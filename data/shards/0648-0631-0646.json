{"poems":[[53,"أقول وقد جاز الرفاق بذي النقا","https://www.aldiwan.net/poem30530.html","الطويل"],[3,"رمت الفؤاد مليحة عذراء","https://www.aldiwan.net/poem121.html",""],[71,"لولا ادكارك تل راهط والحمى","https://www.aldiwan.net/poem4004.html","الكامل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"وضعت كقضبان اللجين","https://www.aldiwan.net/poem64035.html","مجزوء الكامل"],[91,"سلام على السيد المجتبى","https://www.aldiwan.net/poem8758.html","عموديه"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[89,"طلعت كقرن الشمس بعد تبرقع","https://www.aldiwan.net/poem44950.html","الكامل"],[89,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[45,"ذات ارتجاز بحنين الرعد","https://www.aldiwan.net/poem63456.html","الرجز"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"جاء في قده اعتدال","https://www.aldiwan.net/poem39233.html","مجزوء البسيط"],[66,"يا للحماسة ضاقت بينكم حيلي","https://www.aldiwan.net/poem41550.html","البسيط"],[97,"قلب تقسم بين الوجد والألم","https://www.aldiwan.net/poem24873.html","البسيط"],[105,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[50,"شط بسلمى عاجل البين","https://www.aldiwan.net/poem24574.html","السريع"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[96,"إمرأة وشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17498",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""]],"verses":[["وَرِنَّ التِفاتَ القَلبِ مِن بَعدِ طَرفِهِ","طَولَ اللَيالي نَحوَكُم لَيَزيدُ",0,"د",1,0],["وَرَنَت فَقُلتُ غَزالَةٌ مَذعورَةٌ","قَد راعَها وَسطَ الفَلاةِ بَلاءُ",1,"ا",2,0],["وَرَنا إِلَيَّ بِعَينِهِ شَزراً فَما","أَغضى بِها إِلّا وَإِثمِدُها العَمى",2,"م",2,0],["ورنا بعده الغزال فقلنا","حُطّ يا ظبيُ عن جفنك ثقلا",3,"ل",2,0],["ورنتْ بمُقلة جُؤذَرٍ","وسْنانَ ساجي الطرف أحورْ",4,"ر",1,0],["وَرَنَّت بِأُذني أَغاريدُها","فَقُلتُ لِكَفِّيَ أَن تَكتُبا",5,"ب",2,0],["وَرَنَّ نشيدُ الحَيَاةِ المقدَّس","في هيكلٍ حالِمٍ قدْ سُحِرْ",6,"ر",1,0],["ورنت بألحاظ تمض فغادرت","قلبي كشلو بالسيوف مبضع",7,"ع",1,0],["ورنَّق عدوان الزمان معيشتي","فمن ليَ أن ألقى الزمان مصافيا",8,"ي",2,0],["وَرَنَّةٌ مِثلَ زَئيرِ الأُسدِ","وَلَمعُ بَرقٍ كَسُيوفِ الهِندِ",9,"د",1,0],["وَرَنوا بِأَجفانٍ ضِعافٍ في الوَغى","لَكِنَّها في الفَتكِ غَيرُ ضِعافِ",10,"ف",1,0],["وَرَنَّحَ الرَوضُ مِنهُ عِطفاً","حَفَّ بِهِ اللُطفُ وَالدُخولُ",11,"ل",1,0],["وَرَنَّةُ البيضِ في الهاماتِ تُطرِبُهُم","إِذا دَعاهُم لِحَربٍ مَن يُجَرِّبُهُم",12,"م",1,0],["ورنَّحَت بعده خطوي وما عرفت","من عثرة الحظِّ أم من عثرة القدم",13,"م",1,0],["وَرَنَّ صَوتُ أخيهِ عندَ مضجعهِ","اُخرُجْ إلينا أما تَنْفَكُّ تَعْتَكِفُ",14,"ف",1,0],["وَرَنَونَ مِن خَلَلِ الخُدو","رِ بِأَعيُنِ البَقَرِ الخَواذِل",15,"ل",1,0],["وَرَنا إِلَيَّ الفَرقَدانِ كَما رَنَت","زَرقاءُ تَنظُرُ مِن نِقابٍ أَسوَدِ",16,"د",1,0],["وَرَنَّتِ النَفسُ لَها رَنَّةً","كادَت لَها تَنشَقُّ نِصفَينِ",17,"ن",1,0],["وَرَنَّةَ هَتّافِ العَشِيِّ مُكَبَّلٍ","يُنازِعُهُ الأَوتارَ مَن لَيسَ رَامِيا",18,"ي",2,0],["ورنَّقَت مورِدَه","أنَّى له أن يَعذُبا",19,"ب",2,0],["ورنا حيث رنا فاهتاجه","منظرُ الزَّهر الذي زان رباها",20,"ا",3,0],["ورنا الشيطانُ في آثارها","سابحاً في دهشةٍ طال مداها",20,"ا",3,0],["ورنَتْ فبادر نَرْجِسٌ","يشْكُو عَماهُ إِلى حَمائِمْ",21,"م",1,0],["ورنَتْ ذُكاءُ بناظِرٍ","رمِدٍ مِن الأَقْذاءِ سالِمْ",21,"م",1,0],["وَرَنِينُ الأَوْتَارِ فِي فَلَقِ الصُّبْ","حِ وَسَجْعُ الطُّيُورِ فِي الأَوْكَارِ",22,"ر",1,0],["وَرَنِينُ آلاَتٍ تكَادُ تَظَنُّهَا","مُتَجَاوِبَاتِ العَزْفِ بِالإِيَعَادِ",23,"د",1,0],["وَرَنَتْ لَه الآمَالُ ظَمْأَى حُوَّماً","مَعْقُودةً أَبْصارُها برَجَائه",24,"ا",3,0],["ورنينٌ من السماءِ تمنَّى","كلُّ طَيْرٍ لو أنَّهُ من لَهاته",25,"ت",2,0],["وَرَنَتْ كُلُّ سَرْحَةٍ تَسْرِقُ السمْعَ","وتَعْطُو بغُصْنِها الميَّالِ",26,"ل",1,0],["ورنينُ الأجْراسِ يصدَحُ بالنص","ر فيا بِشْرَهُ صباحاً مَجيدا",27,"د",2,0],["وَرَنا الزهرُ باسماً يَنْشُرُ النُّو","رَ ويهَفْوُ بثَغْرهِ الفَوَّاح",28,"ح",1,0],["ورنا إلى الشباك ، يرجو فاختفت","وارتد بالوعد الجلي الخافي",29,"ف",2,0],["ورنا ، بلا قصد ، فخال تحركا","يدنو كقطّاع من الاجلاف",29,"ف",1,0],["ورنا حيث رنا اهتاجه","منظر الزّهر الذي زان رباها",30,"ا",3,0],["ورنانةٍ في المحْفِلِ الضَّخْمِ فذّةٍ","تَناقَلُها عن أصغريهِ التراجم",31,"م",1,0],["ورنوة لك راح النجم يرشفها","حتّى ترنّح سكر في محيّاه",32,"ا",2,0]]}