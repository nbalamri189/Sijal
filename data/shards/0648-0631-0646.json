 يسهر","https://www.poetsgate.com/ViewPoem.aspx?id=157961",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5409,"هدأ الدجى لولا أنين عليل","https://www.poetsgate.com/ViewPoem.aspx?id=155307",""],[5582,"سَفَرَتْ فَكادَ تَأَلُّقُ الأَنْوارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63514",""],[5596,"فقيد البِرِّ والسخاء","https://www.poetsgate.com/ViewPoem.aspx?id=206382",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5725,"عيناك يابغداد تسكنني","https://www.poetsgate.com/ViewPoem.aspx?id=181642",""],[5770,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=178689",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5790,"ومهفهفٍ ماس القضيب وقده","https://www.poetsgate.com/ViewPoem.aspx?id=112146",""],[5961,"موائد إحسان","https://www.poetsgate.com/ViewPoem.aspx?id=199766",""],[6078,"نيليّة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=202774",""],[6093,"يَزُفُّ الدَّهرُ خَوَّاناً","https://www.poetsgate.com/ViewPoem.aspx?id=176379",""],[2575,"مرحى فقد وضح الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=1364",""],[6149,"يصف النسيم إذا يمر به","https://www.poetsgate.com/ViewPoem.aspx?id=169626",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6213,"هدوء الموج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85502&r=&rc=105",""],[6237,"الحب الكاذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77889&r=&rc=31",""],[240,"أُبِثُّكَ مَجْدَ کلدِّينِ حَالاً سَمَاعُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26475&r=&rc=0",""]],"verses":[["وَرِنَّ التِفاتَ القَلبِ مِن بَعدِ طَرفِهِ","طَولَ اللَيالي نَحوَكُم لَيَزيدُ",0,"د",1,0],["وَرَنَت فَقُلتُ غَزالَةٌ مَذعورَةٌ","قَد راعَها وَسطَ الفَلاةِ بَلاءُ",1,"ا",2,0],["وَرَنا إِلَيَّ بِعَينِهِ شَزراً فَما","أَغضى بِها إِلّا وَإِثمِدُها العَمى",2,"م",2,0],["ورنا بعده الغزال فقلنا","حُطّ يا ظبيُ عن جفنك ثقلا",3,"ل",2,0],["ورنتْ بمُقلة جُؤذَرٍ","وسْنانَ ساجي الطرف أحورْ",4,"ر",1,0],["وَرَنَّت بِأُذني أَغاريدُها","فَقُلتُ لِكَفِّيَ أَن تَكتُبا",5,"ب",2,0],["وَرَنَّ نشيدُ الحَيَاةِ المقدَّس","في هيكلٍ حالِمٍ قدْ سُحِرْ",6,"ر",1,0],["ورنت بألحاظ تمض فغادرت","قلبي كشلو بالسيوف مبضع",7,"ع",1,0],["ورنَّق عدوان الزمان معيشتي","فمن ليَ أن ألقى الزمان مصافيا",8,"ي",2,0],["وَرَنَّةٌ مِثلَ زَئيرِ الأُسدِ","وَلَمعُ بَرقٍ كَسُيوفِ الهِندِ",9,"د",1,0],["وَرَنوا بِأَجفانٍ ضِعافٍ في الوَغى","لَكِنَّها في الفَتكِ غَيرُ ضِعافِ",10,"ف",1,0],["وَرَنَّحَ الرَوضُ مِنهُ عِطفاً","حَفَّ بِهِ اللُطفُ وَالدُخولُ",11,"ل",1,0],["وَرَنَّةُ البيضِ في الهاماتِ تُطرِبُهُم","إِذا دَعاهُم لِحَربٍ مَن يُجَرِّبُهُم",12,"م",1,0],["ورنَّحَت بعده خطوي وما عرفت","من عثرة الحظِّ أم من عثرة القدم",13,"م",1,0],["وَرَنَّ صَوتُ أخيهِ عندَ مضجعهِ","اُخرُجْ إلينا أما تَنْفَكُّ تَعْتَكِفُ",14,"ف",1,0],["وَرَنَونَ مِن خَلَلِ الخُدو","رِ بِأَعيُنِ البَقَرِ الخَواذِل",15,"ل",1,0],["وَرَنا إِلَيَّ الفَرقَدانِ كَما رَنَت","زَرقاءُ تَنظُرُ مِن نِقابٍ أَسوَدِ",16,"د",1,0],["وَرَنَّتِ النَفسُ لَها رَنَّةً","كادَت لَها تَنشَقُّ نِصفَينِ",17,"ن",1,0],["وَرَنَّةَ هَتّافِ العَشِيِّ مُكَبَّلٍ","يُنازِعُهُ الأَوتارَ مَن لَيسَ رَامِيا",18,"ي",2,0],["ورنَّقَت مورِدَه","أنَّى له أن يَعذُبا",19,"ب",2,0],["ورنا حيث رنا فاهتاجه","منظرُ الزَّهر الذي زان رباها",20,"ا",3,0],["ورنا الشيطانُ في آثارها","سابحاً في دهشةٍ طال مداها",20,"ا",3,0],["ورنَتْ فبادر نَرْجِسٌ","يشْكُو عَماهُ إِلى حَمائِمْ",21,"م",1,0],["ورنَتْ ذُكاءُ بناظِرٍ","رمِدٍ مِن الأَقْذاءِ سالِمْ",21,"م",1,0],["وَرَنِينُ الأَوْتَارِ فِي فَلَقِ الصُّبْ","حِ وَسَجْعُ الطُّيُورِ فِي الأَوْكَارِ",22,"ر",1,0],["وَرَنِينُ آلاَتٍ تكَادُ تَظَنُّهَا","مُتَجَاوِبَاتِ العَزْفِ بِالإِيَعَادِ",23,"د",1,0],["وَرَنَتْ لَه الآمَالُ ظَمْأَى حُوَّماً","مَعْقُودةً أَبْصارُها برَجَائه",24,"ا",3,0],["ورنينٌ من السماءِ تمنَّى","كلُّ طَيْرٍ لو أنَّهُ من لَهاته",25,"ت",2,0],["وَرَنَتْ كُلُّ سَرْحَةٍ تَسْرِقُ السمْعَ","وتَعْطُو بغُصْنِها الميَّالِ",26,"ل",1,0],["ورنينُ الأجْراسِ يصدَحُ بالنص","ر فيا بِشْرَهُ صباحاً مَجيدا",27,"د",2,0],["وَرَنا الزهرُ باسماً يَنْشُرُ النُّو","رَ ويهَفْوُ بثَغْرهِ الفَوَّاح",28,"ح",1,0],["ورنا إلى الشباك ، يرجو فاختفت","وارتد بالوعد الجلي الخافي",29,"ف",2,0],["ورنا ، بلا قصد ، فخال تحركا","يدنو كقطّاع من الاجلاف",29,"ف",1,0],["ورنا السفر حوله ليس يدري","هل يرى الجدّ أم يحسّ المزاحا ؟",30,"ح",2,0],["ورنا حيث رنا اهتاجه","منظر الزّهر الذي زان رباها",31,"ا",3,0],["ورنانةٍ في المحْفِلِ الضَّخْمِ فذّةٍ","تَناقَلُها عن أصغريهِ التراجم",32,"م",1,0],["ورنوة الحييّ ألف قصّة","عن الهوى وغمزة العفيف",33,"ف",1,0],["ورنوة لك راح النجم يرشفها","حتّى ترنّح سكر في محيّاه",34,"ا",2,0],["ورَنَت وِجهَتِى فَمَّ عَلَيهَا","حَاجِبَاهَا وعَاذِلاىَ الحجابَا",35,"ب",2,0],["ورنح قداً مثل غصنٍ على نقا","بأعلاه بدر التم من فوق فرقدِ",36,"د",1,0],["ورَنَّة زامرِ الدُّولاب فيها","تُوافق طيبَ ألحانِ القَمارِي",37,"ر",2,0],["ورنتْ عينها إليهِ بأن لا","تتبعنا فمرَّ في الآثارِ",38,"ر",1,0],["وَرَنَّ صَدى الأَجراسُ في كَبَدِ الضُحى","يُهيبُ بِأَرواحِ التُقاةِ فَتُسرِعُ",39,"ع",1,0],["وَرَنَت إِلى قَفصٍ هُناكَ مُعَلَّقٍ","بِمَحاجِرٍ غَرِقَت بِماءِ الأَدمُعِ",40,"ع",1,0],["وَرَنَت بِأحوَرِ طَرفِها وَتَبَسَّمت","فَبدا ضياءُ اللُؤلؤ المَنضود",41,"د",1,0],["ورَنَتْ ظبيةً ولاحت صَباحا","وبدتْ دُمْيةً وماستْ قضيبا",42,"ب",2,0],["وَرَنَّقَ عَيشي وَاِستَحالَت إِلى القَذى","مَشارِبُهُ عَن رِقَّةٍ وَصَفاءِ",43,"ا",2,0],["ورنا فقيل هو الغزالُ وأينَ من","لحظاته وفتورها الغزلانُ",44,"ن",1,0],["ورنا النرجس الغضيض بلحظ","صيغ من اصفر النضار سواده",45,"د",2,0],["ورنا مغضبا إلى الطير في الافق","تحادت اعضاؤه والجناح",46,"ح",1,0],["ورَنت إليّ وأسبَلت دَمعاتِها","نجماً فأبصرتُ الثريَّا في الثَّرى",47,"ر",2,0],["ورَنت فقلتُ عِمي صباحاً وانعمي","فلقد طلعتِ بوجهِ ذاتِ النور",48,"ر",1,0],["ورنّ صَدى في الجوّ من صوتِ طارقِ","يقولُ لنصر نحنُ أو للمات",49,"ت",1,0],["ورنَت إليَّ وكفُّها في خصرها","وتبسّمَت وبِلفظةٍ لم تنبُس",50,"س",1,0],["وَرَنِينِ مَفْجُوعٍ لَدَيْكَ وَصَلْتُهُ","بَحَنِينِ باكِيَةٍ عَلَيكَ مُرَجَّعِ",51,"ع",1,0],["ورنّحه الغريد في سحر صوته","فدوى كبشرى الوصل في مسمع الصب",52,"ب",1,0],["ورنحت المعاطف منه قولي","يكون لك البقا مات الكئيب",53,"ب",1,0],["ورنا بطرفٍ أسودٍ","فرايتُ موتا أحمرا",54,"ر",2,0],["ورنة أذكار وصوت مسبح","ونغمة حاد بالمطايا المجدة",55,"ه",1,0],["وَرَنا إِلى العُليا وَرَطِبَ سَمعُنا","بِبِشارَةٍ جاءَت بِأَطرَبِ رَنَّة",56,"ه",1,0],["ورنت إليك (تبوكها) و(عسيرها)","و(الباحة) الخضراء صيبها هتن",57,"ن",1,0],["ورَنَتْ إِليه عينُ كل رئاسةٍ","حُبًّا فكلٌّ مغرَمٌ هَيْمَانُ",58,"ن",1,0],["وَرَنَتْ إِليَّ بطَرْفِ ريمٍ أَكْحَلٍ","فرنا الرقيبُ بطَرْفِ لَيْثٍ ضَارِ",59,"ر",1,0],["ورنح البان شعر حسبه ألم","مما يعنيه من ليلى ويقلقه",60,"ق",2,0],["وَرَنت له أممٌ بدمعةِ حائرٍ","وِجلٍ تُحسُّ مصابها بمصابِه",61,"ب",2,0],["ورنَّحَ رندَ الواديينِ هبوبُه","فمالَ على حَوذانِه وتأطَّرا",62,"ر",2,0],["ورنة السبعة المثاني","ما في الفؤاد المعنى ثاني",63,"ي",1,0],["ورنه دهى بوسه زلب","بهل بَبُوسَمْ لَبَكا",64,"ك",2,0],["ورنح الركب بطيب وصفه","وخذ قلوب كلهم بكل فن",65,"ن",1,0],["ورنَّ جلجال ملك الله عن طربٍ","وعند ليبُ العلى اضحى يغنينا",66,"ن",2,0],["ورنَّةٌ ضمْنَ عَقلي لَوعتي عقَلتْ","وحُكمَ حُبِّكَ في أطرافهِ عقِلَتْ",67,"ت",1,0],["ورنّحْتَ أعطافَ الرِّماحِ كأنّما","مزَجْتَ دماً سقّيْتَها منه بالخَمْرِ",68,"ر",1,0],["ورنَتْ فشدّ على القُلوبِ بأسرِها","أسدُ المنيّةِ من جُفونِ غَزالِ",69,"ل",1,0],["ورنَتْ فجرّحَتِ القُلوبَ بمُقلةً","طرْفُ السِّنانِ وطرفُها سِيّانِ",70,"ن",1,0],["ورنَتْ ففوّقَ لحظُها نَبلاً له","عندَ الرُماةِ على السِّهامِ تفوُّقُ",71,"ق",1,0],["وَرَنَتْ بِعَيْنَيْ جُؤْذَرٍ","شَفّاكَ يَوْمَ الْجَزْعِ شَفّا",72,"ف",2,0],["ورنت لي رنوةً","بطريفٍ أحورا",73,"ر",2,0],["ورنَت عيونُ الناظرِين لِخَالِها","فَتوعَّدت مِن خدِّها بِلَهيبِ",74,"ب",1,0],["ورَنت تطالعُك الدهور فراعها","فتح بماضيك المجيد مُعلَّب",75,"ب",1,0],["وَرَنتْ إليك بطرف جَوْذَرِ رملةٍ","وخطتْ بحِقْفٍ في الإزار مَهيلِ",76,"ل",1,0],["ورنا إلي بطرفه عند النوى","والوجه يزري الشمس في إشراقه",77,"ق",2,0],["وَرَنَ