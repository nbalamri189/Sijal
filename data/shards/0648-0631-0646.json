{"poems":[[53,"أقول وقد جاز الرفاق بذي النقا","https://www.aldiwan.net/poem30530.html","الطويل"],[3,"رمت الفؤاد مليحة عذراء","https://www.aldiwan.net/poem121.html",""],[71,"لولا ادكارك تل راهط والحمى","https://www.aldiwan.net/poem4004.html","الكامل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"وضعت كقضبان اللجين","https://www.aldiwan.net/poem64035.html","مجزوء الكامل"],[91,"سلام على السيد المجتبى","https://www.aldiwan.net/poem8758.html","عموديه"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[89,"طلعت كقرن الشمس بعد تبرقع","https://www.aldiwan.net/poem44950.html","الكامل"],[89,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[45,"ذات ارتجاز بحنين الرعد","https://www.aldiwan.net/poem63456.html","الرجز"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"جاء في قده اعتدال","https://www.aldiwan.net/poem39233.html","مجزوء البسيط"],[66,"يا للحماسة ضاقت بينكم حيلي","https://www.aldiwan.net/poem41550.html","البسيط"],[97,"قلب تقسم بين الوجد والألم","https://www.aldiwan.net/poem24873.html","البسيط"],[105,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[50,"شط بسلمى عاجل البين","https://www.aldiwan.net/poem24574.html","السريع"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[96,"إمرأة وشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17498",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[130,"فت بين الرباب في العين صابا","https://www.aldiwan.net/poem54893.html","الطويل"],[133,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[183,"عسى يجري الزمان على اختياري","https://www.aldiwan.net/poem14534.html","الوافر"],[197,"نفرت والظباء ذات نفار","https://www.aldiwan.net/poem45535.html","الخفيف"],[221,"أطلت من الشباك والليل نير","https://www.aldiwan.net/poem39705.html","الطويل"],[221,"ألفيتها ومن التحسر لا تعي","https://www.aldiwan.net/poem41880.html","الكامل"],[223,"سفرت فلاح لنا هلال سعود","https://www.aldiwan.net/poem55248.html","الكامل"],[227,"ظلموا البين والنوى والرقيبا","https://www.aldiwan.net/poem51215.html","الخفيف"],[233,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[248,"أثن عليه وقد تثنى البان","https://www.aldiwan.net/poem15042.html","الكامل"],[259,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[259,"حباك عرفا حليها والوشاح","https://www.aldiwan.net/poem38348.html","الخفيف"],[268,"قبلتها فشممت وردا أحمرا","https://www.aldiwan.net/poem35242.html","الكامل"],[268,"حييتها بقرنفل ممطور","https://www.aldiwan.net/poem35445.html","الكامل"],[268,"تصباك ما في النجم من لمعات","https://www.aldiwan.net/poem35636.html","الطويل"],[268,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[278,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[288,"وواد كأنفاس المحبين في القرب","https://www.aldiwan.net/poem11671.html","الطويل"],[301,"أيا ريح الصبا إن جزت روضا","https://www.aldiwan.net/poem57895.html","الوافر"],[301,"يا من أمال قوامه","https://www.aldiwan.net/poem58154.html","مجزوء الكامل"],[302,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[318,"الدهر أصبح مشرقا بتجليه","https://www.aldiwan.net/poem67199.html","الكامل"],[397,"نقش على جدار الوطن","https://www.aldiwan.net/poem6788.html","عموديه"],[429,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[429,"لمن الشموس غربن في الأكوار","https://www.aldiwan.net/poem12433.html","الكامل"],[447,"ماذا يطوقه ؟","https://www.aldiwan.net/poem1011.html",""],[451,"يا أيها الموتى ويا من خلدوا","https://www.aldiwan.net/poem61635.html","الكامل"],[475,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[480,"لما يرى حبها فؤادي","https://www.aldiwan.net/poem24552.html","عموديه"],[493,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[498,"أواه من ذاك الغزيل الأغن","https://www.aldiwan.net/poem37569.html","الرجز"],[498,"يا منشد الغيب أذكر من نيهم به","https://www.aldiwan.net/poem37632.html","البسيط"],[498,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[512,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[512,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[527,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[536,"فتحت في روضها","https://www.aldiwan.net/poem47419.html","عموديه"],[536,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[542,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[549,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[562,"لهفي على رؤيا الحبيب وليتني","https://www.aldiwan.net/poem906.html",""],[584,"ليت شعري من قد أحل الخياما","https://www.aldiwan.net/poem17744.html","الخفيف"]],"verses":[["وَرِنَّ التِفاتَ القَلبِ مِن بَعدِ طَرفِهِ","طَولَ اللَيالي نَحوَكُم لَيَزيدُ",0,"د",1,0],["وَرَنَت فَقُلتُ غَزالَةٌ مَذعورَةٌ","قَد راعَها وَسطَ الفَلاةِ بَلاءُ",1,"ا",2,0],["وَرَنا إِلَيَّ بِعَينِهِ شَزراً فَما","أَغضى بِها إِلّا وَإِثمِدُها العَمى",2,"م",2,0],["ورنا بعده الغزال فقلنا","حُطّ يا ظبيُ عن جفنك ثقلا",3,"ل",2,0],["ورنتْ بمُقلة جُؤذَرٍ","وسْنانَ ساجي الطرف أحورْ",4,"ر",1,0],["وَرَنَّت بِأُذني أَغاريدُها","فَقُلتُ لِكَفِّيَ أَن تَكتُبا",5,"ب",2,0],["وَرَنَّ نشيدُ الحَيَاةِ المقدَّس","في هيكلٍ حالِمٍ قدْ سُحِرْ",6,"ر",1,0],["ورنت بألحاظ تمض فغادرت","قلبي كشلو بالسيوف مبضع",7,"ع",1,0],["ورنَّق عدوان الزمان معيشتي","فمن ليَ أن ألقى الزمان مصافيا",8,"ي",2,0],["وَرَنَّةٌ مِثلَ زَئيرِ الأُسدِ","وَلَمعُ بَرقٍ كَسُيوفِ الهِندِ",9,"د",1,0],["وَرَنوا بِأَجفانٍ ضِعافٍ في الوَغى","لَكِنَّها في الفَتكِ غَيرُ ضِعافِ",10,"ف",1,0],["وَرَنَّحَ الرَوضُ مِنهُ عِطفاً","حَفَّ بِهِ اللُطفُ وَالدُخولُ",11,"ل",1,0],["وَرَنَّةُ البيضِ في الهاماتِ تُطرِبُهُم","إِذا دَعاهُم لِحَربٍ مَن يُجَرِّبُهُم",12,"م",1,0],["ورنَّحَت بعده خطوي وما عرفت","من عثرة الحظِّ أم من عثرة القدم",13,"م",1,0],["وَرَنَّ صَوتُ أخيهِ عندَ مضجعهِ","اُخرُجْ إلينا أما تَنْفَكُّ تَعْتَكِفُ",14,"ف",1,0],["وَرَنَونَ مِن خَلَلِ الخُدو","رِ بِأَعيُنِ البَقَرِ الخَواذِل",15,"ل",1,0],["وَرَنا إِلَيَّ الفَرقَدانِ كَما رَنَت","زَرقاءُ تَنظُرُ مِن نِقابٍ أَسوَدِ",16,"د",1,0],["وَرَنَّتِ النَفسُ لَها رَنَّةً","كادَت لَها تَنشَقُّ نِصفَينِ",17,"ن",1,0],["وَرَنَّةَ هَتّافِ العَشِيِّ مُكَبَّلٍ","يُنازِعُهُ الأَوتارَ مَن لَيسَ رَامِيا",18,"ي",2,0],["ورنَّقَت مورِدَه","أنَّى له أن يَعذُبا",19,"ب",2,0],["ورنا حيث رنا فاهتاجه","منظرُ الزَّهر الذي زان رباها",20,"ا",3,0],["ورنا الشيطانُ في آثارها","سابحاً في دهشةٍ طال مداها",20,"ا",3,0],["ورنَتْ فبادر نَرْجِسٌ","يشْكُو عَماهُ إِلى حَمائِمْ",21,"م",1,0],["ورنَتْ ذُكاءُ بناظِرٍ","رمِدٍ مِن الأَقْذاءِ سالِمْ",21,"م",1,0],["وَرَنِينُ الأَوْتَارِ فِي فَلَقِ الصُّبْ","حِ وَسَجْعُ الطُّيُورِ فِي الأَوْكَارِ",22,"ر",1,0],["وَرَنِينُ آلاَتٍ تكَادُ تَظَنُّهَا","مُتَجَاوِبَاتِ العَزْفِ بِالإِيَعَادِ",23,"د",1,0],["وَرَنَتْ لَه الآمَالُ ظَمْأَى حُوَّماً","مَعْقُودةً أَبْصارُها برَجَائه",24,"ا",3,0],["ورنينٌ من السماءِ تمنَّى","كلُّ طَيْرٍ لو أنَّهُ من لَهاته",25,"ت",2,0],["وَرَنَتْ كُلُّ سَرْحَةٍ تَسْرِقُ السمْعَ","وتَعْطُو بغُصْنِها الميَّالِ",26,"ل",1,0],["ورنينُ الأجْراسِ يصدَحُ بالنص","ر فيا بِشْرَهُ صباحاً مَجيدا",27,"د",2,0],["وَرَنا الزهرُ باسماً يَنْشُرُ النُّو","رَ ويهَفْوُ بثَغْرهِ الفَوَّاح",28,"ح",1,0],["ورنا إلى الشباك ، يرجو فاختفت","وارتد بالوعد الجلي الخافي",29,"ف",2,0],["ورنا ، بلا قصد ، فخال تحركا","يدنو كقطّاع من الاجلاف",29,"ف",1,0],["ورنا حيث رنا اهتاجه","منظر الزّهر الذي زان رباها",30,"ا",3,0],["ورنانةٍ في المحْفِلِ الضَّخْمِ فذّةٍ","تَناقَلُها عن أصغريهِ التراجم",31,"م",1,0],["ورنوة لك راح النجم يرشفها","حتّى ترنّح سكر في محيّاه",32,"ا",2,0],["ورَنَت وِجهَتِى فَمَّ عَلَيهَا","حَاجِبَاهَا وعَاذِلاىَ الحجابَا",33,"ب",2,0],["ورنح قداً مثل غصنٍ على نقا","بأعلاه بدر التم من فوق فرقدِ",34,"د",1,0],["ورَنَّة زامرِ الدُّولاب فيها","تُوافق طيبَ ألحانِ القَمارِي",35,"ي",1,0],["ورنتْ عينها إليهِ بأن لا","تتبعنا فمرَّ في الآثارِ",36,"ر",1,0],["وَرَنَّ صَدى الأَجراسُ في كَبَدِ الضُحى","يُهيبُ بِأَرواحِ التُقاةِ فَتُسرِعُ",37,"ع",1,0],["وَرَنَت إِلى قَفصٍ هُناكَ مُعَلَّقٍ","بِمَحاجِرٍ غَرِقَت بِماءِ الأَدمُعِ",38,"ع",1,0],["وَرَنَت بِأحوَرِ طَرفِها وَتَبَسَّمت","فَبدا ضياءُ اللُؤلؤ المَنضود",39,"د",1,0],["ورَنَتْ ظبيةً ولاحت صَباحا","وبدتْ دُمْيةً وماستْ قضيبا",40,"ب",2,0],["وَرَنَّقَ عَيشي وَاِستَحالَت إِلى القَذى","مَشارِبُهُ عَن رِقَّةٍ وَصَفاءِ",41,"ا",2,0],["ورنا فقيل هو الغزالُ وأينَ من","لحظاته وفتورها الغزلانُ",42,"ن",1,0],["ورنا النرجس الغضيض بلحظ","صيغ من اصفر النضار سواده",43,"د",2,0],["ورنا مغضبا إلى الطير في الافق","تحادت اعضاؤه والجناح",44,"ح",1,0],["ورَنت إليّ وأسبَلت دَمعاتِها","نجماً فأبصرتُ الثريَّا في الثَّرى",45,"ر",2,0],["ورَنت فقلتُ عِمي صباحاً وانعمي","فلقد طلعتِ بوجهِ ذاتِ النور",46,"ر",1,0],["ورنّ صَدى في الجوّ من صوتِ طارقِ","يقولُ لنصر نحنُ أو للمات",47,"ت",1,0],["ورنَت إليَّ وكفُّها في خصرها","وتبسّمَت وبِلفظةٍ لم تنبُس",48,"س",1,0],["وَرَنِينِ مَفْجُوعٍ لَدَيْكَ وَصَلْتُهُ","بَحَنِينِ باكِيَةٍ عَلَيكَ مُرَجَّعِ",49,"ع",1,0],["ورنّحه الغريد في سحر صوته","فدوى كبشرى الوصل في مسمع الصب",50,"ب",1,0],["ورنحت المعاطف منه قولي","يكون لك البقا مات الكئيب",51,"ب",1,0],["ورنا بطرفٍ أسودٍ","فرايتُ موتا أحمرا",52,"ر",2,0],["ورنة أذكار وصوت مسبح","ونغمة حاد بالمطايا المجدة",53,"ه",1,0],["وَرَنا إِلى العُليا وَرَطِبَ سَمعُنا","بِبِشارَةٍ جاءَت بِأَطرَبِ رَنَّة",54,"ه",1,0],["ورنت إليك (تبوكها) و(عسيرها)","و(الباحة) الخضراء صيبها هتن",55,"ن",1,0],["ورَنَتْ إِليه عينُ كل رئاسةٍ","حُبًّا فكلٌّ مغرَمٌ هَيْمَانُ",56,"ن",1,0],["وَرَنَتْ إِليَّ بطَرْفِ ريمٍ أَكْحَلٍ","فرنا الرقيبُ بطَرْفِ لَيْثٍ ضَارِ",57,"ر",1,0],["ورنح البان شعر حسبه ألم","مما يعنيه من ليلى ويقلقه",58,"ق",2,0],["وَرَنت له أممٌ بدمعةِ حائرٍ","وِجلٍ تُحسُّ مصابها بمصابِه",59,"ب",2,0],["ورنَّحَ رندَ الواديينِ هبوبُه","فمالَ على حَوذانِه وتأطَّرا",60,"ر",2,0],["ورنة السبعة المثاني","ما في الفؤاد المعنى ثاني",61,"ي",1,0],["ورنه دهى بوسه زلب","بهل بَبُوسَمْ لَبَكا",62,"ك",2,0],["ورنح الركب بطيب وصفه","وخذ قلوب كلهم بكل فن",63,"ن",1,0],["ورنَّ جلجال ملك الله عن طربٍ","وعند ليبُ العلى اضحى يغنينا",64,"ن",2,0],["ورنَّةٌ ضمْنَ عَقلي لَوعتي عقَلتْ","وحُكمَ حُبِّكَ في أطرافهِ عقِلَتْ",65,"ت",1,0],["ورنّحْتَ أعطافَ الرِّماحِ كأنّما","مزَجْتَ دماً سقّيْتَها منه بالخَمْرِ",66,"ر",1,0],["ورنَتْ فشدّ على القُلوبِ بأسرِها","أسدُ المنيّةِ من جُفونِ غَزالِ",67,"ل",1,0],["ورنَتْ فجرّحَتِ القُلوبَ بمُقلةً","طرْفُ السِّنانِ وطرفُها سِيّانِ",68,"ن",1,0],["ورنَتْ ففوّقَ لحظُها نَبلاً له","عندَ الرُماةِ على السِّهامِ تفوُّقُ",69,"ق",1,0],["وَرَنَتْ بِعَيْنَيْ جُؤْذَرٍ","شَفّاكَ يَوْمَ الْجَزْعِ شَفّا",70,"ف",2,0],["ورنت لي رنوةً","بطريفٍ أحورا",71,"ر",2,0],["ورنَت عيونُ الناظرِين لِخَالِها","فَتوعَّدت مِن خدِّها بِلَهيبِ",72,"ب",1,0],["ورَنت تطالعُك الدهور فراعها","فتح بماضيك المجيد مُعلَّب",73,"ب",1,0],["وَرَنتْ إليك بطرف جَوْذَرِ رملةٍ","وخطتْ بحِقْفٍ في الإزار مَهيلِ",74,"ل",1,0],["ورنا إلي بطرفه عند النوى","والوجه يزري الشمس في إشراقه",75,"ق",2,0],["وَرَنَا إِليّ فَسلَّما","لِلْوَجْدِ قَلْبِي سَلَّما",76,"م",2,0]]}