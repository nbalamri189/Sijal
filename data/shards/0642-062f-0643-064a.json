{"poems":[[89,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[133,"أنامل النسيان مري على","https://www.aldiwan.net/poem67432.html","السريع"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62500","الرمل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128753","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""]],"verses":[["قَدكِ يَا نَفْسُ فَالتَّصَبُّرُ إِلَّا","فِي لِقَاءِ الْحُرُوبِ غَبْنٌ وَجَهْلُ",0,"ل",1,0],["قدك يا عصر اختراعا إنه","مكمن الويل ولكن قد طلي",1,"ي",1,0],["قَدكَ يَلقى شعوب كُلِّ شُجاعٍ","وَجبانٍ وَكُلُّ سَمح وَلِحزِ",2,"ز",1,0],["قَدكَ يا هاتِكَ الحُرَم","تَنبُشُ بالذِكرى رَميمَ القُدود",3,"د",1,0],["قَدُّكَ يا جَميلُ","كَالغُصنِ إذ يَميلُ",4,"ل",1,1],["قَدْكَ يا قلبي ويا","نعماكَ جاءتك البشائرْ",5,"ر",1,0],["قدَّك يا ريم الحمى بانه","فتنثني ام ساق ريحانه",6,"ن",2,1],["قدك يا جوراء عذلاً وفند","رائدُ الموت أراه قد وفد",7,"د",1,1],["قدك يا دهر فكم أم لها","أمل نالته من عندك عندا",8,"د",2,0],["قدك يا بعد قد نزعت قلوبا","كنّ ملأى قوىً فأقوين هزلا",9,"ل",2,0],["قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","قَدْ أَطَلْتَ اللَّوْمَ عِنْدِي وَالفَنَدْ",10,"د",1,1]]}