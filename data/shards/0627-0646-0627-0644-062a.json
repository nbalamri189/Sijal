َ الَّتي كَتَبَت بِما كَتَبت بِهِ","تَرَكَت رَجاءَكَ واقِفاً حَيرانا",3,"ن",2,0],["إِنَّ الَّتي عَدَلَ الهَوى عَن قَلبِها","وَأَصابَ قَلبي سَيفُهُ لَم تَظلِمِ",4,"م",1,1],["إِنَّ الَّتي سَكَنَت فُؤادَكَ كاعِبٌ","حَوراءُ تَستُرُ وَجهَها بِذِراعِها",5,"ع",3,0],["إِنَّ الَّتي هامَت بِها النَفسُ","عاوَدَها مِن سُقمِها نُكسُ",6,"س",1,1],["أَنَّ الَّتي حَدَّثَتكِ قَد كَذَبَت","وَأَدرَكَت عِندَكِ الَّذي طَلَبَت",7,"ت",1,1],["إِنَّ التَجنُّبَ إِن تَمَكَّنَ مِنكُما","دَبَّ السُلُوُّ لَهُ فَعَزَّ المَطلَبُ",8,"ب",1,0],["إِنَّ الَّتي قُلِّدتَها في حاجَةٍ","لِعَزيمَةٍ تَمضي وَرَأيٍ باتِرِ",9,"ر",1,0],["إِنَّ الَّتِي تَجَلَتْ عَلِيّاً أَنْجَبَتْ","لِلْعِلْمِ أَنْفَسَ دُرَّةٍ فِي عِقْدِهِ",10,"د",2,1],["إِنَّ التَّجَدُّدَ لِلِّسَانِ حَياتُهُ","وَمَنِ الَّذِي يُحْيِيهِ غَيْرُ المُقْدَمِ",11,"م",1,0],["إِنَّ الَّتِي تَبْكِي لَفِي جَنَّةٍ","مَوْرِدُهَا فِيهَا نَعِيمُ الدَّوَامْ",12,"م",1,0],["إِنَّ التِراتِ مُسَهَّدٌ طُلّابُها","فَاِكفُف لِعابَكَ عَن لِعابِ الأَسوَدِ",13,"د",1,0],["أن التمدُّح من عُجب ومن أشَرٍ","والمرء في العُجب ممقوت وفي الأشر",14,"ر",1,0],["أن التجارب للشيوخ وإنما","أمَل البلاد يكون في شُبانها",15,"ن",3,0],["إِنَّ التَذَكُّرَ فَاِعذِلاني أَو دَعا","بَلَغَ العَزاءَ وَأَدرَكَ المَجلودا",16,"د",2,0],["إِنَّ الَّتي ناوَلتَني فَرَدَدتُها","قُتِلَت قُتِلتَ فَهاتِها لَم تُقتَلِ",17,"ل",1,0],["إِنَّ الَّتي أَلقَتكَ مِن تَحتِ رِجلِها","وَليدُ لِمِجهالُ العَشِيِّ خَبوبُ",18,"ب",1,1],["إن التي أسْدَيْتَهَا رَيْحَانَةٌ","أنْشَأتَهَا لا بدَّ مِنْ أنْ تَنْفَحا",19,"ح",2,0],["إن التي تبغي مواراتها","كأنّها في الليل قنديلُ",20,"ل",1,0],["إن التي عُلّقْتَها","تَزْنِي الفرائضَ والنوافلْ",21,"ل",1,0],["إن التي ولدتْك تخبرُ أنها","حملتْك من نُطفٍ لعدةِ أفحُلِ",22,"ل",1,0],["إنَّ التجرُّمَ مُسْرعٌ","في نَقْضِ ما يبني التذَمُّمْ",23,"م",1,0],["إنَّ التلوُّنَ فِعْلُ ذي","خُلقَيْنِ يَصْغُرُ حين يَعْظُمْ",23,"م",1,0],["إن التثبّتَ والأناةَ على امرئٍ","عدلِ القضاءِ من السداد مكين",24,"ن",1,0],["إِنَّ التَحَوُّلَ في الجَمادِ تَقَلُّصٌ","في الحَيِّ مَوتٌ في النَباتِ ذُبولُ",25,"ل",1,0],["إِنَّ الَّتي نَقَلَت حِكاياتِ الهَوى","لَم يَبقَ غَيرَ حِكايَةٍ تَرويها",26,"ي",3,0],["إِنَّ التَرَحُّلَ أَن تَلَبَّسَ أَمرُنا","وَاِعتاقَنا قَدَرٌ أُحِمَّ بَكورُ",27,"ر",1,0],["ان التعصب مانع","ان تبصر العين الصوابا",28,"ب",2,0],["إِن التي تبكيك تع","رفها المصاحف والخدور",29,"ر",1,0],["إن التي جاورت صان الله عن","لوم الحياة أديمها وفضاءها",30,"ا",3,0],["إن التي جاورتها","لم ترع للجيران حقا",31,"ق",2,0],["إِنَّ التَعاوُنَ قُوَّةٌ عُلوِيَّةٌ","تَبني الرِجالَ وَتُبدِعُ الأَشياءَ",32,"ا",2,0],["إِنَّ الَّتي خَلَّفتَ أَم","سِ وَما سِواكَ لَها نَصير",33,"ر",1,0],["إِنَّ الَّتي تَبغونَ دونَ مَنالِها","طولُ اِجتِهادٍ وَاِضطِرادُ كِفاحِ",34,"ح",1,0],["إِنَّ الَّتي صادَتكَ تَس","عى بِالقُلوبِ لَها النَواظِر",35,"ر",1,0],["إِنَّ الَّتي سَفَكَت دَمي بِجُفونِها","لَم تَدرِ أَنَّ دَمي الَّذي تَتَقَلَّدُ",36,"د",1,0],["إِنَّ الَّتي سَمَّيتَها خُلَّةً","لَيسَت بِأَسماءَ وَلا تِربِها",37,"ب",3,0],["إِنَّ التَنازُعَ في الرِئاسَةِ زَلَّةٌ","لا تُستَقالُ وَدَعوَةٌ لَم تُنصَرِ",38,"ر",1,0],["إِنَّ التَزاوُرَ فيما بَينَنا خَطَرٌ","وَالأَرضُ مِن وَطأَةِ البِرذَونِ تَنخَسِفُ",39,"ف",1,0],["إِنِ اِلتَمَستُ رُجوعاً مِن بَشاشَتِهِ","لَم أُلفَ مُلتَمِساً قَصداً وَلا أَمَما",40,"م",2,0],["إِنَّ الَّتي نَظَرَت إِلَيكَ بِفادِرٍ","نَظَرَت إِلَيكَ بِمِثلِ عَينَي جُؤذُرِ",41,"ر",1,1],["إِنَّ الَّتي فُقِأَت بِها أَبصارُكُم","وَهِيَ الَّتي دَمَغَت أَباكَ الفَيصَلُ",42,"ل",1,0],["إِنّا لَتوزَنُ بِالجِبالِ حُلومُنا","وَيَزيدُ جاهُلُنا عَلى الجُهّالِ",43,"ل",1,0],["إِنَّ التَخَلُّقَ لَيسَ يَم","كُثُ إِن يَؤولُ إِلى الطَبيعَة",44,"ع",2,0],["إِنَّ الَّتي تَخطُبُ غَرّارَةٌ","قَريبَةُ العُرسِ مِنَ المَأتَمِ",45,"م",1,0],["إن التي نضَّرت عيشاً نعمت به","وصيرت بيتك المعمور بستانا",46,"ن",2,0],["إِنَّ التِلادَ عَلى نَفاسَةِ قَدرِهِ","لا يُرغِمُ الأَزَماتِ ما لَم يُرغَمِ",47,"م",1,0],["إنَّ التفكُّرَ في المعاهدِ نافعٌ","بلْ عاصمٌ والغافلونَ كثيرُ",48,"ر",1,0],["إنَّ التيقظَ لو علمتِ","طليعةُ الموتِ الزؤامِ",49,"م",1,0],["إِنَّ الَّتي مِن أَرضِها وَسَمائِها","جُلِبَت لِحَينِكَ لَيتَها لَم تُجلَبِ",50,"ب",1,0],["إِنَّ الَّتي زَعَمَت فُؤادَكَ مَلها","خُلِقَت هَواكَ كَما خُلِقتَ هَوىً لَها",51,"ل",3,1],["إِنَّ الَّتي طَرَقَ الرِجالَ خَيالُها","ما كُنتُ زائِرَها وَلا طَرّاقَها",52,"ق",3,0],["إنَّ التي شُغِفَ الرّجالُ بحبِّها","لم تُبْنَ من جُثَثِ الضَّحايا للددِ",53,"د",1,0],["إِنَّ التَحِيَّةَ وَالسَلامَ لِمُؤمِنٍ","عالي المَواقِفِ راجِحِ المِقدارِ",54,"ر",1,0],["إنّ التي رامها في عزّها سَفهاً","لَتُؤثِرُ الموتَ ممّا سامها بدلا",55,"ل",2,0],["إنَّ الَّتِي استَقبَحُوها قَد تُصَورُ لِي","حُسنَ التَّصَبُّرش عَنهَا أقبَحَ الصُّوَرِ",56,"ر",1,0],["إِنَّ التَكَرُمَ وَالنَدى مِن عامِرٍ","جَدّاكَ ما سُلِكَت لِحَجٍ غَزوَرُ",57,"ر",1,1],["إنّ التّجارِبَ لم تَزِدْهُ حَزامَةً","هل زائِدٌ في المَشْرَفيِّ الصَّيْقَل",58,"ل",1,0],["إنّ التي رامَ الدُّمُستُقُ حَربَها","للّهِ فِيها صارمٌ مسلول",59,"ل",1,0],["إنّا لَتَشْرُفُ أيامُ الفَخَارِ بِنَا","حتى يقول عِدانا إنّنا الفَلَق",60,"ق",1,0],["إنّ التي أخلَتْ عَرينَهُمُ","أضحَت بحيثُ الضّيغَمُ الهَصِر",61,"ر",1,0],["إنّا لتجمعُنا وهذا الحيَّ من","بَكْرٍ أذِمَّةُ سالِفٍ لم تُخْفَر",62,"ر",1,0],["إِنَّ الَّتي أَبصَرتَها","سَحَراً تُكَلِّمُني رَسولُ",63,"ل",1,1],["إنّ التنسّكَ عندنا","يا صاح من إحدى الكِبَر",64,"ر",1,0],["إِنَّ الَّتي سَبَعَت عَدُوَّهُ أَصبَحَت","عَمّا لَقيتَ كَغائِبٍ لَم يَشهَدِ",65,"د",1,0],["إِنَّ الَّتي كانَت هَواكَ فَأَصبَحَت","تَحتَ السَفائِفِ في الثَرى المُتَلَبِّدِ",65,"د",1,0],["إِنَّ التَجَهُّمَ عَدّى عَن زِيارَتِكُم","مِمَّن عَلِقتُ وَأَمسى ذاكِ قَد جَهِدا",66,"د",2,0],["إِنَّ الَّتي راحَت مَوَدَّتُها","رَغماً عَلَيَّ فَبِتُّ مُكتَئِبا",67,"ب",2,0],["إِنَّ التَوابيتَ أَجداثٌ مُكَرَّرَةٌ","فَجَنِّبِ القَومَ سَجناً في التَوابيتِ",68,"ت",1,0],["إِنَّ التَجارُبَ طَيرٌ تَألَفُ الخَمَرا","يَصيدُها مَن أَفادَ اللُبَّ وَالعُمرا",69,"ر",2,1],["إِنَّ التَبالِيَ في الحَياةِ وَلا","يُغني نَوائِبَ ماجِدٍ عُذَرُه",70,"ر",2,0],["إِنَّ الَّتي رَمَتِ المَمالِكَ باعَدَت","بَينَ المَضاجِعِ وَالشُعوبِ النُوَّمِ",71,"م",1,0],["إن التراب لمن ينا","م بحفرة بئس الوساده",72,"د",2,0],["إن التوقف سبة","تزري بأنسال الكِرام",73,"م",1,0],["إِن التوقف 