{"poems":[[90,"عندي حديث عن دمشق فأنصتوا","https://www.aldiwan.net/poem44802.html","الكامل"],[90,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[93,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[93,"أزف الرحيل وحان أن نتفرقا","https://www.aldiwan.net/poem8988.html","عموديه"],[94,"يا قلبي الدامي إلام الوجوم","https://www.aldiwan.net/poem38920.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54511","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54878","الكامل"],[108,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[128,"كوخي لقد حال إلى صومعه","https://www.aldiwan.net/poem23741.html","السريع"],[164,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[358,"هذي هي المرآة تجلى لمن","https://www.aldiwan.net/poem39764.html","السريع"],[422,"هذي هي الفلك فتح الخير كنيتها","https://www.aldiwan.net/poem53889.html","البسيط"],[422,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[438,"عاد له الدهر كما قد بدا","https://www.aldiwan.net/poem12389.html","السريع"],[447,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[458,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[484,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[543,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[549,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[580,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199616","المسحوب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62584","البسيط"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130881","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48913","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58410","المجتث"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100785","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100810","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110067","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216809","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102976","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83490","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52132","الكامل"],[4728,"هذا انت حيّ ومعْتبرْك مْتوفّي","https://www.poetsgate.com/ViewPoem.aspx?id=176896",""],[4755,"مَهما رَأَت عَيناكِ مِن بُؤسِه","https://www.poetsgate.com/ViewPoem.aspx?id=183671",""],[4797,"عقب اربعين سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=180552",""],[4898,"إنّا هُنا !","https://www.poetsgate.com/ViewPoem.aspx?id=35811",""],[4908,"أذن الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=207412",""],[5010,"أمتنا والفتنة الحمقاء","https://www.poetsgate.com/ViewPoem.aspx?id=190371",""],[5032,"جبل الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=189969",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5089,"عرِّجْ على هذا الجمال الأقدسِ","https://www.poetsgate.com/ViewPoem.aspx?id=128710",""],[5111,"غَفْوةُ الْحَلاجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212222",""],[5135,"يا دارُ","https://www.poetsgate.com/ViewPoem.aspx?id=201991",""],[5174,"لغتنا.. عزَّتنا","https://www.poetsgate.com/ViewPoem.aspx?id=199656",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5277,"نؤومُ المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=191348",""],[5335,"اطعن","https://www.poetsgate.com/ViewPoem.aspx?id=35185",""],[5455,"سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=34425",""],[5628,"الغروب والذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=178450",""],[5720,"وَطَنِي رِجَالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207270",""],[5821,"الروح للروح","https://www.poetsgate.com/ViewPoem.aspx?id=113758",""],[5829,"هذي دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=214085",""],[5848,"تفاصيل الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=52029",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[5950,"هذي هي أخباري","https://www.poetsgate.com/ViewPoem.aspx?id=128134",""],[5956,"الشر فينا منذ قابيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192436",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""],[6171,"عُرسُ الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86324&r=&rc=7",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""]],"verses":[["هذي هي الرؤيا وهل تعبيرها","إلاّ دمشق تفوز باستقلالها",0,"ل",3,0],["هذي هي الدنيا وأبناؤها","في يومنا والحِقب الغابره",1,"ر",2,0],["هَذي هِيَ الدُنيا الَّتي أَحبَبتَها","وَسَقَيتَ غَيرَكَ حُبَّها أَكوابا",2,"ب",2,0],["هَذي هِيَ الدُنيا الجَديدَةُ فَاِنظُري","فيها ضِياءَ العِلمِ كَيفَ تَأَلَّقا",3,"ق",2,0],["هذي هيَ الدُّنيا فمَاذَا الأَسى","يا قلبيَ الدَّامي وماذا الوُجُومْ",4,"م",1,0],["هَذِي هِيَ الدَّارُ الَّتِي قَلَّدْتَهَا","شَرَفاً بِهِ تَاهَتْ عَلَى الْجَوْزَاءِ",5,"ا",2,0],["هَذِي هِيَ الدَّارُ الَّتِي اسْتوْطَنْتِهَا","وَأُولَئِكَ الأَمْجَاد أَهْلُ الدَّارِ",6,"ر",1,0],["هذي هي التقوى، وتلك سبيلها","ما أكثر المُتَهَجِّدين الصُّوَّما!",7,"م",2,0],["هذي هي الدنيا فمن يستطع","دفع أذاها عنه فليدفعه",8,"ع",2,0],["هذي هي الآية الكبرى فلو فهموا","هذي الدقيقة ردتهم عقولهم",9,"م",1,0],["هَذي هِيَ المرآة تُجلى لِمَن","تشرى لَهُ بِالنَفس لا بِالثَمَن",10,"ن",1,1],["هذي هي الفلكُ فتحُ الخير كُنْيَتُها","فابشر فبُشراك بالخيراتِ بشراها",11,"ا",3,1],["هذي هي الدنيا كما تريانها","حرم اللبيب بها وفازَ الأَحمق",12,"ق",1,0],["هذِي هِيَ الجَنَّةُ قد عُجِّلَتْ","لو كانَ فيها أَحدٌ خُلِّدا",13,"د",2,0],["هذي هي الدار التي","أوعدتموها باقيه",14,"ي",2,0],["هذى هي العقبىَ لأحلام الصبىَ","ونهايةُ الايمانِ والأحلام",15,"م",1,0],["هذي هي الحجج التي أدلي بها","أتمتمها لبروره تتميما",16,"م",2,0],["هذي هي الحال والأقدار جارية","دارت عليها شؤون الخلق كالخلق",17,"ق",1,0],["هذي هىَ الدُّنيا وهذا حَالُها","اَلموتُ غايةُ كُلِّ حَيٍّ فانِ",18,"ن",1,0],["هذي هِيَ الكلماتُ بين أناملي","وردٌ بقاموسِ الربيعِ مُسَطَّرُ",19,"ر",1,0],["هذِي هي النَّفسُ التي","أَضحَى الأَجلُّ عِصامَها",20,"م",3,0],["هذيه حظ من وراه عنايه","والحظ يسعى لك بغير عنايه",21,"ه",1,0],["هذي هي السَّهلة البيضاء أنتَ لها","محيي ولا غَرْو إن أحييت ما سبقا",22,"ق",2,0],["هذى هي الشمس ان تمعن بها نظرا","يوما ويغشى عينك الضرر",23,"ر",1,0],["هذي هي الدنيا يسودُ قويُّها","وضعيفُها يمشي إلى اْستعباد",24,"د",1,0],["هذي هَدِيَةُ عيدٍ","يَرجو بها كُلَّ خير",25,"ر",1,1],["هذي هي الدار دار الأمن زاهرةٌ","تجنى من العدل نعماءً واسعادا",26,"د",2,0],["هذي هي الدنيا كما تبدو لكم","حِرمَ اللبيبُ وفاز فيها الأحمق",27,"ق",1,0],["هَذى هيَ الأَخلاق لا","ما يدّعيه المدّعونا",28,"ن",2,0],["هذي هيَ الظُلُمات فاترُك ظُلمها ال","داجي فما يدجو اليك ظَلامُ",29,"م",1,0],["هذي هي الجنة قد أزلفت","أليس هذا وصفها في الكتاب",30,"ب",1,0],["هذي هي النعمة العظمى لأمتّه","فيها السعادة والإجلال والجاه",31,"ا",2,0],["هذي هي الشمس لا تكثر لها نظراً","يوماً فيلحقك الأعياء والضرر",32,"ر",1,0],["هذي هي الأرباب فتتهم","وأخيل ظل يؤج محترقا",33,"ق",2,0],["هذي هداياه عندي لا تُعَدُّ وكم","أَغاثَني وتولّى حسنَ تَأديبي",34,"ب",2,0],["هذي هي الدنيا وهذا طبها","ليست تغيِّرُ طبعها دنيانا",35,"ن",2,0],["هذي هي أطلالك وهذا وقوفي","حتى عن مْصافحْك شيّمت كفّي",36,"ف",2,0],["هذي هيَ الأَرضُ التي دُورُنا","مَكبُوحَةٌ فِيها ومُنقادَةُ",37,"د",2,0],["هذي هي الطربه ومفتاح الاشعار","اللي بندفن عنّها ما انتهينا",38,"ن",2,0],["هَذِي هِيَ القُدْسُ الشَّرِيْفُ أمَامَنا","مِنَّا كَغَايَةِ عَدْوَةِ الغِزْلانِ",39,"ن",1,0],["هذي هيَ الدّنيا ببردةِ عاشقٍ","تتدثَّر الأشّواقَ فينا لنعشقا",40,"ق",2,0],["هَذِيْ هِيَ الْحَالُ فِي الشَّهْبَاءِ حَالَ بِهَا","حَرْبٌ ضَرُوْسٌ وَتَحْتَ الْقَصْفِ تَضْطَرِمُ",41,"م",1,0],["هَذِيْ هِيَ الْفِتْنَةُ الْحَمْقَاءُ تَسْحَقُنَا","وَلَا مَلَاذَ بِغَيْرِ اللهِ نَعْتَصِمُ",41,"م",1,0],["هذي هِيَ الحَرْبُ التي هِيَ نُفْسَها","في وَجْهِ أصْحابِ السِّياسَةِ تَبْصُقُ",42,"ق",1,0],["هذي هي الحال ُ يا مولاي َ قد فَتكت ْ","كلاب ُ كسرى بنا والعز ُّ مُسْتلب ُ",43,"ب",1,0],["هذي هي الآيات عند المقتفي","آثارَ ذاك الطَّهْلَسِيِّ الأنفس",44,"س",1,0],["هَذِيْ هُنَا لُغَةُ الإعْصَارِ تُجْرِفُنِي","حَرْفٌ عَلَى شَفَتَيَّ الصُّفْر يَنْتَحِرُ",45,"ر",1,0],["هٰذِي هِيَ الدُّنْيَا إِلَيْكَ دُرُوسَهَا","تَبْقَى الدِّيَارُ وَيَذْهَبُ الخِلَّانُ",46,"ن",1,0],["هذي هي الحكمةُ الكُبرى، وذي لغتي","فيها جلالٌ عظيمٌ جلَّ مُعْلِيْهَا",47,"ي",3,0],["هذي هي الخلق التي عن أحمد","ورثت فأين سريره وبناؤه",48,"ا",3,0],["هذي هنا كلُّ القصائدِ تنتهي","أتبثّها رملا يزين طويلكْ",49,"ك",1,0],["هذي هي اوراق شعري تحتري ندك","من غيبتك والدفاتر بيض وعجافي",50,"ف",2,0],["هذي هي اللي عرّفتني على الشوق","هذي قدر .. ماكنت حاسب حسابه",51,"ب",2,0],["هذي هي النفسُ أشتاتٌ مُشتتة ٌ","راحتْ بكلّ مفيض السحْرِ تُنتَهبُ",52,"ب",1,0],["هذي هي الشرقية الشماء قد","صارت كنجم دائم اللمعانِ",53,"ن",1,0],["هذي هديه لك من الروح للروح - فيها تحياتي وكل احترامي","فيها رساله اسمها روح مسموح - وصوره تعيد احساس كل الاسامي",54,"م",2,1],["هذي هي الحسناء مطلب عاشق","بُذلت لها الارواحُ. جلَّ رجاؤها",55,"ا",3,0],["هذي هي اول مرة تسافر وانا اسافر بلا","توديع رغم إنا سوى نكره تفاصيل الوداع",56,"ع",1,1],["هٰذي هِيَ الُأرْدُنُّ فَاهْبِطْ دونَها","فَعَلى الثَّرى لا تَستَضيفُ عَميلا",57,"ل",2,0],["هذي هي أخباري اللي مبطي أخباري","ما جد عقبك جديد ولا سأل عنّي",58,"ن",2,0],["هذي هي الدنيا نقلّم ظِفرها","ويعود ينمو مثلما الأغصانُ",59,"ن",1,0],["هذي هي الحقيقه من غير تشفير","واضحه للعلن انت وش حسبالك",60,"ك",1,0],["هذي هي الذروة العليا التي سقطت","علوم كل البرايا عن ترقيها",61,"ي",3,0],["هذي هي الضربة الكبرى التي قصرت","أعمال كل البرايا عن مجاريها",62,"ي",3,0],["هذي هي النعمة العظمى فليس سوى","طه وحيدرة منهم بحاويها",63,"ي",3,0],["هذى هي الأىامُ قَد نَثَرتْ عَلَىَّ","نِثَارَها فانظُر فُؤَادي واْهتَدِ",64,"د",1,0],["هذي هي الدمام دعوة صادق","ومن القصيم نفاسة وعمارُ",65,"ر",1,0],["هذي هِيَ البِيدُ إِذْ تَكتَظُّ شَاخِصَةً","في نحر أُنثَى تَرَى الأَفْلاَكَ خُطَّابا",66,"ب",2,0]]}