{"poems":[[55,"ما لخيال الحبيب قد طرقا","https://www.aldiwan.net/poem29928.html","المنسرح"],[78,"يا هلالا قد تجلى","https://www.aldiwan.net/poem39330.html","مجزوء الرمل"],[376,"ما لخلق الأمير ثان نرجي","https://www.aldiwan.net/poem56985.html","الخفيف"],[567,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96686","الرمل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138724",""],[5314,"عودة الذات","https://www.poetsgate.com/ViewPoem.aspx?id=214821",""]],"verses":[["ما لِخَيالِ الحَبيبِ قَد طَرَقا","وَما لِهَذا المُحِبِّ قَد قَلِقا",0,"ق",2,1],["مَا لِخَدَّيْكَ اسْتَعارا","حُمْرَةَ الوَرْدِ المُنيرْ",1,"ر",1,0],["ما لخُلقِ الأَميرِ ثانٍ نُرجِّي","هِ فلا لِلغِنى ولا لِلمَلاهي",2,"ي",1,1],["ما لخُرْشيدَ في الكِرامِ مثالٌ","مَن تُراهُ للشَّمسِ يبغي مِثالا",3,"ل",2,0],["ما لخلّافِ الرجا وَالوعد ما","جادَ لي بِالوعدِ إلّا وخلَف",4,"ف",1,0],["ما لخلق سوى النبي وسبطيه","السعيدين هذه العلياء",5,"ا",2,0],["مالخطب لو عادت إلي نضارتي","مالضير لو رممت بعض حطامي",6,"م",2,0]]}