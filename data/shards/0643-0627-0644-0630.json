{"poems":[[55,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"قل لأيوب والكلام سجال","https://www.aldiwan.net/poem65887.html","الخفيف"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[53,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[64,"صنوان ضدان أب واحد","https://www.aldiwan.net/poem52181.html","السريع"],[82,"أدهم كالظلام تشرق فيه","https://www.aldiwan.net/poem31265.html","الخفيف"],[82,"حبذا فتيان صدق أعرسوا","https://www.aldiwan.net/poem31454.html","الرمل"],[82,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[48,"يا ملوك البلاد فزتم بنسء ال","https://www.aldiwan.net/poem22029.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19742",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[133,"أتملي من محاسنها","https://www.aldiwan.net/poem67436.html","المديد"],[203,"لا أعذل الدهر على","https://www.aldiwan.net/poem45399.html","مجزوء الرجز"],[266,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[438,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[469,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[484,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[510,"نحن لا نكذب ولكن نتجمّل","https://www.aldiwan.net/poem27793.html","الخفيف"],[510,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82240","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27438","المديد"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27814","الكامل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127380","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204497","الخفيف"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35899","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205743","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205734",""],[4392,"","https://poetry.dctabudhabi.ae/diwan/poem/101564","الكامل"],[4767,"لملم جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=198534",""],[5038,"في الحكمة / النميمة4","https://www.poetsgate.com/ViewPoem.aspx?id=190196",""],[5187,"حواء وتجربتي","https://www.poetsgate.com/ViewPoem.aspx?id=29256",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5542,"قراءة متأنية في سجل التطرف","https://www.poetsgate.com/ViewPoem.aspx?id=10031",""],[5952,"كفكف الدمعات","https://www.poetsgate.com/ViewPoem.aspx?id=203111",""]],"verses":[["كَالَّذي يَخبِطُ الظَلامَ وَقَد أَق","مَرَ مِن خَلفِهِ النَهارُ المُضِيُّ",0,"ي",1,0],["كَالَّذي شاوَرَ الدُجى في سُراهُ","وَاِستَغَشَّ النُجومَ وَالأَقمارا",1,"ر",2,0],["كالذَّابل الخطيّ لكنَّه","في البرّ أو في الخصب ريَّانه",2,"ن",2,0],["كالَّذي غرَّه السَّراب بما خي","يَل حتَّى هراق ما في السِّقاءِ",3,"ا",2,0],["كالذي حاقَ بالمؤيَّدِ منكُمْ","بعدما نُوِّطَتْ به الآمالُ",4,"ل",1,0],["كالذي أدركَ المؤيدَ منكم","وهْو في رأسِ نجوةٍ لا يُنالُ",4,"ل",1,0],["كالذي يعكسُ الشِّهابَ ليَخْفَى","وهْو أدنى لهُ إلى التَّضريم",5,"م",1,0],["كالذي ذَاده السُّقاة عن الما","ء ولم يشفِ ما به مِنْ أُوامِ",6,"م",1,0],["كالذي لم تزلْ عليه قديماً","مِن صيامٍ ومن تَجافي جُفون",7,"ن",1,0],["كالذهب الإبريز باقٍ على ال","نار صبور ليس بالهاربِ",8,"ب",1,0],["كالّذي يخضب المشيبَ ويبقي","شاهدات بهنّ نفي الظنونِ",9,"ن",1,0],["كَالَّذي يأمرُ بالكرِّ ولا","يَصْطلي نارَ الوَغى حَيثُ تَفور",10,"ر",1,0],["كالّذي يلعبُ في شطرنجه","رأيُهُ عنه تَخَطّى في اللّعب",11,"ب",1,0],["كَالَّذي قامَ يَجمَعُ الزَنجَ بِالبَص","رَةِ وَالقَرمَطِيَّ بِالأَحساءِ",12,"س",3,0],["كالذهب الأبريز","والثوم عليها كالدرر",13,"ر",1,0],["كَالذئْبِ لَمْحاً فِي الدُّجى","كَالحُوْتِ خَوْضاً فِي العَرِمْ",14,"م",1,0],["كالذي يعبُدُ خالِقَهُ","في سَنا الرَوضِةِ والعِطرِ",15,"ر",1,0],["كالذهبِ الإبريزِ","من ينقدهُ يبردُهُ",16,"د",2,0],["كالذي ملّك أيدي الن","نار أطراف الرصاص",17,"ص",1,0],["كالذي أغرق السفين بما خف","ت من الماء حين خاف الماء",18,"ا",2,0],["كالذهبِ الأحمرِ قد صيغَ أُكَرْ","من صنعةِ الخالقِ لا صنع البشرْ",19,"ر",1,0],["كالذرّ عاطرةٌ فإن جحدَ أمروء","ما قلتهُ فقيأتنا بنديدها",20,"د",3,0],["كالذي في الشعر عمدته","رفعت من شأن راويه",21,"ي",2,0],["كالذِّئابِ حاقتْ بنا ردَّ دينٍ","تشهدُ الأيدي قبضَهُ والسّطورُ",22,"ر",1,0],["كالذُّبابِ تهيجُ تلك الحقوقُ","لوْ شكا فِي القُمامِ فأرٌ سَقيمُ",23,"م",1,0],["كَالذي كانَ وَالصَّفاءُ مَصونٌ","لَم تَشُبهُ بِهِجرَةٍ وَاِجتِنابِ",24,"ب",1,0],["كالذي جاءتْ مسطرة","وهي سرٌّ في قَضا وقَدَر",25,"ر",1,0],["كالذر ينشرُه الإله بموقفٍ","ليذوقَ فيه خزيه ونكالا",26,"ل",2,0],["كالذي قالوه عني","بل أرى شبحا سخيفا",27,"ف",2,0],["كالذي يحصر الحياة بواد","ضيّقٍ فيه روضة غناءُ",28,"ا",2,0],["كَالَّذي قَد عَهِدتُ لا مُعرِضاً عَن","ني وَلا واجِداً وَلا مُستَحيلا",29,"ل",2,0],["كالذي يشهد الكوارثَ فنًّا","من فنون التمثيل والإخراج",30,"ج",1,0],["كالذي يهجر الديا","رَ إذا ارتاض واختلى",31,"ل",2,0],["كالذكر يمنع ما أتي للدين من","خطب الأذان لمنهج الحنفاء",32,"ا",2,0],["كالذئب تعوي حولنا وكأننا","مِمَّا تُهدِّدُنا به أغنام",33,"م",1,0],["كَالذِّئْبِ كُنْ لاتَأْمَنَنَّ لِوِدِّهِ","لابُدَّ بَينَ النّاسِ نَمَّ عَلَيْكا",34,"ك",2,0],["كالذِّئبِ أرْصُدها وأتركُها","ما بينَ رابيةٍ ومُنحدرِ",35,"ر",1,0],["كالذئب من يرمي إليك بنظرة","مسمومة مهما بدا متأنقا",36,"ق",2,0],["كالذئب من يرمي إليك بنظرة","مسمومة مهما بدى متأنقا",37,"ق",2,0],["كالّذي يهدي اليك الورد لم","يدر إذ حتماً سيُدميكَ الأسَلْ",38,"ل",1,0]]}