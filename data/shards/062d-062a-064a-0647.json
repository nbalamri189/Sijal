{"poems":[[23,"ولأصدقن إلى حذيفة مدحتي","https://www.aldiwan.net/poem21598.html","الكامل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[104,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[113,"عهدي بدار المنجكي محمد","https://www.aldiwan.net/poem16360.html","الكامل"],[230,"يا بنت روما لا تكوني كما","https://www.aldiwan.net/poem55110.html","السريع"],[369,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[445,"شكرا لمن أعطاك ما أعطاكا","https://www.aldiwan.net/poem34906.html","الكامل"],[458,"يا منطق الموتى إليك هدية","https://www.aldiwan.net/poem61701.html","الكامل"],[520,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66762","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66726","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87176","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48553","الكامل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117694","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118092","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105434","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118299","البسيط"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110705","السريع"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105076","الكامل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10446","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202726","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112645","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127036","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126923","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86298","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138555",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138592",""],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199025","الرجز"],[4008,"","https://poetry.dctabudhabi.ae/diwan/poem/141908","الكامل"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138771",""],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143719","البسيط"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124117","الكامل"],[4767,"مقام الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=179965",""],[4883,"الفلوجة دائماً","https://www.poetsgate.com/ViewPoem.aspx?id=48356",""],[5589,"ما لم يقله الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=187960",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5616,"نُقوشٌ إسلاميَّةٌ على الحَجرِ الفِلَسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205253",""],[5953,"بيني وبينك عصمة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=93833",""],[5956,"شعلة الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=182637",""],[5956,"خبثُ الأطفال وبراءة الأطفال","https://www.poetsgate.com/ViewPoem.aspx?id=193876",""],[6355,"المرء بالشر مفتون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66615&r=&rc=75",""]],"verses":[["حَتّى هَوى مُتَزايِلاً أَوصالَهُ","لِلخَدِّ بَينَ جَنادِلٍ وَقِفافِ",0,"ف",1,0],["حَتّى هَبَطنَ مِنَ الوادي لِغَضبَتِهِ","أَرضاً تَحُلُّ بِها شَيبانُ أَو غُبَرُ",1,"ر",1,0],["حَتَّى هَوَتْ فجعلتَ الصدرَ مَوضِعَهُ","كأنّهُ منه بِضْعٌ غَيرُ مُنفَصِلِ",2,"ل",1,0],["حَتّى هَداني وَمِيضُ سارية","أَعقبه قاصف يَفجّرها",3,"ر",3,0],["حَتى هتفت بك اليو","م بين جمٍّ غفير",4,"ر",1,0],["حَتّى هَوى بَدر الكَمال وَكَوَرَت","شَمس السَماحة في بُروج لحود",5,"د",1,0],["حتّى هَوَت لِلقاعِ معمورةً","فَدَنِّسَت مَثنى نَفيسِ اللآلي",6,"ل",2,0],["حتّى هَزَمْنا للظّلامِ جُنودَهُ","لمّا تَشاهَرْنا عليه الألْسُنا",7,"ن",2,0],["حَتَّى هُزِزْتُ فَلا زَنْدُ القريضِ كَبَا","فيما لَدَيَّ ولا سيفُ البدِيهِ نَبا",8,"ب",2,0],["حتى هَوَتْ قَدَماهُ فِي ظُلَمِ الرَّدى","لما اهْتَدى فِيهَا بِغَيْرِ هُدَاكا",9,"ك",2,0],["حتى هَرعت إليه تنقذُ وشلةً","بقيت وُترجعه إلى قِرطاسه",10,"س",2,0],["حتى هجمت هجوم الريح في طفل","من العجاجة مستغن عن الطفل",11,"ل",1,0],["حتى هوى من جوفِه نضناضةٌ","تَنضَحُ سُمّاً باللعابِ المنسدِلْ",12,"ل",1,0],["حتى هوت قعرَ بُرهوتٍ معذّبةً","وجسمُه في كنيفٍ بين أقذارِ",13,"ر",1,0],["حَتّى هزمت لَدى النِزال جُموعَهم","بِالصَبر لا بمثقفٍ وَيمان",14,"ن",1,0],["حتى هوت في لجة ال","يَمِّ الخِضَمِّ الاثنتان",15,"ن",1,0],["حتى هوى على الثرى موزعا","بين المواضي والقنا مفرقا",16,"ق",2,0],["حتى هممتُ بأن أقبلَ خدهُ","هبت وغطت وجههُ بقبائه",17,"ه",1,0],["حتى هدمت منار الشرك حين علا","من بعد ما شب في الآفاق واتقدا",18,"د",2,0],["حتى هوى متشحطاً بدماه من","سهم أصاب حشاه من يد خاطي",19,"ط",2,0],["حتى هممت بشيء ما هممت به","ازمان لاق باشكالي واكفائي",20,"ا",2,0],["حتى هوت للغرب شهب الدجا","والنجم في أسرائه ينعس",21,"س",1,0],["حتى هوت صرعى فتحسب انها","أقمار تمّ في الطفوف غواربا",22,"ب",2,0],["حَتّى هَوى مُتَدائِلاً أَوصالُهُ","لِلحَدِّ بَينَ جَنادِلٍ وَقِفافِ",23,"ف",1,0],["حتى هوى في بؤرة النيران","فاستقبلته عرائس النيران",24,"ن",1,0],["حتى هوى للأرضِ بينَ القتلى","فارقَ منه قوة وحَولا",25,"ل",2,0],["حَتّى هَوى فَهوى به","صرح العلا وَتهدّما",26,"م",2,0],["حتى هوى للثرى ظامي الحشا وغدا","من فيض منحره الهندي ريانا",27,"ن",2,0],["حتى هووا صرعا دون ابن فاطمة","يرون صاب الردى كالمنهل العذب",28,"ب",1,0],["حَتّى هَوى بي الهَوى جَهلاً فَصِرتُ بِهِ","كَتائِه حائِرٍ لَم يَدرِ ما صَنَعا",29,"ع",2,0],["حتى هووا فوق الثرى سجداً","لله في حمدٍ وتسبيح",30,"ح",1,0],["حتى هوت في الثرى اجسادهم فرقت","منها النفوس باعلا حضرة الكرم",31,"م",1,0],["حتى هدى الله بهم من اهتدى","لولاهم لأصبح الناس سدى",32,"د",2,0],["حتى هززن البيض أصناف القنا","بسنان لحظٍ فاتك وسنان",33,"ن",1,0],["حتى هناك حلبن من رؤسائكم","دما به هاماتهم تتطايح",34,"ح",1,0],["حتى هتكْتُ رِواقُ المُلكِ عن شَرِسٍ","يُرضي السيوفَ من الجاني إذا غَضبا",35,"ب",2,0],["حتى هوى وهوى فكان فقيدهم","كبر المصاب إذ الفقيد زعيم",36,"م",1,0],["حتى هوى مستلقياً ومقبِّلاً","ما استقبلته بوجهها الغبراء",37,"ا",2,0],["حتى هطل وسم ٍ صدوق ٍ ومدرار","على جباه المُتقين المناعير",38,"ر",1,0],["حتى هتافات الفضيلة نكّست","أتظن أن المجد يعلوه الصدأ ؟!",39,"ا",1,0],["حتى هزمنا وما عادت لنا ذمم","وَشَاخَ منا سِنُونَ العُمْرِ والعَظَمِ",40,"م",1,0],["حَتَّى هَتَفْتُمْ وَنَارُ الْعِشْقِ تَصْهَرُكُمْ","إِنَّا بِمَهْرِكِ يَا حَسْنَاءُ نَبْتَدِرُ",41,"ر",1,0],["حتى هبطنا بالذنوب إلى التي","صارت لنا سجناً من الأسجان",42,"ن",1,0],["‏ ‏حتى هرمتُ وإن العمر محتَسَبٌ","‏ ‏ وقت الطفولة والريعان لا الهرم",43,"م",1,0],["حتى همُ الأطفال دون براءةٍ","لكنهم فازوا بتعميم قد اشتُهِروا به",44,"ب",2,1],["حتى هدمْنا بأيدينا منائرنا","فلم يقمْ في الحنايا للهدى وطن",45,"ن",1,0]]}