{"poems":[[23,"ولأصدقن إلى حذيفة مدحتي","https://www.aldiwan.net/poem21598.html","الكامل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[102,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[109,"عهدي بدار المنجكي محمد","https://www.aldiwan.net/poem16360.html","الكامل"],[225,"يا بنت روما لا تكوني كما","https://www.aldiwan.net/poem55110.html","السريع"],[364,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[439,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[439,"شكرا لمن أعطاك ما أعطاكا","https://www.aldiwan.net/poem34906.html","الكامل"],[453,"يا منطق الموتى إليك هدية","https://www.aldiwan.net/poem61701.html","الكامل"],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"]],"verses":[["حَتّى هَوى مُتَزايِلاً أَوصالَهُ","لِلخَدِّ بَينَ جَنادِلٍ وَقِفافِ",0,"ف",1,0],["حَتّى هَبَطنَ مِنَ الوادي لِغَضبَتِهِ","أَرضاً تَحُلُّ بِها شَيبانُ أَو غُبَرُ",1,"ر",1,0],["حَتَّى هَوَتْ فجعلتَ الصدرَ مَوضِعَهُ","كأنّهُ منه بِضْعٌ غَيرُ مُنفَصِلِ",2,"ل",1,0],["حَتّى هَداني وَمِيضُ سارية","أَعقبه قاصف يَفجّرها",3,"ر",3,0],["حَتى هتفت بك اليو","م بين جمٍّ غفير",4,"ر",1,0],["حَتّى هَوى بَدر الكَمال وَكَوَرَت","شَمس السَماحة في بُروج لحود",5,"د",1,0],["حتّى هَوَت لِلقاعِ معمورةً","فَدَنِّسَت مَثنى نَفيسِ اللآلي",6,"ل",2,0],["حتّى هَزَمْنا للظّلامِ جُنودَهُ","لمّا تَشاهَرْنا عليه الألْسُنا",7,"ن",2,0],["حَتَّى هُزِزْتُ فَلا زَنْدُ القريضِ كَبَا","فيما لَدَيَّ ولا سيفُ البدِيهِ نَبا",8,"ب",2,0],["حتى هَوَتْ قَدَماهُ فِي ظُلَمِ الرَّدى","لما اهْتَدى فِيهَا بِغَيْرِ هُدَاكا",9,"ك",2,0],["حتى هَرعت إليه تنقذُ وشلةً","بقيت وُترجعه إلى قِرطاسه",10,"س",2,0],["حتى هجمت هجوم الريح في طفل","من العجاجة مستغن عن الطفل",11,"ل",1,0]]}