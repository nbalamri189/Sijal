38700",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101237","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45837","البسيط"],[3629,"","https://poetry.dctabudhabi.ae/diwan/poem/97614","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66326","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85189","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85167","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66582","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35535","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40128","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69907","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70012","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127253","السريع"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102731","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105526","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90845","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90797","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90803","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90743","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90828","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90844","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94870","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73097","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83554","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83169","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72481","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139683",""],[4767,"نبئت","https://www.poetsgate.com/ViewPoem.aspx?id=93823",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""]],"verses":[["لِلَّهِ بَحرٌ ما هَتَفتُ بِهِ","حَتّى اِستَهَلَّ عَليَّ وَاِنبَجَسا",0,"س",2,0],["لِلَّهِ بيتٌ رَفَعتَ عِمَّتَهُ","أَغناهُ سُلطانُهُ عَنِ العَمَدِ",1,"د",1,0],["لِلّهِ بَيْتٌ شَدَّ مِنْ أطْنابِهِ","رَكْزُ القَنا في ثُغَرِ القَنابِلِ",2,"ل",1,0],["لِلَّهِ بَنْيونُشٌ تَحْكِي مَنَازِلُهَا","كَوَاكِباً أَشْرَقَتْ فِي جُنْحِ ظَلْمَاءِ",3,"ا",2,1],["لِلَّهِ بَيطارٌ بِحمصٍ ما رَنا","إِلّا وَسَلَّت مُقلَتاهُ مخذَما",4,"م",2,1],["للَه بين بني نوالك فتيةٌ","طلبوا الفنون فأتقنوا وأجادوا",5,"د",3,0],["للَه بيتٌ رحيبٌ","مشيدٌ للصناعه",6,"ع",2,1],["لله بحرك والصِّبا قد سرَّدْتْ","منه دروعاً تحت أعلام الشجرْ",7,"ر",1,0],["لله برّك ما أحلى تكتّمه","في الخلق لو كانَ عُرفُ المسك يكتتم",8,"م",1,0],["للَه بالشام وفي بابلٍ","بيتان بيتُ القدس والمقدِس",9,"س",1,0],["لِلَّهِ بُستاني وَما","قَضَّيتُ فيهِ مِنَ المآرِب",10,"ب",1,1],["لِلَّهِ بِالحَدباءِ عَيشي فَكَم","وَرَدتُ مِن عَينٍ بِها جارِيَه",11,"ه",1,1],["لِلَّهِ بِالزَوراءِ لَيلَتُنا وَقَد","جَرَّدتُ غُصنَ البانِ مِن سِربالِهِ",12,"ل",2,0],["للَّه بالعيد بيضُ الغيدِ نافرةٌ","أهْيَ الحمائم شَامتْ أشْهباً قَرِمَا",13,"م",2,0],["لِلَّهِ بَردٌ ما أَشَد","دَ وَمَنظَرٌ ما كانَ أَعجَب",14,"ب",1,1],["لله بحرُ الروم وهْوَ بحيرَةٌ","عربيَّةُ اللَّهَوَاتِ وَالأَرحامِ!",15,"م",1,0],["للهِ بردٌ ما أش","دَّ ومنظرٌ ما كانَ أعجبْ",16,"ب",1,1],["لِلّهِ بَدر المُصلى إِذ مَشى مَرَحاً","وَالزَهو يَسحَب ذَيل الدَل وَالخَفر",17,"ر",1,1],["لله بالله مضت ايامنا","وسجف التقوى عليها تضرب",18,"ب",1,0],["لله بدر جلالٍ كان منزلهُ","منا القلوبَ فأضحى طيَّ أكفانِ",19,"ن",1,0],["لِلَّهِ بَذلُكَ حينَ لا مُستَمنَحٌ","يُرجى وَمَنعُكَ حينَ لا مُستَعصَمُ",20,"م",1,0],["لله بالعبد لطف لو فطنت له","ما بعد ومك طول الليل بالسهر",21,"ر",1,0],["لِلّهِ بَدرُ الدِينِ مِن مَلِكٍ فَما","أَوفى وَأكفى لِلخُطُوبِ وَأَحمَلا",22,"ل",2,0],["لِلَهِ بَينٌ جارَ في وَقعِهِ","عَقلي وَلُبّي قَد غَدا مُعجَبا",23,"ب",2,0],["للّه باكٍ على زلّاتهِ ندماً","دماً يُخضّبُ منه النحوُ مسفوكُ",24,"ك",1,0],["لله (بدرٌ) عَلَى علاّتِه رجلاً","يولى الجميلَ بما أُوتيه من كرم",25,"م",1,0],["لِلَهِ بارِقَةٌ لِلقَلبِ قَد لَمَعَت","مِن عالَمِ الأَمرِ لا مِن عالَمِ الصُوَرِ",26,"ر",1,0],["لِلَّهِ بِرْكَتُكَ التي حَسُنَتْ","نَظَراً لِوَجهِكَ حِينَ تَبتَسِمُ",27,"م",1,1],["للّه بيض خلال السطر نقرؤها","من بين مختلف الالوان مختلط",28,"ط",1,0],["للهِ بدْرٌ وأطرافُ القنا شُهُبٌ","يَجلوهُ فيهِنَّ من صُدْغَيْهِ لَيْلان",29,"ن",1,0],["للهِ بكَفِّ خليفتهِ","سَهْمٌ وإليه تَسَدُّده",30,"د",2,0],["لِلَهِ بابٌ مِنكَ في أَرضِهِ","ما دونَهُ مَلجاً وَلا مَقصِدُ",31,"د",1,0],["للَه بحر ندىً إذا بحرُ الرَّدى","أمسى يعبُّ غدا عليه زاخِرا",32,"ر",2,0],["للّه بحرٌ منك زاخر","أعطى اللآلي والجواهر",33,"ر",1,1],["للَّه بستان أنسٍ ساد مرتفعاً","مذ حلّ فيه بشير المجد ذي العظم",34,"م",1,1],["للَه بركتها الكبيرة","مورد الطرب الوفير",35,"ر",1,0],["لله باب على القبلي متجه","بقوسه الكوكب السيارة قد صدا",36,"د",2,1],["للهِ بدرٌ أشرقَتْ","شمسُ المدامةِ في يمينِهْ",37,"ن",2,1],["لله بيت نماكم ما اجلكم","من معشر طيب الأعراق محمود",38,"د",1,0],["للّه بأسك يوم الروع إذ شفيت","منك الجماجم بالهنديّ والقصرُ",39,"ر",1,0],["للّه بيتُك أمنُهُ وجِفانُهُ","والحق بين مَخافةٍ وجُدوبِ",40,"ب",1,0],["للّه بيتا بنيت فابشر","يا من صراطه مستقيم",41,"م",1,1],["للّه بينَ بيانهِ وبنانِه","كنزٌ أفادَ السائِلينَ بدُرّهِ",42,"ر",2,0],["لله بالبيت المقدَّسِ جامعٌ","بهر النواظرَ نورُهُ وضياؤُه",43,"ا",3,1],["لله بارضَةُ الأنوارِ مخجلةٌ","نَوْرَ الرَّبيعِ إذا ما نوْرُهُ برَضا",44,"ض",2,0],["لله بحر ندى وعلم زاخرٍ","فضح البحور بسيبه المتهللِ",45,"ل",1,0],["لله بالبحرين بح","رٌ بالمكارم مزبدُ",46,"د",1,0],["لله بالجرداء وقفتنا ولم","يَكُ بيننا إلاَّ منادمةُ الجوى",47,"و",2,0],["لله بشراك قبل الندى","يبشر الوفد بنجح الطلب",48,"ب",1,0],["لِلَّهِ بَهوٌ عَزَّ مِنهُ نَظيرُ","لَمّا زَها كَالرَوضِ وَهوَ نَضيرُ",49,"ر",1,1],["لِلّه بيتك فيه الوفد عاكفة","كأنه كعبة أضحى إلى الأمم",50,"م",1,0],["للهِ بردُ خوارِزْمٍ إذا كَلِبَتْ","أنيابُهُ وكسَتْ أبدانَنَا الرَّعدَا",51,"د",2,1],["لله بُزلُ اليَعملاتِ فإنّها","عونُ المشوق على مجانبة الكَرى",52,"ا",1,0],["لله بحْرُ النّخلتَيْنِ وما حوى ال","بحرُ المَشيدُ به المقام الأعظمُ",53,"م",1,0],["لله بلدة بعلبك بقعة","رق النسيم بها وراق الماء",54,"ا",2,1],["لله بُرؤكَ من شكوىً بها لكَ دا","مَ الأجرُ وهي بحمدِ الله لم تَدُمِ",55,"م",1,0],["لله بدراً لم تزل","وجناته تتوقد",56,"د",1,0],["للّه باللّه بل في اللّه خدمته","للهاشمي صفيّ اللّه مختاره",57,"ر",2,0],["لله بل للحسن ماء أحكمت","فسقية تصعيده فتقطرا",58,"ر",2,1],["لله بأسك والسيوف مجالها","بين الظُّلى وحلى السيوف دماء",59,"ا",2,0],["لله بأسك عند مشتجر القنا","والجو قد لبس العجاج الأكدرا",60,"ر",2,0],["لله بدرٌ تبدَّى","إليَّ من مطلعيه",61,"ي",2,0],["لله بيتٌ بالحجاز محرَّمٌ","لا يدخل الإنسانُ فيه حلالا",62,"ل",2,0],["لِلَّهِ بِالفُسطاطِ صادِحُ رَوضَةٍ","مُتَنَقِّلٌ فَوقَ المَنابِرِ شادي",63,"د",2,0],["للَه بيت للعلوم سما به","شرف له الجوزاء طأطأ هامها",64,"م",3,0],["لِلّه بَيتك فَهوَ كَعبة أَنعم","تَسعى العفاة لَهُ بِكُل سَبيل",65,"ل",1,0],["لِلّه بَدر الجعفريين الَّذي","أَبدى برغم المكرمات غُروبا",66,"ب",2,0],["لِلّه بَيتُكُمُ آل الخليل فَما اس","تدار إِلّا عَلى الأَبدال وَالأُمَنا",67,"ن",2,0],["لِلّه بَرق الثَغر مِن خلَّبٍ","يَبخل بِالريِّ وَيُعطي السَنا",68,"ن",2,0],["للَه بالزوراء أين رزية","ماد العراق لوقعها والشام",69,"م",1,0],["لله بيت على هام السهى ضُربت","اطنابه وغدت مرفوعة العمد",70,"د",1,1],["لله بارق يمن في الحمى لمعا","وبدر أنس على افق الهنا طلعا",71,"ع",2,1],["للّه بعنا وطناً لم يذمم","للّه عطلنا رضاب الملئم",72,"م",1,0],["لله بدر حل في أفوله","بالقلب بعد منزل الذراع",73,"ع",1,0],["للَه بحر مكارم","عذب المشارع والتسارب",74,"ب",1,0],["للَه بدر علاً حاق المحاق به","قد بات أوج المعالي من سناه جلي",75,"ل",2,0],["لله بالشّطرنج بتُّ مُلاعبا","لمهفهف في حًسنه مُنتاه",76,"ه",1,0],["لله بن حمل الافاضل غدوة","وبنعشه المجهول توج هامها",77,"م",3,0],["للَه بيت عبادات به قبلت","أعمال من شاده فضلاً بإتقان",78,"ن",1,1],["لله باسل غداة جاءه","للدار جندٌ للدعي كالدبا",79,"ب",2,0],["لِلّه برق لاح من وادي الحما","ليلاً فأثر في حشاي لموعه",80,"ع",2,0],["لِلّهِ بَدر لَهُ في القَلب مَنزِلَة","وَالطَرف عَن حُسنِهِ لا يَبتَغي حولا",81,"ل",2,0],["لِلّه بُستاني إذا","يهفو بهِ القصبُ المندّى",82,"د",2,1],["للَّه بدر نوال","جلا ظلام النوى لي",83,"ي",1,0],["للَه بدر صين من محاق","تعنو له البدور في الأفاق",84,"ق",1,0],["للَه بدر ولكن لا أفول له","للَه غصن ولكن ليس من حطب",85,"ب",1,0],["لِلَّهِ بَحْرُ نَوالٍ جَفَّ مَشْرِعُهُ","وَطَودُ مُلْكٍ هَوَى مِنْ بَعْدِ تَشيِيدِ",86,"د",1,0],["لِلّهِ بَأسك وَالأَلبابُ طائِشَة","وَالخَيلُ تردي وَنارُ الحَربِ تَستَعرُ",87,"ر",1,0],["للَّه بَلجَةُ لَيلَةٍ مَحَصت بِهِ","واليوم دَبَّجَ وشْيَهُ ساعاتُهُ",88,"ت",2,0],["لِلّهِ ببتٌ بِنَصرِ اللَهِ مفتخرٌ","وَيوسف الحَسَن مَن لَقوهُ قد عَمرا",89,"ر",2,0],["لِلّهِ بولس مِن خدّام هَيكلِهِ","مِن جرَّماءً إِلى الدامور أَحياها",90,"ه",2,1],["لله بدر فيه دمعي همي","وقلبي المضنى به هاما",91,"م",2,1],["للَه بين لم يزل قلبي به","مما جنيتم في الهوى يتعشت",92,"ت",1,0],["للَه بدر من مراق نجيعه","مزج الحسام لجينه بالعسجد",93,"د",1,0],["للَه بارودي حزم محرق","أحشاء أفئدة العدا بضرام",94,"م",1,0],["للَه بهجة حسنها من روضة","للمجتلي والمجتني القطاف",95,"ف",1,0],["للَه بيت سيادة تسعى له","زمر السراة وسعيهم مشكور",96,"ر",1,0],["للَه بارودي عزم صادر","عن بحر حلم بالوفا عباب",97,"ب",1,0],["للَه بدر سعود غاب ثم بدا","يشف عن ملك في صورة البشر",98,"ر",1,0],["للَه بارودي عزم صادر","عن بحر حلم بالوفاء عباب",99,"ب",1,0],["لِلَّه بهجة حجرةٍ من حسنها","كلِفَت بمدح نظامها اللُوّامُ",100,"م",1,1],["للهِ بدرٌ بُرجُه في خاطري","يَسبي العقولَ جمالُه وسناؤُه",101,"ا",3,0],["لِلَّهِ بارِقَةُ الأَمَل","أَحيَت مَواتي بِالعجل",102,"ل",1,1],["لِلّهِ بَينَ بَنانَي كامِلٍ قَلَمٌ","يَفيضُ بِالسحرِ مِن إِنشائه العَجَبِ",103,"ب",1,0],["لله بنيان صف بالرجال عدا","فعدوه للأعادي خرق عادات",104,"ت",1,0],["لله بيتٌ شاده ومذ علت","قواعدٌ منه على السها رسا",105,"س",2,0],["لله بالإيمان يوصلها","كم طابَ ما أعطى وما بذلا",106,"ل",2,0],["لله بيت فوق مكة قائم","والأزهر المعمور بيت آخر",107,"ر",1,0],["للهِ باعوا مالهم ودماءهم","ليُمَتَّعوا بالروح والريحانِ",108,"ن",1,0]]}