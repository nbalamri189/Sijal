{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132733","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125802","المتقارب"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126357","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216343",""],[4883,"اطلق فمي","https://www.poetsgate.com/ViewPoem.aspx?id=48372",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[4119,"يا هل سمعتم بدير سمعان","https://www.poetsgate.com/ViewPoem.aspx?id=16235",""],[5219,"الأماني المنشودة","https://www.poetsgate.com/ViewPoem.aspx?id=194625",""],[5794,"علامك","https://www.poetsgate.com/ViewPoem.aspx?id=73681",""]],"verses":[["تسجد إن لاحَ رؤوس العالم","وراثة قد حازها من آدم",0,"م",1,0],["تسجعُ السجعةَ البديعةَ في الفجر","وتأتي بمثلها تكرارا",1,"ر",2,0],["تسجيع منتظمي والغرُّ من حكمي","ألفاظها بِفَمي دُرٌّ من الحكمِ",2,"م",1,0],["تسجدُ ديناً لها القلوبُ إذا","يقرأ ذكرٌ منها وترتيل",3,"ل",1,0],["تَسْجُدُ الهُضْبُ نَحْوَهُ ولو","استَعْصَتْ عليه لآدَنَتْ بالزَّوَال",4,"ل",1,0],["تسجف عزا بالحديد خدورها","فلو رام اقداماً بها الليث احجما",5,"م",2,0],["تَسجعُ ذات الأَطواق خاليَة","وَذو الهَوى فاقِد الأَخلاءِ",6,"ا",2,0],["تُسَجِّلُ مجدّك في سيرة","تُضاهي أجَلَّ وأسمى السير",7,"ر",1,0],["تسجّ ومما يستزيد انهمارها","دواهٍ شداد للخلائق جائحه",8,"ح",2,0],["تَسجِي أنهارٍ مَعْ بحورٍ تلاطِمَت","لي مِنْ تِرَضَّف مويها مَعْ شِمالها",9,"ل",3,0],["تسجن احلامي ورى شك النوايا","وش يفيد ان كان تطلق معصمي؟!َ",10,"م",2,0],["تسجل في التاريخ آية حكمه","وقد درأ الأحقاد في عهده شَذْبا",11,"ب",2,0],["تسجد للشمس وهي معرضة","في الأفق عنه بوجه غيران",12,"ن",1,0],["تسجو على أرق تصحو على قلقٍ","والروح مولعة حنت لذكراها",13,"ا",3,0],["تسج وتطلق النظره تسافر والدروب سهاد","تشيل الحزن في كفك تبلل منه أهدابك",14,"ك",1,0]]}