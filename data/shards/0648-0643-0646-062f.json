{"poems":[[29,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[23,"ألا أيها الساعي لتدرك مجدنا","https://www.aldiwan.net/poem21585.html","الطويل"],[30,"سمونا لنجران اليماني وأهله","https://www.aldiwan.net/poem5485.html","الطويل"],[51,"سلام على قبر النبي محمد","https://www.aldiwan.net/poem62046.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[141,"ألم تهتج فتدكر الوصالا","https://www.aldiwan.net/poem67908.html","الوافر"],[1124,"","https://poetry.dctabudhabi.ae/diwan/poem/202226","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77888","المنسرح"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66446","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58119","الطويل"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4955,"سيدنو الموت منا ذات يوم","https://www.poetsgate.com/ViewPoem.aspx?id=188782",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""]],"verses":[["وَكِندَةُ لَو نَزَلتَ بِهِم دَخيلاً","لَزادَهُمُ مَعَ الحَسَبِ اِشتِدادا",0,"د",2,0],["وَكِندَةُ فيها كُلُّ قَرمٍ سَمَيدَعٍ","أولَئِكَ أَصحابي وَوُدّي وَناصِري",1,"ر",2,0],["وَكِندَةُ لَم يَترُك لَهُم ذا حَفيظَةٍ","وَلا مَعقِلاً إِلّا أُبيحَت مَعاقِلُه",2,"ل",2,0],["وَكُن داخِلاً فيها كَأَنَّكَ خارِجٌ","إِلى غَيرِها مِنها مِنَ اليَومِ أَو غَدِ",3,"د",1,0],["وَكِندَةُ كَانَت بِالعَقِيقِ مُقِيمَةً","وَعَكُّ فَكُلاًّ قَد طَحَرناهُ مَطحَرا",4,"ر",2,0],["وَكِندةُ كانت بِالعَقِيقِ مُقيمَةً","وَنَهدٌ فَكُلاًّ قَد طَحَرناهُ مَطحَرا",5,"ر",2,0],["وَكِندَة إِذ هُم بِالحِصابِ عَشيَّةً","تُجيزُ بِهِم حجاج بَكرِ بنِ وائِلِ",6,"ل",1,0],["وَكِندَةُ وَالسَكونُ فَما اِستَقالوا","وَلا بَرِحَت خُيولُهُم الرِحالا",7,"ل",2,0],["وكندة الخير ما زالت لنا ولهم","حتى يرى فتح يأجوج ومأجوج",8,"ج",1,0],["وَكنَّ دراً وَلؤلؤاً حسنا","رطباً لَطيفاً مفصلاً قضبا",9,"ب",2,0],["وكن داعيا عند السجود تأدبا","وسبحه بالأجلال في كل ركعة",10,"ه",1,0],["وكن داعياً وأنصت لنصحي واعيا","ولا تك في جلب المكائد ساعيا",11,"ي",2,0],["وكن دليلي بدليل الخيراتْ","وباسمه مصحّحاً للحسناتْ",12,"ت",1,0],["وكنْ دائم الأفكار في خَلْقِ خالِقٍ","فتلكَ عباداتٌ لها الأجرُ يُجْزَلُ",13,"ل",1,0],["و(كندوزٌ) يعجِّزنا بشرْطٍ","وهل يأتي بخير ذلك (الشرْ..)",14,"ر",1,0],["وكن دوماً بكلِّ الحالِ عبداً","صبوراً لا يزعزعهُ العناءُ",15,"ا",2,0],["وَكُنْ دَوْمًا مَعَ الأَحْرَا","رِ ذَاكَ الْعِزُّ وَالْبِرُّ",16,"ر",1,0]]}