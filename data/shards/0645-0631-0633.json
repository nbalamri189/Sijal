{"poems":[[102,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[73,"مرسى السيادة سدة سيفية","https://www.aldiwan.net/poem3983.html","الكامل"],[0,"أيا هند لا تنكحي بوهة","https://www.aldiwan.net/poem67.html",""],[53,"يا فؤادي غلبتني عصيانا","https://www.aldiwan.net/poem66699.html","الخفيف"],[51,"لاح شيب الرأس مني فاتضح","https://www.aldiwan.net/poem62030.html","الرمل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[48,"أيتها النفس لا تهالي","https://www.aldiwan.net/poem23229.html","مجزوء البسيط"],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[113,"أصبح الملك للذي فطر الخلق","https://www.aldiwan.net/poem16182.html","الخفيف"],[168,"مني علي براحة من مهجة","https://www.aldiwan.net/poem67854.html","الكامل"],[347,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[469,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[543,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48705","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95564","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128056","السريع"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104809","المديد"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93946","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100300","الخفيف"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206162","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117843","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128923","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86368","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81692","المنسرح"],[4753,"عاشق السوسن","https://www.poetsgate.com/ViewPoem.aspx?id=108350",""],[4767,"مركز الماجد","https://www.poetsgate.com/ViewPoem.aspx?id=97448",""],[4578,"مرسلٌ فوق نجيل الخصر شد","https://www.poetsgate.com/ViewPoem.aspx?id=49408",""],[4858,"مرسي والسيسي","https://www.poetsgate.com/ViewPoem.aspx?id=144476",""],[4859,"قناديل الإياب","https://www.poetsgate.com/ViewPoem.aspx?id=191609",""],[4940,"أين الهوى؟!","https://www.poetsgate.com/ViewPoem.aspx?id=210643",""],[4984,"مُحَاوَلَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201090",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[3294,"لي شوق لم أستطع لك بثه","https://www.poetsgate.com/ViewPoem.aspx?id=173262",""],[5495,"منو بحالنه","https://www.poetsgate.com/ViewPoem.aspx?id=175423",""],[5725,"رحيق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=177720",""]],"verses":[["«مرسل» قد صاغه خالقه","من معاني الرسل بدءاً وختاما",0,"م",2,0],["مَرسى السِيادَةِ سُدَّةٌ سَيفِيَّةٌ","مَحروسَةٌ مَسعودَةُ التَأسيسِ",1,"س",1,0],["مُرَسَّعَةٌ بَينَ أَرساغِهِ","بِهِ عَسَمٌ يَبتَغي أَرنَبا",2,"ب",2,0],["مُرْسلاتٍ على الروادِف منهنْ","نَ فُروعاً تمج مِسكاً وبانا",3,"ن",2,0],["مُرسَلٌ لَو يُوزَنُ الناسُ بِهِ","في التُقى وَالبِرِّ شالوا وَرَجَح",4,"ح",1,0],["مُرَسِّمٌ لِيافِعٍ طَويلِ","مِثلَ جَناحِ الطائِرِ المَبلولِ",5,"ل",1,0],["مُرسِلُ الجودَ مِنهُ في كُلِّ سُؤلٍ","يَكلَأُ المَجدَ بَينَ عَينِ السَخاءِ",6,"ا",2,0],["مُرسِلَةً غارَةً بِخَيلٍ","قَد غَنِيَت عَن هَبٍ وَهالِ",7,"ل",1,0],["مُرسَلٌ نال بآي الذكرِ ما","لم ينلْ من قبلُ موسى بعصاه",8,"ا",2,0],["مُرسل المُصطَفى البَشير إِلَينا","رَحمة مِنهُ بِالكَلام القَديمِ",9,"م",1,0],["مَرسومَةٌ بِالحُسنِ لَكِن فِعلُها","سَمِجٌ كَذا فِعلُ المَليكِ الظالِمِ",10,"م",1,0],["مرسلات من العيون سهاماً","فاتكات امضى من السيف حدا",11,"د",2,0],["مُرسِلُ النورِ إِلى أَبياتِهِ","داعِياً يُرشِدُهُم مِن بَعدِ غَي",12,"ي",1,0],["مرسلُ سهمٍ را","ش بالهدبِ وباللحظ نصل",13,"ل",1,0],["مُرسِلٌ تِلوَ نكتَةٍ نُكتةً أُخ","رى مُجيباً عَن كُلِّ تلكَ الشُّؤونِ",14,"ن",1,0],["مرسلة ظنني","منها لشكوى العناء",15,"ا",2,0],["مرسل شافع بشير نذير","منتهى القصد غاية القصاد",16,"د",1,0],["مُرسىَ الودفى النفوس كما تُر","سى الجوارى ببرها إلمامَا",17,"م",2,0],["مر سريعا ما تأملته","بالنحو والمنطق أشغلته",18,"ه",1,0],["مُرسَلٌ بالحَقِّ أنتَ لَنا","فِيكَ نِلنا أَرفَعَ الدَّرَجِ",19,"ج",1,0],["مُرسَلٌ جاوَزَ السَمواتِ سَبعاً","وَإِلَيهِ تَناهَت العَلياءُ",20,"ا",2,0],["مُرسَلٌ بِالنَثرِ وافى مُعجِزاً","بَعدَهُ بِالنَظمِ وافانا وَلي",21,"ل",2,0],["مُرسَلُ اللَّيلُ عارضَتهُ بِنَقلٍ","مُسنَدٍ عن أثيثها الأسحَمَانِ",22,"ن",1,0],["مَرسَى إلى الكُوسِ مَعاً والعَقرَبي","إن شِيتَ أن تَطرَح هُنَاكَ فَآقرُبِ",23,"ب",1,0],["مرسل ذو فصاحة وبلاغة","مدمع في هواك أدى بلاغه",24,"غ",2,1],["مرسلاً فوق متنه افعوانا","أرقما يقذف السمام شرارا",25,"ر",2,0],["مرسلين العظام سمح الأيادي","أصل سر لذات شكل الأنام",26,"م",1,0],["مرسلَ السهم حليةً في فؤادي","يا لعُجبي بحليتي وشقائي",27,"ا",2,0],["مرسلو دمعهم مهما دعوا","سحراً أو هللوا أو حمدا",28,"د",2,0],["مرسلا من شقيه نورا مبينا","لينير الآراء بالبينات",29,"ت",1,0],["مرسلا من مزماره نغمات","تبعث الجد في النفوس الابيه",30,"ي",2,0],["مُرسَلاً عينه يُحاول أَمرا","فاتِحاً حَولَهُ ذِراعاً وَصَدرا",31,"ر",2,0],["مرسلاً من سبط الشعر علن","ودعا الناس إلى شرع الهوى",32,"ه",3,0],["مرسلي السيب حيث دجلة منه","تنهل الآملين منا ونجحا",33,"ح",2,0],["مرسيَ كم ناعمٍ وكم جذلٍ","بين الرياحين فيكِ والراح",34,"ح",1,0],["مرسل الهدب شراكا وله","من أسيل الخد ما يدني المنى",35,"ن",2,0],["مرسلةً للقلب أنوارَها","تنهِضُه مِن جهله السائدِ",36,"د",1,0],["مرسلٌ فوق نجيل الخصر شد","عقد القلب على الحب وشد",37,"د",1,1],["\" مرسي \" حبيب الله يفدي شرعةً","بالرّوح لا يرضى لها إلاّ الظّهور",38,"ر",1,0],["مرسلاً شاراتِه عبرَ المدى","فاقطفِ الأحرفَ من روضِ العتابْ",39,"ب",1,0],["مرسالُ عطرك لم يعد يهب الطريق","نسائما بحضور كل صباحِ",40,"ح",1,0],["مرسخة فما التبست برأي","مثبتة المسار على حياد",41,"د",1,0],["مرسل على قوم أبرهة طير أبابيل","وسلط عليه ومن نواياه لده",42,"د",2,0],["مرسلي من بني الاخاه نبيا","صدقت آية المودة بعثه",43,"ث",2,0],["مرسومه بجلدنه ذيج الانياب","الجرح لو طاب هم يترك نياشين",44,"ن",1,0],["مرسلات كانها من لهيبٍ","توجع القلب والضلوع سقاما",45,"م",2,0]]}