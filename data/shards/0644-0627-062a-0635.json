{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[51,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[51,"لست أبكي على نوال صديق","https://www.aldiwan.net/poem65523.html","الخفيف"],[51,"لا تصنعن صنيعة مبتورة","https://www.aldiwan.net/poem66069.html","الكامل"],[51,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[91,"إني عرفت من الإنسان ما كانا","https://www.aldiwan.net/poem62785.html","عموديه"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[70,"خانني من لم أخنه","https://www.aldiwan.net/poem42430.html","مجزوء الرمل"],[32,"لا تصرمي يا جمل حبلي","https://www.aldiwan.net/poem27708.html","الطويل"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[66,"لا تصاحب من الأنام لئيما","https://www.aldiwan.net/poem38588.html","الخفيف"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[44,"لا تصدي فالصد أمر عظيم","https://www.aldiwan.net/poem30108.html","الخفيف"],[44,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[69,"لا تصحبن أعورا","https://www.aldiwan.net/poem28857.html","مجزوء الرجز"],[33,"وتفرقوا بعد الجميع بغبطة","https://www.aldiwan.net/poem25795.html","الكامل"],[48,"لا تصحبن أخا نسك وإن نسكا","https://www.aldiwan.net/poem64465.html","البسيط"],[48,"نادم العز الكراما","https://www.aldiwan.net/poem66609.html","مجزوء الرمل"],[50,"قل لعبد الكريم يا ابن أبي العو","https://www.aldiwan.net/poem62324.html","البسيط"],[50,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[50,"أمن الحوادث والهوى المعتاد","https://www.aldiwan.net/poem63910.html","الكامل"],[46,"لا تصحبن يد الليالي فاجرا","https://www.aldiwan.net/poem22573.html","الكامل"],[46,"إن راز عاذلك الرازي مختبرا","https://www.aldiwan.net/poem22762.html","البسيط"],[46,"أزول وليس في الخلاق شك","https://www.aldiwan.net/poem23073.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[91,"ابنة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=53343",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[94,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[109,"حمائم الروض ما هذي التغاريد","https://www.aldiwan.net/poem16498.html","البسيط"],[150,"يا حاسد النعمة في غيره","https://www.aldiwan.net/poem68516.html","السريع"],[160,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[160,"أحسنت في تدبير أمرك يا حسن","https://www.aldiwan.net/poem58795.html","الكامل"],[164,"لا تصغيا في الهوى لمن عذلا","https://www.aldiwan.net/poem67850.html","المنسرح"],[185,"مالي وللحادثات الصم تطرقني","https://www.aldiwan.net/poem14595.html","البسيط"],[186,"لا تصحبن اميرا","https://www.aldiwan.net/poem43753.html","المجتث"],[186,"لا تصحبن وإن صحب","https://www.aldiwan.net/poem43844.html","الكامل"],[193,"لا تصبحن بالحياة ذا ثقه","https://www.aldiwan.net/poem13087.html","الرجز"],[197,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[198,"لا تصيخن لتشويق النديم","https://www.aldiwan.net/poem51886.html","الرمل"],[198,"هم سرى في أضلعي وسرى بي","https://www.aldiwan.net/poem51978.html","الكامل"],[211,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[223,"كنت بالأمس ربة العاشقينا","https://www.aldiwan.net/poem41911.html","الخفيف"],[235,"يا من رعيت له الوداد تمسكا","https://www.aldiwan.net/poem32021.html","الكامل"],[254,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[270,"حسنت لي الصهباء يا غيث","https://www.aldiwan.net/poem35284.html","السريع"],[275,"لا تصدوا فربما مات صدا","https://www.aldiwan.net/poem25575.html","الخفيف"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[297,"بين العذيب وبين برقة ضاحك","https://www.aldiwan.net/poem33203.html","الكامل"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[348,"أيها الفاضل الأديب يمينا","https://www.aldiwan.net/poem19899.html","الخفيف"],[353,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[361,"ان يكن صبك المتيم قد دل","https://www.aldiwan.net/poem68077.html","الخفيف"],[393,"الناس في أخلاقهم أصناف","https://www.aldiwan.net/poem53645.html","الكامل"],[416,"متى أرى هذه الأيام مسعفة","https://www.aldiwan.net/poem54090.html","البسيط"],[432,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[432,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[468,"لا تصطبح ما استطعت إلا","https://www.aldiwan.net/poem59677.html","مخلع البسيط"],[468,"لا تصغين إلى العذول وسقني","https://www.aldiwan.net/poem60329.html","الكامل"],[470,"أسلام هل لمتيم تنويل","https://www.aldiwan.net/poem4786.html","الكامل"],[479,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[500,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[527,"لا تصحب الكسلان في حاجاته","https://www.aldiwan.net/poem46007.html","الكامل"],[546,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[551,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[551,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[558,"إن من آيات ربي هو قال","https://www.aldiwan.net/poem34210.html","الرمل"],[562,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لا تَصحَبَنَّ دَهرَكَ إِلّا خائِفاً","فِراقَ إِلفٍ وَنَبوا عَن وَطَن",0,"ن",1,0],["لا تَصفَحَنَّ عَنِ المُلِمِّ إِذا جَنى","وَإِذا المَضارِبُ أَمكَنَتكَ فَصَمِّمِ",1,"م",1,0],["لا تَصحَبِ الدَهرَ إِلّا غَيرَ مُنتَظِرٍ","فَالهَمُّ يَطرُدُهُ قَرعُ الظَنابيبِ",2,"ب",1,0],["لا تَصرِميني يا عُبَيلَ وَراجِعي","فِيَّ البَصيرَةَ نَظرَةَ المُتَأَمِّلِ",3,"ل",1,0],["لا تُصَمِّمْ على عقابك إيَّا","يَ إذا أحسن الزمانُ ثوابي",4,"ب",2,0],["لا تُصيخَنَّ نحو شعري ونحوي","أنت جوَّدْتَ فاستمع تجويدَكْ",5,"ك",1,0],["لا تُصغِر الشعر إن أصغرت قائلهُ","فإنه غير محقوقٍ بإصغار",6,"ر",1,0],["لا تصادفْ ليّن الصو","فِ فأنت اليوم ماعز",7,"ز",1,0],["لا تصونُ الأموالَ بل تقتنيهنْ","نَ لصونِ الأحساب مثلَ الدروع",8,"ع",1,0],["لا تصدِّق مقالة ابن خرخشا","ذ فما عائب لكم بصدوق",9,"ق",1,0],["لا تَصْنَعَنّ صنيعةً مبتورةً","وإذا اصْطنعْتَ إلى الرجالِ فتمِّمِ",10,"م",1,1],["لا تُصَدِّقْ عن النَّبِيِّينَ إلا","بحديثٍ يلوحُ فيه البيان",11,"ن",1,0],["لا تَصطَفيهِ وَإِن أَثقَلَتهُ مِنَناً","يَعدو عَلَيكَ وَإِن أَولاكَ شُكرانا",12,"ن",2,0],["لا تَصيحي واحَسرَتاهُ لِأَلّا","يُدرِكُ السامِعون ما تُضمِرينَه",13,"ن",2,0],["لا تَصُن بِاللَهِ وُدّاً","لِخَؤونٍ لَم يَصُنهُ",14,"ن",2,0],["لا تَصرِمي يا جُملُ حبلي فإنَّني","ورودٌ علَى سَكِّ الأُمور صَدُورُ",15,"ر",1,1],["لا تصهل الخيل إلا تحته طربا","ولا يرى الخير إلا في نواصيها",16,"ي",3,0],["لا تُصِغَينَّ إلى مَقالِ سَفِيهِ","غادٍ عليكَ بزُخْرُفِ التَّمويِه",17,"ي",2,1],["لا تُصاحِب مِنَ الأَنامِ لَئيماً","رُبَّما أَفسَدَ الطِباعَ اللَئيمُ",18,"م",1,1],["لا تصدرُ الأنفسُ عن حُبِّهِ","فإنّهُ للسيّئاتِ اجتراح",19,"ح",1,0],["لا تَصرِفَنَّ نَداكَ عَمَّن لَم يَدَع","لِلقَولِ فيكَ إِلى سِواكَ تَصَرُّفا",20,"ف",2,0],["لا تَصُدّي فَالصَدُّ أَمرٌ عَظيمُ","وَاِرحَمي فَالمُحِبُّ بَرٌّ رَحيمُ",21,"م",1,1],["لا تُصيبُ الصَديقَ قارِعَةُ التَأ","نيبِ إِلّا مِنَ الصَديقِ الرَغيبِ",22,"ب",1,0],["لا تصحبنَّ أعوَرا","وإنْ تناهى زينُهُ",23,"ه",1,1],["لا تَصبِرُ الإِبِلُ الجِلادُ تَفَرَّقَت","حَتّى تَحِنَّ وَيَصبِرُ الإِنسانُ",24,"ن",1,0],["لا تَصحَبَنَّ أَخا نُسكٍ وَإِن نَسَكا","وَإِن فَتَكتَ فَكُن حَرباً لِمَن فَتَكا",25,"ك",2,1],["لا تصرّف في حرام","أبداً إلّا حراما",26,"م",2,0],["لا تُصَلّي وَلا تَصومُ فإِنَ صُم","تَ فَبَعضَ النَهارِ صَوماً رَقيقا",27,"ق",2,0],["لا تَصرِميني فَإِنّي مِن تَذَكُّرِكُم","لَتَعتَريني جُنودُ الحُبِّ أَجنادا",28,"د",2,0],["لا تَصرِميهِ يا عُبَيدَةُ وَاِقصِدي","نَفسي فِداكِ وَطارِفي وَتِلادي",29,"ي",1,0],["لا تَصحَبَنَّ يَدَ اللَيالي فاجِراً","فَالجارُ يُؤخَذُ أَن يَعيبَ الجارُ",30,"ر",1,1],["لا تُصغِيَنَّ إِلى حازٍ لِتَسمَعُهُ","فَما يُطيقُ لِما أَخفَيتَ إِبرازا",31,"ز",2,0],["لا تَصغوا إِلى أَخبارِ قَومٍ","يُصَدَّقُ مَينَها العَقلُ الأَرَكُّ",32,"ك",1,0],["لا تُصيخوا دق ناقوسُ القضاءْ","فاحملوا أشلاءَ هذا العالمِ",33,"م",1,0],["لا تَصِفهُ صِفَةَ الطِفلِ وَاِنظُر","أَينَ مِنهُ كُلُّ كَهلٍ تَقِيِّ",34,"ي",1,0],["لا تصيحي واحسرتاه لئلّا","يدرك السّامعون ما تضمرينه",35,"ن",2,0],["لا تَصدِفا عن دِمن المنازلِ","اللائي أصبحنَ قِرَى النوازِل",36,"ل",1,1],["لا تصلح الدّنيا ويصلح امرها","إلاّ بفكر كالشعاع صراح",37,"ح",1,0],["لا تَصحبنَ غَير حَر أَن ظَفرت بِهِ","وَما سِواهُ إِذا جَرَبت تَنكيدُ",38,"د",1,0],["لا تصحَبَن ذا حسدٍ إنَّه","أولُ ذنبٍ عُصِيَ الله به",39,"ب",2,0],["لا تصبحوا كالنار يأكل بعضها","من بعضها حتى تصير رمادا",40,"د",2,0],["لا تصغِ إن شرٌ دعا فالشر أَن","تنهض له ينهض وإِ تسكنْ سكنْ",41,"ن",1,0],["لا تُصغِيا في الهَوى لِمَن عَذَلا","بَل وَاِسقِياني سُقيتُما نَهَلا",42,"ل",2,1],["لا تصحب العلم إلا والغِني معَه","أَوْلا فحَظُّك منه الهمُّ والأَسف",43,"ف",1,0],["لا تصحبنّ اميراً","ولا غنيا قديرا",44,"ر",2,1],["لا تصحبنّ وإن صحب","ت فعاقلا أو لا فذر",45,"ر",1,1],["لا تُصبِحَنَّ بِالحَياةِ ذا ثِقه","فَكُلُّ نَفسٍ لِلماتِ ذائِقَه",46,"ه",1,1],["لا تصغِ قطّ إلى أرا","جيفِ الكواشح والخصوم",47,"م",1,0],["لا تصيخَنَّ لتشويق النديمِ","واجتنبْ وصلَ بنيَّاتِ الكرومِ",48,"م",1,1],["لا تصلح العبراتُ إلا لامرئٍ","لم يدرِ أنَّ العيشَ لمعُ سَرَاب",49,"ب",1,0],["لا تصدّق كلامه في اتهامي","إنه يمترى ضروع الخبال",50,"ل",1,0],["لا تَصيخي لِلحُبِّ وَاِمشي عَلَيهِ","لَيسَ عَهدُ الغَرامِ إِلّا جُنونا",51,"ن",2,0],["لا تَصيخي إِلى الضَميرِ إِذا ما","قالَ يَوماً عِبارَةَ المُشفِقينا",51,"ن",2,0],["لا تَصيخي يا مرغَريتُ لِصَوتٍ","لَيسَ صَوتُ الضَميرِ إِلّا مُجونا",51,"ن",2,0],["لا تُصغِ فيَّ إِلى الوُشاةِ وَلا تَكُن","لي بِاِجتِرامِ الكاشِحينَ مُواخِذا",52,"ذ",2,0],["لا تصدق قول واشٍ","فعلهُ ما هَمَّ شاني",53,"ن",2,0],["لا تصطبِح أو تغتَبق مع فتىً","في مَجلِسِ الأُنسِ له عَيثُ",54,"ث",1,0],["لا تَصُدُّوا فرُبَّما ماتَ صَدا","مُستَهامٌ لِسَلْوَةٍ ما تَصَدّى",55,"د",2,1],["لا تَصحبنَّ الأَحمقا","المائقَ الشَمَقمَقا",56,"ق",2,0],["لا تَصطَفي خِلّا سوى كلِّ امرئٍ","صبٍّ لأَستار التنسُّك هاتكِ",57,"ك",1,0],["لا تصدع رأسي فحسبي من","عيشي حميا كأس ورنة عود",58,"د",1,0],["لا تُصَدِّقْ فيَّ العَدُوَّ فَمن دُونَ","كَ عِنْدِي وَلَمْ أُبَالِغْ حَبِيبُ",59,"ب",1,0],["لا تَصرمنَّ مِن الصَدي","ق وَلَو قَلاك حبالَ ودّك",60,"ك",1,0],["لا تُصدّق فيه مقال عذول","اِن شَأن العَذول أَن يَتَقَوّل",61,"ل",1,0],["لا تَصحَبَنَّ سِوى التَقِيِّ أَخي الحجي","اِنَّ القَرينَ إِلى القَرينِ يُضافُ",62,"ف",1,0],["لا تصدر الناس إلاَّ عنه في جدة","ونائل من ندى كفَّيه مورود",63,"د",1,0],["لا تصحبِ العبد ولا ذا سفَهٍ","واصحَبْ إذا صاحَبْتَ كلَّ ذي حِجى",64,"ا",1,0],["لا تُصلحُ النعماءُ سيرةَ مُفسدٍ","إصلاحُ سيرةِ سيرِه البأساءُ",65,"ا",2,0],["لا تصلح الدنيا بغير معدّلٍ","يَسقِي بكأسَيْ شهدها والعلقمِ",66,"م",1,0],["لا تَصطَبح ما اِستَطَعتَ إِلّا","بِمسمِعٍ فيهِ حُسنُ فَهمِ",67,"م",1,1],["لا تُصغِيَنَّ إِلى العَذولِ وَسَقِّني","مَشمولَةً في حُمرَةِ الباذينجِ",68,"ج",1,1],["لا تَصرِفي عَنّي دَلالَكِ إِنَّهُ","حَسَنٌ لَدَيَّ وَإِن بَخِلتِ جَميلُ",69,"ل",1,0],["لا تصيدوا قلوبهن بشعر","فالعذارى قلوبهن هواء",70,"ا",2,0],["لا تُصِرْ غافلاً عن الذِّكرِ يوماً","إنَّ في الذِّكرِ راحةَ الأرواحِ",71,"ح",1,0],["لا تصحب الكسلان في حاجاته","كم صالح بفساد آخر يفسدُ",72,"د",1,1],["لا تَصْطَلِي النَّارَ باللَّيْلِ وَلا","تُوقَظُ لِلزَّادِ بَلْهاءُ نَؤُومْ",73,"م",1,0],["لا تصدقاني عن ذنوب الصِّبا","وعلّلا قلبِيَ بالباطلِ",74,"ل",1,0],["لا تُصخْ نَحوهْم بسمعٍ فكم لا","موا وَقوراً منهم وَأعفَوا خليعا",75,"ع",2,0],["لا تصدق أنت رؤياك كما","للخليل القول قد كان يقال",76,"ل",1,0],["لا تَصرِفا طَيِّباتِ الشِّعرِ في غَزَلٍ","بحُبِّ ظبيٍ وشَكوَى صاحبٍ هَجَرا",77,"ر",2,0],["لا تصلح الإمرة للمفضول","قيل لهم فالفضل في المعقول",78,"ل",1,0]]}