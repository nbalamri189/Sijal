{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[51,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[51,"لست أبكي على نوال صديق","https://www.aldiwan.net/poem65523.html","الخفيف"],[51,"لا تصنعن صنيعة مبتورة","https://www.aldiwan.net/poem66069.html","الكامل"],[51,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[91,"إني عرفت من الإنسان ما كانا","https://www.aldiwan.net/poem62785.html","عموديه"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[70,"خانني من لم أخنه","https://www.aldiwan.net/poem42430.html","مجزوء الرمل"],[32,"لا تصرمي يا جمل حبلي","https://www.aldiwan.net/poem27708.html","الطويل"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[66,"لا تصاحب من الأنام لئيما","https://www.aldiwan.net/poem38588.html","الخفيف"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[44,"لا تصدي فالصد أمر عظيم","https://www.aldiwan.net/poem30108.html","الخفيف"],[44,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[69,"لا تصحبن أعورا","https://www.aldiwan.net/poem28857.html","مجزوء الرجز"],[33,"وتفرقوا بعد الجميع بغبطة","https://www.aldiwan.net/poem25795.html","الكامل"],[48,"لا تصحبن أخا نسك وإن نسكا","https://www.aldiwan.net/poem64465.html","البسيط"],[48,"نادم العز الكراما","https://www.aldiwan.net/poem66609.html","مجزوء الرمل"],[50,"قل لعبد الكريم يا ابن أبي العو","https://www.aldiwan.net/poem62324.html","البسيط"],[50,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[50,"أمن الحوادث والهوى المعتاد","https://www.aldiwan.net/poem63910.html","الكامل"],[46,"لا تصحبن يد الليالي فاجرا","https://www.aldiwan.net/poem22573.html","الكامل"],[46,"إن راز عاذلك الرازي مختبرا","https://www.aldiwan.net/poem22762.html","البسيط"],[46,"أزول وليس في الخلاق شك","https://www.aldiwan.net/poem23073.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""]],"verses":[["لا تَصحَبَنَّ دَهرَكَ إِلّا خائِفاً","فِراقَ إِلفٍ وَنَبوا عَن وَطَن",0,"ن",1,0],["لا تَصفَحَنَّ عَنِ المُلِمِّ إِذا جَنى","وَإِذا المَضارِبُ أَمكَنَتكَ فَصَمِّمِ",1,"م",1,0],["لا تَصحَبِ الدَهرَ إِلّا غَيرَ مُنتَظِرٍ","فَالهَمُّ يَطرُدُهُ قَرعُ الظَنابيبِ",2,"ب",1,0],["لا تَصرِميني يا عُبَيلَ وَراجِعي","فِيَّ البَصيرَةَ نَظرَةَ المُتَأَمِّلِ",3,"ل",1,0],["لا تُصَمِّمْ على عقابك إيَّا","يَ إذا أحسن الزمانُ ثوابي",4,"ب",2,0],["لا تُصيخَنَّ نحو شعري ونحوي","أنت جوَّدْتَ فاستمع تجويدَكْ",5,"ك",1,0],["لا تُصغِر الشعر إن أصغرت قائلهُ","فإنه غير محقوقٍ بإصغار",6,"ر",1,0],["لا تصادفْ ليّن الصو","فِ فأنت اليوم ماعز",7,"ز",1,0],["لا تصونُ الأموالَ بل تقتنيهنْ","نَ لصونِ الأحساب مثلَ الدروع",8,"ع",1,0],["لا تصدِّق مقالة ابن خرخشا","ذ فما عائب لكم بصدوق",9,"ق",1,0],["لا تَصْنَعَنّ صنيعةً مبتورةً","وإذا اصْطنعْتَ إلى الرجالِ فتمِّمِ",10,"م",1,1],["لا تُصَدِّقْ عن النَّبِيِّينَ إلا","بحديثٍ يلوحُ فيه البيان",11,"ن",1,0],["لا تَصطَفيهِ وَإِن أَثقَلَتهُ مِنَناً","يَعدو عَلَيكَ وَإِن أَولاكَ شُكرانا",12,"ن",2,0],["لا تَصيحي واحَسرَتاهُ لِأَلّا","يُدرِكُ السامِعون ما تُضمِرينَه",13,"ن",2,0],["لا تَصُن بِاللَهِ وُدّاً","لِخَؤونٍ لَم يَصُنهُ",14,"ن",2,0],["لا تَصرِمي يا جُملُ حبلي فإنَّني","ورودٌ علَى سَكِّ الأُمور صَدُورُ",15,"ر",1,1],["لا تصهل الخيل إلا تحته طربا","ولا يرى الخير إلا في نواصيها",16,"ي",3,0],["لا تُصِغَينَّ إلى مَقالِ سَفِيهِ","غادٍ عليكَ بزُخْرُفِ التَّمويِه",17,"ي",2,1],["لا تُصاحِب مِنَ الأَنامِ لَئيماً","رُبَّما أَفسَدَ الطِباعَ اللَئيمُ",18,"م",1,1],["لا تصدرُ الأنفسُ عن حُبِّهِ","فإنّهُ للسيّئاتِ اجتراح",19,"ح",1,0],["لا تَصرِفَنَّ نَداكَ عَمَّن لَم يَدَع","لِلقَولِ فيكَ إِلى سِواكَ تَصَرُّفا",20,"ف",2,0],["لا تَصُدّي فَالصَدُّ أَمرٌ عَظيمُ","وَاِرحَمي فَالمُحِبُّ بَرٌّ رَحيمُ",21,"م",1,1],["لا تُصيبُ الصَديقَ قارِعَةُ التَأ","نيبِ إِلّا مِنَ الصَديقِ الرَغيبِ",22,"ب",1,0],["لا تصحبنَّ أعوَرا","وإنْ تناهى زينُهُ",23,"ه",1,1],["لا تَصبِرُ الإِبِلُ الجِلادُ تَفَرَّقَت","حَتّى تَحِنَّ وَيَصبِرُ الإِنسانُ",24,"ن",1,0],["لا تَصحَبَنَّ أَخا نُسكٍ وَإِن نَسَكا","وَإِن فَتَكتَ فَكُن حَرباً لِمَن فَتَكا",25,"ك",2,1],["لا تصرّف في حرام","أبداً إلّا حراما",26,"م",2,0],["لا تُصَلّي وَلا تَصومُ فإِنَ صُم","تَ فَبَعضَ النَهارِ صَوماً رَقيقا",27,"ق",2,0],["لا تَصرِميني فَإِنّي مِن تَذَكُّرِكُم","لَتَعتَريني جُنودُ الحُبِّ أَجنادا",28,"د",2,0],["لا تَصرِميهِ يا عُبَيدَةُ وَاِقصِدي","نَفسي فِداكِ وَطارِفي وَتِلادي",29,"ي",1,0],["لا تَصحَبَنَّ يَدَ اللَيالي فاجِراً","فَالجارُ يُؤخَذُ أَن يَعيبَ الجارُ",30,"ر",1,1],["لا تُصغِيَنَّ إِلى حازٍ لِتَسمَعُهُ","فَما يُطيقُ لِما أَخفَيتَ إِبرازا",31,"ز",2,0],["لا تَصغوا إِلى أَخبارِ قَومٍ","يُصَدَّقُ مَينَها العَقلُ الأَرَكُّ",32,"ك",1,0],["لا تُصيخوا دق ناقوسُ القضاءْ","فاحملوا أشلاءَ هذا العالمِ",33,"م",1,0],["لا تَصِفهُ صِفَةَ الطِفلِ وَاِنظُر","أَينَ مِنهُ كُلُّ كَهلٍ تَقِيِّ",34,"ي",1,0],["لا تَصدِفا عن دِمن المنازلِ","اللائي أصبحنَ قِرَى النوازِل",35,"ل",1,1]]}