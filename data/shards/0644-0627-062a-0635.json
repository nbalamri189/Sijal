ViewPoem.aspx?id=207079",""],[5748,"لا تصيخنَّ لتشويق النديمِ","https://www.poetsgate.com/ViewPoem.aspx?id=26245",""],[5748,"همٌّ سرى في أضلعي وسرى بي","https://www.poetsgate.com/ViewPoem.aspx?id=26137",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5804,"حديث مع المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214749",""],[5906,"احذر عديم الأصل","https://www.poetsgate.com/ViewPoem.aspx?id=188219",""],[5939,"قوليها","https://www.poetsgate.com/ViewPoem.aspx?id=178586",""],[5956,"الحب السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=181895",""],[5956,"نقشة الفرحة","https://www.poetsgate.com/ViewPoem.aspx?id=182102",""],[5956,"سلام بعد الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182523",""],[6152,"لاتصبغيه","https://www.poetsgate.com/ViewPoem.aspx?id=208663",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""]],"verses":[["لا تَصحَبَنَّ دَهرَكَ إِلّا خائِفاً","فِراقَ إِلفٍ وَنَبوا عَن وَطَن",0,"ن",1,0],["لا تَصفَحَنَّ عَنِ المُلِمِّ إِذا جَنى","وَإِذا المَضارِبُ أَمكَنَتكَ فَصَمِّمِ",1,"م",1,0],["لا تَصحَبِ الدَهرَ إِلّا غَيرَ مُنتَظِرٍ","فَالهَمُّ يَطرُدُهُ قَرعُ الظَنابيبِ",2,"ب",1,0],["لا تَصرِميني يا عُبَيلَ وَراجِعي","فِيَّ البَصيرَةَ نَظرَةَ المُتَأَمِّلِ",3,"ل",1,0],["لا تُصَمِّمْ على عقابك إيَّا","يَ إذا أحسن الزمانُ ثوابي",4,"ب",2,0],["لا تُصيخَنَّ نحو شعري ونحوي","أنت جوَّدْتَ فاستمع تجويدَكْ",5,"ك",1,0],["لا تُصغِر الشعر إن أصغرت قائلهُ","فإنه غير محقوقٍ بإصغار",6,"ر",1,0],["لا تصادفْ ليّن الصو","فِ فأنت اليوم ماعز",7,"ز",1,0],["لا تصونُ الأموالَ بل تقتنيهنْ","نَ لصونِ الأحساب مثلَ الدروع",8,"ع",1,0],["لا تصدِّق مقالة ابن خرخشا","ذ فما عائب لكم بصدوق",9,"ق",1,0],["لا تَصْنَعَنّ صنيعةً مبتورةً","وإذا اصْطنعْتَ إلى الرجالِ فتمِّمِ",10,"م",1,1],["لا تُصَدِّقْ عن النَّبِيِّينَ إلا","بحديثٍ يلوحُ فيه البيان",11,"ن",1,0],["لا تَصطَفيهِ وَإِن أَثقَلَتهُ مِنَناً","يَعدو عَلَيكَ وَإِن أَولاكَ شُكرانا",12,"ن",2,0],["لا تَصيحي واحَسرَتاهُ لِأَلّا","يُدرِكُ السامِعون ما تُضمِرينَه",13,"ن",2,0],["لا تَصُن بِاللَهِ وُدّاً","لِخَؤونٍ لَم يَصُنهُ",14,"ن",2,0],["لا تَصرِمي يا جُملُ حبلي فإنَّني","ورودٌ علَى سَكِّ الأُمور صَدُورُ",15,"ر",1,1],["لا تصهل الخيل إلا تحته طربا","ولا يرى الخير إلا في نواصيها",16,"ي",3,0],["لا تُصِغَينَّ إلى مَقالِ سَفِيهِ","غادٍ عليكَ بزُخْرُفِ التَّمويِه",17,"ي",2,1],["لا تُصاحِب مِنَ الأَنامِ لَئيماً","رُبَّما أَفسَدَ الطِباعَ اللَئيمُ",18,"م",1,1],["لا تصدرُ الأنفسُ عن حُبِّهِ","فإنّهُ للسيّئاتِ اجتراح",19,"ح",1,0],["لا تَصرِفَنَّ نَداكَ عَمَّن لَم يَدَع","لِلقَولِ فيكَ إِلى سِواكَ تَصَرُّفا",20,"ف",2,0],["لا تَصُدّي فَالصَدُّ أَمرٌ عَظيمُ","وَاِرحَمي فَالمُحِبُّ بَرٌّ رَحيمُ",21,"م",1,1],["لا تُصيبُ الصَديقَ قارِعَةُ التَأ","نيبِ إِلّا مِنَ الصَديقِ الرَغيبِ",22,"ب",1,0],["لا تصحبنَّ أعوَرا","وإنْ تناهى زينُهُ",23,"ه",1,1],["لا تَصبِرُ الإِبِلُ الجِلادُ تَفَرَّقَت","حَتّى تَحِنَّ وَيَصبِرُ الإِنسانُ",24,"ن",1,0],["لا تَصحَبَنَّ أَخا نُسكٍ وَإِن نَسَكا","وَإِن فَتَكتَ فَكُن حَرباً لِمَن فَتَكا",25,"ك",2,1],["لا تصرّف في حرام","أبداً إلّا حراما",26,"م",2,0],["لا تُصَلّي وَلا تَصومُ فإِنَ صُم","تَ فَبَعضَ النَهارِ صَوماً رَقيقا",27,"ق",2,0],["لا تَصرِميني فَإِنّي مِن تَذَكُّرِكُم","لَتَعتَريني جُنودُ الحُبِّ أَجنادا",28,"د",2,0],["لا تَصرِميهِ يا عُبَيدَةُ وَاِقصِدي","نَفسي فِداكِ وَطارِفي وَتِلادي",29,"د",2,0],["لا تَصحَبَنَّ يَدَ اللَيالي فاجِراً","فَالجارُ يُؤخَذُ أَن يَعيبَ الجارُ",30,"ر",1,1],["لا تُصغِيَنَّ إِلى حازٍ لِتَسمَعُهُ","فَما يُطيقُ لِما أَخفَيتَ إِبرازا",31,"ز",2,0],["لا تَصغوا إِلى أَخبارِ قَومٍ","يُصَدَّقُ مَينَها العَقلُ الأَرَكُّ",32,"ك",1,0],["لا تُصيخوا دق ناقوسُ القضاءْ","فاحملوا أشلاءَ هذا العالمِ",33,"م",1,0],["لا تَصِفهُ صِفَةَ الطِفلِ وَاِنظُر","أَينَ مِنهُ كُلُّ كَهلٍ تَقِيِّ",34,"ي",1,0],["لا تصيحي واحسرتاه لئلّا","يدرك السّامعون ما تضمرينه",35,"ن",2,0],["لا تَصدِفا عن دِمن المنازلِ","اللائي أصبحنَ قِرَى النوازِل",36,"ل",1,1],["لا تصلح الدّنيا ويصلح امرها","إلاّ بفكر كالشعاع صراح",37,"ح",1,0],["لا تَصحبنَ غَير حَر أَن ظَفرت بِهِ","وَما سِواهُ إِذا جَرَبت تَنكيدُ",38,"د",1,0],["لا تصحَبَن ذا حسدٍ إنَّه","أولُ ذنبٍ عُصِيَ الله به",39,"ب",2,0],["لا تصبحوا كالنار يأكل بعضها","من بعضها حتى تصير رمادا",40,"د",2,0],["لا تصغِ إن شرٌ دعا فالشر أَن","تنهض له ينهض وإِ تسكنْ سكنْ",41,"ن",1,0],["لا تُصغِيا في الهَوى لِمَن عَذَلا","بَل وَاِسقِياني سُقيتُما نَهَلا",42,"ل",2,1],["لا تصحب العلم إلا والغِني معَه","أَوْلا فحَظُّك منه الهمُّ والأَسف",43,"ف",1,0],["لا تصحبنّ اميراً","ولا غنيا قديرا",44,"ر",2,1],["لا تصحبنّ وإن صحب","ت فعاقلا أو لا فذر",45,"ر",1,1],["لا تُصبِحَنَّ بِالحَياةِ ذا ثِقه","فَكُلُّ نَفسٍ لِلماتِ ذائِقَه",46,"ه",1,1],["لا تصغِ قطّ إلى أرا","جيفِ الكواشح والخصوم",47,"م",1,0],["لا تصيخَنَّ لتشويق النديمِ","واجتنبْ وصلَ بنيَّاتِ الكرومِ",48,"م",1,1],["لا تصلح العبراتُ إلا لامرئٍ","لم يدرِ أنَّ العيشَ لمعُ سَرَاب",49,"ب",1,0],["لا تصدّق كلامه في اتهامي","إنه يمترى ضروع الخبال",50,"ل",1,0],["لا تَصيخي لِلحُبِّ وَاِمشي عَلَيهِ","لَيسَ عَهدُ الغَرامِ إِلّا جُنونا",51,"ن",2,0],["لا تَصيخي إِلى الضَميرِ إِذا ما","قالَ يَوماً عِبارَةَ المُشفِقينا",51,"ن",2,0],["لا تَصيخي يا مرغَريتُ لِصَوتٍ","لَيسَ صَوتُ الضَميرِ إِلّا مُجونا",51,"ن",2,0],["لا تُصغِ فيَّ إِلى الوُشاةِ وَلا تَكُن","لي بِاِجتِرامِ الكاشِحينَ مُواخِذا",52,"ذ",2,0],["لا تصدق قول واشٍ","فعلهُ ما هَمَّ شاني",53,"ن",2,0],["لا تصطبِح أو تغتَبق مع فتىً","في مَجلِسِ الأُنسِ له عَيثُ",54,"ث",1,0],["لا تَصُدُّوا فرُبَّما ماتَ صَدا","مُستَهامٌ لِسَلْوَةٍ ما تَصَدّى",55,"د",2,1],["لا تَصحبنَّ الأَحمقا","المائقَ الشَمَقمَقا",56,"ق",2,0],["لا تَصطَفي خِلّا سوى كلِّ امرئٍ","صبٍّ لأَستار التنسُّك هاتكِ",57,"ك",1,0],["لا تصدع رأسي فحسبي من","عيشي حميا كأس ورنة عود",58,"د",1,0],["لا تُصَدِّقْ فيَّ العَدُوَّ فَمن دُونَ","كَ عِنْدِي وَلَمْ أُبَالِغْ حَبِيبُ",59,"ب",1,0],["لا تَصرمنَّ مِن الصَدي","ق وَلَو قَلاك حبالَ ودّك",60,"ك",1,0],["لا تُصدّق فيه مقال عذول","اِن شَأن العَذول أَن يَتَقَوّل",61,"ل",1,0],["لا تَصحَبَنّ