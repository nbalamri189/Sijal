{"poems":[[55,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[55,"أي عيد من الهوى عاد قلبي","https://www.aldiwan.net/poem30718.html","الخفيف"],[55,"ما للهموم كأنها","https://www.aldiwan.net/poem30729.html","مجزوء الكامل"],[65,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[88,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[95,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[90,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[53,"شرب البيهقي والبين ناء","https://www.aldiwan.net/poem9232.html","الخفيف"],[53,"نادمت بدر السماء في فلكه","https://www.aldiwan.net/poem65770.html","المنسرح"],[93,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[93,"ذهب الربيع ففي الخمائل وحشة","https://www.aldiwan.net/poem62787.html","عموديه"],[93,"أنشودة في ضميري كم أواريها","https://www.aldiwan.net/poem62812.html","عموديه"],[87,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[87,"بين سمع الله والبصر","https://www.aldiwan.net/poem7590.html","المديد"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[45,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[47,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[33,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem42539.html","الكامل"],[33,"يا صاحبي أقلا اللوم واحتسبا","https://www.aldiwan.net/poem42544.html","البسيط"],[33,"بكر العاذلات فيها صراحا","https://www.aldiwan.net/poem42587.html","البسيط"],[50,"لي صاحب أثقل من أحد","https://www.aldiwan.net/poem62607.html","السريع"],[52,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[48,"يا حصان النساء كم فارسا ول","https://www.aldiwan.net/poem22638.html","الخفيف"],[48,"فكروا في الأمور يكشف لكم بع","https://www.aldiwan.net/poem22733.html","الخفيف"],[48,"الجسم كالصفر يكسوه الثرى صدأ","https://www.aldiwan.net/poem22796.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39623","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[108,"ما نسيناك","https://www.poetsgate.com/ViewPoem.aspx?id=179363",""],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[93,"يا أنشودتي انطلقي","https://www.poetsgate.com/ViewPoem.aspx?id=53391",""],[96,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[33,"بكرَ العاذلاتِ فيها صراحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18816&r=&rc=79",""],[132,"ورد الكتاب فسرني","https://www.aldiwan.net/poem50628.html","مجزوء الكامل"],[146,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[164,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[203,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[227,"إن ترم مجدا وفخرا","https://www.aldiwan.net/poem41627.html","مجزوء الرمل"],[227,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[229,"لك ألفاظ إذا احتجت إلى","https://www.aldiwan.net/poem55190.html","الرمل"],[301,"صاح إن جزت بذي الأثل فحي","https://www.aldiwan.net/poem33082.html","الرمل"],[302,"يفنى الزمان وذكره يتجدد","https://www.aldiwan.net/poem36263.html","عموديه"],[309,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[357,"كل حي سوى المهيمن فاني","https://www.aldiwan.net/poem39759.html","الخفيف"],[357,"ته دلالا أيها القمر","https://www.aldiwan.net/poem40228.html","المديد"],[368,"أيا ولي الدولة المرتجى","https://www.aldiwan.net/poem60856.html","السريع"],[397,"من لقلب يهيم في كل وادي","https://www.aldiwan.net/poem53585.html","الخفيف"],[397,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[413,"إن فاجأتك الليالي","https://www.aldiwan.net/poem32076.html","المجتث"],[420,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[420,"ناشداها عن فؤادي وسلاها","https://www.aldiwan.net/poem53959.html","الطويل"],[420,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[461,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[461,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[467,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[471,"لنا مغن من بني الجند","https://www.aldiwan.net/poem60190.html","السريع"],[473,"أمن خليدة وهنا شبت النار","https://www.aldiwan.net/poem4695.html","البسيط"],[503,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[532,"لست أسوى قط شيئا","https://www.aldiwan.net/poem37387.html","مجزوء الرمل"],[554,"قال لجاف كلما سيم","https://www.aldiwan.net/poem47177.html","مجزوء الرمل"],[565,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[565,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/28","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/202288","الطويل"],[1021,"قد كن من غَسّان قبلك","https://www.poetsgate.com/ViewPoem.aspx?id=17630",""]],"verses":[["لَو دامَ لي وُدُّ الأَوانِسِ لَم أُبَل","بِطُلوعِ شَيبٍ وَاِبيِضاضِ غَدائِرِ",0,"ر",1,0],["لَو دَعاني مِن غَيرِ أَرضِكَ داعٍ","لِغَرامٍ لَكُنتُ غَيرَ مُلَبّي",1,"ب",2,0],["لِوَداعِ إِخوانِ الشَبا","بِ مَضَت مَطاياهُم تَخُبُّ",2,"ب",1,0],["لو دامَ قَبْلَكمُ اجْتِماعٌ لم يَذُقْ","ألمَ افْتِراقٍ مالِكٌ وعَقيلُ",3,"ل",1,0],["لَو دَرَوا ما خَبَّأَ الشَرقُ لَهُم","آثَروا فيزوفَ وَاِختاروا المُقاما",4,"م",2,0],["لَو دَرَت رومَةُ ما قَد نابَها","في طَرابُلسَ أَبَت إِلّا اِنقِساما",4,"م",2,0],["لَوْ دَرَى المُمْعِنُونَ فِي جَمْعِ مَالٍ","كَمْ تَزِيدُ الزَّكَاةُ قَدَرَ المَالِ",5,"ل",1,0],["لو درى منبعي بما أنا فيه","من أسىً جفّ ماؤه الضحضاح",6,"ح",1,0],["لو درى البينُ بالذي غاب عنهُ","ملأ البينُ ثوبَهُ أحداثا",7,"ث",2,0],["لو دونيَ البحرُ جاء نائلُهُ","أسْبحَ من فُلكه ومن سَمَكِهْ",8,"ك",2,0],["لَو دَرى حينَ أَتى المُنقَلَبا","لَتَمَنّى أَنَّهُ لَم يَبِنِ",9,"ن",1,0],["لَو دُمتَ لَم تَحزَن عَلَيهِ قُلوبُنا","وَلَئِن أَضَعنا الوَردَ وَالنَسرينا",10,"ن",2,0],["لَو دامَ إيمانُها لَم تَنطَلِق سَقَرٌ","بِدورِها وَالأَفاعي في مَغانيها",11,"ي",3,0],["لو دام للصحف ودامت له","لم تنج منه الصحف المنزله",12,"ل",2,0],["لو دام يهدى لك الأشعار حافلة","ما ضِقت جاها ولا ضاقت قوافيها",13,"ي",3,0],["لوداع بعده لكما","خطوات الشمس والقمر",14,"ر",1,0],["لَو دامَتِ الدُنيا عَلى نُبوةٍ","لَكانَ لِلناسِ عَن الأُخرى غِنى",15,"ا",1,0],["لَو دَرَتِ الدُنيا بِما عِندَهُ","لَاِستَحيَتِ الأَيّامُ مِن عَتبِهِ",16,"ب",2,0],["لو دبَّ رأيُك في كعوبِ قَناً","ما مسَّها طنبٌ ولا خَطَلُ",17,"ل",1,0],["لَو دَرَت ما أَتَت لَمَنَّت بِنُجحٍ","لَم يُكَدَّر وَنائِلٍ غَيرِ نَزرِ",18,"ر",1,0],["لَو دَعا عَزمُهُ النَجيب","لِقَضا اللَهِ وَالقَدَر",19,"ر",1,0],["لَو دَبَّ ذَرُّ فَوقَ ضاحي جِلدِها","لَأَبانَ مِن آثارِهِنَّ حُدورُ",20,"ر",1,0],["لَو دَبَّ ذَرٌّ رُوَيدا فَوقَ قَرقَرِها","لَأَثَّرَ الذَرُّ فَوقَ الثَوبِ في البَشَرِ",21,"ر",1,0],["لَو دَويتُنَّ مِثلَ دائي عَذَرتُن","نَ وَلَكِن رَأَيتُكُنَّ صِحاحا",22,"ح",2,0],["لَو دَخَلَ النارَ طَفى حَرَّها","فَماتَ مَن فيها مِنَ البَردِ",23,"د",1,0],["لَو دَعاكِ الَّذي دَعاني مِنَ الشَو","قِ فُواقاً أَرَدتِ بي ما أُريدُ",24,"د",1,0],["لَو دَرى بِالَّذي عَلِمتُ ثَبيرٌ","لَدَعا مِن أَذى الحَياةِ ثُبورا",25,"ر",2,0],["لَو دَرى الطائِرُ المُوَكِّرُ بِالعُقبى","أَبى أَن يَهُمَّ بِالتَوكيرِ",26,"ر",1,0],["لَو دامَ في الأَرضِ عُمرَ الدَهرِ مُختَزِناً","لَما تَغَيَّرَ عَمّا يَعهَدُ الأَنَسُ",27,"س",1,0],["لودِدْتُ لو أني أمامك قد جلوتُ محاسني","بغِلالةٍ مُبتلَّةٍ كشفت جميعَ مفاتني",28,"ي",1,0],["لَوَدَّ إلى الأرضِ لو لم يُصِخْ","أو ارتدَّ بالمقلةِ الحاسرهْ",29,"ه",1,0],["لوددتُ لو أنِّي عرضتُ بناتُه","في المهرجانِ نواثرَ الريحانِ",30,"ن",1,0],["لَوْ دَامَ ذَاكَ العَهْد لَ","كِنْ هَلْ لِيَوْمِ رِضىً عَقِيبُ",31,"ب",1,0],["لَو دَرى عَيرٌ دَوائِرها","ما نَزا مِن هَولِ ما نَزَلا",32,"ل",2,0],["لو دَرَى كيف مَوقعُ العذلِ مني","كفَّ من غَربهِ وأقصر عني",33,"ن",2,1],["لو دَعَأهُم إِلى النُّجوم لَسَاروا","خَلْفَه يُزْمِعُون للنَّجْمِ قَصْدا",34,"د",2,0],["لو دَعا أَنْجُمَ السَّماءِ لَلبَّتْ","مُهْطِعاتٍ لأمْرِهِ صاغِرَاتِ",35,"ت",1,0],["لو دَرتْ من تكون تلك الليالي","ما أصابت بعلَّةٍ جُثْمَانك",36,"ك",1,0],["لو دَرَتْ من حملتْهُ، لثمت","قدميه حين تخطو قدماه",37,"ا",2,0],["لو دَرَى المُزنُ به ظلَّلَهُ","من هجيرٍ يشتكي الضبُّ لظاه",37,"ا",2,0],["لو دَرَى الفقرُ بمن يجتازهُ","ضجَّ بالتسبيح والذكر حَصاه",37,"ا",2,0],["لو درى الدَّوْحُ بمن مَرَّ بهِ","لحني الدوحُ له شمَّ الجبِاه",37,"ا",2,0],["لو درى الوحش به، ما نفرت","طبيةٌ منه، ولا فَرَّت مهاه",37,"ا",2,0],["لو درى الطير به، ما أجفلت","منه ورقاءُ، ولا ريعَتْ قطاه",37,"ا",2,0],["لو دافع الصبر حزنا ثم اذهبه","لكنت بين رجال الصبر كالجبل",38,"ل",1,0],["لو دام أيمانا لم تنطلق سقر","بدورها والأفاعي في مغانيها",39,"ي",3,0],["لودّ في كلّ مل يجريه من عسل","ومن خمور ومن درّ وعقيان",40,"ن",1,0],["لو دويتنّ مثلَ دائي، عذرْ","تنّ، ولكنْ رأيتكنّ صحاحا",41,"ح",2,0],["لوددت أن يبقَى بَقَا","ءَ الدهر أو طولَ الأَمَدْ",42,"د",1,0],["لو درتْ هذه الحمائمُ ما ند","رى لما رجَّعتْ على الغصن لَحنا",43,"ن",2,0],["لو دام عاماً واحد التبددوا","في كل أرض أيما تبديد",44,"د",1,0],["لو درى الأفقُ أنها فيكَ ما أط","لعَ شمسُ الضحى لئلا تغارا",45,"ر",2,0],["لَو دَروا مَعنى نَشيدي","لَرَأوني اِبنَ الخلودِ",46,"د",1,0],["لَو دَرَوا أَنَّ في الطَبيعَة عَدلاً","قَطع الظُلمُ كَفَّتَي ميزانِه",47,"ن",2,0],["لو دَرى رَبُّ المُروءاتِ رمى","لكَ ما رَجَّيتَ من حِصنٍ حَصين",48,"ن",1,0],["لَو دَعاني الدَهرُ يَوماً دعوةً","نحوه أَو قالَت الأَقدارُ هَي",49,"ي",1,0],["لو دافع المستضعفون دفاعَه","ما كان ثمَّ ثعالبٌ تستأْسد",50,"د",1,0],["لَو دَرى نفسهُ النفيسةَ يوماً","لَم يُذِلها في مَطلبٍ حَيَواني",51,"ن",2,0],["لَو دَرى المَرء حَظَّهُ مِن حَياة","لَقَضاها بِالهَمِّ وَالأَحزانِ",52,"ن",1,0],["لَو دَرى العُذّال إِذ عذلوا","بِهَواه صَبوَتي عَذروا",53,"ر",3,0],["لَوَدَّتِ الأنجُمُ في كُتْبِه","لَو جُعلَتْ أمكنةَ النَّقْط",54,"ط",1,0],["لَو دَرى الدَهرُ أَنَّهُ مِن بَنيهِ","لَاِزدَرى قَدرَ سائِر الأَولادِ",55,"د",1,0],["لَو دامَ مُعتَرِضُ القَتيلِ بِحالِهِ","لَرَضيتُهُ لكِنَّهُ يَزدادُ",56,"د",1,0],["لو دامَ ما ساءَ مِنْهُ","لدامَ ما كانَ سَرَّا",57,"ر",2,0],["لو دعا الشُّمَّ الرَّواسي أَمْرُه","لم تُجِبْ دَعوتَه إلاَّ امتثالا",58,"ل",2,0],["لو دَرَتْ إذ طلَبت تعذيبه","ما يقاسي بهواها لكفاها",59,"ا",3,0],["لودَعيٌّ لم تدع آراؤه","من أُمور الرأي أمراً مبهما",60,"م",2,0],["لو دبَّ كلُّ عائب","أفعَى لها لم تُلسعِ",61,"ع",1,0],["لو دَرى لا حَمَلتْ ناجيةٌ","رحلَهُ فيمن لحاني ما لَحَا",62,"ح",2,0],["لو درتْ جودَ عشرهِ مثل ما","ندري لغاضت غيظاً مياه السبع",63,"ع",1,0],["لَو دَخَلَ النارَ عَلى حَرِّها","لَماتَ مَن فيها مِنَ البَردِ",64,"د",1,0],["لَو دَبَّ حَوليُّ ذَرٍّ تَحتَ مِدرَعِها","أَضحَى بِها مِن دَبيبِ الذَرِّ آثارُ",65,"ر",1,0],["لو دَعا مَيْتاً لوافَى مُسرِعاً","أو دَحا الطَّوْدَ له ينهَدِمُ",66,"م",1,0],["لو دَرَى بِي مِثْلَ ما أَدْ","رِي لأَولانِيَ نُفْرَهْ",67,"ر",2,0],["لو درَى العاذلُ أنّي","لم أُطِعْه ما تعنّى",68,"ن",2,0],["لو دَرَى ماؤُها بما هيَ فيهِ","جفَّ أو صخرُها لَذابَ وسَالا",69,"ل",2,0],["لو دام هذا الحُزنُ ألقى رَبَّهُ","في اللحد قبلَ بِلَى الحبيبِ المُلحَدِ",70,"د",1,0],["لَو دامَ لِتُبَّعٍ وَذَوي ال","أَصناعِ مِن عادٍ وَمِن إِرَمِ",71,"م",1,0],["لو دام لي هذا السواد حمدته","فكان بديلا من شباب قد انصرم",72,"م",1,1],["لو دام لتبعٍ وذوي ال","الأصناعِ من عادٍ ومن إِرمِ",73,"م",1,0]]}