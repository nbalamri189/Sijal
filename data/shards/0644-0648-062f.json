80","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114088","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125823","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136805",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81274","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28744","البسيط"],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114045","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4691,"عطرها يملؤني فرحا","https://www.poetsgate.com/ViewPoem.aspx?id=61363",""],[4767,"فارس القريض","https://www.poetsgate.com/ViewPoem.aspx?id=126303",""],[4797,"بيت أبو خلف","https://www.poetsgate.com/ViewPoem.aspx?id=174645",""],[4929,"حيثيات الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=207444",""],[4932,"يا كاتم الشوق إن الدمع مبديه","https://www.poetsgate.com/ViewPoem.aspx?id=187278",""],[5092,"لا أجملَ من عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=161809",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[3591,"ضجّت بحسن عيونك الآنام","https://www.poetsgate.com/ViewPoem.aspx?id=149536",""],[5121,"فَوْقَ القَمَر","https://www.poetsgate.com/ViewPoem.aspx?id=213471",""],[5121,"لُؤْلُؤَة","https://www.poetsgate.com/ViewPoem.aspx?id=215867",""],[5277,"دمعةٌ على وجنةِ الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=189757",""],[5277,"ودائعُ النعناع","https://www.poetsgate.com/ViewPoem.aspx?id=191321",""],[5376,"قلْنا لذي العربانِ ما الخطْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=197733",""],[5455,"كبوة جواد","https://www.poetsgate.com/ViewPoem.aspx?id=34465",""],[5460,"أجمعت ظالمة على تركي","https://www.poetsgate.com/ViewPoem.aspx?id=200739",""],[5536,"أعطني الناي َ وغنيّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=23194",""],[3469,"قد كن من غَسّان قبلك","https://www.poetsgate.com/ViewPoem.aspx?id=17630",""],[5596,"الخسارة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=206771",""],[5606,"الرجل كلمته تظهرمدى مستواه","https://www.poetsgate.com/ViewPoem.aspx?id=194430",""],[5612,"ماذا جَرى لكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179543",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5843,"مكاسر عود جاوي!","https://www.poetsgate.com/ViewPoem.aspx?id=51287",""],[5848,"اللهم إني عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=48895",""],[5956,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=194897",""],[6008,"الحب بلوى","https://www.poetsgate.com/ViewPoem.aspx?id=60800",""],[6093,"ماله عندي شبيه ( مجزوء الرمل )","https://www.poetsgate.com/ViewPoem.aspx?id=176000",""],[6093,"بئرٌ معطلةٌ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176094",""],[6142,"ما تأذى أذاه أي نبي","https://www.poetsgate.com/ViewPoem.aspx?id=155694",""],[6229,"ليلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65190&r=&rc=16",""]],"verses":[["لَو دامَ لي وُدُّ الأَوانِسِ لَم أُبَل","بِطُلوعِ شَيبٍ وَاِبيِضاضِ غَدائِرِ",0,"ر",1,0],["لَو دَعاني مِن غَيرِ أَرضِكَ داعٍ","لِغَرامٍ لَكُنتُ غَيرَ مُلَبّي",1,"ب",2,0],["لِوَداعِ إِخوانِ الشَبا","بِ مَضَت مَطاياهُم تَخُبُّ",2,"ب",1,0],["لو دامَ قَبْلَكمُ اجْتِماعٌ لم يَذُقْ","ألمَ افْتِراقٍ مالِكٌ وعَقيلُ",3,"ل",1,0],["لَو دَرَوا ما خَبَّأَ الشَرقُ لَهُم","آثَروا فيزوفَ وَاِختاروا المُقاما",4,"م",2,0],["لَو دَرَت رومَةُ ما قَد نابَها","في طَرابُلسَ أَبَت إِلّا اِنقِساما",4,"م",2,0],["لَوْ دَرَى المُمْعِنُونَ فِي جَمْعِ مَالٍ","كَمْ تَزِيدُ الزَّكَاةُ قَدَرَ المَالِ",5,"ل",1,0],["لو درى منبعي بما أنا فيه","من أسىً جفّ ماؤه الضحضاح",6,"ح",1,0],["لو درى البينُ بالذي غاب عنهُ","ملأ البينُ ثوبَهُ أحداثا",7,"ث",2,0],["لو دونيَ البحرُ جاء نائلُهُ","أسْبحَ من فُلكه ومن سَمَكِهْ",8,"ك",2,0],["لَو دَرى حينَ أَتى المُنقَلَبا","لَتَمَنّى أَنَّهُ لَم يَبِنِ",9,"ن",1,0],["لَو دُمتَ لَم تَحزَن عَلَيهِ قُلوبُنا","وَلَئِن أَضَعنا الوَردَ وَالنَسرينا",10,"ن",2,0],["لَو دامَ إيمانُها لَم تَنطَلِق سَقَرٌ","بِدورِها وَالأَفاعي في مَغانيها",11,"ي",3,0],["لو دام للصحف ودامت له","لم تنج منه الصحف المنزله",12,"ل",2,0],["لو دام يهدى لك الأشعار حافلة","ما ضِقت جاها ولا ضاقت قوافيها",13,"ي",3,0],["لوداع بعده لكما","خطوات الشمس والقمر",14,"ر",1,0],["لَو دامَتِ الدُنيا عَلى نُبوةٍ","لَكانَ لِلناسِ عَن الأُخرى غِنى",15,"ا",1,0],["لَو دَرَتِ الدُنيا بِما عِندَهُ","لَاِستَحيَتِ الأَيّامُ مِن عَتبِهِ",16,"ب",2,0],["لو دبَّ رأيُك في كعوبِ قَناً","ما مسَّها طنبٌ ولا خَطَلُ",17,"ل",1,0],["لَو دَرَت ما أَتَت لَمَنَّت بِنُجحٍ","لَم يُكَدَّر وَنائِلٍ غَيرِ نَزرِ",18,"ر",1,0],["لَو دَعا عَزمُهُ النَجيب","لِقَضا اللَهِ وَالقَدَر",19,"ر",1,0],["لَو دَبَّ ذَرُّ فَوقَ ضاحي جِلدِها","لَأَبانَ مِن آثارِهِنَّ حُدورُ",20,"ر",1,0],["لَو دَبَّ ذَرٌّ رُوَيدا فَوقَ قَرقَرِها","لَأَثَّرَ الذَرُّ فَوقَ الثَوبِ في البَشَرِ",21,"ر",1,0],["لَو دَويتُنَّ مِثلَ دائي عَذَرتُن","نَ وَلَكِن رَأَيتُكُنَّ صِحاحا",22,"ح",2,0],["لَو دَخَلَ النارَ طَفى حَرَّها","فَماتَ مَن فيها مِنَ البَردِ",23,"د",1,0],["لَو دَعاكِ الَّذي دَعاني مِنَ الشَو","قِ فُواقاً أَرَدتِ بي ما أُريدُ",24,"د",1,0],["لَو دَرى بِالَّذي عَلِمتُ ثَبيرٌ","لَدَعا مِن أَذى الحَياةِ ثُبورا",25,"ر",2,0],["لَو دَرى الطائِرُ المُوَكِّرُ بِالعُقبى","أَبى أَن يَهُمَّ بِالتَوكيرِ",26,"ر",1,0],["لَو دامَ في الأَرضِ عُمرَ الدَهرِ مُختَزِناً","لَما تَغَيَّرَ عَمّا يَعهَدُ الأَنَسُ",27,"س",1,0],["لودِدْتُ لو أني أمامك قد جلوتُ محاسني","بغِلالةٍ مُبتلَّةٍ كشفت جميعَ مفاتني",28,"ي",1,0],["لَوَدَّ إلى الأرضِ لو لم يُصِخْ","أو ارتدَّ بالمقلةِ الحاسرهْ",29,"ه",1,0],["لوددتُ لو أنِّي عرضتُ بناتُه","في المهرجانِ نواثرَ الريحانِ",30,"ن",1,0],["لَوْ دَامَ ذَاكَ العَهْد لَ","كِنْ هَلْ لِيَوْمِ رِضىً عَقِيبُ",31,"ب",1,0],["لَو دَرى عَيرٌ دَوائِرها","ما نَزا مِن هَولِ ما نَزَلا",32,"ل",2,0],["لو دَرَى كيف مَوقعُ العذلِ مني","كفَّ من غَربهِ وأقصر عني",33,"ن",2,1],["لو دَعَأهُم إِلى النُّجوم لَسَاروا","خَلْفَه يُزْمِعُون للنَّجْمِ قَصْدا",34,"د",2,0],["لو دَعا أَنْجُمَ السَّماءِ لَلبَّتْ","مُهْطِعاتٍ لأمْرِهِ صاغِرَاتِ",35,"ت",1,0],["لو دَرتْ من تكون تلك الليالي","ما أصابت بعلَّةٍ جُثْمَانك",36,"ك",1,0],["لو دَرَتْ من حملتْهُ، لثمت","قدميه حين تخطو قدماه",37,"ا",2,0],["لو دَرَى المُزنُ به ظلَّلَهُ","من هجيرٍ يشتكي الضبُّ لظاه",37,"ا",2,0],["لو دَرَى الفقرُ بمن يجتازهُ","ضجَّ بالتسبيح والذكر حَصاه",37,"ا",2,0],["لو درى الدَّوْحُ بمن مَرَّ بهِ","لحني الدوحُ له شمَّ الجبِاه",37,"ا",2,0],["لو درى الوحش به، ما نفرت","طبيةٌ منه، ولا فَرَّت مهاه",37,"ا",2,0],["لو درى الطير به، ما أجفلت","منه ورقاءُ، ولا ريعَتْ قطاه",37,"ا",2,0],["لو دافع الصبر حزنا ثم اذهبه","لكنت بين رجال الصبر كالجبل",38,"ل",1,0],["لو دام أيمانا لم تنطلق سقر","بدورها والأفاعي في مغانيها",39,"ي",3,0],["لودّ في كلّ مل يجريه من عسل","ومن خمور ومن درّ وعقيان",40,"ن",1,0],["لو دويتنّ مثلَ دائي، عذرْ","تنّ، ولكنْ رأيتكنّ صحاحا",41,"ح",2,0],["لوددت أن يبقَى بَقَا","ءَ الدهر أو طولَ الأَمَدْ",42,"د",1,0],["لو درتْ هذه الحمائمُ ما ند","رى لما رجَّعتْ على الغصن لَحنا",43,"ن",2,0],["لو دام عاماً واحد التبددوا","في كل أرض أيما تبديد",44,"د",1,0],["لو درى الأفقُ أنها فيكَ ما أط","لعَ شمسُ الضحى لئلا تغارا",45,"ر",2,0],["لَو دَروا مَعنى نَشيدي","لَرَأوني اِبنَ الخلودِ",46,"د",1,0],["لَو دَرَوا أَنَّ في الطَبيعَة عَدلاً","قَطع الظُلمُ كَفَّتَي ميزانِه",47,"ن",2,0],["لو دَرى رَبُّ المُروءاتِ رمى","لكَ ما رَجَّيتَ من حِصنٍ حَصين",48,"ن",1,0],["لَو دَعاني الدَهرُ يَوماً دعوةً","نحوه أَو قالَت الأَقدارُ هَي",49,"ي",1,0],["لو دافع المستضعفون دفاعَه","ما كان ثمَّ ثعالبٌ تستأْسد",50,"د",1,0],["لَو دَرى نفسهُ النفيسةَ يوماً","لَم يُذِلها في مَطلبٍ حَيَواني",51,"ن",2,0],["لَو دَرى المَرء حَظَّهُ مِن حَياة","لَقَضاها بِالهَمِّ وَالأَحزانِ",52,"ن",1,0],["لَو دَرى العُذّال إِذ عذلوا","بِهَواه صَبوَتي عَذروا",53,"ر",3,0],["لَوَدَّتِ الأنجُمُ في كُتْبِه","لَو جُعلَتْ أمكنةَ النَّقْط",54,"ط",1,0],["لَو دَرى الدَهرُ أَنَّهُ مِن بَنيهِ","لَاِزدَرى قَدرَ سائِر الأَولادِ",55,"د",1,0],["لَو دامَ مُعتَرِضُ القَتيلِ بِحالِهِ","لَرَضيتُهُ لكِنَّهُ يَزدادُ",56,"د",1,0],["لو دامَ ما ساءَ مِنْهُ","لدامَ ما كانَ سَرَّا",57,"ر",2,0],["لو دعا الشُّمَّ الرَّواسي أَمْرُه","لم تُجِبْ دَعوتَه إلاَّ امتثالا",58,"ل",2,0],["لو دَرَتْ إذ طلَبت تعذيبه","ما يقاسي بهواها لكفاها",59,"ا",3,0],["لودَعيٌّ لم تدع آراؤه","من أُمور الرأي أمراً مبهما",60,"م",2,0],["لو دبَّ كلُّ عائب","أفعَى لها لم تُلسعِ",61,"ع",1,0],["لو دَرى لا حَمَلتْ ناجيةٌ","رحلَهُ فيمن لحاني ما لَحَا",62,"ح",2,0],["لو درتْ جودَ عشرهِ مثل ما","ندري لغاضت غيظاً مياه السبع",63,"ع",1,0],["لَو دَخَلَ النارَ عَلى حَرِّها","لَماتَ مَن فيها مِنَ البَردِ",64,"د",1,0],["لَو دَبَّ حَوليُّ ذَرٍّ تَحتَ مِدرَعِها","أَضحَى بِها مِن دَبيبِ الذَرِّ آثارُ",65,"ر",1,0],["لو دَعا مَيْتاً لوافَى مُسرِعاً","أو دَحا الطَّوْدَ له ينهَدِمُ",66,"م",1,0],["لو دَرَى بِي مِثْلَ ما أَدْ","رِي لأَولانِيَ نُفْرَهْ",67,"ر",2,0],["لو درَى العاذلُ أنّي","لم أُطِعْه ما تعنّى",68,"ن",2,0],["لو دَرَى ماؤُها بما هيَ فيهِ","جفَّ أو صخرُها لَذابَ وسَالا",69,"ل",2,0],["لو دام هذا الحُزنُ ألقى رَبَّهُ","في اللحد قبلَ بِلَى الحبيبِ المُلحَدِ",70,"د",1,0],["لَوَدَّعتُ الجَزيرَةَ قَبلَ يَومٍ","يُنَسّي القَومَ أَطهارَ النِساءِ",71,"ا",2,0],["لو دُونت اعماله كل على","حدة لا عجزت الذي قد دونا",72,"ن",2,0],["لودَّعتُ أَرضِي وَسُكّانَها","وَحاوَلتُ فِي الأُفقِ لِي مصعَدا",73,"د",2,0],["لو دام لي عهد الشباب","لكنت حافظة عهودي",74,"د",2,0],["لَو دامَ لي وَعدُكَ المُحالُ وَلَو","عَلَّلتَني فالحَياةُ تَعليلُ",75,"ل",1,0],["لو دام هجري كنت اربح غادة","ملكَت على طول الزمان عميدا",76,"د",2,0],["لَوُدُّكم في صَميم قَلْبِي","ما غَيَّرَتْهُ صُروفُ بَيْنِ",77,"ن",1,0],["لو درى لا درى الفراق لما فرّ","ق بين المشتاق والمشتاق",78,"ق",1,0],["لودَّ قومٌ تُلِمُّ الدهرَ جامعَهمْ","بأنه كلَّهُ لا بَعْضَهُ جُمَع",79,"ع",1,0],["لودك في قلبي كقلبي كرامة","وبرك عندي لا يقوم له شكري",80,"ر",2,0],["لو دام ودك وانبسطت إلى امرىءٍ","في الود بعدك كنت أنت غررتني",81,"ن",2,0],["لو دفعته الكتائب اندفعت","إليه بالبيض والقنا السمر",82,"ر",1,0],["لو درى ما الهوى لأوسعنى في ال","حب عطفا ورحمة وحنانا",83,"ن",2,0],["لو دام ملك لم يكن بعد","الملوك لنا بصير",84,"ر",1,0],["لو دروا بعض ما تكن لخروا