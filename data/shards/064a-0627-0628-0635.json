{"poems":[[68,"يا بصيرا إلا بإبصار كتبي","https://www.aldiwan.net/poem38720.html","الخفيف"],[189,"كن من الدنيا على وجل","https://www.aldiwan.net/poem14629.html","المديد"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[549,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145891","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64545","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33169","السريع"],[4940,"يا بصمة في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=214660",""],[5174,"ضادٌ تُعطرُ روح الكون..","https://www.poetsgate.com/ViewPoem.aspx?id=184996",""],[5431,"للبصرة_وسنة الله حق دون تبديلِ","https://www.poetsgate.com/ViewPoem.aspx?id=199512",""],[5431,"بصرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=199811",""],[5790,"يا بصيرا بالمعمى","https://www.poetsgate.com/ViewPoem.aspx?id=111922",""]],"verses":[["يا بَصيراً إِلّا بِإِبصارِ كُتبي","وَجَواداً إِلّا بِرَدِّ جَوابي",0,"ي",1,1],["يا بصيرا ليس يُبِصر ما","فيه من عيبٍ ومن زَلل",1,"ل",1,0],["يا بَصرَةُ اِعتَرَفي بِأَنَّ بَصائِراً","فَقَدت لَدَيكَ رمى بِهِنَّ عناد",2,"د",1,0],["يا بصمةَ اللهِ في أبعادِ كوكبِهِ","حيث الفضاءُ كتابٌ والمَدَى وَرَقُ",3,"ق",1,0],["يا بَصرَةَ اللهِ شاءَ اللهُ مقدَرَةً","يُدمِيكِ مذْ كنتِ حتى آخرِ الحقبِ",4,"ب",1,0],["يا بصرةَ اللهِ ماذا بعدُ مِن شجنٍ","أقولُهُ إنَ صمتي الآن أجْمل بي",4,"ب",2,0],["يا بصيرا بما أبان لساني","يا عليما بما أكن ضمير",5,"ر",1,0],["يا بصير امنحني يقيناً وادرا","كاً وبصر سري بنورك واجل",6,"ل",1,0],["يا بصري ليتك ما كنتا","أسررت ما ألقى وأعلنتا",7,"ت",2,1],["يا بصرى حسبك ما خنتا","أنت الذي أهلكتني أنتا",7,"ت",2,0],["‏يا بصمة في القلب كيف أزيلها","ويداكَ قد ملأت خطاه وفِكْرَهْ",8,"ر",2,1],["يا بصمة _ ولكل روح بصمة _","جمعت بك الدنيا الجمالَ وسُكْرَهْ",8,"ر",2,0],["يابصمة الذات ياعشقي وفاكهتي","بك اكتفيتُ وهذا العشقُ نوّارُ",9,"ر",1,0],["يابصرة النور فيضي النور واغتسلي","لن تُطفئَ الفجرَ أحقادُ الأساطيلِ",10,"ل",1,0],["يابصرة السعد ياأرض الجنان ويا","مناجم الخير من جودٍ وتمويل",10,"ل",1,0],["يابصرة الملح ضمّي الجرحَ واحتسبي","فسنة الله حقٌ دون تبديلِ",10,"ل",1,0],["يابصرة الحب ياروح الحياة ويا","فرادس الخير كلّ الروح في أمرك",11,"ك",1,0],["يا بصيرا بالمعمى","وخبيرا بالأحاجي",12,"ي",1,1]]}