{"poems":[[74,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[53,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[119,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[449,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[458,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59757","الرمل"]],"verses":[["كلّ مربع سماطه كربيع","صاح يا مربع الخصيب ووبْله",0,"ل",2,0],["كلِّم رئيسي كلاماً في تعطفه","إن الكرام إذا ما استعطفوا عطفوا",1,"ف",3,0],["كلُّ مرعى سوى جنابِك يُرعَى","فهْو مرعى وليس كالسَّعدان",2,"ن",1,0],["كل مر من بعد هجرك حلو","يا بديع الصفات ما احلاكا",3,"ك",2,0],["كلّ مرّ من المليحة يحلو","ما خلا صدّها وطول جفاها",4,"ا",3,0],["كل مرأى لحسنك معنى","بل معان شريفة أريحيّه",5,"ي",2,0],["كلُّ مَرءوس يُرى","في يديه ورئيس",6,"س",1,0]]}