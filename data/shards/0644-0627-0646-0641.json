{"poems":[[74,"لأنف حاسدك الرغم الطويل فقد","https://www.aldiwan.net/poem20221.html","البسيط"],[53,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[53,"سماك خرءا بخل","https://www.aldiwan.net/poem65911.html","الطويل"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[46,"لو صحح الدمع لي أو ناصح الكمد","https://www.aldiwan.net/poem30314.html","البسيط"],[71,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[71,"مدحت أنطاكية","https://www.aldiwan.net/poem29298.html","مجزوء الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[53,"ومولًى يجرُّ الشرَّ لي غيرَ مؤْتَل","https://www.poetsgate.com/ViewPoem.aspx?id=30229",""],[185,"أنخنا قلوصينا وأرسلت صاحبى","https://www.aldiwan.net/poem59073.html","الطويل"],[216,"أهل خبر فيه النجيد لنا يروى","https://www.aldiwan.net/poem37825.html","الطويل"],[264,"يمم ندى غيث الكرام العلي","https://www.aldiwan.net/poem35740.html","السريع"],[280,"كفاني الحر منتجع الغمام","https://www.aldiwan.net/poem25530.html","الوافر"],[385,"لو كنت تبصر حالتي","https://www.aldiwan.net/poem48774.html","مجزوء الكامل"],[396,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[454,"بوركت من نهضة","https://www.aldiwan.net/poem975.html",""],[458,"عصابة من لصوص أمنها خطر","https://www.aldiwan.net/poem61283.html","البسيط"],[463,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[463,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[520,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[520,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[534,"صبرا أبا أحمد فالموت لا","https://www.aldiwan.net/poem37169.html","مجزوء البسيط"],[572,"جنبك الله عارض العلل","https://www.aldiwan.net/poem69535.html","المنسرح"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145779","المتقارب"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67845","الطويل"],[1033,"","https://poetry.dctabudhabi.ae/diwan/poem/18180","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124494",""],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142262","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104791","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113762","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93543","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65944","الكامل"],[3135,"","https://poetry.dctabudhabi.ae/diwan/poem/105704","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97884","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74033","المنسرح"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94436","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83173","المجتث"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104540","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72526","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120341","السريع"],[4869,"احتفال اليوم الوطني السعودي في الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=151631",""],[5002,"مشكاةُ الصَّبر....","https://www.poetsgate.com/ViewPoem.aspx?id=213617",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5281,"رحلة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=199222",""],[307,"كوفيدُ رفقاً ما لسيفك ينْحرُ","https://www.poetsgate.com/ViewPoem.aspx?id=213996",""],[5739,"هيه يالمسترجله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=131708",""],[5776,"أحتاجُ قلبا سماويا","https://www.poetsgate.com/ViewPoem.aspx?id=199437",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""],[454,"بوركت من نهضة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82681&r=&rc=45",""]],"verses":[["لأنف حاسدك الرغم الطويل فقد","ظهرت يا ابن عليّ مظهراً حسنا",0,"ن",2,1],["لا نفع في ذاك إن نظرت وإن","قوَّم منك الحياء والورع",1,"ع",1,0],["لأن في الخُرء نفعاً","للنخلِ والخلُّ يؤكَلْ",2,"ل",1,0],["لأنْفيَ نَوْمي لا لأشفِيَ غُلَّتي","على أنَّ عيني مُذْ فقدتُكِ لم تنمْ",3,"م",1,0],["لا نفع في طول الحياة فانها","كالماء ان يمكث طويلا يفسد",4,"د",1,0],["لَأَنفَدَنَّ أَسىً إِذ لَم أَمُت أَسَفاً","أَو يَنفَدُ العُمرُ بي أَو يَنفَدُ الأَبَدُ",5,"د",1,0],["لأنفْتُ مِنْ مدحي لهم متكسِّباً","فالكسبُ بالأمداحِ ثوبُ صَغارِ",6,"ر",1,0],["لأن في يس جا","ء ذكرُها وفضلُها",7,"ل",3,0],["لأَنَّ في أَولِ كلِّ شَطْرِ","حَركتينِ في ابتداءِ الصَّدرِ",8,"ر",1,0],["لأن في الخُرء نفعا","للنخلِ والنخلُّ يؤكل",9,"ل",1,0],["لأَنفعَهُ شَلَّت إِذا ما نَفَعَتُه","بِشَيءٍ وَقَد حُدِّثتُ حَيثُ يَميلُ",10,"ل",1,0],["لأنَّ فؤادي ذَائِبٌ من فِراقِهِ","ولا راحةً قد رام قطُّ ولا حَزْوَى",11,"و",2,0],["لا نفع فيه كامرءٍ ساقط","يعدي الورى من دائه المعضل",12,"ل",1,0],["لأَنْفُسِهمْ بِغايته غرامٌ","وَآنُفُهُمْ لَوَاصِقُ بِالرَّغامِ",13,"م",1,0],["لانفكَّ طَوق الكَرب بال","فرج المنفس عَن خِناقي",14,"ق",2,0],["لأن فيها كم حرج واخواف","فخف الهك يدركك بالطاف",15,"ف",1,0],["لان فيك خصالا قد خصصت به","نعم وأودع فيك الله اسرارا",16,"ر",2,0],["لا نفع منها وإن غنت بما وعدت","فكل نفع لها في طيه الضرر",17,"ر",1,0],["لا نَفَّرتْ عنك الليالي نعمةً","وطالما آنستَ وحشيَّ النِّعَمْ",18,"م",1,0],["لانَ في كفّي فأرخيتُ له","فمضى كالسهم لم أملك مُروقَهْ",19,"ق",2,0],["لأنفضنَّ الناسَ عن ظهري كما","قَطَّرَ بالراكبِ مجلوبٌ عُقِرْ",20,"ر",1,0],["لأنفضن الهون عن خاطري","نفض سقيط الطل عن منكبي",21,"ب",2,0],["لأنفت من تاريخه وسلبته","ذكر الفضيلة من شهور العام",22,"م",1,0],["لا نَفْعَ في هايٍ ولا وايَ أَوْ","في وَيْل أَوْ وَيْحَ لِذِي الفَهْمِ",23,"م",1,0],["لِأَنَّ فِي رَدِّهِ مُصَحَّفَةٌ","فَصُنْ رِسُولِي عَنْ ذِلَّةِ الخَجَلِ",24,"ل",1,0],["لأن فيما جاء في التنزيل","طاعة أهل الأمر والرسول",25,"ل",1,0],["لأن في فعلهم التوفيقا","فنصبوا لذلك الصديقا",25,"ق",2,0],["لأن في المشهور عند الناس","بأنها ماتت من النفاس",25,"س",1,0],["لأنَّ فِرَاقَ العِرَاقِ مَهولٌ","نُديمُ أسَانَا ليبقى مَهُولا",26,"ل",2,0],["لأَنَّ فُؤَادِي يَسْتَلذُّ حِمَامَهُ","فَرِيدُ فَنَا فِي الْحُبِّ يَسْتَعْذِبُ الْقَتْلاَ",27,"ل",2,0],["لَأَن فُجِّعتُ بِالقُرَباءِ مِنّى","لَقَد مُتِّعتُ بِالأَمَلِ البَعيدِ",28,"د",1,1],["لأن فيه تعرض الأسباب","من أجل ذاك رده الأصحاب",29,"ب",1,0],["لإِن فجعت بمن أودت مروءته","به واصبح نرجو الله مرحوما",30,"م",2,0],["لأن فؤادي في رياض ودادكم","مقيم على طول الزمان ويرتع",31,"ع",1,0],["لأَنفٌ عَدِيلٌ أنوَرٌ وَمُقَوِّمُ","هَنِيئاً لِمَن شَامَ وَجنةَ أَحمَدِ",32,"د",1,0],["لأنَّ فِراقاً مثل هذا وحقِّكُم","وصالٌ لأنَّ القَصدَ منهُ هو الوَصلُ",33,"ل",1,0],["لأنّ فيه غادةً طَفْلَةً","ترمي فتُصْمِي منّي المَقْتَلاَ",34,"ل",2,0],["لِأَن فاتَهُ سن الشَباب فَطالَما","أَعيد لَهُ إِن أَوقدت يَدهُ حَربا",35,"ب",2,0],["لأنَّ فيهَا عُلُوماً يَهتَدُونَ بِهَا","في البَرِّ والبَحرِ ذا زامٌ وذا مِيلُ",36,"ل",1,0],["لأنَّ في التَغليقِ جوزرات","أمطَارُهَا ثقيلةُ الماءات",37,"ت",1,0],["لأنَّ فيها الماءَ مِثلُ السَلسَلِ","فَكُن على قياسِهَا وَعَوِّلِ",38,"ل",1,0],["لأنَّ في الدامانِ مَعكَ الشَّبُّ","وَالجَوشُ بالياهُومِ فِيهِ الطبُّ",39,"ب",1,0],["لأنَّ في سَبعَةِ رُقّ البَحرِ","وَلا بِهِ الجَاهِل هُنَاكَ يَدري",39,"ي",1,0],["لأنَّ في أَوسَاطِ ذي الطريقِ","أرقَاقَ تَعرِفهَا على التَّحقِيقِ",40,"ق",1,0],["لا نفقٌ يغنيك عن ادراكها","إذا بدت صبحاً ولا صعود",41,"د",1,0],["لأن فقيدي الذين فقدتهم","هما علة الإيجاد للدين والهدى",42,"د",2,0],["لا نفع للناس من أموالهم ذهبت","ولا البنين بل الأعمالُ عقباك",43,"ك",1,0],["لا نَفس صاعِد وَلا حسّ","اللَهُ ماذا ترين يا نَفسُ",44,"س",1,1],["لأن فوق الثرى من أجله رفع ال","بيت العتيق ومنه فاز في الرتب",45,"ب",1,0],["لأن فيها مسجدٌ ونَهر","والنخل فيها باسقٌ والتّمرُ",46,"ر",1,0],["لأن فطرقل عزيزاً حسبا","لديه منذ لأخيل انتسبا",47,"ب",2,0],["لان فعال الفرد في كل ممكنٍ","تَسامت وقد فاقَت على حد مكنةِ",48,"ه",1,0],["لأَنَّ فَنَّكَ فَردٌ","بَعَثثُ في الكُتبِ فَردا",49,"د",2,0],["لا نفيضوا دماً على غير حق","أرخصوه وقد غلت أثمانه",50,"ن",2,0],["لإِن فَعَلنا ما لَم نَرَ اللَهَ فاعِلاً","على الشَكِّ بِالمَعبودِ في كُلِّ وُجهَةِ",51,"ه",1,0],["لأنفاس الكبى يا راحة الأرواح عللها","على عيني وقلبي حسنك الفتان قد غشى",52,"ش",2,0],["لا نفع منها غير أني بها","اطلى الذي عند السوى من زجاج",53,"ج",1,0],["لان فيها الحرَمين الشريفه","ولا غير الشريعه تحتمينا",54,"ن",2,0],["لانفحةٌ للوفا هبَّتْ نسائمُها","كي تزدَهِي دوحةُ الآتي لمن غَفَروا",55,"ر",3,0],["لانفك يحمي حوزة الإسلام إن","يسمى ويدرأ عن مقر المذهب",56,"ب",1,0],["لا نَفخَرُ اليَومَ بالأَنسَابِ دُونَ هُدَىً","-كَمَا أَمَرتَ- ولَكِنَّا ادَّخَرنَاهَا",57,"ا",3,0],["لا نفع يرجى حين تحْتدمُ الوغى","فسلاحهمْ خشبٌ بنارٍ تسعرُ",58,"ر",1,0],["لا نفخ بالصور ثم نبتت بذور.","من يجيرك لابغيتي لك مجير.",59,"ر",1,0],["لأن في كل قلب يسكن الحب","أحببت طه فهل يستحملُ القلبُ",60,"ب",1,1],["لأن فيها برم فارت وهمم بارت","وحدايات عفاريت طارت في أرض ابو قير",61,"ر",1,0],["لان فيك خصالا قد خصصت بها","نعم وأودع فيك الله اسرارا",62,"ر",2,0]]}