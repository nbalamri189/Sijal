"https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147461","الكامل"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40276","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21021","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42604","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54761","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54526","الوافر"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12784","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43774","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43849","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43643","الطويل"],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"أهلا بِمَقْدمِكَ السَّنِّي ومرْحبا","https://www.poetsgate.com/ViewPoem.aspx?id=33308",""],[77,"سلوا عن فؤادي بعدكم كيف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=34157",""],[50,"يا صَاحِ بيِّن حَاجَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=21822",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"الليل والشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=178930",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[45,"هَلْ أنْتَ مُستَمِعٌ لِمَنْ نَاداكَا","https://www.poetsgate.com/ViewPoem.aspx?id=32145",""],[45,"مَحَلٌّ على القَاطُولِ أخْلَقَ داثِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31192",""],[80,"لله شمسٌ كانَ أوّلها السّها","https://www.poetsgate.com/ViewPoem.aspx?id=3769",""],[91,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[51,"يا تناهٍ والتَّناهي انقطاعُ","https://www.poetsgate.com/ViewPoem.aspx?id=29590",""],[51,"لستُ أبكي على نوالِ صديقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29915",""],[51,"أبا حسنٍ لا زلتَ منّا على قُربِ","https://www.poetsgate.com/ViewPoem.aspx?id=27027",""],[51,"بدا الشيبُ في رأسي فَجَلَّى عَمَايتي","https://www.poetsgate.com/ViewPoem.aspx?id=27410",""],[105,"أما ينهى دعاة السوء عنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54880&r=&rc=50",""],[85,"صريعُ جفنيك ينفي عنهما التُّهَما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9566&r=&rc=56",""]],"verses":[["صُرِفَ الطَرفُ عَنكَ لا عَن تَقالٍ","وَأُقِلَّ اللِقاءُ لا عَن تَواني",0,"ن",2,0],["صَريعُ هُمومٍ يَحسَبُ الناسُ أَنَّني","لِما أَخَذَت مِنّي صَريعُ مُدامِ",1,"م",1,0],["صِراعاً لِلزَمانِ العَو","دِ أَغلوهُ كَما يَغلو",2,"ل",2,0],["صَرَّحَ الاِقتِضاءُ وَالقَولُ مَحبو","سٌ عَلى ما تُريدُهُ مَوقوفُ",3,"ف",1,0],["صَرَفتُ نَفسِيَ عَنكُم وَهيَ غانِيَةٌ","وَالنَفسُ تُصرَفُ أَحياناً فَتَنصَرِفُ",4,"ف",1,0],["صَرعى عَلى جِسرِ الهَوى لِشَقائِهِم","يَتَصَبَّرونَ وَما بِهِم صَبرُ",5,"ر",1,0],["صَرَمَ الأَحِبَّةُ حَبلَهُ فَكأَنَّهُ","إِذ غادَروهُ وَضَرَّهُ الإِضرارُ",6,"ر",1,0],["صَرْعَى عَلَى عَفْرِ الرِّمَالِ وَلِيمَةً","لِلْحُوتِ أَوْ لِلطَّيْرِ أَوْ لِلضَّيْغَمِ",7,"م",1,0],["صَرَفْتُ إِلَى اللهِ الرَّجَاءَ ضَرَاعَةً","وَمَا خَابَ يَوْماً مَنْ عَلَيْهِ اتِّكَالُهُ",8,"ل",2,0],["صَرَفَ العِنَانَ إِلَيَّ غَيْرَ مُنَكِّبٍ","عَنِّي وَأَثْبَتَ دُونَ ثُغْرَتِيَ الشَّبَا",9,"ب",2,0],["صَرَمتُ وَلَم أَصرِمكُمُ وَكَصارِمٍ","أَخٌ قَد طَوى كَشحاً وَأَبَّ لِيَذهَبا",10,"ب",2,0],["صَرّوفُ لا تَبعُد فَلَستَ الَّذي","يَطويهِ طاوي ذَلِكَ المَضجَعِ",11,"ع",1,0],["صِراعٌ وَعَدوٌ بَعيدُ المَدى","وَوَثبٌ يَكادُ يَنالُ السُها",12,"ا",1,0],["صَرَفتُ الهَوى عَنهُنَّ مِن خَشيَةِ الرَدى","وَلَستُ بِمُقليِّ الخِلالِ وَلا قالِ",13,"ل",1,0],["صَريعِ أَرماحٍ وَمَشحوذَةٍ","كَالبَرقِ يَلمَعنَ خِلالَ الدِيار",14,"ر",1,0],["صَرَّفْتَ رَأْيَكَ فِيهِ فَاضْطَلَعْتَ بِهِ","مُؤَيَّدَ الرَّأْيِ بِالأَرْمَاحِ والقُضُبِ",15,"ب",1,0],["صَرَّفْتَ عَقْلَكَ فِي الفُنُونِ فَلَمْ","يَفْلُتْهُ أَجْدَاهَا وَأَجْوَدُهَا",16,"د",3,0],["صِرْنَا حَيَارَى سُكَارَى مِنْ تَخَاذُلِنَا","وَأَسْعَفَتْهُمْ يَدَانَا فِي تَلاشِينَا",17,"ن",2,0],["صَرْحٌ نَمَى البِرُّ مَبْنَاهُ وَبَانِيهِ","قَدْ بَارَكَ اللهُ فِي مَبْنَاهُ وَالبَانِي",18,"ن",2,0],["صَرْحٌ لِعِزِّهِ مِصْرَ تَرْفَعُهُ","وَأَسَاسُهُ مَتَخَضِّلٌ بِدَمِ",19,"م",1,0],["صِرْ إِلَى اللهِ ثَمَّةَ الرَّاحَةِ الكُبْ","رَى وَثَمَّ الْخُلُودُ يَا نَعُّومُ",20,"م",1,0],["صَرَّفْتُ تَنْشِئَةَ الشَّبَابِ بِحِكْمَةٍ","وَهْدَىً كَأَحْسَنِ مَا أَسامَ مُسِيمُ",21,"م",1,0],["صَرَّفْتِهَا فِي ضُرُوبٍ","مِنْ بِرَّكِ المُتَوَالي",22,"ي",1,0],["صَريعُ تَنائِفٍ وَرَفيقُ صَرعى","تُوُفّوا قَبلَ آجالِ الحِمامِ",23,"م",1,0],["صَرى آجِنٌ يَزوي لَهُ المَرءُ وَجهَهُ","وَلَو ذاقَهُ ظَمآنُ في شَهرِ ناجِرِ",24,"ر",1,0],["صرفوا إليكَ ركابَهم وتيمموا","من بابك المنتاب خير مُيّمَمِ",25,"م",1,0],["صرنا إلى جنب بني رومة","ننفر من نافرنا وافتخر",26,"ر",1,0],["صرعت في الوغى ليوث من اليا","بان أسطول خصمها مفروسا",27,"س",2,0],["صَرحت في إنشادها بحقيقة","فات الأنام بمثلها التعريض",28,"ض",1,0],["صرّفت فيهنّ أقلامي ورحت بها","أعرّف الناس سحر السمع والبصر",29,"ر",1,0],["صرع النهى فالوهم فيه تيقّن","تحت الملامح واليقين توهّم",30,"م",1,0],["صَرَمَ الخَليطُ تَبايُناً وَبُكورا","وَحَسِبتَ بَينَهُمُ عَلَيكَ يَسيرا",31,"ر",2,1],["صَريحاً لَم تَلِد أَبَوَيهِ تَيمٌ","وَلَم يُنسَب لِأُختِ بَني حُذارِ",32,"ر",1,0],["صَرَمتُ اللَواتي كُنَّ يَقتَدنَ ذا الهَوى","شَبيهٌ بِهِنَّ الرَبرَبُ المُتَآلِفُ",33,"ف",1,0],["صَرَمتُ حِبالَها وَصَدَدتُ عَنها","بِناجِيَةٍ تَجِلُّ عَنِ الكَلالِ",34,"ل",1,0],["صَرَّ رجلَ الغرابِ مُلكُك في النا","س على من أراد فيه الفجورا",35,"ر",2,1],["صرفت إليك القصد عن كلّ باذل","وقلت امرؤ بالفضل أدرى وأدرب",36,"ب",1,0],["صرعت طيراً وسكنت الحشى","فما تعدَّيتَ عن الواجب",37,"ب",1,0],["صرع الأسود بمقلة نجلاء إن","تلمح صوارمها بجفن تقطع",38,"ع",1,0],["صرفت لجود تاج الدين قصدِي","ولم أرَ بعد ذا عنه انصرافَه",39,"ه",1,1],["صرت من وهميَ تيساً","للمراعي يتشمَّمْ",40,"م",1,0],["صرفت فعلي في الأسى وقولي","بحمدِ ذي الطُّول الشديد والحول",41,"ل",1,1],["صرَّحتْ عن طَويّة الأصدقاءِ","واضحاتُ التجريب والابتلاءِ",42,"ا",2,1],["صرفتَ قلوبَ الناسِ عن كلِّ صاحبٍ","إليك بما أُلبستَ من قِلَّةِ العُجْبِ",43,"ب",1,0],["صَريخٌ لو اسْتَصْرخْتَه يا ابن طاهرٍ","على الدهر إذ أخنى عليك لأَصْرخا",44,"خ",2,0],["صَرَفَتني عن مالِه بَدأَة المُسْ","رِفِ صَرْفَ الكريم لا المطْرودِ",45,"د",1,0],["صرف السماعُ نوى المقلِّد نحوهُ","وحدا القياسُ إليه بالقَيَّاس",46,"س",1,0],["صرمتَ اليوم حبلَكَ من لَميس","على ما في فؤادك من رسيس",47,"س",1,1],["صَرّاعُ باغ وإنني لأخٌ","للعاثر الجدِّ جدُّ نعّاش",48,"ش",1,0],["صُرُّوا ضُراطَكُم المُبذِّرَ صرَّكم","عِند السُؤال الفَلْسَ والقيراطا",49,"ط",2,0],["صر