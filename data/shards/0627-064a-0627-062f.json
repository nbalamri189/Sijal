الربيعُ فخيِّم","https://www.poetsgate.com/ViewPoem.aspx?id=135327",""],[5121,"يا دمعي","https://www.poetsgate.com/ViewPoem.aspx?id=33667",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5156,"أياديك عندي معظمات جلائلض","https://www.poetsgate.com/ViewPoem.aspx?id=99147",""],[5160,"أيا دنيا","https://www.poetsgate.com/ViewPoem.aspx?id=175361",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5277,"رسائلُ عشقٍ بغدادية..5","https://www.poetsgate.com/ViewPoem.aspx?id=191524",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[5376,"قدِ ارْتدَّ طرفيْ بالشآم ِتَوَجُّعَا","https://www.poetsgate.com/ViewPoem.aspx?id=197597",""],[351,"وسِرْبٍ كَعَيْنِ الدِّيكِ مَيلٍ إلى الصّبا","https://www.poetsgate.com/ViewPoem.aspx?id=4529",""],[5595,"العظيم له احتراما","https://www.poetsgate.com/ViewPoem.aspx?id=144522",""],[5650,"غوايةُ الموجِ الغَدور","https://www.poetsgate.com/ViewPoem.aspx?id=177956",""],[5664,"الغيبوبه","https://www.poetsgate.com/ViewPoem.aspx?id=176683",""],[5691,"شآم العزة...","https://www.poetsgate.com/ViewPoem.aspx?id=206441",""],[5697,"لحن الصباحات","https://www.poetsgate.com/ViewPoem.aspx?id=178328",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5781,"لا سيّداتي نحنُ لسنا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=202846",""],[402,"حديث ما تجدد يستعاد","https://www.poetsgate.com/ViewPoem.aspx?id=35392",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[5956,"أيها البحر العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=183229",""],[5957,"عراقية النبض تهدي السلام","https://www.poetsgate.com/ViewPoem.aspx?id=177054",""],[5969,"يُسَلينا التَفَكُرُ في المُحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=198976",""],[6045,"عروبي ساخط !","https://www.poetsgate.com/ViewPoem.aspx?id=125347",""],[6093,"ذَارِيْ الرِّيْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=187943",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""],[6124,"تأتأ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=174701",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[520,"سرت نفحة كالمسك ازهى وأعطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577523",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""],[5519,"لحن الغياب ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69278&r=&rc=11",""]],"verses":[["أَيا دارَ الأُلى دَرَجَت عَلَيها","حَوايا المُزنِ وَالحِجَجُ الخَوالي",0,"ل",2,0],["أَيادي أَميرَ المُؤمِنينَ كَثيرَةٌ","وَمالُ إِمامِ المُؤمِنينَ مُذالُ",1,"ل",1,0],["أَيا دَهرُ لِم فَرَّقتَ بَينَ أَحِبَّتي","وَما تَبتَغي مِن شَمليَ المُتَشَتِّتِ",2,"ت",1,0],["أَيَا دَهْرُ كَفْكِفْ مِنْ جماحِكَ إِنَّني","إِذَا الخَطْبُ أَمْهى نابَهُ أَسَدٌ وَرْدُ",3,"د",1,0],["أيادِيكَ نُهْبَى الحَمْدِ في كُلِّ مَوطِنٍ","تَميلُ بأسْماعٍ إليْكَ وأبْصارِ",4,"ر",1,0],["أيَادِيكَ لاَ أَنْسَى عَلَى بُعُدِ الْمَدَى","نَعُوذُ بِكَ اللَّهُمَّ مِنْ شَرِّ نِسْيَانِ",5,"ن",1,0],["أيادِيهِ سحّتْ في الوَرَى برَكاتُها","فأيّامُهُمْ بيضُ اللّيالي صَوالِحُ",6,"ح",1,0],["أَياديكَ عَينٌ تَستَهِلُّ بِعَينِ","وَفَضلكَ شَمسٌ لا تُصَدُّ بِغَينِ",7,"ن",1,1],["أَيادٍ قَد عُرِفنَ مُظاهَراتٍ","لَهُ فيها التَطاوُلُ وَالفُضولُ",8,"ل",1,0],["أَيادي سَبا يا عَزُّ ما كُنتُ بَعدَكُم","فَلَم يَحلَ لِلعَينَينِ بَعدَكِ مَنزِلُ",9,"ل",1,0],["أَيادي سبا يا عَزَّ ما كُنتُ بَعدَكُم","فَلَم يَحلُ لِلعَينَينِ بَعدَكِ منظَرُ",10,"ر",1,1],["اياد حين تنسب من معد","وإن رغمت أنوف الراغمينا",11,"ن",2,0],["أيادِي عليٍّ رحمةُ اللهِ في الورَى","فأن يبغِ باغيهِم فهنَّ عذاب",12,"ب",1,0],["أيا دارُ دارَ اليمنُ من كل وجهةٍ","عليكِ ولا زالَ الهنَا لكِ يُجلب",13,"ب",1,1],["أيادٍ بوادٍ لا تُفيق وشايةً","بأيدِ انتهاءٍ وهي مُستتَراتُ",14,"ت",1,0],["أيادي بني الجرّاح عندي كثيرةٌ","وأكثرُ منها أنها لا تُكَدَّرُ",15,"ر",1,1],["أَياديكَ عِندي لا يَغُبُّ سِجامُها","يَجودُ إِذا ضَنَّ الغَمامُ غَمامُها",16,"م",3,1],["أَياديهِ بيضٌ في الوَرى موسَوِيَّةٌ","وَلَكِنَّها تَسعى عَلى قَدَمِ الخِضرِ",17,"ر",1,0],["أَيادي اللَهِ ما عوفيتَ وافٍ","سَنا الأَوضاحِ مِنها وَالحُجولِ",18,"ل",1,0],["أيادٍ سحائبُها ثَرَّةٌ","تفيض رَواحاً وتَهمي ابتكارا",19,"ر",2,0],["أَيا دَهرُ قَد قَلَّلتَني بَعدَ كَثرَةٍ","وَأَوحَشتَني مِن بَعدِ أُنسٍ وَمُجتَمِع",20,"ع",1,0],["أيا دادا حكَتْ صدغاكِ واواً","فما أحلى ثناياكِ العذابا",21,"ب",2,1],["أياديك ذِكرٌ للكنانةِ صاعدٌ","ومجدٌ يُبارِي همّةَ النّجمِ طامِحُهْ",22,"ح",2,0],["أيادي اللّهِ يجعلها ثواباً","لكلِّ مُجاهدٍ نِعمَ الثّواب",23,"ب",1,0],["أَيا دَهرُ لا تُرعي عَلَينا وَلا تُبقي","فَرِفقاً بِنا بَل لا أَرى لَكَ مِن رِفقِ",24,"ق",1,1],["أَيا ديكُ عُدَّت مِن أَياديكَ صَيحَةٌ","بَعَثتَ بِها مَيتَ الكَرى وَهُوَ نائِمُ",25,"م",1,1],["أَيا دارَ سَلمى بالحَرُورِيَّةِ اِسلَمي","إِلى جانِبِ الصَمّانِ فَالمُتَثَلَّمِ",26,"م",1,1],["أَيَادِيكُمْ وَقَدْ بُسِطَتْ إِلَيْهِمْ","بِحَارٌ لِلْبِحَارِ بِهَا ارْتِفَادُ",27,"د",1,0],["أَيا دَهرُ خَلَّطتَ مِن بَعدِهِ","كَذا يَنبَغي بَعدَهُ أَن تَكونا",28,"ن",2,0],["أَيَا دَاوُدُ وَالذكْرَى بَقَاءٌ","ظَفِرْتَ بكُلِّ أَسْبَابِ الْبَقَاءِ",29,"ا",2,0],["أيا دمية أنشأتها وعبدتها","كما عبد الغاوون منحوت أحجار",30,"ر",1,1],["اياد عن الطهر البتول وحيدر","مورثة ما مس جانبها النكر",31,"ر",1,0],["أياديه لا تُحصى عداداً وكثرةً","وساحاتُه للأكرمين جوامِعُ",32,"ع",1,0],["أياديه لا تُحصى عداداً وكثرةً","تجلُّ عن الإحصاءِ والعدّ والحصرِ",33,"ر",1,0],["أيادٍ توالت منك عًجلَى كأنها","شَرارٌ أطارته الأكفُّ من الزَّندِ",34,"د",1,0],["أَياديكَ أَغنَت عَن مَدائِحِ مَعشَرٍ","مَدائِحُهُم لِلناظِميها مَثالِبُ",35,"ب",1,0],["أَيادِيَ يَغمِرُني جودُها","كَما غَمَرَ الأَرضَ جَودُ المَطَر",36,"ر",1,0],["أَيادٍ تُباري الغَيثَ إِبّانَ هَطلِهِ","وَتَخلُفُهُ فينا إِذا هُوَ أَقلَعا",37,"ع",2,0],["أَيادٍ جُدنَ سَحّاً وَهيَ بيضٌ","بِما يُعيي السَحائِبَ وَهيَ جونُ",38,"ن",1,0],["أَيَا دِمْنَةَ الْلذَّاتِ لازَالَ دائِماً","عَلَيْكِ مِنَ الإِشْراقِ نُورُ بَهاكِ",39,"ك",1,0],["أياد في الرقاب لها عهود","وثاق لا يحل لهن عقد",40,"د",1,0],["أياديك قد علمتني طلب العلا","فما لي سوى العلياء عندك مطلب",41,"ب",1,0],["أَيا دَمعِ اُسقِ قَبراً أَرَّخوهُ","بَكَيتُ بِهِ ذُبولَ الزَهرَتينِ",42,"ن",1,0],["أَيادٍ في الوَرى اِتَّسَعَتْ وَعَمَّتْ","فَما تَرَكَتْ لَنا في الحَمدِ وُسعا",43,"ع",2,0],["اياديك جلت ان تقاس بغيرها","وتالله غيث لا يقايس بالندى",44,"د",2,0],["أيادٍ لا يقوم بهن شكر","وشكر لا يقوم به لساني",45,"ن",2,0],["أيا دَيْرَ مَرْحَنَّا سقتك رُعود","من الغيث تَهْمِي مرّةً وتعودُ",46,"د",1,1],["أَيادٍ كَأَطواقِ الحَمامِ وَأَنعُمٌ","تَقَرُّ بِها الأَعناقُ طَوعاً وَتَشهَدُ",47,"د",1,0],["أيادٍ أرتنا كفَّها خيرَ راحةٍ","لإحيا مواتِ الفضل وهي رِمام",48,"م",1,0],["أيا دار بثن بالعواصم لا عدت","ثراك بواكي السحب أو يمسى ضاحكا",49,"ك",2,0],["اياد بدينه الاديان حقا","وَكانَت قبل زورا وافتراء",50,"ا",2,0],["أَيَادٍ كَفَتْ مَا أَتَّقِي وَاكِفَاتُه","فَلا أَرْتَضِي حَدَّ الثَنَاءِ لَهَا كُفْوَا",51,"و",2,0],["أَيَا دَولَةَ الآدابِ والعِلْمِ سَامِحِي","بَليغاً إِذا أَفْضى لتِلكَ الحُلَى أفْصَى",52,"ص",2,0],["أيادٍ ما أعَمَّتْ في ازْدِيادٍ","كَما انْتَثَرَ الفَرِيدُ منَ النِّظامِ",53,"م",1,0],["أَيا دَهْرُ إِنْ حَمَّلتَنِي وَيْكَ مِنَّةً","لِمُولِي جِمِيلٍ فَلْتَكُنْ لأَبِي الْيُمْنِ",54,"ن",1,0],["أَياديكَ غُرٌّ فَوَبلُ الصَبيرِ","تَلا الطَل عِندَ تَوالي نَداها",55,"ا",3,0],["أَيادٍ في الوَرى عَمَّت فَصارَت","هِيَ الأَطواقُ وَالناسُ الحمامُ",56,"م",1,0],["أَياديهِ أَنسَتني دِمَشقَ وَأَهلَها","وَإِن أَشبَهَت في حُسنِها جَنَّةَ الخُلدِ",57,"د",1,0],["أَيا ديكَ الصَباحِ لَسَوفَ تَجني","أَياديكَ الصباحُ جنى مَديحي",58,"ح",2,0],["أيا داركم عمرت والسعد مقبل","عليك وكم بالعلم سادت بك الغبرا",59,"ر",2,0],["أَيادٍ عالياتِ الكعبِ تُنسي","إِياداً كعبها لمّا يجودُ",60,"د",1,0],["أَيادِياً مُعييَةَ الحُسّابِ","تَبقى وَمُوليها عَلى الأَحقابِ",61,"ب",1,0],["أَيا دَهرٌ مَتى تَرضى","فَقَد طالَ بِكَ ال