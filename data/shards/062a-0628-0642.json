ا فَرَزدَقُ وَالقَذى","وَالمُخزِياتُ بِعَينِكَ العُوّارا",0,"ر",2,0],["تَبقى وَيَبقَونَ في نَعيمٍ","ما بَقِيَ الرُكنُ وَالحَطيمُ",1,"م",1,0],["تبقى على مرِّ الزمان وغيره","عاف الذّرى متوعر الأكناف",2,"ف",1,0],["تبقى ويمضون عُمراً لا انقطاع له","مُفضَّلاً بعطاء اللَّه ما اتصلا",3,"ل",2,0],["تبقى العيون اليه شاخصة فما","هي عنه زائغة ولا هي تطرف",4,"ف",1,0],["تبقى المودة حتى الموت بينهما","فما هنالك شنآن ولا ملل",5,"ل",1,0],["تبقى الحياة على الارزاء طيبة","ما دامت النفس بالآمال تتصل",5,"ل",1,0],["تُبقي عَواقِبَ سوءٍ في مَغَبَّتِها","لا خَيرَ في لَذَةٍ مِن بَعدِها النارُ",6,"ر",1,0],["تَبقى صَنائِعُهُم في الأَرضِ بَعدَهُمُ","وَالغَيثُ إِن سارَ أَبقى بَعدَهُ الزَهرا",7,"ر",2,0],["تَبَقَّى بقاءَ القلب يَنبِضُ دائماً","وليسَ لسلوانٍ وليس إلى تَرك",8,"ك",1,0],["تَبقى كَنَقشِ الصخرِ وهيَ شَواردٌ","مَثَلُ المقيمِ بها وحَدْوُ الحادي",9,"د",2,0],["تَبقى وَتُؤخَذُ ما أَرادَ وَما أَبى","لا شَيءَ غَيرَ تَحَكُّمِ وَخِيارِ",10,"ر",1,0],["تَبْقَى الصَّلاةُ عليهِ دائمَةً فَخُذ","وَصْفَ النبيِّ مِنَ الزُّبُورِ مَقُولا",11,"ل",2,0],["تبقي على الأشواك من أصوافها","خصلاً مخضبة بأحمر قان",12,"ن",1,0],["تبقين أنت فقهقهي","مما يدور ببال غابه",13,"ب",2,0],["تبقين أنت ويذهبون إذا","الصباح جلا ضبابه",13,"ب",2,0],["تبقين أنت ويذهبون","ذبابة تتلو ذبابه",13,"ب",2,0],["تبقى من الشهوة العمياء سوأتُها","للمشتهينَ ويفنَى الحرصُ والنَهَم",14,"م",1,0],["تبقى كنقشِ الصخرِ وهي شواردٌ","مَثَلُ المقيمِ بها وحَدْوا الحادي",15,"د",2,0],["تبقَى بِمَيدانِ السِّباقِ مُخَلَّفاً","كَمَا خَلّفَ الطِّرفُ السَّبُوحُ هَجِينَا",16,"ن",2,0],["تبقى الفوارس والكتابُ حائرةً","إن قط بالسيف أو إن خط بالقلمِ",17,"م",1,0],["تَبقى عَلى المَرءِ وَيَف","نى ما اِقتَنى وَما اِختَزَن",18,"ن",1,0],["تَبقى عَلى الأَيّامِ مَوصولاً بِأَي","يامِ الخُلودِ بَقاؤُها وَدَوامُها",19,"م",3,0],["تَبقى بَقاءَ الأَيامِ حالِيَةً","بِالعَدلِ مِنكَ الآثارُ وَالسَيرُ",20,"ر",1,0],["تُبقي عَلى الأَيّامِ مِنهُ قِلادَةً","كَالعِقدِ في عُنقِ الفَتاةِ الكاعِبِ",21,"ب",1,0],["تبقى عليك الزمان حمداً","يطول في وصفه الشروح",22,"ح",1,0],["تَبْقى الذَّخائِرُ مِنْ فَضْلاتِ نائِلِهِ","كَأَنَّها غُدُرٌ مِنْ بَعْدِ أَمْطارِ",23,"ر",1,0],["تُبقي السُرورَ وَتَنفي هَمَّ شارِبِها","عَن قَلبِهِ فَهوَ لاهٍ غَيرُ مَحزونِ",24,"ن",1,0],["تَبقَى ويَبقَونَ في نَعماءَ عاكفةٍ","وعيشةٍ ما لكم من وِرْدِها صَدَر",25,"ر",1,0],["تَبقَى طوالَ الدّهرِ حيث صَفّها","من قصَدِ المرّانِ وهْو مُحتَطَب",26,"ب",1,0],["تَبقى خُطوطُ رَمادٍ في القُبورِ بِما","رَأَيتَ شُعلَةَ هَذي النارِ في الفَحَمِ",27,"م",1,0],["تبقى الحصون منيعةً أسوارها","مادام يرفع باليقينِ شعارُها",28,"ر",3,1],["تبقى البلادُ عزيزةً بثباتِها","وبحبِّ ما يدعو إليهِ خيارُها",28,"ر",3,0],["تبقى الشَّواطئ للسفينةِ مأمناً","إن كان في بحر الردى إبحارُها",28,"ر",3,0],["تبقى الشهورُ على تألُّقِه","تمضي، وأنتَ السَّيِّدُ الشَّهْرُ",29,"ر",1,0],["تبقى الحضارة لوحةً مطموسةً","لمَّا يُديرُ شؤونَها عِرْبيدُ",30,"د",1,0],["تَبقى قَوافي الشِعر ما بَقيتُ","وَالشِعرُ مَنسِيٌّ إِذا نُسيتُ",31,"ت",1,1],["تبقى كذا في نعيمٍ ما له أمدٌ","تعيشُ ألفاً ولا تعلو عليك يدُ",32,"د",1,0],["تبقَي كعوبُ الرماح سالمةً","ويرتقي في العوامل الحطمُ",33,"م",1,0],["تبقَى مع الدهر فإن تنكَّرتْ","بالدهر حالٌ لم تزل بحالها",34,"ل",3,0],["تَبقَى عليك والذي نأخذهُ","من الجزاءِ مضمحِلٌ بائدُ",35,"د",1,0],["تبقَى على الدهر وِساعَ الخُطَا","في جَوْبِها الأرض طِوالَ المدى",36,"د",2,0],["تَبقى بَوارِقُه ُ، تَبقى فَيالِقُه ُ","تَبقى بَيارِقُهُ زُهْرَ التَّلاوين ِ",37,"ن",1,0],["تَبقى،وَيَبقى ضَوءُ وَجهِكَ حاسِرا ً","عَدَدَََ السِّنين ِلَهُ شموسٌ تَسطَعُ",38,"ع",1,0],["تَبقى القبورُ وِلا دا تٍ مؤَجَّلَة ً","ما دامَ فيها كِبارُ الهَمِّ سُكَّانا!",39,"ن",2,0],["تبقى لأمثالٍ له","في نِعَمٍ لا تنثَلِمْ",40,"م",1,0],["تَبقى بَقاءَ الطالِعات دُجىً","مِن غَيرِ مَنقصةٍ ولا ثلمِ",41,"م",1,0],["تبقَى مدَى الدُّنيا وأَمثالها","طُولاً وهَذا القولُ مِنِّي اخْتصارْ",42,"ر",1,0],["تبقى تشكي لاي من جه","وآخرو ما قلت أمس",43,"س",1,0],["تبقى بها كل النجوم","تضئ داجية الليالي",44,"ل",2,0],["تبقى الخلافة فيهم كي يسلِّمَها ال","مهدي منهم إلى عيسى كما أثَرا",45,"ر",2,0],["تبقى النجوم دوائراً أفلاكها","والأرض فيها كل يوم داعي",46,"ع",2,0],["تبقى حياة السالفي