ه التنعم أملدا","https://www.poetsgate.com/ViewPoem.aspx?id=121550",""],[5205,"حتام يا من صان ظلماً","https://www.poetsgate.com/ViewPoem.aspx?id=120990",""],[5277,"في عينكِ تاهتْ أشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=200889",""],[5281,"حُسنُ الخِتامِ","https://www.poetsgate.com/ViewPoem.aspx?id=200234",""],[5302,"محنة مسلمي الروهينغا","https://www.poetsgate.com/ViewPoem.aspx?id=201898",""],[5409,"حتام يحدو الليل في","https://www.poetsgate.com/ViewPoem.aspx?id=155294",""],[5461,"سمرت","https://www.poetsgate.com/ViewPoem.aspx?id=34730",""],[5525,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=7272",""],[5525,"دم الاطراف","https://www.poetsgate.com/ViewPoem.aspx?id=34728",""],[5542,"عندما يعزف الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=10187",""],[5582,"هَلْ ذاكَ بَدْرٌ لاحَ تَحْتَ غَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63579",""],[5606,"بنت القبيله","https://www.poetsgate.com/ViewPoem.aspx?id=196769",""],[5615,"عقوبة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=188258",""],[5629,"جداً حزين","https://www.poetsgate.com/ViewPoem.aspx?id=184504",""],[5652,"كثير احظوظ ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=190145",""],[5732,"نشدت اهل الموده","https://www.poetsgate.com/ViewPoem.aspx?id=177950",""],[5809,"إبحار","https://www.poetsgate.com/ViewPoem.aspx?id=205094",""],[5818,"وإلى متى الفيفاء في أملٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193122",""],[5818,"قلبي يئنّ وتستجير الأضلع","https://www.poetsgate.com/ViewPoem.aspx?id=200195",""],[5848,"محراب صمتك","https://www.poetsgate.com/ViewPoem.aspx?id=53163",""],[5848,"الدعيع والشلية","https://www.poetsgate.com/ViewPoem.aspx?id=49006",""],[5853,"كلاسيكية على جدار التجريد","https://www.poetsgate.com/ViewPoem.aspx?id=175721",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5974,"أُسْتَاذي","https://www.poetsgate.com/ViewPoem.aspx?id=200426",""],[5997,"لا تسألي","https://www.poetsgate.com/ViewPoem.aspx?id=214211",""],[6027,"لي في هواك .. تعقل وجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187195",""],[6056,"حالة وراثية","https://www.poetsgate.com/ViewPoem.aspx?id=130318",""],[6159,"كوز الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85858&r=&rc=4",""]],"verses":[["وَإِلى مَتى عُودي عَلى أَيديهِمُ","مُلقىً يُنَيَّبُ دائِباً وَيُحَرَّقُ",0,"ق",1,0],["وَإِلى مَتى أَبكي وَتَضحَكُ لاهياً","عَنّي وَأُدني في الهَوى وَتُباعِدُ",1,"د",1,0],["وَإِلى مَتى أَنا هاتِفٌ بِكَ في دُجّىً","أَبكي إِلَيكَ وَأَشتَكي وَأُناشِدُ",1,"د",1,0],["وإلى متى هو ساتر","وجه الحقيقة في ضَبابه",2,"ب",2,0],["واليمن تابع قصده","والجود طيُّ بنانه",3,"ن",2,0],["وإلى مَن يُذْعَر العا","رمُ منه والعُرامُ",4,"م",1,0],["وإلى مَن منه يُخشى","وإليه يُستنامُ",4,"م",1,0],["وإلى مُن يُؤثرُ الحقْ","قَ إذا اشتدَّ الخصامُ",4,"م",1,0],["وَإِلى مَعشَرِ الكَسالى قُصوراً","مِن لُجَينٍ وَعَسجَدٍ في السَحابِ",5,"ب",1,0],["وَإِلى مَن يَسُبُّني في غِيابي","شَرَفاً كَي يَصونُهُ مِن سِبابي",5,"ب",2,0],["واليمُّ لا يَرْثِي لمَنْ طمَّهُ","والسَّيْلُ لا يبكي لنَوْحِ الهَشِيمْ",6,"م",1,0],["وَاليَماني الَّذي لَوِ اِسطَعتُ كانَت","مُقلَتي غِمدَهُ مِنَ الإِعزازِ",7,"ز",1,0],["وَإِلى مَدىً سَبَقَت جِيادُ ذَوي التُقى","فَأَصَبنَ فيهِ مِنَ الحَياءِ رَبيعا",8,"ع",2,0],["وَإِلى مَدىً تَجري وَتِلكَ هِيَ الَّتي","لا تُستَقالُ إِذا بَلَغتَ مَداكا",9,"ك",2,0],["وَإِلى مَتى أَنا مُمسِكٌ","بُخلاً بِما مَلَكَت يَميني",10,"ن",2,0],["وَإِلى مَن رَغِبَ النا","سُ إِلَيهِ أَكبَروهُ",11,"و",2,0],["وَإِلى مُحَمَّدٍ اِبتَعَثتُ قَصائِدي","وَرَفَعتُ لِلمُستَنشِدينَ لِوائي",12,"ا",2,0],["وَاليَمُّ رَهوٌ إِذ رَآكَ كَأَنَّهُ","قَد قَيَّدتَهُ دَهشَةٌ وَحَياءُ",13,"ا",2,0],["وإلى متى زعماءُ قوْ","مِكَ يخلبونك بالكياسه",14,"ه",1,0],["وإلى مدى التحليق يرفعه هوى","وهوى يخوض به مدى الاسفاف",15,"ف",1,0],["وإلى من أشتكي الحبّ إلى","من إلى من ؟ إنّني وحدي غريب ؟",16,"ب",1,0],["واليمُّ رهوٌ إذا رآك كأنّهُ","قد قيّدتْهُ دهشَة ٌ وحياء",17,"ا",2,0],["وَإِلى مَن عَهدتَ في الحَزم وَالعزْ","مِ وَنَقضِ الأُمورِ وَالإِبرامِ",18,"م",1,0],["وَإِلى مكّة للبيتِ اِنثنى","ذا اِبتِهاجٍ قبل إشراق الصباح",19,"ح",1,0],["والى ميادين النوال تسابقت","او ما تراه قد حوى قصباتها",20,"ت",3,0],["وَإلى متى ذا الصَدُّ عن مَضنى الهَوى","عودي لِيورِقَ بِالتَواصُل عودي",21,"د",2,0],["وَاليُمْنُ وَالإِقْبالُ فِي","لَفْظِ الثَّنَاءِ عليهِ مُغْمَدْ",22,"د",1,0],["وَأَليم هجركَ ما يَراكَ مواصِلي","وَلَذيذُ وَصلِكَ ما اليه وصول",23,"ل",1,0],["وَإِلى مَن نَوى وَناوى اِعتِداء","لِذَويهِ فَاِنصِب وَحامي وَناصِبِ",24,"ب",1,0],["وَاليُمنُ بادِرِ بِالبُشرى يُؤَرِّخُهُ","هِلالَ ذي العَهدِ في بُرجِ الكَمالِ زَها",25,"ه",2,0],["واليُمنُ أَجمَعُ موصولٌ بيُمْناهُ","واليُسرُ أَجمَعُ مأمولٌ بيُسْراه",26,"ا",2,0],["واليُمنُ واليُسرُ طَريقاهُما","للخَلْقِ يُمْناه ويُسْراه",27,"ا",2,0],["وَاليُمنُ مِن عَن يَميني غَيرُ مُنقَطِعٍ","وَاليُسرُ مِن عَن يساري غَيرُ مَصدودِ",28,"د",1,0],["وإلى مَنِ اليومَ المُناخُ لوافدٍ","إلاّ الرِّضا بعدَ الإمام الهادي",29,"د",2,0],["وإلى مَن وقَد استَو","سَقَ مِنه الثَّقلانِ",30,"ن",1,0],["وإلى متَى أصبو إلى ريح الصِّبا","ومُهِيجُ نار جوايَ تِلك الريحُ",31,"ح",1,0],["وإلى مَتى تَزدادُ مِن مُقَلِ الظِّبا","وخدودِهنّ تَدَلُّهاً وتَحيُّرا",32,"ر",2,0],["وإلى مكة شدوا رحلهم","بلدة لا نختلي منها خلاها",33,"ا",3,0],["وإلى متى شغل الفؤاد بفكره","في قول كل محقق سبَّاق",34,"ق",1,0],["وإلى متى لهب الفؤا","د بهجره يقوى وقوده",35,"د",2,0],["والى معاليكُم إشارةُ خُرْسِه","والى أياديكُم ثناء فِصاحه",36,"ح",2,0],["واليمّ طاغ مطلق في نفسه","ما قيّدت يده قيود دساتر",37,"ر",1,0],["وإلى مَ نَدبي للديارِ كأنّه","فرضٌ عليّ أخافُ فَوْتَ أدائِهِ",38,"ا",3,0],["وَإلى متى يَسْعى الزّمانُ لَنَقْضِ ما","أَسْعَى بِكُلِّ الجَهْدِ في إبْرامهِ",39,"م",2,0],["واليمن حف به من كل ناحية","والنصر بالملك والبشرى يحيطان",40,"ن",1,0],["واليمن أشرق من جبينك نوره","ولأنت مشرق كل يمن للملا",41,"ل",2,0],["وإلى مُحَمَّدَ سَيفِ آلِ مُحَمَّدٍ","راحَت تَقيسُ الأرضَ بُوعاً بُوعا",42,"ع",2,0],["وَإلَى مَن ألتَجيء إن أَشتكَي","صَفقَةَ الغُبنِ وَزَلاَّتِ الغَبَن",43,"ن",1,0],["وَإِلى مَصرَ قادَهُ في حِبال ال","ذلِّ مِن بعد عزِّه وَهَناه",44,"ا",2,0],["وَإِلى مَصر عادَ وَهوَ","بَعدَ عز كانَ رداه",44,"ا",2,0],["وَإِلى مَصر جاءَ يَسعى بِنُور","فَوق نُور وَزاد بِالعَود أَمنا",45,"ن",2,0],["وَإِلى مَصر أَنتَ أَهديت خصباً","كُل يَوم يَزداد فيها بِجَد",46,"د",1,0],["وإلى من تسير مصر بخير","وإلى من تسير مصر بشر",47,"ر",1,0],["وإلى من أشكو وقد مات من كن","تُ أنادي فكان خير مُلَبِّ",48,"ب",1,0],["واليمُّ زاهٍ قد هدا تيارُهُ","مِن بعدِ طُولِ تقلُّقٍ وتموُّجِ",49,"ج",1,0],["وإلى من تُهْدَى البلاغةُ والشع","رُ وعلمُ الممدودِ والمقصور",50,"ر",1,0],["وَاليُمْن يَلزَمُها وَالنّصرُ يَعضُدها","وَالعَدلُ يَحفَظُها في الدّهرِ من رِيَبِ",51,"ب",1,0],["وَاليُمن وافى بَشيراً طابَ مَنظَرُهُ","وَالسَّعدُ يَتلوهُ نجّاباً على الأثرِ",52,"ر",1,0],["وإلى من إن قلت فيه بعيب","لم أحط في مقالتي بالصواب",53,"ب",1,0],["وإلى محاسن شعره","قد سلم الحسن المقالد",54,"د",1,0],["وإلى مشائخ جلّة عرفت لهم","بين الأنام إغاثة اللّهفان",55,"ن",1,0],["وَإِلى مَتى الغيبات عن وطنٍ وعن","أَهلٍ إليكَ بهم غليل موامُ",56,"م",1,0],["وَاليمنُ أَرّخه يُنادي بِالصَفا","بُشرى لِمَن وافى مَقامَ مُحَمَّدِ",57,"د",1,0],["وإِلى مَجْدِكَ يُعزَى","كلُّ إِحسانٍ وحُسْنى",58,"ن",2,0],["والى مَ تكتم لوعة","شهدت عليك بها المظاهر",59,"ر",1,0],["وإلى مظهر الشهود انتهى بي","واردي فالهدى إذا ميقاتي",60,"ت",2,0],["واليمن والايمان والاحسان","والعرفان وكن لي منجدا",61,"د",2,0],["وَإِلى مَجدِكَ يَنمى","كُلُّ مَجدٍ وَيَحورُ",62,"ر",1,0],["والى متى تلقي بنا العذال في","حرب ولا حرب البسوس عوان",63,"ن",1,0],["والى متى ينسيك سحر عواذلي","قربي بكل وسائل النسيان",63,"ن",1,0],["والى متى القاك مثل الطفل في","راحاتهم يا احسن الشبان",63,"ن",1,0],["والى متى هذا الغموض ومن ترى","يطرح الغبار بطرفك الوسنان",63,"ن",1,0],["وإلى منكبٍ عليه استقلّت","قبةُ الدين لا به الدين ريعا",64,"ع",2,0],["وَإِلى معارفه الجسام","علا به وَإِلى الحكم",65,"م",1,0],["وَالْيَمَانِينَ فَلاَ يَجْعَلْ بِهِمْ","فَهُمُ مِنْ شَرّ مَنْ فَوْقَ الْغُبَرْ",66,"ر",1,0],["وإلى متى أدَعُ الزمانَ وشأنَهُ","هيهاتِ حتى أبْلُغَ ابنَ الحضرمي",67,"م",2,0],["واليم ضرب باليدى والصي","على المحيا او على الصلباء",68,"ا",2,0],["وإلى مسرح المكارم قابو","س أراح الندى سوام العقول",69,"ل",1,0],["واليمن خط لمن يرافق جيشه","والفتحُ مرسومٌ على أعلامه",70,"م",2,0],["وإلى م تغضي والطغاة تحكمت","في المسلمين وحكمت أشرارها",71,"ر",3,0],["والى مدى خمسين ميلاً ما اكتفوا","بالزحف بل صاح الجميع الى الاما",72,"م",2,0],["واليمن انشد في دمشق مؤرخاً","وُلدت بها عربيةُ الاقبالِ",73,"ل",1,0],["واليمانون يفخرون أما يد","رون أن النبي غير يمان",74,"ن",1,0],["وإلى متى يبقى الفؤاد معذبا","لم ينسها آناً ولا يسلاها",75,"ا",3,0],["والي من ذنب اليه علمته","سوى أنني قد جئته غير صائم",76,"م",1,0],["وإلى موزع تُحدي أينقى","وإلى ذاك الربيع الخَضلِ",77,"ل",1,0],["واليمن وافى ملقياً لك قوده","بكتائب منصورة وجنود",78,"د",1,0],["وَإِلى مَ وُلاتك كُلّ دَعيّ","أَسلم لِلعادي رَسَنه",79,"ه",1,0],["واليمن والتوفيق حلا","فيه والفال الحميد",80,"د",1,0],["واليم لا يعرف ما طعمه","إلا الذي وافى لأن يَشرَبا",81,"ب",2,0],["وإلى مالقة يهفو هوىً","قلب صبّ بالنوى لا يقلَبُ",82,"ب",1,0],["واليمن وافى للانام وقد بدا","في موكب البشرى رفيع لوائه",83,"ا",3,0],["واليمن فيه قد استهل مؤرخا","عيدا بتوفيق العزيز تجملا",84,"ل",2,0],["وإلى مساعى الخير نفسك لم تزل","تصبو ومنها للأنام تزيد",85,"د",1,0],["واليمن قد حياك فيه مؤرخا","بعلى مجدك راق هذا العيد",86,"د",1,0],["وَإِلى مَقامِكَ كُلَّ حينٍ عاطِراً","أُزجيهِ في الإصباحِ وَالإمساءِ",87,"ا",2,0],["وإلى مَقامِكُمو أقدِّمُهُ عَلى","أَملي بِأن ترعَاهُ مِنكَ يَدَانِ",88,"ن",1,0],["واليمين التي سمعت صداها","لتخرّ الرؤوس للأذقان",89,"ن",1,0],["وإلى مرفقي يديك فأسبغ","غسل أيد وامسح برأس أعالي",90,"ل",2,0],["وإلى مكان الاعتدال بنقطة","ولمغرب مقيوسة بالنقطة",91,"ه",1,0],["وإلى م تبقى والعدو بجنبها","يمسي قريراً وهي تقرع نابها",92,"ب",3,0],["وإلى متغضي والحسين وصحبه","ورضيعه أضحى النجيع شرابها",92,"ب",3,0],["واليمن لاح به يقول مؤرخاً","عيد بثروته يعود وهبي",93,"ي",1,0],["وإلى م تنفث موقد الزفرات عن","جمر بأخبية الحشى مكمون",94,"ن",1,0],["وإلى متى طي اللواء وهذه","أعداؤكم منشورةٌ أعلامها",95,"م",3,0],["وإلى متى في الغمد سيفك والعدى","لنحور آلك منتضى صمصامها",95,"م",3,0],["وإلى متى فطم الأسنة والعدى","فطمت رضيع ابن البتول سهامها",95,"م",3,0],["والى مَ أَسترضِي وتَزأَرُ ثائراً","وإلى مَ أُخمِدُ ما تُ