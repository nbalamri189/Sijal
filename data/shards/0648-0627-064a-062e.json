{"poems":[[55,"لأمر يا بني جشم","https://www.aldiwan.net/poem29770.html","مجزوء الوافر"],[73,"حوى قصب السبق أهل العراق","https://www.aldiwan.net/poem3910.html","المتقارب"],[47,"لتصدقني وما أخشاك تكذبني","https://www.aldiwan.net/poem65543.html","البسيط"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[47,"لِتَصْدُقَنِّي، وَمَا أخشاكَ تَكذِبُني","https://www.poetsgate.com/ViewPoem.aspx?id=32137",""],[147,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[303,"رمت ولم ترم غير العلم والعمل","https://www.aldiwan.net/poem36258.html","عموديه"],[376,"أبثك ما بي وماذا عسى","https://www.aldiwan.net/poem57024.html","المتقارب"],[376,"من كل جفن بين عيني بين","https://www.aldiwan.net/poem57094.html","السريع"],[385,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[458,"ولي منزل لقنته سر عزلتي","https://www.aldiwan.net/poem61264.html","الطويل"],[463,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[520,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[556,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[556,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83344","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122561","السريع"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82283","السريع"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76920","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137448",""],[2937,"","https://poetry.dctabudhabi.ae/diwan/poem/140177","المنسرح"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82839","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126960","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45858","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139542",""],[5050,"لشغلي بأهل الدهر إحدى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=38188",""],[5145,"توسّمت رسم الدار من أمّ حارث","https://www.poetsgate.com/ViewPoem.aspx?id=108054",""],[243,"مقطع بلا عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=50483",""]],"verses":[["وَأَيُّ خَميلَةٍ شَرَقَت","عَلى الأَيّامِ مِن شِيَمي",0,"م",2,0],["وَأَيُّ خَطيبٍ يُجاريهِمُ","وَقَد خَطَبَت فيهِمُ الأَجدِيَه",1,"ه",1,0],["وَأَيُّ خَيرٍ يُرَجّى عِندَ مومِسَةٍ","زَلّاءَ مِن دُبُرٍ وَقباءَ مِن قُبُلِ",2,"ل",1,0],["وأيُ خيرٍ بلا شرٍّ يُلَقِّحه","طهرُ الملائك منْ رجس الشياطين",3,"ن",1,0],["وأَيُّ خَيْرٍ يُورجَّى عِنْدَ مُومِسةٍ","زَلاَّءَ مِنْ دُبُرٍ ºوقْبَاءَ مِن قُبُلِ",4,"ل",1,0],["وَأَيُّ خِلالِ المَجدِ ما مَلَّكَتكَهُ","وَإِن رَغِمَ الحُسّادُ هِمَّتُكَ البِكرُ",5,"ر",1,0],["وَأي خطبٍ دهانا يومَ مصرعِهِ","فحسبنا اللهُ في ذا الحادثِ الجلل",6,"ل",1,0],["وأيُّ خِصالِ المَعالي سَمعت","بها فالتَمِس فعليَّ الضَّمانُ",7,"ن",1,0],["وأيُّ خُلفٍ بَينَنا بعدَ ما","وافقَ صَوبُ الغَيثِ صَوب اليَدَين",8,"ن",1,0],["وَأَيَّ خَصلة مِنهُ","إِلَيها القَلب لَم يَمل",9,"ل",1,0],["وأيّ خفاء نستطيع وهذه","حليك تعلو في الهواء نثارا",10,"ر",2,0],["وأيّ خلالهِ كرماً سقاه","كَفَى وسقَى نميرٌ منه عِدُّ",11,"د",1,0],["وأي خطوب الدهر جلت فلم يكن","على فارس الإسلام فيها المعول",12,"ل",1,0],["وأيُّ خطبٍ مُعضِلٍ","ضرّم ناراً فاِضطرمْ",13,"م",1,0],["وأيُّ خرقٍ عَبَقَ الجود به","لم يُسألِ المعروفَ يوماً فبذَلْ",14,"ل",1,0],["وَأَيُّ خَطبٍ مَلّى أَن أَقولَ لَهُ","يا عُمري اِنفَضَّ أَو يا مُهجَتي ذوبي",15,"ب",2,0],["وأيُّ خصمٍ لك أو حاسدٍ","ما ناطحَ الطودَ برأسٍ زجاج",16,"ج",1,0],["وَأَيُّ خِزيٍ هُوَ أَخزى مِن أَن","يُقالَ لي يا سِبَّ بَشّارِ",17,"ر",1,0],["وأى خلّ من الخلان سامحني","بقربه الدهر لم يرحل وَلم يبِنِ",18,"ن",1,0],["وَأَي خَيل ضَلال بِالطفوف عَدت","عَلى حَريم رَسول اللَه فَاِنتَهكا",19,"ك",2,0],["وأي خير يرجى في الزمان وقد","ساروا وتابعهم في السير نعمان",20,"ن",1,0],["وأيّ خير يأتيك من رجلٍ","ليس لأنثى يُدْعى ولا ذكرِ",21,"ر",1,0],["وَأَيُّ خِلِّ وَفاءٍ لَيسَ يُؤنِسُني","كَما يُؤانِسُني مُستَحسَنُ الكُتبِ",22,"ب",1,0],["واي خليل بعد نأي خليله","لأحشائه نار الجوى ليس تلفح",23,"ح",1,0],["وَأي خَير نَراه في مَحبَتَكُم","وَقَد لَبَستُم مِن العُدوان إِكليلا",24,"ل",2,0],["وأي خسارٍ قد حملنا ببرقةٍ","وأي خميسٍ في مدارجها سقنا",25,"ن",2,0],["وأيُّ خطبٍ ليثُ أرزائه","أنشب في قلب الهدى مخلبا",26,"ب",2,0],["وأي خصال إن تحلى بها الفتى","تميز فيها عن ذوات الجلابب",27,"ب",1,0],["وأيّ خلال المجد لم يحو سربها","ببرد التأنّي أو بحرّ الحثاحث",28,"ث",1,0],["وأي خير في الهوى كله","إن كنتما بالحب لا تعلمان",29,"ن",1,1]]}