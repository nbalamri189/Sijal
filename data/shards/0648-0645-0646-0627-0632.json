{"poems":[[55,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[65,"النجم يبعد مرمى طرفه الساجي","https://www.aldiwan.net/poem46197.html","البسيط"],[73,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[32,"أفي كل يوم أنت من غبر الهوى","https://www.aldiwan.net/poem29480.html","الطويل"],[29,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[74,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[74,"حمدت دموعي إذ وفت بوعودها","https://www.aldiwan.net/poem18562.html","الكامل"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[93,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[45,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[63,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[46,"الزنج أكرم منكم والروم","https://www.aldiwan.net/poem30003.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[315,"هذي الديار فحيهن صباحا","https://www.aldiwan.net/poem59513.html","الكامل"],[356,"قد تم ما حملتني من آلة","https://www.aldiwan.net/poem68963.html","الكامل"],[369,"ومنازعي في أول اسمك","https://www.aldiwan.net/poem60984.html","مجزوء الكامل"],[376,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[580,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56215","المتدارك"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55940","الكامل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29668","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93136","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78016","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109005","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108634","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127987","الكامل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119200","الكامل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69479","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106865","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100332","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122484","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104341","البسيط"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143479","الكامل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204075","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21553","الكامل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106736","الكامل"],[5183,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186473",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5242,"هجر وشجن","https://www.poetsgate.com/ViewPoem.aspx?id=125967",""],[5376,"سكنت فؤادي في الضلوع وأودعت","https://www.poetsgate.com/ViewPoem.aspx?id=197588",""],[5490,"من أغضب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176263",""],[5561,"على قارعة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=195028",""]],"verses":[["وَمَنازِلٍ سَطَرَ الزَما","نُ عَلى مَعالِمِها الحُؤولا",0,"ل",2,0],["ومَنْ أزارَكَ للعَلْياءِ هِمَّتَهُ","فلَيْسَ يَرضى بمُزْجاةٍ منَ الحاجِ",1,"ج",1,0],["وَمَنازِلاً بَينَ البِقاعِ وَراهِطٍ","أَكرم بِها من أَربُعٍ وَبِقاعِ",2,"ع",1,0],["وَمِن أَزمَةٍ حَصّاءَ تَطرَحُ أَهلَها","عَلى مَلَقِيّاتٍ يَعبُرنَ بِالغُفرِ",3,"ر",1,0],["وَمِن أَزواجِ فاكِهَةٍ وَنَخلٍ","يَكونُ بِحَملِهِ طَلعٌ نَضيدُ",4,"د",1,0],["وَمُنازِلُ الهِرماسِ تَحتَ لِوائِهِ","فَحَشاهُ مُعتَدِلَ القَناةِ سَديدا",5,"د",2,0],["ومنازل بالسفح غُير رسمها","بمدامعِ العشاقِ والأنواء",6,"ا",2,0],["ومنازل ما بين كفِّك والغنى","يا مشتكي الإقتار غير ورودها",7,"د",3,0],["ومن ازْورَّ عنه يوماً هجونا","ه وكان النحيس عين النحيس",8,"س",1,0],["وَمَنازِلُ البُؤَساءِ أَولى بِالنَدى","وَلَأَنتِ أَولاها بِمالِ ذَويكِ",9,"ك",1,0],["وَمَنازِلُ الحُمّى الجُسومُ فَقُل لَنا","ما عُذرُها في تَركِها خَيراتِها",10,"ت",3,0],["ومنازل عبق المكارم مخبر","زوارها عنهم بقرب فراق",11,"ق",1,0],["وَمَنازِلٌ لَم يَبقَ فيها ساحَةٌ","إِلّا وَفيها سائِلٌ مَحرومُ",12,"م",1,0],["ومنازلٌ مشبوبةٌ وكأنها","للجنِّ في وادي اللظى أوكارُ",13,"ر",1,0],["ومنازل للظاعنين استعجمت","حزناً وكانت بالسرور فصاحا",14,"ح",2,0],["ومنازل القمر التي حجبت معاً","دون العيون بكل طالع حين",15,"ن",1,0],["ومُنازعي في أوّلِ اسْ","مِكَ والجوابُ عليكَ واجِبْ",16,"ب",1,1],["ومنازلٍ خلفَ المَها فيها المَها","حتَّى ظننتُ تَرحُّلاً تَعريسا",17,"س",2,0],["وَمَنَازِلٍ بِاللَّهو آهِلَةٍ","تُزْهَى بِهَا الآصَالُ والبُكَرُ",18,"ر",1,0],["ومنازل بيت الدين زهت","وتلألئ ذاك الديوانُ",19,"ن",1,0],["ومنازعٍ ومخادعٍ ومصارعٍ","ومقارعٍ ومسارعٍ في ضَرهِ",20,"ر",2,0],["وَمَنازِلُ العُظَماءِ مِنكُم أَصبَحَت","دُوراً لَهُم تُكرى بِلا أَثمانِ",21,"ن",1,0],["ومن أزال لوياً عن مراتبها","من بعدما طاولت في الشأو كيوانا",22,"ن",2,0],["ومنازل ما مثلهن منازل","وزيادة لا تنتهي وثواب",23,"ب",1,0],["ومنازل بدل الحِمام","حَمامها الغالي ببومه",24,"م",2,0],["ومنازلاً ما أغلقت أبوابها","إلّا لتدفع سائلاً متنكرا",25,"ر",2,0],["ومنا زيد المشهور باسم","من التنزيل بين العالمينا",26,"ن",2,0],["ومنازل الاقمار أفئدة الورى","وهناك هالات من الابصار",27,"ر",1,0],["ومنازلين إذا بدوا في شارق","شبوا ضياء وقوده بوقودِ",28,"د",1,1],["وَمَنازِلٍ لَكَ بالحِمى","وَبِها الخَليطُ نُزولُ",29,"ل",1,1],["ومنازعاً للنفس ضاربةً","أوتارها ما أغفلت وترا",30,"ر",2,0],["ومنازلٍ لسميذع","عبل الذراع سميذع",31,"ع",1,0],["ومنازِلُ العُربِ الكِرامِ مآتِمٌ","ودُعاءُ أُمَّةِ أحمَدٍ مَقبُولُ",32,"ل",1,0],["ومن أزال لوياً عن مراتبها","من بعدما جاوزت ف الشأو كيوانا",33,"ن",2,0],["ومنازل لك بالحمى","وعهود سعدى باللوى",34,"ا",1,0],["ومنازلاً قضيت بين خيامها","عيشاً كما يرضى التصابي طيبا",35,"ب",2,0],["ومنازل الظلمات ظاهرةً","تبدو يراها الجن والبشر",36,"ر",1,0],["وَمنازِلٍ للقَرن يسحَب فاضَةً","عَلَق النَجيعُ بِثَوبِها الفَضفاضِ",37,"ض",1,0],["وَمُنازِعي كَأسَ السُهادِ زَواهرٌ","أمَّ الذَميلُ بِها بَعيدَ مَغارِ",38,"ر",1,0],["ومنازل يأوي عليها مَارِق","فكأنما هي للضلال إهاب",39,"ب",1,0],["ومِن أَزمَةٍ صَوبَ أُخرَى يَسِيرُ","ولَيسَ يُرِى الشَّعبَ إِلَّا رُؤَاهْ",40,"ا",2,0],["ومنازلٌ جَرّرتُ في","أرجائها فضلَ الرسن",41,"ن",1,0],["ومنازل للأم لست أحيطها","وكأنها فلك من الآفاق",42,"ق",1,0],["ومنازلُ الإلهام فيك فسيحةٌ","والشِعر إذ أعليتَ منبرَه ارتقى",43,"ق",2,0],["ومِن أزلٍ تُحصِّنُهُ عهودٌ","ويغرَقُ مِن خطاياهُ اليقينُ",44,"ن",1,0]]}