{"poems":[[93,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[97,"عروس المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=745&r=&rc=23",""],[259,"ياعظيم الشأن","https://www.aldiwan.net/poem25013.html","مجزوء الرمل"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[505,"لي قلب في الحب مضنى عليل","https://www.aldiwan.net/poem37927.html","الخفيف"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112445","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199999",""],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138921",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67979","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110036","الخفيف"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136941",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72434","الطويل"],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[4869,"المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=151553",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5183,"رزء العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180254",""],[5431,"وجع الناي...","https://www.poetsgate.com/ViewPoem.aspx?id=202198",""],[5431,"رقصة النار ...","https://www.poetsgate.com/ViewPoem.aspx?id=204746",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5878,"أيها الليل","https://www.poetsgate.com/ViewPoem.aspx?id=199219",""],[5970,"ساحة الأرض ضيقت بي فهاتوا","https://www.poetsgate.com/ViewPoem.aspx?id=130613",""],[5976,"ذل السكوت","https://www.poetsgate.com/ViewPoem.aspx?id=33893",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""],[469,"لا ومن قصر الوصال ومن صي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574791",""],[6237,"لكل صابونة ليفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77876&r=&rc=18",""],[463,"يا لنوازي كبدٍ هاجها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60066&r=&rc=122",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["يا لَنَفسي فَإِنَّها فَتَنَتني","بِالحَديثِ المُنَمَّقِ الخَلّابِ",0,"ب",1,0],["يا لنفوس غاب عن","ها الرشد فَهي لا تَعي",1,"ع",2,0],["يا لنعمى خفَّ في أظلالها","ما حملنا في ركابِ الحقبِ",2,"ب",1,0],["يالَنَفْسي كيف حالي","إن دعاني الرَّبُّ يوما",3,"م",2,0],["يا لنفس كريمة عصمته","من ضلال الخلائق السافلات",4,"ت",1,0],["يا لنيلٍ أجراه في شعره الخا","لد حرّ الضفاف والموجات",4,"ت",1,0],["يا لنيل الخلود تحرمه","مصر وتهريقه يد الأجنبي",5,"ي",1,0],["يا لنجدٍ وابن منّي نجدٌ","بعدتْ شقةً وشطّت مقاما",6,"م",2,0],["يا لِناري حُزني عليكُمْ طَويلُ","يا لِسَقمي صَبري عليكُمْ جَميلُ",7,"ل",1,0],["يا لنا أمة تلقفها الاع","داء رفساً والأقربون بنحس",8,"س",1,0],["يا لنصح قد ضاع في نفر","كبروا حيث عقلهم صغرا",9,"ر",2,1],["يا لنفس طارت عليهم شعاعا","يوم شدت للبين منها القتود",10,"د",1,0],["يَا لَنفسٍ لَمْ تَجِدها طَمَحت","إن نفسَ الحرِّ لفحشاءِ كَبْح",11,"ح",1,0],["يا لنفسٍ تُحارِبُ اللَه عمداً","بخَطاءٍ كأَنَّهُ سهمُ قاتل",12,"ل",1,1],["يالنا من ثلاثةٍ يعجز الطا","لب عن رابعٍ لنا في البريه",13,"ي",2,0],["يا لنادٍ اظلُّه البشر حتى","خُلته للنعيم والزهو مرتع",14,"ع",1,0],["يا لِنَفسٍ تَعيشُ بَينَ مُيولٍ","أَتعَبَتها ما بَينَ رُشدٍ وَغيِّ",15,"ي",1,0],["يا لندب ردَّ الشريعة بكرا","فغدت شبة وكانت مسنه",16,"ن",2,0],["يالنّصوح افهمني نصْحك ماعنالي","وأعلم انّك ماخذه من تمثليّه",17,"ي",2,0],["يالنآيم إليا قمت سد القسآيم","وألا اقول انك ب هالحُب كآفر",18,"ر",1,0],["يا لنشوان يقطع العمر سكرا","كأسه الزهر , والطلى انداء",19,"ا",2,0],["يا لنعي فتت الأكباد من","عالم الأرض وأمسى مُدلجا",20,"ج",2,0],["يالنايٍ يُرقّصُ الروح حزنا","تشتهي الروح سعده لو يُغنّي!",21,"ن",2,0],["يالنارٍ ومركزُ الوجد برْدٌ","ويقين بأنّه (ال)..كيف يُكسر؟!!!",22,"ر",1,0],["يا لنوقي حمّلتْ أوزارها","فوق صدري مذ تنحّتْ مشرقا",23,"ق",2,0],["يالنادر اللي من قنص فيك ما خاب","خطك طويل الياهبا كل هايب",24,"ب",1,0],["يَالَنَفسِي فَمَا لَهَا مِن مُجيرٍ","حِينَ يَغفُو بِمُقلَتَيهَا البُكَاءُ",25,"ا",2,0],["يا لنفسي ويا لطول عنائي","في حياتي ويا لطول شقائي",26,"ا",2,0],["يالنايم اللي ما صحى من سباته","في غفوتك تتراكم ذنوبك اكوام",27,"م",1,0],["يالنصيب اسمعني لوتسمح تعال","يكفي انك خذت مني ماخذيت",28,"ت",1,1],["يا لنجدٍ وأينَ منيَ نجدٌ","بَعُدَتْ شُقَّةً وشطَّت مقاما",29,"م",2,0],["يا لنفسي من أنفسٍ تقذف الحبر","عداءً على الثياب النظيفةْ",30,"ف",2,0],["يا لنوازي كبدٍ هاجها","بالبان من خنساءَ تذكارُ",31,"ر",1,1],["يا لَنُعْمَى الإِنسَانِ يَحْمِلُ مِنْهُ","مِشْعَلاً شَقَّ مِنْ لَيَالٍ سُوْدِ",32,"د",1,0],["يا لَنَفْح الإِيمان يَنْشُرُ طِيباً","مِنْ فَعَالٍ ورَفّةً مِنْ بَيَانِ",33,"ن",1,0],["يا لَنُورٍ يَشُقُّ مِنْ ظُلْمةِ اللّيْ","لِ وَيَسْري بَينَ الضُلُوع الحَوَانَي",33,"ن",2,0]]}