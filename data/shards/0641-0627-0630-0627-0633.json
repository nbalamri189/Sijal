oetry.dctabudhabi.ae/diwan/poem/117232","الكامل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/100705","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120475","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120435","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52176","الكامل"],[4691,"( جفاف الغدير)","https://www.poetsgate.com/ViewPoem.aspx?id=61628",""],[4898,"إنّا هُنا !","https://www.poetsgate.com/ViewPoem.aspx?id=35811",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5074,"شوق واعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=153919",""],[5121,"شَاعِر","https://www.poetsgate.com/ViewPoem.aspx?id=213481",""],[5273,"تعزية","https://www.poetsgate.com/ViewPoem.aspx?id=181761",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5376,"في الليلة الظلماء ساد نواح","https://www.poetsgate.com/ViewPoem.aspx?id=194862",""],[5413,"هو كل حب","https://www.poetsgate.com/ViewPoem.aspx?id=200566",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203238",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203466",""],[5616,"حماس","https://www.poetsgate.com/ViewPoem.aspx?id=205248",""],[5725,"وأْد الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=197222",""],[402,"قد قام عرشك في أعز مكان","https://www.poetsgate.com/ViewPoem.aspx?id=36471",""],[5845,"ألسيعُ صلِّ مالهُ منْ راقِ","https://www.poetsgate.com/ViewPoem.aspx?id=16699",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[5937,"الكَمَانيّة","https://www.poetsgate.com/ViewPoem.aspx?id=211898",""],[5944,"نُصحٌ.","https://www.poetsgate.com/ViewPoem.aspx?id=213888",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""],[5977,"الحب العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=213129",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""],[6093,"الشَّيْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=178325",""],[6102,"حل الأحجية","https://www.poetsgate.com/ViewPoem.aspx?id=183655",""]],"verses":[["فَإِذا سَلِمتَ مِنَ النَوائِبِ أَصبَحَت","تَرضى وَنَرضى أَن يَكونَ فِداءَ",0,"ا",2,0],["فَإِذا سَمِعتَ بِأَنَّ مَجدوداً حَوى","عُوداً فَأَثمَرَ في يَدَيهِ فَصَدِّقِ",1,"ق",1,1],["فإذا سألْتَ فَلا تُسائِلْ مُخْبِراً","وإذا سمِعْتَ فلا تُحِسّ حَسيسا",2,"س",2,0],["فَإذا سَمَوتُ لِقَصدِهِم لم أستَطِع","وإذا اعْتَذَرْتُ إِلَيْهِمُ لَمْ يَقْبَلُوا",3,"ل",3,0],["فَإِذَا سَمَوْتَ إِلَى مَرَامٍ شَاسِعٍ","فَغُصُونُهُ ثَمَرَ الْمُنَى تَجْنِيكَا",4,"ك",2,0],["فإذا سَلَكْتَ طريقَها متصَوِّفاً","فابْنِ السّلوكَ بِها على التّجْريدِ",5,"د",1,0],["فَإِذا سَمِعتَ سَمِعتَ أَمراً مُنكَراً","وَإِذا رَأَيتَ رَأَيتَ لا إِنسانُ",6,"ن",1,0],["فَإِذَا سَمَوْتَ إِلَى الذُّرَى تَرْنُو إِلَى","مَا دُونَهَا مِنْ مرْتَمَى العِقْيَانِ",7,"ن",1,0],["فَإِذا سَكَّنتُ رَوعَتَهُ","وَرَعى في مُقلَتَيهِ فَمي",8,"م",2,0],["فإذا سألت الكتب نقل فضيلةٍ","لَمْ تُلْفِ إلاّ فخرها منقولا",9,"ل",2,0],["فَإِذا سَمِعتَ بِحَربِ قَيسٍ بَعدَها","فَضَعوا السِلاحَ وَكَفِّروا تَكفيرا",10,"ر",2,0],["فإذا سخا ملأَ الديارَ عوارِفاً","وإذا غزا ملأَ القفارَ كتائِبا",11,"ب",2,0],["فإذا ساح في المريءِ وفي البط","نِ وولّتْ حياتُهُ للذهابِ",12,"ب",1,0],["فَإِذا سَكَتَّ فَأَنتَ لَحنٌ طائِرٌ","وَإِذا نَطَقتَ فَأَنتَ غَيرُ مُقَلِّدِ",13,"د",1,0],["فَإِذا سَمِعتَ بِعاشِقٍ","فَاِسأَل دَوامَ العافِيَه",14,"ي",2,0],["فَإِذا سَأَلتَ سَألتَ مِنهُ حاتِماً","وَإِذا لَقَيتَ لَقَيتَ مِنهُ عَنتَرا",15,"ر",2,0],["فإذا سرَّني من الفجرِ نورٌ","ساءَني مَا يُسِرُّ قلبُ الظَّلاَمِ",16,"م",1,0],["فإذا سَكَتُّ تضجَّروا وإذا نَطَقْتُ","تذمَّروا من فكْرَتي وشُعوري",17,"ر",2,0],["فاذا سكت اذاب مهجتي الاسى","واذا شكوت فليس لي من يسمع",18,"ع",1,0],["فَإِذا سَخَوتَ بَلَغتَ بِالجودِ المَدى","وَفَعَلتَ ما لا تَفعَلُ الأَنواءُ",19,"ا",2,0],["فَإِذا سَقَطتَ عَلى حَديدٍ مُضرَمٍ","صَدَفَ الحَديدُ وَلَم تَنَلكَ النارُ",20,"ر",1,0],["فَإِذا سُئِلتَ فَلا لِأَنَّكَ مُحوِجٌ","وَإِذا كُتِمتَ وَشَت بِكَ الآلاءُ",21,"ا",2,0],["فَإِذا سابَقَ الجِيادَ إِلى المَج","دِ فَما البَرقُ خَلفَهُ بِسَريعِ",22,"ع",1,0],["فَإِذا سَخا ذَلَّ النُضارُ بِكَفِّهِ","كَرَماً وَعَزَّ لَهُ الغَداةَ نَظيرُ",23,"ر",1,0],["فَإِذا سَطا مَلَأَ القُلوبَ مَهابَةً","وَإِذا سَخا مَلَأَ العُيونَ مَواهِبا",24,"ب",2,0],["فَإِذا سِرتُ أَحسَبُ الأَرضَ مِلكي","وَجَميعَ الأَقطارِ طَوعَ قِيادي",25,"د",2,0],["فإذا سمحت دفعت فيه دماءها","ورجعتُ أحمدُ من ذراكَ مآبي",26,"ب",2,0],["فَإِذَا سَأَلْتَ الدَّهْرَ مَعْرِفَةً بِهِ","فَاسْأَلْ لِتَعْرِفَهُ النَّعَامَ الْجَافِلا",27,"ل",2,0],["فَإِذا سَعَوا جَرَتِ الحَوادِثُ طَوعَهُم","وَإِذا مَشوا وَقفَ القَضاءُ الجاري",28,"ر",2,0],["فَإِذا سارَ دُكَّتِ الأَرضُ دَكّاً","بَعدَ إِذ رامَها بِذَيلِ عَسيبِ",29,"ب",1,0],["فإذَا سَقَطْتَ عَلَى الخَبير بِدَائها","فَاصْبِرْ لِمُرِّ دَوَائِهِ وَتَجَلَّدِ",30,"د",1,0],["فإذا سَطَّرَ الكتابَ أَرانا","بَحْرَ فضلٍ أمواجُهُ مِنْ سُطورِ",31,"ر",1,0],["فإذا سمِعتَ على البِعادِ زَئِيرَهُ","فاذهَبْ فقد طَرَقَ الهِزَبْرُ الباسل",32,"ل",1,0],["فإذا سَعَيْتُ إلى العُلى لم أتّئِدْ","وإذا اشترَيْتُ الحمدَ لم أسترْخصِ",33,"ص",1,0],["فإذا سَمعتَ بذِكرِ سُودَدِهَا","ليلاً أتاكَ الفجرُ يَنفجر",34,"ر",1,0],["فَإِذا سَمِعتِ بَمَيِّتٍ حَزَناً","بَكَرَ الحِمامُ بِهِ وَلَم يَسرِ",35,"ر",1,0],["فإذا سألتَهُمُ مَواليَ مَن هُمُ","قالوا مواليَ كلِّ ليلٍ داجِ",36,"ج",1,0],["فَإِذا سِرتُ في الطَريقِ نَهاراً","خِلتُ أَنّي عَلى المَرايا أَسيرُ",37,"ر",1,0],["فَإِذَا سَمَوْتَ بِهِ تَقَلَّدَ أَنْجُماً","وَإِذَا دَنَوْتَ بِهِ اكْتَسَى بِغُبَارِ",38,"ر",1,0],["فإذا سمعت بعاشقين فقل هما","ملكان متصلان منفصلان",39,"ن",1,0],["فإذا سهمُهن في الجو أمضى","من سهام العيون والأجفان",40,"ن",1,0],["فإذا سلكت طريقها متصوفا","فابن السلوك فيها على التجريد",41,"د",1,0],["فَإذا سَقَطْتُ سَقَطْتُ أَحْمِلُ عِزَّتي","يَغْلي دَمُ الأَحْرارِ في شِرياني",42,"ن",2,0],["فَإِذا سَكَنت سَكَنت بَح","راً لَو وَثَبت وَثَبت فهدا",43,"د",2,0],["فإذا سخَوتُ فإن سيبكَ عارضٌ","وإذا سطَوتَ فإنَّ سيفَك عارِمُ",44,"م",1,0],["فإذا سخا ما حاتم في جوده","واذا سطا في الروع ما بسطام",45,"م",1,0],["فَإِذا سِرتَ من دِيارٍ لأخرى","حَسَدت أَرضَها عَليك السَماءُ",46,"ا",2,0],["فَإِذَا سَكِرْتُ صَحَوْتُ مِنْ طَرَبِي بِهَا","وَإِذَا صَحَوْتُ سَكِرْتُ مِنْ ذِكْرَاهَا",47,"ا",3,0],["فإذا سطا لم تلق إلا باسلا","ملأ القلوب مهابة وجلالا",48,"ل",2,0],["فإذا سمعتُ حديثَهُنَّ عشيَّةً","خلتُ الحديثَ تغرُّداً وخَريرا",49,"ر",2,0],["فإذا سُئلتِ عن الذينَ تساقَطوا","صَرعى فدى وَطنٍ لهم ولِواء",50,"ا",2,0],["فاذا سمعت فاحمد وَمُحَمَّد","وَإِذا كنتي فَقاسِم الارزاق",51,"ق",1,0],["فَإِذا سَلِمتَ لَنا فَكُلٌّ سالِمٌ","وَبِبُرءِ رِجلِكِ نُظهِرُ التَعييدا",52,"د",2,0],["فإذا سمعت سؤالها","وعجزت عن ردّ الجواب",53,"ب",1,0],["فإذا سَخا مطَر الأكُفَّ مواهباً","وإذا سَطا مطَر الرِّقابَ نُصولا",54,"ل",2,0],["فَإِذا سَأَلتَ عَنِ الهَوى","فَاِسأَل بِهِ مِنهُم خَبيرا",55,"ر",2,0],["فإِذا سَلوتُكَ ساعَةً","رَجعَت مواكبُها إلَيَّا",56,"ي",2,0],["فإذا سَلَتْ عَنْها الكرامُ وأَصْبحتْ","عنها عواريّ فهيَ منك عواري",57,"ر",2,0],["فإذا سلِمتَ فلا تكُنْ لكَ هِمَّةٌ","إلا دوامَ سلامَةِ الأُلاّفِ",58,"ف",1,0],["فإذا سوّدت يداه كتاباً","فبياض العلى بذاك السواد",59,"د",1,0],["فإِذا سَطَا فَالسيفُ يَضْحَكُ غُرَّةً","وإِذا عفا فالمالُ ذو اسْتْعبارِ",60,"ر",1,0],["فإذا سمعتَ بقائلٍ سمعَ الحَيا","بنوالِه نبِّهْهُ عن غَفَلاتِه",61,"ت",2,0],["فإِذا سئلت عن المسائل لم تكن","ذا حيرة عن ردها لكاء",62,"ا",2,0],["فإذا سلمتَ عليه حيّاً مقبلاً","فأبوك تحتَ الترب مَيْتٌ مقبلُ",63,"ل",1,0],["فاذا سلمت فكلُّ بؤس نِعْمةٌ","واذا بقيتَ فكلُّ غُرْمِ مَغْنَمُ",64,"م",1,0],["فإذا سارٍ وَنى مِنْ نَصَبٍ","حَثَّهُ زاجِرُ سَوَّاقٍ حُطَمْ",65,"م",1,0],["فإذا سمحن بمن أودُّ أعضني","عن يوم وصلٍ منه عامَ صدود",66,"د",1,0],["فإذا سخا أو جاد بعد تمنع","فأظنه من راحتيه تعلما",67,"م",2,0],["فإذا سمعت حديث جودٍ وارداً","صحَّحتهُ فنما إليك معنعنا",68,"ن",2,0],["فإذا سَمِعْتَ مَقَالةً مُعْوَجَّةً","في شَأْنِ حُكْمٍ قَالَها مَنْ يَنْقُدُ",69,"د",1,0],["فإذا سَألتَه فَهوَ ذو إنكار","وإذا صَبَرتَ ولا إخالُكَ صابراً",70,"ر",2,0],["فإذا سألتُم وصفَه وبيانُه","وكماله فالفرعُ بالأصلِ اقتََدَى",71,"د",2,0],["فإذا سَرَوْا فَسَناهُ أشرقُ كوكبٍ","وإذا صَدَوْا فنداه أعذبُ منهلِ",72,"ل",1,0],["فَإِذا سَرحتَ الطّرف بينَ بيوتهم","لَم تَلق غيرَ مُغبَّطٍ محسودٍ",73,"د",1,0],["فَإِذا سألتَ فليس تس","ألُ غيرَ صُمٍّ صامتاتِ",74,"ت",1,0],["فإذا سلكت اُخىّ منهج حكمة","عند الزواج امنت كل عثار",75,"ر",1,0],["فإذا سَفُلتَ فَلا يُفيدُكَ مِن","شَيءٍ عُلُوُّ الخالِ والعَمِّ",76,"م",1,0],["فَإِذا سئلتَ وَأَنتَ بَحر مَكارم","جادَت يَداك وَلا يردّ السائل",77,"ل",1,0],["فَإِذا سَطا أَين المَفَرْ","مِنهُ إِذا النجم أَفلْ",78,"ل",1,0],["فَإِذا سَخَوا كانوا البِحارَ وَإِن سَطوا","كانوا الأسودَ أَو السُراة الصيدا",79,"د",2,0],["فإِذا سَقاكُ بِعَيْنِهِ","وَبِفِيهِ ثمَّ سَقاكَ بِاليَدْ",80,"د",1,0],["فَإِذا سَللت مِنَ العَواضِبِ صَيْقَلاً","أُردي الغَضَنفَرَ بِالحُسامِ وَأصرعُ",81,"ع",1,0],["فإذا سمعت أخي عن استشهاده","يوما وحاول ذهنك استذكاره",82,"ر",2,0],["فإذا سابق قالوا","أولٌ والكل آخِرْ",83,"ر",1,0],["فإذا سالت فذا وقو","فُ سؤال ذي طلب سليمْ",84,"م",1,0],["فَإِذا سُئِلتَ تَقولُ لا","وَإِذا سَأَلتَ تَقولُ هاتِ",85,"ت",1,1],["فَإذَا سفرتِ فبدرُ تَمٍّ طَالٍعٌ","وَإذَا نَفَرْتِ فشادنٌ ظَمْآنُ",86,"ن",1,0],["فإذا سألت عن الندى","فجوابهم عن ذاك وو",87,"و",1,0],["فَإِذا ساعَةُ المَنِيَّة حَمَت","لَم يَكُن غَيرُ عاثِر بِمَقال",88,"ل",1,0],["فإِذا سَرَى مَلأَ العَراءَ سَنابِكاً","وإِذا سَطَا مَلأَ القِفارَ جماجماً",89,"م",2,0],["فإذا سمعت حديثنا بين الصفا","والمنحنى فاشرب ونعم المشرب",90,"ب",1,0],["فَإِذا سارَ بِالخَميسِ لِحَرب","كَلَّ عَن نَصِّ جَريِهِ الخافِقانِ",91,"ن",1,0],["فَإِذا سَرَت فَاللَيلُ مِنهُم أَبيَضٌ","وَإِذا غَدَت فَالصُبحُ مِنها أَدهُمُ",92,"م",1,0],["فإذا سطا فقراهما الفرسان","وإذا عفا فالطير والحملان",93,"ن",1,0],["فاذا سرَت انفاسُها لك أبرأَت","بلطيفِ ريّاها غليلَ الأَنفُسِ",94,"س",1,0],["فاذا سهونا في القيام بأمرنا","حملوه عنا ركعا او سجدا",95,"د",2,0],["فَإِذا سَمِعتُ أَنينَها في لَيلِها","طَفِقَت عَلَيكِ شُؤونُ عَيني تَدمُعُ",96,"ع",1,0],["فَإِذا سَأَلتَهُمُ سَأَلتَ غَمائِماً","