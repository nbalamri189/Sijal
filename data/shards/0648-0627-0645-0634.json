{"poems":[[65,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[88,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[74,"سأسعى إلى أبوابكم ولو أنني","https://www.aldiwan.net/poem19640.html","الطويل"],[93,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[93,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[94,"راعها منه صمته ووجومه","https://www.aldiwan.net/poem38890.html","الخفيف"],[34,"أرى كل معشوقين غيري وغيرها","https://www.aldiwan.net/poem27811.html","الطويل"],[87,"أيها الثغر بلغت الأملا","https://www.aldiwan.net/poem7143.html","الرمل"],[48,"اعمل لأخراك شروى من يموت غدا","https://www.aldiwan.net/poem23054.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[12,"","https://poetry.dctabudhabi.ae/diwan/poem/11812","الطويل"],[164,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[190,"إذا ملك الفتى هنا ودنا","https://www.aldiwan.net/poem43205.html","الوافر"],[228,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[275,"حتام تعشق عاجا تحت ديباج","https://www.aldiwan.net/poem35179.html","البسيط"],[275,"لئن ذبلت كالزهر يوما قريحتي","https://www.aldiwan.net/poem35607.html","الطويل"],[376,"دنت فرأتني عاتبا متطرفا","https://www.aldiwan.net/poem57300.html","الطويل"],[396,"خل المقادير تمضي لا تغالبها","https://www.aldiwan.net/poem54612.html","عموديه"],[409,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[422,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[458,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[466,"اجنب أهل الأمر والنهي زورتي","https://www.aldiwan.net/poem15929.html","الطويل"],[505,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[563,"عشق ذات الخال عشقي","https://www.aldiwan.net/poem34325.html","مجزوء الرمل"],[563,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37976","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216578",""],[2394,"","https://poetry.dctabudhabi.ae/diwan/poem/146277","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104673","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112346","الكامل"],[3551,"","https://poetry.dctabudhabi.ae/diwan/poem/46154","المواليا"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85129","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59462","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199060","الكامل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111118","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133080","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66121","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[4676,"ثورة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=206651",""],[4702,"سكرة الموج","https://www.poetsgate.com/ViewPoem.aspx?id=155104",""],[4702,"مشوار عز","https://www.poetsgate.com/ViewPoem.aspx?id=155169",""],[4764,"الدمع ساكن والاماني تفضحه","https://www.poetsgate.com/ViewPoem.aspx?id=28004",""],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[4927,"ضياع الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=30179",""],[5084,"هلّ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=177785",""],[5135,"أبَى الشَّوْقُ إلَّا أَنْ يَزِيْدَ مَوَاجِعِي","https://www.poetsgate.com/ViewPoem.aspx?id=201821",""],[5219,"ظلام .. ونور","https://www.poetsgate.com/ViewPoem.aspx?id=195035",""],[5277,"دفّةُ الأفلاك","https://www.poetsgate.com/ViewPoem.aspx?id=185841",""],[5277,"نوافذ المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=201911",""],[5376,"للموتِ في شامِ الورى أفياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=196577",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5550,"إذا شئْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211314",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[6124,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=201317",""],[6131,"نحَّاتُ نورٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189270",""],[6251,"الأرقم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76494&r=&rc=34",""],[6299,"كأنْ قَدْ فلا يَغْرُرْكِ مِنِّي تَمَكُّثِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19680&r=&rc=5",""]],"verses":[["وامْشِ الضَّراءَ تَنَلْ ما شِئْتَ من فُرَصٍ","ولا تَمُدَّ لمَنْ عاداكَ في الطِّوَلِ",0,"ل",1,0],["وَاِمشوا عَلى حَذَرٍ فَإِنَّ طَريقَكُم","وَعرٌ أَطافَ بِهِ الهَلاكُ وَحَلَّقا",1,"ق",2,0],["وَأَمشي اِختِيالاً إِلى عابِدينَ","يُطالِعُني بَدرُها عَن كَثَب",2,"ب",1,0],["وأمشي لكم ما بين مصرٍ وغزَّةٍ","وإن كنتُ لا أستحسن المشي في الرمل",3,"ل",1,0],["وَاِمشِ بِنا في كُلِّ لَحنٍ فاتِنٍ","كَالماءِ يَجري في الغُصونِ طُهورُهُ",4,"ر",2,0],["وَاِمشِ عَلى ضَوءِ الصَباحِ فَإِن خَبا","فَاِمشِ عَلى ضَوءِ الهِلالِ الساري",5,"ر",2,0],["وامش في روضَةِ الشَّبابِ طَروباً","فحواليكَ وردُهُ وَكُرومُهْ",6,"م",2,0],["وَأَمشي وَتَمشي في البِلادِ كَأَنَّنا","أَسيرانِ لِلأَعداءِ مُرتَهَنانِ",7,"ن",1,0],["وامش في موكبه واجتله","موكب الرحمن نعم المجتلى",8,"ل",2,0],["وَأَمُّ شِبلَينِ في غَيلٍ وَمَأسَدَةٍ","كَأُمِّ خِشفَينِ في شَتٍّ وَطُبّاقِ",9,"ق",1,0],["وامش بآداب الكتاب تهتد","وقف بأبواب الحديث واجتد",10,"د",1,0],["وَأَمشي لَدى العَصداءِ أَبغي سَراتَهُم","وَأَسلكَ خَلاًّ بَينَ أَرباغِ وَالسَردِ",11,"د",1,0],["وامشوا على الآثار من أسلافكم","من زاد في الإِنصاف زيد ودادا",12,"د",2,0],["وأمشى خلفه كلبا هروشا","له ذات نعوس به وسن",13,"ن",1,0],["وَاِمشي بِأَعصابِ الحَقودِ وَأَضرِمي","نارَ السَلامِ تدبُّ في أَحقادِهِ",14,"د",2,0],["وامشِ الهويناء لا يأسٌ ولا طمعٌ","وكُن حكيماً فلا مُطْرٍ ولا هاج",15,"ج",1,0],["وأمشي حزيناً خائفاً متردِّداً","على طَللِ النُّعمى وقبرِ الشبيبة",16,"ه",1,0],["وأَمشي إِلى الحَسناءِ أسبقُ وَعدها","فَأعجلُها عَن أَن تَقولَ فتُخلِفا",17,"ف",2,0],["وامش رويدا مع الأقدار في مهل","فإن من يكره الأقدار متعوب",18,"ب",1,0],["وامش في روض المعاني والبيان","واقطف الأمثال",19,"ل",1,0],["وأمشي بها مَرَحاً تستميل","من السكر بالراح ميَّالَها",20,"ل",3,0],["وأمشي على كل الذي هتفوا به","وما ملكوا منه جنانا ولا فما",21,"م",2,0],["وأمشي إِلى الخلاَّنِ سعياً ولا أرى","تحمَّلُني نحو الملوكِ الصَّواهلُ",22,"ل",1,0],["وامْشِ المُطَيْطاءَ للدُّنيا فقِسْمَتُها","لا بدَّ تأتي فقلْ يا أَهلَها طِيروا",23,"ر",3,0],["وامشقوا يا أيها القو","م على آثار مشقي",24,"ق",2,0],["وامشو الصراط المستقي","م إلى الحبيب لتقربوا",25,"ب",3,0],["وَاِمشِ في الرَّكبِ الحجازيِّ الَّذي","جَدَّ في السَّيرِ وَقَد عادَى المَناما",26,"م",2,0],["وامش فوق البساط بالنعل عزا","فبنعليك قد زكا مقدارا",27,"ر",2,0],["وَاِمشي عَلى الأَشلاءِ نَشوى وَاِرقُصي","في مَأتَمِ الأَخلاقِ شَهوى وَاِسكَري",28,"ر",2,0],["وامش فارمل إذا وصلت إلى ال","ميل وعد كن لما مضى قوالا",29,"ل",2,0],["وامْشِيْ عَلَى كَاري وفني","واكيد لِكْ شروات مَا تْكيد",30,"د",1,0],["وامش الهوينا مظهراً عفّةً","وابغ رضى الأعين عن هيئتك",31,"ك",1,0],["وأُمُّ شَيطان طَحلَةٌ برقِّ","مِنَ الأَباعِل ترها في الشَّرقِ",32,"ق",1,0],["وَأُمشى ثُمَّ أُصبِحُ في حِماها","وَأَشبَعُ مِن جَوانِبِها عِناقا",33,"ق",2,0],["وامشي مَعَ الأيّام","والخَمرُ في الكأسِ",34,"س",1,0],["وامشرفه من قصرها المُمَنَّع","وَالنَيِّزات تَسجُد لَها وَتَركَع",35,"ع",1,1],["وأمشي مشيتي وأتيه تيها","أنا شمس الضحى لاحت بعقدي",36,"ي",1,0],["وأمشي بسيفي يوَم الجلادِ","كَمشي الخَبنْثَعة المخِدرِ",37,"ر",1,0],["وامش الهوينا واحترم قيعانها","ولج الفناء وجانب الأغيارا",38,"ر",2,0],["وامش بي رسلا فما تدري عسى","اللَه لبى دعوة في مشتكاها",39,"ا",3,0],["وامش على نهج الشريعة والحيا","واحذر من الكبر المشوم كذا الريا",40,"ي",2,0],["وامْشُوا إلى الأَمجادِ لا تَهِنُوا","مَنْ يَطْلِبُ العلياءَ لا يَهِن",41,"ن",1,0],["وامش الهوينا في مناكبها التي","فرشت لوطئك أعينا وجباها",42,"ا",3,0],["وأمشي كَما يَمشي التَأمّلُ لَحظةَ ال","وداعِ إلى آلامهِ وهوَ صَاغرُ",43,"ر",1,0],["وامشي نهارك ولو انّه عسير الطرق","ما همني دام ضو الشمس ما تكسره",44,"ر",2,0],["وامشي مع دروب المعزة .. تقديت","بالفكر مع خوة مهوّنة الاصعاب",45,"ب",1,0],["وامشتت الاحساس في ارضه وسماه","يرسم خطوط الحب يرجع يمسحه",46,"ح",2,0],["وأمشي فتمشي بإثريَ حِينا","وحيناً تُباعدُ عَنَّي الحَجر",47,"ر",1,0],["وَأَمْشِيْ عَلَىْ دَرْبٍ سَلَكْنَاْهُ خِلْسَةً","بِلَنْدُنَ يَاْ عَفْراءُ ذَاْتَ مَسَاْءِ",48,"ا",2,0],["وأمشي مع اللي لي يعذلون مشروع","مرضات من ظنّه على لون ظنيّ",49,"ن",2,0],["وأمْشِي مَعَ الْقَوْمِ الْكَثِيْرِ عَدِيْدُهُمْ","كَأنِّي وَحِيْدٌ فِي الدِّيَارِ الْبَلَاقِعِ",50,"ع",1,0],["٤-وأمْشي كسيرًا لعلّي ألاقي","شعاعًا من النور يُحيي الحياة",51,"ا",2,0],["وأمشي على النيرانِ والغيمُ مغرقٌ","ودوني هزيجُ الريحِ والبرقُ والرعدُ",52,"د",1,0],["وامشي في الدروبِ على خطاها","وتخذلني المحطّةُ والقطارُ",53,"ر",1,0],["وامشِ الهوينا تحت خطْوك بسمةٌ","أكفانُها الأزمانُ والعلياءُ",54,"ا",2,0],["وامشي بهم مشي الهلال معانياً","حلك الدجى حتى يتم كمالا",55,"ل",2,0],["وامشِ في مسْلك الحياة طليقًا","وارْم للرّيح كلَّ شيءٍ ذميم",56,"م",1,0],["وامشي بعيد بدون داعي وسبه","عشان اناظر صوره بوسط مخباي",57,"ا",2,0],["وامشي بدرب لا تبين خطوطه","محتها خطى الأوهام خلفك ماشيا",58,"ي",2,0],["وَأَمشِي فَوقَ شَوكِ التِّيهِ حَتَّى","كَأَنَّ الشَّوكَ فِي رِجلِي تَمَفصَلْ",59,"ل",1,0],["وَأَمْشِي فِي رَوَابِيْهَا","وَأَحْمِيْهَا مِنَ الجَدْبِ.",60,"ب",1,0],["وَ أمشيْ وحيدًا وَ ظلِّي حزينٌ","يكادُ يذوبُ منَ الشَّوقِ صَبْرَا",61,"ر",2,0],["وأمشي على شطيه ألثم زهره","وأترك خلفي فيه للوحش مجثما",62,"م",2,0],["وَأَْمْشِي لدى العَصْدَاءِ أبْغِي سَرَاتَهُمْ","وَأسْلُكَ خَلاَّ بَيْنَ أرْفَاغَ والسَّرْدِ",63,"د",1,0]]}