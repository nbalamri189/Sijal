{"poems":[[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"وساق صبيح للصبوح دعوته","https://www.aldiwan.net/poem64984.html","الطويل"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[31,"أرسلت هند إلينا رسولا","https://www.aldiwan.net/poem42030.html","المديد"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[90,"يا يراع الحر","https://www.poetsgate.com/ViewPoem.aspx?id=178940",""]],"verses":[["كاذبي المادحين يعلمُه اللَّ","هُ عُدول الهُجاة والعُيَّابِ",0,"ب",1,0],["كأذيال خَودٍ أقبلتْ في غلائلٍ","مُصبَّغةٍ والبعضُ أقصرُ من بعضِ",1,"ض",1,0],["كاذِبٌ في صَبابَتي","ماذِقٌ في تَوَدُّدي",2,"ي",1,0],["كاذِباً قَد يَعلَمُ اللَهُ رَبّي","أَنَّني لَم أَجنِ ما كُنهُ ذاكا",3,"ك",2,0],["كاذبُ الزَّعمِ مستحيلُ المعاني","فاسِدُ النّظمِ فاسدُ التأليف",4,"ف",1,0],["كاذبٌ جاءَ جَهاماً زِبْرِجاً","بَعْدَمَا أوْمَضَ بَرْقٌ وَرَعَد",5,"د",1,0],["كاذب ما نال شعب بسوى القوة نالا","يا يراع الحر قد ضاق بك الحر مجالا",6,"ل",2,0]]}