{"poems":[[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"وساق صبيح للصبوح دعوته","https://www.aldiwan.net/poem64984.html","الطويل"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[33,"أرسلت هند إلينا رسولا","https://www.aldiwan.net/poem42030.html","المديد"],[77,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/142366","الرمل"],[259,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[369,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[469,"عاد مني الخيال طيف الخيال","https://www.aldiwan.net/poem3497.html","عموديه"],[510,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[522,"وساق صبيح للصبوح دعوته","https://www.aldiwan.net/poem60552.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67030","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204891",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65164","السريع"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[4755,"إِنَّهَا فِتنَةُ الفِتَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=195210",""],[5725,"لنسفعاً بالناصية","https://www.poetsgate.com/ViewPoem.aspx?id=207484",""]],"verses":[["كاذبي المادحين يعلمُه اللَّ","هُ عُدول الهُجاة والعُيَّابِ",0,"ب",1,0],["كأذيال خَودٍ أقبلتْ في غلائلٍ","مُصبَّغةٍ والبعضُ أقصرُ من بعضِ",1,"ض",1,0],["كاذِبٌ في صَبابَتي","ماذِقٌ في تَوَدُّدي",2,"د",2,0],["كاذِباً قَد يَعلَمُ اللَهُ رَبّي","أَنَّني لَم أَجنِ ما كُنهُ ذاكا",3,"ك",2,0],["كاذبُ الزَّعمِ مستحيلُ المعاني","فاسِدُ النّظمِ فاسدُ التأليف",4,"ف",1,0],["كاذبٌ جاءَ جَهاماً زِبْرِجاً","بَعْدَمَا أوْمَضَ بَرْقٌ وَرَعَد",5,"د",1,0],["كاذب ما نال شعب بسوى القوة نالا","يا يراع الحر قد ضاق بك الحر مجالا",6,"ل",2,0],["كاذبٌ، نذلٌ، وضيعٌ","ليتهُ عدلاً شكاني",7,"ن",2,0],["كإذْكائه دونَ الخلافةِ طَرْفَه","مُدِلاًّ برأْيٍ يَقرُنُ النَّصْلَ بالنَّصر",8,"ر",1,0],["كاذباتِ الأحلام لستُ اسمي","كنَّ إلاَّ صوادقَ الآمال",9,"ل",1,0],["كأذيالِ عباءاتٍ تلهَّىْ","بأقواتِ الخلائقِ والمصائِرْ",10,"ر",1,0],["كأذيال أقبلت في غلائل","مصبغة والبعض أقصر من بعض",11,"ض",1,0],["كأذرع الغيد في خضر البرود جلت","على أناملها صفر اليواقيت",12,"ت",1,0],["كأذنابِ الطواويس","كأطواقِ الخرامين",13,"ن",1,0],["كاذؤبٍ تنهثُها أذؤب","لها عواءٌ ولها زفر",14,"ر",1,0],["كاذب في الحب حيّ","وبحبٍّ ما كذبنا",15,"ن",2,0],["كاذ الذي أمسيت عبدا له","وهو عزيزٌ لوصالي مُجيز",16,"ز",1,1],["كاذا ابن ادهم لما انعشته سرى","عن الديار بترك الملك والحشم",17,"م",1,0],["كاذِبٌ كُلُّ صَادِقٍ","لَم يَمُتْ فِيهِ أَو يُجَنْ",18,"ن",1,0],["كاذبة خاطئة افعالهم","لن يخدعونا بالوعود الخالية",19,"ي",2,0]]}