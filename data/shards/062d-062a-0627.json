,"لِغَيرِنا مِن بِئرِنا نَمتَحُ",4,"ح",1,0],["حَتّامَ وَالأَموالُ مَشفوهَةٌ","نَمنَحُ إِلّا مِصرَ ما نَمنَحُ",4,"ح",1,0],["حَتّامَ يُمضي أَمرَنا غَيرُنا","وَذاكَ بِالأَحرارِ لا يَملُحُ",4,"ح",1,0],["حتَّامَ نكتُم حُزنَنَا حَتَّامَا","وَعَلامَ نَستَبقي الدُّمُوعَ عَلامَا",5,"م",2,1],["حَتّام تَبقَى لعبة لحكومة","دامَت تُجرِّعنا نَقيع الحنظل",6,"ل",1,0],["حتام بين مذكرٍ ومؤنثٍ","قلبي الشجيّ طويلة برحاؤه",7,"ا",3,0],["حتَّامَ لاشعري أمَامَ المُجْتَنَى","فَأَحَظَّ منْهُ ولا وراءَ المطَّرِحْ",8,"ح",1,0],["حتام لا نلتقي على دعة","وطيب عيش منا فنأتلف",9,"ف",1,0],["حتّام يا سائس الدنيا تؤخرني","وإنني لنظيرُ الصدرِ لا الكفلِ",10,"ل",1,0],["حَتّامَ أَكذِبُ لِلوَرى","وَإِلى مَتى أَتَجَمَّلُ",11,"ل",1,0],["حَتّامَ تُمطِلُني اللَيالي قُربَ مَن","قَلبي لَهُ مُتَشَوِّفٌ مُتَشَوِّقُ",12,"ق",1,0],["حتامَ يختار الشقاقُ مقامه","في المسلمين وإنهم إخوان",13,"ن",1,0],["حتام هذا الحقد بين رجالنا","حتام هذا البغض والخذلان",13,"ن",1,0],["حتام لا تأتي النفوس صلاحها","حتام لا تتنبه الأذهان",13,"ن",1,0],["حَتّامَ هِجراني وَفيمَ تَجَنُّبي","وَإِلامَ بي ذُلُّ الهَوى يُغريكِ",14,"ك",1,0],["حَتّامَ نَحنُ نُساري النَجمَ في الظُلَمِ","وَما سُراهُ عَلى خُفٍّ وَلا قَدَمِ",15,"م",1,1],["حتَّامَ أُنْهِضُ جَدِّي وهو يعثر بي","أخافُ ألّا يرانِي الجَدُّ إِنْ نَهَضَا",16,"ض",2,0],["حتامَ تحلِم منهم غيرَ منتقِمٍ","والحِلْمُ ينزعُ أحياناً إِلى الخَوَرِ",17,"ر",1,0],["حتَّامَ يحتملُ الأذى","في حبِّكَ القلبُ القريحُ",18,"ح",1,0],["حَتّامَ لا أَنفَكُّ مِنكَ تَسومُني","خَسفاً وَتَعسِفُني بِسَطوَةِ حاقِدِ",19,"د",1,0],["حَتّامَ تُفرِطُ في التَصابي لَوعَتي","وَتُفيضُ واكِفَ دَمعِيَ المَذروفِ",20,"ف",1,0],["حتام نحمل غير محمول على","إرهاقنا ونطيق غير مطاق",21,"ق",1,0],["حتَّامَ سيفُكَ لا تُروى مضاربُه","من الدِّماءِ ولا تُقضَى مآربُه",22,"ب",2,0],["حَتّامَ أَمنَحُكَ المَوَدَّةَ وَالوَفا","وَتَسومُني قَصدَ القَطيعَةِ وَالجَفا",23,"ف",2,1],["حَتّامَ لا تَضجَرُ يا سَيِّدي","مِن سَعَةِ العُذرِ وَضيقِ الحِجاب",24,"ب",1,1],["حَتّامَ أَحزانُ في تَوديعِ مُرتَحِلٍ","وَأَقرَعُ السِنَّ في آثارِهِ نَدَما",25,"م",2,0],["حتام كتماني وطول تجلدي","يا أيها الجاني عليَّ وما درى",26,"ر",2,0],["حَتَّامَ تُعْرِضُ عَنِّي","وَلا تَرُدُّ سَلامِي",27,"م",2,0],["حَتّامَ أَندُبُ صاحِباً وَشَبيبَةً","فَتَفيضُ عَينٌ أَو يَحِنُّ فُؤادُ",28,"د",1,0],["حَتّامَ أَنتَ تَهيمُ لا","حَتّامَ بِالأُنسِ المُزايِل",29,"ل",1,0],["حَتّامَ قَلبِيَ مَشغولٌ بِذِكرِكُمُ","يَهذي وَقَلبُكِ مَربوطٌ بِنِسياني",30,"ي",1,1],["حَتّامَ أَدعو الصِبى وَأَتبَعُهُ","وَالمَوتُ دانٍ وَاللَهُ بِالرَصَدِ",31,"د",1,0],["حَتّامَ تُجشِمُني الصِبى وَتَشُفُّني","بَل لَيتَ غَيرَكَ يا فُؤادُ فُؤادا",32,"د",2,0],["حتام تغتر العرو","بة بالأمانيِّ الكواذب",33,"ب",1,0],["حتام تخفي وَجهها","عنا المَليحة في اللثام",34,"م",1,0],["حتام يَشكو الضيم شعب كامل","حتامَ تحمل أمة أَثقالا",35,"ل",2,0],["حَتّامَ تَعْتَسِفُ الرّفَا","قُ حُزُونَها ورِمالَها",36,"ل",3,0],["حَتَّام أَنْتَ على الضَّرَّاءِ مُضْطَجعٌ","مُعرِّسٌ في دِيارِ الظُّلْمِ والظُّلَمِ",37,"م",1,0],["حَتَّامَ تَفْخَرُ بِالْجُدُودِ وَلَمْ تَنَلْ","مَا أَحْرَزَتْ تِلْكَ الْجُدُودُ الْفَاخِرَهْ",38,"ر",2,0],["حتَّامَ يشكو الشعرَ من مُتَمَسِّحٍ","فيه يُشيِّدُ نفسَه بخرابه؟",39,"ب",2,0],["حَتَّام، يا قومي، نُفا","خِرُ بالأَوائل إذْ نفاخر؟",40,"ر",1,0],["حتَّام يَحْتَدم الخلا","فُ، وفيمَ تفترقُ العشائر؟",40,"ر",1,0],["حتَّام تضرب في الدياجي هائمًا","تهدي الأنام ولا إخالك تهتدي؟",41,"د",2,0],["حتام نَنْعَتُ بالبطولة فاتكًا","يحكي الوحوش ضراوة ووثوبا؟",42,"ب",2,0],["حَتّامَ تُفْرِطُ في التَّصابِي لَوْعتي،","وَيَفيضُ واكفَ دَمعيَ المَذرُوفِ",43,"ف",1,0],["حتّام نبقي لُعبة لحكومة","دامت تجرّعنا نقيع الحنظل",44,"ل",1,0],["حتام سفن أَمانينا عَلى يَبس","تَجري بِجَنح ظَلام مَطفيء القَبسِ",45,"س",1,1],["حتّام في لَيل الهُمو","م زِناد فكرك تَنقدح",46,"ح",1,1],["حتامَ قلبي للوصال يميلُ","وعلامَ سيفُ الصدّ لي مسلولُ",47,"ل",1,1],["حتّام نفرح بالبقاء ونطربُ","والنفسُ أدنى للفناءِ وأقربُ",48,"ب",1,1],["حتامَ تأسى والحِمامُ محتمٍ","وعلامَ تأسف وهو أمرٌ مبرمُ",49,"م",1,1],["حتّام أرعىَ وردةً لا تُجتنَى","في الخدِّ أو تُفّاحةً لا تُلثمُ",50,"م",1,0],["حتام تخلف وعدي","وكيف ضيعت عهدي",51,"د",2,1],["حَتّامَ يُساوِرهُ كمدٌ","يُبلى الأَحشاءِ تجدُّدُه",52,"د",2,0],["حَتّامَ مَطلُكَ يا ظَلومُ","ماآنَ أَن يُقضى الغَريمُ",53,"م",1,1],["حَتّامَ يَحمِلُ فيكَ أَعباءَ الهَوى","قَلبٌ قَريحٌ بِالصَبابَةِ موجَعُ",54,"ع",1,0],["حَتّامَ دَهري بِتَصاريفِهِ","يَقصِدُني وَالحُرُّ مَقصودُ",55,"د",1,0],["حَتّامَ أَصحَبُ فيكَ قَل","باً بِالصُدودِ مُعَذَّبا",56,"ب",2,0],["حَتّامَ أَرضى في هَواكَ وَتَغضَبُ","وَإِلى مَتى تَجني عَليَّ وَتَعتَبُ",57,"ب",1,1],["حَتَّامَ أُخفِي في هوا","ك صَبابَتي والدمع يُبدي",58,"د",2,0],["حَتَّامَ تحكمُ في نفو","س العاشقين وأنتَ جائر",59,"ر",1,0],["حَتَّامَ أمشى في طلا","ب معيشتي والرزقُ واقف",60,"ف",1,0],["حَتَّامَ تَخدَع عزمي الآمالُ","وتَصُدُّني عن فعليَ الأقوالُ",61,"ل",1,1],["حتَّام أسبحُها فلولا أنَّ لي","عَينينِ قال الناسُ ذا الدجَّالُ",61,"ل",1,0],["حتام منا المستهام","بحالتيك المستهان",62,"ن",1,0],["حتام دمعي فيك لا","برقي وروحي التراق",63,"ق",1,0],["حتام جورك ظبي جيران اللوى","فأجر محبك من صدودك تؤجر",64,"ر",1,0],["حتام تطمح آمالي ويعقلها","ضمن الجديدين اقبال واعسار",65,"ر",1,0],["حتام نستسقي سحائب أجهمت","منه فتبرق خلباً أو ترعد",66,"د",1,0],["حتام أرقب كل برق خلب","والفضل عندك منهل مورود",67,"د",1,0],["حتام لا ينثني الجموح","ويغمد المرهف الصفيح",68,"ح",1,1],["حتام استنجد الأيام في طلب","وينهض العزم والأقدار تقعد بي",69,"ب",2,0],["حتَّامَ ترقدُ غافلاً مُستَسلِماً","وتقولُ تلكَ من الزمانِ أحاظي",70,"ظ",2,0],["حتّامَ تعشقُ عاجاً تحتَ ديباجِ","بعد التلمُّسِ للدّيباجِ والعاجِ",71,"ج",1,1],["حتّامَ أطمعُ بالوصالِ ومُهجتي","ذابت من التعليلِ والتحريق",72,"ق",1,0],["حتّام يِشفى الفَتى والدَّهرُ يَدفعُهُ","وليسَ من ظُلُماتِ الموتِ يُرجعُهُ",73,"ع",2,1],["حتَّامَ أَنتم صابرونَ على الأذى","وإلامَ أنتم غُفَّلٌ ونيام",74,"م",1,0],["حتّامَ دَعوى البطلِ يَسمَعُها الوَرى","ويغِضُّ طَرفاً عن أذى جابيك",75,"ك",1,0],["حَتّامَ نصبرُ في ذلٍّ وفي جزعٍ","وكيفَ نحملُ بَلوانا وبلواك",76,"ك",1,0],["حَتّامَ لا أَنفَكُّ ذا لَوعَةٍ","وَعَولَةٍ مِن رَوعَةِ البَينِ",77,"ن",1,1],["حَتّامَ أَصدى وَهَذا البَحرُ مُعتَرِضٌ","يَفيضُ في كُلِّ قُطرٍ مِنهُ خُلجانُ",78,"ن",1,0],["حَتّامَ لا تَحنو عَلى 