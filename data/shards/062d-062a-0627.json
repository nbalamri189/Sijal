"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[468,"يا من يحن علي فيما يدعي","https://www.aldiwan.net/poem59546.html","الكامل"],[468,"حتام ذا الطغيان","https://www.aldiwan.net/poem59549.html","المجتث"],[493,"سرورنا بك فوق الهم بالنوب","https://www.aldiwan.net/poem67416.html","البسيط"],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[514,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[514,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[514,"حتام فيكم أعاني الشوق وأقاسي","https://www.aldiwan.net/poem20887.html","المواليا"],[514,"حتام أشغل بفكر القلب واعذبه","https://www.aldiwan.net/poem20895.html","المواليا"],[514,"حتام يا قلب عن نجل العيون أنهاك","https://www.aldiwan.net/poem20899.html","المواليا"],[514,"حتام يا نفس من سكر الهوى تصحين","https://www.aldiwan.net/poem20933.html","المواليا"],[551,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[586,"تحرش الطرف بين الجد واللعب","https://www.aldiwan.net/poem17437.html","البسيط"],[586,"حتام حظي لديك حرمان","https://www.aldiwan.net/poem17778.html","المنسرح"],[586,"حتام يلحى عليك من خلت ال","https://www.aldiwan.net/poem17809.html","المنسرح"]],"verses":[["حَتّامَ تَعتَلِقُ البَطالَةُ مِقوَدي","وَيَعودُني لِهوى الظَعائِنِ عيدي",0,"د",2,0],["حتّامَ تَبكي دماً والشَّيبُ مبتَسِمٌ","وَالعُمرُ قَد أَخلَقَتْ أَثوابُهُ القُشُبُ",1,"ب",1,0],["حَتّامَ تَشْكو الصَّدى بِيْضٌ مَباتِيرُ","وَلا تَخوضُ دَماً جُرْدٌ مَحاضِيرُ",2,"ر",1,1],["حَتّامَ وَالصَبرُ لَهُ غايَةٌ","لِغَيرِنا مِن بِئرِنا نَمتَحُ",3,"ح",1,0],["حَتّامَ وَالأَموالُ مَشفوهَةٌ","نَمنَحُ إِلّا مِصرَ ما نَمنَحُ",3,"ح",1,0],["حَتّامَ يُمضي أَمرَنا غَيرُنا","وَذاكَ بِالأَحرارِ لا يَملُحُ",3,"ح",1,0],["حتَّامَ نكتُم حُزنَنَا حَتَّامَا","وَعَلامَ نَستَبقي الدُّمُوعَ عَلامَا",4,"م",2,1],["حَتّام تَبقَى لعبة لحكومة","دامَت تُجرِّعنا نَقيع الحنظل",5,"ل",1,0],["حتام بين مذكرٍ ومؤنثٍ","قلبي الشجيّ طويلة برحاؤه",6,"ا",3,0],["حتَّامَ لاشعري أمَامَ المُجْتَنَى","فَأَحَظَّ منْهُ ولا وراءَ المطَّرِحْ",7,"ح",1,0],["حتام لا نلتقي على دعة","وطيب عيش منا فنأتلف",8,"ف",1,0],["حتّام يا سائس الدنيا تؤخرني","وإنني لنظيرُ الصدرِ لا الكفلِ",9,"ل",1,0],["حَتّامَ أَكذِبُ لِلوَرى","وَإِلى مَتى أَتَجَمَّلُ",10,"ل",1,0],["حَتّامَ تُمطِلُني اللَيالي قُربَ مَن","قَلبي لَهُ مُتَشَوِّفٌ مُتَشَوِّقُ",11,"ق",1,0],["حتامَ يختار الشقاقُ مقامه","في المسلمين وإنهم إخوان",12,"ن",1,0],["حتام هذا الحقد بين رجالنا","حتام هذا البغض والخذلان",12,"ن",1,0],["حتام لا تأتي النفوس صلاحها","حتام لا تتنبه الأذهان",12,"ن",1,0],["حَتّامَ هِجراني وَفيمَ تَجَنُّبي","وَإِلامَ بي ذُلُّ الهَوى يُغريكِ",13,"ك",1,0],["حَتّامَ نَحنُ نُساري النَجمَ في الظُلَمِ","وَما سُراهُ عَلى خُفٍّ وَلا قَدَمِ",14,"م",1,1],["حتَّامَ أُنْهِضُ جَدِّي وهو يعثر بي","أخافُ ألّا يرانِي الجَدُّ إِنْ نَهَضَا",15,"ض",2,0],["حتامَ تحلِم منهم غيرَ منتقِمٍ","والحِلْمُ ينزعُ أحياناً إِلى الخَوَرِ",16,"ر",1,0],["حتَّامَ يحتملُ الأذى","في حبِّكَ القلبُ القريحُ",17,"ح",1,0],["حَتّامَ لا أَنفَكُّ مِنكَ تَسومُني","خَسفاً وَتَعسِفُني بِسَطوَةِ حاقِدِ",18,"د",1,0],["حَتّامَ تُفرِطُ في التَصابي لَوعَتي","وَتُفيضُ واكِفَ دَمعِيَ المَذروفِ",19,"ف",1,0],["حتام نحمل غير محمول على","إرهاقنا ونطيق غير مطاق",20,"ق",1,0],["حتَّامَ سيفُكَ لا تُروى مضاربُه","من الدِّماءِ ولا تُقضَى مآربُه",21,"ب",2,0],["حَتّامَ أَمنَحُكَ المَوَدَّةَ وَالوَفا","وَتَسومُني قَصدَ القَطيعَةِ وَالجَفا",22,"ف",2,1],["حَتّامَ لا تَضجَرُ يا سَيِّدي","مِن سَعَةِ العُذرِ وَضيقِ الحِجاب",23,"ب",1,1],["حَتّامَ أَحزانُ في تَوديعِ مُرتَحِلٍ","وَأَقرَعُ السِنَّ في آثارِهِ نَدَما",24,"م",2,0],["حتام كتماني وطول تجلدي","يا أيها الجاني عليَّ وما درى",25,"ر",2,0],["حَتَّامَ تُعْرِضُ عَنِّي","وَلا تَرُدُّ سَلامِي",26,"م",2,0],["حَتّامَ أَندُبُ صاحِباً وَشَبيبَةً","فَتَفيضُ عَينٌ أَو يَحِنُّ فُؤادُ",27,"د",1,0],["حَتّامَ أَنتَ تَهيمُ لا","حَتّامَ بِالأُنسِ المُزايِل",28,"ل",1,0],["حَتّامَ قَلبِيَ مَشغولٌ بِذِكرِكُمُ","يَهذي وَقَلبُكِ مَربوطٌ بِنِسياني",29,"ي",1,1],["حَتّامَ أَدعو الصِبى وَأَتبَعُهُ","وَالمَوتُ دانٍ وَاللَهُ بِالرَصَدِ",30,"د",1,0],["حَتّامَ تُجشِمُني الصِبى وَتَشُفُّني","بَل لَيتَ غَيرَكَ يا فُؤادُ فُؤادا",31,"د",2,0],["حتام تغتر العرو","بة بالأمانيِّ الكواذب",32,"ب",1,0],["حتام تخفي وَجهها","عنا المَليحة في اللثام",33,"م",1,0],["حتام يَشكو الضيم شعب كامل","حتامَ تحمل أمة أَثقالا",34,"ل",2,0],["حَتّامَ تَعْتَسِفُ الرّفَا","قُ حُزُونَها ورِمالَها",35,"ل",3,0],["حَتَّام أَنْتَ على الضَّرَّاءِ مُضْطَجعٌ","مُعرِّسٌ في دِيارِ الظُّلْمِ والظُّلَمِ",36,"م",1,0],["حَتَّامَ تَفْخَرُ بِالْجُدُودِ وَلَمْ تَنَلْ","مَا أَحْرَزَتْ تِلْكَ الْجُدُودُ الْفَاخِرَهْ",37,"ر",2,0],["حتَّامَ يشكو الشعرَ من مُتَمَسِّحٍ","فيه يُشيِّدُ نفسَه بخرابه؟",38,"ب",2,0],["حَتَّام، يا قومي، نُفا","خِرُ بالأَوائل إذْ نفاخر؟",39,"ر",1,0],["حتَّام يَحْتَدم الخلا","فُ، وفيمَ تفترقُ العشائر؟",39,"ر",1,0],["حتَّام تضرب في الدياجي هائمًا","تهدي الأنام ولا إخالك تهتدي؟",40,"د",2,0],["حتام نَنْعَتُ بالبطولة فاتكًا","يحكي الوحوش ضراوة ووثوبا؟",41,"ب",2,0],["حَتّامَ تُفْرِطُ في التَّصابِي لَوْعتي،","وَيَفيضُ واكفَ دَمعيَ المَذرُوفِ",42,"ف",1,0],["حتّام نبقي لُعبة لحكومة","دامت تجرّعنا نقيع الحنظل",43,"ل",1,0],["حتام سفن أَمانينا عَلى يَبس","تَجري بِجَنح ظَلام مَطفيء القَبسِ",44,"س",1,1],["حتّام في لَيل الهُمو","م زِناد فكرك تَنقدح",45,"ح",1,1],["حتامَ قلبي للوصال يميلُ","وعلامَ سيفُ الصدّ لي مسلولُ",46,"ل",1,1],["حتّام نفرح بالبقاء ونطربُ","والنفسُ أدنى للفناءِ وأقربُ",47,"ب",1,1],["حتامَ تأسى والحِمامُ محتمٍ","وعلامَ تأسف وهو أمرٌ مبرمُ",48,"م",1,1],["حتّام أرعىَ وردةً لا تُجتنَى","في الخدِّ أو تُفّاحةً لا تُلثمُ",49,"م",1,0],["حتام تخلف وعدي","وكيف ضيعت عهدي",50,"د",2,1],["حَتّامَ يُساوِرهُ كمدٌ","يُبلى الأَحشاءِ تجدُّدُه",51,"د",2,0],["حَتّامَ مَطلُكَ يا ظَلومُ","ماآنَ أَن يُقضى الغَريمُ",52,"م",1,1],["حَتّامَ يَحمِلُ فيكَ أَعباءَ الهَوى","قَلبٌ قَريحٌ بِالصَبابَةِ موجَعُ",53,"ع",1,0],["حَتّامَ دَهري بِتَصاريفِهِ","يَقصِدُني وَالحُرُّ مَقصودُ",54,"د",1,0],["حَتّامَ أَصحَبُ فيكَ قَل","باً بِالصُدودِ مُعَذَّبا",55,"ب",2,0],["حَتّامَ أَرضى في هَواكَ وَتَغضَبُ","وَإِلى مَتى تَجني عَليَّ وَتَعتَبُ",56,"ب",1,1],["حَتَّامَ أُخفِي في هوا","ك صَبابَتي والدمع يُبدي",57,"ي",1,0],["حَتَّامَ تحكمُ في نفو","س العاشقين وأنتَ جائر",58,"ر",1,0],["حَتَّامَ أمشى في طلا","ب معيشتي والرزقُ واقف",59,"ف",1,0],["حَتَّامَ تَخدَع عزمي الآمالُ","وتَصُدُّني عن فعليَ الأقوالُ",60,"ل",1,1],["حتَّام أسبحُها فلولا أنَّ لي","عَينينِ قال الناسُ ذا الدجَّالُ",60,"ل",1,0],["حتام منا المستهام","بحالتيك المستهان",61,"ن",1,0],["حتام دمعي فيك لا","برقي وروحي التراق",62,"ق",1,0],["حتام جورك ظبي جيران اللوى","فأجر محبك من صدودك تؤجر",63,"ر",1,0],["حتام تطمح آمالي ويعقلها","ضمن الجديدين اقبال واعسار",64,"ر",1,0],["حتام نستسقي سحائب أجهمت","منه فتبرق خلباً أو ترعد",65,"د",1,0],["حتام أرقب كل برق خلب","والفضل عندك منهل مورود",66,"د",1,0],["حتام لا ينثني الجموح","ويغمد المرهف الصفيح",67,"ح",1,1],["حتام استنجد الأيام في طلب","وينهض العزم والأقدار تقعد بي",68,"ب",2,0],["حتَّامَ ترقدُ غافلاً مُستَسلِماً","وتقولُ تلكَ من الزمانِ أحاظي",69,"ظ",2,0],["حتّامَ تعشقُ عاجاً تحتَ ديباجِ","بعد التلمُّسِ للدّيباجِ والعاجِ",70,"ج",1,1],["حتّامَ أطمعُ بالوصالِ ومُهجتي","ذابت من التعليلِ والتحريق",71,"ق",1,0],["حتّام يِشفى الفَتى والدَّهرُ يَدفعُهُ","وليسَ من ظُلُماتِ الموتِ يُرجعُهُ",72,"ع",2,1],["حتَّامَ أَنتم صابرونَ على الأذى","وإلامَ أنتم غُفَّلٌ ونيام",73,"م",1,0],["حتّامَ دَعوى البطلِ يَسمَعُها الوَرى","ويغِضُّ طَرفاً عن أذى جابيك",74,"ك",1,0],["حَتّامَ نصبرُ في ذلٍّ وفي جزعٍ","وكيفَ نحملُ بَلوانا وبلواك",75,"ك",1,0],["حَتّامَ لا أَنفَكُّ ذا لَوعَةٍ","وَعَولَةٍ مِن رَوعَةِ البَينِ",76,"ن",1,1],["حَتّامَ أَصدى وَهَذا البَحرُ مُعتَرِضٌ","يَفيضُ في كُلِّ قُطرٍ مِنهُ خُلجانُ",77,"ن",1,0],["حَتّامَ لا تَحنو عَلى عاشِقٍ","مُفارِقِ الوَصلِ غَريمِ الغَرام",78,"م",1,0],["حَتّامَ يا دَهرُ لا أَنفَكّ ذا ظَمَأٍ","وَلا أَراكَ بِوِردٍ ناقِعاً غُلَلي",79,"ل",2,0],["حَتَّامَ تَعملُ لي دُسُوتاً لَمْ تَزَلْ","مَصْقُولَةً بِخدِيعةٍ وَنفاقِ",80,"ق",1,0],["حَتّامَ بِالأَعراضِ عَن جَورهَ","ري ا