.html","السريع"],[575,"يا قوم عشقي ابن فلان غدا","https://www.aldiwan.net/poem2859.html","السريع"],[575,"أموت بمن لو مر ذيل قميصه","https://www.aldiwan.net/poem2980.html","الطويل"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[587,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"]],"verses":[["غَلَبنَ عَلى عِلقي النَفيسِ فَحُزنَه","وَفارَقَني عِلقٌ عَلَيَّ ثَمينُ",0,"ن",1,0],["غَلَبَت عَلى كَرَمِ المَعا","رِقِ فيهِ أَخلاقُ اللِئامِ",1,"م",1,0],["غَلَبنَ عَلى جَمالِ الخُلقِ حَتّى","تَرَكنَ الخَلقَ مَنسيَّ الجَمالِ",2,"ل",1,0],["غَلَبَت مَآثِرُهُ النُجومَ عَلى","عَرَضاتِها وَبَدأنَ بِالبَدرِ",3,"ر",1,0],["غُلِبتُ عَليكُم فيا صَفقَةً","غُبِنتُ بِها العَيشَ غُصناً رَطيبا",4,"ب",2,0],["غُلبٌ كَأَنَّهُمُ الصُقورُ جَوانِحاً","وَكَأَنَّ أَكنافَ الجِيادِ مَراقِبُ",5,"ب",1,0],["غُلامٌ كَأَخلاءِ اللِجامِ تُجيزُهُ","صُدورُ القَنا وَالبيضُ كُلَّ فَضاءِ",6,"ا",2,0],["غُلَّتْ عن المَعروفِ فهْيَ بكِيَّةٌ","والضَّرْعُ تَغْمُرُهُ الأصِرَّةُ حافِلُ",7,"ل",1,0],["غَلَبُوا عَلَيْكَ لِكَيْ تَتِمَّ مَشِيئَةٌ","لِلَّهِ تَبْرُزُ فِي الْوُجُودِ وَتَنْزِلُ",8,"ل",1,0],["غَلَبَ الظُّنُونَ الرَّوْعُ أَوَّلَ وَهلَةٍ","فَقَضَى بِسَعْدِكَ غَالِبُ الْغلاَّبِ",9,"ب",1,0],["غَلِيلٌ وَلِكنْ مِنْ قَبُولِكَ مُنْهَلٌ","عَلِيلٌ وَلِكَنْ مِنْ رَضَاكَ طَبيِبُ",10,"ب",1,0],["غُلبُ الرِقابِ سَقاها جَدوَلٌ سَرِبٌ","أَو مَشعَبٌ مِن أَتِيِّ البَحرِ مَفجورُ",11,"ر",1,0],["غَلَّ القَضاءُ يَدَ القَضاءِ فَذا","يَبكي عَلَيكَ وَذاكَ في جَذَلِ",12,"ل",1,0],["غَلَبَ الخُشوعُ عَلَيهِمُ فَدُموعُهُم","تَجري بِلا كَلَحٍ وَلا اِستِنثارِ",13,"ر",1,0],["غَلِطَ الناسُ ما طَغى جَبَلُ النا","رِ بِإِرسالِ نَفثَةٍ في الهَواءِ",14,"ا",2,0],["غَلَيانٌ في الأَرضِ نَفَّسَ عَنهُ","ثَوَرانٌ في البَحرِ وَالبُركانِ",15,"ن",1,0],["غُلامِيَّةُ التَخطيطِ ريمِيَّةُ الطُلى","كَثيبِيَّةُ الأَردافِ خوطِيَّةُ القَدِّ",16,"د",1,0],["غلِطَ اِمرُؤٌ بِأَبي عَلِيٍّ قاسَهُ","هَيهاتَ قَصَّرَ عَن مَداهُ أَبو عَلي",17,"ل",2,0],["غَلِقنَ بِرَهنٍ مِن حَبيبٍ بِهِ اِدَّعَت","سُلَيمى فَأَمسى حَبلُها قَد تَبَتَّرا",18,"ر",2,0],["غلب الحنان وكم له من آيةٍ","غراء أسطع ما تجلت فيك",19,"ك",1,0],["غَلَتِ الحَيَاةُ فَإِنْ تُرِدْهَا حُرَّةً","كُنْ مِنْ أُبَاةِ الضَّيْمِ وَالشُّجْعَانِ",20,"ن",1,0],["غَلَبَتْنِي صُرُوفُ دَهْرِي عَلَى صَبْ","رِي وَأَفْنَتْهُ نَارُهَا فِي الَملاحِمْ",21,"م",1,0],["غَلَلتُ المَهارى بَينَها كُلَّ لَيلَةٍ","وَبَينَ الدُجى حَتّى أَراها تَمَزَّقُ",22,"ق",1,0],["غَلَب الشقاء على الأنام فخيرهم","دَثٌّ وقَطر شرورهم اغريض",23,"ض",1,0],["غَلَوتم في ديانتكم غُلُوّاً","يَضيق ببعضه الشرع الرحيب",24,"ب",1,0],["غَليظَةُ جِلدِ المِنخَرَينِ مُصِنَّةٌ","عَلى أَنفِ خِنزيرٍ يُشَدُّ نِقابُها",25,"ب",3,0],["غَلَبَ العَزاءَ وَكُنتُ غَيرَ مُغَلَّبٍ","دَهرٌ طَويلٌ دائِمٌ مَمدودُ",26,"د",1,0],["غَلَبَ اللَيالي خَلفَ آلِ مُحَرِّقٍ","وَكَما فَعَلنَ بِتُبَّعٍ وَبِهِرقَلِ",27,"ل",1,0],["غَلَلاً تَضَمَّنَهُ ظِلالُ يَراعَةٍ","غَرقى ضَفادِعُهُ لَهُنَّ نَئيمُ",28,"م",1,0],["غُلبٌ تَشَذَّرُ بِالذُحولِ كَأَنَّها","جِنُّ البَدِيِّ رَواسِياً أَقدامُها",29,"م",3,0],["غُلامٌ فَوقَ ما أَصِفُ","كَأَنَّ قَوامَهُ أَلِفُ",30,"ف",1,1],["غُلامٌ أَتاهُ اللُؤمُ مِن شَطرِ خالِهِ","لَهُ جانِبٌ وافٍ وَآخَرُ أَكشَمُ",31,"م",1,1],["غَلِبَت عَلى شَبَهِ الغُلامِ وَقَد","بانَ السَوادُ لِحالِكٍ جَعدِ",32,"د",1,0],["غلا الجوهر الأعلى بثغرك فلتَفُضْ","مدامع لا تكون على العرض الأدنى",33,"ن",2,0],["غلام بيتك في بيتي ثناً ووَلاً","كما يسرك حسان وسلمان",34,"ن",1,0],["غلب الصبر في هوى ناظريه","وضعيفان يغلبان قويّا",35,"ي",2,0],["غلطَ الناسُ لست تلعب بالشِّط","رنج لكن بأنفُس اللُّعباءِ",36,"ا",2,0],["غلب الجهلُ والسَّفاهُ عليهم","فتراهم يُزندقون الأديبا",37,"ب",2,0],["غلبوني به على كل حظٍّ","غيرَ حظٍّ يفوتُ كلَّ اغتصابِ",38,"ب",1,0],["غليلٌ أبى أن يُطفِئَ الدمعُ نارَهُ","ويُضرمهُ أن تَعصِب الزفراتُ",39,"ت",1,0],["غلاماً أميراً ثم كهلاً خليفةً","بهمَّة ماضي العزم يقظانَ ماجدِ",40,"د",1,0],["غلِط الطبيب عليَّ غلطةَ مُوردٍ","عجزتْ مَحالتُه عن الإصدارِ",41,"ر",1,1],["غلبت لكنة النصارى على في","ه فأعيت علاج بُقْراطيس",42,"س",1,0],["غلِّبْ عليه جميلَ فعلِك بي","إنَّ هناتي تغيب في شحنك",43,"ك",1,0],["غلائلُهُ الأَمساحُ يأكلنَ جلدَهُ","وحليتُهُ أقياد سُخطٍ وأغلالُ",44,"ل",1,0],["غلبتهُ خلاعةً ومُجوناً","يا لقوم للشيخة المِغْليم",45,"م",1,0],["غلبتْ على ألبابهم شهواتُهم","فأرتهمُ ما لا يزَينُ يزين",46,"ن",1,0],["غَلَبَ اليَأسُ عَلَيهِم فَهُم مُستَسلِمونا","وَإِذا بِالبابِ مَكتوبٌ عَلَيهِ لَستُ أَدري",47,"ي",1,0],["غَلِطَ القائِلُ إِنَّ الخَمرَ بِنتُ الخابِيَه","فَهيَ قَبلَ الزِقِّ كانَت في عُروقِ الدالِيَه",47,"ه",1,0],["غَلَبَتني عَواطِفُ الصَحبِ حَتّى","صُرتُ في حاجَةٍ إِلى تُرجُمانِ",48,"ن",1,0],["غَليظَةً كَالحَديدِ الصَلبِ صارِمَةً","كَالمَوتِ تَبَقّى لِأَدهارٍ وَأَزمانِ",49,"ن",1,0],["غَلِطَ القائِلُ إِنّا خالِدونَ","كُلُّنا بَعدَ الرَدى هَيُّ اِبنُ بَي",50,"ي",1,1],["غَلَبَ الوَجدُ فَلا أَكتُمُهُ","إِنَّما أَكتُمُ ما يَنكَتِمُ",51,"م",1,0],["غُلاميَةٌ جاءَت وَقَد جَعَلَ الدُجى","لِخاتَمَ فيها فَصٌّ غاليَة خَطّا",52,"ط",2,1],["غَلَبَ الكَرى وَدَنَت مَطايا الراحِ","وَاِشتَقنَ شَدوَ حُداتها النُصاحِ",53,"ح",1,1],["غلت بالامس حافظا وبشوقي","اليوم انشبت الظفر للالحاق",54,"ق",1,0],["غلت فما ابدت اقل تذمر","فكأنما طابت لها اغلالها",55,"ل",3,0],["غلبوا عليها الراشدين وضرجوا","أم الكتاب بجبهة السَّجاد",56,"د",1,0],["غَلَبَ الحَياةَ فَتىً يَسُدُّ مَكانَها","بِالذِكرِ فَهوَ لَها بَديلٌ وافي",57,"ي",1,0],["غَلَبَ المَوجَ عَلى قُوَّتِهِ","فَكَأَنَّ المَوجَ مِن جُندِ الزَمان",58,"ن",1,0],["غِلمانُ قَصرِك في الرِكا","بِ يُناوِلونَ وَيَطرَدون",59,"ن",1,0],["غُلِبَ النَسرُ عَلى دَولَتِهِ","وَتَنَحّى لَكِ عَن عَرشِ الهَواء",60,"ا",2,0],["غُلِبوا عَلى أَعصابِهِم فَتَوَهَّموا","أَوهامَ مَغلوبٍ عَلى أَعصابِهِ",61,"ب",2,0],["غَلِتَ الَّذي حَسَبَ العُشورَ بِاّيَةٍ","تَرتيلُكَ السوراتِ مِن آياتِها",62,"ت",3,0],["غلَبَ التبَسُّمُ يومَ ماتَ تفجُّعي","وغدا به رأي الحمامِ سديدا",63,"د",2,0],["غلب العبيدُ على مقرِّ سريرِكم","والعبدُ خَوَّارُ القناةِ مهينُ",64,"ن",1,0],["غلائِلُه أدراعُه وكؤوسُهُ","مخوف عِداهُ والنجيعُ شَمولُ",65,"ل",1,0],["غَلَّسَ الشَيبُ أَو تَعَجَّلَ وِردَه","وَاِستَعارَ الشَبابَ مَن لا يَرُ