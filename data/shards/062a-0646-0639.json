{"poems":[[29,"تنعى النعاة أمير المؤمنين لنا","https://www.aldiwan.net/poem5780.html","البسيط"],[30,"وبيض كأرآم الصريم ادريتها","https://www.aldiwan.net/poem5158.html","الطويل"],[46,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[48,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116962","الطويل"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[30,"وبيض كأرآم الصريم ادريتها","https://www.poetsgate.com/ViewPoem.aspx?id=21955",""],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[230,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[336,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[449,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[484,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[543,"دعوني فإني لا أطيق التكلما","https://www.aldiwan.net/poem47949.html","عموديه"],[545,"لما أتاني وأهلي من طياتهم","https://www.aldiwan.net/poem56648.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126700","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126677","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126750","الكامل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138856",""],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100582","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59670","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119893","المنسرح"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16999","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138064",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65076","الوافر"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128273","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136214","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109102","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115916","المنسرح"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21666","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79821","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80014","الكامل"],[1555,"","https://poetry.dctabudhabi.ae/diwan/poem/105605","الرمل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113959","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128071","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95412","المديد"],[2001,"","https://poetry.dctabudhabi.ae/diwan/poem/111184","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77225","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144754","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88646","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88647","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93659","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93356","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201764","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132764","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100178","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62750","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48346","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92068","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136014","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35593","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97094","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81713","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117215","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120498","الطويل"],[4767,"نعي الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=89357",""],[4767,"حسن الخاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178993",""],[4767,"نار الأسَى","https://www.poetsgate.com/ViewPoem.aspx?id=187546",""],[4771,"ناعى أبي جعفر القاضي دَعوتَ إلى ل","https://www.poetsgate.com/ViewPoem.aspx?id=106573",""],[4830,"هو نفْسُ مُحمّد","https://www.poetsgate.com/ViewPoem.aspx?id=204707",""],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[4968,"أمّاه","https://www.poetsgate.com/ViewPoem.aspx?id=206754",""],[4994,"سفر في تفاصيل الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=209153",""],[460,"بَخِلَتْ رَقاشِ بوُدِّها ونَوالِها","https://www.poetsgate.com/ViewPoem.aspx?id=22213",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5186,"حسبك الجهد بذله لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=156491",""],[5186,"يا بروحي لاعبات التنس","https://www.poetsgate.com/ViewPoem.aspx?id=156500",""],[5409,"وطني لأجلك قد عدمت قراري","https://www.poetsgate.com/ViewPoem.aspx?id=155272",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5419,"خيرٌ وأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=39918",""],[5461,"أجاذبك الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=30030",""],[5725,"ياقلب رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=178058",""],[5837,"وجه الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=181759",""],[5956,"أنا زارعُ الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=194461",""],[6213,"قائمة الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76279&r=&rc=36",""],[406,"أين بغداد عنا ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=925&r=&rc=55",""]],"verses":[["تَنعى النُعاةُ أَميرَ المُؤمِنينَ لَنا","يا خَيرَ مَن حَجَّ بَيتَ اللَهِ وَاِعتَمَرا",0,"ر",2,1],["تَنَعَّلنَ أَطرافَ الرِياطِ وَواءَلَت","مَخافَةَ سَهلِ الأَرضِ أَن يَتَقَفَّرا",1,"ر",2,0],["تَنعى مُحَمَّداً الثاوي رِماحُهُمُ","وَيَسفَحونَ عَلَيهِ عَبرَةً نَشَجا",2,"ج",2,0],["تَنَعَّمَتِ الخَوافِضُ في مَقامٍ","فَكَيفَ الناعِماتُ إِذا رُمِسنَه",3,"ن",2,0],["تُنْعَى عَلَى الشُّعَراءِ أَوْهَامٌ لَهَا","خِدَعُ البَهارِجِ فِي طِلاَءِ مُحالِ",4,"ل",1,0],["تنَعَّم قومٌ بالعبادَةِ والتُقى","ألَذَّ النعيم لا اللذاذَةَ بالخمرِ",5,"ر",1,1],["تنعم في ميراثهم غير كاسب","وعما قليل يقعص المتنعم",6,"م",1,0],["تنعى ابن يوسف فتح السالكين وخ","تم الواصلين مربي الأنفس الكمل",7,"ل",1,0],["تَنَعَّلْنَ أطْرَفَ الرِّيَاطِ، وَواءَلَتْ","مَخافَةَ سَهْلِ الأرْضِ أن يَتقفّرَا",8,"ر",2,0],["تنعَّمْ تَنَعَّمْ أيها الربْعُ إنما","يُنَعَّمُ عيشاً من يراك تنعُّما",9,"م",2,0],["تَنعى إِلى القَومِ مَن ظَنّوا بِمَقدَمَهِ","وَالبَغيُ مَصرَعُهُ أَن يَملِكوا حَلَبا",10,"ب",2,0],["تَنَعَّمتَ فيها وَخَلَّفتَني","لَدى منزِلٍ بَرقهُ خُلَّبُ",11,"ب",1,0],["تَنَعَى امرأً لاَ تَغُبَّ الحيَّ جَفْنَتُهُ","إذا الكَوَاكِبُ خَوّى نَوْأَها المَطَرُ",12,"ر",1,0],["تنعق فيها الغربان جائعة","والوحش كادت تسير في الطرق",13,"ق",1,0],["تنعي على آمالها بسعالها","والدمع منها لؤلؤ منثور",14,"ر",1,0],["تنعَّمتُ في رَبعٍ بديعٍ مَناظراً","وما تَمَّمَ المولى إلىَّ التَّنَعُّما",15,"م",2,0],["تَنعى الإِمامَ وَخَيرَ الناسِ كُلِّهُمُ","أَخنَت عَلَيهِ يَدُ الجَعديِّ مَروانا",16,"ن",2,0],["تنعي خَطيباً لقد طابت أرومته","كريم أصلٍ له من هاشم نسبُ",17,"ب",1,0],["تنعي الزعيم وأين مثل زعيمها","مَن كان عنهم كاشفاً ضرّاءها",18,"ا",3,0],["تَنعي أباها الندب كافلها","وغياثها وهو الأب البرُّ",19,"ر",1,0],["تنعاكَ أفراس المغار تعطّلت","وأضرّ بعدكَ جسمَهنَّ جَمام",20,"م",1,0],["تنعى عليك فواطم لك ثُكَّلٌ","أودى بها داء ألمَّ عُقام",20,"م",1,0],["