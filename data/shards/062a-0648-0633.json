etsgate.com/ViewPoem.aspx?id=108054",""],[5145,"نسيم الصبا بادر بهبتك الفجرا","https://www.poetsgate.com/ViewPoem.aspx?id=108203",""],[5213,"أزف لك التهاني باسمات","https://www.poetsgate.com/ViewPoem.aspx?id=170397",""],[5246,"نصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187036",""],[5266,"لُبُّ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=210745",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5376,"بأيِّ الذنبِ ذاك الطفلُ يُقْتلْ","https://www.poetsgate.com/ViewPoem.aspx?id=196896",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5411,"مرامي الأناة","https://www.poetsgate.com/ViewPoem.aspx?id=187223",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5472,"توسطت من قومك الا كرمي","https://www.poetsgate.com/ViewPoem.aspx?id=200471",""],[5567,"حروفي تجلت","https://www.poetsgate.com/ViewPoem.aspx?id=10896",""],[5574,"أنا والصبْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206020",""],[5595,"سَلاماً أيّها الوطنُ","https://www.poetsgate.com/ViewPoem.aspx?id=144627",""],[5749,"قبل عذري","https://www.poetsgate.com/ViewPoem.aspx?id=170290",""],[5753,"من بريدِ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=212286",""],[6093,"سَيْرٌ رِيَاضِي","https://www.poetsgate.com/ViewPoem.aspx?id=187112",""],[5567,"وسواس الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81769&r=&rc=37",""],[6355,"الدمعة المشتعلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66669&r=&rc=129",""]],"verses":[["تَوَسَّدَ فَوْدي وَفدُهُ قَبلَ حينِهِ","وَذَلِكَ زَورٌ لَيسَ يُخلِفُ مَوعِدا",0,"د",2,0],["تَوَسَّدَ مِنْهَا التُرْبَ أَيُّ خَلاَئِفٍ","بِهِمْ دِينُكَ الأَرْضَى اسْتَقَلَّتْ رُسُومُهُ",1,"م",2,0],["توسّدَ أضغاثَ الرَّياحينِ وانْثَنى","يغِطُّ غَطيطَ الطِّفْلِ منْ فوْقِ مَهْدِهِ",2,"د",2,0],["تَوَسَّعتَ لِلحاجاتِ يا صَخرُ كُلِّها","فَحامَ إِلى مَعروفِكَ المُتَنَسَّمِ",3,"م",1,0],["تَوَسَّطَتِ النَّدِيَّ عَرُوسُ شِعْرٍ","تَنَالُ مِنَ القُلُوبِ بِلاَ تَجَنِّي",4,"ن",2,0],["تَوَسَّع قَليلاً أَو يَكُن ثَمَّ حَسبُن","وَموقِدُها الباري أَعَفُّ وَأَحمَدُ",5,"د",1,0],["توسعون الناس تنفي","ساً وأهل الظلم خنقا",6,"ق",2,0],["تَوَسَّدَ هَذا قائِمَ السَيفِ يَتَّقي","وَهَذا عَلى أَحلامِهِ يَتَحَسَّبُ",7,"ب",1,0],["تَوَسَّطَ أَوساطَ الأُمورِ بِنَفسِهِ","وَنالَ نَواحيها الأَقاصي تَعاهُدُه",8,"د",2,0],["تَوَسَّطَ الدَهرَ أَحوالاً فَلا صِغَرٌ","عَنِ الخُطوبِ الَّتي تَعرو وَلا كِبَرُ",9,"ر",1,0],["تَوَسَّل بِالنَبِي في كُلِ خَطبٍ","يَهونُ إِذا تُوُسِّلَ بِالنَبيِّ",10,"ي",1,0],["تَوَسَّع في حَلالِ اللَهِ أَكلاً","وَإِلّا لَم تَجِد لِلعَيشِ طَعما",11,"م",2,0],["تَوَسَّط كُلَّ رَأيٍ أَنتَ فيهِ","وَخُذ بِمَجامِعِ الطَرَفَينِ مِنهُ",12,"ه",1,0],["تَوَسَّدَ في الفَلا أَيدي المَطايا","وَقَدَّ مِنَ الصَعيدِ لَهُ حَشايا",13,"ا",3,1],["تَوَسَّطتَ مِن أَبناءِ ساسانَ هَضبَةً","لَها الكَنَفُ المَحلولُ وَالسَنَدُ النَهدُ",14,"د",1,0],["تَوسَّطَت بَين مَعشُوقٍ وعَاشِقِهِ","بِمَوعِدِ الوصلِ فَأحمَرَّت من الخَجَلِ",15,"ل",1,0],["تَوَسَّط بِنا سائِراتِ الرِفاقِ","لَعَلَّ رَكائِبَنا تَسلَمُ",16,"م",1,0],["تَوَسَّدَ أَلْحِي العِيسِ أَجْنِحَةَ القَطَا","ومَا في أدَاوَى القَوْمِ خِفُّ صَلاَصِلُهْ",17,"ل",2,0],["توسَّدَ رَمْلَتَهُ شاخِصاً","إليَّ وما كُنتُ بالخائرِ",18,"ر",1,0],["توسَّدتْ صخرةَ الآباد والتفتتْ","ترعى سفائنُ من راحوا ومن جاؤُوا",19,"ا",1,0],["تَوَسَّدَ أَحجارَ المَهامِهِ وَالقَفرِ","وَماتَ جَريحَ القَلبِ مُندَمِلَ الصَدرِ",20,"ر",1,1],["تَوَسَّمْتُ فِيهِ الْخَيْرَ قَبْلَ لِقَائِهِ","وَأَحْمَدْتُ مِنْهُ الْخُبْرَ بَعْدَ التَّعَرُّفِ",21,"ف",1,0],["تَوَسَّدُ هَامَاتٌ لَهُنَّ وَسَائِداً","مِنَ الرِّيشِ فِيهِ طَائِلٌ وَشَكِيرُ",22,"ر",1,0],["تَوَسَّطْتُهُ وَالْخَيْلُ بِالْخَيْلِ تَلْتَقِي","وَبِيضُ الظُّبَا في الْهَامِ تَبْدُو وَتَغْرُبُ",23,"ب",1,0],["تَوَسَّع قَليلاً أَو يَكُن ثَمَّ حَسبُنا","وَموقِدُها الباري أَعَفُّ وَأَحمَدُ",24,"د",1,0],["توسَّطَتِ البحرَ حتَّى نأى","على من أقامَ بها السَّاحلُ",25,"ل",1,0],["توسعه مريرة ويتقي","من جدها ما تبقى من الردى",26,"ا",1,0],["تَوَسَّلْ بالنَّبِيِّ فَكُلّ خَطْبٍ","يَهُونُ إِذا تُوُسِّلَ بالنَّبِيِّ",27,"ي",1,0],["توسي الجروحُ وليس يوسي شاعرٌ","بصميم إحساساته مجروح",28,"ح",1,0],["توسعه مريرة ويتقى","من جدها ما يتقى من الردى",29,"ا",1,0],["توسل يا أبا العلمين عند النبي","ي بنيل مأربي القصي",30,"ي",1,1],["توسل بأولاد الرسول فإنهم","أمان لأهل الأرض من صدمة العمى",31,"م",2,1],["توسلت بالزهرا إليك وآلهاً","قمارك بأسرار القبول ندائبا",32,"ب",2,0],["توسل إلى المولى فجاهك لم يخب","وقم بمرادي واكفني شر خواني",33,"ن",2,0],["توسُّدي براثنَ الحيَّاتِ تضطربُ","أم افتراشى جَمْراً وهو يلتهبُ",34,"ب",1,1],["توسّد بمهد الأمن قد مرّت النوى","وزال لغوبُ السير من مشهد الثوى",35,"و",2,1],["توسع الخرق عن رقع يحيط به","فما يغطيه إلا العفو والكرم",36,"م",1,0],["توسّدَ حجرَ الأكرِمينَ أُولي النُّهى","وألقَم ثديَ المُحصّناتِ الغَوافِلِ",37,"ل",1,0],["تَوَسَّدَ فى اليَمِينِ زِمَامَ حَرفٍ","كَنازِ اللَّحمش اَيِّدَةِ الفُصُوصِ",38,"ص",1,0],["توسَّعَ دَهْرٌ لم يَضق بك وُسْعُه","على أَنّ أهلَ الذكر دونك والدهر",39,"ر",1,1],["تَوَسَّلْ به في كلِّ ما أنتَ طالبٌ","فكم نلتُ منهُ بالتوسُّلِ مطلبا",40,"ب",2,0],["تَوَسَّلْ لِي إِلَى خَيْرِ الْعِبَادِ","مُرِيحِ الْخَلْقَ فِي يَوْمِ الْمَعَادِ",41,"د",1,0],["تَوَسَّلْ لِي لِخَلاَّقِ الْبَرَايَا","بِحَقِّ الْمُصْطَفَى أَزْكَى نَبِيِّ",42,"ي",1,0],["توسّلت بالبكريّ شمسِ الحقيقةِ","إمامِ الهدى يهدي لأهدى طريقةِ",43,"ه",1,1],["توسّلاً بصاحب الوسيلةْ","ذي الحوض واللواء والفضيلةْ",44,"ه",1,0],["تَوَسَّلتُ فيهِ عِندَهُ وَبِجاهِهِ","تَشَفَّعتُ لِلمَولى بِخَيرِ المَوالِيا",45,"ي",2,0],["توسّلتُ بالقربى إليه فلم تضع","لدى العربيّ الهاشميّ شفاعتي",46,"ي",1,0],["توسل بي قربا اليك لعله","عليك احتسابا في القراءة يبتدى",47,"د",2,0],["توسل بي برّ اليك صو يحب","لِيَمحو كتابا بالذنوب مسودا",48,"د",2,0],["تَوَسَّطْتَ مِنْهُمْ بَيْتَ فَخْرٍ عِمادُهُ","صُدُورُ الْقَنا وَالْمُرْهَفاتُ الذَوالِقُ",49,"ق",1,0],["توسد بعد 