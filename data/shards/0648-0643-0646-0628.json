{"poems":[[79,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[88,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[26,"تالله يبقى على الأيام مبتقل","https://www.aldiwan.net/poem24086.html","البسيط"],[72,"مولاي كن لي وحدي","https://www.aldiwan.net/poem42934.html","المجتث"],[42,"لمن طلل بالنعف نعف وقير","https://www.aldiwan.net/poem42313.html","الطويل"],[79,"قفا فاسألا في ساحة الأجدع الفرد","https://www.poetsgate.com/ViewPoem.aspx?id=33812",""],[92,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[264,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[309,"إذا شئت أن تحيا سعيدا مدى العمر","https://www.aldiwan.net/poem16761.html","الطويل"],[309,"العبد قد بناه","https://www.aldiwan.net/poem16835.html","مجزوء الرجز"],[314,"وكن بشا كريما ذا انبساط","https://www.aldiwan.net/poem50214.html","الوافر"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[396,"عن الناس لا تسأل ولا عن فعالهم","https://www.aldiwan.net/poem54512.html","عموديه"],[396,"محمد إن شئت تلحق بالرجال","https://www.aldiwan.net/poem54591.html","عموديه"],[447,"وهبتك النصح لو طاوعت من نصحا","https://www.aldiwan.net/poem14423.html","البسيط"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[511,"تأن في الأمر لا تكن عجلا","https://www.aldiwan.net/poem2445.html","المنسرح"],[534,"من ظن في بعمته أنها","https://www.aldiwan.net/poem37531.html","السريع"],[563,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[563,"إمامنا هو الإمام الأعظم","https://www.aldiwan.net/poem33865.html","الرجز"],[563,"ظهرت يا نور والسوى عدم","https://www.aldiwan.net/poem34091.html","المنسرح"],[563,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"],[563,"صفا ماء الحقيقة فهو صافي","https://www.aldiwan.net/poem34351.html","الوافر"],[563,"أنا البرق اللموع وأنت أيضا","https://www.aldiwan.net/poem34416.html","الوافر"],[563,"ونحن أهل الصفا لا نقبل الكدرا","https://www.aldiwan.net/poem34494.html","البسيط"],[563,"هذا الوجود وهذا الواحد الأحد","https://www.aldiwan.net/poem34575.html","البسيط"],[563,"بلاء الأنبياء هو البلاء","https://www.aldiwan.net/poem35089.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37799","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62531","البسيط"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119284","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96721","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112957","المجتث"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137863",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122018","الطويل"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130662","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87865","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49543","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53047","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27952","المجتث"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27828","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27671","السريع"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102533","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130859",""],[2822,"","https://poetry.dctabudhabi.ae/diwan/poem/131387","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74183","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3082,"","https://poetry.dctabudhabi.ae/diwan/poem/202457","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121387","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62854","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91090","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117927","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118016","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114296","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135339","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103027","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77128","الوافر"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138844",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83189","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58063","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4955,"خفيف الظل كن دوما","https://www.poetsgate.com/ViewPoem.aspx?id=202494",""],[4955,"مصير الحزن أن يرحل","https://www.poetsgate.com/ViewPoem.aspx?id=203790",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5282,"رفقاً بنبع الحنان","https://www.poetsgate.com/ViewPoem.aspx?id=213983",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"أهاجك رسم بالديار الدوائر","https://www.poetsgate.com/ViewPoem.aspx?id=128849",""],[5459,"هذي الحشاشة تذوي","https://www.poetsgate.com/ViewPoem.aspx?id=190947",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5768,"أَخَاكَ .. أَخَاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=215592",""],[5768,"سُلُوكُ الْمَحَجَّةِ إلَى عَشْرِ ذِي الْحِجَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=215594",""],[5791,"تعويذة حبر داخن ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208589",""],[5309,"عاشق العلم غني ما اذخر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573755",""],[2220,"يا لائمي في مقالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11585&r=&rc=459",""],[2220,"إذا بدا علمُ الأحوالِ يسبقُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11573&r=&rc=447",""]],"verses":[["وكُنْ بكِتابِ اللهِ تأتَمُّ دائِماً","هوَ الحقُّ والسّورُ المُبينُ الذي يَهْدي",0,"د",2,0],["وَكُن بِأَبيكَ لِاِبنِ أَخيكَ عَوناً","فَأَنتَ بِكَفِّهِ نِعمَ الحُسامُ",1,"م",1,0],["وَكُنَّ بِالرَوضِ لا يُرغَمنَ واحِدَةً","مِن عَيشِهِنَّ وَلا يَدرينَ كَيفَ غَدُ",2,"د",1,0],["وَكُن بِقَلبِكَ عِندي","فَإِنَّ قَلبِيَ عِندَك",3,"ك",1,0],["وَكُنَّ بِهِ في صيفَةِ الحَيِّ كُلِّها","إِلى سَرَبٍ في رَوضَةٍ وَغَديرِ",4,"ر",1,0],["وكن بكتاب الله تأتم دائما","هو الحق والنور المبين الذي يهدي",5,"د",2,0],["وكُنْ بالصَّمتِ أبلغَ منك نُطْقاً","وأورى في مُحاجَجةٍ زِنادا",6,"د",2,0],["وكُنَّ بريقاً في عُيوني ، وهِزَّةً","بجسمي ، وبُقْيا رَجفَةٍ في أصابعي",7,"ع",2,0],["وكن بعُرَا الحقِّ مستمسِكا","أَلاَ إنها غيرُ ذات انفصام",8,"م",1,0],["وكن بالخوف راجي العفو فضلاً","وغفراناً فإنّ الله غافر",9,"ر",1,0],["وَكُن باذِلاً لِلفَضلِ سَماحاً وَلا تَخَف","مِنَ اللَهِ إِقتاراً وَلا تَخشَ مِن فَقرِ",10,"ر",1,0],["وكن به لطيفاً","واغفر له خطاه",11,"ا",2,0],["وَكُن بَشّاً كَريماً ذا اِنبِساطٍ","وَفيمَن يَرتَجيكَ جَميلَ رَأيِ",12,"ا",2,1],["وَكُن بِرَفضِ الشُحِّ مُستَنَّ السَخا","بِالنَفسِ تَلقَ فيهِ رِبحَ المُتَّجَر",13,"ر",1,0],["وكن بقضاء الله ربك راضيا","تفوز برضوان بدنيا وآجل",14,"ل",1,0],["وكن بربك كثير الاشتغال","ولا تعلق همومك بالعبيد",15,"د",1,0],["وكن بأَهل التُقى والعلم مقترناً","وَعن آلي الجهل صاري الحبل منتوِحا",16,"ح",2,0],["وكنْ بذاك من ضمان الله لي","في أن تعيش وضماني مُوقِنا",17,"ن",2,0],["وكُن بحبلِ الإله مُعتَصِماً","تَأَمَن به بَغيَ كلَّ من كادا",18,"د",2,0],["وكُنْ بِهِ مُسْتَمْسِكاً إِنْ دجا","لَيْلُ خُطُوبٍ حالِكاتِ الخِضابْ",19,"ب",1,0],["وكن به له خفياً ظاهراً","ولا تكن بجهله مغبونا",20,"ن",2,0],["وكن بشرع الله عاملاً ولا","تعرض عن الشرع ودع ما يحرم",21,"م",1,0],["وكن بها لا بغيرها ولها","لا لسواها يزول منبهم",22,"م",1,0],["وكن به طاهراً نظيفاً","إن قمت يا أيها المصلي",23,"ل",2,0],["وكن بالله أنت تكن قوياً","وجانب غفلة القوم الضعاف",24,"ف",1,0],["وكن بالأمر لا بالخلق تعرف","لك الأمر الطويل لك العريضا",25,"ض",2,0],["وكن بأوصافنا في القرب متصفاً","تنل مرادك منا كيف منك جرى",26,"ر",2,0],["وكن بلا أنت كشفاً بالوجود ولا","تكن بنفسك كن ظلاً له عمد",27,"د",1,0],["وكن بالإنفراد سليم صدر","لأن مصاحبات الناس داء",28,"ا",2,0],["وَكُنْ بازِياً يَصطادُ كُلَّ فَضيلَةٍ","وَكُنْ رَجُلاً تَخشاهُ مِن خَوفِها الأُسْدُ",29,"د",1,0],["وكن بحجك للرستاق معتمراً","فإنها كعبة المعروف والكرم",30,"م",1,0],["وكن بالسحيق حليف الرحيق","وهن للرشيق اذا ما شرد",31,"د",1,0],["وَكُن بالندبِ حمير وال","فَتى كهلانَ مُعتَصما",32,"م",2,0],["وكن به مستغيثا","ترقى الكمال وتنجح",33,"ح",1,0],["وكن باضطرار وافتقار مؤمما","وإن شئت قرب اللّه فالعلم قربة",34,"ه",1,0],["وكن بالرزق مهتما ولكن","على نهج التخفظ والوقايه",35,"ا",3,0],["وَكُنْ بَاسِطاً خَدًّا لَهُ فِي طَرِيقِهِ","وَاقْسِمْ عَلَى الأمْوَاجِ تَلْقَاهُ سُجَّدَا",36,"د",2,0],["وكن بني بحسن الخلق متصفاً","وقابل الدرس في جدو في جلد",37,"د",1,0],["وَكُن بِكُلٍّ وَحيداً بارِعا صَمَداً","إِلَيكَ يُصمَدُ في عُرفٍ وَمَسنودِ",38,"د",1,0],["وكُن بهمُ أَدنى إلى الرشد منهمُ","تكْن هذه إحدى عُلاك العجائب",39,"ب",1,0],["وَكُن بِمراة الفكر للعقل ناظِراً","يَبنِ لَكَ أَن الناس طُرّاً ثَعالب",40,"ب",1,0],["وكن بسعي غياث الدين مقتدياً","وقد بلغت مدى الآمال عن كَثَب",41,"ب",1,0],["وكن به من لدنه","تحوز علماً ورزقا",42,"ق",2,0],["وكن بكتابِ الله معتصماً ولا","تحرِّف كلامَ الله عن نصِّه إذا",43,"ذ",2,0],["وكن بهم نائباً عنهم فلبسهمُ","غضٌّ جيد ولبسي دونهم خَلَق",44,"ق",1,0],["وكن بالرضا مستمسكاً فلربما","عصاك أمرؤ فاقبله إن جاء بالعذر",45,"ر",1,0],["وكن بالفخر في عدلٍ وحلمٍ","واصلاحٍ واحسانٍ ويسر",46,"ر",1,0],["وكن بي حفيا في حياتيَ ولأكُن","لديك شفيعا ما شفعتُ مشفعا",47,"ع",2,0],["وكن بالجواري المنشآت وسيرها","خبيرا متى هبت رياح السرى فاسر",48,"ر",1,0],["وَكُن بِالأَجر مُغتبطاً معافى","وَإِن أَصبَحت في خَطبٍ جَسيم",49,"م",1,0],["وَكُن بسنة خَير الخَلق معتصماً","وَإِن هُما محضاك النصح فاتهم",50,"م",1,0],["وكن بي حفيا يوم تقضي منيتي","رؤوفاً رحيماً في القيامة والحشر",51,"ر",1,0],["وكن بالذي قد خطّ باللوحِ راضياً","فلا مَهرَبٌ مما قضاهُ وخطّه",52,"ط",2,0],["وكن برزخا واحذر من الميل دائما","ولازم مقام الحد في كل عثرة",53,"ه",1,0],["وكن بالإلاه معتصما بقلبك","وقل يا سلام سلم من كل فتنة",53,"ه",1,0],["وكنَّ بِمُعْضِلاتِكَ كلَّ يومٍ","على الأَعداءِ تجلبها الجَلُوبُ",54,"ب",1,0],["وَكُن بربك فيما ناب ذا ثقةٍ","وَارضَ الَّذي قدّر الرَحمن في القدم",55,"م",1,0],["وكن بحبل الله مستعصماً","وثق بما عوّدت من نصره",56,"ر",2,0],["وكن باليسير قانعات","تظفرن يوم الحشر بالجنات",57,"ت",1,0],["وكُنْ بِرَسُولِ اللهِ مُقْتَدِياً فَقَدْ","سَرَى لمْ يَزِغْ طَرْفٌ بِمَا لاَحَ فِي السُّبلِ",58,"ل",1,0],["وكن بي رؤوفاً يا رؤوف ونجني","من الغضب المذموم في النفس والغير",59,"ر",1,0],["وكن باسط النُّعمى علينا تفضُّلا","فُرادى وإن كنا إلهي بمجمعِ",60,"ع",1,0],["وكن بنادي العلى والعز ممتنعا","تمنع ولا تخش من سلطان سلطان",61,"ن",1,0],["وَكُن بِاليَمَن قارِنَه دَواماً","فَيَبدو مِنهُ لِلخَيراتِ سَبق",62,"ق",1,0],["وكن باذلاً ما اسطعت في الله موقناً","بحسن الجزا فاجهد ولا تخش فاقره",63,"ر",2,0],["وَكن بَصيراً بِأَحوالِ الزَمانِ فَكم","تَلقى بِها حكماً تجلو البَصيراتِ",64,"ت",1,0],["وَكُن بِمَن عَلَّمتَه رَؤوفا","لِكَي يَرى مِنكَ أَبَاً عَطُوفا",65,"ف",2,0],["وكنْ بعظاتِ الدهر مُتّعِظاً إذا","غداةً يُرِيكَ الدهرُ منه غضنفرا",66,"ر",2,0],["وَكُن بِمَقاماتِ الرِجالِ بِظاهِرٍ","وَلا تَكُ يَوماً حذوَ كُلٍّ بِفِكرَةِ",67,"ه",1,0],["وَكُن بِاليَقينِ الحَقِّ لِلخَلقِ جاحِداً","وَجَمعَكَ صِلهُ إِنَّ فَرقَكَ قاطِعُ",68,"ع",1,0],["وكن بالله معتصماً وسَلْه","عوائدَ برّه فيها يجود",69,"د",1,0],["وكن باللينِ مُتَّصفًا","لطيفًا ليسَ بالقاسي",70,"س",2,0],["وكن بالصَّبرِ مُتَّصِفًا","وعن مولاكَ لاتغفلْ",71,"ل",1,0],["وكن بي حفيا يا رقيب فأنت يا","مجيب الذي إن يدعه العبد لباه",72,"ا",2,0],["وكن بي رؤوفاً يا رؤوف فمن يكن","رؤوفاً به كانت جنانك مأواه",72,"ا",2,0],["وكن باذلا أبداً للندى","ولو كان في غير أصحابه",73,"ب",2,0],["وكن بالودِ بَسْام المُحيا","عَطُوفاً مُكثرا لهم اللقاءَ",74,"ا",2,0],["وكن بربك لا بالناس معتصما","كفى بربك رزاقا وغفارا",75,"ر",2,0],["وكن باذلاً للجد والجهد طالباً","وسل ربك التثبيت أي موحد",76,"د",1,0],["وكن باذلاً للجسد والجهد قائماً","بنصرة دين الله عن كل كائد",77,"د",1,0],["وكن باذلاً للجد في طلب الهدى","من العلم إن العلم خير الذخائر",78,"ر",1,0],["وَ كُنْ بِخَيْرِ الْوَرَى مَا عِشْتَ مُقْتَدِيًا","فَبِاتِّبَاعِ خُطَاهُ يُؤْمَنُ الزَّلَلُ",79,"ل",1,0],["وكن بعلومك مستظهرا","فأنفع علمك مستظهره",80,"ر",2,0],["وَكُنْ بِالْعَدْلِ قَوَّامًا","وَلَا تَقْرَبْ مِنَ الْخَسْفِ",81,"ف",1,0],["وَكُنْ بَرًّا بِوَالِدَةٍ","وَوَالِدُكُمْ لَهُ الشُّكْرُ",82,"ر",1,0],["وكن بكاءً عظيماً وقت تكتبها","قصيدةً عنكما من حيث لا تدري",83,"ر",2,0],["وَكَنَبتِ الاَرضِ رَوّاهُ المَطَر","نَفَعَ العالِمُ أَجناسَ البَشَر",84,"ر",1,0],["وكنْ بهِ من لدنِه","تحورُ علماً ورزقا",85,"ق",2,0],["وكنْ بهم نائباً عنهمُ فلبهمُ","غضٌّ جديدٌ ولبسي دونهمْ خلقُ",86,"ق",1,0]]}