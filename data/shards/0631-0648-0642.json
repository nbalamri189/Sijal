{"poems":[[371,"عد العتاب فما أعدت عتابا","https://www.aldiwan.net/poem17313.html","الكامل"],[505,"روق كؤوسك هذا الوقت قد راق","https://www.aldiwan.net/poem37939.html","البسيط"],[556,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122816","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122616","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122569","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132997","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117929","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85055","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32468","الخفيف"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105119","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94607","الكامل"],[5106,"هذا حَبيبي بِوجهِ الفَجرِ ينتظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=139107",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""]],"verses":[["رَوَّقتُ فيكُم لِلمَدائِحِ خَمرَةً","فَجَزَيتُموني بِالوُعودِ حَبابا",0,"ب",2,0],["روِّقْ كُؤوسَكَ هذا الوقتُ قد راقَ","جَلا من الغيبِ لو حقَّقْتَ إطْلاقَا",1,"ق",2,1],["روّقته الأيّامُ والخُلُقٌ الأخْ","لَقُ فينا مُمَنَّعٌ محجوبُ",2,"ب",1,0],["رَوقةٌ يَقصِمُ الخَلاخيلَ ساقا","ها وَيشكُو أذراعَها دُملجاها",3,"ا",3,0],["رَوقَةٌ كالقضيبِ تعطِفُها الرّيحُ","يَميناً في مَرِّها ويَسارا",4,"ر",2,0],["رَوقَةٌ للقَضيبِ والحِقفُ والرُّمَّ","انِ مِنها عِطفٌ ورِدفٌ ونَهد",5,"د",1,0],["روقه بنشره ريح الصبا","فانحرف القَلب إِلَيهِ وَصَبا",6,"ب",2,0],["روق الكَأس وَعجل بِالندامى","إِنَّني أَصبَحت مَملوءاً غَراما",7,"م",2,1],["روقت نَفتضح في عشقِ وجهك أنَّي","رأيت أفتضاحَ العاشقين تجمُّلا",8,"ل",2,0],["روق الخمرة صرفاً وأدر","واسقنيها في الظلام المعتكر",9,"ر",1,1],["روق القول كم تثير غرامي","إنما أنت بالثنا تمتحني",10,"ن",2,0],["روقُ أَي روقُ كَيفَ فيكِ أَقولُ","صارَ بَينا وَردٌ وَرَملٌ وَنيلُ",11,"ل",1,1],["روقه للقضيب والورد وال","سلسال منه قد وخد وثغر",12,"ر",1,0],["روَّقت قلباً بالحديث معرِّضاً","عن حفظِ عهدٍ ليس ذاك بمختفي",13,"ف",2,0],["رَوْقَاءُ قَدْ سَلِمَتْ مِنْ كُلِّ مَنْقَصَةً","كَالسُّوْرَةِ اكْتَمَلَتْ بِالحُسْنِ تَعْتَصِمُ",14,"م",1,0],["روَّقتَ نهر العلم لذَّ لناهلٍٍ","أسقيتَ واردة العلوم النيلا",15,"ل",2,0]]}