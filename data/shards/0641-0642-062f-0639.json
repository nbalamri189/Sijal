//www.poetsgate.com/ViewPoem.aspx?id=160417",""],[5057,"إلى عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207359",""],[585,"سل الفلك الدوار ما للكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=161941",""],[5077,"إلى أعداء النّجاح مع التّحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=37250",""],[5106,"أُسَهَّدُ فِيْ تَذَكُّرِهِ وَأَرْضَى ..","https://www.poetsgate.com/ViewPoem.aspx?id=137167",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[5246,"نظم القريض يسليني عن الكسل","https://www.poetsgate.com/ViewPoem.aspx?id=187059",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"ألا ليت شعري هل لماضي زماننا","https://www.poetsgate.com/ViewPoem.aspx?id=128855",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5356,"همسُ اشتياقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204474",""],[5387,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=53541",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5442,"لا تسأمي يا ناق طول السري","https://www.poetsgate.com/ViewPoem.aspx?id=114730",""],[5691,"روح المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=206312",""],[5725,"كورونيات","https://www.poetsgate.com/ViewPoem.aspx?id=211274",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5853,"تباريح","https://www.poetsgate.com/ViewPoem.aspx?id=178345",""],[5858,"حياة الصغار","https://www.poetsgate.com/ViewPoem.aspx?id=188184",""],[5879,"حماسيات (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215441",""],[6070,"إلهَ الكونِ قدْ عَلَتِ الخطوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=187901",""],[6093,"ذاك لنا","https://www.poetsgate.com/ViewPoem.aspx?id=197424",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""],[6149,"أناخ على قلبي الكآبة والكرب","https://www.poetsgate.com/ViewPoem.aspx?id=169622",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""]],"verses":[["فقد عَرَفْتُ بِها قَوْماً ألِفْتُهُمُ","كما تَمازَجَ أرْواحٌ وأبدانُ",0,"ن",1,0],["فَقَد عَجِبَ الناسُ مِن أَمرِنا","وَأَنساهُمُ قِصَصَ الأَوَّلينا",1,"ن",2,0],["فَقَد عُوِّضُوا بِالأُثْلِ والْخَمْطِ بَعْدَهَا","وَهَيْهَاتَ أَيْنَ الأَثْلُ مِنْهَا وَمَا الْخَمْطُ",2,"ط",1,0],["فقد عجَمَتْ عوداً صَليباً على الرّدى","وعزْماً كَما تمْضي المهنّدَةُ البُتْرُ",3,"ر",1,0],["فقَد عادَ الزّمانُ اليومَ عِيداً","وهَزَّ البِشْرُ أعْطافَ الوجودِ",4,"د",1,0],["فَقَد عانَيتُ قِدماً ما يُعاني","عَلى عِلّاتِهِ القَلبُ الحَزينُ",5,"ن",1,0],["فَقَد عَرَفَ الفَقيرُ نَداكَ قِدماً","وَقَد عَرَفَ الكَبيرُ عُلاكَ قَبلُ",6,"ل",1,0],["فَقَد عوفِيَت حَدراءُ شَيبانَ أَن تُرى","حَليلَةَ قَينٍ أَو يَكونَ لَها بَعلا",7,"ل",2,0],["فَقَد عَلِمَت غَوثٌ بِأَنّا سَراتُه","إِذا أُعلِمَت بَعدَ السِرارِ أُمورُها",8,"ر",3,0],["فقد عزفت عن كل ما كنت أبتغي","لديك فأمسى كبرياءً خضوعها",9,"ع",3,0],["فقد عكفتْ منها عليهِ بما اشتهى","هنالك أظْآر من العيشِ رُوَّمُ",10,"م",1,0],["فَقَد عُرِكَت شَيبانُ مِنّا بِكَلكَلٍ","وَعَيَّلنَ تَيمَ اللاتِ رَهطَ زِيادِ",11,"د",1,0],["فَقَد عَلِموا أَنّي وَفَيتُ لِرَبِّها","فَراحَ عَلى عَنسٍ بِأُخرى يَقودُها",12,"د",3,0],["فقد عَبَّأَ الهَمُّ لي جَيْشَه","وليسَ له غيرُ جيشِ الخُمارِ",13,"ر",1,0],["فقد عُذْنَ منك بمستَلئِمٍ","يُبيحُ التَّليدَ ويَحمي الذِّمارا",14,"ر",2,0],["فقد عاق الشتاءُ الحَيْنَ عنكم","وعنه الحربَ فيه والحِرابا",15,"ب",2,0],["فَقَد عَلِمتَ بِما في النَفسِ مِن أَرَبٍ","وَأَنتَ أَكبَرُ مِن ذِكري لَهُ بِفَمي",16,"م",2,0],["فقد عَمّهُ الإعْظامُ منْ قَبْرِ عَمّةٍ","أنوحُ عليها بالنحيب إلى النّحْبِ",17,"ب",1,0],["فَقَد عَلِمَ اللَهُ أَن لَن تُحِبَّ","شَيئاً كَحُبِّكَ كَنزَ الثَناءِ",18,"ا",2,0],["فَقَد عِشتُ فِيما مَضى خِدنَها","لَيالي الوِصالُ بِها يَعنقُ",19,"ق",1,0],["فَقَدْ عَاشَرْتُهُمْ وَلَبِثْتُ فِيهمْ","مَعَ التَّجْرِيبِ مِنْ عُمْرِي سِنينا",20,"ن",2,0],["فَقَد عاوَدَت نَفسي الصَبابَةَ وَالهَوى","وَحانَ صَبوحٌ باكِرٌ وَغَبوقُ",21,"ق",1,0],["فَقَد عَلِمتَ يَقيناً أَو سَتَعلَمُهُ","صَنيعَ حُبِّكَ في قَلبي وَذِكراكا",22,"ك",2,0],["فَقَد عِشتُ حَتّى مَلَّني وَمَلَلتُهُ","زَماني وَناجَتني عُيونُ التَجارُبِ",23,"ب",1,0],["فَقَد عَرِيَت بِالكَأسِ مِن كُلِّ مَلبَسٍ","جَميلٍ وَأَلقَت في حَشاكَ خُمارَها",24,"ر",3,0],["فقد عنِيتْ بهَواها الحُلُو","مُ فهْي براحتِهَا عانِيهْ",25,"ن",3,0],["فَقَدْ عَادَيْتُ أَعْظَمَ مِنْكَ قَدْراً","ومَا ضَاقَتْ عَلَى بَدَنِي ثِيَابِي",26,"ب",2,0],["فَقَد عَلِمَت غَوثٌ بِأَنّا سَراتُها","إِذا أُعلِمَت بَعدَ السِرارِ أُمورُها",27,"ر",3,0],["فَقَد عَزَلَتني الغانِياتُ عَنِ الصِبا","وَمَزَّقَ جِلبابَ الشَبابِ مَشيبُ",28,"ب",1,0],["فَقَدْ عِشْتُ في ما مَضَى لاَهِياً","بها، والوصالُ بنا يعلق",29,"ق",1,0],["فقد عمّ أرجاءها بالسنا","وشرف ابناءها بالحضورْ",30,"ر",1,0],["فقد عرفوا مقدار قربك منهم","ببعدك عنهم واشتكوا منه مايشكا",31,"ك",2,0],["فَقَد عَهِدتُكَ طَوداً ما تُزَعزِعُهُ","نَكباءُ عادٍ فكَيفَ القِيلُ وَالقالُ",32,"ل",1,0],["فَقَد عاوَرتُهُنَّ ثِيابَ لَهوٍ","لَبِسناهُنَّ وَالمَحرُومُ عارِى",33,"ر",2,0],["فَقَد عاشَ إمّا واجب الحبسِ عمرهُ","وإمّا غدا بينَ الورى دمهُ هَدرا",34,"ر",2,0],["فقد عصيتُ اللَه في نظرتي","وخُنتُ من أهوى بلا عتبِ",35,"ب",1,0],["فقد علم الأعداء أنك زرتهم","ولاقَوك حرباً زَرْدَقاً بعد زَرْدَقِ",36,"ق",1,0],["فَقَد عِشتُ دَهراً ما تُمَدُّ لِنائِلٍ","يَدايَ وَلا تَسعى إِلى آمِلٍ رِجلي",37,"ل",2,0],["فقد علم الأشاوس من بنيها","بأن النصر في حمل السلاح",38,"ح",1,0],["فَقَد عادَ أَيقاظاً عَلَينا صُروفُهُ","فَما نَلتَقي أَحبابنا غَيرَ نُوَّمِ",39,"م",1,0],["فقد علمت قبله","حكمَ القضاء المنزَل",40,"ل",1,0],["فقد عفتم الدنيا متاعاً وحزتم","من الحمد زاداً والمكارم موردا",41,"د",2,0],["فَقَد عظمت أَوزارنا وَذنوبنا","وَلَم نأت شيأ لِلكَرامة يوجب",42,"ب",1,0],["فقد عقموا به من غير عَقُمٍ","كما جَبُنوا به من غير جُبْن",43,"ن",1,0],["فَقَد عشتَ مَحموداً وَجئتَ مؤرِّخاً","وَمَأواكَ بِالفردوسِ كاِسمكَ مُصطفى",44,"ف",2,0],["فَقد عادَ للأجفانِ نومٌ مشرّدٌ","وَوثّر أَعطافاً أُقضّت مهودها",45,"د",3,0],["فَقَد عَمِيَ اِبنُ آدَمَ لا يَراها","عَمىً أَفضى إِلى صَمَمِ الصماخِ",46,"خ",1,0],["فقد عاش كُلَّ الدَّهرِ مَن عاش بَعضَهُ","كريماً حليماً فاغتَنِمْ أَطْولَ العُمر",47,"ر",1,0],["فقد عادتِ الدُّنيا لنا مُستَقيمةً","بأَرْوعَ سهْمُ الرَّأْيِ منه سديد",48,"د",1,0],["فقَد عارَضَ حُكم الشَّم","سِ تعذيرٌ فأوهاهُ",49,"ا",2,0],["فقَد عَدلَ الدهرُ الذي كانَ جائِراً","وكيفَ يخافُ الجورَ من كانَ جاركِ",50,"ك",1,0],["فقد عد الغزالي","له عشرين آفات",51,"ت",1,0],["فقد عاد لعن اللاعنين جميعه","عليه كذا من سن سُنَّة منكر",52,"ر",1,0],["فقد عَوَّضَ الإِسلامَ من فقدِ نَفْسِهِ","هلالَ سماءٍ لا يضِلُّ مُهِلِّوهُ",53,"و",2,0],["فقد عاشوا بها وهم كرامٌ","وماتوا بعد ما وضحوا هداها",54,"ا",3,0],["فقد علم الصمصامُ أن مصيركم","إليه إذا التفّت رقابٌ وأذرعُ",55,"ع",1,0],["فقد عَقَدتَ لَسَني وقُدتني","بالطَّوْلِ في حباله جنيبا",56,"ب",2,0],["فقد علمتْ قُريشٌ ما لديهِ","من الفخرين اِفْضالٍ وفَضْلٍ",57,"ل",1,0],["فقد علمتُ بما أوتيتَ من شيَمٍ","إنَّ المكارمَ طُراً في بني البَلَدي",58,"د",2,0],["فَقَد عَجَمَت مِنّي العَواجِمُ ماجِداً","صَبوراً عَلى عَضّاتِ تِلكَ التَلاتِلِ",59,"ل",1,0],["فَقَد عَجِبتُ وَما بِالدَهرِ مِن عَجَبٍ","أَنّى قُتِلتَ وَأَنتَ الحازِمُ البَطَلُ",60,"ل",1,0],["فقد عجّت به الأسوا","قُ والإقبالُ قد قلّا",61,"ل",2,0],["فَقَد عَريت بَعدَ ابن لَيلى فَإِنَّما","ذُراها لِمن لاقَت من الناسِ مَنظَر",62,"ر",1,0],["فَقَد عَزَبتُ عَنِ الدُّنيا وَبَهجَتِها","وَقُلتُ لِلنَّفسِ صَبراً أُمَّ صَبَّارِ",63,"ر",1,0],["فقد علم المُلكُ ثمّ الملو","كُ أنّك أوْلاهمُ بالرِّهانِ",64,"ن",1,0],["فقد عَلَّمتَ كيف تفوت شرّاً","وكيف تجوز ضيّقةَ المجالِ",65,"ل",1,0],["فَقَد عَلا الماء الزُبى فَلا غِيَر","وَاَختارَ في الدينِ الحَروريُّ البَطَر",66,"ر",1,0],["فقد علمنا غير ما اشتباه","بأنه جاء بعلم الله",67,"ه",1,0],["فقد عدا الحق وخلّى الظار","من دينه بقوله وكابر",67,"ر",1,0],["فقد عقمت عن الكرم اللّيالي","فلا تَرْجُ الوِلادة من عقيم",68,"م",1,0],["فَقَدْ عَادَ الحَكِيمُ إلى عُلاَهَا","وَعَادَ الْجُودُ في طَرَبٍ يَصُولُ",69,"ل",1,0],["فقد عقر المجد من فوقه","فطبق وسع الفضا بالهدير",70,"ر",1,0],["فقد عمها الرزء الذي جدد الأسى","عليها بما خص النبي محمدا",71,"د",2,0],["فَقَد عَمَّت البُشرى بِمقدمك الَّذي","بِهِ نالَ ما يرجو غُلام وَسَيد",72,"د",1,0],["فقد عزموا على إبطال حقّي","وما إنْ فيهِمُ رجلٌ يعيبُ",73,"ب",1,0],["فقد عرفوا من حساب مسير","لما نجتلي من أشعة نور",74,"ر",1,1],["فَقَدْ عَبِقَتْ رِيْحُ النُّعَامَى كأنَّما","سَلامُ سُلَيْمَى رَاحَ في نَفَحَاتِها",75,"ت",3,0],["فَقَد عَجزوا عَن أَن يَجيئوا بِمِثلهِ","وَهُمْ حينَئذ مِن أَفصَحِ الفُصَحاءِ",76,"ا",2,0],["فقد علمت في القوم أبناء يوسف","غداةَ اهتياج الروع أنى المدَمِّر",77,"ر",1,0],["فَقَد عصيتَهم والحَربُ مقبلةٌ","لا بَل قَدَحتَ زَناداً غَيرَ صلاَّدِ",78,"د",1,0],["فقد عَدِم الأضيافُ بعدهما القرى","وأخمدَ نارَ الليل كُلُّ فتىً وَغل",79,"ل",1,0],["فقد علمت فهىَ الأَمانىّ أَنَّها","بجداء إِلاَّ تسبق الليلَ تَثكَلِ",80,"ل",1,0],["فقد عمَّها خصب به من رءوسهم","بها ولكم خصب أضَّر من الجدب",81,"ب",1,0],["فَقَد علمت يَقيناً أَنَّهُ خَطل","وَأَنَّني سَوفَ أَبلى وَهوَ يَكتتب",82,"ب",1,0],["فَقَد عزَمنا على الشُر","بِ صبحَةً واجتَمَعنا",83,"ن",2,0],["فقد علينا انه","على الصراط المستقيم",84,"م",1,0],["فَقَد عَلَتنِي وَأبِيكَ كَبرَةٌ","وَإِن ثَوَت تَحتَ ضُلوعِي زَفرَةٌ",85,"ه",1,0],["فقد عاثت بكم أيدي الأعادي","وثار الجور بالجيش الرداح",86,"ح",1,0],["فقد عبثت في الذين آل أمية","وغالت رسول الله في ولده جهرا",87,"ر",2,0],["فقد عزيت باللوم والقلب بالجوى","فمل ملَّ قلبي والعواذلُ ملَّت",88,"ت",1,0],["فقد عرَّست حيث الندى لا سحابةً","جهامٌ ولا برق المكارم خلَّبُ",89,"ب",1,0],["فقد عز في الدنيا \"له المثل\" في العلى","فما \"يوسفٌ إ\"لاّ الحيا طاب وردُه",90,"د",2,0],["فقد عقدوا القلوب على ائتلاف","له الأيد المظفر والفلاح",91,"ح",1,0],["فقد عز اللقا ومضى","شباب كنت أئتلف",92,"ف",1,0],["فقد عاضَني الرحمانُ منه ومنهمُ","بكم وبِسامي طَوْدِهِ المُتَعالي",93,"ل",2,0],["فقد عقم الدهر من بعدها","ومن قبلها في السنين الأول",94,"ل",1,0],["فقد عوضوا عنها القناعة والرضى","فليس لهم فيها هموم ومأرب",95,"ب",1,0],["فقد عشت في مَحْل الأقاليم مخصباً","بما غاد