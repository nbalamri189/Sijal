3,"الشاعر الصامت","https://www.poetsgate.com/ViewPoem.aspx?id=94020",""],[5267,"من كل ذات روادف","https://www.poetsgate.com/ViewPoem.aspx?id=109427",""],[5277,"رَبْح..أم الخير","https://www.poetsgate.com/ViewPoem.aspx?id=191819",""],[5302,"ملكت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=202727",""],[307,"الرحيل الى الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=213747",""],[5324,"ليلة وفاة الشاعر عبد الرزاق عبد الواحد.","https://www.poetsgate.com/ViewPoem.aspx?id=211464",""],[5338,"على منهاج صاحب البردة","https://www.poetsgate.com/ViewPoem.aspx?id=187617",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5363,"الكرمة والدود","https://www.poetsgate.com/ViewPoem.aspx?id=144164",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5409,"غنت وتابعت الغناء بجسها","https://www.poetsgate.com/ViewPoem.aspx?id=155517",""],[5431,"لعالم الروح تروى من مآقيه","https://www.poetsgate.com/ViewPoem.aspx?id=185944",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5497,"هيفاء غانيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=208895",""],[5508,"جدَّ الصبَّا في أباطيل الهوى لعب","https://www.poetsgate.com/ViewPoem.aspx?id=110820",""],[5561,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=193375",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[482,"ما لم تزوروا فالمامُ الكرى زورُ","https://www.poetsgate.com/ViewPoem.aspx?id=111256",""],[5648,"صمت الشفايف","https://www.poetsgate.com/ViewPoem.aspx?id=155982",""],[5660,"فَالوَصلُ وَ الصَّدُ في أَيامِنا دُوَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23914",""],[5667,"هند","https://www.poetsgate.com/ViewPoem.aspx?id=214871",""],[5720,"إدْمَانٌ","https://www.poetsgate.com/ViewPoem.aspx?id=199782",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5736,"فتحي","https://www.poetsgate.com/ViewPoem.aspx?id=203820",""],[5858,"نقش معلمي","https://www.poetsgate.com/ViewPoem.aspx?id=187984",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[520,"العلم مذ كان محتاج الى العلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577651",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[6229,"حواء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65186&r=&rc=12",""],[6229,"يا خادم الحرمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82504&r=&rc=39",""],[463,"سلْ أبرقَ الحنَّانِ واحبسْ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60166&r=&rc=222",""],[6314,"جدارية عارية للبحر والجسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88073&r=&rc=8",""],[5190,"طَرَقات على باب الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78319&r=&rc=32",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""]],"verses":[["حتّى كأنّكَ لمْ تغيَّبْ في الثّرى","وكأنّ عُمْرَكَ ساعَدَ استِمْرارُهُ",0,"ر",2,0],["حَتَّى كَأَنَّ نَجَازَ مَوْعِدِهَا","بَعْضُ العُهُودِ عَلَيْكَ وَالذِّمَمِ",1,"م",1,0],["حَتّى كَأَنَّكَ نِقمَةٌ في نِعمَةٍ","أَو غُصنُ شَوكٍ في حَديقَةِ نَرجِسِ",2,"س",1,0],["حَتّى كَسا كُلَّ مُرتادٍ لَهُ خَضِلٌ","مُستَحلَسٌ مِثلُ عَرضِ اللَيلِ يَحمومُ",3,"م",1,0],["حَتّى كَأَنَّ رِياضَ القُفَّ أَلبَسَها","مِن وَشيِ عَبقَرَ تَجليلٌ وَتَنجيدُ",4,"د",1,0],["حتى كأن عِراص الدار أرديةٌ","من التجاويز أو كُرَّاس أسفارِ",5,"ر",1,1],["حَتّى كَأَنَّ الوَحيَ فيكُم مَنزِلٌ","وَلَكُم تُخَصُّ فَضائِلُ القُرآنِ",6,"ن",1,0],["حتَّى كأنَّ ربيعها ونسيمها","نعمى يديكَ وذكركَ الفيَّاح",7,"ح",1,0],["حتى كأنَّ العقلَ ليس بعاقلٍ","إياك أن تعي بأمرٍ مفضع",8,"ع",1,0],["حتى كأنك قاصدٌ تعويقَهُ","عمَّا ابتغاهُ وطالبٌ تخييبَهُ",9,"ب",2,0],["حتى كأن لم يجتَرِحْ","ما جاء منْهُ مُجْتَرِحْ",10,"ح",1,0],["حتى كأني وما أسْلَفْتُ سيِّئَةً","مُطَالَبٌ تحْت حقدٍ منْك محقودِ",11,"د",1,0],["حتى كأنِّي في صرارك درهمٌ","أو في مَزاودك الحريزة زادُ",12,"د",1,0],["حتى كأنّ نبياً كان أدركه","دعا له بشباب القرن في صغرَهْ",13,"ر",2,0],["حتى كأن كلومهم مأسُوَّةً","بكلوم إخوتهم تَعادي أنفس",14,"س",1,0],["حتى كفلتَ الفِراخ كامنةً","في البيض قبل انقياض مُنقاضه",15,"ض",2,0],["حَتّى كَأَنّي لِلحَوادِثِ مَروَةٌ","بِصَفا المُشَرَّقِ كُلَّ يَومٍ تُقرَعُ",16,"ع",1,0],["حَتّى كَأَنَّ الزَمانَ أَعمى","يَمشي عَلى الشَوكِ في الوُعورِ",17,"ر",1,0],["حتى كأن سيرتي","مكتوبة في صورتي",18,"ي",1,0],["حَتّى كَأَنَّ لِكُلِّ عَظمٍ رَنَّةً","في جِلدِهِ وَلِكُلِّ عِرقٍ مَدمَعا",19,"ع",2,0],["حَتّى كَفَيتَهُمُ الَّذي اِستَكفَوكَ مِن","أَمرِ العِدى وَوَفَيتَ أَيَّ وَفاءِ",20,"ا",2,0],["حَتّى كَأَنِّيَ لَم أُرِم وَطَني وَلَم","تَشمَت بِزائِلِ نِعمَتي حُسّادي",21,"د",2,0],["حتى كأنَّ سُجُوفَ الرَّقْمِ ضاحيةً","تكشَّفَت عن دُمىً منهن أو لُعَبِ",22,"ب",1,0],["حَتّى كَأَنَّ الشَمسَ مَخفوفَةٌ","بَينَ جَواريكِ وَخِصيانِك",23,"ك",1,0],["حَتّى كَأَنَّ لِسانَهُ بِيَمينِهِ","أَو أَنَّ ما بِيَمينِهِ في فيهِ",24,"ه",1,0],["حَتّى كَأَنَّ اللَيالي في تَصَرُّفِنا","إِذ جانِبُ العَيشِ طَلقٌ مِن تَأَلُّفِنا",25,"ن",2,0],["حَتّى كَمَلتَ الأَربَعينَ وَأَشرَقَت","شَمسُ النُبوَّةِ وَاِنجَلى التَبيانُ",26,"ن",1,0],["حَتّى كَأَنَّهُمُ بِهَجرِ حَياتِهمْ","يَجِدونَ مِنها بالحِمامِ وِصالا",27,"ل",2,0],["حتى كأنّ بَياضَ الشيب منتقلٌ","إلى سوادِ عُيُونِ الخُرّدِ الأنسِ",28,"س",1,0],["حَتّى كَسَوْتَ حياةً جِسْمَ مَملكةٍ","بِرَدّ روحٍ إليهِ منكَ يَنْتَظرُ",29,"ر",1,0],["حَتّى كَأَنَّ جَلابيبَ الدُجى رَغِبَت","عَن لَونِها وَكَأَنَّ الشَمسَ لَم تَغِبِ",30,"ب",1,0],["حتى كأنَّ الفِجاجَ الغُبرَ تَفهمُنا","والمبهماتِ من الوادي تُناغينا",31,"ن",2,0],["حتى كأنَّا وضوءُ البدر يَفرشها","نمشي على غيمةٍ منه تماشينا",31,"ن",2,0],["حَتّى كَأَنِّيَ قَد فَزَّعتُ والِدَها","في المَهدِ فَاِنقَلَبَت عَيناهُ مِن فَرَقِ",32,"ق",1,0],["حتى كأنّي مُلْهَمٌ وكأنّها","سُوَرٌ أُرَتِّلُ آيَهَا تَرتِيلا",33,"ل",2,0],["حَتّى كَأَنّي واجِدٌ حِسُّهُ","أَو مَسَّهُ مِن دونِ أَطرابي",34,"ب",2,0],["حَتَّى كَسَوْنَ حَدِيدَ التِّ","مْثَالِ ذَاكَ الْغِشَاءَ",35,"ا",2,0],["حتى كأني -حين أقرأ- أجتلي","صُوَرًا وأستمع الحديث منغّما",36,"م",2,0],["حتى كأنَّ الأرضَ من إعيائها","سكنَتْ وأخطأت النجوم مدارها",37,"ر",3,0],["حتى كأنك مَنْ رمى","«مجنو» ولاذ «بسجفريد»",38,"د",1,0],["حتى كشفناكَ بالعلم الحديث؛ فما","عادَتْ تحوطك أسْدَافٌ من الظلم",39,"م",1,0],["حتى كأنّ عيونَ الشعر يُعوِزُها","وصفُ الدقائقِ من هذي التصاوير",40,"ر",1,0],["حتى كأنْ لم يكنْ للعُربِ مطَّلبٌ","ولا استقلَّ بحملِ القومِ مضطلِع",41,"ع",1,0],["حتى كأنَّ مصايراً محتومةً","سُوداً تُنيلُهُمُ مُنىً ورَغائبا",42,"ب",2,0],["حتى كأنْ لم تكُ بالأواهلِ","صاولَ منها الدهرُ غيرَ صائلِ",43,"ل",1,0],["حَتّى كَأن أَديمها مِما حَوَت","حَبات أَفئِدة المُلوك العدّل",44,"ل",1,0],["حتى كأن لم يكن ولا طرق الد","هر ذراه بالصفو والكدر",45,"ر",1,0],["حتى كأني سليمانُ الزمانِ فلا","يردّ أمرٌ إلى من شئتِ أصدرهُ",46,"ر",2,0],["حتى كأنّ لديه وِرد سائغٌ","والناسُ من ظمإ إليه تؤولُ",47,"ل",1,0],["حتى كأن عليه عهداً للعلا","أن يصلح الأخلاق والأفكارا",48,"ر",2,0],["حتى كأن القلب مد حجابه","ليرد عنه طوارق اللوام",49,"م",1,0],["حتى كأنّ الأرضَ طبّقها","بغمائم نشأت من البِرِّ",50,"ر",1,0],["حَتّى كَأَنَّ جَناباً قَبلَ مَصرَعِهِ","وَصّاكَ إِذ بايَنَ الدُنيا بِمَن وَلَدا",51,"د",2,0],["حَتّى كَأَنَّكَ وَالمُشَبِّهُ صادِقٌ","عُمَرٌ بِها وَكَأَنَّها لَكَ يَثرِبُ",52,"ب",1,0],["حَتّى كَأَنّا مِن جُهَينَةَ أَصلُنا","لا وُلدَ عَبدِ اللَهِ نَحنُ وَلا عَلِي",53,"ل",2,0],["حتى كأنّك لم تكرّذ كرّة","وكسيتها الوبينة وسقاعا",54,"ع",2,0],["حتى كأني لم أبت","منهم على عهد وثيق",55,"ق",1,0],["حتى كأني في جِوا","رِك للورى طُرّاً سمير",56,"ر",1,0],["حتى كأنّ تَنّبهي وتأَدُّبي","وتكّرمي عند الزمان ذنوبي",57,"ب",2,0],["حَتّى كَأَنّي ما نَظَمتُ لَكُم","في مَدحِكُم بَيتاً مِنَ الشِعَرِ",58,"ر",1,0],["حَتّى كَأَنَّكَ مِن ضَما","ئِرِها خُلِقتَ وَمِن هَواها",59,"ا",3,0],["حَتّى كَأَنَّ الأَرضَ حَلقَةُ خاتَمٍ","في عَينِهِ وَالجَوُّ سَقفٌ مُطبَقُ",60,"ق",1,0],["حَتّى كَأَنَّ المَجدَ أَقسَمَ مولِياً","أَن لا يَقُرَّ لِطالِبيهِ وِسادُ",61,"د",1,0],["حتى كأن فمي عليه","تغار ان قررت غيره",62,"ر",2,0],["حتى كأن بكل قطر ضمها","قطر يضوع وكل عودٍ عود",63,"د",1,0],["حَتَّى كَسَاهُ الدَّوْحُ مِن أَفيائِهِ","بُرْداً تَمَزَّقَ بِالأَصائِلِ هَلْهَلا",64,"ل",2,0],["حتى كأنَّ بعضَها","له عَلَى بَعْضٍ تِرَه",65,"ر",2,0],["حتّى كأنّ رَجائي في علاك يدٌ","أَوليتها حينَ وافت شكرَ معترفِ",66,"ف",1,0],["حتّى كأنّ ولا كأنّ فِراقُه","أَغرَى السَّقامَ بجسميَ المَفْجوع",67,"ع",1,0],["حتّى كأنّك أَردَشِيرُ الفُرسِ إذْ","وافَى فقَصَّ طوائفَ الإسكَنْدر",68,"ر",1,0],["حَتّى كَأَنَّ قَميصي حينَ تَنفُذُهُ","قَميصُ يوسُفَ وافى بِالدَمِ الكَذِبِ",69,"ب",1,0],["حَتّى كَأَنَّ حَبيباً قَبلَ فُرقَتِهِ","لا عَن أَحِبَّتِهِ يَنأى وَلا بَلَدِه",70,"ه",1,1],["حَتّى كَأَنَّ الصَبرَ مُح","تَرِقٌ بِنيرانِ اِشتِياقي",71,"ق",2,0],["حتَّى كشَفتُ لَه حالِي فقَالَ إذا","لو كانَ غيرَ الَّذي نَنحوهُ لَم تَصِلِ",72,"ل",1,0],["حتَّى كأنَّهُما استَملا","مِن وَفاءِ أَبي المَعالِي",73,"ل",2,0],["حتَّى كأنَّ تَرَقُّبي","إِياكَ زَجرٌ أَو عيافَه",74,"ف",2,0],["حتَّى كأنَّ السالِكي","نَ وراءهُ فيها وقوفُ",75,"ف",1,0],["حتى كأنَّ ظُنونَهم","فيه حَمولَةُ تاجِرِ",76,"ر",1,0],["حتى كأن لا علم لي","أنَّ الزمان معانِدي",77,"د",2,0],["حَتّى كَأَنّا نَرى في كلِّ ملتفِتٍ","رَوضاً تَفَتَّح في أَثنائِهِ الزَهَرُ",78,"ر",1,0],["حَتّى كَأَنَّ سَنا الصَباحِ لِثامُهُ","وَمَضى الظَلامُ يَجُرُّ فَضلَ رِدائِهِ",79,"ا",3,0],["حتَّى كَأَنَّ الشُّكْرَ كانَ نَسِيمُهُ","يَهْوى عَلَى عُرْفِ العَبِيرِ عُبُورا",80,"ر",2,0],["حتى كأَنَّا وكَفُّ النَّوْءِ تُقْلِقُنا","دراهمٌ قَلَّبَتْها كفُّ نَقَّادِ",81,"د",1,0],["حتى كأَنَّ الدَّهْرَ حَيَّرني به","في مثلِ ما أَهواهُ أَو منَّاني",82,"ي",1,1],["حتى كأنّي لم ألُذْ بالحافظِ ال","حَبْرِ الإمامِ النافعِ الضّرّارِ",83,"ر",1,0],["حتى كأنّي قد عدَلْ","تُ عن الصّراطِ المستقيمِ",84,"م",1,0],["حتى كأن منَ المشا","رق عسكراً تغزو المَغارب",85,"ب",1,0],["حتى كأنك يا عباسُ متّصلٌ","في نسبةِ الفضلِ بالعباسِ من مُضرِ",86,"ر",1,0],["حتى كأن اللهَ لمْ","يَخلُقْ لشغْلِ 