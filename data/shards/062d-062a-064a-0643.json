 وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[465,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[465,"ولقد بدا والصولجان بكفّه","https://www.aldiwan.net/poem3522.html","عموديه"],[471,"زايلت ما صنعوا إليك برحلة","https://www.aldiwan.net/poem4781.html","الكامل"],[478,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[478,"قد حق للمشتاق أن يتوجعا","https://www.aldiwan.net/poem15217.html","الكامل"],[478,"ماذا الوقوف وقد بانوا على الطلل","https://www.aldiwan.net/poem15230.html","البسيط"],[516,"ما كل سجع بمعدود من الخطب","https://www.aldiwan.net/poem12020.html","البسيط"],[516,"هل تبلغن لبختيار","https://www.aldiwan.net/poem12133.html","مجزوء الكامل"],[516,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[516,"أقول والصدق فيما قلت يعضدني","https://www.aldiwan.net/poem12281.html","البسيط"],[516,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[530,"نخرج أو ندخل في مصرنا","https://www.aldiwan.net/poem37378.html","السريع"],[539,"إن غاب صفو العيش عنا برهة","https://www.aldiwan.net/poem47565.html","عموديه"],[541,"أألحمامة في نخل ابن هداج","https://www.aldiwan.net/poem56877.html","البسيط"],[552,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[552,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[554,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[559,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[559,"من صالحيتنا طرنا بأجنحة","https://www.aldiwan.net/poem34683.html","المواليا"],[568,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[574,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[587,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"]],"verses":[["حتّى كأنّكَ لمْ تغيَّبْ في الثّرى","وكأنّ عُمْرَكَ ساعَدَ استِمْرارُهُ",0,"ر",2,0],["حَتَّى كَأَنَّ نَجَازَ مَوْعِدِهَا","بَعْضُ العُهُودِ عَلَيْكَ وَالذِّمَمِ",1,"م",1,0],["حَتّى كَأَنَّكَ نِقمَةٌ في نِعمَةٍ","أَو غُصنُ شَوكٍ في حَديقَةِ نَرجِسِ",2,"س",1,0],["حَتّى كَسا كُلَّ مُرتادٍ لَهُ خَضِلٌ","مُستَحلَسٌ مِثلُ عَرضِ اللَيلِ يَحمومُ",3,"م",1,0],["حَتّى كَأَنَّ رِياضَ القُفَّ أَلبَسَها","مِن وَشيِ عَبقَرَ تَجليلٌ وَتَنجيدُ",4,"د",1,0],["حتى كأن عِراص الدار أرديةٌ","من التجاويز أو كُرَّاس أسفارِ",5,"ر",1,1],["حَتّى كَأَنَّ الوَحيَ فيكُم مَنزِلٌ","وَلَكُم تُخَصُّ فَضائِلُ القُرآنِ",6,"ن",1,0],["حتَّى كأنَّ ربيعها ونسيمها","نعمى يديكَ وذكركَ الفيَّاح",7,"ح",1,0],["حتى كأنَّ العقلَ ليس بعاقلٍ","إياك أن تعي بأمرٍ مفضع",8,"ع",1,0],["حتى كأنك قاصدٌ تعويقَهُ","عمَّا ابتغاهُ وطالبٌ تخييبَهُ",9,"ب",2,0],["حتى كأن لم يجتَرِحْ","ما جاء منْهُ مُجْتَرِحْ",10,"ح",1,0],["حتى كأني وما أسْلَفْتُ سيِّئَةً","مُطَالَبٌ تحْت حقدٍ منْك محقودِ",11,"د",1,0],["حتى كأنِّي في صرارك درهمٌ","أو في مَزاودك الحريزة زادُ",12,"د",1,0],["حتى كأنّ نبياً كان أدركه","دعا له بشباب القرن في صغرَهْ",13,"ر",2,0],["حتى كأن كلومهم مأسُوَّةً","بكلوم إخوتهم تَعادي أنفس",14,"س",1,0],["حتى كفلتَ الفِراخ كامنةً","في البيض قبل انقياض مُنقاضه",15,"ض",2,0],["حَتّى كَأَنّي لِلحَوادِثِ مَروَةٌ","بِصَفا المُشَرَّقِ كُلَّ يَومٍ تُقرَعُ",16,"ع",1,0],["حَتّى كَأَنَّ الزَمانَ أَعمى","يَمشي عَلى الشَوكِ في الوُعورِ",17,"ر",1,0],["حتى كأن سيرتي","مكتوبة في صورتي",18,"ي",1,0],["حَتّى كَأَنَّ لِكُلِّ عَظمٍ رَنَّةً","في جِلدِهِ وَلِكُلِّ عِرقٍ مَدمَعا",19,"ع",2,0],["حَتّى كَفَيتَهُمُ الَّذي اِستَكفَوكَ مِن","أَمرِ العِدى وَوَفَيتَ أَيَّ وَفاءِ",20,"ا",2,0],["حَتّى كَأَنِّيَ لَم أُرِم وَطَني وَلَم","تَشمَت بِزائِلِ نِعمَتي حُسّادي",21,"د",2,0],["حتى كأنَّ سُجُوفَ الرَّقْمِ ضاحيةً","تكشَّفَت عن دُمىً منهن أو لُعَبِ",22,"ب",1,0],["حَتّى كَأَنَّ الشَمسَ مَخفوفَةٌ","بَينَ جَواريكِ وَخِصيانِك",23,"ك",1,0],["حَتّى كَأَنَّ لِسانَهُ بِيَمينِهِ","أَو أَنَّ ما بِيَمينِهِ في فيهِ",24,"ه",1,0],["حَتّى كَأَنَّ اللَيالي في تَصَرُّفِنا","إِذ جانِبُ العَيشِ طَلقٌ مِن تَأَلُّفِنا",25,"ن",2,0],["حَتّى كَمَلتَ الأَربَعينَ وَأَشرَقَت","شَمسُ النُبوَّةِ وَاِنجَلى التَبيانُ",26,"ن",1,0],["حَتّى كَأَنَّهُمُ بِهَجرِ حَياتِهمْ","يَجِدونَ مِنها بالحِمامِ وِصالا",27,"ل",2,0],["حتى كأنّ بَياضَ الشيب منتقلٌ","إلى سوادِ عُيُونِ الخُرّدِ الأنسِ",28,"س",1,0],["حَتّى كَسَوْتَ حياةً جِسْمَ مَملكةٍ","بِرَدّ روحٍ إليهِ منكَ يَنْتَظرُ",29,"ر",1,0],["حَتّى كَأَنَّ جَلابيبَ الدُجى رَغِبَت","عَن لَونِها وَكَأَنَّ الشَمسَ لَم تَغِبِ",30,"ب",1,0],["حتى كأنَّ الفِجاجَ الغُبرَ تَفهمُنا","والمبهماتِ من الوادي تُناغينا",31,"ن",2,0],["حتى كأنَّا وضوءُ البدر يَفرشها","نمشي على غيمةٍ منه تماشينا",31,"ن",2,0],["حَتّى كَأَنِّيَ قَد فَزَّعتُ والِدَها","في المَهدِ فَاِنقَلَبَت عَيناهُ مِن فَرَقِ",32,"ق",1,0],["حتى كأنّي مُلْهَمٌ وكأنّها","سُوَرٌ أُرَتِّلُ آيَهَا تَرتِيلا",33,"ل",2,0],["حَتّى كَأَنّي واجِدٌ حِسُّهُ","أَو مَسَّهُ مِن دونِ أَطرابي",34,"ب",2,0],["حَتَّى كَسَوْنَ حَدِيدَ التِّ","مْثَالِ ذَاكَ الْغِشَاءَ",35,"ا",2,0],["حتى كأني -حين أقرأ- أجتلي","صُوَرًا وأستمع الحديث منغّما",36,"م",2,0],["حتى كأنَّ الأرضَ من إعيائها","سكنَتْ وأخطأت النجوم مدارها",37,"ر",3,0],["حتى كأنك مَنْ رمى","«مجنو» ولاذ «بسجفريد»",38,"د",1,0],["حتى كشفناكَ بالعلم الحديث؛ فما","عادَتْ تحوطك أسْدَافٌ من الظلم",39,"م",1,0],["حتى كأنّ عيونَ الشعر يُعوِزُها","وصفُ الدقائقِ من هذي التصاوير",40,"ر",1,0],["حتى كأنْ لم يكنْ للعُربِ مطَّلبٌ","ولا استقلَّ بحملِ القومِ مضطلِع",41,"ع",1,0],["حتى كأنَّ مصايراً محتومةً","سُوداً تُنيلُهُمُ مُنىً ورَغائبا",42,"ب",2,0],["حتى كأنْ لم تكُ بالأواهلِ","صاولَ منها الدهرُ غيرَ صائلِ",43,"ل",1,0],["حَتّى كَأن أَديمها مِما حَوَت","حَبات أَفئِدة المُلوك العدّل",44,"ل",1,0],["حتى كأن لم يكن ولا طرق الد","هر ذراه بالصفو والكدر",45,"ر",1,0],["حتى كأني سليمانُ الزمانِ فلا","يردّ أمرٌ إلى من شئتِ أصدرهُ",46,"ر",2,0],["حتى كأنّ لديه وِرد سائغٌ","والناسُ من ظمإ إليه تؤولُ",47,"ل",1,0],["حتى كأن عليه عهداً للعلا","أن يصلح الأخلاق والأفكارا",48,"ر",2,0],["حتى كأن القلب مد حجابه","ليرد عنه طوارق اللوام",49,"م",1,0],["حتى كأنّ الأرضَ طبّقها","بغمائم نشأت من البِرِّ",50,"ر",1,0],["حَتّى كَأَنَّ جَناباً قَبلَ مَصرَعِهِ","وَصّاكَ إِذ بايَنَ الدُنيا بِمَن وَلَدا",51,"د",2,0],["حَتّى كَأَنَّكَ وَالمُشَبِّهُ صادِقٌ","عُمَرٌ بِها وَكَأَنَّها لَكَ يَثرِبُ",52,"ب",1,0],["حَتّى كَأَنّا مِن جُهَينَةَ أَصلُنا","لا وُلدَ عَبدِ اللَهِ نَحنُ وَلا عَلِي",53,"ل",2,0],["حتى كأنّك لم تكرّذ كرّة","وكسيتها الوبينة وسقاعا",54,"ع",2,0],["حتى كأني لم أبت","منهم على عهد وثيق",55,"ق",1,0],["حتى كأني في جِوا","رِك للورى طُرّاً سمير",56,"ر",1,0],["حتى كأنّ تَنّبهي وتأَدُّبي","وتكّرمي عند الزمان ذنوبي",57,"ب",2,0],["حَتّى كَأَنّي ما نَظَمتُ لَكُم","في مَدحِكُم بَيتاً مِنَ الشِعَرِ",58,"ر",1,0],["حَتّى كَأَنَّكَ مِن ضَما","ئِرِها خُلِقتَ وَمِن هَواها",59,"ا",3,0],["حَتّى كَأَنَّ الأَرضَ حَلقَةُ خاتَمٍ","في عَينِهِ وَالجَوُّ سَقفٌ مُطبَقُ",60,"ق",1,0],["حَتّى كَأَنَّ المَجدَ أَقسَمَ مولِياً","أَن لا يَقُرَّ لِطالِبيهِ وِسادُ",61,"د",1,0],["حتى كأن فمي عليه","تغار ان قررت غيره",62,"ر",2,0],["حتى كأن بكل قطر ضمها","قطر يضوع وكل عودٍ عود",63,"د",1,0],["حَتَّى كَسَاهُ الدَّوْحُ مِن أَفيائِهِ","بُرْداً تَمَزَّقَ بِالأَصائِلِ هَلْهَلا",64,"ل",2,0],["حتى كأنَّ بعضَها","له عَلَى بَعْضٍ تِرَه",65,"ر",2,0],["حتّى كأنّ رَجائي في علاك يدٌ","أَوليتها حينَ وافت شكرَ معترفِ",66,"ف",1,0],["حتّى كأنّ ولا كأنّ فِراقُه","أَغرَى السَّقامَ بجسميَ المَفْجوع",67,"ع",1,0],["حتّى كأنّك أَردَشِيرُ الفُرسِ إذْ","وافَى فقَصَّ طوائفَ الإسكَنْدر",68,"ر",1,0],["حَتّى كَأَنَّ قَميصي حينَ تَنفُذُهُ","قَميصُ يوسُفَ وافى بِالدَمِ الكَذِبِ",69,"ب",1,0],["حَتّى كَأَنَّ حَبيباً قَبلَ فُرقَتِهِ","لا عَن أَحِبَّتِهِ يَنأى وَلا بَلَدِه",70,"ه",1,1],["حَتّى كَأَنَّ الصَبرَ مُح","تَرِقٌ بِنيرانِ اِشتِياقي",71,"ق",2,0],["حتَّى كشَفتُ لَه حالِي فقَالَ إذا","لو كانَ غيرَ الَّذي نَنحوهُ لَم تَصِلِ",72,"ل",1,0],["حتَّى كأنَّهُما استَملا","مِن وَفاءِ أَبي المَعالِي",73,"ل",2,0],["حتَّى كأنَّ تَرَقُّبي","إِياكَ زَجرٌ أَو عيافَه",74,"ف",2,0],["حتَّى كأنَّ السالِكي","نَ وراءهُ فيها وقوفُ",75,"ف",1,0],["حتى كأنَّ ظُنونَهم","فيه حَمولَةُ تاجِرِ",76,"ر",1,0],["حتى كأن لا علم لي","أنَّ الزمان معانِدي",77,"د",2,0],["حَتّى كَأَنّا نَرى في كلِّ ملتفِتٍ","رَوضاً تَفَتَّح في أَثنائِهِ الزَهَرُ",78,"ر",1,0],["حَتّى كَأَنَّ سَنا الصَباحِ لِثامُهُ","وَمَضى الظَلامُ يَجُرُّ فَضلَ رِدائِهِ",79,"ا",3,0],["حتَّى كَأَنَّ الشُّكْرَ كانَ نَسِيمُهُ","يَهْوى عَلَى عُرْفِ العَبِيرِ عُبُورا",80,"ر",2,0],["حتى كأَنَّا وكَفُّ النَّوْءِ تُقْلِقُنا","دراهمٌ قَلَّبَتْها كفُّ نَقَّادِ",81,"د",1,0],["حتى كأَنَّ الدَّهْرَ حَيَّرني به","في مثلِ ما أَهواهُ أَو منَّاني",82,"ي",1,1],["حتى كأنّي لم ألُذْ بالحافظِ ال","حَبْرِ الإمامِ النافعِ الضّرّارِ",83,"ر",1,0],["حتى كأنّي قد عدَلْ","تُ عن الصّراطِ المستقيمِ",84,"م",1,0],["حتى كأن منَ المشا","رق عسكراً تغزو المَغارب",85,"ب",1,0],["حتى كأنك يا عباسُ متّصلٌ","في نسبةِ الفضلِ بالعباسِ من مُضرِ",86,"ر",1,0],["حتى كأن اللهَ لمْ","يَخلُقْ لشغْلِ البالِ غَيري",87,"ر",2,0],["حتى كأنّ الشمسَ فيه","غادةٌ تحتلُّ حَذْرا",88,"ر",2,0],["حتى كأن اللهَ جلّ جلالُه","أوحى له وكأنّه أوحى لها",89,"ل",3,0],["حَتَّى كَأَنِّي في الْجَلالَةِ جَعْفَرٌ","وَكَأَنَّ هارُونَ الرَّشيدَ نَديمي",90,"م",2,0],["حتى كأن وبلدت في ثوب مولده","فواكبت قلبه الصابي كآيته",91,"ت",2,0],["حَتّى كَأَنَّ تُرابَها مِن غَيرِها","يُفدى لَها مِن رَملَةٍ وَصَحاري",92,"ر",2,0],["حَتّى كَأَنَّ حَديثَهُ وقَديمَهُ","لَيلٌ تَلَفَّعَ مُدبِراً بِنَهارِ",92,"ر",1,0],["حتى كأنّ خليجَ قلبي ليس في","صدري ولا سيفَ انتصاري في فمي",93,"م",2,0],["حتى كفى اللّهُ فمُدَّت يدٌ","طُولَى يقي اللّهُ لها مَن تقي",94,"ق",2,0],["حتى كأنك لم تقُدْ ملمومةً","يُومَى إليك أمامَها ويُشارُ",95,"ر",1,0],["حتى كأنّ معيشةً","لم يحلُ فيكِ مُرارُها",96,"ر",3,0],["حتى كأنَّ العار أخذك مذنباً","أولاً تكون من الغوادي أهتنا",97,"ن",2,0],["حتى كأنَّ ديارهم خلقت","مذ كنَّ أطلالا بل أهل",98,"ل",1,0],["حتى كأنَّ ظبي سليمان قضيت","بفساد ما طبعتْ يدا داوود",99,"د",1,0],["حَتّى كَأَنَّكَ يُتَّقى بِكَ دونَهُم","مِن أُسدِ بيشَةَ خادِرٌ مُتَبَسِّلُ",100,"ل",1,0],["حتّى كأنَّ عندَها","مِنَ الجَوى ما عندي",101,"د",2,0],["حتى كأنَّ عليَّ ضربةَ لازبٍ","في