{"poems":[[79,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[119,"واعظمقوة للمرء حيا","https://www.aldiwan.net/poem41239.html","عموديه"],[216,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[216,"منازل للأحباب غبر طوامس","https://www.aldiwan.net/poem37874.html","الطويل"],[412,"محل العلى أني حللت محلها","https://www.aldiwan.net/poem50133.html","الطويل"],[5790,"ما غير البعد وجدي فيك يا قمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=112045",""],[6259,"محلَّ العلى أنى حللتَ محلّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59395&r=&rc=43",""]],"verses":[["متَى ظَعنَ الحيُّ الجميعُ وأصْبَحوا","كَما افْتَرَقَ الحُجّاجُ في ليْلَةِ النّفْرِ",0,"ر",1,0],["مَتى ظَنَّتِ الأَيّامُ أَنَّكَ جازِعٌ","أَوِ اِستَشعَرَت في فَلِّ صَبرِكَ مَطمَعا",1,"ع",2,0],["متى ظلم الزمان صحيح حق","تقوم لنصره غيبا حروب",2,"ب",1,0],["متى ظعنت منه ظبا الأنس غدوةً","فَظَلّتْ ظباءُ الوحشِ فيه فَتَرْتَع",3,"ع",1,0],["متى ظعنَ الأهلونَ منها وبوَّعَتْ","بساطَ الفيافي نوقُهم والقَنَاعسُ",4,"س",1,0],["مَتى ظَمِئَت منّا قَرائِحُ فَهمنا","فَأَنتَ بِريٍّ من نُهاكَ تَعُلُّها",5,"ل",3,0],["متى ظمئت إلى لقياك أوردني","منك الهوى عذب ورد ما له صدر",6,"ر",1,0],["متى ظمئت منا قرائحُ فهمنا","فأنت بريّ من نهال تعلّها",7,"ل",3,0]]}