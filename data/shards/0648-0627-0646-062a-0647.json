 إمتمايل.!","https://www.poetsgate.com/ViewPoem.aspx?id=51298",""],[5843,"أعطني حريتي اطلق يديه","https://www.poetsgate.com/ViewPoem.aspx?id=51302",""],[5956,"فراغ","https://www.poetsgate.com/ViewPoem.aspx?id=181952",""],[6001,"امل عمري","https://www.poetsgate.com/ViewPoem.aspx?id=404",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6082,"حلم متعثَر","https://www.poetsgate.com/ViewPoem.aspx?id=59182",""],[6100,"كحيلان","https://www.poetsgate.com/ViewPoem.aspx?id=52549",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[231,"لماذا أحبك !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79161&r=&rc=35",""],[6225,"قوسُ الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80920&r=&rc=189",""],[6225,"تقمُّص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78046&r=&rc=131",""],[6305,"خُذِي قلَمِي ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87345&r=&rc=18",""],[6315,"محاريب الحيرة .. حيرة الفراديس!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87576&r=&rc=1",""]],"verses":[["وانتهت حيث انتهى الشوط بها","فاطمأنّت تحت أستار الغياب",0,"ب",1,0],["وَإِن تَهلِك جُؤيُّ فَإِنَّ حَرَباً","كَظَنِّكَ كانَ بَعدَك موقِدوها",1,"و",3,0],["وَأَن تُهدي السَلامَ إِلَيَّ غِبّاً","وَلَو في بَعضِ أَنفاسِ الرِياحِ",2,"ح",1,0],["وانتهزْ ما تشتهيه","إنما العيش مناهِز",3,"ز",1,0],["وَإِن تَهادَت غُصونٌ","وَإِن تَسارى عَبيرُ",4,"ر",1,0],["وَإِن تَهجُروها فَذَلِكَ أَولى","فَإِنَّ فِلِسطينَ مُلكٌ لَنا",5,"ن",2,0],["وَاِنتَهَت إِمرَةُ البِحارِ إِلى الشَر","قِ وَقامَ الوُجودُ فيما يَشاءُ",6,"ا",2,0],["وَاِنتَهى الدينُ بِالرَجاءِ إِلَيهِ","وَبَنو الدينِ إِذ هُمُ ضُعَفاءُ",6,"ا",2,0],["وانْتَهَرَتْني فَمِتُّ مِنْ فَرَقٍ","يا حُسْنَها في الرِّضَا ومُنْتَهِرَهْ",7,"ر",2,0],["وانتهبُ الحَيَّ اللَّقاحَ وأكتفِي","بريعانِ عزمي عن طِرادِ التجاربِ",8,"ب",1,0],["وَإِن تَهجُ آلَ الزِبرِقانِ فَإِنَّما","هَجَوتَ الطِوالَ الشُمَّ مِن هَضبِ يَذبُلِ",9,"ل",1,0],["وانتهاك الحريم تحت رواق","الملك وهن على ملوك الرواق",10,"ق",1,0],["وانتهى بعدك الجميل فلا فض","لٌ لمسد ولا يدٌ بيضاء",11,"ا",2,0],["وَأَنتِ هَمِّيَ في أَهلي وَفي سَفَري","وَفي الجُلوسِ وَفي الرُكبانِ إِن رَكِبوا",12,"ب",3,0],["وَإِن تَهجُ عُليا طَيِّئٍ تَلقَ طَيِّئاً","إِلَيها تَناهى نَعتُ كُلَّ كَريمِ",13,"م",1,0],["وَأنتَ هُمَامٌ دَبَّرَ المُلْكَ رَأْيُهُ","خَبِيرٌ بِأحْوَالِ الزَّمَانِ بَصِيرُ",14,"ر",1,0],["وَأنتَ هُمامٌ قَدَّمَتْهُ ثَلاثَةٌ","لها المُنْتَهَى قَوْلٌ وَفِعْلٌ ومَنْظَرُ",15,"ر",1,0],["وَانتَهى لِلباهِياتِ كَما","كُسِرَت فَتخاءُ مِن لَهَبِ",16,"ب",1,0],["وَإِن تَهَجَّدتَ لَم تُعدَم ثَوابَ تُقاً","وَإِن هَجَدتَ فَإِنَّ اللَيلَ مَهجودُ",17,"د",1,0],["وَانْتَهَى اليأسُ مِنكَ وَاستشعَرَ الوَجْ","دُ بأنْ لا مَعادَ حتى المعادِ",18,"د",1,0],["وانتهت سلطة البلاد لقوم","خلقوا للرُّشى واللسرقات",19,"ت",1,0],["وانتهكَ الحيُّ دماءَ الحيِّ","من أجل ميْت غابر وحيِّ",20,"ي",1,0],["وانتهز الفرصة في استدراكها","أوامر الله وما عنه نهى",21,"ا",1,0],["وانتهى عمره وهل كان إلاّ","في مدى النفس غدوة أو رواحا",22,"ح",2,0],["وانتهى العهد كأنّ لم يبتديء","أو تلاقى البدء فيه والختام",23,"م",1,0],["وأن تهبِطَ الوديانَ ليلاً لريبةٍ","وأن ترتقي صُبحاً على عَجَلٍ هُضْبا",24,"ب",2,0],["وإن تهجّدْتَ، لم تعدَم ثوابَ تُقًى","º وإن هَجَدْتَ، فإنّ الليلَ مهجود",25,"د",1,0],["وإنْ تهجُ عليَا طيِّىء ٍ تلقَ طيِّئاً","إِلَيْها تَنَاهَى نَعْتُ كُلِّ كَرِيمِ",26,"م",1,0],["وانتهز فرحة الزمان وأقبل","وأغنم الصفو هاجراً للمُليمِ",27,"م",1,0],["وإن تهادى تهادت","أردافُه تتردَّف",28,"ف",1,0],["وإن تهزئي بالعلجِ والجلفِ أنعمي","على عربيٍّ من ذويكِ صميم",29,"م",1,0],["وانتهز فرصة الزمان وبادر","بغتات الحمام والأسقام",30,"م",1,0],["وَاِنتَهِز فرصةَ الحياة وحاذِر","أَن تُرى نادماً ولات أوانِ",31,"ن",1,0],["وانتهى سرها إليه فما أغفى","ومن حوله الكسالى نيام",32,"م",1,0],["وانتهينا فبدأنا","وبدأتا فانتهينا",33,"ن",2,0],["وَاِنتهز فُرصة الزَمان فَأَحلاه","يَوم أُنسٍ صَفا فَطابَ فَطالا",34,"ل",2,0],["واِنتهز فُرصةَ الرباح","وَاِقتطف زهرة الربى",35,"ب",2,0],["وَاِنتَهز فُرصَة إِسعاف المُنى","بِالهَنا الدائم وَاِهجر مَن لَحا",36,"ح",2,0],["وَاِنتَهِز فُرصَة المَسَرّات فيها","بِغَدير وَغَرّد وَغوان",37,"ن",1,0],["وَاِنتَهبنا اللَذّات في غَفلَة الدَه","ر وَنادى الغَرام هَل من داع",38,"ع",1,0],["وانتهَتْ حَيرتي فصَيرَّتُ في أم","ري إلى رأيهِ الكريمِ اخْتِياره",39,"ر",2,0],["وانتَهى الحالُ إلى أن واصَلوا","فتَواهَبْنا بِداياتِ الجفَاء",40,"ا",2,0],["وأنتهبُ الأيامَ حتّى كأنّني","أُدافع من بعد الحلولِ منيَّتي",41,"ت",2,0],["وأنت هو الراعي الحقيقيْ كبطرسٍ","رعيتَ خرافاً في مروج المحامد",42,"د",1,0],["وانتهى لما تناهى","ومضى عنا ومرا",43,"ر",2,0],["وإن تهملوها فالوبال عليكم","ويلقاكم موت وقبر ومحشر",44,"ر",1,0],["وانتَهِبْها فرصةً ممكنة","قبل أن تمضي سدًى أو تتندّم",45,"م",1,0],["وانتهزها فُرْصةً قد أمكَنَتْ","فاغتنمها واتَّخذها مغنما",46,"م",2,0],["وانتهبها لذَّةً إنْ تنقضِ","يا نَديمي أعْقَبَتْك الندما",46,"م",2,0],["وأنت هادٍ لها في كل مشتَوَرٍ","وأنتَ مقدامُها في كل مشتجر",47,"ر",1,0],["وانْتَهَتِ الحالُ إِلى أَنَّني","جعلتُكُمْ قِبْلَةَ مِحْرابي",48,"ب",2,0],["وانتهى في الفضل من حيث ابتدا","ما تثنَّى غصنُه حتى استقاما",49,"م",2,0],["وانتهى حيث لا يَرَى النجمُ في الأف","ق صعوداً ولا الهلالُ مسيرا",50,"ر",2,0],["وَاِنتَهِز فُرصَةَ الشَبيبَةِ فيها","لا تَكُن مِن عِصابَةِ الأَشقِياءِ",51,"ا",2,0],["وانتهض وارفع كفوفاً","فسحاب الجود ماطر",52,"ر",1,0],["وانتهضوا نحو ابن هند إذ نهض","بهم علي نحو ذاك وانقبض",53,"ض",1,0],["وأَنت هو البَرُّ الَّذي شَهِدَتْ لَهُ","بِذَلك أَبرَارٌ لَعَمري وفجَّارُ",54,"ر",1,0],["وإِن تَهْجُروا مَنْ وَاصلَ السّهْدَ جَفْنُهُ","وَهَذَّب فِيكم عِشْقَهُ فَتَهَذَّبا",55,"ب",2,0],["وانتهب لَذَّةَ الزَمانِ فَيا رُبَّ","سُرُورٍ نَهبتهُ مِن زَماني",56,"ن",2,0],["وَانته الآن عن خطاك وَقاطع","مجرماً يَرتجي زَوال السقام",57,"م",1,0],["وَاِنتَهَزنا مِن الزَمان المواسي","فُرصة مِنهُ في المَسَرة تُحمد",58,"د",1,0],["وَانتهز لي فُرصة يَمضي بِها","مثل أَقراني عَن الجسم السقام",59,"م",1,0],["وانتهى المستَقرُّ بين وعيد ال","متحدي وموعد الخلابِ",60,"ب",1,0],["وانتهى المشترطونا","بالذي يقترحونا",61,"ن",2,0],["وانتهى الشعب من قضيته الكب","رى بمحتوم حكمه وقضائه",62,"ا",3,0],["وانتهى الموعد الخفي إلى من","في يديه التأخير والتقديم",63,"م",1,0],["وانتهى العابثون إلا فريقاً","لم يزل في عناده وضلاله",64,"ل",2,0],["وانتهز الفرصة قب","ل فوتها واستدرك",65,"ك",1,0],["وانتَهكوا الشبان وَالفتيانا","واستأسروا النسوان وَالصبيانا",66,"ن",2,0],["وَأَنتَ هَل صرت نَديم المَلكِ","وَقاضِياً محتضِناً بالملكِ",67,"ك",1,0],["وَانتَهَزَ الصَياد غاية الفُرص","لِيَضع الإِثنين في قَلب القَفَص",68,"ص",1,0],["وَإِن تَهوَ البِقاعَ فَلَيسَ غَرواً","هَوى أَهلِ البِقاعِ هَوى البِقاعِ",69,"ع",1,0],["وأنت هل تدرين كم خاطر","أضأت يا حلوة في فكري",70,"ر",2,0],["وأنت هل تدرين يا ديمتي","أنك ذاك الخصب في شعري",70,"ر",2,0],["وانتهب الدر على غرة","فما بقى في الكون إلا الصدق",71,"ق",1,0],["وانْتِه لكلِ الناس روضٍ وجنّات","خيرك شِمَل كل بقعةٍ من ثراها",72,"ا",3,0],["وانتهَتْ لآمال بي هَمّ وعَذاب","وآشِقَنا المملك من ظلْم المليك",73,"ك",1,0],["وان تهت في بيدا المعاني فلا غنى","لمثلك عن ايضاح معناه فاسأل",74,"ل",1,0],["وانتهى قصده وادرك مجدا","جر في شاوه على الكون ذيلا",75,"ل",2,0],["وانتهت دولة الشباب كأن لم","تك كانت لم تبق من تذكار",76,"ر",1,0],["وانتهى نقصه وعشش بازُ ال","شيبِ في رأسهِ وطار غرابُه",77,"ب",2,0],["وانتهزوا فرصة دهر صفا","فالدهر مجبول على غدره",78,"ر",2,0],["وَانتهز الفُرصة إِن الفُرصة","تَعود إِن لَم تَنتهزها غَصه",79,"ه",1,0],["وَاِنتَهَبوا مالَهُ وَشَنّوا ال","غاراتِ فيما حَواهُ شَنّا",80,"ن",2,0],["وانتهى وارعوى وَضحا وَنوىَ","وَرَعى وطوَى غيّه الوَجلُ",81,"ل",1,0],["وانتهز فرصة الليالي التذاذاً","فالليالي تمر مر الرياح",82,"ح",1,0],["وَأَنتِ هَوى النَّفس مِن بَينهم","وَأَنتِ الحَبيبُ وَأَنتِ المُطاع",83,"ع",1,1],["وانتهاء الحلاحل الجهبد الفا","ئق مجدا من ارتقاك ابتداء",84,"ا",2,0],["وأن تهب رياح الوصل عاطرة","فتنشق الروح من رُبا اللِّقا أرجا",85,"ج",2,0],["وانته كنز هذا الجيل كلّه","ورمز الخفر والنّفس الأبيّه",86,"ي",2,0],["وانته ذخرنا وانته حمانا","ايلي قلّت من النّاس الحميّه",86,"ي",2,0],["وانته فوق المراتب المراتب ذهب","والنياشين دونك قدتها للأمام",87,"م",1,0],["وَانتهز فُرصة أَيام الصِبا","لا تُؤخر إن للتأخير آفه",88,"ف",2,0],["وانت همام زانه الفضل والحجى","ومنه على غير النهى ما انطوى البرد",89,"د