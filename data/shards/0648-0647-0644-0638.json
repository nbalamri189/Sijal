{"poems":[[39,"وهل ظنون أوس إلا كأسهمه","https://www.aldiwan.net/poem6874.html","البسيط"],[70,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[310,"بسعيك تبلغ الرتب العظام","https://www.aldiwan.net/poem56409.html","الوافر"],[422,"إذا اضطرم البرق اليماني في الدجى","https://www.aldiwan.net/poem53836.html","الطويل"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[463,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[510,"الراحل","https://www.aldiwan.net/poem61092.html","الطويل"],[567,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83257","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53916","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62535","الطويل"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178073","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109728","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204505","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74172","الطويل"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113703","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93307","الطويل"],[4830,"وَعْدُ اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=213549",""],[4119,"يذود الظبى عنهن والحدق الصيد","https://www.poetsgate.com/ViewPoem.aspx?id=16115",""],[1362,"سقتك وهناً يا دارها الديم","https://www.poetsgate.com/ViewPoem.aspx?id=127724",""]],"verses":[["وهل ظنون أوس إلا كأسهمه","والنبل إن هي تخطىء مرةً تصب",0,"ب",1,1],["وهل ظَبَيَاتُ الرّقْمَتَيِن بُعَيْدَنَا","أَقَمَنا بها أمْ دونَ ذلكَ مانع",1,"ع",1,0],["وهل ظِلُّ ذاك الضّال شرقيّ ضارجٍ","ظَلِيلٌ فقد روّتْهُ منّي المَدامع",1,"ع",1,0],["وَهل ظَفرت بمكرمةٍ يمينٌ","وَليسَ لَها بعروتكَ اِعتصامُ",2,"م",1,0],["وهل ظنَّ أنَّ الدّمعَ يعقب راحة","من الوَجد حتَّى خيَّبته ظنونه",3,"ن",2,0],["وهل ظَفِرَتْ هِمَّتِي من هُمُومِي","بِثَأْرٍ مُنيمٍ وَوِتْرٍ بَوَاءِ",4,"ا",2,0],["وهل ظبياتٌ بين جوٍّ ولعلعٍ","تمرُّ على وادي الغضا وتعودُ",5,"د",1,0],["وهل ظلّ في العين كفاءُ دموعهِ","فيصفحَ حبٌّ ليتنا ما عرفناهُ",6,"ن",3,0],["وهل ظَبَياتُ اُلبانِ أصبحنَ بعدنا","أوانِسَ أم كالعهدِ هُنَّ جَوافِلُ",7,"ل",1,0],["وَهَل ظَعائِنُ ذاكَ الرَكبَ عالِمَةً","إِنَّ النَوى بَينَ أَرواحٍ وَأَجسادِ",8,"د",1,0],["وهل ظفِرتْ كفِّي بأفضلِ فائدٍ","يسرّ أوِدَّائِي وأهلَ ذِمامِي",9,"م",2,0],["وهل ظالم أرخى بذا العصر مفسد","ونور بدا من صالح يكشف الظلمْ",10,"م",1,0],["وهل ظباؤكن في أرجائه","تشب فيه مرحاً وتستبق",11,"ق",1,0],["وهل ظن من فرط الحماقة أنهُ","يكون بعدوى لمسهم متضلعا",12,"ع",2,0],["وهل ظلّ شيء من شقائي حسمته","تضاف له أرباحه والفوائد",13,"د",1,0],["وَهَل ظبيات الكرخ يَخرجن شَرعاً","وَدون حِماهن الأَسنة وَالنَصل",14,"ل",1,0],["وهل ظلُّ ذاك الدَّوحِ ضافٍ وغصنه","وريقٌ وبدر الحيِّ فيه يقامُ",15,"م",1,0],["وهل ظبياتٌ في ضميرٍ سوانِحٌ","وعين المها هل قادهنَّ زمامُ",15,"م",1,0],["وهلْ ظِلُّ ريعان الشبيبة عائدٌ","عليّ ولُقيان الأَحِبّة مَرْدود",16,"د",1,0],["وهل ظلَّ منّي لقوسَيْكَ مرمى","وصيَّرتَ ليلَ الأسرِ صباحْ",17,"ح",1,0],["وهل ظل ريعان الشبيبة عائد","علاي ولقيان الأحبة مردود",18,"د",1,0],["وهل ظباء النقا بوجرة أم","طارت بهن الوخادة الرسم",19,"م",1,0]]}