{"poems":[[74,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[99,"يا أبا الأشواق غن","https://www.aldiwan.net/poem24584.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85424","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42684","السريع"],[190,"إني اعتللت فلم أجد لي عائدا","https://www.aldiwan.net/poem43879.html","الكامل"],[234,"لم أفارقكما اختيارا وهل تختار","https://www.aldiwan.net/poem50849.html","الخفيف"],[240,"يالك من ليل حجا","https://www.aldiwan.net/poem31597.html","مجزوء الرجز"],[302,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[412,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[443,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[466,"شرف الدولة بحر زاخر","https://www.aldiwan.net/poem15129.html","الرمل"],[484,"كأس من الراح أم كأس من الأدب","https://www.aldiwan.net/poem36934.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56126","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82526","الرمل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103712","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75919","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112578","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100188","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61269","الخفيف"],[4755,"صَلَّيتُ حتى غَادَرَ المِحرابُ","https://www.poetsgate.com/ViewPoem.aspx?id=196533",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5956,"الأديان نبعُ الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194896",""],[6008,"الواسطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=60803",""]],"verses":[["لا أهملتك عيونُ السحب هاملة","ولا بعينيك ما يلقى الحشا ولقي",0,"ق",2,0],["لا أهنيك ولكن","كل مخلوق أهني",1,"ن",2,0],["لا أَهجر الروض ما كا","ن بالرّوائِح يدلي",2,"ل",2,0],["لا أَهْتَدِي فِيهَا إِلَى حِيلَةٍ","تَقِي حَيَاتِي مِنْ يَدَيْ مَصْرَعِي",3,"ع",2,0],["لا أهل سامرّا رعوا لي ما مضى","عند الشدائد لا ولا بغداذ",4,"ذ",1,0],["لا أُهنّيكما بعِيدٍ لأَنّ ال","عيدَ نَقْصٌ لَنا مِن الآجالِ",5,"ل",1,0],["لا أَهتَدي لِحاجَتي","وَفي اللَيالي عِبَرُ",6,"ر",1,0],["لا أَهتَدي وَاللَيلُ معتَكِرٌ","إلّا بنَشرِ المِسك والنَدِّ",7,"د",1,0],["لا أَهنِّيك إِذ وليت لِعِلمي","أَنَّ ما ازددتَ فيهِ عَنكَ يَقِلُّ",8,"ل",1,0],["لا أهنّي بالصوم لكن يهنّى ال","صوم بمجدكم والصيام",9,"م",1,0],["لا أهَنِّيهِ بتجْديدِ عُلاً","كل فخر بعُلاهُ يَفْتَخِرْ",10,"ر",1,0],["لا اهتمامه بالآداب ما انبعثت","بواعث الود في القلبين كالشهب",11,"ب",1,0],["لا أهل موّالٍ ولا زجلٍ ولا","أهل المعنّى مطلقاً بي تعلقُ",12,"ق",1,0],["لا أُهَنّيكَ بِطوس","بَل أُهَنّي بِكَ طوسا",13,"س",2,1],["لا اهتدي مع طول ما حاولته","لرضاه في الدنيا ولا للمهرب",14,"ب",1,0],["لا أُهنِّيكَ بِالمَلابسِ فَاعلَم","بَل أُهَنّي بِكَ المَلابسَ تَترى",15,"ر",2,0],["لا أهلنا تركوا وما ترك البلى","بديارنا السوداء غير رسوم",16,"م",1,0],["لا أهتدي منهج القول البليغ ولي","قلب غدى بيد الأحزان منزعا",17,"ع",2,0],["لا أَهنّي مَولاي بِالعيدِ إِلا","خَوفَ تَعطيلِ سُنَّةٍ تُعتادُ",18,"د",1,1],["لا أَهْلَ لِي في الأَرضِ إني مَوجةٌ","طُوِيَت غَداةَ نَزِيفِها الأَنسابُ",19,"ب",1,0],["لا أهل فوق العدل عند أميرها","الكل في هذا المقام يقاسي",20,"س",2,0],["لا أهتدي بسوى الإله عقيدة","إني إلى كل التحزُّبِ نيرُ",21,"ر",1,0],["لا أهملت بالواجب والامر نتمشى به","وسر العمل في داخل الصدر شايلها",22,"ل",3,0]]}