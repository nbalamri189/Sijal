{"poems":[[97,"غادة من الاندلس","https://www.aldiwan.net/poem60150.html","عموديه"],[93,"دمية حسناء تغري النظرا","https://www.aldiwan.net/poem8870.html","عموديه"],[94,"سرت في الروض","https://www.aldiwan.net/poem38960.html","الرمل"],[68,"ليالي الحمى ما كنت إلا لآليا","https://www.aldiwan.net/poem40988.html","الطويل"],[33,"أتحذر وشك البين أم لست تحذر","https://www.aldiwan.net/poem42506.html","الطويل"],[50,"ريب الدار مطلبه بعيد","https://www.aldiwan.net/poem62588.html","الوافر"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39377","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54524","الكامل"],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[228,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[275,"ما جئت ألتزم القوام الناحلا","https://www.aldiwan.net/poem35412.html","الكامل"],[275,"لما وردت الماء صار لهيبا","https://www.aldiwan.net/poem35420.html","الكامل"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[275,"هذا مليك القبة الزرقاء","https://www.aldiwan.net/poem35689.html","الكامل"],[353,"نظرت من خلل السج","https://www.aldiwan.net/poem20746.html","مجزوء الرمل"],[422,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[457,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[469,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[543,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[567,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54060","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202123","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79916","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114004","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49569","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125374","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119238","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28476","السريع"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88639","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137126",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75874","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109802","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87645","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87551","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129426","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131057",""],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44684","الخفيف"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199086","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94401","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94554","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66116","المتقارب"],[4767,"طود العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=94353",""],[4767,"عقد زينب","https://www.poetsgate.com/ViewPoem.aspx?id=179946",""],[4767,"مشاهد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=180319",""],[4859,"وهمست في أذنيه!","https://www.poetsgate.com/ViewPoem.aspx?id=213586",""],[4119,"بدينك يا قس بربارة","https://www.poetsgate.com/ViewPoem.aspx?id=16171",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[3591,"تحكي الإمام اليازجيّ بطلعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=149438",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5186,"خلوا عقيم البحث في خلخالها","https://www.poetsgate.com/ViewPoem.aspx?id=156494",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5302,"وسبت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=201220",""],[5444,"عروس جرونوبل","https://www.poetsgate.com/ViewPoem.aspx?id=205530",""],[5452,"بلادي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=111448",""],[5596,"إلى التي..","https://www.poetsgate.com/ViewPoem.aspx?id=206712",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5703,"ليلى والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=206325",""],[6069,"متى نجعت في لوعتي وبلابلي","https://www.poetsgate.com/ViewPoem.aspx?id=105701",""],[2575,"روضة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=10282",""],[6142,"أسفح اللوى لا صافحتك الحوادث","https://www.poetsgate.com/ViewPoem.aspx?id=155731",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""]],"verses":[["فَرَنت شامخةً أحسبها","فوق أنساب البرايا تتعالى",0,"ل",2,0],["فَرَنَت عَن فاتِر وَاِبتَسَمَت","عَن نَظيمٍ قَد أَكَنَّ الدُرارا",1,"ر",2,0],["فَرَنَتْ نَحْوَ جَلالِ الكَوْ","نِ جَوْناءُ اللِّياحِ",2,"ح",1,0],["فَرَنَّقَ مِنكِ الدَهرُ ما كان رَيَّقاً","وَكَدَّرَ مِنكِ البُعدُ ما كان صافِيا",3,"ي",2,0],["فَرُنِّحَ قَلبي فَهوَ يَزعَمُ أَنَّهُ","سَيَهلِكُ قَبلَ الوَعدِ أَو سَوفَ يَفتُرُ",4,"ر",1,0],["فَرَنَّقَ مُغضَباً لَحَظاتِ عَينٍ","عَلَيهِ بِغَيرِ قَوّادٍ تَقودُ",5,"د",1,0],["فِرَنْدٌ إذا مَا اعْتَنَّ لِلعَيْنِ رَاكِدٌ","وبَرقٌ إِذَا مَا اهْتَزَّ بالكفِّ لامِعُ",6,"ع",1,0],["فَرَنَا إِلَيْهَا حَبرُ رَوُمَةَ وَانْثَنَى","يَهْدِي إلى النِجْمَينِ طِيبَ ثَنَاءِ",7,"ا",2,0],["فَرَنا وهبَّ فجنَّحَت","قلبي حُمَيّا الإحوِرارِ",8,"ر",1,0],["فَرَنَّ في مِسمَعِهِ المهزَلَه","وَرَجَّعتَها قُبَّةُ الهَيكَلِ",9,"ل",1,0],["فرنت إليَّ حَييِّةً وتبسَّمت","فرأيتُ أسهمَها تُصيبُ مَقاتِلا",10,"ل",2,0],["فرنت إليَّ وأغمَضت أجفانها","ففَتَحتُ قلبي للنّعيمِ رَحيبا",11,"ب",2,0],["فرنا إليها قائلاً في نَفسهِ","أَبأكلِ تفّاحٍ يكون رَدانا",12,"ن",2,0],["فَرَنت إليهِ تقولُ سِر وارجع فقُل","أبلى بلاءَ الباسلينَ أخُوك",13,"ك",1,0],["فَرنَوتُ مبتهجاً وقلتُ مناجياً","والضوءُ في الأجفانِ والأحشاءِ",14,"ا",2,0],["فَرَنَتْ لي بِفُتورٍ","وَرَمَتْني بِفُتونِ",15,"ن",1,0],["فرن المؤيّد جوهراً في جوهرٍ","فرأت به بغداد سعْدَ قران",16,"ن",1,0],["فِرَنْجَةُ أَعْلاهُ وقَشْتِلُّ أُسُّهُ","وَسلْمُكُ أَرْكَانٌ لَهُ وَدَعائِمُ",17,"م",1,0],["فرنَّح الأعطافَ مني وانثنى","فكري لما رامَ سميعاً طائعا",18,"ع",2,0],["فرنت مقاضته إلى شم","س من عين أرمد",19,"د",1,0],["فرنسا قضَت حقا وفَيتَ بعهدِه","فهل لوفاءٍ بينكم كان مَوعِدُ",20,"د",1,0],["فرَنا الشَّقيقُ بأعينٍ مُحمَرَّةٍ","غَضَباً وأبدى منهُ قَلباً أسْودَا",21,"د",2,0],["فرنت إليَّ من الحياء بمقلةٍ","فتانةٍ ما كحلها إلا الكحل",22,"ل",1,0],["فَرَنَّتْ وأنَّتْ من شجاها وأسْبَلَت","من العين ماء فار من فورة الصدر",23,"ر",1,0],["فرَنت بناظرتي عقيلة رَبربٍ","بكَرت تريعُ إلى نِطافِ غديرها",24,"ر",3,0],["فَرَنَت بالتفاتَةٍ من مهاةٍ","مخرفٍ بالصريمِ ترقُبُ عينا",25,"ن",2,0],["فرنا إلى مَجْرى الكؤو","سِ وأنتَ أعلمُ بالخليع",26,"ع",1,0],["فَرَنَت إليه بمُقلَةٍ فتَّانةٍ","وكسى اصفرارَ جبينها وردُ الحيَا",27,"ا",1,0],["فرََنا وقالَ سألتمُوا فأجبتُكُم","وعَلَىَّ حقُّ سُؤالِ الاستفهامِ",28,"م",1,0],["فَرَنا بلحظِ جُفُونِهِ وأَجابني","شكراً ولكن حانَ وقتُ مَنَامي",28,"ي",1,0],["فرنا إلي وقال لي متبسماً","ليس الكريم على القنا بمحرَّم",29,"م",1,0],["فَرَنَّحَتنا لَهُم نَشوَة","يَطرَبُ مِنها الرَّاحُ وَالكُوبُ",30,"ب",1,0],["فرن بفوده سيفي فاهوى","كما انعطف الشَقيق على الشَقيق",31,"ق",1,0],["فرنت اليك فكنت اكرم ذائد","عن حوضها في يومها المشهود",32,"د",1,0],["فِرِندٌ لَو اَنَّ الجِنَّ لَيلاً تَمُرُّ بي","سَناءً رَأَتها الأُنسُ مِن بَعدِ خِفيَةِ",33,"ه",1,0],["فرنت اليه بمقلة فتانة","وكسا اصفرار جبينها ورد الحيا",34,"ا",1,0],["فرنت نحو صحبها بانكساف","خوف نقص يعزي اليها اتهاما",35,"م",2,0],["فرنسيس الزَنانيريُّ انشا","زِفافاً قد زها جاهاً وعزّا",36,"ز",2,1],["فرنا إليهِ عودُها واجابُه","ان كنتَ مَن غنى فاني من نطق",37,"ق",1,0],["فرنحني العبير ولست أدري","أضاع المسك أم هل ضاع عقلي",38,"ل",2,0],["فرنت وقالت إنّ مث","لي لا تعيش بلا ظهير",39,"ر",1,0],["فَرنوتُ إِلى السَماءِ بِجفنٍ","شابَهَ النَهرَ سَكبَهُ وَالغَماما",40,"م",2,0],["فرنوا إلى الوطن الشريف برحمة","طارت بها صيتا مُطاةُ الهوجل",41,"ل",1,0],["فَرَنَت نحوي بطرف ساحرٍ","جاوز الحدَّ بتعذيب الرجال",42,"ل",1,0],["فرنت وحنت ثم أنت بحرقة","على فنن من ناضر الدوح أملدا",43,"د",2,0],["فرنكو وزير الأنس والرجم والوَلا","غمار الجدا والجود كنز الزخارفِ",44,"ف",1,0],["فرنكو خطير القدر تعريبُ إسمه","فخرٌ وللأحرار قد جاءَ منجِدا",45,"د",2,0],["فَرَنَّتْ سهامَ الرَّزايا رَنِيناً","وصَلَّتْ سُيُوفُ البَلايا صَلِيلا",46,"ل",2,0],["فرنت لها في الداجيات بمقلة","خرساء لا تقوى الكلام عوالم",47,"م",1,0],["فرَنَت له الآماق حاملةً","أملاً تُصان بظله الذمم",48,"م",1,0],["فرنت إلى شباكِ نافذةٍ","منها يطل على الورى يُسْر",49,"ر",1,0],["فرنا إلي وقال لي متبسما","أناً مذ عرفتك ماعرفت سوى الوطن",50,"ن",1,0],["فرنجية ساكن عقدها","وزنارها قلق المجلس",51,"س",1,0],["فرنت للقصور غيرى شجاها","أخيل من لواحظ الكهرباء",52,"ا",2,0],["فرنت نحو ضيفها علّ عُتباً","يَرْعوي منهُ أو يَسوق اعْتذارا",53,"ر",2,0],["فرنا إليّ بأعين مملوءةٍ","عطفاً عليّ وكان أكرم باذل",54,"ل",1,0],["فرنا سنا واهتز حسناً مبدعا","بادي السنا يحكي الربيع ثغورا",55,"ر",2,0],["فرنت تقبح روح كل تقد","ونسب كل تجدد بجدالها",56,"ل",3,0],["( فرنسا ) حين تذكرُ ما دَهاها","وكيف أصابها الموتُ الزؤآم",57,"م",1,0],["فرنت إلي بنظرة وتبسمت","في خطوها ولخطوها لألاء",58,"ا",2,0],["فرنسا، والفؤاد، وبعض حبري","جمالٌ يجعل الأيام عرسا",59,"س",2,0],["فرنسا النصارى بالجحافل أجلبت","عليك فقلنا لا تزول حروبها",60,"ب",3,0],["فرنا وأطرق وهو بين مصدقٍ","ومكذبٍ أذنيه كالمتحيّر",61,"ر",1,0],["فرَنَت ثم سلّمت ثم ولّت","وهْي محمرّةٌ لفرط النحيب",62,"ب",1,0],["فَرَنَتْ لَيلى مِنْ كُوَّتِها","تَبكي بِفُؤادٍ مُنْفَطِرِ",63,"ر",1,0],["فرنح في ثوب الملاحة قده","ترنح خوط البانة المتمايل",64,"ل",1,0],["فرنت إلي وقد تألق لحظها","أفديه من لحظ رنا فتاك",65,"ك",1,0],["فرند حسام بالمنية راشحٌ","وصدر قناةٍ بالشواظ منافث",66,"ث",1,0],["فرنا باسماً إليّ بعينٍ","شاع في لحظها الجوابُ السديدُ:",67,"د",1,0]]}