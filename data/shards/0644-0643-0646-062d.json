e.com/ViewPoem.aspx?id=211882",""],[5956,"القهوة وكف المحبوب","https://www.poetsgate.com/ViewPoem.aspx?id=182087",""],[5956,"شهامةُ المرء تبدو من مواقفِهِ *","https://www.poetsgate.com/ViewPoem.aspx?id=182927",""],[5956,"صعبٌ عليكِ تُفارقين حبيبا","https://www.poetsgate.com/ViewPoem.aspx?id=194464",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[5977,"يا نعمة الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=213533",""],[6093,"إنى أرى من صاحبي من ما لا ترى","https://www.poetsgate.com/ViewPoem.aspx?id=190994",""],[6134,"للبيت أنية وفرش منهما","https://www.poetsgate.com/ViewPoem.aspx?id=169585",""],[402,"نهاية الفخر لي في هذه الكلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54056&r=&rc=908",""],[6308,"صوتٌ من الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87726&r=&rc=4",""],[6340,"غادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85846&r=&rc=11",""]],"verses":[["لَكِن حِذاراً مِن أَن يُغَيَّرَكِ ال","دَهرُ فَإِنّي مِنهُ عَلى وَجَلِ",0,"ل",1,0],["لَكِنَّ حَافِظَ إِبْرَاهِيمَ أُنْذِرُكُمْ","لَهُ جَوَانِبُهُ الأُخْرَى مِنَ الْعِظَمِ",1,"م",1,0],["لكنَّ حقِّيَ خسَّسْتَ الرقيبَ له","فَوَقْتُهُ الدهرَ مأخوذٌ بتنحيتِ",2,"ت",1,0],["لكنْ حَديثا عَداوَةٍ وقِلىً","تَهَوَّرَا في غيابةِ الشُّقُبِ",3,"ب",1,0],["لكنَّ حزني لو علمت به","لم يُبقِ لي صبراً ولا جُهدَا",4,"د",2,0],["لَكِن حَماكِ العَقلُ وَهوَ مُؤَمَّرٌ","فَاِنأَي وَراءَكِ في التُرابِ التارِبِ",5,"ب",1,0],["لَكِن حُسَينٌ وَأَمثالُ الحُسَينِ إِذا","ما الناسُ يَومَ حِفاظٍ حُصِّلوا قُلُلُ",6,"ل",1,0],["لكِنَّ حُكْمَ الحقِّ يَصْدُقُ آخِراً","فِيمَا يُقَوِّمُهُ مِنَ الأَقْدارِ",7,"ر",1,0],["لَكِنَّ حُبَّ الأُمِّ أَبْنَاءَهَا","بِهَا إِلى أَسْمَى ذُرَاهُ عَلاَ",8,"ل",2,0],["لكن حرام على عيون","تشهد حسناً ولا تميل",9,"ل",1,0],["لكنَّ حبِّي للترقي غالبٌ","ولذاك صبري يا جليل جميلُ",10,"ل",1,0],["لكن حللتَ من الفؤاد بمنزلٍ","أصبحتَ فيه ربيبَ بيتٍ عامرِ",11,"ر",1,0],["لكن حبّك شافع ومشفع","يغشي محبّك يمنه وأمانه",12,"ن",2,0],["لَكِنَّ حَظَّ العَينِ مِنكَ فَقَدتُهُ","فَالشَوقُ مِنّي لا يَزالُ جَديدا",13,"د",2,0],["لكَ نحوَ أرضِ العربِ لحظُ","أَهَواكَ قيصومٌ وقرظُ",14,"ظ",1,1],["لكنَّ حالاتِ القضاءِ على الورى","شتَّى وهذي الحالُ من حالاتهِ",15,"ت",2,0],["لكن حلال شربها طيب","وفي بني يسجن فاشرب جهار",16,"ر",1,1],["لَكنّ حَسبي أَن أزوّدك الدعا","نوعاً مِنَ العمل الّذي لا يقطعُ",17,"ع",1,0],["لكن حجاهُ اِستصحب الحال الّتي","عُهدت وَلم يعرض لها ما يقطعُ",17,"ع",1,0],["لَكِن حاميهِ بِاللُطفِ الخَفي حَمى","فَالصِدقُ فيالغارِ وَالصَديقُ لَم يَرما",18,"م",2,0],["لكِنَّ حسن تَصبري","أَرجو بِهِ حُسن الخِتام",19,"م",1,0],["لكن حديثي بعدَه","عجبٌ وأعجبَني وزادا",20,"د",2,0],["لكن حقوق قد ثناني الفقر عَنْ","قَضَائها والحقّ دينٌ يُقتَضَى",21,"ا",1,0],["لكنَّ حظَّ هَواكَ من جِسمي ضَنىً","بَادٍ نَفَى نَومِي وأَفْنَى الأَدْمُعَا",22,"ع",2,0],["لكن حكمة ربنا في خلقه","للمؤمنين به دليل مقنع",23,"ع",1,0],["لَكِنَّ حُسْنَ ظَنِّي","هُو مُنْيَةُ المتَمَنِّي",24,"ي",1,0],["لكنَّ حظي لَم يُسا","عِدني فزادَ ألَمَي",25,"م",2,0],["لكنَّ حظِّي لا يزالُ مِشاكِسِي","وعسَى بعطفٍ منكَ يَسمحُ بالسَّماح",26,"ح",1,0],["لَكِنَّ حَقَّ الطَبعُ مَحكومٌ بِهِ","وَالعَقلُ مُرتَبِطٌ بِبَعضِ قُيودِ",27,"د",1,0],["لكن حكى لك خده ال","مصقول صورة ما جرى",28,"ر",2,0],["لَكَ نَحوَ أَرضِ العُربِ لَحظُ","أَهواكَ قَيصومٌ قرظُ",29,"ظ",1,1],["لكنْ حُسْينٌ منهما خَطُّهُ","أشْكَالُهُ في وَضْعِها أحْسَنُ",30,"ن",1,0],["لكنَّ حفظ الملك يق","ضي بالتأهب للمصائبْ",31,"ب",1,0],["لَكِن حَكَت لَونَ خَدَّيهِ وَوَجنته","وَقَد سَقاني فَلا أَصحو ولَم أفقِ",32,"ق",1,0],["لَكِنَّ حُسْنَ الظَّنّ يَدْعُونِي لأنْ","أدْعُوكَ يَا مَنْ بِالْجَمِيلِ تَفَرَّداَ",33,"د",2,0],["لَكن حُكمي بِيدي إِخوة","نَسير في ركبهم حَيث سار",34,"ر",1,0],["لَكِنْ حَقَنْتَ دِمَاءَ قَوْمِكَ مُرْجِئاً","لِلْفَتْحِ إِرْجَاءً بِمَا تَرْجُو يَفِي",35,"ف",2,0],["لكن حفظي للعهود جبلة","كلفي بكم خلق بغيرتكلف",36,"ف",1,0],["لكن حليب البنت يخلط باللَمى","فيفيد من بعيونه سرطان",37,"ن",1,0],["لكنّ حرصي قَادَنِي لِلَطِيفَةٍ","فرأيتُ منه الأَمرَ شِبْهَ عِيَان",38,"ن",1,0],["لَكِن حَقِيقَةُ قَولِهِ أن قَد أتَوا","بِالكِذبِ عِندَ مَصَالِحِ الإِنسانِ",39,"ن",1,0],["لَكِن حَقِيقَةَ قَولِهِم وَصَرِيحَهُ","تَعطِيلُ خَالِقِ هَذَا الأكوَانِ",39,"ن",1,0],["لَكِن حَفِظنَا نَحنُ حُرمَتَهُم وَلَم","نَعدُ الذِي قَالُوهُ قَدرَ بَنَانِ",39,"ن",1,0],["لَكِن حَيَاتُهُم أجَلُّ وَحَالُهُم","أعلَى وَأكمَلُ عِندَ ذِي الإِحسَانِ",39,"ن",1,0],["لَكِنَّ حُبَّكِ أَبلاني وَعَذَّبَني","وَأَنتِ في راحَةٍ طوباكِ طوباكِ",40,"ك",1,0],["لكن حذار الثور مع ذُبابِ","إِن كُنتَ باغي الزُّقرَمِ ذا البابِ",41,"ب",1,0],["لكن حشو الحشا رجاء","... في واسع الجهات",42,"ت",1,0],["لكن حجاب الجهل غطى الحقا","والامر عند اللّه حقا حقا",43,"ق",2,0],["لكنّ حبّ المجد أشعر قلبه","رغم الهوى شيئاً من البغضاء",44,"ا",2,0],["لكن حسنك ذا لقلبي مالك","أتراك من تأميمه لا تحذر",45,"ر",1,0],["لكن حفظ مقامها صعب على","من لم يكن ذا مرة ومراس",46,"س",1,0],["لكن حالي وغن جفا من أهوى","حالٍ أبد عمى لأهل العذلِ",47,"ل",1,0],["لكن حظ الفتى ان ساء في زمن","فالحسن في الخط لم ينفعه منظره",48,"ر",2,0],["لكن حللت بها في غير منزلة","تأتي إليك هديات سنيات",49,"ت",1,0],["لكنَّ حلمكَ يقضى ان تجاملهم","بالرفق مهما أساءتك الاباطيل",50,"ل",1,0],["لكن حكم الدهر جائرٌ على","كل كريمٍ للمعالي انتسبا",51,"ب",2,0],["لكن حزبك أن تقيم مؤَوّداً","فينا وتكشفَ ليل جهلٍ قاتما",52,"م",2,0],["لَكن حَوادث هَذا الدَهر قَد جبلت","عَلى خلاف مُراد غَير مُتَفق",53,"ق",1,0],["لكنّ حلمك بالنجاح","ونيل ما يرجو ضمينه",54,"ن",2,0],["لكن حساده في الناس قد كثروا","إذ صاحب الفضل بين الناس محسود",55,"د",1,0],["لكن حليهن تاج زهر","تعاضدوا بالكف والإبهام",56,"م",1,0],["لكِن حَذارِ بِأَن تَعافَ جَدِيرَهُم","عَطفاً على مَن كَانَ أَكرَمَ مَولِدا",57,"ا",1,0],["لكن حظوظ قسمت بلا تعب","ما حيلتي ان كان خاب جدي",58,"ي",1,0],["لكنَّ حمْلَ الرزايا ليس أثقلَ مِن","حملِ الأمانةِ في وزنٍ وتقدير",59,"ر",1,0],["لكنَّ حكمت يا منيَّة جازمٌ","يا ليتهُ في ذات شخصكِ يُحصَرُ",60,"ر",1,0],["لكن حكم القضا جرى","من سابق الأمر خل لو",61,"و",1,0],["لكنّ حتماً ما قَضَى ربُّنا","تعذيبَ عبدٍ كافرٍ خاتلِ",62,"ل",1,0],["لكن حذار من الزيادة فيه أو","أن ترتأي استعماله محذوفا",63,"ف",2,0],["لكن حَذَونا حَذوَ ما فيه أتى","خيرُ الورى من سنَّةٍ وكتابِ",64,"ب",1,0],["لَكِنَّ حُبّكِ مَاكِرٌ","أَتْقَنْتِ نَسْجَكِ لِلشِّباكِ",65,"ك",1,0],["لكن حبر دواتي جف من الم","وقد خشيت على الأقلام تنكسر",66,"ر",1,0],["لكن حظي عاثر","يعييه أن يتقدما",67,"م",2,0],["لكنَّ حسيناً خلده","الموقف والذكر السامي",68,"م",2,0],["لكنَّ حبلَ وَلائنا يا سيِّدِي","دونَ الحِبالِ بحبلِكم مشدود",69,"د",1,0],["لكنّ حقدَ الماكرينَ ولؤمَهم","ملأ العرينَ مراصداً تترقّبُ",70,"ب",1,0],["لكنّ حكمة ربّنا حُجِبَتْ","في ذي الحياةِ فنجهل العِبرا",71,"ر",2,0],["لكنّ حكمةَ ربّنا تقضي بأنْ","تتغيّرَ الأجواءُ والمنظورُ",72,"ر",1,0],["لكن حلاة الفارس يداعب الخيل","ويشوف نفسه بين هالناس خيال",73,"ل",1,0],["لكنّ حظي .. للقرآده سآجد","كنّه بحآلي يوم جيت إتبرّع",74,"ع",1,0],["لَكِنَّ حُزْنَكَ خَاْلِدٌº وَخَيَاْلَهَاْ","رغْمَ التَّنَاْئِيْ مُحْزِنٌº وَجَلِيْلُ",75,"ل",1,0],["لَكِنَّ حُبِّيْ مَا تَضَعْضَعَ لَحْظَةً","أَبَداً، وَأَفْدِيْ كُلَّ مَنْ يَفْدِيْكِ",76,"ك",1,0],["لكِنَّ حالتَه ليْسَتْ مُطَمْئِنَةً","من سعْلَةٍ كِدتُّ أن أُغْشَى لهَا صَعِقَا",77,"ق",2,0],["لكن حذار بأن تناسى دعوة","صعدت إلى رب المظالم مسرعة",78,"ع",2,0],["لَكِنْ حَذَارِ فَإِنَّ الرِّيحَ هَاتِكَةٌ","سِتْرَ البِقَاعِ وَهَتْكُ الرِّيحِ مَشْهُور",79,"ر",1,0],["لكن حكمة الرب الذي فوقنا قدوس","عليم أبخفي الأسرار واللي يدور بها",80,"ب",3,0],["لكنَّ حولي ألفُ قيدٍ شدَّني","والحُلمُ مِن خيْباتِهِ يتَبَدَّدُ",81,"د",1,0],["لكنَّ حسنَ الظنِّ يؤنسُ خافقي","مِنْ رحمةٍ كانتْ لربِّي غامرهْ",82,"ر",2,0],["لكن حين الصحو آن اوانه","ماعاد فيمن أرتجيه مرامي",83,"م",2,0],["لكنَّ حبي لن يكون مقارعاً","وأنا الذي قد عشت فيه مُسَلِّما",84,"م",2,0],["لكن حظي شاءَ ألا أحتسي","إلا أمَرَّ منَ الفراق وأخطرا",85,"ر",2,0],["لكنّ حبك قبل العمر أعرفه","دهرا أعانقه..دهرا ولم يَزلِ",86,"ل",1,0],["لكن حلميَ قد ضحى بصحبتنا","وباع للريح آمال المساجين",87,"ن",1,0],["لكنّ حبيَ للبلاد مؤصلٌ","لا ارتضي وطنا يُهانُ ويُصلبُ",88,"ب",1,0],["لكنّ حبر دموعكم","خطّ الأسى عمق انطباع",89,"ع",1,0],["لكن حداني الشوق واقتادني الهوى","فوافى غراب الحظ ينعي وينعق",90,"ق",1,0],["لكن حسن رجائها أوجي لها","في الحشر عند الله من حسناتها",91,"ت",3,0],["لكّن حبك يالغضي تلع لرقاب","وافي على جيشه ويزهى بعتاده",92,"د",2,0],["لكن حنا بعسر الوقت واليسرا","بالحق ننقطق لو العالم تجاهلته",93,"ت",2,0],["لكن حظي أبى إلا معاندتي","ينأى إلى طرفٍ إن كنت في طرف",94,"ف",1,0],["لكنَّ حروفي نائحة ٌ","ترثي ماضيها بالحاضر",95,"ر",1,0],["لكنّ حبك قاتلي فنسيت صب","ري رغم أنّي قبل ذاك لصبور",96,"ر",1,0],["لكن حبا لبنان أوفى منحةٍ","ممتازةٍ عن سائر البلدانِ",97,"ن",1,0],["لكنَّ حظّي قليلٌ ليس يَحسُدُني","غيري عليه وربي من يُقَدِّرُهُ",98,"ر",2,0],["لكن حب الأم أنباءها","بها إلى أسمى ذراه علا",99,"ل",2,0],["لكن حمته أسنةٌ وأعنة","فلكم قتيل حولها وطعين",100,"ن",1,0],["لكنَّ حظُّ المرء يغلبه ولو","حيزت له كلُّ الملوكِ رعايا",101,"ا",3,0],["لكن : حبيبي صرت انا حيل فرحان","لأني غريق البحر وإنته شراعي",102,"ع",2,0],["لكنَّ حبَّكِ راعَ النفسَ فابتدرتْ","إليه تسعى وشوق القلب ينْضدُها",103,"د",3,0],["لكن حربي من مباح حرامهم","والحرب فيهم من حرام مُباحِي",104,"ح",2,0],["لكنَّ حَرْقَ فؤادي كان ذا ألمٍ","يحْكي جهنم لا يُبقي ولا يذرُ",105,"ر",1,0],["‏لكنَّ حكمته عكسٌ لمجتمَعٍ","فيه الغباء يحاكي نافخَ الكيرِ",106,"ر",1,0],["لكنَّ حظي ما يزال مسافراً","ومجدِّداً بطُّوطةً والدّيبا..",107,"ب",2,0],["لكنَّ حسرةَ قلبكم هو حِسُّها","برحيلها عن نسلها المتنامي",108,"م",2,0],["\"لكن حسن الظن بدد وحشتي \"","وأزال كل وساوس الشيطانِ",109,"ن",1,0],["لَكِنَّ حُبَّكَ لا يُجِيْزُ لِشِعْرِكُمْ","تَقْدِيْمَ مَنْ كَانَتْ مَرَاتِبُهُ وَرَا",110,"ر",2,0],["لكن حسن المرء بالأخلاق مع","عقل وعلم فيهما يتشرف",111,"ف",1,0],["لكن حافظ إبراهيم أنذكرم","له جوانبه الأخرى من العظم",112,"م",1,0],["لكنَّ حربِي أَنا وحدِي وأَغطيتِي","كرِهتُها... أَدفعُ الأَشياءَ في ملَلِ",113,"ل",1,0],[".. لكنَّ حزنكِ صار جرحًا ثانيا","يدْمَى..و ينزفُ في غيوب فؤادي",114,"د",2,0]]}