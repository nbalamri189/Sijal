"أكثري أو فأقلي","https://www.aldiwan.net/poem65047.html","مجزوء الرمل"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[46,"تلف البصائر والزمان مفجع","https://www.aldiwan.net/poem22708.html","الكامل"],[46,"أنسيت حق الله أم أهملته","https://www.aldiwan.net/poem22843.html","الكامل"],[46,"أسررت إذا مر السنيح تفاؤلا","https://www.aldiwan.net/poem23255.html","الكامل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[76,"فؤادي رميت وعقلي سبيت","https://www.aldiwan.net/poem39477.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85429","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/204571","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54955","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54878","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"قدْاحة","https://www.poetsgate.com/ViewPoem.aspx?id=179376",""],[85,"قم في فم الدنيا وحيي الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=471",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[45,"أحْرَى الخُطُوبِ بأنْ يكونَ عَظيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32079",""],[80,"في كُنْهِ قَدْرِكَ للعقولِ تَحَيّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3214",""],[91,"فنون الوصف","https://www.poetsgate.com/ViewPoem.aspx?id=53081",""],[20,"وتفكر رب الخورنقِ إِذ أش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69772&r=&rc=13",""],[96,"في القرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66357&r=&rc=33",""]],"verses":[["وَتَفارَطتُم عَلى رَفهِ السُرى","مَورِدَ النَعماءِ وَالعَيشِ الرَغَد",0,"د",1,0],["وَتَفَرُّقُ البُعداءِ بَعدَ مَوَدَّةٍ","صَعبٌ فَكَيفَ تَفَرُّقُ القُرَباءِ",1,"ا",2,0],["وَتَفلي الصَوارِمُ مِن مَعشَرٍ","ذَوائِبَ تَهفو بِأَيدي الفَوالي",2,"ي",1,0],["وتَفْري الأرضَ أحياناً يَميناً","على لَغَبٍ وآوِنَةً شِمالا",3,"ل",2,0],["وَتَفانى بَنو أَبيكَ فَأَصبَحتَ","عَقيراً لِلدَّهرِ أَو كَالعَقيرِ",4,"ر",1,0],["وتَفْنَى إذا ما شاهَدَتْ عنْ شُهودِها","وقد فَنِيَ الفاني وقدْ بَقِيَ الباقي",5,"ي",1,0],["وَتَفْتَرِشُ الْبِطَاحَ لَنَا الْحَشَايَا","وَلِلرَّايَاتِ أَرْوِقَةٌ مُظِلَّهْ",6,"ل",2,0],["وتفاءَلَ الكُهّانُ أن رَئِيَّها","أضْحى لديْكَ مُقرَّناً مصْفودا",7,"د",2,0],["وَتَفتَرُّ عَن مُشرِقٍ بارِدٍ","كَشَوكِ السَيالِ أُسِفَّ النَؤورا",8,"ر",2,0],["وَتَفتَرُّ عَن غُرِّ الثَنايا كَأَنَّها","أَقاحٍ تُرَوّى مِن عُروقٍ غَلاغِلِ",9,"ل",1,0],["وَتَفَيَّئوا ظِلَّ الأَريكَةِ وَاِقصِدوا","مَلِكاً بِأُمَّتِهِ أَبَرَّ وَأَرفَقا",10,"ق",2,0],["وَتَفانيكَ في سَبيلِ أَبي حَف","صٍ وَمَسعاكَ عِندَ دَفعِ المُصابِ",11,"ب",1,0],["وتُفضى هذِهِ وَيُجَبُّ هذا","وَلا تُؤذيهِما تِلكَ الجِراحُ",12,"ح",1,0],["وَتَفَيَّأَ ظِلَّ سَعدٍ تَجتَني","فيهِ مِن غَرسِ المُنى أَحلى الثَمَر",13,"ر",1,0],["وَتَفرُقُ بِالمِدرى أَثيثاً نَباتُهُ","كَجَنَّةِ غَربيبٍ تَدَلَّت كُرومُها",14,"م",3,0],["وَتَفَكَّكَتْ أَغْلالُهَا وَتَقَلَّصَتْ","عَنْهَا ظِلالُ البَغْي وَالعُدْوَانِ",15,"ن",1,0],["وَتَفِي بِمَا افْتَرَضَتْ لَهُمْ آلاؤُهُمْ","أَفَمَا هُمُ لِثِرَاءِ مِصْرَ قِوَامُ",16,"م",1,0],["وَتُفَّاحَةٍ أَعْطَيْتِنِيهَا تَكَرُّماً","فَأَوْلَيْتِنِي فَضْلاً بِذَاكَ عَظِيمَا",17,"م",2,1],["وَتَفْتَقِدُ الأسَى مَنْ كُلِّ قَلْبٍ","بِحَيْثُ قَرَارَةُ الجُرْحِ الألِيمِ",18,"م",1,0],["وَتَفتَرُّ عَن قُلحٍ عَدِمتُ حَديثَها","وَعَن جَبَلَي طَيٍّ وَعَن هَرَمي مِصرِ",19,"ر",1,0],["وتفرقوا دنياً كأن لم يكفهم","في النائبات تفرّق الأديان",20,"ن",1,0],["وتفنيد قول المرء شين لرأيه","وزينةُ أخلاق الرجال وظوبها",21,"ب",3,0],["وتفْضُلُ ايمانَ الرجال شمالُهُ","كما فضلت يمنى يديه شمالَها",22,"ل",3,0],["وتفرَّدت كرماً وإن قال العدَى","إنَّ الغمامَ لها من النظراء",23,"ا",2,0],["وتفنَّنت في مفاوضة الش","كر إلى أن أعيى التطوُّل شكري",24,"ي",1,0],["وتفنن في العلم يق","دح بين ذاك خواطره",25,"ر",2,0],["وتفرقت جفناي عن دمعٍ به","أشرت وعن ميسور نوم أملقا",26,"ق",2,0],["وتفيد الجنى من اللفظ حلواً","حين كانت نوعاً من العسَّال",27,"ل",1,0],["وتفعلون جميلاً في مساترةٍ","كأنّ معروفكم إيداع أسرار",28,"ر",1,0],["وتفعل ما يدعو إليه فكلُّهم","يكرُّ عليه عائداً فيُلابسه",29,"س",2,0],["وتفي بما يعدُ الكذوبُ كأنما","كُفّلتَ ذلك دونَهُ تكفيلا",30,"ل",2,0],["وَتَفَصَّدَت مِن غَيرِ هَشٍّ عودُهُ","بالٍ وَلَيسَ بِحِصرِمٍ أَبكارِ",31,"ر",1,0],["وَتَفَرَّقوا بَعدَ اِنتِظامِهِمِ","بَدَدا وَكَم نَظمٍ إِلى نَثرِ",32,"ر",1,0],["وَتَفتَكُ اتيكَ الأَسِنَّةُ في الحَشى","وَيُحيِ الحَشى إِن راحَ يَفتُكُ بِالحِبرِ",33,"ر",1,0],["وَتَفَنَّنوا بِالمَكرِ حَتّى أَصبَحوا","وَغَبِيُّهُم أَدهى مِنَ الشَيطانِ",34,"ن",1,0],["وَتَفَضَّلتَ وَأَحسَن","تَ إِلى الصَبِّ المَشوقِ",35,"ق",1,0],["وَتَفَضَّل مِثلَ ماقَد","كُنتَ لي أَوَّلَ مَرَّه",36,"ر",2,0],["وَتَفَرَّعَت لِلمَجدِ مِنكَ ثَلاثَةٌ","كَثَلاثَةِ الجَوزاءِ في جَنَباتِهِ",37,"ت",2,0],["وَتَفَتَّحَت أَزهارُهُ","فَتَأَرَّجَت مِن كُلِّ جانِب",38,"ب",1,0],["وتفرَّقَ النَّاسُ الَّذين","المقابِرِ شيَّعوكْ",39,"ك",1,0],["وتفرد الانسان بين لداته","بدهائه فله المقام الارفع",40,"ع",1,0],["وتفوز بالنصر المبين على العدا","والغاصبين الحق والأضداد",41,"د",1,0],["وَتَفَيَّئوا الدُستورَ تَحتَ ظِلالِهِ","كَنَفاً أَهَشَّ مِنَ الرِياضِ وَأَنضَرا",42,"ر",2,0],["وَتَفتَرُّ مِنهُ عَن خِصالٍ كَأَنَّها","ثَنايا حَبيبٍ لا يُمَلُّ لَها رَشفُ",43,"ف",1,0],["وَتَفوحُ مِن طيبِ الثَناءِ رَوائِحٌ","لَهُمُ بِكُلِّ مَكانَةٍ تُستَنشَقُ",44,"ق",1,0],["وَتَفَرَّقَت عَنكُم كَتائِبُهُ","إِنَّ المِلاحَ خَوادِعٌ قُتُلُ",45,"ل",1,0],["وَتَفاوُتِ الأَقسامِ فيما بَينَهُم","لا يَأتَلينَ نَوازِلاً وَصَواعِدا",46,"د",2,0],["وَتَفاضُلُ الأَخلاقِ إِن حَصَّلتَها","في الناسِ حَسبَ تَفاضُلِ الأَجناسِ",47,"س",1,0],["وَتَفيضُ مِن حَذَرِ الوُشاةِ مَدامِعِ","فَإِذا خَلَوتُ أَفَضتُهُنَّ سُجوما",48,"م",2,0],["وَتَفَجَّرَت أَنهارُها بِمِياهِها","مَوصولَةً بِفَواهِقِ الغُدرانِ",49,"ن",1,0],["وتفاوتت أيامه","فمفيد مسعدة وناحس",50,"س",1,0],["وَتَفَكَّري فيما أَقو","لُ لَعَلَّ قَلبَكِ أَن يَلينا",51,"ن",2,0],["وَتَفَكَّري في المَوتِ أَح","ياناً لَعَلَّكِ أَن تَليني",52,"ي",1,0],["وَتَفقُدُهُ في دَولَةٍ ظاهِرِيَّةٍ","بِها الذِئبُ يَعدو رائِعاً بَينَ سِربِهِ",53,"ب",2,0],["وَتَفَرَّدتَ بِالنَعيمِ مِنَ العَي","شِ وَأَبقَيتَ لي العَذابَ الأَليما",54,"م",2,0],["وتَفوحُ غالِيَةٌ بِهِم وَذَريرَةٌ","وَهُما دمٌ في بُردَتَيكَ وَعِثْيَرُ",55,"ر",1,0],["وَتَفرَّقَت تِلكَ الغَياهِبُ عَن سَنا","فلقٍ يُفَلّقُ هامَها بِعَمُودِ",56,"د",1,0],["وتفشي سريراتِ النُفوسِ حماتها","بجهدِ ضرابٍ يصرعُ الأُسدَ الغلبا",57,"ب",2,0],["وَتَفَنُّني في القَولِ إِكثارٌ وَقَد","أَسرَجتَ في كَرَمِ الفَعالِ فَأَلجِمِ",58,"م",1,0],["وَتُفَلَّلُ الأَحسابُ بَعدَكَ وَالنُهى","وَالبيضُ مُلسٌ ما بِهِنَّ فُلولُ",59,"ل",1,0],["وتفتكُ بابن جملة في دمشقٍ","ويعلوها لمصرعِهِ القتامُ",60,"م",1,0],["وَتَفتَرُّ عَن بِشرٍ هُنالِكَ زَهرَةٌ","وَيَهفو لَهُ مِن مَعطِفَيَّ قَضيبُ",61,"ب",1,0],["وَتَفَرَّقوا بَعدَ الجَميعِ بِغِبطَةٍ","لا بُدَّ أَن يَتَفَرَّقَ الجيرانُ",62,"ن",1,1],["وتفرّقوا جزعين ممّا نابهم","إلا بقايا كالأصابع في اليدِ",63,"د",1,0],["وتفزّعَ الآباءُ في أجداثِهم","وتطلَّعتْ مِن ذُعرها الأَجدادُ",64,"د",1,0],["وتفديه النفوسُ على اعتقادٍ","بِأَنَّ حَياتَهُ تُحيي العِبادا",65,"د",2,0],["وتَفَضَّضَت أزهَارُهُ وتَذهَّبَت","فَكأنَّمَا الطَّاوُوسُ فِي تَلوِينِهِ",66,"ن",2,0],["وَتَفجَرت شِعراً بِقَلبي دافِقاً","فَسَكَبَت صافيهِ لِيَشرب مَوطِني",67,"ن",2,0],["وَتُفّاحٌ وَرُمّانٌ وَتينٌ","وَماءٌ بارِدٌ عَذبٌ سَليمُ",68,"م",1,0],["وَتَفنى وَلا يَبقى سِوى الواحِدُ الَذي","يُميتُ وَيحيِي دائِباً لَيسَ يُهمَدُ",69,"د",1,0],["وَتَفَرَّعَ الحَسَبَ الجَسي","مَ إِذا يُفاخِرُ أَو يُكاثِر",70,"ر",1,0],["وَتُفَلُّ الخُطوبُ مِنهُ بِرَأيٍ","قَد جَلاهُ بِالعَزمِ أَيَّ جَلاءِ",71,"ا",2,0],["وتَفْخَرُ أن أعْطَتْ نَجائبَ صِرْمَةً","وما أثّ من بَرْكِ الحِواءِ المصتَّم",72,"م",1,0],["وَتُفَلّي حينَ تَلقا","كَ لِتَحظى بِالتَفَلّي",73,"ي",1,0],["وَتَفيضُ لِلبُزلِ النَوائِبِ راحَتي","فَيضَ الفُراتِ بِهِ صَفاً وَكُدورُ",74,"ر",1,0],["وَتَفَكُّرُ الإِنسانِ يَثني غَرب