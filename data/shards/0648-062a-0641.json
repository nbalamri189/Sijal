لخيل تردي في أعنتها","https://www.aldiwan.net/poem15416.html","البسيط"],[461,"فمن كان لي لائما فيهم","https://www.aldiwan.net/poem16268.html","المتقارب"],[461,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[468,"جدت والعيش ما حل","https://www.aldiwan.net/poem59728.html","مجزوء الخفيف"],[477,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[479,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"تدرع بدرع البغي يا طامس القلب","https://www.aldiwan.net/poem37709.html","الطويل"],[500,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[500,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[500,"تجرد من مكابرة وجحد","https://www.aldiwan.net/poem37949.html","الوافر"],[505,"الراحل","https://www.aldiwan.net/poem61092.html","الطويل"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[514,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[515,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[538,"مع الأيام تلتئم الجراح","https://www.aldiwan.net/poem48250.html","عموديه"],[544,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[544,"وراءَ أروقة الخيام","https://www.aldiwan.net/poem67257.html","عموديه"],[558,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"],[558,"قد جاء ربنا لنا","https://www.aldiwan.net/poem33876.html","مجزوء الرجز"],[558,"ظهر الوجود من","https://www.aldiwan.net/poem34082.html","مجزوء الكامل"],[558,"بدت الحقيقة من خلال ستورها","https://www.aldiwan.net/poem34461.html","الكامل"],[558,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[558,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[567,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[575,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[575,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[575,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[575,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[575,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["وَتَفارَطتُم عَلى رَفهِ السُرى","مَورِدَ النَعماءِ وَالعَيشِ الرَغَد",0,"د",1,0],["وَتَفَرُّقُ البُعداءِ بَعدَ مَوَدَّةٍ","صَعبٌ فَكَيفَ تَفَرُّقُ القُرَباءِ",1,"ا",2,0],["وَتَفلي الصَوارِمُ مِن مَعشَرٍ","ذَوائِبَ تَهفو بِأَيدي الفَوالي",2,"ي",1,0],["وتَفْري الأرضَ أحياناً يَميناً","على لَغَبٍ وآوِنَةً شِمالا",3,"ل",2,0],["وَتَفانى بَنو أَبيكَ فَأَصبَحتَ","عَقيراً لِلدَّهرِ أَو كَالعَقيرِ",4,"ر",1,0],["وتَفْنَى إذا ما شاهَدَتْ عنْ شُهودِها","وقد فَنِيَ الفاني وقدْ بَقِيَ الباقي",5,"ي",1,0],["وَتَفْتَرِشُ الْبِطَاحَ لَنَا الْحَشَايَا","وَلِلرَّايَاتِ أَرْوِقَةٌ مُظِلَّهْ",6,"ل",2,0],["وتفاءَلَ الكُهّانُ أن رَئِيَّها","أضْحى لديْكَ مُقرَّناً مصْفودا",7,"د",2,0],["وَتَفتَرُّ عَن مُشرِقٍ بارِدٍ","كَشَوكِ السَيالِ أُسِفَّ النَؤورا",8,"ر",2,0],["وَتَفتَرُّ عَن غُرِّ الثَنايا كَأَنَّها","أَقاحٍ تُرَوّى مِن عُروقٍ غَلاغِلِ",9,"ل",1,0],["وَتَفَيَّئوا ظِلَّ الأَريكَةِ وَاِقصِدوا","مَلِكاً بِأُمَّتِهِ أَبَرَّ وَأَرفَقا",10,"ق",2,0],["وَتَفانيكَ في سَبيلِ أَبي حَف","صٍ وَمَسعاكَ عِندَ دَفعِ المُصابِ",11,"ب",1,0],["وتُفضى هذِهِ وَيُجَبُّ هذا","وَلا تُؤذيهِما تِلكَ الجِراحُ",12,"ح",1,0],["وَتَفَيَّأَ ظِلَّ سَعدٍ تَجتَني","فيهِ مِن غَرسِ المُنى أَحلى الثَمَر",13,"ر",1,0],["وَتَفرُقُ بِالمِدرى أَثيثاً نَباتُهُ","كَجَنَّةِ غَربيبٍ تَدَلَّت كُرومُها",14,"م",3,0],["وَتَفَكَّكَتْ أَغْلالُهَا وَتَقَلَّصَتْ","عَنْهَا ظِلالُ البَغْي وَالعُدْوَانِ",15,"ن",1,0],["وَتَفِي بِمَا افْتَرَضَتْ لَهُمْ آلاؤُهُمْ","أَفَمَا هُمُ لِثِرَاءِ مِصْرَ قِوَامُ",16,"م",1,0],["وَتُفَّاحَةٍ أَعْطَيْتِنِيهَا تَكَرُّماً","فَأَوْلَيْتِنِي فَضْلاً بِذَاكَ عَظِيمَا",17,"م",2,1],["وَتَفْتَقِدُ الأسَى مَنْ كُلِّ قَلْبٍ","بِحَيْثُ قَرَارَةُ الجُرْحِ الألِيمِ",18,"م",1,0],["وَتَفتَرُّ عَن قُلحٍ عَدِمتُ حَديثَها","وَعَن جَبَلَي طَيٍّ وَعَن هَرَمي مِصرِ",19,"ر",1,0],["وتفرقوا دنياً كأن لم يكفهم","في النائبات تفرّق الأديان",20,"ن",1,0],["وتفنيد قول المرء شين لرأيه","وزينةُ أخلاق الرجال وظوبها",21,"ب",3,0],["وتفْضُلُ ايمانَ الرجال شمالُهُ","كما فضلت يمنى يديه شمالَها",22,"ل",3,0],["وتفرَّدت كرماً وإن قال العدَى","إنَّ الغمامَ لها من النظراء",23,"ا",2,0],["وتفنَّنت في مفاوضة الش","كر إلى أن أعيى التطوُّل شكري",24,"ي",1,0],["وتفنن في العلم يق","دح بين ذاك خواطره",25,"ر",2,0],["وتفرقت جفناي عن دمعٍ به","أشرت وعن ميسور نوم أملقا",26,"ق",2,0],["وتفيد الجنى من اللفظ حلواً","حين كانت نوعاً من العسَّال",27,"ل",1,0],["وتفعلون جميلاً في مساترةٍ","كأنّ معروفكم إيداع أسرار",28,"ر",1,0],["وتفعل ما يدعو إليه فكلُّهم","يكرُّ عليه عائداً فيُلابسه",29,"س",2,0],["وتفي بما يعدُ الكذوبُ كأنما","كُفّلتَ ذلك دونَهُ تكفيلا",30,"ل",2,0],["وَتَفَصَّدَت مِن غَيرِ هَشٍّ عودُهُ","بالٍ وَلَيسَ بِحِصرِمٍ أَبكارِ",31,"ر",1,0],["وَتَفَرَّقوا بَعدَ اِنتِظامِهِمِ","بَدَدا وَكَم نَظمٍ إِلى نَثرِ",32,"ر",1,0],["وَتَفتَكُ اتيكَ الأَسِنَّةُ في الحَشى","وَيُحيِ الحَشى إِن راحَ يَفتُكُ بِالحِبرِ",33,"ر",1,0],["وَتَفَنَّنوا بِالمَكرِ حَتّى أَصبَحوا","وَغَبِيُّهُم أَدهى مِنَ الشَيطانِ",34,"ن",1,0],["وَتَفَضَّلتَ وَأَحسَن","تَ إِلى الصَبِّ المَشوقِ",35,"ق",1,0],["وَتَفَضَّل مِثلَ ماقَد","كُنتَ لي أَوَّلَ مَرَّه",36,"ر",2,0],["وَتَفَرَّعَت لِلمَجدِ مِنكَ ثَلاثَةٌ","كَثَلاثَةِ الجَوزاءِ في جَنَباتِهِ",37,"ت",2,0],["وَتَفَتَّحَت أَزهارُهُ","فَتَأَرَّجَت مِن كُلِّ جانِب",38,"ب",1,0],["وتفرَّقَ النَّاسُ الَّذين","المقابِرِ شيَّعوكْ",39,"ك",1,0],["وتفرد الانسان بين لداته","بدهائه فله المقام الارفع",40,"ع",1,0],["وتفوز بالنصر المبين على العدا","والغاصبين الحق والأضداد",41,"د",1,0],["وَتَفَيَّئوا الدُستورَ تَحتَ ظِلالِهِ","كَنَفاً أَهَشَّ مِنَ الرِياضِ وَأَنضَرا",42,"ر",2,0],["وَتَفتَرُّ مِنهُ عَن خِصالٍ كَأَنَّها","ثَنايا حَبيبٍ لا يُمَلُّ لَها رَشفُ",43,"ف",1,0],["وَتَفوحُ مِن طيبِ الثَناءِ رَوائِحٌ","لَهُمُ بِكُلِّ مَكانَةٍ تُستَنشَقُ",44,"ق",1,0],["وَتَفَرَّقَت عَنكُم كَتائِبُهُ","إِنَّ المِلاحَ خَوادِعٌ قُتُلُ",45,"ل",1,0],["وَتَفاوُتِ الأَقسامِ فيما بَينَهُم","لا يَأتَلينَ نَوازِلاً وَصَواعِدا",46,"د",2,0],["وَتَفاضُلُ الأَخلاقِ إِن حَصَّلتَها","في الناسِ حَسبَ تَفاضُلِ الأَجناسِ",47,"س",1,0],["وَتَفيضُ مِن حَذَرِ الوُشاةِ مَدامِعِ","فَإِذا خَلَوتُ أَفَضتُهُنَّ سُجوما",48,"م",2,0],["وَتَفَجَّرَت أَنهارُها بِمِياهِها","مَوصولَةً بِفَواهِقِ الغُدرانِ",49,"ن",1,0],["وتفاوتت أيامه","فمفيد مسعدة وناحس",50,"س",1,0],["وَتَفَكَّري فيما أَقو","لُ لَعَلَّ قَلبَكِ أَن يَلينا",51,"ن",2,0],["وَتَفَكَّري في المَوتِ أَح","ياناً لَعَلَّكِ أَن تَليني",52,"ي",1,0],["وَتَفقُدُهُ في دَولَةٍ ظاهِرِيَّةٍ","بِها الذِئبُ يَعدو رائِعاً بَينَ سِربِهِ",53,"ب",2,0],["وَتَفَرَّدتَ بِالنَعيمِ مِنَ العَي","شِ وَأَبقَيتَ لي العَذابَ الأَليما",54,"م",2,0],["وتَفوحُ غالِيَةٌ بِهِم وَذَريرَةٌ","وَهُما دمٌ في بُردَتَيكَ وَعِثْيَرُ",55,"ر",1,0],["وَتَفرَّقَت تِلكَ الغَياهِبُ عَن سَنا","فلقٍ يُفَلّقُ هامَها بِعَمُودِ",56,"د",1,0],["وتفشي سريراتِ النُفوسِ حماتها","بجهدِ ضرابٍ يصرعُ الأُسدَ الغلبا",57,"ب",2,0],["وَتَفَنُّني في القَولِ إِكثارٌ وَقَد","أَسرَجتَ في كَرَمِ الفَعالِ فَأَلجِمِ",58,"م",1,0],["وَتُفَلَّلُ الأَحسابُ بَعدَكَ وَالنُهى","وَالبيضُ مُلسٌ ما بِهِنَّ فُلولُ",59,"ل",1,0],["وتفتكُ بابن جملة في دمشقٍ","ويعلوها لمصرعِهِ القتامُ",60,"م",1,0],["وَتَفتَرُّ عَن بِشرٍ هُنالِكَ زَهرَةٌ","وَيَهفو لَهُ مِن مَعطِفَيَّ قَضيبُ",61,"ب",1,0],["وَتَفَرَّقوا بَعدَ الجَميعِ بِغِبطَةٍ","لا بُدَّ أَن يَتَفَرَّقَ الجيرانُ",62,"ن",1,1],["وتفرّقوا جزعين ممّا نابهم","إلا بقايا كالأصابع في اليدِ",63,"د",1,0],["وتفزّعَ الآباءُ في أجداثِهم","وتطلَّعتْ مِن ذُعرها الأَجدادُ",64,"د",1,0],["وتفديه النفوسُ على اعتقادٍ","بِأَنَّ حَياتَهُ تُحيي العِبادا",65,"د",2,0],["وتَفَضَّضَت أزهَارُهُ وتَذهَّبَت","فَكأنَّمَا الطَّاوُوسُ فِي تَلوِينِهِ",66,"ن",2,0],["وَتَفجَرت شِعراً بِقَلبي دافِقاً","فَسَكَبَت صافيهِ لِيَشرب مَوطِني",67,"ن",2,0],["وَتُفّاحٌ وَرُمّانٌ وَتينٌ","وَماءٌ بارِدٌ عَذبٌ سَليمُ",68,"م",1,0],["وَتَفنى وَلا يَبقى سِوى الواحِدُ الَذي","يُميتُ وَيحيِي دائِباً لَيسَ يُهمَدُ",69,"د",1,0],["وَتَفَرَّعَ الحَسَبَ الجَسي","مَ إِذا يُفاخِرُ أَو يُكاثِر",70,"ر",1,0],["وَتُفَلُّ الخُطوبُ مِنهُ بِرَأيٍ","قَد جَلاهُ بِالعَزمِ أَيَّ جَلاءِ",71,"ا",2,0],["وتَفْخَرُ أن أعْطَتْ نَجائبَ صِرْمَةً","وما أثّ من بَرْكِ الحِواءِ المصتَّم",72,"م",1,0],["وَتُفَلّي حينَ تَلقا","كَ لِتَحظى بِالتَفَلّي",73,"ي",1,0],["وَتَفيضُ لِلبُزلِ النَوائِبِ راحَتي","فَيضَ الفُراتِ بِهِ صَفاً وَكُدورُ",74,"ر",1,0],["وَتَفَكُّرُ الإِنسانِ يَثني غَربَهُ","وَيَرُدُّ جامِحَهُ إِلى الإِقصارِ",75,"ر",1,0],["وَتَفَكَّرَت نَفسُ اللَبيبِ وَقَد رَأَت","أَشُخوصُ جِنٍّ أَم شُخوصُ إِناسِ",76,"س",1,0],["وَتَفاوُتُ الأَجسامِ ثُمَّ جَميعُها","مُتَقارِباتٌ في نُهىً وَخَصائِلِ",77,"ل",1,0],["وَتَفَرَّعنا مِنِ اِبنَي وائِلٍ","هامَةَ العِزِّ وَخُرطومَ الكَرَم",78,"م",1,0],["وَتَفَرّى اللَحمُ مِن تَعدائِها","وَالتَغالي فَهيَ قُبٌّ كَالعَجَم",78,"م",1,0],["وَتُفَّاحِ خَدٍّ ورُمَّانِ صَدْرٍ","وَمَجْناهُما خَيرُ شيءٍ جَنَيْتْ",79,"ت",1,0],["وَتفتحت أَزهارها","تَحكي عيوناً تنظر",80,"ر",1,0],["وتفهمت حق أمي كبيرا","عندما صرت من أولى الافهام",81,"م",1,0],["وتفرَّستكِ قلوبهم فترنَّحوا","رُعْباً وأنتِ الخمرُ والخمّارُ",82,"ر",1,0],["وتفيَّأي الدوحَ الظَّليل ومربأ","للفنِّ تحت أزاهرٍ وقطوفِ",83,"ف",1,0],["وَتَفْدِيك جُنْدٌ فِي الْحُرُوبِ أَعِزَّةٌ","وَأَنْتِ بِلاَ سَهْمٍ أَصَابَ قَتِيلُ",84,"ل",1,0],["وَتُفِيدُهُ آدَابُهُ أَدَبَاً","وَتزِيدُهُ أَخْبَارُهُ خُبْرَا",85,"ر",2,0],["وَتَفْوِيفُهُ بِنِعَالِ الجِيَا","دِ وَتَدْبِيجُه بِدَمٍ أَحْمَرَا",86,"ر",2,0],["وتَفَقَّدِي تِلْكَ المَعَابِدَ وَاسْأَلِي","فِيهَا الصَّدَى عَنْ صامِتِ الأَسْرَارِ",87,"ر",1,0],["وتفارقا فإذا بعروة رُجمة","تهوي عليها انْقضّ صاعقتان",88,"ن",1,0],["وتفهّموا سِرَّ الحياةِ ولم يكنْ","سرُّ الحياةِ لغيرهم بمُباح",89,"ح",1,0],["وتَفَتح