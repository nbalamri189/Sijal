,[5629,"المجتمع","https://www.poetsgate.com/ViewPoem.aspx?id=184558",""],[5638,"عيد أمة هانت","https://www.poetsgate.com/ViewPoem.aspx?id=198128",""],[5725,"لبلاب","https://www.poetsgate.com/ViewPoem.aspx?id=206962",""],[5732,"ما طاع عذاله","https://www.poetsgate.com/ViewPoem.aspx?id=177911",""],[5732,"كلما قلت","https://www.poetsgate.com/ViewPoem.aspx?id=177952",""],[5732,"اللي هتف باسماه قلبي وناداه","https://www.poetsgate.com/ViewPoem.aspx?id=177868",""],[5732,"الله كفيل الناس وارضه وسيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177863",""],[5732,"الله من هم بالأعماق مخفيه","https://www.poetsgate.com/ViewPoem.aspx?id=177821",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[5792,"يا ظالمة","https://www.poetsgate.com/ViewPoem.aspx?id=180335",""],[5792,"ليل المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=180341",""],[5818,"ليت العذول الذي قد بات يعذلني","https://www.poetsgate.com/ViewPoem.aspx?id=199979",""],[5848,"لا صار خلك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=53365",""],[5906,"أوتار حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188311",""],[5948,"يا أيها السَائلُ عن قومِنا","https://www.poetsgate.com/ViewPoem.aspx?id=100612",""],[5956,"ذكرى وفاة زهرة الشمعة","https://www.poetsgate.com/ViewPoem.aspx?id=215786",""],[5976,"وبْل القصيد .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30535",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6056,"الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=130328",""],[6113,"حراااامي","https://www.poetsgate.com/ViewPoem.aspx?id=35354",""],[6115,"ونطيره بالمدح مثل العجاجه","https://www.poetsgate.com/ViewPoem.aspx?id=186688",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6275,"البريق الضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83614&r=&rc=6",""]],"verses":[["لو همى ماء معطفيّ من اللي","نِ لأفنته مهجتي بلهيب",0,"ب",1,0],["لو هجا الأنبياءُ كلباً لقال ال","ناسُ هذا تكذُّب الشعراءِ",1,"ا",2,0],["لو هزَّ أدناها الأشلْ","لُ فرى الحديدَ بها الأشلُّ",2,"ل",1,0],["لوْ هداكَ القَصْدَ فهْمُ","أو أراك الرأي حَزْمُ",3,"م",1,1],["لَو هاجَهُ الراكِبُ بِالكُرباجِ","لَما مَشى بِهِ سِوى اِعوِجاجِ",4,"ج",1,0],["لو همت في بدر السما","ء لما أوى إلا سماك",5,"ك",1,0],["لو هَمَّ بَأسُكَ بالطَّودِ الذي شَمَخَتْ","هِضابُهُ لَهَوَى من بأسِكَ الطَّورُ",6,"ر",1,0],["لَوْ هَفَا من أُذْنِها القُرْطُ على","حبلِها من بُعْدِ مَهْوَاهُ لطاح",7,"ح",1,0],["لَو هَبَّ هُجّادُ قَومٍ في الثَرى دُفِنوا","لَضاقَت المُدُنُ وَالبيدُ الأَماليسُ",8,"س",1,0],["لَو هَبَّ سُكّانُ التُرابِ مِنَ الكَرى","أَعيا المَحَلُّ عَلى المُقيمِ الساكِنِ",9,"ن",1,1],["لَو هُم حُماتُكَ بِالمَحمى حَمَوكَ وَلَم","تُترَك لِيَومٍ أَقامَ الناسَ في كَبَدِ",10,"د",1,0],["لو هاب حر اللظى مسيء","ما اهتاج حرصاً ولا تلظى",11,"ظ",2,0],["لو هبَّ فرعون لخال موسى","بجانبيه يعرض النّاموسا",12,"س",2,0],["لو هزّت الأحداث صخرا جلمدا","لدوى وأرعد باللذهيب الجلمد",13,"د",1,0],["لو هجا الأنبياء كلباً لقال النْ","ناسُ هذا تكذُّب الشعراء",14,"ا",2,0],["لو هَزّ في يمينه مخَاصرا","أرسلها ببأسه صواعقا",15,"ق",2,0],["لو هان بالأمس مالاقوه ما وجدوا","هذا السرورَ الذي ساروا به مثَلا",16,"ل",2,0],["لو هَمَّ مُوِقدُ نارٍ أنْ يَرى يَده","فيها ولو كانتِ الزَّرقاءُ لم يَكَد",17,"د",1,0],["لَو هُمُ يَعلَمونَ ماذا يُقاسي","عاشِقٌ يستَجيرُ في لبنانِه",18,"ن",2,0],["لوهت عرى الإسلام لكن وعدك ال","ميمون واضح رسمه لا يمسخ",19,"خ",1,0],["لَوْ همومي قد توالتْ","ربما هَمّاً تصيبُ",20,"ب",1,0],["لو هَبطتَ البلادَ انسيَتُكَ","القتلَ كما يُنسيء النَسيء النَسِيّا",21,"ي",2,0],["لو هاج من دائك ما هيَّج لي","علمتَ أني للبروق شائمُ",22,"م",1,0],["لو هبّت الريحُ نسيما أبدا","لم يُتَعوَّذ من أذَى السمائمِ",23,"م",1,0],["لو هزّ جِذْعاً هشيماً في أنامِله","يوماً لأوشَكَ منه يسقُطُ الرُّطَبُ",24,"ب",1,0],["لَو هاجَ صَحبُكَ شَيئاً مِن رَواحِلِهم","بِذي شَناصِيرَ أَو بالنَعفِ مِن عُظُمِ",25,"م",1,1],["لَو هَداني إلى سُلُوِّي سُلُوٌّ","منكَ في الحُبِّ لاِهتديتُ إليهِ",26,"ي",2,0],["لو هَمَّ نُسَّابُ الحِجازِ بضبطِهِ","بَلغَ السِّياقُ بهِ إلى عَدنانِهِ",27,"ن",2,0],["لَو هاجَ مِثلُ الفَضلِ خاطِرَ شاعِرٍ","أَلقَيتَ بَينَ يَدَي سِواكَ بَواكِري",28,"ر",2,1],["لوهابَ عن عزّةٍ أو نجدةٍ قدرٌ","من البرّيةِ خَلقاً هَابَكَ القدرُ",29,"ر",1,0],["لو هويتُم لما انقلبتُم علينا","كالافاعي تفحُّ حيث تدبُّ",30,"ب",1,0],["لو هو ما ينسخى به","باغزّر له تحت",31,"ت",1,0],["لو هو فراقك مسهمٍ في حالنا","شنروم كان الله يزيح اظلالنا",32,"ن",2,0],["لَو هَمَّهُ اِنتابَ الهِضا","بَ لَدَكدَكَت مِنهُ الهِضابْ",33,"ب",1,0],["لو هدتني إلى سبيل التلاقي","مانحاتي لما تستر غيبي",34,"ب",2,0],["لَوْ هَجَوْنا بِها المَنونَ لَدَلَّتْ","أَوْ مَدَحْنا بِها الزَّمانَ لأَجْدى",35,"د",2,0],["لو هدّت الأوجاع صدري لما","شكوت من ضعفي وأوجاعيه",36,"ي",2,0],["لو هز بالنجم تساقطت كيو","م أسقط الجذع لمريم الجنى",37,"ا",1,0],["لَوَهبتُ من طربي له","رب الخورنق والسديرِ",38,"ر",1,0],["لو هدّد الريح لم تبرز زوابعها","أو بارز الليث لم يخرج من الأجم",39,"م",1,0],["لو هزك الشوق المقيم وكنت ذا","حس لما استبدلت بالأهوان",40,"ن",1,0],["لَو هدم الإِيوان ما تَهدَّما","نَذرتُ نذراً وَحلفتُ قسما",41,"م",2,0],["لَو هَدَمنا غُدوَةً بُنيانَهُ","لَاِنمَحَت أَسماؤهُم طولَ الأَبَد",42,"د",1,0],["لو هبت الريح من تلقاء داركم","يوماً بوصل له طارت به الريح",43,"ح",1,0],["لو هذَّبَ الناموسُ أخلاقَهُ","ما كانَ منسوباً إلى البقِّ",44,"ق",1,0],["لو هجى المسك وهو أهل","لكل مدحٍ لصار جيفه",45,"ف",2,0],["لَوْ هُوْ طلب لكّين خَيَّالْ","سِتَّان قِلْ لِهْ مِنْ العينا",46,"ن",2,0],["لَوْ هُوْ طلب من داني اظلال","جنه بذلنا الجنتينا",46,"ن",2,0],["لَوْ هُوْ طلب مِ السندس العَال","مِنْ كِلّ حِلَّه لِهْ جِبينا",46,"ن",2,0],["لو هو صاعِد رَد فِيْ انْكاسِ","خِمّصان ورِطْبِتَه مخَشْفَه",47,"ف",2,0],["لو هو عاري وهِنْ بِلباسِ","هِن المحبا وهو قِمَر شوفه",48,"ف",2,0],["لَو هَزَّ رمحاً في النزالِ لخلتهُ","اسداً هصوراً راعَ الف محاربِ",49,"ر",2,0],["لَو هَزَّ رُمحاً رُدينياً عَلى جَبَلِ","لاهتَزَّ مِن رَوعِهِ واندكَّ منحدرا",50,"ر",2,0],["لوهبنا لزايدٍ ما لدينا","وتبارى لفَدْيِه الأوفياء",51,"ا",2,0],["لو هبَّتِ الريحُ اغتدى لسماعها","قلبُ الشجيع القلبِ وهْوَ خَفُوق",52,"ق",1,0],["لو ه