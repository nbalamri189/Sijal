{"poems":[[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[51,"قل لهاجيك مطنبا في الهجاء","https://www.aldiwan.net/poem8140.html","الخفيف"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[51,"لو هداك القصد فهم","https://www.aldiwan.net/poem66315.html","مجزوء الرمل"],[91,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[85,"يا قلب أحمد","https://www.aldiwan.net/poem7883.html","مجزوء الكامل"],[61,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[80,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[46,"إن كان إبليس ذا جند يصول بهم","https://www.aldiwan.net/poem22797.html","البسيط"],[46,"لو هب سكان التراب من الكرى","https://www.aldiwan.net/poem23531.html","الكامل"],[15,"دعا معاشر فاستكت مسامعهم","https://www.aldiwan.net/poem45275.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147496",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[51,"قال لهاجيكَ مُطنباً في الهجاء","https://www.poetsgate.com/ViewPoem.aspx?id=26209",""]],"verses":[["لو همى ماء معطفيّ من اللي","نِ لأفنته مهجتي بلهيب",0,"ب",1,0],["لو هجا الأنبياءُ كلباً لقال ال","ناسُ هذا تكذُّب الشعراءِ",1,"ا",2,0],["لو هزَّ أدناها الأشلْ","لُ فرى الحديدَ بها الأشلُّ",2,"ل",1,0],["لوْ هداكَ القَصْدَ فهْمُ","أو أراك الرأي حَزْمُ",3,"م",1,1],["لَو هاجَهُ الراكِبُ بِالكُرباجِ","لَما مَشى بِهِ سِوى اِعوِجاجِ",4,"ج",1,0],["لو همت في بدر السما","ء لما أوى إلا سماك",5,"ك",1,0],["لو هَمَّ بَأسُكَ بالطَّودِ الذي شَمَخَتْ","هِضابُهُ لَهَوَى من بأسِكَ الطَّورُ",6,"ر",1,0],["لَوْ هَفَا من أُذْنِها القُرْطُ على","حبلِها من بُعْدِ مَهْوَاهُ لطاح",7,"ح",1,0],["لَو هَبَّ هُجّادُ قَومٍ في الثَرى دُفِنوا","لَضاقَت المُدُنُ وَالبيدُ الأَماليسُ",8,"س",1,0],["لَو هَبَّ سُكّانُ التُرابِ مِنَ الكَرى","أَعيا المَحَلُّ عَلى المُقيمِ الساكِنِ",9,"ن",1,1],["لَو هُم حُماتُكَ بِالمَحمى حَمَوكَ وَلَم","تُترَك لِيَومٍ أَقامَ الناسَ في كَبَدِ",10,"د",1,0],["لو هاب حر 