{"poems":[[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[51,"قل لهاجيك مطنبا في الهجاء","https://www.aldiwan.net/poem8140.html","الخفيف"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[51,"لو هداك القصد فهم","https://www.aldiwan.net/poem66315.html","مجزوء الرمل"],[91,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[85,"يا قلب أحمد","https://www.aldiwan.net/poem7883.html","مجزوء الكامل"],[61,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[80,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[46,"إن كان إبليس ذا جند يصول بهم","https://www.aldiwan.net/poem22797.html","البسيط"],[46,"لو هب سكان التراب من الكرى","https://www.aldiwan.net/poem23531.html","الكامل"],[15,"دعا معاشر فاستكت مسامعهم","https://www.aldiwan.net/poem45275.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147496",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[100,"عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=50116",""],[51,"قال لهاجيكَ مُطنباً في الهجاء","https://www.poetsgate.com/ViewPoem.aspx?id=26209",""],[143,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[161,"ما خيب الله فيه للورى أملا","https://www.aldiwan.net/poem58899.html","البسيط"],[186,"لو كان هجرك يبقيني إلى أمد","https://www.aldiwan.net/poem14501.html","البسيط"],[224,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[232,"لمن المطايا في رباها تنفخ","https://www.aldiwan.net/poem44593.html","الكامل"],[255,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[307,"عللاني وعللا صاحبي","https://www.aldiwan.net/poem28.html","الخفيف"],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[515,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[541,"لو هاج صحبك شيئا من رواحلهم","https://www.aldiwan.net/poem56656.html","الخفيف"],[552,"يا خليلي أراك من شغف الحب","https://www.aldiwan.net/poem46354.html","الخفيف"],[563,"قد قام رب الدار في أوطانه","https://www.aldiwan.net/poem52767.html","الكامل"]],"verses":[["لو همى ماء معطفيّ من اللي","نِ لأفنته مهجتي بلهيب",0,"ب",1,0],["لو هجا الأنبياءُ كلباً لقال ال","ناسُ هذا تكذُّب الشعراءِ",1,"ا",2,0],["لو هزَّ أدناها الأشلْ","لُ فرى الحديدَ بها الأشلُّ",2,"ل",1,0],["لوْ هداكَ القَصْدَ فهْمُ","أو أراك الرأي حَزْمُ",3,"م",1,1],["لَو هاجَهُ الراكِبُ بِالكُرباجِ","لَما مَشى بِهِ سِوى اِعوِجاجِ",4,"ج",1,0],["لو همت في بدر السما","ء لما أوى إلا سماك",5,"ك",1,0],["لو هَمَّ بَأسُكَ بالطَّودِ الذي شَمَخَتْ","هِضابُهُ لَهَوَى من بأسِكَ الطَّورُ",6,"ر",1,0],["لَوْ هَفَا من أُذْنِها القُرْطُ على","حبلِها من بُعْدِ مَهْوَاهُ لطاح",7,"ح",1,0],["لَو هَبَّ هُجّادُ قَومٍ في الثَرى دُفِنوا","لَضاقَت المُدُنُ وَالبيدُ الأَماليسُ",8,"س",1,0],["لَو هَبَّ سُكّانُ التُرابِ مِنَ الكَرى","أَعيا المَحَلُّ عَلى المُقيمِ الساكِنِ",9,"ن",1,1],["لَو هُم حُماتُكَ بِالمَحمى حَمَوكَ وَلَم","تُترَك لِيَومٍ أَقامَ الناسَ في كَبَدِ",10,"د",1,0],["لو هاب حر اللظى مسيء","ما اهتاج حرصاً ولا تلظى",11,"ظ",2,0],["لو هبَّ فرعون لخال موسى","بجانبيه يعرض النّاموسا",12,"س",2,0],["لو هزّت الأحداث صخرا جلمدا","لدوى وأرعد باللذهيب الجلمد",13,"د",1,0],["لو هجا الأنبياء كلباً لقال النْ","ناسُ هذا تكذُّب الشعراء",14,"ا",2,0],["لو هَزّ في يمينه مخَاصرا","أرسلها ببأسه صواعقا",15,"ق",2,0],["لو هان بالأمس مالاقوه ما وجدوا","هذا السرورَ الذي ساروا به مثَلا",16,"ل",2,0],["لو هَمَّ مُوِقدُ نارٍ أنْ يَرى يَده","فيها ولو كانتِ الزَّرقاءُ لم يَكَد",17,"د",1,0],["لَو هُمُ يَعلَمونَ ماذا يُقاسي","عاشِقٌ يستَجيرُ في لبنانِه",18,"ن",2,0],["لوهت عرى الإسلام لكن وعدك ال","ميمون واضح رسمه لا يمسخ",19,"خ",1,0],["لَوْ همومي قد توالتْ","ربما هَمّاً تصيبُ",20,"ب",1,0],["لو هَبطتَ البلادَ انسيَتُكَ","القتلَ كما يُنسيء النَسيء النَسِيّا",21,"ي",2,0],["لو هاج من دائك ما هيَّج لي","علمتَ أني للبروق شائمُ",22,"م",1,0],["لو هبّت الريحُ نسيما أبدا","لم يُتَعوَّذ من أذَى السمائمِ",23,"م",1,0],["لو هزّ جِذْعاً هشيماً في أنامِله","يوماً لأوشَكَ منه يسقُطُ الرُّطَبُ",24,"ب",1,0],["لَو هاجَ صَحبُكَ شَيئاً مِن رَواحِلِهم","بِذي شَناصِيرَ أَو بالنَعفِ مِن عُظُمِ",25,"م",1,1],["لَو هَداني إلى سُلُوِّي سُلُوٌّ","منكَ في الحُبِّ لاِهتديتُ إليهِ",26,"ي",2,0],["لو هَمَّ نُسَّابُ الحِجازِ بضبطِهِ","بَلغَ السِّياقُ بهِ إلى عَدنانِهِ",27,"ن",2,0]]}