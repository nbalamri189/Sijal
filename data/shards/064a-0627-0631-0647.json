{"poems":[[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[128,"قولوا لعبود على القول يشفيني","https://www.aldiwan.net/poem23720.html","البسيط"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66800","الكامل"],[1685,"","https://poetry.dctabudhabi.ae/diwan/poem/145241","الخفيف"],[585,"أقسمتُ أنكَ روضةٌ وجنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5756,"كلمة حق","https://www.poetsgate.com/ViewPoem.aspx?id=5380",""]],"verses":[["يا رَهطَ أَحمَدَ ما زالَت أَيِمَّتُكُم","تُؤدي الضَعيفَ وَلا تَكدي لِرُوّادِ",0,"د",1,0],["يا رهط شيلوخ من يأخذ بناصركم","يجني على الحق والأخلاق والدين",1,"ن",1,0],["يا رهيب السكون يا ليل ما أع","جب حالي على الغرام وحالك",2,"ك",1,0],["يا رهطَ أحَمد إنّ من أعطاكُمُ","ولكمْ لديهِ زيادةٌ وتَمامُ",3,"م",1,0],["يا رهين التراب لو صدقتك ال","ود نفسي إذن لكانت تفيظ",4,"ظ",1,0],["يا رهط عز الدين حسبك نعمةً","في الخلد لا عنت ولا أشجان",5,"ن",1,0],["يارهبةَ البحرِ هذا البحرُ يسألُني","أنّى سَيُمنعُ عنهُ الضيَّمُ والغَرَرُ",6,"ر",1,0],["يارهبةٍ هزت سراجيف الانذال","ياشوق تلعات الرقاب الرغايد",7,"د",1,0]]}