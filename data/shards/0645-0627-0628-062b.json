{"poems":[[487,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87099","البسيط"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124714","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83444","الخفيف"]],"verses":[["ما بث شكوى للزمان فلا له","حكم على الرجحان والنقصان",0,"ن",1,0],["ما بث مَجدي بِإِخلاص مَدائحه","في دَولة لَم تَزَل مَنشورة العلم",1,"م",1,0],["مابثّ في ساكن الغبراء أسهمه","إلا ويصمي بها من يسكن الفلكا",2,"ك",2,0],["ما بثثتُ الشَكوى وَلم أَشكُ بثّي","ثَمَّ إِلّا لأنَّهُ مَبثوثُ",3,"ث",1,0]]}