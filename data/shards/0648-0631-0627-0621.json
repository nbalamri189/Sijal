يع"],[563,"وراء هذا الوجود عندي","https://www.aldiwan.net/poem34585.html","مخلع البسيط"],[563,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96993","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88616","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48731","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48752","البسيط"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105608","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105443","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202081","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25355","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122023","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44835","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79955","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79808","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80010","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79946","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105415","الطويل"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53194","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53179","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53171","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107006","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110656","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87685","المجتث"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100267","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100729","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130117","البسيط"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139460",""],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111055","الوافر"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123457","الطويل"],[4709,"من أين لي بحروف أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214868",""],[4712,"يداويني حبيبي لا طبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=202611",""],[4822,"بحبك أيها الظبي الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=171235",""],[4955,"لكم فتن القلب في ذي الدنا","https://www.poetsgate.com/ViewPoem.aspx?id=200422",""],[5111,"غَفْوةُ الْحَلاجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212222",""],[5183,"العراقين","https://www.poetsgate.com/ViewPoem.aspx?id=180174",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5213,"ألا للّه خطبك ما أجلا","https://www.poetsgate.com/ViewPoem.aspx?id=170531",""],[5351,"على وثبة الصحو","https://www.poetsgate.com/ViewPoem.aspx?id=202102",""],[5362,"أرى الناس ميالين نحو التمدن","https://www.poetsgate.com/ViewPoem.aspx?id=170392",""],[5368,"وراءَ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=183827",""],[5368,"طوقاً من نجاة","https://www.poetsgate.com/ViewPoem.aspx?id=184389",""],[5431,"لأنك خبزي الأسمر ...","https://www.poetsgate.com/ViewPoem.aspx?id=198413",""],[5493,"شربنا من كؤوسِ الذل","https://www.poetsgate.com/ViewPoem.aspx?id=197087",""],[5751,"تَحارُ بكَ الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=214772",""],[6031,"وراءَ كُما إنَّ المُصَابَ جَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46289",""],[6090,"هدمت للمجد والعلياء أركانا","https://www.poetsgate.com/ViewPoem.aspx?id=170920",""],[6093,"النظرة العجلى","https://www.poetsgate.com/ViewPoem.aspx?id=200869",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""],[6262,"أحلامُ نورِ الدين الصغيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80126&r=&rc=24",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""]],"verses":[["وَراءَكَ فَالخَواطِرُ بارِداتٌ","عَلى الإِحسانِ وَالأَيدي جُمودُ",0,"د",1,0],["وراءَكَ إني لستُ أغْرِسُ نَخْلَةً","لأجْنيَ منها حينَ تُثْمِرُ حَنْظلا",1,"ل",2,0],["وراء النوى ، حيث لا برعم","جنين ، ولا موعد ، من جناح",2,"ح",1,0],["وَرَاءَ كُمُ عَمَّا أَرَدْ تُمْ فَإِنَّهَا","لَدَائِرَةٌ فِي الرَّأيِ دَاخَلَهَا الْخَرْمُ",3,"م",1,0],["وَرَاءَ كلِّ سَرِيرٍ مَثَّلُوهُ بِهِ","مِنَ الجَمَاعَاتِ مَا لَمْ يَجْمَعِ الرَّقَمُ",4,"م",1,0],["وراءكما ما اللوم يَثْني مقادتي","فإنِّيَ عن شأن الملامة في شانِ",5,"ن",1,0],["وَراءَكَ يانُمَيرُ فَلا أَمامُ","فَقَد حَرُمَ الجَزيرَةُ وَالشَآمُ",6,"م",1,1],["وَراءَ القافِلينَ بِكُلِّ أَرضٍ","وَأَوَّلُ مَن يُغيرُ إِذا أَغارا",7,"ر",2,0],["وراء معاطِفٍ منهُ لِدانٍ","إباءُ مكاسرٍ منهُ صِلابِ",8,"ب",1,0],["وراء بيض أياديه إذا غُمِطَت","بيضٌ يطيح بها بيضاً وأقحافا",9,"ف",2,0],["وراءك جَدٌّ لا ينام كلاءة","ودونك عزٌّ ذو مناكبَ مزْحمُ",10,"م",1,0],["وَراءَ رَيبِ اللَيالي أَو فُجاءَتِها","دَمعٌ لِكُلِّ شِماتٍ ضاحِكٍ رَصَدُ",11,"د",1,0],["وَراءَ كُلِّ سَبيلٍ فيهِما قَدَرٌ","لا تَعلَمُ النَفسُ ما يَأتي وَما يَدَعُ",12,"ع",1,0],["وَراءَكَ عَنّي يا عَذولَ الأَشايِبِ","بِكُلفَةِ عَذلٍ بَعدَ شَيبِ الذَوائِبِ",13,"ب",1,1],["وَراءَكَ عَن بَحرٍ يَغُطُّكَ مَوجُهُ","وَعَن جَبَلٍ تَعلو عَلَيكَ جَلامِدُه",14,"د",2,0],["وَراءَ سَوادِها يُخشى عَلَيها","لِيَمنَعَها وَما أَغنى قِبالا",15,"ل",2,0],["وراءَ سِترٍ لهما لم يَستُرِ","واعتَفَرا ظَبْيَ الصَّريمِ الأعفَرِ",16,"ر",1,0],["وراءَك يا بحرُ لي جَنّةٌ","لبستُ النّعيم بها لا الشقاءَ",17,"ا",2,0],["وَراءَكَ عَن شاكٍ قَليلِ العَوائِدِ","تُقَلِّبُهُ بِالرَملِ أَيدي الأَباعِدِ",18,"د",1,1],["وَرَاءَنَا الْبَحْرُ وَتِلْقَاءَنَا","سَوَادُ جَيْشٍ مُكْفَهِرٍّ لُهَامْ",19,"م",1,0],["وَراءَكُمُ إِنّي لَقيتُ مِنَ الهَوى","تَباريحَ أَبلَت جِدَّتي وَشَبابِيا",20,"ي",2,0],["وراءَكِ واطْلُبِي قَنَصاً سوانا","فإنّ لُحومَنا أمست سِماما",21,"م",2,0],["وَرَاءَكَ يا حُوَيْطِبُ كُلُّ عَضْبٍ","يَسُحُّ الموتُ من حَدَّيْهِ سَحّا",22,"ح",2,0],["وراءَكِ كلُّ مُنصلِتٍ طَموحِ","تُهيِّجُّ بأسَهُ رِيحُ الفتوحِ",23,"ح",1,0],["وراءك فتيةٌ تأبى النّكولا","وراءك نِسوةٌ للحرب تُزجَى",23,"ج",2,0],["وَرَاءَكَ يا عُيَيْنَةُ لا تَدَعْها","فما هِيَ عن دِفَاعِكَ بالغَنِيَّهْ",24,"ي",2,0],["وراءهم مسهد الفؤاد","موكّل العيون بالقوّاد",25,"د",1,0],["وراءك الركبُ في يأسٍ وفي أملٍ","لما يروْن وتصديقٍ وتفنيد",26,"د",1,0],["وراءَ العِدا مَجْرٌ على الهَوْلِ مُقْدِمٌ","وصِلٌ تَحاماه الأراقِمُ أَرقَمُ",27,"م",1,1],["وراء الستار الظفاري عيون","صليبية ، وفم مكتسب",28,"ب",1,0],["وراءك أقلام يهوِّن وقعُها","شبا السيف إن ساوى القرينَ قرينه",29,"ن",2,0],["وَرَاءَكَ مِنْ بَحْرٍ يَغُطُّكَ مَوْجُهُ،","وَمِنْ جَبَلٍ تَعلو علَيكَ جَلامِدُهْ",30,"د",2,0],["وَراءَكَ الخَلقُ في فَضلٍ وَفي كَرَمٍ","فَقُل لِسَعيكَ مَهلاً تَربَحِ التَعَبا",31,"ب",2,0],["وَراءَها عَلَما النَصرِ اللَذا كَفَلا","لِمَن أَظَلّا بِعِزٍّ لَيسَ يُنتَحَلُ",32,"ل",1,0],["وراءك عنه تنج ارومه طالبا","مكارمه يملا يديك مغانما",33,"م",2,0],["وراءك دون العلم ما لا تطيقه","من المهد أهلوه إلى اللحد تدأب",34,"ب",1,0],["وَراءَ هَوىً طَوَيتُ لَهُ ضُلوعي","حَذاراً وَهوَ بِالأَشواقِ بادِ",35,"د",1,0],["وراء حصونهم آساد غاب","تدمدم بالقنابل والسلاح",36,"ح",1,0],["وراءَ الكلّةِ البيضاءِ ظَبيٌ","غَريرٌ يَصرَعُ الأسَدَ الهَصُورا",37,"ر",2,0],["وراء حدود الغيب تهمى فيوضه","على خافق في الصدر جد جهيد",38,"د",1,0],["وراءَك إن زندَك غيرُ واري","ولو شقَّ الكواكبَ بالشرارِ",39,"ر",1,1],["وراءَك ارجِع إنَّ خيلَ الهوى","لا تلحقُ المسلوبَ بالسالبِ",40,"ب",1,0],["وراءَ الحُمول إلى أن قتل","تُ شكَّ الفراقِ بعيني يقينا",41,"ن",2,0],["وراءَها تعطيك أسنى خَبِّها","بنغضها رأساً مُخَشاًّ مانعا",42,"ع",2,0],["وراءَ الرزق مختبطين تَرمِي","بهم أصدارُها قفراً بقفر",43,"ر",1,0],["وراءَكُم ارجعوا فتضيَّفوها","بيوتاً لا مجاعةَ وهي تَقْرِي",43,"ر",2,0],["وراءَ العزّ نطلبُهُ فإما","وصلنا أو بلغنا فيه عُذرا",44,"ر",2,0],["وراءكِ أقوالَ الوشاة الفواجر","ودونك أحوال الغرام المخامرِ",45,"ر",1,1],["وراء حجب العلى طودٌ أَخو شرفٍ","أرجو نَداهُ فاذكاراً وتنْبيها",46,"ي",3,0],["وراءَك إنّي ما تركتُ لباحثٍ","من الدّهر ما يُفضِي إليَّ به سَبْرُ",47,"ر",1,0],["وراءكم أنتم وقدامكم","يا حضرة قد غبت في ذكرها",48,"ر",3,0],["وراء هذا الوجود عندي","وجود حقٍّ قديم عهدِ",49,"د",1,1],["وراءه الأمر الذي يقتضي","حقيقة تجهلها كل روح",50,"ح",1,0],["وراءه وكان من رأي عمر","إحداث ما كرهه لما عبر",51,"ر",1,0],["وراء عمرو فانبرى إليه","حتى إذا أمكن في يديه",51,"ه",1,0],["وراءك من ناع كأنك للورى","من النفخة الأولى أتيت بعاطب",52,"ب",1,0],["وَراءَك عن معشر حلّقت","بهم قادمات العلا عن زحل",53,"ل",1,0],["وراءك البلد الخصب الأمين بما","آثرت من سيرة واخترت من سنن",54,"ن",1,0],["وراءكم جيرة زالت خصومتهم","دأبتمُ في رضاهم مثل ما دأبوا",55,"ب",3,0],["وراءك عني داعي الصبر والأسى","فقد عز كظم الغيظ من بعد كاظم",56,"م",1,0],["وراءك فاذهب أينما شئت تذهب","فما لا مرءٍ من حادث الدهر مهرب",57,"ب",1,1],["وَرَاء طُلابِ العزة الناسُ كلهم","وأنك قُدَّامٌ وتلك وراءُ",58,"ا",2,0],["وَراءَ جَرْي السابِقِ المُصَمِّمِ","رَمَيْتَ عَنْ عِرْضِكَ رَمْيَ المِرْجَمِ",59,"م",1,0],["وَرَاءَكَ إِلاَّ عَنْ تَلَهُّبِ زَفْرَتِي","بِتِلْكَ الَّتِي تَزْدَادُ وَقْداً عَلَى وَقْدِ",60,"د",1,0],["وَرَاءَكَ عَنْ كُلِّ الْمُلوكِ وَعُجْ بِهَا","لأحْمَدِ مَلْكٍ سَاسَ أُمَّةَ أَحْمَدِ",61,"د",1,0],["وَرَاءَ ضُلُوعِ الغَيمِ قَلبُ مَشُوقِ","لِبَرقٍ بِذَاتِ الأَبرَقَين خَفُوقِ",62,"ق",1,1],["وراءك أبرادٌ لعلياء لم تكنْ","تمدُّ الثريا نحوها كفَّ جاذب",63,"ب",1,0],["وَراءكِ عنها لا أباً لك إنَّما","تقدَّمتِها لا عن تقدّمِ سُؤدد",64,"د",1,0],["وراءكم يا حاسديه مكانه","بأندية العليا فإنَّ له الصدرا",65,"ر",2,0],["وراءكِ اليوم عن لهوي وعن طرَبي","فإن قلبيَ أمسى كعبةَ النوبِ",66,"ب",1,1],["وراءك عني لم تروعك لوعةٌ","بها ضاق صدري لا بليت بضيقه",67,"ق",2,0],["وراءك عني فاتك القصد إنما","يهيج كبيرات الأمور صغيرها",68,"ر",3,0],["وراءك أيها الباغي مداه","فأين مُنَاك من ذاك المرام",69,"م",1,0],["وراءك أيها الراجي مداه","فدون بلوغه طرق تهول",70,"ل",1,0],["وراءك عني بالملام فإنني","بسنة أحكام الهوى لم أبدلِ",71,"ل",1,0],["وراءك يا باغي عداه فإنه","مكان السها من ناظر المتأمل",71,"ل",1,0],["وراءك عني لا تسمني في الهوى","هوانا فلي أنف من العزّ يأباه",72,"ا",2,0],["وراءك فاذهب أين ما شئت تذهب","فما لأمرىء من حادث الدهر مهرب",73,"ب",1,1],["وَراءَ خمر العَذارى","كَم مِن جمالٍ مُحجَّب",74,"ب",1,1],["وَراءَهُم مَواكِب الخيل أَتوا","وَقد بَغوا حَقّاً عَلَينا بَل عَتوا",75,"ت",3,0],["وراءك منه منذلقاً حدودا","فلن تقفنَّ منه على حدود",76,"د",1,0],["وراءك يجري الحاسدون ليدركوا","علاك فتستحي فتمشي على مهل",77,"ل",1,0],["وَراءه خُلُقٌ سبحان واهبه","منزّه عن سجايا كلّ إنسانِ",78,"ن",1,0],["وراءً أو مقابلة وفوقاً","وتحتاً أو يمينا أو شمالا",79,"ل",2,0],["وراء ركابه جبريل يمشى","وميكائيل قد أخذ الزماما",80,"م",2,0],["وَراءَ أَبيهِ لِإِليونَ قِدما","أَتى لِيوافي القَضاءَ المُلِمّا",81,"م",2,0],["وراءها كل فتىً جذعاً حمل","أمرٌ لمريون له الكل امتثل",82,"ل",1,0],["وراءهم الأخاءة وال","جواشن في عواتقهم",83,"م",1,0],["وَراءَهُ السورُ وَالأَركانُ قَد رُفِعَت","أَوتادُها غَضَّةً من ضِمنِ سُدَّتِهِ",84,"ه",1,0],["وراءَ مضيقِ الخوفِ متسعُ الأمنِ","وأولُ مفروحٍ به آخرُ الحزنِ",85,"ن",1,1],["وراءك رائد المعروف سيراً","وسيراً في الورى جيلاً فجيلا",86,"ل",2,0],["وراءك لست أبلغ منك هجوا","وإن جاز المدى معشار عشر",87,"ر",1,0],["وراءَك يا مغرورُ خنجَرُ فاتكٍ","وأنتَ مُطأطس لا تفيقُ ولا تدري",88,"ر",2,0],["وراءيتمُ مَن كان للّه مُخلِصاً","كمَن شبَّهَ الوجهَ البهيَّ بأسحَمِ",89,"م",1,0],["وراءٍ ربيعٌ هو العمرُ أمسى","بقربِ الحبيبِ كعطرٍ يفوحُ",90,"ح",1,0],["وراءَ عظيمةٍ رَجُلٌ عظيمٌ","ولستُ أرَى لأسمَى الحُبِّ سَقْفا",91,"ف",2,0],["وراءك يا حسود فمت بغيظ","فإن أبا تراب هو السفير",92,"ر",1,0],["وراءَ الضلوعِ فؤادٌ كسيرٌ","بنبضٍ حزينٍ لربَّي انحنى",93,"ن",2,0],["وَرَاءَ هَذِيْ الدُّنَى تَصْبُو إلَيْكِ دُنَى","بَيْنَ الْفُؤَادِ ، وَبَيْنَ الرُّوْحِ تَنْتَظِرُ",94,"ر",1,0],["وراءك صدي إن صدعي إرادة","وقصدي إحسان ومرماي كوكب",95,"ب",1,0],["وَرَاءَ سِتَارِ التَّدَيُّنِ أَخفَوْا","مَطَامِعَهُمْ فِي قُصُورٍ وجَاهْ",96,"ا",2,0],["وراءكم فان العلم جفت","موارده وعاد الروض محلا",97,"ل",2,0],["وراء تعزاتهِ مأربٌ","وفي جوفهِ حوفُ ترمي ثمودْ",98,"د",1,0],["وراءك عن يانني قد وزنتهم","وما وازن ما عنده كالخمن",99,"ن",1,0],["وَراءَ الصَّمْتِ أَشْجانٌ تَلظَّتْ","وبَوْحُ الجرْحِ أَصْعب ما أُدارِي",100,"ر",2,0],["وَراءَ الصَّمْتِ يَخْتَنِقُ اشتِياقِي","سِلاحِي دَمْعتِي والكِبْرياءُ",101,"ا",2,0],["وراء الروح اوردتي","دعاءٌ قام واستغفرْ",102,"ر",1,0],["وَراءَ ظُهُورِنَا أَضْغَاثُ رُؤْيَا","جَعَلْنَاهَا خُرَافَاتٍ وَسِحْرَا",103,"ر",2,0],["وراءَكَ ألفُ أغنيةٍ ولحنٍ","وعشاقٌ وأشرعةٌ ونجمُ",104,"م",1,0],["وراءَ كُما إنَّ المُصَابَ جَليلُ","وإنَّ البُكَا في مِثْلِهِ لَقَلِيلُ",105,"ل",1,1],["وراءه قد مشوا ميل الرقاب ترى","قلوبهم فوقه تبكيه تحنانا",106,"ن",2,0],["وراءَ النَّظرةِ العَجْلى","يَدورُ حِوارُنا الأعظمْ",107,"م",1,1],["وراء الهضبة الحمراء حفلٌ..","وراء تلالها رقصتْ تلال",108,"ل",1,0],["وراءَ السماءِ/الشِّعرِ..أبعد ما تُرى","وراءَ اللغاتِ/العُشْبِ..والقمرِ الطفلِ",109,"ل",1,1],["وراءَ العيونِ/الصَّحْوِ..والغيمةِ/البُكا","ولونِ دُمَى الأمواجِ والوردةِ/الليلِ",109,"ل",1,0],["وراءَ اندهاشِ الوقتِ والنجمةِ التي","تُواعدُها في صمتِ شارعِكَ الكهلِ",109,"ل",1,0],["وَراءَ تِسْعِينَ جِيلاً ، أُفْرِدَتْ عُصُرٌ","ذاْ مَضَتْ في هَبَاءٍ ، أتْأَمْتَ عُصُرُ",110,"ر",1,0]]}