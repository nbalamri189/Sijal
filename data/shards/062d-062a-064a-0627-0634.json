{"poems":[[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[51,"سبحان جبار السماء","https://www.aldiwan.net/poem63210.html","مجزوء الكامل"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54743","البسيط"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[234,"أذكرني النرجس أجفان من","https://www.aldiwan.net/poem50987.html","السريع"],[369,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[376,"وأغن أغيد وده","https://www.aldiwan.net/poem56935.html","مجزوء الكامل"],[500,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20471","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100346","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134016","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97086","الكامل"],[4307,"","https://poetry.dctabudhabi.ae/diwan/poem/31538","الكامل"],[4575,"","https://poetry.dctabudhabi.ae/diwan/poem/31515","البسيط"],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[5956,"إن كان عبد الله أصبح ساليا","https://www.poetsgate.com/ViewPoem.aspx?id=194611",""],[5956,"سوريّةُ العربية","https://www.poetsgate.com/ViewPoem.aspx?id=204722",""],[6052,"رداء السكينة والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=34646",""]],"verses":[["حَتّى أُشِبَّ لَهُ ضِراءُ مُكَلِّبٍ","يَسعى بِهِنَّ أَقَبُّ كَالسِرحانِ",0,"ن",1,0],["حَتّى أُشَكِّكَهُ فَيَس","كُتَ عَن مَلامي وَالمِراءِ",1,"ا",2,0],["حَتّى أُشِبَّ لَهُنَّ الثَورُ مِن كَثَبٍ","فَأَرسَلوهُنَّ لَم يَدروا بِما ثيروا",2,"ر",3,0],["حَتَّى اشْرَأَبَّتْ عُقَابُ الْفَجْرِ وَانْطَلَقَتْ","حَمَائِمُ الشُّهْبِ مِنْ أُحْبُولَةِ السَّحَرِ",3,"ر",1,0],["حَتَّى أَشَادَتْ بِفَضْلِ مِصْرَ","حَوَاضِرُ الشَّرْقِ وَالْبَوَادِي",4,"د",2,0],["حتى اشتروا بدمائهم","حرية الوطن الغبين",5,"ن",1,0],["حتى أشاب الصبحُ فرعَ الدجى","ولم أنم عنه ولم ينعسِ",6,"س",1,0],["حتّى أُشهِّرَ فيك كلَّ بديعةٍ","تَثْني زمامَ الرّاكبِ المُستَعْجِل",7,"ل",1,0],["حتَّى أشاوِرَ قلتُ","لكنّي هَويتُ ولم أشاوِر",8,"ر",1,0],["حتى اشتفوا من يوم بد","ر واستبدوا بالزعامه",9,"م",2,0],["حَتَّى اشْفَتَرُّوا فِي البِلادِ أُبَّقا","قَتْلاً وَتَعْوِيقاً عَلَى مَنْ عَوَّقا",10,"ق",2,0],["حَتَّى اِشتَهى المصري أَن يَزورَها","وَقالَ إِني مزمِعٌ حُضورَها",11,"ه",2,0],["حَتّى أُشِبَّ لَها وَطالَ إِيابُها","ذو رُجلَةٍ شَثنُ البَراثِنِ جَحنَبُ",12,"ب",1,0],["حَتّى اشتَفى وَشفى مِنها لُبانَتهُ","وَما يَزيدُ شِفاءً غَيرَ اِسقامِ",13,"م",1,0],["حتى اشمّ ضحى خَياشمها","شذا المسك الفتيق",14,"ق",1,0],["حتى اشار لكفها باصابع","رجعت له من زهرها بتخم",15,"م",1,0],["حتى اشتفى الطاغي","وروى من دم الهادي سيوفه",16,"ف",2,0],["حَتّى أُشِبَّ لَها أُغَيبِرُ نابِلٌ","يُغري ضَوارٍ خَلفَها وَيَصيدُ",17,"د",1,0],["حَتّى أُشِبَّ لَها رامٍ بِمُحدَلَةٍ","ذو مِرَّةٍ بِدُوارِ الصَيدِ هَمّاسُ",18,"س",1,0],["حتّى اشرَأبَت ْ فكانَتْ مِثلما عُرفتْ","ظلماءَ دَهماءَ فِيها المَوْت ُ يَصْطَفِقُ",19,"ق",1,0],["حتى اشتكتْ زوجي من المنأى بنا","عن موطنٍ قهرتْه عصبةُ مافِيا",20,"ي",2,0],["حتى اشتهى أهلُ المقابر أنهم","فيها يكون البعث يوم الآخِرِ",21,"ر",1,0],["حتى اشتهتْ تلدُ البنينَ لمثلها","ويكون ذكرٌ للمآثرُ خُلَّدا",22,"د",2,0]]}