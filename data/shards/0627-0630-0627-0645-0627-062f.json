الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117201","المتقارب"],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143720","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18799","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120235","الطويل"],[4691,"تلحفتُ حرفَكِ لمّا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=216035",""],[1901,"رويْدَكَ لا تُشمتْ بصاحِبكَ العِدَى","https://www.poetsgate.com/ViewPoem.aspx?id=160420",""],[4119,"لك الله إن حاربت فالنصر والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=16107",""],[2365,"ألاهل الى ورد العراق سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=200655",""],[5280,"أوهام عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=187770",""],[5323,"بارق ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=207293",""],[5376,"إذا ما دنتْ مني المنيةُ لا تُعِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=192171",""],[5376,"سقى اللهُ نفساً لا تبورُ بذكرِه","https://www.poetsgate.com/ViewPoem.aspx?id=196443",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[2215,"سألزمُ نفسي الصفحَ عن كل من جنى","https://www.poetsgate.com/ViewPoem.aspx?id=113137",""],[5616,"العقد الفريد","https://www.poetsgate.com/ViewPoem.aspx?id=204588",""],[5690,"أسيرُ وقلبي في الغرام أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172162",""],[5691,"زمان الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=206311",""],[5795,"أبيت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""],[5809,"نوبة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205654",""],[5814,"إِذا أَنا لم أَصْبِر على الذَّنب من أَخ","https://www.poetsgate.com/ViewPoem.aspx?id=189519",""],[6002,"أَلاَ أَيُّهَا الْحَادِي تَرَنَّمْ وَزَمْزِمِ","https://www.poetsgate.com/ViewPoem.aspx?id=210297",""],[6004,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=59103",""],[6080,"إذا ما دهاك الدهر يوما بمعضل","https://www.poetsgate.com/ViewPoem.aspx?id=127324",""],[6093,"أرى الحُبُّ حَلَّ نَفْسَا","https://www.poetsgate.com/ViewPoem.aspx?id=178428",""],[6179,"إذا ما دَعَاهُنَّ ارْعَوَيْنَ لِصَوْتِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7629&r=&rc=12",""],[6259,"أخذن زمام الدَّمع خوف انسجامه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59398&r=&rc=46",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""],[6345,"فديتك بالروح يا موطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78673&r=&rc=44",""],[6345,"بلادي الإمارات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78677&r=&rc=48",""]],"verses":[["إِذا ما دُعوا خِلتَ الرِياحَ عَواصِفاً","تَهيلُ ثَرىً مِن جانِبِ الغَورِ أَو رَملا",0,"ل",2,0],["إِذا ما دَعاهُ الشَوقُ راوَحَ كَفَّهُ","عَلى لاعِجٍ في مُضمَرِ القَلبِ لاطِفِ",1,"ف",1,0],["إِذا ما دُخانُ النَدَ مِن ثَوبِها عَلا","عَلى وَجهِها أَبصَرتَ غَيماً عَلى شَمسِ",2,"س",1,0],["إِذا ما دُعوا لِليَومِ ذي الخَطبِ أَصفَحوا","صُدورَ الحَرابي أَرمَضَتها الهَواجِرُ",3,"ر",1,0],["إِذا ما دَعا الداعونَ لِلبَأسِ وَالنَدى","فَلا الجودُ مَنزورٌ وَلا الغَوثُ رائِثُ",4,"ث",1,0],["إِذا ما ديمَ نَمَّرَ صَفحَتَيهِ","وَقامَ عَلى بَراثِنِهِ إِباءَ",5,"ا",2,0],["إذا ما دَعا لبَّاهُ حُمْشٌ كأنَّها","تُفَتِّشُ عن سِرِّ الصَّباحِ وتَبحَثُ",6,"ث",1,0],["إذا ما دَعا لَبّاهُ كُلُّ سَمَيْدَعٍ","تُعَلُّ بِكَفَّيهِ الرُّدَيْنيَّةُ السُّمْرُ",7,"ر",1,0],["إِذا ما دَعَوتُ الصَبرَ بَعدَكِ وَالبُكا","أَجابَ البُكا طَوعاً وَلَم يُجِبِ الصَبرُ",8,"ر",1,1],["إِذَا مَا دَعَا دَاعٍ مِنَ الْقَوْمِ بِاسْمِهِ","وَثَبْتُ وَمَا اسْتَتَبْتُ شِيمَةَ هَيْمَانِ",9,"ن",1,0],["إِذَا مَا دَجَا رَوْعٌ فَغُرَّةَ يُوسُفٍ","تُضِيءُ بِهَا الآَفَاقُ فِي الْحَادِثِ الْجَهْمِ",10,"م",1,0],["إذا ما دَنا الإمْساءُ حُيِّيتَ بالمُنى","ومهْما أتى الإصْباحُ حُيّيتَ بالبُشْرى",11,"ر",2,0],["إِذا ما دَنا مِنها اِلتَقَتهُ بِحافِرٍ","كَأَنَّ لَهُ في الصَدرِ تَأثيرَ مِحجَمِ",12,"م",1,0],["إِذا ما دَعاها أَوزَغَت بَكَراتُها","كَإِيزاغِ آثارِ المُدى في التَرآئِبِ",13,"ب",1,0],["إذا ما دممنا الدهر يوماً وأهله","فإنك من تلك المذمّات مستثنى",14,"ن",2,0],["إِذا ما دَعا قَومٌ عَلَيَّ أَخاهُمُ","دَعَوتُ فَلَم أُسمِع حَكيماً وَلا عَمرا",15,"ر",2,0],["إِذا ما دَعا جَنباءُ قالَ اِبنُ دَيسَقٍ","لَعا لَكَ فيها عالِياً غَيرَ تاعِسِ",16,"س",1,0],["إِذا ما دَرُّها لَم يَقرِ ضَيفاً","ضَمِنَّ لَهُ قِراهُ مِنَ الشُحومِ",17,"م",1,0],["إذا ما دعاها الدهر يا عزَّة الهدى","بذا فدعاها السطو يا ذلَّة الشرك",18,"ك",1,0],["إذا ما دعته الحرب يا قاتل العدى","بدا فدعاهُ الجود يا قاتل المحل",19,"ل",1,0],["إذا مادحٌ أرَّقْتَ عينيهِ باطلاً","كواكَ بمكْواة الهِجاء فأنضجا",20,"ج",2,0],["إذا ما دعا منه خليل خليله","بأفديك لباه مجيباً فأسرعا",21,"ع",2,0],["إذا مادحٌ أسدَى وألحمَ باطلاً","فمدحك مسدىً بالذي فيك مُلحَمُ",22,"م",1,0],["إذا ما دخلْتَ فلاحظتَهُ","نظرتَ إليه بطرفٍ شَفون",23,"ن",1,0],["إِذا ما دَعَت شيباً بِجَنبَي عُنَيزَةٍ","مَشافِرُها في ماءِ مُزنٍ وَباقِلِ",24,"ل",1,0],["إِذا ما دجا ليلُ العجاجةِ لم يزلْ","بأيديهم جمرٌ إِلى الهند منسوبُ",25,"ب",1,0],["إِذا ما دَلَفتَ إِلى نِعمَةٍ","عَصَفَت بِرَونَقِها فَاِستَطارا",26,"ر",2,0],["إِذا ما دَعا غِلمانُهُ لِبَلِيَّةٍ","فَخَلوَتُهُ بِالعِفرِ دونَ المُراهِقِ",27,"ق",1,0],["إذا ما دعونا لاحِقاً ومُعانِقاً","وقِيدَ لدَيْنا واثِبٌ ومُخالِسُ",28,"س",1,1],["إِذا ما دَنا مِنَ الضَريبَةِ لَم يَخِم","يُقَطِّعُ أَوصالَ الرِجالِ وَيَنتَقي",29,"ق",2,0],["إِذا ما دَعاكَ الرُشدُ أَحجَمتَ دونَهُ","وَأَنتَ إِلى ما قادَكَ الغَيُّ تَبدُرُ",30,"ر",1,0],["إِذا ما دَرى إِبليسُ ما في طِباعِها","مِنَ السِرِّ قالَ الجِنُّ نَفديكَ يا إِنسُ",31,"س",1,0],["إِذا ما دَعَوناهُ بِأَجلَحَ أَيمَنٍ","دَعاهُ وَلَم يَظلِم بِأَصلَعَ أَنكَدِ",32,"د",1,0],["إِذا ما دَعَت أَترابَها فَاِكتَنَفنَها","تَمايَلنَ أَو مالَت بِهِنَّ المَآكِمُ",33,"م",1,0],["إِذا ما دَعَت بِالمِرطِ كَيما تَلُفَّهُ","عَلى الخَصرِ أَبدَت مِن رَوادِفِها فَخرا",34,"ر",2,0],["إِذا ما دَجا لَيلُ العَجاجِ رَأَيتَهُ","يَشُقُّ عَنِ النَصرِ العِدى وَالدَياجِيا",35,"ي",2,0],["إِذا ما دَعا الشُمَّ الأُباةَ لغارةٍ","دَعا البَيتُ فيهِ وَاستَجابَت أخاشبُهْ",36,"ب",2,0],["إِذا ما دُعوا لَم يَسأَلوا مَن دَعاهُمُ","وَلَم يُمسِكوا فَوقَ القُلوبِ الخَوافِقِ",37,"ق",1,0],["إِذا ما دَنَوتُم تَلَقَّتكُمُ","زَبوناً وَقَرَّت بِحَلّابِها",38,"ب",3,0],["إِذا ما دَنَت مِن مَشرَعٍ قَعقَعَت لَها","عِصِيٌّ وَقامَت زَأرَةٌ وَزُقاءُ",39,"ا",2,0],["إِذا ما دَنا وَقتُ الصَلاةِ رَأَيتَهُم","يَحُثّونَها حَتّى تَفوتَهُمُ سُكرا",40,"ر",2,0],["إِذا ما دَعا بِاسمي العَريفُ أَجَبتُهُ","إِلى دَعوَةٍ مِمّا عَلَيَّ تَهونُ",41,"ن",1,0],["إِذا ما دَعا ثابت إِلَيهِ عَصائِبٌ","كِرامٌ أُعينوا بِالصَلاةِ وَبِالصَبرِ",42,"ر",1,0],["إِذا ما دَعِيُّ القَومِ ضاهى صَريحَهُم","فَلا تَنكُرَن وَاِعدُدهُ آخَرَ عَبدَلِ",43,"ل",1,0],["إِذا ما دَنَت زِدتُ اِشتِياقاً وَإِن نَأَت","جَزِعتُ لِنَأيِ الدارِ مِنها وَلِلبُعدِ",44,"د",1,0],["إِذَا مَا دَعَوْتَ الْمَرءَ دَارَ بِلَحْظِهِ","إِلَيْكَ وَغَشَّاهُ الذُّهُولُ عَنِ الْجَهْرِ",45,"ر",1,0],["إِذَا مَا دَنَتْ فَوْقَ الْفِرَاشِ لِوَسْنَةٍ","جَفَا خَصْرُهَا عَنْ رِدْفِهَا الْمُتَخَاذِلِ",46,"ل",1,0],["إِذَا مَا دَعَوْتَ الْمَرْءَ مِنْهُمْ لِدَعْوَةٍ","عَلَى عَجَلٍ لَبَّاكَ غَيْرَ مُسَائِلِ",46,"ل",1,0],["إِذَا مَا دَعَا داعِي الحِفاظِ أَجَابَهُ","مُجِيبٌ يَرَى التَّفرِيطَ فِي حَقِّهِ كُفْرَا",47,"ر",2,0],["إِذَا ما دَوَاءٌ يَا طَبِيبِي أَعَلَّنِي","فَقَدْ كَان أَشْفَى مِنْهُ لِي ذلِكَ اللُّطْفَ",48,"ف",1,0],["إذا ما دنا الإمساء حييت بالمنى","ومهما أتى الإصباح حييت بالبشرا",49,"ر",2,0],["إذا ما دجى روع فغرة يوسف","تضيء بها الآفاق في الجادة الجهم",50,"م",1,0],["اذا ما \" دواويننا \" نُشِّرت","فكلٌّ وما ضَمَّ \" ديوانه \"",51,"ن",2,0],["إذا ما دَعَتْ أَتْرابَها، فکكْتَنَفْنَها،","تَمَايَلْنَ أَوْ مَالَتْ بِهِنَّ المَآكِمُ",52,"م",1,0],["إذا ما دهاني زمان الخطو","ب أوجه سر فؤادي إليه",53,"ي",2,0],["إذا ما دعا أهل السفاهة والبذا","دعوت بأرباب التقى والبصائر",54,"ر",1,0],["إِذا ما دَعاهُ الرّاغِبونَ لِحاجَةٍ","فَلا الصَوتُ مَحجوبٌ وَلا الجودُ رائِثُ",55,"ث",1,0],["إِذا ما دَعَوتُ اِبنَي نِزارٍ أَجابَني","كَتائِبُ أَنكى في العِدى من يَدِ الدَهرِ",56,"ر",1,0],["إِذا ما دَعَت يابا الفَضائِلِ أَرعَدَت","فَرِيصَ الأَعادي فَاِتَّقَت بِالهَزائِمِ",57,"م",1,0],["إِذا ما دَفَعنا لِلبَليَّةِ مَرةً","وَلَم نَنتَفع بِالحُزنِ فَالصَبرُ أَحزمُ",58,"م",1,0],["إذا ما دعا الفهم اللبيب وقاده","هوى النفس يوما فاستجاز القبائحا",59,"ح",2,1],["إذا ما دعاكَ الحقُّ للظلمِ مرّةً","وقد كنتَ ذا حلمٍ فلا تَكُ ذا حلمِ",60,"م",1,1],["إذا ما دعا الداعي إليها تطايرت","سرائرُ من روحي تصول وتجهل",61,"ل",1,0],["إذا ما دَعا داعٍ إلى الشرِّ مرَّةً","وَهزَّت رياحُ الحادِثاتِ قناتي",62,"ي",1,1],["إذا ما دجا جِنْحُ الظلام أناره","لهنّ تَراقٍ وُصَّحٌ ونُحور",63,"ر",1,0],["إِذا مادَرَجنَ حَولَها يَرتَضِعنَها","جَرَينَ بِأَرزاقٍ تَدِرُّ وَآجالِ",64,"ل",1,0],["إِذا ما دَبَّ في خَمرٍ ذَليلٌ","سَعى سَعيَ الأعزَّةِ في السَراحِ",65,"ح",1,0],["إِذا ما دُعوا لِلبَغيِ قاموا وَأَشرَقَت","وُجوهُهُمُ وَالرُشدُ وِردٌ لَهُ نَفرُ",66,"ر",1,0],["إذا ما دنوتم فالحياة لذيذة","وفي العيش خير والزمان سليم",67,"م",1,0],["إِذا ما دَعَوتَ الشَيخَ شَيخاً هَجَوتَهُ","وَحَسبُكَ مَدحاً لِلفَتى قَولُ يا فَتى",68,"ت",2,1],["إِذا ما دَعاها اِستَسمَعَت وَتَأَنَّسَت","بِسَحماءَ مِن دونِ الغَلاصِمِ شَدقَمِ",69,"م",1,0],["إذا ما دَرى قَصَصَ الذّاهبِينَ","وجادَ لِيُذْكَرَ في الغابِرينا",70,"ن",2,0],["إذا ما دنا من ثَعْلَبِ الرُّمْحِ نَحْرُه","غدا كاسْمِه عن قَصْدِه منه أَرْوَغا",71,"غ",2,0],["إذا ما درَى الإنسانُ أخبارَ مَنْ مضَى","فتَحسَبُه قد عاشَ في أوَّلِ الدَّهر",72,"ر",1,0],["إذا ما دعا الرّأيُ الإماميُّ دَعوةً","أجاب إلى العلياء منهُ مُجيب",73,"ب",1,0],["إِذا ما دَواءٌ مَرَّ في غَيرِ عِلَّةٍ","بِجِسمٍ فَما أَمرَرتَ غَيرَ مُعِلِّهِ",74,"ل",2,0],["اِذا ما دَهاكَ الخطبُ تَخشى ضَرارَهُ","فَلا تَنتَظِر نَصراً سِوى نَصرِ خالِقك",75,"ك",1,1],["إذا ما دَعَا داعي المطالب مالَهُ","يُلبّيه منه طارفٌ وتليدُ",76,"د",1,0],["إذَا مَا دَجَتْ ظُلَمُ المشْكِلات","جَلّى دُجى لَيلِها الأَسْودِ",77,"د",1,0],["إِذا ما دَعا لِلهَجرِ خِلٌّ فَلبّه","إِلَيهِ وَلوَ كانَ الرَدى في ضِرامِهِ",78,"م",2,0],["إِذا ما دَعى الداعوَ حيَّ عَلى النَدى","وَحيَّ عَلى الهيجاء أَقبل مسرعا",79,"ع",2,0],["إذا ما دَنَت دارُ الأحِبَّة جدَّدَت","بقُربهم الأُنسَ الّذي كانَ أَنهَجا",80,"ج",2,1],["إذَا ما دَعاهُ الشوقُ خَرَّ كأنّما","به الموتُ لولاَ أنّهُ المتَأوّهِ",81,"و",2,0],["إذا ما دعاك الصَّبرُ يوماً