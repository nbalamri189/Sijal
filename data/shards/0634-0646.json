زائِلاً","أُعالِجُ مِنهُ عَوجَةً لا أُقَيمُها",5,"م",3,0],["شَنِئتُ مِنَ الصُحبان مَن لَستُ زائِلاً","أُدامِلُهُ دَملَ السِقاءِ المُخرَّقِ",6,"ق",1,0],["شُنِقوا وَلَو مُنِحوا الخِيارَ لَأَهَّلوا","بِلَظى سِياطِ الجالِدينَ وَرَحَّبوا",7,"ب",3,0],["شنتمري تفتل بديها","والهم جيها من كل جيها",8,"ه",2,0],["شنقوكم ليلاً على غير مهل","ثمّ دسّوا جسومكم في الرموس",9,"س",1,0],["شنقوكم لأنكم قد جعلتم","علّم الجيش غير ما منكوس",9,"س",1,0],["شنقوكم لأنكم قد أبيتم","أن تكونوا في ربقة الأنكليس",9,"س",1,0],["شَنِئَتْهم حُثالةٌ من أناس","أيقنوا أن مُخَّهم منكوتٌ",10,"ت",1,0],["شنعاءُ في الآذان تُق","لق كلَّ روحٍ في جسدْ",11,"د",1,0],["شنعاء تُضْرم فيك نار شناعةٍ","تبقى نوائرُها وأنت رمادُ",12,"د",1,0],["شننتُ عليه حلةً ليس عيبها","سوى أنها ظلت تطول ويقصر",13,"ر",1,0],["شُنطفُ يا عُوذَة السمواتِ وال","أرض وشمسَ النهار والقمرِ",14,"ر",1,1],["شنطُف يا سوءَ ما مُنِيت به","ما كُنتِ إلا فريسةَ القدر",14,"ر",1,0],["شنعاءَ لو جُلِّل النهارُ بها","بُدِّل من ضوئه بإغطاش",15,"ش",1,0],["شنوفٌ من صنوفِ العِلْ","مِ بالآذانِ متصلَهْ",16,"ل",2,0],["شَنَّ هذا على الجلود من الما","ءِ وهذا حَماه من شاربيه",17,"ي",2,0],["شنَّ فيه على الجلود بروداً","فأباخَ الحَروَر عن صائميه",17,"ي",2,0],["شَنَّفَ السامِعينَ دُرُّ كَلامي","وَتَحَلَّت أَجيادُهُم أَطواقي",18,"ق",2,0],["شنؤوا العروبة مدعين ولاءها","ما بالولي مخادع ظلام",19,"م",1,0],["شَنَنتَ بِها الغاراتِ حَتّى تَرَكتَها","وَجَفنُ الَّذي خَلفَ الفَرَنجَةَ ساهِدُ",20,"د",1,0],["شَنَنتَ عَلى نَهرِ اليَهودِيِّ غارَةً","هَوى خُرَّمِيّوها وَطاحَ يَهودُها",21,"د",3,0],["شَنِئتُ الصَبا أَن قيلَ وَجَّهنَ نَحوَها","وَعادَيتُ مِن بَينِ الرِياحِ قَبولَها",22,"ل",3,0],["شَنعاءُ جادِعَةُ الأُنوفِ مُذِلَّةٌ","كانَت لَهُ نَزَلَت بِكُلِّ غَرامِ",23,"م",1,0],["شنّفه الحسن بلا شنوف","وذنب كالنون في الحروف",24,"ف",1,0],["شنَّا على الآدابِ أقبحَ غارةٍ","جَرحَتْ قلوبَ محاسنِ الآدابِ",25,"ب",1,0],["شَنَنتَ عَلى الأَعداءِ غارَةَ عَزمَةٍ","فَبادَت وَلَمّا يُغنِها النَبلُ وَالبَطشُ",26,"ش",1,0],["شَنعاءُ بَينَ المَركَبِ الهِملاجِ قَد","كَمَنَت وَبَينَ الطَيلَسانِ المُطبَقِ",27,"ق",1,0],["شَنِئتُ بِمُجتَلاها النورَ حَتّى","شَنِئتُ بِمُجتَلى النورِ القَضيبا",28,"ب",2,0],["شَنِجُ النَسا أَدفى الجَناحِ كَأَنَّهُ","في الدارِ بَعدَ الظاعِنينَ مُقَيَّدُ",29,"د",1,0],["شَنِئتُ العَقرَ عَقرَ بَني شَليلٍ","إِذا هَبَّت لِقارِإِها الرِياحُ",30,"ح",1,1],["شَنونٌ أَبوهُ أَخلَدِيٌّ وَأُمُّهُ","مِنَ الحُقبِ فَحّاشٌ عَلى العِرسِ باسِلُ",31,"ل",1,0],["شَنَّعَ الظَنُّ عَلَينا عِندَكُم","إِنَّما كَذَّبَهُ الحُسنُ لَنا",32,"ن",2,0],["شُنعُ الأَسامي مُسبِلي أُزُرٍ","حُمرٍ تَمَسُّ الأَرضَ بِالهُدُبِ",33,"ب",1,0],["شَنّعَ المُرْجِفونَ عنكَ بِهَجري","وأشاعُوا أنّي سَلَوْتُ هَواكا",34,"ك",2,0],["شَنَنَّا عليهم كلَّ جَرْداءَ شَطْبَةٍ","لَجُوجٍ تُبارِي كُلَّ أَجْرَدَ شَرْجَبِ",35,"ب",1,0],["شَنُّوا بِهَا غَارَةً أَلْقَتْ بِرَوْعَتِهَا","أَمْناً يُؤَلِّفُ بَيْنَ الذِّئْبِ وَالْحَمَلِ",36,"ل",1,0],["شَنَّهَا غارَةً عَلَيَّ وَلَكِنْ","بَاءَ بِالْحَدِّ وَالقَصَاصِ الشَّدِيدِ",37,"د",1,0],["شُنعاً شواردَ كالسها","م جِبارُها لا تَدرُس",38,"س",1,0],["شُنُّوا عليهم كلَّ يومٍ غارةً","في كل وادٍ، في المدائِن، في القُرى",39,"ر",2,0],["شَنُونٌ أَبُوهُ الأَخْدَرِيُّ وأمُّهُ","من الحقب فحّاشٌ على العرس باسل",40,"ل",1,0],["شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","إذَا هَبَّتْ لِقَارِيهَا الرِّيَاحُ",41,"ح",1,1],["شَنِئْتُ الصَّبَا إذْ قيلَ وَجّهنَ نَحْوَها،","وَعادَيْتُ مِنْ بَينِ الرّياحِ قَبُولَهَا",42,"ل",3,0],["شنَّ فيه على الجواد بروداً","فأباخَ الحَرورَ عن صائميه",43,"ي",2,0],["شنوا علي من التأفف غارة","وبعذلهم جعلوا نهاري داجيا",44,"ي",2,0],["شنف بذكر الحي اسماعنا","وصف لنا حدائق الورد",45,"د",1,0],["شنَّ غاراتِه على عازبِ السؤ","ددِ ما يقترِحْ يحوز ويَسبي",46,"ب",2,0],["شَنَنتَ عَلَيهِمُ شَعواءَ أَبقَت","لِكُلٍّ مِنهُمُ قَلباً خَفوقا",47,"ق",2,0],["شَنئتُ حَياتي والحياةُ لَذيذةٌ","إذا غابَ مَن نهوى فلا خَيرَ في العَيشِ",48,"ش",1,0],["شَنَيتُ الكَلِمَ المَدخو","لَ وَالشِعرَ إِذا اِستَغلَق",49,"ق",1,0],["شنَّ النهابَ على قوافلِ ماله","بأنامل كمغيرةِ الأكراد",50,"د",1,0],["شُنوف عقيقٍ صِيغَ من سبج لها","مَعاليقُ ما باشَرْن فيها مَعاقدا",51,"د",2,0],["شَنعاءُ جُلِّلَ مِن سَوآتِها حَضَنٌ","وَسالَ ذو شَوغَرٍ مِنها وَسُلوَانُ",52,"ن",1,0],["شنع العاذل عني سلوة","كذب العاذل فيما شنعا",53,"ع",2,0],["شنَعَّ الناسُ أنني جاهليٌّ","ما نوى وما لهم أهواءُ",54,"ا",2,0],["شَنَقوا قلعَهَا مراراً على الريح","ولا شكَّ أنه مظلومُ",55,"م",1,0],["شنّعوا تلك الأراجيف الّتي","لججاً خاضوا بها في بحر غي",56,"ي",1,0],["شنّف السمع مطرباً بالسماعِ","فالهوى يسترقّ حرّ الطباعِ",57,"ع",1,1],["شنَّفتَ سَمعي بنظم قافيةٍ","لَو باهَت الدرَّ أَرخَصت قيمَه",58,"م",2,0],["شنّها لاعج الحنين إلى مج","د قديم مضيّعٍ مفقود",59,"د",1,0],["شُندُفٌ أَشدَفُ ما وَرَّعتَهُ","فَإِذا طُؤطِئَ طَيّارٌ طِمِرّْ",60,"ر",1,0],["شنِّفِ السَّمعَ لي بذكْر عليٍّ","خير مَاشٍ يسيرُ فوق التُراب",61,"ب",1,0],["شنف بها كل سمع ولتكن حذراً","من أن تعربد سكراً من حمياها",62,"ا",3,0],["شنَّ مغيراً على القلوب فما","ينهض ثِقلاً منها بما علِما",63,"م",2,0],["شُنَّت عليك مغيرةٌ لا تُقتضَى","ذَحلا ولا يودى لها مقتولُ",64,"ل",1,0],["شنَّتْ على الكناس حتى لم تدع","للريم إلاّ حَمَشاً أو خَنَسا",65,"س",2,0],["شنعاءَ لو طَرَقَ الخَيالُ بمثلها","عيني لما أطبقتُ مقلةَ راقدِ",66,"د",1,0],["شنعاءُ مُخْلِفةٌ النجومِ جَنوبُها","مطْرودةٌ عن جوِّها بالشَّمْألِ",67,"ل",1,0],["شَنَقتُ بِها مَعابِلَ مُرهَفاتٍ","مُسالاتِ الأَغِرَّةِ كَالقِراطِ",68,"ط",1,0],["شِنْشنَةٌ صارتْ له مذهباً","وهو لها دونَ الورى أخزَمُ",69,"م",1,0],["شَنَّ مِن أَودٍ عَلَيكُم شَنَّةً","إِنَّهُ يَحمي حِماها وَيَغارُ",70,"ر",1,0],["شنّوا الإغارَ على نهبِ الجِمالِ وإذْ","فيهِم أتَتْ وهَبوها كلّما نهَبوا",71,"ب",3,0],["شَنَّ عليها بماءٍ باردٍ","شَنٌّ مَنُوطٌ بأَخْرابِ هَزِيمْ",72,"م",1,0],["شَنَنْتُمُ بغضاءكمْ فينا وكمْ","شَنّ اِمرؤٌ في قومِهِ ما لم يُشَنْ",73,"ن",1,0],["شَنِئَتْكَ النفوسُ وانحرفَتْ عن","كَ قلوبٌ وكنتَ تَسْبي القُلوبا",74,"ب",2,0],["شَنُّوا عليْه وما سقو","ه قطرةً من ماءِ شَنِّ",75,"ن",1,0],["شِنْشِنةٌ تُعْرَفُ من يُوسُفٍ","في الحَرْبِ لا تُعْرَفُ من أَخْزَم",76,"م",1,0],["شَنَنْتَ بها الغاراتِ حتى نباتِها","وأَعْشَابَها مِنْ حُمرَةِ الدَّمِ عَنْدمُ",77,"م",1,0],["شنعاءَ ما حسَّ الفَوارِسُ جَمرَها","إلاَّ رمَت شَرراً عَلى الأشرار",78,"ر",