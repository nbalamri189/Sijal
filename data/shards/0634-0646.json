{"poems":[[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[53,"أتذكراني طلب الطوائل","https://www.aldiwan.net/poem29897.html","الرجز"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[42,"تعلم يقينا أنني لك ماقت","https://www.aldiwan.net/poem50410.html","الطويل"],[42,"تعلم بأني إن أردت صحابتي","https://www.aldiwan.net/poem50411.html","الطويل"],[86,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[83,"ألني أبلغ من العمل","https://www.aldiwan.net/poem54195.html","مخلع البسيط"],[88,"أيها الأنجم التي قد رأينا","https://www.aldiwan.net/poem45031.html","الخفيف"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"لي أربعون من السنين","https://www.aldiwan.net/poem10868.html","مجزوء الكامل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"مدحت سليمان المغلب مدحة","https://www.aldiwan.net/poem62864.html","الطويل"],[51,"شنطف يا عوذة السموات والأرض","https://www.aldiwan.net/poem62918.html","المنسرح"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[51,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[70,"رفعت رايتي على العشاق","https://www.aldiwan.net/poem42791.html","الخفيف"],[89,"ابناء دجلة والفرات نيام","https://www.aldiwan.net/poem44882.html","الكامل"],[43,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[45,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[45,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[61,"لما تنادى اليوم بالخفوف","https://www.aldiwan.net/poem51349.html","الرجز"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[66,"شمول إلى نيرانها أبدا نعشو","https://www.aldiwan.net/poem38489.html","الطويل"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[74,"أرقت على الصبا لطلوع نجم","https://www.aldiwan.net/poem12871.html","الوافر"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[13,"شنئت العقر عقر بني شليل","https://www.aldiwan.net/poem2189.html","الوافر"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[52,"قليعقوب فديناك بنا","https://www.aldiwan.net/poem26644.html","الرمل"],[48,"من غائب في الحب لم يؤب","https://www.aldiwan.net/poem62414.html","البسيط"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54798","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[22,"أرى العير تحدى بين قنٍّ وضارجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19793",""],[13,"شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180790",""],[45,"قِفَا في مَغاني الدّارِ نَسألْ طُلُولَها","https://www.poetsgate.com/ViewPoem.aspx?id=32118",""],[51,"شهر نسْكٍ قرينُهُ يوم لَهْو","https://www.poetsgate.com/ViewPoem.aspx?id=30762",""]],"verses":[["شَنّوا الخِضابَ حِذاراً أَن يُطالِبَهُم","بِحِلمِهِ الشَيبُ أَو يُقصيهِمُ الغَزَلُ",0,"ل",1,0],["شُنّا بِيَ الغاراتِ كُلَّ لَيلَةٍ","وَعَوِّداني طَرَدَ الهَوامِلِ",1,"ل",1,0],["شَنَنتَ بِها الغاراتِ حَتّى تُرابُها","يَثورُ عَلى العاداتِ مِن غَيرِ حافِرِ",2,"ر",1,0],["شَنَنتَ عَلَيهِ الحَقَّ حَتّى رَدَدتَهُ","صَموتاً وَفي أَنيابِهِ القَولُ راقِدُ",3,"د",1,0],["شنّوا على الأعْداءِ غاراتِهمْ","تَتْرى كوَلْغِ الأذْؤُبِ العَواسِلِ",4,"ل",1,0],["شَنِئتُ مِنَ الصُحبان مَن لَستُ زائِلاً","أُعالِجُ مِنهُ عَوجَةً لا أُقَيمُها",5,"م",3,0],["شَنِئتُ مِنَ الصُحبان مَن لَستُ زائِلاً","أُدامِلُهُ دَملَ السِقاءِ المُخرَّقِ",6,"ق",1,0],["شُنِقوا وَلَو مُنِحوا الخِيارَ لَأَهَّلوا","بِلَظى سِياطِ الجالِدينَ وَرَحَّبوا",7,"ب",3,0],["شنتمري تفتل بديها","والهم جيها من كل جيها",8,"ه",2,0],["شنقوكم ليلاً على غير مهل","ثمّ دسّوا جسومكم في الرموس",9,"س",1,0],["شنقوكم لأنكم قد جعلتم","علّم الجيش غير ما منكوس",9,"س",1,0],["شنقوكم لأنكم قد أبيتم","أن تكونوا في ربقة الأنكليس",9,"س",1,0],["شَنِئَتْهم حُثالةٌ من أناس","أيقنوا أن مُخَّهم منكوتٌ",10,"ت",1,0],["شنعاءُ في الآذان تُق","لق كلَّ روحٍ في جسدْ",11,"د",1,0],["شنعاء تُضْرم فيك نار شناعةٍ","تبقى نوائرُها وأنت رمادُ",12,"د",1,0],["شننتُ عليه حلةً ليس عيبها","سوى أنها ظلت تطول ويقصر",13,"ر",1,0],["شُنطفُ يا عُوذَة السمواتِ وال","أرض وشمسَ النهار والقمرِ",14,"ر",1,1],["شنطُف يا سوءَ ما مُنِيت به","ما كُنتِ إلا فريسةَ القدر",14,"ر",1,0],["شنعاءَ لو جُلِّل النهارُ بها","بُدِّل من ضوئه بإغطاش",15,"ش",1,0],["شنوفٌ من صنوفِ العِلْ","مِ بالآذانِ متصلَهْ",16,"ل",2,0],["شَنَّ هذا على الجلود من الما","ءِ وهذا حَماه من شاربيه",17,"ي",2,0],["شنَّ فيه على الجلود بروداً","فأباخَ الحَروَر عن صائميه",17,"ي",2,0],["شَنَّفَ السامِعينَ دُرُّ كَلامي","وَتَحَلَّت أَجيادُهُم أَطواقي",18,"ي",1,0],["شنؤوا العروبة مدعين ولاءها","ما بالولي مخادع ظلام",19,"م",1,0],["شَنَنتَ بِها الغاراتِ حَتّى تَرَكتَها","وَجَفنُ الَّذي خَلفَ الفَرَنجَةَ ساهِدُ",20,"د",1,0],["شَنَنتَ عَلى نَهرِ اليَهودِيِّ غارَةً","هَوى خُرَّمِيّوها وَطاحَ يَهودُها",21,"د",3,0],["شَنِئتُ الصَبا أَن قيلَ وَجَّهنَ نَحوَها","وَعادَيتُ مِن بَينِ الرِياحِ قَبولَها",22,"ل",3,0],["شَنعاءُ جادِعَةُ الأُنوفِ مُذِلَّةٌ","كانَت لَهُ نَزَلَت بِكُلِّ غَرامِ",23,"م",1,0],["شنّفه الحسن بلا شنوف","وذنب كالنون في الحروف",24,"ف",1,0],["شنَّا على الآدابِ أقبحَ غارةٍ","جَرحَتْ قلوبَ محاسنِ الآدابِ",25,"ب",1,0],["شَنَنتَ عَلى الأَعداءِ غارَةَ عَزمَةٍ","فَبادَت وَلَمّا يُغنِها النَبلُ وَالبَطشُ",26,"ش",1,0],["شَنعاءُ بَينَ المَركَبِ الهِملاجِ قَد","كَمَنَت وَبَينَ الطَيلَسانِ المُطبَقِ",27,"ق",1,0],["شَنِئتُ بِمُجتَلاها النورَ حَتّى","شَنِئتُ بِمُجتَلى النورِ القَضيبا",28,"ب",2,0],["شَنِجُ النَسا أَدفى الجَناحِ كَأَنَّهُ","في الدارِ بَعدَ الظاعِنينَ مُقَيَّدُ",29,"د",1,0],["شَنِئتُ العَقرَ عَقرَ بَني شَليلٍ","إِذا هَبَّت لِقارِإِها الرِياحُ",30,"ح",1,1],["شَنونٌ أَبوهُ أَخلَدِيٌّ وَأُمُّهُ","مِنَ الحُقبِ فَحّاشٌ عَلى العِرسِ باسِلُ",31,"ل",1,0],["شَنَّعَ الظَنُّ عَلَينا عِندَكُم","إِنَّما كَذَّبَهُ الحُسنُ لَنا",32,"ن",2,0],["شُنعُ الأَسامي مُسبِلي أُزُرٍ","حُمرٍ تَمَسُّ الأَرضَ بِالهُدُبِ",33,"ب",1,0],["شَنّعَ المُرْجِفونَ عنكَ بِهَجري","وأشاعُوا أنّي سَلَوْتُ هَواكا",34,"ك",2,0],["شَنَنَّا عليهم كلَّ جَرْداءَ شَطْبَةٍ","لَجُوجٍ تُبارِي كُلَّ أَجْرَدَ شَرْجَبِ",35,"ب",1,0],["شَنُّوا بِهَا غَارَةً أَلْقَتْ بِرَوْعَتِهَا","أَمْناً يُؤَلِّفُ بَيْنَ الذِّئْبِ وَالْحَمَلِ",36,"ل",1,0],["شَنَّهَا غارَةً عَلَيَّ وَلَكِنْ","بَاءَ بِالْحَدِّ وَالقَصَاصِ الشَّدِيدِ",37,"د",1,0],["شُنعاً شواردَ كالسها","م جِبارُها لا تَدرُس",38,"س",1,0],["شُنُّوا عليهم كلَّ يومٍ غارةً","في كل وادٍ، في المدائِن، في القُرى",39,"ر",2,0],["شَنُونٌ أَبُوهُ الأَخْدَرِيُّ وأمُّهُ","من الحقب فحّاشٌ على العرس باسل",40,"ل",1,0],["شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","إذَا هَبَّتْ لِقَارِيهَا الرِّيَاحُ",41,"ح",1,1],["شَنِئْتُ الصَّبَا إذْ قيلَ وَجّهنَ نَحْوَها،","وَعادَيْتُ مِنْ بَينِ الرّياحِ قَبُولَهَا",42,"ل",3,0],["شنَّ فيه على الجواد بروداً","فأباخَ الحَرورَ عن صائميه",43,"ي",2,0]]}