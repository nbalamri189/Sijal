 تنادى اليوم بالخفوف","https://www.aldiwan.net/poem51349.html","الرجز"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[66,"شمول إلى نيرانها أبدا نعشو","https://www.aldiwan.net/poem38489.html","الطويل"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[74,"أرقت على الصبا لطلوع نجم","https://www.aldiwan.net/poem12871.html","الوافر"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[13,"شنئت العقر عقر بني شليل","https://www.aldiwan.net/poem2189.html","الوافر"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[52,"قليعقوب فديناك بنا","https://www.aldiwan.net/poem26644.html","الرمل"],[48,"من غائب في الحب لم يؤب","https://www.aldiwan.net/poem62414.html","البسيط"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54798","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[22,"أرى العير تحدى بين قنٍّ وضارجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19793",""],[13,"شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180790",""],[45,"قِفَا في مَغاني الدّارِ نَسألْ طُلُولَها","https://www.poetsgate.com/ViewPoem.aspx?id=32118",""],[51,"شهر نسْكٍ قرينُهُ يوم لَهْو","https://www.poetsgate.com/ViewPoem.aspx?id=30762",""],[115,"لم تذكري الذكرى فاطيب عيشة","https://www.aldiwan.net/poem40411.html","عموديه"],[115,"لمع الصباح برونق السعد","https://www.aldiwan.net/poem41172.html","عموديه"],[142,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[143,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[150,"شربت كؤوس الحب صرفا وليس لي","https://www.aldiwan.net/poem68564.html","الطويل"],[164,"ديار الحي بالرس","https://www.aldiwan.net/poem67584.html","الهزج"],[166,"غر الأعادي منه رونق بشره","https://www.aldiwan.net/poem47097.html","الكامل"],[185,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[207,"أصابت العام رعلا غول قومهم","https://www.aldiwan.net/poem27887.html","البسيط"],[210,"يا بريقاً بالحمى قد لمعا","https://www.aldiwan.net/poem13314.html","الرمل"],[250,"لي من الشمس خدمة صفراء","https://www.aldiwan.net/poem14922.html","الخفيف"],[250,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[259,"أنجد المتهم في غزلان طي","https://www.aldiwan.net/poem35802.html","الرمل"],[259,"شنف السمع مطربا بالسماع","https://www.aldiwan.net/poem35817.html","الخفيف"],[297,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[367,"عجب خولة إذ تنكرني","https://www.aldiwan.net/poem4615.html","الرمل"],[402,"لا تكثر فدتك نفسي عتابي","https://www.aldiwan.net/poem46957.html","الخفيف"],[403,"أهلا بها بنت فكر طال مسراها","https://www.aldiwan.net/poem33360.html","البسيط"],[458,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[458,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[458,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[458,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[461,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[475,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[477,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[490,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[514,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[546,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[567,"صرت يا عامل البريد مقيتا","https://www.aldiwan.net/poem69800.html","الخفيف"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[575,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"]],"verses":[["شَنّوا الخِضابَ حِذاراً أَن يُطالِبَهُم","بِحِلمِهِ الشَيبُ أَو يُقصيهِمُ الغَزَلُ",0,"ل",1,0],["شُنّا بِيَ الغاراتِ كُلَّ لَيلَةٍ","وَعَوِّداني طَرَدَ الهَوامِلِ",1,"ل",1,0],["شَنَنتَ بِها الغاراتِ حَتّى تُرابُها","يَثورُ عَلى العاداتِ مِن غَيرِ حافِرِ",2,"ر",1,0],["شَنَنتَ عَلَيهِ الحَقَّ حَتّى رَدَدتَهُ","صَموتاً وَفي أَنيابِهِ القَولُ راقِدُ",3,"د",1,0],["شنّوا على الأعْداءِ غاراتِهمْ","تَتْرى كوَلْغِ الأذْؤُبِ العَواسِلِ",4,"ل",1,0],["شَنِئتُ مِنَ الصُحبان مَن لَستُ زائِلاً","أُعالِجُ مِنهُ عَوجَةً لا أُقَيمُها",5,"م",3,0],["شَنِئتُ مِنَ الصُحبان مَن لَستُ زائِلاً","أُدامِلُهُ دَملَ السِقاءِ المُخرَّقِ",6,"ق",1,0],["شُنِقوا وَلَو مُنِحوا الخِيارَ لَأَهَّلوا","بِلَظى سِياطِ الجالِدينَ وَرَحَّبوا",7,"ب",3,0],["شنتمري تفتل بديها","والهم جيها من كل جيها",8,"ه",2,0],["شنقوكم ليلاً على غير مهل","ثمّ دسّوا جسومكم في الرموس",9,"س",1,0],["شنقوكم لأنكم قد جعلتم","علّم الجيش غير ما منكوس",9,"س",1,0],["شنقوكم لأنكم قد أبيتم","أن تكونوا في ربقة الأنكليس",9,"س",1,0],["شَنِئَتْهم حُثالةٌ من أناس","أيقنوا أن مُخَّهم منكوتٌ",10,"ت",1,0],["شنعاءُ في الآذان تُق","لق كلَّ روحٍ في جسدْ",11,"د",1,0],["شنعاء تُضْرم فيك نار شناعةٍ","تبقى نوائرُها وأنت رمادُ",12,"د",1,0],["شننتُ عليه حلةً ليس عيبها","سوى أنها ظلت تطول ويقصر",13,"ر",1,0],["شُنطفُ يا عُوذَة السمواتِ وال","أرض وشمسَ النهار والقمرِ",14,"ر",1,1],["شنطُف يا سوءَ ما مُنِيت به","ما كُنتِ إلا فريسةَ القدر",14,"ر",1,0],["شنعاءَ لو جُلِّل النهارُ بها","بُدِّل من ضوئه بإغطاش",15,"ش",1,0],["شنوفٌ من صنوفِ العِلْ","مِ بالآذانِ متصلَهْ",16,"ل",2,0],["شَنَّ هذا على الجلود من الما","ءِ وهذا حَماه من شاربيه",17,"ي",2,0],["شنَّ فيه على الجلود بروداً","فأباخَ الحَروَر عن صائميه",17,"ي",2,0],["شَنَّفَ السامِعينَ دُرُّ كَلامي","وَتَحَلَّت أَجيادُهُم أَطواقي",18,"ي",1,0],["شنؤوا العروبة مدعين ولاءها","ما بالولي مخادع ظلام",19,"م",1,0],["شَنَنتَ بِها الغاراتِ حَتّى تَرَكتَها","وَجَفنُ الَّذي خَلفَ الفَرَنجَةَ ساهِدُ",20,"د",1,0],["شَنَنتَ عَلى نَهرِ اليَهودِيِّ غارَةً","هَوى خُرَّمِيّوها وَطاحَ يَهودُها",21,"د",3,0],["شَنِئتُ الصَبا أَن قيلَ وَجَّهنَ نَحوَها","وَعادَيتُ مِن بَينِ الرِياحِ قَبولَها",22,"ل",3,0],["شَنعاءُ جادِعَةُ الأُنوفِ مُذِلَّةٌ","كانَت لَهُ نَزَلَت بِكُلِّ غَرامِ",23,"م",1,0],["شنّفه الحسن بلا شنوف","وذنب كالنون في الحروف",24,"ف",1,0],["شنَّا على الآدابِ أقبحَ غارةٍ","جَرحَتْ قلوبَ محاسنِ الآدابِ",25,"ب",1,0],["شَنَنتَ عَلى الأَعداءِ غارَةَ عَزمَةٍ","فَبادَت وَلَمّا يُغنِها النَبلُ وَالبَطشُ",26,"ش",1,0],["شَنعاءُ بَينَ المَركَبِ الهِملاجِ قَد","كَمَنَت وَبَينَ الطَيلَسانِ المُطبَقِ",27,"ق",1,0],["شَنِئتُ بِمُجتَلاها النورَ حَتّى","شَنِئتُ بِمُجتَلى النورِ القَضيبا",28,"ب",2,0],["شَنِجُ النَسا أَدفى الجَناحِ كَأَنَّهُ","في الدارِ بَعدَ الظاعِنينَ مُقَيَّدُ",29,"د",1,0],["شَنِئتُ العَقرَ عَقرَ بَني شَليلٍ","إِذا هَبَّت لِقارِإِها الرِياحُ",30,"ح",1,1],["شَنونٌ أَبوهُ أَخلَدِيٌّ وَأُمُّهُ","مِنَ الحُقبِ فَحّاشٌ عَلى العِرسِ باسِلُ",31,"ل",1,0],["شَنَّعَ الظَنُّ عَلَينا عِندَكُم","إِنَّما كَذَّبَهُ الحُسنُ لَنا",32,"ن",2,0],["شُنعُ الأَسامي مُسبِلي أُزُرٍ","حُمرٍ تَمَسُّ الأَرضَ بِالهُدُبِ",33,"ب",1,0],["شَنّعَ المُرْجِفونَ عنكَ بِهَجري","وأشاعُوا أنّي سَلَوْتُ هَواكا",34,"ك",2,0],["شَنَنَّا عليهم كلَّ جَرْداءَ شَطْبَةٍ","لَجُوجٍ تُبارِي كُلَّ أَجْرَدَ شَرْجَبِ",35,"ب",1,0],["شَنُّوا بِهَا غَارَةً أَلْقَتْ بِرَوْعَتِهَا","أَمْناً يُؤَلِّفُ بَيْنَ الذِّئْبِ وَالْحَمَلِ",36,"ل",1,0],["شَنَّهَا غارَةً عَلَيَّ وَلَكِنْ","بَاءَ بِالْحَدِّ وَالقَصَاصِ الشَّدِيدِ",37,"د",1,0],["شُنعاً شواردَ كالسها","م جِبارُها لا تَدرُس",38,"س",1,0],["شُنُّوا عليهم كلَّ يومٍ غارةً","في كل وادٍ، في المدائِن، في القُرى",39,"ر",2,0],["شَنُونٌ أَبُوهُ الأَخْدَرِيُّ وأمُّهُ","من الحقب فحّاشٌ على العرس باسل",40,"ل",1,0],["شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","إذَا هَبَّتْ لِقَارِيهَا الرِّيَاحُ",41,"ح",1,1],["شَنِئْتُ الصَّبَا إذْ قيلَ وَجّهنَ نَحْوَها،","وَعادَيْتُ مِنْ بَينِ الرّياحِ قَبُولَهَا",42,"ل",3,0],["شنَّ فيه على الجواد بروداً","فأباخَ الحَرورَ عن صائميه",43,"ي",2,0],["شنوا علي من التأفف غارة","وبعذلهم جعلوا نهاري داجيا",44,"ي",2,0],["شنف بذكر الحي اسماعنا","وصف لنا حدائق الورد",45,"د",1,0],["شنَّ غاراتِه على عازبِ السؤ","ددِ ما يقترِحْ يحوز ويَسبي",46,"ب",2,0],["شَنَنتَ عَلَيهِمُ شَعواءَ أَبقَت","لِكُلٍّ مِنهُمُ قَلباً خَفوقا",47,"ق",2,0],["شَنئتُ حَياتي والحياةُ لَذيذةٌ","إذا غابَ مَن نهوى فلا خَيرَ في العَيشِ",48,"ش",1,0],["شَنَيتُ الكَلِمَ المَدخو","لَ وَالشِعرَ إِذا اِستَغلَق",49,"ق",1,0],["شنَّ النهابَ على قوافلِ ماله","بأنامل كمغيرةِ الأكراد",50,"د",1,0],["شُنوف عقيقٍ صِيغَ من سبج لها","مَعاليقُ ما باشَرْن فيها مَعاقدا",51,"د",2,0],["شَنعاءُ جُلِّلَ مِن سَوآتِها حَضَنٌ","وَسالَ ذو شَوغَرٍ مِنها وَسُلوَانُ",52,"ن",1,0],["شنع العاذل عني سلوة","كذب العاذل فيما شنعا",53,"ع",2,0],["شنَعَّ الناسُ أنني جاهليٌّ","ما نوى وما لهم أهواءُ",54,"ا",2,0],["شَنَقوا قلعَهَا مراراً على الريح","ولا شكَّ أنه مظلومُ",55,"م",1,0],["شنّعوا تلك الأراجيف الّتي","لججاً خاضوا بها في بحر غي",56,"ي",1,0],["شنّف السمع مطرباً بالسماعِ","فالهوى يسترقّ حرّ الطباعِ",57,"ع",1,1],["شنَّفتَ سَمعي بنظم قافيةٍ","لَو باهَت الدرَّ أَرخَصت قيمَه",58,"م",2,0],["شنّها لاعج الحنين إلى مج","د قديم مضيّعٍ مفقود",59,"د",1,0],["شُندُفٌ أَشدَفُ ما وَرَّعتَهُ","فَإِذا طُؤطِئَ طَيّارٌ طِمِرّْ",60,"ر",1,0],["شنِّفِ السَّمعَ لي بذكْر عليٍّ","خير مَاشٍ يسيرُ فوق التُراب",61,"ب",1,0],["شنف بها كل سمع ولتكن حذراً","من أن تعربد سكراً من حمياها",62,"ا",3,0],["شنَّ مغيراً على القلوب فما","ينهض ثِقلاً منها بما علِما",63,"م",2,0],["شُنَّت عليك مغيرةٌ لا تُقتضَى","ذَحلا ولا يودى لها مقتولُ",64,"ل",1,0],["شنَّتْ على الكناس حتى لم تدع","للريم إلاّ حَمَشاً أو خَنَسا",65,"س",2,0],["شنعاءَ لو طَرَقَ الخَيالُ بمثلها","عيني لما أطبقتُ مقلةَ راقدِ",66,"د",1,0],["شنعاءُ مُخْلِفةٌ النجومِ جَنوبُها","مطْرودةٌ عن جوِّها بالشَّمْألِ",67,"ل",1,0],["شَنَقتُ بِها مَعابِلَ مُرهَفاتٍ","مُسالاتِ الأَغِرَّةِ كَالقِراطِ",68,"ط",1,0],["شِنْشنَةٌ صارتْ له مذهباً","وهو لها دونَ الورى أخزَمُ",69,"م",1,0],["شَنَّ مِن أَودٍ عَلَيكُم شَنَّةً","إِنَّهُ يَحمي حِماها وَيَغارُ",70,"ر",1,0],["شنّوا الإغارَ على نهبِ الجِمالِ وإذْ","فيهِم أتَتْ وهَبوها كلّما نهَبوا",71,"ب",3,0],["شَنَّ عليها بماءٍ باردٍ","شَنٌّ مَنُوطٌ بأَخْرابِ هَزِيمْ",72,"م",1,0],["شَنَنْتُمُ بغضاءكمْ فينا وكمْ","شَنّ اِمرؤٌ في قومِهِ ما لم يُشَنْ",73,"ن",1,0],["شَنِئَتْكَ النفوسُ وانحرفَتْ عن","كَ قلوبٌ وكنتَ تَسْبي القُلوبا",74,"ب",2,0],["شَنُّوا عليْه وما سقو","ه قطرةً من ماءِ شَنِّ",75,"ن",1,0],["شِنْشِنةٌ تُعْرَفُ من يُوسُفٍ","في الحَرْبِ لا تُعْرَفُ من أَخْزَم",76,"م",1,0],["شَنَنْتَ بها الغاراتِ حتى نباتِها","وأَعْشَابَها مِنْ حُمرَةِ الدَّمِ عَنْدمُ",77,"م",1,0]]}