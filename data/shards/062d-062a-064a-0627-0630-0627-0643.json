عره","https://www.aldiwan.net/poem57863.html","الكامل"],[327,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[406,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[541,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[563,"يا من به تتكون الأكوان","https://www.aldiwan.net/poem33779.html","الكامل"],[563,"هي هذه الحركات والسكنات","https://www.aldiwan.net/poem34703.html","الكامل"],[566,"قد أملت أمنية من الأمل","https://www.aldiwan.net/poem27841.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126877","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88600","الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96361","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96690","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17082","الكامل"],[1152,"","https://poetry.dctabudhabi.ae/diwan/poem/73867","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1373,"","https://poetry.dctabudhabi.ae/diwan/poem/198927","البسيط"],[1521,"","https://poetry.dctabudhabi.ae/diwan/poem/20767","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77986","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108689","الكامل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124297","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114751","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53107","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53064","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108387",""],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88567","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125831","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93739","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[4859,"أنين القهر","https://www.poetsgate.com/ViewPoem.aspx?id=186799",""],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[470,"المنعطف","https://www.poetsgate.com/ViewPoem.aspx?id=18589",""],[5818,"الكسير","https://www.poetsgate.com/ViewPoem.aspx?id=196494",""],[147,"بكَ اقتضى الدينُ ديناً كانَ قدْ وجبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27445&r=&rc=12",""]],"verses":[["حَتَّى إِذَا كَمُلَتْ فِيهِ الْقُوَى وَسَما","فَضْلاً وَرَاعَ أُسُودَ الْغَابِ فِي الأَجَمِ",0,"م",1,0],["حتّى إذا كادَت سِماتُ طَريقِهِمْ","تَخْفَى بكُلِّ مُمَوِّهٍ ومُداجِي",1,"ج",2,0],["حَتّى إِذا كُنَّ مَحجوزاً بِنافِذَةٍ","وَزاهِقاً وَكِلا رَوقَيهِ مُختَضِبُ",2,"ب",1,0],["حتى إذا كفر الصَّنيعةَ وازدرى","بحقوقها ألحقته بالنارِ",3,"ر",1,0],["حتى إذا كنت للنواب مجتمَعاً","بانت عواقب ذاك السعي خسرانا",4,"ن",2,0],["حتى إذا كفَّ عن غاراته فَلَهُ","شعرٌ يئنُّ مُقاسيه من الوَصَبِ",5,"ب",1,0],["حَتّى إِذا كادَ ضَوءُ الصُبحِ يَفضَحُهُ","وَكادَ عَنهُ سَوادُ اللَيلِ يَنطَلِقُ",6,"ق",1,0],["حتَّى إِذا كِدْنا نُرَشِّفَ","خَمْرَها غَضِبَ المَنُونْ",7,"ن",1,0],["حَتّى إِذا كادَت مَصابيحُ الهُدى","تَخبو وَكادَ مُمَرُّهُ يُتَقَضَّبُ",8,"ب",1,0],["حَتّى إِذاكُسِرَ الحَليجُ وَقُسِّمَت","أَمواهُ لُجَّتِه عَلى الخُلجانِ",9,"ن",1,0],["حَتّى إِذا كانَ ذَنبٌ","فَتَحتُ لِلعُذرِ بابا",10,"ب",2,0],["حَتَّى إِذَا كَمَلَ الْعَتَادُ تَقَاذَفُوا","بِالنَّارِ ذَاتِ البَرْقِ وَالإرْعَادِ",11,"د",1,0],["حَتّى إِذَا كَشَفَتْ لَهُ عَمَّا بِهَا","لَمْ يُرْضِهِ فَخْرٌ تَبَطَّنَ عَابا",12,"ب",2,0],["حتى اذا كبرا تولى شرح ما","لم يفهما قلبهما الخفقان",13,"ن",1,0],["حتى إذا كملت فيه الورى وسما","خطلا وراع أسود الغاب في الأجم",14,"م",1,0],["حتى إذا كادت سماة طريقهم","تخفى بكل مموه ومداج",15,"ج",1,0],["حتى إذا كشَّفتُ عن غَدَراته","قالوا تقلَّبَ ناقداً ومقرِّظا",16,"ظ",2,0],["حتّى إذا كادَتْ مَصَابيحُ الهُدَى","تَخْبُو، وَى كَادَ مَمَرُّهُ يَتَقَضّبُ",17,"ب",1,0],["حتى إذا كر السنين","جلا غشاوات العيون",18,"ن",1,0],["حَتّى إِذا كَذَبَت فيهِم ظُنونُهُمُ","فاؤوا إِلَيكَ بِظَنٍّ جانَبَ الكَذِبا",19,"ب",2,0],["حَتَّى إِذَا كَانَتِ الْبَيْضَاءُمِنْ كَثَبٍ","عَادَ الْحَنِينُ إِلىَ الحَمْرَاءِ وَالدَّاعِي",20,"ع",2,0],["حتى إذا كان بعد شهرٍ","دل على موضعي أنيني",21,"ن",2,0],["حَتّى إِذا كانَ يَومُ النَفر نفَّرَهُ","وَجدٌ ينكِّتُ في الأَحشاءِ تَنكيتا",22,"ت",2,0],["حَتّى إِذا كَرَبَت وَاللَيلُ يَطلُبُها","أَيدي الرِكابِ مِنَ اللَغباءِ تَنحَدِرُ",23,"ر",1,0],["حتى إذا كشف القناع وزارني","تحت الدجا بطل القياس بفرقه",24,"ه",1,0],["حَتّى إِذا كانَ مِن أَفواهِها كَثَباً","وَما طَلَتهُ ضِراءٌ كُلُّها حَنِسُ",25,"س",1,0],["حتى إذا كتب الإله قضاءهُ","فارقتنا فتعذَّرتْ لُقيانا",26,"ن",2,0],["حتَّى إذا كانَ لا يصغي إلى حكم","حكمتما الصارم الهندي بينكما",27,"م",2,0],["حتَّى إِذا كَمُلَتْ لها آلاتُها","من عُدَّةٍ تجري بها أَو عِدّةِ",28,"ه",1,0],["حتى إذا كشف الزمان ستارها","برح الخفاء فلم يعد موهوما",29,"م",2,0],["حَتّى إِذا كانوا مِنَ التِئامِ","كَخَرزٍ جُمِعنَ في نِظامِ",30,"م",1,0],["حتى إذا كشف القناع وأشرقت","تلك الحقيقة والعيان عيان",31,"ن",1,0],["حتى إذا كهلت رأيت كهولها","تحيى وصبيان الحمى أموات",32,"ت",1,0],["حَتّى إِذا كانَ بِفُرقانِ النُصُل","رَأوا قَداميسَ خَميسٍ ذِي سَبَل",33,"ل",1,0],["حتى إذا كان من القلب وصل","إلى قلوب السامعين واتصل",34,"ل",1,0],["حتّى إذا كضّه حرّ الظماء أتى","يريدُ ماءً بقلبٍ لاهب سخنِ",35,"ن",1,0],["حتىّ إِذا كف الصباح لطمت","وَجه الدجي ومزقت أَطماره",36,"ر",2,0],["حتى إذا كانت النيرانُ بينَهُمُ","للحَرب يُوقدونَ لا يُوَقدنَ للزّادِ",37,"د",1,0],["حتّى إِذا كشرَ الصباحُ بمبسمٍ","فيما لَدَينا لَم يَكُن موموقا",38,"ق",2,0],["حَتّى إِذا كَشَفَ الصَباحُ قِناعَهُ","قَرَأَت لِيَ الذُبانِ بِالأَلحانِ",39,"ن",1,0],["حَتَّى إِذا كانَ بَعدَ حينٍ","أَلجَمَهُ الدَّهرُ بِالعِذارِ",40,"ر",1,0],["حتى إذا كادت تريح على الحمى","وسمت بغرة قاطنيه سعودا",41,"د",2,0],["حَتّى إِذا كُنا عَلى رَمل الحمى","وَقَد خَبطنا جَوف لَيل مظلما",42,"م",2,0],["حَتَّى إِذا كادَ يَموت جوعا","وَهَجر القَرار وَالهُجوعا",43,"ع",2,0],["حتى إذا كاد أن يوفى على شجن","ساوى لها بين سلوان ومجلود",44,"د",1,0],["حتى إذا كثر التحاولُ بينهم","فَصَلَ الأمور الحارث بن هشامِ",45,"م",1,0],["حتى إذا كملت لتسعة أشهر","أجزاؤه أخرجته متناكسا",46,"س",2,0],["حتى إذا كادت تحل بساحتي","ويحل منها في اليدين نضار",47,"ر",1,0],["حتّى إذا كملت له اشتاق اللقا","ودعاه ربّ منعم متودد",48,"د",1,0],["حتّى إذا كنتُم من ال","قَبرِ المُبارَكِ قِيدَ ميل",49,"ل",1,0],["حتى إذا كأس الحميّا آنست","من خلقه ما كان منه منفرا",50,"ر",2,0],["حتى إذا كُومُ المطايا أصبحت","مثل الحنايا في أكف صَحَاصِح",51,"ح",1,0],["حتى اذا كادت تحسُّ جلوسنا","ينظر الى المرآة طرفي الشيق",52,"ق",1,0],["حتى إذا كان قسمُ اللؤم قال لكم","خلّوا إلى حظكم في غابر الأُمم",53,"م",1,0],["حتى إذا كفروا به","مستهزئين بما يريد",54,"د",1,0],["حتّى إذا كبت الثريا واِنبرى","ببنات نعش منسم الجوزاء",55,"ا",2,0],["حتَّى إذا كوكبُ الأَسحارِ لاح لها","في شهرِ تشرينَ أضحتْ ذاتَ أَسحار",56,"ر",1,0],["حَتّى إِذا كادَت ثَنَت صَولَتَهُ","عَزيمَةٌ مِنهُ وَجدٌّ لَم يَزَلْ",57,"ل",1,0],["حتى إذاكبرتْ بلوايَ واستعرت","وخانني الصبرُ والتصبيرُ أرهقني",58,"ن",2,0],["حتى اذا كادت الدنيا ترد على","الاعقاب أبداك فانجابت بنا الريب",59,"ب",1,0],["حتى اذا كان في عينيك بعض رضا","عني ، فعن كلهم الاك انصرف",60,"ف",1,0],["حتّى إذا كبر الصغيرْ","وتحوّل المغلوب غالبْ",61,"ب",1,0],["حَتّى إِذَا كَذَبَتْ فِيهِمْ ظُنُونُهُمُ","فَاؤُا إِلَيْكَ بِظَنٍّ جَانَبَ کلْكَذِبا",62,"ب",2,0]]}