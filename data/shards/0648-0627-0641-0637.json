{"poems":[[119,"أرأيت يا حلول الشمائل","https://www.aldiwan.net/poem40609.html","عموديه"],[119,"منذ الذي يغريك يا ريم الغضا","https://www.aldiwan.net/poem40917.html","عموديه"],[119,"فرطت لا تنحرف عن منهج الادب","https://www.aldiwan.net/poem41217.html","عموديه"],[190,"أطالب بالتنفل في السجود","https://www.aldiwan.net/poem43906.html","الوافر"],[240,"أبو علي قد تجافاني","https://www.aldiwan.net/poem31638.html","السريع"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[358,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119895","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108567","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132247","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109678","الرمل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216564",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102934","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111469","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[5461,"كلٍ يعوّد لاصل جدّه ومرباه","https://www.poetsgate.com/ViewPoem.aspx?id=5307",""]],"verses":[["وافطن فلله البقا","ء وغيره فان وزائل",0,"ل",1,0],["وافطن فذي الدنيا خيال ما بها","امد تطول حبالها الا انقضى",1,"ض",2,0],["وافطن فانى امروء من سادة شرفت","احسابهم وعلوا بالفضل والنسب",2,"ب",1,0],["وأفطر بالعشا إفطار سوء","على ماء كمضروب المزيد",3,"د",1,0],["وَاِفطِر وَعَيِّد مَع تَوانيكَ في","إِنفاذِ رَسمي أَلفَ نيسانِ",4,"ن",1,0],["وَاِفطِر وَعَيِّد وَاِسلَم لِنُصرَةِ مَظ","لومٍ ضَعيفٍ وَجَبرِ مُهتَضَمِ",5,"م",1,0],["وَأَفطر قُلوب الحاسِدين فَإِنَّها","تَكادُ إِذا ما عاينتك تفطَّرُ",6,"ر",1,0],["وافطر وعِيد وابق في نعم","كبد الحسود لها ستفطر",7,"ر",1,0],["وأَفْطروا وعيَّدوا","فابقَ لهم وفي الدُّنى",8,"ن",2,0],["وافطر وفطر قلوب الحاسدين بمر","آك الوسيم وزد أشباحهم كلحا",9,"ح",2,0],["وأفطرتم فيه ليزداد حظوة","فصار لكل منهما الفضل والذخر",10,"ر",1,0],["وافطم النفس عن الشر تجد","كلَّ خير ترتجيه تبعك",11,"ك",1,0],["وافطن ترى للإذن عِذَّال","لَهجٍ ولا لِهْ مِهتِوينا",12,"ن",2,0],["وافطن لادوية الأمور فإنما","سم الأفاعي غير سم العقرب",13,"ب",1,0],["وأَفطُومِذُونٌ مُمسِكٌ وَهوَ خازِلٌ","وَيَنظِمُ في تِلكً السَّفافِيدِ ما خَزَل",14,"ل",1,0],["وأفطميذ الخيل في الحال شد","وألقميذٌ ببهي العدد",15,"د",1,0],["وافطن ترى زول الرّجاجيل توّاه","كم واحدٍ يعجبك زوله وهو دون",16,"ن",1,0]]}