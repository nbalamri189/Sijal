{"poems":[[57,"قالت مرضت فعدتها فتبرمت","https://www.aldiwan.net/poem26418.html","الكامل"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[469,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131369","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34631","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77117","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44730","الكامل"],[4689,"يا أيها الصيف الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=190631",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[5736,"قنوط","https://www.poetsgate.com/ViewPoem.aspx?id=208402",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""]],"verses":[["فَجَحَدتُهُم ليَكونَ غَيرَكِ ظَنُّهُم","إِنّي لَيُعجِبُني المُحِبُّ الجاحِدُ",0,"د",1,0],["فَجَحشٌ عَلى أَدبارِهِنَّ مُخَلَّفٌ","وَجَحشٌ لَدى مِكَرِّهِنَّ وَقيصُ",1,"ص",1,0],["فَجَحَدْتَهُمْ جحداً جعل","تَ قبيحَ قَرْفِكَهُمْ قِطابهْ",2,"ب",2,0],["فجحودها بجفونها","وبخدِّها إقرارها",3,"ر",3,0],["فَجَحَدتَ أوصَافَ الكَمَالِ مَخَافَةً التَّ","جسِيمِ والتَّشبِيهِ بالإِنسانِ",4,"ن",1,0],["فجحتي وصحابي غير داحضة","من نص بهرام والتوضيح والكاف",5,"ف",1,1],["فجحدت ربي فضل نعمته","وعبدته أبداً على حرفِ",6,"ف",1,0],["فَجَحَدتُهُ طوراً بِزُعمِكَ ضاعَ في","مِصرَ وَشام أَو مَنازِلَ قَيصَرا",7,"ر",2,0],["فَجَحيمُ دُنيانا إِذا","هَبَت رِياحُ الشَرِّ تلهبْ",8,"ب",1,0],["فجحيم شوقك للثرى أهذى به","وسقاه من قبلات نارك سيلا",9,"ل",2,0],["فَجُحرٌ آوَى فَلَّا طَرِيداً","يَكُونُ لِذى ثَوْرةٍ مُفْتَرَشْ !!",10,"ش",1,0],["فجحدتُ فضلك إذ عُميت بصيرةََ","ومضيت في درب التلاهي أغتني",11,"ن",2,0],["فجحفلُ الشوقِ في الأحشاءِ أسيفُهُ","ومَوقِدُ الحُبِّ في قلبي مشاعِلُهُ",12,"ل",2,0]]}