ry.dctabudhabi.ae/diwan/poem/85481","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85490","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85768","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140839",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140861",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20989","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42715","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141965","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10389","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116946","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54239","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"تحية فريال","https://www.poetsgate.com/ViewPoem.aspx?id=179501",""],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[77,"نفحت فشبت لافح التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=34093",""],[100,"من ذا هنا","https://www.poetsgate.com/ViewPoem.aspx?id=50178",""],[98,"أيها العصر","https://www.poetsgate.com/ViewPoem.aspx?id=55344",""],[98,"عودوا إلى تلك القرى","https://www.poetsgate.com/ViewPoem.aspx?id=55335",""],[98,"سلمى الكورانية","https://www.poetsgate.com/ViewPoem.aspx?id=53904",""],[58,"إنّما الدُّنيا كَظِلٍّ زائلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22728",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[45,"حَاشَاكِ مِنْ ذِكَرٍ ثَنَتْهُ كَئِيبَا","https://www.poetsgate.com/ViewPoem.aspx?id=31694",""],[45,"طَفِقَتْ تَلومُ وَلاتَ حينَ مَلامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=185700",""],[45,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[45,"أَما لِعيْنيْ طَلِيحِ الشُّوقِ تَغْمِيضُ","https://www.poetsgate.com/ViewPoem.aspx?id=31135",""],[39,"لِمَنْ دِيَارٌ بهذا الجِزْعِ مِنْ رَبَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=4232",""],[31,"إنّي أَتَتْنَي شَكْوَى لا أُسَرُّ بِها،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19066&r=&rc=329",""]],"verses":[["أَو كَالوُفودِ رَأوا سِماطَ خَليفَةٍ","فَرَموا عَلى الأَعناقِ بِالأَذقانِ",0,"ن",1,0],["أَو كَماوِيَّةِ الصَناعِ عَلاها","صَدَأُ اللَونِ بَعدَ طولِ صِيانِ",1,"ن",1,0],["أَو كَالشُجاعِ تَمَطّى بَعدَ هَجعَتِهِ","يُرخي لِساناً كَغَربِ اللَهذَمِ الخَذِمِ",2,"م",1,0],["أَو كانَ يَأنَسُ بِالأَنيسِ أَوابِدٌ","يَوماً لَزَمَّ لِيَ النِعامُ النافِرُ",3,"ر",1,0],["أَو كانَ ما قَدَّمتُ مِن مِقَةٍ","سَبَباً إِلى البَغضاءِ لَم يَزِدِ",4,"د",1,0],["أَو كانَ جِلدٌ يُستَعارُ إِذاً","يَومَ الطِعانِ لِعِرتُكُم جِلدي",5,"ي",1,0],["أوْ كانَ لي في نِعَمِ اللهِ منْ","تَحَكُّمٍ حُطّتْ جَميعاً لَدَيْكْ",6,"ك",1,0],["أَو كُنْتُ أَرْخَصْتُ فِي التَّرْجِيحِ مُجْتَهداً","لَمْ يَقْبَلِ الْوَرَعُ الْفُتيَى مَعَ الرُّخَصِ",7,"ص",1,0],["أوْ كانَ يمنَعُ منع قضاءِ اللهِ ما","خلَصَتْ إلَيْهِ نوافِذُ الأقْدارِ",8,"ر",1,0],["أو كانَ في قَنْصِ بْنِ مَعْدٍ ثاوِيّاً","دَهَمَ العَفا رَبيعةَ بْنَ نِزارِ",9,"ر",1,0],["أو كانَ في يومِ الصّريمِ لَما غَدا","حَكَمُ ابْنُ زِنْباعٍ رهينَ إسارِ",9,"ر",1,0],["أَو كَما قالوا سَقيمٌ فَلَئِن","نَفَضَ الأَسقامَ عَنهُ وَاِستَصَح",10,"ح",1,0],["أَو كَالبِناءِ يُريدُ أَن","يَنقَضَّ مِن وَقعِ الخَوَر",11,"ر",1,0],["أَوَ كُلَّما أَرسَلتُ مَرثِيَةً","مِن أَدمُعي في إِثرِ مُرتَحِلِ",12,"ل",1,0],["أَوَ كُلَّما هَزَّ الرَجاءُ مُهَنَّداً","بَدَرَت إِلَيهِ غَوائِلُ الأَقدارِ",13,"ر",1,0],["أَو كَاللَعوبِ مِنَ الحَما","ئِمِ فَوقَ مَلعَبِهِ اِستَطار",14,"ر",1,0],["أَوَ كُلَّما قالوا تَجَمَّعَ شَملُهُم","لَعِبَ الشِقاقُ بِجَمعِنا فَتَفَرَّقا",15,"ق",2,0],["أَوَ كُلَّما باحَ الحَزينُ بِأَنَّةٍ","أَمسَت إِلى مَعنى التَعَصُّبِ تُنسَبُ",16,"ب",1,0],["أَو كَشَرخِ الشَبابِ لَم يَدرِ كاسي","هِ تَوَلّى في يَقظَةٍ أَو مَنامِ",17,"م",1,0],["أَو كانَ في ظَبيِ الحِمى مُغرَماً","أَما لِهَذا الظَبيِ مِن مَرتَعِ",18,"ع",1,0],["أَو كانَ شَقُّ الجَيبِ يُنقذُ مِن رَدىً","شَقَّت عَلَيكَ بَنو أَبيكَ الأَكبُدا",19,"د",2,0],["أَو كانَ يُغني عَنكَ دَفعٌ بِالقَنا ال","خَطيِّ غادَرَتِ الوَشيجَ مُقَصّدا",19,"د",2,0],["أَوْ كُنْتَ تَمْلِكُ وَثْباً مِن نَوىً لَرَأَوْا","مِنْ ذَلِكَ اللَّيْثِ مَا لا تَحْمَدُ النَّعَمُ",20,"م",1,0],["أَوْ كَاتِبٍ كَالنِّيلِ فِي فَيضَانِهِ","أَوْ خَاطِبٍ كَالزَّاخِرِ المُتَلاطِمِ",21,"م",1,0],["أَوْ كُنتُ أَشْهَدُ لَهْوَهُنَّ وَهَلْ يُرَى","غَيْرُ العَفَافِ مَلاهِيَ الآرَامِ",22,"م",1,0],["أَو كَاِبنِ مَسعَدَةَ الكَريمِ نِجارُهُ","بَيتِ الكِتابَةِ في بَني العَبّاسِ",23,"س",1,0],["أو كنتُ أبلغ من قبولك مأملي","لم أودع الشكوى صَباً وقَبُولا",24,"ل",2,0],["أو كان هذا لا يدوم فإن ذا","ليدوم ما دامت تكرّ عصور",25,"ر",1,0],["أو كان في الناس انصاف ومرحمة","لم تشك أرملة ضنكاً بدنياها",26,"ا",3,0],["أَو كُنتُ أَرهَبُ وَشكَ بَينٍ عاجِلٍ","لَقَنَعتُ أَو لَسَأَلتُ ما لَم يُسأَلِ",27,"ل",1,0],["أَو كُنتَ تُفدى لَاِفتَدَتكَ سَراتُنا","بِنَفائِسِ الأَرواحِ وَالأَموالِ",28,"ل",1,0],["أَو كانَ يُدفَعُ عَنكَ بَأسٌ أَقبَلَت","شَرعاً تَكَدَّسُ بِالقَنا العَسّالِ",28,"ل",1,0],["أَو كُلِّ أَروَعَ ماجِدٍ ذي مِرَّةٍ","أَو كُلِّ مُستَرخي النَجادِ مُدَجَّجِ",29,"ج",1,0],["أَو كُنتَ مِن زُهرَةَ الأَبطالِ قَد عَلِموا","أَو مِن بَني خَلَفِ الزُهرِ الأَماجيدِ",30,"د",1,0],["أو كلموا بمواضيهم وألسنهم","فإنهم أهل إبلاغ وإفصاح",31,"ح",1,0],["أَو كانَت العَينُ مُذ فارَقَتكُم نَظَرَت","شَيئاً سِواكُم فَخانَتها أَمانيها",32,"ي",3,0],["أَو كانَت النَفسُ تَدعوني إِلى سَكَنٍ","سِواكَ فَاِحتَكَمَت فيها أَعاديها",32,"ي",3,0],["أو كدُخانِ النفط في مُطْبِقٍ","من يُمسِ من سُكَّانه يُنْدَبِ",33,"ب",1,0],["أو كنتُ قدْ أخطأتُ في لفظةٍ","فأنت يا مَوْلايَ رَبُّ السَّمَاحْ",34,"ح",1,0],["أو كنت تبتاعُ الثنا","ءَ لكان جُودُك جودَ مَتْجَرْ",35,"ر",1,0],["أو كنت قد قلت ما لا أستحق به","منكم ثواباً فرُدّوه وما سارا",36,"ر",2,0],["أو كنت كابن سُريجٍ في تقادُمه","أو الغريض ففيهم منتهى العبر",37,"ر",1,0],["أو كُدِّرَ البدءُ ثم أعْقبه","صفوٌ ففي ذاك وجه معتذَر",38,"ر",1,0],["أو كالذي فسدت قَعيدةُ بيته","فأحالَ يضرب ظهر طيرٍ أبتر",39,"ر",1,0],["أو كُسُوها فأساءوا لُبْسَها","بالتَّعرِّي من سرابيل الورع",40,"ع",1,0],["أو كما انقضَّ كوكبٌ أو كما طا","رت من البرق شقَّةٌ في غمامِ",41,"م",1,0],["أو كان لا يعشق إلا التي","تهواه ما كان الهوى محنهْ",42,"ن",2,0],["أو كل ما لم يستطع فعله","عيسى ولا موسى بن عمرانا",43,"ن",2,0],["أو كما شال ناقصٌ الوزنِ في المي","زانِ وانحطَّ عنه ذو رجحان",44,"ن",1,0],["أَو كَالعَسيبِ نَماهُ جَدوَلٌ غَدِقٌ","وَكَنَّهُ وَهَجَ القَيظِ الأَظاليلُ",45,"ل",1,0],["أَو كَالكِلابِ عَلى الهَراسِ يَطَأنَهُ","أَو مَشيَهُنَّ يَطَأنَ شَوكَ سَيالِ",46,"ل",1,0],["أَو كَمِثلِ الجَنينِ ماتَت بِهِ الحا","مِلُ حَيّاً يَجولُ في الأَحشاءِ",47,"ا",2,0],["أَو كُلَّما نَصَرَ الحَقيقَةَ فاضِلٌ","قامَت عَلَيهِ قِيامَةُ السُفَهاءِ",48,"ا",2,0],["أَو كانَ يَمدَحُ بِالسَوادِ","فَمَن تُرى مَدَحَ الغُراب",49,"ب",1,0],["أَو كانَ فارَقَهُ الصُدا","حُ فَلَم يُفارِقهُ الوَقار",50,"ر",1,0],["أَو كَلباً يَعدو أَو حَمَلا","يَرعى أَو نَهراً أَو هَضَبَه",51,"ه",1,0],["أَو كُلَّما جاءَ الزَمانُ بِمُصلِحٍ","في أَهلِهِ قالوا طَغى وَتَزَندَقا",52,"ق",2,0],["أَو كُنتَ تُشفِقُ مِن حُلولِ مَصيبَةٍ","هَيهاتِ يَمنَعُ أَن تَحِلَّ تَجَهُّمُ",53,"م",1,0],["أَو كُنتَ جاوَزتَ الشَبابَ فَلا تَقُل","شاخَ الزَمانُ فَإِنَّهُ لا يَهرَمُ",53,"م",1,0],["أَو كَفُلكٍ في البَحرِ أَوفى عَلَيها","عارِضٌ بَعدَ عارِضٍ هَتّانِ",54,"ن",1,0],["أَو كُنتُ في النيرانبِ حَيثُ لَدَيهُمُ","مِنها النَجاةُ رَضيطُ بِالنيرانِ",55,"ن",1,0],["أَو كُلَّما طَلَعَت عَلَيهِم أَزمَةٌ","هاجوا ضَغائِنَكُم عَلى الصُلبانِ",56,"ن",1,0],["أَو كَالغَزالَةِ وَهيَ تَنقَضُّ تِبرَجا","عِندَ المَغيبِ عَلى ذُرى حَرَمونِ",57,"ن",1,0],["أَو كَالمُسافِرِ في قَفرٍ عَلى ظَمَإٍ","أَضنى المَسيرُ مَطاياهُ وَأَضناهُ",58,"ا",2,0],["أَو كَالسَفينَةِ في الضَبابِ طَريقَها","ضَلَّت وَغابَت أَنجُمٌ تَهديها",59,"ي",3,0],["أَو كانَ في الأَرضِ أَزهارٌ لَها أَرَجٌ","لَو كانَتِ الأَرضُ لا تُبدي أَقاحيها",60,"ي",3,0],["أَو كانَ عِزٌّ دائِماً ما أَصبَحَت","بَغدادُ في عَدَدِ الطُلولِ البالِيَه",61,"ي",2,0],["أَو كَالأَزاهِرِ حَبَستَهُ لَكِن مَتى","يَعُدِ الرَبيعُ إِلى الإِنشادِ",62,"د",1,0],["أَو كانَ قَصدُكَ في الهَوى","قَتلي يُطيلُ اللَهُ عُمرَك",63,"ك",1,0],["أَو كنتَ ترقُبُني فهاتِ","السَّهمَ أَرشُقُهُ بنَحْرِي",64,"ي",1,0],["او كسيف مجرد للتقاضي","من قراع الاحداث فيه فلول",65,"ل",1,0],["او كان من داء به يصدى فقد","يرد الخضم ولا يبل اواما",66,"م",2,0],["أو كنت غصت فقد","غاصت مثلك السلحفاة",67,"ه",1,0],["أو كامنية بدت غبّ يأس","أو كوعد قد سر بعد وعيد",68,"د",1,0],["أو كلما بسط الكرام أكفهم","بالجود أنهارا بسطتَ الكوثرا",69,"ر",2,0],["أو كنت يوشع تجرى الشمس طوع يدى","طمعت منكم غداة البين في المهل",70,"ل",1,0],["أو كنت عيسى أعيد الميت سيرته","أعدت للسقم جسما مات بالعلل",70,"ل",1,0],["أو كنت موسى يخط اليم لي سبلا","حملتكم في عيون سمحة السبل",70,"ل",1,0],["أو كأبي اللطف الذي","أمنَّه الله العطب",71,"ب",1,0],["أو كأبي الإِشاد من","لسوء حظ قد خطب",71,"ب",1,0],["أو كان ينبت ف يالتراب محامد","نبت الثنا لك منه والإطراء",72,"ا",2,0],["أو كان مصريا فلِم","في الكيد أنجد ثم أتهم",73,"م",1,0],["أو كان عبد الاحتلا","ل فكيف ينصحنا ويرحم",73,"م",1,0],["أَو كانَت الدُنيا قُصارى هِمتك","فَبئس أَنتَ كَم دَمٍ بِذمتك",74,"ك",1,0],["أَوَ كُلَّما جادَت نَداكَ رَوِيَّتي","سَبَقَت ثَنايَ بِالارتِجالِ يَداكا",75,"ك",2,0],["أَو كانَ يُحمَلُ في الجَوارِحِ مَيِّتٌ","حَمَلوكَ في الأَسماعِ وَالأَجفانِ",76,"ن",1,0],["أَو كانَ لِلذِكرِ الحَكيمِ بَقِيَّةٌ","لَم تَأتِ بَعدُ رُثيتَ في القُرآنِ",76,"ن",1,0],["أَوَكُلُّ مَن حامى عَنِ الحَقِّ اِقتَنى","عِندَ السَوادِ ضَغائِناً وَذُحولا",77,"ل",2,0],["أَو كَاِبنِ عَفّانَ وَالقُرآنُ في يَدِهِ","يَحنو عَلَيهِ كَما تَحنو عَلى الفُطُمِ",78,"م",1,0],["أَو كانَ دونَ أَبي الرَضِيِّ أُبُوَّةً","فَلَقَد أَعادَ بَيانَ عَبدِ مَنافِ",79,"ف",1,0],["أَو كَسَجعِ الحَمامِ لَو فَصَّلَتهُ","وَتَأَنَّت بِهِ وَدَقَّ اِختِراعُه",80,"ع",2,0],["أَوَ كُلَّما سَمَحَ الزَمانُ وَبُشِّرَت","مِصرٌ بِفَردٍ في الرِجالِ مَنارِ",81,"ر",1,0],["أَوَ كُلُّ ما عِندَ الرِجا","لِ لَهُ الخَواطِبُ وَالمُهور",82,"ر",1,0],["أَو كَأَنَّ البُرجَ أَلقى حوتَهُ","فَتَرامى في السَماواتِ الفِساح",83,"ح",1,0],["أَو كانَ بَعثُكَ مِن دَبي","بِ الروحِ أَو نَبضِ الوَتين",84,"ن",1,0],["أَو كَخَيالٍ لَها","بَعدَ مَتابٍ أَلَم",85,"م",1,0],["أَو كَيفَ تَختَرِقُ الغُيوبَ بَهيمَةٌ","فيما يَنوبُ مِنَ الأُمورِ وَيَطرُقُ",86,"ق",1,0],["أَو كَمَغلوبٍ عَلى ذاكِرَةٍ","يَشتَكي مِن صِلَةِ الماضي اِنقِضابا",87,"ب",2,0],["أَو كَباقَةِ زَهرا","لِلعُيونِ تَأتَشِبُ",88,"ب",1,0],["أَو كَحوتٍ يَرتَمي المَوجُ بِهِ","سابِحٌ بَينَ ظُهورٍ وَخَفاء",89,"ا",2,0],["أَو كُنتُ بَعضَ الإِنكِليزَ قَبِلتُكُم","مَلِكاً أُقَطِّعُ كَفَّهُ تَقبيلا",90,"ل",2,0],["أَو كُنتُ عُضواً في الكُلوبِ مَلَأتُهُ","أَسَفاً لِفُرقَتِكُم بُكاً وَعَويلا",90,"ل",2,0],["أَو كُنتُ قِسّيساً يَهيمُ مُبَشِّراً","رَتَّلتُ آيَةَ مَدحِكُم تَرتيلا",90,"ل",2,0],["أَو كُنتُ صَرّافاً بِلُندُنَ دائِناً","أَعطَيتُكُم عَن طيبَةٍ تَحويلا",90,"ل",2,0],["أَو كُنتُ تَيمَسَكُم مَلَأتُ صَحائِفي","مَدحاً يُرَدَّدُ في الوَرى مَوصولا",90,"ل",2,0],["أَو كُنتُ في مِصرٍ نَزيلاً جاهِداً","سَبَّحتُ بِاِسمِكِ بُكرَةً وَأَصيلا",90,"ل",2,0],["أَو كُنتُ سِريوناً حَلَفتُ بِأَنَّكُم","أَنتُم حَوَيتُمُ بِالقَناةِ الجيلا",90,"ل",2,0],["أَو كَالنَسيمِ غَدا عَلَيكِ وَراحَ مِن","فوفِ الرِياضِ وَوَشيِها المَحبوكِ",91,"ك",1,0],["أَو كَالأَصيلِ جَرى عَلَيكِ عَقيقُهُ","أَو سالَ مِن عِقيانِهِ شاطيكِ",91,"ك",1,0],["أَو كانَ يَجزيكَ الرَدى عَن صُحبَةٍ","وَهوَ القَديمُ وَفاؤُهُ لِصِحابِهِ",92,"ب",2,0],["أَوْ كُنْتَ وافَقْتَهُ يَوْماً على نَسَبٍ","فاقْبِضْ يَدَيْكَ فإنِّي لَسْتُ بالعَرَبِيْ",93,"ي",1,0],["أَو كانَ صادَفَ رَأسَ عازَرَ سَيفُهُ","في يَومِ مَعرَكَةٍ لَأَعيا عيسى",94,"س",2,0],["أَو كانَ لُجُّ البَحرِ مِثلَ يَمينِهِ","ما اِنشَقَّ حَتّى جازَ فيهِ موسى",94,"س",2,0],["أَو كانَ لِلنيرانِ ضَوءُ جَبينِهِ","عُبِدَت فَصارَ العالَمونَ مَجوسا",94,"س",2,0],["أو كان ضوؤُكَ للغزالةِ لمْ","يحجُبْ ضياءَ جبينها الطَفَلُ",95,"ل",1,0],["أو كَنهودٍ ظَهَرَتْ","من تحت لاذٍ أحمَرِ",96,"ر",1,0],["أَو كَشِّفِ الظَلماءَ بِال","نورِ المُضيءِ مِنِ اِنجِلائِك",97,"ك",1,0],["أَو كَالبُرودِ تُخُيِّرَت لِمُتَوَّجٍ","مِن خالِهِ أَو وَشيِهِ أَو عَصبِهِ",98,"ب",2,0],["أَو كَالسِماكِ إِذا تَدَلّى رُمحُهُ","كانَت لَهُ الكَفُّ الخَضيبُ رَقيبا",99,"ب",2,0],["أَو كَالخَريفِ مَضى وَأَصبَحَ بَعدَهُ","وَشيُ الرَبيعِ عَلى النَجادِ قَشيبا",99,"ب",2,0],["أَو كَالسَحابِ إِذا اِنقَضى شُؤبوبُهُ","أَنشى يُؤَلِّفُ بَعدَهُ شُؤَبوبا",99,"ب",2,0],["أَو كَالحُسامِ أُعيرَ حَدّاهُ الرَدى","إِن كَلَّ هَذا كانَ ذاكَ قَضوبا",99,"ب",2,0],["أَو كانَ في كَرَمِ السَماحَةِ واحِداً","فَلَأَنتَ في كَرَمِ العِنايَةِ واحِدُ",100,"د",1,0],["أَو كَأَنّي أَحوكُ حَوكَ زِيادِ","أَو كَأَنّي أَبي دُؤادِ الإِيادي",101,"ي",1,0],["أَو كَوَردِ الرِياضِ أَو كَجَنّاتِ ال","كاعِبِ الرودِ أَو كَوَشيِ البُرودِ",102,"د",1,0],["أَو كَالغُرابِ غَدا يُباري صَحبَهُ","بَسَوادِ بُقبَتِهِ وَحُسنِ قَوامِهِ",103,"م",2,0],["أَو كُنتَ ناقِلَ عِزّي عَن أَرومَتِهِ","فَاِنقُل ثَبيراً بِما جَمَّعتَ مِن سَبَدِ",104,"د",1,0],["أَو كُلِّ دايِرَةٍ كَأَنَّ بِها","قاراً وَلَيسَ سَفينُها يَجري",105,"ر",2,0],["أَو كُلِّ صادِقَةٍ إِذا طُلِبَت","مِن دونِها الريحُ الَّتي تُذري",105,"ر",2,0],["أَو كَاِبنِ عَجلانَ إِذ كانَت لَهُ تَلَفاً","هِندُ الهُنودِ بِمِقدارٍ وَآجالِ",106,"ل",1,0],["أو كالعَرانينِ هذا حَظُّهُ خَنَسٌ","مُزْرٍ عليه وهذا حظُّه شَمَمُ",107,"م",1,0],["او كالغَمامِ الجَونِ إن بعثَ الحَيا","احيا وإن بعثَ الصَّواعِقَ أضرَما",108,"م",2,0],["أو كالحُسام إذا تبسَّمَ مَتنُه","عَبَسَ الرَّدى في حَدِّهِ فتجهَّما",108,"م",2,0],["أو كالتِّلاعِ الحُوِّ آنسَ نَورُها","إِيماضُ طَلٍّ للسَّحابِ وَوابلِ",109,"ل",1,0],["أو كالرَّبيعِ يُريكَ أخضَرَ يانِعاً","ومورِّداً شَرِقاً وأصفرَ فاقِعا",110,"ع",2,0],["أو كالحُسامِ إذا مضَى في مَشهَدٍ","شَهِدَتْ مَضارِبُه بعُتْقِ نِجارِه",111,"ر",2,0],["أو كالرَّبيعِ الطَّلْقِ واجهَ قَطْرُه","وجهَ الثَّرى فاخضرَّ من أقطارِه",111,"ر",2,0],["أو كالحُسامِ جَلا الصيَّاقلُ مَتْنَهُ","حتى ترقَرقَ منه ماءُ الجَوهَرِ",112,"ر",1,0],["أَو كانَ يُعطي النَصفَ قُلتُ لَهُ","أَحرَزتَ قِسمِكَ فَاِلهُ عَن قِسمي",113,"م",2,0],["أَو كانَ يَقعُدُ فَوقَ الشَمسِ مِن كَرَمٍ","قَومٌ بِأَوَّلِهِم أَو مَجدِهِم قَعَدوا",114,"د",3,0],["أَو كانَ تَحتَ طِباقِ السَبعِ مَطلَبُها","كَسَهَّلِ اللَهِ في المَرقى مَراقيها",115,"ي",3,0],["أَو كَطيفٍ قَد يَراهُ نائِمٌ","اَو كَبَرقٍ لاحَ في أُفْقِ الأَمَل",116,"ل",1,0],["أَو كُوثِروا كَثُروا أَو صُوبِروا صَبروا","أَو سوهِموا سَهَموا أَو سُولِبوا سَلَبوا",117,"ب",3,0],["أَو كُنتَ مِن زُبَرِ الحَدي","دِ وَكُنتَ مِن صُمِّ الصُخورِ",118,"ر",1,0],["أَو كُنتَ مُعتَصِماً بِأَع","لى الريحِ أَو لُحَجِ البُحورِ",118,"ر",1,0],["أَوكُنتُمُ العامَ عَلى عُسرَةٍ","مِنهُ فَمَنّوهُ إِلى قابِلِ",119,"ل",1,0],["أَو كانَ قَسّاً في الفَصا","حَةِ قيلَ هَذا باقِلُ",120,"ل",1,0],["أَو كانَ طولُ لِسانِهِ بِيَمينِهِ","أَفنى الكُنوزَ وَأَنفَذَ الأَموالا",121,"ل",2,0],["أَو كانَ بِالجَوسِقِ النُعمانُ تاهَ فَكَم","مِن جَوسَقٍ لَكَ بِالشِعبَينِ مَعمورِ",122,"ر",1,0],["أو كل الحب في رأ","يك غفرانٌ وصفح",123,"ح",1,0],["أو كان فضْلُك ليس يُجحدَ حقُّه","فعليه مُتّفِقٌ ذوو الأديانِ",124,"ن",1,0],["أو كنْتَ مرهوبَ الأناةِ فكامنٌ","فيها وثوبُ الضيغم الغضبانِ",124,"ن",1,0],["أَوْ كُلّ لَمياءَ لو جادَتْ بِريقِ فمٍ","نَقَعتُ حَرّ غليلي منه في الخَصَرِ",125,"ر",1,0],["أو كلّ ثعبانٍ يُناطُ بقَسْوَرٍ","بين البنود كمُحْنَقٍ وغَضُوبِ",126,"ب",1,0],["أَو كُنتُ يَوماً بِالنُجومِ مُصَدِّقاً","لَزَعَمتُ أَنَّكَ أَنتَ بِكرُ عُطارِدِ",127,"د",1,0],["أو كالعشارِ التي غنَّتْ رواعدُها","مثلَ الحداةِ التي أصواتُها ذهبُ",128,"ب",1,0],["أَو كُنتُ أَحبَبتُ حُبّاً مِثلَ حُبِّكُمُ","فَلا أَقَلَّت إِذاً نَعلَب لِيَ القَدَما",129,"م",2,0],["أَو كانَ ذَلِكَ لِلبِعادِ فَإِنَّما","يَكفيكِ ضَربُكِ دونَنا الجِلبابا",130,"ب",2,0],["أَو كلّما جذب المقادةَ مُصعَبٌ","في الشّرق غُودِرَ أنفُهُ مخزوما",131,"م",2,0],["أوَ كُلَّما نزلت بمصرَ مُلمَّةٌ","هاجَ الغليلُ وفاضتِ العَبَراتُ",132,"ت",1,0],["أَوَ كلّما ذَهبتْ رِكابُكَ أو أَتتْ","رَجفَ الزّمانُ وضجّتِ الآفاقُ",133,"ق",1,0],["أَوَ كلّما نَبتَ الصّلاحُ بأرضِنا","نَبتتْ مَناجلُ للفسادِ حِدادُ",134,"د",1,0],["أَوَ كلّما نَصرَ الحقائقَ أهلُها","عَثُرَ الكَمِيُّ بِمُدَّعٍ مخذولِ",135,"ل",1,0],["أَو كُلَّما طارَت بِتاجٍ نَزوَةٌ","نَزَتِ السُيوفُ وَطارَتِ الأَجنادُ",136,"د",1,0],["أَو كلّما هاجَ التعصُّبَ أَهلُهُ","صاح الغَوِيُّ بِنا وضجَّ المُرجِفُ",137,"ف",1,0],["أَو كَالكَعابِ تَبَرَّجَت لِخَليلِها","في اللَيلِ وَاِرتَقَبَت لَهُ الإِلماما",138,"م",2,0],["أَو كَالخُدودِ بَدَت لَنا مُبيَضَّةً","فَاِرتَدَّ بِالخَجَلِ البَياضُ مُعصفَرا",139,"ر",2,0],["أو كإيمانهم رسوخاً وعمقاً","ثابت الأَصل في قرار الفؤادِ",140,"د",1,0],["أَو كَأَسبادِ النَصِيَّةِ لَم","تَجتَذِل في حاجِرٍ مُستَنام",141,"م",1,0],["أَو كَماءٍ ذي ثُبىً أَتأَقَت","غَرَباً أَيدي سُقاةِ الهِيام",141,"م",1,0],["أَو كَمَجلوحِ جِعثِنِ بَلَّةُ القَط","ر فَأَضحى مُوَدِّسَ الأَعراضِ",142,"ض",1,0],["أَو كانَ في غالِبٍ شِعرٌ فَيُشبِهَهُ","شِعرُ اِبنِهِ فَيَنالَ الشِعرَ مِن صَدَدِ",143,"د",1,0],["أَو كَالفَتى حاتِمٍ إِذا قالَ ما مَلَكَت","كُفّايَ لِلَناسِ نُهبى يَومَ ذي خَشَبِ",144,"ب",1,0],["أَو كَإِبنِ حِيَّةَ لَمّا طَرَّ شارِبُهُ","أَزمانَ يَملِكُ أَهلَ الريفِ وَالقَتَبِ",144,"ب",1,0],["أَو كَتَفسيرِ مُصحَفٍ مُفَسَّرِ","وَالشَمسُ في إِصحاءِ جَوٍّ أَخضَرِ",145,"ر",1,0],["أَوَ كُلَّ ما حَلِمَتْ به حَمَلَتْ به","مَنْ لِي بِأنَّ الناسَ غيرُ نيامِ",146,"م",1,0],["أو كِسْرَويّةُ مَحتدٍ وأرومةٍ","شَمطاءُ يُدعَى باسمِها دِهقانُها",147,"ن",3,0],["أو كان بشُرك في شعاع الشمس لم","يُكسَفْ لها عند الشُروقِ جَبِين",148,"ن",1,0],["أو كان سُخطُك عدوةً في السمّ لم","يَحْمِلْهُ دونَ لَهاتِهِ التَّنّين",148,"ن",1,0],["أو كنْتَ شاهِدَ لفْظِهِ في مُشْكِلٍ","لرَأيْتَ نَظْمَ الدُّرِّ كيْفَ يُفَصَّل",149,"ل",1,0],["أوَكُلّما جَنَحَ الأصيلُ تَنَفّسَتْ","نَفَساً تُجاذِبُهُ إليَّ عَليلا",150,"ل",2,0],["أو كنتَ نُوحاً مُنذِراً في قومِهِ","ما زادَهم بدُعائِهِ تَضليلا",150,"ل",2,0],["أو كان سُنبُكُهُ الدّقيقُ بكفّهَا","نَظَمَتْ قلائدَهَا بغيرِ سُلوك",151,"ك",1,0],["أو كان منكُمْ للرُّفاتِ مُخاطِبٌ","لَبَّوا وظنّوا أنّه إنشار",152,"ر",1,0],["أَو كَالصَنيعِ استُلَّ مِن قِرابِهِ","فَسَدَّدَ الطَرقَ وَما هاها بِهِ",153,"ب",2,0],["أَو كَراكٍ ذُعِرنَ مِن صَوتِ صَقرٍ","مُفزَعاتٍ شَواخِصَ الأَبصارِ",154,"ر",1,0],["أَو كانَ تَقصيرٌ عَذَر","أَو كانَ تَقصيرٌ عَذَر",155,"ر",1,0],["أَو كَالسَمَوأَلِ إِذ طافَ الهُمامُ بِهِ","في جَحفَلٍ لَجِبِ الأَصواتِ يَرتَجِسُ",156,"س",1,0],["أَو كانَ خِلواً لَيسَ يَد","ري ذا وَذَلِكَ فَاِنقَضى",157,"ض",2,0],["أَو كَعِرقِ السامِ يَنشَقُّ عَنهُ","شُعَبٌ مِثلَ اِنفِراجِ البَنانِ",158,"ن",1,0],["أو كنتُ للجنّةِ أحيا بها","فما عليكم يا بني الزانيه",159,"ن",3,0],["أو كنتَ من قوم عادٍ","في البأسِ أو بُخَتَنصَر",160,"ر",1,0],["أَو كَحَبِّ الزَرّاعِ وافَقَ أَرضاً","وَافَقَتهُ وَحائِراً مَفجورا",161,"ر",2,0],["أَو كانَ غَيَّرَهُ الزَما","نُ فَحُبُّكُم غَضٌّ جَديدُ",162,"د",1,0],["أَو كانَ جَلداً في الهَوى","فَأَنا الضَعيفُ لَهُ البَليدُ",162,"د",1,0],["أَو كَبَدرِ السَماءِ غَيرِ قَريبٍ","حينَ أَوفى وَالضَوءُ فيهِ اِقتِرابُ",163,"ب",1,0],["أَو كُنتَ نَفسي جُمِعَت في يَدي","أَلفَيتَني سَمحاً بِإِبقاءِ",164,"ا",2,0],["أَو كانَ كُلُّ بَني حَوّاءَ يُشبِهُني","فَبِئسَ ما وُلِدَت في الخَلقِ حَوّاءُ",165,"و",3,0],["أَو كَالمُعيرِ مِنَ العا","سِلاتِ يَطرُقُ زَربَه",166,"ب",2,0],["أَو كُنتُ كُدرِيّاً أَخا قَفرَةٍ","مَشرَبُهُ مِن آجِناتِ الوِقاب",167,"ب",1,0],["أَو كُنتُ رَأسَ الغولِ وَهوَ مُوَقَّرٌ","في الشُهبِ لَم آمَن تَهَجُّمَ غائِلِ",168,"ل",1,0],["أو كُنْتَ رَاخَيْتَ في العنانِ لَهُ","حَازَ العُلا واحْتَوى على الأَمدِ",169,"د",1,0],["أوْ كان مَنْ يرضى بخدّي موْطِئاً","لَوَضَعْتُهُ أرْضاً ولم أستنكِف",170,"ف",1,0],["أَو كانَ من قدم به","أَبلى من العظم الرَميم",171,"م",1,0],["أَو كنت في البحر تَرتَجيه","فاركب له غارب البحار",172,"ر",1,0],["أَو كالَّذين إذا تغي","يرت الظروف تغيروا",173,"ر",3,0],["أَو كالَّذين إذا تَجَم","هرت الرعاع تجمهروا",173,"ر",3,0],["أَو كالَّذين تذللوا","أَو كالَّذين تكبروا",173,"ر",3,0],["أَو كالمنافق جاء يظ","هرُ غير ما هو يضمر",173,"ر",1,0],["أَو كروح قد أتت","لك تروى خبرا",174,"ر",2,0],["أو كانَت الأخرى وتلك مظنتي","فعليك يا لَيلى عليك سلامي",175,"ي",1,0],["أَو كالسفين نشرن أش","رعة فهن بها جواري",176,"ي",1,0],["أو كان للنيران ضوء جبينه","عبدت فكان العالمون مجوسا",177,"س",2,0],["أو كان لا يسعى لجودٍ ماجدٌ","إلا كذا فالغيث أبخل من سعى",178,"ع",2,0],["أو كان كلَّمَ بُرجَها بلسانه","والقومُ شتّى ألسنٍ وحناجرِ",179,"ر",1,0],["أو كانت تلك روما أم سدوما","يومَ ذاقتْ بخطاياكَ الجحيما",180,"م",2,0],["أو كلِّ فادٍ بالحياة عشيرَهُ","لا القولِ في خُدَع الخيال السانِحِ",181,"ح",1,0],["أو كان يملك قدرةً حشَدَ الدُّجى","ونضا الرجومَ وجنَّد الأنواءَ",182,"ا",2,0],["أو كزياد خطبة إذا انبرى","والثقفي حين يرقى المنبرا",183,"ر",2,0],["أو كانَ مَفروقاً فذاكَ الأصْلمُ","كلاهُما للجُزءِ حقّاً صَيْلَمُ",184,"م",1,0],["أو كَمَاءِ المثمُودِ بعدَ جِمَامٍ","زَرِمِ الدَّمعِ لا يَؤُوبُ نَزُورا",185,"ر",2,0],["أَوْ كَالتُّرَابِ يَهِيلُ مِنْ عَقَدَاتِهِ","أَوْ كَالْهَوَاءِ يَجُولُ فِي آفَاقِهِ",186,"ق",2,0],["أَوْ كَانَ يَرْهَبُ صَوْلَةً مِنْ فَاتِكٍ","لَفَعَلْتُ فِعْلَ الْحَارِثِ بْنِ عُبَادِ",187,"د",1,0],["أَوْ كُلُّ بِكْرٍ تُجْتَلَى","قَسَمَاتُهَا فِي غَيْرِ ذَامِ",188,"م",1,0],["أو كصمصام بخديه الردى","كامن والغمد زاهي الخلل",189,"ل",1,0],["أو كنت مت لليلتي جهد","يا مهجتي خفف ولا تزد",190,"د",1,0],["أو كالحباحب، باخ لامعه،","يبدو من الوجنات في خدد",190,"د",1,0],["أو كسربٍ من الحمام نهيك","أثخَنتهُ يد النوى إرهاقا",191,"ق",2,0],["أَوْ كانَ لِلَّيْلِ أَنْ يَخْتَارَ حِلْيَتَهُ‏‏‏","وَقَدْ طَلَعْتِ عَلَيْهِ، لازْدَرى الشُّهُبَا‏‏‏",192,"ب",2,0],["أو كان منبت مصر غير منبته","أو كان شاعر مصر غير شاعره؟",193,"ر",2,0],["أو كصمصامة تكشف الأبطال عنها","ما بين أسرى وقتلى",194,"ل",2,0],["أو كقيثارة علاها غبار المجد غنت","عرس البطولة قبلا",194,"ل",2,0],["أَوْ كاهِنُ الأَزَلِ الحالي بِشَيْبَتِهِ","قَبَّالُ تَوْبَتِها ماحِي خَطاياها",195,"ا",3,0],["أَو كَالجَناحِ إِذا سُلَّت قَوادِمُهُ","صارَ الجَناحُ لِفَضلِ الريشِ يَتَّبِعُ",196,"ع",1,0],["أو كانَ يتعِبُ خيلهُ في باطل","فخيولُنا يومَ الصبيحَةِ تتعبُ",197,"ب",1,0],["أو كَالْحَيَاة تَدِبُّ في جِسْمِ امْرِىءٍ","أَفْنتْ شِكَايتُه فُنونَ إِسَائه",198,"ا",3,0],["أَوْ كَالصَّبَاحِ لمُدْلِجٍ خَبَطَ الدُّجَى","فَطَوَاهُ وادِي التِّيه في أَحْشَائه",198,"ا",3,0],["أَوْ كَالغَمَام رأَتْه أَزْهَارُ الرُّبَا","مِنْ بَعْدِ ما أَحْتَرقَتْ لطُولِ جَفَائه",198,"ا",3,0],["أَوْ كابْتِسَامِ السَّعْدِ بَعْدَ قُطُوبِه","أَوْ كانْقِيَادِ الدَّهْرِ بَعْدَ إِبَائه",198,"ا",3,0],["أوْ كُنْتُ أظْفرُ في الأخْرَى بِجَنَّتِها","غَسَلْتُ بالدمْعِ آثامي وأوْزاري",199,"ر",2,0],["أو كوَجْهِ الحَسْناءِ يَبْدُو ويَخفَى","بين مَيْل الهَوَى وخَوْفِ الوُشَاةِ",200,"ه",1,0],["أو كاليدِ البَيْضَاءِ تَنْضَح بالنَّدَى","والغيث أو جِيدِ العَذَارَى الغِيدِ",201,"د",1,0],["أَو كاقْتِبَالِ الْحُسنِ بعد تَحَجُّبٍ","أو كابتسام الدَّلِّ بعد صُدُودِ",201,"د",1,0],["أو كان عيبٌ في النظا","م ووضعه، فهو المعيب",202,"ب",1,0],["أو كَذُكَاءَ ساعة الدلوك","الشعب يُهدي آيةَ التبريك",203,"ك",1,0],["أو كلما كادت تَتِم فصولها","مُنيتْ بشيطان يزيح ستارها؟",204,"ر",3,0],["أو كحُسَام سُلَّ من قِراب","بيضاءَ مثلِ دِرَّة الحِلاَّب",205,"ب",1,0],["أو كان في قنص بن معد ثاوبا","دهم العفاء ربيعه بن نزار",206,"ر",1,0],["أو كان في يوم الضريم لما غدا","حكم بن زنباع رهين إسار",206,"ر",1,0],["أوكلت أمرها الطغاه كراع","نام واستودع الذئاب قطيعة",207,"ع",2,0],["أو كصمام بخديه الردى","كامن والغمد زاهي الخلل",208,"ل",1,0],["أو كانت الأخرى فوا حربا","البؤس والأرزاء والفتن",209,"ن",1,0],["أو كاهن الأزل الحالي بشيبه","قبال توبتها ماحي خطاياها",210,"ا",3,0],["أو كطيف يراه نائمٌ","أو كبرق لاح في أفق الأمل",211,"ل",1,0],["أو كساعٍ يَسعى لتجفيف ماءِ","النَهر إشفاقةً على الأسماك",212,"ك",1,0],["أو كالسماك إذا تدلى روحه","كانت له الكف الخضيب رقيباً",213,"ب",2,0],["أوْ كالسّحابِ، إذا انقضَى شُؤبُوبُهُ","أنْشَا يُؤَلّفُ بَعْدَهُ شؤبُوبَا",213,"ب",2,0],["أَو كالغُرَابِ غَدَا يُبَاري صَحْبَهُ","بِسَوَادِ نُقْبَتِهِ، وَحُسنِ قَوَامِهِ",214,"م",2,0],["أو كورد الرياض أو وجنات ال","كاعب الرود أو كوشي البرود",215,"د",1,0],["اَوْ كانَ يَكْفيكَ عِلمُ الشَّيءِ تجَهلُهُ","لَقدْ كَفاكَ من التَّصريحِ تَعرِيضُ",216,"ض",1,0],["أوْ كالفَتَى حِاتِمٍ إِذْ قَالَ: مَا مَلَكَتْ","كفّايَ للنّاسِ نهبَى يومَ ذي خشبِ",217,"ب",1,0],["أوْ كنتُ أحببتُ حباً مثلَ حبكمُ،","فلا أقلتْ إذاً نعلي ليَ القدما",218,"م",2,0]]}