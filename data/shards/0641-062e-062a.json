{"poems":[[435,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[469,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59106","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127946","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133306","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125873","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72475","البسيط"]],"verses":[["فختامها مسك كعرف ثناءكم","وبثغرها مدح لديك تميم",0,"م",1,0],["فَخَتَمْتَ طُولَ تَقَلُّبي بتَقَبُّلِي","وجزَيْتَ غُرَّ غرائِبِي برَغائِبِ",1,"ب",1,0],["فختَّام يرعى ساهر عهدَ راقدٍ","ويحفظ دان في الهوى ودُّ شاسع",2,"ع",1,0],["فَخِتَامِي بِمَدْحِكَ العَطرِ","مَبْدَأ الإفْتِتَاحْ",3,"ح",1,0],["فختام العدو يريك بغضا","وقلبك من وساسوه مراح",4,"ح",1,0],["فختم أن تراعيَ حق جسم","وروض فكرك العانى شويه",5,"ي",2,0],["فَخَتَمْتَهُمْ والأنبيا","خُتِمُوا بوالدِكَ الرسولِ",6,"ل",1,0],["فختام الرسل بي أول الورى","في حياتي ولدى محتضري",7,"ر",2,0],["فختمت في عقود الدرِّ","أنمل أيدي العقول العشر",8,"ر",1,1]]}