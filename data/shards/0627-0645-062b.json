{"poems":[[53,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[47,"زماني كله غضب وعتب","https://www.aldiwan.net/poem25372.html","الوافر"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"يا سيدا لم تزل فروع","https://www.aldiwan.net/poem65943.html","مخلع البسيط"],[51,"ترفع إلى النجم العلي مكانه","https://www.aldiwan.net/poem66002.html","الطويل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[51,"ألا أيها الموسوم باسم وكنية","https://www.aldiwan.net/poem66404.html","الطويل"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[85,"يا أقرب الناس من أمين","https://www.aldiwan.net/poem7785.html","مخلع البسيط"],[85,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[43,"أبا عبد الإله معاذ إني","https://www.aldiwan.net/poem10533.html","الوافر"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[80,"أمثلك مولى يبسط العبد بالعذر","https://www.aldiwan.net/poem31422.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"كأني لم أبثكما دخيلي","https://www.aldiwan.net/poem30009.html","الوافر"],[74,"يا جامعا بمساويه وطلعته","https://www.aldiwan.net/poem13238.html","البسيط"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[50,"أمثل بني مضر وائل","https://www.aldiwan.net/poem24578.html","المتقارب"],[46,"أمثالنا كان جمل قبلنا فمضوا","https://www.aldiwan.net/poem22386.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199474","المتقارب"],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[46,"أهلُ البسيطة، في هَمٍّ حياتُهُمُ،","https://www.poetsgate.com/ViewPoem.aspx?id=18328",""],[51,"يا سيداً لم تزلْ فروعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30287",""],[100,"الوجه السبئي وبزوغة الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67741&r=&rc=228",""],[142,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[160,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[160,"تدارك من زمانك ما افدتا","https://www.aldiwan.net/poem59135.html","الوافر"],[169,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[211,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[211,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[211,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[280,"سأشكر ما مننت به ومثلي","https://www.aldiwan.net/poem60758.html","الوافر"],[280,"ألا من مبلغ عني عليا","https://www.aldiwan.net/poem60781.html","الوافر"],[305,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[310,"حي المعاهد كانت قبل تحييني","https://www.aldiwan.net/poem59516.html","البسيط"],[320,"مرت بحارس بستان فقال لها","https://www.aldiwan.net/poem67107.html","البسيط"],[353,"صبرا وإلا فماذا ينفع الحزن","https://www.aldiwan.net/poem39757.html","البسيط"],[403,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[416,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[416,"وفظ غليظ القلب أيقنت أنه","https://www.aldiwan.net/poem54019.html","الطويل"],[439,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[449,"تذكر عهد ماضيه فحنا","https://www.aldiwan.net/poem1019.html",""],[458,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[503,"ألم تر أني في المعارك أشتر","https://www.aldiwan.net/poem21727.html","الطويل"],[513,"أيا زاعما أني له غاير خالص","https://www.aldiwan.net/poem67737.html","الطويل"],[513,"أمثل الذي ألقى يقاومه صبر","https://www.aldiwan.net/poem67754.html","الطويل"],[538,"أرى الشهد يجنيه لي الذل علقما","https://www.aldiwan.net/poem48245.html","عموديه"],[573,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[586,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"]],"verses":[["أَمِثلي يُستَضامُ وَما تَرى لي","إِذا عَرَضَ العَيانُ بَنيكَ مِثلا",0,"ل",2,0],["أمِثْلي ولا مِثْلَ لي في الوَرى","ولا لأُميَّةَ حاشا عُلاهْ",1,"ا",2,0],["أَمِثلِيَ غُفلٌ خامِلُ الذِكرِ ضائِعٌ","ضَياعَ الحُسامِ العَضبِ أَصدَأَهُ الغِمدُ",2,"د",1,0],["أَمِثلي تُقبِلُ الأَقوالُ فيهِ","وَمِثلُكَ يَستَمِرُّ عَلَيهِ كِذبُ",3,"ب",1,0],["أمثالَهُمْ فاعْممْ بمد","حكَ عَمَّهُمْ حُسْنُ الصحابهْ",4,"ب",2,0],["أمثلُ عمروٍ يَسُومُ مثلي","خسفاً وأيامُه تطولُ",5,"ل",1,0],["أمثلُ عمروٍ يُهين مثلي","عمداً ولا تُنتَضَى النُّصولُ",5,"ل",1,0],["أمثلُ الذي قد نلتَ يكبُر قدْرُه","لدى نفسك الكبرى التي ليس مثلُها",6,"ل",3,0],["أمِثْلُ شِعْريَ يُلوى حقُّه وله","عليك من خِيمك المحمودِ أعوان",7,"ن",1,0],["أمثلك بعد الحِلم والعِلم والنُّهَى","يَبَرُّ ويَجفُو للإقامةِ والظَّعْن",8,"ن",1,0],["أمثلُ سُخطك يدهوني فيَكرُبني","شيء سواه وإن مثقالَهُ وَزَنا",9,"ن",2,0],["أمِثل فكري أبا حسين","يموت في نضرة السنين",10,"ن",1,0],["أَمِثلُكَ ضائِقٌ بِالحَقِّ ذَرعاً","وَفي بُردَيكَ كانَ لَهُ حُماةُ",11,"ه",1,0],["أَمِثلي تَأخُذُ النَكَباتُ مِنهُ","وَيَجزَعُ مِن مُلاقاةِ الحِمامِ",12,"م",1,0],["أَمثالُ بَيضاتِ النَعامِ يَهُزُّها","لِلبُعدِ أَمثالُ النَعامِ الهُدَّجِ",13,"ج",1,0],["أَمِثلُكَ مولىً يَبسُطُ العبدَ بِالعذرِ","بِغَيرِ انقِباضٍ مِنكَ يَجْري إلى ذكرِ",14,"ر",1,1],["أُمَثّلُها في خاطري كلّ ساعةٍ","وأمْري لها قَطْرَ الدّموعِ السواكِبِ",15,"ب",1,0],["أَمِثلُكَ يُرتَجى لَولا تَنائي","أُموري وَاِلتِياثي في حَويلي",16,"ل",2,0],["أَمِثلُهُ جَسَداً في مِثلِهِ حَسَداً","لَقَد تَأَلَّفَ بَينَ النارِ وَالفَحمِ",17,"م",1,0],["أَمثالُهُنَّ الباكِيا","تُ المُعوِلاتِ مِنَ النَوائِح",18,"ح",1,0],["أَمثالُ عَلقَمَةَ بنِ هَو","ذَةَ كُلَّ غالِيَةٍ مَياسِر",19,"ر",1,0],["أُمَثّلُهُ في ناظِرٍ غَيرِ ناظِري","كأنّيَ فيما قد أرى منه حالم",20,"م",1,0],["أَمِثلُ بَني مُضَرٍ وائِلٌ","فَقَدتُكَ مِن فاخِرٍ ما أَجن",21,"ن",1,1],["أَمثالُنا كانَ جُملٌ قَبلَنا فَمَضوا","وَمِثلُ رُزءٍ وَجَدنا حِسَّهُ وَجَدوا",22,"د",3,1],["أم ثُرْتَ للحقِّ الطَّرِي","دِ وبالبطولة قد فُتِنْتْ",23,"ت",1,0],["أمثل في مسرح الزيف ألف رواية","وأهذي بألف حكاية",24,"ه",1,0],["أمثقِفَ القلم الذي آلى على","أن ليس ترجَحُ كفهُ استعباد",25,"د",1,0],["أَمثالُنا كان جُيْلٌ، قبلنا، فمضَوا","، ومثلُ رُزْءٍ وجدنا حِسّهُ، وجدوا",26,"د",3,0],["أمثلُ عمروٍ يَسُومُ مثلي","خسفاً وأيامُه فطولُ",27,"ل",1,0],["أمثل الربيع ، لبست المغيب","وأنضر من كلّ آت أتيت",28,"ت",1,0],["أمثالُها فوق الرؤوس وهذه","فوق الرزانةِ والحصانة توضعُ",29,"ع",1,0],["أمثلي ولحمي هواكم ومن دمي","يطيل على الإيام بينكم العتبا",30,"ب",2,0],["أمثلك يا علي وأنت فهماً","حسام لا تفل إذا سللتا",31,"ت",2,0],["أَمِثلُكَ يَرضى دارَ ذُلٍّ إِذا مَأى","بها نَأمُ الضَيّونِ طارَ أَبُو الشِبلِ",32,"ل",1,0],["أمثلك تسديه الحياة إلى فتى","مريد الهوى والشوق وعرِ الخلائق",33,"ق",1,0],["أمثلى يرى منكم عقوقاً لحبه","وشعري بعد الله للحسن يخلق",34,"ق",1,0],["أمثلى ينسى آه مما اجترحتُمُ","على الهائم الحيران فيحومة الورد",35,"د",1,0],["أمثلى يؤذى بالعقوق ولم يكن","له غير حفظ العهد في الحب من وكد",35,"د",1,0],["أَمِثْلُكَ مُنْعِماً يُجْزى بِشُكْرٍ","لَقَدْ أَلْقَتْ مَقالِدَها الأُمُورُ",36,"ر",1,0],["أَمِثْلُكَ مَنْ يَجُوزُ عَلَيْهِ هذا","بِخُبْثِ مِحالِهِ وَالتُّرَّهاتِ",37,"ت",1,0],["أَمثالُ يومِ الدين يوم نعيّه","أَم معجل راع الخداج نُتوجه",38,"ج",2,0],["أمثل الربع من شوق فألثمه","وكيف والفكر يدنيه ويقصيني",39,"ي",1,0],["أُمَثِّلُ هاتَينِ هَذا الرَوضُ يُثمِرُهُ","لا تَدَّعي الزَورَ كِلا بَل هُما ثَمَري",40,"ي",1,0],["أَمثالنا وَالأَعالي قَبلَنا نكبوا","فَما اِستَكانوا بِما لاقوا وَلا وَهَنوا",41,"ن",3,0],["أمثلك يرضى بارتكاب العظائم","ونهب الرعايا وانتهاك المحارم",42,"م",1,1],["أَمثلي يطوفُ الأرض شرقاً ومغرباً","على أرب يرضى من الكثر بالقلّ",43,"ل",1,0],["أمثل شهاب الدِّين لا يرتجى لها","وما انقَبَضَتْ منه اليدان على القبض",44,"ض",1,0],["أَمُثَبِّطِي عنكَ الزمانُ إِذَنْ فَلا","نَهَضَتْ إِلَى الظِّلِّ المبارَكِ لي قَدَمْ",45,"م",1,0],["أمثلك من تنسيه الليالي","محبّا كم بكى وجدا وأنا",46,"ن",2,0],["أمثل محمدٍ المصطفَى","إذا الحكم وُلِّيتُموه لبيبا",47,"ب",2,0],["أمِثلِي يُنَادَى فِي القِتََالِ جَهَالَةً","لَقِيتَ حِمَامَ المَوتِ وَالمَوتُ أَحمَرُ",48,"ر",1,0],["أمثلي يخون العهد عن غير حادثٍ","رماني إذاً ربي بحتفٍ مغافص",49,"ص",1,0],["أمثل الذي ألقى يقاومه صبر","فأصبر أم مثلي ينهنهه الزجر",50,"ر",1,1],["أمِثلي وسِلكُ الشَّيبِ ضَاء بِعَارِضِي","وما تَمَّ غيرُ النائباتِ لَه وقدُ",51,"د",1,0],["أَمَثَّلُهُ في خاطِري فَيَفوتُني","وَبِالقَلبِ مِن عَرفانِهِ التيهُ وَالزَهوُ",52,"و",1,0],["أُمَثِّلُ ما أَخْتَارُ مِنْكَ بِخاطِري","فَيَمْنَحُنِي وَصْلاً وَإِنْ كُنْتَ لا تَدْرِي",53,"ر",2,0]]}