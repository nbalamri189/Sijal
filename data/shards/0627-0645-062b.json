صة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5956,"حسبي ذكاؤك سابراً لحقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=193504",""],[5956,"هل حاتم الطيىء نحو الأرض قد عادا؟","https://www.poetsgate.com/ViewPoem.aspx?id=194010",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[6024,"زجر الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=186348",""],[6093,"نسيمٌ خادع (الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=188632",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""],[6102,"عودة اضطرارية","https://www.poetsgate.com/ViewPoem.aspx?id=184458",""],[6102,"قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=184624",""],[6102,"هاتِف","https://www.poetsgate.com/ViewPoem.aspx?id=185295",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""]],"verses":[["أَمِثلي يُستَضامُ وَما تَرى لي","إِذا عَرَضَ العَيانُ بَنيكَ مِثلا",0,"ل",2,0],["أمِثْلي ولا مِثْلَ لي في الوَرى","ولا لأُميَّةَ حاشا عُلاهْ",1,"ا",2,0],["أَمِثلِيَ غُفلٌ خامِلُ الذِكرِ ضائِعٌ","ضَياعَ الحُسامِ العَضبِ أَصدَأَهُ الغِمدُ",2,"د",1,0],["أَمِثلي تُقبِلُ الأَقوالُ فيهِ","وَمِثلُكَ يَستَمِرُّ عَلَيهِ كِذبُ",3,"ب",1,0],["أمثالَهُمْ فاعْممْ بمد","حكَ عَمَّهُمْ حُسْنُ الصحابهْ",4,"ب",2,0],["أمثلُ عمروٍ يَسُومُ مثلي","خسفاً وأيامُه تطولُ",5,"ل",1,0],["أمثلُ عمروٍ يُهين مثلي","عمداً ولا تُنتَضَى النُّصولُ",5,"ل",1,0],["أمثلُ الذي قد نلتَ يكبُر قدْرُه","لدى نفسك الكبرى التي ليس مثلُها",6,"ل",3,0],["أمِثْلُ شِعْريَ يُلوى حقُّه وله","عليك من خِيمك المحمودِ أعوان",7,"ن",1,0],["أمثلك بعد الحِلم والعِلم والنُّهَى","يَبَرُّ ويَجفُو للإقامةِ والظَّعْن",8,"ن",1,0],["أمثلُ سُخطك يدهوني فيَكرُبني","شيء سواه وإن مثقالَهُ وَزَنا",9,"ن",2,0],["أمِثل فكري أبا حسين","يموت في نضرة السنين",10,"ن",1,0],["أَمِثلُكَ ضائِقٌ بِالحَقِّ ذَرعاً","وَفي بُردَيكَ كانَ لَهُ حُماةُ",11,"ه",1,0],["أَمِثلي تَأخُذُ النَكَباتُ مِنهُ","وَيَجزَعُ مِن مُلاقاةِ الحِمامِ",12,"م",1,0],["أَمثالُ بَيضاتِ النَعامِ يَهُزُّها","لِلبُعدِ أَمثالُ النَعامِ الهُدَّجِ",13,"ج",1,0],["أَمِثلُكَ مولىً يَبسُطُ العبدَ بِالعذرِ","بِغَيرِ انقِباضٍ مِنكَ يَجْري إلى ذكرِ",14,"ر",1,1],["أُمَثّلُها في خاطري كلّ ساعةٍ","وأمْري لها قَطْرَ الدّموعِ السواكِبِ",15,"ب",1,0],["أَمِثلُكَ يُرتَجى لَولا تَنائي","أُموري وَاِلتِياثي في حَويلي",16,"ل",2,0],["أَمِثلُهُ جَسَداً في مِثلِهِ حَسَداً","لَقَد تَأَلَّفَ بَينَ النارِ وَالفَحمِ",17,"م",1,0],["أَمثالُهُنَّ الباكِيا","تُ المُعوِلاتِ مِنَ النَوائِح",18,"ح",1,0],["أَمثالُ عَلقَمَةَ بنِ هَو","ذَةَ كُلَّ غالِيَةٍ مَياسِر",19,"ر",1,0],["أُمَثّلُهُ في ناظِرٍ غَيرِ ناظِري","كأنّيَ فيما قد أرى منه حالم",20,"م",1,0],["أَمِثلُ بَني مُضَرٍ وائِلٌ","فَقَدتُكَ مِن فاخِرٍ ما أَجن",21,"ن",1,1],["أَمثالُنا كانَ جُملٌ قَبلَنا فَمَضوا","وَمِثلُ رُزءٍ وَجَدنا حِسَّهُ وَجَدوا",22,"د",3,1],["أم ثُرْتَ للحقِّ الطَّرِي","دِ وبالبطولة قد فُتِنْتْ",23,"ت",1,0],["أمثل في مسرح الزيف ألف رواية","وأهذي بألف حكاية",24,"ه",1,0],["أمثقِفَ القلم الذي آلى على","أن ليس ترجَحُ كفهُ استعباد",25,"د",1,0],["أَمثالُنا كان جُيْلٌ، قبلنا، فمضَوا","، ومثلُ رُزْءٍ وجدنا حِسّهُ، وجدوا",26,"د",3,0],["أمثلُ عمروٍ يَسُومُ مثلي","خسفاً وأيامُه فطولُ",27,"ل",1,0],["أمثل الربيع ، لبست المغيب","وأنضر من كلّ آت أتيت",28,"ت",1,0],["أمثالُها فوق الرؤوس وهذه","فوق الرزانةِ والحصانة توضعُ",29,"ع",1,0],["أمثلي ولحمي هواكم ومن دمي","يطيل على الإيام بينكم العتبا",30,"ب",2,0],["أمثلك يا علي وأنت فهماً","حسام لا تفل إذا سللتا",31,"ت",2,0],["أَمِثلُكَ يَرضى دارَ ذُلٍّ إِذا مَأى","بها نَأمُ الضَيّونِ طارَ أَبُو الشِبلِ",32,"ل",1,0],["أمثلك تسديه الحياة إلى فتى","مريد الهوى والشوق وعرِ الخلائق",33,"ق",1,0],["أمثلى يرى منكم عقوقاً لحبه","وشعري بعد الله للحسن يخلق",34,"ق",1,0],["أمثلى ينسى آه مما اجترحتُمُ","على الهائم الحيران فيحومة الورد",35,"د",1,0],["أمثلى يؤذى بالعقوق ولم يكن","له غير حفظ العهد في الحب من وكد",35,"د",1,0],["أَمِثْلُكَ مُنْعِماً يُجْزى بِشُكْرٍ","لَقَدْ أَلْقَتْ مَقالِدَها الأُمُورُ",36,"ر",1,0],["أَمِثْلُكَ مَنْ يَجُوزُ عَلَيْهِ هذا","بِخُبْثِ مِحالِهِ وَالتُّرَّهاتِ",37,"ت",1,0],["أَمثالُ يومِ الدين يوم نعيّه","أَم معجل راع الخداج نُتوجه",38,"ج",2,0],["أمثل الربع من شوق فألثمه","وكيف والفكر يدنيه ويقصيني",39,"ن",2,0],["أُمَثِّلُ هاتَينِ هَذا الرَوضُ يُثمِرُهُ","لا تَدَّعي الزَورَ كِلا بَل هُما ثَمَري",40,"ر",2,0],["أَمثالنا وَالأَعالي قَبلَنا نكبوا","فَما اِستَكانوا بِما لاقوا وَلا وَهَنوا",41,"ن",3,0],["أمثلك يرضى بارتكاب العظائم","ونهب الرعايا وانتهاك المحارم",42,"م",1,1],["أَمثلي يطوفُ الأرض شرقاً ومغرباً","على أرب يرضى من الكثر بالقلّ",43,"ل",1,0],["أمثل شهاب الدِّين لا يرتجى لها","وما انقَبَضَتْ منه اليدان على القبض",44,"ض",1,0],["أَمُثَبِّطِي عنكَ الزمانُ إِذَنْ فَلا","نَهَضَتْ إِلَى الظِّلِّ المبارَكِ لي قَدَمْ",45,"م",1,0],["أمثلك من تنسيه الليالي","محبّا كم بكى وجدا وأنا",46,"ن",2,0],["أمثل محمدٍ المصطفَى","إذا الحكم وُلِّيتُموه لبيبا",47,"ب",2,0],["أمِثلِي يُنَادَى فِي القِتََالِ جَهَالَةً","لَقِيتَ حِمَامَ المَوتِ وَالمَوتُ أَحمَرُ",48,"ر",1,0],["أمثلي يخون العهد عن غير حادثٍ","رماني إذاً ربي بحتفٍ مغافص",49,"ص",1,0],["أمثل الذي ألقى يقاومه صبر","فأصبر أم مثلي ينهنهه الزجر",50,"ر",1,1],["أمِثلي وسِلكُ الشَّيبِ ضَاء بِعَارِضِي","وما تَمَّ غيرُ النائباتِ لَه وقدُ",51,"د",1,0],["أَمَثَّلُهُ في خاطِري فَيَفوتُني","وَبِالقَلبِ مِن عَرفانِهِ التيهُ وَالزَهوُ",52,"و",1,0],["أُمَثِّلُ ما أَخْتَارُ مِنْكَ بِخاطِري","فَيَمْنَحُنِي وَصْلاً وَإِنْ كُنْتَ لا تَدْرِي",53,"ر",2,0],["أمثال يوسف بعد جهد جاهد","أولى بتنشيط لئلا يخفقوا",54,"ق",3,0],["أمثاله في القطر بأكثر إنما","هل كان هذا عبرة لمن اعتبر",55,"ر",1,0],["أمثالهم عزوا فإن منهم بدا","فرد رأيت له جموعا حسدا",56,"د",2,0],["أُمثِّلُ شَخْصِي عندهم في حديقةٍ","سَقاها سحابُ الجَوْدِ صوبَ سِجامِ",57,"م",1,0],["أمثليَ عمٌّ عاش بين بني أخٍ","أبرُّ بهم من والديهم وأرحما",58,"م",2,0],["أمثنٍ بشكر أياديَّ أنت","منذ هجوتك أم غامط",59,"ط",1,0],["أمثلةٌ في الزجاجِ منه","حواجبُ القومِ والطِّرار",60,"ر",1,0],["أُمَثِّلُ بالفِكر دارَ القَرارِ","فأهجُرُ دون اللِّقاء القَرارا",61,"ر",2,0],["أمثلي ملامٌ والملامةُ فطرةٌ","وقدْغاصَ في هامِ المُلِمّاتِ صارمُهْ",62,"م",2,0],["أمثاله الْفِجَاجِ وَسُبْلِهَا","وَسُحْبُ سَمَاءِ الْجُودِ سَحَّتْ بِوَبْلِهَا",63,"ه",2,0],["أمثلي من يرجى لكشف مهمة","وكفي عن قطف المعارف اقطعُ",64,"ع",1,0],["أمثالِ عُقبةَ والعلاءِ وعامرٍ","والسَّجفِ غير مُغمَّر وزيادِ",65,"د",1,0],["أَمِثلَ عَلِيٍّ تَعتَريهِ بِخِدعَةٍ","وَقَد كانَ ماجَرَّبتَ مِن قَبلُ كافِيا",66,"ي",2,0],["أَمَثِّلُهُ مَعْنىً وأَشتاقُ صُورَةً","فَغَيْبَتُهُ مَلْحوظَةٌ وَشُهودُهُ",67,"د",2,0],["أَمثلِ ابنِ هودٍ آخِذاً بِتراتِهِ","وَمَن كانَ موتوراً فَلا يَدَعُ الوَترا",68,"ر",2,0],["أمَثنى بالزواج وكيف ترضى","عروسك ضرَّة بعروس شعر",69,"ر",1,0],["أمثل عنجهة شوكاء يلحق بى","أو مثل شغبر حش عرضه زيم",70,"م",1,0],["أمثل نصب العين من كلّ صاحبٍ","مآثر قد يفنى الزّمان ولا تفنى",71,"ن",2,0],["أم ثَكالى تندُبنَ والنَدبُ فرضٌ","في طريقِ الوَفا على الثَكلانِ",72,"ن",1,0],["أمثلى يستحق السجن إني","لصاحبة المقامات العليه",73,"ي",2,0],["أمثلي يا أخي وقسيم نفسي","يفارق عهده عند الفراق",74,"ق",1,1],["أمَثِّلُهُ لَو كَانَ فِيهِ أصَابِع","عِنَاجَ سِوَارَيْ مِعصَمٍ من أخي الشَّمسِ",75,"س",1,0],["أَمِثلُ قِرواشٍ يَذوقُ الرَدى","يا صاحِ ما أَوقَحَ وَجهَ الحِمام",76,"م",1,1],["أَمثال حَدٍ ما تَرى أَم أَيكم","قَد بُشِرَت بِتآلف الأَهواء",77,"ا",2,0],["أَمِثْلي يُلْهِيهِ فيُلْهَي بطِيبِهِ","تَرنُّمُ أَوْتارٍ وشُرْبُ عُقارِ",78,"ر",1,0],["أمثل شمر أذل الله جبهته","يلقى حسينا بذاك الملتقى الخشن",79,"ن",1,0],["أمثَالُ ذَا التَّأويلِ أفسَدَ هَذِهِ ال","أديَانِ حِينَ سَرَى إلَى الأديَانِ",80,"ن",1,0],["أمثلُ في عَيني خَيالَكَ حاضِراً","وَأَنتَ بَعيدٌ عَن مَقامي وَمَوضِعي",81,"ع",2,0],["أَمثالُهُم مِن خَيرِ قَومِهِمُ","حَسَباً وَكُلُّ أَرومِهِم مِثلُ",82,"ل",1,0],["أمثل نسل رسول الله تأسرهم","عتاة قوم بيوم الفتح قد أسروا",83,"ر",3,0],["أَمثالُ عَلقَمَةَ بنِ هوذَةَ إِذ سَعى","يَخشى عَلَيَّ مَتالِفَ الأَمصارِ",84,"ر",1,0],["أَمثلي أَنتَ أَخو لَوعَةٍ","بَكى لِفُراق الأَليف وَناح",85,"ح",1,0],["أَمثلي شرِقتَ بِماءِ الشُؤونِ","دَماً وَغَصَصتَ بماءِ القراح",85,"ح",1,0],["أَمثلُكَ تَعرى مِن مَحاسنِهِ العُلى","وَحقٌّ لَهُ مَن يَعدَمِ الكفو يسبِقِ",86,"ق",1,0],["أم ثغرها اللألاء أو ماء برقه","لو صال مضناها وقعد جفاء",87,"ا",2,0],["أم ثغر كاس الطلا يفتر عن حبب","أم ذا ضياء نبي اللَه جرجيس",88,"س",1,0],["أم ثنايا غادة بسمت","عن أقاحي ثغرها الشنب",89,"ب",1,0],["أم ثنايا أشنب الثغر بدت","حيث فوه افتر عنها بابتسام",90,"م",1,0],["أم ثغر كأس الحميا لاح مبسمه","يفتر عن عقد در باهر النظم",91,"م",1,0],["امثنِّي المأة الثنى","ومضاعف الألف المضعف",92,"ف",1,0],["أُمَثِّلُكُم هاجِناً أَوهادِ بَيضَتَنا","اَو سَبَّنا يا رُعاةَ المَعزِ وَالضانِ",93,"ن",1,0],["أمثال ريم راعها قانص","أو الحبارى أبصرت قشعا",94,"ع",2,0],["أَمثلك مَن تَميل بِهِ اللَيالي","وَتَرفع كُل ذي فعل رَدي",95,"ي",1,0],["أَمثلك مَن يُشابه يا ابن فَخر","وَجدك حيدر الملك الهمام",96,"م",1,0],["أمثلى يُنهى من أبيكَ وما درى","لغفلته أن الحياة شمول",97,"ل",1,0],["أمثلي ترين الغرب يقظان شاخصاً","الى الشرق يرجو أن تسوء عواقبه",98,"ب",2,0],["أمثلها فتكسبني انبساطا","فيرجعني الزمان إلى اعتيادي",99,"د",2,0],["أمثُله وهو ابن ساقي الكَوثَر","ومالك الحوض بيوم المحشَر",100,"ر",1,0],["أمثلُهُ يَحُقُّ للفُجّار","أن يمنعوا عنهُ الفُراتَ الجاري",100,"ي",1,0],["أمثِّلُه في رجل أكرم من مشى","فتبصُره عيني وما أنا حالمه",101,"م",2,0],["أم ثغرُ زهرٍ بالمسرةِ باسمٌ","أم بالتهاني دارتْ الأقداحُ",102,"ح",1,0],["أمِثلُكَ يَعشُو عَن مَكَانِي وَيَمتَرِي","بِأنِّيَ مِن أفلاَكِ ذَا الأدَبِ القُطبِ",103,"ب",1,0],["أمثل ابن هند رافل في حريره","على دسته وهو الطليق الملسق",104,"ق",1,0],["امثل مسلمٍ وما أدراك ما","مسلم في فضل وعز وابا",105,"ب",2,0],["امثلُ ذا قولي لمن","في الناسِ بَصَّرَ إِنعَطِف",106,"ف",1,0],["أمثال حبات اللآلئ نُضّدت","وأعارها الحسنَ الصناعُ الأيّد",107,"د",1,0],["أمثله تجرح البلوى وتمطره","بنانة الدهر أوجاعاً وأحزانا",108,"ن",2,0],["أَمثالَ زَيدٍ حينَ أَفسَدَ رَهطَهُ","حَتّى تَشَتَّتَ أَمرُهُم فَتَصَدَّعوا",109,"ع",3,0],["أمثلي من يخشى وإن شب جمرها","وليس بضرار على الذهب الوقد",110,"د",1,0],["أَمِثلي جدير با