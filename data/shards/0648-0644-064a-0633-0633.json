{"poems":[[3,"إذا كانَ أمر الله أمراً يقدر","https://www.aldiwan.net/poem160.html",""],[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[90,"علام حرمنا منذ حين تلاقيا","https://www.aldiwan.net/poem44994.html","الطويل"],[53,"يسمو إلى المجد أقوام فتلهزهم","https://www.aldiwan.net/poem64525.html","البسيط"],[93,"أقص عليكم ما جرى لي بالأمس","https://www.aldiwan.net/poem8975.html","عموديه"],[91,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[76,"آليت إلا أن تسير مع الفضل","https://www.aldiwan.net/poem13226.html","الطويل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[50,"كتمت الحب يا حكم","https://www.aldiwan.net/poem65230.html","مجزوء الوافر"],[113,"رحلنا إلى الروم من جلق","https://www.aldiwan.net/poem16491.html","المتقارب"],[125,"لقد لاح من هند هدى راح لائحاً","https://www.aldiwan.net/poem23819.html","الطويل"],[214,"قدوم به ربع الأحبة مشرق","https://www.aldiwan.net/poem13317.html","الطويل"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[261,"سرى متعرضا طيف الخيال","https://www.aldiwan.net/poem48456.html","الوافر"],[325,"رسول الهدى ضاقت بي الحال في الورى","https://www.aldiwan.net/poem67113.html","الطويل"],[369,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[371,"وليس سكوتي رضا عنهم","https://www.aldiwan.net/poem17944.html","المتقارب"],[374,"العبد يهدي إلى المولى ويتحفه","https://www.aldiwan.net/poem4318.html","البسيط"],[376,"مزيدي أسى ما عندكم أنه يسلي","https://www.aldiwan.net/poem57215.html","الطويل"],[385,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[409,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[409,"صدقت فمدح الله أشرف ما يتلى","https://www.aldiwan.net/poem34173.html","الطويل"],[412,"أيا من نعاه لسان القريض","https://www.aldiwan.net/poem50146.html","المتقارب"],[412,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[422,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[445,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[454,"هو الدين","https://www.aldiwan.net/poem977.html",""],[458,"يعز علي أن ألفى المعزى","https://www.aldiwan.net/poem61775.html","الوافر"],[463,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[466,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem15924.html","الوافر"],[482,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[543,"بأي لسان في المحافل أخطب","https://www.aldiwan.net/poem48289.html","عموديه"],[556,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[563,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[563,"فؤادي قد أضر به الغرام","https://www.aldiwan.net/poem34183.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83338","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37971","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202120","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126186","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112820","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122053","الطويل"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122417","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89553","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28039","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27705","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77348","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93703","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93672","الوافر"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99093","الوافر"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132333","الطويل"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142922","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205027","المتقارب"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118795","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132701","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100755","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112345","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74073","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103915","المتقارب"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123537","المتقارب"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103810","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135160","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101364","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105131","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90900","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54408","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136698",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83650","الطويل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124620","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133102","الطويل"],[4515,"","https://poetry.dctabudhabi.ae/diwan/poem/205611","المتقارب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4755,"إِليكَ إِذا الزَّمانُ قَسَا وأَشْوَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=213577",""],[5409,"ذكرت الجنان وأنهارها","https://www.poetsgate.com/ViewPoem.aspx?id=155274",""],[5431,"شغوفٌ كما قلبي..","https://www.poetsgate.com/ViewPoem.aspx?id=190343",""],[5431,"ديك مدجن","https://www.poetsgate.com/ViewPoem.aspx?id=205542",""],[5431,"العبودية الجديدة!(1)","https://www.poetsgate.com/ViewPoem.aspx?id=207437",""],[5431,"غناء ...","https://www.poetsgate.com/ViewPoem.aspx?id=207456",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5616,"تغريبة \"محمود\"","https://www.poetsgate.com/ViewPoem.aspx?id=203240",""],[5616,"أبا الطيب عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=203454",""],[5628,"بين بغداد والقاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=179813",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[6152,"بعد وشوق وافتقاد ولوعة","https://www.poetsgate.com/ViewPoem.aspx?id=213214",""],[2220,"تبارك ربٌّ لم يزل عالي الجدّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11328&r=&rc=202",""],[2220,"سما فاعتلى في كلِّ حال مقام من","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11287&r=&rc=161",""],[6305,"خُذِي قلَمِي ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87345&r=&rc=18",""],[4222,"جفون البيض أم بيض الجفون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52908&r=&rc=200",""]],"verses":[["وَلَيسَ سِباعُ البَرِّ مِثلَ ضِباعِهِ","وَلا كُلُّ مَن خاضَ العَجاجَةَ عَنتَرُ",0,"ر",1,0],["وليس سوى لحظ خفيِّ نُجيلُه","وشكوى كما ارفضَّ الجُمانُ من العِقْدِ",1,"د",1,0],["وليس سَرِيّ القوم من كان شاعراً","ولكن سري القوم من كان هاديا",2,"ي",2,0],["وليس سيفي بمغمودٍ إذا التمستْ","يداك نصري ولا رمحي بمركوز",3,"ز",1,0],["وَلَيسَ سِوى نورٍ ضَئيلٍ بِجانِبي","يَلوحُ وَيَخفى كَالرَجاءِ لَدَى اليَأسِ",4,"س",1,0],["وليس سوى العدالة ما هوينا","وميٌّ قد ذكرناها مثالا",5,"ل",2,0],["وَلَيسَ سِوى تِلكَ الصَرامَةِ صارِمٌ","وَلا غَيرَ هاتيكَ البَشاشَةِ مِن صَقلِ",6,"ل",1,0],["وليسَ سواءً في طريقٍ لسالكٍ","حُدورٌ إلى ما يبتغي وصُعُود",7,"د",1,0],["وَلَيسَ سِوى مُلاحَظَتي","إِذا ما جِئتُ أَتَّهِمُ",8,"م",1,0],["وَلَيسَ سِوى اللَه مِن ناصر","إِذا ما غَريم تَقاضى وَلج",9,"ج",1,0],["وليس سواك الذات الله ربنا","لك النعت في الإخلاص في النعت فاسحا",10,"ح",2,0],["وليس سواك الله بالأواخر عالم","طلبت لفضلٍ منك للصدر شارحا",10,"ح",2,0],["وليس سواك اليوم اسعى لبابه","ولم تك آمالي بغيرك تعلق",11,"ق",1,0],["وليس سوى الدين الحنيف مطهر","لعادات شعب أهله قد تشعبوا",12,"ب",3,0],["وليس سوى الزنا همي ورأيي","فبيكار الخصى نيك العيال",13,"ل",1,0],["وَلَيسَ سِواهُ جَلَّ شَأنُ جَلالِهِ","عَلى فَرَجي دونَ الأَنامِ قَديرِ",14,"ر",1,0],["وليس سوى التَّسليمِ للهِ وَحْدَه","وإنْ عَزَّ منهُ كلَّ صَعبٍ وإنْ عنّى",15,"ن",2,0],["وَلَيسَ سُكوتي رِضاً عَنهُمُ","وَلَكِنَّهُ غَضَبٌ عاقِلُ",16,"ل",1,1],["وليس سمنع مولاه تملَكه","من أن يُحسِّنَ ما أهدى ويقبله",17,"ل",2,0],["وليس سوادَ الصُّدغ في الخدِّ تارِكاً","سوادَ قلوبِ العاشقينَ بِلا شُغلِ",18,"ل",1,0],["وَلَيسَ سِوى مَعاليهِ","معوَّل ضارب المَثَل",19,"ل",1,0],["وليس سوى الرحمن يجذب عبده","إلى كل ما يرضيه منه ويهديه",20,"ي",2,0],["وليس سواه يملك الأمر كله","له ملك هذي الدار والنشأة الأخرى",21,"ا",1,0],["وَلَيسَ سِوى نَكَباتِ الزَمانِ","وَرأيٌ يُضلُّكَ في ضَعفِهِ",22,"ف",2,0],["وَلَيسَ سفاحاً جئنَ لكن مُهورها","صَحيحُ وِدادٍ وَالغَرام يَقودُها",23,"د",3,0],["وليس سواه في حزم وعزم","يبين لنا المضيع من المضاع",24,"ع",1,0],["وَلَيْسَ سِوى نارِ الطِّعانِ لَهُ صِلىً","ولا غَيْرُهُ فِي حَرِّ أَوَّلِها صالِ",25,"ل",1,0],["وليس سوى التوحيد لله منهج","له وبه وصى النبي وأرسلا",26,"ل",2,0],["وليس سوى المقادر حاكماتٌ","تُراوغنا فيخدعنا الدهاء",27,"ا",2,0],["وليس سكوتيَ عنهم رضاً","ولكنه غضبٌ عاقلُ",28,"ل",1,0],["وليس سُرورُ يومٍ مثل دهْرٍ","وأنْت سُرور فضلكَ لا يَريمُ",29,"م",1,0],["وليس سؤالُ الربعُ إلا علالةً","متى رمتَ نطقاً مِن ملاعبِه العجْمِ",30,"م",1,0],["وليسَ سِوى الرحمانِ جلَّ جلالُه","سيَجزيكَ عنِّي بالذي أنتَ تَطلُبُ",31,"ب",1,0],["وَليسَ سعودُ المرء إلّا رضاكُمُ","وإنْ لم يَطُفْ منكمْ برَبْعِ مَلامِ",32,"م",1,0],["وليس سواه لا شرعاً لدينا","ولا عقلاً فدع عنك الخيالا",33,"ل",2,0],["وليس سواكمو للجود أهلا","فكيف نزيل ساحتكم يضامُ",34,"م",1,0],["وَلَيسَ سِوى هِزَّةَ عامِلٍ","وَلَيسَ سِوى مِنَّةَ ضامِرُ",35,"ر",1,0],["وَلَيسَ سِوى مَدحِ امْأَكارِمِ يَنبَغي","فَمَدحُ سِواهُم كانَ مِن خَطَأ امْفِكرِ",36,"ر",1,0],["وليس سواه يُسْأل عن نعيم","إذا وقع السؤال عن النعيم",37,"م",1,0],["وليس سواك والله رحيم","برحمته العفاة مظللونا",38,"ن",2,0],["وليس سواك والله شفيق","يؤم جنابه المتخلفونا",38,"ن",2,0],["وليس سواك والله عليم","يؤم جنابه المتعلمونا",38,"ن",2,0],["وليس سواك والله فقيه","يؤم جنابه المتفقهونا",38,"ن",2,0],["وليس سواك والله إمام","يقيم العدل والحق المبينا",38,"ن",2,0],["وليس سواك والله دليل","ينير سبيل كل المهتدينا",38,"ن",2,0],["وليس سوى علياك يا ذا الجلال من","ينجي من الاسواء والهول والشر",39,"ر",1,0],["وَلَيْسَ سِوَى الإِغْضَاءِ حَيّاً وَمَيِّتاً","تُنِيلُ بِهِ مِنْكَ المُنَى فَأَنَالُهَا",40,"ل",3,0],["وليسَ سماءُ اللَهِ قاطرةً دماً","لذاك وما الارضُ الفضاءُ بمائِدَه",41,"د",2,0],["وَلَيسَ سارٍ إِلى نَيلِ العَلاءِ كَمَن","أَضحى بِنَومِ المُنى وَالعَجزِ وَسنانا",42,"ن",2,0],["وليس سوى النفسِ التي عابد لها","وكلنت من العدا لمن حاله الرشد",43,"د",1,0],["وليس سواه والعيون كثيرةٌ","وتختلف الألقاب فيه مع الفقد",44,"د",1,0],["وَلَيسَ سَواءً صارِمانِ مُضَلَّلٌ","وَآخرُ مَوعود مِنَ اللَهِ بِالنَصرِ",45,"ر",1,0],["وَلَيسَ سِوى سليمانٍ رَئيس","لَهُ ألقت يَدُ العَليا زِماما",46,"م",2,0],["وَلَيسَ سِوى حِماك محط رحلي","وَلَيسَ سِوى فَناك مَناخ نوقي",47,"ق",2,0],["وليس سوى المودة والتصافي","أبا عبد الإله لك اعتقادي",48,"د",2,0],["وليسَ سِوى قَولِ الثَّرى لِصِفاتِهِ","لدى بلِّها فالسبقُ أنتُم جِيَادُهُ",49,"د",2,0],["وليس سوى الظلماء في الليل سلوة","وماليلها إلا عذابٌ وتسهيدُ",50,"د",1,0],["وليس سروري بزهر جديد","يساوي بكائي لزهر ذوى",51,"و",2,0],["وليس سواكُم للجود أهلاً","فكيف نزيلُ سوحكمُ يضامُ",52,"م",1,0],["وليس سواء صادق ومخادع","وليس سواء عالم وجهول",53,"ل",1,0],["وليس سواه بمصر امرؤ","مشوق إلى مجدها العاجل",54,"ل",1,0],["وليس سلوًّا ما تراهُ من النّوى","ولكنّها الدّنيَا نَهَتني عن السيرِ",55,"ر",1,0],["وَلَيسَ سواء وَالخطى تتبع الخطى","غداة الوَغى شاكي السلاح وأعزلُ",56,"ل",1,0],["وليس سؤلكَ يا قلبى سِوى رَهَجٍ","تجوره من دمِ الفرسانِ بالديمِ",57,"م",1,0],["وليس سوى العليل لها كفيل","وماذا بالعليل من الغناء",58,"ا",2,0],["وليس سيد لم