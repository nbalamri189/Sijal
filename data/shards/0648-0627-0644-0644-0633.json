{"poems":[[930,"","https://poetry.dctabudhabi.ae/diwan/poem/132400","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135428","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69992","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69969","الكامل"],[5409,"بدلت وجهه الحميا بوجهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155393",""]],"verses":[["واللسن تنصحه بأفصح منطق","لو كان ينجو بالنصيحة هالك",0,"ك",1,0],["وَاللِسانُ اِحذَر وَخف مِن وَخزِهِ","اِنَّهُ لا شَكَّ يُزري بِالأَسَل",1,"ل",1,0],["واللَّسُّ واللوس مهما لمسه لمسا","صرح الصلاح وعدُّ دمعه عدما",2,"م",2,0],["وَاللسنُ جَمعاءُ تَدعو بِالبَقاءِ لَهُ","في عَرش ملكٍ علي الجوزاءِ أَسماهُ",3,"ا",2,0],["واللسن تهتفُ وَالثُغورُ بَواسِمٌ","لُبنانُ أَبشر بِالمسرَّةِ وَالهَنا",4,"ن",2,0],["واللسان الذليق في فمه الما","ثل قد عاد فاقد الإفصاح",5,"ح",1,0]]}