{"poems":[[318,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[396,"أني أنا السائل الطلاب","https://www.aldiwan.net/poem54619.html","عموديه"],[449,"ناظم الفضل النا قد غدونا","https://www.aldiwan.net/poem56023.html","عموديه"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128231","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103038","الخفيف"],[5790,"أنا أولى بما ذكرت من الأم","https://www.poetsgate.com/ViewPoem.aspx?id=111947",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""]],"verses":[["عاكف في اللوح أقرأ وأرى","كلما كان تنائي ودنا",0,"ن",2,0],["عاكف على الباب والاعتاب","لا خيب الله به ظني",1,"ن",2,0],["عاكف ليس يرقب الله فينا","خيب الله عاكفا حيث مالا",2,"ل",2,0],["عاكف قد بغى وندعوك أن لا","تزد الظالمين إلا ضلالا",2,"ل",2,0],["عاكف دهراً على أصنامه","تنفر الكفار من إسلامه",3,"ه",1,0],["عاكر للعدو كل مرام","وهو للملك طالع الاسعاد",4,"د",1,0],["عاكف فيه لا على صنمٍ فر","دٍ كأني أستغفر الله آزر",5,"ر",1,0],["عاكفاً في حراء , لا العي","ش يصيبه ولا صحبه ولا العشراء",6,"ا",2,0]]}