{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[39,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[53,"يا هل يخلد منظر حسن","https://www.aldiwan.net/poem66456.html","أحذ الكامل"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[41,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[208,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[211,"وإن تك من سعد العشيرة تلقني","https://www.aldiwan.net/poem27968.html","الطويل"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[534,"فالعطف لم يأت في إضمار تابعه","https://www.aldiwan.net/poem37369.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86687","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56098","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65060","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49931","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96332","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123078","الرجز"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202379","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121019","السريع"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83245","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202901","الكامل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86325","المجتث"],[3645,"","https://poetry.dctabudhabi.ae/diwan/poem/99287","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114435","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133066","البسيط"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131003","الرجز"],[4561,"","https://poetry.dctabudhabi.ae/diwan/poem/22611","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120231","الطويل"],[4739,"رساله الي نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=34895",""],[4119,"أشرق البهو يا جبين الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=16212",""],[5334,"وعكليةٌ قالت لجارةِ بيتها","https://www.poetsgate.com/ViewPoem.aspx?id=96981",""],[5956,"الواقع شريعتي الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=201546",""],[463,"ما لي شرقت بماءِ ذي الأثلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60288&r=&rc=344",""]],"verses":[["وَعكٌ كَما يُطبَعُ الحُسامُ وَفي","جَوهَرِهِ صاقِلٌ لَهُ عَمِلُ",0,"ل",1,0],["وعَكٌّ ولَخمٌ والسَّكُونُ وحِميَرٌ","وكِندَةُ والحَيَّانِ بَكرٌ وتَغلِبُ",1,"ب",1,0],["وعكَفْتُ بالقبر المحيط به","فاعذِرْ فلا صنمٌ ولا وثنُ",2,"ن",1,0],["وَعَكستم آياتها فَإِذا القَت","ل مُباح وَالفسقُ فيكُم عَميم",3,"م",1,0],["وَعُكلُ عُبَيدِ التَيمِ وَالتَيمُ أَعبُدٌ","إِذا قيلَ خَلّي عَن حِياضِكَ خَلَّتِ",4,"ت",1,0],["وَعَكَفْتُ آمالِي عَلَيها جاهِلاً","فكأنَّما عَكَفَتْ عَلَى الأَصْنامِ",5,"م",1,0],["وَعكُ الأمير وقاه اللَه كلَّ أذىً","أنشا سحاباً من الأحزان مركوما",6,"م",2,0],["وَعَكُّ بنُ عَدنانَ الَّذينَ تَلاعَبوا","بِغَسّانَ حَتّى طُرِّدوا كُلَّ مَطرَدِ",7,"د",1,0],["وعكفتُ بعدهُمُ على ضَمِنٍ","عرف الهوى فبَلِي كما يُبلي",8,"ل",2,0],["وَعَكْسُها صَحّ في الإبْدالِ مُطَّرِداً","خُذْها ثَمانِيةً تَسْتَيْسِرُ العَسِرَا",9,"ر",2,0],["وَعكَفنا على الخَلاعة لَكن","بوقار لَهُ الصِيانة تَشهَد",10,"د",1,0],["وعكا التي كم فاخرت مستعزة","على كل من ينحو حماها مخاصما",11,"م",2,0],["وعَكْسُهُ مِنْ بَعْدِ تَصْحيفِهِ","بَلْدَةٌ مَلْكٍ مِنْ بلادِ الشَّامْ",12,"م",1,0],["وعُكَّف آمالٍ تَرود لَديهِمُ","جَنى شَجَراتٍ أَثمرَتْ واظلَّتِ",13,"ت",1,0],["وَعُكَّاشَةٌ أَعْطَاهُ غُصْناً فَعَادَ إِذْ","تَنَاوَلَهُ سَيْفاً صَقِيلاً مِنَ الهِنْدِ",14,"د",1,0],["وعكرمة الفياض فينا وموشب","هما فتيا الناس اللذا لم يغمرا",15,"ر",2,1],["وعكلٌ يوم أشبعهم تِراراً","برسل لقاحه متغبقينا",16,"ن",2,0],["وعكس تصحيف تقي","مع طرده اسم ما بقي",17,"ي",1,0],["وعك أعطتك في حربى مقادها","بغير ذنب اليها لي ولا جرم",18,"م",1,0],["وعكسها بعكسه ولا ترى","اصيلةً منها القبيح قد جرى",19,"ر",2,0],["وعكسه إن شئتَ عكساً له","يوجد لكن عند دورِ السماع",20,"ع",1,0],["وعك ابن عدنان الذين سمى لهم","إلى قصب المجد الأغر المحبب",21,"ب",1,0],["وعكاظ وقُسُّ لو حضراهُ","أصبحا من إبداعهِ الكنانِ",22,"ن",1,0],["وَعِكرِمَةٌ تَطوفُ الأَرضَ بَحثاً","لِتَجمَعَ مِن ثِمارِ الزارِعينا",23,"ن",2,0],["وعكاشة لما تكسر سيفه","أعطاه عوداً مكن جريد النخلة",24,"ه",1,0],["وعكستها لكمو بشعري صادقاً","فكأنّ شعري صورةٌ عن شعرها",25,"ه",2,0],["وعكسه يدعى القياس المنطقي","وهو الذي قدّمتهُ فحقّق",26,"ق",1,0],["وَعَكسه صاحَ فِعلٌ","قَد جاءَ لِلحُبِّ داعي",27,"ع",2,0],["وعكست حال يفي العيون كأنه","نقش الفصوص صوابه المعكوس",28,"س",1,0],["وعكسُهُ لم أمدح لأرضيهُ لئيماً","ان كنتَ مُغرماً بفنِّ المعاني",29,"ن",2,0],["وَعَكسُهُ مُمتَنِعٌ لِلدَّورِ","فَاقطِف بِأيدِ الفَهمِ أبهَى النَّورِ",30,"ر",1,0],["وعكا وما عكا فقد كانَ فتحُها","لإجلائهم عن مُدْنِ ساحلهم كَنْسا",31,"س",2,0],["وعكسه ذ شقا تلقاه مجتهداً","لا يرعوي في عنا غي وطغيان",32,"ن",1,0],["وعكسه الثاني فتيٌّ غرّ","إذ كان لم يحكم نهاه الدهر",33,"ر",1,0],["وَعَكٍّ وَلَخمٍ شائِلينَ سِياطَهُم","حِذارَ العَوالي كَالإِماءِ العَوارِكِ",34,"ك",1,0],["وعكس الذي قد مر أكثر فاتئد","الا ايهاذا اللائمي والمعاتب",35,"ب",1,0],["وعكّرت صفو القلوب وجوها هادي","ذكّرتها بالحنان وعشت من دونه",36,"ن",2,0],["وعكة أقلعت وأنت صحيح","ويصح النسيم بالإعتلال",37,"ل",1,0],["وعكليةٌ قالت لجارةِ بيتها","إذا العيرُ أدلى حبذا مثلُ ذا غلفا",38,"ف",2,1],["وعكسُ هذا صحيح لست أَفْهَمُني","والشعر يدأبُ حتى يبلغ الهدفا",39,"ف",2,0],["وعكفتُ بعدهمُ على ضمنٍ","عرف الهوى فبلي كما بيلي",40,"ل",2,0]]}