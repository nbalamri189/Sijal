{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[51,"يا هل يخلد منظر حسن","https://www.aldiwan.net/poem66456.html","أحذ الكامل"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[205,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[208,"وإن تك من سعد العشيرة تلقني","https://www.aldiwan.net/poem27968.html","الطويل"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[530,"فالعطف لم يأت في إضمار تابعه","https://www.aldiwan.net/poem37369.html","البسيط"]],"verses":[["وَعكٌ كَما يُطبَعُ الحُسامُ وَفي","جَوهَرِهِ صاقِلٌ لَهُ عَمِلُ",0,"ل",1,0],["وعَكٌّ ولَخمٌ والسَّكُونُ وحِميَرٌ","وكِندَةُ والحَيَّانِ بَكرٌ وتَغلِبُ",1,"ب",1,0],["وعكَفْتُ بالقبر المحيط به","فاعذِرْ فلا صنمٌ ولا وثنُ",2,"ن",1,0],["وَعَكستم آياتها فَإِذا القَت","ل مُباح وَالفسقُ فيكُم عَميم",3,"م",1,0],["وَعُكلُ عُبَيدِ التَيمِ وَالتَيمُ أَعبُدٌ","إِذا قيلَ خَلّي عَن حِياضِكَ خَلَّتِ",4,"ت",1,0],["وَعَكَفْتُ آمالِي عَلَيها جاهِلاً","فكأنَّما عَكَفَتْ عَلَى الأَصْنامِ",5,"م",1,0],["وَعكُ الأمير وقاه اللَه كلَّ أذىً","أنشا سحاباً من الأحزان مركوما",6,"م",2,0],["وَعَكُّ بنُ عَدنانَ الَّذينَ تَلاعَبوا","بِغَسّانَ حَتّى طُرِّدوا كُلَّ مَطرَدِ",7,"د",1,0],["وعكفتُ بعدهُمُ على ضَمِنٍ","عرف الهوى فبَلِي كما يُبلي",8,"ل",2,0],["وَعَكْسُها صَحّ في الإبْدالِ مُطَّرِداً","خُذْها ثَمانِيةً تَسْتَيْسِرُ العَسِرَا",9,"ر",2,0]]}