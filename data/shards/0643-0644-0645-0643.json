{"poems":[[55,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54643","الكامل"],[376,"من كل جفن بين عيني بين","https://www.aldiwan.net/poem57094.html","السريع"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[482,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80052","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[5274,"دموع القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=203255",""],[5749,"في رثاء فويتح","https://www.poetsgate.com/ViewPoem.aspx?id=203743",""],[5977,"جروح تبرأ","https://www.poetsgate.com/ViewPoem.aspx?id=213270",""]],"verses":[["كَلِمٌ كَالنُصولِ هَذَّبَها القَي","نُ وَوَجهٌ كَالهِرقَليِّ المَشوفِ",0,"ف",1,0],["كُلُّ مِكسالٍ رَقودِ الضُحى","وَعثَةٍ ميسانِ لَيلِ التِمام",1,"م",1,0],["كلِمٌ كنظمِ العِقْدَ يحْسُنُ تحتَه","مَعْناهُ حُسْنَ الماء تحتَ حَبابِهِ",2,"ب",2,0],["كُلُّ مَكَانٍ تَكُونُ فِيهِ","يُقْلِقُهُ وَثْبُهَا مِرَارْ",3,"ر",1,0],["كَلِمٌ كَسَتْهُنَّ الْكَآبَةُ لَوْنَهَا","فَحَكَيْنَ أَنْوَارَ الزَّوَالِ غُرُوبَا",4,"ب",2,0],["كلُّ مكانٍ مِن نَداها نَدىً","عَمَّ فَما يُسألُ عَنهُ بِأَين",5,"ن",1,0],["كل مكر في حماها وفاد","تلك والحق لقد أمست سقر",6,"ر",1,0],["كَلِمٌ كالروضِ أوشيهنّ","بلا عي وبلا حَصَرِ",7,"ر",1,0],["كلم كليس أو مزيد واتفق","توكيده للجحد مع واو النسق",8,"ق",1,0],["كلِمٌ كلّه سبائكُ تبرٍ","ما سبكنَ الأفكار شرواه تبرا",9,"ر",2,0],["كلمٌ كلها محبة اوطان","ورأس الايمان ذاك الولاء",10,"ا",2,0],["كلم كشهب الأُفق أَسمَع وَقعه","في الأَرضِ ذا صمم وَأَنطق أَخرَسا",11,"س",2,0],["كلّ مَكْلومَةٍ بها الحُزْنُ يَغْليْ","كيفَ تُخْفى غيومُهَا وهيَ تُمْطِر",12,"ر",1,0],["كل مكان يلهمك نغيمات وانت سواح","تقول لكلام مسكوب فالانغام سكيب",13,"ب",1,0],["كل مكلوم ٍ ينادي الله جهرا","أو يسرُّ القول فالرحمن أدرى",14,"ر",2,0]]}