{"poems":[[55,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[65,"الناس من خولي والدهر من خدمي","https://www.aldiwan.net/poem45927.html","البسيط"],[95,"تعجبني رؤية حوليكم","https://www.aldiwan.net/poem11070.html","السريع"],[90,"يا شهر أيار ما أن أنت أيار","https://www.aldiwan.net/poem44420.html","البسيط"],[90,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[74,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[47,"تخطى الليالي معشرا لا تعلهم","https://www.aldiwan.net/poem10898.html","الطويل"],[51,"ما كل ما تشتهي يكون","https://www.aldiwan.net/poem63158.html","مجزوء البسيط"],[92,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[76,"ألا ليت لمح البارق المتألق","https://www.aldiwan.net/poem13196.html","الطويل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[50,"خذ العيش الهني من المجوس","https://www.aldiwan.net/poem66598.html","الوافر"],[52,"ظل اليسار على العباس ممدود","https://www.aldiwan.net/poem63880.html","البسيط"],[48,"يزورني القوم هذا أرضه يمن","https://www.aldiwan.net/poem22795.html","البسيط"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20998","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55146","السريع"],[102,"زامر القفر العامر","https://www.poetsgate.com/ViewPoem.aspx?id=50393",""],[47,"تُخَطّي اللّيالي مَعشَراً لا تُعِلُّهُم ْ","https://www.poetsgate.com/ViewPoem.aspx?id=31552",""],[96,"تعالوا نعدّ الصّيد","https://www.poetsgate.com/ViewPoem.aspx?id=15668",""],[53,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[111,"ماذا تريد من الدنيا تعنيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66822&r=&rc=1",""],[119,"قالوا ولعت بشيخون وليس بها","https://www.aldiwan.net/poem40882.html","عموديه"],[154,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[164,"شممت نسيما من وصالك لوهبا","https://www.aldiwan.net/poem58997.html","الطويل"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[189,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[189,"ألا لا أعاد الله ليلى بحجرة","https://www.aldiwan.net/poem14612.html","الطويل"],[189,"حمامنا هذه حمام","https://www.aldiwan.net/poem14651.html","مخلع البسيط"],[202,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[216,"وأغيد ميال القوام مهفهف","https://www.aldiwan.net/poem37915.html","الطويل"],[275,"ما أطيب الخمر في برد الكوانين","https://www.aldiwan.net/poem35282.html","البسيط"],[275,"حلمت بأني في الرياض أسير","https://www.aldiwan.net/poem35397.html","الطويل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[287,"قوامك ثم لحظك يا غلام","https://www.aldiwan.net/poem32625.html","الوافر"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[447,"وأما الصلاة والصيام ومثله","https://www.aldiwan.net/poem14403.html","الطويل"],[457,"وافى الربيع بترنام الفواخيت","https://www.aldiwan.net/poem13672.html","البسيط"],[469,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[543,"رأيت بعيني نجم الثريا","https://www.aldiwan.net/poem48147.html","عموديه"],[563,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53756","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88608","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86956","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86688","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48784","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62652","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119905","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56236","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112816","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20003","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50027","البسيط"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26680","الوافر"],[1704,"","https://poetry.dctabudhabi.ae/diwan/poem/100674","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100976","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143013","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77304","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88645","المتقارب"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137210",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58449","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58258","الطويل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102362","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132649","الهزج"],[3268,"","https://poetry.dctabudhabi.ae/diwan/poem/98148","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145118","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138552",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199022","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102995","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40164","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90840","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45042","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73223","البسيط"],[4755,"على السَّطرِ عَانَى البَحرُ عاصِفَةً هَوْجَا","https://www.poetsgate.com/ViewPoem.aspx?id=190070",""],[4859,"أقصى شراييني","https://www.poetsgate.com/ViewPoem.aspx?id=187679",""],[4929,"ذكريات عن ايام الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=202410",""],[5002,"همس شفيف","https://www.poetsgate.com/ViewPoem.aspx?id=205349",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5652,"بجروح صدر الشمري","https://www.poetsgate.com/ViewPoem.aspx?id=164386",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[5948,"أبِنْ لِي دَعِيَّ بني أصمعِ","https://www.poetsgate.com/ViewPoem.aspx?id=100611",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6301,"حَنِيْنٌ الى لِقَاءٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80673&r=&rc=37",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""]],"verses":[["وَلِلبيضِ لا كَفٌّ لِماضٍ مُهَنَّدٍ","وَلِلسُمرِ لا باعٌ لِعالٍ مُسَدَّدِ",0,"د",1,0],["وَلِلْبَيان لِساني وَالنَّدى خَضِلٌ","بِهِ يَدي وَالعُلا يُخْلَقْنَ مِنْ شِيَمي",1,"م",2,0],["وللبراغيث بأمعائنا","قرصة جوع مثل طعن الأسل",2,"ل",1,0],["وللبعوض انتشار لا انتهاء له","كأنه في وجوه القوم تيّار",3,"ر",1,0],["وللبدر نورٌ يمنح البحر رونقاً","فيبدو كأنّ الماء فيه ضريب",4,"ب",1,0],["وللبيت بيت الفضل كدر صفوه","وللبيت من ذات الصفا حين يهرع",5,"ع",1,0],["وللبلاءِ انفراجٌ بعد أزمنةٍ","ورعيةُ الدَّهرِ إعجافٌ وإسمان",6,"ن",1,0],["وللبرية منها ما تسر به","وللرعية ما يرضى أمانيها",7,"ي",3,0],["وَلِلبُسفورِ طاروا في ثَواني","فَأَهلاً بِالأَوَزِّ العائِمينا",8,"ا",1,0],["وَلِلبُرءِ عُقبى سَوفَ يُحمَدُ غِبُّها","وَخَيرُ الأُمورِ ما تَسُرُّ عَواقِبُه",9,"ب",2,0],["وَلِلبِلى فيهِمُ دَبيبٌ","كَأَنَّ تَحريكَهُ سُكونُ",10,"ن",1,0],["ولَلبَساطَةِ ما أَغْلى كَنائِزَها","(قارونُ) يُرْخِصُ فيها التِّبْرَ والوَرِقا",11,"ق",2,0],["وَلِلبَرقِ مِن قَلبٍ بِهِ مُتَمَلمِلٍ","وَلِلنَجمِ مِن طَرفٍ عَلَيهِ مُؤَرَّقِ",12,"ق",1,0],["وَلِلبُزاةِ مَعَها وَقائِعُ","فَغائِصٌ في جَوفِها وَواقِعُ",13,"ع",1,0],["وَلِلْبِغالِ الْوَطِيَّاتِ الرِّكابِ تَرَى","غِلْمانَهُمْ خَلْفَهُمْ فَوْقَ الْبراذِينِ",14,"ن",1,0],["وللبيضُ المضمّخةُ التراقي","سوى الشفع المنمّشةِ الرؤوس",15,"س",1,0],["وَلِلبَخيلِ عَلى أَموالِهِ عِلَلٌ","زُرقُ العُيونِ عَلَيها أَوجُهٌ سودُ",16,"د",1,0],["وَلِلبَداويِّ أَن يُبنى الخِباءُ لَهُ","في ضاحِكاتٍ بِهِنَّ العَبسُ وَالعَبَسُ",17,"س",1,0],["وللبازِلِ الكَوْماءِ يَرْغُو حُوارُها","وللخيلِ تَعْدُو بالكُماةِ المَساعِرِ",18,"ر",1,0],["وَللبس الدِّلاَص يَغشَى ثيابي","فَوقَها بَيضَةٌ كضَوءِ السِّراجِ",19,"ج",1,0],["وَلِلْبِيدِ السْحِيقَةِ وَالرَّوَاسِي","جَلاَلٌ لاَ يُضَاهِيهِ جَلاَلُ",20,"ل",1,0],["وَلِلْبَرَاغِيتِ بِأَمْعَائِنَا","قَرْصَةُ جُوعٍ مِثْلِ طَعْنِ الأَسَل",21,"ل",1,0],["وللبيدر المنطقي , كي يشعّ","ويورق في المنجل الابتام",22,"م",1,0],["وَللبُرْءِ عُقْبَى، سَوْفَ يُحْمَدُ غبه فيهما،","وَخَيْرُ الأُمُورِ ما تَسُرُّ عَوَاقِبُهْ",23,"ب",2,0],["وللبطل صولات على الحقّ جمّة","وتسفر عن فوز المحقّ الخواتم",24,"م",1,0],["وللبلاءِ انفراجٌ بعد أمنة ٍ","ورعية ُ الدَّهرِ إعجافٌ وإسمان",25,"ن",1,0],["وللبصائر حكم في تقلبها","بأن عيشتها فيها سترديها",26,"ي",3,0],["وللبقاع حقوق ليس يجحدها","زكي الولادة مأمون الحليب نقي",27,"ق",2,0],["وَلِلبَحرِ قَعرٌ لَيسَ يُدرَكُ بِالسَبحِ","إِلى اللَه أَشكو حَرَّ نارِ جَوانِحي",28,"ي",1,0],["وللبين عندي في إساءته يد","غفرت له عند التلاقي بها الذنبا",29,"ب",2,0],["وَلِلبُيوتِ سِطاعاتٌ تَقُومُ بِها","لا خِروَعاً جُعِلَت يَوماً وَلا عَنَما",30,"م",2,0],["وللبَهار دَنانيرٌ منمّقةٌ","سْبكُ الغُيوثِ بنارِ الشمسِ في العُشُب",31,"ب",1,0],["وللبَقِّ فيها والبَراغيثِ خُلْطَةٌ","كبَزْر قَطُوْنا ذُرَّ في حَبِّ سُمّاقِ",32,"ق",1,0],["وللبراغيثِ في نواحي","بيوتِها عَسْكَرٌ لُهام",33,"م",1,0],["وللبرقِ ألهوبٌ وللرعدِ ضَجَّةٌ","تعبِّرُ فيها عن",34,"ن",1,0],["وللبينِ أسيافٌ حِدادٌ يَهُزُّها","ويَظْهَرُ من صَيْحاتِه النَّعْقُ والنَّعْبُ",35,"ب",1,0],["وللبخورِ دُخانٌ طيبُهُ عَبَقٌ","حيث المشامِعُ حُفَّت بالرَّياحين",36,"ن",1,0],["وللبدرِ أنوارٌ كخيطانِ فضَّةٍ","تفضَّضَ منها جَدولٌ وغدير",37,"ر",1,0],["وللبرودِ حفيفٌ فوقَ مرمرِها","وقد تضوعَ منها مسكُ دارينا",38,"ن",2,0],["وَلِلبيضِ المَواضي وَالعَوالي","بِذا التَشبيهِ تيهٌ وَاِبتِسامُ",39,"م",1,0],["وللبنان في يد الداعر الفذ","انتفاضات فارس علوي",40,"ي",1,0],["وللبعض رأي مخلص مخبت كذا","فقيه وقول الكافرين ثأي هبا",41,"ب",2,0],["وللبكور على النوار أندية","فضّت نوافج مسك منه مفتوت",42,"ت",1,0],["وللبدر وجهٌ يصقل الماءَ نورهُ","كما عمَّ سيفاً زئبقٌ يترجرج",43,"ج",1,0],["ولِلبَحرِ قَذفٌ لِدُرًّ وما","كَقَذفِ الدَّراريِّ لِلدُّرَرِ",44,"ر",1,0],["وللبداية قد عادت نهايتنا","وأخلصت عندنا كل الجواسيس",45,"س",1,0],["وللبلاد ألا تسمو زلازلها","والراسيات ألا تَرْدى فتنقعُر",46,"ر",1,0],["وَللبيت نوح واركانه","عليه مع الحجَر الأَسود",47,"د",1,0],["وَللبيّادة الأَنجاب بَطشٌ","شَديد لا يُقاوم بِالدِفاع",48,"ع",1,0],["وَللبنّا ضُروبٌ مِن صَواب","مُؤسسة عَلى رُكن مشيد",49,"د",1,0],["وللباغي عليَّ وإن تمادى","نصيبٌ من سماحي والحنان",50,"ن",1,0],["وللبخل والشح ائتلاف وإنما","يمَيزهما شاوى الكلام وذائِقه",51,"ق",2,0],["وللبشر في وجهه رونق","يدل على النجع مثل البشير",52,"ر",1,0],["وللبرق قد صيغت أساوير عسجد","فلاح لكف الروض بالنهر معصم",53,"م",1,0],["وللبشير شهاب العصر زد نعماً","وفي مديد بقاه بلّغ الأملا",54,"ل",2,0],["وللبذ جميل الغوث فهو على ضنا","وسيء حال طعمه ساء ما أمر",55,"ر",1,0],["وَلِلبيضِ خَلَّتها البعولُ وَلَم يَدَع","لَها غَيرَهُ داعي الصباحِ المُفَزَّعُ",56,"ع",1,0],["وللبصائر أبصارٌ مميّزةٌ","برشدها تعرفُ الأنوار والظلما",57,"م",2,0],["وللبهو البهيِّ سماءُ نورٍ","تمثّلَ شكلها حَلَقَاً دِخالا",58,"ل",2,0],["وللبدر من بين الكواكب قد هوى","وللشم