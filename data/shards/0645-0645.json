,[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43864","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[106,"الطفل الموءود!","https://www.poetsgate.com/ViewPoem.aspx?id=179638",""],[13,"وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180800",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"طافَ الوُشاةُ بهِ، فصَدّ وَأعْرَضَا","https://www.poetsgate.com/ViewPoem.aspx?id=31129",""],[28,"إن الذي سمك السماء بنى لنا","https://www.poetsgate.com/ViewPoem.aspx?id=22079",""],[51,"شغَلَ المُحبَّ عن الرسو","https://www.poetsgate.com/ViewPoem.aspx?id=30515",""],[51,"كُفي الدموع وإن كان الفراقُ غَدَاً","https://www.poetsgate.com/ViewPoem.aspx?id=27698",""]],"verses":[["مَمنوعَةً لا ظِلُّها","يَدنو إِلَيَّ وَلا جَناها",0,"ا",3,0],["مُماطِلَةٍ رَكبُها بِالوُرو","دِ إِلّا إِذا حانَ وِردُ القَطامي",1,"م",2,0],["مُمَوَّجِ الأَخلاقِ لا مُحسِنٌ","رَبِّ يَدِ الجودِ وَلا باخِلِ",2,"ل",1,0],["مَمطورَةَ الأَنفاسِ فاهَ بِطيبِها","سَحَرٌ بِبَينُ بِها مِنَ الأَسحارِ",3,"ر",1,0],["مِمّا يُطيلُ الهَمَّ أَنَّ أَمامَنا","طولَ الطَريقِ وَقِلَّةَ الأَزوادِ",4,"د",1,0],["مِمّا يَقَوّي العَزاءَ عَنكَ وَإِن","شَرَّدَ قَلبي العَزاءُ بِالكُرَبِ",5,"ب",1,0],["مَمْنُوعَةُ الأَبْيَاتِ بِالْبِيْضِ الظُّبَا","فَالنَّجْمُ لِلطُّرَّاقِ مِنْهَا أَقْرَبُ",6,"ب",1,0],["مُمَرٌّ كَسَرحانِ القَصيمَةِ مُنعَلٌ","مَساحِيَ لا يُدمي دَوابِرَها الوَجى",7,"ا",1,0],["مُمَرّاً كَعَقدِ الأَندَرِيِّ مُدَمَّجاً","بَدا قارِحٌ مِنهُ وَلَم يَبدُ قارِحُ",8,"ح",1,0],["مَمالِكُهُ مَحروسَةٌ وَثُغورُهُ","رَكائِبُهُ مَنصورَةٌ وَمَراكِبُه",9,"ب",2,0],["مُمِرُّ القُوى لا يَملَأُ الخَطبُ صَدرَهُ","وَلَيسَ لِأَمرٍ فائِتٍ يَتَلَهَّفُ",10,"ف",1,0],["مُمَتَّعٌ بِالرَبيعِ الطَلقِ نازِلُها","يُلهيهِ عَن طيبِ آصالٍ نَدى بُكَرِ",11,"ر",1,0],["مُمِرٌّ لِمَن عاداهُ إِذ أَولِياؤُهُ","يَلَذُّ لَهُم كَالماءِ شيبَ بِهِ الشَهدُ",12,"د",1,0],["مَمدودَةٌ بِلُهى النَدى أَطنابُهُ","مَرفوعَةٌ بِالبيضِ مِنهُ عِمادُ",13,"د",1,0],["ممثلوها بهذا المنتدى لهم","مفاخر ملء عين الدهر والأذن",14,"ن",1,0],["مِمَّا عَلَى الأَيَّامِ تَبْذُلِينَهْ","لِمِصْرَ مِنْ جُهْدٍ فَمَا تَأْلِينَهْ",15,"ن",2,0],["مَمْنُونُ مُرْدِي الأَعَادِي غَيْرَ مُحْتَشِمٍ","بَطْشاً وَمُسْدِي الأَيَادِي غَيْرَ مَنَّانِ",16,"ن",1,0],["مِمَّا تَوَالَتْ عَلَى الوَادِي بِهِ حِقَبٌ","زِينَتْ حَوَاشِي الصَّفَا مِنْهُ بِأَفْنَانِ",16,"ن",1,0],["مِمَّا لَوِ اسْتَطْلَعَ الرَّانِي نَفَائِسَهُ","لَمَا انْقَضَى عَجَدُ المُسْتِطْلِعِ الرَّانِي",16,"ن",2,0],["مُمَثِّلُوهَا بِهَذَا المُنْتَدَى لَهُمُ","مَفَاجِرٌ مِلْءُ عيْنِ الدَّهْر وَالأُذُنِ",17,"ن",1,0],["مِمَّنْ يُقَدَّمُ فِي الرِّجَالِ وَمَا بِهِ","إِلاَّ الطِّلاَءُ بِكَاذِبِ الأَلوَانِ",18,"ن",1,0],["مُمَكَّنٌ فِي أُصُولِ الفَنِّ مُبْتَكِرُ","مُعَالِجٌ لَبِقٌ مًسْتَنبِطٌ ذُهُنِ",19,"ن",1,0],["مِمَّا بَنَى فِرْعَونُ مِنْ","قِدَمٍ فَأَعْجَزَ كُلَّ بَانِي",20,"ي",1,0],["مِمَّا يُريكَ الشَّرْقُ فِيهِ سِرَّهُ","وَصَنِيعُهُ بِبَدِيعِهِ مَوْسُومُ",21,"م",1,0],["مِمَّا الحَقِيقَةُ فِيهِ","تُزْهَى بِثَوبِ خَيَالِ",22,"ل",1,0],["مِمَّا تَلَقَّتْ عَنْ أَبٍ هُوَ عَالِمٌ","عِلْمٍ يُحَقُّ لِقَدْرِهِ التَّبْجِيلُ",23,"ل",1,0],["مِمّا تَعالَت مِنَ البُهمى ذَوائِبُها","بِالصَيفِ وَاِنضَرَجَت عَنَهُ الأَكاميمُ",24,"م",1,0],["مُمَرٍّ أَمَرَّت مَتنَهُ أَسَدِيَّةٌ","يَمانِيَةٌ حَلَّت جُنوبَ المَضاجِعِ",25,"ع",1,0],["مِمّا تَقَيَّضَ عَن عوجٍ مُعَطَّفَةٍ","كَأَنَّها شامِلٌ أَبشارَها جَرَبُ",26,"ب",1,0],["مُموّهٌ بنفارٍ تاه من عجب","فليس يعدمُ تنويها ولا تيها",27,"ي",3,0],["مما أناجي الأفق أعْديه بالجوى","فأرعى له سَرْحَ النجوم ويرعاني",28,"ن",2,0],["مما لهم أنبته جَوده","ويشبع المعدم والمغتني",29,"ي",1,0],["مِمَّن يَعُدُّكَ تَكفي فَقدَ والِدِهِ","كَالفَرخِ في العُشِّ لَم يَدرُج وَلَم يَطِرِ",30,"ر",1,0],["مُمقِرٌ مُرٌّ عَلى أَعدائِهِ","وَعَلى الأَدنَينَ حُلوٌ كَالعَسَل",31,"ل",1,0],["مَمالِكُنا مَكاسِبُنا إِذا ما","تَوارَثَها رِجالٌ عَن رِجالِ",32,"ل",1,0],["مَمالِكُها لِلبيضِ بيضِ سُيوفِنا","سَبايا وَهُنَّ لِلمُلوكِ مَهابِرُ",33,"ر",1,0],["مَمكورَةُ الساقَينِ شِبهُهُما","بَردِيَّتا مُتَحَيِّرٍ غَمرِ",34,"ر",1,0],["ممدحة ثلاثتها لضرّ","ضرَابٌ أو طعانٌ أو رماء",35,"ا",2,0],["ممدّحين لهم في كلّ شارقةٍ","برٌّ وتحت سجوف الليل إخبَات",36,"ت",1,0],["مملوكةٌ عنديَ روميَّة","كم نشَّفت رأسي وما من شفه",37,"ه",1,1],["مما أناف به للمجد إنَّ له","عُرفاً يرى فرص الإحسان تغتنم",38,"م",1,0],["ممنّع الوصل كم حالمت من شغفٍ","عدايَ فيه وكم عاديت أحلامي",39,"م",2,0],["ممنَّعة المغزى تجر برأسهِ","جريراً وتلقي من جرى الكلب جرولا",40,"ل",2,0],["مِمَّا إذا راكب أنْضَى مَطيَّتَهُ","أضحتْ جَمُوماً وقد أنضاه مَسراها",41,"ه",2,0],["مملوكةً بالسيف مَغْصوبةً","لها دلالٌ مالِكٌ غاصبُ",42,"ب",1,0],["ممن إذا أبت الخطوبُ أو الْتَوَتْ","عاج الأبيُّ به وقام الأعوجُ",43,"ج",1,0],["ممن إذا ما تعاطى نيل مكرمة","نالت يداه مَنال الطرف ما طمحا",44,"ح",2,0],["ممن إذا كان لاحِي البخلِ يَعذِره","فما يبالي بِلاحي الجود كيف لحى",44,"ح",2,0],["ممن ينافس في العلياء صاحبَها","ولو تحمَّل أدنى ثِقْلِها دَلحا",44,"ح",2,0],["ممن إذا قَرَّظَهُ مادحٌ","ساعدَه الإجْمالُ والشَّرْحُ",45,"ح",1,0],["ممن إذا حَفَزَ السهامَ بِقوسه","فَحَّتْ أفاعِيهنَّ أيَّ فحيحِ",46,"ح",1,0],["مِمَّا تراه الدهْرَ يُصْدر وارداً","عن نَائلٍ قَبْلَ السؤال نجيحِ",46,"ح",1,0],["مما تراه لعافيهِ وشانئهِ","يروحُ غَيْثاً ويغدو تارة أسدا",47,"د",2,0],["ممَّنْ يَبُزُّ الناسَ منْفوسَ العلا","وعليه من منفوسها أبرادُ",48,"د",1,0],["ممن أبى الله أن ينفِّلَه","أجراً وما إن يزال في السَّجَدَهْ",49,"د",2,0],["ممن يرى أن رزء العِرْض مُجتَبرٌ","ولا يرى أن رزء المال يجتبر",50,"ر",1,0],["مما أرى من سوء هذا القَدر","وليس لي في عاجلٍ من صبر",51,"ر",1,0],["مِمراضَهُمْ وذميمَهم","وقريبَهُم من وِردِ رمسه",52,"س",2,0],["ممن تراعى الوحشُ حول فنائه","وتُراعُ منهُ الأسد في الأخياس",53,"س",1,0],["ممن يُنيلُ وما استُنيل كما","يُكسَى المدائحَ غير مُستَكس",54,"س",1,0],["ممن إذا أغضِبَ في قُدرة","كقُدرةِ القَسْور لم يفرِس",55,"س",1,0],["ممَّن إذا جاهلٌ تعرَّض لي","أصبحَ في جُنده قد افترضا",56,"ض",2,0],["مُموِّه زُورٍ مُبتغٍ صيد محرمٍ","جنيبُ هوى للجهل بالغيِّ خالط",57,"ط",1,0],["مُمْجِداً منجداً كأنك عدٌّ","دائمُ السَّقي زاخرُ الينبوع",58,"ع",1,0],["ممن قضى الله بإحسانه","ما أحسنت قُمْرِيَّةٌ سَجْعه",59,"ع",