زارني","https://www.aldiwan.net/poem48040.html","السريع"],[560,"لا تكن إلا لمولاك أنا","https://www.aldiwan.net/poem33718.html","الرمل"],[560,"لم يكن ذا الكون قط","https://www.aldiwan.net/poem34408.html","مجزوء الرمل"],[560,"باطن الباطن ظاهر","https://www.aldiwan.net/poem34520.html","مجزوء الرمل"],[756,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/26626","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18969","الطويل"]],"verses":[["باطِشَةً بِلا يَدٍ","واعِظَةً بِغَيرِ فَم",0,"م",1,0],["بأطْيَبَ نَشْراً منْ شَمائِلِهِ التي","تَنُمُّ بِرَيّاها على العَنْبَرِ الوَرْدِ",1,"د",1,0],["بأطْيَبَ نَشْراً منْ شَمائِلهِ التي","يَلوذُ بِها جارٌ وضَيْفٌ ومُجْتَدِ",2,"د",1,0],["بِإِطراقِ رَأسي بِاِعتِرافي بِذِلَّتي","بِمَدِّ يَدي أَستَمطِرُ الجودَ وَالرُحمى",3,"م",2,0],["بِأَطيَبَ مِن فيها لِمَن ذاقَ طَعمَهُ","وَقَد لاحَ ضَوءُ النَجمِ أَو كادَ يَنجَلي",4,"ل",2,0],["بِأَطيَبَ مِن أَردانِ عَزَّةَ مَوهِناً","وَقَد أوقِدَت بِالمَندَلِ الرَطبِ نارُها",5,"ر",3,0],["بِأَطيَبَ مِنها نَكهَةً بَعدَ هَجعَةٍ","وَنَشراً وَلا وَعساءُ طَيِّبَةُ النَشرِ",6,"ر",1,0],["بِأَطيَبَ مِن فيها وَلا طَعُم قَرقَفٍ","بِرَمّانَ لَم يَنظُر بِها الشَرقَ صابِحُ",7,"ح",1,0],["باطنا راحتَيهِ زمزم تُمتا","حُ وظهراهما فركنا استلام",8,"م",1,0],["بأطولَ من قرنهِ","وأغلظ من ذهنه",9,"ن",2,0],["بِأَطيَبَ مِنها إِذا ما النُجو","مُ أَعنَقنَ مِثلَ تَوالي البَقَر",10,"ر",1,0],["بِأَطيَبَ مِن فيها إِذا جِئتَ طارِقاً","وَأَشهى إِذا نامَت كِلابُ الأَسافِلِ",11,"ل",1,0],["بِأَطيَبَ مِن فيها إِذا جِئتَ طارِقاً","مِنَ اللَيلِ وَالتَفَّت عَلَيكَ ثِيابُها",12,"ب",3,0],["بِأَطيَبَ مِن مُقَبَّلِها إِذا ما","دَنا العَيّوقُ وَاِكتَتَمَ النُبوحُ",13,"ح",1,0],["بِأَطيَبَ مِن فيها إِذا جِئتُ طارِقاً","وَلَم يَتَبَيَّن ساطِعُ الأُفُقِ المُجلى",14,"ل",2,0],["بِأَطيَبَ مِن ثَوبَينِ تَأوي إِلَيهِما","سُعادُ إِذا نَجمُ السِماكَينِ عَرَّدا",15,"د",2,0],["بِأَطيَبَ مِن أَردانِ بَثنَةَ مَوهِناً","أَلا بَل لِرَيّاها عَلى الرَوضَةِ الفَضلُ",16,"ل",1,0],["باطِلٌ مِن أُمَمٍ مَخدوعَةٍ","يَتَحَدّونَ بِهِ الحَقَّ المُبين",17,"ن",1,0],["باطِنُ الأُمَّةِ مِن ظاهِرِها","إِنَّما السائِلُ مِن لَونِ الإِناء",18,"ا",2,0],["بأطيبَ من طِيبِ الرُّقادِ لساهرٍ","وأعذبَ من رِيقِ الحبيبِ لصَادي",19,"د",2,0],["باطِنُهُ أَحسَنُ مِن ظاهِرِهِ","وَشَكُّهُ أَوضَحُ مِن يَقينِهِ",20,"ن",2,0],["بِأَطيَبَ مِنها جَنى ريقَةٍ","إذا نَحَرَ اللَّيلَ رمحُ السماك",21,"ك",1,0],["بِأَطيَبَ مِن فَمِها ريقَةً","إذا بَرَدَ الدُّرُّ فَوقَ النحورِ",22,"ر",1,0],["بأطيبَ من ريّا لماها لراشفٍ","إذا انتبهتْ في الشرْقِ ناظرةُ الصبح",23,"ح",1,0],["بأطيبَ مِنْ أبياتِ نظمٍ بعثتُها","تجدِّدُ أشواقاً طوالاً شروحُها",24,"ح",3,0],["بِأَطوَلَ باعاً مِن رَحيمٍ وَقَد سَطا","بِأَرقَشَ مُصفَرِّ القَميصِ قَصيرِ",25,"ر",1,0],["بِأَطيَبَ أَفياءً وَأَنضَرَ صَفحَةً","وَأَعطَرَ أَخلاقاً وَأَحلى تَرَنُّما",26,"م",2,0],["بِأَطيَبَ مَن فيها وَلا المِسكُ بَلَّهُ","مِنَ اللَيلِ أَروى ديمَةٍ وَقُطارُها",27,"ر",3,0],["بِأَطيَبَ نَكهَةً مِن أُمِّ سَلمى","إِذا مال الَيلُ آذَنَ بِاِنتِصافِ",28,"ف",1,0],["بِأَطيَبَ مِن فيها إِذا ما تَقَلَّبَت","مِنَ اللَيلِ وَسنى وَالعُيونُ هُجوعُ",29,"ع",1,0],["بِأَطيَبِ مِن سَلمى وَلا كُلُّ طَيِّبٍ","وَلا مِثلُ ما تَحلو بِهِ يَفعَلُ البَدرُ",30,"ر",1,0],["بِأَطيرٍ مِنَ المَوَدَّةِ دانٍ","وَثَناءٍ كَالعَصبِ عَصبِ الحَريرِ",31,"ر",1,0],["باطِلٌ ذاكَ إِنَّ لُبّي إِلى الدُن","يا قَرينٌ وَما يَزالُ سَليبا",32,"ب",2,0],["بأَطيبَ مِن فيها وَلا طَعمَ ريقِها","إِذَا النَجمُ أَصغى للمَغِيبِ وَصَوَّبا",33,"ب",2,0],["بأطيبَ نَشراً من خلائقِهِ الَّتي","لها خَضَعتْ في الحُسنِ زُهرُ الخلائقِ",34,"ق",1,0],["باطلٌ إن مرّت الرِّيحُ به","طارَ عن صاحبهِ وهو هباءْ",35,"ا",2,0],["بِأَطيَبَ من فيها محادثَةً إِذا","حَلا النومُ عِندَ الفجرِ في الأَعيُنِ النجلِ",36,"ل",1,0],["بِأَطيَبَ مِن بَيتِ المُلاءَةِ إِذ غَدَت","تَقاعَسُ في مِرطِ التَصابي عَلى مَهلِ",37,"ل",1,0],["بإطراق رأسي باعترافي بذلتي","أمد يدي استمطر الجود والرحمى",38,"م",2,0],["بأطيَبَ من أردانِ بَثنة َ مَوهِناً،","ألا بل لريَّها، على الروضة ِ، الفَضْل",39,"ل",1,0],["بِأَطيَب مِن خَلائِقِهِ ال","تي سارَت بِها المثل",40,"ل",1,0],["باطل النفس تمادى","فعسى بالحق يدمغ",41,"غ",1,0],["باطلاً تَرجُونَ لَحناً مُفرِحاً","قَطَّعَت أطرَبَ أوتاري العِبَر",42,"ر",1,0],["باطِنُها مُكْتَسٍ وظاهرُها","لِلعينِ يُبدي مستَنْزَهاً عَجبا",43,"ب",2,0],["بِاَطيَبَ مَوهِناً مِن رِيقِ سَلمَى","إِذا عَصَبَ الكَرَى بِالسَّامِرينَأ",44,"ن",2,0],["بِأَطيبَ مِن فِيها مَذَاقاً وإِنَّى","بِشَيمِى إذا أَبصَرتُهُ لَطَبِيبُ",45,"ب",1,0],["بِأَطيبَ مشن فيها ولا قَرقَفِيَّةٌ","يُشابُ بماءِ الزَّنجَبيلِ رُضابُها",46,"ب",3,0],["بِأَطيَبَ مَوهِناً مِنها إِذا ما","لَوَت لِضَجيعِها القَصَبَ الخِدالا",47,"ل",2,0],["باطل باطل حديث أناس","زعموا أن شرعة الكون حبّ",48,"ب",1,0],["بِأَطيَبَ نَشراً مِنكَ في كُلِّ مَحفلٍ","يَقومُ بِهِ المُطري لَهُ فَيَقولُ",49,"ل",1,0],["بِأَطيَبَ من فيكِ لي نَكهَةً","وَلا ريقَةً لَيتَني مِنهُ أُسقى",50,"ق",2,0],["بِأَطيَبَ مِن فيها لِمَن ذاقَ طَعمَهُ","وَقَد جَفَّ بَعدَ النَومِ لِلنَومِ ريقُها",51,"ق",3,0],["بِأَطيَبَ مِن فيها إِذا ما تَقَلَّبَت","مَعَ اللَيلِ وَسَنى جانِباً بَعدَ جانِبِ",52,"ب",1,0],["باطِنُهُ وَالظاهِرُ اِتِّحادُهُ","وَهَل تَرى قَلبَ دَدٍ غَيرَ دَدِ",53,"د",1,0],["بأطيب من ريَّا عُلالة ريقها","غداة هضاب الطلّ في روضة تندى",54,"د",2,0],["بِأَطَيبِ من مُجاجتهنَّ طَعماً","إِذا استيقظنَ من سِنَةِ المَنامِ",55,"م",1,0],["بأَطيبَ منها نَكهَةً بَعدَ هجعَةٍ","إِذا ما تَدلّى الكَواكبُ المتصَوِّبُ",56,"ب",1,0],["بأطيبَ منه أوْ بأبهى خلائقاً","وخلقاً بحال ما تغنت أوانس",57,"س",1,0],["بأطيبَ من أردانِ سُنَّة أحمدٍ","وما راح يهدي للنفوس كلامُه",58,"م",2,0],["باطنٌ مثل ظاهرٍ إنّ حسن ال","خَلْقِ بُشرى محاسنِ الأخلاقِ",59,"ق",1,0],["باطِنة وظاهر جمالُها","فالحسنُ منها غائبٌ وشاهدُ",60,"د",1,0],["بأطيبَ من فم ذات الوشاح","سُحوراً بلى فمُها أطيبُ",61,"ب",1,0],["بأطيب من عرض الرضا حين تنش","ر المدائح غُراً بين نادٍ ومازق",62,"ق",1,0],["بأطيب من ذكرى دبيس بن مزيد","إذا ردد الساري ثناءً ورجَّعا",63,"ع",2,0],["بأطيبَ من عِرْض تاج المُلوكِ","إذا نكَّبَ الدار رُكبانُها",64,"ن",3,0],["بأطيب من عِرض الوزير ولو غدت","أصائلُها مَطْلولةً وبُكورها",65,"ر",3,0],["بأطربَ مِن شعري وأين كمثلِه","قريضٌ عليه تَحسِدُ المقلةُ الأذِنا",66,"ن",2,0],["بِأطْوارهِ بالطَّوْلِ من عَزَمَاتِهِ","بِسُلْطانهِ الفَعَّالِ في السِّرِّ والجَهْرِ",67,"ر",1,0],["بأطرافِ نجدٍ والقَبائلِ كلِّها","وفَتحُ حجازٍ كانتِ الآيةَ الكُبرى",68,"ر",2,0],["بأَطْيَبَ مِنْ فيها إذا جئْتَ طارِقاً","منَ اللَّيْلِ بَلْ فُوها أَلَذُّ وأَنْصَحُ",69,"ح",1,0],["باطلةٍ لكنَّها","منَ المسيءِ حَسَنَهْ",70,"ن",2,0],["باطلةً كأنّها","هناك من محقِّقِ",71,"ق",1,0],["بِأَطيبَ مِنْ أَردانها حينَ أَقبلتْ","وغضُّ النَّقا في دِرْعها يترنَّحُ",72,"ح",1,0],["باطلةٌ روّتْ لنا غُلَّةً","والحقّ لم يأتِ بمطلوبِ",73,"ب",1,0],["باطل أيْ عدم قدَّره","فهو تقدير هناك وهنا",74,"ن",2,0],["باطل منعدم","وله الحق لقط",75,"ط",1,0],["باطن الباطن ظاهرْ","ظاهر الباطن قاهرْ",76,"ر",1,1],["بِأَطيَبَ مَن فيها إِذا جِئتَ طارِقاً","مِنَ اللَيلِ وَاِخضَلَّت عَلَيكَ المَضاجِعُ",77,"ع",1,0],["بِأَطيَبَ مِمَّن يَقصِرُ الطَرفَ دونَهُ","تُقى اللَهِ وَاِستِحياءَ بَعضِ العَواقِبِ",78,"ب",1,0],["بِأَطيَبَ بَعدَ النَومِ مِن أُمِّ طارِقٍ","وَلا طَعمُ عُنقودٍ عَقارٍ زَبيبُها",79,"ب",3,0]]}