l","الخفيف"],[280,"ألا هل إلى باب البريد سبيل","https://www.aldiwan.net/poem32669.html","الطويل"],[280,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[290,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[356,"وما نفح روض ذي أقاح وحنوة","https://www.aldiwan.net/poem718.html","الطويل"],[362,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[366,"خليلي عوجا بارك الله فيكما","https://www.aldiwan.net/poem1870.html","الطويل"],[403,"بعثن غداة تقويض الخيام","https://www.aldiwan.net/poem50124.html","الوافر"],[416,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[450,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[450,"أجل حديث لا يمل دوامه","https://www.aldiwan.net/poem13898.html","الطويل"],[456,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[459,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[459,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[459,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[459,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[475,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[498,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[544,"أمن رسم دار ماء عينيك يسفح","https://www.aldiwan.net/poem1860.html","الطويل"],[549,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[549,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[549,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[549,"فديته من زائر زارني","https://www.aldiwan.net/poem48040.html","السريع"],[556,"لا تكن إلا لمولاك أنا","https://www.aldiwan.net/poem33718.html","الرمل"],[556,"لم يكن ذا الكون قط","https://www.aldiwan.net/poem34408.html","مجزوء الرمل"],[556,"باطن الباطن ظاهر","https://www.aldiwan.net/poem34520.html","مجزوء الرمل"]],"verses":[["باطِشَةً بِلا يَدٍ","واعِظَةً بِغَيرِ فَم",0,"م",1,0],["بأطْيَبَ نَشْراً منْ شَمائِلِهِ التي","تَنُمُّ بِرَيّاها على العَنْبَرِ الوَرْدِ",1,"د",1,0],["بأطْيَبَ نَشْراً منْ شَمائِلهِ التي","يَلوذُ بِها جارٌ وضَيْفٌ ومُجْتَدِ",2,"د",1,0],["بِإِطراقِ رَأسي بِاِعتِرافي بِذِلَّتي","بِمَدِّ يَدي أَستَمطِرُ الجودَ وَالرُحمى",3,"م",2,0],["بِأَطيَبَ مِن فيها لِمَن ذاقَ طَعمَهُ","وَقَد لاحَ ضَوءُ النَجمِ أَو كادَ يَنجَلي",4,"ل",2,0],["بِأَطيَبَ مِن أَردانِ عَزَّةَ مَوهِناً","وَقَد أوقِدَت بِالمَندَلِ الرَطبِ نارُها",5,"ر",3,0],["بِأَطيَبَ مِنها نَكهَةً بَعدَ هَجعَةٍ","وَنَشراً وَلا وَعساءُ طَيِّبَةُ النَشرِ",6,"ر",1,0],["بِأَطيَبَ مِن فيها وَلا طَعُم قَرقَفٍ","بِرَمّانَ لَم يَنظُر بِها الشَرقَ صابِحُ",7,"ح",1,0],["باطنا راحتَيهِ زمزم تُمتا","حُ وظهراهما فركنا استلام",8,"م",1,0],["بأطولَ من قرنهِ","وأغلظ من ذهنه",9,"ن",2,0],["بِأَطيَبَ مِنها إِذا ما النُجو","مُ أَعنَقنَ مِثلَ تَوالي البَقَر",10,"ر",1,0],["بِأَطيَبَ مِن فيها إِذا جِئتَ طارِقاً","وَأَشهى إِذا نامَت كِلابُ الأَسافِلِ",11,"ل",1,0],["بِأَطيَبَ مِن فيها إِذا جِئتَ طارِقاً","مِنَ اللَيلِ وَالتَفَّت عَلَيكَ ثِيابُها",12,"ب",3,0],["بِأَطيَبَ مِن مُقَبَّلِها إِذا ما","دَنا العَيّوقُ وَاِكتَتَمَ النُبوحُ",13,"ح",1,0],["بِأَطيَبَ مِن فيها إِذا جِئتُ طارِقاً","وَلَم يَتَبَيَّن ساطِعُ الأُفُقِ المُجلى",14,"ل",2,0],["بِأَطيَبَ مِن ثَوبَينِ تَأوي إِلَيهِما","سُعادُ إِذا نَجمُ السِماكَينِ عَرَّدا",15,"د",2,0],["بِأَطيَبَ مِن أَردانِ بَثنَةَ مَوهِناً","أَلا بَل لِرَيّاها عَلى الرَوضَةِ الفَضلُ",16,"ل",1,0],["باطِلٌ مِن أُمَمٍ مَخدوعَةٍ","يَتَحَدّونَ بِهِ الحَقَّ المُبين",17,"ن",1,0],["باطِنُ الأُمَّةِ مِن ظاهِرِها","إِنَّما السائِلُ مِن لَونِ الإِناء",18,"ا",2,0],["بأطيبَ من طِيبِ الرُّقادِ لساهرٍ","وأعذبَ من رِيقِ الحبيبِ لصَادي",19,"ي",1,0],["باطِنُهُ أَحسَنُ مِن ظاهِرِهِ","وَشَكُّهُ أَوضَحُ مِن يَقينِهِ",20,"ن",2,0],["بِأَطيَبَ مِنها جَنى ريقَةٍ","إذا نَحَرَ اللَّيلَ رمحُ السماك",21,"ك",1,0],["بِأَطيَبَ مِن فَمِها ريقَةً","إذا بَرَدَ الدُّرُّ فَوقَ النحورِ",22,"ر",1,0],["بأطيبَ من ريّا لماها لراشفٍ","إذا انتبهتْ في الشرْقِ ناظرةُ الصبح",23,"ح",1,0],["بأطيبَ مِنْ أبياتِ نظمٍ بعثتُها","تجدِّدُ أشواقاً طوالاً شروحُها",24,"ح",3,0],["بِأَطوَلَ باعاً مِن رَحيمٍ وَقَد سَطا","بِأَرقَشَ مُصفَرِّ القَميصِ قَصيرِ",25,"ر",1,0],["بِأَطيَبَ أَفياءً وَأَنضَرَ صَفحَةً","وَأَعطَرَ أَخلاقاً وَأَحلى تَرَنُّما",26,"م",2,0],["بِأَطيَبَ مَن فيها وَلا المِسكُ بَلَّهُ","مِنَ اللَيلِ أَروى ديمَةٍ وَقُطارُها",27,"ر",3,0],["بِأَطيَبَ نَكهَةً مِن أُمِّ سَلمى","إِذا مال الَيلُ آذَنَ بِاِنتِصافِ",28,"ف",1,0],["بِأَطيَبَ مِن فيها إِذا ما تَقَلَّبَت","مِنَ اللَيلِ وَسنى وَالعُيونُ هُجوعُ",29,"ع",1,0],["بِأَطيَبِ مِن سَلمى وَلا كُلُّ طَيِّبٍ","وَلا مِثلُ ما تَحلو بِهِ يَفعَلُ البَدرُ",30,"ر",1,0],["بِأَطيرٍ مِنَ المَوَدَّةِ دانٍ","وَثَناءٍ كَالعَصبِ عَصبِ الحَريرِ",31,"ر",1,0],["باطِلٌ ذاكَ إِنَّ لُبّي إِلى الدُن","يا قَرينٌ وَما يَزالُ سَليبا",32,"ب",2,0],["بأَطيبَ مِن فيها وَلا طَعمَ ريقِها","إِذَا النَجمُ أَصغى للمَغِيبِ وَصَوَّبا",33,"ب",2,0],["بأطيبَ نَشراً من خلائقِهِ الَّتي","لها خَضَعتْ في الحُسنِ زُهرُ الخلائقِ",34,"ق",1,0],["باطلٌ إن مرّت الرِّيحُ به","طارَ عن صاحبهِ وهو هباءْ",35,"ا",2,0],["بِأَطيَبَ من فيها محادثَةً إِذا","حَلا النومُ عِندَ الفجرِ في الأَعيُنِ النجلِ",36,"ل",1,0],["بِأَطيَبَ مِن بَيتِ المُلاءَةِ إِذ غَدَت","تَقاعَسُ في مِرطِ التَصابي عَلى مَهلِ",37,"ل",1,0],["بإطراق رأسي باعترافي بذلتي","أمد يدي استمطر الجود والرحمى",38,"م",2,0],["بأطيَبَ من أردانِ بَثنة َ مَوهِناً،","ألا بل لريَّها، على الروضة ِ، الفَضْل",39,"ل",1,0],["بِأَطيَب مِن خَلائِقِهِ ال","تي سارَت بِها المثل",40,"ل",1,0],["باطل النفس تمادى","فعسى بالحق يدمغ",41,"غ",1,0],["باطلاً تَرجُونَ لَحناً مُفرِحاً","قَطَّعَت أطرَبَ أوتاري العِبَر",42,"ر",1,0],["باطِنُها مُكْتَسٍ وظاهرُها","لِلعينِ يُبدي مستَنْزَهاً عَجبا",43,"ب",2,0],["بِاَطيَبَ مَوهِناً مِن رِيقِ سَلمَى","إِذا عَصَبَ الكَرَى بِالسَّامِرينَأ",44,"ن",2,0],["بِأَطيبَ مِن فِيها مَذَاقاً وإِنَّى","بِشَيمِى إذا أَبصَرتُهُ لَطَبِيبُ",45,"ب",1,0],["بِأَطيبَ مشن فيها ولا قَرقَفِيَّةٌ","يُشابُ بماءِ الزَّنجَبيلِ رُضابُها",46,"ب",3,0],["بِأَطيَبَ مَوهِناً مِنها إِذا ما","لَوَت لِضَجيعِها القَصَبَ الخِدالا",47,"ل",2,0],["باطل باطل حديث أناس","زعموا أن شرعة الكون حبّ",48,"ب",1,0],["بِأَطيَبَ نَشراً مِنكَ في كُلِّ مَحفلٍ","يَقومُ بِهِ المُطري لَهُ فَيَقولُ",49,"ل",1,0],["بِأَطيَبَ من فيكِ لي نَكهَةً","وَلا ريقَةً لَيتَني مِنهُ أُسقى",50,"ق",2,0],["بِأَطيَبَ مِن فيها لِمَن ذاقَ طَعمَهُ","وَقَد جَفَّ بَعدَ النَومِ لِلنَومِ ريقُها",51,"ق",3,0],["بِأَطيَبَ مِن فيها إِذا ما تَقَلَّبَت","مَعَ اللَيلِ وَسَنى جانِباً بَعدَ جانِبِ",52,"ب",1,0],["باطِنُهُ وَالظاهِرُ اِتِّحادُهُ","وَهَل تَرى قَلبَ دَدٍ غَيرَ دَدِ",53,"د",1,0],["بأطيب من ريَّا عُلالة ريقها","غداة هضاب الطلّ في روضة تندى",54,"د",2,0],["بِأَطَيبِ من مُجاجتهنَّ طَعماً","إِذا استيقظنَ من سِنَةِ المَنامِ",55,"م",1,0],["بأَطيبَ منها نَكهَةً بَعدَ هجعَةٍ","إِذا ما تَدلّى الكَواكبُ المتصَوِّبُ",56,"ب",1,0],["بأطيبَ منه أوْ بأبهى خلائقاً","وخلقاً بحال ما تغنت أوانس",57,"س",1,0],["بأطيبَ من أردانِ سُنَّة أحمدٍ","وما راح يهدي للنفوس كلامُه",58,"م",2,0],["باطنٌ مثل ظاهرٍ إنّ حسن ال","خَلْقِ بُشرى محاسنِ الأخلاقِ",59,"ق",1,0],["باطِنة وظاهر جمالُها","فالحسنُ منها غائبٌ وشاهدُ",60,"د",1,0],["بأطيبَ من فم ذات الوشاح","سُحوراً بلى فمُها أطيبُ",61,"ب",1,0],["بأطيب من عرض الرضا حين تنش","ر المدائح غُراً بين نادٍ ومازق",62,"ق",1,0],["بأطيب من ذكرى دبيس بن مزيد","إذا ردد الساري ثناءً ورجَّعا",63,"ع",2,0],["بأطيبَ من عِرْض تاج المُلوكِ","إذا نكَّبَ الدار رُكبانُها",64,"ن",3,0],["بأطيب من عِرض الوزير ولو غدت","أصائلُها مَطْلولةً وبُكورها",65,"ر",3,0],["بأطربَ مِن شعري وأين كمثلِه","قريضٌ عليه تَحسِدُ المقلةُ الأذِنا",66,"ن",2,0],["بِأطْوارهِ بالطَّوْلِ من عَزَمَاتِهِ","بِسُلْطانهِ الفَعَّالِ في السِّرِّ والجَهْرِ",67,"ر",1,0],["بأطرافِ نجدٍ والقَبائلِ كلِّها","وفَتحُ حجازٍ كانتِ الآيةَ الكُبرى",68,"ر",2,0],["بأَطْيَبَ مِنْ فيها إذا جئْتَ طارِقاً","منَ اللَّيْلِ بَلْ فُوها أَلَذُّ وأَنْصَحُ",69,"ح",1,0],["باطلةٍ لكنَّها","منَ المسيءِ حَسَنَهْ",70,"ن",2,0],["باطلةً كأنّها","هناك من محقِّقِ",71,"ق",1,0],["بِأَطيبَ مِنْ أَردانها حينَ أَقبلتْ","وغضُّ النَّقا في دِرْعها يترنَّحُ",72,"ح",1,0],["باطلةٌ روّتْ لنا غُلَّةً","والحقّ لم يأتِ بمطلوبِ",73,"ب",1,0],["باطل أيْ عدم قدَّره","فهو تقدير هناك وهنا",74,"ن",2,0],["باطل منعدم","وله الحق لقط",75,"ط",1,0],["باطن الباطن ظاهرْ","ظاهر الباطن قاهرْ",76,"ر",1,1]]}