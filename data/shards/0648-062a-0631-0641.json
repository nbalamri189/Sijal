ي العشق","https://www.poetsgate.com/ViewPoem.aspx?id=213903",""],[4797,"فرقا شهيد الدين","https://www.poetsgate.com/ViewPoem.aspx?id=180556",""],[4979,"جَنّةُ الرّيحان","https://www.poetsgate.com/ViewPoem.aspx?id=176551",""],[5050,"ألا دع خلة الكاس","https://www.poetsgate.com/ViewPoem.aspx?id=38215",""],[5064,"دروب التّائهين","https://www.poetsgate.com/ViewPoem.aspx?id=200051",""],[585,"هي لفتةٌ أوحت إلي الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=161932",""],[585,"نثلت لك الكنانة في العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=161849",""],[5121,"رَيَّانَةُ الدِّبْسِ / إبنتي حنين","https://www.poetsgate.com/ViewPoem.aspx?id=49548",""],[5147,"إن الحياة وإن تمادى عمرها","https://www.poetsgate.com/ViewPoem.aspx?id=166745",""],[5155,"الى معجزة الغناء العربي (ام كلثوم)","https://www.poetsgate.com/ViewPoem.aspx?id=176242",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[5320,"دموعى عليك حفيظ دماء","https://www.poetsgate.com/ViewPoem.aspx?id=43104",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5491,"صلى عليك","https://www.poetsgate.com/ViewPoem.aspx?id=215281",""],[5493,"يشق الصبح صدر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=201676",""],[5536,"إمرأة من تمثال..!!","https://www.poetsgate.com/ViewPoem.aspx?id=19892",""],[5550,"إذا شئْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211314",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5776,"سرةٌ تبلعُ ذقنَ المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=199337",""],[5804,"جلسة على الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=193678",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5829,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180642",""],[5910,"ما زال طيفُكِ بالسَّحَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=206869",""],[5918,"طَوى الآفاقَ","https://www.poetsgate.com/ViewPoem.aspx?id=54708",""],[5943,"أرى الأيام تكرم كلَّ وغدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=34670",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5977,"لها في خافقي ركن شديد","https://www.poetsgate.com/ViewPoem.aspx?id=213902",""],[6032,"عهود الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181520",""],[6070,"تُعلِّمهُ الأَيامُ معنى قوافيا","https://www.poetsgate.com/ViewPoem.aspx?id=188645",""],[6070,"رَكبتَ هواكَ ألوانَ الرُّكوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=189129",""],[6102,"ساق !!","https://www.poetsgate.com/ViewPoem.aspx?id=184410",""],[6210,"ألق السلام على القباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78228&r=&rc=20",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[572,"ومَلْعَبٍ للخيلِ في قراحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9209&r=&rc=66",""]],"verses":[["وَتَرَفَّق بِالجُندِ فَالجُندُ آبا","ؤُكَ إِن صَحَّ أَنَّكَ اِبنُ عَساكِر",0,"ر",1,0],["وتَرَفَّقي أَمَلي فَقَد","كَلَّفتِني مَالاَ أُطِيق",1,"ق",1,0],["وترفُض مني كل عيش منعَّم","إذا ازوَرّ ذاك العيش بالذلّ جانبا",2,"ب",2,0],["وتَرَفّقِ إذا جهدت فإن الر","فق يُذكي الفؤاد والعُنف يُعمي",3,"م",2,0],["وَتَرفَعُنا عَلَيكَ إِذا اِفتَخَرنا","لِيَربوعٍ بَواذِخُ شامِخاتِ",4,"ت",1,0],["وتُرْفَدُ الخيرَ من جدودك أو","يُلْقَى بك النَّسْبُ صاعداً أُدَدَكْ",5,"ك",1,0],["وَتَرفِدُهُم أَبناءُ حَنظَلَةَ الذُرى","حَصىً يَتَحَدّى قِبصُهُ كُلَّ فاتِكِ",6,"ك",1,0],["وَتَرفَع عَينَيكَ نَحوَ السَماءِ","وَلَيسَت تُبالي وَلا تَحفِلُ",7,"ل",1,0],["وتُرفّرفُ الأَفراحُ فوقَ","رؤوسنا أَنَّى نَسيرْ",8,"ر",1,0],["وَتَرٌ في اللَهاةِ ما لِلمُغَنّي","مِن يَدٍ في صَفائِهِ وَلِيانِه",9,"ن",2,0],["وَتَرفُلُ في مَلحَماتِ العِرا","قِ وَتَرفُلُ في حُلَلِ المَغرِبِ",10,"ب",1,0],["وَتُرفَعُ أَجسادٌ وَتُنصَبُ مَرَّةً","وَتُخفَضُ في هَذا التُرابِ وَتُجزَمُ",11,"م",1,0],["وَترفسها من غير ذنب برجلها","وَتوجع ضرباً بالعصا وَهيَ تصبر",12,"ر",1,0],["وترفُّ منه على ثغورِك قبلةٌ","أصغى النسيم لها وغضَّ حياءَ",13,"ا",2,0],["وترفُ روحي فوق أنفاسِ الرُّبا","فلعلّها نَفَسُ الحبيبِ الزائرِ",14,"ر",1,0],["وتَرُفُّ الشُّجونُ من حول قلبي","بسُكونٍ وَهَيْبَةٍ وقُطوبُ",15,"ب",1,0],["وَتَرَفَّقْتُ بِالْفُؤَادِ وَلَكِنْ","غَلَبَتْ لَوْعَةُ الصَّبَابَةِ رِفْقِي",16,"ق",2,0],["وَتَرَفَّقِي بِمُتَيَّمٍ عَلِقَتْ بِهِ","نَارُ الصَّبَابَةِ فَهْوَ ذَاكِي الأَضْلُعِ",17,"ع",1,0],["وترفعُ صدراً كانَ حِصْناً وموئِلاً","لمصرَ فأغناهَا عن الحصْنِ والأطَمِ",18,"م",1,0],["وترفّعت عن 'رادتك البل","ها ورضت الجناح أغزو السما",19,"ا",1,0],["وترفعها عجلى وعجلى تحطّها","لعوب من الأمواج جدّ لعوب",20,"ب",1,0],["وترفّ إن حمى الهجير غمامة","وندى وظلاّ في الهجير ظليلا",21,"ل",2,0],["وترفّعت عن إرادتك البل","ها ورضت الجناح أغزو السما",22,"ا",1,0],["وترفّ منك على ثغورك قبلة","أصغى النّسيم لها وغضّ حياء",23,"ا",2,0],["وَتَرفل في ثِياب الكبر تعساً","لِمثلك قَد عَريت مِن المَعالي",24,"ل",2,0],["وترفعني اكف العون حتى","يحير لذلك السر اللئام",25,"م",1,0],["وترفق لطفا بحالي فاني","فتكت بي ظباء تالت البوادي",26,"د",2,0],["وترفقي بي واذكري ما يعتري","قلبي من الهيمان والتذكارِ",27,"ر",1,0],["وترفُلُ في جَلاَبِيبِ المَساوي","مُوَّشَحةً بِتَنمِيقِ الحَرَامِ",28,"م",1,0],["وَتَرفاً إِلى غَيرِ الفَضائِلِ مارَنا","وَسَمعاً إِلى غَيرِ المَحامِدِ ما صَبا",29,"ب",2,0],["وترفَّقْنَ بصبٍّ مُدْنفٍ","يتلظى قلبهُ كالقبسِ",30,"س",1,0],["وترفضون طاهر الأعراق","الشاعر الحنذيذ عبد الباقي",31,"ي",1,0],["وترفّق بمحبٍّ","يا حبيبي وتدارك",32,"ك",1,0],["وترفُلُ من فولاذِها وحديدها","بأمتنِ درعٍ أو بأشرفِ لبسة",33,"ه",1,0],["وَتَرفَعُ صِبياناً عَلَينا كَأَنَّهُم","مَشايِخُ عِلمٍ في النَدِيِّ تَصَدَّروا",34,"ر",3,0],["وَترفعُ الوَضيعا","وَتكرمُ الشَفيعا",35,"ع",2,0],["وترفّق يا قبر إن كنت جوعا","نَ فمنّا الطعامُ والإطعام",36,"م",1,0],["وَتَرفَعُ جِلباباً بِعَبلٍ مُوَشَّمٍ","يَكُنُّ جَبيناً كانَ غَيرَ مُشَجَّجِ",37,"ج",1,0],["وترفَّعت بك شيمة علويَّة","لم ترضَ إلاَّ بالمحلِّ العالي",38,"ل",2,0],["وترفع بغرفات الجنان مخلدا","بدار نعيم عيشها لن يكدرا",39,"ر",2,0],["وترفع عني الحجب في كل مشهد","فأحظى بجنة المعارف دانيه",40,"ي",2,0],["وترفّعَتْ بي همّتي عن مِدحةٍ","لسِوى جَنابِ أبي الحُسينِ العالي",41,"ل",2,0],["وترفق عندما","قبلاً تمطرُها",42,"ه",2,0],["وَتَرفَّعَ النِسرانِ هَذا باسِطٌ","يَهوي لسقطَتِهِ وَهَذا كاسِرُ",43,"ر",1,0],["وترفُلُ في مُصْمَتٍ أبْيَضٍ","تَلَوّنَ من خَدِّهَا الجُلَّنَارِي",44,"ر",2,0],["وترفَّقْ بهِ فإِنكَ تُسْدِي","مِنَّةً جَمَّةً إِلَى الْعَلْياءِ",45,"ا",2,0],["وَتَرفع مَخفوضاً وَتَخفض راقِياً","وَتَسطو عَلى الأَخيار مِنا بِلا رفق",46,"ق",1,0],["وَتَرفَع مَخفوضاً وَتَخفض راقِياً","وَتَسطو عَلى الأَخيار في الهَزل وَالجَد",47,"د",1,0],["وَترفل بَين الحُور في حلل الرضا","بِدار نَعيم دائم وَسُرور",48,"ر",1,0],["وَترفل في بُرد المَعارف فَتيةٌ","بِتعليمها وَجه المَكاتب باسم",49,"م",1,0],["وترفقاً أحيا به أم قسوة","بالصبِّ تُشمِتُ حاسداً ورقيبا",50,"ب",2,0],["وترفقوا بنفوسكم فضلالكم","ساع إلى تدميركم ببلائه",51,"ا",3,0],["وترفلُ في ثيابِ الخزْ","زِ قُمصٍ غيرِ أطمار",52,"ر",1,0],["وترفعت عنا ارتفا","ع الأكبرين على الأصاغر",53,"ر",1,0],["وترفِدُني الاراقمُ كلَّ رفدٍ","وشيبانُ بنُ ثعلبةًَ القرومُ",54,"م",1,0],["وترفلوا في زيّ أبّهة وفى","حلل من النفحات والإمنان",55,"ن",1,0],["وترفل في رداء التيه لما","قلت بيد السرى قود السحاري",56,"ر",2,0],["وترفع الأنذال من أخلاقه","وكذا القرين يراعى كل قرين",57,"ن",1,0],["وترفقوا فؤاد صب زاده","يوم الرحيل على هواه تولعا",58,"ع",2,0],["وترفل من ثوب الشبابا بصحة","ولكنها في لوعة المتألم",59,"م",1,0],["وترفع بل تحظى بحسن كرامة","وفي الدنيا والاخرى بخير تدثر",60,"ر",1,0],["وترفع أعلام الهداية والولا","يوالى واسباب السلامة تكثر",61,"ر",1,0],["وترفع أعلام الولاية للملا","وتهدي إلى حسن الكمالات والجذب",62,"ب",1,0],["وترفرق المهج الغوالي حولها","في مهدها لتصونها وتقيها",63,"ي",3,0],["وترفع لي إما ضللت على السرى","قباب لكم فوق السها وخيام",64,"م",1,0],["وترّفعوا عن كلّ قصدٍ سافلٍ","وتمسّكوا بفضائل الأقوام",65,"م",1,0],["وَتَرفَعهُ يَوماً إلَى صَدرِ مَوكِبِ","وَتَنطبهُ طَوراً بِسَوح أبي حَسلِ",66,"ل",1,0],["وترفل في خز المعاني كأنها","فتاةٌ لدى الأتراب بالخز ترفلُ",67,"ل",1,0],["وترفع من اركانها كل ما وهي","وتعمر من اوطانها كل ما دثر",68,"ر",1,0],["وَتَرَفَّقْ بِأُمَّةٍ جَعَلَتْ حُ","بَّكَ دِيناً لنا وَوَجهَكَ قِبلَه",69,"ل",2,0],["وترفق بها فما هي إلا","شمعة في مرابعي وقاده",70,"د",2,0],["وترفعوا عن قدر كل مموه","وممول ومدهم وممخرق",71,"ق",1,0],["وترفَق في فؤادِ لم يزَل","فيكَ عانٍ ولجسمٍ قد خَفى",72,"ف",2,0],["وَتَرفَعُ الصَوتَ أَحياناً وَتَخفِضُهُ","كَما يَطِنُّ ذُبابُ الرَوضَةِ الهَزِجُ",73,"ج",1,0],["وترفع اعراف البخور وسيلةً","إلى خالق الاكوان فواحة النوشر",74,"ر",1,0],["وترفع بالاقدام مجدك شامخاً","وتبطل بالتحقيق كذب المنجم",75,"م",1,0],["وتَرْفُل في وشْيٍ إِذا اشتاق لمسَها","تظلَّمَ من أَرْدافها ونُهودِها",76,"د",3,0],["وترفقي بحشا شتى فأنا الذي","ما كنت أعلم ما الهوى لولاك",77,"ك",1,0],["وترف شوقاً كي تطير لهم","بجناح نور منك مؤتلق",78,"ق",1,0],["وترفقوا بالقلب فهو أسيركُم","وله عليكُم حق حسنِ ودادهِ",79,"د",2,0],["وترفع ناباها صريفَ ابنِ بَكرة","على الرسّ لم يمسس جميلٌ نِخَاسَها",80,"ه",2,0],["وَترفّقي بثرى حمى","أَمسى الرفاق به حلولا",81,"ل",2,0],["وَتَرفل في بَرد المَسَرّة مَصره","وَتُسفر عَن وجه السُعود بِأَسعد",82,"د",1,0],["وَتَرفّعتِ اِمتِناعاً","عَن حلى الدُرِّ المَشوقَه",83,"ق",2,0],["وترفقوا تحت الثرى بعظامه","لا تحسبوا تلك العظام جمادا",84,"د",2,0],["وترفعني على شعراء مصر","أراني عند هضبتهم ضئيلا",85,"ل",2,0],["وترفع بالمكارم في ذراها","بروجاً من خلال المجد تبنى",86,"ن",2,0],["وترفع فيه عهدها بمحبة","لحضرة قدسٍ عندها قدرك الأسمى",87,"م",2,0],["وترفق في كل امرك فالرف","ق جميل وبالملك اجمل",88,"ل",1,0],["وَتَرفَعَ مِن حُجبِهَا فَتَرَى","وَتَحظَى بِقُربٍ وَتأمَنَ بُعدَا",89,"د",2,0],["وترفل في ثياب العز حتى","يراك أبوك في حال رضيه",90,"ي",2,0],["وترفعنْ قدريَ في الأيامِ","وتولينِّي الحبَّ في الأنامِ",91,"م",1,0],["وترفع لي الحدوج مكللات","بحسن وسامة منهم وسام",92,"م",1,0],["وَتَرِفُّ في دِهليزِ كُلِّ أَشِعَّةٍ","قَمراءَ أَو تَرنيمَةٍ بَيضاءِ",93,"ا",2,0],["وَترفقن بي عاذراً قصري وَدُم","بالعزّ يا مَن لَم يَزل يَترفَقُ",94,"ق",1,0],["وَترفعُ ناظريها للأَعالي","وَتقرعُ بابَ مَولاها الرَحيمِ",95,"م",1,0],["وَترفل تيهاً في مَطارف حُسنِها","وَبِالغَنجِ تَجلو عَن نَديم مكدرا",96,"ر",2,0],["وترفع في أوج العوالي رؤوسها","فتخسف في أوج السما كل شارق",97,"ق",1,0],["وَتَرف في وَجه الحَيا","ة وَبَينَ طَيّات السِنين",98,"ن",1,0],["وترفَّق بها فَفي حِلَّة القَو","مِ رَشاً لابِسٌ منَ الحُسنِ حُلَّه",99,"ل",2,0],["وترفق بمُهجة فيك ذابت","بينَ نار الغرام والتَفنيد",100,"د",1,0],["وترفَّعَت همَمي فما أرضَى سوى","شُهبِ الدُّجى عِوضاً من الخِلاَّنِ",101,"ن",1,0],["وترفقي في الشجو دونك موجع","أضناه فرط السقم حتى لا يعي",102,"ع",2,0],["وترفع للدين اعلامه","ويعتز من كان قبل ذليلا",103,"ل",2,0],["وترفق بمعنى طالما","ناح حتى علم النوح الحماما",104,"م",2,0],["وترفض الوصل قطعًا كي تجرّعه","كأس المرارة في كأْسٍ من التيهِ",105,"ي",2,0],["وترفع بالأكفِّ لها دعاءً","وأنت بِما حُبِيتَ لها مجيب",106,"ب",1,0],["وتُرفع بالدعاء بكل حينٍ","لمن في درب حُبِّهِمُ يسير",107,"ر",1,0],["وترفع بالدعاء لهم أكفاً","وتجتاز الحواجز والحدودا",108,"د",2,0],["وترفعُ جفنَها مِن غيرِ غمضٍ","كعُضوٍ قد ألمَّ به الكساح",109,"ح",1,0],["وترفع لك البيضا ع كل الاقطار","( يا راس حربة جيش درع الجزيره)",110,"ر",2,0],["وترف أنسامُ الأصائلِ فى الدُّنا من أجلنا","ويُقَطِّرُ الغيمُ الغنىُ مِياهَهُ من فوقنا",111,"ن",2,0],["وترفع في مجالسهم","على العينين والرأس",112,"س",1,0],["وترفَعُ سالِفَ الذّكرَى حُدَاءً","ليَنبُتَ بينَ أيدِي الحاصِدِينْ",113,"ن",1,0],["وترف في القد الرشيق تبخترا","وتشع في الخد الأسيل توردا",114,"د",2,0],["وترفع شأن كل فتى تراه","إذا عدت النوازل ليث غاب",115,"ب",1,0],["وَتَرْفِلُ عِطْرَ الْوَرْدِ جُورِيَّةَ الْهَوَا","فَتَحْتَفِلُ الأَثْوَابُ فِي نَشْوَةِ الْمَلْسِ",116,"س",1,0],["وترفعي للعالم الأعلى وذا","سير تقاصر دونه الأفهام",117,"م",1,0],["وتر في اللهاة غال نقي","يتحدى البلور والعقيانا",118,"ن",2,0],["وترفدُنا تلكَ الحكاياتُ أنَّنا","لنا من طروسِ الفخرِ في قصةٍ رفدُ",119,"د",1,0],["وَترْفعُ (فيَومَ مِصْرَ) التَّعازِي ... إلى (آلِ غَسّانَ).. جلَّ العَزاءْ","تَوارَى عَن الأُفقِِ نَ