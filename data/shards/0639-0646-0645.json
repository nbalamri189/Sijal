90295",""],[5791,"ميقات نرد ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208602",""],[5809,"مراض","https://www.poetsgate.com/ViewPoem.aspx?id=205099",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[5910,"طال عهدُ السُّهادِ","https://www.poetsgate.com/ViewPoem.aspx?id=206274",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5956,"إن كان عبد الله أصبح ساليا","https://www.poetsgate.com/ViewPoem.aspx?id=194611",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[161,"إحْصَاءُ عَامِ قَدْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""],[6089,"مالئ الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213900",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[6277,"بوركت الأعمال والجهود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64483&r=&rc=46",""],[2220,"ما إنْ علمتُ بأمرٍ فيهِ منْ عددٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11338&r=&rc=212",""],[6308,"انكسارات آخر الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87730&r=&rc=8",""]],"verses":[["عَن مُبِلٍّ مِنَ الجَوى","راجَعَ الداءَ فَاِنتَكَس",0,"س",1,0],["عَن مَشهَدي بِبُعاثَ إِذ دَلَفَت لَهُ","غَسّانُ بِالبيضِ القَواطِعِ وَالقَنا",1,"ا",1,0],["عَنْ مُغْرِقِ العَالِمِ فِي بُؤْسِهِ","وَمُغْرِقِ الجَاهِلِ فِي سَعْدِهِ",2,"د",2,0],["عن مدمعِي وندى كفّ الأمير ألا","حدث عن البحرِ يا رائيه بالعجب",3,"ب",1,0],["عن مثله نكص الهجاء مقهقِراً","ونَبَتْ سيوفُ الشتم وهي حِدادُ",4,"د",1,0],["عن مصبِّ الحَيَاةِ أَيْنَ مَداهُ","وصميمِ الوُجُودِ أَيَّان يُرسي",5,"س",2,0],["عَن مُستَقِرٍّ في مَراتِبِ مَجدِهِم","في بازِخٍ نائي المَحَلِّ بَعيدِهِ",6,"د",2,0],["عَن مُكثِرٍ مِن سيبِهِ لَكَ لَو جَرى","مَعَهُ الفُراتُ لَقَلَّ في إِكثارِهِ",7,"ر",2,0],["عَن مَنبِتِ الوَردِ المُعَصفَرِ صِبغُهُ","في كُلِّ ضاحِيَةٍ وَمَجنى الآسِ",8,"س",1,0],["عَن مَبيتِ لَيلَةٍ ما تَسمَح بِقُبلَه","لا عَدِمنا مِنكَ هَذي السَماحَه",9,"ه",1,0],["عن مقفرٍ ليس فيه","غيرُ التماعِ الآلَ",10,"ل",1,0],["عَن مِثلِ نَصلِ السَيفِ إِلّا أَنَّهُ","مُذ سُلَّ أَوَّلَ سَلَّةٍ لَم يُغمَدِ",11,"د",1,0],["عَن مِثلِ زافِرَةِ الرِتاجِ أَجافَهُ","مِن بَعدِ أَوَّلِ فَتحِهِ بَوّابُهُ",12,"ب",2,0],["عن مكانٍ من العيون مصونِ","فيه يحمي جلاله أن يهانا",13,"ن",2,0],["عَن مُبرِقاتٍ بالبُرينَ وتَب","دُو بالأَكُفِّ الَّلامعِاتِ سُوُر",14,"ر",1,0],["عَن مِصْرَ نَاءَ وَهْوَ فِيهَا","إِنَّ شَرَّ النَّأْيِ ذَاكْ",15,"ك",1,0],["عَن مَثاني العودِ يثني النَدامى","إِن تَغنّي بِمَثاني الوَحِيِّ",16,"ي",1,0],["عن مدار النجوم وهي وعيد","عن فم الغيب أو بريق المواعد",17,"د",1,0],["عن مماتي : وردة تحكي ، وعن","مولدي في الموت تنبي سوسنه",18,"ن",2,0],["عن من تعادي؟ كل من تجتبي","ملوا نضالاً، والعدا أنهكوك",19,"ك",1,0],["عن مصرعٍ في المجلِسَين لأجلهِ","وهما البلادُ بأسرِها إِضراب",20,"ب",1,0],["عَن مُستَقَرٍّ في مَرَاتبِ مجْدهمْ،","في باذِخٍ، نائي المَحَلّ بَعيدِهِ",21,"د",2,0],["عَن مَعانٍ تَكسو المَناقِبَ أَفوا","فَ ثَناءٍ أَبقى مِنَ الأَفوافِ",22,"ف",1,0],["عن مثل عقد الدر يفتر فما","ان لم يهم في حبه مثلي فمن",23,"ن",1,0],["عن مجدِنا وملوكِ أهلِ الأرض","هلا نَكّسوا الأعلامَ والتيجانا",24,"ن",2,0],["عن مهجتي وضلوعي","روى سعيرُ الوجود",25,"د",1,0],["عن مَشُوق نحوَه قِلقٍ","ماله عن ذكره صَدَر",26,"ر",1,0],["عَن مَجمَعي فِرقُ الغُواةِ تَفَرَّقوا","وَلِتُربِهِ أَهلُ الرَشادِ تَوَسَّدوا",27,"د",3,0],["عَن مُهجَةٍ بالهجرِ قَد","تَلِفَتْ وعَينٍ جَارِيَه",28,"ي",2,0],["عن مليحٍ صَرَّحَتْ عنه الكنى","توبة في حبّه لم تُقْبَلِ",29,"ل",1,0],["عن مُسْلمٍ ضَحَّى بِهِ غاوٍ وَعَن","نَفْسٍ حرامٍ والعُداة تَصيدُها",30,"د",3,0],["عن مثل هذا مصدري","ضحى ومن هذا نزوعي",31,"ع",2,0],["عن مغرمٍ دَنِفٍ بَرَى","تَذكارُ قربهمُ عظامَه",32,"م",2,0],["عَنَّ مِنه تَزايُدٌ","لَم يَجُل قطُّ في خَلَد",33,"د",1,0],["عن مِشيتي وَخَبَبِي وشدِّي","فإنّني لحاضرٌ بِوُدِّي",34,"د",2,0],["عَن مُدلَجٍ قاسى الدُؤوبَ وَالسَهَر","وَخَدَرَ اللَيلِ فَيجتابُ الخَدَر",35,"ر",1,0],["عَن مِثلِ عَلياهُ كَفُّ الدَهرِ قاصِرَةٌ","وَأَعيُنَ السُخطِ مِن حُسّادِهِ حولُ",36,"ل",1,0],["عَن مائِهِ الصّافي النَّميرِ وِظِلِّهِ","الضّافي الظَّليلِ وَطَلِّهش المُتَرَقرِقِ",37,"ق",1,0],["عن مثله أخذٌ أو منه مكتسب","فعلمه منه تظنين وتقليد",38,"د",1,0],["عَن مَصر كُلَّ لَئيمِ","وَيَقتدي بِحَماسِهْ",39,"ه",1,0],["عَن مَدح إِبراهيم أَل","سنةُ الوَرى تَتقاصر",40,"ر",1,0],["عَن مَهرَجان ختانه","زهواً تَلوح مَفاخر",40,"ر",1,0],["عن مُغرَمِ شفّه كتمانُ حُبِّكُمُ","فدمعُه في مجاري الجفن لم يَقَفِ",41,"ف",1,0],["عَن مَلِكٍ شاهَدَ سرباً مِن غَنَم","وَفَوقَهُم راع أَجادَ مُذ حَكَم",42,"م",1,0],["عن معلمي يُتحقق الإعلامُ","صدقاً فيقدرُ قدره الأعلامُ",43,"م",1,1],["عن ملوكٍ دوّخوا الأرض عُلاً","بسطوا النفع عليهَا والضررْ",44,"ر",1,0],["عن مطلع الحسن","غني به غني",45,"ي",1,0],["عن معان قضت بوصف اختبار","وشؤون قضت بحسن اختيار",46,"ر",1,0],["عَنْ مِثْلِ فَضْلِكَ تَنْطِقُ الشُّعَراءُ","وَبِمِثْلِ فَخْرِكَ تَفْخُرُ الأُمَرْاءُ",47,"ا",2,1],["عن مثلِها ما انشقَّ يوماً ثرى","نبوَّةٍ فاسأل سجاياها",48,"ا",3,0],["عن مالكينا","هل قابِلونا",49,"ن",2,0],["عن مثل ذا داود عنه نبا","قد أكلوا خبزي وداروا العقبا",50,"ب",2,0],["عن مصرعِ الدينِ والدنيا وما وسعا","لعمرُ صَرْفِ الليالي إنّهُ لجري",51,"ر",2,0],["عن مزار الحبيب إذ شحط البي","ن وحرب تشب للغلفاء",52,"ا",2,0],["عَن مُزنَةٍ وَعَنِ الرَبابِ سَقاهُما","وَسَقى المَنازِلَ مُزنَةٌ وَرَبابُ",53,"ب",1,0],["عن ماجلٍ طافحٍ بالماء معتلجٍ","كأن نُغْبَتَهُ صيغت من الحدق",54,"ق",1,0],["عن معشرٍ في الدين قد حَلَّلُوا","ما هو بئس الكَدْح للكادِحِ",55,"ح",1,0],["عن مشمخر العلا دانت لعزَّته","صيد الملوك بترغيب وترهيبِ",56,"ب",1,0],["عن من إلى من وفي من فاستعدّ له","إن الإمام الذي يهدي إلى الرشد",57,"د",1,0],["عن معاني ثغرها البرقُ حكى","سيرةً عنها سلوا الدرَّ النضيدا",58,"د",2,0],["عن مُجتنى نبعهِ الزاكي منافعُه","أشجى البريَّةِ طُرا وقعةٌ وقعت",59,"ت",1,0],["عَن مُستفيدٍ يَهتَدي بنظمي","إنّيَ قَد نَظَمتُهُ بعلمي",60,"ي",1,0],["عَن مَغرِبِ الحِمَارِ ثُمَّ العَقرَبِ","إلى سُقطرَه ثُمَّ أُدنُ وَآقرُبِ",61,"ب",1,0],["عَن مَغرِبِ السُّهَيلِ نِعمَ المَجري","لِحَدَّ وَاسِيني وَذَاكَ المَعبَرِ",61,"ر",1,0],["عن مضجعي قد تجافى","جنبي ومهد جنبك",62,"ك",1,0],["عن مُدية كان فيها قطعُ مدّته","فوافق الحرث موفوراً كما حرثا",63,"ث",2,0],["عن ملامي","كانَ قبلَ الملام حُبّي",64,"ي",1,0],["عن مثل ما أهديته سل هل أدي","بٌ دوَّنا شعراً بديع بيان",65,"ن",1,0],["عن مثل الشيخ مضى فرحاً","وعلى مثلي ذا أحزاني",66,"ن",2,0],["عن مصرَ ما كان احتجبْ","في شهره السامي بَدا",67,"د",2,0],["عن مبهمات العلم فيه كشف","اللّه الغطا لخلقه والحجبا",68,"ب",2,0],["عن مقام المصطفى عترته","عزلت فاغتدت الناس حيارى",69,"ر",2,0],["عن مزاياهم سل المحراب وال","حرب والعرب والخيل العرابا",70,"ب",2,0],["عن مسلم وهو ما أدى شهادته","وكافر وهو لا والله ما كفرا",71,"ر",2,0],["عن مأكل يسد فيه الجوعا","من قبل أن يغدو به صريعا",72,"ع",2,0],["عنْ معالينا وعنْ احسابنا","ووفانا وسخانا والهِممْ",73,"م",1,0],["عن معجزات المصطفى حدث ولا","حرج وقل وردت بها الأنباء",74,"ا",2,0],["عن محض ود رائق التصافى","من بعد طول البعد والتجافى",75,"ف",2,0],["عن محب يزداد فيه ولوعا","فيه ما مر بين سميعه عذل",76,"ل",1,0],["عَن مَضجعه قامَ إِلى النَدمانِ","وَالصُبحُ بريدُ ضَوئِهِ وافاني",77,"ي",1,1],["عن ماجد على العلى منعطف","ذي ساعد إلى التقى مشمر",78,"ر",1,0],["عن مشبهٍ في صفاتٍ أو نظيرٍ له","في الذات والفعل أو في سائر الصور",79,"ر",1,0],["عن منزل متهيء لتنزل","وإنزل من العليا بدارة جلجل",80,"ل",1,0],["عن موجه العالي طويت الشراعي","وماني على كثر الاصاحيب طماع",81,"ع",1,0],["عن ما بقى بالواقع المحسوس","شربت من كوس المدامة كاس",82,"س",1,0],["عَن مَوْطِنٍ كالثَّوْبِ تُلْقِي بهِ","مَجنُونَةٌ لِلقَادِمِ اللَّاهِثِ ؟!",83,"ث",1,0],["عَن مَوْطِنٍ كالثَّوْبِ تُلْقِي بهِ","مَجنُونَةٌ كَسلَى إِلى اللَّاهِثِ؟!",84,"ث",1,0],["عَن مَبسِمٍ أَشهى إلى المُشتاقِ","مِن طَعمِ \"العَرِيكَة\"",85,"ك",2,0],["عن مثل ما أهديته","سل هل أديب دونا",86,"ن",2,0],["عن موعدٍ قادمٍ ما حان تسألني","أو عن دواءٍ جديد ليس يُحتمل",87,"ل",1,0],["عن ما يلدّ الهجس بلحون طاروق","ملهود مجرود السنود انسعربه",88,"ب",2,0],["عن ماجلٍ طافحٍ بالماء مُعتَلِج","كأنّمَا نَفسُهُ صيغَتْ مِنَ الحَدَقِ",89,"ق",1,0],["عن موعد لقطار في محطته","مات النذير وراح الصمت يقتله",90,"ل",2,0],["عن مفلح الكايد وحفظ المواجيب","ما له مثيل وغير عن كل جيله",91,"ل",2,0],["عن مقلتي لا تختفي يا ناظري","إنْ غبْتَ باتَ القلبُ لحْدًا باكيا",92,"ي",2,0],["عن مستهام طوته في خواطرها","مغازل الحب لما بات يطويها",93,"ي",3,0],["عن مبسم هام فيه الأقحوان به","عن غرة ظل قرص الشمس يغريها",93,"ي",3,0],["عن معز الدين مجدا ورثوا","نيراً أربى على الشمس احتقارا",94,"ر",2,0],["عن منهج التحقيق حتى إنه","لا يهتدي نحو الطريق اللهجم",95,"م",1,0],["عن مثله في الورى أم العلى عقمت","لكن به وأبيه حملها نتجا",96,"ج",2,0],["عَنْ مُعرِقٍ دَأَبَ الحَيَاةَ مَكَارِمَاً","عَفَّ الهَوى تَحتَ الفَضا المُتَحَطِّمِ",97,"م",1,0],["عن ما مضى، عن ما جرى، عن لحظةٍ","عصف الزمانُ بقدرةِ استيعابي!",98,"ب",2,0],["عن مثل حسنك في الهوى","هيهات ما مثلي صبور",99,"ر",1,0],["عن مجد آباء لنا","درجوا فليتهم حضور",99,"ر",1,0],["عن مذهبه خلك على راس ما طال","وخله على فاله يشم المغاريب",100,"ب",1,0],["عن من نوده بالفراق ابعدتها","الأمر لله والمقادير عجلات",101,"ت",1,0],["عن منارة كل بيت وكل حاره","عن خسارة كل دار وكل ديره",102,"ر",2,0],["عن مخرجٍ يروي مشاهدَ موته","عن راحتينِ عليهما القدرُ اشتغلْ",103,"ل",1,0],["عن مصرا إذ نعوه لها","وجمت من شدة الخطب",104,"ب",1,0],["عن مصر أو بغداد مهلك لا تسلْ","وعن الشآم عن السلام إذا اضمحلّْ",105,"ل",1,1],["عن موعدٍ للموت عن شفةٍ","مُسْمَرّةٍ سَكَراتُها حشدُ",106,"د",1,0],["عن مِراضٍ أمرَضَتنا نًظًرةً","فيهما الداءُ تجلّى والدوا",107,"و",2,0],["عن متعة تطويه في ملكوتها","عن قصة تعطي الخيال مداه",108,"ا",2,0],["عن مهاةٍ كالشمس أبرَقَ منها","طارقُ الوجدِ في دجى السَّهَرِ",109,"ر",1,0],["عن مِنْبَرٍ غَير الّذي","ملأ المدى كذباً وزورْ",110,"ر",1,0],["عن موطن أعداؤه أبناؤه","آذَوه ما لم يستطعه أعاديا",111,"ي",2,0],["عن ْمن ْأخذت َالحُسن َ قُلْ","هل يوسفٌٌٌ قد كانَ جدَّكْْْ؟",112,"ك",1,0],["22- عَنْ مَغْرِبِ ، عَنْ مَشْرِقِ الشَّمْسِ الَّتِي","أَدَّتْ حُدُودَ العَامِ بالإِتْمَامِ",113,"م",1,0],["عن (مالئ الدنيا) قديما حدّثَ ال","حمقى وقالوا فيه مثلَك نقدا",114,"د",2,0],["عَنْ مَبْدَأيْ سَتَرَانِيْ شَوْكَةً تَمْضِيْ","فِيْ ظُلْمَةٍ قَدْ يَهَابُهَا الصّنَادِيْدُ",115,"د",1,0],["عن ممرٍ أسيرُ فيهِ وعيني","لا ترى في ضُلوعه أيَّ جُندي",116,"د",2,0],["عن مثله الآباء والجدود","ذادوا ومن يقتد بهم يسود",117,"د",1,0],["عنْ منْ لي منْ وفي منْ فاستعدَّ لهُ","إنَّ الإمامَ الذي يهدي إلى الرشدِ",118,"د",1,0],["عن موتِنَا حينما صاحتْ ملائكةٌ","عن الدروب التي نَمْشي بها حتَّى",119,"ت",2,0]]}