https://www.aldiwan.net/poem49753.html","الخفيف"],[408,"إن أكن مذنبا فعفو إلهي","https://www.aldiwan.net/poem49995.html","الخفيف"],[412,"لو كان صد مغاضبا ومعاتبا","https://www.aldiwan.net/poem31986.html","الكامل"],[412,"إن تقطع الأيام منك علائقي","https://www.aldiwan.net/poem32407.html","الكامل"],[432,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[440,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[455,"أربعاء الرماد يا عيد أحزا","https://www.aldiwan.net/poem61392.html","الخفيف"],[455,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[466,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[481,"شاهدته يوم الدفاع","https://www.aldiwan.net/poem36888.html","مجزوء الكامل"],[481,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[484,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[517,"يا من بليغ المعاني من عبارته","https://www.aldiwan.net/poem12044.html","البسيط"],[517,"أيها القارئ إذا مت","https://www.aldiwan.net/poem12157.html","مجزوء الرمل"],[540,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[560,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[560,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[560,"يحبني وأنا المعدوم لم أزل","https://www.aldiwan.net/poem34199.html","البسيط"],[560,"أنا كتاب الله في الناس","https://www.aldiwan.net/poem34436.html","السريع"],[560,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[560,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[560,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[564,"رسالة فاضل وردت فكانت","https://www.aldiwan.net/poem52745.html","البسيط"],[571,"إِن أك مسكيرا فلا أَشرب الو","https://www.aldiwan.net/poem52014.html","السريع"],[577,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[588,"أنا كاس في كيس","https://www.aldiwan.net/poem17755.html","مجزوء الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/198369",""],[779,"","https://poetry.dctabudhabi.ae/diwan/poem/31549","الوافر"],[1020,"","https://poetry.dctabudhabi.ae/diwan/poem/3","الطويل"],[1020,"","https://poetry.dctabudhabi.ae/diwan/poem/12","السريع"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18759","البسيط"],[1020,"يا رب من أسفاهُ أحلامه","https://www.poetsgate.com/ViewPoem.aspx?id=17627",""],[1020,"إنْ أكُ قد أقْصرْتُ عن طولِ رحلة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=5340",""]],"verses":[["إِنّا كَذَلِكَ يا سُهَيَّ إِذ","غَدَرَ الحَليفُ نَقودُ بِالخَطمِ",0,"م",1,0],["أَنَا كَاتِبُ السُّلْطَانِ مَا","طَالَعْتُ قَطُّ كِتَابَ مُسْلِمْ",1,"م",1,0],["إنْ أكُنْ غيرَكُم نظَرْتُ بعَيْني","بعْدَكُمْ يا سَوادَ ذاكَ السّوادِ",2,"د",1,1],["أنا كافِرٌ وسِوايَ فيهِ بِعاذِلٍ","لا يَسْتَبينُ الصِّدْقُ في آياتِهِ",3,"ه",1,1],["أَنا كَالمَنجَمِ تِبرٌ وَثَرىً","فَاِطرَحوا تُربي وَصونوا ذَهَبي",4,"ب",2,0],["أَنا كَالَّذي أَحتاجُ ما يَحتاجُهُ","فَاغنَم ثَوابي وَالثَناءَ الوافي",5,"ي",1,0],["أَنا كَالصَدرِ بِالإِحاطَةِ بِالرا","حِ إِذِ الراحُ كَالضَميرِ اللَطيفِ",6,"ف",1,0],["إِنْ أَكْبَرَتْ فِيهِ المُرُوءةُ خَطْبُهَا","فَالرُّزْءُ العَيْنِ فِي إِنْسَانِ",7,"ن",1,0],["إِنّا كَذاكَ لِمِثلِ ذاكَ نُعِدُّها","تُسقى الحَليبَ وَتُشعَرُ الأَجلالا",8,"ل",2,0],["أنا كالذي هو قائلٌ","في شعره أنا كالذي",9,"ي",1,0],["إن أكن صرت بالبلادةِ فزعاً","إن لفظي كما يقال مسير",10,"ر",1,0],["إن أكتم الحبّ لم تكتم دلائله","وإن أمل لطريق الصبر لم أمل",11,"ل",1,0],["إن أكن أحسن الثنا فيك قولاً","فلقد أحسنت أياديكَ فعلا",12,"ل",2,0],["إن أكن غيرَ مُحسنٍ كلَّ ما تطْ","لبُ إني لَمُحْسنٌ أجزاءَ",13,"ا",2,0],["إن أكن عاطلاً لديك منَ الآ","لاتِ حاشاك أن تجورَ عَثاءَ",13,"ا",2,0],["إن أكن قد أجدتُ نحت قريضٍ","فيكُمُ جادَ ذلك المنحوتُ",14,"ت",1,0],["إن أكن أحسنتُ في مدحكُم","فأخو الإِحسان أولى من رُفِدْ",15,"د",1,0],["أنا كعبة النيك التي نُصبت لهُ","فتلقّ منها حيث شِئت فكَبِّر",16,"ر",1,0],["أنا كفءٌ لكم ومالي عليكمْ","من ظهيرٍ وهل لأقرَعَ مشط",17,"ط",1,0],["إن أكن أبصرت شخصاً مثله","فثيابي في الجوالي صدقه",18,"ق",2,0],["أنا كالبيهقي إن لم أكن مِنْ","هُ مكان القذاةِ من بطن جَفْنِه",19,"ن",2,0],["إن أكُ قد أكسبْتُه سمعةً","وزانه شعري بتزيينه",20,"ن",2,0],["أَنا كَالكَرمَةِ لَو لَم تَغتَرِب","ما حَواها الناسُ خَمراً في الخَوابي",21,"ب",2,0],["أَنا كَالسَوسَنِ لَو لَم يَنتَقِل","لَم يُتَوَّج زَهرُهُ رَأسَ كَعابِ",21,"ب",1,0],["إِن أَكُن أُبعَثُ بَعدَ المَوتِ جُثمانا وَعَقلاً","أَتَرى أُبعَثُ بَعضاً أَم تُرى أُبعَثُ كُلّاً",22,"ل",2,0],["إِن أَكُن في حالَةِ الإِدراكِ لا أَدري مَصيري","كَيفَ أَدري بَعدَما أَفقِدُ رُشدي لَستُ أَدري",22,"ي",1,0],["أَنا كَالصَهباءِ لَكِن أَنا صَهبائي وَدَنّي","أَصلُها خافٍ كَأَصلي سِجنُها طينٌ كَسِجني",22,"ي",1,0],["إِن أَكرَمَتكَ نُفوسُنا في لَيلَةٍ","فَلَكَم قَضَيتَ العُمرَ في تَكريمِها",23,"م",3,0],["أَنا كَالطائِرِ الَّذي اِندَفَقَ السِح","رُ عَلَيهِ فَغَصَّ بِالأَلحانِ",24,"ن",1,0],["إِن أَكُن فِرقَداً فَأَنتُم سَمائيو","أَو هَزاراً فَأَنتُمُ بُستاني",24,"ن",2,0],["أَنا كَما شاءَ الهَوء وَالصِبا","وَهيَ كَما شاءَت أَمانيها",25,"ي",3,0],["أَنا كُلّي لَكُم تُرى","سادَتي أَنتُمُ لِمَن",26,"ن",1,0],["انا كالرحمة منبو","ذ وكالحق غريب",27,"ب",1,0],["إِن أَكُن مُعجَباً فَعُجبُ عَجيبٍ","لَم يَجِد فَوقَ نَفسِهِ مِن مَزيدِ",28,"د",1,0],["إن أكُن قبلَ أن رأيتُكَ أخطَأ","تُ فإنّي على يديكَ أتوبُ",29,"ب",1,0],["إِن أُكَلِّفهُ حاجَةً لا يُواكِل","جَدُّهُ دونَها وَلا تَشميرُه",30,"ر",2,0],["إِن أَكُن حُبتُ في سُؤالِ بَخيلٍ","فَبِكَرهي ذاكَ السُؤالُ وَرَغمي",31,"م",2,0],["إن أكن قد كويت لحم بلادي","فمن الكي قد يجيء الشفاء",32,"ا",2,0],["إن أَكسُكُمْ من مدائحي جُنَناً","فإنَّ لي أسهُماً تُمَزِّقُها",33,"ق",3,0],["إِن أَكُن في تَأَخُّرِ السَعيِ قَصَّر","تُ فَفَرضُ المُسافِرُ التَقصيرُ",34,"ر",1,0],["إِن أَكُن قَد جَنَيتُ في السُكرِ ذَنباً","فَاِعفُ عَنّي يا راحَةَ الأَرواحِ",35,"ح",1,1],["أنا كالخيروزِ صعبٌ كسرُهُ","وهْوَ لدْنٌ كيفما شئتَ انفتلْ",36,"ل",1,0],["إنْ أكنْ في حلبٍ كاسداً","إنَّ لسوقي في سواها مقامْ",37,"م",1,0],["إنْ أَكُ براً فأنا فاجرٌ","بجرِّيَ الشوكَ إلى الوردِ",38,"د",1,1],["إِن أَكُن قَد سَأَيتُكُم فَلَكِ العُت","بى وَهانَ الَّذي سَأَلتُ وَقَلّا",39,"ل",2,0],["إِن أُكرِهِ الطَرفَ يَحسِر دونَ غَيرِكُمُ","وَلَستُ أُحسِنُ إِلّا نَحوَكِ النَظرا",40,"ر",2,0],["أن أكْرِموا رُسلِي الذين تَرَوْنَهم","يرجون فضلَ الله عِندَ ديُونهِ",41,"ه",1,0],["إِن أَكُن مُسرِفاً بِلَومي فَلومي","صادر عَن مَحَبتي القَلبيه",42,"ي",2,0],["أَنا كَالمَنِيَّةِ سُقمُها قُدّامُها","طَوراً وَطَوراً تَبتَدي فَتُفاجي",43,"ج",2,0],["إنْ أَكُنْ ما أقولُهُ مِنه دَعْوَى","فاطلُبُوني عليه بالبُرْهانِ",44,"ن",1,0],["إن أكُنْ أُنبيكما عن شاكِرٍ","فلقد أُخبِرُ عن حَيَّةِ واد",45,"د",1,0],["أَنا كَالسَيفِ إِذا رَوَّعتَهُ","لَم يُرَوِّعكَ وَإِن هُزَّ قَطَع",46,"ع",1,0],["إِن أَكَلتُم فَضلاً وَأَنفَقتُم فَض","لاً فَلا يَدخُلَنَّ والٍ عَلَيكُم",47,"م",1,1],["أَنا كَالحَرفِ لَيسَ يُنقَطُ وَاللَ","هُ حَسيبُ الجِهّالِ إِن نَقَطوني",48,"ن",2,0],["إِن أَكُن سُؤتُها بِما لَم أُرِدهُ","في حَديثٍ بِهِ فَعِندي رِضاها",49,"ا",3,0],["أَنا كالناس حينَما مت ماتَت","مَع نَفسي الهموم وَاللذات",50,"ت",1,0],["إنْ أكُنْ قد شربتُ نخبَ كثيرا","تٍ وأترعتُ بالمدامة كأسي",51,"س",2,1],["إِنّا كَذَلِكَ يا سُهَيَّ إِذا","غَدَرَ الحَليفُ نَقودُ بِالخَطمِ",52,"م",1,0],["إنْ أكْبَرَ الْعُلَمَاءُ حِكْمَتَهُ فَقَدْ","فُتِنَتْ بِحُسْنِ بَيَانِهَا الأُدَبَاءُ",53,"ا",2,0],["أنا كالمعَرّي لست أسأل رحمةً","إلا من الآباء للأولاد",54,"د",1,0],["أَنا كَالأَورَقِ اِشتَكى","فَقد إِلفٍ وَأَفرُخ",55,"خ",1,0],["أَنا كَالزَرعِ وَالعِدا","كَالجَرادِ المَصوِّخ",55,"خ",1,0],["أنا كأس من غنى الشو","ق ودمع الذكريات",56,"ت",1,0],["إن أكنْ فيكَ داني القلبِ بالأم","سِ فروحي لروحِك اليوم أدْنَى",57,"ن",2,0],["إنا كبِرْنا يا نخيلُ وحبُّنا","بين الجوانحِ شُعْلةٌ وضِرامُ",58,"م",1,0],["أَنا كَالسَّيفِ إِذَ رَوَّعْتَهُ","لَمْ يُرَوِّعْكَ وأن هُزّ قَطَعْ",59,"ع",1,0],["إِنْ أَكْ بَاكِياً مِنَ السَّرَّاءِ","فَإِنَّ طُولَ الشَّوْقِ فِي التَّنَائِي",60,"ا",2,0],["إنا كلينا عارفان بما","حَوَتِ الثّيابُ وضَمَّتِ الأزُر",61,"ر",1,0],["ان اكن اصغرَ المجيدين سِناً","فانا أكبرُ المجيدين نَفْسا",62,"س",2,0],["أنا كما شاءَ الهوى والصبا","وهيَ كما شاءَتْ أمانيها",63,"ي",3,0],["أنا كالمسافر لاح لي أيك وأغرتني قباب","وتفتّحت حولي الرياض الخضر واصطفق العباب",64,"ب",1,0],["إن أكن قد أجدتُ تحت قريضٍ","فيكُم جادَ ذلك المنحوتُ",65,"ت",1,0],["إنَّا كذلك يا سُهَيَّ إذا","غدرَ الحليفُ نمورُ بالخطم",66,"م",1,0],["إِن أَكُن راجياً فَأَنتَ جَوادٌ","أَو أَكُن مُذنِباً فَأَنتَ الغَفورُ",67,"ر",1,0],["انا كما شهد الغرام مع الهوى","في طي اثواب الوجود فنينا",68,"ن",2,0],["إنا كلينا واجدٌ متجلد","يخطو إلى الغايات خطو مقيد",69,"د",1,0],["أنا كلاموج ليس يحييه إلّا","ثورة الريح وانتفاء الركود",70,"د",1,0],["إن أُكملتْ حسنا فقد زُرَّت على","جسدٍ يكلَّل بالعلا ويرصَّعُ",71,"ع",1,0],["أنا كمٌّ أنا كيف","أنا وجدٌ أنا فقد",72,"د",1,0],["أَنَا كَالدُّرِ وَلكِن","أَنَا مِن صَخرٍ شَدِيد",73,"د",1,0],["إِن أَكُن حَقّاً بما قلتُ حقيق","فَعَلى ما ولِما هذا المُقام",74,"م",1,0],["إِن أَكُن مُذنِباً فَهُم أَهلُ عَفوٍ","وَعَلى الكَونِ إِن رَضوني العَفاءُ",75,"ا",2,0],["إنا كلانا لعاشقٌ دنفٌ","طارَ بنومي ونومكَ السهدُ",76,"د",1,0],["أنا كاسٍ من الصبابة والوج","دِ لظبي من الملاحة كاسِ",77,"س",1,0],["أنا كالسبط مات وهو يرى الما","ءَ وشيكاً بغلة الظمآنِ",78,"ن",1,0],["إن أكن ربما سخطتُ على الده","ر لذنبٍ فطال ما قد رضيتُ",79,"ت",1,0],["إن أكن في هواك أخلفت وعداً","فلقد ضاع فيك وعد ووعد",80,"د",1,0],["إِن أَكن مِن دَمي بَقِيَّةَ شِعرٍ","وَخَيالٍ فَأَنتِ مِنّي بَقايا",81,"ا",3,0],["إِن أَكن سُقت في غَرامِكِ شَرّاً","فَالبَرايا مطيّة لِلشُرورِ",82,"ر",1,0],["إِن أَكُن ناجيتُها مُنذُ الصِبا","سَوفَ من بعدي يُناجيها الوُجود",83,"د",1,0],["أنا كالجِدِّ في الأمور إذا ما","كان غيري فيهن مثل المُزاحِ",84,"ح",1,0],["أَنا كنتُ أَولَ عاشِقيكَ وَقَد سَلا","غَيري وودّي بِالوَفاءِ ثَقيلُ",85,"ل",1,0],["إنْ أَكُنْ نجماً بعيداً","اِرْقَ، أقْبِلْ، واسْتَبِقْني",86,"ن",2,0],["أَنا كُلُّ مَن وَالى الإِمامَ وَمَقتُهُ","وَلِمَن يُعاديهِ قِلايَ وَمَقتُهُ",87,"ت",2,0],["أنا كالليث إذ أهيجُ وكالو","رشان في رقتي ولينِ خطابي",88,"ب",2,0],["إِن أَكن شِبتُ غَراماً بعدَكم","فالهَوى العُذريُّ ما زالَ غُلاما",89,"م",2,0],