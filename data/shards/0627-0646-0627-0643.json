{"poems":[[3,"وفوارس لي قد علمتهم","https://www.aldiwan.net/poem109.html",""],[77,"أفل الألى كانوا نجو","https://www.aldiwan.net/poem36114.html","مجزوء الكامل"],[77,"إن أكن غيركم نظرت بعيني","https://www.aldiwan.net/poem36527.html","الخفيف"],[77,"أنا كافر وسواي فيه بعاذل","https://www.aldiwan.net/poem36690.html","الكامل"],[86,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[71,"انظر إلي بعين مولى لم يزل","https://www.aldiwan.net/poem3991.html","الكامل"],[73,"أنا ظرف للهو كل ظريف","https://www.aldiwan.net/poem11989.html","الخفيف"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[72,"مولاي دعوة معجب","https://www.aldiwan.net/poem18685.html","مجزوء الكامل"],[72,"غازلتني سمراء في حلية المر","https://www.aldiwan.net/poem18765.html","الخفيف"],[72,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"يا بني طود المعالي طاهر","https://www.aldiwan.net/poem61898.html","الرمل"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"طلع الرقي في شاشية","https://www.aldiwan.net/poem65693.html","الرمل"],[51,"طلب البيهقي قرنا فلم يحرمه","https://www.aldiwan.net/poem66478.html","البسيط"],[51,"أعرف وراقا بآيينه","https://www.aldiwan.net/poem66488.html","السريع"],[91,"جعت والخبز وفير في وطابي","https://www.aldiwan.net/poem8748.html","عموديه"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"تلك المازل كيف حال مقيمها","https://www.aldiwan.net/poem62713.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[91,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[70,"لكم الروح والبدن","https://www.aldiwan.net/poem42443.html","مجزوء الخفيف"],[89,"انا لا يسأل عني","https://www.aldiwan.net/poem44678.html","مجزوء الرمل"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[43,"بيدي أيها الأمير الأريب","https://www.aldiwan.net/poem10633.html","الخفيف"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[45,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"أي قواف يعز مونقها","https://www.aldiwan.net/poem51511.html","المنسرح"],[66,"طلب الود بالزيارة زور","https://www.aldiwan.net/poem38679.html","الخفيف"],[66,"إن أكن قد جنيت في السكر ذنبا","https://www.aldiwan.net/poem39042.html","الخفيف"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[69,"إن أك برا فأنا فاجر","https://www.aldiwan.net/poem28628.html","السريع"],[31,"جن قلبي فقلت يا قلب مهلا","https://www.aldiwan.net/poem41849.html","الخفيف"],[31,"ما كنت أشعر إلا مذ عرفتكم","https://www.aldiwan.net/poem42519.html","البسيط"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[67,"ليت شعري ما مقتضى حرماني","https://www.aldiwan.net/poem18113.html","الخفيف"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[50,"أنفس الشوق ولا ينفسني","https://www.aldiwan.net/poem62334.html","الرمل"],[46,"إن أكلتم فضلا وأنفقتم فض","https://www.aldiwan.net/poem23434.html","الخفيف"],[46,"ويبكم إن رأيتموني يوما","https://www.aldiwan.net/poem23543.html","الخفيف"],[40,"","https://poetry.dctabudhabi.ae/diwan/poem/93167","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39650","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9874","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54528","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[50,"أَنْفسُ الشوْق ولا ينفسنِي","https://www.poetsgate.com/ViewPoem.aspx?id=30960",""],[93,"هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31925",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[51,"كم يُعَزّ المُفَضَّلُ المبخوتُ","https://www.poetsgate.com/ViewPoem.aspx?id=27203",""],[3,"وفوارسٍ لي قد علمتُهُم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10746&r=&rc=100",""]],"verses":[["إِنّا كَذَلِكَ يا سُهَيَّ إِذ","غَدَرَ الحَليفُ نَقودُ بِالخَطمِ",0,"م",1,0],["أَنَا كَاتِبُ السُّلْطَانِ مَا","طَالَعْتُ قَطُّ كِتَابَ مُسْلِمْ",1,"م",1,0],["إنْ أكُنْ غيرَكُم نظَرْتُ بعَيْني","بعْدَكُمْ يا سَوادَ ذاكَ السّوادِ",2,"د",1,1],["أنا كافِرٌ وسِوايَ فيهِ بِعاذِلٍ","لا يَسْتَبينُ الصِّدْقُ في آياتِهِ",3,"ه",1,1],["أَنا كَالمَنجَمِ تِبرٌ وَثَرىً","فَاِطرَحوا تُربي وَصونوا ذَهَبي",4,"ب",2,0],["أَنا كَالَّذي أَحتاجُ ما يَحتاجُهُ","فَاغنَم ثَوابي وَالثَناءَ الوافي",5,"ي",1,0],["أَنا كَالصَدرِ بِالإِحاطَةِ بِالرا","حِ إِذِ الراحُ كَالضَميرِ اللَطيفِ",6,"ف",1,0],["إِنْ أَكْبَرَتْ فِيهِ المُرُوءةُ خَطْبُهَا","فَالرُّزْءُ العَيْنِ فِي إِنْسَانِ",7,"ن",1,0],["إِنّا كَذاكَ لِمِثلِ ذاكَ نُعِدُّها","تُسقى الحَليبَ وَتُشعَرُ الأَجلالا",8,"ل",2,0],["أنا كالذي هو قائلٌ","في شعره أنا كالذي",9,"ي",1,0],["إن أكن صرت بالبلادةِ فزعاً","إن لفظي كما يقال مسير",10,"ر",1,0],["إن أكتم الحبّ لم تكتم دلائله","وإن أمل لطريق الصبر لم أمل",11,"ل",1,0],["إن أكن أحسن الثنا فيك قولاً","فلقد أحسنت أياديكَ فعلا",12,"ل",2,0],["إن أكن غيرَ مُحسنٍ كلَّ ما تطْ","لبُ إني لَمُحْسنٌ أجزاءَ",13,"ا",2,0],["إن أكن عاطلاً لديك منَ الآ","لاتِ حاشاك أن تجورَ عَثاءَ",13,"ا",2,0],["إن أكن قد أجدتُ نحت قريضٍ","فيكُمُ جادَ ذلك المنحوتُ",14,"ت",1,0],["إن أكن أحسنتُ في مدحكُم","فأخو الإِحسان أولى من رُفِدْ",15,"د",1,0],["أنا كعبة النيك التي نُصبت لهُ","فتلقّ منها حيث شِئت فكَبِّر",16,"ر",1,0],["أنا كفءٌ لكم ومالي عليكمْ","من ظهيرٍ وهل لأقرَعَ مشط",17,"ط",1,0],["إن أكن أبصرت شخصاً مثله","فثيابي في الجوالي صدقه",18,"ق",2,0],["أنا كالبيهقي إن لم أكن مِنْ","هُ مكان القذاةِ من بطن جَفْنِه",19,"ن",2,0],["إن أكُ قد أكسبْتُه سمعةً","وزانه شعري بتزيينه",20,"ن",2,0],["أَنا كَالكَرمَةِ لَو لَم تَغتَرِب","ما حَواها الناسُ خَمراً في الخَوابي",21,"ي",1,0],["أَنا كَالسَوسَنِ لَو لَم يَنتَقِل","لَم يُتَوَّج زَهرُهُ رَأسَ كَعابِ",21,"ب",1,0],["إِن أَكُن أُبعَثُ بَعدَ المَوتِ جُثمانا وَعَقلاً","أَتَرى أُبعَثُ بَعضاً أَم تُرى أُبعَثُ كُلّاً",22,"ل",2,0],["إِن أَكُن في حالَةِ الإِدراكِ لا أَدري مَصيري","كَيفَ أَدري بَعدَما أَفقِدُ رُشدي لَستُ أَدري",22,"ي",1,0],["أَنا كَالصَهباءِ لَكِن أَنا صَهبائي وَدَنّي","أَصلُها خافٍ كَأَصلي سِجنُها طينٌ كَسِجني",22,"ي",1,0],["إِن أَكرَمَتكَ نُفوسُنا في لَيلَةٍ","فَلَكَم قَضَيتَ العُمرَ في تَكريمِها",23,"م",3,0],["أَنا كَالطائِرِ الَّذي اِندَفَقَ السِح","رُ عَلَيهِ فَغَصَّ بِالأَلحانِ",24,"ن",1,0],["إِن أَكُن فِرقَداً فَأَنتُم سَمائيو","أَو هَزاراً فَأَنتُمُ بُستاني",24,"ي",1,0],["أَنا كَما شاءَ الهَوء وَالصِبا","وَهيَ كَما شاءَت أَمانيها",25,"ي",3,0],["أَنا كُلّي لَكُم تُرى","سادَتي أَنتُمُ لِمَن",26,"ن",1,0],["انا كالرحمة منبو","ذ وكالحق غريب",27,"ب",1,0],["إِن أَكُن مُعجَباً فَعُجبُ عَجيبٍ","لَم يَجِد فَوقَ نَفسِهِ مِن مَزيدِ",28,"د",1,0],["إن أكُن قبلَ أن رأيتُكَ أخطَأ","تُ فإنّي على يديكَ أتوبُ",29,"ب",1,0],["إِن أُكَلِّفهُ حاجَةً لا يُواكِل","جَدُّهُ دونَها وَلا تَشميرُه",30,"ر",2,0],["إِن أَكُن حُبتُ في سُؤالِ بَخيلٍ","فَبِكَرهي ذاكَ السُؤالُ وَرَغمي",31,"ي",1,0],["إن أكن قد كويت لحم بلادي","فمن الكي قد يجيء الشفاء",32,"ا",2,0],["إن أَكسُكُمْ من مدائحي جُنَناً","فإنَّ لي أسهُماً تُمَزِّقُها",33,"ق",3,0],["إِن أَكُن في تَأَخُّرِ السَعيِ قَصَّر","تُ فَفَرضُ المُسافِرُ التَقصيرُ",34,"ر",1,0],["إِن أَكُن قَد جَنَيتُ في السُكرِ ذَنباً","فَاِعفُ عَنّي يا راحَةَ الأَرواحِ",35,"ح",1,1],["أنا كالخيروزِ صعبٌ كسرُهُ","وهْوَ لدْنٌ كيفما شئتَ انفتلْ",36,"ل",1,0],["إنْ أكنْ في حلبٍ كاسداً","إنَّ لسوقي في سواها مقامْ",37,"م",1,0],["إنْ أَكُ براً فأنا فاجرٌ","بجرِّيَ الشوكَ إلى الوردِ",38,"د",1,1],["إِن أَكُن قَد سَأَيتُكُم فَلَكِ العُت","بى وَهانَ الَّذي سَأَلتُ وَقَلّا",39,"ل",2,0],["إِن أُكرِهِ الطَرفَ يَحسِر دونَ غَيرِكُمُ","وَلَستُ أُحسِنُ إِلّا نَحوَكِ النَظرا",40,"ر",2,0],["أن أكْرِموا رُسلِي الذين تَرَوْنَهم","يرجون فضلَ الله عِندَ ديُونهِ",41,"ه",1,0],["إِن أَكُن مُسرِفاً بِلَومي فَلومي","صادر عَن مَحَبتي القَلبيه",42,"ي",2,0],["أَنا كَالمَنِيَّةِ سُقمُها قُدّامُها","طَوراً وَطَوراً تَبتَدي فَتُفاجي",43,"ج",2,0],["إنْ أَكُنْ ما أقولُهُ مِنه دَعْوَى","فاطلُبُوني عليه بالبُرْهانِ",44,"ن",1,0],["إن أكُنْ أُنبيكما عن شاكِرٍ","فلقد أُخبِرُ عن حَيَّةِ واد",45,"د",1,0],["أَنا كَالسَيفِ إِذا رَوَّعتَهُ","لَم يُرَوِّعكَ وَإِن هُزَّ قَطَع",46,"ع",1,0],["إِن أَكَلتُم فَضلاً وَأَنفَقتُم فَض","لاً فَلا يَدخُلَنَّ والٍ عَلَيكُم",47,"م",1,1],["أَنا كَالحَرفِ لَيسَ يُنقَطُ وَاللَ","هُ حَسيبُ الجِهّالِ إِن نَقَطوني",48,"ن",2,0],["إِن أَكُن سُؤتُها بِما لَم أُرِدهُ","في حَديثٍ بِهِ فَعِندي رِضاها",49,"ا",3,0],["أَنا كالناس حينَما مت ماتَت","مَع نَفسي الهموم وَاللذات",50,"ت",1,0],["إنْ أكُنْ قد شربتُ نخبَ كثيرا","تٍ وأترعتُ بالمدامة كأسي",51,"ي",1,1],["إِنّا كَذَلِكَ يا سُهَيَّ إِذا","غَدَرَ الحَليفُ نَقودُ بِالخَطمِ",52,"م",1,0],["إنْ أكْبَرَ الْعُلَمَاءُ حِكْمَتَهُ فَقَدْ","فُتِنَتْ بِحُسْنِ بَيَانِهَا الأُدَبَاءُ",53,"ا",2,0],["أنا كالمعَرّي لست أسأل رحمةً","إلا من الآباء للأولاد",54,"د",1,0],["أَنا كَالأَورَقِ اِشتَكى","فَقد إِلفٍ وَأَفرُخ",55,"خ",1,0],["أَنا كَالزَرعِ وَالعِدا","كَالجَرادِ المَصوِّخ",55,"خ",1,0],["أنا كأس من غنى الشو","ق ودمع الذكريات",56,"ت",1,0],["إن أكنْ فيكَ داني القلبِ بالأم","سِ فروحي لروحِك اليوم أدْنَى",57,"ن",2,0],["إنا كبِرْنا يا نخيلُ وحبُّنا","بين الجوانحِ شُعْلةٌ وضِرامُ",58,"م",1,0],["أَنا كَالسَّيفِ إِذَ رَوَّعْتَهُ","لَمْ يُرَوِّعْكَ وأن هُزّ قَطَعْ",59,"ع",1,0],["إِنْ أَكْ بَاكِياً مِنَ السَّرَّاءِ","فَإِنَّ طُولَ الشَّوْقِ فِي التَّنَائِي",60,"ا",2,0],["إنا كلينا عارفان بما","حَوَتِ الثّيابُ وضَمَّتِ الأزُر",61,"ر",1,0],["ان اكن اصغرَ المجيدين سِناً","فانا أكبرُ المجيدين نَفْسا",62,"س",2,0],["إن أكن قد أجدتُ تحت قريضٍ","فيكُم جادَ ذلك المنحوتُ",63,"ت",1,0],["إنَّا كذلك يا سُهَيَّ إذا","غدرَ الحليفُ نمورُ بالخطم",64,"م",1,0]]}