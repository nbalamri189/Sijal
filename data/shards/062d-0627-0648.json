"],[6102,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=184862",""],[6108,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=192389",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""],[6185,"حاولت ريّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86944&r=&rc=4",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[5080,"أشجرت ذاتك في أحشاء تربته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88137&r=&rc=7",""],[6243,"سحق الوهم ِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84440&r=&rc=14",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[454,"ردّي علي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82654&r=&rc=18",""],[454,"رثاء جمال عبد الناصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82677&r=&rc=41",""]],"verses":[["حاوَلنَ شَغلَ فُؤادي مِن عَلاقَتِهِ","بِالعَقلِ وَالقَلبُ عِندَ البيضِ في شَغَلِ",0,"ل",1,0],["حاوَلَ رَدَّ غَربِها","يا بُعدَ ما يُحاوِلُ",1,"ل",1,0],["حاوَلتَ أَن تَرِدَ المَجَر","رَةَ وَالوُرودَ مِنَ العَسيرِ",2,"ر",1,0],["حاوَلوا طَمسَ ما صَنَعتَ وَوَدّوا","لَو يُطيقونَ طَمسَ خَطِّ الحَديدِ",3,"د",1,0],["حاولتم الشرف الرتيق مناله","حتى رميتم رتقه بفتوق",4,"ق",1,0],["حاولَ لثمِي خيلانُ وَجنتِها","فقال مسكيها ولا حبه",5,"ب",2,0],["حاول به أمراً وقلِّب به","أمراً تجده حُوَّلاً قُلَّبا",6,"ب",2,0],["حاوِلْ مَعاطِفهُ فهن نواعمٌ","واترك مَكاسِرهُ فهن عَواس",7,"س",1,0],["حاولَ القردُ لعَمْري","عكْسَ أمرٍ ليس يُعْكَسْ",8,"س",1,0],["حاولتَ ما ليس في قواك مِنَ الْ","أمر فلا تجْشَمنَّ ما جَشما",9,"م",2,0],["حاولتَهُ والهولُ يزخرُ دونَه","كالبحرِ جلَّلَ متنه الإظلامُ",10,"م",1,0],["حاوَلتَ أَن تَهتاجَني عَن مَربَضي","لِتَنالَ ذِكراً خِبتَ يا ذا الراجي",11,"ج",2,0],["حاوَلتُ وَصفَ جَمالِها فَكَأَنَّني","وَلَدٌ بِأُنمُلِهِ يَحوشُ الأَبحُرا",12,"ر",2,0],["حاوَلتَ وُجدانَ عَيبٍ لي فَكُنتُ كَمَن","يُحاوِلُ الماءَ في البُركانِ ذي الضَرَمِ",13,"م",1,0],["حاوَلنَني لِأَبُتَّ حَبلَ وِصالِكُم","مِنّي وَلَستُ وَإِن جَهَدنَ بِفاعِلِ",14,"ل",1,0],["حاولت وصف خصال فيك راجحة","فاعجزتني عن تصويرها الكلم",15,"م",1,0],["حاولت أن تذاكي القلى بقلوبنا","لمليك مصر وكان ذاك محالا",16,"ل",2,0],["حاوَلنَ إِلى خَيالِكَ سُلَّماً","لَو سامَحَت بِخَيالِكَ الأَحلامُ",17,"م",1,0],["حاوَلنَ تَفدِيَتي وَخِفنَ مُراقِباً","فَوَضَعنَ أَيدِيَهُنَّ فَوقَ تَرائِبا",18,"ب",2,0],["حاولتُما جبلاً كأنَّ رِعانَه","فَوقَ السَّحابِ الغُرِّ غُرُّ سحابِ",19,"ب",1,0],["حاوَلتَ رِزقَكَ دونَ دينِكَ مُلحِفاً","وَالرِزقُ لَو لَم تَبغِهِ لَبَغاكا",20,"ك",2,0],["حاوَلتُها عارِيَةً مَردودَةً","فَرَجَعتُ مِنها عارِياً مَردودا",21,"د",2,0],["حاوَلَتني مِنَ العُداةِ لُيوثٌ","لا أَراها بَعوضَةً في صِماخي",22,"خ",2,0],["حاوَلَت روسُهُم صُعوداً فَنالَت","هُ وَلَكِنَّ مِن رُؤوسِ الصِعادِ",23,"د",1,0],["حاوَلنَ عِندَ الشِعريَينِ مَآرِباً","وَحَمَلنَ مِلءَ الخافِقينَ أَمانِيا",24,"ي",2,0],["حاوَرَتْهَا الحوراءُ شَوْقاً فينبو","عٌ فَرَقَّ اليَنْبُوعُ وَالْحَوْراءُ",25,"ا",2,0],["حاوَلتُمُ العَرشَ عِندي في سَلاسِلِهِ","هَيهاتَ رُمتُم قَريباً غَيرَ مَقروبِ",26,"ب",1,0],["حاولت مجتهداً أن ينهض العربُ","وأن يقوم بأعباء الهدى الأدبُ",27,"ب",1,0],["حاولت أن ألقى الحَقيقة جهرة","فإذا الحَقيقَة دونها أستار",28,"ر",1,0],["حاول إهواني قوم فما","واجهتهم إلا بإهوان",29,"ن",1,1],["حاوَلنَ منه إِلى خَيالِكَ سُلَّماً","لَو سامَحَت بِخَيالِكَ الأَحلامُ",30,"م",1,0],["حَاوَلْت جُهْدَكَ لاَ نَفَا","ئِسَك ادَّخَرْتَ وَلاَ قُوَاكْ",31,"ك",1,1],["حاوَلتُ لُقياكَ مُذ زَمانٍ","لَيسَ لَهُ بِالمُنى سَماحُ",32,"ح",1,0],["حَاولْتُ تَصْوِيرَها جُهْدِي فما اتَّسَعَتْ","لِبَعْضِ ذلكَ أَلْواحي وأَلْواني",33,"ن",2,0],["حاولت يومًا صرفَه بتثاؤبي","فرأيته فوق الأريك مسمَّرا",34,"ر",2,0],["حاولوا ما رقمته من كمالي","حنقا بالتحريف والتصحيف",35,"ف",1,0],["حاولت مثلك مرة","أبدو ذكيا ضاع جهدي",36,"د",2,0],["حاولي فهمهم بِرقّة أختٍ","بل أذيق اللظى المرير مُذيقي",37,"ق",2,0],["حاولت أن تتقيئي","في ليلة عفن ا لعصور",38,"ر",1,0],["حاولتُ وصفكِ فاستعصى الخيالُ معي","يا مَنْ تَدُوخُ على أقدامِكِ الصُوَرُ",39,"ر",1,0],["حاولت أن تتقئي","في ليلة عّفن العصور",40,"ر",1,0],["حاولتني واحتلت رأيك قطعتي","ولقد يضل برأيه المحتال",41,"ل",1,0],["حاولت حين رأيت أن أمْحَنه","فمنحته بعد اختياري يمما",42,"م",2,0],["حاوِرْ ونَاقِشْ واسْتَمِعْ صَوْتَ الجُمُوعِ","فَقَطْ جُمُوعُ الصُمِّ مَنْ لا تُسْمَعُ",43,"ع",1,0],["حاولها قومٌ ومن هذا الذي","يُخْرِجُ لينا خادرا من غابهِ",44,"ب",2,0],["حاوِل بِها أَيَّ المَمالِكِ شِئتَهُ","إِنَّ الطَريقَ إِلى اِبتِغائِكَ مَهيَعُ",45,"ع",1,0],["حاوَلتَها قِدماً وَكُلٌّ عاشِقٌ","وَبَلَغتَ غايَتَها وَكُلٌّ سالِ",46,"ل",1,0],["حاولتُ نفسي الصبر عنهم قيل لي","مه ذا محالٌ ويك عنه تحوّل",47,"ل",1,0],["حاولت أن يجروا على عاداتهم","عند الملوكِ وتغفر الإِخطالا",48,"ل",2,0],["حاولتُ أَن أُثني عَلَيكَ فَخانَني","قَلمٌ أَراهُ غَداً بِكَفِّي مَغزلا",49,"ل",2,0],["حاولت زورتي فنمّ عليها","قرطها في الدجى ومسك الغلاله",50,"ل",2,0],["حاول خلاصك واسلُك","إلى النجاة المذاهب",51,"ب",1,0],["حاول نجاتك مني إنني بطلٌ","يغزو الجمال بأنغام وألحانٍ",52,"ن",1,0],["حاوي العلومِ وحاوي كُلَّ معجبةٍ","يا ليت كاتبَه أمْلاهُ بالذَّهبِ",53,"ب",1,0],["حاوَل النَومَ غير أَن طُيوفاً","جاوَرَت عَينَه وَفيها اِنتِقامُ",54,"م",1,0],["حَاوَلْتُ صَبْراً عَلَى مَا نَابَ مِنْ نُوَبِ","وَهْوَ عَظيمٌ فَجَدُّ الصَّبْرِ فِي عَطَبِ",55,"ب",1,1],["حاولت زورتكم فحل لكم","قتليَ في حتفي سعى قدمي",56,"م",2,0],["حاوِ الشَمائِلِ مَعسولٌ خَلائقُه","صافي الأَديمِ أَبيُّ لَينٌ خَشن",57,"ن",1,0],["حاوي الهدى مصباح انوار التقي","كنز الفضائل معدن التطهير",58,"ر",1,0],["حاوى المحامد كامل الصنفين في","نفع وَضر فاتح الاغلاق",59,"ق",1,0],["حاوَلتُ تَهنِئَةَ الوَزيرِ فَلَم أَجِد","لي في الدُخولِ بِبابِهِ مِن مُسعِدِ",60,"د",1,1],["حاوَلتْ أن تشرق الشم","سُ وَهَّمتْ بالظهور",61,"ر",1,0],["حاولتُ أكشف من غمّائِها ظللاً","تذيقها غصص الأشجان ألوانا",62,"ن",2,0],["حاوَلتهُ القضبُ تَقبيلاً فما","راعهُ إلّا عيونُ النرجسِ",63,"س",1,0],["حاوَلُوا الكَسْبَ من جزيلِ ثراء","فيه فاستبضَعوا جميلَ ثَناء",64,"ا",2,0],["حاولت قربهم فنادى بعدُهم","الهجرُ أعذب من وصال لئام",65,"م",1,0],["حاوي الفضائل والفواضل كلها","أغنى به صنوي أبا إسماعيلا",66,"ل",2,0],["حاولتُ كتمانَ بثِّي بعدَ فقدِهِمُ","فلم يُطِقْ قلبيَ المحزونُ كِتمانا",67,"ن",2,0],["حاولت إيقاف الدموع تجلد","ففشلت واستعصى علي المدمع",68,"ع",1,0],["حاولت أن أضع المحبة جانب","وأعيش مثل بقية الأصحاب",69,"ب",1,0],["حاوَلوا في العِراقِ منِّي بُروزاً","لو تَوَلَّوْا للجانِبِ الغَرْبِيِّ",70,"ي",1,0],["حاوَرْتُها فيه ذوْقاً","بلُطْفِ طَوْرٍ فحارَتْ",71,"ت",1,0],["حاوِ لِغايات الكَمال مُنزهاً","عَن كُل نَقص عارِفاً متبتلا",72,"ل",2,0],["حاوَلوا منها عَدَّ تلكَ المَزايا","في مَغيبٍ يَحكي مَغيبَ هِلالِ",73,"ل",1,0],["حاوى الشرائع بل ضرغام أولها","في الحرب يوم اشتقاق الغدغم الخصم",74,"م",1,0],["حاولتُ في المرآة أنظرُ مَن أنا","فرأيتُ شخصاً أنكرتْهُ عيوني",75,"ن",2,1],["حاولوا بالإستهانة أن","يخفضوا مرفوع أعلامي",76,"م",2,0],["حاولته الفحول أن يدركوه","فأبى من حجابه المسدول",77,"ل",1,0],["حاولوا الدرك مع جمودتهم","ثم لما أعياهمو كفروا",78,"ر",3,0],["حاولوا يطفئون بالزور نوري","ويذلون عز قدري المهيب",79,"ب",1,0],["حاوَلتَ سفْكَ دمي بعينِكَ ثانياً","هيهاتِ قد سَفكَتْهُ عيني أوَّلا",80,"ل",2,0],["حاوَلتُ مِدحَتَهُ فَبِتُّ بِلَيلَةٍ","ما لَيلُ مَهجورٍ وَلَيلُ سَليمِ",81,"م",1,0],["حاوِلْ صلاحَ فسادِه فلقد طَمَا","ما دُمتَ في وقتٍ تصيبُ يَسارَا",82,"ر",2,0],["حاولتها زمناً ودون سبيلها","متطيِّرون كما يشاء العاذل",83,"ل",1,0],["حاول من قبله العلا امم","والشعر قبلي وطالما عجلوا",84,"ل",3,0],["حاوي إِحكام الأَحْكامِ","وَعَنِ التّصويبِ فلم تَحِدِ",85,"د",1,0],["حاوي المَعالي عَريضُ الجاهِ وَالسّعدِ","في حُسنِ رَأيٍ لَقَد آخاهُ تَسديدُ",86,"د",1,0],["حاولت حسن امتداح المصطفى زمنا","فما استطعت بإطراء وإغياء",87,"ا",2,0],["حاولتُ منهُ برَوْضٍ خلسةً فعدا","وخلفَه الدمع كلٌّ عادَ منطلقا",88,"ق",2,0],["حاوي الجميل عريق المجد مرتضِع","دُرَّ المكارم مفطوم على الرشدِ",89,"د",1,0],["حاول العَليا بسهم وافر","فحَواها وأصاب الغَرضَا",90,"ض",2,0],["حاولْتِ حين صرمتني","والمرءُ يعجزُ لا المَحَالهْ",91,"ل",2,1],["حاولت أن تهدم في ساعة","كونا تعالى في السنين ا