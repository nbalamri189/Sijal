دِّ",16,"د",1,0],["يَتَهَلَّلُ الشُّرَكَاءُ فِي أَرْبَاحِهَا","لِتَهَلُّلِ الفَرِحِينَ بِالأَجْعَالِ",17,"ل",1,0],["يتهادينَ في غلائلَ كالوردِ","ويهبطنَ من سماءٍ بعيدة",18,"د",2,0],["يتهكمون على النبيذ معتقا","وهمُ على سطح النبيذ ذباب",19,"ب",1,0],["يتهافت العمار في هلكاتها","فعل الفراش على لهيب النار",20,"ر",1,0],["يتهادى كهودج من خطايا","حار هادية القفار وحارا",21,"ر",2,0],["يَتهَنَّى بالأمانيِّ إنَّهُ","هُ قبلَ مماتٍ أنابا",22,"ب",2,0],["يتهالكا على جمالك صبوة","يتنافسان ضراعة وسجودا",23,"د",2,0],["يتهافتون على المطالع فعلهم","قول بشقشقة العناد يقال",24,"ل",1,0],["يتهللون ببدر طلعته وهم","من حوله مثل النجوم الطلع",25,"ع",1,0],["يتهادى تائهاً متشحاً","برواء الحسن لا بالحُلل",26,"ل",1,0],["يَتَهامَسونَ عَلَيَّ من أَسَفٍ","هو سَيف عَقلٍ مُرهَفُ الحَدِّ",27,"د",1,0],["يَتَهادى تيها كَما خَطَرَت غِب","بَ قُطارٍ عَلى غَديرِ شِمالُ",28,"ل",1,0],["يتهجّد ليلاً ذا سهرٍ","ويصوم نهاراً وهو وفي",29,"ف",2,0],["يتهادى مستزيداً وَله","حولها ضوضاءُ عربيد وَقاح",30,"ح",1,0],["يتهافتون على الحطام وربّما","شربوا السموم ليظفروا بدواء",31,"ا",2,0],["يتهادى خدي على خدك الور","د يناجيه عاشق النسمات",32,"ت",1,0],["يَتَهادى بِهِ الهَناء سُروراً","وَلَهُ في الأَحباب شرح يَطولُ",33,"ل",1,0],["يُتَهادَى كُلُّ ما فاهَ بهِ","فهو الدُّرُّ انْتِشاراً وانْتظاما",34,"م",2,0],["يتهاوى أمامها كلُّ ليل","سرمدي من العذاب المُهينِ",35,"ن",1,0],["يتهللون طلاقة ويخافهم","لسطاهم الأساد في الآجام",36,"م",1,0],["يتهلّلُون لدَى النَّوالِ وفي الوغَى","يَسطُون بالإرعاد والإبرَاقِ",37,"ق",1,0],["يتهافتون على الرحال كأنما","لعبت بما تحت الشعور القرقفُ",38,"ف",1,0],["يتهافتون على المنون كأنَّهم","حِرصاً فَراشٌ والمنيَّةُ نارُ",39,"ر",1,0],["يتهلَّلون إلى العفاة كمزنةٍ","ضحكت ثغور البرق في جنباتها",40,"ت",3,0],["يَتهنّا بِالعيشِ وَهوَ عَلى ما","لَيسَ يَهوى مِنها لقاء شَعوبِ",41,"ب",1,0],["يَتَهادَى كعروسٍ أقبلتْ","تَسْحَبُ الأذْيالَ مِنْ وشِي عَدَنْ",42,"ن",1,0],["يتهادى بقوامٍ","كمُنيفاتِ العوالي",43,"ل",2,0],["يتُها الريحُ هلْ مررَّتِ عليهِ","هلْ تنفَّستِ مِنْ دِما رئتيهِ",44,"ي",2,1],["يتهافتون على مواقده التي