{"poems":[[95,"خير الحلى من أدب وطهر","https://www.aldiwan.net/poem11237.html","البسيط"],[95,"يا من بكى والخطب جد أليم","https://www.aldiwan.net/poem11284.html","الكامل"],[93,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[93,"أنا هو","https://www.poetsgate.com/ViewPoem.aspx?id=53080",""],[203,"نفرت والظباء ذات نفار","https://www.aldiwan.net/poem45535.html","الخفيف"],[246,"ضحكات الشيب في الشعر","https://www.aldiwan.net/poem45748.html","المديد"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138415",""]],"verses":[["هُنَّ رَجَاءُ الوَطَنِ الجَدِيدِ","وَهُنَّ نُورُ الزَّمَنِ العَتِيدِ",0,"د",1,0],["هَنْرِي تَوَلَّى وَهْوَ مِنْكَ خُلاصَةٌ","إِنَّ الجَزُوعَ عَلَيْهِ غَيْرُ مُلِيمُ",1,"م",1,0],["هِنري اللَعين وَما الفَتى هِنري","إِلّا اِبنُ أُمِّ المَوتِ لَو تَدري",2,"ر",2,0],["\" هنري \" اللّعين وما الفتى هنري","إلاّ لبن أمّ الموت لو تدري",3,"ر",2,0],["هنَّ رباتُ كلِّ ذاتِ جمالٍ","ولها وحدها خلقنَ جواري",4,"ر",2,0],["هُنَّ رُسلُ الموتِ سائحةٌ","قبلَه والموتُ في الأَثَرِ",5,"ر",1,0],["هنري لعين زماننا انسان","وبفضله ما فاقه انسان",6,"ن",1,1]]}