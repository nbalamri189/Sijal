{"poems":[[47,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[48,"روحي كالنار أذابت دمي","https://www.aldiwan.net/poem23431.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[136,"هذى نقول بنص الآي والأثر","https://www.aldiwan.net/poem54824.html","البسيط"],[290,"طابت صفاتك مصطفى فتهللت","https://www.aldiwan.net/poem39412.html","الكامل"],[295,"أسفا لقد طفىء السراج","https://www.aldiwan.net/poem11668.html","مجزوء الكامل"],[325,"الحب ما أقساه ليس يطاق","https://www.aldiwan.net/poem61735.html","الكامل"],[415,"يا منتهى الأمل امتدت مطارحه","https://www.aldiwan.net/poem32226.html","البسيط"],[447,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[534,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107085","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48677","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61020","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108909","البسيط"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126638","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52090","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104965","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204576",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130051","الكامل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138743",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85263","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125810","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45015","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45026","الكامل"],[4718,"سجيت انا في تالي الليل سجه","https://www.poetsgate.com/ViewPoem.aspx?id=137564",""],[4755,"كم جَهْد قلبي يضاوي لَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=192871",""],[4916,"العود لا طاحت سنونه","https://www.poetsgate.com/ViewPoem.aspx?id=135661",""],[5106,".. إِنَّ النِّفْطَ قَدْ جَبُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=151384",""],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""],[5409,"حياك وادي الرافدين وما به","https://www.poetsgate.com/ViewPoem.aspx?id=155250",""],[5480,"نصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=33112",""],[5525,"أنفاس","https://www.poetsgate.com/ViewPoem.aspx?id=876",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5956,"المسلم من سلم الناس من لسانه ويده","https://www.poetsgate.com/ViewPoem.aspx?id=192367",""],[5956,"الجانبان","https://www.poetsgate.com/ViewPoem.aspx?id=193911",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[5977,"ندائي للأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=213074",""],[6035,"النداء الأخير ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151965",""],[6056,"طيور الظلامي","https://www.poetsgate.com/ViewPoem.aspx?id=130381",""],[6056,"الحكي والوشاية","https://www.poetsgate.com/ViewPoem.aspx?id=156706",""],[6070,"يا أيها المأسورُ بالأوهامِ","https://www.poetsgate.com/ViewPoem.aspx?id=197527",""],[6115,"يالعاقل اصبر للزلل","https://www.poetsgate.com/ViewPoem.aspx?id=180454",""],[313,"إلى شباب بلادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66490&r=&rc=15",""]],"verses":[["هَذي نَوافِلُكَ الَّتي خُوِّلتَها","رَجَعَت غَرائِبُها إِلَيكَ قَصائِدا",0,"د",2,0],["هَذي نُجومٌ شاهَدَت تُبَّعاً","وَمَن مَضى مِن حِميَرٍ أَو قُدُم",1,"م",1,0],["هَذِي نَصِيحَةُ مَنْ لا يَبْتَغِي بَدَلاً","بِكُمْ وَهَلْ بَعْدَ قَوْمِ الْمَرْءِ مِنْ بَدَلِ",2,"ل",1,0],["هَذى نُقُولٌ بِنَصِّ الآيِ والأثَرِ","رَدَّت سِوَاهَا عَلَى الأعقَابِ والأَثَرِ",3,"ر",1,1],["هذي نصائح مخلص مستبشر","برقي قطركم به من كامل",4,"ل",1,0],["هذي نهاية كل حيّ","في الدنى وهنا المثاب",5,"ب",1,0],["هَذي نُجومُ اللَيلِ مِن شُهبِها","كَم لَيلَةٍ أَسهَرَت أَحداقي بِها",6,"ه",2,0],["هَذيِ نتيجةُ فِكرٍ كان في الزّمنِ ال","ماضِي عَقِيماً ولولا أنتَ مَا نُتِجَا",7,"ج",2,0],["هذي نهاية وقع الحادث الجلل","موت الطبيب الأريب الهاشمي علي",8,"ل",2,1],["هَذِي نَصِيحَةُ ما حِضٍ ما شَابِها","غِشٌّ فَمَنْ بالنُّصْحِ يَوْماً يَهْتَدي",9,"د",2,0],["هذي نساء الغرب دونك فانظري","هل تبصرين بهن ذات قصور",10,"ر",1,0],["هذي نفوسهم لديك رهينةٌ","ولو استطاعوا غيرها منحوكا",11,"ك",2,0],["هذي نجومُ المعالي الزُّهْرِ قد طُمِسَتْ","وذا لواءُ العلى المرفوعُ قد خُفِضا",12,"ض",2,0],["هذي نَشيد للإسلام مِن مدن","ما خربت هَذهِ للكفر مِن مُدن",13,"ن",1,0],["هذي نهودك أم رمان بستانِ","وذا قوامك أم غصنٌ من البانِ",14,"ن",1,1],["هذى نوادينا لقد","امست بنورك عامره",15,"ر",2,0],["هَذي نَتَائِجُ فِكرِي قَد أقَمْتُ بِهَا","دَلِيلَ صِدقٍ لِمَنْ يَبلُو وَيَمتَحِنُ",16,"ن",1,0],["هَذِي نِهَايَات لأقدَامِ الوَرَى","فِي ذَا المَقَام الضَّيِّقِ الأعطَانِ",17,"ن",1,0],["هَذِي نِهَايَاتٌ لأقدَامِ الوَرَى","فِي ذَا المَقَامِ الضَّنكِ صَعبِ الشَّانِ",17,"ن",1,0],["هذي نساؤك من يكون إذا سرت","في الأسر سائقها ومن حاديها",18,"ي",3,0],["هذي نداماي في الدياجي","عاد بهم شملي الشتيت",19,"ت",1,0],["هذي نساءُ الغربِ قد طارت به","فوقَ السها والشرق لاهٍ ينظرُ",20,"ر",1,0],["هذي نساؤك يا رسول الله في","كرب الخطوب شواخص الأبصار",21,"ر",1,0],["هذي نفائس فكرة قد صغتها","ببديع نظم كالزلال السلسل",22,"ل",1,0],["هذي نجائب للهادي تقلصها","ايدي نجائب من بدو ومن حضر",23,"ر",1,0],["هذي نتيجة كل شعب قائم","بالفرد منه حياته ومماته",24,"ت",2,0],["هَذي نَتيجَةُ خاطِري وَجَّهتُها","يَومَ الهَنا مِثلَ الفَتاةِ الرود",25,"د",1,0],["هَذي نَتيجَةُ خاطِرٍ بَزَغَت لَكُم","يَومَ الهَنا مِن خادِمٍ مُتَرَدد",26,"د",1,0],["هذي نصيحه والنصيحه محجه","اما تصيب او تركي القلب بالصاج",27,"ج",1,0],["هذي نهاية مَعاقِيلَك","مقتول مُتحمِّل القاتل",28,"ل",1,0],["هذي(نصيحه) ومضمونه","خذها على هيئة رساله",29,"ل",2,0],["هَذِيْ چِنِيْڤٌ بِرِيحِ النِّفْطِ قَدْ سَكَرَتْ","پارِيْسُ هَذِيْ وَهَذَا الشَّيخُ قَدْ رَهَنَا",30,"ن",2,0],["هذي نتائج حانةٍ بك أفسدت","في عصرها الكرم الذي هو حصرم",31,"م",1,0],["هذي نتائج ما جنى من سعيه","يا خيبة الآمال في أتعابه",32,"ب",2,0],["هذي نصيحة صاحب ٍ عاش محروم","في ديمة الظلما تقاها منيره",33,"ر",2,0],["هذي نجوم السما .. جلاس","وعيبٍ على العاشق القومه",34,"م",2,0],["هذي نياقي ورملي شاخ من زمن","لما نأيْنا وقلبي في الهوى نابي",35,"ب",2,0],["هذي نزاهتهم ويعرف غيرنا","هذا وأمّا الغير يهوى الاعتدا",36,"د",2,0],["هذي نصيحة من يعَفّ عن الأذى","فاهجرْ بني الدنيا وَضُمَّ قرَنْفُلا",37,"ل",2,0],["هذي نفوس المخلِصين تظل في","جِدٍّ وكَدٍّ دونما استسلامِ",38,"م",1,0],["هذي نفوس النابغين تظل في","بحثٍ ليخترعوا الخلودَ السّامي",38,"م",2,0],["هذي نداءاتي لكل أحبتي","ممزوجة بالنصحِ دون جراحِ",39,"ح",1,1],["هذي نهاية دعوتيْ","فتأمليْ .. وتَفَكَّريْ",40,"ر",2,0],["هذي نهاية كل من هو ترك باب","بيته ، وزارنّه طيور الظلامي",41,"م",2,0],["هذي نهاية ،، مطردين المقفّى","كلّش ولو طال الزمن ، له نهاية",42,"ا",3,0],["هذي نصيحةُ صاحبٍ في قلبهِ","حبٌ كبيرٌ واسعُ الإلهامِ",43,"م",1,0],["هذي نصيحه عابره يفطن لها العقل النبيه","وكان النصايح بالذهب عند العوارف تشترى",44,"ر",2,0],["هذي نصيحة مخلص","يهوى المجادة والطلاب",45,"ب",1,0]]}