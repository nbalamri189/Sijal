{"poems":[[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[51,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[68,"للترك مالي ترك","https://www.aldiwan.net/poem39673.html","المجتث"],[33,"إن أهوى العباد شخصا إلينا","https://www.aldiwan.net/poem41845.html","الخفيف"],[33,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[33,"هَيَّجَ القَلْبَ مَغَانٍ وَصِيَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18881&r=&rc=144",""],[463,"قد قنعنا أن نرقب الأحلاما","https://www.aldiwan.net/poem55874.html","الخفيف"],[463,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[484,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[505,"للتجلي من طيه أسرار","https://www.aldiwan.net/poem37646.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55903","المجتث"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136286","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125361","البسيط"],[2117,"","https://poetry.dctabudhabi.ae/diwan/poem/111328","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109420","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103832","الخفيف"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104854","الخفيف"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146845","البسيط"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72761","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4979,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=176546",""],[5212,"بابُ الحوائج","https://www.poetsgate.com/ViewPoem.aspx?id=212031",""],[5273,"حقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=191949",""],[5510,"لا تعذليه","https://www.poetsgate.com/ViewPoem.aspx?id=206146",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5848,"الدمع والشمع","https://www.poetsgate.com/ViewPoem.aspx?id=50590",""]],"verses":[["لِلتُركِ ساعاتُ صَبرٍ يَومَ نَكبَتِهِم","كُتِبنَ في صُحُفِ الأَخلاقِ بِالذَهَبِ",0,"ب",1,0],["لِلتُقى عاقِبَةٌ مَحمودَةٌ","وَالتُقى المَحضُ لِمَن كانَ يَزِع",1,"ع",1,0],["لِلتُركِ مالي تَركُ","ما دينُ حُبِّيَ شِركُ",2,"ك",1,1],["لَلَّتي بِالبَلاطِ أَمسَت تَشَكّي","رَمَداً لَيتَهُ بِعَينِيَ حَلّا",3,"ل",2,0],["لِلَّتي قالَت لِجارَتِها","وَيحَ قَلبي ما دَهى عُمَرا",4,"ر",2,0],["للتجاريب في الأمور يداها رُبَّ","بانٍ ما كان بالأمس هادم",5,"م",1,0],["للتي قالتْ لأترابٍ لها","قطفٍ، فيهنّ أنسٌ وخفر",6,"ر",1,0],["للتهاني وصفٌ يخُصُّ وإن كا","نت سعاداتُكم تعُمّ العاما",7,"م",2,0],["للتهاني كلّ يومٍ فوقها","طارقٌ يوسع للشعر مجالَهْ",8,"ل",2,0],["للترك قد تركت رغما طراكية","واستنزفت دمعة حرا لمكتئب",9,"ب",1,0],["للتجلي من طيِّه أسرار","تنجلي من نماطها أدوار",10,"ر",1,1],["للتاج أم للشعب أم لكليهما","ذنب المغير وسيئات العادي",11,"د",2,0],["للترك آداب تقضى","ترك السوى من وراء",12,"ا",2,1],["للتلقي سر شريف لطيف","فيه للسالكين اقوى دلاله",13,"ل",2,0],["للتُّركِ كم طأطأت هامُ الملوكِ وكم","عَنَت وجوهٌ علاها الجبنُ والضَّجَرُ",14,"ر",1,0],["للتن فاعلم يا أخي شرطان","تبليلك الشطب وجمرتان",15,"ن",1,0],["للتيه والعجب اسرارٌ مخبأةٌ","بخصره وأرى وجدي به علنا",16,"ن",2,0],["للتلاقي بعد الفراق سرور","كسرور المفيق حانت وفاته",17,"ت",2,1],["للتصابي داعي هواك دعاني","وجناني لباه قبل لساني",18,"ي",1,0],["للتها مثل سل الفجر صارمه","وأحجم الليل في أثواب موتور",19,"ر",1,0],["للتسع والخمسين والخمسمائة","ولثلاث وتسعين هيه",20,"ه",1,0],["للتلغراف الفضل إذ جاءنا","يقول بشراكم بلفظ وجيز",21,"ز",1,1],["للتلغراف لمع برق خاطف","في لمحة يفعل فعل آصف",22,"ف",1,0],["للتي قد حشت حشا المجد ناراً","وأسالت من العيون عيونا",23,"ن",2,0],["للترمذي القولُ في سننٍ له","فاقرأ حُبِيتَ من الكتابِ منافعَه",24,"ع",2,0],["للتي كانت بهاء لا يحد","والتي ما مثلها في الناس ند",25,"د",1,1],["للتُّربِ صارَ مُقَبِّلاً وَمُخاطِباً","أ ترابُ هَلْ أَيقَظتَ مَنْ بِكَ يَهْجَعُ؟",26,"ع",1,0],["للتُّرَّهاتِ مَضَاجِعٌ بِصُدُورِنا","وَبِبابِ فِطْنَتِنا يَمُوتُ المَنْطِقُ",27,"ق",1,0],["للتائبين وذنب الحب طهّرهم","من ينصفُ الحبَّ (لم يعدم جوازيه)",28,"ي",2,0],["للتفح لا يرفع الهدى علما","بنصره خر من ذرى علم",29,"م",1,0],["للتباريح الحزينه / لإنتكاسات السنين","للجروح النازفات / من طعونٍ داخليه",30,"ي",2,0],["للتصعلك في زوايا الطاهرون الطيبين","للأمل بعيون صابر في ليالٍ سرمديه",30,"ي",2,0],["للتجافي والمنافي حدود بلا مكان","لانسكاب الدمع والشمع يطفيه الأنين",31,"ن",1,0],["للتباريح ان بدت ريح وطعوني ثمان","هبّت احزاني وجاني مثل ركض السنين",31,"ن",1,0]]}