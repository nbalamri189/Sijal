{"poems":[[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[49,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[66,"للترك مالي ترك","https://www.aldiwan.net/poem39673.html","المجتث"],[31,"إن أهوى العباد شخصا إلينا","https://www.aldiwan.net/poem41845.html","الخفيف"],[31,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[31,"هَيَّجَ القَلْبَ مَغَانٍ وَصِيَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18881&r=&rc=144",""],[456,"قد قنعنا أن نرقب الأحلاما","https://www.aldiwan.net/poem55874.html","الخفيف"],[456,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[477,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[498,"للتجلي من طيه أسرار","https://www.aldiwan.net/poem37646.html","الخفيف"]],"verses":[["لِلتُركِ ساعاتُ صَبرٍ يَومَ نَكبَتِهِم","كُتِبنَ في صُحُفِ الأَخلاقِ بِالذَهَبِ",0,"ب",1,0],["لِلتُقى عاقِبَةٌ مَحمودَةٌ","وَالتُقى المَحضُ لِمَن كانَ يَزِع",1,"ع",1,0],["لِلتُركِ مالي تَركُ","ما دينُ حُبِّيَ شِركُ",2,"ك",1,1],["لَلَّتي بِالبَلاطِ أَمسَت تَشَكّي","رَمَداً لَيتَهُ بِعَينِيَ حَلّا",3,"ل",2,0],["لِلَّتي قالَت لِجارَتِها","وَيحَ قَلبي ما دَهى عُمَرا",4,"ر",2,0],["للتجاريب في الأمور يداها رُبَّ","بانٍ ما كان بالأمس هادم",5,"م",1,0],["للتي قالتْ لأترابٍ لها","قطفٍ، فيهنّ أنسٌ وخفر",6,"ر",1,0],["للتهاني وصفٌ يخُصُّ وإن كا","نت سعاداتُكم تعُمّ العاما",7,"م",2,0],["للتهاني كلّ يومٍ فوقها","طارقٌ يوسع للشعر مجالَهْ",8,"ل",2,0],["للترك قد تركت رغما طراكية","واستنزفت دمعة حرا لمكتئب",9,"ب",1,0],["للتجلي من طيِّه أسرار","تنجلي من نماطها أدوار",10,"ر",1,1]]}