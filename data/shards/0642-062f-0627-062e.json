],[5725,"يا غصنك المياد","https://www.poetsgate.com/ViewPoem.aspx?id=205269",""],[5776,"مُبَاغَتة","https://www.poetsgate.com/ViewPoem.aspx?id=199378",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5858,"استعطفي البدر","https://www.poetsgate.com/ViewPoem.aspx?id=188026",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[5956,"تُمارس حُبَّين","https://www.poetsgate.com/ViewPoem.aspx?id=194741",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[6106,"إلى ربيع المولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=6310",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["قَد أَخصَبَت أُمُّ اللُغاتِ بِهِ","خِصباً أَدَرَّ لِأَهلِها الضَرعا",0,"ع",2,0],["قَد أَخصَبَ الإِقليمُ حينَ حَلَلتَهُ","وَالغَيثُ لا يَبقى عَلَيهِ مُحولُ",1,"ل",1,0],["قد أخلصوا لله حبّ بلادهم","فتسربلوا أبهى البرود من الثنا",2,"ن",2,0],["قد اختطّ فيه السيف للقوم خطّة","من العُنف لم يُمرر بساحتها رِفق",3,"ق",1,0],["قد اختلف البريّة واختلفنا","فكنّا نحن أسوأها اختلافا",4,"ف",2,0],["قَد أَخرَجَ اللَهُ قَسراً مِن مَعاقِلِهِم","أَهلَ الحُصونِ وَأَصحابَ المَطاميرِ",5,"ر",1,0],["قد أخلقت جسدِي أيدي الأسى فمتى","للأرضِ ترمي بهذا الملبَسِ الخلِق",6,"ق",1,0],["قد أخلق الناس الهدايا كلها","إلا الكلام فإنه لم يَخلَقِ",7,"ق",1,1],["قَد أَخلَقَت كَفُّ السِياسَةِ عَهدَها","إِنَّ السِياسَةَ لا تُراعي مَوثِقا",8,"ق",2,0],["قَد اِختَفَت ذاتي في بُردَتي","فَما يُرى الخَلقُ سِوى بُردَتي",9,"ي",1,0],["قَدْ أَخْرَسَتْهُ مَرارَةُ","القَلْبِ التَّعيسِ الظَّالمهْ",10,"ه",1,0],["قَد أَخلَقتَني صُروف أَنتَ تعلمها","وَقالَ موردها ما لي بِها صدرُ",11,"ر",1,0],["قد اخذت تغرب شمسي به","شاحبة صفراء كالورس",12,"س",1,0],["قد اخترمت اعز الناس قاطبة","علي تقسو فهلا كنت مخترمي",13,"م",2,0],["قد اخرجت دمعي الى اعيني","لواعج للهم في داخلي",14,"ل",2,0],["قد اخرجت للناس زخرفها الثرى","والسهل والآكام والوهدان",15,"ن",1,0],["قد أخذنا الدهر منه رضى","لم يحاربنا ولم يجر",16,"ر",1,0],["قَدِ اِختارَ لَكَ الشَلحَ","وَما كُنتَ لِتَختارَه",17,"ر",2,0],["قَد أَخَذنا في الصِناعاتِ المَدى","وَبَنَينا في الأَوالي ما خَلَد",18,"د",1,0],["قَد أَخطَأَ النَجمَ ما نالَت أُبُوَّتُهُ","مِن سُؤدُدٍ باذِخٍ في مَظهَرٍ سَنِمِ",19,"م",1,0],["قَدِ اِختَرتُكَ الأَملاكَ فَاِختَر لَهُم بِنا","حَديثاً وَقَد حَكَّمتُ رَأيَكَ فَاِحكُمِ",20,"م",1,0],["قَد أَخلَقَ المَجدَ في قَومٍ لِنَقصِهِمِ","عَنهُ وَأَخلاقُهُ مَرضِيَّةٌ جُدُدُ",21,"د",1,0],["قَد أَخَذنا مِنَ التَلاقي بِحَذٍّ","وَالتَلاقي في النَومِ عِدلُ التَلافي",22,"ي",1,0],["قَد أَخَذناهُ مِن ذَويهِ وَلَكِن","كُلُّ قَلبٍ في أَسرِهِ مَأخوذُ",23,"ذ",1,0],["قَد أَخلَقَت ثوبَ صَبري فيكَ حادِثَةٌ","أَضحى بِها لِثِيابِ الحُزنِ تَجديدُ",24,"د",1,0],["قدْ أخذَ الثأرَ لآبائِهِ","يا قومَنا لا تهملوا أمرَهُ",25,"ر",2,0],["قَد أَخَذ النَوم جفنها مَللا","بَعد اِنتَظار تَرى أَنشعرها",26,"ر",3,0],["قَد أَخلَقَت عَهدَها مِن بَعدِ جِدَّتِهِ","وَكَذَّبَت حُبَّ مَلهوفٍ وَما كَذَبا",27,"ب",2,0],["قَدِ اِختارَهُم عُقماً عَواقِرَ لِلوَرى","وَمِن ثَمَّ وَلّاهُم سَنامَ القَبائِلِ",28,"ل",1,0],["قَدْ أخَذَ المُسْلِمُونَ عَكاً","وَأَشْبَعوا الكافِرِينَ صَكا",29,"ك",2,1],["قَد أَخَذَ اللَهُ مِن رَقاشِ عَلى","تَركِهِمُ المَجدَ بِالمَواثيقِ",30,"ق",1,0],["قَد أَخلَقَتهُ اللَيالي فَاِترُكيهِ لَقىً","فَما يَزينُكِ لُبسُ المُخَلقِ البالي",31,"ل",2,0],["قَد اِختَلَّ الأَنامُ بِغَيرِ شَكٍّ","فَجَدّوا في الزَمانِ وَأَلعَبوهُ",32,"ب",3,1],["قد اخضلَّ روض الشعر حتى حمدته","وَحَتى رأَيت الزهر يبسم للزهر",33,"ر",1,0],["قَدْ أَخَذَ النَّوْمَ وَمَا رَدَّهُ","وَاسْتَلَبَ الْقَلْبَ وَمَا عَوَّضَا",34,"ض",2,0],["قَدْ أَخْلَفَتْ بِسُكُونِهَا وَصَفائِهَا","فِعْلَ النُّجُومِ مُثِيرَةِ الأَنْوَاءِ",35,"ا",2,0],["قَدِ اخْتَارَكَ الرَّحْمَنُ مَوْضِعَ فَضْلِهِ","إِذَا عَزَّ مَوْصُولٌ فَقَدْ جَلَّ وَاصِلُهْ",36,"ل",2,0],["قد أخذنا عن الرئيسين درسًا","في سُموِّ الأخلاق عند النضال",37,"ل",1,0],["قد اختصصتم بشأن كله شرف","هل تسمحون بأن يبقى لنا شرعا",38,"ع",2,0],["قد أخجلَ الظالمينَ الناسَ مُحتشِمٌ","من نفسِه في سبيلِ الناسِ ينتقم",39,"م",1,0],["قَدْ أخَذْنَا مِنَ التَّلاقي بِحَظٍّ،","وَالتّلاقي في النّوْمِ عَدْلُ التّلاقي",40,"ق",2,0],["قَد أَخْلَقتني صُروف أَنتَ تعلمُها","وغالَ موردَ آمالي بها كَدرُ\"2\"",41,"ر",1,0],["قد اخلص الحب من اهداك عيبك لا","مطر مداج على العواراء تمويها",42,"ي",3,0],["قد اختصرت دنيا بقلبي وعالم","كما اختصر العلم الشتيت رقيم",43,"م",1,0],["قد اخطاؤا النهج السوي وابطلت","عزم العزائم منهم الآمال",44,"ل",1,0],["قد اختارَك الرحمن فضلاً ببقعةٍ","مباركة قدست عن كلِّ مُلحدِ",45,"د",1,0],["قد أخرستني فما أسطيع أشكرها","ما قدر شكري وما قولي وما عملي",46,"ل",2,0],["قَدِ اِختَصروا بالجهلِ دين مُحمّدٍ","وَما تَرَكوا من عُشرِ أحكامهِ العُشرا",47,"ر",2,0],["قَدِ اِختارَ مِن كلِّ الخَلائقِ رسلهُ","لِتَعريفِهم ما كفَّ عَن علمهِ الفِكرا",48,"ر",2,0],["قد اخضرَّتِ الدُّنيا لنا وتَزَيَّنَتْ","وعَمَّتْ على كلِّ الورى بركاتُها",49,"ت",3,0],["قَد أَخصَبَت أَرضُ العِراقِ وَإِنَّني","لَأَرودُ مِنها في جَديبٍ ما حِلِ",50,"ل",1,0],["قد اخترت رأيا أن اوفر خاطري","عليه وهد الرأي رأي موفق",51,"ق",1,0],["قد أخرجت آدمَ تفاحةٌ","من جنّةِ النعمةِ والخلد",52,"د",1,0],["قد اخترمَت نفسي الكبيرةُ جسمَها","كما فلَّ طولُ الضَّربِ سيفاً مهنَّدا",53,"د",2,0],["قَدِ اخْشَوشَنُوا إِلا حَواشِيَ أُرْهِفَتْ","رِقاقاً وآداباً صَغَتْ نَحْوَهُم صَغْيَا",54,"ي",2,0],["قَد أخجلَ الشَّمسَ أنَّ الشَّمسَ غارِبَةٌ","وَمُذ تَطَلَّعتِ لم يَغْرُب مُحَيَّاكِ",55,"ك",1,0],["قَد أَخَذَ السَقامُ مِن أَعضائِهِ","لِضَعفِهِ أَضعافَ ما مِنهُ تَرَك",56,"ك",1,0],["قد أَخجل المرّانَ حالي قدِّهِ","وَالبيضَ في الأَجفان سود جفونِهِ",57,"ن",2,0],["قد أَخفقوا في سعيهم","عساكِ لن تخيَّبي",58,"ب",2,0],["قَد أَخلَفَ الصَبرُ ميعادي وَأَنجَزَ بِالأَسى","الوَعيدَ لِقَلبي بَعدُ مَحبوبي",59,"ب",2,1],["قَد أَخَذنا عَنكُم رِواية صدق","هِيَ حَقٌّ لِأَنَّها ذات ثَبتِ",60,"ت",1,1],["قَد أَخَذنا اِرتفاعها فإذا هي","دَرجات أَتَت عَلى غَير سَمتِ",60,"ت",1,0],["قَد أَخصَبت هممي بِهِ وَلرُبَّما","أَنزَلَت طارِقها بِوادٍ مجدبِ",61,"ب",1,0],["قد أخذتم منِّي الفؤاد فردُّوا","في تَدانيكم عَليَّ فؤادي",62,"د",2,0],["قد أخجل الخطيّ لين قوامه","وج