x?id=128845",""],[5376,"معللتي","https://www.poetsgate.com/ViewPoem.aspx?id=188268",""],[5409,"سلب الخريف البان وارف ظله","https://www.poetsgate.com/ViewPoem.aspx?id=155450",""],[5412,"فعج صاح بالعوج الطلاح إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=181280",""],[5442,"دع الصب يدمع منه المآقيا","https://www.poetsgate.com/ViewPoem.aspx?id=114761",""],[5447,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=208363",""],[5615,"على مضض ...!","https://www.poetsgate.com/ViewPoem.aspx?id=189551",""],[1680,"أيا نفحة الألطاف من لطف ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=108882",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5725,"وأْد الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=197222",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5842,"عصفورة الأمل \\محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=150624",""],[5906,"بي وجع","https://www.poetsgate.com/ViewPoem.aspx?id=188235",""],[5956,"الظلم والطيبون","https://www.poetsgate.com/ViewPoem.aspx?id=192334",""],[6093,"الكُلُّ يخطيءُ تارةً ويُصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205649",""],[463,"نعم هذه يا دهرُ أمُّ المصائبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59966&r=&rc=22",""]],"verses":[["فعُجْ على خِيَمٍ لَفّتْ ولائِدُها","أطْنابَهُنَّ بأعْرافِ السّراحيبِ",0,"ب",1,0],["فَعَجِبتُ مِنها حينَ زَلَّت عَينُه","عَن ماجِدٍ طَلقِ اليَدَينِ شَمَردَلِ",1,"ل",1,0],["فعجبنا فالقضيّا","كل احد يقول ويسئل",2,"ل",1,0],["فعجت على الطلول بها مكبّا","أسائلها وقد ذهب الرفاق",3,"ق",1,0],["فَعَجَّت وَأَلقَت لِلجِرانِ رَجيلَةً","لَأَنظُرَ ما زادُ الكَريمِ المُسافِرِ",4,"ر",1,0],["فعجِّل كسائي طيِّباً نحو شاكرٍ","سيُجنيك من حُرِّ الثناء الأطايِبا",5,"ب",2,0],["فَعُجْمتُهُ كِتْمَانُهُ أينَ عَهْدُهُ","وتَوْلِيدُهُ عِرْفَانُه أيْنَ يَعْمِدُ",6,"د",1,0],["فعجّل بالكساء فإن قلبي","إليه مستهامٌ مستطار",7,"ر",1,0],["فعجله بالسيف كي تستري","ح إن كنت من قتله في سعه",8,"ع",2,0],["فعجّل ولا تمطلْ بما أنت أهلُه","فخيرات أفعال الفتى في عِجالِها",9,"ل",3,0],["فعجِّل الغوثَ إنا منك نأمله","يا سيدَ الغوث بل يا سيد اليمن",10,"ن",1,0],["فَعَجِبتُ مِمَّن نامَ مِلءَ جُفونِهِ","وَالكَونُ يَشهَدُ مِثلَ هَذا المَشهَدِ",11,"د",1,0],["فَعَجِبَت مِنّي كَيفَ أَذكُرُها","وَقَد اِنقَضى حَولانِ مِن عُمري",12,"ر",2,0],["فَعَجِبتُ كَيفَ ذَبَحتُ ثَورِيَ في الضُحى","وَالهِندُ ساجِدَةٌ هُناكَ لَدَيهِ",13,"ي",2,0],["فَعَجِبتُ كَيفَ تَغَيَّرَت","مِنهُ خَلائِقُهُ الدَمائِث",14,"ث",1,0],["فَعَجِبتُ مِمّا قَد سَمِع","تُ وَحُقَّ لي أَن أَعجَبا",15,"ب",2,0],["فَعُجنا عَلى رَسمٍ بِرَبعٍ تَجُرُّهُ","مِنَ الصَيفِ جَشّاءُ الحَنينِ نَؤوجُ",16,"ج",1,0],["فَعُجنَ عَلَينا مِن عَلاجيمَ جِلَّةٍ","لِحاجَتِنا مِنها رَتوكٌ وَفاسِحُ",17,"ح",1,0],["فَعُجنا لِذِكراها وَتَشبيهِ صَوتِها","قِلاصاً بِمَجهولِ الفَلاةِ صَوادِيا",18,"ي",2,0],["فَعَجَّتْ بقلبي دماءُ الشَّبابِ","وضجَّت بصدري رياحٌ أُخَرْ",19,"ر",1,0],["فَعَجَنَت في اللَبَنِ اللُبابا","كَما تَرانا نُطعِمُ الكِلابا",20,"ب",2,0],["فَعَجِبتُ حَتّى ما عَجِبتُ مِنَ الظُبى","وَرَأَيتُ حَتّى ما رَأَيتُ مِنَ السَنا",21,"ن",2,0],["فَعَجِبتِ مِن حالَينِ خالَفَ مِنهُما","رَيبُ الزَمانِ وَما رَأَيتِ عَجيبا",22,"ب",2,0],["فَعُج بِوِدادٍ حَسبَ ما كُنتُ واثِقاً","وَلا تَكُ وَقّافاً كَمَن لَيسَ يُعرَفُ",23,"ف",1,0],["فَعُجتُها قِبَلَ الأَخيارِ مَنزِلَةً","وَالطَيِّبي كُلِّ ما اِلتاثَت بِهِ الأُزُرُ",24,"ر",1,0],["فَعُجنا المَطايا عَن شَقائِقِ قَوبَعٍ","وَأَنّى مَنافٌ مِن تَناوُلِ دارِمِ",25,"م",1,0],["فَعَجِبتُ من غُصْنٍ تُدَافِعُهُ الصَّبا","بِالنهدِ أَثمَر وَالثنايا نَوّرَا",26,"ر",2,0],["فَعُجنا فَعاجَت ساعَةً وَتَكَلَّمَت","فَظَلَّت لَها العَينانِ تَبتَدِرانِ",27,"ن",1,0],["فَعَجِبتُ مِنها إِذ تَقولُ لَنا","يا صاحِ ما هاذي مِنَ الإِنسِ",28,"س",1,0],["فَعَجِبنَ مِن ذاكُم وَقُلنَ لَها اِفتَحي","لا شَبَّ قَرنُكِ مَفتَحاً مِن بابِ",29,"ب",1,0],["فَعُج تَتَصَفَّح بَديعَ البَديعِ","وَتَلمَح سَلامَةَ شِعرِ السَلامي",30,"م",2,0],["فَعَجِّلوا بِالشُربِ قَد أَمسَكَت","مِن قَبلِ أَن تَلحَقَها النَوبَه",31,"ه",1,0],["فعَجِبتُ كيفَ تخالَفَ القَدَرانِ في","عُقْباهُما وتَشابَهَ الأمَلانِ",32,"ن",1,0],["فعجبتُ من أن لا تَميدَ الأرضُ من","أقطارِها وعجبْتُ أن لا تُخسَفا",33,"ف",2,0],["فَعُج يَدَكَ اليُمنى لِتَشرَبَ طاهِراً","فَقَد عِيَفَ لِلشُربِ الإِناءُ المُعَوَّجُ",34,"ج",1,0],["\"فعجبت حتى ما عجبت من الظبى","ورأيت حتى ما رأيت، من السنى\"",35,"ن",2,0],["فَعَجِبتُ مِنها حينَ زَلَّت عَينُها","عَن ماجِدٍ طَلقِ اليَدَينِ شَمَردَلِ",36,"ل",1,0],["فَعَجِبْتَ أَنَّي صَاغَ مِنْ تِلْكَ اللُّغَى","كَلِمَاتِ إِنْشَادٍ وَلَفْظَ غِنَاءِ",37,"ا",2,0],["فَعَجِّلي بِرَسولٍ مِنكِ مُؤتَمَنٍ","حَتّى يُخَبِّرَكُم يا فَوزُ بِالخَبَرِ",38,"ر",1,0],["فعجبت: كيف أسرت مصرًا بعدما","حررتها من رق الاستعباد؟!",39,"د",1,0],["فَعَجِبتُ حَتّى ما عَجِبتُ مِنَ الظُبا","وَرَأَيتُ حَتّى ما رَأَيتُ مِنَ السَنا",40,"ن",2,0],["فَعُجْنَا المَطايَا عَنْ شَقائِقِ فَوْبَعٍ،","وَأنّى مَنَافٌ مِنْ تَنَاوُلِ دارِمِ",41,"م",1,0],["فعجِّل الغوثَ إنا منك نأمله","يا سيدَ الغوث يا سيد اليمن",42,"ن",1,0],["فَعُجْنَا، فَعَاجَتْ ساعَة ً، فَتَكَلَّمَتْ","فظَلَّتْ لَها العَيْنَانِ تَبْتَدِرَانِ",43,"ن",1,0],["فَعَجِبْتُ مِنْها إذْ تَقُولُ لَنَا:","يا صاحِ، ما هذي من الأنسِ",44,"س",1,0],["فعُجتُ على الطلول بها مُكِباً","أسير عَضَّ ساعده الوَثاق",45,"ق",1,0],["فعجبت منها وهي تعلم أنني","لم أثن عنها كيف عني تنثني",46,"ن",2,0],["فَعَجِبتُ كَيفَ أَقَرَّ أَنَّكَ واحِدٌ","في الناسِ مَن ما دينُهُ التَوحيدُ",47,"د",1,0],["فعَجِبتُ كيف رَمَيْتِ يومئذٍ","سهما فعادَ لوقِته هدفا",48,"ف",2,0],["فعَجَلٌ في مهلٍ","ومهلٌ في عَجَلِ",49,"ل",1,0],["فَعَجِّلْ مُنَايَ وَسَكِّنْ حَشَايَ","فَقَدْ قَرْطَسَتْهُ سِهَامُ الزَّمَنْ",50,"ن",1,0],["فَعجِّل به جُوداً فمالي حاجةٌ","سواه نباتاً يُثمِرُ الحمدَ والشكرا",51,"ر",2,0],["فعجّل وقل ربّي عجلت لبغيتي","لترضى فعندي حيّة النفس لَسّاعه",52,"ع",2,0],["فعَجِبتُ كيفَ الأرضُ لم تخسَف ولم","يَنهَدَّ يَذبُلُ خِشيةَ وشمام",53,"م",1,0],["فعجل بافتقادك لي فاني","ضعفت جوار حار وَكبرت سنا",54,"ن",2,0],["فعُج بشرقيِّ وادي الرَمل من إضم","حيثُ الغضا والأَضى والرندُ والبانُ",55,"ن",1,0],["فعجلته لما انتدبت 