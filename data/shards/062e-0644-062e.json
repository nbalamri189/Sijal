{"poems":[[56,"خلخالها يسحب في ساقها","https://www.aldiwan.net/poem27521.html","السريع"],[42,"إن الخليط الذين كنت","https://www.aldiwan.net/poem42265.html","المنسرح"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[119,"خل خلي من الى الغي انتمى","https://www.aldiwan.net/poem40597.html","عموديه"],[290,"طربت بنا ريح النسيم","https://www.aldiwan.net/poem39376.html","مجزوء الكامل"],[382,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[505,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[519,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[572,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122564","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107215","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120007","المنسرح"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110114","الخفيف"],[4790,"سمفونية الخلخال","https://www.poetsgate.com/ViewPoem.aspx?id=144355",""],[4869,"موضه جديده","https://www.poetsgate.com/ViewPoem.aspx?id=151666",""]],"verses":[["خِلخالُها يُسحَبُ في ساقِها","وَقُرطُها في الجيدِ ما يَنطِقُ",0,"ق",1,1],["خِلخالُها مُشبَعٌ وَدُملُجُها","وَالكَشحُ مِنها وِشاحُهُ قَلِقُ",1,"ق",1,0],["خَلّ خِلّي عنكَ ألقاباً بِها","جيء مَيْناً وانْجُ مِنْ بدعِة جَي",2,"ي",1,0],["خل خلي من الى الغي انتمى","وتباعد عن جهول ظلما",3,"م",2,1],["خل خلا بخليله","وعليهما اطغ الخفير",4,"ر",1,0],["خَلِّ خلِّّي فدتك نفسي مديحاً","لأناسٍ أصولهنَّ تراب",5,"ب",1,0],["خلُّ خلِّ الوجود عنك سواهم","فسوى سرِّ سيرهم أوهام",6,"م",1,0],["خلخالُها يُخفي الأنينَ وقرطُها","قلِقٌ كقَلْبِ الصّبِّ في الخَفقانِ",7,"ن",1,0],["خَلْخَالُهُ فِي نَحْرِهِ وَلِسَانُهُ","فِي أُذُنِهِ وَجَبِيْنُهُ مِنْ أَسْفَلِ",8,"ل",1,0],["خُلخِلَت عَضَّ الخلاخيل ساقَها","وإن وُشِّحَت جالَت على خَصرِها الوشُح",9,"ح",1,0],["خَلِّ خِلي العَذلَ واغضُض عَن مَلامِي","فَمَعاذَ اللَّه أَن أُثنِي زِمامِي",10,"ي",1,1],["خلخاله صامت ينافي","خصرا له ناطق الوشاحِ",11,"ح",1,0],["خل خل اللهو وابتدرن","بمسير فيه والتزم",12,"م",1,0],["خَلِّ خِلِّ العَنَا بما انتَ تُعنَى","من زَمانٍ هُوَ البِلَى والبلايا",13,"ا",3,0],["خلْخالها بيدي تَكوَّنَ جامِداً","فَغَدا بِمَلْمَسِها رَقيقاً والِها",14,"ل",3,0],["خلٍ خفوقي وين يبغى يوديه","اقفى معاه بروح يآهي عنيده",15,"د",2,0]]}