{"poems":[[54,"خلخالها يسحب في ساقها","https://www.aldiwan.net/poem27521.html","السريع"],[40,"إن الخليط الذين كنت","https://www.aldiwan.net/poem42265.html","المنسرح"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[116,"خل خلي من الى الغي انتمى","https://www.aldiwan.net/poem40597.html","عموديه"],[286,"طربت بنا ريح النسيم","https://www.aldiwan.net/poem39376.html","مجزوء الكامل"],[378,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[501,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[515,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[568,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"]],"verses":[["خِلخالُها يُسحَبُ في ساقِها","وَقُرطُها في الجيدِ ما يَنطِقُ",0,"ق",1,1],["خِلخالُها مُشبَعٌ وَدُملُجُها","وَالكَشحُ مِنها وِشاحُهُ قَلِقُ",1,"ق",1,0],["خَلّ خِلّي عنكَ ألقاباً بِها","جيء مَيْناً وانْجُ مِنْ بدعِة جَي",2,"ي",1,0],["خل خلي من الى الغي انتمى","وتباعد عن جهول ظلما",3,"م",2,1],["خل خلا بخليله","وعليهما اطغ الخفير",4,"ر",1,0],["خَلِّ خلِّّي فدتك نفسي مديحاً","لأناسٍ أصولهنَّ تراب",5,"ب",1,0],["خلُّ خلِّ الوجود عنك سواهم","فسوى سرِّ سيرهم أوهام",6,"م",1,0],["خلخالُها يُخفي الأنينَ وقرطُها","قلِقٌ كقَلْبِ الصّبِّ في الخَفقانِ",7,"ن",1,0],["خَلْخَالُهُ فِي نَحْرِهِ وَلِسَانُهُ","فِي أُذُنِهِ وَجَبِيْنُهُ مِنْ أَسْفَلِ",8,"ل",1,0]]}