{"poems":[[55,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[99,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[71,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[99,"ليالي الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=17271",""],[240,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[422,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[438,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[449,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[563,"خادم الله يخدم العز بابه","https://www.aldiwan.net/poem33523.html","الخفيف"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83320","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48758","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64080","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119928","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95510","الكامل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128764","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93540","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93530","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134198","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71339","الخفيف"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111049","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[4830,"ياموسى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=198352",""],[5725,"ولجارتي عتب عليّ","https://www.poetsgate.com/ViewPoem.aspx?id=192275",""],[5741,"لك طرفُ طرفٍ حمى من حسنك السرحه","https://www.poetsgate.com/ViewPoem.aspx?id=187440",""],[5956,"هجاء","https://www.poetsgate.com/ViewPoem.aspx?id=192939",""],[5956,"يا خالقَ الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=194028",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""]],"verses":[["لَكَ طَبعٌ تَعَرَّفَتهُ اللَيالي","وَاِمتَرى فيهِ كُلُّ قارٍ وَبادي",0,"د",2,0],["لك طلعة البرءِ المرج","جَى بعد مستعصى السقم",1,"م",1,0],["لكِ طرفٌ يروي روايةَ مكحو","لٍ وإحسانُهُ عنِ ابنِ كثيرِ",2,"ر",1,0],["لك طلعةُ البرِ المرجَّى","بعد مستعصى السقمْ",3,"م",1,0],["لَكَ طَرفٌ تَعَلَّمَ ال","سَيفُ مِن لَحظِهِ المَضا",4,"ض",2,0],["لك طرف أحمديٌّ إنْ رمى","نبله العزم يشق الحجرا",5,"ر",2,0],["لك طيبُ الهناءِ هَنَّأَكَ اللَّ","هُ وللحاسدينَ خُبْثُ الهَناتِ",6,"ت",1,0],["لك طاعتي فتحكمي وتأمري","فلقد أطيع لما يشير خيالك",7,"ك",1,0],["لك طوبى إن كنت يوما تراه","راضياً عنك قد أحاط حجابه",8,"ب",2,0],["لك طوبى يوما إذا فزت بالحجّْ","فاقصد الركب إن تجد شوقهم لجّْ",9,"ج",1,0],["لَكَ طَبعٌ سامَ وَوَجهٌ وَسيمٌ","أَدبَرَ الظُلمَ مِنهُما وَالظَلامُ",10,"م",1,0],["لك طبع يرى الغنى عنده العا","ني ويلقى الشفاء فيه السقيم",11,"م",1,0],["لك طاعةٌ ومحبةٌ من أمة","أغنيتها لسواك عن أن تذعنا",12,"ن",2,0],["لك طَرْفٌ مذ كان كان جموحاً","وفؤادٌ مذ كان كان مشوقا",13,"ق",2,0],["لك طرة كالليل إن أسدلتها","خفي الصبلاح وفرَّة تجلو الظلم",14,"م",1,0],["لك طارفُ المجد الذى","بتليده يغشى ذُراك",15,"ك",1,0],["لك طبع ارقُّ من نفحة الورد","ووجه من ابلج الصبح اسنى",16,"ن",2,1],["لَكَ طيب أَنفاس يَرق هُبوبها","كَنَسيم نَجد إِذ يَرق هُبوبا",17,"ب",2,0],["لَكَ طَأطَأت دُول الضلال رقابها","قَدها فسيفك قَد أَذَّل صعابها",18,"ب",3,1],["لك طول البقا يخفف عنا","الم الحزن والأسى حيث عنا",19,"ن",2,1],["لَكَ طَرْفي حِمَىً وَقَلْبِيَ بَيْتُ","فِيهِمَا عَهْدَكَ القَدِيمَ خَبَيْتُ",20,"ت",1,1],["لك طبع كطبعه في المعاني","وعلى طبع خلها الطبيعة تجري",21,"ر",2,0],["لكَ طرفٌ يسبي الغزالَ وقّدٌ","يفضحُ الغصنَ والقنى العسّالا",22,"ل",2,0],["لك طأطأتْ بيضُ العواليَ هامةً","والمُكرماتُ قد اقتفَتْ ممشاكا",23,"ك",2,0],["لك طلعة عند العتاب مهابة","في خافقي منها الحناجر تنشفُ",24,"ف",1,0],["لك طرفُ طرفٍ حمى من حسنك السرحه","كم قد أغار على العشاق في صبحه",25,"ه",1,1],["لك طلعةٌ كالأتقياء وَجَاهَةً","لكنْ إلى القُدُّوسِ لستَ بمُهْطعِ",26,"ع",1,0],["لك طاعتي أنا ما عصِيتك راضياً","لكنْ لأني عاجزٌ أن أصبِرا",27,"ر",2,0],["لَكَ طُولُ البَقَاءِ فابْقَ وأُفْدِيْ","كَ أنَا يا ابْنَ سَالمٍ والأنَامُ",28,"م",1,0]]}