{"poems":[[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[97,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[97,"ليالي الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=17271",""],[233,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[413,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[429,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[441,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[556,"خادم الله يخدم العز بابه","https://www.aldiwan.net/poem33523.html","الخفيف"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"]],"verses":[["لَكَ طَبعٌ تَعَرَّفَتهُ اللَيالي","وَاِمتَرى فيهِ كُلُّ قارٍ وَبادي",0,"د",2,0],["لك طلعة البرءِ المرج","جَى بعد مستعصى السقم",1,"م",1,0],["لكِ طرفٌ يروي روايةَ مكحو","لٍ وإحسانُهُ عنِ ابنِ كثيرِ",2,"ر",1,0],["لك طلعةُ البرِ المرجَّى","بعد مستعصى السقمْ",3,"م",1,0],["لَكَ طَرفٌ تَعَلَّمَ ال","سَيفُ مِن لَحظِهِ المَضا",4,"ض",2,0],["لك طرف أحمديٌّ إنْ رمى","نبله العزم يشق الحجرا",5,"ر",2,0],["لك طيبُ الهناءِ هَنَّأَكَ اللَّ","هُ وللحاسدينَ خُبْثُ الهَناتِ",6,"ت",1,0],["لك طاعتي فتحكمي وتأمري","فلقد أطيع لما يشير خيالك",7,"ك",1,0],["لك طوبى إن كنت يوما تراه","راضياً عنك قد أحاط حجابه",8,"ب",2,0],["لك طوبى يوما إذا فزت بالحجّْ","فاقصد الركب إن تجد شوقهم لجّْ",9,"ج",1,0]]}