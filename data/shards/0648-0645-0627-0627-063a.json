{"poems":[[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[70,"أبى الله إلا أن تسود وتفضلا","https://www.aldiwan.net/poem42765.html","الطويل"],[85,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[28,"يا سلم كم من جبان قد صبرت به","https://www.aldiwan.net/poem5187.html","البسيط"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10807","الطويل"],[117,"أسائلكم لمن جيش لهام","https://www.aldiwan.net/poem4335.html","الوافر"],[141,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[158,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[162,"ديار الحي بالرس","https://www.aldiwan.net/poem67584.html","الهزج"],[235,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[295,"سقى تلك الأباطح والرمالا","https://www.aldiwan.net/poem33190.html","الوافر"],[296,"أَسيغوا البث واحتبسوا الزفيرا","https://www.aldiwan.net/poem36267.html","عموديه"],[364,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[573,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"]],"verses":[["وَما أَغرَبَت فيكَ اللَيالي وَإِنَّها","لَتَصدَعُنا مِن كُلِّ شِعبٍ وَتَثلِمُ",0,"م",1,0],["وما أغْرَقَ المُدَّاحُ إلا غَلا بِهِ","وراء مَغَالي مَدْحِهِمْ فيه مَخْلدُ",1,"د",1,0],["وَما أَغمِدَ الهِندِيُّ إِلّا لَيُنتَضى","وَما ثُقِّفَ الخَطِّيُّ إِلّا لِيُحمَلا",2,"ل",2,0],["وَما أَغناهُ عَمَّن قالَ فيهِ","وَما أَغناكَ عَن هَذا التَرامي",3,"م",2,0],["وَما أَغَبَّ تَميماً فارِسٌ بَطَلٌ","مِن مازِنٍ يَرتَدي بِالنَصرِ مَن نَصَرا",4,"ر",2,0],["وَما اِغطَوطَشَ الغِربيبُ وَاِسوَدَّ لَونُهُ","وَما مَرَّ طولَ الدَهرِ ذِكرُكِ في صَدري",5,"ر",2,0],["وما أغنت قِسِيِّ الغُرِّ عَنها","فليسَت تدفَعُ القدرَ السِّهامُ",6,"م",1,0],["وَما أَغنَوهُمُ وَبَنو كِلابٍ","عَشِيَّةَ رُعتَهُم مُتَظافِرينا",7,"ن",2,0],["وما أغمدت إلا وقد ظلت العدى","ترى السلم منها للسلامة سلّما",8,"م",2,0],["وَما أَغرَبتُ بَل أَفلَق","تُ إِنَّ المُغرِبَ المُفلِق",9,"ق",1,0],["وَمَا اغْتَرَّتْ بِمَا اعْتَزَّتْ أُنَاسٌ","بِهِ مِنْ سُؤْدَدٍ لأَِبٍ وَجَدِّ",10,"د",1,0],["وَما أَغرى الفؤادَ بحبِّ خودٍ","مَنوعٍ لن تُنيل ولن تُنالا",11,"ل",2,0],["وما أَغفلته ميْتاً ولكنْ","ربضتَ ببابه أسداً هصورا",12,"ر",2,0],["وَما أَغلَقتُ عَنكُم كَفَّ يُسري","وَلَم أَكشِف إِلَيكُم وَجهَ عُسري",13,"ي",1,0],["وما أُغْمِدت عَنْهم سيوفُك أَوْ أَتَتْ","على الغِرِّ والشَّيخِ المغَفَّلِ والكَهْلِ",14,"ل",1,0]]}