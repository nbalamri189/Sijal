{"poems":[[65,"ووغد حديث بالخصاصة عهده","https://www.aldiwan.net/poem45862.html","الطويل"],[53,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[240,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[287,"إذا كنت في جلق راجلا","https://www.aldiwan.net/poem32429.html","المتقارب"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145553","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201054","الوافر"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110784","الطويل"]],"verses":[["وَوَغْدٍ حَديثٍ بِالخَصاصَةِ عَهْدُهُ","أَلَظَّ بِهِ الإِثْراءُ حَتَّى تَبَذَّخا",0,"خ",2,1],["ووغدٍ وهبتُ له حُكْمَهُ","وأمَّلتُ منكودَ موهوبِهِ",1,"ب",2,0],["ووغدٍ تخيَّرَ أمثالَه","فوغداً أهرَّ ووغداً شلا",2,"ا",1,0],["وَوَغى نَهَضتَ بِعِبءِ ما حُمِّلتَهُ","مِنها وَقَوّادُ الجَرادِ بَدادُهُ",3,"د",2,0],["وَوَغدٍ غَدا راكِباً سابِقاً","لَئيماً أَضَرَّ بِماشٍ كَريمِ",4,"م",1,0],["ووغد إن أردت له عقابا","عفا عن ذنبه حسبي وديني",5,"ن",2,1],["ووغد ذمني فصممت أُذني","وأنفي عن كلام كالهراء",6,"ا",2,1],["ووغد أتى في عسكر من حشيشة","يقاد وعيناه على خصمه حمرا",7,"ر",2,1]]}