px?id=197412",""],[5533,"جَفانِي النَّوْم","https://www.poetsgate.com/ViewPoem.aspx?id=176665",""],[5533,"أُحِبُّ حَدِيثَها","https://www.poetsgate.com/ViewPoem.aspx?id=179990",""],[5542,"قراءة في وجة امرأة شو هاء..!","https://www.poetsgate.com/ViewPoem.aspx?id=1655",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[482,"لكم مِن فؤادي شاهدٌ ليس يكذبُ","https://www.poetsgate.com/ViewPoem.aspx?id=111424",""],[5720,"أَبَا حَسَنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204335",""],[5739,"قصيده تنتظر شاعر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131709",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[391,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","https://www.poetsgate.com/ViewPoem.aspx?id=4653",""],[6068,"ل بُونَةَ فِي قَلْبِي غَرَامٌ مُطَابِق -26-","https://www.poetsgate.com/ViewPoem.aspx?id=175807",""],[4442,"يلوذ بركن بينك من يضام","https://www.poetsgate.com/ViewPoem.aspx?id=171202",""],[6082,"تمادت طويلا","https://www.poetsgate.com/ViewPoem.aspx?id=180042",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6185,"موّالُ خاشع !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86945&r=&rc=5",""],[5567,"ذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69072&r=&rc=10",""]],"verses":[["لها في غيهب الهيجاء غمد","يسيل الصبح من فمه لعابا",0,"ب",2,0],["لَها في الرَأسِ سَوراتٌ يُطاطي","لَها الإِنسانُ كَالرُجُلِ الأَميمِ",1,"م",1,0],["لَها في الحَشا حافِزٌ كُلَّما","جَرى الدَمعُ دَلَّ عَلَيهِ وَنَم",2,"م",1,0],["لَها فَساطيطٌ عَلى","ذُرى الرَوابي وَخِيَم",3,"م",1,0],["لَها في فُرجَةِ الفَجرِ اِختِلاطٌ","يَرُدُّ الصُبحَ مِن رَهَجٍ غِيابا",4,"ب",2,0],["لَها في مَحاني ذَلِكَ الشِّعبِ مَنزِلٌ","لَئِن أَنكَرَتهُ العَينُ فالقَلبُ عارِفُ",5,"ف",1,0],["لَها فتَكاتٌ في القُلوبِ كأنّها","سُيوفُ المُلوكِ الغالِبينَ بَني نَصْرِ",6,"ر",1,0],["لَها فَخِذانِ تَحفِزانِ مَحالَةً","وَصُلباً كَبُنيانِ الصَفا مُتَلاحِكا",7,"ك",2,0],["لَها فَمٌ مُلتَقى شِدقَيهِ نُقرَتُها","كَأَنَّ مِشفَرَها قَد طُرَّ مِن فيلِ",8,"ل",1,0],["لَها في بَني ذُبيانَ نَبتٌ بِمَفرَعٍ","وَفي مِنقَرٍ عالي البِناءِ كَنينُ",9,"ن",1,0],["لها فمٌ مثلُ اتِّساع الدَّربِ","وفَقْحةٌ مشقوقةٌ بالزُّبِ",10,"ب",1,0],["لها فِرقٌ شتّى من الحُسنِ أجْمعتْ","على أن يُلقَّى البرْح منها المُتيَّمُ",11,"م",1,0],["لَها فَضلُ سِنٍّ فَاِستَقَدنَ إِلى الصِبا","فَأَمسَينَ قَد أَعطَينَها عُقَدَ الأَمرِ",12,"ر",1,0],["لَها في رُبوعِ الشَرقِ جَيشٌ عَرَمرَمٌ","وَأَعوانُها في الغَربِ لَيسَ لَهُم حَصرُ",13,"ر",1,0],["لَها فُضولٌ كُلُّها فُضولُ","كَثيرُ ما يَقولُهُ قَليلُ",14,"ل",1,0],["لَها فَأرَةٌ ذَفراءُ كُلَّ عَشِيَّةٍ","كَما فَتَقَ الكافورَ بِالمِسكِ فاتِقُه",15,"ق",2,0],["لَها في سَوادِ القَلبِ بِالحُبِّ مَنعَةٌ","هِيَ المَوتُ أَو كادَت عَلى المَوتِ تُشرِفُ",16,"ف",1,0],["لَها في الماءِ مُنسابٌ كَطَيرٍ","تُسِفُّ عَلَيهِ أَحياناً وَتَحسو",17,"س",2,0],["لها في كُلِّ مَعْرَكَةٍ ضجاجٌ","وداهيةٌ كَداهيةِ البَسُوسِ",18,"س",1,0],["لَها في الوَغى زِيُّ الفَوارِسِ فَوقَها","فَكُلُّ حِصانٍ دارِعٌ مُتَلَثِّمُ",19,"م",1,0],["لها في كلِّ سالفةٍ ونَحرٍ","عِثارُ تَعمُّدٍ لن يُستَقالا",20,"ل",2,0],["لَها فَضلٌ عَلى غُرَرِ القَوافي","كَما فَضلُ البِقاعِ عَلى البِقاعِ",21,"ع",1,0],["لها فخذا قَرْمٍ وأظلافُ قَرْهبٍ","وناظِرَنا رِئمٍ وهامةُ أَيّلِ",22,"ل",1,0],["لَها في الهاجِسِ القَدحُ المُعَلّى","وَفي نَظمِ القَوافي وَالعِمادِ",23,"د",1,0],["لَها في طَرفِها لَحَظاتُ حَتفٍ","تُميتُ بِها وَتُحيِي مَن تُريدُ",24,"د",1,0],["لَها فَرخانِ قَد تُرِكا بِقَفرٍ","وَعُشُّهُما تُصَفِّقُهُ الرِياحُ",25,"ح",1,0],["لها في كلِّ مملكةٍ وشعبٍ","شرائعُ تُعجب المتعبِّدينا",26,"ن",2,0],["لها في يد الغازي لواءٌ مُظفَّرٌ","تُناجي الفتوحَ الغُرَّ فيه الوقائعُ",27,"ع",1,0],["لَها في يَدِ التاريخِ ما لَيسَ يَنطَوي","مِنَ العِبَرِ اللائي مَلَأنَ النُهى بَهرا",28,"ر",2,0],["لَها في أَعاصيرِ القِتالِ وَقائِعٌ","هِيَ السحرُ لَولا أَن يُزيَّف كاذِبُهْ",29,"ب",2,0],["لَها في الكَأسِ لينُ عَروسِ خِدرٍ","وَفيها لِلسُرورِ رَحىً تَدومُ",30,"م",1,0],["لها فَرَحاً فُوَيْقَ الأرضِ أرْضٌ","ومِن تحْتِ اللُّجَينِ لها لِجانُ",31,"ن",1,0],["لَها فَخِذانِ أُكمِلَ النَحضُ فيهِما","كَأَنَّهُما بابا مُنيفٍ مُمَرَّدِ",32,"د",1,0],["لَها فَرَطٌ يَكُونُ وَلا تَراهُ","أَماناً مِن مَعرّسِنا وَدُونا",33,"ن",2,0],["لها في دَمي خَلجاتُ الحياةِ","كأني خلِقتُ بأعصابها",34,"ه",2,0],["لها في مهجة الجبّار فتكٌ","وفي عينيهِ إِيماضٌ وسكْبُ",35,"ب",1,0],["لَهَا فِي نَوَاحِي الأُفْقِ لَفْتَةُ أَصْيَدٍ","يَلُوحُ عَلَى أَطْرَافِ عِرْنِينِهِ الْكِبْرُ",36,"ر",1,0],["لها فخذا قَرْمٍ وأظلافُ قَرْهبٍ","وناظرِتا رئمٍ، وهامة ُ ايّلِ",37,"ل",1,0],["لها في يد التاريخ ما ليس ينطوي","من العير اللائي ملأن النهى بهرا",38,"ر",2,0],["لها في كل جارحةٍ جنينٌ","وأكثرُ ما تجيءُ بتوأمين",39,"ن",1,0],["لَها في العامِ أَجمَعِهِ ثِمارٌ","وَفي أَعلى السَماءِ لَها غُصونُ",40,"ن",1,0],["لها في قلب سامعها دبيبٌ","دبيب البرء في ذات السقيم",41,"م",1,0],["لَها فَيلَقٌ بِالجَوِّ ذِي النَخلِ كامِنٌ","وَرَيعانُها لِلمَسجِدِ الفَردِ شامِلُ",42,"ل",1,0],["لها في عصرها الماضي حديث","قديم جل من واش بديع",43,"ع",1,0],["لَها في مَقاصير السَماء مَطامِحٌ","وَلَيسَ لَها في مَسلَكَ الجَوِّ مُقودُ",44,"د",1,0],["لَها في لماها العذبِ بَسمَةُ طاهِرٍ","تُنيرُ دُجى الظَلماءِ من شِعرِها الجَثلِ",45,"ل",1,0],["لَها في قَومِها نَسَبٌ عَريقٌ","إِذا اِنتَسَبَت وَبَيتُ حِجىً أَصيلُ",46,"ل",1,0],["لها فرخانِ قد علقا بوكرٍ","فعشّهما تصفقّه الرّياحُ",47,"ح",1,0],["لها في البحرِ أسطولٌ يدلّي","مراسيَهُ كأشطانِ الركي",48,"ي",1,0],["لَهَا فِي سُلَيْمٍ مَا لَهَا في زَنَاتَةٍ","وَهُوّارَة مِنْ عُدّةِ الهَصِّ والرّهْصِ",49,"ص",1,0],["لها في الجبال الشامخات معاقل","أسود الوغى تقري السباع الجماجما",50,"م",2,1],["لها في معبد النسك","وفي أقداسه نسب",51,"ب",1,0],["لها في ظاهِري بَرْدٌ وحَرٌّ","بِقلبي والفُتُورُ ففي عِظامي",52,"م",2,0],["لها في حمىً منّي وراء التّرائب","مَنازلُ لا تُغشَى بأيدي الرّكائبِ",53,"ب",1,1],["لها في الندى مالٌ وبذلٌ وقاصدٌ","ويومَ الوغى سيفٌ وقلبٌ وساعدُ",54,"د",1,0],["لها في عالم الملكوت فضلٌ","كذا في عالم الدنيا مزايا",55,"ا",3,0],["لَها فَرَطٌ يَحمي النِهابَ كَأَنَّهُ","لَوامِعُ عِقبانٍ مَروعٍ طَريدُها",56,"د",3,0],["لها في رحاب البيتِ دعوةُ ساجدٍ","ودمعةُ مشتاقٍ، وصوتُ مرحبِ",57,"ب",1,0],["لها في قلب خير الناس حُبٌّ","تضلَّع من منابعه الجنان",58,"ن",1,0],["لها في جبين الدهر أنصع غرة","يحف بها نور تألق وازدهى",59,"ه",2,0],["لها في عِقابِ الموج مَتنٌ ململَمٌ","قويٌّ ولكن لا يقالُ أمينُ",60,"ن",1,0],["لها في الحسن ينبوعٌ مديدٌ","وفي الإعجاز جِنِّيٌّ مُطيعُ",61,"ع",1,0],["لها في بعد مسراه أجيجٌ","عصوفُ الريح يخترق اليَراعا",62,"ع",2,0],["لها في القوافي ما لبيتك في العلا","سَنامُ نصابٍ لا يُنالُ رفيعِ",63,"ع",1,0],["لها في الجوّ رافعةً صُعودٌ","وفي مَهوَى الرياح لها انحدارُ",64,"ر",1,0],["لها فارسٌ من وصفِ مجدك دائسٌ","بارساغِها ما بين طَودٍ وفدفدِ",65,"د",1,0],["لها فعلُ الدروع عليك صوتاً","وفي الأعداء أفعالُ الصِّعادِ",66,"د",1,0],["لها فوق مَتنِ الأرض وهي رفيقةٌ","بما صافحت وَخْدُ القرومِ المصاعب",67,"ب",1,0],["لهُ إفكُ مدَّاحٍ وأبنة كاتب","وكدية صوفيّ وعقل معلم",68,"م",1,0],["لها فلق البحر الخضم نفاسةً","وأخفى رؤوساً بين أصدافه الدرّ",69,"ر",1,0],["لها فيه لمّا أن نأتْ عن جَنابِهِ","هَدِيلٌ تُرَجَّي قُرْبَهُ وتُحاولُه",70,"ل",2,0],["لها في نديَّ القومِ نشرٌ تخالُه","شذا المسكِ في أرجائهِ يتضوَّعُ",71,"ع",1,0],["لها في كلِّ مُضطرَبٍ ذميلٌ","ولي في كلِّ داجيةٍ منارُ",72,"ر",1,0],["لها في نفوسِ الناسِ وقعٌ إذا غدا","قريضُ أناسٍ وهو مُسْتَضْعَفُ الوَقْعِ",73,"ع",1,0],["لها في نسبة البيت افتخار","تأيد بالشروح وبالمتون",74,"ن",1,0],["لَها في الجارِحِ النَسَبُّ المُعَلّى","وَإِن هِيَ خالَفَتهُ في المَعاني",75,"ن",2,0],["لَها فَرخان قَد تَرَكا بوكر","فَعشهُما تصفِّقه الرِياح",76,"ح",1,0],["له إفقاري كيفَ ماشاءَه ل","كن إذلالي مِنهُ صعبُ المَنالِ",77,"ل",1,0],["لها في لحظها لحظاتُ حَتفٍ","تُميتُ بها وتُحيي مَن تُريدُ",78,"د",1,1],["لها فغرَةٌ إنْ شاءَ يوماً وُلوجَها","خَروقٌ لها بالرّمحِ فهو وَلوجُ",79,"ج",1,0],["لها في مُلتَقَى الحيَّيْنِ دارٌ","ولكن لا تزورُ ولا تُزارُ",80,"ر",1,0],["لَها في اللَهوِ ضَربٌ بَعدَ ضَربٍ","عَلى آذانِ أَصحابِ الرَقيمِ",81,"م",1,0],["لها فمٌ وهْوَ لها خَاتَمٌ","جعلْتُ فيه فصَّه لَثْمي",82,"م",2,0],["لها في البها ليس للغيد قبلها","وحسن حديث للأنيس ومندم",83,"م",1,0],["لَها في صَباباتِ الق