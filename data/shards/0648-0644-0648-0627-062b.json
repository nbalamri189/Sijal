{"poems":[[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[107,"هو النصر يا تيماء يتبعه النصر","https://www.aldiwan.net/poem44050.html","الطويل"],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62667","الكامل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145544","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66145","الطويل"]],"verses":[["ولو أثارتك دلوهُ رجعتْ","إليه مملوءةً من المدر",0,"ر",1,0],["ولو آثروا الإسلامَ دِيناً لأفلحوا","ولكنّه الشِّركُ المُذَمَّمُ والكُفْرُ",1,"ر",1,0],["ولو آثروا الدنيا لقد كان جاهها","تليدا لديهم والقسامة والوفر",2,"ر",1,0],["وَلّوا ثِقالاً أو خفا","فاً وارتجوك على الأثَرْ",3,"ر",1,0],["ولو آثرت باسم الخلافة غيره","لكان المسمى بالإمام ملقبا",4,"ب",2,0],["وَلَوْ آثَرُوا داعي الهُدَى لَتَسَنَّمُوا","مِنَ الشَّرَفِ الاعْلَى اجَلَّ المَراتِب",5,"ب",1,0]]}