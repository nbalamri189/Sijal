tsgate.com/ViewPoem.aspx?id=212972",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""],[5956,"قلبي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=193291",""],[5956,"يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=193297",""],[5956,"كل تقصير لديهم بأداء الضَّخِ","https://www.poetsgate.com/ViewPoem.aspx?id=194199",""],[5977,"رياح الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=213086",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6024,"أنياب المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=186354",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6070,"القاضي والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=188079",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[463,"منْ حاكمٌ وخصوميَ الأقدارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60069&r=&rc=125",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""],[6262,"الرجفةُ تبدأُ من يدِها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80104&r=&rc=2",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""]],"verses":[["هَل سَبيلٌ لي إِلى را","حَةِ قَلبٍ مِن وَجيبِ",0,"ب",1,0],["هَل سَمِعتُم يا ساكِني أَرضَ نَجدٍ","بِعَليلَينِ يَشفيانِ عَليلا",1,"ل",2,0],["هَل سَرَّ حِنقِطَ أَنَّ القَومَ صالَحَهُم","أَبو شُرَيحٍ وَلَم يوجَد لَهُ خَلَفُ",2,"ف",1,0],["هَلْ سَوَاءٌ فِي الفَضْلِ مَا يَتَقَضَّى","مَعَهْ نَفْعُهُ وَمَا يُسْتَدَامُ",3,"م",1,0],["هل سمعتم منيرة مذ أفاضت","من بديع الغناء في كلّ فنّ",4,"ن",1,1],["هَل سَرَّ أَولادَ اللَقيطَةِ أَنَّنا","سِلمٌ غَداةَ فَوارِسِ المِقدادِ",5,"د",1,1],["هل سُبّةٌ يا أبا العباس تعلمُها","إلا وأنت بها في الناس مسبوبُ",6,"ب",1,0],["هل سألنا أبا العلاء وإن قلّ","ب عينا في عالم الكون وسنى",7,"ن",2,0],["هل سبيلٌ إلى تقاصُرِ ليلٍ","غابَ عني الحُسينُ فيه فَطَالا",8,"ل",2,1],["هَل سَبيلٌ إِلى الَّتي لا أُبالي","بَعدَها أَن أَموتَ قَبلَ وَفاتي",9,"ت",2,0],["هَل ساءَهُ أَن آلَ آساً وَردُهُ","وَتَعَطَّلَت مَن فيهِ كَأسٌ تُشرَبُ",10,"ب",1,1],["هَل سرتِ النار إِلى تينها","وَتُوتِها الغضّ وَرُمانها",11,"ن",3,0],["هَل سارَ في الناسِ أَوَّلٌ بِتُقىً","فَيَتبَعَ الناسُ بَعدَهُ سِيَرَه",12,"ر",2,0],["هَل سُرَّت الخَيلُ أَن زانَت سَوابِقَها","بَينَ المَواكِبِ غُرّاتٌ وَتَحجيلُ",13,"ل",1,0],["هَل سَرَّكُم في جُمادى أَن نُصالِحَكُم","إِذِ الشَقاشِقُ مَعدولٌ بِها الحَنَكُ",14,"ك",1,0],["هل سَمِعْتُمُ أو رأيتُمُ أسَداً","صادَهُ لحْظُ مَهاةٍ أو ظُبَي",15,"ي",1,0],["هل سمِعَتْ أذناك قصفَ الرعودْ","في صخَبِ البحرِ وعصفِ الرياحْ",16,"ح",1,0],["هل سَمْسَمٌ فيما مَضَى عالِمٌ","بوَقْفَةِ العَجّاجِ في سَمْسَم",17,"م",1,0],["هَل سَأَلتَ الحَربَ عن إخوانِها","إذ فُحُولُ النَّاسِ تُغمَى بالزبَّدَ",18,"د",1,0],["هَلْ سِجِلٌّ لِلْفَخْرِ إِلاَّ وَفِيهِ","لاسْمِهِ فِي افْتِتَاحِهِ تَسْجِيلُ",19,"ل",1,0],["هَل سَفَرَت عَن عَيبِها","قائِلَةً خُذ حَذَرَك",20,"ك",1,0],["هل سأعتاد وجه غيري بوجهي؟","زعموا ربما أخون اعتيادي",21,"د",2,0],["هَلْ سَمِعْتُمْ بِغَزالٍ","صادَ لَيْثاً في غِياضِ",22,"ض",1,0],["هل سلَوا أم قَضَوا غراما فإني","لم أجد بعدَهُم فتىً يرثي لي",23,"ل",2,0],["هلْ سبيل إلى لقاهُ وإن لم","يشف ما بي من الغرامِ اللقاءُ",24,"ا",2,0],["هل سوى نهضتهم ردت لهم","هذا الرفعة والعيش الشبم",25,"م",1,0],["هل سلونا معا فما بال روحي","حائر الروح في شعاب الحنين",26,"ن",1,0],["هل سمعتم أن شخصا مرة","سره من بعض أهليه البغاء",27,"ا",2,0],["هل سقامي في غرامي","كامِنٌ حَيٌّ دفينُ؟",28,"ن",1,0],["هَل سُلَيمانُ رَبُّ ذاكَ المُلكِ","أَم كَليمانُ ذو القِوى وَالفَتكِ",29,"ك",1,0],["هَل سِواهُم قَد أَذهَبَ اللَه عَنهُ","الرجس نَصا في ذِكرِه مَسطورا",30,"ر",2,0],["هل سرَّنا إفسادُنا إيمانَنا","أم هل ختمناه بسوء خِتام",31,"م",1,0],["هَل سَبيل إِلى رِضاك أَو الصَب","ر وَإِلّا إِلى الحمام الوَحيِّ",32,"ي",1,0],["هل سمعت أو رأيت خيرا به لا","تنظر أو تسمع الأكل كريه",33,"ي",2,0],["هَل سَناً مِثل سناها","هَل عُلىً مِثل علاها",34,"ا",3,0],["هل سألتم عن فؤادي إنَّه","ما سلاكم في الهوى حتَّى انسلى",35,"ل",2,0],["هل سبيلٌ الى القصاصِ فقالوا","إنّ جُرحَ العجماءِ صاحِ جُبار",36,"ر",1,0],["هل سائلٌ بك بعدها أو قائلٌ","هيهات لا خبرٌ ولا استخبارُ",37,"ر",1,0],["هل سمعتم بفوآدٍ ظائرٍ","معكم كلَّت لديه الأينقُ",38,"ق",1,0],["هل ساق زمزمة القلوب لربها","بعد انحرافٍ مسها إلانا",39,"ن",2,0],["هل سمعْتُمْ حِكَماً من ميِّتٍ","تحتَ أطْباقِ الهَوَى ينعَدِمُ",40,"م",1,0],["هل سمِعْتُمْ غيرَنا من","ماتَ في الحُبِّ غَرَامَا",41,"م",2,0],["هَل ساقِطٌ لَهُما قَدرُ مَسافَتِهِ","عَن مُكتَريهِ أَيا مَن حَلَّ مُختَصَرا",42,"ر",2,0],["هل سره العيش أو راقته أنعمه","عند المشيب كما قد سر شبانا",43,"ن",2,0],["هل ساء ظنُّك فيَّ أو","أبلَى ودادَك ما تَجَدَّد",44,"د",1,0],["هَل سَرحَةُ الوادي عَلَى عَهدي بِها","مُخضَّرَةُ الثَّمَراتِ والاَفنانِ",45,"ن",1,0],["هل ساذج الطبع يحظى","بذات حسن وعلم",46,"م",1,0],["هل سمعتم أهل دينٍ","يستحلون الحَراما",47,"م",2,0],["هَل سِوى زَورَةِ الحَبيبَةِ عيدُ","أَم فُؤادِي بِغَيرِهَا مَعمُودُ",48,"د",1,1],["هل سرَّكم أنّني مِن بينكم رجلٌ","لا أَرتجي أملاً منكم ولا سولا",49,"ل",2,0],["هل سلوة هيهات لا سلوة","قد بلغ السيل الزبى وارتقى",50,"ق",2,0],["هل سبيلٌ إلى عناقٍ كما عا","نقتُ عندَ الفراقِ يومَ الوداعِ",51,"ع",1,1],["هَل سَيفُهُ من طَرفِه أم طَرفُهُ","مِن سَيفِهِ أَم ذاكَ طَرفٌ ثَالِثُ",52,"ث",1,0],["هل ساءه رَهَبُ القواضب في الوغى","أم سره رغَبُ الغنى والمزمَر",53,"ر",1,0],["هل سمعتم بمعشر جمعوا الخي","ل وساروا في الرجل والفرسان",54,"ن",1,0],["هل سمعتم فيما سمعتم بإنسا","ن عراه في دعوة ما عراني",54,"ن",2,0],["هَل ساءَلوا أَو واصلوا أَو قابلوا","أَم لا فَقولي لا أَموت بحسرتي",55,"ت",2,0],["هَلْ سابِقٌ مِثْلُهُ في السابِقينَ لَهُ","فَضْلُ السِّباقِ وَما صَلّى إلى الوَثَنِ",56,"ن",1,0],["هل سوى الموت بعده من صنيع","أرتجيه أم غاية أرعاها",57,"ا",3,0],["هل سواه من كلم الناس في المه","د صبياً بما تروم وفاها",57,"ا",3,0],["هل سرني وثيابي فيه قوم سبا","أو راقني وعلى رأسي به ابن جلا",58,"ل",2,0],["هل سوء حظي رعاك اللَه أوقفني","في الجهد أم كل من يهواك مجهود",59,"د",1,0],["هل سعى بيننا السُعاة فمالوا","برضاها عنا ونالوا رضاها",60,"ا",3,0],["هَلْ سَيْلُ مَدْمعِه المُرْفَضِّ سَلّاكِ","فاستغربَ التوْمُ من فيكِ بأسلاكِ",61,"ك",1,1],["هل سمعتم يا لقومي عاشقاً","انس الظبي به وهو شرد",62,"د",1,0],["هل سرحة الحي في أيامنا فرقتنا","هل بعدنا للتصابي لذة لفم",63,"م",1,0],["هل سجف الظعن تُكِنُّ الظِّبَا","أم كُنَّسٌ تحجب غزلانا",64,"ن",2,0],["هَل سَرى اليُسرُ سِوى مِن مصرِهِ","أَو جَرى التِبرُ سِوى في نيلِهِ",65,"ل",2,0],["هل سبيلٌ إلى زَرُودٍ واهليه","وهيهاتَ أينُ الهُ زرود",66,"د",1,0],["هل سوغ الاسلام حقن دمائهم","ودماء أحمد بينهم لم تحقن",67,"ن",1,0],["هل سمعتم أو هل رأيتم عذاباً","والنعيم المقيم يجتمعانِ",68,"ن",1,0],["هل سبيل إلى وقوفي بوادي","الجزع يا صاحبي أو المامي",69,"م",2,0],["هل سمعتم أو رأيتم","قاضيا تحت السماء",70,"ا",2,1],["هل سلاني حاشاه من غير ذنب","سال قلبي إن كان يوماً سلاه",71,"ا",2,0],["هَل سِوى شَيءٍ يَسيرٍ","مِن سُرورٍ لا يَدومُ",72,"م",1,0],["هَلْ سَأَلَتْكَ حاجَةً","فَأْنَت تَهْتَزُّ لَهَا",73,"ه",2,0],["هل سلا عاشق سواي فأسلو","والتأسي في شرعة الحب يحلو",74,"ل",2,1],["هل سببٌ إِلى الرِّضا","يا عاتباً بلا سبب",75,"ب",1,0],["هل سيروا الرأس فوق الرمح هل شربوا","عليه هل قرعوه الثغر بالقضب",76,"ب",1,0],["هل سبيل إلى لماك فاطفي","غللا في الحشا ببرد لماكا",77,"ك",2,0],["هل سقاك الغدر كاسات الحِمام","ليتهُ يُبلى بما فيهِ غَدَر",78,"ر",1,0],["هل سار شخصٌ بفابورين في زَمَنٍ","معاً وكلٌّ يقول الشخص ثاوينا",79,"ن",2,0],["هل سمعتم برجال راسلَت","هم حسان فأبوا واعتذروا",80,"ر",3,0],["هَل سُوَيدٌ غَيرُ لَيثٍ خادِرٍ","ثَئِدَت أَرضٌ عَليهِ فَانتَجَع",81,"ع",1,0],["هل ستُشفي لوعتي مقلتاها ؟","هل سيُدنيني إليها وصولُ ؟",82,"ل",1,0],["هَلْ سَامع يا رسول الله أنتَ لمن","ولاؤه لك مَرويٌّ ومنْقُولُ",83,"ل",1,0],["هل سيأتي..هل يعود","ولقد حزنا المنيةْ",84,"ي",2,0],["هل سمعتم بدرهمٍ أو بدينارٍ","مع الجيش للرعية خانا",85,"ن",2,0],["هل سرّك الوجع البغيض يلوكني","أبكي وتبكي حسرتي الأقداح",86,"ح",1,0],["هل سُدَّتِ الأفاقُ عن ضَحَواتِنا","وتضَعْضَعتْ صَحوَاتُنا دونَ العُلا",87,"ل",2,0],["هل سيُغنينيَ اصْطِبارٌ إذا ما","غابَ نُورُ الشموسِ عندَ الطلوعِ ؟!",88,"ع",1,0],["هَلْ سَمِعْتَ الهَزَارَ حِيْنَ يُغَنِّيْ","أَفَتَدْرِيْ يَا عَاذِلِيْ مَا يَقُوْلُ ؟",89,"ل",1,0],["هَلْ سُوِّدَ السيسى على أمرٍ وما ..","زحفتْ إليه مصائبٌ وخرابُ ؟",90,"ب",1,1],["هل ساءَكَ الغازونَ عند المعبرِ","يتغامزون وراء ثوبِ تَعَثُّري",91,"ر",2,1],["هَلْ سَالَ عَقلاً عَلىْ الإنسَانِ أَو ضَمِنَتْ","آبَارُهُ خُلُقَاً .. فَوقَ النُّجُومِ سَنَا",92,"ن",2,0],["هَلْ سَألْتِ الشِّعْرَ سُعْدَى ؟!!","ذَا هُيَامٌ سَاحَ مِنِّيْ",93,"ن",2,1],["هَلْ سَألْتِ النَّايَ يَشْجُو","هَلْ سَألْتِ الآهَ عَنِّيْ ؟! !",93,"ن",2,0],["هَلْ سَأَحْيَا؟ وَهَلْ سَيُشْفَى فُؤَادٌ؟","بَعْدَ تَارِيخٍ مَدَّ فِيِهِ العَيَاءُ!!",94,"ا",2,0],["هَلْ سَأَنْسَى شَقِيقَةً مِثْلَ بَدْرٍ","إِنْ تَرَاءَت تَلَأْلَأَتْهَا السَّمَاءُ ؟!!",95,"ا",2,0],["هَلْ سَمِعْتُمْ بِمَنْ يُغَرِّدُ شِعْراً","وَهْوَ مَيْتٌ عَلَى غُصُونِ التَّجَنِّي",96,"ن",2,0],["هل سلّ خنجره ترى إلا علي","أعداء مولانا الأجلّ الأفخر",97,"ر",1,0],["هَلْ سَمِعْتَ الْعُرْبَ أَرْبَابَ الْبَيَانِ","أَوْ بَلِيغًا قَوْلُهُ سِحْرُ اللِّسَانِ؟!",98,"ن",1,1],["هل سنجري على رغائب نفس","فقدت في تقلب العيش رفقا",99,"ق",2,0],["هل ستبقى على تسلط نفس","فقدت في الحياة بالخلق رفقا",99,"ق",2,0],["هل سعدنا في دهرنا نسعى له","أم أنّ قوتا للقلوب يُعرجُ؟؟",100,"ج",1,0],["هل ستلقى على الجحيم فتشوى","أم تُفدّى وأنت في النار تكبر!؟",101,"ر",1,0],["هلْ سيبكي البحرُ يومًا أسَفًا","إن طَوى اللُّجُّ يَؤوسًا غَرِقَا ..؟!",102,"ق",2,0],["هل سوف توقظها كما ايقظتني؟","أم سوف تعطيها بقايا حليتي",103,"ت",2,0],["هل سوف يجمعنا مخافة سجننا","قلق ليشرق بعده الإفراج؟!",104,"ج",1,0],["هل سامعٌ شاقه صوتي وهيّجَهُ","متيم قلبه، بالدمع قد شرقا",105,"ق",2,0],["4- هل سيأتي باتِّفاقٍ؟","أو كأنْ يُعطيكَ مُهلَةْ؟",106,"ل",2,0],["هل سَلَوتَ القلبَ والروحَ الّتي","أبْرأتْ وَعْساءَهُ كي تَزْرعَكْ",107,"ك",1,0],["هل سنبقى فو