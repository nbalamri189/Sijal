{"poems":[[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[63,"أيها الحي إن بكرتم رحيلا","https://www.aldiwan.net/poem45703.html","الخفيف"],[9,"كانت وصاة وحاجات لنا كفف","https://www.aldiwan.net/poem21952.html","البسيط"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[88,"هل سمعتم منيرة مذ أفاضت","https://www.aldiwan.net/poem44403.html","الخفيف"],[23,"هل سر أولاد اللقيطة أننا","https://www.aldiwan.net/poem21401.html","الكامل"],[51,"قالوا ابن يوسف مستوه فقلت لهم","https://www.aldiwan.net/poem8509.html","البسيط"],[85,"أخذت السماء يا دار ركنا","https://www.aldiwan.net/poem7106.html","الخفيف"],[61,"هل سبيل إلى تقاصر ليل","https://www.aldiwan.net/poem51466.html","الخفيف"],[31,"برز البدر في جوار تهادى","https://www.aldiwan.net/poem42598.html","الخفيف"],[74,"هل ساءه أن آل آسا ورده","https://www.aldiwan.net/poem12846.html","الكامل"],[102,"لهفي على الشام وسكانها","https://www.aldiwan.net/poem33115.html","السريع"],[46,"من عاش سبعين فهو في نصب","https://www.aldiwan.net/poem22637.html","المنسرح"],[46,"دين وكفر وأنباء تقص وفر","https://www.aldiwan.net/poem23135.html","البسيط"],[19,"زعمتم أن غولا والرجام لكم","https://www.aldiwan.net/poem355.html",""],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20984","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[100,"ثرثرات محموم","https://www.poetsgate.com/ViewPoem.aspx?id=50376",""],[155,"أنت بالعزة ماض","https://www.aldiwan.net/poem55640.html","مجزوء الرمل"],[197,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[199,"قمر أطلعت أخاه السماء","https://www.aldiwan.net/poem45628.html","الخفيف"],[209,"خطرت تسحب أذيال الرسم","https://www.aldiwan.net/poem26481.html","عموديه"],[211,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[221,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[254,"لا تخف","https://www.aldiwan.net/poem25016.html","مجزوء الرمل"],[320,"أي وقت وأي هائل طقس","https://www.aldiwan.net/poem61667.html","الخفيف"],[361,"أنا في عرض آل بيت نبي","https://www.aldiwan.net/poem68104.html","الخفيف"],[377,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[380,"حر قلبي من برد ريق شهي","https://www.aldiwan.net/poem48825.html","الخفيف"],[391,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[393,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[416,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[432,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[500,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[500,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[500,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[500,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"]],"verses":[["هَل سَبيلٌ لي إِلى را","حَةِ قَلبٍ مِن وَجيبِ",0,"ب",1,0],["هَل سَمِعتُم يا ساكِني أَرضَ نَجدٍ","بِعَليلَينِ يَشفيانِ عَليلا",1,"ل",2,0],["هَل سَرَّ حِنقِطَ أَنَّ القَومَ صالَحَهُم","أَبو شُرَيحٍ وَلَم يوجَد لَهُ خَلَفُ",2,"ف",1,0],["هَلْ سَوَاءٌ فِي الفَضْلِ مَا يَتَقَضَّى","مَعَهْ نَفْعُهُ وَمَا يُسْتَدَامُ",3,"م",1,0],["هل سمعتم منيرة مذ أفاضت","من بديع الغناء في كلّ فنّ",4,"ن",1,1],["هَل سَرَّ أَولادَ اللَقيطَةِ أَنَّنا","سِلمٌ غَداةَ فَوارِسِ المِقدادِ",5,"د",1,1],["هل سُبّةٌ يا أبا العباس تعلمُها","إلا وأنت بها في الناس مسبوبُ",6,"ب",1,0],["هل سألنا أبا العلاء وإن قلّ","ب عينا في عالم الكون وسنى",7,"ن",2,0],["هل سبيلٌ إلى تقاصُرِ ليلٍ","غابَ عني الحُسينُ فيه فَطَالا",8,"ل",2,1],["هَل سَبيلٌ إِلى الَّتي لا أُبالي","بَعدَها أَن أَموتَ قَبلَ وَفاتي",9,"ي",1,0],["هَل ساءَهُ أَن آلَ آساً وَردُهُ","وَتَعَطَّلَت مَن فيهِ كَأسٌ تُشرَبُ",10,"ب",1,1],["هَل سرتِ النار إِلى تينها","وَتُوتِها الغضّ وَرُمانها",11,"ن",3,0],["هَل سارَ في الناسِ أَوَّلٌ بِتُقىً","فَيَتبَعَ الناسُ بَعدَهُ سِيَرَه",12,"ر",2,0],["هَل سُرَّت الخَيلُ أَن زانَت سَوابِقَها","بَينَ المَواكِبِ غُرّاتٌ وَتَحجيلُ",13,"ل",1,0],["هَل سَرَّكُم في جُمادى أَن نُصالِحَكُم","إِذِ الشَقاشِقُ مَعدولٌ بِها الحَنَكُ",14,"ك",1,0],["هل سَمِعْتُمُ أو رأيتُمُ أسَداً","صادَهُ لحْظُ مَهاةٍ أو ظُبَي",15,"ي",1,0],["هل سمِعَتْ أذناك قصفَ الرعودْ","في صخَبِ البحرِ وعصفِ الرياحْ",16,"ح",1,0],["هل سَمْسَمٌ فيما مَضَى عالِمٌ","بوَقْفَةِ العَجّاجِ في سَمْسَم",17,"م",1,0],["هَل سَأَلتَ الحَربَ عن إخوانِها","إذ فُحُولُ النَّاسِ تُغمَى بالزبَّدَ",18,"د",1,0],["هَلْ سِجِلٌّ لِلْفَخْرِ إِلاَّ وَفِيهِ","لاسْمِهِ فِي افْتِتَاحِهِ تَسْجِيلُ",19,"ل",1,0],["هَل سَفَرَت عَن عَيبِها","قائِلَةً خُذ حَذَرَك",20,"ك",1,0],["هل سأعتاد وجه غيري بوجهي؟","زعموا ربما أخون اعتيادي",21,"د",2,0],["هَلْ سَمِعْتُمْ بِغَزالٍ","صادَ لَيْثاً في غِياضِ",22,"ض",1,0],["هل سلَوا أم قَضَوا غراما فإني","لم أجد بعدَهُم فتىً يرثي لي",23,"ل",2,0],["هلْ سبيل إلى لقاهُ وإن لم","يشف ما بي من الغرامِ اللقاءُ",24,"ا",2,0],["هل سوى نهضتهم ردت لهم","هذا الرفعة والعيش الشبم",25,"م",1,0],["هل سلونا معا فما بال روحي","حائر الروح في شعاب الحنين",26,"ن",1,0],["هل سمعتم أن شخصا مرة","سره من بعض أهليه البغاء",27,"ا",2,0],["هل سقامي في غرامي","كامِنٌ حَيٌّ دفينُ؟",28,"ن",1,0],["هَل سُلَيمانُ رَبُّ ذاكَ المُلكِ","أَم كَليمانُ ذو القِوى وَالفَتكِ",29,"ك",1,0],["هَل سِواهُم قَد أَذهَبَ اللَه عَنهُ","الرجس نَصا في ذِكرِه مَسطورا",30,"ر",2,0],["هل سرَّنا إفسادُنا إيمانَنا","أم هل ختمناه بسوء خِتام",31,"م",1,0],["هَل سَبيل إِلى رِضاك أَو الصَب","ر وَإِلّا إِلى الحمام الوَحيِّ",32,"ي",1,0],["هل سمعت أو رأيت خيرا به لا","تنظر أو تسمع الأكل كريه",33,"ي",2,0],["هَل سَناً مِثل سناها","هَل عُلىً مِثل علاها",34,"ا",3,0],["هل سألتم عن فؤادي إنَّه","ما سلاكم في الهوى حتَّى انسلى",35,"ل",2,0],["هل سبيلٌ الى القصاصِ فقالوا","إنّ جُرحَ العجماءِ صاحِ جُبار",36,"ر",1,0],["هل سائلٌ بك بعدها أو قائلٌ","هيهات لا خبرٌ ولا استخبارُ",37,"ر",1,0],["هل سمعتم بفوآدٍ ظائرٍ","معكم كلَّت لديه الأينقُ",38,"ق",1,0],["هل ساق زمزمة القلوب لربها","بعد انحرافٍ مسها إلانا",39,"ن",2,0],["هل سمعْتُمْ حِكَماً من ميِّتٍ","تحتَ أطْباقِ الهَوَى ينعَدِمُ",40,"م",1,0],["هل سمِعْتُمْ غيرَنا من","ماتَ في الحُبِّ غَرَامَا",41,"م",2,0],["هَل ساقِطٌ لَهُما قَدرُ مَسافَتِهِ","عَن مُكتَريهِ أَيا مَن حَلَّ مُختَصَرا",42,"ر",2,0]]}