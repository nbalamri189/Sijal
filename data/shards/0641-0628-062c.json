{"poems":[[95,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54301","الخفيف"],[136,"لله ما رضعت بنو صلاح","https://www.aldiwan.net/poem54864.html","الكامل"],[193,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[240,"حمام دارك جنة لنزيله","https://www.aldiwan.net/poem31955.html","الكامل"],[369,"تظلم من طرف ظبي رخييم","https://www.aldiwan.net/poem60647.html","المتقارب"],[435,"جاءت تلوح وحبها وافى السند","https://www.aldiwan.net/poem41413.html","الكامل"],[443,"شكراً لما تولى من الإنعام","https://www.aldiwan.net/poem2566.html","الكامل"],[469,"لا تلمني فليس يجدي الملام","https://www.aldiwan.net/poem3627.html","عموديه"],[473,"أبركت يا بركات راحلة الهوى","https://www.aldiwan.net/poem59555.html","البسيط"],[505,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130718","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123692","الرمل"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205224","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59387","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59416","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59389","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84488","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111846","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101029","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104738","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53077","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53216","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93535","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132305","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137401",""],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52993","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91101","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135239","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136048","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135240","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123502","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123500","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90957","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81717","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83561","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133137","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35466","الكامل"],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""]],"verses":[["فَبِجِدٍّ هَبَّ يَرْجِعُ مِنْ","شَأْنِهَا مَا ضَاعَ بِاللَّعْبِ",0,"ب",1,0],["فَبَجَّلَتْ تَحْتَ تَاجِ المُلْكِ مُدْمِيهَا","وَقَبَّلَتْ دَمَهَا فِي المَرْمَرِ القَانِي",1,"ن",2,0],["فَبِجَاهِهِ وَبِنُصْحِهِ وَبِبِرِّهِ","نَصَرَ النِفيسَ عَلَى الخَسِيسِ النافِقِ",2,"ق",1,0],["فبجهلٍ قابلتَ ما كان منِّي","وبحلمٍ قابلتُ ما كان منكا",3,"ك",2,0],["فبِجِدِّهم خاضوا بُحورَ معارف","يوهِى تلاطمُها قُوَى المَلاَّحِ",4,"ح",1,0],["فَبِجاههِ اِغفِر ما جنيتُ فَها أنا","لِندامَتي قَد صرتُ ربِّ نَديما",5,"م",2,0],["فَبِجودِهِ تَتَدَفَّقُ الأَمواهُ في","أَرجائِهِ وَبِيَأسِهِ يُستَسعَرُ",6,"ر",1,0],["فبجّسَ صَخْرَ المليكِ الوَليّ","ويبّسَ بحرَ المليكِ الخَصيم",7,"م",1,0],["فبجده رب الرسالة والسنا","ما خانه قلبي المشوق ولا جحد",8,"د",1,0],["فبجدّك المبعوث في هذا الورى","ثبتت دعائم قبّةِ الاسلام",9,"م",1,0],["فبجسمي لا جسمك السُّقم","في الحب وقلبي لا قلبك المستهامْ",10,"م",1,0],["فَبِجَوهَرِ الحُسنِ الَّذي تَجلو بِهِ","خَدَّيكَ مِن سَبَجٍ وَمِن مَرجانِ",11,"ن",1,0],["فبجَبْرَؤُوتِكَ من ظُهو","رِكَ سرُّ طَوْلٍ في خَفائِكْ",12,"ك",1,0],["فبجدِّكَ الصديقِ جُد لمؤمِّلٍ","بعنايةٍ وأنلهُ عوناً بجتزِ",13,"ز",1,0],["فبجاهِه رفَعَ الإلاهُ شدائداً","عنْ خَلْقِهِ كانتْ تهولُ ونَارَا",14,"ر",2,0],["فبجُها دُرَّاجُها أو","فحُبَارها قَطَاها",15,"ا",3,0],["فبجدّيك ابن لي","ما به أعرف قصدك",16,"ك",1,0],["فبجسمي لا جسمك السُّقم في الحب","ب وقلبي لا قلبك المستهامُ",17,"م",1,0],["فبجاهه لا تخزني","إذ جاهه الجاه الأعد",18,"د",1,0],["فَبِجَاهِ يس المُشَفَّعِ نَجِّنِي","مِنْ شَرّ نَفْسِي وَالهَوَى وَمَنِ اعْتَدَى",19,"د",2,0],["فبجاه طه المصطفى لا تخزني","يا رب بين أقاربي وأناسي",20,"س",2,0],["فبجاهه لا ترددن توسلي","وبسره لا تعكسن قياسا وليس قد",20,"س",3,0],["فبجاهه وبنوره وبسره","متع حواسي الخمس بالإحساس",20,"س",1,0],["فبجاه أحمد لا تخيبني وجد","بالعفو والغفران والفضل العميم",21,"م",1,0],["فَبِجَاهِ أحْمَدَ لاَ تُخَيِّبْ مَقْصَدِي","وَتَوَلَّنِي بِالْعَفْوِ وَامْنُنْ بِالرِّضَى",22,"ض",2,0],["فبجاه خير الخلق أحمد جُد له","بسحاب فضلٍ دائمٍ لا يقلع",23,"ع",1,0],["فبجيدِها انتظمت حُلى افكارِكم","وبدت بنحرِ العصرِ عقداً نضدا",24,"د",2,0],["فبجانب الفسطاط من غربيه","ورقٌ لها بالمنيلين هديل",25,"ل",1,0],["فَبجاهِهِ وَبِقَدرِهِ وَبِسِرِّهِ","هَبنَا رِضُاكم يا إِلهَ مُحَمّد",26,"د",1,1],["فبجده وبآله","فات الملوك أباً وجدّا",27,"د",2,0],["فبجوّ ذاك الشعب ظبيٌ ما الظبا","يوماً بأفتك من ضعاف جفونه",28,"ن",2,0],["فَبِجُهدِنَا تَأوِيلُهَا وَالدَّفعُ فِي","أكنَافِهَا دَفعاً لِذِي الصَّوَلاَنِ",29,"ن",1,0],["فَبِجاهِهِم يا خالِقَ كل","مهما عبدٌ بالأزمة مل",30,"ل",1,0],["فَبِجَدواه إِذا السُحب هَمَت","وَلِمَغناه إِذا ما الركب جابا",31,"ب",2,0],["فَبِجَحفَلٍ يَذَرُ الصَّلاخِدَ كالهَبَا","مِن مُحكَمِ الآياتِ والأَسمَاءِ",32,"ا",2,0],["فبجبيهما أنال الأماني","من زماني ويقبل الالتماس",33,"س",1,0],["فبجِده يحيى مآثرَ جَدّه","ويمدُّ بالتأييد قوةَ باسها",34,"س",3,0],["فَبجيرة تَعتاض جي","رانا وَلو خفي الصَواب",35,"ب",1,0],["فبجاهه أدعوك تدرء مكرهاً","عنا بدنيا ثم أخرى برزخا",36,"خ",2,0],["فبجميلِ صُنعك الجميلِ","لْتُغنِنا ربِّ عن الرحيلِ",37,"ل",1,0],["فبجاهه نرجو الظهور على العدا","وظهور من منا علا والمختفي",38,"ي",1,0],["فبجاهه لذ واستقل زللا وقل","يا من به منا تطيب نفوس",39,"س",1,0],["فبجاهه السامى استقل للاوقل","يا خير ذخر للشدائد يكنز",40,"ز",1,0],["فبجاهه اللهم فرج كربة","ضاقت لشدتها علي مذاهب",41,"ب",1,0],["فبجدواه زائلٌ كل فقرٍ","وبنعماهُ آهلٌ كل فقرِ",42,"ر",1,0],["فَبِجُودِهِ ترجو العُفاةُ حياتَها","وببأسه تخشى العُداةُ هلاكها",43,"ك",3,0],["فَبجاهك العالي اِستَجِب لِمُؤَمِّلٍ","إيمانُهُ بك سَيِّدي إيمانُهُ",44,"ن",2,0],["فبجاه خير المرسلين محمدٍ","زين الوجودِ وسيدِ الشفعاء",45,"ا",2,0],["فَبِجاهِهِ لاذَ الألى","فازوا جَميعاً بِالوَطَر",46,"ر",1,0],["فبجاه المصطفى خذ لي يا","ذا العلا من قاتليه بالقود",47,"د",1,0]]}