.poetsgate.com/ViewPoem.aspx?id=201830",""],[5135,"طيفَ الأحبةِ","https://www.poetsgate.com/ViewPoem.aspx?id=201973",""],[4572,"حمامة بلّغي عنّي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=15009",""],[5277,"رابحة ..في حلّي ومرتحلي","https://www.poetsgate.com/ViewPoem.aspx?id=192911",""],[5277,"مِن تهجّدات البدوي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=208837",""],[5277,"\" من البغداديات \"","https://www.poetsgate.com/ViewPoem.aspx?id=210741",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5442,"مضى شهر الصيام فليت شعري","https://www.poetsgate.com/ViewPoem.aspx?id=114784",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5616,"طباق","https://www.poetsgate.com/ViewPoem.aspx?id=205771",""],[5672,"عيونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214549",""],[2960,"إِذا مَا قصدت طيبَة شوقاً","https://www.poetsgate.com/ViewPoem.aspx?id=189633",""],[5873,"عيش الفخار","https://www.poetsgate.com/ViewPoem.aspx?id=215435",""],[5979,"حمى الله من كيد الزمان خلائقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181360",""],[6093,"لعلَّهُ لا يعدُّ لنا هروبا","https://www.poetsgate.com/ViewPoem.aspx?id=176250",""],[6152,"إشراقة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203712",""],[6152,"ولدت مسافرا","https://www.poetsgate.com/ViewPoem.aspx?id=204435",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[6209,"نعيقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82549&r=&rc=18",""]],"verses":[["إذا ما قلت ويح البين ظنوا","بإن الوصل قبل البين طابا",0,"ب",2,0],["إِذا ما قُلتُ رَوَّحَ عَقرَ ظَهري","مِنَ الإِدلاجِ أَغبَطَ بِالجَوايا",1,"ا",3,0],["إِذا ما قيلَ مَلَّ رَأَيتَ مِنهُ","نَوازِعَ تَشرَئِبُّ إِلى اللِقاءِ",2,"ا",2,0],["إِذا ما قَضاها عادَ فيها كَأَنَّهُ","لِلَذَّتِهِ سَكرانُ أَو مُتَساكِرُ",3,"ر",1,0],["إِذا ما قُلتُ حانَ لَها أُفولٌ","تَصَعَّدَتِ الثُرَيّا وَالسُعودُ",4,"د",1,0],["إِذا ما قَطَعنا مِن قُرَيشٍ قَرابَةً","بِأَي نِجادٍ تَحمِلُ السَيفَ مَيسرا",5,"ر",2,0],["إِذَا مَا قَرَأْنَا لَهَا آيَةً","حَسِبْنَا الحُرُوفَ بِهَا شَادِيَهْ",6,"د",3,0],["إِذا ما قُرَيشٌ قيلَ أَينَ خِيارُها","أَقَرَّت بِهِ شُبّانِها وَكُهولُها",7,"ل",3,0],["إذا ما قال في بغداد شعراً","رواه له بأقصى الأرض راو",8,"و",1,0],["إِذا ما قُلتَ حانَ لَنا التَقاضي","بَخِلنَ بِعاجِلٍ وَوَعَدنَ دَينا",9,"ن",2,0],["إِذا ما قُرِّبَ الشُهَداءُ يَوماً","فَما لِلتَيمِ يَومَئِذٍ شَهيدُ",10,"د",1,0],["إذا ما قَضَت من أهلِ يَثرِبَ مَوعِدَاً","فَمَكَّةَ من أوطَانِها والمُحَصَّبُ",11,"ب",1,0],["إذا ما قصدتَ الأمرَ أول قصْدِه","ولم تَتْلُها أخرى فما حَصْحَصَ القصدُ",12,"د",1,0],["إذا ما قضيت اليوم لم أبك عهده","وأخلفت أدنى منه ظلّاً وأفنعا",13,"ع",2,0],["إذا ما قابَل الأبصا","رَ ظلَّتْ فيه منتضلَهْ",14,"ل",2,0],["إِذا ما قَسَمنا سَبيَ قَومٍ وَمالَهُم","دَعانا لِقَومٍ آخَرينَ مُزاحِمُ",15,"م",1,0],["إِذا ما قُلتُ قَد صالَحتُ بَكراً","أَبى الأَضغانُ وَالنَسَبُ البَعيدُ",16,"د",1,1],["إِذا ما قُرَيشُ المُلكِ يَوماً تَفاضَلوا","بَدا سابِقٌ مِن آلِ مَروانَ أَقرَحُ",17,"ح",1,0],["إِذا ما قُلتُ جاوَزَها لِأَرضٍ","تَذاءَبَتِ الرِياحُ لَهُ فَحارا",18,"ر",2,0],["إِذا ما قيلَ أَينَ حُماةُ ثَغرٍ","فَنَحنُ بِدَعوَةِ الداعي عُنينا",19,"ن",2,0],["اذا ما قضى رب السماوات حاجنا","حمدناه حمد المخلصين على الارض",20,"ض",1,1],["إِذا ما قَدَرتُ عَلى نَطقَةٍ","فَإِنّي عَلى تَركِها أَقدَرُ",21,"ر",1,0],["إِذا ما قدحتُمْ نارَ وجدٍ فإنَّما","شرارتُها فيكم وجَمْرَتُها عِندي",22,"د",2,0],["إِذا ما قَرَّبوهُ وَآنَسوهُ","غَلا في البُعدِ عَنهُم وَالنِفارِ",23,"ر",1,0],["إِذا ما قَتَلنا بِالسُيوفِ رِجالَها","تَقاضَينَ مِنّا بِالعُيونِ القَواتِلِ",24,"ل",1,0],["إِذا ما قَضَينا في البِلادِ قَضِيَّةً","جَرى بَينَ عَرضِ المَشرِقَينِ بَريدُها",25,"د",3,0],["إِذا ما قُلتَ قَد زَجَّيتُ غَمّاً","فَمَرَّ تَشَعَّبَت مِنهُ غُمومُ",26,"م",1,0],["إِذا ما قَضى لَهُ امرِئٍ فَكَأَنَّهُ","تَحَسُّفُ زَهرٍ أَو كِتابٌ يُمَجمَجُ",27,"ج",1,0],["إِذا ما قُلتَ مَهلاً قالَ مَه لا","وَحَقِّكَ لَيسَ ذا يَومِ اِختِصارِ",28,"ر",1,0],["إِذا ما قَلَّبوا في الحَشرِ قَلبي","رَأوا بَينَ الضُلوعِ هَوى حُسينِ",29,"ن",1,0],["إذا ما قذفْتُ ظلاماً بها","تَفَرّتْ جوانبُهُ عن شُعَل",30,"ل",1,0],["إِذا ما قُيِّدَت رَتَكَت وَلَيسَت","إِذا ما أُطلِقَت ذاتَ اِنطِلاقِ",31,"ق",1,0],["إذا ما قضى اللهُ أمراً فمَنْ","يردُّ القضاءَ الذي ينفذُ",32,"ذ",1,1],["إذا ما قلتَ إنَّ القرعَ يحكي","بني الورديِّ أخطأتَ الرميَّهْ",33,"ه",1,1],["إِذا ما قَضَينا ذاتَ نَفسٍ مُهِمَّةٍ","إِلَيها وَقَرَّت بِالهَوى العَينُ فَاِركَبا",34,"ب",2,0],["إِذا ما قَرَضتُ الشِعرَ في غَيرِ ذِكرِها","أَبي وَأَبيكُم أَن يُطاوِعَني شِعري",35,"ر",2,0],["إِذا ما قَضى الدَهرُ أَحكامَهُ","فَتِلكَ حُكومَةُ أَقضى القُضاةِ",36,"ه",1,0],["إِذا ما قَضَينا ذاتَ نَفسٍ مَريضَةٍ","إِلَيها وَقَرَّت بشالهَوى العَينُ فَاِركَبا",37,"ب",2,0],["إِذا ما قَلَّ مالي قَلَّ مَدحي","وَإِن أَثرَيتُ عادوا في اِمتِداحي",38,"ح",2,0],["إِذا ما قَلى الإِخوانَ كانَ مَرارَةً","يُعَرِّضُ في حَلقي مِراراً وَيَنشَبُ",39,"ب",1,0],["إِذا ما قُلتُ كَيفَ العَي","شُ قالَ شَرَنبَثٌ نَكِدُ",40,"د",1,0],["إِذا ما قُلتُ يا مَولا","يَ يَوماً قالَ يا عَبدي",41,"د",2,0],["إِذا ما قيلَ حَقٌّ في أُناسٍ","فَأَوجُهُهُم لَهُ مُتَرَبِّداتُ",42,"ت",1,0],["إِذا ماقُلتُ نَثراً أَو نَظيماً","تَتَبَّعَ سارِقو الأَلفاظِ لَفظي",43,"ي",1,0],["إذا ما قلتُ أينَ الوَصلُ قالتْ","طَلبتَ العِزَّ في دارِ الهَوانِ",44,"ن",1,0],["إِذَا مَا قُلْتُ زَهَّتْهَا عِصيُّ","عِصيُّ الرَّنْدِ والعُصُفُ السِّوَارِي",45,"ر",2,0],["إِذَا مَأْقِيَاهُ أَصْفَقَا الطرْفَ صَفْقَةً","كَصَفْقِ الصَّنَاعِ بِالطِّبَابِ تُقَابِلُهْ",46,"ل",2,0],["إِذَا مَا قَضَيْنَا وَاجِبَ الدِّينِ حَقَّهُ","فَلَيْسَ عَلَيْنَا فِي الْخَلاعَةِ مِنْ وِزْرِ",47,"ر",1,0],["إِذَا مَا قَضَى يَعْقُوبُ صَرُّوفَ نَحْبَهُ","فَمَهْمَا تَجِلِّي يَا صُرُوفَ النَّوى جِلِّي",48,"ل",2,0],["إِذا ما قَصَدت الناس فَاِقصد أَخا نَدا","طَليق المَحيا مجزلاً في هِباتِهِ",49,"ه",1,1],["إذَا مَا قُلتُ يَا هَنتُ ارحَمِيني","تَقُولُ مُجِيبَةٌ لاَه يَا هَنَاهُ",50,"ا",2,0],["إذا ما قلت قد أشجاك نوحي","ولنت قسا فؤادك فهو صلد",51,"د",1,0],["إذا ما قَهْقهَ الابريقُ عنَهْا","ليكسوْ الكأسَ منها أحسنَ الزِّيْ",52,"ز",2,0],["إِذا ما قُلتُ أَهجَعُ بَعضَ لَيلي","أَتَت ذِكَرٌ يُقَضُّ لَها المَنامُ",53,"م",1,0],["إذا ما قُلتُ أَسلُو عَن هَواها","تَدَاوىَ مُبتغِى طِبٍّ حَرِيصِ",54,"ص",1,0],["إذا ما قام فوق جواد جد","روى له الجبال الراسخون",55,"ن",1,0],["إذا ما قيل من بك قلتُ أودتْ","بسفك دمي جفون أبي الجميل",56,"ل",1,0],["إذا ما قَنعنا بالتواصل في الهوى","فلا أَنت معشوق ولا أنا عاشقُ",57,"ق",1,1],["إذا ما قرا حرفاً لتنفيس حفظه","فمقصوده أن نختم الحمدَ في شهرِ",58,"ر",1,0],["اذا ما قرا والفجرِ في عتماتِهِ","تراه يقاسيها إلى مطلع الفجرِ",58,"ر",1,0],["إذا ما قضاياه تخللن ظلمةً","توقَّدن إذ قد كُنَّ فيها قنادلا",59,"ل",2,0],["إذا ما قلت إني تبت عادت","جآذر وصلهن من الحتوف",60,"ف",1,0],["إذا ما قلت أجلى الوجدُ عني","تذكرتُ المعاهد والعهودا",61,"د",2,0],["إِذا ما قُلتُ أَقصَرَ أَو تَناهى","بِهِ الأَصواءُ لَجَّ بِهِ الطُلوعُ",62,"ع",1,0],["إذا ما قرأت إذا زلزلت","حَشيتُ بأن تقرا الواقِعه",63,"ع",2,0],["إِذا ما قيلَ ما أَعطى وَأَغنى","فَلا عُرفٌ لَديَّ وَلا نَكيرُ",64,"ر",1,0],["إذا ما قام أيرك في الدياجي","وعندك من تحب فلا تحابي",65,"ي",1,1],["إِذا ما قُلتُ خابِيَةٌ زَهاهاً","سَوادُ اللَيلِ وَالريحُ الدَبورُ",66,"ر",1,0],["إِذا ما قيلَ عيد الفطر وَلّى","أَجبناً إِنَّ هَذا العيد ثاني",67,"ن",2,0],["إذا ما قامَ دونَ الدِّينِ خَصمٌ","بلَوا منه أَشدَّ فَتىً مِحالا",68,"ل",2,0],["إذا ما قضَتْ نَفْسي من العِزِّ حاجةً","فلستُ أُبالي الدَّهرَ أمْلَى لها أمْ لا",69,"ل",2,0],["إِذا ما قلتُ إِنَّ عَلَيَّ دَيناً","بِطَعنةِ فارسٍ قَضَّيتُ دَيني",70,"ن",2,0],["إذا ما قلت شعراً لا","تصيِّر مدَّه دُونا",71,"ن",2,0],["إذا ما قيل من أفتى بفتكٍ","يشينهم وفتواه سَرِيُّ",72,"ي",1,0],["إِذا ما قُمتُ أَرحَلُها بِلَيلٍ","تَأَوَّهُ آهَةَ الرَجُلِ الحَزينِ",73,"ن",1,0],["إذا ما قرأت الشطر منه تصعدت","من الصدر نار تحرق الرق في يدي",74,"د",2,0],["إذا ما قربنا منهم أقبل النوى","يُبَعِّدُنا عن دارهم ويشرد",75,"د",1,0],["إذا ما قَعَدْتُم في الأُمور وقُمْتُمْ","عليها حُمِدْتُم قاعدين وقوّما",76,"م",2,0],["إذا ما قلت للأشياء