{"poems":[[55,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[37,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[43,"ترجل وضاح وأسبل بعدما","https://www.aldiwan.net/poem42353.html","الطويل"],[90,"كتبت لنفسي عهد تحريرها شعرا","https://www.aldiwan.net/poem45026.html","الطويل"],[29,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[29,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[47,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[63,"غداة الشك ندعوك","https://www.aldiwan.net/poem51402.html","الهزج"],[63,"غدت لذاتنا أمما","https://www.aldiwan.net/poem51435.html","مجزوء الوافر"],[51,"أخلاي بي شجو وليس بكم شجو","https://www.aldiwan.net/poem65366.html","الطويل"],[33,"إني ومن أحرم الحجيج له","https://www.aldiwan.net/poem41281.html","المنسرح"],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[83,"من لي بأن يدنو بعيد مزاره","https://www.aldiwan.net/poem61514.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[173,"أتاني كتاب منك عظمت قدره","https://www.aldiwan.net/poem1622.html",""],[199,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[203,"أمن الظبا ذاك الغرير المعجب","https://www.aldiwan.net/poem45580.html","الكامل"],[214,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[240,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[280,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[376,"ببعض الدمى قام بعض الفتن","https://www.aldiwan.net/poem57084.html","البسيط"],[438,"وعلقته متعلقا","https://www.aldiwan.net/poem12767.html","مجزوء الكامل"],[463,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[463,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[463,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[463,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[463,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[563,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[572,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87180","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37987","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145804","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59778","السريع"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59747","الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67837","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96604","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61131","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61063","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61102","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11951","المتقارب"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126666","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53152","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76127","المديد"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76067","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75971","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75899","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76068","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76093","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76041","الطويل"],[2908,"","https://poetry.dctabudhabi.ae/diwan/poem/145232","الطويل"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146494","المتقارب"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124273","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131244",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142938","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119655","الوافر"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/142523","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119541","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72656","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76761","الكامل"],[4702,"مشوار عز","https://www.poetsgate.com/ViewPoem.aspx?id=155169",""],[4771,"أبعْد ارتِحالِ الحَيِّ مِنْ جَو بارقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=106581",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""],[5031,"شدوُ البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=165139",""],[4119,"أشبا سيوف الهند أم عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=16201",""],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[5092,"قبلةٌ ومن أوّل السطر","https://www.poetsgate.com/ViewPoem.aspx?id=163043",""],[5156,"وعلقت ليلي وهي ذات ذؤابة","https://www.poetsgate.com/ViewPoem.aspx?id=99211",""],[5277,"رسالة منها...","https://www.poetsgate.com/ViewPoem.aspx?id=190741",""],[5277,"أميرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192119",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""]],"verses":[["وَعَلَّقنا مَطامِعَنا بِحَبلٍ","تُعَلَّقُهُ القُلوبُ بِغَيرِ راحِ",0,"ح",1,0],["وَعَلَّقَتهُ فَتاةٌ ما يُحاوِلُها","مِن أَهلِها مَيِّتٌ يَهذي بِها وَهِلُ",1,"ل",1,0],["وَعُلِّقَتني أُخَيرى ما تُلائِمُني","فَاِجتَمَعَ الحُبَّ حُبّاً كُلُّهُ تَبِلُ",1,"ل",1,0],["وَعُلِّقتُها وَسطَ الجَواري غَريرَةً","وَما قُلِّدَت إِلا التَميمَ المُنَظَّما",2,"م",2,0],["وَعُلِّقَ بَيضَاءَ العَوَارِضِ طَفلَةً","مُخَضَّبةَ الأطرَافِ طَيِّبةَ النَّسَم",3,"م",1,0],["وعلّقته كي لا تَناوّلَه يدٌ","بمنبَعَث الأنوار من ذروة الشعرى",4,"ر",2,0],["وَعَلِقتَ في قَرَنِ الثَلاثَةِ رابِعاً","مِثلَ البِكارِ لُزِزنَ في الأَقرانِ",5,"ن",1,0],["وَعَلِقتَ في مَرَسٍ يَمُدُّ قَرينَهُ","حَتّى اِلتَوى بِكَ مُحصَدٌ مَشزورُ",6,"ر",1,0],["وَعَلِقتُهُ كَالغُصنِ أَسمَرَ أَهيَفاً","وَعَشِقتُهُ كَالظَبِيِ أَحوَرَ أَكحَلا",7,"ل",2,0],["وَعَلِقتُ وَعدَ مُناجِزٍ","لا يَصحَبُ التَسويفَ وَعدُه",8,"د",2,0],["وعِلْقٌ يِحمِل الرَّايَ","ةَ لا غِشّاً وتَموِيها",9,"ي",3,0],["وعِلْقٌ مُعَلمٌ بالحُس","نِ أَضحى يَحْمِلُ العَلَما",10,"م",2,0],["وَعُلِّقتُ مَن يَزحو عَلَيَّ تَجَبُّراً","وَإِنِّيَ في كُلِّ الخِصالِ لَهُ كُفوُ",11,"و",1,0],["وَعُلَّقَتني أُخرى وَعُلَّقَها","ناشٍ يَصيدُ القُلوبَ كَالشَطَنِ",12,"ن",1,0],["وَعُلِّقتَها أَيّامَ قَلبُكَ موثَقٌ","لَدَيها فَدَعها الآنَ إِذ أَنتَ سالِمُ",13,"م",1,0],["وَعَلِقتُهُ وسَنانَ يَلعَبُ بِالنُهى","كَتَلاعُبِ الساقي بِكَأسِ عُقارِهِ",14,"ر",2,0],["وَعَلَّقوهُ في عُرى الجِدارِ","كَأَنَّهُ بَرّادَةٌ في الدارِ",15,"ر",1,0],["وَعَلقَمَةَ الجُعفيَّ أَدرَكَ رَكضُنا","عَلى الخَيلِ إِذ صامَ النَهارُ وَهَجَّرا",16,"ر",2,0],["وَعَلقمَةَ الجعفيَّ أَدرَكَ رَكضُنا","بِذِي النَخلِ إِذ صامَ النَهارُ وَهَجَّرا",17,"ر",2,0],["وعلِقْتم من عهدهم بسرابٍ","كمْ سُمومٍ تحت الشفاهِ البواسم",18,"م",1,0],["وعلقت بالأملِ العزيز محصّناً","بظوامِىء الأرماحِ والأسيافِ",19,"ف",1,0],["وعلقته فتاة ما يحاولها","ومن بني عمها ميت بها وهل",20,"ل",1,0],["وعلقتني أخيرى ما تلائمني","فاجتمع الحب ، حبٌ كله تبل",20,"ل",1,0],["وعلقوهم على الأعواد ما علموا","أَن العزائم لا تثنى بعيدان",21,"ن",1,0],["وعلقتها بالشوقِ في الملعبِ الذي","بهِ لعبتْ أَيدي البلى بِملاعبِ",22,"ب",1,0],["وَعَلَّقتُهُ في الصَدرِ مِنّي كَرامَةً","كَما عُلِّقَت صَدرَ الوَليدِ التَعاوِذُ",23,"ذ",1,0],["وَعَلَّقَ اللَهُ أَسبابَ الأُمورِ بِهِ","وَلَم يُطِق حامِلٌ فَوقَ الَّذي اِضطَلَعا",24,"ع",2,0],["وعلقتهُ كالظبيِ أحورَ يُرتجى","وعشقتهُ كالليثَ أزورَ يرهبُ",25,"ب",1,0],["وعلقت آمالي بحبل رجائه","لعلمي فيه انه محكم البرم",26,"م",1,0],["وَعَلِقتُ مِنهُ بِحَبلِ مَرهوبِ السُطى","وَالبَأسِ ضَرّارِ اليَدَينِ نَفوعِ",27,"ع",1,0],["وَعلّقتُ أَعْرابِيَّة دارُها الفَلا","تَصيفُ علَى نَجْدٍ وَتَشْتُو علَى حُزْوَى",28,"و",2,0],["وعلق معانيها قبيل فراقه","فترسخ بالتكرار في صحف أذهان",29,"ن",1,0],["وعُلِّقتُه شادِناً شادِياً","علَيه الشَّجَى وعَليَّ الشَّجَن",30,"ن",1,0],["وعلِقْتُه متعلِّقاً","بالخطّ معتَكِفاً عليْهِ",31,"ي",2,1],["وعلِقتُ منه فطار بي متحلّقا","بقويّ قادمةِ الجنَاح أمينِ",32,"ن",1,0],["وعُلِّقتْ من أمرها ونَهيها","بذروة العلياء أو سَنامِها",33,"م",3,0],["وعَلّقتُ بالأسماع كلَّ غريبةٍ","بأمثالها لم تُفترَعْ أذُنٌ قبلُ",34,"ل",1,0],["وعَلِقَتْ بقلبه ناشطةٌ","مرَّت عليه من بُنَيَّاتِ الفِكَرْ",35,"ر",1,0],["وعلَّقتُ المودّةَ منك كفِّي","على زِلقٍ متينِ الفتلِ شَزْرا",36,"ر",2,0],["وعلِقتُ منها ذمَّةً ومودّةً","أن فات حمّادٌ بحبلِ شبيبِ",37,"ب",1,0],["وعلقوا بالبيت أصنامهم","ودنسوا البيت الحرام العتيق",38,"ق",1,0],["وَعَلَّقْنَ سُودَ مَسَابِحِهِنَّ","دُوَيْنَ النُّهُودِ وَفَوْقَ السُّرَرْ",39,"ر",1,0],["وَعَلِقتُ مِن سُلطانِهِ أب","نِ نِبيِّهِ ابن وصيه ابنِ إمامِِه",40,"م",2,0],["وَعلقت آمال العذول بسلوة","لِذَنب جَناه مَن رَنا فَرَماني",41,"ن",2,0],["وَعَلَّقت آمالاً بِدُنيايَ إِذ حَلَت","وَهاتيكَ آمالٌ تَؤولُ إِلى اليأسِ",42,"س",1,0],["وَعَلّقْ منادِيْلَكَ الناحِبَات","على مغربِ الأرض ِوالمشرقِ",43,"ق",1,0],["وعلق القرطق من خده","يحكي ضياء البدر في الدجنة",44,"ه",1,0],["وعَلقته كالغصن بين حدائق","يختال بين قراطق ومناطق",45,"ق",1,1],["وَعَلَّقْتُ آمَالي بِتِلْكَ الْمَطَامِعِ","غِيَاثٌ يُرَجَّى عِنْدَ ضِيقِ الْمَسَالِكِ",46,"ك",1,0],["وَعلقتُ بِالزاكي أبي العربِ الّذي","عمّ الأنامَ غوايلاً وَرَغائبا",47,"ب",2,0],["وَعلقته كَالبَدر عِندَ تَمامه","وَكالغُصن في أَعطافه وَقوامه",48,"م",2,1],["وَعَلقتها طفلاً صَغيراً وَيافِعا","فَما إِن أَرى عَنها حَياتي لأَنزعا",49,"ع",2,0],["وَعلقته مثل غصن النقا","تَنؤ بِهِ لينات البُرود",50,"د",1,1],["وعلّقا بالفعل أو كالفعل في","معنى وجرّد خمسة في الأحرف",51,"ف",1,0],["وعُلّقْتُ محْبوباً إليَّ دلالُه","سواءُ علَيْه في الهَوى زارَ أو جَفا",52,"ف",2,0],["وَعِلقٍ تَعَلَّقتُهُ بَعدَ ما","غَدا مِنهُ كُلُّ جَديدٍ خَليعا",53,"ع",2,1],["وعلقه فأبصرنا الثريا","وأرسلنا عليها العين رصدا",54,"د",2,0],["وعلقت منك بماجد مهما أقل","فيه كفاني أن أقول مصدّقا",55,"ق",2,0],["وَعُلِّقتُهُ مسوَدَّ عَينٍ وَوَفرَةٍ","وَثَوبٍ يُعاني صَنعةَ الفَحم عَن قَصدِ",56,"د",1,1],["وَعُلِّقتهُ رِيماً وَعُلِّقَ آخَرا","هَوى آخَراً يَهذِي بِبَدرِ تمامِ",57,"م",1,0],["وَعلّقَ أُخرى حَبَّها آخَرٌ هَوى","أُخيرى غَدَت تَهذِي بآخرَ رامِ",57,"م",1,0],["وَعلّقتُه تركي أَصلٍ وَمُقلَةٍ","لَهُ نَسَبٌ في آلِ خاقان خالِصُ",58,"ص",1,0],["وَعلّقتُهُ صَعبَ المقادَةِ آبياً","كَثيرَ التَوقي صَيِّنا ذا تَشَدُّدِ",59,"د",1,0],["وَعُلِّقتُهُ وَالسَيفُ بَيني وَبَينَهُ","غَزالاً وَلَكن قاتِلٌ لِلضراغمِ",60,"م",1,1],["وَعُلِّقتُها سَمراءَ أَمّا قَوامُها","فَللسُمرِ وَالأَلحاظِ للشادِنِ الأَحوى",61,"و",2,0],["وَعلِّقتُهُ ما اسودَّ مِنهُ سِوى المُقَل","وَوافِر دَيجورٍ عَلى الرِدفِ قَد أَطَل",62,"ل",1,1],["وعلق من فرع الغصون جواهراً","ورصع ديباجاً بدر منضد",63,"د",1,0],["وعِلقٍ نفيسٍ تعلقتُه","فزار على خلوةٍ وارتياع",64,"ع",1,1],["وَعُلقَةٌ حَاصِلَةٌ بتابعِ","كعُلَقَةٍ بِنَفسِ الإسمِ الوَاقِعِ",65,"ع",1,0],["وعل قربا معنويا منكم","بنيله الحسى دافع الأذى",66,"ذ",2,0],["وعلق قلبٌ بين جنبيك مظلمٌ","فما غر حراً أن وجهك مشرق",67,"ق",1,0],["وعلِّقنْ سوطك حيث قل يراه","أهلك زد عليك نفسك تراهْ",68,"ه",1,0],["وعلقت أمالي فأبيض صارم","وأسمر خطيٍّ وأجرد سابق",69,"ق",1,0],["وَعَلق لم يزل لهجاً بذامي","بلا حسبٍ ولا نسبٍ مبين",70,"ن",1,0],["وعُلِّقَت بابلٌ في ظِلِّ دَاليةٍ","فَعَلَّقَت طِيبةٌ في صَدركِ العِنَبا",71,"ب",2,0],["وعلَّقتُ آمالي بأعطاف لطفهِ","بسرّي وإعلاني وما في طويتي",72,"ي",1,0],["وعلق القلب به ومرضا","فاستلّ مني سيف عزم منتضى",73,"ض",2,0],["وعلق ورد الوجنتين بعنبر","أديف بمسك ناشرا عرف عرفان",74,"ن",1,0],["وعلقته في الحب علق مظنةٍ","أرخصت فيها العمر وهو ثمين",75,"ن",1,1],["وْعلقت لي في كل نجمٍ تعدّيت","أروع قصيدي بالذهب نقش وخضاب",76,"ب",1,0],["وَعلَّقتُ آمالي بأبيض صارمٍٍ","وأسَمر خَطيِّ وأجَردَ سابقِ",77,"ق",1,0],["وعلقوا جهدهم بالغُنْمِ إذْ عشقوا","أرضا بمنطقهم بالحب مصطحبة",78,"ب",2,0],["وَعلَّقْتُ النُّجُومَ علَى عُيُونٍ","تَوَهّجَ في تَساؤلِها الصَّلِيْلُ",79,"ل",1,0],["وعلقت في أشراككم فاصطدتني","وتعطلت عن صيدكم أشراكي",80,"ك",2,0],["وعلقت بالثديين ترضع منهما","جشعاً وما استثنيت رضع بناني",81,"ن",2,0],["وعلّقتُ الجراحَ على حروفي","فما أحداً رآها وما بكاني",82,"ن",2,0],["وعلقت ليلي وهي ذات ذؤابة","ترد علينا بالعشي المراميا",83,"ي",2,1],["وعَلِقتُ فيكَ وصرتَ كوني كلَّهُ","لولاكَ ما عرفَ الهوى لولاكا",84,"ك",2,0],["وعَلِقتُ فيكِ وصرتِ وجدي كلّهُ","لولاكِ ما عرفَ الهوى لولاكِ",85,"ك",1,0],["وعلَّقْتُ أشياء َ الهوي وشفيتُ من","حماقتِهِ الكبري بعرْوةِ نسياني",86,"ن",2,0],["وعَلّقتُ بحبلِ اللهِ","كفِّيَ فهو الحَبْلُ",87,"ل",1,0]]}