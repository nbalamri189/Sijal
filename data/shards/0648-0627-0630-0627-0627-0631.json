wPoem.aspx?id=214042",""],[4767,"منير","https://www.poetsgate.com/ViewPoem.aspx?id=98577",""],[4858,"ومن المساجد ينبع الظفر","https://www.poetsgate.com/ViewPoem.aspx?id=37236",""],[4858,"ذكرياتٌ وحنينٌ","https://www.poetsgate.com/ViewPoem.aspx?id=138783",""],[4862,"كلمة وفاء لسيدة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=55515",""],[4929,"قُلْ للذي أبْكَتْ يداهُ زماني","https://www.poetsgate.com/ViewPoem.aspx?id=199282",""],[4978,"رد على قصيدة لك الله ياصومال","https://www.poetsgate.com/ViewPoem.aspx?id=177246",""],[5054,"لا يا خليلي","https://www.poetsgate.com/ViewPoem.aspx?id=215692",""],[5057,"ياخاله","https://www.poetsgate.com/ViewPoem.aspx?id=203632",""],[5121,"غَرِّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=183758",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5189,"سهمٌ أصاب القلب","https://www.poetsgate.com/ViewPoem.aspx?id=197542",""],[5190,"روح وريحان","https://www.poetsgate.com/ViewPoem.aspx?id=121512",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5338,"القلب شوقا للقاء طموح","https://www.poetsgate.com/ViewPoem.aspx?id=187677",""],[592,"وإذا أردت ترى مصارع من ثوى","https://www.poetsgate.com/ViewPoem.aspx?id=128824",""],[5376,"أرَّا ومارَّا والعواصمُ واحدُ","https://www.poetsgate.com/ViewPoem.aspx?id=196641",""],[5376,"للأُسْدِ أنيابٌ لها ومغانمُ","https://www.poetsgate.com/ViewPoem.aspx?id=214071",""],[5431,"تغريبة الحضارة العربية ...","https://www.poetsgate.com/ViewPoem.aspx?id=212197",""],[5518,"في مدح الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=201599",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[5582,"طَرَقَ الطَّيْفُ وَقَدْ زارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186881",""],[5688,"لو كان يملك...","https://www.poetsgate.com/ViewPoem.aspx?id=200776",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5790,"وأنا السعيد إذا صلح","https://www.poetsgate.com/ViewPoem.aspx?id=111881",""],[5943,"يا أنَّةَ الصَّدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=61778",""],[6070,"إعدلْ هداكَ اللهُ للإحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188631",""],[6093,"شفتان وقهوة","https://www.poetsgate.com/ViewPoem.aspx?id=204117",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""],[6102,"الأَماسِيُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182862",""],[1333,"لو كنت في ديني من الابطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56026&r=&rc=4",""],[6259,"أتروم تغطية َ الهوى بجحوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59366&r=&rc=14",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِذا اِرتَقى الآباءُ أَمنَعَ نَجوَةٍ","فَدَع الرَدى يَستَنزِلُ الأَبناءَ",0,"ا",2,0],["وَإِذَا أَرَدْتَ الْعِزَّ لاَ","تَرْزَأ بَنِي الدُّنْيَا قُلاَمَهْ",1,"م",2,0],["وَإِذَا أَرَدْتَ لَهَا زِيَادَةَ نِسْبَةٍ","هَذِي وَهَذِي فِي الْكِنَانَةِ تُجْعَلُ",2,"ل",1,0],["وَإِذَا أَرَادَ اللهُ بُرْءَ زَمَانَةٍ","لَمْ تَعْدُ مِيقَاتاً لَهَا مَكْتُوبَا",3,"ب",2,0],["وَإِذا أَرَدتَ بِأَرضِ عُكلٍ نائِلاً","فَاِعمِد لِبَيتِ رَبيعَةَ بنِ حُذارِ",4,"ر",1,1],["وإذا أردت من الزمان مضاحكاً","فَتَحَسَّ منها قَرقَفاً ورحيقا",5,"ق",2,0],["وإذا أردن زيارة فكأنما","ينقلن أرجلهن من أوحال",6,"ل",1,0],["وإذا أرابَ الرأيُ من ذي هفوةٍ","ضمنتْ إنابةُ رأيهِ تأنيبَهُ",7,"ب",2,0],["وإذا ارْتأى رَأياً فأثْقَبُ ناِظرٍ","نظراً وأبْعَدُهُ مَدَى تطريحِ",8,"ح",1,0],["وإذا أراك نَدَاهُ يوْماً زُهْدَهُ","أبصرتَ زُهْدَ مُحالِفِ الأمْساحِ",9,"ح",1,0],["وإذا أراك مزاحه من جدِّه","أجناك صفوَ ودائع الأجباحِ",9,"ح",1,0],["وإذا ارتأى فكمن رأى","وإذا سها فكمن تفقَّدْ",10,"د",1,0],["وَإِذا أُريدَ بِهِم عُقوبَةَ فاجِرٍ","مَطَرَت صَواعِقُهُم عَلَيهِ بِنارِ",11,"ر",1,0],["وَإِذا أَرَدتَ زِيادَةً","خُذها وَنَفسي راضِيَه",12,"ي",2,0],["وَإِذا اِرتَدى ثَوباً جَميلاً لَم أَقُل","يا لَيتَ أَنَّ عَلَيَّ حُسنَ رِدائِهِ",13,"ا",3,0],["وَإِذا أَرَدتِ وَلَن يَخونَكِ كاتِمٌ","حَتّى يُشيعَ حَديثَكِ الإِظهارُ",14,"ر",1,0],["وإذا أراد الله أمرا لم يكن","في وسع عبد عاجز تأخيره",15,"ر",2,0],["واذا اراد اللَه امراً","بالعباد فلا مردّا",16,"د",2,0],["وإذا ارتدى ثوب النصو","ح فإن منه الشهد علقم",17,"م",1,0],["وَإِذا أَرادَ اللَهُ إِشقاءَ القُرى","جَعَلَ الهُداةَ بِها دُعاةَ شِقاقِ",18,"ق",1,0],["وَإِذا اِرتَحَلتَ فَشَيَّعَتكَ سَلامَةٌ","حَيثُ اِتَّجَهتَ وَديمَةٌ مِدرارُ",19,"ر",1,0],["وإذا ارتقى في صبغه","صُعُداً فغُنمٌ باردُ",20,"د",1,0],["وَإِذا أَرَدتَ جَعَلتَ يَومَ إِقامَةٍ","يَقِفُ السُرورُ بِهِ وَيَومَ تَرَحُّلِ",21,"ل",1,0],["وَإِذا أَرَدتُ لَبِستُ مِنكَ مَواهِباً","يَنشُرنَ نَشرَ الوَردِ في أَكمامِهِ",22,"م",2,0],["وإذا ارتدى بالسَّيفِ خَفَّ مَضاؤُه","وإذا ارتدى بالحِلمِ كان يَرَمْرَما",23,"م",2,0],["وإذا ارتقى دَرَجَ العُلا قالَتْ له","أَوفَيتَ أقصَى المُرتَقى فتَصَدَّرِ",24,"ر",1,0],["وَإِذا أَرَدتَ ذَخيرَةً تَبقى فَنا","فِس في اِدِّخارِ الباقِياتِ الصالِحاتِ",25,"ت",1,0],["وَإِذا أَرَدتَ بِأَنْ تُصَوِّرَ للمُنى","صُوَراً فَسَلِّمْها لِفِكرَةِ شاعِرِ",26,"ر",1,0],["وَإِذا أَرَدتُ بِها سِواكَ فَرُضتُها","وَاِقتَدتُها بِثَنائِهِ لَم تَنقَدِ",27,"د",1,0],["وَإِذا أَرادَ اللَهُ نَشرَ فَضيلَةٍ","طُوِيَت أَتاحَ لَها لِسانَ حَسودِ",28,"د",1,0],["وإذا أراد اللهُ نشرَ فضيلةٍ","طُويَتْ أقامَ لها رئيسَ زمانِ",29,"ن",1,0],["وإذا أراد اللهُ نجدةَ أُمَّةٍ","نَصرَ الحُماةَ وأيَّدَ الأنصارا",30,"ر",2,0],["وَإِذا أَرادوا نَهضَةً نَفَرَت لَهُم","حُمُرٌ خَلا الوادي فَكُنَّ سباعا",31,"ع",2,0],["وَإِذا أَرادَ بِها الهَضيمَةَ أَرهَقَت","هِمَماً يَضيقُ بِها الدُهاةُ ذِراعا",31,"ع",2,0],["وَإِذا أَرادَ اللَهُ شَرّاً بِاِمرِئٍ","تَبِعَ الغُواةَ وَطاوَعَ الجُهّالا",32,"ل",2,0],["وَإِذا أَرَدتُ تَصابِياً في مَجلِسٍ","فَالشَيبُ يَضحَكُ لي مَعَ الأَصحابِ",33,"ب",1,0],["وإِذا أرادَ اللَّهُ فِتْنَةَ مَعْشَرٍ","وَأَضَلَّهُمْ رَأَوُا القَبِيحَ جَمِيلا",34,"ل",2,0],["وَإذَا أرَادَ اللَّهُ حِفظَ وَلِيِّهِ","خَرَجَ الهَوَى مِنْ قَلْبِهِ مَعْزُولا",35,"ل",2,0],["وإذا ارتمَتْهُ بما تَريشُ ومُكّنَتْ","فأصابَ أسْودَ قلْبِهِ إمكانُها",36,"ن",3,0],["وإذا أردتَ على المشيبِ وِفادَةً","فاجعلْ إليه مَطيّكَ الأحقابا",37,"ب",2,0],["وَإِذا أَرَدتَ مَديحَ قَومٍ لَم تَمِن","في مَدحِهِم فَاِمدَح بَني العَبّاسِ",38,"س",1,0],["وَإِذا أَرَدنَ لَها مُحاوَرَةً","رَوَّحنَ ما عَزَّبنَ مِن حِلمِ",39,"م",1,0],["وَإِذا أَرَدتَ عِداتِها بِخِلَت بِها","حَتّى الفُؤادِ وَصافَحَتكَ جَمادا",40,"د",2,0],["وَإِذا أَرَدتَ طِلاعَ أُمِّ مُحَمَّدٍ","غَلَبَ القَضاءُ وَشُؤمُ عَبدِ الواهِبِ",41,"ب",1,0],["وَإِذا أَرَدتُم لِلبَنينَ كَرامَةً","فَالحَزمُ أَجمَعُ تَركُهُم في الأَظهُرِ",42,"ر",1,0],["وَإِذَا أَرادَ اللهُ رَحْمَةَ أُمَّةٍ","بَعَثَ الشِّفَاءَ لَهَا بِخَيْرِ طَبِيبِ",43,"ب",1,0],["وَإِذَا أَرَابَكُمَا الزَّمَانُ بِوَحْشَةٍ","فَاسْتَمْخِضَاهُ الْيُسْرَ بِالإِيْنَاسِ",44,"س",1,0],["وَإِذا أَرادَ اللَهُ ميتَةُ مُدنفٍ","أَخفى عَلى الآسي دَواء الداءِ",45,"ا",2,0],["واذا ا رزمت وحنت لألف الطب","ع فارفض حنينها وبكاها",46,"ا",3,0],["وإِذا أرادَ الله فِتْنَة َ مَعْشَرٍ","والآخِرونَ الأوَّلونَ فَقوْمُه",47,"ه",1,0],["وَإذا أرادَ الله حِفْظَ وَلِيِّهِ","ويَرُومُ مِنْ حَرِّ الهَجِيرِ مَقِيلا",47,"ل",2,0],["وإذا أردتَعلى الحياة دلائلا","لم تلق مثلَ تآلف الأضّداد",48,"د",1,0],["وإذا ارتختْ عُقَدٌ تيسّرَ حلُّها","جدُّوا لكم عُقَداً تُريدُ حُلولا",49,"ل",2,0],["وَإذا أرَدْتَ لَبِسْتُ منكَ مَوَاهِباً،","يُنْشَرْنَ نَشْرَ الوَرْدِ مِنْ أكْمَامِهِ",50,"م",2,0],["وإذا أَرادَت أُمَّةٌ","رشداً فَما شيءٌ يحول",51,"ل",1,0],["وإذا أرسلت من الطرف سهما","صار شهم البيدا طعيناً صريعا",52,"ع",2,0],["وإذا أرادَ إرادةً","في الخلق شاورَ من حضَرْ",53,"ر",1,0],["وإذا أردتَ من النِّساءِ خريدةً","فأنظر إليها نظرة الحُكماءِ",54,"ا",2,0],["واذا أرادَ المُستَزِيدَ","فمَن له يُعطى لهُ",55,"ه",1,0],["واذا أرادت لا مَرَد","هيهاتِ أن تَخشى أحد",56,"د",1,0],["وإذا أردتَ البدرَ فابعث نظرةً","لمطالع بين اللِّوى فمُحَجَّرِ",57,"ر",1,0],["وَإِذا أَرَدتُكَ بِالمَديحِ تَفَتَّحَت","أَغلاقُهُ وَتَسَهَّلَت أَوعارُهُ",58,"ر",2,0],["وَإِذا أَرَدتَ بَوارَ مَملَكَةٍ طَغَت","سَفَهاً فَبَعثُكَ رايَةً عُنوانُهُ",59,"ن",2,0],["وإذا أراد الله تبليغ امرئٍ","فالعرب خاضعة له والروم",60,"م",1,0],["وإذا أردت من ال