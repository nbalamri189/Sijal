,[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""],[6291,"ألستم خير من ركب المطايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87688&r=&rc=19",""]],"verses":[["تَبِعتُ فُؤادي إِلى حُبِّهِ","مُطيعاً وَإِن لَجَّ عِصيانُهُ",0,"ن",2,0],["تَبَعَّقَ حَتّى خِلتُ أَنَّ بُعاقَهُ","عَلى عَدَمِ الجَدوى أَكُفُّ تَميمِ",1,"م",1,0],["تَبِعوا أَمرَ المَقاديرِ فَهُم","قاطِنٌ يَظعَنُ أَو دانٍ يَشُطّ",2,"ط",1,0],["تَبَعَّقُ بِالأَطباءِ مِن كُلِّ فيقَةٍ","كَمَخضِ الغَريرِيِّ المَزادَ المُوَكَّرا",3,"ر",2,0],["تَبِعْتُ أَضَالِيلَ المُنى في شَبيبَتي","فَحَلَّ مَشيبي وَهيَ تَخْدَعُني بَعْدُ",4,"د",1,0],["تَبِعوا الضَلالَةَ ناكِبينَ عَنِ الهُدى","وَالتَغلِبِيُّ عَمي الفُؤادِ ضَلولُ",5,"ل",1,0],["تبعوا الهوى فهوى بهم وكذا الهوى","منه الهُوِيُّ بأهله فحَذارِ",6,"ر",1,0],["تَبعَثُ الحُبَّ إِلى قَلبِ الخَلي","وَهوَ لا يَدري وَلا يَستَشعِرُ",7,"ر",1,0],["تَبِعتُ الَّذي يُرضيكَ في كُلِّ حالَةٍ","فَإِن كُنتَ لَم تُبصِرهُ فَاللَهُ يُبصِرُ",8,"ر",1,0],["تبعتهمُ حتى ثَوَوا في حفائرٍ","وحجَّبهم عني من الترب حاجب",9,"ب",1,0],["تَبعا كانت ورقَّا في النوى","وقليل للهوى ما أتبعك",10,"ك",1,0],["تبعث فيها الهمة الأبيه","فتأنف المواقف الدنيه",11,"ي",2,0],["تَبِعتِ مُحَمَّداً مِن بَعدِ عيسى","لِخَيرِكِ في سِنيكِ الأولَياتِ",12,"ت",1,0],["تَبعَثُ أَنّى بَدَت","ضَوءَ جَبينٍ وَفَم",13,"م",1,0],["تَبِعتُ رِجالاً أَطلُبُ المالَ عِندَهُم","فَكَيفَ يَكونُ المالُ مُطَّلَباً عِندي",14,"د",2,0],["تَبِعَت بَنو العَبّاسِ هَديَ مُوَفَّقٍ","ثَبتِ البَصيرَةِ بِالمَحَجَّةِ هادِ",15,"د",1,0],["تَبِعنا مَوقَعَ النِسرَينِ حَتّى","تَرَكنا مُخَّ أَسمَنِهِنَّ رارا",16,"ر",2,0],["تَبِعوا رَسولَهُمُ بِسُنَّتِهِ","حَتّى لَقوهُ وَهُم عَلى قَدرِ",17,"ر",1,1],["تَبِعَ الحِمارَ مُكَلَّماً فَأَصابَهُ","بِنَهيقِهِ مِن خَلفِهِ بِنِكالِ",18,"ل",1,0],["تَبِعَ الهَوى قَومٌ فَكانَ هَواهُ في","طَلَبِ العُلى وَتَجَنُّبِ الشَهَواتِ",19,"ت",1,0],["تبعته تقتفي أحلامَهُ","كلّما أغفى أطلَّت فرآها",20,"ا",3,0],["تبعث السلوى وتنسى ال","موت مهتوك القناع",21,"ع",1,0],["تبعَ الخلائقَ في الوفاةِ ملوكُهمْ","فكأنَّهمْ كانوا على ميعادِ",22,"د",1,1],["تَبِعتُهُمُ بِطَرفِ العَينِ حَتّى","أَتى مِن دونِهِم خَرقٌ بَطينُ",23,"ن",1,0],["تَبِعتُهُمُ بِطَرفِ العَي","نِ حَتّى قيلَ لي اِفتَضَحا",24,"ح",2,0],["تبعثها عيناكِ في أضلعي","فياضةً بعطفها آسيه",25,"ي",2,0],["تَبِعتُهُمُ وَضَيَّعتُ المَوالي","فَأَلقَوا لِلضِباعِ دَمي وَلَحمي",26,"م",2,0],["تَبَّعتُهُم بَصَري حَتّى تَدَمَّنَهُم","مِنَ الجَمادِ وَوادي الغابَةِ البُرَقُ",27,"ق",1,0],["تَبَعَت عَطاياهُ مَواهِبَهُ","كَالسَيلِ مُتَّبِعاً قَفا مَطَرِه",28,"ر",2,0],["تَبِعَت تُبَعاً وَفي القَصرِ غالَت","قَيصَراً وَاِنتَحَت لِكِسرى بِكَسرِ",29,"ر",1,0],["تَبِعتُ رَسُولَ اللَهِ إِذ جاءَ بالهُدى","وَيَتلُو كِتاباً كالمَجَرَّةِ نَيِّرا",30,"ر",2,0],["تبعت الغواة وما أسلفوا","فهلا أخذت بقول السلف",31,"ف",1,0],["تَبِعْتُ خُطَّةَ آبَائِي فَسِرْتُ بِهَا","عَلَى وَتِيرَةِ آدَابٍ وَآسَالِ",32,"ل",1,0],["تَبِعْتُ نَهْجَ أَبِي فَضْلاً وَمَحْمِيَةً","حَتَّى بَرَعْتُ وَكَانَ الْفَضْلُ لِلْبَادِي",33,"د",2,0],["تَبِعَ الْهَوَى قَلْبِي فَهَامَ وَلَيْتَهُ","قَبْلَ التَّوَغُّلِ فِي البَلاءِ تَثَبَّتَا",34,"ت",2,0],["تَبْعَثُ اللَّهْوَ والسُّرُورَ وَتَمْحُو","مِنْ فُؤادِ الْحَزِينِ كُلَّ شَكاةِ",35,"ه",1,0],["تَبْعَثُ الشَّمْسُ بَاهِرَاتِ شِعَاعٍ","تَغْتَدِي فِي انْحِدَارِهَا شِبْهَ رُبْدِ",36,"د",1,0],["تَبِعَتْ هُدَى فَاعْتَزَّ جَانِبُهَا","وَلِكُلِّ مَنْ تَبِعَ الْهُدَى الْفَخْرُ",37,"ر",1,0],["تبعوا نعقته وانجلفوا","نحوه اشباه ضان وبقر",38,"ر",1,0],["تبعثه ريح الصبا فيبتدي","في جوفه روح وفي الأرض جسد",39,"د",1,0],["تبعتهمْ بصري حتى تضمنهُم","من الجُمَادِ ووادي الغابة ِ البُرَقُ",40,"ق",1,0],["تبعث الدنيا حسنها","مثلما تجلو ليالي العرس بكرا",41,"ر",2,0],["تبعث عطاياه مواهبهُ","كالسيل متبعاً قفا مطره",42,"ر",2,0],["تبعتهمُ بطرفِ العي","نِ حَتَّى قِيلَ لي کفْتَضَحا",43,"ح",2,0],["تبعثه سيولا","لواعج اضطرامي",44,"م",2,0],["تبعث ثاية من اهوى فغالطني","زمزمت مشتملا والحب مقتبل",45,"ل",1,0],["تبعت احمد في منهاج سنته","ما زاغ منك بذاك المنهج البصر",