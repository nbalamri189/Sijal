الضَوءَ مِن مَطلَعِ الشَمسِ",1,"س",1,0],["كَأَنَّ حَوافِرَها وَالصُخورَ","إِذا ما ذَرَعنَ الدُجى في صَخَب",2,"ب",1,0],["كأنّ حُداةَ الرّعْدِ ضلّتْ طريقَها","فهزّتْ لكَيْما تهْتَدي مِشْعَلَ البرْقِ",3,"ق",1,0],["كَانَ حُلْماً فَوَيْحَ مَنْ أَمَّلَ الدَّهْ","رَ وَأَعْمَاهُ جَهْلُهُ وَأَصَمَّه",4,"م",2,0],["كَأَنَّ حُدوجَ المالِكِيَّةِ غُدوَةً","نَواعِمُ يَجري الماءُ رَفهاً خِلالَها",5,"ل",3,0],["كانَ حُرَّ الآراءِ لا يَعرِفُ الخَت","لَ وَلا يَستَبيحُ غَيبَ الصِحابِ",6,"ب",1,0],["كَأَنَّ حُمولَهُم لَمّا تَوَلَّت","بِيَليَلَ وَالنَوى ذاتُ اِنفِتالِ",7,"ل",1,0],["كَأَنَّ حُمولَ الحَيِّ حينَ تَحَمَّلوا","صَريمَةُ نَخلٍ أَو صَريمَةُ إيدَعِ",8,"ع",1,0],["كَأَنَّ حُمولَها بِمَلا تَريمٍ","سَفينٌ بِالشُعَيبَةِ ما تَسيرُ",9,"ر",1,0],["كأَنَّ حَدائِجَ أَظعانِها","بِغَيقَةِ لَمّا هَبَطنَ البِراثا",10,"ث",2,0],["كَانَ حَقَّ الزَّمَانِ إِعْطَاءَكَ الآلافِ","لا الأَخْذِ مِنْكَ شَلَّ يَمِينَا",11,"ن",2,0],["كَأَنَّ حُبابَي رَملَةٍ حَبَوا لَها","بِحَيثُ اِستَقَرَّت مِن مُناخٍ وَمُرسَلِ",12,"ل",1,0],["كَأَنَّ حِجالَهُنَّ أَوَت إِلَيها","ظِبآءُ الرَملِ باشَرنَ المَغارا",13,"ر",2,0],["كَأَنَّ حِرباءَها في كُلِّ هاجِرَةٍ","ذو شَيَبة مِن رِجالِ الهِندِ مَصلوبُ",14,"ب",1,0],["كان حبل الإخاء فيكم وثيقاً","كيف أمسى وعَقده محلول",15,"ل",1,0],["كَأَنَّ حادِيَها لَمّا أَضَرَّ بِها","بازٍ يُصَعصِعُ بِالسَهبا قَطاً جونا",16,"ن",2,0],["كَأَنَّ حُداتَنا الزَجلينَ هاجوا","بِخَبتٍ أَو سَماوَتِهِ نَعاما",17,"م",2,0],["كأن حديثهن غريض مزن","بما تقرِي المخصرَّة اللسوبُ",18,"ب",1,1],["كأن حصى المعزاء بين فروجها","نوى الرضخ يلقى المصعدُ المتصوِبُ",19,"ب",1,1],["كأنَّ حُسَيناً والبَهَالِيلَ حَولَه","لأَسيَافِهِم ما يَختَلِي المُتَبقِّلُ",20,"ل",1,0],["كأنَّ حديثه في كلِّ نادٍ","حديث النار عن نفسِ العبير",21,"ر",1,0],["كأنّ حلاوة إحضاره","حلاوة يوم خميس العدس",22,"س",1,0],["كأن حَب سقيطِ الطل بينهما","دمعٌ تحير في أجفان مهجور",23,"ر",1,0],["كان حياة صفت بعافية","هيهات منها ملال ذائقها",24,"ق",3,0],["كَأَنَّ حيرانَها في كُلِّ مَنزِلَةٍ","قَتلى مُجَرَّدَةُ الأَوصالِ تُستَلَبُ",25,"ب",1,0],["كَأَنَّ حُبوبُها خُضرا وَصُفراً","فُصوصَ زُمُرُّد وَشُذورَ تِبرِ",26,"ر",1,0],["كَأَنَّ حَفيفَ النَبلِ مِن فَوقِ عَجزِها","غَوارِبُ نَحلٍ أَخطَأَ الغارَ مُطنِفُ",27,"ف",1,0],["كانَ حُلواً هَذا الهَوى فَأَراهُ","عادَ مُرّاً وَالسُكرُ قَبلَ الخُمارِ",28,"ر",1,0],["كَأَنَّ حَديثَ الدارِجاتِ مِنَ القَطا","تَراطِنُ أَنباطٍ تَلاقَت وَرومُها",29,"م",3,0],["كأنَّ حَصى الياقوتِ نَهْبُ أكُفِّنا","يَذوبُ عليها تارةً ويَسيلُ",30,"ل",1,0],["كأنَّ حَمامَ الرَّوضِ نَشْوَانُ كلما","ترنَّمَ في أغصانِه أو تَرَجَّحا",31,"ح",2,0],["كَأَنَّ حَيّاً وَقَد طالَت سَلامَتُهُ","قَد صارَ في سَكَراتِ المَوتِ تَغشاهُ",32,"ا",2,0],["كَأَنَّ حَيّاً قَد قامَ نادِبُهُ","وَاِلتَفَّتِ الساقُ مِنهُ بِالساقِ",33,"ق",1,0],["كَأَنَّ حَشاهُ ضَمَّ سِرّاً مُكَتَّماً","يُمَوِّهُ عَنهُ أَو حَديثاً مُجَمجَما",34,"م",2,0],["كَأَنَّ حُزنَكَ مِن أَسمائِهِ سَقَرٌ","فَذاكَ في القَلبِ لا يُبقي وَلا يَذَرُ",35,"ر",1,0],["كَأَنَّ حِبالَ الساحِرينَ نُفوسُنا","وَتِلكَ عَصا موسى لَها تَتَلَقَّفُ",36,"ف",1,0],["كأنّ حروفَ اللينِ كانتْ رؤوسهُمْ","فلاقَيْنِ حَذْفاً من وقوع الجوازمِ",37,"م",1,0],["كأنّ حصاةَ القلب كانت زجاجةً","مقارعةً من لاعجِ الشوق صادعا",38,"ع",2,0],["كأنّ حُداءَ العيس في السير نعيها","وقد سُقِيَتْ سمّاً من البين ناقعا",38,"ع",2,0],["كَأَنَّ حَبِيّاً ساكباً فيضَ ودقهِ","وقَد يَحْتبي منه لقُصّادِهِ البدرُ",39,"ر",1,0],["كأنّ حَشْوَ جفوني عند سَوْرَتِهِ","جيشٌ منَ النَّملِ في جُنحِ الدُّجى ساري",40,"ي",1,0],["كَأَنَّ حُبَاباً ريعَ تَحتَ حَبَابِهِ","فَأَقبَلَ يُلْقي نَفسَهُ في غَديرِهِ",41,"ر",2,0],["كَأَنَّ حَواشيهِ العُلى وَخُصورَهُ","وَما اِنحَطَّ مِنهُ جَمرَةٌ تَتَلَهَّبُ",42,"ب",1,0],["كأنّ حِمارَ الحصنِ أُوتِيَ رُشدَهُ","فأجمعَ ألا يصحبَ الدَّهرَ غاويا",43,"ي",2,0],["كَأَنَّ حَياهُ الجَودَ وَالنَبتَ وَالثَرى","بَنانُ أَبي بَكرٍ وَخَطٌّ وَمَهرِقُ",44,"ق",1,0],["كأنَّ حلوَ الأَماني","والوصلِ لم تكُ شياً",45,"ي",2,0],["كَأَنَّ حُطامَ قَيضِ الصَيفِ فيهِ","فَراشُ صَميمِ أَقحافِ الشُؤونِ",46,"ن",1,0],["كَأَنَّ حُمُولَهُمُ إِذ غَدَوا","نَخيلٌ عَلى نُهُرٍ دُلَّحُ",47,"ح",1,0],["كَأَنَّ حاطِبَةً كانَت تُحَطِّبُ في","قَلبي قَتاداً وَتَكويهِ بِنيرانِ",48,"ن",1,0],["كأنَّ حديثَه زَهْرٌ نَضِيرٌ","وَحاملَ زَهْرِهِ غُصْنٌ رَطيبُ",49,"ب",1,0],["كأنّ حُماةَ الرَّجْلِ تحتَ ركابِهِ","سُيولُ نَداهُ أقبَلتْ تتدفّع",50,"ع",1,0],["كأنّ حَبابَها خَرَزَاتُ دُرٍّ","عَلَتْ ذَهَباً بأقْداحِ النُّضَارِ",51,"ر",1,0],["كأنّ حلمك أرسى الأرض أو عقدت","بهِ نَواصي ذُرَى أعْلامِها القُودِ",52,"د",1,0],["كانَ حُلماً ما كُنتُ آمَلُ فيكُم","وَقَليلاً ما تَصدُقُ الأَحلامُ",53,"م",1,1],["كَأَنَّ حُمولَهُم لَقَحاتُ وادٍ","مِنَ الجَبّارِ طابَ بِها الثِمارُ",54,"ر",1,0],["كَأَنَّ حُبَّكِ فَوقي حينَ أَكتُمُهُ","وَتَحتَ رِجلَيَّ لُجٌّ فَوقَهُ لُجَجُ",55,"ج",1,0],["كَأَنَّ حَياةَ الناسِ حينَ ضَمِنتَها","قَذىً في حُقوقِ العَينِ مِنّي أُوارِبُه",56,"ب",2,0],["كَأَنَّ حَوّاءَ الَّتي زَوجُها","آدَمُ لَم تَلقَح بِشَخصٍ أَريب",57,"ب",1,0],["كَأَنَّ حَياةَ الفَتى لَيلَةٌ","يُرَجّي أَخو اللُبِّ إِسفارَها",58,"ر",3,0],["كَأَنَّ حَوادِثَ الأَيّامِ آمٌ","تُريقُ بِجَهلِها ما أَدهَقَتهُ",59,"ت",2,0],["كأنّ حَبابَ الكأسِ وَهْيَ حَبيبةٌ","إلى الشَّرْبِ ما يَنفي الحُبابُ من السّمِّ",60,"م",1,0],["كَأَنَّ حُدوجَ المالِكيَّةِ غُدوَةً","خَلايا سَفينٍ بِالنَواصِفِ مِن دَدِ",61,"د",1,0],["كَأَنَّ حَوافِرَهُ مُدبِراً","خُضبِنَ وَإِن كانَ لَم يُخضَبِ",62,"ب",1,0],["كَأَنَّ حِجاجَ مُقلَتِها قَليبٌ","مِنَ السَقبَينِ يُخلِفُ مُستَقاها",63,"ا",3,1],["كأنَّ حَمامَةً بَيْضَاءَ ظَلَّتْ","تُقَابِلُ في مَفَارِقِهِ غُرَابا",64,"ب",2,0],["كأَنَّ حَياتي حين أَبصر لونها","سراب بِبَيداءٍ بدا يتلعلع",65,"ع",1,0],["كأن حوريةً في ظلّ شاهقةٍ","من البروج تقضّي العيشَ في خلس",66,"س",1,0],["كان حديثُ القَدرِ المبهَم","مثارَ هذا الخاطر المفزعِ",67,"ع",1,0],["كأن حسان ذا شعبين كنت له","وقاية في زمان القحط والوبأ",68,"ا",1,0],["كأن حراماً أن تفارق صارماً","يكون لما أضمرت أول فاعل",69,"ل",1,0],["كأنّ حديثاً حاضِراً وَجْهُ غائِبٍ","تَلَقّاهُ بالإكْبارِ مَنْ لم يُوَدّع",70,"ع",1,0],["كأَنَّ حَمامَ الأيكِ حينَ تَجاوبَتْ","حزينٌ بكى من رحمةٍ لحزينِ",71,"ن",1,0],["كَانَ حَرَاماً كَسْرُهَا وَهْيَ لَمْ","تَحْمِلُ مِنْ القَهْوَةِ إِلاَّ الحَلاَلِ",72,"ل",1,0],["كَأَنَّ حِجَاكَ مِنْهُ