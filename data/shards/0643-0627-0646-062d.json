l","الوافر"],[341,"لمن طلل عاف ورسم منازل","https://www.aldiwan.net/poem45427.html","الطويل"],[341,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[365,"قال لي قائل رأيتك تهوى","https://www.aldiwan.net/poem68059.html","الخفيف"],[373,"روض الهوى مرتع وخيم","https://www.aldiwan.net/poem4324.html","مخلع البسيط"],[375,"يا ابن النبي النداء من كبد","https://www.aldiwan.net/poem57072.html","المنسرح"],[384,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[410,"أذهبت رونق ماء النصح في العذل","https://www.aldiwan.net/poem50137.html","البسيط"],[413,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[413,"قد مرنت قلوبنا على النوى","https://www.aldiwan.net/poem32487.html","عموديه"],[420,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[420,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[420,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[427,"حن إلى كأسه الخليع","https://www.aldiwan.net/poem4107.html","مخلع البسيط"],[445,"قفوا أيها الركبان نودعكم منا","https://www.aldiwan.net/poem14339.html","الطويل"],[445,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[456,"تنادينا بنكهتها فهيا","https://www.aldiwan.net/poem61298.html","الوافر"],[456,"وفائي للصديق أبي علي","https://www.aldiwan.net/poem61305.html","الوافر"],[461,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[461,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[464,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[464,"وبالكوفة الفيحاء فارس بهمة","https://www.aldiwan.net/poem15346.html","الطويل"],[464,"أظل مريضا بالصدى دون وردكم","https://www.aldiwan.net/poem15923.html","الطويل"],[467,"كأن حديثه خلس التشاكي","https://www.aldiwan.net/poem3406.html","عموديه"],[468,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[469,"قل للبوادر والأحلاف ما لكم","https://www.aldiwan.net/poem50470.html","البسيط"],[480,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[554,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[554,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[556,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[569,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21444","الطويل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[1124,"","https://poetry.dctabudhabi.ae/diwan/poem/60","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/200368","البسيط"]],"verses":[["كأن حصاته للنار زندٌ","أطارت سقطه عيني انتحابا",0,"ب",2,0],["كَأَنَّ حِماكُم خِطَّةُ الخَسفِ لِلفَتى","إِذا سيمَها الحُرُّ الكَريمُ أَباها",1,"ا",3,0],["كَأَنَّ حِدادَ اللَيلِ زادَ سَوادَهُ","عَليكَ وَرَدَّ الضَوءَ مِن مَطلَعِ الشَمسِ",2,"س",1,0],["كَأَنَّ حَوافِرَها وَالصُخورَ","إِذا ما ذَرَعنَ الدُجى في صَخَب",3,"ب",1,0],["كأنّ حُداةَ الرّعْدِ ضلّتْ طريقَها","فهزّتْ لكَيْما تهْتَدي مِشْعَلَ البرْقِ",4,"ق",1,0],["كَانَ حُلْماً فَوَيْحَ مَنْ أَمَّلَ الدَّهْ","رَ وَأَعْمَاهُ جَهْلُهُ وَأَصَمَّه",5,"م",2,0],["كَأَنَّ حُدوجَ المالِكِيَّةِ غُدوَةً","نَواعِمُ يَجري الماءُ رَفهاً خِلالَها",6,"ل",3,0],["كانَ حُرَّ الآراءِ لا يَعرِفُ الخَت","لَ وَلا يَستَبيحُ غَيبَ الصِحابِ",7,"ب",1,0],["كَأَنَّ حُمولَهُم لَمّا تَوَلَّت","بِيَليَلَ وَالنَوى ذاتُ اِنفِتالِ",8,"ل",1,0],["كَأَنَّ حُمولَ الحَيِّ حينَ تَحَمَّلوا","صَريمَةُ نَخلٍ أَو صَريمَةُ إيدَعِ",9,"ع",1,0],["كَأَنَّ حُمولَها بِمَلا تَريمٍ","سَفينٌ بِالشُعَيبَةِ ما تَسيرُ",10,"ر",1,0],["كأَنَّ حَدائِجَ أَظعانِها","بِغَيقَةِ لَمّا هَبَطنَ البِراثا",11,"ث",2,0],["كَانَ حَقَّ الزَّمَانِ إِعْطَاءَكَ الآلافِ","لا الأَخْذِ مِنْكَ شَلَّ يَمِينَا",12,"ن",2,0],["كَأَنَّ حُبابَي رَملَةٍ حَبَوا لَها","بِحَيثُ اِستَقَرَّت مِن مُناخٍ وَمُرسَلِ",13,"ل",1,0],["كَأَنَّ حِجالَهُنَّ أَوَت إِلَيها","ظِبآءُ الرَملِ باشَرنَ المَغارا",14,"ر",2,0],["كَأَنَّ حِرباءَها في كُلِّ هاجِرَةٍ","ذو شَيَبة مِن رِجالِ الهِندِ مَصلوبُ",15,"ب",1,0],["كان حبل الإخاء فيكم وثيقاً","كيف أمسى وعَقده محلول",16,"ل",1,0],["كَأَنَّ حادِيَها لَمّا أَضَرَّ بِها","بازٍ يُصَعصِعُ بِالسَهبا قَطاً جونا",17,"ن",2,0],["كَأَنَّ حُداتَنا الزَجلينَ هاجوا","بِخَبتٍ أَو سَماوَتِهِ نَعاما",18,"م",2,0],["كأن حديثهن غريض مزن","بما تقرِي المخصرَّة اللسوبُ",19,"ب",1,1],["كأن حصى المعزاء بين فروجها","نوى الرضخ يلقى المصعدُ المتصوِبُ",20,"ب",1,1],["كأنَّ حُسَيناً والبَهَالِيلَ حَولَه","لأَسيَافِهِم ما يَختَلِي المُتَبقِّلُ",21,"ل",1,0],["كأنَّ حديثه في كلِّ نادٍ","حديث النار عن نفسِ العبير",22,"ر",1,0],["كأنّ حلاوة إحضاره","حلاوة يوم خميس العدس",23,"س",1,0],["كأن حَب سقيطِ الطل بينهما","دمعٌ تحير في أجفان مهجور",24,"ر",1,0],["كان حياة صفت بعافية","هيهات منها ملال ذائقها",25,"ق",3,0],["كَأَنَّ حيرانَها في كُلِّ مَنزِلَةٍ","قَتلى مُجَرَّدَةُ الأَوصالِ تُستَلَبُ",26,"ب",1,0],["كَأَنَّ حُبوبُها خُضرا وَصُفراً","فُصوصَ زُمُرُّد وَشُذورَ تِبرِ",27,"ر",1,0],["كَأَنَّ حَفيفَ النَبلِ مِن فَوقِ عَجزِها","غَوارِبُ نَحلٍ أَخطَأَ الغارَ مُطنِفُ",28,"ف",1,0],["كانَ حُلواً هَذا الهَوى فَأَراهُ","عادَ مُرّاً وَالسُكرُ قَبلَ الخُمارِ",29,"ر",1,0],["كَأَنَّ حَديثَ الدارِجاتِ مِنَ القَطا","تَراطِنُ أَنباطٍ تَلاقَت وَرومُها",30,"م",3,0],["كأنَّ حَصى الياقوتِ نَهْبُ أكُفِّنا","يَذوبُ عليها تارةً ويَسيلُ",31,"ل",1,0],["كأنَّ حَمامَ الرَّوضِ نَشْوَانُ كلما","ترنَّمَ في أغصانِه أو تَرَجَّحا",32,"ح",2,0],["كَأَنَّ حَيّاً وَقَد طالَت سَلامَتُهُ","قَد صارَ في سَكَراتِ المَوتِ تَغشاهُ",33,"ا",2,0],["كَأَنَّ حَيّاً قَد قامَ نادِبُهُ","وَاِلتَفَّتِ الساقُ مِنهُ بِالساقِ",34,"ق",1,0],["كَأَنَّ حَشاهُ ضَمَّ سِرّاً مُكَتَّماً","يُمَوِّهُ عَنهُ أَو حَديثاً مُجَمجَما",35,"م",2,0],["كَأَنَّ حُزنَكَ مِن أَسمائِهِ سَقَرٌ","فَذاكَ في القَلبِ لا يُبقي وَلا يَذَرُ",36,"ر",1,0],["كَأَنَّ حِبالَ الساحِرينَ نُفوسُنا","وَتِلكَ عَصا موسى لَها تَتَلَقَّفُ",37,"ف",1,0],["كأنّ حروفَ اللينِ كانتْ رؤوسهُمْ","فلاقَيْنِ حَذْفاً من وقوع الجوازمِ",38,"م",1,0],["كأنّ حصاةَ القلب كانت زجاجةً","مقارعةً من لاعجِ الشوق صادعا",39,"ع",2,0],["كأنّ حُداءَ العيس في السير نعيها","وقد سُقِيَتْ سمّاً من البين ناقعا",39,"ع",2,0],["كَأَنَّ حَبِيّاً ساكباً فيضَ ودقهِ","وقَد يَحْتبي منه لقُصّادِهِ البدرُ",40,"ر",1,0],["كأنّ حَشْوَ جفوني عند سَوْرَتِهِ","جيشٌ منَ النَّملِ في جُنحِ الدُّجى ساري",41,"ر",2,0],["كَأَنَّ حُبَاباً ريعَ تَحتَ حَبَابِهِ","فَأَقبَلَ يُلْقي نَفسَهُ في غَديرِهِ",42,"ر",2,0],["كَأَنَّ حَواشيهِ العُلى وَخُصورَهُ","وَما اِنحَطَّ مِنهُ جَمرَةٌ تَتَلَهَّبُ",43,"ب",1,0],["كأنّ حِمارَ الحصنِ أُوتِيَ رُشدَهُ","فأجمعَ ألا يصحبَ الدَّهرَ غاويا",44,"ي",2,0],["كَأَنَّ حَياهُ الجَودَ وَالنَبتَ وَالثَرى","بَنانُ أَبي بَكرٍ وَخَطٌّ وَمَهرِقُ",45,"ق",1,0],["كأنَّ حلوَ الأَماني","والوصلِ لم تكُ شياً",46,"ي",2,0],["كَأَنَّ حُطامَ قَيضِ الصَيفِ فيهِ","فَراشُ صَميمِ أَقحافِ الشُؤونِ",47,"ن",1,0],["كَأَنَّ حُمُولَهُمُ إِذ غَدَوا","نَخيلٌ عَلى نُهُرٍ دُلَّحُ",48,"ح",1,0],["كَأَنَّ حاطِبَةً كانَت تُحَطِّبُ في","قَلبي قَتاداً وَتَكويهِ بِنيرانِ",49,"ن",1,0],["كأنَّ حديثَه زَهْرٌ نَضِيرٌ","وَحاملَ زَهْرِهِ غُصْنٌ رَطيبُ",50,"ب",1,0],["كأنّ حُماةَ الرَّجْلِ تحتَ ركابِهِ","سُيولُ نَداهُ أقبَلتْ تتدفّع",51,"ع",1,0],["كأنّ حَبابَها خَرَزَاتُ دُرٍّ","عَلَتْ ذَهَباً بأقْداحِ النُّضَارِ",52,"ر",1,0],["كأنّ حلمك أرسى الأرض أو عقدت","بهِ نَواصي ذُرَى أعْلامِها القُودِ",53,"د",1,0],["كانَ حُلماً ما كُنتُ آمَلُ فيكُم","وَقَليلاً ما تَصدُقُ الأَحلامُ",54,"م",1,1],["كَأَنَّ حُمولَهُم لَقَحاتُ وادٍ","مِنَ الجَبّارِ طابَ بِها الثِمارُ",55,"ر",1,0],["كَأَنَّ حُبَّكِ فَوقي حينَ أَكتُمُهُ","وَتَحتَ رِجلَيَّ لُجٌّ فَوقَهُ لُجَجُ",56,"ج",1,0],["كَأَنَّ حَياةَ الناسِ حينَ ضَمِنتَها","قَذىً في حُقوقِ العَينِ مِنّي أُوارِبُه",57,"ب",2,0],["كَأَنَّ حَوّاءَ الَّتي زَوجُها","آدَمُ لَم تَلقَح بِشَخصٍ أَريب",58,"ب",1,0],["كَأَنَّ حَياةَ الفَتى لَيلَةٌ","يُرَجّي أَخو اللُبِّ إِسفارَها",59,"ر",3,0],["كَأَنَّ حَوادِثَ الأَيّامِ آمٌ","تُريقُ بِجَهلِها ما أَدهَقَتهُ",60,"ت",2,0],["كأنّ حَبابَ الكأسِ وَهْيَ حَبيبةٌ","إلى الشَّرْبِ ما يَنفي الحُبابُ من السّمِّ",61,"م",1,0],["كَأَنَّ حُدوجَ المالِكيَّةِ غُدوَةً","خَلايا سَفينٍ بِالنَواصِفِ مِن دَدِ",62,"د",1,0],["كَأَنَّ حَوافِرَهُ مُدبِراً","خُضبِنَ وَإِن كانَ لَم يُخضَبِ",63,"ب",1,0],["كَأَنَّ حِجاجَ مُقلَتِها قَليبٌ","مِنَ السَقبَينِ يُخلِفُ مُستَقاها",64,"ا",3,1],["كأنَّ حَمامَةً بَيْضَاءَ ظَلَّتْ","تُقَابِلُ في مَفَارِقِهِ غُرَابا",65,"ب",2,0],["كأَنَّ حَياتي حين أَبصر لونها","سراب بِبَيداءٍ بدا يتلعلع",66,"ع",1,0],["كَأَنَّ حِبَالَ الرَّحْلِ مِنْهَا تَوَشَّحَتْ","سَرَاةَ لَيَاحٍ أَكْلَفِ الوَجْهِ أَكْحَلاَ",67,"ل",2,0],["كَأَنَّ حَنَاتِمِ حَارِيَةٍ","جَمَاجِمُهَا إِذْ مَسِسْنَ ابْتِلاَلاَ",68,"ل",2,0],["كأن حوريةً في ظلّ شاهقةٍ","من البروج تقضّي العيشَ في خلس",69,"س",1,0],["كان حديثُ القَدرِ المبهَم","مثارَ هذا الخاطر المفزعِ",70,"ع",1,0],["كأن حسان ذا شعبين كنت له","وقاية في زمان القحط والوبأ",71,"ا",1,0],["كأن حراماً أن تفارق صارماً","يكون لما أضمرت أول فاعل",72,"ل",1,0],["كأنّ حديثاً حاضِراً وَجْهُ غائِبٍ","تَلَقّاهُ بالإكْبارِ مَنْ لم يُوَدّع",73,"ع",1,0],["كأَنَّ حَمامَ الأيكِ حينَ تَجاوبَتْ","حزينٌ بكى من رحمةٍ لحزينِ",74,"ن",1,0],["كَانَ حَرَاماً كَسْرُهَا وَهْيَ لَمْ","تَحْمِلُ مِنْ القَهْوَةِ إِلاَّ الحَلاَلِ",75,"ل",1,0],["كَأَنَّ حِجَاكَ مِنْهُ وَرَا","ءَ شَفَّافٍ مِنَ السِّتْرِ",76,"ر",1,0],["كَأَنَّ حُسْنَكَ هَذَا وَهْوَ رَائِعُنَا","حُسْنٌ لِبِكْرٍ مِنَ الأَقْمَارِ مَوْلُودِ",77,"د",1,0],["كَانَ حُرَّ الرَّأْيِ لاَ يَطْرِفُهُ","رَغَبٌ عَمَّا رَآهُ أَوْ رَهَبْ",78,"ب",1,0],["كانَ حَلَيَّ الأَيّامِ ثُمَّ تَوَلّى","فَمَعاطيل بَعدَهُ الأَيّامُ",79,"م",1,0],["كَأَنّ حَماماتِ الأَراكِ تَرَنَّمَت","عَلى نَشَواتي وَالشُؤونُ دِناني",80,"ن",2,0],["كَأَنَّ حُزونَ الأَرضِ حينَ يَطَأنَهُ","سُهولٌ وَما يُصعِدنَ فيهِ صَبوبُ",81,"ب",1,0],["كأنَّ حِبالَ الشمسِ كِفّةُ حابِلٍ","تُحيطُ بنا من شمأَلٍ وجَنوب",82,"ب",1,0],["كأنّ حَفيفَه نَضْراً وريقاً","بسمعي حَلْيُ غانيةِ يصِلُ",83,"ل",1,0],["كأن حلة حرباء تلونها","لا تظهر الشكل الا ريث ينتقل",84,"ل",1,0],["كأن حياتهم لما تقضت","خيال طاف في نوم العيون",85,"ن",1,0],["كأن حداة الرعد ظلت طريقه","فهزت لكيما تهتدي مشعل البرق",86,"