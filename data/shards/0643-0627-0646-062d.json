{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"بقاء الفتى مستأنف من فنائه","https://www.aldiwan.net/poem30187.html","الطويل"],[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[77,"صاح ما أعطر القبول بنمه","https://www.aldiwan.net/poem36081.html","الخفيف"],[9,"أتصرم ريا أم تديم وصالها","https://www.aldiwan.net/poem21968.html","الطويل"],[86,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[35,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[35,"خليلي عوجا منكما ساعة معي","https://www.aldiwan.net/poem39134.html","الطويل"],[35,"سأتك وقد أجد بها البكور","https://www.aldiwan.net/poem39147.html","الوافر"],[35,"حبال سجيفة أمست رثاثا","https://www.aldiwan.net/poem39175.html","المتقارب"],[93,"روعتني ذكرى الخسارة لما","https://www.aldiwan.net/poem11229.html","الخفيف"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[30,"أمنكر أنت ربع الدار عن عفر","https://www.aldiwan.net/poem29614.html","البسيط"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[27,"أمسى فؤادك عند الحي مرهونا","https://www.aldiwan.net/poem4439.html","البسيط"],[27,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[37,"كأن حديثهن غريض مزن","https://www.aldiwan.net/poem6431.html","الوافر"],[37,"كأن حصى المعزاء بين فروجها","https://www.aldiwan.net/poem6454.html","البسيط"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"كتاب مع المطل أحضرته","https://www.aldiwan.net/poem19028.html","المتقارب"],[51,"وزعفرانية في اللون تحسبها","https://www.aldiwan.net/poem64089.html","البسيط"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[29,"أقفرت البلخ من عيلان فالرحب","https://www.aldiwan.net/poem6028.html","البسيط"],[91,"شربناها على سر القوافي","https://www.aldiwan.net/poem8849.html","عموديه"],[12,"ومرقبة عنقاء يقصر دونها","https://www.aldiwan.net/poem1216.html",""],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[28,"ومطروفة العينين قد قدت للصبا","https://www.aldiwan.net/poem5565.html","الطويل"],[61,"لنا مجلس لو لم تغب عنه كامل","https://www.aldiwan.net/poem51481.html","الطويل"],[61,"أعاد الحيا سكر النبات وقد صحا","https://www.aldiwan.net/poem51735.html","الطويل"],[49,"الدهر ذو دول والموت ذو علل","https://www.aldiwan.net/poem63190.html","البسيط"],[49,"لو أن عبدا له خزائن ما","https://www.aldiwan.net/poem64253.html","المنسرح"],[66,"شجى وشفى لما شدا وترنما","https://www.aldiwan.net/poem39510.html","الطويل"],[66,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[66,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[80,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[80,"أشكو إلى الله ما قاسيت من رمد","https://www.aldiwan.net/poem31451.html","البسيط"],[80,"ومطرد الأجزاء يصقل متنه","https://www.aldiwan.net/poem31461.html","الطويل"],[44,"دنا سفر والدار تنئي وتصقب","https://www.aldiwan.net/poem30573.html","الطويل"],[105,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[81,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[102,"هواك أصبح نسيا","https://www.aldiwan.net/poem32994.html","المجتث"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[40,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[52,"هل من معين على أحداث أزماني","https://www.aldiwan.net/poem26625.html","البسيط"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[75,"وليل بت أسقاها سلافا","https://www.aldiwan.net/poem69074.html","الوافر"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[48,"كان حلما ما كنت آمل فيكم","https://www.aldiwan.net/poem65229.html","الخفيف"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[50,"وللموت خير من حياة على أذى","https://www.aldiwan.net/poem64792.html","الطويل"],[46,"ما أجلي في أجلى حاضر","https://www.aldiwan.net/poem22375.html","السريع"],[46,"أتدري النجوم بما عندنا","https://www.aldiwan.net/poem22641.html","المتقارب"],[46,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[8,"كأن حجاج مقلتها قليب","https://www.aldiwan.net/poem21852.html","الوافر"],[76,"أصمم في الغواية أم أنابا","https://www.aldiwan.net/poem39498.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147452","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39497","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55184","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/7658","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[77,"نديمي عللني بمشمولة واسق","https://www.poetsgate.com/ViewPoem.aspx?id=34194",""],[45,"أبُكَاءً في الدّارِ، بَعْدَ الدّارِ","https://www.poetsgate.com/ViewPoem.aspx?id=31284",""],[46,"تحية كسرى في السناء وتبع","https://www.poetsgate.com/ViewPoem.aspx?id=74894",""],[77,"نديمي عللني بمشمولة واسق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54812&r=&rc=334",""],[88,"كأن حياتنا جبل مُطِل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19567&r=&rc=70",""]],"verses":[["كَأَنَّ حِماكُم خِطَّةُ الخَسفِ لِلفَتى","إِذا سيمَها الحُرُّ الكَريمُ أَباها",0,"ا",3,0],["كَأَنَّ حِدادَ اللَيلِ زادَ سَوادَهُ","عَليكَ وَرَدَّ الضَوءَ مِن مَطلَعِ الشَمسِ",1,"س",1,0],["كَأَنَّ حَوافِرَها وَالصُخورَ","إِذا ما ذَرَعنَ الدُجى في صَخَب",2,"ب",1,0],["كأنّ حُداةَ الرّعْدِ ضلّتْ طريقَها","فهزّتْ لكَيْما تهْتَدي مِشْعَلَ البرْقِ",3,"ق",1,0],["كَانَ حُلْماً فَوَيْحَ مَنْ أَمَّلَ الدَّهْ","رَ وَأَعْمَاهُ جَهْلُهُ وَأَصَمَّه",4,"م",2,0],["كَأَنَّ حُدوجَ المالِكِيَّةِ غُدوَةً","نَواعِمُ يَجري الماءُ رَفهاً خِلالَها",5,"ل",3,0],["كانَ حُرَّ الآراءِ لا يَعرِفُ الخَت","لَ وَلا يَستَبيحُ غَيبَ الصِحابِ",6,"ب",1,0],["كَأَنَّ حُمولَهُم لَمّا تَوَلَّت","بِيَليَلَ وَالنَوى ذاتُ اِنفِتالِ",7,"ل",1,0],["كَأَنَّ حُمولَ الحَيِّ حينَ تَحَمَّلوا","صَريمَةُ نَخلٍ أَو صَريمَةُ إيدَعِ",8,"ع",1,0],["كَأَنَّ حُمولَها بِمَلا تَريمٍ","سَفينٌ بِالشُعَيبَةِ ما تَسيرُ",9,"ر",1,0],["كأَنَّ حَدائِجَ أَظعانِها","بِغَيقَةِ لَمّا هَبَطنَ البِراثا",10,"ث",2,0],["كَانَ حَقَّ الزَّمَانِ إِعْطَاءَكَ الآلافِ","لا الأَخْذِ مِنْكَ شَلَّ يَمِينَا",11,"ن",2,0],["كَأَنَّ حُبابَي رَملَةٍ حَبَوا لَها","بِحَيثُ اِستَقَرَّت مِن مُناخٍ وَمُرسَلِ",12,"ل",1,0],["كَأَنَّ حِجالَهُنَّ أَوَت إِلَيها","ظِبآءُ الرَملِ باشَرنَ المَغارا",13,"ر",2,0],["كَأَنَّ حِرباءَها في كُلِّ هاجِرَةٍ","ذو شَيَبة مِن رِجالِ الهِندِ مَصلوبُ",14,"ب",1,0],["كان حبل الإخاء فيكم وثيقاً","كيف أمسى وعَقده محلول",15,"ل",1,0],["كَأَنَّ حادِيَها لَمّا أَضَرَّ بِها","بازٍ يُصَعصِعُ بِالسَهبا قَطاً جونا",16,"ن",2,0],["كَأَنَّ حُداتَنا الزَجلينَ هاجوا","بِخَبتٍ أَو سَماوَتِهِ نَعاما",17,"م",2,0],["كأن حديثهن غريض مزن","بما تقرِي المخصرَّة اللسوبُ",18,"ب",1,1],["كأن حصى المعزاء بين فروجها","نوى الرضخ يلقى المصعدُ المتصوِبُ",19,"ب",1,1],["كأنَّ حُسَيناً والبَهَالِيلَ حَولَه","لأَسيَافِهِم ما يَختَلِي المُتَبقِّلُ",20,"ل",1,0],["كأنَّ حديثه في كلِّ نادٍ","حديث النار عن نفسِ العبير",21,"ر",1,0],["كأنّ حلاوة إحضاره","حلاوة يوم خميس العدس",22,"س",1,0],["كأن حَب سقيطِ الطل بينهما","دمعٌ تحير في أجفان مهجور",23,"ر",1,0],["كان حياة صفت بعافية","هيهات منها ملال ذائقها",24,"ق",3,0],["كَأَنَّ حيرانَها في كُلِّ مَنزِلَةٍ","قَتلى مُجَرَّدَةُ الأَوصالِ تُستَلَبُ",25,"ب",1,0],["كَأَنَّ حُبوبُها خُضرا وَصُفراً","فُصوصَ زُمُرُّد وَشُذورَ تِبرِ",26,"ر",1,0],["كَأَنَّ حَفيفَ النَبلِ مِن فَوقِ عَجزِها","غَوارِبُ نَحلٍ أَخطَأَ الغارَ مُطنِفُ",27,"ف",1,0],["كانَ حُلواً هَذا الهَوى فَأَراهُ","عادَ مُرّاً وَالسُكرُ قَبلَ الخُمارِ",28,"ر",1,0],["كَأَنَّ حَديثَ الدارِجاتِ مِنَ القَطا","تَراطِنُ أَنباطٍ تَلاقَت وَرومُها",29,"م",3,0],["كأنَّ حَصى الياقوتِ نَهْبُ أكُفِّنا","يَذوبُ عليها تارةً ويَسيلُ",30,"ل",1,0],["كأنَّ حَمامَ الرَّوضِ نَشْوَانُ كلما","ترنَّمَ في أغصانِه أو تَرَجَّحا",31,"ح",2,0],["كَأَنَّ حَيّاً وَقَد طالَت سَلامَتُهُ","قَد صارَ في سَكَراتِ المَوتِ تَغشاهُ",32,"ا",2,0],["كَأَنَّ حَيّاً قَد قامَ نادِبُهُ","وَاِلتَفَّتِ الساقُ مِنهُ بِالساقِ",33,"ق",1,0],["كَأَنَّ حَشاهُ ضَمَّ سِرّاً مُكَتَّماً","يُمَوِّهُ عَنهُ أَو حَديثاً مُجَمجَما",34,"م",2,0],["كَأَنَّ حُزنَكَ مِن أَسمائِهِ سَقَرٌ","فَذاكَ في القَلبِ لا يُبقي وَلا يَذَرُ",35,"ر",1,0],["كَأَنَّ حِبالَ الساحِرينَ نُفوسُنا","وَتِلكَ عَصا موسى لَها تَتَلَقَّفُ",36,"ف",1,0],["كأنّ حروفَ اللينِ كانتْ رؤوسهُمْ","فلاقَيْنِ حَذْفاً من وقوع الجوازمِ",37,"م",1,0],["كأنّ حصاةَ القلب كانت زجاجةً","مقارعةً من لاعجِ الشوق صادعا",38,"ع",2,0],["كأنّ حُداءَ العيس في السير نعيها","وقد سُقِيَتْ سمّاً من البين ناقعا",38,"ع",2,0],["كَأَنَّ حَبِيّاً ساكباً فيضَ ودقهِ","وقَد يَحْتبي منه لقُصّادِهِ البدرُ",39,"ر",1,0],["كأنّ حَشْوَ جفوني عند سَوْرَتِهِ","جيشٌ منَ النَّملِ في جُنحِ الدُّجى ساري",40,"ي",1,0],["كَأَنَّ حُبَاباً ريعَ تَحتَ حَبَابِهِ","فَأَقبَلَ يُلْقي نَفسَهُ في غَديرِهِ",41,"ر",2,0],["كَأَنَّ حَواشيهِ العُلى وَخُصورَهُ","وَما اِنحَطَّ مِنهُ جَمرَةٌ تَتَلَهَّبُ",42,"ب",1,0],["كأنّ حِمارَ الحصنِ أُوتِيَ رُشدَهُ","فأجمعَ ألا يصحبَ الدَّهرَ غاويا",43,"ي",2,0],["كَأَنَّ حَياهُ الجَودَ وَالنَبتَ وَالثَرى","بَنانُ أَبي بَكرٍ وَخَطٌّ وَمَهرِقُ",44,"ق",1,0],["كأنَّ حلوَ الأَماني","والوصلِ لم تكُ شياً",45,"ي",2,0],["كَأَنَّ حُطامَ قَيضِ الصَيفِ فيهِ","فَراشُ صَميمِ أَقحافِ الشُؤونِ",46,"ن",1,0],["كَأَنَّ حُمُولَهُمُ إِذ غَدَوا","نَخيلٌ عَلى نُهُرٍ دُلَّحُ",47,"ح",1,0],["كَأَنَّ حاطِبَةً كانَت تُحَطِّبُ في","قَلبي قَتاداً وَتَكويهِ بِنيرانِ",48,"ن",1,0],["كأنَّ حديثَه زَهْرٌ نَضِيرٌ","وَحاملَ زَهْرِهِ غُصْنٌ رَطيبُ",49,"ب",1,0],["كأنّ حُماةَ الرَّجْلِ تحتَ ركابِهِ","سُيولُ نَداهُ أقبَلتْ تتدفّع",50,"ع",1,0],["كأنّ حَبابَها خَرَزَاتُ دُرٍّ","عَلَتْ ذَهَباً بأقْداحِ النُّضَارِ",51,"ر",1,0],["كأنّ حلمك أرسى الأرض أو عقدت","بهِ نَواصي ذُرَى أعْلامِها القُودِ",52,"د",1,0],["كانَ حُلماً ما كُنتُ آمَلُ فيكُم","وَقَليلاً ما تَصدُقُ الأَحلامُ",53,"م",1,1],["كَأَنَّ حُمولَهُم لَقَحاتُ وادٍ","مِنَ الجَبّارِ طابَ بِها الثِمارُ",54,"ر",1,0],["كَأَنَّ حُبَّكِ فَوقي حينَ أَكتُمُهُ","وَتَحتَ رِجلَيَّ لُجٌّ فَوقَهُ لُجَجُ",55,"ج",1,0],["كَأَنَّ حَياةَ الناسِ حينَ ضَمِنتَها","قَذىً في حُقوقِ العَينِ مِنّي أُوارِبُه",56,"ب",2,0],["كَأَنَّ حَوّاءَ الَّتي زَوجُها","آدَمُ لَم تَلقَح بِشَخصٍ أَريب",57,"ب",1,0],["كَأَنَّ حَياةَ الفَتى لَيلَةٌ","يُرَجّي أَخو اللُبِّ إِسفارَها",58,"ر",3,0],["كَأَنَّ حَوادِثَ الأَيّامِ آمٌ","تُريقُ بِجَهلِها ما أَدهَقَتهُ",59,"ت",2,0],["كأنّ حَبابَ الكأسِ وَهْيَ حَبيبةٌ","إلى الشَّرْب