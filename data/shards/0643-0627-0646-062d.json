 شابت خُطاه!","https://www.poetsgate.com/ViewPoem.aspx?id=207719",""],[4984,"منبع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175804",""],[5038,"كيف يغنيك القليل","https://www.poetsgate.com/ViewPoem.aspx?id=190125",""],[5072,"لنا غدنا في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=53579",""],[5111,"أنِينٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212520",""],[5135,"يا صفي الروح","https://www.poetsgate.com/ViewPoem.aspx?id=202016",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5246,"أيها الناس هل علي ملام","https://www.poetsgate.com/ViewPoem.aspx?id=187027",""],[5273,"عيد وشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=181799",""],[5273,"لقاء بنكهة الحُلْم","https://www.poetsgate.com/ViewPoem.aspx?id=198671",""],[5327,"وَطَنُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=156016",""],[5376,"الشهد بالزهر ما ان نلت أحلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188553",""],[5431,"بنت الشامِ","https://www.poetsgate.com/ViewPoem.aspx?id=183090",""],[5431,"لعمرك إنّ الحب راحٌ ومبهجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189966",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5455,"كبوة جواد","https://www.poetsgate.com/ViewPoem.aspx?id=34465",""],[5539,"سمو المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=193537",""],[5585,"كان حقي ألا أذكر غيري","https://www.poetsgate.com/ViewPoem.aspx?id=186769",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5628,"اقرعي الطبول","https://www.poetsgate.com/ViewPoem.aspx?id=178532",""],[5725,"جمعة محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177425",""],[5730,"غيرة قاتلة","https://www.poetsgate.com/ViewPoem.aspx?id=210390",""],[5768,"لِسانُ الضَّادِ فَخْرُ البلادِ !","https://www.poetsgate.com/ViewPoem.aspx?id=215276",""],[5829,"تؤرقني زكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155355",""],[5861,"إغلقِ الباب وغادر","https://www.poetsgate.com/ViewPoem.aspx?id=191351",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5910,"حيِّ قبرًا بجانبِ الآكامِ","https://www.poetsgate.com/ViewPoem.aspx?id=207124",""],[5977,"نجم أفل","https://www.poetsgate.com/ViewPoem.aspx?id=212730",""],[6045,"تحية الترحيب","https://www.poetsgate.com/ViewPoem.aspx?id=180624",""],[6056,"عبير الورد","https://www.poetsgate.com/ViewPoem.aspx?id=130354",""],[313,"كان حلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66507&r=&rc=29",""],[6177,"مديح الفصيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79433&r=&rc=22",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""],[6299,"بِكَفَّيِّ مِنْها لِلْبَغيضِ عُرَاضة ٌ وَمَرْقَبَة ٍ عَنْقَاءَ يَقْصُرُ دُونَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19688&r=&rc=13",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["كأن حصاته للنار زندٌ","أطارت سقطه عيني انتحابا",0,"ب",2,0],["كَأَنَّ حِماكُم خِطَّةُ الخَسفِ لِلفَتى","إِذا سيمَها الحُرُّ الكَريمُ أَباها",1,"ا",3,0],["كَأَنَّ حِدادَ اللَيلِ زادَ سَوادَهُ","عَليكَ وَرَدَّ الضَوءَ مِن مَطلَعِ الشَمسِ",2,"س",1,0],["كَأَنَّ حَوافِرَها وَالصُخورَ","إِذا ما ذَرَعنَ الدُجى في صَخَب",3,"ب",1,0],["كأنّ حُداةَ الرّعْدِ ضلّتْ طريقَها","فهزّتْ لكَيْما تهْتَدي مِشْعَلَ البرْقِ",4,"ق",1,0],["كَانَ حُلْماً فَوَيْحَ مَنْ أَمَّلَ الدَّهْ","رَ وَأَعْمَاهُ جَهْلُهُ وَأَصَمَّه",5,"م",2,0],["كَأَنَّ حُدوجَ المالِكِيَّةِ غُدوَةً","نَواعِمُ يَجري الماءُ رَفهاً خِلالَها",6,"ل",3,0],["كانَ حُرَّ الآراءِ لا يَعرِفُ الخَت","لَ وَلا يَستَبيحُ غَيبَ الصِحابِ",7,"ب",1,0],["كَأَنَّ حُمولَهُم لَمّا تَوَلَّت","بِيَليَلَ وَالنَوى ذاتُ اِنفِتالِ",8,"ل",1,0],["كَأَنَّ حُمولَ الحَيِّ حينَ تَحَمَّلوا","صَريمَةُ نَخلٍ أَو صَريمَةُ إيدَعِ",9,"ع",1,0],["كَأَنَّ حُمولَها بِمَلا تَريمٍ","سَفينٌ بِالشُعَيبَةِ ما تَسيرُ",10,"ر",1,0],["كأَنَّ حَدائِجَ أَظعانِها","بِغَيقَةِ لَمّا هَبَطنَ البِراثا",11,"ث",2,0],["كَانَ حَقَّ الزَّمَانِ إِعْطَاءَكَ الآلافِ","لا الأَخْذِ مِنْكَ شَلَّ يَمِينَا",12,"ن",2,0],["كَأَنَّ حُبابَي رَملَةٍ حَبَوا لَها","بِحَيثُ اِستَقَرَّت مِن مُناخٍ وَمُرسَلِ",13,"ل",1,0],["كَأَنَّ حِجالَهُنَّ أَوَت إِلَيها","ظِبآءُ الرَملِ باشَرنَ المَغارا",14,"ر",2,0],["كَأَنَّ حِرباءَها في كُلِّ هاجِرَةٍ","ذو شَيَبة مِن رِجالِ الهِندِ مَصلوبُ",15,"ب",1,0],["كان حبل الإخاء فيكم وثيقاً","كيف أمسى وعَقده محلول",16,"ل",1,0],["كَأَنَّ حادِيَها لَمّا أَضَرَّ بِها","بازٍ يُصَعصِعُ بِالسَهبا قَطاً جونا",17,"ن",2,0],["كَأَنَّ حُداتَنا الزَجلينَ هاجوا","بِخَبتٍ أَو سَماوَتِهِ نَعاما",18,"م",2,0],["كأن حديثهن غريض مزن","بما تقرِي المخصرَّة اللسوبُ",19,"ب",1,1],["كأن حصى المعزاء بين فروجها","نوى الرضخ يلقى المصعدُ المتصوِبُ",20,"ب",1,1],["كأنَّ حُسَيناً والبَهَالِيلَ حَولَه","لأَسيَافِهِم ما يَختَلِي المُتَبقِّلُ",21,"ل",1,0],["كأنَّ حديثه في كلِّ نادٍ","حديث النار عن نفسِ العبير",22,"ر",1,0],["كأنّ حلاوة إحضاره","حلاوة يوم خميس العدس",23,"س",1,0],["كأن حَب سقيطِ الطل بينهما","دمعٌ تحير في أجفان مهجور",24,"ر",1,0],["كان حياة صفت بعافية","هيهات منها ملال ذائقها",25,"ق",3,0],["كَأَنَّ حيرانَها في كُلِّ مَنزِلَةٍ","قَتلى مُجَرَّدَةُ الأَوصالِ تُستَلَبُ",26,"ب",1,0],["كَأَنَّ حُبوبُها خُضرا وَصُفراً","فُصوصَ زُمُرُّد وَشُذورَ تِبرِ",27,"ر",1,0],["كَأَنَّ حَفيفَ النَبلِ مِن فَوقِ عَجزِها","غَوارِبُ نَحلٍ أَخطَأَ الغارَ مُطنِفُ",28,"ف",1,0],["كانَ حُلواً هَذا الهَوى فَأَراهُ","عادَ مُرّاً وَالسُكرُ قَبلَ الخُمارِ",29,"ر",1,0],["كَأَنَّ حَديثَ الدارِجاتِ مِنَ القَطا","تَراطِنُ أَنباطٍ تَلاقَت وَرومُها",30,"م",3,0],["كأنَّ حَصى الياقوتِ نَهْبُ أكُفِّنا","يَذوبُ عليها تارةً ويَسيلُ",31,"ل",1,0],["كأنَّ حَمامَ الرَّوضِ نَشْوَانُ كلما","ترنَّمَ في أغصانِه أو تَرَجَّحا",32,"ح",2,0],["كَأَنَّ حَيّاً وَقَد طالَت سَلامَتُهُ","قَد صارَ في سَكَراتِ المَوتِ تَغشاهُ",33,"ا",2,0],["كَأَنَّ حَيّاً قَد قامَ نادِبُهُ","وَاِلتَفَّتِ الساقُ مِنهُ بِالساقِ",34,"ق",1,0],["كَأَنَّ حَشاهُ ضَمَّ سِرّاً مُكَتَّماً","يُمَوِّهُ عَنهُ أَو حَديثاً مُجَمجَما",35,"م",2,0],["كَأَنَّ حُزنَكَ مِن أَسمائِهِ سَقَرٌ","فَذاكَ في القَلبِ لا يُبقي وَلا يَذَرُ",36,"ر",1,0],["كَأَنَّ حِبالَ الساحِرينَ نُفوسُنا","وَتِلكَ عَصا موسى لَها تَتَلَقَّفُ",37,"ف",1,0],["كأنّ حروفَ اللينِ كانتْ رؤوسهُمْ","فلاقَيْنِ حَذْفاً من وقوع الجوازمِ",38,"م",1,0],["كأنّ حصاةَ القلب كانت زجاجةً","مقارعةً من لاعجِ الشوق صادعا",39,"ع",2,0],["كأنّ حُداءَ العيس في السير نعيها","وقد سُقِيَتْ سمّاً من البين ناقعا",39,"ع",2,0],["كَأَنَّ حَبِيّاً ساكباً فيضَ ودقهِ","وقَد يَحْتبي منه لقُصّادِهِ البدرُ",40,"ر",1,0],["كأنّ حَشْوَ جفوني عند سَوْرَتِهِ","جيشٌ منَ النَّملِ في جُنحِ الدُّجى ساري",41,"ر",2,0],["كَأَنَّ حُبَاباً ريعَ تَحتَ حَبَابِهِ","فَأَقبَلَ يُلْقي نَفسَهُ في غَديرِهِ",42,"ر",2,0],["كَأَنَّ حَواشيهِ العُلى وَخُصورَهُ","وَما اِنحَطَّ مِنهُ جَمرَةٌ تَتَلَهَّبُ",43,"ب",1,0],["كأنّ حِمارَ الحصنِ أُوتِيَ رُشدَهُ","فأجمعَ ألا يصحبَ الدَّهرَ غاويا",44,"ي",2,0],["كَأَنَّ حَياهُ الجَودَ وَالنَبتَ وَالثَرى","بَنانُ أَبي بَكرٍ وَخَطٌّ وَمَهرِقُ",45,"ق",1,0],["كأنَّ حلوَ الأَماني","والوصلِ لم تكُ شياً",46,"ي",2,0],["كَأَنَّ حُطامَ قَيضِ الصَيفِ فيهِ","فَراشُ صَميمِ أَقحافِ الشُؤونِ",47,"ن",1,0],["كَأَنَّ حُمُولَهُمُ إِذ غَدَوا","نَخيلٌ عَلى نُهُرٍ دُلَّحُ",48,"ح",1,0],["كَأَنَّ حاطِبَةً كانَت تُحَطِّبُ في","قَلبي قَتاداً وَتَكويهِ بِنيرانِ",49,"ن",1,0],["كأنَّ حديثَه زَهْرٌ نَضِيرٌ","وَحاملَ زَهْرِهِ غُصْنٌ رَطيبُ",50,"ب",1,0],["كأنّ حُماةَ الرَّجْلِ تحتَ ركابِهِ","سُيولُ نَداهُ أقبَلتْ تتدفّع",51,"ع",1,0],["كأنّ حَبابَها خَرَزَاتُ دُرٍّ","عَلَتْ ذَهَباً بأقْداحِ النُّضَارِ",52,"ر",1,0],["كأنّ حلمك أرسى الأرض أو عقدت","بهِ نَواصي ذُرَى أعْلامِها القُودِ",53,"د",1,0],["كانَ حُلماً ما كُنتُ آمَلُ فيكُم","وَقَليلاً ما تَصدُقُ الأَحلامُ",54,"م",1,1],["كَأَنَّ حُمولَهُم لَقَحاتُ وادٍ","مِنَ الجَبّارِ طابَ بِها الثِمارُ",55,"ر",1,0],["كَأَنَّ حُبَّكِ فَوقي حينَ أَكتُمُهُ","وَتَحتَ رِجلَيَّ لُجٌّ فَوقَهُ لُجَجُ",56,"ج",1,0],["كَأَنَّ حَياةَ الناسِ حينَ ضَمِنتَها","قَذىً في حُقوقِ العَينِ مِنّي أُوارِبُه",57,"ب",2,0],["كَأَنَّ حَوّاءَ الَّتي زَوجُها","آدَمُ لَم تَلقَح بِشَخصٍ أَريب",58,"ب",1,0],["كَأَنَّ حَياةَ الفَتى لَيلَةٌ","يُرَجّي أَخو اللُبِّ إِسفارَها",59,"ر",3,0],["كَأَنَّ حَوادِثَ الأَيّامِ آمٌ","تُريقُ بِجَهلِها ما أَدهَقَتهُ",60,"ت",2,0],["كأنّ حَبابَ الكأسِ وَهْيَ حَبيبةٌ","إلى الشَّرْبِ ما يَنفي الحُبابُ من السّمِّ",61,"م",1,0],["كَأَنَّ حُدوجَ المالِكيَّةِ غُدوَةً","خَلايا سَفينٍ بِالنَواصِفِ مِن دَدِ",62,"د",1,0],["كَأَنَّ حَوافِرَهُ مُدبِراً","خُضبِنَ وَإِن كانَ لَم يُخضَبِ",63,"ب",1,0],["كَأَنَّ حِجاجَ مُقلَتِها قَليبٌ","مِنَ السَقبَينِ يُخلِفُ مُستَقاها",64,"ا",3,1],["كأنَّ حَمامَةً بَيْضَاءَ ظَلَّتْ","تُقَابِلُ في مَفَارِقِهِ غُرَابا",65,"ب",2,0],["كأَنَّ حَياتي حين أَبصر لونها","سراب بِبَيداءٍ بدا يتلعلع",66,"ع",1,0],["كَأَنَّ حِبَالَ الرَّحْلِ مِنْهَا تَوَشَّحَتْ","سَرَاةَ لَيَاحٍ أَكْلَفِ الوَجْهِ أَكْحَلاَ",67,"ل",2,0],["كَأَنَّ حَنَاتِمِ حَارِيَةٍ","جَمَاجِمُهَا إِذْ مَسِسْنَ ابْتِلاَلاَ",68,"ل",2,0],["كأن حوريةً في ظلّ شاهقةٍ","من البروج تقضّي العيشَ في خلس",69,"س",1,0],["كان حديثُ القَدرِ المبهَم","مثارَ هذا الخاطر المفزعِ",70,"ع",1,0],["كأن حسان ذا شعبين كنت له","وقاية في زمان القحط والوبأ",71,"ا",1,0],["كأن حراماً أن تفارق صارماً","يكون لما أضمرت أول فاعل",72,"ل",1,0],["كأنّ حديثاً حاضِراً وَجْهُ غائِبٍ","تَلَقّاهُ بالإكْبارِ مَنْ لم يُوَدّع",73,"ع",1,0],["كأَنَّ حَمامَ الأيكِ حينَ تَجاوبَتْ","حزينٌ بكى من رحمةٍ لحزينِ",74,"ن",1,0],["كَانَ حَرَاماً كَسْرُهَا وَهْيَ لَمْ","تَحْمِلُ مِنْ القَهْوَةِ إِلاَّ الحَلاَلِ",75,"ل",1,0],["كَأَنَّ حِجَاكَ مِنْهُ وَرَا","ءَ شَفَّافٍ مِنَ السِّتْرِ",76,"ر",1,0],["كَأَنَّ حُسْنَكَ هَذَا وَهْوَ رَائِعُنَا","حُسْنٌ لِبِكْرٍ مِنَ الأَقْمَارِ مَوْلُودِ",77,"د",1,0],["كَانَ حُرَّ الرَّأْيِ لاَ يَطْرِفُهُ","رَغَبٌ عَمَّا رَآهُ أَوْ رَهَبْ",78,"ب",1,0],["كانَ حَلَيَّ الأَيّامِ ثُمَّ تَوَلّى","فَمَعاطيل بَعدَهُ الأَيّامُ",79,"م",1,0],["كَأَنّ حَماماتِ الأَراكِ تَرَنَّمَت","عَلى نَشَواتي وَالشُؤونُ دِناني",80,"ن",2,0],["كَأَنَّ حُزونَ الأَرضِ حينَ يَطَأنَهُ","سُهولٌ وَما يُصعِدنَ فيهِ صَبوبُ",81,"ب",1,0],["كأنَّ حِبالَ الشمسِ كِفّةُ حابِلٍ","تُحيطُ بنا من شمأَل