{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[129,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[165,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[272,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[367,"رضيت بما أفنيت فارض بما بقى","https://www.aldiwan.net/poem17893.html","الطويل"],[387,"ظعائن لا توفي بهن ظعائن","https://www.aldiwan.net/poem1838.html","الطويل"],[440,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[453,"أرى القلب ما بين الغواني موزعا","https://www.aldiwan.net/poem13837.html","الطويل"],[539,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[552,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[587,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"]],"verses":[["وَلا ثُنِيَت لَهُ إِلّا","عَلى مَجدٍ خَناصِرَه",0,"ر",2,0],["وَلا ثَنَيتُ عُنقي","إِلى اللَيالي صَيدا",1,"د",2,0],["وَلا ثَنَتِ المَحذورَ عَنكَ جَلالَةٌ","وَلا غُرَرٌ ثَبتٌ وَلا نائِلٌ غَمرُ",2,"ر",1,0],["وَلا ثَوبُ مَجدٍ غَيرَ ثَوبِ اِبنِ أَحمَدٍ","عَلى أَحَدٍ إِلّا بِلُؤمٍ مُرَقَّعُ",3,"ع",1,0],["ولا ثوبٌ على طرفيه وشيٌ","ولا قصر على تلّ مَشيد",4,"د",1,0],["ولا ثبتتْ للدينِ سورٌ وكعبةٌ","ولا شرُفتْ نَزْوى ولا بُنِيَ المجدُ",5,"د",1,0],["وَلاثَت تُثَنّي مِرطَها دِعصَ رَملَةٍ","سَقاها مُجاجُ الطَلِّ غِبَّ الدَثائِثِ",6,"ث",1,0],["وَلا ثنيت عنان الشوق عَن طلل","بالَ عفت بيد الانواء أَرسمه",7,"م",2,0],["وَلا ثَوبَ إِلّا مِن ظَلامٍ مُزَرَّرٍ","وَلا زادَ إِلّا مِن نُعاسِ مُرَتَّقِ",8,"ق",1,0],["وَلا ثَعلَبِيّاتٌ حَلَلنَ عُباعِباً","وَلا أُسرَةُ القَعقاعِ مِن رَهطِ حاجِبِ",9,"ب",1,0],["ولا ثنائي وشُكري بالوفاءِ بما","أولَيْتَني دونَ بذْلِ النفسِ يكفيني",10,"ن",2,0],["ولا ثَنى عَبَراتي عنْ تَذَكُّرِهِ","دَهْرٌ تَقارَعُ فِي صدري قوارِعُهُ",11,"ع",2,0],["ولا ثم لي وعد من الحب منجز","ولا فرصة في حبه تتوقع",12,"ع",1,0],["ولا ثَاكِلٌ مَفجُوعةٌ بوحيدها","تقَرَّحَ منهَا الجفنُ من بعده نَحبا",13,"ب",2,0],["ولا ثوى اليُسْرُ بدارِ باخلٍ","متى يُسَلْ بذل اليَسارِ جَمْجَما",14,"م",2,0],["وَلا ثَناهُ وَأَمْرُ الحبِّ في يَدِهِ","عَذْلٌ فَكَيْفَ وأَمْرُ الحُبّ قَدْ غَلَبَا",15,"ب",2,0]]}