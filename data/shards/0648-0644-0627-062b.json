{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[55,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[45,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[132,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[276,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[371,"رضيت بما أفنيت فارض بما بقى","https://www.aldiwan.net/poem17893.html","الطويل"],[391,"ظعائن لا توفي بهن ظعائن","https://www.aldiwan.net/poem1838.html","الطويل"],[445,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[457,"أرى القلب ما بين الغواني موزعا","https://www.aldiwan.net/poem13837.html","الطويل"],[543,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[591,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87022","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145970","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62463","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59355","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64530","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64456","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128699","البسيط"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104151","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48216","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53225","البسيط"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33007","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104300","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48327","الطويل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27128","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138620",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3634,"","https://poetry.dctabudhabi.ae/diwan/poem/202664","الطويل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106792","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91380","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91336","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66137","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66123","البسيط"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143304","السريع"],[5183,"مُلغِزَه رق441م","https://www.poetsgate.com/ViewPoem.aspx?id=186404",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[6056,"لبّى عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=130332",""]],"verses":[["وَلا ثُنِيَت لَهُ إِلّا","عَلى مَجدٍ خَناصِرَه",0,"ر",2,0],["وَلا ثَنَيتُ عُنقي","إِلى اللَيالي صَيدا",1,"د",2,0],["وَلا ثَنَتِ المَحذورَ عَنكَ جَلالَةٌ","وَلا غُرَرٌ ثَبتٌ وَلا نائِلٌ غَمرُ",2,"ر",1,0],["وَلا ثَوبُ مَجدٍ غَيرَ ثَوبِ اِبنِ أَحمَدٍ","عَلى أَحَدٍ إِلّا بِلُؤمٍ مُرَقَّعُ",3,"ع",1,0],["ولا ثوبٌ على طرفيه وشيٌ","ولا قصر على تلّ مَشيد",4,"د",1,0],["ولا ثبتتْ للدينِ سورٌ وكعبةٌ","ولا شرُفتْ نَزْوى ولا بُنِيَ المجدُ",5,"د",1,0],["وَلاثَت تُثَنّي مِرطَها دِعصَ رَملَةٍ","سَقاها مُجاجُ الطَلِّ غِبَّ الدَثائِثِ",6,"ث",1,0],["وَلا ثنيت عنان الشوق عَن طلل","بالَ عفت بيد الانواء أَرسمه",7,"م",2,0],["وَلا ثَوبَ إِلّا مِن ظَلامٍ مُزَرَّرٍ","وَلا زادَ إِلّا مِن نُعاسِ مُرَتَّقِ",8,"ق",1,0],["وَلا ثَعلَبِيّاتٌ حَلَلنَ عُباعِباً","وَلا أُسرَةُ القَعقاعِ مِن رَهطِ حاجِبِ",9,"ب",1,0],["ولا ثنائي وشُكري بالوفاءِ بما","أولَيْتَني دونَ بذْلِ النفسِ يكفيني",10,"ن",2,0],["ولا ثَنى عَبَراتي عنْ تَذَكُّرِهِ","دَهْرٌ تَقارَعُ فِي صدري قوارِعُهُ",11,"ع",2,0],["ولا ثم لي وعد من الحب منجز","ولا فرصة في حبه تتوقع",12,"ع",1,0],["ولا ثَاكِلٌ مَفجُوعةٌ بوحيدها","تقَرَّحَ منهَا الجفنُ من بعده نَحبا",13,"ب",2,0],["ولا ثوى اليُسْرُ بدارِ باخلٍ","متى يُسَلْ بذل اليَسارِ جَمْجَما",14,"م",2,0],["وَلا ثَناهُ وَأَمْرُ الحبِّ في يَدِهِ","عَذْلٌ فَكَيْفَ وأَمْرُ الحُبّ قَدْ غَلَبَا",15,"ب",2,0],["وَلأثقل الثقلين ملتَ وَبعتَني","بَيع العَبيد وَما رحمت تذللي",16,"ل",2,0],["ولا ثيَابَاً قصِيرَاتٍ ولا خُطبَاً","مُملَّةً مُعتِمَاتٍ في نَوَاهِيهَا",17,"ي",3,0],["ولا ثوباً لعِرْسي لا","ولا مائةً من الصُّفْرِ",18,"ر",1,0],["وَلاَ ثَنَى البَانُ أعطَافاً مُرَنَّحَةً","إلاّ وَغَنَّى عَلَيْهَا هاتفُ البُكَرِ",19,"ر",1,0],["ولاثم قانون تعاليت تنتحي","إليه ولا عن فعل طبع وعلة",20,"ه",1,0],["ولاثم أبعاد ولاثم جوهر","فيلزم ذات الحق نقص السوية",21,"ه",1,0],["ولا ثنت في رداء الشعر قامتها","إلا حسبنا النقا عادت لياليه",22,"ي",2,0],["ولا ثقلت في الوزن أعباءً منةٍ","على المرء إلا منة الشكر أثقل",23,"ل",1,0],["ولا ثَنى السُّمْرَ إِلا وهو مُولِغُها","جَنانَ كل طويلِ الباع دَعّاس",24,"س",1,0],["ولا ثللت مغيراً عرش ملكهمُ","إلا وشيَّدت هذا الملك غيرانا",25,"ن",2,0],["وَلا ثَوبُ البَقاءِ بِثَوبِ عِزٍّ","فَيُطوى عَن أَخي الخَنعِ اليُراعُ",26,"ع",1,0],["ولا ثمنٌ فيهنّ منكم سوى الرّضى","ومرتبة من دُونها النّسرُ حائمُ",27,"م",1,0],["ولا ثملت بشيء غير ذكركم","وان يكن لكم في غيري الشغف",28,"ف",1,0],["ولا ثَنَتِ السُّمْرُ العَوالي لدى الوغَى","ذوابِل في الأيدي تَروقُ تنعُّما",29,"م",2,0],["وَلاثوا بِأَيديهِم فُضولَ أَزِمَّةٍ","تَصورُ البُرى أَزرارُها لَم تُحَلَّلِ",30,"ل",1,0],["ولا ثائرٌ من آل أحمد مدرك","لأوتارها من قبل أن يظهرَ المهدي",31,"د",2,0],["وَلأُثنينَّ عَلَيكُمُ بِفَرائد","تَبقى وَإِن أَفنى يَدوم ثَناءُ",32,"ا",2,0],["ولا ثغر إلا دونه ثغر بارق","ولا خد إلا دونه حد بارق",33,"ق",1,0],["وَلاَ ثِقلٍ بِلاَ سَبَبٍ فَرِدفٍ","خفِيفٍ مِنهُ وَالحصرِ الثَّقيلِ",34,"ل",1,0],["وَلاثغٌ أَهيفٌ بِالراء تيَّمني","في جفنه وَطفٌ في قدّه هَيَف",35,"ف",1,0],["وَلا ثنى القَلبَ عَن أَعطافه مَيَدٌ","إلا دعاهُ هوىً بَعد النَوى نجذا",36,"ذ",2,0],["ولا ثَنَتْهُ عَنِ الامْجادِ كارِثَةٌ","ولا لَواهُ عَنِ العَلْياءِ سُلْطانُ",37,"ن",1,0],["وَلاَ ثَنَتْني صُرُوفُ الدَّهْرِ تَقْرَعُني","بكلِّ صَلْدٍ ولا العَسالَةُ الذُّبُلُ",38,"ل",1,0],["ولا ثنيت العزم عن بابكم","إلا تعثرت بأذيالي",39,"ي",1,0],["ولا ثناها وقد صاح الأجش بها","تخالُ في الأفق منه الصوت صْهصلقا",40,"ق",2,0],["ولا ثناها لداعي الله مزدجر","عن جهلها بنذير الشيب والهدم",41,"م",1,0],["ولا ثنتهم عن الأخلاق بهرجة","وصبغ وجه بأشكال وألوان",42,"ن",1,0],["ولأثمدوا رمٓدٓ العيون ترابها","وأصابهُمْ بعد البكاءِ بحاحُ",43,"ح",1,0],["ولاثار بركان إبتسامة سنونك","يرمي حمم شهد العسل نظم ريّك",44,"ك",1,0]]}