{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"]],"verses":[["وَلا ثُنِيَت لَهُ إِلّا","عَلى مَجدٍ خَناصِرَه",0,"ر",2,0],["وَلا ثَنَيتُ عُنقي","إِلى اللَيالي صَيدا",1,"د",2,0],["وَلا ثَنَتِ المَحذورَ عَنكَ جَلالَةٌ","وَلا غُرَرٌ ثَبتٌ وَلا نائِلٌ غَمرُ",2,"ر",1,0],["وَلا ثَوبُ مَجدٍ غَيرَ ثَوبِ اِبنِ أَحمَدٍ","عَلى أَحَدٍ إِلّا بِلُؤمٍ مُرَقَّعُ",3,"ع",1,0],["ولا ثوبٌ على طرفيه وشيٌ","ولا قصر على تلّ مَشيد",4,"د",1,0]]}