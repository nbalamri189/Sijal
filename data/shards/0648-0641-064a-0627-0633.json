{"poems":[[102,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[95,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[95,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[30,"لنا دون من تحت السماء عليهم","https://www.aldiwan.net/poem5091.html","الطويل"],[107,"دعاة الخير والإصلاح مرحى","https://www.aldiwan.net/poem43066.html","الوافر"],[52,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[275,"فؤادي للسماء وللسمو","https://www.aldiwan.net/poem35006.html","الوافر"],[354,"تفرق الغاوون في حبكم","https://www.aldiwan.net/poem15756.html","السريع"],[371,"ففي البر بحر قد طمى تحت جيشه","https://www.aldiwan.net/poem17241.html","الطويل"],[396,"يا حسرتي ضاع عمري في البطالات","https://www.aldiwan.net/poem54608.html","عموديه"],[398,"لنا قاض له رأس","https://www.aldiwan.net/poem53631.html","الهزج"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[484,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137617",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38123","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1155,"","https://poetry.dctabudhabi.ae/diwan/poem/203309","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49928","المنسرح"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77893","الوافر"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107034","الرجز"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137926",""],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101758","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27990","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77352","البسيط"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84920","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205785","الوافر"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91295","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133250","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199065","الطويل"],[5616,"آسام","https://www.poetsgate.com/ViewPoem.aspx?id=204837",""],[5762,"على عهد العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=12688",""],[402,"مددت طرافك للائذين","https://www.poetsgate.com/ViewPoem.aspx?id=36537",""]],"verses":[["وفي أسى مقلتيها يغتلي (يمن","ثان كحلم الصبا... ينأى ويقترب",0,"ب",1,0],["وَفِي اسْمِ شَقِيق دَلِيلٌ عَلَيْهِ","وَمَنْ مِثْلُهُ يَنْصُرُ البَائِسِينْ",1,"ن",1,0],["وَفِي أُسْرَةٍ مِنْ مَاجِدِينَ أَعِزَّةٍ","هُمُ النُّبَلاءُ النَّابِهُونَ الْخَضَارِمُ",2,"م",1,0],["وَفي أَسَدٍ عادِيُّ عِزٍّ وَفيهِمُ","رَوافِدُ مَعروفٍ غَزيرٍ غَزيرُها",3,"ر",3,0],["وَفي اِستِقلالِكُم بَعضُ المَزايا","وَلَكِنّا لَمَسناهُ فَذابا",4,"ب",2,0],["وَفي أَسهَلِ ما يَأتي","بِهِ كافٍ مِنَ الصَعبِ",5,"ب",1,0],["وفي أساريرهم ذكرى وأعينهم","أسرارُ ماضٍ على الأحقابِ منسَدِلِ",6,"ل",1,0],["وفي أسفارِ فردوسي عزاءٌ","ولكن لا سبيلَ إلى السلوِّ",7,"و",1,0],["وَفي اِستِناني لِمُوالاتِكُم","إِستَنَّ أَعداؤُكُك في عَرضي",8,"ض",2,0],["وَفي أَسرِهِ الإيمانُ كانَ بِأَسرِهِ","فَلا عُدِمَت كفٌّ تَسامَت لِفَكِّهِ",9,"ك",2,0],["وفي استماع إلى أقوال مردية","وكل ما ليس يعنيني له آت",10,"ت",1,0],["وَفي أَسفَلِهِ داءٌ","يُعيد مِنكُم السوءُ",11,"س",3,0],["وَفِي اسمِ المظفَّرِ فألُ الحياةِ","ليحيا الغريبُ بِهِ والمقيمُ",12,"م",1,0],["وفي أسبوعه ربضت سباع","تقوم لمن قيامته تقوم",13,"م",1,0],["وفي أسفل الصرح تلقى أوائل","دوافع أمواهها من أسافل",14,"ل",1,1],["وَفي أَسعَدٍ إِذ عادَ عادَ تَشَرُّفي","وَلي الشّرفُ الأَعلى بِبَيتِ المَحاسِنِ",15,"ن",1,0],["وَفي أسدٍ وَالنِّمر أَبناء قاسِطٍ","أَمانٌ مِنَ الأَيّامِ وَالغيَراتِ",16,"ت",1,0],["وفي أسانيد الأراك حافظ","للعهد يروي صبره عن علقمه",17,"ه",1,1],["وفي استواء ليس إلا الفصل","وقلّ في الغيبة منها الوصل",18,"ل",1,0],["وفي اسم صوت أو دُعاء للفرَس","ومنه زجرٌ نحو ده على عدَس",18,"س",1,0],["وفي استغاثة أتى يا وانخفض","مع فتح لام مستغاث قد عرض",18,"ض",1,0],["وفي إسار الدُّمى لها كبدٌ","يُصْعدُها تارةٌ ويسغْبُها",19,"ب",3,0],["وَفي اِستغفار أَملاك كرام","وَقلبك عَن سَبيل الحق ساهي",20,"ا",3,0],["وفي اسمه كنز النجاح والفرح","حدث بما شئت هنا ولا حرج",21,"ج",1,0],["وفي استعداده للحرب معهم","قضى التسعين يوماً مستمرا",22,"ر",2,0],["وفي أَسْرِ الغرام إذا استَقَلُّوا","فؤادٌ كيفما ساروا يَسيرُ",23,"ر",1,0],["وفي استوائي العقولُ تاهت","إذ حال ما بينها وبيني",24,"ن",2,0],["وَفي أُسامَةَ مِن أَخبارِهِ طرَفٌ","لِلسامِعينَ وَآياتٌ لِواعيها",25,"ي",3,0],["وَفي اسمك مَأوى السُم لَو نَطقت بِهِ","جَميع الوَرى ماتَت عَلى غَير مَأتم",26,"م",1,0],["وفي أسوان حيث الليل صبح","رأيت العزم يصنع مستحيلا",27,"ل",2,0],["وَفِى اسمِ مَفعُولِ الثُّلاثِى اطَّرَد","زِنهُ مَفعُولٍ كآتٍ مَن قَصَد",28,"د",1,0],["وَفِى اسمٍ استٍ ابنٍ ابَّنمٍ سُمِع","وَاثَنَين وَامرِىءٍ وَتأنِيثٍ تَبِع",28,"ع",1,0],["وَفي استهانةِ صَعبِ الأَمرِ مكرمةٌ","وفي احتمال الشَقا بابٌ إِلى النعم",29,"م",1,0],["وفي استباقي إلى الخيرات أطلبها","وفي ارتيادي العلا مع نيل أو طارى",30,"ر",2,0],["وفي إسمه راء يدل بنصره","إلى موكب في عزه دائما يجري",31,"ر",2,0],["وفي آسامَ قد بقرت بطونٌ","وفي ((آسام)) قد سُملت عيونُ",32,"ن",1,0],["وفي ((آسام)) قد جُزَّت رقابٌ","كما جزّت بنضرتها غصونُ",32,"ن",1,0],["وفي استقلالها تتلو كتابا","به جاء المليك هدى وحقا",33,"ق",2,0],["وفي اسم شفيق دليل عليه","ومن مثله ينصر البائسين",34,"ن",1,0]]}