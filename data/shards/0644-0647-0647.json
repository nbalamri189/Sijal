{"poems":[[53,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[63,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[63,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[72,"إليك مدير الكأس عني إنني","https://www.aldiwan.net/poem18552.html","الطويل"],[72,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"أبا غانم فيم احتشامك عندنا","https://www.aldiwan.net/poem11428.html","الطويل"],[45,"مدحت أبا العباس للحين ضلة","https://www.aldiwan.net/poem65551.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[45,"لها الله عني ضامن وكفيل","https://www.aldiwan.net/poem65604.html","الطويل"],[58,"ومحترس من نفسه خوف ذلة","https://www.aldiwan.net/poem30789.html","الطويل"],[80,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[74,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42701","الطويل"],[58,"ومحترس من نفسه خوف ذلة","https://www.poetsgate.com/ViewPoem.aspx?id=22712",""],[45,"لَنَا أبَداً بَثٌّ نُعانيهِ من أرْوَى","https://www.poetsgate.com/ViewPoem.aspx?id=31686",""],[80,"بكى فقدكَ العزُّ المؤيد والمجد","https://www.poetsgate.com/ViewPoem.aspx?id=3164",""],[130,"أيا عين السلامة لا تنامى","https://www.aldiwan.net/poem54740.html","الوافر"],[158,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[158,"إلى كم عتاب دائم وعتاب","https://www.aldiwan.net/poem58982.html","الطويل"],[167,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[167,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[167,"بنانك من مغدودق المزن أهطل","https://www.aldiwan.net/poem1659.html",""],[167,"صعود العلا إلا عليك حرام","https://www.aldiwan.net/poem1666.html",""],[210,"ألا أبلغا عني أبا المجد والعلا","https://www.aldiwan.net/poem37897.html","الطويل"],[259,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[259,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[280,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[295,"إليك فقلبي لا تقر بلابله","https://www.aldiwan.net/poem33195.html","الطويل"],[296,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[303,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[351,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[361,"أشاقتك أظعان بجفن يبنبم","https://www.aldiwan.net/poem1707.html","الطويل"],[362,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[363,"وسيري حتى قال في القوم قائل","https://www.aldiwan.net/poem44532.html","الطويل"],[377,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[403,"أرى منك وجه الصد لا يتغير","https://www.aldiwan.net/poem50160.html","الطويل"],[413,"دعوت فؤادي للسلو فما أجدى","https://www.aldiwan.net/poem54056.html","الطويل"],[429,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[429,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[450,"سقى الله أيام العذيب وبارقه","https://www.aldiwan.net/poem13862.html","الطويل"],[459,"له هزة لو لا تقاه ونسكه","https://www.aldiwan.net/poem15591.html","الطويل"],[480,"أنخت مطايا الذل نحوك ملقيا","https://www.aldiwan.net/poem24461.html","عموديه"],[488,"لهُ هيدب دانٍ ورعد ولجة","https://www.aldiwan.net/poem649.html",""],[560,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""]],"verses":[["لَهُ هامَةٌ كَرَحى الطاحِناتِ","تَدورُ عَلى لُبدَةٍ كَالثِفالِ",0,"ل",1,0],["لهُ هزّةٌ في نَدوَةِ الحَيّ للندىً","كَما هَزّ أعْطافَ الخَليعِ رَحيقُ",1,"ق",1,0],["لهُ هَيْبَةٌ فيها التّواضُعُ كامِنٌ","وعِزٌّ بذَيْلِ الكِبْرِياءِ تَلَثّما",2,"م",2,0],["لهُ هِمّةٌ غَيْرى على المَجدِ برَّحَتْ","بنَفْسٍ على الأيّامِ منْ تيهِها غَضْبى",3,"ب",2,0],["لهُ هَيبَةٌ شِيبتْ بِبشْرٍ كَما التَقَتْ","مِياهٌ بمَتْنِ المَشْرَفيِّ ونيرانُ",4,"ن",1,0],["له همةٌ توَّاقةٌ شادَويةٌ","إذا صعدت تاقت لأشرف مصعدا",5,"د",2,0],["له همَّة إن شئت غالية الثنا","فشمها وإن شئت الفخار فشمّها",6,"م",3,0],["له هيبةٌ لم يكتسبْها بكلْفةٍ","إذا اكتسبتْ ذاك الوجوهُ العوابس",7,"س",1,0],["لَهُ هَيدَبٌ يَعلو الشِراجَ وَهَيدَبٌ","مُسِفٌّ بِأَذنابِ التِلاعِ خَلوجُ",8,"ج",1,0],["له هَيبةٌ تسري أمامَ جُنودِه","ورأيٌ بمُستنِّ الغُيوبِ يجولُ",9,"ل",1,0],["له هضبةُ العزِّ القُدامسُ والذُّرَى","من المجدِ والطَودُ الذي هو أبذخُ",10,"خ",1,0],["لَهُ هِمَّةٌ أَعلى النُجومِ مَحَلَّةً","مَحَلٌّ لَها دونَ الأَماكِنِ أَو مَثوى",11,"و",2,0],["لَهُ هِزَّةٌ مِن أَريَحِيَّةِ جودِهِ","تَكادُ لَها الأَرضُ الجَديبَةُ تُعشِبُ",12,"ب",1,0],["لَهُ هَيبَةٌ في مَجلِسِ الحُكمِ تُتَّقى","وَقَد باتَ مُلقىً وَالأُيورُ تُلاعِبُه",13,"ب",2,0],["لَهُ هِمَّةٌ لَوفَرَّقَ اللَهُ شَملَها","عَلى الناسِ لَم يُجمَع لِمَكرُمَةٍ شَملُ",14,"ل",1,0],["لَهُ هِمَمٌ لا تَملَأُ الدَهرَ صَدرَهُ","يَضيقُ بِها عَرضُ البِلادِ وَطولُها",15,"ل",3,0],["لَهُ هِمَّةٌ نُلقي عَلَيها مُهِمَّنا","فَيَدنو بَعيدٌ أَو يَدِقُّ جَليلُ",16,"ل",1,0],["لَهُ هِمَّةٌ تَعلو عَلى كُلِّ هِمَّةٍ","كَما قَد عَلا البَدرَ النُجومُ الدَراريا",17,"ي",2,0],["له هِمَّةٌ في أُفقِها فَرقَدِيَّةٌ","كَواكبُها زُهْرٌ أحاطَ بِهِ السَّعدُ",18,"د",1,0],["لَهُ هِمَمٌ ما إِن تَزالُ سُيوفُها","قَواطِعَ لَو كانَت لَهُنَّ مَقاطِعُ",19,"ع",1,0],["لَهُ هِمَّةٌ تُملي عَلَيهِ وَعَزمَةٌ","تَخُطُّ بِأَطرافِ الرِماحِ وَتَمشُقُ",20,"ق",1,0],["لَهُ هِمَمٌ فُتنَ عِزَّ النُجومِ","وَمالٌ عَلى الذُلِّ قَد عَوَّلا",21,"ل",2,0],["لهُ هاجِسٌ يَفْري الفَرِيَّ كأنّهُ","شَبَا مَشرَفّيٍ ليسَ ينبو مُذَلَّقُه",22,"ق",2,0],["له هذه وله هذه","فسَجْلٌ حياةٌ وسَجْلٌ رَدى",23,"ا",1,0],["له هناك قرين","يطيعه ويطاع",24,"ع",1,0],["لَهُ هَيْدَبٌ مِلْءُ الْفَضَاءِ كَأَنَّهُ","مَنَاكِبُ أَطْوَادٍ عَلَى الأَرْضِ تَزْحَفُ",25,"ف",1,0],["له همّة ٌ تعلو كل همّة ٍ","كما قَدْ عَلاَ البَدْرُ النُّجومَ الدَّرارِيا",26,"ي",2,0],["لَهُ هِمّةٌ، أغْلَى النّجُومِ مَحَلّةً","مَحلٌّ لها، دونَ الأماكنِ، أوْ مَثوى",27,"و",2,0],["له همّة ٌ في أفقها فرقدية","كواكبُها زُهْرٌ أحاطَ بها السّعد",28,"د",1,0],["لَهُ هِمَمٌ جَمَعنَ لَهُ المَعَالِى","كَجمعِ الكَفِّ مَجمُوعَ البَنَامِ",29,"م",1,0],["له همة يستصغر الدهر عندها","وشأو إذا رام البعيد بعيدُ",30,"د",1,0],["له هزة عند المديح وضحكة","تباشيرها قبل الرعاب رعاب",31,"ب",1,0],["لَهُ هَيبَةٌ مِلءُ الصُدورِ فَلو رَنا","إِلى المَوتِ مُزوَرّاً لَماتَ مِنَ الذُعرِ",32,"ر",1,0],["لَهُ هَيبَةٌ كَم ضَيَّقَت مِن مُوَسَّعٍ","وكَم قَد غَدا رَهواً بِها المتَضايِقُ",33,"ق",1,0],["لَهُ هَيبَةٌ مِلءُ الصُدورِ وَإِنَّهُ","عَلى عِزَّهِ للناسِكُ المُتَبَتِّلُ",34,"ل",1,0],["لَهُ هَيبَةٌ مِلءُ الصُدُورِ وَعَزمَةٌ","تُريهِ الجِبالَ الشُمَّ وَهيَ إِكامُ",35,"م",1,0],["له هِمّةٌ فوق السِّماك مَحَلُّها","ومَحْفِلة فوق المَجَرةِ والصَّمْدِ",36,"د",1,0],["له هندواني كأن مضاءه","يقسم منه السحر للحدق والنجل",37,"ل",1,0],["له همة لا ترضي البدر درهما","ولا الشمس ديناراً ولا الافق مقعدا",38,"د",2,0],["لَهُ هَيبَةٌ تَحتَها هَبَّةٌ","تَفُتُّ حَشا الأَسَدِ الباسِلِ",39,"ل",1,0],["له همَّةٌ نافت على الأَوج رفعةً","تقاصرَ عنها حين همَّت تُطاولُه",40,"ل",2,0],["له هناة عَلى فكيّه دائرةٌ","لَما تدير سواكاً كفُّ مستاك",41,"ك",1,0],["له هِممٌ ما أُشعرَ الدهرُ بعضها","يُكتِّمُها حزمٌ ويُعلنها فخرُ",42,"ر",1,0],["لَهُ همّة تَسمو السماك فَلو أَتى","بِها الفلك الدوّار أَوهنه متنا",43,"ن",2,0],["لَهُ هَيدَبٌ دانٍ كَأَنَّ فُروجَهُ","فُوَيقَ الحَصى وَالأَرضِ أَرفاضُ حَنتَمِ",44,"م",1,0],["له هِمّةٌ تَستَصْغِرُ الأرضَ عنْدَها","إذا أخذَتْ في قُنّةِ المجدِ تَسْتَمي",45,"م",2,0],["له هامةٌ ما تأكلُ البَيضُ أُمَّها","وأشباحُ عاديٍّ طويلِ الرَواجِبِ",46,"ب",1,0],["له هجومٌ فاسدُدَن ممرَّهُ","ببيدقٍ عسى تصدّ شره",47,"ه",1,0],["لَهُ هِمَّة تَعلو عَلى كُلِّ هِمَّةٍ","وَرأيٌ حَصيفُ في الأُمورِ مُدَبِّرُ",48,"ر",1,0],["له هممٌ في المعضلات تخالها","كسُمر القنا طعناً وبيض الظبا حدَّا",49,"د",2,0],["له هشّةٌ كالروضِ والروضُ مونِقٌ","الى حنكة كالطّودِ والطّودُ طامحُ",50,"ح",1,0],["له همٌّ كقدورهُمُ المُعلّى","وبشرٌ مثلُ فعلهمُ الجميلِ",51,"ل",1,0],["له همةٌ أربت على كلِّ مُبرمٍ","صريمة شأو ثابت العزمِ صادقِه",52,"ق",2,0],["له هِزَّةٌ لو لا تُقاهُ ونُسْكُه","لقلتُ أصابَ البابِليَّ المُشعْشَعا",53,"ع",2,1],["له همم أربت على الفلك تبتغي","مراتب فوق الفوق ليست تفاضل",54,"ل",1,0],["لَهُ هَيدَبٌ دانٍ وَرَعدٌ وَلَجَّةٌ","وَبَرقٌ تَراهُ ساطِعاً يَتَبَلَّجُ",55,"ج",1,1],["لهُ هِمَّةٌ في الحادثاتِ بعيدةٌ","إذا راضَتِ الأعمالَ يدنو بَعيدُها",56,"د",3,0],["له همة تدني له كل شاسع","وتستسهل الصعب الذي ليس يسهل",57,"ل",1,0]]}