ewPoem.aspx?id=76778",""],[5980,"نجيب يرى كسب الفنون فضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=146271",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[2220,"سُحيراً أناخوا بِوادي العقيقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19280&r=&rc=822",""]],"verses":[["لَهُ هامَةٌ كَرَحى الطاحِناتِ","تَدورُ عَلى لُبدَةٍ كَالثِفالِ",0,"ل",1,0],["لهُ هزّةٌ في نَدوَةِ الحَيّ للندىً","كَما هَزّ أعْطافَ الخَليعِ رَحيقُ",1,"ق",1,0],["لهُ هَيْبَةٌ فيها التّواضُعُ كامِنٌ","وعِزٌّ بذَيْلِ الكِبْرِياءِ تَلَثّما",2,"م",2,0],["لهُ هِمّةٌ غَيْرى على المَجدِ برَّحَتْ","بنَفْسٍ على الأيّامِ منْ تيهِها غَضْبى",3,"ب",2,0],["لهُ هَيبَةٌ شِيبتْ بِبشْرٍ كَما التَقَتْ","مِياهٌ بمَتْنِ المَشْرَفيِّ ونيرانُ",4,"ن",1,0],["له همةٌ توَّاقةٌ شادَويةٌ","إذا صعدت تاقت لأشرف مصعدا",5,"د",2,0],["له همَّة إن شئت غالية الثنا","فشمها وإن شئت الفخار فشمّها",6,"م",3,0],["له هيبةٌ لم يكتسبْها بكلْفةٍ","إذا اكتسبتْ ذاك الوجوهُ العوابس",7,"س",1,0],["لَهُ هَيدَبٌ يَعلو الشِراجَ وَهَيدَبٌ","مُسِفٌّ بِأَذنابِ التِلاعِ خَلوجُ",8,"ج",1,0],["له هَيبةٌ تسري أمامَ جُنودِه","ورأيٌ بمُستنِّ الغُيوبِ يجولُ",9,"ل",1,0],["له هضبةُ العزِّ القُدامسُ والذُّرَى","من المجدِ والطَودُ الذي هو أبذخُ",10,"خ",1,0],["لَهُ هِمَّةٌ أَعلى النُجومِ مَحَلَّةً","مَحَلٌّ لَها دونَ الأَماكِنِ أَو مَثوى",11,"و",2,0],["لَهُ هِزَّةٌ مِن أَريَحِيَّةِ جودِهِ","تَكادُ لَها الأَرضُ الجَديبَةُ تُعشِبُ",12,"ب",1,0],["لَهُ هَيبَةٌ في مَجلِسِ الحُكمِ تُتَّقى","وَقَد باتَ مُلقىً وَالأُيورُ تُلاعِبُه",13,"ب",2,0],["لَهُ هِمَّةٌ لَوفَرَّقَ اللَهُ شَملَها","عَلى الناسِ لَم يُجمَع لِمَكرُمَةٍ شَملُ",14,"ل",1,0],["لَهُ هِمَمٌ لا تَملَأُ الدَهرَ صَدرَهُ","يَضيقُ بِها عَرضُ البِلادِ وَطولُها",15,"ل",3,0],["لَهُ هِمَّةٌ نُلقي عَلَيها مُهِمَّنا","فَيَدنو بَعيدٌ أَو يَدِقُّ جَليلُ",16,"ل",1,0],["لَهُ هِمَّةٌ تَعلو عَلى كُلِّ هِمَّةٍ","كَما قَد عَلا البَدرَ النُجومُ الدَراريا",17,"ي",2,0],["له هِمَّةٌ في أُفقِها فَرقَدِيَّةٌ","كَواكبُها زُهْرٌ أحاطَ بِهِ السَّعدُ",18,"د",1,0],["لَهُ هِمَمٌ ما إِن تَزالُ سُيوفُها","قَواطِعَ لَو كانَت لَهُنَّ مَقاطِعُ",19,"ع",1,0],["لَهُ هِمَّةٌ تُملي عَلَيهِ وَعَزمَةٌ","تَخُطُّ بِأَطرافِ الرِماحِ وَتَمشُقُ",20,"ق",1,0],["لَهُ هِمَمٌ فُتنَ عِزَّ النُجومِ","وَمالٌ عَلى الذُلِّ قَد عَوَّلا",21,"ل",2,0],["لهُ هاجِسٌ يَفْري الفَرِيَّ كأنّهُ","شَبَا مَشرَفّيٍ ليسَ ينبو مُذَلَّقُه",22,"ق",2,0],["له هذه وله هذه","فسَجْلٌ حياةٌ وسَجْلٌ رَدى",23,"ا",1,0],["له هناك قرين","يطيعه ويطاع",24,"ع",1,0],["لَهُ هَيْدَبٌ مِلْءُ الْفَضَاءِ كَأَنَّهُ","مَنَاكِبُ أَطْوَادٍ عَلَى الأَرْضِ تَزْحَفُ",25,"ف",1,0],["له همّة ٌ تعلو كل همّة ٍ","كما قَدْ عَلاَ البَدْرُ النُّجومَ الدَّرارِيا",26,"ي",2,0],["لَهُ هِمّةٌ، أغْلَى النّجُومِ مَحَلّةً","مَحلٌّ لها، دونَ الأماكنِ، أوْ مَثوى",27,"و",2,0],["له همّة ٌ في أفقها فرقدية","كواكبُها زُهْرٌ أحاطَ بها السّعد",28,"د",1,0],["لَهُ هِمَمٌ جَمَعنَ لَهُ المَعَالِى","كَجمعِ الكَفِّ مَجمُوعَ البَنَامِ",29,"م",1,0],["له همة يستصغر الدهر عندها","وشأو إذا رام البعيد بعيدُ",30,"د",1,0],["له هزة عند المديح وضحكة","تباشيرها قبل الرعاب رعاب",31,"ب",1,0],["لَهُ هَيبَةٌ مِلءُ الصُدورِ فَلو رَنا","إِلى المَوتِ مُزوَرّاً لَماتَ مِنَ الذُعرِ",32,"ر",1,0],["لَهُ هَيبَةٌ كَم ضَيَّقَت مِن مُوَسَّعٍ","وكَم قَد غَدا رَهواً بِها المتَضايِقُ",33,"ق",1,0],["لَهُ هَيبَةٌ مِلءُ الصُدورِ وَإِنَّهُ","عَلى عِزَّهِ للناسِكُ المُتَبَتِّلُ",34,"ل",1,0],["لَهُ هَيبَةٌ مِلءُ الصُدُورِ وَعَزمَةٌ","تُريهِ الجِبالَ الشُمَّ وَهيَ إِكامُ",35,"م",1,0],["له هِمّةٌ فوق السِّماك مَحَلُّها","ومَحْفِلة فوق المَجَرةِ والصَّمْدِ",36,"د",1,0],["له هندواني كأن مضاءه","يقسم منه السحر للحدق والنجل",37,"ل",1,0],["له همة لا ترضي البدر درهما","ولا الشمس ديناراً ولا الافق مقعدا",38,"د",2,0],["لَهُ هَيبَةٌ تَحتَها هَبَّةٌ","تَفُتُّ حَشا الأَسَدِ الباسِلِ",39,"ل",1,0],["له همَّةٌ نافت على الأَوج رفعةً","تقاصرَ عنها حين همَّت تُطاولُه",40,"ل",2,0],["له هناة عَلى فكيّه دائرةٌ","لَما تدير سواكاً كفُّ مستاك",41,"ك",1,0],["له هِممٌ ما أُشعرَ الدهرُ بعضها","يُكتِّمُها حزمٌ ويُعلنها فخرُ",42,"ر",1,0],["لَهُ همّة تَسمو السماك فَلو أَتى","بِها الفلك الدوّار أَوهنه متنا",43,"ن",2,0],["لَهُ هَيدَبٌ دانٍ كَأَنَّ فُروجَهُ","فُوَيقَ الحَصى وَالأَرضِ أَرفاضُ حَنتَمِ",44,"م",1,0],["له هِمّةٌ تَستَصْغِرُ الأرضَ عنْدَها","إذا أخذَتْ في قُنّةِ المجدِ تَسْتَمي",45,"م",2,0],["له هامةٌ ما تأكلُ البَيضُ أُمَّها","وأشباحُ عاديٍّ طويلِ الرَواجِبِ",46,"ب",1,0],["له هجومٌ فاسدُدَن ممرَّهُ","ببيدقٍ عسى تصدّ شره",47,"ه",1,0],["لَهُ هِمَّة تَعلو عَلى كُلِّ هِمَّةٍ","وَرأيٌ حَصيفُ في الأُمورِ مُدَبِّرُ",48,"ر",1,0],["له هممٌ في المعضلات تخالها","كسُمر القنا طعناً وبيض الظبا حدَّا",49,"د",2,0],["له هشّةٌ كالروضِ والروضُ مونِقٌ","الى حنكة كالطّودِ والطّودُ طامحُ",50,"ح",1,0],["له همٌّ كقدورهُمُ المُعلّى","وبشرٌ مثلُ فعلهمُ الجميلِ",51,"ل",1,0],["له همةٌ أربت على كلِّ مُبرمٍ","صريمة شأو ثابت العزمِ صادقِه",52,"ق",2,0],["له هِزَّةٌ لو لا تُقاهُ ونُسْكُه","لقلتُ أصابَ البابِليَّ المُشعْشَعا",53,"ع",2,1],["له همم أربت على الفلك تبتغي","مراتب فوق الفوق ليست تفاضل",54,"ل",1,0],["لَهُ هَيدَبٌ دانٍ وَرَعدٌ وَلَجَّةٌ","وَبَرقٌ تَراهُ ساطِعاً يَتَبَلَّجُ",55,"ج",1,1],["لهُ هِمَّةٌ في الحادثاتِ بعيدةٌ","إذا راضَتِ الأعمالَ يدنو بَعيدُها",56,"د",3,0],["له همة تدني له كل شاسع","وتستسهل الصعب الذي ليس يسهل",57,"ل",1,0],["له هممٌ تعالى كلّ حينٍ","يفوقُ بها ذرى النجم العليِّ",58,"ي",1,0],["له همة تعلو صعوداً فينثني","لا صغرها شمّ الشواهق ينحط",59,"ط",1,0],["لَهُ هِممٌ أَعيَت فُحُولَ زَمانِهِ","وما يَذكُرُ المِعشارَ مَن هوَ مادِحُ",60,"ح",1,0],["لَهُ هِمَّةٌ فَوقَ السِّماكِ مَحلُّها","لها آصفٌ حقّاً مُضافٌ ومُنتَمي",61,"م",2,0],["له همة تعلو السماكين رفعةً","وتأنف أن ترضى المجرة موضعا",62,"ع",2,0],["له همة تسمو لجلب كرايم ال","مطايا وجمع الصافنات الصواهلِ",63,"ل",1,0],["له هيبة في الله تغنى وخشية","تذيب الحصى منها القلوب فواطرُ",64,"ر",1,0],["لَهُ هِمَمٌ لا مُنتَهى لِكِبارِها","وَهِمَّتُهُ الصُغرى أَجَلُّ مِنَ الدَهرِ",65,"ر",1,1],["لَهُ هِمَّةٌ دانَ ابنُ ذِي يَزَنٍ لَها","وَعزمٌ كَحدِّ الهِندُوانِيَّةِ البُترِ",66,"ر",1,0],["له همة يدنو لها كل نازح","وينأى بها داني الخطوب وينزح",67,"ح",1,0],["له همم يسمو بهن محاولاً","أقامته ما بين نسر وفرقد",68,"د",1,0],["له همة تتعالى به","فهمتها في عبور العبورِ",69,"ر",1,0],["لَهُ هَامَةُ العَلْيَاءِ وَالسَّعْدِ وَالذُّرَى","وَكَفُّ النَّدَى وَالزَّنْدُ وَاليَدُ وَالإبْطُ",70,"ط",1,0],["لَهُ هِمَّةٌ فَاقَتْ عَلَى كُلّ هِمَّةٍ","بِدَوْلَةِ مُلْكٍ أخْجَلَتْ كُلَّ دَوْلَةِ",71,"ه",1,0],["لَهُ هِمةٌ عَمَّ البَرِيَّةَ عَدْلُهَا","فَأضْحَى لَدَيْهِ آمِناً كُل رَاهِبِ",72,"ب",1,0],["له همة بلغت للسها","وصورته عن ظهور الجياد",73,"د",1,0],["لَهُ هَفواتٌ في الرَخاءِ يشوبها","بنصرة يوم لا توارى كَواكبه",74,"ب",2,0],["له همة للحادثات مكيدة","وعزمٌ إذا أبداه للصخر أفصلا",75,"ل",2,0],["له همّةٌ علياءُ في كل مشكلٍ","وعزم إذا ما احتد يزري الصوارما",76,"م",2,0],["له هنداسة التفصيل قرت","وقد طاعت له كل الاطاعَهْ",77,"ع",2,0],["لهُ هِمَّةٌ لم أَلْقَ إِلاّ مُصَدِّقاً","لِقَوْليَ ما أَدْنَى النُّجومَ وأَعْلاها",78,"ا",3,0],["له همة تعلوا السماك وقدره","عظيم على الرحمن فاصغ إلى الذكر",79,"ر",1,0],["له همَّةٌ لما حَسَبْتُ عُلُوَّها","حَسِبتُ الثُّريَّا في الثرى أبداً تسري",80,"ر",2,0],["له هيف الغصن الرطيب ولينه","ولي من تجنيه بكاء حمامه",81,"م",2,0],["له همامةُ نفس لا تُطاولها","همامةٌ تدرك الأفلاك إن رغبَا",82,"ب",2,0],["لهُ هِمَّةٌ عليا وفَخرٌ وسُؤدَدٌ","بهِم قَد زَكَت أخلاقُهُ وَسَجاياهُ",83,"ا",2,0],["له هِمَّةٌ تعلو على كل همةٍ","كذا شرفٌ ما إن يُطاوِلُهُ الغفرُ",84,"ر",1,0],["لهُ همةٌ من دونها السيف ماضياً","مضارعه في الدهر ناهٍ وآمرُ",85,"ر",1,0],["له هذا فقل لي يا نديمي","وأوضح ما تحب لمن تحب",86,"ب",1,0],["له همُّ محزونٍ إذا ما طردته","يزول ولكن دانقٌ منه يفضل",87,"ل",1,0],["له همة لم يلف بعد كبعدها","ما أرضها إلا سماء الكواكب",88,"ب",1,0],["له هبَّةٌ لا من أنَاةٍ ولا وَنىً","إلى حيثُ لم يَسْبِقْهُ عُذْرٌ ولا عَذْل",89,"ل",1,0],["لهُ هِمَمٌ في البأسِ والجودِ والندى","لها فوق أثْباجِ النجوم قباب",90,"ب",1,0],["له هزة في الجود معتضدية","تهز إلى تشتيت شمل الدراهم",91,"م",1,0],["له هيبةٌ أزدريةٌ تتركُ الحَصا","بدار الأعادي بعد قسوتهِ عِهْنا",92,"ن",2,0],["له هيبةٌ عندَ القياسِ تَعُدُّها","أعاديه ضرباً من ل