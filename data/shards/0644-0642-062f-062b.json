{"poems":[[53,"أصبت بعيني من أصاب بعينه","https://www.aldiwan.net/poem29873.html","الطويل"],[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[33,"نهاري نهار الناس حتى إذا بدا","https://www.aldiwan.net/poem25887.html","الطويل"],[3,"لا تَقْتضِ الدَّيْنَ إلاّ بالقَنا الذُّبُلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10736&r=&rc=90",""],[134,"لواؤك منصور وسعدك غالب","https://www.aldiwan.net/poem4251.html","الطويل"],[183,"لقد ثوى نعمة الفياض في جدث","https://www.aldiwan.net/poem67007.html","البسيط"],[240,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[453,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"]],"verses":[["لَقَد ثَأَرَت عَيني بِقَلبي وَلَم يَكُن","حَلالاً لَهُ مِن مُهجَتي ما اِستَحَلَّه",0,"ل",2,0],["لَقَد ثَناني النُهى عَنها وَأَدَّبَني","فَلَستُ أَبكي عَلى رَسمٍ وَلا طَلَلِ",1,"ل",1,0],["لقد ثنى من يدَي صبري عزائمه","قلبٌ بطرفك أمسى وهو مسحور",2,"ر",1,0],["لَقَد ثَبَتَت في القَلبِ مِنكِ مَحَبَّةٌ","كَما ثَبَتَت في الراحَتَينِ الأَصابِعُ",3,"ع",1,0],["لقد ثناني النهى عنها وأدبي","فلسْتُ أبكي على رسْمٍ ولا طَلل",4,"ل",1,0],["لقد ثكلت أمُّ المناوي وغرَّرَت","مبادئُ من أحوالهِ وعواقِبُ",5,"ب",1,0],["لَقَد ثَوى نِعمةُ الفياضُ في جَدَثٍ","عَلى ثَراهُ أَفاضَ اللَهُ رحمتَهُ",6,"ه",1,1],["لقد ثكلته أمه من مؤمر","يسير به نحو المهالك منصب",7,"ب",1,0],["لقد ثبتوا حُمساً وكلُّ مُجاهِدٍ","لِعشرةِ أعلاجٍ فأبلى وأعذَرا",8,"ر",2,0],["لقد ثَوَّبَ الداعي لربوة جِلَقٍ","بقلبٍ على تلك الرياض مُرَنَّقِ",9,"ق",1,1]]}