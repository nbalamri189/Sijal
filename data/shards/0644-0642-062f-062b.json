{"poems":[[55,"أصبت بعيني من أصاب بعينه","https://www.aldiwan.net/poem29873.html","الطويل"],[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[74,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[35,"نهاري نهار الناس حتى إذا بدا","https://www.aldiwan.net/poem25887.html","الطويل"],[3,"لا تَقْتضِ الدَّيْنَ إلاّ بالقَنا الذُّبُلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10736&r=&rc=90",""],[137,"لواؤك منصور وسعدك غالب","https://www.aldiwan.net/poem4251.html","الطويل"],[186,"لقد ثوى نعمة الفياض في جدث","https://www.aldiwan.net/poem67007.html","البسيط"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[457,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137345",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145796","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120041","الوافر"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131925","الوافر"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78178","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108794","الطويل"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101795","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106837","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93686","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123924","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86535","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94466","الوافر"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[4680,"خذينا","https://www.poetsgate.com/ViewPoem.aspx?id=185892",""],[4858,"حنين إلى الأهل والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=138206",""],[5216,"مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187649",""],[5397,"أغاظ الدهر قدرك أن يسودا","https://www.poetsgate.com/ViewPoem.aspx?id=157926",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""]],"verses":[["لَقَد ثَأَرَت عَيني بِقَلبي وَلَم يَكُن","حَلالاً لَهُ مِن مُهجَتي ما اِستَحَلَّه",0,"ل",2,0],["لَقَد ثَناني النُهى عَنها وَأَدَّبَني","فَلَستُ أَبكي عَلى رَسمٍ وَلا طَلَلِ",1,"ل",1,0],["لقد ثنى من يدَي صبري عزائمه","قلبٌ بطرفك أمسى وهو مسحور",2,"ر",1,0],["لَقَد ثَبَتَت في القَلبِ مِنكِ مَحَبَّةٌ","كَما ثَبَتَت في الراحَتَينِ الأَصابِعُ",3,"ع",1,0],["لقد ثناني النهى عنها وأدبي","فلسْتُ أبكي على رسْمٍ ولا طَلل",4,"ل",1,0],["لقد ثكلت أمُّ المناوي وغرَّرَت","مبادئُ من أحوالهِ وعواقِبُ",5,"ب",1,0],["لَقَد ثَوى نِعمةُ الفياضُ في جَدَثٍ","عَلى ثَراهُ أَفاضَ اللَهُ رحمتَهُ",6,"ه",1,1],["لقد ثكلته أمه من مؤمر","يسير به نحو المهالك منصب",7,"ب",1,0],["لقد ثبتوا حُمساً وكلُّ مُجاهِدٍ","لِعشرةِ أعلاجٍ فأبلى وأعذَرا",8,"ر",2,0],["لقد ثَوَّبَ الداعي لربوة جِلَقٍ","بقلبٍ على تلك الرياض مُرَنَّقِ",9,"ق",1,1],["لقد ثكلتهُ الكنانةُ فذاً","كما ثكلتهُ جميعُ النَحَل",10,"ل",1,0],["لقدْ ثقبُوا جَفننا إنهُ","يُلاحِقُهُمْ حَيثما يَذهَبُونْ",11,"ن",1,0],["لقد ثبتت بعد لك للرعايا","قلوب كن خوفا مستطاره",12,"ر",2,0],["لقد ثبتتْ مروءتُه علينا","كمثل النقشِ في الحجر الصليب",13,"ب",1,0],["لَقَد ثلم الإِسلام بَعدك ثَلمةً","مَدى الدَهر وَالأَعوام لَيسَ لَها سَدُّ",14,"د",1,0],["لقد ثقَّل البين المفرق بيننا","عليَّ فما أدهى فراقك يا تقلا",15,"ل",2,0],["لقد ثبتوا لكن جبالا رواسيا","وطارت قلوب للعدى وجماجم",16,"م",1,0],["لقد ثكلوا الآمال هل عجبٌ إذا","غدوا ولهم حزناً وجوهُ ثكالى",17,"ل",2,0],["لَقَد ثَبتت أَقدامهم في مَزالق","عَلى مثلها لا يُثبت الأَعصم الوَعل",18,"ل",1,0],["لقد ثبتوا في موقف هان عنده","زوال الجبال الراسيات المواكث",19,"ث",1,0],["لقد ثبتت للترك في عصبيةٍ","يقل لها في العالمين مثال",20,"ل",1,0],["لَقَد ثملت بنشوتها الحميّا","فأَنى ذو الرشاد أخو الحميّه",21,"ي",2,0],["لَقَد ثكِلَت أمّ القُرى ولكَعبةٍ","مدامِعُ في الميزابِ تسكُبُ في الحِجرِ",22,"ر",1,0],["لقد ثمن السبع الطباق صنيعه","قديما وفي ذا العام قد زادها أخرى",23,"ر",2,0],["لقد ثقُل النوى وقسا علينا","فجودي بالوصال وأسعدينا",24,"ن",2,0],["لقد ثار بي شوقٌ إليكم ، أحبتي","كما ثار في جوف العطاش غليلُ",25,"ل",1,0],["لقد ثبَتَ الغرامُ بقلبِ قلبي","كما ثبتتْ ببطنِ الكفِّ خَمْسُ",26,"س",1,0],["لقد ثكلت بغيبتك الأماني","إمام هدى وضيعت العميدا",27,"د",2,0],["لقد ثبت الإسلام فيك موطداً","ورزؤك أوهى جنبه فتضعضعا",28,"ع",2,0],["لقدْ ثأرنا وألقينا السّوادَ وإنْ","مرَّتْ على الليثِ أيّامٌ وأعوامُ",29,"م",1,0],["لقد ثارَ اليراعُ وكمْ لديهِ","تزاحَمَتِ الخواطرُ والسطورُ",30,"ر",1,0],["لقد ثارَ اليراعُ وربَّ حرفٍ","له وقعُ الرصاصةِ لو يثورُ",30,"ر",1,0]]}