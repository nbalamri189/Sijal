{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[63,"مضى زمن كنت الذنابى لأهله","https://www.aldiwan.net/poem45842.html","الطويل"],[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[34,"كأنك لم تغنه إذ لم تلاقها","https://www.aldiwan.net/poem4902.html","الطويل"],[27,"أتنفي قروما من معد لغيرهم","https://www.aldiwan.net/poem5754.html","الطويل"],[27,"أجد اليوم جيرتك ارتحالا","https://www.aldiwan.net/poem5947.html","الوافر"],[27,"فلا خوف عليك ولن تراعي","https://www.aldiwan.net/poem5978.html","الوافر"],[72,"أقسمت ما رزءك مما يهون","https://www.aldiwan.net/poem20193.html","السريع"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[70,"على الطائر الميمون يا خير قادم","https://www.aldiwan.net/poem42693.html","الطويل"],[99,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[61,"خليلي إن الغيث أوله قطر","https://www.aldiwan.net/poem51606.html","الطويل"],[87,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[33,"لا أيها البيت الذي لا أزوره","https://www.aldiwan.net/poem26020.html","الطويل"],[48,"غدوت على اللذات منهتك الستر","https://www.aldiwan.net/poem63280.html","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29869","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9498","المتقارب"],[126,"يتم سروري إن رأيتك مقبلا","https://www.aldiwan.net/poem50541.html","الطويل"],[129,"إليك ابن جدعان أعملتها","https://www.aldiwan.net/poem24173.html","المتقارب"],[141,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[141,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[148,"ألا فاخش سهم الموت عن كل مرصد","https://www.aldiwan.net/poem68588.html","الطويل"],[148,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[148,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[158,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[158,"إلى أى باب غير بابك أقرع","https://www.aldiwan.net/poem59097.html","الطويل"],[167,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[167,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[233,"أحق دار وأولى أن نهنئها","https://www.aldiwan.net/poem31632.html","البسيط"],[233,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[268,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[273,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[280,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[318,"شرحت صدر أخاكا","https://www.aldiwan.net/poem61652.html","المجتث"],[318,"خد الحبيب زانه","https://www.aldiwan.net/poem61809.html","مجزوء الرجز"],[346,"رأت حالي وقد حالت","https://www.aldiwan.net/poem19923.html","الهزج"],[347,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[374,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[377,"تغيب در الزهر في صدف الأفق","https://www.aldiwan.net/poem48822.html","الطويل"],[388,"عباد الله جيناكم قصدنا طلبناكم","https://www.aldiwan.net/poem54504.html","عموديه"],[388,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[388,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[402,"إذا لم يفتني عقل ودين","https://www.aldiwan.net/poem49633.html","المتقارب"],[413,"أتانا عنك مولانا البشير","https://www.aldiwan.net/poem53895.html","الوافر"],[413,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[429,"أقول رياض إذ ترصعها زهرا","https://www.aldiwan.net/poem12435.html","الطويل"],[436,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[436,"طاعت لك الأحرار باستعبادها","https://www.aldiwan.net/poem34804.html","الكامل"],[436,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[436,"محلك بالدنيا وبالدين آهل","https://www.aldiwan.net/poem34914.html","الطويل"],[438,"تروح المنايا في البرايا وتغتدي","https://www.aldiwan.net/poem14444.html","الطويل"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[456,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[459,"ليهن التقى والدين كونك سالما","https://www.aldiwan.net/poem15155.html","الطويل"],[459,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[459,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[462,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[462,"كذا فليد من نازع الخضر الندى","https://www.aldiwan.net/poem3221.html","عموديه"],[462,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[462,"يا غائباً لم تغب عني مكارمه","https://www.aldiwan.net/poem3315.html","عموديه"],[462,"لكم من سقامي بالهوى شاهد عدل","https://www.aldiwan.net/poem3604.html","عموديه"],[511,"أأيام هذا الدهر كم تعنفين بي","https://www.aldiwan.net/poem67760.html","الطويل"],[527,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[549,"حذرتكم وكم لله عندي","https://www.aldiwan.net/poem47774.html","الوافر"],[562,"اهجر معنى القلب عندك جائز","https://www.aldiwan.net/poem856.html",""],[583,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["فَلَآخُذَنَّ مِنَ الزَمانِ غُلُبَّةً","حَقّي وَأَمنَعُ ما أَشاءُ وَأَبذُلُ",0,"ل",1,0],["فَلا خَطَرٌ يا بنَ اللِّئامِ لِدَولَةٍ","وَأَنتَ عَلى رَغمِ المَعالي خَطيرُها",1,"ر",3,0],["فلا خَيَّمَتْ إلا لدَيكُمْ مَدائِحي","ولا ساقَها إلا إلَيْكُمْ حُداتُها",2,"ت",3,0],["فلا خَيْرُهُ يُطْوى ولا الشّرُّ يُتَّقَى","ولا المُعتَفِي يُجْفَى ولا العِرضُ يُمْغَثُ",3,"ث",1,0],["فَلا خَيرَ في الدُنيا إِذا لَم تُواتِنا","لُبَينى وَلَم يَجمَع لَنا الشَملَ جامِعُ",4,"ع",1,0],["فَلا خَيرَ في تَركِ النُبُوَّةِ وَالهُدى","وَلا خَيرَ في دَعوى يُكَذَّبُ زورُها",5,"ر",3,0],["فَلا خَيلٌ لَكُم صَبَرَت لِخَيلٍ","وَلا أَغنَت رِجالُكُمُ رِجالا",6,"ل",2,0],["فَلا خَوفٌ عَليكَ وَلَن تُراعي","بِعُقوَةِ مازِنٍ وَبَني هِلالِ",7,"ل",1,1],["فلا خبا شخصك عن معشرٍ","إلى العلى بالنجمِ هم يهتدون",8,"ن",1,0],["فلا خلَّةٌ منها أضرَّتْ بخلَّةٍ","على أنه في كُلّها متقسَّمُ",9,"م",1,0],["فَلا خَيَّبَ الرَحمَنُ سَعيَكَ إِنَّهُ","لَكَالسَعيِ لِلراجينَ حَطَّ المَآثِمِ",10,"م",1,0],["فلا خيول بني حمدان راقصةٌ","زهواً... ولا المتنبي مالئٌ حلبا",11,"ب",2,0],["فلا خَيْرَ في القُربى إذا ما مَلْلتَني","ولا خَيْرَ في نُعمى يُقارِبُها كُفرُ",12,"ر",1,0],["فَلا خَيْرَ فِي الدُّنْيَا إِذَا الْمَرْءُ لَمْ يَعِشْ","مَهِيباً تَرَاهُ الْعَيْنُ كَالنَّارِ فِي دَغْنِ",13,"ن",1,0],["فَلا خَيرَ في الدُنيا إِذا أَنتَ لَم تَزُر","حَبيباً وَلَم يَطرَب إِلَيكَ حَبيبُ",14,"ب",1,0],["فَلا خَيرَ في قَومٍ تَدورُ عَلَيهِمُ","كُؤوسُ المَنايا بِالمُثَقَّفَةِ السُمرِ",15,"ر",1,0],["فَلا خَيْرَ في مَنْ لا يَلينُ لِذِكْرِهِ","جِماحُ القَوافي حينَ يُمْدَحُ أَوْ يُرْثَى",16,"ث",2,0],["فَلا خَيرَ فيهِم لِشُربِ النَبيذِ","وَدَعهُم يَناموا مَعَ النُوَّمِ",17,"م",1,0],["فلا خيرَ في مالٍ إذا لم يكن حجاً","ولا العقل إن هُمْ عن جنابك مالُوا",18,"ل",3,0],["فَلا خَفضَ حَتّى تُلاقي اِمرَأً","جَوادَ الرِضا حَليمَ الغَضَب",19,"ب",1,0],["فَلا خَلَتِ الأَيّامُ مِنها مَحاسِناً","أَشَدَّ عَلى الأَحداقِ مِن نَومِها فَقدا",20,"د",2,0],["فَلا خَبا ضَوءُ نارٍ يَستَضيءُ بِها","مَنِ اِستَجارَ وَيَصلاها مَنِ اِجتَرَما",21,"م",2,0],["فَلا خَوفَ مِن فَصمٍ لِخَصمٍ وَلا صَدعِ","فَيا حُسنَ دَهرٍ قَبلَ مُبعَثِهِ قَبُح",22,"ح",1,0],["فَلا خَوفَ مِن حَيفٍ وَلا عضَّ مِن عَظِّ","قَمَعنا العِدا لَمّا أَوَينا بِظِلِّها",23,"ه",2,0],["فَلا خَيرَ إِلّا في المَسير تِباعِهِ","سَعادَتُنا مَشروطَةٌ باتباعِهِ",24,"ه",1,0],["فلا خفرَتْ ذمامَكم الليالي","ولا ضامت لك الأيامُ جارا",25,"ر",2,0],["فلا خير في رزق سواك يسوقه","ولو أنه من خطة الأرض أوسع",26,"ع",1,0],["فَلا خَلَت مِنكَ آفاقُ البِلادِ وَلا","خَلَوتَ مِن نِعَمٍ تَأتي عَلى نِعَمِ",27,"م",1,0],["فَلا خَلَت مِنكَ الرَعايا وَلا","زِلتَ لِمُرفَضِّ المَعالي نِظام",28,"م",1,0],["فَلا خَلَت مِنكُمُ أَوطانُها أَبَداً","فَإِنَّها صُوَرٌ أَنتُم مَعانيها",29,"ي",3,0],["فَلا خَلا الدينُ مِن والٍ يُعِزُّ بِهِ","مِنكُم إِذا باتَ مَظلوماً وَيَنتَصِرُ",30,"ر",1,0],["فلا خيرَ في العيشِ الذي دونُ مَطمعي","خُلِقتُ ليُغريني البعيدُ بأبعدا",31,"د",2,0],["فَلا خَائِفٌ إِلا بِمَثْوَاك آمِنٌ","وَلا آيِس إلا لجَدْواكَ آمِلُ",32,"ل",1,0],["فَلا خَلَت مَنابِرُ الإِسلامِ مِن","ها ما دَعا اللَهُ حَنيفٌ وَنَسَك",33,"ك",1,0],["فَلا خَليلٌ أَرجى","وَلا حَبيباً سِواكا",34,"ك",2,0],["فَلا خَلاصَ لي إِذا","لا وَالضُحى وَاللَيلِ",35,"ل",1,0],["فَلا خَيْرٌ ولا مَيْرٌ","ولا أَيرٌ فَذا مَوْتُ",36,"ت",1,0],["فَلا خَيرَ في عِزٍّ إِذا كانَ مُختَبىً","بِذُلٍّ وَأَيُّ العِزِّ يَجلِبُهُ السِرُّ",37,"ر",1,0],["فلا خير في حظٍّ يكون مؤجَّلاً","كتأجيل عُمرٍ آن منه انقضاؤه",38,"ا",3,0],["فَلا خَير في سُكر تَليهِ أَفاقَةٌ","وَلا بَينَ بَعض الصَحو وَالمَوت مِن فَرق",39,"ق",1,0],["فلا خيبتمو ظني فحاشاكم وحاشاكم","سعدنا إذ أتيناكم",40,"م",1,0],["فلا خير في النجوى مع الناس","سوى أمر بمعروف أو إنكار",41,"ر",1,0],["فلا خيبت يا مولاي ظني","فإني قلت قول ذي العراء",42,"ا",2,0],["فلا خلقَ أسوأُ مِنِّي اختِياراً","إذا ما أسيت لشَيءٍ يفوتُ",43,"ت",1,0],["فلا خبرٌ ليوصله إليكم","على عَجَلٍ ولا أحدٌ يسير",44,"ر",1,0],["فلا خير في هذي الحياة فإنها","عقاب وما لا تشتهيه عقاب",45,"ب",1,0],["فَلا خَيْرَ لليَعْقُوبِ منَّا فإِنَّهُ","عِقابٌ ولا الكُرْكِيِّ من حيثُ ماكَرَّا",46,"ر",2,0],["فلا خَانَها أمَلُ المُسْتَفِيدِ","وَأُبْقِيتَ فِي عُمُرٍ مُسْتفادِ",47,"د",1,0],["فلأَخْمَصَيْكَ اليومَ حُرُّ وُجُوهِها","ولوَطْءِ خيلِكَ أَمْسِ حُرُّ بِلادِها",48,"د",3,0],["فلا خُذِلَ الدِّينُ الَّذِي أَنت سَيْفُهُ","ولا أَوْحَشَ المُلْكُ الَّذِي أَنت حَاجِبُهْ",49,"ب",2,0],["فَلا خَذْلَ الرحمنُ مَنْ أَنت ناصرٌ","ولا نصر الرحمنُ من أنت خاذلُ",50,"ل",1,0],["فلا خير في من عاش فرداً بنفسه","وإِن كان ذا صنع من الفضل مفرد",51,"د",1,0],["فلا خَلتْ أبداً منها مواضعُها","من السماء ولا منه مواضعُهُ",52,"ع",2,0],["فلا خلا منه ربعُ الفضلِ يَعمُرُه","بالمال يُقسَمُ والأقوالِ تُدَّخَرُ",53,"ر",1,0],["فلا خَلتِ الأيام منك ولا خَلا","من القول في أوصاف مجدك حامدُ",54,"د",1,0],["فلا خطْب إِلا وهو بالرأي كاسِرٌ","ولا فقْرَ إِلاَّ وهو بالجودِ جابِرُ",55,"ر",1,0],["فلا خطْبَ إِلا والرويَّةُ كاشفٌ","ولا حَرْب إلاَّ والمُهنَّدُ قاهِرُ",56,"ر",1,0],["فلا خاب ظني في العقيق وأهله","كما لم يخب في الظافر الملك سائل",57,"ل",1,0],["فلا خذلته المشرفية غضة","من الماء خضراً والأنابيب ذبلا",58,"ل",2,0],["فلا خير في ناس مياه وجوههم","كما شين ماءُ الحوضِ كدّر بالجدح",59,"ح",1,0],["فلا خلت منك دنيا أنت مالكها","فإنما الملك عقدٌ أنت ناظمهُ",60,"م",2,0],["فلا خير فيمن ليس يرضيك غيبهُ","ولا في بلادٍ جارُ سكَّانها المحل",61,"ل",1,0],["فلا خلف إلا بعد توكيد موعدٍ","ولا وعد إلا عن صفاءٍ من الود",62,"د",1,0],["فلا خَيْرَ في عِلْمٍ يُضِلُّ عَنِ الْهُدَى","ويَجْذِبُ أَهْلِيهِ إلى الْعَصَبِيَّةِ",63,"ه",1,0],["فَلا خَصِبَتْ بلادُكُمُ بجَدْبٍ","ولا جيدَتْ بأنواءٍ غِزارِ",64,"ر",1,0],["فلا خير في خل خلي من الوفا","ولا في هوى فيه أذى وتعارز",65,"ز",1,0],["فلا خير في نظم هذا القريض","ولا في تغزُّله والمِدَحْ",66,"ح",1,0]]}