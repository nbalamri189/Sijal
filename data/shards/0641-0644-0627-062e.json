i.ae/diwan/poem/147241","الطويل"],[4320,"","https://poetry.dctabudhabi.ae/diwan/poem/133905","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58138","الطويل"],[4623,"","https://poetry.dctabudhabi.ae/diwan/poem/140151",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147160","البسيط"],[4726,"أيا رحمة الدارين والسيد الذي","https://www.poetsgate.com/ViewPoem.aspx?id=146651",""],[1703,"لك الله من أمّةٍ هاويه","https://www.poetsgate.com/ViewPoem.aspx?id=49929",""],[5050,"هو المجد فاطلبه وإن عز طالبه","https://www.poetsgate.com/ViewPoem.aspx?id=38193",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5413,"سيبقى المعلى","https://www.poetsgate.com/ViewPoem.aspx?id=200569",""],[5550,"رحلْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=214912",""],[5616,"آسام","https://www.poetsgate.com/ViewPoem.aspx?id=204837",""],[5660,"شَرِبتُ العِشقَ في الأَرحامِ صَفواً","https://www.poetsgate.com/ViewPoem.aspx?id=23799",""],[5674,"متى توافي","https://www.poetsgate.com/ViewPoem.aspx?id=213837",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5725,"ونادبة قتلي","https://www.poetsgate.com/ViewPoem.aspx?id=196931",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[5759,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213914",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5817,"حماة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=199671",""],[5923,"سَأَم الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=162750",""],[5943,"عبير الزهر","https://www.poetsgate.com/ViewPoem.aspx?id=35846",""],[1920,"ربيع لا يتاجر بالسلاح","https://www.poetsgate.com/ViewPoem.aspx?id=191410",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[6070,"رَأيتُ العُمرَتبكيهِ الورودُ*","https://www.poetsgate.com/ViewPoem.aspx?id=189502",""],[6152,"حياة القلب في أنس وقرب","https://www.poetsgate.com/ViewPoem.aspx?id=204739",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[6277,"الحنين الى الجزيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64461&r=&rc=24",""],[2220,"إذا كانَ عينُ الحبِّ ما ينتجُ الحبُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11179&r=&rc=53",""]],"verses":[["فلا خلت الأزمان من نائحٍ لهُ","ولا إنفكت الدنيا لذلك مأتما",0,"م",2,0],["فَلَآخُذَنَّ مِنَ الزَمانِ غُلُبَّةً","حَقّي وَأَمنَعُ ما أَشاءُ وَأَبذُلُ",1,"ل",1,0],["فَلا خَطَرٌ يا بنَ اللِّئامِ لِدَولَةٍ","وَأَنتَ عَلى رَغمِ المَعالي خَطيرُها",2,"ر",3,0],["فلا خَيَّمَتْ إلا لدَيكُمْ مَدائِحي","ولا ساقَها إلا إلَيْكُمْ حُداتُها",3,"ت",3,0],["فلا خَيْرُهُ يُطْوى ولا الشّرُّ يُتَّقَى","ولا المُعتَفِي يُجْفَى ولا العِرضُ يُمْغَثُ",4,"ث",1,0],["فَلا خَيرَ في الدُنيا إِذا لَم تُواتِنا","لُبَينى وَلَم يَجمَع لَنا الشَملَ جامِعُ",5,"ع",1,0],["فَلا خَيرَ في تَركِ النُبُوَّةِ وَالهُدى","وَلا خَيرَ في دَعوى يُكَذَّبُ زورُها",6,"ر",3,0],["فَلا خَيلٌ لَكُم صَبَرَت لِخَيلٍ","وَلا أَغنَت رِجالُكُمُ رِجالا",7,"ل",2,0],["فَلا خَوفٌ عَليكَ وَلَن تُراعي","بِعُقوَةِ مازِنٍ وَبَني هِلالِ",8,"ل",1,1],["فلا خبا شخصك عن معشرٍ","إلى العلى بالنجمِ هم يهتدون",9,"ن",1,0],["فلا خلَّةٌ منها أضرَّتْ بخلَّةٍ","على أنه في كُلّها متقسَّمُ",10,"م",1,0],["فَلا خَيَّبَ الرَحمَنُ سَعيَكَ إِنَّهُ","لَكَالسَعيِ لِلراجينَ حَطَّ المَآثِمِ",11,"م",1,0],["فلا خيول بني حمدان راقصةٌ","زهواً... ولا المتنبي مالئٌ حلبا",12,"ب",2,0],["فلا خَيْرَ في القُربى إذا ما مَلْلتَني","ولا خَيْرَ في نُعمى يُقارِبُها كُفرُ",13,"ر",1,0],["فَلا خَيْرَ فِي الدُّنْيَا إِذَا الْمَرْءُ لَمْ يَعِشْ","مَهِيباً تَرَاهُ الْعَيْنُ كَالنَّارِ فِي دَغْنِ",14,"ن",1,0],["فَلا خَيرَ في الدُنيا إِذا أَنتَ لَم تَزُر","حَبيباً وَلَم يَطرَب إِلَيكَ حَبيبُ",15,"ب",1,0],["فَلا خَيرَ في قَومٍ تَدورُ عَلَيهِمُ","كُؤوسُ المَنايا بِالمُثَقَّفَةِ السُمرِ",16,"ر",1,0],["فَلا خَيْرَ في مَنْ لا يَلينُ لِذِكْرِهِ","جِماحُ القَوافي حينَ يُمْدَحُ أَوْ يُرْثَى",17,"ث",2,0],["فَلا خَيرَ فيهِم لِشُربِ النَبيذِ","وَدَعهُم يَناموا مَعَ النُوَّمِ",18,"م",1,0],["فلا خيرَ في مالٍ إذا لم يكن حجاً","ولا العقل إن هُمْ عن جنابك مالُوا",19,"ل",3,0],["فَلا خَفضَ حَتّى تُلاقي اِمرَأً","جَوادَ الرِضا حَليمَ الغَضَب",20,"ب",1,0],["فَلا خَلَتِ الأَيّامُ مِنها مَحاسِناً","أَشَدَّ عَلى الأَحداقِ مِن نَومِها فَقدا",21,"د",2,0],["فَلا خَبا ضَوءُ نارٍ يَستَضيءُ بِها","مَنِ اِستَجارَ وَيَصلاها مَنِ اِجتَرَما",22,"م",2,0],["فَلا خَوفَ مِن فَصمٍ لِخَصمٍ وَلا صَدعِ","فَيا حُسنَ دَهرٍ قَبلَ مُبعَثِهِ قَبُح",23,"ح",1,0],["فَلا خَوفَ مِن حَيفٍ وَلا عضَّ مِن عَظِّ","قَمَعنا العِدا لَمّا أَوَينا بِظِلِّها",24,"ه",2,0],["فَلا خَيرَ إِلّا في المَسير تِباعِهِ","سَعادَتُنا مَشروطَةٌ باتباعِهِ",25,"ه",1,0],["فلا خفرَتْ ذمامَكم الليالي","ولا ضامت لك الأيامُ جارا",26,"ر",2,0],["فلا خير في رزق سواك يسوقه","ولو أنه من خطة الأرض أوسع",27,"ع",1,0],["فَلا خَلَت مِنكَ آفاقُ البِلادِ وَلا","خَلَوتَ مِن نِعَمٍ تَأتي عَلى نِعَمِ",28,"م",1,0],["فَلا خَلَت مِنكَ الرَعايا وَلا","زِلتَ لِمُرفَضِّ المَعالي نِظام",29,"م",1,0],["فَلا خَلَت مِنكُمُ أَوطانُها أَبَداً","فَإِنَّها صُوَرٌ أَنتُم مَعانيها",30,"ي",3,0],["فَلا خَلا الدينُ مِن والٍ يُعِزُّ بِهِ","مِنكُم إِذا باتَ مَظلوماً وَيَنتَصِرُ",31,"ر",1,0],["فلا خيرَ في العيشِ الذي دونُ مَطمعي","خُلِقتُ ليُغريني البعيدُ بأبعدا",32,"د",2,0],["فَلا خَائِفٌ إِلا بِمَثْوَاك آمِنٌ","وَلا آيِس إلا لجَدْواكَ آمِلُ",33,"ل",1,0],["فَلا خَلَت مَنابِرُ الإِسلامِ مِن","ها ما دَعا اللَهُ حَنيفٌ وَنَسَك",34,"ك",1,0],["فَلا خَليلٌ أَرجى","وَلا حَبيباً سِواكا",35,"ك",2,0],["فَلا خَلاصَ لي إِذا","لا وَالضُحى وَاللَيلِ",36,"ل",1,0],["فَلا خَيْرٌ ولا مَيْرٌ","ولا أَيرٌ فَذا مَوْتُ",37,"ت",1,0],["فَلا خَيرَ في عِزٍّ إِذا كانَ مُختَبىً","بِذُلٍّ وَأَيُّ العِزِّ يَجلِبُهُ السِرُّ",38,"ر",1,0],["فلا خير في حظٍّ يكون مؤجَّلاً","كتأجيل عُمرٍ آن منه انقضاؤه",39,"ا",3,0],["فَلا خَير في سُكر تَليهِ أَفاقَةٌ","وَلا بَينَ بَعض الصَحو وَالمَوت مِن فَرق",40,"ق",1,0],["فلا خيبتمو ظني فحاشاكم وحاشاكم","سعدنا إذ أتيناكم",41,"م",1,0],["فلا خير في النجوى مع الناس","سوى أمر بمعروف أو إنكار",42,"ر",1,0],["فلا خيبت يا مولاي ظني","فإني قلت قول ذي العراء",43,"ا",2,0],["فلا خلقَ أسوأُ مِنِّي اختِياراً","إذا ما أسيت لشَيءٍ يفوتُ",44,"ت",1,0],["فلا خبرٌ ليوصله إليكم","على عَجَلٍ ولا أحدٌ يسير",45,"ر",1,0],["فلا خير في هذي الحياة فإنها","عقاب وما لا تشتهيه عقاب",46,"ب",1,0],["فَلا خَيْرَ لليَعْقُوبِ منَّا فإِنَّهُ","عِقابٌ ولا الكُرْكِيِّ من حيثُ ماكَرَّا",47,"ر",2,0],["فلا خَانَها أمَلُ المُسْتَفِيدِ","وَأُبْقِيتَ فِي عُمُرٍ مُسْتفادِ",48,"د",1,0],["فلأَخْمَصَيْكَ اليومَ حُرُّ وُجُوهِها","ولوَطْءِ خيلِكَ أَمْسِ حُرُّ بِلادِها",49,"د",3,0],["فلا خُذِلَ الدِّينُ الَّذِي أَنت سَيْفُهُ","ولا أَوْحَشَ المُلْكُ الَّذِي أَنت حَاجِبُهْ",50,"ب",2,0],["فَلا خَذْلَ الرحمنُ مَنْ أَنت ناصرٌ","ولا نصر الرحمنُ من أنت خاذلُ",51,"ل",1,0],["فلا خير في من عاش فرداً بنفسه","وإِن كان ذا صنع من الفضل مفرد",52,"د",1,0],["فلا خَلتْ أبداً منها مواضعُها","من السماء ولا منه مواضعُهُ",53,"ع",2,0],["فلا خلا منه ربعُ الفضلِ يَعمُرُه","بالمال يُقسَمُ والأقوالِ تُدَّخَرُ",54,"ر",1,0],["فلا خَلتِ الأيام منك ولا خَلا","من القول في أوصاف مجدك حامدُ",55,"د",1,0],["فلا خطْب إِلا وهو بالرأي كاسِرٌ","ولا فقْرَ إِلاَّ وهو بالجودِ جابِرُ",56,"ر",1,0],["فلا خطْبَ إِلا والرويَّةُ كاشفٌ","ولا حَرْب إلاَّ والمُهنَّدُ قاهِرُ",57,"ر",1,0],["فلا خاب ظني في العقيق وأهله","كما لم يخب في الظافر الملك سائل",58,"ل",1,0],["فلا خذلته المشرفية غضة","من الماء خضراً والأنابيب ذبلا",59,"ل",2,0],["فلا خير في ناس مياه وجوههم","كما شين ماءُ الحوضِ كدّر بالجدح",60,"ح",1,0],["فلا خلت منك دنيا أنت مالكها","فإنما الملك عقدٌ أنت ناظمهُ",61,"م",2,0],["فلا خير فيمن ليس يرضيك غيبهُ","ولا في بلادٍ جارُ سكَّانها المحل",62,"ل",1,0],["فلا خلف إلا بعد توكيد موعدٍ","ولا وعد إلا عن صفاءٍ من الود",63,"د",1,0],["فلا خَيْرَ في عِلْمٍ يُضِلُّ عَنِ الْهُدَى","ويَجْذِبُ أَهْلِيهِ إلى الْعَصَبِيَّةِ",64,"ه",1,0],["فَلا خَصِبَتْ بلادُكُمُ بجَدْبٍ","ولا جيدَتْ بأنواءٍ غِزارِ",65,"ر",1,0],["فلا خير في خل خلي من الوفا","ولا في هوى فيه أذى وتعارز",66,"ز",1,0],["فلا خير في نظم هذا القريض","ولا في تغزُّله والمِدَحْ",67,"ح",1,0],["فَلا خَيرَ في عيشَةٍ يُكتَسَى","بِها العِرضُ عاراً وَذَما وَذاما",68,"م",2,0],["فلا خُذِلَت سَراياكَ اللَّواتي","يفاجِئنَ العِدا إذ لا مَفاجا",69,"ج",2,0],["فلا خيرَ في حبٍّ يزولُ لعارضٍ","ولا في حبيبٍ لاثباتَ لودّهِ",70,"د",2,0],["فلا خير منكم ما ذرا ناب شائك","ولا خير إلّا أنها ناب شائك",71,"ك",1,0],["فلا خسر إلا دون خسر مسافر","إلى الموت من زاد التقى كفه صفر",72,"ر",1,0],["فلا خير في دارٍ بلا الغيث والحيا","كما قريْةٍ تخبث بطاين جنودها",73,"د",3,0],["فَلا خَطأ فيهِ نخطَّأُ منهُمُ","وَلا يُنكِرونَ القَولَ حينَ نَقولُ",74,"ل",1,0],["فَلاَ خَوْفَ مِنْ نَارٍ وَلاَ رُعْبَ مِنْ خَسْفِ","قَرِيبٌ مِنَ الْمَوْلَى وَلاَ بُعْدَ فِي مَدى",75,"د",2,0],["فلا خطأ نعدّ ولا صوابا","نعاتب حيث لا نرجو الجوابا",76,"ب",2,0],["فلا خير في عيش أبيت موسداً","به جمر جان ان توالت تولت",77,"ت",1,0],["فلا خير في ربع تظل نعاله","بأقدام أهل العي فوق العمائم",78,"م",1,0],["فلا خلاف إن الهموم به","تزول لا زال علاي الهممِ",79,"م",1,0],["فلأخذهم في كل قلب موقع","عند الصقال لها أكف قيون",80,"ن",1,0],["فلا خليل بدفع الجوع يرحمني","ولا كريم بلحم الضأن يسمح لي",81,"ل",2,0],["فَلا خُبْرُ الخَبيرِ بِمُسْتَكِفٍّ","غَوائِلَهُ ولا جَهْلُ الجَهولِ",82,"ل",1,0],["فلا خيرَ في الفضلِ الذي قد حويته","إذا الفضلُ لم يرفعكَ عن شكرِ ناقصِ",83,"ص",1,0],["فلا خير إلا من يديك ولا غنى","لك الملك تؤتي الفضل تولي الأياديا",84,"ي",2,0],["فلا خيرَ في اللذات إلا بأهلِها","ولا عيشَ إلا بالخيلِ المساعِدِ",85,"د",1,0],["فلا خاطَ الكرى عينيَّ شوقاً","لرؤية وجهكِ الحسنِ الرواءِ",86,"ا",2,0],["فلا خير في اليد لا تستجيب","إذا ما دعاها لسان جهور",87,"ر",1,0],["فلا خدَّ إلا فيه حدُّ مهنَّدٍ","ولا صدرَ إلا فيه صدر سنان",88,"ن",1,0],["فلا خير في دنيا طوى الموت أهلها","وناءَ بهم عيشٌ من الجهل أغبر",89,"ر",1,0],["فلا خلا الدستُ من غيثٍ اذا قنطوا","ظلٌّ نداهُ لدى الرُّواد مبذولا",90,"ل",2,0],["فَلا خَيرَ في حُبٍّ يُباعُ وَيُشتَرى","يَحومُ عَلَيهِ كلُّ ذي سَفَهٍ جِبسِ",91,"س",1,0],["فَلا خَيرَ إلاَّ وَهوَ كَالعَدلِ لا زِبُ","ولاَ شَرَّ إلاَّ وَهوَ كَالظُّلْمِ عَازِبُ",92