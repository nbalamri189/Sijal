{"poems":[[87,"بأي جواب غير ذا السيف تطمع","https://www.aldiwan.net/poem7754.html","الطويل"],[119,"والدة لله كم مرة","https://www.aldiwan.net/poem41728.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86732","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70927","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62610","الرجز"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75767","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48930","المتقارب"],[1649,"","https://poetry.dctabudhabi.ae/diwan/poem/104397","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122455","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85266","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131210",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58002","الطويل"],[4988,"ارطغرلّ","https://www.poetsgate.com/ViewPoem.aspx?id=198225",""]],"verses":[["وترغب نفسي في القلائد والغنى","وصدري بتقوى الله حال مرصع",0,"ع",1,0],["وترغب الخير لمن أسلموا","من عرب الدنيا وأعجامها",1,"م",3,0],["وَترغم أَنف جَبار عَنيد","بِجَيش ساسَهُ رَأيٌ سَديد",2,"د",1,0],["وترغب أو تصيرَ به مُرِبّاً","مُلِظّاً في انبساط وانْسِلاخِ",3,"خ",1,0],["وترغبُ عن زيارة غير أرضٍ","وتبذُر في المعاطن والسباخ",3,"خ",1,0],["وترغم الأنوف والخشوشا","وتكرم الضيوف والطروشا",4,"ش",2,0],["وَتُرغبك الأَماني في مَغاني","سميرك وَسطها برد النَعيم",5,"م",1,0],["وترغب فيكَ لحسن الضيع","وترغب عنكَ إلى المَضجِع",6,"ع",1,0],["وترغب في الدنيا وتعلم حالها","وتزهد في اخرك سراً ومجهرا",7,"ر",2,0],["وَتَرغَبُ في المعَأرِفِ والمزَايَا","جَوَارِي المسلمِينَ وَلا تُصَدُّ",8,"د",1,0],["وترغب عن أثر النبيين كلهم","وترغب في ميراث من شأنه الظلم",9,"م",1,0],["وترغب عن إتيان كل محللٍ","فتفعل بين الناس كل محرم",10,"م",1,0],["وترغب في الدنيا بكل دناءَةٍ","تغادرُ أملاكاً وفردوس نعمةِ",11,"ه",1,0],["وترغب في الأخرى تقي وتكرماً","وتعرج عن دار الغرور وتشمخ",12,"خ",1,0],["وترغوت يا ترغوت قرمٍ ومقدام","فاسه على راس المعادي وثوبه",13,"ب",2,0]]}