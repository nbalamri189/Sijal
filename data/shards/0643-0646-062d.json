{"poems":[[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[45,"اليوم عهدكم فأين الموعد","https://www.aldiwan.net/poem9534.html","الكامل"],[45,"سر حل حيث تحله النوار","https://www.aldiwan.net/poem9562.html","الكامل"],[99,"أقبل بموكبك الأغَر","https://www.aldiwan.net/poem24760.html","مجزوء الكامل"],[48,"كم بالمدينة من غريب نازل","https://www.aldiwan.net/poem22582.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[113,"كن حريصا واجمع من المال ما شئ","https://www.aldiwan.net/poem16529.html","الخفيف"],[119,"متى خيام من احب تقرب","https://www.aldiwan.net/poem41253.html","عموديه"],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[132,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[190,"خذ من زمانك ما صفا","https://www.aldiwan.net/poem43606.html","مجزوء الكامل"],[208,"يا غائبا ذكره في القلب محتضر","https://www.aldiwan.net/poem53267.html","البسيط"],[259,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[275,"جار الزمان فجاره محتاطا","https://www.aldiwan.net/poem34989.html","الكامل"],[374,"وصل الكتاب المهتدى برشاده","https://www.aldiwan.net/poem4320.html","الكامل"],[449,"اقنع من الدنيا بما","https://www.aldiwan.net/poem55983.html","عموديه"],[520,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[563,"كن حافظا حرمة من تقتدي","https://www.aldiwan.net/poem33503.html","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59089","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60841","البسيط"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99087","الرجز"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198983","المنسرح"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140295",""],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121375","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118778","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86473","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119634","الخفيف"],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4775,"طلاسم النار","https://www.poetsgate.com/ViewPoem.aspx?id=175238",""],[4829,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=36754",""],[4987,"عليل وتداوى","https://www.poetsgate.com/ViewPoem.aspx?id=49583",""],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5411,"لست أدري..","https://www.poetsgate.com/ViewPoem.aspx?id=191057",""],[5550,"عاملِ الناسَ","https://www.poetsgate.com/ViewPoem.aspx?id=214056",""],[5704,"قُمْ خليلي ...","https://www.poetsgate.com/ViewPoem.aspx?id=198798",""],[5791,"تعويذة حبر داخن ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208589",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5957,"كيف تقسو","https://www.poetsgate.com/ViewPoem.aspx?id=178159",""]],"verses":[["كَنَحلَةٍ أَمَسَكَها شَهدُها","مِنَ الجَناحَينِ فَلَم تَفلَتِ",0,"ت",1,0],["كُن حَيثُ شِئتَ تَسِر إِلَيكَ رِكابُنا","فَالأَرضُ واحِدَةٌ وَأَنتَ الأَوحَدُ",1,"د",1,0],["كُن حَيثُ شِئتَ فَما تَحولُ تَنوفَةٌ","دونَ اللِقاءِ وَلا يَشِطُّ مَزارُ",2,"ر",1,0],["كن حيث شئت فما أنا","إلا معنَّى بالمحال",3,"ل",1,0],["كُن حَيثُ شِئتَ بِلُجَّةٍ أَو رَبوَةٍ","أَو وَهدَةٍ سَيَنالُكَ التَيّارُ",4,"ر",1,0],["كن حيث أنت وَلا تخف ستجيء من","قبل الحكومة ذادةٌ أنجاب",5,"ب",1,0],["كُن حَريصاً وَاِجمَع مِن المال ما شئ","ت فَفي الجَمع جَمع كُل حَواس",6,"س",1,1],["كن حيثما شئت وباعد انه","ذيلك في فيفاء قلبي يسحب",7,"ب",1,0],["كن حافظاً لنا من الأغادي","وواقيا من حسد الحساد",8,"د",1,0],["كن حامياً لنا من الأكدار","وناصراً لنا على الفجار",8,"ر",1,0],["كن حافظاً لنا وكن نصيراً","وحامياً وحارساً مجيرا",8,"ر",2,0],["كنْ حليفَ التقى وسرَّك صُنْهُ","عن حبيب ومبغضٍ ومشير",9,"ر",1,0],["كن حيث هم لا حيث أن","ت وكن حكيما أحنفا",10,"ف",2,0],["كن حيث ما شئتَ من قربٍ ومن بَعَدٍ","فالقلب يرعاك إن لم يرعك النظرُ",11,"ر",1,0],["كُنْ حكيماً،عِشْ كريماً","وابتعدْ عن أيِّ رَيْبِ",12,"ب",1,0],["كن حازماً إن بتَّ يوماً عازماً","واطلُب لنفسكَ قوةً ونشاطا",13,"ط",2,0],["كن حيث شئت فما مررت بخاطري","إِلاّ وجدت هواك سر فؤاده",14,"د",2,0],["كن حازما لا تجزعن","لبؤسها كل الجزع",15,"ع",1,0],["كن حذراً منها إذا ما أرسلت","على القلوب أسهم النواظر",16,"ر",1,0],["كن حافظاً حرمة من تقتدي","به وصن نفسك عن فصلها",17,"ل",3,1],["كُنْ حَيْثُ شِئْتَ أسِرْ إلَيْكَ فَإنَّنْي","أَهْدَي إلَيْكَ وَلِمْ وَأنْتَ ذُكَاءُ",18,"ا",2,0],["كن حريصا على فؤادك ان جز","ت ففيها لكل قلب اماله",19,"ل",2,0],["كنحو ما اضطروا إلى علمهم","بالصين والردمِ وبالرملِ",20,"ل",1,0],["كُنْ حيث شئت فما أضمت نار وغى","إلاّ بقلب عدو تلك تضطرمُ",21,"م",1,0],["كن حذراً كن حذراً","كن حذراً من الغرق",22,"ق",1,0],["كن حذراً في الذي طمعت به","من حجب نقص وحجب إسقاط",23,"ط",1,0],["كن حيث كان من التقوى أبوك ولا","تجزع لخطب وإن أعيت به الخطب",24,"ب",1,0],["كن حاقداً ما دمتَ لستَ بقادرٍ","فإذا قدرتَ فخلِّ حقدَكَ واغفر",25,"ر",1,1],["كُن حِلسَ بَيتِكَ إِن سَمِعتَ بِفتنَةٍ","وَتَوَقَّ كُلَّ مُنافِقٍ فَتّانِ",26,"ن",1,0],["كنحو جاء المرسلون ولنا","اولو سيادة بهم زال العنا",27,"ن",2,0],["كن حيث كنت فإنه","أبد الزمان يراك عنده",28,"د",2,0],["كن حميم الزجال وامض سريعاً","تخو شهمٍ له الدجيل مقام",29,"م",1,0],["كن حبري دم قاني وطرسي قرطيان","وأحرفي مكساه من ماء ورد الياسمين",30,"ن",1,0],["كن حيث شئت فلا أزال متيما","والنور نوري ناسك في غاري",31,"ر",2,0],["كن حسنك اتى من جنان الخلد","حط في ارضنا ولّ يا ماجملك",32,"ك",1,0],["كن حبه على حدب الضلوع امتطوي","كيف ابقوى وانا بيباني قلبي تهاوى",33,"ا",3,0],["كن حبيبي أوعش تحاول أومت","في خواء إذا طلبت الإقالة",34,"ل",2,0],["كنحو ابن سينا بل أرسطو وقومه","وأتباعه ممن مضى وتقدما",35,"م",2,0],["كنحو الذي آووا لغارٍ فأطبقت","هناك عليهم صخرة منه للسد",36,"د",1,0],["كنحو ابن سينا وابن سبعين والذي","يرى رأيهم من كل غاو عن الرشد",36,"د",1,0],["كُنْ حَبيبي أوْ لا تَكُنْ لَيْسَ إلاّ..","رُبَّما القَصْدُ لمْ يَكُنْ مَعْنِيَّا",37,"ي",2,0],["كُنْ حَكيمًا يأبى التسَّرعَ دوْمًا","ويُحبُّ التفكيرَ والتمْهيلا",38,"ل",2,0],["كن حريصًا في ثمان إنها","تكسب الألباب نورا لا يُطَلْ",39,"ل",1,0],["كن حول معصمها المسْمَرّ أسورةً","ذابت ملامحها في صعقة العطر",40,"ر",1,0],["كُنْ حَاتميَ الطَّبْعِ في كَرَمٍ وَفي","أَدَبٍ وَمَفْخَرَةٍ وَحُزْ سِيمَاهَا",41,"ا",3,0],["كن حليما كن رقيقا كالندى","سيصير الوقت حتما مرحا",42,"ح",2,0]]}