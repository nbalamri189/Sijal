َسِّداً مِنْ جَوْهَرِ النُّورِ الَّذِي","لَمْ تُرْمَ يَوْماً شَمْسُهُ بِغُرُوبِ",1,"ب",1,0],["مُتَجَنٍّ يَحلو تَجَنّيهِ عِندي","فَهوَ يَجني وَمِنِّيَ الإِعتِذارُ",2,"ر",1,0],["متجاولين من الحديث بساحة","ركض البيان بها بغير عنان",3,"ن",1,0],["متجمِّلاً لدجاجهِ مُتجلِّداً","كتجلُّدِ المجلودِ بين ربائط",4,"ط",1,0],["متجاسراً حتى لظَنَّك جاهلٌ","غُمْراً تخالُ الليثَ ظبياً شادنا",5,"ن",2,0],["متجهما لليأس تبصر","فوق سحنته اصفرارا",6,"ر",2,0],["متجمعات في منابتها معاً","فكأنهن عرائس اخدان",7,"ن",1,0],["متجنب الدنيا عدو","وللأوائل والأواخر",8,"ر",1,0],["متجانسات في سياق وفودها","يحكين هذا اللؤلؤ المنظوما",9,"م",2,0],["مُتَجَنِّبِ الخُيَلاءِ إِلّا عِزَّةً","في العِزِّ حُسنٌ لَيسَ في الخُيَلاءِ",10,"ا",2,0],["مُتَجافٍ عَنِ الوِسادِ بِقَلبٍ","يَقِظِ اللُبِّ غَيرِ جَوشٍ صَكيكِ",11,"ك",1,0],["مُتَجَرِّدينَ عَلى الجِيادِ عَشِيَّةً","عُصَباً مُجَلَّحَةً بِدارِ ظَلامِ",12,"م",1,0],["متجنِّباً خَطَلَ الكلامِ كأنَّما","بُعِثَ البعِيثُ له وعاشَ الأخطَلُ",13,"ل",1,0],["متجرِّدٌ للخطبِ عرَّاضُ القَنا","والمَشرفيّةُ من مَشيدِ بنائِه",14,"ا",3,0],["مُتَجَشِّماً سُبُلَ المَطامِحِ طالِباً","مِنها وَفيها شَأوَ رِزقٍ هارِبِ",15,"ب",1,0],["مُتَجَرِّدٌ ثَبتُ المَواطِىءِ حَزمُهُ","مُتَجَرِّدٌ لِلحادِثِ المُتَجَرِّدِ",16,"د",1,0],["مُتَجَهِّماً ثَكِلَ الشَبابِ كَأَنَّما","نَشَرَ العِذارُ عَلى الشَبابِ حِدادا",17,"د",2,0],["مُتَجَلِّداً أَربا بِنَفسي أَن يُرى","هَذا الهِزبَرُ قَتيلَ ذاكَ الجُؤذُرِ",18,"ر",1,0],["مُتجرِّدٌ للهِ حَشْوُ قَميصهِ","تَقْوَى وَمِلءُ فُؤادهِ إيمانُ",19,"ن",1,0],["مُتجدِّدٌ في كلّ عصرٍ يَبتغي","أُمَماً تَجِيءُ جديدةً وعُلوما",20,"م",2,0],["مُتَجَدِّدِ الآثارِ ذي","لَجَبٍ كَثيرٍ وَحى الصَواهِل",21,"ل",1,0],["مُتَجَلِّداً أَو خِلتُهُ مُتَلَبِّداً","لا دَمعَ فيهِ بِفادِحٍ يَتَرَقرَقُ",22,"ق",1,0],["مُتَجَرِّداً لِلَهِ يَطلُبُ حَقَّهُ","وَيُقيمُ جانِبَ شَعبِهِ المُتَهَدِّمِ",23,"م",1,0],["متجاذِبات لَو تخل","لفَ واحدٌ عنها لأودى",24,"د",2,0],["متجدِّدَ الصبواتِ أودعَ حبَّهُ","شتى الأشعةِ فيكِ والأنداءَ",25,"ا",2,0],["مُتَجاهِلاتٍ أَنَّهُ","يَهْوى وهُنَّ به عَوالِمْ",26,"م",1,0],["مُتَّجِهاً إِلَى الكَ","مَالِ وَالصَّلاحِ العَمِمِ",27,"م",1,0],["مُتَجَدِّدٍ عَدَدَ الشُّهُورِ رَبِيعُهُ","حُلْوُ الجَنَى وَبِكُلِّ حُسْنٍ حَالِي",28,"ل",2,0],["مُتَجَشِّمٍ بِالصَّبْرِ دُونَ أَدَائِهَا","مَا سِيمَ مِنْ عَنَتٍ وَفَرطِ عَنَاءِ",29,"ا",2,0],["مُتجَاهِلاً عُقْبَى مَطَامِعِهِ وَلا","عقْبَى كَيَوْمِ قِيَامَةِ الْجُهَّالِ",30,"ل",1,0],["متجعد الخدين من سرف","متكسر الجفنين من سهد",31,"د",1,0],["متجلل بالفقر، مؤتزر","بالنبت من متيبس وندي",31,"د",2,0],["مُتجمِّعين كأَنَّهم سِرْبُ القَطا","مُتَدفِّقين كأَنهم أَنْهار",32,"ر",1,0],["متجبّر وأصمّ لم يسمع سوى","رهج الحديد المارد المتجبّر",33,"ر",1,0],["مُتجلببونَ سكِينةً وكآبة","ومن السواد عليهم جِلباب",34,"ب",1,0],["متجانياً عن خير مَن أبغَضتَهُ","ولشرِّ من أحببتُه مُتعرَّضا",35,"ض",2,0],["متجاورين ترى بكلّ خميلة","عند الغدير خليلة وخليلا",36,"ل",2,0],["متجنبا للمكرمات حاقدا","نَكِداً حقيرَ الجاه عند البارى",37,"ر",2,0],["متجاذبين من الحديث طرائفا","يُصغِى سماعِها النِّضوانِ",38,"ن",1,0],["مُتَجَلبِبَ النَصرِ الَّذي عُوِّدتَهُ","إِذ كانَ خَلفَكَ حَيثُما تَتَيَمَّمُ",39,"م",1,0],["متجنبٍ لا يُستطا","ع ولا يجود إذا رضى",40,"ض",2,0],["مُتَجَبِّراً ما خَوَّفو","هُ بِرَبِّهِ إِلّا تَجَبَّر",41,"ر",1,0],["مُتَجَهِّمٍ أَصفَت مَكارِمُهُ فَما","تَندى عَلى طولِ السُؤالِ صَفاتُهُ",42,"ت",2,0],["مُتجّرِدٌ للهِ يَنصُرُ دِينَهُ","والسّيفُ أحسَنُ حَلْيِه التَّجْريد",43,"د",1,0],["متَجمِّعاتٍ لي فكُن","تُ أعدُّ واحِدةً كَفافا",44,"ف",2,0],["متجلياً متوارياً","عن فهمنا بين الملائك",45,"ك",1,0],["متجنباً أبوابهم وفعالهم","متحلياً بمحاسن الأوصاف",46,"ف",1,0],["متجلِلاً ثَوب الرِئاسَة معلماً","بِبَهائِهِ وَوَفائِهِ وَسَدادِهِ",47,"د",2,0],["مُتجرِّمٌ أبداً يُجر","رِعُنِي مَراراتِ العتابِ",48,"ب",1,0],["متجاهر يهفو إلى لذاته","أحبب إلى اللذات من متجاهر",49,"ر",1,0],["متجنّبُ الإيعادِ حِلْ","ماً سابقٌ بالبذْلِ وعْدا",50,"د",2,0],["متجاربان فأبتُ مغلوباً يسا","بقني وحاز الخصلَ بالمسبوقِ",51,"ق",1,0],["متجاهلٌ ما حالُ قلبي بعدَه","جهلَ العليم وغائبٌ كالشاهدِ",52,"د",1,0],["مُتجاورين كأنهمْ لتَهاجُرٍ","مُتباعدونَ فمُنْجدونَ ومُتْهِ