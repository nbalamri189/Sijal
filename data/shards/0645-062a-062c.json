{"poems":[[53,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[73,"وبنفسي وإن أضر بنفسي","https://www.aldiwan.net/poem11988.html","الخفيف"],[88,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[51,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[89,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[89,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"ملَك بأفق الرمل هلّ كريما","https://www.aldiwan.net/poem7888.html","الكامل"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[45,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[28,"عفى المنازل آخر الأيام","https://www.aldiwan.net/poem5617.html","الكامل"],[61,"سعد حبيت به وجد مقبل","https://www.aldiwan.net/poem51472.html","الكامل"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[44,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[44,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[74,"وافى لنا وله صحيفة صفحة","https://www.aldiwan.net/poem12895.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[46,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[100,"عودة القائد","https://www.poetsgate.com/ViewPoem.aspx?id=50093",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[94,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[133,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[143,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[144,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[230,"خفقان قلبي ممرض","https://www.aldiwan.net/poem50969.html","مجزوء الكامل"],[236,"للدهر يا أبناء معمر","https://www.aldiwan.net/poem31933.html","مجزوء الكامل"],[236,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[365,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[372,"ولقلما حكم الزمان","https://www.aldiwan.net/poem57299.html","مجزوء الكامل"],[378,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[404,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[407,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[410,"قمر إذا عاتبته","https://www.aldiwan.net/poem32620.html","مجزوء الكامل"],[417,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[433,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[459,"ركب الدجى فسعى بغير رفيق","https://www.aldiwan.net/poem56085.html","الكامل"],[459,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[462,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[465,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[505,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[539,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[559,"إنما وحدة الوجود فنون","https://www.aldiwan.net/poem33762.html","الخفيف"],[559,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[568,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"]],"verses":[["مُتَجَرِّدينَ مِنَ الرِياضِ ضُحىً","حُلَّ النِطاقُ وَأُطلِقَ العَقصُ",0,"ص",1,0],["مُتَجَسِّداً مِنْ جَوْهَرِ النُّورِ الَّذِي","لَمْ تُرْمَ يَوْماً شَمْسُهُ بِغُرُوبِ",1,"ب",1,0],["مُتَجَنٍّ يَحلو تَجَنّيهِ عِندي","فَهوَ يَجني وَمِنِّيَ الإِعتِذارُ",2,"ر",1,0],["متجاولين من الحديث بساحة","ركض البيان بها بغير عنان",3,"ن",1,0],["متجمِّلاً لدجاجهِ مُتجلِّداً","كتجلُّدِ المجلودِ بين ربائط",4,"ط",1,0],["متجاسراً حتى لظَنَّك جاهلٌ","غُمْراً تخالُ الليثَ ظبياً شادنا",5,"ن",2,0],["متجهما لليأس تبصر","فوق سحنته اصفرارا",6,"ر",2,0],["متجمعات في منابتها معاً","فكأنهن عرائس اخدان",7,"ن",1,0],["متجنب الدنيا عدو","وللأوائل والأواخر",8,"ر",1,0],["متجانسات في سياق وفودها","يحكين هذا اللؤلؤ المنظوما",9,"م",2,0],["مُتَجَنِّبِ الخُيَلاءِ إِلّا عِزَّةً","في العِزِّ حُسنٌ لَيسَ في الخُيَلاءِ",10,"ا",2,0],["مُتَجافٍ عَنِ الوِسادِ بِقَلبٍ","يَقِظِ اللُبِّ غَيرِ جَوشٍ صَكيكِ",11,"ك",1,0],["مُتَجَرِّدينَ عَلى الجِيادِ عَشِيَّةً","عُصَباً مُجَلَّحَةً بِدارِ ظَلامِ",12,"م",1,0],["متجنِّباً خَطَلَ الكلامِ كأنَّما","بُعِثَ البعِيثُ له وعاشَ الأخطَلُ",13,"ل",1,0],["متجرِّدٌ للخطبِ عرَّاضُ القَنا","والمَشرفيّةُ من مَشيدِ بنائِه",14,"ا",3,0],["مُتَجَشِّماً سُبُلَ المَطامِحِ طالِباً","مِنها وَفيها شَأوَ رِزقٍ هارِبِ",15,"ب",1,0],["مُتَجَرِّدٌ ثَبتُ المَواطِىءِ حَزمُهُ","مُتَجَرِّدٌ لِلحادِثِ المُتَجَرِّدِ",16,"د",1,0],["مُتَجَهِّماً ثَكِلَ الشَبابِ كَأَنَّما","نَشَرَ العِذارُ عَلى الشَبابِ حِدادا",17,"د",2,0],["مُتَجَلِّداً أَربا بِنَفسي أَن يُرى","هَذا الهِزبَرُ قَتيلَ ذاكَ الجُؤذُرِ",18,"ر",1,0],["مُتجرِّدٌ للهِ حَشْوُ قَميصهِ","تَقْوَى وَمِلءُ فُؤادهِ إيمانُ",19,"ن",1,0],["مُتجدِّدٌ في كلّ عصرٍ يَبتغي","أُمَماً تَجِيءُ جديدةً وعُلوما",20,"م",2,0],["مُتَجَدِّدِ الآثارِ ذي","لَجَبٍ كَثيرٍ وَحى الصَواهِل",21,"ل",1,0],["مُتَجَلِّداً أَو خِلتُهُ مُتَلَبِّداً","لا دَمعَ فيهِ بِفادِحٍ يَتَرَقرَقُ",22,"ق",1,0],["مُتَجَرِّداً لِلَهِ يَطلُبُ حَقَّهُ","وَيُقيمُ جانِبَ شَعبِهِ المُتَهَدِّمِ",23,"م",1,0],["متجاذِبات لَو تخل","لفَ واحدٌ عنها لأودى",24,"د",2,0],["متجدِّدَ الصبواتِ أودعَ حبَّهُ","شتى الأشعةِ فيكِ والأنداءَ",25,"ا",2,0],["مُتَجاهِلاتٍ أَنَّهُ","يَهْوى وهُنَّ به عَوالِمْ",26,"م",1,0],["مُتَّجِهاً إِلَى الكَ","مَالِ وَالصَّلاحِ العَمِمِ",27,"م",1,0],["مُتَجَدِّدٍ عَدَدَ الشُّهُورِ رَبِيعُهُ","حُلْوُ الجَنَى وَبِكُلِّ حُسْنٍ حَالِي",28,"ل",2,0],["مُتَجَشِّمٍ بِالصَّبْرِ دُونَ أَدَائِهَا","مَا سِيمَ مِنْ عَنَتٍ وَفَرطِ عَنَاءِ",29,"ا",2,0],["مُتجَاهِلاً عُقْبَى مَطَامِعِهِ وَلا","عقْبَى كَيَوْمِ قِيَامَةِ الْجُهَّالِ",30,"ل",1,0],["متجعد الخدين من سرف","متكسر الجفنين من سهد",31,"د",1,0],["متجلل بالفقر، مؤتزر","بالنبت من متيبس وندي",31,"د",2,0],["مُتجمِّعين كأَنَّهم سِرْبُ القَطا","مُتَدفِّقين كأَنهم أَنْهار",32,"ر",1,0],["متجبّر وأصمّ لم يسمع سوى","رهج الحديد المارد المتجبّر",33,"ر",1,0],["مُتجلببونَ سكِينةً وكآبة","ومن السواد عليهم جِلباب",34,"ب",1,0],["متجانياً عن خير مَن أبغَضتَهُ","ولشرِّ من أحببتُه مُتعرَّضا",35,"ض",2,0],["متجاورين ترى بكلّ خميلة","عند الغدير خليلة وخليلا",36,"ل",2,0],["متجنبا للمكرمات حاقدا","نَكِداً حقيرَ الجاه عند البارى",37,"ر",2,0],["متجاذبين من الحديث طرائفا","يُصغِى سماعِها النِّضوانِ",38,"ن",1,0],["مُتَجَلبِبَ النَصرِ الَّذي عُوِّدتَهُ","إِذ كانَ خَلفَكَ حَيثُما تَتَيَمَّمُ",39,"م",1,0],["متجنبٍ لا يُستطا","ع ولا يجود إذا رضى",40,"ض",2,0],["مُتَجَبِّراً ما خَوَّفو","هُ بِرَبِّهِ إِلّا تَجَبَّر",41,"ر",1,0],["مُتَجَهِّمٍ أَصفَت مَكارِمُهُ فَما","تَندى عَلى طولِ السُؤالِ صَفاتُهُ",42,"ت",2,0],["مُتجّرِدٌ للهِ يَنصُرُ دِينَهُ","والسّيفُ أحسَنُ حَلْيِه التَّجْريد",43,"د",1,0],["متَجمِّعاتٍ لي فكُن","تُ أعدُّ واحِدةً كَفافا",44,"ف",2,0],["متجلياً متوارياً","عن فهمنا بين الملائك",45,"ك",1,0],["متجنباً أبوابهم وفعالهم","متحلياً بمحاسن الأوصاف",46,"ف",1,0],["متجلِلاً ثَوب الرِئاسَة معلماً","بِبَهائِهِ وَوَفائِهِ وَسَدادِهِ",47,"د",2,0],["مُتجرِّمٌ أبداً يُجر","رِعُنِي مَراراتِ العتابِ",48,"ب",1,0],["متجاهر يهفو إلى لذاته","أحبب إلى اللذات من متجاهر",49,"ر",1,0],["متجنّبُ الإيعادِ حِلْ","ماً سابقٌ بالبذْلِ وعْدا",50,"د",2,0],["متجاربان فأبتُ مغلوباً يسا","بقني وحاز الخصلَ بالمسبوقِ",51,"ق",1,0],["متجاهلٌ ما حالُ قلبي بعدَه","جهلَ العليم وغائبٌ كالشاهدِ",52,"د",1,0],["مُتجاورين كأنهمْ لتَهاجُرٍ","مُتباعدونَ فمُنْجدونَ ومُتْهِمُ",53,"م",1,0],["متجلببٌ ليلَ القلوب لصونهِ","ما زارَ إلا والظَّلام إِزارُه",54,"ر",2,0],["متجدد متوفرٌ متكثر","متزايد متواتر متوالي",55,"ل",2,0],["مُتَجَاذِبينَ مِن الحَدِيثِ نَوَادراً","تَسمُو سُموَّ النجم فِي الأفلاَكِ",56,"ك",1,0],["مُتَجاوِرينَ بدارِ مَضْيَعَةٍ","لا حرَّ عندهُمُ ولا بَرْدُ",57,"د",1,0],["متجلٍّ على الدوام بما في","علمه من ثوابتٍ فتبين",58,"ن",1,0],["متجردا عن كل ما","يلهيك عن هاتيك فاني",59,"ن",2,0],["متجدِّدُ العَبَرَاتِ يُعْ","جِلُهُنَّ بالنّفَسِ المُصَاعِدْ",60,"د",1,0]]}