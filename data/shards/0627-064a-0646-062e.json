{"poems":[[53,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[45,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[68,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[396,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48813","الخفيف"],[2555,"","https://poetry.dctabudhabi.ae/diwan/poem/147060","الخفيف"],[5111,"صَرْحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212514",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""]],"verses":[["أين خَطْمٌ كأنما","فُوكَ من تحتِه شرَجْ",0,"ج",1,0],["أَينَ خَلَّفتَها غَداةَ لَقيتَ ال","رومَ وَالهامُ بِالصَوارِمِ تُفلى",1,"ل",2,0],["أَينَ خَصبُ الأَكنافِ في الزَمَنِ الما","حِلِ وَالسُبطُ في السِنينَ الجِعادِ",2,"د",1,0],["أين خلْخالها لقد خلعتْه","وهي تبكي أسىً وتنفُثُ صَهْدا",3,"د",2,0],["أين خطاب المعالي","من هم للخير قاده",4,"د",2,0],["أين خلخالك قالت","غاص في الساق وغارا",5,"ر",2,0],["أين خلق الإيثار بالفضل فيهم","وعلاج العليل بالأعصاب",6,"ب",1,0],["اين خط ابن مقلة عن جمال ال","خط في صحن خده المعشوق",7,"ق",1,1],["أيْنَ خَمْرِيْ أيْنَ كَاسِيْ؟'","صَاحَ قَلْبِيْ يَازَمَانِيْ",8,"ن",2,0],["أَينَ خَدِيمُ الرُّوحِ دَامَ وَصْلُهُ","يَشدُو نُهُوجَ الخَيرِ يَسمُو حَانِيَا",9,"ي",2,0]]}