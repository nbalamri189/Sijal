{"poems":[[57,"لا غرني بعدك إنسان","https://www.aldiwan.net/poem26060.html","السريع"],[59,"ما في المقام لذي عقل وذي أدب","https://www.aldiwan.net/poem24724.html","البسيط"],[24,"ألا بكرت عرسي توائم من لحى","https://www.aldiwan.net/poem21856.html","الطويل"],[29,"عرفت ببرقة الوداء رسما","https://www.aldiwan.net/poem5983.html","الوافر"],[53,"مهما يكن للقيان زينا","https://www.aldiwan.net/poem66539.html","مخلع البسيط"],[34,"أبوك حباب سارق الضيف برده","https://www.aldiwan.net/poem27731.html","الطويل"],[87,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[30,"لولا يدا بشر بن مروان لم أبل","https://www.aldiwan.net/poem1236.html",""],[30,"ستعلم يا عمرو بن عفرا من الذي","https://www.aldiwan.net/poem1263.html",""],[50,"خليلي هذا موقف من متيم","https://www.aldiwan.net/poem65258.html","الطويل"],[50,"ألا كل بصري يرى أنما العلى","https://www.aldiwan.net/poem66154.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54601","الطويل"],[24,"ألاَ بَكَرتْ عِرْسِي تُوَائمٌ مَنْ لَحَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10859&r=&rc=0",""],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[199,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[215,"رجعت إلى رؤى الماضي رجعت","https://www.aldiwan.net/poem46318.html","الوافر"],[302,"ورحلتي المشتهاة تزري","https://www.aldiwan.net/poem33318.html","مخلع البسيط"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[382,"إلام تصر إثما يا حقود","https://www.aldiwan.net/poem59449.html","الوافر"],[408,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[435,"هجرت ربعك لا بغضا ولا مللا","https://www.aldiwan.net/poem40288.html","البسيط"],[438,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[463,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[466,"جلبت الخيل تمرح بالعوالي","https://www.aldiwan.net/poem15906.html","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66645","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86625","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86643","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86980","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69420","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140044",""],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96433","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130124","البسيط"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144896","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88996","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62806","الطويل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20599","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45835","البسيط"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17783","الطويل"],[4069,"","https://poetry.dctabudhabi.ae/diwan/poem/22628","الوافر"],[404,"لسْتُ براحلِ","https://www.poetsgate.com/ViewPoem.aspx?id=195049",""],[5906,"في الحكمة / الحلم ..... لا ينصفن","https://www.poetsgate.com/ViewPoem.aspx?id=193757",""],[463,"بطرفِّكَ والمسحورُ يقسمُ بالسَّحرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60085&r=&rc=141",""]],"verses":[["فَإِن تَغَيَّرتِ فَما حيلَتي","ما لي عَلى قَلبِكِ سُلطانُ",0,"ن",1,0],["فَإِن تَغَرَّبَ هَذا عَزَّ مَطلَبُهُ","وَإِن تَغَرَّبَ ذاكَ عَزَّ كَالذَهَبِ",1,"ب",1,0],["فَإِن تَغضَبوا أَو تُدرِكوا لي بِذِمَّةٍ","وَأَصبَحَ زَيدٌ بَعدَ فَقرٍ قَد اِقتَنى",2,"ا",1,0],["فَإِن تُغلَب فَإِنَّكَ تَغلِبِيٌّ","نَزَلتَ بِغايَةِ الحَمِقِ اللَئيمِ",3,"م",1,0],["فإن تغنَّتْ لنا وَدِدْنا","لو هي قامتْ عن المكانِ",4,"ن",1,0],["فَإِن تَغضَبوا مِن قِسمَةِ اللَهِ فيكُمُ","فَلِلَّهُ إِذ لَم يُرضِكُم كانَ أَبصَرا",5,"ر",2,0],["فَأَنتَ غَمامٌ وَالزَمانُ خَميلَةٌ","وَأَنتَ سِنانٌ وَالزَمانُ قَناةُ",6,"ه",1,0],["فَإِن تُغلِقِ الأَبوابَ دوني وَتَحتَجِب","فَما لِيَ مِن أُمٍّ بِغافٍ وَلا أَبِ",7,"ب",1,0],["فَإِن تَغضَبِ الدَهنا عَلَيكَ فَما بِها","طَريقٌ لِرِبّاتٍ تُقادُ رَكايِبُه",8,"ب",2,0],["فَإِن تُغلِقوا أَبوابَهُ لا تُعَنَّفوا","وَإِن تَفتَحوها نَستَطِف وَنُسَلَّمِ",9,"م",1,0],["فَإِن تُغرِسوا نَخلاً فَإِنَّ غِراسَنا","ضِرابٌ وَطَعنٌ في النُحورِ سَخينُ",10,"ن",1,0],["فَإِنْ تَغْلِبِ الأَشْجَانُ قَلْبَكَ مَرَّةً","عَلَى أَمْرِهِ فَاذْرِفْ دُمُوعَكَ فِي قَلْبِي",11,"ي",1,0],["فإنْ تغضبوا أو تدركوا لي بذمة ٍ","لعمركُم لمثلُ سعيكمُ كفى",12,"ا",1,0],["فَإِن تَغاضيتُ عَن قَومي فَعَن كَرَمٍ","مِنّي وَما ذَنبُ كُلِّ الناسِ يُغتَفَرُ",13,"ر",1,0],["فَأَنتَ غَيثٌ بِإِذنِ اللَهِ أَرسَلَهُ","لِلمُسلِمينَ حَياً وَالأَرضِ عُمرانا",14,"ن",2,0],["فأنت غناؤها في صمت قلبي","وأنت وفاؤها فيما جحدتُ",15,"ت",1,0],["فإن تغرَّبتَ فاِصطَحبها","فإنَّها سَلوةُ الغَريبِ",16,"ب",1,0],["فَإِن تَغدُ مَولوداً لَهُ رُحتَ والِداً","لِنَفسٍ بِمَفهومِ الغَرامِ تَزَكَّتِ",17,"ت",1,0],["فإن تغفر تجد ربّاً غفوراً","وإن تحقد فهوْ العدل الحقود",18,"د",1,0],["فإن تَغْفِرْ فَفضْلاً أو تُعاقبْ","فَعَدْلاً أيّها العَدْلُ القديرُ",19,"ر",1,0],["فأنت غصن وفي قلبي عظيم هوى","والغصن مرُّ الهوى يثني معاطفه",20,"ه",1,0],["فإنْ تُغمدِ البيضَ الصّفائحَ دونَه","فقد جرّد السودُ الصحائفَ للسّفْكِ",21,"ك",1,0],["فإن تَغرْ أو تكفني جانبهم","فلستُ من ذلك بالمبتئسِ",22,"س",1,0],["فأنت غِياثُ دين اللهِ تحْمي","حِمى الاسلامِ دُمْتَ له وداما",23,"م",2,0],["فأنتَ غريبٌ فيهمُ متباعدٌ","كأنّك مّما يَتَّقونَكَ أجربُ",24,"ب",1,0],["فَأَنتَ غَيثٌ وَإِن الغَيث عادته","يَأتي فَيَروي بَلا وَعد وَلا طَلَب",25,"ب",1,0],["فَأَنتَ غَيثٌ وَإِن الغَيثَ عادته","يَأتي فَيروي بِلا سؤلٍ وَلا طلَب",26,"ب",1,0],["فأنت غيث وإن الغيث عادته","يروي بِلا مَوعد طُول المَدى وَيَفي",27,"ف",2,0],["فَأَنتَ غُرَّةُ هَذا الدَهرِ مُشرِقَةً","في وَجهِهِ وَبَقايا الناسِ تَحجِيلُ",28,"ل",1,0],["فإن تَغِب شِعراءُ بالحدِّ","فالنَّسرُ والذِّراعُ كلُّ عندي",29,"ي",1,0],["فأنت غفار كا ذنب","وأنت يا سيدي رجائي",30,"ا",2,0],["فأنت غياثٌ للتيامى وعصمةٌ","إليكَ رحاءُ الطالبي الخيرِ يَرحَلُ",31,"ل",1,0],["فإن تَغَذّت بماءِ العلم نَبعَتُها","أهدت إلى الكونِ طيب العنبر العَطِرِ",32,"ر",1,0],["فأنت غصن صيغ من درة","على ذراه قمر لائح",33,"ح",1,0],["فأنت غيثٌ له إن جاء مُجدبُهُ","وأنت ليثٌ إذا الهيجا تهيج لهب",34,"ب",1,0],["فإنْ تَغمروني بالفوائدِ إنني","لأغْمركم من منطقي بالفَوائدِ",35,"د",1,0],["فَأَنتَ غَيثُهُم نَفعا وَطَودُهُم","دَفعا إِذا ما مرادُ المُمتَشى جَدَبا",36,"ب",2,1],["فَإِن تَغب عَن عُيوني يَستَضيء بِكُم","سَواد قَلب عَن الأَضلاع قَد رَحَلا",37,"ل",2,0],["فَإِن تُغرِموني داءَ غَيرِيَ أَحتَمِل","ذُنوبَ ذِئابِ القَريَتَينِ العَواسِلِ",38,"ل",1,0],["فَإِن تَغضَب فَلَستَ المَرءَ تَرضى","وَلَم أَعلَمكَ إِلّا مِن إِيادِ",39,"د",1,1],["فأنتِ غرستِ العِشْقَ بين قصائدي","جعلتِ الغرامَ الحُلْوَ... وَحْيَ تساؤلي",40,"ل",2,0],["فَإنْ تَغاضى يُقالُ الجُبنُ شيمَتُهُ","وَ النُّصحُ يَحسَبُهُ الجَهولُ بَعضَ النَّطْ",41,"ط",1,0],["فأنتَ غذا شمتَ الظبا قاتلُ العدا","وأنتَ إذا شمتَ النَّدى قاتلُ الفقرِ",42,"ر",1,0]]}