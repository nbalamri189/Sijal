,"الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66162","الكامل"],[4935,"صفت في روض حلوان","https://www.poetsgate.com/ViewPoem.aspx?id=129433",""],[5046,"متصابية","https://www.poetsgate.com/ViewPoem.aspx?id=197895",""],[585,"لمن اللواء محلقاً يتهلل","https://www.poetsgate.com/ViewPoem.aspx?id=161887",""],[5082,"دفءٌ وندى/ إلى أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=212473",""],[1420,"نزل اللاهوت في ناسوتها","https://www.poetsgate.com/ViewPoem.aspx?id=87622",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5189,"تبدو العروبةُ","https://www.poetsgate.com/ViewPoem.aspx?id=195164",""],[5277,"هي وحدها","https://www.poetsgate.com/ViewPoem.aspx?id=190223",""],[5277,"مقدمة الديوان","https://www.poetsgate.com/ViewPoem.aspx?id=191130",""],[5277,"نابُ النوى","https://www.poetsgate.com/ViewPoem.aspx?id=191464",""],[5277,"زهرةٌ لا تذبلها الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=196558",""],[5324,"هي والربيع وموطني .","https://www.poetsgate.com/ViewPoem.aspx?id=207542",""],[5351,"آخر الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202029",""],[5351,"خطاب إلى من يهمها الأمر","https://www.poetsgate.com/ViewPoem.aspx?id=202074",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[5561,"حسٌّ وتراب","https://www.poetsgate.com/ViewPoem.aspx?id=197538",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5739,"علمها عند الفهيم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=162751",""],[5751,"طِفلة الورد","https://www.poetsgate.com/ViewPoem.aspx?id=214766",""],[5768,"حَلَتِ الْعَشْرُ ثُمَّ رَحَلَتْ !","https://www.poetsgate.com/ViewPoem.aspx?id=215419",""],[5848,"اسبوع","https://www.poetsgate.com/ViewPoem.aspx?id=50533",""],[5956,"حقاً أخذتِ منَ اسمِكِ الأمجادا","https://www.poetsgate.com/ViewPoem.aspx?id=194218",""],[5956,"شكراً دعوتِ لطفلتي أن تشتفي","https://www.poetsgate.com/ViewPoem.aspx?id=202659",""],[5956,"عزرائيل هو إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=215497",""],[5956,"يومَ الخميس حبيبتي قد سافرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=215905",""],[5975,"وأنت دقَّ معناكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53251",""],[161,"قصيدة شكر وعرفان لآل العروض الرقمي","https://www.poetsgate.com/ViewPoem.aspx?id=166365",""],[6127,"حَدَثٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=198201",""],[6142,"جاءنا بالشريعة السهلة الس","https://www.poetsgate.com/ViewPoem.aspx?id=155701",""],[6152,"الحب اكتفاء","https://www.poetsgate.com/ViewPoem.aspx?id=204248",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[313,"أمل يخيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66500&r=&rc=22",""],[6198,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79295&r=&rc=69",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[6247,"الراحلون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80266&r=&rc=5",""]],"verses":[["هِيَ وَالفَقيدَةُ كَالأَديمِ اِختَرتَهُ","فَقَدَدتَ إِذ خَلُقَ الشِراكُ شِراكا",0,"ك",2,0],["هي وَخْشٌ وإنّ دهراً سَمِعْنا","فيه من مِثلها غناءً لوخْشُ",1,"ش",1,0],["هُيوز وَقَد كانَ قَبلاً مُرَشَّح","شَكَوتُ إِلَيهِ اِنقِلابَ الأُمور",2,"ر",1,0],["هِيَ وَقعَةٌ ضَجَّت لَها الدُنيا كَما","ضَجَّت وَضَجَّ الناسُ في سيدانِ",3,"ن",1,0],["هي والشمس غابتا في زمانٍ","واحدٍ آه آه يا للمصيبه",4,"ب",2,0],["هِيَ وَالزَمانُ بِأَرضِهِ وَسَمائِهِ","في لُجَّةِ الأَقدارِ نِضوُ شِراعِ",5,"ع",1,0],["هَيِّؤوها لِما يَليقُ بِمَنفٍ","وَكَريمِ الآثارِ وَالأَطلالِ",6,"ل",1,0],["هي وقعةٌ لكَ عِزّها وسَناؤُها","وعلى عَدوِّكَ نارُها وشَنارُها",7,"ر",3,0],["هِيَ وَعكَةٌ كانت ثِقافَ مُقوَّمٍ","لَدْنَ المَهَزَّةِ أو صِقالَ مُذكَّرِ",8,"ر",1,0],["هِيَ وَاللَهِ الَّذي هُوَ رَبّي","صادِقاً أَحلِفُ غَيرَ الكِذابِ",9,"ب",1,0],["هي وحيهُ من سماءِ الأُولمبِ","وآلهةِ الحكمة الغابرينْ",10,"ن",1,0],["هِيَ وَقْعَةٌ فِي الْجَوَّ بَيْ","نَ هَبَائِهِ الْمُتَلَمِّعِ",11,"ع",1,0],["هي والدنيا وما بينهما","غصصي الحرى وأهوائي العنيدة",12,"د",2,1],["هي وحدة العرب الأباه تسنّمت","في ربوه التاريخ أرفع منبر",13,"ر",1,0],["هيَ واللَّه مُنى قلبي الحزين","إِن تكُن تقربُ أَو تَنأى الديار",14,"ر",1,0],["هي والدهر والأله على ما","قد جرى حولها شهود عدول",15,"ل",1,0],["هِيَ وَجنة الدُنيا وَرَونَقَها","وَجَبينُها الزاهي بِلا نَكر",16,"ر",1,0],["هيَ ومْضةٌ تجلو الظلامَ إذا سما","قصد المُحِبِّ وصانَها الإحسانُ",17,"ن",1,0],["هي وصل بين المحاسن لما","تم حسنا وبالعذار التمام",18,"م",1,0],["هيَ وعكةٌ زالت أمامَ سلامةٍ","زانت مُنًى أَمت على الشاني مَنى",19,"ن",2,0],["هيولي هباء الغين من جوهر العمى","فمني تبدي الكل من بسط نقطتي",20,"ي",1,0],["هي وقفة رزق المكرم حمدها","وعلى رجال لومها والعار",21,"ر",1,0],["هي وحدة باسم الوجود تحققت","وهي الوجود الحق والوجدان",22,"ن",1,0],["هيولا شهدنا أنها نور نوره","لها صور شتى به تتدافع",23,"ع",1,0],["هي وهْي وهْي هِي التي هي عندهم","هي عندنا هي في حجاب خدورها",24,"ر",3,0],["هي وردة قل كالدهان سماؤنا","كانت كما القرآن أفصح مشهدا",25,"د",2,0],["هي وحدة في كثرة هي كثرةٌ","في وحدة تتلى بها الآيات",26,"ت",1,0],["هيولا هم من نور ذي العرش بدؤها","فلا عز إلا وهو يعزى اليهم",27,"م",1,0],["هيوبٌ عَنِ الفعلِ الذميمِ وإنّه","إِلى أخذِ رايات الثناء وثوبُ",28,"ب",1,0],["هي وصف الوجد ان من كل صب","وهي عين المدعو ممن دعاله",29,"ل",2,0],["هي وقفة بين التعلل والأسى","يفنى الرجاء ويخلد الميثاقُ",30,"ق",1,0],["هي والبدرُ معاً من مَطلع","كلَّما ورَّد خدَّيها الخجل",31,"ل",1,0],["هيوم قيوم العلوم وَبحرها","رستاقها وَعماد سقف البيت",32,"ت",1,0],["هي والراح أسفرا إسفاراً","فأعادا ليل الندامى نهارا",33,"ر",2,1],["هي وشح نسجٍ نيلها","فيه الطرازُ الأحمرُ",34,"ر",1,0],["هيوتكِ حتى لا نهاية في الهوى","وأَتعبتُ فيك النازلات نزالا",35,"ل",2,0],["هِيَ وَردَةٌ في خَدِّها وَبِكَأسِها","تَحت القَناني عَسجَدٌ مَضبوبُ",36,"ب",1,0],["هي والله ساعةٌ من سعود","عمني من روائها شؤبوب",37,"ب",1,0],["هيولي شخصه ملك ولكن","بدت في صورة البشر الفخام",38,"م",1,0],["هي وسط النهار ليل وفي الليل","ظلام على ظلام سار",39,"ر",1,0],["هي وحدها أنسى إذا ما أوحشت","دنياي وهي نجيتي عند الضجر",40,"ر",1,0],["هي وحدها درسي الذي فيه العبر","هي وحدها الخمر التي تحي الفكر",40,"ر",1,0],["هي واقعة لك لاجئة","بك تجلو مطلعك الحسنا",41,"ن",2,0],["هي وقعة جلل اثارت لوعة","منها تصدع يذبل ويلملم",42,"م",1,0],["هي والأقدار تجرى حولها","جثة في موجها الملتطم",43,"م",1,0],["هيوباً ولا شيءٌ يهاب لقاؤهُ","عسوفاً إذا ما الخوف قد كان احزما",44,"م",2,0],["هي وردة نبتت ببذرة زايد","والورد منه كسا الندى بجمال",45,"ل",1,0],["هيوا وجودوا بما في وسعكم شغفا","بالبر حَتّى نَرى في الافق بدر دجى",46,"ج",2,0],["هَيّوا اِتبَعوني فَخَيرُ الأَمرِ ما اِجتَمَعَت","عَلى تَطَلُّبِهِ القُوّاتُ تَلتَئِمُ",47,"م",1,0],["هَيُّوا نَرَى أَنَّى يُتاحُ لَنَا","أَن نَدفَعَ الإِغرِيقَ كَي تَثِبا",48,"ب",2,0],["هيّوا فَبَطنيَ مَلأى","بِالأَعَظُمِ النَخِراتِ",49,"ت",1,0],["هَيُّوا لِطَردِ الفَقرِ عن أَوطَانِكُم","جيشاً مِنَ الزُّرَّاعِ والصُّنَّاعِ",50,"ع",1,0],["هي وَقعة الحَدَق المِراض فمِن","جُرحٍ جبارٍ أَو دمٍ هَدِر",51,"ر",1,0],["هي وحدة أفعمتها بمحبّة","ورَعيتها بالجُود قُل هل يا تُرى؟",52,"ر",2,0],["هِيَ وَالرُوحُ في فُؤادِكَ صُنوا","نِ وَفَيضٌ مِن عالَمٍ عُلوِيِّ",53,"ي",1,0],["هِيَ وَرْدَةٌ فَتانَةٌ في رَوْضَةٍ","فَيْنانَةٍ طَلُّ الرَّبيعِ سَقاها",54,"ا",3,0],["هيولي وصفه الذاتي","أرانا الشكل نوراني",55,"ن",2,0],["هَيُّوا اليراعَ لقَوْلَتي والمِحْبَرةْ","حتَّى أُسطِّرَ مِن كلامِيَ أشهرَهْ",56,"ر",2,1],["هي وثبة الأسد الهصور وغضبةٌ","للحق من ملك يقول ويفعل",57,"ل",1,0],["هي وردةٌ يسعى النّدى لرحابها","متوجساً , يرجو نعيم ثوابِها",58,"ب",3,0],["هي والكاس وما مازجها","كأب متحد وابن روح",59,"ح",1,0],["هي واليَهودُ كَوالدٍ ووليدِهِ","تُعطيهِ مِن عَطفٍ ومِن تَحْنانِ",60,"ن",1,0],["هيَ وحدةٌ بين الشعوب ورفضِها","لمشاهدِ الإذلالِ والإضغانِ",61,"ن",1,0],["هي وحدها أهزوجةٌ بفمِ المَدى","كتبتْ ترانيمَ الهوى البغدادي",62,"د",2,1],["هي والعقود حبيبتي وخليلتي","ربحاي في ربحي من النسوان",63,"ن",1,0],["هي واختصارٌ للحياةِ تنوءُ إذْ","قطعٌ من الليلِ