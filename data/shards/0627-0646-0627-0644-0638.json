{"poems":[[55,"يا نظرة كانت عليك بلية","https://www.aldiwan.net/poem26128.html","الكامل"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[45,"إن الظباء غداة سفح محجر","https://www.aldiwan.net/poem63628.html","البسيط"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[33,"إن الظباء التي في الدور تعجبني","https://www.aldiwan.net/poem25899.html","البسيط"],[46,"إني لمن آل حواء الذين هم","https://www.aldiwan.net/poem23575.html","البسيط"],[140,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[219,"مولاي قد نامت عيون","https://www.aldiwan.net/poem55273.html","مجزوء الكامل"],[227,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[268,"طف بالكؤوس وأطلع أنجم الحلك","https://www.aldiwan.net/poem35288.html","البسيط"],[278,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[280,"أما وكل نفوخ","https://www.aldiwan.net/poem32813.html","المجتث"],[429,"يا من وهبت لوجهه","https://www.aldiwan.net/poem12703.html","مجزوء الكامل"],[456,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[536,"الويل ثم الويل للبياز","https://www.aldiwan.net/poem48010.html","عموديه"]],"verses":[["إِنَّ الظُنونَ بِمَن أُحِبُّ كَثيرةٌ","اللَهُ يَعلَمُ ما أُسِرُّ وَأَكتُمُ",0,"م",1,0],["إِنَّ الظَعائِنَ يَومَ بُرقَةِ عاقِلٍ","قَد هِجنَ ذا سَقَمٍ فَزِدنَ خِبالا",1,"ل",2,0],["إِنَّ الظِباءَ غَداةَ سَفحِ مُحَجَّرِ","هَيَّجنَ حَرَّ جَوىً وَفَرطَ تَذَكُّرِ",2,"ر",1,1],["إنَّ الظِّباءَ حَمتْ مراتِعَها الظُّبا","ورَعَتْ سوائمُها أُسودَ الغابِ",3,"ب",1,0],["إِنَّ الظِباءَ الَّتي في الدورِ تُعجِبُني","تِلكَ الظِباءُ الَّتي لا تَأكُلُ الشَجَرا",4,"ر",2,1],["إِنَّ الظَواهِرَ لَم تُشبِه بَواطِنَها","مِثلَ القَوادِمِ خانَتها خَوافيها",5,"ي",3,0],["إن الظباءَ التي هام الفؤادُ بها","يَرعَينَ ما بين أحشاءٍ وأكبادِ",6,"د",1,0],["إن الظلام الحق لهو","ظلام من لا يفقهون",7,"ن",1,0],["إنّ الظعائن يومَ رَمْلَةِ عالجٍ","مَلّكن كلَّ حَشيً لكلّ غَرامِ",8,"م",1,0],["إنّ الظَّرافةَ مِن كاسٍ ثُمالتُها","لم تُبقِ شكّاً ولا همّاً لمُرتبك",9,"ك",1,0],["إِنَّ الظِّباءَ غَداةَ رامَةَ لَمْ تَدَعْ","إِلاّ حَشىً قَلِقاً وَقَلْباً شَيِّقا",10,"ق",2,0],["إِنَّ الظَهيرَ لَيَسمو","فَضلاً بِأَنفٍ شَموخِ",11,"خ",1,0],["إن الظلامَ إذا دَجا","سببٌ لإظهارِ الفتيلَهْ",12,"ل",2,0],["إنّ الظباءَ بالغضا ضياغمٌ","والأَجَمُ الكِناسُ والصرائمُ",13,"م",1,0],["إنَّ الظَّلُومَ إذا تفاحَشَ ظُلمُه","كانت خُطاه سَريعةَ الإنجازِ",14,"ز",1,0]]}