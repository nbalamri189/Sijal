{"poems":[[79,"يوم أزمعت عنك طوع البعاد","https://www.aldiwan.net/poem36595.html","الخفيف"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[79,"يوم أزمعت عنك طوع البعاد","https://www.poetsgate.com/ViewPoem.aspx?id=33793",""],[228,"وترامى الصباح فوق الهضاب","https://www.aldiwan.net/poem41603.html","الخفيف"],[308,"قال صحبي إذ رأوا من هام في","https://www.aldiwan.net/poem57560.html","الرمل"],[543,"حدثوا عن خائن","https://www.aldiwan.net/poem48300.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77508","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77602","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101427","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202948","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123928","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32888","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111457","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119723","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81289","المنسرح"],[357,"الليل والذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=6324",""],[5076,"قلمي يحاورني","https://www.poetsgate.com/ViewPoem.aspx?id=179336",""],[5409,"قال صحبي علام لا تقتفي النا","https://www.poetsgate.com/ViewPoem.aspx?id=155372",""],[6093,"ماله عندي شبيه ( مجزوء الرمل )","https://www.poetsgate.com/ViewPoem.aspx?id=176000",""],[6093,"أجْبَلَ الشعرُ وأكْدى الشاعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=215902",""]],"verses":[["قالَ صَحْبي وقدْ أطَلْتُ التِفاتي","أيَّ شَيْءٍ ترَكْتَ قلْتُ فُؤادي",0,"ي",1,0],["قال صَحْبي في لُجّتَينِ من الحِنْ","دِسِ والبيدِ إذْ بدا الفَرْقَدانِ",1,"ن",1,0],["قالَ صَحبي إِذ رَأَوهُ مُقبِلاً","ما تَراهُ شَأنُهُ قُلتُ أَدَل",2,"ل",1,0],["قَالَ صَوْتٌهِيَ الْعِنَايَةُ حَلَّتْ","فَأَنَارَتْ مَلِيكَكُمْ وَأَظَلَّتْ",3,"ت",1,0],["قال صحبي وقد أطلت التفاتي","أيى شيء تركت قلت فؤادي",4,"ي",1,0],["قالَ صَوتٌ هذي عروسٌ من الج","نِّ تَزورُ الضَريحَ لِلإِرهابِ",5,"ب",1,0],["قال صحبي إذ رأوا من هام في","لحية كانت عذارا ومضى",6,"ض",2,1],["قال صَحبِي إنَّه","لَخِسيسٌ خُندُبُ",7,"ب",1,0],["قال صلاة العيد بعد الظهر","أو قبل أن يبدو طلوع الفجر",8,"ر",1,0],["قالَ صَغيرُهُم ومن ذا يربط","القطُّ كَالعفريت حينَ يهبط",9,"ط",1,0],["قالَ صدقتَ وَجُزيت خَيراً","خُذ هَذِهِ الفُؤوس مني طُرّا",10,"ر",2,0],["قَالِصَةٍ رَأدَ الضُّحَى أفيَاؤُهُ","يَخطُبُ فَوقَ عُودِهِ حِربَاؤُهُ",11,"ه",1,0],["قال صحبي وقد أشرت اليكم","أيُّ شيء مشوا به ؟ قلت: قلبي",12,"ب",2,0],["قالَ صِفْها فقلتُ قد شَرَحَتْها","لَكَ في الخَدِّ أَدْمُعي المُسْتَهلَه",13,"ل",2,0],["قال صِدغي فوقَه لا تحذر","قال لي لما نأى الواشي ارتشفْ",14,"ف",1,0],["قال صحبي مع الحياة تطوّرْ","وتلبّسْ للعيش في كل لبس",15,"س",1,1],["قال صبَرتُ والإلهُ الحَكَمُ","إذ أخذوا مالي وعرضي شتَموا",16,"م",3,0],["قال صبراً وما درى","كغز صبري به نفد",17,"د",1,0],["قالَ صُبّي في الحُبِّ كوزاً بِكوزٍ","وَأَزيحي البُردَينِ هذا وَذاكا",18,"ك",2,0],["قَالَ صَحبي هَكطُورَ هَولاً ظَنَنتُم","بِقَناهُ وَالعاسِلِ المسَنُونِ",19,"ن",1,0],["قال صَهٍ إنما وصالي","يوم تمور السماء مَورا",20,"ر",2,0],["قالَ صَديقي وَكُلُ ذي أَدَب","صاحب قُربى عِندي وَذُو نَسَب",21,"ب",1,1],["قال صمت الليل: كلا ...ليس في الحب ايراده","قدر هذا علينا ...مثل موت وولاده",22,"د",2,0],["قال صبراً قد تطاولتَ على","عزّتي واللهِ اني للنعمْ",23,"م",1,0],["قال صحبي علام لا تقتفي النا","س فتحيا مبجلاً محبوبا",24,"ب",2,1],["قال: صِفني يا مُعَنىً","قلتُ قولاً يزدَهِيْهْ",25,"ي",2,0],["قال : صفها ! قلتُ: دُرٌّ آسِرُ","قال زدني! قلت: عطرٌ عاطرُ",26,"ر",1,1]]}