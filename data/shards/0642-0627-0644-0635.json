{"poems":[[77,"يوم أزمعت عنك طوع البعاد","https://www.aldiwan.net/poem36595.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[77,"يوم أزمعت عنك طوع البعاد","https://www.poetsgate.com/ViewPoem.aspx?id=33793",""],[224,"وترامى الصباح فوق الهضاب","https://www.aldiwan.net/poem41603.html","الخفيف"],[304,"قال صحبي إذ رأوا من هام في","https://www.aldiwan.net/poem57560.html","الرمل"],[539,"حدثوا عن خائن","https://www.aldiwan.net/poem48300.html","عموديه"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قالَ صَحْبي وقدْ أطَلْتُ التِفاتي","أيَّ شَيْءٍ ترَكْتَ قلْتُ فُؤادي",0,"ي",1,0],["قال صَحْبي في لُجّتَينِ من الحِنْ","دِسِ والبيدِ إذْ بدا الفَرْقَدانِ",1,"ن",1,0],["قالَ صَحبي إِذ رَأَوهُ مُقبِلاً","ما تَراهُ شَأنُهُ قُلتُ أَدَل",2,"ل",1,0],["قَالَ صَوْتٌهِيَ الْعِنَايَةُ حَلَّتْ","فَأَنَارَتْ مَلِيكَكُمْ وَأَظَلَّتْ",3,"ت",1,0],["قال صحبي وقد أطلت التفاتي","أيى شيء تركت قلت فؤادي",4,"ي",1,0],["قالَ صَوتٌ هذي عروسٌ من الج","نِّ تَزورُ الضَريحَ لِلإِرهابِ",5,"ب",1,0],["قال صحبي إذ رأوا من هام في","لحية كانت عذارا ومضى",6,"ض",2,1],["قال صَحبِي إنَّه","لَخِسيسٌ خُندُبُ",7,"ب",1,0],["قال صلاة العيد بعد الظهر","أو قبل أن يبدو طلوع الفجر",8,"ر",1,0]]}