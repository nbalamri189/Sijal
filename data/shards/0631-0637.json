{"poems":[[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[85,"يا خير من ملك الملوك بجوده","https://www.aldiwan.net/poem54266.html","الكامل"],[90,"إن رمت عيشا ناعما ورقيقا","https://www.aldiwan.net/poem44987.html","الكامل"],[64,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[47,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[76,"ويوم صقيل للشباب ظللته","https://www.aldiwan.net/poem12860.html","الطويل"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[76,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[92,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[164,"هز الغرام معاقد التيجان","https://www.aldiwan.net/poem59100.html","الكامل"],[264,"هذا كتاب أم بشير سعاد","https://www.aldiwan.net/poem35761.html","الكامل"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[398,"مشيب عراه لو يدوم مشيب","https://www.aldiwan.net/poem53654.html","الطويل"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[463,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[547,"رطلان لا أزداد فوقهما","https://www.aldiwan.net/poem34020.html","أحذ الكامل"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119979","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144075","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79990","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108593","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93830","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33761","المنسرح"],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5376,"نور على نور ضياء محمدا","https://www.poetsgate.com/ViewPoem.aspx?id=189522",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[6052,"همس الذكربات","https://www.poetsgate.com/ViewPoem.aspx?id=49636",""]],"verses":[["رَطْبُ الغِرارَيْنِ مأمونٌ على بَطَلٍ","يَخشى زَماناً على الأحرارِ مُتَّهَما",0,"م",2,0],["رُطَبٌ من الطَّلع النضيد كأنها","قد نُظِّمت من حسنها أسلاكا",1,"ك",2,0],["رطِّب حياتك بالغناء إذا عرا","هَمٌ يُجَفِّف في الحُلوق الريقا",2,"ق",2,0],["رطّب تراكيبك إن","جفّت بماء الورقِ",3,"ق",1,1],["رَطبُ الغَمامِ إِذا ما اِستُمطِرَت يَدُهُ","جاءَت مَواهِبُهُ قَبلَ المَواعيدِ",4,"د",1,0],["رَطيبٌ بِأَنفاسِ الصِبا وَنَدى الصَبا","فَقَد رَقَّ حَتّى كادَ يَجري فَيَسكُبُ",5,"ب",1,0],["رَطبِ الكَلامِ عَلى سَماعِ جَليسِهِ","فَكَأَنَّ في فيهِ لِسانَ مُبَشِّرِ",6,"ر",1,0],["رَطيبِ النَسيمِ كَأَنَّ الصَبا","تُجَرِّرُ فيهِ ذُيولَ الغَمامِ",7,"م",1,0],["ر|طاباً كأنفاس النسائم سَحرةً","عِذاباً كماء الرافدين المصفقَّ",8,"ق",1,0],["رطب الشمائل ضاحك عن مبسم","نبتت لآلئه على المرجان",9,"ن",1,0],["رطب البنان كأنّ من ألفاظه","راحاً لسلب العقل بالمراصاد",10,"د",1,0],["رَطْبِ اللّسانِ يَبُثُّ سرّاً كامِناً","خِلْوِ الجَنانِ يَحُثُّ دَمعاً مُسبَلا",11,"ل",2,0],["رَطيبٌ وَعودُ النَصبِ اذ ذاكَ يابِسٌ","فَللنارِ في تِلكَ الجُسومِ لَهيب",12,"ب",1,0],["رَطِبَتْ بالشكر صِدقا شَفَتي","منذُ ألقيتُ إلى بحرك شَنِّي",13,"ن",2,0],["رطابُ النطق بسّامو المجالي","إذا ما أيبسَ الفَرَقُ الحُلوقا",14,"ق",2,0],["رَطبٌ نَضيجٌ فائِقٌ لَذيذُ","يَعومُ في الدَهنِ بِهِ السَميذُ",15,"ذ",1,0],["رَطلانِ لا أزداد فَوقَهما","في الشرب إن حَضَروا وإن وَحدي",16,"د",2,1],["رَطبُ اللآلي بَعيدٌ","مِن ثَغرِها في الصِقالِ",17,"ل",1,0],["رطب الصوارم من دما","ء عداته عضب الصرائم",18,"م",1,0],["رطْبُ الصِّبا عذْبُ اللّمى","حُلو الرِّضا مُرّ السّخَطْ",19,"ط",1,0],["رطيب ثرًى منه تحيي وفودُه","محيًّا بأنداء الحيا لم يزل رطبا",20,"ب",2,0],["رطب القرار كأن خضرته","بدء العذار بأوجه المرد",21,"د",1,0],["رطّب لساني والجنانَ بذكرِكم","كجّل عيوني بالجلا الربّاني",22,"ن",2,0],["رطيب قوام أهيف القد لم تدع","ليانة عطفيه قياساً لقائس",23,"س",1,0],["رطب المزاج حظه منك الفلج","يلقى بك الشدة طالب الفرج",24,"ج",1,0],["رطب الجبين سرت حلاوة وجهه","في الروض بين ربي وبين نطاف",25,"ف",1,0],["رَطيب جسمٍ كالماءِ تَحسبُهُ","يخطرُ في القلبِ منهُ مسلكُهُ",26,"ك",2,0],["رُطََبٌ عِنْدَنا أكِمّتُهُ","فهنيئاً لِغَيْرِنا الحَشَفُ",27,"ف",1,0],["رطِّبْ لسانَك بالحبيب وذكره","وانعمْ حلاوةَ ذكره قطر الندى",28,"د",2,0],["رطانة العجم ما زلنا نعاقرُها","أمسى الكثير على حاناتها ثَمِلا",29,"ل",2,0],["رطبٌ بذكر الله فيه حلاوة","عسل الهدى بشذى التقى قد شابا",30,"ب",2,0]]}