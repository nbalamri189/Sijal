{"poems":[[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[83,"يا خير من ملك الملوك بجوده","https://www.aldiwan.net/poem54266.html","الكامل"],[88,"إن رمت عيشا ناعما ورقيقا","https://www.aldiwan.net/poem44987.html","الكامل"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[45,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[74,"ويوم صقيل للشباب ظللته","https://www.aldiwan.net/poem12860.html","الطويل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[74,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[161,"هز الغرام معاقد التيجان","https://www.aldiwan.net/poem59100.html","الكامل"],[260,"هذا كتاب أم بشير سعاد","https://www.aldiwan.net/poem35761.html","الكامل"],[365,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[394,"مشيب عراه لو يدوم مشيب","https://www.aldiwan.net/poem53654.html","الطويل"],[459,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[459,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[469,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[543,"رطلان لا أزداد فوقهما","https://www.aldiwan.net/poem34020.html","أحذ الكامل"],[564,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"]],"verses":[["رَطْبُ الغِرارَيْنِ مأمونٌ على بَطَلٍ","يَخشى زَماناً على الأحرارِ مُتَّهَما",0,"م",2,0],["رُطَبٌ من الطَّلع النضيد كأنها","قد نُظِّمت من حسنها أسلاكا",1,"ك",2,0],["رطِّب حياتك بالغناء إذا عرا","هَمٌ يُجَفِّف في الحُلوق الريقا",2,"ق",2,0],["رطّب تراكيبك إن","جفّت بماء الورقِ",3,"ق",1,1],["رَطبُ الغَمامِ إِذا ما اِستُمطِرَت يَدُهُ","جاءَت مَواهِبُهُ قَبلَ المَواعيدِ",4,"د",1,0],["رَطيبٌ بِأَنفاسِ الصِبا وَنَدى الصَبا","فَقَد رَقَّ حَتّى كادَ يَجري فَيَسكُبُ",5,"ب",1,0],["رَطبِ الكَلامِ عَلى سَماعِ جَليسِهِ","فَكَأَنَّ في فيهِ لِسانَ مُبَشِّرِ",6,"ر",1,0],["رَطيبِ النَسيمِ كَأَنَّ الصَبا","تُجَرِّرُ فيهِ ذُيولَ الغَمامِ",7,"م",1,0],["ر|طاباً كأنفاس النسائم سَحرةً","عِذاباً كماء الرافدين المصفقَّ",8,"ق",1,0],["رطب الشمائل ضاحك عن مبسم","نبتت لآلئه على المرجان",9,"ن",1,0],["رطب البنان كأنّ من ألفاظه","راحاً لسلب العقل بالمراصاد",10,"د",1,0],["رَطْبِ اللّسانِ يَبُثُّ سرّاً كامِناً","خِلْوِ الجَنانِ يَحُثُّ دَمعاً مُسبَلا",11,"ل",2,0],["رَطيبٌ وَعودُ النَصبِ اذ ذاكَ يابِسٌ","فَللنارِ في تِلكَ الجُسومِ لَهيب",12,"ب",1,0],["رَطِبَتْ بالشكر صِدقا شَفَتي","منذُ ألقيتُ إلى بحرك شَنِّي",13,"ن",2,0],["رطابُ النطق بسّامو المجالي","إذا ما أيبسَ الفَرَقُ الحُلوقا",14,"ق",2,0],["رَطبٌ نَضيجٌ فائِقٌ لَذيذُ","يَعومُ في الدَهنِ بِهِ السَميذُ",15,"ذ",1,0],["رَطلانِ لا أزداد فَوقَهما","في الشرب إن حَضَروا وإن وَحدي",16,"د",2,1],["رَطبُ اللآلي بَعيدٌ","مِن ثَغرِها في الصِقالِ",17,"ل",1,0]]}