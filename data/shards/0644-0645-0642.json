{"poems":[[95,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[33,"عجبا ما عجبت مما لو أبصرت","https://www.aldiwan.net/poem42603.html","الخفيف"],[164,"لم قدموا العجم إن كان الحديث كذا","https://www.aldiwan.net/poem58701.html","البسيط"],[244,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[259,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[438,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[447,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[457,"علقته حين ارجحن به الصبا","https://www.aldiwan.net/poem13695.html","الكامل"],[463,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[466,"طرب الزمان وأنجمت أشجانه","https://www.aldiwan.net/poem15145.html","الكامل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82250","الخفيف"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79953","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71067","الكامل"],[2057,"","https://poetry.dctabudhabi.ae/diwan/poem/130455","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102126","المقتضب"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102139","المديد"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33869","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28048","الكامل"],[2253,"","https://poetry.dctabudhabi.ae/diwan/poem/115143","الخفيف"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93429","الطويل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34744","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65121","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130130","الكامل"],[3250,"","https://poetry.dctabudhabi.ae/diwan/poem/144401","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91010","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81732","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73131","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72412","الخفيف"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105171","الرجز"],[4767,"وزير الماء *","https://www.poetsgate.com/ViewPoem.aspx?id=94074",""],[4888,"الوأد في البحار","https://www.poetsgate.com/ViewPoem.aspx?id=207761",""],[5285,"سميرة","https://www.poetsgate.com/ViewPoem.aspx?id=203519",""],[5644,"ثوب العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=204444",""],[5770,"الحلم الذي ولَّى","https://www.poetsgate.com/ViewPoem.aspx?id=178680",""],[5956,"من الجلوس اللّا سليم ظهر نجلي اْحدَودَب","https://www.poetsgate.com/ViewPoem.aspx?id=194784",""],[4222,"أجيران جيرون مالي مجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52786&r=&rc=78",""]],"verses":[["لمقدمك الميمون مصر تهللت","وجناتها افترت وبلبلها شدا",0,"د",2,0],["لِمُقارِفِ البُهتانِ غَيرُ مُقارِفٍ","وَمِنَ البَعيدِ الرَهطِ غَيرُ بَعيدِ",1,"د",1,0],["لِمَقالِ الصَفِيَّ فيمَ التَجَنّي","وَلِما قَد جَفَوتَني وَهَجَرتا",2,"ت",2,0],["لم قدموا العجم إن كان الحديث كذا","على الصحابة أهل الفضل والنسب",3,"ب",1,1],["لمقامك التعظيمُ والتبجيلُ","ولشخصِك التكريمُ والتفضيل",4,"ل",1,1],["لِمَ قلبي، بعدُ عقلي","فوق جهدي حَمَّلاني؟",5,"ن",2,0],["لمُقَبِّلٍ طولَ الزمانِ بساطَهُ","والورد لَيْسَ مَدَى الزَّمانِ يُقَبَّلُ",6,"ل",1,0],["لمقبول وغيركم","لمحض العلم لم يجب",7,"ب",1,0],["لمقرِّ أوطارٍ ومأْلَفِ صبوةٍ","تروى بها أحشاؤنا وتُرَوحُ",8,"ح",1,0],["لمقتدِحين في كبدي وساروا","لواعجَ ما لقاطنها بَراحُ",9,"ح",1,0],["لمقام أبلجَ في العَلاء مُحلّقٍ","فوق النجوم مقامه ومكانهُ",10,"ن",2,0],["لمقامٍ زَلخٍ فَلَمّا أَجَنّوا","شَخصَهُ وَاِرتَقوا وَلَيسَ بِراقي",11,"ق",2,0],["لِمُقتِرٍ فِي غَيرِ شَرخِ الزَّمَنِ","وَسَائِلِي بِمُزعِجِي عَن وَطَنِ",12,"ن",1,0],["لمقلِّمٍ ظفرَ الخطوب بنجدةٍ","قلقتْ لأفواه النوائب نابَها",13,"ب",3,0],["لم قد أمنت سواه زعيماً","ما عدى منهج الرشاد سواها",14,"ا",3,0],["لمقامه السامي تُلِمُّ بُرتْبَةٍ","أَطهر بها من سوحة وحريمِ",15,"م",1,0],["لمقامه المحمود وسع قد جمع","كل المقامات العلا وبها سطع",16,"ع",1,0],["لمّ قحط ظاهرنا","وكذاك باطننا",17,"ن",2,0],["لمقدِمنا بذلك مع","نائهينا وكل معتضدي",18,"د",2,0],["لِمُقلَتِهِ الحَوراءِ في كُلِّ لَحظَةٍ","مَواقِعُ سِحرٍ مِن قُلوبِ رِجالِ",19,"ل",1,0],["لمقام من يرجى العلو لذاته","ومقام من يرجو المقام الأنزل",20,"ل",1,0],["لمقام النبيّ أحمد أو مث","لِ مقام الخليلِ إبراهيمِ",21,"م",1,0],["لمقليهِ لَيلٌ لَهُ مِن هُمُومِهِ","دُجاهُ وَمِن وَجدٍ تَضَمَّنَ دائِمُه",22,"م",2,1],["لِمُقرَسٍ ذكر أخي ثِقَةٍ","لم يَغذهُ التأنيثُ واللّقطُ",23,"ط",1,0],["لمقدم مولانا أبي الحسن الرّضا","عليّ فعلّى شأنه مالكُ الأمر",24,"ر",1,0],["لِمَقامهِ طولَ السنة","مُتَنقّلاً في الأمكنة",25,"ه",1,0],["لم قد هويت جفاءه","وتركته بغرامه",26,"م",2,0],["لِمُقتَضى أَخلاقِهِ المُهَذَّبَه","إِختارَ مِن بَينِ الوَرى أَن يَصحَبُهُ",27,"ه",1,0],["لمقام الولي عبد الغني مذ","شاد ارخت نال أجرا عظيما",28,"م",2,0],["لمُقْرِىء مَقْرَى كقُمريها","غناءٌ فصيحٌ وشَدْوٌ جَهيرُ",29,"ر",1,0],["لمقام الملك الهمام أبي يَح","يى الذي الجود من يديه سجيّه",30,"ي",2,0],["لُمقِلتيكَ النَّجلا نَشاطٌ وقوَّةٌ","على قتلنِا وهيَ الضَّعيفةُ والكَسلَى",31,"ل",2,0],["لمقام ما فوقه من مقام","فالتزم مدحه أشدَّ التزام",32,"م",1,0],["لمقلتيه السحر ينمى لا إلى","هاروت بل لغيره لم يسند",33,"د",1,0],["لمقدمكم وزوروها","تروا في عينها فاقة",34,"ق",2,0],["لمَ قد يموتُ الطفلُ وهو مهاجرٌ","عن حُلمه ويُكَبُّ بالشطآنِ",35,"ن",1,0],["لمَ قد هجرتِ أيا سميرةُ حيَّنا","وتركتِنا في حسرةٍ تُسبينا",36,"ن",2,0],["لم قد تركت الحب يقتله النوى","وجعلته في غربةٍ منفيا",37,"ي",2,0],["لمَ قطرة الأمل البهي","جِ تضيع في وهج الهواجر ؟",38,"ر",1,0],["لِمَ قبل أن يهوي يقيم رياضة","يومية لتصون قلبه طيبا؟",39,"ب",2,0],["لمقرئ مقرى كقمريها","غناء فصيح وشدو جهير",40,"ر",1,0]]}