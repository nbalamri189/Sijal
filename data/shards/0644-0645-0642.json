{"poems":[[93,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[31,"عجبا ما عجبت مما لو أبصرت","https://www.aldiwan.net/poem42603.html","الخفيف"],[161,"لم قدموا العجم إن كان الحديث كذا","https://www.aldiwan.net/poem58701.html","البسيط"],[240,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[255,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[433,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[442,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[453,"علقته حين ارجحن به الصبا","https://www.aldiwan.net/poem13695.html","الكامل"],[459,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[462,"طرب الزمان وأنجمت أشجانه","https://www.aldiwan.net/poem15145.html","الكامل"]],"verses":[["لمقدمك الميمون مصر تهللت","وجناتها افترت وبلبلها شدا",0,"د",2,0],["لِمُقارِفِ البُهتانِ غَيرُ مُقارِفٍ","وَمِنَ البَعيدِ الرَهطِ غَيرُ بَعيدِ",1,"د",1,0],["لِمَقالِ الصَفِيَّ فيمَ التَجَنّي","وَلِما قَد جَفَوتَني وَهَجَرتا",2,"ت",2,0],["لم قدموا العجم إن كان الحديث كذا","على الصحابة أهل الفضل والنسب",3,"ب",1,1],["لمقامك التعظيمُ والتبجيلُ","ولشخصِك التكريمُ والتفضيل",4,"ل",1,1],["لِمَ قلبي، بعدُ عقلي","فوق جهدي حَمَّلاني؟",5,"ن",2,0],["لمُقَبِّلٍ طولَ الزمانِ بساطَهُ","والورد لَيْسَ مَدَى الزَّمانِ يُقَبَّلُ",6,"ل",1,0],["لمقبول وغيركم","لمحض العلم لم يجب",7,"ب",1,0],["لمقرِّ أوطارٍ ومأْلَفِ صبوةٍ","تروى بها أحشاؤنا وتُرَوحُ",8,"ح",1,0],["لمقتدِحين في كبدي وساروا","لواعجَ ما لقاطنها بَراحُ",9,"ح",1,0],["لمقام أبلجَ في العَلاء مُحلّقٍ","فوق النجوم مقامه ومكانهُ",10,"ن",2,0]]}