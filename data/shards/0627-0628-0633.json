{"poems":[[53,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[72,"كيف قاسوا قد الحبيب بغصن","https://www.aldiwan.net/poem20160.html","الخفيف"],[91,"إبسمي كالورد في فجر الصباء","https://www.aldiwan.net/poem8733.html","عموديه"],[85,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[91,"ابسمي","https://www.poetsgate.com/ViewPoem.aspx?id=53427",""],[130,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[227,"الغيرة","https://www.aldiwan.net/poem24242.html","عموديه"],[276,"أبستان الرصافة لا","https://www.aldiwan.net/poem25505.html","مجزوء الوافر"],[286,"طرب الهزار وعمت البشرى فما","https://www.aldiwan.net/poem39429.html","الكامل"],[364,"أشاقتك أظعان بجفن يبنبم","https://www.aldiwan.net/poem1707.html","الطويل"],[372,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[372,"دار ما دار بيننا وتردد","https://www.aldiwan.net/poem57500.html","الخفيف"],[483,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"]],"verses":[["أَبَسَّت بِهِ ريحُ النُعامى مَنيحَةً","كَما جَعجَعَ الوَهمُ الثَفالُ لِيَعقِرا",0,"ر",2,0],["أبسطُ العالمين بأساً وجوداً","يوم يفني العدَاة أو يوم يغني",1,"ن",2,0],["إِبسِمي كَالوَردِ في فَجرِ الصَباء","وَاِبسُمي كَالنَجمِ إِن جُنَّ المَساء",2,"ا",2,1],["اُبسُط جَناحَيكَ اللَذَي","نِ هُما الطَهارَةُ وَالهِدايَه",3,"ا",3,0],["أَبِسَفْكِ مَاءِ المَدْمعِ الْهَطَّالِ","يُودَى دَمُ الشُّهَدَاء وَالأَبْطَالِ",4,"ل",1,1],["أبساطُ الورد ممدوٌ على","هذه الأقطارِ مَدَّ البصر",5,"ر",1,0],["إبسمي كالورد في الفجر الصباء","وابسمي كالنجم إن جنّ المساء",6,"ا",2,1],["أُبسُط يديكَ وحُلَّ أسرَ","الروحِ من هذا الرُفاتِ",7,"ت",1,0],["ابسمي ، تبسم الحياةُ وترضى","وامنحيني اليقين ، أمنحك حبّا !",8,"ب",2,0],["أبُسْتَانَ الرّصَافَة لا","هَوِيتُ سِوَاكَ بُسْتَانا",9,"ن",2,1],["ابسط يديك إلى الجهات مراقبا","قطب الشمال وجاوزن بحر السفيد",10,"د",1,0],["أَبَسَّت بِهِ ريحُ الجَنوبِ فَأَسعَدَت","رَوايا لَهُ بِالماءِ لَمّا تَصَرَّمِ",11,"م",1,0],["ابسُط على النائِباتِ بأسَك لا","مُرتهناً مُبقِياً ولا آسِر",12,"ر",1,0],["أبسطُ التيه والدليلُ قليلٌ","في طريقي وربَّما ليسَ يُوجَد",13,"د",1,0],["أبسط علينا من أيادي الامتنان","ما يثلج الصدر له مدى الزمان",14,"ن",1,0]]}