{"poems":[[55,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[74,"كيف قاسوا قد الحبيب بغصن","https://www.aldiwan.net/poem20160.html","الخفيف"],[93,"إبسمي كالورد في فجر الصباء","https://www.aldiwan.net/poem8733.html","عموديه"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[92,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[93,"ابسمي","https://www.poetsgate.com/ViewPoem.aspx?id=53427",""],[133,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[231,"الغيرة","https://www.aldiwan.net/poem24242.html","عموديه"],[280,"أبستان الرصافة لا","https://www.aldiwan.net/poem25505.html","مجزوء الوافر"],[290,"طرب الهزار وعمت البشرى فما","https://www.aldiwan.net/poem39429.html","الكامل"],[368,"أشاقتك أظعان بجفن يبنبم","https://www.aldiwan.net/poem1707.html","الطويل"],[376,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[376,"دار ما دار بيننا وتردد","https://www.aldiwan.net/poem57500.html","الخفيف"],[487,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2457","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46467","الرمل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45614","الخفيف"],[2501,"","https://poetry.dctabudhabi.ae/diwan/poem/198534","الطويل"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89312","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111439","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111516","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45008","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117294","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83136","الخفيف"],[4718,"دن الدلال","https://www.poetsgate.com/ViewPoem.aspx?id=137175",""],[4829,"التوابع والزوابع","https://www.poetsgate.com/ViewPoem.aspx?id=34253",""],[4830,"قاريء الكَفّ","https://www.poetsgate.com/ViewPoem.aspx?id=198916",""],[4849,"والله العظيم إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=53515",""],[4916,"ياشيب عيني","https://www.poetsgate.com/ViewPoem.aspx?id=135374",""],[4931,"ورود الحب","https://www.poetsgate.com/ViewPoem.aspx?id=31111",""],[5170,"وجه البدر","https://www.poetsgate.com/ViewPoem.aspx?id=175543",""],[5219,"جفف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=194802",""],[5225,"ياصاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=36751",""],[5370,"لعيونه","https://www.poetsgate.com/ViewPoem.aspx?id=85510",""],[5389,"رواية الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=213987",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5509,"محاولات لاصطياد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=93490",""],[5626,"اربأ بنفسك","https://www.poetsgate.com/ViewPoem.aspx?id=189715",""],[5652,"سلام ياهامة بعيدات الاذهان","https://www.poetsgate.com/ViewPoem.aspx?id=181104",""],[5736,"ابسط جناحك","https://www.poetsgate.com/ViewPoem.aspx?id=203814",""],[5747,"اللي خذاك بطيب خاطر رجعك","https://www.poetsgate.com/ViewPoem.aspx?id=61675",""],[5848,"عيضه","https://www.poetsgate.com/ViewPoem.aspx?id=50584",""],[5848,"يادنيا من أنتي له","https://www.poetsgate.com/ViewPoem.aspx?id=51938",""],[5848,"ماهيب الليلة أخلاقي","https://www.poetsgate.com/ViewPoem.aspx?id=48911",""],[5848,"عندي سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=48834",""],[5894,"أبسحر عينك قد وصلت بكائي","https://www.poetsgate.com/ViewPoem.aspx?id=131410",""],[5956,"تجلو المعاني لي كخير مترجمِ","https://www.poetsgate.com/ViewPoem.aspx?id=181983",""],[5956,"هلّل إلى التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=192293",""],[5956,"كم أبتغي إضحاككم","https://www.poetsgate.com/ViewPoem.aspx?id=192423",""],[5956,"فرحة العمل بالهدى","https://www.poetsgate.com/ViewPoem.aspx?id=192553",""],[6038,"بيعة الخسراني","https://www.poetsgate.com/ViewPoem.aspx?id=26802",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""]],"verses":[["أَبَسَّت بِهِ ريحُ النُعامى مَنيحَةً","كَما جَعجَعَ الوَهمُ الثَفالُ لِيَعقِرا",0,"ر",2,0],["أبسطُ العالمين بأساً وجوداً","يوم يفني العدَاة أو يوم يغني",1,"ن",2,0],["إِبسِمي كَالوَردِ في فَجرِ الصَباء","وَاِبسُمي كَالنَجمِ إِن جُنَّ المَساء",2,"ا",2,1],["اُبسُط جَناحَيكَ اللَذَي","نِ هُما الطَهارَةُ وَالهِدايَه",3,"ا",3,0],["أَبِسَفْكِ مَاءِ المَدْمعِ الْهَطَّالِ","يُودَى دَمُ الشُّهَدَاء وَالأَبْطَالِ",4,"ل",1,1],["أبساطُ الورد ممدوٌ على","هذه الأقطارِ مَدَّ البصر",5,"ر",1,0],["إبسمي كالورد في الفجر الصباء","وابسمي كالنجم إن جنّ المساء",6,"ا",2,1],["أُبسُط يديكَ وحُلَّ أسرَ","الروحِ من هذا الرُفاتِ",7,"ت",1,0],["ابسمي ، تبسم الحياةُ وترضى","وامنحيني اليقين ، أمنحك حبّا !",8,"ب",2,0],["أبُسْتَانَ الرّصَافَة لا","هَوِيتُ سِوَاكَ بُسْتَانا",9,"ن",2,1],["ابسط يديك إلى الجهات مراقبا","قطب الشمال وجاوزن بحر السفيد",10,"د",1,0],["أَبَسَّت بِهِ ريحُ الجَنوبِ فَأَسعَدَت","رَوايا لَهُ بِالماءِ لَمّا تَصَرَّمِ",11,"م",1,0],["ابسُط على النائِباتِ بأسَك لا","مُرتهناً مُبقِياً ولا آسِر",12,"ر",1,0],["أبسطُ التيه والدليلُ قليلٌ","في طريقي وربَّما ليسَ يُوجَد",13,"د",1,0],["أبسط علينا من أيادي الامتنان","ما يثلج الصدر له مدى الزمان",14,"ن",1,0],["أَبَسَّ بِها الفَوارِسُ فَاِستَطارَت","تُباري المُردَ بِالجِذَمِ الكُهولُ",15,"ل",1,0],["أَبٌ سنَّ في سبل المكارم سُنَّةً","تَقبَّلها الأبناءُ منهُ فأنجبَا",16,"ب",2,0],["أَبِسَيفٍ أَم بِجودٍ","أَم بِمَجد أَم سَناء",17,"ا",2,0],["أَبسط العُذر في التَأَخُر عَنكُم","شُغل الحلى أَهله أَن يُعارا",18,"ر",2,1],["أبسل عليك الماء حتى يشوبه","دم والكرى حتى تقض المضاجع",19,"ع",1,1],["أبسبق الْقَضَاءِ جَفَّ مِدادي","أَمْ بِجَمْرِ الْغَضَا أُذيبَ فُؤادي",20,"ي",1,1],["أَبْسَمَ اللَهُ للفضائل عبا","ساً وأولاه منه عمراً طويلا",21,"ل",2,0],["أبسم ثغرَ الشرق والحصونا","ومر يحلو مشرقاً مأمونا",22,"ن",2,0],["أَبسَلُ مَن في القَومِ طُرّاً غَرَبا","وَزَفسُ لي نَصراً مُبيناً وَهَبا",23,"ب",2,0],["أَبِسَيلِ الدِّماءِ زَفسُ مُشِيرٌ","أَم لِرَبطِ الإِخاءِ بالوَفقِ مالا",24,"ل",2,0],["أبسل من في القوم قرما صد","فليبرزا بكل ماضي الحد",25,"د",1,0],["ابسُط أَكُفَّكَ واملَ مِن بَركاتِهِ","وَاِكتَلَ كَما قالوا بِكَيلِ باجي",26,"ج",2,0],["أبستر حال قد ذوى غصن روضه","وأصبح من بعد النضارة في محل",27,"ل",1,0],["أَبسِمي لِلصَديقِ بَسمَةَ راضٍ","عَن هَواهُ يُنيلُ قُرباً بِقُربِ",28,"ب",1,0],["أَبسمي لِلوشاةِ بَسمَةَ زارٍ","ساخِرٍ بِالوشاةِ غَيرِ مُلبّي",28,"ب",2,0],["أبسمي للسَقيمِ بَسمة آسٍ","أَيُّ طبٍّ في سِحرِها أَيُّ طِبِّ",28,"ب",1,0],["أبسمي لِلزَمانِ بسمَةَ لاهٍ","لَيسَ يُلوي عَلى الزَمانِ بِعَتبِ",28,"ب",1,0],["أبسمي لِلحَياةِ بَسمَةَ راجٍ","يَنهَبُ العَيشَ بِالمُنى أَيّ نَهبِ",28,"ب",1,0],["أبسمي كُلُّ ما تَرَين جَميلٌ","كُلُّ شَيءٍ يَحلو بِقَلبِ المُحبِّ",28,"ب",1,0],["أَبسمي لِلظَلام يَبسِم بِصُبحٍ","وَأَبسِمي لِلصَباح بَسمَةَ عُجبِ",28,"ب",1,0],["أبسمي لِلرِياضِ يَبسِم لَكِ الزَ","زَهرُ وَيُكسَ النَباتُ نضرَةَ خِصبِ",28,"ب",1,0],["ابسِمي لِلمقِلِّ يَستَصغِر الكَو","نَ بِما فيهِ مِن ثَراءٍ وَكَسبِ",28,"ب",1,0],["ابسِمي لي إِذا سَأَلتُ لِقاءً","بَسمَةٌ مِنكِ لَو تَشائِينَ حَسبي",28,"ب",2,0],["ابسالك يامن تولعت بالمال","لازال مالك وش بقالك مجالي",29,"ل",2,0],["ابسئل كل ذو عقل(ن) لبيبن عن بعض اصناف","من الاجناس شذر الناس سقط القوم ثم ثمّه",30,"م",2,0],["أبسِطْ كفّيكَ على مَهلٍ","وَلِمَ الأنفاسُ بَدَتْ عَجلى",31,"ا",1,0],["ابسألك ياللي من القلب ماكن","ياللي تقول إن الغلا فيه تشكيك",32,"ك",1,0],["ابسط جناحينك ولو كلّك اقسام","واللي هوى المرقاب ينطح علوّه",33,"و",2,0],["أبسأل عنك يا اجمل من سكن هالقلب وضلوعه","وابروز صفحة كتاب الغلا باسمك مع أوصافك",34,"ك",1,1],["ابسألك عقب الجفا جهزت لشواقي زهاب","ولا ع الله ضيقتي ، لاصار حاديني القدر",35,"ر",1,0],["ابسم ففي بسماتكم طب لنا","يشفي الفؤاد دواؤه والأضلعا",36,"ع",2,0],["أبَسْألك عن صاحبٍ ما تعدّاك","رفيق دربك كان حَرْبٍ وْسِلْم",37,"م",1,0],["أبسطّها.. آخذ جوازي واجحد الجاحد","وآخذ شليلي بفمي.. واقول: لعيونه",38,"ن",2,0],["ابسبب هاي الفضائل شانئك عاداك","اوصِنَع من حِقده سمّ وسمّك الفاسق",39,"ق",1,0],["أبسفح حاجر منك يسفح محجر","ولسربه أسراب دمعك يهمر",40,"ر",1,1],["أب ٌ سوف يلقاك َ عذبًا طليقا","وأم ٌّ تصلي لكيما تراك ْ",41,"ك",1,0],["إِبْسُطْ ذِراعَكَ لِلْجَميلِ بِهِمَّةٍ","فَجَميلُ صُنْعِكَ خالِدُ الآجالِ",42,"ل",1,0],["ابسألك عن واحدٍ ماله إحسان","يمشي دروبٍ مايحسّب ضياعه ..!",43,"ع",2,0],["ابسط جناحَكَ غيمًا واحتضنْ حلمًا أن","يهطلَ الغيثُ يروي مهجةً فرحا",44,"ح",2,1],["ابسئلك..في ذمتك ليه المشاعر لك تجوع؟","مادام كلك لو خذا كلي قسم مايقنعك",45,"ك",1,0],["ابسط حقوقي هذي ابسط حقوقي","مادمت راحل لازم اعرف على وين",46,"ن",1,0],["ابسلك درب من قبلي طريق وقد مشوه الناس","احد راضي واحد مجبر ويا دنيا من انتي له",47,"ل",2,0],["أبسألني ولا ادري كيف أجاوبني","وانا اخلاقي ماهيب الليلة اخلاقي",48,"ق",2,0],["ابسألك وش اللي البارح اشغلك","وخلاك تنساني وانا ميتٍ فيك",49,"ك",1,0],["أبسحر عينك قد وصلت بكائي","أم باللحاظ صرمت حبل دوائي",50,"ا",2,1],["‏ابسِمْ قطعتَ نياط قلبي حسرة","‏ ‏ من هجرك الممجوجِ مثلَ العلقمِ",51,"م",1,0],["ابسم توحدت القلوب على الهدى","والوعيُ أصبح سيد الساداتِ",52,"ت",1,0],["ابسم إليّ فلست أعرف فرحة","إلّا قليلا حين رؤية طلعتكْ",53,"ك",1,0],["ابسم فما غيري أحقّ ببسمة","أو رحمة أو طيبة من مهجتكْ",53,"ك",1,0],["ابسم بوجهِ أخيك يا نورَ التقى","إن ابتسامك أكرم الصدقاتِ",54,"ت",1,0],["ابسالك وش ذنبي تروح وتنساني","ياللي وهبتك رقه احساسي وطيبي",55,"ب",2,0],["ابسألك بس لا تهتال","قبل انسف البعد ويشّرك",56,"ك",1,0]]}