بَخُلَت عَيني إِذاً لَعَسَفتُها","فَكَيفَ وَدَمعُ الناظِرينَ كَريمُ",1,"م",1,0],["وَلَو بِأَبي العَوّامِ كانَ مُناخُها","لَغامِرَ عَنها اللَوذَعِيُّ المُغامِرُ",2,"ر",1,0],["وَلو بَسَطتَ يَميناً بِالعِراقِ إِذاً","نالَتهُ وَهوَ بَعيدُ الدارِ مَطرودُ",3,"د",1,0],["وَلَو بَلَغَ المُنى إِنسانُ عَيني","خَلا مِنها وَأَسكَنَكَ الحُجاجا",4,"ج",2,0],["ولو بَذَلَ البَدْرُ النّجومَ لخاطِبٍ","لمَدَّ إِلى ثَرْوانَ باعَ المُصاهِرِ",5,"ر",1,0],["ولوْ بَقِيَتْ في المَشْرَفيّةِ هَبّةٌ","ضَرَبْتُ لداعِي الحَيّ بالخِصْبِ مَوعِدا",6,"د",2,0],["وَلَو بانَ مِن مُلكي لَبِتُّ مُسَهَّداً","وَنَبهانُ عَمّابي مِن الشَجوِ نائِمُ",7,"م",1,0],["وَلَو بَلَغَ القَتيلَ فِعالُ حُيٍّ","لَسَرَّكَ مِن سيوفِكَ مُنتَضوها",8,"و",3,0],["وَلَو بَعَثتُ عَلى مِقدارِ فَضلِكَ أَر","سَلتُ الكَواكِبَ فيها الشَمسُ وَالقَمَرُ",9,"ر",1,0],["وَلوَ بَذَلَت أُمُّ الوَليدِ حَديثَها","لِعُصمٍ بِرَضوى أَصبَحَت تَتَقَرَّبُ",10,"ب",1,0],["ولو باح كلٌّ بالذي هو كاتمٌ","لما كان في هذا الأنام أديب",11,"ب",1,0],["ولو بلغت ما مسَّه من مصابها","لكادت به في جنَّة الخلد تجزع",12,"ع",1,0],["ولو بَلَّغْتني عنك أذْني أقمتُها","لديَّ مُقامَ الكاشح المُتكذّبِ",13,"ب",1,0],["وَلَو بِبَني ذُبيانَ بَلَّت رِماحُنا","لَقَرَّت بِهِم عَيني وَباءَ بِها وِتري",14,"ر",2,0],["وَلَو باتَ يَسري الذَرُّ فَوقَ جُلودِها","لَأَثَّرَ في أَبشارِهِنَّ مُحيلُها",15,"ل",3,0],["وَلَو بُلِّغَ الناسُ ما بُلِّغَت","لَخانَتهُمُ حَولَكَ الأَرجُلُ",16,"ل",1,0],["وَلَو بِتُّما عِندَ قَدرَيكُما","لَبِتَّ وَأَعلاكُما الأَسفَلُ",16,"ل",1,0],["وَلَو بَرَزَ الزَمانُ إِلَيَّ شَخصاً","لَخَضَّبَ شَعرَ مَفرِقِهِ حُسامي",17,"م",2,0],["وَلَو بَدَت لَأَتاهَتهُم فَحَجَّبَها","صَونٌ عُقولَهُمُ مِن لَحظِها صانا",18,"ن",2,0],["وَلَو بَصُرَت عَيناهُ بِالزَوِّ لَاِزدَرى","حَقيرَ الَّذي نالَت يَداهُ مِنَ الأَمرِ",19,"ر",1,0],["وَلَو بِعتُ يَوماً مِنكَ بِالدَهرِ كُلِّهِ","لَفَكَّرتُ دَهراً ثانِياً في اِرتِجاعِهِ",20,"ع",2,0],["وَلَو بَلَغَ الجاني أَقاصِيَ حِلمِهِ","لَأَعقَبَ بَعدَ الحِلمِ مِنهُ التَحَلُّمُ",21,"م",1,0],["وَلَو بِعنا أُسَيِّدَ لَم تَزِدنا","أُسَيِّدُ قَتَّتَينِ عَلى حِمارِ",22,"ر",1,0],["وَلَو بِأُباضَ إِذ لاقَوا جِلاداً","بِأَيدي مِثلِهِم وَسُيوفُ كُفرِ",23,"ر",1,0],["ولو بَعُدَتْ قِبابُكَ قابَ قوسٍ","من الواشينَ حَيَّينا القِبابا",24,"ب",2,0],["وَلَو بَرَزَت في جَحفَلٍ تَحتَ عَنتَرٍ","لَجُدِّلَ وَاِنفَلَّت جُيوشُ بَني عَبسِ",25,"س",1,0],["وَلَو بِمَدحِ المُؤَيَّدِ اِعتَبَروا","لَبُدِّلَت سَيِّئاتُهُم حَسَنَه",26,"ن",2,0],["وَلَو بُعِثْتَ غَدَاً أَصْبَحْتَ تَحْفَظُنَا","بِالاسْمِ وَالوَجْهِ أَوْ أَحْصَيْتَنَا عَدَدَا",27,"د",2,0],["وَلَو بَصُرَت بِهِ لَرَأَت جَريضاً","بِماءِ الدَهرِ حِليَتُهُ الشُحوبُ",28,"ب",1,0],["ولو بلغَ الجاهلونَ السُّها","فما تحتَ موضعِهِمْ موضعُ",29,"ع",1,0],["وَلَو باتَ وَالهُجرانُ يَصدُعُ قَلبَهُ","لَجادَ بِوَصلٍ دائِمٍ آخَرَ الدَهرِ",30,"ر",1,0],["وَلَو بَقِيَت لِأَدرَكَها مُزيلٌ","بِريبِ الدَهرِ مِن عَجمٍ وَضَرسِ",31,"س",1,0],["وَلَو بِمُشارِ العَينِ يوحى إِلَيهِما","لِوَشكِ اِعتِزالِ العَيشِ لَاِعتَزَلاهُ",32,"ل",3,0],["وَلَو بَينَ دُنيانا الدَنيَّةِ خُيِّرَت","وَبَينَ سِواها ماءَرادَت سِوى الدُنِّيا",33,"ي",2,0],["ولو بذلت أدنى الحديث لعاقل","خذول إذا ما أفضت العصم يجلس",34,"س",1,0],["ولَوْ بَذَلَتْ حُسْنَ مَا عِنْدَهَا","لِبَارِحِ أَرْوَى نَوَارٍ مُسِنْ",35,"ن",1,0],["ولو بِعْتُ دِرْعِي سُقْتُ يا هندُ للفتى","هُنَيْدَةَ ألْقَى الرّاعِيانِ إفالَها",36,"ل",3,0],["ولو بَرَدَى أنّتْ لخطبٍ مياهُه","لسالتْ بوادي النيلِ للنيل أدمُع",37,"ع",1,0],["ولو بعدت في النفس منزعة التقى","لما نزعت نحو الشقاق المنازع",38,"ع",1,0],["ولو بحثت عن دائها كان كبرها","فمنه بلا قيد تثور الشنائع",38,"ع",1,0],["ولو بلغت دون السَّماءِ قبيلة","لزادت عليها نهشلٌ وتغلَّتِ",39,"ت",1,0],["ولوبِنتَ – لا بنتَ – عن ذا المحيط","لضاق عليَّ بأقطاره",40,"ر",2,0],["ولو بدَتْ لهمُ الدُّنيا بزيِنتها","لقابلوها بتبجيلٍ وإطراء",41,"ا",2,0],["ولو بهما مُتّعتُ ما زلتُ ساخطاً","على الدهر إذ لم يَحْبُني حاجةً أُخرى",42,"ر",2,0],["ولو بُعدَ المسَرى زجرنا على الوجَى","أغرَّ وجيهيٍّا ووجناءَ جَلْعَدا",43,"د",2,0],["ولو بذلوا لي كلَّ بحر بدمعة","على الأرض عدَّت همتي الدمع مأثما",44,"م",2,0],["ولو بَلي تحت أطباق الثرى جسدي","لكنتُ أبلى وما قلبي لكم ناسِ",45,"س",1,0],["ولو بِكُمُ ما بي لزرتم ولو على","حدودِ السريجيات كالبرقِ أو أمضى",46,"ض",2,0],["ولو بغير الهوى جوزيت في سنن","وجدتني غير رعديد ولا سمج",47,"ج",1,0],["وَلَو بِالفيلِ مِمّا بِ","كَ عشرٌ ما نَجا الفيلُ",48,"ل",1,0],["وَلَو بسط الهَوى العذرى عذري","لما قاسيت سنة قيس لبنى",49,"ن",2,0],["ولَوْ بَرَّدَ السُّلْوانُ حَرَّ جَوانِحِي","لآثَرْتُ عَنْ طَوْعٍ سُلُوَّ البَهائِمِ",50,"م",1,0],["وَلَوْ بَذَلَ الْيسِيرَ لَبَلَّ شَوْقي","وَقَدْ يَرْوى الظِّمَاءُ مِنَ الثِّمَادِ",51,"د",1,0],["ولو بدا فبدور الأفق في خجل","ترخي على وجهها من سحبها نقب",52,"ب",1,0],["وَلَوْ بَالَغْتُ قُلْتُ يمين يَحْيى","وَلكنِي علَى هَاتِيكَ حَاسِدْ",53,"د",1,0],["وَلَو بَلَغوا في الهَديِ بِالحُبِّ كَعبَةً","سِوى كَعبَتي لَم يَقبَلِ اللَهُ مِنهُمُ",54,"م",1,0],["وَلَو بَدَت تجلى لَدى راهب","لَبادَرَ التَبخّر بِالعَنبرِ",55,"ر",1,0],["ولو بِقَدرِكَ أُهدِي","َمَا وَجدتُ هَدِيّه",56,"ه",1,1],["وَلَو بِعَيني رَأَوا ما قَد رَأَيتَ لما","لاموا وَلكِنَّهُم مِن لُؤمِهِم خَبِثوا",57,"ث",3,0],["وَلَو بَقيتَ عُمُراً تُكَرِّرُه","ما عِندَ عفوِ اللَهِ ذَنبٌ يُكبِرُه",58,"ه",1,0],["ولو بِعتُ ساعةَ لُقيانه","بدهْرٍ سواهُ لكُنْتُ الغَبينا",59,"ن",2,0],["وَلَو بَدَّلوني مِن مَلامٍ شَفاعَةً","إِلى مَن عَلَيهِ اللَومُ لَاِعتَدَلَ الأَمرُ",60,"ر",1,0],["ولو بلغوا من عشر تسعين نصفها","تبيَّنَ في تركي القيام لهم عذري",61,"ي",1,0],["ولو بذل الأنام الجهدَ كيما","يُصار لفضلك المحسود ثان",62,"ن",1,0],["وَلَو بحتُ بِالشَكوى لرقت لَها العِدى","وَذابَت لَها صم الحَصا وَالجلامدُ",63,"د",1,0],["ولو بَدتْ لبني العبّاس عزمتُهُ","لروّعتْ كلَّ مأمونٍ ومؤتمنِ",64,"ن",1,0],["ولو بالقتل إن عنهم تأبَّى","بلا خوف هناك ولا احتشام",65,"م",1,0],["وَلَو بكتِ الوَرَقُ الحَمائِم شَجوها","بَعَيني مَحا أَطواقهُنَّ انسِجامُها",66,"م",3,0],["وَلَو بارى بِجودِ يَدَيهِ بَحراً","لآل البَحرُ كالآلِ المروعِ",67,"ع",1,0],["ولو بعصا موسى اتقيت لآدها","على ما بها من قوة حمل ثقلي",68,"ل",2,0],["ولو بَسطَتْ أيدي الحوادِثِ مِن يدي","تلقتْهُمُ قبلَ السُّؤال بِنائِلي",69,"ل",2,0],["ولو بدا ثغرها يوما رايت له","برقا تألق للابصار مختطفا",70,"ف",2,0],["