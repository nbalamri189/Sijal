{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"عطون بأعناق الظباء وأشرقت","https://www.aldiwan.net/poem29798.html","الطويل"],[53,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[63,"أبت إبلي والليل وحف الغدائر","https://www.aldiwan.net/poem46167.html","الطويل"],[63,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[42,"يديرونني عن سالم وأديرهم","https://www.aldiwan.net/poem50222.html","الطويل"],[24,"لقد ولى أليته جؤي","https://www.aldiwan.net/poem21889.html","الوافر"],[71,"يا أيها الصاحب الصدر الذي شهدت","https://www.aldiwan.net/poem3940.html","البسيط"],[35,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[88,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[51,"أتاني مقال من أخ فاغتفرته","https://www.aldiwan.net/poem8311.html","الطويل"],[29,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[43,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[43,"أبا عبد الإله معاذ إني","https://www.aldiwan.net/poem10533.html","الوافر"],[43,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[45,"حبيب سرى في خفية وعلى ذعر","https://www.aldiwan.net/poem63632.html","الطويل"],[45,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[45,"خيال ملم أم حبيب مسلم","https://www.aldiwan.net/poem65652.html","الطويل"],[28,"ستخلع في فصافص ما سقتها","https://www.aldiwan.net/poem5188.html","الوافر"],[28,"ستبلغ مدحة غراء عني","https://www.aldiwan.net/poem5230.html","الوافر"],[61,"أجانبها حذارا لا اجتنابا","https://www.aldiwan.net/poem51817.html","الوافر"],[66,"ولي فرس ليست شكورا وإنما","https://www.aldiwan.net/poem38621.html","الطويل"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[44,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[48,"سقى الله ظبيا مبدي الغنج في الخطر","https://www.aldiwan.net/poem63298.html","الطويل"],[46,"تعالي قدرة وخفوت جرس","https://www.aldiwan.net/poem22835.html","الوافر"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[46,"لعمري لقد بعنا القناء نفوسنا","https://www.aldiwan.net/poem23608.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16698","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[22,"لَعَمْرُكَ ما ذَمَّتْ لَبُونِي ولا قَلَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=19733",""],[90,"هجرت الديار","https://www.poetsgate.com/ViewPoem.aspx?id=178969",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[143,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[200,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[205,"لو حز بالسيف رأسي في محبتكم","https://www.aldiwan.net/poem53114.html","البسيط"],[213,"أمالئة الحجلين ذبت بحبكم","https://www.aldiwan.net/poem37868.html","الطويل"],[262,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[270,"أبا الأطول طولت","https://www.aldiwan.net/poem26458.html","الهزج"],[272,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[276,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[281,"أمني النفس وصلا من سعاد","https://www.aldiwan.net/poem60785.html","الوافر"],[304,"إذا ثنى سلب الألباب عطفه","https://www.aldiwan.net/poem58313.html","البسيط"],[349,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[350,"أثمة أرباب الصبابة يمموا","https://www.aldiwan.net/poem15884.html","الطويل"],[354,"مرت بنا بيضاء أعطافها","https://www.aldiwan.net/poem40231.html","السريع"],[358,"ولو بقدرك أهدي","https://www.aldiwan.net/poem4142.html","المجتث"],[362,"يا عاذلي لا تلمني انه عبث","https://www.aldiwan.net/poem68128.html","البسيط"],[365,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[365,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[367,"لها نظرة لا يدعي فعلها الخمر","https://www.aldiwan.net/poem16998.html","الطويل"],[370,"تركت قيامي للصديق يزورني","https://www.aldiwan.net/poem4268.html","الطويل"],[370,"بحمد الله وافتنا التهاني","https://www.aldiwan.net/poem4312.html","الوافر"],[381,"أكابد من برح النوى ما أكابد","https://www.aldiwan.net/poem48773.html","الطويل"],[403,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[404,"إلى الأشراف أعيان الأنام","https://www.aldiwan.net/poem33410.html","الوافر"],[407,"هل الوجد إلا أن تلوح خيامها","https://www.aldiwan.net/poem50126.html","الطويل"],[407,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[410,"أريد عصا من أبنوس تقلني","https://www.aldiwan.net/poem31664.html","عموديه"],[410,"توالى إلي السائلون وإنني","https://www.aldiwan.net/poem32062.html","الطويل"],[438,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[440,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[440,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[442,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[459,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[459,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[459,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[462,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[483,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[516,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[539,"صدعت بحبه من بعد كتمي","https://www.aldiwan.net/poem48161.html","عموديه"],[554,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[559,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[563,"من عاش في الأرض لا يخلو من الكمد","https://www.aldiwan.net/poem52790.html","البسيط"],[568,"أبى الدهر إلا فعالا خسيسا","https://www.aldiwan.net/poem69635.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"],[587,"أما ولآل من شتيت ابتسامه","https://www.aldiwan.net/poem17501.html","الطويل"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَلَو بِاِبنِ لَيلى كانَ مَلقى رِحالِها","لَطَرَّقَ مِن حُرِّ النُضارِ ثَراها",0,"ا",3,0],["وَلَو بَخُلَت عَيني إِذاً لَعَسَفتُها","فَكَيفَ وَدَمعُ الناظِرينَ كَريمُ",1,"م",1,0],["وَلَو بِأَبي العَوّامِ كانَ مُناخُها","لَغامِرَ عَنها اللَوذَعِيُّ المُغامِرُ",2,"ر",1,0],["وَلو بَسَطتَ يَميناً بِالعِراقِ إِذاً","نالَتهُ وَهوَ بَعيدُ الدارِ مَطرودُ",3,"د",1,0],["وَلَو بَلَغَ المُنى إِنسانُ عَيني","خَلا مِنها وَأَسكَنَكَ الحُجاجا",4,"ج",2,0],["ولو بَذَلَ البَدْرُ النّجومَ لخاطِبٍ","لمَدَّ إِلى ثَرْوانَ باعَ المُصاهِرِ",5,"ر",1,0],["ولوْ بَقِيَتْ في المَشْرَفيّةِ هَبّةٌ","ضَرَبْتُ لداعِي الحَيّ بالخِصْبِ مَوعِدا",6,"د",2,0],["وَلَو بانَ مِن مُلكي لَبِتُّ مُسَهَّداً","وَنَبهانُ عَمّابي مِن الشَجوِ نائِمُ",7,"م",1,0],["وَلَو بَلَغَ القَتيلَ فِعالُ حُيٍّ","لَسَرَّكَ مِن سيوفِكَ مُنتَضوها",8,"و",3,0],["وَلَو بَعَثتُ عَلى مِقدارِ فَضلِكَ أَر","سَلتُ الكَواكِبَ فيها الشَمسُ وَالقَمَرُ",9,"ر",1,0],["وَلوَ بَذَلَت أُمُّ الوَليدِ حَديثَها","لِعُصمٍ بِرَضوى أَصبَحَت تَتَقَرَّبُ",10,"ب",1,0],["ولو باح كلٌّ بالذي هو كاتمٌ","لما كان في هذا الأنام أديب",11,"ب",1,0],["ولو بلغت ما مسَّه من مصابها","لكادت به في جنَّة الخلد تجزع",12,"ع",1,0],["ولو بَلَّغْتني عنك أذْني أقمتُها","لديَّ مُقامَ الكاشح المُتكذّبِ",13,"ب",1,0],["وَلَو بِبَني ذُبيانَ بَلَّت رِماحُنا","لَقَرَّت بِهِم عَيني وَباءَ بِها وِتري",14,"ر",2,0],["وَلَو باتَ يَسري الذَرُّ فَوقَ جُلودِها","لَأَثَّرَ في أَبشارِهِنَّ مُحيلُها",15,"ل",3,0],["وَلَو بُلِّغَ الناسُ ما بُلِّغَت","لَخانَتهُمُ حَولَكَ الأَرجُلُ",16,"ل",1,0],["وَلَو بِتُّما عِندَ قَدرَيكُما","لَبِتَّ وَأَعلاكُما الأَسفَلُ",16,"ل",1,0],["وَلَو بَرَزَ الزَمانُ إِلَيَّ شَخصاً","لَخَضَّبَ شَعرَ مَفرِقِهِ حُسامي",17,"م",2,0],["وَلَو بَدَت لَأَتاهَتهُم فَحَجَّبَها","صَونٌ عُقولَهُمُ مِن لَحظِها صانا",18,"ن",2,0],["وَلَو بَصُرَت عَيناهُ بِالزَوِّ لَاِزدَرى","حَقيرَ الَّذي نالَت يَداهُ مِنَ الأَمرِ",19,"ر",1,0],["وَلَو بِعتُ يَوماً مِنكَ بِالدَهرِ كُلِّهِ","لَفَكَّرتُ دَهراً ثانِياً في اِرتِجاعِهِ",20,"ع",2,0],["وَلَو بَلَغَ الجاني أَقاصِيَ حِلمِهِ","لَأَعقَبَ بَعدَ الحِلمِ مِنهُ التَحَلُّمُ",21,"م",1,0],["وَلَو بِعنا أُسَيِّدَ لَم تَزِدنا","أُسَيِّدُ قَتَّتَينِ عَلى حِمارِ",22,"ر",1,0],["وَلَو بِأُباضَ إِذ لاقَوا جِلاداً","بِأَيدي مِثلِهِم وَسُيوفُ كُفرِ",23,"ر",1,0],["ولو بَعُدَتْ قِبابُكَ قابَ قوسٍ","من الواشينَ حَيَّينا القِبابا",24,"ب",2,0],["وَلَو بَرَزَت في جَحفَلٍ تَحتَ عَنتَرٍ","لَجُدِّلَ وَاِنفَلَّت جُيوشُ بَني عَبسِ",25,"س",1,0],["وَلَو بِمَدحِ المُؤَيَّدِ اِعتَبَروا","لَبُدِّلَت سَيِّئاتُهُم حَسَنَه",26,"ن",2,0],["وَلَو بُعِثْتَ غَدَاً أَصْبَحْتَ تَحْفَظُنَا","بِالاسْمِ وَالوَجْهِ أَوْ أَحْصَيْتَنَا عَدَدَا",27,"د",2,0],["وَلَو بَصُرَت بِهِ لَرَأَت جَريضاً","بِماءِ الدَهرِ حِليَتُهُ الشُحوبُ",28,"ب",1,0],["ولو بلغَ الجاهلونَ السُّها","فما تحتَ موضعِهِمْ موضعُ",29,"ع",1,0],["وَلَو باتَ وَالهُجرانُ يَصدُعُ قَلبَهُ","لَجادَ بِوَصلٍ دائِمٍ آخَرَ الدَهرِ",30,"ر",1,0],["وَلَو بَقِيَت لِأَدرَكَها مُزيلٌ","بِريبِ الدَهرِ مِن عَجمٍ وَضَرسِ",31,"س",1,0],["وَلَو بِمُشارِ العَينِ يوحى إِلَيهِما","لِوَشكِ اِعتِزالِ العَيشِ لَاِعتَزَلاهُ",32,"ل",3,0],["وَلَو بَينَ دُنيانا الدَنيَّةِ خُيِّرَت","وَبَينَ سِواها ماءَرادَت سِوى الدُنِّيا",33,"ي",2,0],["ولو بِعْتُ دِرْعِي سُقْتُ يا هندُ للفتى","هُنَيْدَةَ ألْقَى الرّاعِيانِ إفالَها",34,"ل",3,0],["ولو بَرَدَى أنّتْ لخطبٍ مياهُه","لسالتْ بوادي النيلِ للنيل أدمُع",35,"ع",1,0],["ولو بلغت دون السَّماءِ قبيلة","لزادت عليها نهشلٌ وتغلَّتِ",36,"ت",1,0],["ولوبِنتَ – لا بنتَ – عن ذا المحيط","لضاق عليَّ بأقطاره",37,"ر",2,0],["ولو بدَتْ لهمُ الدُّنيا بزيِنتها","لقابلوها بتبجيلٍ وإطراء",38,"ا",2,0],["ولو بهما مُتّعتُ ما زلتُ ساخطاً","على الدهر إذ لم يَحْبُني حاجةً أُخرى",39,"ر",2,0],["ولو بُعدَ المسَرى زجرنا على الوجَى","أغرَّ وجيهيٍّا ووجناءَ جَلْعَدا",40,"د",2,0],["ولو بذلوا لي كلَّ بحر بدمعة","على الأرض عدَّت همتي الدمع مأثما",41,"م",2,0],["ولو بَلي تحت أطباق الثرى جسدي","لكنتُ أبلى وما قلبي لكم ناسِ",42,"س",1,0],["ولو بِكُمُ ما بي لزرتم ولو على","حدودِ السريجيات كالبرقِ أو أمضى",43,"ض",2,0],["ولو بغير الهوى جوزيت في سنن","وجدتني غير رعديد ولا سمج",44,"ج",1,0],["وَلَو بِالفيلِ مِمّا بِ","كَ عشرٌ ما نَجا الفيلُ",45,"ل",1,0],["وَلَو بسط الهَوى العذرى عذري","لما قاسيت سنة قيس لبنى",46,"ن",2,0],["ولَوْ بَرَّدَ السُّلْوانُ حَرَّ جَوانِحِي","لآثَرْتُ عَنْ طَوْعٍ سُلُوَّ البَهائِمِ",47,"م",1,0],["وَلَوْ بَذَلَ الْيسِيرَ لَبَلَّ شَوْقي","وَقَدْ يَرْوى الظِّمَاءُ مِنَ الثِّمَادِ",48,"د",1,0],["ولو بدا فبدور الأفق في خجل","ترخي على وجهها من سحبها نقب",49,"ب",1,0],["وَلَوْ بَالَغْتُ قُلْتُ يمين يَحْيى","وَلكنِي علَى هَاتِيكَ حَاسِدْ",50,"د",1,0],["وَلَو بَلَغوا في الهَديِ بِالحُبِّ كَعبَةً","سِوى كَعبَتي لَم يَقبَلِ اللَهُ مِنهُمُ",51,"م",1,0],["وَلَو بَدَت تجلى لَدى راهب","لَبادَرَ التَبخّر بِالعَنبرِ",52,"ر",1,0],["ولو بِقَدرِكَ أُهدِي","َمَا وَجدتُ هَدِيّه",53,"ه",1,1],["وَلَو بِعَيني رَأَوا ما قَد رَأَيتَ لما","لاموا وَلكِنَّهُم مِن لُؤمِهِم خَبِثوا",54,"ث",3,0],["وَلَو بَقيتَ عُمُراً تُكَرِّرُه","ما عِندَ عفوِ اللَهِ ذَنبٌ يُكبِرُه",55,"ه",1,0],["ولو بِعتُ ساعةَ لُقيانه","بدهْرٍ سواهُ لكُنْتُ الغَبينا",56,"ن",2,0],["وَلَو بَدَّلوني مِن مَلامٍ شَفاعَةً","إِلى مَن عَلَيهِ اللَومُ لَاِعتَدَلَ الأَمرُ",57,"ر",1,0],["ولو بلغوا من عشر تسعين نصفها","تبيَّنَ في تركي القيام لهم عذري",58,"ي",1,0],["ولو بذل الأنام الجهدَ كيما","يُصار لفضلك المحسود ثان",59,"ن",1,0],["وَلَو بحتُ بِالشَكوى لرقت لَها العِدى","وَذابَت لَها صم الحَصا وَالجلامدُ",60,"د",1,0],["ولو بَدتْ لبني العبّاس عزمتُهُ","لروّعتْ كلَّ مأمونٍ ومؤتمنِ",61,"ن",1,0],["ولو بالقتل إن عنهم تأبَّى","بلا خوف هناك ولا احتشام",62,"م",1,0],["وَلَو بكتِ الوَرَقُ الحَمائِم شَجوها","بَعَيني مَحا أَطواقهُنَّ انسِجامُها",63,"م",3,0],["وَلَو بارى بِجودِ يَدَيهِ بَحراً","لآل البَحرُ كالآلِ المروعِ",64,"ع",1,0],["ولو بعصا موسى اتقيت لآدها","على ما بها من قوة حمل ثقلي",65,"ل",2,0],["ولو بَسطَتْ أيدي الحوادِثِ مِن يدي","تلقتْهُمُ قبلَ السُّؤال بِنائِلي",66,"ل",2,0],["ولو بدا ثغرها يوما رايت له","برقا تألق للابصار مختطفا",67,"ف",2,0],["ولو بَصُرَتْ بِي والسُّرى جُلُّ عَزْمَتي","وجَرْسِي لِجِنَّانِ الفَلاةِ سَمِيرُ",68,"ر",1,0],["ولو بلغ النُّسُورَ بِهِ نسورٌ","وطارَ بِهِ النَّعامُ إِلَى النَّعَامِ",69,"م",1,0],["ولو بعَصَا موسى أُفَجِّرُ شُرْبَهُمْ","ولكنْ بِذُلِّ الفقرِ فِي عزَّة الوَفْرِ",70,"ر",1,0],["ولو بالمكارم يبقى كريم","بقى لاك ما كل حر بباق",71,"ق",1,0],["ولو بسعد الدولة اشتغاله","مذ سار ما سار بمدحٍ مختلَقْ",72,"ق",1,0],["ولو بأبي الأغرِّ صرختَ فاءتْ","عليك فضولُ رأفته تعودُ",73,"د",1,0],["ولو بكت السماءُ لها وجفني","تيقَّنَتِ البخيلَ من الجوادِ",74,"د",1,0],["ولو بنصير الدين صُلْتُ عليهم","لعَفَّى على الآثار منهم ودمَّرا",75,"ر",2,0],["ولو بدت ذرة في الكون من ضرمي","لاستهلكوا أو تلاشوا في الطوى هجج",76,"ج",1,0],["ولو بلغتني ما أريد بلاغتي","نظمت له نثر الكواكب جوهرا",77,"ر",2,0],["ولو بإشارَةٍ أدَّى مَقالي","لمَا انتَظمَ القريضُ لديكَ دُراّ",78,"ر",2,0],["وَلَو بَكى لِشَيءٍ","بَكى لِيَ البُعادُ",79,"د",1,0],["ولو بيتيم الوالدين قد اعتلت","لعز وعنه زال من ذله اليتم",80,"م",1,0],["ولو بذلتَ كنوزَ الأرضِ قاطبةً","تبغي علاجاً بغير الصَّبرِ لم تَجِدِ",81,"د",1,0],["وَلَو بَرَزَتْ لِنَصَارَى المَسِيْ","حِ عِيْسَى لَدَانُوا بِهَا دُونَ عِيْسَى",82,"س",2,0],["ولو بسطت علم كل باب","لاحتجت في ذاك إلى كتاب",83,"ب",1,0],["ولو بَلِيت تلك الحُلى وتنكَّرتْ","وأَبصرتَها بعد البلى لعرَفْتُها",84,"ت",3,0],["وَلَوْ بِسِوَى سَهْمِ الفِرَاقِ رَمَيْتَنِي","حَنانَيْكَ لَمْ يَنْفُذْ بِدرْعِ تَجلُّدِي",85,"د",2,0],["ولو بانت الحرفان منه كما أتى","بأف ثلاث في الحديث المؤيد",86,"د",1,0]]}