{"poems":[[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[27,"سرت الهموم فبتن غير نيام","https://www.aldiwan.net/poem6021.html","الكامل"],[51,"يا باني الدرج الذي أولى به","https://www.aldiwan.net/poem62842.html","الكامل"],[51,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[51,"ولحية يحملها مائق","https://www.aldiwan.net/poem65429.html","السريع"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"قصرت شنطف وقلت وذلت","https://www.aldiwan.net/poem65894.html","الطويل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[28,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[61,"برز إبراهيم في علمه","https://www.aldiwan.net/poem51438.html","السريع"],[66,"لو غدا أنفك العظيم غدا وه","https://www.aldiwan.net/poem38601.html","الخفيف"],[80,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[69,"لحيته طويلة","https://www.aldiwan.net/poem28491.html","مجزوء الرجز"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[46,"مضى الزمان ونفس الحي مولعة","https://www.aldiwan.net/poem23227.html","البسيط"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[76,"لا غرو إن نال منك السقم والضرر","https://www.aldiwan.net/poem39315.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""]],"verses":[["لو غدا الشعر ناطقاً لسان","لتغنّى بوصفها عندليبا",0,"ب",2,0],["لَو غَيرُكُم عَلِقَ الزُبَيرَ وَرَحلَهُ","أَدّى الجِوارَ إِلى بَني العَوّامِ",1,"م",1,0],["لو غار هدَّمها بفيهِ وأنفهِ","طلباً لها حتى المماتِ بثارِهِ",2,"ر",2,0],["لو غدا حكمها إليّ لطارت","في مهبّ الرياح كلَّ مَطيرِ",3,"ر",1,0],["لو غاص في البحر بها غوصةً","صاد بها حيتانه أجمعا",4,"ع",2,0],["لو غدت وهي كعبة","ما استُحِلَّ التطوُّف",5,"ف",1,0],["لو غدا طولُ بظرِها لقناةِ ال","ظهرِ منها لألحقتْ بالطوالِ",6,"ل",1,0],["لَو غابَ كُلُّ عَزيزٍ عَنهُ غَيبَتَنا","لَم يَأتِهِ الشَوقُ إِلّا مِن نَواحينا",7,"ن",2,0],["لَو غَيرُ عَبدِ بَني جُؤَيَّةَ سَبَّني","مِمَّن يَدِبُّ عَلى العَصا لَم أَغضَبِ",8,"ب",1,0],["لو غَضِبَتْ روحٌ على جِسمِها","أصلحَ بينَ الروحِ والجِسمِ",9,"م",1,0],["لَو غَدا أَنفَكَ العَظيمُ غَدا وَه","وَ وَقودٌ لِلنارِ ذاتِ الوَقودِ",10,"د",1,1],["لو غَدت جَدوَى يَدَيه قَهوةً","ما مَشى مِن سُكرِها في الأَرض صاح",11,"ح",1,0],["لو غاصَ في البحرِ بها","لعرقلَتْ أسماكَهُ",12,"ه",1,0],["لو غَيّبتْهُ المواضِي في سرائرِها","ألقى بمهجته يرتادُ مُدَّخلا",13,"ل",2,0],["لَو غَربَلَ الناسُ كَيما يُعدَموا سَقَطاً","لَما تَحَصَّلَ شَيءٌ في الغَرابيلِ",14,"ل",1,0],["لوْ غِبْتَ شَهْرَكَ موْصُولاً بتابِعِه","وأبْتَ لانْتقلَ الأضْحَى إلى صَفَرِ",15,"ر",1,0],["لَو غالَ مَجْلودَهُ شَيءٌ سِوى قَدَرٍ","أكْبَرْتُ ذَاكَ وَلكِنْ غالَهُ القَدَرُ",16,"ر",1,0],["لَو غمسوا الصب في المَلاهي","ما وجدت نفسه اِنشراحا",17,"ح",2,0],["لو غَيْرُ ذلك أطاحَ رأسَك لارتَمى","بِشِراك نعلِكَ طائحاً \" هَمّام \"",18,"م",1,0]]}