{"poems":[[53,"يا دهر ماذا الطروق بالألم","https://www.aldiwan.net/poem29811.html","المنسرح"],[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[53,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[63,"إذا غار عزمي في البلاد وأنجدا","https://www.aldiwan.net/poem45920.html","الطويل"],[63,"ألا بأبي من حيل دون مزاره","https://www.aldiwan.net/poem46137.html","الطويل"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[42,"رأيت زيادا يجتويني بشره","https://www.aldiwan.net/poem50454.html","الطويل"],[30,"خليلي عوجا من صدور الرواحل","https://www.aldiwan.net/poem29541.html","الطويل"],[88,"أشر فعل البرايا فعل منتحر","https://www.aldiwan.net/poem44985.html","البسيط"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[37,"رجوك ولم يبلغ العمر منك","https://www.aldiwan.net/poem7015.html","المتقارب"],[47,"أي اصطبار ليس بالزائل","https://www.aldiwan.net/poem25210.html","السريع"],[72,"من منصفي من أناس","https://www.aldiwan.net/poem20306.html","المجتث"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[89,"تلغى معاهدة واخرى تعقد","https://www.aldiwan.net/poem44875.html","الكامل"],[89,"ما شاهدت عيني ممث","https://www.aldiwan.net/poem44910.html","مجزوء الكامل"],[85,"يقال كانت فأرة الغيطان","https://www.aldiwan.net/poem8045.html","الرجز"],[56,"ما أنت مني ولا ربعاك لي وطر","https://www.aldiwan.net/poem58594.html","البسيط"],[62,"سماؤنا من ذهب خالص","https://www.aldiwan.net/poem52182.html","السريع"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[28,"لأدنو من أرض لأرضك إن دنت","https://www.aldiwan.net/poem5546.html","الطويل"],[61,"لا در در بني رباح إنهم","https://www.aldiwan.net/poem51373.html","الكامل"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[58,"النفس تبكي على الدنيا وقد علمت","https://www.aldiwan.net/poem30805.html","البسيط"],[44,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[90,"لا در درك من ربوع ديار","https://www.aldiwan.net/poem60160.html","عموديه"],[31,"هيهات من أمة الوهاب منزلنا","https://www.aldiwan.net/poem41292.html","البسيط"],[31,"يا صاحبي تصدعت كبدي","https://www.aldiwan.net/poem42574.html","الكامل"],[22,"لأدماء منها كالسفينة نضجت","https://www.aldiwan.net/poem22046.html","الطويل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85564","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202537","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54930","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"مأتم الخلق!","https://www.poetsgate.com/ViewPoem.aspx?id=179664",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[58,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""]],"verses":[["لا دَرَّ دَرُّ السَقامِ كَيفَ رَمى","طَبيبَ آمالِنا مِنَ السَقَمِ",0,"م",1,0],["لا دَرَّ دَرّي إِن مَطَلتُكَ ذِمَّةً","في باطِنٍ مُتَغَيّبٍ أَو بادِ",1,"د",1,0],["لا دَرَّ دَرّي إِن رَضَيتُ بِذِلَّةٍ","تَلوي يَدي وَتَرُدُّ غَربَ طَماحي",2,"ي",1,0],["لَأَدَّرِعَنَّ النَّقْعَ وَالسَّيْفُ يُنْتَضَى","لُجَيْناً وَنُؤويهِ إِلى الغِمْدِ عَسْجَدا",3,"د",2,0],["لأَدَّرِعَنَّ اللّيلَ حتى أُزيرَهُ","أغَرَّ يُناصي الشُّهْبَ يومَ فَخارِهِ",4,"ر",2,0],["لأَدَّرِعَنَّ اللّيلَ يَلْمَعُ صُبْحُهُ","تَحَدُّرَ راحٍ منْ خِلالِ فِدامِ",5,"م",1,0],["لِأُدرِكَ نُجحاً أَو أُسلّيَ حاجَةً","وَهَمُّ القَصيرِ الباعِ داءٌ يُماطِلُه",6,"ل",2,0],["لَأُدمانَةٍ مِن وَحشٍ بَينَ سُوَيقَةٍ","وَبَينَ الحِبالِ العُفرِ ذاتِ السَلاسِلِ",7,"ل",1,0],["لاَ درّ درّ قصيد راح يَنظمه","من ليس يعرف معنى الدَرْ والدُرر",8,"ر",1,0],["لا دجلة يا للرزية دجلة","بعد الرشيد ولا الفرات فرات",9,"ت",1,0],["لادني خسا أو زكا من سنيك","إلى أربع فبقوك انتظارا",10,"ر",2,0],["لادَرَّ دَرُّ الدَهرِ مابالُهُ","حَمَّلَني مالَستُ بِالحامِلِ",11,"ل",1,0],["لا درهماً وزنوه","وحاولوا الشرّ مني",12,"ي",1,0],["لا دمعةٌ صهباء نعلمها","إلا دم استِك خاضباً فُصعه",13,"ع",2,0],["لا دمي يُسفك في نُصرتكم","لا ولا عِرضي فيكم يُمتهَن",14,"ن",1,0],["لا دُؤوبٌ إلا دُؤوبُ رَحاها","أو دُؤوبُ الرحى التي للمنون",15,"ن",1,0],["لا دَرَّ دَرُّ الوُشاةِ قَد حَلَفوا","أَن يُفسِدوا بَينَنا وَقَد قَدَروا",16,"ر",3,0],["لا دُجى يَكرَهُ العَوالِمَ وَالنا","سَ فَيُلقي عَلى الجَميعِ سُدولا",17,"ل",2,0],["لا دين اكمل من دين دعوت له","في طلعة الشمس ما يغني عن القمر",18,"ر",1,0],["لا در در الجاهلين فانهم","يرمون بالالحاد من لا يلحد",19,"د",1,0],["لا دور الاّ احسنت","هُ في الروايات الكثيره",20,"ر",2,0],["لَأَدخُلَنَّ الدارَ بَعدَ الدارِ","وَثباً مِنَ الرَفِّ إِلى الكَرارِ",21,"ر",1,0],["لا دَرَّ دَرُّ الأَعادي عندما وَتَروا","ودَرَّ دَرُّكِ مَا تَحوينَ يا حُفَرُ",22,"ر",1,0],["لا داخل فيه ولا خارج","عنه يمشي ماؤه أرضه",23,"ض",2,0],["لا دَيزَجٌ يَصِفُ الرَمادَ وَلَم أَجِد","حالاً تُحَسِّنُ مِن رُواءِ الدَيزَجِ",24,"ج",1,0],["لا دِمنَةٌ بِلِوى خَبتٍ وَلا طَلَلُ","يَرُدُّ قَولاً عَلى ذي لَوعَةٍ يَسَلُ",25,"ل",1,1],["لَأَدنُوَ مِن أَرضٍ لِأَرضِكِ إِن دَنَت","بِها بيدُها مُوصولَةٌ وَإِكامُها",26,"م",3,1],["لا درّ درُّ بني رباح إنّهم","مثل الفسا هبّت عليه رياح",27,"ح",1,1],["لا درعه إلا سطاه ولا","شيء سوى الإقدام مغفره",28,"ر",2,0],["َلأُدني من غرائِبها إليه","وكان لهنّ في الأرضِ اغتِرابُ",29,"ب",1,0],["لا دارَ لِلمَرءِ بَعدَ المَوتِ يَسكُنُها","إِلّا الَّتي كانَ قَبلَ المَوتِ بانيها",30,"ي",3,0],["لِإِدريسَ يَومٌ ماتَزالُ لِذِكرِهِ","دُموعٌ وَإِن سَكَّنتَها تَتَفَرَّعُ",31,"ع",1,0],["لا درّ درّك من ربوع ديار","قرْبُ المزار بها كُبعْد مزار",32,"ر",1,1],["لا درّ درّكِ عرية غطى بها","من لعنة التاريخ شرُّ دثار",32,"ر",1,0],["لا دارُكُم دارُنا يا وَهبَ إِن نَزَحَت","نَواكِ عَنّا وَلا أَوطانُكُم وَطَني",33,"ن",2,0],["لا دارُها داري فَتُسعِفَني","هَذا لَعَمرُكَ مِن شَقا جَدّي",34,"ي",1,0],["لِأَدماءَ مِنها كَالسَفينَةِ نَضَّجَت","بِهِ الحَولَ حَتّى زادَ شَهراً عَديدُها",35,"ه",2,1],["لا دَرَّ دَرُّ الشَّيْبِ إنَّ نُجومَهُ","تَذَرُ السَّعِيدَ مِنَ الرِّجالِ نَحيسا",36,"س",2,0],["لا دَرَّ دَرُّهُمُ فإنَّ كلامَهم","يذَرُ الثَّرَى مِنْ أَدْمُعِي مَبْلولا",37,"ل",2,0],["لآدَمَ من سرّكمْ مَوضِعٌ","بهِ استوْجَبَ العَفوَ لمّا عَصَى",38,"ا",1,0],["لا دفاع عما لحوك عليه","في اِنتقاداتهم ولا تأويل",39,"ل",1,0],["لا دجلة دجلة من بعد نكبتها","وَلا الزَمان بواديها كَما عهدا",40,"د",2,0],["لا دارنا بعد الأحبة في اللوى","دار ولا جيراننا جيرانُ",41,"ن",1,1],["لا دين للباغي وإن تديّنا","كفى بقتْل النّفس ظلماً بيّنا",42,"ن",2,0],["لَأديِبَها وَخَطِيبِهَا فَخْرِ","المَحَابِرِ وَالمَنَابِرْ",43,"ر",1,0],["لاده سطر على","كتاب عبرة الزّمن",44,"ن",1,0],["لا دَرَّ درُّ الحكم؛ كم أحنى لنا","رأسًا، وعفَّر بالتراب خدودا!",45,"د",2,0],["لا در درُّ الحكم؛ كم","دس المعاطس في التراب",46,"ب",1,0],["لا درَّ درُّ أناسٍ لا وفاءَ لهم","يَلقَونَ كلَّ جديدٍ جاء بالمَلَق!",47,"ق",1,0],["لا دُرعٌ سابغات، لاقنا","مشرعاتٌ، لا سيوفٌ منتضاه",48,"ا",2,0],["لا دار للمرء بعد الموت يسكنها","الا التي كان قبل الموت يبنيها",49,"ي",3,0],["لا دجلةٌ لولاهمُ ، وهي التي","عذُبت، تروق ولا الفراتُ يذاق",50,"ق",1,0]]}