ُ مُهاجِر","https://www.poetsgate.com/ViewPoem.aspx?id=176272",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5616,"معذرة يا أبا العلاء","https://www.poetsgate.com/ViewPoem.aspx?id=204842",""],[5648,"كل عام والامه بخير وسلامه","https://www.poetsgate.com/ViewPoem.aspx?id=155977",""],[5717,"لا دار سلمى هي بل ربع الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=170593",""],[5717,"لا در در الجهل كم جر على ال","https://www.poetsgate.com/ViewPoem.aspx?id=170595",""],[5725,"اخفى الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=197618",""],[5730,"قميص الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=210352",""],[5751,"تعال بنفسجًا","https://www.poetsgate.com/ViewPoem.aspx?id=214806",""],[5784,"لا تسل","https://www.poetsgate.com/ViewPoem.aspx?id=190295",""],[5784,"#تجليات","https://www.poetsgate.com/ViewPoem.aspx?id=210524",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5842,"من ورق / إياد صالح","https://www.poetsgate.com/ViewPoem.aspx?id=150275",""],[5861,"أكان بوذيا قاتلي يا ترى ..أم انه قد كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=191503",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5956,"لا دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""],[6069,"يا من يعيب علي حب مدللٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105675",""],[6089,"العتب لي","https://www.poetsgate.com/ViewPoem.aspx?id=214045",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""],[6152,"لا دفء لي حماكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203290",""],[6166,"رسالة من المدينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7281&r=&rc=1",""],[5355,"دنيا القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87209&r=&rc=34",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["لا دَرَّ دَرُّ السَقامِ كَيفَ رَمى","طَبيبَ آمالِنا مِنَ السَقَمِ",0,"م",1,0],["لا دَرَّ دَرّي إِن مَطَلتُكَ ذِمَّةً","في باطِنٍ مُتَغَيّبٍ أَو بادِ",1,"د",1,0],["لا دَرَّ دَرّي إِن رَضَيتُ بِذِلَّةٍ","تَلوي يَدي وَتَرُدُّ غَربَ طَماحي",2,"ح",2,0],["لَأَدَّرِعَنَّ النَّقْعَ وَالسَّيْفُ يُنْتَضَى","لُجَيْناً وَنُؤويهِ إِلى الغِمْدِ عَسْجَدا",3,"د",2,0],["لأَدَّرِعَنَّ اللّيلَ حتى أُزيرَهُ","أغَرَّ يُناصي الشُّهْبَ يومَ فَخارِهِ",4,"ر",2,0],["لأَدَّرِعَنَّ اللّيلَ يَلْمَعُ صُبْحُهُ","تَحَدُّرَ راحٍ منْ خِلالِ فِدامِ",5,"م",1,0],["لِأُدرِكَ نُجحاً أَو أُسلّيَ حاجَةً","وَهَمُّ القَصيرِ الباعِ داءٌ يُماطِلُه",6,"ل",2,0],["لَأُدمانَةٍ مِن وَحشٍ بَينَ سُوَيقَةٍ","وَبَينَ الحِبالِ العُفرِ ذاتِ السَلاسِلِ",7,"ل",1,0],["لاَ درّ درّ قصيد راح يَنظمه","من ليس يعرف معنى الدَرْ والدُرر",8,"ر",1,0],["لا دجلة يا للرزية دجلة","بعد الرشيد ولا الفرات فرات",9,"ت",1,0],["لادني خسا أو زكا من سنيك","إلى أربع فبقوك انتظارا",10,"ر",2,0],["لادَرَّ دَرُّ الدَهرِ مابالُهُ","حَمَّلَني مالَستُ بِالحامِلِ",11,"ل",1,0],["لا درهماً وزنوه","وحاولوا الشرّ مني",12,"ن",2,0],["لا دمعةٌ صهباء نعلمها","إلا دم استِك خاضباً فُصعه",13,"ع",2,0],["لا دمي يُسفك في نُصرتكم","لا ولا عِرضي فيكم يُمتهَن",14,"ن",1,0],["لا دُؤوبٌ إلا دُؤوبُ رَحاها","أو دُؤوبُ الرحى التي للمنون",15,"ن",1,0],["لا دَرَّ دَرُّ الوُشاةِ قَد حَلَفوا","أَن يُفسِدوا بَينَنا وَقَد قَدَروا",16,"ر",3,0],["لا دُجى يَكرَهُ العَوالِمَ وَالنا","سَ فَيُلقي عَلى الجَميعِ سُدولا",17,"ل",2,0],["لا دين اكمل من دين دعوت له","في طلعة الشمس ما يغني عن القمر",18,"ر",1,0],["لا در در الجاهلين فانهم","يرمون بالالحاد من لا يلحد",19,"د",1,0],["لا دور الاّ احسنت","هُ في الروايات الكثيره",20,"ر",2,0],["لَأَدخُلَنَّ الدارَ بَعدَ الدارِ","وَثباً مِنَ الرَفِّ إِلى الكَرارِ",21,"ر",1,0],["لا دَرَّ دَرُّ الأَعادي عندما وَتَروا","ودَرَّ دَرُّكِ مَا تَحوينَ يا حُفَرُ",22,"ر",1,0],["لا داخل فيه ولا خارج","عنه يمشي ماؤه أرضه",23,"ض",2,0],["لا دَيزَجٌ يَصِفُ الرَمادَ وَلَم أَجِد","حالاً تُحَسِّنُ مِن رُواءِ الدَيزَجِ",24,"ج",1,0],["لا دِمنَةٌ بِلِوى خَبتٍ وَلا طَلَلُ","يَرُدُّ قَولاً عَلى ذي لَوعَةٍ يَسَلُ",25,"ل",1,1],["لَأَدنُوَ مِن أَرضٍ لِأَرضِكِ إِن دَنَت","بِها بيدُها مُوصولَةٌ وَإِكامُها",26,"م",3,1],["لا درّ درُّ بني رباح إنّهم","مثل الفسا هبّت عليه رياح",27,"ح",1,1],["لا درعه إلا سطاه ولا","شيء سوى الإقدام مغفره",28,"ر",2,0],["َلأُدني من غرائِبها إليه","وكان لهنّ في الأرضِ اغتِرابُ",29,"ب",1,0],["لا دارَ لِلمَرءِ بَعدَ المَوتِ يَسكُنُها","إِلّا الَّتي كانَ قَبلَ المَوتِ بانيها",30,"ي",3,0],["لِإِدريسَ يَومٌ ماتَزالُ لِذِكرِهِ","دُموعٌ وَإِن سَكَّنتَها تَتَفَرَّعُ",31,"ع",1,0],["لا درّ درّك من ربوع ديار","قرْبُ المزار بها كُبعْد مزار",32,"ر",1,1],["لا درّ درّكِ عرية غطى بها","من لعنة التاريخ شرُّ دثار",32,"ر",1,0],["لا دارُكُم دارُنا يا وَهبَ إِن نَزَحَت","نَواكِ عَنّا وَلا أَوطانُكُم وَطَني",33,"ن",2,0],["لا دارُها داري فَتُسعِفَني","هَذا لَعَمرُكَ مِن شَقا جَدّي",34,"د",2,0],["لِأَدماءَ مِنها كَالسَفينَةِ نَضَّجَت","بِهِ الحَولَ حَتّى زادَ شَهراً عَديدُها",35,"ه",2,1],["لا دَرَّ دَرُّ الشَّيْبِ إنَّ نُجومَهُ","تَذَرُ السَّعِيدَ مِنَ الرِّجالِ نَحيسا",36,"س",2,0],["لا دَرَّ دَرُّهُمُ فإنَّ كلامَهم","يذَرُ الثَّرَى مِنْ أَدْمُعِي مَبْلولا",37,"ل",2,0],["لآدَمَ من سرّكمْ مَوضِعٌ","بهِ استوْجَبَ العَفوَ لمّا عَصَى",38,"ا",1,0],["لا در درُّ امرئ يطري أوائله","فخراً، ويطرق إن ساءلته ماهو ؟",39,"ا",3,0],["لا دفاع عما لحوك عليه","في اِنتقاداتهم ولا تأويل",40,"ل",1,0],["لا دجلة دجلة من بعد نكبتها","وَلا الزَمان بواديها كَما عهدا",41,"د",2,0],["لا دارنا بعد الأحبة في اللوى","دار ولا جيراننا جيرانُ",42,"ن",1,1],["لا دين للباغي وإن تديّنا","كفى بقتْل النّفس ظلماً بيّنا",43,"ن",2,0],["لَأديِبَها وَخَطِيبِهَا فَخْرِ","المَحَابِرِ وَالمَنَابِرْ",44,"ر",1,0],["لاده سطر على","كتاب عبرة الزّمن",45,"ن",1,0],["لا دَرَّ درُّ الحكم؛ كم أحنى لنا","رأسًا، وعفَّر بالتراب خدودا!",46,"د",2,0],["لا در درُّ الحكم؛ كم","دس المعاطس في التراب",47,"ب",1,0],["لا درَّ درُّ أناسٍ لا وفاءَ لهم","يَلقَونَ كلَّ جديدٍ جاء بالمَلَق!",48,"ق",1,0],["لا دُرعٌ سابغات، لاقنا","مشرعاتٌ، لا سيوفٌ منتضاه",49,"ا",2,0],["لا دار للمرء بعد الموت يسكنها","الا التي كان قبل الموت يبنيها",50,"ي",3,0],["لا دجلةٌ لولاهمُ ، وهي التي","عذُبت، تروق ولا الفراتُ يذاق",51,"ق",1,0],["لا درب غيري ، منتهاي كأولي","أنوي السؤال ، يردّ قبل سؤالي",52,"ل",2,0],["لا در درك جعفر يا جعفر","دعني بغي ضلالتي أتعثر",53,"ر",1,1],["لا دينُكُم ديني وَلا أَنا كافِرٌ","حَتّى يَزولَ إِلى الطَراةِ شَمامُ",54,"م",1,0],["لا دَرَّ دَرُّك إن ورَّيتَ عن خبري","إذا وصلتَ وإن أشمتَّ حُسّادي",55,"د",2,0],["لا درَّ دَرُّ المرء يقطعُ دهرَه","رِخوَ الإزارِ وعزمُه مفلولُ",56,"ل",1,0],["لا دَرَّ دَرُّ مَطامِعي إِن نَكَّبَت","بَحراً وَأَفضَت بي إِلى أَوشالِ",57,"ل",1,0],["لأَدْنُوَ مِنْ بيضاءَ خفّاقَةِ الحشا","بُنَيَّةِ ذي قاذورةٍ شَنآنِ",58,"ن",1,0],["لا دَولةٌ لَكُمُ يَشتَدُّ أزرَكُمُ","بِها وَلا ناصِرٌ لِلخَطبِ ينتَدِبُ",59,"ب",1,0],["لأدرعَنّ الليل سيرا تجوب بي","فسيح الفلا نوق بلى الوخد كومها",60,"م",3,0],["لا درّ درّك من أبٍ","فظٍّ ووالدةٍ لئيمه",61,"ه",1,0],["لا درّ درهمُ فلَو","حُزتُ النضارَ لأكرموني",62,"ن",2,0],["لا درّ درّ الغادرين فإنّهُم","وعدوا اليهودَ بقسمةِ البُلدانِ",63,"ن",1,0],["لأُدارِينَّ وأُحسدنَّ ومن يَفُز","بوصال مثلك يصطبر للحاسدِ",64,"د",1,0],["لا دار إلا بوجد","وما أراكم وجدتم",65,"م",1,0],["لا دهاكَ الفَناءُ بَعد بَقاءٍ","خالِدٌ أَنتَ في ضَميرِ البَقاءِ",66,"ا",2,0],["لا دولةٌ فيهم ولا مُلكٌ لهم","إنَّ الممالِكَ بالملوكِ ضِخام",67,"م",1,0],["لا درك منك في الدنيا والاخرى","نَصيبي من دعاء مستجاب",68,"ب",1,0],["لادر در المَطايا أَينَما ذهبت","ان لم تنخ حيث لا تثنى لها العقل",69,"ل",1,0],["لا در در الشعر ان لم أمله","في مدح أَحمَد لؤلؤا منظوما",70,"م",2,0],["لا دَرَّ درُّ البَينِ كَم مِن مُقلَةٍ","مِنهُ بِإِثمِدِ نَومِها ما تُكحَلُ",71,"ل",1,0],["لا دَرَّ دَرُّكَ إِنّي في ذرى مَلِكٍ","فاضَت أَياديهِ حَتّى فاقَتِ السُحُبا",72,"ب",2,0],["لا دين مَنْ جعلوا أَركانَ دينهمُ","عمائماً ومساويكاً وطول لحى",73,"ح",2,0],["لأَدفَعَ عَن مآثرَ صالحاتٍ","وأحمي بَعدُ عن عِرضٍ صَحِيحِ",74,"ح",1,0],["لا دامَ لدَهْرٍ فَرَّقَنا","إن صَحّ نوىً يَتَرصّده",75,"د",2,0],["لأدَّرِعَنَّ اللّيلَ أسحَبُ ذَيْلَه","إلى أن يُرَى فَرْعٌ من الصبحِ شائب",76,"ب",1,0],["لادَرَّدَرُّ الموتِ ماذا ضَرَّهُ","لو كان عنك لطَرْفهِ اِغضاء",77,"ا",2,0],["لا دَليلٌ إِلّا عَلَيهِ عَلامَةٌ","لا بَخيلٌ إِلّا إِلَيهِ مَلامَه",78,"م",2,1],["لا درَّ درُّكِ مهجةً مظلومةً","مخلوقةً لنوائبٍ وشدائِد",79,"د",1,0],["لا دَين لي إلّا ذنوبي إنها","قد كلَّ عن إحصائهن بَنان",80,"ن",1,0],["لا دار للمرء بعد الموت يسكنها","إلا الذي كان قبل الموت يبنيها",81,"ي",3,0],["لا دَمَ اِلّا دَم لِعترتِهِ","أُريقَ تَأبى النُفوسُ مَجراهُ",82,"ا",2,0],["لا دَرُّ نوازِلِ الأحداثِ","نقلَتْ أحِبَّتَنا إلى الأجداثِ",83,"ث",1,1],["لا دَرَّ دَرُّ بَياض الشَيبِ إِنَّ لَهُ","في أَعيُن الغيدِ مِثلَ الوَخزِ بالإِبَرِ",84,"ر",1,0],["لا دَرَّ دَرُّكَ مِن رجَاءٍ كاذِبٍ","يغْترُّنَا بورُودِ لامِعِ آلِ",85,"ل",1,1],["لا دَرَّ درُّك سوف يُفرِدُكَ الهوَى","منّي فلا تتعجَّلَنَّ فِرَاقي",86,"ق",2,0],["لا دَمْعُه يرقا ولا هذا الجوى","يَفنى ولا نار الجوانح تخمد",87,"د",1,0],["لا دم سالَ ولا دمعٌ جرى","وكفاها ربّك الخصمَ الألدَّا",88,"د",2,0],["لا دمعُها يرْقا على تِذْكارِهمْ","يَهْمي فيَحْمي جفنَها أن يُطْبِقا",89,"ق",2,0],["لا در درك من يباع شعوذة","تسومنا ذهبا صرفا ببلور",90,"ر",1,0],["لأُدرِكَ معجزاتِكُمُ بعيني","فيصبحَ منظراً ما كان حِسَّا",91,"س",2,0],["لأدركَ بيتي خفيُّ السنادِ وقد","كنتَ علياءهُ والسنَد",92,"د",1,0],["لا دعوت الملك الممدَّح فخر الد","دين إلاَّ لدفع كل ملمَّهْ",93,"م",2,0],["لا دليل السقام بادٍ عليكنَّ","كجسمي ولا شهيد الدمع",94,"ع",1,0],["لا دَفَّأتْكَ ، ولا ضاءَ الظَّلامُ بِها","طارَتْ بِعُمرِكَ بَيْنا أنتَ مُنْذهِلُ",95,"ل",1,0],["لا دَرَّ دَرِّيَ إِن أَطعَمتُ نازِلَكُم","قِرفَ الحَتِيِّ وَعِندي البُرُّ مَكنوزُ",96,"ز",1,1],["لإدراك ما قد فات لما غرتهم","الطوارق وانقادوا لشد المراحل",97,"ل",1,0],["لا دَرَّ دَرّ المعالي لا يزال لها","برق يشوقك لا هوناً ولا كثبا",98,"ب",2,0],["لا دَرَّ من آمالنا دَرٌّ","يجرنا الموت 