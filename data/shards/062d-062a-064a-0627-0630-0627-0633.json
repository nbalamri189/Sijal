4,"","https://poetry.dctabudhabi.ae/diwan/poem/94169","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205830","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205432",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112480","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100722","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112343","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102411","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129404","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91562","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85275","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40045","الرجز"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93256","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52146","الكامل"],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""],[4955,"ما كنت أعرف ما الذي يخفيه","https://www.poetsgate.com/ViewPoem.aspx?id=202862",""],[4984,"من رواق جميل بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=175550",""],[5367,"شُهود","https://www.poetsgate.com/ViewPoem.aspx?id=197191",""],[5409,"متى يحرر وادينا صحائفه","https://www.poetsgate.com/ViewPoem.aspx?id=155444",""],[5493,"سفر...","https://www.poetsgate.com/ViewPoem.aspx?id=203786",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""]],"verses":[["حتّى إذا سألَتْكَ السِّلْمَ ماثِلَةً","حكّمْتَ فيها كِتابَ اللهِ مُمْتَثِلا",0,"ل",2,0],["حَتَّى إَذَا سَئِمْتْ نُفُوسُهُمُ الرَّدَى","وَاعْتَاضَ مُصْطَبَرٌ وَعَزَّ عَزَاءُ",1,"ا",2,0],["حَتّى إِذا سامي العَجاجِ أَصعَدا","تَحسَبُ عُثنونَ دُخانٍ موقَدا",2,"د",2,0],["حَتّى إِذا سَلَخا جُمادى سِتَّةً","جَزءً فَطالَ صِيامُهُ وَصِيامُها",3,"م",3,0],["حتَّى إذا سحبت مثنى ذوائبها","فيا لها من غزالٍ في حبائله",4,"ل",2,0],["حَتّى إِذا سَفَرَ الصَباح وَقَد","رُفِعَ الظَلام وَكانَ كَالسِترِ",5,"ر",1,0],["حتى إذا سكنت إليك لنا منىً","كانت بظلك في هنىّ جوار",6,"ر",1,0],["حتى إذا سبكوا دواءهم","طرحوا عليه دواءهم ففسد",7,"د",1,0],["حتَّى إِذا سَمِعُوا بيومِكَ عطَّلُوا","أنضاءَهُمْ من عاقرٍ ومُجعْجَعِ",8,"ع",1,0],["حَتّى إِذا سَلِمَت مَغارِبُها لَهُ","وَصَفَت مِنَ الفُجّارِ وَالأُنّاسِ",9,"س",1,0],["حتى إذا سكرت من الأمل","وترنحت مالت على كتفي",10,"ي",1,0],["حَتّى إِذا سَكَنَ الإِرجاف وَاِحتَرقَت","أَكبادُ قَومٍ بِنارِ اليَأسِ وَالوَغَمِ",11,"م",1,0],["حتى إذا سَجَدَ الرفاقُ تخلَّفوا","عنهم فَضُوعِفَ أجرُهم والمغنم",12,"م",1,0],["حتى إذا سَرَقَ القوابلُ شَنْفَه","عوّضْنَه منه صَفيحاً مِقْضَبا",13,"ب",2,0],["حَتّى إِذا سَكَنَت في دَنِّها وَهَدَت","مِن بَعدِ دَمدَمَةٍ مِنها وَضَوضاءِ",14,"ا",2,0],["حَتّى إِذا سَكَنَت جَوانِحُها","كَتَبَت بِمِثلِ أَكارِعِ النَملِ",15,"ل",1,0],["حَتّى إِذا سُلسِلَت في قَعرِ باطِيَةٍ","أَغناكَ لَألائُها عَن ضَوءِ مِصباحِ",16,"ح",1,0],["حَتّى إِذا سَمِعَ الضُباحَ خِلافَهُ","وَعَرَضنَهُ طَلقاً عَلى أَعطابِهِ",17,"ب",2,0],["حتى إذا سَفَكَ الصباحُ دماءَه","وهوى قتيلُ الليلِ بعد صِراع",18,"ع",1,0],["حَتَّى إِذَا سَمِعَتهُ","بِالْقُرْبِ مِنْهَا يُنَادِي",19,"د",2,0],["حتى إذا سألتك السلم مائلة","حكمت فيها كتاب الله ممتثلا",20,"ل",2,0],["حتى إذا سئمَتْ نفوسهمُ الردى","واعتاصَ مُصطبرٌ وعزَّ عزاءُ",21,"ا",2,0],["حتى إذا سلخا جمادى ستة","جزءا فطال صيامه وصيامها",22,"م",3,0],["حتى إذا سال الصبوحُ وددت لو","أنّي اغتبقت بدمعيَ الهتّان",23,"ن",1,0],["حَتّى إِذا سادَ السُكونُ المُخيفُ","وَكان في الخارِج صَوتُ الحَفيف",24,"ف",1,0],["حتى إذا سُمْنَاه في بيعها","قَطَّب غيظاً حين سُمْناه",25,"ن",3,0],["حتى إذا سمَحَ الزّمانُ بفرصةٍ","بَسَقت على أيامِهم أيام",26,"م",1,0],["حَتّى إِذا سَعدُ سَعدِ الدَولَةِ التَمَعَت","أَنوارُهُ نَدِموا لَو يَنفَعُ النَدَمُ",27,"م",1,0],["حتى إذا سألوه لثمي قال لو","قبلته للموت ما قبلته",28,"ه",1,0],["حتّى إِذا ساغَ الهنا بشفائهِ","للسّمعِ واِرتبطَ القلوب حبورُ",29,"ر",1,0],["حتى إذا سئمت قريش حربه","رجعت رجوع مسربل بخسار",30,"ر",1,0],["حَتّى إِذا سامَرتها وَتَرنّمت","كَترنّم الحادي بِمنعرج اللوى",31,"و",2,0],["حتّى إذا سِيلَ اعتَذَر","حتّى إذا زادَ شَكَر",32,"ر",1,0],["حتى إذا سَحَبَ السَّحابُ ذُيولَهُ","فيهِ فدَرْهَمَ ما أَرادَ وَدَنَّرا",33,"ر",2,0],["حتى إذا سطعَ الضياءُ وأشبهَتْ","في لُجّةٍ حَبَاً طَفا ثم انْطَفا",34,"ف",2,0],["حتّى إذا سطَعَتْ مجامرُ ندِّهِ","لبِسَ النّهارُ عليهِ ليلاً مُظلِما",35,"م",2,0],["حتى إذا سيره وأنفذه","نفى أبا ذر لوجه الربذة",36,"ه",1,0],["حتى إذا سادت الظلماء لاح له","ظل يسير الهوينا مقبلاً حذرا",37,"ر",2,0],["حتى إِذا سلَّم ردُّوا وفي","ردهمُ ما يُخْبِرُ الخابر",38,"ر",1,0],["حتّى إِذا سَلَخت مطالعَ صبحها","في حندسِ الليلِ البهيمِ لباسا",39,"س",2,0],["حَتَّى إِذا سِرنا وَجد السير","قالَ الصَّلاة فافعلوها خَير",40,"ر",1,0],["حتى إذا سمع الإفرنجُ غارَتنا","وأنهم بالذى يخشونَ قد قُصِدُوا",41,"د",3,0],["حتى إذا سمعوا فصاحة لفظه","أبدوا لسان الألكن المتلجلج",42,"ج",1,0],["حتّى إذا سلبَ الحدائقَ طِيبَها","وافى فعاجَ على الدِّيارِ وسَلّما",43,"م",2,0],["حتى إذا سلَّ الصباحُ حُسامهُ","وانحازَ داجي الليل عن مرآتِهِ",44,"ت",2,0],["حتى إذا سئموا دار البلى وبت","لهم عياناً هناك الخرب العرب",45,"ب",1,0],["حتَّى إذا سِيمَ اعتساف مهامهٍ","غُبْرٍ محلّ النُّجح فيها أغبر",46,"ر",1,0],["حَتّى إِذا سَكَنَت نَفسي سَمَوتُ لَهُ","أَرعى الجَمالَ وَأَخشى زَلَّةَ القَدَمِ",47,"م",1,0],["حَتّى إِذا سَفَرَ الضُّحى وَتَمارَتِ ال","أَبصارُ أيَّكُما لَهُ الإِشراقُ",48,"ق",1,0],["حَتّى إِذا ساءَ لَونُ العيسِ وَاِنتَكَثَت","شَبَّهتَ في نِسعَتَيها فارِداً شَبَبا",49,"ب",2,0],["حتى إذا سئم الحياة ونابه","فقدان أكرم معشر وبنين",50,"ن",1,0],["حتى إذا سعدت الآصفي وصفت","أوقاتها بسناه باهر النور",51,"ر",1,0],["حتى إذا سمع الزمان بلُقْية","سنحت سنوح الطيف عبر خيالي",52,"ل",2,0],["حتى إذا سجعت مطوقة","ألفيتها بوماً على طلل",53,"ل",1,0],["حتى إذا سلموا للعود وانصرفوا","سريتُ جوعان يفرى عزمى الكلل",54,"ل",1,0],["حتى اذا سألوا للجرم مغفرة","أحييتهم والردى منهم على رصد",55,"د",1,0],["حتى إذا سَكَتَت طارا لعشّهِما","والنفسُ مَشغوفةٌ والقلبُ مَسرُورُ",56,"ر",1,0],["حتى إذا سَرِبَت عَلَيْهِ وبَعَّجَت","وَطْفاء سارِبةٌ كُلِيّ مَزادِ",57,"د",1,1],["حتى اذا سفرت هناك تحجبت","ما بين أطراف القنا والادرع",58,"ع",1,0],["حتى إِذا سَمح الزَمانُ بَدَت لَنا","تَروي حَديثَ السادةِ القدماء",59,"ا",2,0],["حتى إذا سار نحو الخرج محدقة","به النجائب مع خيل وفرسانا",60,"ن",2,0],["حَتّى إِذا سَرَّى سَرى","وَحينَ أَحْيَا قَتَلا",61,"ل",2,0],["حتّى إِذا سَلَك العَدُوُّ سبيلَها","فعلى طريق مَكامِنٍ ومكائدِ",62,"د",1,0],["حتى إذا سبق القضاء وسابقت","شوقاً إليه حورها ولدانها",63,"ن",3,0],["حتى إذا سكن الوجيف وأمسكت","حيناً مدامعنا عن التهتانِ",64,"ن",1,0],["حتى إذا سارت به بان ما","قد كان مأنوساً به مرعبا",65,"ب",2,0],["حتى إذا سقط القناعُ تكشَّفَت","منهُ السمومُ تساقَطَت من فيهِ",66,"ه",1,0],["حتى إذا سئم التعاقب حفلنا","وتكررت في الحادثات لياليا",67,"ل",3,0],["حتّى إذا سُئِلَ العِبارةَ أَخْرَستْ","كلماتِه لُجَجٌ يفِضْنَ حقائقا",68,"ق",2,0],["حتى إذا سئل التاريخ حدثنا","حديث منتصفٍ بين الورى حكم",69,"م",1,0],["حتًّى إذا ساقَ النوَى إعراضَه","بانَ الشروقُ وخيَّمَ الإليالُ",70,"ل",1,0],["حَتَّى إِذا سارُوا لِتَعزِيَةٍ","فَكَأَنَّهُمْ سارُوا إِلَى عُرسِ",71,"س",1,0],["حتَّى إِذا سَمِعَ الأَشعارَ أُطْلِقُها","رَوْضاً تفتَّح أوْراداً وأَزْهارا",72,"ر",2,0]]}