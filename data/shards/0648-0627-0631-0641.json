tps://www.poetsgate.com/ViewPoem.aspx?id=130661",""],[6004,"أيُّ ربيعٍ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=109515",""],[6038,"العيد الوطني للملكة 1422ه","https://www.poetsgate.com/ViewPoem.aspx?id=25699",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6070,"أيّامُ عُمْرِكَ والمَغيبْ","https://www.poetsgate.com/ViewPoem.aspx?id=187881",""],[6070,"فَوِّضْ أمُورَكَ لِلذي سوَّاكا","https://www.poetsgate.com/ViewPoem.aspx?id=189546",""],[6115,"الشهره اللى تجي بالكذب ماهي لي","https://www.poetsgate.com/ViewPoem.aspx?id=180492",""],[6115,"المجلس اللى فيه غيبه ونمات","https://www.poetsgate.com/ViewPoem.aspx?id=180511",""],[1376,"وافى يميل بعطفه وقد انتشى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599331",""],[6171,"أميرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86321&r=&rc=1",""],[6072,"دَوّامات الندى والغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85443&r=&rc=30",""],[6290,"خُلِقْتُ كَبِيرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85162&r=&rc=8",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["وارْفَضَّ عنْ أجْفانِ عَيني رَقْدَةٌ","أطارَها عنها انْتِباهي للعُلا",0,"ا",1,0],["وَاِرفَعوا دَولَتي عَلى العِلمِ وَالأَخ","لاقِ فَالعِلمُ وَحدَهُ لَيسَ يُجدي",1,"د",2,0],["وأرفع إلى فخامة الرئي","س شكر الشاعر",2,"ر",1,0],["وَأَرْفَعُ شُكْرَنَا الأَوْفَى إِلَى مَنْ","هُوَ الرَّأْسُ المُفَدَّى وَالزَّعِيمُ",3,"م",1,0],["وَأَرفاضُ أُحدانٍ تَلوحُ كَأَنَّها","كَواكِبُ لا غَيمٌ عَلَيها وَلا مَحلُ",4,"ل",1,0],["وَأَرفَضَتِ الهَوجُ السَفا فَتَساقَطَت","مَرابِعُهُ الأُولى كَما يَنصُلُ النَبلُ",4,"ل",1,0],["وأرفُلوا أما بثوب الاعتزاز","أو بثوبٍ هو ثوب الكفن",5,"ن",1,0],["وَأَرفَعُ صَدرَ العَنسِ وَهيَ شِمِلَّةٌ","إِذا ما السُرى مالَت بِلَوثِ العَمائِمِ",6,"م",1,0],["وارفض ملامي في البكى متوالياً","وأقرأ على أهل المحبة مصرعي",7,"ع",2,0],["وارفع إلى عمرٍ إسناد بيتك في","فضلٍ وفصلٍ وتقديمٍ وإقدام",8,"م",1,0],["وارْفق بمضناك فما سوى اسمه","ولا لغير ما بقى من رسمه",9,"ه",1,0],["وارفُقْ بخصميَ والمُمْهُ على شَعَثٍ","لا زلتَ ما عشتَ ملموماً بك الشَعَثُ",10,"ث",1,0],["وإرفاد قومٍ قد تركتُ لرفدِهِ","وعند ورود اليمِّ تُنسى المطائط",11,"ط",1,0],["وارفُق بنفسٍ فلم تعْمَهْ وإنْ جهلَت","مقدارُ زلَّتها مقدارُ غفرانك",12,"ك",1,0],["وَاِرفُق بِأَبناءِ الغَباءِ كَأَنَّهُم","مَرضى فَإِنَّ الجَهلَ شَيءٌ كَالعَمى",13,"م",2,0],["وارفع الصوت إن عصرك حر","لن يرى من سماع صوتك بدّا",14,"د",2,0],["وَاِرفُق بِنَفسِكَ إِنَّ خَلقَكَ ناقِصٌ","وَاِستُر أَباكَ فَإِنَّ أَصلَكَ مُظلِمُ",15,"م",1,0],["وارفع ذكرك في الغابرين","وذاك لمثلك عندي قليلُ",16,"ل",1,0],["وارفق بدهنك ينبسط لك صبغه","فيه فسرُّ علاجه التبسيطُ",17,"ط",1,0],["وأرفَهُ خَلْقِ اللّهِ راضٍ بعيشةٍ","وأتعبُهم قلباً على الدهر واجدُ",18,"د",1,0],["وَاِرفَع يَدَيكَ إِلى السَماحَةِ مُفضِلا","إِنَّ العُلا في القَومِ لِلأَعلى يَدا",19,"د",2,0],["وَارفُض دَنِيّاتِ المَطامِعِ إِنَّها","شَينٌ يَعُرُّ وَحَقُّها أَن تُرفَضا",20,"ض",2,0],["وَاِرفَع نَواظِرَهُ وَكُن سَنَداً","فَلَقَد يَكونُ أَخو الرِضا سَنَدا",21,"د",2,0],["وارْفُقْ بِعَبدٍ لَحظُهُ جَزِعٌ","يوْمَ الحساب ونُطْقُهُ هَمسُ",22,"س",1,0],["وَاِرفُضوا الرُسحَ في الشَهادَةِ رَفضاً","لا تُجيزوا شَهادَةَ الرَسحاءِ",23,"ا",2,0],["وَاِرفَعوا بُنيانَهُ حَتّى يُرى","كَالَّذي كانَ أَشَمَّ القِمَمِ",24,"م",1,0],["وارِفَةٌ لِلطَيرِ في أَرجائِها","كَلَغَطِ الكُتّابِ في اِستِملائِها",25,"ا",3,1],["وَاِرفَع لَنا نِسبَةَ أُمَّهاتِها","فَجاءَ يُزجيها عَلى شِياتِها",26,"ت",3,0],["وَاِرَفَع لَهُ شَقراءَ تَرمَحُ في","دَهماءَ مِثلَ تَأَرُّنِ المُهرِ",27,"ر",1,0],["وارفعي يا رُبى إليَّ وأدني","زَهَرَاتٍ من عُشْبكِ المخضَلِّ",28,"ل",1,0],["وارفعي وَجهكِ الجميلَ أرى","كيفَ هذا الحياءُ لَمْ يَذُبِ",29,"ب",1,0],["وَارْفَعِي فِي الأَحْزَابِ رَايَةَ جَمْعٍ","بَيْنَ حُسْنٍ بَاقٍ وَنَجْمٍ سَعِيدِ",30,"د",1,0],["وارفعي شَعْرَك عنه ينجلي","للملا تكوينُ سكانِ السَّماء",31,"ا",2,0],["وَارْفَعْ لِوَاءَكَ فَوْقَ الشَّرْقِ تَلْثِمُهُ","أَفْوَاهُ أَوْدِيَةٍ فِيهِ وَأمْصَارِ",32,"ر",1,0],["وأرفع أهلِها هامًا إذا ما","تقوّست الظهورُ من السجود",33,"د",1,0],["وارفُقْ بجيلٍ قضى أيَّامه شَظَفًا","فبات يحلم بعد الضيق بالرَّغَدِ",34,"د",1,0],["وارْفقْ بعيدٍ، لحظُهُ جَزِعٌ","يَوْمَ الحساب، ونُطْقُهُ همس",35,"س",1,0],["وارفق بدمع كالسحاب لم يزل","يجرى تزمجر فيه انواء النوى",36,"و",2,0],["وارفق بمن هو في هوا","ك تراه لم يسمع ملاما",37,"م",2,0],["وارفق واسعفني بوعد لفظه","كالخمر لألأَ في مبهرج جام",38,"م",1,0],["وارفق فان صبري","عنك من المحال",39,"ل",1,0],["وارفق بمن بهواك غا","ب عن المظاهر والخليل",40,"ل",1,0],["وارفع امورك للآله فانه","قد ينفذ الموهون من اوحاله",41,"ل",2,0],["وارفع العزم واصلح الحزم واثبت","صاح واعمل ولا تكن بطالا",42,"ل",2,0],["وارفع له الحال عن صدق فما رفعت","لغير حضرته في الخطب اصوات",43,"ت",1,0],["وارفُضُوا البَيْن والبعَادً فإني","لستُ أقوى نعُرْوَةُ الحبِّ وُثقَى",44,"ق",2,0],["وارفقوا سالمين في دَرَج العَليا","فإن العُلَى لكم درجاتُه",45,"ت",2,0],["وارفض جميع الشُّغْل عنك وجِدَّ في","التأْويبِ والإدلاجِ والإسراءِ",46,"ا",2,0],["وارفق بنفسكَ يا خلي","لُ أضعتَ في التحصيلِ عمركْ",47,"ك",1,0],["وَاِرفَع وَضَع وَاِعتَزِم وَاِنفَع وَضُرَّ وَصِل","وَاِقطَع وَقُم وَاِنتَقِم وَاِصفَح وَخُذ وَهَب",48,"ب",1,0],["وَاِرفَع وَضَع وَاِقطَع وَصِل وَاِمنَع وَهَب","وَاِنفَع وَضُرَّ وَقُم وَسامِ وَرامِ",49,"م",1,0],["وأرفُلُ في ثَوْبَي صِباً وصبابةٍ","وأسحَبُ ذيلي مِشْيَة المُتبختِر",50,"ر",1,0],["وارفع لمعتمد الحكومة","خالص الشكر الوفير",51,"ر",1,0],["وأرفع إعجابي وشكري خالصا","له واعترافي صادقا وأهنّيه",52,"ي",2,0],["وارفَعي شكواهُ إلى اللَهِ وهناً","وأذيعي لا تكتُمي أخبارَه",53,"ر",2,0],["وَاِرفَعِ الأَلسُنَ الرَديئَةَ عَنّا","وَليَكُن عَيشُنا نُفوساً طِرابا",54,"ب",2,0],["وَاِرفَعِ الأَلسُنَ الخَبيثَةَ عَنها","وَالأَذى في اللَواحِظِ السَوداءِ",55,"ا",2,0],["وارفع ضعيفَك لا يَحُرْ بِكَ ضعفه","يوماً فتدركهُ العواقبُ قد نَمَا",56,"م",2,0],["وَارْفُ ثَوْبَ الْهُدَى بِمُنْصَحِ ثَوْبٍ","إِنَّ أَهْلَ النُّهَى كَذَاكَ رَفَوْهُ",57,"و",2,0],["وَأَرفَعُ الصَوتَ بِالحَديث عَسى","يَخفى وَجيبُ الفُؤادِ في الصَدرِ",58,"ر",1,0],["وارفع مسمّاك من جرّ العوالمل عن","فتح العواطفِ وانعت شأنَه وصِف",59,"ف",1,0],["وارفق ولو بالألتفات","على ما بين الرفاق",60,"ق",1,0],["وارفع عُيونَ اليائسينَ إِلى السنى","وتَفَقَّدَنَّ نَوافذَ السجناء",61,"ا",2,0],["وَاِرفَع عَقيرَةَ شادٍ وَسطَ أَندِيَةٍ","وَصَوتَ حادٍ بِبيدٍ مُطرِبِ الإِبِلِ",62,"ل",1,0],["وأرفعْ عقيرةَ ذي عويل ناعياً","أركانَ فهر فالعماد لقد نعي",63,"ع",2,0],["وارفقْ بزغبٍ عَلَى الأَعشاشِ جاثمة","من كل أَسود ذي نابين فحّاح",64,"ح",1,0],["وَأَرفُضُ الدنيا الغَرور التي","من حبها كان الحجاب المقيم",65,"م",1,0],["وارفع القحط من الأرض مع الظ","لم والجور الذي قد كثفا",66,"ف",2,0],["وَأَرفَعهم ملكاً وذِكراً وعزّةً","وَأَحماهُمُ أَنفاً وأصدقهم ذبّا",67,"ب",2,0],["وَاِرفُضِ البِدعَةَ وَالسُنَّةَ لا","تَعدُها عَدواً تَلَظّى بِلُظى",68,"ظ",2,0],["وَاِرفِق بِجِسم ناحِل","وَبِمدمَع فيهِ اِنسِجام",69,"م",1,0],["وارفَعْ مَحلّي بلفظٍ منك مُشتهِرٍ","يَثْني الحسودَ بمَتْنٍ منه مُنقَصِف",70,"ف",1,0],["وارفع الحال لا تقل","نَصبُه كان أصدقا",71,"ق",2,0],["وأرفع أعمال الفتى في حياته","أمانته والوُدُّ ثم رجاؤه",72,"ا",3,0],["وَاِرفَع بَعَز النَفس هَمك","مِن دَنيّ أَو همام",73,"م",1,0],["وارفع جميع الفتن والإمتحان","واستر فإنك خير الراحمين",74,"ن",1,0],["وارفقوا بي والطفوا بي","سادتي لا تهملوني",75,"ن",2,0],["وارفع ما يعليك في الجنة التي","أعدت لأهل الله من حاملي السر",76,"ر",1,0],["وارفض الدنيا وذرها انها","هم في الحال وفي يوم المفر",77,"ر",1,0],["وأرفع ما يكونُ الناس قدرً","إذا وضعوا الجباه مسبحينا",78,"ن",2,0],["وارفضّ من عرق من مر جامده","حتَّى وددتُ بأنِّي تِربُ مِنشَفَتِهْ",79,"ت",2,0],["وارفق بمهجة مشتاق بقد رديت","وكلّ نفس هواها كانَ مردتيها",80,"ي",3,0],["وارفَعْ رغائِبَ مَا نَوَيْتَ إِلَى الَّذِي","ما زِلْتَ ترفعُها إِلَيْهِ فلم تَخِبْ",81,"ب",1,0],["وارْفَضِّ من دمعِ السحائِبِ لُؤلؤٌ","أضحى لآذانِ الغصون شُنوفَا",82,"ف",2,0],["وأرفد ظهري أن تشلّ جوانبي","أخٌ ما أخى منه لظهرِ أبي نسلُ",83,"ل",1,0],["وارفُ العشيرة ما استطعت فإنها","أمُّ القبائل والفَخارِ الأعْظمِ",84,"م",1,0],["وأرْفَعِهمْ إذا نَزلوا قِباباً","وأمْنَعِهِمْ إذا ما الخَطْبُ غالا",85,"ل",2,0],["وَاِرفُض لِمَن صارَ يَغشى","قَوماً وَلا يَخشاكا",86,"ك",2,0],["وارفع لحضرته أمر الحسين وقل","هذا الشريف وحا