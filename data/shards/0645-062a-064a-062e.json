{"poems":[[119,"متى خيام من احب تقرب","https://www.aldiwan.net/poem41253.html","عموديه"],[285,"محا الدهر آثار الكرام فلم يدع","https://www.aldiwan.net/poem60763.html","الطويل"],[382,"طهارة نفس لا تفيد وتنفع","https://www.aldiwan.net/poem59338.html","الطويل"],[447,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[447,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[463,"وما زائد أبدا ناقص","https://www.aldiwan.net/poem55977.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122759","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122560","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61054","المتقارب"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42402","الطويل"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123824","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100783","الطويل"],[3312,"","https://poetry.dctabudhabi.ae/diwan/poem/146466","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45777","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102974","الطويل"],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""]],"verses":[["متى خيام من احب تقرب","ويشتفى قلب بها معذب",0,"ب",1,1],["مَتى خِفْتُ حالاً حالَ بَيْنِي وَبَيْنَها","تَخاطُرُهُمْ مِنْ بُزَّلٍ وَقُرُومِ",1,"م",1,0],["متى خضع الجسم الكثيفُ قوامُه","لعفة نفسٍ كان باللَه يَخضع",2,"ع",1,0],["متى خبا البرق شبته الصبا فغدت","تنقض كالجمر منثوراً عقائقه",3,"ق",2,0],["متى خمدت نار الأَسى من فؤاده","يهب عليها شمأل الزفرات",4,"ت",1,0],["متى خفَّ أو طاش أعمدتُه","ويُحمدُ وهو رزينٌ ثقيلُ",5,"ل",1,0],["مَتَى خَطَرَت مِنهُ عَلَى القَلبِ خَطرَةٌ","أتَت زَفرَةٌ تَنقَضُّ مِنها حَيازِمُه",6,"م",2,0],["مَتى خُطِبت أُلفيتَ مِدرةَ خُطبِها","وإن تُوّجت ألفيتَ دُرَّةَ تاجها",7,"ج",3,0],["مَتى خنتكم في الهَوى ساعة","فَفارَقت مِن راحَتي اليَمينا",8,"ن",2,0],["متى خبرتْ فالكسرُ منها محققٌ","يحقُّ لنا فيها بأنْ نكثرَ الهجوا",9,"و",2,0],["متى خطبته المكرمات لنفسها","وفي فض ختم المجد قد أحرز الصكا",10,"ك",2,0],["متى خص قلب ابن الكناس برحمة","اذا كان قلب ابن العرينة أرحما",11,"م",2,0],["متى خطفت يد المنية روحه","وقد كان للأرواح بالبيض يخطف",12,"ف",1,0],["مَتى خَطَرت بي الأَريحية لَم يَكُن","إِلى خاطِري يَوماً سِواه بِخاطر",13,"ر",1,0],["متى خفقت في أرض قوم بنوده","أماتهم من قبل موتهم الذعر",14,"ر",1,0],["(متى خط قرد أو ترنم ضفدغ","متى طار عير أو رقا الثور سلما)",15,"م",2,0],["متى خفتُ منْ ناب الحوادث عضَّةً","وإن يعتلقني من أذاهن مخْلبُ",16,"ب",1,0]]}