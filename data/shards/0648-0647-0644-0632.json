{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42567","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[240,"ليهنك أن عيني ما تنام","https://www.aldiwan.net/poem31761.html","الوافر"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[580,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122776","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54163","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59520","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79817","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80022","المتقارب"],[1568,"","https://poetry.dctabudhabi.ae/diwan/poem/202668","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53068","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27527","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91612","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128919","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["وَهَل زانَ تيجانُهُ أُسرَةً","جِباهُهُمُ الغُرُّ تيجانُهُ",0,"ن",2,0],["وَهَلْ زَمَنٌ وَلَّى وَعَيْشٌ تَقَيَّضَتْ","غَضَارَتُهُ بَعْدَ الذَّهَابِ يَعُودُ",1,"د",1,0],["وَهَل زَهَتْ بِبَني الْعَبَّاسِ دَوْلَتُهُمْ","إِلاَّ بِأَمْثَالِ حَمَّادٍ وَبَشَّارِ",2,"ر",1,0],["وَهَل زالَت مَعَ الأَظعانِ عَنها","بُدورٌ لا يُزايِلُها التَمامُ",3,"م",1,0],["وَهَلْ زالَتْ خيامُ الحَي","يِ عن أحْقافِ أعقادِ",4,"د",1,0],["وهل زادهْم بالسِّجن ضيقاً عليهِمُ","وقَدْ جَعَلَ الأَرْضَ الفضاءَ لهم سِجْنا",5,"ن",2,0],["وَهَل زَهرةُ الدُّنيا وَإن هيَ مُوِّهَت","بِزُخرُفِها إلاَّ كَأحلامِ نائِمِ",6,"م",1,0],["وهل زورةٌ نحو الرسول بيثربٍ","تقرب مني ما الزمان يباعدُ",7,"د",1,0],["وهل زادها التركيب إلا دلالة","تدلُّ على ما استودِعتْ من عجائب",8,"ب",1,0],["وَهَل زارَ أَرضَ الزِنجِ جَيشٌ عَرَمرَمٌ","تَكَنَّفَ أُسدَ الغابِ مِنهُ وَشيجُ",9,"ج",1,0],["وهل زمني بالصالحية عائد","يبلغني اقصى المنى ويحقق",10,"ق",1,0],["وهل زالَ من ذاكَ المحيَّا وضاؤه","فقد راح وجهُ الدهر للحشرِ يشحبُ",11,"ب",1,0],["وَهل زحفُ هذا اليوم أبقى لحيِّهم","عميدَ وغًى يستنهض الحيَّ للزحفِ",12,"ف",1,0],["وهل زبرةٌ عضها أدردٌ","فآثر أو نال منها منالا",13,"ل",2,0],["وهل زاره عني ثناء كأنما","يخامر عطف الدهر منه مدام",14,"م",1,0],["وهل زائد في الشمس قولي إنها","من النجم أسمى أو من البدر أوضح",15,"ح",1,0],["وهل زي بابٍ كريم دعا","إلى بابه أحداً أطبقا",16,"ق",2,0],["وَهَل زبرجٌ من جانب العَيش مونقٌ","إذا لَم تَكُن نالَت مُناها البَرازغُ",17,"غ",1,0],["وهل زواجي لسعدي","قد كان أم لعذابي",18,"ي",1,0],["وهل زفرة الدنيا ترى في هوادج","تمر كعير ظالع أم مطافيس",19,"س",1,0],["وهل زهرة الدنيا ترى في هوادج","تمر كبرق خاطف أم طواويس",20,"س",1,0],["وهل زالَت الحجُبُ عنكَ تكرُّماً","وهل رُفِع الرداءُ وزالتِ السدلا",21,"ل",2,0]]}