{"poems":[[5,"جلبنا الخيل من جنبي أَريكٍ","https://www.aldiwan.net/poem295.html",""],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[29,"راح الرفاق ولم يرح مرار","https://www.aldiwan.net/poem5742.html","الكامل"],[29,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[29,"يا عقب لا عقب لي في البيت أسمعه","https://www.aldiwan.net/poem5755.html","البسيط"],[49,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[40,"تذكر هذا القلب هند بني سعد","https://www.aldiwan.net/poem7703.html","الطويل"],[87,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[30,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[63,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[51,"أرقت وطار عن عيني النعاس","https://www.aldiwan.net/poem64220.html","الطويل"],[82,"ونوبية في الخلق منها خلائق","https://www.aldiwan.net/poem31328.html","الطويل"],[83,"كأن الخال في وجنات موسى","https://www.aldiwan.net/poem61528.html","الوافر"],[41,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62242","الوافر"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54545","الكامل"],[102,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[189,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[269,"أسرك أم أساءك فعل قومي","https://www.aldiwan.net/poem2032.html","الوافر"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[369,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122318","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77480","الرجز"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205217","الطويل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128273","الكامل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73494","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109084","الوافر"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114828","الوافر"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12016","الوافر"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12015","الوافر"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96349","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102059","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141248","البسيط"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117811","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205040","الوافر"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96128","الوافر"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89425","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62761","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102383","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66415","الطويل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101354","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90925","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94327","البسيط"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45315","الوافر"],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[4802,"جرح الندم","https://www.poetsgate.com/ViewPoem.aspx?id=32348",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[5039,"بعض الحكي","https://www.poetsgate.com/ViewPoem.aspx?id=48122",""],[5219,"أشجان عربي","https://www.poetsgate.com/ViewPoem.aspx?id=194935",""],[5324,"مسك الختام.","https://www.poetsgate.com/ViewPoem.aspx?id=207254",""],[5409,"ذكرت الجنان وأنهارها","https://www.poetsgate.com/ViewPoem.aspx?id=155274",""],[5525,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=7272",""],[5638,"رثاء الشيخ أحمد ياسين","https://www.poetsgate.com/ViewPoem.aspx?id=198130",""],[5948,"حبيبي لا يزورُ ولا يُزارُ","https://www.poetsgate.com/ViewPoem.aspx?id=100594",""],[6127,"صُفِّ الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=189733",""],[6189,"فيروز أغنية العش الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83597&r=&rc=64",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""]],"verses":[["كَأَنَّ الخَيلَ أَيمَنَ مِن أَباضٍ","بِجَنبِ عُوَيرِضٍ أَسرابُ دَبرِ",0,"ر",1,0],["كانَ الخَليطُ هُمُ الخَليطَ فَأَصبَحوا","مُتَبَدِّلينَ وَبِالدِيارِ دِيارُ",1,"ر",1,0],["كانَ الخِيارَ سِوى أَبيهِ وَعَمِّهِ","وَلِكُلِّ قَومٍ سادَةٌ وَخِيارُ",2,"ر",1,0],["كَأَنَّ الخَيلَ بَعدَ قِيادِ حَولٍ","قِياسُ النَبعِ شَحَّجَهُنَّ باري",3,"ر",2,0],["كانَ الخَليلُ الَّذي تَبقى مَوَدَّتُهُ","عِندي وَمَوضِعَ حاجاتي وَأَسراري",4,"ر",2,0],["كَأَنَّ الخَيلَ تَعرِفُ مَن عَلَيها","فَفي بَعضٍ عَلى بَعضٍ تُعالي",5,"ل",2,0],["كَأَنَّ الخُزامى خالَطَت في ثِيابِها","جَنِيّاً مِنَ الرَيحانِ أَو قُضُبِ الرَندِ",6,"د",1,0],["كَأَنَّ الخودُ مَريَمُ في سُفورٍ","وَرائيها حَوارِيٌّ وَقِسُّ",7,"س",1,0],["كَأَنَّ الخَلايا فَوقَ كُلِّ ضَريرَةٍ","تُخَطِّمُهُ في دَوسَرِ الماءِ نيبُها",8,"ب",3,0],["كأنَّ الخطوبَ إذا حاولَتْه","تَقَطَّرَ منها بقُطْرَي حِراءِ",9,"ا",2,0],["كَأَنَّ الخَلقَ رُكِّبَ فيهِ روحٌ","لَهُ جَسَدٌ وَأَنتَ عَلَيهِ راسُ",10,"س",1,0],["كأنّ الخطوطَ البيضَ والصّفْرَ أشبهتْ","على جسمها ترصيعَ عاجٍ بِصَندلِ",11,"ل",1,0],["كَأَنَّ الخالَ في وَجَناتِ موسى","سَوادُ العَتبِ في نورِ الوِدادِ",12,"د",1,1],["كَأَنَّ الخَيمَ هاجَ إِلَيَّ مِنهُ","نِعاجُ صَرائِمٍ حُمَّ القُرونِ",13,"ن",1,0],["كَأَنَّ الخَلايا فيهِ ضَلَّت رِباعُها","وَعوذاً إِذا ما هَدَّهُ رَعدُهُ اِحتَفَل",14,"ل",1,0],["كَأَنَّ الخَيْلَ قَد صَبَّحْنَ كَلْباً","يَرَيْنَ وَرَاءَهُمْ مَا يَبْتَغِينَا",15,"ن",2,0],["كَأَنَّ الخُدورَ أَولَجَت في ظِلالِها","ظِباءَ المَلا لَيسَت بِذاتِ قُرونِ",16,"ن",1,0],["كأنّ الخُزامى جمّعَتْ لكِ حُلّةً","عليكِ بها في اللونِ والطّيبِ سِرْبال",17,"ل",1,0],["كَانَ الخَلِيلُ بِجِدِّهِ وَثَبَاتِهِ","لِلْمُقْتَدِينَ بِهِ أَجَلَّ مِثَالِ",18,"ل",1,0],["كَانَ الخَميسُ وَكُلَّ ظَني","أَنَّنِي في الأَرْبَعَاءْ",19,"ا",2,1],["كان الخميس أو الاثنين واحتشدت","مواقف ، تدفع الذكرى وتلتقف",20,"ف",1,0],["كأنّ الْخَمْرةَ الحَمْراء رَاقتْ","وأوراقُ الشَّقيقِ لها قِعاب",21,"ب",1,0],["كَأَنَّ الخَيلَ بِالنَحيَينِ هَجرا","وَبِالبَقعاءِ رَجلٌ مِن جَرادِ",22,"د",1,0],["كانَ الخليفةُ يمشي بينَ أعمدةٍ","كأنه الليثُ يمضي في عفرّينا",23,"ن",2,0],["كان الخلائفُ يحفظون عهودَها","وهي المهانةُ عند علجٍ يزدري",24,"ر",2,0],["كأنَّ الخالدِيّةَ يومَ راحَتْ","تَهادَى بينَ أترابٍ نَواعم",25,"م",1,0],["كأنَّ الخزامى صفقت منهُ قرقفاً","فالمسكر أعناق المطيّ تميل",26,"ل",1,0],["كأن الخطوب قيون له","فيرجع احسن ما كان أثرا",27,"ر",2,0],["كان الخَروف عِندَ نَهر يشرَبُ","وَالذئب فَوقَ ريحه وَأَقرَبُ",28,"ب",1,0],["كأنَّ الخزامى صفقت منهُ قرقفاً","فللسكر أعناق المطيّ تميل",29,"ل",1,0],["كان الخيار بقبضتي فأضعته","وبقيت متكلا على الأعذار",30,"ر",1,0],["كَأَنّ الخضرَ مَرَّ بِهِ يَميناً","وَمَدَّ عَلَيهِ جبريلٌ جَناحا",31,"ح",2,0],["كأَن الخمرَ قد عشقت قديماً","قبيل عصيرها بل قبل تغرس",32,"س",1,0],["كأنّ الخيل طالِعَةً عليهم","بفُرسانِ الصَّباحِ قَطاً رِعالُ",33,"ل",1,0],["كَأَنَّ الخالَ في الخَدِّ اليَمينِ","ظَلامُ الشَكِّ في صُبحِ اليَقين",34,"ن",1,1],["كَأَنَّ الخالَ في الخَدِّ الشِمالِ","ظَلامُ الهَجرِ في صُبحِ الوِصال",35,"ل",1,1],["كأن الخدور الجأت في ظلالها","نعاج الملا ليست لهن قرون",36,"ن",1,0],["كأن الخال في خدي مليح","تبارك من بري ذا القدِّ قادر",37,"ر",1,0],["كان الخليفة نوراً في حماك ولم","يصب بنوكِ بإرهاقٍ وإظلام",38,"م",1,0],["كأنَّ الخيلَ مركبها سنيحاً","قطاميّ بناصفةِ العناب",39,"ب",1,0],["كأن الخل قد أهدى مماتي","إليّ غداة أهداني أباه",40,"ا",2,0],["كأن الخيل ان آنسن كلبا","يرين وراءهم ما يبتغينا",41,"ن",2,0],["كان الخليل كلما جاء المقام","يسند ظهره بالتزام",42,"م",1,0],["كان الخديوي تُربِّيه كوالدة","اللَه يمنحها فضلاً ويبقيه",43,"ي",2,0],["كأنّ الخيلَ من مرحٍ ولهوٍ","تُنزعهُ إذا تركَ الرّحيلا",44,"ل",2,0],["كأنَّ الخزامى يمُجُّ الندى","بمَحنيَةٍ أُنُفاً والعرارا",45,"ر",2,0],["كان الخلال الأحمر اللون إذ بدا","لدى وكرها العناب لا الحشف البالي",46,"ي",1,0],["كَأَنَّ الخَيْلَ إذْ عَرَفَتْ مَقامِي","تُفادي عن َشَتيِمِ الوَجْهِ صَارِ",47,"ر",1,0],["كأن الخيل يرسلها سراباً","كواكب في السماء لها طراد",48,"د",1,0],["كان الخال فوق العنق منها","وصارم لحظها الماضي مجرد",49,"د",1,0],["كان الخلوص تَوى والحرُّ يندبُهُ","والآن قد عاش إذ أنتم خلاصتُهُ",50,"ت",2,0],["كَأَنَّ الخَيلَ يَومَ بِناتِ قينٍ","يُرينَ وَلاءَهُم ما يَبتَغينا",51,"ن",2,0],["كأنَّ الخدود غطَّاها لفاعٌ","هلال الأفق غطي بالسحابِ",52,"ب",1,0],["كان الخطا يبقى مخلد ذهابي","جرح الندم له في جبيني تراسيم",53,"م",1,0],["كأن الخيل صيغت من حمامٍ","إذا قيل أركبي فيهم وميدي",54,"د",2,0],["كان الخلق حولك حين صاروا","بنعشك وفد يبغون وفدا",55,"د",2,0],["كان الخطا بأن أنا مانيب أحد ثان","فأنا أعترف رميتك ياعاذلي صابت",56,"ت",1,0],["كأن الخيانة طبع لنا","رضعنا النفاق ومنذ الصغر",57,"ر",1,0],["كان الختام من الشفاهِ رِشافا","أبراَ العليلَ من الهمومِ وشافى",58,"ف",2,1],["كأن الخمائل من فوقهن","نثرن على الأرض أزهارها",59,"ر",3,0],["كان الخطا منى ... فقلبي خطاياه","هو علمه ... وشلون ... يهجر ويجفا",60,"ف",2,0],["كَانَ الخِيَانَةُ كَالنُّجُومِ دَفَنْتَهَا","فِي الأَرْضِ حِينَ أَتَيْتَ بِالشُّرَفَاءِ",61,"ا",2,0],["كأنَّ الخمرَ يغذو وجنتيه","وحسبُكَ ما تُزينُه العقارُ",62,"ر",1,0],["كانَ الخيارُ بأنْ تأتيْ على عَجَلٍ","دونَ اكْتِراثٍ بما تَلْقَى وإنْ عَظُما",63,"م",2,0],["كان \"الخليج\" دماءً و\"الجليل\" أسى","وفوق \" بامير \" سيل الظلم يستعر",64,"ر",1,0],["كان الخطا بة والبلا","غة والمكارم والقرى",65,"ر",2,0]]}