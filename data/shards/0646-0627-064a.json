",""],[5111,"تَرَاتيْلُ الْبَتُولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212511",""],[5111,"شَجْوٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212519",""],[2365,"نائح في الغصون بالليل ناحا","https://www.poetsgate.com/ViewPoem.aspx?id=200663",""],[5261,"رمضانيون","https://www.poetsgate.com/ViewPoem.aspx?id=212890",""],[5271,"شك!!!","https://www.poetsgate.com/ViewPoem.aspx?id=60072",""],[5376,"قد عدت يا عيد ما عادت أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=188357",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5411,"ضجيج الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=185306",""],[5431,"الناي يشدو مسمعا عذره","https://www.poetsgate.com/ViewPoem.aspx?id=196785",""],[5431,"الى حيّ الميدان الدمشقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202358",""],[5431,"نأيتُ ولي قلبٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=211003",""],[5484,"في رثاء شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=206306",""],[5491,"جنون من العشق","https://www.poetsgate.com/ViewPoem.aspx?id=197549",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5690,"سلوا عن فؤادي من بار واحنا يفدا","https://www.poetsgate.com/ViewPoem.aspx?id=172144",""],[349,"راحل مقيم","https://www.poetsgate.com/ViewPoem.aspx?id=146248",""],[5701,"نأيت بنفسي عنك أجتنب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=164653",""],[5707,"اتتنا من ودادك خير هبه","https://www.poetsgate.com/ViewPoem.aspx?id=189184",""],[5821,"يوم السبت - مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=114115",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5861,"سراب الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=188086",""],[6008,"ترحيبيه بالإمير فهد بن بدر آل سعود","https://www.poetsgate.com/ViewPoem.aspx?id=60995",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6056,"نايض البرق","https://www.poetsgate.com/ViewPoem.aspx?id=130383",""],[6142,"لمن أذيل عقيق الأدمع السجم","https://www.poetsgate.com/ViewPoem.aspx?id=155760",""],[321,"لهفى عليك ابا النذير لو انه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606414",""],[6239,"نُور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75986&r=&rc=37",""],[6248,"رجع الخاصرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86024&r=&rc=1",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""],[6301,"حَنِيْنٌ الى لِقَاءٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80673&r=&rc=37",""]],"verses":[["نَأى السِربُ عَنكَ وَعَهدي بِهِ","تَكَنَّسُ في القَلبِ غِزلانُهُ",0,"ن",2,0],["نائي الحَنا داني النُهى صافي السَدى","ضافي العَطايا وَالعُلى وَالمَفخَرِ",1,"ر",1,0],["نأَيتِ وَبَينَنا رُبَواتُ نَجدٍ","يُضِلُّ بِها الأَداحيَّ النَّعامُ",2,"م",1,0],["نَأَى فَأَثارَ الحَرْبَ يَصْرِفُ نابَها","عَلَيَّ زَمانٌ كانَ يَجْنَحُ لِلسِّلمِ",3,"م",1,0],["نَأَى عامِرٌ لا قَرَبَّ اللهُ دارَهٌ","وَآواهُ رَبْعٌ بِالغُمَيْرِ جَديبُ",4,"ب",1,0],["نأى بجانِبِهِ والصُّبْحُ مُبْتَسِمُ","طَيْفٌ تبلّجَ عنهُ مَوْهِناً حُلُمُ",5,"م",1,1],["نائي المَدى يَقْصُرُ عن شأْوِهِ","خُطاً أطالَتْها الأعادي فِساحْ",6,"ح",1,0],["نأى فأنْكَرْتُ نَصْلي واتَّهَمْتُ يَدي","وفاقِدُ النّصرِ يومَ الرّوعِ مَفقودُ",7,"د",1,0],["نَأى المَزارُ بِهِ وَالدارُ دانِيَةٌ","يا حَبَّذا الفَألُ لَو صَحَّت زَواجِرُهُ",8,"ر",2,0],["نَائِبٌ أَيْقَظَ الْحِمَى","وَعَنِ الْحَقِّ لَمْ يَنَمْ",9,"م",1,0],["نَأَيْتَ مُخَلِّفاً ذِكْراً جَمِيلاً","وَشِعْراً شَائِقاً يُصْبِي الْحَلِيمَا",10,"م",2,0],["نَأَينَ فَلا يَسمَعنَ إِن حَنَّ صَوتُهُ","وَلا الحَبلُ مُنحَلٌّ وَلا هُوَ قاضِبُه",11,"ب",2,0],["نَأى الحَيُّ الَّذينَ يَهيجُ مِنهُم","عَلى ما كانَ مِن فَزَعٍ رَكوبُ",12,"ب",1,0],["نائي المَناهِلِ طامِسٍ أَعلامُهُ","مَيتِ الشُخوصِ بِهِ يَكادُ يَحولُ",13,"ل",1,0],["نأى بيتها ونأى ذهنه","كما قد نأى عنهُ بيت النشيد",14,"د",1,0],["نائي اللقا وحماه أقرب مطرحاً","يا بعد مجتمع وقرب مزار",15,"ر",1,0],["نأى بك الشام يا خلي فقلت عسى","خلّ بمصر إذا بالموت قد طرقَه",16,"ه",1,1],["نأى فنأى عنِّي الكرى وتغيبت","فلا طيب أحلامي ولا فضل حلمها",17,"م",3,0],["نأى ولمن لم يألف العشق غادر","فما عذر عذريّ الغرام وفيّه",18,"ي",2,0],["نائلٌ لم يزلْ مُفاضاً علينا","بيمينيه من ثراءٍ مُفاض",19,"ض",1,0],["نأى القبح عن يوسف","وأنت له يوسف",20,"ف",1,0],["نأى ولم ينأَ نأياً ينطوي أبداً","لزائريهِ بنصٍّ أو بإرقالِ",21,"ل",1,0],["نَأَينَ بِنا غَداةَ دَنونَ مِنها","وَهُنَّ إِلَيكَ بِالجَولانِ صورُ",22,"ر",1,0],["نَأى فَما في قُربِهِ مَطمَعٌ","لا تَصِلُ الكَفُّ إِلى الفَرقَدِ",23,"د",1,0],["نائي الرَجاءِ فَلا أَسيرٌ موثَقٌ","أَرجو الفَكاكَ وَلَستُ حُرّاً مُطلَقا",24,"ق",2,0],["نَأى كاظِماً لِلغَيظِ خَوفَ شَماتَةٍ","وَلَم يَطلُبِ الإِنصافَ خِفيَةَ لائِمِ",25,"م",1,0],["نَأَيتُ فَلَم يُحدِث لِيَ النَأيُ سَلوَةً","وَلَم أُلفِ طولَ النَأيِ عَن خُلَّةٍ يُسلي",26,"ل",2,0],["نأى بي عن الأصحاب في سيره العمر","ويرجع أحياناً إليهم بي الذكر",27,"ر",1,1],["نَأَيتَ فَقاتَلَهُم بِاللِقاءِ","وَجِئتَ فَقاتَلَهُم بِالهَرَب",28,"ب",1,0],["نائِلٌ مِنكَ نَظرَةً ساقَهُ الفَق","رُ عَلَيهِ لِفَقرِهِ إِنعامُ",29,"م",1,0],["نَأَينَ بِحاجَةٍ وَجَذَبنَ قَلباً","تَأَبّى ثُمَّ أَصحَبَ في القِيادِ",30,"د",1,0],["نَأى رَبُّهُ عَنّا وَأَعرَضَ دونَهُ","عَلى كُرهِنا عَرضُ الثَرى وَالجَنادِلُ",31,"ل",1,0],["نأيْتَ فأصبحْتَ جارَ الفُراتِ","وكنتَ لدِجلةَ من قبلُ جارا",32,"ر",2,0],["نَأَيتُ فَلا مالاً حَوَيتُ وَلَم أُقِم","فَأَمتَعَ إِذ فُجِّعتُ بِالمالِ وَالأَهلِ",33,"ل",1,0],["نَأيٌ وَشيكٌ وَاِنطِلاقُ","وَغَليلُ شَوقٍ وَاِحتِراقُ",34,"ق",1,1],["نَأيُ النَدى لا ثَنائي خُلَّةً وَهَوىً","وَالفَجعُ بِالمَجدِ غَيرُ الفَجعِ بِالغَزَلِ",35,"ل",1,0],["نَأَينا عَنِ الحَيِّ حَتّى إِذا","تَوَدَّعَ مِن نارِها المَوقِدُ",36,"د",1,0],["نَأيُها سُقمٌ وَأَشتا","قُ إِذا تَمشى قَريبا",37,"ب",2,0],["نائِلاً طَرفُها القَساوِرَ وَالصُدعانَ","وَالطِفلُ في المَنارِ الشَكيلا",38,"ل",2,0],["نَأَيُّها سُقمٌ وَأَش","تاقُ إِذا أَمسَت قَرِيبا",39,"ب",2,0],["نَأى عَنهُ النَسيسُ فَقَد تَساوى","لَهُ لَمسُ الحَديدَةِ وَالحَريرَه",40,"ر",2,0],["نَأيُ زُنامِ أَوانَ يُدهى","حَدَّثَ بِالنايِ عَن زُنامِ",41,"م",1,0],["نأى طيرُها عانياً واختفى","غرامٌ أتى وغرامٌ ذهبْ",42,"ب",1,0],["نَأى عامِرٌ عنها وأصْحابُ مُذْهَبٍ","وما رَبُّ مَيّاسٍ بها الدّهْرَ مائِس",43,"س",1,0],["نَائِلٌ مِنْ جَمِيلِ وُدِّكَ أَوْفى","بِرِّ بَاقٍ بِرَاحِلٍ مَبْرُورِ",44,"ر",1,0],["نأَى عنّي وخلّف لي فؤاداً","يذوبُ أسىً عليه ويضمحلُ",45,"ل",1,0],["نأيت عنها ولكن لا أفارقها","بلى كم افترقت ورح وجثمان",46,"ن",1,0],["نائية القطوف كلّ نجمة","من شفتي دانية القطوف",47,"ف",1,1],["نائلٌ لم يزلْ مُفاضاً علينا","بيمينه من ثراءٍ مُفاضِ",48,"ض",1,0],["نَائي الدِيار بَعيد الوَصل مُحتَجب","وَقَلب عاشِقِهِ بِالصَد مُكتَئب",49,"ب",1,0],["نائب المرتضى امين المعالي","في بني المصطفى رفيع العماد",50,"د",1,0],["نائب تاج الانبياء بالهدى","واقرب القوم اليه سببا",51,"ب",2,0],["نأى عنه من يهواه والبين مزعج","ولم يلق للبين المبرح اسبابا",52,"ب",2,0],["نَأيُ الشِّفا وَتَدَاني الجَفَا كَشَفَا","سَجفَ اصطِبَارِي ومَنَّانِي وشَفَّانِي",53,"ن",2,0],["نأيتِ عني بلا ذنبِ وملتِ إلى ال","واشين والغصن من عاداته الميل",54,"ل",1,0],["نأيتَ فَلم أطِبق على سَلوَةٍ حَشىً","صَدَدتَ فلم أُغمِض على سِنَةٍ جَفنا",55,"ن",2,0],["نأى فَنأى صَبري وَأَكدى تَجَلُّدي","وَلا شَيءَ إِلّا القُربُ يأَخُذُ بِاليَدِ",56,"د",1,0],["نَأى فَصَبَبنا الدَمعَ نَمري شُؤُونَهُ","وَنَذري عَلى حُكمِ النُزوع هَتونَهُ",57,"ه",1,0],["نأيتم فما وفي الصداقة حقها","سوى دمع عيني والصديق قتيل",58,"ل",1,0],["نأيتم فاغليتم رخيص تجلدي","وصبري وأرخصتم من الدمع ما يغلو",59,"ل",2,0],["نَأى يَمانِيّاً فَلَمّا اِنتَشَرَت","أَحضانُهُ وَاِمتَدّ كِسراهُ غَطا",60,"ا",1,0],["نأى مَن أحبُّ فلي مَدمعٌ","كما انْتَثَر اللؤلؤ المُختزَنْ",61,"ن",1,0],["نأيت وصعب الدمع بعدك بالأسى","ذلول ومطواع التصبر جامع",62,"ع",1,0],["نَأَيتِ فَأَيُّ بَرقٍ لَم يَشُقني","إِلَيكَ وَأَيُّ دارٍ ما شَجَتني",63,"ن",2,0],["نَأَيتِ فَحَرَّمتَ الجُفونَ عَنِ الكَرى","وَأَغرَيتِ دَمعَ العَينِ بِالهَمَلانِ",64,"ن",1,0],["نائي المَحَلِّ وَجودُهُ","لِعُفاتِهِ داني القُطوفِ",65,"ف",1,0],["نأيتُم فلولا ما تُقَرِّرُهُ المُنى","بقلبي عليكم ما استقَرَّت بلابلُه",66,"ل",2,0],["نأى شَبَحي عنها فعزَّت زيارتي","ولكنّ شِعري خالدُ النَّغمات",67,"ت",1,0],["نَأَى ودَنَا مَكاناً وامْتِنَاناً","فَيَهْنِي المَجْدَ نَاءٍ مِنْهُ دانِ",68,"ن",1,0],["نَأى راقِياً وَدَنَا قارياً","فبُشرَاك بالأبعَد الأقرَب",69,"ب",1,0],["نأَيْتَ عَلى قُرْبٍ مِنَ الدّارِ بَيْنَنا","وَكُلُّ قَرِيبٍ لا يَوَدُّكَ نائِي",70,"ي",1,0],["نأى ففرَّق بين الطَرف والوسن","وَأَلَّف البينُ بين القَلب والحزنِ",71,"ن",1,1],["نأَيتم فأذوى ناضرَ العَيش نأيُكم","وَعادَ رَبيعُ الوصل وهو محرَّمُ",72,"م",1,0],["نأيت هجراً فَلا وَصلٌ ولا سَبَبٌ","وَبنتِ داراً فَلا عَينٌ ولا أَثَرُ",73,"ر",1,0],["نأيتم فَلا حرُّ الفِراقِ مُفارِقٌ","فؤادي ولا جمرُ الصَبابة بائخُ",74,"خ",1,0],["\"نأْيتُ بجانبي وَأجبت \"\"كلاّ\"\"\"","بملءِ فمي وأزمعتُ الرحيلا",75,"ل",2,0],["نأى بأعطافِه من تيهه وَرَسا","بأصلِهِ وَسما بالأنفِ والراسِ",76,"س",1,0],["نأيت عني فلبست الضنى","واصفرَّ حتى وجه صهبائي",77,"ي",1,1],["ناي دقيق ناعم قرنت به","نعم مؤلفة من الموسيقي",78,"ق",2,0],["ناي ساحر النغمه","سقاها الحب فانداحت",79,"ت",1,0],["نأَى بي عَن موارِدِهِ زَمَاني","فَأَرْسَلَ لي نَداهُ مَعَ السَّحَابِ",80,"ب",1,1],["نَأى وَدِيارُنا تَلتاع وَجداً","وخلّى في حشاشتنا حَنينا",81,"ن",2,0],["نَأَيتُم وَما النائي سِوى القَلب قَبلَكُم","وَيا رُبَّما صادَفتُموه عَلى الدَربِ",82,"ب",1,0],["نأى عُلُوّاً أو أدناهُ تَكرُّمُه","مِن كَفِّ مَن يَجْتني منه ليَجْتنيا",83,"ي",2,0],["نأىَ النّومُ عَنّىَ لمّا نأوا","وأقْسمَ لا عادَ حتّى يَعودوا",84,"د",3,0],["نائباً عن أبيك في بَثِ نورٍ","يَمْلأُ الأرضَ دائماً بالضّياء",85,"ا",2,0],["نَأى بِهِ المُلكُ حَتّى قيلَ ذا مَلَكٌ","دَنا بِهِ الجودُ حَتّى قيلَ ذا بَشَرُ",86,"ر",1,0],["نَأَيت بِقَلبك وَالود لا","بِوَجهك عَني وَهَذا أَضَر",87,"ر",1,0],["نَأى بِجانِبِهِ عَنّي وَصَيَّرَني","مَعَ الاِسى وَدَواعي الشَوقِ في قَرَنِ",88,"ن",1,0],["نأيتُمُ فنأى السّلوان واتّسعَتْ","أبوابُ صبري حتّى ضاقتِ الحيَلُ",89,"ل",1,0],["نائله عذبٌ بيوم النَّدى","وهو بيوم البأس مُرُّ المذاق",90,"ق",1,0],["نأَيْتَ فودَّعْنا الفضائل كلَّها","فيا نائياً بالله هلْ أنتَ قادم",91,"م",1,0],["نائياً عن وَطَنٍ قاطنه","يحسُد