{"poems":[[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[51,"يا ابن حسان لا تشكن في دينى","https://www.aldiwan.net/poem66483.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[105,"يا ابن عوف سر حثيثا باللواء","https://www.aldiwan.net/poem43583.html","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42654","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[184,"لي صديق صدقاته نفر السب","https://www.aldiwan.net/poem43565.html","الخفيف"],[252,"لا تلمني","https://www.aldiwan.net/poem24962.html","مجزوء الرمل"],[259,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[326,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[326,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[326,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[326,"كيف ينسى غرامه","https://www.aldiwan.net/poem55068.html","مجزوء الخفيف"],[360,"حب جديد","https://www.aldiwan.net/poem11635.html","عموديه"],[388,"أحمد السقاف أبشر لا نخاف","https://www.aldiwan.net/poem54552.html","عموديه"],[413,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[429,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[456,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[466,"غنى فأبكى بصوته الفرنجا","https://www.aldiwan.net/poem60320.html","المنسرح"],[477,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[556,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"]],"verses":[["مُلهَماتٍ مِن دِقَّةِ الصُنعِ مالا","يُلهَمُ الشِعرُ مِن دَقيقِ المَعاني",0,"ن",2,0],["مِلَّةٌ رِشْدةٌ أَراني هُداها","بصرٌ ثاقب وعقلٌ متين",1,"ن",1,0],["ملها بعد ان قضى","الشيخ من جسمها الوطر",2,"ر",1,0],["مِلَّةٌ فُضْلَى وبَعلٌ صالحٌ","حَبَّذَا القَسمُ وما أسنَى العَطَاءْ",3,"ا",2,0],["مَلْهَى أَخِي طَرَبٍ وَمَلْعَبُ صَبْوَةٍ","وَثَرَى بُلَهْنِيَةٍ وَدَارُ أُنَاسِ",4,"س",1,0],["مُلْهِباً عَزْمَه إِذا اجتازَ غَوْراً","مُسْتَحِثّاً إِذا تسلَّقَ نَجْدا",5,"د",2,0],["ملهمٌ باليهود والسبت عن ذك","ر ليالي التغريب والتشريق",6,"ق",1,0],["ملهِمٌ في الأرضِ نورٌ","كوكبٌ ما في علاهُ",7,"ا",2,0],["مله العائدون مني وما","اعضل داءً تملّه عواده",8,"د",2,0],["ملهمى يوم لأرجاء رجائي","حين أعطى كما يشاء كتابي",9,"ب",2,0],["ملهماً أستبيح مالا يبيح النا","س في عالم قليل المتاع",10,"ع",1,0],["ملهم بالفجور أفكاره الإثم","وليل الساقي ويوم الخلي",11,"ي",1,0],["ملهَمٌ من ملاكه","بدّد الشكّ باليقين",12,"ن",1,0],["مَلهوفَة ً تستفسِرُ:","أتحبُّني يا أسمرُ؟",13,"ر",1,0],["ملة ما مثلها في حسنها","كل من يمشي عليها لا يخاف",14,"ف",1,0],["ملة فيها السلامة والهنا","غيرها فيها البلايا والحراف",14,"ف",1,0],["ملهمٌ يعلم ما يأتي من الأَ","مرِ إنْ شاءَ وبعض النَّاس ملهم",15,"م",1,0],["مُلْهيةُ الداعي وحنانة ال","حادي ومُستَطْرَفَةِ السائر",16,"ر",1,0],["مُلهَبةٌ سوقُ الوفاءِ عنده","لا يُخمِدُ الجفاءُ من نيرانِها",17,"ن",3,0],["مِلَّةٌ في الوفاء ضيَّعها النا","سُ وأحييتَها سَناءً وفخرا",18,"ر",2,0],["مُلهٍ أَتانا وَوَقتُنا حَسَنٌ","فَعادَ مَن حَسَّ عودِهِ سَمِجا",19,"ج",2,0],["مله اكتسبت حياة قلبي والذكا","وله سعيت ولست عنه أغيب",20,"ب",1,0],["ملة للموحدين نهار","وعلى المشركين ليل طويل",21,"ل",1,0]]}