رمل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80185","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69374","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202136","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202066","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48264","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205853","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101630","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74051","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52161","الرمل"],[4869,"وطن قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=138052",""],[5526,"الصبر والياس","https://www.poetsgate.com/ViewPoem.aspx?id=198261",""],[5537,"وجع","https://www.poetsgate.com/ViewPoem.aspx?id=208165",""],[5739,"الشريط ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127064",""],[5749,"القوة والجهد والصغر","https://www.poetsgate.com/ViewPoem.aspx?id=140223",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5952,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202282",""],[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""]],"verses":[["مُلهَماتٍ مِن دِقَّةِ الصُنعِ مالا","يُلهَمُ الشِعرُ مِن دَقيقِ المَعاني",0,"ن",2,0],["مِلَّةٌ رِشْدةٌ أَراني هُداها","بصرٌ ثاقب وعقلٌ متين",1,"ن",1,0],["ملها بعد ان قضى","الشيخ من جسمها الوطر",2,"ر",1,0],["مِلَّةٌ فُضْلَى وبَعلٌ صالحٌ","حَبَّذَا القَسمُ وما أسنَى العَطَاءْ",3,"ا",2,0],["مَلْهَى أَخِي طَرَبٍ وَمَلْعَبُ صَبْوَةٍ","وَثَرَى بُلَهْنِيَةٍ وَدَارُ أُنَاسِ",4,"س",1,0],["مُلْهِباً عَزْمَه إِذا اجتازَ غَوْراً","مُسْتَحِثّاً إِذا تسلَّقَ نَجْدا",5,"د",2,0],["ملهم الشعر من هوى كلّ نفس","ولبنات كلّ قلب عميد :",6,"د",1,0],["ملهم حاضر البديهة تغريه","بأحلى ممّا اصطفى وأعدّا",7,"د",2,0],["ملهمٌ باليهود والسبت عن ذك","ر ليالي التغريب والتشريق",8,"ق",1,0],["ملهِمٌ في الأرضِ نورٌ","كوكبٌ ما في علاهُ",9,"ا",2,0],["مله العائدون مني وما","اعضل داءً تملّه عواده",10,"د",2,0],["ملهمى يوم لأرجاء رجائي","حين أعطى كما يشاء كتابي",11,"ب",2,0],["ملهماً أستبيح مالا يبيح النا","س في عالم قليل المتاع",12,"ع",1,0],["ملهم بالفجور أفكاره الإثم","وليل الساقي ويوم الخلي",13,"ي",1,0],["ملهَمٌ من ملاكه","بدّد الشكّ باليقين",14,"ن",1,0],["مَلهوفَة ً تستفسِرُ:","أتحبُّني يا أسمرُ؟",15,"ر",1,0],["ملة ما مثلها في حسنها","كل من يمشي عليها لا يخاف",16,"ف",1,0],["ملة فيها السلامة والهنا","غيرها فيها البلايا والحراف",16,"ف",1,0],["ملهمٌ يعلم ما يأتي من الأَ","مرِ إنْ شاءَ وبعض النَّاس ملهم",17,"م",1,0],["مُلْهيةُ الداعي وحنانة ال","حادي ومُستَطْرَفَةِ السائر",18,"ر",1,0],["مُلهَبةٌ سوقُ الوفاءِ عنده","لا يُخمِدُ الجفاءُ من نيرانِها",19,"ن",3,0],["مِلَّةٌ في الوفاء ضيَّعها النا","سُ وأحييتَها سَناءً وفخرا",20,"ر",2,0],["مُلهٍ أَتانا وَوَقتُنا حَسَنٌ","فَعادَ مَن حَسَّ عودِهِ سَمِجا",21,"ج",2,0],["مله اكتسبت حياة قلبي والذكا","وله سعيت ولست عنه أغيب",22,"ب",1,0],["ملة للموحدين نهار","وعلى المشركين ليل طويل",23,"ل",1,0],["مِلَّةٌ أحدَثَها أَهلُ الهَوى","أصبَحَت في تابِعيهِم مِلَلا",24,"ل",2,0],["مُلْهَبٌ حسهُ كحسِّ حريقٍ","وسط غابٍ وذاك منه حضارُ",25,"ر",1,0],["ملهىً غُصون الماءِ فَوقَ غُصونِهِ","كَالنَخلِ فَوقَ مَسارِحِ الغُزلانِ",26,"ن",1,0],["ملهمَ النفسَ بالتقَى خيرَ مسرى","لمفازاتِ نورِكَ الرَّباني",27,"ن",2,0],["ملهمُ النفسِ والتدابيرُ تجرى","محكماتٍ في عالم الأكوانِ",27,"ن",1,0],["ملهماتٌ قد حُيَّرَ العقلُ فيها","أكسبت فَهمَهُ قُوَى العِرفانِ",27,"ن",1,0],["مُلهَجٌ بِالنَدى تَراهُ يَرى السا","ئِلَ مِن حُبِّهِ لَهُ في مَنامِه",28,"م",2,0],["ملة من ملة ساخرة","وأناس من أناس يسخرون",29,"ن",1,0],["ملة مثل ملة بعد أخرى","مأتم شامل ودمع يسيل",30,"ل",1,0],["ملَّهُ خَصْمُهُ الألدُّ عِراكاً","فأبى أن يملَّ قَتْلَ الخصومِ",31,"م",1,0],["ملهد ويد الاعسار تصفعني","ناء عن الاهل صفر اليد منفرد",32,"د",1,0],["ملهمٌ بالبيان سحراً وبالحك","مة نورا يشعّ بالإيمان",33,"ن",1,0],["ملهى صباي ومهد ميلادي","وعسى يكون بحضنه قبري",34,"ي",1,0],["ملَّه صَحبه الكِرام فَصَدّوا","أَقتل الصدّ ما يَكون ملالا",35,"ل",2,0],["مِلَّةُ الرُومِ التي قد رَكِبَت","فَرَسَ الغَيِّ لأَن فيها كَبَت",36,"ت",1,0],["ملهَمٌ يبتدعُ الحسنَ ومن","يلْهَم الإبداع أعلى الفنَّ شانا",37,"ن",2,0],["ملهوف ابيك وجمّرت بي مدينه","وعيونك بنظرآت شوقك تبآطن",38,"ن",1,0],["ملهم قصيد وكل ماجيت الأطلال","تنزف جروح الشعر زينه وشينه",39,"ن",2,0],["ملهوش مكان بيننا","فيه ألف غيره ينوب",40,"ب",1,0],["ملهمة شاعر .... يغنيها الشعور.","في ليال ٍ فلّت الذكرى الشريط.",41,"ط",1,1],["ملهي ومدهي ايا ويحي واش نهو لي لهاني","غفلات صابوني عماوني وكم من بلية",42,"ي",2,0],["(....) , مُلهمتي , يا ليتني قمراً","قد ذاب وجداً وأضوى وانطفا غزلا",43,"ل",2,0],["ملهِباتٌ كأنهنَّ جِمارٌ","ولنا العرضُ بكرةً وأصيلا",44,"ل",2,0],["مُلهِمَةَ الشعرِ التي حولَها","غرستُ أشواقي أفانينا",45,"ن",2,0]]}