{"poems":[[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[51,"يا ابن حسان لا تشكن في دينى","https://www.aldiwan.net/poem66483.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[105,"يا ابن عوف سر حثيثا باللواء","https://www.aldiwan.net/poem43583.html","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42654","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[94,"دمعة على الشاعر عبد الحميد الرافعي","https://www.poetsgate.com/ViewPoem.aspx?id=13792",""],[94,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[186,"لي صديق صدقاته نفر السب","https://www.aldiwan.net/poem43565.html","الخفيف"],[254,"لا تلمني","https://www.aldiwan.net/poem24962.html","مجزوء الرمل"],[261,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[328,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[328,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[328,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[328,"كيف ينسى غرامه","https://www.aldiwan.net/poem55068.html","مجزوء الخفيف"],[362,"حب جديد","https://www.aldiwan.net/poem11635.html","عموديه"],[391,"أحمد السقاف أبشر لا نخاف","https://www.aldiwan.net/poem54552.html","عموديه"],[416,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[432,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[458,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[468,"غنى فأبكى بصوته الفرنجا","https://www.aldiwan.net/poem60320.html","المنسرح"],[479,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[558,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"]],"verses":[["مُلهَماتٍ مِن دِقَّةِ الصُنعِ مالا","يُلهَمُ الشِعرُ مِن دَقيقِ المَعاني",0,"ن",2,0],["مِلَّةٌ رِشْدةٌ أَراني هُداها","بصرٌ ثاقب وعقلٌ متين",1,"ن",1,0],["ملها بعد ان قضى","الشيخ من جسمها الوطر",2,"ر",1,0],["مِلَّةٌ فُضْلَى وبَعلٌ صالحٌ","حَبَّذَا القَسمُ وما أسنَى العَطَاءْ",3,"ا",2,0],["مَلْهَى أَخِي طَرَبٍ وَمَلْعَبُ صَبْوَةٍ","وَثَرَى بُلَهْنِيَةٍ وَدَارُ أُنَاسِ",4,"س",1,0],["مُلْهِباً عَزْمَه إِذا اجتازَ غَوْراً","مُسْتَحِثّاً إِذا تسلَّقَ نَجْدا",5,"د",2,0],["ملهم الشعر من هوى كلّ نفس","ولبنات كلّ قلب عميد :",6,"د",1,0],["ملهم حاضر البديهة تغريه","بأحلى ممّا اصطفى وأعدّا",7,"د",2,0],["ملهمٌ باليهود والسبت عن ذك","ر ليالي التغريب والتشريق",8,"ق",1,0],["ملهِمٌ في الأرضِ نورٌ","كوكبٌ ما في علاهُ",9,"ا",2,0],["مله العائدون مني وما","اعضل داءً تملّه عواده",10,"د",2,0],["ملهمى يوم لأرجاء رجائي","حين أعطى كما يشاء كتابي",11,"ب",2,0],["ملهماً أستبيح مالا يبيح النا","س في عالم قليل المتاع",12,"ع",1,0],["ملهم بالفجور أفكاره الإثم","وليل الساقي ويوم الخلي",13,"ي",1,0],["ملهَمٌ من ملاكه","بدّد الشكّ باليقين",14,"ن",1,0],["مَلهوفَة ً تستفسِرُ:","أتحبُّني يا أسمرُ؟",15,"ر",1,0],["ملة ما مثلها في حسنها","كل من يمشي عليها لا يخاف",16,"ف",1,0],["ملة فيها السلامة والهنا","غيرها فيها البلايا والحراف",16,"ف",1,0],["ملهمٌ يعلم ما يأتي من الأَ","مرِ إنْ شاءَ وبعض النَّاس ملهم",17,"م",1,0],["مُلْهيةُ الداعي وحنانة ال","حادي ومُستَطْرَفَةِ السائر",18,"ر",1,0],["مُلهَبةٌ سوقُ الوفاءِ عنده","لا يُخمِدُ الجفاءُ من نيرانِها",19,"ن",3,0],["مِلَّةٌ في الوفاء ضيَّعها النا","سُ وأحييتَها سَناءً وفخرا",20,"ر",2,0],["مُلهٍ أَتانا وَوَقتُنا حَسَنٌ","فَعادَ مَن حَسَّ عودِهِ سَمِجا",21,"ج",2,0],["مله اكتسبت حياة قلبي والذكا","وله سعيت ولست عنه أغيب",22,"ب",1,0],["ملة للموحدين نهار","وعلى المشركين ليل طويل",23,"ل",1,0]]}