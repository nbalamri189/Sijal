{"poems":[[53,"بني عامر ما العز إلا لقادر","https://www.aldiwan.net/poem29773.html","الطويل"],[63,"لحى الله من يرنو إلى أمد العلا","https://www.aldiwan.net/poem45865.html","الطويل"],[86,"سكن الظلام وبات قلبك يخفق","https://www.aldiwan.net/poem68942.html","الكامل"],[10,"يا عين جودي بالدموع الغزار","https://www.aldiwan.net/poem21090.html","السريع"],[93,"يا عائداً برعاية الرحمن","https://www.aldiwan.net/poem11169.html","الكامل"],[93,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[88,"لعمرك أن الحر لا يتقيد","https://www.aldiwan.net/poem45017.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[51,"لما استقل بك الطريق إلى العدا","https://www.aldiwan.net/poem65767.html","الكامل"],[51,"حذار عرامي أو نظار فإنما","https://www.aldiwan.net/poem65891.html","الطويل"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[45,"أجدك إن لمات الخيال","https://www.aldiwan.net/poem65568.html","الطويل"],[45,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[28,"كتبت وعجلت البرادة إنني","https://www.aldiwan.net/poem1291.html",""],[49,"إيها إليك أخي إيها","https://www.aldiwan.net/poem63196.html","مجزوء الكامل"],[80,"يد الدهر جارحة آسيه","https://www.aldiwan.net/poem31251.html","المتقارب"],[80,"نفى هم شيبي سرور الشباب","https://www.aldiwan.net/poem31576.html","المتقارب"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[87,"كتمت هواك حتى ليس يدري","https://www.aldiwan.net/poem8214.html","الوافر"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9902","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54714","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67327","الكامل"],[51,"لمّا استقلّ بك الطريقُ إلى العدا","https://www.poetsgate.com/ViewPoem.aspx?id=30021",""],[107,"ولي بالجانب الشرقي بدر","https://www.aldiwan.net/poem16566.html","الوافر"],[113,"عليك دهراً سلام الله يا عمر","https://www.aldiwan.net/poem41099.html","عموديه"],[113,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[113,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[122,"يا راهب الدير تبنا عن محبتهم","https://www.aldiwan.net/poem23769.html","البسيط"],[133,"بالبشر والتوفيق هل أمين","https://www.aldiwan.net/poem48882.html","الكامل"],[141,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[167,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[172,"فديتك ما أظهر","https://www.aldiwan.net/poem46043.html","مجزوء المتقارب"],[180,"رمس ليمخائيل دهان الذي","https://www.aldiwan.net/poem61115.html","الكامل"],[180,"من آل دباس الكرام كريم","https://www.aldiwan.net/poem61156.html","الكامل"],[180,"رمس به من آل حجة راحل","https://www.aldiwan.net/poem61177.html","الكامل"],[180,"رمس ليوسف من بني الذكار قد","https://www.aldiwan.net/poem61191.html","الكامل"],[180,"ولى بشارة عن بني الحداد في","https://www.aldiwan.net/poem66986.html","الكامل"],[183,"عتبت الزمان عسى يعتب","https://www.aldiwan.net/poem14122.html","المتقارب"],[268,"نظرت إلى ماوية أطلعت لبنى","https://www.aldiwan.net/poem35230.html","الطويل"],[273,"يا ريم قصر به أهيم","https://www.aldiwan.net/poem25522.html","مخلع البسيط"],[280,"كل سقام زال عن سنقر","https://www.aldiwan.net/poem32779.html","السريع"],[283,"طابت صفاتك مصطفى فتهللت","https://www.aldiwan.net/poem39412.html","الكامل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"ينهي إليك سلاما جارك الجنب","https://www.aldiwan.net/poem56608.html","البسيط"],[326,"لولا ولولا ولولا","https://www.aldiwan.net/poem54933.html","المجتث"],[347,"بي للورى فليطل العجب","https://www.aldiwan.net/poem15535.html","السريع"],[347,"سواي لميل الحب عنه يفاسخ","https://www.aldiwan.net/poem15565.html","الطويل"],[390,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[396,"اغبر آفاق السماء وكورت","https://www.aldiwan.net/poem4520.html","الكامل"],[413,"عفت أرسم من دار مي وأطلال","https://www.aldiwan.net/poem53921.html","الطويل"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[429,"ولي بالخيف من نعمان ظبي","https://www.aldiwan.net/poem12529.html","الوافر"],[429,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[429,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[434,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[434,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[451,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[451,"عيد الملايين ازدهت بجلاله","https://www.aldiwan.net/poem61285.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[459,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[459,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[462,"وحنين ولكن أين منك زرود","https://www.aldiwan.net/poem3625.html","عموديه"],[477,"بنورك يا مولاي لا زلت أهتدي","https://www.aldiwan.net/poem37046.html","الكامل"],[491,"خلف المدائح بعدك التأبين","https://www.aldiwan.net/poem67315.html","الكامل"],[498,"طراز سر له في سمك قبته","https://www.aldiwan.net/poem38081.html","البسيط"],[504,"طول اغتراب وبرح شوق","https://www.aldiwan.net/poem2393.html","مخلع البسيط"],[549,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[584,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[584,"الدمع هام والحشا هائم","https://www.aldiwan.net/poem17702.html","السريع"]],"verses":[["وَلي بَينَ أَخفافِ المَراسيلِ حاجَةٌ","سَتُصحِبُ وَالأَيّامُ بيضٌ نَواعِمُ",0,"م",1,0],["وَلِي بِرِباعٍ تُنْبِتُ الذُّلَّ رُبْصَةٌ","وَلَولا انْتِكاسُ الدَّهْرِ لَمْ أَتَرَبَّصِ",1,"ص",1,0],["وَليَبقَ ذُخراً لِلبِلادِ وَأَهلِها","يَعفو وَيَرحَمُ مَن يَشاءُ وَيُعتِقُ",2,"ق",1,0],["وَليَبكِهِ كُلُّ أَخي كُربَةٍ","ضاقَت عَلَيهِ ساحَةُ المُستَجار",3,"ر",1,0],["وَليُبْلِغُوا شُكْرَ الحِمَى ذَاكَ الَّذِي","أَعْلَى مَكَانَتَهُ إِلَى كِيوَانِ",4,"ن",1,0],["وَلُيُبْلَّغْ مُنَاهُ كُلُّ مَلِيكٍ","وَرَئِيسِ مُحَالِفٍ وَمُوَالِي",5,"ي",1,0],["ولي بين شِدْقَيَّ في الهَرِيتين صارم","بُسَلّ على الأيام طوراً ويُغْمَد",6,"د",1,0],["وَلي بأبي عيسى إليه وسِيلَةٌ","يُفَكُّ بها أصفادُ عانٍ ويُصْفَدُ",7,"د",1,0],["وليبكها راهب كانت شفيعتهُ","أمسى يحاذر ذنباً غير مغفور",8,"ر",1,0],["وليبكها لخلال لا كِفاء لها","أجملن من كل خير كل تفسير",8,"ر",1,0],["وَلْيُبْقِ أن أبْقى على حَوْبائهِ","وعلى بقيَّةِ سترِه أن تُهْتَكا",9,"ك",2,0],["ولي بعد إعطائي الوثيقةَ حقَّها","بدائِهُ لا يخذُلنَني حينَ أعجلُ",10,"ل",1,0],["وليُبقِ جودك من جَدواك باقيةً","لخادم لك محقوقٍ بإخدامِ",11,"م",1,0],["وَلي بَينَ الضُلوعِ دَمٌ وَلَحمٌ","هُما الواهي الَّذي ثَكِلَ الشَبابا",12,"ب",2,0],["وَلي بِكَ حُرمَةٌ دَرَجَت عَلَيها","صُروفُ البُعدِ وَالحِجَجُ الخَوالي",13,"ي",1,0],["وَلي بَينَ القُصورِ إِلى قُوَيقٍ","أَليفٌ أَصطَفيهِ وَيَصطَفيني",14,"ن",2,0],["وَلي بِبِلادِ الهِندِ عِندَ أَميرِها","حَوائِجُ جَمّاتٌ وَعِندي ثَوابُها",15,"ب",3,0],["وَلَيَبعُدَنَّ مِنَ الحَلي","مِ الحِلمُ إِن مارى السَفيها",16,"ي",3,0],["ولي بالوقوفِ على جمرها","وإنْضاجه قَدَمٌ حافيَه",17,"ي",2,0],["ولي بينها مهجةٌ صَبّةٌ","تزودتُ في الجسم منها ذماءَ",18,"ا",2,0],["وَلّى بِها المَخذولُ يَعذِلُ نَفسَهُ","مُتَمَطِّراً في جَيشِهِ المَهزومِ",19,"م",1,0],["وَلي بَدَنٌ يَأوي إِذا الحُبُّ ضافَهُ","إِلى كَبِدٍ حَرّى وَقَلبٍ مُعَذَّبِ",20,"ب",1,0],["وَلِي بِحُبِّ رَسُولِ اللَّهِ مَنزِلَةٌ","أَرجُو بِها الصَّفحَ يَومَ الدِّينِ عَن جُرُمِي",21,"م",2,0],["وَلِي بَيْنَ الْجَوَانِحِ مِنْكِ سِرٌّ","خَفِيٌّ لا يَعِيهِ الْكَاتِبَانِ",22,"ن",1,0],["وليَبْلُغَنَّ جِيادُ خيلِكَ حيْثُ لم","يَبْلُغْ صَباحٌ مُسْفِرٌ وأصِيل",23,"ل",1,0],["وَلي بين أَحناء الضلوع لفقده","فؤاد بفورات الهموم مروَّع",24,"ع",1,0],["وليبتلعهُ الموجُ في جوفهِ","فلا مفرَّ اليوم مما أصابْ",25,"ب",1,0],["ولى بسر العبقرية شاعر","اللّه هيأه لنا وأتاحا",26,"ح",2,0],["وَلي بَيتٌ عَلا فَلَكَ الثُرَيّا","تَخِرُّ لِعُظمِ هَيبَتِهِ البُيوتُ",27,"ت",1,0],["وَلي بَأسُ مَفتولِ الذِراعَينِ خادِرٍ","يُدافِعُ عَن أَشبالِهِ وَيُحامي",28,"ي",1,0],["وَلْيُبْقِهِ لِلهائِمِينَ فِي دُجَى","هَذِي الحَيَاةِ هَادِيَ السبِيلِ",29,"ل",1,0],["وَليُبْشِرِ العَرَبُ الكِرَا","مَ مَضَى الخِلاَفُ وَكَانَ إِدَا",30,"د",2,0],["وليبْكِهِ عِنْدَ الحِفاظِ لِمُعْظِمٍ","والخيلُ بَيْنَ مَقانبٍ وصُفُوفِ",31,"ف",1,0],["وَلْيُبْقِ أن أبْقى على حَوْبائهِ","وعلى بقيَّة ِ شِلوه أن تُهْتَكا",32,"ك",2,0],["وَلي بِالجانب الشَرقيّ بَدرٌ","مِن الأَتراك مَغربهُ القُلوب",33,"ب",1,1],["ولي بجاهك آمال موطدة","وحسن ظن بماء الخير ينفجر",34,"ر",1,0],["ولي بعد من بعد الاحباء وارد","قريب بمحو الرأي والعزم يصدر",35,"ر",1,0],["ولي بطريق الله شيخان بعده","هما درتا سلك الفخار بلا نكر",36,"ر",1,0],["وليبك وادي الشتا بعدي جآذره","وليبك حسبون بعدي ماء حسبان",37,"ن",1,0],["وليْبتسم ثغر الزمان بيمنه","وليتّسم بالأمن هذا الحينُ",38,"ن",1,0],["وَليَبتَغَوا نَفَقاً سِوى هَذا فَقَد","وَقَفَ البَرِيَّةُ دونَ فَصمِ عُراكا",39,"ك",2,0],["وَلِي بِفَصاحَةِ الأَلفاظِ قُسٌّ","يُقِرُّ وَدَغفَلٌ وَالأَعشَيانِ",40,"ن",1,0],["وَلِي بَدَنٌ ناحِلٌ","عَلَى الْهَجْرِ لا يَصْبِرُ",41,"ر",1,0],["وَلَّى بسنِّ ثلاثَ عَشرةَ تارِكاً","حُزناً يَزولُ الدَهرُ قَبلَ زَوالِهِ",42,"ل",2,0],["وَلَّى بَلا ثَمرٍ وَأَبقى عِندَنا","ذِكراً لَهُ بِالصالِحاتِ يَدومُ",43,"م",1,0],["وَلَّى بِلا ثَمَرٍ فَلَم يُترَك سِوى","دَمعَ الحَزينِ وَحَسرَةَ المُتلَهِّفِ",44,"ف",1,0],["وَلَّى بلا ثَمرٍ وَغادرَ بِعدَهُ","مُهَجاً تَذوبُ وَأَدمُعاً تُستَنزَفُ",45,"ف",1,0],["وَلى بشارةُ عَن بَني الحدَّادِ في","شَرخِ الشَبيبةِ مَثلَما حَكمَ القَضا",46,"ض",2,1],["ولى بالكنيسةِ لا بالكِناسِ","رَشاً هابَه الضَّيْغَمُ الأَغْلَب",47,"ب",1,0],["وَلي بعد حُسنِ الجسمِ حسنُ خيالِها","وفي قُربها والبُعدِ أشهدُها مَثنى",48,"ن",2,0],["وَلي بحُكْمِ الهَوى نَسِيبٌ","كَأَنَّهُ رِقَّة نَسِيمُ",49,"م",1,0],["وَلّى بَهارٌ كانَ في خَدِّهِ","منهَزِماً مِن وَردِهِ الأَحمَرِ",50,"ر",1,0],["وليبتهج بسمو عباس فقد","أرضى النفوس بذا الحنان الوابل",51,"ل",1,0],["وَلي بها خَليلُ","إِحسانُه جَليلُ",52,"ل",1,0],["وَلي بتونسَ حاجات تجشِّمني","لَها الركوبَ على ما ليس يرتكبُ",53,"ب",1,0],["ولى بنجواه وجد","والهجر يعقب وصلا",54,"ل",2,0],["وَلي بِهِ نَجمٌ وَبَدرٌ في","هِ الشَمسُ لا يَستُرُها الحَجبُ",55,"ب",1,0],["وَلي بَرزَخٌ ما بَينَ بَحرَي صَبابَتي","وَدونَهُما لِلعاشِقينَ بَرازِخُ",56,"خ",1,0],["وَلي بِذِكرِ حُنَينٍ","تَفَرُّحٌ لَيسَ يُكري",57,"ر",2,0],["وَلَيبكهِ الطور المعظّمُ جوّهُ","وَالبيتُ ذو الأستارِ والأركانِ",58,"ن",1,0],["ولي بعليّ القَدْر عن غيره غنًى","إذا عُدَّ قول للكرام وأفعال",59,"ل",1,0],["ولي بأحوال الزمان عبرة","كفى الزمان عبرة لذي النهى",60,"ا",1,0],["ولي بالخَيفِ من نَعمانَ ظبيٌ","يحيفُ على فؤادي أيّ حَيْفِ",61,"ف",1,1],["وليَبْقَ في المجدِ مقيماً فلي","جوّالُ مدحٍ منكَ سيّارُ",62,"ر",1,0],["وليبْقَ في ظلّ السعادةِ بالغاً","مما يُحبُّ نهايةَ الآمالِ",63,"ل",1,0],["ولي بين أكناف الحمى ومحجّرٍ","غزال متى ما شاء عافى وأمرضا",64,"ض",2,0],["ولي بأحاديث الرسول رواية","تقصّرُ عنها في العلوّ العمائمُ",65,"م",1,0],["وليباه الجناة لست حقودا","فأجاري ولا أثيما فأجني",66,"ي",1,0],["وليبق مولدك الأغر منارة","لمجاهد مستقتل بقتاله",67,"ل",2,0],["ولَّى بها شنعاء تَذهبُ نفسُهُ","فيها ويَبقَى لومُها والعارُ",68,"ر",1,0],["ولي بَعْدُ فيكم ذَروةٌ ستنالُها","يدي ومُنىً في قولها ستُصيبُ",69,"ب",1,0],["ولي بأس مشبوح الذراعين مغضب","يصاول عن أشباله ويُحامي",70,"م",2,0],["وليبكه اليوم العصيب من الوغى","ينزو بكل كتيبة حمساء",71,"ا",2,0],["وليبكهِ رأدُ الصباحِ أعادهُ","بطرادهِ كالليلةِ اللَّيْلاءِ",71,"ا",2,0],["وليبكهِ اللُّطْفُ الذي لم تؤتَهُ","خَمْرٌ ولم يُرْزَقْهُ صَفوُ الماءِ",71,"ا",2,0],["ولي بالحمى قلبٌ بعيدٌ إيابهُ","أسائل عنه الحيَّ وهو فقيد",72,"د",1,0],["ولي بك أمسى الذكر كاسمك طيبا","فلله يا بوشناق عندك من يد",73,"د",1,0],["وَلى بِسَيفِ الدَولَةِ العِزُّ الَّذي","كانَت عَلَيهِ مِنَ الخُطوبِ تَهونُ",74,"ن",1,0],["ولي به أملٌ لا زالَ مُتَّصلاً","كما اتَّصلتْ به والموصِلُ النَّسَبُ",75,"ب",1,0],["ولي بِغرناطةٍ حَبيب","قد غَلّقَ الرَّهنَ في يَدَيهش",76,"ي",3,0],["ولْيَبكِهِ الرّمحُ الأصمُّ تعطّلَتْ","حركاتُهُ والباترُ الصُّمْصامُ",77,"م",1,0],["ولْيَبن ما عقدتُماه من الصب","رِ بأَن تَحْلُلا وِكَاءَ البُكَاءِ",78,"ا",2,0],["وَلِي بِابْنِ عَبْدِ الظَّاهِرِ الهِمَّةُ الَّتي","أَجَادَ بِهَا جَدِّي وأَعْلى بِهَا قَدْرِي",79,"ر",2,0],["وَلي بِجَرْعَاءِ الحِمَى شَادِنٌ","بِقَتْلِ أَرْبابِ الهَوى عَالمُ",80,"م",1,0]]}