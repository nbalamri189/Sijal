5,"شاطِئُ الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=184069",""],[4755,"قد وَهَبناكَ فَوقَ ما تَستَطِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184812",""],[4755,"أَنا مُنهَكٌ أَيُّها المُنهَكُونا","https://www.poetsgate.com/ViewPoem.aspx?id=192452",""],[4830,"مجرى دمي","https://www.poetsgate.com/ViewPoem.aspx?id=202615",""],[4578,"عُرب اللوى عن عهود الود قد حالوا","https://www.poetsgate.com/ViewPoem.aspx?id=49505",""],[4578,"راع القلوب مصابٌ جاء بالعجب","https://www.poetsgate.com/ViewPoem.aspx?id=49352",""],[4925,"ما بين بابَيْ عينِ سَعْنةَ واليَمنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176643",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[4929,"لا تحسبِ الشعرَ نظماً أنت كاتبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203667",""],[4929,"سجال البوابة","https://www.poetsgate.com/ViewPoem.aspx?id=211691",""],[5031,"شدوُ البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=165139",""],[5032,"أرجوحة الحُلم","https://www.poetsgate.com/ViewPoem.aspx?id=188909",""],[5151,"أغويتُ كاهنها والحبرَ والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=184851",""],[5183,"ذكرى الأخوة","https://www.poetsgate.com/ViewPoem.aspx?id=180230",""],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""],[5232,"ناسِكُ الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=213020",""],[5277,"لا حدَّ للحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200206",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[5358,"ساعات تحت النار","https://www.poetsgate.com/ViewPoem.aspx?id=21892",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5411,"وَرْدَةٌ حمراءُ","https://www.poetsgate.com/ViewPoem.aspx?id=215793",""],[5535,"يا ريس الحب أدركني فقد وحلت","https://www.poetsgate.com/ViewPoem.aspx?id=201502",""],[482,"لكم مِن فؤادي شاهدٌ ليس يكذبُ","https://www.poetsgate.com/ViewPoem.aspx?id=111424",""],[5616,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=205249",""],[5621,"صهوة","https://www.poetsgate.com/ViewPoem.aspx?id=24565",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5697,"لحن الصباحات","https://www.poetsgate.com/ViewPoem.aspx?id=178328",""],[402,"آلاء فاروق المفدى","https://www.poetsgate.com/ViewPoem.aspx?id=35465",""],[5790,"لا غرو أن حجب الأمي","https://www.poetsgate.com/ViewPoem.aspx?id=111901",""],[5809,"سلوا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205565",""],[5809,"صحبة","https://www.poetsgate.com/ViewPoem.aspx?id=205572",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5956,"شِباكُ الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=183742",""],[5956,"أواصلُ الانجذاب إلى حياتي الجديدة بمدريد","https://www.poetsgate.com/ViewPoem.aspx?id=192079",""],[6093,"يَسْتَحْسِنُ القُبْحَ مَنْ يَسْتَقْبِحُ الحَسَنَا(حرب بِرُسْغٍ)","https://www.poetsgate.com/ViewPoem.aspx?id=205621",""],[6102,"تقولين خذني","https://www.poetsgate.com/ViewPoem.aspx?id=183319",""],[6124,"الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=159314",""],[6124,"خناس","https://www.poetsgate.com/ViewPoem.aspx?id=201249",""],[1583,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73011&r=&rc=2",""],[4222,"قد صح أن صلاح الدين في الكسوه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52913&r=&rc=205",""]],"verses":[["وَلي بَينَ أَخفافِ المَراسيلِ حاجَةٌ","سَتُصحِبُ وَالأَيّامُ بيضٌ نَواعِمُ",0,"م",1,0],["وَلِي بِرِباعٍ تُنْبِتُ الذُّلَّ رُبْصَةٌ","وَلَولا انْتِكاسُ الدَّهْرِ لَمْ أَتَرَبَّصِ",1,"ص",1,0],["وَليَبقَ ذُخراً لِلبِلادِ وَأَهلِها","يَعفو وَيَرحَمُ مَن يَشاءُ وَيُعتِقُ",2,"ق",1,0],["وَليَبكِهِ كُلُّ أَخي كُربَةٍ","ضاقَت عَلَيهِ ساحَةُ المُستَجار",3,"ر",1,0],["وَليُبْلِغُوا شُكْرَ الحِمَى ذَاكَ الَّذِي","أَعْلَى مَكَانَتَهُ إِلَى كِيوَانِ",4,"ن",1,0],["وَلُيُبْلَّغْ مُنَاهُ كُلُّ مَلِيكٍ","وَرَئِيسِ مُحَالِفٍ وَمُوَالِي",5,"ل",2,0],["ولي بين شِدْقَيَّ في الهَرِيتين صارم","بُسَلّ على الأيام طوراً ويُغْمَد",6,"د",1,0],["وَلي بأبي عيسى إليه وسِيلَةٌ","يُفَكُّ بها أصفادُ عانٍ ويُصْفَدُ",7,"د",1,0],["وليبكها راهب كانت شفيعتهُ","أمسى يحاذر ذنباً غير مغفور",8,"ر",1,0],["وليبكها لخلال لا كِفاء لها","أجملن من كل خير كل تفسير",8,"ر",1,0],["وَلْيُبْقِ أن أبْقى على حَوْبائهِ","وعلى بقيَّةِ سترِه أن تُهْتَكا",9,"ك",2,0],["ولي بعد إعطائي الوثيقةَ حقَّها","بدائِهُ لا يخذُلنَني حينَ أعجلُ",10,"ل",1,0],["وليُبقِ جودك من جَدواك باقيةً","لخادم لك محقوقٍ بإخدامِ",11,"م",1,0],["وَلي بَينَ الضُلوعِ دَمٌ وَلَحمٌ","هُما الواهي الَّذي ثَكِلَ الشَبابا",12,"ب",2,0],["وَلي بِكَ حُرمَةٌ دَرَجَت عَلَيها","صُروفُ البُعدِ وَالحِجَجُ الخَوالي",13,"ل",2,0],["وَلي بَينَ القُصورِ إِلى قُوَيقٍ","أَليفٌ أَصطَفيهِ وَيَصطَفيني",14,"ن",2,0],["وَلي بِبِلادِ الهِندِ عِندَ أَميرِها","حَوائِجُ جَمّاتٌ وَعِندي ثَوابُها",15,"ب",3,0],["وَلَيَبعُدَنَّ مِنَ الحَلي","مِ الحِلمُ إِن مارى السَفيها",16,"ي",3,0],["ولي بالوقوفِ على جمرها","وإنْضاجه قَدَمٌ حافيَه",17,"ي",2,0],["ولي بينها مهجةٌ صَبّةٌ","تزودتُ في الجسم منها ذماءَ",18,"ا",2,0],["وَلّى بِها المَخذولُ يَعذِلُ نَفسَهُ","مُتَمَطِّراً في جَيشِهِ المَهزومِ",19,"م",1,0],["وَلي بَدَنٌ يَأوي إِذا الحُبُّ ضافَهُ","إِلى كَبِدٍ حَرّى وَقَلبٍ مُعَذَّبِ",20,"ب",1,0],["وَلِي بِحُبِّ رَسُولِ اللَّهِ مَنزِلَةٌ","أَرجُو بِها الصَّفحَ يَومَ الدِّينِ عَن جُرُمِي",21,"م",2,0],["وَلِي بَيْنَ الْجَوَانِحِ مِنْكِ سِرٌّ","خَفِيٌّ لا يَعِيهِ الْكَاتِبَانِ",22,"ن",1,0],["وليَبْلُغَنَّ جِيادُ خيلِكَ حيْثُ لم","يَبْلُغْ صَباحٌ مُسْفِرٌ وأصِيل",23,"ل",1,0],["وَلي بين أَحناء الضلوع لفقده","فؤاد بفورات الهموم مروَّع",24,"ع",1,0],["وليبتلعهُ الموجُ في جوفهِ","فلا مفرَّ اليوم مما أصابْ",25,"ب",1,0],["ولى بسر العبقرية شاعر","اللّه هيأه لنا وأتاحا",26,"ح",2,0],["وَلي بَيتٌ عَلا فَلَكَ الثُرَيّا","تَخِرُّ لِعُظمِ هَيبَتِهِ البُيوتُ",27,"ت",1,0],["وَلي بَأسُ مَفتولِ الذِراعَينِ خادِرٍ","يُدافِعُ عَن أَشبالِهِ وَيُحامي",28,"م",2,0],["وَلْيُبْقِهِ لِلهائِمِينَ فِي دُجَى","هَذِي الحَيَاةِ هَادِيَ السبِيلِ",29,"ل",1,0],["وَليُبْشِرِ العَرَبُ الكِرَا","مَ مَضَى الخِلاَفُ وَكَانَ إِدَا",30,"د",2,0],["وليبْكِهِ عِنْدَ الحِفاظِ لِمُعْظِمٍ","والخيلُ بَيْنَ مَقانبٍ وصُفُوفِ",31,"ف",1,0],["وَلْيُبْقِ أن أبْقى على حَوْبائهِ","وعلى بقيَّة ِ شِلوه أن تُهْتَكا",32,"ك",2,0],["وَلي بِالجانب الشَرقيّ بَدرٌ","مِن الأَتراك مَغربهُ القُلوب",33,"ب",1,1],["ولي بجاهك آمال موطدة","وحسن ظن بماء الخير ينفجر",34,"ر",1,0],["ولي بعد من بعد الاحباء وارد","قريب بمحو الرأي والعزم يصدر",35,"ر",1,0],["ولي بطريق الله شيخان بعده","هما درتا سلك الفخار بلا نكر",36,"ر",1,0],["وليبك وادي الشتا بعدي جآذره","وليبك حسبون بعدي ماء حسبان",37,"ن",1,0],["وليْبتسم ثغر الزمان بيمنه","وليتّسم بالأمن هذا الحينُ",38,"ن",1,0],["وَليَبتَغَوا نَفَقاً سِوى هَذا فَقَد","وَقَفَ البَرِيَّةُ دونَ فَصمِ عُراكا",39,"ك",2,0],["وَلِي بِفَصاحَةِ الأَلفاظِ قُسٌّ","يُقِرُّ وَدَغفَلٌ وَالأَعشَيانِ",40,"ن",1,0],["وَلِي بَدَنٌ ناحِلٌ","عَلَى الْهَجْرِ لا يَصْبِرُ",41,"ر",1,0],["وَلَّى بسنِّ ثلاثَ عَشرةَ تارِكاً","حُزناً يَزولُ الدَهرُ قَبلَ زَوالِهِ",42,"ل",2,0],["وَلَّى بَلا ثَمرٍ وَأَبقى عِندَنا","ذِكراً لَهُ بِالصالِحاتِ يَدومُ",43,"م",1,0],["وَلَّى بِلا ثَمَرٍ فَلَم يُترَك سِوى","دَمعَ الحَزينِ وَحَسرَةَ المُتلَهِّفِ",44,"ف",1,0],["وَلَّى بلا ثَمرٍ وَغادرَ بِعدَهُ","مُهَجاً تَذوبُ وَأَدمُعاً تُستَنزَفُ",45,"ف",1,0],["وَلى بشارةُ عَن بَني الحدَّادِ في","شَرخِ الشَبيبةِ مَثلَما حَكمَ القَضا",46,"ض",2,1],["ولى بالكنيسةِ لا بالكِناسِ","رَشاً هابَه الضَّيْغَمُ الأَغْلَب",47,"ب",1,0],["وَلي بعد حُسنِ الجسمِ حسنُ خيالِها","وفي قُربها والبُعدِ أشهدُها مَثنى",48,"ن",2,0],["وَلي بحُكْمِ الهَوى نَسِيبٌ","كَأَنَّهُ رِقَّة نَسِيمُ",49,"م",1,0],["وَلّى بَهارٌ كانَ في خَدِّهِ","منهَزِماً مِن وَردِهِ الأَحمَرِ",50,"ر",1,0],["وليبتهج بسمو عباس فقد","أرضى النفوس بذا الحنان الوابل",51,"ل",1,0],["وَلي بها خَليلُ","