etry.dctabudhabi.ae/diwan/poem/120503","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204296","الكامل"],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[4778,"أنتم مع الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=191498",""],[4859,"إدلب","https://www.poetsgate.com/ViewPoem.aspx?id=208582",""],[4984,"الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=175826",""],[5032,"حال شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=191236",""],[5121,"خميلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33597",""],[5147,"يا حياة الأفراد مهما تعاليت","https://www.poetsgate.com/ViewPoem.aspx?id=166729",""],[5183,"قلن","https://www.poetsgate.com/ViewPoem.aspx?id=186480",""],[5183,"المصلى","https://www.poetsgate.com/ViewPoem.aspx?id=180159",""],[3294,"قد بت طول الليل ساهر","https://www.poetsgate.com/ViewPoem.aspx?id=173268",""],[5449,"عليل","https://www.poetsgate.com/ViewPoem.aspx?id=189265",""],[5460,"شرب النبيذ على الطعام ثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=200757",""],[5725,"واذا دعوتك","https://www.poetsgate.com/ViewPoem.aspx?id=211535",""],[5736,"يقين","https://www.poetsgate.com/ViewPoem.aspx?id=203823",""],[5781,"يا ليتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211101",""],[6152,"اعتراف","https://www.poetsgate.com/ViewPoem.aspx?id=202354",""],[6183,"طير شارد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79844&r=&rc=34",""],[6229,"ليلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65190&r=&rc=16",""]],"verses":[["فَإِذا شِئتَ أَن تُبَكّي لَيالي","هِ فَمِلأَنَ قُل لِعَينَيكَ جودا",0,"د",2,0],["فَإِذا شَرِبتُ فَإِنَّني مُستَهلِكٌ","مالي وَعِرضي وافِرٌ لَم يُكلَمِ",1,"م",1,0],["فإذا شغلت العقل فالْهُ سويعةً","فاللهو للعقل الطليح جمام",2,"م",1,0],["فإذا شئت بلوغ الأرَب","فأغترف من بحره وأرتشف",3,"ف",1,0],["فإذا شهدتُمْ مشهداً وأبُوكمُ","لم تُشبهوا يعقوبَ والأسباطا",4,"ط",2,0],["فإذا شئت أن تراه فأنجِدْ","في أعالي نظيرهِ ثَهْلان",5,"ن",1,0],["فَإِذا شَمَمتِ اليَومَ رائِحَةَ الدِماءِ","وَطالَعَت عَيناكِ آثارَ البِلى",6,"ل",2,0],["فَإِذا شاخَتِ الرُأى وَتَلاشَت","وَصَحا باتَ جَزمُهُ تَخمينا",7,"ن",2,0],["فَإِذا شاءَ فَالرِقابُ فِداهُ","وَيَسيرٌ إِذا أَرادَ الدِماءُ",8,"ا",2,0],["فإذا شَاءَ أَحْمَدُ بنُ عَلِيٍّ","ضَمَّ شَمْلاً لَهُ يَخافُ انْشِعَاثُهْ",9,"ه",1,0],["فَإِذا شِئتَ فَاِرفَعِ العيسَ يَنحَت","نَ بِحَرِّ الوَجيفِ نَحتَ القِداحِ",10,"ح",1,0],["فَإِذا شَكا جَورَ الحَوادِثِ جارُهُ","يُعدي النَزيلَ عَلا الزَمانِ وَيَعدِلُ",11,"ل",1,0],["فَإِذا شَكَوتُ يُقالُ لَم يَذهَب لَهُ","مالٌ وَلَكِن ظالِمٌ يَتَظَلَّمُ",12,"م",1,0],["فَإِذا شُخوصٌ كُنتُ أَعرِفُها","في المِسكِ وَالأَكباشِ وَالعَصبِ",13,"ب",1,0],["فإذا شِمْتَ بِشْرَهُ وَنَدَاهُ","أذْهَلَتْكَ الأنوارُ والأنواءُ",14,"ا",2,0],["فإذا شِمتَ أو شَمِمْتَ رُبَاها","لاحَ منها برقٌ وفاحَ كِباءُ",14,"ا",2,0],["فإذا شاء للعباد نشوراً","فمن السهل أن يكون نشورُ",15,"ر",1,0],["فإذا شبت الملوك لظاها","أَكلتهم لَمَّاً مع الأجناد",16,"د",1,0],["فَإِذَا شَمِمْتَ وَجَدْتَ أَطْيَبَ نَفْحَةٍ","وَإِذَا الْتَفَتَّ رَأَيْتَ أَحْسَنَ مَا يُرَى",17,"ا",1,0],["فَإِذَا شَبَّتِ الْحَمَاسَةُ فِيه","فَلْيَكُنْ شَوْطُهُ مَجَالَ الجِهَاد",18,"د",1,0],["فَإِذَا شِعَابُ النّهْرِ تَذْهَبُ بِابْنِهَا","فِي فَجْوَةِ الَوادِي ضُرُوبَ مَذَاهِبِ",19,"ب",1,0],["فإِذا شئتَ أن تَرَى الأرضَ أرْضاً","كنْتَ ممن يُحاولُ الأمْرَ إِدّا",20,"د",2,0],["فإذا شئتَ أن أكونَ زُهَيْراً","فأَعِنِّي وهاتِ لي ابنَ سِنانا",21,"ن",2,0],["فإذا شم أتفُهُ ريحَ ضيم","كان كالصخر جفْوةً وخشونة",22,"ن",2,0],["فإذا شكا واديك، كنتَ ملاذَه","وإذا بكى، كفكفت من عَبَراته",23,"ت",2,0],["فإذا شِئْتُم مَشَيْناها ونىً","وإذا شئتم مشيناها عِجالا",24,"ل",2,0],["فإذا شِئْتَ، فادفَعِ العِيسَ يُنْحَتْ","نَ بحَرّ الوَجيفِ، نَحتَ القِداحِ",25,"ح",1,0],["فإذا شاخت الرؤى وتلاشت","وصحا بات جزمه تخمينا",26,"ن",2,0],["فإذا شبتْ خُلودا دائماً","وترَى الخيراتِ في أعْلَى مَحَلّْ",27,"ل",1,0],["فَإِذا شِبهُكِ ما نُنكِرُهُ","حينَ أَزجى طَرفَهُ ثُمَّ لَمَح",28,"ح",1,0],["فَإِذا شَكا فَقراً بَذَلتَ لَهُ الغِنى","وَإِذا جَنى خَطَأً صَفَحتَ تَعَمُّدا",29,"د",2,0],["فإذا شققت عيون أرضك صنتها","من جل منتها وزال العار",30,"ر",1,0],["فإذا شربناها على همس الصبا","هتف السرور وصفّق القلبان",31,"ن",1,0],["فإذا شاءَ أنزلَ البدرَ قسراً","وإذا شاءَ كانَ عندَ البدورِ",32,"ر",1,0],["فإذا شاء فالحياة اضطراب","وإذا شاء فالحياة أمان",33,"ن",1,0],["فإذا شقوة يليها هناء","وإذا ظلمة يليها ضياء",34,"ا",2,0],["فإِذا شِئْت فالمَجَرَّةُ نَهْرٌ","لي فيه بنات نعش سُماري",35,"ر",2,0],["فإذا شكوتُ فما بدارٍ رحمةٌ","وإذا دعوتُ فصامتٌ لا يسمع",36,"ع",1,0],["فإذا شئت ظلمه","فقلِ البدرُ ندّه",37,"د",2,0],["فَإِذا شَدَدتُ شَدَدتُ غَيرَ مُكَذِّبٍ","وَإِذا طَعَنتُ كَسَرتُ رُمحي أَو مَضى",38,"ا",1,0],["فإذا شئت كان حمزةُ فيها","وإذا شئت كان فيها الكسائي",39,"ا",2,0],["فإذا شِلوه طريحٌ عليه","لعنةُ اللهِ بين تلكَ الروابي",40,"ب",2,0],["فإذا شاء عدكم من موالي","ه وإن شاء عدكم أحرارا",41,"ر",2,0],["فَإِذا شَرِبتَ فَمِن رَحيقٍ سَلسَلٍ","وَإِذا رَشَفتَ فَمِن شَتيتٍ أَفلَجِ",42,"ج",1,0],["فإذا شبت وانحنى ظهر أيري","وانحناء الأيور خطب عظيم",43,"م",1,0],["فَإِذا شَرِبْتَ مَشُوبَها","لا تَسْقِني مِمَّا شَرِبْتا",44,"ت",2,0],["فإذا شكا وشكت اليك فلا تكن","من حزبه يوماً ولا من حزبها",45,"ب",3,0],["فَإِذا شَعبي وَشَعبُ حَبيبي","إِنَّما نَلتامُ بَعدَ اِنصِداعِ",46,"ع",1,0],["فإذا شهدت جماعة واعتادني","تذكاركم فاضت دموعي تسجم",47,"م",1,0],["فإذا شيتَ فشُؤْبُوبُ حياً","وإذا شيتَ فشؤبوبُ بَرَدْ",48,"د",1,0],["فإذا شاء أسفت في الثرى","وإذا شاء بها شق الغماما",49,"م",2,0],["فإذا شَدَوتِ صَرَفتِ عن ألمِ الهوى","قلباً أسيراً حائراً ولهانا",50,"ن",2,0],["فاذا شحّ فهو ذَوبُ لُجينٍ","واذا فاض فهو من عقيان",51,"ن",1,0],["فإذا شاهد العجائب فيه","لم يكن ذا إنابة في هواه",52,"ه",1,0],["فإذا شتت أمري قدرٌ","جاء منها ما إليها جمعه",53,"ع",2,0],["فإذا شَمَمْتَ المسك من إقباله","وَنَمَا سُرُورُكَ حين كشف لثامه",54,"م",2,0],["فَإِذا شِئتَ قُلتَ رَبَّةَ بَيتٍ","ذاتَ طِفلَينِ مِن خَيارِ النِساءِ",55,"ا",2,0],["فإذا شكوت إليه شكوى راحةٍ","ذكّرته فشكا إليّ بأكثر",56,"ر",1,0],["فإذا شمسه تبدت أصاب ال","قل