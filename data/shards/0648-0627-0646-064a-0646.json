{"poems":[[55,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[55,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[93,"تبدل قلبي من ضلالته رشدا","https://www.aldiwan.net/poem8815.html","عموديه"],[93,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[94,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[50,"تباعد ما استطعت من الشقوق","https://www.aldiwan.net/poem66603.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[92,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[93,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[128,"بالنفس يا شيخ من تقواك أشياء","https://www.aldiwan.net/poem23734.html","البسيط"],[128,"لقد كان لي قلب شفوق وأدته","https://www.aldiwan.net/poem23805.html","الطويل"],[190,"طال هذا الليل واستغشي","https://www.aldiwan.net/poem43969.html","مجزوء الرمل"],[201,"يا أخا الروح من يبل أوامي","https://www.aldiwan.net/poem39821.html","الخفيف"],[201,"عشق المجد والهوى فكرة تنمو","https://www.aldiwan.net/poem39874.html","الخفيف"],[233,"وساقية ترتمي بالحباب","https://www.aldiwan.net/poem51085.html","المتقارب"],[241,"وقرر ما تحويه منك الأضالع","https://www.aldiwan.net/poem19493.html","الطويل"],[309,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[395,"يا غياث المستغيثين أغث","https://www.aldiwan.net/poem54550.html","عموديه"],[407,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[407,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[409,"أرى الضر يقفو الحر في كل مقصد","https://www.aldiwan.net/poem49763.html","الطويل"],[420,"على أي وجد طويت الضلوعا","https://www.aldiwan.net/poem53848.html","المتقارب"],[420,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[443,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[461,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[461,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[464,"كأن عقارا خندريسا تضوعت","https://www.aldiwan.net/poem16114.html","الطويل"],[467,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[482,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[518,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[554,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"]],"verses":[["وَإِنّي نِعمَ دامِغُ كُلِّ قِرنٍ","يُرادي بِالعَداوَةِ أَو يُرامي",0,"م",2,0],["وَأَن يَنصَدِعَ الشَعبُ ال","لَذي لوئِمَ وَالشَملُ",1,"ل",1,0],["وَإِن يَنهَضِ الغَرسُ الَّذي هُوَ غارِسٌ","يَكُن لَكَ مَجنىً في الخُطوبِ وَمَعلَقا",2,"ق",2,0],["وأني نصحت وأني مدح","ت بالمنطق الرائق الرائع",3,"ع",1,0],["وَأَن يَنشُروا في كُلِّ أُفقٍ بُنودَهُم","وَأَن لا نَرى فَوقَ السِماكِ لَنا بَندا",4,"د",2,0],["وَأَنينُ مُحتَضِرٍ يَقولُ قَتَلتَني","ثَكَلَتكَ أُمُّكَ لَم أَنَل مَأمولا",5,"ل",2,0],["وأَنينٍ مِنْ مُعْدَمٍ ذي سَقامٍ","عضَّهُ الدَّهرُ بالخُطُوبِ الجِسامِ",6,"م",1,0],["وَأَنينٍ لَو أَنَّهُ مِن مَشوقٍ","عَرَفَ السامِعونَ مَوضِعَ نارِهِ",7,"ر",2,0],["وإن ينزل بكم خطبٌ تولَّوْا","يضجُّ عُواتُهم في الشّامتينا",8,"ن",2,0],["وإنّي ناصحٌ لكَ فاتّبعني","ودَعني من ثنيّات الطريق",9,"ق",1,0],["وأن يناط القطر والولايه","بمن له الصّهر أو الولايه",10,"ه",1,0],["وإنْ يَنَلْ بعضَهما إزالَهْ","عاقَبَه الآخرُ لا مَحالَهْ",11,"ه",1,0],["وأنيناً باحت النجوى به","عربيا رشفَتهُ مقلتانا",12,"ن",2,0],["وأنْ ينجابَ عنكَ غُبارُ بُؤسٍ","يَضيقُ به مُحيَّاك الأسيف",13,"ف",1,0],["وأنين مختضر يقول قتلتني","ثكلتك أمّك لم أنل مأمولا",14,"ل",2,0],["وأن ينير سبيل العلم إمعة","وأن تريك سوي النهج عجماء",15,"ا",2,0],["وإني نسيت اليوم أمسي فلم أعد","لتطراق طيف الشركسيات أطرب",16,"ب",1,0],["وأنيني طيّ قلبي","وهمومي وسهادي",17,"د",2,0],["وأنيني أما سمعت أنيني","دونه يا أخي أنين الحمام",18,"م",1,0],["وأنين الجرحى وحشرجة المو","تى هتافٌ لا عاش كلّ جبان",19,"ن",1,0],["وإني نهضت بمكسورِها","وآنست وحشة مهجورها",20,"ر",3,0],["وَأَنْ يَنْزَعَ الشَّحْنَاءَ مِنْ قَلْبِ عِرْسِكُمْ","فَتَطْلُعُ فِي أُفْقِ السُّرُورِ طَوَالِعُ",21,"ع",1,0],["وَأَن يُنيل رضاه من يؤازرهُ","حتّى يعزّ بِهِ الأنصار والحشمُ",22,"م",1,0],["وأنيناك من الباب الذي","منه يوصل كل عبد منه جاك",23,"ك",1,0],["وإني ناصح لك فاتبعني","فما أنا من شرابك والطعام",24,"م",1,0],["وأن ينحر السلوان في كل مقلة","ويجري دم السلوان في الوجنات",25,"ت",1,0],["وإن يَنْوِ يَوماً عِزَّةً فَهْيَ ذِلَّةٌ","وإنْ يَبغِ يَوماً مَغنَماً فَهْوَ مَغْرَمُ",26,"م",1,0],["وإنِّي نصحتُك من قبلها","وزِدْتُك لَوماً فَزِدْتَ ولوعا",27,"ع",2,0],["وإنِّي نظرتُ الناس نظرة عارفٍ","وأبصرتهم خَلقاً وخُلقاً وميسما",28,"م",2,0],["وأَنْ يَنْظُرُوا كَيْفَ ازْدَهى مَفْرِقُ العُلا","بعَقْدِي لَهُ تاجاً من الكَلِمِ العُلْيا",29,"ي",2,0],["وأن يُنزع الأمرُ من أهله","لأنّ عليّا له أُهِّلا",30,"ل",2,0],["وأن ينهضَ الجَدُّ العَثورُ بِهجرةٍ","تُعالَجُ أشواقي بها والتَّبارِحُ",31,"ح",1,0],["وأنْ ينقُضَ العهد الوكيد حفيظةً","لديهِ ولو أنَّ الذُّنوبَ زَلازِلُ",32,"ل",1,0],["وان ينل منها لغوب فلها","الأَسماع ورد والقلوب منزل",33,"ل",1,0],["وإني ناشر الإحساس فيهم","وحسبك عن أقل قالت حذام",34,"م",1,0],["وإن ينقذوني من تملك عبدهم","وخادمهم وهو الزمان ويعتقوا",35,"ق",3,0],["وأنْ يُنزلوك عن قَراها كأَنَّهمْ","بما فعلوا عالوْك فوق سنامِها",36,"م",3,0]]}