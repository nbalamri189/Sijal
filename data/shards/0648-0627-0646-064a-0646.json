{"poems":[[55,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[55,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[93,"تبدل قلبي من ضلالته رشدا","https://www.aldiwan.net/poem8815.html","عموديه"],[93,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[94,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[50,"تباعد ما استطعت من الشقوق","https://www.aldiwan.net/poem66603.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[92,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[93,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[128,"بالنفس يا شيخ من تقواك أشياء","https://www.aldiwan.net/poem23734.html","البسيط"],[128,"لقد كان لي قلب شفوق وأدته","https://www.aldiwan.net/poem23805.html","الطويل"],[190,"طال هذا الليل واستغشي","https://www.aldiwan.net/poem43969.html","مجزوء الرمل"],[201,"يا أخا الروح من يبل أوامي","https://www.aldiwan.net/poem39821.html","الخفيف"],[201,"عشق المجد والهوى فكرة تنمو","https://www.aldiwan.net/poem39874.html","الخفيف"],[234,"وساقية ترتمي بالحباب","https://www.aldiwan.net/poem51085.html","المتقارب"],[242,"وقرر ما تحويه منك الأضالع","https://www.aldiwan.net/poem19493.html","الطويل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[396,"يا غياث المستغيثين أغث","https://www.aldiwan.net/poem54550.html","عموديه"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[409,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[411,"أرى الضر يقفو الحر في كل مقصد","https://www.aldiwan.net/poem49763.html","الطويل"],[422,"على أي وجد طويت الضلوعا","https://www.aldiwan.net/poem53848.html","المتقارب"],[422,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[463,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[466,"كأن عقارا خندريسا تضوعت","https://www.aldiwan.net/poem16114.html","الطويل"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[520,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[556,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97024","الوافر"],[725,"","https://poetry.dctabudhabi.ae/diwan/poem/205998","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137577",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48899","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48685","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48790","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63723","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37986","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62669","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62649","الرجز"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112770","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110330","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53171","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27227","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123746","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102501","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87338","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204645","الوافر"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86335","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131250",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114220","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135767","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86376","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133113","الرجز"],[4735,"غيابات الحب","https://www.poetsgate.com/ViewPoem.aspx?id=179275",""],[4755,"وسَأَلْتُهَا: ولِمَن كِتَابَتُهُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184804",""],[4755,"أَسَرَّت إِلى أُختِها","https://www.poetsgate.com/ViewPoem.aspx?id=190547",""],[4755,"صَيَّادُ البُرُوق","https://www.poetsgate.com/ViewPoem.aspx?id=199741",""],[4859,"ضجيج الجوع","https://www.poetsgate.com/ViewPoem.aspx?id=192162",""],[4862,"الليل والمعاناة","https://www.poetsgate.com/ViewPoem.aspx?id=55373",""],[4978,"تشطير لقصيدة نادية الكيلاني","https://www.poetsgate.com/ViewPoem.aspx?id=177236",""],[5005,"قفا نبكِ..","https://www.poetsgate.com/ViewPoem.aspx?id=189391",""],[5149,"يَا أَيُّهَا المُزْجِي حَنينَ غَرَامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=211188",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5273,"سِفْرُ الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=180938",""],[5273,"نفاق","https://www.poetsgate.com/ViewPoem.aspx?id=181011",""],[592,"أقول هذا كله لا يعقل","https://www.poetsgate.com/ViewPoem.aspx?id=128804",""],[5376,"في الليلة الظلماء ساد نواح","https://www.poetsgate.com/ViewPoem.aspx?id=194862",""],[5409,"يا ابن ودي أما كفاك سهادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=155445",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5725,"الى مسافر","https://www.poetsgate.com/ViewPoem.aspx?id=184689",""],[5751,"أميرة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214765",""],[5781,"قلبي على شفاهه والسَّحَر !","https://www.poetsgate.com/ViewPoem.aspx?id=208946",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5956,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=182191",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""]],"verses":[["وَإِنّي نِعمَ دامِغُ كُلِّ قِرنٍ","يُرادي بِالعَداوَةِ أَو يُرامي",0,"م",2,0],["وَأَن يَنصَدِعَ الشَعبُ ال","لَذي لوئِمَ وَالشَملُ",1,"ل",1,0],["وَإِن يَنهَضِ الغَرسُ الَّذي هُوَ غارِسٌ","يَكُن لَكَ مَجنىً في الخُطوبِ وَمَعلَقا",2,"ق",2,0],["وأني نصحت وأني مدح","ت بالمنطق الرائق الرائع",3,"ع",1,0],["وَأَن يَنشُروا في كُلِّ أُفقٍ بُنودَهُم","وَأَن لا نَرى فَوقَ السِماكِ لَنا بَندا",4,"د",2,0],["وَأَنينُ مُحتَضِرٍ يَقولُ قَتَلتَني","ثَكَلَتكَ أُمُّكَ لَم أَنَل مَأمولا",5,"ل",2,0],["وأَنينٍ مِنْ مُعْدَمٍ ذي سَقامٍ","عضَّهُ الدَّهرُ بالخُطُوبِ الجِسامِ",6,"م",1,0],["وَأَنينٍ لَو أَنَّهُ مِن مَشوقٍ","عَرَفَ السامِعونَ مَوضِعَ نارِهِ",7,"ر",2,0],["وإن ينزل بكم خطبٌ تولَّوْا","يضجُّ عُواتُهم في الشّامتينا",8,"ن",2,0],["وإنّي ناصحٌ لكَ فاتّبعني","ودَعني من ثنيّات الطريق",9,"ق",1,0],["وأن يناط القطر والولايه","بمن له الصّهر أو الولايه",10,"ه",1,0],["وإنْ يَنَلْ بعضَهما إزالَهْ","عاقَبَه الآخرُ لا مَحالَهْ",11,"ه",1,0],["وأنيناً باحت النجوى به","عربيا رشفَتهُ مقلتانا",12,"ن",2,0],["وأنْ ينجابَ عنكَ غُبارُ بُؤسٍ","يَضيقُ به مُحيَّاك الأسيف",13,"ف",1,0],["وأنين مختضر يقول قتلتني","ثكلتك أمّك لم أنل مأمولا",14,"ل",2,0],["وأن ينير سبيل العلم إمعة","وأن تريك سوي النهج عجماء",15,"ا",2,0],["وإني نسيت اليوم أمسي فلم أعد","لتطراق طيف الشركسيات أطرب",16,"ب",1,0],["وأنيني طيّ قلبي","وهمومي وسهادي",17,"د",2,0],["وأنيني أما سمعت أنيني","دونه يا أخي أنين الحمام",18,"م",1,0],["وأنين الجرحى وحشرجة المو","تى هتافٌ لا عاش كلّ جبان",19,"ن",1,0],["وإني نهضت بمكسورِها","وآنست وحشة مهجورها",20,"ر",3,0],["وَأَنْ يَنْزَعَ الشَّحْنَاءَ مِنْ قَلْبِ عِرْسِكُمْ","فَتَطْلُعُ فِي أُفْقِ السُّرُورِ طَوَالِعُ",21,"ع",1,0],["وَأَن يُنيل رضاه من يؤازرهُ","حتّى يعزّ بِهِ الأنصار والحشمُ",22,"م",1,0],["وأنيناك من الباب الذي","منه يوصل كل عبد منه جاك",23,"ك",1,0],["وإني ناصح لك فاتبعني","فما أنا من شرابك والطعام",24,"م",1,0],["وأن ينحر السلوان في كل مقلة","ويجري دم السلوان في الوجنات",25,"ت",1,0],["وإن يَنْوِ يَوماً عِزَّةً فَهْيَ ذِلَّةٌ","وإنْ يَبغِ يَوماً مَغنَماً فَهْوَ مَغْرَمُ",26,"م",1,0],["وإنِّي نصحتُك من قبلها","وزِدْتُك لَوماً فَزِدْتَ ولوعا",27,"ع",2,0],["وإنِّي نظرتُ الناس نظرة عارفٍ","وأبصرتهم خَلقاً وخُلقاً وميسما",28,"م",2,0],["وأَنْ يَنْظُرُوا كَيْفَ ازْدَهى مَفْرِقُ العُلا","بعَقْدِي لَهُ تاجاً من الكَلِمِ العُلْيا",29,"ي",2,0],["وأن يُنزع الأمرُ من أهله","لأنّ عليّا له أُهِّلا",30,"ل",2,0],["وأن ينهضَ الجَدُّ العَثورُ بِهجرةٍ","تُعالَجُ أشواقي بها والتَّبارِحُ",31,"ح",1,0],["وأنْ ينقُضَ العهد الوكيد حفيظةً","لديهِ ولو أنَّ الذُّنوبَ زَلازِلُ",32,"ل",1,0],["وان ينل منها لغوب فلها","الأَسماع ورد والقلوب منزل",33,"ل",1,0],["وإني ناشر الإحساس فيهم","وحسبك عن أقل قالت حذام",34,"م",1,0],["وإن ينقذوني من تملك عبدهم","وخادمهم وهو الزمان ويعتقوا",35,"ق",3,0],["وأنْ يُنزلوك عن قَراها كأَنَّهمْ","بما فعلوا عالوْك فوق سنامِها",36,"م",3,0],["وأنى نرتضي منه ملالاً","وكنا من دلال ساخطينا",37,"ن",2,0],["وإن ينفذ الأمر الذي كان بيننا","نحل جميعاً في السهولة والرحب",38,"ب",1,0],["وان ينقطع عمل تنقطع","موارد رزق ويقض الرخا",39,"ا",1,0],["وإن ينج منها جانب لجناتها","فما هو إلا للجناة غداً سجن",40,"ن",1,0],["وإني نذير الغرب والغرب آثم","بهاوية لو يجمع الشرقَ جامع",41,"ع",1,0],["وإني نصيرك فيما اعتزمت","قوي اليقين عظيم الأمل",42,"ل",1,0],["وإِني ناذرٌ نَذْراً","وَمُوفٍ فيه بالنَّذر",43,"ر",1,0],["وَأَنّي نَبيءُ الحبِّ أَدعو إِلى الهَوى","وَلي مُعجِزاتٌ زيحَ عَنها سُتورُها",44,"ر",3,0],["وَأَن يُنيلَه كَمالَ الفَتح","هوَ وَمن وازَره بِنُصحِ",45,"ح",1,0],["وإن ينل قبل ما يرجو منيته","فكلُّ ما قدر الرحمن مفعولُ",46,"ل",1,0],["وإن ينادي يا بلال فهما","معرفتان قصداً معنى ظهرْ",47,"ر",1,0],["وان ينازل قرنه في موقف","أطار روساً وأطن مرفقا",48,"ق",2,0],["وأني نزيل الباب طالب نجدة","فخذ بيدي يا سيدي واسبطن يدا",49,"د",2,0],["وإن ينصدع أو ينكسر فهو هاشمٌ","ومن بعده المأموم في الأرش أثقلُ",50,"ل",1,0],["وانين ثكلاها وبث عميدها","وحنين ولهاها إلى ولهانها",51,"ن",3,0],["وإني نجاشيّ القريض فسل به","ليخبرك العجلان رهط ابن مقبل",52,"ل",1,0],["وأنينه مما يجنّ وصمته","عنه وعبرة وجده وأواره",53,"ر",2,0],["وأن ينرين له القريبا","ولا يحقرن له مشيبا",54,"ب",2,0],["وأن ينحى عنها ما أحاط بها","من الخطوب التي هالت أهاليها",55,"ي",3,0],["وإن يَنتموا جاءوا بكلّ حُلاحِلٍ","تُذِلُّ له شموسُ الملوكِ بإقرارِ",56,"ر",1,0],["وان ينازع فيما قلت ذو حسد","فليبرزن لتخرسه محاورتي",57,"ي",1,0],["وَإن يَنقُصِ البَلدُ وإن كُنتَ حازماً","هناك عَنِ الخمسين والكَوسُ عَامِر",58,"ر",1,0],["وإني ناصر للقلب وحدي","وأطلب منه تحسين الأمور",59,"ر",1,0],["وَأَنينُ النّاي أَبقى","مِن مَجيدٍ وَذَليل",60,"ل",1,0],["وَأَنينُ النّايِ يَبقى","بَعدَ أَن يَفنى الزَّمَن",60,"ن",1,0],["وَأَنِينُ النّايِ يَبقى","بَعدَ أَن تَفنى الهِضاب",60,"ب",1,0],["وَأَنِينُ النّايِ يَبقى","بَعدَ أَن تَفنى الحَياة",60,"ه",1,0],["وَأَنينُ النّايِ يَبقى","بَعد أَن تَفنى الذُّنوب",60,"ب",1,0],["وَأَنينُ النّايِ يَبقى","بَعدَ أَن تَفنى الشُّموس",60,"س",1,0],["وَأَنينُ النّاي يَبقى","بَعدَ أَن تطفا النُّجُوم",60,"م",1,0],["وَأَنِينُ النّايِ أَبقى","مِن زَنيمٍ وَجَليل",60,"ل",1,0],["وَأَنينُ النّايِ أَبقى","مِن ضَعيفٍ وَضَليع",60,"ع",1,0],["وَأَنينُ النّايِ أَبقى","مِن رَقيقٍ وَكَثيف",60,"ف",1,0],["وَأَنِينُ النّايِ أَبقى","مِن جَميلٍ وَمَليح",60,"ح",1,0],["وَأَنِينُ النّايِ أَبقى","مِن حَصيفٍ وَرَصِين",60,"ن",1,0],["وَأَنِينُ النّايِ شَوقٌ","لا يُدانيهِ الفُتُور",60,"ر",1,0],["وَأَنِينُ النّايِ أَبقى","مِن غَبوقٍ وَصَبوح",60,"ح",1,0],["وَأَنِينُ النّايِ أَبقى","مِن مسوخٍ وَنغول",60,"ل",1,0],["وَأَنِينُ النّايِ يَبقى","بَعدَ أَن يَفنى الوُجُود",60,"د",1,0],["وان ينضب البحر الخضم بماءه","فكفك بحر ماؤه غير ناضب",61,"ب",1,0],["وان يناديك قل لبيك او بنعم","اجب نداه وان يأمرك فاستلم",62,"م",1,0],["وَاِن يَنسَني وَاللَهِ بِالصَدِّ في النَوى","فَإِنّي لَهُ طولُ المَدى لَستُ بِالناسي",63,"ي",1,0],["وإن ينل أَحداً منا مينتُهُ","فما الَّذي بقضاء اللَه يَصنعُهُ",64,"ه",1,0],["وإن ينابذ ناقصٌ كاملاً","فهل يبالي الناقص الكامل",65,"ل",1,0],["وإن يناد المنادي بالصلاة فقم","لشرب كأسٍ دهاقٍ مترعٍ وقمِ",66,"م",1,0],["وَإِنِّيَ نَظَّامٌ لِكُلِّ دَقِيقَةٍ","فَأبدَت إِلَيَّ الجَوهَرَ الفَردَ مِن ثَغرِ",67,"ر",1,0],["وأن ينيلنا شراباً من شرابْ","أهلِ العنايةِ وأهل الاقترابْ",68,"ب",1,0],["وإن ينل منك مقدار فلا عجب","هل ابن آدم إلا عرضة الخطر",69,"ر",1,0],["وإن ينل القبول فخير مهر","به أصدقتها كرما وفضلا",70,"ل",2,0],["وإن ينصروك ابتداءً","فآخراً يخذلونك",71,"ك",1,0],["وأنينُ قافيتي بوهْجِ مشاعرِي","تاهتْ من الدورانِ في أفلاكي",72,"ك",2,0],["وأنِينُ (رَحْمَةَ) وهي تَمْسَحُ عَن","(أيُّوبَ) ما ألقَتْ إصَابَتُهُ",73,"ت",2,0],["وإِني نَصِيبُ الغَريبِ الذي","غَدًا يُفصِحُ الغَيبُ عَن دُورِهِ",74,"ر",2,0],["وأَنينُ شَدْوِكَ للصّباحِ مَنَاسِكٌ","صَلَّاكَ خَلفَ سُطُورِهَا الثُّوَّارُ",75,"ر",1,0],["وأن ينسى ضجيج الجوع جوعا","ويغفو كالملائك في سعادة !",76,"ه",1,0],["وأنين شخص بات يشكو سقمه","يغتاله حينا وحينا يهجم",77,"م",1,0],["(وإن ينضبْ أنا أذوي)","وَإِذْ يَبْتَلُّ يُحْيِينِي",78,"ن",2,0],["وَإِنْ يَنْبِسْ بِحرفٍ - لَيْتَنِيْهِ -","أَزُمَّ الماسَ فيما قد حكاهُ",79,"ا",2,0],["وَأَنِينُ ذَا الصَّدِّ الْمُقِيمِ كَغَيْمَةٍ","وَرَفَتْ وَغَطَّتْ بِالْهُمُومِ غَيَاهِبَا",80,"ب",2,0],["وإن ينافسني في صناعتي","فإنها أجل من أن تدعى",81,"ا",1,0],["وإن ينازعني ردائي ظالما","جعلته غلاّ عليه فَخَذا",81,"ا",1,0],["وأنينُ قنديلٍ يغازل ظُلْمتي","والتَّبْغُ أوغلَ في العروقِ المُقفرَهْ",82,"ر",2,0],["وأنينُ أيامٍ ونوحُ قَصيدةٍ","ومسافةٌ بخُطى النّهايةِ تُقْتَلُ",83,"ل",1,0],["وأن ينادي إن ألمت أزمة","وأنشبت أظفارها لا تمهل",84,"ل",1,0],["وأنين طائرِها يهيج تلوَّعاً","ما عامَ في دمعاتَه السبَّاحُ",85,"ح",1,0],["وأنين منه اتخذت أذاناً","في الليالي لتوقظ النواما",86,"م",2,0],["وأنينك المدمي الكبو","د كأنه وخز الإبر",87,"ر",1,0],["واني نجمة استوحشت بعد المغيبِ","وبجبينك سيّر ابنوره الكمر",88,"ر",1,0],["وأنْ يَنمو بذاكرةِ الخَطايا","ويَسْتَعْدي بذاكرةٍ جديدَهْ",89,"د",2,0],["وأنينُ أهلي مُوجِعٌ","وأنا الوَجيعُ بِلا شَفيقِ",90,"ق",1,0],["وإنّي نميريٍّ على العهد لم أزل","لما قصدوا أهل التُّقى متقصّدا",91,"د",2,0],["وإني نميري اليقين ومعشري","إلى مضر الحمراء في المجد تُضْربُ",92,"ب",1,0],["وأنيني سوف يبقى","في فؤادي باضطراب",93,"ب",1,0],["وَ أَنِّي نَخْلَةٌ فِي الْقَفْرِ أَرْجُو","سَمَاءً هَلْ سَتُمْطِرُ أَوْ تَخُونُ",94,"ن",1,0]]}