",""],[5528,"مداعبة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=201113",""],[5535,"سأودعك السر الذي قد كتمته","https://www.poetsgate.com/ViewPoem.aspx?id=201513",""],[5537,"ال( أنا ) وال( هو )","https://www.poetsgate.com/ViewPoem.aspx?id=207858",""],[5561,"الحوار الرابع عشر","https://www.poetsgate.com/ViewPoem.aspx?id=202115",""],[470,"أسفاً على كل الذي عشناه","https://www.poetsgate.com/ViewPoem.aspx?id=178049",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[5818,"حِبالُ الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=186909",""],[5853,"غروب شمس","https://www.poetsgate.com/ViewPoem.aspx?id=175722",""],[5956,"حبٌ وصد","https://www.poetsgate.com/ViewPoem.aspx?id=182213",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[5956,"أ تظن أني لست آلَفُ فضلكا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193356",""],[5957,"حبي الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=12485",""],[4442,"أرهقتني بين المقابر جلبه","https://www.poetsgate.com/ViewPoem.aspx?id=171231",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6202,"هيهات هيهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86756&r=&rc=57",""],[6238,"بِئسَ الهوى...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86778&r=&rc=7",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[4222,"قد أضاء الزمان بالمستضيء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52712&r=&rc=4",""]],"verses":[["ساوَرَت أَطواداً تَرَ","دّى دونَها الأَجادِلُ",0,"ل",1,0],["ساوَرتَهُ فَفَضَضتَ سَورَتَهُ","وَاِرتاحَ في نُعماكَ مُملِقُهُ",1,"ق",2,0],["ساوَرَ الأَمرَ وَلَم يَع","لَم بِأَسرارِ الغُيوبِ",2,"ب",1,0],["سَأوحِشُ قَلبي بَعدَها مِن سُرورِهِ","وَأونِسُ عَيني بِالدُموعِ السَواكِبِ",3,"ب",1,0],["ساوَرْتُ أسْوَدَ منْ ظَلامِ دُجىً","مَنْ نابَهُ فإلى الهُمومِ دُفِعْ",4,"ع",1,1],["سَأوصي بَصيراً إِن دَنَوتُ مِنَ البِلى","وَصاةَ اِمرِئٍ قاسى الأُمورَ وَجَرَّبا",5,"ب",2,0],["سَأوصي بَصيراً إِن دَنَوتُ مِنَ البِلى","وَكُلُّ اِمرِئٍ يَوماً سَيُصبِحُ فانِيا",6,"ي",2,0],["سَاوَمَ فِيهَا عَلَى جَوَاهِرِهِ","مَنْ فِي مَرَائِي النُّفُوسِ يَنْضِدُهَا",7,"د",3,0],["سَأوتي العَشيرَةَ ما حاوَلَت","إِلَيَّ وَأُكذِبُ إِبعادَها",8,"د",3,0],["ساور الفرقدين عنه إلى أن","أسلماه وتله للجبين",9,"ن",1,0],["سَاوروها بكلِّ علياءَ حتى","بَلَغوها مَفْتوحَة الأبوابِ",10,"ب",1,0],["ساواهما في الحجى واحتاز دونهما","فضلَ الندى فلهُ في الفضل سُهمان",11,"ن",1,0],["ساوَرَني الهَم وَساوَرتُهُ","ما أَعجَزَ الإِنسانَ عَن رَدِّهِ",12,"د",2,0],["ساوى الرَضيعَ بِهِ مَن شابَ مَفرِقُهُ","وَالعَبدُ سَيِّدَه وَالثَعلَبُ الأَسَدا",13,"د",2,0],["سأُوليكَ مِنّي ما عهدتَ مِنَ الرِضا","وَأَعرِضُ عَمّا كانَ إِن كانَ مِن ذَنبِ",14,"ب",1,0],["سأوالى الجهد او القى","الذي قد ضاع مني",15,"ي",1,0],["ساورتني بك الرزية حتى","ضاق عما اقول فيك نطاقي",16,"ق",2,0],["سأول يوم سقوطهم في وجههم","هذا جزاء الخائنين فذوقوا",17,"ق",3,0],["ساويتُه في لونه ونُحولهِ","وفضَلتُه في بُؤسهِ وشقَائهِ",18,"ا",3,0],["سَأُوَدِّعُ الإِحسانَ بَعدَكَ وَاللُهى","إِذ حانَ مِنكَ البَينُ وَالتَوديعُ",19,"ع",1,0],["ساوى الرِفاقَ بِشُربِها حَتّى إِذا","ثَمِلَ المُديرُ وَغابَ رُشدُ الحاسي",20,"س",2,0],["ساوى البِلادَ كَما تُساوي في النَدى","بَينَ الأَنامِ مَواهِبُ السُلطانِ",21,"ن",1,0],["سَأوطِئُ أَهلَ العَسكَرِ الآنَ عَسكَراً","مِنَ الذُلِّ مَحّاءً لِتِلكَ المَعالِمِ",22,"م",1,0],["سَآوي بِهَذا القَلبِ مِن لَوعَةِ الهَوى","إِلى ثَغَبٍ مِن نُطفَةِ اليَأسِ بارِدِ",23,"د",1,0],["ساوَرتُ مِن دونِهِ العَقَنقَلَ وَال","جَوفَ أُزجّي المَهرِيَّةَ النُجُبا",24,"ب",2,0],["ساوَى الرّضيُّ المُرْتَضى وتَقاسَما","خِطَطَ العُلى بتَناصُفٍ وتَصافِ",25,"ف",1,0],["سأولي ربوع بغداد ظهري","تاركاً خيرها لأهل النفاق",26,"ق",1,0],["ساوت على الحالين حُم","لاناً بها وأذؤُبا",27,"ب",2,0],["سَاوَرَ الأُمَّةَ التَّرَددَ وَالْتَا","ثَ عَلَيْهَا فِي السَّيْرِ وَجْهُ الرَّشَادِ",28,"د",1,0],["ساوى الرضيع به شاب مفرقه","والعبد سيّده والثعلب الأسدا",29,"د",2,0],["ساوت بساطته الشعوب فما ترى","فيها هجينا أو تعدّ أصيلا",30,"ل",2,0],["سأوصي بصيراً إنْ دنوتُ من البلى","وَصَاة َ امْرِىء ٍ قاسَى الأمُورَ وَجَرّبَا",31,"ب",2,0],["ساوَمتُهُ وَصلاً فَأَعجَم لِفظُهُ","وَأَظنَهُ عَن ضد ذَلِكَ أَعرَبا",32,"ب",2,0],["ساوى لديه معلم متعلماً","إذ كلهم في رتبة التلقين",33,"ن",1,0],["ساوى العزيز بها الذليل فما بقى","منها الفرار ولا ينال الثارُ",34,"ر",1,0],["ساوَت في الحُسنِ زَمانَ المَل","كِ عِمادِ الدِّينِ حَيا الأُمَمِ",35,"م",1,0],["سأوقد نيران المعاني يشبها","جوى في ثنيات الفؤاد دخيل",36,"ل",1,0],["سأوقد الشعر في الوادي وأعلنه","إن كان في حاجة يوماً لإعلان",37,"ن",1,0],["سَأُوافيكَ عَن قَريبٍ فَهَيّء","خَيمَةَ الحُبِّ بَينَ زَهرِ الخُزامى",38,"م",2,0],["ساويتَ بين الزَّهْرِ في نَبْتِه","كأنّما لحظك ورّاق",39,"ق",1,0],["ساوَتْ أَعاصِرُهُ طِيباً عَنَاصِرُهُ","فالدَّهْرُ أَجْمَعُ أَسْحارٌ وآصالُ",40,"ل",1,0],["سَاوى الجِهَادُ الحَيّ فيه هَوىً","مِنْ عُرْفِهِ أنْ يُنْكَرَ العَذَلُ",41,"ل",1,0],["سَاوَرَتْهُم فَاغْتَدَوْا مَثَلاً","سُؤْرَ تَنْفِيرٍ وَتَنْفيلِ",42,"ل",1,0],["سَأُؤَذِّنُ في حُبّيكَ جِها","راً حَيّ على خَيرِ العَمَلِ",43,"ل",1,0],["ساوت شجاعتُه فيهم فصاحته","فردَّهم معجزاً بالكَلم والكَلِمِ",44,"م",1,0],["ساوَت ليالي البدرِ عند كمالهِ","أنصافُ أبيات على ميزانِ",45,"ن",1,0],["سَأَودي حَقَّ جاري","وَيَدي رَهنُ فِعالي",46,"ل",2,0],["ساويريوسْ ذاك الشقي","إذ كان بالإيمان مان",47,"ن",1,0],["سَأوضح نَهجَ الحَق إِن كانَ سامِعٌ","وَأُرشِدُ مَن يُصغي إِلَيَّ وَيُرشَد",48,"د",1,0],["سَأُوَالي مِدَحي فيه وفي","آله ما مَلك النّطْقَ لِساني",49,"ن",2,0],["ساوَى حُضورَهُمُ عِندي مغيبهُمُ","وصنتُهم فيهما عَمّا يَعيبُهمُ",50,"م",1,0],["ساويتَ في عدلِكَ بين الورَى","حتّى تَساوَى الزُّجُّ واللَّهذمُ",51,"م",1,0],["ساوَى بِعادُك ليلَها ونَهارَها","كلٌّ كما قَضَتِ الهمومُ بَهيمُ",52,"م",1,0],["ساؤوا رسول الله في أصحابه","وبقولهم بالإِفك وهو يكفر",53,"ر",1,0],["ساورتها حتى الصبا","ح ودمع عيني في صبيب",54,"ب",1,0],["ساورتها ليل التما","م وبتُّ في العشاق فرْدَا",55,"د",2,0],["ساوَرَتْني نوازِعُ الشوق حتى","تركتْ وَبْلَ أدمعي مهطالا",56,"ل",2,0],["ساوى النشوء دمارا في مسارحه","كما عرفت وساوى البؤس نعماء",57,"ا",2,0],["ساوت فما تركت عزيزاً مُفرداً","وَحَبت فلم تَذرَ الفقيرَ ذليلا",58,"ل",2,0],["ساوى الفقيرُ به الغنىَّ طلاقةً","والغيمُ رقرقَ في الدموعِ قصيدا",59,"د",2,0],["ساوى بها الليل النهار وضفا ال","ظل ولذ في ذراها المنهل",60,"ل",1,0],["سأوصي عليه الدهر في كل نكبة","فيغتاله رئبال آجام ضاربا",61,"ب",2,0],["ساوَتْهُمُ عدداً وساوَوْها عُلاً","فالفرقُ لا يخلو من الإشكالِ",62,"ل",1,0],["سآوي إلى ركن شديد والتجي","إلى ملك عم البرية نائله",63,"ل",2,0],["ساوَمْنَنِي قلبي فرُحنَ به","عنّي وكم بيعٍ على غَرَرِ",64,"ر",1,0],["ساوَرتُهُ فَاِمتَدَّ ثُمَّ تَقَطَّعَت","أَنفاسُهُ في صُبحِهِ المُتَنَفِّسِ",65,"س",1,0],["ساوى البرية في أوصاف خلقتهم","وفاقهم في العلا والفضل والعصم",66,"م",1,0],["سَاوَى على لَوحِ ياقوتٍ لعارِضهِ","سَطرَين من خَطّ رَيحانٍ بلا قَلَمِ",67,"م",1,0],["سأُوسِعُ القَبْرَ بالأَعمالِ أُصلحُها","جُهْدي وأَلْبَسُ زُهْدِي قَبْلَ أَكفَاني",68,"ن",2,0],["ساوى الوفاء لمصر بين قلوبهم","وأجلُّهم أثراً أجلُّ ثوابا",69,"ب",2,0],["ساوى المُحَيِّي بأزهارٍ وألوية","من كان يرمي بأشواكٍ وأحجارِ",70,"ر",1,0],["ساوموا في الرضى به واستحلوا","ثمناً للرضى وقد قبضوه",71,"و",2,0],["سَأودِع غَزوَهُم في الروم نَصّاً","نِظاماً لا أَخاف بِهِ اِضطِرابا",72,"ب",2,0],["سأورثها غبراء بالجمر تلتظي","وتُمطر هاماً بالوشيج المقصد",73,"د",1,0],["ساويت فيه بين مض","طهد وبني عظيم جاه",74,"ه",1,0],["سأوضحُ القولَ في الأزد الذينهُمُ","في منهجِ الدين والإسلام برهانُ",75,"ن",1,0],["سأوضح الصدق في منطقي ولو","أقيمت على رأسي السيوف وسلّتِ",76,"ت",1,0],["ساوى الرَعية في قسطاسِ رَحَمَتِهِ","فَوطد الوفقَ لا خَلفٌ وَلا هَرجُ",77,"ج",1,0],["سَاوَرْتُهُ مُعْتَرِفاً بِأَكْلِي","بِالصِيتِ وَالعَجَّاجِ غَيْرِ غُفْلِ",78,"ل",1,0],["ساورتني البأس