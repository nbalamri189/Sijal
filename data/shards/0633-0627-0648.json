{"poems":[[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[55,"أأبغي صبا من بعد هيلانة إذا","https://www.aldiwan.net/poem26450.html","الطويل"],[77,"ساورت أسود من ظلام دجى","https://www.aldiwan.net/poem35984.html","أحذ الكامل"],[9,"كفى بالذي تولينه لو تجنبا","https://www.aldiwan.net/poem21907.html","الطويل"],[9,"ذريني لك الويلات آتي الغوانيا","https://www.aldiwan.net/poem21989.html","الطويل"],[93,"هذي عكاظ وذاك معهدها","https://www.aldiwan.net/poem11142.html","المنسرح"],[23,"ألم تذر العين تسهادها","https://www.aldiwan.net/poem21258.html","المتقارب"],[72,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[51,"أعلم الناس بالنجوم بنو نوبخت","https://www.aldiwan.net/poem8155.html","الخفيف"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"مثلي هذا النجم في سهده","https://www.aldiwan.net/poem8804.html","عموديه"],[91,"عدمت قلبي إذا لم يعدم الجلدا","https://www.aldiwan.net/poem8814.html","عموديه"],[78,"تقدم إلى ما اعتدت عندي من الرحب","https://www.aldiwan.net/poem14177.html","الطويل"],[89,"آه يا نفسي اطمئني","https://www.aldiwan.net/poem44681.html","مجزوء الرمل"],[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[89,"الشمس قد غربت فلاح وراءها","https://www.aldiwan.net/poem44892.html","الكامل"],[62,"ومساعد لي في البكاء مساهر","https://www.aldiwan.net/poem52510.html","الكامل"],[45,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[66,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[44,"متى كان سمعي خلسة للوائم","https://www.aldiwan.net/poem30358.html","الطويل"],[44,"قفوا جددوا من عهدكم بالمعاهد","https://www.aldiwan.net/poem30543.html","الطويل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[91,"الرزء الأليم","https://www.poetsgate.com/ViewPoem.aspx?id=53030",""],[9,"كَفَى بِالّذِي تُولِينَهُ لَوْ تَجَنّبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17253&r=&rc=0",""],[107,"قمر إذا فكرت فيه تعتبا","https://www.aldiwan.net/poem16217.html","الكامل"],[148,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[158,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[167,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[209,"غدا سوف ألقى من حياتي نعيمها","https://www.aldiwan.net/poem46620.html","الطويل"],[209,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[221,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[227,"يأيها المعشوق لا فارقت","https://www.aldiwan.net/poem50918.html","السريع"],[273,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[273,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[273,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[280,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[295,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[303,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[341,"إنما جاري لعمري","https://www.aldiwan.net/poem24177.html","مجزوء الرمل"],[374,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[390,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[399,"حدثاني عن علي حدثاني","https://www.aldiwan.net/poem46975.html","الرمل"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[406,"وسر إلى بحر خضم له","https://www.aldiwan.net/poem32206.html","السريع"],[406,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[413,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[450,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13633.html","مجزوء الكامل"],[450,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13751.html","مجزوء الكامل"],[450,"ويح قلبي كم ذا يطيق احتمالا","https://www.aldiwan.net/poem13962.html","الخفيف"],[451,"قال الصديق وديع في سوانحه","https://www.aldiwan.net/poem61240.html","البسيط"],[451,"لمن النجوم رقصن فوق خميلة","https://www.aldiwan.net/poem61633.html","الكامل"],[451,"الشكر يجدر أن يمثل عيدا","https://www.aldiwan.net/poem61637.html","الكامل"],[462,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[480,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[512,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[513,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[549,"لما طلعن علي في غسق","https://www.aldiwan.net/poem47773.html","أحذ الكامل"],[551,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[573,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"]],"verses":[["ساوَرَت أَطواداً تَرَ","دّى دونَها الأَجادِلُ",0,"ل",1,0],["ساوَرتَهُ فَفَضَضتَ سَورَتَهُ","وَاِرتاحَ في نُعماكَ مُملِقُهُ",1,"ق",2,0],["ساوَرَ الأَمرَ وَلَم يَع","لَم بِأَسرارِ الغُيوبِ",2,"ب",1,0],["سَأوحِشُ قَلبي بَعدَها مِن سُرورِهِ","وَأونِسُ عَيني بِالدُموعِ السَواكِبِ",3,"ب",1,0],["ساوَرْتُ أسْوَدَ منْ ظَلامِ دُجىً","مَنْ نابَهُ فإلى الهُمومِ دُفِعْ",4,"ع",1,1],["سَأوصي بَصيراً إِن دَنَوتُ مِنَ البِلى","وَصاةَ اِمرِئٍ قاسى الأُمورَ وَجَرَّبا",5,"ب",2,0],["سَأوصي بَصيراً إِن دَنَوتُ مِنَ البِلى","وَكُلُّ اِمرِئٍ يَوماً سَيُصبِحُ فانِيا",6,"ي",2,0],["سَاوَمَ فِيهَا عَلَى جَوَاهِرِهِ","مَنْ فِي مَرَائِي النُّفُوسِ يَنْضِدُهَا",7,"د",3,0],["سَأوتي العَشيرَةَ ما حاوَلَت","إِلَيَّ وَأُكذِبُ إِبعادَها",8,"د",3,0],["ساور الفرقدين عنه إلى أن","أسلماه وتله للجبين",9,"ن",1,0],["سَاوروها بكلِّ علياءَ حتى","بَلَغوها مَفْتوحَة الأبوابِ",10,"ب",1,0],["ساواهما في الحجى واحتاز دونهما","فضلَ الندى فلهُ في الفضل سُهمان",11,"ن",1,0],["ساوَرَني الهَم وَساوَرتُهُ","ما أَعجَزَ الإِنسانَ عَن رَدِّهِ",12,"د",2,0],["ساوى الرَضيعَ بِهِ مَن شابَ مَفرِقُهُ","وَالعَبدُ سَيِّدَه وَالثَعلَبُ الأَسَدا",13,"د",2,0],["سأُوليكَ مِنّي ما عهدتَ مِنَ الرِضا","وَأَعرِضُ عَمّا كانَ إِن كانَ مِن ذَنبِ",14,"ب",1,0],["سأوالى الجهد او القى","الذي قد ضاع مني",15,"ي",1,0],["ساورتني بك الرزية حتى","ضاق عما اقول فيك نطاقي",16,"ق",2,0],["سأول يوم سقوطهم في وجههم","هذا جزاء الخائنين فذوقوا",17,"ق",3,0],["ساويتُه في لونه ونُحولهِ","وفضَلتُه في بُؤسهِ وشقَائهِ",18,"ا",3,0],["سَأُوَدِّعُ الإِحسانَ بَعدَكَ وَاللُهى","إِذ حانَ مِنكَ البَينُ وَالتَوديعُ",19,"ع",1,0],["ساوى الرِفاقَ بِشُربِها حَتّى إِذا","ثَمِلَ المُديرُ وَغابَ رُشدُ الحاسي",20,"س",2,0],["ساوى البِلادَ كَما تُساوي في النَدى","بَينَ الأَنامِ مَواهِبُ السُلطانِ",21,"ن",1,0],["سَأوطِئُ أَهلَ العَسكَرِ الآنَ عَسكَراً","مِنَ الذُلِّ مَحّاءً لِتِلكَ المَعالِمِ",22,"م",1,0],["سَآوي بِهَذا القَلبِ مِن لَوعَةِ الهَوى","إِلى ثَغَبٍ مِن نُطفَةِ اليَأسِ بارِدِ",23,"د",1,0],["ساوَرتُ مِن دونِهِ العَقَنقَلَ وَال","جَوفَ أُزجّي المَهرِيَّةَ النُجُبا",24,"ب",2,0],["ساوَى الرّضيُّ المُرْتَضى وتَقاسَما","خِطَطَ العُلى بتَناصُفٍ وتَصافِ",25,"ف",1,0],["سأولي ربوع بغداد ظهري","تاركاً خيرها لأهل النفاق",26,"ق",1,0],["ساوت على الحالين حُم","لاناً بها وأذؤُبا",27,"ب",2,0],["سَاوَرَ الأُمَّةَ التَّرَددَ وَالْتَا","ثَ عَلَيْهَا فِي السَّيْرِ وَجْهُ الرَّشَادِ",28,"د",1,0],["ساوى الرضيع به شاب مفرقه","والعبد سيّده والثعلب الأسدا",29,"د",2,0],["سأوصي بصيراً إنْ دنوتُ من البلى","وَصَاة َ امْرِىء ٍ قاسَى الأمُورَ وَجَرّبَا",30,"ب",2,0],["ساوَمتُهُ وَصلاً فَأَعجَم لِفظُهُ","وَأَظنَهُ عَن ضد ذَلِكَ أَعرَبا",31,"ب",2,0],["ساوى لديه معلم متعلماً","إذ كلهم في رتبة التلقين",32,"ن",1,0],["ساوى العزيز بها الذليل فما بقى","منها الفرار ولا ينال الثارُ",33,"ر",1,0],["ساوَت في الحُسنِ زَمانَ المَل","كِ عِمادِ الدِّينِ حَيا الأُمَمِ",34,"م",1,0],["سأوقد نيران المعاني يشبها","جوى في ثنيات الفؤاد دخيل",35,"ل",1,0],["سأوقد الشعر في الوادي وأعلنه","إن كان في حاجة يوماً لإعلان",36,"ن",1,0],["سَأُوافيكَ عَن قَريبٍ فَهَيّء","خَيمَةَ الحُبِّ بَينَ زَهرِ الخُزامى",37,"م",2,0],["ساويتَ بين الزَّهْرِ في نَبْتِه","كأنّما لحظك ورّاق",38,"ق",1,0],["ساوَتْ أَعاصِرُهُ طِيباً عَنَاصِرُهُ","فالدَّهْرُ أَجْمَعُ أَسْحارٌ وآصالُ",39,"ل",1,0],["سَاوى الجِهَادُ الحَيّ فيه هَوىً","مِنْ عُرْفِهِ أنْ يُنْكَرَ العَذَلُ",40,"ل",1,0],["سَاوَرَتْهُم فَاغْتَدَوْا مَثَلاً","سُؤْرَ تَنْفِيرٍ وَتَنْفيلِ",41,"ل",1,0],["سَأُؤَذِّنُ في حُبّيكَ جِها","راً حَيّ على خَيرِ العَمَلِ",42,"ل",1,0],["ساوت شجاعتُه فيهم فصاحته","فردَّهم معجزاً بالكَلم والكَلِمِ",43,"م",1,0],["ساوَت ليالي البدرِ عند كمالهِ","أنصافُ أبيات على ميزانِ",44,"ن",1,0],["سَأَودي حَقَّ جاري","وَيَدي رَهنُ فِعالي",45,"ل",2,0],["ساويريوسْ ذاك الشقي","إذ كان بالإيمان مان",46,"ن",1,0],["سَأوضح نَهجَ الحَق إِن كانَ سامِعٌ","وَأُرشِدُ مَن يُصغي إِلَيَّ وَيُرشَد",47,"د",1,0],["سَأُوَالي مِدَحي فيه وفي","آله ما مَلك النّطْقَ لِساني",48,"ي",1,0],["ساوَى حُضورَهُمُ عِندي مغيبهُمُ","وصنتُهم فيهما عَمّا يَعيبُهمُ",49,"م",1,0],["ساويتَ في عدلِكَ بين الورَى","حتّى تَساوَى الزُّجُّ واللَّهذمُ",50,"م",1,0],["ساوَى بِعادُك ليلَها ونَهارَها","كلٌّ كما قَضَتِ الهمومُ بَهيمُ",51,"م",1,0],["ساؤوا رسول الله في أصحابه","وبقولهم بالإِفك وهو يكفر",52,"ر",1,0],["ساورتها حتى الصبا","ح ودمع عيني في صبيب",53,"ب",1,0],["ساورتها ليل التما","م وبتُّ في العشاق فرْدَا",54,"د",2,0],["ساوَرَتْني نوازِعُ الشوق حتى","تركتْ وَبْلَ أدمعي مهطالا",55,"ل",2,0],["ساوى النشوء دمارا في مسارحه","كما عرفت وساوى البؤس نعماء",56,"ا",2,0],["ساوت فما تركت عزيزاً مُفرداً","وَحَبت فلم تَذرَ الفقيرَ ذليلا",57,"ل",2,0],["ساوى الفقيرُ به الغنىَّ طلاقةً","والغيمُ رقرقَ في الدموعِ قصيدا",58,"د",2,0],["ساوى بها الليل النهار وضفا ال","ظل ولذ في ذراها المنهل",59,"ل",1,0],["سأوصي عليه الدهر في كل نكبة","فيغتاله رئبال آجام ضاربا",60,"ب",2,0],["ساوَتْهُمُ عدداً وساوَوْها عُلاً","فالفرقُ لا يخلو من الإشكالِ",61,"ل",1,0],["سآوي إلى ركن شديد والتجي","إلى ملك عم البرية نائله",62,"ل",2,0],["ساوَمْنَنِي قلبي فرُحنَ به","عنّي وكم بيعٍ على غَرَرِ",63,"ر",1,0],["ساوَرتُهُ فَاِمتَدَّ ثُمَّ تَقَطَّعَت","أَنفاسُهُ في صُبحِهِ المُتَنَفِّسِ",64,"س",1,0],["ساوى البرية في أوصاف خلقتهم","وفاقهم في العلا والفضل والعصم",65,"م",1,0],["سَاوَى على لَوحِ ياقوتٍ لعارِضهِ","سَطرَين من خَطّ رَيحانٍ بلا قَلَمِ",66,"م",1,0],["سأُوسِعُ القَبْرَ بالأَعمالِ أُصلحُها","جُهْدي وأَلْبَسُ زُهْدِي قَبْلَ أَكفَاني",67,"ي",1,0]]}