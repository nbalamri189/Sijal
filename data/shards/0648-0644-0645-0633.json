{"poems":[[92,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[269,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[362,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[456,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"]],"verses":[["ولَمَسْتُ أَوتارَ الدُّهُورِ فلمْ تُفِضْ","إلاَّ أَنيناً دامياً مَكْلُوما",0,"م",2,0],["ولمسُ كفٍّ ولمحُ طرفٍ","ولثمُ مستعذبٍ برودِ",1,"د",1,0],["ولمستُ الخافقَ الحيَّ المنى","طينةً تبكي بكفِّ الجابلِ",2,"ل",1,0],["وَلِمُسْتَعِيري جَاهِهِ مِنْ نَشْئِهِمْ","عَوْناً بِقَوْلٍ مُسْعِدٍ أَوْ نَالِ",3,"ل",1,0],["ولَمَستُ في أبياتِه دَعةَ الصِّبا","ولداتهِ والخاطرَ المجموعا",4,"ع",2,0],["ولمستُ يومَك حين ضجَّ ضجيجُها","ومشتْ تدُكُّ روابياً وسهولا",5,"ل",2,0],["ولمستَ من لَهَبِ السياطِ ووَقْعها","فوقَ الظهورِ على الطُّغاةِ دليلا",5,"ل",2,0],["وَلمسجد الاقصى استمر رحيله","وَثَنى الى عرش المُهَيمِن راقى",6,"ق",2,0],["ولمَسْحِه كَفَّ الثريّا عُمْرَها","بَقِيَتْ كذا مَبْسوطةً إلحاحا",7,"ح",2,0],["ولمستجيرٍ والخطوبُ تنوشه","مستطعمٌ والدهر فيه آكلُ",8,"ل",1,0]]}