{"poems":[[94,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[50,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[92,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[276,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[463,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77983","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108369",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91837","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90906","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117253","الكامل"],[4958,"هكذا تكلم المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=155102",""],[4966,"عصفورتى","https://www.poetsgate.com/ViewPoem.aspx?id=196684",""],[5183,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=186492",""],[5363,"خذني إلي ودلني","https://www.poetsgate.com/ViewPoem.aspx?id=144467",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5525,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=875",""],[5525,"تغريد","https://www.poetsgate.com/ViewPoem.aspx?id=833",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[5721,"ما حييتُ أقولها","https://www.poetsgate.com/ViewPoem.aspx?id=214742",""],[5845,"ألسيعُ صلِّ مالهُ منْ راقِ","https://www.poetsgate.com/ViewPoem.aspx?id=16699",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[6102,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=182838",""],[6203,"من منفاه يحدّثك!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88022&r=&rc=0",""]],"verses":[["ولَمَسْتُ أَوتارَ الدُّهُورِ فلمْ تُفِضْ","إلاَّ أَنيناً دامياً مَكْلُوما",0,"م",2,0],["ولمسُ كفٍّ ولمحُ طرفٍ","ولثمُ مستعذبٍ برودِ",1,"د",1,0],["ولمستُ الخافقَ الحيَّ المنى","طينةً تبكي بكفِّ الجابلِ",2,"ل",1,0],["وَلِمُسْتَعِيري جَاهِهِ مِنْ نَشْئِهِمْ","عَوْناً بِقَوْلٍ مُسْعِدٍ أَوْ نَالِ",3,"ل",1,0],["ولَمَستُ في أبياتِه دَعةَ الصِّبا","ولداتهِ والخاطرَ المجموعا",4,"ع",2,0],["ولمستُ يومَك حين ضجَّ ضجيجُها","ومشتْ تدُكُّ روابياً وسهولا",5,"ل",2,0],["ولمستَ من لَهَبِ السياطِ ووَقْعها","فوقَ الظهورِ على الطُّغاةِ دليلا",5,"ل",2,0],["وَلمسجد الاقصى استمر رحيله","وَثَنى الى عرش المُهَيمِن راقى",6,"ق",2,0],["ولمَسْحِه كَفَّ الثريّا عُمْرَها","بَقِيَتْ كذا مَبْسوطةً إلحاحا",7,"ح",2,0],["ولمستجيرٍ والخطوبُ تنوشه","مستطعمٌ والدهر فيه آكلُ",8,"ل",1,0],["ولمس وذوق للمطاعم كلها","وأنف لمشموم وسمع وناظر",9,"ر",1,0],["وَلَمَستِ بُهتانَ الغَنِيِّ وَمَكرهُ","وَشَهِدتِ عُدوانَ الفَقيرِ المُعسِرِ",10,"ر",1,0],["ولمست معصمها فقابلني بها","روح يعيد الروح من اردانه",11,"ن",2,0],["وَلمستُ تلك الناعمات نواهداً","وَسحرتُ سحرَ اللحظ في ذاك الغزل",12,"ل",1,0],["ولمسحه رأس الصغير ووضعه","يده الكريمة فوق بطن الحامل",13,"ل",1,0],["ولمست أعضاء الزمان بفكرة","عرفت مكان شفائها والمقتل",14,"ل",1,0],["ولمستحقيها الهناء لأنهم","فازوا بما حازوه فوز جسور",15,"ر",1,0],["ولمسكة الظلماء عرفٌ طيبه","يزرى بكافور الضيا ويشيحُ",16,"ح",1,0],["وَلمَسْتُ أحزانَ التُّرابِ إذا استُبيحَ","بنَفْسَجٌ أو يُسْتَباحُ قَرَنْفُلُ",17,"ل",1,0],["ولمستُ برد الكف يلفحُ مهجتى","فعلمتُ أنى فى الجنان مخلِّفُ",18,"ف",1,0],["ولمست الحياة حفنة ورد","في يدها والأنس خمرا وجاما",19,"م",2,0],["ولمستُ جلدي كان جلداً قاسياً","ونظرت عودي كانحناءةِ نخلةِ",20,"ه",1,0],["ولمست في يدك الطهور خشونة","من كسبها لعيالها تتخدّدُ",21,"د",1,0],["ولمست فيض نبوءة","سطعت به في السابعة",22,"ع",2,0],["ولمستك بروحي .. وكانت قناديل","أصابعي .. والقلب نار.. وفتيله",23,"ل",2,0],["ولمست قلبي لين كله تجاعيد","شاب الهوى يا ليت ما فات ميعاد",24,"د",1,0],["ولمستُ الجراح لمسَ طبيبٍ","وغسلتُ العناء وهو شديدُ",25,"د",1,0],["وَ لَمِسْتُ بَيْنَهُمَا عَجَائِبَ قُدْرَةٍ","وَ حَفِظْتُ نُورَكَ فِي الفُؤَادِ نَزِيلا",26,"ل",2,0],["ولمسجدِ الأقصى استمرَّ رحيلهُ","وثنى إلى عرشِ المهيمنِ راقِ",27,"ق",1,0],["ولمستُ حرقة ما تناثر من","شِعرٍ على الطرقات مرتَجلِ",28,"ل",1,0],["وَ لَمَستُ طَيفًا ؛ وَي كَأَنَّ ضِياءَهُ","شَقَّ الكَرَى إِمَّا تَكَوَّرَ حالِكا",29,"ك",2,0],["ولمستُ في عينيكِ جذبةَ سالكٍ","ووجدتني أسعى إليكِ.. (مُريدا)",30,"د",2,0]]}