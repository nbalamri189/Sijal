{"poems":[[57,"أناسية ما كان بيني وبينها","https://www.aldiwan.net/poem26095.html","الطويل"],[9,"صحا القلب من ذكرى قتيلة بعدما","https://www.aldiwan.net/poem21967.html","الطويل"],[49,"أما إنه ربع الصبا ومعالمه","https://www.aldiwan.net/poem25132.html","الطويل"],[51,"نريد بقاء والخطوب تكيد","https://www.aldiwan.net/poem61203.html","الكامل"],[51,"ألا إن أبقى الذخر خير تنيله","https://www.aldiwan.net/poem63090.html","الطويل"],[42,"ألا أيها الربع الذي خف أهله","https://www.aldiwan.net/poem42340.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"رأيت قضاء الله أوجب خلقه","https://www.aldiwan.net/poem22113.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54885","البسيط"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[230,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[266,"اغمد شبا مرهفك الباتر","https://www.aldiwan.net/poem38276.html","السريع"],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[463,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[469,"ما نال من وصلكم بعض الذي وجبا","https://www.aldiwan.net/poem3498.html","عموديه"],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/203595","البسيط"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1810,"","https://poetry.dctabudhabi.ae/diwan/poem/31409","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95395","الوافر"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116643","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53149","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102504","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204921","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83383","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133098","الطويل"],[4802,"اعجاب","https://www.poetsgate.com/ViewPoem.aspx?id=34379",""],[5198,"نهر رقراق","https://www.poetsgate.com/ViewPoem.aspx?id=135801",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5759,"عودة الرَشاد","https://www.poetsgate.com/ViewPoem.aspx?id=213721",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["وَأَيُّ بَلاءٍ بِالمُقامِ لَدَيكُمُ","عَلى غَيرِ وَصلٍ إِنَّ ذا لَعَظيمُ",0,"م",1,0],["وَأَيَّ بَلاءِ الصِدقِ لا قَد بَلَوتُمُ","فَما فُقِدَت كانَت بَلِيَّةُ مُبتَلي",1,"ل",2,0],["وَأَيُّ بِلادِ اللَهِ لَم أَنتَقِل بِها","وَلا وَطِئَتها مِن بَعيري مَناسِمُه",2,"م",2,0],["وَأَيُّ بَني الأَيّامِ إِلّا وَعِندَهُ","مِنَ الدَهرِ عِلمٌ طارِفٌ وَتَليدُ",3,"د",1,0],["وَأَيُّ بَلاغٍ يُكتَفى بِكَثيرِهِ","إِذا كانَ لا يَكفيكَ مِنهُ قَليلُهُ",4,"ل",2,0],["وَأَيَّ بِلادِ اللَهِ حَلُّوا فَإِنَّني","عَلى العَهدِ راعٍ لِلخَليطِ المَزايِلِ",5,"ل",1,0],["وأَيُّ بَرِّيَّةٍ فيها بُيُوتُكُم","وَهلْ هِيَ الشَّعْرُ قولوا لي أَمِ المَدَرُ",6,"ر",1,0],["وَأَيَّ بَني الأَيّامِ يَحمَدُ قائِلٌ","وَمَن جَرَّبَ الأَقوامَ أَوسَعَهُم ثَلبا",7,"ب",2,0],["وَأَيُّ بَاقٍ عَلَى الأَيَّامِ نَطْلُبُهُ","وَكُلُّ وَارِدَةٍ يَوْمَاً إِلَى صَدَرِ",8,"ر",1,0],["وَأَيِّ بِكْرٍ تُزَفُّ أَحْرى","بِشَاعِرٍ مِنْ عَرُوسِ شِعْرِ",9,"ر",1,0],["وَأَيُّ بارِقَةٍ لِلمَجدِ صادِقَةٍ","لاحَت وَلَمّا تَشِمها هَذِهِ الشِيَمُ",10,"م",1,0],["وَأيَّ بَديلٍ له أَرتَضى","وَأَيَّ شَمائِلهِ أندُبُ",11,"ب",1,0],["واي بحث لم يكن باه","فيه طويلا ليس بالقاصر",12,"ر",1,0],["وأيُّ بُرْجٍ حَلّه رأْسُ عُلاً","قابَلَه بالطّبْعِ لا بُدَّ ذَنَب",13,"ب",1,0],["وأيبَسَ رَبعي وحدَه من سَحابةٍ","تبيتُ لمثلي من عَطاياه تَسْكُبُ",14,"ب",1,0],["وأيُّ بدعٍ لصبٍّ هزَّهُ شجنٌّ","إذا صبا نحو إلفٍ أو شكا وصبا",15,"ب",2,0],["وأي بيت يرى أهل الكساء له","أهلاً وينزل فيهم ربنا كتبا",16,"ب",2,0],["وأي بيت حظوا يوماً بفاطمة","أُمّاً لهم وعليٌّ ذي الإباء أبا",16,"ب",2,0],["وأيبسَ الضرع منه شؤم راحتهِ","من بعد إرسال رسلٍ منه منهمِل",17,"ل",1,0],["وَأَيُّ بِلادِ اللَهِ أَو أَيُّ قيعَةٍ","سَلَكتُ فَلَم أَسفِك بِعَرصَتِها دَما",18,"م",2,1],["وأي بطاطة لما أتتنا","كماة من أراضي المشرفيا",19,"ي",2,0],["وأَيُّ بَني الأَيَّامِ إِلا وعِندَهُ","مِن الد‍َّهرِ ذَنبٌ طَارِفٌ وتَلِيدُ",20,"د",1,0],["وأيّ بحر عماد الدين يتحفني","بدره فيرى سمعي له صدفا",21,"ف",2,0],["وأيّ باب إليه تصمد","حوائجي فاسمعوا حنيني",22,"ن",2,0],["وأي بديل أرتضيه بديلها","وكم طفت أبغيه وكم عدت بالياس",23,"س",1,0],["واي بلاد لا تراك اميرها","بربك سلها عن نداك تجاوب",24,"ب",1,0],["وأي بليغ أو خطيب يفي بما","نشته نواشي عصره في المسامع",25,"ع",1,0],["وَأَيُّ بِقاع الأَرضِ مِن بَعد طيبَةٍ","تَكونُ إِلى قَلبي أَحَبّ وَأَطيَبا",26,"ب",2,0],["وأي بلادٍ لم يمر بها البلا","وأي فضاءٍ سالمٌ عن أذية",27,"ه",1,0],["وأي بسمه في شفاهك ترسميها","منتهى أمن المولع والسلام",28,"م",1,0],["وايبست شلالٍ يشوق انسكابه","يعني على وصف العرب نهر رقراق",29,"ق",1,0],["وَأَيْبَسْتِ لَحْمِي فِي الهَوَى وَدَمِي مَعاً","وَلَمْ يَبْقَ إِلاّ أَعْظُمٌ فَوْقَها جِلْدُ",30,"د",1,0],["وأي بناء لا يضعضع صرحه","إذا كان منهار الدعامة والركن",31,"ن",1,0],["وائبَهْ بدهرِكَ قادِماً ولَئِنْ","ما العينُ تبصرْ أمسَها بِغدِ",32,"د",1,0],["وأي بلاد حلها حرم كذا","ك كل مكان ضمه دار طيبتي",33,"ت",2,0]]}