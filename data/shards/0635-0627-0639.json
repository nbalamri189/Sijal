{"poems":[[95,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[63,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142052","الخفيف"],[79,"يا هلالا يا قضيبا يا رشا","https://www.poetsgate.com/ViewPoem.aspx?id=34195",""],[458,"أرقصي أيتها الأضواء","https://www.aldiwan.net/poem61391.html","مجزوء الرمل"],[505,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[505,"ما للفؤاد بكم طرق","https://www.aldiwan.net/poem37946.html","مجزوء الكامل"],[519,"حيدري عم نائله","https://www.aldiwan.net/poem20843.html","المديد"],[519,"حيدري عم نائله","https://www.aldiwan.net/poem20849.html","المديد"],[563,"من لعبد بجسمه السقم بادي","https://www.aldiwan.net/poem34600.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38202","الرمل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31627","الخفيف"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202410","المنسرح"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44893","الخفيف"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105563","الرمل"],[396,"","https://poetry.dctabudhabi.ae/diwan/poem/133406",""],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95803","السريع"],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[5145,"مرحباً بالطالع المشتهر","https://www.poetsgate.com/ViewPoem.aspx?id=108067",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""]],"verses":[["صَاعَدَ النَّجْمَ ثُمَّ قَطَّرَهُ عَنْ","أَوْجِهِ حَادِثٌ مِنَ الدَّهْرِ حَاطِمْ",0,"م",1,0],["صاعد وابنه وما للخسيسي","ن وللمدح بالكلام النفيس",1,"س",1,0],["صاعِدَةٍ في مَعمَلٍ","مِن مَعمَلٍ مُنحَدِرَه",2,"ر",2,0],["صاعِقَةٌ رَعدُ بأسِها قَصِفٌ","وعَارِضٌ صَوْبُ مُزْنِه هَطِلُ",3,"ل",1,0],["صاعداً يرقى على سُلَّمهِ","دَرَجَ المجد ومرموقَ العلاءْ",4,"ا",2,0],["صاعداتٍ تلوك في شدقها الصخر","وترمي به صدورَ الشعابِ",5,"ب",1,0],["صاعدات أنفاسها هادئات","كصلاة الأطفال طهر شذاها",6,"ا",3,0],["صاع يوم البين قلبي فانجثى","بين أخفاف المطايا وانبشا",7,"ش",2,0],["صاعدا نحو السما","وات شهابا أو مهند",8,"د",1,0],["صاعَ العَزيزِ سَرَقْتهُ عُصبَةٌ","وها أَنا يُقالُ فيَّ السَّارِقُ",9,"ق",1,0],["صاعُ العَزيزِ بِرَحْلهِمْ","ولهُ الفُؤادُ قدِ انْطَلَقْ",10,"ق",1,0],["صَاعِدٌ تُخشَى نَوَازِلُهُ","ضَارِبُ الهَامَاتِ والقُلَلِ",11,"ل",1,0],["صَاعِدٌ تُخشَى نَوَازِلُهُ","عِندَ بَيتِ المَالِ صَاحِبُهُ",12,"ب",2,0],["صاعدات أنفاسها كدخان","منه يعلو الوجوه صبغ السواد",13,"د",1,0],["صاعِداً في فَرحٍ مُبتَسِماً","وَطَليقاً وَجهُهُ لَم يعبِسِ",14,"س",1,0],["صَاعِدٌ خَلْفَ صَاعِدٍ","نَازِلٌ خَلْفَ نَازِلِ",15,"ل",1,0],["صاع بصاع مثلها قبلا جرى","بالمكر من يعقوب مع لابان",16,"ن",1,0],["صاعقات الرصاص تشدو رعودا","ويذيب الجبال منها الصلاء",17,"ا",2,0],["صاعدكم للسما كهابطكم","بهذه الأنفس الوضيعات",18,"ت",1,0],["صاعِداً هابِطاً يَدُبُّ دَبيبا","فَرَأى الخَصم بَينَها وَالحَبيبا",19,"ب",2,0],["صاعِداً هالِكاً يَحَلِّقُ فَوقَ الن","نورِ وَالنّورُ آخذٌ في السُطوعِ",20,"ع",1,0],["صاعداً في مدرج الحق ولا","يعتريه عوجٌ عنه وصد",21,"د",1,0],["صاع من القوت للواحد إذا المال طال","عن مسكن الشخص والكسوه ودين الرجال",22,"ل",1,0],["صاعقةً أرسلها ربُّها","بِأرض سنجار على مَن بُلى",23,"ل",2,0],["صاعِداً من جيوشِهِ في إكامٍ","تَتَجَلَّى في البرِّ منها الاكامُ",24,"م",1,0],["صاعد الجد بعيد المنتهى","ناعم البال طويل العمر",25,"ر",1,0],["صاعقا في العرش ديك عظيم","حسن الصوت مليح الفتان",26,"ن",1,0]]}