.dctabudhabi.ae/diwan/poem/35568","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107482","المتقارب"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81250","المجتث"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127932","الكامل"],[4578,"عُرب اللوى عن عهود الود قد حالوا","https://www.poetsgate.com/ViewPoem.aspx?id=49505",""],[4888,"يحتلني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=207748",""],[4888,"حسرة على العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=207764",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5150,"أم الدنيا .. مصر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202872",""],[5216,"إهداء إلى سائح","https://www.poetsgate.com/ViewPoem.aspx?id=187001",""],[5273,"نداء","https://www.poetsgate.com/ViewPoem.aspx?id=28772",""],[5449,"موسوعةُ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=188935",""],[5493,"إعدام أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=197210",""],[5616,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=203490",""],[5725,"رهطي اعز به","https://www.poetsgate.com/ViewPoem.aspx?id=213595",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5753,"أنا والليل","https://www.poetsgate.com/ViewPoem.aspx?id=210864",""],[5830,"وَ حََقّاً إِنَّنِي خَجِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=200773",""],[6075,"لِلْحُبِّ عَاشَ","https://www.poetsgate.com/ViewPoem.aspx?id=213326",""],[6093,"إلاَّا القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178563",""],[6115,"زلة الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180512",""],[6202,"يا مصر لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86769&r=&rc=70",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""],[433,"رحلة النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87052&r=&rc=5",""]],"verses":[["والنَّيِّراتُ طَوالِعٌ رَأْدَ الضُّحى","نُفِضَتْ على صَفَحاتِها الظَّلْماءُ",0,"ا",2,0],["وَالنيلَ لا تَرقُصُ أَمواهُهُ","فَرحى وَلا يَجري بِها الأَبطَحُ",1,"ح",1,0],["وَالنيلُ مِرآةٌ تَنَف","فَسَ في صَحيفَتِها النَسيمُ",2,"م",1,0],["وَالنيلُ يَجري تَحتَها مُتَهَلِّلاً","وَالمَوجُ بَينَ مُهَلِّلٍ وَمُصَفِّقِ",3,"ق",1,0],["والنيل من شرف العروبة منهل","جلّت موارده عن الترنيق",4,"ق",1,0],["وَالنيبُ إِن تَعرُ مِنّي رَمَّةً خَلَقاً","بَعدَ المَماتِ فَإِنّي كُنتُ أَثَّئِرُ",5,"ر",1,0],["والنيل عند الظن غاية جريه","ونداك من فوق الظنون إذا جرى",6,"ر",2,0],["والنيل في الواديى نجاشىّ مشى","في ركبه الرؤساء والأحبار",7,"ر",1,0],["والنيل حياة دافقة","ونعيم عذب مورِده",8,"د",2,0],["والنيِّرات من السحاب مُطِلَّةٌ","كالغِيد من سِتْرٍ ومن شُبّاكِ",9,"ك",1,0],["وَالنيلُ يُقبِلُ كَالدُنيا إِذا اِحتَفَلَت","لَو كانَ فيها وَفاءٌ لِلمُصافينا",10,"ن",2,0],["والنيران اثنان رقّتهما","إلى الكمال الانجم الخمسُ",11,"س",1,0],["وَالنَيلُ دَينٌ يُستَرَقُّ بِهِ","فَاِطلُب لِرِقِّكَ عِندَ مَن تَدَعُه",12,"ع",2,0],["والنيل نهركم وما","زان الخميلة والفنن",13,"ن",1,0],["والنّيلُ من هَوْلِ الفِراقِ كأنّما","يَسْقِي البلادَ دماً ويقذفُ نارا",14,"ر",2,0],["والنّيلُ لولا رَجاءُ الله يمنعهُ","طغتْ عليه عوادي الهمِّ فاستعرا",15,"ر",2,0],["وَالنيلُ خِصبٌ في القُرى مُتَدَفِّقٌ","وَالزَرعُ مِنهُ قائِمٌ وَحَصيدُ",16,"د",1,0],["وَالنيلُ إِن حَمَلَ القَذى وَإِذا صَفا","فَهوَ الحَياةُ وَوِردُها المَورودُ",16,"د",1,0],["وَالنِّيلُ يُذكِرُني كَرِيمَ بَنانِهِ","فأُطِيلُ مِن شَوقِي لهُ التَّقبِيلا",17,"ل",2,0],["وَالنيرانِ المُواصِلانِ سَناً","إِن نَلهُ في أَرضِنا فَما لَهَوا",18,"ه",3,0],["والنيل يجري هادئاً والنسيم","معربدٌ في الخُصَل الثائره",19,"ه",1,0],["والنِّيلُ سَارَ يَجُرّ مِنْ أَذْيالِهِ","تِيهاً ويَمْرَحُ في مَدَى خُيَلاَئه",20,"ا",3,0],["والنِّيلُ يَجْتازُ المُروجَ مُبشِّراً","فتُرددُ الأطْيَارُ مِنْ أَصْدائه",20,"ا",3,0],["والنِّيلُ لم يَشْهدْ جَلاَلةَ حَفْلِه","في عَهْدِ خَفْرعهِ ولا مِينَائه",20,"ا",3,0],["وَالنيلُ منكَ فلو بَكْيتَ لفادحٍ","غَمَر الشُّطوطَ بدمعِه النضّاح",21,"ح",1,0],["وَالنيلُ يَنْسَابُ تِيهاً","بَيْنَ الْمُرُوجِ انْسِيَابَا",22,"ب",2,0],["والنيرات جيران","يكاد يأتي العطشان",23,"ن",1,0],["والنيل يعصر للمحتَلِّ كرمتَهُ","وسادةُ النيل للمحتل عُبْدان؟",24,"ن",1,0],["والنّيْلُ دَيْنٌ يُسْترَقّ بِهِ،","فاطْلُبْ لرِقْكَ عندَ مَنْ تَضَعُهْ",25,"ع",2,0],["والنيل نهركم وما","زان الخميلةَ والفتنْ",26,"ن",1,0],["وَالنيربان عَلى مَعاهد انسنا","يَتَباكيان بِأَدمُع الغُدران",27,"ن",1,0],["والنيل خاطبته فانجر ممتثلا","يجري وامضى الذي امضيته القدر",28,"ر",1,0],["والنّيلُ تَمَوَّجَ أَضواءً","يَزهو بِالعِشقِ وبالطَّرَبِ",29,"ب",1,0],["والنيل أجراه مجريه للذتنا","من حولنا فلنا عرشٌ على الماء",30,"ا",2,0],["والنيل يجري كما نجري لغايتنا","وكل شيءٍ من الدنيا إلى أجل",31,"ل",1,0],["والنيلُ مثلُ عِمامةٍ","نُشِرتْ مُحشّاةً بأَخْضَرْ",32,"ر",1,1],["والنيلُ يحشُو حَشا الخليجِ وقد","كَساه زهرُ الربيعِ بإسْتَبْرَق",33,"ق",1,0],["والنيلُ مذ نسبوهُ للأميرِ جرى","ينافرُ السينَ والتاميزَ في النسبِ",34,"ب",1,0],["والنيل سكران صاحٍ","مثل العيون الكسيره",35,"ه",1,0],["والنيل مسترسل شحيح","كأنه الكوثر الخصر",36,"ر",1,0],["وَالنيلُ لم يَبرَح على العهدِ الذي","أخَذَته قبلُ عليه ناضِرَةُ القُرى",37,"ر",2,0],["والنِّيلُ قد حاربَ رِيحَ الصَّبا","ثمّ تَبدَّى لابِساً جَوْشَنَهْ",38,"ن",2,0],["والنّيلُ في رونَقِ شمسِ الضحا","سيفٌ صَقيلُ المتنِ مسلولُ",39,"ل",1,0],["والنيل حلّ به ما حلّ من كربٍ","كم من مصائب قد حلّت بواديه",40,"ي",2,0],["والنِّيلُ كَمْ حَسَدَ القاضِي على مَلِكٍ","تَصوَّرَ الجُودُ فيهِ بَلْ هُوَ الجُودُ",41,"د",1,0],["والنيل مندفع كاللحن أرسله","من المزامير إحساس ووجدان",42,"ن",1,0],["والنيّران وإن هما اختلفا","فالشمسُ لا تُرتابُ بالبدرِ",43,"ر",1,0],["والنيل منقذ الأديم عليكم","حاشا رضاك بسيفه المقدود",44,"د",1,0],["وَالنَيّران أَطاعاهُ فَتِلكَ بَدَت","بَعدَ الأُفولِ وَهَذا شُقَّ في الظُلَمِ",45,"م",1,0],["والنِّيْلُ مُسْتَكْمِلٌ زِيَادَتَهُ","مِثْلَ دُرُوعِ الكُمَاةِ مُنْتَثِرَهْ",46,"ر",2,0],["والنيل باليمن يسري في جوانبه","كأنه السعد يجري حول مسعود",47,"د",1,0],["والنيل منتحب يقول رزيئتي","فدحت فيا ليت الردى مشلول",48,"ل",1,0],["والنيل يجري في زبرجد أرضها","متسلسلا برياضها الفيحاء",49,"ا",2,0],["والنيل تخصب كل أرض تسقى","منه وصدري بالولا لك قد خصب",50,"ب",1,0],["والنيل يخزن ماؤهُ حتى إذا","شحَّ السحاب بفيضه كان البديل",51,"ل",1,0],["وَالنيل أَنتَ بمصر جابر دائِماً","لِحياتها بِإِرادة الرَحمَن",52,"ن",1,0],["وَالنيل فيهِ سَفينة الأَفراح قَد","حَلّت فَأَشرَق وَجهُه بِضِياء",53,"ا",2,0],["وَالنيل فاض وَعَن قَريب يَرتَوي","مِنهُ بِحيرةُ قطرها وَصَعيد",54,"د",1,0],["وَالنيل يَلطُم وَجهَهُ","حَسَداً بكفِّ الموجِ لَطما",55,"م",2,0],["والنيل تقسمه سخيّاً عادلاً","في كل معمور وكل خلاء",56,"ا",2,0],["والنيل فياض زلالاً سائغاً","والأرض مخرجة شهيَّ الزاد",57,"د",1,0],["والنيل بين يديك يجري سلسلاً","والعيش رغد في زمانك ناعم",58,"م",1,0],["والنيل إن لم يجرِ باسمك وحده","في سائر الوادي جرى مسموما",59,"م",2,0],["والنيل من قدم زلال سائغ","ولقد يكون لمترف جربالا",60,"ل",2,0],["والنيل وهو يود لو يجري إلى","أخويه دجلة والفرات قراحا",61,"ح",2,0],["والنيل تابعكم في كلِّ ناحيةٍ","منه تمدون أنهاراً بأنهار",62,"ر",1,0],["والنيل أجراه في واديه خالقه","إن شاء أطلقه حراً أو اختزنا",63,"ن",2,0],["والنيل مطَّرِدٌ عذبٌ نتيه به","على الفرات وسيحان وجيحان",64,"ن",1,0],["والنيل يخطب والأهرام مصغية","كأن للنيل والأهرام وجُدانا",65,"ن",2,0],["والنيل موف للبلاد فلو جرى","في غير واديه لعاد غماما",66,"م",2,0],["والنيل لو ملكت أعنته جرى","خلف القلوب مودة وحنينا",67,"ن",2,0],["والنيلُ يجري فوقَ رض","راضٍ من الجَزْعِ الظُّفاري",68,"ر",2,0],["وَالنيل مِن جَدواك في زِياده","يرفل في مَلابس السَعادَه",69,"ه",1,0],["والنَّيِّرُ الأعْلَى الإمَامُ المُرْتَضَى","ذُو المبسمِ الوَضَّاحِ وَالوَجْهِ الأغَرْ",70,"ر",1,0],["وَالنيلُ أَحيى أَرضَ مَصرَ بِجودِهِ","فَاِمتَدَّ فَوقَ مُروجِها الفَيضانُ",71,"ن",1,0],["والنيل وسيحان العليا","طراً والبحر من الجملهْ",72,"ل",2,0],["والنيل من اسف تمنى لو جرى","للشرق تعزية لقلب فراته",73,"ت",2,0],["والنيل صفَّق والهزار شدا","ونضال العذار وأينع الزهرُ",74,"ر",1,0],["وَالنَيلُ نالَ بِهِ الخليفَةُ فَتحَ ما","قَد كانَ قَبلُ أَصَمَّ في عَمياءِ",75,"ا",2,0],["والنيل أكرم من قضين حقوقه","ورعين في أهليه كل ذمام",76,"م",1,0],["والنيل دمع الباكيات جرى","في الواديين كأنه نهر",77,"ر",1,0],["والنيل في ثوب المخيلة بينها","يسطو على جنباتها ويصول",78,"ل",1,0],["والنيلُ فاض من السرورِ وَأهلُهُ","بِهِمُو إلى مرأى العزيزِ هُيَامُ",79,"م",1,0],["والنيلُ في أحشائها","عقد يلوحُ مجوهرُ",80,"ر",1,0],["والنِّيلُ من طربِ المسرَّةِ ماؤُهُ","رَوَّى بلذَّتهِ القُلُوبَ وأسكرا",81,"ر",2,0],["والنَّيِّران المُشرِقان مُحَمَّدٌ","وأَبو السعود وصِنْوهُ المحروسُ",82,"س",1,0],["وَالنَيِّراتُ إِذا مَدَدتُ لَها يَدي","تكُن الفَرائِدَ لِلعُقودِ وَأَنظُمُ",83,"م",1,0],["وَالنيلُ وَالوادي وَما يَحبوهُما","مِن رَوعَةٍ وَجَلالَةٍ هَرَماها",84,"ا",3,0],["والنّيلُ سارَ على وفاءِ وِدادِهِ","زَفَّ البَشائِرَ في مَدَى مَجْراهُ",85,"ا",2,0],["والنيل وافاء النسيم مبشرا","فأتى يقبل موطئ الأقدام",86,"م",1,0],["وَالنيرات كَسَتهما سَطعاته","هوَ ذَلِكَ النُور الَّذي لَمعاته",87,"ه",1,0],["والنيك خذ لا تسل يغشى علي لذا","من شدة الشهو أخرى في السراويل",88,"ل",1,0],["والنيرب الأعلى محل الأنس","كذلك الأدنى حياة النفسِ",89,"س",1,0],["وَالنيلُ لَمّا أَن رَكِبتَ عُبابَهُ","أَجرَيتَهُ مِنَناً فَفاضَ وَعَمَّنا",90,"ن",2,0],["والنيل يبدي لبشنس شحه","وفيضه يحظى به أبيب",91,"ب",1,0],["والنير قل جبل بوسط بحيرة","يسمى بطوما أحمر ذو شعلة",92,"ه",1,0],["والنيل قد بادرَت زيادَتُه","كأنّه قد أطلق من حبسَ",93,"س",1,0],["والنيل يجري هادئاً","حينا وحينا يزخرُ",94,"ر",1,0],["وَالنيلُ بين يديك يَلمَعُ وجهُهُ","متبسِّماً ولكفِّه تَصفيقُ",95,"ق",1,0],["والنيل قُل ما شئت في تعظيمهِ","نهر جرى كي يدرك الابحارا",96,"ر",2,0],["والنيل يجرى فوق صفحته","تتكسر الأضواء والبدر",97,"ر",1,0],["والنيّرين الشهيدين ابنها حسن","إذا قال للمُلك إن السم في الدسم",98,"م",1,0],["والنيل يجري بالمسرة مذ رأى","تاريخ قنطرة بعز جدَّتِ",99,"ت",1,0],["والنيل يجري بالدعاء مؤرخاً","جمع الثواب ليمن باني القنطره",100,"ر",2,0],["والنيلُ كوثرها الشهيُّ شرابه","لأبرُّ كل البر في أيمانِي",101,"ن",2,0],["والنّيِّرانِ في ظلامِ الدُّجى","جَبينُهُ المُشْرِقُ والكَوْكَبُ",102,"ب",1,0],["وَالنيلُ مضطَرِبُ الغَوارب مزبدٌ","صَبٌّ إلَيك فُؤاده متشوِّقُ",103,"ق",1,0],["والنيل مصطفق كمن","قد هزه فرط السرور",104,