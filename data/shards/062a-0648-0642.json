َذِر","https://www.poetsgate.com/ViewPoem.aspx?id=207507",""],[5431,"ياقيسُ ليلاكَ قد عادت بلوعتها","https://www.poetsgate.com/ViewPoem.aspx?id=186644",""],[5431,"تراود منك الروح حتى تُسلّما","https://www.poetsgate.com/ViewPoem.aspx?id=196983",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5499,"الحوبه","https://www.poetsgate.com/ViewPoem.aspx?id=177548",""],[5547,"ومرضعة بثدي الغمام رف","https://www.poetsgate.com/ViewPoem.aspx?id=187147",""],[5582,"أَتَعْرِفُ أَطْلالاً لِهِنْدٍ غَوارِثَا","https://www.poetsgate.com/ViewPoem.aspx?id=186765",""],[5582,"جَفا جَفْنَهُ يَوْمَ الفِراقِ رُقادُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186903",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5582,"ستبدي خفيّات الأمورِ العواقبُ","https://www.poetsgate.com/ViewPoem.aspx?id=63465",""],[5582,"أَساكِنَةً وادِي الأَراكِ أَراكِ","https://www.poetsgate.com/ViewPoem.aspx?id=63551",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5732,"انا من نجد يكفيني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=177852",""],[5841,"الصراحة","https://www.poetsgate.com/ViewPoem.aspx?id=34956",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[6056,"رحيق الذات","https://www.poetsgate.com/ViewPoem.aspx?id=130317",""],[6082,"فلَة","https://www.poetsgate.com/ViewPoem.aspx?id=59817",""],[520,"أصبح عبد الحضرة العاليه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577687",""],[406,"استنكار ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1118&r=&rc=62",""],[463,"إذا لم يرعَ عندكم الودادُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60017&r=&rc=73",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""]],"verses":[["تَوَقَّعي أَن يُقالَ قَد ظَعَنا","ما أَنتِ لي مَنزِلاً وَلا سَكَنا",0,"ن",2,1],["تَوَقَّعوها فَقَد شَبَّت بَوارِقُها","بِعارِضٍ كَصَريمِ اللَيلِ مَدجونِ",1,"ن",1,0],["تَوَقَّصَ تَحتَها القُلَلُ الرَوابي","وَتَجدَعُ مِن حَوافِزِها الإِكامُ",2,"م",1,0],["تَوَقَّرَ مِن عُنفِ السِياطِ مِراحُها","وَغاضَ عَلى طولِ القِيادِ صَهيلُها",3,"ل",3,0],["تُوَقَّعُ يَومَ الوَغى بِالنَجيعِ","وَتُنعَلُ بَينَ الفَنا بِالقِلالِ",4,"ل",1,0],["تَوَقُّلاً في بِناءٍ غَيرِ مُنتَقِضٍ","مِنَ المَعالي وَظِلٍّ غَيرِ مُنتَقِلِ",5,"ل",1,0],["تَوَقُّعُ أَمرٍ زادَ هَمّاً وُقوعُهُ","وَإِنَّ وُقوعَ الأَمرِ دونَ التَوَقُّعِ",6,"ع",1,0],["تَوَقَّعوا طَلاعَها","كَناغِرِ العِرقِ نَغَر",7,"ر",1,0],["تَوَقَّرُ جاشَكَ الأَهوالُ فيهِ","إِذا اِعتَلَجَ الجَبانُ بِهِ اِعتِلاجا",8,"ج",2,0],["تَوَقَّرَ أُزْرُها شِبَعاً فَقَرَّتْ","وَطاشَ وِشاحُها غَرَثاً فَجالا",9,"ل",2,0],["تُوقِرُهُ وِزْراً ولا يَصْحَبُ مَنْ","أُلْقيَ في ضَريحِهِ إلا التُّقى",10,"ا",1,0],["توقّفوا كارْتِدادِ الجَفْنِ وانصَرَفوا","كما طَرَدْتَ حِذارَ الغارَةِ النَّعَما",11,"م",2,0],["توَقّلْتَ أهْضابَ الجَلالِ وأحْرَزْتَ","لكَ الحمْدَ آباءٌ كِرامٌ وأجْدادُ",12,"د",1,0],["تُوَقِّذُ قَولي كَي تُوَلِّهَ حاجَتي","وَبَعضُ الكَلامِ لِلكَلامِ مَواقِذُ",13,"ذ",1,0],["توقِّع حولي تارة وتصيبني","بنبل الأذى عفواً جزاها حسيبها",14,"ب",3,0],["توقَّد ذهناً واسْتفاضَ مكارماً","فأعلم أن الشهبَ بالغيث تهمع",15,"ع",1,0],["تَوقِّي الداء خيرٌ من تَصَدٍّ","لأيسرِهِ وإن قَرُبَ الطبيبُ",16,"ب",1,0],["توقَّد فيها كلما تَلَّعَ الضحى","مصابيحُ تذكو حين تخبو المصابحُ",17,"ح",1,0],["تَوقَّد في الكاسات نور شعاعها","ومن عجب ماء توقَّد كالجمر",18,"ر",1,0],["توقّعْ لبغدادَ إذْ ساسها","زِفافاً فقدْ أصبحَتْ مُمْلكهْ",19,"ك",2,0],["تَوَقّى بِأَطرافِ القِرانِ وَعَينُها","كَعَينِ الحُبارى أَخطَأَتها الأَجادِلُ",20,"ل",1,0],["تَوَقَّ الأَذى مِن كُلِّ رَذلٍ وَساقِطٍ","فَكَم قَد تَأَذّى بِالأَراذِلِ سَيِّدُ",21,"د",1,1],["تَوَقَّهُ فَمَتى ما شِئتَ تَبلُوَهُ","فَكُن مُعادِيَهُ أَو كُن لَهُ نَشَبا",22,"ب",2,0],["تَوَقَّعُني الدارُ الشَطونُ أَحُلَّها","وَيَبهَجُ بي أَهلُ البِلادِ أَزورُها",23,"ر",3,0],["تَوَقُّعُ الكُرهِ إِزدِيادٌ إِلى","عَذابِ مَن يَرقُبُهُ لا الوُقوع",24,"ع",1,0],["تَوَقَّعُ أَن يَحتَلَّها دَرَجَ العُلا","كَما اِنتَظَرَت أَوبَ الهِلالِ مَنازِلُه",25,"ل",2,0],["تَوَقُّوا النِساءَ فَإِنَّ النِساءَ","نَقَصنَ حُظوظاً وَعَقلاً وَدينا",26,"ن",2,1],["تَوَقَّ مَدى الأَيامِ إِدخالُ مَطعَمٍ","عَلى مَطعَمٍ مِن قَبلِ هَضمِ المَطاعِمِ",27,"م",1,1],["تَوَّقَ مِمّا تَأتي وَما تَذَرُ","جَميعُ ما أَنتَ فيهِ مُعتَذَرُ",28,"ر",1,1],["تَوَقَّ يَداً تَكونُ عَلَيكَ فَضلاً","فَصانِعُها إِلَيكَ عَلَيكَ عالِ",29,"ل",1,0],["توق حدود الله لا يأت محرما","إذا شئت أن تحظى بجناته العليا",30,"ي",2,1],["توق سبعة أيام قد اطردت","في كل شهر هلالي مناحسها",31,"س",3,1],["تَوَقَّ مِنَ الناسِ فُحشَ الكَلامِ","فَكُلٌّ يَنالُ جَنى غَرسِهِ",32,"ه",1,1],["تَوقَّدَ في كفِّ المنادم نورها","ولكنه بالشرب في فمه انطفا",33,"ف",2,0],["توَقّدَ إقداماً وفاض سماحةً","وهُذّبَ أخلاقاً وطاب نصابا",34,"ب",2,0],["تَوَقَّينا الشَماتَةَ مِن أُناسٍ","ذَوي ضَغنٍ فَما نَفَعَ التَوَقّي",35,"ق",2,0],["تَوَقَّى القومُ صَوْلَتَهُ فَضَنُّوا","بِأنْفُسِهِم وجَادوا بالفِرارِ",36,"ر",1,0],["توقَّتها فَزارةُ وهْيَ حَتْمٌ","فما عصمتْ مقاتِلَها التُّقاةُ",37,"ه",1,0],["تَوَقَّدَ ذِهناً حينَ سالَ سَماحَةً","كَما شَبَّ بَرقاً حينَ فاضَت هَواطِلُه",38,"ل",2,0],["تَوَقَّدَ فيها النورُ مِن كُلِّ جانِبٍ","وَبَلَّلَها طَلٌّ مَعَ اللَيلِ دامِعُ",39,"ع",1,0],["تَوَقَّعوا السَيلَ أَوفى عارِضٌ وَلَهُ","في العَينِ بَرقٌ وَفي الأَسماعِ إِرعادُ",40,"د",1,0],["تَوَقَّع بَعدَ هَذا الغَيِّ رُشداً","فَمِن بَعدِ الظَلامِ ضِياءُ فَجرِ",41,"ر",1,0],["تَوَقوا سَبيلَ الغانِياتِ فَكُلُّها","كَلَيثِ الشَرى وَالطَيِّبُ فيها فُرانِقُ",42,"ق",1,0],["تَوَقَّعوا مِن دَهرِهِم عَدلَهُ","وَالدَهرُ لا يُحسِنُ أَن يَعدِلا",43,"ل",2,0],["تَوَقَّ النِساءَ عَلى عِفَّةٍ","لِيَجزِيَكَ الواحِدُ القَيِّمُ",44,"م",1,1],["توقفت لا أدري تجاه الحقائق","أأني خلقت أم هو خالقي",45,"ق",2,1],["توقف عنه الشعب يطلب دافِعاً","وإن اِحتياج الشعب أكبر دافع",46,"ع",1,0],["توقه؛ فإذا ما شئت تبلوه","فكن معاديه أو كن له نشبا",47,"ب",2,0],["تَوَقّى البُدورٌ النقصَ وهْيَ أهِلَّةٌ","ويُدْرِكُها النّقْصانُ وهْيَ كوامل",48,"ل",1,0],["تَوَقّتْكَ سِرّاً وزارَتْ جِهارا","وهلْ تَطْلُعُ الشمسُ إلاّ نهارا",49,"ر",2,1],["توقِظُ الروضَ من كراهُ وتجلو","بسماتِ الضحى على زهراتِه",50,"ت",2,0],["توقدّى فى خاطرى وصَفّقى وغَرّدى","تستيقظ الأحلام في نفسى وتسقيها يدى",51,"د",2,0],["تَوَقَّدَ في جَوِّ السَماءِ كَأَنَّما","تَشَقَّقَ عَنهُ في الظَلامِ جُيوبُ",52,"ب",1,0],["توقِّعُ باليمنى صكوك انعتاقِها","وتُومي لها اليسرى بأن لا تصدِقي",53,"ق",2,0],["تَوَقَّعُ أنْ يَحْتَلّها دَرَجُ العُلَى،","كما انتَظَرَتْ أوْبَ الهِلالِ مَنَازِلُهْ",54,"ل",2,0],["تَوَقعت مُقلَتي خَيالاً","فَعزَ مِن ذاكَ ما تَروم",55,"م",1,0],["توقد دون الضلوع نارا","طعامها النفس والجسوم",56,"م",1,0],["تُوقُ نَفُوسُ أسوِئِكِم مَسَاوي","ِإلَى فِعلاَتِهِم فَتَكُونَ فِينَا",57,"ن",2,0],["تُوقَدُ النارُ في الظَلامِ وَلَكِن","لَيسَ يَجلو الهَزِيعَ كَاِبنِ ذُكاءَ",58,"ا",2,0],["تَوَقَّلتَ في تِلكَ الهِضابِ فَحُزتَها","عَلى أَنَها لَولاكَ لَم تَكُ تُعبَرُ",59,"ر",1,0],["توقع للهلاكِ فقد تداني","وقد نبتت على النمل الجناحُ",60,"ح",1,0],["توقّ فخزّان الكلام قليلُ","وأكثر أقوال السفال فضول",61,"ل",1,1],["توقر عن ملاعبة الجواري","وشرّ خلائق الوقار",62,"ر",1,0],["توقعت ما صرنا إليه ومن يجد","كوجدي بكم ترفع له سدف السر",63,"ر",1,0],["توقد عينيه لهول أوارها","فتنفر خوفا من أذاه وترتد",64,"د",1,0],["توقظ الماضِيَ وَالماضي خَطايا","حينَ أَشرَفتِ عَلى قَلبي اِمَّحَت",65,"ت",1,0],["تَوَقَّدُ نارُ الغَيظِ بَينَ ضُلوعِهِ","وَلَكِنَّها نارٌ بِغَيرِ دُخانِ",66,"ن",1,0],["تَوَقَّ الشَّرَّ لاَ تَضْرِمْ لَظَاهُ","فَشَرُّ النَّاسِ مَنْ لِلشَّرِّ سَاخِ",67,"خ",1,0],["تَوَقَّلْتُ أَنْجَادَ الصَّبَابَةِ في الصِّبَا","وَخُضْتُ بِحَارَ الْحُبِّ وَهْيَ حَوَافِلُ",68,"ل",1,0],["توقد العزم منه والندى غدقا","كالصارم العضب فيه الماء والنار",69,"ر",1,0],["توقت لعلياك ويه شاردة","فانجذبت نحوها بلا مسد",70,"د",1,0],["توقَّلَ عبد الله فيها ولم يكن","يزاحمه فيها امْرُؤٌ غيرُ أحمقِ",71,"ق",1,0],["توقَّ أَخا الغرام رُضابَ فيها","فَكَم شقَّت حلاوتُها مَرارَه",72,"ر",2,0],["توقد جمرُ القلب عند تغزلي","فمن أجل هذا قد أتى جيد السبكِ",73,"ك",1,1],["توقر لدى كل المحاقل جالسا","توق بها من شبك اصبوع أحضان",74,"ن",1,0],["تَوقّى لَفح هاجرةٍ بأيكٍ","يُسرهِدها كما حضنَ الوليدُ",75,"د",1,0],["تَوَقَينا وَمَنزِلَنا جَميعاً","أَمامَ الخَيلِ بِالسَمرِ الثِقافِ",76,"ف",1,0],["تَوقّفَ العارِضُ الهَطّالُ مُنتظراً","وُرُودَ موكبه العالي مَراقيه",77,"ي",2,0],["توقيعُه في الكُتْبِ من أقلامِه","يُغْنِى الكتائبَ عن شهودِ وَقائع",78,"ع",1,0],["تَوقيعُه أبداً له تَفْسيرُه","في كُلّ يَومِ تَخاذُلٍ وتَواس",79,"س",1,0],["تَوَقَّ اِبتِداءَ الأَمرِ قَبلَ اِنتِشارِهِ","وَحاذِر شَرارَ النارِ مِن قَبلِ أَن تَسري",80,"ر",2,0],["توقَّ إذا ما حُرمة العدل جلَّتِ","ملامي لتقضي صَبوتي ما تمنَّتِ",81,"ت",1,1],["توقَّ يا من غدا بالعلم متصفاً","من شهوةٍ شوَّهت سلمانَ في الأمم",82,"م",1,0],["توقَّل في علياكَ شمسٌ منيرةٌ","ولا غروَ أن كانت بأُفْقك تطلع",83,"ع",1,0],["توقَّفَتْ ريشتي طال الوجومُ به","حتى تخيَّلْتُ رأسَ الرِّيشةِ انكسرا",84,"ر",2,0],["تَوَقَّ مِنَ اللَّيالي واجْتَنِبْها","فإنَّ نَعِيمَها دُونَ الرَّزايا",85,"ي",2,1],["تَوَقَّ خِلافاً إنْ سمحْتَ بمَوعدٍ","لِتسلَمَ مِن هَجْوِ الورى وتُعافى",86,"ف",2,1],["توقَّ مُعاداةَ الرِّجالِ فإنَّها","مُكَدِّرَةٌ للصَّفْوِ من كُلِّ مَشرَبِ",87,"ب",1,1],["تَوَقَّ عُيون الغانِيات فَإِنَّها","سُيوف وَأَشفار الجُفون شِفارُها",88,"ر",3,0],["توقَّع الخوفَ ممَّن أنت آمِنُهُ","قد تنكأُ الكَلْمَ كفُّ الآسِيِ الرّفِقِ",89,"ق",1,0],["توقَّدَتِ النَّار في جوانحي","إلى ساكني وادي الغضا أيّما وقد",90,"د",1,0],["توقُع الرَّوض ما تسديه غادية","أناخ كلكلها ليلاً بذي بقر",91,"ر",1,0],["توقَّد في حشا الظلماء حتَّى","وجَدنَا منه في الأحشاء وقدا",92,"د",2,0],["تَوَقَّدَتْ فَلَوَانَّ المَرْءَ يُنْشِدُها","في شهرِ كانُونَ ظنُّوا آبَ قَدْ آبَا",93,"ب",2,0],["توقّل في هضب العلى فعلا على","بني الدهر من تشييد مجد وسؤدد",94,"د",1,0],["تَوَقَّى فأَبْلى عُذْرَ نَاجٍ مُخاطِرٍ","فَرَدَّ المنايا عنهُ مُبْلِيَةَ العُذْرِ",95,"ر",1,0],["توقدَ زهرُه جمراً لدينا","وتلك لها من الجمر التقامُ",96,"م"