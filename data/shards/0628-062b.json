{"poems":[[63,"أما وحبيك هذا منتهى حلفي","https://www.aldiwan.net/poem46124.html","البسيط"],[57,"أأنثر درا بين سارحة البهم","https://www.aldiwan.net/poem24639.html","الطويل"],[77,"يا ابن الخلائف يا سمي محمد","https://www.aldiwan.net/poem36507.html","الكامل"],[73,"قد أحسن الله في الذي صنعه","https://www.aldiwan.net/poem11972.html","المنسرح"],[93,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[30,"وميتة في الأرض إلا حشاشة","https://www.aldiwan.net/poem29469.html","الطويل"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[72,"بث المشيب على الشجي بزاته","https://www.aldiwan.net/poem18390.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"إن المنية لا تبقي على أحد","https://www.aldiwan.net/poem10865.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[32,"يا بثن حيي أو عديني أو صلي","https://www.aldiwan.net/poem27740.html","الرجز"],[32,"بثغر قد سقين المسك منه","https://www.aldiwan.net/poem27752.html","الوافر"],[32,"بثينة قالت يا جميل أربتني","https://www.aldiwan.net/poem27757.html","الطويل"],[32,"بثينة من صنف يقلبن أيدي","https://www.aldiwan.net/poem27771.html","الطويل"],[32,"خليلي إن قالت بثينة ما له","https://www.aldiwan.net/poem27773.html","الطويل"],[32,"أنخت جديلا عند بثنة ليلة","https://www.aldiwan.net/poem27774.html","الطويل"],[89,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[89,"بثوا بألسنة لكم من نار","https://www.aldiwan.net/poem44922.html","الكامل"],[85,"أخذت السماء يا دار ركنا","https://www.aldiwan.net/poem7106.html","الخفيف"],[85,"بثثت شكواي فذاب الجليد","https://www.aldiwan.net/poem63673.html","السريع"],[45,"أصبا الأصائل إن برقة منشد","https://www.aldiwan.net/poem63446.html","الكامل"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[28,"فأغلق من وراء بني كليب","https://www.aldiwan.net/poem4952.html","الوافر"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[66,"بثلاث واوات وشين بعدها","https://www.aldiwan.net/poem38544.html","الكامل"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[44,"لامته لام عشيرها وحميمها","https://www.aldiwan.net/poem30348.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"باسم إله الخلق هذا ما اشترى","https://www.aldiwan.net/poem27989.html","الرجز"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[105,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[105,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[81,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[50,"ظل اليسار على العباس ممدود","https://www.aldiwan.net/poem63880.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55015","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54994","الكامل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[77,"يا ابن الخلائف يا سمي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=34090",""],[90,"في الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178935",""],[94,"الكنز المقدّس","https://www.poetsgate.com/ViewPoem.aspx?id=15624",""],[32,"يا بثنَ حييّ، أو عديني، أو صلي","https://www.poetsgate.com/ViewPoem.aspx?id=15995",""],[32,"خليلي إن قالت بثينة ماله ..","https://www.poetsgate.com/ViewPoem.aspx?id=124",""]],"verses":[["بَثَّ المَواهِبَ حتى ضمَّ نائِلُهُ","منَ المَحامِدِ شَمْلاً غيرَ مُؤْتَلِفِ",0,"ف",1,0],["بَثَثتُ مُفيداً وَاِستَفَدتُ وِدادَهُم","وَإِلّا فَمَكنونٌ لَدَيَّ وَمُكتَتِم",1,"م",1,0],["بثَرَى جُدودِكَ قد وضَعْتُ حَقيبَتي","فوَسيلَتي لعُلاكَ نورٌ باهِرُ",2,"ر",1,0],["بَثَثتَ فيهِ البَديعَ مُنتَقِياً","كَالرَوضِ إِذ بَثَّ في الرُبى قِطَعَه",3,"ع",2,0],["بِثِقَاتِكَ الغُرِّ المَيَامِينِ الأُولَى","صَحِبُوكَ لَمْ يَعْزُزْ عَلَيْكَ مَرَامُ",4,"م",1,0],["بِثَبَاتِهِمْ وَبِحِلْمِهِمْ وَبِعِلْمِهِمْ","فَعَلُوا فِعَالَ الجَيْشِ وَهْوَ لُهَامُ",4,"م",1,0],["بَثَّتْ أَساهَا بِمَا رِيعَ الزَّمَانُ لَهُ","كَأَنَّمَا أَخْرَجَتْ أَشْبَالَهَا الأَجَمُ",5,"م",1,0],["بِثِنتَينِ إِن تَضرِب ذِهي تَنصَرِف ذِهي","لِكِلتَيهِما رَوقٌ إِلى جَنبِ مِخدَعِ",6,"ع",1,0],["بَثّ أسطوله فلبّسه طو","غو بأسطول خصمه تلبيسا",7,"س",2,0],["بثّ المشيبُ على الشجيّ بزاته","وبدا فنفّر ظبيه ومهاته",8,"ت",2,1],["بَثَّ عنها الفُتونَ حَجْلٌ صَمُوتٌ","ماله نَبْسَةٌ وعُودٌ صَخُوبُ",9,"ب",1,0],["بثَثْتَ شَجْوَكَ فيهم إذ فُقدْتَ كما","بثثت رفْدَكَ فيهم غَيْر مُفْتَقَدِ",10,"د",1,0],["بثّ منها الحكيمُ فيهم سهاماً","وقعتْ في مواضعِ الآجالِ",11,"ل",1,0],["بُثَينَ أَيّاً ما أَرَدتِ فَاِفعَلي","إِنّي لِآني ما أَشَأتِ مُعتَلي",12,"ي",1,0],["بِثَغرٍ قَد سُقينَ المِسكَ مِنهُ","مَساويكُ البَشامِ وَمِن غُروبِ",13,"ب",1,1],["بُثَينَةُ قالَت يا جَميلُ أَرَبتَني","فَقُلتُ كِلانا يا بُثَينَ مُريبُ",14,"ب",1,1],["بُثَينَةُ مِن صِنفٍ يُقَلِّبنَ أَيدِيَ ال","رُماةِ وَما يَحمِلنَ قَوساً وَلا نَبلا",15,"ل",2,1],["بُثَينَةُ تُزري بِالغَزالَةِ في الضُحى","إِذا بَرَزَت لَم تُبقِ يَوماً بِها بَها",16,"ه",2,0],["بُثَينَ سَليني بَعضَ مالي فَإِنَّما","يُبَيِّنُ عِندَ المالِ كُلُّ بَخيلِ",17,"ل",1,0],["بثوا باوجه من يريدون","الشرور لكم شرارا",18,"ر",2,0],["بثوا بألسنة لكم من نار","ما في جماجمكم من الأفكار",19,"ر",1,1],["بثهم في كنانة الله نورا","من ظلام على البصائر أخنى",20,"ن",2,0],["بَثَثتُ شَكوايَ فَذابَ الجَليدُ","وَأَشفَقَ الصَخرُ وَلانَ الحَديد",21,"د",1,1],["بَثَّ الفَوائِدَ في الأَباعِدِ وَالدُنى","حَتّى تَوَهَّمناهُ مَخروقَ اليَدِ",22,"د",1,0],["بَثَثتَ فيها عَطاءً زادَ في عَدَدِ ال","عَليا وَنَوَّهتَ بِاِسمِ الجودِ تَنويها",23,"ي",3,0],["بِثَديِ اللُؤمِ أُرضِعَ لِلمَخازي","وَأَورَثَكَ المَلائِمَ حينَ شابا",24,"ب",2,0],["بَثّوا خُيولَهُمُ في كُلِّ مَعرَكَةٍ","كَما تَقاذَفَ ضَربُ القَينِ بِالشَرَرِ",25,"ر",1,0],["بِثَلاثِ واواتٍ وَشينٍ بَعدَها","كافٌ وَضادٌ أَصلُ كُلِّ هَوانِ",26,"ن",1,1],["بِثُغورٍ لَم يَعلُها قَشَفُ النُح","لِ وَلَم تَجلُها يَدٌ بِسِواكِ",27,"ك",1,0],["بِثَلاثَةٍ كَثَلاثَةِ الراحِ اِستَوى","لَكَ لَونُها وَمَذاقُها وَشَميمُها",28,"م",3,0],["بَثَّ الرَّدى وَالنَّدى شَطرَينِ فَاِنبَعَثا","فِيمَن غَوى وَهَدى بِالبُؤسِ وَالنِّعَمِ",29,"م",1,0],["بثمنٍ مبلغُهُ منْ فضهْ","وازنةٍ جيدةٍ مُبَيَّضَهْ",30,"ه",1,0],["بِثَمدَينِ لاحَت نارَ لَيلى وَصَحبَتي","بِذاتِ الغَضا تَزجي المَطِيَّ النَواجِيا",31,"ي",2,0],["بَثَّ الحَضارةَ في المدائِنِ والقُرَى","وأجالَ في أرجائِها العُمرانا",32,"ن",2,0],["بثَّ الشكاةَ فلم يَتركْ لِذي شَجَنٍ","يشكو جَوى الحُبِّ من قولٍ وإن برعا",33,"ع",2,0],["بَثَثتَ بِأُفقِ الغَربِ كُلَّ غَريبَةٍ","مِنَ القَولِ يَشجى الشَرقَ مِنها وَيَشرِقُ",34,"ق",1,0],["بَثَّ فيهُم روحاً جَديداً يَفيقوا","وَيَروا كَم يَد تَعيث خَفيه",35,"ي",2,0],["بَثَّ عَلَيها غارَةً أَكثَرَت","عَيلَ أَياماها وَأَيتامِها",36,"م",3,0],["بَثَّ الفضائِلَ فِي الوجودِ فَمَنْ يُرِد","فضلاً يَزِدْهُ بِفَضلِهِ تفصيلا",37,"ل",2,0],["بُثَّ النَوالَ وَلا تَمنَعكَ قِلَّتُهُ","فَكُلُّ ما سَدَّ فَقراً فَهوَ مَحمودُ",38,"د",1,0],["بثها في بلاغة ولقد قا","ل صريحاً ولم يقلها نجيا",39,"ي",2,0],["بُثَينَ اِلزَمي لا إِنَّ لا إِن لَزِمتِهِ","عَلى كَثرَةِ الواشينَ أَيُّ مَعونِ",40,"ن",1,0],["بثت العدل راحتاه وعزت","في حماه العلوم والعلماء",41,"ا",2,0],["بِثَمدينَ لاحَت نارُ لَيلى وَصُحبَتي","بِذاتِ الغَضى تُزجي المَطِيَّ النَواجِيا",42,"ي",2,0],["بَثَّ الخَلِيلُ وَعادِلٌ شَجْوَيهِمَا","فَإِذَا القوَافِي فِي الطُّرُوسِ مَدَامعُ",43,"ع",1,0],["بِثَوْبِكَ مِنْ نَسْجِ الحِمَى تَخْدمُ الحِمَى","ونَفْسَكَ مَوْفُورَ الكَرَامَةِ وَالأَجْرِ",44,"ر",1,0],["بِثَائِرِهِ وَسَاجِيهِ","أَفَانِينُ مِنَ السِّحْرِ",45,"ر",1,0],["بَثَّهَا دَائِباً وَلَمْ يَدَّخِرْ دُو","نَ الْبَلاَغِ المَبِينِ مِنْ مَجْهُود",46,"د",1,0],["بَثَّتْ حِكَايَةَ وَجْدِهِ","بِأَنِينِهَا المُتَقَطعِ",47,"ع",1,0],["بثرى ترنمت الشفاه بلحنها","وتساقطت بردًا على الأكباد",48,"د",1,0],["بثُّوا له الأشواك إذ يمشي، وإنْ","يشرَبْ، فشُوبوا ماءه بالعلْقَم",49,"م",1,0],["بثرى جدودك قد حططت حقيبتي","فوسيلتي لعلاك نور باهر",50,"ر",1,0],["بثثت إليه أنه توهن الصفا","فلما تغاضى صح لي أنه حجر",51,"ر",1,0],["بثغرك من ذكرى شبابي صحيفة","مطرّزة بالحبّ والأمل السامي",52,"م",2,1],["بُثينَ، أيّاً ما أردتِ، فافعلي","، إني لآتي ما أشأتِ مُعتَلي",53,"ي",1,0],["بثينة تزري بالغزالة في الضحى","إذا برزت لم تبث يوما بِها بَها",54,"ه",2,0]]}