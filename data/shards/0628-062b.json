aspx?id=202804",""],[5150,"حوران .. الثورة ..!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202805",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5362,"قالوا التمدن قلت ذاك سراب","https://www.poetsgate.com/ViewPoem.aspx?id=170372",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5409,"تركت وراءك البلد الأمينا","https://www.poetsgate.com/ViewPoem.aspx?id=155482",""],[5409,"عش في زمانك ما استطعت نبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155496",""],[5431,"شهاب الشعر والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=198555",""],[5442,"أيها السائل الذي رزق التوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=114767",""],[351,"طرقْتكَ زينَبُ والرِّكَابُ مُناخَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=4473",""],[5497,"أتت تسعى","https://www.poetsgate.com/ViewPoem.aspx?id=210241",""],[5574,"\"شُوَيَّ برْضو\"","https://www.poetsgate.com/ViewPoem.aspx?id=206028",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5628,"الشاعر وأنين الناي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=191333",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5720,"الرَّحمَة المهدَاة ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=198968",""],[5776,"بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=199379",""],[5818,"بثامن آيةٍ في العادياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199689",""],[5823,"ثنائية العشق والهجر","https://www.poetsgate.com/ViewPoem.aspx?id=59185",""],[5953,"أنا بالمعنى وبالاسم","https://www.poetsgate.com/ViewPoem.aspx?id=93842",""],[6070,"بثوبٍ مِنَ الثَّلجِ البَريءِ تلحَّفا","https://www.poetsgate.com/ViewPoem.aspx?id=197532",""],[520,"أفخر فحسبك ما اوتيت من حسب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577444",""],[520,"إذا قدرت على العلياء بالغلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577434",""],[6256,"أحبك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65915&r=&rc=3",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["بَثَّ المَواهِبَ حتى ضمَّ نائِلُهُ","منَ المَحامِدِ شَمْلاً غيرَ مُؤْتَلِفِ",0,"ف",1,0],["بَثَثتُ مُفيداً وَاِستَفَدتُ وِدادَهُم","وَإِلّا فَمَكنونٌ لَدَيَّ وَمُكتَتِم",1,"م",1,0],["بثَرَى جُدودِكَ قد وضَعْتُ حَقيبَتي","فوَسيلَتي لعُلاكَ نورٌ باهِرُ",2,"ر",1,0],["بَثَثتَ فيهِ البَديعَ مُنتَقِياً","كَالرَوضِ إِذ بَثَّ في الرُبى قِطَعَه",3,"ع",2,0],["بِثِقَاتِكَ الغُرِّ المَيَامِينِ الأُولَى","صَحِبُوكَ لَمْ يَعْزُزْ عَلَيْكَ مَرَامُ",4,"م",1,0],["بِثَبَاتِهِمْ وَبِحِلْمِهِمْ وَبِعِلْمِهِمْ","فَعَلُوا فِعَالَ الجَيْشِ وَهْوَ لُهَامُ",4,"م",1,0],["بَثَّتْ أَساهَا بِمَا رِيعَ الزَّمَانُ لَهُ","كَأَنَّمَا أَخْرَجَتْ أَشْبَالَهَا الأَجَمُ",5,"م",1,0],["بِثِنتَينِ إِن تَضرِب ذِهي تَنصَرِف ذِهي","لِكِلتَيهِما رَوقٌ إِلى جَنبِ مِخدَعِ",6,"ع",1,0],["بَثّ أسطوله فلبّسه طو","غو بأسطول خصمه تلبيسا",7,"س",2,0],["بثّ المشيبُ على الشجيّ بزاته","وبدا فنفّر ظبيه ومهاته",8,"ت",2,1],["بَثَّ عنها الفُتونَ حَجْلٌ صَمُوتٌ","ماله نَبْسَةٌ وعُودٌ صَخُوبُ",9,"ب",1,0],["بثَثْتَ شَجْوَكَ فيهم إذ فُقدْتَ كما","بثثت رفْدَكَ فيهم غَيْر مُفْتَقَدِ",10,"د",1,0],["بثّ منها الحكيمُ فيهم سهاماً","وقعتْ في مواضعِ الآجالِ",11,"ل",1,0],["بُثَينَ أَيّاً ما أَرَدتِ فَاِفعَلي","إِنّي لِآني ما أَشَأتِ مُعتَلي",12,"ي",1,0],["بِثَغرٍ قَد سُقينَ المِسكَ مِنهُ","مَساويكُ البَشامِ وَمِن غُروبِ",13,"ب",1,1],["بُثَينَةُ قالَت يا جَميلُ أَرَبتَني","فَقُلتُ كِلانا يا بُثَينَ مُريبُ",14,"ب",1,1],["بُثَينَةُ مِن صِنفٍ يُقَلِّبنَ أَيدِيَ ال","رُماةِ وَما يَحمِلنَ قَوساً وَلا نَبلا",15,"ل",2,1],["بُثَينَةُ تُزري بِالغَزالَةِ في الضُحى","إِذا بَرَزَت لَم تُبقِ يَوماً بِها بَها",16,"ه",2,0],["بُثَينَ سَليني بَعضَ مالي فَإِنَّما","يُبَيِّنُ عِندَ المالِ كُلُّ بَخيلِ",17,"ل",1,0],["بثوا باوجه من يريدون","الشرور لكم شرارا",18,"ر",2,0],["بثوا بألسنة لكم من نار","ما في جماجمكم من الأفكار",19,"ر",1,1],["بثهم في كنانة الله نورا","من ظلام على البصائر أخنى",20,"ن",2,0],["بَثَثتُ شَكوايَ فَذابَ الجَليدُ","وَأَشفَقَ الصَخرُ وَلانَ الحَديد",21,"د",1,1],["بَثَّ الفَوائِدَ في الأَباعِدِ وَالدُنى","حَتّى تَوَهَّمناهُ مَخروقَ اليَدِ",22,"د",1,0],["بَثَثتَ فيها عَطاءً زادَ في عَدَدِ ال","عَليا وَنَوَّهتَ بِاِسمِ الجودِ تَنويها",23,"ي",3,0],["بِثَديِ اللُؤمِ أُرضِعَ لِلمَخازي","وَأَورَثَكَ المَلائِمَ حينَ شابا",24,"ب",2,0],["بَثّوا خُيولَهُمُ في كُلِّ مَعرَكَةٍ","كَما تَقاذَفَ ضَربُ القَينِ بِالشَرَرِ",25,"ر",1,0],["بِثَلاثِ واواتٍ وَشينٍ بَعدَها","كافٌ وَضادٌ أَصلُ كُلِّ هَوانِ",26,"ن",1,1],["بِثُغورٍ لَم يَعلُها قَشَفُ النُح","لِ وَلَم تَجلُها يَدٌ بِسِواكِ",27,"ك",1,0],["بِثَلاثَةٍ كَثَلاثَةِ الراحِ اِستَوى","لَكَ لَونُها وَمَذاقُها وَشَميمُها",28,"م",3,0],["بَثَّ الرَّدى وَالنَّدى شَطرَينِ فَاِنبَعَثا","فِيمَن غَوى وَهَدى بِالبُؤسِ وَالنِّعَمِ",29,"م",1,0],["بثمنٍ مبلغُهُ منْ فضهْ","وازنةٍ جيدةٍ مُبَيَّضَهْ",30,"ه",1,0],["بِثَمدَينِ لاحَت نارَ لَيلى وَصَحبَتي","بِذاتِ الغَضا تَزجي المَطِيَّ النَواجِيا",31,"ي",2,0],["بَثَّ الحَضارةَ في المدائِنِ والقُرَى","وأجالَ في أرجائِها العُمرانا",32,"ن",2,0],["بثَّ الشكاةَ فلم يَتركْ لِذي شَجَنٍ","يشكو جَوى الحُبِّ من قولٍ وإن برعا",33,"ع",2,0],["بَثَثتَ بِأُفقِ الغَربِ كُلَّ غَريبَةٍ","مِنَ القَولِ يَشجى الشَرقَ مِنها وَيَشرِقُ",34,"ق",1,0],["بَثَّ فيهُم روحاً جَديداً يَفيقوا","وَيَروا كَم يَد تَعيث خَفيه",35,"ي",2,0],["بَثَّ عَلَيها غارَةً أَكثَرَت","عَيلَ أَياماها وَأَيتامِها",36,"م",3,0],["بَثَّ الفضائِلَ فِي الوجودِ فَمَنْ يُرِد","فضلاً يَزِدْهُ بِفَضلِهِ تفصيلا",37,"ل",2,0],["بُثَّ النَوالَ وَلا تَمنَعكَ قِلَّتُهُ","فَكُلُّ ما سَدَّ فَقراً فَهوَ مَحمودُ",38,"د",1,0],["بثها في بلاغة ولقد قا","ل صريحاً ولم يقلها نجيا",39,"ي",2,0],["بُثَينَ اِلزَمي لا إِنَّ لا إِن لَزِمتِهِ","عَلى كَثرَةِ الواشينَ أَيُّ مَعونِ",40,"ن",1,0],["بثت العدل راحتاه وعزت","في حماه العلوم والعلماء",41,"ا",2,0],["بِثَمدينَ لاحَت نارُ لَيلى وَصُحبَتي","بِذاتِ الغَضى تُزجي المَطِيَّ النَواجِيا",42,"ي",2,0],["بَثَّ الخَلِيلُ وَعادِلٌ شَجْوَيهِمَا","فَإِذَا القوَافِي فِي الطُّرُوسِ مَدَامعُ",43,"ع",1,0],["بِثَوْبِكَ مِنْ نَسْجِ الحِمَى تَخْدمُ الحِمَى","ونَفْسَكَ مَوْفُورَ الكَرَامَةِ وَالأَجْرِ",44,"ر",1,0],["بِثَائِرِهِ وَسَاجِيهِ","أَفَانِينُ مِنَ السِّحْرِ",45,"ر",1,0],["بَثَّهَا دَائِباً وَلَمْ يَدَّخِرْ دُو","نَ الْبَلاَغِ المَبِينِ مِنْ مَجْهُود",46,"د",1,0],["بَثَّتْ حِكَايَةَ وَجْدِهِ","بِأَنِينِهَا المُتَقَطعِ",47,"ع",1,0],["بثرى ترنمت الشفاه بلحنها","وتساقطت بردًا على الأكباد",48,"د",1,0],["بثُّوا له الأشواك إذ يمشي، وإنْ","يشرَبْ، فشُوبوا ماءه بالعلْقَم",49,"م",1,0],["بثرى جدودك قد حططت حقيبتي","فوسيلتي لعلاك نور باهر",50,"ر",1,0],["بثثت إليه أنه توهن الصفا","فلما تغاضى صح لي أنه حجر",51,"ر",1,0],["بثغرك من ذكرى شبابي صحيفة","مطرّزة بالحبّ والأمل السامي",52,"م",2,1],["بُثينَ، أيّاً ما أردتِ، فافعلي","، إني لآتي ما أشأتِ مُعتَلي",53,"ي",1,0],["بثينة تزري بالغزالة في الضحى","إذا برزت لم تبث يوما بِها بَها",54,"ه",2,0],["بثايتك احتمل صبا جلوها","تأجج في جوانحه اصطلام",55,"م",1,0],["بَثَّت سَراياكَ الحُتوفَ وَأَكثَرَت","في أَرضِ أَنطاكِيَّةَ الأَيتاما",56,"م",2,0],["بث نحوى جنده والسرايا","وأتتني بعد الجنود الجنود",57,"د",1,0],["بَثَّ بِها الأَمنَ وَرَدَّ المُنى","غَضّاً وَكانا آذَنا بِاِنصِرام",58,"م",1,0],["بِثَنِيَّةِ العَلَمَينِ وَهناً بَعدَ مَا","خَفَقَ السِّماكُ وَعَأرضَتهُ العَقرَبُ",59,"ب",1,0],["بَثَت مِن الأَشواقِ ما لَم يُعدِنِي","مِما لَقَد شَعَرَت بَحرِّ ضَرامِهْ",60,"م",2,0],["بُثَّ شَكواكَ فَالحَنانُ يُرَجّى","وَالمَواعيدُ إن يكن إِصغاءُ",61,"ا",2,0],["بثاراتِ بدرٍ طالبَوهم ومكَّةٍ","وكادهُمُ والحقُّ ليس يُكاد",62,"د",1,0],["بث فيها من كل زوج من النا","س وما طار من ذوات الريش",63,"ش",1,0],["بَثَّ في أَقطارِها مَعدِلَةً","تُؤمِنُ الظَبيَةَ مِن سِرحانِها",64,"ن",3,0],["بِثُغورٍ يَشجى بِهِنَّ الأَقاحي","وَقُدودٍ تَشقى بِهِنَّ الغُصونُ",65,"ن",1,0],["بِثَغرٍ كَما يَبدو لَكَ الصُبحُ باسِمٍ","وَفَرعٌ كَما يَدجو لَكَ اللَيلُ فاحِمِ",66,"م",1,0],["بَثَّت يَداهُ الآجالَ في الناسِ وَال","أَرزاقَ عَدلا بِالسَيفِ وَالقَلَمِ",67,"م",1,0],["بَثَّ في الأَرضِ رَأفَةً بَدَّلَت وَح","شَةَ ساري الظَلامِ بِالإيناسِ",68,"س",1,0],["بَثَّ بَثِّي شَجَنِي","فَنَبَتْ بِي بُِغْيَتِي",69,"ي",1,1],["بثمدين لاحتْ نار ليلى وصُحبتي","بفرعِ الغَضا تُزجي قِلاصاً نواجيا",70,"ي",2,0],["بثلاثٍ من النساءِ حِسانٍ","مرَّ ليلي وكنتُ كالمسحور",71,"ر",1,0],["بُثينةُ أعطاها جميلٌ جمالَها","وفي شِعرِ قيسٍ حُسنُ ليلى له نضر",72,"ر",1,0],["بَثَّتِ النجمَ عيوناً خَلْفَها","يتطلّعنَ إلى أينَ سراها",73,"ا",3,0],["بثَّ الحياةَ وَبثَّ الحسنَ حيث جرى","وانساح بُوركَ من جارٍ وَمنساح",74,"ح",1,0],["بثت شباك لآلٍ في المياه فكم","صادت سروراً لمن قد بات محزونا",75,"ن",2,0],["بثغره خال ندٍّ","فليس يحكيه ندُّ",76,"د",1,1],["بَثَثتُ مُفيداً وَاِستَفَدتُ وِدادَه","وَإِلّا فَمَخزونٌ لَدَيَّ وَمُكتَتَم",77,"م",1,0],["بِثَنِيَّةِ العَلَمَينِ وَهناً بَعدَما","خَفَقَ السِماكُ وَجاوَرَتهُ العَقرَبُ",78,"ب",1,0],["بَثثْتَ أمير المؤمنين صنائعاً","قليلٌ لها منّي كثير المَحامد",79,"د",1,0],["بث سر الهوى عليه النحول","واصفرار ودهشة وذهول",80,"ل",1,1],["بَثَّ الفَضائِل خلفه وَأَمامه","فَفَناء مُهجَتِهِ كَمِثلِ خُلودِها",81,"د",3,0],["بُثَيْنَةُ ما أعرَضتُ عنكِ ملاَلةً","ولا أنَا عمّا تعلمينَ مُفِيقُ",82,"ق",1,1],["بَثَّ في الرَأسِ حَرثَةَ الشَيبُ لَمّا","حانَ إِبّانُ حَرثِهِ فَعَلاكا",83,"ك",2,0],["بثي الأشواق بمربعهم","عن صب ذات ببعدهم",84,"م",1,0],["بثنا أوصاف مآثره","اطنب يا صاح وقل مهما",85,"م",2,0],["بثَثْتُكَ سِرِّي والحديثُ كما حَكَوْا","شُجونٌ فيا صَدْرَ الكمالِ احْفَظِ السِّرَّا",86,"ر",2,0],["بثغر حكى الأغريض حسنا وإنّه","لفاخر درّ في عقيق منضّد",87,"د",1,0],["بثورة قمت ضد الظلم فانتصرت","بك العروبة بعد الذل والعار",88,"ر",1,0],["بثها الجهل والحماقة بثا","في طريق الإصلاح والإقدام",89,"م",1,0],["بُثينةُ لا أرَضى الوداعَ وإن أكن","لأرَضىَ دمائي 