t/poem36844.html","عموديه"],[303,"يا حسن بركة ماء قد بصرت بها","https://www.aldiwan.net/poem57812.html","البسيط"],[303,"بثغره خال ند","https://www.aldiwan.net/poem57946.html","المجتث"],[338,"أأنثر درا بين سارحة النعم","https://www.aldiwan.net/poem68610.html","الطويل"],[346,"طرقتك زينب والركاب مناخة","https://www.aldiwan.net/poem24116.html","الكامل"],[364,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[403,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[406,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[409,"بثينة ما أعرضت عنك ملالة","https://www.aldiwan.net/poem32558.html","الطويل"],[410,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[429,"نسمات البان من العلم","https://www.aldiwan.net/poem40851.html","المتدارك"],[429,"رفقا بأسيرك يا أسما","https://www.aldiwan.net/poem41412.html","المتدارك"],[432,"أقول رياض إذ ترصعها زهرا","https://www.aldiwan.net/poem12435.html","الطويل"],[437,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[449,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[453,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[453,"بثينة لا أرضى الوداع وإن أكن","https://www.aldiwan.net/poem61656.html","الطويل"],[458,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[464,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[464,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[468,"بث السقام من الحبشان في بدني","https://www.aldiwan.net/poem59583.html","البسيط"],[477,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[504,"أثني على خير الأنام محمد","https://www.aldiwan.net/poem38401.html","الطويل"],[514,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[515,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[538,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[553,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[558,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[558,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"]],"verses":[["بَثَّ المَواهِبَ حتى ضمَّ نائِلُهُ","منَ المَحامِدِ شَمْلاً غيرَ مُؤْتَلِفِ",0,"ف",1,0],["بَثَثتُ مُفيداً وَاِستَفَدتُ وِدادَهُم","وَإِلّا فَمَكنونٌ لَدَيَّ وَمُكتَتِم",1,"م",1,0],["بثَرَى جُدودِكَ قد وضَعْتُ حَقيبَتي","فوَسيلَتي لعُلاكَ نورٌ باهِرُ",2,"ر",1,0],["بَثَثتَ فيهِ البَديعَ مُنتَقِياً","كَالرَوضِ إِذ بَثَّ في الرُبى قِطَعَه",3,"ع",2,0],["بِثِقَاتِكَ الغُرِّ المَيَامِينِ الأُولَى","صَحِبُوكَ لَمْ يَعْزُزْ عَلَيْكَ مَرَامُ",4,"م",1,0],["بِثَبَاتِهِمْ وَبِحِلْمِهِمْ وَبِعِلْمِهِمْ","فَعَلُوا فِعَالَ الجَيْشِ وَهْوَ لُهَامُ",4,"م",1,0],["بَثَّتْ أَساهَا بِمَا رِيعَ الزَّمَانُ لَهُ","كَأَنَّمَا أَخْرَجَتْ أَشْبَالَهَا الأَجَمُ",5,"م",1,0],["بِثِنتَينِ إِن تَضرِب ذِهي تَنصَرِف ذِهي","لِكِلتَيهِما رَوقٌ إِلى جَنبِ مِخدَعِ",6,"ع",1,0],["بَثّ أسطوله فلبّسه طو","غو بأسطول خصمه تلبيسا",7,"س",2,0],["بثّ المشيبُ على الشجيّ بزاته","وبدا فنفّر ظبيه ومهاته",8,"ت",2,1],["بَثَّ عنها الفُتونَ حَجْلٌ صَمُوتٌ","ماله نَبْسَةٌ وعُودٌ صَخُوبُ",9,"ب",1,0],["بثَثْتَ شَجْوَكَ فيهم إذ فُقدْتَ كما","بثثت رفْدَكَ فيهم غَيْر مُفْتَقَدِ",10,"د",1,0],["بثّ منها الحكيمُ فيهم سهاماً","وقعتْ في مواضعِ الآجالِ",11,"ل",1,0],["بُثَينَ أَيّاً ما أَرَدتِ فَاِفعَلي","إِنّي لِآني ما أَشَأتِ مُعتَلي",12,"ي",1,0],["بِثَغرٍ قَد سُقينَ المِسكَ مِنهُ","مَساويكُ البَشامِ وَمِن غُروبِ",13,"ب",1,1],["بُثَينَةُ قالَت يا جَميلُ أَرَبتَني","فَقُلتُ كِلانا يا بُثَينَ مُريبُ",14,"ب",1,1],["بُثَينَةُ مِن صِنفٍ يُقَلِّبنَ أَيدِيَ ال","رُماةِ وَما يَحمِلنَ قَوساً وَلا نَبلا",15,"ل",2,1],["بُثَينَةُ تُزري بِالغَزالَةِ في الضُحى","إِذا بَرَزَت لَم تُبقِ يَوماً بِها بَها",16,"ه",2,0],["بُثَينَ سَليني بَعضَ مالي فَإِنَّما","يُبَيِّنُ عِندَ المالِ كُلُّ بَخيلِ",17,"ل",1,0],["بثوا باوجه من يريدون","الشرور لكم شرارا",18,"ر",2,0],["بثوا بألسنة لكم من نار","ما في جماجمكم من الأفكار",19,"ر",1,1],["بثهم في كنانة الله نورا","من ظلام على البصائر أخنى",20,"ن",2,0],["بَثَثتُ شَكوايَ فَذابَ الجَليدُ","وَأَشفَقَ الصَخرُ وَلانَ الحَديد",21,"د",1,1],["بَثَّ الفَوائِدَ في الأَباعِدِ وَالدُنى","حَتّى تَوَهَّمناهُ مَخروقَ اليَدِ",22,"د",1,0],["بَثَثتَ فيها عَطاءً زادَ في عَدَدِ ال","عَليا وَنَوَّهتَ بِاِسمِ الجودِ تَنويها",23,"ي",3,0],["بِثَديِ اللُؤمِ أُرضِعَ لِلمَخازي","وَأَورَثَكَ المَلائِمَ حينَ شابا",24,"ب",2,0],["بَثّوا خُيولَهُمُ في كُلِّ مَعرَكَةٍ","كَما تَقاذَفَ ضَربُ القَينِ بِالشَرَرِ",25,"ر",1,0],["بِثَلاثِ واواتٍ وَشينٍ بَعدَها","كافٌ وَضادٌ أَصلُ كُلِّ هَوانِ",26,"ن",1,1],["بِثُغورٍ لَم يَعلُها قَشَفُ النُح","لِ وَلَم تَجلُها يَدٌ بِسِواكِ",27,"ك",1,0],["بِثَلاثَةٍ كَثَلاثَةِ الراحِ اِستَوى","لَكَ لَونُها وَمَذاقُها وَشَميمُها",28,"م",3,0],["بَثَّ الرَّدى وَالنَّدى شَطرَينِ فَاِنبَعَثا","فِيمَن غَوى وَهَدى بِالبُؤسِ وَالنِّعَمِ",29,"م",1,0],["بثمنٍ مبلغُهُ منْ فضهْ","وازنةٍ جيدةٍ مُبَيَّضَهْ",30,"ه",1,0],["بِثَمدَينِ لاحَت نارَ لَيلى وَصَحبَتي","بِذاتِ الغَضا تَزجي المَطِيَّ النَواجِيا",31,"ي",2,0],["بَثَّ الحَضارةَ في المدائِنِ والقُرَى","وأجالَ في أرجائِها العُمرانا",32,"ن",2,0],["بثَّ الشكاةَ فلم يَتركْ لِذي شَجَنٍ","يشكو جَوى الحُبِّ من قولٍ وإن برعا",33,"ع",2,0],["بَثَثتَ بِأُفقِ الغَربِ كُلَّ غَريبَةٍ","مِنَ القَولِ يَشجى الشَرقَ مِنها وَيَشرِقُ",34,"ق",1,0],["بَثَّ فيهُم روحاً جَديداً يَفيقوا","وَيَروا كَم يَد تَعيث خَفيه",35,"ي",2,0],["بَثَّ عَلَيها غارَةً أَكثَرَت","عَيلَ أَياماها وَأَيتامِها",36,"م",3,0],["بَثَّ الفضائِلَ فِي الوجودِ فَمَنْ يُرِد","فضلاً يَزِدْهُ بِفَضلِهِ تفصيلا",37,"ل",2,0],["بُثَّ النَوالَ وَلا تَمنَعكَ قِلَّتُهُ","فَكُلُّ ما سَدَّ فَقراً فَهوَ مَحمودُ",38,"د",1,0],["بثها في بلاغة ولقد قا","ل صريحاً ولم يقلها نجيا",39,"ي",2,0],["بُثَينَ اِلزَمي لا إِنَّ لا إِن لَزِمتِهِ","عَلى كَثرَةِ الواشينَ أَيُّ مَعونِ",40,"ن",1,0],["بثت العدل راحتاه وعزت","في حماه العلوم والعلماء",41,"ا",2,0],["بِثَمدينَ لاحَت نارُ لَيلى وَصُحبَتي","بِذاتِ الغَضى تُزجي المَطِيَّ النَواجِيا",42,"ي",2,0],["بَثَّ الخَلِيلُ وَعادِلٌ شَجْوَيهِمَا","فَإِذَا القوَافِي فِي الطُّرُوسِ مَدَامعُ",43,"ع",1,0],["بِثَوْبِكَ مِنْ نَسْجِ الحِمَى تَخْدمُ الحِمَى","ونَفْسَكَ مَوْفُورَ الكَرَامَةِ وَالأَجْرِ",44,"ر",1,0],["بِثَائِرِهِ وَسَاجِيهِ","أَفَانِينُ مِنَ السِّحْرِ",45,"ر",1,0],["بَثَّهَا دَائِباً وَلَمْ يَدَّخِرْ دُو","نَ الْبَلاَغِ المَبِينِ مِنْ مَجْهُود",46,"د",1,0],["بَثَّتْ حِكَايَةَ وَجْدِهِ","بِأَنِينِهَا المُتَقَطعِ",47,"ع",1,0],["بثرى ترنمت الشفاه بلحنها","وتساقطت بردًا على الأكباد",48,"د",1,0],["بثُّوا له الأشواك إذ يمشي، وإنْ","يشرَبْ، فشُوبوا ماءه بالعلْقَم",49,"م",1,0],["بثرى جدودك قد حططت حقيبتي","فوسيلتي لعلاك نور باهر",50,"ر",1,0],["بثثت إليه أنه توهن الصفا","فلما تغاضى صح لي أنه حجر",51,"ر",1,0],["بثغرك من ذكرى شبابي صحيفة","مطرّزة بالحبّ والأمل السامي",52,"م",2,1],["بُثينَ، أيّاً ما أردتِ، فافعلي","، إني لآتي ما أشأتِ مُعتَلي",53,"ي",1,0],["بثينة تزري بالغزالة في الضحى","إذا برزت لم تبث يوما بِها بَها",54,"ه",2,0],["بثايتك احتمل صبا جلوها","تأجج في جوانحه اصطلام",55,"م",1,0],["بَثَّت سَراياكَ الحُتوفَ وَأَكثَرَت","في أَرضِ أَنطاكِيَّةَ الأَيتاما",56,"م",2,0],["بث نحوى جنده والسرايا","وأتتني بعد الجنود الجنود",57,"د",1,0],["بَثَّ بِها الأَمنَ وَرَدَّ المُنى","غَضّاً وَكانا آذَنا بِاِنصِرام",58,"م",1,0],["بِثَنِيَّةِ العَلَمَينِ وَهناً بَعدَ مَا","خَفَقَ السِّماكُ وَعَأرضَتهُ العَقرَبُ",59,"ب",1,0],["بَثَت مِن الأَشواقِ ما لَم يُعدِنِي","مِما لَقَد شَعَرَت بَحرِّ ضَرامِهْ",60,"م",2,0],["بُثَّ شَكواكَ فَالحَنانُ يُرَجّى","وَالمَواعيدُ إن يكن إِصغاءُ",61,"ا",2,0],["بثاراتِ بدرٍ طالبَوهم ومكَّةٍ","وكادهُمُ والحقُّ ليس يُكاد",62,"د",1,0],["بث فيها من كل زوج من النا","س وما طار من ذوات الريش",63,"ش",1,0],["بَثَّ في أَقطارِها مَعدِلَةً","تُؤمِنُ الظَبيَةَ مِن سِرحانِها",64,"ن",3,0],["بِثُغورٍ يَشجى بِهِنَّ الأَقاحي","وَقُدودٍ تَشقى بِهِنَّ الغُصونُ",65,"ن",1,0],["بِثَغرٍ كَما يَبدو لَكَ الصُبحُ باسِمٍ","وَفَرعٌ كَما يَدجو لَكَ اللَيلُ فاحِمِ",66,"م",1,0],["بَثَّت يَداهُ الآجالَ في الناسِ وَال","أَرزاقَ عَدلا بِالسَيفِ وَالقَلَمِ",67,"م",1,0],["بَثَّ في الأَرضِ رَأفَةً بَدَّلَت وَح","شَةَ ساري الظَلامِ بِالإيناسِ",68,"س",1,0],["بَثَّ بَثِّي شَجَنِي","فَنَبَتْ بِي بُِغْيَتِي",69,"ي",1,1],["بثمدين لاحتْ نار ليلى وصُحبتي","بفرعِ الغَضا تُزجي قِلاصاً نواجيا",70,"ي",2,0],["بثلاثٍ من النساءِ حِسانٍ","مرَّ ليلي وكنتُ كالمسحور",71,"ر",1,0],["بُثينةُ أعطاها جميلٌ جمالَها","وفي شِعرِ قيسٍ حُسنُ ليلى له نضر",72,"ر",1,0],["بَثَّتِ النجمَ عيوناً خَلْفَها","يتطلّعنَ إلى أينَ سراها",73,"ا",3,0],["بثَّ الحياةَ وَبثَّ الحسنَ حيث جرى","وانساح بُوركَ من جارٍ وَمنساح",74,"ح",1,0],["بثت شباك لآلٍ في المياه فكم","صادت سروراً لمن قد بات محزونا",75,"ن",2,0],["بثغره خال ندٍّ","فليس يحكيه ندُّ",76,"د",1,1],["بَثَثتُ مُفيداً وَاِستَفَدتُ وِدادَه","وَإِلّا فَمَخزونٌ لَدَيَّ وَمُكتَتَم",77,"م",1,0],["بِثَنِيَّةِ العَلَمَينِ وَهناً بَعدَما","خَفَقَ السِماكُ وَجاوَرَتهُ العَقرَبُ",78,"ب",1,0],["بَثثْتَ أمير المؤمنين صنائعاً","قليلٌ لها منّي كثير المَحامد",79,"د",1,0],["بث سر الهوى عليه النحول","واصفرار ودهشة وذهول",80,"ل",1,1],["بَثَّ الفَضائِل خلفه وَأَمامه","فَفَناء مُهجَتِهِ كَمِثلِ خُلودِها",81,"د",3,0],["بُثَيْنَةُ ما أعرَضتُ عنكِ ملاَلةً","ولا أنَا عمّا تعلمينَ مُفِيقُ",82,"ق",1,1],["بَثَّ في الرَأسِ حَرثَةَ الشَيبُ لَمّا","حانَ إِبّانُ حَرثِهِ فَعَلاكا",83,"ك",2,0],["بثي الأشواق بمربعهم","عن صب ذات ببعدهم",84,"م",1,0],["بثنا أوصاف مآثره","اطنب يا صاح وقل مهما",85,"م",2,0],["بثَثْتُكَ سِرِّي والحديثُ كما حَكَوْا","شُجونٌ فيا صَدْرَ الكمالِ احْفَظِ السِّرَّا",86,"ر",2,0],["بثغر حكى الأغريض حسنا وإنّه","لفاخر درّ في عقيق منضّد",87,"د",1,0],["بثورة قمت ضد الظلم فانتصرت","بك العروبة بعد الذل والعار",88,"ر",1,0],["بثها الجهل والحماقة بثا","في طريق الإصلاح والإقدام",89,"م",1,0],["بُثينةُ لا أرَضى الوداعَ وإن أكن","لأرَضىَ دمائي أَن تُراق لديكِ",90,"ك",1,1],["بثُمْرِكم حاملةٌ","ولم تُهجَّنْ لَقْحا",91,"ح",2,0],["بثُّ السَّرايا والسُّطا حتى غدا","ذئبُ الفلاةِ وشاؤها في مرتع",92,"ع",1,0],["بثّت نبوته الأخبارُ إذ نطقت","فحدّثت عنهُ توراةٌ وأنجيل",93,"ل",1,0],["بَثَّ السَقامَ مِنَ الحُبشانِ في بَدَني","عَبدٌ تَمَلَّكَني عَبداً بِلا ثَمَنِ",94,"ن",1,1],["بثثتُهمُ والدارُ تجمعُ شملَنا","على غِرَّةِ الواشينَ وَجْداً مكتَّما",95,"م",2,0],["بِثَنائِهِ رُفِعتْ مَدَارِجُ قَدرِنَا","خَصَّتْ تَحيتُنا عَليه وآلِهِ",96,"ه",1,0],["بثَناهُ يَلهَجُ كلُّ ذي روحٍ فلو","نطقَ الجَمادُ لكانَ فيه يصْدَعُ",97,"ع",1,0],["بث الندى والردى زجراً وتكرمة","فكل قلب رهين الرعب والرغب",98,"ب",1,0],["بث الجيوش على التدريج فانبعثت","في غزوهم سرباً كالوابل السرب",99,"ب",1,0],["بثثت بها بأساً وجوداً تنافيا","كما تتنافى جنة وجهنم",100,"م",1,0],["بثَّ ما يَشتكيه مِنَّا إليكم","أنصِفوه فلا يُرى مُستَضاما",101,"م",2,0],["بَثَّ النَوالَ حَتّى","أَحَبَّهُ الحُسّادُ",102,"د",1,0],["بثَّتِ السرَّ الذي كان لها","وهي كالشمس سحابا وغماما",103,"م",2,0],["بثَّ للجيرة عني شغفاً","لم يزل بين الحشى يضطرم",104,"م",1,0]]}