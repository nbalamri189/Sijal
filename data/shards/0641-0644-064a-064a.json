{"poems":[[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[147,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136325","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136322",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93886","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[5937,"لاهوتُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211812",""]],"verses":[["فَليَيأَسِ الشَرَفَ الَّذي أُوتيتَهُ","مَن لا يَقومُ مَقامَكَ المَحمودا",0,"د",2,0],["فَليَيأَسِ الأَعداءُ أَرضاً ذادَهُم","عَنها طِعانٌ صادِقٌ وَجِلادُ",1,"د",1,0],["فَليَيأَسِ الطالِبو مَدحي فَمَطلَبُهُ","إِلّا عَلى مَن كَفاني بَذلَهُ عَسِرُ",2,"ر",1,0],["فَليَيأَسِ المُتَمَحِّلونَ مَحَلَّ مَن","هَذي مَناقِبُهُ وَذاكَ نِجارُهُ",3,"ر",2,0],["فَليَيأَسوا الرُتَبَ العَلِيَّةِ إِنَّها","لَكُمُ وِراثَةُ خِضرِمٍ عَن خِضرِمِ",4,"م",1,0],["فَليَيأَسوا مِن مَعاليكَ الَّتي بَهَرَت","هَذا وَما بَلَغَت غاياتِها الهِمَمُ",5,"م",1,0],["فلي يَدٌ بيضاءُ إن أظهرتُها","في النّظْمِ مهما يَأْفِكوا تَلَقَّف",6,"ف",1,0],["فَليَيَنما هو غافِلٌ إذ راعَهُ","يَحمون أرسَلَهُم بنو ذَكوانا",7,"ن",2,0],["فلئين برزت إلى الشهادة اخراً","فوجود روحك للورى قدام",8,"م",1,0],["فلي يا رب في فضلك المبذول رجوى","وفي رجواك كم قد لقينا من غنيمة",9,"م",2,0],["فلئيم منهم تصدى لا بذا","وكريم لرأفة بالعباد",10,"د",1,0],["فلى يصوغ مديحى فيه عهد ولا","وعقد ودّ به لى زاد تأميل",11,"ل",1,0],["فلي يونس المعنى ، وللحُبِّ بحرُهُ","فهل عَجَبٌ إنْ كانَ في عينِكِ الحُوتُ !",12,"ت",1,0]]}