يف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[461,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[461,"يا إمام الهدى علوت عن الجود","https://www.aldiwan.net/poem16241.html","الخفيف"],[461,"يا إمام الحق يا من فضله","https://www.aldiwan.net/poem16247.html","الرمل"],[464,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[464,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[464,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[465,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[466,"يا أم عمرو أنجزي الموعودا","https://www.aldiwan.net/poem50367.html","الكامل"],[468,"يا آمري بالذل للمرتمي","https://www.aldiwan.net/poem59733.html","الوافر"],[470,"يا أم طلحة إن البين قد أفدا","https://www.aldiwan.net/poem4663.html","البسيط"],[477,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[479,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[479,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[500,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[504,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[514,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[515,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[529,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[529,"يا إمام الأنام قد ضجر الناس","https://www.aldiwan.net/poem37530.html","الخفيف"],[538,"يا أمير المؤمنين المرتضى","https://www.aldiwan.net/poem47578.html","عموديه"],[543,"يا أم سودة بل يا أم عباد","https://www.aldiwan.net/poem1758.html","البسيط"],[553,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[558,"ظهرت يا نور والسوى عدم","https://www.aldiwan.net/poem34091.html","المنسرح"],[558,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[558,"يا أمة العشق فزتم بالبصر والسمع","https://www.aldiwan.net/poem34376.html","المواليا"],[562,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[575,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[586,"ما عهدنا كذا تكون الرفاق","https://www.aldiwan.net/poem17612.html","الخفيف"],[586,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["يا آمِرَ الأَقدارِ كَيفَ أَطَعتَها","أَوَما وَقاكَ جَلالُكَ الآجالا",0,"ل",2,0],["يا آمِنَ الأَقدارِ بادِر صَرفَها","وَاِعلَم بِأَنَّ الطالَبَينَ حِثاثُ",1,"ث",1,1],["يا أَمينَ الإِلَهِ وَالنَبَرُ الأَع","ظَمُ وَالعَقبُ مِن مَقاوِلَ غُلبِ",2,"ب",1,0],["يا أمي اليمن الخضرا وفاتنتي","منك الفتون ومني العشق والسهر",3,"ر",1,0],["يا أَمينَ اللَهِ وَالساعي لَهُ","خَيرُ داعٍ قامَ في خَيرِ الأُمَم",4,"م",1,0],["يا إماماً أطالَ رَبّي عُلاهُ","وهُماماً بالفَخْرِ ما أوْلاهُ",5,"ه",1,1],["يَا إمَامَ الْهُدَى وَأيّ إمَامِ","أوْضَحَ الْحَقّ بَعْدَ إخْفَاء رَسْمِه",6,"ه",1,1],["يا إماماً غَدا لِدينٍ ودُنْيا","خَيْرَ مُسْتَصْرَخٍ وخَيْرَ غِياثِ",7,"ث",1,1],["يا أَميرَ البَيانِ وَالأَدَبِ النَض","رِ لَقَد كُنتَ فَخرَ أُمِّ اللُغاتِ",8,"ت",1,0],["يا أَميناً عَلى الحَقيقَةِ وَالإِف","تاءِ وَالشَرعِ وَالهُدى وَالكِتابِ",9,"ب",1,0],["يا أَميرَ الحَجِّ أَنتَ لَهُ","خَيرُ واقٍ خَيرُ مُؤتَمَنِ",10,"ن",1,0],["يا أُمُّ عَمروٍ أَلا تَبكينَ مُعوِلَةً","عَلى أَخيكِ وَقَد أَعلى بِهِ الناعي",11,"ي",1,1],["يَا أَمِيرَ الْقُلُوبِ يَحْفَظُكَ اللهُ","ويَرْعَاكَ يَا أَمِيرَ الْقُلُوبِ",12,"ب",1,1],["يَا أَمِيراً أَهْدَى إِلَى لُغَةِ الضَّادِ","كُنُوزاً مِنْ عِلْمِهِ وَبَيَانِهْ",13,"ن",2,1],["يَا أُمَّةً ضَدْجٌ وَأَنْدَادُهُ","جَلَوا لَنَا صُورَتَهَا الرَّائِعَهْ",14,"ع",2,0],["يَا أُمَّ كُلْثُومٍ بِفَنِّ","كِ أَنْتِ نَابِغَةُ الزَّمَانِ",15,"ن",1,1],["يَا أمِيراً لَنَا العَزَاءُ بِهِ","عَنْ أَعَزَ الأَحْياءِ إنْ يَحِنِ",16,"ن",1,0],["يَا أَمِيراً دَعَا وَمَنْ لا يُلَبِّي","فَرِحاً إِنْ دَعَا الأَمِيرُ الكَرِيمُ",17,"م",1,1],["يَا أُمَّتِي تُنْكِري نُصْحَ امْرِيءٍ","يَأْبَى لَكِ الضَّيزَى وَجَوْرَ القَاسِمِ",18,"م",1,1],["يَا أُمَّتِي إِنْ تَذْكُرِي مَجْداً مَضَى","فَالمَجْدُ لا يُرْضِيهِ نَوْحُ حَمَائِمِ",18,"م",1,0],["يَا أُمَّتِي إِن الهُدَى كُلَّ الْهُدَى","فِي ذَلِكَ الصَّوْتِ البَعِيدِ المُلْهِمِ",19,"م",1,0],["يَا أُمَّتِي حَسْبُنَا بِاللهِ سُخريَةً","مِنَّا وَمِمَّا تَقَاضَى أًهْلَهَا الذِّمَمُ",20,"م",1,0],["يَا أُمَّتِي هَبَّةً لِلمَجْدِ صَادِقَةً","فَالنَّصْرُ مِنْكُمْ قَرِيبٌ وَالمُنَى أَمَمُ",20,"م",1,0],["يا أُمَّةَ الضَّادِ الَّتِي فِي حُبِّهَا","بَذَلَ النَّفِيسَ وَلَمْ يَكُنْ بِمُسَاوِمِ",21,"م",1,0],["يَا أَمِيراً بِهِ خَبِرْتُ سُمُوّاً","بِالسَّجَايَا يَعِزُّ فِي الاقْيَالِ",22,"ل",1,1],["يا أُمَّةً قَتَلَت حُسَناً عَنوَةً","لَم تَرعَ حَقَّ اللَهِ فيهِ فَتَهتَدي",23,"د",2,1],["يا أُمَّةَ السوءِ ما جازَيتِ أَحمَدَ عَن","حُسنِ البَلاءِ عَلى التَنزيلِ وَالسُوَرِ",24,"ر",1,0],["يا آمري بالصبر عيلَ تَصَبُّري","دعْني فدَتْكَ لواعجُ الأشواقِ",25,"ق",1,0],["يا إماماً قد تَخِذْنا","هُ من الدّهر ملاذا",26,"ذ",2,1],["يا إمام الهدى وربّ المعالي","ومليكاً تطيعه العرب طرّا",27,"ر",2,1],["يا أمّ لا تخشى فإنّ","اللّه يا أمي مجيري",28,"ر",2,0],["يا أمة رقدت فطال رقادها","هُبّي وفي أمر الملوك تأمّلي",29,"ل",2,0],["يا أمةً عاش البرية أعصُراً","في عدلها رغداً وفي إحسانها",30,"ن",3,0],["يا أمين الرشيد أودعك الرا","حل مجداً في الوارثين تليدا",31,"د",2,0],["يا أُمَّ عَمروٍ جَزاكِ اللَهُ مَغفِرَةً","رُدّي عَلَيَّ فُؤادي كَالَّذي كانا",32,"ن",2,0],["يا أُمَّ عُثمانَ إِنَّ الحُبُّ عَن عَرضٍ","يُصبي الحَليمَ وَيُبكي العَينَ أَحيانا",32,"ن",2,0],["يا أُمَّ عُثمانَ ما تَلقى رَواحِلُنا","لَو قِستِ مُصبَحَنا مِن حَيثُ مُمسانا",32,"ن",2,0],["يا أُمَّ حَرزَةَ إِنَّ العَهدَ زَيَّنَهُ","وُدٌّ كَريمٌ وَسِرٌّ غيرُ مَنثورِ",33,"ر",1,0],["يا أُمَّ طَلحَةَ ما لَقينا مِثلَكُم","في المُنجِدينَ وَلا بِغَورِ الغائِرِ",34,"ر",1,0],["يا أُمَّ ناجِيَةَ السَلامُ عَلَيكُمُ","قَبلَ الرَواحِ وَقَبلَ لَومِ العُزَّلِ",35,"ل",1,0],["يا أُمَّتا لاتَحزَني","وَثِقي بِفَضلِ اللَهِ فِيَّه",36,"ي",2,0],["يا أُمَّتا لاتَيأَسي","لِلَّهِ أَلطافٌ خَفِيَّه",36,"ي",2,0],["يا أُمَّتا هَذِهِ مَنازِلُنا","نَترِكُها تارَةً وَنَنزِلُها",37,"ل",3,0],["يا أُمَّتا هَذِهِ مَوارِدُنا","نَعُلُّها تارَةً وَنُنهَلُها",37,"ل",3,0],["يا إماماً في مدح علياه صدقٌ","قد محا كذب غير مدحك ماح",38,"ح",1,1],["يا إماماً له علومٌ وجدْوى","كاملٌ بحرها سريعٌ مديد",39,"د",1,0],["يا أميناً بالتقى معتضداً","فهو مهديٌّ وهادٍ ورشيد",40,"د",1,0],["يا أميراً زادت يداه لعافٍ","وأجادت يوم الحروب جهادا",41,"د",2,1],["يا إماماً لم يزل في الفض","ل ذا كف صناعي",42,"ي",1,1],["يا إماماً إن هان قدرِي فلي من","خمس بمناك عائدات بنفع",43,"ع",1,0],["يا إمام التقى مضى ربع عامٍ","من وصولي ولم يصل ليَ ربع",44,"ع",1,1],["يا إماماً صفاته","ذات فضل مكمل",45,"ل",1,1],["يا إماماً قال المقلد والعا","لم فيه بواجبِ التفضيل",46,"ل",1,1],["يا إمام التقى كذا كلّ عيدٍ","تتلقى هناً وتمنح نعمى",47,"م",2,1],["يا أميراً ناصر المنتمي","حبَّذا بيت العلا والمدح معنى",48,"ن",2,0],["يا إماماً إذا المفاخر نادت","هُ مشى ساحب الذيول مدلا",49,"ل",2,0],["يا إماماً تهوي الغمائم من خل","ف عطاياه سجَّداً وبكيَّا",50,"ي",2,0],["يا إماماً له مقام سنيّ","وثناء في الخافقين وفيّ",51,"ي",1,1],["يا أماني الوفدِ هنيتِ بهِ","الندى حيث الهدى حيث الثنا",52,"ن",2,0],["يا إمام الهُداة في كل أرضٍ","جعل الله من عَصاك حصيدَكْ",53,"ك",1,0],["يا إمام الناس زِدْهُ نعمةً","لا تزل كفُّك كفاً قادره",54,"ر",2,0],["يا امرأ التَيس يا حليفَ القوافي","حلق اللَهُ رأسكَ المصفوعا",55,"ع",2,0],["يا أميناً عنده مؤتمناً","كُنْ على المجد أميناً مؤتَمَن",56,"ن",1,0],["يا أُمَّةً في الغَربِ يَنعَمُ شَطرُها","رِفقاً بِشَطرٍ بائِسٍ مَنهوكِ",57,"ك",1,0],["يا آمَلي العادات مِن نَفَحاتِنا","كُفّوا فَإِنَّ الدَهرَ كَفّ أَكُفّنا",58,"ن",2,0],["يا امام القريض بعدك فينا","نفد الشعر الجزل الا بقايا",59,"ي",2,0],["يا اماني فارقيني ويا نفس","وداعا ويا حشاشة جودي",60,"د",2,0],["يا ام كلثوم انا شاكرون فقد","اتيت طائرة فوق القشاعيم",61,"م",1,0],["يا ام كلثوم غنى فالهوى نغم","تلذه الشيب والشبان كلهم",61,"م",1,0],["يا ام كلثوم غنى فالغناء اذا","ذهبت عنا سيبقى عندنا اثرا",61,"ر",2,0],["يا ام كلثوم احييت المنى فينا","من بعد يأس تألمنا به حينا",61,"ن",2,0],["يا ام كلثوم انا امة رزحت","تحت المصائب احقابا فلسلينا",61,"ن",2,0],["يا ام كلثوم ان اليأس يقتلنا","اذا تأبيت والآمال تحيينا",61,"ن",2,0],["يا ام كلثوم حيينا مغردة","حيي الملائك منا والشياطينا",61,"ن",2,0],["يا ام كلثوم ان الشعر ذو نسب","الى الغناء كمثل الشمس قدموس",61,"س",1,0],["يا ام كلثوم ان الامر مشترك","فان سكت فلسنا فيه نتفق",61,"ق",1,0],["يا ام كلثوم غنينا مسلية","فاننا بعد ايام سنفترق",61,"ق",1,0],["يا امير الغناء ايه فانا","قد فتنا بفنك السحار",62,"ر",1,0],["يا امير الغناء انك منا","لجدير بالحمد والاكبار",62,"ر",1,0],["يا أم صدري والنون تذكى الهوى","يا أم كانونٌ لنارٍ تلذع",63,"ع",1,0],["يا أم جربت البكاء وعكسَه","يا أم إن كليهما لا ينفع",63,"ع",1,0],["يا أم طلَّقني فماذا حيلتي","يا أم سرَّحني فماذا أصنع",63,"ع",1,0],["يا أم لا تنأين عني إنني","عما قليل للحياة أودعُ",63,"ع",1,0],["يا أم في نفسي عذابٌ مؤلم","يا أم في قلبي اضطراب موجع",63,"ع",1,0],["يا أم إني إذا بكيت","فلا تلومي على بكائي",64,"ي",1,0],["يا أم أبكي على ضياعي","يا أم ابكي على شبابي",64,"ي",1,0],["يا أم هاتي نبيلا ابني","منه أنل قبلة الوداع",64,"ع",1,0],["يا أم هاتيه لي فمني","قَرُبت ساعة النزاع",64,"ع",1,0],["يا أمة المصطفى جلت حوائجكم","فقدموا الخير علّ الله يقضيها",65,"ي",3,0],["يا أمة بلغت في المجد غايته","وقصر الناس فيه عن مساعيها",66,"ي",3,0],["يا أمّة ولا وطن","يا منزلا لمن سكن",67,"ن",1,0],["يا أمير الحلم لا تضجر فما","خاب من أيدّ بالصبر مُراده",68,"د",2,0],["يا أَمينَ الحُقوقِ أَدَّيتَ حَتّى","لَم تَخُن مِصرَ في الحُقوقِ فَتيلا",69,"ل",2,0],["يا إِمامَ الشُعوبِ بِالأَمسِ وَاليَو","مِ سَتُعطى مِنَ الثَناءِ فَتَرضى",70,"ض",2,0],["يا أُمَّةً بِفَروقَ فَرِّقَ بَينَهُم","قَدَرٌ تَطيشُ إِذا أَتى الأَحلامُ",71,"م",1,0],["ياأُمَّتا أَبصَرَني راكِبُ","يَسيرُ في مُسحَنفِرٍ لاحِبِ",72,"ب",1,1],["يا إِمامَ الهُدى الَّذي اِح","تاطَ لِلدينِ وَا