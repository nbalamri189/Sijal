","https://www.poetsgate.com/ViewPoem.aspx?id=20184",""],[87,"يَا نَاعِسَ الطَّرْفِ، إِلَى كَمْ تَنَامْ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23778&r=&rc=40",""],[113,"لكل مقام في مقال الهوى سر","https://www.aldiwan.net/poem41118.html","عموديه"],[115,"العطرُ أنت (1)","https://www.aldiwan.net/poem24028.html","البسيط"],[133,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[164,"يعقوب عمي وغير بدع","https://www.aldiwan.net/poem46871.html","مخلع البسيط"],[184,"من ذا يكون مجيري من بني زمن","https://www.aldiwan.net/poem43614.html","البسيط"],[187,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[187,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[208,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[209,"حضرنا إلى نهرنا نستقيه","https://www.aldiwan.net/poem46235.html","المتقارب"],[219,"صبرت وما الصبر فيه الشفاء","https://www.aldiwan.net/poem55270.html","المتقارب"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[233,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[235,"أقول لمن يصيخ إلى اصطراخي","https://www.aldiwan.net/poem18130.html","الوافر"],[269,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[269,"من لنفس ثناها","https://www.aldiwan.net/poem52122.html","مجزوء الرمل"],[278,"نشدتك لا تعدم الراح راحا","https://www.aldiwan.net/poem60715.html","المتقارب"],[279,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[280,"إذا جزتما بالعيس دورة آبل","https://www.aldiwan.net/poem32646.html","الطويل"],[303,"بشرى فذا صبح التهاني أسفرا","https://www.aldiwan.net/poem56548.html","الكامل"],[311,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[340,"يا لقلبي من ذكريات الأماني","https://www.aldiwan.net/poem55330.html","الخفيف"],[362,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[362,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[377,"دعك من نهي النهاة","https://www.aldiwan.net/poem48799.html","مجزوء الرمل"],[399,"يا بن خير الورى ومن","https://www.aldiwan.net/poem46910.html","مجزوء الخفيف"],[399,"أغيرك يرجى لخطب نزل","https://www.aldiwan.net/poem46914.html","المتقارب"],[399,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[399,"الآن باح بمضمر الأسرار","https://www.aldiwan.net/poem46978.html","الكامل"],[400,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[406,"ذكر الوفاء خيالك المنتاب","https://www.aldiwan.net/poem32619.html","الكامل"],[407,"ما يلمع البرق إلا حن مغترب","https://www.aldiwan.net/poem67530.html","البسيط"],[436,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[441,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[441,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[446,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[446,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[459,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[459,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[462,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[498,"مر حبيبي ووقف","https://www.aldiwan.net/poem37955.html","مجزوء الرجز"],[504,"بنى الإسلام جدوا في الجهاد","https://www.aldiwan.net/poem2385.html","الوافر"],[534,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[549,"لأنتم آل خير الناس كلهم","https://www.aldiwan.net/poem47379.html","البسيط"],[556,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"],[560,"خير الرثاء الذي بالقلب قد لطفا","https://www.aldiwan.net/poem52788.html","البسيط"],[573,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[573,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[573,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"],[573,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[573,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"],[573,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"],[584,"ودي لكم سادتي بالبعد ما نقصا","https://www.aldiwan.net/poem17572.html","البسيط"]],"verses":[["وُدّي لِخَيرِ الناسِ أَذخَرُهُ","ما كُلُّ وُدٍّ فيكَ أُنفِقُهُ",0,"ق",2,0],["ودَيْرٍ أنَخْنا في قَرارتِهِ العِيسا","بحِلّةِ رُهْبانٍ إلاهُهُمُ عِيسا",1,"س",2,1],["وديوانُ مجْدٍ قدْ تَواتَرَ نقْلُهُ","حَديثُ المَعاني عنْهُ يُرْوَى ويُسْمَعُ",2,"ع",1,0],["وَدِينُ الْهُدَى جِسْمٌ وَذَاتُكَ رُوحُهُ","وَكَمْ وَصْلَةٍ مَا بَيْنَ رُوحٍ وَجُثْمَانِ",3,"ن",1,0],["وديْرٍ قطَعْتُ إليْهِ الفَلا","وجُبْتُ الدُّجى وركِبْتُ البِحارا",4,"ر",2,0],["وَديعَةٌ رُدَّت إِلى رَبِّها","وَمالِكُ الأَرواحِ أَولى بِها",5,"ه",2,1],["وَدِيارُ مِصرٍ لَو وَنَت عَزماتُهُ","عَن نَصرِها لَتَمَكَّنَت فيها العِدى",6,"د",2,0],["وَديباجُ خَدَّيهِ حَكى رَونَقَ الخَمرِ","وَأَلفاظُهُ في النُطقِ كَاللُؤلُؤِ النَثرِ",7,"ر",1,0],["وديعة إن أطربتنا فهي المنى","أجابت وقد ناديتها خفرات",8,"ت",1,1],["ودينٍ أوضحت للناس قبلاً","نواصع آيِهِ سبل الرشاد",9,"د",1,0],["وَدى ماءَةً لَولاهُ جَرَّت دِمائُهُم","مَوارِدَ مَوتٍ مالَهُنَّ مَصادِرُ",10,"ر",1,0],["ودينار وجهٍ غاله صرف دهره","سريعاً كأن الصرف للباس ناقد",11,"د",1,0],["وديار ضدك ذَمته","وسيوف حيلته كليلهْ",12,"ل",2,0],["وديارٌ من الأحبَّة أقوت","فصداها لبعدهم كالأنين",13,"ن",1,0],["وَديني الَّذي اِختارَ الغَديرُ لِنَفسِهِ","وَيا حُسنَ ما اِختارَ الغَديرُ وَما أَحلى",14,"ل",2,0],["وَديني كَديني الشُهبِ تَبدو لِعاشِقٍ","وَقالٍ وَفيها ما يُحِبُّ وَما يُقلى",14,"ل",2,0],["وَديني كَدينِ الغَيثِ إِن سَحَّ لَم يُبَل","أَرَوّى الأَقاحي أَم سَقى الشَوكَ وَالدِفلى",14,"ل",2,0],["وَدَيتَ اِبنَ راعي الإِبلِ إِذ حانَ يَومُهُ","وَشَقَّ لَهُ قَبراً بِأَرضِكَ لاحِدُ",15,"د",1,1],["وَدِيارَ مُلكٍ خَرَّبَتها فِتنَةٌ","وَمُشَيَّداً فيهِ الحَمامُ ظَليلا",16,"ل",2,0],["وَدى ما جَنى قَبلَ المَبيتِ بِنَفسِهِ","وَلَم يَدِهِ بِالجامِلِ العَكَنانِ",17,"ن",1,0],["وَدُيونٍ مَضمونَةٍ مِن عِداتٍ","كَضَمانِ الأَعدادِ مِلءَ الحِياضِ",18,"ض",1,0],["وُدّي لَو قَد كُفيتُ ما قِبَلَ ال","دَهرِ كَما قَد كُفيتُ ما قِبَلي",19,"ل",2,0],["وديرٍ شُغِفْتُ بِغِزلانِه","فكِدْتُ أُقَبِّلُ صُلبانَها",20,"ن",3,0],["وَدَيَّمَ صَوبُ المُزْنِ فيه كأنَّه","نَوالُ أبي إسْحَاقَ صَابَ فدَيَّما",21,"م",2,0],["وَدِياري ما بَينَ دِجلَةَ وَالصَي","رَةِ لا بَينَ دِجلَةٍ وَالصَراةِ",22,"ه",1,0],["وديعةُ السّيلِ في البطحاءِ غَادرها","تقري الرِّماحِ بها الآصالُ والبكرُ",23,"ر",1,0],["وَدَيْدَبَانَاً صَارِخاً فِي الدُّجَى","ارْجِعْ وَرَاءً إِنَّهُ لا أَمَامْ",24,"م",1,0],["ودينٌ وعرضٌ سالمٌ وتعطّفٌ","وصونٌ وثغرٌ باسمٌ وتلطُّفُ",25,"ف",1,0],["ودِّي لكمْ ودي وعهدي بعدكم","عهدي وإنْ لمْ تجمعِ الأيامُ",26,"م",1,0],["وَديسَ بِهِ اِنحِطاطاً بَطنُ وادٍ","مُذ أَعشَبَ شَعرُ لِحيَتِهِ ضَراءَ",27,"ا",2,0],["ودينٌ من شعائِره السّلامُ","يصونُ لواءَهُ جيلاً فجيلا",28,"ل",2,0],["وَدُيوكاً تَدعو الغُرابَ لِصُلحٍ","وَإِوزّينَ أُحرِجَت وَصُقورا",29,"ر",2,0],["وَدينُكَ أَن لا تَتَّقي سائِلاً بَلا","فَإِن قُلتَها لي فَهيَ إِحدى الكَبائِرِ",30,"ر",1,0],["وَدَيدَبانٌ فَوقَ ساباطِهِ","وَالناسُ مُنغِضونَ عَن وَقفَتِه",31,"ت",2,0],["وَدَيمومَةٍ أَدرَجتُها بِشِمِلَّةٍ","تَشَكّى إِلَيَّ عَضَّ نِسعٍ وَأَقتابا",32,"ب",2,0],["وَدينُ مَكَّةَ طاوَعنا أَإِمَّتَهُ","عَصراً فَما بالُ دينٍ جاءَ مِن هَجَرا",33,"ر",2,0],["وَديدَنُ الجَدِّ مَملوكٌ تُنافِرُهُ","كُلُّ النُفوسِ وَتَهوى اللَهوَ وَالدَدَنا",34,"ن",2,0],["وَدينُكَ ما عَلَيَّ الحُكمُ فيهِ","فَأَبغِيَ لِلَّذي أَخفَيتَ بَغيا",35,"ي",2,0],["وديعة الخلد في يدَيهِ","وبوركت فيهما الوديعه",36,"ع",2,0],["وَدينُكَ ما عَلَيَّ الحُكمُ فيهِ","فَأَبغِيَ لِلَّذي أَخفَيتَ نعيا",37,"ع",3,0],["ودينهم بين الشعوب دينهم","يُعيِي على الأيام من يَدينهمْ",38,"م",1,0],["وُدِّي لِرِزْقَ اللّهِ وُدُ تَجِلَّةٍ","لأَخٍ تَحَلَى بِالْكَمَالِ النَّادِرِ",39,"ر",1,1],["وَديعَتي اليَومَ عِندَ رَبّي","نَجمٌ مِنَ النَيِّراتِ هاوِ",40,"و",1,0],["وَدِيعَةُ اللّهِ صِينَتْ في يَدَيْ مَلِكٍ","للّهِ مُرْتَقِب للّهِ مُحْتَسِبِ",41,"ب",1,0],["ودينُهم حُبُّ مِصْرٍ","وغيرُ ذلكَ كُفْر",42,"ر",1,0],["ودينُك دينُ المساواة وهْوَ","من الطبقات -لعمري- براء",43,"ا",2,0],["وديوانهم هي عند الصباحِ","ومضجعهم هي عند المساء",43,"ا",2,0],["ودينُ العُروبةِ -بعد الإِله","وبعد النَّبِيِّينَ- أوطانُها",44,"ن",3,0],["وديوان مجد ضمنت صفحاته","خلال الملوك الغالبين بني نصر",45,"ر",1,0],["ودير أنخنا في قراراته العيسا","بحلة رهبان إلاههم عيسا",46,"س",2,1],["وديكاً يؤذِّنُ في جَمعهم","بأن قد مضى الليلُ إلا إنى",47,"ا",1,0],["وديوانُ \" شوقي \" بما فيه من","صنوفِ البداعةِ روضٌ نضر",48,"ر",1,0],["وديوانُ \" شوقي \" يُجِدُّ الشبابَ","لتأريخِ أُمتَّهِ المُختَصَر",48,"ر",1,0],["وديني الذي اختار الغدير لنفسه","ويا حسن ما اختار اغدير وما أحلى!",49,"ل",2,0],["وديني كدين الشّهب تبدو لعاشق","وقال، وفيها ما يحبّ وما يقلى",49,"ل",2,0],["ودينُ مكّةَ، طاوعنا أئِمّتَهُ،","عصراً، فما بالُ دينٍ جاءَ من هجَرا",50,"ر",2,0],["وَ ديدباناً صارخاً في الدجى","يرجعْ وراءً ؛ إنهُ لاَ أمامْ",51,"م",1,0],["ودين الهوى يا من ولهنا بحبهم","وشب بنا من اجل هجرانهم جمر",52,"ر",1,0],["ودِينُكَ الحَقُّ والقُرآنُ فَصَّلَهُ","والأرضُ مِن غَيرِه بِالظُّلمِ تَقْتَتِلُ",53,"ل",1,0],["وديليسِبْس قد ألقى القنا لي","خضوعاً إذ مررت على القنالِ",54,"ل",1,0],["وُدِّي لهُ كالصبّاحِ عارٍ","ولا أُورِّي ولا أُعَمِّي",55,"ي",1,0],["ودي من الناس أنجو سالما وهمُ","عابوا الأكابر والأشراف والسلفا",56,"ف",2,0],["وَدينُ سِواه العلمُ فيه يوضّحُ","شكوكاً فدينُ المُصطفى هو أسلمُ",57,"م",1,0],["وَدينهُ الحقُّ مفتاحُ الفلاح فما","بِدونهِ بابهُ المقفول مدخولُ",58,"ل",1,0],["ودي لكم صدق بغير تملق","وسوايَ في دعواه غير مصدق",59,"ق",1,1],["ودين ثقيل يهون يهون","سأقضيه مما جنته العيون",60,"ن",1,0],["وديع صريح أمج الرياء","وأعجل بالصفح عن من أساء",61,"ا",2,0],["وَديزَجٍ كَأَنَّهُ أَو","وَلُ صُبحٍ أَورَقِ",62,"ق",1,0],["وَدَيرٍ قَد حَلَلتُ بِهِ","وَرَبُّ الدَيرِ قَد نَعَسا",63,"س",2,0],["وَدِينَكَ لَنْ يَزِينَكَ غَيْرُ دِينٍ","فَرَاعِ تَكُنْ لأَِنْفِ الْخُسْرِ لَاخِ",64,"خ",1,0],["وديان يوم الدين يبرز عرشه","وَيَحكم بين الخلق وَالحمق أَبلج",65,"ج",1,0],["وَديارا لمثلى","فاحَ مسكا ثَراها",66,"ا",3,0],["وَدِيكاً تَرى الصُّفْرَ جِسْماً لَهُ","وَمِن فِضَّةٍ رِيشهُ وَالْجَناحا",67,"ح",2,0],["وديني بتقوى الله يجعلْ بلطفه","لك الله من كلّ المضايق مخرجا",68,"ج",2,0],["وَدَيرُ قُبَيسٍ جَنَّةٌ أَيُّ جَنَّةٍ","مَشارِبُها مَشفوعَةٌ بِالمَآكِلِ",69,"ل",1,0],["ودّي إليكَ يَسوقها بل إنّني","أُبقي الحباءَ فذاك في لن يخطُرا",70,"ر",2,0],["وديعة روح القدس نفسك ردها","فمن واجبات العقل رد الوديعة",71,"ه",1,0],["وديار الاحلام شطت وامسى","كل ما كان عرضة النسيان",72,"ن",1,0],["وديعةُ ربٍّ كان ثُمَّ استَردَّها","فكم ذا أقولُ الدَّهرُ أعطَى وما هَنّا",73,"ن",2,0],["ودينُ مُحمّدٍ في كُلِّ حالٍ","ومُلْكُ مُحمّدٍ لكَ شاكران",74,"ن",1,0],["وَدِيار خالِيات","وَطُلول باليات",75,"ت",1,0],["وديوناً غدا بهنَّ","مَنَامي مُشرّدا",76,"د",2,0],["ودَيْناً عَدا صِيرتُ من أجْلِه","على وَجَلٍ من هجومِ الأَجل",77,"ل",1,0],["ودين آل رسول الله متضحاً","أزاحه عن مزلاتٍ وأخطارِ",78,"ر",1,0],["ودّي على طُولِ المدَى مُتجدّدٌ","وفرائد الأَشعارِ فيكَ شِعاري",79,"ي",1,0],["وديوان أهل الشرك في النار أهله","وليس لهم إلا الخلود يلازم",80,"م",1,0],["وُدّي كَعهدِكَ والدّيارُ قريبةٌ","من قبلِ أن تَتَقَطّع الأسبابُ",81,"ب",1,0],["وُدّي عَلى ما عَهِدتُم في تَجَدُّدِهِ","لا القَلبُ عَنكُم بطولِ النَأيِ يَنقَلِبُ",82,"ب",1,0],["ودَيْنُهُمُ عَلَى الإِسلامِ أَوْلى","ومالُ اللهِ أَوْسَعُ لِلأَداءِ",83,"ا",2,0],["ودينوهم بما دانوا","وجزوا ملكهم اجزا",84,"ا",1,0],["وديار لهو يلتقي","فيها المباكر والمسامر",85,"ر",1,0],["وديار تمثيل بها","أدب لأرباب الخواطر",85,"ر",1,0],["وديار منعرج الثنية ما خلت","منهم ولا امتلأت من الحسرات",86,"ت",1,0],["وديار أنس بالعقيق أحبها","وربى عليها آل علوة خيموا",87,"م",3,0],["ودينٌ وإسلامٌ شددتُ عُراها","بصدرٍ رحيبٍ صدره وقَوامٍ",88,"م",1,0],["ودينٍ حنفيٍّ كأنَّ مُتونَهُ","شبا غَرْقدٍ أو في نواحيه شَيْهمُ",89,"م",1,0],["وديمومةٍ جاوزتها بعصابةٍ","سَرَوا من حسام النائباتِ على حدّ",90,"د",1,0],["ودينِ أصحابِ الهَوى","من خَلَفٍ بعدَ سَلَفْ",91,"ف",1,0],["ودين الله يلحظه أغثنا","بجفن قد تكحّل بالسهاد",92,"د",1,0],["وَدينُ اللَهِ مَعزوزٌ أَثاماً","فَعَزَّ الدينُ وَاِجتُنِبَ الأَثامُ",93,"م",1,0],["وُدّي عليه مقيمٌ لا بَراحَ له","من الزَّمان ورَهْني عندكم عَلِقُ",94,"ق",1,0],["وديننا ما في الورى غيره","وما عداه خدعة الخادع",95,"ع",1,0],["وديعةٌ عندَها كانت فما سَمحَت","بالدُّرِ منها ولكنْ ردَّت الصَّدَفا",96,"ف",2,0],["وُدِّي وَعَيْشِي بعد تودِيعه","ذلك ما حالَ وذا ما حَلاَ",97,"ل",2,0],["وديمةُ كلِّ وليٍّ له","عليه منْهاالوسْمُ كالوشْمِ",98,"م",1,0],["وديعةُ مسكٍ في ثَراها وجْدتُها","فصيِّرتُ لَثْمِي للوَدِيعةِ كالخَتْمِ",99,"م",1,0],["وديارهُم أَخْلَيتَها","فكأَنَّما هِي بَيْتً مَالِك",100,"ك",1,0],["ودينارُ خدٍّ قد كنزت لأَنَّني","عليه بخيلٌ لستُ أَسْخُو بصرفه",101,"ف",2,0],["ودينارُ وجهٍ للحبيب معلَّقٌ","فلو قُرِّب الدينارُ منه تَبَهْرَجا",102,"ج",2,0],["وُدِّي لَكُمْ سَادتي بِالبُعْدِ ما نَقَصَا","وَالقَلْبُ في حُبِّكُمْ بالحَبِّ قَد قُنِصَا",103,"ص",2,1]]}