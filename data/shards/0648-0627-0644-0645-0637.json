{"poems":[[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[5,"أنذرت أعدائي غدا","https://www.aldiwan.net/poem315.html",""],[31,"أقفرت البلخ من عيلان فالرحب","https://www.aldiwan.net/poem6028.html","البسيط"],[31,"أتنكر الدار أم عرفان منزلة","https://www.aldiwan.net/poem6042.html","البسيط"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[31,"ما زال فينا رباط الخيل معلمة","https://www.aldiwan.net/poem6162.html","البسيط"],[48,"قد كان قبلك ذادة ومقاول","https://www.aldiwan.net/poem22413.html","الكامل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6825","الكامل"],[131,"ما هاجك اليوم من رسم وأطلال","https://www.aldiwan.net/poem24261.html","البسيط"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[234,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[242,"حي السلالم بالسلام","https://www.aldiwan.net/poem19799.html","مجزوء الكامل"],[362,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[382,"سقياك سقياك ربعا ظل مبتهجا","https://www.aldiwan.net/poem66893.html","البسيط"],[438,"منتاب مصركما بالرفد مغمور","https://www.aldiwan.net/poem12354.html","البسيط"],[438,"حيث التفت فكثبان وقضبان","https://www.aldiwan.net/poem12748.html","البسيط"],[443,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[463,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[556,"شاقك البرق اليماني","https://www.aldiwan.net/poem47375.html","مجزوء الرمل"],[556,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[556,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48505","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63998","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63814","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119868","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96454","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49912","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49991","الكامل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20595","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113056","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21626","البسيط"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21641","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216559",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131208",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135578","الرجز"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130531","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102738","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94639","الكامل"],[4755,"لِلفاتِحِينَ الجَوَّ لِلطائراتْ","https://www.poetsgate.com/ViewPoem.aspx?id=184207",""],[5213,"وجد تذوب له الجوانح","https://www.poetsgate.com/ViewPoem.aspx?id=170432",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""],[5455,"باب النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=213952",""],[5573,"اتعبني التقسيم والطرح والضرب","https://www.poetsgate.com/ViewPoem.aspx?id=200090",""],[5606,"يحسب إن الفوزياجي بالرشاوي","https://www.poetsgate.com/ViewPoem.aspx?id=198631",""],[6115,"لويروب الماء","https://www.poetsgate.com/ViewPoem.aspx?id=180466",""]],"verses":[["وَالمُطعِمونَ وَما عَلَيهِم نِعمَةٌ","وَالأَكرَمونَ أَباً وَمَحتِدَ خالِ",0,"ل",1,0],["وَالمُطعِمَونَ الضَيفَ حينَ يَنوبُهُم","مِن لَحمِ كومٍ كَالهِضابِ عِشارِ",1,"ر",1,0],["وَالمُطعِمينَ لَدى الشِت","ءِ سَدائِفاً مِنَ النَيبِ غُرّا",2,"ر",2,0],["وَالمُطعِمُ الكومَ لا يَنفَكُّ يَعقِرُها","إِذا تَلاقى رِواقُ البَيتِ وَاللَهَبُ",3,"ب",1,0],["وَالمُطعِمونَ إِذا ما أَزمَةٌ أَزَمَت","وَالمُقدِمونَ عَلى الغاراتِ بِالجِذَمِ",4,"م",1,0],["وَالمُطعِمينَ عَلى ما كانَ مِن إِزَمٍ","إِذا أَراهيطُ مَلّوا ذاكَ أَو خَدَعوا",5,"ع",3,0],["وَالمُطعِمينَ إِذا هَبَّت شَآمِيَةً","تُزجي الجَهامَ سَديفَ المُربِعِ الواري",6,"ر",2,0],["وَالمُطلَقاتُ مِنَ النُفوسِ كَأَنَّما","جُمِعَت لَها الأَغلالُ وَالأَقيادُ",7,"د",1,0],["وَالمُطعِمينَ لَدى الشِتا","ءِ سَدائِفاً مِنَ النَيبِ غُرّا",8,"ر",2,0],["وَالمُطعِمينَ إِذا هَبَّت شآمِيَةٌ","تَذري الهَشيمَ وَثَمَّ الدِندَنِ البالي",9,"ل",2,0],["وَالمَطعِمينَ إِذا هَبَّت شَآمِيَةٌ","نَكباءُ تَقلَعُ كسرَ البَيتِ بِالطُنُبِ",10,"ب",1,0],["وَالمُطعِمُ الضِيفانَ مِن قَمَعِ الذُرى","عَبطاً إِذا ما ضُنَّ بِالجُلّامِ",11,"م",1,0],["والمطعِمين إذا الرياح تناوحت","شُعْثَ الأَرامِلِ واليتامَى الجُوّعا",12,"ع",2,0],["وَالْمُطْعِمِينَ لِمَنْ يَمُرُّ","بِطَرِيقِهِمْ مُرَّ الطَّعَامِ",13,"م",1,0],["والمُطعِمونَ إِذِ السِّنونَ تَتابَعَت","والمُحسِنونَ كَفَالة الأَيتامِ",14,"م",1,0],["والمطايا نَواحلٌ قد طَوتْها ال","بيدُ ضُمْراً ممّا طَوين البِيدا",15,"د",2,0],["والمطهر العدل جارٍ في تصرفها","من خلصته وفت عن دينه فنجا",16,"ج",2,0],["والمطلقينَ الثَّناءَ الجَمَّ في شِيَمٍ","ببعضِهِنَّ الثَّناءُ الجَمُّ مأْسورُ",17,"ر",1,0],["والمطعمون الجفانَ البيضَ ساطعةً","تُردُّ عنهنّ أحداقٌ وأجفانُ",18,"ن",1,0],["والمطايا تبديها البيد حتى","رحن من شدّة الرجا أنضاء",19,"ا",2,0],["والمُطْلِعُونَ نُجومَ المُلكِ إِذْ أفلتْ","والكافِلونَ بعِزِّ الحقِّ إِذْ هانا",20,"ن",2,0],["والمطعمين إذا انبرت سَنةٌ","عضَّاضةٌ بنيوبها العُصْلِ",21,"ل",1,0],["والمطايا تخلِط المَعْ","جَ كَلالاً بالسِّواكِ",22,"ك",1,0],["والمطايا كالحنايا","غالها البعدُ السَّحيقُ",23,"ق",1,0],["وَالمَطايا منَ الكلالِ على رَمْ","لٍ زَرودٍ قدِ اِفتَرشْنَ الضّلوعا",24,"ع",2,0],["والمطايا يوم السّقيفةِ ما رُح","حلْنَ إِلّا تَعمّداً لعذابي",25,"ب",2,0],["والمطمئن إلى الأقدار أنت بما","أعددته وشعوب الأرض تضطرب",26,"ب",1,0],["والمطلع الميمون حيث الموكب ال","مشهور قام يموج في أضوائه",27,"ا",3,0],["والمطمعي من غيرهِ بجزيل ما","يوليه فيما ليس فيه أَطْمع",28,"ع",1,0],["والمطعمين يتيماً","والمطعمينَ أسيرا",29,"ر",2,0],["والمطرف الراجي ندا","ه بمطرف منه ومتلد",30,"د",1,0],["وَالمُطعِمِينَ إِذَا الرِّيَاحُ تنَاوَحَت","بِقَتَامِهَا فِى كُلِّ عَامٍ مُمحِلِ",31,"ل",1,0],["والمطعمونَ من الكُوم العَبيطَ إذا","هبَّتْ على الحيَّ بالصَّرداءِ نكْباءُ",32,"ا",2,0],["والمطعم الأضياف طيَّبَ ماله","زمن المحول غداة ريح زَعْزَعِ",33,"ع",1,0],["وَالمُطعِمونَ إِذا الرياحُ تَناوحَت","وَرِجالُ مَكَّةَ مِسنِتونَ عِجافُ",34,"ف",1,0],["وَالمَطايا تَكادُ تَدخُلُ في الأَخ","راتِ سُقماً مِنَ الذَمِيلِ وَضُمرا",35,"ر",2,0],["والمطرب الشادي لد","يه يصيح منه المزهر",36,"ر",1,0],["والمطرب الصداع لست أعده","في الطير قبل إلا بقع النعاق",37,"ق",1,0],["والمطلقُ المشهورُ من نَجراشي","لِبُتَّمَ العقربُ يا ذا الماشي",38,"ي",1,0],["والمَطلقُ المشهورُ خُذ أخباري","من بُتَّمَ القُطبُ لِتَكوَى باري",38,"ي",1,0],["وَالمُطمِعينَ إِذا ما شَتوَةٌ أَزَمَت","فَالناسُ شَتّى إِلى أَبوابِهم شَرَعُ",39,"ع",1,0],["وَالمُطعِمِ الناسَ إِذا حارَدَت","نَكباؤُها في الزَمَنِ العارِمِ",40,"م",1,0],["والمطر لَي غَرَّق اهواسي","ليت بَلّ اهواسِك بنفَّه",41,"ف",2,0],["والمطمئن إلى الغضاضة شأنه","أن يستبد به الذي يتحكم",42,"م",1,0],["والمطعم انسب لعديٍ وأبو","البحتري بن هشام حَسَبوا",43,"ب",3,0],["والمطعمين اذا الرياح تناوحت","حتى تغيب الشمس في الرجاف",44,"ف",1,0],["والمطايا في سيرها راقصات","منذ غنت حداتها بارتجاز",45,"ز",1,0],["والمطل يوقع في المومَّل ريبةً","والصدق ينفي الريب بالإنكار",46,"ر",1,0],["والمُطلِقينَ النارَ غَدرًا على","أوجاعِنا والأنفُسِ الحائراتْ",47,"ت",1,0],["والمطلعات من الوجوه","بهن أقماراً لوايح",48,"ح",1,0],["وَالْمُطْعِمينَ سُغُوبَهَا","مُهَجًا تَجودُ بِلَا حُدودِ",49,"د",1,0],["والمطر لا لوّن الشارع .. وقلنا للسحاب :","بللّ أيدينا .. ترى العشّاق أياديهم زهور",50,"ر",1,0],["والمطلع الي يشرق بعينك الغرب","لوتسأله يمكن يجاوب سؤالك",51,"ك",1,0],["والمطمئنه راضيه ماجنت ثرب","تاخذ مطيتها ثبات البرا ..لك",51,"ك",1,0],["والمطوع حقهم يصدر فتاوي","لاعرف يفتي ولا يسدي نصيحه",52,"ح",2,0],["والمطر يعرف من الرعد والبارق","والثعول الغر للنو ماريّه",53,"ي",2,0]]}