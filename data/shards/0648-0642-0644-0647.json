{"poems":[[87,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[45,"عذيري من عذارى من أمور","https://www.aldiwan.net/poem9584.html","الوافر"],[64,"أما الزمان ففي تنبيهه عظة","https://www.aldiwan.net/poem52472.html","البسيط"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[50,"إذا ما وطئ الأمر","https://www.aldiwan.net/poem62575.html","الوافر"],[112,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=8399",""],[139,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[190,"فقالوا هو الزاهي فقلت ولم زها","https://www.aldiwan.net/poem43447.html","الطويل"],[190,"وقائل لي وهو موفور الأسف","https://www.aldiwan.net/poem43618.html","مشطور الرجز"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[236,"نعم إن للبرق اليماني لوعة","https://www.aldiwan.net/poem44585.html","الطويل"],[242,"قصدت أبا علي ذا المعالي","https://www.aldiwan.net/poem18853.html","الوافر"],[273,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[408,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[408,"نسيم الصبا كيف المنازل من نجد","https://www.aldiwan.net/poem46424.html","الطويل"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[563,"يا أيها البارق الذي برقا","https://www.aldiwan.net/poem34294.html","المنسرح"],[563,"ما هذه عندنا الأجسام والصور","https://www.aldiwan.net/poem34482.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138408",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122793","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70983","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96735","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136254","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46530","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49560","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118443","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27320","الوافر"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105675","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103496","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112689","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133266","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95355","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95353","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69956","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133134","الوافر"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205455","المتقارب"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4718,"الحق على خلك قبل تطلع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=137172",""],[5158,"للحلم للشعر وأشياء أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=59128",""],[5437,"ياصاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=143690",""],[5732,"فتى بني وايل","https://www.poetsgate.com/ViewPoem.aspx?id=177900",""],[5893,"رسول الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=141494",""]],"verses":[["وَقُل هاتوا أَفاعِيَكُم","أَتى الحاوي مِنَ الهِندِ",0,"د",1,0],["وَقِلَّةِ ناصِرٍ جوزيتَ عَنّي","بِشَرٍّ مِنكَ يا شَرَّ الدُهورِ",1,"ر",1,0],["وقِلَّةُ الفِكْرِ ما زالت مؤدِّيةً","إِلى عبادةِ مطبوعٍ ومنحوتِ",2,"ت",1,0],["وَقُلَّةٍ كَسِنانِ الرِمحِ بارِزَةٍ","ضَحيانَةٍ في شُهورِ الصَيفِ مِحراقِ",3,"ق",1,0],["وَقُل هَذا قَضاءُ اللَ","هِ هَل تَدفَعُ أَو تَجحَد",4,"د",1,0],["وقلّه؟. رخيص المد .. في بالي غلي","ولانيب مصخيبه ..... ولاني بايعه",5,"ع",2,0],["وقلّه؟ لو الصايم .. يقدّمله جلي","لله...؟ يخلّي كل نكهه رايعه",5,"ع",2,0],["وقلّه بعد.. ماقلت,... جائك مايلي","من راس قومن رسّته... جمايعه",5,"ع",2,0],["وقلّة المالِ إن كادت لتُوبِقُها","لولا كريم تولىّ أمرها حينا",6,"ن",2,0],["وقلة عقل المرء أكثر دائه","وإن كان لا داء أشد من الجهل",7,"ل",1,0],["وقلّة النوم إذا الليل اعتكف","ما الرجل تمشي إنّما يمشي العلف",8,"ف",1,0],["وَقُل هوَ بحرُ اللَّه بالفضلِ زاخرٌ","وَفي مدحهِ فاِستغرقِ النظمَ والنثرا",9,"ر",2,0],["وقل هل لمشتاق يهيم بذكركم","تمادت به الأيام فهو حريض",10,"ض",1,0],["وَقِلَّةِ مُنْجِدِي فِي دِينِ رَبِّي","وَكَثْرَةِ نَاصِرِيَ عَلَى الضَّلاَلِ",11,"ل",1,0],["وَقُل هَل فَشا في الأَرضِ غَيرُ لِسانِهِم","لِسانٌ فُشوَّ الضَوء وَاليَوم شامِسُ",12,"س",1,0],["وَقلَّة الاِصغاءِ لِلدلالَه","وَكَثرَةِ الاِعجابِ بِالضَلالَه",13,"ه",1,0],["وَقِلّة مالٍ جشَّمَتْ عِيْسيَ السَّرى","إلى حيث لا أَلْقَى لِعَظْميَ جابرا",14,"ر",2,0],["وقلةٍ لا عزّ إلاّ مع الغِنَى","فَبِالمال يَسْتكْسِي الفتى حُلَلَ الْحَمْدِ",15,"د",1,0],["وقل هذا شعور الشعب أبدى","أمانيه لتصبح في اشتهار",16,"ر",1,0],["وقل هو الله لا سواه ولا","تقل سواه لطارق طرقا",17,"ق",2,0],["وقل هو الغير ثم الفصل منه له","فالذات وانظر به يكشف لك النظر",18,"ر",1,0],["وقل هذا لدى فضل حليت به","يا من لقد تاه مختالا به الوطن",19,"ن",1,0],["وَقُل هَل كانَ ذاكَ القَلبُ بَيعاً","بِأغلَى نَظرَةٍ أَم كانَ رَهنا",20,"ن",2,0],["وقلةُ شكرٍ عندَ عُظْم مكائدٍ","فهذى لنا منهنَّ شرَّ نكالِ",21,"ل",1,0],["وقُل هل جاوزَ الأحبا","ب في الركبان ركبانا",22,"ن",2,0],["وقلة الكلام والمنام","وحملك الأذى من الأنام",23,"م",1,0],["وقل هل يفوز الصب منكم بنظرة","بها يشتفي فالصب بالبعد مدنف",24,"ف",1,0],["وَقلة الخلاف","وَكَثرة الأَلطاف",25,"ف",1,0],["وقلْ هنالكَ إن الصبَّ حمله","عنه السلام إليكمْ أيها النَّفر",26,"ر",1,0],["وَقُل هِيَ الخَمرُ كَم طابَت لِشارِبِها","وَاِصرَع بِها دَولَةَ الأَحزانِ وَالكَدَرِ",27,"ر",1,0],["وقلة النتف من قبح الصباغ على","ريح تضر بذكران الخنافيس",28,"س",1,0],["وقل هذي اليمينُ يمينُ ربي","وإني الواله الدَّنِف الحزينُ",29,"ن",1,0],["وقل هاك عذرى عن ثناك وشأوه","فلا طاقة لي بالسمو إلى الشهب",30,"ب",1,0],["وَقُلَّةِ طَودٍ مُشمَخِرٍّ شعافُهُ","لمُلتَمسٍ قَصدَ السَبيل مُزيلِ",31,"ل",1,1],["وقلة الأنصار والأعوانِ","وكثرة النفاق والخذلانِ",32,"ن",1,0],["وقلة المال والأسقام تقعدني","والحب ينشرني طورا ويطويني",33,"ن",2,0],["وقلّة العيال قيل أحدُ","من اليسارين كما قد وجدوا",34,"د",3,0],["وقل هو الظُفر من الناس ومن","ذي الحافر الحافر فافهم واستبن",35,"ن",1,0],["وقل هما الخُصيان والخُصيه في","الإِفراد والقوم عُداة فاعرف",36,"ف",1,0],["وَقل هَذا يساق ذاكَ فَضلاً","وَقَد نالَ التَفاوتَ بالتَسامي",37,"ي",1,0],["وقل هذه سبيلي قم عليها","فمن يختار مذهبها رفيقي",38,"ق",2,0],["وقلة نومي على مضجعي","لدى هجعة الأعين النعس",39,"س",1,0],["وَقُل هُوَ ذا بَل غَيرُهُ وَهوَ غَيرُ ما","عَرَفتَ وَعَينُ العِلمِ فَالحَقُّ شائِعُ",40,"ع",1,0],["وقله تراني خاطري بعدها عمس","ياكبر قدري له وياصغر قدره",41,"ر",2,0],["وقله مدامه راح عني ونساني !","مثله بسوي ! ببتعد عنه وانساه",42,"ا",2,0],["وقلّه غديت اليوم إنسان ثاني !","شاعر جريح وكل هالناس تقراه",42,"ا",2,0],["وقلّه حبيبك جار وقته ورصه","يموت واقف مانحنى مثل الاشجار",43,"ر",1,0],["وقله ترى قلبي من الحب مليان","والله يعرف البينه والسريره",44,"ر",2,0],["وقلّه ان الحب دوخني هيام","من فراقه شبّت ضلوعي بنار",45,"ر",1,0]]}