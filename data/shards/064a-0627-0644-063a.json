{"poems":[[95,"انزل المنزل الحسن","https://www.aldiwan.net/poem11260.html","مجزوء الخفيف"],[74,"رشقتني من اللحاظ بغمزه","https://www.aldiwan.net/poem19000.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[112,"علم الغايبيني","https://www.poetsgate.com/ViewPoem.aspx?id=8404",""],[563,"إن روحي بجسمها مصبوغه","https://www.aldiwan.net/poem34362.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64033","السريع"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216640",""],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199640","المسحوب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28524","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97994","الرجز"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[4755,"ثُمَّ باعُوا جَنوبَنا والشمالا","https://www.poetsgate.com/ViewPoem.aspx?id=190112",""],[4805,"هجينيه 2","https://www.poetsgate.com/ViewPoem.aspx?id=176592",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4852,"هيأتُني ورقا","https://www.poetsgate.com/ViewPoem.aspx?id=214349",""],[4869,"انتي صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=151552",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[5601,"في رحم الغد","https://www.poetsgate.com/ViewPoem.aspx?id=23475",""],[5781,"جنونٌ على مراشِفِ الضَّوء","https://www.poetsgate.com/ViewPoem.aspx?id=198553",""],[5843,"وصندوق البريد","https://www.poetsgate.com/ViewPoem.aspx?id=51286",""],[5862,"لوحة شقاوة حُ ب ... !!","https://www.poetsgate.com/ViewPoem.aspx?id=34637",""],[192,"ما أظن","https://www.poetsgate.com/ViewPoem.aspx?id=16325",""],[5970,"ما بقائي في العيش بعد الذي بي","https://www.poetsgate.com/ViewPoem.aspx?id=130636",""],[6113,"ريحة البن","https://www.poetsgate.com/ViewPoem.aspx?id=137096",""]],"verses":[["يَا لَغَبْنِ الكَمَالِ فِي","كُلِّ عِلْمٍ وَكلِّ فَنْ",0,"ن",1,0],["يا لغيداء حسنها يقطع القل","ب وطرفي هو الذي حاز حرزه",1,"ز",2,0],["يَا لُغَةَ العُرْب الَّتِي كاشَفَتْ","طهَ بِمَا صَانَت مِن السرِّ",2,"ر",1,0],["يالغوا يالطيش يالعكش المضلّه","يامجرّدني كذا .... يامعتريني",3,"ن",2,0],["يا لغيب محقق وهو حق","ليس عنه لعاقل زيغوغَهْ",4,"غ",2,0],["يا لغوياً ما تزال استُهُ","أَنطَقَ من فيه بعلم اللغه",5,"غ",2,0],["يَالغالية واعْلَى مِنْ النجم تقدير","غلاك مَا تحسبه بالعَدّ الاعْدَادْ",6,"د",1,0],["يالغضي يا زين لجبالي","خذت روحي عندك ادخيله",7,"ل",2,0],["يا لِغَنيٍّ ما لِناديكُمُ","قَد فَقَدَ الطّارِقَ وَالسّامِرا",8,"ر",2,1],["يالغزال الربرب","في القصر بعد السبسب",9,"ب",1,1],["يا لغاراتٍ بِالعِراقَينِ فَالشامِ","فَمِصرٍ فأرضِ بَحرِ الغَزالِ",10,"ل",1,0],["يا لَغَدرِ الشقيقِ بالنَّصرِ زَعمًا،","أَقبَحُ النّصر ما يَصيرُ احتلالا",11,"ل",2,0],["يالغز عمري وانا حلك","ما رمعتي لك تورالك",12,"ك",1,0],["يالغاليّة لك نوّخ الحب نوّخ","صادق صدوقن والوفا الزامي",13,"م",2,0],["يا لغْزَ عمري ويا .. سِرًّا بأحْجِيَتِي ..","ليت الأنامَ ترى ما بيننا بَرَقَا",14,"ق",2,0],["يالغير بغيابك وفي جيّتك غير","انا بزود الشوق طايح ومنصاب",15,"ب",1,0],["يالغيمات ثقالٍ","اترعت حبا وريّا",16,"ي",2,0],["يا لغة الثورة لا تتعبي","لا تلبسي عباءة الرهبان",17,"ن",1,1],["يا لُغْزَ مَرْثِيَةٍ أعْيَتْكَ نائِلتي","هاتِ السَّليبَ فقَدْ صِرْنا حَفاياهُ",18,"ي",3,0],["يالغالي اللي جيت وانا اغليك جرحك ما برى","تبى تحفر القبر لفوادي وجرحك فالوريد",19,"د",1,0],["يالغالي وينك ، ليه تبعد إيدينك","وأنا أقرّب وأنت تنبض لي : حرمان",20,"ن",1,1],["يالغرام السجن والسجّان غالي والسجين يخاف إطلاق iiالسراح","لو هو في الأوراق قدر الغصن عالي بتاخذ الاوراق اقدار الرياح",21,"ح",1,0],["يالغصن قد كان أمس رطيبا","أصبح اليوم وهو غير رطيب",22,"ب",1,0],["يالغلا والله اني منك مانيب خايف","ميربعض الظروف الله وكيلك يهدن",23,"ن",1,0]]}