{"poems":[[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[37,"ولم أك عند محملها أزوحا","https://www.aldiwan.net/poem7189.html","الوافر"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"قد قلت للعذال عند تتبعي","https://www.aldiwan.net/poem9219.html","الكامل"],[51,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[29,"هل تعرف الدار قد محت معارفها","https://www.aldiwan.net/poem6079.html","البسيط"],[70,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[78,"قبر الغريب سقاك الرائح الغادي","https://www.aldiwan.net/poem14236.html","البسيط"],[78,"ألا يا مليكا يرتجى ويهاب","https://www.aldiwan.net/poem14278.html","الطويل"],[89,"وما الارض والانسان يجثم فوقها","https://www.aldiwan.net/poem44858.html","الطويل"],[43,"تذكرت ما بين العذيب وبارق","https://www.aldiwan.net/poem9734.html","الطويل"],[62,"بدا الحركات ثم انفك عنها","https://www.aldiwan.net/poem52240.html","الوافر"],[45,"رأى البرق مجتازا فبات بلا لب","https://www.aldiwan.net/poem10651.html","الطويل"],[45,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[45,"أعن جوار أبي إسحاق تطمع أن","https://www.aldiwan.net/poem66813.html","البسيط"],[28,"ولما رأيت النفس صار نجيها","https://www.aldiwan.net/poem5277.html","الطويل"],[61,"هجوت أبا العشائر لا لأني","https://www.aldiwan.net/poem51317.html","الوافر"],[66,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[66,"أخلان المدام هجرتموني","https://www.aldiwan.net/poem38749.html","الوافر"],[66,"ملكت ببعض برك رق شكري","https://www.aldiwan.net/poem38795.html","الوافر"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[97,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[46,"تداولني صبح ومسي وحندس","https://www.aldiwan.net/poem22778.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55154","المجتث"],[95,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=720",""],[107,"ياسمينُ التي من حَلبْ","https://www.poetsgate.com/ViewPoem.aspx?id=208770",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[45,"رَأى البرْقَ مُجتازاً، فباتَ بلا لُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=31578",""],[51,"لم يزلْ قلْبُهُ إليهم مَشوقا","https://www.poetsgate.com/ViewPoem.aspx?id=29924",""],[129,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[133,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[133,"أجدك أن بينهم أن آنا","https://www.aldiwan.net/poem54722.html","الوافر"],[133,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[133,"رقاب العقل لو تدرين ما بي","https://www.aldiwan.net/poem54880.html","الوافر"],[167,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[170,"أفي كل يوم للخطوب أصالي","https://www.aldiwan.net/poem1650.html",""],[187,"قالوا أتى العيد قلت العيد عادته","https://www.aldiwan.net/poem43794.html","البسيط"],[190,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[211,"يا رب عفواً فإني خائف وجل","https://www.aldiwan.net/poem13305.html","البسيط"],[236,"أسفت وقد نضت عني الليالي","https://www.aldiwan.net/poem31599.html","الوافر"],[271,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[283,"الشعر ما زال لسان الزمان","https://www.aldiwan.net/poem32335.html","السريع"],[298,"أما والهوى حلفا ولست بحانث","https://www.aldiwan.net/poem33311.html","الطويل"],[310,"فما ساءني شيء كما ساءني أخي","https://www.aldiwan.net/poem50281.html","الطويل"],[321,"يا ليتني كنت أغبى الناس كلهم","https://www.aldiwan.net/poem67104.html","البسيط"],[338,"تعارض أسماء الركاب عشية","https://www.aldiwan.net/poem45433.html","الطويل"],[365,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[403,"شعرك يا بن الكرام أضحى","https://www.aldiwan.net/poem46549.html","المنسرح"],[404,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[407,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[438,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[438,"سلام عليكم والتحية تكتب","https://www.aldiwan.net/poem2601.html","الطويل"],[442,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[459,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[459,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[459,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[459,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[459,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[459,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[459,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[459,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[471,"وإني لأهواها وأهوى لقاءها","https://www.aldiwan.net/poem4658.html","الطويل"],[480,"تهاطلت الرسائل منك تترى","https://www.aldiwan.net/poem36932.html","الوافر"],[480,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[514,"علام وقد أذبت القلب شوقا","https://www.aldiwan.net/poem67709.html","الوافر"],[530,"إذا أجبت دعائي فأنت","https://www.aldiwan.net/poem37243.html","مجزوء الرجز"],[552,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[552,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[552,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[552,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[552,"عثرت ولولا انتياش الإله","https://www.aldiwan.net/poem48024.html","المتقارب"],[552,"لا تلمني فليس لي","https://www.aldiwan.net/poem48047.html","مجزوء الخفيف"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[559,"أنا النور المبين ولا أكني","https://www.aldiwan.net/poem33817.html","الوافر"],[562,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[568,"يا حبذا الصرة أهدى لنا","https://www.aldiwan.net/poem69727.html","السريع"]],"verses":[["وَلَم أكُ قَبلَ وَسمِكَ لي مُحِبّاً","فَيَبعُدَ بي بَياضُكَ مِن حَبيبِ",0,"ب",1,0],["ولم أك عند محملها أزوحا","كما يتقاعس الفرس الحزَوَّر",1,"ر",1,1],["ولَمَا كان بين أكمل خلق ال","لاهِ فرقٌ وبين أهل الغباءِ",2,"ا",2,0],["ولما كُرِثْتُ لأن شَيْبيَ شائعٌ","لكنَّ ما يَجْنِي ويُعقِبُ يُكْرِثُ",3,"ث",1,0],["ولم أكُ شارباً إلا بعذب","وإن أعطِشت خمساً بعد خمس",4,"س",1,0],["ولما كنت مثل مستودع الما","ءِ سقاءً مهزَّماً مخروقا",5,"ق",2,0],["ولم أكثر فأوجب عُذر قالٍ","ولم أهجر فأوجب عذرَ سالي",6,"ل",2,0],["ولم أكُ كالتي اختارت فأضحى","من الأسماءِ خيرتُها جُذامُ",7,"م",1,0],["ولم أكنْ عن رجاءٍ فيك مُنصرفاً","ولو عدلتَ بذنب واحد حَضَنا",8,"ن",2,0],["وَلَم أَكُن لِنِساءِ الحَيِّ قَد شَمِطَت","مِنّي المَفارِقُ أَحياناً بِزَوّارِ",9,"ر",1,0],["وَلَم أَكُن أَخدَعُكُم","بِباطِلٍ مُنَمَّقِ",10,"ق",1,0],["وَلَم أَكُن قَبلَ ذاكَ النَعشِ أَعلَمُهُ","أَنَّ الجِبال تَهادى فَوقَ أَعوادِ",11,"د",1,0],["وَلَمّا كَبا جَدّي لَدَيكَ وَلَم يَسُغ","لِنَفسي عَلى سُوءِ المُقامِ شَرابُ",12,"ب",1,0],["ولم اك يوما بالإصابة واثقا","فاني في داج من الليل ارجم",13,"م",1,0],["وَلَمّا كَسا كَعباً ثِياباً طَغَوا بِها","رَمى كُلَّ ثَوبٍ مِن سِنانٍ بِخارِقِ",14,"ق",1,0],["ولما كانت الحركات دوراً","وتحت الدور مركزها الأمينُ",15,"ن",1,0],["وَلَم أَكتَسِب ذَنباً فَتَجزِيَني بِهِ","وَلَم أَجتَرِم جُرماً فَتُعتَبَ مِن ذَنبِ",16,"ب",1,0],["وَلَمّا كَشَّفَتهُ الحَربُ أَعلى","لَها لَهَباً يَهولُ الموقِدينا",17,"ن",2,0],["وَلَم أَكُن بائِعاً بِالرَغبِ عَبدَهُمُ","وَأَنتَ تَطلُبُهُم يا بُهلُ مَجّانا",18,"ن",2,0],["وَلَم أَكُ أَو تَلقى زِياداً مَطِيَّتي","لِأَكحَلَ عَينَي صاحِبي بِهُجوعِ",19,"ع",1,0],["ولم أك بارعا في الهو لكن","تعلمت الحجامة في قفاه",20,"ه",1,0],["وَلَم أَكُن مُستَحدِثاً نِعمَةً","أَفضى بِيَ السَعدُ إِلى نَحسِ",21,"س",1,0],["وَلَم أَكُ تائِباً عَنها وَلَكِن","أَرَدتُ بِأَن أَرى أَهلَ الذِمامِ",22,"م",1,0],["وَلَم أَكُ باذِلاً لِلناسِ وَجهي","وَلا أَنا كاسِبٌ مالاً بِشِعري",23,"ر",2,0],["وَلَم أَكُ قَبلَ يَومِ رَداهُ أَدري","بِأَنَّ الطُربَ بُرجٌ لِلهِلالِ",24,"ل",1,0],["ولم أكن أعرفُ لي مدمعاً","إلا الذي تذرفُه مقلتاك",25,"ك",1,0],["ولمّا كَتبتُ الحبَّ في القلبِ وارتَقَى","إلى الطرْفِ ماءُ الشوقِ أنكَر ما أملى",26,"ل",2,0],["وَلَمّا كُنتُ جارَكُمُ أَبَيتُم","وَشَرُّ مَواطِنِ الحَسَبِ الإِباءُ",27,"ا",2,0],["وَلَمّا كُنتُ جارَهُمُ حَبَوني","وَفيكُم كانَ لَو شِئتُم حِباءُ",27,"ا",2,0],["وَلَم أَكُ نِدّاً لِلكِلابيِّ أَبتَغي","مِنَ السُؤرِ ما فيهِ لِذي شَنَبٍ غَمسِ",28,"س",1,0],["ولم أكنْ أولَ مُغرَى بما","أغرَتْ بهِ حواءَ أو آدما",29,"م",2,0],["ولم أكُنْ ورَسولي حينَ أُرْسِلُهُ","مثْلَ الفَرَزْدَقِ في إرْسالِ وَقّاعِ",30,"ع",1,0],["ولم أَكُن أَجهَلُ ألَحوادثَ وأل","أيَّامَ ما أن يَعِفَّ راغِبُها",31,"ب",3,0],["وَلَمْ أَكَلِّفْكِ إِلاَّ","حُسْنَ اللِّقَاءِ وِصَالاَ",32,"ل",2,0],["ولم أكد اجتلي دربي على حدس","وأستلين عليه المركب الخشنا",33,"ن",2,0],["ولم اكتب الشِعرَ فيكِ","ولكنْ أحَبكِ من نَفسِه فانكتبْ",34,"ب",1,0],["ولمَّا كنتَ كالفجر انبلاجاً","\" وكالعنقاء تكْبُرُ أنْ تُصادا\"",35,"د",2,0],["وَلمْ أكتَسِبْ ذنباً، فتَجزِيَني بهِ،","ولَمْ أجتَرِمْ ذَنْباً، فتَعتُبَ من جرماً",36,"م",2,0],["ولما كنتَ مستودع الما","ءِ سِقاءً مُهزَّما مخروقا",37,"ق",2,0],["ولما كان دينُنا مستقيماً","ولما أينعت لنا ثمراتُه",38,"ت",2,0],["ولَم أكُ في أخذِي لَهُ مُتَكَلِّفاً","فَمَا هُو ِإلاَّ مُختَفٍ بِلِسَاني",39,"ن",2,0],["وَلَم أكُ طَالِباً تِرَةً بَفدرٍ","ولاَ أرضَى لِعَهدِى أن يُخَانَأ",40,"ن",2,0],["ولَم أكُ إِن اُخِذتُ بِمُستَكِينٍ","ورُبَّ فَتًى إِن أُخِذَ استَكَانَا",40,"ن",2,0],["ولَم أكُ هَاتِكاً بِيَدِى حَرِيماً","وإِنَّ لِكُلِّ حَادِثَةٍ لَشَانَا",40,"ن",2,0],["ولم أكن قَاصِداً في حَوكِهَا عَدَداً","أبآى بِكَثرَتِهِ إِن يُقصَدِ العَدَدُ",41,"د",1,0],["ولَم أكُ قَد نَأيتُكِ باختِيَارِى","ولم يَكُ عن قِلاَىَ لَكِ إغتَرَابي",42,"ب",2,0],["ولم أكنْ عالماً قبلَ الحلولِ بهِ","أنِّي أرى رجلاً في بُردَتَيْ رَجُلِ",43,"ل",1,0],["وَلَم أَكُ عارَفتُ اللِئامَ وَلَم أَنُط","حِبالَ خَسيسٍ مِنهُمُ بِحِبالي",44,"ل",2,0],["ولم أكن نهشليا من بني مضر","وكنت أنسب في أبناء سابور",45,"ر",1,0],["وَلمّا كان منه كقاب قوسٍ","بحقٍّ أحرزَ القِدحَ المعلّى",46,"ل",2,0],["ولم أكل في الورى امري الى احد","وليس الا عليك العبد يتكل",47,"ل",1,0],["وَلَم أَكرَه بَياضَ الشَيبِ إِلّا","لِأَنَّ العَيبَ يَظهَرُ بِالنَهارِ",48,"ر",1,0],["ولم أكُ راغباً يوماً لجهلي","بعيشٍ أو بموتٍ من لبيد",49,"د",1,0],["وَلَم أَكُن يَوماً بَخيلاً بِما","نَحَلتُهُ مَن بِقَريضي اِستَعان",50,"ن",1,0],["ولَم أَكتَرِث في الحُبِّ من لوم لائِمٍ","وَلكن سَماعُ اللوم إِحدى الكَوارِثِ",51,"ث",1,0],["وَلَم أَكُ أَرضى بِالَّذي قَد رَضَوا بِهِ","وَلَو جَمَعَت كُل إِلَيَّ المَجامِعا",52,"ع",2,0],["وَلَم أَكُن أَنا فِيَّ عِلمي وَفي أَدَبي","مَن أَحسَنَ الناسِ في ماضٍ وَفي حالِ",53,"ل",1,0],["وَلَم أَكُ مِثلَ الكاهِلِيِّ وَعِرسِهِ","سَقَتهُ عَلى لوحٍ دِماءَ الذَرارِحِ",54,"ح",1,0],["ولم أَك للعُقْبَى قطعْتُ علائقي","ولم أَك للدُّنيا قضَيْتُ شُؤوني",55,"ن",2,0],["ولم أكن شاعراً بأن النبية","كابن النبية شاعِرْ",56,"ر",1,0],["ولم أكرر فيه ما أمليه","ولا بتنكيت أتيت فيه",57,"ه",1,0],["وَلَم أَكُ كالخَطّي أَو غصن بانَةٍ","كَساها بِها فَصل الرَبيع وَدَبَّجا",58,"ج",2,0],["ولما كنت في شعري مجيدا","أنصّ لمدحني ملك مجيد",59,"د",1,0],["ولم أك إذ يممت ربعك منشدا","ولست بمستبق وأنت المهذب",60,"ب",1,0],["ولم أكسب بها إلا الذ","ذنوب بئس من كسب",61,"ب",1,0],["ولم أك في العكوف على هواها","بأوّلِ محسنِ يهوَى مُسِيَّا",62,"ي",2,0],["ولما كنتُمُ يومَ التنائي","مَنيَّةَ نفسه كنتم مُناها",63,"ا",3,0],["ولما كان بعضُ النوم عارا","ملكت على النوى أهداب جفني",64,"ن",2,0],["ولم أك قبلَه لأذمَّ جودي","على أمرٍ وأحمدَ فيه ضنّي",64,"ن",2,0],["ولم أك في صفقِي على يدك التي","خطبت بها مدحي وودّي لأُغبَنا",65,"ن",2,0],["ولم أكُ مع غضَبي إن غضِبتُ","لأهتِكَ إلَّا حريما مصونا",66,"ن",2,0],["ولم أك حاشاي في الغادرين","بكم إن نبا الدهرُ والمارقينا",66,"ن",2,0],["ولم أك لمّا صِدتُه فسرحته","بأول قنّاصٍ تجنّى فأخفقا",67,"ق",2,0],["ولما كفى الأقرانَ في الرَّوع وارتوتْ","صوارمُهُ من حاسرٍ ومسرَّدِ",68,"د",1,0],["ولم أك أحمَدُ أفعالَه","فلي أُسوةٌ ببني أحمدِ",69,"د",1,0],["وَلَم أَكُ لِلإِحسانِ لما اصطَفَيتني","كَفوراً وَلا لاعاً مِن المصر معددا",70,"د",2,0],["ولما كنت للرحمان عبدا","بك الحرية العلياء أحرى",71,"ر",2,0],["ولم أك مثل غيري ذا خداع","يداجيهم لتحصيل الحطام",72,"م",1,0],["ولم أك قبل ذاك أتيت ذنباً","سوى أني نهيتك عن خصال",73,"ل",1,0],["وَلَمْ أَكُنْ مُسْتَحِقّاً","فإنْ رَدَدْتَ فَعَدْلُ",74,"ل",1,0],["ولم أكُ صلبَ العودِ يوم يقودني","أكفٌّ شِدادٌ أو نيوبٌ عواجمُ",75,"م",1,0],["ولَم أكُ قبل اِمتداحي علا","ك إلّا كبُرْدٍ بلا رافلِ",76,"ل",1,0],["ولم أكنْ ذا صامتٍ وناطقٍ","ولم أرُحْ بباقرٍ وجاملِ",77,"ل",1,0],["ولمّا كسوتَ الجِذْعَ منك بشِلْوِه","رَأَينا رجاءً لِلقلوبِ وسولا",78,"ل",2,0],["ولمّا كرعتُك دون الأنامِ","رَوِيتُ وطاب لِيَ المَكْرَعُ",79,"ع",1,0],["ولم أكنْ قبلُ في فضلٍ بمتَّبِعٍ","ولم أكنْ قطُّ في حيٍّ بمدموسِ",80,"س",1,0],["وَلَم أَكُن أَقنع في نَصركمْ","بنَظْمِ أبياتٍ من الشّعرِ",81,"ر",1,0],["ولمّا كفاني الّذي خِفتُهُ","وقد كنتُ في وَسَطِ الخيفةِ",82,"ه",1,0],["وَلَما كان ظافراً","بيّ يوماً مؤنّبي",83,"ب",2,0],["ولم أكُ يوماً قانعاً في فضيلةٍ","بأصلي ولا في مَحتِدٍ بنصابي",84,"ب",2,0],["ولما كنتُ منه بغير فصلٍ","ولا وصلٍ شهدت الكلَّ مني",85,"ن",2,0],["وَلَم أَكُن لِجارَتي غَوّالا","وَلَم أَكُن في جَنبِها جَهّالا",86,"ل",2,0],["وَلَم أَكُن أُخادِعُ الضُلّالا","وَلا لِما حَرَّمتَهُ أَكّالا",86,"ل",2,0],["ولما كان حُلْوُ الشِّعْرِ أقْضَى","لما أسلفتنيه من الأيادي",87,"د",2,0]]}