//www.aldiwanalarabi.com/poemDescription.do?poemId=573841",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""]],"verses":[["وَلَم أكُ قَبلَ وَسمِكَ لي مُحِبّاً","فَيَبعُدَ بي بَياضُكَ مِن حَبيبِ",0,"ب",1,0],["ولم أك عند محملها أزوحا","كما يتقاعس الفرس الحزَوَّر",1,"ر",1,1],["ولَمَا كان بين أكمل خلق ال","لاهِ فرقٌ وبين أهل الغباءِ",2,"ا",2,0],["ولما كُرِثْتُ لأن شَيْبيَ شائعٌ","لكنَّ ما يَجْنِي ويُعقِبُ يُكْرِثُ",3,"ث",1,0],["ولم أكُ شارباً إلا بعذب","وإن أعطِشت خمساً بعد خمس",4,"س",1,0],["ولما كنت مثل مستودع الما","ءِ سقاءً مهزَّماً مخروقا",5,"ق",2,0],["ولم أكثر فأوجب عُذر قالٍ","ولم أهجر فأوجب عذرَ سالي",6,"ل",2,0],["ولم أكُ كالتي اختارت فأضحى","من الأسماءِ خيرتُها جُذامُ",7,"م",1,0],["ولم أكنْ عن رجاءٍ فيك مُنصرفاً","ولو عدلتَ بذنب واحد حَضَنا",8,"ن",2,0],["وَلَم أَكُن لِنِساءِ الحَيِّ قَد شَمِطَت","مِنّي المَفارِقُ أَحياناً بِزَوّارِ",9,"ر",1,0],["وَلَم أَكُن أَخدَعُكُم","بِباطِلٍ مُنَمَّقِ",10,"ق",1,0],["وَلَم أَكُن قَبلَ ذاكَ النَعشِ أَعلَمُهُ","أَنَّ الجِبال تَهادى فَوقَ أَعوادِ",11,"د",1,0],["وَلَمّا كَبا جَدّي لَدَيكَ وَلَم يَسُغ","لِنَفسي عَلى سُوءِ المُقامِ شَرابُ",12,"ب",1,0],["ولم اك يوما بالإصابة واثقا","فاني في داج من الليل ارجم",13,"م",1,0],["وَلَمّا كَسا كَعباً ثِياباً طَغَوا بِها","رَمى كُلَّ ثَوبٍ مِن سِنانٍ بِخارِقِ",14,"ق",1,0],["ولما كانت الحركات دوراً","وتحت الدور مركزها الأمينُ",15,"ن",1,0],["وَلَم أَكتَسِب ذَنباً فَتَجزِيَني بِهِ","وَلَم أَجتَرِم جُرماً فَتُعتَبَ مِن ذَنبِ",16,"ب",1,0],["وَلَمّا كَشَّفَتهُ الحَربُ أَعلى","لَها لَهَباً يَهولُ الموقِدينا",17,"ن",2,0],["وَلَم أَكُن بائِعاً بِالرَغبِ عَبدَهُمُ","وَأَنتَ تَطلُبُهُم يا بُهلُ مَجّانا",18,"ن",2,0],["وَلَم أَكُ أَو تَلقى زِياداً مَطِيَّتي","لِأَكحَلَ عَينَي صاحِبي بِهُجوعِ",19,"ع",1,0],["ولم أك بارعا في الهو لكن","تعلمت الحجامة في قفاه",20,"ه",1,0],["وَلَم أَكُن مُستَحدِثاً نِعمَةً","أَفضى بِيَ السَعدُ إِلى نَحسِ",21,"س",1,0],["وَلَم أَكُ تائِباً عَنها وَلَكِن","أَرَدتُ بِأَن أَرى أَهلَ الذِمامِ",22,"م",1,0],["وَلَم أَكُ باذِلاً لِلناسِ وَجهي","وَلا أَنا كاسِبٌ مالاً بِشِعري",23,"ر",2,0],["وَلَم أَكُ قَبلَ يَومِ رَداهُ أَدري","بِأَنَّ الطُربَ بُرجٌ لِلهِلالِ",24,"ل",1,0],["ولم أكن أعرفُ لي مدمعاً","إلا الذي تذرفُه مقلتاك",25,"ك",1,0],["ولمّا كَتبتُ الحبَّ في القلبِ وارتَقَى","إلى الطرْفِ ماءُ الشوقِ أنكَر ما أملى",26,"ل",2,0],["وَلَمّا كُنتُ جارَكُمُ أَبَيتُم","وَشَرُّ مَواطِنِ الحَسَبِ الإِباءُ",27,"ا",2,0],["وَلَمّا كُنتُ جارَهُمُ حَبَوني","وَفيكُم كانَ لَو شِئتُم حِباءُ",27,"ا",2,0],["وَلَم أَكُ نِدّاً لِلكِلابيِّ أَبتَغي","مِنَ السُؤرِ ما فيهِ لِذي شَنَبٍ غَمسِ",28,"س",1,0],["ولم أكنْ أولَ مُغرَى بما","أغرَتْ بهِ حواءَ أو آدما",29,"م",2,0],["ولم أكُنْ ورَسولي حينَ أُرْسِلُهُ","مثْلَ الفَرَزْدَقِ في إرْسالِ وَقّاعِ",30,"ع",1,0],["ولم أَكُن أَجهَلُ ألَحوادثَ وأل","أيَّامَ ما أن يَعِفَّ راغِبُها",31,"ب",3,0],["وَلَمْ أَكَلِّفْكِ إِلاَّ","حُسْنَ اللِّقَاءِ وِصَالاَ",32,"ل",2,0],["ولم أكد اجتلي دربي على حدس","وأستلين عليه المركب الخشنا",33,"ن",2,0],["ولم اكتب الشِعرَ فيكِ","ولكنْ أحَبكِ من نَفسِه فانكتبْ",34,"ب",1,0],["ولمَّا كنتَ كالفجر انبلاجاً","\" وكالعنقاء تكْبُرُ أنْ تُصادا\"",35,"د",2,0],["وَلمْ أكتَسِبْ ذنباً، فتَجزِيَني بهِ،","ولَمْ أجتَرِمْ ذَنْباً، فتَعتُبَ من جرماً",36,"م",2,0],["ولما كنتَ مستودع الما","ءِ سِقاءً مُهزَّما مخروقا",37,"ق",2,0],["ولما كان دينُنا مستقيماً","ولما أينعت لنا ثمراتُه",38,"ت",2,0],["ولَم أكُ في أخذِي لَهُ مُتَكَلِّفاً","فَمَا هُو ِإلاَّ مُختَفٍ بِلِسَاني",39,"ن",2,0],["وَلَم أكُ طَالِباً تِرَةً بَفدرٍ","ولاَ أرضَى لِعَهدِى أن يُخَانَأ",40,"ن",2,0],["ولَم أكُ إِن اُخِذتُ بِمُستَكِينٍ","ورُبَّ فَتًى إِن أُخِذَ استَكَانَا",40,"ن",2,0],["ولَم أكُ هَاتِكاً بِيَدِى حَرِيماً","وإِنَّ لِكُلِّ حَادِثَةٍ لَشَانَا",40,"ن",2,0],["ولم أكن قَاصِداً في حَوكِهَا عَدَداً","أبآى بِكَثرَتِهِ إِن يُقصَدِ العَدَدُ",41,"د",1,0],["ولَم أكُ قَد نَأيتُكِ باختِيَارِى","ولم يَكُ عن قِلاَىَ لَكِ إغتَرَابي",42,"ب",2,0],["ولم أكنْ عالماً قبلَ الحلولِ بهِ","أنِّي أرى رجلاً في بُردَتَيْ رَجُلِ",43,"ل",1,0],["وَلَم أَكُ عارَفتُ اللِئامَ وَلَم أَنُط","حِبالَ خَسيسٍ مِنهُمُ بِحِبالي",44,"ل",2,0],["ولم أكن نهشليا من بني مضر","وكنت أنسب في أبناء سابور",45,"ر",1,0],["وَلمّا كان منه كقاب قوسٍ","بحقٍّ أحرزَ القِدحَ المعلّى",46,"ل",2,0],["ولم أكل في الورى امري الى احد","وليس الا عليك العبد يتكل",47,"ل",1,0],["وَلَم أَكرَه بَياضَ الشَيبِ إِلّا","لِأَنَّ العَيبَ يَظهَرُ بِالنَهارِ",48,"ر",1,0],["ولم أكُ راغباً يوماً لجهلي","بعيشٍ أو بموتٍ من لبيد",49,"د",1,0],["وَلَم أَكُن يَوماً بَخيلاً بِما","نَحَلتُهُ مَن بِقَريضي اِستَعان",50,"ن",1,0],["ولَم أَكتَرِث في الحُبِّ من لوم لائِمٍ","وَلكن سَماعُ اللوم إِحدى الكَوارِثِ",51,"ث",1,0],["وَلَم أَكُ أَرضى بِالَّذي قَد رَضَوا بِهِ","وَلَو جَمَعَت كُل إِلَيَّ المَجامِعا",52,"ع",2,0],["وَلَم أَكُن أَنا فِيَّ عِلمي وَفي أَدَبي","مَن أَحسَنَ الناسِ في ماضٍ وَفي حالِ",53,"ل",1,0],["وَلَم أَكُ مِثلَ الكاهِلِيِّ وَعِرسِهِ","سَقَتهُ عَلى لوحٍ دِماءَ الذَرارِحِ",54,"ح",1,0],["ولم أَك للعُقْبَى قطعْتُ علائقي","ولم أَك للدُّنيا قضَيْتُ شُؤوني",55,"ن",2,0],["ولم أكن شاعراً بأن النبية","كابن النبية شاعِرْ",56,"ر",1,0],["ولم أكرر فيه ما أمليه","ولا بتنكيت أتيت فيه",57,"ه",1,0],["وَلَم أَكُ كالخَطّي أَو غصن بانَةٍ","كَساها بِها فَصل الرَبيع وَدَبَّجا",58,"ج",2,0],["ولما كنت في شعري مجيدا","أنصّ لمدحني ملك مجيد",59,"د",1,0],["ولم أك إذ يممت ربعك منشدا","ولست بمستبق وأنت المهذب",60,"ب",1,0],["ولم أكسب بها إلا الذ","ذنوب بئس من كسب",61,"ب",1,0],["ولم أك في العكوف على هواها","بأوّلِ محسنِ يهوَى مُسِيَّا",62,"ي",2,0],["ولما كنتُمُ يومَ التنائي","مَنيَّةَ نفسه كنتم مُناها",63,"ا",3,0],["ولما كان بعضُ النوم عارا","ملكت على النوى أهداب جفني",64,"ن",2,0],["ولم أك قبلَه لأذمَّ جودي","على أمرٍ وأحمدَ فيه ضنّي",64,"ن",2,0],["ولم أك في صفقِي على يدك التي","خطبت بها مدحي وودّي لأُغبَنا",65,"ن",2,0],["ولم أكُ مع غضَبي إن غضِبتُ","لأهتِكَ إلَّا حريما مصونا",66,"ن",2,0],["ولم أك حاشاي في الغادرين","بكم إن نبا الدهرُ والمارقينا",66,"ن",2,0],["ولم أك لمّا صِدتُه فسرحته","بأول قنّاصٍ تجنّى فأخفقا",67,"ق",2,0],["ولما كفى الأقرانَ في الرَّوع وارتوتْ","صوارمُهُ من حاسرٍ ومسرَّدِ",68,"د",1,0],["ولم أك أحمَدُ أفعالَه","فلي أُسوةٌ ببني أحمدِ",69,"د",1,0],["وَلَم أَكُ لِلإِحسانِ لما اصطَفَيتني","كَفوراً وَلا لاعاً مِن المصر معددا",70,"د",2,0],["ولما كنت للرحمان عبدا","بك الحرية العلياء أحرى",71,"ر",2,0],["ولم أك مثل غيري ذا خداع","يداجيهم لتحصيل الحطام",72,"م",1,0],["ولم أك قبل ذاك أتيت ذنباً","سوى أني نهيتك عن خصال",73,"ل",1,0],["وَلَمْ أَكُنْ مُسْتَحِقّاً","فإنْ رَدَدْتَ فَعَدْلُ",74,"ل",1,0],["ولم أكُ صلبَ العودِ يوم يقودني","أكفٌّ شِدادٌ أو نيوبٌ عواجمُ",75,"م",1,0],["ولَم أكُ قبل اِمتداحي علا","ك إلّا كبُرْدٍ بلا رافلِ",76,"ل",1,0],["ولم أكنْ ذا صامتٍ وناطقٍ","ولم أرُحْ بباقرٍ وجاملِ",77,"ل",1,0],["ولمّا كسوتَ الجِذْعَ منك بشِلْوِه","رَأَينا رجاءً لِلقلوبِ وسولا",78,"ل",2,0],["ولمّا كرعتُك دون الأنامِ","رَوِيتُ وطاب لِيَ المَكْرَعُ",79,"ع",1,0],["ولم أكنْ قبلُ في فضلٍ بمتَّبِعٍ","ولم أكنْ قطُّ في حيٍّ بمدموسِ",80,"س",1,0],["وَلَم أَكُن أَقنع في نَصركمْ","بنَظْمِ أبياتٍ من الشّعرِ",81,"ر",1,0],["ولمّا كفاني الّذي خِفتُهُ","وقد كنتُ في وَسَطِ الخيفةِ",82,"ه",1,0],["وَلَما كان ظافراً","بيّ يوماً مؤنّبي",83,"ب",2,0],["ولم أكُ يوماً قانعاً في فضيلةٍ","بأصلي ولا في مَحتِدٍ بنصابي",84,"ب",2,0],["ولما كنتُ منه بغير فصلٍ","ولا وصلٍ شهدت الكلَّ مني",85,"ن",2,0],["وَلَم أَكُن لِجارَتي غَوّالا","وَلَم أَكُن في جَنبِها جَهّالا",86,"ل",2,0],["وَلَم أَكُن أُخادِعُ الضُلّالا","وَلا لِما حَرَّمتَهُ أَكّالا",86,"ل",2,0],["ولما كان حُلْوُ الشِّعْرِ أقْضَى","لما أسلفتنيه من الأيادي",87,"د",2,0],["ولم أكن قبلها بالشوق أقتلها","إلا لعلمي بأن الشوق يحييها",88,"ي",3,0],["وَلَما كانَ سِرحاناً","بَعثناه إِلى الذِئب",89,"ب",1,0],["ولم أكُ بالجسور على سُلُوٍّ","فقد علَّمتني الآنَ الجساره",90,"ر",2,0],["ولم أكن وشبابي الغض مقتبل","لحمل أصغر احدى الذرّ صفتيتا",91,"ت",2,0],["وَلَم أكُ بِالآلاءِ مُكتفياً وإن","سَمت وَعَلت لي في العتيكِ مناسبُ",92,"ب",1,0],["ولم أكن أشرح طهر ضافن","ولا أشد للسرى وضينا",93,"ن",2,0],["ولم أكن غير امرئ مدنف","كثير تحنان وتسآلِ",94,"ل",1,0],["وَلَم أَكُن أغلط في مثله","لَكن دَهَتني ثِقَتي بالشفيع",95,"ع",1,0],["وَلَم أَكُن أحبهُم بِالطبع","فَلَم أَزَل أَخصهم بِالمَنع",96,"ع",1,0],["ولما كانت الذكرى لمجد","أتتها غرةُ الصوم المكينِ",97,"ن",1,0],["وَلَم أَكُ مشغولاً بِسابورَ عَنكُمُ","وَبِالسَفحِ إِذ نَغشى صُدورَ الغَواشِمِ",98,"م",1,0],["ولم أكُ مثل الطيف إن رام وجهة","مضى آخذاً إذن العيون الهواجع",99,"ع",1,0],["ولم أك أدري أنهّم يغدرون بي","وقد كنت في حبيّ لهم متفانيا",100,"ي",2,0],["ولما كنتَ بغدادَ القَوافي","جلبتُ إليكَ ماءَ الرافدين",101,"ن",1,0],["ولم أك ذا نفسٍ علىالخطب مرة","عزيزٌ عليها أن تراني خاملا",102,"ل",2,0],["وَلَم أَكُ في حَرِّ الكَريهَةِ مُحجِماً","إِذا لَم يَكُن في الحَربِ لِلوِردِ مَصدَرُ",103,"ر",1,0],["ولما كان في ذا العصر فرداً","مدحناه بعنوان الكنايه",104,"ا",3,0],["ولم أَكس أَرجاءَ الفضاء جماجما","يضيق بها مبسوطةً وتريبا",105,"ب",2,0],["ولم أك قبلَ حبِّكَ ذا نظامٍ","وليس إليَّ شِعرٌ قطُّ يسندْ",106,"د",1,0],["ولم اك يوماً من الثائري","ن ولست من العالم المقلق",107,"ق",1,0],["ولما كانت الأسماء باسمي","كذاك له السماتُ من أصل وسمي",108,"م",2,0],["ولما كنت مختاراً حبيباً","وكان بُراق سيري بي كريما",109,"م",2,0],["ولما كنتُ مرضياً حَصوراً","وكان أمامَ وقتِ الشمسِ ميما",109,"م",2,0],["ولم أكن عند قولي","إني بربي نسيّا",110,"ي",2,0],["وَلَمّا كُنتُ أَطرَبُ لِلغَوادي","ظَنَنتُ خَلائِقي زَهرَ الغَميمِ",111,"م",1,0],["ولم اكره الاوطان او قرب اهلها","وعن ملتي واللّه ما انا راغب",112,"ب",1,0],["وَلَم أَكُن لِنضار الشعر منتَقِدا","وَيَوم لي بابليُّ اللَحظ مِنكَ بَدا",113,"د",2,0],["وَلماك ري العاشقين فَهَل جَرى","ضَرب بَريقك أَم ضريب شمول",114,"ل",1,0],["وَلَم أَكُ للناس المسيئين أَحسِنُ","فَيا قَوم عَني بِالنَدامة أَعلنوا",115,"ن",3,0],["ولم أكسب الحمق لكنني","خلقت رقيعاً كما ترى",116,"ا",1,0],["ولماك العذب الالعس","قد مزج فيه شرابين",117,"ن",1,0],["ولَم أكُن أجعَلُ في المَنظومَه","علماً بلا تَجرِبَةٍ مَعلومَه",118,"ه",1,0],["ولم أك ذا نذب اليك وإنما","حميت ذماماً رمت تغرق بالسيف",119,"ف",1,0],["ولما كسوه وقد زاد نوراص","يفيض سناه على من يزور",120,"ر",1,0],["ولم أكن في سمو مجدي","ساويت كعباً ولا كلابا",121,"ب",2,0],["ولم أكن حرفتي في رصفها أدبٌ","وإن أليَّ تناهت نوبة الأدب",122,"ب",1,0],["ولما كان للخلافة ذكر","خالد تحتفي به الأحقاب",123,"ب",1,0],["ولم أكُ نجواً للخوارج إذ بغوا","على قتل عثمان بسطوةِ ذي شُطبِ",124,"ب",1,0],["ولم أكُ سلماً لابن ملجم إذ سطا","لحربِ عليٍّ والهوان لذي الحربِ",124,"ب",1,0],["ولم أكُ في قتل الحسينِ مجرِّداً","لصِمامتي أو أن يذاد عن الشُّربِ",124,"ب",1,0],["ولم أك قطّ بالجاني وإلا","فكل جنايتي حب الجمال",125,"ل",1,0],["ولم أكشف دفين الأرض لكن","دفينا في نفوس العالمينا",126,"ن",2,0],["ولم اكُ قد وقعت به اختياراً","ولكني زلقت فهدَّ ركني",127,"ن",2,0],["ولم أك أخشى به بطنه","تهد القوى وتديم السقام",128,"م",1,0],["ولم أك نواحا على رسم دارها","بعين وكوف بالدموع ذروف",129,"ف",1,0],["ولم أك للتقدم في أوام","أهيم بذكره في كل واد",130,"د",1,0],["ولم أكن أعرف فيها أحدا","سواه أبغي عنده ملتحدا",131,"د",2,0],["وَلَم أَكُ قَوّالاً وَلَم أَكُ ناظِماً","وَلَكِن صَفا وُدّي فَلَذَّ لِيَ الشِعرُ",132,"ر",1,0],["ولم أكُ أدري أنّ أُخوتَها القَنا","وأنّ الظُّبا آباؤُها وجدودُها",133,"د",3,0],["ولمْ أكُ ذا جَهْلٍ بأن تملِكَ الوَرَى","فقدْ كان مَولانا بذلِكَ مُعْلِمِي",134,"م",2,0],["ولم أك قد نظمت الا مناقباً","اضاءت نجوما في سما الفضل بزغا",135,"غ",2,0],["وَلَم أَكُ قَد قَضَيتُ دُيونَ نَفسي","وَلا حَقَّ المُهَنَّدِ وَالسِنانِ",136,"ن",1,0],["ولم أك بعده حيا ولكن","برغمي كانت الأقدار تجري",137,"ر",2,0],["ولم اك مخدوعاً بهم غير أنني","صبرت ملياً والكريم صبور",138,"ر",1,0],["ولم أك أدري قبل مرآك أنني","سأنظر بدرا فوق غصن النقا يبدو",139,"د",2,0],["ولم أك أدري والحوادث جمةٌ","أناديك أم شم المعاقل أمنع",140,"ع",1,0],["ولم أك أدري حين يطريك شاعرٌ","اذكرك أم عرف الأزاهير أضوع",140,"ع",1,0],["وَلَمّا كَسَرتُ لَهُ جَردَقاً","وَمَن ذا يُطيقُ لَهُ كَسرَ جَردَق",141,"ق",1,1],["وَلَم أَكُن حَيثُ بُستانٌ وَلا نَهر","فَرادَ لَحظي وَفِكري مِنهُ بُستانا",142,"ن",2,0],["ولم أكن أهلاً لذاك الملام","مالذنب ذنبي حين حرمانه",143,"ه",1,0],["ولم أكن أعرف ما هذا الجوى","حتى ابتليت بالذي هد القوى",144,"ق",3,0],["وَلَم أَكُن لِذا المَرامِ أَهلا","فَأَينَ لي بِأَن أَقولَ أَهلا",145,"ل",2,0],["ولماك العذب أحلى مرشفا","من دم الكرم وماء المزن",146,"ن",1,0],["ولم أَكُ في عمري بحالٍ مماذقاً","وما راعَني جور وإن هزَّ مرهفا",147,"ف",2,0],["ولم أكُ بالآتي بذنبٍ تعمداً","وواللَه ذاك الذنب لم يكُ من قلبي",148,"ب",2,0],["وَلَم أَكُ أَدري أَنَّهُ ثُكلُ أُمِّهِ","إِذا قيلَ لِأَحرارِ في الكُربَةِ أَقدُموا",149,"م",3,0],["ولم أكُ لِلتَّقدمِ في أوامٍ","أهيمُ بمدحه في كلِّ واد",150,"د",1,0],["ولم أك عرضي للئام أذيَّهُ","ولو لعبت بي المرهقاتُ الفواصلُ",151,"ل",1,0],["ولَم أكذبْ الحبَّ لمّا صرختُ","أكادُ من الحبِّ يوحَى إليّ",152,"ي",1,0],["ولَمَّا كَبيرُ الكَرشِ أَلْقَى بِرأسِهِ","على الأَرضِ, نادَوْنَا وقالوا تَمَخَّضَا!",153,"ض",2,0],["ولم أَكُن بِمَصِيرِي عابِئًا، فَلَقد","رَضِيتُهُ يَمَنِيًّا.. زانَ.. أَو شَانا",154,"ن",2,0],["ولما كشفن عن الوجوه براقعاً","ولما عطفن على الخصور شعورا",155,"ر",2,0],["ولم أك عن مقدار أكلي ونوعه","وسوء اختيارٍ يا أخيَّ بجاهل",156,"ل",1,0],["ولما كنا رغم الهم شرق","لعقنا الصبر فاغتاضوا انبهارا",157,"ر",2,1],["ولم أك معتمداً فارساً","بفخر يجد لها من درس",158,"س",1,0],["ولما كنت بالأحكام أدري","تحاولها بأحكام الرويه",159,"ي",2,0],["ولم أكتبه مبتغياً ثراءً","ولم أمدح بهِ نذلاً ذليلا",160,"ل",2,0],["ولم أكن أحسب أن المنى","من بعضها وهم عفا باطلا",161,"ل",2,0],["ولم أكن أعلم قبل ختلها","أن الظباء تنصب الحبائلا",162,"ل",2,0],["ولم أك لما التف روعي وروعه","عصارة هجن من نساء ولا أب",163,"ب",1,0],["ولمْ أكْ أستسقي الكؤوسَ إذا صدتْ","وما شِيبَ شهدي العمرَ يوماً بعلقمِ",164,"م",1,0],["ولم أكنْ بالَّذي تؤذيهِ راحلةٌ","وليسَ قلبي الَّذي من بعدُ يندفعُ",165,"ع",1,0],["ولمْ أكنْ في عدادِ الأرضِ قطرَ ندى","إلا كما كانَ جدبُ القطرِ منتشرا",166,"ر",2,0],["ولَم أكذبْ عليكِ، فما وَجَدَّتِ","سِوى رَمْزٍ لِمَن أَرجُوهُ أهلا",167,"ل",2,0],["ولم أك في ردي عليه تعمقاً","بتعقيد ألفاظٍ كمنظوم ذي الأطرا",168,"ر",2,0],["ولم أكفك السري بعدها","إلا إليه رائحاً مبكراً",169,"ر",2,0],["وَلَمْ أَكُ بالآباءِ مُكْتَفِياً وَإِنْ","سَمَتْ وَعَلَتْ بِي فِي العَتِيكِ مَناسِبُ",170,"ب",1,0],["وَ لَم أَكُ ذَاتَ يَوْمٍ فِي اِدِّكَارٍ","وَ لَم أَرْجُ البَّخِيلَ يَكَنْ جَوَادَا",171,"د",2,0],["ولم أكُ راضياً لك أيَّ حزنٍ","على موتي، ولكنّي أموتُ",172,"ت",1,0],["ولم أك محتاجاً بباقي معيشتي","برأيي سوى لِلَّفْظ كي أتقدما",173,"م",2,0],["ولم أك أستسيغ سوى المآسي","عليها قد شَبَبْتُ أنا وعنْسي",174,"س",2,0],["وَلَمْ أَكُ شاعراً حَتى غَزَتني","خَيالاتُ الهَوى قَصْفاً وَحَرْقا",175,"ق",2,0],["ولم أكن مُدركا بالأمسِ نيَّتها","إذ لم يزلْ خافقُ الولهانُ بحارا",176,"ر",2,0],["ولم أكن موضعَ التقصير في مِقَةٍ","أو هزَّ بِيْ غيرُها للعشقِ أوتارا",176,"ر",2,0],["ولَمْ أكْدُ وما ألْقَتْ يَدَاهُ","بآلتِها إلى حَسَيَيْ بَكيِّ",177,"ي",1,0],["ولِما كتبتُ دفاترا نشرت","في ذكرها بين الورى نظما",178,"م",2,0],["ولم أكسه در المديح وإنما","أعرت نجوم الليل بدر تمامه",179,"م",2,0],["وَلَم أَكُ مِمَّن فاتَهُ جَورُ ظالِمٍ","وَلكِنَّني ذَكَّرتُ يَومي بِأَمسِهِ",180,"س",2,0],["وَلَم أَكُ مِمَّن عَقلُهُ عَبدُ قَلبِهِ","فَيَصرِفَهُ عَن قَصدِهِ النَّهيُ وَالأَمرُ",181,"ر",1,0]]}