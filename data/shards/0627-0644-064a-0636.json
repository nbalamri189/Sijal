{"poems":[[40,"عجبت من السارين والريح قرة","https://www.aldiwan.net/poem7684.html","الطويل"],[34,"تذكر أنسا من بثينة ذا القلب","https://www.aldiwan.net/poem27801.html","الطويل"],[58,"هل لكما في اصطباح كأس","https://www.aldiwan.net/poem58573.html","مخلع البسيط"],[438,"لهن ربوع بالعقيق دواثر","https://www.aldiwan.net/poem12468.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64356","المتقارب"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115106","الطويل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18264","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102509","الكامل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34743","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132687","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117853","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18983","الطويل"],[4888,"على شط الخليج","https://www.poetsgate.com/ViewPoem.aspx?id=207741",""],[5525,"تخير","https://www.poetsgate.com/ViewPoem.aspx?id=837",""],[5861,"هسيس الروح","https://www.poetsgate.com/ViewPoem.aspx?id=215789",""]],"verses":[["إِلى ضَوءِ نارٍ يَشتَوي القِدَّ أَهلُها","وَقَد يُكرَمُ الأَضيافُ وَالقِدُّ يُشتَوى",0,"ا",1,0],["إِلى ضَوءِ نارٍ ما تَبوخُ كَأَنَّها","مِنَ البُعدِ وَالإِقواءِ جَيبٌ لَهُ نَقبُ",1,"ب",1,0],["إلى ضِياءٍ وضَوْءِ نارٍ","تَمازجا في قَرارِ كاسِ",2,"س",1,0],["الى ضمّرٍ راحت بنا أريحيّةٌ","يُبيدُ الفيافي سيرُها المُتواتِرُ",3,"ر",1,0],["إلى ضبة الكوفة الاكرمين","تنسب أكرم بهذا النسب",4,"ب",1,0],["إلى ضوء نارٍ بالحبونن والصفا","تُشَبُّ ودوني من هُلُولِ مِتانِ",5,"ن",1,0],["إلى ضوء نار دون سلع يشبها","ضعيف الوقود فائر غير سائم",6,"م",1,0],["إلى ضريح قد زهت","به يثرب وأهيلها",7,"ل",3,0],["إلى ضامرٍ مثل ضِلفِ الغزال","أشدُّ اصفرارا من المِشمشِ",8,"ش",1,0],["إلى ضوء نار الهم يعشو فيهتدي","مشيبي في ليل الشباب لمفرقي",9,"ق",2,1],["إلى ضوء نار النصب يدعون جهرة","وينهون عن شمس الهدى وهي شارقه",10,"ق",2,0],["إِلى ضَفِراتِ المِلحِ لَيسَ بِجَوِّها","أَنيسٌ وَلا مِمَّن يَحُلَّ بِها شفرُ",11,"ر",1,0],["إلى ضِفّةِ الأمجادِ يُرسونَ سُفْنَنا","ويَسبَحُ حولَ السُّفْنِ لَمْعُ الضّياءِ",12,"ا",2,0],["إلى ضاع الوفا .. مابه هوى بارجيه أنا .. ووداد","ترى ذا الفرق .. بين أقرب قريب .. وبين عدواني",13,"ن",2,0],["إلى ضفّتيها حيثُ حضنِ نخيلِها","يعانقُ أنسامَ الفراتِ مدى الدهرِ",14,"ر",1,0]]}