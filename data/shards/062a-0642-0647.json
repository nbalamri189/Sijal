{"poems":[[79,"تقهقه عند رؤيته الثكالى","https://www.aldiwan.net/poem35871.html","الوافر"],[90,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[53,"وتال تلا يوما فأنسي آية","https://www.aldiwan.net/poem64550.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198599","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104562","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59784","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143012","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92158","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[5064,"لُغات الأرض .. لُغة الإله","https://www.poetsgate.com/ViewPoem.aspx?id=199123",""],[5458,"الغدفة","https://www.poetsgate.com/ViewPoem.aspx?id=113375",""],[5628,"الشاعر والعاذلة","https://www.poetsgate.com/ViewPoem.aspx?id=178469",""],[5684,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=188300",""],[5691,"هبوط","https://www.poetsgate.com/ViewPoem.aspx?id=206350",""],[6056,"بنت رسلان","https://www.poetsgate.com/ViewPoem.aspx?id=130379",""]],"verses":[["تُقَهْقِهُ عندَ رؤيتِه الثّكالَى","ويضْحَكُ منْهُ معْتادُ العُبوسِ",0,"س",1,1],["تقهقر يبغي في الديار تحصُّناً","فقرَّبها من خشية الموت واستذرى",1,"ر",2,0],["تقهقر عنها قِيسَ عشرينَ خطوةً","وجاش إليها جيشةً فأجازها",2,"ز",3,0],["تقهقرت دونها الأيام واجفةً","فهي الشباب وتلك الشيب والهرمُ",3,"م",1,0],["تَقهرُ الصَّعبَ لا تُبالي بماتل","قاهُ حتى كسبتَ كل رِهان",4,"ن",1,0],["تُقهقهُ في تلكَ الرُّبوعِ رعودُهُ","وتبكي على تلك الطُّلولِ سحائبُه",5,"ب",2,0],["تقهقرتُ خلفي والدموع حثيثة","على الخد مني تستهل وتهمع",6,"ع",1,0],["تقهوين رواد الهضاب ببنها","وبَثي أنا شعر من الراح أسلس",7,"س",1,0],["تقهقهَ الرعدُ فانهلت مدامعُهُ","والضحكُ يجري دموعُ العين وافرُهُ",8,"ه",1,1],["تقهقر فطرقل مضطرباً","لخشيته سخط ذاك الملك",9,"ك",1,0],["تقهرُ الباسلَ العنيد فلا تدنو","إليكِ الأعداءُ والأضدادُ",10,"د",1,0],["تقهقرَ ذاكَ الصَّدَى الأبجدِيُّ","وأعلنَ إفلاسَهُ الأسودَا",11,"د",2,1],["تقهقر الركب صار الجهل شيمتنا","والجاهلية قد عادت بما انصرفا",12,"ف",2,0],["تقهقرتْ عن رؤاها النفسُ واحتضنتْ","ليل الخرائبِ مظلمَّ الرؤى عبِسَا",13,"س",2,0],["تقهقرٌ مخجل مُفْضٍ إلى جدث","والسوس ينخرنا من فرقة يلج",14,"ج",1,0],["تقَهْقَرَ بُعْداً عنْ مَبادئِ دينِهِ","إلى سفْسَطاتٍ ما عَرَفْنَ أُصولا",15,"ل",2,0],["تقَهْقَرَ حتّى أصْبَحَ الكُلُّ دونَهُ","وأرْخى عليْهِ اللَّيْلُ ثَمَّ سُدولا",15,"ل",2,0],["تقهويت الهجوس مهيّله من فكري المشغول","تزعفرها الهموم الزايدة شوق ٍ على الغالي",16,"ل",2,1]]}