وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[462,"وقالوا هجاك الصديق الصدق","https://www.aldiwan.net/poem3360.html","عموديه"],[462,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[475,"هي العيس دعها بي إلى حاجر تحدى","https://www.aldiwan.net/poem15248.html","الطويل"],[480,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[491,"صبرت ولم أحمد على الصبر شيمتي","https://www.aldiwan.net/poem67370.html","الطويل"],[498,"محاضر القوم لا تترك بها الأدبا","https://www.aldiwan.net/poem38080.html","البسيط"],[504,"وكم فلتات للصنائع تتقى","https://www.aldiwan.net/poem2404.html","الطويل"],[511,"كم دون أرضك من واد ومن علم","https://www.aldiwan.net/poem67770.html","البسيط"],[512,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[549,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[549,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[549,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[549,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[571,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[573,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["وَكَم في نِزارٍ مِن نَهيضٍ نَجيبَةٍ","إِذا سَلَّ عَضباً سابِقَ الضَربِ عَزمُهُ",0,"م",2,0],["وَكَم فَوقَ البَسيطَةِ مِن شَريفٍ","أَغَرَّ الوَجهِ شيمَتُهُ بَهيمُ",1,"م",1,0],["وَكَم فيهِ مِن خَوِّ اللَثاثِ كَأَنَّما","جَرى ضَرَبٌ ما بَينَها وَشَمولُ",2,"ل",1,0],["وكَمْ فيهمُ منْ صارِخٍ ومُثَوِّبٍ","ومنْ مَجلِسٍ فَخْمٍ ومنْ نِعَم دَثْرِ",3,"ر",1,0],["وكَمْ في مَحاني ذلك الجِزْعِ مِنْ مَهاً","تُجاذِبُها ظِلَّ الأراكَةِ غِزْلانُ",4,"ن",1,0],["وكَمْ في هَوادي سِرْبِهِم مِنْ مُهَفْهَفٍ","إذا خَطَرَ استَعْدى على الكَفَلِ الخَصْرُ",5,"ر",1,0],["وَكَم فارِسٍ يا عَبلَ غادَرتُ ثاوِي","يَعَضُّ عَلى كَفَّيهِ عَضَّةَ نادِمِ",6,"م",1,0],["وَكَم فُزتُ مِن رَبِّ الهِلالِ بِحِكمَةٍ","وَكَم زِنتُ مِن رَبِّ الضِياءِ بَياني",7,"ي",1,0],["وَكَم فيكِ يا مِصرُ مِن كاتِبٍ","أَقالَ اليَراعَ وَلَم يَكتُبِ",8,"ب",1,0],["وَكَم فَوَّقوا نَحوي سِهاماً عَلى النَوى","فَأَصمت فُؤادي وَاِعتَدَدتُ بِها مِنَن",9,"ن",1,0],["وكم في مصر من بطل همام","يسير بها على خطوات سعد",10,"د",1,0],["وكم فتاة فقدت بعلها","من بعد ما قد َولَدتْ تَوْءمه",11,"م",2,0],["وكم في رُبا لبنان من ذي فصاحة","مُجيدٍ بيوم الحفل قَرْع المنابر",12,"ر",1,0],["وكم فأرة في الشرق تُحسَب هرّة","وكم عَقعَق في الشرق سُميَ هدهدا",13,"د",2,0],["وَكَم فينا إِذا ما المَحلُ أَبدى","نُحاسَ القَومِ مِن سَمحٍ هَضومِ",14,"م",1,0],["وَكَم فَجرٍ سَبَقنَ إِلى مَلامي","فَعُدتُ ضُحىً وَلَم أَحفِل بِهِنَّه",15,"ن",2,0],["وكم فيكُم يوم الوداع لشقوتي","هلالٌ سما غصنٌ زها رشأٌ رنا",16,"ن",2,0],["وكم في الناس من رجلٍ لئيمٍ","يقوم بُعذرهِ لؤْمُ النِّصابِ",17,"ب",1,0],["وكم في السيف من لين","وكم في السيف من ذبحِ",18,"ح",1,0],["وكم فللتم شَبا الأظفار منه بما","ظاهرتُمُ دون كفيه من الجُنن",19,"ن",1,0],["وكم في الجديد من الطيبات","وإن ضربوا بالقديم المثل",20,"ل",1,0],["وكم فتاة قد دعو","ت للهوى لم تحجم",21,"م",1,0],["وَكَم فَتَحوا الثُغورَ بِلا تَواني","وَبِالأُسطولِ جاؤوا مِن مَواني",22,"ا",3,0],["وَكَم فَجِئَت يَداهُ يَدَيَّ بُغتاً","بِنَيلٍ مِن نَدى كَفَّيهِ غَمرِ",23,"ر",1,0],["وَكَم في قُرى مَيسانَ مِن عِلجِ قَريَةٍ","قَريبٍ بِكَفَّيهِ الوُشومُ لِصالِحِ",24,"ح",1,0],["وَكَم فيهِمُ مِن سَيِّدٍ وَاِبنِ سَيِّدٍ","وَمِن قائِلٍ يَومَ الحَفيظَةِ فاصِلِ",25,"ل",1,0],["وكم في عَدِيٍّ من كُهولٍ وفِتيَةٍ","كِرامٍ لهم كَهْلُ السَّماحِ ويافعُه",26,"ع",2,0],["وكم في الناسِ من رجلٍ قويٍّ","شديدِ البأسِ يقتحمُ اقتحاما",27,"م",2,0],["وكم فرَس في الحسن أُكمِل خلقُهُ","فلمَّا عَدا في الشأوِ أدركهُ النقصُ",28,"ص",1,0],["وكم فاضلٍ ملبوسُهُ دونَ قَدْرِهِ","وِعَا الجوهرِ الأجسام لا الدرُّ والفصُّ",28,"ص",1,0],["وَكَم في مُديماتِ الأَسى من خَبيئَةٍ","مَعَ الصّونِ أَبقى الدَّمعُ في خَدِّها خَدَّا",29,"د",2,0],["وكم فرحةٍ جَلَبَتْ ترحةٍ","وَكَمْ ضحكٍ بعدَهُ مدمعُ",30,"ع",1,0],["وَكَم فَتىً قَد راحَ نَهباً راكِباً","إِمّا جَليسَ مَلِكٍ أَو كاتِبا",31,"ب",2,0],["وَكَم فَتاةٍ خَرَجَت مِن مَنزِلِ","فَغَصَبوها نَفسَها في المَحفِلِ",31,"ل",1,0],["وَكَم فيهِ مِن قُمريِّ عودٍ مُغَرَّدٍ","وَمِن كارِعٍ في كَأسِهِ غَيرَ حابِسِ",32,"س",1,0],["وَكَم فيهِ مِن حَيٍّ مَليحٍ مُراسِلٍ","بِعَينَيهِ فيما شِئتَ غَيرَ مُماكِسِ",32,"س",1,0],["وَكَم فَطِنٍ قَد مَلَأ","نَ مُقلَتَيهِ بِالرِيَب",33,"ب",1,0],["وَكَمْ فِتْنَةٍ بَيْنَ العَشيرِ أَزالَها","وكانَ بها للناسِ بَعْثٌ وَمَحْشَرُ",34,"ر",1,0],["وكم فتى كَرَمٍ أعطاكَ مِقْوَدَهُ","فاقتادَ كلُّ كريم النفسِ والنسبِ",35,"ب",1,0],["وَكَم فاتَكَ الشَيءُ الَّذي كُنتَ راجِياً","وَجاءَكَ بِالمِقدارِ ما لَم تَكُن تَرجو",36,"و",1,0],["وَكَم فيكَ يا بَحرُ مِن لُؤلوءٍ","وَلَكِنَّ لُجُّكَ لا يَنحَسِر",37,"ر",1,0],["وَكَم فَتَكا وَالحِسُّ قَد بانَ عَنهُما","بِأَهلِ وُهودٍ أَو جِبالٍ وَحِزّانِ",38,"ن",1,0],["وكم فقد الرحمن إذنا سميعة","وكم وجد الشيطان للسمع آذانا",39,"ن",2,0],["وَكَم في التريث من حكمة","ولكنما المرء مستعجل",40,"ل",1,0],["وَكَم فلّ هَذا الموت في غشيانه","جموعاً من الأقوام إِثر جموع",41,"ع",1,0],["وَكَم فجوة فيها الهداية ضلة","وَكَم شقة فيها الضلال هو الهدى",42,"د",2,0],["وَكَم في قرى لبنان من فتية زهوا","وَمن فَتَيات حسنهن بَديع",43,"ع",1,0],["وكم في الرجالِ سُعَارُ الوحوش","إذا لمسوا الجُثَّةَ الدافئهْ",44,"ه",1,0],["وَكَم فارِسٍ يا عَبلَ غادَرتُ ثاوِياً","يَعَضُّ عَلى كَفَّيهِ عَضَّةَ نادِمِ",45,"م",1,0],["وَكَمْ في سَبيل العلمِ عَبَّأَ بَعْثَةً","وَكَمْ في سَبيل الفَنِّ أَنْشَأَ مَعْهَدَا",46,"د",2,0],["وَكَمْ فِي فُؤَادِي مِنْ جِراحٍ ثَخِينَةٍ","يُحَجِّبُهَا بُرْدَايَ عَنْ أَعْيُنِ النَّاسِ",47,"س",1,0],["وَكَمْ فَوَّتَّ فِيهَا طَيِّبَاتٍ","يَفُوزُ بِهَا المُدَاجِي وَالكَذُوبُ",48,"ب",1,0],["وكم فتىً تسبِقُ الأيامَ وثبتُه","وللبطولةِ أفْقٌ غيرُ محدود",49,"د",1,0],["وكم فتكة في الروم بكر جلوتها","منصاتها للمسلمين المنابر",50,"ر",1,0],["وكمْ في الشرقِ مثلي من مُرَجٍّ","أرادَ لكَ النجاحَ فما استطاعا",51,"ع",2,0],["وَكَم في الناس مثل أَبي نَواس","وَلَكن لَيسَ فيهُم مِن رَشيد",52,"د",1,0],["وَكَم في الناس مِن رَشأ جَميل","وَلَكن لَيسَ مَحظوظ الجَمال",53,"ل",1,0],["وكم في الناس من حسن ولكن","بلاء الحب اذ يقضى نصيب",54,"ب",1,0],["وكم فل عزماً من رجال تجمعوا","علينا ببسط الكف فانقبضوا دهرا",55,"ر",2,0],["وَكَم فَتًى صِفرِ كَفٍّ","قَد كَانَ آلَى ألِيَّه",56,"ي",2,0],["وَكَم فِتيَةٍ سَامَرتُهُم بِقَصَائِدٍ","مُحَلاَة بألفَاظٍ بِدُرِّ مَعَانِ",57,"ن",1,0],["وكَم فَتَنتِ فَتًى عَن سِحرِ فَاتِنَةٍ","مَا إِن أتَاكِ فَتًى ِإلاَّ بِكِ افتَتَنا",58,"ن",2,0],["وكَم فَضَحَتهُ في النَّادِى لُحُونٌ","فَجَرَّرَ مِن مَذَمَّتِهَا ذُيُولا",59,"ل",2,0],["وكم فيهُمُ من مثلِ كعبٍ وهاشمٍ","وكم لَهُمُ من مثلِ عَمروٍ وعامِرِ",60,"ر",1,0],["وَكَم فَتَحتَ بِلاداً غَيرَ مُكتَرِثٍ","وَالسُمرُ مَركوزَةٌ وَالبيضُ في القُرُبِ",61,"ب",1,0],["وَكَم فيكَ لي عِقدٌ يَحوزُ جَواهِراً","تُزَيِّنُ مِنها كُلُّ جَوهَرَةٍ عِقدا",62,"د",2,0],["وكم في الهوى القتال من ذى حجي هوى","فبالصبر ثق لا تعى عن حمله ثقلا",63,"ل",2,0],["وكم فحصتْ يدُ الأيّامِ عَنِّي","كأيْدي الخيلِ أبصرتِ المَخالي",64,"ي",1,0],["وَكَم فَوق طورِ العقلِ طوراً وفوقه","سواهُ وَزِد ما شئتَ طوراً علا طورا",65,"ر",2,0],["وَكَم فتيات سابقاتٍ وفتيةٍ","هداةٍ وكم عبدٍ أتى سابقاً حرّا",65,"ر",2,0],["وَكَم فَتياتٍ راهباتٍ وفتيةٍ","رَهابين من زهدٍ بِهم سَكنوا دَيرا",65,"ر",2,0],["وكم في حشا الأيامِ من مدلهمةٍ","قد ازدحمتْ فيها بناتُ المصائبِ",66,"ب",1,0],["وكم في الناسِ من دَنِفٍ مَشوقٍ","إليكَ وكمْ شجيِّ مُستهامِ",67,"م",1,0],["وكم فاتحٍ أبواب شرٍّ لنفسه","إذا لم يكن قفلٌ على فيه مُقفَلُ",68,"ل",1,0],["وكم في هواهم لي حديث مسلسل","روته جفوني بالمدامع عنهم",69,"م",1,0],["وكم في قتال الروم اظهرت آية","تلاها غداة الفتح سيفك والنصر",70,"ر",1,0],["وَكَم فَتىً بَطِرَ الإِلهامُ في دَمِهِ","فَقامَ يُغصِبُني في شِعرِهِ البَطَرُ",71,"ر",1,0],["وَكم في رُبى لُبنان من ذي مكيدَةٍ","وَما رائِدُ الحُسّادِ غَير المَكائِدِ",72,"د",1,0],["وَكَم فَرَقَ الأَبطالَ يَومَ كَريهَةٍ","وَأَحرَزَ خَصلَ السَبقِ يَومَ رِهانِ",73,"ن",1,0],["وَكَم فَقيرٍ باتَ ذا عُسرَةٍ","أَصبَحَ وَهوَ الموسِرُ المُثري",74,"ر",2,0],["وكم في مصرَ عندي من غنى","وفقري لا يمرُّ له ببالِ",75,"ل",1,0],["وكم فظٍّ تراه غليظ لفظٍ","إذا ما كان كان الليل عاكر",76,"ر",1,0],["وكم فرصة فيها استحالت بغصة","فما افترسني أو قرعت لها سني",77,"ن",2,0],["وكم في ثَغرها البسّامِ كيداً","وكم في خَدِّها الباهي ذُرُورا",78,"ر",2,0],["وكم في جيدِها الحالي نُذوراً","وكم في طرفها الساجي نذيرا",78,"ر",2,0],["وكم في الجوى أعرضتُ عنها وقد أتت","تُضَمّدُ جرحاً لم يكن ليُضَمَّدا",79,"د",2,0],["وكم فيكَ من حلمٍ ولهوٍ ونُزهة","وسلمى لتسليمٍ وسعدى لإسعاد",80,"د",1,0],["وَكَم في عيون الغي بالرشد من قذى","وَكَم في فؤاد الشرك منكبد نزح",81,"ح",1,0],["وَكَم في الغَيب مِن تَيسير عسر","وَمن تفريج نائية تنوب",82,"ب",1,0],["وَكَم في غَريب الملك وَالمَلكوت من","عَجائِب لا يحصى لا يسرها وصف",83,"ف",1,0],["وَكَمْ فِي ظُباها مِنْ ظِباءٍ غَرِيرَةٍ","وَفِي قَصَبِ الْمُرّانِ مِنْ قَصَبٍ فَعْمِ",84,"م",1,0],["وَكَم فيهِم مِن شادِنٍ ثَمِلِ الخُطا","مُعَربِدَةٌ أَلحاظُهُ يَتَحَكَّمُ",85,"م",1,0],["وَكَم فُزتُ في الكُبرى بِكُبرى المُنى مِن ال","زَمانِ وَصُغراها بِتِلكَ المَحافِلِ",86,"ل",1,0],["وَكَم فَتىً فاتَه لثمُ النِعال غدا","يَرجو وَيأملُ أَن يَلقاه من أمَمِ",87,"م",1,0],["وكَمَّ فمي عن الشكوى لكيلا","يسير بغيبةٍ يوماً مقالي",88,"ل",2,0],["وكم في الليالي لا رعى الله عهدها","عوائق مطل عن حوائج نابه",89,"ه",1,0],["وكم في العصا واليد من سر قدرة","كتكذيب فرعون وإيمان سحرة",90,"ه",1,0],["وَكَم في الناسِ مِن حسنٍ وَلَكن","عَليكَ لِشقوتي وقَعَ اِختياري",91,"ي",1,0],["وَكَم فَرِحتُ وَقُلتُ القُطنَ مِنهُ وَفا","إِذا بِالغَوا فيهِ وَاِستَعلوا مَحصَلَهُ",92,"ل",2,0],["وكم في المحاريب من ساجِدين","أفاءوا إليك بذلّ الرؤوس",93,"س",1,0],["وكم في المذابح من راهب","يريقُ اللحون ويُزجى الطقوس",93,"س",1,0],["وكم فيهم أخو شجن","براه القدر الصلب",94,"ب",1,0],["وكم في غانيات الجن","للمحروم مطلب",94,"ب",1,0],["وَكَم في جَماد الأَرض مِن ناطق لَهُ","بِأَبدَع مَن أَن يُفصحَ القَول مُعربُ",95,"ب",1,0],["وكم فِتْنَةٍ تَطْغَى بكلِّ مُشيِّعٍ","له النّقْعُ ليلٌ والسِّنانُ سَمير",96,"ر",1,0],["وكم فوقَ تلك العيسِ من بَدْرِ هَوْدَجٍ","إذا لاحَ للسّارى رأَى الغَيَّ رُشْده",97,"د",2,0],["وكم في الأرض من حُسن ولكن","عليك لشقوتي وقعَ اختياري",98,"ر",2,1],["وكَم فَلكٍ للجودِ دارَ فلَم يَزَل","يُديرُ لِسانِي بالمَدائِحِ في فَمي",99,"ي",1,0],["وكم فراقٍ رَفَعت عيسُه","ذيلَ اشتِياقٍ كان مَجرورا",100,"ر",2,0],["وكم فاضَ بالأدبِ المُستَفا","ضِ فأَجرى بهذا وذا أبحُرا",101,"ر",2,0],["وكم فضايح لي عليها شهود","كثير منها جم موجود",102,"د",1,0],["وكم في الآي زجر","وكم جافي الروايات",103,"ت",1,0],["وكم في زبيدٍ أغلقت من مساجد","وأغلق فيها مسجد للأشاعر",104,"ر",1,0],["وكُم فَرَحَةٍ منتوجةٍ من كآبةٍ","كَما انَهلَّ صَوبُ المُزنِ عن زَجَلِ الرَّعْدِ",105,"د",1,1],["وكم فُجِعتُ بروْعاتِ الفِراقِ ولا","كَهذه لم يُرْعِني قطُّ تَرحالُ",106,"ل",1,0],["وكم في النَّاس من شيخ كبير","عليه ينزل اللَّعْن الكبير",107,"ر",1,0],["وكم في الحيّ من كبدٍ تَلَظّى","وتَصْلى حَرَّ نيران الخدود",108,"د",1,0],["وكم فرح من بعد حزن وراحة","من النصب الجاني على العدل بالجور",109,"ر",1,0],["وكم فرج لله من بعد شدَّةٍ","تعللنا فيه الأَماني تعلُّلا",110,"ل",2,0],["وكم فئةٍ قد خامر البغيُ قلبَها","على أنَّها بأحبولة الحصر",111,"ر",1,0],["وكم في الحيِّ من ليثٍ هصورٍ","صريع لواحظ الرشأ الغرير",112,"ر",1,0],["وكم في الناس من حيٍّ ولكنْ","يُرى في الناس من أهل القبور",112,"ر",1,0],["وكم فتنة أوقدت قبله","فكان الخمود لنيرانها",113,"ن",3,0],["وكم فتحٍ أبو الفتحِ اجتناهُ","بقُبٍّ في العُلى رفعَتْ قِبابا",114,"ب",2,0],["وكم فتًى بات محرابَ الوَغى فغدَا","بغارةِ اللصِّ محروباً بمحرابِ",115,"ب",1,0],["وكم فاضَتْ مدامِعُهُمْ فَمَدَّتْ","عُبابَ البَحْرِ بالماءِ الرُّواءِ",116,"ا",2,0],["وكَمْ فَتَّقَتْ فِي الأَرضِ من وَقْرِ مَسْمَعٍ","وكم أَنْطَقَتْ بِالحَمْدِ من أَلْسُنِ خُرْسِ",117,"س",1,0],["وكمْ فؤادٍ وكم جسمٍ وكم بَصَرٍ","لَبَّاهُ من قُرْبهِ سَعياً ومِنْ بُعُدِهْ",118,"د",2,0],["وكم فيها عهدنا من رجال","تخف الشم وزنا عن حجاها",119,"ا",3,0],["وكم فتىً شاكلتْ علاه","خُلْقي على قلّة الشُّكولِ",120,"ل",1,0],["وكم فننٍ أهدى إلى القلب بل هدى","وقد غرّد القمريُّ من لوعةٍ فنّا",121,"ن",2,0],["وكم في البرَّية من جاهلِ","عيّيٍ ويحسبُ أن قد فطن",122,"ن",1,0],["وكم في الهوى من سبابٍ يلذُّ","طعماً ومن غضبٍ مستطاب",123,"ب",1,0],["وكم فلَّ حداً من عديد وعدةٍ","ولم يُغن فيه حاسرٌ ومدرَّع",124,"ع",1,0],["وكم في المجاني مِن نبالِ لواحظٍ","فَرَتْ بعدَ أحشائي المضاعفةَ السَّردا",125,"د",2,0],["وكم فتنت منا القلوب كأنني","أنا الطور حيث لم يقو بقوتي",126,"ت",2,0],["وَكَم فَرَجٍ وَاليَأسُ يَحجُبُ دونَهُ","أَتاكَ بِهِ المَقدورُ مِن حَيثُ لا تَدري",127,"ي",1,0],["وكم فقيرٍ أتاهُمْ مُخلصاً ولِهاً","صارَ التُّرابُ له في تِبْرِهم ذَهَبا",128,"ب",2,0],["وكم فلتات للصّنائع تُتّقى","عواقِبها إن لم تقع في محلِّها",129,"ه",2,1],["وكم فلاةٍ يفوت الطرف آخرها","للجن بالليل في أقطارها وهج",130,"ج",1,0],["وكم في التّابعين لآلِ حَربٍ","له من فتكةٍ بِكرٍ عَوانِ",131,"ن",1,0],["وكم فيه من عادمٍ عائمٍ","ومن واجدٍ للغِنى آجمِ",132,"م",1,0],["وكم فيهمُ من مليحِ الدَّلا","ل تستلب العينُ منه العقولا",133,"ل",2,0],["وَكَم في الأسافلِ تَحتَ الحَضيض","أخامص قَومٍ علون السّريرا",134,"ر",2,0],["وكم فيهمُ للجهلِ ميتٌ وربّما","يَموت اِمرُءٌ لم يطوِه القومُ في اللَّحْدِ",135,"د",1,0],["وكم فتنت في عشقها من متيم","إذا ذكرت منه تفيض المدامع",136,"ع",1,0],["وَكَم في الثَرى دَسَّت جَبينَ مُتَوَّجٍ","فَأَصبَحَ بِالإِقدامِ يوطا وَيُمتَهَن",137,"ن",1,0],["وكمْ فيه مَنْ يَلْقَى الكميَّ مقنعاً","بفرْحَةِ من يَلْقى الحبيبَ مُعَمَّمَا",138,"م",2,0],["وكم فيه من يَرْمِي ببعضِ سِهَامِه","فَيتْرُك دِرْع القِرْن بَرْداً مسَّهما",138,"م",2,0],["وكم فيه للقطرِ مِنْ خُوذةٍ","تَدُلُّ علَى أَنَّه مِغْفَر",139,"ر",1,0]]}