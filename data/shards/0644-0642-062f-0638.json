{"poems":[[55,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[93,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[47,"أشدة ما أراه منك أم كرم","https://www.aldiwan.net/poem25155.html","البسيط"],[72,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[72,"لمصر مفاخر تقديم تاج","https://www.aldiwan.net/poem19991.html","الوافر"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[91,"فديناك لو ان الردى قبل الفدا","https://www.aldiwan.net/poem8811.html","عموديه"],[70,"رويدك قد أفنيت يا بين أدمعي","https://www.aldiwan.net/poem42833.html","الطويل"],[89,"الما بشعر قام كالطلل البالي","https://www.aldiwan.net/poem44841.html","الطويل"],[43,"أرى حللا مطواة حسانا","https://www.aldiwan.net/poem10126.html","الوافر"],[28,"إليك حملت الأمر ثم جمعته","https://www.aldiwan.net/poem4992.html","الطويل"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[44,"أما والذي غشى المبارك خزية","https://www.aldiwan.net/poem30068.html","الطويل"],[33,"بكى فرحا بليلى إذ رآها","https://www.aldiwan.net/poem25759.html","الوافر"],[105,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[115,"لقد ظن العذول نسيت حاشا","https://www.aldiwan.net/poem40924.html","عموديه"],[143,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[143,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[150,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[160,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[160,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[160,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[166,"لقد ظلم القمري إذ ناح باكيا","https://www.aldiwan.net/poem47016.html","الطويل"],[181,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[185,"هناؤك ليس يعدمه زمان","https://www.aldiwan.net/poem14678.html","الوافر"],[239,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[270,"تعالي نترك النسكا","https://www.aldiwan.net/poem35246.html","مجزوء الوافر"],[270,"بكيت لباك واشتكيت لشاك","https://www.aldiwan.net/poem35624.html","الطويل"],[270,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[297,"لقد ظلمتني واستطالت يد النوى","https://www.aldiwan.net/poem32967.html","الطويل"],[297,"بكيت لبرق لاح بالثغر باسمه","https://www.aldiwan.net/poem33167.html","الطويل"],[300,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[303,"أيا نور عيني صرت في ظلمة اللحد","https://www.aldiwan.net/poem57676.html","الطويل"],[304,"أسفت على أيام عمر تصرمت","https://www.aldiwan.net/poem16771.html","الطويل"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[393,"لقد ظن بدر التم نقص جماله","https://www.aldiwan.net/poem53392.html","الطويل"],[403,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[403,"لي الله ما قلبي هو الحجر الصلد","https://www.aldiwan.net/poem33975.html","الطويل"],[416,"بوخز القنا والمرهفات البواتر","https://www.aldiwan.net/poem54013.html","الطويل"],[424,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[482,"لقد ظهرت فلا تخفى على أحد","https://www.aldiwan.net/poem24377.html","عموديه"],[551,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"]],"verses":[["لَقَد ظَفِرَت مَوَدَّتُكُم بِقَلبي","فَحَلَّت في الشَغافِ وَفي الفُؤادي",0,"د",2,0],["لَقَد ظَفِرَ الأَتراكُ عَدلاً بِسُؤلِهِم","وَنَحنُ عَلى الآثارِ لا شَكَّ نَظفَرُ",1,"ر",1,0],["لَقَدْ ظَفِرْتُم بِمَا أَدْنَى القَصِيُّ لَكُمْ","مِنَ المَرَامِ فَلَيْسَ الفَوْزَ مَزْعُومَا",2,"م",2,0],["لَقَد ظَنَنتُكَ بَينَ الجَحفَلَينِ تَرى","أَنَّ السَلامَةَ مِن وَقعِ القَنا تَصِمُ",3,"م",1,0],["لقد ظفرت منكم قسيّ ظهورها","لدى عرض البيدا بخيرِ سهام",4,"م",1,0],["لقد ظهرت كرامة ما رآه","إمام عن إمام عن إمام",5,"م",1,0],["لقد ظفرتم بمن ما هز مُنصُلَه","إلا تَحكَّم في الهامات والقَصَر",6,"ر",1,0],["لقد ظفرتم بمن كانت أنامله","تقوم فينا مقام الرزق في البشر",6,"ر",1,0],["لَقَد ظَعِنَت تَبغي لُقاكَ كَأَنَّما","ضَربتَ لَها قَبلَ التَفَرُّقِ مَوعِدا",7,"د",2,0],["لَقَد ظَلَمَتني وَاِستَطالَت يَدُ النَوى","وَقَد طَمِعَت في جانِبي كُلَّ مَطمَعِ",8,"ع",1,0],["لقد ظل هذا الشعر خمسين حجة","يهذب اقوالي ويصلح اعمالي",9,"ي",1,0],["لَقَد ظَلَّت أَواخِرُها الأَعالي","مَعَ الأولى بِجِسمِكَ في قِتالِ",10,"ل",1,0],["لَقَد ظَلَمَت أَيديكُمُ غَيرَ ظالِمٍ","وَلا لِهَوانٍ في القُيودِ مُقَوَّدِ",11,"د",1,0],["لقد ظَلَما من كلِّ غَيداءَ حُرَّةٍ","كَلاماً لو اسطاعَ الكلامَ تَظَلَّما",12,"م",2,0],["لَقَد ظَلَّ يُصميني الزَمانُ لِبُعدِهِ","وَيُحزِنُ قَلبي مِنهُ ما كانَ يُفرِحُ",13,"ح",1,0],["لَقَد ظَلَّ مُقرانٌ يَحُكُّ بِعِرضِهِ","قَوافِيَ شِعرٍ لَو تَدَبَّرَها جُربا",14,"ب",2,0],["لَقَد ظَفِرَت يَداهُ وَنالَ مُلكاً","لَإِن كانَت تَراهُ كَما يَراها",15,"ه",2,0],["لَقَد ظَنّ العُداةُ بِنا ظُنوناً","كَواذبَ مثلَ أَحلامِ النِيامِ",16,"م",1,0],["لقد ظل هذا اللَه يعبد أدهرا","وقد كان قبل اللَه تعبد أوثان",17,"ن",1,0],["لَقَد ظعن اليوم الرفاق وإننا","لنمشي عَلى الآثار منهم نشيع",18,"ع",1,0],["لقد ظن أهل الغرب أو بعض أهله","وبعض ظنون الناس والناس مأثم",19,"م",1,0],["لَقَد ظَنَّ هَذا القَلبُ أَن لَيسَ لاقِياً","سُلَيمى وَلا أُمَّ الحُسَينِ لِحينِ",20,"ن",1,0],["لقد ظن العذول نسيت حاشا","هوى من حبه سكن المشاشا",21,"ش",2,1],["لَقَد ظَفِرتَ مِنَ المَجدِ الصَريحِ بِما","نَصيبُ طُلّابِهِ الإِكداءُ وَالنَصَبُ",22,"ب",1,0],["لَقَد ظَلَّلَت هَذي البِلادُ سَحابَةٌ","بَوارِقُها بِشرٌ وَإيماضُها تِبرُ",23,"ر",1,0],["لَقَد ظَمئَت نَفسي بِعِلم إِلهها","وَلَو كَرَعَت في طَيبَةٍ مِلءَ فاهِها",24,"ه",2,0],["لقد ظهرت في الظاهر الملك في الورى","محاسن تشوي قلب حاسده شيا",25,"ي",2,0],["لقد ظهرت في ردة الامن خيرة","ظفرت به من غير عقد ولا حلف",26,"ف",1,0],["لقد ظن غر سره ما يسؤني","بأني إذا غولبت فارقتكم غلبا",27,"ب",2,0],["لقد ظَلَم القمريُّ إذ ناحَ باكياً","وليسَ لهُ من مثلِ ما ذُقْتُهُ ذَوقُ",28,"ق",1,1],["لَقَد ظَلَمُوا ذاتَ الوِشاحِ وَلَم يَكُن","لَنا فى هَوَى ذاتِ الوِشاحِ نَصِيبُ",29,"ب",1,0],["لقد ظَفِرتْ يداىَ بما توالتْ","به من فضِلك النعم المِنان",30,"ن",1,0],["لقد ظن أن الجو للحكم قد خلا","بمقتل ضيدانٍ لما يتطلب",31,"ب",1,0],["لقد ظهرت سرائرُنا","وما أبقى الهوى شكَّا",32,"ك",2,0],["لقد ظلَّلت روحي محيّاكِ عِندما","نثرتِ على الأتراب ورد مُحَيَّاك",33,"ك",1,0],["لقد ظَمِئَت نفسي إِلى بَردِ قبلةٍ","هي الماءُ للنّفسِ التي عَيشُها قَفر",34,"ر",1,0],["لَقَد ظَلمَتني واِستَطالَت يدُ النَوى","وقد طمعَت في جانبي أَيَّ مَطمَعِ",35,"ع",1,1],["لَقَد ظفِرَت كفّايَ منه بماجدٍ","فواتحه محمودة وخواتمُه",36,"م",2,0],["لَقَد ظَعَنَت قَيسٌ فَأَلفَت بُيوتَها","بِسِنجارَ فَالأَجزاعِ أَجزاعِ دَوسَرا",37,"ر",2,0],["لقد ظمئت نفسي لرشف رضابه","وهيهات واسهدي على ذلك الشهد",38,"د",1,0],["لَقَد ظَنَّ أَهلُ الزيغِ وَالشَكِّ أَنَّهُم","إِذا قُبَروا لا يَبعَثونَ لِيُسئَلوا",39,"ل",3,0],["لَقَد ظَفِرتُ بِحَبلِ اللَهِ فَاِعتَصِمِ","وَهيَ النَجاةُ لِتالِ شَأنِها حِفظاً",40,"ظ",2,0],["لَقَد ظَنَّ بَدرُ التمِّ نَقصَ جَمالِهِ","فَبُعداً لِوَجه البَدر مَع سوءِ ظَنِّهِ",41,"ه",1,1],["لقد ظلمت إذ صار يلثم ظلمها","فتى ليس أهلاً أن يريد هواها",42,"ا",3,0],["لقد ظلمتني واستطالتْ يدُ النوى","وقد تركتني لا أقر ولا أهدو",43,"د",2,0],["لقد ظفِرَتْ آل الزهير بشيخها","بأَشجع من ليث بخفَّان خادر",44,"ر",1,0],["لَقَدْ ظَفِرَتْ كَفَّاكَ بِالْمَالِ وَالْعِدا","بِرَأْي ابْنِ يَحْيَى الْقَرْمِ وَاللهُ يُظْفِرُكْ",45,"ك",1,0],["لَقَدْ ظَفَرَتْ كَفّاكَ مِنْهُ بِفاضِلٍ","بِهِ اللهُ مِنْ بَعْدِ القَلِيلِ يُكَثِّرُكْ",45,"ك",1,0],["لقد ظهرت في الكل عينا بكلها","فما ثم إلا الكل في كل وجهة",46,"ه",1,0],["لقد ظهرت فلا تخفى على أحد","إلا على أعمى لا يبصر القمرا",47,"ر",2,1],["لَقَد ظَفِرت أيّامُكُم بِمُحمَّدٍ","بماضٍ حديدِ الغَرْب غيرِ كَهامِ",48,"م",1,0]]}