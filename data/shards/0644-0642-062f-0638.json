{"poems":[[57,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[88,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[95,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[49,"أشدة ما أراه منك أم كرم","https://www.aldiwan.net/poem25155.html","البسيط"],[74,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[74,"لمصر مفاخر تقديم تاج","https://www.aldiwan.net/poem19991.html","الوافر"],[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[93,"فديناك لو ان الردى قبل الفدا","https://www.aldiwan.net/poem8811.html","عموديه"],[72,"رويدك قد أفنيت يا بين أدمعي","https://www.aldiwan.net/poem42833.html","الطويل"],[91,"الما بشعر قام كالطلل البالي","https://www.aldiwan.net/poem44841.html","الطويل"],[45,"أرى حللا مطواة حسانا","https://www.aldiwan.net/poem10126.html","الوافر"],[30,"إليك حملت الأمر ثم جمعته","https://www.aldiwan.net/poem4992.html","الطويل"],[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[68,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[46,"أما والذي غشى المبارك خزية","https://www.aldiwan.net/poem30068.html","الطويل"],[35,"بكى فرحا بليلى إذ رآها","https://www.aldiwan.net/poem25759.html","الوافر"],[107,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[119,"لقد ظن العذول نسيت حاشا","https://www.aldiwan.net/poem40924.html","عموديه"],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[154,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[164,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[164,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[164,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[170,"لقد ظلم القمري إذ ناح باكيا","https://www.aldiwan.net/poem47016.html","الطويل"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[189,"هناؤك ليس يعدمه زمان","https://www.aldiwan.net/poem14678.html","الوافر"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[275,"تعالي نترك النسكا","https://www.aldiwan.net/poem35246.html","مجزوء الوافر"],[275,"بكيت لباك واشتكيت لشاك","https://www.aldiwan.net/poem35624.html","الطويل"],[275,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[302,"لقد ظلمتني واستطالت يد النوى","https://www.aldiwan.net/poem32967.html","الطويل"],[302,"بكيت لبرق لاح بالثغر باسمه","https://www.aldiwan.net/poem33167.html","الطويل"],[305,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[308,"أيا نور عيني صرت في ظلمة اللحد","https://www.aldiwan.net/poem57676.html","الطويل"],[309,"أسفت على أيام عمر تصرمت","https://www.aldiwan.net/poem16771.html","الطويل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[398,"لقد ظن بدر التم نقص جماله","https://www.aldiwan.net/poem53392.html","الطويل"],[409,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[409,"لي الله ما قلبي هو الحجر الصلد","https://www.aldiwan.net/poem33975.html","الطويل"],[422,"بوخز القنا والمرهفات البواتر","https://www.aldiwan.net/poem54013.html","الطويل"],[430,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[487,"لقد ظهرت فلا تخفى على أحد","https://www.aldiwan.net/poem24377.html","عموديه"],[556,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83323","الطويل"],[777,"","https://poetry.dctabudhabi.ae/diwan/poem/203403","الطويل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99992","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67822","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120038","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96634","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108900","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101039","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101027","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11170","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96175","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95302","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27200","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27574","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21442","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93563","الطويل"],[255,"","https://poetry.dctabudhabi.ae/diwan/poem/141752","الطويل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105408","الوافر"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100441","الطويل"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116833","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87731","الطويل"],[561,"","https://poetry.dctabudhabi.ae/diwan/poem/145198","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112694","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97931","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68004","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74093","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129382","المتقارب"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37522","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216627","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77187","البسيط"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105146","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123517","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130602","الوافر"],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4927,"الشهيد محمود بن عبد الرزاق الدغيم","https://www.poetsgate.com/ViewPoem.aspx?id=79607",""],[5092,"همسة","https://www.poetsgate.com/ViewPoem.aspx?id=178125",""],[5092,"يموت الظلُّ","https://www.poetsgate.com/ViewPoem.aspx?id=190579",""],[5147,"دعاه الهوى ما العصر عصر بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=166712",""],[5216,"قناة السويس","https://www.poetsgate.com/ViewPoem.aspx?id=187002",""],[5246,"ولست بناس دوحة قد تنورت","https://www.poetsgate.com/ViewPoem.aspx?id=187047",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5691,"ناكر العهد...!","https://www.poetsgate.com/ViewPoem.aspx?id=206584",""],[5956,"إخلاص حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=182457",""],[5956,"الضحيَّةُ والمنقذ","https://www.poetsgate.com/ViewPoem.aspx?id=194198",""],[6035,"إنّ المُقَرِّظَ بالأحبابِ مُتَّهَمُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177163",""]],"verses":[["لَقَد ظَفِرَت مَوَدَّتُكُم بِقَلبي","فَحَلَّت في الشَغافِ وَفي الفُؤادي",0,"د",2,0],["لَقَد ظَفِرَ الأَتراكُ عَدلاً بِسُؤلِهِم","وَنَحنُ عَلى الآثارِ لا شَكَّ نَظفَرُ",1,"ر",1,0],["لَقَدْ ظَفِرْتُم بِمَا أَدْنَى القَصِيُّ لَكُمْ","مِنَ المَرَامِ فَلَيْسَ الفَوْزَ مَزْعُومَا",2,"م",2,0],["لَقَد ظَنَنتُكَ بَينَ الجَحفَلَينِ تَرى","أَنَّ السَلامَةَ مِن وَقعِ القَنا تَصِمُ",3,"م",1,0],["لقد ظفرت منكم قسيّ ظهورها","لدى عرض البيدا بخيرِ سهام",4,"م",1,0],["لقد ظهرت كرامة ما رآه","إمام عن إمام عن إمام",5,"م",1,0],["لقد ظفرتم بمن ما هز مُنصُلَه","إلا تَحكَّم في الهامات والقَصَر",6,"ر",1,0],["لقد ظفرتم بمن كانت أنامله","تقوم فينا مقام الرزق في البشر",6,"ر",1,0],["لَقَد ظَعِنَت تَبغي لُقاكَ كَأَنَّما","ضَربتَ لَها قَبلَ التَفَرُّقِ مَوعِدا",7,"د",2,0],["لَقَد ظَلَمَتني وَاِستَطالَت يَدُ النَوى","وَقَد طَمِعَت في جانِبي كُلَّ مَطمَعِ",8,"ع",1,0],["لقد ظل هذا الشعر خمسين حجة","يهذب اقوالي ويصلح اعمالي",9,"ل",2,0],["لَقَد ظَلَّت أَواخِرُها الأَعالي","مَعَ الأولى بِجِسمِكَ في قِتالِ",10,"ل",1,0],["لَقَد ظَلَمَت أَيديكُمُ غَيرَ ظالِمٍ","وَلا لِهَوانٍ في القُيودِ مُقَوَّدِ",11,"د",1,0],["لقد ظَلَما من كلِّ غَيداءَ حُرَّةٍ","كَلاماً لو اسطاعَ الكلامَ تَظَلَّما",12,"م",2,0],["لَقَد ظَلَّ يُصميني الزَمانُ لِبُعدِهِ","وَيُحزِنُ قَلبي مِنهُ ما كانَ يُفرِحُ",13,"ح",1,0],["لَقَد ظَلَّ مُقرانٌ يَحُكُّ بِعِرضِهِ","قَوافِيَ شِعرٍ لَو تَدَبَّرَها جُربا",14,"ب",2,0],["لَقَد ظَفِرَت يَداهُ وَنالَ مُلكاً","لَإِن كانَت تَراهُ كَما يَراها",15,"ه",2,0],["لَقَد ظَنّ العُداةُ بِنا ظُنوناً","كَواذبَ مثلَ أَحلامِ النِيامِ",16,"م",1,0],["لقد ظل هذا اللَه يعبد أدهرا","وقد كان قبل اللَه تعبد أوثان",17,"ن",1,0],["لَقَد ظعن اليوم الرفاق وإننا","لنمشي عَلى الآثار منهم نشيع",18,"ع",1,0],["لقد ظن أهل الغرب أو بعض أهله","وبعض ظنون الناس والناس مأثم",19,"م",1,0],["لَقَد ظَنَّ هَذا القَلبُ أَن لَيسَ لاقِياً","سُلَيمى وَلا أُمَّ الحُسَينِ لِحينِ",20,"ن",1,0],["لقد ظعن الأحبة واغتبطنا","بما تركوه غبطة ذي جنون",21,"ن",1,0],["لقد ظن العذول نسيت حاشا","هوى من حبه سكن المشاشا",22,"ش",2,1],["لَقَد ظَفِرتَ مِنَ المَجدِ الصَريحِ بِما","نَصيبُ طُلّابِهِ الإِكداءُ وَالنَصَبُ",23,"ب",1,0],["لَقَد ظَلَّلَت هَذي البِلادُ سَحابَةٌ","بَوارِقُها بِشرٌ وَإيماضُها تِبرُ",24,"ر",1,0],["لَقَد ظَمئَت نَفسي بِعِلم إِلهها","وَلَو كَرَعَت في طَيبَةٍ مِلءَ فاهِها",25,"ه",2,0],["لقد ظهرت في الظاهر الملك في الورى","محاسن تشوي قلب حاسده شيا",26,"ي",2,0],["لقد ظهرت في ردة الامن خيرة","ظفرت به من غير عقد ولا حلف",27,"ف",1,0],["لقد ظن غر سره ما يسؤني","بأني إذا غولبت فارقتكم غلبا",28,"ب",2,0],["لقد ظَلَم القمريُّ إذ ناحَ باكياً","وليسَ لهُ من مثلِ ما ذُقْتُهُ ذَوقُ",29,"ق",1,1],["لَقَد ظَلَمُوا ذاتَ الوِشاحِ وَلَم يَكُن","لَنا فى هَوَى ذاتِ الوِشاحِ نَصِيبُ",30,"ب",1,0],["لقد ظَفِرتْ يداىَ بما توالتْ","به من فضِلك النعم المِنان",31,"ن",1,0],["لقد ظن أن الجو للحكم قد خلا","بمقتل ضيدانٍ لما يتطلب",32,"ب",1,0],["لقد ظهرت سرائرُنا","وما أبقى الهوى شكَّا",33,"ك",2,0],["لقد ظلَّلت روحي محيّاكِ عِندما","نثرتِ على الأتراب ورد مُحَيَّاك",34,"ك",1,0],["لقد ظَمِئَت نفسي إِلى بَردِ قبلةٍ","هي الماءُ للنّفسِ التي عَيشُها قَفر",35,"ر",1,0],["لَقَد ظَلمَتني واِستَطالَت يدُ النَوى","وقد طمعَت في جانبي أَيَّ مَطمَعِ",36,"ع",1,1],["لَقَد ظفِرَت كفّايَ منه بماجدٍ","فواتحه محمودة وخواتمُه",37,"م",2,0],["لَقَد ظَعَنَت قَيسٌ فَأَلفَت بُيوتَها","بِسِنجارَ فَالأَجزاعِ أَجزاعِ دَوسَرا",38,"ر",2,0],["لقد ظمئت نفسي لرشف رضابه","وهيهات واسهدي على ذلك الشهد",39,"د",1,0],["لَقَد ظَنَّ أَهلُ الزيغِ وَالشَكِّ أَنَّهُم","إِذا قُبَروا لا يَبعَثونَ لِيُسئَلوا",40,"ل",3,0],["لَقَد ظَفِرتُ بِحَبلِ اللَهِ فَاِعتَصِمِ","وَهيَ النَجاةُ لِتالِ شَأنِها حِفظاً",41,"ظ",2,0],["لَقَد ظَنَّ بَدرُ التمِّ نَقصَ جَمالِهِ","فَبُعداً لِوَجه البَدر مَع سوءِ ظَنِّهِ",42,"ه",1,1],["لقد ظلمت إذ صار يلثم ظلمها","فتى ليس أهلاً أن يريد هواها",43,"ا",3,0],["لقد ظلمتني واستطالتْ يدُ النوى","وقد تركتني لا أقر ولا أهدو",44,"د",2,0],["لقد ظفِرَتْ آل الزهير بشيخها","بأَشجع من ليث بخفَّان خادر",45,"ر",1,0],["لَقَدْ ظَفِرَتْ كَفَّاكَ بِالْمَالِ وَالْعِدا","بِرَأْي ابْنِ يَحْيَى الْقَرْمِ وَاللهُ يُظْفِرُكْ",46,"ك",1,0],["لَقَدْ ظَفَرَتْ كَفّاكَ مِنْهُ بِفاضِلٍ","بِهِ اللهُ مِنْ بَعْدِ القَلِيلِ يُكَثِّرُكْ",46,"ك",1,0],["لقد ظهرت في الكل عينا بكلها","فما ثم إلا الكل في كل وجهة",47,"ه",1,0],["لقد ظهرت فلا تخفى على أحد","إلا على أعمى لا يبصر القمرا",48,"ر",2,1],["لَقَد ظَفِرت أيّامُكُم بِمُحمَّدٍ","بماضٍ حديدِ الغَرْب غيرِ كَهامِ",49,"م",1,0],["لَقَد ظَلَّ سُلطانِ الكَلامِ بِأَسرِهِ","فَاِعلامُهُ الأَقلامُ وَالكُتبُ جُندُهُ",50,"د",2,0],["لقد ظهرت في مصر أكبر آية","فكل امرئ أضحى بها يتعجبُ",51,"ب",1,1],["لَقَدْ ظَفَرَتْ كَفّاكَ مِنْهُ بِفاصِلٍ","بِهِ اللهُ مِنْ بَعْدِ القْلَيلِ يُكَثِّرُكْ",52,"ك",1,0],["لَقَدْ ظَفِرُوا بِالْقُرْبِ مِنْ ذِي المَعَارِجِ","دَوَا غُصَّتِي والْغَصُّ يُبْلي إذا ثَوى",53,"ث",3,0],["لقد ظفرت منك الغداة بعادل","يميل على أعدائها ويجورُ",54,"ر",1,0],["لَقَد ظفر اللّه المظفّر في العدا","غداةَ اِلتَقى في الحومةِ الجندُ والجندُ",55,"د",1,0],["لقد ظلتَ في ظل الخلافة مكرماً","وأصبحت غوثاً للعفاة ورضوانا",56,"ن",2,0],["لقد ظلموا أم اللغى في جمالها","بباطل دعوى منهم ووغول",57,"ل",1,0],["لقد ظنوا الظنون بنا سفاهاً","ورادوا البغي فانتجعوا الخيالا",58,"ل",2,0],["لقد ظنوا النظنون بنا فخابوا","وكان عليهم يوماً عقاما",59,"م",2,0],["لَقَد ظَلَّت تُعاوِنُني عَلَيهِم","صَموتُ الحِجلِ كاظِمَةُ السِوارِ",60,"ر",1,0],["لقد ظهرت شهامتهم صغارا","وما خبر المخبّر كالعيان",61,"ن",1,0],["لقد ظفرت والحمد للَّه منيتي","بما كنت أهوى في الجهارة والنجوى",62,"ا",1,1],["لَقَد ظَفِرُوا فَما أَبقَوا عَلَينا","وَهَل يُبقي إِذا ظَفِرَ الجَبانُ",63,"ن",1,0],["لَقد ظلَّ عُذّالي يَعيبونَ حُسنَهُ","وما فيه عيبٌ غَير قَامَتهِ السَّمرا",64,"ر",2,1],["لقد ظهرتَ فما تخفى على أحدٍ","إلا على أحدٍ لا يعرفُ الباري",65,"ر",2,0],["لقد ظهرتْ فيها أمور عظيمةٌ","وما انفصمتْ مما رأته عراها",66,"ا",3,0],["لَقَد ظَلَمت مِرآتَها أُمُّ مالكٍ","بِما لاقتِ المرآةُ كانَ مُحَرَّدا",67,"د",2,1],["لَقَد ظَنَّ فيكَ الخَير بِالأَمس جابر","وَأَدناك حُبّاً وَالنُفوس شَحائح",68,"ح",1,0],["لقد ظهَرَتْ للظاهر الملك همةٌ","بها اليومَ في الدارين قد بلغَ المنا",69,"ن",2,0],["لقد ظعنوا بقلبي يوم راحوا","فما هو بين هانيك الظعون",70,"ن",1,0],["لقد ظهرت منه الضمائر مخلصاً","بأعماله للَه في السر والجهر",71,"ر",1,0],["لقد ظعَنت في رَبرَب شابَه الدمى","رقاقِ الثنايا واضحاتِ المحاجِر",72,"ر",1,1],["لَقَد ظفِرَت أَيدي الخُطوب بِنائمٍ","عَلى الضَيم مَغموز القَناة مُعنَّت",73,"ت",1,0],["لقد ظلموا شيخ القوافي يصوغها","قصائد مما ينتقى وأراجزا",74,"ز",2,0],["لَقَد ظفِرتَ بحبلِ اللَه فاِعتصم","أَبشر أخيَّ إذا ما عشتَ محتفظا",75,"ظ",2,0],["لقد ظهرت نواياه الينا","كأن حشاه واضحة الثقوب",76,"ب",1,0],["لقد ظهرت فضائله فأضحت","مطي بني الرجاء له تحث",77,"ث",1,0],["لقد ظلموهما فإذا رأينا","الموظف في التقميش فالظهارة",78,"ر",2,0],["لقد ظفرتْ مني ظفار وأَوثتتْ","بأسبابِها وداً بقلبي لَهُ شَدّ",79,"د",1,0],["لَقَد ظعن الخَليط وَكنت أَدعو","وَلَكِن لا تجاوِبني الظعونُ",80,"ن",1,0],["لقد ظل سعي الذي ما نحاك","ضلالي بمي بلا إمترا",81,"ر",2,0],["لقد ظنّ عاوٍ مِسْعَرٌ أَن يُرَى لهمْ","بدونِ نظامِ المُلكِ مُنتَظِماً أَمر",82,"ر",1,0],["لقد ظفرتن بي ختلاً بلا تعب","وما ظفرتنَّ بي نكساً ولا وكلا",83,"ل",2,0],["لَقَد ظَنَنتُ بِأَنَّ الساعَةَ اِقتَرَبَت","لَمّا عَلِمتُ بِلَيلى قَد جفت فَسلت",84,"ت",1,1],["لقد ظهرت للعالمين بشائر","باكرم مولود لأكرم مولد",85,"د",1,0],["لقد ظفرت بكنز عز مطلبه","باليمن جاء به المنان أغناك",86,"ك",1,0],["لَقَد ظَفِرْتَ بِحَبْلِ اللهِ فَاعْتَصِمِ","كَم أَيْقَظَتْ لو دَعَتْ لَمّا دَعَتْ يَقِظا",87,"ظ",2,0],["لقد ظفرت بهم ياجد فيها","لال امية ظفر وناب",88,"ب",1,0],["لَقَدْ ظَفِرْتَ بِحُسْنَىْ لاْ مَثِيْلَ لَهَاْ *** فِيْ جَنَّةِ الْخُلْدِ، وَاسْتَقْبَلْتَ أَضْيَاْفَاْ","ضَيْفٌº وَحَوْلَكَ أَضْيَاْفٌ لَهُمْ قَصَصٌ *** تُعَمِّمُ الْحَقَّ شُطْآناً وَأَحْقَاْفَاْ (14)",89,"ف",2,0],["لَقَدْ ظَلَمُوْا سُرَاْةَ الشَّاْمِ طُراًّ","وَخَيَّمَ فِيْ مَرَاْبِعِهَا السَّقَاْمُ",90,"م",1,0],["لقد ظمِئتْ كؤوسُ الحبِّ حبَّا !","وأوَّلُ من كَسرنا فيهِ كأسَهْ",91,"س",2,0],["لقد ظمئتْ أراضي اللهِ عدلا","أوار الزورِ شقَّ الأرضَ شقا",92,"ق",2,0],["لقد ظل ديمقراط في نظراته","ورب ضلال كان في حده فكرا",93,"ر",2,0],["لقد ظلَّ الزمانُ يرى شعوبًا","ولم يرَ مثلكم شعبًا أبيّا",94,"ي",2,0],["لقد ظهرت في ربوة وتسنمت","مقاماً له بين المقامات مرتقى",95,"ق",2,0],["لقد ظلمت بعد فقد النبي","وأمته أصبحت ظالمه",96,"م",2,0],["لقد ظلّلت درب الحبيب بفيئها","وكانت سحاب الخير أغلى الأوانس",97,"س",1,0],["لَقَدْ ظَفَّرَ اللهُ المُظَفَّرَ فِي العِدَى","غَداةَ الْتَقَى فِي الحَوْمَةِ الجُنْدُ وَالجُنْدُ",98,"د",1,0],["لقدْ ظلَمْتُكِ ويْحي فاقْبَلي نَدَمي","وسامِحيني كفتْني نارُ وجْداني !",99,"ن",2,0],["‏لقد ظهرت حقيقته","‏ ‏ ويا حمْداً لمن أظهرْ",100,"ر",1,0],["لقد ظلموا شريداً مستكيناً","وضدَّ الظلم قرَّر أن يثُورا",101,"ر",2,0],["لقد ظَلَلْتِ مع الأَقْدارِ حازمَةً","ومااسْتَكَنْتِ ولمْ تَفْترْ لكِ الهِمَم",102,"م",1,0]]}