{"poems":[[63,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[55,"الله يعلم من تغير قلبه","https://www.aldiwan.net/poem26151.html","الكامل"],[57,"ولقد بلوتك وابتليت خليقتي","https://www.aldiwan.net/poem24636.html","الكامل"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[4,"قضي الأمور وأنجز الموعود","https://www.aldiwan.net/poem21156.html","الكامل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[4,"ولئن كبرت لقد عمرت كأنني","https://www.aldiwan.net/poem21275.html","الكامل"],[11,"ولقد بغى بجلاد أوس قومه","https://www.aldiwan.net/poem256.html",""],[23,"ولقد بكيت وعز مهلك جعفر","https://www.aldiwan.net/poem21429.html","الكامل"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"رخصت معاملتي على رجل","https://www.aldiwan.net/poem64939.html","أحذ الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[89,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[43,"أرق على أرق ومثلي يأرق","https://www.aldiwan.net/poem9735.html","الكامل"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[45,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[45,"ليس الزمان بمعتب فذريني","https://www.aldiwan.net/poem66683.html","الكامل"],[28,"وطئت جياد يزيد كل مدينة","https://www.aldiwan.net/poem5178.html","الكامل"],[28,"ليست ترد ديات من قد قتلت","https://www.aldiwan.net/poem5440.html","الكامل"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[49,"الجود لا ينفك حامده","https://www.aldiwan.net/poem63119.html","السريع"],[49,"أمسي وأصبح من تذكركم","https://www.aldiwan.net/poem64225.html","الكامل"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"غيري بحبل سواكم يتمسك","https://www.aldiwan.net/poem40111.html","الكامل"],[44,"ضاحكن من أسف الشباب المدبر","https://www.aldiwan.net/poem29983.html","الكامل"],[105,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[52,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[52,"يا غزال الوادي بنفسي أنتا","https://www.aldiwan.net/poem27216.html","الخفيف"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[50,"أسعاد جودي لا شفيت سعادا","https://www.aldiwan.net/poem63955.html","الكامل"],[1,"ما تنظرون بحق وردة فيكم","https://www.aldiwan.net/poem20966.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85498","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21020","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42491","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54714","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"النقمة","https://www.poetsgate.com/ViewPoem.aspx?id=178955",""],[45,"ما أنتَ، للكَلِفِ المَشُوقِ، بصَاحِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31560",""],[45,"لَوْ كَانَ يُعْتَبُ هاجرٌ في وَاصِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32196",""],[141,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[141,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[148,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[158,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[184,"ولقد بليت بمعشر","https://www.aldiwan.net/poem43352.html","مجزوء الكامل"],[193,"لمن المنازل أقفرت بغباء","https://www.aldiwan.net/poem54412.html","الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[248,"يا ابن الأئمة دعوة من مادح","https://www.aldiwan.net/poem14949.html","الكامل"],[269,"يا صاحب القبر المقيم بيثرب","https://www.aldiwan.net/poem52121.html","الكامل"],[280,"دمع هوى سلكاه عن جلد وهى","https://www.aldiwan.net/poem32312.html","الكامل"],[288,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[318,"أديت واجبك المقدس كاملا","https://www.aldiwan.net/poem61624.html","الكامل"],[346,"مولاي أقسم لم تعد في منزلي","https://www.aldiwan.net/poem20633.html","الكامل"],[346,"حبل المودة بيننا لم ينقض","https://www.aldiwan.net/poem20779.html","الكامل"],[347,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[351,"ذكر المعاهد والوقوف على الصفا","https://www.aldiwan.net/poem40038.html","الكامل"],[364,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[400,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[413,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[434,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[462,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[462,"ما لي بألحاظ الظباء يدان","https://www.aldiwan.net/poem3424.html","عموديه"],[462,"ولقد بدا والصولجان بكفّه","https://www.aldiwan.net/poem3522.html","عموديه"],[468,"يبكي لما قلب الزمان جديده","https://www.aldiwan.net/poem4780.html","الكامل"],[480,"لي في الغرام صبابة قد أسكرت","https://www.aldiwan.net/poem24326.html","عموديه"],[525,"ولقد بلوت الأصدقاء فلم","https://www.aldiwan.net/poem45955.html","أحذ الكامل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[549,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[556,"صدق الكتاب لمن به يتمسك","https://www.aldiwan.net/poem34273.html","الكامل"],[556,"بدت الحقيقة من خلال ستورها","https://www.aldiwan.net/poem34461.html","الكامل"],[560,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[560,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[573,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[573,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"]],"verses":[["ولقد بُليتُ بهِ بَلاءَ مُهَنَّدٍ","بأبَلَّ لا وَرَعٍ ولا بَطّاشِ",0,"ش",1,0],["ولَقَد بَكَيْتُ فلَو رأيتَ مَدامِعي","لعَلِمْتَ أيُّ الباكِيَيْنِ مُتَيَّمُ",1,"م",1,0],["وَلَقَد بَلَوتِ مَوَدَّتي فَوَجَدتِني","أَوفى وَأَحفَظَ في المَغيبِ وَأَوصَلا",2,"ل",2,0],["وَلَقَد بَلَوتُكَ وَاِبتَلَيتَ خَليقَتي","وَلَقَد كَفاكَ مُعَلِّمي تَعليمي",3,"ي",1,1],["ولقد بَرِئت إلى الوفاء من اميءٍ","عهد الصداقة عنده منقوض",4,"ض",1,0],["وَلَقَد بَنَيتَ أَخَسَّ بَيتٍ يُبتَنى","فَهَدَمتُ بَيتَكُمُ بِمِثلَي يَذبُلِ",5,"ل",1,0],["وَلَقَد بَنى لَكَ في المَكارِمِ وَالعُلى","آلُ المُغيرَةِ مِن بَني مَخزومِ",6,"م",1,0],["وَلَقَد بَلَت إِرَمٌ وَعادٌ كَيدَهُ","وَلَقَد بَلَتهُ بَعدَ ذاكَ ثَمودُ",7,"د",1,0],["وَلَقَد بَلَت يَومَ النُخَيلِ وَقَبلَهُ","مَرّانُ مِن أَيّامِنا وَحَريمُ",8,"م",1,0],["وَلَقَد بُليتُ وَكُلُّ صاحِبِ جِدَّةٍ","لِبِلىً يَعودُ وَذاكُمُ التَتبيبُ",9,"ب",1,0],["وَلَقَد بَغى بِجِلادِ أَوسٍ قَومُهُ","ذُلّاً وَقَد عَلِمَت بِذَلِكَ سِنبِسُ",10,"س",1,1],["وَلَقَد بَكَيتُ وَعَزَّ مَهلِكُ جَعفَرٍ","حُبَّ النَبِيِّ عَلى البَرِيَّةِ كُلِّها",11,"ل",3,1],["ولقدْ بلاَهُ إمامُهُ وأميرُه","فكلاهما ألْفَاهُ حَقَّ نَصيحِ",12,"ح",1,0],["ولقد بدا لكن محايدةً","ولقد جرى لكنه نكصا",13,"ص",2,0],["ولقد بلاك الطالبونَ فثُبِّطُوا","أن يُدركوكَ وخُذّلوا تخذيلا",14,"ل",2,0],["وَلَقَد بَكى الجَحّافُ مِمّا أَوقَعَت","بِالشَرعَبِيَّةِ إِذ رَأى الأَطفالا",15,"ل",2,0],["وَلَقَد بَكَيتُ وَما بَكي","تُ مِنَ الرِياءِ وَلا النِفاقِ",16,"ق",1,0],["ولقد بدت في خيلع من نورها","احسن بها لما بدت في الخيلع",17,"ع",1,0],["وَلَقَد بَعَثتُهُما إِلَيكَ قَصيدَةً","أَفَأَنتَ مُنتَظِرٌ كَعَهدِكَ شَيِّقُ",18,"ق",1,0],["وَلَقَد بَكَيتُ عَلى الشَبابِ وَلِمَّتي","مُسوَدَّةٌ وَلِماءِ وَجهِيَ رَونَقُ",19,"ق",1,0],["وَلَقَد بَعَثتُ العيسَ تَحمِلُ كِمَّةً","أَنضَت عَزائِمَ أَركُبٍ وَأَكائِبِ",20,"ب",1,0],["وَلَقَد بَرَعتَ عَلى المُلوكِ مَحَلَّةً","عُلواً وَأَفنِيَةً يَرُقنَ الرائِدا",21,"د",2,0],["وَلَقَد بَلَوتُ خِلالَهُ فَوَجَدتُهُ","مُعطى خِلالٍ مِن لَدَيكَ جَلائِلِ",22,"ل",1,0],["وَلَقَد بايَعتُ بِالشَيبِ فَما","قيضَ لِيَ طَيِّبُ نَفسٍ بِغَبَن",23,"ن",1,0],["وَلَقَد بَعَثتُ لَهُ الثَناءَ فَلَم يَقُم","جُهدُ الثَناءِ بِعَفوِ ما يوليني",24,"ي",1,0],["وَلَقَد بَنى لَبَني المُهَلَّبِ بَيتَهُم","في المَجدِ أَطوَلُ أَذرُعٍ وَسَواري",25,"ر",2,0],["وَلَقَد بَنى لَكُمُ المُعَلّى بَيتَكُم","في فَرعِ رابِيَةٍ بِغَيرِ مَسيلِ",26,"ل",1,0],["وَلَقَد بَلَوتُ فَلَم أَجِد سَبَباً","بِأَعَزَّ مِن قَنَعٍ وَلا أَعلى",27,"ا",1,0],["وَلَقَد بَليتُ وَكُنتُ مُطَّرِفاً","وَالشَيءُ يُخلِقُهُ تَقادُمُهُ",28,"م",2,0],["وَلَقَد بَرِمتُ مِنَ الحَياةِ لِما","ضَمَّنتَني وَعَرَضتَ مِن نَفسي",29,"ي",1,0],["وَلَقَد بَسَطتُ العُذرَ عِندَكَ فَاِعتَبِر","مَبسوطَهُ مِن رَأيِكَ الكَشّافِ",30,"ف",1,0],["وَلَقَد بَذَلتُ النَفسَ إِلّا أَنَّني","خادَعتُكُم وَبَذَلتُ ما لا أَملِكُ",31,"ك",1,0],["وَلَقَد بَكَيتُ لِدَهشَتي بِقُدومِكُم","وَضَحَكتُ قَبلُ وَهَجرُكُم لي مُهلِكٌ",31,"ك",1,0],["وَلَقَد بَلَونَ خَلائِقي فَوَجَدنَني","سَمحَ اليَدَينِ بِبَذلِ وُدٍّ مُضمَرِ",32,"ر",1,0],["وَلَقَد بَلَوتُ الكاتِبينَ جَميعَهُم","فَوَجَدتُ أَكثَرَ ما يُقالُ دَعاوِيا",33,"ي",2,0],["ولقد بَلوتِ خِلالَهُ فوجدته","نِعمَ الخليلُ إذا يَسوءُ المَعشرُ",34,"ر",1,0],["وَلَقَد بَلَّغَني الظا","عِنونَ أَمَلا",35,"ل",2,0],["وَلَقَد بُلِّغتُ أَوطارَ العُلى","وَرَعَيتُ العَيشَ وَالعَيشُ مَريعُ",36,"ع",1,0],["وَلَقَد بانَ أَنَّهُ لَكَ قالٍ","مُخلِفُ الوَعدِ خائِنٌ لَو عَقَلتا",37,"ت",2,0],["ولقد بَرَاكَ وكنْتَ مَوثِقَهُ الذي","أخذَ الكِتابَ وعهْدَهُ المسؤولا",38,"ل",2,0],["ولقد بعُدْتَ عن الصِّفاتِ وكنهِها","ولقد قربتَ فكنتَ غيرَ بعيد",39,"د",1,0],["وَلَقَد بَدا لي أَن أَموتَ بِحُبِّها","فَاِنهَلَّ دَمعي في الرِداءِ وَجادا",40,"د",2,0],["وَلَقَد بَدا لِيَ أَنَّهُ سَيَغولُني","ما غالَ عاداً وَالقُرونَ فَأَشعَبوا",41,"ب",3,0],["وَلَقَد بدأنا نَبتَني","وَاللَه يكفل بالتمام",42,"م",1,0],["وَلَقَد باتَ أَرنَب الجو يَرنو","من بعيد للحيَّة الرقطاء",43,"ا",2,0],["وَلَقَد باتَ راجفاً حمل الزه","رِ أَمام التنين خوف البلاء",43,"ا",2,0],["ولَقَد بَكيتُ عَلَى الشَّبابِ لَو أَنَّهُ","كانَ البُكاءُ بهِ عَلَيَّ يعُودُ",44,"د",1,0],["وَلَقَدْ بَلَوْتُ النّاسَ في أَطْوارِهِمْ","ومَلِلْتُ حتَّى مَلَّني الإِبْلاءُ",45,"ا",2,0],["وَلَقَدْ بَلَغْتَ القَصْدَ بُو","رِكَ فِي سَبِيلِ اللهِ قَصْدَا",46,"د",2,0],["وَلَقَد بَعَثتُ مِنَ الدُموعِ إِلَيكُمُ","بِرَكائِبٍ وَمِنَ الزَفيرِ بِحادِ",47,"د",1,0],["ولقد بحثْتُ عن السلام، فلم أجد","كإراقةِ الدّمِ بالسلام كفيلا",48,"ل",2,0],["ولقد بَكْيتُ وما البكاءُ بِمُرجِعٍ","مُلكاً بشهوةِ مالكيهِ بيعا",49,"ع",2,0],["ولقد بَكَيْتُ على حُبوطِكِ يا بلادي لا حبوطي","يا نائماً ما نَّبهَتْهُ الحادثاتُ من الغطيط",50,"ط",1,0],["ولَقَدْ بَعَثْتُ العِيسَ تَحمِلُ هِمّةً","أنضَتْ عَزَائمَ أرْكْبٍ وَرَكائِبِ",51,"ب",1,0],["وَلَقَدْ بَلَوْتُ خِلالَهُ، فَوَجَدْتُهُ","أنْدَى أسِرّةِ رَاحَةٍ، وأنَامِلِ",52,"ل",1,0],["وَلَقَد بَلَغتَ بِبَعضِ سَعيِكَ رُتبَةً","أَعيَت عَلى مَن لَم يَدَع مَجهودا",53,"د",2,0],["وَلَقَد بَغَيتُ العِزَّ مِن أَوطانِهِ","وَتَرَكتُ أَهلَ الشامِ تَركَ مُوَدِّعِ",54,"ع",1,0],["ولقد بعثت به وأعلم أنه","نقد ولكن عفوكم يعفيني",55,"ن",2,0],["ولقد بليت بفتية ما فيهم","رجل رشيد يرعوي ان ذكرا",56,"ر",2,0],["ولقد بليت بمعشر","نوكى أخفّهم ثقيل",57,"ل",1,1],["وَلَقَد بَلَوتُ الدَهرَ مُذ أَنا يافِعٌ","حَتّى لَبِستُ الشَيبَ بَعدَ فَتاءِ",58,"ا",2,0],["وَلَقَد بَدَت أَنوارُهُ بِجَبينِ عَب","دِ اللَهِ ظاهِرَةً لِذي عِرفانِ",59,"ن",1,0],["وَلَقَد بَكى وَدَعا لِأُمَّتِهِ إِلى","أَن جاءَهُ فيهِم جَوابُ أَمانِ",59,"ن",1,0],["وَلَقَد بَكى حَتّى تَبَلَّلَ حِجرُهُ","وَبَكى فَبلَّ الأَرضَ بِالهملانِ",59,"ن",1,0],["ولقد بَعثتُ بها قصيدا لَفظُها","كالدرِّ إذ وافى بسلك مُنضَّدِ",60,"د",1,0],["وَلَقَد بعثت لامة أُمية","نورا عَلى الاكوان غير محجب",61,"ب",1,0],["وَلَقَد بَعَثنَ إِلى الغُصونِ مَلامِحاً","مِنها وَمِن لَحظِ العُيونِ إِلى المَها",62,"ه",2,0],["ولقد بدا عدل الخلائف","للضرير وللبصير",63,"ر",1,0],["ولقد بَحثتُ فما غَنمتُ حقيقةً","ودفنتُ آمالي وعشتُ الثَّاكلا",64,"ل",2,0],["ولَقَدْ بُلِيتُ بهِ عَذُوّاً باتَ في","جِلْدِي فَرَّقَ لِمن بذلكَ قَد بُلي",65,"ي",1,0],["وَلَقد بَعَثْتَ خَمِيَلةً أَغْنَيْتَني","مِن زَهْرِها بِمُذَهَّبٍ ومُفَضَّضِ",66,"ض",1,0],["وَلَقَد باسَطَني في خِلوَةٍ","أَصبَحَ البُسطُ بِها في قَبضَتَي",67,"ي",1,0],["وَلَقَد بَلَغتَ مِن العِناية غاية","ما نالَها ذُو مطمع إِلّا اِكتَفى",68,"ف",2,0],["وَلَقَد بَكَيتُهُمُ بِغَيرِ مَدامِعٍ","وَلَقَد شَكَوتُهُمُ بِغَيرِ لِسانِ",69,"ن",1,0],["ولقد بخلت بقطرة من أدمعي","تجري لغير ذوي الجمال الباهر",70,"ر",1,0],["ولقد بلغتَ من العناية مبلغاً","يسمو برتبتها على كيوان",71,"ن",1,0],["ولقد بنيت لآل أيوب الألى","بيتا بنا وجه السماك الأعزل",72,"ل",1,0],["ولقد بكتك منائر ومنابر","ودفاتر ومحابر والمرفع",73,"ع",1,0],["ولقد بكيتُ وحطَّ فضبَ لثامهِ","فرأيت ورداً في الشتاء وسوسنا",74,"ن",2,0],["ولقد بكيت لثاكلٍ أيكيَّةٍ","بثَّت فنون الشَّجو في الأفنانِ",75,"ن",1,0],["ولقد بدا والصولجان بكفّهِ","والأرض في حلل لها وبرود",76,"د",1,1],["وَلَقَد بَدَأتُ أُريدُ وُدَّ مَعاشِرٍ","وَعَدوا مَواعِدَ أُخلِفَت إِذ حُصِّلوا",77,"ل",3,0],["ولقد بلغت على الذي في حبها","بعث السعادة فقلبي في شقوتي",78,"ت",2,0],["ولقد بلوت الأصدقاء فلم","أر فيهُمُ أوفى من الوفرِ",79,"ر",1,1],["ولقد بلوك على الزّمان فصادفوا","عَضْباً غنيّاً عن يمين الصَّيْقَلِ",80,"ل",1,0],["وَلَقد بَلوك خِلالَ مُعضلةٍ","دَهَمَتْ يُقضُّ بِمِثلها الجَنْبُ",81,"ب",1,0],["وَلَقَد بَنى لَكَ في الذُرى مِن وائِلٍ","أَبياتَ مَجدٍ ما تُرامُ طِوالا",82,"ل",2,0],["وَلَقَد بَنى لَكَ أَرقَمٌ وَمُطَرِّفٌ","بَيتاً رَفيعَ السَمكِ عَزَّ فَطالا",82,"ل",2,0],["ولقد بدت صوراً إذا هي فخمت","بنزولها الثاني لدى من يسلك",83,"ك",1,0],["ولقد بدت كاساتها مملوءة","من مائها الصافي وصرف خمورها",84,"ر",3,0],["ولَقد بكَيتُ على الدِّيارِ فساءَني","دَمعٌ لهُ سَعَةٌ وطَرْفٌ ضَيِّقُ",85,"ق",1,0],["ولَقد بَكَيْتُ على الشَّبابِ وعَصرهِ","فأضَعْتُ دَمْعي خاسراً في خاسرِ",86,"ر",1,0],["ولقد بكيت ونُحْتُ من حَزَني","بغريبِ مَنظُومِي ومَنْثُوري",87,"ر",2,0],["ولَقَدْ بَدا لِلْبَدْرِ مُعْتَرِضاً","فالبدرُ أَغْضَى والمحبُّ نَظَرْ",88,"ر",1,0]]}