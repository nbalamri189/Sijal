{"poems":[[87,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[30,"فلم أر منزولا به بعد هجعة","https://www.aldiwan.net/poem5079.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[202,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137666",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112923","الطويل"],[1550,"","https://poetry.dctabudhabi.ae/diwan/poem/131378","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52073","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18977","الطويل"],[4759,"ومن أحرى بحبك؟","https://www.poetsgate.com/ViewPoem.aspx?id=204362",""],[4940,"روح من جنون","https://www.poetsgate.com/ViewPoem.aspx?id=205646",""],[5005,"في مدارات الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=195377",""],[5184,"غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=186054",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""]],"verses":[["هُم أَدرَكوا عِزَّ النُبُوَّةِ وَاِنتَهَت","فيها إِلَيكَ العِزَّةُ القَعساءُ",0,"ا",2,0],["هُما دَلَّتاني مِن ثَمانينَ قامَةً","كَما اِنقَضَّ بازٍ أَقتَمُ الريشِ كاسِرُه",1,"ر",2,0],["هُمَا دَارَانِ فِي وَطَنٍ عَزِيزٍ","وَفِي الدَّارَيْنِ إِخْوانٌ وَآلُ",2,"ل",1,0],["هم أدهشوا الهول بما يهوله","فانكفأ الهول شكيا بالضوى",3,"ا",1,0],["هُمُ أَدَّبوا الأيامَ حتى تحصَنتْ","ذنوبُ عواديها بحُسن العواقبِ",4,"ب",1,0],["هما دون شك عمادا الحضاره","وكل لسبل النجاح مناره",5,"ر",2,1],["هما دهره هما عليه لأنه","تقاعس عن فعل المكارم بالعمى",6,"م",2,0],["هم أدركوا مدركا فات المدارك من","علم الرجال من التاخير والسبَق",7,"ق",1,0],["هُمَا دُرَّتَا الملكِ الذي يَصْطَفِيهما","وَنِعْمَ جَنَاحَا طَائِرِ العقْدِ وَالحَلِّ",8,"ل",1,0],["هُمُ أَدرَكوا في عَبدِ وُدٍّ دِمائَهُم","غَداةَ بَناتِ القينِ وَالخَيلِ جُنَّحُ",9,"ح",1,0],["هما دربان تفترق الليالي","على وجه وأيام تعدُ",10,"د",1,0],["هما دليلانِ أن الوجدَ متكئٌ","عليهما حيث مالا مال وانجذبا",11,"ب",2,0],["هما دليلانِ أن العشقَ معجزةٌ","إذ أنجباهُ ولكن قد له انتَسَبَا",11,"ب",2,0],["هم أدلجوا في خافقي فتعثروا","بالله ما ذنب الظلام إذا وسق؟!",12,"ق",1,0],["هُمْ أدمنوكَ .. وكنتَ أولَ زرعهمْ","فَعلامَ تُشبعُ عُودَهم إحراقا",13,"ق",2,0],["هما دليلاك ان الدهر ذو غير","وان آجالا تأتي على قدر",14,"ر",1,0]]}