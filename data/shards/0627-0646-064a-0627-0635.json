{"poems":[[57,"قالت مرضت فعدتها فتبرمت","https://www.aldiwan.net/poem26418.html","الكامل"],[45,"بم التعلل لا أهل ولا وطن","https://www.aldiwan.net/poem10591.html","البسيط"],[107,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[302,"هاتا أعيدا لي حديثي القديم","https://www.aldiwan.net/poem33164.html","السريع"],[422,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[466,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[505,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[558,"يا واشيا حسنت فينا إساءته","https://www.aldiwan.net/poem68281.html","البسيط"],[567,"ذكر النقا فاهتز من ذكر النقا","https://www.aldiwan.net/poem52720.html","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72289","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66294","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110265","الكامل"],[2965,"","https://poetry.dctabudhabi.ae/diwan/poem/146559","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135989","الرجز"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107286","الكامل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121262","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58029","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[5277,"القدرُ الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=200621",""],[5425,"بَغداد .. حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=199911",""],[5431,"واحمل جراحك الواحا مخلدة","https://www.poetsgate.com/ViewPoem.aspx?id=190534",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5431,"ياسيدي...","https://www.poetsgate.com/ViewPoem.aspx?id=199967",""],[5431,"ميحانةٌ...ميحانه...أغنية","https://www.poetsgate.com/ViewPoem.aspx?id=200018",""],[5431,"ضوء ..وجياع..وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=201723",""],[5493,"لستَ الهوَى","https://www.poetsgate.com/ViewPoem.aspx?id=197002",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5582,"قِفْ بِالدِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5674,"من حشاشة قلبي الحرف أرتجل","https://www.poetsgate.com/ViewPoem.aspx?id=186693",""],[5674,"أصون عهد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=189550",""],[5704,"تشطير لنونية المتنبي \" ما كل ما يتمنى المرء يدركه\"","https://www.poetsgate.com/ViewPoem.aspx?id=204264",""],[5956,"يا ليت","https://www.poetsgate.com/ViewPoem.aspx?id=185663",""],[5956,"شهيد الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=201541",""],[6082,"عبير","https://www.poetsgate.com/ViewPoem.aspx?id=58838",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""]],"verses":[["أَنّى أَصيدُ وَما لِمِثلي قُوَّةٌ","ظَبياً يَموتُ إِذا رآهُ الصائِدُ",0,"د",1,0],["إِنّي أُصاحِبُ حِلمي وَهوَ بي كَرَمٌ","وَلا أُصاحِبُ حِلمي وَهوَ بي جُبُنُ",1,"ن",1,0],["إنّي اصطفيتُ مُحمداً وهو الذي","أوصى به عيسَى فَنِعمَ المُصطفى",2,"ف",2,0],["أني أصون صفحتي مقتنعا","بما يطف من علالات الحسى",3,"ا",1,0],["إنّي أُصارِحك التعبيرَ مُجترئاً","وما الصريحُ بذي ذَنبٍ فَيعتذر",4,"ر",1,0],["أَنّيَ أَصبَحتُ به شاعِراً","أَنظم فيه كلَّ عِقدٍ نَظيم",5,"م",1,0],["إنِّي أصون الشعر لا بخلاً به","عن أن يذل بساحة اللؤماء",6,"ا",2,0],["إني اصطفيت حساماً راق رونقهُ","أغنى شباه عن الصَّمصامة الذَّكر",7,"ر",1,0],["إنِّي اصْطَفاني اللهُ قُطْباً عارِفاً","هل يقطَعُ الخِبُّ مَنِ اللهُ اصْطَفَى",8,"ف",2,0],["إِنّي أَصُدُّ دُموعاً لَجَّ سائِقُها","مَطروفَةَ العَينِ بِالمَرضى مِنَ الحَدَقِ",9,"ق",1,0],["إنِّي أُصدِّقُ قولَ حُرٍّ صادقٍ","لكنَّني أجِدُ التَّجاربَ أصدَقا",10,"ق",2,0],["إِني أصرح بالبرا فيه لمن عادى","فلست بما أقول معرضا",11,"ض",2,0],["إني أصبت به رشا","دي بل نجوت من ابتلائي",12,"ي",1,0],["إني أصانعه مخافةَ ظلمه","والنفي أقتلُ ما ارى من ظالم",13,"م",1,0],["إني أصافحه بكفي صائن","لكن ألاحظه بعيني فاسق",14,"ق",1,0],["إنِّيَ أصبحتُ ونيَّتي رضاكْ","فوالِني رضاكَ ربِّ وعطاكْ",15,"ك",1,1],["إِنِّي أُصَرِّحُ بالعَقيقِ وبالنَّقَا","وَاللَّهُ يَعلمُ ما تُكِنُّ سَرائِرِي",16,"ر",2,0],["إني اصطفَيتُك دون الناس قاطبَةً","إذ لا يُشَبّهُ أعيانٌ بآحاد",17,"د",1,0],["إني اصطَفَيْت من المَسَاكن منزلاً","من جَنبِه الشرقيِّ نهرٌ جارِ",18,"ر",1,1],["اني اصدَّق فيما قلت فيه ولو","في غيره قلتُ قال الناس ذا كذب",19,"ب",1,0],["إنّي اصطبرْتُ وليسَ لي مِن حيلةٍ","إلّا الزهورُ تزفُّها الأشعارُ",20,"ر",1,0],["إِنِّيْ اصْطَفَيْتُكُمَا قَدَرَاً عَلَى قَدَرِيْ","إنِّي المُنَاشِدُ في حُبِّيْكُما اللهَ",21,"ه",1,0],["إني اصطفيتك للأمجاد تقطفها","فاقطف فؤادي واجعل منه ملتحفا",22,"ف",2,0],["إني اصطفيتك كونا من مروءته","تعطر العمر بالريحان والآسِ",23,"س",1,0],["إني اصطفيتك كعبة لهدايتي","والقلب يقفز في الطواف وينهلُ",24,"ل",1,0],["إني اصطفيت خلوده","روحي به هيمانه",25,"ن",2,0],["إني اصطفيتك نزفا من تمرده","سيف الاباء علا من رعشتي امتشقا",26,"ق",2,0],["إنِّي اصْطفَيْتُكَ وَالعيُونُ شوَارِدٌ","ضَاعتْ كأنَّ التِّيهَ فِيهَا قَدْ هَوَى",27,"و",2,0],["إِنِّي اصْطَفَيْتُكَ بِالمَدْحِ الصَّرِيحِ إِذا","بَعْضُ القَرائِحِ لَمْ تَمْحَضْ مَدائِحُها",28,"ح",3,0],["إِنِّي اصْطَفَيْتُكَ دُونَ الخَلْقِ قاطِبَةً","مَوْلىً فَصِلْنِي بِحَبْلٍ غَيْرِ مُنْصَرِمِ",29,"م",1,0],["إني اصطفيتُ من الأوزان أكملَها","ومنْ سِوايَ بها الأوزانُ تكتملُ..!!",30,"ل",1,0],["إني أصون الحب عهد مودة","ويظل ذاك الود من أسراري",31,"ر",2,0],["( إنِّي أصاحب حلمي وهو بي كرمٌ)","والحِلمُ طبعٌ به الألبابُ تمتحنُ",32,"ن",1,0],["إني أصِرُّ على تحويل معْدتكم","لتهضم الشعر ضد الجهل والسَّقمِ",33,"م",1,0],["إني أصوّرُ بيئة حُجِبتْ","عن واقعٍ فيه يعيش سِوايْ",34,"ا",2,0],["اني اصارع في هواك منِيَتي","درب الحياة يا عبير قصيرُ",35,"ر",1,0],["إني أصدق منك الآل .. يخدعني","وإن يكن من خداع .. نالني النَّصَب",36,"ب",1,0]]}