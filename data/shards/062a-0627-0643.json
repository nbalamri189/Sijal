ttps://poetry.dctabudhabi.ae/diwan/poem/32892","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81251","المتقارب"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4739,"الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=36102",""],[4755,"كُن كما كُنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=183777",""],[4767,"استجارة","https://www.poetsgate.com/ViewPoem.aspx?id=184946",""],[4984,"أحلام الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=176011",""],[4994,"من قباب الجرح معراجي","https://www.poetsgate.com/ViewPoem.aspx?id=210700",""],[5122,"تّمر","https://www.poetsgate.com/ViewPoem.aspx?id=33179",""],[5189,"آجال وعمر","https://www.poetsgate.com/ViewPoem.aspx?id=198419",""],[5335,"اطعن","https://www.poetsgate.com/ViewPoem.aspx?id=35185",""],[5387,"حضارة الغاب","https://www.poetsgate.com/ViewPoem.aspx?id=53796",""],[5431,"صحوة الأرض...","https://www.poetsgate.com/ViewPoem.aspx?id=208842",""],[5542,"أيها العالم","https://www.poetsgate.com/ViewPoem.aspx?id=10056",""],[5545,"ما تُرى أنتَ صانعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184826",""],[5695,"وداع صهر..","https://www.poetsgate.com/ViewPoem.aspx?id=212543",""],[5848,"طفلة نجديه","https://www.poetsgate.com/ViewPoem.aspx?id=53355",""],[5848,"ممنوع الإزعاج","https://www.poetsgate.com/ViewPoem.aspx?id=48833",""],[5975,"أنا في هذه الدنيا سجينُ","https://www.poetsgate.com/ViewPoem.aspx?id=53401",""],[5982,"يا سماك البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176599",""],[6019,"طواف العبير","https://www.poetsgate.com/ViewPoem.aspx?id=53050",""],[161,"لفي كبدٍ خُلِقْتَ فَمَنْ تَلومُ ؟ !","https://www.poetsgate.com/ViewPoem.aspx?id=155650",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""],[2944,"راعي الغنم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86013&r=&rc=2",""]],"verses":[["تَأكُلُ النارُ مِنهُ لا هُوَ ناجٍ","مِن لَظاها وَلا اللَظى عَنهُ واني",0,"ن",2,0],["تأكل الارض كل حي فلا","تبقى على بائس ولا مسعود",1,"د",1,0],["تَأكُلُ الهِرَّةُ الصِغارَ إِذا جا","عَت وَلا تَأكُلُ اللَباةُ الشُبولا",2,"ل",2,0],["تَأكّدَ العهدُ مما ضَمَّ أُلفتَهم","وَاسْتَحصدَ الحبلُ من شَدٍّ وإمرارِ",3,"ر",1,0],["تَأكُلُ أَصحابي وَتَفنيهِمُ","ثُمَّ تَلقاني بِوَجهٍ صَفيقِ",4,"ق",1,0],["تَأكُلُهُ الرَزايا","وَالصُبحُ وَالمَساءُ",5,"ا",2,0],["تَأكُلُ مِن دُبٍّ عَلى ظَهرَها","وَهِيَ عَلى رُغبَتِها ما اكتَفَت",6,"ت",1,0],["تَأكُلُ ما شِئتَ وتَعتَلُّها","حَمراءَ مِن خُصٍّ كَلَونِ الفُصُوص",7,"ص",1,0],["تأكُلُ القَدَّ والدُّعَاعَ من الجُو","عِ وتَهْفُو شوقاً لِحَبِّ الْهَبِيدِ",8,"د",1,0],["تأكل الشمس ظلّها في مواميه","كما يأكل الغروب النهارا",9,"ر",2,0],["تأكل الشعب ولا يسري إلى","مقلتيها طيفه العاني لماما",10,"م",2,0],["تَأكُلُ ما شِئتَ وَتَعتَلُّها","خَمراً مِنَ المُصِّ كَلَونِ الفُصوص",11,"ص",1,0],["تأكل سحتا وحرما ولا","تريدني جارك في النار",12,"ر",1,0],["تأكل لحم القفا السمين كما","يأكل رز البهطة الجائع",13,"ع",1,0],["تأكل من جسمي وتصلي الحشا","والقلب من نيرانها الحاميه",14,"ي",2,0],["تأكل الأخضرَ واليابسَ، ترمي","كلَّ من تلقاه في الدَّرْب بنار",15,"ر",1,0],["تأكل العينُ منه ما تشربُ النف","س اتفاقا في حبّه والتئاما",16,"م",2,0],["تأكَّد فيما بيننا نسبُ العلى","وأن لم يكن ما بيننا نسبُ الملح",17,"ح",1,0],["تَأكُل مِنها كُلَّ كَبشٍ أسرفا","وَزادَ في إِسرافِهِ فأَتلَفا",18,"ف",2,0],["تَأْكُلُ بَعْدَ الخُضْرَة اليَبِيسا","وَلَمْ يُدِرُّوا جَلْدَةً برْعِيسا",19,"س",2,0],["تأكل القولُ ذا البساطة مسياً","بعد روثِ الحمار في كل فجر",20,"ر",1,0],["تأكلُ العشبَ وهو ينسجُ لحماً","وينمى عظامها بالدِّهانِ",21,"ن",1,0],["تأكل الغثّ والسّمين ولا تت","رك يوماً لذي الجناحين ريشا",22,"ش",2,0],["تاكلون البر منه وبه","عندكم تلك الدنانير انجلت",23,"ت",1,0],["تأكل من فأر بيتنا رغدا","واين بالشاكرين الرغد",24,"د",1,0],["تأكل الخير وترمي","أهله للنائبات",25,"ت",1,0],["تَأكلُ سُحتاً وَتُزِلُّ الَّذي","يَبقى مِن الزاد لأُمِ النقول",26,"ل",1,0],["تَأكُلهُ حَسرة في الضَمير","وَتَسحقه خَيبة في الضُلوع",27,"ع",1,0],["تَأكُل أَغرارها الواهِمين","وَتَسحق مِن كِبرِياء العِمَم",28,"م",1,0],["تأكد رموز الحب ماتنتظر شارح","وماللحكي داعي وسمعك مكذبني",29,"ن",2,0],["تَأكُلُ النَّارُ نَفسَها فِيكَ كَي لا","يَترُكَ الفَجرُ نَجمةً لِاصطِلائِكْ",30,"ك",1,0],["تأكل الناس في وهاد أتتها","تحتمي أو على ظهور اليَفاع",31,"ع",1,0],["تأكدي أنني أجتاز من خطر","بلوح باخرتي الأمواج منفردا",32,"د",2,0],["تأكُلُ الأرضُ شَمسَها في مَراياهُ","كَما تأكلُ السُّنونُ الصَبيحا",33,"ح",2,0],["تأكد ترا مالك شريك على الوجود","بادق العبارة قلتها لك واثبتها",34,"ت",3,0],["تأكَّد لن تكون سوى كضيفٍ","وأنك راحلٌ كالسابقينَ",35,"ن",1,0],["تاكد ان المشاعر ما تقف ضدك","لا خانها البرد ترجي صوتك الدافي",36,"ف",2,0],["تأكل من لحم حمائمها","وتغوص بدمعٍ ودماءِ",37,"ا",2,0],["تآكل العظم من هول البلاء وما","زال الشقاء بأمرٍ منه موهوبِ",38,"ب",1,0],["تأكل الأخضر واليابس حربٌ","كل ما فيها من الأمر مقيتُ",39,"ت",1,0],["تأكدتُ أني دونَ حبكَ ضائعُ","وروحي على رؤياكَ صمتًا تُنازعُ",40,"ع",1,1],["تأكّدت أنْ ليس للدهر عهدُ","إذا سرّك القرب يُبكيك بُعْدُ",41,"د",1,1],["تأكدي وقتها لو ينشغل بالي","فيك انشغاله وتفكيره بجديه",42,"د",3,0],["تأكدي ما عاد تفرق لو يميل الياسمين","ماعاد اشوفه صدقيني من ورا نظارتي",43,"ت",2,0],["تآكلني الشقاءُ وأينَ أهلي","وأينَ الدارُ بل أينَ السنونو",44,"ن",2,0],["تأكلون بعضكم لكنني لا ,","ادرِ يوما ًربما قد تنهشوني.",45,"ن",2,0],["تَأَكَّدُوا أَنَّنَي أَبقَيتُ بَينَكُمُ","رُوحي تُغَنِّي أَغَاني البَدوِ والحَضَرِ",46,"ر",1,0],["20- تَأَكَّدْ أَنَّ بَعْدَ العُسْر يُسْرا","كَمَا انْكَدَرَتْ سَتَنْقَشِعُ الغيومُ",47,"م",1,0],["تآكَلَ فيها الناسُ حتّى","تَظُنَّ الأرضَ عامِرَةً خَرابا",48,"ب",2,0],["تأكُلُ عشبَ الثرى وتُرضِعُني","دَرًّا وتكسو بالصوفِ لي جسدا",49,"د",2,0]]}