,"https://www.poetsgate.com/ViewPoem.aspx?id=186747",""],[5061,"ياذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147154",""],[5061,"دنيا الفنا","https://www.poetsgate.com/ViewPoem.aspx?id=152995",""],[5277,"غيرة بيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=185661",""],[5277,"سرُّ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=188635",""],[5277,"ثورةُ الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=198498",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[5431,"وعرّشت في الأعماق نبعا وماجفّا","https://www.poetsgate.com/ViewPoem.aspx?id=198714",""],[5438,"تَكْوِينٌ لِذَاتِي","https://www.poetsgate.com/ViewPoem.aspx?id=202094",""],[5561,"الحوار السادس","https://www.poetsgate.com/ViewPoem.aspx?id=205186",""],[5720,"أقمار الزمان (*)","https://www.poetsgate.com/ViewPoem.aspx?id=212483",""],[5722,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=12690",""],[5818,"وإنّ غداً لناظرهِ قريب","https://www.poetsgate.com/ViewPoem.aspx?id=199691",""]],"verses":[["وَفي خِدرِهِ غَرّاءُ مِن آلِ طَلحَةٍ","عَلاقَةُ قَلبٍ لِلنَديمِ المُخالِمِ",0,"م",1,0],["وَفي خُطوبِ الدَهرِ إِن فُتِّشَت","طَعمانِ مِن شُهدٍ وَخُطبانِ",1,"ن",1,0],["وَفي خُطاهُ وَفي مَفاصِلِهِ","نَعَم وَفي شَعرِهِ وَفي بَشَرِه",2,"ر",2,0],["وفي خُلُقِ الزّمان طباعُ خُلْفٍ","تُمرِّرُ في فمي النُّغَبَ العذابا",3,"ب",2,0],["وفي خيرِ الأنامِ لنا عزاءٌ","وغايتنا إلى هذا المصيرِ",4,"ر",1,0],["وفي خيرِ الأنامِ لكمْ عزاءٌ","وليس لساكن الدنيا دوامُ",5,"م",1,0],["وَفِي خِصَالٍ مُتَمَّمَاتٍ","بِالْخُلُقِ الطَّاهِرِ الصَّرِيحِ",6,"ح",1,0],["وفي خدمةِ الأوطانِ قمتَ مشمراً","وواليت من يسعى إلى ذلك الأمرِ",7,"ر",1,0],["وفي خراسانَ قد شِيدتْ مآثره","أرَّخَها صيتُها تاريخَ ميلادِ",8,"د",1,0],["وفي خَدِّه نارٌ وماء تَألَّفا","ومن عَجبٍ ماءٌ خِلال ضِرام",9,"م",1,0],["وفي خَلل الأوراق وُرْقٌ غناؤها","ألذُّ وأحلى في القلوب من الغنى",10,"ن",2,0],["وفي خلقة الإنسان تقصير طبعه","عن الصبر إلا فاضل وجليل",11,"ل",1,0],["وفي خلق الدنيا وساكن أرضها","تغير حال وانقطاع سرور",12,"ر",1,1],["وفي خلقه الانسان هذا وإنمّا","يكفّ التقى والدين شرّ الحقائد",13,"د",1,0],["وفي خصلةٍ من هذه يَغْرَقُ الحِجا","وتغدو القوافي وهي حَسْرَى وظلَّع",14,"ع",1,0],["وفي خدّيك ما رقَّ","عن التشبيه بالخمر",15,"ر",1,0],["وفي خلف عوضته من شقيقه","زواهرُ فضل تبهر الزُهر طلعا",16,"ع",2,0],["وفي خدَّيكِ وردٌ منهُ أبكي","فذاكَ الوردُ من دمعي نضير",17,"ر",1,0],["وفي خَدَّيكِ سامرّا تُريني","مِنَ الدّنيا النّضارةَ والنّضارا",18,"ر",2,0],["وَفِي خَبَل خَتمُ السُّلافَةِ بِالصَّفَا","وَحَبْلُ الوَفا بِالعَهدِ يَجرِي مَعَ الأَيدِي",19,"د",2,0],["وَفي خَلَدِي واللَّهِ ثكلك خالِدٌ","أَلِيَّةَ بَرٍّ لا ألِيَّةَ آثِمِ",20,"م",1,0],["وفي خده وردٌ وفي الروض مثله","ولكن ما تحت النواظر أنضر",21,"ر",1,0],["وفي خفوت الصوت عند اللقا","وفي حفيف الثوب والارجل",22,"ل",1,0],["وَفي خَفائي بَدا لي بِالتَنَعُّمِ في","دارَيَّ مِن غَيرِ إِثمٍ أَمرُ مَولائي",23,"ا",3,0],["وَفي خُطانا لَنا ثَوابٌ","وَاللَهُ فينا بِنا الفَعولُ",24,"ل",1,0],["وَفي خَفاهُ عَنّي إِلَيهِ","لَمّا بَدى لي مِنّي دَعاني",25,"ن",2,0],["وفي خبر مسلم","عن النبي المسلم",26,"م",1,0],["وَفي خَبيرٍ أَخبارُهُ الغرُّ بيَّنَت","حَقيقَتَها وَاللَيثُ بِالسَيفِ لاعبُ",27,"ب",1,0],["وفي خطِّ بَرْليْفَ ما دونه","جميعُ الأباطيل تُسْتَرْذَلُ",28,"ل",1,0],["وفي خدّه وردٌ جنيٌّ قطافهُ","ولكنّ سيف اللحظ يجني على الجاني",29,"ن",2,0],["وفي خلق يحكي النسيم لطافة","ومن دونه في النشر رائحة الند",30,"د",1,0],["وَفِي خَصْرِها قاضٍ كَرَأْيكَ في الْعِدَا","بِهِ تَنْقَضِي أَعْمَارُهُمْ وَيُعَمِّرُكْ",31,"ك",1,0],["وفي خلع العذار بها","روى مكحولها عذري",32,"ر",2,0],["وَفِي خيولِكَ حازَ الدَّرْبَ يُصْعِقُهُ","بكُلِّ مُبْرِقِ غيمِ الموت مُرْعِدِهِ",33,"د",2,0],["وفي خنبقة عقبى تنكبه","وردت ماء كماء العشر والغرب",34,"ب",1,0],["وفي خَطَلِ الرمح انحناءٌ وإنما","تُعَدُّ أنابيبٌ له وكعوبُ",35,"ب",1,0],["وفي خدّه روضةٌ بالجفون","تجني على طرف من جاء يجني",36,"ن",2,0],["وفي خلف إن ألحقتنا يدالمني","لنا خلف لا يخلف الظن ماطره",37,"ر",2,0],["وفي خد ذات الخال حمرة جمرة","على نارها ماء الصبا يترقرق",38,"ق",1,0],["وفي خيلهم كر وفر وعندهم","طعان وضرب بالقنا واللهاذم",39,"م",1,0],["وفي خدي تسيل عمى","فلم أرها ولم ترني",40,"ن",2,0],["وفي خلق تكويني بحق تمكني","جلوت جمال في عيون تعييني",41,"ي",1,0],["وفي خلدٍ من كل خُرد خُلوده","مع الخُرَد الغِيد المَهى جلواته",42,"ت",2,0],["وفي خاصفِ النّعلِ البيانُ وعبرةٌ","لِمعتَبِرٍ إذ قال والنّعلُ تُرقَعُ",43,"ع",1,0],["وفي خيبرٍ فاسأل به آل خيبرٍ","أَمِن ضربِهم بالسيفِ هل كان يَشبَعُ",44,"ع",1,0],["وَفي خدرها أُسدُ الشَرى يَحرسونها","بِبيض وَسُمر لا تردّ عَن الحفز",45,"ز",1,0],["وَفي خامس الساعات مِن لَيل جُمعة","أَتى يَزدَري في نُوره بِالفَراقد",46,"د",1,0],["وَفي خدمة الأَوطان أَبدى كِفايةً","تَلوح عَلَيهِ مِن زَمان وَلاده",47,"د",2,0],["وَفي خَزائن مصر لا يَكون لَهُ","مِنها نَفاد وَباب العُسر مَسدود",48,"د",1,0],["وَفي خَيرِ خَلقِ اللَّهِ لِلنّاسِ أُسوةٌ","وَفيهِ مُصاب النّاسِ أَعلى وَأَصعبُ",49,"ب",1,0],["وَفي خَدِّهِ مِن خالِهِ وَورودِهِ","إِلى الحسنِ دينارٌ وَقيراط مِن مِسكِ",50,"ك",1,0],["وَفي خِلالِها أَتانا زائِرا","جَمّ غَفير يَشرَحونَ الخاطِرا",51,"ر",2,0],["وَفي خِلالِها جَرَت مذاكَرَه","أَشبَه شَيء هِيَ بِالمُناظَرَه",51,"ه",1,0],["وفي خارج البنيان هيكل زهرة","وتلك إله الحسن فيها التورع",52,"ع",1,0],["وَفِي خَدَّيْكَ صَاغَ الحُسْنُ لاَمًا","عَلَى لَوْحَيْنِ مِنْ وَرَقٍ وَعَيْنِ",53,"ن",1,0],["وفي خزي رأس الكفر عمر وحزبه","دنوا أولي التقوى القيام الرواكع",54,"ع",1,0],["وفي خدها عين الحياة أما ترى","بها غصن الأصداغ أضحى بنعم",55,"م",1,0],["وفي خديجة والزهراء ووالدها","وفي البنين وفي الأزواج آيات",56,"ت",1,0],["وفي خديجة لما جاء ميسرة","سر لطيف أراها قدره عظما",57,"م",2,0],["وفي خرجه زاد قومٍ صيام","جياعٍ، وشمسُهُمُ تُدْبِرُ",58,"ر",1,0],["وفي خير اقبالٍ وعزٍّ وثروةٍ","وفي صحةٍ مقرونةٍ بالتدوّمِ",59,"م",1,0],["وَفي خَلْخَالِها خَرَسٌ ولكنْ","إِذا أَوْمَأْتُ تَفْهَمُ بالإِشارَهْ",60,"ر",2,0],["وفي خصوص أولياك","نكتب من العارفين",61,"ن",1,0],["وفي خبز يجرره عفي","نذيرة خسف أرض أو قيامه",62,"ه",1,1],["وفي خطوب الزمان لي عِظةٌ","لو كان يثني النفوس واعظُها",63,"ظ",3,0],["وفي خيبر قد صدّق الخبر في الوغى","لهم خبرا قد سلسلته الجحافل",64,"ل",1,0],["وفي خدها ورد المسرة ينجلي","لنا وبه قطر الهناء صريح",65,"ح",1,0],["وفي ختن هذا النجل فرح مؤبد","ومجد واشراق بكل ضياء",66,"ا",2,0],["وفي خديجةَ والزهرا وما ولدت","أزكى مديحي سأهدي دائماً دُرَرَه",67,"ر",2,0],["وفي ختامٍ جميلٍ طيبٍ حسنٍ","فبالختامِ يتِمُّ القَصدُ والوَطَرُ",68,"ر",1,0],["وفي خيار البيع ثم العدّه","وأجل عقيقة وعهدَه",69,"ه",1,0],["وفي ختم المقال أهدي سلامي","على المرسول شفّاع البريّه",70,"ي",2,0],["وفي خلوة الانس التي سمحت بها","أرتني سروراً ما رآه متيم",71,"م",1,0],["وفي خدها جمرٌ اظن التهابه","سرى من فؤادي حينما يتلهب",72,"ب",1,0],["وفي خمسةٍ منّي حَلَتْ منكِ خمسةٌ","فَريقُكِ منها في فمي طيِّبُ الرَّشْفِ",73,"ف",1,1],["وفي خلوة الإنسان بالعلم أنسهُ","ويسلم دين المرء عند التوحد",74,"د",1,0],["وفي خبر الثقلين هاد إلى الذي","تنازع فيه الناس والتبس الأمر",75,"ر",1,0],["وفي خدها وردٌ هممتُ بَقطْفِهِ","ولكنّ سيفَ المقلتين حماني",76,"ن",2,0],["وَفي خَمسة مني حَلَت منكَ خَمسة","فَريقك مِنها في فَمي الطَيب الرَشف",77,"ف",1,1],["وفي خفايا شقاء نال ذا أربٍ","وفي تنعم غرٍ عاش وهو عمي",78,"م",2,0],["وفي خنصر اليمنى ويسراه خاتم","ويردف عبدا او سواه بلا نكر",79,"ر",1,0],["وفي خيام الخمر تلقى ثاوياً","إذا حوانا المسجد المشهود",80,"د",1,0],["وفي خميس من خيار يعرب","ذوي رماح وخيول سبّق",81,"ق",1,0],["وَفي خَيبَر أَعطاه راية نَصره","وَعَممه في كَفه فسَما قَدرا",82,"ر",2,0],["وَفي خَده نار خبتها أَضالعي","إِذا ما سرى في مُهجَتي حرها يَسري",83,"ر",2,0],["وفي خامس والعشر نصف محرم","لنا قدر الرحمن أوبة قافل",84,"ل",1,0],["وفي خيبر رفت بكفك راية","عليك بها النصر الألهي انزلا",85,"ل",2,0],["وفي خمائلهِ ذات النضارة ما","تَشآؤُهُ من سوى نَخلٍ وَرُمّانِ",86,"ن",1,0],["وَفي خَصائصه العُظمى عموم عُلا","لِمَن دَعاه فَلبّاه بإِيقان",87,"ن",1,0],["وَفي خطبه هذى القُلوب تُصدَّعُ","فَيا قمراً قَد غابَ هيهات تَطلعُ",88,"ع",1,0],["وَفي خدّك النعمانُ يَحميهِ أَسوَدٌ","ووالده دَهري إِذا رُمت زخرفا",89,"ف",2,0],["وفي خيبر هل رحبت نفس مرحب","بغير شبا قرضا به لاخترامها",90,"م",3,0],["وفي خِيف المحصَّب قد علمتم","بهرب الحارثيّ بلا اختيال",91,"ل",1,0],["وَفي خَصرِهِ آغَمَمنُونُ أَلقى","سِناناً يُشَقِّقُ أَخشاه شَقَّا",92,"ق",2,0],["وَفي خِلالِ جُموعِ المُسلِمينَ سَعَت","مَدافِعُ لِعَذابِ الضَد في صَعَد",93,"د",1,0],["وفي خلفى يكون خليفة لى","به كل يرى برّا تقيا",94,"ي",2,0],["وفي خلقى بعد الوفاة يكون لى الخليفة","اذا واروا بلحدى لى شخصا",95,"ص",2,0],["وفي خلفى اخلفنى وأنطق بحجتى","لسانى اذا حليت قبرا منبشا",96,"ش",2,0],["وفي خلفى اخلفنى وأصلح شؤونهم","اذامت واستولت علىّ السوابخ",97,"خ",1,0],["وفي خلفى اخلفنى وكن شافعى غدا","من النار اذ قلب العصاة بها يكوى",98,"و",2,0],["وفي خلال تلاقينا وموقفنا","وقربنا وتناجينا وشكوانا",99,"ن",2,0],["وفي خدودك ما ماج الجمال بها","للطرف أبهج روض يانع نضر",100,"ر",1,0],["وفي خِيامِ الحَي أحوَى حوَى","رِقِّيِ لهُ كفٌّ رقيقُ البَنَان",101,"ن",1,0],["وفي خدِّه من دمي شاهدٌ","وحَسبك من شاهدٍ عادل",102,"ل",1,0],["وفي خطوكِ الحر إيقاعة","تهد الفؤاد وتطوي النوى",103,"و",2,0],["وفي خد مصر لطفه لاح شامةً","تُباهي بلاد الشام منها المنايحِ",104,"ح",1,0],["وفي خدها التفاح بادٍ صلاحةُ","فافسد نساك الغرام بلا صلحِ",105,"ح",1,0],["وفي خاطري من ميل عطفيه خاطرٌ","بغير الفنا بالجر والعقل نصبه",106,"ب",2,0],["وفي خَلَدِ السَّمّاءِ أَرَاكَ فَجْرًا","يَزِيدُ الكَوْنَ إِشْرَاقًا وَضَيَّا",107,"ي",2,0],["وفي خوة الوافين انا ماتهنيت","خوة سنه ثم قال للصد هيا",108,"ي",2,0],["وفي ختمها ........يالله ياخير معبود","تكفيني الدنيا ....وقسوة عناها",109,"ا",3,0],["وفي خافقي سقمُ هذا العنا","ومن مقلتي دمعةٌ تسكبُ",110,"ب",1,0],["وَفي خَدَّيْهِ أزْهارٌ","أباحتْ لِلنوا عِطْرَهْ",111,"ر",2,0],["وفي خدودِكِ نبعٌ فيهِ مرتشفٌ","فيهِ لنا مذْ شربنا ماءَهُ وطرُ",112,"ر",1,0],["وفي خيمةٍ يقطرُ الماءُ فيها","ويقرعُ في الطست منه صليلا",113,"ل",2,0],["وفي خافقي حبه لاسواه","أضاءت شموسي به ساطعه",114,"ع",2,0],["وفي خافقي المذبوح إرث جهالة","هديرٌ مع الأمواج يستوجب الخسفا!",115,"ف",2,0],["وفي خَاطِرِي سِرٌّ تَقَدَّسَ سِرُّهُ","وَشَى بِالمَعَانِي وَ القَوَافِي لِيَفْضَحَا",116,"ح",2,0],["وفي خطواتِهِ وَلَهً سخيٌّ","تمادى في تعثَّرِهِ جوابُ",117,"ب",1,0],["وفي خير الشهور نظمتُ شعري","لِمَن هم فيه .. أقمارُ الزمانِ",118,"ن",1,0],["وفي خلوةِ الحقلِ نبعٌ حبيبٌ","يهدهدُ أوجاعهُ الباكيه",119,"ي",2,0],["وفي خنتوشة اللايكات تفنى","وتكثر في محيّاها الندوب",120,"ب",1,0]]}