{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[45,"ضاعف من بثي وأحزاني","https://www.aldiwan.net/poem66820.html","السريع"],[49,"ماذا يريك الزمان من عبره","https://www.aldiwan.net/poem62113.html","المنسرح"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[69,"دموع يستبقن إلى النحور","https://www.aldiwan.net/poem28750.html","الوافر"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[136,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[143,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[186,"ألا يا نسيم الريح إن كنت عابرا","https://www.aldiwan.net/poem14661.html","الطويل"],[186,"تولى شباب واقتراب فأمعنا","https://www.aldiwan.net/poem14733.html","الطويل"],[187,"ولم أر مثل الصبر أما مذاقه","https://www.aldiwan.net/poem43443.html","الطويل"],[187,"وفي خلق الدنيا وساكن أرضها","https://www.aldiwan.net/poem43875.html","الطويل"],[187,"إذا كنت مرتادا صديقا لعشرة","https://www.aldiwan.net/poem43968.html","الطويل"],[230,"إذا رمت أن أثني بما أنت أهله","https://www.aldiwan.net/poem50963.html","الطويل"],[230,"أتنسى أيها العات","https://www.aldiwan.net/poem51076.html","الهزج"],[262,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[271,"لقد هاج الهوى هذا الحرير","https://www.aldiwan.net/poem35446.html","الوافر"],[271,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[276,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[276,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[304,"يقابل بدر التم منه بطلعة","https://www.aldiwan.net/poem58012.html","الطويل"],[343,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[350,"رفضت سنة أهل الزهد معتمدا","https://www.aldiwan.net/poem15495.html","البسيط"],[350,"أشكو إلى الله جهل قوم","https://www.aldiwan.net/poem15850.html","مخلع البسيط"],[350,"بنطق سمعي جرى لساني","https://www.aldiwan.net/poem15963.html","مخلع البسيط"],[392,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[394,"أيعسوب دين الله صنو نبيه","https://www.aldiwan.net/poem53623.html","الطويل"],[401,"إيقاعات على نيل مصر","https://www.aldiwan.net/poem6726.html","عموديه"],[403,"فراقكم هاج اشتياقي وأشجاني","https://www.aldiwan.net/poem46756.html","الطويل"],[404,"دع اللوم إن سالت دموعي على خدي","https://www.aldiwan.net/poem33938.html","الطويل"],[425,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[430,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[440,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[442,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[459,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[465,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[496,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[516,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[516,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"]],"verses":[["وَفي خِدرِهِ غَرّاءُ مِن آلِ طَلحَةٍ","عَلاقَةُ قَلبٍ لِلنَديمِ المُخالِمِ",0,"م",1,0],["وَفي خُطوبِ الدَهرِ إِن فُتِّشَت","طَعمانِ مِن شُهدٍ وَخُطبانِ",1,"ن",1,0],["وَفي خُطاهُ وَفي مَفاصِلِهِ","نَعَم وَفي شَعرِهِ وَفي بَشَرِه",2,"ر",2,0],["وفي خُلُقِ الزّمان طباعُ خُلْفٍ","تُمرِّرُ في فمي النُّغَبَ العذابا",3,"ب",2,0],["وفي خيرِ الأنامِ لنا عزاءٌ","وغايتنا إلى هذا المصيرِ",4,"ر",1,0],["وفي خيرِ الأنامِ لكمْ عزاءٌ","وليس لساكن الدنيا دوامُ",5,"م",1,0],["وَفِي خِصَالٍ مُتَمَّمَاتٍ","بِالْخُلُقِ الطَّاهِرِ الصَّرِيحِ",6,"ح",1,0],["وفي خدمةِ الأوطانِ قمتَ مشمراً","وواليت من يسعى إلى ذلك الأمرِ",7,"ر",1,0],["وفي خراسانَ قد شِيدتْ مآثره","أرَّخَها صيتُها تاريخَ ميلادِ",8,"د",1,0],["وفي خَدِّه نارٌ وماء تَألَّفا","ومن عَجبٍ ماءٌ خِلال ضِرام",9,"م",1,0],["وفي خَلل الأوراق وُرْقٌ غناؤها","ألذُّ وأحلى في القلوب من الغنى",10,"ن",2,0],["وفي خلقة الإنسان تقصير طبعه","عن الصبر إلا فاضل وجليل",11,"ل",1,0],["وفي خلق الدنيا وساكن أرضها","تغير حال وانقطاع سرور",12,"ر",1,1],["وفي خلقه الانسان هذا وإنمّا","يكفّ التقى والدين شرّ الحقائد",13,"د",1,0],["وفي خصلةٍ من هذه يَغْرَقُ الحِجا","وتغدو القوافي وهي حَسْرَى وظلَّع",14,"ع",1,0],["وفي خدّيك ما رقَّ","عن التشبيه بالخمر",15,"ر",1,0],["وفي خلف عوضته من شقيقه","زواهرُ فضل تبهر الزُهر طلعا",16,"ع",2,0],["وفي خدَّيكِ وردٌ منهُ أبكي","فذاكَ الوردُ من دمعي نضير",17,"ر",1,0],["وفي خَدَّيكِ سامرّا تُريني","مِنَ الدّنيا النّضارةَ والنّضارا",18,"ر",2,0],["وَفِي خَبَل خَتمُ السُّلافَةِ بِالصَّفَا","وَحَبْلُ الوَفا بِالعَهدِ يَجرِي مَعَ الأَيدِي",19,"د",2,0],["وَفي خَلَدِي واللَّهِ ثكلك خالِدٌ","أَلِيَّةَ بَرٍّ لا ألِيَّةَ آثِمِ",20,"م",1,0],["وفي خده وردٌ وفي الروض مثله","ولكن ما تحت النواظر أنضر",21,"ر",1,0],["وفي خفوت الصوت عند اللقا","وفي حفيف الثوب والارجل",22,"ل",1,0],["وَفي خَفائي بَدا لي بِالتَنَعُّمِ في","دارَيَّ مِن غَيرِ إِثمٍ أَمرُ مَولائي",23,"ا",3,0],["وَفي خُطانا لَنا ثَوابٌ","وَاللَهُ فينا بِنا الفَعولُ",24,"ل",1,0],["وَفي خَفاهُ عَنّي إِلَيهِ","لَمّا بَدى لي مِنّي دَعاني",25,"ن",2,0],["وفي خبر مسلم","عن النبي المسلم",26,"م",1,0],["وَفي خَبيرٍ أَخبارُهُ الغرُّ بيَّنَت","حَقيقَتَها وَاللَيثُ بِالسَيفِ لاعبُ",27,"ب",1,0],["وفي خطِّ بَرْليْفَ ما دونه","جميعُ الأباطيل تُسْتَرْذَلُ",28,"ل",1,0],["وفي خدّه وردٌ جنيٌّ قطافهُ","ولكنّ سيف اللحظ يجني على الجاني",29,"ن",2,0],["وفي خلق يحكي النسيم لطافة","ومن دونه في النشر رائحة الند",30,"د",1,0],["وَفِي خَصْرِها قاضٍ كَرَأْيكَ في الْعِدَا","بِهِ تَنْقَضِي أَعْمَارُهُمْ وَيُعَمِّرُكْ",31,"ك",1,0],["وفي خلع العذار بها","روى مكحولها عذري",32,"ر",2,0],["وَفِي خيولِكَ حازَ الدَّرْبَ يُصْعِقُهُ","بكُلِّ مُبْرِقِ غيمِ الموت مُرْعِدِهِ",33,"د",2,0],["وفي خنبقة عقبى تنكبه","وردت ماء كماء العشر والغرب",34,"ب",1,0],["وفي خَطَلِ الرمح انحناءٌ وإنما","تُعَدُّ أنابيبٌ له وكعوبُ",35,"ب",1,0],["وفي خدّه روضةٌ بالجفون","تجني على طرف من جاء يجني",36,"ن",2,0],["وفي خلف إن ألحقتنا يدالمني","لنا خلف لا يخلف الظن ماطره",37,"ر",2,0],["وفي خد ذات الخال حمرة جمرة","على نارها ماء الصبا يترقرق",38,"ق",1,0],["وفي خيلهم كر وفر وعندهم","طعان وضرب بالقنا واللهاذم",39,"م",1,0],["وفي خدي تسيل عمى","فلم أرها ولم ترني",40,"ن",2,0]]}