{"poems":[[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[51,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[61,"فؤادي بك مشغوف","https://www.aldiwan.net/poem51550.html","الهزج"],[46,"إذا اجتمع اثنان في منزل","https://www.aldiwan.net/poem22498.html","المتقارب"],[46,"غفرت زمانا في انتكاس مآثم","https://www.aldiwan.net/poem22517.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[115,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[117,"قرطبة","https://www.aldiwan.net/poem24050.html","الطويل"],[125,"سلام على حمص وإن غير البلى","https://www.aldiwan.net/poem4063.html","الطويل"],[128,"بنى مصعب أنتم أولو العلم والهدى","https://www.aldiwan.net/poem50505.html","الطويل"],[150,"أروح على ذكر النبي وأغتدي","https://www.aldiwan.net/poem68602.html","الطويل"],[211,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[270,"متى ألقى الغواني والعذارى","https://www.aldiwan.net/poem35023.html","الوافر"],[270,"فتاتي الصغيرة تهوى النقارا","https://www.aldiwan.net/poem35454.html","المتقارب"],[280,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[298,"إن كان للموت حتما كل مولود","https://www.aldiwan.net/poem36254.html","عموديه"],[328,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[349,"لست بذي وجد إذا","https://www.aldiwan.net/poem15651.html","مجزوء الرجز"],[353,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[366,"ترى عندهم أن العذاب غرام","https://www.aldiwan.net/poem17098.html","الطويل"],[371,"وللندى أوجه إذا سفرت","https://www.aldiwan.net/poem57177.html","المنسرح"],[391,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[416,"حباك الله منه بالشفاء","https://www.aldiwan.net/poem53925.html","الوافر"],[429,"لقد جمع المعشوق قلبي بنونه","https://www.aldiwan.net/poem41012.html","الطويل"],[432,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[453,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[458,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[495,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[573,"أرى عقرب الصدغ في خده","https://www.aldiwan.net/poem3658.html","المتقارب"]],"verses":[["وفِي وفِي فِي ثمَّ فِي فِي وفِي وفِي","وفِي وجنَتَي سَلمَى أُقَبِّلُ لَم أَمَل",0,"ل",1,0],["وفي وسط النادي سراج منور","فتحسبه بدراً وهم هالة البدر",1,"ر",1,0],["وفَى وَعَفَا عن كلِّ صاحِبِ هفْوَةٍ","وكابَدَ ما دون العُلا من كُؤُودها",2,"د",3,0],["وفيٌّ وتلكم شيمةٌ طاهريةٌ","له سلفٌ فيها قديمٌ قُدامس",3,"س",1,0],["وفي وعدِكَ إن جُدْتَ","به مَطْلٌ وتَسويفُ",4,"ف",1,0],["وَفي وَحدَةِ المَرءِ سِترُ لَهُ","فَكُن مِثلَ سَيفِكَ حِلفَ الرُبَد",5,"د",1,0],["وَفي وَحدَةِ الإِنسانِ أَصنافُ لَذَّةٍ","وَكُلُّ صُنوفِ الوَحشِ يَجمَعُها القَفرُ",6,"ر",1,0],["وَفِي وَصْفِ عَبْدِ اللهِ أَوْ بَعْضِ وَصْفِهِ","يُقصِّرُ مَنْ يَفْنِي قَرِيحَتهُ جُهْدَا",7,"د",2,0],["وفي وقعة اليرموك كر بصولة","تفيد احتقار الموت من طور خالد",8,"د",1,0],["وفي وَجْنَتَيْها مِن دُموعٍ كَذُوبةٍ","عَلاماتُ كُحْلٍ للبراءةِ تَدَّعي",9,"ي",1,0],["وَفِي وَجَناتِ الدَّهرِ إِذذَاكَ رَونَقٌ","كَمَا رَونَق الصّقلُ الحُسامَ اليَمَانيا",10,"ي",2,0],["وفي وجهِ من يقلاكمُ آلَ جريةٍ","وإن كانَ ذَا قُرْبى حَصىً ورَغَامُ",11,"م",1,0],["وَفي وَجهِهِ لِلعَين أَمتَعُ نُزهَةٍ","ثُقوبُ سَناهُ لَم يَدَع لَيلَ شُبهَةٍ",12,"ه",1,0],["وفيّون في حبي لمالي فإن رأوا","سحابة فقرٍ أسرعوا فتمزقوا",13,"ق",3,0],["وفي وطنِ العروبة كلُّ أمٍّ","تُهَذِّبُ صبيةً وتزينُ دارا",14,"ر",2,0],["وفي وَجهها قطراتُ جمالٍ","على كلِّ قلبٍ تصيرُ شرارا",15,"ر",2,0],["وفي وَجهها الزهراتُ تقولُ","لرامِقها ما أعزَّ الثمارا",15,"ر",2,0],["وَفِي واحِدٍ مِنْ بَنِي أَحْمَدٍ","لَنا خَلَفٌ مِنْ جَمِيعِ الأَنامِ",16,"م",1,0],["وَفى وَأخلص في سرٍّ وَفي علنٍ","إذ كان بعضُهمُ في الغدرِ كالسيد",17,"د",1,0],["وفي واديك كم ضلل","صب واهتدى صب",18,"ب",1,0],["وَفي وَقودِ نارِهِ","لِلناسِ أَضحى مُؤَبَّذا",19,"ذ",2,0],["وَفى وَأَخو الوَفاءِ أَخو المَعالي","وَمَن أَوفى بِعَونك مِنهُ وَعدا",20,"د",2,0],["وَفي وَجهِهِ لَو لَم يُحَيِّ تَحِيَّةٌ","وَيَلقاهُ مِن دونِ السَلامِ سَلامُ",21,"م",1,0],["وَفي وُصولي إِليكَ قَد وصَلَت","إليَّ مُمتَدَّةً أَوائِلُها",22,"ل",3,0],["وفي وزن وجسر","ونيران وجنات",23,"ت",1,0],["وفي وجدانك الأَيَّام تزهو","كما تزهو الرِّياض من البهاء",24,"ا",2,0],["وفي واوه خمس الحواس ترفّعت","وجرّ بلام البعد قلبا به ألف",25,"ف",1,0],["وفيولٍ من المَجَانيقِِ لا بَلْ","هيَ في الحربِ تقذِفُ الأَفْيالا",26,"ل",2,0],["وفي وحشتي فوجئت غير مؤمَّلٍ","بمسحة نور بدّدت كل إِظلامي",27,"ي",1,0],["وفي وفاءِ الحلو الوفاء ابن أي","يوب مَرادٌ كافٍ ومنتجَعُ",28,"ع",1,0],["وفي واديه متَّسَع","لأمالي ومنتدَح",29,"ح",1,0],["وَفي وَجنَتَيهِ شُعاعَ اللَهيبِ","وَفي أَضلُعي قَبَسَ المُلهِبِ",30,"ب",1,0]]}