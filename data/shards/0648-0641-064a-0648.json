{"poems":[[108,"خليلي","https://www.shoaraa.com/p11134",""],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[51,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[61,"فؤادي بك مشغوف","https://www.aldiwan.net/poem51550.html","الهزج"],[46,"إذا اجتمع اثنان في منزل","https://www.aldiwan.net/poem22498.html","المتقارب"],[46,"غفرت زمانا في انتكاس مآثم","https://www.aldiwan.net/poem22517.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[116,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[118,"قرطبة","https://www.aldiwan.net/poem24050.html","الطويل"],[126,"سلام على حمص وإن غير البلى","https://www.aldiwan.net/poem4063.html","الطويل"],[129,"بنى مصعب أنتم أولو العلم والهدى","https://www.aldiwan.net/poem50505.html","الطويل"],[151,"أروح على ذكر النبي وأغتدي","https://www.aldiwan.net/poem68602.html","الطويل"],[212,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[271,"متى ألقى الغواني والعذارى","https://www.aldiwan.net/poem35023.html","الوافر"],[271,"فتاتي الصغيرة تهوى النقارا","https://www.aldiwan.net/poem35454.html","المتقارب"],[281,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[299,"إن كان للموت حتما كل مولود","https://www.aldiwan.net/poem36254.html","عموديه"],[329,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[350,"لست بذي وجد إذا","https://www.aldiwan.net/poem15651.html","مجزوء الرجز"],[354,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[367,"ترى عندهم أن العذاب غرام","https://www.aldiwan.net/poem17098.html","الطويل"],[372,"وللندى أوجه إذا سفرت","https://www.aldiwan.net/poem57177.html","المنسرح"],[392,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[417,"حباك الله منه بالشفاء","https://www.aldiwan.net/poem53925.html","الوافر"],[430,"لقد جمع المعشوق قلبي بنونه","https://www.aldiwan.net/poem41012.html","الطويل"],[433,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[454,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[459,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[496,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[574,"أرى عقرب الصدغ في خده","https://www.aldiwan.net/poem3658.html","المتقارب"]],"verses":[["وفي ودها أجر النبي فحيثما","جرى بغضها حق النبي يعطّل",0,"ل",1,0],["وفِي وفِي فِي ثمَّ فِي فِي وفِي وفِي","وفِي وجنَتَي سَلمَى أُقَبِّلُ لَم أَمَل",1,"ل",1,0],["وفي وسط النادي سراج منور","فتحسبه بدراً وهم هالة البدر",2,"ر",1,0],["وفَى وَعَفَا عن كلِّ صاحِبِ هفْوَةٍ","وكابَدَ ما دون العُلا من كُؤُودها",3,"د",3,0],["وفيٌّ وتلكم شيمةٌ طاهريةٌ","له سلفٌ فيها قديمٌ قُدامس",4,"س",1,0],["وفي وعدِكَ إن جُدْتَ","به مَطْلٌ وتَسويفُ",5,"ف",1,0],["وَفي وَحدَةِ المَرءِ سِترُ لَهُ","فَكُن مِثلَ سَيفِكَ حِلفَ الرُبَد",6,"د",1,0],["وَفي وَحدَةِ الإِنسانِ أَصنافُ لَذَّةٍ","وَكُلُّ صُنوفِ الوَحشِ يَجمَعُها القَفرُ",7,"ر",1,0],["وَفِي وَصْفِ عَبْدِ اللهِ أَوْ بَعْضِ وَصْفِهِ","يُقصِّرُ مَنْ يَفْنِي قَرِيحَتهُ جُهْدَا",8,"د",2,0],["وفي وقعة اليرموك كر بصولة","تفيد احتقار الموت من طور خالد",9,"د",1,0],["وفي وَجْنَتَيْها مِن دُموعٍ كَذُوبةٍ","عَلاماتُ كُحْلٍ للبراءةِ تَدَّعي",10,"ع",2,0],["وَفِي وَجَناتِ الدَّهرِ إِذذَاكَ رَونَقٌ","كَمَا رَونَق الصّقلُ الحُسامَ اليَمَانيا",11,"ي",2,0],["وفي وجهِ من يقلاكمُ آلَ جريةٍ","وإن كانَ ذَا قُرْبى حَصىً ورَغَامُ",12,"م",1,0],["وَفي وَجهِهِ لِلعَين أَمتَعُ نُزهَةٍ","ثُقوبُ سَناهُ لَم يَدَع لَيلَ شُبهَةٍ",13,"ه",1,0],["وفيّون في حبي لمالي فإن رأوا","سحابة فقرٍ أسرعوا فتمزقوا",14,"ق",3,0],["وفي وطنِ العروبة كلُّ أمٍّ","تُهَذِّبُ صبيةً وتزينُ دارا",15,"ر",2,0],["وفي وَجهها قطراتُ جمالٍ","على كلِّ قلبٍ تصيرُ شرارا",16,"ر",2,0],["وفي وَجهها الزهراتُ تقولُ","لرامِقها ما أعزَّ الثمارا",16,"ر",2,0],["وَفِي واحِدٍ مِنْ بَنِي أَحْمَدٍ","لَنا خَلَفٌ مِنْ جَمِيعِ الأَنامِ",17,"م",1,0],["وَفى وَأخلص في سرٍّ وَفي علنٍ","إذ كان بعضُهمُ في الغدرِ كالسيد",18,"د",1,0],["وفي واديك كم ضلل","صب واهتدى صب",19,"ب",1,0],["وَفي وَقودِ نارِهِ","لِلناسِ أَضحى مُؤَبَّذا",20,"ذ",2,0],["وَفى وَأَخو الوَفاءِ أَخو المَعالي","وَمَن أَوفى بِعَونك مِنهُ وَعدا",21,"د",2,0],["وَفي وَجهِهِ لَو لَم يُحَيِّ تَحِيَّةٌ","وَيَلقاهُ مِن دونِ السَلامِ سَلامُ",22,"م",1,0],["وَفي وُصولي إِليكَ قَد وصَلَت","إليَّ مُمتَدَّةً أَوائِلُها",23,"ل",3,0],["وفي وزن وجسر","ونيران وجنات",24,"ت",1,0],["وفي وجدانك الأَيَّام تزهو","كما تزهو الرِّياض من البهاء",25,"ا",2,0],["وفي واوه خمس الحواس ترفّعت","وجرّ بلام البعد قلبا به ألف",26,"ف",1,0],["وفيولٍ من المَجَانيقِِ لا بَلْ","هيَ في الحربِ تقذِفُ الأَفْيالا",27,"ل",2,0],["وفي وحشتي فوجئت غير مؤمَّلٍ","بمسحة نور بدّدت كل إِظلامي",28,"م",2,0],["وفي وفاءِ الحلو الوفاء ابن أي","يوب مَرادٌ كافٍ ومنتجَعُ",29,"ع",1,0],["وفي واديه متَّسَع","لأمالي ومنتدَح",30,"ح",1,0],["وَفي وَجنَتَيهِ شُعاعَ اللَهيبِ","وَفي أَضلُعي قَبَسَ المُلهِبِ",31,"ب",1,0]]}