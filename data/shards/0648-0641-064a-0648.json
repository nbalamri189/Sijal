.dctabudhabi.ae/diwan/poem/72445","الوافر"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139548",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[4843,"يا أمةَ العربِ الأمجادِ في القدمِ","https://www.poetsgate.com/ViewPoem.aspx?id=142690",""],[4929,"تراب الورد للشعراء خدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=199440",""],[4935,"فؤادي كلما ذكر الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=129278",""],[4963,"ياصفحة التاريخ امجادنا غير","https://www.poetsgate.com/ViewPoem.aspx?id=24403",""],[5032,"كتاب البكاء","https://www.poetsgate.com/ViewPoem.aspx?id=189764",""],[3271,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=128730",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[4045,"نفّر نومي الخبر الساري","https://www.poetsgate.com/ViewPoem.aspx?id=200300",""],[5237,"بإحسان ذي الطول أهل الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=113118",""],[5277,"إنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=185231",""],[5323,"بارق ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=207293",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5526,"ريف وبساتين","https://www.poetsgate.com/ViewPoem.aspx?id=192804",""],[5718,"جواد العز","https://www.poetsgate.com/ViewPoem.aspx?id=213871",""],[402,"أنرتجل الأشعار في فرع هاشم","https://www.poetsgate.com/ViewPoem.aspx?id=35391",""],[5804,"مساجلة ( الطغاة )","https://www.poetsgate.com/ViewPoem.aspx?id=189659",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[5977,"توأم روحي","https://www.poetsgate.com/ViewPoem.aspx?id=213068",""],[5977,"لا أحد يشبهني","https://www.poetsgate.com/ViewPoem.aspx?id=213295",""],[463,"هبَّتْ ومنها الخلابُ والخدعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60118&r=&rc=174",""]],"verses":[["وفي ودها أجر النبي فحيثما","جرى بغضها حق النبي يعطّل",0,"ل",1,0],["وفِي وفِي فِي ثمَّ فِي فِي وفِي وفِي","وفِي وجنَتَي سَلمَى أُقَبِّلُ لَم أَمَل",1,"ل",1,0],["وفي وسط النادي سراج منور","فتحسبه بدراً وهم هالة البدر",2,"ر",1,0],["وفَى وَعَفَا عن كلِّ صاحِبِ هفْوَةٍ","وكابَدَ ما دون العُلا من كُؤُودها",3,"د",3,0],["وفيٌّ وتلكم شيمةٌ طاهريةٌ","له سلفٌ فيها قديمٌ قُدامس",4,"س",1,0],["وفي وعدِكَ إن جُدْتَ","به مَطْلٌ وتَسويفُ",5,"ف",1,0],["وَفي وَحدَةِ المَرءِ سِترُ لَهُ","فَكُن مِثلَ سَيفِكَ حِلفَ الرُبَد",6,"د",1,0],["وَفي وَحدَةِ الإِنسانِ أَصنافُ لَذَّةٍ","وَكُلُّ صُنوفِ الوَحشِ يَجمَعُها القَفرُ",7,"ر",1,0],["وَفِي وَصْفِ عَبْدِ اللهِ أَوْ بَعْضِ وَصْفِهِ","يُقصِّرُ مَنْ يَفْنِي قَرِيحَتهُ جُهْدَا",8,"د",2,0],["وفي وقعة اليرموك كر بصولة","تفيد احتقار الموت من طور خالد",9,"د",1,0],["وفي وَجْنَتَيْها مِن دُموعٍ كَذُوبةٍ","عَلاماتُ كُحْلٍ للبراءةِ تَدَّعي",10,"ع",2,0],["وَفِي وَجَناتِ الدَّهرِ إِذذَاكَ رَونَقٌ","كَمَا رَونَق الصّقلُ الحُسامَ اليَمَانيا",11,"ي",2,0],["وفي وجهِ من يقلاكمُ آلَ جريةٍ","وإن كانَ ذَا قُرْبى حَصىً ورَغَامُ",12,"م",1,0],["وَفي وَجهِهِ لِلعَين أَمتَعُ نُزهَةٍ","ثُقوبُ سَناهُ لَم يَدَع لَيلَ شُبهَةٍ",13,"ه",1,0],["وفيّون في حبي لمالي فإن رأوا","سحابة فقرٍ أسرعوا فتمزقوا",14,"ق",3,0],["وفي وطنِ العروبة كلُّ أمٍّ","تُهَذِّبُ صبيةً وتزينُ دارا",15,"ر",2,0],["وفي وَجهها قطراتُ جمالٍ","على كلِّ قلبٍ تصيرُ شرارا",16,"ر",2,0],["وفي وَجهها الزهراتُ تقولُ","لرامِقها ما أعزَّ الثمارا",16,"ر",2,0],["وَفِي واحِدٍ مِنْ بَنِي أَحْمَدٍ","لَنا خَلَفٌ مِنْ جَمِيعِ الأَنامِ",17,"م",1,0],["وَفى وَأخلص في سرٍّ وَفي علنٍ","إذ كان بعضُهمُ في الغدرِ كالسيد",18,"د",1,0],["وفي واديك كم ضلل","صب واهتدى صب",19,"ب",1,0],["وَفي وَقودِ نارِهِ","لِلناسِ أَضحى مُؤَبَّذا",20,"ذ",2,0],["وَفى وَأَخو الوَفاءِ أَخو المَعالي","وَمَن أَوفى بِعَونك مِنهُ وَعدا",21,"د",2,0],["وَفي وَجهِهِ لَو لَم يُحَيِّ تَحِيَّةٌ","وَيَلقاهُ مِن دونِ السَلامِ سَلامُ",22,"م",1,0],["وَفي وُصولي إِليكَ قَد وصَلَت","إليَّ مُمتَدَّةً أَوائِلُها",23,"ل",3,0],["وفي وزن وجسر","ونيران وجنات",24,"ت",1,0],["وفي وجدانك الأَيَّام تزهو","كما تزهو الرِّياض من البهاء",25,"ا",2,0],["وفي واوه خمس الحواس ترفّعت","وجرّ بلام البعد قلبا به ألف",26,"ف",1,0],["وفيولٍ من المَجَانيقِِ لا بَلْ","هيَ في الحربِ تقذِفُ الأَفْيالا",27,"ل",2,0],["وفي وحشتي فوجئت غير مؤمَّلٍ","بمسحة نور بدّدت كل إِظلامي",28,"م",2,0],["وفي وفاءِ الحلو الوفاء ابن أي","يوب مَرادٌ كافٍ ومنتجَعُ",29,"ع",1,0],["وفي واديه متَّسَع","لأمالي ومنتدَح",30,"ح",1,0],["وَفي وَجنَتَيهِ شُعاعَ اللَهيبِ","وَفي أَضلُعي قَبَسَ المُلهِبِ",31,"ب",1,0],["وفي وادي منى أهدى ضحايا","وقرّبها إلى ذات الجلالِ",32,"ل",1,0],["وفي وحدتي أصبحت بي متواحدا","تواريت عن آراء رأي مشتت",33,"ت",1,0],["وَفي وَسط الحُصون تَرى صُفوفاً","هَيَ البيّادةُ الشمُّ الأُسود",34,"د",1,0],["وفي وسط البحر قد شيدوه","ولم يرهبوا البحر والبحر طام",35,"م",1,0],["وفي وسطها طُرَّةٌ فَصُّها","على طُرَّةِ العود بل أعجب",36,"ب",1,0],["وَفي وَجهِهِ شَمسٌ وَفي الأفقِ مِثلُها","وَلَكِن ما في الوجهِ أَبهى وَأَحسنُ",37,"ن",1,0],["وَفِيٌّ وفاه كادَ يَسبقُ وَعدهُ","وَيَسبقُ مَرّ البرقِ لَو أَنّه أَبطا",38,"ط",2,0],["وفي وجهك الموسُوم بالحسنِ شاهدٌ","يُبين بأنَّ الجرحَ من عضَّة اللثم",39,"م",1,0],["وَفِي وِلادَتِهِ سِر بَدَا عَجَباً","لم تستطعْ حملَهُ الدنيا وَلَمْ تُطِقِ",40,"ق",1,0],["وفي وفد زيد الخير وابنة حاتم","ووفد أخيها ما تلي في المجامع",41,"ع",1,0],["وفي وفد زيد الخير وابنة حاتم","ووفد أخيها ما يرى المتوهم",42,"م",1,0],["وفي ولادته ما قد قضى عجبا","لمن له ظهرت تلك العلامات",43,"ت",1,0],["وَفي وادي الرسيل لكم صليت","مَدى الدُنيا بكفّيه يشيرُ",44,"ر",1,0],["وفي وجوم الحلم المستحي","إن همّ يخفيه حياء رصين",45,"ن",1,0],["وفي وسع طول اللّه ذي الطول موضع","لتسهيل أوطاري ودفع ضرورتي",46,"ي",1,0],["وفيوض الأسماء قوة تصري","في وفصلي في الكائنات ووصلي",47,"ل",2,0],["وفي وصل النسا مُذ أنتَ طفل","أخو سرف وفي السرف الغلو",48,"و",1,0],["وفي وغى فتنةٍ مُرها الفطانة ان","شئت اختلال البلا أَم عفت أَوطانا",49,"ن",2,0],["وفيٌّ وقد ضاعَ الوفاءُ وأهْلُهُ","مُصانَعَةً بين الغَوَايةِ والجَهْلِ",50,"ل",1,0],["وفي ورقاتٍ الأنف إن نفذت معاً","فثلث وإلا ثلث ثلثٍ يقللُ",51,"ل",1,0],["وفي وجد يعقوبٍ بيوسفَ أُسوة","فلا تَعذِلُوني اليَومَ في عَبرَةٍ تُذرى",52,"ر",2,0],["وَفِيّونَ إِن ذَمّوا جَرَيّونَ إِن سَطَوا","مُلَبُّونَ إِن قالوا وَفِيُّون إِن وَدّوا",53,"د",3,0],["وفي وجه المهاجم ثمّ سلاّ","مناصل ماضيات الحد بترا",54,"ر",2,0],["وفي ومضة من بارق الغيب بذت ال","سما ولها تعنو الكواكب والبدر",55,"ر",1,0],["وفي \"وهران\" قد أمسيت رهنا","لظامي الخصر ذي ردف روي",56,"ي",1,0],["وفي وسط الأرض قيجاطة","ولوشة خفَّا بأحلامنا",57,"ن",2,0],["وَفي وَقت الصَلاة يَقوم فينا","إِماماً لا تَعوّقه العَوائق",58,"ق",1,0],["وَفي وَسَطِ البِطاحِ مَحَلُّ بَيتي","مَحَلُّ اللَيثِ مِن وَسَطِ الغَريفِ",59,"ف",1,0],["وفي وعظه جد وقال اقرأوا وعوا","ولا تضربوا بالذكر بعضا من الذكر",60,"ر",1,0],["وفي وَصْلها أمس الشّقاءُ مُيَسّراً","وجاوزَ في تَيسيرهِ غايةَ الجَهْدِ",61,"د",1,0],["وَفىّ وفى بالوعد إذ كان أصله","من البدر داود حميد الخصائل",62,"ل",1,0],["وفي وَسطها عينٌ من الدرّ تذرفُ","يمُرّ بها صافي النّسيم فتألفُ",63,"ف",1,0],["وَفي وَجه أَوروبا وَفي سَطح آسيا","وَفي صَدر أَفريقا لَنا السيرة الوَضّا",64,"ض",2,0],["وفي ولادة يُمْنٍ","تُزَفُّ بالمهرجانِ",65,"ن",1,0],["وَفِي وَجهِهِ رَوضَةٌ زُيِّنَت","بِمَاءِ الحَيَاةِ وَوَردِ الخَفَر",66,"ر",1,0],["وَفيِ وُسعَةِ المَرءِ نَيلُ العُلاَ","وَقَد يَمنَعُ المَرءَ مَا يَمنَعُ",67,"ع",1,1],["وَفِيُّونَ نادى فَبَلسَمَهُ","عَلى الجُرحِ ذَرَّ فأَلأَمَهُ",68,"ه",1,0],["وَفي وحدةِ الإِنسانِ خَيرُ وِقايةٍ","إِذا فاضَ سَيلُ الدَهرِ مَفعَوعِماً شَرا",69,"ر",2,0],["وفي وفي كلّ شيء كان يطرقه","ذكرى نحسُّ بها من غيرِ تذكير",70,"ر",1,0],["وفي وَبارٍ وعَعبْقر","بين وُلْدٍ وبينَ حور",71,"ر",1,0],["وفي وكناتها العقبان القت","لهائلها القوادم والخوافي",72,"ف",2,0],["وفي وجناتهن رياض حسن","وأقمار فمن نورٍ ونور",73,"ر",1,0],["وفي وفدِ السرور أرَختُ تُجلى","سما بحرٍ تولّاهُ عطاءُ",74,"ا",2,0],["وفي وضَح المشيب على كلامي","دليلٌ ليس تنكرُه العقول",75,"ل",1,0],["وفي وجهها بدراً وبالثغر أنجما","وبالريم لفتات ورمانها النهد",76,"د",1,0],["وفي وسط قلبي أنت أودعت جمرة","بقدح وداد لا بقدح زناد",77,"د",1,0],["وَفى وأوفى نَصيبي","من كُلّ خيرٍ قَريبِ",78,"ب",1,0],["وفي وركٍ، والعبدِ ذكوان، والذي","أناخ على بشرٍ بقاصمةِ الظهرِ",79,"ر",1,0],["وَفِيٍّ وَفاءَ الرُسلِ بَينَ مَعاشِرٍ","نَصِيبُ الحِمى مِنهُم وَفاءُ الثَعالِبِ",80,"ب",1,0],["وفي وزارته العظمى القريض زها","وفاح منها على الخضراء منثورُ",81,"ر",1,0],["وفي وادي عقيق الدمع عيني","من الاجفان سوَّرت الحطيما",82,"م",2,0],["وفي وعد شهيرا كالسموأل في","حسن الوفاء وأرجى من بني ثقل",83,"ل",1,0],["وفي وَلدَيهِ تسليةٌ برزءٍ","له بضلوع كلِّ فتىً لهيب",84,"ب",1,0],["وفي وسط الفؤادِ ضعي مكاني","ومن شهقاتِ قلبِك زوّديني",85,"ن",2,0],["وفي وجنتي وادي العقيق ومنحنى","ضلوعي بها أذكى الغضا حبّ عربه",86,"ب",2,0],["وفي وفاءٍ وإخلاصٍ ومصطبرٍ","على الشدائدِ في حربٍ وفي سلمِ",87,"م",1,0],["وفي وطني المصفد بالمآسي","على الأرواح للآ جالِ حصدُُ؟",88,"د",1,0],["وفي وادي الحضور خلعت نعلي","وأوقات الشهود بدت تطيب",89,"ب",1,0],["وفي وقتنا الحاضر جنود وطوابير","فالجيش والتعليم وسهود ومهود",90,"د",1,0],["وفي وَجْهِ كافُورِ الطُّمُوحِ إلى العُلى","على دَمِنا الغالي وكُفْرِ المُتاجَرَة",91,"ر",2,0],["وفي وجهها صوفيةٌ لو تكلمتْ","لكانتْ حديثَ الطهر في كل خاطرِ",92,"ر",1,0],["وفي وجهه قسمات الرضا","تلوح فأكرم بمن أكرما",93,"م",2,0],["وفى ولاة الخرج إذ عاندوا","أعذر منهم أىّ إعذار",94,"ر",1,0],["وفي والضحى والتي إثرها","أبان المزايا وأبدى النعم",95,"م",1,0],["وفي وجناتِها الحمراءَ أيْكٌ","تقاصر عن نداهُ الجلّنارُ...",96,"ر",1,0],["وفي وجهِ من أهوى شفيعٌ مشفعٌ","وفي الأعينِ النجلاءِ ماليسَ في الرُّمْدِ",97,"د",1,0],["وفي وقعة الخرج التي شاع ذكرها","من العز والمجد الأثيل من الفخر",98,"ر",1,0],["وفي وجه الكتيبة يوم حرب","هو الضحاك إذا اشتد الضراب",99,"ب",1,0],["وفيٌ ومن نهر المكارم يرتوي","ويهدي لها شهدا فتحلو المكارم",100,"م",1,0],["وفي وجنتينه للعذوبه عناوين","مثل النهر .. ياحظ من هو عبرها",101,"ر",3,0],["وَ في وَضَحِ النَّهَارِ يَرَي اللَّيَالِي","وَ في جُنْحِ الظَّلامِ أَسَيً يَسُودُ",102,"د",1,0],["وفي وصف عبد الله أو بعض وصفه","يقصر من يفني قريته جهدا",103,"د",2,0],["وفي وَسَطِ الأرضِ نحنُ هنا","ولنْ نطويَ الإرثَ للكفرِ طيّا",104,"ي",2,0],["وفي وَدَقِ الغيث اشرأبَّ لِوَقْعِهِ","مَواتُ الثرى فارتدَّ بالغيث ينهلُ",105,"ل",1,0],["وفي وقتِ بؤسي وفي وقتِ حزني","وعند احتياجي مضوا في عَجَلْ",106,"ل",1,0],["وفي وفائي لأيامٍ لنا سلفت","وفي ابتهاجي وفي فرحي وإيناسي",107,"س",2,0],["وفي وفاءِ الحلوِ الوفاءُ ابن أيَّ","وبَ مرادٌ كافٍ ومنتجعُ",108,"ع",1,0]]}