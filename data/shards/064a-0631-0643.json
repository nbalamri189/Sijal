{"poems":[[55,"كيف صبحت أبا الغمر بها","https://www.aldiwan.net/poem30693.html","الرمل"],[9,"قالت سمية من مدح","https://www.aldiwan.net/poem21971.html","مجزوء الكامل"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[107,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[54,"قد أغتدي والليل قد تقضى","https://www.aldiwan.net/poem26881.html","الرجز"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[45,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[141,"قد راح نحو العراق مشخلبه","https://www.aldiwan.net/poem68033.html","المنسرح"],[178,"يوم أتى بديمة هطالة","https://www.aldiwan.net/poem46066.html","الرجز"],[286,"من مبلغ نجدا ومن بنجد","https://www.aldiwan.net/poem32810.html","الرجز"],[420,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[436,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[461,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[461,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[532,"يا من رأى جلسا أتى جلسا","https://www.aldiwan.net/poem37361.html","السريع"],[561,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10420","المنسرح"],[901,"ردَّ الخليطُ الجمالَ فانقضبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27408&r=&rc=12",""]],"verses":[["يَركَبُ الراكِبُ إِن جَشَّمَها","دَلَجَ اللَيلِ وَتُسبي المُستَبي",0,"ب",2,0],["يَركُضنَ كُلَّ عَشِيَّةٍ","عَصبَ المُرَيَّشِ وَالمَراجِل",1,"ل",1,0],["يَركَبُ الهَولَ وَحِيداً وَلا","يَصحَبُهُ إِلّا اليَمانِي الأَفَلُّ",2,"ل",1,0],["يُركِضُ النُهى","مَشيُهُ الخَبَب",3,"ب",1,0],["يَركَبونَ الشُهبَ وَالسُحبَ إِلى","رِفعَةِ الذِكرِ وَعَلياءِ الثَناء",4,"ا",2,0],["يركب الرّأيَ غويّاً جَامحاً","ضِلَّةً لِلمرءِ ماذا يركبُ",5,"ب",1,0],["يركبُ اللّيلَ والنّهارَ وَيَطوِي ال","بِيدَ غُبْراً سُهولها والوعُورا",6,"ر",2,0],["يَركُضُ في جَوِّ السَماءِ رَكضاً","بِخافِقينِ يَنقُضانِ نَقضا",7,"ض",2,0],["يركب من راكبه شنعةً","زينت بتتويج وتطويق",8,"ق",1,0],["يَركَبُها بِالخُطمِ وَالرِحالِ","يُؤمِنُها مِن هَذِهِ الأَهوالِ",9,"ل",1,0],["يركب ظهري غير مستغفر","حب به طفلاً على كبره",10,"ر",2,0],["يَركَبُها صاغِراً بِلا قَتَبٍ","وَلا خِطامٍ وَحَولَهُ جَلَبَه",11,"ب",2,0],["يَرْكُضُ سَعْيِ إِنْ قَصَدْتُ فَتْكَةً","وَإِنْ قَصَدْتُ النُّسْكَ فالسَّيْرُ خَبَبْ",12,"ب",1,0],["يَركَعُ في الهامِ فَتَهوي سُجَّداً","مِن كُلِّ مَن لَم يَتلُ آيَ الحَمدِ",13,"د",1,0],["يركبُ في الجدِّ جوادَ المنى","إذ يأمن الرَّاكبُ فيه العثار",14,"ر",1,0],["يركبُ في قِشْرِ عِضَاهٍ جَرَى","وإِن جَرَى مَنْطِقُ عَضَّاهِ",15,"ه",1,0],["يركب الليل قعدةً والليالي","صَهَواتٌ فُرسانهنّ البدورُ",16,"ر",1,0],["يركب في الحاجات أخطارَها","إما خَساً فيها وإما زَكَا",17,"ا",1,0],["يَرْكَبُ جَلْساً وَهْوَ في سَيْرِهِ","مِنْ بَعْدِ هذا قاصِدٌ جَلْسا",18,"س",2,0],["يركّب الأشياء منها على","تصويرها من فاضل أو دني",19,"ن",2,0],["يَركَبُ حَزنَ الطَريقِ أَوَّلُهُم","يَدعو بَني عَمِّهِ وَقَد كُرِبا",20,"ب",2,0],["يَرْكَبُ حَزْنَ الطّرِيقِ أوَّلُهُمْ","يدعو يني عمهِ وقدْ كربا",21,"ب",2,0]]}