{"poems":[[55,"كيف صبحت أبا الغمر بها","https://www.aldiwan.net/poem30693.html","الرمل"],[9,"قالت سمية من مدح","https://www.aldiwan.net/poem21971.html","مجزوء الكامل"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[107,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[54,"قد أغتدي والليل قد تقضى","https://www.aldiwan.net/poem26881.html","الرجز"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[45,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[141,"قد راح نحو العراق مشخلبه","https://www.aldiwan.net/poem68033.html","المنسرح"],[178,"يوم أتى بديمة هطالة","https://www.aldiwan.net/poem46066.html","الرجز"],[287,"من مبلغ نجدا ومن بنجد","https://www.aldiwan.net/poem32810.html","الرجز"],[422,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[438,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[463,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[534,"يا من رأى جلسا أتى جلسا","https://www.aldiwan.net/poem37361.html","السريع"],[563,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16874","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126155","الكامل"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178070","المنسرح"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95561","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53130","المنسرح"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109468","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77201","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93653","الرمل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10420","المنسرح"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3039,"","https://poetry.dctabudhabi.ae/diwan/poem/105382","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112658","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59496","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40160","الكامل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126337","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81242","المجتث"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34745","السريع"],[4883,"طعم حلوى","https://www.poetsgate.com/ViewPoem.aspx?id=48371",""],[5111,"بنْتُ الشَّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212341",""],[5121,"يركض الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33580",""],[5122,"(غني الاوأدم ما تكفل أبمفلسها)","https://www.poetsgate.com/ViewPoem.aspx?id=34736",""],[5163,"ولد اليوم كعبة الاكوان","https://www.poetsgate.com/ViewPoem.aspx?id=33949",""],[5413,"عاد حلما","https://www.poetsgate.com/ViewPoem.aspx?id=208942",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[6299,"إنَّ بالشَّعبِ الذي دونَ سلعٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19694&r=&rc=19",""],[2696,"ردَّ الخليطُ الجمالَ فانقضبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27408&r=&rc=12",""]],"verses":[["يَركَبُ الراكِبُ إِن جَشَّمَها","دَلَجَ اللَيلِ وَتُسبي المُستَبي",0,"ب",2,0],["يَركُضنَ كُلَّ عَشِيَّةٍ","عَصبَ المُرَيَّشِ وَالمَراجِل",1,"ل",1,0],["يَركَبُ الهَولَ وَحِيداً وَلا","يَصحَبُهُ إِلّا اليَمانِي الأَفَلُّ",2,"ل",1,0],["يُركِضُ النُهى","مَشيُهُ الخَبَب",3,"ب",1,0],["يَركَبونَ الشُهبَ وَالسُحبَ إِلى","رِفعَةِ الذِكرِ وَعَلياءِ الثَناء",4,"ا",2,0],["يركب الرّأيَ غويّاً جَامحاً","ضِلَّةً لِلمرءِ ماذا يركبُ",5,"ب",1,0],["يركبُ اللّيلَ والنّهارَ وَيَطوِي ال","بِيدَ غُبْراً سُهولها والوعُورا",6,"ر",2,0],["يَركُضُ في جَوِّ السَماءِ رَكضاً","بِخافِقينِ يَنقُضانِ نَقضا",7,"ض",2,0],["يركب من راكبه شنعةً","زينت بتتويج وتطويق",8,"ق",1,0],["يَركَبُها بِالخُطمِ وَالرِحالِ","يُؤمِنُها مِن هَذِهِ الأَهوالِ",9,"ل",1,0],["يركب ظهري غير مستغفر","حب به طفلاً على كبره",10,"ر",2,0],["يَركَبُها صاغِراً بِلا قَتَبٍ","وَلا خِطامٍ وَحَولَهُ جَلَبَه",11,"ب",2,0],["يَرْكُضُ سَعْيِ إِنْ قَصَدْتُ فَتْكَةً","وَإِنْ قَصَدْتُ النُّسْكَ فالسَّيْرُ خَبَبْ",12,"ب",1,0],["يَركَعُ في الهامِ فَتَهوي سُجَّداً","مِن كُلِّ مَن لَم يَتلُ آيَ الحَمدِ",13,"د",1,0],["يركبُ في الجدِّ جوادَ المنى","إذ يأمن الرَّاكبُ فيه العثار",14,"ر",1,0],["يركبُ في قِشْرِ عِضَاهٍ جَرَى","وإِن جَرَى مَنْطِقُ عَضَّاهِ",15,"ه",1,0],["يركب الليل قعدةً والليالي","صَهَواتٌ فُرسانهنّ البدورُ",16,"ر",1,0],["يركب في الحاجات أخطارَها","إما خَساً فيها وإما زَكَا",17,"ا",1,0],["يَرْكَبُ جَلْساً وَهْوَ في سَيْرِهِ","مِنْ بَعْدِ هذا قاصِدٌ جَلْسا",18,"س",2,0],["يركّب الأشياء منها على","تصويرها من فاضل أو دني",19,"ن",2,0],["يَركَبُ الأُقحُوانَ فيها نَهاراً","فَتَرى دِرهَماً عَلى دينارِ",20,"ر",1,1],["يَرْكَبْن أَعْضادَ عِتاق الأَجْفُنِ","حَتَّى تَرَى عَيْنَ الهِبِلِّ المُذْعِنِ",21,"ن",1,0],["يَرْكَبُ أَجْراف الزُبَى فَيَثْلِمُهْ","فِيكَ بِشَيءٍ عِنْدَ جُودٍ تَخْذِمُهْ",22,"م",2,0],["يركب في كميونه إلى صدد","يقول يا شيخ الكمايين المدد",23,"د",1,0],["يركب في طاعة الهوى خَطَراً","تُضرَمُ من دُونِه الأنابيب",24,"ب",1,0],["يركضون البريد تسعة أميا","ل بنص الوجيف والذملان",25,"ن",1,0],["يركب الصعب للوفا لا يُبالى","إن رماه القضا بسقم وبيلَ",26,"ل",1,0],["يركز في الدارعين ذُبَّلَه","كأنهنَّ الأَشْطَان والغُدر",27,"ر",1,0],["يُركب السجع فيبدي طربا","تركيب مزجٍ نحو معدي كربا",28,"ب",2,0],["يَركَعُ البَغيُ لاثِماً قَدَمَيهِ","وَتُنَجِي الصدورَ مِنهُ الظهورُ",29,"ر",1,0],["يَركَع الغُصن عَلى معطفه","ان رَأى في ذَلِكَ الحَي اِنعِطافه",30,"ف",2,0],["يَركَبُ حَزنَ الطَريقِ أَوَّلُهُم","يَدعو بَني عَمِّهِ وَقَد كُرِبا",31,"ب",2,0],["يركب الصعب إلى أمثاله","لا إلى الراحة إلا حين أودى",32,"د",2,0],["يرّكب حدّه جمل المنايا","عليه يدور معناها اعتوارا",33,"ر",2,0],["يركضن عدوا نحو حومة الوغى","والشمر سيف بغيه قد أولغا",34,"غ",2,0],["يَركُلُها كلّ حاسرٍ دَمُهُ","عليه تحت الغبارِ أطمارُ",35,"ر",1,0],["يركب الشرطي الأقتراني","من القضيتين في البرهان",36,"ن",1,0],["يركضنَ سِرْباً للوغى","كقَطا ندى قرفين ناهلْ",37,"ل",1,0],["يَركُزنَ في حَلَبٍ وَمِن أَفنانِها","تَجني فَواكِهَ أَمنِها بَغدادُ",38,"د",1,0],["يركبهُ الجاهل من حلمهِ","والممتطي صنوٌ لذي المحزم",39,"م",1,0],["يُركِّبُ أقطاباً بمجور إبرةٍ","يُدَوِّرُها إن شاءَ في رجل نملةِ",40,"ه",1,0],["يَركُض بَينَ الدُموع","أَهوج داني الخَطَر",41,"ر",1,0],["يَركَبُ هذا ذا وَذا ذا فَما","يَنفَكُّ تَصعيداً وَتَصويبا",42,"ب",2,0],["يركض العيد، يتذوق لسان","طعم حلوى، والاطفال الزهر",43,"ر",1,0],["يركعُ الحَرْفُ أمَامِيْ","فِيْ مَعَاريْجَ ابْتِهَالِيْ",44,"ل",2,0],["يَرْكُضُ الْحَرْفُ وَالْمَشَاعِرُ هَشَّة","فَتُعَانِي إِذَا كَبَا مَنْ أَشَّهْ",45,"ه",1,1],["يركز على فكره وجهده وتكريسه","تخير من أثياب الحقيقه ويلبسها",46,"س",3,0],["يركب الخوف رَامِقاً ورَمُوقَه","عندما يسمعان سحر بياني",47,"ن",2,0],["يركب الليلَ لفجر نائمٍ","يطردُ الليلَ بصبح العزة",48,"ه",1,0],["يركض الإنسان والموعد الشوط الاخير","مادرى كم يوم قدمه وكم يومٍ وراه",49,"ا",2,0],["يركبون من الوسائل للتواصل مترفين","فإجتماعات السوالف شوف (كم اعرف بنيّه)..!!",50,"ي",2,0],["يركَبُ الهَوْلَ وَحِيدا ، ولا يَص","يصحبهُ إلا اليمانيُّ الأفلُّ",51,"ل",1,0],["يَرْكَبُ حَزْنَ الطّرِيقِ أوَّلُهُمْ","يدعو يني عمهِ وقدْ كربا",52,"ب",2,0]]}