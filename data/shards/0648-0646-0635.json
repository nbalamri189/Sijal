ر منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[235,"ما للأحبة أسياف الجفا اخترطوا","https://www.aldiwan.net/poem18841.html","البسيط"],[250,"مولاي سعد الدين دعوة آمل","https://www.aldiwan.net/poem1454.html",""],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[347,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[359,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[362,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[364,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[369,"جمرات الهوى بمثلك تصلى","https://www.aldiwan.net/poem57227.html","الطويل"],[374,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[383,"ألا تلك العمود تصد عنا","https://www.aldiwan.net/poem1830.html","الوافر"],[388,"يا من له الحول والقوه","https://www.aldiwan.net/poem54466.html","عموديه"],[388,"من أراد لهم والغم الكبير","https://www.aldiwan.net/poem54561.html","عموديه"],[399,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[399,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[400,"بدأ الدين غريبا مثلما","https://www.aldiwan.net/poem33448.html","الرمل"],[400,"يا فاضلا وافى إلينا شعره","https://www.aldiwan.net/poem33763.html","الرجز"],[407,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[426,"سل الخطي والبيض الصقالا","https://www.aldiwan.net/poem40268.html","الوافر"],[434,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[436,"بسعدك لا بسعد أو سعاد","https://www.aldiwan.net/poem34782.html","الوافر"],[436,"زمان جديد وصنع جديد","https://www.aldiwan.net/poem34911.html","المتقارب"],[450,"لقد بشرتنا باقتبال وجدة","https://www.aldiwan.net/poem13691.html","الطويل"],[451,"ماذا أصابك أيها البستاني","https://www.aldiwan.net/poem61801.html","الكامل"],[456,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[456,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[459,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[462,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[466,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[507,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[512,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[513,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[513,"بهرت مناقب مجدك الأوهاما","https://www.aldiwan.net/poem12271.html","الكامل"],[527,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[541,"ليس يغني القول إلا لامرئ","https://www.aldiwan.net/poem1759.html","الرمل"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[549,"وللغصن يرمى كل يوم بشاذب","https://www.aldiwan.net/poem48066.html","الطويل"],[556,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["ونَصا الشّبابَ وعنْ ضَميرٍ عاتِبٍ","أعْطى المَشيبَ قِيادَهُ لا عنْ رِضى",0,"ض",2,0],["ونَصَلْتُ منْ أعْجازِهِ في غِلْمَةٍ","تَشْفي الغَليلَ بهِمْ صُدورُ سُيوفي",1,"ف",2,0],["وَنَصيبي مِنَ الحَبيبِ بِعادٌ","وَلِغَيري الدُنُوُّ مِنهُ نَصيبُ",2,"ب",1,0],["وَنُصحي لَهُم أَن يَهرُبوا مِن عِقابِهِ","إِلَيهِ فَإِنَّ النُصحَ في الدينِ واجِبُ",3,"ب",1,0],["وَنُصْفِيَهَا مُوَدَّتنَا","وَخَيْرُ الرْاحِ صافِيهَا",4,"ي",3,0],["وَنَصَبتَني عَلَماً عَلى غَرَضٍ","تَرمينِيَ الأَعداءُ بِالحَدَقِ",5,"ق",1,0],["وَنَصَّ حِرباؤُها فيها ذَوائِبَهُ","في صامِحٍ مِن لُعابِ الشَمسِ مَسجورِ",6,"ر",1,0],["ونصر هذا البريّا","ومن النيل يكون ينصره لولاك",7,"ك",1,0],["ونصر على الأعدا يبادرُ رُعبه","فيسبق مجرى الخيل بالعسكر المجرِ",8,"ر",1,0],["ونصبت للتبريح أحشائي التي","فيها من الأشواق فعلٌ مضمر",9,"ر",1,0],["ونَصيحٍ يلومُني في هواها","ضَلَّ عنه التوفيقُ والتسديدُ",10,"د",1,0],["ونَصْرُك باسِطُ النُّعمى علينا","نهايةُ ما نُؤَمِّلُهُ لديكا",11,"ك",2,0],["وَنَصراً وَلَولا رَغبَةٌ عَن مُحارِبٍ","لَأَشبَعَ قَتلاها الضِباعَ العَوافِيا",12,"ي",2,0],["وَنَصِّيَ العيسَ تَهديهِم وَقَد سَدِرَت","كُلُّ جُماليَّةٍ كَالفَحلِ هِملاجِ",13,"ج",1,0],["ونصحت اهل الرافدين","على التحالف ان يقروا",14,"ر",3,0],["ونصرتها نصر المجاهد في ذَرا","عبدالحميد وفي جناح رشاد",15,"د",1,0],["وَنَصبرُ لِلشَدائِدِ في مَقامٍ","وَيَغلِبُنا عَلى صَبرٍ مَقامُ",16,"م",1,0],["وَنَصونُهُ وَنُجِلُّهُ","بَينَ الشَماتَةِ وَالنَكير",17,"ر",1,0],["وَنَصِلَ النازِلَ في سِلمِهِ","وَنَقطَعَ الداخِلَ في حَربِهِ",18,"ب",2,0],["وَنَصرِفَ النيلَ إِلى رَأيِهِ","يَقسِمُهُ بِالعَدلِ في شِربِهِ",18,"ب",2,0],["وَنَصَبنَني غَرَضَ الرُماةِ تُصيبُني","مِحَنٌ أَحَدُّ مِنَ السُيوفِ مَضارِبا",19,"ب",2,0],["وَنُصفي الَّذي يُكنى أَبا الحَسَنِ الهَوى","وَنُرضي الَّذي يُسمى الإِلَهَ وَلا يُكنى",20,"ن",2,0],["وَنَصيحَةُ السُلطانِ مَوقِعُ طَرفِهِ","وَنَجِيُّ فِكرَتِهِ وَحُلمُ هُجودِهِ",21,"د",2,0],["وَنُصحٌ لَم تَجِدهُ عَبدُ شَمسٍ","لَدى الحَجّاجِ قَبلُ وَلا زِيادِ",22,"د",1,0],["وَنَصَبَتْ نفسَك للنبيِّ وآلِه","حتى شَفَيْتَهُمُ من الطُّلاُّبِ",23,"ب",1,0],["وَنِصفُ العُقولَ فَإِجزاؤُهُنَّ","بِنِصفِ الشَهادَةِ في الشاهِدينا",24,"ن",2,0],["وَنِصفُ النِصفِ يَذهَبُ لَيسَ يَدري","لِغَفلَتِهِ يَميناً مِن شِمالِ",25,"ل",1,0],["وَنَصيحَتي لَكَ مَحضَةٌ","وَمَوَدَّتي لَكَ صافِيَه",26,"ي",2,0],["وَنَصرانِيَّةٍ بِتنا جِواراً","لَها فَلَنا بِساحَتِها جُنوحُ",27,"ح",1,1],["وَنُصِرتَ بِالرُعبِ الشَديدِ عَلى العِدى","وَلَكَ المَلائِكُ في الوَغى أَعوانُ",28,"ن",1,0],["وَنَصَرتَهُ بِكَتائِبٍ صَيَّرتَها","نَصباً لِعَوراتِ العَدُوِّ بِمَرصَدِ",29,"د",1,0],["وَنَصُّ المَطايا في رِضاكِ وَحَبسُها","لَكَ اليَومَ مَبذولٌ وَلَكِن تَجَمَّلِ",30,"ل",1,0],["وَنَصّى إِلَيكِ العَيسَ شاكِيَةَ الوَجى","مَناسِمُها مِمّا تُلاقي رَواعِفُ",31,"ف",1,0],["وَنَصَبَ الناسُ لَهُ القِبابا","وَشَكَروا المُهَيمِنَ الوَهّابا",32,"ب",2,0],["وَنَصَبوهُ قائِماً يَدعو لَهُم","فَحَقَّقَ الرَحمَنُ فيهِ سُؤلَهُم",32,"م",1,0],["وَنُصلِحُ ما أَبقى لَنا مِنهُ جودُنا","لِنَجرِيَ ما عِشنا عَلى عادَةِ الفَضلِ",33,"ل",1,0],["وَنَصِيبُكِ الأوْفَى مِنَ الذِّكْرِ الذي","منه العَبيرُ لِسَامِعِيهِ يَفوحُ",34,"ح",1,0],["ونَصِيحَةٍ أَعرَبتُ عنها فانثَنَت","كالصُّبْحِ يَجْلُو ضَوْءُهُ التَّغْلِيسا",35,"س",2,0],["ونصرك للحقّ الذي أنت أهله","وعونك للملهوف وهو رهيق",36,"ق",1,0],["ونَصَرْتَ بالجيش اللُّهام وإنّما","أعْدَدْتَهُ قبل الفُتوح فتوحا",37,"ح",2,0],["وَنُصبَ عَينَيَ طَودٌ","فَكَيفَ لي بِصُعودِه",38,"د",2,0],["وَنَصيحٍ قالَ لا تَع","جَل بِهُلكِ النَفسِ خُرقا",39,"ق",2,0],["وَنَصيحَينِ أَلَمّا باكِراً","بِطَبيبٍ وَطَبيبي المُجتَنَب",40,"ب",1,0],["وَنُصّا إِلى اللَهِ مَغزاكُما","فَذَلِكَ أَفضَلُ ما تَغزُوانِ",41,"ن",1,0],["وَنُصَّ الحَديثَ إِلى أَهلِهِ","فَإِنَّ الوَثيقَةَ في نَصِّهِ",42,"ص",2,0],["وَنَصُدُّ الأَعداءَ عَنّا بِضَربٍ","ذي خِذامٍ وَطَعنِنا بِالحِرابِ",43,"ب",1,0],["ونُصر الإمامُ فيها المُصطفى","وقد شَفى من العدوِّ واشتَفى",44,"ف",2,0],["ونِصْفُهُ الثّلْثَانِ مِن آلَةٍ","لِجِنْسِهِ في الضّرْبِ منسوبَهْ",45,"ب",2,0],["ونِصْفُهُ الآخَرُ نِصْفُ اسمِ مَنْ","جانَسَهُ يَتْبَعُ أُسلوَبهْ",45,"ب",2,0],["وَنَصيب الضعيف أن يتلقَّى","حتفَه في غمار هذا الجهاد",46,"د",1,0],["ونصَّ المعانيَ عن جانبيكِ","فمنها السُّرَى وإليكِ العروجْ",47,"ج",1,0],["ونصبهم للحكم كل غاشم","جرت يداه في دماء هاشم",48,"م",1,0],["وَنَصِيرِهَا المِقْدَامِ فِي الجُلَّى","وَقَدْ عَزَّ المُنَاصِرْ",49,"ر",1,0],["وَنَصِيرَةٍ لأُولِي الحُقُوقِ تَصُونُهَا","مِمَّنْ يَصُولُ عَلَى الحُقُوقِ وَيَعْتَدِي",50,"د",2,0],["ونصراً وهدياً إن طغى السيلُ جارفاً","وفاضَ بما يحوي الإناء إنَاءُ",51,"ا",2,0],["ونصف (كانون) زارت بنت جارته","فأفشت الخبر الأبواب والشرف",52,"ف",1,0],["ونصيحين ألما باكرً","بطبيبٍ وطبيبي المجتنب",53,"ب",1,0],["ونَصِّبْ مِنْ جبينكَ فاللَّيالي","تُحاولُ ان تُخَوِّفَ مَنْ يُخيف",54,"ف",1,0],["ونَصَّبْنا مرَوِّضةً غِلاظاً","على ما في الطبائِعِ منْ جِماح",55,"ح",1,0],["وَنَصِيحَةُ السّلطانِ مَوْقعُ طَرْفِهِ،","وَنحيُّ فِكرَتِهِ، وَحُلمُ هُجودِهِ",56,"د",2,0],["ونصّيَ العيسَ تهديدهمْ وقدْ سدرتْ","كُلُّ جُمَالِيَّة ٍ كالفَحْلِ هِمْلاَجِ",57,"ج",1,0],["ونصوص حكم هواك ما برحت","مطروحة بدوائر الإجرا",58,"ر",2,0],["وَنَصَّت فَأَبدَت جِيدَ أُمِّ جِدايَةٍ","فَقُلتُ مَهَاةٌ هِى أم أُمُّ طَلاً هِيَا",59,"ي",2,0],["ونَصرِ النَّمُومِ وطَيشِ الحُلُومِ","وجَهلِ العُلُومِ وعِلمِ الجَفَا",60,"ف",2,0],["وَنِصفَ النَهارِ عِراكُ الجَوارِ","وَحَلُّ الإِزارِ إِذا تَنبَهِر",61,"ر",1,0],["وَنَصَحتَ مُلكَ بَني عَلِيٍّ نُصحَ مَن","أَربى عَلى إِعلانِهِ إِسرارُهُ",62,"ر",2,0],["وَنَصِيَّةِ البَيتِ الَّذي طالَ السُهى","وَعَلا الثُرَيّا صاعِداً بُنيانُهُ",63,"ن",2,0],["ونصرتَ بالرعب الذي امتلات به","من خوفِ سطوة بأسك الأَقطارُ",64,"ر",1,0],["وَنَصَّت عَنِ الغَصنِ الرَطيبِ سَوالِفاً","يَشُبُّ سَناها لَونَ أَحوى جَثاجِثِ",65,"ث",1,0],["وَنَصّ القِلاص القُودِ تَخدي كَأَنَّها","نَعامٌ بِأَعلى قُلَّةِ الدَوِّ جافِلُ",66,"ل",1,0],["وَنَصدُرُ عَن رِىِّ العَفافِ ورُبَّما","نَقَعنا غَلِيلَ الحُبِّ بِالرَّشَفَانِ",67,"ن",1,0],["ونصّف ثم ضاعف ثم أفضى","به التعديل والضرب الوكيد",68,"د",1,0],["ونصيبُ المرءِ مما","قدَّرَ اللهُ يُصيبهْ",69,"ب",2,0],["ونصرة واجتماع في طريقك قد","تولدا ولهذا الشكل توليد",70,"د",1,0],["ونصرته وقع السيوف على العدا","وللضرب في الاسماع منها مواقع",71,"ع",1,0],["ونصرت دين المصطفى","خير البرية أجمعين",72,"ن",1,0],["ونصحت إذا بلغت نصحاً شافياً","ما فيه لا وهن ولا تعجيز",73,"ز",1,0],["وَنَصَرتَ دينَ اللَهِ نَصرَ مُؤَيَّدِ ال","آراءِ في نَقضٍ وَفي إِبرامِ",74,"م",1,0],["وَنُصْرَةُ الدِّينِ وَالأَعْلاَمُ طَامِسَةٌ","مِنْهُ وَأَمْرُ الْجَوَى مِنْ أَمْرِهِ فُرُطُ",75,"ط",1,0],["وَنَصَرتَ نورَ الدينِ حينَ نَصحتَ بالرَ","أيِ الأَصيلِ وَبالحُسامِ المُفضلِ",76,"ل",1,0],["ونُصولُهُ لمّاعةٌ كبوارقٍ","وخُيوله صهّالةٌ كرواعد",77,"د",1,0],["وَنُصِبَ الميزانُ بِال","قِسطِ وَقامَتِ النُذُر",78,"ر",1,0],["وَنَصيب حُبّي مِنكَ لذة ناظِري","لكن أَقول تَبارَكَ الخَلّاق",79,"ق",1,0],["وَنُصِبَت مَنابِرُ الأَشجارِ","وَخَطَبَت سَواجِعُ الأَطيارِ",80,"ر",1,0],["ونَصيحُ سُلطانٍ يُهذِّبُ مُلكه","من كُلِّ ماأهدَىمَقالُ مؤنِّب",81,"ب",1,0],["وَنُصغي لَها بِالقَلبِ أُذناً سَميعَةً","يَبيتُ لَها فَختُ السِماكِ مُناجِيا",82,"ي",2,0],["ونَصوحٍ مازالَ يُعجِمُ عَنِّي","لفظَ نُصحٍ حتَّى تفسَّرَ عَذلا",83,"ل",2,0],["وَنَصبتُ أَحشائي على بُعدِ المدى","غَرَضاً فكُنتُ لِمَصرَعي إيماءَ",84,"ا",2,0],["وَنَصبُ الحَيِّ قَد عَطَّلتُموهُ","وَنَقرٌ بِالأَثامِجِ وَالوُكوسِ",85,"س",1,0],["ونصرة الشرع والمظلوم","والجبر والغوث للهفان",86,"ن",1,0],["ونصيح ومشير ونذير","لا تخالطهم فهم بئس العشير",87,"ر",1,0],["ونصيحِ غير مُتّهَمٍ","قد أطال العذْل فيك بلا",88,"ل",2,0],["ونصَّ عليه بالإمامة دونهم","ولو لم يكن نصَّاً لقدَّمه الفضلُ",89,"ل",1,0],["ونصلي فيه خمساً جمعاً","واحد ما فيه تفريق لما",90,"م",2,0],["ونصفه في سور في عشره","ثنتان مع خمس فهذا كسره",91,"ر",2,0],["وَنَصَبتَ نَفسَكَ خَيرَ نَفسٍ دونَها","وَجَعَلتَ مالَكَ واقِياً أَموالَها",92,"ل",3,0],["ونصر اللَه صاحبها يميناً","وآي العز قارنها شمالا",93,"ل",2,0],["ونصر نفيس الدين موفيك ودّه","وموليك محض النصح في السر والجهر",94,"ر",1,0],["ونُصْحُكَ فِي الديانَة ليْسَ يَخْفى","وَمَا تَسْعى إلى غيرِ المَعادِ",95,"د",1,0],["وَنَصْرٌ كَمَا تَتَمَنَّى الأَمَانِي","وَمَوْلَىً كَمَا يتمنّى العبيدُ",96,"د",1,0],["ونُصغي لتَرنام اليراع مُوَقعاً","على شدوات الطير والطلُّ راشح",97,"ح",1,0],["ونصيخ للعذب الحديث كأنه","تفسيرُ أحكامٍ من القرآن",98,"ن",1,0],["ونُصرةٍ من مُخوِلٍ","في مجده مُعِمِّ",99,"م",1,0],["ونصرتَ فيَّ الحقَّ غيرَ مراقَب","وحكمتَ بالإنصاف غيرَ محكَّمِ",100,"م",1,0],["ونَصَحَتْه نفسُه لنفسِهِ","فشاورَ الحزمَ وأحسنَ النظرْ",101,"ر",1,0],["ونص حديث بالغدير دلالة","على نفي أضراب وبعد مساجل",102,"ل",1,0],["ونصيحٍ أوسعتهُ فيكِ سخطاً","يهزلُ الصبرُ كلَّما جدَّ عذلا",103,"ل",2,0],["ونصلها رماحاً من شموعٍ","لوامعَ تحتَ راياتِ الدياجي",104,"ج",2,0],["وَنِصفُ جَدى بارِدٍ أُمُّهُ","كَما حَكى الجَلّابُ حَوفِيَّه",105,"ي",2,0],["ونصْرٍ دون أسلابٍ وسلْمٍ","بلا أرضٍ وقدسٍ في الخسائرْ",106,"ر",1,0],["وَنَصَبنا لِقَيسِ عَيلانَ حَتّى","ما أَرَدنا قَبائِلاً وَخُيولا",107,"ل",2,0],["ونصرٌ لا يزالُ الدهرُ منه","عليكَ يزُفُّ ألويةَ الجَلالِ",108,"ل",1,0],["ونصالٍ تدُبُّ فيها نِمالٌ","ترهَبُ الأُسْدُ خشيةً من لَقاها",109,"ا",3,0],["ونصول في قنا ظامية","ريها ماء غدير الزرد",110,"د",1,0],["ونصري له في حيث لا أنت ناصر","بضرب صقيلات ولا طعن شرع",111,"ع",1,0],["ونصرت دين الله بالعزم الذي","أمن الهدى من بعده أن يخذلا",112,"ل",2,0],["ونصرت ألوية الهدى بوقائع","أصبحت فيها يا حسام حساما",113,"م",2,0],["ونَصْرُكَ مَوْجودٌ عَلَى كُلِّ حالَة","لَقَدْ عَزَّ مَنْ خَيْرُ الخَلائِقِ عاضِدُهْ",114,"د",2,0],["وَنَصَبنا في خَزازى رُمحه","وَطَرَدنا العُصمَ عِن كُلِّ أَنيقِ",115,"ق",1,0],["ونُصحُكمُ فرضٌ فدونك قولةً","حططتُ لها حتّى أقولَ لِثامي",116,"ي",1,0],["وَنَصبو إِلى وِرْدِ الحياةِ وصرفُها","يذودُ بنا عنها ذِيادَ الغرائبِ",117,"ب",1,0],["ونصول في أهل النفوس بربنا","إن حاولوا الشرف الرفيع تحرشا",118,"ش",2,0],["ونصبا وإن رأيتموني","زللت في أمر فقوموني",119,"ي",1,0],["ونَصَّبوا إِنْسَانَها","يُحنِّنُ الأَحَامِس",120,"س",1,0]]}