"https://www.aldiwan.net/poem34106.html","الطويل"],[409,"أسفي على عصر الشباب تصرمت","https://www.aldiwan.net/poem31640.html","عموديه"],[409,"لما بلغت من الحياة إلى مدى","https://www.aldiwan.net/poem31711.html","عموديه"],[416,"أبا جميل قر عينا بمن","https://www.aldiwan.net/poem53939.html","السريع"],[429,"لما بدا بدر الجمال بعجبه","https://www.aldiwan.net/poem41050.html","الكامل"],[432,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[441,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[448,"إن كان غير أهيل نجد","https://www.aldiwan.net/poem53764.html","مجزوء الكامل"],[452,"عهدي بأيامي على النيربين","https://www.aldiwan.net/poem13897.html","السريع"],[452,"لما بدا بردى تجود فروعه","https://www.aldiwan.net/poem13973.html","الكامل"],[458,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[458,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[461,"إذا كنت مضعوفا بأدنى فراقكم","https://www.aldiwan.net/poem16126.html","الطويل"],[464,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[464,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[479,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[482,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[493,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[495,"لما بعثت بلحظي في خد جلنار نارا","https://www.aldiwan.net/poem9858.html","مجزوء الخفيف"],[500,"أي عين رأت حبيبي ونامت","https://www.aldiwan.net/poem38057.html","الخفيف"],[515,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[515,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[515,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[551,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[553,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[558,"إن المحب إذا اختفت أسراره","https://www.aldiwan.net/poem34377.html","الكامل"],[559,"إذا بريق الحمى استنارا","https://www.aldiwan.net/poem69359.html","مخلع البسيط"],[564,"في فؤادي من الغرام لهيب","https://www.aldiwan.net/poem885.html",""],[567,"الآن أشبه خده","https://www.aldiwan.net/poem69466.html","مجزوء الرجز"],[575,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[586,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[586,"أفدى عربا حلوا بوادي الجزع","https://www.aldiwan.net/poem17594.html","الدوبيت"],[586,"أفدي التي برزت كالشمس في الأفق","https://www.aldiwan.net/poem18005.html","البسيط"]],"verses":[["لَمّا بَدَت فَرَأَيتُها في صُفرَةٍ","كَلِفَ الفُؤادُ بِكُلِّ شَيءٍ أَصفَرِ",0,"ر",1,1],["لَمّا بَلَوتُ أَخِلاّئي وَجَدتُهُمُ","كَالدَهرِ في الغَدرِ لَم يُبقوا عَلى أَحَدِ",1,"د",1,0],["لَمَا بَلَغَ النُّعْمَى عَلَيْكَ سُرُورُهُ","أَلِيَّةَ وَافٍ لاَ ألِيَّةَ خَوَّانِ",2,"ن",1,0],["لمّا بعَثْتُ بِها تورّدَ خدُّها","واحْمَرّ منْ خَجَلٍ لديْكَ عَراها",3,"ا",3,0],["لَمَّا بَرَزْتَ إلَى المُصَلَّى مَاشِياً","وَدَّتْ خَدُودٌ أَنَّهَا حَصْبَاءُ",4,"ا",2,0],["لَمّا بَدا الصَدغُ مُسوَدّاً بِأَحمَرِهِ","أَرى التَسالُمَ بَينَ الرومِ وَالحَبَشِ",5,"ش",1,0],["لَمَّا بَدَا أَنْشَدَ الإِقْبَالُ فِي جَذَلٍ","تَاريخ بُولَسَ سَامٍ غُرَّةِ الزَّمَنِ",6,"ن",1,0],["لَمْ أَبْغِ حثّاً إِخْوَانِي بِهَا وَهُمُ","أَهْلُ النَّدَى بَلْ كَمِشْكَاةِ لإِخْوَانِي",7,"ي",1,0],["لَمْ أَبْغِ مِنْ ذِكْرِهَا أَنْ تَيْأَسُوا جَزَعاً","خَيْرٌ مِنَ اليَّأْسِ أَن يُسْتَقْدَمَ العَدَمْ",8,"م",1,0],["لَمّا بَلَغتُ إِمامَ العَدلِ قُلتُ لَهُم","قَد كانَ مِن طولِ إِدلاجي وَتَهجيري",9,"ر",2,0],["لَمّا بَنى الخَطفى رَضيتُ بِما بَنى","وَأَبو الفَرَزدَقِ نافِخُ الأَكيارِ",10,"ر",1,0],["لَم أبِع دِينيَ المُسَاوِمَ بِالوَك","سِ وَلاَ مُغلِيَاً مِنَ السُّوَّامِ",11,"م",1,0],["لَم أَبُح بِالوَداعِ جَهراً وَلَكِن","كانَ جَفني فَمي وَدَمعي كَلامي",12,"ي",1,0],["لَمّا بدا البَدءُ أَبدى عِشقُهُ صِفَةً","فيما بَدا فَتَلَالاَ فيهِ لَألاءُ",13,"ا",2,0],["لما بدا لك أنَّ خِزْيك قد غدا","أحدوثة الرُّكبان والأَملاءِ",14,"ا",2,0],["لم أبتدع في ثنائك الحسن ال","منشَر بل كنتُ بعض من نَشره",15,"ر",2,0],["لمَا بدا لي بشيرُ غُرَّته","وراع دهري نذيرُ إنباضه",16,"ض",2,0],["لم أبتدعْ بدعةً بمدحكُمُ","قد قَرَّضَ الناسُ قبلِيَ الأدَمَا",17,"م",2,0],["لَم أُبصِر ذاتي بِالأَمسِ","في لَوحِ زُجاجٍ أَو ماءِ",18,"ا",2,0],["لما بدا لي ان قلبك ملني","وعلمت ان هناك ما لا اعلم",19,"م",1,1],["لما بلغت مداها","وأصبحت بك تغلو",20,"ل",2,0],["لما بلغت السؤل ليلة مدحه","بعث الملوك يعظمون جنابي",21,"ي",1,0],["لما بدت منك السعود تمزقت","تلك القيود وأُطلق السجناء",22,"ا",2,0],["لما بدا الشهر واستقبلت غرّته","لاح الهلال ولاح البدر في آن",23,"ن",1,0],["لَمّا بَنَيتَ الأَيكَ وَاِستَوهَبتَهُ","بَعثَ الهَزارَ وَأَرسَلَ الوَرقاءَ",24,"ا",2,0],["لَمّا بَلَغنا بِالأَحِبَّةِ وَالمُنى","بابَ السُرورِ تَغَيَّبَ المِفتاحُ",25,"ح",1,0],["لَمّا بَنى اللَهُ القَضِيَّةَ مِنهُمُ","قامَت عَلى الحَقِّ المُبينِ عَمودا",26,"د",2,0],["لمّا بَدا وجدي وكان مُكتَّماً","أَبْدَيْنَ وَجْداً كان فيَّ مُكَتَّما",27,"م",2,0],["لَمَّا بدَتْ راياتُ صُبْحٍ مُقْبلٍ","يَخفُقْنَ في أعجازِ ليلٍ مُدبرِ",28,"ر",1,0],["لَم أُبقِ غَيرَ جَماجِمٍ عَرِيَت","بيضٍ تَلوحُ وَأَعظُمٍ نَخِرَه",29,"ر",2,0],["لَم أُبادِركَ بِالوَداعِ لِأَنّي","واثِقٌ بِاِجتِماعِنا عَن قَريبِ",30,"ب",1,1],["لَم أَبكِ بِالحُزنِ الطَويلِ تَمَلُّقاً","حُزني عَليكَ وَقائِعٌ وَحُروبُ",31,"ب",1,0],["لَمّا بَدَت لِلأَرضِ مِن قَريبِ","تَشَوَّفَت لِوَبلِها السَكوبِ",32,"ب",1,0],["لَمّا بَدا لي مِن صَميمِكَ ما بَدا","بَل لَم يُصَب لَكَ لا أُصيبَ صَميمُ",33,"م",1,0],["لَمّا بَلَغنا ساحَةَ الحَسَنِ اِنقَضى","عَنّا تَعَجرُفُ دَولَةِ الإِمحالِ",34,"ل",1,0],["لَم أُبقِ حَلبَةَ مَنطِقٍ إِلّا وَقَد","سَبَقَت سَوابِقَها إِلَيكَ جِيادي",35,"ي",1,0],["لمَّا بَدَتْ غيداءُ في حلَّةٍ","سوداءَ مثلَ الشمسِ تحت السحابْ",36,"ب",1,1],["لما بكى فقدَ الهمومِ سحابُها","ضحكتْ وقدْ عاشَ السرورَ زهورُها",37,"ر",3,0],["لم أبِعهُ لشقيقٍ","أو صديقٍ لي حميمِ",38,"م",1,0],["لَما بَلَغتُ إِزاءَ البابِ مُكتَتِماً","وَطالِبُ الحاج تَحتَ اللَيلِ مُكتَتِمُ",39,"م",1,0],["لَمّا بَدا لِيَ مِنكُم غَيبُ أَنفُسِكُم","وَلَم يَكُن لِجِراحي مِنكُمُ آسي",40,"ي",1,0],["لَم أَبكِ في مَجلِسِ مَنصورِ","شَوقاً إِلى الجَنَّةِ وَالحورِ",41,"ر",1,1],["لَم أَبِت غافِلاً فَأَشراني الحِر","صُ إِلى أَن أَعودَ كَالأَشرانِ",42,"ن",1,0],["لما بدا للأرض مُستبهِجاً","كادَت له عيدانُها تُورِقُ",43,"ق",1,0],["لمّا بَدا كِبَرٌ تَكا","دُ يَدايَ مِنهُ تَرعشانِ",44,"ن",1,1],["لما بدا قدَّست من","خَلقَ الخلائق من عدم",45,"م",1,0],["لما برمت به فارقته جذلا","وكف دمعي عن سح وتهتان",46,"ن",1,0],["لم أبكِ أن رحلَ الشبابُ وإنما","أبكى لأنْ يتقاربْ الميعادُ",47,"د",1,1],["لمّا بَدا الكفُّ الخَضيبُ رأيتَني","جَذْلانَ للعَنمِ الخَصيبِ مُرافِقا",48,"ق",2,0],["لَما بَلَغوا في قُبحها عُشر وَصفها","وَما بَلغوا مِن حسنِ أوصافك العشرا",49,"ر",2,0],["لما بدا في دجى الظلماء أوهمني","أن الصباح بدا أو ضوء مصباحِ",50,"ح",1,0],["لم أبك يوماً على نفسي بكيت لكم","عنكم بشعر كمثل الدر منضود",51,"د",1,0],["لما بدا لي الحبيب","يشبه لبدر التمام",52,"م",1,0],["لمّا بَلغتُ أشُدِّي بعدما انْقَرَضَتْ","بعد الثّلاثين خَمْسٌ مِن زمانِيَ لي",53,"ل",2,0],["لَمّا بَنى اللَهُ السَماواتِ العُلى","سَبعاً تَعالى اللَهُ أَكرَم باني",54,"ن",2,0],["لمَّا بَكَيْتُ بَكَى يُسَاعِدُنِي الحَيَا","فَدُمُوعُهُ مِنْ رِقَّةٍ لِيَ تَهْمَعُ",55,"ع",1,0],["لمَّا بَكَتْ مِنْ غَيْرِ دَمْعٍ جَرَى","أَعَارَها أدْمُعَهُ المُزْنُ",56,"ن",1,1],["لَمَّا بَنَوْا شُرُفاتِهِ مِنْ فِضَّة","جَعَلُوا أَدِيمَ قِبابِهِ عِقْيانا",57,"ن",2,0],["لم أَبُحْ بالهوى الخف","يّ اختياراً فأُهْجَرا",58,"ر",2,0],["لَمّا بَدا لي ثَغرُهُ باسِماً","أَيقَنتُ بِالخَيرِ فَلاحَ الفَلاح",59,"ح",1,0],["لَمّا بَعَثتُ بِداعي الشَوقِ وَالدَلهِ","إِلى زِيارَةِ مَن فيها نَما وَلَهي",60,"ي",1,1],["لَم أَبكِ مِن خُبثِ خِلٍّ","إِلّا بَكَيتُ عَلَيهِ",61,"ي",2,1],["لمّا بدا والشّوقُ يُدْني مَن نأى","مِن وجههِ والعزُّ يُنْئي مَن دنا",62,"ن",2,0],["لمّا بَرزْتَ تَضعْضعَتْ أركانُها","فالخَيلُ زُورٌ والفوارسُ مِيل",63,"ل",1,0],["لمّا بكَوا لا بكَوا والرَّكْبُ مُرتحلٌ","من لَوعةٍ ضحكَ الواشونَ لا ضَحِكوا",64,"ك",3,0],["لما بَدا الشَّعر عَلى خَدِّه","وكنتُ قد أفلَتُّ بَعد الوقُوع",65,"ع",1,1],["لما بدا ورأى انهمالَ مدامعي","ولَّى يثلِّثُ وانثنيتُ أوحِّدُ",66,"د",1,0],["لما بدا الموت فاهتزت فرائصُنا","منه وكان اسمه عندي أبا الفتن",67,"ن",1,0],["لمّا بنعمته كساها فاكتسَى","منها بجسمٍ كاملٍ يُستَعظم",68,"م",1,0],["لَما بَليت بِهُم بَلَوت خِلالَهُم","دَهراً فَحير لُؤمَهُم آرائي",69,"ا",2,0],["لَما بَدا العارِضُ في الخَدِّ","زادَ الَّذي أَلقى من الوجدِ",70,"د",1,1],["لمّا بدا لي وَجْهُهُ مُشْبِهاً","وجهَ حبيبي حينَ فارقتُهُ",71,"ت",2,0],["لما به نزلنا","لكربنا أَزلنا",72,"ن",2,0],["لما بررت من نار حربي جذوة","ولو غرفت من دجلة وفرات",73,"ت",1,0],["لم أبكه أسفا على مرح الصبا","ووصال غانية وشرب مدام",74,"م",1,0],["لما بلغت من الحياة إلى مدى","قد كنت أهواه تمنيت الردى",75,"د",2,1],["لمَّا بدا للعين أَرَّخْته","أَشرقتِ الدُّنيا بعبد الحميد",76,"د",1,0],["لما بدا بدر الجمال بعجبه","يختال تيها بارزاً من حجبه",77,"ه",1,1],["لِما بَراهُ من محاسنِ الصُوَرِ","قال الورى تاللهِ ما هذا بشَرْ",78,"ر",1,0],["لما بو عروة جاوزت أمشي","ولهدة ثم بربر في طريقي",79,"ق",2,0],["لم أبق حيا بعدما","رحل الخليط وعدت وحدي",80,"ي",1,0],["لمَّا بدا يخطر في حلتينْ","ويلي على رقِة تلك الخلالْ",81,"ل",1,0],["لمّا بَدا بَرَدى تَجودُ فروعُه","بين الرياضِ دَعى إلى التشبيهِ",82,"ه",1,1],["لَمَا بعث القاريُّ زُرق نبالهِ","بأقتلَ من تلك العيونِ وأرشقا",83,"ق",2,0],["لم أبك يوماً نَضرةً بوصاله","حتى بكيتُ على الشباب الناضرِ",84,"ر",1,0],["لمَا بِتُّ مِقْلاقَ الوَضينِ وبيننا","كما استبقت يوم الرهان الضَّوامِر",85,"ر",1,0],["لم أبك إذا نشرت بنود سحابها","إلا لحاجتها إلى أنوائها",86,"ا",3,0],["لم أبك جهلاً بالبكاءِ وإنما","خطبُ الفراق كما علمتَ شديد",87,"د",1,0],["لما بدا نور الهدى قلت انجلى","ما كنت أرجوه فلست أخيب",88,"ب",1,0],["لما بدا منه الصباح","همت هناك في فرح",89,"ح",1,0],["لَمّا بدا الفَحمُ فيهِ أَسوَدَ كَال","لَيلِ وَبَثَّ الشَرارَ كَالسَرجِ",90,"ج",1,0],["لما بعثت بلحظي","في خد جُلْنارَ نارا",91,"ر",2,1],["لم أُبارحْ أعتابَهُ طرْفةَ العيْ","نِ ولو أنَّها القِيامةُ قامتْ",92,"ت",1,0],["لما برزت غداة فطرك خاشعاً","وشعارك التكبير والتمجيد",93,"د",1,0],["لما برزت إلى المصلى لابساً","ثوب الخشوع وهيبة الآساد",94,"د",1,0],["لما برزت إلى المصلى معلناً","وشعارك التكبير والتهليل",95,"ل",1,0],["لمّا بسِمْنَ لنا أبدين عن شَنَبٍ","مُمَنَّعٍ ليس يُروى منه ظمآنُ",96,"ن",1,0],["لمّا بَنَوْا خُططَ العَلاءِ وشيّدوا","قَعدَ الرّدى فيما اِبتَنَوْهُ وقاما",97,"م",2,0],["لَمّا بَدا القَمَرُ اِستَحيَت فَقُلتُ لَها","بَعضَ الحَياءِ فَإِنَّ الحُبَّ قَد ظَهَرا",98,"ر",2,0],["لم أبكه لكن برؤية غيره","طهرت أجفاني بفيض دموعي",99,"ي",1,0],["لمَّا بَدت في رُبيَ المُصَلَّى","علمت الصبحَ الاسفرارَا",100,"ر",2,0],["لمَّا بدت دونَه تَسمَّى","مَجْنَونها ما رآه عَارا",100,"ر",2,0],["لم أبت قط خالياً من شجونٍ","بك والدمع في الخدود يسيل",101,"ل",1,0],["لَمَّا بَدَا فِي كَفِّهِ","خَالٌ كَنُقْطَةِ غَالِيَهْ",102,"ه",1,0],["لما بكيتُ ضحكْتَ من طَرَبٍ","فنظمتَ ما كان المُحِبُّ نَثَرْ",103,"ر",1,0],["لَمَّا بكوْا وضَحِكْتُ أَنْكَرَ بَعْضُهُمْ","شَأْني وَقَالوا الوَجْدُ بِالعَبراتِ",104,"ت",1,0],["لَمَّا بَحَثُوا عِنْدِي فِي فُرْقَتِنَا","اشْتَاقَ لَهُمْ مَسَايِلاً مِنْ دَمْعِي",105,"ي",1,0],["لَمَّا بَدَتْ رَشَقَتْ قَلبي لَواحِظُها","مَنْ مُنْصِفي في الهَوى مِنْ أَسْهُمِ الحَدقِ",106,"ق",1,0]]}