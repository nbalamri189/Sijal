w.poetsgate.com/ViewPoem.aspx?id=182739",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[6125,"في ضَيِّ عينيكِ القصيدُ تَبَعثَرا","https://www.poetsgate.com/ViewPoem.aspx?id=210971",""],[6127,"سقطَ النصيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=198388",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[520,"بصفات مجدك يشرف التمجيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577470",""],[321,"لهفى عليك ابا النذير لو انه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606414",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""]],"verses":[["لَمّا بَدَت فَرَأَيتُها في صُفرَةٍ","كَلِفَ الفُؤادُ بِكُلِّ شَيءٍ أَصفَرِ",0,"ر",1,1],["لَمّا بَلَوتُ أَخِلاّئي وَجَدتُهُمُ","كَالدَهرِ في الغَدرِ لَم يُبقوا عَلى أَحَدِ",1,"د",1,0],["لَمَا بَلَغَ النُّعْمَى عَلَيْكَ سُرُورُهُ","أَلِيَّةَ وَافٍ لاَ ألِيَّةَ خَوَّانِ",2,"ن",1,0],["لمّا بعَثْتُ بِها تورّدَ خدُّها","واحْمَرّ منْ خَجَلٍ لديْكَ عَراها",3,"ا",3,0],["لَمَّا بَرَزْتَ إلَى المُصَلَّى مَاشِياً","وَدَّتْ خَدُودٌ أَنَّهَا حَصْبَاءُ",4,"ا",2,0],["لَمّا بَدا الصَدغُ مُسوَدّاً بِأَحمَرِهِ","أَرى التَسالُمَ بَينَ الرومِ وَالحَبَشِ",5,"ش",1,0],["لَمَّا بَدَا أَنْشَدَ الإِقْبَالُ فِي جَذَلٍ","تَاريخ بُولَسَ سَامٍ غُرَّةِ الزَّمَنِ",6,"ن",1,0],["لَمْ أَبْغِ حثّاً إِخْوَانِي بِهَا وَهُمُ","أَهْلُ النَّدَى بَلْ كَمِشْكَاةِ لإِخْوَانِي",7,"ن",2,0],["لَمْ أَبْغِ مِنْ ذِكْرِهَا أَنْ تَيْأَسُوا جَزَعاً","خَيْرٌ مِنَ اليَّأْسِ أَن يُسْتَقْدَمَ العَدَمْ",8,"م",1,0],["لَمّا بَلَغتُ إِمامَ العَدلِ قُلتُ لَهُم","قَد كانَ مِن طولِ إِدلاجي وَتَهجيري",9,"ر",2,0],["لَمّا بَنى الخَطفى رَضيتُ بِما بَنى","وَأَبو الفَرَزدَقِ نافِخُ الأَكيارِ",10,"ر",1,0],["لَم أبِع دِينيَ المُسَاوِمَ بِالوَك","سِ وَلاَ مُغلِيَاً مِنَ السُّوَّامِ",11,"م",1,0],["لَم أَبُح بِالوَداعِ جَهراً وَلَكِن","كانَ جَفني فَمي وَدَمعي كَلامي",12,"ي",1,0],["لَمّا بدا البَدءُ أَبدى عِشقُهُ صِفَةً","فيما بَدا فَتَلَالاَ فيهِ لَألاءُ",13,"ا",2,0],["لما بدا لك أنَّ خِزْيك قد غدا","أحدوثة الرُّكبان والأَملاءِ",14,"ا",2,0],["لم أبتدع في ثنائك الحسن ال","منشَر بل كنتُ بعض من نَشره",15,"ر",2,0],["لمَا بدا لي بشيرُ غُرَّته","وراع دهري نذيرُ إنباضه",16,"ض",2,0],["لم أبتدعْ بدعةً بمدحكُمُ","قد قَرَّضَ الناسُ قبلِيَ الأدَمَا",17,"م",2,0],["لَم أُبصِر ذاتي بِالأَمسِ","في لَوحِ زُجاجٍ أَو ماءِ",18,"ا",2,0],["لما بدا لي ان قلبك ملني","وعلمت ان هناك ما لا اعلم",19,"م",1,1],["لما بلغت مداها","وأصبحت بك تغلو",20,"ل",2,0],["لما بلغت السؤل ليلة مدحه","بعث الملوك يعظمون جنابي",21,"ب",2,0],["لما بدت منك السعود تمزقت","تلك القيود وأُطلق السجناء",22,"ا",2,0],["لما بدا الشهر واستقبلت غرّته","لاح الهلال ولاح البدر في آن",23,"ن",1,0],["لَمّا بَنَيتَ الأَيكَ وَاِستَوهَبتَهُ","بَعثَ الهَزارَ وَأَرسَلَ الوَرقاءَ",24,"ا",2,0],["لَمّا بَلَغنا بِالأَحِبَّةِ وَالمُنى","بابَ السُرورِ تَغَيَّبَ المِفتاحُ",25,"ح",1,0],["لَمّا بَنى اللَهُ القَضِيَّةَ مِنهُمُ","قامَت عَلى الحَقِّ المُبينِ عَمودا",26,"د",2,0],["لمّا بَدا وجدي وكان مُكتَّماً","أَبْدَيْنَ وَجْداً كان فيَّ مُكَتَّما",27,"م",2,0],["لَمَّا بدَتْ راياتُ صُبْحٍ مُقْبلٍ","يَخفُقْنَ في أعجازِ ليلٍ مُدبرِ",28,"ر",1,0],["لَم أُبقِ غَيرَ جَماجِمٍ عَرِيَت","بيضٍ تَلوحُ وَأَعظُمٍ نَخِرَه",29,"ر",2,0],["لَم أُبادِركَ بِالوَداعِ لِأَنّي","واثِقٌ بِاِجتِماعِنا عَن قَريبِ",30,"ب",1,1],["لَم أَبكِ بِالحُزنِ الطَويلِ تَمَلُّقاً","حُزني عَليكَ وَقائِعٌ وَحُروبُ",31,"ب",1,0],["لَمّا بَدَت لِلأَرضِ مِن قَريبِ","تَشَوَّفَت لِوَبلِها السَكوبِ",32,"ب",1,0],["لَمّا بَدا لي مِن صَميمِكَ ما بَدا","بَل لَم يُصَب لَكَ لا أُصيبَ صَميمُ",33,"م",1,0],["لَمّا بَلَغنا ساحَةَ الحَسَنِ اِنقَضى","عَنّا تَعَجرُفُ دَولَةِ الإِمحالِ",34,"ل",1,0],["لَم أُبقِ حَلبَةَ مَنطِقٍ إِلّا وَقَد","سَبَقَت سَوابِقَها إِلَيكَ جِيادي",35,"د",2,0],["لمَّا بَدَتْ غيداءُ في حلَّةٍ","سوداءَ مثلَ الشمسِ تحت السحابْ",36,"ب",1,1],["لما بكى فقدَ الهمومِ سحابُها","ضحكتْ وقدْ عاشَ السرورَ زهورُها",37,"ر",3,0],["لم أبِعهُ لشقيقٍ","أو صديقٍ لي حميمِ",38,"م",1,0],["لَما بَلَغتُ إِزاءَ البابِ مُكتَتِماً","وَطالِبُ الحاج تَحتَ اللَيلِ مُكتَتِمُ",39,"م",1,0],["لَمّا بَدا لِيَ مِنكُم غَيبُ أَنفُسِكُم","وَلَم يَكُن لِجِراحي مِنكُمُ آسي",40,"س",2,0],["لَم أَبكِ في مَجلِسِ مَنصورِ","شَوقاً إِلى الجَنَّةِ وَالحورِ",41,"ر",1,1],["لَم أَبِت غافِلاً فَأَشراني الحِر","صُ إِلى أَن أَعودَ كَالأَشرانِ",42,"ن",1,0],["لما بدا للأرض مُستبهِجاً","كادَت له عيدانُها تُورِقُ",43,"ق",1,0],["لمّا بَدا كِبَرٌ تَكا","دُ يَدايَ مِنهُ تَرعشانِ",44,"ن",1,1],["لما بدا قدَّست من","خَلقَ الخلائق من عدم",45,"م",1,0],["لما برمت به فارقته جذلا","وكف دمعي عن سح وتهتان",46,"ن",1,0],["لم أبكِ أن رحلَ الشبابُ وإنما","أبكى لأنْ يتقاربْ الميعادُ",47,"د",1,1],["لمّا بَدا الكفُّ الخَضيبُ رأيتَني","جَذْلانَ للعَنمِ الخَصيبِ مُرافِقا",48,"ق",2,0],["لَما بَلَغوا في قُبحها عُشر وَصفها","وَما بَلغوا مِن حسنِ أوصافك العشرا",49,"ر",2,0],["لما بدا في دجى الظلماء أوهمني","أن الصباح بدا أو ضوء مصباحِ",50,"ح",1,0],["لم أبك يوماً على نفسي بكيت لكم","عنكم بشعر كمثل الدر منضود",51,"د",1,0],["لما بدا لي الحبيب","يشبه لبدر التمام",52,"م",1,0],["لمّا بَلغتُ أشُدِّي بعدما انْقَرَضَتْ","بعد الثّلاثين خَمْسٌ مِن زمانِيَ لي",53,"ل",2,0],["لَمّا بَنى اللَهُ السَماواتِ العُلى","سَبعاً تَعالى اللَهُ أَكرَم باني",54,"ن",2,0],["لمَّا بَكَيْتُ بَكَى يُسَاعِدُنِي الحَيَا","فَدُمُوعُهُ مِنْ رِقَّةٍ لِيَ تَهْمَعُ",55,"ع",1,0],["لمَّا بَكَتْ مِنْ غَيْرِ دَمْعٍ جَرَى","أَعَارَها أدْمُعَهُ المُزْنُ",56,"ن",1,1],["لَمَّا بَنَوْا شُرُفاتِهِ مِنْ فِضَّة","جَعَلُوا أَدِيمَ قِبابِهِ عِقْيانا",57,"ن",2,0],["لم أَبُحْ بالهوى الخف","يّ اختياراً فأُهْجَرا",58,"ر",2,0],["لَمّا بَدا لي ثَغرُهُ باسِماً","أَيقَنتُ بِالخَيرِ فَلاحَ الفَلاح",59,"ح",1,0],["لَمّا بَعَثتُ بِداعي الشَوقِ وَالدَلهِ","إِلى زِيارَةِ مَن فيها نَما وَلَهي",60,"ي",1,1],["لَم أَبكِ مِن خُبثِ خِلٍّ","إِلّا بَكَيتُ عَلَيهِ",61,"ي",2,1],["لمّا بدا والشّوقُ يُدْني