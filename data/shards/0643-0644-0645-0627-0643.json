{"poems":[[55,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[55,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[63,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[99,"بين سهد وعذاب وضنى","https://www.aldiwan.net/poem24860.html","الرمل"],[50,"يا ابنة الشيخ اصبحينا","https://www.aldiwan.net/poem65280.html","مجزوء الرمل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8913","الرمل"],[102,"راهب الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50160",""],[136,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[159,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[190,"هذا المورث قال لي","https://www.aldiwan.net/poem43233.html","مجزوء الكامل"],[190,"زهد الناس في العلوم","https://www.aldiwan.net/poem44141.html","مجزوء الخفيف"],[289,"أتراني أرى من الدهر يوما","https://www.aldiwan.net/poem44317.html","الخفيف"],[303,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[358,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[406,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[422,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[422,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[435,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[466,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110446","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119892","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96686","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56309","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136200","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109206","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123097","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27520","الخفيف"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[2599,"","https://poetry.dctabudhabi.ae/diwan/poem/142624","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76014","الرمل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68728","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205783","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58471","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132668","الرمل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34665","الخفيف"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88585","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136918",""],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124303","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73159","الخفيف"],[4680,"إهدئي يا ريحُ","https://www.poetsgate.com/ViewPoem.aspx?id=185984",""],[4767,"ههنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=197295",""],[5219,"ليتها","https://www.poetsgate.com/ViewPoem.aspx?id=194757",""],[5351,"هل تراهم إليك بالقهر جاؤوا؟","https://www.poetsgate.com/ViewPoem.aspx?id=202634",""],[5413,"للنقود عطر لا يُقَاوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=201483",""],[5431,"الشعر واللين...","https://www.poetsgate.com/ViewPoem.aspx?id=202299",""],[5525,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=847",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5950,"السماء لا تطيحَ","https://www.poetsgate.com/ViewPoem.aspx?id=128124",""],[5956,"غليل وعويل","https://www.poetsgate.com/ViewPoem.aspx?id=181971",""],[5956,"قصة‎ ‎اللص والبَصَل","https://www.poetsgate.com/ViewPoem.aspx?id=184623",""],[5956,"أنت مثلي يا أرتين","https://www.poetsgate.com/ViewPoem.aspx?id=205429",""],[6056,"البارعة","https://www.poetsgate.com/ViewPoem.aspx?id=156701",""],[6102,"استِنزاف","https://www.poetsgate.com/ViewPoem.aspx?id=182845",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[1706,"في بطحاء مكة","https://www.poetsgate.com/ViewPoem.aspx?id=102862",""]],"verses":[["كُلَّما كَرَّتِ اللَيالي عَلَينا","شَقَّ فيها الوَفاءُ جَيبَ الشِقاقِ",0,"ق",1,0],["كُلَّما كانَ زائِدَ العَقلِ أَمسى","ناقِصاً مِن تَليدِهِ وَالطَريفِ",1,"ف",1,0],["كل ما كنا قد نظمناه قبلا","نظرة في الحياة من نظراتك",2,"ك",1,0],["كلَّما كرَّتِ الجِباهُ بصبُحٍ","عطفَتْ ليلَها عليه الطِّرارُ",3,"ر",1,0],["كلُّ ما كان بعيداً ورنا","كلُّ نجمٍ من سماوات السنا",4,"ن",2,0],["كُلَّ ما كانَ خِلافاً","لِشَرابِ الصالِحينا",5,"ن",2,0],["كُلَّما كَلَّمنِي قَبَّلْتُهُ","فَهْو إِمّا قال قَوْلاً ردَّدا",6,"د",2,0],["كُلَّمَا كَفْكَفَهُ نَاهِي النُّهَى","عَنْ أَذَاهُمْ جَرَّأُوهُ فَتجَرَّى",7,"ر",2,0],["كُلَّما كُبَّ لِشُربٍ خِلتَهُ","حَبَشِيّاً قُطِعَت مِنهُ الرُكَب",8,"ب",1,0],["كلّما كتّم الهوى","فضح الفنّ ما كتم",9,"م",1,0],["كَلَّمَا كَلَّمتُه آلَم قَلبي","أنّهُ آلَ لِلرَّبَابِ كَلِيمَا",10,"م",2,0],["كُلَّما كَرَّ ناظِري فيهِ أَبْدى","لُؤْلُؤاً مُطْبِقاً عَلَى جُلَّنارِ",11,"ر",1,0],["كل ما كسبت وجزّه","بالعدل في ألوانه",12,"ن",2,0],["كل ما كان قائما","مستويا قد انتصب",13,"ب",1,0],["كل ما كان في الدما","غ فقد صار في الذنب",13,"ب",1,0],["كُلَّما كُنتُ في جَميعٍ فَقالوا","قَرِّبوا لِلرَحيلِ قَرَّبتُ نَعلي",14,"ل",2,0],["كلَّما كشَّف كرباً","نابه يا ميّ كرب",15,"ب",1,0],["كلَّما كُرِّر الملامُ عليها","في الإساءات زادها إغراءَ",16,"ا",2,0],["كُلّ ما كانَ أَو يَكون فَفي جا","نب عَلياك كائن كَالهباءِ",17,"ا",2,0],["كُلَّما كَفكفت دَمعي اِنسَجَما","وَإِذا اِستنجدت بِالصَبر هَرَب",18,"ب",1,0],["كلُّ ما كانَ من دعاوى تَهاوى","وتلاشى ما كان يستهوينا",19,"ن",2,0],["كلَّما كرَّرْتُ فيه نظراً","رَمَقَتْني منه أَلحاظُ الورود",20,"د",1,0],["كلَّما كرَّ كرَّةً بعد أُخرى","بعث الرُّعب في القلوب رسولا",21,"ل",2,0],["كلما كفكفت عينا سجمت","قال في الظلما دخان فاهطلي",22,"ل",2,0],["كلما كفكف من وثبتهِ","ذهب الخوفُ بألبابِ الرجال",23,"ل",1,0],["كلّما كبّر في حَشْرِ وغىً","سبّح الصّفُّ لآياتٍ يَراها",24,"ا",3,0],["كُلَّما كُنّا رُؤوساً","لِلوَرى كُنتُم عُجوبا",25,"ب",2,0],["كلَّما كَرَّرَتهْ تسأَمه النَّف","سُ سِوَى مَدْحِه إِذَا مَا تَكرَّرْ",26,"ر",1,0],["كلَّما كاد بضَمدُ الجرحُ تَرميني","بجرحٍ مُفَتّت الأَكبادِ",27,"د",1,0],["كلَّما كشَّ أُفْعُوانُ ضَلالٍ","دَمغوا أُفعُوانه الكشَّاشا",28,"ش",2,0],["كلما كررت على سامعيها","فعلت بالعقول فعل السلاف",29,"ف",1,0],["كلّما كرّرَ في تغريدهِ","زادَني تغريدهُ نارَ الأسَف",30,"ف",1,0],["كلّما كفّ لَدى أصحابهِ","دمعهُ مِن مَدمعيهِ اِندَفَعا",31,"ع",2,0],["كلما كفكفت عيناً سجمت","قال دخان من النار أهطلي",32,"ل",2,0],["كلما كفكفت دمعي انسجما","أو عز الشوق لعيني اكبسي",33,"ي",1,0],["كلما كفك اضحى ممطرا","كف وكاف السحاب",34,"ب",1,0],["كل ما كان في التنزل والان","زال يبدو فذاك شان كبير",35,"ر",1,0],["كل ما كان بيننا سوءُ فهم","فامنع السوءَ بيننا إن يجولا",36,"ل",2,0],["كلّما كان أن تكون لسرّ","فلشر أبانها ونفاها",37,"ا",3,0],["كلما كلم قلبي طرفه","أخلق الصبر وشوقي جدّدا",38,"د",2,0],["كلُّ ما كان أو يكون وما لا","إنما كونه بأمر متاح",39,"ح",1,0],["كلما كلمته باعد عن","متن ملساء كمثل السرق",40,"ق",1,0],["كل ما كان لم يكن","وأنا لم أعد أنا",41,"ن",2,0],["كُلَّما كلَّفتُ قَلبي عَنكُمُ","صَبرَهُ زادَ بِقَلبي الكَلَفُ",42,"ف",1,0],["كل ما كان طاعة فهو شكر","والمعاصي كفران ما لا يزال",43,"ل",1,0],["كلما كرت الليلي عليه","جددت منه أوثق الأسباب",44,"ب",1,0],["كلُّ ما كُنْتَ تتّقيهِ محالا","لم تُحَقّقْ بصّحة أحكامَه",45,"م",2,0],["كلما كلف قلبي سلوة","زاد قلبي في هواه كلفا",46,"ف",2,0],["كل ما كان من حبيبك","مستظرفٌ حسن",47,"ن",1,0],["كلما كفكفت مني عبرة","فاضت العين بمنهلّ درَر",48,"ر",1,0],["كلما كفكفت منه وكفا","فوق خدي وكيف المزن",49,"ن",1,0],["كل ما كان في شبابك حقاً","اصبح اليوم في اكتهالك ضله",50,"ل",2,0],["كلما كذبته منهم جموع","كلمته من أرضهم عجماء",51,"ا",2,0],["كلَّما كانَ منكَ عنِّي انقباضٌ","زادَ منكَ الإِعجابُ والانبساطُ",52,"ط",1,0],["كل ما كان بعثرته المنايا","والبقايا على البقايا تنوحُ",53,"ح",1,0],["كلما كرَّ فرَّ مِن سيفِ حقٍّ","واعتراه الذهول والانكفاء",54,"ا",2,0],["كلما كابرت في دنيا الهوى","راح قلبي يشتكي داء دفينا",55,"ن",2,1],["كلما كنتَ، يشطبونك إسماً","كلما طرت يكسرون جناحك",56,"ك",1,0],["كلُّ ما كنتَ دونَهُ فسَرَابٌ","في عقولٍ تُؤلِّه الأثرياء",57,"ا",2,0],["كلّما كنت ليّنا صرت بحرا","بشغافٍ من اللالئ لاقط",58,"ط",1,0],["كل ما كتبت أبها .. نشت فوق الأوراق","سحابةٍ .. وابتل في الصدر معلوق",59,"ق",1,1],["كل ما كان أو يكون فمن اجل","علاه بظله مستور",60,"ر",1,0],["كلما كثّروهُ ، كان قليلاً","كلما قللوهُ كانَ كانَ مزيدا",61,"د",2,0],["كل ما كبر جرحك صرت مثله كبير","كل ماطال بعدك صار دمعك شحيح",62,"ح",1,0],["كلما كنتُ وحيداً","لا أراكِ تُقْبِلينْ",63,"ن",1,1],["كلما كنَّا نشدُّ الكيسَ شدَّتْ","خَشْبَةُ (الرَّاسور) هذا الباب جاما",64,"م",2,0],["كلما كسَّر ربي فيَّ عضواً","فاجأ الرحمن أيضاً فيَّ عضوا",65,"و",2,0],["كلما كبرّت أصليّ في خشوع","إنبرى طيفك ، وشال القافية",66,"ف",3,0],["كُلُّ ما كانَ بَينَنا قَد تَلاشَى","قَتَلَ الحُبَّ- بَينَنا- الإِجحافُ",67,"ف",1,0],["كُلُّ ما كانَ قَدْ غَدا الآنَ نَسيًا","بِنُفُورِ الأَحِبَّةِ الفُرَقاءِ",68,"ا",2,0],["كلما كلَّتِ المطايا من الإغ","ذاذِ صاحا: إن النجاة النجاء",69,"ا",2,0]]}