{"poems":[[95,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[53,"بخلت علي بجدوى سواك","https://www.aldiwan.net/poem66528.html","المتقارب"],[45,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[30,"إن يظعن الشيب الشباب فقد ترى","https://www.aldiwan.net/poem1267.html",""],[82,"ونيلوفر أوراقه مستديرة","https://www.aldiwan.net/poem31462.html","الطويل"],[71,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[71,"سألت من الناهي عن البدع التي","https://www.aldiwan.net/poem29270.html","الطويل"],[107,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[107,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[21,"مجدوا الله فهو للمجد أهل","https://www.aldiwan.net/poem36210.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42580","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[113,"دنوا لقد أوهى تجلدي البعد","https://www.aldiwan.net/poem16228.html","الطويل"],[119,"الى شيخون تنعطف الاماني","https://www.aldiwan.net/poem41257.html","عموديه"],[132,"سلام جزيل نير اللفظ شارق","https://www.aldiwan.net/poem50564.html","الطويل"],[136,"صبغت بدمع عاشقك الخدودا","https://www.aldiwan.net/poem54860.html","الوافر"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[199,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[210,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[266,"محل العلا لولا الدني شريف","https://www.aldiwan.net/poem38231.html","الطويل"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[302,"على باب ابن معصوم أنخنا","https://www.aldiwan.net/poem33303.html","الوافر"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[358,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[366,"قال لي قائل رأيتك تهوى","https://www.aldiwan.net/poem68059.html","الخفيف"],[369,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[369,"أسائل عنها الركب وهي مع الركب","https://www.aldiwan.net/poem60986.html","الطويل"],[408,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[457,"تنفست نسمات السحر في السحر","https://www.aldiwan.net/poem13760.html","البسيط"],[463,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[466,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[466,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[519,"هوى الكوكب الدري من أفق المجد","https://www.aldiwan.net/poem20841.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126816","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126753","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126693","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126738","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87177","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87017","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86597","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86922","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86890","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86784","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38770","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39009","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1129,"","https://poetry.dctabudhabi.ae/diwan/poem/102043","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136189","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136105","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136280","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78178","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50026","المتدارك"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48961","الوافر"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103225","الطويل"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110707","البسيط"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110705","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69341","الكامل"],[2117,"","https://poetry.dctabudhabi.ae/diwan/poem/111326","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121206","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126197","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126195","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93649","الطويل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105405","الطويل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100436","البسيط"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110666","الطويل"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45320","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65242","المنسرح"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65126","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131899","الكامل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123900","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74062","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126964","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127026","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127006","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45812","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85171","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111449","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77069","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119655","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127242","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90866","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90955","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81944","الخفيف"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45301","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4738,"طَوايا نِظامي في الزَّمانِ لها نَشرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205737",""],[4761,"هي الشمس أم نار على علم تبدو","https://www.poetsgate.com/ViewPoem.aspx?id=127120",""],[4767,"عين الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=93516",""],[4830,"اِبتداءُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214929",""],[4847,"قل هو الحب وطن","https://www.poetsgate.com/ViewPoem.aspx?id=175537",""],[4960,"السَّيِّد النُّبْل","https://www.poetsgate.com/ViewPoem.aspx?id=214474",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5366,"صحت ولا شلت ونالت عدوها","https://www.poetsgate.com/ViewPoem.aspx?id=186591",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[5753,"مولاي","https://www.poetsgate.com/ViewPoem.aspx?id=198597",""]],"verses":[["هُوَ ابْتِناءٌ لِمَا تَرْجُونَ مِنْ عِظَمٍ","وَهْوَ اتِّقَاءٌ لِمَا تَخْشَونَ مِنْ فِتَنِ",0,"ن",1,0],["هو ابن الشهيد الذي لا يُثاب","ثوابَ الشهادة بل يُلعنُ",1,"ن",1,0],["هُوَ اِبنُ رَسولِ اللَهِ وَاِبنُ وَصِيِّهِ","وَشِبهُهُما شَبَّهتُ بَعدَ التَجارِبِ",2,"ب",1,0],["هُوَ اِبنُ أَبي موسى الَّذي كانَ عِندَهُ","لِحاجاتِ أَصحابِ الرَسولِ كِتابُها",3,"ب",3,0],["هُوَ ابْنُ بِلادي كَاغتِرابي اغتِرابُهُ","كِلانا عَنِ الأَوْطانِ أَزْعَجَهُ الدَّهرُ",4,"ر",1,0],["هو ابن جَلا وطلاَّعُ الثنايا","متينُ المتنِ خفَّاقُ الجناحِ",5,"ح",1,0],["هوَ ابنُ الزَّمَلْكاني الهمامُ الذي له","تُقى وفنونٌ جمَّة وقنوتُ",6,"ت",1,0],["هو ابنُ عتيكٍ إن جَهِلتَ وصَحبُه","فلستَ بلاقٍ من حِمامِكَ واقيا",7,"ي",2,0],["هُوَ ابنُ الأكوعِ البَطلُ المُرجَّى","سَباها حِينَ أسْلَمَها الرُّعاةُ",8,"ه",1,0],["هوَ أَبدى كُلَّ ما يَأثُرُ","الناسَ أَماثيلَ باقياتٍ سُفورا",9,"ر",2,0],["هُوَ ابنُ السماءِ ولكنَّهُ","من النقصِ تركيبُه والتمامْ",10,"م",1,0],["هُوَ أَبْهَى وَجْهاً وَأَقْتَلُ أَلْحَا","ظَاً وَأَنْدَى خَدَّاً وَأَلْيَنُ قَدَّا",11,"د",2,0],["هُوَ ابْنَ عَبْدِ اللهِ ذِي الْ","قَدْرِ الرَّفِيعِ المُعْتَلي",12,"ل",2,0],["هُوَ ابن عِماد الدين مِن شاد مربعاً","مِن الفَضل في أَرجائِهِ يَنجَح القَصد",13,"د",1,0],["هو ابن المصطفى والآل قوم","بهم ينجو المكبر الذنوب",14,"ب",1,0],["هوَ ابن الإمامِ العدلِ سُلطان سيفِنا","أبو العربِ الزاكي الرفيقُ المرافِقُ",15,"ق",1,0],["هُو ابنُ الدَّيدِ سَيِّدُ كٌُلِّ نَادٍ","وأَعلَى كُلِّ ذي رُتَبٍ شُهُوَدا",16,"د",2,0],["هو اِبنُ عبدِ اللَّه نجلِ النجبِ","جاءَ لهُ مِن قبلهِ في العربِ",17,"ب",1,0],["هُوَ اِبنُ الخَليفَةِ مِن ضَربِهِ","ضَريبَتُهُ فيهِ قَد تُعرَفُ",18,"ف",1,0],["هو ابن عبيد مورد كلّ ضيف","فأكرمنا بعزّ ما بقينا",19,"ن",2,0],["هو ابن علي بن سيفا أخو العلا","أبو الفضل خدن المكرمات حليف",20,"ف",1,0],["هُوَ اِبنُ بَجدَةِ ذي الدُنيا وَأَوحَدُها","فَشَملُ كُلِّ فَخارٍ فيهِ مُلتَئِمُ",21,"م",1,0],["هو ابنُ عَطاءٍ المُعطي كَثيراً","لنا من جودِه ابنَ أَبي رَباحِ",22,"ح",1,0],["هو ابن لعلويّ ابن من نال رفعة","يسمى بعبد اللّه اشجع فرسان",23,"ن",1,0],["هُوَ اِبن أَمين المَجد مَن بِمَقامِهِ","سَمَت فَوقَ فرق الفرقدين مَناصبُه",24,"ب",2,0],["هو أَبدى لَنا كُنوز فخار","نجتليها كَأَنَّنا نَجتَليهِم",25,"م",1,0],["هو ابْنُ مَن بعجَ اللهُ الغمامَ له","حتّى تَرهْيا فأحيا البَدْوَ والحَضَرا",26,"ر",2,0],["هو ابنُ رئيسِ الدّين والمُقتدَى به","بوَضْعِ هناءِ المُلْكِ في مَوضِعِ النُّقب",27,"ب",1,0],["هو ابنُ النَبيّ وهو ابنُ","الوصيّ كذلك فَلْكنِ المفخَرُ",28,"ر",1,0],["هو ابنِ خدن المعالي وابن بجدتها","عبد الرحيم إِمام البدو والحضر",29,"ر",1,0],["هو ابتدأ الندَى لم أحتسبه","وأورَى لي ولم يكن اقتداحُ",30,"ح",1,0],["هو ابن الذي جازى مناول سوطه","فأغنى وأقنى حين أعطى فأوسعا",31,"ع",2,0],["هو ابنُ بني الطَّعن الدِّراكي غبشة","وأهل النَّدى إنْ شائم الجود أعْتما",32,"م",2,0],["هو اِبنُ رسولِ اللّهِ والجوهرُ الّذي","تكوّن من نورِ النّبوّةِ والرُّشْدِ",33,"د",1,0],["هو اِبن عدنان والشأن العظيم إلى ال","غرّ الأعاظمِ من آبائه الأولِ",34,"ل",1,0],["هو اِبن البتولةِ سبط النبي","حِمى اللاجئينَ ملاذ البشَر",35,"ر",1,0],["هو ابن موسى على الطهر من شَهِدَت","له الوَرى أنّه أزكاهمُ نَسَبا",36,"ب",2,0],["هو اِبن ساداتِ الورى","وَالنُجباءِ الغررِ",37,"ر",1,0],["هوَ اِبن خديوي مصر توفيقٌ الَّذي","كَسا كَأبيه القطرَ درعَ أَمان",38,"ن",1,0],["هُوَ اِبن الأَكرمين أَبو المَعالي","سَديد الرَأي لِلمَعروف أَصل",39,"ل",1,0],["هُوَ اِبنُ الَّذي في مَوقف الحَرب ظافرٌ","بِأَعدائه وَهوَ الهمام المُحارب",40,"ب",1,0],["هُوَ اِبن الأَمير الضيغم الفارس الَّذي","لَهُ أَذعنت رغم الأُنوف الأَعارب",40,"ب",1,0],["هُوَ اِبن الَّذي قَد كانَ يَخشاه في الوَغى","كَميٌّ عَلى الأَعدا سَريع البَوادر",41,"ر",1,0],["هُوَ اِبن رَسول اللَه أَكرَم مُرسلٍ","وَأَعظَم مَخلوق لَهُ الفَتح وَالنَصر",42,"ر",1,0],["هُوَ إِبراهيم نجل","قَد أَتى مِن خَير جد",43,"د",1,0],["هُوَ اِبنٌ لياسينٍ فطه مُحمَّد","عَليهِ صَلاةُ اللَّه وَالآلِ وَالصّحبِ",44,"ب",1,0],["هوَ ابنُ الملوكِ الغرِّ في الدَّهرِ قَد غَدَوْا","ملوكَ ملوكِ الأرض طرّاً بلا نِدِّ",45,"د",1,0],["هوَ اِبنهُ مُصطفى العَلياء في شَرَفٍ","وَمِن مَعاليهِ مِن أَسنى العُلى اِنتخبت",46,"ت",1,0],["هو أبترٌ حقاً كنَي عنْه بذا","ربُّ العُلَى سُحْقا لشأن الأبتر",47,"ر"