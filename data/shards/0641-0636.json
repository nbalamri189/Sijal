[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39538","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9936","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20992","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42580","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42720","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54740","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55038","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54950","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54718","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"قيادة الدب","https://www.poetsgate.com/ViewPoem.aspx?id=179768",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[77,"نفحت فشبت لافح التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=34093",""],[77,"سكن الحب فؤادي وعمر","https://www.poetsgate.com/ViewPoem.aspx?id=34129",""],[23,"قالت له يوما تخاطبه","https://www.poetsgate.com/ViewPoem.aspx?id=11528",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[45,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""],[45,"أنَافِعي، عندَ لَيلى، فَرْطُ حُبّيها","https://www.poetsgate.com/ViewPoem.aspx?id=31647",""],[28,"ما نحن إن جارت صدور ركابنا","https://www.poetsgate.com/ViewPoem.aspx?id=20013",""],[51,"يا رُبَّ جَرِّي شَوّاءٍ مررتُ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30782",""],[20,"مضمم أَطراف العظام محنباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70009&r=&rc=31",""]],"verses":[["فَضائِلُ أَلَّفتَ أَشتاتَها","وَلَم تَكُ مَوجودَةً بِالعِيانِ",0,"ن",1,0],["فَضَنّاً بَني فِهرٍ بِما في أَكُفِّكُم","مِنَ المَجدِ فَالأَيّامُ عَودٌ وَراجِعُ",1,"ع",1,0],["فَضَرَبتُ أَوجُهَهُم بِغَيرِ مَناصِلٍ","وَهَزَمتُ جَمعَهُمُ بِغَيرِ جُنودِ",2,"د",1,0],["فَضافِضَ غيلٍ في الدِماءِ عَيِيَّةً","كَأَنَّ عَلى لَيتَيهِ سِبّاً مُوَرِّدا",3,"د",2,0],["فَضَّ جَمعَ الغِيِّ عَن شِدَّتِها","زَأَرَ الضَيغَمُ فَاِنصاعَ النَقَد",4,"د",1,0],["فُضالاتُ ما أَبقى الكُلابُ وَطَخفَةٌ","وَما أَسأَرَ الأَبطالُ يَومَ الذَنائِبِ",5,"ب",1,0],["فَضَنّتْ بِما تَحْويهِ شُلَّ بَنانُها","وَإِنْ رُمْتَ جَدْواها فَشُلَّ بَنانِي",6,"ن",2,0],["فَضَوءُ الصُّبْحِ مُرْتَقَبٌ لِسارٍ","تَرَدَّد بَيْنَ أَثْناءِ الظَّلامِ",7,"م",1,0],["فَضَعي قِناعَكِ إِنَّ رَيبَ","مُخَبِّلٍ أَفنى مَعَدّا",8,"د",2,0],["فَضائِلُ عَزمٍ لا تُباعُ لِضارِعٍ","وَأَسرارُ حَزمٍ لا تُذاعُ لِعائِبِ",9,"ب",1,0],["فَضَحِكتُ حينَ رَأَيتُها","وَبَكَيتُ حينَ قَراتُها",10,"ت",3,0],["فَضَعَّفَني حُبَّيكِ حَتّى كَأَنَّني","مِنَ الأَهلِ وَالمالِ التِلادِ خَليعُ",11,"ع",1,0],["فَضْلِ الْهَوَاءِ وَصِحَّةِ الْمَاءِ الَّذِي","يَجْرِي بِهَا وَسَلاَمَةِ الْمَخْزُونِ",12,"ن",1,0],["فضاءٌ تَضيقُ الأرْضُ عنْهُ برَحْبِها","وشِيمَةُ حِلْمٍ لا يَضيقُ بِها صدْرُ",13,"ر",1,0],["فضَمَمْتُ الغُصْنَ من ثوبِ النّقا","ولثَمْتُ الرّاحَ منْ بيْنِ الدّرَرْ",14,"ر",1,0],["فضُلوعُ مُشْتاقٍ يُشِبُّ وُقودَها","ذكْرُ العُهودِ ودمْعُ عيْنٍ جاري",15,"ر",2,0],["فَضَلْتَ النّبِيئِينَ الكِرامَ مَزيّةً","وكمْ بيْنَ رَبِّ اشْرَحْ وبيْنَ ألَمْ نَشْرَحْ",16,"ح",1,0],["فَضَلَ المُلوكَ فليْسَ يُدْرَكُ شأوُهُ","أنّى يُقاسُ الغَمْرُ بالضَّحْضاحِ",17,"ح",1,0],["فَضَاعَفَ فِي مَثْوَاكَ رَبُّكَ نُورَهُ","وَنَضْرَتَهُ لَقَّاكَهَا وَسُرُورَه",18,"ه",1,0],["فَضَضتُ بِها ما كانَ جَمَّعَ قَبلها","كَما انفَضَّ عَن شَمسِ النَهارِ الكَواكِبُ",19,"ب",1,0],["فُضاضاً كَما تَنزو دَراهِمُ تاجِرٍ","يُقَمِّصُها فَوقَ البَنان الأَباهِمُ",20,"م",1,0],["فَضَع حَدّاً لَهُم وَاُنظُر إِلَينا","إِذا أَنصَفتَنا نَظَرَ الوَدودِ",21,"د",1,0],["فَضَجَّ لَها العَرشُ وَالحامِلوهُ","وَضَجَّ لَها القَبرُ في يَثرِبِ",22,"ب",1,0],["فَضِقتُ ذَرعاً بِأَمرٍ","عَلى النُفوسِ بَئيسِ",23,"س",1,0],["فَضَفا عَلَيَّ ظِلالُ أَبلَجَ ماجِدٍ","ضافي لِباسِ المَجدِ صافي المَشرعِ",24,"ع",1,0],["فَضَحَ الدُهاةَ فَلَو تَقَدَمَ عَهدُهُ","لَعَنا المُغيرَةُ أَو أَقَرَّ زِيادُ",25,"د",1,0],["فَضَحَت مَحاسِنُهُ الرِياضَ بَكى الحَيا","وَهناً عَلَيها فَاِغتَدَت تَتَبَسَّمُ",26,"م",1,0],["فَضَلَ السابِقَ المُقَدَّمَ في النُض","جِ فَأَزرى بِطَعمِهِ إِزراءَ",27,"ا",2,0],["فَضْلٌ مِنَ اللهِ لاَ يَحْصِيهُ حَاسِبُهُ","يُؤْتَأهُ كُلُّ نَدَىِّ الْكَفِّ مُحْتَسَبِ",28,"ب",1,0],["فَضَاعَ فِي إِسْرَافِهِ عُمْرُهُ","وَلَمْ يَنَلْ إِلاَّ المُنَى السَّافِلَهْ",29,"ل",2,0],["فَضِيلَةُ البِرِّ قَدْ تَجَلَّتْ","فِيهِ وَأَعْظِمْ بِهَا فَضِيلَهْ",30,"ل",2,0],["فَضْلُكُمْ أَصْبَحَ المِثَالَ المُعَلَّى","أَيُّ فَضْلٍ كَنُصْرَةِ الْعِرْفَانِ",31,"ن",1,0],["فَضَمِنْتَ صِحَّتَهَا مشَذَّبَةً","وَأَوَلْتَ مَا اسْتَعْصَى مِنَ السَّقَمِ",32,"م",1,0],["فضح الغزالة والأقاحة والقنا","مهما تثنَى أو تبسّم أو نظرْ",33,"ر",1,0],["فضمت إلى الصدر اليدين وعينها","تقاذفُ منها بالدموع شؤون",34,"ن",1,0],["فضاقّت بطنه ِشبعا وشالت","إلى أن كاد ينقطع الحزام",35,"م",1,0],["فَضَلوا بِيَومِ مَكارِمِ مَعلومَةٍ","يَومٍ أَغَرَّ مُحَجَّلٍ مَشهورِ",36,"ر",1,0],["فَضَلَّ ضَلالَ العادِلينَ مُجاشِعاً","ثُلوطَ الرَوايا بِالحُماةِ عَنِ الثَغرِ",37,"ر",1,0],["فَضَحَ الكَتيبَةَ يَومَ يَضرِطُ قائِماً","سَلحُ النَعامَةِ شَبَّةُ بنُ عِقالِ",38,"ل",1,0],["فَضلاً وَذو كَرَمٍ يُعينُ عَلى النَدى","سَمحٌ كَسوبُ رَغائِبٍ غَنّامُها",39,"م",3,0],["فَضّلُوا النَّاسَ في الحَدِيثِ حَدِيثاً","وَقَدِيماً في أوّلِ القُدَّامِ",40,"م",1,0],["فَضمَّ قَوَاصِي الأَحيَاءِ مِنهُم","فَقَد أمسَوا كَحَيٍّ وَاحِدِينَا",41,"ن",2,0],["فَضَلَت لَدَيَّ مَدامِعٌ فَبَكيتُ لِل","باكي بِها وَوَلِهتُ لِلوَلهانِ",42,"ن",1,0],["فَضَلتَ بِها أَهلَ القَريضِ فَأَصبَحَت","تَحِيَّةَ أَهلِ البَدوِ مُؤنِسَةَ الحَضرِ",43,"ر",1,0],["فَضَحِكتُ ثُمَّ رَفَعتُ مُتَّصِلاً","صَوتي أَوانَ المَنطِقِ الشَغبِ",44,"ب",1,0],["فَضَرَّجَها مِن نَجيعِ الدِماءِ","بَعدَ الهُدوءِ فَلَم يَحرَجِ",45,"ج",1,0],["فَضَلنا مُلوكَ الشامِ في كُلِّ مَشهَدٍ","لَنا الأَثرُ في المَرعى وَوِردٌ وَمَصدَرُ",46,"ر",1,0],["فضلٌ ظهر","ثمَّ انتشر",47,"ر",1,0],["فضلٌ أبرُّ فوفي الحمد غايته","وراحة فعلت كل الندى فعلت",48,"ت",1,0],["فضلت السعيد وأستاذه","بنظميهما وبنثريهما",49,"م",2,1],["فضلته بأوانينٍ ومعدلةٍ","زادت فكيف بتوحيدٍ وإيمانِ",50,"ن",1,0],["فضاعت ولكن على أوجهٍ","ثلاث لديَّ ومنِّي ومنْ",51,"ن",1,0],["فَضَلَ الرجالَ ذوي الكما","لِ كما اعتلى جبلٌ ظِرابَهْ",52,"ب",2,0],["فضيفُهُ في ربيعٍ طولَ مُدَّته","وجارهُ كلَّ حين منه في رجَبِ",53,"ب",1,0],["فضافاهما للمجد لا أن نفسهُ","إذا لم يَهزّاها لمجدٍ تُشاكسه",54,"س",2,0],["فضلْت أخاك الغيثَ بالعلم والحِجى","وحاصصْتَه في الجود أيّ حِصاص",55,"ص",1,0],["فُضِحتْ كتابتُكم وقُنِّع مجدُكم","خِزياً وأُسقط جاهُكم إسقاطا",56,"ط",2,0],["فُضِحتْ تلك البلاغا","تُ وهاتيكَ الخُطوطُ",57,"ط",1,0],["فَضَلنا بإيثارِ الجميلِ وفعلِه","ونحن سواءٌ والبهائم في الأكلِ",58,"ل",1,0],["فضمَّ إليه جأْشه ثم راعها","بشدةِ مكروهِ الفجاءة باسلِ",59,"ل",1,0],["فضلاً له بك يا ابنَ طاحنة الرَّحى","رَوْمي وبيتُك بالحضيضِ الأسفلِ",60,"ل",1,0],["فُضِّلَ حتى كان خالقَه","خَيَّرَه دون خَلْقه القسَما",61,"م",2,0],["فضلُ الرجالِ علينا أنَّ شيمتَهُمْ","جودٌ وبأْسٌ وأحلاٌم وأذهان",62,"ن",1,0],["فضلُك أو عدلك الذي ائتمن ال","له علينا أجلَّ مؤتَمن",63,"ن",1,0],["فضربتُ الزمانَ حتى استكانتْ","بِيضُهُ بعدما استطالتْ وجُونه",64,"ن",2,0],["فضلُ مجدِ الأمير في المجد يحكي","فضلَ ذاك البنيان في البنيان",65,"ن",1,0],["فَضَّلَ الراح أنها لذَّة المَش","رب عند الظمآن والريَّانِ",66,"ن",1,1],["فضلاً نعشْتَ به جدودَ معاشرٍ","وجنأتَ منه أجنَّةً وجنائنا",67,"ن",2,0],["فضلاً من اللَّهِ أعطاهُ وحرَّمهُ","على شَقيٍّ من الضُلّالِ شيعيِّ",68,"ي",1,0],["فَضَلنا الناسَ أَنَّ الجارَ فينا","يُجيرُ وَأَيُّ جارٍ يُستَجارُ",69,"ر",1,0],["فَضَحِكتُ مِن حِرصي عَلى مَلِكِ الصِبا","وَعَجِبتُ كَيفَ مَضى عَلَيهِ شَبابي",70,"ي",1,0],["فَضَرَّجَ خَدَّيها اِحمِرارٌ كَأَنَّما","تَصاعَدَ مِن قَلبي إِلى خَدِّها الوَجدُ",71,"د",1,0],["فَضَحِكتُ وَلَجَّ بِيَ الضِحكُ","حَتّى اِستَلقَيتُ عَلى ظَهري",72,"ي",1,0],["فَضَنَّ بِها وَالشَمسُ تَنثُرُ تِبرَها","وَفَضَّتَها وَالأَرضُ ضاحِكَةٌ جَذلى",73,"ل",2,0],["فَضاقَ فُؤادُهُ بَِلهَمِّ ذَرعاً","وَضاقَ بِهَمِّهِ وَبِهِ الظَلامُ",74,"م",1,0],["فَضاءَ مَن كانَ في الكَأسِ الَّتي اِرتَفَعَت","وَمَن يُريدُ وَيَعني القائِلُ العاني",75,"ن",2,0],["فَضَحَ الغَزالَةَ وَالغَزالَ فَتِلكَ في","وَسَطِ السَماءِ وَذاكَ في وَسَطِ الفَلا",76,"ل",2,0],["فَضَجَّ وَضَجَّت بِالبَراح كَأَنَّها","وَإِيّاه نوحٌ فَوقَ عَلياءَ ثُكَّلُ",77,"ل",1,0],["فضَاعَ التَّنَهُّدُ في الضَّجَّةِ","بما في ثَنَايَاهُ مِنْ لوْعةِ",78,"ه",1,0],["فِضِّيَّةِ الأَسْحارِ مُذْهبَةِ","الأَصائِلِ والبُكورْ",79,"ر",1,0],["فضل العاجل القريب على الآ","جل ان كنت حازنا ذا حصاة",80,"ه",1,0],["فضَّته تاليةً له حتى إذا","فرغت من التلوِّ صاحت تجزع",81,"ع",1,0],["فضاؤُك هل يصير إلى انتهاءٍ","أم الأبعاد ليس لها انتهاءُ",82,"ا",2,0],["فُضَّت ثُغورٌ وَخلت حَواضِرُ","وَأَمرَ الطاغي عَلَيها وَنَهى",83,"ا",1,0],["فَضاقَ مَروانُ بِهِ ذِراعا","وَاِنخرعت قُدرته اِنخِراعا",84,"ع",2,0],["فَضَحِكَ الحِصانُ مِن مَقالِهِ","وَقالَ بِالمَعهودِ مِن دلالِهِ",85,"ه",1,0],["فَضاقَ بِالذُيولِ صَحنُ الدار","مِن كُلِّ ذي صوفٍ وَذي مِنقارِ",86,"ر",1,0],["فَضَحِكَ الهِندِيُّ حَتّى اِستَلقى","وَقالَ ما هَذا العَمى يا حَمقى",87,"ق",2,0],["فُضّي بِتَقواكِ فاهاً كُلَّما ضَحِكَت","كَما يَفُضُّ أَذى الرَقشاءِ بِالثَرَمِ",88,"م",1,0],["فَضاءٌ مُثِّلَ الفِردَوسُ فيهِ","وَمَرأَىً في البِحارِ بِلا شَبيهِ",89,"ه",1,0],["فَضاقَت عَن سَفينِهِمُ البِحارُ","وَضاقَ البَرُّ عَنهُمُ واجِفينا",90,"ا",1,0