138748",""],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62960","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91157","الطويل"],[3760,"","https://poetry.dctabudhabi.ae/diwan/poem/143920","الوافر"],[3789,"","https://poetry.dctabudhabi.ae/diwan/poem/145255","السريع"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95322","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125828","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86375","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127321","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136645",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117270","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204236","الطويل"],[4679,"أما لأبي البرية أن يعادا","https://www.poetsgate.com/ViewPoem.aspx?id=142720",""],[4830,"حذار","https://www.poetsgate.com/ViewPoem.aspx?id=194147",""],[4852,"سكوتي احتراقي","https://www.poetsgate.com/ViewPoem.aspx?id=215465",""],[5002,"نقاط وحروف","https://www.poetsgate.com/ViewPoem.aspx?id=204115",""],[4119,"إذا ما زرت ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=16233",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5411,"وَحُبُّكَ موسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=186139",""],[470,"سلامٌ على بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=178093",""],[6093,"بوجه نَعُومٍ رأيت شروقاً ( المتقارب )","https://www.poetsgate.com/ViewPoem.aspx?id=176585",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""]],"verses":[["فَلَو نَزَعتَ الجِلدَ كا","نَ رَقمُها كَما رُقِم",0,"م",1,0],["فلَوْ ناوَلَ الأقْمارَ أطْرافَ ذِمّةٍ","إذاً لوَقاهُنَّ المَحاقَ ذِمامُهُ",1,"م",2,0],["فَلَو نَطَقَ الكِتابُ فَدَتكِ نَفسي","بَكى قَلَقاً ليَرحَمَني الكِتابُ",2,"ب",1,0],["فَلَو نُبِذوا بِأَبي ماعِزٍ","حَديدِ السِنانِ وَشاهي البَصَر",3,"ر",1,0],["فَلَو نَفسُهُ يُغري بِها شُؤمَ نَفسِهِ","لَأَقشَعَ إِظلامٌ وَأَعقَبَ نورُ",4,"ر",1,0],["فلو نَطقَ الدهرُ الذي ليسَ ناطقاً","تَنصَّلَ إذ هَزَّت يداه المَناصِلا",5,"ل",2,0],["فَلَو نَشَرَت قُواكَ لِيَ المَنايا","شَكَوتُ إِلَيكَ ما صَنَعَت إِلَيّا",6,"ي",2,0],["فَلَو نُبِشَ المَقابِرُ عَن كُلَيبٍ","فَيَعلَمَ بِالذَنائِبِ أَيُّ زيرِ",7,"ر",1,0],["فَلَو نُشِرَ الخَليلُ لَهُ لَعَفَّت","رَزاياهُ عَلى فِطَنِ الخَليلِ",8,"ل",1,0],["فَلَو نُبِشَ المَقابِرُ عَن زُهَيرٍ","لَصَرَّحَ بِالعَويلِ وَبِالنَحيبِ",9,"ب",1,0],["فَلَو نَطَقَت حَربٌ لَقالَت مُحِقَّةً","أَلا هَكَذا فَليَكسِبِ المَجدَ كاسِبُه",10,"ب",2,0],["فَلَو نالَتِ الكَفّانِ أَصحابَ نَوفَلٍ","بِمَهمَهَةٍ مِن بَينِ ظَرَّ فَعَرعَرا",11,"ر",2,0],["فَلَو نَبَّأَتني الطَيرُ أَو كُنتُ شاهِداً","لَآساكَ في البَلوى أَخٌ لَكَ ناصِرُ",12,"ر",1,0],["فلو ناقَةٌ عندَ ذاكَ انْثَنَتْ","لِتُرْوي فصِيلاً لَجَادَتْ بدَم",13,"م",1,0],["فلْو نُسِبَتْ يَمَنٌ كُلّها","إليكَ لقلْنَا لها لا جَرَم",13,"م",1,0],["فلو نَطَقَ الماءُ النّميرُ مُسَلِّماً","عليْهِنّ لم يَرْدُدْنَ رَجْعَ سَلامهِ",14,"م",2,0],["فلو نطقَ السَّفحُ الذي قُتلوا بهِ","إذنْ لبكَى من نَتْنِ قتلاهُمُ السَّفحُ",15,"ح",1,0],["فلو نبش المقابر عن كليب","فيخبر بالذنائب أي زير",16,"ر",1,0],["فَلَوْ نَالَتِ الكَفَّانِ أَصْحَابَ نَوْفَلٍ","بِمَهْمَهَةٍ مِنْ بَطْنِ ظَرءٍ فَعَرْعَرَا",17,"ر",2,0],["فَلَو نُقَضَت عَزائِمُهُ وَبادَت","سَلامَتُهُ لَكانَ كَما يُريدُ",18,"د",1,0],["فلو نظر الأملاك ختم إنائها","تخلّوا عن الأملاك طوعا ولا قهر",19,"ر",1,0],["فلو نُفخ الصورُ في عَصرِهِ","لأفلتَ حيّاً ولم يُصعقِ",20,"ق",1,0],["فلو نُظِمت قَلائدَ للغواني","لَماَ رَضِيتْ عن الدُّرِّ الرقاب",21,"ب",1,0],["فلو نَوى حلقَ رأسٍ في ضَمائِره","بفطنةٍ كاد منه المخ ينتثر",22,"ر",1,0],["فَلَو نظرَ العنّين فيهنّ نظرةً","لَما اِحتاجَ في تَقويمِ قوّتهِ أخرى",23,"ر",2,0],["فلو نطقتْ لنا المرآةُ عنها","إذاً قالتْ تباركَ ذو الجلالِ",24,"ل",1,0],["فلونُه في لونها ظاهِرٌ","ورِيقُه في طعمها جامِدُ",25,"د",1,0],["فَلو نَصَبوا جَهبَذاً ما اِرتَضى","بِما تَرتَضيهِ لَكَ الجَهبَذُ",26,"ذ",1,0],["فلو نظر ابنُ العبد طرفةُ سمتَه","لقال له بين الورى أنت سيّدي",27,"د",2,0],["فَلَو نَظَرَت وَجنَتَيهِ المَجوسُ","تَعالى الإِلَهُ اِدَّعَتهُ إِلَها",28,"ا",1,0],["فَلَو نازَعَتهُم نُجومُ السَماءِ","لَما فاتَ عَزمَهُمُ شِعرَياها",28,"ا",3,0],["فلو نطقت بها غيدا","رداح نضة الثغر",29,"ر",1,0],["فَلو نطَقت قالت زفافي لبابه","كَمُستبضع تمراً إلى هجر يسبى",30,"ب",2,0],["فَلَو نِلتُ ما يُغني بِكَ اليَوم أَو غَداً","أَنَلتُكَ ما يَبقى إِلى آخرِ الدَهرِ",31,"ر",1,0],["فَلَوْ نُمِى لِلجَزَّارِ أَمْرُهُما","صِرْنا لِوالي البِلادِ والقاضِي",32,"ي",1,0],["فلو نيطَ أيضاً بالبسيطةِ مثْلُها","وقيل له احكُمْ في الجميعِ وأحْكِم",33,"م",1,0],["فلو نَطَق الوحشُ قالتْ لهُ","وقد صدَقَتْ فلَهُنَّ الحُرَم",34,"م",1,0],["فلو نقِضَتْ يوماً وأُحدِثَ نَصبْهُا","وما في صنيع اللهِ ذلك عاب",35,"ب",1,0],["فَلَو نَطَقَ الزَمانُ لَقالَ فينا","كَم أَرسَلَنا إِلَيهِم مِن نُذيرِ",36,"ر",1,0],["فلو نظرت عينه مهجتي","ونار الغرام عليها تشب",37,"ب",1,0],["فلو نجازيك عن معشار قيمتها","جوزيت إذ ذاكَ بالدُّنيا وما فيها",38,"ي",3,0],["فلو نظمت الثريا","والشعريينِ قريضا",39,"ض",2,1],["فَلَوْ نَظَرتُ لِصَخرٍ بالمياهِ جَرى","ولو نَظَرْتُ لِجَمرٍ سالَ بالبَلَلِ",40,"ل",1,0],["فلو نهيتُ الدّمعَ عن سَحِّهِ","والدّار وحشٌ لم تُطِعْ أمري",41,"ر",2,0],["فَلَو نَفَعَت عِندَ المَنونِ شَفاعَةً","كَفَتهُ فَريداتُ الخِصالِ مُشَفَّعا",42,"ع",2,0],["فَلو نَفلثتُ بألفاظي علََى حَجرٍ","صَلدٍ تَفَجَّرَ ماءً ذلِك الحَجَرُ",43,"ر",1,0],["فلو نَسطيعُ طِرنا أو رَكبنا","إليكَ الرّيحَ مَرّا واندِلاجا",44,"ج",2,0],["فلو نزعت عنها القيود لصفقت","بأجنحة نحو السعادة تهرع",45,"ع",1,0],["فَلَو نَقِدَت خَلائِقُهُ","تَبَهرَجَ عِندَها الذَهَبُ",46,"ب",1,0],["فلو نظرت عيناكَ في اللَّيلِ حالتي","وقد هزَّني شوقٌ وقلقلني فِكرُ",47,"ر",1,0],["فَلَو نَظَرَ الرّاؤونَ حُسنَ بَلاطِهِ","لَقالوا يَقيناً ها هُنا الأَنجُمُ الزُّهرُ",48,"ر",1,0],["فلو نبيٌّ يُرْى بعدْ النبي نها","لقيل هذا النبيُّ المرسلُ الثاني",49,"ن",2,0],["فلوّنوهُ كما شئتمْ ملائكةً","ولوّنوهُ كما شئتمْ شياطينا",50,"ن",2,0],["فلو نشرت طي طوت شعرائها","برؤيتها واستصحبت ألسنا خرسا",51,"س",2,0],["فَلَو نَزَعت نَفسي عَلَيها مَحَبة","لَما كُنتُ يَوماً عَن سَليبي لأَنزعا",52,"ع",2,0],["فلو نالوا من العياء قسطاً","لما ملأوا الملا حرباً وكربَا",53,"ب",2,0],["فلو نُبشَ المقابرُ عن عُميرٍ","فيُخبَرَ عن بلاءِ أبي الهُذَيل",54,"ل",1,1],["فَلَو نَبَّأَتكَ الأَرضُ أَو لَو سَمِعتَهُ","لَأَيقَنتَ أَنّي كِدتُ بَعدَكَ أَكمَدُ",55,"د",1,0],["فَلَو نالَ الخُلودَ فَتىً بِجُودٍ","وَمَعرُوفٍ لحَقَّ لَكَ الخُلودُ",56,"د",1,0],["فلو نطقت أرض شكت من سمائها","وحتى سهول الأرض تشكو جبالها",57,"ل",3,0],["فَلَو نَظرَةٌ تُهدَى تُقِرُّ عُيُونَنَا","وَتَمحُو لِما قَد كانَ فِى اليَومِ أو غَدَا",58,"د",2,0],["فَلَو نُشِرَت أَيّامُ كِسرى وَتبَّعٍ","وَأَيّامُ هرونَ الرَشيدِ وَنائِلُه",59,"ل",2,0],["فلو نحوت هرقلا في عساكره","لما رأى عدة أنجى من الهرب",60,"ب",1,0],["فلو نجوتم من البحر الخضمّ لما","نجوتمُ من توالي سيله العَرم",61,"م",1,0],["فلو نفى الرتبةَ لم يتخذ","خليفةً في عالم السفلِ",62,"ل",1,0],["فلو نفث السحر من طرفه","لما زاد هاروت إلا رهق",63,"ق",1,0],["فَلَو نُسِبَت مُرهَفاتُ السُّيوفِ","إِلى لُؤم أَصلِكَ لَم تُقطَعِ",64,"ع",1,0],["فلو نُشِرَ الصادان من لحديهما","لإنصافِ هذا الدَّينِ لاذا بإملاق",65,"ق",1,0],["فلو نُشِرَ الصَّادانِ مِن مَضجَعَيهِمَا","ليومِ رهانٍ لم يشقَّا غُبَاركَا",66,"ك",2,0],["فَلو نَرى المَوت يَرضى مِنكُم بِفِدا","جئناكُم مِن صَفايانا بِألف فَدا",67,"د",2,0],["فَلَو نالَ حَظّاً مِنهُ غَيلانُ لالتَقَت","لَهُ صَيدَحٌ فيهِ وَمَيُّ وَدَهناءُ",68,"ا",2,0],["فَلَونٌ لَها لَونُ البَياضِ وَصُفرَةٍ","كَما مَزَجَت بِالماءِ كَأسَ عُقارِ",69,"ر",1,0],["فَلَو نَطَقَت ما كانَ أَكثَرَ نُطِقها","سِوى قَولها أَينَ الخَليطُ المُعاشِرُ",70,"ر",1,0],["فَلَو نالَ يوما أَبوك الغنى","كَساكِ الدَّبيقيّ وَالتُّستري",71,"ر",2,0],["فَلَو نَطَقَت قَالَت أَلاَ يا مُصَنِّفِي","بَلَغتَ المُنَى يا ابنَ الجُدُودِ الأطايِبِ",72,"ب",1,0],["فلو نصبوا لآداب قضاةً","إذن طالبتُ تعويضاً لخسري",73,"ر",2,0],["فَلَو نَظَروا في مصر أَوصاف خَده","لَما نَظَروا يَوماً إِلى حمرة الوَرد",74,"د",1,1],["فلو نادى بدولته الليالي","أتتْ وخُطا حوادثها قِصار",75,"ر",1,0],["فلو نطق الطروس لفضلته","وقالت أجود الكتاب خطا",76,"ط",2,0],["فلو نام قلبي حينا لكان استراح","من اليتم مما سجر",77,"ر",1,0],["فلو نظرت عيناك حالي وحاله","لشاهدت نارا عندها جنة المأوى",78,"و",2,0],["فلو نادتهم كل الأشياء بصوتها","لما التفتوا إليها بأدنى لمحة",79,"ه",1,0],["فلونُ عقودكِ لونُ النجومِ","ولونُ ثيابِكِ لونُ السَّمَاءِ",80,"ا",2,0],["فَلو نَطقت تلكَ الليالي بِما جَرى","كَفتنا مقال السوء أَو لَوم لائم",81,"م",1,0],["فلو نقدت خلائقه","لبهرج عندها الذهب",82,"ب",1,0],["فلو نقصتم منكم واحداً","لزدت في مجلسكم واحده",83,"ه",1,0],["فَلو نَتَجَت أمُّ السَّماء صَواعِقاً","لما شَجَّ منها سارِحٌ رأسَ حاسِر",84,"ر",1,0],["فلونُ الدماءِ ولونُ الحريق","كلونِ مبادئهم أحمر",85,"ر",1,0],["فلو نزلوا من صلب قرد كما ادعوا","لأورثهم يوماً فكاهته القرد",86,"د",1,0],["فلو نزعت لحاظك عن قسي","لما حملت سواهن الرماة",87,"ه",1,0],["فلون لماه يحكي اللون منها","وشبه الشيء منجذب اليه",88,"ه",1,0],["فلو نفعَ الأنينُ جريحَ وجدٍ","مَلأت الخافقينَ لهم أنينا",89,"ن",2,0],["فلو نزعت نحو الحبيب بقصدها","وساعدها الإسعاف عند نزوعها",90,"ع",3,0],["فَلَو نَقَطَ الخَطّاطُ حَرفاً لِهَيكَلي","عَلى سَطحِ لَوحٍ ما رَآهُ مُطالِعُ",91,"ع",1,0],["فلو نطقت أيامنا باعتقادها","لناجتك لفظاً بالدعاء وبالشكر",92,"ر",1,0],["فلو نظر الأوائل ما أتاه","أفاضل عصرنا فقدوا الرشادا",93,"د",2,0],["فلو نسيَ الجبانَ الموتُ دهرا","لما عَشِقتْ أناملُه الحِرابا",94,"ب",2,0],["فلو نادى \"دعائي\" أو\"عيونو\"","يلومون استكاني في يديهِ",95,"ي",2,0],["فَلوِّنْ أمَانيْنا وقلْبٌ وتينهُ","تَرِقُّ له الأطيارُ لو راحَ شَادي",96,"ي",1,0],["فلو نظهر وسم الحب","أبصرت له كيا",97,"ي",2,0],["فلو نال ما قد حاز قارون واحتوى","عليه فمال نفعه غير طائل",98,"ل",1,0],["فلو نذر الإنسان في قول من ترى","زيارة قبرٍ أي قبرٍ مع الشد",99,"د",1,0],["فلو نفضا يوم العطا ترب الثرى","لصار الثرى أغلا من التبر بالنفض",100,"ض",1,0],["فلَوّنْ بِذاكَ الأقْحوان مَدائِني","فَعَيْني بأطْيافِ البَنَفْسَج تُسْحَرُ",101,"ر",1,0],["فلو نسمةٌ طافتْ عليها بغيرِ ما","تُراحُ به، أدمى فؤادي طوافُها",102,"ف",3,0],["فلونُ الخدود كشمسٍ بدتْ","وفوقَ الخدود كلونِ الشَّفقْ",103,"ق",1,0],["فلو نظرت ضحى نحو الرياض وما","فيها من الحسن مبثوثا ومسكوبا",104,"ب",2,0]]}