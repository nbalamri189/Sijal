{"poems":[[55,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[32,"ألا يا دار مية بالوحيد","https://www.aldiwan.net/poem29597.html","الوافر"],[46,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[48,"كن صاحب الخير تنويه وتفعله","https://www.aldiwan.net/poem23091.html","البسيط"],[189,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[471,"يقول خليلي باللوى من حفارة","https://www.aldiwan.net/poem50474.html","الطويل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96455","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118338","الكامل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102194","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145067","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205604","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44723","الطويل"],[5187,"حواء وتجربتي","https://www.poetsgate.com/ViewPoem.aspx?id=29256",""],[5431,"كن صديقي...","https://www.poetsgate.com/ViewPoem.aspx?id=200252",""],[5550,"أنت بحر","https://www.poetsgate.com/ViewPoem.aspx?id=211903",""],[5628,"حديث مع الطير","https://www.poetsgate.com/ViewPoem.aspx?id=178516",""],[5704,"قُمْ خليلي ...","https://www.poetsgate.com/ViewPoem.aspx?id=198798",""],[5853,"لا تشتكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175626",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[5977,"همة","https://www.poetsgate.com/ViewPoem.aspx?id=212725",""],[6046,"حدود... بلا حدود!","https://www.poetsgate.com/ViewPoem.aspx?id=37247",""],[6070,"كنْ صابراً في كلِّ هَمٍ أو وجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=197529",""],[6131,"روحي رهينةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189335",""]],"verses":[["كَنَصلِ اليَمانِيِّ أَبلى القِرابَ","وَما أَضمَرَ الغِمدُ مِنهُ كَهاما",0,"م",2,0],["كَنَصلِ السَيفِ تَسلَمُ شَفرَتاهُ","وَيُخلِقُ كُلَّ أَيّامٍ قِرابا",1,"ب",2,0],["كَنَصلِ السَيفِ أَخلَصَهُ صِقالٌ","وَلَم يَعلَق بِهِ طَبَعُ الحَديدِ",2,"د",1,0],["كَنَصلِ السَيفِ عُرِّيَ مِن كِساهُ","وَفَلَّت مِن مَضارِبِهِ الخُطوبُ",3,"ب",1,0],["كُن صاحِبَ الخَيرِ تَنويهِ وَتَفعَلُهُ","مَعَ الأَنامِ عَلى أَن لايَدينوكا",4,"ك",2,1],["كنصرِ أبيك في يومَىْ حُنينٍ","وبَدْرٍ عند مُعْتَرك الحِمام",5,"م",1,0],["كَنَصلِ اليَمانِي لَم تُغَلَّل مَضارِبُه","كَأَنَّ عَلى أَعطافِهِ لَونُ مُذهَبٍ",6,"ه",2,0],["كَنَصر مُحَمَّدٍ فِى يَومِ بَدرٍ","وَيَومِ الشِّعبِ إِذ لاَقَى حُنَينَا",7,"ن",2,0],["كن صابرا او جازعا او الهوى","باد عليك صبرت ام لم تصبر",8,"ر",1,0],["كن صبوراً ولا تعض بنانا","ليس يجدي المصاب عض البنان",9,"ن",1,1],["كن صابر لجفاء الناس أو قلقا","لا يعطف الناس لا صبر ولا قلق",10,"ق",1,0],["كن صانعًا أو لا فلست بصانع","شيئًا ولست بدافع من يعتدي",11,"ي",1,0],["كَنَصر الَّذي قَد كانَ بِالأَمس بَينَنا","مِثالٌ كَمالٌ ذاعَ بَينَ الوَرى جَهرا",12,"ر",2,0],["كُنْ صادقاً في سَبْرِ عالمِها","قُلْ مُبتغاكَ بِأبسطِ الأطرِ",13,"ر",1,0],["كن صديقي فهالة الحبّ تخبو","إنما الودّ دائم التحليقِ",14,"ق",1,0],["كن صديقي وحرر الخيل تعدو","صاهلاتٍ بكل فجٍ عميقِ",14,"ق",1,0],["كن صديقي على الدوام أنيقا","أجمل اللفظ صادحا (ياصديقي)",14,"ق",2,0],["كُنْ صَباحًا يزيحُ عَنِّي ظلامي","فَطُيوري اشْتَاقتْ إلى التغريد",15,"د",1,0],["كنْ صاحبي يا طيرُ في سَفَري","بُحْ لي بما قدْ ضمّهُ الصْدرُ",16,"ر",1,0],["كن صبورا صابرًا كي ترتدي","حلةً .. تكسوك من أبهى الحللْ",17,"ل",1,0],["كن صامتا وتأّملِ الآتي إذا","هبّ الأثير بنسمةٍ وبهاا نطلقْ",18,"ق",1,0],["كنص قصيدة في الحسن مبهَمْ","وجدت لماكِ لا ضوءًا ولا دَمْ",19,"م",1,1],["كن صبوراً يا عزيزي واثقاً","هذه العتمة عنوان الصباح",20,"ح",1,0],["كنْ صاحِبَ النَّظرِ القصير، وضيِّقاً","في الأُفْقِ، واخضعْ للمَصِيرِ الأَسْوَدِ",21,"د",1,0],["كنْ صابراً في كلِّ هَمٍ أو وجعْ","مهما تضقْ ليلاً بصبحٍ تتسعْ",22,"ع",1,1],["كنْ صوتَيَ الآتيْ معَ","الأنهارِ ، وَ اسْكبْ ليْ سكونَكْ",23,"ك",1,0]]}