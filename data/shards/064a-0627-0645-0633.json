,""],[5848,"يا مسافر للجفا","https://www.poetsgate.com/ViewPoem.aspx?id=49227",""],[5953,"يا مسبت السبت ومجمع الجمعة","https://www.poetsgate.com/ViewPoem.aspx?id=93832",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6032,"ما على الدهر عتب","https://www.poetsgate.com/ViewPoem.aspx?id=181506",""],[6038,"علامك غيوبي","https://www.poetsgate.com/ViewPoem.aspx?id=25686",""],[6069,"يا مسعراً بالعذل أثناء الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=105682",""],[6078,"في غربةِ القمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=202773",""],[6083,"لابسات المساء","https://www.poetsgate.com/ViewPoem.aspx?id=151966",""],[6125,"من ذا لأمةِ أحمدٍ فوق الثرى","https://www.poetsgate.com/ViewPoem.aspx?id=210969",""],[6142,"لا عذر للعين إن لم تنفجر علقا","https://www.poetsgate.com/ViewPoem.aspx?id=155754",""],[6144,"باريس خلاص","https://www.poetsgate.com/ViewPoem.aspx?id=21847",""],[6144,"الورد","https://www.poetsgate.com/ViewPoem.aspx?id=13695",""],[520,"الناس في بلوى وفي بلبال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577624",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""]],"verses":[["يا مَسقِطَ العَلَمَينِ مِن رَملِ الحِمى","لي عِندَ ظَبيَتِكَ النَوارِ دُيونِ",0,"ن",1,1],["يا مَسرَحَ الآرامِ في وادي الحِمى","هَل فيكَ ذو شَجَنٍ يَروحُ وَيَغتَدي",1,"د",2,0],["يا مُستَقِلَّ كَثيرِنا يَسِّر لَنا","مِنكَ القَليلَ فَما نَراهُ قَليلا",2,"ل",2,0],["يا مُسْتَهينَ الخطْبِ لمّا أعْضَلَتْ","أدْواؤهُ وتكالَبَتْ أشْرارُهُ",3,"ر",2,0],["يا مُسْنِدَ السّعْدِ والنّصْرِ العَزيز الى","سَعْدٍ لنَصْرٍ الى خَيْرِ البَرِيّاتِ",4,"ت",1,0],["يا مُستَخِفّاً بِعاشِقيهِ","وَمُستَغِشّاً لِناصِحيهِ",5,"ي",2,1],["يَا مُسْرِفاً فِي لَهْوِهِ","وَمُذْهَباً فِي العَجَبْ",6,"ب",1,1],["يَا مُسْهِدَ القَوْمِ أَطَلْتَ السِّنَهْ","مَا الدَّهْرُ إِلاَّ بَعْضُ هَذِي السَّنَهْ",7,"ن",2,1],["يا مسلياً ذا الشيب عن شبابه","بأن وخط الشيب أزهار النهى",8,"ا",1,0],["يا مُستَجيرَ مُجاشِعٍ يَخشى الرَدى","لا تَأمَنَنَّ مُجاشِعاً بِأَمانِ",9,"ن",1,0],["يا مَسلَمَ المُتَضَيِّفونَ إِلَيكُمُ","أَهلَ الرَجاءِ طَلَبتُ وَالتَكريمِ",10,"م",1,0],["يا مَسْلَم بن أبي الوليد","لميَّتٍ إن شئت ناشر",11,"ر",1,0],["يا مسدِي النعمى التي قد أصبحت","سنداً لمن يشكو الزمان ومسندا",12,"د",2,0],["يا مسلمونَ انفروا جميعاً","إليه أوْ اِنْفروا ثُباتِ",13,"ت",1,0],["يا مُستقرَّ العار والنقصِ","أغنتْ مخازيك عن الفحصِ",14,"ص",1,1],["يا مستحلَّ دمي مُحَرِّم رَحْمتي","ما أنصفَ التحليل والتحريم",15,"م",1,0],["يا مَسرَحَ العُشّاقِ كَم","لي فيكَ مِن يَومٍ مَطيرِ",16,"ر",1,0],["يا مُستَرِقّاً بِنُعما","هُ كُلَّ حُرٍّ سَريِّ",17,"ي",1,0],["يا مُسرِفاً في التيهِ ما يَنتَهي","أَخافُ أَن يَفنى عَلَينا الزَمان",18,"ن",1,0],["يا مُستَرِدّاً قَليلَ نائِلِهِ","أَكُلُّ هَذا حِرصاً عَلى العَشرَه",19,"ر",2,1],["يا مسرحاً والفصول تترى","عليه ما لي بك اغترار",20,"ر",1,0],["يا مُسْدياً من نداهُ كلّ مَكرُمَةٍ","ومجرياً في مداه شُزّبَ الحُصُنِ",21,"ن",1,0],["يا مُستَجمَ «النُّوُاسيِّ» الذي لبِستْ","به الحضارةُ ثوباً وشيَ «هارون»",22,"ن",1,0],["يا مسعرَ النار كَيفَ أَطفئها","سامَحَكَ اللَه حينَ تسعرها",23,"ر",3,0],["يا مِسكَةَ العَطّارِ","وَخالَ وَجهِ النَهارِ",24,"ر",1,1],["يَا مَسْقِطاً لِلرَّأْسِ فِي جَنَبَاتِهِ","مِنْ حَرِّ شَوْقِي جَمْرَةٌ لَمْ تَخْمُدِ",25,"د",1,0],["يا مُسديَ اليد، لا يرمي إلى غرضٍ","وكاشفَ الضُّرِّ، لا يسعى إلى أرَب",26,"ب",1,0],["يامسفرني لوجهك ذهاب بلا اياب","يامعزز بالغلا يامقدر يامحسوب",27,"ب",1,0],["يا مسبل الستر على خلقه","وكاشفا غم الضعيف الحزين",28,"ن",1,0],["يا مسيكين انت طورا عجوز","وكما انت عاجز ذو خيال",29,"ل",1,0],["يا مستريحا بالتجافي ربما","بما جناه المستريح يتعب",30,"ب",1,0],["يا مُسمِعي فِقراً تَفضيلُها لَزَمٌ","وَموسِعي مِنَناً تَفصيلُها جُمَلُ",31,"ل",1,0],["يا مُسْقِماً بِالْبَذْلِ صِحَّةَ مَالِهِ","فِينا وَهادِمَهُ بِما يَبْنِينا",32,"ن",2,0],["يا مستعينا على جرمي بفضل يدي","ما أنت بالنفخ ملق قلة الجبل",33,"ل",1,0],["يا مُسقْنِي غُصَصَ الغرامِ بصَدِّه","لما تأهب للمسير وَودَّعا",34,"ع",2,0],["يا مُسقِمِى بجفونٍ تَدَّعى سَقَما","لا أَدَّعى مثَلها زُورا وبهتانا",35,"ن",2,0],["يا مسكنَ الشُّهبِ الزهراء كم عجبٍ","بمعدنِ الدررِ الغرَّا وأسرارِ",36,"ر",1,0],["يا مستعِدُّون للفَخارِ بنا","ومَنْ بنا أدرَكوا الذي سألوا",37,"ل",3,0],["يا مُستريحاً لم أنل","من حُبِّه إلا التَّعَب",38,"ب",1,0],["يا مُسقمي مهلاً على جسدي الذي","لم يَبقَ فيه للسقَّام مكانُ",39,"ن",1,0],["يا مسلمون كفى نوماً …كفى دعةً","مسرى نبيكم طالت مراثيه",40,"ي",2,0],["يا مُسلمينَ تَقَطَّعت أوصالكم","ونِصالكم قد بكّها المِرجام",41,"م",1,0],["يأمس للخليج رأيت يوما","علا قدراً على اليوم السعيد",42,"د",1,0],["يا مسجداً زان البلاد بحسنه","وتباشرت بمشيده العباد",43,"د",1,0],["يا مستعيناً جل في شرف","عن رتبة المنصور والمهدي",44,"د",2,0],["يا مسعدي في شقوتي ومعذبي","في لذتي ساع السنون وقريبا",45,"ب",2,0],["يا مُسبلَ الستر يا رَبَّ العِبادِ وَيا","مَن جوده الجود وَالإِحسان ما يهبُ",46,"ب",1,0],["يا مُسيءَ الظُنونِ بِالدَهرِ يَأَتي","نُجحُهُ فيكَ قَبلَ وَعدٍ نَكيرِ",47,"ر",1,0],["يا مُستَغاثَ النَّاسِ في يَومِ الوَغى","ما بالُ مالِكَ يَستَغيثُ من الثَّنا",48,"ن",2,0],["يا مُستَمداً من مَنا","قِبهِ يُسَطُّرُها سُطورا",49,"ر",2,0],["يا مسكن اللَه العلي وعرشه ال","سامي الذي قد شاء فيه يمكث",50,"ث",1,1],["يا مسجدَ الأقصى, أراكَ على","هامِ السَّحاب، وأنتَ في القُدْسِ",51,"س",1,0],["يا مسجدَ الأقصى أراكَ على","وَجْهِ الحقيقةِ دونما لَبْسِ",51,"س",1,0],["يا مسجدَ الإسراءِ يا شَفَةً","تدعو إلى صلواتنا الخمسِ",51,"س",1,0],["يا مسرعون إلى الفتاوى, هوّنو","فلربَّ فتوى أهلكت من قالها",52,"ل",3,0],["يا مسقمي من طَرفِهِ بِسِقامِهِ","رِفقاً بِقَلبي قَد أَطَلتَ هُيامي",53,"م",2,0],["يا مُستَقِلَّ الغِنَى فيما تجودُ بهِ","ومَن مواهِبُهُ كالعَارِض الهَطِلِ",54,"ل",1,1],["يا مسرح من وادي الحمى","هل عودة يا مسرح الآرام",55,"م",1,0],["يا مُسقطَ العلمينِ هل من مُخبرٍ","عن مستقرّي زينب وسعادِ",56,"د",1,0],["يا مسعد الدهر في ظلمي أما عجب","إن جت عدلا وجئت اليوم عدوانا",57,"ن",2,0],["يا مستجيباً دعوة المض","طر والواهي المصاب",58,"ب",1,0],["يا مستلذ الظما في كل هاجرة","صوما وملتذ من طاعاتك السهرا",59,"ر",2,0],["يا مسقط الرأس العزي","ز ودرة الحسن اليتيمة",60,"م",2,0],["يا مستعزا بالنجوم","تبسمت لمن ابتسم",61,"م",1,0],["يا مستضيمَ الملك أينَ الحامي","ياجدبُ ما فعلَ السحابُ الهامي",62,"م",2,1],["يا مسلفي تبرُّعاً من ودِّه","سلافةَ الخمرِ ووسمِيَّ المطَرْ",63,"ر",1,0],["يا مِسكَةَ العُشّاقِ مِسكُ الدُجى","قَد رُدَّ في نافِجَةِ الغَربِ",64,"ب",1,1],["يا مُسقِمي بِجُفونِ سَقمها سَبَب","إِلى مُواصَلَةِ الأَسقامِ في جَسَدي",65,"د",2,1],["يا مُسْدِلَ البُرْدِ في مجْلى جَلالَتِهِ","عنهُ حِجاباً ولم تُكْشَفْ حَواشيها",66,"ي",3,0],["يا مُسَيْكِينُ هل عَلِمْتَ يَقيناً","ما طَواهُ الخَلاَّقُ في المَخلوُق",67,"ق",1,0],["يا مسبل الأستار دون جلاله","ماذا الذي رفعت له الأستار",68,"ر",1,0],["يا مسلمين ويا نصارى انظروا","كتابنا وكفاة بيت المال",69,"ل",1,0],["يا مسبل الستر لا تكشفه عن رجل","لا يلتجي أبداً إلا إلى كرمك",70,"ك",1,1],["يا مستبيحين أعراضاً محرمةً","بسوء ظن وتلبيس وتمويه",71,"ي",2,0],["يا مُسعِفاً دهري عليَّ بهَجْرِهِ","لا تُسعِفِ البازي على خُفّاشِهِ",72,"ش",2,0],["يَا مُسْدِيَ العُرْفِ إسْرَارَاً وَإِعْلاَنَا","وَمُتْبِعَ البِرِّ وَالإِحْسَانِ إِحْسَانَا",73,"ن",2,1],["يا مُسْهِرِي بِشكرِه","وجودُه مُنيمِي",74,"م",2,0],["يا مُسْقِمِي بِلَواحِظٍ","أَهْدَتْ إِليّ سَقَامَها",75,"م",3,0],["يا مُسْعِدي في حَمْل أَثْقَالِ الهَوَى","مُتَجَمِّلاً تَبْغي مَعُونةَ حَمْلِهِ",76,"ل",2,0],["يا مُسكِناً حَرَكاتِ فيَّ","وَنُطقَهُ بِسُكُونِ فيكا",77,"ك",2,1],["يا مُستَعيضَ الغَيرَ بي","قَد استَعَضتُ اللهَ فيكا",77,"ك",2,0],["يا مُستَشاراً يوم أعوز الورى","فيه حصيف الرأي مستشاره",78,"ر",2,0],["يا مستجيدَ الحليِّ حلِّ أبا","يعقوبَ منه بالأخلصِ الأخلص",79,"ص",1,0],["يا مستجيب ادعايه","أرجو منك السماح",80,"ح",1,0],["يا مسمّر العكايف","رحّبت بك حييت",81,"ت",1,1],["يا مُسرعُ السَيرِ إِبطيه","وَامشي خَطاوى خَطاوى",82,"ا",3,0],["يا مسعر وجدي من داوى","داءً في أحشاك استعرا",83,"ر",2,0],["يا مسراتٍ علينا وردت","بلقاه وعدكِ اليومَ نجحْ",84,"ح",1,0],["يا مسيحا يُكَلِّمُ النَّاسَ طِفْلا","ضَلَّ في شَأنِه أخو اللُّبِّ لُبَّا",85,"ب",2,0],["يا مسعفي إني وهذي الهموم","سميرتي مالي وللفرقدِ",86,"د",1,0],["يا مسعفي كن ذلك الآسي","وارفق بأحلامي وإحساسي",86,"ي",1,0],["يا مُسْكِنَ المُتَجَبِّرينَ بسَيْفِهِ","دُورَ الهَوانِ وجابِرَ 