{"poems":[[53,"يا مسقط العلمين من رمل الحمى","https://www.aldiwan.net/poem29736.html","الكامل"],[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[55,"أمسى بكاك على هواك دليلا","https://www.aldiwan.net/poem26144.html","الكامل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"يا واحد الدهر في خلق وفي خلق","https://www.aldiwan.net/poem36698.html","البسيط"],[73,"يا مستخفا بعاشقيه","https://www.aldiwan.net/poem11866.html","مجزوء البسيط"],[93,"يا مسرفا في لهوه","https://www.aldiwan.net/poem9795.html","عموديه"],[93,"يا مسهد القوم أطلت السنه","https://www.aldiwan.net/poem11117.html","السريع"],[88,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[37,"قف بالديار وقوف زائر","https://www.aldiwan.net/poem7174.html","مجزوء الكامل"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[51,"إلف لنا بارع الصفات غراب بين المغنيات","https://www.aldiwan.net/poem8702.html","مخلع البسيط"],[51,"يا مستقر العار والنقص","https://www.aldiwan.net/poem64934.html","البسيط"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[78,"خلعت ثوب الصفي","https://www.aldiwan.net/poem14068.html","المجتث"],[85,"أذعن للحسن عصي العنان","https://www.aldiwan.net/poem63009.html","السريع"],[45,"يا مستردا قليل نائله","https://www.aldiwan.net/poem63586.html","المنسرح"],[97,"كل الورى يدعون حبك","https://www.aldiwan.net/poem25066.html","مجزوء البسيط"],[80,"لا ذنب للطرف في معداه يوم كبا","https://www.aldiwan.net/poem31260.html","البسيط"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[102,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[52,"يا مسكة العطار","https://www.aldiwan.net/poem26955.html","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54721","الكامل"],[106,"أبو الشعراء!","https://www.poetsgate.com/ViewPoem.aspx?id=179680",""],[113,"يا ربنا يا ارحم الراحمين","https://www.aldiwan.net/poem40450.html","عموديه"],[113,"قل لشيخ يؤذي النبي عناداً","https://www.aldiwan.net/poem40846.html","عموديه"],[113,"متى خيام من احب تقرب","https://www.aldiwan.net/poem41253.html","عموديه"],[141,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[153,"لمن الرسوم برامتين بلينا","https://www.aldiwan.net/poem55540.html","الكامل"],[158,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[183,"يا بدر تم بالجمال تبرقعا","https://www.aldiwan.net/poem14587.html","الكامل"],[183,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[197,"على السماء وفوق الشمس أشعاري","https://www.aldiwan.net/poem45351.html","البسيط"],[227,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[248,"يا هاجري بلا سبب","https://www.aldiwan.net/poem14924.html","مجزوء الرجز"],[248,"سر القلوب تذيعه الأجفان","https://www.aldiwan.net/poem15045.html","الكامل"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[283,"أمصر طربت لكن ليس هذا","https://www.aldiwan.net/poem39414.html","الوافر"],[283,"وجب الثناء على جماعة جادو","https://www.aldiwan.net/poem39417.html","الكامل"],[308,"قدحت يد الأشواق من زندي","https://www.aldiwan.net/poem59518.html","أحذ الكامل"],[340,"قلبي المعنى لم أراك طروبا","https://www.aldiwan.net/poem55359.html","الكامل"],[351,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[364,"يا شجاع بن شاور بن مجير","https://www.aldiwan.net/poem17210.html","الخفيف"],[369,"طال الزمان وما ثناه ولا انثنى","https://www.aldiwan.net/poem57023.html","الكامل"],[369,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[374,"يا مسكن الله العلي وعرشه","https://www.aldiwan.net/poem66894.html","الكامل"],[397,"يا مسجد الإسراء","https://www.aldiwan.net/poem6713.html","عموديه"],[397,"تشكو الفتاوى","https://www.aldiwan.net/poem6741.html","عموديه"],[403,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[406,"يا مستقل الغنى فيما تجود به","https://www.aldiwan.net/poem32209.html","البسيط"],[413,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[429,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[434,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[438,"هل لي إلى عصر الشباب","https://www.aldiwan.net/poem14350.html","مجزوء الكامل"],[438,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[441,"قف بالديار وحيها","https://www.aldiwan.net/poem56021.html","عموديه"],[451,"حييت يا يوم العلم","https://www.aldiwan.net/poem61271.html","مجزوء الكامل"],[456,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[466,"يا مسكة العشاق مسك الدجى","https://www.aldiwan.net/poem60431.html","السريع"],[491,"يا مسقمي بجفون سقمها سبب","https://www.aldiwan.net/poem67386.html","البسيط"],[498,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[498,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[513,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[513,"الناس في بلوى وفي بلبال","https://www.aldiwan.net/poem12228.html","الكامل"],[513,"يا مسبل الستر لا تكشفه عن رجل","https://www.aldiwan.net/poem12258.html","البسيط"],[556,"يا من تكلم فينا بالذي فيه","https://www.aldiwan.net/poem33664.html","البسيط"],[560,"نزع القريض إلى حمى نقاشه","https://www.aldiwan.net/poem52908.html","الكامل"],[565,"يا مسدي العرف إسرارا وإعلانا","https://www.aldiwan.net/poem69491.html","البسيط"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[573,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[584,"ما شئت من عبء الغرام وحمله","https://www.aldiwan.net/poem17688.html","الكامل"]],"verses":[["يا مَسقِطَ العَلَمَينِ مِن رَملِ الحِمى","لي عِندَ ظَبيَتِكَ النَوارِ دُيونِ",0,"ن",1,1],["يا مَسرَحَ الآرامِ في وادي الحِمى","هَل فيكَ ذو شَجَنٍ يَروحُ وَيَغتَدي",1,"د",2,0],["يا مُستَقِلَّ كَثيرِنا يَسِّر لَنا","مِنكَ القَليلَ فَما نَراهُ قَليلا",2,"ل",2,0],["يا مُسْتَهينَ الخطْبِ لمّا أعْضَلَتْ","أدْواؤهُ وتكالَبَتْ أشْرارُهُ",3,"ر",2,0],["يا مُسْنِدَ السّعْدِ والنّصْرِ العَزيز الى","سَعْدٍ لنَصْرٍ الى خَيْرِ البَرِيّاتِ",4,"ت",1,0],["يا مُستَخِفّاً بِعاشِقيهِ","وَمُستَغِشّاً لِناصِحيهِ",5,"ي",2,1],["يَا مُسْرِفاً فِي لَهْوِهِ","وَمُذْهَباً فِي العَجَبْ",6,"ب",1,1],["يَا مُسْهِدَ القَوْمِ أَطَلْتَ السِّنَهْ","مَا الدَّهْرُ إِلاَّ بَعْضُ هَذِي السَّنَهْ",7,"ن",2,1],["يا مسلياً ذا الشيب عن شبابه","بأن وخط الشيب أزهار النهى",8,"ا",1,0],["يا مُستَجيرَ مُجاشِعٍ يَخشى الرَدى","لا تَأمَنَنَّ مُجاشِعاً بِأَمانِ",9,"ن",1,0],["يا مَسلَمَ المُتَضَيِّفونَ إِلَيكُمُ","أَهلَ الرَجاءِ طَلَبتُ وَالتَكريمِ",10,"م",1,0],["يا مَسْلَم بن أبي الوليد","لميَّتٍ إن شئت ناشر",11,"ر",1,0],["يا مسدِي النعمى التي قد أصبحت","سنداً لمن يشكو الزمان ومسندا",12,"د",2,0],["يا مسلمونَ انفروا جميعاً","إليه أوْ اِنْفروا ثُباتِ",13,"ت",1,0],["يا مُستقرَّ العار والنقصِ","أغنتْ مخازيك عن الفحصِ",14,"ص",1,1],["يا مستحلَّ دمي مُحَرِّم رَحْمتي","ما أنصفَ التحليل والتحريم",15,"م",1,0],["يا مَسرَحَ العُشّاقِ كَم","لي فيكَ مِن يَومٍ مَطيرِ",16,"ر",1,0],["يا مُستَرِقّاً بِنُعما","هُ كُلَّ حُرٍّ سَريِّ",17,"ي",1,0],["يا مُسرِفاً في التيهِ ما يَنتَهي","أَخافُ أَن يَفنى عَلَينا الزَمان",18,"ن",1,0],["يا مُستَرِدّاً قَليلَ نائِلِهِ","أَكُلُّ هَذا حِرصاً عَلى العَشرَه",19,"ر",2,1],["يا مسرحاً والفصول تترى","عليه ما لي بك اغترار",20,"ر",1,0],["يا مُسْدياً من نداهُ كلّ مَكرُمَةٍ","ومجرياً في مداه شُزّبَ الحُصُنِ",21,"ن",1,0],["يا مُستَجمَ «النُّوُاسيِّ» الذي لبِستْ","به الحضارةُ ثوباً وشيَ «هارون»",22,"ن",1,0],["يا مسعرَ النار كَيفَ أَطفئها","سامَحَكَ اللَه حينَ تسعرها",23,"ر",3,0],["يا مِسكَةَ العَطّارِ","وَخالَ وَجهِ النَهارِ",24,"ر",1,1],["يَا مَسْقِطاً لِلرَّأْسِ فِي جَنَبَاتِهِ","مِنْ حَرِّ شَوْقِي جَمْرَةٌ لَمْ تَخْمُدِ",25,"د",1,0],["يا مُسديَ اليد، لا يرمي إلى غرضٍ","وكاشفَ الضُّرِّ، لا يسعى إلى أرَب",26,"ب",1,0],["يا مسبل الستر على خلقه","وكاشفا غم الضعيف الحزين",27,"ن",1,0],["يا مسيكين انت طورا عجوز","وكما انت عاجز ذو خيال",28,"ل",1,0],["يا مستريحا بالتجافي ربما","بما جناه المستريح يتعب",29,"ب",1,0],["يا مُسمِعي فِقراً تَفضيلُها لَزَمٌ","وَموسِعي مِنَناً تَفصيلُها جُمَلُ",30,"ل",1,0],["يا مُسْقِماً بِالْبَذْلِ صِحَّةَ مَالِهِ","فِينا وَهادِمَهُ بِما يَبْنِينا",31,"ن",2,0],["يا مستعينا على جرمي بفضل يدي","ما أنت بالنفخ ملق قلة الجبل",32,"ل",1,0],["يا مُسقْنِي غُصَصَ الغرامِ بصَدِّه","لما تأهب للمسير وَودَّعا",33,"ع",2,0],["يا مُسقِمِى بجفونٍ تَدَّعى سَقَما","لا أَدَّعى مثَلها زُورا وبهتانا",34,"ن",2,0],["يا مسكنَ الشُّهبِ الزهراء كم عجبٍ","بمعدنِ الدررِ الغرَّا وأسرارِ",35,"ر",1,0],["يا مستعِدُّون للفَخارِ بنا","ومَنْ بنا أدرَكوا الذي سألوا",36,"ل",3,0],["يا مُستريحاً لم أنل","من حُبِّه إلا التَّعَب",37,"ب",1,0],["يا مُسقمي مهلاً على جسدي الذي","لم يَبقَ فيه للسقَّام مكانُ",38,"ن",1,0],["يا مُسلمينَ تَقَطَّعت أوصالكم","ونِصالكم قد بكّها المِرجام",39,"م",1,0],["يأمس للخليج رأيت يوما","علا قدراً على اليوم السعيد",40,"د",1,0],["يا مسجداً زان البلاد بحسنه","وتباشرت بمشيده العباد",41,"د",1,0],["يا مستعيناً جل في شرف","عن رتبة المنصور والمهدي",42,"د",2,0],["يا مسعدي في شقوتي ومعذبي","في لذتي ساع السنون وقريبا",43,"ب",2,0],["يا مُسبلَ الستر يا رَبَّ العِبادِ وَيا","مَن جوده الجود وَالإِحسان ما يهبُ",44,"ب",1,0],["يا مُسيءَ الظُنونِ بِالدَهرِ يَأَتي","نُجحُهُ فيكَ قَبلَ وَعدٍ نَكيرِ",45,"ر",1,0],["يا مُستَغاثَ النَّاسِ في يَومِ الوَغى","ما بالُ مالِكَ يَستَغيثُ من الثَّنا",46,"ن",2,0],["يا مُستَمداً من مَنا","قِبهِ يُسَطُّرُها سُطورا",47,"ر",2,0],["يا مسكن اللَه العلي وعرشه ال","سامي الذي قد شاء فيه يمكث",48,"ث",1,1],["يا مسجدَ الأقصى, أراكَ على","هامِ السَّحاب، وأنتَ في القُدْسِ",49,"س",1,0],["يا مسجدَ الأقصى أراكَ على","وَجْهِ الحقيقةِ دونما لَبْسِ",49,"س",1,0],["يا مسجدَ الإسراءِ يا شَفَةً","تدعو إلى صلواتنا الخمسِ",49,"س",1,0],["يا مسرعون إلى الفتاوى, هوّنو","فلربَّ فتوى أهلكت من قالها",50,"ل",3,0],["يا مسقمي من طَرفِهِ بِسِقامِهِ","رِفقاً بِقَلبي قَد أَطَلتَ هُيامي",51,"ي",1,0],["يا مُستَقِلَّ الغِنَى فيما تجودُ بهِ","ومَن مواهِبُهُ كالعَارِض الهَطِلِ",52,"ل",1,1],["يا مسرح من وادي الحمى","هل عودة يا مسرح الآرام",53,"م",1,0],["يا مُسقطَ العلمينِ هل من مُخبرٍ","عن مستقرّي زينب وسعادِ",54,"د",1,0],["يا مسعد الدهر في ظلمي أما عجب","إن جت عدلا وجئت اليوم عدوانا",55,"ن",2,0],["يا مستجيباً دعوة المض","طر والواهي المصاب",56,"ب",1,0],["يا مستلذ الظما في كل هاجرة","صوما وملتذ من طاعاتك السهرا",57,"ر",2,0],["يا مسقط الرأس العزي","ز ودرة الحسن اليتيمة",58,"م",2,0],["يا مستعزا بالنجوم","تبسمت لمن ابتسم",59,"م",1,0],["يا مستضيمَ الملك أينَ الحامي","ياجدبُ ما فعلَ السحابُ الهامي",60,"م",2,1],["يا مسلفي تبرُّعاً من ودِّه","سلافةَ الخمرِ ووسمِيَّ المطَرْ",61,"ر",1,0],["يا مِسكَةَ العُشّاقِ مِسكُ الدُجى","قَد رُدَّ في نافِجَةِ الغَربِ",62,"ب",1,1],["يا مُسقِمي بِجُفونِ سَقمها سَبَب","إِلى مُواصَلَةِ الأَسقامِ في جَسَدي",63,"ي",1,1],["يا مُسْدِلَ البُرْدِ في مجْلى جَلالَتِهِ","عنهُ حِجاباً ولم تُكْشَفْ حَواشيها",64,"ي",3,0],["يا مُسَيْكِينُ هل عَلِمْتَ يَقيناً","ما طَواهُ الخَلاَّقُ في المَخلوُق",65,"ق",1,0],["يا مسبل الأستار دون جلاله","ماذا الذي رفعت له الأستار",66,"ر",1,0],["يا مسلمين ويا نصارى انظروا","كتابنا وكفاة بيت المال",67,"ل",1,0],["يا مسبل الستر لا تكشفه عن رجل","لا يلتجي أبداً إلا إلى كرمك",68,"ك",1,1],["يا مستبيحين أعراضاً محرمةً","بسوء ظن وتلبيس وتمويه",69,"ي",2,0],["يا مُسعِفاً دهري عليَّ بهَجْرِهِ","لا تُسعِفِ البازي على خُفّاشِهِ",70,"ش",2,0],["يَا مُسْدِيَ العُرْفِ إسْرَارَاً وَإِعْلاَنَا","وَمُتْبِعَ البِرِّ وَالإِحْسَانِ إِحْسَانَا",71,"ن",2,1],["يا مُسْهِرِي بِشكرِه","وجودُه مُنيمِي",72,"م",2,0],["يا مُسْقِمِي بِلَواحِظٍ","أَهْدَتْ إِليّ سَقَامَها",73,"م",3,0],["يا مُسْعِدي في حَمْل أَثْقَالِ الهَوَى","مُتَجَمِّلاً تَبْغي مَعُونةَ حَمْلِهِ",74,"ل",2,0]]}