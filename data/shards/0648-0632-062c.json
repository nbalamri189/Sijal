{"poems":[[93,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[93,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[87,"صداح يا ملك الكنار","https://www.aldiwan.net/poem7144.html","مجزوء الكامل"],[87,"صداح يا ملك الكنار","https://www.aldiwan.net/poem63754.html","مجزوء الكامل"],[63,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[107,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[41,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[52,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[52,"تثاقل ليلي فما أبرح","https://www.aldiwan.net/poem63978.html","المتقارب"],[41,"قفَا فاسألاَ الدِّمنَة َ المَاصحَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=4239",""],[128,"لما وجدت مكارم الأخلاق","https://www.aldiwan.net/poem23750.html","مجزوء الكامل"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[276,"دمى طلل بين الطلول بحا جر","https://www.aldiwan.net/poem52110.html","الطويل"],[280,"أسلم للمقدور ثم أسلم","https://www.aldiwan.net/poem25531.html","الطويل"],[382,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[422,"كم قد ألين لمن قسا بصدوده","https://www.aldiwan.net/poem53923.html","الكامل"],[487,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[563,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105469","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26428","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137927",""],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101754","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121176","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60852","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65977","الطويل"],[2801,"","https://poetry.dctabudhabi.ae/diwan/poem/144466","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140044",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65460","الكامل"],[3109,"","https://poetry.dctabudhabi.ae/diwan/poem/102827","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91679","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117842","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133308","الكامل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2528","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81919","الخفيف"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127927","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139582",""],[4978,"لا بد مني كي يكون فتيلا","https://www.poetsgate.com/ViewPoem.aspx?id=177270",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[5431,"لاأنبسُ...","https://www.poetsgate.com/ViewPoem.aspx?id=190718",""],[5587,"رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=196791",""],[5718,"جواد العز","https://www.poetsgate.com/ViewPoem.aspx?id=213871",""],[487,"وصلتم بأنواع المسرات دائما","https://www.poetsgate.com/ViewPoem.aspx?id=129655",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["وَزَجَرتُ عَيني أَن تُسَرَّ بِمَنظَرٍ","وَمَنَعتُ قَلبي بَعدَهُ أَن يَخفِقا",0,"ق",2,0],["وَزَجَرتُ نَفسي أَن تَميلَ كَنَفسِهِ","عَن كَوثَرِ الدُنيا إِلى أَوحالِها",1,"ل",3,0],["وزجاجة من فضة","مملؤة من سلسل",2,"ل",1,0],["وَزُجاجَةٌ مِن فِضَّةٍ","مَملوءَةٌ مِن سَلسَلِ",3,"ل",1,0],["وزَجَرْتُ أمثالَ الأهِلَّةِ بل تَرى","أجرامَهُنَّ من الأهِلَّةِ أمحَقا",4,"ق",2,0],["وَزجّوها فَوارِسَ ضاق عَنها","فَضاءُ الأَرض أَعينُها دَوامِ",5,"م",1,0],["وَزَجرٍ وَنيرٍ يُنَسّي الكَلال","بِمَجدولَةٍ طُوِيَت بارِحَه",6,"ح",2,0],["وَزُجاجَةٍ لِلشَربِ فيها مَقنَعٌ","قُرِنَت بِأَزهَرَ كَالغَزالِ مُباحِ",7,"ح",1,0],["وَزَجّاءَ بَرجاءَ في جَوهَرٍ","تَروقُ بِها عَينُ مَن يَلمَحُ",8,"ح",1,0],["وزَجْرٍ ونَبْرٍ يُنَسِّي الكَلاَلْ","بمجدولة ٍ طويتْ بارحَة ْ",9,"ح",2,0],["وزججتها في زمرة المتصع","لكين مع الطغام",10,"م",1,0],["وَزجّ بالمُصطفى في النورِ مُنفرداً","حتّى رَأى ربّه والكيف مجهولُ",11,"ل",1,0],["وَزج به في النور حَتّى اذا اِنتَهى","الى موقف ما فيه نهج لسائر",12,"ر",1,0],["وَزَجَّيْتُ أيَّامي وَرَجَّيتُ فُرْجَةً","ولَمَّا يَسِرْ مُسْرىً بِرَحْلِي ومُلْجَمُ",13,"م",1,0],["وزجَّهُ عن جِنان الخلد منهبطاً","لما برِجْل المعاصي قلبُه لَبَطا",14,"ط",2,0],["وزَجَرْتُ طير السَّعد يهتُفُ باسمه","ورأيتُ منه الطَّالع المسعودا",15,"د",2,0],["وزج بي في لجة المشاهده","ولا تثبطني عن المجاهده",16,"ه",1,0],["وزجرت العيس منكم للسرى","فهمو أهل المعاني فهموا",17,"م",3,0],["وزجرت عن وادي الغري حوادثاً","ونشرت ثوب العدل فوق عراقها",18,"ق",3,0],["وزجرت عن مدح الأنام نشائدي","حتى ظننت قريحتي جلمودا",19,"د",2,0],["وَزُجاجَةٍ غَرَضَت عَلَيكَ شُعاعَها","وَاللَيلُ مَضروبُ الدَوالي أَسوَدُ",20,"د",1,0],["وزجاجات بهجة تتثنّى","خوط بان تهزّه النكباء",21,"ا",2,0],["وزج بجيشه في تيهِ سنا","يسام صدًى وإعياءً وحرَّا",22,"ر",2,0],["وزجاجةٍ قَابَلْتَها فتبسَّمَتْ","عن ثَغْرِهِ وَرُضَابِهِ وسَنَائِهِ",23,"ا",3,0],["وزجرنا الحداة ليلا فجدت","ثم ارخت ازمّة الاعناق",24,"ق",1,0],["وزجرتُ ذا القلب الجريح فما ارعوى","وكفَفْتُ ذا الجِفنَ القريحَ فقال لاَ",25,"ل",2,0],["وزجّ عجاج والعناجيج ضمَّر","وحطم رماح ذبل ومناصل",26,"ل",1,0],["وزجيت بزلاً كالجوازي مجهزاً","وأزجيت عزم الهبرزي المناجز",27,"ز",1,0],["وزجه رفرف التداني","كقاب قوسين في استواء",28,"ا",2,0],["وزُجاجة في ضمنها نارنجةٌ","في وصفها حارت ذوو التمييز",29,"ز",1,1],["وزجاجٌ كبدر التم وجهاً","لصارم مقلتيه دمي أبيحا",30,"ح",2,1],["وَزجرتَ الطيرَ عَن أَوكارِهِ","غلطاً جرَّ عَلى الوكر العفاءَ",31,"ا",2,0],["وَزجت بي الأَهوالُ في كل مَهمَهٍ","أُشير إِلى الدُنيا براحة فاقد",32,"د",1,0],["وزج به والروح يخدمه إلى","طباق السما والحجب من دونه تطوى",33,"و",2,0],["وزجرت دمعى ثم قلت لرفقتي","هذا النعيم هو المقيم فقد كفى",34,"ف",2,0],["وَزَجَرتُ المَزنوقَ حَتّى رَمى بي","وَسطَ خَيلٍ مَلمومَةٍ فَاِبذَعَرَّت",35,"ت",1,0],["وزج زج واثقٍ عميد","فقطع النصل حبال الجيد",36,"د",1,0],["وَزَجَّ فَطاشَ السِنانُ وَطار","إِلى عَسقَلافَ اِبنِ رَبِّ البِدار",37,"ر",1,0],["وزج فطار علماء","لقلب مجن آخيل",38,"ل",1,0],["وزجرتُ القلب الخفوق بلطفٍ","واشتياقٍ ولوعةٍ واكتئاب",39,"ب",1,0],["وزجَّني في وهدة الاياسِ","وكثرة الافكار والوسواسِ",40,"س",1,0],["وزج به شوقاً إلى أرض طيبةٍ","إلى المرشد الهادى إلى واضح النهج",41,"ج",1,0],["وزجاج قلبي ليس عن جدرانه","لرذاذ حبّك في المساء بديلا",42,"ل",2,0],["وزج به في طم نور ولم يكن","يسح إلا أحمد ذلك الطما",43,"م",2,0],["وزجراً بما يلقاه من زاغ من لظى","إذا قيد قوم نحوها بالسلاسل",44,"ل",1,0],["وزجل رعود المارتين وقد همت","بوبل لأعداء الشريعة قاتل",45,"ل",1,0],["وزجاج روحي عاكسٌ لصبابتي","يهب النعيم بكل ركن يعكسُ",46,"س",1,0],["وَزَجَرْتُهَا عَنْ أُمَّةٍ مِنْ بَيْنَنَا","فَجَرَى بِأَرْضِهِمُ الخَرَابُ الأَبْقَعُ",47,"ع",1,0],["وَ زُجَّ الخِدْرُ في سِجْنِ البَغَايَا","وَ نَادَي الحُرُّ أَنْ يَا قَوْمُ عُودُوا",48,"د",3,0],["وزج بكم بحر السعادات سابحا","بأنموذج ألطاف لديم تتابع",49,"ع",1,0],["وزج بنا في مقعد الصدق واحمنا","من اللبس والتلبيس في قاب سدرتي",50,"ت",2,0],["وزجوا الجَميح بسجن واحد وبشعوا","وَذاقوا العَذاب الناس لَما وَلونها",51,"ن",3,0],["وَزجوا الجَميع بسجن واحد وَشنعوا","لا ما غَدَت شخص الرجال هزال",52,"ل",1,0]]}