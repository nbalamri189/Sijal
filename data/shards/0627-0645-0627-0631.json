{"poems":[[108,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"يا ناشد النعماء يقفو إثرها","https://www.aldiwan.net/poem30480.html","الرجز"],[3,"برح بالعينين كل مغيرة","https://www.aldiwan.net/poem111.html",""],[55,"فديت من لا أفدي غيره أبدا","https://www.aldiwan.net/poem26382.html","البسيط"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[73,"أما رضاك فعلق ما له ثمن","https://www.aldiwan.net/poem11905.html","البسيط"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[88,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"ياوجنتيه اللتين من بهج","https://www.aldiwan.net/poem9237.html","مجزوء الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"هبك الفرات الذي بالروم مطلعه","https://www.aldiwan.net/poem65425.html","البسيط"],[51,"حق الأديب لازم لذي الكرم","https://www.aldiwan.net/poem66033.html","الرجز"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[85,"قضى أريحي القوم والقوم من همو","https://www.aldiwan.net/poem6832.html","الطويل"],[62,"نار الهوى تسبك القلوب وبال","https://www.aldiwan.net/poem52274.html","المنسرح"],[62,"إياك والإرتقاء في سبب","https://www.aldiwan.net/poem52420.html","المنسرح"],[62,"أما الزمان ففي تنبيهه عظة","https://www.aldiwan.net/poem52472.html","البسيط"],[45,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[61,"جاءك شهر السرور شوال","https://www.aldiwan.net/poem51336.html","المنسرح"],[61,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[49,"إيها إليك أخي إيها","https://www.aldiwan.net/poem63196.html","مجزوء الكامل"],[49,"أما رحمتني يوم ولت فأسرعت","https://www.aldiwan.net/poem64124.html","الطويل"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"أيا ملين الحديد","https://www.aldiwan.net/poem62572.html","المجتث"],[46,"لقد ترفع فوق المشتري زحل","https://www.aldiwan.net/poem22192.html","البسيط"],[46,"لا يحسب الجود من رب النخيل جدا","https://www.aldiwan.net/poem22336.html","البسيط"],[46,"ما يفتأ المرء والأبراد يخلقها","https://www.aldiwan.net/poem22615.html","البسيط"],[46,"من رام أن يلزم الأشياء واجبها","https://www.aldiwan.net/poem22939.html","البسيط"],[46,"هذي الحياة مسافة فاصبر لها","https://www.aldiwan.net/poem23412.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202637","المجتث"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9876","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[77,"الحمدُ لله مَوْصُولا كما وجبا","https://www.poetsgate.com/ViewPoem.aspx?id=33314",""],[45,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[45,"مِيلُوا إلى الدّارِ مِنْ لَيْلَى نُحَيّيهَا","https://www.poetsgate.com/ViewPoem.aspx?id=31648",""],[46,"لقد ترفّعَ، فوقَ المُشتري، زُحَلٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=18018",""],[51,"أما رأيتَ الدهر كيف يجري","https://www.poetsgate.com/ViewPoem.aspx?id=29116",""],[143,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[165,"أعن الشمس عشاء","https://www.aldiwan.net/poem67842.html","مجزوء الرمل"],[170,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[186,"أما رأيت هلال العيد حين بدت","https://www.aldiwan.net/poem14526.html","البسيط"],[205,"نفس المحب دواؤها في دائها","https://www.aldiwan.net/poem53154.html","الكامل"],[224,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[236,"جاء بدستبوية","https://www.aldiwan.net/poem32151.html","مجزوء الرجز"],[238,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[257,"يا من يعادي الهوى جهلا بموقعه","https://www.aldiwan.net/poem48528.html","البسيط"],[271,"متى حلم السعادة يضمحل","https://www.aldiwan.net/poem35206.html","الوافر"],[276,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[276,"هنيئا لوفد الغرب من صفوة العرب","https://www.aldiwan.net/poem25623.html","الطويل"],[281,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[298,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem33023.html","الوافر"],[337,"بنيت طاعتي باتباع","https://www.aldiwan.net/poem67803.html","عموديه"],[365,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[365,"من القاتلات الصب بالهجر في الهوى","https://www.aldiwan.net/poem60956.html","الطويل"],[366,"ألا هل أتاها من نهاوند أنني","https://www.aldiwan.net/poem44378.html","الطويل"],[367,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[372,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[372,"أترى بثار أم بدين","https://www.aldiwan.net/poem57099.html","مجزوء الكامل"],[372,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[394,"أما رأيت الدمع مسجوما","https://www.aldiwan.net/poem53664.html","السريع"],[394,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[404,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[407,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[410,"أما رأوا تقلب الدنيا بنا","https://www.aldiwan.net/poem31931.html","الرجز"],[417,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[430,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[433,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[459,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[459,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[478,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[539,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[552,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[580,"نفسي تميل إِلى الهوى فأَردها","https://www.aldiwan.net/poem56776.html","الكامل"]],"verses":[["أما رأيتَ بسامرّاءَ كيفَ شَفَت","نواصِبُ الآلِ منها الغيظَ والكَمَدا",0,"د",2,0],["أَما رَأى اِبنُ واصِلٍ","تَقنِصُهُ الحَبائِلُ",1,"ل",1,0],["أُمّاً رَؤوماً أَرضَعَتكَ دَرَّها","لَو أَلَّفَت عَلى النِظامِ نَثرَها",2,"ر",3,0],["أُمارِسُ فيها اِبنَي قُشَيرٍ كِلَيهِم","بِرُمحِيَ حَتّى بَلَّ عامِلَهُ الدَمُ",3,"م",1,0],["أُمارِسُ خَيلاً لِلهُجَيمِ كَأَنَّه","سَعالٍ بِأَيديها الوَشيجُ المُقَوَّمُ",3,"م",1,0],["أَمّا رَسولي فَمَمنوعُ اللِقاءِ بِكُم","وَلا يَهُمُّكُمُ أَن تُرسِلوا أَحَدا",4,"د",2,0],["إِمَارَةٌ قَدْ غَدَا نَصْرٌ بِقُبَّتِهَا","عِمَادَ عِزٍّ وَكُنَّا حَوْلَهُ طُنُبَا",5,"ب",2,0],["أَمّا رِضاكَ فَعِلقٌ ما لَهُ ثَمَنٌ","لَو كانَ سامَحَني في وَصلِهِ الزَمَنُ",6,"ن",1,1],["أَمَا رَأَتْ مِصْرُ يَوْمَ هَبَّتِهَا","بَيْنَ حِرَابِ العَدَاةِ وَالخُذُمِ",7,"م",1,0],["أمارِس دهراً من جديدَيّ داهرا","وما زال ليلي بالعراقَين ساهرا",8,"ر",2,1],["امارِمُ غُرٌّ حِسَانُ الوُجُوهِ","مَطَاعِيمُ للطَّارِقِ الاَجنَبِ",9,"ب",1,0],["أما رأيت الوُرق في الأوراق","جاذبة القلوب بالأطواق",10,"ق",1,0],["أما رأيت القلوبَ عندهما","يجرحها مخلبان من سبجِ",11,"ج",1,0],["أما رآك وقد أكرمتني طرفاً","من النهار أما كانت له ذِكر",12,"ر",1,0],["أما رضيت بأن تحظى ببيدرة","من كوخ مصلحة بالقلس تذرعه",13,"ع",2,0],["أما رآه لم يزل أعنَى الخَدمْ","بالأدبِ الشعريِّ طوراً والحِكمْ",14,"م",1,0],["أما رأيْتَ ابن إسحاقٍ ومصرعَهُ","ودونه ركن عزٍّ غيرُ موهون",15,"ن",1,0],["أما رأيتَ الفجاجَ واسعة","واللَّه حيّاً والرزق مضمونا",16,"ن",2,0],["أَماراتُ الشَبابِ عَلَيهِ تَبدو","وَفي أَثوابِهِ كَهلٌ رَزينُ",17,"ن",1,0],["أما راعكم نعش حوى ذلك الغنى","وما فيه دينار ولا فيه درهم",18,"م",1,0],["أما رأيت الفَراشَ تأكلُهُ ال","نارُ فيعتادُها ويزدَحِمُ",19,"م",1,0],["أما رأيتَ الصحيحَ يُؤلِمُهُ","ما لا يُبالِي بمثلِه الحَذِرُ",20,"ر",1,0],["أما رأيتَ حظوظَ الدَّهْرِ قد عُكستْ","فالماءُ للضَّبِّ والرمَضاءُ للحُوتِ",21,"ت",1,0],["إِمّا رَدَدتِ عَنِ الحاجاتِ مُفتَقِداً","جادَ الشَبابِ الَّذي قَد فاتَ ذاهِبُهُ",22,"ب",2,0],["أَما راعَكَ الحَيُّ الحِلالُ بِهَجرِهِم","وَهُم لَكَ غَدواً بِالتَفَرُّقِ أَروَعُ",23,"ع",1,0],["أَما رَأَت كالِئَ الإِسلامِ يَكلَءُها","مِن أَن تُعابَ وَباني المَجدِ يَبنيها",24,"ي",3,0],["أما رأيت الهلال يلحظه","قوم لهم ما رأوه إهلال",25,"ل",1,0],["أما رَأَيْتَ الحَياةَ تُقطَعُ في","هَزَّتِهِ والحِمامُ يَتَّصِلُ",26,"ل",1,0],["أَمّا رَحى الدُنيا فَدا","إِرَةٌ تَدورُ عَلى بَنيها",27,"ي",3,0],["أَما رَحِمَتني يَومَ وَلَّت فَأَسرَعَت","وَقَد تَرَكَتني واقِفاً أَتَلَفَّتُ",28,"ت",1,1],["أما رأوه جريحاً لو يُصادِفُه","حِمامُه لم يجد من دونه حِوَلا",29,"ل",2,0],["أَما رَأَيت الأَقاح","أَفاق بَعد الكَرى",30,"ر",2,0],["أم أردتُم بها الصفاتِ فلمْ خُص","صَتْ ثُلاثٌ بِوصفِه وَثُناءُ",31,"ا",2,0],["أَما رَحِمتِ اِشتِياقي","أَما رَحِمتِ سُهودي",32,"د",2,0],["أَما رَأَيتِ بُكائي","في كُلِّ يَومٍ جَديدِ",32,"د",1,0],["أَما رَأَيتَ رِجالاً بَعدَ شُربِهِمُ","في النَضرِ يَرضونَ أَن أَن يُسقَوا مِنَ العُلَبِ",33,"ب",1,0],["أَما رَأَيتَ صُروفَ الدَهرِ غادِيَةً","عَلى القُلوبِ بِتَبغيضٍ وَتَحبيبِ",34,"ب",1,0],["أَما رَأَيتَ فَقيهَ المِصرِ أَقبَلَ مِن","دَفنِ الصَديقِ فَلَم يوعَظ بِمَن قَبَرا",35,"ر",2,0],["أَما رَأَيتَ جِبالَ الأَرضِ لازِمَةً","قَرارَها وَغُبارُ الأَرضِ يَرتَفِعُ",36,"ع",1,0],["أَمّا رُكابُ الجودِ فَهيَ عَواطِبٌ","وَسَرى الأَنامُ عَلى رِكابِ اللُومِ",37,"م",1,0],["أما رأيت حبيبي","في حسنه كالغزالِ",38,"ل",1,0],["أُمارِسُ فيها اِبنَي قُشَيرٍ كِلَيهِما","بِرُمحِيَ حَتّى بَلَّ عامِلَهُ الدَمُ",39,"م",1,0],["أُمارِسُ خَيلاً لِلهُجَيمِ كَأَنَّها","سَعالٍ بِأَيديها الوَشيجُ المُقَوَّمُ",39,"م",1,0],["أَمْ أَرْقَشٌ مَرِسٌ يَسِيلُ كَأَنَّهُ","بَيْنَ الْخَمَائِلِ جَدْوَلٌ دَفَّاقُ",40,"ق",1,0],["أَما رَأَيْتُمْ صَدَأَ السَّيْفِ وَقَدْ","غَالَ الفِرِنْدَ ثُمَّ نَالَ الْغِمْدا",41,"د",2,0],["أَمَا رِسَالَتُكِ المُثْلَى فَمَا بَرِحَتْ","كَمَا بَدَأْتِ بِهَا مَوْصُولَةَ السَّبَبِ",42,"ب",1,0],["إمارَة ٌ قد غدا نصْرٌ لقُبَّتِها","عِمادَ عِزٍّ وكُنّا حولهُ طُنُبا",43,"ب",2,0],["أمَا رَدَدْتَ عن الحاجاتِ مُفْتَقِداً،","جاهَ الشّبابُ الذي قدْ فاتَ ذاهِبُهُ",44,"ب",2,0],["أمَا رَأتْ كالىءَ الإسلامِ يَكْلأُهَا","مِنْ أنْ تُعَابَ، وَبَاني المَجدِ يَبْنيهَا",45,"ي",3,0],["أما رأيتَ رجالاً، بعد شربهمُ،","في النَّضر، يرضون أن يُسقوا من العُلب",46,"ب",1,0],["أما رأيتَ الدهر كيف يجري","يُظهر ما أَكتمه من عمري",47,"ي",1,1],["أما رأى أنَّ ليثَ الغاب مجتمعٌ","لوثبةٍ وفنيقَ النِّيبِ هَدّارُ",48,"ر",1,0],["أما رجل منكم رشيد يرده","إلى الحق عقل أو جليس مؤدب",49,"ب",1,0],["أما رجعوا فيها إلى ملك أرضهم","فشد لنصر الله عقد المآزر",50,"ر",1,0],["أَم أَراكَ الحَينُ ما لَم","يَرَهُ القَومُ الوُقوفُ",51,"ف",1,0],["أَماراتُ سِرِّ الحُبِّ ما لا يُكَتَّمُ","وَأَبيَنُ شَيءٍ ما يُجِنُّ المُتَيَّمُ",52,"م",1,1],["أَما رأيتَ هلالَ العيدِ حين بَدَتْ","للعين منه بَقايا جرم دائرِهِ",53,"ر",2,1],["أما ربيعةُ لا يضيع ذمامُها","أبداً ولا ينحلُّ عقدُ وفائها",54,"ا",3,0],["إِمّا رَآهُ الحُبُّ مُستَنزِفاً","أَدمُعُهُ قالَ لَهُ غَرّدِ",55,"د",1,0],["أَما رَأَت عَيناكَ تَخ","ييشَ اللُجَينِ بِالذَهَب",56,"ب",1,0],[