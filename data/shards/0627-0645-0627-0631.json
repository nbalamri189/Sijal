{"poems":[[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"يا ناشد النعماء يقفو إثرها","https://www.aldiwan.net/poem30480.html","الرجز"],[3,"برح بالعينين كل مغيرة","https://www.aldiwan.net/poem111.html",""],[55,"فديت من لا أفدي غيره أبدا","https://www.aldiwan.net/poem26382.html","البسيط"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[73,"أما رضاك فعلق ما له ثمن","https://www.aldiwan.net/poem11905.html","البسيط"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[88,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"ياوجنتيه اللتين من بهج","https://www.aldiwan.net/poem9237.html","مجزوء الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"هبك الفرات الذي بالروم مطلعه","https://www.aldiwan.net/poem65425.html","البسيط"],[51,"حق الأديب لازم لذي الكرم","https://www.aldiwan.net/poem66033.html","الرجز"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[85,"قضى أريحي القوم والقوم من همو","https://www.aldiwan.net/poem6832.html","الطويل"],[62,"نار الهوى تسبك القلوب وبال","https://www.aldiwan.net/poem52274.html","المنسرح"],[62,"إياك والإرتقاء في سبب","https://www.aldiwan.net/poem52420.html","المنسرح"],[62,"أما الزمان ففي تنبيهه عظة","https://www.aldiwan.net/poem52472.html","البسيط"],[45,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[61,"جاءك شهر السرور شوال","https://www.aldiwan.net/poem51336.html","المنسرح"],[61,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[49,"إيها إليك أخي إيها","https://www.aldiwan.net/poem63196.html","مجزوء الكامل"],[49,"أما رحمتني يوم ولت فأسرعت","https://www.aldiwan.net/poem64124.html","الطويل"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"أيا ملين الحديد","https://www.aldiwan.net/poem62572.html","المجتث"],[46,"لقد ترفع فوق المشتري زحل","https://www.aldiwan.net/poem22192.html","البسيط"],[46,"لا يحسب الجود من رب النخيل جدا","https://www.aldiwan.net/poem22336.html","البسيط"],[46,"ما يفتأ المرء والأبراد يخلقها","https://www.aldiwan.net/poem22615.html","البسيط"],[46,"من رام أن يلزم الأشياء واجبها","https://www.aldiwan.net/poem22939.html","البسيط"],[46,"هذي الحياة مسافة فاصبر لها","https://www.aldiwan.net/poem23412.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202637","المجتث"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9876","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[77,"الحمدُ لله مَوْصُولا كما وجبا","https://www.poetsgate.com/ViewPoem.aspx?id=33314",""],[45,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[45,"مِيلُوا إلى الدّارِ مِنْ لَيْلَى نُحَيّيهَا","https://www.poetsgate.com/ViewPoem.aspx?id=31648",""],[46,"لقد ترفّعَ، فوقَ المُشتري، زُحَلٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=18018",""],[51,"أما رأيتَ الدهر كيف يجري","https://www.poetsgate.com/ViewPoem.aspx?id=29116",""],[142,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[160,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[164,"أعن الشمس عشاء","https://www.aldiwan.net/poem67842.html","مجزوء الرمل"],[169,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[185,"أما رأيت هلال العيد حين بدت","https://www.aldiwan.net/poem14526.html","البسيط"],[204,"نفس المحب دواؤها في دائها","https://www.aldiwan.net/poem53154.html","الكامل"],[223,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[235,"جاء بدستبوية","https://www.aldiwan.net/poem32151.html","مجزوء الرجز"],[237,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[256,"يا من يعادي الهوى جهلا بموقعه","https://www.aldiwan.net/poem48528.html","البسيط"],[270,"متى حلم السعادة يضمحل","https://www.aldiwan.net/poem35206.html","الوافر"],[275,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[275,"هنيئا لوفد الغرب من صفوة العرب","https://www.aldiwan.net/poem25623.html","الطويل"],[280,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[297,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem33023.html","الوافر"],[336,"بنيت طاعتي باتباع","https://www.aldiwan.net/poem67803.html","عموديه"],[364,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[364,"من القاتلات الصب بالهجر في الهوى","https://www.aldiwan.net/poem60956.html","الطويل"],[365,"ألا هل أتاها من نهاوند أنني","https://www.aldiwan.net/poem44378.html","الطويل"],[366,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[371,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[371,"أترى بثار أم بدين","https://www.aldiwan.net/poem57099.html","مجزوء الكامل"],[371,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[393,"أما رأيت الدمع مسجوما","https://www.aldiwan.net/poem53664.html","السريع"],[393,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[403,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[406,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[409,"أما رأوا تقلب الدنيا بنا","https://www.aldiwan.net/poem31931.html","الرجز"],[416,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[429,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[432,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[432,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[458,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[458,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[477,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[551,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[579,"نفسي تميل إِلى الهوى فأَردها","https://www.aldiwan.net/poem56776.html","الكامل"]],"verses":[["أَما رَأى اِبنُ واصِلٍ","تَقنِصُهُ الحَبائِلُ",0,"ل",1,0],["أُمّاً رَؤوماً أَرضَعَتكَ دَرَّها","لَو أَلَّفَت عَلى النِظامِ نَثرَها",1,"ر",3,0],["أُمارِسُ فيها اِبنَي قُشَيرٍ كِلَيهِم","بِرُمحِيَ حَتّى بَلَّ عامِلَهُ الدَمُ",2,"م",1,0],["أُمارِسُ خَيلاً لِلهُجَيمِ كَأَنَّه","سَعالٍ بِأَيديها الوَشيجُ المُقَوَّمُ",2,"م",1,0],["أَمّا رَسولي فَمَمنوعُ اللِقاءِ بِكُم","وَلا يَهُمُّكُمُ أَن تُرسِلوا أَحَدا",3,"د",2,0],["إِمَارَةٌ قَدْ غَدَا نَصْرٌ بِقُبَّتِهَا","عِمَادَ عِزٍّ وَكُنَّا حَوْلَهُ طُنُبَا",4,"ب",2,0],["أَمّا رِضاكَ فَعِلقٌ ما لَهُ ثَمَنٌ","لَو كانَ سامَحَني في وَصلِهِ الزَمَنُ",5,"ن",1,1],["أَمَا رَأَتْ مِصْرُ يَوْمَ هَبَّتِهَا","بَيْنَ حِرَابِ العَدَاةِ وَالخُذُمِ",6,"م",1,0],["أمارِس دهراً من جديدَيّ داهرا","وما زال ليلي بالعراقَين ساهرا",7,"ر",2,1],["امارِمُ غُرٌّ حِسَانُ الوُجُوهِ","مَطَاعِيمُ للطَّارِقِ الاَجنَبِ",8,"ب",1,0],["أما رأيت الوُرق في الأوراق","جاذبة القلوب بالأطواق",9,"ق",1,0],["أما رأيت القلوبَ عندهما","يجرحها مخلبان من سبجِ",10,"ج",1,0],["أما رآك وقد أكرمتني طرفاً","من النهار أما كانت له ذِكر",11,"ر",1,0],["أما رضيت بأن تحظى ببيدرة","من كوخ مصلحة بالقلس تذرعه",12,"ع",2,0],["أما رآه لم يزل أعنَى الخَدمْ","بالأدبِ الشعريِّ طوراً والحِكمْ",13,"م",1,0],["أما رأيْتَ ابن إسحاقٍ ومصرعَهُ","ودونه ركن عزٍّ غيرُ موهون",14,"ن",1,0],["أما رأيتَ الفجاجَ واسعة","واللَّه حيّاً والرزق مضمونا",15,"ن",2,0],["أَماراتُ الشَبابِ عَلَيهِ تَبدو","وَفي أَثوابِهِ كَهلٌ رَزينُ",16,"ن",1,0],["أما راعكم نعش حوى ذلك الغنى","وما فيه دينار ولا فيه درهم",17,"م",1,0],["أما رأيت الفَراشَ تأكلُهُ ال","نارُ فيعتادُها ويزدَحِمُ",18,"م",1,0],["أما رأيتَ الصحيحَ يُؤلِمُهُ","ما لا يُبالِي بمثلِه الحَذِرُ",19,"ر",1,0],["أما رأيتَ حظوظَ الدَّهْرِ قد عُكستْ","فالماءُ للضَّبِّ والرمَضاءُ للحُوتِ",20,"ت",1,0],["إِمّا رَدَدتِ عَنِ الحاجاتِ مُفتَقِداً","جادَ الشَبابِ الَّذي قَد فاتَ ذاهِبُهُ",21,"ب",2,0],["أَما راعَكَ الحَيُّ الحِلالُ بِهَجرِهِم","وَهُم لَكَ غَدواً بِالتَفَرُّقِ أَروَعُ",22,"ع",1,0],["أَما رَأَت كالِئَ الإِسلامِ يَكلَءُها","مِن أَن تُعابَ وَباني المَجدِ يَبنيها",23,"ي",3,0],["أما رأيت الهلال يلحظه","قوم لهم ما رأوه إهلال",24,"ل",1,0],["أما رَأَيْتَ الحَياةَ تُقطَعُ في","هَزَّتِهِ والحِمامُ يَتَّصِلُ",25,"ل",1,0],["أَمّا رَحى الدُنيا فَدا","إِرَةٌ تَدورُ عَلى بَنيها",26,"ي",3,0],["أَما رَحِمَتني يَومَ وَلَّت فَأَسرَعَت","وَقَد تَرَكَتني واقِفاً أَتَلَفَّتُ",27,"ت",1,1],["أما رأوه جريحاً لو يُصادِفُه","حِمامُه لم يجد من دونه حِوَلا",28,"ل",2,0],["أَما رَأَيت الأَقاح","أَفاق بَعد الكَرى",29,"ر",2,0],["أم أردتُم بها الصفاتِ فلمْ خُص","صَتْ ثُلاثٌ بِوصفِه وَثُناءُ",30,"ا",2,0],["أَما رَحِمتِ اِشتِياقي","أَما رَحِمتِ سُهودي",31,"ي",1,0],["أَما رَأَيتِ بُكائي","في كُلِّ يَومٍ جَديدِ",31,"د",1,0],["أَما رَأَيتَ رِجالاً بَعدَ شُربِهِمُ","في النَضرِ يَرضونَ أَن أَن يُسقَوا مِنَ العُلَبِ",32,"ب",1,0],["أَما رَأَيتَ صُروفَ الدَهرِ غادِيَةً","عَلى القُلوبِ بِتَبغيضٍ وَتَحبيبِ",33,"ب",1,0],["أَما رَأَيتَ فَقيهَ المِصرِ أَقبَلَ مِن","دَفنِ الصَديقِ فَلَم يوعَظ بِمَن قَبَرا",34,"ر",2,0],["أَما رَأَيتَ جِبالَ الأَرضِ لازِمَةً","قَرارَها وَغُبارُ الأَرضِ يَرتَفِعُ",35,"ع",1,0],["أَمّا رُكابُ الجودِ فَهيَ عَواطِبٌ","وَسَرى الأَنامُ عَلى رِكابِ اللُومِ",36,"م",1,0],["أما رأيت حبيبي","في حسنه كالغزالِ",37,"ل",1,0],["أُمارِسُ فيها اِبنَي قُشَيرٍ كِلَيهِما","بِرُمحِيَ حَتّى بَلَّ عامِلَهُ الدَمُ",38,"م",1,0],["أُمارِسُ خَيلاً لِلهُجَيمِ كَأَنَّها","سَعالٍ بِأَيديها الوَشيجُ المُقَوَّمُ",38,"م",1,0],["أَمْ أَرْقَشٌ مَرِسٌ يَسِيلُ كَأَنَّهُ","بَيْنَ الْخَمَائِلِ جَدْوَلٌ دَفَّاقُ",39,"ق",1,0],["أَما رَأَيْتُمْ صَدَأَ السَّيْفِ وَقَدْ","غَالَ الفِرِنْدَ ثُمَّ نَالَ الْغِمْدا",40,"د",2,0],["أَمَا رِسَالَتُكِ المُثْلَى فَمَا بَرِحَتْ","كَمَا بَدَأْتِ بِهَا مَوْصُولَةَ السَّبَبِ",41,"ب",1,0],["إمارَة ٌ قد غدا نصْرٌ لقُبَّتِها","عِمادَ عِزٍّ وكُنّا حولهُ طُنُبا",42,"ب",2,0],["أمَا رَدَدْتَ عن الحاجاتِ مُفْتَقِداً،","جاهَ الشّبابُ الذي قدْ فاتَ ذاهِبُهُ",43,"ب",2,0],["أمَا رَأتْ كالىءَ الإسلامِ يَكْلأُهَا","مِنْ أنْ تُعَابَ، وَبَاني المَجدِ يَبْنيهَا",44,"ي",3,0],["أما رأيتَ رجالاً، بعد شربهمُ،","في النَّضر، يرضون أن يُسقوا من العُلب",45,"ب",1,0],["أما رأيتَ الدهر كيف يجري","يُظهر ما أَكتمه من عمري",46,"ي",1,1],["أما رأى أنَّ ليثَ الغاب مجتمعٌ","لوثبةٍ وفنيقَ النِّيبِ هَدّارُ",47,"ر",1,0],["أما رجل منكم رشيد يرده","إلى الحق عقل أو جليس مؤدب",48,"ب",1,0],["أما رجعوا فيها إلى ملك أرضهم","فشد لنصر الله عقد المآزر",49,"ر",1,0],["أَم أَراكَ الحَينُ ما لَم","يَرَهُ القَومُ الوُقوفُ",50,"ف",1,0],["أَماراتُ سِرِّ الحُبِّ ما لا يُكَتَّمُ","وَأَبيَنُ شَيءٍ ما يُجِنُّ المُتَيَّمُ",51,"م",1,1],["أَما رأيتَ هلالَ العيدِ حين بَدَتْ","للعين منه بَقايا جرم دائرِهِ",52,"ر",2,1],["أما ربيعةُ لا يضيع ذمامُها","أبداً ولا ينحلُّ عقدُ وفائها",53,"ا",3,0],["إِمّا رَآهُ الحُبُّ مُستَنزِفاً","أَدمُعُهُ قالَ لَهُ غَرّدِ",54,"د",1,0],["أَما رَأَت عَيناكَ تَخ","ييشَ اللُجَينِ بِالذَهَب",55,"ب",1,0],["أَمَّا رِضَاكَ عُمُومُهُ وَخُصُوصُهُ","فَمُنَاخَةٌ بِذُرَى الْمُنِيبِ قُلُوصُهُ",56,"ص",2,1],["أما رأيت الهوى استولى بفتنته","على النبييين واستغوى بها الرسلا"