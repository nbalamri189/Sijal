etsgate.com/ViewPoem.aspx?id=188561",""],[5419,"تباريح الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=32266",""],[5431,"أمير..","https://www.poetsgate.com/ViewPoem.aspx?id=190434",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5736,"يا قدس يا طفلتي","https://www.poetsgate.com/ViewPoem.aspx?id=208458",""],[5751,"نَهارُ عينَيك","https://www.poetsgate.com/ViewPoem.aspx?id=215014",""],[5770,"إلى التي خطرت بالبال","https://www.poetsgate.com/ViewPoem.aspx?id=178677",""],[402,"علتنا بالمثال والقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36322",""],[5789,"أفنية العنادل","https://www.poetsgate.com/ViewPoem.aspx?id=201407",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5956,"لا تستحقك لا أرضٌ ولا شهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208505",""],[5966,"هذا المصيف","https://www.poetsgate.com/ViewPoem.aspx?id=158863",""],[5974,"أريكة الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=215273",""],[6070,"أيام عمرك","https://www.poetsgate.com/ViewPoem.aspx?id=187805",""],[6093,"ولا كل ّ طير ٍ بالجناحِ يَطيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190513",""],[6142,"إمارة القول أعطته الحليَّ وأع","https://www.poetsgate.com/ViewPoem.aspx?id=155723",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""],[5190,"في المقهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78322&r=&rc=35",""]],"verses":[["أما رأيتَ بسامرّاءَ كيفَ شَفَت","نواصِبُ الآلِ منها الغيظَ والكَمَدا",0,"د",2,0],["أَما رَأى اِبنُ واصِلٍ","تَقنِصُهُ الحَبائِلُ",1,"ل",1,0],["أُمّاً رَؤوماً أَرضَعَتكَ دَرَّها","لَو أَلَّفَت عَلى النِظامِ نَثرَها",2,"ر",3,0],["أُمارِسُ فيها اِبنَي قُشَيرٍ كِلَيهِم","بِرُمحِيَ حَتّى بَلَّ عامِلَهُ الدَمُ",3,"م",1,0],["أُمارِسُ خَيلاً لِلهُجَيمِ كَأَنَّه","سَعالٍ بِأَيديها الوَشيجُ المُقَوَّمُ",3,"م",1,0],["أَمّا رَسولي فَمَمنوعُ اللِقاءِ بِكُم","وَلا يَهُمُّكُمُ أَن تُرسِلوا أَحَدا",4,"د",2,0],["إِمَارَةٌ قَدْ غَدَا نَصْرٌ بِقُبَّتِهَا","عِمَادَ عِزٍّ وَكُنَّا حَوْلَهُ طُنُبَا",5,"ب",2,0],["أَمّا رِضاكَ فَعِلقٌ ما لَهُ ثَمَنٌ","لَو كانَ سامَحَني في وَصلِهِ الزَمَنُ",6,"ن",1,1],["أَمَا رَأَتْ مِصْرُ يَوْمَ هَبَّتِهَا","بَيْنَ حِرَابِ العَدَاةِ وَالخُذُمِ",7,"م",1,0],["أمارِس دهراً من جديدَيّ داهرا","وما زال ليلي بالعراقَين ساهرا",8,"ر",2,1],["امارِمُ غُرٌّ حِسَانُ الوُجُوهِ","مَطَاعِيمُ للطَّارِقِ الاَجنَبِ",9,"ب",1,0],["أما رأيت الوُرق في الأوراق","جاذبة القلوب بالأطواق",10,"ق",1,0],["أما رأيت القلوبَ عندهما","يجرحها مخلبان من سبجِ",11,"ج",1,0],["أما رآك وقد أكرمتني طرفاً","من النهار أما كانت له ذِكر",12,"ر",1,0],["أما رضيت بأن تحظى ببيدرة","من كوخ مصلحة بالقلس تذرعه",13,"ع",2,0],["أما رآه لم يزل أعنَى الخَدمْ","بالأدبِ الشعريِّ طوراً والحِكمْ",14,"م",1,0],["أما رأيْتَ ابن إسحاقٍ ومصرعَهُ","ودونه ركن عزٍّ غيرُ موهون",15,"ن",1,0],["أما رأيتَ الفجاجَ واسعة","واللَّه حيّاً والرزق مضمونا",16,"ن",2,0],["أَماراتُ الشَبابِ عَلَيهِ تَبدو","وَفي أَثوابِهِ كَهلٌ رَزينُ",17,"ن",1,0],["أما راعكم نعش حوى ذلك الغنى","وما فيه دينار ولا فيه درهم",18,"م",1,0],["أما رأيت الفَراشَ تأكلُهُ ال","نارُ فيعتادُها ويزدَحِمُ",19,"م",1,0],["أما رأيتَ الصحيحَ يُؤلِمُهُ","ما لا يُبالِي بمثلِه الحَذِرُ",20,"ر",1,0],["أما رأيتَ حظوظَ الدَّهْرِ قد عُكستْ","فالماءُ للضَّبِّ والرمَضاءُ للحُوتِ",21,"ت",1,0],["إِمّا رَدَدتِ عَنِ الحاجاتِ مُفتَقِداً","جادَ الشَبابِ الَّذي قَد فاتَ ذاهِبُهُ",22,"ب",2,0],["أَما راعَكَ الحَيُّ الحِلالُ بِهَجرِهِم","وَهُم لَكَ غَدواً بِالتَفَرُّقِ أَروَعُ",23,"ع",1,0],["أَما رَأَت كالِئَ الإِسلامِ يَكلَءُها","مِن أَن تُعابَ وَباني المَجدِ يَبنيها",24,"ي",3,0],["أما رأيت الهلال يلحظه","قوم لهم ما رأوه إهلال",25,"ل",1,0],["أما رَأَيْتَ الحَياةَ تُقطَعُ في","هَزَّتِهِ والحِمامُ يَتَّصِلُ",26,"ل",1,0],["أَمّا رَحى الدُنيا فَدا","إِرَةٌ تَدورُ عَلى بَنيها",27,"ي",3,0],["أَما رَحِمَتني يَومَ وَلَّت فَأَسرَعَت","وَقَد تَرَكَتني واقِفاً أَتَلَفَّتُ",28,"ت",1,1],["أما رأوه جريحاً لو يُصادِفُه","حِمامُه لم يجد من دونه حِوَلا",29,"ل",2,0],["أَما رَأَيت الأَقاح","أَفاق بَعد الكَرى",30,"ر",2,0],["أم أردتُم بها الصفاتِ فلمْ خُص","صَتْ ثُلاثٌ بِوصفِه وَثُناءُ",31,"ا",2,0],["أَما رَحِمتِ اِشتِياقي","أَما رَحِمتِ سُهودي",32,"د",2,0],["أَما رَأَيتِ بُكائي","في كُلِّ يَومٍ جَديدِ",32,"د",1,0],["أَما رَأَيتَ رِجالاً بَعدَ شُربِهِمُ","في النَضرِ يَرضونَ أَن أَن يُسقَوا مِنَ العُلَبِ",33,"ب",1,0],["أَما رَأَيتَ صُروفَ الدَهرِ غادِيَةً","عَلى القُلوبِ بِتَبغيضٍ وَتَحبيبِ",34,"ب",1,0],["أَما رَأَيتَ فَقيهَ المِصرِ أَقبَلَ مِن","دَفنِ الصَديقِ فَلَم يوعَظ بِمَن قَبَرا",35,"ر",2,0],["أَما رَأَيتَ جِبالَ الأَرضِ لازِمَةً","قَرارَها وَغُبارُ الأَرضِ يَرتَفِعُ",36,"ع",1,0],["أَمّا رُكابُ الجودِ فَهيَ عَواطِبٌ","وَسَرى الأَنامُ عَلى رِكابِ اللُومِ",37,"م",1,0],["أَمَ ارْضَى بِمَا قَدْ كُنْتُ أَسْخَطُ مَرَّةً","أَمَ اشْرَبُ رَنْقَ العَيْشِ أَمْ كَيْفَ أَصْنَعُ",38,"ع",1,0],["أما رأيت حبيبي","في حسنه كالغزالِ",39,"ل",1,0],["أُمارِسُ فيها اِبنَي قُشَيرٍ كِلَيهِما","بِرُمحِيَ حَتّى بَلَّ عامِلَهُ الدَمُ",40,"م",1,0],["أُمارِسُ خَيلاً لِلهُجَيمِ كَأَنَّها","سَعالٍ بِأَيديها الوَشيجُ المُقَوَّمُ",40,"م",1,0],["أَمْ أَرْقَشٌ مَرِسٌ يَسِيلُ كَأَنَّهُ","بَيْنَ الْخَمَائِلِ جَدْوَلٌ دَفَّاقُ",41,"ق",1,0],["أَما رَأَيْتُمْ صَدَأَ السَّيْفِ وَقَدْ","غَالَ الفِرِنْدَ ثُمَّ نَالَ الْغِمْدا",42,"د",2,0],["أَمَا رِسَالَتُكِ المُثْلَى فَمَا بَرِحَتْ","كَمَا بَدَأْتِ بِهَا مَوْصُولَةَ السَّبَبِ",43,"ب",1,0],["إمارَة ٌ قد غدا نصْرٌ لقُبَّتِها","عِمادَ عِزٍّ وكُنّا حولهُ طُنُبا",44,"ب",2,0],["أمَا رَدَدْتَ عن الحاجاتِ مُفْتَقِداً،","جاهَ الشّبابُ الذي قدْ فاتَ ذاهِبُهُ",45,"ب",2,0],["أمَا رَأتْ كالىءَ الإسلامِ يَكْلأُهَا","مِنْ أنْ تُعَابَ، وَبَاني المَجدِ يَبْنيهَا",46,"ي",3,0],["أما رأيتَ رجالاً، بعد شربهمُ،","في النَّضر، يرضون أن يُسقوا من العُلب",47,"ب",1,0],["أما رأيتَ الدهر كيف يجري","يُظهر ما أَكتمه من عمري",48,"ي",1,1],["أما رأى أنَّ ليثَ الغاب مجتمعٌ","لوثبةٍ وفنيقَ النِّيبِ هَدّارُ",49,"ر",1,0],["أما رجل منكم رشيد يرده","إلى الحق عقل أو جليس مؤدب",50,"ب",1,0],["أما رجعوا فيها إلى ملك أرضهم","فشد لنصر الله عقد المآزر",51,"ر",1,0],["أَم أَراكَ الحَينُ ما لَم","يَرَهُ القَومُ الوُقوفُ",52,"ف",1,