gate.com/ViewPoem.aspx?id=185767",""],[5888,"للراقصين بالعتمة","https://www.poetsgate.com/ViewPoem.aspx?id=214505",""],[5910,"حيِّ قبرًا بجانبِ الآكامِ","https://www.poetsgate.com/ViewPoem.aspx?id=207124",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5956,"جاءني طفلٌ نحيل","https://www.poetsgate.com/ViewPoem.aspx?id=192779",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[6082,"الحزن منّي","https://www.poetsgate.com/ViewPoem.aspx?id=59108",""],[6145,"على خطا شيخ الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=7796",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""],[463,"نفَّرها عنْ وردها بحاجرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60081&r=&rc=137",""],[6249,"أفّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85663&r=&rc=6",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[6260,"أنشودة التحرير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68349&r=&rc=41",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""],[402,"يا من بكى والخطب جد أليم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54088&r=&rc=940",""],[4222,"خطرت تحمل من سلمى سلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52886&r=&rc=178",""],[5190,"طر يا حجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78347&r=&rc=60",""]],"verses":[["لَم تَكفِ يا كافي الكُفاةِ مَنيَّةً","نَفَذَت إِلَيكَ صَوارِماً وَأَلالا",0,"ل",2,0],["لَم تَكُن عَلياؤُهُم مَنحولَةً","أَبَدَ الدَهرِ وَلا المَجدُ مُعارا",1,"ر",2,0],["لَم تَكُن خَتلاً وَلَكِن غارَةً","أَمِنَ الشَلَّةَ مَن لاقى العِوارا",1,"ر",2,0],["لَم تَكُن مِصرُ بِالعَقيمِ وَلَكِن","قَد رَماها أَعداؤُها بِالحَيالِ",2,"ل",1,0],["لَم تَكَد تُدرِكُ النُفوسُ مُراداً","في زَمانِ المُتَوَّجِ العَلَوِيِّ",3,"ي",1,0],["لَم تَكَد تَبلُغُ البِلادَ مُناها","تَحتَ أَفياءِ عَدلِهِ الكِسرَوِيِّ",3,"ي",1,0],["لَمْ تَكْتُمِ الأَيَّامُ سِرَّ حَدِيثِهَا","عَنْهُ وَلَمْ يُخْطِئْهُ عِلْمُ قَدِيمِ",4,"م",1,0],["لم تكفه في مجال البَغي فتنته","حتى غداء بعدوّ الله معتَصِما",5,"م",2,0],["لَم تَكُن سُعدى لِتُنصَفُني","قَلَّ ما يُنصِفُني الصاحِبُ",6,"ب",1,0],["لم تكتمل حولاً وأورثتني","ضعفاً فلا حول ولا قوّه",7,"ه",1,0],["لم تكونوا كمعْشَرٍ جرَّدوا الفيْ","ءَ وهَلْ نحْلُه كمثْل جَرادِهْ",8,"د",2,0],["لم تكن مثلُ نعمة اللَّه في العبْ","باس تنجو من آفة التكديرِ",9,"ر",1,1],["لم تكتسب أن الدراهم شَجْوُها","لكِن لترشوهنّ عند المَكْبر",10,"ر",1,0],["لم تكن تُلبثُ الأيورُ جنيناً","في حشاها إلا مدى ما يُحطُّ",11,"ط",1,0],["لم تكن آلةٌ ليخلقها الخا","لقُ إلا شبيهةَ المؤتالِ",12,"ل",1,0],["لَم تَكُن مَوجودَةً قَبلَ وُجِد","وَلِهَذا حينَ يَمضي تَتبَعُ",13,"ع",1,0],["لم تكن قبل أن يلم بك المو","ت أخيرا بالصارم المفلول",14,"ل",1,0],["لم تكن هذه الحياة سوى حرب","وقد تختفي وراء العجاج",14,"ج",1,0],["لم تكن مني الصبابة في شيخوختي","غير جمرة في الرماد",15,"د",1,0],["لم تكن ليلى بالجبانة الا","انها تخشى لذعة الاقوال",16,"ل",1,0],["لم تكن هذه العوا","لم فيه سوى جزر",17,"ر",1,0],["لم تكتب الصحف النعي وانما","ذرفت عليك دموعها الاقلام",18,"م",1,0],["لم تكن هذه الحياة سوى حر","ب عوان تخوضها الأفواج",19,"ج",1,1],["لَم تُكشَفِ النَفسُ لَولاهُ وَلا بُلِيَت","لَها سَرائِرُ لا تُحصى وَأَهواءُ",20,"ا",2,0],["لَم تُكثِرِ الحَمراءُ مِن نُظَرائِهِ","نَسلاً وَلا بَغدادُ مِن أَمثالِهِ",21,"ل",2,0],["لم تكْسُ أطرافَ النهار قساطلاً","طُرُقُ المهالكِ عندَهنَّ مهائِعُ",22,"ع",1,0],["لَم تَكُنِ العِلجَةُ مَطبوعَةً","بَل كانَ مَطبوعاً عَلى قَلبِها",23,"ب",3,0],["لَم تَكُن نُهزَةَ الوَضيعِ وَلا رو","حُكَ كانَت لِفقاً لِروحِ لثَقيلِ",24,"ل",1,0],["لَم تَكرَ عَن قاصي الرَعِيَّةِ عَينُهُ","فَيَنامَ عَن وِترِ القَريبِ الداني",25,"ن",2,0],["لَم تَكُن صَفقَةُ الخِيارِ عَشِيّاً","لِاِبنِ عَمرٍو فيها وَلا صَفوانِ",26,"ن",1,0],["لَم تَكُ لي دارُ مَيَّةٍ غَرَضاً","إِذ لِيَ مِنهُ العَلياءُ وَالسَنَدُ",27,"د",1,0],["لَم تَكوني كَما زَعَمتُ وَلَكن","هالَني ما قَرَأتهُ في الكِتابِ",28,"ب",1,0],["لَم تَكُ إِلّا كَلا وَلا وَمَضَت","تَدفَعُ في صَدرِها يَدُ السَحَرِ",29,"ر",1,0],["لَم تَكوني لِتَصلُحي لِوَدادٍ","لِكَريمٍ كَحُلَّةِ العَنكَبوتِ",30,"ت",1,0],["لَم تُكفَهُ الخُضرُ مِن لُؤمٍ وَلا كَرَمٍ","وَلا تَجاوَزَ عَن موسى وَلا الخَضِرِ",31,"ر",1,0],["لَم تَكُن غَزوَةَ الجِيادِ وَلَم يُن","قَب بِآثارِها صُدورُ النِعالِ",32,"ل",1,0],["لم تَكَدْ أَمْناً تُكَدْ من حُكْمَ لا","تَقْصُصْ الرّؤيا عليهم يا بُنَي",33,"ي",1,0],["لم تكن أقوالي الجريئة إلا","نفثاتٍ يرمي بها المصدور",34,"ر",1,0],["لَمْ تَكْنْ بِالضَّعِيفِ يَوْمَ أُصِبْ","تَ الأَمْرَ وَالأَمْرُ مَطْمَعُ الأَقْوِيَاءِ",35,"ا",2,0],["لَمْ تكُنْ مُخْطِيءَ ارَّجَاءِ بِمَا اسْتَسْ","لَفْتَ مِنْ مَجْدِ هَذِهِ التَّكْرِمَاتِ",36,"ت",1,0],["لَمْ تكُونِي سِوَى شَمَائِلَ مِنْ عُلْ","وٍ تَرَاءَتْ فِي شِبْهِ مَاءٍ وَطِينِ",37,"ن",1,0],["لم تكن أولَ خلٍّ عقَّني","بعد ما ساقيتُهُ الوُدَّ مُداما",38,"م",2,0],["لم تكوني شهية الدفء لو لم","ترتعش في دمي اليك المحاعه",39,"ع",2,0],["لم تكن سلوةً لقلبي عمّا","أنا فيه إلا بأنّي أراك",40,"ك",1,0],["لم تكفِها الظُّلَمَ التي","غَشيتْ ولم تَهمُمْ بقدح زناد",41,"د",1,0],["لم تكفنا هذي المطامع فُرقةٍ","حتى تُفرِّقَ بيننا الأحقاد",42,"د",1,0],["لم تكفِني نكباتٌ قد أُخذتُ بها","حَتى نُكبتُ بأفكاري وآرائي",43,"ا",2,0],["لم تَكُنْ نُهْزَةَ الوَضِيعِ وَلا رُو","حُكَ كانَتْ لِفْقاً لرُوحِ الثّقيلِ",44,"ل",1,0],["لم تكتحِلْ مقلتُها سوى الكَحَل","ولا يحلّي جِيدها إلا العَطل",45,"ل",1,0],["لم تكتحل مقلتها سوى الكحل","ولا تحلَّى جيدها سوى العطل",46,"ل",1,0],["لَم تَكُن فيهُم السِيادة إِلّا","أَنَّهُم أَهلَها بِغَير اِحتِيال",47,"ل",1,0],["لم تكن عبرتي أفيكة أفا","كٍ ولا وجه حبنا بظنين",48,"ن",1,0],["لَم تَكُن مِن رِجَالِ مَيدَانِ ذَاكَ الش","شَيخِ يُعيِبكَ ذَلِكَ المَيدانُ",49,"ن",1,0],["لَم تَكُن سَامِعاً مِنَ الصَّوتِ فِيهَا","غَيرَ صَوتش الرِّيَاحِ إِلاَّ النَّئِيمَا",50,"م",2,0],["لَم تَكُ الآدِميَّ شَكلاً ولاَ طَب","عَاً ِإلى أن تُظَنَّ أصلاً كَرِيمَا",50,"م",2,0],["لَم تَكُن قَارِئاً ولَم تَكُ قُحًّا","مَضَغَ الشِّيحَ واجتني القَيصُومَا",50,"م",2,0],["لَم تَكُن شَاعِراً تُقَدَّمُ لِلش","شِعرِ إِذَا صَمَّمَ الهجاءُ الهُجُومَا",51,"م",2,0],["لَم تَكُن قِسمَةً ضِيزَى","بَينَ أَصحَابِي وَبَينِي",52,"ن",2,0],["لم تكذب في بعث وجدي بألحا","ظ اغن تحيي رميم الغرام",53,"م",1,0],["لَمْ تَكْتَسِبْ مِنْ رَبِّنَا","رُشْداً وَلاَ مَعُونَهْ",54,"ن",2,0],["لم تكن فازت بد فتر دارها","قبله فوز المعلّى بالقداح",55,"ح",1,0],["لم تكُن ديِّنةً لكنَّها","إن تجد ذا وَحشةٍ تستأنس",56,"س",1,0],["لَم تَكُن في النَسجِ ديباجَتُها","دونَ ديباجَةِ وَشي البُحترِيِّ",57,"ي",1,0],["لَم تَكُن تَزدَهيكَ بِالحُسنِ يَوماً","ظَبيَةٌ لا وَلا يَشوقُكَ ريمُ",58,"م",1,0],["لَم تكن إلّا ثَلاثاً واِنبرَت","بهمُ بُدنُ المَطايا تَتَرامى",59,"م",2,0],["لم تكدْ تسكنُ حتّ","ى قاربَ اللَّيلُ ختامه",60,"م",2,0],["لم تكنْ إِلاّ كشعبٍ ثائرٍ","شنَّها حرباً عَلَى المستعمرين",61,"ن",1,0],["لم تكن ذات لحظة رب شيء","فأفِق تشهد الربيب المريدا",62,"د",2,0],["لم تكن هذه المنى لي لو كا","نت فإني وهبتُها البائسينا",63,"ن",2,0],["لم تكُنْ يَعرُبٌ لِيُعْرِبَ عنها","معه النّاسُ أو يَعُدُّوا مَعَدّا",64,"د",2,0],["لم تكونوا كما يُحبُّ التآخي","كان جسمُ الخلافِ جسماً بَدينَا",65,"ن",2,0],["لم تكن الأحلامُ موسومةً","بالقُربِ في تاريخِها الأسبقِ",66,"ق",1,0],["لم تكن تغفل عن أمَّتن","وضلالاتِ بَنيها العابثين",67,"ن",1,0],["لم تكُن إلاّ كَظِلٍّ زَائلٍ","والمسَّراتُ تَلاشَى ثُمّ تَفْنى",68,"ن",2,0],["لم تكد تُحصى سجاياه الَّتي","رَفَعَ الله بها بيتَ المعالي",69,"ل",2,0],["لم تكنْ بالغةً منك عُلًى","طاوَلَتْ أعلى الجبال الشُّمّ طولا",70,"ل",2,0],["لم تكن تدري ومن أينَ لها","مَبْلَغُ العلم وما تعرفُ شاني",71,"ن",2,0],["لم تكونوا كالذي دبّ له","خَمَراً في مُلكه حتى أزالَهْ",72,"ل",2,0],["لم تك يا بازلُ في حملها","مقطِّراً تظلَعُ بالأوسقِ",73,"ق",1,0],["لم تك في الإيمان لي مقلِّداً","ولم يكن يُسرُك بي تخلُّقا",74,"ق",2,0],["لم تكن صدقت بأوّل مدحٍ","ضاق وقتٌ عن ملكه فاستعيرا",75,"ر",2,0],["لم تكُ كالفاتل في حباله","والدِّي