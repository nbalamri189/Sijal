,"https://www.poetsgate.com/ViewPoem.aspx?id=199311",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5453,"البندق","https://www.poetsgate.com/ViewPoem.aspx?id=28017",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[5542,"قلعة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=10191",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[2110,"صرف راح ما مسها كف عاصي","https://www.poetsgate.com/ViewPoem.aspx?id=156276",""],[5732,"فتى بني وايل","https://www.poetsgate.com/ViewPoem.aspx?id=177900",""],[5790,"قدست من ملكٍ عظيم الشان","https://www.poetsgate.com/ViewPoem.aspx?id=111870",""],[5847,"حينما بكت عمان .!!","https://www.poetsgate.com/ViewPoem.aspx?id=208953",""],[5910,"لغةُ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=206217",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[5943,"تشطير (الشّعرُ لي )","https://www.poetsgate.com/ViewPoem.aspx?id=138283",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[5979,"أخذت لحاظي من جنا خديك","https://www.poetsgate.com/ViewPoem.aspx?id=181346",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["صانَعتُ يَومَ فِراقِهِ","قَلباً قَدِ اِعتَنَقَ الغَليلا",0,"ل",2,0],["صانَ الظُبى وَاِستَلَذَّ الرَأيَ وَاِنكَشَفَت","لَهُ العَواقِبُ بَينَ الهَمِّ وَالجَذَلِ",1,"ل",1,0],["صانَكُما اللَهُ لِبُرءِ الوَرى","وَصانَهُ لِلعُرفِ وَالحَقِّ",2,"ق",1,0],["صَانِعُ الخَيْرِ دَافِعُ الضَّيْرِ كَشَّ","افُ الظُّلامَاتِ إِنْ دَعَا المَظْلُومُ",3,"م",1,0],["صانوا بها الأنسال من أمراضها","ومن الحقوق صيانة الأنسال",4,"ل",1,0],["صانت يداك عن الأنام وسائلي","وثني حماك عن البلاد عناني",5,"ن",2,0],["صان الحمى بجيوشٍ من مهارقه","لما أقلَّ من الأقلام خرصانا",6,"ن",2,0],["صانَ للفضلِ ذمَّةً وحوى العل","م جميعاً فلم تقل فيه إلا",7,"ل",2,0],["صانَ وجهي عن الورَى بأيادٍ","وأيادٍ غيَّرن حالي الزريّا",8,"ي",2,0],["صانعِ الأيرَ لِتُؤْتَى","إن في ظهرك حمَّهْ",9,"م",2,0],["صانُوا النفوسَ عن الفحشاء وابتذلوا","منهنّ في سُبُلِ العلياءِ ما صانوا",10,"ن",3,0],["صانَ الوزارة أحمدٌ عن معشرٍ","خُلِقُوا لِكاسبِ القُوت بالأستاه",11,"ه",1,0],["صانتْه صائنةٌ تُكافئُ سَعْيَهُ","وزَهَتْهُ من شرفِ الفَعال زَواهي",11,"ه",2,0],["صانَكُنَّ الإلهُ من ظُلْمةِ الرُّوحِ","ومن ضَلّة الضّميرِ المُريدِ",12,"د",1,0],["صانك الله","وأدام الآل",13,"ل",1,0],["صانَكَ اللَهُ مِن فَسادِ زَمانٍ","دَنَّسَ اللومُ مِن ثِيابِ رِجالِه",14,"ل",2,0],["صانَ الخَليفَةُ بِالأَبطالِ مُهجَتَهُ","صِيانَةَ الذَكَرِ الهِندِيَّ بِالخَلَلِ",15,"ل",1,0],["صانَ القِواريرَ خَوفَ العَزلِ في سَفَطٍ","فيهِ مَشارِطُ لا تُحصى وَأَجلامُ",16,"م",1,0],["صانَه عِرْضُه فنجَّاهُ منَّي","إنَّ عِرْضَ المِلحيِّ أمنعُ حِرْزِ",17,"ز",1,0],["صانعةٌ قلتُ لها أنت قدْ","عاشرتني سامعةً طائعَهْ",18,"ه",1,1],["صانِعٌ يُحسِنُ إنشاءَ النُّفوسْ","فَهْيَ في إشراقِها مِثلُ الشُّموسْ",19,"س",1,0],["صانَ الذّمارَ وأعلى شأنَهُ عَلَماً","صِينتْ به الحُرماتُ الغُرُّ والذِّمَمُ",20,"م",1,0],["صانوا بِحَدِّ السَيفِ حَوزَةَ مُلكِهِم","وَحِفاظَ كُلِّ مُشَيَّعٍ صَلَتانِ",21,"ن",1,0],["صانوا الكِتابَ فَصانَ اللَهُ دَولَتَهُم","وَاِستُؤصِلَت دُوَلٌ بِالسوءِ تَبغيها",22,"ي",3,0],["صانوا الخِلافَةَ فَاِستَطالَ لِواؤُها","كِبراً وَعَزَّ عَلى العَدُوِّ مَنالا",23,"ل",2,0],["صانوا الدِماءَ فَلَولا اللَهُ لَاِنبَجَسَت","تَعلو اليَفاعَ وَتَروي القاعَ وَالكُثُبا",24,"ب",2,0],["صانَك اللَهُ كَم فداك وَفي","أَو تحصين كَم أَبدت رِجالا",25,"ل",2,0],["صانَ أَسْرَارَه الخِتَامُ فلا الفَضْ","ضُ مُلِمٌّ بِهِ وَلا الإِفضاءُ",26,"ا",2,0],["صانَهُ الحُسْنُ وَالسّكِينَةُ أَنْ تُظ","هِرَ فيه آثارها البأساءُ",26,"ا",2,0],["صانَ النَّدَى أَعْراضَهُمْ وَزَهَتْ بهمْ","فكأَنما الأَزْهارُ في الأَكْمامِ",27,"م",1,0],["صانَهُ الجِدُّ وَالمَح","ضُ فَفيهِ ذِلٌّ وَفيهِ اِلتِهابُ",28,"ب",1,0],["صانَها التَّاجِرُ اليَهُودِيُّ حَولَي","نِ فأَذكى مِن نَشرِها التَّعتيقُ",29,"ق",1,0],["صَانَ أَعَرَاضَهُمْ وَصَانَ حِمَاهُمْ","مِنَ فَسَادٍ وَضَلَّةٍ وَشَقَاءِ",30,"ا",2,0],["صَانَتْ فؤَادَكَ مِنْ لَدُنْهِ عِنَايَةٌ","جَعَلَتْ شِفَاءَكَ لِلْعِنَايةِ مظْهَرَا",31,"ر",2,0],["صَانَكَ اللهُ وَالعَرُوسَ مَدِيداً","فِي سُرُورٍ وَنِعمَةٍ وَرِفاءِ",32,"ا",2,0],["صانه النبْلُ أن يُمَسَّ له ذَيْ","لٌ وأدَّى الإيمانُ فرض ذكاته",33,"ت",2,0],["صانَهُ اللّهُ في يَدَيْكَ فَخُذْهُ","وَتَقَدَّمْ بِهِ قَويّاً جَلِيدا",34,"د",2,0],["صانَ الإلَهُ لجيشِ الشرقِ عزَّتَهُ","وصَانَ أبطالَهُ الغُرَّ الميامينا",35,"ن",2,0],["صانَ الكَرامةَ أَن تُمَسَّ وَإِنّما","إِذلالُ نَفْسِ المَرْءِ من زَلاَّتِه",36,"ت",2,0],["صان الحواريُّون -بعدك- عهدهم","صون الكرام، وواصلوا المجهودا",37,"د",2,0],[".....صانه الجدُّ والم","فَفيه ذلٌّ وَفيه الْتهاب",38,"ب",1,0],["صانتْه صائنة ٌ تُكافيءُ سَعْيَهُ","وزَهَتْهُ من شرفِ الفَعال زَواهي",39,"ه",2,0],["صانت دم النفس التي حرمت","واعتمدت ذبح التي حلت",40,"ت",1,0],["صان الإله بهتكم اعراضهم","لك ذلك العرض المصون وطهرا",41,"ر",2,0],["صانَعوه مِن خَوفهم بِالهدايا","ليسَ يُغني عن الهدى الإهداءُ",42,"ا",2,0],["صانَ أسرارها وباحتْ بما في","صدرها من ودائعِ الأسرارِ",43,"ر",1,0],["صانك القبر عن الدنيا الغدور","إنما الدنيا غرورٌ في غرور",44,"ر",1,0],["صانك اللهُ مُبَقِّي مُعَلِّي","وَلَوى عنك حادثَ المقْدار",45,"ر",1,0],["صانك الله للمكارم والمج","د وأبقاك للعُلاَ والحُبُور",46,"ر",1,0],["صانَ قَدري عَن مَعشَرٍ يُحرَمُ السا","ئِلُ فيهِم وَيُمنَعُ الماعونُ",47,"ن",1,0],["صان العلا عن بذلها بصوارم","صون الجنان محله بالأضلع",48,"ع",1,0],["صانت محاسنك النُّعمى مجدّدةً","ثوباً من النضرِ تكسوهُ وتخلعه",49,"ع",2,0],["صانت بمُرهَفِها آياتِ مصحفِها","حتى أذلّت ذوي كفرٍ وإشراك",50,"ك",1,0],["صانَ التحيةَ حتى ما يبوح بها","إلى نسيمِ الصبا ضنّاً بنجواك",51,"ك",1,0],["صانَ اللّئيمُ وصُنتُ وَجْهي ما لَهُ","دُوني فلم يَبذُلْ ولم أتبَذَّل",52,"ل",1,0],["صانِعْ عدوّكَ تُكْفَه ومَنِ الّذي","للأعداءِ غيرَ مُصانع",53,"ع",1,0],["صانكَ الأقوى ليبقى منكَ أقوى","وليحمي بكَ أشباه الرِّجالِ",54,"ل",1,0],["صانَ في أحشائه الحبّ وقد","أَهْرَقَتْ أَجفانه الدَّمع المذالا",55,"ل",2,0],["صان أعراضَهُ وجادَ بما في","راحتَيْهِ فلن ترى مثلَ جودِه",56,"د",2,0],["صانت مبادئه السلامَ وإن تكن","حملت إباءَ الصُّلبِ يقدحُ نارا",57,"ر",2,0],["صانوا حمى أعراضِهم ومالهُم","وَذِيَّةٌ على الطريق تُنتقَدْ",58,"د",1,0],["صان اليهوديُّ خِدرَها أن يُفَ","ضَّ الخَتمُ أو تؤخذَ المقاليدُ",59,"د",1,0],["صانَ قِناعُ القُنوعِ وَجهي","صِيانَةَ الغِمدِ لِلحُسامِ",60,"م",1,1],["صانك الله عادك الإبلال","حفك اللطف زانك الإجلال",61,"ل",1,1],["صانها الإله به","فهي خير ما اكتسبا",62,"ب",2,0],["صان الإله فؤادي","لأنه بيت ودك",63,"ك",1,0],["صان الآله أبداً","بقدسه كمالهم",64,"م",1,0],["صانَهُ اللهُ من مَزالِقِ شطْحٍ","وغُرورٍ ومزجِ لَيٍّ بِلَيِّ",65,"ي",1,0],["صانَها عن سِوى عُلاكَ شِهابٌ","يا شِهاباً أضاءَ بالإشْراقِ",66,"ق",1,0],["صانوا من الدُّرِّ ما حازَتْ مباسِمُهُم","وما حوَوا منه في راحاتِهم بذَلوا",67,"ل",3,0],["صانت علاك فدار منها بالعلى","سور وفي يمنى يديك سوار",68,"ر",1,0],["صانوا بأعراضهم أعراضهم فغدا","شعري وسعري مصوناً غير مبتذل",69,"ل",1,0],["صانعتُ فيك معاشراً وكتمتُهمْ","وَجْدِي عليك وصَبْوَتِي ووساوسي",70,"س",2,0],["صانه الله وعما","قد حوى لا يتلاهى",71,"ا",3,0],["صانَ القريضَ عن الدَعوَى تفرُّدُها","بين الكرائمِ حتى ليسَ يُنتَحلُ",72,"ل",1,0],["صَانِعُ أَلْطَفٍ تَأَتَّى لَهَا","بِحِكْمَةٍ كِلْتَا يَدَيْهِ يَمِينْ",73,"ن",1,0],["صانُوهُ طاقَتَهُم عَمّا يُدَنِّسُهُ","كَما يَصُونُ نفِيسَ المالِ تجّارُ",74,"ر",1,0],["صانكَ اللّه مِن صروفِ الليالي","وحَباكَ الإله عُمراً طويلا",75,"ل",2,0],["صانهُ اللّه مِن صروفِ الليالي","وَوقاه الأهوالَ والأخطارا",76,"ر",2,0],["صانعُ المَجدِ ورُبَّانُ العُلَا","وفَتَى الخيرِ وزاكي النَّسَبِ",77,"ب",1,0],["صان منها الزجاج مثل الذي صا","ن من الوجنتين شف النقاب",78,"ب",1,0],["صانه اللّه من وزير به الحق","إلى الكامل المحق يؤب",79,"ب",1,0],["صانع لنفسك ما استطعتَ ولا تكن","لأسود بيشة مضغة للآكلِ",80,"ل",1,0],["صانت وجوه الطالبي عرفه","كف له تعرف بالبذل",81,"ل",1,0],["صَانَ بِهِ ردْفَهُ وَلِمْ لاَ","يَحْجُبُ مَا صَانَ وَهْوَ أسْوَدْ",82,"د",1,0],["صانَ الممالكَ واِرتَقى فعلا على","أهل الممالك 