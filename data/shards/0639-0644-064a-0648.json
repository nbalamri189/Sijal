gate.com/ViewPoem.aspx?id=191266",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[5397,"أفق من رقدة الآمال جفن","https://www.poetsgate.com/ViewPoem.aspx?id=157927",""],[5411,"جناح الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=189169",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5431,"تجلى في رحاب الروح نورا","https://www.poetsgate.com/ViewPoem.aspx?id=191738",""],[5431,"وسبحان من سواه اعجوبتي الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=197300",""],[5431,"غيومٌ به سكرى...","https://www.poetsgate.com/ViewPoem.aspx?id=198423",""],[5431,"والكلّ هالك ...","https://www.poetsgate.com/ViewPoem.aspx?id=198915",""],[5431,"وما الكره إلا هلاك سعى!!....","https://www.poetsgate.com/ViewPoem.aspx?id=199939",""],[5431,"الى حيّ الميدان الدمشقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202358",""],[5431,"يضحك الشفق...","https://www.poetsgate.com/ViewPoem.aspx?id=203089",""],[5431,"طبيب الفقراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=215177",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5438,"زَبَدُ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=202062",""],[5561,"أُمُّ الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=192738",""],[5561,"عروبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=213353",""],[1117,"ما أجملك","https://www.poetsgate.com/ViewPoem.aspx?id=19420",""],[5692,"ياقانصين الصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179109",""],[5781,"فاكهةُ الشّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202854",""],[5784,"يأسي يسرج حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=189746",""],[5790,"على وجه من أهوى غبارٌ فخلته","https://www.poetsgate.com/ViewPoem.aspx?id=112042",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5820,"فلا تسألونا بالسلاح فإنه","https://www.poetsgate.com/ViewPoem.aspx?id=201348",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[5948,"حبيبي لا يزورُ ولا يُزارُ","https://www.poetsgate.com/ViewPoem.aspx?id=100594",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[6125,"سكبتُ مدامعي سوداً فسودا","https://www.poetsgate.com/ViewPoem.aspx?id=212884",""],[6127,"إلى الأم في يومها","https://www.poetsgate.com/ViewPoem.aspx?id=203599",""],[6320,"قَافِلَةُ المَآسِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84338&r=&rc=35",""]],"verses":[["عَلى وَجهِ مَيٍّ مَسحَةٌ مِن مَلاحَةٍ","وَتَحتَ الثِيابِ الخِزيُ إِن كانَ بادِيا",0,"ي",2,0],["على وجهها خطّت علائم تهتدي","بها الناس في أوقاتها لمناها",1,"ا",3,0],["عَلَيَّ وَعِندي ما تُريدُ مِنَ الرِضا","فَما لَكَ غَضباناً عَلَيَّ وَمُعرِضا",2,"ض",2,1],["على ولاء أمين","وبطرس والآل",3,"ل",1,0],["عَلى وَجهِكَ المَيمونِ في كُلِّ غارَةٍ","صَلاةٌ تَوالى مِنهُمُ وَسَلامُ",4,"م",1,0],["عَلى وَدِّهِ لَو أُمُّهُ حينَ يَنتَمي","أَبوهُ وَحُزَّت مِنهُ عَشرُ الأَنامِلِ",5,"ل",1,0],["عَلَيَّ وَقَد كانوا يَخافونَ صَولَتي","وَيَرقَأُ بي فَيضُ العُيونِ الذَوارِفِ",6,"ف",1,0],["عَلى وَصلِها سِترٌ فَمَن لي بِهَتكِهِ","إِذا ما مَضى عَنّي منَ العمرِ هاتِكُه",7,"ك",2,0],["عليٌّ والزُّبيرُ لِكُلِّ عَضْبٍ","صقيلٍ منهما عَضْبٌ صَقِيلُ",8,"ل",1,0],["عَلى وُدِّهِ لَو كانَ ثُمَّ مُجيبَهُ","وَكانَ لَهُ نَدمانَ صِدقٍ مواتِيا",9,"ي",2,0],["عَلَيَّ وَإِنّي بِالقَليلِ مِن الَّذي","لَدَيكِ وَلَو صَرَّدتِهِ لِيَ قانِعُ",10,"ع",1,0],["عَلى واسِطٍ مِن رَبِّها أَلفُ لَعنَةٍ","وَتِسعَةُ آلافٍ عَلى أَهلِ واسِطِ",11,"ط",1,1],["عَلى وَجهِ مَعروفِ الكَريمِ بَشاشَةٌ","وَلَيسَ لِمَعروفِ البَخيلِ بَهاءُ",12,"ا",2,0],["على وجههِ سِيما المكارِم والعُلا","فضاءَتْ به الآمالُ وابتهجَ الشِّعرُ",13,"ر",1,0],["عَلَى وَجْهِهَا مِنْ مَغْرِبِ الشَّمْسِ مَسْحَةٌ","تُذِيبُ فُؤَادَ الْعَاشِقِ المُتَطَلِّعِ",14,"ع",1,0],["عَلَّ يَوْماً وَلاَ يَكُونُ بَعيداً","يَلْتَقي وَالمُنَى عَلَى ميعَادِ",15,"د",1,0],["على وجه سورية جديد تحيتي","إلى سابقات فيه مؤتلقات",16,"ت",1,0],["على وزن منين إحداهُما","تقلّ بها الكف شيئا رزينا",17,"ن",2,0],["على وحشة في السجن من بغتة الفنا","وما خلف يوم الموت كيف المفازع",18,"ع",1,0],["علي وعثمان ويعقوب لا عدا","رضا الله ذاك النجل والأب والجدا",19,"د",2,0],["على وجهِهِ سِيماءُ أصيدَ أشوسٍ","وفيه من النفس الطَّموحِ علائم",20,"م",1,0],["عَلَى وَدِّهِ لَوْ أُمُّهُ حِينَ يَنْتمِي","أَبُوهُ ، وجُزَّتْ مِنهُ عَشْرُ الأَناملِ",21,"ل",1,0],["عليّ والبكا والنوح ضربه لازب","وإنذي لأبكي أنّني لست باكيا",22,"ي",2,0],["عليّ وجرّبني ما اعتدى","وفي الذاهبينَ وفى منْ وفى",23,"ا",1,0],["علىَ وَجْهِ الْحَيَاةِ مَدَارُ دَهْرٍ","وَفِي عُمْرِ الزَّمَانِ مَضَى زَمَانُ",24,"ن",1,1],["على وجهِ الذي أجنى بَناني","ثماراً للمكارمِ وهْوَ غَرْسي",25,"س",2,0],["عَلى وجهِ كلٍّ من ظلامٍ علامةٌ","بهِ عرّفت مَن لم يكُن يعرفُ الأَمرا",26,"ر",2,0],["عَليَّ واللَه فيما شيَّعوا كذبوا","ككذْبِ أولاد يعقوبٍ على الذيبِ",27,"ب",1,0],["عَلى وائِلٍ إِذ يُنزِلُ الكَلبَ مائِحاً","وَإِذ يُمنَعُ الأَكلاءَ مِنها حُلولُها",28,"ل",3,0],["عُليْوةُ إن الدمعَ أفشى وخبَّرا","بأسرارِنا لمّا بَلَلْنا به الثرى",29,"ر",2,1],["عليّ وقارٌ مَعْ سَكِينةِ هَيْبَة","ومِنْ عَبْرَتِي تِبْرٌ يَسيِلُ بِوَجْنَتي",30,"ي",1,0],["عَلى وَجهِهِ صِبغُ الدُجى فَحَسِبتهُ","نَهارٌ بِهِ شَمسُ المُنيرَةِ تُشرِقُ",31,"ق",1,0],["على وجهكِ الباهي ربيعُ بلادِنا","وحسنُكِ عمرٌ يا مليحةُ لا فصل",32,"ل",1,0],["على واحدٍ منهم إذا هبَّتِ الصَّبا","أرى فلذةً من مُهجتي سَقطت منّي",33,"ن",2,0],["علَى وَسْمِهِ أمْضَيْتُ فَأْلِيَ وَاسمُه","فَلا ونَدَاه الغَمْر ما الفَأْلُ فائِلُ",34,"ل",1,0],["على وجهه نورُ الهدى وبكفّه","مفاتيحُ بابِ المبهم المتغلِّقِ",35,"ق",1,0],["عَلى وَردِهِ المُحمَرِّ دَبَّت نِمالُهُ","إِلى أُقحُوانِ الثَغرِ في عَسَلِ الفَمِ",36,"م",1,0],["عَلى وَردٍ كَأَنَّ بِهِ خُدودَ ال","غَواني نافِحاتٌ بِالغَوالي",37,"ل",2,0],["على وفق ما قال خير الورى","وقال الوصي إما السداد",38,"د",1,0],["عَلى ولدٍ وَزين الناس طرّاً","إِذا ما النارُ لَم ترَ مَن صلاها",39,"ا",3,0],["عَلَيَّ وَلا تَعجَل دَواؤُكَ فَاِنتَظِر","بَقِيَّةَ حِلمٍ شارَفَت أَن تَصَرَّما",40,"م",2,0],["عَلِيٌّ وَلِيُّ المُؤمِنينَ لَدَيكُمُ","وَمَولاكُم مِن بَين كُلِّ الأَعاظِم",41,"م",1,1],["على وَحدٍ طاوٍ أقرّت فؤاده","كلابُ ذريح أو كلابُ ابن مِيزن",42,"ن",1,0],["على وجهه من خالص اللؤم شاهد","متى استشْهَدَتْهُ رؤية العين تشهد",43,"د",1,0],["عليّ وقد جرتم مدى البعد لذتي","حرام ورفق العيش غير محرم",44,"م",1,0],["على وعلك في التحادثِ نرتضى","بعضَ العزاءِ وأستقيه مُدامي",45,"م",2,0],["على وادٍ ولمَّا يزكُ عُشْبٌ","إلى قُلُبٍ ولمّا يُسنِ مُسنِي",46,"ن",2,0],["على وجه مرآة الزمان وللصَّبا","بوادرب يجلو مرُّها صدأ السحب",47,"ب",1,0],["على وجهه المصفر آثار خيبة","تناسب سكناه بأسفل طابق",48,"ق",1,0],["على ولي اللَه وصفا وصورة","ولكن في المعنى مشيح ويوشع",49,"ع",1,0],["عَلى وَاحِدٍ قَد كَانَ لي فَفَقَدتُهُ","عَلى غِرَّةٍ فَقدَ الجَوانِحِ لِلقَلبِ",50,"ب",1,0],["على وجههِ من سُورةِ النُّور آيةٌ","وفي سيفهِ من سورةِ الفَتْحِ والنَّصْرِ",51,"ر",1,0],["على وجههِ المسعودِ ألفُ تحيَّةٍ","من اللهِ تأتي بالسَّلامِ وبالبَرْدِ",52,"د",1,0],["على وَجهِهِ نُورُ الجمالِ يزِينُهُ","طَلاقةُ بِشرٍ فوقَهُ يَستَفيدُها",53,"د",3,0],["عليَّ ولي في الدَّهرِ همٌّ وفرحةٌ","فيا ليت أَنِّ لا عليَّ ولا لِيَا",54,"ي",2,0],["عليٌّ وعثمانٌ أَبُوهُ وجدُّه","عَلى قولِه حَاشا عليّاً وعُثْمانا",55,"ن",2,1],["عليٌّ وصيُّ المصطفى وابنُ عمِّهِ","وأوّلُ من صلّى ووحّد فاعلمِ",56,"م",1,0],["عليٌّ وليّ الحوضِ والذائدُ الذي","يُذَبِّبُ عن أرجائه كلَّ مُجرِمِ",56,"م",1,0],["عليٍّ وما كان من عَمَّه","بردِّ الإمامةِ عَطفَ العِنانِ",57,"ن",1,0],["عليٌّ والثلاثةُ من بنيهِ","هم أسباطُه والأوصياءُ",58,"ا",2,0],["عليٌّ وأبو ذرٍّ","ومقدادٌ وسَلمانُ",59,"ن",1,1],["عليٌّ وصيُّ المصطفى ووزيرُه","وناصرُه والبيضُ بالبيضِ تُقرَعُ",60,"ع",1,0],["على وجههِ الضاحي الوسيم الذي له","بقلبي رسمٌ لا يفارقهُ العُمرا",61,"ر",2,0],["على وجهه نور النبوة ساطع","مبين كما في الليل تجلو الكواكب",62,"ب",1,0],["على وجهها من لونِ وجهيَ صفرةٌ","وأحشايَ من أحشائها تتوقد",63,"د",1,0],["عَلى وجه ميٍّ مسحةٌ من ملاحةٍ","وَتحتَ الثيابِ الخزيُ لَو كان بادِيا",64,"ي",2,0],