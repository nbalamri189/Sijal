{"poems":[[30,"ألا حبذا أهل الملا غير أنه","https://www.aldiwan.net/poem29429.html","الطويل"],[88,"وخرساء لم ينطق بحرف لسانها","https://www.aldiwan.net/poem44449.html","الطويل"],[70,"علي وعندي ما تريد من الرضا","https://www.aldiwan.net/poem42844.html","الطويل"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[43,"أراع كذا كل الملوك همام","https://www.aldiwan.net/poem10525.html","الطويل"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[28,"أرى شعراء الناس غيري كأنهم","https://www.aldiwan.net/poem5321.html","الطويل"],[80,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[105,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[21,"ومرهنة عند الغراب حبيبه","https://www.aldiwan.net/poem36137.html","الطويل"],[40,"أقول بأعلى نخلتين وقد مضى","https://www.aldiwan.net/poem42330.html","الطويل"],[50,"على واسط من ربها ألف لعنة","https://www.aldiwan.net/poem62350.html","الطويل"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[76,"هلال نماه المجد واختاره الفخر","https://www.aldiwan.net/poem39316.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142044","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[77,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[45,"أَمَا كَانَ في تَلْكَ الدُّموعِ السَّوائلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32192",""],[91,"حنة مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=53395",""],[75,"ألا كلُّ آتٍ قريبُ المَدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""],[158,"سيد الشهور","https://www.aldiwan.net/poem23652.html","الوافر"],[167,"فدتك النفس يا قمري وشمسي","https://www.aldiwan.net/poem47042.html","الوافر"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[205,"قالوا ولو صح ما قالوا لفزت به","https://www.aldiwan.net/poem53360.html","البسيط"],[208,"كما كان يبغيها كليب بظلمه","https://www.aldiwan.net/poem27910.html","الطويل"],[213,"عليوة إن الدمع أفشى وخبرا","https://www.aldiwan.net/poem37887.html","الطويل"],[213,"أتزعم يا جاري وسؤلي ومنيتي","https://www.aldiwan.net/poem37911.html","الطويل"],[233,"لبرق الحمى عهد علي وموثق","https://www.aldiwan.net/poem14835.html","الطويل"],[271,"قد اجتمعت فيك المحاسن يا جمل","https://www.aldiwan.net/poem35426.html","الطويل"],[271,"تطاير من قلبي الشرار ومن جفني","https://www.aldiwan.net/poem35594.html","الطويل"],[276,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[279,"سرى موهناً طيف الخيال المؤرق","https://www.aldiwan.net/poem2481.html","الطويل"],[283,"عجبت ولكن من ملامة لومي","https://www.aldiwan.net/poem32448.html","الطويل"],[283,"شكوت فلم يرق لضعف حالي","https://www.aldiwan.net/poem32662.html","الوافر"],[305,"أدر ذكر سلمى وذكر سعاد","https://www.aldiwan.net/poem16870.html","المتقارب"],[342,"كأن العين خالطها قذاها","https://www.aldiwan.net/poem2237.html","الوافر"],[367,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[394,"علي ولي المؤمنين لديكم","https://www.aldiwan.net/poem53442.html","الطويل"],[397,"أبينت رسم الدار أم لم تُبينِ","https://www.aldiwan.net/poem621.html",""],[417,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[438,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[454,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[459,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[465,"خليلي ما بال الكؤوس عواطلا","https://www.aldiwan.net/poem3524.html","عموديه"],[480,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[505,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[507,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[563,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[563,"إذا رمت نظم الشعر في مدح ذي الرشد","https://www.aldiwan.net/poem52781.html","الطويل"],[563,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[576,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[576,"علي وعثمان أبوه وجده","https://www.aldiwan.net/poem2797.html","الطويل"]],"verses":[["عَلى وَجهِ مَيٍّ مَسحَةٌ مِن مَلاحَةٍ","وَتَحتَ الثِيابِ الخِزيُ إِن كانَ بادِيا",0,"ي",2,0],["على وجهها خطّت علائم تهتدي","بها الناس في أوقاتها لمناها",1,"ا",3,0],["عَلَيَّ وَعِندي ما تُريدُ مِنَ الرِضا","فَما لَكَ غَضباناً عَلَيَّ وَمُعرِضا",2,"ض",2,1],["على ولاء أمين","وبطرس والآل",3,"ل",1,0],["عَلى وَجهِكَ المَيمونِ في كُلِّ غارَةٍ","صَلاةٌ تَوالى مِنهُمُ وَسَلامُ",4,"م",1,0],["عَلى وَدِّهِ لَو أُمُّهُ حينَ يَنتَمي","أَبوهُ وَحُزَّت مِنهُ عَشرُ الأَنامِلِ",5,"ل",1,0],["عَلَيَّ وَقَد كانوا يَخافونَ صَولَتي","وَيَرقَأُ بي فَيضُ العُيونِ الذَوارِفِ",6,"ف",1,0],["عَلى وَصلِها سِترٌ فَمَن لي بِهَتكِهِ","إِذا ما مَضى عَنّي منَ العمرِ هاتِكُه",7,"ك",2,0],["عليٌّ والزُّبيرُ لِكُلِّ عَضْبٍ","صقيلٍ منهما عَضْبٌ صَقِيلُ",8,"ل",1,0],["عَلى وُدِّهِ لَو كانَ ثُمَّ مُجيبَهُ","وَكانَ لَهُ نَدمانَ صِدقٍ مواتِيا",9,"ي",2,0],["عَلَيَّ وَإِنّي بِالقَليلِ مِن الَّذي","لَدَيكِ وَلَو صَرَّدتِهِ لِيَ قانِعُ",10,"ع",1,0],["عَلى واسِطٍ مِن رَبِّها أَلفُ لَعنَةٍ","وَتِسعَةُ آلافٍ عَلى أَهلِ واسِطِ",11,"ط",1,1],["عَلى وَجهِ مَعروفِ الكَريمِ بَشاشَةٌ","وَلَيسَ لِمَعروفِ البَخيلِ بَهاءُ",12,"ا",2,0],["على وجههِ سِيما المكارِم والعُلا","فضاءَتْ به الآمالُ وابتهجَ الشِّعرُ",13,"ر",1,0],["عَلَى وَجْهِهَا مِنْ مَغْرِبِ الشَّمْسِ مَسْحَةٌ","تُذِيبُ فُؤَادَ الْعَاشِقِ المُتَطَلِّعِ",14,"ع",1,0],["عَلَّ يَوْماً وَلاَ يَكُونُ بَعيداً","يَلْتَقي وَالمُنَى عَلَى ميعَادِ",15,"د",1,0],["على وجه سورية جديد تحيتي","إلى سابقات فيه مؤتلقات",16,"ت",1,0],["على وزن منين إحداهُما","تقلّ بها الكف شيئا رزينا",17,"ن",2,0],["علي وعثمان ويعقوب لا عدا","رضا الله ذاك النجل والأب والجدا",18,"د",2,0],["على وجهِهِ سِيماءُ أصيدَ أشوسٍ","وفيه من النفس الطَّموحِ علائم",19,"م",1,0],["عَلَى وَدِّهِ لَوْ أُمُّهُ حِينَ يَنْتمِي","أَبُوهُ ، وجُزَّتْ مِنهُ عَشْرُ الأَناملِ",20,"ل",1,0],["عليّ والبكا والنوح ضربه لازب","وإنذي لأبكي أنّني لست باكيا",21,"ي",2,0],["عليّ وجرّبني ما اعتدى","وفي الذاهبينَ وفى منْ وفى",22,"ا",1,0],["علىَ وَجْهِ الْحَيَاةِ مَدَارُ دَهْرٍ","وَفِي عُمْرِ الزَّمَانِ مَضَى زَمَانُ",23,"ن",1,1],["على وجهِ الذي أجنى بَناني","ثماراً للمكارمِ وهْوَ غَرْسي",24,"س",2,0],["عَلى وجهِ كلٍّ من ظلامٍ علامةٌ","بهِ عرّفت مَن لم يكُن يعرفُ الأَمرا",25,"ر",2,0],["عَليَّ واللَه فيما شيَّعوا كذبوا","ككذْبِ أولاد يعقوبٍ على الذيبِ",26,"ب",1,0],["عَلى وائِلٍ إِذ يُنزِلُ الكَلبَ مائِحاً","وَإِذ يُمنَعُ الأَكلاءَ مِنها حُلولُها",27,"ل",3,0],["عُليْوةُ إن الدمعَ أفشى وخبَّرا","بأسرارِنا لمّا بَلَلْنا به الثرى",28,"ر",2,1],["عليّ وقارٌ مَعْ سَكِينةِ هَيْبَة","ومِنْ عَبْرَتِي تِبْرٌ يَسيِلُ بِوَجْنَتي",29,"ي",1,0],["عَلى وَجهِهِ صِبغُ الدُجى فَحَسِبتهُ","نَهارٌ بِهِ شَمسُ المُنيرَةِ تُشرِقُ",30,"ق",1,0],["على وجهكِ الباهي ربيعُ بلادِنا","وحسنُكِ عمرٌ يا مليحةُ لا فصل",31,"ل",1,0],["على واحدٍ منهم إذا هبَّتِ الصَّبا","أرى فلذةً من مُهجتي سَقطت منّي",32,"ن",2,0],["علَى وَسْمِهِ أمْضَيْتُ فَأْلِيَ وَاسمُه","فَلا ونَدَاه الغَمْر ما الفَأْلُ فائِلُ",33,"ل",1,0],["على وجهه نورُ الهدى وبكفّه","مفاتيحُ بابِ المبهم المتغلِّقِ",34,"ق",1,0],["عَلى وَردِهِ المُحمَرِّ دَبَّت نِمالُهُ","إِلى أُقحُوانِ الثَغرِ في عَسَلِ الفَمِ",35,"م",1,0],["عَلى وَردٍ كَأَنَّ بِهِ خُدودَ ال","غَواني نافِحاتٌ بِالغَوالي",36,"ل",2,0],["على وفق ما قال خير الورى","وقال الوصي إما السداد",37,"د",1,0],["عَلى ولدٍ وَزين الناس طرّاً","إِذا ما النارُ لَم ترَ مَن صلاها",38,"ا",3,0],["عَلَيَّ وَلا تَعجَل دَواؤُكَ فَاِنتَظِر","بَقِيَّةَ حِلمٍ شارَفَت أَن تَصَرَّما",39,"م",2,0],["عَلِيٌّ وَلِيُّ المُؤمِنينَ لَدَيكُمُ","وَمَولاكُم مِن بَين كُلِّ الأَعاظِم",40,"م",1,1],["على وَحدٍ طاوٍ أقرّت فؤاده","كلابُ ذريح أو كلابُ ابن مِيزن",41,"ن",1,0],["على وجهه من خالص اللؤم شاهد","متى استشْهَدَتْهُ رؤية العين تشهد",42,"د",1,0],["عليّ وقد جرتم مدى البعد لذتي","حرام ورفق العيش غير محرم",43,"م",1,0],["على وعلك في التحادثِ نرتضى","بعضَ العزاءِ وأستقيه مُدامي",44,"م",2,0],["على وادٍ ولمَّا يزكُ عُشْبٌ","إلى قُلُبٍ ولمّا يُسنِ مُسنِي",45,"ن",2,0],["على وجه مرآة الزمان وللصَّبا","بوادرب يجلو مرُّها صدأ السحب",46,"ب",1,0],["على وجهه المصفر آثار خيبة","تناسب سكناه بأسفل طابق",47,"ق",1,0],["على ولي اللَه وصفا وصورة","ولكن في المعنى مشيح ويوشع",48,"ع",1,0],["عَلى وَاحِدٍ قَد كَانَ لي فَفَقَدتُهُ","عَلى غِرَّةٍ فَقدَ الجَوانِحِ لِلقَلبِ",49,"ب",1,0],["على وجههِ من سُورةِ النُّور آيةٌ","وفي سيفهِ من سورةِ الفَتْحِ والنَّصْرِ",50,"ر",1,0],["على وجههِ المسعودِ ألفُ تحيَّةٍ","من اللهِ تأتي بالسَّلامِ وبالبَرْدِ",51,"د",1,0],["على وَجهِهِ نُورُ الجمالِ يزِينُهُ","طَلاقةُ بِشرٍ فوقَهُ يَستَفيدُها",52,"د",3,0],["عليَّ ولي في الدَّهرِ همٌّ وفرحةٌ","فيا ليت أَنِّ لا عليَّ ولا لِيَا",53,"ي",2,0],["عليٌّ وعثمانٌ أَبُوهُ وجدُّه","عَلى قولِه حَاشا عليّاً وعُثْمانا",54,"ن",2,1]]}