{"poems":[[32,"ألا حبذا أهل الملا غير أنه","https://www.aldiwan.net/poem29429.html","الطويل"],[90,"وخرساء لم ينطق بحرف لسانها","https://www.aldiwan.net/poem44449.html","الطويل"],[72,"علي وعندي ما تريد من الرضا","https://www.aldiwan.net/poem42844.html","الطويل"],[87,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[45,"أراع كذا كل الملوك همام","https://www.aldiwan.net/poem10525.html","الطويل"],[47,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[30,"أرى شعراء الناس غيري كأنهم","https://www.aldiwan.net/poem5321.html","الطويل"],[82,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[21,"ومرهنة عند الغراب حبيبه","https://www.aldiwan.net/poem36137.html","الطويل"],[42,"أقول بأعلى نخلتين وقد مضى","https://www.aldiwan.net/poem42330.html","الطويل"],[52,"على واسط من ربها ألف لعنة","https://www.aldiwan.net/poem62350.html","الطويل"],[52,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[78,"هلال نماه المجد واختاره الفخر","https://www.aldiwan.net/poem39316.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142044","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[79,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[47,"أَمَا كَانَ في تَلْكَ الدُّموعِ السَّوائلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32192",""],[93,"حنة مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=53395",""],[77,"ألا كلُّ آتٍ قريبُ المَدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""],[161,"سيد الشهور","https://www.aldiwan.net/poem23652.html","الوافر"],[170,"فدتك النفس يا قمري وشمسي","https://www.aldiwan.net/poem47042.html","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[208,"قالوا ولو صح ما قالوا لفزت به","https://www.aldiwan.net/poem53360.html","البسيط"],[211,"كما كان يبغيها كليب بظلمه","https://www.aldiwan.net/poem27910.html","الطويل"],[216,"عليوة إن الدمع أفشى وخبرا","https://www.aldiwan.net/poem37887.html","الطويل"],[216,"أتزعم يا جاري وسؤلي ومنيتي","https://www.aldiwan.net/poem37911.html","الطويل"],[236,"لبرق الحمى عهد علي وموثق","https://www.aldiwan.net/poem14835.html","الطويل"],[274,"قد اجتمعت فيك المحاسن يا جمل","https://www.aldiwan.net/poem35426.html","الطويل"],[274,"تطاير من قلبي الشرار ومن جفني","https://www.aldiwan.net/poem35594.html","الطويل"],[279,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[282,"سرى موهناً طيف الخيال المؤرق","https://www.aldiwan.net/poem2481.html","الطويل"],[286,"عجبت ولكن من ملامة لومي","https://www.aldiwan.net/poem32448.html","الطويل"],[286,"شكوت فلم يرق لضعف حالي","https://www.aldiwan.net/poem32662.html","الوافر"],[308,"أدر ذكر سلمى وذكر سعاد","https://www.aldiwan.net/poem16870.html","المتقارب"],[345,"كأن العين خالطها قذاها","https://www.aldiwan.net/poem2237.html","الوافر"],[370,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[397,"علي ولي المؤمنين لديكم","https://www.aldiwan.net/poem53442.html","الطويل"],[400,"أبينت رسم الدار أم لم تُبينِ","https://www.aldiwan.net/poem621.html",""],[420,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[441,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[456,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[461,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[467,"خليلي ما بال الكؤوس عواطلا","https://www.aldiwan.net/poem3524.html","عموديه"],[482,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[507,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[509,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[565,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[565,"إذا رمت نظم الشعر في مدح ذي الرشد","https://www.aldiwan.net/poem52781.html","الطويل"],[565,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[578,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[578,"علي وعثمان أبوه وجده","https://www.aldiwan.net/poem2797.html","الطويل"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/29562","الطويل"]],"verses":[["عَلى وَجهِ مَيٍّ مَسحَةٌ مِن مَلاحَةٍ","وَتَحتَ الثِيابِ الخِزيُ إِن كانَ بادِيا",0,"ي",2,0],["على وجهها خطّت علائم تهتدي","بها الناس في أوقاتها لمناها",1,"ا",3,0],["عَلَيَّ وَعِندي ما تُريدُ مِنَ الرِضا","فَما لَكَ غَضباناً عَلَيَّ وَمُعرِضا",2,"ض",2,1],["على ولاء أمين","وبطرس والآل",3,"ل",1,0],["عَلى وَجهِكَ المَيمونِ في كُلِّ غارَةٍ","صَلاةٌ تَوالى مِنهُمُ وَسَلامُ",4,"م",1,0],["عَلى وَدِّهِ لَو أُمُّهُ حينَ يَنتَمي","أَبوهُ وَحُزَّت مِنهُ عَشرُ الأَنامِلِ",5,"ل",1,0],["عَلَيَّ وَقَد كانوا يَخافونَ صَولَتي","وَيَرقَأُ بي فَيضُ العُيونِ الذَوارِفِ",6,"ف",1,0],["عَلى وَصلِها سِترٌ فَمَن لي بِهَتكِهِ","إِذا ما مَضى عَنّي منَ العمرِ هاتِكُه",7,"ك",2,0],["عليٌّ والزُّبيرُ لِكُلِّ عَضْبٍ","صقيلٍ منهما عَضْبٌ صَقِيلُ",8,"ل",1,0],["عَلى وُدِّهِ لَو كانَ ثُمَّ مُجيبَهُ","وَكانَ لَهُ نَدمانَ صِدقٍ مواتِيا",9,"ي",2,0],["عَلَيَّ وَإِنّي بِالقَليلِ مِن الَّذي","لَدَيكِ وَلَو صَرَّدتِهِ لِيَ قانِعُ",10,"ع",1,0],["عَلى واسِطٍ مِن رَبِّها أَلفُ لَعنَةٍ","وَتِسعَةُ آلافٍ عَلى أَهلِ واسِطِ",11,"ط",1,1],["عَلى وَجهِ مَعروفِ الكَريمِ بَشاشَةٌ","وَلَيسَ لِمَعروفِ البَخيلِ بَهاءُ",12,"ا",2,0],["على وجههِ سِيما المكارِم والعُلا","فضاءَتْ به الآمالُ وابتهجَ الشِّعرُ",13,"ر",1,0],["عَلَى وَجْهِهَا مِنْ مَغْرِبِ الشَّمْسِ مَسْحَةٌ","تُذِيبُ فُؤَادَ الْعَاشِقِ المُتَطَلِّعِ",14,"ع",1,0],["عَلَّ يَوْماً وَلاَ يَكُونُ بَعيداً","يَلْتَقي وَالمُنَى عَلَى ميعَادِ",15,"د",1,0],["على وجه سورية جديد تحيتي","إلى سابقات فيه مؤتلقات",16,"ت",1,0],["على وزن منين إحداهُما","تقلّ بها الكف شيئا رزينا",17,"ن",2,0],["على وحشة في السجن من بغتة الفنا","وما خلف يوم الموت كيف المفازع",18,"ع",1,0],["علي وعثمان ويعقوب لا عدا","رضا الله ذاك النجل والأب والجدا",19,"د",2,0],["على وجهِهِ سِيماءُ أصيدَ أشوسٍ","وفيه من النفس الطَّموحِ علائم",20,"م",1,0],["عَلَى وَدِّهِ لَوْ أُمُّهُ حِينَ يَنْتمِي","أَبُوهُ ، وجُزَّتْ مِنهُ عَشْرُ الأَناملِ",21,"ل",1,0],["عليّ والبكا والنوح ضربه لازب","وإنذي لأبكي أنّني لست باكيا",22,"ي",2,0],["عليّ وجرّبني ما اعتدى","وفي الذاهبينَ وفى منْ وفى",23,"ا",1,0],["علىَ وَجْهِ الْحَيَاةِ مَدَارُ دَهْرٍ","وَفِي عُمْرِ الزَّمَانِ مَضَى زَمَانُ",24,"ن",1,1],["على وجهِ الذي أجنى بَناني","ثماراً للمكارمِ وهْوَ غَرْسي",25,"س",2,0],["عَلى وجهِ كلٍّ من ظلامٍ علامةٌ","بهِ عرّفت مَن لم يكُن يعرفُ الأَمرا",26,"ر",2,0],["عَليَّ واللَه فيما شيَّعوا كذبوا","ككذْبِ أولاد يعقوبٍ على الذيبِ",27,"ب",1,0],["عَلى وائِلٍ إِذ يُنزِلُ الكَلبَ مائِحاً","وَإِذ يُمنَعُ الأَكلاءَ مِنها حُلولُها",28,"ل",3,0],["عُليْوةُ إن الدمعَ أفشى وخبَّرا","بأسرارِنا لمّا بَلَلْنا به الثرى",29,"ر",2,1],["عليّ وقارٌ مَعْ سَكِينةِ هَيْبَة","ومِنْ عَبْرَتِي تِبْرٌ يَسيِلُ بِوَجْنَتي",30,"ي",1,0],["عَلى وَجهِهِ صِبغُ الدُجى فَحَسِبتهُ","نَهارٌ بِهِ شَمسُ المُنيرَةِ تُشرِقُ",31,"ق",1,0],["على وجهكِ الباهي ربيعُ بلادِنا","وحسنُكِ عمرٌ يا مليحةُ لا فصل",32,"ل",1,0],["على واحدٍ منهم إذا هبَّتِ الصَّبا","أرى فلذةً من مُهجتي سَقطت منّي",33,"ن",2,0],["علَى وَسْمِهِ أمْضَيْتُ فَأْلِيَ وَاسمُه","فَلا ونَدَاه الغَمْر ما الفَأْلُ فائِلُ",34,"ل",1,0],["على وجهه نورُ الهدى وبكفّه","مفاتيحُ بابِ المبهم المتغلِّقِ",35,"ق",1,0],["عَلى وَردِهِ المُحمَرِّ دَبَّت نِمالُهُ","إِلى أُقحُوانِ الثَغرِ في عَسَلِ الفَمِ",36,"م",1,0],["عَلى وَردٍ كَأَنَّ بِهِ خُدودَ ال","غَواني نافِحاتٌ بِالغَوالي",37,"ل",2,0],["على وفق ما قال خير الورى","وقال الوصي إما السداد",38,"د",1,0],["عَلى ولدٍ وَزين الناس طرّاً","إِذا ما النارُ لَم ترَ مَن صلاها",39,"ا",3,0],["عَلَيَّ وَلا تَعجَل دَواؤُكَ فَاِنتَظِر","بَقِيَّةَ حِلمٍ شارَفَت أَن تَصَرَّما",40,"م",2,0],["عَلِيٌّ وَلِيُّ المُؤمِنينَ لَدَيكُمُ","وَمَولاكُم مِن بَين كُلِّ الأَعاظِم",41,"م",1,1],["على وَحدٍ طاوٍ أقرّت فؤاده","كلابُ ذريح أو كلابُ ابن مِيزن",42,"ن",1,0],["على وجهه من خالص اللؤم شاهد","متى استشْهَدَتْهُ رؤية العين تشهد",43,"د",1,0],["عليّ وقد جرتم مدى البعد لذتي","حرام ورفق العيش غير محرم",44,"م",1,0],["على وعلك في التحادثِ نرتضى","بعضَ العزاءِ وأستقيه مُدامي",45,"م",2,0],["على وادٍ ولمَّا يزكُ عُشْبٌ","إلى قُلُبٍ ولمّا يُسنِ مُسنِي",46,"ن",2,0],["على وجه مرآة الزمان وللصَّبا","بوادرب يجلو مرُّها صدأ السحب",47,"ب",1,0],["على وجهه المصفر آثار خيبة","تناسب سكناه بأسفل طابق",48,"ق",1,0],["على ولي اللَه وصفا وصورة","ولكن في المعنى مشيح ويوشع",49,"ع",1,0],["عَلى وَاحِدٍ قَد كَانَ لي فَفَقَدتُهُ","عَلى غِرَّةٍ فَقدَ الجَوانِحِ لِلقَلبِ",50,"ب",1,0],["على وجههِ من سُورةِ النُّور آيةٌ","وفي سيفهِ من سورةِ الفَتْحِ والنَّصْرِ",51,"ر",1,0],["على وجههِ المسعودِ ألفُ تحيَّةٍ","من اللهِ تأتي بالسَّلامِ وبالبَرْدِ",52,"د",1,0],["على وَجهِهِ نُورُ الجمالِ يزِينُهُ","طَلاقةُ بِشرٍ فوقَهُ يَستَفيدُها",53,"د",3,0],["عليَّ ولي في الدَّهرِ همٌّ وفرحةٌ","فيا ليت أَنِّ لا عليَّ ولا لِيَا",54,"ي",2,0],["عليٌّ وعثمانٌ أَبُوهُ وجدُّه","عَلى قولِه حَاشا عليّاً وعُثْمانا",55,"ن",2,1],["عَلَيَّ وَكانوا أَهلَ عِزٍّ مُقَدَّمٍ","وَمَجدٍ إِذا ما حَوَّضَ المَجدَ نائِلي",56,"ل",2,0]]}