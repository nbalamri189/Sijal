{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[91,"من بعد ما انتظرت حقابا","https://www.aldiwan.net/poem44746.html","مجزوء الكامل"],[82,"أسعاد إن كمال خلقك راعني","https://www.aldiwan.net/poem31405.html","الكامل"],[435,"زارت فكان بأمر الله اسراها","https://www.aldiwan.net/poem41037.html","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94472","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83669","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133142","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4929,"وقفة على ديار بني عبس","https://www.poetsgate.com/ViewPoem.aspx?id=199356",""],[4980,"يَا مُرهِقَ القَلب","https://www.poetsgate.com/ViewPoem.aspx?id=191673",""],[4980,"يا زهرة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=193828",""],[4980,"يا قاتلي","https://www.poetsgate.com/ViewPoem.aspx?id=194510",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5277,"وجهُ المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=206220",""],[5431,"ضوء ..وجياع..وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=201723",""],[5431,"هيتَ له ....","https://www.poetsgate.com/ViewPoem.aspx?id=202400",""],[5493,"طريق الشوك","https://www.poetsgate.com/ViewPoem.aspx?id=205584",""],[5939,"ثورة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=178590",""],[5490,"سنة حلوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81969&r=&rc=56",""]],"verses":[["هَل ظَفِرتُم مِنّا بِقَلبٍ أَبِيٍّ","أَو رَأَيتُم مِنّا إِلَيكُم مَثابا",0,"ب",2,0],["هل ظن ان المرهق","الغرثان يلتهم الترابا",1,"ب",2,0],["هل ظنّ ثَغْرَكِ أُقحُواناً ناضراً","ترعاهُ غزلانُ الفلاةِ خمائصا",2,"ص",2,0],["هل ظالع مدرك يوما على عجز","شأو الظليع فعفو عند مرماها",3,"ا",3,0],["هل ظبي وجرة في ظل الأراك له","ظل وبالجزع مسراه ومعذاه",4,"ا",2,0],["هَل ظلَّ من بالهجر بات متيَّما","يهوى الحبيبة وَالمنازل والحمى",5,"م",2,1],["هل ظُهورٌ بعدَ أَن طالَ الخَفا","طَلعَ الفَجرُ وَقد قامَ بِلاله",6,"ل",2,0],["هل ظبي الفلا","يدري بحال قولو له",7,"ه",1,0],["هل ظننت العهد منى خلقا","مثلما يخلق ثوب المستكين",8,"ن",1,0],["هل ظل في وطني المصفد بالأسى","من معْلَمٍ بالحرب لما يُهْدَمِ",9,"م",1,0],["هَل ظَنَّ حُبِّي بِأنَّ القَلبَ يُبدِلهُ","لا وَالَّذِي صَاغَ فِينَا العَيشَ وَالمَوتَ",10,"ت",1,0],["هل ظنَّ حبِّي بأنَّ البعد يُسكِنُنِي","ما أشبه اليوم في شوقي من الأمسِ",11,"س",1,0],["هل ظنَّ حُبِّي بأنَّ القلبَ يجحدهُ","يومًا إذا مال بالهجران يكوينِي",12,"ن",2,0],["هَلْ ظَمِئْنَاْ وَرُوْيْنَاْ بَرْدَ أَغْلاْسِ الْجِبَاْلْ","هَلْ رُمِيْنَاْ وَاحْتُوِيْنَاْ بَينَ حُضْنَيْنَاْ ذِهَاْلْ",13,"ل",1,0],["هلْ ظَلَّ مِن أحفادِهِ ذو نَخْوَةٍ","كي يُستَجَارَ بدارِهِ مِن جانِ",14,"ن",1,0],["هل ظلّ ودُّكَ صامِداً","وسط العواصفِ والرُّكامْ",15,"م",1,0],["هل ظنّت الريح أن الأرض هامدة؟","أو أنّ صوتَ عذاباتٍ بها اختنقا ؟!!",16,"ق",2,0],["هل ظنّ سرمدة الحنين معابدا","تبقى على نزف الشعور مبجّله",17,"ل",2,0],["هل ظن معقله الأمين صوامعا","في رحمها ..لوجوده متبتله !!",17,"ل",2,0],["هل ظنّ هذا الغرّ أن سنابلا","ثقلت ركوعا طالباتٍ منجله ؟!!",17,"ل",2,0],["هل ظن أن حباله لاتنتهي","ستظل في وهج الحصاد مكبّله !!",17,"ل",2,0],["هل ظنت النار نورا عند مشرقه؟!","والنار رمضاؤها تخفي لها الغسقَا",18,"ق",2,0],["هل ظنُّها أنّني أُذيقُها وَلَهَي","وحِسُّها ثَمِلٌ مِنْ لَثْمِ رَيحاني؟",19,"ن",2,0],["هل ظنُكَ ميلادكَ يوماً","لم تدرِ عناءَ تجاربه؟",20,"ب",2,0]]}