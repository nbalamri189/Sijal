صفا","https://www.poetsgate.com/ViewPoem.aspx?id=49485",""],[4578,"راع القلوب مصابٌ جاء بالعجب","https://www.poetsgate.com/ViewPoem.aspx?id=49352",""],[4955,"وتبخرت أفراحنا","https://www.poetsgate.com/ViewPoem.aspx?id=188733",""],[4955,"من نهر دجلة شاعت الأخبار","https://www.poetsgate.com/ViewPoem.aspx?id=203745",""],[5135,"يَا سَيِّدِي","https://www.poetsgate.com/ViewPoem.aspx?id=204360",""],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[307,"كورونا سيف الردى","https://www.poetsgate.com/ViewPoem.aspx?id=214922",""],[5376,"ملحٌ وماءٌ بنا الآماق قاطرة","https://www.poetsgate.com/ViewPoem.aspx?id=188257",""],[1547,"تضاحك الرَّوضُ لما أَنْ بكى المطرُ","https://www.poetsgate.com/ViewPoem.aspx?id=16756",""],[5628,"الشاعر والعاذلة","https://www.poetsgate.com/ViewPoem.aspx?id=178469",""],[5952,"إنَّهمْ زَبَدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197203",""],[6084,"عز الهدى والندى والعلم والعلما","https://www.poetsgate.com/ViewPoem.aspx?id=170871",""]],"verses":[["لِلَّهِ نَعلٌ حُذِيَت في العُلى","أَخمَصَ ذاكَ العارِضِ المُرزَمِ",0,"م",1,0],["لِلَّهِ نَفرَةُ وَجدٍ لَستُ أَملِكُها","إِذا تَذَكَّرتُ إِخوانَ الصَفاءِ مَعي",1,"ع",2,0],["لِلهِ ناضِرَةُ الصِّبا يَسْرِي لَها","طَيْفٌ إذا صَغَتِ النُّجومُ طَروقُ",2,"ق",1,0],["لِلَّهِ نَاراً أَهْلَكَتْ عُبَّادَهَا","هِنْدِيَّةً تَغْدُو بِغَيْرِ دُخَانِ",3,"ن",1,0],["لِلَّهِ نافِلَةُ الأَجَلِّ الأَفضَلِ","وَلَهُ العُلى وَأَثيثُ كُلِّ مُؤَثَّلِ",4,"ل",1,1],["لله نظمك للطروس لقد","نعمت به الألحاظ والفكر",5,"ر",1,1],["للَّه نفسٌ يومَ ذاك أذلْتها","ولرُبَّ شيءٍ صينَ حين أُذيلا",6,"ل",2,0],["للَّه نسوةُ خالدٍ لقد اعتلتْ","كلَّ القِحاب خلاعةً ومجونا",7,"ن",2,0],["لِلَّهِ نَهرٌ سالَ في بَطحاءِ","أَشهى وُروداً مِن لِمى الحَسناءِ",8,"ا",2,1],["لِلَّهِ نورِيَّةُ المُحَيّا","تَحمِلُ نارِيَّةُ الحُمَيّا",9,"ي",2,1],["لِلَّهِ نَهرٌ ما رَأَيتُ جَمالَهُ","إِلّا ذَكَرتُ لَدَيهِ نَهرَ الكَوثَرِ",10,"ر",1,1],["لِلّهِ نَدماني أَبو وابِصٍ","ما شَأنُهُ بُخلٌ وَتَقصيرُ",11,"ر",1,0],["للهِ ناطِقةُ النُقُوشِ أَهكَذَا","تُعطَى الكَلامَ جَوَامِدُ الَأشيَاءِ",12,"ا",2,0],["لِلهِ نَعْشُكَ فِي السْنَاءِ كَانَهُ","فُلْكٌ تَهَادَى مُوسَعاً تَبجِيلاَ",13,"ل",2,0],["لِلَّهِ نَفسكَ ما أَشَدّ إِذا وَهَت","عِندَ المَكارِهِ لِلكِرامِ نُفوسُ",14,"س",1,0],["لله نخبة ابرار فقدتهم","كانوا الأمان فأبقوا بعدهم فزعا",15,"ع",2,0],["لله نارا هلكت عبادها","هندية تغدو بغير دخان",16,"ن",1,0],["لِلّهِ نافِلَة ُ الأجَلِّ الأفْضَلِ","ولَهُ العُلى وأثيتُ كلِّ مُؤتَّلِ",17,"ل",1,1],["لِلّهِ ناشرُ هَذا البَرد مِن رجلٍ","وَفي النَّجابةِ حَقَّ الفَضلِ وَالأَدبِ",18,"ب",1,0],["للهِ نفسٌ بكم أعرِّفها","تقضي وما ينقضي تأسّفها",19,"ف",3,1],["لِلهِ نَيْلُ مَسَرَّةٍ ضَمِنَ الْهَوى","فَوَفى عَلى رَغْمِ النَّوى بِضَمانِهِ",20,"ه",1,0],["لله نحنُ فما يشاءُ فحقُّنا","فيه انقيادٌ بالرضا لله",21,"ل",2,0],["لِلَّهِ نَعمانُ الأَراكِ مَنزِلاً","ضَمَّ بِنُعمٍ شَملَنا نُعمانُهُ",22,"ن",2,0],["لله نصفيةٌ بعثت بها","بيضاءَ في أحمرِ من الورق",23,"ق",1,1],["للَه نفس امرئٍ موفقة","آوت إلى ربها فآواها",24,"ا",3,0],["لِلّه نَجل أَكارم بلَغوا السُها","بِكَمالهم لَم يَرغَبوا عَن أَمرِهِ",25,"ر",2,0],["للهِ نَيْسابورُ مِن حِلَّهْ","ما مِثلُها دارُ ولا حِلَّهْ",26,"ل",2,1],["لله نَصْلٌ ضئيلٌ في أنامِلِهِ","أعادَ حَظِّي سَميناً بَعدَ ما نَحفا",27,"ف",2,0],["لله نجم لاح في افق الثنا","يحكي بنور شهابه بدر السما",28,"م",2,0],["لله نعم مهذبٍ باهت بهِ","حمصٌ ونور الفضل عنهُ يبينُ",29,"ن",1,1],["لله نجعته وشرعته وما","في عرفه من طيب منخوب",30,"ب",1,0],["للّه ناشطةٌ جمعتُ بودّها ال","محفوظِ باعي في حبالِ ربيقِ",31,"ق",1,0],["للَّهِ نفسُ أسىً يصعِّدها الأسى","ويردّها في العَيْنِ كفُّ قَذائِهِ",32,"ا",3,0],["للّهِ نُعمانُ الأراكِ فطالَما","نعِمَتْ به روحي على نُعْمانِ",33,"ن",1,0],["للَّه نَفسي تَقاضى إربةً عجباً","مِنها تبسّم ثغرُ الشيبِ في اللِّممِ",34,"م",1,0],["للَّهِ نَدْبٌ جريءُ","رأى الغبينةَ ذُلّا",35,"ل",2,0],["لله نشكو أليم الحزن والألم","جلَّ المصاب وجلَّت غيبة العلم",36,"م",1,1],["لله نفحة عون عليّ مادحكم","أراه حلّ بروضات المنى فقطف",37,"ف",1,0],["لله نُعمى أتى منها البشيرُ بما","عمَّ السرورُ به والأنسُ والفرَحُ",38,"ح",1,1],["لله نعي من الشامات قد ورد ال","العراق يا ليته يا قوم لم يرد",39,"د",1,0],["للّه نسمةُ دارينٍ إذا صدرت","عن ورد وجنته النفَّاحة الأرج",40,"ج",1,0],["للهِ نَلجأُ ساجِدينَ لِنَجْدَةٍ","أَبِغَيْرِهِ يَسْتَنْجِدُ الضُّعَفاءُ؟",41,"ا",2,0],["لله نور البحر مث","ل البرق لاح فخطفْ",42,"ف",1,0],["لِلّه نعشك إذ وافى الغري غدا","لحيدر الطهر في الفردوس جيرانا",43,"ن",2,0],["للّه نحلتنا ونِعمَ سبيلها","أصلاً وفرعاً لا تخالفُ مصحفه",44,"ف",2,0],["لله ناظم عقدها الشهم الذي","ينسيك نثر الدر او يتكلم",45,"م",1,0],["لله نظم بدا من مطلع الأدب","كأنه الدر في سلكٍ من الذهبِ",46,"ب",1,1],["لِلَّهِ نَمنَمَةُ النَمامِ حينَ بَدَت","وَالوَردُ يُنظَمُ وَالمَنثورُ يَنتَثِرُ",47,"ر",1,0],["للَه نفس في رضاه بذلتها","سمعاً وكنت لما تحب مهينا",48,"ن",2,0],["للَه نوق سرت فيكم ميممة","بيتاً مشيداً لمن قد حج واعتمرا",49,"ر",2,0],["لله نورٌ كالسراجِ يمدّه","وهن التقابل بالنزاهة يأفل",50,"ل",1,0],["لله نفسٌ براها الله من عرقِ","الأفراس في حلبةِ الأفراسِ والنوق",51,"ق",1,0],["لله نفسٌ وللرحمنِ أنفاسٌ","وللمنازعِ فيما قلت إبلاس",52,"س",1,1],["لله نعشك من سارٍ وما وطأت","له على غير هامات الورى قدم",53,"م",1,0],["للَه نازلة بآل طباطبا","نزلت فشب إلى السماء ضرامها",54,"م",3,0],["للَه نازلة في الدين قد قصمت","فقاره إذ رمته في فواقرها",55,"ر",3,0],["لِلّه نَضوي إِن مرت رَكائبنا","عَلى المَنازل في أَطلالها عكفا",56,"ف",2,0],["لِلّه نَعش قَد سَرى بسكينة","عَنهُ اِنحطَطَن بَنات نَعش مُذ سَرى",57,"ر",2,0],["لِلّه نَعش قَد حَوى نَفس العُلا","بَنات نَعش دُونه وَالذابح",58,"ح",1,0],["لله نار في الحشى مشبوبة","أبداً بغير وصالهم لا تطفي",59,"ف",2,0],["لله نشكو عواديه التي سفكت","دم الهدى بالردا ظلما وليس يدى",60,"د",2,0],["لله نشكو ودمع العين منهمل","خطبا ضربت له حزنا يد اليد",60,"د",1,0],["لله نشكو وقلب المجد منفطر","نوائبا في الورى جلت عن العدد",60,"د",1,0],["لله نفسك انها قدسية","والنفس عند ذوي الحجي اقسام",61,"م",1,0],["للّهِ نَهْرٌ كالْحُباب","تَرْقيشُه سامي الحَبابِ",62,"ب",1,1],["لله ناي سبتنا روحُ صاحبهِ","حتى وقفنَا حَيارَى عند واجبهِ",63,"ه",1,0],["للهِ نغمةُ أوتارٍ ومُسمِعَةٌ","باتَتْ تَدُلُّ على شَوق