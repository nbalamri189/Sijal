{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[72,"أتتك ولم تبعد على عاشق مصر","https://www.aldiwan.net/poem42920.html","الكامل"],[47,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[63,"يعنفني أن أطلت النحيبا","https://www.aldiwan.net/poem51786.html","المتقارب"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[376,"أرى الناس كلهم عاذلي","https://www.aldiwan.net/poem57200.html","الطويل"],[422,"مدحت ابن الفداغ نظمي","https://www.aldiwan.net/poem54065.html","مخلع البسيط"],[438,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[438,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[541,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[556,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77580","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109170","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100503","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121589","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62873","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62813","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129491","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[4679,"ألا أهنأ أيها الصرح المشيد","https://www.poetsgate.com/ViewPoem.aspx?id=142721",""],[5431,"للحيتان ...","https://www.poetsgate.com/ViewPoem.aspx?id=210256",""]],"verses":[["رَأى لِصاباً فَشارَها صَبِراً","ذُقِ الجَنى قَد أَظَلَّكَ العَسَلُ",0,"ل",1,0],["رَأى لَكَ عِزّاً لَم يَكُن لِمُعِزِّهِ","وَبَعدَ ضِياءِ الشَمسِ لا يُذكَرُ الفَجرُ",1,"ر",1,0],["رَأى لِأَخيهِ عَزماً أَنقَذَتنا","صَريمَتُهُ مِنَ التَلَفِ المُبيدِ",2,"د",1,0],["رأى لحظُه ما تُجِنُّ الصُّدورُ","فخِلناه يعلمُ منها الغُيوبا",3,"ب",2,0],["رأى ليلة المعراج أمراً محققاً","ومنكر هذا الأمر يخفى ويردع",4,"ع",1,0],["رأى لَهم الفَضلَ في قَصدِهم","وما الفَضلُ إلا معَ الباذِلِ",5,"ل",1,0],["رأى لساني إذنْ كليلاً","وما دَرى أنَّه حسام",6,"م",1,0],["رَأْيٌ له بَذَلَ الإِقْليمُ طاعَتَه","فلو يشاءُ كفاه السَّيْفَ والقلما",7,"م",2,0],["رأَى لك عزماً محتويا نَعَى له","أَباهُ فَوَلَّى مُدْبِراً عندما نَعَى",8,"ع",2,0],["رَأى لَهُمُ فَضلاً فَأَعطاهُمُ المُنى","وَكانَ بِما أَعطى أَطَبَّ وَأَبصَرا",9,"ر",2,0],["رَأى لِيناً عَليهِ فَظَنَّ خَيراً","وَيَلقَى اللّينَ من لَمس الحُبابا",10,"ب",2,0],["رَأى لَهُنَّ هَيئَةً قَبيحة","فَاِفتَكر البومة وَالنَصيحَه",11,"ه",1,0],["رأى لأولِ حين شعر والده","تقصه يد حلاقٍ وتقذفه",12,"ه",1,1],["رآى لك أَصفى الناس حُبّاً وطاعةً","وأحلى ذوي الآداب شعراً وافصَحا",13,"ح",2,0],["رأى لدى السياق ما أعده","اللَه له فسار يسعى موفضا",14,"ض",2,0],["رأى ليلاً عيون الشهب رمداً","فعصبها بمسود الدياجي",15,"ي",1,0],["رأَى ليلةَ الوصلِ قد أَسعَفَتْ","ولا بدَّ للصُّبحِ من أَنْ يَعُودا",16,"د",2,0],["رأى للمعالي والمكارمِ هضبةً","يُقَطِّعُ أنفاسَ الرجالِ صُعودُها",17,"د",3,0],["رأي له ما عن عند ملمة","إلا توقد جذوة من نار",18,"ر",1,0],["رايُ لوتارٍ وكَلوينٍ لَقَد","تَبِعُوهُ وهوَ رأيٌ مُنتَقَد",19,"د",1,0],["رأى لك مكرماتٍ قد تسامت","بفرض ثنائها كلٌّ يشيدُ",20,"د",1,0],["رأى للشعر هجرته","وفي أمواجه عسّا",21,"س",2,0]]}