ر",87,"ر",1,0],["وللدبران من حريزان أوّل","وهقعته تتلوه في رابع العشر",88,"ر",1,0],["وللدهر تفريق الأحبة عادة","وللجهل داء في الطباع عضال",89,"ل",1,0],["وللدموع بعيني ألف شاهدةٍ","تشفّ عن روضةٍ قد أصبحت حطبا!",90,"ب",2,0],["وللدِّينِ مِحرابٌ وللحُبِّ مثلُهُ","وتسمعُ في كلٍّ تراتيلَ عابدِ",91,"د",1,1]]}