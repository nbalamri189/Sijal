{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[65,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[74,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[53,"أيا شجرات الله ليس بقاطع","https://www.aldiwan.net/poem65081.html","الطويل"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[40,"ولم أر معقورا به وسط معشر","https://www.aldiwan.net/poem7708.html","الطويل"],[51,"إذا أنت لاينت التي خشنت لانت","https://www.aldiwan.net/poem10836.html","الطويل"],[51,"كأن يقيننا بالموت شك","https://www.aldiwan.net/poem63041.html","الوافر"],[51,"شرهت فلست أرضى بالقليل","https://www.aldiwan.net/poem63059.html","الوافر"],[51,"ألا هل إلى طول الحياة سبيل","https://www.aldiwan.net/poem63078.html","البسيط"],[51,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[68,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[54,"أهاجك أم لا بالدويرة منزل","https://www.aldiwan.net/poem26757.html","الطويل"],[54,"ألست ترى موت العلى والمحامد","https://www.aldiwan.net/poem27063.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[52,"وللدهر أيام قصار إذا سرت","https://www.aldiwan.net/poem62265.html","الطويل"],[48,"إذا ما رأيتم عصبة هجرية","https://www.aldiwan.net/poem22446.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62234","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/2612","المتقارب"],[113,"إن الوزير أدام الله دولته","https://www.aldiwan.net/poem16293.html","البسيط"],[136,"هو الموت صمصامة منتضى","https://www.aldiwan.net/poem54809.html","المتقارب"],[139,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[147,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[164,"علي لها أن لا انام ولا أسلو","https://www.aldiwan.net/poem59084.html","الطويل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[190,"قصير مدى ما لا ينال طويل","https://www.aldiwan.net/poem43355.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[333,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[369,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[369,"حقيق على الأيام أن يتحدثوا","https://www.aldiwan.net/poem60971.html","الطويل"],[376,"لئن حجبت نجل العيون وحورها","https://www.aldiwan.net/poem57450.html","الطويل"],[385,"تنسمي بالله ريح نجد","https://www.aldiwan.net/poem49209.html","الرجز"],[438,"قد أغتدي والصبح خفاق العذب","https://www.aldiwan.net/poem12462.html","الرجز"],[443,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[520,"يا من أدل يبسط العذر من جارا","https://www.aldiwan.net/poem12138.html","البسيط"],[556,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[556,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[556,"يقولون لي لم أنت بالذل راكد","https://www.aldiwan.net/poem48107.html","الطويل"],[563,"يا مثمرا قبل ينبت","https://www.aldiwan.net/poem34535.html","المجتث"],[580,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83334","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87111","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53879","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54024","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77594","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145893","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62448","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62673","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62503","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59298","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202091","المتقارب"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80251","الوافر"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117107","البسيط"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49600","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100963","الطويل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130584","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110319","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33855","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77308","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115686","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65129","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132534","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100726","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89377","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129381","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91689","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91667","الهزج"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21389","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21382","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95344","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44677","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116053","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120520","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139703",""],[4680,"بأية حالٍ عدتَ يا عيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=185046",""],[4854,"الدِّيكُ والحِمَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=216045",""],[4929,"العراق الحر","https://www.poetsgate.com/ViewPoem.aspx?id=207477",""],[4984,"لمن تُعزف النجوى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175545",""],[5340,"ويوم ترى كانونا الأول مقبلا","https://www.poetsgate.com/ViewPoem.aspx?id=186106",""],[5543,"شموسي في أفق الحياه هلال","https://www.poetsgate.com/ViewPoem.aspx?id=181703",""],[5616,"شيخوخة","https://www.poetsgate.com/ViewPoem.aspx?id=203235",""],[6093,"وللدِّينِ مِحرابٌ وللحُبِّ مثلُهُ (الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=176099",""]],"verses":[["وَلِلدَهرِ يُعري جانِبي مِن أَقارِبي","وَيَقطَعُ ما بَيني وَبَينَ الأَصادِقِ",0,"ق",1,0],["وللدُّرِّ حُسْنٌ حَيْثُ عُلِّقَ عِقْدُهُ","ولكنّهُ في جِيدِ حَسْناءَ أجْمَلُ",1,"ل",1,0],["وللدرج بعد الدرس منهُ فوائد","تفضل في أسلاكها وتفصَّل",2,"ل",1,0],["وللدين أنصار وللملك شيعةٌ","وللعرف معطاء وللجار مانع",3,"ع",1,0],["وللدهر فينا قسمة عجرفية","على السخط والمرضاة منا وقوعها",4,"ع",3,0],["وَلِلدارِ فيها مِن حُمولَةِ أَهلِها","عَقيرٌ وَلِلباكي بِها المُتَبَلِّدِ",5,"د",1,0],["وَلِلدينِ دَيّانٌ غَداً يَومَ فَصلِهِ","تُدانُ نُفوسُ الناسِ فيهِ بِما دانَت",6,"ت",1,0],["وَلِلدُنيا عِداتٌ بِالتَمَنّي","وَكُلُّ عِداتِها كَذِبٌ وَإِفكٌ",7,"ك",1,0],["وَلِلدُنيا دَوائِرُ دائِراتٌ","لِتَذهَبَ بِالعَزيزِ وَبِالذَليلِ",8,"ل",1,0],["وَلِلدُنيا يَدٌ تَهَبُ المَنايا","وَتَستَلِبُ الخَليلَ مِنَ الخَليلِ",8,"ل",1,0],["وَلِلدَهرِ أَلوانٌ تَروحُ وَتَغتَدي","وَإِنَّ نُفوساً بَينَهُنَّ تَسيلُ",9,"ل",1,0],["وَلِلدَهرِ أَيّامٌ عَلَينا مُلِحَّةٌ","تُصَرِّحُ لي بِالمَوتِ عَنهُنَّ لا تَكني",10,"ن",2,0],["وَلِلدِماءِ عَلى أَثوابِنا عَلَقٌ","بِنَشرِهِ عَن عَبيرِ المِسكِ يُغنينا",11,"ن",2,0],["وَلِلدَهرِ سِرٌّ سَوفَ يَظهَرُ أَمرُهُ","وَلِلناسِ وَزنٌ جائِرٌ سَوفَ يَعدِلُ",12,"ل",1,0],["وَلِلدَهرِ أَيّامٌ تُسيءُ عَواقِباً","وَتُحسِنُ إِن أَحسَنَّ غَيرَ عَوامِدِ",13,"د",1,0],["وللدّهْرِ سَجْلٌ من حَياةٍ ومن رَدىً","ولكنّهُ من بَطْنِ كَفّيكَ يَنهَمي",14,"م",2,0],["وَلِلدَهرِ أَيامٌ قِصارٌ إِذا سَرَت","بِخَيرٍ وَيَومُ الحُزنِ مِنهُ طَويل",15,"ل",1,1],["وَلِلدَهرِ سُرٌّ مُرقِدٌ كُلَّ ساهِرٍ","عَلى غِرَّةٍ أَو موقِظٌ كُلَّ هاجِدِ",16,"د",1,0],["ولِلدَّارِ مِنْ جَنْبَيْ قَرَوْرَى كَأَنَّهَا","وُحِيُّ كِتَابٍ أَتْبَعْتْهُ أَنَامِلُهْ",17,"ل",2,0],["وَلِلدَهرِ شَدٌّ عَلى أَهلِهِ","فَبَينٌ مُشِتٌّ وَنَبلٌ مُصيبُ",18,"ب",1,0],["وَلِلدُروز شَتات في بِلادِهم","كَأَنَّهُم قَتَلوا مِن قَبل ما قَتَلوا",19,"ل",3,0],["وللِدَّهرِ في أهلِهِ صَولَةٌ","ورَمىٌ مُصِيبٌ بِسَهمٍ مِضَا",20,"ض",2,0],["وللدفاتر صكت وجهها جزعاً","وللمتارب يشكو كفها التَربا",21,"ب",2,0],["وَلِلدَولَةِ المُستَنصِرِيَّةِ ناصِرٌ","بِهِ اِشتَدَّ زَنداً عِزُّها وَوَرَت زَندا",22,"د",2,0],["وللدهر حكم في زمان نعيبه","نسميه جورا وهو في غيره عدل",23,"ل",1,0],["وللدفوف وأصوات الغنا زجل","في وسط مسحده يا مَن من شدا أجب",24,"ب",1,0],["وللدهر علات فخذ منه عفوه","وإلا فكلّ في الصفاء عليل",25,"ل",1,0],["وللدينِ والدنيا اعملوا وتنافسوا","ليُحمدَ في الدارينِ حسن المغبّة",26,"ه",1,0],["وللدهر طاحونةٌ لا تملّ","تُدوّرها نكبات الليال",27,"ل",1,0],["وللدّهر أن يقسو وإني لصامدٌ","وإن حطّمت سود الليالي جلاديا",28,"ي",2,0],["وللدّمِ من نَحْرِ الكَمّيِ صَوائكٌ","من النّضْحِ حَيّاتُ الرّماح بها رُقْط",29,"ط",1,0],["وللدِينِ نَصْرٌ واصبٌ ليس يأتَلي","وللمُلْكِ نُصْحٌ خالصٌ ليس يُغْلَث",30,"ث",1,0],["وللدولة الزهراءِ نورٌ مطنِّبٌ","من الأفُقِ الأعلى وهذا مُنيرُها",31,"ر",3,0],["وَلِلدُجى كَأبتي وَحيرَتي","إِذ غابَ عَنهُ بَدرُهُ للفَقد",32,"د",1,0],["وللدّراري دُرَرٌ بلا ثُقَبْ","براحةِ الأنوار راحَتْ تُنتهَبْ",33,"ب",1,0],["وللدين رزء منك عزّ عزاؤهُ","وكادت قوى الأيام فيك تقطّع",34,"ع",1,0],["وللدهرِ في حالِي جُروحٌ وإنه","بلحظك إن لاحظتَ يوُسَي رغيبُها",35,"ب",3,0],["وللدهاليز أرباب الظلامة لا","أهل الكرامة إجلالاً وإقدارا",36,"ر",2,0],["وللدّنيا تماطلُ بالرّزايا","مِطالَ الجُربِ للإبلِ الصِّحاحِ",37,"ح",1,0],["وَللدُموعِ عَلَيها","سَحٌّ وقَطْرٌ وسَكْبُ",38,"ب",1,0],["وَلِلدّهرِ عِندي كُلَّ يَومٍ وَلَيلَةٍ","وَإِن لَم يَكُن مِنّي العتابُ ذنوبُ",39,"ب",1,0],["وللدجاجة ريشٌ","لكنها لا تطير",40,"ر",1,0],["وللدَّهرِ من بَعْد ابن غازٍ أَليَّةٌ","بأَن لاَ يزالَ السقْمُ للجسْم غازِيَا",41,"ي",2,0],["وَلِلدينِ وَجدٌ لَيسَ تَطفَأُ نارُهُ","وَلِلشَرعِ طَرفٌ لَيسَ يَقلَعُ ما طِرُه",42,"ر",2,0],["وَللدواوين مِنها في إِدارتها","أَبهى نِظام بَديع غَير منخرم",43,"م",1,0],["وللدّهر إسعافٌ بما أنتَ راغِبٌ","يجود بما قد شِئتَ منه ويَسْمحُ",44,"ح",1,0],["وللدُّنيا بما نِلتَ ابْتهاجٌ","شَدَا فَرَحاً بمرآه الحَمَامُ",45,"م",1,0],["وَلِلدَنانير غَدا مَليكا","وَلَم يَجد ضدّاً وَلا شَريكا",46,"ك",2,0],["وللدمع ِفي أعيني لهفةٌ","إذا ما مررَّتِ بليلي شِهَابا",47,"ب",2,0],["وللدهر من بعد التفرق إلفة","وللأرض من بعد الصعاب مطائبُ",48,"ب",1,0],["وللدهر صولات وفي الناس غفلة","فلم يشعروا إلا وفيهم ضرائبُهْ",49,"ب",2,0],["وللدهر انعطاف إن","أساء فيحسن الرجعى",50,"ع",2,0],["وَلِلدينِ ما قامُوا وَما قَعَدُوا ولِل","مَعَالِي إِذا باعَ السِّوى سَعيُهُم يَشرِي",51,"ر",2,0],["وَلِلدَّهْرِ احتكامٌ سَوْفَ يَقْضِي","عليكمْ بالذي أوْلَيْتُمونَا",52,"ن",2,0],["وللدوح بالزهر الأنيق تبهرج","وللشمس بالغيم الرقيق تكتم",53,"م",1,0],["وَلِلدَّهْرِ شُحٌّ بِالْمَنِيَّةِ وَالْمُنَى","وَلَكِنَّهُ من سُحْب كَفَّيْهِ يَنْهَمِي",54,"م",2,0],["وَلِلدّينِ وَالدُّنْيَا ابْتِهَاجٌ ورفعَةٌ","لِمُنْتَقِمٍ لِلَّه فِي اللَّهِ مُنْعِمِ",54,"م",1,0],["وللدم إذ سال منهم دَوىٌّ","وللروح إذْ فَازَ عنهم خَرِير",55,"ر",1,0],["وَلِلدَولة الغَرا مُشيراً أَقامَهُ","فَقامَ عَلى هام الأَنام نَذيرا",56,"ر",2,0],["وللدماء انحدار في مسايلها","كأنها من عيون الأرض تنسرب",57,"ب",1,0],["وَللِدَّعواتِ تَأثيرٌ بَليغٌ","وَقَد يَنفيهِ أَصحابُ الضَّلالِ",58,"ل",1,0],["وللدين رِدْءاً وللمسلمينَ","مآلاً وللحقِّ يَعْلُو وآنا",59,"ن",2,0],["وللدين بالفاروق مِن بعدُ صولةٌ","تَثُل 