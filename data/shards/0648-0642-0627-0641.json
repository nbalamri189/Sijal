ةٍ","تَلَقَّيتُ مِن جَوِّ السَماءِ نُزولَها",3,"ل",3,1],["وَقافِيَةٍ شَبيهِ الشَمسِ حُسناً","تَرَدَّدُ بَينَ كَفّي وَاليَراعِ",4,"ع",1,0],["وقَافِيَةٍ مِثْلِ وَقْعِ الرَّدَا","ةِ لَمْ تَتَّرِكْ لِمُجِيبٍ مَقَالاَ",5,"ل",2,0],["وَقافِيَةٍ غَيرِ إِنسِيَّةٍ","قَرَضتُ مِنَ الشِعرِ أَمثالَها",6,"ل",3,1],["وَقافِيَةٍ حَبَّرتُها فَبَعَثتُها","عَسى أَن يُوافيها لَدَيهِ قَبولُ",7,"ل",1,0],["وقافيةٍ تتلى ويحلو نشيدها","وكم تتحلّى في ثنائك معطال",8,"ل",1,0],["وقافية من شرود الكلام","بأخبار سلمان قد قالها",9,"ل",3,0],["وقافيةٍ أهزُّ بها إذا ما","نطقتَ معاطفَ الطربِ الرميمِ",10,"م",1,0],["وقافيةٍ طغت فنهست منها","بفيَّ مكانَ لا يرقَى اللسيعُ",11,"ع",1,0],["وقافيةٍ جمعتُ لهم شروداً","بها ووصلت حبلَ أخٍ قطوعِ",12,"ع",1,0],["وقافيةٍ أسهلتُ مجرَى طريقها","لها في حُلوقِ القائلين عِثارُ",13,"ر",1,0],["وقافيةٍ على الراوي لَجوجٍ","خدعتُ نِفارَها حتى استَقرَّا",14,"ر",2,0],["وقافيةٍ باتت تحارب ربَّها","فنازلتُها شيئاً فألقت يدَ الصلحِ",15,"ح",1,0],["وقافيةٍ سيَّارةٍ عَطَّ وَخْدُها","بُرود المَلا ما بين غربٍ ومشرقِ",16,"ق",1,0],["وقافيةٍ عذراء في كل مطلبٍ","زهيد من الأيّام ظاهرة الزّهد",17,"د",1,0],["وقافيةٍ مغبوبةِ الحقّ حزتها","فوفّيتها حقاً وأمّنتها الغبنا",18,"ن",2,0],["وقافية عذراء لم تأت ريبة","ولا خام عن كسب المحامد خيمها",19,"م",3,0],["وقافية تجلوه غرائب فضله","فتعرب عن فصل الخطاب وتفصح",20,"ح",1,0],["وقافيةٍ متى اِستُمِعتْ أبرّتْ","عذوبتُها على الماء الزُّلالِ",21,"ل",1,0],["وَقافِيَةٍ أَحيَيتُ في أَخَواتِها","وَفيها نُجومَ اللَيلِ وَالناسُ نُوَّمُ",22,"م",1,0],["وقافية غراء هام بحسنها","أولو الفضل حتى لم تجد غير هائم",23,"م",1,0],["وقافية عقام قلت بكر","رعان نجد محكمات",24,"ت",1,1],["وَقافِيَةٍ حَذّاءَ بِتُّ أَحوكُها","إِذا ما سُهَيلٌ في السَّماءِ تَلالا",25,"ل",2,1],["وقاف قراءات المثاني كما أتت","ونون التي يجري بها قلم الدين",26,"ن",1,0],["وقاف أنزلته مني بخسر","نزول الروح من حبلِ الوريد",27,"د",1,0],["وقافية حذاء ألقيت حشوها","وصححت معناها فجاءت مهذبه",28,"ب",2,1],["وقافية كأن السم فيها","وليس سليمها أبداً بنامي",29,"ي",1,1],["وقافية منك أوضاحها","ولكن لفظي فيها لمع",30,"ع",1,1],["وقافية ضلت وتاه دليلها","فجاءتك تبغى منك أهدى الدلائل",31,"ل",1,0],["وقافية كالعقد والتاج لم يزل","يحلى بها للدهر جيد ومفرق",32,"ق",1,0],["وقافٍ قوافٍ ترنُ بقلبي","قصيدٌ مُحلى وقولٌ مَديحُ",33,"ح",1,0],["وقافية البيت الأخيرة بل من ال","محرك قبل الساكنين إلى انتها",34,"ا",1,0],["وقافُ بلادِنا قَصَصٌ","بها التّاريخُ قد صدَقَا",35,"ق",2,0],["وقافل من بعد ذا راجع","عاط الينا بالوفا عاطف",36,"ف",1,0],["وقافية أحمَّلها ودادي -","لمنْ بالقلبِ - قد ألفتْ سطورا",37,"ر",2,0],["وَ قَافِيَةٍ أَغْرَى حُرُوفِي اخْضِرارُها","رَوِيًّا بِهَا رَصَّعْتُ , فَاحْتَدَّ ثَارُها",38,"ر",3,1],["وقافيةٍ تجلو غرائب فضله","فتعرب عن فصل الخطاب وتفصح",39,"ح",1,0],["وقافية تبتغي في البحور","دراً أصيلاً وصيداً جليبا",40,"ب",2,0],["وقافية ٍ أسهلتُ طريقها","لها في حلوقِ القائلين عثارُ",41,"ر",1,0],["وقافية ٍ طفتْ فنهستُ منها","بفيَّ مكانَ لا يرقى اللّسيعُ",42,"ع",1,0],["وقافيتي ستخبرُ حيثُ سارتْ","بأنِّي نازلٌ بلظى الحروبِ",43,"ب",1,0],["وقافلةٌ مَرَّتْ بطيئاً مَسِيرُها","وقد أعْيَتِ الحادي.. وطالَ بها الدَّهْرُ",44,"ر",1,0]]}