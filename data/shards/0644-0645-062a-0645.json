{"poems":[[95,"يوسف يا سبط الندى والعلى","https://www.aldiwan.net/poem9776.html","عموديه"],[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[93,"سكت خوفا وقلت الصفح من خلقي","https://www.aldiwan.net/poem62725.html","عموديه"],[94,"لله ما أحلى الطفولة","https://www.aldiwan.net/poem38964.html","مجزوء الرمل"],[87,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[47,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[68,"إن ثنت عنكم الخطوب عناني","https://www.aldiwan.net/poem40972.html","الخفيف"],[54,"لم تمت أنت إنما مات من لم","https://www.aldiwan.net/poem26941.html","الخفيف"],[50,"عزوا أخلاي قلبي فقد أصبت بلبي","https://www.aldiwan.net/poem10817.html","المجتث"],[50,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54942","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[47,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[113,"لم تمل بي عن العفاف العقار","https://www.aldiwan.net/poem16460.html","الخفيف"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[146,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[214,"ثبوت حسنك لي فيه شهادات","https://www.aldiwan.net/poem13336.html","البسيط"],[287,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[358,"لمت من أبدل العمامة بالطر","https://www.aldiwan.net/poem40216.html","الخفيف"],[371,"يا رعد ما هذي القعاقع","https://www.aldiwan.net/poem17228.html","مجزوء الكامل"],[376,"لم تمح بالدمع بعد البين آماقي","https://www.aldiwan.net/poem57257.html","البسيط"],[376,"أحديث نفسي أم سمر","https://www.aldiwan.net/poem57452.html","مجزوء الكامل"],[447,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[458,"صداحة الشرق مذ أتتنا","https://www.aldiwan.net/poem61397.html","مخلع البسيط"],[458,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[463,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[463,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[556,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[563,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66800","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48771","الكامل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17602","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65078","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100476","البسيط"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136898","الرمل"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101396","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93680","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[2539,"","https://poetry.dctabudhabi.ae/diwan/poem/113619","المديد"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82942","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130024","البسيط"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84533","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127396","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201916","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203473","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204665","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91504","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205737","المنسرح"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83661","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76708","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120198","الكامل"],[4755,"كُلُّ وَجهٍ طَرَقتَهُ صارَ ظِلَّا","https://www.poetsgate.com/ViewPoem.aspx?id=193476",""],[4767,"عزاء القديح","https://www.poetsgate.com/ViewPoem.aspx?id=89967",""],[4767,"لم تمت","https://www.poetsgate.com/ViewPoem.aspx?id=100529",""],[4929,"مرثية الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=204918",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5431,"مي سكاف الأسطورة (2)","https://www.poetsgate.com/ViewPoem.aspx?id=198827",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5776,"غيمٌ قاحل","https://www.poetsgate.com/ViewPoem.aspx?id=199450",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""]],"verses":[["لم تمضي عجمته معربا","لما به من سانحات عراب",0,"ب",1,0],["لم تمس عين الله راعية","أحداً يبيت وأنت لم ترعه",1,"ع",2,0],["لَم تَمُت لا وَإِنَّما","أَصبَحَت في سِوى يَدي",2,"د",2,0],["لَم تَملَء دَربي الأَشواكُ","إِنَّ الأَشواكَ لَفي قَلبي",3,"ي",1,0],["لَم تَمتَنِع أَنفَةً لَكِن قَدِ اِمتَنَعَت","عَلَيكَ أَشباهُ ما قَد صاغَهُ قَلَمي",4,"م",2,0],["لمْ تمشِ في دنيا الكآبَةِ","والتَّعاسَةِ والعَذابْ",5,"ب",1,0],["لم تمسحوا للعميد رأسا","ولا نفضتم له حذاء",6,"ا",2,0],["لَم تُمارِس بِهِ الأَراقِمُ حَتّى","عَرَفَ العاجِمونَ شِدَّةَ عودِه",7,"د",2,0],["لَم تَمَسَّ التُرابَ نَعلاكَ إِلّا","حَسَدَتهُ مَعاقِدُ التيجانِ",8,"ن",1,0],["لَم تَمُت أَنتَ إِنَّما ماتَ مَن لَم","يُبقِ في المَجدِ وَالمَحامِدِ ذِكرا",9,"ر",2,1],["لَم تَمشِ رِجلي لِشَيءٍ","حَتّى مَشى فيهِ قَلبي",10,"ب",2,0],["لَم تَمتَنِع عِفَّةً مِنهُ وَلا وَرَعاً","بِلا صَداقٍ وَلَم يوجَد لَها عَقَلُ",11,"ل",1,0],["لَمْ تُمْهِلي حَتَّى نَرَى أَثَراً","لَكِ مِنْ أَشِعَّةِ بَاهِرِ الفِكْرِ",12,"ر",1,0],["لَمْ تمْهِلي حَتَّى نَرَى عَمَلاً","لَكِ مِنْ نِتَاجِ الفَضْلِ وَالبِرِّ",12,"ر",1,0],["لَمْ تُمْهِلي حَتى نَرَى وَلَداً","لَكِ يُرْتَجَى لِلنَّفْعِ وَالضُّرِّ",12,"ر",1,0],["لم تمت فوق سريرٍ ناعمٍ","يكتسي ندا ويندى زعفرانا",13,"ن",2,0],["لم تمحق اليونانَ حر","بُك بل حبتهم بالخلود",14,"د",1,0],["لم تمارس به الأرقم حتى","عرف العاجمون شدة عوده",15,"د",2,0],["لَم تَمل بي عَن العفاف العقارُ","أَعشَق الغيد وَالوَقار وَقارُ",16,"ر",1,1],["لم تُمَيِّز مِنَ الحَلاَلِ حَرَاماً","لاَ تُرَاعِى التَّحلِيلَ والتَّحرِيمَا",17,"م",2,0],["لم تُمطر السحبُ ولكن خجِلتْ","من جوده حتى نضحن بالعَرقْ",18,"ق",1,0],["لم تمطر الدمع درا سحب مقلته","يا برق لولا الثنايا اللؤلؤيات",19,"ت",1,0],["لُمتُم عَلى الرَشَأ النَجدِيِّ ذا كَلَفٍ","قامَت لَهُ في الهَوى العُذرِيِّ أَعذارُ",20,"ر",1,0],["لمتُ مَن أَبدل العَمامة بِالطر","بوش حَتّى إِذا الحَماقة أَظهَر",21,"ر",1,1],["لَم تَملَأ الأَيدي وَلَ","كنّ النَواظِرَ وَالمَسامِعْ",22,"ع",1,0],["لم تُمحَ بالدَّمعِ بعدَ البَينِ آماقي","وها فُؤادي مَعي بَعد النَّوى باقِ",23,"ق",1,1],["لم تمضِ قبلكَ نكبةٌ","ما أثَّروا فيها أثَر",24,"ر",1,0],["لَمت موتة فرهود بحكمته","ثم احترقت بنار الحزن والأَسف",25,"ف",1,0],["لم تمنحي العاشقين حلما","بل فوق ما أملوا وكانوا",26,"ن",3,0],["لم تميزهمُ سوى أعمالِهم","أو يعِّرفهم سوى لون الفدَاء",27,"ا",2,0],["لمتُمُ فيه وقلتم رقبة","رمتُمُ صعباً وقُدتم رَيِّضا",28,"ض",2,0],["لمتموني فيه وربَّ ملومٍ","كان في غيبِ أمره معذورا",29,"ر",2,0],["لم تُمتَهنْ بلفظةٍ يلفظُها","من شرِّها السمعُ ولا معنىً يُرَدّْ",30,"د",1,0],["لم تُمحَ مِنّي جِدَّتي ونضارتي","كلّا ولا نَضُبَتْ غضارةُ رونقي",31,"ق",2,0],["لم تُملْهم عن نوره ظلماتٌ","يا سوى بارتكابهم شهواتك",32,"ك",1,0],["لمتمم لكم الذي أعطاكم","ولكم لديه زيارة وتمام",33,"م",1,0],["لم تمضه عن مصر إلا ناقداً","فيه لك التقييد والإطلاق",34,"ق",1,0],["لَم تَمرَضِ الأَجفانُ مِن قاتِلٍ","بِلَحظِهِ إِلا لأَن أَمرَضا",35,"ض",2,0],["لم تُمْنِ مَنْ لاقى منيَّ","تَهُ فيا عجباً أَمَا",36,"م",2,0],["لم تمزق أحشاك إلا سيوف","يوم فقدانٍ أحمد منتضاها",37,"ا",3,0],["لم تمسكوا من دينهم الا القرا","عد خمسها مدفوفة برياء",38,"ا",2,0],["لم تمض فادحة إلا وأتبعها","بفادح قل أن العين تبكيه",39,"ي",2,0],["لم تمت نفس حوت في شعرها","أمة بل أمما في الناهضين",40,"ن",1,0],["لم تميز مما جنته الليالي","لوعة البين من سرور العيد",41,"د",1,0],["لَم تَمحل الناس ما دامَت مَواهبه","وَكَيفَ يَجتَمع الوَسمي وَالمحل",42,"ل",1,0],["لَم تَمس أَعداؤهم إِلّا عَلى درك","وَجارهم يَأمن الأَهوال وَالدركا",43,"ك",2,0],["لم تمل روحي إلى وطنٍ","لا ولا قلبي إلى وَطَرِ",44,"ر",1,0],["لم تمت همّاً وَلَم تُل","مِم بك الحمّى بسرعه",45,"ع",2,0],["لم تمتنع عندما قاربت ساحتها","وجال جيشكَ في تلكَ الميادين",46,"ن",1,0],["لمت من صدّني عن الطعن جبنا","وَلِمثلي يشار عند القِتال",47,"ل",1,0],["لم تموتي هذه ذكراك فينا","حية نبعثها حينا فحينا",48,"ن",2,0],["لمتمونَي جهلاً لأني وحيدُ","لا تلوموا فإنَّ دُري فريد",49,"د",1,1],["لم تمر الأيام بالرغد حتى","أخذ البيض بعدها بالظهور",50,"ر",1,0],["لم تمثل لهم جمال العذارى","كاشفات الصدور والأجياد",51,"د",1,0],["لَم تَمتَلِك إِلّا وزدت تَواضعاً","وَلربّ ممتلك يَزيد تغطرسا",52,"س",2,0],["لَم تُمِط عن محيَّاك المُنى","لا وَلو أُوتيت معنى يوشع",53,"ع",1,0],["لم تمنعي دمعةً تؤجِّجها","في القلب نار العذاب والغضب",54,"ب",1,0],["لم تميز ضلالها من هداها","لم تفرق حلالها من حرام",55,"م",1,0],["لِمَ تَمضي قبلَ أَن تَجمَعَنا","في ظِلالِ الحُبِّ وَالوكرِ المَهيبِ",56,"ب",1,0],["لَم تَمُت فيها حَياة اللَه","إِن كُنت تَراه",57,"ه",1,0],["لم تُمْضِها يَدُ صَيْقَلٍ مُنذُ اغْتَدى","وَصْلُ الضِرابِ مواصلاً إمضاءها",58,"ا",3,0],["لَم تَمُت أُمَّةُ النَبِيِّ وَفيها","من ذَوَيه مجدِّدٌ وَإِمامُ",59,"م",1,0],["لم تمُت انما المكارم ماتت","لا سقى اللَه بعدك الارض قطرا",60,"ر",2,0],["لم تمض الا ساعة حتى سرت","عنا دجى كرب حسبن رواسيا",61,"ي",2,0],["لَم تَمُت بَعدُ فانتَفِض بانتِماءٍ","لا تُرَى فيهِ ناكِثًا أَو مُخِلَّا",62,"ل",2,0],["لم تمتلك أن تستجيب لصارخ","فالكل يطلق خافي الأنات",63,"ت",1,0],["لم تمت لكنما مات الجسد","وسيبقى لك ذكر في البلد",64,"د",1,1],["لم تمت أنت إنما نحن موتى","فعلى مِثْلِنَا يحقُّ الرثاءُ",65,"ا",2,0],["لم تملك الصبر الجميل عن البكا","لما ركبن على متون جمال",66,"ل",1,0],["لم تموتي فنورك الآن يسري","في المرايا ويزرع القلب ضيّا",67,"ي",2,0],["لمْ تُمهليني لحظة ً","أُفضي إليك بما شعرْت",68,"ت",1,0],["لم تمطر الغيمَ البساتينُ التي...","فالغيمُ سكينٌ هنا ودماءُ",69,"ا",2,0],["لم تمض أنت وإنما أُمضَيْتَ رغ","ماً عنكَ عن نسل وعن أعمامِ",70,"م",1,0],["لم تمتلئْ عينها، كلٌّ يغازلها","وتشتريه برخصٍ كلَّ مَنْ وثبا",71,"ب",2,0],["لم تميز بين الشباب وطفل","قصدوا للعمى غداة لقاء",72,"ا",2,0]]}