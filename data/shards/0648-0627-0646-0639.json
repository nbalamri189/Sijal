ml","الطويل"],[44,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[87,"عم الحيا واستنت الجداول","https://www.aldiwan.net/poem8367.html","الرجز"],[31,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[81,"خضعت وأمرك الأمر المطاع","https://www.aldiwan.net/poem61464.html","الوافر"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[22,"إذا قلت أني آيب أهل بلدة","https://www.aldiwan.net/poem22010.html","الطويل"],[52,"أشكو إلى الله أن الدمع قد نفدا","https://www.aldiwan.net/poem27129.html","البسيط"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[48,"لما تبدى الصبح من حجابه","https://www.aldiwan.net/poem62448.html","الرجز"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[46,"لعمري لقد فضح الأولين","https://www.aldiwan.net/poem22598.html","المتقارب"],[46,"تجنب الوعد يوما أن تفوه به","https://www.aldiwan.net/poem22757.html","البسيط"],[46,"يا خاطري لا توجه وجه سيئة","https://www.aldiwan.net/poem23220.html","البسيط"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[76,"تحف به جنات دنيا تعطفت","https://www.aldiwan.net/poem39035.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140857",""],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16657","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19720",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30487","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9981","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9972","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[66,"كن عن همومك معرضاً","https://www.poetsgate.com/ViewPoem.aspx?id=178182",""],[77,"أمولاي إن الشعر ديوان حكمة","https://www.poetsgate.com/ViewPoem.aspx?id=34161",""],[77,"قلبي وسمعي في شغل عن الفند","https://www.poetsgate.com/ViewPoem.aspx?id=33815",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[45,"أنَاةً أيّهَا الفَلَكُ المُدارُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31279",""]],"verses":[["وَإِن عاتَبتَ هَذا الدَه","رَ صارَ الذَنبُ ذَنبَينِ",0,"ن",1,0],["وَأَنعَمُ مِنّا في الحَياةِ بَهائِمٌ","وَأَثبَتُ مِنّا في التُرابِ جِبالُ",1,"ل",1,0],["وَاِنعَم بِيَومِ المِهرِجانِ وَلا","نَعِمَ العُداةُ بِهِ وَلا عَقَلوا",2,"ل",3,0],["وَإِن عَثَرَ الأَحياءُ مِن بَعدِ مَوتِكُم","فَلا دَعدَعاً لِلعاثِرينَ وَلا لَعا",3,"ع",2,0],["وَاِنعَم بِذا النَيروزِ زَو","رً نازِلاً وَمُنتَظَر",4,"ر",1,0],["وَإِنَّ عَناءَ الناظِرينَ كِلَيهِما","إِذا طَمِعا مِن بارِقٍ في خُلوبِهِ",5,"ب",2,0],["وَإِن عَزَمتُ فَعَزمي يَستَحيلُ قَذىً","تَدمى مَسالِكُهُ في أَعيُنِ النُوَبِ",6,"ب",1,0],["وإنْ عَرَّسُوا خَرُّوا سُجوداً على الثَّرى","عَواطِفَ مِنْ أيدٍ تَطولُ العَوالِيا",7,"ي",2,0],["وَإِن عُشتُ مِن بَعدِ الفُراقِ فَما أَن","كَما أَدَّعي أَنّي بِعَبلَةَ مُغرَمُ",8,"م",1,0],["وَإِن عَرَّضَ الواشي صَفَحنا تَكَرُّماً","وَذو الوُدِّ عَن قَولِ العِدى يَتَكَرَّمُ",9,"م",1,0],["وَاِنعَتوا لي ما بَينَ بُطحانَ فَالمَس","جِدَ ما حَولَهُ وَماذا يُوازي",10,"ي",1,0],["وَأَنعَمَ العاشِقَ في عَيشِهِ","إِن دامَ مَن يَهوى عَلى العَهدِ",11,"د",1,0],["وَأَنَّ عُرى الإيمانِ قَولٌ مُبَيَّنٌ","وَفِعلٌ زَكِيٌّ قَد يَزيدُ وَينقُصُ",12,"ص",1,0],["وإنْ عجَزْتُ فعَنْ عُذْرٍ وثقتُ بهِ","مَنْ رامَ عدَّ الحَصى والقَطْرَ لم يُطِقِ",13,"ق",1,0],["وإنْ عادَ فاسْألْهُ يُجِبْكَ بِما يَرى","لعلّك تَرْثي أوْ لعلّكَ تقنَعُ",14,"ع",1,0],["وَإِن عَليّاً قَدَّسَ اللهُ جَمْعَهُمْ","وَكَرَّمَنَا بِالْقُرْبِ مِنْهُمْ وَحَبَانَا",15,"ن",2,0],["وَإِنْ عَرضَتْ دُونَ التَّزَاوُرِ بَيْنَنَا","مَهَامِهُ تُعْيِي كُلَّ خُفٍّ وَمَنْسَمِ",16,"م",1,0],["وَانْعَمْ بِمُلْكٍ دَائِمٍ لاَيَنْقَضِي","وَاخْلُدْ قِوَاماً لِلْعُلَى وَمِلاَكَا",17,"ك",2,0],["وإن عرَكَتْ منّي الخُطوبُ مجَرِّباً","نِقاباً تَساوَى عنْدَهُ الحُلْوُ والمُرُّ",18,"ر",1,0],["وانْعَمْ بمُقْتَبلِ السُّعودِ فإنّما","يجْري القضاءُ بكلِّ ما تخْتارُهُ",19,"ر",2,0],["وإنْ عَدا الدّهْرُ أبْدى منْ أسرَّتِهِ","وكَفِّهِ رأْيَ حيْرانٍ ورَيَّ صَدي",20,"د",2,0],["وَأَنْعُمٍ غَمَرِتْنِي مِنْهُ وَاكِفَةٍ","وَأَنْشَأَتْ فِي سَمَاءِ اللُّطْفِ لِي سُحُبَا",21,"ب",2,0],["وَانْعَمْ بِمَوْقِعِهِ الجَمِيلِ فَإِنَّهُ","يُشْجِي عَدُوّاً أَوْ يَسُرُّ حَبِيْبَا",22,"ب",2,0],["وَإِنَّ عَليّاً لَكُم مُصحِرٌ","أَلا إِنَّهُ الأَسَدُ الأَسوَدُ",23,"د",1,0],["وَإِنَّ عِتاقَ العيسِ سَوفَ يَزورُكُم","ثَناءٌ عَلى أَعجازِهِنَّ مُعَلَّقُ",24,"ق",1,0],["وَاِنعَ لِلنَيِّراتِ سَعداً فَسَعدٌ","كانَ أَمضى في الأَرضِ مِنها شِهابا",25,"ب",2,0],["وَإِن عَراكَ هُزالٌ","هَيَّأتُ لَحدي وَقُطني",26,"ي",1,0],["وَإِن عَرَضَت غَفلَةٌ لِلرَقيبِ","فَحَسبِيَ تَسليمَةٌ تُختَصَر",27,"ر",1,0],["وَإِن عَصَفَت مِنكَ ريحُ الصُدودِ","فَقَدتُ نَسيمَ الحَياةِ البَليلا",28,"ل",2,0],["وأن عباساً أميرٌ جليل","ذو موكبٍ فخم وزي جميل",29,"ل",1,0],["وَإِن عُدَّتِ الأَيّامُ أَخزَيتَ دارِماً","وَتُخزيكَ يا اِبنَ القَينِ أَيّامُ دارِمِ",30,"م",1,0],["وإِن عَرَضَت دُونَ الضَّلاَلَةِ حَومَةٌ","أخَاضُوا إلَيهَا طَائِعِينَ وأَوثَبُوا",31,"ب",3,0],["وَإِن عَصاهُ لِساني","فَالقَلبُ طَوعُ يَدَيهِ",32,"ي",2,0],["وَإِن عَبَرتَ بِنادٍ لاتُطيفُ بِهِ","أَهلُ السَفاهَةِ فَاِجلِس ذاكَ نادينا",33,"ن",2,0],["وَإِن عاتَبوهُ عَلى مِرَّةٍ","وَنابَت مُبَيِّتَةٌ زادَها",34,"د",3,0],["وانعمْ بوعدِ الأماني عند رؤيتهِ","فإنَّ ذلكَ وعدٌ غير مكذوب",35,"ب",1,0],["وأنعماً دأبها إسداءُ بكر يدٍ","لكنهنَّ أيادٍ ذاتُ توليد",36,"د",1,0],["وأنعامهُ عندِي وشكريَ عندهُ","ولكن متى يوفي بإنعامه الشكر",37,"ر",1,0],["وأنعمٌ قربت عن همَّةٍ بعُدت","كالشمس يدنو سناها حينَ ترتفع",38,"ع",1,0],["وانعم ودُمْ واسمعْ معاني الثنا","على قصور الخلق واسْتمتع",39,"ع",1,0],["وإن عكست الحروف منه","فبلدة ما تكاد تصفو",40,"ف",2,0],["وإن عُدَّتِ الأحْسَابُ يوماً فإنَّمَا","يُعَدُّ مِن الأحْساب رَمْلُ زَرُودِها",41,"د",3,0],["وإن عدا هِرْمسه حدّه","قالت له زُهْرتُه نفِّس",42,"س",1,0],["وإنَّ عبيدَ اللَّه للرَّأْسُ منهمُ","ولولا مكان الرأْسِ لم تك أوصالُ",43,"ل",1,0],["وإن عادوا إلى أخرى سواها","تُتُبِّعتِ الطوائلُ والذحولُ",44,"ل",1,0],["وإن عاد الرئيسُ لبخس حقي","غضبتُ وغضبتي أمرٌ يهولُ",44,"ل",1,0],["وإن عُدَّتِ الآدابُ يوماً وأهلُها","فذكراه ريحانُ القلوبِ المشمَّمُ",45,"م",1,0],["وأنَّ عبيدَ الله للناس عصْمةٌ","بأيديهمُ منها عُرىً لا تُفَصَّمُ",45,"م",1,0],["وإن عاقَ القضاءُ نداك عني","فلستُ أراكَ في مَنْعِي مُليما",46,"م",2,0],["وَاِنعِدامُ الأَريج وَالأَلوانِ","وَاِندِثارٌ لا مَجدَ فيه",47,"ه",1,0],["وَإِنَّ عاطِفَةً هَذي مَظاهِرُها","مِن عالَمِ الروحِ لا مِن عالَمِ الطينِ",48,"ن",1,0],["وَإِن عَرَضَت لي في المَحَبَّةِ نَشوَةٌ","وَحَقِّكِ إِنّي ثابِتٌ وَوَقورُ",49,"ر",1,0],["وَإِن عِشنا لِشَوّالٍ","أَعَدنا ذَلِكَ العَهدا",50,"د",2,0],["وَإِن عَمَرتُ جَعَلتُ الحَربَ والِدَةً","وَالسَمهَرِيَّ أَخاً وَالمَشرَفِيَّ أَبا",51,"ب",2,0],["وَإِن عَرَفتَ مُرادي","تَكَشَّفَت عَنكَ كُربَه",52,"ب",2,0],["وَإِن عَشِقَت كانَت أَشَدَّ صَبابَةً","وَإِن فَرِكَت فَاِذهَب فَما فِركُها قَصدُ",53,"د",1,0],["وَإِن عَراكَ الشَكُّ في نَفسِهِ","بِحالِهِ فَاِنظُر إِلى جِنسِهِ",54,"س",2,0],["وأنعم سحقه بالماء واعزل","أذاه وأهد عند الطبخ نارك",55,"ك",1,0],["وإِن عادَ ذاك السربُ يوماً بعينهِ","أخذتُ بحقي من أصابَ جناني",56,"ي",1,0],["وإِنْ عزَّ ما أرجوهُ منك فإِنَّنِي","لَتُقنعني تسليمةٌ ولِمَامُ",57,"م",1,0],["وإنْ عَلانِيَ مَنْ دُونِي فلا عَجَبٌ","لي أُسوةٌ بانحطاطِ الشمس عن زُحَلِ",58,"ل",1,0],["وَإِنَّ عَلِيّاً لَأَولى بِكُم","وَأَزكى يَداً عِندَكُم مِن عُمَر",59,"ر",1,0],["وَأَنَّ عَلى أَبي العَبّاسَ سيما","تُخَبِّرُ مِنهُ عَن كَرَمٍ وَخيرِ",60,"ر",1,0],["وَإِنَّ عَوائِدَ الأَيّامِ فيها","لِما هاضَت بَوادِؤُها اِنجِبارُ",61,"ر",1,0],["وَإِنَّ عَلَيها إِن رَأَت مِن غِمارِها","ثَنايا بِراقٍ أَن يَجِدَّ نَجاؤُها",62,"ا",3,0],["وَإِن عُدَّتِ الآباءُ كُنتَ اِبنَ خَيرِهِم","وَأَملاكِها الأَورَينَ في المَجدِ أَزنُدا",63,"د",2,0],["وَإِن عُدَّتِ الأَحسابُ يَوماً وَجَدتَها","يَصيرُ إِلى حَيَّي تَميمٍ مَصيرُها",64,"ر",3,0],["وإن عَفَتِ الأقدارُ عنه فقَد عَفَتْ","مَصايفُه منه وَأَقْوَتْ مرابِعُه",65,"ع",2,0],["وإنْ عادَ خوفاً من سُيوفِكَ ربُّها","بِدِرَّتِها أضحَى لَديْكَ أسيرَها",66,"ر",3,0],["وإنَّ عَلِيّاً بائعَ الملحِ بالنَّوى","تجرَّدَ لي بالسَّبِّ فيمَن تجرَّدا",67,"د",2,0],["وإن عُمْنَ في طامي المياهِ تَبسَّمَتْ","غرائِبُها ما بينَ تلك الغَرائبِ",68,"ب",1,0],["وإن عَذُبَتْ رَيَّاه أو طابَ نَشرُه","فقد مَلَّ في بطحائها الكرَمُ العَذْبُ",69,"ب",1,0],["وإن عجزتَ فكن في الموت لي كفناً","أمت وألقى إلهي غيرَ هيَّابِ",70,"ب",1,0],["وإن عصت نارها فكن","قبراً لها آخر الأبد",71,"د",1,0],["وإِنَّ عَليّاً يَنْتَضي القُضُبَ الَّتي","يَرُدّ بها مَدّ العُداةِ إلى قَصْرِ",72,"ر",1,0],["وَإِن عَثَرَت سودُ اللَيالي وَبيضُها","بِوَحدَتِهِ أَلفَيتَها وَهيَ مَجمَعُ",73,"ع",1,0],["وَانْعَمْ فَأَيَّامُ الصِّبَا قَلائِلُ","وَالْمَرْءُ فِي الدُّنْيَا خَيَالٌ زَائِلُ",74,"ل",1,0],["وَإِن عاتَبَتهُ مَرَّةً كانَ قَلبُهُ","لَها ضَلعُهُ حَتّى تَعودَ العَواصِفُ",75,"ف",1,0],["وَإِن عَصَفَت يَوماً بِهِم ريحُ زَجرَةٍ","وَلَفَّهُمُ خَطبٌ تَقَعقَعَ مُرعِدُ",76,"د",1,0],["وَإِن عُطِّلَ النادي بِهِ مِن حِلاكُمُ","وَكانَ عَلى عَهدِ التَفاوُضِ حالِيا",77,"ي",2,0],["وإن عَدَتِ العوادِي فاذكرونا","وقولوا أُمّةٌ ترعى الذِّماما",78,"م",2,0],["وإنّ علينا أن نُقوِّمَ دَرأَهم","إذا ما مشى منهم إلى الشَّرِّ ظالعُ",79,"ع",1,0],["وَإِن عَبَّرتُ عَن شَوقي بِكُتبٍ","تَلَهَّبَ في أَنامِلِيَ اليَراعُ",80,"ع",1,0],["وَإِن عادَ فيها النَزعُ تَأبى بِصُلبِها","وَتُقبِلُ مِن أَقطارِها فَتُطيعُ",81,"ع",1,0],["وَإِن عَبَّ في ماءٍ سَمِعتَ لِجَرعِهِ","خَواةً كَتَثليمِ الجَداوِلِ في الدَبرِ",82,"ر",1,0],["وَأَنَّ عَينِيَ في لَيلٍ مُسَهَّدَةٌ","فَلَستُ أَرقُدُ فيهِ مِثلَ مَن رَقَدا",83,"د",2,0],["وإنْ عَجَمَتْ أَفواهُها عُودَ بأْسِهِ","أَفادَتْكَ عِلْماً أنَّ أَفواهَها دُرْدُ",84,"د",1,0],["وأنَّ عَذابَ المُجْرِمِينَ بِعَدْلِهِ","طويلٌ وعُمْر الخائِنِينَ قَصِيرُ",85,"ر",1,0],["وَاِنعَدَلَ اللَيلُ إِلى مَآبِهِ","كَالحَبَشِيِّ اِفتَرَّ عَن أَنيابِهِ",86,"ب",2,0],["وَإِنَّ عَبّاسَ مِثلُ والِدِهِ","لَيسَ إِلى غايَةٍ بِمَسبوقِ",87,"ق",1,0],["وَإِن عَجِبوا لِاِحتِباسِ الغَمامِ","فَأَعجَبُ مِن ذاكَ أَن يُمطَروا",88,"ر",3,0],["وَإِن عَجَزتَ عَنِ الخَيراتِ تَفعَلُها","فَلا يَكُن دونَ تَركِ الشَرِّ إِعجازُ",89,"ز",1,0],["وَإِن عَلِمتَ مَآلي عِندَ آخِرَتي","شَرّاً وَأَضيَقَ فَاِنسأ رَبِّ في الأَجَلِ",90,"ل",1,0],["وَإِن عُرِّيَت كاسِياتُ الغُصو","نِ فَلتَكسُ بِالدِفءِ مَن تَكسُوانِ",91,"ن",1,0],["وإن عُصرتْ مجَّتْ رُضاباً كأنها","جَنَى النَّحلِ من طيبٍ وما تَعرفُ النَّحلا",92,"ل",2,0],["وإنَّ عذري عجزي","فليقبل القوم عذري",93,"ي",1,0],["وإن عمرتُ جعلت الحرب والدةً","والسهمري أخاً والمشرفي أبا",94,"ب",2,0],["وَإِنَّ عَروضَ الوَصلِ بَيني وَبَينَها","وَإِن سَهَّلَتهُ بِالمُنى لَكَؤودُ",95,"د",1,0],["وأنْعَمَ قيْسٌ فِكْرَهُ في قِياسِها","بما أعْجَزَ النّعمانَ حينَ يُقايِس",96,"س",1,0],["وإنْ عاشَ لاقَى ذِلّةً واخْتِيارُهُ","وفاةُ عَزيزٍ لا حياةُ ذَليل",97,"ل",1,0],["وأنعت المجد القدي","م وأحلِّى النسبا",98,"ا",1,0],["وأَنْعى خسيساتِ ابْنِ آدم عاملاً","براحَةِ طِفْل أَحكم الضُّرُّ نَصْلَهَا",99,"ل",3,0],["وَإِن عابَت سَوادي فَهوَ فَخري","لِأَنّي فارِسٌ مِن نَسلِ حامِ",100,"م",1,0],["وَإِن عُشتُ مِن بَعدِ الفُراقِ فَما أَنا","كَما أَدَّعي أَنّي بِعَبلَةَ مُغرَمُ",101,"م",1,0],["وَإِنْ عُدْتُ فِيمَنْ شَيَّعُوكِ فَلاَ يَكُنْ","بِمَوْتِيَ لِي مِنْ صَاحِبٍ وَمُشَيِّعِ",102,"ع",1,0],["وَإِن عَلَّلَتني الغَواني فَقَد","أَراهُنَّ مُذ شبتُ لي فُرَّكا",103,"ك",2,0],["وأنّ عمّ خاله","كان يزين يحصبا",104,"ب",2,0],["وإن عشقتْ روحُ الفتى راحةَ الفتى","فلا خير في روحٍ ولا خيرَ في جسْمِ",105,"م",1,0],["وانْعَمْ بِعِيدِ الفِطْرِ واسْعَدْ بالمُنَى","في طالِعٍ ضَافي النَّعيمِ سَعِيدِ",106,"د",1,0],["وانعَمْ برضْوانِ الإِله وظِلِّه","واسعَدْ بعَيْشِ الْخُلْدِ في جَنَّاتِهِ",107,"ت",2,0],["وانعم بطول سلامة","تُسليك عما قد مضى",108,"ض",2,0],["وأن عليا قدس الله جمعهم","وكرمنا بالقرب منهم وجارانا",109,"ن",2,0],["وإن عدا الدهر أبدى من أسرته","وكفه رأي حيران وريى صد",110,"د",1,0],["وإن عيوباً جلْبَبَ الكِذبُ كُنْهَها","فغَطَينَ أضعافَ العيوبِ السوافِر",111,"ر",1,0],["وإنَّ عُضالاتِ هذا المحيط","نقائصُ أعوزها المصلحونا",112,"ن",2,0],["وَإنّ عَوَائِدَ الأيّامِ فيهَا،","لمَاْ هاضَتْ بَوَادِئُها، انجِبَارُ",113,"ر",1,0]]}