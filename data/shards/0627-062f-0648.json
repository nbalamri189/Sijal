spx?id=189721",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5950,"هذي هي أخباري","https://www.poetsgate.com/ViewPoem.aspx?id=128134",""],[5950,"ممكن أغنّي على الطاروق","https://www.poetsgate.com/ViewPoem.aspx?id=128138",""],[5956,"أدوس على أشعاري الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=193515",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[6051,"أَدُّوا إلى مَيْدَانَ عَنْكُمْ عِرْسَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=85166",""],[6068,"سحّتْ دموعي لجّها تهيّيجا -17-","https://www.poetsgate.com/ViewPoem.aspx?id=175813",""],[6089,"تسامرُني الأشواقُ في غارِ وحشتي","https://www.poetsgate.com/ViewPoem.aspx?id=214639",""],[5957,"ياحبيبي النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82404&r=&rc=39",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""]],"verses":[["أَدومُ بِعَهدي ما حَييتُ وَقَلَّ مَن","يَدومُ عَلى عَهدٍ وَلا يَتَغَيَّرُ",0,"ر",1,0],["إِدوارُ دُمتَ وَدامَ المُلكُ في رَغَدٍ","وَدامَ جُندُكَ في الآفاقِ مُنتَصِرا",1,"ر",2,0],["أَدُّوا حُقُوقَ نَقِيبِهَا وَخَطِيبِهَا","فَأَدِيبِهَا المُتفَوِّقِ الفَنَّانِ",2,"ن",1,0],["أَدورُ حَوالَيكِ البُيوتَ كَأَنَّني","إِذا جِئتُ عَن إِتيانِ بَيتِكِ مُحرِمُ",3,"م",1,0],["أَدّوا أُسَيدَةَ في جِلبابِ أُمُّكُمُ","غَصباً فَكانَ لَها دِرعٌ وَجِلبابُ",4,"ب",1,0],["أدوَتْ وغابَ دَواؤُها","عن كل نفسٍ مُسْتطبَّهْ",5,"ب",2,0],["إدورد ما لك كلما","سأل الملا لا تنبس",6,"س",1,1],["أَدّوا إِلى الغازي النَصيحَةَ يَنتَصِح","إِنَّ الجَوادَ يَثوبُ بَعدَ جِماحِ",7,"ح",1,0],["أدُّوا رِسالَتَها واقْضُوا لُبانَتَها","وامْضُوا سِراعاً إلى الغاباتِ أرسالا",8,"ل",2,0],["أَدوَيتِني وَدَواءُ الحُبِّ عِندَكُمُ","لَو كُنتِ تَشفينَني مِن داخِلِ الكَمَدِ",9,"د",1,0],["أَدّوا الحُقوقَ تَفِر لَكُم أَعراضُكُم","إِنَّ الكَريمَ إِذا يُحَرَّبُ يَغضَبُ",10,"ب",1,0],["أَدُومُ عَلى العَهدِ ما دامَ لِي","فَإن خانَ خُنتُ وَلَم أَكذِبِ",11,"ب",1,0],["أَدورُ فلا أَعْتامُ غيْر مُحارِبٍ","وأَسْعى فلا أَلْقَى امْرأً لِي يُسالِمُ",12,"م",1,0],["أَدُورُ بِعَيْنِي لا أَرَى غَيْرَ أُمَّةٍ","مِنَ الرُّوسِ بِالْبَلْقَانِ يُخْطِئُهَا الْعَدُّ",13,"د",1,0],["أَدُورُ بِعَيني لا أَرَى بَيْنَهُمْ فَتىً","يَرُودُ مَعِي في الْقَوْلِ حَيْثُ أَرُودُ",14,"د",1,0],["أَدُورُ بِعَيْنِي لا أَرَى وَجْهَ صَاحِبٍ","يَرِيعُ لِصَوْتِي أَوْ يَرِقُّ لِمَا أُبْدِي",15,"د",2,0],["أَدَواتُ لَهْوٍ نَسْتَعِينُ بِهَا عَلَى","سَيْرٍ عَسِيرٍ فِي الحَيَاةِ كَؤُودِ",16,"د",1,0],["ادْوَرَدُ يَا أَوْفَى الرِّجَالِ إِذَا دَعَا","في حِينِهِ دَاعِي الْقِيَامِ بِوَاجِبِ",17,"ب",1,0],["أَدوا الْحُقُوقَ لِصَحْبِهِ ال","أَبْرَارِ أَحْسَنَ مَا تُؤدَّى",18,"د",2,0],["إِدْوَرَدُ عِشْ مُتَوَافِرَ الآلاَءِ","مَرْفُوعَ الجَنَابْ",19,"ب",1,0],["أَدّوا إِلى جارِهِم خَفارَتِهِ","وَلَم يَضَع بِالمَغيبِ مَن نَصَروا",20,"ر",3,0],["أدُّوا إليه دَيْنه","والدِّينْ محتومٌ أداؤه",21,"ا",3,0],["أدون فتوح النصر ترضى دنية","وهل في سوى الفردوس يخلد نائم",22,"م",1,0],["َادُوا وُقُوفاً حَوْلَ قَبْرِكْ","يَتَنَاشَدُونَ جَمِيلَ ذِكْرِكْ",23,"ك",1,1],["أدوات الحرب عنها أضربت","والتقت أجمعها في محفل",24,"ل",1,1],["أدور بكم في شطحة الفكر دائماً","فاقطع فيكم قطعة البر والبحر",25,"ر",1,0],["أدور بعينٍ حير العيش لحظها","وأرجعها محمرةً كالشقائق",26,"ق",1,0],["أدُّوا إلى الأبدانِ حق غذائها","إن الغذاءَ مقوِّم الأجسامِ",27,"م",1,1],["أدواتُ الفخرِ ألقَّنَ فيه","حسَبا عِداًّ وعِرقا مُصاصا",28,"ص",2,0],["أدورُ على جَنبي مخافةَ أنّني","أرى الجارَ جارَ السوءِ لزقاً إلى جَنبي",29,"ب",2,0],["أدور بعيني نحو كل شعاعة","على الأفق في نجم أو الأرض في زهر",30,"ر",1,0],["أدولتكم تدوم وأنت فيها","قذاة العين في الوجه المليح",31,"ح",1,0],["أدؤرْها على الروْضِ الذي راقَ حُسنُهُ","فكَمْ لك منْ مرْأى هناكَ أَنِيق",32,"ق",1,0],["أَدور بطرفي لا أرى بعد فقدِهمْ","خليلاً عَلَى البلوى يقاسمني سهما",33,"م",2,0],["ادولة دولة الأغرار قد نهضوا","إلى المناصب والاكفاء اشهاد",34,"د",1,0],["أدوم على خصاصته طويلاً","مخافة أن يقال شكا اقتناعا",35,"ع",2,0],["أَدورُ وَلَولا أَن أَرى أُمَّ جَعفَرٍ","بِأَبياتِكُم ما دُرتُ حَيثُ أَدورُ",36,"ر",1,0],["أَدورُ وَلَولا أَن أرَ أُمَّ جَعفَرٍ","بِأَبياتِكُم ما دُرتُ حَيثُ أَدورُ",37,"ر",1,0],["أدواتها في علبة مجموعة ال","أجزاء لم تترتب بكف رياح",38,"ح",1,0],["أدوا به حق إنسانية رعيت","فيهم وكانت لهم من أحسن السنن",39,"ن",1,0],["أدوم على حسن العهود بكم عسى","تواصلنا يوما بكل المآرب",40,"ب",1,0],["أدور على الأكوان كيما أرها أو","أرى من يراها أو تماط خمورها",41,"ر",3,0],["أدواكُمُ لسَقيمِ المجدِ عافيةٌ","لكنّهُنّ لأبحارِ الثّنا عِلَلُ",42,"ل",1,0],["أدور من ذي إلى ذي","وليس عندي تواني",43,"ن",2,0],["أدوسُ بأقدامِي جِبَاه عزِيزِهم","وغن رامَ رفعَ الرأسِ فالهَلكُ والعَطبُ",44,"ب",1,0],["أدْوَتْ فؤادِي من صَبا","بتها وضنّتْ بالعلاجِ",45,"ج",1,0],["أدُورُ على رِضاكَ ولا أراهُ","كأنِّي طالبٌ لِسعِيدَ مِثْلا",46,"ل",2,0],["أَدُورُ لِتَقْبِيلِ الثَّنَايَا وَلَمْ أَزَلْ","أَجُودُ بِنَفْسِي لِلنَّدامَى وَأَنْفاسِي",47,"ي",1,1],["أدَّوا نَفُوسَهُم القَنا فَكَأنَّها","كانَت لَديهِم للرِّماحِ وَدائِعا",48,"ع",2,0],["أدُّوا زَكاةَ جَمالِكُمْ مِسْكِينَكُمْ","مُلِّكتُمُ فَهَبُوا رُحِمْتُمْ فارْحَموا",49,"م",3,0],["أَدورُ على جوانب قبر ليلى","وأَبكي حَوله بدمٍ فضيض",50,"ض",1,0],["أدُورَ أحِبَّةٍ ليستْ بِدورِ","رأيتُكِ دورَ غُيَّابٍ حضورِ",51,"ر",1,1],["أَدورُ وَأَمشي لا أُجاوِزُ مَوضِعي","وَإِنّي بِهذا الحالِ تُشبِهُني الرّحى",52,"ا",1,0],["أدُوادُ إنّ الأمرَ أصبح ما ترى","فانظرْ دوُادُ لأيِّ أرضٍ تَعْمِدُ",53,"د",1,1],["ادّوا له حسن الإطاعة ذمةً","ومن الوجوب تبرر المتهم",54,"م",1,0],["أَدُوُر له في كل وجهٍ لعلَّني","سأثبتهُ وهو الذي ظلَّ يَحذِفُ",55,"ف",1,0],["أَدورُ في القصرِ لا أَرى أَحداً","أَشكو إِليه وَلا يكلّمني",56,"ن",2,1],["أَدورُ فيهِم وَعمرانُ يُخاطِبُهُم","مِنّي وَهُم فِيَّ مِن رَوحٍ وَمِن زُفَرِ",57,"ر",1,0],["أدوا الخضوع له يا قوم واعتبروا","فهو الحسام الذي يسطو به اللَه",58,"ه",1,0],["أَدّوا الأَمانَةَ حَقَّها وَاِجنوا عَلى","دُستورِ أُمَّتِكُم جِنايَةَ مُجرِمِ",59,"م",1,0],["أَدوْحَتي العُظْمَى من القُدْس متِّعي","بِقِسْطي من قُدْسِيّ ذاك الغِذا غُصْني",60,"ن",2,0],["إدوار دارت على الآمال دائرةٌ","جلى ومنت إلى الأجال اعمار",61,"ر",1,0],["أدور بعيني لا أرى غير لحده","كأن جميع الكون ذلكم اللحد",62,"د",1,0],["أدواي بُمعْتّلِ النسيمِ حشاشتي","وجسْمي عليلٌ والنّسيمُ علِيلُ",63,"ل",1,0],["أَدّوا إِلى رَوحِ بنِ حَس","سانِ بنِ حارِثَةِ بنِ مُنذِر",64,"ر",1,1],["أَدواءَ هَذا العَيش اِعييتِني","أَلا دَواءٌ يَبتَغي ناجِعُه",65,"ع",2,0],["أَدورُ على بيوت الناس لَيْلاً","وأَنْهَقُ كالحمير وكالبِغالِ",66,"ل",1,0],["أدَّوا صلاتَهُم المُثلَى كأنَّهُمُ","وَهُم صُفُوفٌ وراء القارِىءِ المَلَكُ",67,"ك",1,0],["أدواتُنا تبدو كذا","كَي لا يَحلّ بها ضَرَر",68,"ر",1,0],["أدوا إلى أهل الحجاز تحية","وأقروا سلاما زاكيين رقيما",69,"م",2,0],["أَدُّوا السَّلامَ سَلِمْتُمُ وَبِرَدِّهِ","أَرْجُو الإجارَةَ مِنْ وُرُودِ النَّارِ",70,"ر",1,0],["أَدور على قلبي لأنّي فقدتُه","وأَما دموعي فهي تَجري على جِسمي",71,"ي",1,0],["أَدورُ فيهِ نَهاري ثُمَّ مُنقَلِبي","بِاللَيلِ أَدهمُ مَزرورٌ بِأَزرارِ",72,"ر",1,0],["أَدوارُها دائرات","أَوطارُها أَطوارْ",73,"ر",1,0],["أدور على المنازل أبتليها","عسى ألقى لصبٍّ دارَ دارا",74,"ر",2,0],["أَدّوا ذِمامَةَ حِصنٍ أَو خُذوا بِيَدٍ","حَرباً تَحُشُّ الوَقودَ الجَزلَ وَالضَرَما",75,"م",2,0],["أدوا الحقوق مرغبها ولازمها","لله والخلق فاستعلوا على الرتب",76,"ب",1,0],["أدوى بخير البرايا","في حسن خلق وحسنى",77,"ن",2,0],["أ دونكِ أحيا وانتِ الحياه","وهل دون حبك إلا العدم؟",78,"م",1,0],["أدوارهم في نشر مايهوَون من","بغيٍ به أهل الخنا تتنادم",79,"م",1,0],["أدوّر صعلكة: عبدالعزيز | وما معي .. اخبار !","سوى همٍ لعب فيني .. وتاه بغصّة / اهدابي !",80,"ب",2,0],["أدوّر ريق يبلعني , ولكن صار لي ما صار","على غفلة .. كتبني الليل فجر وقلت له ما بي !",80,"ب",2,0],["ادوّر اللي معي نيّر","ونلقى بعضنا ولاندري",81,"ر",2,0],["أدوزنُ في شفاهِ الريحِ شعري","فتطربهُ الحناجرُ والدفوفُ",82,"ف",1,0],["ادّوده قليبي وتخربط كياني","القلب يتراقع به النّبض مفتون",83,"ن",1,0],["آدومُ * رفقا بي فاني عاشقٌ","يا اختَ تاريخٍ تَجلى في العنان",84,"ن",1,0],["أدور بحلمي على كل بيت","أعاتب صمتا طويلا طويلا..",85,"ل",2,0],["أدورلك كلام أجمل ولا اجمل من كلام القلب","وعمر القلب مايكذب نهار يحدث احبابه",86,"ب",2,0],["أدورُ مرارًا على وحدتي","وأرفضُ شوقًا بأنْ أُدْبِرَا",87,"ر",2,0],["أدورُ على مداكِ بغيرِ وعيٍ","كأني في هواكِ فقدتُ رشدي",88,"د",2,0],["أدَوّر قلبي رغيفا نقيا","يُعَمّرُ مائدة الجائعين",89,"ن",1,0],["أدورُ غَيْمًا على أشلاءِ ضحكتنا","ومِن أَريجِكَ حلوَ القولِ أَسترقُ",90,"ق",1,0],["أدورُ على كُلِّ الْقُلوبِ بلَيْلَةٍ","كَبَدْرٍ أحاطَتْ بالْوُجودِ مَنازِلُهْ",91,"ل",2,0],["أدور بالدار لا خلٌّ يُسامرني","ولا وليدٌ بيوم العُسر مُبتسمُ",92,"م",1,0],["أدور بالحيّ هيماناً لوحشتهم","والكرْبُ في القلب جاثٍ والدموعُ فمُ",92,"م",1,0],["أدوزِنُ ما تشظّى من جراحي","من الأشواقِ والأشواقُ تُضني",93,"ن",2,0],["أدوخ وأنتشي فرحاً إذا إتلقا","وغاب البدر أو صدحت موواويلُ",94,"ل",1,0],["أدورُ بضمْنِكَ في اللامكانِ","وأنتَ تدورُ عليّ وَضمْني",95,"ن",2,0],["أدور الكونَ ملاحاً","وبين يديك مرساتي",96,"ت",2,0],["أدور على معنى الحياة تصوّفا","وفي الروح زخات الضياء فلا أُلوى",97,"و",2,0],["أَدْوَاؤُنَا أَعْضَلَتْ فَمَنْ يُطَبِّبُهَا..","وَ مَنْ يُدَاوِي أَذًى فِي تَرْكِهِ الْعَطَبُ..?!",98,"ب",1,0],["أدوسُ على مساميرٍ ونارٍ","كأنَّ العمرَ سَيرٌ فوقَ جمرِ",99,"ر",1,0],["أدوّر عن ذهب عمري .. أدور كنزي المفقود","وأشوف الموج يطوي الموج ويبحر مركب أحلامي",100,"م",2,0],["أَدورُ على نفسي بشَرقٍ ومَغربٍ","جَنوبٍ شمالٍ والهوى صارَ عَلقَما",101,"م",2,0],["ادور وانا ادري وين وجهي ووجهتي","واميز طريقي حين ماالموج هاج به",102,"ب",2,0],["أدور ) ف وجيه الليالي والأيام","( أدوّر ) اللي ضيعته الليالي !",103,"ل",2,1],["ادور ومقلتي مني تناءت","لتبحث في السراب عن الشهودِ",104,"د",1,0],["أدواتُ جرٍّ للغرامِ وجرُّهنَّ","إلى الهَوَى هُو غايةُ الآرابِ",105,"ب",1,0],["أدور داخل رحاة الوقت وأشعاري","تقتاتها الناس جوع وتطرب ل/ ونّي",106,"ن",2,0],["أدون منّك حلم ما يوم قد جاب","شلون بتجيبك حظوظ الغلابه",107,"ب",2,0],["أدوس عليها ولا أرتجيكْ","فإني عرفتك مِمّن يليكْ",108,"ك",1,1],["أدور عسى ألتقيهم قُبالي","وأصبر حتى يتم الوصالُ",109,"ل",1,0],["أَدُّوا إلى مَيْدَانَ عَنْكُمْ عِرْسَهُ","ودعوا سِبَابِي يَا بَنِي عُرْقُوبِ",110,"ب",1,1],["أدّوا زكاة عقولكم كي تبعثوا","في العالمين الحبّ والتهريجا",111,"ج",2,0],["أدوّنها في الأفقٍ شمسًا وأنجمًا","سوى ضوئها عن أعينِ الناس يأفلُ",112,"ل",1,0],["أدون من دمي أنغام بوحي","مناهل ادمعي من قلب شاعر",113,"ر",1,0],["أدوزنُ فوقَ خاصرةِ التلاشي","مساميراً تفهرسُ منتهايا",114,"ا",3,0]]}