{"poems":[[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[30,"إليك ابن سيار فتى الجود واعست","https://www.aldiwan.net/poem5297.html","الطويل"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[52,"بعثت بذكرها شعري","https://www.aldiwan.net/poem62301.html","مجزوء الوافر"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[234,"وزنجية الآباء كرخية الجلب","https://www.aldiwan.net/poem51235.html","الطويل"],[303,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[342,"إذا ما جد واستذكى عليها","https://www.aldiwan.net/poem45312.html","الوافر"],[342,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70793","الوافر"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33101","الطويل"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109032","المتقارب"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109046","الوافر"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114828","الوافر"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36190","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2149,"","https://poetry.dctabudhabi.ae/diwan/poem/115144","الوافر"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28855","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28864","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69949","الوافر"],[5038,"تراءى","https://www.poetsgate.com/ViewPoem.aspx?id=190109",""],[5458,"الحج غدفة","https://www.poetsgate.com/ViewPoem.aspx?id=72397",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""]],"verses":[["فلما شارَفَ الحَرَمَ اسْتَنارَتْ","بهِ سُرَرُ الأباطِحِ والمَحاني",0,"ن",2,0],["فَلَمّا شَكَت عَضَّ الرِحالِ ظُهورُها","إِلى خِندِفِيِّ الجودِ لِلضَيمِ دافِعِ",1,"ع",1,0],["فَلَمّا شَتا ساقَتهُ مِن طُرَّةِ اللَوى","إِلى الرَملِ صِنَّبرُ شَمالٍ وَداجِنِ",2,"ن",1,0],["فَلَم أَشتُم لَكُم حَسَباً وَلَكِن","حَدَوتُ بِحَيثُ يُستَمَعُ الحُداءُ",3,"ا",2,0],["فَلَمّا شاقَها قَولي","وَشَبَّ الحُبُّ فَاِحتُنِكا",4,"ك",2,0],["فلما شجاني حاله وأفزّني","وقفت وكلّي مَجْزَع وتَوَجُّع",5,"ع",1,0],["فلمّا شِربناها صَبَوْنا كأنّنا","شِربنا السّرورَ المحض والَّلهو والطَّرب",6,"ب",1,0],["فلما شبّتِ النيرانُ فيها","وَطال لهيبُها أعلى ذراها",7,"ا",3,0],["فَلَمّا شَرَّعَت قَصَعَت غَليلاً","فَأَعجَلَها وَقَد شَرِبَت غِمارا",8,"ر",2,0],["فَلَمّا شَراها فاضَتِ العَينُ عَبرَةً","وَفي الصَدرِ حُزّازٌ مِنَ الوَجدِ حامِزُ",9,"ز",1,0],["فلما شِمْتُ أسطرَه","سِكرت به بلا سُكرِ",10,"ر",1,0],["فَلَمّا شَرِبتُ الكَأسَ بانَت بَأُختِها","فَبانَ الغَزالُ المُستَحَبُّ خَلائِقُه",11,"ق",2,0],["فلما شَرَعن رمى واتقى","بسهم ثنى حدَّه الأثأبُ",12,"ب",1,0],["فلما شفعنا إليه فحن","واسهر أجفاننا ثم نام",13,"م",1,0],["فلما شبتُ شاب معي فؤادي","وقلت وقالت الحسناءُ حسبي",14,"ي",1,0],["فلمَّا شَقَّ أَبيَضُ ذو حَواشٍ","له حالٌ وللظلماءِ حالُ",15,"ل",1,0],["فَلَمّا شَرِبناها بإِقراه فمها","أَضاءَ لَنا مِنها شُموس وَأَقمارُ",16,"ر",1,0],["فلما شام بارقة المواضي","ببدرٍ خار من فرق وخاما",17,"م",2,0],["فلمّا شاب رأسي في ذراهُ","حجبتُ لعقبِ ما بعدَ اللقاءُ",18,"ا",2,0],["فَلَمّا شَفاني اليَأسُ عَنهُ بِسَلْوَةٍ","وَأَعذَرْتُما لا بَل أَجَلَّ مِنَ العُذْرِ",19,"ر",1,0],["فَلَم أَشْرِ وُدّي بِالكَسادِ وَلَم أَعُدْ","إِلى الماءِ يأذى أَهلُه وَيُحَسّسُ",20,"س",1,1],["فَلَما شمتُ بارقهُ تجلّى","لِعَين بَصيرَتي نورُ الهِلالِ",21,"ل",1,0],["فلمّا شعَّ مِنْ خدّيهِ زهْرٌ","تضوّعَ خالُهُ مسْكاً شذيّا",22,"ي",2,0],["فلما شاهد الإخلاص فيهم","وما حملوه أعناباً وتينا",23,"ن",2,0],["فلما شكا بعد الأثافي قدرها","وضنت على الشدق الحفي المراضع",24,"ع",1,0]]}