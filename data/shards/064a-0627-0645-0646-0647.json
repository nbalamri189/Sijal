كل ساعة في شأن","https://www.poetsgate.com/ViewPoem.aspx?id=121730",""],[5277,"عبقُ الراسقي","https://www.poetsgate.com/ViewPoem.aspx?id=200070",""],[5388,"درة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=206916",""],[5397,"طلعت بك العليا بنجم أسعد","https://www.poetsgate.com/ViewPoem.aspx?id=157935",""],[5431,"حول المذابح كم يطيب المرقصُ","https://www.poetsgate.com/ViewPoem.aspx?id=185558",""],[5577,"وألوذ من عجم الشعور إليها","https://www.poetsgate.com/ViewPoem.aspx?id=177006",""],[5587,"وجد وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=196570",""],[5590,"يا من هوى مع فضله همة","https://www.poetsgate.com/ViewPoem.aspx?id=105284",""],[5720,"اقرأْ فديتُكَ *","https://www.poetsgate.com/ViewPoem.aspx?id=199236",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[5759,"يا غادتي","https://www.poetsgate.com/ViewPoem.aspx?id=213624",""],[5845,"قفْ بالخضوعِ ونادِ ربكَ يا هو","https://www.poetsgate.com/ViewPoem.aspx?id=15455",""],[5845,"ياصاحبَ القبرِ المنيرِ بيثربِ","https://www.poetsgate.com/ViewPoem.aspx?id=16605",""],[5956,"الزوجُ أهمُّ شُغل ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182373",""],[5957,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=56335",""],[5991,"يا قانعاً بصفاته عن ذاته","https://www.poetsgate.com/ViewPoem.aspx?id=116387",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6056,"لبّى عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=130332",""],[6213,"نبراس أمتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76308&r=&rc=56",""]],"verses":[["يا مَن هُوَ جَنَّتي وَيا روحي أَنا","إِن دامَ عَلَيَّ هَجرُكُم يُعييني",0,"ي",1,0],["يا مَن هَواهُ دائِماً","في مُهجَتي لا يَنقَضي",1,"ض",2,0],["يا مَنْ هواه من القلوب مَكينُ","والماءُ في الوَجَنات منه مَعينُ",2,"ن",1,1],["يا من هجرت إلى الأوطان رؤيتها","فرحت أشوق مشتاق لأوطان",3,"ن",1,0],["يا مَن هربتِ من القضاء وصرفهِ","عجباً لهاربةٍٍ تلوذ بهاربِ",4,"ب",1,0],["يا من هجرت لقد هجرت إلى مدى","فإلى اللقاء ولن أقول وداعا",5,"ع",2,0],["يا مِنَّةً لَكَ لَولا ما أُخَفِّفُها","بِهِ مِنَ الشُكرِ لَم تُحمَل وَلَم تُطَقِ",6,"ق",1,0],["يا مَنْ همْ للعينِ قرَّهْ","ولبيتِهِمْ قدرٌ وقدرهْ",7,"ه",1,1],["يا مَنْ همُ في جلِّقٍ","عيني عليكمْ في حلبْ",8,"ب",1,0],["يا مَن هُديتُ لِحُبِّهِ فَمَحَجَّتي","بَيضاءُ في نَهجِ الغَرامِ الواضِحِ",9,"ح",1,1],["يا من هَواها أَجرى دُموعي","وَأَشعل النار في ضُلوعي",10,"ي",1,0],["يا مِنَّةَ إِمتَنَّها السُكرُ","ما يَنقَضي مِنّي لَكَ الشُكرُ",11,"ر",1,1],["يا مُنهِضَ المُلكِ إِذ ريعَت لِكَبوَتِهِ","نُفوسُنا وَمُجيرَ الشَعبِ إِذ نُكِبا",12,"ب",2,0],["يا منهلاً لم أَستَطع","ورداً إليه من الزحام",13,"م",1,0],["يَا مَنْ هَوَاهَا مَجْدُ أُمَّتِهَا","مَهْمَا يُجَشِّمُهَا مِنَ الْنَّصَبِ",14,"ب",1,0],["يا مُنهض الأدب المهضوم في زمنٍ","تعيشُ فيه القوافي عيش مُغترب",15,"ب",1,0],["يا من هجرت وقد غدرت ارجع فقد","تمحو الليال رونق الايام",16,"م",1,0],["يا مَنْ هوَ الماءُ في تَكْوينِ خِلْقَتِهِ","وَمَنْ هُوَ الخمرُ في أَفعالِ مُقلَتِهِ",17,"ت",2,1],["يا من هو الملجأُ والمعقلُ","مدح سواكَ اليومَ لا يحملُ",18,"ل",1,1],["يا منهل الفضل يا من بر جودك لن","اظما وبحرك للعافين مورود",19,"د",1,0],["يا من هواه أعزه وأذلني","كيف السبيل إلى وصالك دلني",20,"ن",2,1],["يا مُنهِضي وَقَوادِمي مَحصوصَةٌ","بِقَوادِمٍ مِن جودِهِ وَخَوافِ",21,"ف",1,0],["يا مُنهِضي حَتّى لَطِرتُ مُحَلِّقاً","في عَصرِهِ بِجَناحَي المِنهاضِ",22,"ض",1,0],["يا مُنهِضي وَالدَهرُ قَد حَضَّ بِما","أَولاهُ مِن أَحداثِهِ عَواشِري",23,"ر",2,0],["يا مُنهِضَ الأَمَلِ المَهيضِ جَناحُهُ","بِقَوادِمٍ مِن جودِهِ وَعَواشِرِ",24,"ر",1,0],["يا من هُوَ البر التقى المنتقى","سر السرارة طيب من طيب",25,"ب",1,0],["يا من هوالمعروف بالمَعروف يا","غوثاه يا رباه يا مولاه",26,"ا",2,0],["يا مَن هُوَ العالمُ في دَهرِنا","يَحويهِ جِسمٌ واحِدٌ في مَكان",27,"ن",1,0],["يا مَن هُوَ مَخلوقٌ بَشَراً","وَنَرى مِنهُ خُلُقَ المَلَكِ",28,"ك",1,0],["يا مَن هَواهُم في فُؤادي مُقيمُ","وَحُسنَهُم في مَشهَدي مُستَقيمُ",29,"م",1,1],["يا من هواه وحبه ووداده","سكن السويدا من فؤادي الداخل",30,"ل",1,0],["يا من هواهم أقام","في مهجتي واستقر",31,"ر",1,1],["يا مَن هُم دَلّوا عَلى","مَعنى الغَرامِ قَلبي",32,"ي",1,1],["يا مَن هَدى مُوسى إِلى النار كَما","قَدَّرَ أَن يَلقى عَلى النار هُدى",33,"ا",1,0],["يا مَن هُوَ القَهّار مُردي مَن طَغى","نَظير عادٍ وَثَمودٍ وَسبا",33,"ا",1,0],["يا مَن هَواهُ شَفَني","أَنا مَن جَفاكَ عَلى شَفا",34,"ف",2,0],["يا مَن هَجاني عَامداً","ومحلّه عندي مكينُ",35,"ن",1,1],["يا من هَواهُ على التّنا","ئِي والتّدانِي في ازدْيادِ",36,"د",1,1],["يا من هو الشمس تأتينا أشعتها","ويقصر الطرف عن إدراك عنصرها",37,"ه",2,1],["يا من هو البدر لا تخفى اشعته","وكيف يخفى ضياء لاح في علم",38,"م",1,0],["يا من هو اللَه شيء لا يشابه","شيء بك الشيء معدوم وموجود",39,"د",1,0],["يا من هو اللَه شيء لا يشابهه","شيء يضاهيه في الكونين في القدم",40,"م",1,0],["يا مِنّةً للكرى لولا حلاوتُها","ما ذُمَّ وهو وفاءٌ في الهوى السهرُ",41,"ر",1,0],["يا مَن هُوَ الغُصنُ الرَطيبُ إِذا اِنثَنى","وَاِبنُ الغَزالَةِ وَالغِزالُ إِذا رَنا",42,"ن",2,1],["يا مَن هُوَ البَحرُ إِذا ما طَمّا","وَمَن هُوَ الغَيثُ إِذا اِنسَجَم",43,"م",1,0],["يا مَن هُوَ الأُمُّ لَنا وَ الأَبُ","وَمَن إِلى مَذهَبِهِ نَذهَبُ",44,"ب",1,1],["يا مَنْ هجا الصِّدِّيق والفاروقَا","كيما يقيمَ عند قومٍ سُوقا",45,"ق",2,0],["يا مِنّةً لذّ بها السُّكْرُ","لا ينقَضي منّي لها الشُّكْرُ",46,"ر",1,1],["يا منهلاً للسّوءِ ما ألقى له","في كلُ أحيافِ الورى من عائِفِ",47,"ف",1,0],["يَا مَنْ هُمُو لِلجْمِيل أهْلٌ","إِنْ لم يَمنُّوا فَيَا شَقائِي",48,"ا",3,0],["يا مَنهلاً قالَ بالتَّأريخِ ناهِلُهُ","مِن شيمةِ الحَسَنِ الإحسانُ والجودُ",49,"د",1,0],["يا من هواه بقلبي قد حجى ورسى","وليس لي غيره خلا أصاحبه",50,"ب",2,1],["يا من هواهُ غايةُ العاقِل","النَّدبِ وللأَشْياءِ غاياتُ",51,"ت",1,0],["يَا مَنْ هَجَرُوا طَرْفِي مُحِبُّوه كَرىً","باللَّه عَسَى الخَيالُ أَنْ يَطْرُقَهُ",52,"ه",1,0],["يا مَنْ هَجر المُحبَّ مِنْ غَيرِ سَببْ","وَاسْتبدلَ بِالوَصْلِ صُدوداً وغَضبْ",53,"ب",1,1],["يامن هجرت على هواهم عاذلي","أيحل في شرع الهوى أن أهجرا",54,"ر",2,0],["يا من هو السيف في يومي ندى وردى","يقرى ويفرى فيولى المن والعطبا",55,"ب",2,0],["يا من هو المرهوبُ والمُرتجى","اليكَ من خيفتِكَ المُلتجا",56,"ج",2,1],["يا مَن هجرتُ له الأَهلينَ والوطَنا","وصارَمَت مقلتي في حُبِّهِ الوَسَنا",57,"ن",2,1],["يا من هواه وهو الحبيب","لنا وحيث يكون كنا",58,"ن",2,0],["يا مَنْ هُوَ الصفوةُ من هاشمٍ","يعرفُها الأولُ والآخرُ",59,"ر",1,0],["يا من هَداه اللَّهُ لِلفَواضِل","وَخصَّه بالعلم وَالفَضائل",60,"ل",1,0],["يا منْ هرعتُمْ لاهِثينَ كالجَرَادْ","منتخِبينَ الوَهْمَ والذلَّ المُعَادْ",61,"د",1,1],["يا من هَمَتْ في الأرض من فيض فضله","سحائبُ أبدت عن وجوه المنافعِ",62,"ع",1,0],["يا منة من كنوز الله قد عظمت","لولاك موسى كليم الله من سلمت",63,"ت",1,0],["يا منهلاً عذب الورود وخير مَنْ","يُلجى إليه ونعم مولى يقصدُ",64,"د",1,0],["يا منهلاً عذب الورود على فوا","يض جوده تتزاحم الورّادُ",65,"د",1,0],["يَا مَنهَلَ الخَيرِ فِيْ شَتَّى رَوَافِدِهِ","أَقَمتَ صَرْحاً بِحُكمِ العَدْلِ تُعْلِيْهِ",66,"ي",2,0],["يا من هدى للخير عبدك جد له","بحماية من مسلك العصيان",67,"ن",1,0],["يا من هو المحبوب بشرني بخير","دائم واشفع لعبد خيرا",68,"ر",2,0],["يا من هو الرب الرؤف وذو المدد","يا واهب الإحسان في كل المدد",69,"د",1,0],["يا من هو الرحمن فارحمنا وعد","أنت الرحيم بنا مجيب سؤالي",70,"ل",2,0],["يا من هو الملك الرجا في بابكم","أنزلته قدوس فاصلح بالي",70,"ل",2,0],["يا من هو القهار فادرأ عننا","كيد العدو وخذه بالاهوال",70,"ل",1,0],["يا من هو الوهاب هبنا رحمة","رزاق يا فتاح فاصلح بالي",70,"ل",2,0],["يا من هو الحكم الطغاة تمردوا","يا من هو العدل إحمني بجلال",70,"ل",1,0],["يا من هو الصمد المرجىّ جوده","يا قادر وفق إلى اعمال",70,"ل",1,0],["يا من هو النور ارحمنّا بالهدى","يا هادي واحفظنا من الانكال",70,"ل",1,0],["يا مَن هُوَ البَحرُ لِلرّاجي مَكارِمُهُ","وَالبَحرُ رَحبٌ وَمَورودٌ لكُلِّ ظمي",71,"م",2,0],["يا من هواه بقلبي ليس يبرح من","بين الترائب ترب الشوق والأسفِ",72,"ف",1,1],["يا من هممت بعذلي فاترك العذلا","وبنت أحمد لا أَبغي بها بدلا",73,"ل",2,1],["يا مَن هواك مع الصَّبا","بةِ والكآبةِ فى جهادِى",74,"د",2,0],["يا من هممت بمثله","فجحدت من أكنى به",75,"ب",2,0],["يا من هو الرب القدي","ر وهادي قلب المنكسر",76,"ر",1,0],["يا مَنهَلاً ظَلَّ يُرويني وَيُعطِشُني","رُحماكَ رِفقاً بِراوٍ مِنكَ عَطشانِ",77,"ن",1,0],["يا منهلاً قد تمتَعَّنا بكَوثَرِهِ","حيناً روينا به لو دام ريُّ صَدى",78,"د",2,0],["يا منهلاً قد تمتَّعنا بكوثَرِهِ","إليكَ تشكُو اشتياقاً هاجَهُ السَّفَرُ",79,"ر",1,0],["يا من هَواه بِقَلبي","مقدارُه ما يُحدُّ",80,"د",1,1],["يا مَن هُوَ البَحرُ جَيّاشاً بِنائِلِهِ","وَغَيرُهُ المَنهلُ الضَحضاحُ وَالثَمَدُ",81,"د",1,0],["يَا مَن هُوَ الحَقُّ المُبينُ وَقَولُهُ","وَلِقَاؤهُ وَرَسُولُهُ بِبَيَانِ",82,"ن",1,0],["يا من هدى المسترشدين بنوره","نم هادئاً فعليك قلبي ما هدا",83,"د",2,0],["يا منهل الصادي الَّذي ما أَعطشت","مِن مُهجة الأَوكان رواءها",84,"ا",3,0],["يا من هجا في الزوايا حيّ ديمانا","ظلما وفي مغفر أبناء دامانا",85,"ن",2,1],["يا من هدمت البيت فوق صغاره","شكراً فأنت جعلتنا أحرارا",86,"ر",2,0],["يا من هو الليث لولا حسن صورته","ومن هو الغيث إلا أنه بشر",87,"ر",1,1],["يا مَنْ هو البحر جوداً والأَضا نسباً","جُدْلي بما شئت قد أدركت ما شيتا",88,"ت",2,0],["يا منهل العاطش الهيمان حلأه","عن عذب وردك بالأصدار إيراد",89,"د",1,0],["يا مَن هِلالي وَجهُهُ وَشَمسي","لا تُقتَلُ النَفسُ بِغَيرِ نَفسِ",90,"س",1,0],["يا من همُ للجميل أهلٌ","إن لم تمنّوا فيا شقائي",91,"ي",1,0],["يا منهلاً قد صفا فلا كدر","يصدّ عن ورده ولا حظر",92,"ر",1,0],["يا مَن هُمُ قَومي وَأَهلُ مَودَّتي","أَكرِم بِهِم وَبِدارِهِم مِن جارِ",93,"ر",1,0],["يا مَن هَواهُ بِقتل مُضناه حكم","رِفقاً فقتلُ الصَبِّ لا يُرضى حَكَم",94,"م",1,1],["يا مَن هَجَوناهُ فَغَنّانا","أَنتَ وَبَيتِ اللَهِ أَهجانا",95,"ن",2,1],["يامن هجرت فما تبالي","هل ترجع دولة الوصال",96,"ل",1,1],["يا من هو المراد والسلطان","ذلت له الملوك اين كانوا",97,"ن",3,1],["يا من هوى نجم السعود ببعده","عنّا وعقد الصبر منا قد وهى",98,"ه",2,1],["يا منة كنت مملوء اللايدين بها","فعاقني دونها صرف من القدر",99,"ر",1,0],["يا منهلاً طامياً ما فيه رجراج","ولم يكدره دلاجٌ وخراج",100,"ج",1,1],["يا مَن هَويتُ جَمالَه وَدَلالَه","ما لي إِلى السُلوان عَنكَ دَليل",101,"ل",1,0],["يا من هواني هَواهُ","وعزَّ عنهُ التسلّي",102,"ي",1,1],["يا مَن هَواه قاتلي وَأَنا بِهِ","أَلهو وَأَطربُ في الجُنون بكل فنْ",103,"ن",1,0],["يأمنهم من فاتهم طائعًا","أو ساقهم كرهًا مطيعينا",104,"ن",2,0],["يا من هو 