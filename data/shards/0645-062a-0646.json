2,"أطيافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212387",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5302,"محنة مسلمي الروهينغا","https://www.poetsgate.com/ViewPoem.aspx?id=201898",""],[5431,"مادمت أنت بناره متورّطا ....","https://www.poetsgate.com/ViewPoem.aspx?id=200964",""],[5431,"هي لم تعد لليوم تهواه!","https://www.poetsgate.com/ViewPoem.aspx?id=201336",""],[5431,"من حبقِ....منسرح","https://www.poetsgate.com/ViewPoem.aspx?id=206243",""],[5464,"قانا","https://www.poetsgate.com/ViewPoem.aspx?id=8311",""],[5528,"ضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201145",""],[5582,"هَلْ ما عَهِدْتُ مِنَ البَشاشَةِ عائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186883",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5764,"الشارع","https://www.poetsgate.com/ViewPoem.aspx?id=174220",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""],[5943,"هديل الخير","https://www.poetsgate.com/ViewPoem.aspx?id=53803",""],[5956,"البحر أصبح واحداً من أسرتي","https://www.poetsgate.com/ViewPoem.aspx?id=183259",""],[5956,"أجمل جنة في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184960",""],[5956,"إن جاء موتي سوف يرقص خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=192133",""],[5956,"أ تطيق بُعداً عن محبِّك خالدٍ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193347",""],[5956,"وتعاونوا على البِرِّ والتقوَى","https://www.poetsgate.com/ViewPoem.aspx?id=194825",""],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""],[5956,"يعفو لأنه مثلُنا متسامحُ","https://www.poetsgate.com/ViewPoem.aspx?id=213371",""],[5976,"طفلة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=34669",""],[6068,"رشيد تونس -18-","https://www.poetsgate.com/ViewPoem.aspx?id=177481",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[658,"لَوَّمتَهُ وَعَنَفتَ في تَعنيفِه","https://www.poetsgate.com/ViewPoem.aspx?id=45927",""],[6131,"الجذرُ..العتيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=189264",""],[422,"عادَ المتَّيم في غرامكَ داؤهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22253&r=&rc=9",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""]],"verses":[["مُتَناوِلاً طَرَفَ الفَخارِ يَجُرُّهُ","وَيَقودُ مُصعَبَهُ بِغَيرِ زِمامِ",0,"م",1,0],["مُتَنافِسينَ عَلى المُقامِ وَإِنَّما","خَلفَ الرَكائِبِ سائِقٌ مِلظاظُ",1,"ظ",1,0],["مُتَنَبِّيءٌ أَنَا فِي حُلاَ تلكَ الْعُلَى","لَكِنَّ شِعْري فِيكَ شِعْرُ حَبيبِ",2,"ب",1,0],["متناكرين لدى الخطوب تناكراً","يعيا لسان الشعر عن تمثيله",3,"ل",2,0],["متنوع الآلاء أغنى بالندى","وسطاً فكيف المعتفي والمعتدي",4,"د",2,0],["متنبهاً وكأنه","لفتور ذاك اللحظ نائم",5,"م",1,0],["مُتنسِّماً عن مثل نَشْ","رِكَ للضجيع إذا انتبهتا",6,"ت",2,0],["متنطِّق من جلده","متختِّم في خَصرِهِ",7,"ه",1,1],["مُتَنقِّلاُ بَيْنَ الخَمائلِ تالِياً","وَحْيَ الرَّبيعِ السَّاحرِ المَسْحورِ",8,"ر",1,0],["متنا كلانا كَغُصْنَيْ بانَةٍ ذَبُلا","مِنْ بَعْدِ ما اسْتَوْرَقَا واسْتَنْضَرا حِينا",9,"ن",2,0],["مُتَنَصِّتاً لِصَدى الصَريخِ إِلى الوَغى","لِيُجيبَ صَوتَ الصارِخِ المَسموعا",10,"ع",2,0],["مُتَناسونَ لِلذُنوبِ إِذا اِستُس","رِفَ تَفريطُ مَن يَزِلُّ وَيَهفو",11,"ف",2,0],["مُتَنَقِّلٌ مِن سُؤدَدٍ في سُؤدَدٍ","مِثلَ الهِلالِ جَرى إِلى اِستِكمالِهِ",12,"ل",2,0],["متنا جميعا لا يؤخر واحد","عن واحد لمرارة الثكل",13,"ل",1,0],["مُتَنَعِّماتٍ في النَعي","مِ مُضَمَّخاتٍ بِالعَبيرِ",14,"ر",1,0],["متنفساً لهباً يهبُّ على","وجهي كأنفاس البراكينِ",15,"ن",1,0],["متناوِلٌ قُمُحَ الكماة بأسمرٍ","لِدَمِ الأُسود سنانُه سَفّاحُ",16,"ح",1,0],["مُتَناوِمٌ إِن زارَها إِخوانُها","مُتَيَقِّظٌ إِن زارَها أَخَواتُها",17,"ت",3,0],["مُتنَخِّلٌ حَلّاكَ نَظمَ بَدائِعٍ","صارَت لِآذانِ المُلوكِ شُنوفا",18,"ف",2,0],["مُتَنَقِّلاً ذا مَلَّةٍ طَرِفاً","لا يَستَقيمُ لِواصِلٍ أَبَدا",19,"د",2,0],["مُتَنَفَّساً عَن مِثلِ نَفحَةِ مِسكَةٍ","مُتَبَسِّماً عَن مِثلِ سِمطَي جَوهَرِ",20,"ر",1,0],["مُتَنَسِّماً نَفَسَ القُبولِ وَرُبَّما","أَورى زِنادَ الشَوقِ أَن أَتَنَسَّما",21,"م",2,0],["مُتَناسِبٌ فىِ الفَضلِ مُكتَمِلٌ فَلا","نَقصُ الكَفيفِ وَلا اِختِلافُ الأَخيَفِ",22,"ف",1,0],["مُتَنَقِّلاً مِثْلَ البُدُورِ وسائراً","بِنَدَاكَ في الآفاقِ سَيْرَ غَمَامِ",23,"م",1,0],["مُتَناهي الرَيحانِ يَسجِدُ لِلشمَ","سِ مُبيناً وَما عَلَيهِ اِتِّئابُ",24,"ب",1,0],["مُتَنَصِّلٌ مِن غَيرِ ذَنبٍ فيهِمُ","وَأَخو ذُنوبٍ لَيسَ بِالمُتَنَصِّلِ",25,"ل",1,0],["متنقلات في فسي","حِ فَضائها عكساً وَطردا",26,"د",2,0],["متنبئاً بالغيبِ والقدَرِ","وعجيبةٌ تلك النبوءاتُ",27,"ت",1,0],["مُتَنَصِّبٌ كالغُصْنِ إِلا أَنَّهُ","يَهْتَزُّ مِن أَعْجازِه وصُدُورِه",28,"ر",2,0],["مُتَنَزَّهٌ عَالي الجَنَابِ وَقَلَّ مَنْ","جَمَعَ التَّنَزُّهَ وَالعُلُوَّ جَنَابَا",29,"ب",2,0],["مُتنقِّصُو مَحْسُودِهِمْ","وَلَهُ التَّجِلَّةُ وَالرُّجُوبُ",30,"ب",1,0],["مُتَنَكِّرٌ فِيهَا وَتَعْ","رِفُ فَضْلَهُ المُقَلٌ الشَّهِيدَهْ",31,"د",2,0],["مُتَنَزِّهاً عَما يُزَيِّفُ","شَانِيءٌ وَلِيَ انِتْقَادَكْ",32,"ك",1,0],["متنقِّلاتٍ بين أزهارِ الرُّبا","الجوُّ مَتْنٌ والنسيمُ زِمامُ",33,"م",1,0],["مُتَنَمِّراً كالَلَّيْث دِيسَ عَرِينُه","مُتَوثِّباً يَدْعُو الرِّجَالَ نَزَالِ",34,"ل",1,0],["متن تود الشمس لو عقدت له","تاجا وأن له النجوم قلائد",35,"د",1,0],["متنبىء أنا في حُلى تلك العُلا","لكنَّ شِعري فيك شِعرُ حَبيب",36,"ب",1,0],["مُتَنَاهي الرَّيْحَان يَسْجُدُ للشَّمْسِ","مس مبيناً وما عليه اتئابُ",37,"ب",1,0],["متنقلُ الأوفياء شْيَّعَ ركبَه","نَفسَي يُناطُ بسَيره ووُقوفه",38,"ف",2,0],["مُتَنمّرينَ يُنَصّبونَ صُدورهُمْ","مِثْلَ السّباعِ ضَراوةً وتَكالُباً",39,"ب",2,0],["متنادمين على السلافة أنشدوا","غرر النسيب ورتّلوا التنزيلا",40,"ل",2,0],["مُتَنَسِّكاً مُتَعَزِّزاً مُتَذَلِّلاً مُتَهَيِّباً","مُتَهَيِّباً مُتَخَوَّفاً مُتَخَوفاً",41,"ف",2,0],["مُتَنائِيَ الأَقطارِ زادَ قَتامُهُ","فَغَدا بِهِ وَجهُ النَهارِ مُلَثَّما",42,"م",2,0],["متناسبون فضائلاً وتواصلاً","متشابهون ضراغماً وشبولا",43,"ل",2,0],["متناسبون فواضلا وفضائلا","متشابهون ضراغما وشبولا",44,"ل",2,0],["متنازعان فلا يصدق واحد","منكم على ما قاله في الثاني",45,"ن",2,0],["متنقل طلب الغنى أطوي السرى","وأواصل الإدلاج والكدّا",46,"د",2,0],["متنكباً زوراء مثل هلاله","نصَّلتُ أسهمها بمثل الأنجم",47,"م",1,0],["مُتَنَصِّرٌ صبغ الهوى جسمي به","فأذابَ قلبي في الهوى تَذكارُهُ",48,"ر",2,1],["مُتَنَقِّلٌ بكَ وَالملائكُ حولَه","يَرعَونَ شَخصَك حُوَّماً وَنُزولا",49,"ل",2,0],["مَتْنٌ كِصْبغ الدجى نِيطت حوالِكُه","بِفضِّة صاغ منها النحر والجِيدا",50,"د",2,0],["مُتَنافِري الأَوصافِ يَصدُقُ فيهِمُ ال","هاجي وَتَكذُبُ فيهِمِ الآمالُ",51,"ل",1,0],["مُتَنَمِّرَ الأَخلاقِ كَال","لَيثِ الغَضوبِ إِذا تَنَمَّر",52,"ر",1,0],["مُتَنَزِّهَينِ عَنِ المَحارِمِ خيفَةً","لِسُطى أَميرِ المُؤمِنينَ الناصِرِ",53,"ر",1,0],["مُتَناصِرُ المَعروفِ ما أَسدى يَداً","في مَعشَرٍ إِلّا وَأَتبَعَها يَدا",54,"د",2,0],["متنا قليلاً","عندما مالَ الغبيطُ بنا",55,"ن",2,1],["مَتْنُ الجَوادِ النَّهد آثَرُ فُرْشِهِ","لا يُؤْثِرُ الخَوْدَ الكَعَابَ فَرِيشا",56,"ش",2,0],["متنظراً متوقعاً متوجيا","مترقباً للطائف الجبار",57,"ر",1,0],["متناسقي الحركات في أشخاصهم","روح كما قد قالت الحكماءُ",58,"ا",2,0],["مُتناسِبُ الحالَينِ منْ","هُ لربّهِ سِرٌّ وجَهر",59,"ر",1,0],["مُتناصِفُ الآدابِ يَمْشُقُ دائماً","لبياضِ قرطاسٍ سَوادَ كُبود",60,"د",1,0],["مُتَنَقّباتٌ بالسّواعدِ رِقْبةً","من كُلِّ سافرةٍ ولم تَتنقَّب",61,"ب",1,0],["مُتَناولاتٌ من بعيدٍ دِقّةً","والأرضُ خيرُ رياضِها للمغرب",61,"ب",1,0],["متنبّه في دينه ببصيرةٍ","قد قوّمته على طريق رشاده",62,"د",2,0],["متنبه للمكرمات ولم يكن","عنها ينام فيهتدي بتنبُّهِ",63,"ه",1,0],["متناهِياً في الزور من","قَولي وليتَ الزُورَ يُفهَم",64,"م",1,0],["مُتَنَكِراً خَوف الوُشاة وَما","واشيهِ غَير النَشر وَالثَغر",65,"ر",1,0],["مُتنَظِّمينَ جِوارَ نَضلَةَ يا","شاهَ الوجُوهُ لذلكَ النَّظمِ",66,"م",1,0],["مُتَنَمِّرٌ إن سيم ضيماً أدميت","منه البراثن واستشاط إباؤه",67,"ا",