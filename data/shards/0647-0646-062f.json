{"poems":[[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[93,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[99,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[71,"إن يوم الوصال يوم قصير","https://www.aldiwan.net/poem28913.html","الخفيف"],[33,"ذكر البلاط وكل ساكن قرية","https://www.aldiwan.net/poem41302.html","الكامل"],[33,"أراك يا هند في مباعدتي","https://www.aldiwan.net/poem42623.html","المنسرح"],[50,"أبصرت في بغداد روميه","https://www.aldiwan.net/poem66211.html","السريع"],[93,"لم أجد أحدا ...","https://www.poetsgate.com/ViewPoem.aspx?id=53029",""],[147,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[272,"جاءوا معاً فيلقاً جأواء مشعلة","https://www.aldiwan.net/poem1139.html",""],[295,"هند عذراء أسلمتها المقادير","https://www.aldiwan.net/poem11680.html","الخفيف"],[302,"وافتك والزهر في روض الدجى زهر","https://www.aldiwan.net/poem33266.html","البسيط"],[353,"شهدت دواة الفتح ساعة فتحها","https://www.aldiwan.net/poem20398.html","الكامل"],[382,"بئس الزمان المرتدي بشرار","https://www.aldiwan.net/poem59431.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66700","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109274","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137895",""],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141268","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28509","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105671","الرمل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137386",""],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10420","المنسرح"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132530","المنسرح"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77117","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136689",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141650","الكامل"],[4927,"أشواق الْعُشَّاْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=29719",""],[5186,"ربي قضاءك ما له رد","https://www.poetsgate.com/ViewPoem.aspx?id=156448",""],[5278,"يا زوجُ ، يومُكَ قد حَلَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=202550",""],[5351,"شيماء","https://www.poetsgate.com/ViewPoem.aspx?id=202239",""],[5411,"لا تَسْتَهِنْ بِعَواطِفي","https://www.poetsgate.com/ViewPoem.aspx?id=186124",""],[5431,"هند..وبلقيس المقعدة!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200068",""],[5747,"بين فرح وبين جرح","https://www.poetsgate.com/ViewPoem.aspx?id=61682",""],[5952,"نساء الشِعر","https://www.poetsgate.com/ViewPoem.aspx?id=196742",""],[5956,"محاولة تعبيرية لرد جميل الأم","https://www.poetsgate.com/ViewPoem.aspx?id=192089",""],[5974,"هَنْدَسَةُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=200330",""],[6102,"قاومي","https://www.poetsgate.com/ViewPoem.aspx?id=184633",""]],"verses":[["هَندسَه رأيك المبرِّز في ال","فضل وأعطته حقَّه النَّجَره",0,"ر",2,0],["هِند وَأَحسَبُني إِذا ذُكِرَت","أَطَءُ الأَفاعي أَو أَجُسُّ مُدى",1,"د",2,0],["هِندِيَّةٌ إِن تُصَغِّر مَعشَراً صَغُروا","بِحَدِّها أَو تُعَظِّم مَعشَراً عَظَموا",2,"م",3,0],["هُندِمَت كَفّاهُ مِن دونِ الَّذي","يُبتَغى هَندَمَةَ البابِ اِنصَفَق",3,"ق",1,0],["هند التي اتَّخذته من","دون الخلائق إلفَها",4,"ه",2,0],["هندُ لا تكشفي عنِ الصفحِ ستراً","لا ولا تفتحي إلى البحرِ بابا",5,"ب",2,0],["هِندٌ وَهِندٌ لا تَزالُ بَخيلَةً","وَالقَلبُ يُسعِرُهُ لَها أَشجانُه",6,"ن",2,0],["هِندُ أَطاعَت بِيَ الوُشاةَ فَقَد","أَمسَت تَراني كَعُرَّةِ الجَرِبِ",7,"ب",1,0],["هِندِيَّةُ الحاجِبِ نوبِيَّةُ ال","فَخذَينِ في زَهوِ عِبادِيَّه",8,"ي",2,0],["هند ، وأحسبني إذا ذكرت","أطأ الأفاعي ، أو أجسّ مدى",9,"د",2,0],["هِندِيَّةٌ كَم مَزَّقَت في مَأزِقٍ","ما كانَ أَحكَمَ سَردَهُ داوودُ",10,"د",1,0],["هِندُ إِنَّ الرَبيعَ في الحَقلِ بَسّا","مٌ وَعَرف الزهورِ يُنشَر نَشرا",11,"ر",2,0],["هِندُ يا هِندُ أَنشِدي ليَ أَيضاً","وَاِنظُري مَوكِبَ الدُجى كَيف مرّا",11,"ر",2,0],["هِندُ إِنّي عَطشان جُرعَةُ ماءٍ","فَشفاهي الصَفراءُ يا هِندُ حرّى",11,"ر",2,0],["هِندية كاشتعال البرق يعصمهم","بها مغاوير عن أحسابهم غِيرُ",12,"ر",1,0],["هندُ عذراءُ أسلمتها المقادير","لذئبٍ يروغ خبثاً ومكرا",13,"ر",2,1],["هنديَّةٌ فعلت منها اللِحاظُ بنا","ما لَيسَ تفعلهُ الهنديَّةُ البُتُرُ",14,"ر",1,0],["هِنْدِيَّةٌ عَبِقَتْ لنا أَنفاسُها","وَجَرَى لها ذِكْرهُ مَعَ الأَنفاسِ",15,"س",1,0],["هنديةٌ في خَلقها زنجيةٌ","في ذوقها عربيةٌ في الثار",16,"ر",1,0],["هندُ من أين تخطّيتِ إلى","ركبِ أطلاحِ مطيٍّ قد حَسرْ",17,"ر",1,0],["هند يكفي إنما أولادنا","أكبادنا وأنا إِلى الخمسين",18,"ن",1,0],["هند تبيض وجهها زورا وذا","زيد يخضب شبيه تسويدا",19,"د",2,1],["هند انثني عن عزمك الواهي وعي","ما قلت وانصرفي إلى أولادي",20,"د",2,0],["هِنْدِيّةٌ لم يزلْ بالهندِ مغتربٌ","يَدْعُو بها كلمّا شَبّتْ وَيَبْتَهِلُ",21,"ل",1,0],["هِندِيَّةٌ وَبَنو حَمدانَ رُفقَتُها","لَقَد تَخَيَّرَتِ الأَحسابُ وَالزُّبُرُ",22,"ر",1,0],["هِندامُهَا للتِّير والإِكليل","والنَّهجُ ما بينهما لَدَى الدليل",23,"ل",1,0],["هند والحب الذي يجمعنا","بالصبا ما خثت فيه النوايا",24,"ا",3,0],["هندي لحظيه أضنى مهجتي وسطا","على فؤاد وحق الله يهواه",25,"ا",2,0],["هِندٌ تَجَنّى الذُنوبَ عاتِبَةً","يا حَبَّ بِالعاتِبِ الَّذي عَتَبا",26,"ب",2,0],["هندية لم تزل لواحظه","وقد نمته الغطارف العرب",27,"ب",1,0],["هنداً إلى خليلها هِدَاءً","فافهم وأهديت له إهداء",28,"ا",2,0],["هِنداً عمانا وَالحِجازُ وَنَجِدُهُم","يُمناً وَشاماً وَالعِراقُ وَتَسَتُّرا",29,"ر",2,0],["هنديةُ الألحاظ ما","لجريحها أبداً دواء",30,"ا",2,0],["هنَّدتني يا ذات كل ملاحة","وتركت قلبي بالغرام يعلل",31,"ل",1,1],["هِنْدِيَّةُ اللَّوْنِ الْمُشَرَّبِ حُمْرَةً!","مَاْلِيْ سِوَاْهَاْ لِلْهَوَىْ مِنْ رَاْقِ",32,"ق",1,0],["هند انهضي فورا لخدمته","واستقبلي العواد يا دعد",33,"د",1,0],["هِندٌ تقولُ لِزَوجهَا","إنِّي سأتركُ مَنزِلَكْ",34,"ك",1,1],["هندستُ فيكِ الشعر يا شيماء منْ","قلبي وصغت الحرف منْ فحواك ِ",35,"ك",1,0],["هَنْدِمْ قَميصَكَ وَاخْتَلِقْ","عُذْرًا لِتُصْلِح ما انْكَسَرْ",36,"ر",1,0],["هندٌ تموتُ وكلّهم هندٌ","لم ينتهِ التقطيعُ والحقدُ",37,"د",1,0],["هندس الحرف وتميّز يوم ضم الإكتشاف","مركز الإبداع يعمل من مصادر محكمه",38,"م",2,0],["هند التى هَنَّدَتْ قلبى وما لبثت","تستل أسيافَها هجْراً وتذبحني",39,"ن",2,0],["هند وبَدْءُ اسم* القرينة في غدٍ","والنسل منك لكي يكون جميلا",40,"ل",2,0],["هندِسْ حياتك بالتَّبَسُمِ إنَّما","تَرْقى الحياة ببسمة نحو السما",41,"م",2,1],["\" هِندُ \" , مَا سُقتِ فِي غَرَامِيَ إِلَّا","- فِي غُرُورٍ - حِجَارَةً وَ حَدِيدا",42,"د",2,0]]}