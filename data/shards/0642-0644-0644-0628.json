{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[55,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[74,"وسواس حلا لا كوسواس","https://www.aldiwan.net/poem19020.html","السريع"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[18,"جارت بنو بكر ولم يعدلوا","https://www.aldiwan.net/poem23941.html","السريع"],[71,"قل لبني الناس على زعمهم","https://www.aldiwan.net/poem28736.html","السريع"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[50,"قل لبني الأشعث لن تصلحوا","https://www.aldiwan.net/poem64334.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142058","الرمل"],[41,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[234,"جلت مساعي عن الفخر","https://www.aldiwan.net/poem51081.html","السريع"],[242,"قل لبينك يا حبيبي ينجلي","https://www.aldiwan.net/poem18864.html","عموديه"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[469,"ذاك سلع فاندب معي أطلاله","https://www.aldiwan.net/poem3614.html","عموديه"],[473,"قل لبني الملح ما محسنكم","https://www.aldiwan.net/poem60366.html","الخفيف"],[556,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[556,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143232","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34779","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119991","السريع"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202082","السريع"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76675","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69434","السريع"],[2841,"","https://poetry.dctabudhabi.ae/diwan/poem/133895","السريع"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138013",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132572","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87368","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138530",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138529",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117905","السريع"],[4045,"","https://poetry.dctabudhabi.ae/diwan/poem/34753","الخفيف"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[3581,"غيرة الله كيف تستطيع صبراً","https://www.poetsgate.com/ViewPoem.aspx?id=158507",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[463,"بكرتْ هيماً تحلُّ الرَّبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60115&r=&rc=171",""]],"verses":[["قُل لِبُهامٍ نُشِرَت في الرُبى","هَذا قِوامُ الدينِ فَاِستَجمِعي",0,"ع",2,0],["قُل لِبَهاءِ المُلكِ إِن جِئتَهُ","سَوَّدَ دَهري بِكَ ما بَيَّضا",1,"ض",2,0],["قل لبني الدنيا ألا هكذا","فليصنع الناس مع الناس",2,"س",1,0],["قُل لِبانٍ بَنى فَشادَ فَغالى","لَم يَجُز مِصرَ في الزَمانِ بِناءُ",3,"ا",2,0],["قُل لِبَني ذُهلٍ يَرُدَّنَهُ","أَو يَصبِروا لِلصَّيلَمِ الخَنفَقيق",4,"ق",1,0],["قلْ لبني الناسِ على زعمِهِمْ","بأنهمْ أصلَحُ بالملْكِ",5,"ك",1,1],["قُل لِباكي الأَموتِ لا يَبكِ لِلنا","سِ وَلا يَستَنِع بِهِ فَنَدُه",6,"د",2,0],["قُل لِبَني الأَشعَثِ لَن تُصلِحوا","بِاللَومِ عِندي أَمرَ عَبّاسِ",7,"س",1,1],["قل لبغداد قد هُضمت فنوحي","إنما أَنت في أسار الطغاة",8,"ه",1,0],["قُل لبغداد متى عدتَ","إلى بغداد إنا",9,"ن",2,0],["قُلْ لِباكي الأَمْواتِ: لا يَبْكِ للنَّا","سِ، ولا يستنعْ بهِ فندُهْ",10,"د",2,0],["قُلْ لِبَنِي ذُهْلٍ يَرُدُّونَهْ","أوْ يصبروا للصيلمِ الخنفقيقْ",11,"ق",1,0],["قل لبني اللَّخناء ذي آيةٌ","واضحةُ الإسرار والجهر",12,"ر",1,0],["قُلْ لِبَيْنِكَ يَا حَبِيبِيَ يَنْجَلِي","وَلِوَصْلِكَ يَامُنَايَ يَرِقُّ لِي",13,"ي",1,1],["قُل لِبَني الآمال هَبوا فَقَد","هَبَّت بِكُم بابن عَلي رِياح",14,"ح",1,0],["قل لبيضاءَ توسّعتْ بها","قد تلثَّمتُكِ صِلّاً أرقطا",15,"ط",2,0],["قل لباغي السلوّ وهو فقيدٌ","عن غصونٍ إلى القلى ميَّاله",16,"ل",2,0],["قُل لِبَني المِلحِ ما مُحَسِّنُكُم","أَوَّلُ مَن أُهمِلَت سَفالَتُهُ",17,"ه",1,1],["قلْ لبني حربٍ ومَنْ جمّعوا","من جائرٍ عن رُشدِهِ أوْ عمِ",18,"م",1,0],["قلْ لبني الحارث خلّوا نَعَمي","فلستُمُ ممّنْ يَشُلّ النّعَما",19,"م",2,0],["قُل لِبَني حَربٍ وكم قولةٍ","سطّرها في القوم من سطّرا",20,"ر",2,0],["قل لباغي ربحٍ","بمدحٍ إذا ظل يمدحُ",21,"ح",1,0],["قل لبغا كنجروذ أبي سع","د ومن قد تناجلته بغايا",22,"ا",3,1],["قل لبغاة الآداب ما صنعت","منها إليكم فلا تضيعوها",23,"و",3,1],["قل لبهاء الدين خدنِ العلى","وقاتل المحلِ ومحيي الأدب",24,"ب",1,1],["قل لبني العبَّاِس أَصْبَحْتم","مالكم في الأَرضِ مِنْ ناِصر",25,"ر",1,0],["قل لبرق الغمام ظاهر بريدي","قاصداً بالسلام قصر الرشيد",26,"د",1,1],["قُل لِبَني الدُنيا أَلا هَكَذا","فَليَفعَلِ الناسُ مَعَ الناسِ",27,"س",1,0],["قل لبني الحيريّ مخصوصة","تظهرُ منهم بعض ما يكتمون",28,"ن",1,0],["قل لبو طالب الوادي من البطل ملعوب","والفتن كيرها في غالب القطر مشبوب",29,"ب",1,1],["قل لباغ احصاء غرّ مساعيه","اتحصى النجوم بالتعداد",30,"د",1,0],["قل لِبَيروتَ في التَهاني رُوَيداً","انَّ للدَهرِ مبدأ ومَعادا",31,"د",2,0],["\"قل لبيت الأ؛زان ما زال حزني\"","لا ولا عيشي الهني يطيب",32,"ب",1,0],["قل لبيت الأحزان بعدك حزني","مستمر على مرور الدهور",33,"ر",1,0],["قل لبني الآداب والفهم ما","مدينة في قطرها قاعده",34,"د",2,1],["قُل لِبَيضاءَ بَضَّةٍ ذاتِ أَعطا","فٍ وَساقٍ لَفّاءَ كَالجُمّارَه",35,"ر",2,1],["قل لباغي الندى خف الله لا تس","أله عمراً فإنه موهوب",36,"ب",1,0],["قل لبيت الأحزان ما زال حزني","لا ولا عيشي الهني يطيب",37,"ب",1,0],["قُل لِبَدرِ الدُّجى سَميرِ اللَّيالي","يا حَبيبَ النُّجومِ وَالحُبُّ جيرَه",38,"ر",2,0],["قلْ لبيضاءَ توسَّعتُ بها","قدْ تلثَّمنكِ صلاًّ أرقطا",39,"ط",2,0]]}