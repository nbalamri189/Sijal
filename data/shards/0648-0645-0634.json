","https://www.aldiwan.net/poem47387.html","الكامل"],[551,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[551,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[558,"فؤادي قد أضر به الغرام","https://www.aldiwan.net/poem34183.html","الوافر"],[558,"صفا ماء الحقيقة فهو صافي","https://www.aldiwan.net/poem34351.html","الوافر"],[558,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[558,"شخصت لطلعة وجهك الأشخاص","https://www.aldiwan.net/poem34426.html","الكامل"],[558,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[558,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[575,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["وَمُشرِفٍ كَسَنامِ العودِ مُلتَبِسٍ","كَالماءِ لُزَّ بِأَضلاعٍ مِنَ السُفُنِ",0,"ن",1,0],["وَمُشَمِّرِ العِرنَينِ خَرَّ جَبينُهُ","لَكَ غَيرَ مَقبولٍ وَلا مُستَقبَلِ",1,"ل",1,0],["وَمَشَت فيهِ بِالنَسيمِ عَليلاً","قِطَعُ المُزنِ في الرِياضِ المَرضى",2,"ض",2,0],["وَمَشهَدٍ مِثلِ حَدِّ السَيفِ مُنصَلِتٍ","تَزِلُّ عَن غَربِهِ الأَلبابُ وَالفِكَرُ",3,"ر",1,0],["وَمُشرِفَةُ القَذالِ تَمُرُّ رَهواً","كَما عَسَلَت عَلى القاعِ الذِئابُ",4,"ب",1,0],["وَمُشرَعَةِ الأَسِنَّةِ ذاتِ جَرسٍ","يَقودُ عُقابُ رايَتِها العُقابا",5,"ب",2,0],["وَمَشى على كَسَلٍ فَقُلتُ لَهُ","عَثَرَتْ بِكَ الوَخَّادَةُ الرُّتُكُ",6,"ك",1,0],["وَمَشْبوحِ الأَشاجِعِ ناشِريٍّ","لَهُ في خِنْدِفَ الشَّرَفُ الرَّفيعُ",7,"ع",1,1],["وَمُشْتَمِلٍ على كَرَمٍ وَحَزْمٍ","شَباةُ يَراعِهِ ظُبَةُ الحُسامِ",8,"م",1,1],["وَمُشْبِلَةٍ شَمْطاءَ تَبْكي مِنَ النَّوَى","وقَد غَيَّبَتْ عَنْ غَابِها أَسَداً وَرْدا",9,"د",2,1],["ومَشارِبي زُرْقُ الجِمامِ فلَمْ يَنَلْ","منّي الأُوامُ بمَنهَلٍ مَورودِ",10,"د",1,0],["ومَشى بأجْرَعِهِ فهَبَّ عَرارُهُ","منْ نَومِهِ وتَناجَتِ الأغْصانُ",11,"ن",1,0],["وَمِشَكِّ سابِغَةٍ هَتَكتُ فُروجَه","بِالسَيفِ عَن حامي الحَقيقَةِ مُعلِمِ",12,"م",1,0],["ومُشْتَغِلٍ بالحَزْمِ يَقْدَحُ زَنْدُهُ","إذا اشْتَغَلَ الأمْلاكُ باللّهْوِ والدَّدِ",13,"د",1,0],["وَمَشى القَومُ بِالعِمادِ إِلى الرَز","حى وَأَعيا المُسيمُ أَينَ المَساقُ",14,"ق",1,0],["وَمَشى في مَوكِبِ الدَفنِ لَهُم","مِن بَنيكُم كُلُّ مِسماحٍ أَغَر",15,"ر",1,0],["وَمَشى يَحمِلُ اللِواءَ إِلى الحَ","قِ وَيَتلو في الناسِ ذاكَ الكِتابا",16,"ب",2,0],["وَمَشى بَنوكِ كَما اِشتَهَيتِ إِلى العُلا","وَعَلى الوَلاءِ كَما عَلِمتِ أَقاموا",17,"م",3,0],["وَمَشى الهَمُّ ثاقِباً في فُؤادي","وَمَشى الحُزنُ ناخِراً في عِظامي",18,"م",2,0],["وَمَشى الصَغيرُ إِلى الكَبيرِ مُسائِلاً","يَتَسَقَّطُ الأَخبارَ أَو يَتَنَسَّمُ",19,"م",1,0],["وَمِشرَطاً جُمِّعَ مِن رَحمَةٍ","وَصيغَ مِن يُمنٍ وَمِن رِفقِ",20,"ق",1,0],["وَمُشَمَّرٌ في اللَهِ يَسحَبُ لِلتُّقى","وَالدينِ سِربالَ العَفافِ المُسبَلِ",21,"ل",1,0],["وَمَشدودَةَ السَكِّ مَوضونَةٍ","تَضاءَلُ في الطَيِّ كَالمِبرَدِ",22,"د",1,0],["ومشت تشيع قطعة من قلبها","في النعش إذ تمشي بعيد القادر",23,"ر",1,0],["وَمَشَوْا إلى زُعَمَاء مِصْرَ كَمَا مَشَى","أَقْرَانُ مَمْلَكَةٍ إلىَ أقْرَانِ",24,"ن",1,0],["وَمُشَفِّعٌ بِمَكَارِمِ الأَخْ","لاَقِ تَقْصِيرَ العَلِيلِ",25,"ل",1,0],["وَمُشَجَّجٍ أَمّا سَواءُ قُذالِهِ","فَبدا وَغُيِّبَ سارَهُ المَعزاءُ",26,"ا",2,1],["ومشتملٍ بالحسن أحوى مهفهف","قضى رجع طرفي من محاسنه الوطرْ",27,"ر",1,1],["ومشت فخفّ بها الصبا فتمايلت","مرحاً فأجهد خصرها الردفان",28,"ن",1,0],["وَمُشعِلَةً رَهواً كَأَنَّ جِيادَها","حَمامٌ تُباري بِالعَشِيِّ سَوافِلا",29,"ل",2,0],["وَمشْعر جَمْع والمغاض عشيةً","إذا حال دون الشمس قصراً مغيبها",30,"ب",3,0],["ومشجَّجاً ترك الولائد رأسه","مثل السواك ودمنةً كالمُهرق",31,"ق",1,0],["ومشى في الورى على نهج حقٍّ","مستبين الهدى وساد وأسدى",32,"د",2,0],["ومشمش بستان ثريَّاه أشرقت","وأين الثريَّا من يد المتناول",33,"ل",1,0],["ومشت في حمى الضلال إلى","الكعبة مشي الطريدة البلهاء",34,"ا",2,0],["ومُشفقٍ جاءهُ على وَجَلٍ","يستاقُهُ نحو عزِّهِ رَهَبُهْ",35,"ب",2,0],["ومُشَهّريهم في الأنا","م بظلم آملِهم وبخسه",36,"س",2,0],["ومَشْجَى حلوقٍ لا تسيغك بغضةً","ومَدْوَى صُدورٍ كامناتِ السخائمِ",37,"م",1,0],["وَمَشى إِلى المَظلومِ بارِقُ رَحمَةٍ","وَهَوى عَلى الظَلامِ سَوطَ بَلاءِ",38,"ا",2,0],["وَمَشَت تَحِفُّ بِها الغُصونُ كَأَنَّها","مَلِكٌ تَحِفُّ بِهِ الجُنودُ إِذا مَشى",39,"ا",1,0],["وَمَشَت بَعدَها عَلى الأَغصانِ","دودَةٌ فَالغُصونُ جُردُ",40,"د",1,0],["وَمُشَيَّدٍ لِلناسِ إِذ يَغشونَهُ","مِن كُلِّ أَرضٍ خِشيَةَ العُبّادِ",41,"د",1,0],["وَمَشَت ريحُ الصَبا حائِرَةً","في المَغاني حَيرَةَ الصَبِّ العَميد",42,"د",1,0],["وَمَشيُهُنَّ اِرتِباكٌ","وَتارَةً تَقديرُ",43,"ر",1,0],["وَمَشى المَشيبُ بِرَأسِهِ فَإِذا بِهِ","كَالحَقلِ فيهِ الزَهر وَالأَثمارُ",44,"ر",1,0],["وَمَشى الرَدى في مُهجَتي","اللَهَ مِن جَهلِ الخَبيرِ",45,"ر",1,0],["وَمَشى الدَهرُ إِلَيها طائِعاً","فَمَشَت تائِهَةً مُفتَخِرَه",46,"ر",2,0],["وَمَشَيتُ في الدُنيا بقَلبٍ يابِسٍ","حَتّى لَقيتُ أَحِبَّتي فَاِخضَوضَرا",47,"ر",2,0],["وَمَشى الخَيالُ عَلى الحَياةِ بِسِحرِهِ","فَإِذا الهَوى في الماءِ وَالأَنسامِ",48,"م",1,0],["وَمُشَيِّدٍ وَقَفَ الزَمانُ حَيالَهُ","مُتَخَيِّراً بِجَمالِهِ الفَتّانِ",49,"ن",1,0],["وَمَشَت عَلى الجيشِ الكَثيفِ فَلا","خَيلٌ مُسَوَّمَةٌ وَلا زُردُ",50,"د",1,0],["وَمَشى بِها في رَوضَةٍ","قَد نامَ عَنها حارِساها",51,"ا",3,0],["وَمَشَت تُطَوِّفُ في البِلادِ هِباتُهُ","تَغشى حَواضِرَها وَتَغشى البادِيَه",52,"ي",2,0],["وَمَشَوا عَلى هامِ النُجومِ فَلَم تَزَل","في اللَيلِ مِن وَجَلٍ تُحَدِّقُ ساهِيَه",52,"ي",2,0],["وَمُشَبَّهٌُ بِالغُصنِ قَل","بي لا يَزالُ عَلَيهِ طائِر",53,"ر",1,0],["ومَشَاعِراً حَسْرى يسيرُ بها","القُنُوطُ إلى الجُنونْ",54,"ن",1,0],["ومشيتُ تَحْتَ ظِلالهِ متَهَيِّباً","كالطِّفلِ في صَمْتٍ وفي استسلامِ",55,"م",1,0],["ومشاعري في يقظة مسحورة","وَسْنَى كيقظةِ آدَمٍ لمَّا سَرَى",55,"ر",2,0],["ومشاهدَ الوديانِ والآجامِ","فكأَنَّها شُعَبُ الجَحيمِ رهيبةً",55,"ه",1,0],["ومشى النَّاسُ خلفَهَا يتَمَلَّوْنَ","جمالَ الوُجُودِ في مرآها",56,"ه",2,0],["ومَشَى النَّاسُ في الشِّعابِ وفي الغابِ","وفوقَ المسالكِ المجهولهْ",56,"ه",1,0],["وَمَشيٌ كَما جاءَت تَهادى غَمامَة","وَلَفظٌ كَما اِنحَلَّ النِظامُ عَنِ الدُرّ",57,"ر",1,0],["ومشى يشيع نعشه متلهفا","من كل حزب امة اجناس",58,"س",1,0],["ومشت فهزت عند ذلك قامة","تزرى بأملود الرماح الشُرَّع",59,"ع",1,0],["ومشى إليكِ يتوب عن هفواته","عبدا فردّيه بعفوك سيدا",60,"د",2,0],["ومشى يقلَّب في المعسكر عينه","فيرى الصفوف ولا يحس إماما",61,"م",2,0],["ومشى على المتحطمين بصخرها","من جدّ يجمع باليدين حطامها",62,"م",3,0],["ومشى كسائر قومه","في بردتيه تعصبه",63,"ب",2,0],["ومشينا في مناقبه","فسبقنا كل مفتخر",64,"ر",1,0],["ومشوا بأقدام حوا","ف مرهفات كالحوافر",65,"ر",1,0],["وَمَشَت فيهِما النُجومُ فَكانَت","في حَواشِيهِما يَواقيتَ زُهرا",66,"ر",2,0],["وَمَشى جَلالُ المَوتِ وَهوَ حَقيقَةٌ","وَجَلالُكَ المَصدوقُ يَلتَقِيانِ",67,"ن",1,0],["وَمَشى المَجنونُ فيها سالِياً","نَفَضَ اللَوعَةَ عَنهُ وَالوَصَب",68,"ب",1,0],["وَمَشَت إِلى الخَيلِ الدَوارِعِ وَاِنبَرَت","لِلظافِرِ الشاكي بِغَيرِ سِلاحِ",69,"ح",1,0],["وَمَشى المُلوكُ مُصَفَّدينَ خُدودُهُم","نَعلٌ لِفِرعَونَ العَظيمِ وَنُمرُقُ",70,"ق",1,0],["وَمَشَت بِموسى في الظَلامِ مُشَرَّداً","وَحَدَتهُ في قُلَلِ الجِبالِ اللُمَّعِ",71,"ع",1,0],["وَمَشَت مِشيَتَها لَم تَرتَكِب","غَيرَ رِجلَيها وَلَم تَحجِل غُرابا",72,"ب",2,0],["وَمَشى الزَمانُ إِلى سَريرِكَ تائِباً","خَجِلاً عَلَيهِ الذُلُّ وَالإِرغامِ",73,"م",1,0],["وَمَشى عَلى يَبَسِ المَشارِقِ نورُهُ","وَأَضاءَ أَبيَضَ لُجِّها وَالأَحمَرا",74,"ر",2,0],["وَمَشى إِلى الحَلَقاتِ فَاِنفَجَرَت لَهُ","حَلقاً كَهالاتِ السَماءِ مُنَوِّرا",74,"ر",2,0],["ومشمِّرِ الأصداغِ يُهدي ريقَهُ","من خمرِهِ سُكراً إِلى أجفانِهِ",75,"ه",1,1],["وَمَشَت فيهِمُ الرِماحُ وَخيداً","وَوَجيفَن مِن بَعدِ ذاكَ الوَجيفِ",76,"ف",1,0],["وَمَشَيتَ مِشيَةَ خاشِعٍ مُتَواضِعٍ","لِلَّهِ لا يُزهى وَلا يَتَكَبَّرُ",77,"ر",1,0],["وَمُشرِقَةٍ في النَظمِ غَرّاً يَزيدُها","بَهاءً وَحُسناً أَنَّها لَكَ تُنظَمُ",78,"م",1,0],["وَمُشفِقَةٍ تَخشى الحِمامَ عَلى اِبنِها","لِأَوَّلِ هَيجاءٍ تَلاقى جُموعوها",79,"ه",2,0],["وَمَشمولَةٍ ساوَرتُ آخِرَ لَيلَةٍ","زُجاجَتَها وَالصُبحُ لَم يَتَنَفَّسِ",80,"س",1,1],["ومشيت مثل الطفل خلف دليلتي","وورائي التاريخ كوم رماد",81,"د",1,0],["ومَشهَدٍ ما جَرى ماءُ الحديدِ به","إلاّ غَدَا البَرُّ بَحراً ثَمَّ مُلتَطِما",82,"م",2,0],["ومُشهَّرٍ يُدعى الكَريمَ تَركتَه","يُدْعَى وقد هَطَلَتْ يَداكَ لَئيما",83,"م",2,0],["ومَشمولَةً شَجَّ السُّقاةُ كُؤوسَها","فأَشرقَ وَجْهُ الصُّبحِ واللَّيلُ عاكِفُ",84,"ف",1,0],["ومُشَتِّتٌ شَمْلَ اللُّهى بأناملٍ","جمَعَتْ له شَمْلَ العُلى فتألّفا",85,"ف",2,0],["ومُشرِفَةٍ لقاصدِها صُبُوبٌ","على قِمَمِ السَّحائبِ أو صُعودُ",86,"د",1,0],["ومُشتمِلٍ بنِجادِ الحُسامِ","يَفُلُّ شبا الحربِ بأساً مَهيبا",87,"ب",2,0],["ومُشرِفَةِ الأفعالِ لم يَحوِ مثَلها","إذا عُدِّدَ النِّسوانُ شرقٌ ولا غَربُ",88,"ب",1,0],["ومُشمِّراً قد شلَّ من إدلاجِه","ليلُ التمامِ وملَّ من إسرائِه",89,"ا",3,0],["ومشرق الوجه بماء الحيا","حيا بوجه كله أعين",90,"ن",1,1],["ومشَى إلى تكريمِكَ الوطنُ الذي","لولا التقَى صليتَ في محرابِهِ",91,"ب",2,0],["ومشت يميني في غزيرٍ حالكٍ","مسترسلٍ كالجدولِ المنسابِ",92,"ب",1,0],["ومشينا في طريق مقمر","تثب الفرحة فيه قبلنا",93,"ن",2,0],["ومشى الشتاء لها فغيّرها","وأحالها لفظاً بلا معنى",94,"ن",2,0],["ومشى مع الأمل الذهول كأنما","طارت بلبي الحادثات شعاعا",95,"ع",2,0],["ومشى الحسن في ركابك والإح","سان طراً والغرة السمحاء",96,"ا",2,0],["ومشمولةٍ راحٍ كأنّ حبابها","إذا ما بدا في الكأسِ درٌّ مَجوَّفُ",97,"ف",1,1],["وَمَشَوْا مع التّأييدِ قاماتٍ إلى","هيجاءَ مَشْيُ حُماتِها أشبارُ",98,"ر",1,0],["وَمَشَت تَرَنّحُ كَالنَّزيفِ وَمَشيها","فَضَحَ القطاةَ بِحُسنِهِ والجُؤذَرَا",99,"ر",2,0],["ومَشمولَةٍ في كَأسِها اشتَمَلَت على","نُجومِ سُرورٍ بَينَ شُرّابها تسري",100,"ر",2,0],["ومشبهَةٍ في الجَوِّ أنوارَ أختها","يضيءُ سَنَاها كلَّ أسحمَ داج",101,"ج",1,1],["ومشرعةٍ بالموتِ للطّعنِ صَعْدَةً","فلا قِرْنَ إنْ نادَتْهُ يوماً يُجيبها",102,"ب",3,1],["ومشحونةٍ بالخوف لا أمنَ عندها","كأنّك فيها حيثُ سِرْتَ مُريبُ",103,"ب",1,0],["ومشرقٍ كيمياءُ الشمسِ في يدهِ","ففضةُ الماءِ من إلقائها ذهبُ",104,"ب",1,0],["وَمُشَجَّجٍ بِالمِسكِ في وَجَناتِهِ","حَسَنِ الشَمائِلِ ساحِرِ الأَلفاظِ",105,"ظ",1,1],["وَمَشى إِلى المَوتِ الزُؤامِ كَأَنَّما","هُوَ في مَحَبَّتِهِ إِلَيهِ خَليلُ",106,"ل",1,0],["وَمَشهَدٍ بَينَ حُكمِ الذُلِّ مُنقَطِعٌ","صاليهِ أَو بِحِبالِ المَوتِ مُتَّصِلُ",107,"ل",1,0],["وَمُشَيِّعوهُ مُعَوِّذوهُ بِكُلِّ ما","عَرَفوهُ مِن عُوَذٍ مِنَ التَحميدِ",108,"د",1,0],["وَمَشَوا أَمامَ أَبي يَزيدَ وَخَلفَهُ","مَشياً يَهُدُّ الراسِياتِ وَئيدا",109,"د",2,0],["ومشت لوادي(عبقر ٍ) فتكفَّلت","بعذاب كل مدوّخ ٍ قهار",110,"ر",1,0],["وَمَشى الرَسولُ بِحاجَةٍ مَكتومَةٍ","لَولا مَلاحَةُ بَعضِها لَم تُكتَمِ",111,"م",1,0],["وَمُشاحِنٍ ذي بِغضَةٍ وَقَرابَةٍ","يُزجي لِأَقرَبِهِ عَقارِبَ لُسَّعا",112,"ع",2,1],["وَمَشى ثَلاثٍ بِهِ موهِناً","خَرَجنَ إِلى عاشِقٍ زُوَّرا",113,"ر",2,0],["وَمَشى يَتيهُ بِها اِختِيالاً أَجرَدٌ","في شُقرَةٍ لَو سالَ سالَ نُضارا",114,"ر",2,0],["وَمُشرِفِ الهادي طَويلِ السُرى","ضافي سَبيبِ الذَيلِ وَالعُرفِ",115,"ف",1,1],["ومَشَى يُحدِّثُ هَالكاً عن هالكٍ","فيها ويسألُ مَصرعاً عن مصرعِ",116,"ع",1,0],["وَمُشتجِراتٌ في الصُدورِ نَوافذٌ","تَودُّ تُقىً لَو أَنَّها تَتَحطَّمُ",117,"م",1,0],["وَمَشَتْ تُخْبِرُ الرسولَ وترجو","عِندَهُ الخيرَ والفُؤادُ كميدُ",118,"د",1,0],["ومَشى على الأثرِ الكريمِ يَزِينُه","خُلُقُ الهُداةِ ومَظهرُ الحُنَفاءِ",119,"ا",2,0],["وَمَشَوْا فما بَلَغَ الرسولَ حَدِيثُهُم","حتّى بدا متهلّلاً بَسّاما",120,"م",2,0],["ومَشَى إلى غَطفان يُنبئُهم بما","سَمعتْ قريشٌ أو يَزيدُ مُحابيا",121,"ي",2,0],["ومشى النبيُّ يقول يا قومُ اسكنوا","أكذاكَ تضطربُ الجبالُ وترجف",122,"ف",1,0],["ومشى جاسوسُهم يبغِي الأذى","فمشى عِزريلُه في المفرق",123,"ق",1,0],["ومشى باللواءِ بين يديه","يتلقَّى السنا البهيَّ فخورا",124,"ر",2,0],["وَمُشرقُ نور الكِتاب المُبين","عِمادِ الحَياة وِرُكنِ العلا",125,"ل",2,0],["ومشى صلاحُ الدينّ تح","ت لوائِهِ في مِهْرجانِ",126,"ن",1,0],["وَمُشيحٌ عَدوُهُ مُتأَقٌ","يَرعَمُ الإيجابَ قَبلَ الظَلام",127,"م",1,0],["وَمُشَمِّرٍ أَذيالَهُ يَومَ الوَغى","جَرَّت عَليهِ السافِياتُ ذُيولا",128,"ل",2,0],["وَمُشَجَّجٍ ذي لِمَّةٍ","ثاوٍ بِرَبعٍ قَد عَفا",129,"ف",2,0],["وَمُشتَبِهٍ بِالبَدرِ في أَعيُنِ الوَرى","مِنَ الناسِ إِلّا أَنَّهُ أَملَحُ الناسِ",130,"س",1,0],["وَمَشى الشَيبُ قَبلَ عَقدِ الثَلاثي","نَ فَلَمّا اِنتَهى إِلَيها أَغَذّا",131,"ذ",2,0],["وَمَشمولَةٍ قَد طالَ بِالقَفصِ حَبسُها","حَكَت نارَ إِبراهيمَ في اللَونِ وَالبَردِ",132,"د",1,1],["وَمَشَى تُظلِّلُهُ الغَمامُ لِظلِّها","ذَيْلٌ عليه في الهواجر يُ