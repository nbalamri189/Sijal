{"poems":[[90,"هي النفوس وإن لم تبلغ الحلما","https://www.aldiwan.net/poem44830.html","البسيط"],[53,"يا أسدا يا ابن جهور طرقت","https://www.aldiwan.net/poem61867.html","المنسرح"],[94,"إن الحياة صراع","https://www.aldiwan.net/poem38937.html","المجتث"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13457","المنسرح"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[214,"يا صاحبي نأى من كان في وطني","https://www.aldiwan.net/poem13397.html","البسيط"],[234,"للعيد في كل عام","https://www.aldiwan.net/poem51272.html","المجتث"],[276,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[592,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87163","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101982","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77848","السريع"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45387","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27882","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68026","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89438","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119421","المتقارب"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135131","المجتث"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117309","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52148","البسيط"],[5277,"عبقُ الراسقي","https://www.poetsgate.com/ViewPoem.aspx?id=200070",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5720,"البَصْمَة","https://www.poetsgate.com/ViewPoem.aspx?id=200696",""],[5309,"تركت دنياك لم تحفل ببهجتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573875",""],[6294,"هل لامسّت معطفها ! ! !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69183&r=&rc=24",""]],"verses":[["فأنتِ يا قدرة الله التي عظُمت","خذي حسيناً بذنب منه قد عظُما",0,"م",2,0],["فأنت يومٌ لآملٍ وَغَدٌ","وأنت يومٌ لخائف وغدُ",1,"د",1,0],["فإِنْ تَيَقَّظَ كانت","بَيْنَ الجفون بقايا",2,"ي",2,0],["فَأَنتَ يَومَ النَوالِ في حُلَلٍ","مِنها وَيَومَ النَوالِ في زَرَدِ",3,"د",1,0],["فان تيامنت الحوراء شاخصة","لها مع السحب أكناف وأحضان",4,"ن",1,0],["فَأَنتَ يا عُدَّةَ الإيمانِ أَوَّلُ مَن","يَعُدُّ ذا الدَهرُ مِن فَخرٍ إِذا فَخَرا",5,"ر",2,0],["فإن تيممتما ارضا بها شجني","بالله ربكما عوجا على سكني",6,"ي",1,0],["فأنت يُمْنَى يديه","وأنت أمضى ظُباه",7,"ا",2,0],["فأَنتَ يا موسم الزوّار ملجؤنا","عما نحاذر في الدارين من نقم",8,"م",1,0],["فَأنت يمينُ الملك تنضي حسامه","وصنوك يُسرى هزّ جنّته حجبا",9,"ب",2,0],["فَأَنتِ يا هِندُ لا تَرضَي بِفاحِشَةٍ","فَالضادُ مَفتوحَةٌ أَو عِندَكُم كُسِرا",10,"ر",2,0],["فإن تيمم كان ذلك عنده","يجوز فقابل بالثنا كل فاضل",11,"ل",1,0],["فَأَنتَ يا طَيِّبَ الأَنفاس يا أَملي","لا زلت تجبر كسر اللائذ العاني",12,"ن",2,0],["فأنت يا عين هلي ما بقيت دما","وأنت يا جذوة الأحزان فاتقد",13,"د",1,0],["فأَنتَ يعسوب الحصى حاصِباً","وَحاشر الطير الأَبابيل",14,"ل",1,0],["فأَنتَ يا وَلَدَ الفَخارِ أَنتَ كَما","تُدعى وَلا تسبّق الراءُ الأَلِف",15,"ف",1,1],["فإن تيسَّر مطلوبي ظفرتُ به","وإن تعذر تعلم أنَّ ذاك قضي",16,"ض",2,0],["فأنت يَا منزلٌ طاب النَّزِيلُ بِهِ","من حل فيك كمن قَدْ حل بالحرَم",17,"م",1,0],["فأنت يقيني لست أعتقد السوى","وأنت مرادي في الزمان وتاليه",18,"ي",2,0],["فأنتَ يا مَلكَ الإسْلامِ ناصرُهُ","من كُلّ حادثَةٍ في الدهْرِ تمنَعُهُ",19,"ع",2,0],["فأنت يد ولسان له","إذا أحدث الدهر خطبا كبيرا",20,"ر",2,0],["فأنت يا رب حسب","وأنت يا رب كافي",21,"ف",2,0],["فأنت يا ممرضى الطبيبُ","جماح نفسي مع اعتياصي",22,"ي",1,0],["فأنتَ يا مبدعَ الأَعمال حِجَّتُنا","إذا اتًّخَذْتَ على الأخلاقِ برهانا",23,"ن",2,0],["فأنتَ يا منيتي حبٌّ سرى بِدمي","وباتَ عندي هو الأعرافُ والسُّنَنُ",24,"ن",1,0],["فأنت يا ايتها النفس ارجعي","لوعده راضية لم تحرمي",25,"م",2,0],["فأنت يا أخا الرسول أول","في الفضل من بعد الرسول الاكرم",25,"م",1,0],["فأنتِ يا نُزهةَ الأبياتِ فاتِنَتِي","وأنتِ حَرفي الذي يَهديني المَدَدَا",26,"د",2,0],["فَأَنتَ يَومَ اطمَأَنَّ النّاسُ قائِدُهُم","وَأَنتَ يَومَ المُلِمّاتِ ابنُ بجَدَتِها",27,"ت",3,0],["فأنت يادنيتي نبضي وأنسجتي","يداك مسكي وشهدي منك ينهمرُ",28,"ر",1,0]]}