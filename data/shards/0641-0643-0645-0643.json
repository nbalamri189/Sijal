etry.dctabudhabi.ae/diwan/poem/130606","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89416","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91751","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85239","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133304","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199073","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105125","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136763",""],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130602","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4717,"وصيتي لبلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199833",""],[4767,"أنهار الفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179964",""],[4858,"وللإنسان ما زرعا","https://www.poetsgate.com/ViewPoem.aspx?id=140134",""],[4884,"الحب البصير","https://www.poetsgate.com/ViewPoem.aspx?id=212246",""],[4927,"خاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=29602",""],[4984,"فيا رمضان الجد","https://www.poetsgate.com/ViewPoem.aspx?id=175575",""],[5002,"من خلف السّحاب...","https://www.poetsgate.com/ViewPoem.aspx?id=202380",""],[5038,"قضى سعد","https://www.poetsgate.com/ViewPoem.aspx?id=197667",""],[5121,"بَيْرُوتُ","https://www.poetsgate.com/ViewPoem.aspx?id=215301",""],[5320,"شهيد العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=43102",""],[5442,"دع الصب يدمع منه المآقيا","https://www.poetsgate.com/ViewPoem.aspx?id=114761",""],[5457,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213104",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[5956,"الوسواس الخناس يحطِّم كبارَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192093",""],[5956,"شعوري الصدوق","https://www.poetsgate.com/ViewPoem.aspx?id=192454",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[5956,"فقدان وأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=194843",""],[6078,"جرحٌ يتأوّه","https://www.poetsgate.com/ViewPoem.aspx?id=202776",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["فكَم كَم وكَم كَم ثمَّ كَم كَم وكَم وَكَم","قَطَعتُ الفَيافِي والمَهَامِهَ لَم أَمَل",0,"ل",1,0],["فَكَم كُربَةٍ جَلّى الزُبَيرُ بِنَفسِهِ","عَنِ المُصطَفى وَاللَهُ يُعطي فَيُجزِلُ",1,"ل",1,0],["فَكَم كَم مِنَ الأَملاكِ قَد ذَلَّ مُلكُهُم","وَهَل مِن نَعيمٍ دائِمٍ لا يُغَيَّرُ",2,"ر",1,0],["فَكَم كُربَةٍ فَرَّجتَها بِمَقالَةٍ","تُصَدِّقُ تَأثيرَ الرُقى وَالعَزائِمِ",3,"م",1,0],["فَكَم كَلَفٍ في إِثرِهِم لَيسَ يَنقَضي","وَكَم خُلَّةٍ مِن بَعدِهِم لَيسَ توصَلُ",4,"ل",1,0],["فكم كان للرومان والفرسِ صولةً","وهم في بوادي أرضهم سُجناءُ",5,"ا",2,0],["فكم كم وكم كم ثم كم كم وكم كمْ","قطعتُ الفيافىِ والمَهامهِ لم أملّْ",6,"ل",1,0],["فَكَم كَسَا العارِىَ الأوصال مَكرُمَةً","منكم وكَم جندِ جوعٍ عَنكُم هَزَمَه",7,"م",2,0],["فَكَم كُربَةٍ في غُربَةٍ وَمَنِيَّةٍ","بِأُمنِيَّةٍ وَالرِزقُ ذُو العَرشِ كافِلُه",8,"ل",2,0],["فَكَم كَشَفَا مِن كُربةٍ بَعدَ كُربةٍ","تَقُولُ لَهَا النِّيرَانُ كُفِّي أُوَارَاكِ",9,"ك",1,0],["فكم كُرْبةٍ في كربلاءَ شديدةٍ","دهاهُمْ بها للناكثِين كِياد",10,"د",1,0],["فكم كأس أنسٍ من مدامِ طباعه","تدور علينا حيث نحن ندام",11,"م",1,0],["فكم كاسب فيه وليس بطالب","وساعٍ له بالكد خيب كده",12,"د",2,0],["فكم كلبٍ ينامُ على الحَشايا","وكم أسدٍ له ربطٌ وقفص",13,"ص",1,0],["فَكَمْ كَسا نِعْمَةً أَدْنى مَلابِسِها","أَسْنى مِنَ النِّعْمَةِ الأُولى الَّتِي سَلَبا",14,"ب",2,0],["فَكَم كَمِيٍّ قَدَّهُ سَيفُهُ","نِصفَينِ فَاِستافَ الذُبابُ الثَرى",15,"ر",2,0],["فكمْ كريمٍ حنا للموت هامتَهُ","عَلى الجذوعِ بحبلٍ غيرِ مُنقضب",16,"ب",1,0],["فكم كربةٍ نحيتني من غمارِها","وكانَت شجىً بين الحشا والتَرائبِ",17,"ب",1,0],["فكم كتابٍ ألّفا","ناهيكَه من فطِنِ",18,"ن",1,0],["فكم كرب حلت بمثل مذنب","دعاك على تفريجها فتفرجا",19,"ج",2,0],["فكم كفَّ دمعٌ بعد طول هموله","وقرَّ على حكم المنية مضجع",20,"ع",1,0],["فكم كرم وإكرام وبشر","كأن طلوع طلعتها بشير",21,"ر",1,0],["فكم كَبدٍ حرّى تقطّع حسرةً","وكم عبرة قد أقرح الدّمعُ خدَّها",22,"د",3,0],["فكم كَسَا منهُمُ السُّيُوفَ دَماً","يَوْمَ جِلادٍ يطيحُ طائِحُهْ",23,"ح",2,0],["فكم كنت معتزاً به لصلاحه","وطاعته لله في الدهر والنجوى",24,"و",2,0],["فكم كان يبدي فيه كل غريبة","ويظهر من أبكاره بالعقائل",25,"ل",1,0],["فكمْ كُرْبةٍ جَلَّى عن الدين رُشْدَها","غداةَ استباحتْه خُطوبٌ تَبَرَّحُ",26,"ح",1,0],["فكَمْ كُرْبةٍ جَلَّى عنِ القلبِ كَتْبُهُ","وخَطْبِ عناءٍ أسودِ الليلِ مُظْلِمِ",27,"م",1,0],["فكم كلفنا بحظ كان محتجباً","فالآن أصبح عنا غير محجوب",28,"ب",1,0],["فكم كان فيها للمها من مصائدٍ","وكم كان فيها للنُّهى من مصارعِ",29,"ع",1,0],["فكم كذّبت فيّ مقال واش","وكم صدقت بالإحسان ظني",30,"ن",2,0],["فَكَمْ كَشَفْتَ خَفايا مِنْ مَكايدِهم","رَفَلْتَ مِنْ أَجْره والشُّكرِ في حُلَلِ",31,"ل",1,0],["فكم كامل \"الأوصاف وال\"ذات ماجدٍ","إلى ذلك \"الهامي العميم\" مردُّه",32,"د",2,0],["فَكَم كافورِ أَيّامٍ خَلَطنا","وَلَم تُظلَم بِمِسكٍ مِن لَيالِ",33,"ل",1,0],["فكم كف عن وجه النبي جيوشهم","وكم ظهرت منه بأحد عجائب",34,"ب",1,0],["فكم كشفت من ظلمةٍ عينُ شمسها","فما ثَمَّ سهولٌ لا يُضيء ولا وَعر",35,"ر",1,0],["فكم كَرمٍ بجنَّتِها مليحٍ","يصيحُ هزارُه هاكُمْ حصادَهْ",36,"د",2,0],["فَكَم كَنزِ مَعروفٍ اَثارَ وَمَفخَرٍ","أَشادَ وَمَجدٍ لَيسَ تُحصى فَضائِلُه",37,"ل",2,0],["فَكَم كاعِبٍ حَسناَ تَلطِمُ وَجهَها","وَأُخرى تَشُقُّ الجَيبَ بِالثُكلِ أَيِّمُ",38,"م",1,0],["فكم كنت افدي دون ما شئت مهجتي","وابذله في حفظ عهد اعلاقا",39,"ق",2,0],["فكم كمي من الأقرام قد ظفرت","لها بمهجته حتى قضى ظفر",40,"ر",1,0],["فَكَم كانَ فيهم عالمٌ قالَ ليتَني","أرى أحمَدَ في قَلبِهِ وَهَوَ لايع",41,"ع",1,0],["فَكَم كَمَنَّا خَلفَهُم طَاوينَا","عَنهُنَّ للشِّمَالِ خُذ تقمينَا",42,"ن",2,0],["فكم كُنتَ تصبِرُ للنَّكبَاتِ","مِنَ الزَّمَنِ الفاتِكِ الجائِرِ",43,"ر",1,0],["فكم كسرت قلباً بكسر جفونها","واقتل أجفان الحسان كسيرها",44,"ر",3,0],["فكم كان لفظ الجد يصدم مسمعي","ينادي به منهم لدي وليد",45,"د",1,0],["فكم كنت تجفوني وثغري باسم","وها أنت تدنو لي ووجهي مزورّ",46,"ر",1,0],["فكم كشف الضّلال يوماً مجاهلا","وكم هدت الراعين نوقٌ شوارد",47,"د",1,0],["فكم كوى اليكُّ قلب غالٍ","وذوب الدو فؤاد فحل",48,"ل",1,0],["فكم كتب تبدا وتختمها وكم","ترى نُكتا تُبدي بها وتفنّنا",49,"ن",2,0],["فكم كؤوسٍ تصفى","وكم نفوس تصاب",50,"ب",1,0],["فكم كنت للأيام أنساً وبهجةً","وللفضل والتقوى محلاً ومجمعا",51,"ع",2,0],["فكم كريمة أصل في الكروم لنا","بالوصل جادت ولكن صدني ورع",52,"ع",1,0],["فكم كشف الغطا عن وجه رمز","فأبداه وكم رفع الحجابا",53,"ب",2,0],["فكم كمال عنه عيسوي","وكم جمال منه يوسفي",54,"ي",1,0],["فَكم كانَ من يَوم لنا فيهِ لذةٌ","وَكَم كانَ من ليل وَكان الصفا ثمّا",55,"م",2,0],["فكم كابد الكرّار بعدك من قلى","وخلف إلى فتك الشقي ابن ملجم",56,"م",1,0],["فكم كف عني فيصل الجود من أذى","وكم نالني من فيض معروفه يدا",57,"د",2,0],["فكم كان في طى الخفا من معارف","فأظهرها كالشمس تسطع فكره",58,"ر",2,0],["فكم كميٍّ منهم سيمسي","من فوق فطرقل فقيد الحس",59,"س",1,0],["فكم كبحنا قبل علجاً أروعا","وكم تحالفنا عن الكر معا",59,"ع",2,0],["فَكَم كُنتَ تَرعى حُقوقَ النَسَب","فَذا صَهرُكَ الآنَ بادي العَطَب",60,"ب",1,0],["فكم كاسب مالا وباني منازل","سقته المنايا دون آماله صبرا",61,"ر",2,0],["فكم كشفت عن الرمز الخفي به","ستراً وما فيه رمز عنك مستور",62,"ر",1,0],["فكم كريمٍ لدى الهيجاء يأكله ال","هندي والسيفُ يبري من يُلاقيه",63,"ي",2,0],["فكم كرعت على ظمأ كؤوس ال","منايا شيب ولدك والشباب",64,"ب",1,0],["فكم كشفوا لحق من غطاء","وكم في الحرب صانوا من دماء",65,"ا",2,0],["فكمْ كانتْ تَتُوقُ إلَى المعالِي","نفوسٌ خِلتِها دُونَ القِباحِ",66,"ح",1,0],["فكم كان الأذى منها","على الأطرافِ منطبقا",67,"ق",2,0],["فكم كتابٍ عظيم النفع مزدهرٍ","بنور فكرك ،يبقى الدّهرَ متبعا",68,"ع",2,0],["فكم كأْسٍ من الصَّافي سقاني","كما يُسْقى على حبٍّ صغيرُ",69,"ر",1,0],["فَكَمْ كَشَفَتْ دُمُوْعُ الصَّبِّ حُباًّ","تُحَاْصِرُهِ الْعَوَاْذِلُ وَالرَّزَاْيَاْ",70,"ا",3,0],["فكم كتبٍ طالعت فيها مثابرا","لأ