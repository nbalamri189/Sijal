m970.html",""],[452,"الجود والمجد","https://www.aldiwan.net/poem973.html",""],[455,"مولاي صدر الموالي","https://www.aldiwan.net/poem13875.html","المجتث"],[456,"العيد أنتم إذا ما النجح حالفكم","https://www.aldiwan.net/poem61688.html","البسيط"],[456,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[461,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[461,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[461,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[461,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[461,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[461,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[461,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[461,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[461,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[461,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[464,"وكنت أظن في أثواب نصر","https://www.aldiwan.net/poem15962.html","الوافر"],[464,"إذا كنت مضعوفا بأدنى فراقكم","https://www.aldiwan.net/poem16126.html","الطويل"],[466,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[467,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[467,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[471,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[480,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[480,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[480,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[482,"صواعق ساقها سوط العذاب","https://www.aldiwan.net/poem37182.html","الوافر"],[508,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[532,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[539,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[541,"أعبد اللطيف أجب عمرا","https://www.aldiwan.net/poem47462.html","عموديه"],[543,"عوجا على ربع ليلى أم محمود","https://www.aldiwan.net/poem56853.html","الكامل"],[554,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[554,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[554,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[554,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[554,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[554,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[561,"إذا ما سمعت الناي سواه منشد","https://www.aldiwan.net/poem33578.html","الطويل"],[561,"هي الذات التي فوق البراق","https://www.aldiwan.net/poem34331.html","الوافر"],[561,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[567,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[578,"سمعت بأمر ليتني لا سمعته","https://www.aldiwan.net/poem2732.html","الطويل"],[590,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[590,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[512,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10423","البسيط"],[367,"","https://poetry.dctabudhabi.ae/diwan/poem/11392","الطويل"]],"verses":[["وَمُنَبِّهاً عَزماً إِذا","ما هَزَّ لَم يوجَد نَؤوما",0,"م",2,0],["وَمُنَبِّهِ الآمالِ إِن رَقَدَت","بِالطَولِ لا أَغفى وَلا نَعِسا",1,"س",2,0],["وَمِن بارِقٍ نَهفو إِلَيهِ وَنَفحَةٍ","تُذَكِّرُنا أَيّامَها وَشَبابَها",2,"ب",3,0],["وَمِن بيضٍ كَأَنَّ مُجَرِّديها","يُمِرّونَ الأَكُفَّ عَلى الأَضاءِ",3,"ا",2,0],["وَمَنْ بَاتَ مَرْهومَ الرِّداءِ بِدَمْعِهِ","فَما في دُموعي لِلخُطوبِ نَصيبُ",4,"ب",1,0],["ومنْ بَيِّناتِ الشَّوقِ أنِّي على النَّوى","أموتُ لذِكراهُ مِراراً وأُبعَثُ",5,"ث",1,0],["وَمَن بَرى اللَهُ فيهِ","بَدائِعاً إِذ بَراهُ",6,"ا",2,0],["وَمَن بِوَجهي مَن حُبِّهُ عَلَمٌ","لَيسَ يَراهُ إِلّا المُحِبّونا",7,"ن",2,0],["وَمَنْ بَاعَ مَا يَبْقَى بِفَانٍ فَإِنَّمَا","تَعَجَّلَ فِي دُنْيَاهُ صَفْقَةَ خُسْرَانِ",8,"ن",1,0],["ومَنْ باعَ ما يَفْنى بباقٍ مُخَلَّدٍ","فقدْ أنْجَحَ المسْعى وقد ربحَ التّجْرُ",9,"ر",1,0],["ومَنْ بهِ مُذْ وصَلْتَ حبْلَهُمُ","ما جَحَدوا نِعْمَةً ولا كَفُروا",10,"ر",3,0],["ومِنْ بيْنِ مَكْلومٍ بحَدِّ سُيوفِها","تَسيلُ علَى الأعْقابِ منْهُ جِراحُهُ",11,"ح",2,0],["وَمِن بَعدِ ذاكَ إِلى حَضرَمَوتَ","فَأَوفَيتُ هَمّي وَحيناً أَهُم",12,"م",1,0],["وَمُنبَجِسٌ في ظِلّ أَحوى كَأَنَّهُ","ثِيابُ عَروسٍ فاحَ مِنها عَبيرُها",13,"ر",3,0],["وَمِن بَني غَنمِ بنِ دودانَ إِذ","نَقذِفُ أَعلاهُم عَلى السافِلِ",14,"ل",1,0],["ومن بنيك القمر المرتقى","من المعالي مرتقى البدر",15,"ر",1,0],["ومن بعد ما ساءت ظنونٌ بأهلها","وحاموا على وِرد الأماني صواديا",16,"ي",2,0],["ومنبته في شاهق متمنّعٍ","كما امتنع المحبوب في تيهِ صدِّهِ",17,"د",2,0],["ومن بعد هذا يا محمد إنني","أحيّيك باسم الناهضين إلى العلا",18,"ل",2,0],["ومن بعد وهن أشرق البدر طالعاً","فأسفر منها عارض وجبين",19,"ن",1,0],["ومن بعد اتمامي كتابة عهدها","جعلت الثريا فوق عنوانه طُغرى",20,"ر",2,0],["وَمَن بَلَغوا الحَزيزَ وَهُم عِجالٌ","وَقَد جَعَلوا وَرائُهُمُ سَناما",21,"م",2,0],["ومن باع ستراً على خَلَّةٍ","بوعدٍ فأخْسِرْ به حين آبا",22,"ب",2,0],["ومن بغى لك سوءاً","فلا تَخَطَّى أشُدَّهْ",23,"د",2,0],["ومَنْ به رُدَّ سِتر عَوْرته","من بعد ما كان ستْرها هُتِكا",24,"ك",2,0],["ومَنْ بعطاياه تَعيشُ نفوسُنا","وتقويمِه الدنيا تموتُ الملاحمُ",25,"م",1,0],["ومن بصيرةِ رأْي غيرِ مُبْصِرةٍ","إنَّ اطراحَكَ حَمْدي أغبنُ الغَبنِ",26,"ن",1,0],["ومن بدائع ظَرفٍ ذاتِ أَوْشيةٍ","تَدُقُّ عن أن تراها أعينُ الفطنِ",27,"ن",1,0],["وَمِن بَعدِ ما أُنذِرتُمُ وَأَضاءَني","لِقابِسِكُم ضَوءُ الشِهابِ المَحَرِّقِ",28,"ق",1,0],["وَمِن بُلبُلٍ ساجِعٍ لِمُغَنٍّ","وَمِن زَهرَةٍ غَضَّةٍ لِفَتاة",29,"ت",3,0],["وَمَن بِحَقِّ اللَهِ عَن","مَذهَبِ وُدّي نَقَلَك",30,"ك",1,0],["وَمَن بَدَأَ النَعما وَجادَ تَكَرُّماً","بِأَوَّلِها يُرجى لَدَيهِ أَخيرُها",31,"ر",3,0],["ومن بخله تفتح القهوات","وتغلق وهو على شيشته",32,"ت",2,0],["ومن بيت يرى الناس","عليه الخير والنبلا",33,"ا",1,0],["ومن به عن دينه","فرّج الله الكرب",34,"ب",1,0],["ومِنْ بَأْسِهِ فُتِحَتْ خَيْبَرٌ","ولَمْ يُنْجِها بابُها المُقْلَلُ",35,"ل",1,0],["وَمَن بَنوهُ زَينُ آبائِهِ","كَأَنَّها النورُ عَلى قُضبِهِ",36,"ب",2,0],["وَمَن بُعدُهُ فَقرٌ وَمَن قُربُهُ غِنىً","وَمَن عِرضُهُ حُرٌّ وَمَن مالُهُ عَبدُ",37,"د",1,0],["وَمَن بَلَغَ التُرابَ بِهِ كَراهُ","وَقَد بَلَغَت بِهِ الحالُ السُكاكا",38,"ك",2,0],["وَمَن بِالشِعبِ أَحوَجُ مِن حَمامٍ","إِذا غَنّى وَناحَ إِلى البَيانِ",39,"ن",1,0],["ومُنَّ بتوفيرِه مُنعماً","تَحُزْ بفعالكَ حسنَ الثَّوابْ",40,"ب",1,0],["وَمَن بِهِ أُبنَةٌ في الدِبرِ مُقلِقَةٌ","قَد أَحرَقَت جَفنُهُ بَل طَوَّلَت أَرَقَه",41,"ق",2,0],["وَمَن بِهِ بَخرَةٌ تُردي مُخاطِبَةُ","نَعَم وَتَترُكُ مِنهُ روحَهُ قَلِقَه",41,"ق",2,0],["وَمَن بِخَدَّيهِ رَوضَتانِ وَمَن","يَنفُثُ سِحراً مِن طَرفِهِ فِتَنُه",42,"ن",2,0],["وَمِن بَخيلٍ بُروقُ زَبرِجِهِ","كَخُلَّبِ البَرقِ خانَهُ مُزُنُه",42,"ن",2,0],["وَمِن بَعدِ أَن كَمَّلتَ تِسعينَ حِجَّةً","وَفارَقتَ عَن حُلمِ النُهى كُلَّ جاهِلِ",43,"ل",1,0],["وَمَن بَعدَهُ تَدعو النِساءُ إِذا سَعَت","وَقَد رَفَعَت عَنهُ ذُيولَ المَخادِمِ",44,"م",1,0],["وَمَن بَغى السَروَ فَالتَنَزُّهُ عَن","حُبِّ فُضولِ الدُنيا هُوَ السَروُو",45,"و",1,0],["وَمَن باتَ مَغصوباً عَلى تَركِ صُحبَتي","بِنَزعِ مُريدِ الإِنسِ وَهُوَ مَريدُ",46,"د",1,0],["وَمَن بَشَّرَ اللَهُ الأَنامَ بِأَنَّهُ","مُبَشِّرُها عَن إِذنِهِ وَنَذيرُها",47,"ر",3,0],["وَمِن بَعدِ وَردٍ في مقيلي وَسَوْسَنٍ","أقيلُ ومشمومي بها الطّلْحُ والضالُ",48,"ل",1,0],["ومُنبَّهٍ في حِجْرِ مَن شَدَواتُها","تَثْني الهمومَ بها على الأعْقابِ",49,"ب",1,0],["وَمُنْبَعِثَاتٍ فِي الْهَوَاءِ كَأَنَّهَا","بَيَارِقُ لَهْوٍ رُكِّزَتْ فِي الْمَوَاسِمِ",50,"م",1,0],["وَمُنَّ بِها أَندى نَسيماً مِنَ الصَبا","أَصيلاً وَأَحلى مَوقِعاً مِن جَنى النَحلِ",51,"ل",1,0],["وَمِن بَعدِ أَحقابٍ نَسوا ما أَتى لَهُم","مِنَ الخَيرِ وَالنَصرِ العَظيمِ الفَواضِلِ",52,"ل",1,0],["وَمَنْبَعُ الماء عَذْباً مِنْ أصابِعِهِ","وذاكَ صُنْعٌ به فينا جَرَى النيلُ",53,"ل",1,0],["ومِن بَينِ بُرْدَيَّ اللذينِ تراهُما","رقيقُ حواشي النفس والطبْع والشّيَم",54,"م",1,0],["ومن بكاءٍ على رسومٍ","جاهلةٍ بالتي تُلاقي",55,"ق",2,0],["وَمِن بالي وَإِن رَغِموا كَعابٌ","غَدَت في الخَزِّ أَو كادَت تَميدُ",56,"د",1,0],["وَمِن بَكيَةٍ في المُلتَقى ثُمَّ ضَحكَةٍ","وَكِلتاهُما أَحلى مِنَ الماءِ بِالشَهدِ",57,"د",1,0],["وَمِن بَعدِ ذاكَ يَجيءُ الحِما","مُ فَاِنظُر عَلى أَيِّ شَيءٍ حَصَل",58,"ل",1,0],["وَمِن بَديعِ الجَورِ ما بَينَنا","حَربُكَ مَن أَلقى إِلَيكَ السَلَم",59,"م",1,0],["ومِنْ بينِ أحشاء الدّنانِ تصاعدتْ","ولم يَبْقَ منها في الحقيقة إلاّ اسمُ",60,"م",1,0],["ومن بعد كبوته نام في","فراش الضنى برهة ثم قاما",61,"م",2,0],["ومن بعد أيام تزف لبيته","فتعنو لحكم الشيخ فيه وَتخضع",62,"ع",1,0],["ومن بات مسلولاً بمنزل غربة","فإن لَياليه تُمِرُّ وَلا تُحلي",63,"ل",2,0],["ومنبت الشيحٍ والحَوذان تربتها","ومغرس النخل والرمان والعنب",64,"ب",1,0],["ومِن بَنيكَ الصِّيدِ أبطالهُ","ومَن كإبراهيمَ في الفاتحينْ",65,"ن",1,0],["ومَنْ بَنَى تلك السدودَ التي","تختزنُ السُّحبَ ولا يمتلينْ",65,"ن",1,0],["وَمَن بَغى الأَجرَ مَحضاً فَلِيُنادِ لَها","بَرّاً فَقيراً وَإِن لاقاهُ بِالنُكُرِ",66,"ر",1,0],["ومن بعض جارات العراقين بابل","وعانة والصهباء عندهما جم",67,"م",1,0],["ومنبر حفت به القبائل","إياد من أعواده ووائل",68,"ل",1,0],["وَمِنْ بَناتٍ نَائِحَاتٍ بِمَا","يُذيبُ شَجْوَاً مُهْجَةَ السَّامِعِ",69,"ع",1,0],["وَمِن بَينِ مَسحوبٍ عَلى حُرِّ وَجهِهِ","وَمِن بَينِ مَن يَأتي أَغَرَّ مُحَجَّلا",70,"ل",2,0],["وَمَنْ بَيْنِ فَوْقَ العِلمِ وَالعدلِ مُلكَه","رَفيعاًن فَقَدْ أَرسَى الأساسَ وَوطَّدا",71,"د",2,0],["ومن بالخصب يا مولاي يذهب ما","قد حل بالوطن المحبوب واحتدما",72,"م",2,0],["ومن بيعة الرضوان فيهم بقية","بأيديهم منها ندى وعبير",73,"ر",1,0],["ومن بكرهي جعلت القلب مسكنه","كما توارى نصال البيض غمدان",74,"ن",1,0],["ومن بقية احساس وعاطفة","تنم عنها دموع الشعر أحيانا",75,"ن",2,0],["ومَنْ بيديه الأمرُ والنهْىُ في الورَى","ومَنْ في ذُرَا العليا له الشكرُ والحمدُ",76,"د",1,0],["ومَنْ بيديه الملكُ والعدلُ والهدَى","وتدبير أمرِ الخلقِ والحَلُّ والعَقدُ",76,"د",1,0],["ومَن برقُه نارٌ وَمن برقُ وجهه","تهلُّلُ مرتاحٍ إلى الجود والنَّدى",77,"د",2,0],["وَمِن بَخَلي أَن جاءَ ذا القَولُ آخِراً","وَلَم أَعتَمِد نَظمَ القَوافي تَطَوُّعا",78,"ع",2,0],["وَمِن بَدائِعِكَ اِستَخرَجتَ جَوهَرَةً","غَوّاصُها البيضُ وَالخَطِيَّةُ الأَسَلُ",79,"ل",1,0],["وَمَن بَسَطتَ عَلَيهِ لِلوَعيدِ يَداً","كَمَن سَلَلتَ عَلَيهِ صارِماً خَذِما",80,"م",2,0],["وَمِن بَعدِ الأُلوفِ مَنَحتَ كوماً","غَنِيٌّ مَن تُقِلُّ وَمَن تَمونُ",81,"ن",1,0],["ومن بعد ذا أمعنت فكري فلاح ل","هو الكبر المستلزم البأس والضرا",82,"ر",2,0],["ومن بينهم حمّلته حين قد قضى","وكم رميةٍ كالنجم من أفقه هوى",83,"و",2,0],["ومن بهرت دلائله","وقد عمَّ النُّهى عمم",84,"م",1,0],["وَمِن بَعدِ هَذا مَوغِدٌ أَيُّ مَوعِدٍ","لِأَحمَدَ فيهِ مُنتَهى كُلِّ سُؤددٍ",85,"د",1,0],["وَمَنْ بزُرْقَةِ سَيْفِ اللَّحظِ طَلَّ دَمي","والسَّيْفُ ما فخرُه إِلا بِزُرْقَتِهِ",86,"ت",2,0],["وَمِنْ بَيْنِ الشُّهُورِ يَسُودُ شَهْرٌ","تَمَيَّزَ بِالتُّقَى ،هَدْيٌ يُصَانُ",87,"ن",1,0],["ومن بعده لم يبق إلا بشائر","توافيك منها فرحةٌ بعد فرحةِ",88,"ه",1,0],["وَمِن بَعدِ ذاكَ العِزِّ أَضحَت مُلُوكُهُم","وَكُلٌّ لَدَيهِ خاشِعٌ مُتَضائِلُ",89,"ل",1,0],["وَمِن بَني الشَيخِ عَبدِ اللَهِ كُلُّ فَتىً","يُخالُ في الرَوعِ فَحلَ الشَولِ مُغتَلِما",90,"م",2,0],["وَمَنَّ بَعدَ ذَهابِ المالِ عَن عَرَضٍ","يفَتِّرُ النَفسَ كَي نَدعُوهُ مَنّانا",91,"ن",2,0],["وَمنبِّهاً فكري بِحُسنِ قَريضهِ","وَأَنا المطاش بسحره وَمَدامِهْ",92,"م",2,0],["وَمن بَنَوا لِصروحِ العزِّ أَعمِدَةً","تَهوي الصَّواعقُ عَنها وَهيَ تَنقَلِبُ",93,"ب",1,0],["ومن بَرَدٍ يَفْتَرُّ عنه وكيف لم","يَذُب وهْو مغمورٌ بشَهد رُضابِه",94,"ب",2,0],["ومن بنى في المعالي ما بنيتَ بها","فإنه بين ساداتِ الورى عَلَم",95,"م",1,0],["ومن بلغ المنى بلغ التناهي","وكلّ من سعادته يقوم",96,"م",1,0],["ومن بلغ النهاية في الأماني","تشير إلى أمانيه الهموم",96,"م",1,0],["وَمِن بَعدهم جاؤوا بمِقدارِ بُعدهم","عنِ المُصطفى صارَ الظلام لهم سِترا",97,"ر",2,0],["وَمِن بعدِ هَذا حازَ في مصرَ شُهرةً","وَأَلقى دُروساً للفلاسفِ في مِصرا",97,"ر",2,0],["وَمِن بعدِها كَم شهبِ حقٍّ تساقطت","عَلى ذلكَ الشيطانِ أَلقَت بهِ البَحرا",97,"ر",2,0],["وَمِن بعدهِ في الرومِ والفرس قصّرت","قياصرُ عنهم حينَما كَسَروا كِسرى",98,"ر",2,0],["وَمِن بيّناتِ الصدق أَعطاهُ ربّهُ","دَلائلَ يَعلو نورُها الأنجمَ الزهرا",98,"ر",2,0],["ومِن بعدها بعضٌ وبعضٌ تقدّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",99,"م",2,0],["وَمِن بعدُ قَد ناداهُ من أفق سعدهِ","وَقالَ اِنقَسم قِسمين خرَّ مُقسّما",99,"م",2,0],["ومِن بحرِ طه طالبٌ يتعلّمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",100,"م",3,0],["وَمنبرٌ ومغفرٌ ومئزرُ","وَكلُّ ما له اِنتَمى قَد عَظُما",101,"م",2,0],["ومن بلائي أنّي عاشق لكُمُ","عبدٌ وحَوليَ كل الناس أحرارُ",102,"ر",1,0],["ومن بمدحه على ال","شعرى تسامى شعري",103,"ر",2,0],["ومنبره لما به قمت خاطبا","تمنت بان تسعى اليك المنابر",104,"ر",1,0],["وُمنبِئا عن فؤادٍ غيرِ منصرفٍ","عنِ الْوَفاءِ وَوُدٍّ ليس يُتَّهَمُ",105,"م",1,0],["ومُنبِئهُ أن التّصابِي والهوى","أتاه بكُرْهٍ لا بطبعِ تَخَلّق",106,"ق",1,0],["ومن باقِلاَء كبلْق الحمام","تميس ولكنّها لا تطير",107,"ر",1,0],["ومُنْبَحسِ القَطْر مُثْعَنْجِرٍ","جهير الرَّواعد صخَّابها",108,"ب",3,0],["ومَنْ بين جَنْبيه كنفسي وهمّتي","يَروح له فوق الكواكب مَوْكِب",109,"ب",1,0],["ومن بعده الفاروق مظهر ديننا","بإسلامه والأمر خافٍ مبرقع",110,"ع",1,0],["ومن بعده عثمان من كان في الدجى","يرتّل آيات الكتاب ويركع",110,"ع",1,0],["ومن بعده الهادي علي بقوله","السديد إذا ما أشكل الأمر يقطع",110,"ع",1,0],["ومن بعدهم خير الصحابة ستة","لهم بالجنان المصطفى كان يقطع",110,"ع",1,0],["وَمِن بَعدِ مَرعى نَداكَ الخَصيبِ","أَنتَجِعُ البَلَدَ الماحِلا",111,"ل",2,0],["وَمِنْ بَعْدِ هَذَا الأَحْمَدُونَ ابْنُ يُوسُفٍ","فَزَرُّ وقُفَ ابْنُ عُقْبَةٍ مُنْقِذُ الرَّدِي",112,"د",2,0],["وَمَنْ بِهِ تِطْوَانُ حَسْبُ اغْتَذَتْ","فِي رَوْنَقٍ تُزْرِي بِشِعْبِ الْعِرَاقْ",113,"ق",1,0],["وَمَنْ بَغَى وَارْتَابْ","مِنْ سَائِرِ الأَسْقَاطْ",114,"ط",1,0],["ومن بعده حاز الإمامة فيصل","فقامت به كل البلاد ترحب",115,"ب",1,0],["ومنبعها استعدادُ صبٍّ مؤهّلٍ","ومشرعُها استمدادُ صدقِ الطويّة",116,"ه",1,0],["ومن بأيديه الغني يحل","وعقد كل عسرة يُحل",117,"ل",1,0],["ومن بحصر فضله نكل","هيهات ان يحصى الحصى والرمل",117,"ل",1,0],["ومن بسط الارضين فهي بلطفه","لحى بَني الدنيا وميتهم ظرف",118,"ف",1,0],["وَمَنْبَع سِلسالٍ حَبَاهُ بِطِيبِهِ","أغرُّ لغَايَات الأُلَى هُوَ سابِقُ",119,"ق",1,1],["وَمِن بدورٍ في الخُدورِ لَم تَزَل","كَوامِلاً لَم تَدنُ مِن مَحاقِها",120,"ق",3,0],["ومَن بعدَه للسَيف والضَيف والعلى","وَمَن بعدَه للمكرُمات كَفيلُ",121,"ل",1,0],["ومن بايع المختار بايع ربه","يد اللَه من فوق الأيادي الوفية",122,"ه",1,0],["ومن بعده لما حدتها بذكرها","حداه المطايا للربوع العوامر",123,"ر",1,0],["ومن بعده إما مصير إلى لظى","او الجنة العليا ووجد بلا عدم",124,"م",1,0],["ومن بيد تصديقا وليس مصدقا","لمن جاء يحكى نال ذنبا بكتمان",125,"ن",1,0],["وَمَن بِهِ هِمتُ حَتى لَم أَذُق وَسَنا","أَزَرتُ سَنا وَسَنا بِالبَدرِ رُؤيَتُهُ",126,"ت",2,0],["وَمن بَلا شِينَ ومن كَراكي","مِن صائحٍ في كَفّهِ وَبَاكي",127,"ي",1,0],["وَمَن بِهِ هِمتُ عَزيزٌ لَهُ","يَذِلُّ مِن عادَتهُ الشَمخُ",128,"خ",1,0],["وَمَن بِدارِ اللَهوِ أَلهاهُ ما","أَغواهُ عَن جَدٍّ لِجيدِ الرَشاد",129,"د",1,0],["وَمَن بِإِعدامِ صَبري عَنهُ أَوجَدَني","وَجَدا عَلَيهِ بِهِ أَمسَيتُ صَبّارا",130,"ر",2,0],["وَمَن بِقَصِّ جَناحي في هَواهُ لَهُ","إِلى أَعالي المَعالي صِرتُ طَيّارا",130,"ر",2,0],["وَمِن بَني النارِ فَكَم","أَلقَيتُ في قَعرِ سَقَر",131,"ر",1,0],["وَمِن بَني اليونانِ بِالر","ومِ الأَساطينُ الكُبَر",131,"ر",1,0],["وَمَن بِهِ هامَ وَما النِسوَةُ وَالأَي","دي الَّتي مِنهُنَّ مِرآهُ بَتَر",132,"ر",1,0],["وَمَن بِحَقَقٍّ أَحَقُّ مِنّا","وَمُدَّانا لَنا الدَليلُ",133,"ل",1,0],["وَمَن بِأَخلاقِهِ وَخِلقَتِهِ","فاقَ البَرايا حُسناً وَإِحسانا",134,"ن",2,0],["وَمَن بِحُسنِ الوَفاءِ نَذكُرُهُ","عَلى التَنائي وَإِن تَناسانا",134,"ن",2,0],["وَمَن بِالتُقى يَعتَزّ في طَلَب العلا","تذلُّ لَهُ هاماته وَمَناكبُه",135,"ب",2,0],