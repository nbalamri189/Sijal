{"poems":[[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"يا ذاكر النعماء إن نسيت","https://www.aldiwan.net/poem30191.html","الكامل"],[53,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[63,"لحى الله دهرا لا نزال دريئة","https://www.aldiwan.net/poem46103.html","الطويل"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[55,"يا من جعلت فداه","https://www.aldiwan.net/poem26039.html","المجتث"],[55,"سقيا ورعيا لمن تذكره","https://www.aldiwan.net/poem26090.html","المنسرح"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[77,"خليفة الله ساعد القدر","https://www.aldiwan.net/poem36487.html","المنسرح"],[77,"هو النصر باد للعيون صباحه","https://www.aldiwan.net/poem36646.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[71,"أشاقك من عليا دمشق قصورها","https://www.aldiwan.net/poem4027.html","الطويل"],[0,"يا دار ماوِية بالحائلِ","https://www.aldiwan.net/poem65.html",""],[93,"يا بالغ التسعين من عمره","https://www.aldiwan.net/poem9841.html","السريع"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[83,"رعى الله زهرا ينتمي لقرنفل","https://www.aldiwan.net/poem54316.html","الطويل"],[88,"إليك زعيم الهند أورد هاهنا","https://www.aldiwan.net/poem44792.html","الطويل"],[88,"بكت في ظلام الليل تندب أهلها","https://www.aldiwan.net/poem44803.html","الطويل"],[88,"كتبت لنفسي عهد تحريرها شعرا","https://www.aldiwan.net/poem45026.html","الطويل"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[51,"أبا الحسين وأنت المليك","https://www.aldiwan.net/poem61822.html","المجتث"],[51,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"يا من عكفنا عليه لائذين به","https://www.aldiwan.net/poem66386.html","البسيط"],[51,"يا واحد الناس في الآلاء والمننِ","https://www.aldiwan.net/poem66389.html","البسيط"],[26,"أبى الله إلا أن يقيدك بعدما","https://www.aldiwan.net/poem24091.html","الطويل"],[91,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[70,"يا هاجري يحق لك","https://www.aldiwan.net/poem42775.html","مجزوء الرجز"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[85,"رأى فيه عيبا وإن لم نجد","https://www.aldiwan.net/poem6951.html","المتقارب"],[85,"كفى رشاد صفة","https://www.aldiwan.net/poem6963.html","مجزوء الرجز"],[85,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[56,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[43,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[43,"مغاني الشعب طيبا في المغاني","https://www.aldiwan.net/poem10596.html","الوافر"],[62,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[45,"قولوا لسرجس يا ابن القحبة الشبقه","https://www.aldiwan.net/poem65212.html","الخفيف"],[45,"أما وهذا الزمان يمتحنه","https://www.aldiwan.net/poem66844.html","البسيط"],[28,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem5425.html","الطويل"],[28,"ألا أيها القوم الذين أتاهم","https://www.aldiwan.net/poem5556.html","الطويل"],[49,"الصمت في غير فكرة سهو","https://www.aldiwan.net/poem63199.html","المنسرح"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[80,"يا حسن ساقية تمد أناملا","https://www.aldiwan.net/poem31561.html","الكامل"],[87,"ألا حي بالمقياس ريا المعالم","https://www.aldiwan.net/poem8288.html","الطويل"],[74,"آليت إلا أن تسير مع الفضل","https://www.aldiwan.net/poem13226.html","الطويل"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[48,"أحسن من رحلة الفراق","https://www.aldiwan.net/poem66578.html","مخلع البسيط"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[50,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem63925.html","الطويل"],[46,"أرى حبلا حادثا في النسا","https://www.aldiwan.net/poem23277.html","المتقارب"],[46,"رب درفس خلفه ذائب","https://www.aldiwan.net/poem23432.html","السريع"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/15639","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16632","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2896","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54206","الطويل"]],"verses":[["وَمُنَبِّهاً عَزماً إِذا","ما هَزَّ لَم يوجَد نَؤوما",0,"م",2,0],["وَمُنَبِّهِ الآمالِ إِن رَقَدَت","بِالطَولِ لا أَغفى وَلا نَعِسا",1,"س",2,0],["وَمِن بارِقٍ نَهفو إِلَيهِ وَنَفحَةٍ","تُذَكِّرُنا أَيّامَها وَشَبابَها",2,"ب",3,0],["وَمِن بيضٍ كَأَنَّ مُجَرِّديها","يُمِرّونَ الأَكُفَّ عَلى الأَضاءِ",3,"ا",2,0],["وَمَنْ بَاتَ مَرْهومَ الرِّداءِ بِدَمْعِهِ","فَما في دُموعي لِلخُطوبِ نَصيبُ",4,"ب",1,0],["ومنْ بَيِّناتِ الشَّوقِ أنِّي على النَّوى","أموتُ لذِكراهُ مِراراً وأُبعَثُ",5,"ث",1,0],["وَمَن بَرى اللَهُ فيهِ","بَدائِعاً إِذ بَراهُ",6,"ا",2,0],["وَمَن بِوَجهي مَن حُبِّهُ عَلَمٌ","لَيسَ يَراهُ إِلّا المُحِبّونا",7,"ن",2,0],["وَمَنْ بَاعَ مَا يَبْقَى بِفَانٍ فَإِنَّمَا","تَعَجَّلَ فِي دُنْيَاهُ صَفْقَةَ خُسْرَانِ",8,"ن",1,0],["ومَنْ باعَ ما يَفْنى بباقٍ مُخَلَّدٍ","فقدْ أنْجَحَ المسْعى وقد ربحَ التّجْرُ",9,"ر",1,0],["ومَنْ بهِ مُذْ وصَلْتَ حبْلَهُمُ","ما جَحَدوا نِعْمَةً ولا كَفُروا",10,"ر",3,0],["ومِنْ بيْنِ مَكْلومٍ بحَدِّ سُيوفِها","تَسيلُ علَى الأعْقابِ منْهُ جِراحُهُ",11,"ح",2,0],["وَمِن بَعدِ ذاكَ إِلى حَضرَمَوتَ","فَأَوفَيتُ هَمّي وَحيناً أَهُم",12,"م",1,0],["وَمُنبَجِسٌ في ظِلّ أَحوى كَأَنَّهُ","ثِيابُ عَروسٍ فاحَ مِنها عَبيرُها",13,"ر",3,0],["وَمِن بَني غَنمِ بنِ دودانَ إِذ","نَقذِفُ أَعلاهُم عَلى السافِلِ",14,"ل",1,0],["ومن بنيك القمر المرتقى","من المعالي مرتقى البدر",15,"ر",1,0],["ومن بعد ما ساءت ظنونٌ بأهلها","وحاموا على وِرد الأماني صواديا",16,"ي",2,0],["ومنبته في شاهق متمنّعٍ","كما امتنع المحبوب في تيهِ صدِّهِ",17,"د",2,0],["ومن بعد هذا يا محمد إنني","أحيّيك باسم الناهضين إلى العلا",18,"ل",2,0],["ومن بعد وهن أشرق البدر طالعاً","فأسفر منها عارض وجبين",19,"ن",1,0],["ومن بعد اتمامي كتابة عهدها","جعلت الثريا فوق عنوانه طُغرى",20,"ر",2,0],["وَمَن بَلَغوا الحَزيزَ وَهُم عِجالٌ","وَقَد جَعَلوا وَرائُهُمُ سَناما",21,"م",2,0],["ومن باع ستراً على خَلَّةٍ","بوعدٍ فأخْسِرْ به حين آبا",22,"ب",2,0],["ومن بغى لك سوءاً","فلا تَخَطَّى أشُدَّهْ",23,"د",2,0],["ومَنْ به رُدَّ سِتر عَوْرته","من بعد ما كان ستْرها هُتِكا",24,"ك",2,0],["ومَنْ بعطاياه تَعيشُ نفوسُنا","وتقويمِه الدنيا تموتُ الملاحمُ",25,"م",1,0],["ومن بصيرةِ رأْي غيرِ مُبْصِرةٍ","إنَّ اطراحَكَ حَمْدي أغبنُ الغَبنِ",26,"ن",1,0],["ومن بدائع ظَرفٍ ذاتِ أَوْشيةٍ","تَدُقُّ عن أن تراها أعينُ الفطنِ",27,"ن",1,0],["وَمِن بَعدِ ما أُنذِرتُمُ وَأَضاءَني","لِقابِسِكُم ضَوءُ الشِهابِ المَحَرِّقِ",28,"ق",1,0],["وَمِن بُلبُلٍ ساجِعٍ لِمُغَنٍّ","وَمِن زَهرَةٍ غَضَّةٍ لِفَتاة",29,"ت",3,0],["وَمَن بِحَقِّ اللَهِ عَن","مَذهَبِ وُدّي نَقَلَك",30,"ك",1,0],["وَمَن بَدَأَ النَعما وَجادَ تَكَرُّماً","بِأَوَّلِها يُرجى لَدَيهِ أَخيرُها",31,"ر",3,0],["ومن بخله تفتح القهوات","وتغلق وهو على شيشته",32,"ت",2,0],["ومن بيت يرى الناس","عليه الخير والنبلا",33,"ا",1,0],["ومن به عن دينه","فرّج الله الكرب",34,"ب",1,0],["ومِنْ بَأْسِهِ فُتِحَتْ خَيْبَرٌ","ولَمْ يُنْجِها بابُها المُقْلَلُ",35,"ل",1,0],["وَمَن بَنوهُ زَينُ آبائِهِ","كَأَنَّها النورُ عَلى قُضبِهِ",36,"ب",2,0],["وَمَن بُعدُهُ فَقرٌ وَمَن قُربُهُ غِنىً","وَمَن عِرضُهُ حُرٌّ وَمَن مالُهُ عَبدُ",37,"د",1,0],["وَمَن بَلَغَ التُرابَ بِهِ كَراهُ","وَقَد بَلَغَت بِهِ الحالُ السُكاكا",38,"ك",2,0],["وَمَن بِالشِعبِ أَحوَجُ مِن حَمامٍ","إِذا غَنّى وَناحَ إِلى البَيانِ",39,"ن",1,0],["ومُنَّ بتوفيرِه مُنعماً","تَحُزْ بفعالكَ حسنَ الثَّوابْ",40,"ب",1,0],["وَمَن بِهِ أُبنَةٌ في الدِبرِ مُقلِقَةٌ","قَد أَحرَقَت جَفنُهُ بَل طَوَّلَت أَرَقَه",41,"ق",2,0],["وَمَن بِهِ بَخرَةٌ تُردي مُخاطِبَةُ","نَعَم وَتَترُكُ مِنهُ روحَهُ قَلِقَه",41,"ق",2,0],["وَمَن بِخَدَّيهِ رَوضَتانِ وَمَن","يَنفُثُ سِحراً مِن طَرفِهِ فِتَنُه",42,"ن",2,0],["وَمِن بَخيلٍ بُروقُ زَبرِجِهِ","كَخُلَّبِ البَرقِ خانَهُ مُزُنُه",42,"ن",2,0],["وَمِن بَعدِ أَن كَمَّلتَ تِسعينَ حِجَّةً","وَفارَقتَ عَن حُلمِ النُهى كُلَّ جاهِلِ",43,"ل",1,0],["وَمَن بَعدَهُ تَدعو النِساءُ إِذا سَعَت","وَقَد رَفَعَت عَنهُ ذُيولَ المَخادِمِ",44,"م",1,0],["وَمَن بَغى السَروَ فَالتَنَزُّهُ عَن","حُبِّ فُضولِ الدُنيا هُوَ السَروُو",45,"و",1,0],["وَمَن باتَ مَغصوباً عَلى تَركِ صُحبَتي","بِنَزعِ مُريدِ الإِنسِ وَهُوَ مَريدُ",46,"د",1,0],["وَمَن بَشَّرَ اللَهُ الأَنامَ بِأَنَّهُ","مُبَشِّرُها عَن إِذنِهِ وَنَذيرُها",47,"ر",3,0],["وَمِن بَعدِ وَردٍ في مقيلي وَسَوْسَنٍ","أقيلُ ومشمومي بها الطّلْحُ والضالُ",48,"ل",1,0],["ومُنبَّهٍ في حِجْرِ مَن شَدَواتُها","تَثْني الهمومَ بها على الأعْقابِ",49,"ب",1,0],["وَمُنْبَعِثَاتٍ فِي الْهَوَاءِ كَأَنَّهَا","بَيَارِقُ لَهْوٍ رُكِّزَتْ فِي الْمَوَاسِمِ",50,"م",1,0],["وَمُنَّ بِها أَندى نَسيماً مِنَ الصَبا","أَصيلاً وَأَحلى مَوقِعاً مِن جَنى النَحلِ",51,"ل",1,0],["وَمِن بَعدِ أَحقابٍ نَسوا ما أَتى لَهُم","مِنَ الخَيرِ وَالنَصرِ العَظيمِ الفَواضِلِ",52,"ل",1,0],["وَمَنْبَعُ الماء عَذْباً مِنْ أصابِعِهِ","وذاكَ صُنْعٌ به فينا جَرَى النيلُ",53,"ل",1,0],["ومِن بَينِ بُرْدَيَّ اللذينِ تراهُما","رقيقُ حواشي النفس والطبْع والشّيَم",54,"م",1,0],["ومن بكاءٍ على رسومٍ","جاهلةٍ بالتي تُلاقي",55,"ق",2,0],["وَمِن بالي وَإِن رَغِموا كَعابٌ","غَدَت في الخَزِّ أَو كادَت تَميدُ",56,"د",1,0],["وَمِن بَكيَةٍ في المُلتَقى ثُمَّ ضَحكَةٍ","وَكِلتاهُما أَحلى مِنَ الماءِ بِالشَهدِ",57,"د",1,0],["وَمِن بَعدِ ذاكَ يَجيءُ الحِما","مُ فَاِنظُر عَلى أَيِّ شَيءٍ حَصَل",58,"ل",1,0],["وَمِن بَديعِ الجَورِ ما بَينَنا","حَربُكَ مَن أَلقى إِلَيكَ السَلَم",59,"م",1,0],["ومِنْ بينِ أحشاء الدّنانِ تصاعدتْ","ولم يَبْقَ منها في الحقيقة إلاّ اسمُ",60,"م",1,0],["ومن بعد كبوته نام في","فراش الضنى برهة ثم قاما",61,"م",2,0],["ومن بعد أيام تزف لبيته","فتعنو لحكم الشيخ فيه وَتخضع",62,"ع",1,0],["ومن بات مسلولاً بمنزل غربة","فإن لَياليه تُمِرُّ وَلا تُحلي",63,"ي",1,0],["ومنبت الشيحٍ والحَوذان تربتها","ومغرس النخل والرمان والعنب",64,"ب",1,0],["ومِن بَنيكَ الصِّيدِ أبطالهُ","ومَن كإبراهيمَ في الفاتحينْ",65,"ن",1,0],["ومَنْ بَنَى تلك السدودَ التي","تختزنُ السُّحبَ ولا يمتلينْ",65,"ن",1,0],["وَمَن بَغى الأَجرَ مَحضاً فَلِيُنادِ لَها","بَرّاً فَقيراً وَإِن لاقاهُ بِالنُكُرِ",66,"ر",1,0],["ومن بعض جارات العراقين بابل","وعانة والصهباء عندهما جم",67,"م",1,0],["ومنبر حفت به القبائل","إياد من أعواده ووائل",68,"ل",1,0],["وَمِنْ بَناتٍ نَائِحَاتٍ بِمَا","يُذيبُ شَجْوَاً مُهْجَةَ السَّامِعِ",69,"ع",1,0],["وَمِن بَينِ مَسحوبٍ عَلى حُرِّ وَجهِهِ","وَمِن بَينِ مَن يَأتي أَغَرَّ مُحَجَّلا",70,"ل",2,0],["وَمَنْ بَيْنِ فَوْقَ العِلمِ وَالعدلِ مُلكَه","رَفيعاًن فَقَدْ أَرسَى الأساسَ وَوطَّدا",71,"د",2,0]]}