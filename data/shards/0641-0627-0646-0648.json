7944",""],[5136,"عاد عليك العيد عام فعام","https://www.poetsgate.com/ViewPoem.aspx?id=121722",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[5277,"ظلٌّ وحرور","https://www.poetsgate.com/ViewPoem.aspx?id=206087",""],[5314,"أحدث غيما","https://www.poetsgate.com/ViewPoem.aspx?id=214822",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"ركبتُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=182998",""],[5431,"إلى الحر الثائر الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=183079",""],[5431,"ذي المجاز ...","https://www.poetsgate.com/ViewPoem.aspx?id=190200",""],[5490,"يادار غزة","https://www.poetsgate.com/ViewPoem.aspx?id=176357",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5616,"الي من كان صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=205770",""],[5736,"لك الشريان","https://www.poetsgate.com/ViewPoem.aspx?id=203902",""],[5809,"ست وخمسون","https://www.poetsgate.com/ViewPoem.aspx?id=205360",""],[5842,"غثاء السيل /محمد الرحمون","https://www.poetsgate.com/ViewPoem.aspx?id=113404",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[5956,"أعاني من الأحزان ما يغضِب الهوَى","https://www.poetsgate.com/ViewPoem.aspx?id=183713",""],[5970,"جريح عينيك يرجو منك مغفرة","https://www.poetsgate.com/ViewPoem.aspx?id=130641",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[285,"أرى العلياءَ واضحة َ السبيلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7316&r=&rc=13",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[2220,"يا صاحبَ الأذن إنّ الأذن ناداكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11616&r=&rc=490",""]],"verses":[["فَإِن وَعَدنَ فَاِعلَمَن","أَنَّ الغَريمَ الماطِلُ",0,"ل",1,0],["فإنّ وَميضَهُ قَمِنٌ بِخُلْفٍ","كَما ابْتَسَمَتْ إِلى الشُّمْطِ الغَواني",1,"ن",2,0],["فإنْ وفّيْتُ بمعنى المدْحِ فهْوَ جَنى","روْضٍ بإنعامِكَ السّحَّ الغَمامُ سُقي",2,"ق",2,0],["فَإِن وَصَلتَنا أُمُّ عَمرٍو فَإِنَّنا","سَنَقبَلُ مِنها الوُدَّ أَو لا نَلومُها",3,"م",3,0],["فَإِنَّ وَلِيَّ الذَّوْدِ عَنْهُمْ لِجَهْلِهِمْ","أحَبَّ إلَى الرَّحْمَنِ مِنْ مُوقِعِ الحُكْمِ",4,"م",1,0],["فإن وضح النهار طَوَوا ِجياعاً","وقد نهِموا إذا اختلط الظلام",5,"م",1,0],["فإن وافقتني وجربت جَريي","وإلا فاتَك الطبع السليم",6,"م",1,0],["فَإِنَّ وَكيعاً حينَ خارَت مُجاشِعٌ","كَفى شَعبَ صَدعِ الفِتنَةِ المُتَفاقِمِ",7,"م",1,0],["فَإِن وَقَفتُ أَمامَ الحَيِّ أُنشِدُهُ","وَدَّ الخَرائِدُ لَو تُقنى جَواهِرُهُ",8,"ر",2,0],["فَإِن وَصَلَت حَبلَ الصَفاءِ فَدُم لَها","وَإِن صَرَمَتهُ فَاِنصَرِم عَن تَجامُلِ",9,"ل",1,0],["فَإِن وافَقتَني أَهلاً وَسَهلاً","وَإِلّا لَستُ مِنكَ وَلَستَ مِنّي",10,"ن",2,0],["فَإِن وُجِدَت نَعلٌ بِأَرضٍ مضِلَّةٍ","مِنَ الأَرضِ يَوماً فَاِعلَمي أَنَّها نَعلي",11,"ل",2,0],["فَإِن وَقَفتَ مُطرِيَ البِناءِ","فَاعطِف عَلى الأَساسِ في الثَناءِ",12,"ا",2,0],["فإنْ وتَحْظَ بها وإِنْ يَضِقْ","لا يَضِقْ في الأَرْضِ مُضْطَرَبِيْ",13,"ب",2,0],["فأنوارُها مثلُ نظمِ الحِلَى","وأنهارُها مثلُ بِيضِ القُضُب",14,"ب",1,0],["فإنَّ وزناً بوزنٍ غيرَ أنَّ لما","نقولُ فضلاً عليهم سهلُهُ صَعُبا",15,"ب",2,0],["فَإِن وَسَّعَت لِلفَتى ساعَةً","فَسَوفَ تُغادِرُهُ في كَبَد",16,"د",1,0],["فإن وجدت خاطراً مطالبا","ونازعا من الطباع غالبا",17,"ب",2,0],["فإن وفيت بحق المدح فهو جنى","روض بإنعامك السيح العمام سق",18,"ق",1,0],["فان وُجِدَ الحياءُ سطا عليه","فسخَّرهُ أناسٌ أذكياء",19,"ا",2,0],["فانْ وَجَدَتْ دَرَّةً حُلوةً","يداك ، فدُونَكَها فاحلِب",20,"ب",1,0],["فَإِنْ وُفِّقَتْ بِإِعْلاءِ قَدْرِها","عَلَى كُلِّ مَنْ تَعْلُو عَلَيْهَا وَتَسْتَعْلِي",21,"ي",1,0],["فإن وعدوا طابوا وطاب جنانهم","وان وعدوا بالقتل حنوا إلى القتل",22,"ل",1,0],["فَإِنَّ وُرّاثَهُ لَن يَحمَدوكَ لَهُ","إِذا أَجنوكَ بَينَ اللَبنِ وَالخَشَبِ",23,"ب",1,0],["فَإن وافَيتَه الفَيتَ نَدباً","ضَحُوكَ السِّنِّ فَيَّاضَ الأيَادِى",24,"د",2,0],["فانْوِ ائْتلافاً فلكلِّ امرئٍ","قال النبيُّ المصطفى ما نَوى",25,"و",2,0],["فَإِن وصَلَتكُما سَلمَى فَإِنَّا","نَرَى فِى الحَقِّ أن نَصِلَ الوَصُولا",26,"ل",2,0],["فإن وفقت في صبري بشكر","فعند الله ما فيه المزيد",27,"د",1,0],["فإن وفقت كن فردا وحيدا","فما عاداك إلا من عرفنا",28,"ن",2,0],["فَإِنَّ وُرّاثَهُ لَن يَحمَدوكَ بِهِ","إِذا أَجَنّوكَ بَينَ اللَبنِ وَالخَشَبِ",29,"ب",1,0],["فإنْ وشَّى عليّ الزُّورَ باغٍ","فَصبْراً للمَقادِرِ والقضاء",30,"ا",2,0],["فَإِنَّ وَجهَ الأَرضِ بِال","إِمساكِ قَد تَجَهَّما",31,"م",2,0],["فَإِن وَنى جَفنُكَ عَن","سُقيا الدِيارِ لاسُقي",32,"ق",2,0],["فأن وجود الأكرمين من الورى","معاقل أرباب العقول وسورها",33,"ر",3,0],["فإن وجود البر من نفس فاجر","يمحص عنه سيآت المعايب",34,"ب",1,0],["فان ولهت الى قبر ابن آمنة","فهوَ الَّذي خقت فيه الرسالات",35,"ت",1,0],["فَإِنْ وَكَفَتْ سُحْم الغَمائِمِ بَعْدَها","فَقَدْ هَتَفَتْ بالنَّوْحِ وُرْقُ الحَمَائِمِ",36,"م",1,0],["فإن وُعدَتْ قِدْماً مُنَاجَزَةَ العِدى","فَرايَتُهُ الحَمْراءُ مُنْجِزَة الوَعدِ",37,"د",1,0],["فَإِنْ وَجى الْجِيادِ إِذا تَمادى","بِها شَغَلَ الْجِيادَ عَنِ الصَّهِيلِ",38,"ل",1,0],["فان وإلا فاني قد ركنت إلى","ركن شديد له شأن من الشأن",39,"ن",1,0],["فانو بقلبك من","نياته المجزئات",40,"ت",1,0],["فَإِن وَجدت سِوى التَوحيد فيهِ هَوىً","إِلّا هَواكِ فَلا تُبقي وَلا تَذَري",41,"ر",2,0],["فإِن وسعتك حيزوماً وآلا","فما ضاقت حيازيم البلادِ",42,"د",1,0],["فإِن ولَدْتَ لَهَا أَقمارَ مَمْلَكَةٍ","أَسباطَ مَلحمَةٍ أُسْداً وفُرْسانا",43,"ن",2,0],["فإِن وَجَبتُ للمَغْرِبَينِ جُنوبُها","فداوي برَقراقِ السَّرابِ خُمارَكِ",44,"ك",1,0],["فإن ولَغتْ في نعمةٍ بعد نكبة","فقد تيبَس الغدرانُ ثم تُسالُ",45,"ل",1,0],["فإن وجدوا الأبدال لم يتعرضوا","فكيف وما في الناس منك بديلُ",46,"ل",1,0],["فإن وعدت نفسي المنى بلقائها","أبى اليأس منها أن يصحَّ لها وعد",47,"د",1,0],["فِانْ وقفتْ دون المرادِ طلائحاً","فعذْ برسولِ الريحِ أن هبَّ أو لُذِ",48,"ذ",1,0],["فاِنْ وصفتُمْ لنا فيها اشتياقَكُمُ","فعندنا منكمُ أضعافُ ما فيها",49,"ي",3,0],["فإنْ وَفَدَتُ بُنَيَّ عليكَ دُنْيا","فخُذْها باليَمينِ الهاشِمِيَّهْ",50,"ي",2,0],["فإن وردْتَ الحياةَ مِثْلما وردُوا","أَصبحْتَ بالخَبِّ والإفسادِ تُتّهمُ",51,"م",1,0],["فإنْ وَجَدْتَ جَميلاً بَعْدَ تَجْربَةٍ","فاشْدُدْ يَدَيْكَ فَهَذا عِنْدِيَ الحَسَبُ",52,"ب",1,0],["فإنْ وردتُ زلالاً غبَّ معطشةٍ","ففي ولائك عَلِّي اليومَ أو نَهَلِي",53,"ل",2,0],["فَإنْ وَفَتِ الأقدارُ عابثةً لكمْ","فَكمْ مِن وفاءٍ بَعده شرُّ غدرةِ",54,"ه",1,0],["فإن وفت بالعهود من قِدَمٍ","يومَ بَلَى ذاك للربوبيه",55,"ي",2,0],["فأنوارهم فيه به قد تجلت","هو الوسط المختار غير معلل",56,"ل",1,0],["فإنّ وليَّكم بعدي عليٌّ","ومولاكُم هو الهادي الوزيرُ",57,"ر",1,0],["فإن وضعت أساسَ اليوم من حجر","فللنفائس والآلاء مبناه",58,"ا",2,0],["فَإِنّ وَجنَتَهُ الحسناءَ قَد جَذَبَت","إِنسانَ عَيني فَكانَ الخالُ إِنسانا",59,"ن",2,0],["فإن وإلا فتمويه الوصال لنا","لَنُحِييَنَّ فؤاداً مات عندهمُ",60,"م",1,0],["فإن وصل وإلا فالمطالُ أرا","ه جيِّداً وحياتي في وصالهم",60,"م",1,0],["فإنْ وإلا فهلْ من ساعةٍ زعمتْ","فيها الحسانُ مميليك الهوى علقا",61,"ق",2,0],["فإن ورائي رضعا قد تركتهم","وأكابدهم حر الفقد المراضع",62,"ع",1,0],["فان وصلوا حبلى وصلت حبالهم","وان قرعوا سنى جدعت لهم أذنا",63,"ن",2,0],["فَإِن وَجَدتَ صَديقاً عِندَ نائِبَة","فَلَستَ مِن طُرُقاتِ الخَيرِ في أُمَم",64,"م",1,0],["فَإِنَّ وِدادي لا يُغَيِّرَهُ النَوى","وَإِن زَماني لا يَدومُ عِنادُهُ",65,"د",2,0],["فانوف حمية وحجور","طهرت مولداً وطابت وليدا",66,"د",2,0],["فَإِن وَقَعتُ لِجَنبِ الرَملِ مُنقَصِفاً","أَولَيتُ كُلَّ اِمرِئٍ ما كانَ يُوليني",67,"ن",2,0],["فان ولا بد من طول البعاد فمر","طيف الخيال يزور الطرف في الوسن",68,"ن",1,0],["فإن وجدتَ لها شبهَا يُقاربُها","فمثلُ أخلاقِ سيف الدين ما تجدُ",69,"د",1,0],["فإن واحدهم كالألف محتمل","هَذا وَذاكَ وكل غير متهم",70,"م",1,0],["فإن وضعوا حرباً فضعها وإن أبوا","فعرضة عض الحرب مثلك أو مثلي",71,"ل",2,0],["فإنَّ وِدَادي وانقطاعي وغُربتي","وأجري وبعضُ القائلينَ أَثيم",72,"م",1,0],["فإن وافقت اجزاؤها بعض أهلها","ففي بعضها للعالم الطبِّ مقنعُ",73,"ع",1,0],["فإن وجودك الميمون فينا","رأيناه سروراً متسداما",74,"م",2,0],["فإن ورائي من يفل شباته","ويدفع عني والأسنة تلتقي",75,"ق",2,0],["فإن واصلَتْنا بالكمال فمرحباً","وإن صارمَتنا بالمَلالة فالعقرا",76,"ر",2,0],["فإن وردت فأولها ورودا","وإن صدت فليس بذي صدود",77,"د",1,0],["فأنور من بدر سناه إذا اختفى","وأغزر من بحر نداه إذا قلا",78,"ل",2,0],["فإن ونى عنك ثنائي أو ثنى","عنانه فلا دعيت راجحا",79,"ح",2,0],["فَإن وَافَيتَهُ دونَ البرايا","فَأولاهم بِعَبدِ العَالِ أحمَد",80,"د",1,0],["فإنَّ وجود الشكرِ يبغي زيادة","من الله في النعماء فانهض على أثري",81,"ر",2,0],["فإنْ وصالي ليس لي بحقيقة","وإنَّ فصالي حاكم بالتوسُّل",82,"ل",1,0],["فإن وجودَ الحقِّ في قلبِ عبده","وما لك من قلبٍ فما لك من قلبِ",83,"ب",1,0],["فإن وعاها سمعُ أذني فلا","أفهم ما قال ولا أعلم",84,"م",1,0],["فأنوارٌ تلوح على وليِّ","ظهورَ الوشي في الثوب الموشَّى",85,"ش",2,1],["فإن وهبتَ الرجوع فرِّق","بين الحواضر والبوادي",86,"د",2,0],["فَإِن وَجَدتُم كَما أَوجَدتُم بَدَلاً","فَليَرضَ كُلُّ امرئٍ مِنّا بِما وَجَدا",87,"د",2,0],["فان ورثت المعالي بعد ما رحلوا","فكم ركبت لها من هول أخطار",88,"ر",1,0],["فَإِن وَثِقت بِقَولي","فيهِم وَإِلّا فَغَرِّر",89,"ر",1,0],["فَإن وَصَلتَ لِجَزِيرَة لار","شَرقِيَّهَا بِقُربِهَا شَتوَار",90,"ر",1,0],["فَأنوَرُ ما مُدَّ القياسُ عليهِم","بِفَردِ قِيَاسٍ قَد حَوَتهُ الأصَابع",91,"ع",1,0],["فان وصفوا بسمرك يوما بفطنة","رأيناه اسمى في الذكاء وانبها",92,"ه",2,0],["فإن ولهت إلى قبر ابن آمنةٍ","فتلك قبلي للعشاق عادات",93,"ت",1,0],["فإن واعدت يوماً في جميل","فأنجزه وإلا لا تواعد",94,"د",1,0],["فان وراء عزك ان تضامي","حماة الجار مرهفة ظباها",95,"ا",3,0],["فأنوار الصباحة في عيوني","ونيران الصبابة في جنوبي",96,"ب",2,0],["فإن وفائي فِي الغرام سَجيةٌ","طُبعت عَلَيْهَا والطِّباعُ جِبِلَّةٌ",97,"ه",1,0],["فأنواعُ الجمالِ وإن تناهَتْ","حَوَى جمعاً لها وبها انفرادا",98,"د",2,0],["فإنّ وليّ العهْدِ أرفَعُ مظْهَراً","فليسَ على نيْلِ العُلى منهُ أحْرَصُ",99,"ص",1,0],["فَإِن وَصَلتَ فَأَهلُ العُرفِ أَنتَ وَإِن","تَدفَع يَدَيَّ فَلى بُقيا وَمُنقَلَبُ",100,"ب",1,0],["فإنّ ورائيَ لي مذهَباً","بعيداً من الأرضِ قاعاً وقورا",101,"ر",2,0],["فان ونت رفقاً بهن لم تسق","إلا بأن تضرب أو أن توكزا",102,"ز",2,0],["فَإِن وَفَيتُم لِعَهدي وَهِيَ عادتكم","ما أَحسَن الأَرض جادتها السَموات",103,"ت",1,0],["فإن وَرَدَت تِلكَ المن