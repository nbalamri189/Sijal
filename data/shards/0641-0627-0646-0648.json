{"poems":[[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[35,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[88,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[88,"أرى للروح بالبدن اتصالا","https://www.aldiwan.net/poem45062.html","الوافر"],[27,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[26,"أساءلت رسم الدار أم لم تسائل","https://www.aldiwan.net/poem24083.html","الطويل"],[70,"هوانا بالهوى كم ذا التجني","https://www.aldiwan.net/poem42447.html","الوافر"],[32,"لقد فرح الواشون أن صرمت حبلي","https://www.aldiwan.net/poem27816.html","الطويل"],[85,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[56,"إني ببابك لا ودي يقربني","https://www.aldiwan.net/poem58643.html","البسيط"],[61,"هفا طربا في أوان الطرب","https://www.aldiwan.net/poem51796.html","المتقارب"],[69,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[46,"إذا اجتمع اثنان في منزل","https://www.aldiwan.net/poem22498.html","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[116,"نسخت بحبي آية العشق من قبلي","https://www.aldiwan.net/poem40612.html","عموديه"],[128,"يا دار أسماء بين السفح فالرحب","https://www.aldiwan.net/poem24220.html","البسيط"],[133,"إلى كم استهيم إلى سعاد","https://www.aldiwan.net/poem54850.html","الطويل"],[167,"يا شمس والشمس لها حاجب","https://www.aldiwan.net/poem46831.html","السريع"],[182,"أقول وقد أجد رحيل صحبي","https://www.aldiwan.net/poem58803.html","الوافر"],[187,"صبرت لصرف هذا الدهر لما","https://www.aldiwan.net/poem43916.html","الوافر"],[187,"تخل عن الصديق إذا قدرتا","https://www.aldiwan.net/poem44105.html","الوافر"],[208,"يا دار أسماء بين السفح فالرحب","https://www.aldiwan.net/poem27978.html","البسيط"],[230,"رضيت بحكم سابقة القضاء","https://www.aldiwan.net/poem51267.html","الوافر"],[236,"مات السماح فاسفحي","https://www.aldiwan.net/poem31756.html","مجزوء الرجز"],[236,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[262,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[262,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[272,"بالابرق الفرد اطلال قديمات","https://www.aldiwan.net/poem52092.html","البسيط"],[276,"لعل قسيم الفضل من آل قاسم","https://www.aldiwan.net/poem25521.html","الطويل"],[276,"تخيرت مختار الخليفة للعهد","https://www.aldiwan.net/poem25584.html","الطويل"],[281,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[305,"يا ظبي عيد ما في الحسن لك ثاني","https://www.aldiwan.net/poem16834.html","البسيط"],[392,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[407,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[433,"هو النادي وأنت به أنادي","https://www.aldiwan.net/poem12423.html","الوافر"],[440,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[440,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[459,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[459,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[465,"سهادي وليلي فيك ما لها حد","https://www.aldiwan.net/poem3629.html","عموديه"],[478,"متى ينجلي بالقرب ذا الناظر القذي","https://www.aldiwan.net/poem15282.html","الطويل"],[478,"انا لتتحفنا بالأنس كتبكم","https://www.aldiwan.net/poem15366.html","البسيط"],[501,"دني العزم همته دنيه","https://www.aldiwan.net/poem37721.html","الوافر"],[506,"الحسد","https://www.aldiwan.net/poem61088.html","البسيط"],[530,"في حاديات الليالي للفتى عجب","https://www.aldiwan.net/poem37535.html","البسيط"],[552,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[552,"أرى عزة من بين أثناء ذلة","https://www.aldiwan.net/poem48027.html","الطويل"],[559,"معرفة الله عند عارفه","https://www.aldiwan.net/poem33563.html","المنسرح"]],"verses":[["فَإِن وَعَدنَ فَاِعلَمَن","أَنَّ الغَريمَ الماطِلُ",0,"ل",1,0],["فإنّ وَميضَهُ قَمِنٌ بِخُلْفٍ","كَما ابْتَسَمَتْ إِلى الشُّمْطِ الغَواني",1,"ن",2,0],["فإنْ وفّيْتُ بمعنى المدْحِ فهْوَ جَنى","روْضٍ بإنعامِكَ السّحَّ الغَمامُ سُقي",2,"ق",2,0],["فَإِن وَصَلتَنا أُمُّ عَمرٍو فَإِنَّنا","سَنَقبَلُ مِنها الوُدَّ أَو لا نَلومُها",3,"م",3,0],["فَإِنَّ وَلِيَّ الذَّوْدِ عَنْهُمْ لِجَهْلِهِمْ","أحَبَّ إلَى الرَّحْمَنِ مِنْ مُوقِعِ الحُكْمِ",4,"م",1,0],["فإن وضح النهار طَوَوا ِجياعاً","وقد نهِموا إذا اختلط الظلام",5,"م",1,0],["فإن وافقتني وجربت جَريي","وإلا فاتَك الطبع السليم",6,"م",1,0],["فَإِنَّ وَكيعاً حينَ خارَت مُجاشِعٌ","كَفى شَعبَ صَدعِ الفِتنَةِ المُتَفاقِمِ",7,"م",1,0],["فَإِن وَقَفتُ أَمامَ الحَيِّ أُنشِدُهُ","وَدَّ الخَرائِدُ لَو تُقنى جَواهِرُهُ",8,"ر",2,0],["فَإِن وَصَلَت حَبلَ الصَفاءِ فَدُم لَها","وَإِن صَرَمَتهُ فَاِنصَرِم عَن تَجامُلِ",9,"ل",1,0],["فَإِن وافَقتَني أَهلاً وَسَهلاً","وَإِلّا لَستُ مِنكَ وَلَستَ مِنّي",10,"ن",2,0],["فَإِن وُجِدَت نَعلٌ بِأَرضٍ مضِلَّةٍ","مِنَ الأَرضِ يَوماً فَاِعلَمي أَنَّها نَعلي",11,"ل",2,0],["فَإِن وَقَفتَ مُطرِيَ البِناءِ","فَاعطِف عَلى الأَساسِ في الثَناءِ",12,"ا",2,0],["فإنْ وتَحْظَ بها وإِنْ يَضِقْ","لا يَضِقْ في الأَرْضِ مُضْطَرَبِيْ",13,"ب",2,0],["فأنوارُها مثلُ نظمِ الحِلَى","وأنهارُها مثلُ بِيضِ القُضُب",14,"ب",1,0],["فإنَّ وزناً بوزنٍ غيرَ أنَّ لما","نقولُ فضلاً عليهم سهلُهُ صَعُبا",15,"ب",2,0],["فَإِن وَسَّعَت لِلفَتى ساعَةً","فَسَوفَ تُغادِرُهُ في كَبَد",16,"د",1,0],["فإن وجدت خاطراً مطالبا","ونازعا من الطباع غالبا",17,"ب",2,0],["فإن وفيت بحق المدح فهو جنى","روض بإنعامك السيح العمام سق",18,"ق",1,0],["فان وُجِدَ الحياءُ سطا عليه","فسخَّرهُ أناسٌ أذكياء",19,"ا",2,0],["فانْ وَجَدَتْ دَرَّةً حُلوةً","يداك ، فدُونَكَها فاحلِب",20,"ب",1,0],["فَإِنْ وُفِّقَتْ بِإِعْلاءِ قَدْرِها","عَلَى كُلِّ مَنْ تَعْلُو عَلَيْهَا وَتَسْتَعْلِي",21,"ي",1,0],["فإن وعدوا طابوا وطاب جنانهم","وان وعدوا بالقتل حنوا إلى القتل",22,"ل",1,0],["فَإِنَّ وُرّاثَهُ لَن يَحمَدوكَ لَهُ","إِذا أَجنوكَ بَينَ اللَبنِ وَالخَشَبِ",23,"ب",1,0],["فَإن وافَيتَه الفَيتَ نَدباً","ضَحُوكَ السِّنِّ فَيَّاضَ الأيَادِى",24,"د",2,0],["فانْوِ ائْتلافاً فلكلِّ امرئٍ","قال النبيُّ المصطفى ما نَوى",25,"و",2,0],["فَإِن وصَلَتكُما سَلمَى فَإِنَّا","نَرَى فِى الحَقِّ أن نَصِلَ الوَصُولا",26,"ل",2,0],["فإن وفقت في صبري بشكر","فعند الله ما فيه المزيد",27,"د",1,0],["فإن وفقت كن فردا وحيدا","فما عاداك إلا من عرفنا",28,"ن",2,0],["فَإِنَّ وُرّاثَهُ لَن يَحمَدوكَ بِهِ","إِذا أَجَنّوكَ بَينَ اللَبنِ وَالخَشَبِ",29,"ب",1,0],["فإنْ وشَّى عليّ الزُّورَ باغٍ","فَصبْراً للمَقادِرِ والقضاء",30,"ا",2,0],["فَإِنَّ وَجهَ الأَرضِ بِال","إِمساكِ قَد تَجَهَّما",31,"م",2,0],["فَإِن وَنى جَفنُكَ عَن","سُقيا الدِيارِ لاسُقي",32,"ق",2,0],["فأن وجود الأكرمين من الورى","معاقل أرباب العقول وسورها",33,"ر",3,0],["فإن وجود البر من نفس فاجر","يمحص عنه سيآت المعايب",34,"ب",1,0],["فان ولهت الى قبر ابن آمنة","فهوَ الَّذي خقت فيه الرسالات",35,"ت",1,0],["فَإِنْ وَكَفَتْ سُحْم الغَمائِمِ بَعْدَها","فَقَدْ هَتَفَتْ بالنَّوْحِ وُرْقُ الحَمَائِمِ",36,"م",1,0],["فإن وُعدَتْ قِدْماً مُنَاجَزَةَ العِدى","فَرايَتُهُ الحَمْراءُ مُنْجِزَة الوَعدِ",37,"د",1,0],["فَإِنْ وَجى الْجِيادِ إِذا تَمادى","بِها شَغَلَ الْجِيادَ عَنِ الصَّهِيلِ",38,"ل",1,0],["فان وإلا فاني قد ركنت إلى","ركن شديد له شأن من الشأن",39,"ن",1,0],["فانو بقلبك من","نياته المجزئات",40,"ت",1,0],["فَإِن وَجدت سِوى التَوحيد فيهِ هَوىً","إِلّا هَواكِ فَلا تُبقي وَلا تَذَري",41,"ر",2,0],["فإِن وسعتك حيزوماً وآلا","فما ضاقت حيازيم البلادِ",42,"د",1,0],["فإِن ولَدْتَ لَهَا أَقمارَ مَمْلَكَةٍ","أَسباطَ مَلحمَةٍ أُسْداً وفُرْسانا",43,"ن",2,0],["فإِن وَجَبتُ للمَغْرِبَينِ جُنوبُها","فداوي برَقراقِ السَّرابِ خُمارَكِ",44,"ك",1,0],["فإن ولَغتْ في نعمةٍ بعد نكبة","فقد تيبَس الغدرانُ ثم تُسالُ",45,"ل",1,0],["فإن وجدوا الأبدال لم يتعرضوا","فكيف وما في الناس منك بديلُ",46,"ل",1,0],["فإن وعدت نفسي المنى بلقائها","أبى اليأس منها أن يصحَّ لها وعد",47,"د",1,0],["فِانْ وقفتْ دون المرادِ طلائحاً","فعذْ برسولِ الريحِ أن هبَّ أو لُذِ",48,"ذ",1,0],["فاِنْ وصفتُمْ لنا فيها اشتياقَكُمُ","فعندنا منكمُ أضعافُ ما فيها",49,"ي",3,0],["فإنْ وَفَدَتُ بُنَيَّ عليكَ دُنْيا","فخُذْها باليَمينِ الهاشِمِيَّهْ",50,"ي",2,0],["فإن وردْتَ الحياةَ مِثْلما وردُوا","أَصبحْتَ بالخَبِّ والإفسادِ تُتّهمُ",51,"م",1,0],["فإنْ وَجَدْتَ جَميلاً بَعْدَ تَجْربَةٍ","فاشْدُدْ يَدَيْكَ فَهَذا عِنْدِيَ الحَسَبُ",52,"ب",1,0],["فإنْ وردتُ زلالاً غبَّ معطشةٍ","ففي ولائك عَلِّي اليومَ أو نَهَلِي",53,"ل",2,0],["فَإنْ وَفَتِ الأقدارُ عابثةً لكمْ","فَكمْ مِن وفاءٍ بَعده شرُّ غدرةِ",54,"ه",1,0],["فإن وفت بالعهود من قِدَمٍ","يومَ بَلَى ذاك للربوبيه",55,"ي",2,0]]}