{"poems":[[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[35,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[88,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[88,"أرى للروح بالبدن اتصالا","https://www.aldiwan.net/poem45062.html","الوافر"],[27,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[26,"أساءلت رسم الدار أم لم تسائل","https://www.aldiwan.net/poem24083.html","الطويل"],[70,"هوانا بالهوى كم ذا التجني","https://www.aldiwan.net/poem42447.html","الوافر"],[32,"لقد فرح الواشون أن صرمت حبلي","https://www.aldiwan.net/poem27816.html","الطويل"],[85,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[56,"إني ببابك لا ودي يقربني","https://www.aldiwan.net/poem58643.html","البسيط"],[61,"هفا طربا في أوان الطرب","https://www.aldiwan.net/poem51796.html","المتقارب"],[69,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[46,"إذا اجتمع اثنان في منزل","https://www.aldiwan.net/poem22498.html","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["فَإِن وَعَدنَ فَاِعلَمَن","أَنَّ الغَريمَ الماطِلُ",0,"ل",1,0],["فإنّ وَميضَهُ قَمِنٌ بِخُلْفٍ","كَما ابْتَسَمَتْ إِلى الشُّمْطِ الغَواني",1,"ن",2,0],["فإنْ وفّيْتُ بمعنى المدْحِ فهْوَ جَنى","روْضٍ بإنعامِكَ السّحَّ الغَمامُ سُقي",2,"ق",2,0],["فَإِن وَصَلتَنا أُمُّ عَمرٍو فَإِنَّنا","سَنَقبَلُ مِنها الوُدَّ أَو لا نَلومُها",3,"م",3,0],["فَإِنَّ وَلِيَّ الذَّوْدِ عَنْهُمْ لِجَهْلِهِمْ","أحَبَّ إلَى الرَّحْمَنِ مِنْ مُوقِعِ الحُكْمِ",4,"م",1,0],["فإن وضح النهار طَوَوا ِجياعاً","وقد نهِموا إذا اختلط الظلام",5,"م",1,0],["فإن وافقتني وجربت جَريي","وإلا فاتَك الطبع السليم",6,"م",1,0],["فَإِنَّ وَكيعاً حينَ خارَت مُجاشِعٌ","كَفى شَعبَ صَدعِ الفِتنَةِ المُتَفاقِمِ",7,"م",1,0],["فَإِن وَقَفتُ أَمامَ الحَيِّ أُنشِدُهُ","وَدَّ الخَرائِدُ لَو تُقنى جَواهِرُهُ",8,"ر",2,0],["فَإِن وَصَلَت حَبلَ الصَفاءِ فَدُم لَها","وَإِن صَرَمَتهُ فَاِنصَرِم عَن تَجامُلِ",9,"ل",1,0],["فَإِن وافَقتَني أَهلاً وَسَهلاً","وَإِلّا لَستُ مِنكَ وَلَستَ مِنّي",10,"ن",2,0],["فَإِن وُجِدَت نَعلٌ بِأَرضٍ مضِلَّةٍ","مِنَ الأَرضِ يَوماً فَاِعلَمي أَنَّها نَعلي",11,"ي",1,0],["فَإِن وَقَفتَ مُطرِيَ البِناءِ","فَاعطِف عَلى الأَساسِ في الثَناءِ",12,"ا",2,0],["فإنْ وتَحْظَ بها وإِنْ يَضِقْ","لا يَضِقْ في الأَرْضِ مُضْطَرَبِيْ",13,"ي",1,0],["فأنوارُها مثلُ نظمِ الحِلَى","وأنهارُها مثلُ بِيضِ القُضُب",14,"ب",1,0],["فإنَّ وزناً بوزنٍ غيرَ أنَّ لما","نقولُ فضلاً عليهم سهلُهُ صَعُبا",15,"ب",2,0],["فَإِن وَسَّعَت لِلفَتى ساعَةً","فَسَوفَ تُغادِرُهُ في كَبَد",16,"د",1,0],["فإن وجدت خاطراً مطالبا","ونازعا من الطباع غالبا",17,"ب",2,0],["فإن وفيت بحق المدح فهو جنى","روض بإنعامك السيح العمام سق",18,"ق",1,0],["فان وُجِدَ الحياءُ سطا عليه","فسخَّرهُ أناسٌ أذكياء",19,"ا",2,0],["فانْ وَجَدَتْ دَرَّةً حُلوةً","يداك ، فدُونَكَها فاحلِب",20,"ب",1,0],["فَإِنْ وُفِّقَتْ بِإِعْلاءِ قَدْرِها","عَلَى كُلِّ مَنْ تَعْلُو عَلَيْهَا وَتَسْتَعْلِي",21,"ي",1,0]]}