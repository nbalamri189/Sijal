{"poems":[[466,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[589,"يا عين بكي عتبه","https://www.aldiwan.net/poem69381.html","مجزوء الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49091","المنسرح"],[3591,"ملكت حسناً عديم المثل ما وجدا","https://www.poetsgate.com/ViewPoem.aspx?id=149391",""],[5168,"تعودت من زغري أشوفك","https://www.poetsgate.com/ViewPoem.aspx?id=33616",""],[592,"ألا قل لرب البيت من كان ناظماً","https://www.poetsgate.com/ViewPoem.aspx?id=128888",""],[5344,"اما تقول الخير او إلزم الصمت..","https://www.poetsgate.com/ViewPoem.aspx?id=180834",""],[5401,"ضابط الإيقاع","https://www.poetsgate.com/ViewPoem.aspx?id=78141",""],[5691,"فزاعة","https://www.poetsgate.com/ViewPoem.aspx?id=206387",""],[5764,"ست وثلاثينك","https://www.poetsgate.com/ViewPoem.aspx?id=177319",""],[5977,"باعة الورد","https://www.poetsgate.com/ViewPoem.aspx?id=214943",""]],"verses":[["لِنَهْنِ هلال العيدِ كونُك سالماً","فإنَّك في أفق المعالي هلالها",0,"ل",3,0],["لن هذا معه الهداية","لو صح فيه القول والرواية",1,"ه",1,0],["لنه قد جاء بالتنزيل","وجاء هذا بعد بالتأويل",1,"ل",1,0],["لنهبطن يثربه","بغارة منثعبه",2,"ب",2,0],["لنهضةِ الوطنْ","يا أَكرمَ الإخوانْ وأَنبلَ الفتيانْ",3,"ن",1,0],["لنهلة الماء من خديك بي ظمأٌ","وحبذا منه ماء الورد لو وردا",4,"د",2,0],["لنه جاري يصيح ها وين الشباب","كتله هبينه علصوت المؤتمن",5,"ن",1,0],["لنهيك عن لبس الخواتم ضلت","بغير دليل مستبين لزاعم",6,"م",1,0],["لنه يقول الخير ويجلب خبر سار","ومعدنه طِيب ولا لفى به توسمت",7,"ت",1,0],["لنّه وريث الزين كله جَدّ جَدّ","فيه الحلا من أصل بيته ونسبه",8,"ب",2,0],["لنهْبِ ما يمْلِكُهُ منْ ثروَةٍ","جيَّرَها لجَرْدَةِ الحِسابِ",9,"ب",1,0],["لنْها بكوم وماضي العمر في كوم","لاقبلها فرحه ولا بعدها حداد",10,"د",1,0],["لنهدي الحبّ أمي يا لروعتها","ونستقي من هواها كل سلوان",11,"ن",1,0]]}