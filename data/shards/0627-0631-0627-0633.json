{"poems":[[71,"أرأس السبط ينقل والسبايا","https://www.aldiwan.net/poem29063.html","الوافر"],[189,"سلام على الثغر الذي طال عنهده","https://www.aldiwan.net/poem14510.html","الطويل"],[463,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104469","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136120","الوافر"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115206","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94519","البسيط"],[5092,"جفاء","https://www.poetsgate.com/ViewPoem.aspx?id=182904",""],[5538,"أشم النسيم بوقت الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=142639",""]],"verses":[["أرأسَ السبطِ يُنقلُ والسبايا","يُطافُ بها وفوقَ الأرضِ فاسُ",0,"س",1,1],["أُراسل من أَهْوَى حديثا وما له","سوى غمز أجفان العيون بَريد",1,"د",1,0],["أراسلُ نابتةَ العرق منه","فضولاً ويقطع مني النخاعا",2,"ع",2,0],["أراسل منهم قاطعين وإنما","رسائل اخوان الصفا منك ترتجى",3,"ج",2,0],["أراسله فيبعث بالجواب","فيوقفني على فصل الخطاب",4,"ب",1,1],["أُراسِل الطرف وهناً ثم أعطفهُ","في متشتى ومصطافٍ ومرتادِ",5,"د",1,0],["أراسل الحيَّ مع طير الحمام وما","ألقى جواباً ولا عوداً لأطياري",6,"ر",2,0],["أراسلُ في الهوى كلُّ التجافي","وهجركِ في وصال الشوق ردُّ",7,"د",1,0],["أراسل شوقي لأرض الحجاز","فيأتي بوجد يزيد العليل",8,"ل",1,0]]}