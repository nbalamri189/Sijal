الطويل"],[46,"رآني في الكرى رجل كأني","https://www.aldiwan.net/poem22840.html","الوافر"],[46,"لقد بكرت في خفها وإزارها","https://www.aldiwan.net/poem23342.html","الطويل"],[46,"أرى جزء شهد بين أجزاء علقم","https://www.aldiwan.net/poem23365.html","الطويل"],[15,"يا صاح مهلا أقل العذل يا صاح","https://www.aldiwan.net/poem45278.html","البسيط"],[76,"نجوم في المفارق ما تغور","https://www.aldiwan.net/poem39312.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140827",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140854",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42512","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42701","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43665","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[22,"عَفَا مُسْحَلانُ عن سُلَيْمَى فَحَامِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=19750",""],[0,"أمِنْ ذِكرِ سلمَى أنْ نأتْكَ تَنوصُ","https://www.poetsgate.com/ViewPoem.aspx?id=4800",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[80,"أغُمْرَ الهوى كم ذا تُقَطّعُني عَذْلا","https://www.poetsgate.com/ViewPoem.aspx?id=3585",""],[80,"خطاب الرزايا إنه جلل الخطبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3008",""],[23,"عفتْ ذاتُ الأصابعِ فالجواءُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12796&r=&rc=0",""]],"verses":[["كَأَنَّ سِياطَها وَلَها هَبابٌ","قُلوعُ اليَمِّ زَعزَعَتِ السَفينا",0,"ن",2,0],["كَأَنَّ سَيفَكَ ضَيفُ الشَيبِ لَيسَ لَهُ","عَنِ الرُؤوسِ إِذا ما جاءَ مُنصَرَفُ",1,"ف",1,0],["كَأَنَّ سَماءَ اليَومِ ماءٌ أَثارَهُ","مِنَ اللَيلِ سَيلٌ فَالنُجومُ فَواقِعُه",2,"ه",1,0],["كانَ سَناناً يَزينُ صَعدَتَهُم","شُلَّ بِذاكَ السِنانِ مَن نَزَعَه",3,"ع",2,0],["كَأَنَّ سِقاطَ البيضِ ثُمَّ اِرتِفاعَها","مَصاريعُ أَبوابٍ تُجافُ وَتُفتَحُ",4,"ح",1,0],["كَأَنَّ سَوادَ القَلبِ طارَ بِلُبِّهِ","إِلى الطَودِ أَقنى يَنفُضُ الطَلَّ ضابِثُ",5,"ث",1,0],["كأنّ سَقيطَ الطّلِّ في الرّوْضِ والصَّبا","تَهاداهُ طِفْلٌ والخُزامَى لهُ مَهْدُ",6,"د",1,0],["كَأَنَّ سَرابَها إِذ لاحَ فيها","خِداعٌ لاحَ في وَجهِ اللَئيمِ",7,"م",1,0],["كانَ سِرّي مُكَتَّماً","وَهُوَ الآنَ قَد عَلَن",8,"ن",1,0],["كَأَنَّ سُهَيلاً في رَباوَةِ أُفقِهِ","مُسيمُ نُجومٍ حانَ مِنهُ إِيابُ",9,"ب",1,0],["كَأَنَّ سُيوفَنا فينا وَفيهِم","مَخاريقٌ بِأَيدي لاعِبينا",10,"ن",2,0],["كَأَنَّ سِباعاً فيهِ غَرقى غُدَيَّةً","بِأَرجائِهِ القُصوى أَنابيشُ عَنصُلِ",11,"ل",1,0],["كَأَنَّ سُراتَهُ وَجُدَّةَ ظَهرِهِ","كَنائِنُ يَجري بَينَهُنَّ دَليصُ",12,"ص",1,0],["كأن سماءه روض تجلى","بزهر الزهر والشوق الكمام",13,"م",1,0],["كأن سطور أفلاك الدراري","قسي والرجوم لها سهام",13,"م",1,0],["كَأَنَّ سَوالِفَ النَجُداتِ مِنها","تَقَطَّرُ بِالأَرَندَجِ وَالعَصيمِ",14,"م",1,0],["كَانَ سَركِيسُ فِي الصَّحَافَةِ إِنْ قَا","مَتْ صِعَابٌ يَرُوضُهَا فَتَهُونُ",15,"ن",1,0],["كَانَ سَركِيسُ عَالِيَ النَّفْسِ لا يَشْ","كُو وَيُشْكِي مَا اسْطَاعَ مَنْ يَسْتَعِينُ",15,"ن",1,0],["كَانَ سَركِيسُ يَمْنَحُ العُذْرَ إِلاَّ","مَنْ أَتَى بَاغِياً أُمُوراً تَشِينُ",15,"ن",1,0],["كَانَ سَمْحاً يَجْنِي القَلِيلَ وَلَكِنْ","فِيهِ فَضْلٌ يُصِيبُهُ المِسْكِينُ",15,"ن",1,0],["كَأَنَّ سِحْرٌ عَرَاهُ","كَأَنَّ سِحْراً عَرَانِي",16,"ي",1,0],["كَأَنَّ سِنانَهُ أَبَداً ضَميرٌ","فَلَيسَ لَهُ عَنِ القَلبِ اِنقِلابُ",17,"ب",1,1],["كَأَنَّ سِنانا فارِسِيّاً أَصابَني","عَلى كَبِدي بَل لَوعَةُ البَينِ أَوجَعُ",18,"ع",1,0],["كَأَنَّ سَحيقَ المِسكِ رَيّا تُرابِهِ","إِذا هَضَبتهُ بِالطِلالِ هَواضِبُه",19,"ب",2,0],["كأنَّ سِرْبَ قوافيها إذا سَنَحَتْ","طَيْرٌ على فَنَنِ الإِحسان قد صَدَحا",20,"ح",2,0],["كَأَنَّ سُيوفَ التَيمِ عيدانُ بَروَقٍ","إِذا مُلِأَت بِالصَيفِ زُبداً عُيونُها",21,"ن",3,0],["كَأَنَّ سَحيلَهُ شَكوى رَئيسٍ","يُحاذِرُ مِن سَرايا وَاِغتِيالِ",22,"ل",1,0],["كَأَنَّ سِراعَها مُتَواتِراتٍ","حَمامٌ باكِرٌ قَبلَ الحَمامِ",23,"م",1,0],["كأن سوابقها في الغبار","صقور تُعارِضُ بَيْزارها",24,"ه",2,1],["كَأَنَّ سودَ عَناقيدٍ بِلِمَّتِها","أَهدَت سُلافَتَها صِرفاً إِلى فيها",25,"ي",3,0],["كَأَنَّ سَفيناً بَينَ فَيدٍ وَحاجِزٍ","يَحُفُّ بِهِ مِن آلِ قيعانِهِ بَحرُ",26,"ر",1,0],["كَأَنَّ سَليطاً يَومَ شَدَّ بِسَيفِهِ","وَأَلقى القِناعَ الحَرِثُ بنُ أَبي شِمرِ",27,"ر",1,0],["كأنَّ سجاياهُ اللطيفةَ قهوةٌ","حبابُ حميّاها بياضُ مشيبِه",28,"ب",2,0],["كأنَّ سيوفَ سيفِ الدِّين رشت","حفافي خدّها منه لطيخ",29,"خ",1,0],["كأنَّ سنا راووقها وصبيبها","حبالُ شعاعِ الشمسِ تفتلُ باليد",30,"د",1,0],["كأَن سِناني حين وافاه كَوْكَبٌ","أصيب به قِطْعٌ من المُزْن أَقهدُ",31,"د",1,0],["كأن سنا الشَّتم في عرضه","سنا الفجر في السحَر الأغبش",32,"ش",1,0],["كَأَنَّ سِباعَ الغيلِ وَالطَيرَ تَعتَفي","مَلاحِمَ نَقّاضِ التِراتِ طَلوبِ",33,"ب",1,0],["كان سعد نجما تضيء من الشر","ق بأضواء رأيه الآفاق",34,"ق",1,0],["كأن سميّه في بردتيه","يخوض النار في الهيجا سلاما",35,"م",2,0],["كَأَنَّ سَوافِرَ الغاداتِ فيها","مَلائِكُ هَمُّها نَظَرٌ وَهَمسُ",36,"س",1,0],["كَأَنَّ سَنى الأَبواقِ في اللَيلِ بَرقُهُ","كَأَنَّ صَداها الرَعدُ لِلبَرقِ يَصحَبُ",37,"ب",1,0],["كأنَّ سَحيقَ المِسْكِ في جَنَباتها","إذا الْتَمَعَتْ تَفْري رداءَ الغَياهِبِ",38,"ب",1,0],["كَأَنَّ سَخاءَكَ الإِسلامُ تَخشى","إِذا ما حُلتَ عاقِبَةَ اِرتِدادِ",39,"د",1,0],["كَأَنَّ سُهادَ اللَيلِ يَعشَقُ مُقلَتي","فَبَينَهُما في كُلِّ هَجرٍ لَنا وَصلُ",40,"ل",1,0],["كَأَنَّ سَناها بِالعَشِيِّ لِشَربِها","تَبَلُّجُ عيسى حينَ يَلفُظُ بِالوَعدِ",41,"د",1,0],["كَأَنَّ سُقوطَ القَطرِ فيها إِذا اِنثَنى","إِلَيها سُقوطُ اللُؤلُؤِ المُتَحَدِّرِ",42,"ر",1,0],["كَأَنَّ سُهَيلاً شَخصُ ظَمآنَ جانِحٍ","مَعَ الأُفقِ في نَهيٍ مِنَ الأَرضِ يَكرَعُ",43,"ع",1,0],["كأنَّ سِرِّيَ في أحشائِه لَهَبٌ","فما تُطيقُ له طَيّاً حَواشِيها",44,"ي",3,0],["كأنَّ سِحرَ العُيونِ سَاعدَها","فدَبَّ في لَفظِها ومَعناها",45,"ا",3,0],["كأنَّ سواقيه سلاسلُ فِضَّةٍ","إذا اطَّرَدَتْ بين الصَّبا والجَنائبِ",46,"ب",1,0],["كأنَّ سيوفَه بينَ العوالي","جداولُ يطَّرِدْنَ خِلالَ غابِ",47,"ب",1,0],["كأنَّ سيوفَ الهندِ بينَ رماحِه","جداولُ في غابٍ علا وتأشَّبا",48,"ب",2,0],["كأنَّ سَجاياه من نَشْرِها","وإشراقِها عَبَقٌ في ذَكاءِ",49,"ا",2,0],["كَأَنَّ سَحيلَهُ في كُلِّ فَجرٍ","عَلى أَحساءِ يَمؤودٍ دُعاءُ",50,"ا",2,0],["كانَ سَعيُ الضِدَّ فيما بَينَنا","حاجَةً في نَفسِ يَعقوبٍ قَضاها",51,"ه",2,0],["كأن سماءَ النيلِ لم تَلقَ حادثاً","ولا قصفت فيها القواصفُ بالرعدِ",52,"د",1,0],["كأنّ سِقْطَ زنادٍ كان أوّلُهُ","لمّا تغذّى بِعُمْري في الوقودِ نما",53,"م",2,0],["كَأَنَّ سُلَيمانَ بنَ داودَ لم تُبِحْ","مخافتُه للجنّ في شَيْده مَهْلا",54,"ل",2,0],["كَأَنَّ سِهاماً أرْسِلَتْ عن قِسِيِّها","فَما عَدِمَتْ عَينُ الحَسودِ بِها سَمْلا",54,"ل",2,0],["كأنّ سَوْرَةَ كسرى عِنْد سَوْرَتِهِ","سكونُ صورةِ كسرى وهو في الكاسِ",55,"س",1,0],["كأنّ سياط التبر منهُ تَطايَرتْ","لها قِطَعٌ مما يسوق بها السُّحْبا",56,"ب",2,0],["كأنّ سكاكيناً حداداً رؤوسها","مغرّزة في فيهِ في جانِبَيْ وقْبِ",57,"ب",1,0],["كأنَّ سهامٌ لقَوسِ النوى","فرامي الفراقِ بنا مولعُ",58,"ع",1,0],["كَأَنَّ سَوابِلَ مَصيُوفَةٍ","أَقامَ بِها كُلُّ وَحشٍ هَمَل",59,"ل",1,0],["كَأَنَّ سَحيقَ المِسكِ خالَطَ طَعمَهُ","وَريهَ الخُزامى في جَديدِ القَرَنفُلي",60,"ل",2,0],["كَأَنَّ سَحابَةً تَهمى","بِماءٍ حُمِّلَت غَدَقا",61,"ق",2,0],["كَأَنَّ سَحاباً أَسحَماً تَحتَ لِبدِهِ","يُضاحِكُ عَن بَرقٍ سَرى فَتَصَدَّعا",62,"ع",2,0],["كَأَنَّ سَناها عَلى نَهرِهِ","بَقايا نَجيعٍ بِسَيفٍ صَقيلِ",63,"ل",1,0],["كَأَنَّ سُمرَ القَنا في كَفِّهِ قُضُبٌ","تَلوحُ مِن فَوقِها الهاماتُ كَالثَمَرِ",64,"ر",1,0],["كَأَنَّ سَقِيطَ الثَلجِ ما حَصَّبَت بِهِ","عَلى الأَرضِ عَصب أَو دَقيقٌ مُغَربَلُ",65,"ل",1,0],["كَأَنَّ سُلَيمانَ النَبِيَّ أَطارَهُ","بِحَنّانَةٍ تَنضو الرِياحَ عَقيمِ",66,"م",1,0],["كَأَنَّ سُلافَ الخَمرِ مِن ماءِ خَدِّهِ","وَعُنقودَها مِن شَعرِهِ الغَضِّ يُقطَفُ",67,"ف",1,0],["كَأَنَّ سَماءَها لَمّا تَجَلَّت","خِلالَ نُجومِها عِندَ الصَباحِ",68,"ح",1,0],["كانَ سِرّاً في ضَمِيرِ الغَيْبِ مِنْ","قَبْلِ أَنْ يُخْلَقَ كَوْنٌ أَوْ يكونا",69,"ن",2,0],["كأنّ سُهَيْلاً في مطالِعِ أُفقهِ","مُفارِقُ إلْفٍ لم يَجِدْ بعدَه إلفا",70,"ف",2,0],["كأنّ سُهاها عاشِقٌ بين عُوَّدٍ","فآوِنَةً يَبدو وآونَةً يَخْفى",70,"ف",2,0],["كأنّ سِراعَ النُّجْبِ تُنشَرُ يَمْنَةً","على البِيدِ آلٌ في الضّحى يترفّع",71,"ع",1,0],["كَأَنَّ سُطوراً فَوقَها فارِسِيَّةً","تَكادُ وَإِن طالَ الزَمانُ تَبينُ",72,"ن",1,0],["كَأَنَّ سَبيئَةً في الرَأسِ مِنها","بِبَيتِ فَمٍ سَبيئَةُ بَيتِ راسِ",73,"س",1,0],["كَأَنَّ سَحاباً عَمَّهُم بِضَلالَةٍ","فَلَيسَ إِلى يَومِ القِيامَةِ مُنجِما",74,"م",2,0],["كَأَنَّ سُرورَ النَفسِ مِن خَطَأ الفَتى","مَتى ما يَكُن يُنكَر عَلَيهِ وَيُنقَمِ",75,"م",1,0],["كَأَنَّ سُنَّتَها في كُلِّ داجِيَةٍ","حينَ الظَلامُ بَهيمٌ ضَوءُ مِصباحِ",76,"ح",1,0],["كأنَّ سَوادَ لِمَّتهِ ظَلامٌ","أغارَ مِنَ المَشيبِ عَليْهِ نُورُ",77,"ر",1,0],["كان سقراط أثبتَ القوم جأشاً","فهو ذو عزمٍ فائقٍ لا يخور",78,"ر",1,0],["كأن سهاد العين يعشق مقلتي","فبينهما في كل هجرٍ لنا وصل",79,"ل",1,0],["كأن سخاءك الإسلام؛ تخشى","متى ما حلت عاقبة ارتداد",80,"د",1,0],["كأن سليمانَ أخلَى القماقمَ","أو فَكَّ عن جنهنَّ اعتقالا",81,"ل",2,0],["كأَنَّ سَنا نارَيْهِما كُلَّ شَتْوَةٍ","سَنا البَرْقِ يَبْدُو للعُيُونِ النواظِرِ",82,"ر",1,0],["كأنّ سِناناً رامَها خَطَّ قادِرٌ","عليه بَعيدٌ من أذى القِرْنِ يائس",83,"س",1,0],["كأنّ سَنا الفَجْرَينِ لمّا تَوالَيا","دمُ الأخَوَين زَعْفَرانٍ وأيْدَع",84,"ع",1,0],["كَأَنَّ سَنَا الْكاساتِ والنَّدُّ سَاطِعٌ","نُجُومٌ تَراءَتْ مِنْ خِلالِ ضَبابِ",85,"ب",1,0],["كَأَنَّ سُلَيْمَانَ بْنَ دَاوُدَ فَوْقَهُ","عَلَى عَرْشِهِ وَالْجِنُّ بِالْجِنِّ تَعْزِفُ",86,"ف",1,0],["كَانَ سُلْطَانُ هُوَ الْكَا","فِي حِمَاهُ مَا يَهِمُّ",87,"م",1,0],["كَانَ سُلوَانَهَا رَجَاءُ تَلاَقٍ","أَيْنَ أَمْسَى مِنْهَا رَجَاءُ التّلاَقِي",88,"ق",2,0],["كَأَنَّ سَمْعَانَ لمْ يَلْحَقْ بِمَنْ سَلَفَا","يا سَعْدَ مَنْ فِي بَنِيهِ أُوتِيَ الخَلَفَا",89,"ف",2,1],["كَانَ سَمْعَانُ بَانِيهِ كَعَادَتِهِ","وَكَمْ لِسَمْعانَ مَعْرُوفُ بِهِ عُرِفا",90,"ف",2,0],["كَانَ سَيْفاً لِقَوْمِهِ مِنْ سُيُوفٍ","عَرَفَ القَوْمُ كُرْهَهَا لِلغُمُودِ",91,"د",1,0],["كانَ سَيفاً في يَدي ذَكَراً","لَو قَتَلتُ الفيلَ طُلَّ بِهِ",92,"ه",1,0],["كأنّ سيوفَكَ الأقدارُ تجرْي","بِما شاءَ الإله على العِبَادِ",93,"د",1,0],["كان سعدٌ عَلَماً منفرداً","هل يُرَى للشمس في الأفْقِ تَنين",94,"ن",1,0],["كأنّ سليحاً نشَّرتْ فيه بزَّها","بُرُوداً ورَقْماً فاتَكَ البَيْعَ تاجِرُهْ",95,"ر",2,0],["كَأنّ سَرَاتَهُ وَجُدّة َ ظَهْرِهِ","كنائنُ يرجي بينهنَ دليصُ",96,"ص",1,0],["كأن سُيُوفنا منا ومنهُم","مخاريقٌ بأيدي لاعبينا",97,"ن",2,0],["كأن سهماً أُرسلتْ عن قسيّها","فما عَدمتْ عينُ الحسود بها سَملا",98,"ل",2,0],["كأنَّ سكاكيناً حدادا رؤوسها","مغززة في فيهِ في جانبي وقب",99,"ب",1,0],["كَأنّ سَبِيئَة ً مِنْ بَيْتِ رَأسٍ،","تُعفيِّها الرّوَامِسُ والسّمَاءُ",100,"ا",2,0]]}