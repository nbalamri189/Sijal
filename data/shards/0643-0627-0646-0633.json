471.html","الوافر"],[301,"كان سمعي في مصر بالشيخ فتح الدين","https://www.aldiwan.net/poem57666.html","الخفيف"],[320,"أرقت وصاحباي ببعلبك","https://www.aldiwan.net/poem56348.html","الوافر"],[326,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[335,"أعائش ما لأهلك لا أراهم","https://www.aldiwan.net/poem45426.html","الوافر"],[351,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[351,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[361,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[362,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[362,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[363,"ألمم بسلمى قبل أن تظعنا","https://www.aldiwan.net/poem44476.html","السريع"],[374,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[400,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[400,"أحبتنا إن تفضلوا بسؤال","https://www.aldiwan.net/poem33601.html","الطويل"],[403,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[406,"قد كنت أسمع لكن خلته مثلا","https://www.aldiwan.net/poem31866.html","البسيط"],[413,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[426,"رعى الله ربعا زاد فيه سروره","https://www.aldiwan.net/poem40855.html","الطويل"],[436,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[438,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[438,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[450,"لعينيك في الأحشاء ما نفث السحر","https://www.aldiwan.net/poem13762.html","الطويل"],[450,"سقت مستهلات الحيا المتضاعف","https://www.aldiwan.net/poem13843.html","الطويل"],[451,"تنادينا بنكهتها فهيا","https://www.aldiwan.net/poem61298.html","الوافر"],[456,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[456,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[456,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[456,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[456,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[459,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[459,"ضروب بحدي رأيه وحسامه","https://www.aldiwan.net/poem15479.html","الطويل"],[459,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[459,"تود رياض الحزن وهي أنيقة","https://www.aldiwan.net/poem16355.html","الطويل"],[466,"قسا فأصبح لا يرثي لمهجور","https://www.aldiwan.net/poem60011.html","البسيط"],[493,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[541,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[549,"من رأى لي في الدجى ذا خطل","https://www.aldiwan.net/poem47224.html","الرمل"]],"verses":[["كَأَنَّ سِياطَها وَلَها هَبابٌ","قُلوعُ اليَمِّ زَعزَعَتِ السَفينا",0,"ن",2,0],["كَأَنَّ سَيفَكَ ضَيفُ الشَيبِ لَيسَ لَهُ","عَنِ الرُؤوسِ إِذا ما جاءَ مُنصَرَفُ",1,"ف",1,0],["كَأَنَّ سَماءَ اليَومِ ماءٌ أَثارَهُ","مِنَ اللَيلِ سَيلٌ فَالنُجومُ فَواقِعُه",2,"ه",1,0],["كانَ سَناناً يَزينُ صَعدَتَهُم","شُلَّ بِذاكَ السِنانِ مَن نَزَعَه",3,"ع",2,0],["كَأَنَّ سِقاطَ البيضِ ثُمَّ اِرتِفاعَها","مَصاريعُ أَبوابٍ تُجافُ وَتُفتَحُ",4,"ح",1,0],["كَأَنَّ سَوادَ القَلبِ طارَ بِلُبِّهِ","إِلى الطَودِ أَقنى يَنفُضُ الطَلَّ ضابِثُ",5,"ث",1,0],["كأنّ سَقيطَ الطّلِّ في الرّوْضِ والصَّبا","تَهاداهُ طِفْلٌ والخُزامَى لهُ مَهْدُ",6,"د",1,0],["كَأَنَّ سَرابَها إِذ لاحَ فيها","خِداعٌ لاحَ في وَجهِ اللَئيمِ",7,"م",1,0],["كانَ سِرّي مُكَتَّماً","وَهُوَ الآنَ قَد عَلَن",8,"ن",1,0],["كَأَنَّ سُهَيلاً في رَباوَةِ أُفقِهِ","مُسيمُ نُجومٍ حانَ مِنهُ إِيابُ",9,"ب",1,0],["كَأَنَّ سُيوفَنا فينا وَفيهِم","مَخاريقٌ بِأَيدي لاعِبينا",10,"ن",2,0],["كَأَنَّ سِباعاً فيهِ غَرقى غُدَيَّةً","بِأَرجائِهِ القُصوى أَنابيشُ عَنصُلِ",11,"ل",1,0],["كَأَنَّ سُراتَهُ وَجُدَّةَ ظَهرِهِ","كَنائِنُ يَجري بَينَهُنَّ دَليصُ",12,"ص",1,0],["كأن سماءه روض تجلى","بزهر الزهر والشوق الكمام",13,"م",1,0],["كأن سطور أفلاك الدراري","قسي والرجوم لها سهام",13,"م",1,0],["كَأَنَّ سَوالِفَ النَجُداتِ مِنها","تَقَطَّرُ بِالأَرَندَجِ وَالعَصيمِ",14,"م",1,0],["كَانَ سَركِيسُ فِي الصَّحَافَةِ إِنْ قَا","مَتْ صِعَابٌ يَرُوضُهَا فَتَهُونُ",15,"ن",1,0],["كَانَ سَركِيسُ عَالِيَ النَّفْسِ لا يَشْ","كُو وَيُشْكِي مَا اسْطَاعَ مَنْ يَسْتَعِينُ",15,"ن",1,0],["كَانَ سَركِيسُ يَمْنَحُ العُذْرَ إِلاَّ","مَنْ أَتَى بَاغِياً أُمُوراً تَشِينُ",15,"ن",1,0],["كَانَ سَمْحاً يَجْنِي القَلِيلَ وَلَكِنْ","فِيهِ فَضْلٌ يُصِيبُهُ المِسْكِينُ",15,"ن",1,0],["كَأَنَّ سِحْرٌ عَرَاهُ","كَأَنَّ سِحْراً عَرَانِي",16,"ي",1,0],["كَأَنَّ سِنانَهُ أَبَداً ضَميرٌ","فَلَيسَ لَهُ عَنِ القَلبِ اِنقِلابُ",17,"ب",1,1],["كَأَنَّ سِنانا فارِسِيّاً أَصابَني","عَلى كَبِدي بَل لَوعَةُ البَينِ أَوجَعُ",18,"ع",1,0],["كَأَنَّ سَحيقَ المِسكِ رَيّا تُرابِهِ","إِذا هَضَبتهُ بِالطِلالِ هَواضِبُه",19,"ب",2,0],["كأنَّ سِرْبَ قوافيها إذا سَنَحَتْ","طَيْرٌ على فَنَنِ الإِحسان قد صَدَحا",20,"ح",2,0],["كَأَنَّ سُيوفَ التَيمِ عيدانُ بَروَقٍ","إِذا مُلِأَت بِالصَيفِ زُبداً عُيونُها",21,"ن",3,0],["كَأَنَّ سَحيلَهُ شَكوى رَئيسٍ","يُحاذِرُ مِن سَرايا وَاِغتِيالِ",22,"ل",1,0],["كَأَنَّ سِراعَها مُتَواتِراتٍ","حَمامٌ باكِرٌ قَبلَ الحَمامِ",23,"م",1,0],["كأن سوابقها في الغبار","صقور تُعارِضُ بَيْزارها",24,"ه",2,1],["كَأَنَّ سودَ عَناقيدٍ بِلِمَّتِها","أَهدَت سُلافَتَها صِرفاً إِلى فيها",25,"ي",3,0],["كَأَنَّ سَفيناً بَينَ فَيدٍ وَحاجِزٍ","يَحُفُّ بِهِ مِن آلِ قيعانِهِ بَحرُ",26,"ر",1,0],["كَأَنَّ سَليطاً يَومَ شَدَّ بِسَيفِهِ","وَأَلقى القِناعَ الحَرِثُ بنُ أَبي شِمرِ",27,"ر",1,0],["كأنَّ سجاياهُ اللطيفةَ قهوةٌ","حبابُ حميّاها بياضُ مشيبِه",28,"ب",2,0],["كأنَّ سيوفَ سيفِ الدِّين رشت","حفافي خدّها منه لطيخ",29,"خ",1,0],["كأنَّ سنا راووقها وصبيبها","حبالُ شعاعِ الشمسِ تفتلُ باليد",30,"د",1,0],["كأَن سِناني حين وافاه كَوْكَبٌ","أصيب به قِطْعٌ من المُزْن أَقهدُ",31,"د",1,0],["كأن سنا الشَّتم في عرضه","سنا الفجر في السحَر الأغبش",32,"ش",1,0],["كَأَنَّ سِباعَ الغيلِ وَالطَيرَ تَعتَفي","مَلاحِمَ نَقّاضِ التِراتِ طَلوبِ",33,"ب",1,0],["كان سعد نجما تضيء من الشر","ق بأضواء رأيه الآفاق",34,"ق",1,0],["كأن سميّه في بردتيه","يخوض النار في الهيجا سلاما",35,"م",2,0],["كَأَنَّ سَوافِرَ الغاداتِ فيها","مَلائِكُ هَمُّها نَظَرٌ وَهَمسُ",36,"س",1,0],["كَأَنَّ سَنى الأَبواقِ في اللَيلِ بَرقُهُ","كَأَنَّ صَداها الرَعدُ لِلبَرقِ يَصحَبُ",37,"ب",1,0],["كأنَّ سَحيقَ المِسْكِ في جَنَباتها","إذا الْتَمَعَتْ تَفْري رداءَ الغَياهِبِ",38,"ب",1,0],["كَأَنَّ سَخاءَكَ الإِسلامُ تَخشى","إِذا ما حُلتَ عاقِبَةَ اِرتِدادِ",39,"د",1,0],["كَأَنَّ سُهادَ اللَيلِ يَعشَقُ مُقلَتي","فَبَينَهُما في كُلِّ هَجرٍ لَنا وَصلُ",40,"ل",1,0],["كَأَنَّ سَناها بِالعَشِيِّ لِشَربِها","تَبَلُّجُ عيسى حينَ يَلفُظُ بِالوَعدِ",41,"د",1,0],["كَأَنَّ سُقوطَ القَطرِ فيها إِذا اِنثَنى","إِلَيها سُقوطُ اللُؤلُؤِ المُتَحَدِّرِ",42,"ر",1,0],["كَأَنَّ سُهَيلاً شَخصُ ظَمآنَ جانِحٍ","مَعَ الأُفقِ في نَهيٍ مِنَ الأَرضِ يَكرَعُ",43,"ع",1,0],["كأنَّ سِرِّيَ في أحشائِه لَهَبٌ","فما تُطيقُ له طَيّاً حَواشِيها",44,"ي",3,0],["كأنَّ سِحرَ العُيونِ سَاعدَها","فدَبَّ في لَفظِها ومَعناها",45,"ا",3,0],["كأنَّ سواقيه سلاسلُ فِضَّةٍ","إذا اطَّرَدَتْ بين الصَّبا والجَنائبِ",46,"ب",1,0],["كأنَّ سيوفَه بينَ العوالي","جداولُ يطَّرِدْنَ خِلالَ غابِ",47,"ب",1,0],["كأنَّ سيوفَ الهندِ بينَ رماحِه","جداولُ في غابٍ علا وتأشَّبا",48,"ب",2,0],["كأنَّ سَجاياه من نَشْرِها","وإشراقِها عَبَقٌ في ذَكاءِ",49,"ا",2,0],["كَأَنَّ سَحيلَهُ في كُلِّ فَجرٍ","عَلى أَحساءِ يَمؤودٍ دُعاءُ",50,"ا",2,0],["كانَ سَعيُ الضِدَّ فيما بَينَنا","حاجَةً في نَفسِ يَعقوبٍ قَضاها",51,"ه",2,0],["كأن سماءَ النيلِ لم تَلقَ حادثاً","ولا قصفت فيها القواصفُ بالرعدِ",52,"د",1,0],["كأنّ سِقْطَ زنادٍ كان أوّلُهُ","لمّا تغذّى بِعُمْري في الوقودِ نما",53,"م",2,0],["كَأَنَّ سُلَيمانَ بنَ داودَ لم تُبِحْ","مخافتُه للجنّ في شَيْده مَهْلا",54,"ل",2,0],["كَأَنَّ سِهاماً أرْسِلَتْ عن قِسِيِّها","فَما عَدِمَتْ عَينُ الحَسودِ بِها سَمْلا",54,"ل",2,0],["كأنّ سَوْرَةَ كسرى عِنْد سَوْرَتِهِ","سكونُ صورةِ كسرى وهو في الكاسِ",55,"س",1,0],["كأنّ سياط التبر منهُ تَطايَرتْ","لها قِطَعٌ مما يسوق بها السُّحْبا",56,"ب",2,0],["كأنّ سكاكيناً حداداً رؤوسها","مغرّزة في فيهِ في جانِبَيْ وقْبِ",57,"ب",1,0],["كأنَّ سهامٌ لقَوسِ النوى","فرامي الفراقِ بنا مولعُ",58,"ع",1,0],["كَأَنَّ سَوابِلَ مَصيُوفَةٍ","أَقامَ بِها كُلُّ وَحشٍ هَمَل",59,"ل",1,0],["كَأَنَّ سَحيقَ المِسكِ خالَطَ طَعمَهُ","وَريهَ الخُزامى في جَديدِ القَرَنفُلي",60,"ل",2,0],["كَأَنَّ سَحابَةً تَهمى","بِماءٍ حُمِّلَت غَدَقا",61,"ق",2,0],["كَأَنَّ سَحاباً أَسحَماً تَحتَ لِبدِهِ","يُضاحِكُ عَن بَرقٍ سَرى فَتَصَدَّعا",62,"ع",2,0],["كَأَنَّ سَناها عَلى نَهرِهِ","بَقايا نَجيعٍ بِسَيفٍ صَقيلِ",63,"ل",1,0],["كَأَنَّ سُمرَ القَنا في كَفِّهِ قُضُبٌ","تَلوحُ مِن فَوقِها الهاماتُ كَالثَمَرِ",64,"ر",1,0],["كَأَنَّ سَقِيطَ الثَلجِ ما حَصَّبَت بِهِ","عَلى الأَرضِ عَصب أَو دَقيقٌ مُغَربَلُ",65,"ل",1,0],["كَأَنَّ سُلَيمانَ النَبِيَّ أَطارَهُ","بِحَنّانَةٍ تَنضو الرِياحَ عَقيمِ",66,"م",1,0],["كَأَنَّ سُلافَ الخَمرِ مِن ماءِ خَدِّهِ","وَعُنقودَها مِن شَعرِهِ الغَضِّ يُقطَفُ",67,"ف",1,0],["كَأَنَّ سَماءَها لَمّا تَجَلَّت","خِلالَ نُجومِها عِندَ الصَباحِ",68,"ح",1,0],["كانَ سِرّاً في ضَمِيرِ الغَيْبِ مِنْ","قَبْلِ أَنْ يُخْلَقَ كَوْنٌ أَوْ يكونا",69,"ن",2,0],["كأنّ سُهَيْلاً في مطالِعِ أُفقهِ","مُفارِقُ إلْفٍ لم يَجِدْ بعدَه إلفا",70,"ف",2,0],["كأنّ سُهاها عاشِقٌ بين عُوَّدٍ","فآوِنَةً يَبدو وآونَةً يَخْفى",70,"ف",2,0],["كأنّ سِراعَ النُّجْبِ تُنشَرُ يَمْنَةً","على البِيدِ آلٌ في الضّحى يترفّع",71,"ع",1,0],["كَأَنَّ سُطوراً فَوقَها فارِسِيَّةً","تَكادُ وَإِن طالَ الزَمانُ تَبينُ",72,"ن",1,0],["كَأَنَّ سَبيئَةً في الرَأسِ مِنها","بِبَيتِ فَمٍ سَبيئَةُ بَيتِ راسِ",73,"س",1,0],["كَأَنَّ سَحاباً عَمَّهُم بِضَلالَةٍ","فَلَيسَ إِلى يَومِ القِيامَةِ مُنجِما",74,"م",2,0],["كَأَنَّ سُرورَ النَفسِ مِن خَطَأ الفَتى","مَتى ما يَكُن يُنكَر عَلَيهِ وَيُنقَمِ",75,"م",1,0],["كَأَنَّ سُنَّتَها في كُلِّ داجِيَةٍ","حينَ الظَلامُ بَهيمٌ ضَوءُ مِصباحِ",76,"ح",1,0],["كأنَّ سَوادَ لِمَّتهِ ظَلامٌ","أغارَ مِنَ المَشيبِ عَليْهِ ن