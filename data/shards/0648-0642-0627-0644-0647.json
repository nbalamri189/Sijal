{"poems":[[53,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[91,"ما انت يا احمد في دولة الادب","https://www.aldiwan.net/poem44620.html","البسيط"],[50,"اختصم الجود والجمال","https://www.aldiwan.net/poem65039.html","مجزوء البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[113,"نبهته ودواعي الأنس داعية","https://www.aldiwan.net/poem16384.html","البسيط"],[119,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[139,"من بعد حمزة يحمي حوزة الأدب","https://www.aldiwan.net/poem49177.html","البسيط"],[228,"في ليلة حالكة كالهموم","https://www.aldiwan.net/poem39701.html","السريع"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"بكيت حتى لان بعد قسوة","https://www.aldiwan.net/poem58152.html","الرجز"],[369,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[376,"ودعته والدمع في مقلتي","https://www.aldiwan.net/poem57323.html","السريع"],[408,"وصاحب أنشدني مرة","https://www.aldiwan.net/poem46473.html","السريع"],[409,"فأغضب الكرم إذ بالفخر قد هدرت","https://www.aldiwan.net/poem33442.html","البسيط"],[409,"وشادن وافى إلى منهل","https://www.aldiwan.net/poem33984.html","السريع"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[505,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66763","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77580","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77484","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77645","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77497","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77602","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12009","البسيط"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76802","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76803","الطويل"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202378","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102501","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102503","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124603","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140068",""],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118928","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132596","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86337","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199174","المجتث"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35569","المجتث"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94546","الوافر"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122444","الرجز"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4679,"تساءلت هرة وكلبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=142776",""],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""]],"verses":[["وقالة السوء غير راجعة","يوماً إذا نوهت بها السُمَع",0,"ع",1,0],["وقالة الشعر ان نذكر منازلهم","فانت في الرأس والباقون في الذنب",1,"ب",1,0],["وَقالَ هَذا وَوَجهُهُ لي","لِلحُسنِ وَالظُرفِ وَالكَمال",2,"ل",1,0],["وَقالَ هَذَا مُكْسِبِي","لا شكَّ إِعْجَابَ البَشَرْ",3,"ر",1,0],["وَقالَ هاتَ وَخُذها وَاِنتَهَز فُرَصاً","فَلَن تَرى لِزَمان يَنقَضي خَلَفا",4,"ف",2,0],["وقال هلا وصلتم بعد صدكم","لطفاً ليشفي الجوى الفاني من السقم",5,"م",1,0],["وقال هات المسمَّى وهو مجتلبٌ","وخذ من اللغة اسماً غير مجتلبِ",6,"ب",1,0],["وَقالَ هل يُرجى لَه آخِرُ","هذا الدُجى الغارِقُ في ثورَتِه",7,"ه",1,0],["وَقال هَذا الخِلُّ","جَفاهُ لا يحِلُّ",8,"ل",1,0],["وقال ها نحن سواءٌ في البكا","لا يا حبيبي ما بكانا واحدُ",9,"د",1,0],["وقال هذا وَداعي فاستَعِرْ جَزعاً","من وَشْكِ فُرقتِنا أو فاستَعِرْ جَلَدا",10,"د",2,0],["وقالَ هَذا قبلَ يَوم النَّوى","فَما تَرى بَعد النَّوى تَصنَعُ",11,"ع",1,0],["وقَالَ هَل أبصرت مِثلاً لَهُ","ما بينَ أَشعارِ الورى طُراً",12,"ر",2,0],["وقال هل منصف في الناس أقصده","للحكم ما بيننا فالشرع مهتضم",13,"م",1,0],["وقال هل تسبح يا مالِكِي","قلت نعم في أدمعي أسبح",14,"ح",1,0],["وقال هبِ الجزيرةَ لي وإلا","فهذا السيف فاسمح لي وهبني",15,"ن",2,0],["وقالَ هلْ تُبْذَلُ الأرواحُ راضيةً","منكمْ على نَظرَةٍ بيضاءَ أُبْديها",16,"ي",3,0],["وقال هنا فيكمُْ خَليفتي","ومن عليه في الأمورِ المتَّكَلْ",17,"ل",1,0],["وَقالَ هاتيك لِغَير الصاحِبه","تِلكَ قباح الوَجه وَصفاً وَشبه",18,"ه",1,0],["وَقالَ هَذا حصرمٌ","رَأَيتهُ في حَلَبِ",19,"ب",1,0],["وَقالَ هَذا رزقُ يَومٍ واحد","عافِيتي قَد حصَّلتهُ وَيَدي",20,"ي",1,0],["وَقالَ هَذا مَوضع الغَريم","الخائن اِبن الخائن اللَئيم",21,"م",1,0],["وَقالَ هَل تَعرف هَذي الفاسا","وَلا تَرى بِغَيرِها التِباسا",22,"س",2,0],["وَقالَ هَذا سَبب البُكاء","لَيس بِه عَلي من خفاء",23,"ا",2,0],["وقال هذا الحياء يا بأبي","أنت بريد النكول والفشل",24,"ل",1,0],["وَقالَ هَيّا فَقَد لاحَ الصَباحُ وَقَد","طابَ الصَبوحُ عَلى رَوحٍ وَرَيحانِ",25,"ن",1,0],["وقال هلا التبليغ عني ينبغي","لمن ليس من بيتي فبالقوم فاقتد",26,"د",1,0],["وقال هما يرحانتاي أحب من","أحبهما فاصدقهما الحب تسعد",27,"د",1,0],["وقال هذا الذي أرضاه من ولدي","لكم رئيسا اذا ما اجتاحني سحبي",28,"ب",2,0],["وقاله ابن أبي الحب الإمام وفي","ما ألف الجنديّ الحبر تزكيتي",29,"ي",1,0],["وقاله ابن أبي حبّ مع الجندي","ولابن حسان قول قد شفى علل",30,"ل",1,0],["وقال هذا أبو عباد عمدتنا","مقال من اتصف في القول من خطل",30,"ل",1,0],["وقالها الشُّولي إلى كُمَهري","مِن كُولَمَ العقربُ فاحزِم وآجرِ",31,"ر",1,0],["وقاله جمع أهل العلم قاطبةً","وفي حديث النبي المصطفى جانا",32,"ن",2,0],["وَقالَ هذا الشاه قَد أَحبَّكُم","وَإِنَّهُ الآن يُريد صُلحَكُم",33,"م",1,0],["وقال هذا طبل باز له","صوت إذا ازمعت الحمله",34,"ل",2,0],["وقال هذا عاش بي مغرَما","وحُبّه إيّاي كم عذّبه",35,"ب",2,0],["وقال هذا معجز الباري فمن","منكم يباري سورة من السور",36,"ر",1,0],["وَقالَ هو الحبُّ الَّذي في قضائِهِ","تَرى الكُل مَأخوذاً بِما في الهَوى جَنى",37,"ن",2,0],["وقاله حسنٌ مَنْ","أرض الحجاز حوته",38,"ت",2,0],["وَقالَ هَذا بِهَذا","إِنَّ الجُروح قصاصُ",39,"ص",1,0],["وقال هلمَّ يا بدر المعالي","بغيرك لا تضيء سما الوزارَه",40,"ر",2,0],["وقال هذا لكُمُ وليا","من بعدُ إذ كان بكُم حَفِيّا",41,"ي",2,0],["وقال هزِّي تنالي من جنى الرطب","جلَّ الإله الذي ما ردَّ كلمته",42,"ه",1,0],["وقال هذا لولا أتضاهي","لما رضيت الضرغام مولى",43,"ل",2,0],["وقال هيا ارفعوا في جوفها حجراً","من يمسك الثوب بالأكمام يغتنم",44,"م",1,0],["وقال هم يرثون الأنبياء كذا","فيهم رُوينا أحاديثاً وأخبار",45,"ر",1,0]]}