{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[61,"ألا غادها مخطئا أو مصيبا","https://www.aldiwan.net/poem51792.html","المتقارب"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[80,"شموس دعاهن وشك الفراق","https://www.aldiwan.net/poem31415.html","المتقارب"],[44,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[108,"تلقائي","https://www.poetsgate.com/ViewPoem.aspx?id=8382",""],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[229,"ظلموا البين والنوى والرقيبا","https://www.aldiwan.net/poem51215.html","الخفيف"],[365,"ألا غدرت بنو أعلى قديما","https://www.aldiwan.net/poem44513.html","الوافر"],[377,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[403,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[452,"ألا غب إهداء السلام تحية","https://www.aldiwan.net/poem13792.html","الطويل"],[461,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[529,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"]],"verses":[["أَلا غَنِّياني بِالدِيارِ فَإِنَّني","أُحِبُّ زَروداً ما أَقامَ ثَراها",0,"ا",3,0],["أَلا غَنِّياني بِالحَديثِ فَإِنَّني","رَأَيتُ أَلَذَّ القَولِ ما كانَ يُطرِبُ",1,"ب",1,0],["ألا غارمٌ صفحاً ليغنم سُؤدداً","وحمداً وأجراً إنَّ ذا الغُنْمِ غارمُ",2,"م",1,0],["إلا غانمٌ أحدوثَةَ الصِّدقِ في الورى","بغُرم الأيادي إن ذا الغُرْمِ غانمُ",2,"م",1,0],["الأغاني تصبي ولست بدار","أي شيء فيها من الأسرار",3,"ر",1,1],["الأَغَرُّ الوَضّاحُ توري يَداهُ","حينَ يَكبو زَندُ الأَغَمِّ البَهيمِ",4,"م",1,0],["ألا غَادِها مُخطِئاً أو مُصِيباً","وسِرْ نحوَها داعياً أو مجيبا",5,"ب",2,1],["أَلا غَرَّتِ الدُنيا رِجالاً عَهِدتَهُم","أَلا رُبَّما راحوا عَلَيها وَأَدلَجوا",6,"ج",3,0],["ألا غَفلَةٌ من رَقِيبٍ عَتِيدٍ","يُلاحِظنا نَظْرَةَ الأشوَسِ",7,"س",1,0],["أَلا غَربُ دَمعٍ ناصِرٍ لي عَلى الأَسى","أَلا حُرُّ شِعرٍ في الغَليلِ مُساعِدي",8,"د",2,0],["أَلا غَنِّيا لي بِالصَهيلِ فَإِنَّهُ","سَماعي وَرَقراقُ الدِماءِ نِدامي",9,"ي",1,0],["ألا غنمٌ هناك لها ثُغَاءُ","ولا بقرٌ هناكَ له خُوَار؟",10,"ر",1,0],["الاغلب ؟ على أمتان تجربتي صعد","عرته سلوبي وأعتطا عاريّتي",11,"ت",2,0],["أَلا غَيرةٌ كالشامِ أَشكرُكم بها","فَلَستُ أؤدّي ما حييتُ لَها شُكرا",12,"ر",2,0],["الأغَرَّ البهي الكريمَ المواسي ال","مُرْتَجَى الماجدَ الأريبَ الأديبا",13,"ب",2,0],["أَلا غَدَرَت بنو أعلى قديماً","وأَنعُمُ إِنّها وُدُقُ المَزَادِ",14,"د",1,1],["إلّا غدونا بخمر المدح في طربٍ","ما بين صاحٍ وشخصٍ بالهوى ثَمَل",15,"ل",1,0],["ألا غاضب للّه إذ ضاع دينه","يسوق جنوداً إِثْرَهُنَّ جنود",16,"د",1,0],["ألا غيرةٌ تقضي المنازل حقَّها","وتوقظ وسنان التراب خيولها",17,"ه",2,0],["ألاَ غِبَّ إِهداء السلام تحيةً","كعَرْفِ الشذا العطري بَلْ هي أعطر",18,"ر",1,1],["ألا غنياني بالصهيل فإنه","سَماعي ورقْراق الدماء مُدامي",19,"م",2,0],["ألا غاضِبٌ يَوْماً لِسُنَّةِ أَحْمَدٍ","فَمَنْ كانَ مَنْشُوداً فإنِّي ناشِدُهْ",20,"د",2,0],["ألا غادِ دمعَ العينِ إنْ كنتَ غاديا","فلستُ ألومُ اليومَ بعدك باكيا",21,"ي",2,1],["ألا غنّياني بقرع السّيوفِ","فَما غيرُها أبداً مُطربي",22,"ب",2,0]]}