{"poems":[[55,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[55,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[47,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[63,"ألا غادها مخطئا أو مصيبا","https://www.aldiwan.net/poem51792.html","المتقارب"],[51,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[82,"شموس دعاهن وشك الفراق","https://www.aldiwan.net/poem31415.html","المتقارب"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[112,"تلقائي","https://www.poetsgate.com/ViewPoem.aspx?id=8382",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[234,"ظلموا البين والنوى والرقيبا","https://www.aldiwan.net/poem51215.html","الخفيف"],[370,"ألا غدرت بنو أعلى قديما","https://www.aldiwan.net/poem44513.html","الوافر"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[409,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[457,"ألا غب إهداء السلام تحية","https://www.aldiwan.net/poem13792.html","الطويل"],[466,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[534,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[556,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130870","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96611","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55943","الطويل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130635","الكامل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131559",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53074","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100325","الطويل"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130607","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109955","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114197","الكامل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130602","الوافر"],[4755,"لا شَيءَ بَينَ الرّأسِ والوَرَقَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=197779",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5458,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=72286",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5956,"الأغلَيان تُوُفِّيا وفتاهما..","https://www.poetsgate.com/ViewPoem.aspx?id=183597",""],[5956,"الأغلَيان تُوُفِّيا وبنوهما..","https://www.poetsgate.com/ViewPoem.aspx?id=197926",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[5014,"غريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76217&r=&rc=13",""],[6273,"دانة النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78508&r=&rc=6",""]],"verses":[["أَلا غَنِّياني بِالدِيارِ فَإِنَّني","أُحِبُّ زَروداً ما أَقامَ ثَراها",0,"ا",3,0],["أَلا غَنِّياني بِالحَديثِ فَإِنَّني","رَأَيتُ أَلَذَّ القَولِ ما كانَ يُطرِبُ",1,"ب",1,0],["ألا غارمٌ صفحاً ليغنم سُؤدداً","وحمداً وأجراً إنَّ ذا الغُنْمِ غارمُ",2,"م",1,0],["إلا غانمٌ أحدوثَةَ الصِّدقِ في الورى","بغُرم الأيادي إن ذا الغُرْمِ غانمُ",2,"م",1,0],["الأغاني تصبي ولست بدار","أي شيء فيها من الأسرار",3,"ر",1,1],["الأَغَرُّ الوَضّاحُ توري يَداهُ","حينَ يَكبو زَندُ الأَغَمِّ البَهيمِ",4,"م",1,0],["ألا غَادِها مُخطِئاً أو مُصِيباً","وسِرْ نحوَها داعياً أو مجيبا",5,"ب",2,1],["أَلا غَرَّتِ الدُنيا رِجالاً عَهِدتَهُم","أَلا رُبَّما راحوا عَلَيها وَأَدلَجوا",6,"ج",3,0],["ألا غَفلَةٌ من رَقِيبٍ عَتِيدٍ","يُلاحِظنا نَظْرَةَ الأشوَسِ",7,"س",1,0],["أَلا غَربُ دَمعٍ ناصِرٍ لي عَلى الأَسى","أَلا حُرُّ شِعرٍ في الغَليلِ مُساعِدي",8,"د",2,0],["أَلا غَنِّيا لي بِالصَهيلِ فَإِنَّهُ","سَماعي وَرَقراقُ الدِماءِ نِدامي",9,"م",2,0],["ألا غنمٌ هناك لها ثُغَاءُ","ولا بقرٌ هناكَ له خُوَار؟",10,"ر",1,0],["الاغلب ؟ على أمتان تجربتي صعد","عرته سلوبي وأعتطا عاريّتي",11,"ت",2,0],["أَلا غَيرةٌ كالشامِ أَشكرُكم بها","فَلَستُ أؤدّي ما حييتُ لَها شُكرا",12,"ر",2,0],["الأغَرَّ البهي الكريمَ المواسي ال","مُرْتَجَى الماجدَ الأريبَ الأديبا",13,"ب",2,0],["أَلا غَدَرَت بنو أعلى قديماً","وأَنعُمُ إِنّها وُدُقُ المَزَادِ",14,"د",1,1],["إلّا غدونا بخمر المدح في طربٍ","ما بين صاحٍ وشخصٍ بالهوى ثَمَل",15,"ل",1,0],["ألا غاضب للّه إذ ضاع دينه","يسوق جنوداً إِثْرَهُنَّ جنود",16,"د",1,0],["ألا غيرةٌ تقضي المنازل حقَّها","وتوقظ وسنان التراب خيولها",17,"ه",2,0],["ألاَ غِبَّ إِهداء السلام تحيةً","كعَرْفِ الشذا العطري بَلْ هي أعطر",18,"ر",1,1],["ألا غنياني بالصهيل فإنه","سَماعي ورقْراق الدماء مُدامي",19,"م",2,0],["ألا غاضِبٌ يَوْماً لِسُنَّةِ أَحْمَدٍ","فَمَنْ كانَ مَنْشُوداً فإنِّي ناشِدُهْ",20,"د",2,0],["ألا غادِ دمعَ العينِ إنْ كنتَ غاديا","فلستُ ألومُ اليومَ بعدك باكيا",21,"ي",2,1],["ألا غنّياني بقرع السّيوفِ","فَما غيرُها أبداً مُطربي",22,"ب",2,0],["الأغلبُ الجحجاحُ جين يرمُّ في","طُرُقاتها كالضَّيْطرِ الوطواط",23,"ط",1,0],["ألا غيرة تدعو الصريخ إذا دعا","ليوم عبوس شره يوقظ الوسنى",24,"ن",2,0],["أَلا غنّيا بالعامرية واِطربِ","وَهاتِ لنا شرح اللوى والمحصّبِ",25,"ب",1,1],["الا غُبَّ توقير جزيل مقدّمِ","بكل احتشامٍ واحترامٍ مُتمَمِ",26,"م",1,1],["الا غداة رأيت نصب نواظري","في الدهر غور كواكب بصعيد",27,"د",1,0],["إلا غصب ماذا عليه ناصرذ","ولا معه قدره ترد الاقدار",28,"ر",1,0],["ألاّ غضبة لله منكم يعينها","بنصر ففي أيديكمُ الحلّ والعقد",29,"د",1,0],["الا غنِّني مستقبلاً منك صلةً","كشمس الضحى اغنت عن البدر مطلعا",30,"ع",2,0],["الا غداة صفا لآل المصطفى","أُنسٌ بعرس المحسن بن جواد",31,"د",1,0],["إلا غَرامٌ داهَمَت قلبي به","أُمُّ الدُهَيمِ ومقسم الأعمارِ",32,"ر",1,0],["إِلاَّ غَفَرتَ لَنَا الّّذِي مِنَّا جَرَى","جَهلاً وَلاَ تَسال غَداً عَمَّا جَرَى",33,"ر",2,0],["الا غارت عيون الارض لم لا","اغاثته الاعقم السحاب",34,"ب",1,0],["إلَّا غَرِيبٌ كُلَّمَا طَرَقَتْ","كَفَّاهُ بَابًا مُوحِشًا طَرَقَهْ",35,"ق",2,0],["ألا غنمْ ربيعا في حياتك زاهرا","برغم لديك َ الهمّ بات له ثغرُ",36,"ر",1,0],["ألَاْ غُفِّيْ بُصَاْقَكِ وَاتْفُلِيْنَاْ","وَلَاْ تُبْقِ وُجُوْهَاً مُجْرِمِيْنَاْ",37,"ن",2,1],["الأغنياء تزاوروا وتبادلوا","جُمَلَ التهاني من جناس أو طباق",38,"ق",1,0],["أَلا غَنِّيانِي بِالأَحادِيثِ وَاذْكُرا","خِياماً لَها وَسْطَ القُلُوبِ خِيامُ",39,"م",1,0],["ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","وَهاتِ لَنا شَرْحَ اللِّوَى وَالمُحَصَّبِ",40,"ب",1,1],["الأغاني وأنتَ والكلّ جئنا","كي نغنّي ودونَ شيءٍ رجعنا",41,"ن",2,1],["الأغاني والغيثُ كالأمسِ جاثٍ","لاعقاً برزخَ التّلاحينِ حُزنا",41,"ن",2,0],["ألا غني لنا الشعر الرصينا","بلحنٍ يوقظ الإحساس فينا",42,"ن",2,1],["الأغلَيان تُوُفِّيا وفتاهما..","يتلمس المخلوق ربا راحما",43,"م",2,1],["الأغلَيان تُوُفِّيا وبنوهما..","يتلمس المخلوق رباً راحما",44,"م",2,1],["إلا غداة رآه وهو في سنةٍ","عن العداة غفول النفس ساهيها",45,"ي",3,0],["إلا غزالا بذات النار أَلهَبَهُ","وصَيَّرَ العذبَ كالزقوم في فيهِ",46,"ي",2,0],["الأغاريد في دروبك نشوى","ساومتني على السها فأبيت ُ",47,"ت",1,0]]}