{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[61,"ألا غادها مخطئا أو مصيبا","https://www.aldiwan.net/poem51792.html","المتقارب"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[80,"شموس دعاهن وشك الفراق","https://www.aldiwan.net/poem31415.html","المتقارب"],[44,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""]],"verses":[["أَلا غَنِّياني بِالدِيارِ فَإِنَّني","أُحِبُّ زَروداً ما أَقامَ ثَراها",0,"ا",3,0],["أَلا غَنِّياني بِالحَديثِ فَإِنَّني","رَأَيتُ أَلَذَّ القَولِ ما كانَ يُطرِبُ",1,"ب",1,0],["ألا غارمٌ صفحاً ليغنم سُؤدداً","وحمداً وأجراً إنَّ ذا الغُنْمِ غارمُ",2,"م",1,0],["إلا غانمٌ أحدوثَةَ الصِّدقِ في الورى","بغُرم الأيادي إن ذا الغُرْمِ غانمُ",2,"م",1,0],["الأغاني تصبي ولست بدار","أي شيء فيها من الأسرار",3,"ر",1,1],["الأَغَرُّ الوَضّاحُ توري يَداهُ","حينَ يَكبو زَندُ الأَغَمِّ البَهيمِ",4,"م",1,0],["ألا غَادِها مُخطِئاً أو مُصِيباً","وسِرْ نحوَها داعياً أو مجيبا",5,"ب",2,1],["أَلا غَرَّتِ الدُنيا رِجالاً عَهِدتَهُم","أَلا رُبَّما راحوا عَلَيها وَأَدلَجوا",6,"ج",3,0],["ألا غَفلَةٌ من رَقِيبٍ عَتِيدٍ","يُلاحِظنا نَظْرَةَ الأشوَسِ",7,"س",1,0],["أَلا غَربُ دَمعٍ ناصِرٍ لي عَلى الأَسى","أَلا حُرُّ شِعرٍ في الغَليلِ مُساعِدي",8,"د",2,0],["أَلا غَنِّيا لي بِالصَهيلِ فَإِنَّهُ","سَماعي وَرَقراقُ الدِماءِ نِدامي",9,"ي",1,0],["ألا غنمٌ هناك لها ثُغَاءُ","ولا بقرٌ هناكَ له خُوَار؟",10,"ر",1,0]]}