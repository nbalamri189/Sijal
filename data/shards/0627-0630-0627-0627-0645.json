iewPoem.aspx?id=181029",""],[5720,"لنا اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=211674",""],[5766,"على البئر من يبرين حلت حملوهم","https://www.poetsgate.com/ViewPoem.aspx?id=186569",""],[5790,"إليك عني فليس اللهو من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=111920",""],[5853,"معطرة القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=188370",""],[6142,"المرتضى غيره رفقاً ومرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=155722",""],[6218,"يقرّبُ حبُّ الناس حتفي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77480&r=&rc=66",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""]],"verses":[["إِذا أَمَرَ الطِبُّ اللَبيبُ بِقَطعِهِ","أَقولُ عَسى ضَنّاً بِهِ وَلَعَلَّما",0,"م",2,0],["إِذا اِمتَرى عَلَقَ الأَوداجِ عامِلُهُ","أَعشى العَوالي فَلَم تَنظُر إِلى سَلَبِ",1,"ب",1,0],["إذا امتطيت ركاباً للنوى فأنا","في داخلي... أمتطي ناري واغترب",2,"ب",1,0],["إِذا أَمكَنَت بَعضَنا لَم يَزَل","يُرَفِّعُها أَو يَصُكُّ الجَبينا",3,"ن",2,0],["إِذا اِمتَنَعَ القَريبُ فَلَم تَنَلهُ","عَلى قُربٍ فَذاكَ هُوَ البَعيدُ",4,"د",1,0],["إذا أمِنوا واستَوْثَقوا البابَ أعْلنوا","خَبائِثَ ما كان اللّسانُ ليُفْشِيها",5,"ي",3,0],["إِذا أَمالوا إِلى النُشّابِ أَيدِيَهُم","مِلنا بِبيضٍ فَظَلَّ الهامُ يُختَطَفُ",6,"ف",1,0],["إِذا أَمسَيتَ في بَلَدٍ غَريباً","تَرومُ إِقامَةً أَصبَحتَ راحِل",7,"ل",1,0],["إِذا أَمسَيتُ بَطنُ مُجاحَ دوني","وَعَمقٌ دونَ عَزَّةَ فَالنَقيعُ",8,"ع",1,1],["إِذا أَمسَتِ الشِعرى العَبورُ كَأَنَّها","مَهاةٌ عَلَت مِن رَملِ يَبرينَ رابِيا",9,"ي",2,0],["إذا أمست الآفاق حمراً جنوبها","لشيبان أو ملحان واليوم اشيب",10,"ب",1,1],["إِذا أَمسَت نِزارُ لَنا عَبيداً","فَإِنَ الناسَ كُلُّهُمُ نِزارُ",11,"ر",1,0],["إذا امتاحهم أكْلَةً عبَّدُو","هُ تعبيدَ ربٍّ لمربوبِهِ",12,"ب",2,0],["إذا أمنَتْ نفسي وعيدَ زمانها","على ابن سَعيد لم تُرَعْ بوعيدِ",13,"د",1,0],["إذا امتطى الريحَ سار منشمِراً","سيان مَدحيكمُ وسَياره",14,"ر",2,0],["إذا امتُدِحوا وإن لم يُستثابوا","حسبتَ وجوهَهم طُليت بوَرْس",15,"س",1,0],["إذا امتيح جَمَّ لممتاحِهِ","ويأبى صفاه إذا ما قُرِع",16,"ع",1,0],["إذا امتدحُوا لم يُنْحَلوا مجدَ غيرهِم","وهل تُنحلُ الأطواقَ وُرقُ الحمائمِ",17,"م",1,0],["إِذا أُمِرَت بِهِ أَلقَت عَلَيهِ","أَحَدَّ سِلاحِها ظُفُراً وَنابا",18,"ب",2,0],["إِذا أَمَرَتني بِالعُقوقِ حَليلَتي","فَلَم أَعصِها إِنّي إِذاً لَمَضيعُ",19,"ع",1,0],["إذا أمست حياة المرء عبثاً","عليه لا يطيق لها احتمالا",20,"ل",2,0],["إذا أمست حياة المرء داءً","فليس سوى الحمام لها دواءُ",21,"ا",2,0],["إِذا اِمرُؤٌ راعَني بِغَدرَتِهِ","أَورَدتُهُ الغايَةَ الَّتي خافا",22,"ف",2,0],["إِذا اِمتَللأََت عُيونُ الخَيلُ مِنّي","فَوَيلٌ في التَيَقُّظِ وَالمَنامِ",23,"م",1,0],["إِذا امتَحْتُ يوماً جَمَّةً من نوالِه","سقانيَ سَجْلٌ من نَداهُ سجيلُ",24,"ل",1,0],["إِذا أَمعَنتَ في لَونٍ","رَأَينا النارَ وَالحَطَبا",25,"ب",2,0],["إِذا أَمضى عَزيمَتَهُ لِخَطبٍ","كَفاهُ العَفوُ دونَ الإِجتِهادِ",26,"د",1,0],["إِذا أُمَراءُ الناسِ عَفّوا تَقِيَّةً","عَفَفتَ وَلَم تَقصِد لِشَيءٍ سِوى التُقى",27,"ق",2,0],["إذا امتزجَ المعروفُ بالبِشْر عندَه","غدا الحمدُ ممزوجاً له بوَدادِ",28,"د",1,0],["إذا أمْرَضَتْكَ وخفتَ الصّبُوحَ","فَمُمْرِضُها لك غَيْرُ الطبيبِ",29,"ب",1,0],["إِذا آمِلٌ ساماهُ قَرطَسَ في المُنى","مَواهِبَهُ حَتّى يُؤَمِّلَ آمِلُه",30,"ل",2,0],["إِذا أَمَّهُ العافونَ أَلفَوا حِياضَهُ","مِلاءً وَأَلفَوا رَوضَهُ غَيرَ مُجدِبِ",31,"ب",1,0],["إِذا أُمَّةٌ كانَت فِضاضاً قُلوبُها","تَهَدَّمَ عالِي مَجدِها وَكَبا الجَدُّ",32,"د",1,0],["إذا أمسكَ الصَّبرُ البلادَ وأَهْلَها","فليس على هذا قَرارٌ ولا صَبْرُ",33,"ر",1,0],["إِذا اِمتَلَّ يَهوي قُلتَ ظَلُّ طَخاءَةٍ","ذَرا الريحُ في أَعقابِ يَومٍ مُصَرَّحِ",34,"ح",1,0],["إذَا أُمَناؤُنَا قَبِلُوا الهَدَايا","وَصَارُوا يَتْجَرُونَ وَيَزْرَعُونا",35,"ن",2,0],["إِذا اِمتُحِنَت مَحاسِنُهُ فَأَبدَت","غَرائِبَ حُسنِهِ مِن كُلِّ بابِ",36,"ب",1,0],["إِذا امتُحِنَت أَلوانُها مالَ سَفوُها","إِلى الجَوِّ إِلّا أَنَّ أَوبارَها خُضرُ",37,"ر",1,0],["إِذا امتَحَنَ الدُنيا لَبيبٌ تَكَشَّفَت","لَهُ عَن عَدوٍّ في ثِيابِ صَديقِ",38,"ق",1,0],["إِذا اِمتَرَتها أَكُفُّنا نَشَأَت","لَها سَحابٌ تَستَنُّ بِالرِهَمِ",39,"م",1,0],["إِذا امتازَتِ الأَحسابُ يَوماً بِأَهلِها","أَناخَ إِلى عادِيَّةٍ وَصَميمِ",40,"م",1,0],["إِذا اِمتَحَنتَ بِطَرفِ العَينِ مُكتَتَماً","ناداكَ مِن طَرفِهِ بِالسِرِّ تِبيانُ",41,"ن",1,0],["إِذا آمَنَ الإِنسانُ بِاللَهِ فَليَكُن","لَبيباً وَلا يَخلِط بِإيمانِهِ كُفرا",42,"ر",2,1],["إِذا أَمِنتَ عَلى مالٍ أَخا ثِقَةٍ","فَاِحذَر أَخاكَ وَلا تَأَمَن عَلى الحُرَمِ",43,"م",1,1],["إذا امتطَى الخِنصرَين أذكرَ مِن","سَحبانَ فيما أطالَ واخْتَصرا",44,"ر",2,0],["إذا أمرن فإني","لهن ذاك المطيع",45,"ع",1,0],["إِذَا امْتَنَحَتْهُ مِنْ مَعَدٍّ عِصَابَةٌ","غَدَا رَبُّهُ قَبْلَ المُفيضِينَ يَقْدَحُ",46,"ح",1,0],["إذا أَمهَلنَ ذا جَدٍّ عَظيمٍ","عَطَفنَ لَهُ وَلو في طَيِّ حِينا",47,"ن",2,0],["إِذَا أَمْكَنَتْهُ فُرْصَةٌ نَزَعَتْ بِهِ","إِلَى الشَّرِّ أَخْلاقٌ نَبَتْنَ عَلى غِمْرِ",48,"ر",1,0],["إِذا أَمَّلَ الإِنسانُ أَمراً فَنالَهُ","سَما يَبتَغي فَوقَ الَّذي كانَ أَمَّلا",49,"ل",2,0],["إِذَا امْتَلكَ الحبُّ النفوسَ هَفَتْ لَهُ","سِراعاً وأعْطتْ فَوقَ ما هُوَ سَائلُهْ",50,"ل",2,0],["إذا أَمَلَ الفتَى فالهزلُ جِدُّ","وإن يئِسَ الفتَى فالْجِدُّ هزل",51,"ل",1,0],["إذا أَمَّهم ذو حاجةٍ لقضائها","فأقربُ منها نيلُ بعض الكواكب",52,"ب",1,0],["إِذا أَمسَكَ المِرآة يَنظُر وَجهُهُ","فَظاهرها بَدر وَباطنها شَمس",53,"س",1,0],["إِذا أَملت يَوماً مِنكَ فَضلاً","كَأَنّي أَرتَجي عود الشَباب",54,"ب",1,0],["اذا امعنت فيه رقيق نظم","ترى فيه البلاغة والبلاغا",55,"غ",2,0],["اذا ام للدين المؤمل غيرهم","يروح عنان المستحيلات جاذبا",56,"ب",2,0],["إذا أملت في الدنيا صديقاً","أخا صدقٍ فثق بالوالدين",57,"ن",1,1],["إذا امترتهن كف الفكر فاض لها","شخب كما فاض شؤبوب له برد",58,"د",1,0],["ِإذَا امتَحَنت قَرائِحُنَا تَبَدَّى","لِحَضرَتِنَا الكُهَامُ مِنَ الحُسَامِ",59,"م",1,0],["إذا أَمَّم السارون نورَ جبينهِ","كفى الرَّكب أن يدعو جُدَيًّا وفرقدا",60,"د",2,0],["إِذا أَمرَعوا فُقتَهُم في المُحولِ","وَإِن أَسرَعوا فُتَّهُم بِالمَهَل",61,"ل",1,0],["إذا أمّلت من مولاك قرباً","فجدِّد ذكر خير الأنبياء",62,"ا",2,1],["إذا أمطرت ارضا سحائب جوده","فلا القطر 