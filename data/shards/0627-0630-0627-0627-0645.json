مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[261,"أشاقك من هذا الرديني قده","https://www.aldiwan.net/poem38143.html","الطويل"],[261,"لقد علمت ما قد اضر بنا البعد","https://www.aldiwan.net/poem38339.html","الطويل"],[280,"ألا من مبلغ عني عليا","https://www.aldiwan.net/poem60781.html","الوافر"],[282,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[349,"إذا امتنع الإمكان إلا بموجب","https://www.aldiwan.net/poem15508.html","الطويل"],[364,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[366,"خزنت من دره إذ لم أجد أحدا","https://www.aldiwan.net/poem17288.html","البسيط"],[380,"بكيت لتغريد الحمائم في الفجر","https://www.aldiwan.net/poem49260.html","الطويل"],[400,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[400,"أمام حجرة عائشة رضي الله عنها","https://www.aldiwan.net/poem6772.html","عموديه"],[400,"دموع القلم","https://www.aldiwan.net/poem6795.html","عموديه"],[410,"إذا أم طفل راعها جوع طفلها","https://www.aldiwan.net/poem67481.html","الطويل"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[441,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[458,"يا دار لهوي بالنجيل من قطن","https://www.aldiwan.net/poem55854.html","الرجز"],[458,"ما سمح وفاقهن خلف","https://www.aldiwan.net/poem56107.html","الرجز"],[458,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[458,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[461,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[461,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[461,"رأيت غياث الدين في البأس والندى","https://www.aldiwan.net/poem15181.html","الطويل"],[461,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[461,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[464,"أزار علي أمة الأحد الظبي","https://www.aldiwan.net/poem3233.html","عموديه"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[544,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[551,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[551,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[553,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[562,"أسحرا كان شغلي في هواكا","https://www.aldiwan.net/poem52945.html","الوافر"],[575,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[575,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"]],"verses":[["إِذا أَمَرَ الطِبُّ اللَبيبُ بِقَطعِهِ","أَقولُ عَسى ضَنّاً بِهِ وَلَعَلَّما",0,"م",2,0],["إِذا اِمتَرى عَلَقَ الأَوداجِ عامِلُهُ","أَعشى العَوالي فَلَم تَنظُر إِلى سَلَبِ",1,"ب",1,0],["إذا امتطيت ركاباً للنوى فأنا","في داخلي... أمتطي ناري واغترب",2,"ب",1,0],["إِذا أَمكَنَت بَعضَنا لَم يَزَل","يُرَفِّعُها أَو يَصُكُّ الجَبينا",3,"ن",2,0],["إِذا اِمتَنَعَ القَريبُ فَلَم تَنَلهُ","عَلى قُربٍ فَذاكَ هُوَ البَعيدُ",4,"د",1,0],["إذا أمِنوا واستَوْثَقوا البابَ أعْلنوا","خَبائِثَ ما كان اللّسانُ ليُفْشِيها",5,"ي",3,0],["إِذا أَمالوا إِلى النُشّابِ أَيدِيَهُم","مِلنا بِبيضٍ فَظَلَّ الهامُ يُختَطَفُ",6,"ف",1,0],["إِذا أَمسَيتَ في بَلَدٍ غَريباً","تَرومُ إِقامَةً أَصبَحتَ راحِل",7,"ل",1,0],["إِذا أَمسَيتُ بَطنُ مُجاحَ دوني","وَعَمقٌ دونَ عَزَّةَ فَالنَقيعُ",8,"ع",1,1],["إِذا أَمسَتِ الشِعرى العَبورُ كَأَنَّها","مَهاةٌ عَلَت مِن رَملِ يَبرينَ رابِيا",9,"ي",2,0],["إذا أمست الآفاق حمراً جنوبها","لشيبان أو ملحان واليوم اشيب",10,"ب",1,1],["إِذا أَمسَت نِزارُ لَنا عَبيداً","فَإِنَ الناسَ كُلُّهُمُ نِزارُ",11,"ر",1,0],["إذا امتاحهم أكْلَةً عبَّدُو","هُ تعبيدَ ربٍّ لمربوبِهِ",12,"ب",2,0],["إذا أمنَتْ نفسي وعيدَ زمانها","على ابن سَعيد لم تُرَعْ بوعيدِ",13,"د",1,0],["إذا امتطى الريحَ سار منشمِراً","سيان مَدحيكمُ وسَياره",14,"ر",2,0],["إذا امتُدِحوا وإن لم يُستثابوا","حسبتَ وجوهَهم طُليت بوَرْس",15,"س",1,0],["إذا امتيح جَمَّ لممتاحِهِ","ويأبى صفاه إذا ما قُرِع",16,"ع",1,0],["إذا امتدحُوا لم يُنْحَلوا مجدَ غيرهِم","وهل تُنحلُ الأطواقَ وُرقُ الحمائمِ",17,"م",1,0],["إِذا أُمِرَت بِهِ أَلقَت عَلَيهِ","أَحَدَّ سِلاحِها ظُفُراً وَنابا",18,"ب",2,0],["إِذا أَمَرَتني بِالعُقوقِ حَليلَتي","فَلَم أَعصِها إِنّي إِذاً لَمَضيعُ",19,"ع",1,0],["إذا أمست حياة المرء عبثاً","عليه لا يطيق لها احتمالا",20,"ل",2,0],["إذا أمست حياة المرء داءً","فليس سوى الحمام لها دواءُ",21,"ا",2,0],["إِذا اِمرُؤٌ راعَني بِغَدرَتِهِ","أَورَدتُهُ الغايَةَ الَّتي خافا",22,"ف",2,0],["إِذا اِمتَللأََت عُيونُ الخَيلُ مِنّي","فَوَيلٌ في التَيَقُّظِ وَالمَنامِ",23,"م",1,0],["إِذا امتَحْتُ يوماً جَمَّةً من نوالِه","سقانيَ سَجْلٌ من نَداهُ سجيلُ",24,"ل",1,0],["إِذا أَمعَنتَ في لَونٍ","رَأَينا النارَ وَالحَطَبا",25,"ب",2,0],["إِذا أَمضى عَزيمَتَهُ لِخَطبٍ","كَفاهُ العَفوُ دونَ الإِجتِهادِ",26,"د",1,0],["إِذا أُمَراءُ الناسِ عَفّوا تَقِيَّةً","عَفَفتَ وَلَم تَقصِد لِشَيءٍ سِوى التُقى",27,"ق",2,0],["إذا امتزجَ المعروفُ بالبِشْر عندَه","غدا الحمدُ ممزوجاً له بوَدادِ",28,"د",1,0],["إذا أمْرَضَتْكَ وخفتَ الصّبُوحَ","فَمُمْرِضُها لك غَيْرُ الطبيبِ",29,"ب",1,0],["إِذا آمِلٌ ساماهُ قَرطَسَ في المُنى","مَواهِبَهُ حَتّى يُؤَمِّلَ آمِلُه",30,"ل",2,0],["إِذا أَمَّهُ العافونَ أَلفَوا حِياضَهُ","مِلاءً وَأَلفَوا رَوضَهُ غَيرَ مُجدِبِ",31,"ب",1,0],["إِذا أُمَّةٌ كانَت فِضاضاً قُلوبُها","تَهَدَّمَ عالِي مَجدِها وَكَبا الجَدُّ",32,"د",1,0],["إذا أمسكَ الصَّبرُ البلادَ وأَهْلَها","فليس على هذا قَرارٌ ولا صَبْرُ",33,"ر",1,0],["إِذا اِمتَلَّ يَهوي قُلتَ ظَلُّ طَخاءَةٍ","ذَرا الريحُ في أَعقابِ يَومٍ مُصَرَّحِ",34,"ح",1,0],["إذَا أُمَناؤُنَا قَبِلُوا الهَدَايا","وَصَارُوا يَتْجَرُونَ وَيَزْرَعُونا",35,"ن",2,0],["إِذا اِمتُحِنَت مَحاسِنُهُ فَأَبدَت","غَرائِبَ حُسنِهِ مِن كُلِّ بابِ",36,"ب",1,0],["إِذا امتُحِنَت أَلوانُها مالَ سَفوُها","إِلى الجَوِّ إِلّا أَنَّ أَوبارَها خُضرُ",37,"ر",1,0],["إِذا امتَحَنَ الدُنيا لَبيبٌ تَكَشَّفَت","لَهُ عَن عَدوٍّ في ثِيابِ صَديقِ",38,"ق",1,0],["إِذا اِمتَرَتها أَكُفُّنا نَشَأَت","لَها سَحابٌ تَستَنُّ بِالرِهَمِ",39,"م",1,0],["إِذا امتازَتِ الأَحسابُ يَوماً بِأَهلِها","أَناخَ إِلى عادِيَّةٍ وَصَميمِ",40,"م",1,0],["إِذا اِمتَحَنتَ بِطَرفِ العَينِ مُكتَتَماً","ناداكَ مِن طَرفِهِ بِالسِرِّ تِبيانُ",41,"ن",1,0],["إِذا آمَنَ الإِنسانُ بِاللَهِ فَليَكُن","لَبيباً وَلا يَخلِط بِإيمانِهِ كُفرا",42,"ر",2,1],["إِذا أَمِنتَ عَلى مالٍ أَخا ثِقَةٍ","فَاِحذَر أَخاكَ وَلا تَأَمَن عَلى الحُرَمِ",43,"م",1,1],["إذا امتطَى الخِنصرَين أذكرَ مِن","سَحبانَ فيما أطالَ واخْتَصرا",44,"ر",2,0],["إذا أمرن فإني","لهن ذاك المطيع",45,"ع",1,0],["إذا أَمهَلنَ ذا جَدٍّ عَظيمٍ","عَطَفنَ لَهُ وَلو في طَيِّ حِينا",46,"ن",2,0],["إِذَا أَمْكَنَتْهُ فُرْصَةٌ نَزَعَتْ بِهِ","إِلَى الشَّرِّ أَخْلاقٌ نَبَتْنَ عَلى غِمْرِ",47,"ر",1,0],["إِذا أَمَّلَ الإِنسانُ أَمراً فَنالَهُ","سَما يَبتَغي فَوقَ الَّذي كانَ أَمَّلا",48,"ل",2,0],["إِذَا امْتَلكَ الحبُّ النفوسَ هَفَتْ لَهُ","سِراعاً وأعْطتْ فَوقَ ما هُوَ سَائلُهْ",49,"ل",2,0],["إذا أَمَلَ الفتَى فالهزلُ جِدُّ","وإن يئِسَ الفتَى فالْجِدُّ هزل",50,"ل",1,0],["إذا أَمَّهم ذو حاجةٍ لقضائها","فأقربُ منها نيلُ بعض الكواكب",51,"ب",1,0],["إِذا أَمسَكَ المِرآة يَنظُر وَجهُهُ","فَظاهرها بَدر وَباطنها شَمس",52,"س",1,0],["إِذا أَملت يَوماً مِنكَ فَضلاً","كَأَنّي أَرتَجي عود الشَباب",53,"ب",1,0],["اذا امعنت فيه رقيق نظم","ترى فيه البلاغة والبلاغا",54,"غ",2,0],["اذا ام للدين المؤمل غيرهم","يروح عنان المستحيلات جاذبا",55,"ب",2,0],["إذا أملت في الدنيا صديقاً","أخا صدقٍ فثق بالوالدين",56,"ن",1,1],["إذا امترتهن كف الفكر فاض لها","شخب كما فاض شؤبوب له برد",57,"د",1,0],["ِإذَا امتَحَنت قَرائِحُنَا تَبَدَّى","لِحَضرَتِنَا الكُهَامُ مِنَ الحُسَامِ",58,"م",1,0],["إذا أَمَّم السارون نورَ جبينهِ","كفى الرَّكب أن يدعو جُدَيًّا وفرقدا",59,"د",2,0],["إِذا أَمرَعوا فُقتَهُم في المُحولِ","وَإِن أَسرَعوا فُتَّهُم بِالمَهَل",60,"ل",1,0],["إذا أمّلت من مولاك قرباً","فجدِّد ذكر خير الأنبياء",61,"ا",2,1],["إذا أمطرت ارضا سحائب جوده","فلا القطر مرفوع ولا العام ممحل",62,"ل",1,0],["إِذا اِمرُؤٌ خيفَ لِإِفراطِ الأَذى","لَم يُخشَ مِنّي نَزَقٌ وَلا أَذى",63,"ا",1,0],["إذا أملٌ ناجاك وهْما ففَوْزُه","بجملةِ ما يرجوه منك جَواب",64,"ب",1,0],["إذا أمسك الشيخ العصا بيمينه","فكبّر عليه أربعا فهو هالك",65,"ك",1,1],["إذا امتنع الفتى بلطيف عيش","عليك وحسن إقبال متاح",66,"ح",1,1],["إذا أمّة يوما حماها طبيبها","وما تحتمى شيكت بداء حماتها",67,"ت",3,0],["اذا امتضى صارما في يوم معركة","ابصرت منه يلوح الموت والاجل",68,"ل",1,0],["إذا امتزجت بالهوى مهجتا","ن فصيرها الحب كالمهجة",69,"ه",1,0],["إذا أمستْ بعسْفانٍ","فمَغْداها سِجِسْتانُ",70,"ن",1,0],["إذا أمها ركب وددت بأنني","جعلت له خدي على الأرض مفرشا",71,"ش",2,0],["إِذا أَمسى يُفاخِرُهُ بِمَجدٍ","طَريفُ المَجدِ لَيسَ لَهُ اِفتِخارُ",72,"ر",1,0],["إِذا أَمَّت سِواكَ عَلى ضَلالٍ","هَداها مِن نَسيمِ ثَراكَ نَفحُ",73,"ح",1,0],["إِذا أَمَرَتهُ بِالعِقابِ حَفيظَةٌ","نَهاهُ المُحَيّا الطَلقُ وَالخُلقُ العَذبُ",74,"ب",1,0],["إذا أم جيشا خلت نور جبينه","هلالا وأسراب الكواكب جنده",75,"د",2,0],["إذا امه السارون الفين ناره","سلاماً وللعافين من بره برد",76,"د",1,0],["إذا ام جيشاً خلت نور جبينه","هلالا واستراب النجوم له جند",76,"د",1,0],["إِذا أَمْرٌ أُضِيعَ مِنَ الرَّعايا","فَإِنَّ اللَّوْمَ فِيهِ عَلَى الرُّعاةِ",77,"ه",1,0],["إِذا أُمَراءُ الوَرى سابَقوكَ","إِلى غايَةِ المَجدِ بَرَّزت سَبقا",78,"ق",2,0],["إِذا اِمتَنَعَ الإِمكانُ إِلّا بِموجَبِ","فَلا مُمكِنٌ في الكَونِ إِلّا لَواجِبُ",79,"ب",1,1],["إذا أَمَّ أقلامَ الورى فأكفُّهم","مَحاريبُ والأقلامُ فيهنّ عُبَّد",80,"د",1,0],["إِذا اِمرؤٌ خَلَّدَتهُ المَكرُماتُ فَما","يَكونُ غَيرُكَ في هَذا الوَرى فَكُنِ",81,"ن",1,0],["إِذا اِمتَلَأَت مِن دَمع هَذا ثُغور ذا","فَقُلتُ لَهُ ماذا فَأومى إِلى البَدر",82,"ر",1,0],["إذا امتدَّتْ يدُ الباغي بمالٍ","إليكَ فَخَلْفَهُ هدفٌ مُرِيبُ",83,"ب",1,0],["إذا أَمِنَ الغواةُ عقاب ذنبٍ","تمادوا في الغواية واستهانوا",84,"ن",3,0],["إذا أمسكتُه لأَخُطَّ حَرْفاً","تَلَجْلَج نُطْقُه وهو الفَصيحُ",85,"ح",1,0],["إِذا أُمُّ طِفلٍ راعَها جوعُ طِفلِها","دَعتهُ بِإِسمِ الفَضلِ فَاِعتَصَم الطِفلُ",86,"ل",1,1],["إذا امتطى العزم وصال صولة","قدّ الرؤوس جازلاً مع المطا",87,"ا",1,0],["إذا أمسى صغيركمو","وجدكمو كبيركمو",88,"و",1,0],["إذا امرؤ قال لراويها أعدْ","أطرَبه كأنما قال تَغَنّْ",89,"ن",1,0],["إذا امتُرِي من بعضهنّ خِلفُ","بلّك منها ما به تجفُّ",90,"ف",1,0],["إذا أَمَرتهُ مُرَّةً من حفيظةٍ","تسوءُ نهاه خُلْقه الباردُ العذبُ",91,"ب",1,0],["إذا امتلأتْ لحاظي منك نوراً","نَزَا قلبي فطارَ به الوجيبُ",92,"ب",1,0],["إذا أمسك الغيثُ المُلثُّ بأرضه","سقوها عن الأيدي عُقاراً مشعشعا",93,"ع",2,0],["إذا أمَّها مَلكٌ ذادَهُ","حُماةُ الثُّغورِ وفِتيانُها",94,"ن",3,0],["إذا أمْكنتهُ قدرةٌ كفَّ فَتْكَهُ","كريمٌ حليمٌ يَسْتحبُّ المَراحما",95,"م",2,0],["إذا أمنتْ صوارمُه الأعادي","بليلٍ باتَ تخشاها العِشارُ",96,"ر",1,0],["إذا أمْكنتهُ غِرَّةٌ منْ عَدوِّهِ","غَدتْ موبقاتُ الحتف وهي مراحم",97,"م",1,0],["إذا أم جيشاً مارقاً وتضاحكت","وجوه الظبي في نقعه وعبوسه",98,"س",2,0],["إذا اِمتدّتْ إليه يَمينُ نَفسي","ثنَيْتُ عنانَها بيَدي الشِّمالِ",99,"ل",1,0],["إذا امتطَى قَلَمٌ إحدَى أصابعِهِ","تَأَلَّقَتْ ببريقِ الماسِ إصبعُهُ",100,"ع",2,0],["إِذا اِمرؤٌ أَخلَفت أنواءُ خلّتهِ","سَقاك مِن ودّه بِالوابلِ العرمِ",101,"م",1,0],["إذا أمرضوا لم يعودوا المريضَ","وإنْ قتلوا لا يَدون القتيلا",102,"ل",2,0],["إِذا أَمكَنَ السُلوانُ حَبَّةَ قَلبِهِ","ثَنى شَوقَهُ سَهمانِ ريشا بِإِثمِدِ",103,"د",1,0],["إذا أمضَى ذُبابُ السَّيفِ حُكماً","غَدَتْ حُجَجُ الوَرِيدِ لهُ رِكاكا",104,"ك",2,0],["إِذا امتطى القلمَ العالي أَناملُه","جلا الطروسَ وجلَّى الظُّلمَ والظُّلمَا",105,"م",2,0],["إِذا أَمَّ يوماً إِلى جَحْفَلٍ","فلا تسأَلنَّ عن الجَحْفَل",106,"ل",1,0]]}