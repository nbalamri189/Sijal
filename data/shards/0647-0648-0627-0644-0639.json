?id=21899",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5397,"أفق من رقدة الآمال جفن","https://www.poetsgate.com/ViewPoem.aspx?id=157927",""],[5419,"لي الله","https://www.poetsgate.com/ViewPoem.aspx?id=32269",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"درعا ...رسالة الى الاردن الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198512",""],[5431,"ثورة كبرى...في العالم!","https://www.poetsgate.com/ViewPoem.aspx?id=198727",""],[5506,"إن جِئتَ بَدراً فَطِب وَاِنزِل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[1333,"تَفُتُّ فُؤادَكَ الأَيّامُ فَتّا","https://www.poetsgate.com/ViewPoem.aspx?id=6269",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5596,"مجاراة قصيدة الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=206695",""],[5701,"نهايتنا نحو هذا المكان","https://www.poetsgate.com/ViewPoem.aspx?id=164644",""],[5725,"هو العراق","https://www.poetsgate.com/ViewPoem.aspx?id=204165",""],[5751,"للماءِ يُتْمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214783",""],[5751,"حفل الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214810",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[5781,"رصيفهُ والدفءُ العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=202847",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5853,"لماذا ..؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=175630",""],[5912,"نديمان","https://www.poetsgate.com/ViewPoem.aspx?id=205016",""],[5939,"مُتوَّجةٌ في سماواتِ عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=178605",""],[5970,"وزاعمة أني سلوت غرامها","https://www.poetsgate.com/ViewPoem.aspx?id=130648",""],[6070,"ما زلتُ أقرأُ في أوراقيََ القصصا","https://www.poetsgate.com/ViewPoem.aspx?id=187737",""],[4442,"هي الذكوات البيض من جانب الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=171009",""],[6131,"ارْتِدَادُ النُّورْ","https://www.poetsgate.com/ViewPoem.aspx?id=189266",""],[5190,"في رثاء النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85067&r=&rc=142",""]],"verses":[["هُوَ العودُ سَهلٌ لِلسَماحِ جَناتُهُ","وَلَكِن عَلى الأَعداءِ وَعرُ المَكاسِرِ",0,"ر",1,0],["هو العُرْفُ إنْ يُشْكَرْ يُضاعَفْ وإنْ يُثَبْ","يُتابَعْ وإنْ يُكفَرْ ففي بَذْلِهِ الأجْرُ",1,"ر",1,0],["هُوَ الْعَلَمُ الأَعْلَى الَّذِي طَالَ فَخْرُهُ","هُوَ الْمَلِكُ الأَرْضَى الَّذِي طَابَ خيمُهُ",2,"م",2,0],["هُوَ العَسَلُ الصافي مِرارًا وَتارَةً","هُوَ السُمُّ تَستَدمي عَلَيهِ الذَرارِحُ",3,"ح",1,0],["هُوَ العَيْشُ جَهْدٌ طَائِلٌ وَفُتُونُ","وَمَا المَوْتُ إِلاَّ رَاحَةٌ وَسُكَونُ",4,"ن",1,1],["هو العلم يعلو في الحياة سعادة","ويجعلها كالعلم محمودة العقبى",5,"ب",2,0],["هو العلم الفرد الذي شاع فضلُه","فبشراكمُ يا جيرةَ العلم الفرد",6,"د",1,0],["هُوَ العَبدُ يُجبى كُلَّ يَومٍ ضَريبَةً","مَتى تُلزِمِ العَبدَ المَذَلَّةَ يَلزَمِ",7,"م",1,0],["هو العضب يحمى حق شعب اضاعه","من الجبن افراد وامضى من العضب",8,"ب",1,0],["هو العتبُ حتى ما يُرَدَّ سلامُ","وشَحطُ النَّوى حتى اللقاءُ حرامُ",9,"م",1,1],["هُوَ العارِضُ الثَجّاجُ أَخضَلَ جودُهُ","وَطارَت حَواشي بَرقِهِ فَتَلَهَّبا",10,"ب",2,0],["هو العيش فيه الصبر كاليأس تارةً","إذا انهارت الآمال واليأسُ كالصبر",11,"ر",1,0],["هُوَ العيشُ فاغنمْ من زمانك صَفْوَهُ","وَصِدْ قَنَصَ اللَّذَّاتِ قبل مُثيرِهِ",12,"ر",2,0],["هُوَ العَهدُ عهدُ اللَهِ وَالرُسُلِ كُلِّهُم","رِعايَتُهُ تَقوى وَتَوكيدُهُ بِرُّ",13,"ر",1,0],["هُو العِصمةُ الكبرى إذا لم تَفُزْ بها","نُفوسُ البرايا خَانَها كلُّ عاصِمِ",14,"م",1,0],["هُوَ العهدُ الذي أخذَتْ قُرَيْشٌ","ومَالَكَ غَيْرُ نفسِكَ من حسيبِ",15,"ب",1,0],["هُوَ العَسَلُ الماذِيُّ طَوراً وَرُبَّما","يَكونُ كَبيرُ القَومِ مُرَّ جَنى الصَدرِ",16,"ر",1,0],["هُوَ العَصْرُ الَّذِي دَارَتْ عَلَيْنَا","بِهِ اللَّذَّاتُ واضِعَةَ النِّقَابِ",17,"ب",1,0],["هُوَ الْعَسَلُ الْمَاذِيُّ طَوْرَاً وَتَارَةً","يَثُورُ الشَّجَا مِنْهُ مَكَانَ الْمُخَنَّقِ",18,"ق",1,0],["هوَ العمرُ ما نَعُدّ لهُ الأيام","أم بالشهيِ من ثمراتِه",19,"ت",2,0],["هو العزم لا ما تدعي السمر والقضب","وذو الجد حتى كل ما دونه لعب",20,"ب",1,1],["هو العقل إن يذهب يهن كل رائعٍ","ويرحب سبيل المرء أيان يذهب",21,"ب",1,0],["هو العظيم الذي لو شاء طوح بال","دنيا ولوشاء ربط المشتري ربطا",22,"ط",2,0],["هو العلم الخفاق والمرشد الذي","له شد اهل الله شهب الرواحل",23,"ل",1,0],["هو العطوف علينا والرؤوف إذا","ضاق الخناق وراعتنا أعادينا",24,"ن",2,0],["هو العين عين العين إنسانها بدا","وإنسان إنس الإنس يبصر سامحا",25,"ح",2,0],["هُوَ العدلُ سيف نجل سلطان سيفنا","فتى مالك أهلُ الندى والمكارِمِ",26,"م",1,0],["هو العدلُ سيف بحلُ سلطان سيفنا","فتى مالك نجلُ الجحاجحة الشُّمِّ",27,"م",1,0],["هو العدلُ في كلِّ أمرٍ يرى","وليسَ له في البرايا عَدِيلْ",28,"ل",1,0],["هو العفْوُ عمن شاءَ سرّاً وجهرةً","على كلِّ حالٍ والتُّقَى والتلطفُ",29,"ف",1,0],["هو العدلُ سلطانُ بن سيف بن مالك","إمامُ الورى الزاكي الفتى الملك الجعدُ",30,"د",1,0],["هُوَ العَبدُ إِن جَرَّدتَهُ شَهِدَ الوَغى","حُساماً وإِن أَشرَعتَهُ كانَ لَهذَما",31,"م",2,0],["هو العلمُ لاضافي على كلِّ ظلة","وكافيه مما نابه وعميده",32,"د",2,0],["هُوَ العَبدُ مالَم يَرضَ لَم يَرضَ سَيِّدُ","فُؤادي بِبُعدِي عَنهُ ما عِشتُ مُكمَدٌ",33,"د",1,0],["هُوَ العَبدُ حَقّاً قَرَّبَتهُ عِنايَةٌ","نِهايَتُهُ لَمتَكتَسِبَها بِدايَةٌ",34,"ه",1,0],["هُوَ العَلَمُ العالي بِلُبنانَ وَالَّذي","يُشار إِلَيهِ بِالبَنان إِذا بَدا",35,"د",2,0],["هوَ العبدُ عبدُ اللَّه سيّد خلقهِ","لهُ الكونُ عبدٌ والزمان خدومُ",36,"م",1,0],["هو العاقب الماحي محا الكفر سيفه","كذا قلم الشرك انبرى وبه انقطا",37,"ط",2,0],["هو العادل السلطان والملك الذي","به طابت الايام واعتدل الدهر",38,"ر",1,0],["هو العقل ينهاني فأسمع لحظة","ويسكرني ذاك الجمال فأسكر",39,"ر",1,0],["هو العَيْلَمُ المُخْضَمُّ والعالِمُ الذي","ينير الهُدى مما يفوه مِن الفَتْوى",40,"و",2,0],["هو العَلَمُ الهادي الذي يُهتدى بهِ","وطاعتُهُ فَرْضٌ عَلَيْنا ولا نَفْلُ",41,"ل",1,0],["هو العُروةُ الوثقاء في كل حالة","وليس يرى عن مقصد الرشد مقصدا",42,"د",2,0],["هو العدويّ العبقريّ المفهّم","المبصر والباب الحديد الممنع",43,"ع",1,0],["هو العبد للرحمن في الملك كلّه","ولكن سواه بعض عبدٍ لدى الملك",44,"ك",1,0],["هو العِلمُ دَعوى بينَهم وغوايةٌ","فمن كثُرَت صَيحاتُه سَمِعوه",45,"و",2,0],["هو العلم المَلىء بكل علم","هو البحر المحيط عَلى البحار",46,"ر",1,0],["هُوَ العوالمُ عن حصرٍ بأَجمعِها","وَملحق الجزءِ بالكلّي في العِظمِ",47,"م",1,0],["هُوَ العَربيّ كَم بَهرت لَدَينا","مَجاريه الحَميدة أَعجَميّا",48,"ي",2,0],["هُوَ العلم الشَهير وَمَن أُباهي","بِهِ القَمَر المُنير وَلا أُبالي",49,"ل",2,0],["هُوَ العالم العَلّامة العَلَمُ الَّذي","أَناف عَلى كيوان عزّاً وَمَوضعا",50,"ع",2,0],["هُوَ العيد لا عيد سِوى ما بِهِ الهَنا","لَنا وَسُرور الحاسِدين شُرورُ",51,"ر",1,0],["هُوَ العَربيّ الطَبع ذُو الهمّة الَّتي","هِيَ السمهريّ اللدن وَالصارم الهندي",52,"د",2,0],["هُوَ العالم النحرير وَالعلم الَّذي","بِهِ يَهتَدي السارون في المهم السرحا",53,"ح",2,0],["هُوَ العَبشُ نُهبى مِن يَدِ الدَهرِ فَاِنهَبِ","وَإِلّا وَلَم يَذهَب مِنَ الدَهرِ فَاِذهَبِ",54,"ب",1,1],["هو العقل في الإنسان إن ضل واهتدى","له الإختيار التام في النهي والأمر",55,"ر",1,0],["هو العَينُ الَّتي أَبصَرتُ فيها","وَصارَ سوادُ عيني في جُفونِه",56,"ن",2,0],["هو العالِمُ الذاتِ الَّذي لَيسَ مُحوَجاً","إِلى العِلم وَالأَعلامُ تَبدو وَتَشهدُ",57,"د",1,0],["هو العظيم بلا ريب ألست ترى","كلا يقبل كفيه ويلثمه",58,"م",2,0],["هو العمر لا غير عند الذي","يفكر في كل ما قد خلا",59,"ل",2,0],["هو العالمُ العلاّمةُ العلَم الذي","له همّةٌ علياءُ جاوزتِ النّسْرا",60,"ر",2,0],["هو العلم لا شيء سواه وإنما","وعا العلم فالإيمان وشح بالحلم",61,"م",1,0],["هو العالم المفتي بدين محمد","نوادر علم أَبهتت كل مبهت",62,"ت",1,0],["هو العالم النحرير والقلمُ الذي","رقى شَرَفاً يسمو على سائر الأكفا",63,"ف",2,0],["هو العبدُ قِنّاً وابنُ عبدك طاعةً","وعبدُ المعاصي والعِصِيِّ لعينُ",64,"ن",1,0],["هو العرس المشهود زفت مهاته","فلولا التقى غنت لديه المناصل",65,"ل",1,0],["هو العروة الوثقى الذي كلُّ حادثٍ","يخاف من الأيام لولا انفصامها",66,"م",3,0],["هو العارض الوسميُّ وهو وليّهُ","فيسراه فيها اليسر واليمنُ في اليّمنى",67,"ن",2,0],["هُوَ العَسَلُ الماذِيُّ طَوراً وَتارَةً","هُوَ السُمُّ وَالذيفانُ وَاللَيثُ عادِيا",68,"ي",2,0],["هو العنصر الكلي والدرة التي","بها كان بسط الدائرات الوجوديه",69,"ي",2,0],["هو العروة الوثقى هو الآية الكبرى","هو الرحمة العظمى على الكون مجريّه",69,"ي",2,0],["هو العلمُ في أَصلِ القَضايا نَتيجَةٌ","مُنَزَّهَةٌ عندَ اللَّبيبِ عن الجَهْلِ",70,"ل",1,0],["هو العدلُ الّذي بالوَصْفِ يعنو","له العلَمُ المعرَّفُ بالجَلالِ",71,"ل",1,0],["هو العَدَدُ الفرْدُ الّذي يجمَعُ الثّنا","وتصدُرُ عنهُ قِسمةُ الجَبْرِ والكَسْرِ",72,"ر",1,0],["هو العدلُ إلّا أنّه إذ يَرومُه","عدوٌّ بظُلمٍ كان أدهى وأظلَما",73,"م",2,0],["هو العام جاء السعد يحدو ركابه","وقد قدمت أيامه خير مقدم",74,"م",1,0],["هو العِلمُ لا حَدَّ له فاقتَطِف لِمَا","دَنا مِن جَناهُ الرَّطبِ إن شِئتَ تَغنَمُ",75,"م",1,0],["هو العِلمُ لم يُدرَك بغيرِ تَعَلُّمِ","ودونَ اجتهادٍ لا يكون التَّعلُّمُ",76,"م",1,1],["هو العظيم الذي علا شانُهُ","وقام بالكفتين ميزانُهُ",77,"ن",2,1],["هو العقل عقل الكل فرد جوهر","يلوح ويخفى عن ضيا وهو شارع",78,"ع",1,0],["هوَ العُمَرِيُّ الباذخُ الشَّرفِ الذي","حباهُ بهِ الفاروقُ وهوَ بهِ أحرَى",79,"ر",2,0],["هُوَ العُودُ لا ثَمَرٌ عِندَهُ","ومَا ينفَعُ العُودُ دُونَ الثَمَرْ",80,"ر",1,0],["هو العُمَرِيُّ الطَّاهرُ النَسَبِ الذي","تَمتَّعَ بالألطافِ مِنْ مَنِّ مَنْ مَنَّا",81,"ن",2,0],["هو العالمُ العلاّمةُ العاملُ الذي","لدى رَبِّهِ قد قامَ بالفَرْضِ والنَفْلِ",82,"ل",1,0],["هو العُمَريُّ السَيّدُ الماجدُ الذي","لهُ الشَرَفُ المحفوظُ فَرعاً عنِ الأصلِ",83,"ل",1,0],["هُوَ العملُ الذي أصبَحْتَ فيهِ","على العمّالِ كُلَّهِمُ شَهِيْدَا",84,"د",2,0],["هو العظيمُ وفيه مع تَعَاظُمِه","تواضُعٌ قد تَوَلَّى رَفْعَ رِفْعَتِه",85,"ت",2,0],["هو العظيم وإن كنت الحقير عسى","مني يحوز رضى الرحمن تمجيد",86,"د",1,0],["هُوَ العَصرُ وافى ضاحِكاً عَن فُنونِهِ","وَقَد كانَ مِن قَبلُ عَلَيكُم تَأَجَّما",87,"م",2,0],["هو العالمُ الحبر الهمام يزينهُ","منَ الدين علمٌ ملؤه الصبر والحلمُ",88,"م",1,0],["هو العزيزُ الّذي جبريل لازمهُ","في مَهدهِ وكَساه فاخراً الحللِ",89,"ل",1,0],["هو العالم الحبر التقيّ أبو الرضا","وَمَن جلّ قدراً أعظم 