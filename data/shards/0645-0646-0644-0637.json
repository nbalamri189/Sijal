{"poems":[[79,"صاح ما أعطر القبول بنمه","https://www.aldiwan.net/poem36081.html","الخفيف"],[208,"إني لأحسد مقلتي عليكا","https://www.aldiwan.net/poem53210.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[376,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[505,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101032","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53061","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204503",""],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128918","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36289","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36512","الدوبيت"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78303","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136921",""],[5122,"أحبهاااا","https://www.poetsgate.com/ViewPoem.aspx?id=20463",""],[5135,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=201796",""],[5219,"دموع أراكان","https://www.poetsgate.com/ViewPoem.aspx?id=194365",""],[5219,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=194428",""]],"verses":[["مَنْ لِطَرْفِي بِنَظْرَةٍ وَلأَِنْفِي","فِي رُبَاهَا وَفي ثَرَاهَا بِشَمَّهْ",0,"م",2,0],["من لطف إشفاقي ورقة غيرتي","إني أغار عليك من عينيكا",1,"ك",2,0],["مِن لُطفِهِ ما مَرَّ قَطّ بِنِسوَةٍ","إِلّا وَسَلَّمَ أَو عَلى صِبيانِ",2,"ن",1,0],["مَن لَطَليقِ الدَمعِ في","أَسرِ الغَرامِ موثَقِ",3,"ق",1,0],["مَن لطُولِ الهمِّ والحَزنِ","ففُؤادي ليسَ يَصحَبُني",4,"ن",2,1],["من لطيف سارياً","وانسق علينا حالهم",5,"م",1,0],["من لطفها الراح والريحان نشرهما","فللقلوب بها طيبٌ وإثمال",6,"ل",1,0],["من لطرح الفصوص في الكاكمي","ات وخفق البنوج والجارات",7,"ت",1,0],["من لطود هوى وكان عظيما","من لغصن ذوي وكان نصيرا",8,"ر",2,0],["من لطاف الأسماك واحدةٌ","أقبلت والمياه محتبكه",9,"ك",2,0],["من لطفلٍ لم يقض عهد الفطام","قد رماه من المقادير رام",10,"م",1,1],["مِن لطفكَ هَمَّ شَملُ حُزني بِشَتات","مَع عَطفِكَ لَم يُخشَ عَلى العُمرِ فَوات",11,"ت",1,1],["مِن لطفك ما أَقَلَّ حَظّا فَمُهُ","لو فوك بقدر وُسعه أَعطاهُ",12,"ه",1,0],["من لُطفِكُم شَرفوا ناد يفوز بكم","فَاِن طَلَعتكم أَنسى وَمرآني",13,"ي",1,0],["مَن لطرفٍ يرى اليتيم الصغيرا","ليلة العيد كيف بات حسيرا",14,"ر",2,1],["من لطفها لأهزهاأريح تهتز","ترمس هوانا بيننا بس،رمسي",15,"س",2,0],["مَنْ لطفْلٍ قدْ تَلوَّى مُوْجعا","باكيَ الطَّرْفِ يسحُّ الْأدْمعا",16,"ع",2,1],["من لطفل يحتمي من قاتل ؟","من لأم من عتي قد ذبح ؟",17,"ح",1,0],["من لطفل يرتجي سندا","آهة الأوجاع قد صرخت",18,"ت",1,0]]}