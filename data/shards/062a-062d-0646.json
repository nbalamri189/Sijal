,[5431,"كليّ معك ...","https://www.poetsgate.com/ViewPoem.aspx?id=199533",""],[5582,"أَتَعْلَمُ ذاتُ الغُنْجِ أَمْ لَيْسَ تَعْلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=187302",""],[5616,"نعم أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=203492",""],[5652,"مرت مواني رحلة الذات في غاء","https://www.poetsgate.com/ViewPoem.aspx?id=181103",""],[2599,"فى وداع شوقى","https://www.poetsgate.com/ViewPoem.aspx?id=14004",""],[5763,"تحية للمعلم","https://www.poetsgate.com/ViewPoem.aspx?id=27064",""],[5818,"تحنّن واشفِ لي ياربّ أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=200196",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[5956,"يا أعز الناس","https://www.poetsgate.com/ViewPoem.aspx?id=182042",""],[5956,"تحنو على أثدائها الأشجارُ","https://www.poetsgate.com/ViewPoem.aspx?id=183448",""],[5956,"أودَى شقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=192798",""],[5956,"فرحي برجعاكم","https://www.poetsgate.com/ViewPoem.aspx?id=193196",""],[5956,"حفاوة أحفادي","https://www.poetsgate.com/ViewPoem.aspx?id=199852",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[6052,"ثمار الخير","https://www.poetsgate.com/ViewPoem.aspx?id=35377",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[463,"حماها بأطراف الرماحِ حماتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59996&r=&rc=52",""],[463,"دعاها معقَّلة ً بالعراقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60165&r=&rc=221",""],[463,"بلوتُ هذا الدَّهرَ أطوارهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60087&r=&rc=143",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""]],"verses":[["تَحِنُّ إِلى تَرعِيَّةٍ لَم يُرِد بِها","وَبيءَ المَراعي وَالنِطافَ الأَواجِنِ",0,"ن",1,0],["تَحِنُّ وَالحَنَّةُ لِلمُشتاقِ","ما أَولَعَ الحَنينَ بِالنِياقِ",1,"ق",1,0],["تَحِنّينَ إِلّا أَنَّ بي لا بِكِ الهَوى","وَلَي لا لَكِ اليَومَ الخَليطُ المُوَدِّعِ",2,"ع",1,0],["تَحنو المُلوكُ عَلَيهِ مِن جَنَباتِهِ","كَالقَلبِ حانِيَةٌ عَلَيهِ الأَضلُعُ",3,"ع",1,0],["تَحِنُّ الرُبى لِلقَطرِ لا لِغَمامِهِ","وَما تَنفَعُ السُحبُ السَواري بِلا قَطرِ",4,"ر",1,0],["تَحنو عَلَيهِ الرُبى ظِلّاً وَتَستُرُه","عَنِ النَواظِرِ أَذيالُ الأَعاصيرِ",5,"ر",1,0],["تَحِنُّ إِلى حَرْبٍ أَخُوضُ غِمارَها","بِجُرْدٍ يُبارِينَ القَنا في الأَعِنَّةِ",6,"ه",1,0],["تَحِنُّ إِلى ماءِ الصّراةِ رَكائِبي","وصَحْبي بشَطَّيْ زَرْنَروذَ حُلولُ",7,"ل",1,0],["تَحِنُّ حَنينَ النِّيبِ شَوْقاً إِلى الحِمى","ومَطْلَبُهُ مِنْ سَفْحِ كاظِمَةٍ صَعْبُ",8,"ب",1,0],["تَحِنُّ لِفُقدانِ القَرينِ كَأَنَّها","فَصيلٌ حَماهُ الخِلفَ رَبُّ عِيالِ",9,"ل",1,0],["تَحِنُّ بِها الدَبورُ إِذا أَرَبَّت","كَما حَنَّت مُوَلَّهَةٌ عَجولُ",10,"ل",1,0],["تحنو عليها تارةً بافترار","وتارةً ترفعها بافتخار",11,"ر",1,0],["تَحْنُو عَلَيْكَ صِلادُهُ بِظِلالِهَا","وَتَقَرُّ فِي وَادٍ مِنَ التَّحْنَانِ",12,"ن",1,0],["تَحِنُّ إِلى الدَهنا بِخَفّانَ ناقَتي","وَأَنّى الهَوى مِن صَوتِها المُتَرَنِّمِ",13,"م",1,0],["تَحِنُّ إِلى قَصرِ اِبن حَوطٍ نساؤُكُم","وَقَد مالَ بِالأَجيادِ وَالعُذَرِ السُّكرُ",14,"ر",1,0],["تُحَنّى العِظامُ الراجِفاتُ مِنَ البِلى","وَلَيسَ لِداءِ الرُكبَتَينِ طَبيبُ",15,"ب",1,0],["تَحِنُّ قَلوصي بَعدَ هَدءٍ وَهاجَها","وَميضٌ عَلى ذاتِ السَلاسِلِ لامِعُ",16,"ع",1,0],["تحنو على خدر القيام وترعوي","بفناه في سمح الوعاء معلق",17,"ق",1,1],["تَحِنُّ مَطافيلُ الرِباعِ خَلالَهُ","إِذا اِستَنَّ في حافاتِهِ البَرقُ أَثجَما",18,"م",2,0],["تَحِنُّ نَفسي إِلى السَواقي","إِلى الأَقاحي إِلى الشَذاء",19,"ا",2,0],["تَحِنُّ إِلى مَرأى الغَديرِ وَصَوتِهِ","وَتَحرُمُ مِنهُ وَالغَديرُ قَريبُ",20,"ب",1,0],["تَحنو عَلى ظَبي وَقَسوَرَةٍ","أَرَأَيتُمُ سِرَّينِ في صَدرِ",21,"ر",1,0],["تَحُنُّ إِلى بِلادِ الشامِ نَفسي","أَقطُرَ الشامِ حَيّاكِ الغَمامُ",22,"م",1,0],["تَحنو عَلى قَلَمي يَميني وَالدُجى","حانٍ عَلى الفَتَياتِ وَالفِتيانِ",23,"ن",1,0],["تَحِنُّ إِلى سَلمى بِحُرِّ بِلادِها","وَأَنتَ عَلَيها بِالمَلا كُنتَ أَقدَرا",24,"ر",2,1],["تَحِنُّ فَيُذري نيلُها لَكَ دَمعَةً","وَيُعوِلُ قُمرِيٌّ عَلى الدَوحِ مِرنانِ",25,"ن",1,0],["تحنّ له كأنك لم تضعه","فسعه بجبنك المأثور سعه",26,"ه",1,0],["تَحنو السَماءُ عَلى زَكِيِّ سَريرِهِ","وَيَمَسُّ جيدَ الأَرضِ طيبُ رِكابِه",27,"ب",2,0],["تَحنو مَناكِبُهُ عَلى شُعَبِ الهُدى","وَتُطِلُّ سُدَّتُهُ عَلى سينائِهِ",28,"ا",3,0],["تَحُنُّ إِلى ذاكَ الزَمانِ وَطيبِهِ","وَهَل أَنتَ إِلّا مِن دَمٍ وَحَنانِ",29,"ن",1,0],["تَحَنّى عَلَيهِم وَالمَوارِدُ سَهلَةٌ","وَأَفرَجَ عَنهُم بَعدَما أَعضَلَ الخَطبُ",30,"ب",1,0],["تَحِنُّ بِزَوراءِ المَدينَةِ ناقَتي","حَنينَ عَجولٍ تَبتَغِ البَوَّ رائِمِ",31,"م",1,1],["تحِنُّ إليك حانةُ باطر تحى","ويبكي الزَّنْدِرُودُ عليك شجوى",32,"و",2,0],["تَحِنُّ إلى القَومِ الذين ترحَّلُوا","وتَرجُفُ بالقَومِ الذين أَقامُوا",33,"م",3,0],["تَحِنُّ فيه الكُماةُ المُعْلِمونَ إلى","وِرْدِ الحُتوفِ إذا حنَّتْ صَواهِلُه",34,"ل",2,0],["تَحِنُّ شَوْقاً إلى الأَسْرى أرامِلُه","إذا بَكَيْنَ علىالقَتْلى ثَواكِلُه",34,"ل",2,0],["تَحِنُّ جِمالُنا صُوراً إليها","فأحسِبها تَرى مِنها جَمالا",35,"ل",2,0],["تَحِنُّ إليكَ أبكارُ القوافي","إذا اجتُليَت رَواحاً وابتكِارا",36,"ر",2,0],["تَحِنُّ إِلى مِثلِ الحَبابيرِ جُثَّمٍ","لَدى سَكَنٍ مِن قَيضِها المُتَفَلِّقِ",37,"ق",1,0],["تَحِنُّ إِلى مِثلِ الحَبابيرِ جُثَّمٍ","لَدى مَنتِجٍ مِن قَيضِها المُتَفَلِّقِ",38,"ق",1,0],["تَحِنُّ عِداتُهُ إِثرَ التَقاضي","وَتُنتَجُ مِثلَما نَتِجَ العِشارُ",39,"ر",1,0],["تحنو عليَّ غصونُهُ","ويرقُّ لي فيهِ النسيمُ",40,"م",1,0],["تحنُّ على الفقيرِ حنينَ أمٍّ","وترحمُهُ فُوَيتَ الموتِ وَيْبَا",41,"ب",2,0],["تَحِنُّ وَدَمعُ الشَوقِ يَسجِمُ وَالنَدى","وَقَرَّ بِعَيني أَن تَحِنَّ وَيَسجُما",42,"م",2,0],["تَحِنُّ إِلى الخَيرِيِّ نَفسي وَيَغتَدي","نَسيبِيَ في تَصحيفِهِِ يَمَلأُ الصُحفا",43,"ف",2,0],["تَحِنُّ وَتَصبو كُلُّ عَينٍ لِحُسنِهِ","كَأَنَّ عُيونَ الناسِ فيهِ قُلوبُ",44,"ب",1,0],["تَحِنُّ بِأَعلى الهَيجِ ذي السِدرِ ناقَتي","لِعِرفانِ دارٍ قَد أَحالَت رُسومُها",45,"م",3,0],["تَحِنُّ إِذا ذُكِرَت مَرَّةً","حَنينَ الطَرِيفِ أَرادَ النِزاعا",46,"ع",2,0],["تَحَنَّن عَلَيَّ هَداكَ المَليكُ","فَإِنَّ لِكُلِّ مَقامٍ مَقالا",47,"ل",2,0],["تَحنو لِأَطلائِها عينٌ مُلَمَّعَةٌ","سُفعُ الخُدودِ بَعيداتٌ مِنَ الذامِ",48,"م",1,0],["تَحنو بِجُؤشوشِها عَلى ضَرَمٍ","كَقَعدَةِ المُنحَني مِنَ الخَزَفِ",49,"ف",1,0],["تَحِنُّ صَبابَةً في كُلِّ يَومٍ","إِلى حُبّى وَقَد كَرَبَتكَ كَربا",50,"ب",2,0],["تحنو على اليأس في قلبي فتغمره","نورا وتبدع فيه الصّبر والجلدا",51,"د",2,0],["تَحْنُو عَلَيْهِ كَأُمِّهِ","وَتَضُمُّهُ ضَمَّ الإِخَاءْ",52,"ا",2,0],["تحنانَ ساجعة الحمائم في الضحى","وزفير أعواد الجحيم الثاني",53,"ن",2,0],["تحنو على ضعفِ من طال الطريقُ به","حنانَ والدةٍ ثَكْلَى بمولود",54,"د",1,0],["تحن إلى الغد الأهنى","فيمضي قبل أن ياتي",55,"ت",2,0],["تحنو على قلمي يميني والدّجى","حان على فتيات والفتيان",56,"ن",1,0],["تحنو على القلب الجريح فينثني","ريّان من رحماتها مطلولا",57,"ل",2,0],["تحنو الدموع على القبور فتورق الصمّ الصلاب","ولها إلينا لهفة ولطول غربتنا انتحاب",58,"ب",1,0],["تحنى العظامُ الراجغاتُ منَ البلى","وليسَ لداءِ الركبتينِ طبيبُ",59,"ب",1,0],["تحنن تأود واذكر الود وانعطف","امل وتفضل واحب وانعم وعوض",60,"ض",1,0],["تحنن برمش الطرف بالعطف والرضى","للاج قصير الباع حيرة الشاني",61,"ن",2,0],["تحن إلى ظلٍّ من الرخو وأرف","وطول جمامٍ رافه وليان",62,"ن",1,0],["تَحِنُّ لِوَصلِ حَضرَتِهِ القَوافي","فَتَأتِيهِ مُنَمَّقَةً بَدَادِ",63,"د",1,0],["تحن للقياه الوزارة مذ نشا","ولا لوَمِ إن حنّت وطال رزينُها",64,"ن",3,0],["تحن إلى ارض الحصيب جوانحي","كما حن أيام الفصال فصيل",65,"ل",1,0],["تَحِنُّ فتُبْدي ما بها مِنْ صَبابَةٍ","وأُخْفي الذي لولا الأَسى لَقَضاني",66,"ن",2,0],["تحنّب صاحب السوء اختيارا","فشرّ السيف فيه وفي رميله",67,"ل",2,0],["تحنّ إلى الغنى النفس الفقيره","ولا تدري لعل الفقر خيره",68,"ر",2,1],["تَحنُو المَنونُ إِلى حَوبائِهِ وَلَعاً","يهدّمُ الشَيءَ يَأبى أَن يُدانيهِ",69,"ي",2,0],["تَحنو إِلى أَكحَلِ العَينَينِ رانَ بِهِ","نَومُ النَهارِ فَما يَنفَكُّ وَسنانا",70,"ن",2,0],["تَحَنْظَلَ عيشي فيه من بَعْدِ حُلوهِ","وأجَّنَ مائي قلةُ الوصلِ واللِّقَا",71,"ق",2,0],["تَحَنْظَلَ عيشي بعدَهُ وتأجّجتْ","مناهلُ وردي وهي صافيةٌ خُضْرُ",72,"ر",1,0],["تَحِنُّ إِلى الغُوَيرِ لِطيبِ مَرعى","بِصَحراءِ الغُوَيرِ وَبَرد وردِ",73,"د",1,0],["تَحِنُّ إِذا بَدا بِالغَورِ وَهناً","وَميضٌ أَو أَضاءَت مِنهُ نارُ",74,"ر",1,0],["تحنُّ إليكِ نفسي كي تَحِنِّي","وتبكي مُقلتي لِترى بُكاك",75,"ك",1,0],["تحنُّ إِلى لبنانَ نفسي وتَشتهي","لأهليه عيشَ الخصبِ والعدل والأمن",76,"ن",1,0],["تحن لترداد الحَنين حشاشَتي","وَيَستَعذب التَعذيب قَلبي المعذب",77,"ب",1,0],["تحِنُّ إلى مَلْعَبٍ للظّباء","بِكُثْبانِ رامَةَ أو غُرَّب",78,"ب",1,0],["تحنو فتسعدُ قلب مبتئسٍ","في عالم نشوان ممراح",79,"ح",1,0],["تَحنو عليَّ عواطِفاً أَفنانُه","عندَ المبيت به حنوّ المُرضِعِ",80,"ع",1,0],["تحنو الغصونُ على مَنْ يستظلُّ بها","كأُمهاتٍ إذا يرأمنَ أطفالا",81,"ل",2,0],["تَحنو إِلى كُلِّ فِينانٍ أَخي غَزَلٍ","صَوادِفٌ عَن ذَوي الأَسنانِ وَالشيبِ",82,"ب",1,0],["تَحِنُّ عَلى شَطِّ الفُراتِ وَقَد بَدا","سُهَيلٌ لَها مِن دونِهِ سَروُ حِميَرا",83,"ر",2,0],["تَحِنُّ إلى شَرقيِّ نَعْمانَ ناقتي","وَمسْرحُها الأدنَى بجَرْعاءِ مالِكِ",84,"ك",1,1],["تَحِنُّ بباب القادسية ناقتي","وسعدُ بنُ وقّاصٍ عليَّ أميرُ",85,"ر",1,0],["تَحِنُّ قَلوصي نَحوَ صَنعاءَ إِذ رَأَت","سَماءَ الحَيا مِن نَحوِ صَنعاءَ تَبرُقُ",86,"ق",1,0],["تَحِنُّ إِلى مَرعىً بِصَنعاءَ مُخضِبٍ","وَشربٍ رَواءٍ ماؤُهُ لا يُرَنذَقُ",86,"ق",1,0],["تَحِنُّ وَيَأبى أَن يُساعِدَكَ الهَوى","وَلَلمَوتُ خَيرٌ مِن هَوىً لا يُساعِدُ",87,"د",1,0],["تَحِنُّ نياقُ الظاعنين وما لها","تَحِنُّ وفي القلب المشوق حَنينُ",88,"ن",1,1],["تَحِنُّ إلى منازلها بسلع","عَفَتْها الهوجُ والريح العفاء",89,"ا",2,0],["تَحِنُّ إلى محيَّاك وهي مشوقة","إليك حنين المستهام إلى الوصل",90,"ل",1,0],["تحنُّ إلى مرآك في كلِّ ساعةٍ","فتأسَفُ إنْ سافرتَ عنهم في السفر",91,"ر",1,0],["تَحِنُّ إلى أرض العراق ركائبي","وصحبي بأرض الشام طابَ مقيلها",92,"ه",2,0],["تحنّ إلى أيام سلعٍ ورامةٍ","وما دونها في السالفات قراب",93,"ب",1,0],["تحنُّ إلى أعلام سلعٍ ولعلع","لقد فتكت بالحبّ سلع ولعلع",94,"ع",1,0],["تحن يداه لبذل الأيادي","على سائليه حنين النياق",95,"ق",1,0],["تحنُّ إِليه من شَغَفٍ وتحنو","عليه ما تَلَتْهُ أو تَلاها",96,"ا",3,0],["تحنُّ إلى أترابها في بيوتكم