بال","https://www.poetsgate.com/ViewPoem.aspx?id=49565",""],[5045,"شعاري المجد","https://www.poetsgate.com/ViewPoem.aspx?id=184874",""],[5136,"قسما باللها وورد الخدود","https://www.poetsgate.com/ViewPoem.aspx?id=121562",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[778,"مازج بروحك روح الراح تحييها","https://www.poetsgate.com/ViewPoem.aspx?id=89235",""],[5198,"سلة اوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=134769",""],[5230,"دهاء معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=10997",""],[5324,"واحد منهم.","https://www.poetsgate.com/ViewPoem.aspx?id=212489",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5401,"بدون عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=142370",""],[5526,"الصحبه","https://www.poetsgate.com/ViewPoem.aspx?id=192528",""],[5526,"بين الرعايا بالمدارس مساكين","https://www.poetsgate.com/ViewPoem.aspx?id=199780",""],[5537,"فيها حاجه حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=214540",""],[5573,"عشنا عيال احرار","https://www.poetsgate.com/ViewPoem.aspx?id=201930",""],[5573,"نامت عيون الجاهل الي ماعرف درب الرواه","https://www.poetsgate.com/ViewPoem.aspx?id=205469",""],[5619,"العزبة ١","https://www.poetsgate.com/ViewPoem.aspx?id=211364",""],[5725,"اخفى الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=197618",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[5756,"الاولي والتالي","https://www.poetsgate.com/ViewPoem.aspx?id=5415",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[5848,"سوق الفيصلية","https://www.poetsgate.com/ViewPoem.aspx?id=49228",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5956,"دعوت له بخيراتٍ كباراً","https://www.poetsgate.com/ViewPoem.aspx?id=194174",""],[5956,"أقصوصة شغالتين ظالمتين لإنسانية سيدهما الألماني العجوز:","https://www.poetsgate.com/ViewPoem.aspx?id=207868",""],[5976,"الحب بقلوب المخاليق","https://www.poetsgate.com/ViewPoem.aspx?id=30822",""],[6031,"بكيتُكِ لو أنّ الدموع تُديلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46287",""],[6038,"العيد الوطني للملكة 1422ه","https://www.poetsgate.com/ViewPoem.aspx?id=25699",""],[6056,"عكّر الله مزاجه","https://www.poetsgate.com/ViewPoem.aspx?id=130324",""],[6056,"صديق اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=156695",""],[6056,"بالخير متبرّع","https://www.poetsgate.com/ViewPoem.aspx?id=156715",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""],[6117,"طَيْبَةُ الطَّيِّبَة","https://www.poetsgate.com/ViewPoem.aspx?id=183710",""],[463,"حيها أوجهاً على السفحِ غرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60067&r=&rc=123",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""],[4222,"لائم للمحب غير ملائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52884&r=&rc=176",""]],"verses":[["واحِدٌ طائِشٌ وثانٍ مُصيبٌ","ليسَ يُنْجي منْها اشْتِمالُ حِذارِ",0,"ر",1,0],["واحِدٌ فَوقَهُ وَآخَرُ يَحشو","بَطلَيموسِهِ المُقَوَّمِ فاهُ",1,"ا",2,0],["وَإِحداهُما ملكُ اليَمينِ وَعِتقُها","صَحيحٌ وَما في خَلعِها لِامريءٍ عارُ",2,"ر",1,0],["واحِدٌ سَلَّمَ الجَميعُ لَهُ الأَمرَ","فَكانَ الخُصوصُ وَفقَ العُمومِ",3,"م",1,0],["وأحدث مجداً طريفاً له","وأضرب عن مجده التالد",4,"د",1,0],["واحد في النعيم يلهو وألف","في شقاء وأبؤس واعتلال",5,"ل",1,0],["وأحدث نهضةً في العرب هزّت","جنوب الأرض كالريح السهوك",6,"ك",1,0],["واحداً في مراتبِ الفضلِ تلقى","حول أبوبهِ من الخلقِ جندا",7,"د",2,0],["وأحدث نقصانُ القُوىَ بين ناظري","وسمعي وبين الشخصِ والصوت بَرْزخا",8,"خ",2,0],["واحدةُ الأم ولكنَّها","مثلك حاشاها أبٌ واحدُ",9,"د",1,0],["وأحْدث أحْداثاً أضرَّت بمنزلي","يريغُ إلى بيْعِيْهِ منه المسالكا",10,"ك",2,0],["واحدٌ في الفِعال يُغْرِق مُدَّا","حُك من قبل أن يُرى إغراقُك",11,"ك",1,0],["واحدُ الجودِ لا تمجُّ سؤالاً","أُذناهُ ولا تُليقانِ عَذْلا",12,"ل",2,0],["وَأَحدَثُ مَعهَداً مِن أُمِّ وَهبٍ","مَعَرَّسُنا بِدارِ بَني النَضيرِ",13,"ر",1,0],["واحد أنت من عباقرة ما","توا على الارض غيلة للخلود",14,"د",1,0],["واحد انت من ملوك المعاني","ما له في سلطانه من ثان",14,"ن",1,0],["واحِدُ القَصدِ طَرفُهُ في اِرتِفاعٍ","مِن سُمُوٍّ وَكَفُّهُ في اِنصِبابِ",15,"ب",1,0],["واحِدُ دَهرٍ إِن بَدا نائِلاً","ثَنّاهُ في الأَقوامِ أَو رَدَّدَه",16,"د",2,0],["واحِدُ العَهدِ في تَنَقُّلِ قَومٍ","ظاهِرٍ عَن نِفاقِهِم إِخلاصُه",17,"ص",2,0],["وَأَحدَثُ عَهدِ وَدَّكَ بِالغَواني","إِذا ما رَأسُ طالِبِهِنَّ شابا",18,"ب",2,0],["وأحدثَ إخمادُه زُرْقةً","تَأجَّجُ في مُدمَجٍ أحمَرِ",19,"ر",1,0],["وأحدَقْنا بأزهرَ خا","فقاتٌ فوقَه العَذَبُ",20,"ب",1,0],["واحدة السخط والأنين","واحدة الحقد والخصام",21,"م",1,0],["وأحداث آثار إذا ما غشيتُها","فَجَرْتُ عليها أدمعي والقوافيا",22,"ي",2,0],["وأحدُّهم سيفاً وأكثرُهُمْ ندى","وأعزُّ منزلةً وأوضحُ منهجا",23,"ج",2,0],["وَأَحدَثَ قَلبُهُ خَطَراتِ حُبٍّ","وَأَحدَثَ شَوقُهُ حُزناً عَراها",24,"ا",3,0],["وَأُحَدِّثهُ ما تَضَمَّنتُ مِنهُ","إِذ خَلا اليَومَ لِلمَسيرِ المَراضُ",25,"ض",1,0],["واحِدٌ كَأُمَّةٍ","لا يَخافُ الجَحفَلا",26,"ل",2,0],["واحِدَ قَدٍّ في اِكمِلالِ قَدِّهِ","قُلتَ اِرتَدِفهُ فَاِنثَنى لِزَندِهِ",27,"د",2,0],["واحِدَةٌ أُعطيكَ فيها العَشا","إِن قُلتَ إِنّي عَنكَ صَبّارُ",28,"ر",1,0],["وَأَحَدَّ مِن وَلَدِ الجَديلِ أَعارَهُ","طَرفُ النُسوعِ أَخَذنَ في أَقرابِهِ",29,"ب",2,0],["وأَحدقتْ بحِصْنها الأَفاعي","وكُلُّ صِلٍّ أَسْودٍ شُجاعِ",30,"ع",1,0],["وأحدٌ جالوا بها وجالا","وانكشفت بينهما سجالا",31,"ل",2,0],["وإحدى بناتِ الدَّهرِ تَنْسِفُ أُحْدَهُ","وتَهدِم بالتدمِيرِ بنُيانَ تَدْمُرِ",32,"ر",1,0],["واحِدٍ اِعتَضتُهُ بِأَلفٍ","كُنتُ إِلى الكَهفِ مِنهُ آوي",33,"ي",1,0],["وأحَدُّ من سيف الجبان ورمحِهِ","يومَ الوغَى، سوطُ الشُّجاع المُعْلَمِ",34,"م",1,0],["واحدُ الجودِ لاتمجُّ سؤالاً","أُذناهُ ولا تُليقانِ عَدْلا",35,"ل",2,0],["وَأَحدَقوا بِأَبي كَعبٍ لِيَنصُرَهُم","وَهَل تُراعُ لُيوثُ الغابِ بِالشَبَبِ",36,"ب",1,0],["واحِدٌ أَفضَلُ مِن أَلفِ أَلفٍ","فَخُذِ الواحِدَ وَاِسفِ الأُلوفا",37,"ف",2,0],["وَأَحدثَ بينَ المُسلمينَ نَظيرهم","بُرستنتَ صاروا مثلهُم فرقةً أخرى",38,"ر",2,0],["واحدُ الفضلِ أنتَ لم تُلفِ شِركا","ما زَوى اللَّه قطُّ جدواهُ عنكا",39,"ك",2,0],["واحدُ الذاتِ وَالصفاتِ والأفعا","لِ وفي الكلّ ما له شركاءُ",40,"ا",2,0],["وَاَحدَثَت لِي بِغضَةً وَشَنِفَت","وَسُرُح دَوسَرَة قَد شَرَفَت",41,"ت",1,0],["وَأحداثٌ أَصابَتني وَقَومي","يَذلّ مِنَ الحَليمِ لَها القِيادُ",42,"د",1,0],["واحد كيف شئت أنت وثان","كيفما شئته أنا وظنوني",43,"ن",2,0],["واحدٌ في عُلاهُ فردٌ ولكن","جمعَ اللَه فيه كل الوجود",44,"د",1,0],["وَأحدقَ الناسِ في صَيد وأحسنهم","رَمياً وَأَبعَد مِن بخل وَمِن جُبُنِ",45,"ن",1,0],["واحْدُ في أرض نجد عشّاق سلمى","واجعل المطربات بعضَ حداتك",46,"ك",1,0],["واحد في الفضل من ابنائها","جامع فضل امتنان وامتداح",47,"ح",1,0],["واحد الامة هدا وَهدى","غوث أَهل الارض كهف الفقرا",48,"ر",2,0],["وَأَحداقُ الأَزاهرِ شاخصاتٌ","إِلينا حيثما مِلْنا روان",49,"ن",1,0],["وَاحِدٌ مِنهُمُ يُرَتِّبُ لِلما","ءِ وَلَمْ يَدْرِ غَيْرَ كَسْرِ الجِرارِ",50,"ر",1,0],["واحِدَةَ الحُسنِ الَّتي أَمسَيتُ مِن","وَجدي بِها بَينَ البَرايا أَوحَدا",51,"د",2,0],["واحِدَةُ الحُسنِ الَّتي عَن حُسنِها","سارَت تَفاصيلُ الجَمالِ وَالجُمَل",52,"ل",1,0],["وَاحْدُ المطايا إلى أرضِ العراق بنا","فما أَرى بيَ عن زَورائها زَوَرا",53,"ر",2,0],["وأحدَقَت حدقُ الأحداق محدقةً","بعرشها كونها سلطانة العز",54,"ز",1,0],["وأحدقت بفنا تابوت جثتها","أهل السما والفضا عن ضمِّهم حرجا",55,"ج",2,0],["وأحداثَ دهرٍ عِلّةٍ لم أُبَلّ","منها ومن غُلّةٍ لَمْ تُبَلْ",56,"ل",1,0],["وأحد حنين والمريسيع خيبر","قريظة والأحزاب فتح به النصر",57,"ر",1,0],["وَأَحداقُ الحدائِقِ ناظِراتٌ","إِليَّ بأعيُنِ الزَهرِ البَديعِ",58,"ع",1,0],["وَأَحدَق باللَيلِ الصَباحِ كَأَنَّهُ","بَياض بعين وَالظَلامُ سوادُ",59,"د",1,0],["وأحداثُ أيام تشبُّ ولم تَشِبْ","كأن لم يكن قبل المشيب شباب",60,"ب",1,0],["واحِدٌ حازَهُمْ وَهُمْ خَيْرُ خَلْقٍ","صَوَّر اللُّه بَيْنَ جِنٍّ وَإنْسِ",61,"س",1,0],["واحدٌ كالألْفِ لكنْ فاتَهُم","فهْو في الكفّةِ منهم أرجَحُ",62,"ح",1,0],["وأحدو بالروي مكلفات","وأزجر في 