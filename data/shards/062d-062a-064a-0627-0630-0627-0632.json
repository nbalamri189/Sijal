{"poems":[[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[32,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[369,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[520,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92374","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132112","البسيط"],[5431,"ليلى والذئاب....","https://www.poetsgate.com/ViewPoem.aspx?id=207188",""]],"verses":[["حَتّى إِذا زَلَجَت عَن كُلّ حَنجَرَةٍ","إِلى الغَليلِ وَلَم يَقصَعنَهُ نُغَبُ",0,"ب",1,0],["حتى إذا زوَتِ المطامِعُ وجهَها","عنه ، وقطَّبَتِ اللُبانةُ حاجبا",1,"ب",2,0],["حَتَّى إِذَا زَاغَ عَنْ تِلْقَآئِهِ اخْتَصَرَا","إِذَا يُعَارِضُهُ وَعْثٌ أَقَامَ لَهُ",2,"ه",1,0],["حتّى إذا زادَتْ بذاك فصاحةُ ال","أقلامِ حارَ النَّصْلُ لمّا أنْ رَنا",3,"ن",2,0],["حتّى إذا زحَف الفِرا","قُ غدَوتَ من فَرَقٍ تَفِرّ",4,"ر",1,0],["حتى إذا زفت إليه تبرجت","وأتته لا تمشي على استحياء",5,"ا",2,0],["حَتّى إِذا زالَ أَتى الخَريفُ","فَصلٌ بِكُلِّ سَوءَةٍ مَعروفُ",6,"ف",1,0],["حَتَّى إِذَا زَوْزَى الزَيَازِي هَزَّقا","وَلَفَّ سِدْرَ الهَجَرَيْنِ حِزَقا",7,"ق",2,0],["حتى إذا زعزعت ليلي زلازلُهُ","والصبح أسفر ترمينا عواذلُهُ",8,"ه",1,0],["حتى إذا زال أو زالت حرائره","أبصرته وهو في سرباله البالي",9,"ل",2,0],["حتى إذا زلّت لوهنٍ رجلها","وثبت عليها في النيوب تُقطّعُ",10,"ع",1,0]]}