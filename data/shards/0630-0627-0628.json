620",""],[5997,"بعثريني","https://www.poetsgate.com/ViewPoem.aspx?id=214249",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[6142,"أمريضا بالسير بنت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=155735",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""],[520,"قل لجمال الملك يا ابن الذي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577486",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[6237,"الحب الكاذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77889&r=&rc=31",""],[6294,"هل لامسّت معطفها ! ! !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69183&r=&rc=24",""],[6354,"أحاديث النازحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87924&r=&rc=1",""]],"verses":[["ذَابَ جِهَازُ الحَدِيدِ صَهْراً","إِلاَّ أَضَالِيعَهُ الضِّخَامَا",0,"م",2,0],["ذا بالنضارِ وهذا بالحديد فما","ينفكُّ آسرَ أحبابٍ وأعداء",1,"ا",2,0],["ذابَ السوادُ منَ العيونِ بها","فالدَّهرُ إثر الحمرِ والشهب",2,"ب",1,0],["ذابَت بِكُم يا أَهلَ بابِلَ مُهجَتي","فَتَنَغَّصَت بِالعَيشِ بَعدَ تَلَذُّذِ",3,"ذ",1,0],["ذابَ الكَرى عَن ناظِري بِفُراقِكُم","وَلَكُم جَلَوتُ بِنورِكُم طَرفي القَذي",3,"ذ",2,0],["ذا بِماءٍ يَسخو وَأَنتَ بِمالٍ","بِعَطاهُ تُستَعبَدُ الأَحرارُ",4,"ر",1,0],["ذابت حناناً يوم لقياك","وجرت أغاريداً على شفتي",5,"ي",1,0],["ذابلةٌ في الصُّفرِ مركوزَةٌ","لها من النّار سِنانٌ خذِم",6,"م",1,0],["ذاب لي بالراحِ منها بَرَدٌ","هل يكونُ الراحُ ذَوْبَ البَرَدِ",7,"د",1,0],["ذابَ منْ ثغرِكَ قلبي","يالَهُ قلباً وثغراً",8,"ر",2,1],["ذابِلة ناحِلة قَد مَحَت","يَدُ الأَسى القاسي محيّاها",9,"ا",3,0],["ذابَ عَلَيهِ لُعابُ لاعِبَةٍ","بِصارِمٍ لِلسَرابِ مُمتَخَطِ",10,"ط",1,0],["ذا بَنَانٍ لا تَلْمُسُ الذّهَبَ الأحْ","مَرَ زُهْداً في العَسجَدِ المُستَفادِ",11,"د",1,0],["ذابَ فلبي فَأْذَنْ لَهْ يَتَمَنّا","كَ وفيِه بَقِيّةٌ لِرَجَاكَا",12,"ك",2,0],["ذابتِ الرّوحُ اشتياقاً فهْيَ بَعْ","دَ نَفاذِ الدّمعِ أجرى عَبرَتي",13,"ي",1,0],["ذَابَ فُؤَادِي بِحُبِّ لَيْلَى","يَا لِفُؤَادٍ بَرَاهُ وَجْدُ",14,"د",1,0],["ذابَ سقاماً عَلَيكَ جِسمي","لَمّا تَرَكتَ الحَشا جُذاذا",15,"ذ",2,0],["ذابل والنجوم في قبضتيه","ذابلات كالغيد في كفّ أسر",16,"ر",1,0],["ذابت عليك قلوب الشاعرينَ أسىً","فما اعتذارةُ شعرٍ فيك لم يذبُ",17,"ب",1,0],["ذا بيدي نحو المنازل إذ خوت","عساها بخبر الظاعنين تجود",18,"د",1,0],["ذاب لهفا وكله زفرات","محرقات شبت به من هواكا",19,"ك",2,0],["ذاب لجين المزن لمّا رمى","معدنه البرق بمقياس نار",20,"ر",1,0],["ذابَ مِن فَرطِ شَوقِهِ القَلبُ حَتّى","عادَ مِمّا عَراهُ وَهوَ حَنيذُ",21,"ذ",1,1],["ذابِلٍ شاخِصٍ لَهُ مَتنُ ظَبيٍ","وَنَداتا عيرٍ وَساقا ظَليمِ",22,"م",1,0],["ذابَ قلبي أو كادَ يا ربَّةَ الحُ","سنِ خُذيهِ واستَطلِعي أسرارَه",23,"ر",2,0],["ذاب ذوب العطر مذ وقدت","للهوى نار على زهره",24,"ر",2,0],["ذاب قلبي عليه حين تدانى","بين عطفي مسلما عرضه",25,"ض",2,1],["ذَابَ قَلْبِي مِنَ الصُّدُودِ وَلَوْلاَ","مَا أُرَجِّي مِنَ الْوِصَالِ قَضَيْتُ",26,"ت",1,1],["ذابت حشايَ بنارِ حبٍّ نورُها","وجهٌ جميلٌ منه وجهي أصفرُ",27,"ر",1,0],["ذابهجة الكون ذا سر الهداية ذا","روح الوجود المصفى خير مختار",28,"ر",1,0],["ذابَ مِنَ الشَوقِ فَلَو فُتِّشَ عَن","هُ بردُه لَم يُرَ غَيرُ البُردِ",29,"د",1,0],["ذا بنانٌ بِالثريّا ختِّما","قالباً بِالشمسِ ظهر المترسِ",30,"س",1,0],["ذابَتْ زُبَيْدَةُ مِن شَوْقٍ لِسَيِّدِها","عُثْمانَ والنجمُ بِالنِّيرانِ مُشْتَعِلُ",31,"ل",1,1],["ذابَ قلبي لثَغْرِه هل رأيتُمْ","بَرَداً قبلَهُ يُذوِّبُ جَمرا",32,"ر",2,0],["ذاب حبّاً لفضةٍ","ذوبَ صُفرٍ ببَوتَقا",33,"ق",2,0],["ذا باجمال وقول مختصر","ثم إن شئت تفاصيل الجمول",34,"ل",1,0],["ذابَ له الغَيْمُ لُجَيْناً وقَدْ","جَمَّدَ في أَغصانِهِ عَسْجَدا",35,"د",2,0],["ذا بهذاك فما أدري بما","خصّ بي جرح صدود ونفور",36,"ر",1,0],["ذابَ في مسمعيّ منهُ رحيقٌ","فغدا القلبُ حائراً سكرانا",37,"ن",2,0],["ذاب شوقاً فهل له من دواءٍ","غير قرب من بعد بعد الجوار",38,"ر",1,0],["ذابت عليها حصاةُ قلبي","يا من رأى جمرةً تذوبُ",39,"ب",1,0],["ذابوا لديهِ كما ذاب الرَّصاصُ اِذا","رفَّعتَه حينَ تبلوه على النارِ",40,"ر",1,0],["ذا بوقع خطى في بيته طرقت","اسماعه فانجلى ما كن في الدجى",41,"ج",2,0],["ذاب الفؤاد والحذق","من ومضه بين الغسق",42,"ق",1,0],["ذاب الفؤاد وانجرح","من شدة اللذخرج",42,"ج",1,0],["ذاب الفؤاد الكاعب","من مقلتيه وهج",42,"ج",1,0],["ذاب كلي وبيَّض الحزن عين","ي وإني للوعتي مغلوب",43,"ب",1,0],["ذاب المتيم لولا حسن مخلصه","بمدح خير البرايا سيد الامم",44,"م",1,0],["ذابت حشاشته ولم يدر السوى","شوقاً إليه وما له من منقذ",45,"ذ",1,0],["ذاب شوقاً في محبتكم","حين منكم بارق برقا",46,"ق",2,0],["ذاب صبري وانقضى جلدي","والتواني أحرق المهجا",47,"ج",2,0],["ذابلُ الجَفْنِ فاترُ الطرْفِ لابِدْ","عَ ففي خدِهِ من النارِ شُعلَهْ",48,"ل",2,0],["ذا بِمُجَرَّدِهِ غَيرُ مَعيشَتِها","هَلِ الطَلاقُ لَها أَم لا وَلا خَيَرا",49,"ر",2,0],["ذا بعض ما يسدي لك العقلاء من","نصح وكم منهم أتتك نصائح",50,"ح",1,0],["ذابت لفرقتهِ الأكبادُ والتهبت","أَجفاننا من دموعٍ ضُرّجَت بدمِ",51,"م",1,0],["ذابت بجمرةِ فقدكَ الأَجسامُ","يا فاضلاً غَدَرَت بهِ الأيَّامُ",52,"م",1,1],["ذاب جسمي ضاع رشدي","زاه شجوي واكتئابي",53,"ب",2,1],["ذَابَتْ سُيُوفُهُمُ أَسىً فَظُبَاتُها","تَحْكِي المَدَامِعَ والجُفُوْنُ الأجْفُنَا",54,"ن",2,0],["ذا بعض عدتك التي أعددتها","للدهر وهو مروَّع متفاقم",55,"م",1,0],["ذا بعض ما وصلت إليه من المدى","تلك الضحايا والدم المطلول",56,"ل",1,0],["ذا بهارٌ في صُفْرةِ العاشِقِ المَيْ","تِ بداءِ الصدودِ والإعراض",57,"ض",1,0],["ذابل ذابل ذميم ذرار","ذي ذمام ذميمة ذناء",58,"ا",2,0],["ذاب وجدا واستطير جوى","فهو في أثوابه شبحُ",59,"ح",1,0],["ذَابَ حَشَاهُ فَسَالَ دَمْعًا","أمَا تَرَى لَوْنَهُ مُوَرَّدْ",60,"د",1,0],["ذابَ قَلبي مُنذُ حَل بِه","فَاِحتمل يا قَلب وَاغتبن",61,"ن",1,0],["ذا بَسطة وَنَجدة وَقوه","ندباً كَبير البَيت وَالأبوه",62,"ه",1,0],["ذاب مضنى الغرام فيك فكم ذا","يرشق البين في حشاه سهامه",63,"م",2,0],["ذابت حشاشة مدنفٍ","علقت حشاه بحب زينب",64,"ب",1,0],["ذَابَ السَّحَابُ فَهْوَ بَحْرٌ كُلُّهُ","وَعَلى البُحورِ مِنَ السَّحابِ سِجَاءُ",65,"ا",2,0],["ذابت حشاشته ومغناه عفا","فأبو البيان مقيّد مغبون",66,"ن",1,0],["ذابَت لِمَصرَعِهِ القُلوبُ تَحَسُّراً","مَن لِلقُلوبِ بِمِثلِ