{"poems":[[53,"حاجتي أيها الأمير كتاب","https://www.aldiwan.net/poem65437.html","الخفيف"],[285,"أترى الهلال أنار ضوء جبينه","https://www.aldiwan.net/poem60770.html","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107206","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92071","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97073","الخفيف"]],"verses":[["وليضف ذلك الأمير إلى ما","هو مجد من سيب أفضل كف",0,"ف",1,0],["وَلْيَضْرِبِ الْغزُّ الْمَنيعُ رُواقَهُ","بِجنَابِ مَمْنُوعِ الْجَنابِ حَصِينِهِ",1,"ن",2,0],["وليُضِم نفسَهُ الفَتَى لِسِواها","فَهوَ عَن تُهمَةٍ عَلَيها بَعِيدُ",2,"د",1,0],["وليضرم النيرانَ قلبٌ كان في","ما قد مضى مغرى الجمال ولاهيا",3,"ي",2,0],["وليضجوا بعولةً وانتحاب","ولينادوا بذلة وانكسار",4,"ر",1,0]]}