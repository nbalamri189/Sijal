{"poems":[[37,"ظواهر أمثال القداح كأنما","https://www.aldiwan.net/poem7213.html","الطويل"],[119,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[127,"ترى ما انت ماذا فيك","https://www.aldiwan.net/poem67445.html","مجزوء الوافر"],[129,"ظواعن عن خرج النميرة غدوة","https://www.aldiwan.net/poem24161.html","الطويل"],[130,"وقفت على التليل فبت ليلى","https://www.aldiwan.net/poem54646.html","الوافر"],[158,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[162,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[248,"ظهور رسول الله أظهر ديننا","https://www.aldiwan.net/poem15070.html","الطويل"],[362,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[413,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[429,"سندوها من القدود رماحا","https://www.aldiwan.net/poem12579.html","الخفيف"],[456,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[459,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15090.html","الطويل"],[502,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[556,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"]],"verses":[["ظواهر أمثال القداح كأنما","يعالجن أدواء السُّلال الهوالسا",0,"س",2,1],["ظواهر من سلمى سرتْ لبواطني","فأصبحتُ بالساري أُباري العواليا",1,"ي",2,0],["ظَوَينا عالَمَ الأسرارِ","قبلَك نقصِدُ المَغنى",2,"ن",2,0],["ظَواعِنَ عَن خُرجِ النُمَيرَةِ غُدوَةً","دَوافِعَ في ذاكَ الخَليطِ المُصَعَّدِ",3,"د",1,1],["ظويلمة الضويرِب والديه","غويدرة الكويذب في القويل",4,"ل",1,0],["ظواهر العتب للإِخوان أيسر من","بواطن الحقد في التسديد للخلل",5,"ل",1,0],["ظَواهِرُها حِكَمٌ وَمُستَنبَطاتُها","لِما حَكَمَ التَفريقُ فيهِ جَوامِعُ",6,"ع",1,0],["ظواهرُ الفاظي خلت من بواطنٍ","فعندي بما اخفيتُ من أمرها كنظُ",7,"ظ",1,0],["ظَوامِئُ منه إلى مَنْهَلٍ","زَمانِيَ قد كان عنه يَذود",8,"د",1,0],["ظوامئُ يطلبنَ الرَّواء بمهمهٍ","تطوف على أكفائها وتجول",9,"ل",1,0],["ظو المطايا جوامحٌ لِفراقِ","تستحثّ البُكورُ فيه الرّواحا",10,"ح",2,0],["ظواهرُ مثلُ السيف راقك جفنه ال","مُحَلَّى وإن ضاربتَ خانك نَصلُهُ",11,"ل",2,0],["ظواهر أمثال الصَّباح ودونها","بواطن سودٌ كالدجى المتكاثف",12,"ف",1,0],["ظواهر حالي في الملام علامة","ولكن حالي في الضمير سوى الصفا",13,"ا",1,0],["ظواهر منه فيه عنه له به","بواطن أفناها من الذات لامع",14,"ع",1,0],["ظواهر تدرك بالعقل مع","بواطن كالبارق اللامع",15,"ع",1,0]]}