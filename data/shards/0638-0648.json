{"poems":[[39,"ظواهر أمثال القداح كأنما","https://www.aldiwan.net/poem7213.html","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[111,"سميري وهل للمستهام سمير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545431",""],[125,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[133,"ترى ما انت ماذا فيك","https://www.aldiwan.net/poem67445.html","مجزوء الوافر"],[135,"ظواعن عن خرج النميرة غدوة","https://www.aldiwan.net/poem24161.html","الطويل"],[136,"وقفت على التليل فبت ليلى","https://www.aldiwan.net/poem54646.html","الوافر"],[164,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[168,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[254,"ظهور رسول الله أظهر ديننا","https://www.aldiwan.net/poem15070.html","الطويل"],[368,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[420,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[436,"سندوها من القدود رماحا","https://www.aldiwan.net/poem12579.html","الخفيف"],[461,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[464,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15090.html","الطويل"],[507,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"]],"verses":[["ظواهر أمثال القداح كأنما","يعالجن أدواء السُّلال الهوالسا",0,"س",2,1],["ظواهراها بله وتحوي بواطنا","لدى علمها جنس الوجود حقير",1,"ر",1,0],["ظواهراها بله وتحوي بواطنا","لدى علمها جنس الوحود حقير",2,"ر",1,0],["ظواهر من سلمى سرتْ لبواطني","فأصبحتُ بالساري أُباري العواليا",3,"ي",2,0],["ظَوَينا عالَمَ الأسرارِ","قبلَك نقصِدُ المَغنى",4,"ن",2,0],["ظَواعِنَ عَن خُرجِ النُمَيرَةِ غُدوَةً","دَوافِعَ في ذاكَ الخَليطِ المُصَعَّدِ",5,"د",1,1],["ظويلمة الضويرِب والديه","غويدرة الكويذب في القويل",6,"ل",1,0],["ظواهر العتب للإِخوان أيسر من","بواطن الحقد في التسديد للخلل",7,"ل",1,0],["ظَواهِرُها حِكَمٌ وَمُستَنبَطاتُها","لِما حَكَمَ التَفريقُ فيهِ جَوامِعُ",8,"ع",1,0],["ظواهرُ الفاظي خلت من بواطنٍ","فعندي بما اخفيتُ من أمرها كنظُ",9,"ظ",1,0],["ظَوامِئُ منه إلى مَنْهَلٍ","زَمانِيَ قد كان عنه يَذود",10,"د",1,0],["ظوامئُ يطلبنَ الرَّواء بمهمهٍ","تطوف على أكفائها وتجول",11,"ل",1,0],["ظو المطايا جوامحٌ لِفراقِ","تستحثّ البُكورُ فيه الرّواحا",12,"ح",2,0],["ظواهرُ مثلُ السيف راقك جفنه ال","مُحَلَّى وإن ضاربتَ خانك نَصلُهُ",13,"ل",2,0],["ظواهر أمثال الصَّباح ودونها","بواطن سودٌ كالدجى المتكاثف",14,"ف",1,0],["ظواهر حالي في الملام علامة","ولكن حالي في الضمير سوى الصفا",15,"ا",1,0],["ظواهر منه فيه عنه له به","بواطن أفناها من الذات لامع",16,"ع",1,0],["ظواهر تدرك بالعقل مع","بواطن كالبارق اللامع",17,"ع",1,0]]}