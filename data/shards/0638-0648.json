جن أدواء السُّلال الهوالسا",0,"س",2,1],["ظواهراها بله وتحوي بواطنا","لدى علمها جنس الوجود حقير",1,"ر",1,0],["ظواهراها بله وتحوي بواطنا","لدى علمها جنس الوحود حقير",2,"ر",1,0],["ظواهر من سلمى سرتْ لبواطني","فأصبحتُ بالساري أُباري العواليا",3,"ي",2,0],["ظَوَينا عالَمَ الأسرارِ","قبلَك نقصِدُ المَغنى",4,"ن",2,0],["ظَواعِنَ عَن خُرجِ النُمَيرَةِ غُدوَةً","دَوافِعَ في ذاكَ الخَليطِ المُصَعَّدِ",5,"د",1,1],["ظويلمة الضويرِب والديه","غويدرة الكويذب في القويل",6,"ل",1,0],["ظواهر العتب للإِخوان أيسر من","بواطن الحقد في التسديد للخلل",7,"ل",1,0],["ظَواهِرُها حِكَمٌ وَمُستَنبَطاتُها","لِما حَكَمَ التَفريقُ فيهِ جَوامِعُ",8,"ع",1,0],["ظواهرُ الفاظي خلت من بواطنٍ","فعندي بما اخفيتُ من أمرها كنظُ",9,"ظ",1,0],["ظَوامِئُ منه إلى مَنْهَلٍ","زَمانِيَ قد كان عنه يَذود",10,"د",1,0],["ظوامئُ يطلبنَ الرَّواء بمهمهٍ","تطوف على أكفائها وتجول",11,"ل",1,0],["ظو المطايا جوامحٌ لِفراقِ","تستحثّ البُكورُ فيه الرّواحا",12,"ح",2,0],["ظواهرُ مثلُ السيف راقك جفنه ال","مُحَلَّى وإن ضاربتَ خانك نَصلُهُ",13,"ل",2,0],["ظواهر أمثال الصَّباح ودونها","بواطن سودٌ كالدجى المتكاثف",14,"ف",1,0],["ظواهر حالي في الملام علامة","ولكن حالي في الضمير سوى الصفا",15,"ا",1,0],["ظواهر منه فيه عنه له به","بواطن أفناها من الذات لامع",16,"ع",1,0],["ظواهر تدرك بالعقل مع","بواطن كالبارق اللامع",17,"ع",1,0],["ظَوَاهِرُهُ تَهْدِي الْبَرَايَا مِنَ الْعَمى","فَنَالُوا بِهِ الْمَقْصُودَ والرَّفعَ وَالْحَظَّا",18,"ظ",2,0],["ظواهر الحمد تستوفي الثناء له","ما الشأن في حمد ما يخفى على الفكر",19,"ر",1,0],["ظواهره تثنى بحسن ضميره","وفي على عهد وعقد محافظ",20,"ظ",1,0],["ظويلم يظلم عشاقه","ولا يرى في ظلمهم من جناح",21,"ح",1,0],["ظواهرُ آياتٍ تقصُ مواعظاً","ومن لم يعظْهُ القولُ فالسيف أوعظ",22,"ظ",1,0],["ظوالع تلكَ الخيل صحت فكلُّها","ظليعٌ أغرُّ الوجه أرتم ألمظ",22,"ظ",1,0],["ظوف وظبن مئظ والصراف عنوا","بالاستظارة وانسب لليد المشظا",23,"ظ",2,0]]}