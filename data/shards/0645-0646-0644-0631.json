{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85443","الخفيف"],[201,"من لروحي فلا الرحيق رحيق","https://www.aldiwan.net/poem39808.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70858","الخفيف"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53232","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109855","الخفيف"],[5277,"لو أطاعَ الطيفَ..قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=199801",""],[5411,"غنْوَةُ الأُوُرْكيد","https://www.poetsgate.com/ViewPoem.aspx?id=199803",""],[402,"ليلى أجمعي الناس إلى محفل","https://www.poetsgate.com/ViewPoem.aspx?id=36825",""]],"verses":[["من لرب الآمال قال غروراً","إن تلك الحبال غير رثاث",0,"ث",1,0],["من لروحي فلا الرحيق رحيق","ولقلبي فلا الرفيق رفيق",1,"ق",1,1],["مَن لِرُسلِ اللَّه قَد كانَ الإِمام","لَيلَةَ الإِسراءِ في لَيلِ الوُصول",2,"ل",1,0],["مَنْ لركبٍ مستقْبلٍ أرض نجدٍ","يقطعون الفلا على أَوْفازِ",3,"ز",1,1],["من لريم صال في طرف وقد","يا لقومي فتنادينا الفرار",4,"ر",1,0],["من لرعي الأيتام يا فراس الدي","ن وأنت الكفيل والمأمون",5,"ن",1,0],["من لريح الصبى بلطفك ام من","لخزام الرياض طيب سلامك",6,"ك",1,0],["منْ لروحٍ مسَّها وقدُ النوى","وأصابتْ في المفازاتِ ضياعا",7,"ع",2,0],["مَنْ لِرُوحٍ بَيْنَ حُلْمٍ عُلِّقَتْ بي","وَكَذا الأَحْلامُ تُملِيكَ ضَيَاعَا",8,"ع",2,0],["من لرعوس فارقت خدرها","وأصبحت بعد الحلى عاريه",9,"ي",2,0]]}