{"poems":[[53,"فيم التنازع والشقاق","https://www.aldiwan.net/poem65714.html","مجزوء الكامل"],[51,"اسلك من الطرق المناهج","https://www.aldiwan.net/poem62022.html","مجزوء الكامل"],[68,"أخبرت شبهة النعاس بعينيك","https://www.aldiwan.net/poem39043.html","الخفيف"],[469,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44898","الخفيف"],[5156,"أقضى الحوائج ما استطعت","https://www.poetsgate.com/ViewPoem.aspx?id=99200",""]],"verses":[["فلخالد فيها ولا","دة من له يجب الصداق",0,"ق",1,0],["فَلَخَيرُ أَيّامِ الفَتى","يَومٌ قَضى فيهِ الحَوائِج",1,"ج",1,0],["فَلِخَمرِ السُهادِ فيها خُمارٌ","مُخبِرٌ بِاِنقِضاءِ عَيشٍ رَغيدِ",2,"د",1,0],["فلخوف القنا وجدن ذبولاً","واضحاً والظبى نحولاً وسقما",3,"م",2,0],["فلخيلها أجسامكم ولنبلها","أكبادكم ولقضبها الاعضاء",4,"ا",2,0],["فَلِخَيمِهِ أُوذِيسُ بالعَجَلِ انثَنى","وَأَتى بِمِجوَبِهِ وَأَدلَجَ مَعهُما",5,"ا",1,0],["فَلِخَير أَنا لِمثلك في الدُن","يا وَخَيرٌ لي أَنتَ في الأَمجادِ",6,"د",1,0],["فلخير أيام الفتى","يوم قضى فيه الحواج",7,"ج",1,0]]}