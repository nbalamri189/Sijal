 تعش تحت قِدّ","https://www.poetsgate.com/ViewPoem.aspx?id=208016",""],[4755,"يا غُصنْ طُولَ السَّنَهْ مَمطورْ","https://www.poetsgate.com/ViewPoem.aspx?id=194343",""],[4767,"كوكب عمان","https://www.poetsgate.com/ViewPoem.aspx?id=204152",""],[5001,"غُرْبةُ رُوْح","https://www.poetsgate.com/ViewPoem.aspx?id=176230",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[585,"لمن الضارب في ظلال الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=161910",""],[3591,"على صدور الخرد الحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=149415",""],[5135,"لله دَرُّ الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=203368",""],[5186,"محت الدهور الراسخات وقصرت","https://www.poetsgate.com/ViewPoem.aspx?id=156481",""],[5187,"حكايتي مع الناس","https://www.poetsgate.com/ViewPoem.aspx?id=33008",""],[5431,"مات طفلي...","https://www.poetsgate.com/ViewPoem.aspx?id=202275",""],[5449,"عليل","https://www.poetsgate.com/ViewPoem.aspx?id=189265",""],[5507,"يا معجبا بعلائه وغنائه","https://www.poetsgate.com/ViewPoem.aspx?id=186891",""],[5674,"بحة النايات","https://www.poetsgate.com/ViewPoem.aspx?id=191359",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""],[5956,"أعانك الله في ترتيب أنفسكم","https://www.poetsgate.com/ViewPoem.aspx?id=193864",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""],[5956,"الواقع شريعتي الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=201546",""],[6089,"طافوا وطفتُ سعوا سعيتُ رموا رميتُ","https://www.poetsgate.com/ViewPoem.aspx?id=214664",""],[6211,"أنا الطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78235&r=&rc=6",""]],"verses":[["كَم ضافَ رَحلي مِنكُمُ طارِقَ هَم","بِتُّ لَهُ أَخطِمُ دائي وَأَزُم",0,"م",1,0],["كَم ضَربَةٍ لي بِحَدِّ السَيفِ قاطِعَةٍ","وَطَعنَةٍ شَكَّتِ القَربوسَ بِالكَرِكِ",1,"ك",1,0],["كَم ضاقَ بي مِن مَذهَبٍ في مَطلَبٍ","فَثَنَيتَهُ فُسُحَ المَجالِ رَحيبا",2,"ب",2,0],["كم ضاق بحرٌ لا يحد","بما احتوته حدود بحرك",3,"ك",1,0],["كم ضعف حال وقلب","بالضعفِ منك منوط",4,"ط",1,0],["كم ضيعةٍ للحال كانت قطعة","فغدت بضيعة غلةٍ أقطاعا",5,"ع",2,0],["كم ضربةٍ رَعْلاَءَ بل كم طعنةٍ","نجلاء بل كم رَمْيَةٍ إذْبيحِ",6,"ح",1,0],["كم ضياءٍ شببتَه فتعالى","وشُواظٍ بالغت في إخمادِهْ",7,"د",2,0],["كم ضرطةٍ تتبعُها ضحكةٌ","وما على الثِّنْتين تنكير",8,"ر",1,0],["كم ضنينٍ بنفسهِ رامَ مَنْجىً","فتلقّوا جبينه بالحسام",9,"م",1,0],["كم ضنَّ بالفرضِ أقوامٌ وعندهُمُ","وفْرٌ وأعطى العطايا وهْو يدَّان",10,"ن",1,0],["كم ضفرنا الغار في محرابها","وعقدناه لسباق أصيل",11,"ل",1,0],["كَم ضَلَّلَتكَ وَمَن تُحجَب بَصيرَتُهُ","إِن يَلقَ صابا يَرِد أَو عَلقَماً يَسُمُ",12,"م",1,0],["كَم ضِقتَ ذَرعاً بِالحَياةِ وَكَيدِها","وَهَتفتَ بِالشَكوى مِنَ الضَرّاءِ",13,"ا",2,0],["كم ضوء صبح رجاك في غده","وجنح ليل دعاك في غَسقِهْ",14,"ق",2,0],["كَم ضَمَّنَ الدَمعَ رَيَّ غُلَّتِهِ","فَما وَفى بَعدَكُم بِما ضَمِنَه",15,"ن",2,0],["كَمْ ضَرُوبٍ ضارَبْتَه وَجَليدٍ","وَقريبٍ طاعَنْتَهُ وَقَصيِّ",16,"ي",1,0],["كم ضربةٍ أوسعها سيفُهُ","فهو لسانٌ ناطقٌ وهي فم",17,"م",1,0],["كَم ضممت ابنَتي إِلى الصدر مني","أَبتَغي أَن أَردها لجناني",18,"ن",2,0],["كَم ضاحِكٍ وَالمَنايا فَوقَ هامَتِهِ","لَو كانَ يَعلَمُ غَيباً ماتَ مِن كَمَدِ",19,"د",1,1],["كَمْ ضَجْعَةٍ فِيهَا أَرَاكَ وَيَقْظَةٍٍ","لاَحَتْ ذُرَاكَ بِهَا تَرُوحُ وَتَعتدِي",20,"د",2,0],["كم ضحكةٍ تشكو الشفاهُ أوارَها","تبدو لعينكَ ديمَةً تتَرقرَقُ",21,"ق",1,1],["كم ضاق من شِقْوَته عَصْرُهُ","وضاق بالسُّخْطِ على عَصْرِه",22,"ر",2,0],["كَمْ ضِرَاءٍ وَسْطَ الْمَدَائِنِ أَنْكى","مِنْ ضِرَاءِ الضِّرْغَامِ في وَسْطِ غَابِهْ",23,"ب",2,0],["كم ضمّدوا جرح الجري","ح إذا الجريح تألمَّا",24,"م",2,0],["كم ضاق مشتىً بهم؛ وجادت","لهم بشُطآنها البحار",25,"ر",1,0],["كم ضلَّ من أهل الحواضر قارئٌ","فاغتال أعراضًا وشقَّ جيوبا",26,"ب",2,0],["كَم ضَمت الترباء خَلقاً قَبلَنا","مِن آخر يَقفو سَبيل الأَول",27,"ل",1,1],["كم ضَعيفٍ بكى ونادى فَراحَت","لِبُكاهُ تُقَهقِهُ المدفعيّه",28,"ي",2,0],["كم ضامنٍ لك منهم إخلاصهُ","فإذا استحالت يستحيلُ ضمانا",29,"ن",2,0],["كَم ضَمَّ قَبرُكَ يا مَودودُ مِن دينِ","وَمِن عَفافٍ وَمِن بِرٍّ وَمِن لينِ",30,"ن",1,1],["كَمُضِلٍّ رَدَّ النّهارُ عليه","جَوهراً في الظّلامِ عنه استَسَرّا",31,"ر",2,0],["كَم ضَربَةٍ من كَفِّهِ في قَرنِهِ","قَد خيلَ جَريُ دِمائِها من جَدوَلِ",32,"ل",1,0],["كم ضلَّ في ليلِ الشَّبابِ فدَلَّهُ","وَضَحُ المشيبِ على الطَّريقِ الأقْصَدِ",33,"د",1,0],["كم ضاحِكٍ خلفي وتحت ضلوعِهِ","نارٌ تُشَبُّ بأَدمعٍ مُنْهَلَّةِ",34,"ه",1,0],["كم ضيعةٍ باللوى صريع","تختِلهُ مقلتا غزالِ",35,"ل",1,0],["كم ضاع حق واختفت آثاره","متلاشيا ما بينهم مصروما",36,"م",2,0],["كم ضاعف الخطب في الأرزاء مأتمنا","فازداد منه فؤاد المبتلى هلعا",37,"ع",2,0],["كم ضاق ذرعا بالخطوب وقد غدا","متمنطقا بذوائب النيران",38,"ن",1,0],["كم ضلّ عنّي ما أحاول واِهتدى","داري الّذي لم يجر في أوْهامي",39,"م",2,0],["كم ضامني من لا أُضِي","مُ وملَّني مَن لا أمَلُّ",40,"ل",1,0],["كم ضَمَّنَتْ من ضيغمٍ","قَرمٍ إلى قنص النّفوسِ",41,"س",1,0],["كم ضاعَ دمعٌ في الزَّمانِ وقد جَرَى","عَبَثاً ولا عجبٌ فكم ضاعتْ دِما",42,"م",2,0],["كم ضج فيها مسجد مما جنى","أجناده وكم استغاث ضريح",43,"ح",1,0],["كم ضَحِكْنا أَسًى","كَمْ بَكَيْنَا شَرَرْ!",44,"ر",1,0],["كم ضرير شفى فساد بصيرا","كم بصير عمى لفرط عناد",45,"د",1,0],["كم ضحكة ضحكت قسرا وكم مرحت","كرها لترضىَ خِلا جدّ مكروه",46,"ه",1,0],["كمْ ضامني المَكْروهُ مِنْ ضَيْمِهِ","وضمَّني المَحْبوبُ مِنْ ضَمَّهْ",47,"م",2,0],["كَم ضَره ما نَفعه","كَم حَطه ما رفعه",48,"ه",1,0],["كَم ضعة مِن رفعه","كَم جوعة مِن شبعه",49,"ه",1,0],["كَم ضَيغَمٍ عَفَّرتُهُ بِعَرينِهِ","وَلَكَم فَتَكتُ بِأَفتَكِ الفُتّاكِ",50,"ك",1,0],["كم ضيعةٍ كانتْ تصو","نُ الوَجْهَ عن ذُلِّ الطَّلَبْ",51,"ب",1,0],["كم ضمني ورضا بي بات مرتشفاً","وقد جرى من لماهُ في فمي العسلُ",52,"ل",1,0],["كم ضعف صبرك عن","أحاديث الهيام يعبر",53,"ر",1,0],["كَم ضَربَةٍ لَكَ تَحكي فا قُراسيَةٍ","مِنَ المَصاعِبِ في أَشداقِها شَنَعُ",54,"ع",1,0],["كم ضجَّت الأرض إلى خالقها","من طول ما دُكَّتْ إليه الطرق",55,"ق",1,0],["كَم ضِياءٍ يَجيءُ بَعدَ ظَلامٍ","وَنُجومٍ تَعلو وَأُخرى تَغورُ",56,"ر",1,0],["كَم ضَيَّعوهُ فَتَدارَكته","وَالل