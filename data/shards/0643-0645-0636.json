{"poems":[[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[3,"يا عبل إن كان ظل القسطل الحلك","https://www.aldiwan.net/poem181.html",""],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[93,"أبدعت في ديوان شعرك","https://www.aldiwan.net/poem9830.html","مجزوء الكامل"],[72,"مولاي قم للمعالي","https://www.aldiwan.net/poem19140.html","المجتث"],[72,"جاء البشير بها فقلت لدره","https://www.aldiwan.net/poem19175.html","الكامل"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"ليس على الضارط تعيير","https://www.aldiwan.net/poem62938.html","السريع"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[43,"شغلي عن الربع أن أسائله","https://www.aldiwan.net/poem10614.html","المنسرح"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85379","الخفيف"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/8729","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54721","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142006","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[109,"كم ضمت الترباء خلقا قبلنا","https://www.aldiwan.net/poem16538.html","الكامل"],[197,"يا بني العرب إنما الضعف عار","https://www.aldiwan.net/poem39951.html","الخفيف"],[275,"جدد لنيتك القصية نية","https://www.aldiwan.net/poem25396.html","الكامل"],[282,"كم ضم قبرك يا مودود مِن دينِ","https://www.aldiwan.net/poem32286.html","البسيط"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[393,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[409,"قالوا نهته الأربعون عن الصبا","https://www.aldiwan.net/poem32048.html","الكامل"],[432,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[458,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[479,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[482,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[551,"إني مررت على جنادل","https://www.aldiwan.net/poem47747.html","مجزوء الكامل"],[562,"نهنه دموعك أيها الباكي فما","https://www.aldiwan.net/poem52751.html","الكامل"]],"verses":[["كَم ضافَ رَحلي مِنكُمُ طارِقَ هَم","بِتُّ لَهُ أَخطِمُ دائي وَأَزُم",0,"م",1,0],["كَم ضَربَةٍ لي بِحَدِّ السَيفِ قاطِعَةٍ","وَطَعنَةٍ شَكَّتِ القَربوسَ بِالكَرِكِ",1,"ك",1,0],["كَم ضاقَ بي مِن مَذهَبٍ في مَطلَبٍ","فَثَنَيتَهُ فُسُحَ المَجالِ رَحيبا",2,"ب",2,0],["كم ضاق بحرٌ لا يحد","بما احتوته حدود بحرك",3,"ك",1,0],["كم ضعف حال وقلب","بالضعفِ منك منوط",4,"ط",1,0],["كم ضيعةٍ للحال كانت قطعة","فغدت بضيعة غلةٍ أقطاعا",5,"ع",2,0],["كم ضربةٍ رَعْلاَءَ بل كم طعنةٍ","نجلاء بل كم رَمْيَةٍ إذْبيحِ",6,"ح",1,0],["كم ضياءٍ شببتَه فتعالى","وشُواظٍ بالغت في إخمادِهْ",7,"د",2,0],["كم ضرطةٍ تتبعُها ضحكةٌ","وما على الثِّنْتين تنكير",8,"ر",1,0],["كم ضنينٍ بنفسهِ رامَ مَنْجىً","فتلقّوا جبينه بالحسام",9,"م",1,0],["كم ضنَّ بالفرضِ أقوامٌ وعندهُمُ","وفْرٌ وأعطى العطايا وهْو يدَّان",10,"ن",1,0],["كم ضفرنا الغار في محرابها","وعقدناه لسباق أصيل",11,"ل",1,0],["كَم ضَلَّلَتكَ وَمَن تُحجَب بَصيرَتُهُ","إِن يَلقَ صابا يَرِد أَو عَلقَماً يَسُمُ",12,"م",1,0],["كَم ضِقتَ ذَرعاً بِالحَياةِ وَكَيدِها","وَهَتفتَ بِالشَكوى مِنَ الضَرّاءِ",13,"ا",2,0],["كم ضوء صبح رجاك في غده","وجنح ليل دعاك في غَسقِهْ",14,"ق",2,0],["كَم ضَمَّنَ الدَمعَ رَيَّ غُلَّتِهِ","فَما وَفى بَعدَكُم بِما ضَمِنَه",15,"ن",2,0],["كَمْ ضَرُوبٍ ضارَبْتَه وَجَليدٍ","وَقريبٍ طاعَنْتَهُ وَقَصيِّ",16,"ي",1,0],["كم ضربةٍ أوسعها سيفُهُ","فهو لسانٌ ناطقٌ وهي فم",17,"م",1,0],["كَم ضممت ابنَتي إِلى الصدر مني","أَبتَغي أَن أَردها لجناني",18,"ي",1,0],["كَم ضاحِكٍ وَالمَنايا فَوقَ هامَتِهِ","لَو كانَ يَعلَمُ غَيباً ماتَ مِن كَمَدِ",19,"د",1,1],["كَمْ ضَجْعَةٍ فِيهَا أَرَاكَ وَيَقْظَةٍٍ","لاَحَتْ ذُرَاكَ بِهَا تَرُوحُ وَتَعتدِي",20,"د",2,0],["كم ضحكةٍ تشكو الشفاهُ أوارَها","تبدو لعينكَ ديمَةً تتَرقرَقُ",21,"ق",1,1],["كم ضاق من شِقْوَته عَصْرُهُ","وضاق بالسُّخْطِ على عَصْرِه",22,"ر",2,0],["كَمْ ضِرَاءٍ وَسْطَ الْمَدَائِنِ أَنْكى","مِنْ ضِرَاءِ الضِّرْغَامِ في وَسْطِ غَابِهْ",23,"ب",2,0],["كم ضمّدوا جرح الجري","ح إذا الجريح تألمَّا",24,"م",2,0],["كم ضاق مشتىً بهم؛ وجادت","لهم بشُطآنها البحار",25,"ر",1,0],["كم ضلَّ من أهل الحواضر قارئٌ","فاغتال أعراضًا وشقَّ جيوبا",26,"ب",2,0],["كَم ضَمت الترباء خَلقاً قَبلَنا","مِن آخر يَقفو سَبيل الأَول",27,"ل",1,1],["كم ضَعيفٍ بكى ونادى فَراحَت","لِبُكاهُ تُقَهقِهُ المدفعيّه",28,"ي",2,0],["كم ضامنٍ لك منهم إخلاصهُ","فإذا استحالت يستحيلُ ضمانا",29,"ن",2,0],["كَم ضَمَّ قَبرُكَ يا مَودودُ مِن دينِ","وَمِن عَفافٍ وَمِن بِرٍّ وَمِن لينِ",30,"ن",1,1],["كَمُضِلٍّ رَدَّ النّهارُ عليه","جَوهراً في الظّلامِ عنه استَسَرّا",31,"ر",2,0],["كَم ضَربَةٍ من كَفِّهِ في قَرنِهِ","قَد خيلَ جَريُ دِمائِها من جَدوَلِ",32,"ل",1,0],["كم ضلَّ في ليلِ الشَّبابِ فدَلَّهُ","وَضَحُ المشيبِ على الطَّريقِ الأقْصَدِ",33,"د",1,0],["كم ضاحِكٍ خلفي وتحت ضلوعِهِ","نارٌ تُشَبُّ بأَدمعٍ مُنْهَلَّةِ",34,"ه",1,0],["كم ضيعةٍ باللوى صريع","تختِلهُ مقلتا غزالِ",35,"ل",1,0],["كم ضاع حق واختفت آثاره","متلاشيا ما بينهم مصروما",36,"م",2,0],["كم ضاعف الخطب في الأرزاء مأتمنا","فازداد منه فؤاد المبتلى هلعا",37,"ع",2,0],["كم ضاق ذرعا بالخطوب وقد غدا","متمنطقا بذوائب النيران",38,"ن",1,0],["كم ضلّ عنّي ما أحاول واِهتدى","داري الّذي لم يجر في أوْهامي",39,"ي",1,0],["كم ضامني من لا أُضِي","مُ وملَّني مَن لا أمَلُّ",40,"ل",1,0],["كم ضَمَّنَتْ من ضيغمٍ","قَرمٍ إلى قنص النّفوسِ",41,"س",1,0],["كم ضاعَ دمعٌ في الزَّمانِ وقد جَرَى","عَبَثاً ولا عجبٌ فكم ضاعتْ دِما",42,"م",2,0]]}