{"poems":[[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[53,"بني إن فضول الحظ مبشمة","https://www.aldiwan.net/poem65759.html","البسيط"],[132,"أحب أهل العقول من الرعايا","https://www.aldiwan.net/poem50576.html","الوافر"],[275,"يا شارب الراح على ورد","https://www.aldiwan.net/poem35292.html","السريع"],[447,"وداعا وحسبي الله يا عرفات","https://www.aldiwan.net/poem14298.html","الطويل"],[447,"وقيت ببردي ظهر جلدي على البرد","https://www.aldiwan.net/poem14365.html","الطويل"],[556,"أيا صاحبي إن لم تكن في شديدتي","https://www.aldiwan.net/poem48062.html","الطويل"],[564,"دجى غيهب التفريق قد زال واشمطا","https://www.aldiwan.net/poem69352.html","الطويل"],[591,"تهيم ببدر ثم ترجو له قربا","https://www.aldiwan.net/poem17972.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70750","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64694","المجتث"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112962","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81893","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3656,"","https://poetry.dctabudhabi.ae/diwan/poem/133919","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131016",""],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124629","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90825","الطويل"],[4755,"هو الوَقتُ كالسَّيفِ","https://www.poetsgate.com/ViewPoem.aspx?id=204522",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""]],"verses":[["وَكُنَّ قَد أَبقَينَ مِنها أَذىً","عِندَ المَلاقي وافِيَ الشافِرِ",0,"ر",1,0],["وكن قلنْسُوَةَ المملوك تحظَ بها","ولا تكوننَّ نعليْ بِذْلة الملكِ",1,"ك",1,0],["وكن قدَّامهم في كلِّ أمرٍ","تكن في كلّ مرتبةٍ رفيعا",2,"ع",2,0],["وكُن قويّاً وجَسُوراً لِكي","ترُدَّ عَنكَ الموتَ بالجهد",3,"د",1,0],["وكن قابلاً نسكي وحجي وعمرتي","وزوري لمن زانت به العمرات",4,"ت",1,0],["وكن قابلاً كدي لأخراي إنني","أحب لها مني تكون شقا كدي",5,"د",2,0],["وكنْ قَبَسِي إنْ كان قومٌ دياجِري","وكنْ صادقي إنْ كان دهرِيَ كاذِبي",6,"ب",2,0],["وكَنْ قَاصِداً لِلْحَقِّ تَحْظ بنيلِهِ","ومَنْ قَصَدَ الوَهّاب لا شَكَ أنْ يُعْطَى",7,"ط",2,0],["وَكُنْ قانِعاً مِنْهُ وَحَسْبُكَ مَفْخَراً","بِأَنَّكَ تَضْحَى مُسْتَهَاماً بِهِ صَبّا",8,"ب",2,0],["وكن قانتاً حيناً وحيناً فتاركاً","لذلك تسعد بالدليل وتهتد",9,"د",1,0],["وكنْ قاصداً طرْقَ المكارم والندى","ولا نخشَ تعنيفاً عليكَ ولا عذلا",10,"ل",2,0],["وَكُنَّ قَبْلُ عَواطٍ","فَصِرْنَ بَعْدُ عَواطِبْ",11,"ب",1,0],["وكن قطعة من هذه الأرض واحتمل","إذا الخلق أجل اللَه منشرح القلب",12,"ب",1,0],["وَكُنْ قَادِرِيَّ الْوَقْتِ لِلَّهِ مُخْلِصَاً","تَعِيشُ سَعِيدَاً صَادِقَاً بِمَحَبَّتِي",13,"ي",1,0],["وَكُن قانِعاً عِندَ الشِتاءِ بِكُلِّ ما","يُكنِّكُ عَن بَردِ الحَشا وَالجَوانِبِ",14,"ب",1,0],["وَكُن قانِعاً فيها بِما ذَكَرتُهُ","لِأَنَّكَ ذو جِسمٍ نَحيلٍ وَشاحِبِ",14,"ب",1,0],["وَكُن قَنوعاً فَخَير العَيشِ في قنع","وَفيهِ لِلمَرءِ ان حَقَّقت غنيان",15,"ن",1,0],["وكن قمراً يفرى الدجا بمسيره","فتحمد عند الصبح ذاك السرى ألفا",16,"ف",2,0],["وكن قارئا اخبار شوقي فانها","على صفحة الظلماء بالبرق تكتب",17,"ب",1,0],["وكن قاصدا بالسير منك زيارة","لمن حلها رغما لانف المماذق",18,"ق",1,1],["وكن قانعا مني بما هو قدرتي","وإن لك قدمت القليل من النذر",19,"ر",1,0],["وكُن _قَبلَ أَن تَحفِرَ البِئرَ_ فأسًا","وكُن _قَبلَ أَن تُشعِلَ النَّارَ_ مقلى",20,"ل",2,0],["وكن قائلاً خيراً أو اصمت وذر حجا","فما لاق إلا بالمجوس حجاء",21,"ا",2,0],["وكن قاصداً بالسير منك زيارة","لمن حلها رغماً لأنف الممازق",22,"ق",1,0]]}