://www.poetsgate.com/ViewPoem.aspx?id=50659",""],[5818,"عرب","https://www.poetsgate.com/ViewPoem.aspx?id=199696",""],[5818,"عرب","https://www.poetsgate.com/ViewPoem.aspx?id=200202",""],[5829,"دعونا وشأننا","https://www.poetsgate.com/ViewPoem.aspx?id=178059",""],[5842,"سُرَّاق النسب/ محمد الرحمون","https://www.poetsgate.com/ViewPoem.aspx?id=117029",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"الوهمُ والجوَى","https://www.poetsgate.com/ViewPoem.aspx?id=183946",""],[5956,"منطق العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=192221",""],[5956,"الوطن العربي","https://www.poetsgate.com/ViewPoem.aspx?id=192339",""],[5956,"عربٌ تحارب بعضها","https://www.poetsgate.com/ViewPoem.aspx?id=193886",""],[5966,"عتاق الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=158438",""],[5975,"نكسة العرب .. ودمشق العروس ..","https://www.poetsgate.com/ViewPoem.aspx?id=84578",""],[5975,"أمة أبي لهب ...","https://www.poetsgate.com/ViewPoem.aspx?id=84579",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6069,"بكت الخطوب وثغر مجدك ضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=105696",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6093,"أشجار أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=196883",""],[6093,"حلوية عربية","https://www.poetsgate.com/ViewPoem.aspx?id=215567",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6152,"شجن صبح","https://www.poetsgate.com/ViewPoem.aspx?id=203316",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[5393,"إن الذيول صناعة غربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85459&r=&rc=26",""],[6213,"العربية الصامدة","//adab.com/modules.php?name=Sh3er&doWhat=shq