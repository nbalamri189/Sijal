أيُهُ فارِسِيَّةٌ أَعيادُه",14,"د",2,0],["عربيٌّ روائحُ الشِّيحِ والقَي","صومِ منه والشَّثِّ والطُّبَّاقِ",15,"ق",1,0],["عَرَبِيٌّ واطِئٌ رومِيَّةً","يُنسِلُ الزُنجَ لَها وَالحَبَشا",16,"ش",2,0],["عَرْبَدَ الصحوُ عليهمْ بالأسَى","فاتَّقاه السُّكْرُ عَنهم بِالسُّرور",17,"ر",1,0],["عَرَبٌ إذا غَضِبوا لأمرٍ طارقٍ","غَضِبَتْ على بيضِ الظُّبى الأغمادُ",18,"د",1,0],["عَرَبِيَّةٌ أَوفى بِعِزَّةِ قَومِها","نَسَبٌ لَهُم في الكابِرينَ صُراحُ",19,"ح",1,0],["عربيٌّ فتحت آياتُهُ","كلَّ بابٍ للمعاني مُغلَقِ",20,"ق",1,0],["عَربي إِباؤكمُ أُمويّ","لا أَباد الزَمان تِلكَ الخلالا",21,"ل",2,0],["عُربٌ وَعُجمٌ دائِلونَ وَكُلُّنا","في الظُلمِ أَهلُ تَشابُهٍ وَجِناسِ",22,"س",1,0],["عَرَبِيٌّ يَسعى إِلى الجارَةِ الدُن","يا فَيُدعى لِما جَناهُ سَفيها",23,"ي",3,0],["عربدتْ هوجاءَ واستشرتْ قُوى","واستبدَّتْ بعقول الضعفاءْ",24,"ا",2,0],["عربد الشَّاعرُ منْ لألائها","وهيَ كنزٌ في ضميرِ الأبدِ",25,"د",1,0],["عربي زمانه عمري","عهده فيه رحمة ووفاء",26,"ا",2,0],["عَرَبِيَّةٌ يَهتَزُّ لينُ قَوامِها","فَيَخالُهُ العُشّاقُ رُمحاً أَسمَرا",27,"ر",2,0],["عَرَبِيُّ الأُسْلُوبِ مُمْتَنِعٌ سَهْلٌ","لَهُ فِي النُّهَى أَفَاعِيلُ سِحْرِ",28,"ر",1,0],["عربيٌّ على مُحيَّاهُ تبدو","من سمات العُرْب الأوَالى علامة",29,"م",2,0],["عربٌ يَزينهمُ السما","حُ، وبالكرامة هم شِحَاح",30,"ح",1,0],["عربُ الجزيرةِ هامدون كأنّهم","لم يُبْتلْوا أبداً بيومِ عراك",31,"ك",1,0],["عربياً سال من أفئدةٍ","عربياتٍ تلظت حُرَقا",32,"ق",2,0],["عربيّ الدّار والأهل معا","والرحيق المشتهى والندماء",33,"ا",2,0],["عربيّة الأنساب تطرب للوغى","في جاهليّتها وفي إسلامها",34,"م",3,0],["عربي عرق من ذوائب هاشم","ضربت على الشرف الصميم خيامي",35,"م",2,0],["عربد بالافكار راح الهوى","كم للهوى من روح روح وراح",36,"ح",1,1],["عربي الطباع عالي المزايا","مخجل بالبها سنا الأقمار",37,"ر",1,0],["عَرَبِيٌّ فَصاحةً وبَيانًا","لم يَعُدْ مِن فَصيلةِ الإنسانِ",38,"ن",1,0],["عرباً وأتراباً كواعب هبُّها","هَبٌ لفارة تاجر إذ يقسما",39,"م",2,0],["عَرَبٌ مَضَت أَحكامُ عِزِّكَ فيهِمُ","طَوراً تُفَرِّقُهُم وَأُخرى تَجمَعُ",40,"ع",1,0],["عربِيَّةٌ الأعْرَافِ رَمْزُ الانتِمَا