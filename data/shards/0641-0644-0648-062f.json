{"poems":[[34,"خليلي عوجا بالمحلة من جمل","https://www.aldiwan.net/poem27807.html","الطويل"],[47,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[96,"أيّكما الرّبيع","https://www.poetsgate.com/ViewPoem.aspx?id=15635",""],[186,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[189,"وبيت دعيت له ثم لم","https://www.aldiwan.net/poem14618.html","المتقارب"],[385,"تنسمي بالله ريح نجد","https://www.aldiwan.net/poem49209.html","الرجز"],[519,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[521,"ايقظان ام هب الفؤاد لطائف","https://www.aldiwan.net/poem48606.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53926","الطويل"],[837,"","https://poetry.dctabudhabi.ae/diwan/poem/143381","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96664","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202114","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79873","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77916","السريع"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87916","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69366","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53159","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53092","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109459","البسيط"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88996","البسيط"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20640","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91950","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132165","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93313","الطويل"],[5213,"أملت انشي التهاني فيك والغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=170521",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5582,"تُلَوِّمُنِي فِي الحُبِّ وَالحِبُّ يُعْذَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187140",""],[5582,"قِفا بِالدِّيارِ وَكُثْبانِها","https://www.poetsgate.com/ViewPoem.aspx?id=187312",""],[5618,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=208911",""],[4115,"وافوا بفنجان نقي ابيض","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607755",""],[6225,"العُذر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81107&r=&rc=301",""]],"verses":[["فَلَو دَرَجَ النَملُ الصِغارُ بِجِلدِها","لَأَندَبَ أَعلى جِلدِها مَدرَجُ النَملِ",0,"ل",1,0],["فَلَو دامَ شَيءٌ آخِرُ الدَهرِ سَرَّنا","غِنىً عَنهُ مَوجودٌ وَدُمتَ مُخَلَّدا",1,"د",2,0],["فلَو دَبَّر الباغونَ للكيدِ خطةً","رأوا أنَّني منهُمْ بَتدبيرِها أحرى",2,"ر",2,0],["فلو درت الضلوع صنيع قلبي","لما غفرت جريرته الضلوع",3,"ع",1,0],["فَلَو دَرَتِ البِلادُ بِما عَراها","لَكادَتْ مِن تَلَهُّفِها تَمُورُ",4,"ر",1,0],["فلو دخلتْ بيننا ذَرَّةٌ","تَشقَّق حائطُه عند ذاكا",5,"ك",2,0],["فَلو دَنا مِن أَضلُعي جَمر الغَضا","لَأَحرَقتُهُ كَبدي بِالوَقد",6,"د",1,0],["فلو دفَنوهُ قومُه عندَ قدْرِه","لجلَّ ولو أنّ السِّماكَ له قَبْرُ",7,"ر",1,0],["فَلَو دُمت لَم أَملَل وَلكِن تَرَكتَني","بِدائي وَما الدُنيا لحيّ بِدائِمه",8,"م",2,0],["فلو دُرِستْ أمْست دواءً الذي الدّوا","ولو حُفظت أضحت أماناً من الفقر",9,"ر",1,0],["فلو دامت الدنيا على ذي مهابةٍ","لدمت ولكن الزمان مبير",10,"ر",1,0],["فَلو دبَّ نملٌ فوقَ ناعمِ جِسمها","لَكادَ إِذا ما دبَّ فيه تؤثرُ",11,"ر",1,0],["فلو دِنت بالإسلام كنت مُسَلَّما","وكنت إلى أعلى العلى قد ترقيتا",12,"ت",2,0],["فلوِدٍّ شكا وأيأسُ شاكٍ","مَن يُداوي بعتبهِ الأَوصابا",13,"ب",2,0],["فَلَو دَعا الداعي من المبتلى","بين البرايا قلت يا خي أَنا",14,"ن",2,0],["فلو درى عاجلاً مكرَ الهوى لَرَأَى","بُعدَ التناسُب بين الرُّوح والدَّسمِ",15,"م",1,0],["فَلَو داسَ التُرابَ بِأَخمَصَيهِ","وَجَدتُ لِناظِرَيَّ بِهِ اِنتِفاعا",16,"ع",2,0],["فلو دعوت بالرَّدَى عليهمُ","قلت ألا ليت الوشاة عشقوا",17,"ق",3,0],["فلو دعوتك والنيران مضرمة","حولي لعاد لظاها برد بَيْرُود",18,"د",1,0],["فلو درى من يروم السعد طالعه","ما كان للنجم في جنح الدجا رصدا",19,"د",2,0],["فلو درت حسنه في كل آية","لما التفت للبعض منه بنظرة",20,"ه",1,0],["فلو درى بالذي يمتاح نائله","من قبل يسأل أعطاه بغير طلب",21,"ب",1,0],["فَلَو دُنيايَ قابَلَني غِناها","بِغَيرِكَ ما ثَنَيتُ لَها عَناني",22,"ي",1,0],["فَلو دَعا الشرّ خيرَ القَوم طار له","فَلا السليكُ يجاريه وَلا السُّلَكَهْ",23,"ك",2,0],["فلو درسوا حياتك وهي صغرى","لصاغوا من محاسنها كتابا",24,"ب",2,0],["فلو دان ملك للثناء لدنتما","بلى لكما زان الثناء ودانا",25,"ن",2,0],["فلو دفنوه إلى قَدرهِ","لحَقَّ لدى النجم أن يقبرا",26,"ر",2,0],["فلو دَرَجُ الأَفلاك عنه تحصّنت","لأَمْستْ صِعاداً فوقَهنّ صِعادُه",27,"د",2,0],["فلو دهتك المنايا في العراق إذا","لقام دونك منا معشر نبلا",28,"ل",2,0],["فلو دعت الله أفنتهم","ولكنها عنهم حالمه",29,"م",2,0],["فَلَوْ دَبَّ نَمْلٌ فَوْقَ ناعِمِ جِسْمِها","لَكادَ إِذا ما دَبَّ فِيهِ يُؤَثِّرُ",30,"ر",1,0],["فَلَوْ دَبَّ نَمْلٌ عَلَى جِسْمِها","لأَثَّرَ فِي بَشْرَ جِسْمانِها",31,"ن",3,0],["فلو دخلتِ على الحجاج.. في غضبٍ","لقدّمَ العذرُ والتحنان قد هاجا",32,"ج",2,0],["فلود لما صبت السودا به","فكأنه بدر علاه كسوف",33,"ف",1,0],["فلو درَوا ما عليهم باطِنًا وجدوه","ما لهم ظاهرًا .. والنفسُ تُمْتحَنُ .",34,"ن",1,0]]}