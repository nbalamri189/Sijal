{"poems":[[59,"دع الأيام تفعل ما تشاء","https://www.aldiwan.net/poem24737.html","الوافر"],[90,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[93,"مدى زمن كان فيه الفتى","https://www.aldiwan.net/poem9062.html","عموديه"],[87,"وجدت الحياة طريق الزمر","https://www.aldiwan.net/poem8073.html","المتقارب"],[89,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[50,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[50,"على دمنة الدار لا تربع","https://www.aldiwan.net/poem66620.html","المتقارب"],[92,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[90,"تيقَّظ فما انت بالخالدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19512&r=&rc=15",""],[147,"كلانا إذا فكرت فيه على شفا","https://www.aldiwan.net/poem11784.html","الطويل"],[276,"أفق هديت من التبريح والكمد","https://www.aldiwan.net/poem52105.html","البسيط"],[309,"إذا شئت أن تحيا سعيدا مدى العمر","https://www.aldiwan.net/poem16761.html","الطويل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[447,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[473,"لا تسق ماء التجني من تصاحبه","https://www.aldiwan.net/poem59810.html","البسيط"],[563,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[563,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54030","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38028","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38339","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16815","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136266","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141309","الوافر"],[1932,"","https://poetry.dctabudhabi.ae/diwan/poem/199356","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109450","الطويل"],[2227,"","https://poetry.dctabudhabi.ae/diwan/poem/178143","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124767","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35872","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62907","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85230","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135193","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139555",""],[4852,"أعلنها","https://www.poetsgate.com/ViewPoem.aspx?id=214702",""],[5057,"مرتاحُ الضّميرِ","https://www.poetsgate.com/ViewPoem.aspx?id=203665",""],[5189,"ألاَ يا عبدُ ما لك قد غَفِلتا","https://www.poetsgate.com/ViewPoem.aspx?id=190968",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""]],"verses":[["وَكُن رَجُلاً عَلى الأَهوالِ جَلداً","وَشيمَتُكَ السَماحَةُ وَالوَفاءُ",0,"ا",2,0],["وكن رجلاً في العلا حُوَّلاً","تفَنَّنُ في سيره الراشد",1,"د",1,0],["وَكُن رَجُلاً ناهِضاً يَنتَمي","إِلى نَفسِهِ عِندَما يُسأَلُ",2,"ل",1,0],["وَكُن رَجُلاً إِن أَتَوا بَعدَهُ","يَقولونَ مَرَّ وَهَذا الأَثَر",3,"ر",1,0],["وَكُنْ رَجُلاً إِنْ سِيمَ خَسْفاً رَمَتْ بِهِ","حَمِيَّتُهُ بَيْنَ الصَّوَارِمِ وَاللُّدْنِ",4,"ن",1,0],["وَكُن رَجُلاً أَضاعَ العِل","مَ في اللَذّاتِ وَالخَطَرا",5,"ر",2,0],["وكن رجلاً جامعاً للأمو","ر يزني ويلتاطَ في موضع",6,"ع",1,0],["وكن رجلَ الساعةِ المجتبَى","من اليوم ما يرتجى في غد",7,"د",1,0],["وكن رجلاً في العلى حُوَّلا","تفنن في سيره الراشد",8,"د",1,0],["وَكُن راحِماً مَن يَبتَغي رَدَّ مالِهِ","أَذَلَّ مِنَ المُستَرفِدي الناسِ أَوقِفا",9,"ف",2,0],["وَكن رَفيقي في دار السلام اذا","كنا بمقعد صدق جيرة الصمد",10,"د",1,0],["وَكُن راهِباً عِندَ الوَعيدِ وَراغِباً","إِذا ما تَلَوَّثَ الوَعدُ في غايَةِ البِشرِ",11,"ر",1,0],["وكن رائبا ما يختفى في حوادث","ولاتك راجى النفع من ريق ثعبان",12,"ن",1,0],["وكن راضي وقانع","يمر العمر راحات",13,"ت",1,0],["وكن رقيباً حفيظاً واكفني نظراً","من العيون وقيني كيد من كيد",14,"د",1,0],["وَكُن رَفيقاً رَفيقاً لا تَكُن ضَجِراً","فَخَيرُ مَن رافَقَ الإِنسانَ مَن رَفِقا",15,"ق",2,0],["وكن راحماً ذلَّ أرواحنا","إذا ما أتيناك يوم الندم",16,"م",1,0],["وكن رجلاً يبغي خويصة نفسه","عسى أن توافي في الجنان مخلدا",17,"د",2,0],["وكنْ رجلاً عارفاً حقهُ","فإنكَ تدري لذاكَ رجالاَ",18,"ل",2,0],["وَكُنْ رَجُلاً في النّاسِ باطِنُهُ يُرى","كَظاهِرِهِ حَتّى تُعدَّ نَبيها",19,"ه",2,1],["وَكُن راضِياً فيما بِهِ اللَّه قَد قَضى","فَما لِسِوى مَولاكَ شَيءٌ مِنَ الأمرِ",20,"ر",1,0],["وَكُن رَفيعاً ماجِداً","وَاِصبِر عَلى ما لَم تُرِد",21,"د",1,0],["وكن راضيا بالمر يجزيك بعده","حلاوة وصل ليس فيه تفرق",22,"ق",1,0],["وكن رجلاً على صغرٍ وأيّا","تشا منّا تجده أباً حنونا",23,"ن",2,0],["وكن راجعاً لله في كلّ حالة","فليس لنا، إلا إلى الله، مرجع",24,"ع",1,0],["وكن رجلاً لا يغلب الضيم صبره","فان جزوع النفس بالضيم يغلب",25,"ب",1,0],["وكن رجلاً جلداً إذا انقلبتْ","عليه بناتُ الدهر يوماً تقلبا",26,"ب",2,0],["وكن رافعا قبل القيام الطعام قد","نهي عن قيام قبل رفع المميد",27,"د",1,0],["وَكُن راغِباً عَمَّن سِواهُ مِنَ الوَرى","وَدَع كُلَّ خِبٍّ وَاِصرِمَنَّ وَجانِبِ",28,"ب",1,0],["وَكُن راغِباً فيمَن تَعيشُ بِظِلِّهِ","وَذَلِكَ ذو البَطشِ الشَديدِ وَذو الحِلمِ",29,"م",1,0],["وكن رائدَ الشيءِ الذي يطلبونَه","وانْ كانَ فيهِ للعدوِّ مَقَالُ",30,"ل",1,0],["وَكُن راغِباً في الوَحيَ لا عَنهُ راغِباً","كَخابِطِ لَيلٍ تائِهٍ في رَجائِهِ",31,"ا",3,0],["وكن راحم المسكين واصل رحمه","وإياك أن تبدو له بالتبلخ",32,"خ",1,0],["وكن راضيا من بعد سخطٍ على القضا","براضٍ ومَرضىِّ الكرام الأطائب",33,"ب",1,0],["وكنْ رؤوفَا ..إذا حمّلتني لحَظا ..","فالآه مِن لحظٍ .. سيفٌ يُمزقني",34,"ن",2,0],["وكُنْ رَاضٍ بِما أوتيتَ حتى","وإنْ علِقَتْ ضلوعُكَ في الحصيرِ",35,"ر",1,0],["وكن رجلا مطيعاً في ثباتٍ","فإن جاء الحسابُ فقد سلِمتا",36,"ت",2,0],["وكن رائيا ما يختفى في حوادث","ولا تك راجي النفع من ريق ثعبان",37,"ن",1,0]]}