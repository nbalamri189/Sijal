{"poems":[[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[115,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[261,"قل للأمير المرتجى","https://www.aldiwan.net/poem48550.html","مجزوء الرجز"],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[558,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129545","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96746","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47477","الرجز"],[1855,"","https://poetry.dctabudhabi.ae/diwan/poem/145213","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87792","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109852","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204799","الوافر"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132672","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109975","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85088","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34580","الطويل"],[5277,"طفوفٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=199895",""],[5970,"أحمل من ويلاتها ما أحمل","https://www.poetsgate.com/ViewPoem.aspx?id=130653",""]],"verses":[["مُؤَزَّرَةٌ بِالرُعبِ مَلدوغَةٌ بِهِ","فَفي كُلِّ ثَوبٍ عَقرَبٌ مِنهُ تَلسِبُ",0,"ب",1,0],["مُؤَزَّرَةً مِن صَنعَةِ الوَبلِ وَالنَدى","بِوَشيٍ وَلا وَشيٌ وَعَصبٍ وَلا عَصبُ",1,"ب",1,0],["موزونَةٍ عَلَى عَروضِ الرَّجَز","كثيرة المعنَى بلفظٍ موجَز",2,"ز",1,0],["مؤزراً بالجعس في","حافاته مصهرجا",3,"ج",2,0],["موزعاً في جميع الأرض نعمته","بحكمة عجزت عن وصفها الكلم",4,"م",1,0],["موزعون بأمريكا لها عرب","من العبيد وروسيا لها عرب",5,"ب",1,0],["مُؤَزَّرَةٍ بِالآلِ فيها كَأَنَّها","رِجالٌ قُعودٌ في مَلاءٍ مُعَضَّدِ",6,"د",1,0],["موزع الآمال بين الرجا","واليأس لا تدعى ولا تصرف",7,"ف",1,0],["موزونة في ضربِها وعروضِها","تنبيك عن قسٍّ وعن سحبانِ",8,"ن",1,0],["مَوزٌ سَرِيعٌ أَكْلُهُ","مِن قِبَلِ مَغِ الْمَاضِغِ",9,"غ",1,1],["مؤزر بجميل الصنع متئد","إلى المكارم والخيرات مستبق",10,"ق",1,0],["مُوزَّعة في الناس ساعات عُمره","وَمُحتَسَبٌ في اللَه ما كان عُمِّرا",11,"ر",2,0],["مؤزرات بثياب الشعر","على ثياب من نسيج الابر",12,"ر",1,0],["موزعة بأشعاري أراها","وما ضمت سوى الفكر الصواب",13,"ب",1,0],["موزع الأشلاء ثاو وقد","صار لأسهام العدى أسهما",14,"م",2,0],["موزع الجسم روح القدس يندبه","شجواً وناظره بالدمع مندفق",15,"ق",1,0],["مؤَزَّرٌ بإِزارِ الصَونِ محتجبٌ","على الصِيانةِ قد زُمَّت مآزرهُ",16,"ر",2,0],["موزع النِعَم العَلياءِ مطِّلِعاً","على العباد عليماً عينَ عقلهم",17,"م",1,0],["مؤزرين بثوبي حشمة وثقي","ما مسنا نصب للإثم أو لغب",18,"ب",1,0],["مؤزرةُ السربال مهضومةُ الحشى","غلامية التقطيعِ شاطرةُ القدِّ",19,"د",1,0],["موزّعٌ ..لا أرى في الصبحِ بسمتَها","وما شربتُ منَ العينينِ يكفيني",20,"ن",2,0],["موزعة فينا الخطوب فكلنا","له حظه منها جهول وعاقل",21,"ل",1,0]]}