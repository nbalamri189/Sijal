الطَلَبِ","فَاِسبِق بِعَزمِكَ سَيرَ الأَنجُمِ الشُهُبِ",2,"ب",1,1],["لِكُلِّ جَفنٍ عَلى خَدّي عَلى حِدَةٍ","طَريقَةٌ دَمعُها مُستَوكِفٌ جارِ",3,"ر",1,0],["لُكُلِ اِمرىءٍ شَكلٌ مِنَ الناسِ مِثلُهُ","وَكُلُّ امرىءٍ يَهوى إِلى مَن يُشاكِلُه",4,"ل",2,1],["لِكُلِّ فَريقٍ بِهِ لُعبَةٌ","تُلائِمُ مِن سِنِّهِ ما خَلا",5,"ا",1,0],["لِكُلِّ عَظيمَةٍ تُدعى فَتُبلي","بَلاءَ مُجَرِّبٍ يَحدوهُ عَقلُ",6,"ل",1,0],["لِكُلِّ نَجيدٍ في النِجادِ كَأَنَّما","تُناطُ بِمَتنِ الرُمحِ مِنهُ الحَمائِلُ",7,"ل",1,0],["لِكُلِّ شَيءٍ إِذا ما تَمّ نُقصانُ","فَلا يُغَرَّ بِطيبِ العَيشِ إِنسانُ",8,"ن",1,1],["لِكُلِّ زَمَانٍ فَخَارٌ بِفَرْدِ","وأَنْتَ فَخَارٌ لِهَذَا الزَّمَانِ",9,"ن",1,0],["لكليهما الهرمان قد خشعا أسىً","والنيل مدّ أنينه بخريره",10,"ر",2,0],["لِكُلِّ أُناسٍ ميسَمٌ يَعرِفونَهُ","وَميسَمُنا فينا القَوافي الأَوابِدُ",11,"د",1,0],["لِكُلِّ نَجيبٍ مُنجِبٍ زَخَرَت بِهِ","مُهَذَّبَةٌ أَعراقُها لَم تُرَهَّقِ",12,"ق",1,0],["لكل قاصر علم عنه لمحته","رأيٌ يفرق بين الماء واللبن",13,"ن",1,0],["لكل امرئٍ والاك حظُّ سعيده","وكلُّ امرئٍ عاداك حظُّ شقيه",14,"ي",2,0],["لكلٍّ مكانٌ لا يَسُدُّ اخْتلالَهُ","مكانُ أخيه في جَزُوعٍ ولا جَلدِ",15,"د",1,0],["لكل قومٍ يُعدُّ مجدُهُمُ","آصال مجدٍ سَهمتهم بُكره",16,"ر",2,0],["لكل جليسٍ من يديه ووجهه","يدَ الدهرِ يومٌ غائمُ الجو شامسه",17,"س",2,0],["لك لحيةٌ مخضوبةٌ","بعصير أظلاف التيوس",18,"س",1,0],["لكلِّ امرىءٍ من شيبه وخِضابهِ","عناءٌ مُعنٍّ أو بغيضٌ مُرابطُ",19,"ط",1,0],["لكل بديلٍ حين يخلو مكانُهُ","وما لبني وهب من الناس أبدالُ",20,"ل",1,0],["لكلّ قومٍ رسومٌ أنت راسمُها","ولستُ فيهم بذي رسْم ولا طللِ",21,"ل",1,0],["لكلّ نزيل قد أعدَّ عتاده","فللضيف ترحيب ومَثْوىً مكرَّمُ",22,"م",1,0],["لِكُلِّ عَيْنٍ رأتْهُ يوماً","من رَيْبِ أزمانها الأمان",23,"ن",1,0],["لِكُلِّ مَسيلٍ مِن تِهامَةَ بَعدَما","تَقَطَّعَ أَقرانُ السَحابِ عَجيجُ",24,"ج",1,0],["لِكُلِّ فَتاةٍ خِدرُها وَسِوارُها","وَلَكِنَّ هَذي كُلُّ قَلبٍ لَها خِدرُ",25,"ر",1,0],["لِكُلٍّ مِنَ الدُنيا حَبيب وَذا الَّذي","أَشُدُّ بِهِ أَزري وَيَعلو بِهِ قَدري",26,"ر",2,0],["لِكُلِّ ذي هِمَّةٍ في دَهرِهِ أَمَلٌ","وَكُلُّ ذي أَمَلٍ في الدَهرِ ذو أَلَمِ",27,"م",1,0],["لِكُلِّ أُناسٍ سَيِّدٌ يَعرِفونَهُ","وَسَيِّدُنا حَتّى المَماتِ رَبيعُ",28,"ع",1,1],["لِكُلِّ اِمرِئٍ مِنهُ نَصيبٌ يَخُصُّهُ","يُلائِمُ ما في طَبعِهِ وَيُوافِقُ",29,"ق",1,0],["لَكَ لا أَشُكُّ قَضِيَّةٌ","أَنا سائِلٌ عَنها وَباحِث",30,"ث",1,0],["لكل شيء في الليا","لي السود ظل مبهم",31,"م",1,0],["لكل حي على ه","ذي الأرض مخترعات",32,"ت",1,0],["لكل طلوعٍ يا ذُكاء أفول","فنورك هذا في المساء يزولُ",33,"ل",1,1],["لكل مقولة منها إليها","على الدور ابتداءٌ وانتهاءُ",34,"ا",2,0],["لكل عنده في البر","حق ليس يهضمه",35,"م",2,0],["لكل شئ زمان ينقضى معه","فودّعوا النوق واطووا ذكر حاديها",36,"ي",3,0],["لكل حزبه وبه يريب","وكنت لربك الحزب الأمينا",37,"ن",2,0],["لِكُلِّ حالٍ حُلوُها وَمُرُّها","ما أَدَبُ النَعجَةِ إِلّا صَبرُها",38,"ه",2,0],["لِكُلِّ شَيءٍ في الحَياةِ وَقتُهُ","وَغايَةُ المُستَعجِلينَ فَوتُهُ",39,"ه",1,0],["لِكُلِّ يَومٍ خُطوبٌ","تَكفي وَشُغلٌ عَظيمُ",40,"م",1,0],["لِكُلِّ جَنىً زَكاةً في الحَياةِ","وَمَعنى البِرِّ في لَفظِ الزَكاةِ",41,"ه",1,0],["لِكُلِّ لَبوءَةٍ وَلِكُلِّ شِبلٍ","نِضالٌ دونَ غايَتِهِ وَرَشقُ",42,"ق",1,0],["لِكُلِّ يَومٍ غَدٌ يَمضي بِرَوعَتِهِ","وَما لِيَومِكَ يا خَيرَ اللِداتِ غَدُ",43,"د",1,0],["لِكُلِّ زَمانٍ مَضى آيَةٌ","وَآيَةُ هَذا الزَمانِ الصُحُف",44,"ف",1,1],["لِكُلِّ اِمرِئٍ مِن دَهرِهِ ما تَعَوَّدا","وَعادَتُ سَيفِ الدَولَةِ الطَعنُ في العِدا",45,"د",2,1],["لِكُلِّ قَبيلَةٍ خَيلٌ تَداعى","إِلى خَيلٍ مُعاوِدَةِ الرَكوبِ",46,"ب",1,0],["لِكُلِّ قَبيلٍ شُعبَةٌ مِن نَوالِهِ","وَيَختَصُّهُ مِنهُم قَبيلٌ إِذا انتَمى",47,"م",2,0],["لِكُلِّ الداءِ بيطارٌ وَعِلمٌ","وَبيطارُ الكَلامِ أَبو زِيادِ",48,"د",1,1],["لِكَلبٍ حَصىً لا يَحسِبُ الناسُ قِبصَهُ","وَأَكثَرُ مِن كَلبٍ عَديداً نَصيرُها",49,"ر",3,1],["لِكُلِّ اِمرِئٍ نَفسانِ نَفسٌ كَريمَةٌ","وَأُخرى يُعاصيها الفَتى أَو يُطيعُها",50,"ه",2,1],["لَكَلَّفتُكَ الشَأوَ الَّذي لَستَ نايِلاً","وَحَتّى تَرى أَنَّ الذَنوبَينِ أَثقَلُ",51,"ل",1,0],["لكل شيء حسن آفة","وآفة المرد نبات اللحى",52,"ا",1,1],["لِكُلِّ نَفسٍ وَإِن كانَت عَلى وَجَلٍ","مِنَ المَنيَّةِ آمالٌ تُقَوّيها",53,"ي",3,0],["لِكُلِّ اِجتماعٍ مِن خَليلَينِ فِرقَةٌ","وَكُلُّ الَّذي دونَ المَماتِ قلَيلُ",54,"ل",1,0],["لِكُلِّ هَمٍّ فَرَجٌ عاجِلٌ","يَأتي عَلى المُصبِحِ وَالمُمسي",55,"ي",1,0],["لِكُلٍّ مِنَ الأَيّامِ عِندي عادَةٌ","فَإِن ساءَني صَبرٌ وَإِن سَرَّني شُكرُ",56,"ر",1,0],["لِكُلِّ داءٍ دَواءٌ عِندَ عالِمِهِ","مَن لَم يَكُن عالِماً لَم يَدرِ ما الداءُ",57,"ا",2,0],["لِكُلِّ امرِئٍ فيما قَضى اللَهُ خُطَّةٌ","مِنَ الأَمرِ فيها يَستَوي العَبدُ وَالمَولى",58,"ا",1,0],["لِكُلِّ أَمرٍ جَرى فيهِ القَضا سَبَبُ","وَالدَهرُ فيهِ وَفي تَصريفِهِ عَجَبُ",59,"ب",1,1],["لِكُلِّ امرِئٍ مِن سَكرَةِ المَوتِ سَكرَةٌ","وَأَيُّ امرِئٍ مِن سَكرَةِ المَوتِ يُفلِتُ",60,"ت",1,0],["لِكُلِّ أَخي ثُكلٍ عَزاءٌ وَأُسوَةٌ","إِذا كانَ مِن أَهلِ التُقى في مُحَمَّدِ",61,"د",1,0],["لِكُلِّ امرِئٍ رَأيانِ رَأيٌ يَكُفُّهُ","عَنِ الشَيءِ أَحياناً وَرَأيٌ يُنازِعُ",62,"ع",1,0],["لِكُلِّ امرِئٍ حَيٍّ مِنَ المَوتِ خُطَّةٌ","يَصيرُ إِلَيها حينَ يَستَكمِلُ الرِزقا",63,"ق",2,0],["لِكُلِّ مَقامٌ قائِمٌ لا يَجوزُهُ","فَدَع غَيَّ قَلبٍ خائِضٍ في فُتونِهِ",64,"ن",2,0],["لِكُلِّ شَيءٍ إِذا عَلَّلتَهُ سَبَبٌ","وَأَنتَ لِلرِزقِ في كُلِّ الوَرى سَبَبُ",65,"ب",1,0],["لِكُلِّ أُناسٍ مِن مَعَدٍّ عِمارَةٌ","عَروضٌ إِلَيها يَلجَؤونَ وَجانِبُ",66,"ب",1,0],["لِكُلَيبٍ إِذِ الرِياحُ عَلَيهِ","ناسِفاتُ التُرابِ بِالأَذيالِ",67,"ل",1,0],["لكلّ محِبٍّ نظرَةٌ تَبعثُ الهوَى","ولي نَظرةٌ نحوَ القَتول هي القتلُ",68,"ل",1,1],["لِكُلِّ زَمانٍ واعظٌ وعظه كما","يخط كلاماً بالإِشارة أَبكمُ",69,"م",1,0],["لكلّ غارٍ فيه ماء وشَوَى","فيه أُوَارُ الشمس كلّ ضفدعِ",70,"ع",1,0],["لكلٍّ حياةٌ ثمَّ موتٌ ومبعثٌ","إِذا ما التقى الخَصمانِ بين يَدَيْ ربِّي",71,"ب",2,0],["لِكُلٍّ مِن بَني حَوّاءَ عُذرٌ","وَلا عُذرٌ لِطائِيٍّ لَئيمِ",72,"م",1,0],["لِكُلِّ شَيْءٍ آفَةٌ","وَآفَةُ الْقَلْبِ الْهَوَى",73,"و",2,0],["لِكُلِّ عَصْرٍ رِجَالٌ يُذْكَرُونَ بِهِ","وَالْفَضْلُ بِالنَّفْسِ لَيْسَ الْفَضْلُ بِالْقِدَمِ",74,"م",1,0],["لَكَلَّفَني قَلبي أُتابِعكِ إِنَّني","بِذِكراكِ أُخرى الدَهرِ صَبٌّ مُتَيَّمُ",75,"م",1,0],["لِكُلِّ لِقاءٍ نَلتَ