{"poems":[[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[80,"أجلو عروسا بخدها خجل","https://www.aldiwan.net/poem31369.html","المنسرح"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[142,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[237,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[458,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[479,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[558,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"]],"verses":[["وَفَحَصتُ عَن سَببٍ عَصَيتُ بِهِ النّهى","فَوَجدتُهُ ذُلّاً يُطيعُ دلالا",0,"ل",2,0],["وفَحمَةُ اللَّيلِ كلَّما اعتَرَضَتْ","ألْهَبَ فيها اتّقادَهُ الفلقُ",1,"ق",1,0],["وَفُحولٍ هَيكَلاتٍ وُقُحٍ","أَعوَجِيّاتٍ عَلى الشَأوِ أُزُم",2,"م",1,0],["وفحصتُ أطرافي فكانت كلُّها","توحي الىَّ معرّة الإهْمال",3,"ل",1,0],["وفحشاء أدّتها إليك جهالةٌ","جعلتَ رتاجَ الحلم من دونها سِترا",4,"ر",2,0],["وَفُحُولُ الدِّلاَءِ قَدْ خَرَّمُوهَا","وَإِمَامُهُمْ شَارِحُ التَّسْهِيلِ",5,"ل",1,0],["وفحمةٍ من الخطو","ب ذات وجهٍ مفزعِ",6,"ع",1,0],["وفحمةِ ليل كالشعور اهتديتها","بقدحة برق كالثغور لموعِ",7,"ع",1,0],["وفحيح بركان الهيام مسعر","هيجان قلبي فاعتراه وجيب",8,"ب",1,0],["وفحش غيبة ونميمة مع","مرآء والجدال وطعن جاني",9,"ي",1,0]]}