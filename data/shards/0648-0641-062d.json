{"poems":[[82,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[82,"أجلو عروسا بخدها خجل","https://www.aldiwan.net/poem31369.html","المنسرح"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[92,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[146,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[242,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[463,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[484,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[563,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[997,"","https://poetry.dctabudhabi.ae/diwan/poem/132404","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59426","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64832","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124753","الطويل"],[2906,"","https://poetry.dctabudhabi.ae/diwan/poem/29672","الهزج"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123509","الطويل"],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5419,"بين الشعراء أنا عجبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=31465",""],[5581,"فزورة","https://www.poetsgate.com/ViewPoem.aspx?id=22515",""],[6262,"لغةٌ أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""]],"verses":[["وَفَحَصتُ عَن سَببٍ عَصَيتُ بِهِ النّهى","فَوَجدتُهُ ذُلّاً يُطيعُ دلالا",0,"ل",2,0],["وفَحمَةُ اللَّيلِ كلَّما اعتَرَضَتْ","ألْهَبَ فيها اتّقادَهُ الفلقُ",1,"ق",1,0],["وَفُحولٍ هَيكَلاتٍ وُقُحٍ","أَعوَجِيّاتٍ عَلى الشَأوِ أُزُم",2,"م",1,0],["وفحصتُ أطرافي فكانت كلُّها","توحي الىَّ معرّة الإهْمال",3,"ل",1,0],["وفحشاء أدّتها إليك جهالةٌ","جعلتَ رتاجَ الحلم من دونها سِترا",4,"ر",2,0],["وَفُحُولُ الدِّلاَءِ قَدْ خَرَّمُوهَا","وَإِمَامُهُمْ شَارِحُ التَّسْهِيلِ",5,"ل",1,0],["وفحمةٍ من الخطو","ب ذات وجهٍ مفزعِ",6,"ع",1,0],["وفحمةِ ليل كالشعور اهتديتها","بقدحة برق كالثغور لموعِ",7,"ع",1,0],["وفحيح بركان الهيام مسعر","هيجان قلبي فاعتراه وجيب",8,"ب",1,0],["وفحش غيبة ونميمة مع","مرآء والجدال وطعن جاني",9,"ن",2,0],["وفحوى خطاب ثم مفهوم ما به","يدل على مفهومه حيث يوجد",10,"د",1,0],["وفحل الغاب جاء إليه طوعا","وخاطبه وأذعن بانقياد",11,"د",1,0],["وفَحَصْتُ عنْ طُرُقِ المكارمِ والعُلا","ما كانَ يُمكنُ عاقلٌ أَنْ يفحَصَا",12,"ص",2,0],["وفح من العين الصحيحة جفنها","لتعرف نقصان المريضة أولُ",13,"ل",1,0],["وفحش ومكر والبذا وخديعة","وسخرية والهزء والكذب قيد",14,"د",1,0],["وَفَحلَ العانَةِ الجونِ ال","خِماصِ النُحُصِ الحُقبِ",15,"ب",1,0],["وفحش لسان مظهر العيب لاذع الصديق","كثير الخلط مستجهز الغمض",16,"ض",1,0],["وفحال نخل يختلفن نساؤهم","إليه بإهداء القرابين عن عمد",17,"د",1,0],["وفحولُ الشعرِ يؤرّقهم","وجدٌ في القلبِ يُسَهِّدُه",18,"د",2,0],["وف حضرتنا مش بيفكر ،","وإن جت سيره ، لا يتذكر ،",19,"ر",1,0],["وفحيحُ الوقتِ قد خلَّفني","حطباً يبكي بصدرِ المدفأه",20,"ا",2,0]]}