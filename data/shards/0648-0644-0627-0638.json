{"poems":[[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[72,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[12,"أنا السمع الأزل فلا أبالي","https://www.aldiwan.net/poem1204.html",""],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[28,"إن أستطع منك الدنو فإنني","https://www.aldiwan.net/poem4999.html","الطويل"],[61,"أدرها ففقد اللوم إحدى الغنائم","https://www.aldiwan.net/poem51452.html","الطويل"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"]],"verses":[["وَلا ظَفِرَت مِنكَ اللَيالي بِفُرصَةٍ","وَلا غالَ قَلباً بَينَ جَنبِكَ غولُ",0,"ل",1,0],["وَلَأَظعَنَنَّ دُجى الظَلامِ بِحَسرَةٍ","هَوجاءَ تَسأَلُ مَورِداً عَن مَورِدِ",1,"د",1,0],["وَلا ظَفِرَ الباغي عَلَيكَ بِفُرصَةٍ","وَلا طَلَبَ الأَعداءُ ما كُنتَ تَطلُبُ",2,"ب",1,0],["وَلا ظَرْفَ إِلاَّ عُطْلُهَا وَمَزِينُهَا","وَلا لُطْفَ إِلاَّ غُفْلُهَا وَالمَنَمْنَمُ",3,"م",1,0],["وَلاَ ظُعُنُ الحَيّ إِذ أدلَجَت","بَوَاكِرُ كالإِجلِ والرَّبرَبِ",4,"ب",1,0],["ولا ظنَّنا الواشون حرفاً مشدَّداً","لتوثيق جسمي في العناق وجسمها",5,"م",3,0],["وَلا ظَمَأٌ يُؤخِّرُني وحَرٌّ","ولا خَمصٌ يُقَصِّرُ من طِلابِ",6,"ب",1,0],["وَلاظَلَمَت إِذ لَم تُمَيِّل رَوِيَّةً","بُغاةُ النَدى في أَنَّ مالَكَ مالُها",7,"ل",3,0],["وَلا ظُلمَ ما دامَ الخَليفَةُ قائِماً","هِشامٌ وَما عَن أَهلِهِ مِن مُشَرَّدِ",8,"د",1,0],["ولا ظِلَّ إلا ظِلُّ كَرْمٍ مُعرَّشٍ","تُغَنِّيكَ في قُطرَيهِ وُرقُ الحمائمِ",9,"م",1,0],["ولا ظَنَنْتُ صِغارَ النّمْلِ يُمكِنُها","مَشْيٌ على اللُّجّ أو سَعْيٌ على السُّعُرِ",10,"ر",1,0],["ولا ظفروا بأصفى منك روحاً","كأن مزاجها من سلسبيل",11,"ل",1,0],["ولا ظلال حائط","ولا بقايا من فنن",12,"ن",1,0]]}