{"poems":[[55,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[55,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[55,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[39,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[74,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[12,"أنا السمع الأزل فلا أبالي","https://www.aldiwan.net/poem1204.html",""],[47,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[30,"إن أستطع منك الدنو فإنني","https://www.aldiwan.net/poem4999.html","الطويل"],[63,"أدرها ففقد اللوم إحدى الغنائم","https://www.aldiwan.net/poem51452.html","الطويل"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[132,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[242,"مهلا على القلب إن القلب قد لسبا","https://www.aldiwan.net/poem18037.html","البسيط"],[266,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[266,"لئن بعدت عن ناظر الصب داره","https://www.aldiwan.net/poem38144.html","الطويل"],[308,"ما كنت أحسب لولا نبت عارضه","https://www.aldiwan.net/poem57907.html","البسيط"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[463,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[470,"سلام على بغداد مرة أخرى","https://www.aldiwan.net/poem61435.html","عموديه"],[556,"على من ثوى أرض الحجاز تحية","https://www.aldiwan.net/poem47340.html","الطويل"],[556,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[556,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112450","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86737","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49544","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201715","الطويل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142761","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27431","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28497","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94306","البسيط"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101951","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68075","الطويل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69248","الطويل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111198","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135124","البسيط"],[4764,"حبست الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=27080",""],[4764,"تعود قلبي اطعونك","https://www.poetsgate.com/ViewPoem.aspx?id=30111",""],[4764,"حشمتك بكيفي","https://www.poetsgate.com/ViewPoem.aspx?id=34870",""],[4866,"دمعة الرجّال","https://www.poetsgate.com/ViewPoem.aspx?id=139717",""],[5150,"إلام الصمت يا عرب ..؟؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202873",""],[5358,"عسى ألا غيابَ","https://www.poetsgate.com/ViewPoem.aspx?id=27544",""],[223,"عابرة","https://www.poetsgate.com/ViewPoem.aspx?id=181152",""],[5616,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205241",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["وَلا ظَفِرَت مِنكَ اللَيالي بِفُرصَةٍ","وَلا غالَ قَلباً بَينَ جَنبِكَ غولُ",0,"ل",1,0],["وَلَأَظعَنَنَّ دُجى الظَلامِ بِحَسرَةٍ","هَوجاءَ تَسأَلُ مَورِداً عَن مَورِدِ",1,"د",1,0],["وَلا ظَفِرَ الباغي عَلَيكَ بِفُرصَةٍ","وَلا طَلَبَ الأَعداءُ ما كُنتَ تَطلُبُ",2,"ب",1,0],["وَلا ظَرْفَ إِلاَّ عُطْلُهَا وَمَزِينُهَا","وَلا لُطْفَ إِلاَّ غُفْلُهَا وَالمَنَمْنَمُ",3,"م",1,0],["وَلاَ ظُعُنُ الحَيّ إِذ أدلَجَت","بَوَاكِرُ كالإِجلِ والرَّبرَبِ",4,"ب",1,0],["ولا ظنَّنا الواشون حرفاً مشدَّداً","لتوثيق جسمي في العناق وجسمها",5,"م",3,0],["وَلا ظَمَأٌ يُؤخِّرُني وحَرٌّ","ولا خَمصٌ يُقَصِّرُ من طِلابِ",6,"ب",1,0],["وَلاظَلَمَت إِذ لَم تُمَيِّل رَوِيَّةً","بُغاةُ النَدى في أَنَّ مالَكَ مالُها",7,"ل",3,0],["وَلا ظُلمَ ما دامَ الخَليفَةُ قائِماً","هِشامٌ وَما عَن أَهلِهِ مِن مُشَرَّدِ",8,"د",1,0],["ولا ظِلَّ إلا ظِلُّ كَرْمٍ مُعرَّشٍ","تُغَنِّيكَ في قُطرَيهِ وُرقُ الحمائمِ",9,"م",1,0],["ولا ظَنَنْتُ صِغارَ النّمْلِ يُمكِنُها","مَشْيٌ على اللُّجّ أو سَعْيٌ على السُّعُرِ",10,"ر",1,0],["ولا ظفروا بأصفى منك روحاً","كأن مزاجها من سلسبيل",11,"ل",1,0],["ولا ظلال حائط","ولا بقايا من فنن",12,"ن",1,0],["ولا ظهر الدينُ الحنيفي ولا الهدى","ولا اشتهرَ الجدوى ولا ذكرَ الرّفدُ",13,"د",1,0],["وَلا ظَفِرَت بِالنُجحِ طُلّابُ غايَةٍ","تَروحُ وَفي كَفِّ المُعادي زِمامُها",14,"م",3,0],["وَلاَ ظَفِرْتُ بِمَا أَرْجُوهُ مِنْ وَطَرٍ","وَلاَ بَرِحْتُ أُعَانِي الْكَدَّ وَالْوَصَبَا",15,"ب",2,0],["ولا ظهرته العين فيضا بعبرتي","فضمخه من اخميصها عبيرها",16,"ر",3,0],["ولا ظلمت أشياعه وعفاته","ولا الضاع مأسوراً ولا ضاع ثاره",17,"ر",2,0],["ولا ظننت صغار النمل يمكنها","مشيا على اللج أو سعيا على السعر",18,"ر",1,0],["ولا ظَمئَ الدهرُ إلا سَكبتَ","عليه سحائبَ تروي أوامَهْ",19,"م",2,0],["ولا ظُعُنٌ ثَمّ مرحولةٌ","تجرُّ الجنوبَ ولا ضيفَ يُقْرى",20,"ر",2,0],["ولا ظِلَّ إلا ظِلَّها نَتَفَيَّأ ُ","وإلا سَناها في الشِّتا نَتَدَفَّأ ُ!",21,"ا",1,0],["ولا ظَفِرتْ أيدي الخطوبِ بربْعِه","ولا أبصرتْه العينُ وهو هطولُ",22,"ل",1,0],["وَلا ظفِرتمْ وقد جُنّتْ بكم نُوَبٌ","مقلقلاتٌ بتمهيدٍ وتوطيدِ",23,"د",1,0],["وَلا ظِلَّ إلّا ما تُفيءُ لك القَنا","وَلا زادَ إلّا نُجعةُ الطّعنِ والضّربِ",24,"ب",1,0],["ولا ظلام حظي","ينجاب عن أقماري",25,"ر",2,0],["وَلا ظفر اللاهي بِإِغراء شادنٍ","بِهِ همت وَجداً وَهوَ غَير شرود",26,"د",1,0],["ولا ظَمِىءَ العلمُ المُضَيَّعُ أهْلُهُ","فساغ له إلا لديه شراب",27,"ب",1,0],["ولا ظبيَ لي أشكو إليه جناية","عليَّ ولا خود أروم وصالها",28,"ل",3,0],["ولا ظفرت بشئ من نوالكم","غير المنى وأكاذيب المواعيد",29,"د",1,0],["ولا ظهور لها فإنها نسبٌ","فكيف أجعلها في الدفع معتمدي",30,"د",2,0],["وَلا ظفروا مِن عِندِ قَيسٍ بنصرة","والأم خطبان يَكونُ لَها عندُ",31,"د",1,0],["ولا ظننت سيوف الهند إن صدئت","صفاحها مالها من صيقل جلا",32,"ل",2,0],["ولا ظهرت أحكام دين محمد","ولا بان منها حلها وحرامها",33,"م",3,0],["ولا ظاهر غَمزُ الحواجبِ مُعْلَن","ولا لومَ فيما بَيْنَنا وخصامُ",34,"م",1,0],["وَلا ظَفرت كَفّاكَ بِالخَيرِ بَعدَهُ","وَلا عِشتَ إِلّا في تَبارٍ مُخَيَّبِ",35,"ب",1,0],["ولأظفرن بهم بعزمة باسل","ماضي العزيمة كالهزبر الضيغم",36,"م",1,0],["ولا ظننت بأن الزهر منتقشاً","في ساحة الوهم والتخييل والفكر",37,"ر",1,0],["ولا ظِن الهوى يصحى .. وأحس بلهفة المشتاق","يناديني تعالي لي .. وأنا بروحي أنادي له",38,"ل",2,0],["ولا ظَني قِوى الإنسان / تِكابر / والكبر للرَب","كبيرة بس في جروحي اموت وضيقتي فيني",39,"ن",2,0],["ولاظن لك بها مسكن وكلٍ يسرق ابدوره","ثمارٍ لك تبينها ،، تأرجحها ،، على احبالي",40,"ل",2,0],["ولا ظنتي تلقين في جفوتك مقيال","ألا كيف ذوق المرّ أحسن من الحالي",41,"ل",2,0],["ولا ظلمٌ يوحدُكم","ولا خطرٌ ولا شغبُ",42,"ب",1,0],["ولا ظَعَنَتْ ركائبُ من قصَدْنا","ولا رحلوا ولا شُدَّ الرِّحَالُ",43,"ل",1,0],["ولاظلَ والنرجسُ المنتمي","إلى نفسه لا يحبُ الظلالْ",44,"ل",1,0],["ولا ظِلالاً بها ترتاحُ قافلتي","كلُّ الظلالِ التي شاهدتُها كذِبُ",45,"ب",1,0],["ولا ظرف غلا عطها ومزينها","ولا لطف غلا غفلها والمنمنم",46,"م",1,0],["وَلا ظَن بَحر النيل يَطفي سَعيرها","لَها مية شَعب لسانه دالع بحالها",47,"ل",3,0],["وَلا ظنتي لقمان يَشفي لَها أَلَم","وَبَلكي عَسى سُليمان يُوصف دوالها",47,"ل",3,0],["وَلا ظنتي بِالقاع تلمس خفوفها","تَراها مثل قطع السَراب بِزوالها",47,"ل",3,0]]}