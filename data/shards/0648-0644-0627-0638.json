{"poems":[[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[72,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[12,"أنا السمع الأزل فلا أبالي","https://www.aldiwan.net/poem1204.html",""],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[28,"إن أستطع منك الدنو فإنني","https://www.aldiwan.net/poem4999.html","الطويل"],[61,"أدرها ففقد اللوم إحدى الغنائم","https://www.aldiwan.net/poem51452.html","الطويل"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[128,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[169,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[237,"مهلا على القلب إن القلب قد لسبا","https://www.aldiwan.net/poem18037.html","البسيط"],[261,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[261,"لئن بعدت عن ناظر الصب داره","https://www.aldiwan.net/poem38144.html","الطويل"],[303,"ما كنت أحسب لولا نبت عارضه","https://www.aldiwan.net/poem57907.html","البسيط"],[439,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[458,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[465,"سلام على بغداد مرة أخرى","https://www.aldiwan.net/poem61435.html","عموديه"],[551,"على من ثوى أرض الحجاز تحية","https://www.aldiwan.net/poem47340.html","الطويل"],[551,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[551,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"]],"verses":[["وَلا ظَفِرَت مِنكَ اللَيالي بِفُرصَةٍ","وَلا غالَ قَلباً بَينَ جَنبِكَ غولُ",0,"ل",1,0],["وَلَأَظعَنَنَّ دُجى الظَلامِ بِحَسرَةٍ","هَوجاءَ تَسأَلُ مَورِداً عَن مَورِدِ",1,"د",1,0],["وَلا ظَفِرَ الباغي عَلَيكَ بِفُرصَةٍ","وَلا طَلَبَ الأَعداءُ ما كُنتَ تَطلُبُ",2,"ب",1,0],["وَلا ظَرْفَ إِلاَّ عُطْلُهَا وَمَزِينُهَا","وَلا لُطْفَ إِلاَّ غُفْلُهَا وَالمَنَمْنَمُ",3,"م",1,0],["وَلاَ ظُعُنُ الحَيّ إِذ أدلَجَت","بَوَاكِرُ كالإِجلِ والرَّبرَبِ",4,"ب",1,0],["ولا ظنَّنا الواشون حرفاً مشدَّداً","لتوثيق جسمي في العناق وجسمها",5,"م",3,0],["وَلا ظَمَأٌ يُؤخِّرُني وحَرٌّ","ولا خَمصٌ يُقَصِّرُ من طِلابِ",6,"ب",1,0],["وَلاظَلَمَت إِذ لَم تُمَيِّل رَوِيَّةً","بُغاةُ النَدى في أَنَّ مالَكَ مالُها",7,"ل",3,0],["وَلا ظُلمَ ما دامَ الخَليفَةُ قائِماً","هِشامٌ وَما عَن أَهلِهِ مِن مُشَرَّدِ",8,"د",1,0],["ولا ظِلَّ إلا ظِلُّ كَرْمٍ مُعرَّشٍ","تُغَنِّيكَ في قُطرَيهِ وُرقُ الحمائمِ",9,"م",1,0],["ولا ظَنَنْتُ صِغارَ النّمْلِ يُمكِنُها","مَشْيٌ على اللُّجّ أو سَعْيٌ على السُّعُرِ",10,"ر",1,0],["ولا ظفروا بأصفى منك روحاً","كأن مزاجها من سلسبيل",11,"ل",1,0],["ولا ظلال حائط","ولا بقايا من فنن",12,"ن",1,0],["ولا ظهر الدينُ الحنيفي ولا الهدى","ولا اشتهرَ الجدوى ولا ذكرَ الرّفدُ",13,"د",1,0],["وَلا ظَفِرَت بِالنُجحِ طُلّابُ غايَةٍ","تَروحُ وَفي كَفِّ المُعادي زِمامُها",14,"م",3,0],["وَلاَ ظَفِرْتُ بِمَا أَرْجُوهُ مِنْ وَطَرٍ","وَلاَ بَرِحْتُ أُعَانِي الْكَدَّ وَالْوَصَبَا",15,"ب",2,0],["ولا ظهرته العين فيضا بعبرتي","فضمخه من اخميصها عبيرها",16,"ر",3,0],["ولا ظلمت أشياعه وعفاته","ولا الضاع مأسوراً ولا ضاع ثاره",17,"ر",2,0],["ولا ظننت صغار النمل يمكنها","مشيا على اللج أو سعيا على السعر",18,"ر",1,0],["ولا ظَمئَ الدهرُ إلا سَكبتَ","عليه سحائبَ تروي أوامَهْ",19,"م",2,0],["ولا ظُعُنٌ ثَمّ مرحولةٌ","تجرُّ الجنوبَ ولا ضيفَ يُقْرى",20,"ر",2,0],["ولا ظِلَّ إلا ظِلَّها نَتَفَيَّأ ُ","وإلا سَناها في الشِّتا نَتَدَفَّأ ُ!",21,"ا",1,0],["ولا ظَفِرتْ أيدي الخطوبِ بربْعِه","ولا أبصرتْه العينُ وهو هطولُ",22,"ل",1,0],["وَلا ظفِرتمْ وقد جُنّتْ بكم نُوَبٌ","مقلقلاتٌ بتمهيدٍ وتوطيدِ",23,"د",1,0],["وَلا ظِلَّ إلّا ما تُفيءُ لك القَنا","وَلا زادَ إلّا نُجعةُ الطّعنِ والضّربِ",24,"ب",1,0]]}