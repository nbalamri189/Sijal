{"poems":[[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[93,"هنيئاً أيها الملك الهمام","https://www.aldiwan.net/poem11307.html","الوافر"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[47,"لاغرو إن فتنتك بال","https://www.aldiwan.net/poem25118.html","مجزوء الكامل"],[72,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[62,"فديتك قد حان وقت الصبوح","https://www.aldiwan.net/poem52395.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54512","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[106,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""]],"verses":[["فمُصْبَحُهُ يَجْلو بهِ الفَجْرُ مَبْسِماً","ومُمْساهُ تُلْقى عندَهُ الشّمْسُ كَلْكَلا",0,"ل",2,0],["فمصر تُهَنِّيءُ الأُرْدُنَّ فِيهِ","ولُبْنَانُ يُهَنِّيءُ وَالشَّآمُ",1,"م",1,0],["فَمُصطَلَمُ المَسامِعِ أَو خَصِيٌّ","وَآخَرُ عَظمُ هامَتِهِ حُطامُ",2,"م",1,0],["فَمَصارِعُ العُشّاقِ ما","بَينَ الفُتورِ إِلى الفُتونِ",3,"ن",1,0],["فمصصت من رشفاته معسولها","وضممت من أعطافه عسّالها",4,"ل",3,0],["فَمِصرُ الرِياضُ وَسودانُها","عُيونُ الرِياضِ وَخُلجانُها",5,"ن",3,0],["فَمُصابُ المُلكِ في شُبّانِهِ","كَمُصابِ الأَرضِ في الزَرعِ النَضِر",6,"ر",1,0],["فمصلوبةٌ سُمِّرتْ كفُّها","إِلى جِيدها وهي لم تَشْعُرِ",7,"ر",1,0],["فمِصْرُ وَقَدْ حَيَّتْكَ يَا فَخْرَ يَعْرُبٍ","تحَيِّي النَّدَى وَالنُّبْلَ والْبَأْسَ وَالجَدَّا",8,"د",2,0],["فَمِصْرٌ فِي المَسْبَحَيْنِ وَالمَسْ","رَحَيْنِ مَرْفُوعَةُ اللِّواءِ",9,"ا",2,0],["فَمَصَابِيحُ تَمْلأُ الأَرْضَ نُوراً","وَمَصَابِيحُ مِثْلُهَا فِي السَمَاءِ",10,"ا",2,0],["فمصرُ كنَانةُ الرحم","نِ؛ لا تشْقَى، ولن تشقى!",11,"ق",2,0]]}