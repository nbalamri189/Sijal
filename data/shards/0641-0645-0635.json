{"poems":[[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[95,"هنيئاً أيها الملك الهمام","https://www.aldiwan.net/poem11307.html","الوافر"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[49,"لاغرو إن فتنتك بال","https://www.aldiwan.net/poem25118.html","مجزوء الكامل"],[74,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[87,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[87,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[64,"فديتك قد حان وقت الصبوح","https://www.aldiwan.net/poem52395.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54512","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[108,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""],[484,"لمتى الوقوف بجانب الأسطول","https://www.aldiwan.net/poem37199.html","الكامل"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[543,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[556,"فلو انني أنصفت نفسي لصنتها","https://www.aldiwan.net/poem47704.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138387",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138307",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138372",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138189",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126768","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103068","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137690",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104564","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64478","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71083","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110317","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84829","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83227","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83213","الوافر"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122490","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202408","الخفيف"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67595","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132714","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89320","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52977","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123942","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48372","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45798","المتدارك"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133300","البسيط"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141844","الكامل"],[4474,"","https://poetry.dctabudhabi.ae/diwan/poem/139828",""],[4978,"أحبكِ في صمت ولست بطامعِ","https://www.poetsgate.com/ViewPoem.aspx?id=177193",""],[5038,"كبرت اليوم أم تصغر","https://www.poetsgate.com/ViewPoem.aspx?id=189878",""],[585,"يا رافع الصوت ينعى المفرد العلما","https://www.poetsgate.com/ViewPoem.aspx?id=161938",""],[5121,"اللَّحْنُ الجَرِيحْ","https://www.poetsgate.com/ViewPoem.aspx?id=33509",""],[5183,"خفة الأروى","https://www.poetsgate.com/ViewPoem.aspx?id=186382",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5216,"أحزانُ أمَّتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=186987",""],[5376,"عادت قريشُ لتعبدَ الصنما","https://www.poetsgate.com/ViewPoem.aspx?id=194868",""],[5842,"أبكي مصاب الجامعة \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=130029",""],[5970,"آمال مصر بهذا القصر مودعة","https://www.poetsgate.com/ViewPoem.aspx?id=130660",""],[6106,"حكيم وشهم العرب الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=7067",""],[5957,"زرعت الحرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82433&r=&rc=71",""]],"verses":[["فمُصْبَحُهُ يَجْلو بهِ الفَجْرُ مَبْسِماً","ومُمْساهُ تُلْقى عندَهُ الشّمْسُ كَلْكَلا",0,"ل",2,0],["فمصر تُهَنِّيءُ الأُرْدُنَّ فِيهِ","ولُبْنَانُ يُهَنِّيءُ وَالشَّآمُ",1,"م",1,0],["فَمُصطَلَمُ المَسامِعِ أَو خَصِيٌّ","وَآخَرُ عَظمُ هامَتِهِ حُطامُ",2,"م",1,0],["فَمَصارِعُ العُشّاقِ ما","بَينَ الفُتورِ إِلى الفُتونِ",3,"ن",1,0],["فمصصت من رشفاته معسولها","وضممت من أعطافه عسّالها",4,"ل",3,0],["فَمِصرُ الرِياضُ وَسودانُها","عُيونُ الرِياضِ وَخُلجانُها",5,"ن",3,0],["فَمُصابُ المُلكِ في شُبّانِهِ","كَمُصابِ الأَرضِ في الزَرعِ النَضِر",6,"ر",1,0],["فمصلوبةٌ سُمِّرتْ كفُّها","إِلى جِيدها وهي لم تَشْعُرِ",7,"ر",1,0],["فمِصْرُ وَقَدْ حَيَّتْكَ يَا فَخْرَ يَعْرُبٍ","تحَيِّي النَّدَى وَالنُّبْلَ والْبَأْسَ وَالجَدَّا",8,"د",2,0],["فَمِصْرٌ فِي المَسْبَحَيْنِ وَالمَسْ","رَحَيْنِ مَرْفُوعَةُ اللِّواءِ",9,"ا",2,0],["فَمَصَابِيحُ تَمْلأُ الأَرْضَ نُوراً","وَمَصَابِيحُ مِثْلُهَا فِي السَمَاءِ",10,"ا",2,0],["فمصرُ كنَانةُ الرحم","نِ؛ لا تشْقَى، ولن تشقى!",11,"ق",2,0],["فمصيبة إن لم تكن بمصيبة","من لي بها في مسرح التمثيل",12,"ل",1,0],["فمصلحٌ تارةً وأُخرىْ","وليتنيْ بعدَها أُصيبُ",13,"ب",1,0],["فمُصَابُ المَرءِ في نابِغَةٍ","هُوَ جُرحٌ في الحشَا غَير أسِي",14,"ي",1,0],["فمصرعُ مَن ولّى من الذُّلِّ هارباً","ببيضِ الوغا أو سُمرها غيرُ مَصرعِ",15,"ع",1,0],["فمصالح الانام ليس لها سوى","قاض نزيه زينته علوم",16,"م",1,0],["فمصيفنا بين الحسان تمتع","بأعز ما نبغي وما نتخير",17,"ر",1,0],["فمصر طراً وقاه الله من ضرر","عند الجناية قد قامت على قدم",18,"م",1,0],["فمصر نصيبي في حياتي ولم أرم","بديلا ولو ما نالني دونها الضير",19,"ر",1,0],["فمصر أبصرَت منهُ جَمالاً","وأبهى غرّة بالعزّ غرّا",20,"ر",2,0],["فمصادر الأفعال باسمك أعربت","وله الإشارة وهو فيهم مضمر",21,"ر",1,0],["فمصلحة النفس دون سواها","تكون لديها صحيح الولا",22,"ل",2,0],["فمُصطخدُ الحِرباءِ مِن وقعِ حرّهِ","طنيٌّ يُراعي راحةً مِن طنيّهِ",23,"ي",2,0],["فَمصلح وَمُفسد","مُقَرب وَمبعد",24,"د",1,0],["فمصدر خلق العود كالبدأ واحد","وما حكمنا إلا كنفس وحيدة",25,"ه",1,0],["فمصر مكةً والشامَ قدماً","ويثرب واستقر بها وقرا",26,"ر",2,0],["فمُصَدِّقٌ بحكايتي ومُكَذِّبٌ","يُبْدِي تَبَسُّمَ ضاحِكٍ مُسْتَجْهلِ",27,"ل",1,0],["فمصر أهرامها عنه مخبرةٌ","وبعلبك عليه شاهدٌ أبدا",28,"د",2,0],["فَمُصَحّحُ الأوصَافِ وَالأفعَالِ وَال","أسمَاءِ حَقًّا ذَانِكَ الوَصفَان",29,"ن",1,0],["فَمصفد في قَيده لا يُفتدى","وَكَريمة تُسبى وَقَرط يَنزع",30,"ع",1,0],["فَمَصر لَها البُشرى برفعة شَأنِها","وَفيها السَنا وَالأُنس يَقتَرِنان",31,"ن",1,0],["فَمِصرُ جامِعَةُ الإِسلامِ مُنذُ بَدا","وَإِن يَكُن في صَلاحٍ شَعَّ مِن مُضَرِ",32,"ر",1,0],["فَمِصرُ كنانَةُ اللَهِ تَجَلّى","عَلَيها اللَهُ بِالسَبعِ المَثاني",33,"ن",2,0],["فَمِصرُ تُقَدِّرُ الإِخلاصَ مِنّا","وَنَحنُ لِمِصرَ ما بَقِيَت أَماني",33,"ن",2,0],["فمصرَعُ أحمدٍ غِطرِيفُ فاسٍ","رَأت فاسُ بِهِ يوماً ثَقِيلا",34,"ل",2,0],["فمصير الوجود من هدروجينٍ","جاهزٍ للدمار شرُّ مصير",35,"ر",1,0],["فَمُصاحِبُ الأيامِ يَشفعُ يا أخي","يوماً يُساءُ بهِ بآخَرَ مُقبلِ",36,"ل",1,0],["فمصرع العشاق من قوامها","وطرفها بين القنا والاسل",37,"ل",1,0],["فمصريْ حاذق وخافجي أصل","وشاميُّ القوَى أو مغربي",38,"ي",1,0],["فمصر قد حلفت من منذ ما حكمت","بمثله ما أتت لا تأتِ أيام",39,"م",1,0],["فمصرُ ما أجلَّها","الكل يهوى وصلَها",40,"ه",2,0],["فمصر وانحاء الجزيرة كلها","بمختلف الاشكال تبدى التشاكلا",41,"ل",2,0],["فمَصْنَعي والرّوضُ من تحتِه","للهِ ما أعْلى وما أجْمَلا",42,"ل",2,0],["فَمصادمه وَمَصارمه","يَصلي النيران وَلَم يَصل",43,"ل",1,0],["فمصر تدعو بنيها وهي واجمة","أن صيروا الغارة الشعواء ملحاحا",44,"ح",2,0],["فمصنفاتك سهلت وتنزهت","عن طاعن يرجو قذى أوعار",45,"ر",1,0],["فمصر دارها والقدس دار","وجلق والسويدا موطنان",46,"ن",1,0],["فمصدر إحساسي ونشوة خافقي","تجرد حبي عن بلوغ المطامع",47,"ع",1,0],["فَمِصْرٌ قَدْ غَدَتْ مِصْراً","وَتونسُ شَعْبُها الأخْضَرْ",48,"ر",1,0],["فمصر سعد وسعد مصر قاطبةً","كلاهما هو إن قال العدو هما",49,"م",2,0],["فَمِصْبَاحُ عَيْنِي تَنَاءَى كَشَمْسٍ","تَغِيِبُ ارْتِحَالاً بِيَوْمِ انْكِسَافِي",50,"ف",2,0],["فمصير الأمر إليه ولن يغلب ساعده زحف الدجج","نزوات الشر إليك فلا يغررك السبق على العرج",51,"ج",1,0],["فمصرُ كِنانَةٌ للأرضِ دومًا","تردُّ سِهامُها حقدًا دَفينا",52,"ن",2,0],["فَمِصْرُ تُريدُكُمْ عوْنًا وذُخْرًا","فَكونوا دِرْعَها الحاني الأَمينا",52,"ن",2,0],["فَمصرُ ساهِرَةٌ .. والشّامُ حائِرَةٌ","والقيروانُ تَبُثُّ الحُزْنَ للحَرمِ",53,"م",1,0],["فمصابُنا كل الهوان بنا","ومصابُنا في العاديات جَلَلْ",54,"ل",1,0],["فَمَصَانِعُ الأجيالِ أضحتْ","للمنايا صانعهْ",55,"ع",2,0],["فمصر علمت الدنيا وما بخلت","على الممالك قاصيها ودانيها",56,"ي",3,0],["فمصر تشهد أن الخير ديدنكم","فيها نشاهد ما أهديت من نعم",57,"م",1,0],["فمصر الطهر تبقى في دمانا","تشع النور والحق المبينا",58,"ن",2,0]]}