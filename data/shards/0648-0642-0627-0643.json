{"poems":[[57,"عيون العائدات تراك دوني","https://www.aldiwan.net/poem26195.html","الوافر"],[73,"وقاك الله مجد الدين عين الحسود","https://www.aldiwan.net/poem3850.html","الوافر"],[75,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[75,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[72,"أبى الله إلا أن تسود وتفضلا","https://www.aldiwan.net/poem42765.html","الطويل"],[45,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[47,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[82,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[46,"شهدت لقد لبست أبا سعيد","https://www.aldiwan.net/poem29712.html","الوافر"],[45,"أغالب فيك الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=153",""],[135,"لمن طلل بذات الخمس أمسى","https://www.aldiwan.net/poem24013.html","الوافر"],[164,"شكرك فرض من فروض العين","https://www.aldiwan.net/poem58911.html","الرجز"],[164,"ما جود راحتيك والأنواء","https://www.aldiwan.net/poem58975.html","الرجز"],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[242,"أملى الهنا والسعد ردد","https://www.aldiwan.net/poem18140.html","مجزوء الكامل"],[371,"وقاك الله من غلب الرجال","https://www.aldiwan.net/poem17258.html","الوافر"],[454,"تحلو الترانيم","https://www.aldiwan.net/poem985.html",""],[463,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[568,"شيوخ البيان الذائقين حلاوة","https://www.aldiwan.net/poem13607.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64094","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38944","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38982","البسيط"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99988","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70749","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59284","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64674","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48249","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77309","الكامل"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124600","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83245","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83242","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109798","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89007","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62824","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62937","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62857","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66531","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110047","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91290","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86544","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133267","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104915","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[1536,"أَيُرْضِيكِ أَنْ تَضْنَى فَدامَ لَكِ الرِّضا","https://www.poetsgate.com/ViewPoem.aspx?id=85721",""],[4935,"ألا قل لي فما ذنب المحب","https://www.poetsgate.com/ViewPoem.aspx?id=129352",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5112,"قمر البيان","https://www.poetsgate.com/ViewPoem.aspx?id=212997",""],[5277,"بصراويّة","https://www.poetsgate.com/ViewPoem.aspx?id=185787",""],[5277,"جوريّة","https://www.poetsgate.com/ViewPoem.aspx?id=188516",""],[5277,"طيفٌ من الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=202117",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5616,"حوت","https://www.poetsgate.com/ViewPoem.aspx?id=203472",""],[5956,"أهنىء مملكتي بذكاكم","https://www.poetsgate.com/ViewPoem.aspx?id=194564",""],[6031,"يا طِرْسُ قُلْ لخَليلَيَّ اللذَينِ هُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46349",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""]],"verses":[["وَقاكِ اللَهُ كُلَّ أَذىً بِنَفسي","وَعَجَّلَ يا ظَلومُ لَنا شِفاكِ",0,"ك",1,0],["وَقاكَ اللَهُ مَجدَ الدينِ عَينَ ال","حَسودِ مَلَأتَ لي قَلبي سُرورا",1,"ر",2,1],["وَقاكَ ما تَخشى مِنَ الدَهرِ مَن","تَعِبتَ في تَأمينِهِ وَاِستَراح",2,"ح",1,0],["وَقاكَ اللَهُ ما تَخشى وَوالى","عَلَيكَ بِصُنعِهِ المُغدى المُراحِ",3,"ح",1,0],["وَقاكَ الَّذي تَخشاهُ مِن كُلِّ حادِثٍ","جَميلٌ رَعاكَ اللَهُ فيهِ تَطَوُّلا",4,"ل",2,0],["وَقاكَ رَدى الأَعداءِ تَسري إِلَيهِمُ","وَزارَكَ فيهِ ذو الدَلالِ المُحَجَّبُ",5,"ب",1,0],["وَقاكَ لِغَيبِكَ المَأمونِ سِرّاً","وَظاهِرِ فِعلِكَ الحَسَنِ الجَميلِ",6,"ل",1,0],["وقاكِ الهوى إذ لم تذوقيه ضُرَّهُ","وهل تُحْدِثُ الخمرُ الخُمارَ بلا شرْبِ",7,"ب",1,0],["وَقاكَ الخَطبَ قَومٌ لَم يَمُدّوا","يَميناً لِلفَعالِ وَلا شِمالا",8,"ل",2,0],["وَقاكَ رَدى الأَعداءِ تَسري عليهِمُ","وَزارَكَ فيهِ ذو الدَلالِ المُحَجَّبُ",9,"ب",1,0],["وَقاكِ اللَهُ يا اِبنَةَ آلِ عَمروٍ","مِنَ الفِتيانِ أَمثالي وَنَفسي",10,"س",2,0],["وقاكم الرحمن سوء العين","فليس في ميزانكم من عين",11,"ن",1,0],["وقاك رب العرش ما تحذره","ولا اتقى سطوتك الأعداء",12,"ا",2,0],["وَقاكِ حِمامَكِ البَطَلُ المُحامي","أَبوكِ وَعَمُّكِ اللَيثُ الهُمامُ",13,"م",1,0],["وَقَاكَ مَنْ أَسْمَاكَ مِنْ","شَرٍّ تَصَوَّبَ أَوْ تَصَعَّدْ",14,"د",1,0],["وَقاكَ اللَهُ مِن غَلَبِ الرِجالِ","وَصانَ حِماكَ مِن غَضَبِ اللَيالي",15,"ل",2,1],["وقاك مولاك شر الحقد من فئة","لا يحسب الغدر منها أنه عجب",16,"ب",1,0],["وقاك حذارَك المالُ الملَقَّى","وبلَّغك المنى السيفُ القَطوعُ",17,"ع",1,0],["وَقاكَ الَّذي أَبداكَ كَالنَجمِ يَتَّقي","بِهِ الغَيَّ مَن يَبغي الهُدى وَيَعيهِ",18,"ي",2,0],["وَقَاكَ ذو العرشِ ما بقيتَ من ال","دهر فذو العرشِ خيرُ ما واقي",19,"ق",2,0],["وَقاكَ إِلَهي مِن كلِّ سوءٍ","شَفاكَ وَعافاكَ مِن كلِّ داءِ",20,"ا",2,0],["وَقاكَ ربّي مِنَ الأَسواءِ أَجمعها","وَدامَ مِنها مَدى الأَزمانِ يَحميكا",21,"ك",2,0],["وَقاكَ الَّذِ سَمّاكَ مُتَّقِياً لَهُ","فَأَنْتَ مِنَ الدَّهْرِ الغَشُومِ تُدِيلُ",22,"ل",1,0],["وقاك إلهُ العرشِ كل كريهة","نعم ووقَاك الحادثاتِ النوائبا",23,"ب",2,0],["وَقَاكَ اللَّهُ هَلْ أبصَرْتَ صَبًّا","حزِينَ القَلْبِ مَقْرُوحَ الجُفُونِ",24,"ن",1,0],["وقاكَ عَيْنَ الْكَمالِ رَبٌّ","أَبقى لَكَ الوُدَّ في الْقُلوبِ",25,"ب",1,0],["وقاكَ من كلِّ مكروهٍ ومَتْرَحَةٍ","مهيمنٌ فالقُ الإصباحِ قدُّوسُ",26,"س",1,0],["وَقاكِ رَبُّكِ ما يَسوؤُكِ إِنَّهُ","أَعطاكِ تاجَ الحُسنِ يَومَ دَحاها",27,"ا",3,0],["وقاك إله العرش يا أحمدُ الردى","وجُنّبتَ أنواعَ المكاره والضر",28,"ر",1,0],["وَقاكَ اللَهُ شاهينَ الأَعالي","وَقَنَّصَ لِلنَواجِذِ أَربَعينا",29,"ن",2,0],["وَقاكَ اللَهُ طارِئَةَ اللَيالي","وَزادَكَ صِحَّةً في حُسنِ حالِ",30,"ل",1,1],["وقاك اللَه كم تفني قروناً","ولا تفني محياك القرون",31,"ن",1,0],["وقاك اللَه منه داء موتٍ","تهون لديه كل المقتلات",32,"ت",1,0],["وقاكَ المجدُ ما لا تتّقيه","فإنّكَ أولٌ والمجدُ ثانِ",33,"ن",1,0],["وقاكِ اللهُ فاغرةَ الرجالِ","وسلّمَ رضفتيكِ من الكَلالِ",34,"ل",1,1],["وقاكَ الرزايا كلُّ ماضٍ لسانُه","ومَضْرِبُه عند اللقاءِ كَلِيلُ",35,"ل",1,0],["وقاكَ من الأَسواءِ كلُّ منافسٍ","يَرى الغِيَّ أَهدى في الأمُور الى الرشْدِ",36,"د",1,0],["وقاك إله العرش من كل عارض","ولا زلت للراجين يا ذا العلى حصنا",37,"ن",2,0],["وقَّاكما مَلَكُ السَلام كما وَقَى","سارا وطوبيَّاسَ رافائيلُ",38,"ل",1,0],["وَقاك إلهي ما وَفاك كَما أَرى","وَإِنك لَو حَكَّمتَ نَفسك تحكم",39,"م",1,0],["وقاك اللَه من قدٍّ صحيحٍ","وليس لربه ود صحيح",40,"ح",1,0],["وقاك الله من كيد الأعادي","وظلت محصّنا أبدا معانا",41,"ن",2,0],["وقاكم من أزمة الدراهس","وما وقيته من النواهس",42,"س",1,0],["وقاك بنو الدنيا جميعاً صروفها","جميعاً فإن الجفن من خدم النصل",43,"ل",1,0],["وقاك إله العرش من كل نكبة","أبن لي عمن تشتهيه المسامع",44,"ع",1,0],["وقاك اللَه للالام حصنا","يقيه من مقاويه حصينا",45,"ن",2,0],["وَقاكَ الَّذي سَمّاكَ مُتَّقِياً لَهُ","فَأَنْتَ مِنَ الدَّهْرِ الغَشُومِ تُدِيلُ",46,"ل",1,0],["وقاك الله منه يا حبيبي","وألهمك الصواب الله ربي",47,"ب",2,0],["وقاك العمى مزج العماء فعذبه","فرب عشى أفضى إليه عشاء",48,"ا",2,0],["وَقَاكِ اللهُ يَا قَمَرَ البَيَانِ","فَلَا تَبْلَي عَلَى صَرْمِ الزَّمَانِ",49,"ن",1,1],["وقاكِ ربي من الأشرارِ في زمنٍ","باتَ الأميرُ به الرومانُ والتترُ",50,"ر",1,0],["وقاكِ ربّي كما الزهراءُ من فتنٍ","وكلُّ ذنبٍ سوى الإشراكِ يُغتفرُ",50,"ر",1,0],["وقاكِ ربّي ..لطولِ العهدِ.. من فتنٍ","وكلُّ ذنبٍ سوى الإشراكِ يُغتفرُ",51,"ر",1,0],["وقاكِ اللهُ منْ طيفٍ بعيدٍ","على عينيَّ بالسلوى يشيرُ",52,"ر",1,0],["وقاكَ مِن شرِّ ما تصبو النفوسُ له","فلستَ تصبو إلى شيءٍ يرَدِّيها",53,"ي",3,0],["وقاك الله كل أذى وشرٍّ","وجنبك الذي فيه ابتُليت!",54,"ت",1,0],["وقاكم إلهي من الانخذال","أو الارتداد وسوّى خُطاكمْ",55,"م",1,0],["وَقَاكُمَا اللَّهُ عُتْبي إنَّ أيْسَرَهُ","لا تَستقِرُّ عَليهِ الرُّوحُ في البَدَنِ",56,"ن",1,0],["وَقاكَ رّبُّكَ مِن أَسواءِ مَهزَلَةٍ","هِيَ الجُنونُ الَّذي يَدعو إلى العَجَبِ",57,"ب",1,0]]}