x?id=153974",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"أكتب ككتبي كما قد كنت أكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=128829",""],[5411,"وَزُلْفى يا حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=185346",""],[5544,"قصيدة النصر","https://www.poetsgate.com/ViewPoem.aspx?id=213575",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5762,"هو الإثمُ زلزل زلزالها","https://www.poetsgate.com/ViewPoem.aspx?id=177978",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6023,"وزلزلةٍ كادت تهدُّ بعزمها","https://www.poetsgate.com/ViewPoem.aspx?id=123876",""],[6093,"إنَّ السَّلامَ على المُختارِ قدْ وَجَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=211222",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6202,"يا مصر لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86769&r=&rc=70",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""]],"verses":[["وَزَلَّ اِبنُ كُلثومٍ عَنِ العَبدِ بَعدَم","تَبَرّا لَهُ مِن خالِدٍ وَبَني كَعبِ",0,"ب",1,0],["وَزُلنَ كَالتينِ وارى القُطنُ أَسفَلَهُ","وَاِعتَمَّ مِن بَرَدَيّا بَينَ أَفلاجِ",1,"ج",1,0],["وَزُلتِ وَلَم تَرى يَوماً كَريهاً","يُسَرُّ الروحُ فيهِ بِالزَوالِ",2,"ل",1,0],["وزلَّةُ رأيٍ لم تؤيّدْهُ حُنكةٌ","ونقصانُ حزمٍ لم يُعِنْهُ تَمامُ",3,"م",1,0],["وَزِلتَ مِنَ اللَهِ في لَعنَةٍ","تُقيمُ عَلَيكَ وَلا تَنزَعِج",4,"ج",1,0],["وَزُلفَةٌ لَكَ عِندَ اللَهِ تُظهِرُها","لَنا بِبُرهانِ ما تَأتي وَتُبديها",5,"ي",3,0],["وزلزلت البسيطةُ وأستنامت","على الأضغانِ أيقاظٌ رقود",6,"د",1,0],["وزُلزِلَ قومٌ آخرون فأدبروا","سِراعاً يَجرُّونَ الظُّبَى والعواليا",7,"ي",2,0],["وَزِلتُ مُسَيِّراً رَهدي رَعيلاً","أَأُمُّ سَوادَ طَودٍ ذي نِقابِ",8,"ب",1,0],["وَزَلّاتُ رُسلِ الهَوى لا تُقا","لُ وَكَم مِن مُحِبٍّ نَفاهُ الرَسولُ",9,"ل",1,0],["وزُلزِلَ الكفرُ من قَواعدهِ","وجُبَّ رأسُ النِّفاقِ من كَتَدِهْ",10,"د",2,0],["وزلت ولم تري يوماً كريهاً","تسرّ الرّوح فيه بالزّوال",11,"ل",1,0],["وَزَلَّ اِبنُ كُلثومٍ عَنِ العَبدِ بَعدَما","تَبَرّا لَهُ مِن خالِدٍ وَبَني كَعبِ",12,"ب",1,0],["وزُلنا بالغليل وما اشتفينا","وغاية كل شيء أن يزولا",13,"ل",2,0],["وزلّة الكبير أكبر الزّلل","وإن أحيطت بالطّلاء والعلل",14,"ل",1,0],["وزَلَّتْ بشُطْآنِ المَجَرَّةِ رِجْلُهُ","فَطَوَّحَه في غَمْرَةِ اليَمِّ زَاخِرُه",15,"ر",2,0],["وزلزلت الأرض زلزالها","وخذ على الأرض أقهابها",16,"ب",3,0],["وزلزلت الأرض زلزالها","وضاقت بأجزائها هامده",17,"د",2,0],["وزلزل منه البرّ والبحر كافر","بنعماك مرهوب الحتوف غشوم",18,"م",1,0],["وزلزلت البرية بانقاسم","له هرع القلوب لها رغاء",19,"ا",2,0],["وزَلزلَ رُكني فانهدمْتُ لهدِّهِ","وقد هدَّمَ الأركانَ هدُّ الزَّلازِلِ",20,"ل",1,0],["وَزُلزِلَت زِلزالَها بَعدَهُ","حَتّى اِغتَدى مَعروفُها مُنكرا",21,"ر",2,0],["وَزَلزَلَ الصَحبُ أَرضَ الكُفرِ فَاِنفَجَرَت","بُركانُها وَغَدا بِالنارِ صَهرَتُهُ",22,"ت",2,0],["وزلّ عن صهوةِ طَرْفِ الدُجى","سقطةً جُلِّ الفرَسِ الأدْهَمِ",23,"م",1,0],["وزليقٍ منتَهى شاهقةٍ","حيثُ لا يصعَد إلا مَن تردَّى",24,"د",2,0],["وزُلالاً أوْرَدتَ حال أُجاجاً","وشفاءً أورثتَ آل سَقاما",25,"م",2,0],["وزلّتْ عن تُقىً قدمي كأنّي","هنالك لم أكنْ رجلاً عفيفا",26,"ف",2,0],["وزلت فما ودق النوال بهاطل","وغبت فما برق المنى باسم الثغر",27,"ر",1,0],["وزلال المآءِ في تلك العيون","يُعيدُ الكهلَ أَصبَى من غُلاَم",28,"م",1,0],["وزلزال سان فرنسيسكو","دليل على فضله المذخر",29,"ر",1,0],["وَزُلالُه يَروي الظّما","بِالشّربِ مِنهُ بالغِوا",30,"غ",3,0],["وزلزلوا حتى يقول الآية","بالرفع أو بالنصب في الرواية",31,"ه",1,0],["وزلزت الأرض زلزالها","وضاقت بأجزائها هامده",32,"د",2,0],["وزلزل بهم أركانهم وعروشهم","بأية أرض يا قدير وبقعة",33,"ه",1,0],["وزلزل بهم أرجاءها واجلب القضا","لادراك ثار الله واستنهض النصرا",34,"ر",2,0],["وزلزلنا ديارهم فمرت","تبادرنا بأسفل سافلينا",35,"ن",2,0],["وزل فقلنا لعاً ناعشاً","لعالٍ إذا ما تعلى تدلى",36,"ل",2,0],["وزل حجابَ ختمِ","واجعلهُ فيكَ مسمى",37,"م",2,0],["وزلزلت الارضون وارتجت السما","وكادت له أفلاكها تتعطل",38,"ل",1,0],["وزلتم بلا أمر ولا عين مبصر","عن العين بي دونَ الأنام وما زلنا",39,"ن",2,0],["وزلزل أقطار البلاد فأصبحت","شواهقها مهتزّة وهضابها",40,"ب",3,0],["وزلزلت الأرض زلزالها","وأدخل في امه دعهل",41,"ل",1,0],["وزلت قوافي الطم (2) عني كأنها","صواقير تنبو عن حديد وجندل",42,"ل",1,0],["وزليخا لم تنل من يوسف","غير نيران الأسى من أرب",43,"ب",1,0],["وزلزلت البلاد كأن نوحا","وعوجا والسنين لها زرود",44,"د",1,0],["وزلزل إيوان لكسرى ممردٌ","فكسرى نجي الهم حيران مشفق",45,"ق",1,0],["وزلّةٌ من عاقل كثيرهْ","بعكس أحمقٍ فلا شهيرهْ",46,"ه",1,0],["وزلّة العالم مثل الطبلِ","وجاهل تخفى له بالجهلِ",46,"ل",1,0],["وَزَلزَلت الصّعيدَ وراءَ مصرٍ","غَداةَ عَلَتْكَ في قَطَنَا الخيامُ",47,"م",1,0],["وزَلَّتْ لعَيْنِك أَقدامُهَا","وزال لبطشك إِقدامُهَا",48,"م",3,0],["وزلت عقول من مراكز دركها","كما زلت الصفواء بالمتنزل",49,"ل",1,0],["وزلزل بيت اللَه من عظم فادح","وضعضع منه ركنه والجوانب",50,"ب",1,0],["وزلزلنا البشاوه وسط مصر(ن)","الين اعياهموا جمع البِِرارس",51,"س",1,0],["وزلزلتِ مَن ظاهروهُ وقَوماً","تولَّوا بزحفِ العلا والفداءْ",52,"ا",2,0],["وزلة رفيقك ......دور لها معاذير","ان كان كفو ..وطيبته تكتشفها",53,"ف",3,0],["وزلة بني عمك ....ليا جاتك يصير","واجب عليك... تصد ماتعترفها",53,"ف",3,0],["وزلزلة الإحساء منهم مهابة","وفر البوادي واعتلى كل واعل",54,"ل",1,0],["وزلت يا شمس البلاد وبدرها","يساعدك في الإسعاف في النهي والأمر",55,"ر",1,0],["وزل بزي زهى كي تزين به","لدى الزلازل في زهو وفي طرب",56,"ب",1,0],["وَزُلْفى يا حبيب إليكَ زُلْفى","جُنون النَّثْرِ والشِّعْر المُقَفَّى",57,"ف",2,1],["وزلزلت عصبة التخريب وانهدمت","أركانها واحتست كأس الردى جرعا",58,"ع",2,0],["وزله ليامنه رقد كل سالي","وخله يفوح وقنن الهيل بقياس",59,"س",1,0],["وزلّت بأعمالها فغدتْ","ترى في الزلازل أعمالها",60,"ل",3,0],["وزلزل عرش الملك من طرب به","ورجرج كرسي الفخار بليلتي",61,"ت",2,0],["وزلزلةٍ كادت تهدُّ بعزمها","أقاليم لا يبقى لها أبداً أَثر",62,"ر",1,1],["وزُلزِلتَ شُرفاتُ القَصْرِ مُذْعِنَةً","وخَافَ مِنْهُ هِرَقْلُ الرُّوْمِ واضْطَرَبَا",63,"ب",2,0],["وَ زَلَازِلُ الِإلْحَاحِ رَجَّتْ أَضْلُعًا","فِي صَدْرِيَ المُلْتَاعِ لَمَّا زَلْزَلَكْ",64,"ك",1,0],["وزلزل الأرض في عزم وفي ثقة","فزال خوفو وما أبقيت سجانا",65,"ن",2,0],["وزلزِلي هضبات الحب في كبدي","فقد أصيبتْ بحار الروح بالشلل ِ",66,"ل",1,0]]}