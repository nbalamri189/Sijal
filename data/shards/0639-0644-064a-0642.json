,[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[5873,"عيش الفخار","https://www.poetsgate.com/ViewPoem.aspx?id=215435",""],[5956,"تبَسُّمُ عاشقتي","https://www.poetsgate.com/ViewPoem.aspx?id=182048",""],[5956,"أمامَ جمالك","https://www.poetsgate.com/ViewPoem.aspx?id=182649",""],[5956,"الصديق والأمانة","https://www.poetsgate.com/ViewPoem.aspx?id=184479",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[5956,"على قدْر ما هو أسعدَ ناساً","https://www.poetsgate.com/ViewPoem.aspx?id=192977",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[161,"زَهْرَةُ الحيَاةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202595",""],[6070,"بثوبٍ مِنَ الثَّلجِ البَريءِ تلحَّفا","https://www.poetsgate.com/ViewPoem.aspx?id=197532",""],[6093,"لامِسُ النَّجمِ","https://www.poetsgate.com/ViewPoem.aspx?id=202736",""],[6093,"على قدر الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=215941",""],[6124,"جسم القبر","https://www.poetsgate.com/ViewPoem.aspx?id=120170",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""],[5080,"بصبر عصا أبي ذرٍّ صبرت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88140&r=&rc=10",""],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[6292,"إلى إديت سودرجران","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6872&r=&rc=75",""],[6346,"لك الله ياغزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83385&r=&rc=1",""],[5567,"آخر الوصايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81814&r=&rc=64",""]],"verses":[["عَليقُ جِيادِيَ شَمُّ النَسي","مِ وَالظِمءُ سائِقُ أَذوادِيَه",0,"ي",2,0],["عَلى قَطاهُنَّ صَدّارونَ عَن نَهَلٍ","مِنَ القَواضِبِ وَرّا دونَ لِلقُحَمِ",1,"م",1,0],["عَلى قَنَوَينِ أَلا مَن رَأى","ظَعائِنَ بِالطَعنِ وَالضَربِ نَجدا",2,"د",2,0],["عَلَى قَدْرِ مَا يَلْتَاحُ مِنْ ذَلِكَ الْحُسْنِ","أُكَابِدُ مِنْ شَوْقٍ إِلَيْهِ وَمِنْ حُزْنِ",3,"ن",1,1],["عَلَى قَبْرِهِ الزَّاكِي وَقَفْتُ مَطَامِعِي","فَمَنْ نَالَنِي بِالضَّيْمِ أَنْتَ خَصِيمُهُ",4,"م",2,0],["عَلَى قَدَر قَدْ جِئْتَ قَوْمَكَ عِنْدَمَا","تَنَاهَتْ بِهَا الْبُؤسَى وَأَجْهَدَهَا الأَزْمُ",5,"م",1,0],["عَلَى قَدَرٍ جَلَّى بِكَ اللهُ بُؤْسَهَا","وَلاَ يَكْمُلُ البُحْرَانُ أَن يَنْضَجَ الْخَلْطُ",6,"ط",1,0],["عَلى قيلِها يَومَ اِلتَقَينا وَمَن يَكُن","عَلى مَنطِقِ الواشينَ يَصرِم وَيُصرَمِ",7,"م",1,0],["عَلى قَدرِ الأَذى وَالظُلمِ يَعلو","صِياحُ المُشفِقينَ مِنَ المَزيدِ",8,"د",1,0],["عَلى قَطَنٍ بِالشَيمِ أَيمَنُ صَوبِهِ","وَأَيسَرُهُ عَلى السِتارِ فَيَذبُلِ",9,"ل",1,0],["عَلى قَرواءَ قَد ضَمرَت فَفيها","وَلَم تَبلُغ سَليقَتُها ذَبولُ",10,"ل",1,0],["على قاسم شيخ الطريقة قد بكت","جواهر فضل مالها الدهر قاسم",11,"م",1,1],["عَلى قَتلى مَعونَةَ فَاِستَهِلّي","بِدَمعِ العَينِ سَحّاً غَيرَ نَزرِ",12,"ر",1,1],["على قَعودٍ صحيح الظهر تامِكِهِ","ما كَلَّ من طولِ تَرْحالٍ ولا طَلحا",13,"ح",2,0],["على قدر الهوى يأتي العتاب","ومن عاتبت تفديه الصحاب",14,"ب",1,1],["عَلى قَدرِ الهَوى يَأتي العِتابُ","وَمَن عاتَبتُ يَفديهِ الصِحابُ",15,"ب",1,1],["عَلى قُلَلِ الأَجبالِ حَيرى جُموعُهُم","شَواخِصُ ما إِن تَهتَدي أَينَ تَذهَبُ",16,"ب",1,0],["على قَودِ رحل قائمٍ غير قاعدٍ","له بُرْنُسٌ يَعْتَدُّهُ في المناسبِ",17,"ب",1,0],["عَلِيٌّ قاتِلُ البَطَلِ المُفَدّى","وَمُبدِلُهُ مِنَ الزَرَدِ النَجيعا",18,"ع",2,0],["على قَلْبِ قُسْطَنْطينَ مِنْهُ تَعَجّبٌ","وَإنْ كانَ في ساقَيْهِ مِنْهُ كُبُولُ",19,"ل",1,0],["عَلى قَلَقٍ كَأَنَّ الريحَ تَحتي","أُوَجِّهُها جَنوباً أَو شَمالا",20,"ل",2,0],["عَلى قَدرِ أَهلِ العَزمِ تَأتي العَزائِمُ","وَتَأتي عَلى قَدرِ الكِرامِ المَكارِمُ",21,"م",1,1],["عَلى قَصدِ دَهرِ السوءِ إِيّاهُما مَعاً","لِفَهمِهِما إِيّاهُ فِعلُ المُناصِبِ",22,"ب",1,0],["عَلى قُرَيشٍ إِذا اِحتَلَّت وَعَضَّ بِها","دَهرٌ وَأَنيابُ أَيّامٍ لَها أَثَرُ",23,"ر",1,0],["عَلى قَسَمٍ لا أَشتُمُ الدَهرَ مُسلِماً","وَلا خارِجاً مِن فِيَّ سوءَ كَلامِ",24,"م",1,0],["على قُرْبِ عُذّالي وبُعْدِ حبائبي","وأمْوَاهِ أجفاني ونيرانِ أضلُعي",25,"ع",2,0],["على قَدَمِي ضعوا لِلَّيثِ رأساً","أُحاذِرُ أن يُعفّره التراب",26,"ب",1,0],["عَلى قَرماءِ عالِيَةٍ شَواهُ","كَأَنَّ بَياضَ غُرَّتِهِ خِمارُ",27,"ر",1,1],["عُلَيُّ قَد يَشعَبُ ذا","الوَجدِ المُحِبِّ الكَذِبُ",28,"ب",1,0],["عَلَى قَدَرٍ يُمِدُّ الناسَ عِلْماً","كما يُعطِيك أَدْوِيَةً طبيبُ",29,"ب",1,0],["على قوتِ يومٍ لَرَدُّوا الرهانَ","وأرمَوا إلى فضةٍ محضَرَة",30,"ر",2,0],["على قلب قسطنطين منه تعجّبٌ","وإن كان في السّاقين منه كبول",31,"ل",1,0],["على قضب الزبرجد شاهداتٌ","بأن الله ليس له شريك",32,"ك",1,0],["عَلى قَمَرٍ في البلى آفِلٍ","إِذا ما أبلَّت قُروحي نَكا",33,"ك",2,0],["على قدر ما اختلف الواردون","يكونَ اختلافهُمُ في الصَّدَر",34,"ر",1,0],["علي قد استولت كروبي وقد فشت","عيوبي وضاع الرأي من فكرتي مما",35,"م",2,0],["على قدر إحساس الرجال شقاؤهم","وللسعد جوٌّ بالبلادة مشرب",36,"ب",1,0],["على قَمَرٍ لو أطلعتهُ يدُ الثّرى","لقصّر عن لألائه قمرُ السّعدِ",37,"د",1,0],["على قدر ما في الوسعِ لا قدّر حقه","فذلك لا يفنى إلى آخر الدهرِ",38,"ر",1,0],["على قدر نقصي عاملوني بفضلكم","أيا كاملين الوصف لست بكامل",39,"ل",1,0],["على قدر ما يدنيك تنأى عن الاسا","ومقداره ما يقصيك تدنو من اللأوى",40,"و",2,0],["على قدر همَّ المرء يكثر صحبه","وقد ينفع المصحوب إن الصحب",41,"ب",1,0],["على قدرٍ وافي تمام بنائها","وهلك العدى فالحمد لله والشكر",42,"ر",1,0],["على قدر ما يؤتى الفتى يحسد الفتى","وأكثر من يرضى عليه ويغضب",43,"ب",1,0],["عَلى قُضُبِ الزَبَرجَدِ في ذُراها","لِأَعيُنِ مَن يُلاحِظُها مُرادُ",44,"د",1,0],["على قدر ما يخشى الفتى من معرّة","يلُجّ به الجهّال وهو جليل",45,"ل",1,0],["على قوت يوم لردّوا الرهون","وأوموا إلى فضة محضره",46,"ر",2,0],["عَلى قَلبهِ سادَ الهَوى فهو عبدهُ","وَقَد سكَنَ الشيطانُ مِن رأسهِ وَكرا",47,"ر",2,0],["عَلى قدرهِ ليست تعدُّ فتنفدُ","عليهِ سلامُ اللَّه فهو المجدِّدُ",48,"د",1,0],["على قامةٍ مازال يُغبَط ردفُها","ويُحسَدُ ساقاها ويُرحَم خصرُها",49,"ر",3,0],["عَلى قُلُصٍ نَعلو بِها كُلَّ سَبسَبٍ","تَخالُ بِهِ الحِرباءَ أَشمَطَ جالِسا",50,"س",2,0],["على قدر ما نلقى من الوصل والجفا","يقدّر ما نلقى من القرب والبعد",51,"د",1,0],["على قَبرِكَ المَمطورِ منّي تحيَّةٌ","فقد ضمَّ غُصناً ناضِرا وَفتاءَ",52,"ا",2,0],["على قُبٍّ سوابقَ طاوياتٍ","أياطِلَها كما تُطْوَى الْبُرُودُ",53,"د",1,0],["عَلَى قُطْبِهِ الْغَازِيعَلَى بَلَدِيِّهِ","عَلَي سِجِلْمَاسِّيِّ أَصْلٍ وَمُحْتَدِ",54,"د",1,0],["عَلَى قَبْرِهِ قَبْرِ الْمَكَارِمِ وَالْعُلاَ","سَلاَمٌ سَلِيمٌ مِنْ شَوَائِبِ مَنْ غَدَرْ",55,"ر",1,0],["على قلة لكن لها الله كالئ","ومن حولهم أعداؤهم تتألب",56,"ب",1,0],["على قربِ داري منكِ ذبتُ صبابةً","فكيفَ وقلبي يائسٌ أبداً منك",57,"ك",1,0],["على قتبٍ أو هوجلٍ طلَبُ العلى","وإحرازُها من ناقةٍ أو سفينة",58,"ه",1,0],["على قدرِ ذاكَ الحبّ قد كان مَطمعي","فما كنتُ يوماَ راضياً بنواليا",59,"ل",3,0],["على قصدك انطق واجتنب فضل منطق","وحدث بصدق غير مظهر ايقان",60,"ن",1,0],["على قدر فضل المرء بجل مقامه","والافراط في التفضيل اهداء نقصان",60,"ن",1,0],["على قدر جهد المرء قوم يومه","فيوم لساع لا كدهر لكسلان",60,"ن",1,0],["على قدر خبر المرء ينتج عقله","دقائق أفكار من ارشاد أزمان",60,"ن",1,0],["على قربه من ربه واصطفائه","ومنحته إياه أعظم منحة",61,"ه",1,0],["عَلى قُربِ عُذّالي وَبُعدِ أَحِبَّتي","وَأَمواهِ أَجفاني وَنيرانِ أَضلُعي",62,"ي",1,0],["على قائِمٍ بالجودِ غير مُقاومٍ","ومُنفَرِدٍ بالمَجدِ غَيرِ مُشاركِ",63,"ك",1,0],["على قلمي تكاثرت الجروح","فما يَدْري بأيِّ أسىً يَبُوحُ",64,"ح",1,1],["على قلبي من الأعباءِ حِمْلٌ","وفي أعماقِه حُلُمٌ يَنُوحُ",64,"ح",1,0],["على قَدَرٍ قد جاء في ليلة القدر","كتابُ حبيب طيِّبُ النشر والبِشْر",65,"ر",1,1],["على قبرك المكلوء يا نسل أحمد","تعاقبن أخلاف السحاب الحوالك",66,"ك",1,0],["على قبر ابن عبداللَه سارت","غواد باكرت أصلاً عشيا",67,"ي",2,0],["على قلب خير العالمين محمد","رسول بتوحيد المهيمن أرسلا",68,"ل",2,0],["على قمم البيداء منها ومنهمُ","إذا خفَقَ الآلُ المُلاءُ المنشَّرُ",69,"ر",1,0],["عَلى قَطَريٍّ نِعمَةٌ إِن جَزى بِها","يَزيدٌ وَإِلّا يُجزِهِ اللَهُ لي أَجرا",70,"ر",2,1],["على قُمَمِ العُلى بِهِما ارْتِقائي","عَلِيٌّ ذو المَعارِجِ والنَّبِيُّ",71,"ي",1,0],["على قَدَمِ النَّبيِّ لها عُهودٌ","مُبارَكَةُ المَعاني والوَثائِقْ",72,"ق",1,0],["على قدك المياس قدرا فماله","نظير بتكميل البها ومعادل",73,"ل",1,0],["على قصد قطع الاتصال معاند","اذا لامك الاعداء لا تتوهم",74,"م",1,0],["على قدْرِ لهوِكمْ يكونُ هوانكُمْ","وإنّ لكم إنْ أيْقنوا الحالَ موْعِدا",75,"د",2,0],["على قلاص كالقطا النفور","لاصقة البطون بالظهور",76,"ر",1,0],["علَى قَضِيبٍ أميَس","ما اسمُ الجَميلِ الكَيِّسِ",77,"س",1,0],["على قارحٍ مثلِ العَلاةِ وتارةً","تراه كسرْحانِ البسيطةِ عادِيا",78,"ي",2,0],["عَلى قَراهُ فِلَقُ الشُذورِ","حَتُى جَلا عَن لَهَقٍ مَشهورِ",79,"ر",1,0],["على قلبِهِ قد خطَّ من خوفِ ربِّهِ","أساطيرَ ذي النورَينِ في ذلكَ السِّفْرِ",80,"ر",1,0],["على قرانهما الميمون طالعهُ","غيث الصفا والاماني والهناء همى",81,"م",2,0],["عليٌّ قيمُ النارِ من قَولهِ لها","ذَري ذا وهذا فاشربي منه واطعمِ",82,"م",1,0],["على قاتلِ الصيدِ الحرامِ كمثلهِ","من النَّعَمِ المفروضِ كان مُعَقَّبا",83,"ب",2,0],["على قومٍ بَغَوْا فيكمْ علينا","لتُعدي منكمُ يا خيرَ مُعْدِ",84,"د",1,0],["على قبر مَن كانت من الغصن رطبهُ","ومن انجم الأفلاك في منزل البدرِ",85,"ر",1,0],["على قاعهِ لُجّةٌ من رخامِ","يُغرّقُ فيها ولا يتلفُ",86,"ف",1,0],["عَلى قَدماتها تَعلو سَريعاً","وَللأعدا بَنادقُها تَذود",87,"د",1,0],["على قمة المكرمات استقرت","كما قام في العرش ملك مفدى",88,"د",2,0],["على قبور زكية ضمنت","لحودها أعظمها زكيات",89,"ت",1,0],["عَلى قَبرِهِ المَعمورِ مِن غَيثِ رَحمةٍ","سَحابةَ رِضوانٍ تسُحُّ وتمطِرُ",90,"ر",1,0],["عَليُّ قَدْرٍ وَجاهٍ كاِسمِهِ وذُرىً","وَهِمّةٍ بِجَميلِ العَزمِ تَتّصِفُ",91,"ف",1,0],["عَلى قَلبِهِ قَد غِين مِن عَينِ بعده","وَخُطَّ بِحِبرِ الفَمِّ في قَلبِه الغينُ",92,"ن",1,0],["على قبر خير الرسل قف بي لعلني","أعلل قلبا بالجوى والنوى معنى",93,"ن",2,0],["على قدر ما أعطى العيون من الحسن","سناها غدت تعطي النفوس من الحزن",94,"ن",1,0],["علي قال أسألوني كي ابين لكم","علمي وغير علي ذاك لم يقل",95,"ل",1,0],["على قوله القران وليشهد الورى","كلامك يا رب