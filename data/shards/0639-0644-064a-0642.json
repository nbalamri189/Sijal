{"poems":[[53,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[53,"أحق من كانت النعماء سابغة","https://www.aldiwan.net/poem29814.html","البسيط"],[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[77,"على قدر ما يلتاح من ذلك الحسن","https://www.aldiwan.net/poem36020.html","الطويل"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[35,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[88,"على قاسم شيخ الطريقة قد بكت","https://www.aldiwan.net/poem45029.html","الطويل"],[23,"على قتلى معونة فاستهلي","https://www.aldiwan.net/poem21358.html","الوافر"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[85,"على قدر الهوى يأتي العتاب","https://www.aldiwan.net/poem6820.html","الوافر"],[85,"على قدر الهوى يأتي العتاب","https://www.aldiwan.net/poem63681.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[43,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[43,"بقائي شاء ليس هم ارتحالا","https://www.aldiwan.net/poem10117.html","الوافر"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[28,"فأعقب الله ظلا فوقه ورق","https://www.aldiwan.net/poem5054.html","البسيط"],[28,"إذا شئت هاجتني ديار محيلة","https://www.aldiwan.net/poem5524.html","الطويل"],[80,"ولما رأت طير الفراق نواعبا","https://www.aldiwan.net/poem31389.html","الطويل"],[105,"أكان يزيد بأسك إذ تصاب","https://www.aldiwan.net/poem44210.html","الوافر"],[13,"على قرماء عالية شواه","https://www.aldiwan.net/poem2187.html","الوافر"],[40,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"أقول لذي قامة كالقضيب","https://www.aldiwan.net/poem69009.html","المتقارب"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140995",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/205177","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[90,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[113,"كشفت حجاب الطمس عن حيطة الأسما","https://www.aldiwan.net/poem41777.html","الطويل"],[118,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[123,"سلام ولا أقرا سلاماً على هند","https://www.aldiwan.net/poem4095.html","الطويل"],[133,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[145,"سلام يفوق المسك والند عرفه","https://www.aldiwan.net/poem47661.html","الطويل"],[158,"إليك فقد حملت قلبي من الهوي","https://www.aldiwan.net/poem59013.html","الطويل"],[158,"هلموا فقد قامت على ساقها الحرب","https://www.aldiwan.net/poem59019.html","الطويل"],[158,"على الطالع الميمون قد أسس القصر","https://www.aldiwan.net/poem59039.html","الطويل"],[158,"أعد نظرا في قصة ليس تحجب","https://www.aldiwan.net/poem59091.html","الطويل"],[162,"عيون ما يلم بها الرقاد","https://www.aldiwan.net/poem67847.html","الوافر"],[184,"توق فخزان الكلام قليل","https://www.aldiwan.net/poem43502.html","الطويل"],[184,"أيعجبني أنني شاعر","https://www.aldiwan.net/poem43732.html","المتقارب"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[187,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[202,"أقرت نجوم الحسن أنك بدرها","https://www.aldiwan.net/poem53254.html","الطويل"],[205,"لأسماء رسم أصبح اليوم دارسا","https://www.aldiwan.net/poem27943.html","الطويل"],[209,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[223,"ألا يا تجار العصر هل فيكم امرؤ","https://www.aldiwan.net/poem55093.html","الكامل"],[227,"ليهن الملك مالكه الجديد","https://www.aldiwan.net/poem51155.html","الوافر"],[235,"أخذنا طريق القوم حمدا لسيد","https://www.aldiwan.net/poem18181.html","الطويل"],[235,"ذوى خضر الأفراح منذ ذوى الخضر","https://www.aldiwan.net/poem18825.html","الطويل"],[237,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[268,"هربت إلى حجر اليقين من الشك","https://www.aldiwan.net/poem35234.html","الطويل"],[268,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[268,"ليالي قلت إن عددت اللياليا","https://www.aldiwan.net/poem35618.html","الطويل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[311,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[364,"فيا رب إن البين أنحت صروفه","https://www.aldiwan.net/poem17884.html","الطويل"],[369,"وطوفتها بين الأنام مخيرا","https://www.aldiwan.net/poem57244.html","الطويل"],[397,"دموع القلم","https://www.aldiwan.net/poem6795.html","عموديه"],[400,"على قدر قد جاء في ليلة القدر","https://www.aldiwan.net/poem33904.html","الطويل"],[438,"عزاء وصبرا كل شيء فهالك","https://www.aldiwan.net/poem14469.html","الطويل"],[438,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[447,"هو الدين","https://www.aldiwan.net/poem977.html",""],[456,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[464,"على قطري نعمة إن جزى بها","https://www.aldiwan.net/poem50428.html","الطويل"],[498,"إذا ما صغت في المحبوب نظما","https://www.aldiwan.net/poem37728.html","الوافر"],[498,"تجرد من مكابرة وجحد","https://www.aldiwan.net/poem37949.html","الوافر"],[502,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[502,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"],[503,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[513,"إن كنت أزمعت على المسير","https://www.aldiwan.net/poem12128.html","الرجز"],[536,"بدا بوجه أملس","https://www.aldiwan.net/poem47527.html","عموديه"],[549,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[560,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"]],"verses":[["عَليقُ جِيادِيَ شَمُّ النَسي","مِ وَالظِمءُ سائِقُ أَذوادِيَه",0,"ي",2,0],["عَلى قَطاهُنَّ صَدّارونَ عَن نَهَلٍ","مِنَ القَواضِبِ وَرّا دونَ لِلقُحَمِ",1,"م",1,0],["عَلى قَنَوَينِ أَلا مَن رَأى","ظَعائِنَ بِالطَعنِ وَالضَربِ نَجدا",2,"د",2,0],["عَلَى قَدْرِ مَا يَلْتَاحُ مِنْ ذَلِكَ الْحُسْنِ","أُكَابِدُ مِنْ شَوْقٍ إِلَيْهِ وَمِنْ حُزْنِ",3,"ن",1,1],["عَلَى قَبْرِهِ الزَّاكِي وَقَفْتُ مَطَامِعِي","فَمَنْ نَالَنِي بِالضَّيْمِ أَنْتَ خَصِيمُهُ",4,"م",2,0],["عَلَى قَدَر قَدْ جِئْتَ قَوْمَكَ عِنْدَمَا","تَنَاهَتْ بِهَا الْبُؤسَى وَأَجْهَدَهَا الأَزْمُ",5,"م",1,0],["عَلَى قَدَرٍ جَلَّى بِكَ اللهُ بُؤْسَهَا","وَلاَ يَكْمُلُ البُحْرَانُ أَن يَنْضَجَ الْخَلْطُ",6,"ط",1,0],["عَلى قيلِها يَومَ اِلتَقَينا وَمَن يَكُن","عَلى مَنطِقِ الواشينَ يَصرِم وَيُصرَمِ",7,"م",1,0],["عَلى قَدرِ الأَذى وَالظُلمِ يَعلو","صِياحُ المُشفِقينَ مِنَ المَزيدِ",8,"د",1,0],["عَلى قَطَنٍ بِالشَيمِ أَيمَنُ صَوبِهِ","وَأَيسَرُهُ عَلى السِتارِ فَيَذبُلِ",9,"ل",1,0],["عَلى قَرواءَ قَد ضَمرَت فَفيها","وَلَم تَبلُغ سَليقَتُها ذَبولُ",10,"ل",1,0],["على قاسم شيخ الطريقة قد بكت","جواهر فضل مالها الدهر قاسم",11,"م",1,1],["عَلى قَتلى مَعونَةَ فَاِستَهِلّي","بِدَمعِ العَينِ سَحّاً غَيرَ نَزرِ",12,"ر",1,1],["على قَعودٍ صحيح الظهر تامِكِهِ","ما كَلَّ من طولِ تَرْحالٍ ولا طَلحا",13,"ح",2,0],["على قدر الهوى يأتي العتاب","ومن عاتبت تفديه الصحاب",14,"ب",1,1],["عَلى قَدرِ الهَوى يَأتي العِتابُ","وَمَن عاتَبتُ يَفديهِ الصِحابُ",15,"ب",1,1],["عَلى قُلَلِ الأَجبالِ حَيرى جُموعُهُم","شَواخِصُ ما إِن تَهتَدي أَينَ تَذهَبُ",16,"ب",1,0],["على قَودِ رحل قائمٍ غير قاعدٍ","له بُرْنُسٌ يَعْتَدُّهُ في المناسبِ",17,"ب",1,0],["عَلِيٌّ قاتِلُ البَطَلِ المُفَدّى","وَمُبدِلُهُ مِنَ الزَرَدِ النَجيعا",18,"ع",2,0],["على قَلْبِ قُسْطَنْطينَ مِنْهُ تَعَجّبٌ","وَإنْ كانَ في ساقَيْهِ مِنْهُ كُبُولُ",19,"ل",1,0],["عَلى قَلَقٍ كَأَنَّ الريحَ تَحتي","أُوَجِّهُها جَنوباً أَو شَمالا",20,"ل",2,0],["عَلى قَدرِ أَهلِ العَزمِ تَأتي العَزائِمُ","وَتَأتي عَلى قَدرِ الكِرامِ المَكارِمُ",21,"م",1,1],["عَلى قَصدِ دَهرِ السوءِ إِيّاهُما مَعاً","لِفَهمِهِما إِيّاهُ فِعلُ المُناصِبِ",22,"ب",1,0],["عَلى قُرَيشٍ إِذا اِحتَلَّت وَعَضَّ بِها","دَهرٌ وَأَنيابُ أَيّامٍ لَها أَثَرُ",23,"ر",1,0],["عَلى قَسَمٍ لا أَشتُمُ الدَهرَ مُسلِماً","وَلا خارِجاً مِن فِيَّ سوءَ كَلامِ",24,"م",1,0],["على قُرْبِ عُذّالي وبُعْدِ حبائبي","وأمْوَاهِ أجفاني ونيرانِ أضلُعي",25,"ي",1,0],["على قَدَمِي ضعوا لِلَّيثِ رأساً","أُحاذِرُ أن يُعفّره التراب",26,"ب",1,0],["عَلى قَرماءِ عالِيَةٍ شَواهُ","كَأَنَّ بَياضَ غُرَّتِهِ خِمارُ",27,"ر",1,1],["عُلَيُّ قَد يَشعَبُ ذا","الوَجدِ المُحِبِّ الكَذِبُ",28,"ب",1,0],["عَلَى قَدَرٍ يُمِدُّ الناسَ عِلْماً","كما يُعطِيك أَدْوِيَةً طبيبُ",29,"ب",1,0],["على قوتِ يومٍ لَرَدُّوا الرهانَ","وأرمَوا إلى فضةٍ محضَرَة",30,"ر",2,0],["على قلب قسطنطين منه تعجّبٌ","وإن كان في السّاقين منه كبول",31,"ل",1,0],["على قضب الزبرجد شاهداتٌ","بأن الله ليس له شريك",32,"ك",1,0],["عَلى قَمَرٍ في البلى آفِلٍ","إِذا ما أبلَّت قُروحي نَكا",33,"ك",2,0],["على قدر ما اختلف الواردون","يكونَ اختلافهُمُ في الصَّدَر",34,"ر",1,0],["علي قد استولت كروبي وقد فشت","عيوبي وضاع الرأي من فكرتي مما",35,"م",2,0],["على قدر إحساس الرجال شقاؤهم","وللسعد جوٌّ بالبلادة مشرب",36,"ب",1,0],["على قَمَرٍ لو أطلعتهُ يدُ الثّرى","لقصّر عن لألائه قمرُ السّعدِ",37,"د",1,0],["على قدر ما في الوسعِ لا قدّر حقه","فذلك لا يفنى إلى آخر الدهرِ",38,"ر",1,0],["على قدر نقصي عاملوني بفضلكم","أيا كاملين الوصف لست بكامل",39,"ل",1,0],["على قدر ما يدنيك تنأى عن الاسا","ومقداره ما يقصيك تدنو من اللأوى",40,"و",2,0],["على قدر همَّ المرء يكثر صحبه","وقد ينفع المصحوب إن الصحب",41,"ب",1,0],["على قدرٍ وافي تمام بنائها","وهلك العدى فالحمد لله والشكر",42,"ر",1,0],["على قدر ما يؤتى الفتى يحسد الفتى","وأكثر من يرضى عليه ويغضب",43,"ب",1,0],["عَلى قُضُبِ الزَبَرجَدِ في ذُراها","لِأَعيُنِ مَن يُلاحِظُها مُرادُ",44,"د",1,0],["على قدر ما يخشى الفتى من معرّة","يلُجّ به الجهّال وهو جليل",45,"ل",1,0],["على قوت يوم لردّوا الرهون","وأوموا إلى فضة محضره",46,"ر",2,0],["عَلى قَلبهِ سادَ الهَوى فهو عبدهُ","وَقَد سكَنَ الشيطانُ مِن رأسهِ وَكرا",47,"ر",2,0],["عَلى قدرهِ ليست تعدُّ فتنفدُ","عليهِ سلامُ اللَّه فهو المجدِّدُ",48,"د",1,0],["على قامةٍ مازال يُغبَط ردفُها","ويُحسَدُ ساقاها ويُرحَم خصرُها",49,"ر",3,0],["عَلى قُلُصٍ نَعلو بِها كُلَّ سَبسَبٍ","تَخالُ بِهِ الحِرباءَ أَشمَطَ جالِسا",50,"س",2,0],["على قدر ما نلقى من الوصل والجفا","يقدّر ما نلقى من القرب والبعد",51,"د",1,0],["على قَبرِكَ المَمطورِ منّي تحيَّةٌ","فقد ضمَّ غُصناً ناضِرا وَفتاءَ",52,"ا",2,0],["على قُبٍّ سوابقَ طاوياتٍ","أياطِلَها كما تُطْوَى الْبُرُودُ",53,"د",1,0],["عَلَى قُطْبِهِ الْغَازِيعَلَى بَلَدِيِّهِ","عَلَي سِجِلْمَاسِّيِّ أَصْلٍ وَمُحْتَدِ",54,"د",1,0],["عَلَى قَبْرِهِ قَبْرِ الْمَكَارِمِ وَالْعُلاَ","سَلاَمٌ سَلِيمٌ مِنْ شَوَائِبِ مَنْ غَدَرْ",55,"ر",1,0],["على قلة لكن لها الله كالئ","ومن حولهم أعداؤهم تتألب",56,"ب",1,0],["على قربِ داري منكِ ذبتُ صبابةً","فكيفَ وقلبي يائسٌ أبداً منك",57,"ك",1,0],["على قتبٍ أو هوجلٍ طلَبُ العلى","وإحرازُها من ناقةٍ أو سفينة",58,"ه",1,0],["على قدرِ ذاكَ الحبّ قد كان مَطمعي","فما كنتُ يوماَ راضياً بنواليا",59,"ل",3,0],["على قصدك انطق واجتنب فضل منطق","وحدث بصدق غير مظهر ايقان",60,"ن",1,0],["على قدر فضل المرء بجل مقامه","والافراط في التفضيل اهداء نقصان",60,"ن",1,0],["على قدر جهد المرء قوم يومه","فيوم لساع لا كدهر لكسلان",60,"ن",1,0],["على قدر خبر المرء ينتج عقله","دقائق أفكار من ارشاد أزمان",60,"ن",1,0],["على قربه من ربه واصطفائه","ومنحته إياه أعظم منحة",61,"ه",1,0],["عَلى قُربِ عُذّالي وَبُعدِ أَحِبَّتي",