{"poems":[[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[45,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10578.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[102,"أصيل القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50335",""],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[234,"كيف لا تعدم الجسوم القلوبا","https://www.aldiwan.net/poem51239.html","الخفيف"],[280,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[285,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[505,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48762","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95566","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102055","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137945",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109748","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126225","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112654","الرجز"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127812","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109995","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92002","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95347","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94338","الوافر"],[5273,"أبي في الرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=180477",""]],"verses":[["وَأُمَّ عِيالٍ قَد شَهِدتُ تَقوتُهُم","إِذا أَطعَمَتهُم أَوتَحَت وَأَقَلَّتِ",0,"ت",1,0],["وَأَمُّ عَتيقٍ خالُهُ دونَ عَمِّهِ","رَأى خَلقَها مَن أَعجَبَتهُ فَعانَها",1,"ن",3,0],["وأمعنَ في تفكيرهِ القمرُ الزاهي","فمرَّ بأرضٍ ذاتِ عشْبٍ وأمواهِ",2,"ه",1,0],["(وأم علي) تربّي الدّجاج","تكدح خلف ارتعاش الكبر",3,"ر",1,0],["وأمعنتُ بحثاً عن أكفٍُّ كثيرةٍ","فألفيتُ أعلاهُنَّ كَفَّ المُبايع",4,"ع",1,0],["وامُعِزّاه وَامُعِزَّاه حتى","يغتدي الدمعُ بالدماء خضيبا",5,"ب",2,0],["وأَمْعَنَ عَنْ فَاسٍ فِرَاراً وَدَعَّهُ","بخَيْلِكَ فَاسٌ يَحْذَرُ الفَرْسَ والفَرْصا",6,"ص",2,0],["وَأَمْعَنَ ذِكْرُكَ فِي الْخافِقَيْ","نِ شَرْقاً وَغَرْباَ وَغَوْراً وَنَجْدا",7,"د",2,0],["وَأُمِّ عَواتِقَ ما إِنْ عَرَفْ","نَ حَرّاً وَلا ذُقْنَ فِي اللَّيْلِ بَرْدا",7,"د",2,0],["وأُمُّ عُبَيْدَةٍ تُفدى برُوحي","وجُسْماني ومُنْعَقَدِ الجَنَانِ",8,"ن",1,0],["وأمعنوا بين يديه في الهرب","لفئة لهم فجد في الطلب",9,"ب",1,0],["وأمعنتُ في غيب المقادير علَّني","أرى فرجاً للأمّتين قريبا",10,"ب",2,0],["وأمعن طبع الدهر فى غُلَوَائِه","فلم يَعُدِ النائى وأنَّى له عَودُ",11,"د",1,0],["وأمعنت أنظاري بدنيا مهينة","فيا رب أرجوك الخلاص واقبال",12,"ل",1,0],["وأمعنَ في فتحهِ منُقذاً","فلسطين من ظالميها التتر",13,"ر",1,0],["وأمعنوا نظراً في كل حادثةٍ","ولا تجوروا فان اللَه موجودُ",14,"د",1,0],["وامِعاتٌ هاطِلاَتٌ من صُدود","أدمعى مذ شاهدت عَينى سلو",15,"و",1,0],["وأُمّ عثمانَ الذي سمّاهُ","باسمِ ابنِ مظعونَ الأبُ الأواهُ",16,"ه",1,0],["وأَمعنوا الطرف في المظلوم كوكبنا","كيف اختفى نورهُ عن منظر المُقَلِ",17,"ل",1,0],["وأَمعنَ الفِكرَ في مَعنى عواقبهِ","وأَوسعَ الناسَ فعلَ الخيرِ ما وَسِعا",18,"ع",2,0],["وامعِن بها نظراً فليسَ يُرَى بها","الا بلىً يَرعى ودُودٌ آكلُ",19,"ل",1,0],["وَأَمعنتُ فيها ناظريّ فلم أَجد","حساناً بها لكنها تتحسَّنُ",20,"ن",1,0],["وأمّ عمرو كفها خضيب","واللحية الدهين قد تشيب",21,"ب",1,0],["وأَمعَن عَن وفاءِ العهد قَلباً","بخبثٍ نارهُ زادَت سعيرا",22,"ر",2,0],["وأمْعَنْتُ في ذِكراكَ والعُمْرُ وَاقِفٌ","فَحُبُّكَ سِنٌّ ما فَتِئتُ أراهِقُهْ",23,"ق",2,0]]}