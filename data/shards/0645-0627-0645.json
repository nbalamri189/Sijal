َفِّكَ إِن جادَت وَإِن بَخِلَت","مِن ماءِ وَجهي إِذا أَفنَيتُهُ عِوَضُ",104,"ض",1,0],["ما مِنكُمُ إِلّا مُرَدّىً بِالحِجا","أَو مُبشَرٌ بِالأَحوَذِيَّةِ مُؤدَمُ",105,"م",1,0],["ما مِنكُمُ أَحَدٌ إِلّا وَقَد فُطِمَت","عَنهُ الأَعادي بِسيما المَجدِ مُذ فُطِما",106,"م",2,0],["ما مَرَّ يَومٌ واحِدٌ إِلّا وَفي","أَحشائِهِ لِمَحِلَّتَيكِ غَمامُ",107,"م",1,0],["ما مُقرَبٌ يَختالُ في أَشطانِهِ","مَلآنُ مِن صَلَفٍ بِهِ وَتَلَهوُقِ",108,"ق",1,0],["ما مِن جَميلٍ مِنَ الدُنيا وَلا حَسَنٍ","إِلّا وَأَكثَرُهُ في ذَلِكَ الخُلُقِ",109,"ق",1,0],["ما مَهاةُ الحِجالِ مَسلوبَةً أَظ","رَفَ حُسناً مِن ماجِدٍ مَسلوبِ",110,"ب",1,0],["ما مَرَّ يَومٌ لَهُ إِلّا وَقَلَّدَهُ","صَنائِعاً لَم تَزَل فِي الدَّهرِ كَالعَلَمِ",111,"م",1,0],["ما ماتَ مَنْ هذي صفاتُهْ","فوفاةُ ذا عندي حياتُهْ",112,"ه",1,1],["ما مثلُ قولي لشخصٍ","حاجيتُهُ سطلُ قارِ",113,"ر",1,0],["ما مَنْ حاجٍ في الأسما","اطرحْ حرفاً بعد التا",114,"ت",2,1],["ما مثلُهُ في الحسنِ والذكاءِ","عندَ جميعِ العربِ العرباءِ",115,"ا",2,0],["ما مَنْ تَولَّى الحقَّ يَنصرُهُ","ويَصُونُ بَيْضَتَهُ كمن خَذَلا",116,"ل",2,0],["ما مَنعتُمْ مِصرَ من أنفسكم","حَقَّها الأَوفى ولا كنتم شِحاحا",117,"ح",2,0],["ما مرَّ للحكم طيفٌ في وساوِسهم","إلا وَعاودَهم شَوقٌ وتَحنانُ",118,"ن",1,0],["ما مال يوماً عن شريعةِ مُصطفى","ما خان عهدكِ ما أعان عِداكِ",119,"ك",1,0],["ما مَيِّتُ الأحياءِ غيرُ مُنافقٍ","بَالي الضّميرِ مُكفَّنٍ بِردائهِ",120,"ا",3,0],["ما مِثلُ ما قَدَّمَتْ للهِ منك يدٌ","ما قَدَّمَ النّاسُ من هَدْيٍ وقُربانِ",121,"ن",1,0],["ما مِثلهُ إن رُمْتِ في الدّنيا أباً","يا بنتَ عُتبةَ مِن أبٍ يَرعاكِ",122,"ك",1,0],["ما مَن يخوضُ الوغَى تَطغَى زَواخِرُها","كَمَنْ يُجانِبُها خَوْفاً من البَلَلِ",123,"ل",1,0],["ما مِثلهُ يرتابُ في دينِ الهُدى","فَيرى الضّياءَ المستفيضَ ظلاما",124,"م",2,0],["ما مِثلُ رُؤياكِ التي كانت أذىً","رُؤيا تُفسَّرُ للنِّيامِ وَتُعْبَرُ",125,"ر",1,0],["ما مِنهمُ إلا على يَدِهِ يَدٌ","للَّهِ ينظرُ نورها المتوسّم",126,"م",1,0],["ما مِثلُ رِفْدِكَ في المواطنِ كلِّها","رِفدٌ يُضاعَفُ أو عطَاءٌ يُجزَلُ",127,"ل",1,0],["ما مَصير الشَهيد يا رَبّ إ