امل"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[106,"تقليد","https://www.poetsgate.com/ViewPoem.aspx?id=179377",""],[106,"في البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=179307",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[77,"قلتُ إذ وجَّه لي حببا","https://www.poetsgate.com/ViewPoem.aspx?id=33270",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[45,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[45,"حُيّيتماَ مِنْ مَرَبَّعٍ وَمَصِيفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32837",""],[51,"مستبعدٌ هيهات إعتاقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29920",""],[51,"الحمد لله لا شريك لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29174",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[105,"مصر أنت الحياة والموت طراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54935&r=&rc=105",""]],"verses":[["ما مَقامي عَلى الهَوانِ وَعِندي","مِقوَلٌ صارِمٌ وَأَنفٌ حَمِيُّ",0,"ي",1,1],["ما مَرَّ بَرقٌ في فُروجِ غَمامَةٍ","إِلّا وَأَعدى القَلبَ بِالخَفَقانِ",1,"ن",1,0],["ما ماتَ مَن كَثُرَ الثَناءُ وَراءَهُ","إِنَّ المُذَمَّمَ مَيِّتُ الحَيوانِ",1,"ن",1,0],["ما مُقامي غَيرُ مُمضي نِيَّةٍ","دائِباً أَهدُرُ كَالفَحلِ السَدِم",2,"م",1,0],["مَأمَنَةً مِنَ الرَدى","وَنَجوَةً مِنَ العَدَم",3,"م",1,0],["ما مِثلُ قَبرِكَ يُستَسقى الغَمامُ لَهُ","وَكَيفَ يَسقي القُطارُ النازِلَ الفَلَكا",4,"ك",2,0],["ما مِنكُمُ إِلّا اِبنُ أُمٍّ لِلنَدى","أَو مُصبِحٌ بِدَمِ الأَعادي مُغبِقُ",5,"ق",1,0],["ما مُقامي عَلى الجَداوِلِ أَرجو","ها لِنَيلٍ وَقَد رَأَيتُ البِحارا",6,"ر",2,0],["ما مَطعَمُ الدُنيا بِحُلوٍ بَعدَهُ","أَبَداً وَلا ماءُ الحَيا بِبُرادِ",7,"د",1,0],["ما ماتَ مَن جَعَلَ الزَمانَ لِسانُهُ","يَتلو مَناقِبَ عُوَّداً وَبَوادي",7,"د",2,0],["ما مَروَتي لِلناحِتِ المُنتَحي","يَوماً وَلا غُصنِيَ لِلعاضِدِ",8,"د",1,0],["ما مَرَّ يَسحَبُ مِنهُ إِلّا رَدَّهُ","رَيّانَ يَقطُرُ مِن دِماءِ الصَيدِ",9,"د",1,0],["ما مَذهَبي إِلّا التَقَحُّمُ بِالقَنا","بَينَ الضُلوعِ وَلِلرِجالِ مَذاهِبُ",10,"ب",1,0],["ما ماتَ مَن نَزَعَ البَقاءَ وَذِكرُهُ","بِالصالِحاتِ يُعَدُّ في الأَحياءِ",11,"ا",2,0],["ما ماتَ حَتَّى أَقَرَّ النَّاسُ قاطِبَةً","بِفَضلِهِ وَهوَ أَعلى خِندِفٍ نَسَبا",12,"ب",2,0],["ما مَلِلناكَ إذ مَلِلتَ وَلَكِن","أَنتَ يا حِبُّ صاحِبُ اِستِطرافِ",13,"ف",1,0],["ما مَسَّني ضُرٌّ وَلَكِنَّني","جَفَوتُ نَفسي إِذ جَفاني الحَبيب",14,"ب",1,0],["ما مِثْلُ قوْلي لكَ انْظُرْ كِسْوَةً حسُنَتْ","أو مثْلُ قولي لكَ اذْكُرْ راويَ السِّيَرِ",15,"ر",1,0],["ما مُشبِلٌ وَردُ الجَبي","نِ مُهَرَّتُ الشَدقَينِ باسِل",16,"ل",1,0],["ما مَرَّ مِن عُمُرِ الإِنسانِ في حَزَنٍ","أَو في سُرورٍ كَطَيفٍ في الكَرى طَرَقا",17,"ق",2,0],["ما مَنصِبٌ إِلّا وَقَدرُكَ فَوقَهُ","فَبِمَجدِكَ السامي يُهَنَّأُ ما تَلي",18,"ل",2,0],["ما مَدحُهُ بِالمُستَعارِ لَهُ وَلا","آياتُ سُؤدُدِهِ حَديثٌ يُفتَرى",19,"ر",2,0],["مَا مَاتَ بَلْ نَام أَلَمْ تَنْظُرُوا","إِلي احْمِرَارِ الوَرْدِ فِي خَدِّهِ",20,"د",2,0],["مَا مَاتَ بَلْ نَام أَلَمْ تُبْصِرُوا","لَيَانَةَ المَعطِفِ فِي قَدِّهِ",20,"د",2,0],["مَا مِثْلُهُ فِي طُرُوسِ الفَخْرِ مِنْ قِدَمٍ","طِرْسٌ مِنَ الفَخْرِ أَوْعَى كُلَّ عُنْوَانِ",21,"ن",1,0],["مَا مَنْصِبٌ فَوْقَ المَنَاصِبِ أَوْ غِنًى","فَوْقَ المَطَالِبِ غَايَةَ الفَنَّانِ",22,"ن",1,0],["مَأْمُولَةً فِي كَشْفِ كُلِّ مُلِمَّةٍ","أَلْقَتْ عَلَى صَدْرِ الحِمَى بِجِرَانِ",23,"ن",1,0],["مَا مِنْ أَمَانٍ فِي الحَيَاةِ وَأَيْنَ مَنْ","يَقْضِي الحَيَاةَ جَمِيعَهَا بِأَمَانِ",24,"ن",1,0],["مَا مِصْرُ مَا السُّودَانُ إِلاَّ جَانِبا","قَلْبٍ سَوَيِّ الخُلْقِ لا قَلْبَانِ",25,"ن",1,0],["مَا مِن عَظِيمٍ سِوَى سَعْدٍ أُتِيحَ لَهُ","فِي النَّاسِ حَيّاً وَمَيْتاً ذَلِكَ العِظَمُ",26,"م",1,0],["مَا مَجْدُكَ المَشْهُودُ إِلاَّ مَجْدُهَا","فِي قَلْبِ وَاعِي الْحِكْمَةِ المُتَفَهِّمِ",27,"م",1,0],["مَا مَطْلَبُ الفَخْرِ مِنْ أَيْدٍ مُنَعَّمَةٍ","رَطِيبَةٍ وَنُفُوسٍ لَيْسَ تَحْتَدِمُ",28,"م",1,0],["ما مَلكتُ الهَوى ولا النَفسَ مِنّي","مُنذُ عُلِّقتُها فَكَيفَ احتِيَالِي",29,"ي",1,0],["مأمونُها وأمينُها ورشيدها","منصورها مهديُّها المتوكّلُ",30,"ل",1,0],["ما منهم إلا أغرُّ محجّلٌ","يلقى العظائم وهو غير مبالِ",31,"ل",1,0],["ما مات من تركت لنا أقلامه","صوراً خوالد من بنات ضميره",32,"ر",2,0],["ما مِثلُ نَبعَتِنا أَعَزُّ مُرَكَّباً","وَأَقَلُّ قادِحَةً وَأَصلَبُ عودا",33,"د",2,0],["ما مَن جَفانا إِذا حاجاتُنا نَزَلَت","كَمَن لَنا عِندَهُ التَكريمُ وَاللَطَفُ",34,"ف",1,0],["ما مددنا لك اليمينَ ابتغاءً","للعطايا إلا شكرنا اليسارا",35,"ر",2,0],["ما مال غصن قوامهِ عن فكرتي","يوماً ولا دينار وجنتهِ انْصرف",36,"ف",1,0],["مأمورة الوصل والهجران جائرة","بالرَّدف والعطف بين الريث والعجل",37,"ل",1,0],["ما مثل قلبي سالياً عن مثله","خدّ قرأت عليهِ صورة نمله",38,"ل",2,1],["ما مثل أغزالي لحسنك ولا","مثل امْتداحِي في علاء الدِّين",39,"ن",1,0],["ما مثله في الحسنِ إلاَّ خطّ ذي","نظمٍ تأنَّق في البيان بنانه",40,"ن",2,0],["ما مُغَنٍّ غَنَّاكِ نِدَّاً لمُغْنٍ","رِفْدُهُ يجمع الغِنى والغناءَ",41,"ا",2,0],["ما مُشتهٍ قُربَك المكروهَ ذا رَشَدٍ","يا قِربةَ النفطِ لا قُدِّستَ في القِربِ",42,"ب",1,0],["ما مثلُهُ مَنْ سَاءَ تدبيرُهُ","هيهاتَ إن الشيخَ ذو إرْبِ",43,"ب",1,0],["ما مَدْمَعي حَذرَ النَّوى بقريحِ","فدعِ الغُرابَ يَصِيحُ كلَّ مَصيحِ",44,"ح",1,1],["ما متَّ بل مات أهلُ الأرْض كلُّهمُ","إذ بنتَ منْهم وكنت الروح في الجسدِ",45,"د",1,0],["ما مثلها يا شهاب الأرضِ غاشيةٌ","معهودة من غواشي تلكمُ الدار",46,"ر",1,0],["ما مثلُ ذاك الفتى يُعَرَّض لل","بَرِّ وآفاته ولا البحر",47,"ر",1,0],["ما منكُمُ رجلٌ تَمَّتْ رياستُه","إلا مَشُومٌ عظيم الكِبر جَبَّارُ",48,"ر",1,0],["ما مر من يوم عليه وليلةٍ","إلا وبعضُ غلامه في بعضِهِ",49,"ض",2,0],["ما مع الحالة التي","أنت فيها تظرُف",50,"ف",1,0],["ما من مزيد من بلية عاشق","وندى وخير في أبي إسحاق",51,"ق",1,0],["ما من الدعوتين إن ضفت دعوى","غير محتاجة إلى تحقيق",52,"ق",1,0],["ما مِنَ العدلِ والتُّقى","أن ترى قتلَ سائلِكْ",53,"ك",1,0],["ما ماتَ إلّا من تطا","وَلَ عُمرُهُ وأُذِيقَ ثُكْلَكْ",54,"ك",1,0],["ما مُهرت مهراً ولا نُكِحَتْ","إذْ ذاك في حَليٍ ولا حُلَلِ",55,"ل",1,0],["ما مَلَّني من أطاق صبر