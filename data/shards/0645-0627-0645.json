وم يروع ظلامه","إلا بدا صبح له وضاح",152,"ح",1,0],["ما ماتَ قَومي وَلا ماتَت مداركهم","لكنما ماتَت الاخلاق وَالشيم",153,"م",1,0],["ما ماتَت الأسلاف موت حقيقة","بَل إِنَّها لتعيش في الأخلاف",154,"ف",1,0],["ما مقامي بأرض نحلة إلا","كمقام المسيح بين اليهود",155,"د",1,0],["ما مات من أضحك المآسي","من قدَرٍ صنعُه عجيبُ",156,"ب",1,0],["ما مال حائط الهدى حتى اعتدلْ","والركن إن سدّ من الركن بدلْ",157,"ل",1,0],["ما منعوا الله ولا نبيه","قياد نفسٍ سمحةٍ أبيّه",158,"ه",1,0],["ما مَن أَدَلَّ بما وهبت كمى بغى","والناس ذو رأى وآخر ببَّغا",159,"غ",2,0],["مَا مَعْدِنٌ مُتشبِّهٌ فِي نقلِهِ","مِن مَعْدِنٍ فِي أَصْلِهِ مُتَأَلِّقِ",160,"ق",1,0],["مَا مُصْطفَى إِلاَّ الوَزِيرُ الَّذي","يَنْهَضُ لِلْخَيْرِ إِذَا مَا نَهَضْ",161,"ض",1,0],["مَا مِنْ أَمِيرٍ أَوْ رَفِيعِ مَكَانَةٍ","إِلا بَكَاهُ بِحَرِّ قَلْبٍ ذَابَا",162,"ب",2,0],["مَا مِصْرُ مَا أَحْوَالُهَا مَا قَوْمُهَا","يَا مَنْ أَقَامَ بِهَا ثَلاثَ لَيَالِ",163,"ل",1,0],["مَا مَوْتُ أَحْمَدَ حَتْفَ أَنْفٍ إِنَّهُ","لَلْقَتْلُ فِي عُقْبَى أَشَدِّ نِزَالِ",163,"ل",1,0],["مَا مَنْ رَدّى أَجْرى الشُّؤُو","نَ دماً كَمَا أَجْرَى رَدَاكْ",164,"ك",1,0],["مَا مِنْ فَتىً بالمَسَاعي","إِلى الْمَحَامدِ أَهْدَى",165,"د",2,0],["مَا مُقَامِي لَدَى إِفَاضَتِهِ فَيَّاضٌ","وَأَلْفَاظهُ العَذَابُ سِجَامُ",166,"م",1,0],["مَا مَوْقِفِي فِي مَصْرِفٍ لِلمَالِ","أَنَا شَاعِر مَا لِلحِسابِ وَما لِي",167,"ل",2,1],["مَا مَعَانِيهُمُ الحِسَانُ لَدَى","أَدْنَى مَعَانِيكِ أَيُّهَا الحَسْنَاءُ",168,"ا",2,0],["مَا مِصْرُ مِصْرُ وَمَا الرِّبَاعُ بِحُسْنِهَا","هِيَ عَيْنُ مَا عَهِدَتْهُ عَيْنُ الرَّابِعِ",169,"ع",1,0],["مَا مِنْ لَهِيفٍ لَمْ يُغِثْهُ وَمَعْهَد","لِلبِرِّ لَمْ يُخْلِدْ بِهِ آثَارَا",170,"ر",2,0],["ما مِثلُهُ وَلَدٌ هَلِ","سِيّان مِسكٌ وقارُ",171,"ر",1,0],["مَامَسَّ بِالكَفِّ أَوْرَاقاً وَلاَ قَلَماً","وَرَأْيُهُ زِنَةُ الأَوْرَاقِ وَالكُتُبِ",172,"ب",1,0],["ما مدحتُ الكريمَ إلاّ لأدعو","بمديحي إلى كريمِ صِفاته",173,"ت",2,0],["ما مَات مَن كتبَ الخلودُ رثاءَه","ووشَى له حُللَ الثناءِ الضَّافي",174,"ف",2,0],["ما مصر كلُّ جمانه، لكنها","حلَّت محلَّ القلب من خرزاته",175,"ت",2,0],["ما مد راحتَه الطوى","لا ثنتها كبرياؤه",176,"ا",3,0],["ما مَجَّد المتقاعدين، بل الأُلى","يدرُوا جهادًا في الحياةِ جديدا",177,"د",2,0],["ما مَال مِنْ كأسِ رَاحٍ رَاحَ يشربُها","لكنَّهُ من سجايا أهلِها شَرِبا",178,"ب",2,0],["ما مَنْ يجاهد خُفيةً","خلف الستار كمن يجاهر",179,"ر",1,0],["ما مات منهم واحدٌ","برصاصةٍ من كفِّ غادر",179,"ر",1,0],["ما معي حبٌّ يكافيك","سِوى حبة قلبي",180,"ي",1,0],["ما مَسَّ الاعلى طُهْرٍ غرامُكُم","قلبي لاني اعد الحب قرآنا",181,"ن",2,0],["ما مَشَى في هَنيءِ طَوْلِكَ تَطْوِي","لٌ، وَلا دَبَّ في عُداتكَ خُلْفُ",182,"ف",1,0],["ما مَوْضِعي بمُذَمَّمٍ عِندي، وَلا","سَيْبي، وَقَد أكّدْتَهُ، بضَعيفٍ",183,"ف",1,0],["ما مفزع العافي إذا شفَّه","حرمانه واشتدَّ إملاقه",184,"ق",2,0],["ما مثلُ داك الفتى يُعرَّض لل","بَر وآفاته ولا البحر",185,"ر",1,0],["ما مضيض الكلوم معتبطات","كمضيض الكلوم فوق الكلوم",186,"م",1,0],["ما مقام الحياة في النفس إلا","دون ما ينبغي لعالي مقامك",187,"ك",1,0]]}