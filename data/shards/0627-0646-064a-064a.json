te.com/ViewPoem.aspx?id=155755",""],[6147,"لو.","https://www.poetsgate.com/ViewPoem.aspx?id=151497",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[2220,"استغفرُ اللهَ منْ علمٍ أفوهُ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11427&r=&rc=301",""]],"verses":[["أَنّى يُتاهُ بِكُم في كُلِّ مُظلِمَةٍ","وَلِلرَشادِ أَماراتٌ وَعُنوانُ",0,"ن",1,0],["أَنّى يُقَرطِسُ ذو العَمى","غَرَضَ المَرامي بِالسِهامِ",1,"م",1,0],["أَنّى يَكونُ وَلَيسَ ذاكَ بِكائِنِ","يَرِثُ الخِلافَةَ فاسِقٌ عَن فاسِقِ",2,"ق",1,0],["أَنّى يُقَصِّرُ عَن مَكانٍ في العُلا","وَالمَجدِ مَن أَضحى أَبوهُ أَباهُما",3,"م",2,0],["أنى يقايس بالأنواءِ نائله","وهي التي باحمرار البرق قد خجلت",4,"ت",1,0],["إِنّي يَتيمٌ وَلي آب أَلوذُ بِهِ","قَلبي لِغَيبَتِهِ ما عِشتُ مَكروبُ",5,"ب",1,0],["أنَّى يكون مُمدَّداً","رَجلٌ وقد رفعوا كِعابهْ",6,"ب",2,0],["أنَّى يَسُبُّ بني ثوا","بة أو عبيدَ بني ثوابهْ",6,"ب",2,0],["أنَّى يُلاقي القارظَ ال","عَنَزيَّ من يرجو إيابهْ",6,"ب",2,0],["أَنَّى يقولُ من الأقوال أَثْقَبَهَا","من راح يحملُ وجهاً سابغَ الذَنَبِ",7,"ب",1,0],["أنَّى يكون كما يشاء مُدَبَّرٌ","بِيَدَيْ سِواه سَقَامُهُ وصَحَاحُهُ",8,"ح",2,0],["أنَّى يخيبُ ولا يفُوزُ مُسَاهِمٌ","والحاكمون الفاصلون قِداحُه",8,"ح",2,0],["أنَّى يكون لنفسٍ حرة سَكَناً","وليس فيه لكلب جائع جَزَر",9,"ر",1,0],["أنَّى يُسَرُّ بمدحه","من لا يُسر بضوء شمسِهْ",10,"س",2,0],["أنى يعنف كل معنوف به","يَثني يديه على حشا خفّاق",11,"ق",1,0],["أنَّى يُساميك في صليبة أح","رارِك أو مُعتفيكِ من يمنِكْ",12,"ك",1,0],["أنَّى يصلنك لا وصلْ","نَ ولو بقين بلا مُواصِلْ",13,"ل",1,0],["أنّى يكون أبا لِصَق","رٍ من أبوه بلبلُ",14,"ل",1,0],["أنَّى يكون ربيعي ممرعاً غَدِقاً","إن لم يكن هكذا والشمس في الحَمَلِ",15,"ل",1,0],["أنّى يقوَّمُ من كفاهُ قوامُه","سبق القوام فأُسقط التقويمُ",16,"م",1,0],["أنَّى يلومُك طائعاً من لا يرى","ما دمتَ حياً أن يلومَ زمانَهُ",17,"ن",2,0],["أنَّى ينهنهُ ناقمٌ عن ظالمٍ","ولهُ الأيادي السيئات لديه",18,"ي",2,0],["أَنّى يَكونُ أَبا البَرِيَّةِ آدَمٌ","وَأَبوكَ وَالثَقلانِ أَنتَ مُحَمَّدُ",19,"د",1,0],["أنّى يناقِلُكَ العلاءَ مفاخِرٌ","ولقد عنَا لعلائِك القَمرانِ",20,"ن",1,0],["أَنّى يَكونُ لَهُ اتِّصالٌ في النَدى","وَوُقوعُهُ في الحينِ بَعدَ الحينِ",21,"ن",1,0],["إِنّي يُهَيِّجُني إِذا ذُكِرَت","ريحُ الجَنوبِ لَها عَلى الذِكرِ",22,"ر",1,0],["أَنَّى يُصَفَّيكَ الدواءُ وشُربُه","وتَوَرُّدُ الغَمَراتِ قد صَفَّاكا",23,"ك",2,0],["أنّى يعودُ من الصَّبابةِ مُفْرِقا","ولِقاؤُّهُم للبَيْنِ غادَرَهُ لَقَا",24,"ق",2,1],["أنَّى يكونُ القصْدُ شيمةَ وَجْدِه","يومَ النَّوى والجَورُ شيمةُ جارِه",25,"ر",2,0],["أَنّى يَكونُ تَقِيّاً غَيرُ ذي حَرَجٍ","ما يَتَّقي اللَهَ إِلّا كُلُّ ذي حَرَجِ",26,"ج",1,0],["أَنّى يَفوتُ مَخالِبي في بَلدَةٍ","أَرضي بِها مَبسوطَةٌ وَسَمائي",27,"ي",1,0],["أَنّى يَفوتُكَ ما طَلَبتَ وَإِنَّما","وَطَراكَ أَن تُعطي الجَزيلَ وَتُحمَدا",28,"د",2,0],["أَنَّى يَفِرُّ الْمَرْءُ مِن شَرَكِ الرَّدَى","وَالْمَوْتُ مَقْدُورٌ عَلَى الْحَيَوَانِ",29,"ن",1,0],["أنَّى يَخِيبُ وقد تَعَطَّرَ مَشْرِقٌ","بمَدَائحي خيرَ الأنامِ ومَغْرِبُ",30,"ب",1,0],["أنّى يُكَيِّفُها امرؤٌ وَيَحُدُّها","بالقولِ وهْيَ لِذَا الوُجُودِ الرُّوحُ",31,"ح",1,0],["إِنّي يُشَيِّعُني قَلبي بِقافِيَةٍ","راحَت تُحَرِّقُ في كَلبٍ وَخِنزيرِ",32,"ر",1,0],["أَنّي يَنالُ أَخو الدِيانَةِ سُؤدَداً","وَمَآرِبُ الرَجُلِ الشَريفِ خَسائِسُ",33,"س",1,0],["إني يئست من الضياء فَلا أَرى","إلا بجانب مصر بعض بريق",34,"ق",1,0],["إنِّيَ يا أعيني فَجودي","لا أَبتَغي رفقة شحاحا",35,"ح",2,0],["أَنَّى يَطِيشُ عَنِ الْقُلُوبِ لِغَمْزَةٍ","سَهْمٌ وَقَوْسُ الْحَاجِبَيْنِ مُوَتَّرُ",36,"ر",1,0],["أَنَّى يُقَالُ جِنَازَةٌ وَهْيَ الَّتِي","حَمَلَتْ لِقَوْمٍ آيَةَ الإِنْشَارِ",37,"ر",1,0],["أَنَّى يَكُونُوا أَوْ نَكُنْ","فَالشُّكْرُ وَاجِدُنَا عَبِيدَهْ",38,"د",2,0],["أنّي يقصِر بالعِنان اذا انبرى","وهو الجموح وفكرك الميدان",39,"ن",1,0],["أنَّى ينهنهُ ناقمٌ عن ظالمٍ","ولهُ الأيادي الشيئات لديه",40,"ي",2,0],["أنّى يكون أبا الصق","ر من أبوه بلبلُ",41,"ل",1,0],["إني يلذ لي الجلوس مكعوكاً","متقهوياً ومقهوياً من دوني",42,"ن",2,0],["أني يُحَلأُ أو يَئُوبُ مَصَرّداً","صَادٍ ألَمَّ بِمَنهَلٍ يَشكُو الظَّمَا",43,"م",2,0],["أنَّي يقومَ بحقِ مدحكَ شاعر","ما لامتداح علاكَ والشعراءِ",44,"ا",2,0],["أَنّى يَنالُ مَحَلَّةَ الجَوزاءِ مَن","لا يَستَطيعُ مِنَ الصَعيدِ صُعودا",45,"د",2,0],["أَنّى يَكونُ شَريكُهُ في عَمِّهِ","كَشَريكِهِ في عَمِّهِ وَالخالِ",46,"ل",1,0],["أَنّى يُشارِكُكَ الوَرى في رُتبَةٍ","أَدلَجتَ تَطلُبُها وَباتوا نُوَّما",47,"م",2,0],["أنَى يعيد وأنت أنت","ملوكه ويعد صيده",48,"د",2,0],["أنى يصحّ الفرع ينكر أصله","ما للمحال بحاله إمكانه",49,"ن",2,0],["انيى امرؤ صحب الزمان فصانه","عن غيه قلب يصان برشده",50,"د",2,0],["أَنَّى ينوءُ زماني بالذي اقترَحَتْ","نفسي وما خُلُقُ الأيامِ من خلقي",51,"ق",2,0],["أني يصور علة قد جاورت","أعضاء صب لا ترى أعضاؤه",52,"ا",3,0],["أَنّى يَسوغُ لِعاشِقٍ كتمانُهُ","وَوُشاتُهُ يَومَ النَوى أَجفانُهُ",53,"ن",2,1],["أَنّى يُرجّى مِن هواك فكاكُها","من بعد ما عَلِقَت بها الأَشراكُ",54,"ك",1,0],["أَنىّ يكون بها نها","رٌ ثم ليلٌ مظلم",55,"م",1,0],["أَنّى يرى الأشيا كَما هي ناظرٌ","مِن خلفِ حجبِ عوائدٍ لا ترفعُ",56,"ع",1,0],["أنى يطرقُ الأرض من سقفها","فيا للطروقَةِ والطارقِ",57,"ق",1,0],["أَنّى يُناظره السِوى بِشَمائل","لا تَستَوي أَنوارُها وَظَلامُها",58,"م",3,0],["أَنّى يَكون لَدى الأَنام مكرَّما","مَن كانَ أَشأم مِن طويس وَأَنحَسا",59,"س",2,0],["أَنّى يَسومُ سَماءَ مَج","دِكَ اَن يُناطَ بِها ثَراها",60,"ا",3,0],["أنَّى يُغيِّر عَهدَكَ القِدمُ","أسَمَوتَ أم سَقطَت بي الهِمَمُ",61,"م",1,1],["أنَّى ينمُّ عَلى امرِئٍ سِحر الهَوَى","وعلَيهِ من قَصد الأميرِ تَمائِمُ",62,"م",1,0],["إن يئِسَت نفسُه وإن قَنَطا","وسرَّ بِالاعتِزالِ واغتَبَطا",63,"ط",2,1],["أنى يقدر كاتب متمرد","في حبره دعوى الضلال تذاب",64,"ب",1,0],["أنَّى يواصلني الغرام وقد","ولِيَ المشيب سياسة العمر",65,"ر",1,0],["أنَّى يساعدني القري","ض وقد هجرت الشعر دهرا",66,"ر",2,0],["أني يهتدي ما لم فإن أمانه","حتم كما في الذكر قال الواحد",67,"د",1,0],["أنّى يكونُ وضيعُ النَّفسِ ذا هِمَمٍ","لهُ بإبلاغِها أقصى العُلا وَلَهُ",68,"ه",1,0],["أنَّى يخافُ المَوت حَيُّ عالِمٌ","يَعتَدُّهُ فَضلاً مُقوِّمَ ذاتِهِ",69,"ت",2,0],["أَنّي يَكونُ وَلَيسَ ذاكَ بِكائِنٍ","لِبَني البَناتِ وِراثَةُ الأَعمامِ",70,"م"