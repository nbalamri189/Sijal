{"poems":[[53,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[54,"علم وتحكيم وشيب مفارق","https://www.aldiwan.net/poem27519.html","الكامل"],[47,"إبنان أم شبلان ذان فإنني","https://www.aldiwan.net/poem25154.html","الكامل"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[64,"للعلم أهل وللإيمان ترتيب","https://www.aldiwan.net/poem67665.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[51,"قل لابن بلبل لم غلطت","https://www.aldiwan.net/poem65984.html","مجزوء الكامل"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[51,"أمسى دمشقي الأمير ودهره","https://www.aldiwan.net/poem66442.html","الكامل"],[51,"إن كنت تمقت من أساء لأنه","https://www.aldiwan.net/poem66778.html","الكامل"],[43,"اليوم عهدكم فأين الموعد","https://www.aldiwan.net/poem9534.html","الكامل"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[45,"ليس الزمان بمعتب فذريني","https://www.aldiwan.net/poem66683.html","الكامل"],[28,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[61,"عقبى دوائك صحة تغشاكا","https://www.aldiwan.net/poem51498.html","الكامل"],[61,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[61,"ما سره أن ذاع من أسراره","https://www.aldiwan.net/poem51672.html","الكامل"],[49,"الناس في الدين والدنيا ذو درج","https://www.aldiwan.net/poem62020.html","البسيط"],[44,"أعتيب يا ابن الفعلة اللخناء","https://www.aldiwan.net/poem30074.html","الكامل"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[87,"ذكر الصبا فبكى ولات أوان","https://www.aldiwan.net/poem8210.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[50,"سبح خليلي وقل يا حسن تصوير","https://www.aldiwan.net/poem63819.html","البسيط"],[46,"جنت الغوارس واستقل أخو الغني","https://www.aldiwan.net/poem22806.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85550","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[51,"وَلِحْيَة ِ سُوءٍ وَلكنَّهَا","https://www.poetsgate.com/ViewPoem.aspx?id=30777",""],[51,"قل لابنُ بلبل لِمْ غلطْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=30306",""],[125,"خل السجاير وادن لي غليوني","https://www.aldiwan.net/poem23756.html","الكامل"],[133,"إن التي هام الفؤاد بذكرها","https://www.aldiwan.net/poem54752.html","الكامل"],[136,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[144,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[144,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[144,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[151,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[151,"لا يخدعنك ظاهر من باطن","https://www.aldiwan.net/poem68507.html","الكامل"],[161,"أترى النسيم إذا سرى من نجده","https://www.aldiwan.net/poem58724.html","الكامل"],[199,"زارتك من رقبة الواشي على فرق","https://www.aldiwan.net/poem51917.html","البسيط"],[262,"عوفيت نضو هواك برح داؤه","https://www.aldiwan.net/poem38139.html","الكامل"],[283,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[298,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[299,"ماذا الذي تدعوه نورا","https://www.aldiwan.net/poem36298.html","عموديه"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[354,"أظباء رامة بالظبى آرامها","https://www.aldiwan.net/poem39962.html","الكامل"],[354,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[367,"تشكو إليه أن صا","https://www.aldiwan.net/poem17338.html","مجزوء الكامل"],[372,"أنى يغير عهدك القدم","https://www.aldiwan.net/poem57113.html","الكامل"],[372,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[372,"إن يئست نفسه وإن قنطا","https://www.aldiwan.net/poem57339.html","المنسرح"],[401,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[404,"زارت وقد ولى الهوى العذري","https://www.aldiwan.net/poem33903.html","الكامل"],[404,"أحلى الهوى ما كان جهرا","https://www.aldiwan.net/poem33914.html","مجزوء الكامل"],[404,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[406,"لما رأوني فريدا حلس زاوية","https://www.aldiwan.net/poem49669.html","البسيط"],[406,"الحر في التحقيق معتق ذاته","https://www.aldiwan.net/poem50036.html","الكامل"],[411,"طاف الخيال وحيه بسلام","https://www.aldiwan.net/poem67468.html","الكامل"],[417,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[430,"عوفي الندى والمجد والأدب","https://www.aldiwan.net/poem40710.html","أحذ الكامل"],[462,"فخرت بك الأزمان والحقب","https://www.aldiwan.net/poem16420.html","أحذ الكامل"],[465,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[480,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[514,"يا من تجاوز حد السمع والبصر","https://www.aldiwan.net/poem67747.html","البسيط"],[515,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[515,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[552,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[552,"إن كنت بالعفو ليس تعذرنا","https://www.aldiwan.net/poem47851.html","المنسرح"],[563,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"]],"verses":[["أَنّى يُتاهُ بِكُم في كُلِّ مُظلِمَةٍ","وَلِلرَشادِ أَماراتٌ وَعُنوانُ",0,"ن",1,0],["أَنّى يُقَرطِسُ ذو العَمى","غَرَضَ المَرامي بِالسِهامِ",1,"م",1,0],["أَنّى يَكونُ وَلَيسَ ذاكَ بِكائِنِ","يَرِثُ الخِلافَةَ فاسِقٌ عَن فاسِقِ",2,"ق",1,0],["أَنّى يُقَصِّرُ عَن مَكانٍ في العُلا","وَالمَجدِ مَن أَضحى أَبوهُ أَباهُما",3,"م",2,0],["أنى يقايس بالأنواءِ نائله","وهي التي باحمرار البرق قد خجلت",4,"ت",1,0],["إِنّي يَتيمٌ وَلي آب أَلوذُ بِهِ","قَلبي لِغَيبَتِهِ ما عِشتُ مَكروبُ",5,"ب",1,0],["أنَّى يكون مُمدَّداً","رَجلٌ وقد رفعوا كِعابهْ",6,"ب",2,0],["أنَّى يَسُبُّ بني ثوا","بة أو عبيدَ بني ثوابهْ",6,"ب",2,0],["أنَّى يُلاقي القارظَ ال","عَنَزيَّ من يرجو إيابهْ",6,"ب",2,0],["أَنَّى يقولُ من الأقوال أَثْقَبَهَا","من راح يحملُ وجهاً سابغَ الذَنَبِ",7,"ب",1,0],["أنَّى يكون كما يشاء مُدَبَّرٌ","بِيَدَيْ سِواه سَقَامُهُ وصَحَاحُهُ",8,"ح",2,0],["أنَّى يخيبُ ولا يفُوزُ مُسَاهِمٌ","والحاكمون الفاصلون قِداحُه",8,"ح",2,0],["أنَّى يكون لنفسٍ حرة سَكَناً","وليس فيه لكلب جائع جَزَر",9,"ر",1,0],["أنَّى يُسَرُّ بمدحه","من لا يُسر بضوء شمسِهْ",10,"س",2,0],["أنى يعنف كل معنوف به","يَثني يديه على حشا خفّاق",11,"ق",1,0],["أنَّى يُساميك في صليبة أح","رارِك أو مُعتفيكِ من يمنِكْ",12,"ك",1,0],["أنَّى يصلنك لا وصلْ","نَ ولو بقين بلا مُواصِلْ",13,"ل",1,0],["أنّى يكون أبا لِصَق","رٍ من أبوه بلبلُ",14,"ل",1,0],["أنَّى يكون ربيعي ممرعاً غَدِقاً","إن لم يكن هكذا والشمس في الحَمَلِ",15,"ل",1,0],["أنّى يقوَّمُ من كفاهُ قوامُه","سبق القوام فأُسقط التقويمُ",16,"م",1,0],["أنَّى يلومُك طائعاً من لا يرى","ما دمتَ حياً أن يلومَ زمانَهُ",17,"ن",2,0],["أنَّى ينهنهُ ناقمٌ عن ظالمٍ","ولهُ الأيادي السيئات لديه",18,"ي",2,0],["أَنّى يَكونُ أَبا البَرِيَّةِ آدَمٌ","وَأَبوكَ وَالثَقلانِ أَنتَ مُحَمَّدُ",19,"د",1,0],["أنّى يناقِلُكَ العلاءَ مفاخِرٌ","ولقد عنَا لعلائِك القَمرانِ",20,"ن",1,0],["أَنّى يَكونُ لَهُ اتِّصالٌ في النَدى","وَوُقوعُهُ في الحينِ بَعدَ الحينِ",21,"ن",1,0],["إِنّي يُهَيِّجُني إِذا ذُكِرَت","ريحُ الجَنوبِ لَها عَلى الذِكرِ",22,"ر",1,0],["أَنَّى يُصَفَّيكَ الدواءُ وشُربُه","وتَوَرُّدُ الغَمَراتِ قد صَفَّاكا",23,"ك",2,0],["أنّى يعودُ من الصَّبابةِ مُفْرِقا","ولِقاؤُّهُم للبَيْنِ غادَرَهُ لَقَا",24,"ق",2,1],["أنَّى يكونُ القصْدُ شيمةَ وَجْدِه","يومَ النَّوى والجَورُ شيمةُ جارِه",25,"ر",2,0],["أَنّى يَكونُ تَقِيّاً غَيرُ ذي حَرَجٍ","ما يَتَّقي اللَهَ إِلّا كُلُّ ذي حَرَجِ",26,"ج",1,0],["أَنّى يَفوتُ مَخالِبي في بَلدَةٍ","أَرضي بِها مَبسوطَةٌ وَسَمائي",27,"ي",1,0],["أَنّى يَفوتُكَ ما طَلَبتَ وَإِنَّما","وَطَراكَ أَن تُعطي الجَزيلَ وَتُحمَدا",28,"د",2,0],["أَنَّى يَفِرُّ الْمَرْءُ مِن شَرَكِ الرَّدَى","وَالْمَوْتُ مَقْدُورٌ عَلَى الْحَيَوَانِ",29,"ن",1,0],["أنَّى يَخِيبُ وقد تَعَطَّرَ مَشْرِقٌ","بمَدَائحي خيرَ الأنامِ ومَغْرِبُ",30,"ب",1,0],["أنّى يُكَيِّفُها امرؤٌ وَيَحُدُّها","بالقولِ وهْيَ لِذَا الوُجُودِ الرُّوحُ",31,"ح",1,0],["إِنّي يُشَيِّعُني قَلبي بِقافِيَةٍ","راحَت تُحَرِّقُ في كَلبٍ وَخِنزيرِ",32,"ر",1,0],["أَنّي يَنالُ أَخو الدِيانَةِ سُؤدَداً","وَمَآرِبُ الرَجُلِ الشَريفِ خَسائِسُ",33,"س",1,0],["إني يئست من الضياء فَلا أَرى","إلا بجانب مصر بعض بريق",34,"ق",1,0],["إنِّيَ يا أعيني فَجودي","لا أَبتَغي رفقة شحاحا",35,"ح",2,0],["أَنَّى يَطِيشُ عَنِ الْقُلُوبِ لِغَمْزَةٍ","سَهْمٌ وَقَوْسُ الْحَاجِبَيْنِ مُوَتَّرُ",36,"ر",1,0],["أَنَّى يُقَالُ جِنَازَةٌ وَهْيَ الَّتِي","حَمَلَتْ لِقَوْمٍ آيَةَ الإِنْشَارِ",37,"ر",1,0],["أَنَّى يَكُونُوا أَوْ نَكُنْ","فَالشُّكْرُ وَاجِدُنَا عَبِيدَهْ",38,"د",2,0],["أنّي يقصِر بالعِنان اذا انبرى","وهو الجموح وفكرك الميدان",39,"ن",1,0],["أنَّى ينهنهُ ناقمٌ عن ظالمٍ","ولهُ الأيادي الشيئات لديه",40,"ي",2,0],["أنّى يكون أبا الصق","ر من أبوه بلبلُ",41,"ل",1,0],["إني يلذ لي الجلوس مكعوكاً","متقهوياً ومقهوياً من دوني",42,"ن",2,0],["أني يُحَلأُ أو يَئُوبُ مَصَرّداً","صَادٍ ألَمَّ بِمَنهَلٍ يَشكُو الظَّمَا",43,"م",2,0],["أنَّي يقومَ بحقِ مدحكَ شاعر","ما لامتداح علاكَ والشعراءِ",44,"ا",2,0],["أَنّى يَنالُ مَحَلَّةَ الجَوزاءِ مَن","لا يَستَطيعُ مِنَ الصَعيدِ صُعودا",45,"د",2,0],["أَنّى يَكونُ شَريكُهُ في عَمِّهِ","كَشَريكِهِ في عَمِّهِ وَالخالِ",46,"ل",1,0],["أَنّى يُشارِكُكَ الوَرى في رُتبَةٍ","أَدلَجتَ تَطلُبُها وَباتوا نُوَّما",47,"م",2,0],["أنَى يعيد وأنت أنت","ملوكه ويعد صيده",48,"د",2,0],["أنى يصحّ الفرع ينكر أصله","ما للمحال بحاله إمكانه",49,"ن",2,0],["انيى امرؤ صحب الزمان فصانه","عن غيه قلب يصان برشده",50,"د",2,0],["أَنَّى ينوءُ زماني بالذي اقترَحَتْ","نفسي وما خُلُقُ الأيامِ من خلقي",51,"ق",2,0],["أني يصور علة قد جاورت","أعضاء صب لا ترى أعضاؤه",52,"ا",3,0],["أَنّى يَسوغُ لِعاشِقٍ كتمانُهُ","وَوُشاتُهُ يَومَ النَوى أَجفانُهُ",53,"ن",2,1],["أَنّى يُرجّى مِن هواك فكاكُها","من بعد ما عَلِقَت بها الأَشراكُ",54,"ك",1,0],["أَنىّ يكون بها نها","رٌ ثم ليلٌ مظلم",55,"م",1,0],["أَنّى يرى الأشيا كَما هي ناظرٌ","مِن خلفِ حجبِ عوائدٍ لا ترفعُ",56,"ع",1,0],["أنى يطرقُ الأرض من سقفها","فيا للطروقَةِ والطارقِ",57,"ق",1,0],["أَنّى يُناظره السِوى بِشَمائل","لا تَستَوي أَنوارُها وَظَلامُها",58,"م",3,0],["أَنّى يَكون لَدى الأَنام مكرَّما","مَن كانَ أَشأم مِن طويس وَأَنحَسا",59,"س",2,0],["أَنّى يَسومُ سَماءَ مَج","دِكَ اَن يُناطَ بِها ثَراها",60,"ا",3,0],["أنَّى يُغيِّر عَهدَكَ القِدمُ","أسَمَوتَ أم سَقطَت بي الهِمَمُ",61,"م",1,1],["أنَّى ينمُّ عَلى امرِئٍ سِحر الهَوَى","وعلَيهِ من قَصد الأميرِ تَمائِمُ",62,"م",1,0],["إن يئِسَت نفسُه وإن قَنَطا","وسرَّ بِالاعتِزالِ واغتَبَطا",63,"ط",2,1],["أنى يقدر كاتب متمرد","في حبره دعوى الضلال تذاب",64,"ب",1,0],["أنَّى يواصلني الغرام وقد","ولِيَ المشيب سياسة العمر",65,"ر",1,0],["أنَّى يساعدني القري","ض وقد هجرت الشعر دهرا",66,"ر",2,0],["أني يهتدي ما لم فإن أمانه","حتم كما في الذكر قال الواحد",67,"د",1,0],["أنّى يكونُ وضيعُ النَّفسِ ذا هِمَمٍ","لهُ بإبلاغِها أقصى العُلا وَلَهُ",68,"ه",1,0],["أنَّى يخافُ المَوت حَيُّ عالِمٌ","يَعتَدُّهُ فَضلاً مُقوِّمَ ذاتِهِ",69,"ت",2,0],["أَنّي يَكونُ وَلَيسَ ذاكَ بِكائِنٍ","لِبَني البَناتِ وِراثَةُ الأَعمامِ",70,"م",1,0],["أنّى يسالمني الزمان وقد رأى","هِمَمي على حرب الزمان شدادا",71,"د",2,0],["إني يضيرك بالضنا عرضٌ","يا جوهراً تزهو به الرتبُ",72,"ب",1,0],["أنَّى يُجاذبُكَ الرِّجالُ عُلاً","ولكَ المَعالي الغُرُّ والنَّسَبُ",73,"ب",1,0],["أنى يخاف الدين زيفاً بعدما","تخذ الحسام جليسه والمصحفا",74,"ف",2,0],["أنّي يكون المآل","والظلم ما زال يصعد",75,"د",1,0],["أنى يضر ندى الأمطار ذا كبد","حرى وقلبٍ بنار الشوق مستعر",76,"ر",1,0],["أنّى يطَهّرُ بالخِتان صبيّكُم","أو تنجُسونَ وأنتمُ ماءُ السّما",77,"م",2,0],["أنّى يحاوِلُ فيه مدّعٍ صفةً","وهل يُحصِّلُ طِيبَ النّرجسِ البصلُ",78,"ل",1,0],["أَنّى يَزور عَلى الظّلماءِ مِنْ شَحَطٍ","مَنْ كانَ صُبْحاً وَقُرباً غيرَ زَوَّارِ",79,"ر",1,0],["إنِّيَ يا ذا الجلالتين وقد","خُلّفتُ عنكمْ كُرْهاً ولم أرِدِ",80,"د",1,0],["أنَّى يُناقضهمْ من لا يُماثلُهُم","حتى يَرُدَّ لهم عاداً إلى إرَمِ",81,"م",1,0]]}