{"poems":[[93,"هنيئا أيها العلم المفدى","https://www.aldiwan.net/poem11306.html","الوافر"],[30,"أمنكر أنت ربع الدار عن عفر","https://www.aldiwan.net/poem29614.html","البسيط"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[38,"إنا وجدنا العيس خيرا بقية","https://www.aldiwan.net/poem7692.html","الطويل"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[28,"ألكني إلى قطب الرحا إن لقيته","https://www.aldiwan.net/poem1303.html",""],[58,"وأفضل قسم الله للمرء عقله","https://www.aldiwan.net/poem31177.html","الطويل"],[44,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[105,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[21,"وميز في إنفاقه بين مصلح","https://www.aldiwan.net/poem36196.html","الطويل"],[50,"إذا أكره الخطي فينا وفيهم","https://www.aldiwan.net/poem62215.html","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54839","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54526","الوافر"],[106,"زعانف إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179677",""],[38,"إنَّا وَجَدْنَاالْعِيسَ خَيْراً بَقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=17303",""],[58,"وأفضل قسم الله للمرءِ عقلهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15496&r=&rc=24",""],[132,"أرقت ودمع العين في العين غائر","https://www.aldiwan.net/poem21007.html","الطويل"],[141,"حاشاك أن تسلب الأيام ما تهب","https://www.aldiwan.net/poem11738.html","البسيط"],[179,"أعنى على برق أريك وميضه","https://www.aldiwan.net/poem58764.html","الطويل"],[179,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[184,"يا رب عفوك عن شيخ وذي حنف","https://www.aldiwan.net/poem43615.html","البسيط"],[184,"إذا أكل البصير مع الضرير","https://www.aldiwan.net/poem43806.html","الوافر"],[184,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[193,"نشا مستسرا بين هضب هشيمة","https://www.aldiwan.net/poem54363.html","الطويل"],[227,"ما بال عينك تقوى كلما ضعفت","https://www.aldiwan.net/poem50802.html","البسيط"],[233,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[295,"سلام على بدر له السعد مطلع","https://www.aldiwan.net/poem33228.html","الطويل"],[296,"قفا عللا قبل التفرق عانيا","https://www.aldiwan.net/poem36278.html","عموديه"],[320,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[409,"بكى فرثت له أجبال صبح","https://www.aldiwan.net/poem34.html","الوافر"],[436,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[438,"لقد أكثرت في الترب المراثي","https://www.aldiwan.net/poem14357.html","الوافر"],[456,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[459,"وخاطر من حديث المجد ساورني","https://www.aldiwan.net/poem15908.html","البسيط"],[512,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[513,"إذا أكثر المحموم من هذيانه","https://www.aldiwan.net/poem12279.html","الطويل"],[573,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["إِذَا أُكْرِمْتَ فَالإِكْرَامُ حَقٌّ","لَهَتيكِ الفَضَائِل وَالعُلُومِ",0,"م",1,0],["إِذا اِكتَسَت عَرَقاً جوناً على عَرَقٍ","يُضحي بِأَعطافِها مِنهُ جَلابيبُ",1,"ب",1,0],["إِذا اكتَحَلَت عَيني بِعَينِكِ مَسَّني","بِخَيرٍ وَجَلّى غَمرَةً عَن فُؤادِيا",2,"ي",2,0],["إذا اكتحلوا بي مُقْبلاً فكأنما","جباهُهُمُ مزويةٌ بالمحاجمِ",3,"م",1,0],["إِذا اِكتَحَلَت بَعدَ اللِقاحِ نُحورُها","بِنَسأٍ حَمَت أَغبارُها وَاِزمَهَرَّتِ",4,"ت",1,0],["إِذا اِكتَسى المَلِكُ الجَبّارُ أُبَّهَةً","غَشّاهُ بِالسَيفِ ثَوبَ الذُلِّ وَالخَمَلِ",5,"ل",1,0],["إِذا اِكتَفَلَت بِالعُرفَتَينِ وَدونَها","بَنو أَسَدٍ لَم يُدرَ مِن أَينَ تُطلَبُ",6,"ب",1,0],["إِذا أَكمَلَ الرَحمَنُ لِلمَرءِ عَقلَهُ","فَقَد كُمُلَت أَخلاقُهُ وَمآرِبُه",7,"ب",2,0],["إِذا أَكدَت سَوامُ الشِعرِ أَضحَت","عَطاياهُ وَهُنَّ لَها مَراعي",8,"ع",2,0],["إِذا اِكتَحَلَت عَيني بِعَينِكِ لَم نَزَل","بِخَيرٍ وَأَجلَت غَمرَةً عَن فُؤادِيا",9,"ي",2,0],["إذا أكل الدهر الرجال أكلته","وإن وأد الآثار أعجزته وأدا",10,"د",2,0],["إِذا اِكتَسَبَ المالَ الفَتى مِن وجوهِهِ","وَأَحسَنَ تَدبيراً لَهُ حينَ يَجمَعُ",11,"ع",1,0],["إِذا أُكرِهَ الخَطِّيُّ فينا وَفيهِمُ","جَرى ماؤُهُ في لامِنا وَتَحَطَّما",12,"م",2,1],["إِذا اِكتَحَلَت عَيني بِعَينِكِ لَم تَزَل","بِخَيرٍ وَجَلَّت غَمرَةً عَن فُؤادِيا",13,"ي",2,0],["إِذَا أَكْرَمَتْ مِصْرُ الْعَزِيزَةُ ضَيْفَهَا","فَهَلْ عَجَبٌ أَنْ يُكْرَمَ الضَّيْفُ فِي مِصْرِ",14,"ر",1,1],["إِذَا أُكْرِمْتَ وَالحَفَلاَتُ شَتَّى","فَذَلِكَ شَكْرُ مِصْرَ وَلا مِرَاءُ",15,"ا",2,0],["إذا اكتنَفَ الزهر الذباب، فإنني","-وإن أنبتَتهُ جنَّةُ الخلد- عائِفُه",16,"ف",2,0],["إذَا اكْتَحَلَتْ بَعْدَ اللِّقَاحِ نُحُورُهَا","بِنَسْءٍ حَمَتْ أغْبَارُهَا وکزْمَهَرَّتِ",17,"ت",1,0],["إِذَا أَكْمَلَ الرَّحْمَانُ لِلْمَرْءِ عَقْلَهُ","فقد كملتْ أخلاقه ومآربه",18,"ب",2,0],["إِذا أَكَلَت يَوماً أَتى الغَدَ مِثلها","زَواهِقُ زُهمٌ أَو مَخاضٌ بَهازِرُ",19,"ر",1,0],["إِذا اِكتَسَت بَارِضَ الرَبعيِّ أَرضُهُمُ","فَليَرقُبوها فَإِنَّ المُلتَقى كَثَبُ",20,"ب",1,0],["إِذا اكتَحَلَت عَينا مُحِبٍّ بِضَوئِهِ","تَجافَت بِهِ حَتَّى الصَّبَاحِ مَضَاجِعُه",21,"ع",2,0],["إِذا أَكثَرَ الكُرهَ المُحَبُّ وَلَم يَكُن","لَهُ عِلَلٌ كادَ المُحَبُّ يَريبُ",22,"ب",1,0],["إذا أكلتُ كسيراتي على سغب","تمرٌ وماءٌ فقد ناهيت في السرفِ",23,"ف",1,0],["إذا أكل البصير مع الضرير","فويل للضرير من البصير",24,"ر",1,1],["إذا أكلوا الخروب جئنا بيانع","من الرطب الآزاذ يلمع كالتبر",25,"ر",1,0],["إِذا اِكتَحَلتَ عَينُ البَصيرَ بِرَأيِهِ","بَداهُ بِذَعرٍ قَبلَ أَن يَتَهَضَّما",26,"م",2,0],["إذا اكتحلت بنومي استيقظت فِطَني","حتى كأني إذا ما نمتُ لم أنم",27,"م",1,0],["إِذا اِكتَحَلَت بِهِ الأَبصارُ أَغضَت","وَفيها مِن مَهابَتِهِ اِنكِسارُ",28,"ر",1,0],["إِذا اِكتحلت عيني بآثار رَبعه","تحدَّر منها أَربعونَ وأَربعُ",29,"ع",1,0],["إذا اكتحلتْ عينُ المحبِّ به يبتْ","ومضجعه عنه إلى الفجرِ نابيا",30,"ي",2,0],["إِذا اِكتَهَلَت وَاِعتَمَّ أَزواجُ نَبتِها","نَما بَعدَهُ بَقلٌ تُؤامٌ وَزاهِرُ",31,"ر",1,0],["إِذا اكتَنَفا بِضَرِّهِما سَقِيم","يُعادِى الدّاء ليس لَهُ مُقِيتُ",32,"ت",1,0],["إذا اكتَحَلَ الجَوُّ كُحْلَ الظَّلامِ","كَحَلْتَ العيونَ بِطولِ السُّهادِ",33,"د",1,0],["إذا اكترثت رجال في المساعي","سعيت فنلت من غير اكتراث",34,"ث",1,0],["إذا أكلَ الدهرُ أعواضَها","من المال عمَّرها سَرمدا",35,"د",2,0],["اذا اكفهرَّ شديدٌ فهو مُبتسمٌ","وفيه عن عَوَراتِ القولِ تقْطيبُ",36,"ب",1,0],["إذا اِكْتَسى الليلُ من لألائهم ذَهباً","أجرى السّرابَ لُجَيناً فوقَ أرضِهمِ",37,"م",1,0],["إذا أكثر المحموم من هذيانه","فقدم له عون الخبير بشانه",38,"ه",1,1],["إِذا أَكْرَمُ النَّاسِ هابَ النَّوالَ","فنائِلُه لم يَهَبْ أَن يُهَب",39,"ب",1,0]]}