{"poems":[[95,"هنيئا أيها العلم المفدى","https://www.aldiwan.net/poem11306.html","الوافر"],[32,"أمنكر أنت ربع الدار عن عفر","https://www.aldiwan.net/poem29614.html","البسيط"],[29,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[40,"إنا وجدنا العيس خيرا بقية","https://www.aldiwan.net/poem7692.html","الطويل"],[47,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[30,"ألكني إلى قطب الرحا إن لقيته","https://www.aldiwan.net/poem1303.html",""],[60,"وأفضل قسم الله للمرء عقله","https://www.aldiwan.net/poem31177.html","الطويل"],[46,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[35,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[107,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[21,"وميز في إنفاقه بين مصلح","https://www.aldiwan.net/poem36196.html","الطويل"],[52,"إذا أكره الخطي فينا وفيهم","https://www.aldiwan.net/poem62215.html","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54839","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54526","الوافر"],[108,"زعانف إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179677",""],[40,"إنَّا وَجَدْنَاالْعِيسَ خَيْراً بَقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=17303",""],[60,"وأفضل قسم الله للمرءِ عقلهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15496&r=&rc=24",""],[138,"أرقت ودمع العين في العين غائر","https://www.aldiwan.net/poem21007.html","الطويل"],[147,"حاشاك أن تسلب الأيام ما تهب","https://www.aldiwan.net/poem11738.html","البسيط"],[185,"أعنى على برق أريك وميضه","https://www.aldiwan.net/poem58764.html","الطويل"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[190,"يا رب عفوك عن شيخ وذي حنف","https://www.aldiwan.net/poem43615.html","البسيط"],[190,"إذا أكل البصير مع الضرير","https://www.aldiwan.net/poem43806.html","الوافر"],[190,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[199,"نشا مستسرا بين هضب هشيمة","https://www.aldiwan.net/poem54363.html","الطويل"],[234,"ما بال عينك تقوى كلما ضعفت","https://www.aldiwan.net/poem50802.html","البسيط"],[240,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[302,"سلام على بدر له السعد مطلع","https://www.aldiwan.net/poem33228.html","الطويل"],[303,"قفا عللا قبل التفرق عانيا","https://www.aldiwan.net/poem36278.html","عموديه"],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[418,"بكى فرثت له أجبال صبح","https://www.aldiwan.net/poem34.html","الوافر"],[445,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[447,"لقد أكثرت في الترب المراثي","https://www.aldiwan.net/poem14357.html","الوافر"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[466,"وخاطر من حديث المجد ساورني","https://www.aldiwan.net/poem15908.html","البسيط"],[519,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[520,"إذا أكثر المحموم من هذيانه","https://www.aldiwan.net/poem12279.html","الطويل"],[580,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104114","الوافر"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105474","الوافر"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216836","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131402","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35767","الطويل"],[1695,"","https://poetry.dctabudhabi.ae/diwan/poem/144208","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199439","الوافر"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17552","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202595","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100724","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26981","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108091","الطويل"],[3802,"","https://poetry.dctabudhabi.ae/diwan/poem/141078","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59441","الرجز"],[3869,"","https://poetry.dctabudhabi.ae/diwan/poem/34852","الهزج"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119421","المتقارب"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103310","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73204","الطويل"],[4422,"","https://poetry.dctabudhabi.ae/diwan/poem/116623","الوافر"],[4717,"أنوء بقلبٍ أثقلته المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=199866",""],[5018,"أمِنْ حق المودة أن نُقضِّي","https://www.poetsgate.com/ViewPoem.aspx?id=96335",""],[5168,"حجتلي شكد عليك","https://www.poetsgate.com/ViewPoem.aspx?id=33617",""],[5790,"إليكم بكم في حبكم أتوسل","https://www.poetsgate.com/ViewPoem.aspx?id=112105",""],[5804,"آخر أنسأم الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180676",""],[5943,"بناءُ النَّفسِ يلزمه اعتناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=34822",""],[6031,"إلى الملكِ الوهَّابِ ما في يمينِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46259",""],[520,"إذا اكثر المحموم من هذيانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577662",""]],"verses":[["إِذَا أُكْرِمْتَ فَالإِكْرَامُ حَقٌّ","لَهَتيكِ الفَضَائِل وَالعُلُومِ",0,"م",1,0],["إِذا اِكتَسَت عَرَقاً جوناً على عَرَقٍ","يُضحي بِأَعطافِها مِنهُ جَلابيبُ",1,"ب",1,0],["إِذا اكتَحَلَت عَيني بِعَينِكِ مَسَّني","بِخَيرٍ وَجَلّى غَمرَةً عَن فُؤادِيا",2,"ي",2,0],["إذا اكتحلوا بي مُقْبلاً فكأنما","جباهُهُمُ مزويةٌ بالمحاجمِ",3,"م",1,0],["إِذا اِكتَحَلَت بَعدَ اللِقاحِ نُحورُها","بِنَسأٍ حَمَت أَغبارُها وَاِزمَهَرَّتِ",4,"ت",1,0],["إِذا اِكتَسى المَلِكُ الجَبّارُ أُبَّهَةً","غَشّاهُ بِالسَيفِ ثَوبَ الذُلِّ وَالخَمَلِ",5,"ل",1,0],["إِذا اِكتَفَلَت بِالعُرفَتَينِ وَدونَها","بَنو أَسَدٍ لَم يُدرَ مِن أَينَ تُطلَبُ",6,"ب",1,0],["إِذا أَكمَلَ الرَحمَنُ لِلمَرءِ عَقلَهُ","فَقَد كُمُلَت أَخلاقُهُ وَمآرِبُه",7,"ب",2,0],["إِذا أَكدَت سَوامُ الشِعرِ أَضحَت","عَطاياهُ وَهُنَّ لَها مَراعي",8,"ع",2,0],["إِذا اِكتَحَلَت عَيني بِعَينِكِ لَم نَزَل","بِخَيرٍ وَأَجلَت غَمرَةً عَن فُؤادِيا",9,"ي",2,0],["إذا أكل الدهر الرجال أكلته","وإن وأد الآثار أعجزته وأدا",10,"د",2,0],["إِذا اِكتَسَبَ المالَ الفَتى مِن وجوهِهِ","وَأَحسَنَ تَدبيراً لَهُ حينَ يَجمَعُ",11,"ع",1,0],["إِذا أُكرِهَ الخَطِّيُّ فينا وَفيهِمُ","جَرى ماؤُهُ في لامِنا وَتَحَطَّما",12,"م",2,1],["إِذا اِكتَحَلَت عَيني بِعَينِكِ لَم تَزَل","بِخَيرٍ وَجَلَّت غَمرَةً عَن فُؤادِيا",13,"ي",2,0],["إِذَا أَكْرَمَتْ مِصْرُ الْعَزِيزَةُ ضَيْفَهَا","فَهَلْ عَجَبٌ أَنْ يُكْرَمَ الضَّيْفُ فِي مِصْرِ",14,"ر",1,1],["إِذَا أُكْرِمْتَ وَالحَفَلاَتُ شَتَّى","فَذَلِكَ شَكْرُ مِصْرَ وَلا مِرَاءُ",15,"ا",2,0],["إذا اكتنَفَ الزهر الذباب، فإنني","-وإن أنبتَتهُ جنَّةُ الخلد- عائِفُه",16,"ف",2,0],["إذَا اكْتَحَلَتْ بَعْدَ اللِّقَاحِ نُحُورُهَا","بِنَسْءٍ حَمَتْ أغْبَارُهَا وکزْمَهَرَّتِ",17,"ت",1,0],["إِذَا أَكْمَلَ الرَّحْمَانُ لِلْمَرْءِ عَقْلَهُ","فقد كملتْ أخلاقه ومآربه",18,"ب",2,0],["إِذا أَكَلَت يَوماً أَتى الغَدَ مِثلها","زَواهِقُ زُهمٌ أَو مَخاضٌ بَهازِرُ",19,"ر",1,0],["إِذا اِكتَسَت بَارِضَ الرَبعيِّ أَرضُهُمُ","فَليَرقُبوها فَإِنَّ المُلتَقى كَثَبُ",20,"ب",1,0],["إِذا اكتَحَلَت عَينا مُحِبٍّ بِضَوئِهِ","تَجافَت بِهِ حَتَّى الصَّبَاحِ مَضَاجِعُه",21,"ع",2,0],["إِذا أَكثَرَ الكُرهَ المُحَبُّ وَلَم يَكُن","لَهُ عِلَلٌ كادَ المُحَبُّ يَريبُ",22,"ب",1,0],["إذا أكلتُ كسيراتي على سغب","تمرٌ وماءٌ فقد ناهيت في السرفِ",23,"ف",1,0],["إذا أكل البصير مع الضرير","فويل للضرير من البصير",24,"ر",1,1],["إذا أكلوا الخروب جئنا بيانع","من الرطب الآزاذ يلمع كالتبر",25,"ر",1,0],["إِذا اِكتَحَلتَ عَينُ البَصيرَ بِرَأيِهِ","بَداهُ بِذَعرٍ قَبلَ أَن يَتَهَضَّما",26,"م",2,0],["إذا اكتحلت بنومي استيقظت فِطَني","حتى كأني إذا ما نمتُ لم أنم",27,"م",1,0],["إِذا اِكتَحَلَت بِهِ الأَبصارُ أَغضَت","وَفيها مِن مَهابَتِهِ اِنكِسارُ",28,"ر",1,0],["إِذا اِكتحلت عيني بآثار رَبعه","تحدَّر منها أَربعونَ وأَربعُ",29,"ع",1,0],["إذا اكتحلتْ عينُ المحبِّ به يبتْ","ومضجعه عنه إلى الفجرِ نابيا",30,"ي",2,0],["إِذا اِكتَهَلَت وَاِعتَمَّ أَزواجُ نَبتِها","نَما بَعدَهُ بَقلٌ تُؤامٌ وَزاهِرُ",31,"ر",1,0],["إِذا اكتَنَفا بِضَرِّهِما سَقِيم","يُعادِى الدّاء ليس لَهُ مُقِيتُ",32,"ت",1,0],["إذا اكتَحَلَ الجَوُّ كُحْلَ الظَّلامِ","كَحَلْتَ العيونَ بِطولِ السُّهادِ",33,"د",1,0],["إذا اكترثت رجال في المساعي","سعيت فنلت من غير اكتراث",34,"ث",1,0],["إذا أكلَ الدهرُ أعواضَها","من المال عمَّرها سَرمدا",35,"د",2,0],["اذا اكفهرَّ شديدٌ فهو مُبتسمٌ","وفيه عن عَوَراتِ القولِ تقْطيبُ",36,"ب",1,0],["إذا اِكْتَسى الليلُ من لألائهم ذَهباً","أجرى السّرابَ لُجَيناً فوقَ أرضِهمِ",37,"م",1,0],["إذا أكثر المحموم من هذيانه","فقدم له عون الخبير بشانه",38,"ه",1,1],["إِذا أَكْرَمُ النَّاسِ هابَ النَّوالَ","فنائِلُه لم يَهَبْ أَن يُهَب",39,"ب",1,0],["إذا أكلَ الثّرى هذا وهذا","فما فَضلُ الجليلِ على الحقير",40,"ر",1,0],["إذا اكتحلوا فمن نقع المذاكي","أو اختضبوا فمن دم كل شاني",41,"ن",2,0],["إذا أكدت قليب صرنَ منهُ","الى جمّات أحواضٍ ملاء",42,"ا",2,1],["إذا أكلت سمكا وفرضا","ذهبت طولا وذهبت عرضا",43,"ض",2,0],["إذا اكتسب القوم الثراء فإنما","يرى الحمد غنما من كريم المكاسب",44,"ب",1,0],["إِذا اِكتَحَلَت عَينُ اِمرئٍ بِجَمالِها","أَضاءَ لَها مِنهُ جَمالٌ مُزيّفُ",45,"ف",1,0],["إذا أكلت أكلت طيباً","وإن أطعمت أطعمت طيبا",46,"ب",2,0],["إذا اكتفت الرياح بحيث تدعو","بصوب المزن خالقها ابتهالا",47,"ل",2,0],["إِذا أَكمَلَ الرَّحمنُ لِلمَرءِ عَقلَهُ","فَقَد كَمُلَت أَخلاقُهُ وَضَرائِبُه",48,"ب",2,0],["إذا أكملت دوري يحتويني","وإن قصّرت أجّلني لحين",49,"ن",1,0],["اذا اكتهل العام الذي مرَّوا وانقضى","فقد هلَّ عام في حماك وليد",50,"د",1,0],["إِذا أَكَلَ الثَرى هَذا وَهَذا","فَما فَضلُ الكَبيرِ عَلى الحَقيرِ",51,"ر",1,0],["إذا أكرموكم في الحجاز فمن نرى","على قلبه منكم أعزَّ وأكرما",52,"م",2,0],["إذا أكل الطعامَ فمن تُرابٍ","وإن شرب المياهَ فمِنْ مِداد",53,"د",1,0],["إذا اكتَسَبت مُلوك الأرض ذماً","فان الحمدَ قَسمي واكتسابي",54,"ب",2,0],["إِذا أَكرَمَني الناسُ","وَلَم أُرمَ بِإِلمامِ",55,"م",1,0],["إِذا اِكتَحَلَ الساهي الكَرى فَجُفونُهُم","يَنابيعُها يَحلو لَدى فَيضُها الوَردُ",56,"د",1,0],["إذا أكثر الناس شيم الغمام","فلا شمت في الأرض إلا كثيرا",57,"ر",2,0],["إذا أكدى الربيعُ فأيُّ بحرٍ","يؤمَّلُ للحيا بعد الربيع",58,"ع",1,0],["إذا اكتحلت منَّا العيونُ بحُسنِكم","تجلَّت بما من نُوركم تتكحَّلُ",59,"ل",1,0],["إِذا اكتَنَفا بِضَرِّهِما سَقِيماً","يُعادِى الدّاء ليس لَهُ مُقِيتُ",60,"ت",1,0],["إِذَا اكْتْسَبَ الْمَرْءُ الْمَعِيشةَ بِالْأَذَى","فَسُحْقَاً لِعَيْشٍ يَقْتَفِيه الْمُخادِع",61,"ع",1,0],["إذا أكرمتكم وأهنتموني","ولم أغضبْ لِذَلِكُمُ فدامَا",62,"م",2,0],["إذا اكدر أحاذر منك اليوم","كلي شكثر اكدر عنك اصبر؟",63,"ر",1,0],["إذا اكتحلت منا الجفون بحسنكم","تجلت بما من نوركم تتكحل",64,"ل",1,0],["إذا اكتربَ المحزونُ هوّنَ كربَهُ","فحلَّت عليهِ سلوةٌ وابتسامُ",65,"م",1,0],["إذا أُكْرِمتَ في عيشٍ رغيدٍ","وشاءَ اللهُ شيئًا قد تشاءُ",66,"ا",2,0],["إذا اكتنفتهُ النائباتُ نَكَصْنَ عن","نَهوضٍ بأَعْباءِ الخُطُوبِ حَمُولِ",67,"ل",1,0],["إذا أكثر المحموم من هذيانه","فقدم له عذر الخبير بشانه",68,"ه",1,1]]}