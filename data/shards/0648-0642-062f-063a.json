يم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[381,"الحمد لله الذي حمده","https://www.aldiwan.net/poem48751.html","السريع"],[381,"لمن طلل بالجزع قفر جوانبه","https://www.aldiwan.net/poem48837.html","الطويل"],[403,"ثق بالذي صير دون الورى","https://www.aldiwan.net/poem46930.html","السريع"],[410,"ماذا يروعك من وجدي ومن قلقي","https://www.aldiwan.net/poem32420.html","البسيط"],[417,"أبا مصطفى إنا ذكرناك بيننا","https://www.aldiwan.net/poem53893.html","الطويل"],[417,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[417,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[417,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[433,"أبا حسن أحسنت بدءا وعودة","https://www.aldiwan.net/poem12322.html","الطويل"],[433,"هل من رفيق رفيق","https://www.aldiwan.net/poem12680.html","المجتث"],[433,"بعينيه شكري لا بكأس عقاره","https://www.aldiwan.net/poem12787.html","الطويل"],[438,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[440,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[442,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[454,"تبارك الله هل كافور فنان","https://www.aldiwan.net/poem61601.html","البسيط"],[459,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[459,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[469,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[483,"عج ساحل الدير سل عنها الشماميسا","https://www.aldiwan.net/poem24427.html","عموديه"],[491,"منا مُسافٍ يُسافي الناس ما يسروا","https://www.aldiwan.net/poem661.html",""],[501,"أفيضوا لنا يا أهل أم عبيدة","https://www.aldiwan.net/poem38012.html","الطويل"],[530,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[552,"قل للألى أطمعوني في وصالهم","https://www.aldiwan.net/poem47743.html","البسيط"],[552,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[552,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem47855.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"تذكرت صفو زمان عبر","https://www.aldiwan.net/poem52831.html","المتقارب"],[568,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[576,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[587,"أراك الحمى لما شدته السواجع","https://www.aldiwan.net/poem17584.html","الطويل"],[588,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[588,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[588,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["وَقَد غارَ حَظٌّ أَنتَ ثاني جِماحِهِ","وَتُقدَعُ مِن بَعدِ الجِماحِ الشَوامِسُ",0,"س",1,0],["وَقَد غَفَلَ الواشي وَلَم يَدرِ أَنَّني","أَخَذتُ لِعَيني مِن سُلَيمى نَصيبَها",1,"ب",3,0],["وَقَد غَرِضَ الخُلّانُ مِنّي فَلامَني","صِحابيَ حَتَّى الحِمَيريّ لَحاني",2,"ن",2,0],["وقد غَرِيَتْ بالبُعْدِ حتّى بودّها","وبالبُخْلِ حتى بالخَيالِ الذي يَسْري",3,"ر",2,0],["وَقَد غَنّى عَلى الأَغصانِ طَيرٌ","بِصَوتِ حَنينِهِ يَشفي الغَليلا",4,"ل",2,0],["وَقَد غَنيتُ زَماناً لا أَظُنُّكُمُ","مِمَن يُصدِّقُ فينا قَولَ ذي حَسَدِ",5,"د",1,0],["وقد غصَّ منْ وُسْعِ السّبيكَةِ وُسْعُها","وجرَّ بِها أذْيالَهُ العَسْكُرُ المَجْرُ",6,"ر",1,0],["وَقَد غَرَّها مِنّي عَلى الشَيبِ وَالبِلى","جُنوني بِها جُنَّت حِيالي وَخُنَّتِ",7,"ت",1,0],["وَقَد غَنوا في ظِلالِ مُلكٍ","مُؤَيَّدٍ عَقلُهُم جُفارُ",8,"ر",1,0],["وَقَد غَدَوتُ إِلى الحانوتِ يَتبَعُني","شاوٍ مِشَلٌّ شَلولٌ شُلشُلٌ شَوِلُ",9,"ل",1,0],["وَقَد غَدَوتُ وَآمالي مُطَرَّحَةٌ","وَفي أُمورِيَ ما لِلضَبِّ في الذَنَبِ",10,"ب",1,0],["وَقَد غَيَّبَت سُمراً كَأَنَّ حُروفَها","مَواثِمُ وَضّاحٍ يَطيرُ جَريمُها",11,"م",3,0],["وَقَد غادَرَت في السَيرِ ناقَةُ صاحِبي","طَلاً مَوَّتَت أَوصالَهُ فَهوَ يَشهَقُ",12,"ق",1,0],["وقد غَشَّى قضاعة ثوب خِزْي","بقتل أبي سَلامَان بن سَعْدِ",13,"د",1,0],["وقد غَادَروا فِينَا مَصَابِيحَ أنجُماً","لنا ثِقَةً أيّانَ نخشَى وَنَرهَبُ",14,"ب",1,0],["وَقَد غَدَوتُ عَلى الحانوتِ يَصبَحُني","مِن عاتِقٍ مِثلِ عَينِ الديكِ شَعشاعِ",15,"ع",1,0],["وَقَد غادَرَت تَحتَ العَجاجَةِ مُسنَداً","أُبَيّاً وَقَد بَلَّ القَميصَ نَجيعُ",16,"ع",1,0],["وقد غدا يشكُرُ نُعماكُمُ","في كلِّ وادٍ موجِزاً مطنبا",17,"ب",2,0],["وقد غُفِرتْ للدهرِ كلُّ جريمةٍ","تُعدُّ له من سيِّئات الجرائمِ",18,"م",1,0],["وَقَد غَبَرَ العَجلانُ حيناً إِذا بَكى","عَلى الزادِ أَلقَتهُ الوَليدَةُ بِالكِسرِ",19,"ر",1,0],["وَقَد غابَتِ الشِعرى العَبورُ وَقارَبَت","لِتَنزِلَ وَالشِعرى بَطيءٌ نُزولُها",20,"ل",3,0],["وَقَد غَدَوتُ عَلى قِرني يُشَيِّعُني","ماضٍ أَخو ثِقَةٍ بِالخَيرِ مَوسومُ",21,"م",1,0],["وَقَد غَشِي المَنارُ البَحرَ نوراً","كَنارِ الطورِ جَلَّلَتِ الشِعابا",22,"ب",2,0],["وقد غُمَّ نَهْجُ العُلَى بعدَهُ","وقد لَحِبَ المنهجُ المَهْيَعُ",23,"ع",1,0],["وقد غَفلتْ عينُ الرقيبِ ومُقلتِي","بلا حَذَرٍ في عارضيكَ تَرودُ",24,"د",1,0],["وَقَد غَلُظَت دونَ النَجاةِ الَّتي اِبتَغى","رِقابُ رِجالٍ دونَ ما مَنَعَت غُلبُ",25,"ب",1,0],["وَقَد غُصِبوا مُلكاً ثَمانينَ حِجَّةً","وَمَجدُهُمُ يُعيِي يَدَي كُلِّ غاصِبِ",26,"ب",1,0],["وَقَد غَدَت ضَيعَتي مُنَوَّطَةً","بِحَيثُ نيطَت لِلناظِرِ الزُهَرَه",27,"ر",2,0],["وَقَد غَنِيَت أَرضُ الجِبالِ فَما يُرى","يَمانٍ بِها إِلّا هُمُ وَالمَناصِلُ",28,"ل",1,0],["وقد غرسَتْ يمينُك منه غَرْساً","فصُنْهُ أن يُلِمَّ به شُحوبُ",29,"ب",1,0],["وَقَد غادَرتَ كَبشَهُمُ جِهاراً","بِحَمدِ اللَهِ طَلحَةَ في الضَلالِ",30,"ل",1,0],["وَقَد غَنّى الحُسامُ يَصِلُّ قَرعاً","وَأَفضى بِالعَدُوِّ إِلى النَحيبِ",31,"ب",1,0],["وَقَد غَشِيَ النَبتُ بَطحاءَهُ","كَبَدوِ العِذارِ بِخَدٍّ أَسيلِ",32,"ل",1,1],["وقد غَضِبَتْ للدّينِ باسطَ كَفّهِ","إليهِنّ في الآفاقِ كالمُتَظَلِّم",33,"م",1,0],["وقد غَصّتِ البَيْداءُ بالعِيسِ فوقَها","كرائِمُ أبناءِ النّبيّ المكَرَّم",33,"م",1,0],["وَقَد غابَتِ الشِعرى العَبورُ وَأَقبَلَت","نُجومُ الثُرَيّا بِالصَباحِ تَثوبُ",34,"ب",1,0],["وَقَد غَلَبَ الأَحياءَ في كُلِّ وُجهَةٍ","هَواهُم وَإِن كانوا غَطارِفَةً غُلبا",35,"ب",2,0],["وَقَد غَيَّرَ مَعناها","أَذىً يَأتي أَراعيلا",36,"ل",2,0],["وَقَد غابَت نُجومُ الهَديِ عَنّا","فَماجَ الناسُ الناسُ في ظُلَمٍ دَمَسنَه",37,"ن",2,0],["وقد غالت الإخوان إلا أقلهم","كأنهمُ ما ساعدوني ولا سروا",38,"ر",3,0],["وقد غَرِضْتُ من الدّنيا فهَلْ زَمَني","مُعْطٍ حَيَاتي لِغِرٍّ بَعْدُ ما غَرِضا",39,"ض",2,0],["وَقَد غَبَرَت شَهرَي رَبيعٍ كِلَيهِما","بِحَملِ البَلايا وَالحِباءِ المُمَدَّدِ",40,"د",1,0],["وَقَد غَرَّها مِنّي عَلى الشَيبِ وَالبِلى","جُنوني بِها جنَّت حِيالي وَحنَّتِ",41,"ت",1,0],["وقد غص من وسغ السبيكة وسعها","وجر بها أذياله العسكر المجر",42,"ر",1,0],["وقد غَمزت عُودَه النائباتُ","فلم تجد الضارعَ المستكينا",43,"ن",2,0],["وَقَد غَصَّ بِالجَيشِ ذاكَ الفَضا","فَضاقَ عَلى الخائِفِ المُنهَزِم",44,"م",1,0],["وَقَد غَمَرتَ اِبنَ حَسّانٍ بِفَيضِ نَدىً","ما شَكَّ في الفَوزِ راجيهِ وَلا وَهِما",45,"م",2,0],["وقد غضبت للسيف قومٌ وظاهروا","فقلنا لهم كفّوا فسادتكم مِنّا",46,"ن",2,0],["وَقَد غَرَّرتهُم مِن نِزارٍ وَيَعرُبٍ","لِشَنآنِكُم قَومٌ وَقَومٌ تَبَرُّما",47,"م",2,0],["وَقَد غَفَلَتْ عَنا الخطوبَ بِلَيلِها","وَقَدماً عَهِدنا حادثَ الدَّهرِ أَرودا",48,"د",2,0],["وقد غادرَتْها حدودُ المُدَى","كما غادر الصبرُ قَلْبا مُحِبّ",49,"ب",1,0],["وَقد غابَ عنّي خمسَ عشرة حجّةً","وَعادَ ولَم يَزدَد شعوراً ولا شعرا",50,"ر",2,0],["وقد غنَّى الحليُّ على طلاها","بوسواسٍ فجاوبَهُ الوشاح",51,"ح",1,0],["وقد غادرتْني النوى بعدهُ","إذا وصفوا لي النوى أجزعُ",52,"ع",1,0],["وقد غدا السعد لها ناظراً","لما بدا الطالع فيها القمر",53,"ر",1,0],["وقد غَرَبتْ منه سعودٌ وأشرقَتْ","عليه نجومٌ تحتويها نحوسُ",54,"س",1,0],["وَقَد غادَرَتني صُروفُ الزَمانِ","لَديكَ جَريحاً وَلَم يُجهَزِ",55,"ز",1,0],["وَقَد غَرَّ أَبنائَهُ أَنَّني","ضَحِكتُ وَما ضَحِكي مِن عَجَب",56,"ب",1,0],["وَقَد غَشيتَ لَها أَطلالَ مَنزِلَةٍ","قَصراً بِرامَةَ وَالوادي وَلَم تَصِفِ",57,"ف",1,0],["وَقَد غَرسَ القَضيبَ عَلى كَثيبٍ","فَأَثمَرَ بِالظَلامِ وَبِالصَباحِ",58,"ح",1,0],["وقد غمزوا مع العيدان عودي","ليختبروا الصحيح من المريب",59,"ب",1,1],["وقد غص جفني بالدماء كأنه","إناء مدام في أكف سقاته",60,"ت",2,0],["وقد غلب الهوى جلدي وصبري","وباح بصبوتي دمع هتون",61,"ن",1,0],["وَقَدْ غادَرَ الْقَطْرُ مِنْ فَيْضِهِ","غَدِيراً هُوَ السَّيْلُ حَلَّ الْبِطاحا",62,"ح",2,0],["وَقَدْ غَدَوْتُ بِعِزِّ الدِّينِ مُعْتَصِماً","إِنَّ الْكِرامَ عَلَى الأَيّامِ أَنْصارِي",63,"ر",2,0],["وَقَد غادَرَ السَيلُ فيها غَديراً","يَروقُ العُيونَ وَيَجلو قَذاها",64,"ا",3,0],["وَقَد غَصَّ السِوارُ فَعَضَّ زنداً","لَها مَن لي بِتَقبيلِ السِوارِ",65,"ر",1,0],["وقد غصين البان يحكي اعتداله","ووجه كبدر التم تحت ظلام",66,"م",1,0],["وَقَد غَذاها صَريفُ المَحضِ تَشرَبُهُ","وَقارِصٌ وَالَّذي مِن دونِهِ الخَصَفُ",67,"ف",1,0],["وقد غاب آدم يجنى لها","من الأرض أثمارها الباكره",68,"ر",2,0],["وَقَد غَدوت أَمامَ الحيِّ يحمِلني","نَهدُ المَراكِلِ في أَقرابِه بَلَقُ",69,"ق",1,0],["وقد غرَّهم وعدٌ وما من نتيجةٍ","وعنهم إله العرش قد كشف السترا",70,"ر",2,0],["وَقَد غِبتُ مِن فَرطِ السُرورِ بِقُربِهِ","كَأَنّي ما أَلقاهُ لَيلَةَ أَلقاهُ",71,"ا",2,0],["وقد غدا عارياً ندمانَ ذا أسفٍ","من ذنبه جزعاً عن عفوه قَنِطا",72,"ط",2,0],["وقد غدت في عصرنا المُعاشره","محاوراتٍ كلّها مهاتره",73,"ه",1,0],["وَقَد غَدا مِن خَجَل دُونِها","يَعثر بِالأَذيالِ جاري النَسيم",74,"م",1,0],["وَقَد غَربت أَكوارَها في غَوارب","تَسيل نَجيعاً وَالسُنوع مَساربه",75,"ب",2,0],["وقَد غَدا غَايةُ مَطْلوبهمْ","أن تغفرَ الذنبَ وأنْ ترضى",76,"ض",2,0],["وقد غَرضْتُ بِعيشي من مُفَارَقتي","أغَرَّ أروعَ طَلقَ الرّاحتينِ تَقي",77,"ق",2,0],["وقد غَرَّدَتْ من فوقهن حمائمٌ","لها أَنَّةُ المأْلوم من ألَم الهجر",78,"ر",1,0],["وقد غنَّت فأعرَبَتِ الأغاني","عن اللّذات من نايٍ وعود",79,"د",1,0],["وقد غلبت لشقوتنا علينا","وكاد الغيُّ يمكر بالرشاد",80,"د",1,0],["وقد غارت نجوم الصبح لمَّا","رأته وهو قد كشفَ النقابا",81,"ب",2,0],["وقد غَيَّبَتْنِي عَنْ عُلاكَ عوارِضٌ","رَمَتْنِي بسهمٍ للخطوبِ أَصابا",82,"ب",2,0],["وقد غلا السعرَ والشعْ","رُ حلّ أكسدَ سُوقِ",83,"ق",1,0],["وقد غَنيتْ أعطافُهُ عن رِماحِه","كما غنِيَتْ أشْفارُهُ عن شِفارِه",84,"ر",2,0],["وقد غدت دوني الأبواب مرتجة","والأرض تضرب في وجهي بأسداد",85,"د",1,0],["وَقَدْ غَدَوْتَ لآمالِ الوَرى أَمَداً","وَقَدْ غَدَوْتَ لأَفلاكِ العُلا قُطُبا",86,"ب",2,0],["وقد غفلوا الروايات الَّتي عن","محمد والَّذي عَنهُ رواها",87,"ا",3,0],["وقد غدا النثرُ عبداً في تملقهِ","والشعرُ هانَ له أضعاف من هانوا",88,"ن",3,0],["وقد غرَّه أن يُعمِلَ الحزمَ سابقاً","على الكيد أن ليس الذئابُ هُناكا",89,"ك",2,0],["وقد غرّني ليلُ الشباب فأين بي","أضلَّ وفجرُ الشيب عُريانُ مصبِحُ",90,"ح",1,0],["وقد غاض بحرٌ كان فكرك مدَّه","وأُرتجَ بابٌ كان في فيك يُفتَحُ",90,"ح",1,0],["وقد غَلَب الطَّالِينَ عَرُّ جلودها","وفاتت أكفَّ المُلحِمينَ نُقُوبُها",91,"ب",3,0],["وَقَد غابَ عَنّا الهَمُّ حَتّى كَأَنَّما الزَما","نُ لَنا مِمّا حَبانا بِهِ عَبدُ",92,"د",1,0],["وقد غدا سر ذاك الظل يخبرني","عن آدم العين للأسما وإبليسا",93,"س",2,0],["وَقَد غَدَوتُ أَمامَ الحَيِّ يَحمِلُني","وَالفَضلَتَينِ وَسَعيي مُحنِقٌ شَسِف",94,"ف",1,0],["وقد غَلَبَتْنا الصَّادِعاتُ من الهَوَى","وَوجْداً ذَهِلْنا فارْحَموا واقْبَلوا العُذْرا",95,"ر",2,0],["وقَدْ غَدَتْ مُؤَيَّدَهْ","بالعِتْرَةِ الْمُشَيِّدَه",96,"ه",1,0],["وقد غُرِرْتُ بهمْ دهراً بلا سببٍ","وأغبنُ النّاسِ مَن يغترّ بالنّاسِ",97,"س",1,0],["وقد غرستُ غُروساً غيرَ مثمرةٍ","وعاد بالكدِّ من لم يَحظَ بالثَّمَرِ",98,"ر",1,0],["وَقد غاضَ سخطاناً فَهل من صبابةٍ","برأيك إنّي قد تصرّم ما عندِي",99,"د",2,0],["وقد غسلوا أقدامهم في قيامهم","بخدمته عن كل ما هو مانع",100,"ع",1,0],["وقد غاصَ في أبحر الشِّعرِ مُنذُ","صِباهُ يريدُ التِقاطَ الدُرَرْ",101,"ر",1,0],["وَقَدْ غَنِيْتُ وَأَشْغَالِي تُبِيِّنُ مِنْ","فَضْلِي فَقَدْ سَتَرَتْهُ هَذِه العُطْلَهْ",102,"ل",2,0],["وقدْ غار مِنْه عَلى أَنَّنِي","وغيْرِيَ مِنْ قبْله أَغْيَر",103,"ر",1,0],["وَقَدْ غَابَ وَاشِينا وَنامَ رَقِيبُنا","وَقَدْ صَدَقَتْنَا بِاللّقاءِ المَطالِعُ",104,"ع",1,0],["وقد غردت أطيارها برياضها","يرجعن ألحان الغواني تهانيا",105,"ي",2,0],["وقد غودرا في فيضة السر جثما","طعام سباع والنسور الحوائم",106,"م",1,0],["وقد غادروا أبناء حائل في الوغى","جثاثاً ركاماً كالهشيم لشائم",107,"م",1,0]]}