{"poems":[[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[63,"وهيفاء لا أصغي إلى من يلومني","https://www.aldiwan.net/poem45798.html","الطويل"],[63,"لحاني هذيم صاحبي ليلة النقا","https://www.aldiwan.net/poem45812.html","الطويل"],[63,"تراءت لنا والبدر وهنا على قدر","https://www.aldiwan.net/poem46189.html","الطويل"],[3,"إذا ريح الصبا هبت أصيل","https://www.aldiwan.net/poem186.html",""],[55,"إني لأحسب والأقدار غالبة","https://www.aldiwan.net/poem26409.html","البسيط"],[77,"بحيث القباب البيض والأسل السمر","https://www.aldiwan.net/poem36489.html","الطويل"],[42,"تعاتبني عرسي على أن أطيعها","https://www.aldiwan.net/poem50365.html","الطويل"],[9,"ألم تروا إرما وعادا","https://www.aldiwan.net/poem21934.html","مجزوء البسيط"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[86,"ماذا أصبت من الأسفار والنصب","https://www.aldiwan.net/poem10508.html","البسيط"],[35,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[37,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[23,"بانت لميس بحبل منك أقطاع","https://www.aldiwan.net/poem21416.html","البسيط"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[29,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[62,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[62,"تمنى رجال ما أرادوا وإنما","https://www.aldiwan.net/poem52441.html","الطويل"],[45,"قليل لها أني بها مغرم صب","https://www.aldiwan.net/poem10656.html","الطويل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[45,"قل للوزير الذي مناقبه","https://www.aldiwan.net/poem63613.html","المنسرح"],[45,"نوائب دهر أيهن أنازل","https://www.aldiwan.net/poem65620.html","الطويل"],[61,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[58,"رأيت المشركين بغوا علينا","https://www.aldiwan.net/poem30914.html","الوافر"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[74,"وقد غشي النبت بطحاءه","https://www.aldiwan.net/poem13216.html","المتقارب"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"دع الربع ما للربع فيك نصيب","https://www.aldiwan.net/poem10774.html","الطويل"],[46,"رأيت قضاء الله أوجب خلقه","https://www.aldiwan.net/poem22113.html","الطويل"],[46,"أيا شيعة إسماعي","https://www.aldiwan.net/poem23181.html","الهزج"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16651","البسيط"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2242","الطويل"],[42,"","https://poetry.dctabudhabi.ae/diwan/poem/22693","الطويل"],[77,"بحيث القباب البيض والأسل السمر","https://www.poetsgate.com/ViewPoem.aspx?id=34138",""]],"verses":[["وَقَد غارَ حَظٌّ أَنتَ ثاني جِماحِهِ","وَتُقدَعُ مِن بَعدِ الجِماحِ الشَوامِسُ",0,"س",1,0],["وَقَد غَفَلَ الواشي وَلَم يَدرِ أَنَّني","أَخَذتُ لِعَيني مِن سُلَيمى نَصيبَها",1,"ب",3,0],["وَقَد غَرِضَ الخُلّانُ مِنّي فَلامَني","صِحابيَ حَتَّى الحِمَيريّ لَحاني",2,"ن",2,0],["وقد غَرِيَتْ بالبُعْدِ حتّى بودّها","وبالبُخْلِ حتى بالخَيالِ الذي يَسْري",3,"ر",2,0],["وَقَد غَنّى عَلى الأَغصانِ طَيرٌ","بِصَوتِ حَنينِهِ يَشفي الغَليلا",4,"ل",2,0],["وَقَد غَنيتُ زَماناً لا أَظُنُّكُمُ","مِمَن يُصدِّقُ فينا قَولَ ذي حَسَدِ",5,"د",1,0],["وقد غصَّ منْ وُسْعِ السّبيكَةِ وُسْعُها","وجرَّ بِها أذْيالَهُ العَسْكُرُ المَجْرُ",6,"ر",1,0],["وَقَد غَرَّها مِنّي عَلى الشَيبِ وَالبِلى","جُنوني بِها جُنَّت حِيالي وَخُنَّتِ",7,"ت",1,0],["وَقَد غَنوا في ظِلالِ مُلكٍ","مُؤَيَّدٍ عَقلُهُم جُفارُ",8,"ر",1,0],["وَقَد غَدَوتُ إِلى الحانوتِ يَتبَعُني","شاوٍ مِشَلٌّ شَلولٌ شُلشُلٌ شَوِلُ",9,"ل",1,0],["وَقَد غَدَوتُ وَآمالي مُطَرَّحَةٌ","وَفي أُمورِيَ ما لِلضَبِّ في الذَنَبِ",10,"ب",1,0],["وَقَد غَيَّبَت سُمراً كَأَنَّ حُروفَها","مَواثِمُ وَضّاحٍ يَطيرُ جَريمُها",11,"م",3,0],["وَقَد غادَرَت في السَيرِ ناقَةُ صاحِبي","طَلاً مَوَّتَت أَوصالَهُ فَهوَ يَشهَقُ",12,"ق",1,0],["وقد غَشَّى قضاعة ثوب خِزْي","بقتل أبي سَلامَان بن سَعْدِ",13,"د",1,0],["وقد غَادَروا فِينَا مَصَابِيحَ أنجُماً","لنا ثِقَةً أيّانَ نخشَى وَنَرهَبُ",14,"ب",1,0],["وَقَد غَدَوتُ عَلى الحانوتِ يَصبَحُني","مِن عاتِقٍ مِثلِ عَينِ الديكِ شَعشاعِ",15,"ع",1,0],["وَقَد غادَرَت تَحتَ العَجاجَةِ مُسنَداً","أُبَيّاً وَقَد بَلَّ القَميصَ نَجيعُ",16,"ع",1,0],["وقد غدا يشكُرُ نُعماكُمُ","في كلِّ وادٍ موجِزاً مطنبا",17,"ب",2,0],["وقد غُفِرتْ للدهرِ كلُّ جريمةٍ","تُعدُّ له من سيِّئات الجرائمِ",18,"م",1,0],["وَقَد غَبَرَ العَجلانُ حيناً إِذا بَكى","عَلى الزادِ أَلقَتهُ الوَليدَةُ بِالكِسرِ",19,"ر",1,0],["وَقَد غابَتِ الشِعرى العَبورُ وَقارَبَت","لِتَنزِلَ وَالشِعرى بَطيءٌ نُزولُها",20,"ل",3,0],["وَقَد غَدَوتُ عَلى قِرني يُشَيِّعُني","ماضٍ أَخو ثِقَةٍ بِالخَيرِ مَوسومُ",21,"م",1,0],["وَقَد غَشِي المَنارُ البَحرَ نوراً","كَنارِ الطورِ جَلَّلَتِ الشِعابا",22,"ب",2,0],["وقد غُمَّ نَهْجُ العُلَى بعدَهُ","وقد لَحِبَ المنهجُ المَهْيَعُ",23,"ع",1,0],["وقد غَفلتْ عينُ الرقيبِ ومُقلتِي","بلا حَذَرٍ في عارضيكَ تَرودُ",24,"د",1,0],["وَقَد غَلُظَت دونَ النَجاةِ الَّتي اِبتَغى","رِقابُ رِجالٍ دونَ ما مَنَعَت غُلبُ",25,"ب",1,0],["وَقَد غُصِبوا مُلكاً ثَمانينَ حِجَّةً","وَمَجدُهُمُ يُعيِي يَدَي كُلِّ غاصِبِ",26,"ب",1,0],["وَقَد غَدَت ضَيعَتي مُنَوَّطَةً","بِحَيثُ نيطَت لِلناظِرِ الزُهَرَه",27,"ر",2,0],["وَقَد غَنِيَت أَرضُ الجِبالِ فَما يُرى","يَمانٍ بِها إِلّا هُمُ وَالمَناصِلُ",28,"ل",1,0],["وقد غرسَتْ يمينُك منه غَرْساً","فصُنْهُ أن يُلِمَّ به شُحوبُ",29,"ب",1,0],["وَقَد غادَرتَ كَبشَهُمُ جِهاراً","بِحَمدِ اللَهِ طَلحَةَ في الضَلالِ",30,"ل",1,0],["وَقَد غَنّى الحُسامُ يَصِلُّ قَرعاً","وَأَفضى بِالعَدُوِّ إِلى النَحيبِ",31,"ب",1,0],["وَقَد غَشِيَ النَبتُ بَطحاءَهُ","كَبَدوِ العِذارِ بِخَدٍّ أَسيلِ",32,"ل",1,1],["وقد غَضِبَتْ للدّينِ باسطَ كَفّهِ","إليهِنّ في الآفاقِ كالمُتَظَلِّم",33,"م",1,0],["وقد غَصّتِ البَيْداءُ بالعِيسِ فوقَها","كرائِمُ أبناءِ النّبيّ المكَرَّم",33,"م",1,0],["وَقَد غابَتِ الشِعرى العَبورُ وَأَقبَلَت","نُجومُ الثُرَيّا بِالصَباحِ تَثوبُ",34,"ب",1,0],["وَقَد غَلَبَ الأَحياءَ في كُلِّ وُجهَةٍ","هَواهُم وَإِن كانوا غَطارِفَةً غُلبا",35,"ب",2,0],["وَقَد غَيَّرَ مَعناها","أَذىً يَأتي أَراعيلا",36,"ل",2,0],["وَقَد غابَت نُجومُ الهَديِ عَنّا","فَماجَ الناسُ الناسُ في ظُلَمٍ دَمَسنَه",37,"ن",2,0],["وقد غالت الإخوان إلا أقلهم","كأنهمُ ما ساعدوني ولا سروا",38,"ر",3,0],["وقد غَرِضْتُ من الدّنيا فهَلْ زَمَني","مُعْطٍ حَيَاتي لِغِرٍّ بَعْدُ ما غَرِضا",39,"ض",2,0],["وَقَد غَبَرَت شَهرَي رَبيعٍ كِلَيهِما","بِحَملِ البَلايا وَالحِباءِ المُمَدَّدِ",40,"د",1,0],["وَقَد غَرَّها مِنّي عَلى الشَيبِ وَالبِلى","جُنوني بِها جنَّت حِيالي وَحنَّتِ",41,"ت",1,0],["وقد غص من وسغ السبيكة وسعها","وجر بها أذياله العسكر المجر",42,"ر",1,0]]}