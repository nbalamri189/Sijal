"إن كان غيري بها في الحب منعشا",243,"ش",2,0],["وقد غرست أيدي المودة بيننا","هوى في صميم النفس صدقٌ تبادله",244,"ل",2,0],["وقد غدت المدارس في حمانا","دوارس كالحظائر والزراب",245,"ب",1,0],["وقد غدت الضرائب كل يومٍ","تروعنا بأنواع العذاب",245,"ب",1,0],["وقد غدا تاريخه","لكل خير جامعا",246,"ع",2,0],["وقد غادرتني كذي نشوة","تعاطيه من يدها كاسها",247,"س",3,0],["وقد غرّتهم الدنيا","وقد نَصبت لهم فخَّا",248,"خ",2,0],["وقد غاب عنهم أن من ظل يفتري","ستلقيه في وادي الهلاك الزوابع",249,"ع",1,0],["وقد غشانا على طول النوى أمل","أن نلتقي والغيوم السود تنقشع",250,"ع",1,0],["وقد غاب عن الواشي","ن سرا بيننا حاضر",251,"ر",1,0],["وقد غادروا أطفالهم طول ليلهم","لهم ضجة تعلو وأصواتهم تبد",252,"د",1,0],["وقد غاض هذا القدم ما قال جهراً","فلله ما أبدى وما قاله جهرا",253,"ر",2,0],["وقد غره ما قد جلوا من ملاحة","بتنميق ألفاظ بمدحة من سما",254,"م",2,0],["وقد غادرت أبناء أحمد صرعا","بضاحية الرمضاء تحكي الأضاحيا",255,"ي",2,0],["وقد غالت الأقدار شخصك في الوغى","صريعا وداست من حفاظك أغيالا",256,"ل",2,0],["وقد غدت الدقائقُ نابضاتٍ","بأحرفَ ليس يفهمها النحاةُ",257,"ه",1,0],["وَقَدْ غَدَوْا جَزَراً فِي كُلِّ مُقْفِرَةٍ","تَظَلُّ تَنْتاشُهُمْ خُمْعٌ وَذُؤْبانُ",258,"ن",1,0],["وَقَدْ غَدَوْا كَسَراحِينِ الوَغَى وَهُمُ","مَآدِبٌ حَوْلَها تأْوِي السَّراحِينُ",259,"ن",1,0],["وقد غبت عني كأن لم أكن","سوى نفحة سمحة عاليه",260,"ي",2,0],["وقد غدا ساحبا ذوائبه","تعلق الظبى في حبائله",261,"ل",2,0],["وقد غرَّني قلبي وآثرَ حبَّها","فأسلمني للوجدِ، والأمرُ جائرُ",262,"ر",1,0],["وقد غالني الدهر والحادثات","وضاق الزمان وثم القضا",263,"ا",1,0],["وقد غاب سبعين عاما وما","يزيد عليها فلا يحتسب",264,"ب",1,0],["وقَدْ غِبْتُ عَنْكَ وهَذَا لِقَائِي","بِمَا يَقْتَضِيْهِ حُقُوْقُ الإِخَاءِ",265,"ا",1,0],["وَقَدْ غَشِيتْ مِنَ المَوْتِ الطِّلالاَ","مَضَى لِسَبِيلِهِ مَنْ كُنْتَ تَرْجُو",266,"و",1,0]]}