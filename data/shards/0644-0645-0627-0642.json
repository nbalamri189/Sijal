?id=176948",""],[5533,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=177718",""],[5612,"يا رَبّْ","https://www.poetsgate.com/ViewPoem.aspx?id=180615",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5790,"لله در أناملٍ شرفت","https://www.poetsgate.com/ViewPoem.aspx?id=112050",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5829,"ذكره العطر","https://www.poetsgate.com/ViewPoem.aspx?id=213703",""],[5956,"أُعاتب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183227",""],[5956,"ما دام خالد هانئاً","https://www.poetsgate.com/ViewPoem.aspx?id=193696",""],[6062,"وعد","https://www.poetsgate.com/ViewPoem.aspx?id=176606",""],[6089,"العتب لي","https://www.poetsgate.com/ViewPoem.aspx?id=214045",""],[6108,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=192389",""],[6127,"مررْتَ كالطّيف","https://www.poetsgate.com/ViewPoem.aspx?id=198350",""],[6152,"أمطار مكة المكرمة","https://www.poetsgate.com/ViewPoem.aspx?id=204736",""],[6165,"نشيد الألواح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87256&r=&rc=16",""],[6260,"وعد بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68317&r=&rc=10",""]],"verses":[["لَما قَدَحتُ بِنارِ الوَجدِ في كَبِدي","وَلا بَلَلتُ بِماءِ الدَمعِ أَجفاني",0,"ن",2,0],["لَم أَقضِ مِنكِ لُباناتٍ ظَفِرتُ بِها","فَهَل لِيَ اليَومَ إِلّا زَفرَةُ النَدَمِ",1,"م",1,0],["لَم أُقارِف ذَنباً فَأَستَغفِرَ اللَ","هَ وَقَد أَظهَرَ الجَفاءَ الخَليلُ",2,"ل",1,0],["لِما قَد تَعَفّى مِن رَمادٍ وَعَرصَةٍ","بَكَيتُ وَهَل يَبكي إِلَيكَ مُحيلُها",3,"ل",3,0],["لَم أَقضِ حَقَّ بِلادي","وَها أَنا قَد قَضَيتُ",4,"ت",1,0],["لَم أَقِف مَوقِفي لِأُنشِدَ شِعراً","صُبَّ في قالَبٍ بَديعِ النِظامِ",5,"م",1,0],["لَم أَقضِ مِن حَقِّ المُدامِ وَلَم أَقُم","في الشارِبينَ بِواجِبِ الأَقداحِ",6,"ح",1,0],["لما قصدت لها مراسِيَ سبتةٍ","عطفت على الأسوار عطف سوارِ",7,"ر",1,0],["لَم أَقِل إِلّا عَلَيهِ أَو عَلى","مَرقَبٍ يَفرَعُ أَطرافَ الجَبَل",8,"ل",1,0],["لم أقض من إمهاله وطري","وقضيت من إسراعه نحبي",9,"ب",2,0],["لم أقل ذا لأَنْ عَتبْتُ ولكن","شجرُ العَتْبِ مُثْمرٌ للجفاءِ",10,"ا",2,0],["لم أقل إذ صحبتكم بعد أقوا","مٍ تبدلت بعد نوق عنوقا",11,"ق",2,0],["لم أقُلْ هاكها لشيءٍ سوى العا","دة والشّعْرُ يركبُ الأهوالا",12,"ل",2,0],["لم أقرِه بعدَ مفروض القِرى نُزلاً","إلا أحاديثَ ما تُسدي من المِنن",13,"ن",1,0],["لَم أَقطِفِ الوَردَةَ مِن غُصنِها","لَو لَم تَكُن كَالخَدِّ في الإِتِّقاد",14,"د",1,0],["لَمّا قَفَلتَ مِنَ السَواحِلِ نَحوَنا","قَفَلَت إِلَيها وَحشَةٌ مِن عِندِنا",15,"ن",2,0],["لَم أَقُل ذاكَ عَن ضَلالٍ وَلَكِن","أَنتَ رَوحي وَالروحُ مِن أَمرِ رَبّي",16,"ب",2,0],["لَم أَقتَنِع بِالقَوافي في أَواخِرِها","حَتّى لَزِمتُ أَواليها فَلَم تَعُقِ",17,"ق",1,0],["لم أقيدك بشيء في الهوى","أنت من حبي ومن وجدي طليق",18,"ق",1,0],["لم أقُلْ والأسى يُصَدّقُ قولي","جمدت عبرتي فلذت بحلمي",19,"م",2,0],["لَمّا قَضى رَمَضانُ مِنهُ قَضاءَهُ","شالَت بِهِ الأَيّامُ في شَوّالِ",20,"ل",1,0],["لَمّا قَرا الناسُ ذاكَ الفَتحَ قُلتُ لَهُم","وَقائِعٌ حَدِّثوا عَنها وَلا حَرَجا",21,"ج",2,0],["لم أقوَ صبراً على شجوٍ يرمِّضُني","حرَّانَ في قفصِ الأضلاعِ مسجون",22,"ن",1,0],["لمّا قَضَى الشَّعبُ المُقيَّدُ سُؤْلَهم","شدُّوا القُيودَ وأحكموا الأغلالا",23,"ل",2,0],["لَمّا قَرَعتُ عَلَيهِ البابَ أَوجَلَهُ","وَقالَ بَينَ مُسِرِّ الخَوفِ وَالراجي",24,"ج",2,0],["لَم أُقَصِّر عَنِ الأَوانِسِ حَتّى","مَسَّني مِن عُبَيدَةَ التَسهيدُ",25,"د",1,0],["لَمّا قَضَينا حَديثاً مِن مُعاتَبَةٍ","وَكادَ يَبرُدُ هَذا الشَرُّ أَو بَرَدا",26,"د",2,0],["لمّا قصُرَت طَاَلتْ وطَابَتْ بِلُقا","بَدْرٍ مِحَني في حُبِّهِ من منحي",27,"ي",1,0],["لم أَقْضِ حَقّ هَواكَ إن كُنتُ الذي","لم أقضِ فيِه أسىً ومِثليَ مَنْ يَفي",28,"ف",2,0],["لَمّا قَضيتَ قضى رجا","ئي كله وَقضَى سروري",29,"ر",2,0],["لما قفلت من السواحل نحونا","قفلت إليه وحشةٌ من عندنا",30,"ن",2,0],["لِمَ أقبلتِ في الظلامِ إليَّ","ولماذا طرقتِ بابيَ ليلا",31,"ل",2,1],["لم أقُلْ فيه مازِ رأسَكَ والسّيْ","فَ كما قالها المُريدُ بَحيرا",32,"ر",2,0],["لَمَا قَصَّرتُ عن طَلَبِ الَمعالي","فَتَقصُرُني المَنيَّةُ أو تَطولُ",33,"ل",1,0],["لَم أَقْتَرِفْ زَلَّةً تَقْضِي عَلَيَّ بِما","أَصْبَحْتُ فيهِ فَماذَا الْوَيْلُ والْحَرَبُ",34,"ب",1,0],["لما قَضى اِبني نَحبَهُ","ظَهري أَنقَضا",35,"ض",2,0],["لم أقضِ في التشبيبِ شرخَ شبيبتي","لكن وقَفتُ على الحمى أمداحي",36,"ح",2,0],["لما قدمت لمصر عاد سرورها","وابيضّ وجهٌ كان منها فاحما",37,"م",2,0],["لما قلبت مجن العزم حاوله","فلم يجد عدة أمضى من الهرب",38,"ب",1,0],["لم أقض منك مرادى","ولا شفيت غليلي",39,"ل",2,1],["لما قامت شواهد الأحوال","أخفيت عبارتي عن المعتبر",40,"ر",1,0],["لِمَا قُلْنَا عَدَدْنَا النَّوْحَ بَوْحاً","بِنَيْلِ الرَّوْحِ لاَ وَجْداً بِفَقْدِ",41,"د",1,0],["لِما قَطَّعنَ مِن قُربى قَريبٍ","وَما أَتلَفنَ مِن يَسَرٍ يَسورِ",42,"ر",1,0],["لما قدمت دمشقاً بعد مصروفي","عطفي منك بقايا الفضل للراجي",43,"ي",1,1],["لما قمت بالشكر الذي هو أهله","وكنت مع التشمير في وصف قاصر",44,"ر",1,0],["لَم أقضِ حقّ الودّ إِن أقوى بقل","بي أَو لِساني من خيالك موضعُ",45,"ع",1,0],["لَمّا قَضى اللَهُ أَشهارً لِمَذهَبِهِ","وَأَبلِغِ الأَمرَ جِبريلَ لِصاحِبِهِ",46,"ه",1,0],["لَمّا قَضى اللَهُ وَالدُنيا مُلَوَّثَةً","بِالكُفرِ وَالكُفرُ بِالدِيانِ مَخبَثَةُ",46,"ه",1,0],["لم أقدم خيرا ولم أبغ وجه الله","فيما أنفقته من شبابي",47,"ب",2,0],["لَم أَقُل إِنّي سَكِرتُ وَلا","إِنَّ ما أَهواهُ مِلَّتِيَه",48,"ي",2,0],["لَم أَقضِ في حَجِّكُم نَسكي وَلا تَفثي","إِن لَم أَرُح هاجَراً لِلفِسقِ وَالرَفثِ",49,"ث",1,1],["لَمّا قَفلتَ منَ الجِهَادِ وَبَشّرَت","بإِيابِ جَيشِكَ ألسُنُ الأَقلامِ",50,"م",1,0],["لمّا قَدِمْتَ على إثرِ الرَّبيعِ لنا","هَزَّ النّدى كُلّ غُصْنٍ للمُنى عاس",51,"س",1,0],["لم أَقضِ به حقه إذ مضَى","ولم أكتسِبْ فيه حَمْداً وأَجرا",52,"ر",2,0],["لم أقتعدْ ظَهْرَ السرى","إلاّ وآمالي جَنيبي",53,"ب",2,0],["لَما قَدَروا يُحصونَ عُشرَ عُشَيرِ ما","تَضَمَّنَهُ مِن حُبِّكَ القَلبُ وَالصَدرُ",54,"ر",1,0],["لمَّا قَضى مدَّة ما","بَينهما بالوَسَنِ",55,"ن",1,0],["لما قبلت البشارهْ وارتضيتِ بها","وصرتِ حبلى ببكر اللَه يا بكرُ",56,"ر",1,1],["لما قدر عليك إلا","له أشكر وأحمد",57,"د",1,0],["لما قد رأينا في الحسين بن طالب","وتقطيعه مُلْقَى بجنب المقابر",58,"ر",1,0],["لما قد أسساه لأصل يحيى","سقى مثواه هَطَّالُ السحاب",59,"ب",1,0],["لمّا قضَى اللهُ اللّقاءَ تعرَّضَتْ","مساءةُ دهري في طريقِ سُروري",60,"ر",2,0],["لم أقضِ حق الشكر من إحسانكم","لكن أُطاوِلُه بباع قاصر",61,"ر",1,0],["لما قضى أجلاً أضحى مؤرخهُ","لقد رقى كل جنات النعيم علي",62,"ل",2,0],["لما قضى وهو ياقوت الكتابة قد","أجرته دمعاً من الأجفان لوعاتُ",63,"ت",1,0],["لمّا قضَى قاضي القياس عنده","مَن هائبُ الأمرِ ومَن مقتَحِمُهْ",64,"م",2,0],["لم أقل قبلها لسوداءَ عطفاً","واقتراباً ولا لبيضاءَ بُعدا",65,"د",2,0],["لَمّا قَضى القُربُ بِداءِ البُعدِ","وَصارَ مِن فُرقَتِنا في لَحدِ",66,"د",1,1],["لما قلت شعراً بعد إعفاء خاطري","ولي سنوات منذ تبت عن الشعر",67,"ر",1,0],["لما قسَا الإنسانُ مِن قربَائِه","كانَ النباتُ لِضِّمهِ بالمرصَدِ",68,"د",1,0],["لم أقترحْ منه ما غنّى الغداةَ بهِ","وربّ مَنْ نال ما يهوى وما اِقتَرحا",69,"ح",2,0],["لمَّا قَضَى في سبيلِ اللهِ مُبتهِجاً","بنورِهِ وبثوبِ المجدِ مُلتحِفا",70,"ف",2,0],["لما قضى أخوه إبراهيم","وهو الإمام عنده القديم",71,"م",1,0],["لما قصدناه على مطلب","أجابنا بالسرّ والجهر",72,"ر",1,0],["لَما قَضى نحبه ناحَت لفرقته","تراجمٌ زانَها حُسن العِبارات",73,"ت",1,0],["لم أقْضِ بعض حُقوقِهم حتّى انقضَتْ","أيّامُهم فحسبتُها أحْلامَا",74,"م",2,0],["لمّا قِدمتم علينا بَسطةً بَهَرَتْ","أنوارُكُم كلَّ مِنْ فيها من البَشَرِ",75,"ر",1,0],["لَما قَضى ناحَ عَلَيهِ الراعي","وَقالَ آه أفّ يا ذِراعي",76,"ي",1,0],["لما قصدْتك قالوا","نراك مِنْ غير سيْفِ",77,"ف",1,1],["لِما قَضى وَطراً بِفَضلِ سُيوفِنا","نَسِيَ اليَدَ البَيضا وَلَم يَتَذَكَّرِ",78,"ر",1,0],["لَما قَضى ما قَضى مِن حَقِّ زائِرِهِ","عُجتُ المَطِيَّ إِلى النُعمان مِن عامي",79,"م",2,0],["لم أقبلتِ للحياة إذا ما","كان هذا الاقبال رهن الرجوع",80,"ع",1,0],["لما قصدتك باشتراء سكاكرٍ","بيضاء حالية المذاق مفضَّلهْ",81,"ل",2,0],["لما قصدتُ أسكندريةَ زائراً","ملأت فؤادي بهجةً وسرورا",82,"ر",2,1],["لما قضيت حقوق البر كاملة","لم تحل فى هذه الدنيا لك السكنىَ",83,"ن",2,0],["لمّا قَطفنا ثمارَ الوصلِ يانِعةً","بخيرِ حالٍ وغصنُ الوصلِ مُعتدلُ",84,"ل",1,0],["لمَّا قضى الدهر ظلماً بالنوى ونأَى","عنا الهنا ولقينا البؤس والحزنا",85,"ن",2,0],["لم أقض حق هواك 