{"poems":[[53,"يا طائر البان غريدا على فنن","https://www.aldiwan.net/poem29732.html","البسيط"],[53,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem29822.html","البسيط"],[55,"إن جهد البلاء حبك إنسانا","https://www.aldiwan.net/poem26146.html","الخفيف"],[9,"لميثاء دار قد تعفت طلولها","https://www.aldiwan.net/poem21963.html","الطويل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"مرت كعمر الورد بينا أجتلي","https://www.aldiwan.net/poem10939.html","الكامل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"يفديك من كل محذور أبو حسنِ","https://www.aldiwan.net/poem66447.html","البسيط"],[91,"أعطيت من أعشقها وردة","https://www.aldiwan.net/poem8754.html","عموديه"],[43,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[66,"أمر الله أن يطيعك لبي","https://www.aldiwan.net/poem39527.html","الخفيف"],[66,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[48,"وفتية كنجوم الليل أوجههم","https://www.aldiwan.net/poem62482.html","البسيط"],[50,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[68,"يا ليلة وصل صبحها لم يلح","https://www.aldiwan.net/poem1491.html",""],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85447","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140872",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20981","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43772","الرجز"],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[135,"حدث بذكر عريب ذياك الحمى","https://www.aldiwan.net/poem49129.html","الكامل"],[160,"رقص جياد الظبا في حلبة اللعب","https://www.aldiwan.net/poem59045.html","البسيط"],[211,"لم أقض منك مرادى","https://www.aldiwan.net/poem46339.html","المجتث"],[231,"أخفيت إشاراتي عن العذال","https://www.aldiwan.net/poem44540.html","الدوبيت"],[237,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[249,"عفت أطلال مية بالجفير","https://www.aldiwan.net/poem2116.html","الوافر"],[303,"لما قدمت دمشقا بعد مصروفي","https://www.aldiwan.net/poem57664.html","البسيط"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[328,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[346,"يا نساء الحي عدننيه","https://www.aldiwan.net/poem24115.html","المديد"],[349,"لم أقض في حجكم نسكي ولا تفثي","https://www.aldiwan.net/poem15552.html","البسيط"],[357,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[364,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[364,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[364,"نشر المنى طاوي السهوب","https://www.aldiwan.net/poem60995.html","مجزوء الكامل"],[366,"فلو أن كتاب العراق أكفهم","https://www.aldiwan.net/poem17874.html","الطويل"],[371,"بعض بنات الزمن","https://www.aldiwan.net/poem57080.html","مجزوء الرجز"],[377,"لما قبلت البشاره وارتضيت بها","https://www.aldiwan.net/poem59391.html","البسيط"],[391,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[403,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[403,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[409,"إلى الله أشكو فرقة دميت لها","https://www.aldiwan.net/poem32466.html","الطويل"],[416,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[429,"لحد ثواه علي كان خير فتى","https://www.aldiwan.net/poem40054.html","البسيط"],[429,"للعين من ألم الأحشاءِ عبرات","https://www.aldiwan.net/poem40534.html","البسيط"],[458,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[458,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[468,"لما قضى القرب بداء البعد","https://www.aldiwan.net/poem60227.html","الرجز"],[515,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[538,"لله في مراكش قبر به","https://www.aldiwan.net/poem48226.html","عموديه"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[562,"هذا نقولا الذي أجرى الدموع دما","https://www.aldiwan.net/poem52636.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَما قَدَحتُ بِنارِ الوَجدِ في كَبِدي","وَلا بَلَلتُ بِماءِ الدَمعِ أَجفاني",0,"ي",1,0],["لَم أَقضِ مِنكِ لُباناتٍ ظَفِرتُ بِها","فَهَل لِيَ اليَومَ إِلّا زَفرَةُ النَدَمِ",1,"م",1,0],["لَم أُقارِف ذَنباً فَأَستَغفِرَ اللَ","هَ وَقَد أَظهَرَ الجَفاءَ الخَليلُ",2,"ل",1,0],["لِما قَد تَعَفّى مِن رَمادٍ وَعَرصَةٍ","بَكَيتُ وَهَل يَبكي إِلَيكَ مُحيلُها",3,"ل",3,0],["لَم أَقضِ حَقَّ بِلادي","وَها أَنا قَد قَضَيتُ",4,"ت",1,0],["لَم أَقِف مَوقِفي لِأُنشِدَ شِعراً","صُبَّ في قالَبٍ بَديعِ النِظامِ",5,"م",1,0],["لَم أَقضِ مِن حَقِّ المُدامِ وَلَم أَقُم","في الشارِبينَ بِواجِبِ الأَقداحِ",6,"ح",1,0],["لما قصدت لها مراسِيَ سبتةٍ","عطفت على الأسوار عطف سوارِ",7,"ر",1,0],["لَم أَقِل إِلّا عَلَيهِ أَو عَلى","مَرقَبٍ يَفرَعُ أَطرافَ الجَبَل",8,"ل",1,0],["لم أقض من إمهاله وطري","وقضيت من إسراعه نحبي",9,"ب",2,0],["لم أقل ذا لأَنْ عَتبْتُ ولكن","شجرُ العَتْبِ مُثْمرٌ للجفاءِ",10,"ا",2,0],["لم أقل إذ صحبتكم بعد أقوا","مٍ تبدلت بعد نوق عنوقا",11,"ق",2,0],["لم أقُلْ هاكها لشيءٍ سوى العا","دة والشّعْرُ يركبُ الأهوالا",12,"ل",2,0],["لم أقرِه بعدَ مفروض القِرى نُزلاً","إلا أحاديثَ ما تُسدي من المِنن",13,"ن",1,0],["لَم أَقطِفِ الوَردَةَ مِن غُصنِها","لَو لَم تَكُن كَالخَدِّ في الإِتِّقاد",14,"د",1,0],["لَمّا قَفَلتَ مِنَ السَواحِلِ نَحوَنا","قَفَلَت إِلَيها وَحشَةٌ مِن عِندِنا",15,"ن",2,0],["لَم أَقُل ذاكَ عَن ضَلالٍ وَلَكِن","أَنتَ رَوحي وَالروحُ مِن أَمرِ رَبّي",16,"ب",2,0],["لَم أَقتَنِع بِالقَوافي في أَواخِرِها","حَتّى لَزِمتُ أَواليها فَلَم تَعُقِ",17,"ق",1,0],["لم أقيدك بشيء في الهوى","أنت من حبي ومن وجدي طليق",18,"ق",1,0],["لم أقُلْ والأسى يُصَدّقُ قولي","جمدت عبرتي فلذت بحلمي",19,"ي",1,0],["لَمّا قَضى رَمَضانُ مِنهُ قَضاءَهُ","شالَت بِهِ الأَيّامُ في شَوّالِ",20,"ل",1,0],["لَمّا قَرا الناسُ ذاكَ الفَتحَ قُلتُ لَهُم","وَقائِعٌ حَدِّثوا عَنها وَلا حَرَجا",21,"ج",2,0],["لم أقوَ صبراً على شجوٍ يرمِّضُني","حرَّانَ في قفصِ الأضلاعِ مسجون",22,"ن",1,0],["لمّا قَضَى الشَّعبُ المُقيَّدُ سُؤْلَهم","شدُّوا القُيودَ وأحكموا الأغلالا",23,"ل",2,0],["لَمّا قَرَعتُ عَلَيهِ البابَ أَوجَلَهُ","وَقالَ بَينَ مُسِرِّ الخَوفِ وَالراجي",24,"ج",2,0],["لَم أُقَصِّر عَنِ الأَوانِسِ حَتّى","مَسَّني مِن عُبَيدَةَ التَسهيدُ",25,"د",1,0],["لَمّا قَضَينا حَديثاً مِن مُعاتَبَةٍ","وَكادَ يَبرُدُ هَذا الشَرُّ أَو بَرَدا",26,"د",2,0],["لمّا قصُرَت طَاَلتْ وطَابَتْ بِلُقا","بَدْرٍ مِحَني في حُبِّهِ من منحي",27,"ي",1,0],["لم أَقْضِ حَقّ هَواكَ إن كُنتُ الذي","لم أقضِ فيِه أسىً ومِثليَ مَنْ يَفي",28,"ي",1,0],["لَمّا قَضيتَ قضى رجا","ئي كله وَقضَى سروري",29,"ر",2,0],["لما قفلت من السواحل نحونا","قفلت إليه وحشةٌ من عندنا",30,"ن",2,0],["لِمَ أقبلتِ في الظلامِ إليَّ","ولماذا طرقتِ بابيَ ليلا",31,"ل",2,1],["لم أقُلْ فيه مازِ رأسَكَ والسّيْ","فَ كما قالها المُريدُ بَحيرا",32,"ر",2,0],["لَمَا قَصَّرتُ عن طَلَبِ الَمعالي","فَتَقصُرُني المَنيَّةُ أو تَطولُ",33,"ل",1,0],["لَم أَقْتَرِفْ زَلَّةً تَقْضِي عَلَيَّ بِما","أَصْبَحْتُ فيهِ فَماذَا الْوَيْلُ والْحَرَبُ",34,"ب",1,0],["لما قَضى اِبني نَحبَهُ","ظَهري أَنقَضا",35,"ض",2,0],["لم أقضِ في التشبيبِ شرخَ شبيبتي","لكن وقَفتُ على الحمى أمداحي",36,"ح",2,0],["لما قدمت لمصر عاد سرورها","وابيضّ وجهٌ كان منها فاحما",37,"م",2,0],["لما قلبت مجن العزم حاوله","فلم يجد عدة أمضى من الهرب",38,"ب",1,0],["لم أقض منك مرادى","ولا شفيت غليلي",39,"ي",1,1],["لما قامت شواهد الأحوال","أخفيت عبارتي عن المعتبر",40,"ر",1,0],["لِمَا قُلْنَا عَدَدْنَا النَّوْحَ بَوْحاً","بِنَيْلِ الرَّوْحِ لاَ وَجْداً بِفَقْدِ",41,"د",1,0],["لِما قَطَّعنَ مِن قُربى قَريبٍ","وَما أَتلَفنَ مِن يَسَرٍ يَسورِ",42,"ر",1,0],["لما قدمت دمشقاً بعد مصروفي","عطفي منك بقايا الفضل للراجي",43,"ي",1,1],["لما قمت بالشكر الذي هو أهله","وكنت مع التشمير في وصف قاصر",44,"ر",1,0],["لَم أقضِ حقّ الودّ إِن أقوى بقل","بي أَو لِساني من خيالك موضعُ",45,"ع",1,0],["لَمّا قَضى اللَهُ أَشهارً لِمَذهَبِهِ","وَأَبلِغِ الأَمرَ جِبريلَ لِصاحِبِهِ",46,"ه",1,0],["لَمّا قَضى اللَهُ وَالدُنيا مُلَوَّثَةً","بِالكُفرِ وَالكُفرُ بِالدِيانِ مَخبَثَةُ",46,"ه",1,0],["لم أقدم خيرا ولم أبغ وجه الله","فيما أنفقته من شبابي",47,"ب",2,0],["لَم أَقُل إِنّي سَكِرتُ وَلا","إِنَّ ما أَهواهُ مِلَّتِيَه",48,"ي",2,0],["لَم أَقضِ في حَجِّكُم نَسكي وَلا تَفثي","إِن لَم أَرُح هاجَراً لِلفِسقِ وَالرَفثِ",49,"ث",1,1],["لَمّا قَفلتَ منَ الجِهَادِ وَبَشّرَت","بإِيابِ جَيشِكَ ألسُنُ الأَقلامِ",50,"م",1,0],["لمّا قَدِمْتَ على إثرِ الرَّبيعِ لنا","هَزَّ النّدى كُلّ غُصْنٍ للمُنى عاس",51,"س",1,0],["لم أَقضِ به حقه إذ مضَى","ولم أكتسِبْ فيه حَمْداً وأَجرا",52,"ر",2,0],["لم أقتعدْ ظَهْرَ السرى","إلاّ وآمالي جَنيبي",53,"ب",2,0],["لَما قَدَروا يُحصونَ عُشرَ عُشَيرِ ما","تَضَمَّنَهُ مِن حُبِّكَ القَلبُ وَالصَدرُ",54,"ر",1,0],["لمَّا قَضى مدَّة ما","بَينهما بالوَسَنِ",55,"ن",1,0],["لما قبلت البشارهْ وارتضيتِ بها","وصرتِ حبلى ببكر اللَه يا بكرُ",56,"ر",1,1],["لما قدر عليك إلا","له أشكر وأحمد",57,"د",1,0],["لما قد رأينا في الحسين بن طالب","وتقطيعه مُلْقَى بجنب المقابر",58,"ر",1,0],["لما قد أسساه لأصل يحيى","سقى مثواه هَطَّالُ السحاب",59,"ب",1,0],["لمّا قضَى اللهُ اللّقاءَ تعرَّضَتْ","مساءةُ دهري في طريقِ سُروري",60,"ي",1,0],["لم أقضِ حق الشكر من إحسانكم","لكن أُطاوِلُه بباع قاصر",61,"ر",1,0],["لما قضى أجلاً أضحى مؤرخهُ","لقد رقى كل جنات النعيم علي",62,"ي",1,0],["لما قضى وهو ياقوت الكتابة قد","أجرته دمعاً من الأجفان لوعاتُ",63,"ت",1,0],["لمّا قضَى قاضي القياس عنده","مَن هائبُ الأمرِ ومَن مقتَحِمُهْ",64,"م",2,0],["لم أقل قبلها لسوداءَ عطفاً","واقتراباً ولا لبيضاءَ بُعدا",65,"د",2,0],["لَمّا قَضى القُربُ بِداءِ البُعدِ","وَصارَ مِن فُرقَتِنا في لَحدِ",66,"د",1,1],["لما قلت شعراً بعد إعفاء خاطري","ولي سنوات منذ تبت عن الشعر",67,"ر",1,0],["لما قسَا الإنسانُ مِن قربَائِه","كانَ النباتُ لِضِّمهِ بالمرصَدِ",68,"د",1,0],["لم أقترحْ منه ما غنّى الغداةَ بهِ","وربّ مَنْ نال ما يهوى وما اِقتَرحا",69,"ح",2,0],["لمَّا قَضَى في سبيلِ اللهِ مُبتهِجاً","بنورِهِ وبثوبِ المجدِ مُلتحِفا",70,"ف",2,0],["لما قضى أخوه إبراهيم","وهو الإمام عنده القديم",71,"م",1,0]]}