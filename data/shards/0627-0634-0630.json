{"poems":[[45,"لئن تك طيئ كانت لئاما","https://www.aldiwan.net/poem10602.html","الوافر"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[342,"وحرف قد بعثت على وجاها","https://www.aldiwan.net/poem45435.html","الوافر"],[519,"أشذاء زهر الباقلاء تضوعت","https://www.aldiwan.net/poem20856.html","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93872","المتدارك"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127922","الكامل"],[4729,"أُتنكرين الحقَّ أختَ دَارمِ","https://www.poetsgate.com/ViewPoem.aspx?id=109473",""],[5714,"أشذى من الفل","https://www.poetsgate.com/ViewPoem.aspx?id=213798",""]],"verses":[["أَشَذَّ بِعِرسِهِ عَنّي عَبيدي","فَأَتلَفَهُم وَمالي أَتلَفوهُ",0,"و",2,0],["أَشذا نعمان أَهدتُه النُعامى","أَم سرَت تحملُ عن نُعمٍ سَلاما",1,"م",2,1],["أَشَذَّ جِحاشَها وَخَلا بِجونٍ","لَواقِحَ كَالقِسِيِّ وَحائِلاتِ",2,"ت",1,0],["أشذاء زهرِ الباقلاءِ تضوَّعت","نفحاتهُ أم نشر مسكٍ أذفرِ",3,"ر",1,1],["أشذا نفحات من عنبر","أم طيب ثنا يروي عن بر",4,"ر",1,1],["أَشذورُ تبر مع طروس عاجٍ","أم نظم درٍّ في قبا ديباجِ",5,"ج",1,1],["أشذ عن سَمعي أحاديثُ نَدا","كعبِ الندا وفرطُ جودِ حاتمِ",6,"م",1,0],["أشذى من الفل أو أحلى من العسلِ","قد تُهتُ بين جمالِ الخدِ والمقلِ",7,"ل",1,1]]}