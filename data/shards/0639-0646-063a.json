{"poems":[[95,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[47,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[406,"رسالة معايدة من شيخ فلسطيني","https://www.aldiwan.net/poem6706.html","عموديه"],[406,"الجدار الفولاذي","https://www.aldiwan.net/poem6710.html","عموديه"],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[563,"نفس بعلوة لا تزال أبية","https://www.aldiwan.net/poem34719.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118427","السريع"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123143","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109375","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126192","الرجز"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144168","الكامل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125991","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117949","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36605","الدوبيت"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54362","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136670",""],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4860,"ذاك المسى","https://www.poetsgate.com/ViewPoem.aspx?id=32390",""],[4869,"الصدفه","https://www.poetsgate.com/ViewPoem.aspx?id=151582",""],[5102,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=12900",""],[5277,"ختام الخواتيم","https://www.poetsgate.com/ViewPoem.aspx?id=187287",""],[5431,"قنطار شوق زرعت الروح ياحمص","https://www.poetsgate.com/ViewPoem.aspx?id=192391",""],[5732,"ليته معي","https://www.poetsgate.com/ViewPoem.aspx?id=177922",""],[5732,"قالوا قحوم","https://www.poetsgate.com/ViewPoem.aspx?id=177824",""],[6124,"يا ليت ظني","https://www.poetsgate.com/ViewPoem.aspx?id=120027",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""]],"verses":[["عَنْ غَادَةٍ مَاثِلَةٍ بِالجِسْمِ فِي","أَبْدَعِ رَسْمٍ لِلْجَمَالِ التَّمَامْ",0,"م",1,0],["عَن غَيرِ ذَنبٍ جِئتُموهُ سِوى عُلاً","زُهرٍ لِجَدِّكُمُ الأَغَرِّ الأَزهَرِ",1,"ر",1,0],["عَن غير رضايَ جَرَتْ أشيا","ءُ تُغيضُ سواكَ وتُجْمِدهُ",2,"د",2,0],["عن غادَةٍ عُطبولِ","تلعبُ بالعقولِ",3,"ل",1,0],["عن غزَّة الأبطال في نَشراتِكُم","صورٌ يضيقُ بما حوتهُ النَّاقِلُ",4,"ل",1,0],["عن غزَّةَ الأبطال كيف تحوَّلتْ","سجْناً تُحاصرهُ قلوبُ جَلاَذي",5,"ذ",2,0],["عنْ غيرِ غِزْلانِ النَّقا","أمضَى المدَى مُنْسَلِبَا",6,"ب",2,0],["عن غيرها أن جانبوا بهوائهم","فهي التي فيها كمال صفائهم",7,"م",1,0],["عن غير أمره فلما سمعه","قام مع الوصي حتى نزعه",8,"ه",1,0],["عن غيرِها في القدِّ رفَّعها","لكنَّه بيَديهِ أَنْزلَها",9,"ل",3,0],["عن غنى المرملينَ دنيا وأخرى","عن أمان المفَزّع المزءود",10,"د",1,0],["عن غالب عن فهرهم عن مالك","عن نظرهم دعوى كنانة إذوع",11,"ع",1,0],["عن غيرك التختيم اصطانه","ولم اجد اجدى ولا اجدرا",12,"ر",2,0],["عن غيركم لكم رجعت أحبّتي","لا كان عنكم ما حييت رجوعي",13,"ع",2,0],["عن غيره مازه باري الأنام كما","عن سائر الحول ماز الأشهر الحرما",14,"م",2,0],["عن غَيرِنا ذا مشربٌ مَنِيفُ","مَنصِبَةُ شاهَدَها شَريف",15,"ف",1,0],["عن غيرِه فى ظاهِرِ المنِّة وال","قلبُ له برؤيةِ الحقِّ إشتَغل",16,"ل",1,0],["عن غُرّةِ التّاج الذي تعنو له","غُرُّ الأماجدِ من ذوي التّيجانِ",17,"ن",1,0],["عن غزاة في القفر شّبوا زمان الرو","م والفرس يملكون المشارق",18,"ق",1,0],["عن غيره في فنه يغني وإن","يخبر فذاك جهينة المصداق",19,"ق",1,0],["عن غيرهم وصفات البيت قد سألوا","فكان منه لوصف الكل تفصيل",20,"ل",1,0],["عَن غَنِيمِيذٍ ابنهِ المَرفُوعِ","عِوَضاً نالَ أصلَ خَيرِ الفُرُوعِ",21,"ع",1,0],["عَن غَيرِهِ وَمَا نَفَاهُ رَاعَى","تَعَلَّقَ العِلمِ بِهِ امتِنَاعاً",22,"ع",2,0],["عَن غَيرِهِ بِنَداهُ الوَفدُ نالَ غِنى","وَالوارِدُ العَد لا يَحتاجُ لِلثَّمَد",23,"د",1,0],["عَن غَيرِكَ قَلبي كَمَكاني خالِ","إِن زرت فَما أَليقَه بِالحالِ",24,"ل",1,1],["عن غيركم نفسي تُلازم صومَها","وبذكركم أَبداً تُديمُ صلاتَها",25,"ت",3,0],["عن غُصني المياد أين","مَضى وقلبي يَقتفيه",26,"ي",2,0],["عن غسق ذله يبينا نشبّ الشمعدان","نحتذي حذوْ النبي واخلفاه الراشدين",27,"ن",1,0],["عن غيابك/عن بعادك..ودولة هم من أحزاني","وكم أعشق حزن عمري إذا زادت تآويله",28,"ل",2,0],["عن غيري مْن النآس لآزم افولذك","حتى مااهآب ان جآ من الشر مآرق",29,"ق",1,0],["عن غَضِّ طَرْفِكَ لامَكَ الإفتاءُ","وبكل سطحٍ زغردتْ حسناءُ",30,"ا",2,1],["عن غيرةٍ وفؤادي ملؤُهُ شجنٌ","بمنْ ختمتُ هواها العمرَ إيقانا",31,"ن",2,0],["عن غصن عشيَ فالأطيار ماهجعت","من يوم هجرك لاسعدٌ ولا رقصُ",32,"ص",1,0],["عن غير ملهوف الضماير تبريت","وترى الحياة بلاه يا زبن تلوى",33,"ل",3,0],["عن غوج ابو خالد نشدنا هل الخيل","قالوا لنا يلفح بيمنا سليمه",34,"م",2,1],["عن غيمةٍ سألتُها مرّةً","ومرّةً خبّأتُ لِي سرّها",35,"ر",3,0],["عن غُولةٍ أمْرِكيِّ ِ الحِقْدِ محْتدُها","يهْوَى الدماءَ وصِبْغَ الموت فنّانُها",36,"ن",3,0]]}