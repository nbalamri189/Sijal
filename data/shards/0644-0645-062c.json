{"poems":[[77,"لمجدد الملك الرفيع محمد","https://www.aldiwan.net/poem36026.html","الكامل"],[69,"لمجنونكم عارض أخضر","https://www.aldiwan.net/poem29033.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[115,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[142,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[147,"نعم ولكم فضل بأشرف دعوة","https://www.aldiwan.net/poem47669.html","الطويل"],[212,"سعيد بن سلطان بنى العز والعلا","https://www.aldiwan.net/poem37860.html","الطويل"],[285,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[305,"لك الحمد يا من خص أهل الطريقة","https://www.aldiwan.net/poem56591.html","الطويل"],[371,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[391,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[409,"يا ملولا قلما يرعي","https://www.aldiwan.net/poem32601.html","مجزوء الرمل"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[458,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[458,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[461,"حفلت بما شادت قريش من العلى","https://www.aldiwan.net/poem15617.html","الطويل"],[529,"قد مد مطرفه السحاب","https://www.aldiwan.net/poem37526.html","مجزوء الكامل"]],"verses":[["لِمُجَدِّدِ الملكِ الرَّفيعِ مُحَمَّدٍ","أنْشِيتُ فَاعْجَبْ مِنْ غَرَابةِ شَانِي",0,"ي",1,1],["لمجنونِكُمْ عارضٌ أخضرُ","دليلي على حبِّه ناهِضُ",1,"ض",1,1],["لِمَجْرَى نِيلِهَا وَلضَفَّتَيْهِ","جَمَالٌ لاَ يُبَاهِيهِ جَمَالُ",2,"ل",1,0],["لمجلس الأمن أحكامٌ تذوبُ، كما","ذابَتْ فَقَاقِيعُ كأس حَفَّها حَبَب",3,"ب",1,0],["لمجدك في معاريج التداني","مقام لا يدانيه مقام",4,"م",1,0],["لِمْ جَعَلتْ أعيننا مَغاربا","واتّخذت خُدورَها مَشارقا",5,"ق",2,0],["لمجلسكم أعلى الكرامة عندنا","ولفظكم أشهى إلينا من الدر",6,"ر",1,0],["لِمَجدِ ابن سلطان له الفَتْحُ والعُلا","ومن ينصرنه اللهُ مِنْ مَنْ أزَاغَهُ",7,"ه",1,0],["لم جهز الجيش القلي","ل وزاده بعض التمر",8,"ر",1,0],["لِمجذوبهم قد أوجبَ الصحوَ عارفٌ","بِأنّهم من صفوِ أهلِ العنايةِ",9,"ه",1,0],["لمجدكَ ما كفاك القول فيه","ولي خبرٌ كفى الناسَ اختِباري",10,"ي",1,0],["لمجلس التعليم كن ملازم","مع التحفظ من شرور وأشرار",11,"ر",1,0],["لِمْ جَعلتَ الهجرَ يا مو","لايَ قبل البُعد بُعدَا",12,"د",2,0],["لمجالي حسنها فعل شكور","وغدت ناشرة نحو العلاء",13,"ا",2,0],["لمجدك منها يومَ تبغي نكاحَها","كما شئتَ أبكارٌ تُزفُّ وعُونُ",14,"ن",1,0],["لمجدك منها رسومٌ تقا","م كالعهدِ يُحفَظُ والنذرِ يوفى",15,"ف",2,0],["لمجدُ الوزير الزَّيْنبيِّ مُحَلِّقٌ","على ما مضى من حادثٍ وقَديمِ",16,"م",1,0],["لمجامِرِ الأُتْرُجِّ في","أَرْجاهُ عَرْفٌ مُسْتَطابْ",17,"ب",1,0]]}