{"poems":[[79,"لمجدد الملك الرفيع محمد","https://www.aldiwan.net/poem36026.html","الكامل"],[71,"لمجنونكم عارض أخضر","https://www.aldiwan.net/poem29033.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[119,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[151,"نعم ولكم فضل بأشرف دعوة","https://www.aldiwan.net/poem47669.html","الطويل"],[216,"سعيد بن سلطان بنى العز والعلا","https://www.aldiwan.net/poem37860.html","الطويل"],[290,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[310,"لك الحمد يا من خص أهل الطريقة","https://www.aldiwan.net/poem56591.html","الطويل"],[376,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[396,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[415,"يا ملولا قلما يرعي","https://www.aldiwan.net/poem32601.html","مجزوء الرمل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[463,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[463,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[466,"حفلت بما شادت قريش من العلى","https://www.aldiwan.net/poem15617.html","الطويل"],[534,"قد مد مطرفه السحاب","https://www.aldiwan.net/poem37526.html","مجزوء الكامل"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198597","الوافر"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101524","الكامل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35405","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136299","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83010","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92115","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40128","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94428","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[402,"برغم المعالي أنك اليوم نائم","https://www.poetsgate.com/ViewPoem.aspx?id=36257",""],[5956,"نشتاق يا جَدِّي إليكِ وأسرتِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200897",""]],"verses":[["لِمُجَدِّدِ الملكِ الرَّفيعِ مُحَمَّدٍ","أنْشِيتُ فَاعْجَبْ مِنْ غَرَابةِ شَانِي",0,"ي",1,1],["لمجنونِكُمْ عارضٌ أخضرُ","دليلي على حبِّه ناهِضُ",1,"ض",1,1],["لِمَجْرَى نِيلِهَا وَلضَفَّتَيْهِ","جَمَالٌ لاَ يُبَاهِيهِ جَمَالُ",2,"ل",1,0],["لمجلس الأمن أحكامٌ تذوبُ، كما","ذابَتْ فَقَاقِيعُ كأس حَفَّها حَبَب",3,"ب",1,0],["لمجدك في معاريج التداني","مقام لا يدانيه مقام",4,"م",1,0],["لِمْ جَعَلتْ أعيننا مَغاربا","واتّخذت خُدورَها مَشارقا",5,"ق",2,0],["لمجلسكم أعلى الكرامة عندنا","ولفظكم أشهى إلينا من الدر",6,"ر",1,0],["لِمَجدِ ابن سلطان له الفَتْحُ والعُلا","ومن ينصرنه اللهُ مِنْ مَنْ أزَاغَهُ",7,"ه",1,0],["لم جهز الجيش القلي","ل وزاده بعض التمر",8,"ر",1,0],["لِمجذوبهم قد أوجبَ الصحوَ عارفٌ","بِأنّهم من صفوِ أهلِ العنايةِ",9,"ه",1,0],["لمجدكَ ما كفاك القول فيه","ولي خبرٌ كفى الناسَ اختِباري",10,"ر",2,0],["لمجلس التعليم كن ملازم","مع التحفظ من شرور وأشرار",11,"ر",1,0],["لِمْ جَعلتَ الهجرَ يا مو","لايَ قبل البُعد بُعدَا",12,"د",2,0],["لمجالي حسنها فعل شكور","وغدت ناشرة نحو العلاء",13,"ا",2,0],["لمجدك منها يومَ تبغي نكاحَها","كما شئتَ أبكارٌ تُزفُّ وعُونُ",14,"ن",1,0],["لمجدك منها رسومٌ تقا","م كالعهدِ يُحفَظُ والنذرِ يوفى",15,"ف",2,0],["لمجدُ الوزير الزَّيْنبيِّ مُحَلِّقٌ","على ما مضى من حادثٍ وقَديمِ",16,"م",1,0],["لمجامِرِ الأُتْرُجِّ في","أَرْجاهُ عَرْفٌ مُسْتَطابْ",17,"ب",1,0],["لمجتمع الفضيلة كنت تسعى","فقدَّمت العطايا والمهورا",18,"ر",2,0],["لُم جُر إِذَن عيّر أطل عذلي أضِع","فضلى أبح قتلي فما انا من سلا",19,"ل",2,0],["لِمَجاري الماءِ فيهِ سَنَنٌ","كَيفَما صَرَّفتَهُ فيهِ اِنصَرَف",20,"ف",1,0],["لِمَجدِكَ تَنتَمي لَكِن نَماها","إِلى صَنعاءَ ما صَنَعَ اليَدانِ",21,"ن",1,0],["لمجدك قصر في العلى لا يطاول","فمن أين يحصي وصف مجدك قايل",22,"ل",1,1],["لمُجتنيها شوكُها والشذا","منها لمن لم يدرِ مُجناها",23,"ا",3,0],["لمجدِك يَا شَمسَ المعالي رَفعتُهَا","فَلاَ أنثنِي عَن فضلِكُم وَيَدِي صِفرُ",24,"ر",1,0],["لمجانينُ وَإِن هم","لم يكونوا يصرَعونا",25,"ن",2,0],["لمجده قد أرخ التوفيق","البارْمِرَسْتونَ رقيّ الشكر",26,"ر",1,0],["لمجلسك الزاهي سرورٌ وسوددٌ","به يزدهي دهري وتعتزُّ أوقاتي",27,"ي",1,1],["لِمُجرّب عُمَرِيَّة غضباتُه","للَّه مُعْتَصِمِيَّةٌ غَزَواتُهُ",28,"ت",2,0],["لمجلس آل لبنانٍ مقامٌ","رقى أسمى الطباق على الحقيقة",29,"ق",2,1],["لمجدي حمى لا ينبت اللؤم روضه","ولا وطنت في أخمص اللؤم أرضه",30,"ه",1,1],["لمجدك من حق وتقضي العزائم","ومما تجد الحادثات الدواهم",31,"م",1,0],["لمجيئنا بنفوسكم أثرُ الضيا","ونرى اندهاشك من هناءة شهقتكْ",32,"ك",1,0]]}