em.aspx?id=5117",""],[106,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[43,"أوه بديل من قولتي واها","https://www.poetsgate.com/ViewPoem.aspx?id=173",""],[7,"يَا دَارَ مَيَّةَ (المعلقات)","https://www.poetsgate.com/ViewPoem.aspx?id=10023",""],[90,"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[45,"هُوَيْنَاكَ مِنْ لَوْمٍ على حُبٍّ تَكَتّمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32085",""],[28,"إن التي نظرت إليك بفادر","https://www.poetsgate.com/ViewPoem.aspx?id=17966",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[105,"خلت المنازل منك والأوطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55119&r=&rc=289",""],[10,"يا عَينِ جُودي بالدّموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10485&r=&rc=10",""]],"verses":[["الوَجهُ طَلقٌ وَالبَنانُ نَدٍ","وَالوَعدُ نَقدٌ وَالعَطاءُ هَني",0,"ي",1,0],["الواهِبَ النَعَمَ الجَراجِرَ عادَةً","مِن ذي يَدَينِ إِذا سَخا لَم يَندَمِ",1,"م",1,0],["أَلوي عِناني عَن مُنازَلَةِ الهَوى","وَأَصُدُّ عَن ذِكرِ الغَزالِ المُغزِلِ",2,"ل",1,0],["أُلَوّي حَيازيمي عَلَيكَ تَحَرُّقا","وَأَشكو قُصورَ الدَمعِ فيكَ وما رَقا",3,"ق",2,1],["أَلومُ مَن لا يَعُدُّ اللُؤمَ مَنقَصَةً","وَضاعَ عَتبُ مُسيءٍ ليسَ يَعتَذِرُ",4,"ر",1,0],["الوِرْدُ يَبْسِمُ والرَّكائِبُ حُوَّمُ","والسَّيفُ يَلمَعُ والصَّدى يَتضَرَّمُ",5,"م",1,1],["أَلومَكِ في شَأني وَأَنتِ مُليمَةٌ","لَعَمري وَأَجفى لِلمُحِبِّ وَأَقطَعُ",6,"ع",1,0],["الواهِبِ الآلافَ غيْرَ مُعيرِها","طرْفَ الضّنينِ وإنْ تكُنْ هيَ ما هي",7,"ي",1,0],["الْوَجْهَ طَلْقاً وَالْمَعَارِفَ جَمَّةً","وَالْجُودَ رَحْباً وَالْمَحَلَّ نَبِيهَا",8,"ي",3,0],["الواطِئينَ عَلى صُدورِ نِعالِهِم","يَمشونَ في الدَفَنِيِّ وَالأَبرادِ",9,"د",1,0],["الواهِبُ المِئَةِ الهِجانَ وَعَبدَها","عوذاً تُزَجّي خَلفَها أَطفالَها",10,"ل",3,0],["الواهِبُ القَيناتِ كَال","غِزلانِ في عَقِدِ الخَمائِل",11,"ل",1,0],["الواهِبِ المِئَةَ الصَفا","يا بَينَ تالِيَةٍ وَحائِل",12,"ل",1,0],["أَلوى بِهِ الضَعفُ وَاِستَرخَت أَعِنَّتُهُ","فَراحَ يَعثُرُ في حَشوٍ وَتَعقيدِ",13,"د",1,0],["الواعِظُ البَلخِيُّ كانَ قَرابَتي","وَأَبو مُحَمَّدٍ المُنادي جاري",14,"ي",1,1],["الواهِبِ الأَمصارَ مُحتَقراً لَها","إِن غَيرَهُ وَهب الهِجانَ البُزَّلا",15,"ل",2,0],["الورد سلطان كل زهر","لو أنه دائم الورود",16,"د",1,1],["الواهِبُ المِئَةِ الهِجانِ","مِنَ الخَناذيذِ السَوابِح",17,"ح",1,0],["أُلو عِزٍّ كَأَنَّهُمُ غِضابٌ","وَمَجدٍ مَدَّهُ الحَسَبُ الطَويلُ",18,"ل",1,0],["أَلْوِزْرُ مَغفُورٌ وَقَدْ","صَدَقَ المُفَرِّطُ إِذْ أَنَأبَا",19,"ب",2,0],["أَلْوَى يَحُطُّ فَمَا يَقُولُ شُهُودُهُ","إِلاَّ جَلاَلَ النَّسْرِ فِي الطَّيَرَانِ",20,"ن",1,0],["أَلوَالِدُ الشَّيْخُ الرَّئِيسُ وَوُلدُهُ","شَرَوَاهُ فِي أَدَبٍ وَفِي عِرْفَانِ",21,"ن",1,0],["ألوْ حَذَوْا حَذْوَهُ لَطَابَ لَهُمْ","وِرْدُهُمْ صَفياً مِنَ الإحَنِ",22,"ن",1,0],["أَلوَزِيرُ النَّهَّاضُ مَا حَزَبَ الأَمْ","رُ بِأَعْبَائِهِ الثِّقَالِ الضِّخَامِ",23,"م",1,0],["أَلوَلِيُّ الأَوْفَى لِكُلِّ مُوَالٍ","وَالمُذِم الأَكْفَى لِرَاعِي الذِّمَامِ",23,"م",1,0],["الوَجْهُ صُبْحٌ أَغَرُّ سَمْحٌ","وَالاسْمُ مِسْكٌ عَدَاهُ ذَامُ",24,"م",1,0],["الوَاضِحُ القَسَمَاتِ كَالآيَاتِ","فِي حَلَكِ اللَّيَالِي",25,"ي",1,0],["الواهِبَ المِائَةَ الجُرجورَ حانِيَة","عَلى الرِباع إِذا ما ضُنَّ بِالسَبَدِ",26,"د",1,0],["الوجود يقول هنيّا","على راحه فخر الأملاك",27,"ك",1,1],["ألِواءُ صبحٍ في ثنيّة مشرق","أمْ رايةٌ في جحفل جرَّارِ",28,"ر",1,0],["أَلُؤماً وَإِقراراً عَلى كُلِّ سَوءَةٍ","فَما لِلمَخازي عَن قُفَيرَةَ مَصرَفُ",29,"ف",1,0],["آلَوا عَليها يَميناً لا تُكَلِّمُنا","مِن غَيرِ سوءٍ وَلا مِن ريبَةٍ حَلَفوا",30,"ف",3,0],["الواقِفينَ عَلى الثُغورِ جِيادَهُم","وَالمُحرِزينَ مَكارِمَ الأَيّامِ",31,"م",1,0],["الوكا توافي ابني صفية وانتجع","سواحل دُعمىّ بها ورمالها",32,"ه",2,0],["الوَردُ في وَجنَتَيهِ","وَالسِحرُ في مُقلَتَيهِ",33,"ي",2,1],["أَلوى بِعَزمِيَ أَصداغٌ لُوينَ لَهُ","وَغالَ صَبرِيَ ماتَحوي غَلائِلُهُ",34,"ل",2,0],["ألوَى بثعْلبَ نقدُ معرَبها","وعَلتْ ذؤابتها على الضّبي",35,"ب",2,0],["الوزير الذي له الفخر حقاً","في بعيدٍ من الورى وقريب",36,"ب",1,0],["الواصل الجود فينا غير منقطعٍ","والفارج الحال منَّا بعدَ إرتاج",37,"ج",1,0],["الوزير الذي نهى الخطب عنا","فتعدَّى عنا ولم يتعدى",38,"د",2,0],["الوَجدُ يُطرِبُ مَن في الوَجدِ راحَتَهُ","وَالوَجدُ عِندَ وُجودِ الحَقِّ مَفقودُ",39,"د",1,1],["آل وهب ما رَوْعكُم أن نُهيتم","كم نُهيتم والنائراتُ خُفوتُ",40,"ت",1,0],["آل وهبٍ لقد علمتُ يقيناً","أن شعري بمجدكم مَنْخوتُ",40,"ت",1,0],["آلَ وَهْبٍ فوزاً لكُم بِسُلَيْمَا","نَ وكبتاً للحاسد المَفْئُودِ",41,"د",1,0],["آلُ وهبٍ قوم لَهُمْ عِفَّةُ المغْ","مِدِ أظفَارَهُ ونفْعُ الصَّيُودِ",41,"د",1,0],["الوارِثِ السُّؤْدَد أسْلافُهُ","ذي المجد من قَبْلٍ ومن بعْدِ",42,"د",1,0],["آلَ وهْبٍ قد استقرَّ هواكُم","في حَشا الدهر ثابتاً بل فؤادِهْ",43,"د",2,0],["الواحد الماجد الذي عدم ال","مِثْل فلم يلق ماجداً عشره",44,"ر",2,0],["الوارث المجد كلّ أصيدَ لا","يدفع تيجانه ولا سُرُرَه",44,"ر",2,0],["ألوَى بقلبك من غُصون الناسِ","غصنٌ يتيه على غصون الآسِ",45,"س",1,1],["ألومُ منْ يرتجي لحاقكَ في ال","مجدِ كما لا ألومُ من حَسَدَكْ",46,"ك",1,0],["آلَ وهبٍ هنِّيتُمُ هبة اللَّ","هِ فما زلتُمُ لها أشكالا",47,"ل",2,0],["أَلُوفُ عطرٍ تُذكَّى وهي ذاكيةٌ","إذا أساءتْ جوارَ العِطْرِ أبدان",48,"ن",1,0],["الواهِبُ الماءَةَ الجُرجورَ سائِقُها","تَنزو يَرابيعُ مَتنَيهِ إِذا اِنتَقَلا",49,"ل",2,0],["أَلوى عَلى الزَنبَقِ نِسرينُها","وَالتَفَّ عاريها بِكاسيها",50,"ي",3,0],["أَلواهِبُ البُختَ خُضعاً في أَزِمَّتِها","وَالبيضَ فَوقَ تَراقيها الدَنانيرُ",51,"ر",1,0],["الْوَداعَ الوَداعْ","يا جِبَالَ الهُمومْ",52,"م",1,0],["الويلُ في الدُّنيا التي في شَرْعِها","فأْسُ الطَّعامِ كريشَةِ الرّسَّامِ",53,"م",1,0],["الويْل للنَّاسِ من أَهْوائهمْ أَبداً","يمشي الزَّمانُ وريحُ الشَّرِّ تحتدمُ",54,"م",1,0],["الويلُ للحسَّاس في دنياهُمُ","ماذا يلاقي من أسًى وعَذابِ",55,"ب",1,0],["الويل كل الويل للحي الذي","في نفسه قد ماتت الآمال",56,"ل",1,0],["الوفد ان الوفد خير من","رثى ومن ندب",57,"ب",1,0],["الورد لا تقطفه من افنانه","فاخاف ان تتألم الافنان",58,"ن",1,0],["الورد في سُرُر الغصون مفتح","متقابل يثنى على الفتاح",59,"ح",1,0],["الوقت أضيق أن نغا","لط في الحقائق أو نكابر",60,"ر",1,0],["الوارِثونَ القُدسَ عَن أَحبارِهِ","وَالخالِفونَ أُمَيَّةً في الشامِ",61,"م",1,0],["أَلومُ مُعَذِبي فَأَلومُ نَفسي","فَأُغضِبُها وَيُرضيها العَذابُ",62,"ب",1,0],["الوَصلُ صافِيَةٌ وَالعَيشُ ناغِيَةٌ","وَالسَعدُ حاشِيَةٌ وَالدَهرُ ماشينا",63,"ن",2,0],["الوالِداتُ بَنيهُمُ وَبَناتِهِم","الحائِطاتُ العِرضَ كَالأَسوارِ",64,"ر",1,0],["الواحَةُ الزَهراءُ ذاتُ الغِنى","تُربي الَّتي ما مِثلِها في البِلاد",65,"د",1,0],["أَلومُ بِهِ مَن لامَني في وِدادِهِ","وَحُقَّ لِخَيرِ الخَلقِ مِن خَيرِهِ الوُدُّ",66,"د",1,0],["الواضِحينَ أُبُوّاتٍ وَأَجبِنَةٍ","وَوالِداتٍ وَأَلباباً وَأَذهانا",67,"ن",2,0],["الواسِعُ العُذرِ أَن يَتيهَ عَلى ال","دُنيا وَأَبنائِها وَماتاها",68,"ا",3,0],["الوجهُ أزهرُ لم يعرِضْ له كَلَفٌ","والعِرضُ أملسُ لم يحلمْ له أدَمُ",69,"م",1,0],["ألوذُ بكم من عَثْرةِ الجَدُّ إنّها","دهتني ولا ذنبٌ به أتلطَّخُ",70,"خ",1,0],["ألوانُها شَتَّى وأنواعها","متفقاتُ النَّجْرِ والمنْصبِ",71,"ب",1,0],["أَلوى إِذا طَعَنَ المُدَجِّجَ صَكَّهُ","لِيَدَيهِ أَو نَثَرَ القَناةَ كُعوبا",72,"ب",2,0],["أَلوَت بِمَوعِدِها القَديمِ وَآيَسَت","مِنهُ بِلَيِّ بَنانَةٍ لَم تُخضَبِ",73,"ب",1,0],["أَلوى إِذا شابَكَ الأَعداءَ كَدَّهُمُ","حَتّى يَروحُ وَفي أَظفارِهِ الظَفَرُ",74,"ر",1,0],["أَلوَت بِجِدَّتِها الأَيّامُ تُخلِقُها","بِمائِرٍ مِن رَبابِ المُزنِ أَو مورِ",75,"ر",1,0],["أَلِوَهمٍ أَم كُلُّ أَلفَينِ ما لَم","يُؤخَذا عِندَ مُبتَدا الوَعدِ أَلفُ",76,"ف",1,0],["الوارِثونَ مِنَ السَريرِ سَراتَهُ","عَن كُلِّ رَبِّ تَحِيَّةٍ مَأمولِ",77,"ل",1,0],["أَلومُ أَجَلَّ الناسِ قَدراً وَهِمَّةً","إِذا هُوَ لَم يَشرَه إِلَيها تَغَنُّما",78,"م",2,0],["أَلوى بِأَربَدَ عَن لَبيدٍ وَاِهتَ