,"((ناديتني))...على لسان الأنثى","https://www.poetsgate.com/ViewPoem.aspx?id=175647",""],[5956,"أرى وجه الإله على الزهورِ..","https://www.poetsgate.com/ViewPoem.aspx?id=192602",""],[5997,"حَنَاْنِيْكِ","https://www.poetsgate.com/ViewPoem.aspx?id=214254",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[6229,"مي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65188&r=&rc=14",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""],[6271,"زمان الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80699&r=&rc=5",""]],"verses":[["فَنَسجُكَ كَالديباجِ حَلّاهُ وَشيُهُ","وَفي النَسجِ ما يَأتي بِثَوبٍ مُرَقَّعِ",0,"ع",1,0],["فَنِساؤُنا يَندُبنَ نَوحاً","بَعدَ هادِيَةِ النَوائِح",1,"ح",1,0],["فَنَسْطَعَ شَمْسُ الْحَقِّ مِلْءَ سَمَائِهَا","وَتَطْلُعَ فِي لَيلِ الأَبَاطِيلِ أَنْجُمُ",2,"م",1,0],["فَنَسيتُم وَإِنَّما","أَنا لَم أَنسَ ذِكرَكُم",3,"م",1,0],["فَنَسُوكَ مثلَ النَّاسِ وانصرفوا","إلى اللَّهْوِ الجميلْ",4,"ل",1,0],["فنسيرُ نَنْشُدُ لهوَنا المعبودَ","في كلِّ الأُمورْ",5,"ر",1,0],["فَنَسيرَ في طُرق السُرور نَهتَدي","بحُفيِّهنّ بِأنجُم الأَقداحِ",6,"ح",1,0],["فَنَسينَ أَنَّكَ كَالبُدو","رِ وَدونَ رِفعَتِكَ البُدور",7,"ر",1,0],["فنسيتُ آبادَ الحياةِ وطولَها","وعرفتُ أنَّ الخلدَ بضعُ ثوانِ",8,"ن",1,0],["فَنَسِيمُ رُوحِي مِنْ أَثِيرِ هَوَائِهِ","وَقِوَامُ جِسْمِي مِنْ مِزَاجِ رَغَامِهِ",9,"م",2,0],["فَنَسِيمُهَا رُوحِي وَمَعْدِنُ تُرْبِهَا","جِسْمِي وَكَوْثَرُ نِيلِهَا مَحْيَا دَمِي",10,"م",2,0],["فَنَسِيمُهُ أَرِجٌ وَطَائِرُ أَيْكِهِ","هَزِجٌ وَجَدْوَلُهُ بَرُودُ الْمَبْسِمِ",10,"م",1,0],["فنسألُ الرحمنَ سبحانه","يخرجُنا منها بلا عاهَهْ",11,"ه",1,0],["فَنَسيتَها وَأَعَدتَها فَنَسيتَها","حَتّى مُدِحتَ بِذِكرِها فَذَكَرتَها",12,"ت",3,0],["فَنُسكُ أُناسٍ لِضَعفِ العُقولِ","وَنُسكُ أُناسٍ لِبُعدِ الهِمَم",13,"م",1,0],["فَنَسأَلُ العالِمَ إِنقاذَنا","مِن عالَمِ السوءِ الَّذي نَحُن فيه",14,"ه",1,0],["فَنَسِيتُ ما كَلّفْتِنيهِ وطالَما","كلّفْتِني ما ضَرّني تَكْليفُه",15,"ف",2,0],["فَنَسيرَ في طُرق السُّرورِ ونَهتَدي","بخفِيّهِنّ بِأنجُمِ الأَقداحِ",16,"ح",1,0],["فَنِساؤنا يَنْدُبْنَ نَوْحاً","حاً بعدَ هادية ِ النَّوائحْ",17,"ح",1,0],["فنسيتِ قصدك والطِّلاب","ووقَفتِ يذهِلُك السَّراب",18,"ب",1,0],["فنُسرِحُ في تلك البطاح نواظرا","تَنَقَّلُ من روض نضيرٍ إلى نهر",19,"ر",1,0],["فنسجت من وهج القريض قصيدتي","فعلامَ أُلْقَى تحت أقدامِ الحَذَرْ؟",20,"ر",1,0],["فنسيت ربّي كيف لا","وسجدت إجلالاً لهنّه",21,"ن",2,0],["فنسائم الإمساء عنك سألتها","فسلي نسيم الصبح عن أخباري",22,"ر",2,0],["فنسخة خدي اليوم بالسقم قوبلت","ألم تر فيها الدمع قد أوضح الكشطا",23,"ط",2,0],["فنَسوا هواي ولم يَفق","من ودّهم قلبى المشوق",24,"ق",1,0],["فنسوا الله الذي أبدعها","فائقا في صنعه حد الكمال",25,"ل",1,0],["فَنَسَمَاتُ تَحِيَّاتٍ يَغَارُ لَهَا","رَوْضُ الرُّبَى بَاتَ فِيهِ الطَّلُّ رَشَّاشَا",26,"ش",2,0],["فَنَسيمُ السُلافِ يَسري سُحَيراً","بِسُعودٍ فَيَستَفِرُّ النُحوسا",27,"س",2,0],["فَنَسمَعُ مالاً نَرتَضي مِن مَكارِهِ","وَنَظُرُ ما لا نَشتَهي فَلَكَ الحَمدُ",28,"د",1,0],["فنسأل الله يرحم","ويذهب الهم والغم",29,"م",1,0],["فنسأله سبحانه ان يقيمنا","على سنة الهادي لنا خير مرسل",30,"ل",1,0],["فنسأل الرحمن من فضله","يوفق الكل سبيل الصواب",31,"ب",1,0],["فَنَسيمُهُ ملءُ الأُنو","فِ وَحُسنِه ملءُ العُيونِ",32,"ن",1,0],["فنسأل اللّه لن رحمة","تغسل أدران قبيح الفعال",33,"ل",1,0],["فنسألهم ما الذوق قالوا مناله","عزيز فلا بالرسم يدرك والحد",34,"د",1,0],["فَنَسوا النِساءَ وَدَمَّروا ما دَمَّروا","وَرأوا بقا أَرواحِهِم أَرباحا",35,"ح",2,0],["فنَسْلى بِهَا عن ديارٍ نَأَيْنَ","ونَغْنى بِهَا عن مَغانٍ غَنينا",36,"ن",2,0],["فنسى هديلاً بعد موتك أحمد","أمسى عليك يضاعف الترجيعا",37,"ع",2,0],["فنسأل الله أن يبقيكَ في نعمٍ","تختال من فضله في الحلي والحُلَلِ",38,"ل",1,0],["فنَسيتُ إنشاءَ الرسائل كاتباً","ونَسيتُ أني كاتبٌ مُنذُ الصِّبا",39,"ب",2,0],["فَنَسخت حَسّان بنَ تُبَّعَ والَّذي","لاقَت جَديسُ وَطَسمُ مِن حَسّان",40,"ن",1,0],["فنسيم الروض صب وامق","راكد الأنفاس مما قد أجن",41,"ن",1,0],["فنسيت أولهم بآخرهم وأك","بَرَهُم بأصغرهم وزالت لوعتي",42,"ي",1,0],["فنسلو عن أعزتنا وننسى","نفائس في المقابر مودعات",43,"ت",1,0],["فنسقيهمُ كأساً سقونا بمثلِها","ونَعفُو ونَسخو اذ سَطَوا وتلوَّموا",44,"م",3,0],["فنسيم البشر أحيى المهجا","عندما أهدى إلينا الأرجا",45,"ج",2,0],["فنساله اللطف العميم بخلقهِ","وبان يعمّ عبادهُ بالرحمةِ",46,"ه",1,0],["فنستجلي النسيب كما اجتلينا","ونخفي رقة الشكوى ونبدي",47,"د",2,0],["فنسقي به مُرضِعات الربيع","رضيعَ الخمائل ماءً دفوقا",48,"ق",2,0],["فنسكن أرضاً تنبت العز دائماً","وتفخر بالقوم الكرام الأعزة",49,"ه",1,0],["فنساء سفرن بعد حجاب","ورجال هد الأسى وفحول",50,"ل",1,0],["فنسيت لي صنع الجميل وسمتني","خسفاً كأني ما صنعت جميلا",51,"ل",2,0],["فنسطَع مثلَ شمسٍ","على كلّ الأنام",52,"م",1,0],["فنسألُ مولانا كما قدَّرَ البَينا","وأسكَبَ مِن عَيني لفُرقَتِهِ عَينا",53,"ن",2,1],["فنَسألُ من نداكَ الرحبِ وصلاً","إلى الحَرَمينِ توصيلاً مُعَزَّز",54,"ز",1,0],["فَنَستَمِدُّ منَ المَولى لكُم مدداً","في العُمرِ وَالفَخرِ وَالإِذكارِ وَالطيبِ",55,"ب",1,0],["فَنَسيتُ نو مُتَغابِياً","وَعَجَزتُ عَن رَدِّ السُّؤالِ",56,"ل",1,0],["فنسدلُ دونَ رقبتها رِوَاقا","من الظلماء نُخلقهِ جِذَابا",57,"ب",2,0],["فَنَسأل رَب العَرش أَن يَجعَل التُقى","أَماما لِنَمحي بِالتقي الذَنب وَالوَزرا",58,"ر",2,0],["فَنَسأَلُ رَبَّ الناسِ طُولَ حَياتِكُم","وَتأييدَكُم بالعِزِّ وَالحِفظِ والنَّصرِ",59,"ر",1,0],["فنسبة الغرفة من برجه","تقضي له بالوسع في الاعتبار",60,"ر",1,0],["فنسأل المولى سعادة الأزل","واللطف في الدارين ما أمر نزل",61,"ل",1,0],["فنساءٌ بها تباري رجالاً","ورجال بها تباري النساء",62,"ا",2,0],["فنسيت الحسان بعد عذابٍ","ذقت فيه أمرَّ صدٍّ وهجر",63,"ر",1,0],["فنسأل ربنا عوناً بشكر","فقد أعطاك مفروج الأماني",64,"ن",2,0],["فنسبتي منها لفرط الضنى","نسبتها منه بلا كت",65,"ت",1,0],["فنساؤها ورجالها سيّان لا","يرضونَ إلّا بالجلاء المنتظَر",66,"ر",1,0],["فنسني الحظ منها","وخل حظي هناك",67,"ك",1,0],["فنسأل الله بأن ينفعنا","بحبهم ومعهم يحشرنا",68,"ن",2,0],["فَنُسوا عِصمَةً وَخافوا عَذاباً","وَغَدا الكُلُّ دمعُه في اِنسِجامِ",69,"م",1,0],["فنِساؤُهم صارت لغيرهمِ وقد","أُسِرَت بناتهمُ مع الشُبَّانِ",70,"ن",1,0],["فنُسلب من جورهم ملكنا","وأخلاقنا وكذا قد جرى",71,"ر",2,0],["فنسأل الله المعيد المبدي","يَروي لنا في الأرض كلَّ بُعدِ",72,"د",1,0],["فنساء من اللباس عوار","وبنات اني اميلت تميل",73,"ل",1,0],["فنسمح حتى بالنفوس تكرما","إذا لم نجد من بذل أنفسنا بدا",74,"د",2,0],["فَنَسيمُ المَساءِ يَسرِقُ عِطراً","مِن رِياضٍ سَحيقَةٍ في الخَيالِ",75,"ل",1,0],["فَنَسألُ الكَريمِ أن يَجعَلَنَا","مِنهُم وَأن يُيَسِّرَ النَّفَع لَنا",76,"ن",2,0],["فنسبته من رزانة عقله","وما حازه من صبره واحتماله",77,"ل",2,0],["فَنَسأَلُ اللَهَ تَسليماً نَنالُ بِهِ","صَبراً جَميلاً يُريحُ النَفسَ وَالبالا",78,"ل",2,0],["فنسبة الطب إلى العلوم","كنسبة البدر إلى النجوم",79,"م",1,0],["فنساء تجوس في غمرة الحر","بِ بجنب الرجال وسط الضرام",80,"م",1,0],["فَنَستَجِدُّ مَرتَعاً فمَرتَعاً","وَنَستجيدُ مُرتَعىً فَمُرتَعى",81,"ا",1,0],["فنسجُ القوافي على شفتيكِ","له طعم شهدٍ وريقك عنبرْ",82,"ر",1,0],["فنسيتَ صحبةَ مُخلصٍ لك وانثَنَي","تَ ومِلتَ عنِّي مثلَما همْ مالوا",83,"ل",3,0],["فنسابتِ النظراتُ يتبعُ بعضها","فسَلَبنَ من طَيّ الحشا زفراتِ",84,"ت",1,0],["فنسيت هدي رسولنا ونسيت داراً أخرويّه","فعلامَ مزقتِ الحجابَ وإنّه درع التقيه",85,"ي",2,0],["فنَسُوا الإلهَ وكيدَه وعذابَه","يا ويلَ مَن نسيَ العذابَ رهيبا",86,"ب",2,0],["فنسيم المساءِ فيها لهيبٌ","وشموس الصباحِ أقسى وأردا",87,"د",2,0],["فنَسِيْتُ جُرحًا مِثْلَهُ لا يُنْتَسَى","وأخافُ أن أنسى بأنيَ ناسِي",88,"س",2,0],["فنسألك اللهم عيدا مباركا","يعود علينا بالرجاء وما يُنوى",89,"و",2,0],["فنسخة حسنة قرئت وصحت","وها خط الكمال على الحواشي",90,"ي",1,0],["فنِسوتُنا بميْمنةٍ وخُصَّ","يسارهُ للعقالِ بِلا عقيلهْ",91,"ل",2,0],["فَنَسَيْتُ أَنِّي مِثْلُهُ لَمَّا اشْتَكَى","مَا ضَمَّهُ أَصْلُ الْعُرُوبَةِ بَلْ شَجَبْ",92,"ب",1,0],["فنسمعُ من سواقينا","أغانيَ مصرَ أوعَدَنِ",93,"ن",1,0],["فنسيته ونسيت أنيّ مؤمنٌ","شهَدَ الشهادةَ موْثقاً ولزاما",94,"م",2,0],["فنسأل من ربنا عونه","على ما نوينا من الجانبين",95,"ن",1,0],["فنسيتُ جرحي وانتفضتُ منادياً:","يا قومُ كُفّوا بالذي رفعَ السما",96,"م",2,0],["فنَسلَخ أثوابَ أمجادنا","وننزع جُبتنا المُبهِجه",97,"ج",2,0],["فنسأل أين نور الشمس يبقى","ودخَّان تخلل في الصدورِ؟!",98,"ر",1,0],["فنسأل ربي أن يثبت ديننا","علينا ويهدينا الصراط كمن هدا",99,"د",2,0],["فَنَسينَا كُلَّ الأمُور وَ طرْنَا","في فضَاء السَّعادَة المَمْدود",100,"د",1,0],["٢٦- فنسَجْتَ منْ زهْرِ المحبّةِ دعْوةً","فنما الشَّذا في الكعبةِ الغرّاءِ",101,"ا",2,0],["٤- فنَسَجْتُ من فِكري حروفًا علَّها","تحكي وإنْ شهِقتْ بوصْفِ المشْهدِ:",102,"د",1,0],["فنسي أو تجاهلاً قد تناسى","أنه لا يدوم حالٌ بحال",103,"ل",1,0],["فنسيتني..ونسيتَ كل أماكني","وهجرتني..كم كان حكْمك..قاسيا؟؟",104,"ي",2,0],["فنسخو بالصلاةِ وبالهدايا","ونهرب من مقارفةِ الشرورِ",105,"ر",1,0],["فنسْنِس حَبِيبِي بِرِيح التَّلَاقِي","وَأَدْرَك مَقَاْميْ بِتِلْكَ الْبَرَايَا",106,"ا",3,0],["فَنَسِيتُ حِقدِيَ كُلَّهُ","فِي صَحوِ فِكرِيَ , وَ الشُّرُودْ",107,"د",1,0],["فنُسعد بعضاً باشتراك سرورنا","ونُسعد بعضاً باشتراك أسانا",108,"ن",2,0],["فنسوا النساء ودمّروا ما دبروا","ورأوا بقا أرواحهم أرباحا",109,"ح",2,0],["فنسأل كيف يسرقنا ويمضي","ويبقى في القلوب له وجيب",110,"ب",1,0]]}