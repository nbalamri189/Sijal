{"poems":[[35,"ألا اصطبار لليلى أم لها جلد","https://www.aldiwan.net/poem25839.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12825","الوافر"],[123,"ألا اصفح عن الطرف الذي زل إذ جرى","https://www.aldiwan.net/poem4348.html","الطويل"],[133,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[342,"ألا أصبحت عرسي من البيت جامحا","https://www.aldiwan.net/poem45421.html","الطويل"],[412,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[473,"بتناثر المنثور في أغصانه","https://www.aldiwan.net/poem59600.html","الكامل"],[615,"","https://poetry.dctabudhabi.ae/diwan/poem/34545","المنسرح"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112439","البسيط"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206071","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62451","الوافر"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20920","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93424","الطويل"],[3023,"","https://poetry.dctabudhabi.ae/diwan/poem/31534","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67974","الوافر"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/47037","المتقارب"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77693","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89590","المجتث"],[1663,"ألا أصحوا بني عدنان من سكراتكم","https://www.poetsgate.com/ViewPoem.aspx?id=93222",""]],"verses":[["أَلا اِصطِبارَ لِلَيلى أَم لَها جَلَدٌ","إِذاً أُلاقي الَّذي لاقاهُ أَمثالي",0,"ي",1,1],["أَلا اصبر عليه نصف عصر فإنه","سيرقى به لو أنه منك يسلم",1,"م",1,0],["أَلا اِصَّدَّق عَلَيَّ بِحَقِّ فَوزٍ","فَقُلتُ لَها خُذي أَهلي وَمالي",2,"ل",2,0],["ألا اصفح عن الطرفِ الذي زلَّ إذ جرى","أيثبتُ طرفٌ فوقَهُ الناسُ والدهرُ",3,"ر",1,1],["ألا اصبر قليلاً إِنَّ فيَّ بقيَّةً","يَمُدُّ اليها الموتُ كفّاً وتَعسُرُ",4,"ر",1,0],["أَلا أَصبَحَت عِرسي مِنَ البَيتِ جامِحاً","عَلى غَيرِ شَيءٍ أَيُّ أَمرٍ بَدا لَها",5,"ل",3,1],["أَلا اصرِف إِلى صِدغَيهِ لحظك كله","وَدَع لَحظَه مُستَعمَلاً مِن نِصالِهِ",6,"ل",2,0],["أَلا اِصطَبَحتَ فَقَد غَدا دُرُّ النَدى","مُتَدَرِّجاً مِن فَوقِ شاذَروانِه",7,"ن",2,0],["إِلّا اِصبَحاني يَومَ السَعانينِ","مِن قَهوَةٍ عُتِّقَت بِكِركينِ",8,"ن",1,1],["ألا اصبروا للأذى فالناس تعرفكم","فطاحلا دركتم حرفة الأدب",9,"ب",1,0],["ألا أصبحت خنساء جاذبة الوصل","وضنت علينا والضنين من البخل",10,"ل",1,0],["ألا أصغوا أُناجيكم بقول","فليس اليوم لي عنكم مآبُ",11,"ب",1,0],["أَلا أَصبَحَت أَسماءُ في الخَمرِ تَعذِلُ","وَتَزعَمُ أَنّي بِالسَفاهِ مُوَكَّلُ",12,"ل",1,1],["أَلا اصرف إِلى صدغيك لحظك كُلَّهُ","وَدَع لَحظه مُستَغنياً عَن نِصالِهِ",13,"ل",2,0],["أَلا أَصبَحَت ظَمياءُ قَد نَزَحَت بِها","نَوىً خَيتَعورٌ طَرحُها وَشَتاتُها",14,"ا",1,1],["أَلا اصْغُوا أُناجِيكم بقولٍ","فليس اليومَ عنكم مَآب",15,"ب",1,0],["ألا اصمثت عن النطق بالترّ","هات ونهنه بها مقول الناطق",16,"ق",1,0],["أَلا اِصنَع بها يا دَهرُ ما أَنتَ صانِع","فَما كُنتَ إِلّا عَبدَها المُتَذَلّلا",17,"ل",2,0],["أَلا أَصغَ في ناجودٍ","تُريكَ مِنها الجَذلا",18,"ل",2,0],["ألا أصحوا بني عدنان من سكراتكم","وإلا علمتم من أجن وأسكرا",19,"ر",2,1]]}