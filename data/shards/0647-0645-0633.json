. عمر هزاع","https://www.poetsgate.com/ViewPoem.aspx?id=183618",""],[5794,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=80281",""],[5817,"فاتنة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191046",""],[5839,"عاشق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=62053",""],[5956,"إنك لحني ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181964",""],[5956,"أ حَيٌّ أنت ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182157",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5957,"يا غيثَ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=46976",""],[5974,"فيالق النور","https://www.poetsgate.com/ViewPoem.aspx?id=200260",""],[6093,"يا أيها العربي","https://www.poetsgate.com/ViewPoem.aspx?id=191866",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[6152,"ذبيح الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205876",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[6202,"خجلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86719&r=&rc=20",""]],"verses":[["هَمساً فَكَم أَسكَتُّ قَبلَكَ كاشِحاً","بِمَناقِبي وَعَلَيَّ فَضلُ مَزيدِ",0,"د",1,0],["هُمُ سادوا مَعَدّاً في صِباهُم","وَسادوا وَهُمُ شَبابٌ أَو كُهولُ",1,"ل",1,0],["هُمُ سَقَوا بِدَمِ الأَكْبَادِ عَزْمَهُمُ","وَبَاتَ فِي صَدَأِ الأَغْمَادِ مَاضِينَا",2,"ن",2,0],["هُمُ سَلَبوا الجَبابِرَ تاجَ مُلكٍ","بِطِخفَةَ عِندَ مُعتَرَكِ الكُماةِ",3,"ه",1,0],["همَسَتْ إليَّ بفضله","آثارهُ من قبل همسه",4,"س",2,0],["هُمُ سَعَوا بِاِبنِ عَفّانَ الإِمامِ وَهُم","بَعدَ الشِماسِ مَرَوها ثُمَّتَ اِحتَلَبوا",5,"ب",3,0],["هَمَسَ المَوتُ بِهِم هَمسَتَهُ","إِنَّ هَمسَ المَوتِ ريحٌ صَرصَرُ",6,"ر",1,0],["هُم سُقاةُ القُلوبِ بِالوُدِّ وَالصَف","وِ وَهُم تارَةً سُقاةُ العُقولِ",7,"ل",1,0],["هُمُ سادَةٌ غَيرَ أَنَّ النُجومَ","لَيسَت تُقاسُ بِبَدرِ السُعودِ",8,"د",1,0],["هُمُ سَرَقوا طِرفي وَقَد جِئتُ مادِحاً","لَهُم إِنَّ بَعضَ المَدحِ إِفكٌ وَباطِلُ",9,"ل",1,0],["هُمُ سَمِعوا يَومَ المُحَصسَبِ مِن مِنىً","نِدائي إِذِ اِلتَفَّت رِفاقُ المَواسِمِ",10,"م",1,0],["هَمَسَت في خاطري فاستيقظت","روحيَ الحيرى وأصغت لندَاها",11,"ا",3,0],["هَمٌّ سَرى ثُمَّ أَضحى هِمَّةً أَمَماً","أَضحَت رَجاءً وَأَمسَت وَهيَ لي نَشَبُ",12,"ب",1,0],["هم سواءٌ ولكلٍّ حقُّه","ذاك حكمُ اللهِ لا حكمُ الصَّنَمْ",13,"م",1,0],["هم سَخَّروهُ لأمرٍ ليس يَعرفه","فَاسْتنَّ يعصِفُ واستنَّتْ ضحاياهُ",14,"ا",2,0],["هُمْ سَادَةُ الحربِ من شِيبٍ وشُبّانِ","ساروا سِراعاً فما في القومِ من وَانِ",15,"ن",1,1],["هُم ساعَدوهُ كَما قَالوا الهِهِم","وَأَرسَلوهُ يَسوفُ الغَيثَ دُسفانا",16,"ن",2,0],["هُمُ ساجَلوه والسَّماحُ لأهْلِهِ","فأكدَوا وما أكدى وأصْفَوا وما أصفى",17,"ف",2,0],["هُمُ سَوَّدوا رَهواً تَزَوَّدَ في اِستِهِ","مِنَ الماءِ خالَ الطَيرَ وارِدَةً عَشرا",18,"ر",2,0],["همسَت نجمَةٌ بأذن أخيها","همسَ ثغرِ الندى بمسمَعِ ورد",19,"د",1,0],["هَمَساتُ الشبابِ في النفس أحلى","من حديثِ الهوى ومن هَمساتهْ",20,"ت",2,0],["هم سمَّمُوا نيلَ الحمى بثغورهم","فمتى نذوقُ النيلَ غيرَ مسمَّم؟",21,"م",1,0],["همسة عالية أم نهمة","أم شرور النفس ترمي بالشرر",22,"ر",1,0],["همست بها الأرواح في ملكوتها","شدوا أرقّ من الصّبا وزفيرا",23,"ر",2,0],["همس الفردوس هل من نبأ","عن ربى الغوطة معسول الرّجاء",24,"ا",2,0],["هم سطر قدس خط في لوح حكمةٍ","بحبر جلال ما درى رمزه القرا",25,"ر",2,0],["هُمُ سادَةُ الساداتِ في كُلِّ مَوطِنٍ","وَخيرَةُ رَبِّ الناسِ في كُلِّ مُعضِلِ",26,"ل",1,0],["هُمُ سَلَبوا كِسرى بنَ ساسانَ مُلكَهُ","وَقَبلَهُمُ عَقَّ المُلوكَ وَما عُقّا",27,"ق",2,0],["هم سادتي هم أهل كل سماحة","هم قادة داعون للتواب",28,"ب",1,0],["هَمَستْ: حَذاري إنّ كأسِي علقمٌ","قُلتُ امْزِجيهِ لِتَعتلي حَبَبًا سَقَرْ",29,"ر",1,0],["هُم سُيوفٌ للمُصطفى ورماحٌ","وَهوَ رَأسٌ وهم له أعضاءُ",30,"ا",2,0],["هُم سُيوفٌ للَّه جلّ تعالى","وَلَها في يدِ النبيِّ اِنتضاءُ",30,"ا",2,0],["همٌّ سرى في أضلعي وسرى بي","فالبرقُ سَوْطي والظلامُ ركابي",31,"ب",2,1],["هُمُ سَوَّدوا هُجناً وَكُلُّ قَبيلَةٍ","يُبَيِّنُ عَن أَحسابِها مَن يَسودُها",32,"ه",2,1],["همس التليفون إن جاد الحبيب به","في هدأة الليل يشجيني فيرضيني",33,"ي",1,0],["هم سمموا دين الاله ونافقوا","بدخولهم فيه دخول خؤون",34,"ن",1,0],["هُمُ سَواسِيَةٌ في","هَيئاتِهِم كَالمُسوخِ",35,"خ",1,0],["هم سادةُ الدُنيا وَساسةُ أَهلها","فمن ذا يناوي فخرهم وَيُقاومُه",36,"م",2,0],["هُمُ سادةُ الدنيا وَساسَةُ أَهلها","وهم غررُ العَليا وأَنجمُها الزُهرُ",37,"ر",1,0],["هُمُ سِمامُ العِدى إِن غارَةٌ عَرضت","وَهم غَمام النَدى والفَضل إِن سَمحوا",38,"ح",3,0],["همسات قلبك حدثت","عما بقلبك من جراح",39,"ح",1,0],["همسات النهر تكسو","ه جمالاً وبهاءَ",40,"ا",2,0],["هُمُ سَلَبوا لبّي بِباهر لُطفِهم","غَراماً وَقَلبي لا يَزالُ مُتَيَّما",41,"م",2,0],["هُمْ سَبَوا قلبيَ حتّى لم أجِدْ","مَوضعاً فيَّ لسرّي غيرَ عَيْني",42,"ن",2,0],["همُ سابَقوني بالفخار فقصّروا","وهم طالبوني بالإباء فما طالوا",43,"ل",3,0],["هُمُ سنّوا الحجا فالطو","دُ لولاهم لما حَلُما",44,"م",2,0],["هُمُ سَدّوا عَلَيكُم بَطنَ نَجدٍ","وَضَرّاتِ الجُبابَةِ وَالهَضيبِ",45,"ب",1,0],["همسَتْ بأصوات الطُغاة فكاد أنْ","لا يستهلَّ بهم لِسانُ جَنينِ",46,"ن",1,0],["همَسَتْ لهُ الدنيا بصوتِ حبيبةٍ :","كُتِبَ الهوَى فَرْضاً عليكَ فَصَلِّهِ",47,"ل",2,0],["هُم سادةٌ قد أُنزِلَت","في فَضلِهم سورُ العزائِم",48,"م",1,0],["همُ سهلوا للهدي والزهدِ مهيعاً","عليه بنى في سيره كلُّ سائرِ",49,"ر",1,0],["همُ سفنُ النجاة لراكبيها","هُم السّبُلُ المطهرة الرِّحاب",50,"ب",1,0],["همُ سَوَّموا لَيْلِي وصُبْحي كتائباً","من الروم تَغْزُوني وتَخْلُفها الزُّطُّ",51,"ط",1,0],["هم سادةُ النادى وحُمْسُ رجاله","وبدورُ ناشئةٍ الظلام الأليْل",52,"ل",1,0],["همُ سيوفُ اللَّه يوم الوغى","همُ ضراغمُ الخميسِ اللُّهام",53,"م",1,0],["هم سادة عصبة أبناء ملحمة","لا يرتضون سوى ما كان يرضاه",54,"ا",2,0],["هم سادة صحب سراة أولي","صيد دعاة الخير نخب كرام",55,"م",1,0],["هم سادة شرفوا بصحبته فلذ","بجنابهم واسأل بهم وتوسّل",56,"ل",1,0],["هُمْ سَرَاةٌ يُعْزَوْنَ فَخْراً إلَى الفَا","رُوقِ نَجْمِ الهُدَى وَلَيْثِ الصّيدِ",57,"د",1,0],["همُ سايروا الدنيا وداروا مدارها","وجدّوا جميعاً عندها حين جدّتِ",58,"ت",1,0],["هُم ستّةٌ لهم السلامة سابعٌ","وَالمجدُ ثامن والمفاخر تاسعُ",59,"ع",1,0],["هم سر وحي الله والدوحة التي","نمت فزكى فرع لها وأصول",60,"ل",1,0],["هُمُ سَلَبوني الصَبرَ وَالصَبرُ مِن شاني","وَهُم حَرَموا مِن لَذَّةِ الغُمضِ أَجفاني",61,"ن",2,1],["هم سادة في الناس عزَّ نظيرهم","من قاسهم بسواهم ما أنصفا",62,"ف",2,0],["هم سبيل الورى للرشد إن خرجت","عن الطريقة أو ظلت بها السبل",63,"ل",1,0],["هم سارروني بعلم الغيب فاتضحت","معالمي فسرى لي منهم الجذل",64,"ل",1,0],["هُم سادَتي وَرَجائي إِن أَموت عَلى","ما عِشتُ فيه مِن الدُنيا بِحُبِّهم",65,"م",1,0],["هم سبكوا السجايا الغر تبراً","وأبقوهن للأبناء ذخرا",66,"ر",2,0],["هُمْ سواهم على الإلهِ أد","لاّء ولا يهتدى له لولاها",67,"ا",3,0],["همسات في ضمير الدهر ما","فتئت توقظ حشد النائمين",68,"ن",1,0],["هم سفراء الله بين عباده","ولاؤاهم فرض على الحر والعبد",69,"د",1,0],["هم سبعة ذاقوا الردى بشجاعة","لم يألفوا في النائبات سواها",70,"ا",3,0],["هُمُ سَاعِدُ الدهر الذي يتقى به","وماخيرُ كف لا تَنُوءُ بساعد",71,"د",1,0],["هم سنَنَوا لِتابعِيهم سُنّةً","سَما بها الى العُلا مِن اقتدى",72,"ا",1,0],["هم سادات من ولدته حوا","وآدم من بني حام وسام",73,"م",1,0],["هم سر وحي اللَه من بفضلهم","ومدحهم محكمه قد صدعا",74,"ع",2,0],["هُم ستَّةٌ ونصفُ فَوقَ مامي","والنَّطحُ في الغروب ياهُمامي",75,"ي",1,0],["هُم ستَّةٌ ونصفُ والمربَّعُ","تِسعٌ تضيق والمسحَلانِ فَآسمَع",75,"ع",1,0],["هُمُ سَبعَةٌ أيضاً على جاهِ سَبعَةٍ","ذَخِيرَتُهُم يا نِعمَها من ذخايِِر",76,"ر",1,0],["هم سَبعَةٌ لهنَّ سَبعَه أحرِفِ","والمبتدا من الأحَد فاعرِفِ",77,"ف",1,0],["هُم سِتَّةٌ وَرُبعُ فيهنَّ النَّفَس","قِسهُنَّ إن كَانَ مبيناً أو غَلَس",78,"س",1,0],["هُم سَبعةٌ ونفُ في ذا الوصفِ","والفرقَدَانِ ثمانِيَه مَع نَصِفِ",78,"ف",1,0],["هم سادة الدنيا هم شيدوا العلي","بهم لا بها تعلو العلي والمراتب",79,"ب",1,1],["هم سادة من بني الزهرا وآل وفا","نجل ابن عم النبي البين الآيات",80,"ت",1,0],["هم سبايا شعري وعزمي ومجدي","بقري منهم الحلوب وشائى",81,"ا",2,0],["هم ساترون لضعهم","بنضالهم ومراسهم",82,"م",1,0],["هُم سادة يَقضي الزَمان بِكَونهم","إِذا سالَموا شَهداً وَإِن حارَبوا ربدا",83,"د",2,0],["همُ سودوا وجه العطايا بمنهم","وهم كدروا صفو المكارم بالمطل",84,"ل",1,0],["هم سادة الكونين والدين الذي","جاءوا به هو سيد 