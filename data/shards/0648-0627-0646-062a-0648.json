,[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5386,"الجهات الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=35001",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5431,"خيانة الأوراق...","https://www.poetsgate.com/ViewPoem.aspx?id=202740",""],[5578,"لى بابِ الرجاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205581",""],[5616,"أفكار","https://www.poetsgate.com/ViewPoem.aspx?id=203325",""],[5616,"عواصم","https://www.poetsgate.com/ViewPoem.aspx?id=203338",""],[5616,"جمعة حسين","https://www.poetsgate.com/ViewPoem.aspx?id=203500",""],[5616,"أفكار","https://www.poetsgate.com/ViewPoem.aspx?id=206871",""],[5634,"أدنو بودي وحظي منك يبعدني","https://www.poetsgate.com/ViewPoem.aspx?id=181462",""],[5677,"طلب إجازة :!","https://www.poetsgate.com/ViewPoem.aspx?id=179889",""],[5691,"خُلقْنا أُناساً...!","https://www.poetsgate.com/ViewPoem.aspx?id=207459",""],[5703,"قل كل شيءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=208793",""],[5740,"ألاَ اخْرَسْ فَهذاَ مِنْك أعْلا وأكبَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=211476",""],[5756,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=5417",""],[5974,"مُلْهِمَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=201158",""],[5974,"مرافئ الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=214988",""],[6152,"وليّ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=203707",""],[463,"أشاقكَ منْ حسناءُ وهنا طروقها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60156&r=&rc=212",""]],"verses":[["وَأَنتَ وَإِن كُنتَ بَحرَ السَما","حِ فَخَيرُ مَواهِبِكَ العاجِلُ",0,"ل",1,0],["وإنْ تُؤثِرْ دُنُوَّهُمُ تُمارِسْ","أذىً تَجِدُ العَناءَ بهِ طَويلا",1,"ل",2,0],["وَأَنتَ وَفِيٌّ لايُذَمُّ وَفاؤُهُ","وَأَنتَ كَريمٌ لَيسَ تُحصى مَكارِمُه",2,"م",2,0],["وَأَنتَ وَأَنتَ دافِعُ كُلِّ خَطبٍ","مَعَ الخَطبِ المُلِمِّ عَلَيَّ خَطبُ",3,"ب",1,0],["وأنت وإن فتكت بحبِّ نفسي","وصاحبِ لذتي دون الصِّحابِ",4,"ب",1,0],["وأنتَ وإن أُفْردْتَ في دار وَحْشَةٍ","فإني بدار الأنْسِ في وحْشة الفَرْدِ",5,"د",1,0],["وأنت وإن أبصرت رشدك كلّهُ","فذو المنظر الأعلى برشدك أبصر",6,"ر",1,0],["وإن تُؤخِّر قِصاصَ ذي عَوَزٍ","يشكْركَ والشكرُ خير ما ثمرَهْ",7,"ر",2,0],["وأنت وَسطْتَ الحالتين ولم تزَل","لك الواسطاتُ الزهْر من كل جوهر",8,"ر",1,0],["وإن تولت فريَّا الخلق تتبعها","أردافُها من قلوب الناس أردافا",9,"ف",2,0],["وَأَنتَ وَلِيُّ العَفوِ فَاِمحُ بِناصِعٍ","مِنَ الصَفحِ ما سَوَّدتُ مِن صَفَحاتي",10,"ت",2,0],["وَأَنتَ وَلِيُّ الحَقِّ تَقضي بِفَصلِهِ","وَأَنتَ وَلِيُّ العَفوِ إِذ هُوَ مُذنِبُ",11,"ب",1,0],["وَأَنتَ وَالناسُ يَومَ البَأسِ قَد عَلِموا","كَالنارِ حينَ أَطارَ الجاحِمُ الشَرَرا",12,"ر",2,0],["وَإِن تَوَلَّت فَأَحرى أَن تَجودَ بِها","فَالجُودُ فيها إِذا ما أَدبَرَت خَلَف",13,"ف",1,0],["وَأَنتَ وَقَد أَفَدتَ ضَحوكُ ثَغرٍ","وَيَبدو بِالبُكاءِ وَما أَفادا",14,"د",2,0],["وَإِن تَوارى بِشَخصِهِ هَرَباً","مِن راحَةٍ في اِعتِمادِها خَيَفُ",15,"ف",1,0],["وَأَنتَ وَقَد مَجَّت خُراسانُ داءَها","وَقَد نَغِلَت أَطرافُها نَغَلَ الجِلدِ",16,"د",1,0],["وَإِن تَوَرَّدتُ مِن بَحرِ البُحورِ نَدىً","وَلَم أَنَل مِنهُ إِلّا غُرفَةً بِيَدي",17,"ي",1,0],["وإن تولّي ذاهباً تضطرب","خلفكَ مثل الدعصِ مَرمارَه",18,"ر",2,0],["وَإِنْ تَوَارَتْ رَقَدْتُ مُغْتَبِطَاً","بِمُلْتَقَى لِلغَدَاةِ مُنْتَظَرِ",19,"ر",1,0],["وإن توجَّدْنا على البخائلِ","المُستمنحات بلا وسائل",20,"ل",1,0],["وانت وجدك المعبوث فينا","امام شامل للخائفين",21,"ن",1,0],["وأنت وحق الحب في الحسن آية","تعالت وجلّت أن يقاس بها مثل",22,"ل",1,0],["وأنتَ والحُزنُ كونا في الضُلُوعِ معي","إِني عَهِدتُكُما من خَيرِ جُلاسي",23,"س",2,0],["وَأَنتَ وَما في الخَلقِ مِنكَ مُعَوَّضٌ","لَهُم عِوَضٌ مِن كُلِّ ما هُوَ ذاهِبُ",24,"ب",1,0],["وَأَنتَ وَالحَقُّ بادٍ غَيرُ مُكتَتَمٍ","أَعلى الفُروعِ الَّتي طالَت بِها الجِذَمُ",25,"م",1,0],["وأَنتَ واللهِ يا سُؤلي ويا أَملي","أَعزُّ في مهجتي مما أَراكَ بِهِ",26,"ب",2,0],["وأنتَ وردي فما يعيبكَ أن","ينبتُ يا وردُ قبلكَ الورقُ",27,"ق",1,0],["وان توهمني أني اشابهه","نظماً ونثراً فليس الأمر مخفي",28,"ي",1,0],["وَإنْ تَوَخَّى رَداهُم فَالقَضاءُ لَهُ","إِلَى انقِضَائِهِم رِدْءٌ يُؤاخِيهِ",29,"ي",2,0],["وإِن توقَّفَ جَهلاً بالجَوابِ فَقُل","حَفِظتَ شَيئاً وَغابَت عنك أَشياءُ",30,"ا",2,0],["وَأَنتَ وَالكافُ مُلغةُ كَقائِدِهِم","أَلا رَآكَ فَريقَ مِن مَذاهِبِهِم",31,"م",1,0],["وأنت وأنت الهوى والجمال","ومنعايَ بين معاني الحياه",32,"ه",1,0],["وأنت وأنت المنى والشباب","تعيشين في عالمٍ لا أراه",32,"ه",1,0],["وأنت وسهمك الخالد","ما تفنى له حرب",33,"ب",1,0],["وأنت والكون بما يحتويه","تضيق بالكون وبالكائنين",34,"ن",1,0],["وَأَنتَ وَفَخْرُ الدِّينِ أَدْعُوكُما مَعَاً","خَلِيلىَّ لا بَلْ سَيّدَيَّ وَفَوْقَ ذا",35,"ذ",2,0],["وَأَنتَ وَلا وَاللَهِ أَنَّكَ حامِلٌ","بِخاطِرِكَ الجَوّالِ مِن جودِهِ الرُعبُ",36,"ب",1,0],["وَإِن تَولَّيتُ عَنكُم فعَلى","قَلبي لَكُم مِن غَرامِه والِ",37,"ل",1,0],["وإن تَوَلَّتْ فَفؤادي كما","علِمْتَ في اللأواءِ جُلمودُ",38,"د",1,0],["وأنت وحدك فيهم عسكر لجب","سود الوقائع من راياتك الحمر",39,"ر",1,0],["وَأَنْتَ وَرِثْتَ الأَكرمينَ عُلاهُمُ","وعالَتْ على قومٍ سِواكَ المَوَارثُ",40,"ث",1,0],["وأنتَ ورِثْتَهُ طِفلاً ولكن","رَجَحتَ عَلَى الرجالِ بِحلمِ كَهْلِ",41,"ل",1,0],["وأَنْتَ وَسِعْنَ بِهِنَّ الرجالَ","ملابِس فالبَسْ لَهُنَّ الخُلُودا",42,"د",2,0],["وأَنْ تؤنِسا مَا أَوْحَشَتْ مِنِّيَ النَّوى","وأَن ترفعا مَا مَزَّقَ الدهرُ من جَمْعِي",43,"ع",2,0],["وإِن توددعتَ اَسرارا فكن أُذنا","صماء ما سمعت في الحال ما شرحا",44,"ح",2,0],["وأنتَ والسلطانُ ما نلتَه","موطَّأُ الظّهر سليسُ الحزيمْ",45,"م",1,0],["وأنت وإن هجنتها العامَ شاهدٌ","لها كيف يأتي حلوُها ورشيقُها",46,"ق",3,0],["وأنت والشبابُ لي","خميلةٌ ومُطرَفُ",47,"ف",1,0],["وأنت وإن دافعوك الإمامُ","وكان أبوك برغم الأنوفِ",48,"ف",1,0],["وأنت وإن كنتَ جنِّبتها","فلم ترعَ فيها ولم ترتعِ",49,"ع",1,0],["واِنْ توهَّم قومٌ أنَّه حُمُقٌ","فطالما اشتبهَ التَّوْقيرُ بالحُمُقِ",50,"ق",1,0],["وأنت وليها السامي مقامي","على الفضلاء من عرب وفرس",51,"س",1,0],["وإن توسعت في الدوحات مقتطفا","فالزهر لا يجتني إلا من العود",52,"د",1,0],["وأنّ تواضعَ اليوم","غداً يُدفعُ إحسانا",53,"ن",2,0],["وان توالت علينا من نواك المحن","صبراً عسى عن قريب رويتك ينمحن",54,"ن",1,0],["وَأَنتَ وَسيلَتي في جَبر كَسري","وَأَنتَ ذَخيرَتي في كُلِّ حالِ",55,"ل",1,0],["وأنتِ وإنْ لم نلق عندك راحةً","أحبُّ إلينا من سواك وأشغفُ",56,"ف",1,0],["وَإِنْ تَوقّفتَ عَن مَغْنَى العُلا فعلى","وادي الفَضيلة تَوقيفي وتَحبيسي",57,"س",2,0],["وأنتِ وإنْ أوقدتِ في القلبِ جمرةً","تَلَظَّى على كَرِّ اللّيالي وتَلْفَحُ",58,"ح",1,0],["وأنت والعقل فاني والذي في الحقلْ","واعده في الغيبْ واتبعْ ما أتى في النقلْ",59,"ل",1,0],["وأنت وَعَدتنا بالعيد يا من","مُحيّاه ينوب عن الهلالِ",60,"ل",1,0],["وأنت وصف بك التعيين منفصل","وأنت ذات بك الأسرار تتصل",61,"ل",1,0],["وأنت وصيّ المُصطفى وابنُ عمِّهِ","فإنّا نُعادي مُبغضيكَ ونَتركُ",62,"ك",1,0],["وأنت وعاء علوم الإله","ومؤتمن اللَه في سره",63,"ر",2,0],["وَأَنتَ وَزير للمروءة ناصر","بِحَزم يَفيض العَدل مِن ماء نَهره",64,"ر",2,0],["وَأَنتَ وَزير عادل فيكَ عفة","وَحسن سَداد بِالصَلاح كَفيل",65,"ل",1,0],["وإن تؤاخذهمُ يوماً بما فعلوا","بغياً عليك فقد عظَّمت شأنهم",66,"م",1,0],["وأنت وإن مكنت حصنك مشفق","على الخلق من أن يدهم الخلق داهم",67,"م",1,0],["وأنت وإخوانك المصلحون","لمصر ضمان المصير الحسن",68,"ن",1,0],["وإن توسَّلْتَ بالنبي تجدْ","مقالَ صدقٍ من غير مذَّاق",69,"ق",1,0],["وإنْ توسلتُ بالحسودِ فقد","أعرتُ يوم الأمطار ميزابي",70,"ب",2,0],["وإن توانيت فلا حيلة","قد ينضب السيل ويجفو المطر",71,"ر",1,0],["وإن توانيت بي غدوت غدا","من بعض قتلى القتيل قر عنده",72,"د",2,0],["وَأَنتَ وَالشمس بِاتفاق","حللتما أَشرف البُروج",73,"ج",1,0],["وَإِنْ تَوَعَّرْها نِقَاب الأَوْعَرِ","ذَلَّتْ وَإِنْ شَازَرْتُها بِالْمِشْزَرِ",74,"ر",1,0],["وأنت وريث ذاك الشيخ قطعا","بآداب وعلم واقتفاء",75,"ا",2,0],["وان توالت احرفٌ مضارعَه","لبعضها في الوضع والمتابعه",76,"ه",1,0],["وأنت وسعت الكل علماً ورحمة","وربيت بالرحمى الخليقة كافيا",77,"ي",2,0],["وَإِن تَوَلّى اِمرُؤٌ بِشُكرِ يَدٍ","فَاللَهُ يَجزي بِها وَيَشكُرُها",78,"ر",3,0],["وإن توارى الحيا عن حي كاظمةٍ","عرِّض بذكر النوى فالدمع يبديه",79,"ي",2,0],["وأن تُوْسِعَ الأيامَ جوداً ونجدةً","وما ليس يخلو منه عَقْدٌ ولا حَلُّ",80,"ل",1,0],["وانت واقاصدَ الرواح","لا تهامه على البريد",81,"د",1,0],["وَأَنتَ وَإِبناكَ لَم يوجَدُلَكُم مَثَلٌ","ثَلاثَةٌ كُلُّهُم بِالتاجِ مُعتَصِبُ",82,"ب",1,0],["وَإنْ تَوَقفْتَ فَمَنْ أسألُ","فَهَذِهِ جَمرَةُ نَارِ الغَضَا",83,"ض",2,0],["وإن توضأت بلانيةٍ","فصل للفرضِ وللأجرِ",84,"ر",1,0],["وأنت وانت من لحم ودمٍ","تظل على سكوتك مستمرا",85,"ر",2,0],["وَأَنتَ وَلَيتَ هَذا العَبد مُفتَرِساً","سَبعَ سِنينَ وَكُلُّ النَّاسِ تَشكيهِ",86,"ي",2,0],["وأنت وإنت كنت الجوادَ بعينه","فلستَ بمُعطي الناسي ما اللَه مانعُ",87,"ع",1,0],["وَأَنتَ وَلِيُّها وَبَرِئتَ مِنها","إِلَيكَ وَما قَضَيتَ فَلا خِلاجا",88,"ج",2,0],["وَأَنتَ وَهَبتَها كوماً جِلاداً","أُرَجّي النَسلَ مِنها وَالنِتاجا",88,"ج",2,0],["وأنت وجود الهاء مهما تعبدت","وأنت وجودُ الواو مهما تعبَّدا",89,"د",2,0],["وان توافقه في طول الحياة يرى","جميع ما هو من دنياه راغبه",90,"ب",2,0],["وانت ومن انت انت الَّذي","تزمل بالحمد وادثرا",91,"ر",2,0],["وأنت وربي اللَه مولاي لم أزل","إلى خير شعب من ولائك أنتمي",92,"م",2,0],["وإِنْ تَوَدَّدْتَهُمْ لانُوا، وإِن شُهِمُوا","كَشَفْتَ آسادَ حَرْبٍ غَيْرَ أغْمارِ",93,"ر",1,0],["وإن تودَّدتهم لانوا وإن شهموا","كشّفت أذمار حربٍ أيّ أذمارِ",94,"ر",1,0],["وإن توددتهم لانوا وإن شهموا","كشفت أذمار شر غير أشرار",95,"ر",1,0],["وانت ولي عهدهما المفدى","ومنصبك الجديد من الشهود",96,"د",1,0],["وَإِن توهمتَه طَويلا","إِلا كما بَينَ هاوهاتِ",97,"ت",1,0],["وانت واطاوي البطاح","وا مؤمّن على البريد",98,"د",1,0],["وأنت واثق نفسٍ","بخدمة المخلوق",99,"ق",1,0],["وإن توقّفْت أغرق","في حمأة الرغبات",100,"ت",1,0],["وَإِن تَولت فجرعها بِها سحراً","وَإِن هِيَ استحلت المَرعى فلا تسم",101,"م",1,0],["وأنت ورقاء روضى ليس يفدحني","سوى جواك على غصنى وأوراقي",102,"ق",2,0],["وأنت والناس جميعا تدري","قليل لب وكثير قشر",103,"ر",1,0],["وأنت وحسبي أنت تعلم أنَّ لي","لساناً وراءَ المجدِ يبني ويهدمُ",104,"م",1,1],["وَإِنْ تُوقِدُوا نَارَ الحَرِيقِ فَكَمْ أَضَا","وَنَارُ فُؤادِي فِي حَشَا الْوَالِهِ الصِّبِّ",105,"ب",1,0],["وأنتَ وسمتَ بالمعروفِ رِقّي","ورقّ الخيل تحفظ بالوُسومِ",106,"م",1,0],["وأنت واللهِ في علمٍ وفي عملٍ","من يستقيمُ به في العالم العِوَجُ",107,"ج",1,0],["وَإن تُؤَكِّد جُملَةً فَمُضمَرُ","عَامِلُهَا وَلَفظُها يُؤَخِّرُ",108,"ر",1,0],["وَإن تُؤكَّدِ الضَّمِيرَ المُتَّصِل","بِالنفسِ والعَينِ فَبَعدَ المُنفَصِل",108,"ل",1,0],["وَإن تَوَالَيَا وَقَبلُ ذُو خَبَرا","فَالشرطَ رَجِّح مُطلَقاً بِلاَ حَذرَ",108,"ر",1,0],["وانتَ وكيلَ اللَهِ قمتَ لبيتهِ","اميناً طليقَ الحُكمِ فيهِ بما تقضي",109,"ض",2,0],["وَإِن تَوَلَّت فَقَد لَها تَرَكَت","ذِكراً سَيَبقى عَلى الأَعاصيرِ",110,"ر",1,0],["وَإِن تُؤَرِّخَ بِنا بَشِّر بِمَولِدِها","رَدَّ الزَّمانِ إِلى الأَيّامِ بَلقيسا",111,"س",2,0],["وأنت وهذان حتّى الممات","بمنزلة السّمع بعد البصر",112,"ر",1,0],["وإن توثر سواك به ففضل","تنال به ثوابَ الموثرينا",113,"ن",2,0],["وأنت وكيلي يا وكيل وحسبيا","إذ أنت وكيلي في حياتي وفي قبري",114,"ر",2,0],["وإن توالى صياح الناعقين على","أذني عرتني منه حكلة العجم",115,"م",1,0],["وإنَّ تواضعَكُم للصغار","أعلى مقامَكُمُ في الرتَب",116,"ب",1,0],["وإن تَولدَ بكرِ الفُتوحِ","إذا ضُرِبَتْ بالذكور الذكورُ",117,"ر",1,0],["وأنت واحد فضل","وفضلك المتلالي",118,"ل",2,0],["وأنت ورب الراقصات زَعيمها","ولولا حذار اللوم قلتُ إمامها",119,"م",3,0],["وَأَنتَ وَسيلَتي دنيا وَأُخرى","وَسيلَةُ مؤمنٍ لِلأَمرِ راضِخ",120,"خ",1,0],["وَأَنتَ وَسيلَتي دنيا وَأُخرى","فَسَل مَولايَ يُحسِن لي المَآبا",121,"ب",2,0],["وانت وحيد هذا العصر لا بل","فريد الدهر مفقود المثال",122,"ل",1,0],["وأنت والحق يا أقضى الانام به","غدا على الحوض حقا تحشران معا",123,"ع",2,0],["وإنْ تَوَكَّأَ مِثلِي بالضَّيَاعِ بَكَى","بُكَاءَ مَن ضَيَّعَت رِجلَاهُ ما رَأَتَا",124,"ت",2,0],["وإن (توروس دردليان) أوصى","ببحث كان ضمن الأولينا",125,"ن",2,0],["وإنْ توهجتِ للإعجازِ في فلَكٍ","بدَتْ جميعُ اللُّغى لاتحسنُ الوَمْضَا",126,"ض",2,0],["وأنت ولم تحجم وثبت مشمراً","تقاتل قوماً قاتلوا الفقراء",127,"ا",2,0],["وإِنْ تَوَارَت ، كَأَنَّ الشَّمسَ مَا سَطَعَتْ","فَيَا لِقَلبيَ إِمَّا غَابَ مُشْمِسُهُ",128,"س",2,0],["وانت واعي واظنّك ماتغرّ الدليل","وشتبي بالنشايب جعل عمري فداك",129,"ك",1,0],["وانتو شعب ولازمو عرص","نهب مالو يكون قانونو",130,"ن",2,0],["وأنت وحشةُ منفى في قصائدها","كل المحبين قد هاموا وقد تاهوا",131,"ا",1,0],["وإن توارى أمل لم يعد","للوصل بعد الفصل من منطق",132,"ق",1,0],["وأنت وعبادة القبور ومن على","طرائق أهل الزيغ ممن تجهما",133,"م",2,0],["وانتَ ولا همّك تطاولني مزيد من ................. حلاك","من أوّل الليل .. لتوالي الليل حلوك .. ما أوجعه !",134,"ع",2,0],["وأنتَ وحْدكَ صوْتٌ صادحٌ أبداً","وأمّةُ العرْبِ لا قوْلٌ ولا فِعْلُ",135,"ل",1,0],["وأنت وحدك من في الذات أعرفني!","فأنت في نظري شمسٌ وآفاقُ!",136,"ق",1,0],["وأنتَّ وجودى فى شهودى وغيبتى","وسِرُّك نور النُّور أو هو روحُ",137,"ح",1,0],["وإن توكأت في يوم على جسدي","فاعلم بأن حبيبي زادني رهقا",138,"ق",2,0],["وأنت وحدك في الميدان تزرعه","سنابلاً أنت من وفّى بما نذرا",139,"ر",2,0],["وأنت ولا أجامل يا صديقي","إذا ما قلتها الرجل الأعفّ!",140,"ف",1,0],["وان توكأت في يوم على وجعي","فاعلم بأن حبيبي زادني رهقا",141,"ق",2,0],["وإن توخيتني يوماً بلائمةٍ","رجعت باللوم إبقاءً على الزمن",142,"ن",1,0],["وانت وفي والطيب دارك ومسكنك","ودايم على هذا الرتم والوتيرة",143,"ر",2,0],["وأنْتَ وإنْ كانَتْ تُظِلُّكَ هيْبَةٌ","وفي النَّفْسِ كِبْرٌ والفُؤادُ عَليلُ...!",144,"ل",1,0],["وأنتَ وحْدَكَ في قلبي وتَعْرِفُ كمْ","حَفظْتُ عَهْدَ غرامي فيكَ ياقاسي",145,"س",2,0],["وأنْتَ ومْنْ آواكَ مِنْ شِسْعِ نَعْلِكُمْ","أذلّ وأدنَى بَلْ أخَسُّ وَأحْقَرُ",146,"ر",1,0],["وانت وجيوش الموادع والجفيا","كيف اوقف ضدكم وانتم جماعه",147,"ع",2,0],["وَأَنْتِ ..والَّذِي أَهْمَى","دُمُوعَ الْمُزْنِ مُلْهِمَتِي",148,"ت",2,0],["وأنت والله للعينين مشرقها","لولا جبينك لم تنعم بأنوار",149,"ر",1,0],["وأنتَ وليّ روحي وانتمائي","وموطن عزتي ودعاء أمسيّ",150,"س",2,0],["وأنتَ وإنْ هجتنا العامَ شاهدٌ","لها كيفَ ياتي حلوها ورشيقها",151,"ق",3,0]]}