{"poems":[[79,"إنما كان ريقك العذب شهدا","https://www.aldiwan.net/poem36719.html","الخفيف"],[74,"لا ونعماك لم يكن سبب التأ","https://www.aldiwan.net/poem18223.html","الخفيف"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[47,"يا أبا جعفر غدونا حديثا","https://www.aldiwan.net/poem64636.html","الخفيف"],[51,"ما لعذالي ومالي","https://www.aldiwan.net/poem64298.html","مجزوء الرمل"],[18,"عجبت أبناؤنا من فعلنا","https://www.aldiwan.net/poem23960.html","الرمل"],[83,"شادن لو جرى مع","https://www.aldiwan.net/poem61450.html","مجزوء الخفيف"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[52,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/204571","الطويل"],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[369,"قلت لما قالوا غدا رأس شمس","https://www.aldiwan.net/poem60839.html","الخفيف"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[371,"وقف الطيف بجفن كالطلل","https://www.aldiwan.net/poem17080.html","الرمل"],[422,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[558,"إنما كنا كأرض ميتة","https://www.aldiwan.net/poem68298.html","الرمل"],[558,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[563,"أمسك الحق باليد","https://www.aldiwan.net/poem34647.html","مجزوء الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2410","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122813","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38041","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109074","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101002","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27740","الرمل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146349","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205948","الخفيف"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93745","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204215","الخفيف"],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5455,"يبه","https://www.poetsgate.com/ViewPoem.aspx?id=34696",""],[5525,"هلي الجدايل","https://www.poetsgate.com/ViewPoem.aspx?id=7247",""],[2220,"إنما قلتَ لشيءٍ كن فكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11852&r=&rc=721",""]],"verses":[["إِنَّمَا كَانَ رِيقُكَ الْعَذْبُ شُهْداً","حَيْثُ أَهْلُ الْهَوَى ذُبَابٌ مُكِبَّهْ",0,"ه",1,1],["إنَّما كان هيضة حققتْ لي","أنَّ حالي في البعدِ حالُ خراءِ",1,"ا",2,0],["إنما كان حقُّ مثليَ أن يُر","حَمَ لاقَوْا أعداءهم رُحماءَ",2,"ا",2,0],["إنما كلُّ ما أتى ليَ في ظِلْ","لك حَوْلٌ أو دونه بليالِ",3,"ل",1,0],["إنَّما كان هفوءاً ساقه","سهوُ قلب بين هم وحزن",4,"ن",1,0],["إنما كلها العروبة ثكلى","وبمصر وبالعراق صدوع",5,"ع",1,0],["إِنَّما كُنتُ وارِداً في جَميعِ ال","ناسِ مَن كانَ لِلوُرودِ مُفيضا",6,"ض",2,0],["إِنَّما كانَت يَميني","صَرَمَت جَهلاً شِمالي",7,"ل",2,0],["إِنَّما كانَت بِنا مَوصولَةً","أَكلُ الناسِ بِها أَحرى النِهابِ",8,"ب",1,0],["إِنَّما كانَ كَوكَباً","قابَلَ الشَمسَ فاِحتَرَق",9,"ق",1,0],["إنّمَا كان شِهَاباً ثاقِباً","صَعِقَ اللّيْلُ له ثمَّ خَمَد",10,"د",1,0],["إنّما كانتْ خطوبٌ قُيِّضَتْ","فَعَدَتْنا عنكُمُ إحدى العَواد",11,"د",1,0],["إِنَّما كُنّا كَأَرضٍ مَيتَةٍ","لَيسَ لِلرائِدِ فيها مَنتَظَر",12,"ر",1,0],["انما كنت كالسخيلة طفلا","فاقد الفهم عاجزا عن كلام",13,"م",1,0],["إِنَّمَأ كُنتَ مَاضِغَ اللَّوزِ دَأباً","عَوَّدَ الجَهلُ نُطقَكَ التَّعجِيمَا",14,"م",2,0],["إنّما كان عُقْدةً رأْسُه قا","رَنَ شَمساً فآذنَتْ بانْكِساف",15,"ف",1,0],["إنّما كنتُ في المَدامعِ منّى","ذاخِراً عسكراً من الدّمعِ مَجرا",16,"ر",2,0],["إِنَّما كانَ الكَرى يَسكُنُها","فَالكَرى مِن وَصلِهِم ثُمَّ اِنتَقَل",17,"ل",1,0],["إنَّما كانت علاقات هوى","أَصْبَحَتْ بعد اتِّصالٍ بانصرام",18,"م",1,0],["إنما كنتِ حساماً حُطّ في","مَفرِقي واسمكِ شيبٌ وخَطَا",19,"ط",2,0],["إِنَّما كُنّا كَأَرضٍ مَيتَةٍ","لَيسَ لِلزائِرِ فيها مُنتَظَر",20,"ر",1,1],["إِنَّما كانَ عِزُّها في جِبالٍ","تَرتَقيها كَما تُرَقّى الوَبارُ",21,"ر",1,0],["إنما كل منتهى","في الورى كل مبتدي",22,"د",2,0],["إِنَّما كانَ طَلحَةُ الخَيرِ بَحراً","شُقَّ لِلمُعتَفينَ مِنهُ بُحورُ",23,"ر",1,1],["إنَّما كَلَّفَني الصَّبرَ عَلَى","بَعضِ مَن عاشَرتُهُ حُبُ الوَطَن",24,"ن",1,0],["إِنّما كُنتُ آخِذاً مستَعيراً","أحَرامٌ عليّ أَن أَستَعيرا",25,"ر",2,0],["إنما كان دمية من قماش","لم ترعها رضوضه إن يُرضَّا",26,"ض",2,0],["إنَّما كنت على الدهر حمًى","لم تجدْ فيك الليالي مطمعا",27,"ع",2,0],["إنما كنت بين أهلي وإخوا","ني مُقيماً في معشري وأناسي",28,"س",2,0],["إنما كل مشهد شهداه","لبرود المذلة ارتدياها",29,"ا",3,0],["إنما كان عن أذني لا تقل","إنه كان عن إذا لكيان",30,"ن",1,0],["إنما كانت الحياةُ حياةً","في ليالي وصْلِ الحِسانِ، الحسان",31,"ن",1,0],["إنما كان مغرمًا يَتغنَّى","أو مجدًّا يغالب العيش نجحا",32,"ح",2,0],["إِنّما كُل دقة لَك فيها","كافل بِالبَقاء لَو قَدروكا",33,"ك",2,0],["إنما كان للكلابِ عواءٌ","حيثما كان للأُسودِ زئيرُ",34,"ر",1,0],["إنما كنت فلذة من فؤادي","خطفتها المنون من أحشائي",35,"ي",1,0],["إنَّما كنت عبد ربِّك حقَّاً","لم يكن منك في السّوى رغباء",36,"ا",2,0],["إَنَّمَاْ كُنْتَ مُضَاْهٍ أَنْ تُلاْقِيْ حَرْدَةً تَرْ","كَبُهَاْ طِرْوَاْدَةًً تَمْنَحُ تَبْرِيْرَاً وِقَاْرَاً",37,"ر",2,0],["ان ماكتبته باازرق الدمع وابكيت","كل الجروح المبطيه مارحمته",38,"ت",2,0],["إن ما كفاك اني وهبتك هوى النفس","وسهد الليالي يوم انا انكرت نومي",39,"م",2,0],["إنما كان عن أذني لا تقل","إنهُ كانَ عنْ إذنْ لكيانْ",40,"ن",1,0]]}