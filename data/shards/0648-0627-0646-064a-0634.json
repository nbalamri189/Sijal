{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[87,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[41,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[309,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[370,"وما لي في صيد العقارب حيلة","https://www.aldiwan.net/poem16975.html","الطويل"],[407,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[482,"رأيت الهلال ووجه الأمير","https://www.aldiwan.net/poem37056.html","المتقارب"],[503,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[554,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[561,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[561,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[561,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[561,"إن شاء مولاي يظهر للذي يختار","https://www.aldiwan.net/poem34475.html","المواليا"],[561,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[578,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"]],"verses":[["وَإِنّي شَقيقُ الوَغى وَالنَدى","رَضيعُ لِبانِ المَعالي الجِسامِ",0,"م",1,0],["وَإِنْ يُشْجِنَا مَا نَالَهُمْ مِنْ عِقَابِنَا","فَفِينا عَلَى العِلاَّتِ ذَاكَ التَّكَرُّمُ",1,"م",1,0],["وأنِّي شكورٌ للأيادي التي غدتْ","لها في رقابِ العالمين خواتمُ",2,"م",1,0],["وأنَّى شئت ضع منها الحدودا","شمالا في البسيطة أو جنوبا",3,"ا",1,0],["وَأَنّي شَقِيٌّ بِاللِئامِ وَلا تَرى","شَقِيّاً بِهِم إِلّا كَريمَ الشَمائِلِ",4,"ل",1,0],["وَأَن يُشيد البُنى مِن حصن دولتهِ","عَلى أَساسٍ بركنِ العدلِ يندعمُ",5,"م",1,0],["وَإِنّي شُجاعٌ لا عَلى كُلِّ حَيَّةٍ","سِوى حَيَّةٍ صيغَت مِنَ الشَعرِ في الخَدِّ",6,"د",1,0],["وأن يشهدوا أن الرسول محمداً","نبي أتى بالحق والنور والرشد",7,"د",1,0],["وأن يشهدوا أن المعاد حقيقة","يعيدهم رب العباد الذي يبدي",7,"د",2,0],["وإني شهيد لتلك الخلال","أنظّم منها اللآلي عقود",8,"د",1,0],["وإنِّي شَهيدُ الحُبِّ في معْرَكِ النَّوى","قَتيلٌ على ضُعفي الأَحِبَّةُ صَالوا",9,"ل",3,0],["وإنْ يشتروا في ساحةِ العِزِّ رُتبةً","تجاذبُها الأيدي بحكمِ اِستِيامِها",10,"م",3,0],["وإن يشأ بجنان الخلد نعَّمهم","فضلاً وعاملهم باللطف واللين",11,"ن",1,0],["وإن يشأ بالبعد يحرق الذي","أراد غيراً أو أحب دونا",12,"ن",2,0],["وإن يشأ يكشف عن الوجه لمن","يحبه ويخرج المسجونا",12,"ن",2,0],["وإن يشأ الشهود فلا سواء","وكان لنور طلعته سطوع",13,"ع",1,0],["وإن يشا يحتجب بالكون والآثارْ","فالزم أدب حضرتُهْ واعرض عن الأغيارْ",14,"ر",1,0],["وإن يشأ فبما قد آمنت كفرت","قوم وإن شاء فالإقلال إكثار",15,"ر",1,0],["وإني شغلت به عنهم","فما أَنَا عنهمْ به سائِلُ",16,"ل",1,0]]}