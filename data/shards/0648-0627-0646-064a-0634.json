{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[87,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[41,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[371,"وما لي في صيد العقارب حيلة","https://www.aldiwan.net/poem16975.html","الطويل"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[484,"رأيت الهلال ووجه الأمير","https://www.aldiwan.net/poem37056.html","المتقارب"],[505,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[556,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[563,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[563,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[563,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[563,"إن شاء مولاي يظهر للذي يختار","https://www.aldiwan.net/poem34475.html","المواليا"],[563,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101467","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38816","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95494","البسيط"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/141784","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27382","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76025","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202891","الوافر"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124617","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124007","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4034,"","https://poetry.dctabudhabi.ae/diwan/poem/83114","الوافر"],[4755,"هذا السَّرَابُ القائِمُ القاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183630",""],[5213,"ستنبئك الركبان غاد ورائح","https://www.poetsgate.com/ViewPoem.aspx?id=170513",""],[5277,"إنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=185231",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"لكي لا يطمعُ الأسفُ","https://www.poetsgate.com/ViewPoem.aspx?id=199942",""],[5638,"غزة.. لا تخرُّ مع الساجدين","https://www.poetsgate.com/ViewPoem.aspx?id=198036",""],[5660,"عَذابُ الحُبِ أَن تُمسي حَريقاً","https://www.poetsgate.com/ViewPoem.aspx?id=23780",""]],"verses":[["وَإِنّي شَقيقُ الوَغى وَالنَدى","رَضيعُ لِبانِ المَعالي الجِسامِ",0,"م",1,0],["وَإِنْ يُشْجِنَا مَا نَالَهُمْ مِنْ عِقَابِنَا","فَفِينا عَلَى العِلاَّتِ ذَاكَ التَّكَرُّمُ",1,"م",1,0],["وأنِّي شكورٌ للأيادي التي غدتْ","لها في رقابِ العالمين خواتمُ",2,"م",1,0],["وأنَّى شئت ضع منها الحدودا","شمالا في البسيطة أو جنوبا",3,"ا",1,0],["وَأَنّي شَقِيٌّ بِاللِئامِ وَلا تَرى","شَقِيّاً بِهِم إِلّا كَريمَ الشَمائِلِ",4,"ل",1,0],["وَأَن يُشيد البُنى مِن حصن دولتهِ","عَلى أَساسٍ بركنِ العدلِ يندعمُ",5,"م",1,0],["وَإِنّي شُجاعٌ لا عَلى كُلِّ حَيَّةٍ","سِوى حَيَّةٍ صيغَت مِنَ الشَعرِ في الخَدِّ",6,"د",1,0],["وأن يشهدوا أن الرسول محمداً","نبي أتى بالحق والنور والرشد",7,"د",1,0],["وأن يشهدوا أن المعاد حقيقة","يعيدهم رب العباد الذي يبدي",7,"د",2,0],["وإني شهيد لتلك الخلال","أنظّم منها اللآلي عقود",8,"د",1,0],["وإنِّي شَهيدُ الحُبِّ في معْرَكِ النَّوى","قَتيلٌ على ضُعفي الأَحِبَّةُ صَالوا",9,"ل",3,0],["وإنْ يشتروا في ساحةِ العِزِّ رُتبةً","تجاذبُها الأيدي بحكمِ اِستِيامِها",10,"م",3,0],["وإن يشأ بجنان الخلد نعَّمهم","فضلاً وعاملهم باللطف واللين",11,"ن",1,0],["وإن يشأ بالبعد يحرق الذي","أراد غيراً أو أحب دونا",12,"ن",2,0],["وإن يشأ يكشف عن الوجه لمن","يحبه ويخرج المسجونا",12,"ن",2,0],["وإن يشأ الشهود فلا سواء","وكان لنور طلعته سطوع",13,"ع",1,0],["وإن يشا يحتجب بالكون والآثارْ","فالزم أدب حضرتُهْ واعرض عن الأغيارْ",14,"ر",1,0],["وإن يشأ فبما قد آمنت كفرت","قوم وإن شاء فالإقلال إكثار",15,"ر",1,0],["وإني شغلت به عنهم","فما أَنَا عنهمْ به سائِلُ",16,"ل",1,0],["واني شاعرُ الفيحاءِ وحدي","أُنيخ بهِ فتزعجني الغمومُ",17,"م",1,0],["وَإِنّي شَرِبتُ التّبغَ قَصداً لِيَختَفي","دُخان عَلا مِن مُهجَتي بِدُخانِهِ",18,"ه",1,0],["وإنى شاعرٌ يزجى فرائده","لظبية قلبُهُ قد صار مرعاها",19,"ا",3,0],["وأني شموسٌ كنَّ بالأمسِ طُلعاً","فأين استقلُّوا بالرِّكاب ويَمَّموا",20,"م",3,0],["وإني شكورٌ بالذي أنا أهله","وإني كما قال الإله كفورُ",21,"ر",1,0],["وَإنِّي شِهابٌ كَالشِّهَابِ إذَا غَدَت","مَعَالِمُهُ الحَلقَاتِ تَقفُو مطَالِبِي",22,"ب",2,0],["وَإِن يَشرَبوا طَرقاً لتكدير ذهنِهِم","شَرِبتُ أَنا صَفواً إِلى العينِ رائِقا",23,"ق",2,0],["وإني شاعر لا ربُّ نظم","فلست أقول إلا ما أُحس",24,"س",1,0],["وان يشتغل قوم بذاك فإنّ لي","ببادي عيوبي والخفيَ إذاً شغلا",25,"ل",2,0],["وإني شديدُ العزم إِنْ عَضَّ غارِبي","زمانٌ لرَيْعان الشبيبةِ يَخرِم",26,"م",1,0],["وأن يشتري الأحرار من كل معشر","بمعرفه والعرف قد يشتري الحرا",27,"ر",2,0],["وَإن يُشَابِهِ المُضَافُ يَفعَلُ","وَصفاً فَعَن تَنكِيرِهِ لاَ يُعزَلُ",28,"ل",1,0],["وأن يشك الكل في السلاح","كأنهم في حومة الكفاح",29,"ح",1,0],["وإن يشتدَّ عظمك بعد موتي","فلا تقطعك جائحةٌ سبوت",30,"ت",1,0],["وإِنْ يَشَأْ حَشدًا تَنَادَت لَهُ","وجَلجَلَت: لَبَّيكَ يا حاشِدُ",31,"د",1,0],["واني شبل الليث يفعل فعله","وهل تخلف الآساد إلا شبولها",32,"ه",2,0],["وإنّي شاعرٌ يَهوى ويُهوى","كنجمٍ ظلَّ يحضنه المدارُ...",33,"ر",1,0],["وإني شممت الطيب من طيب نحرها","وفيها شممت المسك يدني الغواليا",34,"ي",2,0],["وأنّي شامةٌ سمراءُ","خوفَ الشيبِ ترتجفُ",35,"ف",1,0],["وَأَنِّيَ شَمْسٌ لِبَدْرِ الصُّمُودِ","وَأَنِّي بِبَحْرِ الهَوَانِ سَفِينْ",36,"ن",1,0],["وَ إِن يُشعِل فُؤادُكَ نارَ هَجرٍ","يَقولُ الجَمرُ يا رِفقاً بِحالي",37,"ل",2,0]]}