الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75688","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119662","الخفيف"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111114","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45098","الكامل"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95804","المنسرح"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105498","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89571","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120327","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139585",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4578,"أطلع الريحان في روضِ الشقيق","https://www.poetsgate.com/ViewPoem.aspx?id=49490",""],[4578,"صج المنى بضياء وجهك أبلج","https://www.poetsgate.com/ViewPoem.aspx?id=49369",""],[4935,"اعبد الرحمن بهذا الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=129509",""],[4940,"لغة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=205779",""],[4959,"خُطُوَاتُنَا نحْوَ التَّقَدُّم !!!","https://www.poetsgate.com/ViewPoem.aspx?id=215660",""],[4119,"قلت تقول الله لا خائفا","https://www.poetsgate.com/ViewPoem.aspx?id=16247",""],[5081,"مِنْ مَعَانِي الشِّعْر","https://www.poetsgate.com/ViewPoem.aspx?id=186468",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5151,"لابد أن يلدَّ العراقُ عراقا","https://www.poetsgate.com/ViewPoem.aspx?id=184957",""],[5183,"مِشْكاة المَلاَغِز","https://www.poetsgate.com/ViewPoem.aspx?id=186412",""],[5461,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=27708",""],[5612,"مكاشفة","https://www.poetsgate.com/ViewPoem.aspx?id=185750",""],[5888,"رؤيا وواقع مرير","https://www.poetsgate.com/ViewPoem.aspx?id=214508",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[4442,"يا رب أن الأمر أمرك","https://www.poetsgate.com/ViewPoem.aspx?id=171232",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["أوْضَحْتَ طُرْقَ المَجْدِ وهْيَ خَفِيّةٌ","فبَدا لِطالِبهِ الطَّريقُ المُبهَمُ",0,"م",1,0],["أَوضِح لِمِصرَ الفَرقَ ما","بَينَ السِيادَةِ وَالحِمايَه",1,"ا",3,0],["أَوضَحتَ لِلمِصرِيِّ نَه","جَ صَلاحِهِ فَسَعى وَجَدّا",2,"د",2,0],["أَو ضاقَتِ الشَأمُ عَن بُرهانِ قُدرَتِهِم","فَفي المُهاجَرِ قَد جاؤوا بِبُرهانِ",3,"ن",1,0],["أوضحتها كالشمس عند طلوعها","وعقلتَ عن إدراكهنَّ عقولا",4,"ل",2,0],["أوضاك أنا جهلنا كل معرفةٍ","زمانَ جاز الورى فيه الميادينا",5,"ن",2,0],["أو ضعيِف الركن في ألفافه","هو ركن القوم ضرغام العرين",6,"ن",1,0],["أَو ضَمِنَ اليَومُ مِن جَدواهُ مَرغَبَةً","كانَ الكَفيلَ عَلَيها بِالوَفاءِ غَدُ",7,"د",1,0],["أَوضَعتَ في شَأوِ الجَفا فَاِحبِسِ","وَاِسلُك طَريقَ العَطفِ يا مُؤنِسي",8,"س",2,1],["أَوضَحتَ عَن خُلُقٍ أَضاءَ لَهُ الدُجى","وَأَخو الغَزالَةِ آذِنٌ بِأُفولِ",9,"ل",1,0],["أَوضَحْتَ نَهْجَ المَكرُماتِ فَنهْجُها","بادٍ سَناهُ مُنيفَةٌ أعلامُه",10,"م",2,0],["أوضحَ نَهْجَ الطُّبِّ في مَعْشَرٍ","ما زالَ فيهم دارِسَ الرَّسمِ",11,"م",1,0],["أَوضَحَت نارُ خَدِّهِ لِلمَجوسِ","حُجَّةً في السُجودِ وَالتَقديسِ",12,"س",1,1],["أَوضَحتَ عُذري في هَواكَ بِواضِحٍ","ماءُ الحَيا بِأَديمِهِ يَتَرَقرَقُ",13,"ق",1,0],["أوضاعُها مجهولةٌ","ومصيرها لا يُعلمُ",14,"م",1,0],["أوْضَعتُ في طُرُقِ التشرّفِ سامياً","بكُما ولم أسلُكْ طريقَ العافي",15,"ف",2,0],["أَوضَحَ الدَليلَ لَها","وَهيَ في تَحَيُّرِها",16,"ر",3,0],["أَوضَحَ المَجدَ لِلوَرى وَحَماهُ","فَهوَ بادي المَنارِ صَعبُ المَنالِ",17,"ل",1,0],["أَوضَحتَ لي نَهجَ القَريضِ بِنائِلٍ","رَخُصَت بِهِ فَقرُ الكَلامِ الغالي",18,"ل",2,0],["أوضحتموه لي فان عرفته","كان لكم على لا لي فخره",19,"ر",2,0],["أَوضحَ الحقّ في كلامٍ طويلٍ","كانَ في قلبهِ عليه اِنطواءُ",20,"ا",2,0],["أَوضَحَته لطاعنٍ ضاقَ فهماً","طَعنةٌ في فؤاده نجلاءُ",20,"ا",2,0],["اوضحتم لي طريقا نحوكم عسر","وما لتوضيحكم في الحب تسهيل",21,"ل",1,0],["أَوضَحتُمُ ياءالَ عَباسٍ لَنا","نَهجَ الهُدى حَتّى اِنجَلَت شَبَهاتُهُ",22,"ت",2,0],["أَوْ ضَُرِّهُ أَوْ غَدْرِهِ أَوْ شَرِّهِ","أَوْ مَكْرِهِ أَوْ كَيْدِهِ أَوْ غِشِّهِ",23,"ش",2,0],["أوضحت عُذرَك المعيشةُ عندي","حين أصبحتَ لا تعودُ مريضَا",24,"ض",2,0],["أَوضا مباركة يقبل تربها","وَتحط في عرصاتها الاحمالا",25,"ل",2,0],["أوْضَحَ الفَرْقَ بهِ مَن شَأوه","شَادَ عَليْاء تُناصي الفَرْقَدا",26,"د",2,0],["أو ضَرّةٌ خُلِقَتْ للشّمْسِ حاسدةً","فكلما حُجِبَتْ قامَتْ تُحاكِيها",27,"ي",3,0],["أو ضرب عهدٍ مدة معلومة","من بعدها لا عهد فيما عاهدوا",28,"د",3,0],["أو ضارُ أفعالِهِم تُعدي مُعاشِرَهُم","فلا يَرَوْنكَ فقِدْماً مَن رأوْا ضارُوا",29,"ر",3,0],["أَوْضَحْتَ مَنْهَجَها إِذْ كُنْتَ غايَتَهُ","فّضَلَّ مَنْ ضَلَّ واسْتَوْلَتْ عَلَى السُّنَنِ",30,"ن",1,0],["أوضحتَ من سُبُلِ المكارمِ ما عَفا","وشددتَ من أركانِها ما ضُعْضِعا",31,"ع",2,0],["أو ضامنٌ لِي أن أُعمّر ساعةً","والموتُ من خلفي ومن قُدّامي",32,"م",2,0],["أوضحتمو لمحبيكم طريقَكمو","حاشاكمو تهجروني بعد إيصالي",33,"ي",1,0],["أَو ضاقَ صدراً بي فَصَدْ","رِي بالهُمُومِ ما ضَاقْ",34,"ق",1,0],["أو ضم شمل البائسين معاهد","ومصانع عن نفسهم ذهب الضجر",35,"ر",1,0],["أوضحتَ ما كانَتِ الأعداء تنكرهُ","فيها قلوبهمُ قد قُطّعَت قطَعا",36,"ع",2,0],["اوضحتم سبل المعروف فابتدرت","لها بنو السؤل ايجافاً وارقالا",37,"ل",2,0],["أوضحتَ سُبْلَ النُّهى من بعدِ ما دَرَسَتْ","أَعلامُها ونعشتَ الجودَ فانتعشا",38,"ش",2,0],["أو ضحت نهج الهدى لولاك لاندرست","آثاره وغدت أيامه وهما",39,"م",2,0],["أو ضرر أو مطلقاً","على خلاف حققا",40,"ق",2,0],["أوضح نهج العلى وأصبح من","أوج المعالي في أرفع الدرجِ",41,"ج",1,0],["أو ضَيفَ طَيْفٍ زارجَفْنَ مُسَهَّدٍ","يَرْعَى النُّجُوَم كَأنَّهُ حَيْرَانُ",42,"ن",1,0],["أو ضاحكت ثغر الأقاحة في الربا","لم يزه أفق بالنجوم اللمع",43,"ع",1,0],["أوْضَّحْتَ منهَاجَ الهدى","ونَهَجْتَ منهج من سلفْ",44,"ف",1,0],["أو ضعف الإيمانُ منه أو أكب","على معاصيه ليوم المنقلب",45,"ب",1,0],["او ضاربا للعود تحمل راحه","راحا يدير على القيان كؤوسا",46,"س",2,0],["او ضربة بصقيله وبقيله","تركت سقيط الهام غير منظم",47,"م",1,0],["أو ضَارِبٍ فِي الأَرضِ يَقرُو الجَدَدَا","وَمَا دَرَى أنَّ الرَّدَى اجتَابَ الرِّدَا",48,"د",2,0],["أوضحَ الحقَّ وسنَّ العدلَ من","بعد ميلٍ واعوجاجِ فاستقاما",49,"م",2,0],["أو ضلّ في ليل شعر من ذوائبها","فمدح خير الورى والرسل يهديه",50,"ي",2,0],["أوضح الحقّ فهو خير رسول","ونبيّ وصحبه خير صحب",51,"ب",1,0],["أوضح لنا نور الشهامة مثلهم","وعلى رفيع المجد أحسن غيرة",52,"ه",1,0],["أو ضاق هذا البر ّمرتزّقاً","فالبحر فيه الدّرّ مبتذل",53,"ل",1,0],["أو ضائر نبح الكلاب الشمس أو","يؤذى النجوم تحرك الأشجار",54,"ر",1,0],["أو ضائر تكرارنا للذكرأو","إدماننا الصلوات للغفار",54,"ر",1,0],["أوضاع دمعي في هواك فطالما","أنا بين أرباب الممالك ضائع",55,"ع",1,0],["أوضح الدين القويم إلى","أن هدى مَن ضلّ وافتتنا",56,"ن",2,0],["أوضحت أفعال النَّدَى لنحاتها","فتواردوها حاملين مصادرا",57,"ر",2,0],["أوضحتُ أمراً ليس يدري به","إلا الذي في شأنه قد جرى",58,"ر",2,0],["أوضح مني على وجودي","تقصر عن فهمها العقول",59,"ل",1,0],["أوضحتُ سرّاً إن كنتُ حرّاً","كنتُ به واري الزناد",60,"د",1,0],["أوضا حيا في موقفي أو صاديا","أو شاحبا أو حامل الأوزار",61,"ر",1,0],["أَوضَحتَ لي سُبُلَ الهُمومِ كَأَنَّما","صَبري تَخبُّ بِهِ الرّكابُ وَتوضِعُ",62,"ع",1,0],["أوضحت نهج الحق صدق فانجلى","بك مدلهم الجهل عن شكاكه",63,"ك",2,0],["أوضحْ لقومي عذري واجلِ ظلمتَها","فلم أَرِدْ حوضَ مكروهٍ ولم أُرِد",64,"د",1,0],["أو ضياء الشمس في اليوم المطير","في جمال سرمدي لا يبور",65,"ر",1,0],["أو ضوء شمع تعبث الريح به","أو قدح زند هو أو برق خفق",66,"ق",1,0],["أَو ضاقَت الأرض بي يوما بما رحبت","سواك عند حلول الحادث العَمم",67,"م",1,0],["أَوضح الحَق فَانجَلى كُل ريب","حَيث نادى بسره المخبوء",68,"ا",1,0],["أَوْضَعْتُمُ لِنَجاتِكُمُ فَوَضَعْتُم","ما آدَكمْ منْ فَادِحِ الأَوْزَارِ",69,"ر",1,0],["أوضعت بي اليه وجناء حرف","أكلتها السفار أكل القضيم",70,"م",1,0],["أَو ضربَ البَحرَ بِكَفٍّ لَفَرَق","أَو رَجَم الطودَ بِحلمٍ لَصَعق",71,"ق",1,0],["أَو ضاعَ رشدٌ رَدَّهُ","طيبُ الشَذا بِتَضوُّع",72,"ع",1,0],["أَوضحتَ وَجدي باحتجابك ثم قَد","أَظهرتَ مَعنى الحُب بِالغَمز الخَفي",73,"ف",2,0],["أَوضِح لَنا مَعناه مَنّاً وَجُد","بِحلِّه أَثناءَ رُودٍ كِعاب",74,"ب",1,0],["أوضحت للسنة الغرار سوم هدىً","عفت فأحييت للإسلام أطلالا",75,"ل",2,0],["أَوْضَحْتُمُ الرُّشْدَ فَمَنْ يَهْتَدي","وَقُلْتُمُ الحَقَّ فَمَنْ يَسْمَعُ",76,"ع",1,0],["أوضحت منهاج السداد بطلعةٍ","محمودةٍ من همةٍ وبدار",77,"ر",1,0],["أو ضٍِدِّهِ كَما يَقُولُ الشَّانِى","نَعَم هُو الأعلَى الكَبيرُ الشَّانِ",78,"ن",1,0],["أو ضربان في الحشا أو ضرب","أو نعمة أو نقمة أو أرب",79,"ب",1,0],["أو ضحكوا فالدمع في الآماق","فاعجب لحر ناشئ عن برد",79,"د",1,0],["أَوضَحتُ لِلناس السَبيل إِلى الهُدى","وَطَرائق الإِصلاح وَالعرفان",80,"ن",1,0],["أَوضحت فيه من الحَديث غَوامضا","دقت فعنا كل عقل قَد نبا",81,"ب",2,0],["أوضحوا للخلق نهجاً مقتفي","وطريقاً هو أهدى الطرق",82,"ق",1,0],["أوضح الحال منشداً عن لساني","غير مخفيه خشيةَ الأنكاد",83,"د",1,0],["أوضح من بدر السماء المبدر","الطاهر الذات السليم النفس",84,"س",1,0],["أوضحوا الحق بعدما كان من قبل","خفيا فصار ذا اعزاز",85,"ز",1,0],["أَو ضَنَّ صُنتُ عَنِ العِقابِ جَنابَهُ","مُستَلِماً مُتَذَلِّلاً مُتَلَذِّذاً",86,"ذ",2,0],["أوضعُ خلق الإله كلِّهمُ","وَيدّعى أنه من الشُرَفا",87,"ف",2,0],["أوضحت لي بهواك عذراً","لو أستطيع عليه صبرا",88,"ر",2,1],["أَوضَحتَ سُبُلاً لِمَن ضَلَّ السَبيلَ هَدَت","أَنوارُكَ الزُهارُ مِنها طاحَتِ الظُلَمُ",89,"م",1,0],["أوضحتها سبلا يضل بها القطا","لو أنها تركت لنام قطاها",90,"ا",3,0],["اوضح الحق نجمه في مقال","هو نور في غيهب الشك هاد",91,"د",1,0],["أوضح دين الحق حتى بدا","في كل قطر من سناه ضحى",92,"ح",2,0],["أو ضعيفا تقاذفته الدياجي","أبسط الأمر هاله أو قويا",93,"ي",2,0],["أوضح الحق لمن يطلبهُ","وعلى الباطل قد سد الطريق",94,"ق",1,0],["أوضحت أحكاماً بها حكمٌ لنا","في بردها جمع اللطايف مدمجُ",95,"ج",1,0],["أوضحت طريق الرشاد الى","جميع البرايا يفصل الخطاب",96,"ب",1,0],["أو ضم روحي نحو روحك ،رقة","بالضم كم تشفي بها إيلاما",97,"م",2,0],["أَوْضَاعُهَا فِي كُلِّ شِبْ","رٍ أَصْبَحَتْ مُتَفَجِّرَة",98,"ر",2,0],["أوضح سبل العدل مفتنة","فللبرايا بالدعاء افتتان",99,"ن",1,0],["أَوْ ضَوْءُ فَجْرٍ بَعْدَ لَيْلٍ حَالِكٍ","سَئِمَ النُّجُومَ أَرَادَ لَوْ أَنْ يَنْعَتِقْ.",100,"ق",1,0],["أَوْ ضَلَّ خَيْلٌ تَرَىْ الْمُهْرَاْتِ قَدْ قَدَحَتْ","وَالْعَاْدِيَاْتُ بَدَتْ بِالْنَّقْعِ مُنْتَقَبِ",101,"ب",1,0],["أَوْ ضَمَمْتُ عُيُوْنَهُ فَوْقَ عَيْنِيْ","لاسْتَفَاقَتْ أَشْوَاقُهُ مِنْ غِطَائِيْ",102,"ا",3,0],["أو ضمني لهواك ضمةَ عاشقٍ","قد فارقَ الأوطانَ والأشواقا",103,"ق",2,0],["أو ضيعت في الخفاء ال","مفتاح من راحتيها",104,"ي",3,0],["او ضحك وردٍ على عودِ خضر","او نقل لك نفحة خزامي هبوب",105,"ب",1,0],["أوْ ضاقَ بالرُّوحِ المَشوقةِ شَوْقُها","والقلْبُ أصْبَحَ بالصَّبابَةِ مُرْهَقا",106,"ق",2,0],["أو ضحكةٌ أو لعبةٌ في حيينا","فالعقلُ لن ينسى جنون البارحة",107,"ح",2,0],["أوضحتُ أصل الدين فيه نهاية","فغدا يعبِّر للجهول صوابا",108,"ب",2,0],["أوضحت عذرك في الخطوب","فليت شعري كيف عذرك",109,"ك",1,0],["أو ضلَّ حظُّكِ في الدنيا فذا قدري","وما رأت مثلَه في البؤس عيناكِ",110,"ك",1,0]]}