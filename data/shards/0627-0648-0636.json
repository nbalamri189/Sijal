{"poems":[[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[86,"أي مكمهون قدمت بالقصد","https://www.aldiwan.net/poem10680.html","مجزوء الكامل"],[86,"أرأيت رب التاج في","https://www.aldiwan.net/poem68886.html","مجزوء الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[89,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[85,"يا حماة الطفل خير المحسنين","https://www.aldiwan.net/poem7137.html","الرمل"],[45,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[45,"أوضعت في شأو الجفا فاحبس","https://www.aldiwan.net/poem64583.html","السريع"],[45,"صب يخاطب مفحمات طلول","https://www.aldiwan.net/poem65548.html","الكامل"],[61,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[61,"برز إبراهيم في علمه","https://www.aldiwan.net/poem51438.html","السريع"],[66,"أوضحت نار خده للمجوس","https://www.aldiwan.net/poem39917.html","الخفيف"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[102,"هزلت قضيتكم فلا","https://www.aldiwan.net/poem32970.html","مجزوء الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"]],"verses":[["أوْضَحْتَ طُرْقَ المَجْدِ وهْيَ خَفِيّةٌ","فبَدا لِطالِبهِ الطَّريقُ المُبهَمُ",0,"م",1,0],["أَوضِح لِمِصرَ الفَرقَ ما","بَينَ السِيادَةِ وَالحِمايَه",1,"ا",3,0],["أَوضَحتَ لِلمِصرِيِّ نَه","جَ صَلاحِهِ فَسَعى وَجَدّا",2,"د",2,0],["أَو ضاقَتِ الشَأمُ عَن بُرهانِ قُدرَتِهِم","فَفي المُهاجَرِ قَد جاؤوا بِبُرهانِ",3,"ن",1,0],["أوضحتها كالشمس عند طلوعها","وعقلتَ عن إدراكهنَّ عقولا",4,"ل",2,0],["أوضاك أنا جهلنا كل معرفةٍ","زمانَ جاز الورى فيه الميادينا",5,"ن",2,0],["أو ضعيِف الركن في ألفافه","هو ركن القوم ضرغام العرين",6,"ن",1,0],["أَو ضَمِنَ اليَومُ مِن جَدواهُ مَرغَبَةً","كانَ الكَفيلَ عَلَيها بِالوَفاءِ غَدُ",7,"د",1,0],["أَوضَعتَ في شَأوِ الجَفا فَاِحبِسِ","وَاِسلُك طَريقَ العَطفِ يا مُؤنِسي",8,"ي",1,1],["أَوضَحتَ عَن خُلُقٍ أَضاءَ لَهُ الدُجى","وَأَخو الغَزالَةِ آذِنٌ بِأُفولِ",9,"ل",1,0],["أَوضَحْتَ نَهْجَ المَكرُماتِ فَنهْجُها","بادٍ سَناهُ مُنيفَةٌ أعلامُه",10,"م",2,0],["أوضحَ نَهْجَ الطُّبِّ في مَعْشَرٍ","ما زالَ فيهم دارِسَ الرَّسمِ",11,"م",1,0],["أَوضَحَت نارُ خَدِّهِ لِلمَجوسِ","حُجَّةً في السُجودِ وَالتَقديسِ",12,"س",1,1],["أَوضَحتَ عُذري في هَواكَ بِواضِحٍ","ماءُ الحَيا بِأَديمِهِ يَتَرَقرَقُ",13,"ق",1,0],["أوضاعُها مجهولةٌ","ومصيرها لا يُعلمُ",14,"م",1,0],["أوْضَعتُ في طُرُقِ التشرّفِ سامياً","بكُما ولم أسلُكْ طريقَ العافي",15,"ف",2,0],["أَوضَحَ الدَليلَ لَها","وَهيَ في تَحَيُّرِها",16,"ر",3,0]]}