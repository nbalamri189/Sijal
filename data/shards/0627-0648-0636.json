{"poems":[[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[86,"أي مكمهون قدمت بالقصد","https://www.aldiwan.net/poem10680.html","مجزوء الكامل"],[86,"أرأيت رب التاج في","https://www.aldiwan.net/poem68886.html","مجزوء الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[89,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[85,"يا حماة الطفل خير المحسنين","https://www.aldiwan.net/poem7137.html","الرمل"],[45,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[45,"أوضعت في شأو الجفا فاحبس","https://www.aldiwan.net/poem64583.html","السريع"],[45,"صب يخاطب مفحمات طلول","https://www.aldiwan.net/poem65548.html","الكامل"],[61,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[61,"برز إبراهيم في علمه","https://www.aldiwan.net/poem51438.html","السريع"],[66,"أوضحت نار خده للمجوس","https://www.aldiwan.net/poem39917.html","الخفيف"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[102,"هزلت قضيتكم فلا","https://www.aldiwan.net/poem32970.html","مجزوء الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[141,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[141,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[158,"أهلا به من بحر علم صدره","https://www.aldiwan.net/poem59122.html","الرجز"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[233,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[235,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[248,"قل لعبد العظيم عني مقالا","https://www.aldiwan.net/poem14989.html","الخفيف"],[269,"سامرت ليلك بالغوير فطالا","https://www.aldiwan.net/poem52076.html","الكامل"],[273,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[400,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[402,"لقاء أكثر من يلقاك أوزار","https://www.aldiwan.net/poem49918.html","البسيط"],[429,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[429,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[556,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[573,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["أوْضَحْتَ طُرْقَ المَجْدِ وهْيَ خَفِيّةٌ","فبَدا لِطالِبهِ الطَّريقُ المُبهَمُ",0,"م",1,0],["أَوضِح لِمِصرَ الفَرقَ ما","بَينَ السِيادَةِ وَالحِمايَه",1,"ا",3,0],["أَوضَحتَ لِلمِصرِيِّ نَه","جَ صَلاحِهِ فَسَعى وَجَدّا",2,"د",2,0],["أَو ضاقَتِ الشَأمُ عَن بُرهانِ قُدرَتِهِم","فَفي المُهاجَرِ قَد جاؤوا بِبُرهانِ",3,"ن",1,0],["أوضحتها كالشمس عند طلوعها","وعقلتَ عن إدراكهنَّ عقولا",4,"ل",2,0],["أوضاك أنا جهلنا كل معرفةٍ","زمانَ جاز الورى فيه الميادينا",5,"ن",2,0],["أو ضعيِف الركن في ألفافه","هو ركن القوم ضرغام العرين",6,"ن",1,0],["أَو ضَمِنَ اليَومُ مِن جَدواهُ مَرغَبَةً","كانَ الكَفيلَ عَلَيها بِالوَفاءِ غَدُ",7,"د",1,0],["أَوضَعتَ في شَأوِ الجَفا فَاِحبِسِ","وَاِسلُك طَريقَ العَطفِ يا مُؤنِسي",8,"ي",1,1],["أَوضَحتَ عَن خُلُقٍ أَضاءَ لَهُ الدُجى","وَأَخو الغَزالَةِ آذِنٌ بِأُفولِ",9,"ل",1,0],["أَوضَحْتَ نَهْجَ المَكرُماتِ فَنهْجُها","بادٍ سَناهُ مُنيفَةٌ أعلامُه",10,"م",2,0],["أوضحَ نَهْجَ الطُّبِّ في مَعْشَرٍ","ما زالَ فيهم دارِسَ الرَّسمِ",11,"م",1,0],["أَوضَحَت نارُ خَدِّهِ لِلمَجوسِ","حُجَّةً في السُجودِ وَالتَقديسِ",12,"س",1,1],["أَوضَحتَ عُذري في هَواكَ بِواضِحٍ","ماءُ الحَيا بِأَديمِهِ يَتَرَقرَقُ",13,"ق",1,0],["أوضاعُها مجهولةٌ","ومصيرها لا يُعلمُ",14,"م",1,0],["أوْضَعتُ في طُرُقِ التشرّفِ سامياً","بكُما ولم أسلُكْ طريقَ العافي",15,"ف",2,0],["أَوضَحَ الدَليلَ لَها","وَهيَ في تَحَيُّرِها",16,"ر",3,0],["أَوضَحَ المَجدَ لِلوَرى وَحَماهُ","فَهوَ بادي المَنارِ صَعبُ المَنالِ",17,"ل",1,0],["أَوضَحتَ لي نَهجَ القَريضِ بِنائِلٍ","رَخُصَت بِهِ فَقرُ الكَلامِ الغالي",18,"ل",2,0],["أوضحتموه لي فان عرفته","كان لكم على لا لي فخره",19,"ر",2,0],["أَوضحَ الحقّ في كلامٍ طويلٍ","كانَ في قلبهِ عليه اِنطواءُ",20,"ا",2,0],["أَوضَحَته لطاعنٍ ضاقَ فهماً","طَعنةٌ في فؤاده نجلاءُ",20,"ا",2,0],["اوضحتم لي طريقا نحوكم عسر","وما لتوضيحكم في الحب تسهيل",21,"ل",1,0],["أَوضَحتُمُ ياءالَ عَباسٍ لَنا","نَهجَ الهُدى حَتّى اِنجَلَت شَبَهاتُهُ",22,"ت",2,0],["أَوْ ضَُرِّهُ أَوْ غَدْرِهِ أَوْ شَرِّهِ","أَوْ مَكْرِهِ أَوْ كَيْدِهِ أَوْ غِشِّهِ",23,"ش",2,0],["أوضحت عُذرَك المعيشةُ عندي","حين أصبحتَ لا تعودُ مريضَا",24,"ض",2,0],["أَوضا مباركة يقبل تربها","وَتحط في عرصاتها الاحمالا",25,"ل",2,0],["أوْضَحَ الفَرْقَ بهِ مَن شَأوه","شَادَ عَليْاء تُناصي الفَرْقَدا",26,"د",2,0],["أو ضَرّةٌ خُلِقَتْ للشّمْسِ حاسدةً","فكلما حُجِبَتْ قامَتْ تُحاكِيها",27,"ي",3,0],["أو ضرب عهدٍ مدة معلومة","من بعدها لا عهد فيما عاهدوا",28,"د",3,0],["أو ضارُ أفعالِهِم تُعدي مُعاشِرَهُم","فلا يَرَوْنكَ فقِدْماً مَن رأوْا ضارُوا",29,"ر",3,0],["أَوْضَحْتَ مَنْهَجَها إِذْ كُنْتَ غايَتَهُ","فّضَلَّ مَنْ ضَلَّ واسْتَوْلَتْ عَلَى السُّنَنِ",30,"ن",1,0],["أوضحتَ من سُبُلِ المكارمِ ما عَفا","وشددتَ من أركانِها ما ضُعْضِعا",31,"ع",2,0],["أو ضامنٌ لِي أن أُعمّر ساعةً","والموتُ من خلفي ومن قُدّامي",32,"ي",1,0],["أوضحتمو لمحبيكم طريقَكمو","حاشاكمو تهجروني بعد إيصالي",33,"ي",1,0],["أَو ضاقَ صدراً بي فَصَدْ","رِي بالهُمُومِ ما ضَاقْ",34,"ق",1,0]]}