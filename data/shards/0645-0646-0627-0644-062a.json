{"poems":[[73,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[74,"رأى الغصن أعطاف الغزال المقرطق","https://www.aldiwan.net/poem19355.html","الطويل"],[74,"أخا اللوم لا تتعب لسانا ولا ذهنا","https://www.aldiwan.net/poem20176.html","الطويل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55159","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[214,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[237,"أخاطبه عند التلفت يا رشا","https://www.aldiwan.net/poem14709.html","الطويل"],[237,"أساكن قلبي لا بليت بوجده","https://www.aldiwan.net/poem14745.html","الطويل"],[237,"بدا فأراني الظبي والغصن والبدرا","https://www.aldiwan.net/poem14761.html","الطويل"],[237,"حكاه من الغصن الرطيب وريقه","https://www.aldiwan.net/poem14810.html","الطويل"],[237,"لبرق الحمى عهد علي وموثق","https://www.aldiwan.net/poem14835.html","الطويل"],[237,"ترى البدر في الليل يهدي النفوسا","https://www.aldiwan.net/poem14847.html","المتقارب"],[285,"سلوا سيف ألحاظه الممتشق","https://www.aldiwan.net/poem60707.html","المتقارب"],[287,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[309,"غزال الحمى قلبي بحبك قد ملى","https://www.aldiwan.net/poem16887.html","الطويل"],[353,"سقاها فهل أبصرت شمسا منيرة","https://www.aldiwan.net/poem20256.html","الطويل"],[396,"جزى الله المصائب كل خير","https://www.aldiwan.net/poem54603.html","عموديه"],[435,"رعى الله منشيها ولا فض فاهه","https://www.aldiwan.net/poem41008.html","الطويل"],[591,"ملامك لا ربط لديه ولا حل","https://www.aldiwan.net/poem17642.html","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56099","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122011","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116018","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115922","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115975","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115948","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49591","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125400","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118389","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111094","الطويل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124177","الطويل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124191","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101694","الطويل"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123824","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76068","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76105","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76093","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75977","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75926","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115503","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74194","الطويل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89273","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89274","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62795","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86302","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66545","الطويل"],[4140,"","https://poetry.dctabudhabi.ae/diwan/poem/34706","البسيط"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91013","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45066","المجتث"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73266","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136625",""],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[4578,"عينا بمنشور الهوى جيت والياً","https://www.poetsgate.com/ViewPoem.aspx?id=49614",""],[4578,"بعيني غزال ألبان هاروت ماكث","https://www.poetsgate.com/ViewPoem.aspx?id=49366",""],[4578,"محاسن رياً نشرها طيب الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=49418",""],[4871,"نهج النشامى","https://www.poetsgate.com/ViewPoem.aspx?id=215848",""],[4984,"التباري1","https://www.poetsgate.com/ViewPoem.aspx?id=186524",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[5302,"لما اغتالك الحلك","https://www.poetsgate.com/ViewPoem.aspx?id=201221",""],[5409,"بيني وبينك ألف القدر","https://www.poetsgate.com/ViewPoem.aspx?id=155500",""],[5587,"يا جزائر","https://www.poetsgate.com/ViewPoem.aspx?id=196573",""],[5736,"توليب","https://www.poetsgate.com/ViewPoem.aspx?id=203831",""],[5790,"تثنى كما هز الرديني حامله","https://www.poetsgate.com/ViewPoem.aspx?id=111888",""],[5956,"الحمد لله أعطانا أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=192130",""],[5956,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=192395",""],[5956,"تَدَيُّنكَ الأصيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=193764",""],[6152,"الوفاء معدن","https://www.poetsgate.com/ViewPoem.aspx?id=204738",""],[6211,"أوّاهُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78539&r=&rc=0",""]],"verses":[["مِنَ التُركِ مَيّاسُ القوامِ مُهَفهَفٌ","لَهُ الدُرُّ ثَغرٌ وَالزُمُرُّدُ شارِبُ",0,"ب",1,0],["من الترك إلا أنه أسمر اللمى","لعُوب بأطراف الكلام المشقَّق",1,"ق",1,0],["من الترك في خدَّيه للحسن روضة","ولكنَّها تجني علينا ولا تجنى",2,"ن",2,0],["مِنَ التُّرْكِ في أَخْلاقِهِ بَدَوِيَّةٌ","لها يَعْتَزِي زَيْدٌ وَعَمْرٌو وَعَنْتَرُ",3,"ر",1,0],["مِنَ التوْفِيقِ أَنَّهُمُ أَصَابُوا","عَسِيرَ النُّجْحِ مَيْسُورَ المَنَالِ",4,"ل",1,0],["مَنِ الَّتِي تَنْهَضُ مِنْ بُكْرَةٍ","وَحُرَّةُ القوْمِ الَّتِي تُبْكِرُ",5,"ر",1,0],["من الترك لن يشدو تبعرب لحنه","ولم ار احلى منه في العرب والعجم",6,"م",1,0],["مِنَ التُركِ أَبهى مَن رَأَيتُ مَعَمَّماً","وَأَحسَنُ وَجهاً مَن رَأَيتُ مُشَربَشا",7,"ش",2,0],["مِنَ التُركِ لَو عايَنتَ ذُلّي وَعِزَّهُ","لَعايَنتَ مَولىً لا يَرِقُّ لِعَبدِهِ",8,"د",2,0],["مِنَ التركِ لَم يَترُك بِقَلبي تَجَلُّداً","فتورٌ بِجفَنَيهِ المِراضِ وَلا صَبرا",9,"ر",2,0],["مِنَ التركِ لا يُصبيهِ شَوقٌ إِلى الحمى","وَلا ذِكرُ باناتِ الغُوَيرِ يَشوقُهُ",10,"ق",2,0],["مِنَ التُركِ لا تُخطي سِهامُ جفونِهِ","وَلَكِنَّها في وَسطِ قَلبِيَ تَرشُقُ",11,"ق",1,0],["مِنَ التُركِ مُعتَدِل كَالقَضيبِ","يُمنِّعُهُ عُجبُهُ اَن يَميسا",12,"س",2,0],["مِنَ التُّرْكِ ما سَهْمُهُ لَوْ رَمى","بِأَقْتَلَ مِنْ لَحْظِهِ إِذْ رَمَقْ",13,"ق",1,0],["مِنَ التُركِ تَبري أَسهُماً لَحَظاتُهُ","إِذا ما رَنا أَصمى بِها مَن يُناضِلُ",14,"ل",1,0],["من التعطُّف ما زالوا على خُلقٍ","إِنَّ التعطّفَ معروفٌ لخلقهمِ",15,"م",1,0],["من التابعين المحسنين أتباعه","وأتباعهم في عاجل ومؤجل",16,"ل",1,0],["مِن التُّرْكِ فَتَّاكُ اللِّحاظ إذا رَنَا","وَمالَ بِعِطفيهِ فمَا البِيضُ والسُمْرُ",17,"ر",1,0],["من التزهيد في أهل ومال","وفي وطن وفي هذى الحياة",18,"ه",1,0],["من الترك وافت ذات فخر ومن رأى","يقر لها فضلا على السر والجهر",19,"ر",1,0],["مِنَ التُّربِ هذا الطَّبْعُ والنَّفْسُ مِنْ عُلاً","فَلِلْمَرْءِ أَنْ يَدْنُو وَلِلْمَرْءِ أَنْ يَعْلُو",20,"ل",2,0],["من الترك فرعٌ تحسد العرب أصله","على مثل هذا الطيب طاب أصولا",21,"ل",2,0],["من الترك لاعانيهم يبلغ المنى","ولا هو ممنون عليه فيعتق",22,"ق",1,0],["مِنَ التَّارِكِينَ الأَرْضَ تُشْرِقُ بِالْقَنَا","وَسُحْبُ الدَّمِ المَوَّارِ فِيهَا لَهَا سَبْحُ",23,"ح",1,0],["من التُّرك مَيَّاسُ القَوامِ كأنّهُ","يُجرِّدُ لى سيفاً من اللّحظَِ ماضيا",24,"ي",2,0],["من التّرك ماضى المقلتين كأنّه","إذا مارنا فمن شفرةِ السيف ينظرُ",25,"ر",1,0],["من التُّرك مصقولِ العوارض لحظُهُ","إذا ما رنا سيفٌ علىّ صقيلُ",26,"ل",1,0],["من الترك سحَّارُ الجفونِ كأنّهُ","غزالٌ ولكن فى فؤادىَ يرتَعُ",27,"ع",1,0],["من التغلبيين الأولى وَسِعوا العُلا","إذا بَعِلتْ قيسٌ بها وتميم",28,"م",1,0],["من التُّركِ إلا أن بين جُفُونها","ألاعيبُ سحرٍ لا يقوم بها الهندُ",29,"د",1,0],["من التعذال حسبك يا عذول","فعذل أخي الغرام هو الفضول",30,"ل",1,1],["من التنعيم يدعوها كداء","الى البطحاء بين الاخشفين",31,"ن",1,0],["من التعريف مسيا صادرات","يخدن منكبات المأزمين",31,"ن",1,0],["من الترك بالآداب رحن تطبعا","فطبن بما قد رحن فيه إلى الفخر",32,"ر",1,0],["من التّرك لا يصبيه وجد إلى الحمى","ولا ذكر بانات الغوير يشوقه",33,"ق",2,0],["من الترك لا وادي إلا ذاك محله","ولا داره رمل المصلى ولا السقط",34,"ط",1,0],["من الترك لم تترك لصب محجة","إلى الصبر أو نهجا لعذل إلى العذر",35,"ر",1,0],["من الترك يسطو في القلوب بلحظه","فلا تسألوا عن حال من يعشق التركا",36,"ك",2,0],["مِن التُركِ إِمّا حُسنُهُ فَهوَ فاتِن","وَإما سَطاهُ فَهوَ فتكُ الضَبارِمِ",37,"م",1,0],["مِن التُركِ ضاقَ العَينُ مِنها لِبُخلِها","وَلَيسَت مِن العِينِ الَّتي تُشبِهُ الظَبيا",38,"ي",2,0],["مِن التُركِ لَم تَرتَع بِأَكنافِ حاجِرٍ","وَرَضوى وَلم تَرتَع بِنَجدٍ وَلا حُزوى",39,"و",2,0],["مِن التُرك لَم يَنشأ بِنجدٍ وَإِنَّما","رَبا في عَرينِ الأُسدِ تُمسِكُهُ ضَغطا",40,"ط",2,0],["مِن الترك لَم يُربَع بِنَجدٍ وَإِنَّما","رَبا في عَرينِ اللَيثِ وَاللَيثُ حارِسُه",41,"س",2,0],["مِن التُركِ إِن قابَلتَ فَالبَدرُ طالِعٌ","لِنِصفٍ وَإِن قاتَلتَ فَاللَيثُ مخدَرُ",42,"ر",1,0],["من التُرك غيدٌ طوال الشعور","صباحُ الوجوهِ رشاقُ القدود",43,"د",1,0],["مِن التُربة الفَيحاء مِن مَعدن الهُدى","بِها كُل قَلب مُغرم وَمشوق",44,"ق",1,0],["من التي ليست لهن صورة","لكنها مرصودة مذكورة",45,"ه",1,0],["من التقى والهدى ومما","يليق بالمنصب الجليل",46,"ل",1,0],["من الترك لم يترك من الفضل حاجةً","ولكن مريدٌ للكمال وقابل",47,"ل",1,0],["مِنَ التغلِبيينَ الأُلى لو رأيتَهم","رأيتَ رجالاً يَخلقونَ المَعاليا",48,"ي",2,0],["مِنَ التُركِ لا يُصبيهِ شَوق الى الحِمى","وَلا ذكر بانات العَذيب يَشوقَه",49,"ه",1,0],["من التراب ابتدت تسعى فتنزل في","دارِ الفنا ثم تجفوها لداعيها",50,"ي",3,0],["مِن التُّرْكِ فِي خَدَّيْهِ لْلحُسْنِ جَنَّةٌ","بِمالِكِها مَحْروسَةٌ لا بِرِضوانِ",51,"ن",1,0],["مِنَ الَّتي صانَها مُلوكٌ","هُمُ السادَةُ الكِبارُ",52,"ر",1,0],["من التعاظم تمثيل الزمان به","وقد يكون اتضاع القدر بالشيم",53,"م",1,0],["من آل تسلو شهرة معروفة","والمرء مجهول إذا لم ينسب",54,"ب",1,0],["من التركِ عند دَبابيسها","صحاحُ الطلَى والهوادِي كُسورُ",55,"ر",1,0],["منَ التقى فيهِ أَضحى","وَالعِلم بَرّ وَبَحرُ",56,"ر",1,0],["مِنَ التي عظَّم الرُّهبانُ حُرمَتها","وقرَّب القِسُّ منها كلَّ معمودِ",57,"د",1,0],["من التُرك لم يأثمَ بفعل مُحرم","ومن قَتل من يَهواه لم يتأثم",58,"م",1,0],["من التجاهل الذي قد انتهتْ","حياتنا به إلى الإضرار",59,"ر",1,0],["من الترك ضاتق عينه دون مطلبي","وقد أعربت للفتك فينا يمانيا",60,"ي",2,0],["من الترك سام قد حمى بردثغره","فيا حسن حامٍ قد سما فيه يافثُ",61,"ث",1,0],["من الترك ضاقت عينها دون سائل","وليس لمرماها سوي القلب منفذا",62,"ذ",2,0],["من التجارب تتضح كل الاوزان","وكل واحد تعرفه من رفيقه",63,"ق",2,0],["من \"التَلِّ\"2 الخصيب إذا","حكوا جفت محابرنا",64,"ن",2,0],["من التلاقي قضيت السؤل والطلبا","فاليأس نصب عيوني كان قد نُصبا",65,"ب",2,1],["من التي أشعلت ليلا صرعت به","عشقا وحولك من أشباحه شبك",66,"ك",1,0],["من التي صافحت يمناك واحتضنت","خوف المحب فعاد الأنس والضحك",66,"ك",1,0],["من التي في السرى أبدت مفاتنها","لبائس واستعدت التاج يا ملك",66,"ك",1,0],["من التي قد زهت في حسن طلتها","وعدت تهتك أستارا وتنتهك",66,"ك",1,0],["من التي طحت في حبائلها","قل لي فما أنت بالهوى أشر",67,"ر",1,0],["مِنَ التَّرَانِيمِ فِي ذِكْرَى خَمَائِلِهَا","يَفُوحُ مِنْ كُلِّ وَرْدٍ ذِكْرُهَا العَطِرُ",68,"ر",1,0],["من التوليب باقات تهادت","على كفي لتقرئكم سلامي",69,"ي",1,1],["من الترك أضحى في الصميم وخاله","من الزنج من ذا في الملاح يماثله",70,"ل",2,0],["من التشردِ والزلفى قد انقلبوا","شر انقلابٍ ونرجو الله تحسينا",71,"ن",2,0],["من التذكار صوغُ الشعر لحناً","حميمياً عطوفاً ذا خفوتِ؟",72,"ت",1,0],["من التشريد في دنيا ابتلاء","وعندَ الله للمكدود خيرُ..",73,"ر",1,0],["من التراب خُلقنا , أصلنا رجل","والفضل معياره الإيمان والشيم",74,"م",1,0],["مَنِ التي أيْقَظَتْ بالحُبِّ رَعْشَتَهُ","حتَّى اسْتَعَادَ بأرْضِ الحُبِّ مَجْرَاهُ؟",75,"ا",2,0]]}