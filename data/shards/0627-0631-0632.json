{"poems":[[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[46,"مضى زماني وتقضى المدى","https://www.aldiwan.net/poem23552.html","السريع"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"],[94,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[128,"سير لهم طابت فما خبثت","https://www.aldiwan.net/poem50616.html","أحذ الكامل"],[132,"أرز كقفل بهمز أو بلاه بدا","https://www.aldiwan.net/poem54675.html","البسيط"],[348,"ما أنصف الصحنين مني واصف","https://www.aldiwan.net/poem20631.html","الكامل"],[441,"أرزى المصائب والخسران في الدين","https://www.aldiwan.net/poem14487.html","البسيط"]],"verses":[["أَرزاقُ رَبّي لِأَقوامٍ يُقَدِّرُها","مِن حَيثُ شاءَ فَيُجريهِنَّ في هِبَتي",0,"ي",1,0],["أَرزَمتِ النابُ وَعارَضتُها","فَلِيَعجَبِ السامِعُ لِلمُرزَمَين",1,"ن",1,0],["أرْزَمَتْ ناقتايَ شَوْقاً فظَنّ الرّكْ","بُ أنّي سَرَى بيَ المِرْزَمانِ",2,"ن",1,0],["أَرْزَاقُهُمْ حِلّ لِطَا","لِبِهَا وَمَوْطِنُهُمْ حَرَمْ",3,"م",1,0],["أَرْزَاءُ دَهْرٍ شَفَّنِي تَكْرَارُهَا","أَفَمَا بِهَا سَأَمٌ مِنَ التَّكْرَارِ",4,"ر",1,0],["أَرْزُ لُبْنَانَ هَاكَهُ","حَلَبٌ هَذِهِ حَلَبْ",5,"ب",1,0],["أَرْزَ الْجَنُوبِ اسْلَمْ عَزيزَ الْجَانِبِ","وَالْقَ الدُّهُورَ وَأَنْتَ أَبْقَى صَاحِبِ",6,"ب",1,1],["َأرْزٌ تَرَاهُ كَبَاذِخِ الأَبْرَاجِ إِنْ","تَنْظُرُ إِلَيْهِ مِنْ مَدىً مُتَقَارِبِ",6,"ب",1,0],["أرزيّةٌ يعربياتٌ شمائلها","لو قبلت أبكماً في ثغره فصحا",7,"ح",2,0],["أرز لبنان أيكة في ذرانا","والفراتان ماؤنا والنيل",8,"ل",1,0],["أرزٌ بهم شُدَّت وما حللت","رفعتْ لهم مِدَحٌ وما كَدَرُوا",9,"ر",3,0],["أُرزٌ كَقُفلٍ بِهَمزٍ أو بِلاه بَدَا","وَفِيهِ وَزنٌ بَدَا مُوَازِنَا صُرَدَا",10,"د",2,1],["أُرْزٌ تُجاوِرُهُ هَرِيسَةُ فَسْتُقٍ","كالخَدِّحُفَّ بِعَارِضٍ سَبَّالِ",11,"ل",1,0],["أرزى المصائب والخسران في الدين","وما سوى الدين معدود من الدون",12,"ن",1,1]]}