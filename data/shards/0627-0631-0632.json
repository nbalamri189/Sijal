{"poems":[[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[46,"مضى زماني وتقضى المدى","https://www.aldiwan.net/poem23552.html","السريع"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"]],"verses":[["أَرزاقُ رَبّي لِأَقوامٍ يُقَدِّرُها","مِن حَيثُ شاءَ فَيُجريهِنَّ في هِبَتي",0,"ي",1,0],["أَرزَمتِ النابُ وَعارَضتُها","فَلِيَعجَبِ السامِعُ لِلمُرزَمَين",1,"ن",1,0],["أرْزَمَتْ ناقتايَ شَوْقاً فظَنّ الرّكْ","بُ أنّي سَرَى بيَ المِرْزَمانِ",2,"ن",1,0],["أَرْزَاقُهُمْ حِلّ لِطَا","لِبِهَا وَمَوْطِنُهُمْ حَرَمْ",3,"م",1,0],["أَرْزَاءُ دَهْرٍ شَفَّنِي تَكْرَارُهَا","أَفَمَا بِهَا سَأَمٌ مِنَ التَّكْرَارِ",4,"ر",1,0],["أَرْزُ لُبْنَانَ هَاكَهُ","حَلَبٌ هَذِهِ حَلَبْ",5,"ب",1,0],["أَرْزَ الْجَنُوبِ اسْلَمْ عَزيزَ الْجَانِبِ","وَالْقَ الدُّهُورَ وَأَنْتَ أَبْقَى صَاحِبِ",6,"ب",1,1],["َأرْزٌ تَرَاهُ كَبَاذِخِ الأَبْرَاجِ إِنْ","تَنْظُرُ إِلَيْهِ مِنْ مَدىً مُتَقَارِبِ",6,"ب",1,0],["أرزيّةٌ يعربياتٌ شمائلها","لو قبلت أبكماً في ثغره فصحا",7,"ح",2,0]]}