{"poems":[[55,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[33,"ذكر القلب ذكرة من","https://www.aldiwan.net/poem42642.html","مجزوء الخفيف"],[113,"يا معير البدر حسنا","https://www.aldiwan.net/poem16471.html","مجزوء الرمل"],[196,"يا شبيه الفالوذ في حمرة الخد","https://www.aldiwan.net/poem27574.html","الخفيف"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[287,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[333,"يا حبيبي طاف بالماضي خيالي","https://www.aldiwan.net/poem55051.html","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133798","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108763","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125412","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100379","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100363","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81273","الخفيف"],[4830,"أنغام الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=200113",""],[5277,"بغْددةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215316",""],[5573,"لك البقا مع طول الايام ياخال","https://www.poetsgate.com/ViewPoem.aspx?id=200175",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5956,"في كون الغرامِ","https://www.poetsgate.com/ViewPoem.aspx?id=182093",""],[5956,"تقول لي: ليس في الحب حرام","https://www.poetsgate.com/ViewPoem.aspx?id=182679",""]],"verses":[["إِنتاشَني شِلوَ النَوا","زِلِ وَالنَوائِبُ لي شُجونُ",0,"ن",1,0],["أَنتِ أَشهى من الحَيَاةِ وأَبهى","من جمالِ الطَّبيعَةِ الميمونِ",1,"ن",1,0],["أَنتِ أَشهى إِلَيَّ مِن","صَوبِ مُزنِ السَحائِبِ",2,"ب",1,0],["أَنتَ أَشهى لِفُؤادي","مِن شِفاء لِسَقيم",3,"م",1,0],["أَنتَ أَشهى إِلى القُلوبِ مِنَ الزَبَ","دِ مَعَ النَرسِيانِ بَعدَ الغَداءِ",4,"ا",2,0],["أَنتِ أَشجاني وَأَوطاري فَيا","شَجوَ نَفسٍ أَنتِ مِن أَشجانِها",5,"ن",3,0],["أَنتاشَني مِن نُوَبٍ","شاكِيَةِ السِلاحِ",6,"ح",1,0],["اِنتاشَني مِن زَمَني جودُهُ","وَكُنتُ مَخمولاً فَمَدفونا",7,"ن",2,0],["أنت أشعلتَ بها نار السؤال","بعد أن أشعلت نيران الحنين",8,"ن",1,0],["أنْتَ أشْهَى مِنَ المَنَامِ لِعَيْنِي","وَمِنَ الأمْنِ لِلْفُؤَادِ العَمِيدِ",9,"د",1,0],["أنت أشهى ممنعا","مسرف البعد والشمم",10,"م",1,0],["أنتَ أشبعتَ جوف جلق بالعد","ل وكانت من الجياع الدوانف",11,"ف",1,0],["أنت أشهى من الكنوزِ وأحلى","من نسيمِ الحياةِ في وجداني",12,"ن",2,0],["انت اشهى من النَعيم لعيني","ومن الزَنجيل طعمك احلى",13,"ل",2,0],["انت اشهى من الشمول الى القلب","واحلى من النسيم شمالا",14,"ل",2,0],["انت اشهى من الشمول لقلبي","بل واصفى من الشمال واحلى",15,"ل",2,0],["أَنتَ اِشعاع ذَلِكَ القَبَس المَل","قي ضِياء الهُدى عَلى سودانه",16,"ن",2,0],["أنتِ أشعاري سمتْ في سحرها","وخُطا دربي وللقلبِ دليلْ",17,"ل",1,0],["أنتِ اشْتهاءُ الطينِ ظلَّ مسلّةٍ","وحنينهُ أبداً لمجرى الماءِ",18,"ا",2,0],["انت اشبه بكلمه لها بالوفا حال","عاملتها ماثلتها بالغرابه",19,"ب",2,0],["أنت أشعلت نار قلبك بالتح","ديق نحو الحدائق الحسنيه",20,"ي",2,0],["أنتِ اشتعالُ الهوى أنتِ احتراقُ دمي","إنْ قلت (...) فزَّ القلبُ وانفعلا",21,"ل",2,0],["أنت أشجار الخزامى","وهي فوقي كالخيامِ",22,"م",1,0],["أنت أشبعني تماما","أنا أعطيك الزماما",23,"م",2,0]]}