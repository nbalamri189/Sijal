{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[88,"أخت الكواكب ما رماك","https://www.aldiwan.net/poem10485.html","مجزوء الكامل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[50,"حي الديار وأهلها أهلا","https://www.aldiwan.net/poem65031.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202533","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[96,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[276,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[325,"يا سيدي مصطفى يا خير من سعدت","https://www.aldiwan.net/poem67215.html","البسيط"],[409,"أهذا الذي في كأس نظمك قرقف","https://www.aldiwan.net/poem33638.html","الطويل"],[409,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[435,"زارت فكان بأمر الله اسراها","https://www.aldiwan.net/poem41037.html","البسيط"],[463,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[473,"صاح إن الحياة مد وجزر","https://www.aldiwan.net/poem60140.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122600","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104581","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77449","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62466","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64498","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76672","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89552","الطويل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124054","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105055","البسيط"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89177","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62745","الطويل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27131","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72788","الطويل"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139874",""],[4755,"لِصَمتِكِ وهْو يَقرَؤُنِي استِماعا","https://www.poetsgate.com/ViewPoem.aspx?id=197893",""],[4927,"جُنُوْحُ الْقَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=29640",""],[5064,"رسولُ الله","https://www.poetsgate.com/ViewPoem.aspx?id=199157",""],[5419,"بين الشعراء أنا عجبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=31465",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5956,"زكام","https://www.poetsgate.com/ViewPoem.aspx?id=182074",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""]],"verses":[["فَأَسبَحُ مِن دِمائِكَ في خَلوقٍ","وَأَرفُلُ مِن عَجاجِكَ في عَبيرِ",0,"ر",1,0],["فأسْبابُكَ الوُثْقَى وصلْتُ بِها يَدي","ونِعْمَتُك الكُبْرى ملأتُ بِها كفّي",1,"ف",2,0],["فَاِسبَح بِروحِكَ وَحدَها","وَاِصعَد إِلى المَلِكِ الكَبيرِ",2,"ر",1,0],["فَأَسبَلَ دَمعي كَفَضِّ الجُمانِ","أَوِ الدُرِّ رَقراقِهِ المُنحَدِر",3,"ر",1,0],["فَاِسبِق أَيا عَبدَ الإِلَهِ بِها","وَاِجعَل لِعَقبِكَ ذُخرَها نَجلا",4,"ل",2,0],["فاسبق إذا الحقّ دعا مستنصرا","وكنْ إذا عدّ الحماة الخنصرا",5,"ر",2,0],["فَأَسْبَلَتِ الْعَيْنَانِ فِيهَا بِوَاكِفٍ","مِنَ الدَّمْعِ يَجْرِي بَعْدَ سَحٍّ بِوَابِلِ",6,"ل",1,0],["فأسبغي نعمة النسيان تغمرني","عسى يخفّف من بلواي نسياني",7,"ن",2,0],["فأسبل عليهم ستر صفحك واحمهم","بجاهك يا مَولاي من كل معتدي",8,"د",2,0],["فَاِسبِل عَلَيَّ وَمُنشيها السِتارَ فَما","إِلى اِمتِداحِكَ حَدٌّ ثُمَّ مَحدودُ",9,"د",1,0],["فأسبل عليه حلة العذر ساتراً","عيوب معانيه فلا تتكشف",10,"ف",1,0],["فاسبل عليها الستر إن تر نظمها","لم يحو حسن ختامها والمطلع",11,"ع",1,0],["فاسبل علينا ثوب حلمك مالنا","إلاَّ بحلمك يا كريمُ تَسَتُّرُ",12,"ر",1,0],["فاسبل عليها ذيول الستر اذ خطرت","ترجو القبول ورفقا عند مسراها",13,"ا",3,0],["فاسبق بها الشمسَ أختَها لهباً","بقاؤها في الزمان تخليدُ",14,"د",1,0],["فَاِسبِقِ الشَمسَ قَبلَ تَبدو بِشَمسٍ","سِرُّها غِمامَةَ الكَأسِ جَهرُ",15,"ر",1,0],["فأسبِل عَلَيها ظِلَّ سِترك واغتفِر","جِنايَة جانيها وحَسدِ حَسُودها",16,"د",3,0],["فأسبلتا دمعاً كأنَّ انحدارهُ","جُمانٌ تداعى مِن كثيبٍ ممهدِ",17,"د",1,0],["فَأسبِق بِهِ فَهوَ الجِهاد بِعَينهِ","فَحَتّى مَتى في الدّين يَغمور يُقصرُ",18,"ر",1,0],["فأسبل بحراً دونه كلُّ زاخر","وأقبل بدراً دونه كل طالعِ",19,"ع",1,0],["فاسبغ علي البر يا بر شاملاً","لعاجلتي والدين والأخروية",20,"ه",1,0],["فاسبق بنقدك وعدهم","مسترخضاً لي بالغلاء",21,"ا",2,0],["فَأَسبَلَتِ العَينانِ دَمعاً كأنهُ","جُمانٌ وَهى من سلكِهِ مُتَرادِف",22,"ف",1,0],["فأسبل منها بالدويمة فرّق","مرتهُنّ أنفاس الريح الواقح",23,"ح",1,0],["فأسبل الدمع من عيون","أو فابدل الدمع منك بالدم",24,"م",1,0],["فاسبلوا الدمع عليهِ وبكوا","إذ مات مسموماً على ما قد حكوا",25,"ك",3,0],["فاسبِل على الوجنات هدبَك سيدي","كيلا تخمِّش خدَّك الأبصارُ",26,"ر",1,0],["فأسبَغُ ما تَكْسوهُ أنّك ناظِرٌ","وأجزلُ ما تُعطيهِ أنّك سامِعُ",27,"ع",1,0],["فَأَسبَلتُ الدُموعَ بِلا اِحتِشامٍ","وَلَم أَكُ بِاللِئيمِ وَلا الجَبانِ",28,"ن",1,0],["فأسبل عليها ذيل عفوكَ أنها","يتيمةُ فكر قيدتهُ همومهُ",29,"م",2,0],["فأسبل أستار التخفر صائناً","لكل حديث أن يكون هو السر",30,"ر",1,0],["فَأَسبَحُ كَالنُّجُومِ بغَيرِ ماءٍ","وأَغرَقُ لا هُبُوطَ, ولا ارتِفاعا",31,"ع",2,0],["فَأَسْبَحُ فِيْ بُحُوْرِ الْحُبِّ فَرْداً","وَلاْ أَرْتَدُّ إِنْ كَثُرَ الْمَلاْمُ",32,"م",1,0],["فَأُسْبِغَ مِن حُبٍّ لِرَبِّهِ خِلَّةً","وأُعْجِزَ مِن حَمدٍ لِرفْعَتِهِ الدَّهْرُ",33,"ر",1,0],["فأسبّحُ: \"سبحانَ الباري","وتعالى الخالقُ موجِدُه",34,"د",2,0],["فأسبح في فضاء منك يهدي","إلى المقتول أحلاما وزهرا",35,"ر",2,0],["فأسباب الزكام تشدّ بيني","وبينه بالغرام بلا طبيبِ",36,"ب",1,0],["فأسبح في غياباتي","عسي أن يأتيَ الصبحُ",37,"ح",1,0]]}