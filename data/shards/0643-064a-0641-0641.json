{"poems":[[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[87,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[101,"إمرأة مِنْ دُخَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68837&r=&rc=389",""],[203,"كيف فؤادي والهوى شاغل","https://www.aldiwan.net/poem45637.html","السريع"],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[563,"نحن قوم متنا به وفنينا","https://www.aldiwan.net/poem33804.html","الخفيف"],[870,"","https://poetry.dctabudhabi.ae/diwan/poem/178016","الخفيف"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123645","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93582","الرمل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87407","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108290","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135664","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4724,"ماس وغصونه مواريجي","https://www.poetsgate.com/ViewPoem.aspx?id=25792",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""]],"verses":[["كيْفَ فَارَقْتَهُ وَلَمْ يَتَفَطَّرْ","جَزَعاً ذَلِكَ المُصَابُ الحَزِينُ",0,"ن",1,0],["كَيفَ في الخُلدِ ضَربُ أَحمَدَ بِالعو","دِ وَنَفخُ الأَمينِ في الأَرغولِ",1,"ل",1,0],["كيفَ فَكَّرتِ في الزيارة؟ قولي","بعد أن أطفأت هوانا السنونُ",2,"ن",1,1],["كيفَ فؤادي والهوى شاغلٌ","يهيجهُ المنزلُ والنازلُ",3,"ل",1,1],["كَيفَ فرجيل وَالمَعرّي وَهو","ميروس في ذلِكَ المَكان الهَوائي",4,"ا",2,0],["كيف في الكل لن تبين وبانت","وهي نور لما يزل مستبينا",5,"ن",2,0],["كيف فارقتهم وصرت الى قو","م يرونَ الحرامَ في الرّفضِ حِلاّ",6,"ل",2,0],["كيف فارقتني وكنا جميعاً","فرقدي الفة صفت ومحبه",7,"ب",2,0],["كَيفَ فيها بَعد لين الآس لَو","لَمست أَخشن مِن شوك القتاد",8,"د",1,0],["كيف في المجد تضاهي بعد أن","كنت للمجد سناءً وسناما",9,"م",2,0],["كيفَ فعل الحبّ في اكبادكم","كيفَ تلك الفاتراتُ الباتراتُ",10,"ت",1,0],["كيف فرار قاده","لأخي وقد غلت يداه",11,"ا",2,0],["كيف فارقتنا الفراق الأليمَا","دون رفق وكنت قبلاً رحيمَا",12,"م",2,1],["كيف في الليل بعد نومٍ خليلي","إن خِلّي هاءٌ ونونٌ ودالُ",13,"ل",1,0],["كيف فيه النفوس تسكن روعاً","وله السائق الظلوم المحكم",14,"م",1,0],["كيف فكري في مخاريجي","كم أجاسي مَنّه ومِنّه",15,"ن",2,0],["كيف فرسان سرايا هاشم","تنشر الأعلام بالزحف انعقادا",16,"د",2,0]]}