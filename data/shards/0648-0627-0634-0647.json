sgate.com/ViewPoem.aspx?id=205778",""],[4977,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=199748",""],[4988,"ما نهض ابن الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=180737",""],[5061,"البر","https://www.poetsgate.com/ViewPoem.aspx?id=147159",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5150,"حوران .. الثورة ..!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202805",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[592,"أقول نعم هذا هو الحق والهدى","https://www.poetsgate.com/ViewPoem.aspx?id=128810",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"أشهد","https://www.poetsgate.com/ViewPoem.aspx?id=185789",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5488,"وغيارك يا الضعيف المحتاي","https://www.poetsgate.com/ViewPoem.aspx?id=100731",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63500",""],[5606,"ليت فلان نام","https://www.poetsgate.com/ViewPoem.aspx?id=207434",""],[5694,"اعشقك نجد","https://www.poetsgate.com/ViewPoem.aspx?id=132105",""],[5756,"الاولي والتالي","https://www.poetsgate.com/ViewPoem.aspx?id=5415",""],[5781,"بِلَونِ عينيكَ القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=204074",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5861,"وَرَجعْتَ!!","https://www.poetsgate.com/ViewPoem.aspx?id=192660",""],[5939,"تعريف من معجم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=180328",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5956,"حجمي صغير","https://www.poetsgate.com/ViewPoem.aspx?id=181864",""],[5956,"اشتهاءُ النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=183219",""],[5956,"هذي الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183285",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5956,"أواصلُ الانجذاب إلى حياتي الجديدة بمدريد","https://www.poetsgate.com/ViewPoem.aspx?id=192079",""],[5956,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=192541",""],[5956,"أغلى امرىءٍ في الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=193977",""],[6069,"وأشهى ما إلي إذا أضاءت","https://www.poetsgate.com/ViewPoem.aspx?id=105668",""],[6115,"يسلمون اللى تعنوا في لزومي","https://www.poetsgate.com/ViewPoem.aspx?id=196472",""],[6152,"لك العهد الوثيق","https://www.poetsgate.com/ViewPoem.aspx?id=204876",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""]],"verses":[["وَاِشهَدوا قَد نَذَرتُ إِن كان مِن فَو","زٍ عَلى ما يُقِرُّ عَيني تَدومُ",0,"م",1,0],["وَأَشهَدُ أَنَّكَ بي واثِقٌ","وَإِن كُنتَ تُظهِرُ ما تُظهِرُ",1,"ر",1,0],["وَأَشهَدُ رَبّي أَنَّ عُثمانَ فاضِلٌ","وَأَنَّ عَلِيّاً فَضلُهُ مُتَخَصِّصُ",2,"ص",1,0],["وأشْهَبٍ في سَماءِ النّقْعِ مخْتَرِقٍ","كأنّه قاذِفٌ يهْوي لمُسْتَرِقِ",3,"ق",1,0],["وَأَشْهَى مِنَ الأَمْنِ الْمُتَاحِ لِخَائِفٍ","وَأَحْسَنُ مِنْ نَيْلِ الْغِنَى عِنْدَ مُعْدِمِ",4,"م",1,0],["وَاِشهَدي يَومَ التَنادي أَنَّنا","في سَبيلِ الحَقِّ قَد مِتنا كِراما",5,"م",2,0],["واشهى الوصل ما كان اختلاسا","وخير الحب ما فيه احتشام",6,"م",1,0],["وأشهبَ كالقرطاس قد خطَّ صفحَهُ","كتابٌ من النصر المؤزَر مُحكَمُ",7,"م",1,0],["وأشهدني عهدَ الشهيدِ بأنعمٍ","أبى عطفها أن لا يكون مؤكدا",8,"د",2,0],["وأشهى إليه من رجوع شبابه","رجوعكَ يا قاضي القضاةِ مؤيدا",9,"د",2,0],["وأشهد أنَّ في خدَّيه جمراً","لأنَّ بمهجتي منه اشْتعالا",10,"ل",2,0],["وأشهب كالسهم في انْقضاضه","وصفحة الطرس في ابْيضاضه",11,"ه",1,0],["وأشهى من أغانيها","إلي النار والفلق",12,"ق",1,0],["وأشهدُ ما يكونُ عل هجاءٍ","هُجيتَ به إذا عاقبتَ فيهِ",13,"ي",2,1],["وَأَشهَدُ أَنَّها أَسَدُ بنِ نَهدٍ","وَما وَلَدَت بَني أَسَدٍ نِزارُ",14,"ر",1,0],["وَاِشهَدِ الفَنَّ سُفوحاً وَذُرىً","وَالهَوى الصافي أَريجاً وَمِياها",15,"ا",3,0],["وَأَشهَدنا الغَي","بُ شَيئاً عُجاب",16,"ب",1,0],["وأشهبُ الصبح في إغارته","يستاقُ ما للنّجومِ من سرحِ",17,"ح",1,0],["وأشهدا عليهما بذاكَ في","رابعَ عَشرَ رمضانَ الأشرفِ",18,"ف",1,0],["وَأَشهَبُ وَضّاحٌ تَحَمَّلَ رُقعَةً","مِنَ الحُسنِ لَم تَعبُر بِهِ العَينُ في بَسرِ",19,"ر",1,0],["وَأَشهَبٍ ناصِعِ القِرطاسِ مُؤتَلِقٍ","كَأَنَّما خاضَ ماءَ الصُبحِ فَاِغتَسَلا",20,"ل",2,0],["وَأَشهَدُ عِندَ اللَهِ أَنّي رَأَيتُها","وَعُشرونَ مِنها إِصبَعاً مِن وَرائِيا",21,"ي",2,0],["واشْهديهِ في حماهم مأتماً","لو رَعَوْا للضَّعفِ حقَّاً لم يَقُمْ",22,"م",1,0],["وأشهدُ من حولِ النبيِّ بلاءَها","وأُنشِدُها في اللّهِ هذي القوافيا",23,"ي",2,0],["وَأَشهَدُ أَنَّ اللَهَ لا شَيءَ فَوقَهُ","عَلِيّاً وَأَمسى ذِكرُهُ مُتَعاليا",24,"ي",2,0],["وَأَشهَدُ أَنَّهُ مِنهُم بَريٌّ","وَكانَ بِأَن يُقَتِّلَهُم خَليقا",25,"ق",2,0],["وأشْهَدُ أنّ الدّينَ أنْتَ مَنارُهُ","وعُرْوَتُهُ الوُثْقَى التي لم تُفَصَّم",26,"م",1,0],["وأشهى من ركوب الخيل عندي","ركوبُ خرائدٍ بين الخيامِ",27,"م",1,0],["واشهى من معانقةٍ لقَرنٍ","معانقةُ الصديقةِ للصديق",28,"ق",1,0],["وَأَشهَدُ أَنَّني غاوٍ جَهولٌ","وَإِن بالَغتُ في بَحثٍ وَدَرسِ",29,"س",1,0],["وَأَشهَدُ أَنَّ الدَهرَ كَالحُلمِ زائِلٌ","وَأَنَّ أَديمَ البَدرِ يَبلى وَيَحلَمُ",30,"م",1,0],["وَأَشهَدُ أَنّي بِالقَضاءِ حَلَلتُها","وَأَرحَلُ عَنها خائِفاً أَتَأَلَّهُ",31,"ل",2,0],["وَأَشْهَدُ مَكْبِريهِ كَيْفَ تُؤْتَى","ثِمَارُهُمَا الحَصَافَةُ وَالفَتَاءُ",32,"ا",2,0],["وَأَشْهَدُ الْحَشْدَ لِلشُّورَى قَدِ اجْتَمعُوا","وَلَسْتُ أَسْمَعُ مِنْ لَغْوٍ وَلاَ صَخَبِ",33,"ب",1,0],["وأشهد طفليَ يَيَفَعُ، ثم","يَشبُّ، ويصبح شهمًا أبيا؟",34,"ي",2,0],["وأشهد أنّ الظلم يردي فلو طغى","على السفح هضب شامخ زلزل الهضب",35,"ب",1,0],["وأشهدُ  حتى كتابةِ هذي السطور-","بأنك بين النساءِ الأخيرة..",36,"ر",2,0],["واشهد جمال القرب","من طورسينا الوهب",37,"ب",1,0],["واشهد من الهالات","إذا تنجلي نور اللَه",38,"ه",1,0],["وأشهبَ فضي الأديم مدنرٍ","عليه خطوطٌ غير مفهومةٍ حرفا",39,"ف",2,0],["واشهد فديتك إنه المجد","المؤثل يوم ينشد",40,"د",1,0],["وأَشْهَدُ الغارةَ مسروحةً","تغدو لماء النعم الوارِد",41,"د",1,1],["وَأُشهِدُها غَمَراتِ الحُروبِ","فَسِيّانِ تَسلُمِ أَو تُعقَرُ",42,"ر",1,0],["وأشهى من الراحِ ممزوجةً","وأحلى من الشَّهد والزنجبيلْ",43,"ل",1,0],["وَأَشهَدُ أَنَّهُم كَذَبوا عَلَيهِ","شَهادَةَ عالِمٍ بِهِم خَبيرِ",44,"ر",1,0],["وأشهد أن الل لا شيء غيره","وأنسب أحكام الإله إلى العدل",45,"ل",1,0],["وَأشهدُ أَن اللَّه لا ربّ غيره","وَأنّ لهُ في خلقهِ النفعَ والضرّا",46,"ر",2,0],["وَأشهدُ أنّ المُصطفى خير رسلهِ","وَأعظمُهم فَضلاً وأرفَعهم قدرا",46,"ر",2,0],["وَأَشهَدهم ما لَم يرِد فيهما مَعاً","بِنورِهما قاسوا عَلى قدرهِ قدرا",46,"ر",2,0],["واشهد ما في الارض من صنع ربها","كقلب اب برٍّ يحبُّ بهِ الولدا",47,"د",2,0],["واشهرها اضحت ربيعا لاننا","بطيب لياليها نسينا المحرما",48,"م",2,0],["وأشهد أطياف الفراديس إن بدت","تراود أحلامي مزاحاً وأهوائي",49,"ي",1,0],["وأشهد أنه أولى مهم","وأفضل ما تقدمه اليدان",50,"ن",1,0],["وأشْهبٍ مِخْلَبُهُ شَبَاهُ","كلُّ ذوات الرِّيش مِن عِدَاه",51,"ا",2,0],["وأشهد أن الأنبياء جميعهم","ومعجزهم حقٌ وذلك يُقنع",52,"ع",1,0],["وَأَشهَبٍ تِخالُهُ","مِن مَرَحٍ ذا أَولَقِ",53,"ق",1,0],["وَأَشهَدُ في الرَوعِ يَومَ اللِقاءِ","وَإِن قُسِمَ الفَيءُ لا أَشهَدُ",54,"د",1,0],["وأشهى إلى الظمآن من نَقعٍ غُلَّةٍ","وأَبهى لدى الضُّلالِ من طَلعةِ البَدرِ",55,"ر",1,0],["واشهد ما شمتَ بفيض الحق","ق مع التسليم به تَهج",56,"ج",1,0],["واشهد الحقّ فيك بالفرق حتّى","تشهد الجمع منك بالكلّ آيل",57,"ل",1,0],["وأشهب المشرق جد يتلو","من عسكر المغرب دهما فلّوا",58,"ل",3,0],["واشهر حسامَكَ حامياً أو ناصِراً","فهو الذي دونَ المحارم يُشهر",59,"ر",1,0],["وأشهى من فكاهة بنت عشر","وَتَقبيل المعسلة الرضاب",60,"ب",1,0],["واشهد لطف الفضل في كون آدم","من الطين مخلوق اليدين النزيهة",61,"ه",1,0],["واشهد جمالاً أشرقت أنواره","في كل شيء ظاهراً لا خافي",62,"ف",2,0],["وأشهد أن اللَه لا رب غيره","إله عليم عالم بالسرائر",63,"ر",1,0],["وأشهد أن اللَه أرسل أحمداً","إلى الخلق طراً بالهدى والبصائر",63,"ر",1,0],["واشهد أن الموت حق وكل ما","أني بعده من بعث من في المقابر",63,"ر",1,0],["وَاِشهد بمرأى منكَ فيه مخابراً","كانَت بِصحبكِ للألى أَخبارا",64,"ر",2,0],["وأشهدتني ما كان عنّي خافيا","وربّ شهيدِ العين غير شهيد",65,"د",1,0],["وَأَشْهَبٍ كَأَنَّهُ شِهابُ","لَهُ مَضاءُ وَلَهُ التِهابُ",66,"ب",1,0],["وَأَشهَدني غَيبي حُضوراً وَغَيبَةً","وَحاشا لَها مِن غَيبَةٍ بَعدَ حَضرَةِ",67,"ه",1,0],["وَأَشهَدُ الرِقِّ مَنشوراً لِمَشهَدِكُم","بِناظِرٍ قَد طَواهُ المَوتُ في الجَدَثِ",68,"ث",1,0],["وَأَشهَدُهُ في غَيبَتي بِحُضورِهِ","بِغَيرِ حِجابٍ في عُيونِ عُيوني",69,"ي",1,0],["وَأَشهَد حَقّاً أَن فوق جَبينه","لطرَّة لَيل قَد حكت لَيلة القَدرِ",70,"ر",1,0],["وَاِشهد مَحاسنَ مُنيتي فَلَقَد سَما","بِجَمالِ طَلعته عَلى النُظَراءِ",71,"ر",3,0],["وَاِشهَدي القَبر الَّذي رَتبته","بِرَسول اللَهِ أَعلى الرُتَب",72,"ب",1,0],["وأشْهَبُ يُغْني عن حُجولٍ وغُرَّةٍ","غِنَى عُرْفِكَ المعروفِ عنَ مَدْحِ مادح",73,"ح",1,0],["وأشهد بالزوراء ربعاً كأنما","به كان زوراً مولدي وترعرعي",74,"ع",2,0],["وأشهرُ ما يَروونَه عنه قولهُ","تركتُ كتابَ اللَهِ فيكُم وعِترَتي",75,"ت",2,0],["واشْهَدْ لبانيه إعجاباً بهمَّتِه","بما بناه وعَلاّه وشيّده",76,"د",2,0],["وأَشْهَدُ أنَّ الله لا ربَّ غيره","وأنَّ وليّ الله بين الملا علي",77,"ي",1,0],["وأشْهَبَ يكسوه الصباح رداءه","كما أَشْرَقَ الإِسلام في ملَّة الكفر",78,"ر",1,0],["واشهر أسوداً من ادعجيه","تحاذر فتكه البيض الصقالُ",79,"ل",1,0],["وأشهدُ من أفكاره نارَ فِطْنةٍ","تصَعَّدُ من أنفاسِه عبقَ النَّدِ",80,"د",1,0],["وأشهرُ من ذا الضمّ فيها ولو درى","لقالَ كما قالته أخوةُ يوسفِ",81,"ف",1,0],["واشهدي كيف يستعز بي الحسن","لخلقي فالحق ديني وفرضي",82,"ض",2,0],["وأشهدَ أوراقَ الخريف مجانياً","من الجَّنة الفيحاءِ لا ذابلِ الشجر",83,"ر",1,0],["وأشهد إن لم تغنني العامَ هذه","فلا ريع ممنوعٌ ولا جاد منعِمُ",84,"م",1,0],["وأَشهَدُ النادي فمستعبَدُ ال","سمعِ بآياتي ومخلوب",85,"ب",1,0],["وأشهرُ قولي قبل سيفي وأنني","بحدَّيْهما عند الكريهةِ قاطعُ",86,"ع",1,0],["وأشهدت حزب الاشتراكية الذي","تركته يستبكي العدالة مشفقا",87,"ق",2,0],["وأشهد بحر الجمع والفرق غواصا","قواميسه أبغي الحياة اليحيويه",88,"ي",2,0],["وأشْهدُ من مَجْلاكَ في كلِّ بارزٍ","جَمالاً ولو ضمنَ الصَّبا بالهَفاهفِ",89,"ف",1,0],["وَأشهده ذاتاً وَعرفه حلىً","وَمكنهُ قُرباً وَصرمه حكما",90,"م",2,0],["وأشهدُ لو طالتْ يدُ الحزمِ في الورى","لما درّ للدّنيا على أهلها دَرُّ",91,"ر",1,0],["واشهد الحق في سواه به","وهو غيب عن كل ما يعنونْ",92,"ن",1,0],["واشهد علامته تشهده حيث بدا","والله غيب ومشهود بمن خلقا",93,"ق",2,0],["وأشهدني ظلمي فشاهدت ظلمتي","تجلِّي جمالٍ للعقول أشاعه",94,"ع",2,0],["واشهد بما تعرف فيما ترى","شهادة الحق بغير استناد",95,"د",1,0],["وأشهدتهم عني ألست بربكم","فقالوا بلى طراً بنفس مطيعة",96,"ه",1,0],["وأشهَرُ شيءٍ أنَّه فَرْدُ عَصرِهِ","فذلكَ تَدريهِ شُيوخٌ وأطفالُ",97,"ل",1,0],["وأَشهد حقّاً أَنَّ فوقَ جَبِينيهِ","لآياتِ حسنٍ هنَّ من سُورَة الفَجْرْ",98,"ر",1,0],["وَأَشهَرُ لَيلي عَلى أَنَّني","أُراعي الدُجى ما أَذوقُ المَناما",99,"م",2,0],["وَأشهَدَ ما في الناسِ مِن مُتَأَخِّرٍ","يُدانيكَ فيهِ لا وَلا مُتَقَدِّمِ",100,"م",1,0],["وأشهدُ في بُردٍ مِن المجدِ تَشهدُ النّ","بُوَّةُ عَنهُ أنَّه مِن بُرودِها",101,"د",3,0],["وأشهى مِنهُ عند الغيدِ لُبسا","مُباشَرةُ السِّلابِ أو الحِداد",102,"د",1,0],["وأشهدتني في الليل ناري فجئتها","أرجى الهدى من وهم النهى ضلا",103,"ل",2,0],["وأشهدني في مشهد الكشف شاهدي","بعين الرضا في كل أرض لها رضوى",104,"و",2,0],["وأشهدني في شاهدي عند عودة","توسع في غياي كل توسع",105,"ع",1,0],["وأشهدُ أنّ النبيَّ الأمينَ","بلّغ فيكَ نداءً جهيرا",106,"ر",2,0],["وأُشهِدُ ربّي أنّ قولَك حُجّةٌ","على الخَلق طُرّاً من مُطيعِ ومُذْنبِ",107,"ب",1,0],["واشهدُ أنه حلوٌ مذاقاً","أبِن لي كيف صار الدرُّ شهدا",108,"د",2,0],["وأَشهد بِالتذكارِ رَوضة أَرضهم","فتهمي عَلَيها مُقلَتي كَسَحابِ",109,"ب",1,0],["وأشهدتني مجرى الحياة ولم تزل","تريني وإن مت المدى والنواحيا",110,"ي",2,0],["وأشهد أهل المهرجان موَفِّياً","لهم حقَّهم من طيِّبات وتكريم",111,"م",1,0],["واشهد من الشعب صدقَ الحبِّ يعلنه","فيما تراه وتلقاه وترضاه",112,"ا",2,0],["وأشهدَهُ فيهم مطافك ما سرى","إليه به برقٌ وسار بريد",113,"د",1,0],["وأشهد في الأرض حكم السماء","وألقى مقاديرها الجاريه",114,"ي",2,0],["وَاِشهَدِ النّورَ كَبرقٍ لَمَعا","مِن نَواحي طيبة ذاتِ الفَخارْ",115,"ر",1,0],["وَاِشهَدِ النورَ كَبَرقٍ بَسَما","وَبِمَرآهُ اِبتَهِجْ وَاِسْتَأْنِسِ",115,"س",1,0],["وَاِشهَد بِجنحِ اللّيل زهرَ السّما","وَضَوءها في الأَرضِ يَعلو الفَنَن",116,"ن",1,0],["وَأَشهَدني عَلِّي أصدِّق قَوله","فَقُلت لَهُ ما حَدَّثته الأَوائلُ",117,"ل",1,0],["وَأشهد الأَلطافَ مِما صَنَعت","يَداك في الكَون لَنا وَأَبدَعت",118,"ت",1,0],["وأشهد لمْ تسلَمْ حلاوة شُهده","لِصابٍ إليه من مَرارة صابه",119,"ب",2,0],["وأشهد أن المجد شَهْدٌ ودونَه","مَكارهُ فاشهدهنَ والسمُّ في الدسمْ",120,"م",1,0],["وأشهد منه المنع ضربا من العطا","وفي الفصل معنى الوصل بالأصل قيما",121,"م",2,0],["وأشهد أنك نور الهدى","إمام الورى خير حام وحامد",122,"د",1,0],["وأشهب في غدير الصبح منغمس","وأصفر بمذاب التبر مغسول",123,"ل",1,0],["واشهب يعبوبا طمرا مضمرا","طموحا مروحا أعوجيا مطهما",124,"م",2,0],["وَأشهر من أوسِ بن سعدٍ وخالدٍ","وَأحلم مِن قيسٍ وعمرو بن مزيدِ",125,"د",1,0],["وَأَشْهَى مِنَ الْعَذْبِ النَّميرِ عَلى الظَّما","وَأَبْهى مِنَ الْبَدْرِ المُنِيرِ وَأَبْهَرا",126,"ر",2,0],["واشهد غرائبه واسلك مسالكه","وافهم دقايقه واعش إلى ناره",127,"ر",2,0],["واشهده في علمه من حيث شاهده","يقوم في الذكر من تحقيق نشاته",128,"ت",2,0],["واشهدوا منه عند ما يتجلى","مطلع العلم من جهات المغيب",129,"ب",1,0],["واشهر على النفس الخبيثة سيف عز","م واسأل النصر من الوهاب",130,"ب",1,0],["وأشهدهم اياه منه تكرما","تولاهم باسم البديع تنزلا",131,"ل",2,0],["واشهب من بزاة الدهر خوّى","على فودى فألمأ بالغراب",132,"ب",1,0],["وَأَشهَد سنى أَنوار طَلعة شَمسِهِ","مُتَنَعِماً مِن لُطفِهِ بِجِنان",133,"ن",1,0],["وَأَشهَد حَقاً إِن فَوقَ جَبينه","هِلالٌ عَلى غُصن تَكَلل بِالزَهر",134,"ر",1,0],["وَاشهد بِغصن القَدِّ","رُمانَتَي نِهدايا",135,"ي",2,0],["واشهدْ له أنّه أكفاهمُ ثقةً","أصفاهمُ خُلُقاً أَوفاهمُ ذِمَما",136,"م",2,0],["وأشهد ذاك الضريح الذي","بنورِ إله الوجودِ استنارا",137,"ر",2,0],["وأشهدها بالقلب حتى كأنني","أشاهدها بالعين في كل صورة",138,"ه",1,0],["وأشهر بين السالفين جبينه","مهند فرق لا يغيب سناه",139,"ا",2,0],["وَأَشْهَدُ أَنَّ الله لاَ رَبَّ غَيْرُهُ","تَنَزَّهَ عَنْ حَصْرِ الْعُقُولِ تَكَمُّلا",140,"ل",2,0],["واشهروا في حومة العلم لها","صارماً عضباً ورمحاً سمهريّا",141,"ي",2,0],["وأشْهَدْتَنا منه يوماً تَعالى","فذلَّ الزمانُ له واستكانا",142,"ن",2,0],["وَأشْهَى من ليالي الوصلِ تَتْرى","ويا شوقاً إلى تلكَ الليالي",143,"ل",2,0],["وأشهى من الراح العقار تعلّلا","والاوبة بعد الغنم من وحشة السفر",144,"ر",1,0],["واشهرَ شهيرَ الثَّناء عن ملِك","له عروس الكمَال تُمتهر",145,"ر",1,0],["وأشهدنا السعود شموس حسن","تزيد سناً على الشمس المضيه",146,"ي",2,0],["واشهده عند اللوى وانعطافه","وإن كمال الحق في مشهد الجزعِ",147,"ع",1,0],["وأشهدتُ من علمِ الغيوبِ عجائباً","تصانُ عن التذكارِ في عالم الحسِّ",148,"س",1,0],["وَاشهَد عَلَيهِم إن سُئِلتَ بأنَّهُم","قَالُوا إلَهُ العَرشِ وَالأكوَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُ سُبحَانَهُ","مُتَكَلِّمٌ بِالوَحَيِ وَالقُرآنِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّه سُبحَانَهُ","قَد كَلَّمَ المَولُودَ مِن عِمرَانِ",149,"ن",1,0],["واشهَد عَلَيهِم أنَّهُم قَالُوا بِأنَّ","الله نَادَاهُ بِلاَ كِتمَانِ",149,"ن",1,0],["واشهَد عَلَيهم أنهُم قَالُوا بِأنَّ","الله نَادَى قَبلَهُ الأبَوَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنهُم قَالُوا بأنَّ","الله يَسمَعُ صَوتَهُ الثَّقَلاَنِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم وَصَفُوا الإِل","هَ بِكُلِّ مَا قَد جَاءَ فِي القُرآنِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّ قَولَ نَبِيِّهِم","وَكَلاَمَ رَبِّ العَرشِ ذَا التِّبيَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم قَد قَابَلُوا التَّ","عطِيلَ وَالتَّمثِيلَ بِالنُّكرَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم قَد أثبَتُوا ال","أسمَاءَ وَالأوصَافَ للدَّيَّانِ",149,"ن",1,0],["وَاشهَد عَليهِم أنَّهُم قَالُوا بِهَ","ذَا كُلِّهِ جَهراَ بِلاَ كِتمَانِ",149,"ن",1,0],["وَاشهَد عَليهِم أنَّهُم بُرَآءُ مِن","تَأويلِ كُلِّ مُحَرِّفٍ شَيطَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم يَتَأوَّلُو","نَ حَقِيقَةَ التَّأوِيلِ فِي القُرآنِ",149,"ن",1,0],["وَاشهَد عَليهِم أنَّ تَأوِيلاَتِهم","صَرفٌ عَنِ المَرجُوحِ للرُّجحَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم حَمَلُوا النُّصُو","صَ عَلَى الحَقِيقَةِ لاَ المَجَازِ الثَّانِي",149,"ن",2,0],["وَاشهَد عَلَيهِم أنَّهُم لا يَكفِرُوا","نَكُمُ بِمَا قُلتُم مِنَ الكُفرَانِ",149,"ن",1,0],["وَاشهَد عَليهِم أنَّهُم قَد أثبَتُوا ال","أقدارَ وَارِدَةً مِنَ الرَّحمَنِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّ حُجَّةَ رَبِّهِم","قَامَت عَلَيهِم وَهُوَ ذُو غُفرَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم هُم فَاعلُو","نَ حَقِيقَة الطَّاعَاتِ وَالعِصيَانِ",149,"ن",1,0],["وَاشهَ عَلَيهِم أنَّ إِيمَانَ الوَرَى","قَولٌ وفِعلٌ ثُمَّ عَقدُ جَنَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّهُم لَم يُخلِدُوا","أهلَ الكَبَائِرِ فِي حَمِيمٍ آنِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّ رَبَّهُمُ يُرَى","يَومَ المَعَادِ كَمَا يُرَى القَمرَانِ",149,"ن",1,0],["وَاشهَد عَلَيهِم أنَّ أصحَابَ الرَّسُو","لِ خِيَارُ خَلقِ الله مِن إنسَانِ",149,"ن",1,0],["وَاِشهَد الشَمسَ مَزَّقت حُجُبَ الغَي","مِ وَأَبدَت لَنا مُحَيّا جَميلا",150,"ل",2,0],["وَاِشهَدي لِلشَرقِ عُرساً زاهِراً","عَن عُكاظٍ في مجاليهِ سَلي",151,"ل",2,0],["وأشهد أن الله لا رب غيره","واسأله عفوا وإتمام ما ابتدي",152,"د",2,0],["وأشهد عندالله يوم لقائه","بأن ثنايا أم سعد لطائم",153,"م",1,1],["واشهيداه لست أنساه يدعو","رب فاحكم بيني وبين اللئام",154,"م",1,0],["وَأَشهَدُ وَالمُستَغفَرُ اللَهُ أَنَّني","كَذَبتُ عَلَيها وَالهِجاءُ كَذوبُ",155,"ب",1,0],["وَأَشهَدُ مِن عَوفٍ حُلولاً كَثيرَةً","يَحُجّونَ سَبَّ الزَبرَقانِ المُزَعفَرا",156,"ر",2,0],["وَأَشهَدُ أَنَّها وَلَدَت زِياداً","وَصَخرٌ مِن سُمَيَّةَ غَيرُ دانِ",157,"ن",1,0],["واشهد به نور رضى المولى وقف","وقفة من أحسن فيه ظنه",158,"ن",2,0],["واشهد حلى منشيه فيما قد بدا","من صنعه الزاهي البديع المحكم",159,"م",1,0],["وأشهى من مشعشعة الحميا","تعاطيها بنات الغانيات",160,"ت",1,0],["وأشهل كاسر الأجفان يرنو","كما ترنو إلى الصيد البزاة",161,"ه",1,0],["وأشهد أن مرة حي صدقٍ","ولكن لست منهم في النصاب",162,"ب",1,0],["واشهد مناقبه الجليلة سطرت","من أوج