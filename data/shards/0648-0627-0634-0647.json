,["واشهد أن قربك من زياد","كقرب الفيل من ولد الأتان",191,"ن",1,0],["وَأُشهِدُ رَوَّضَةَ الخَيلِ أَهلي","بِأَنِّيَ لَن أَسمَحَنَّ بأَهلي",192,"ي",1,0],["وأَشهَدُ لستَ تَلقى بَعدَ خَذلي","كُنُوزَ المالِ في جُرُفِ البِحارِ",193,"ر",1,0],["وأشهرت ذكري بين عُرب وأعجُم","وأوليتني فخري على كل امثالي",194,"ل",2,0],["واشهيدا دمه كالمسك في","طيبه قد فعم الجو شذى",195,"ا",1,0],["واشهد بأن اللهَ ربَّك قادرٌ","يحيي الرفاتَ غداً ولو طال المدى",196,"د",2,0],["وأشهد منكم مشهدا مدهشا به","يزول العناعنى ويمحى به المقط",197,"ط",1,0],["وأشهده في حضرة القرب مشهدا","به الخمس عن خمسين فرضا تعوّضا",198,"ض",2,0],["واشهد منكم مشهدا مدش الحجى","وأنشق نشرا منه عنى العنا يطوى",199,"و",2,0],["وأَشهدُ أنَّ الحسنَ ما خطَّ خطّهُ","بعارضهِ والسِّحرُ ما طرفه يُملي",200,"ل",2,0],["واشهد خصوص السر لا الظواهر","فالسر لا ينزع من الطواهر",201,"ر",1,0],["وأشهدُ أني بالذي لا أرى ولا","أخاف إلهي والإلهُ عظيمُ",202,"م",1,0],["واشهدْ بأن رسولَ الله سيدُنا","ونبينَا المبعوث بالأنوارِ",203,"ر",1,0],["وأشهروا ويلهم رأس الحسين على","رمح يطاف به في سائر المدن",204,"ن",1,0],["واشهى مشرب في حلقه ان","تدار عليه كاس خنى وقذف",205,"ف",1,0],["وأشهى من ليالي الحبّ عيدٌ","نَظمتِ به بَنِيكِ المُخلصينا",206,"ن",2,0],["وأُشهر سيف الشعر والقول تارة","ولكن لقوم راية السوء حملوا",207,"ل",3,0],["واشهَد عليكَ, لأنّي","أَشدُو, وأَنتَ تُعَذِّبْ",208,"ب",1,0],["واشهر جملة قالها واعلنها","الغى مصادرة الفكر من باله",209,"ل",2,0],["واشهد جنا الشهد لدى رشفها","فيا مني من كان فيها شهيد",210,"د",1,0],["واشهد أن الله خلاق الأنام","قد وهبنا المملكه أبلا ثمن",211,"ن",1,0],["واشهد أن العشق يسري بالعظام","ألديار الحق... اليوم الكفن",211,"ن",1,0],["واشهدْ بتقواها مثالا يُحْتذَى","ولديكَ \"آسيةُ\" الهدَى تحْكيها",212,"ي",3,0],["وأشهقُ كلما نادى حبيبٌ","أظنُّ الروحَ قد نادت علَيَّا",213,"ي",2,1],["واشهد اني في مطيحي صحت ماجاني حدى","يا .. قبيله ما عرفنا غير صيت ولا / جديد",214,"د",1,0],["واشهد اني م انتخيتك يالقبيله في ردى","مير ما بك من رجال آ وكان فيها ما يفيد",214,"د",1,0],["واشهد انه يالقبيله فيه من لبّى الندى","حاول آ وحاول ولكن ما نهض ابن الوليد",214,"د",1,0],["واشهد ان الشوق له ماهوب عادي","كالسجين إللي يبي فكة قيوده",215,"د",2,0],["وأشهد ما عنه العبارات أفحمت","ولا أفهمتناه الإشارات بالإيما",216,"م",2,0],["واشهدْ على الأحرارِ أذكوا ثورةً","أحيتْ نفوسَ العُربِ في الأوطانِ",217,"ن",1,0],["وأشهد الناس مكتوبا على ورق","وثيقة ظلت الأوهام تمليها",218,"ي",3,0],["وأشهد عناه يا شهيد فإنه","لم يرض غير هواك من أهوائه",219,"ا",3,0],["وأشهدهم للشأن كل عظيمة","بعيني عظيم بين رفع وإسكان",220,"ن",1,0],["وأشهد الحق في جهد النبي وما","أولى ذرى العلم من عز ومن شان",221,"ن",1,0],["وَاشْهَِدْ وُجُودَكَ لَيْسَ مِنكَ وَإنَّمَا","فِي الكَوْنِ كَانَ مُكوَّنًا يَتَعَاكَسُ",222,"س",1,0],["وأشهد من الله ليس كمثله","شبيه ولا مثل ولا كفو يعلم",223,"م",1,0],["وأشهد أن الله لا ب غيره","تعالى عن الأمثال والجعل للندِّ",224,"د",1,0],["وأشهد أن الله أرسل عبده","محمداً الهادي إلى منهج الرشد",224,"د",1,0],["وأشهدُ أنّك الحبُ المعنّى","وحبك لايكون مع المثنى",225,"ن",2,1],["وأشهد أن لا إلها سواه","وأن الثواب لما يذكره",226,"ر",2,0],["واشهد بك يا قلّ العقل تاي","ما شي شرى عقل الكميلي",227,"ل",2,0],["وأشهد أن الله لا رب غيره","تعزز قدما بالبقاء وتفردا",228,"د",2,0],["وَأَشْهَرَ مِنْ شَمْسِ النَّهارِ وَبَدْرِها","وَأَثْقَلَ مِنْ قُدْسٍ وَرَضْوَى وَكَبْكَبِ",229,"ب",1,0],["وَأَشْهَرَ مِنْ أَوْسِ بنِ سَعْدٍ وَخالِدٍ","وَأَحْكَمَ مِنْ قُسٍّ وَعَمْرو بْنِ مَرْثِدِ",230,"د",1,0],["وأشهدإن ماكل من يسكت غشيم","غير يحسب للمقال وللمقام",231,"م",1,0],["وأشهد إن البل حلال أهل الشدادي","ماخلقها الله حلال أهل الرخامه",232,"م",2,0],["واشهد اني كل ما اسهى وافتكر برسومه","وما وعيت الا وانا ارمي غترتي وعقالي",233,"ل",2,0],["وأَشْهَدُ أنَّ الخَدَّ حالَ تبتُّلٍ","يَجيئُكَ مَخْفورًا ومِثْلُكَ يَغْفِرُ",234,"ر",1,0],["وأشهده ما لا يطاق شهوده","وأسكنه بحبوح علم الإرداتي",235,"ت",2,0],["واشهدْ مسيرَ الشمسِ نحو غروبِها","لنهايةٍ والليلُ ينعي الفرقدا",236,"د",2,0],["وأشهى ما اشتهى قلبي إذا سمّاكِ جاريتي!","أنا أُسميكِ ما أَهوَى فأنتِ خيولُ أَخْيِلَتي",237,"ت",2,0],["وأشهد أن الله أعدل حاكم","لجمعهم يوم القيامة محظر",238,"ر",1,0],["وأشهر قولها للناس عني","كفاني منه قوَّتُه الدَّفينةْ",239,"ن",2,0],["وأشهد نجمةً في الجوِّ مثلي","رَنَتْ نحوي غراما واحتراما",240,"م",2,0],["وأشهد الصخرَ طول الدهر ملتزما","حال السلام طهوراً مثلما أُحُدِ",241,"د",1,0],["وأشْهد وجهاً ثم وجهاً مُعَذَّبا","أشدَّ على نفسي مِنَ الموتِ طالبي",242,"ب",2,0],["وأشهد خيرَ شعب عاطفيٍّ","كبيرِ حضارة وافي العهودِ",243,"د",1,0],["وأشهد أنه اللهُ القديرُ","وأن نبيَّه الهادي البشيرُ",244,"ر",1,1],["وأشهد وجههُ يجلو همومي","وأدعو لحفظه مِن كل غَمّْ",245,"م",1,0],["وأشهى ما إلي إذا أضاءت","سماء الكأس من شمس العقار",246,"ر",1,1],["واشهران اللى يعرفون السلومي","والعساكر من على الحدّ اليماني",247,"ن",2,0],["وأشهد خالقي والقول حق","بأنكِ خيرُ من سكن الشغافا",248,"ف",2,0],["وأشهد من دب فوق الثرى","وتحت السما عزة المسلم",249,"م",1,0]]}