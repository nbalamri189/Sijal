{"poems":[[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[37,"عفت غيقة ٌ من أهلها فجنوبُها","https://www.poetsgate.com/ViewPoem.aspx?id=21919",""],[136,"صاحب الرحل والقلوص الرسوما","https://www.aldiwan.net/poem54652.html","الخفيف"],[415,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56646","المتقارب"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144771","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118344","الوافر"],[3039,"","https://poetry.dctabudhabi.ae/diwan/poem/105382","الوافر"],[4755,"لِإِيْلَافِ قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183517",""],[5704,"جمار الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=198797",""],[5997,"غريب","https://www.poetsgate.com/ViewPoem.aspx?id=214230",""],[6048,"نبوءة كل المياه","https://www.poetsgate.com/ViewPoem.aspx?id=201217",""]],"verses":[["تَلَظَّى عليهِمْ وَهْيَ قَدْ شُبَّ حَمْيُهَا","بِزُبْرِ الحَدِيدِ والحجارةِ سَاجرُ",0,"ر",1,0],["تَلَظَّى بهمْ بالنارِ بَرٌّ ، وقاءهُمْ","خِضمٌّ ، وراحَ الجوُّ يُمطرهم عَطْبا",1,"ب",2,0],["تلظّى النّصالُ الزُّرقُ فوقَ خُدُورِها","وتمضي أنابيبُ القنَا وكُعُوبُها",2,"ب",3,0],["تلظت بأضلعى زفراتٌ","مَن أصابته في الهوى لن يلوما",3,"م",2,0],["تُلِظُّ بأرضِ المشرِكين كأنّها","صوادٍ إلى وِردٍ حوانٍ حَوائمُ",4,"م",1,0],["تلظى اشتياقي بقلبي زماناً","ولكنه أصبح اليوم بردا",5,"د",2,0],["تلظى حشاياه من الحقد للورى","فيظهر فوه ما أكن من الظلم",6,"م",1,0],["تلظى النار في الكانون منه","اذا ما صافح الزند الشفارا",7,"ر",2,0],["تلظى غصن ذابله وروداً","ويغرسه فيثمر جلنارا",8,"ر",2,0],["تَلَظِّيهِ في القَلبِ أَحْنَى يَدًا","على القَلبِ مِن بَرْدِ إِنصافِهِ",9,"ف",2,0],["تلظتْ بروحي جمار الهوى","وزاد اشتياقي وطرفي همى",10,"م",2,1],["تُلَظَّى مِنْ جَحِيمِ الشَّوْقِ حَيْنًا","وَحَيَّنَا يَرْتَدِي الدلما حِدَادَا",11,"د",2,0],["تلظت عيوني فسالت نجيعا","وبت كئيبا وجيبا وجيعا",12,"ع",2,1]]}