adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62430&r=&rc=22",""],[31,"يا صاحبيّ، قفا نستخبرِ الطللا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19020&r=&rc=283",""]],"verses":[["وَعَرَضتُ نُصحي وَالقَبولُ إِجازَةٌ","فَإِذا أَبَيتَ لَوَيتُ عَنكَ عِناني",0,"ي",1,0],["وَعَرَفتُ بَينَ بُيوتِ آلِ مُحَرِّقٍ","مَأوى القِرى وَمَواقِدَ النيرانِ",1,"ن",1,0],["وَعَرَفتُمُ مِنّي مَخيلَةَ سُؤدُدٍ","خَفِيَت وَراءَ مَلابِسِ الإِقتارِ",2,"ر",1,0],["وَعَرَّفتُموني كَيفَ أَلتَمِسُ الجَدا","إِلى غَيرِ أَيدي الأَلأَمينَ الشُرابِثِ",3,"ث",1,0],["وَعَرِّج عَلى الغُرِّ مِن هاشِمٍ","فَأَهدِ السَلامَ لَهُم مِن كَثَب",4,"ب",1,0],["وعِرْضُ مِثلِكَ لا تَغْتالُهُ نُوَبٌ","تَفْتَرُّ عيشَتُهُ فيها عنِ الشّظَفِ",5,"ف",1,0],["وعرَّضْتَ مَنْ عاداكَ للهُلْكِ فانْتَهى","عنِ المُلْكِ حتى قَلَّ فيهِ المُنافِسُ",6,"س",1,0],["وعِرْضٍ كمَتْنِ الهِنْدُوانيِّ ناصِعٌ","تَذُبُّ المَعالي دونَهُ وتُحامي",7,"م",2,0],["وَعَرَفتُ أَنَّ مَنِيَّتي إِن تَأتِني","لا يُنجِني مِنها الفِرارُ الأَسرَعُ",8,"ع",1,0],["وعرّضْتَ للتّقْبيلِ كَفاً كريمةً","تَفيضُ على الطُّلاّبِ منها ينابِعُ",9,"ع",1,0],["وَعَرْضاً كَيَوْمِ الْعَرْضِ أَذهَلَ هَوْلَهُ","عِيَانِي وَأَعْيَانِي تَعَدُّدُ أَعْيَانِي",10,"ي",1,0],["وَعُرّيتَ مِن وَفرٍ وَمالٍ جَمَعتَهُ","كَما عُرِّيَت مِمّا تُسِرُّ المَغازِلُ",11,"ل",1,0],["وَعَرَفتَ اليَقينَ وَاِنبَلَجَ الحَ","قُ لِعَينَيكَ ساطِعاً كَالشِهابِ",12,"ب",1,0],["وَعَرَّفتَ دَهري مَكانَ الأَديبِ","وَقَد كانَ دَهري شَديدَ الكَلَب",13,"ب",1,0],["وَعَرَّدَ إِلّا كُلَّ ذمرٍ مغامِسٍ","وَنَكَّبَ إِلّا كُلَّ زاكٍ نِصابُهُ",14,"ب",2,0],["وَعَرَفتُ مِن ذي الطَوقِ عَمرٍ ثَأرَهُ","لِجَذيمَةَ الوَضّاحِ حينَ يُكادُ",15,"د",1,0],["وَعُروَةُ لَم يَلقَ الَّذي قَد لَقيتُهُ","بِعَفراءَ وَالنَهدِيُّ ما أَتَفَجَّعُ",16,"ع",1,0],["وَعَرَّسَ بِالسَكرانِ يَومَينِ وَارتَكى","يَجُرُّ كَما جَرَّ المَكيثُ المُسافِرُ",17,"ر",1,0],["وعرفت من جمر الأسى","ما ليس يستره رماده",18,"د",2,0],["وَعَرَفْتَ فِي إِكْرَامِهِمْ لَكَ مُنْتَهَى","مَا يَبْلُغُ الإِسْدَاءُ مِنْ عِرْفَانِ",19,"ن",1,0],["وَعَرَا الأَعْيُنَ الْكَلالُ فَأَنَّى","نَظَرَتْ حُمْرَةً رَأَتْ وَقَتَامَا",20,"م",2,0],["وعرقلوا بدعاويهم مساعيه","ومدّدوا من دواهيهم له كففا",21,"ف",2,0],["وَعِرقُ الفَرَزدَقِ شَرُّ العُروقِ","خَبيثُ الثَرى كابِيُ الأَزنُدِ",22,"د",1,0],["وَعَرَفتُ بَينَهُمُ فَهاجَ صَبابَةً","صَوتُ الحَمامِ إِذا الهَديلُ تَغَرَّدا",23,"د",2,0],["وَعَرَفتُ مُنتَصَبَ الخِيامِ عَلى بِلىً","وَعَرَفتُ حَيثُ تُرَبَّطُ الأَمهارُ",24,"ر",1,0],["وَعُروقُ نَبعَتِكُم لَها طيبُ الثَرى","وَالفَرعُ لا جَعدٌ وَلا خَوّارُ",24,"ر",1,0],["وَعَرَفتَ مَنزِلَةَ الذَليلِ فَلَم تَجِد","إِلّا التَلَهُّفَ ثُمَّتِ الإِقرارا",25,"ر",2,0],["وَعَرَّدتُمُ عَن جَعفَرٍ يَومَ مَعبَدٍ","فَأَسلَمَ وَالقَلحاءُ عانٍ أَسيرُها",26,"ر",3,0],["وَعَرجَلَةٍ شُعثِ الرُؤوسِ كَأَنَّهُم","بَنو الجِنِّ لَم تُطبَخ بِقِدرٍ جَزورُها",27,"ر",3,0],["وعرائس الأقلام واطربي بها","سودَ المحابرِ للقلوبِ سوالِبا",28,"ب",2,0],["وعروس جعلت لي","من بياض الوصل صبحه",29,"ح",2,0],["وعرفني بالحبِّ في خدِّ عارض","بدا ألِفاً ثم اسْتدارَ فلاما",30,"م",2,0],["وعَرُوسٍ قد جُهِّزتْ بطلاقٍ","عاتبتْ في وَليدَةٍ شَنْآءِ",31,"ا",2,0],["وعِرضُهُ العرض الذي لا يُلْطَخُ","بالطَّيخِ إذ بعضهم مُطَيَّخُ",32,"خ",1,0],["وعرَّضَ عرضَه عمداً لشعري","ليغسل عِرْضَه بعد اتِّساخِ",33,"خ",1,0],["وعَرّى لَمَرْضَاة الإِله مَنَاصِلاً","غِضَاباً عِضَاباً ليس فيهنَّ مُعضَدُ",34,"د",1,0],["وَعَرَتْهُ هِزَّةٌ تَأبى له","أن يُرى فيه عن المجد خُمُودُ",35,"د",1,0],["وعرضه أملسُ ما خيَّمتْ","آمال راجيه على أمْلَس",36,"س",1,0],["وعرّضتَ الخبيثة لي سفاهاً","فعِفْتُ خبيثها حَولاً دكيكا",37,"ك",2,0],["وَعَرَّت حِمارَيها وَقَد كانَتِ اِستُها","شَديداً بِسيساءِ الحِمارِ أُزومُها",38,"م",3,0],["وَعَرَفتُم وَعَرَفنا مِثلَكُم","أَنَّما الحَقُّ لِذي ظُفرٍ وَنابِ",39,"ب",1,0],["وَعَرَفتُ مِن فِرجَينِ جارَتِها","ما زادَني ضُرّاً عَلى ضُرِّ",40,"ر",1,0],["وَعَرَفتُم كَما عَرَفنا اللَهَ","لَخَرَرتُم أَمامَنا ساجِدينا",41,"ن",2,0],["وَعَرَّضتُم بِأَقوالٍ","وَما نَجهَلُ مَعناها",42,"ا",3,0],["وعرائسُ الغابِ الجميلِ هزيلةٌ","ظمأى لِكُلِّ جَنًى وكُلِّ شَرابِ",43,"ب",1,0],["وَعَرَفتَ أَنَّكَ حينَ رُحتَ وَلَم يَكُن","بَعدُ اليَقينُ وَلَيسَ ذاكَ بِمُشكِلِ",44,"ل",1,0],["وَعَرَفتُ رَنَّةَ أُمِّهِ","في الصارِخاتِ النُعَّق",45,"ق",1,0],["وَعَرَّضَ بي قَومي يَقولونَ قَد غَوى","عَدِمتُ عَذولي فيكِ إِن كُنتُ غاوِيا",46,"ي",2,0],["وَعَرَّضَ أَنّا شامِتونَ بِمَوتِهِ","وَإِلّا فَزارَت عارِضَيهِ القَواضِبُ",47,"ب",1,0],["وَعَرَّفَ أَنَّكَ مِن هَمِّهِ","وَأَنَّكَ في نَصرِهِ تَرفُلُ",48,"ل",1,0],["وَعَرِّفاهُم بِأَنّي في مَكارِمِهِ","أُقَلِّبُ الطَرفَ بَينَ الخَيلِ وَالخَوَلِ",49,"ل",1,0],["وعرائسُ الأقداحِ تُجْلَى في الدُّجَى","في جيدهنَّ مخانقُ المرجانِ",50,"ن",1,0],["وعرفت أسرارَ الخليقةِ كلَّها","عِلماً أنارَ ليَ البهيمَ المُظلما",51,"م",2,0],["وعرَّضْتُ حيناً بالعتاب فلم يُفِدْ","وبعضُ معاريضِ الكلامِ خصَامُ",52,"م",1,0],["وَعَرَفتُ نَفسي بَعدَهُ في مَعشَرٍ","ضاقوا عَلَيَّ بِعَقبِ يَومِ قَضائِهِ",53,"ا",3,0],["وَعَرَفتُ وُدَّكَ في تَعَصُّبِ شيعَتي","وَوجوهِ إِخواني وَعَطفِ أَقارِبي",54,"ب",2,0],["وَعَريضُ أَعلى المَتنِ لَو عَلَّيتَهُ","بِالزِئبَقِ المُنهالِ لَم يَتَرَجرَجِ",55,"ج",1,0],["وَعَرَّفَتِ اللَيالي في شُجاعٍ","وَتامِشَ كَيفَ عاقِبَةُ الفَسادِ",56,"د",1,0],["وَعِراكُ الرِجالِ بَينَ يَدَيهِ","في خُفوتٍ مِنهُم وَإِغماضِ جَرسِ",57,"س",1,0],["وَعُروَةُ إِذ لا رِجلُهُ اِنصَرَفَت بِهِ","وَقَد خَرَمَت عَنهُ بَنيهِ خَوارِمُه",58,"م",2,0],["وَعَرَّدَ عَن بَنيهِ الكَسبُ مِنهُم","وَلَو كانوا ذَوي غَلَقٍ شَغابا",59,"ب",2,0],["وعُرِّيَ من بُردَيه بالسيفِ مُنتضىً","فلمْ يَعْرَ مِنْ بُرْدَيْ عَفافٍ ونائلِ",60,"ل",1,0],["وعَرْفُ شَمائلٍ كالمِسكِ يَثنِي","أزمَّتَهم يميناً أو شِمالا",61,"ل",2,0],["وعَريقٍ في الأَزْدِ يُمْسي ويُضحي","باسقَ الفَرْعِ طَيَّبَ الأَعْراقِ",62,"ق",1,0],["وعرَّدَ الرُّومُ لما رامَهم هرباً","وهل من الحَينِ وافى جيشَه هربُ",63,"ب",1,0],["وَعَرَفتُ أَن لَيسَت بِدارِ تَئِيَّةٍ","فَكَصَفقَةٍ بِالكَفِّ كانَ رُقادي",64,"ي",1,0],["وَعُروَةُ لا يَنأى فَقَد كانَ فارِساً","إِذا الحَربُ هاجَت بِالقَنا وَالصَوارِمِ",65,"م",1,0],["وَعَرَفتُ رَأيَكَ بي فَلَو كُشِفَ الغَطا","عَن حالَةٍ ما اِزدادَ فيكَ تَيَقُّني",66,"ي",1,0],["وَعَرَجتَ في ظَهرِ البُراقِ مُجاوِزَ ال","سَبعِ الطِباقِ كَما يَشا الرَحمانُ",67,"ن",1,0],["وعرفتُ ما طعم الهدوءِ أنا الذي","لم أَلقَ ساعةَ راحةٍ وسلامِ",68,"م",1,0],["وعَرَانا طَائِفٌ مِن خَبَلٍ","فاندَفَعنا في الأماني نتبارَى",69,"ر",2,0],["وعرفت الضيق ضيق القلب حتى","لم أجد في الكون ثقباً من رجاء",70,"ا",2,0],["وعروسٍ لك قد أهدَيْتُها","تُكْلَمُ الحُسّادُ منها بالكَلِم",71,"م",1,0],["وعرفٍ دقيقِ الشّعْرِ تحسبُ نبتَهُ","إذا الرّيحُ هَزّتْهُ ذوائب سُنْبُلِ",72,"ل",1,0],["وعَرَفتُ في الأَرواحِ مَسراها كَما","عَرَفَ المريضُ طبيبَهُ في العُوّدِ",73,"د",1,0],["وَعَّرَ الدينَ بِالجِلادِ وَلَكِن","نَ وُعورَ العَدُوِّ صارَت سُهوبا",74,"ب",2,0],["وَعِراصاً تُذري الرِياحُ عَلَيها","ذا بُروقٍ جَوناً أَجَشَّ هَزيما",75,"م",2,0],["وَعَرِّفيهِ بِهِم كَالهَزلِ وَاِحتَفِظي","في غَيرِ مَعتَبَةٍ أَن تُغضِبي الرَجُلا",76,"ل",2,0],["وَعَرَفتُ أَن سَتَكونُ داراً غَربَةً","مِنها إِذا جاوَزتُ أَهلَ حِصابي",77,"ي",1,0],["وَعَرِّج عَلى مَثوى الحَبيبِ بِنَظرَةٍ","تَراهُ بِها عَيني هُناكَ وَتَلمَحُ",78,"ح",1,0],["وَعُروَةُ ماتَ مَوتاً مُستَريحاً","وَهاأَنَذا أَموتُ بِكُلِّ يَومِ",79,"م",1,0],["وعَرَفتُها تشكو إليه غليلَها","وتطوفُ من يدهِ بأطيبِ مشرعِ",80,"ع",1,0],["وَعَرفتَ مِن زُعمائِها مَن لا يَرى","صبرَ الشُعوبِ عَلى الهَوانِ مُحالا",81,"ل",2,0],["وعرفنا بكم صديقاً وفياً","كيف ننسى انتداَبه واحتلاَلهْ",82,"ل",2,0],["وَعَرَفتُ مَنزِلَةً فَقُلتُ لَها","بِالقَصرِ مَرَّ لِعَهدِهِ عَصرُ",83,"ر",1,0],["وَعَرَفوا عِندَ اللِقاءِ صَبرَهُ","وَشَدَّهُ يَومَ الوَغى وَكِّرِّه",84,"ه",1,0],["وَعَرَّفَهُ يُمنَ شَهرِ الصِيامِ","وَأَعطاهُ مِن كُلِّ سوءٍ أَمانا",85,"ن",2,0],["وَعِراصٍ جَرَت عَلَيها سَواري ال","ريحِ حَتّى غودِرنَ كَالأَسطارِ",86,"ر",1,0],["وَعَروسٍ زُفَّت عَلى بَطنِ كَفٍّ","في قَميصٍ مُنَقَّشٍ بِزُجاجِ",87,"ج",1,1],["وَعُرَيْبٌ جَعَلُوا بالمصَلَّى","كلَّ قلبٍ يومَ ساروا نِهايا",88,"ي",2,0],["وعَرينٍ من كلِّ ليْثٍ هَصْورٍ","كالِحِ النّابِ أسْجَرِ الحمِلاق",89,"ق",1,0],["وعرّضَ يَسْتجدي الحِمامَ لنفسِهِ","وبعضُ حِمامِ المُستريح خُلود",90,"د",1,0],["وَعَرَّفَهُم أَعلامَهُم وَأَراهُمُ","مَنارَ الهُدى مَوصولَةً بِمَنارِ",91,"ر",1,0],["وَعَرِفَ الإيحاءَ وَالصَفيرا","وَالكَفَّ أَن تومِئَ أَو تُشيرا",92,"ر",2,0],["وَعَرَفَ الإيحاءَ وَالتَعويصا","بورِكَ كَلباً نَهِماً حَريصا",93,"ص",2,0],["وَعَروسُ يَثرِبَ في المَجاسِدِ وَالحِبا","أَيّامَ فَضلُ جَمالِها مَذكورُ",94,"ر",1,0],["وَعُرّيتُ مِن مالٍ وَخَيرٍ جَمَعتُهُ","كَما عُرِّيَت مِمّا تُمِرُّ المَغازِلُ",95,"ل",1,1],["وَعَرانا عالى الحُطامِّ ضِرابٌ","وَطِعانٌ في باطِلٍ وَرِماءُ",96,"م",3,0],["وَعُريتَ بِالكَأسِ الكُمَيتِ عَنِ التُقى","فَاِعجَب لِجِسمِكَ وَهُوَ كاسٍ عارِ",97,"ر",1,0],["وَعَرّاكَ رازِيَةُ الحُقوقِ فَلَم تَقُم","لِلحَقِّ إِلّا بَعدَ طولِ عِراكِ",98,"ك",1,0],["وَعِرسُهُ في تَعَبٍ دائِمٍ","لا تَخضُبُ الكَفَّ وَلا تَكتَحِل",99,"ل",1,0],["وَعَراني خَطبٌ أَرادَ العَراني","نَ بِذُلٍّ وَكُلُّها في عِرانِ",100,"ن",1,0],["وَعرَّفتُه في شِدَّةِ الجَريِ باِسمِهِ","وَأَشلَيتُهُ حَتّى أَراحَ وَأَبصَرا",101,"ر",2,0],["وَعراص تعاورتها السوافي","وَمشت فوقها تجرّ الذيولا",102,"ل",2,0],["وَعراص همى السحابُ ملحّاً","في ثراها فخددتها السيولُ",103,"ل",1,1],["وعروسٌ من بنات الجنِّ لم تبْدُ لرائي","مثلَها لم يَرَ صَيَّادٌ على صفحةِ ماءِ",104,"ا",2,0],["وعرفتَ بين اليأسِ والأملِ","صحوَ الحياةِ وسكرةَ الموتِ",105,"ت",1,0],["وَعَرَفتَ اليَقينَ وَاِنبَلَجَ الحَق","قُ لِعَينَيكَ ساطِعاً كَالشِهابِ",106,"ب",1,0],["وعَرَفْتَ غايةَ بَدْرِها","لَمّا رأيْتَ هِلالَها",107,"ل",3,0],["وعَرضُ فَلاةٍ يُحرِمُ السيْفُ وَسْطَها","ألا إنّ إحْرامَ الصّوارِمِ إحْلال",108,"ل",1,0],["وَعَرُوسُ الطهْرِ تُدْعَى","كَعَرُوسِ الشِّعْرِ لَيْلى",109,"ل",2,0],["وَعَرَفْتُ فِي نَادِي الْبَيَانِ مَكَانَهُ","وَمَكَانُهُ الأَسْنَى بِغَيْرِ مِرَاءِ",110,"ا",2,0],["وعرفنا الدنيا نعيما وبؤسا","كيف أنسى",111,"ا",1,0],["وعرس ملؤه الكدر",".. فقولي إنه الوتر",112,"ر",1,0],["وَعَرَفْناكَ مُذْ ذَهَبْتَ كما يُعْرَفُ","فَضْلث النُّبُوغِ بعدَ الذَّهَابِ",113,"ب",1,0],["وعَرينٌ حَلَّ فيه ضَيْغَمٌ","رحمةُ اللّه على لَيْثِ العرين",114,"ن",1,0],["وعرفتُ أنّ الحسنَ معنى مدرَكٌ","بالحسِّ، لا لحمًا يكونُ، ولا دما",115,"م",2,0],["وعرشًا كعرش «ابن داودَ»، فيهِ","يقومُ الطيورُ مقامَ الخدم",116,"م",1,0],["وعروقُنَا تَغْلي بهنَّ دماؤنا","فكأَنما في كلِّ عرق مِرْجَل",117,"ل",1,0],["وعرفتها عجوز ، كل حرفتها","صنع الخطايا ، لوجه الله تحترف",118,"ف",1,0],["وَعُرِيْبٌ جَعَلُوا بالمَصَلَّى","كل قلب يوم ساروا نهابا",119,"ب",2,0],["وعَرْجَلَة ٍ شُعْثِ الرّؤوسِ، كأنّهم","بنوا الجن، لم تطبخ، بقدر، جزورها",120,"ر",3,0],["وعَرَفتُ أشجاناً يثيرُكَ بَعْثُها","فأثَرْتُهُنَّ فطِرْنَ كُلَّ مطار",121,"ر",1,0],["وعرفتَ كيف تَرى السياسةَ خطةً","عربيةَ الأوصاف والألقاب",122,"ب",1,0],["وعرفتُ فضلَكَ قبل كونِك عاهلاً","تُرخي عليكَ حِجابَك المسدولا",123,"ل",2,0],["وعرفتَ قدرَ العاملينَ مبجَّلاً","شكراً ، وحظَّ العاملينَ جزيلا",123,"ل",2,0],["وعرَفْتُ وِدّكَ في شَيعَتي تعصب،","وَوُجُوهِ اخْوَاني وَعَطْفِ أقارِبي",124,"ب",2,0],["وَعَرَفْناكَ مُذْ ذَهَبْتَ كما يُعْرَفُ","فَضْلُ النُّبُوغ بعدَ الذَّهَاب",125,"ب",1,0],["وعرفيه به كالهزلِ، واحتفظي","في غيرِ معتبة ٍ أنْ تغضبي الرجلا",126,"ل",2,0]]}