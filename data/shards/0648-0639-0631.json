05.html","الوافر"],[518,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[518,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[541,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[541,"شعراء مغربنا وأنت إمامهم","https://www.aldiwan.net/poem48175.html","عموديه"],[541,"آه إذ تعلو على متن جوا","https://www.aldiwan.net/poem48197.html","عموديه"],[543,"وعرفان إني لا أطيق زيالها","https://www.aldiwan.net/poem56722.html","الطويل"],[554,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[554,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[554,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[554,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[554,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[554,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[554,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[554,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[554,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[561,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"إن للإحسان نورا","https://www.aldiwan.net/poem34550.html","مجزوء الرمل"],[561,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[562,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[564,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[565,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[567,"إن نكن يا حبيب بالرغم غبنا","https://www.aldiwan.net/poem861.html",""],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"حذار سيوف الهند من أعين الترك","https://www.aldiwan.net/poem2903.html","الطويل"],[589,"وافي الربيع فسر إلى السراء","https://www.aldiwan.net/poem17406.html","الكامل"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[866,"","https://poetry.dctabudhabi.ae/diwan/poem/117823","الطويل"],[870,"","https://poetry.dctabudhabi.ae/diwan/poem/31477","الكامل"],[931,"","https://poetry.dctabudhabi.ae/diwan/poem/133886","الطويل"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/18791","الوافر"]],"verses":[["وعرج بها عند الغري وقل أيا","مسجىً به جائت تلوذ الطرائد",0,"د",1,0],["وَعَرَضتُ نُصحي وَالقَبولُ إِجازَةٌ","فَإِذا أَبَيتَ لَوَيتُ عَنكَ عِناني",1,"ن",2,0],["وَعَرَفتُ بَينَ بُيوتِ آلِ مُحَرِّقٍ","مَأوى القِرى وَمَواقِدَ النيرانِ",2,"ن",1,0],["وَعَرَفتُمُ مِنّي مَخيلَةَ سُؤدُدٍ","خَفِيَت وَراءَ مَلابِسِ الإِقتارِ",3,"ر",1,0],["وَعَرَّفتُموني كَيفَ أَلتَمِسُ الجَدا","إِلى غَيرِ أَيدي الأَلأَمينَ الشُرابِثِ",4,"ث",1,0],["وَعَرِّج عَلى الغُرِّ مِن هاشِمٍ","فَأَهدِ السَلامَ لَهُم مِن كَثَب",5,"ب",1,0],["وعِرْضُ مِثلِكَ لا تَغْتالُهُ نُوَبٌ","تَفْتَرُّ عيشَتُهُ فيها عنِ الشّظَفِ",6,"ف",1,0],["وعرَّضْتَ مَنْ عاداكَ للهُلْكِ فانْتَهى","عنِ المُلْكِ حتى قَلَّ فيهِ المُنافِسُ",7,"س",1,0],["وعِرْضٍ كمَتْنِ الهِنْدُوانيِّ ناصِعٌ","تَذُبُّ المَعالي دونَهُ وتُحامي",8,"م",2,0],["وَعَرَفتُ أَنَّ مَنِيَّتي إِن تَأتِني","لا يُنجِني مِنها الفِرارُ الأَسرَعُ",9,"ع",1,0],["وعرّضْتَ للتّقْبيلِ كَفاً كريمةً","تَفيضُ على الطُّلاّبِ منها ينابِعُ",10,"ع",1,0],["وَعَرْضاً كَيَوْمِ الْعَرْضِ أَذهَلَ هَوْلَهُ","عِيَانِي وَأَعْيَانِي تَعَدُّدُ أَعْيَانِي",11,"ن",2,0],["وَعُرّيتَ مِن وَفرٍ وَمالٍ جَمَعتَهُ","كَما عُرِّيَت مِمّا تُسِرُّ المَغازِلُ",12,"ل",1,0],["وَعَرَفتَ اليَقينَ وَاِنبَلَجَ الحَ","قُ لِعَينَيكَ ساطِعاً كَالشِهابِ",13,"ب",1,0],["وَعَرَّفتَ دَهري مَكانَ الأَديبِ","وَقَد كانَ دَهري شَديدَ الكَلَب",14,"ب",1,0],["وَعَرَّدَ إِلّا كُلَّ ذمرٍ مغامِسٍ","وَنَكَّبَ إِلّا كُلَّ زاكٍ نِصابُهُ",15,"ب",2,0],["وَعَرَفتُ مِن ذي الطَوقِ عَمرٍ ثَأرَهُ","لِجَذيمَةَ الوَضّاحِ حينَ يُكادُ",16,"د",1,0],["وَعُروَةُ لَم يَلقَ الَّذي قَد لَقيتُهُ","بِعَفراءَ وَالنَهدِيُّ ما أَتَفَجَّعُ",17,"ع",1,0],["وَعَرَّسَ بِالسَكرانِ يَومَينِ وَارتَكى","يَجُرُّ كَما جَرَّ المَكيثُ المُسافِرُ",18,"ر",1,0],["وعرفت من جمر الأسى","ما ليس يستره رماده",19,"د",2,0],["وَعَرَفْتَ فِي إِكْرَامِهِمْ لَكَ مُنْتَهَى","مَا يَبْلُغُ الإِسْدَاءُ مِنْ عِرْفَانِ",20,"ن",1,0],["وَعَرَا الأَعْيُنَ الْكَلالُ فَأَنَّى","نَظَرَتْ حُمْرَةً رَأَتْ وَقَتَامَا",21,"م",2,0],["وعرقلوا بدعاويهم مساعيه","ومدّدوا من دواهيهم له كففا",22,"ف",2,0],["وَعِرقُ الفَرَزدَقِ شَرُّ العُروقِ","خَبيثُ الثَرى كابِيُ الأَزنُدِ",23,"د",1,0],["وَعَرَفتُ بَينَهُمُ فَهاجَ صَبابَةً","صَوتُ الحَمامِ إِذا الهَديلُ تَغَرَّدا",24,"د",2,0],["وَعَرَفتُ مُنتَصَبَ الخِيامِ عَلى بِلىً","وَعَرَفتُ حَيثُ تُرَبَّطُ الأَمهارُ",25,"ر",1,0],["وَعُروقُ نَبعَتِكُم لَها طيبُ الثَرى","وَالفَرعُ لا جَعدٌ وَلا خَوّارُ",25,"ر",1,0],["وَعَرَفتَ مَنزِلَةَ الذَليلِ فَلَم تَجِد","إِلّا التَلَهُّفَ ثُمَّتِ الإِقرارا",26,"ر",2,0],["وَعَرَّدتُمُ عَن جَعفَرٍ يَومَ مَعبَدٍ","فَأَسلَمَ وَالقَلحاءُ عانٍ أَسيرُها",27,"ر",3,0],["وَعَرجَلَةٍ شُعثِ الرُؤوسِ كَأَنَّهُم","بَنو الجِنِّ لَم تُطبَخ بِقِدرٍ جَزورُها",28,"ر",3,0],["وعرائس الأقلام واطربي بها","سودَ المحابرِ للقلوبِ سوالِبا",29,"ب",2,0],["وعروس جعلت لي","من بياض الوصل صبحه",30,"ح",2,0],["وعرفني بالحبِّ في خدِّ عارض","بدا ألِفاً ثم اسْتدارَ فلاما",31,"م",2,0],["وعَرُوسٍ قد جُهِّزتْ بطلاقٍ","عاتبتْ في وَليدَةٍ شَنْآءِ",32,"ا",2,0],["وعِرضُهُ العرض الذي لا يُلْطَخُ","بالطَّيخِ إذ بعضهم مُطَيَّخُ",33,"خ",1,0],["وعرَّضَ عرضَه عمداً لشعري","ليغسل عِرْضَه بعد اتِّساخِ",34,"خ",1,0],["وعَرّى لَمَرْضَاة الإِله مَنَاصِلاً","غِضَاباً عِضَاباً ليس فيهنَّ مُعضَدُ",35,"د",1,0],["وَعَرَتْهُ هِزَّةٌ تَأبى له","أن يُرى فيه عن المجد خُمُودُ",36,"د",1,0],["وعرضه أملسُ ما خيَّمتْ","آمال راجيه على أمْلَس",37,"س",1,0],["وعرّضتَ الخبيثة لي سفاهاً","فعِفْتُ خبيثها حَولاً دكيكا",38,"ك",2,0],["وَعَرَّت حِمارَيها وَقَد كانَتِ اِستُها","شَديداً بِسيساءِ الحِمارِ أُزومُها",39,"م",3,0],["وَعَرَفتُم وَعَرَفنا مِثلَكُم","أَنَّما الحَقُّ لِذي ظُفرٍ وَنابِ",40,"ب",1,0],["وَعَرَفتُ مِن فِرجَينِ جارَتِها","ما زادَني ضُرّاً عَلى ضُرِّ",41,"ر",1,0],["وَعَرَفتُم كَما عَرَفنا اللَهَ","لَخَرَرتُم أَمامَنا ساجِدينا",42,"ن",2,0],["وَعَرَّضتُم بِأَقوالٍ","وَما نَجهَلُ مَعناها",43,"ا",3,0],["وعرائسُ الغابِ الجميلِ هزيلةٌ","ظمأى لِكُلِّ جَنًى وكُلِّ شَرابِ",44,"ب",1,0],["وَعَرَفتَ أَنَّكَ حينَ رُحتَ وَلَم يَكُن","بَعدُ اليَقينُ وَلَيسَ ذاكَ بِمُشكِلِ",45,"ل",1,0],["وَعَرَفتُ رَنَّةَ أُمِّهِ","في الصارِخاتِ النُعَّق",46,"ق",1,0],["وَعَرَّضَ بي قَومي يَقولونَ قَد غَوى","عَدِمتُ عَذولي فيكِ إِن كُنتُ غاوِيا",47,"ي",2,0],["وَعَرَّضَ أَنّا شامِتونَ بِمَوتِهِ","وَإِلّا فَزارَت عارِضَيهِ القَواضِبُ",48,"ب",1,0],["وَعَرَّفَ أَنَّكَ مِن هَمِّهِ","وَأَنَّكَ في نَصرِهِ تَرفُلُ",49,"ل",1,0],["وَعَرِّفاهُم بِأَنّي في مَكارِمِهِ","أُقَلِّبُ الطَرفَ بَينَ الخَيلِ وَالخَوَلِ",50,"ل",1,0],["وعرائسُ الأقداحِ تُجْلَى في الدُّجَى","في جيدهنَّ مخانقُ المرجانِ",51,"ن",1,0],["وعرفت أسرارَ الخليقةِ كلَّها","عِلماً أنارَ ليَ البهيمَ المُظلما",52,"م",2,0],["وعرَّضْتُ حيناً بالعتاب فلم يُفِدْ","وبعضُ معاريضِ الكلامِ خصَامُ",53,"م",1,0],["وَعَرَفتُ نَفسي بَعدَهُ في مَعشَرٍ","ضاقوا عَلَيَّ بِعَقبِ يَومِ قَضائِهِ",54,"ا",3,0],["وَعَرَفتُ وُدَّكَ في تَعَصُّبِ شيعَتي","وَوجوهِ إِخواني وَعَطفِ أَقارِبي",55,"ب",2,0],["وَعَريضُ أَعلى المَتنِ لَو عَلَّيتَهُ","بِالزِئبَقِ المُنهالِ لَم يَتَرَجرَجِ",56,"ج",1,0],["وَعَرَّفَتِ اللَيالي في شُجاعٍ","وَتامِشَ كَيفَ عاقِبَةُ الفَسادِ",57,"د",1,0],["وَعِراكُ الرِجالِ بَينَ يَدَيهِ","في خُفوتٍ مِنهُم وَإِغماضِ جَرسِ",58,"س",1,0],["وَعُروَةُ إِذ لا رِجلُهُ اِنصَرَفَت بِهِ","وَقَد خَرَمَت عَنهُ بَنيهِ خَوارِمُه",59,"م",2,0],["وَعَرَّدَ عَن بَنيهِ الكَسبُ مِنهُم","وَلَو كانوا ذَوي غَلَقٍ شَغابا",60,"ب",2,0],["وعُرِّيَ من بُردَيه بالسيفِ مُنتضىً","فلمْ يَعْرَ مِنْ بُرْدَيْ عَفافٍ ونائلِ",61,"ل",1,0],["وعَرْفُ شَمائلٍ كالمِسكِ يَثنِي","أزمَّتَهم يميناً أو شِمالا",62,"ل",2,0],["وعَريقٍ في الأَزْدِ يُمْسي ويُضحي","باسقَ الفَرْعِ طَيَّبَ الأَعْراقِ",63,"ق",1,0],["وعرَّدَ الرُّومُ لما رامَهم هرباً","وهل من الحَينِ وافى جيشَه هربُ",64,"ب",1,0],["وَعَرَفتُ أَن لَيسَت بِدارِ تَئِيَّةٍ","فَكَصَفقَةٍ بِالكَفِّ كانَ رُقادي",65,"د",2,0],["وَعُروَةُ لا يَنأى فَقَد كانَ فارِساً","إِذا الحَربُ هاجَت بِالقَنا وَالصَوارِمِ",66,"م",1,0],["وَعَرَفتُ رَأيَكَ بي فَلَو كُشِفَ الغَطا","عَن حالَةٍ ما اِزدادَ فيكَ تَيَقُّني",67,"ن",2,0],["وَعَرَجتَ في ظَهرِ البُراقِ مُجاوِزَ ال","سَبعِ الطِباقِ كَما يَشا الرَحمانُ",68,"ن",1,0],["وعرفتُ ما طعم الهدوءِ أنا الذي","لم أَلقَ ساعةَ راحةٍ وسلامِ",69,"م",1,0],["وعَرَانا طَائِفٌ مِن خَبَلٍ","فاندَفَعنا في الأماني نتبارَى",70,"ر",2,0],["وعرفت الضيق ضيق القلب حتى","لم أجد في الكون ثقباً من رجاء",71,"ا",2,0],["وعروسٍ لك قد أهدَيْتُها","تُكْلَمُ الحُسّادُ منها بالكَلِم",72,"م",1,0],["وعرفٍ دقيقِ الشّعْرِ تحسبُ نبتَهُ","إذا الرّيحُ هَزّتْهُ ذوائب سُنْبُلِ",73,"ل",1,0],["وعَرَفتُ في الأَرواحِ مَسراها كَما","عَرَفَ المريضُ طبيبَهُ في العُوّدِ",74,"د",1,0],["وَعَّرَ الدينَ بِالجِلادِ وَلَكِن","نَ وُعورَ العَدُوِّ صارَت سُهوبا",75,"ب",2,0],["وَعِراصاً تُذري الرِياحُ عَلَيها","ذا بُروقٍ جَوناً أَجَشَّ هَزيما",76,"م",2,0],["وَعَرِّفيهِ بِهِم كَالهَزلِ وَاِحتَفِظي","في غَيرِ مَعتَبَةٍ أَن تُغضِبي الرَجُلا",77,"ل",2,0],["وَعَرَفتُ أَن سَتَكونُ داراً غَربَةً","مِنها إِذا جاوَزتُ أَهلَ حِصابي",78,"ب",2,0],["وَعَرِّج عَلى مَثوى الحَبيبِ بِنَظرَةٍ","تَراهُ بِها عَيني هُناكَ وَتَلمَحُ",79,"ح",1,0],["وَعُروَةُ ماتَ مَوتاً مُستَريحاً","وَهاأَنَذا أَموتُ بِكُلِّ يَومِ",80,"م",1,0],["وعَرَفتُها تشكو إليه غليلَها","وتطوفُ من يدهِ بأطيبِ مشرعِ",81,"ع",1,0],["وَعَرفتَ مِن زُعمائِها مَن لا يَرى","صبرَ الشُعوبِ عَلى الهَوانِ مُحالا",82,"ل",2,0],["وعرفنا بكم صديقاً وفياً","كيف ننسى انتداَبه واحتلاَلهْ",83,"ل",2,0],["وَعَرَفتُ مَنزِلَةً فَقُلتُ لَها","بِالقَصرِ مَرَّ لِعَهدِهِ عَصرُ",84,"ر",1,0],["وَعَرَفوا عِندَ اللِقاءِ صَبرَهُ","وَشَدَّهُ يَومَ الوَغى وَكِّرِّه",85,"ه",1,0],["وَعَرَّفَهُ يُمنَ شَ