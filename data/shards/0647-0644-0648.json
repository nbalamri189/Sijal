{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[63,"هل وقفة بجنوب القاع تجمعنا","https://www.aldiwan.net/poem45777.html","البسيط"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[71,"هل وفت للطلول عيني فأغنت","https://www.aldiwan.net/poem3950.html","الخفيف"],[51,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[80,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[46,"عاقبة الميت محمودة","https://www.aldiwan.net/poem22374.html","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[100,"حيرة الساري","https://www.poetsgate.com/ViewPoem.aspx?id=50134",""],[109,"هل وقفة بين الطلول","https://www.aldiwan.net/poem16305.html","مجزوء الكامل"],[231,"حيتك السنة الحيا من دار","https://www.aldiwan.net/poem44590.html","الكامل"],[252,"عجباً لطيفك حين أسعف موهنا","https://www.aldiwan.net/poem1440.html",""],[403,"أخبرونا تفضلا ما الذي كان","https://www.aldiwan.net/poem33912.html","الخفيف"],[416,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"]],"verses":[["هَل وَقفَةٌ بِلوى خَبتٍ مُؤَلِّفَةٌ","بَينَ الخَليطَينِ مِن شامٍ وَمِن يَمَنِ",0,"ن",1,0],["هَل وَقفَةٌ بِجَنوبِ القاعِ تَجمَعُنا","أَم لا مَقيلَ بِهَذا الصَّفصَفِ السَبِخِ",1,"خ",1,1],["هَل وَقَفتُم بِقِمَّةِ الهَرَمِ الأَك","بَرِ يَوماً فَرَيتُمُ بَعضَ جُهدي",2,"ي",1,0],["هَل وَفَت لِلطلولِ عَيني فَأَغنَت","ساحَتَيها عَن صيفٍ وَرَبيعِ",3,"ع",1,1],["هل وَضَع الفيشةَ تأنيثُها","أو رفع الأحراحَ تذكيرها",4,"ر",3,0],["هل واصلي منكِ إلا طيفُ ميّتَةً","تُهْدي لعينيَ من ذاك السكونِ حَرَك",5,"ك",1,0],["هَل وَأَلَت مُغفِرَةٌ بِالذُرى","أَو أُفعُوانٌ ساكِنٌ بِالشَقاب",6,"ب",1,0],["هَلُوكٌ تُهِينُ المُسْتَهامَ بحُبّها","وتَلْقى الرّجالَ المُبْغِضينَ بإجلال",7,"ل",1,0],["هَل وَقى مَن في بُروجٍ شُيِّدَت","أَو منيفٍ مُشمَخِرٍّ أَو نَفَق",8,"ق",1,0],["هل وراء العمر عمر شائق ؟","هل وراء اليأس ظلّ من نجاح ؟",9,"ح",1,0],["هَل وَقفَةٌ بَينَ الطُلول","تَشفي الفُؤاد مِن الغَليلِ",10,"ل",1,1],["هل وقفة للركب في عرصاتها","وله جوار في أعز جوار",11,"ر",1,0],["هَل وَقفة أَشكو فتبرد لي حشاً","أَلهَبتَها وَجَعلتَها لَكَ مَسكَنا",12,"ن",2,0],["هل وَلِيتُمْ أمر العباد بعدل","وأزلتم ما قد تجاروا وجاروا",13,"ر",3,0],["هلْ وَفَتْ مديونها مستغرماً","يشتكي منها وإنْ أَوْفَتْ مطالا",14,"ل",2,0],["هل وجدتم إلى البنوك سبيلا","قاله الشرع أو اليه يشير",15,"ر",1,0]]}