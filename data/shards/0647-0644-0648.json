{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[65,"هل وقفة بجنوب القاع تجمعنا","https://www.aldiwan.net/poem45777.html","البسيط"],[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[73,"هل وفت للطلول عيني فأغنت","https://www.aldiwan.net/poem3950.html","الخفيف"],[53,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[82,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[48,"عاقبة الميت محمودة","https://www.aldiwan.net/poem22374.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[102,"حيرة الساري","https://www.poetsgate.com/ViewPoem.aspx?id=50134",""],[113,"هل وقفة بين الطلول","https://www.aldiwan.net/poem16305.html","مجزوء الكامل"],[236,"حيتك السنة الحيا من دار","https://www.aldiwan.net/poem44590.html","الكامل"],[257,"عجباً لطيفك حين أسعف موهنا","https://www.aldiwan.net/poem1440.html",""],[409,"أخبرونا تفضلا ما الذي كان","https://www.aldiwan.net/poem33912.html","الخفيف"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[484,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104402","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88666","البسيط"],[2974,"","https://poetry.dctabudhabi.ae/diwan/poem/198750","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79704","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36725","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81932","السريع"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147279","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72735","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72812","الخفيف"],[4764,"عطر الحلا","https://www.poetsgate.com/ViewPoem.aspx?id=35806",""],[4767,"ههنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=197295",""],[4767,"أسير الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=211260",""],[4829,"الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=34267",""],[4984,"جسر الهوى خشب","https://www.poetsgate.com/ViewPoem.aspx?id=175564",""],[4119,"لله عزمك أي سيف وغى","https://www.poetsgate.com/ViewPoem.aspx?id=16156",""],[5119,"لست تدري","https://www.poetsgate.com/ViewPoem.aspx?id=196605",""],[5351,"هل تراهم إليك بالقهر جاؤوا؟","https://www.poetsgate.com/ViewPoem.aspx?id=202634",""],[5431,"يسكن العشق في رباه يذوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=196553",""],[5431,"للسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=202266",""],[5573,"مدية بارضها حقيقها","https://www.poetsgate.com/ViewPoem.aspx?id=200325",""],[5628,"وداعاً أيتها البسمة","https://www.poetsgate.com/ViewPoem.aspx?id=178491",""],[5785,"لا رعى الله من بالجفا والهجر شار","https://www.poetsgate.com/ViewPoem.aspx?id=131574",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""]],"verses":[["هَل وَقفَةٌ بِلوى خَبتٍ مُؤَلِّفَةٌ","بَينَ الخَليطَينِ مِن شامٍ وَمِن يَمَنِ",0,"ن",1,0],["هَل وَقفَةٌ بِجَنوبِ القاعِ تَجمَعُنا","أَم لا مَقيلَ بِهَذا الصَّفصَفِ السَبِخِ",1,"خ",1,1],["هَل وَقَفتُم بِقِمَّةِ الهَرَمِ الأَك","بَرِ يَوماً فَرَيتُمُ بَعضَ جُهدي",2,"د",2,0],["هَل وَفَت لِلطلولِ عَيني فَأَغنَت","ساحَتَيها عَن صيفٍ وَرَبيعِ",3,"ع",1,1],["هل وَضَع الفيشةَ تأنيثُها","أو رفع الأحراحَ تذكيرها",4,"ر",3,0],["هل واصلي منكِ إلا طيفُ ميّتَةً","تُهْدي لعينيَ من ذاك السكونِ حَرَك",5,"ك",1,0],["هَل وَأَلَت مُغفِرَةٌ بِالذُرى","أَو أُفعُوانٌ ساكِنٌ بِالشَقاب",6,"ب",1,0],["هَلُوكٌ تُهِينُ المُسْتَهامَ بحُبّها","وتَلْقى الرّجالَ المُبْغِضينَ بإجلال",7,"ل",1,0],["هَل وَقى مَن في بُروجٍ شُيِّدَت","أَو منيفٍ مُشمَخِرٍّ أَو نَفَق",8,"ق",1,0],["هل وراء العمر عمر شائق ؟","هل وراء اليأس ظلّ من نجاح ؟",9,"ح",1,0],["هَل وَقفَةٌ بَينَ الطُلول","تَشفي الفُؤاد مِن الغَليلِ",10,"ل",1,1],["هل وقفة للركب في عرصاتها","وله جوار في أعز جوار",11,"ر",1,0],["هَل وَقفة أَشكو فتبرد لي حشاً","أَلهَبتَها وَجَعلتَها لَكَ مَسكَنا",12,"ن",2,0],["هل وَلِيتُمْ أمر العباد بعدل","وأزلتم ما قد تجاروا وجاروا",13,"ر",3,0],["هلْ وَفَتْ مديونها مستغرماً","يشتكي منها وإنْ أَوْفَتْ مطالا",14,"ل",2,0],["هل وجدتم إلى البنوك سبيلا","قاله الشرع أو اليه يشير",15,"ر",1,0],["هل وردت في ذاك من سنة","أو آية من محكمات الكتاب",16,"ب",1,0],["هل وصلنَ الغيدُ قبلي مغرما","وسوى الشيبِ له لم يشفعِ",17,"ع",1,0],["هل وجدت النبي يمضي عن الله","أُموراً عليه ما أمضاها",18,"ا",3,0],["هَلْ وجدتم قدماً خليفة حقٍّ","لأعادي نبيّه آواها",18,"ا",3,0],["هل وجدتم حرباً تناويه إلاّ","مذ رأتهُ بكل فضل شئاها",18,"ا",3,0],["هل وجدت القضاء يصرع نفساً","ثم لما قضت غدا ينعاها",18,"ا",3,0],["هل ورث العلم والمَعروفا","عن جده العالم الرباني",19,"ي",1,0],["هل وسدوا جثمانه تحت الثرى","وغدا التراب عن الوصال يحولُ",20,"ل",1,0],["هل وراء الآفاق راحة نفس","أبتغيها أو منفذ من عناء",21,"ا",2,0],["هل وازن ضربته عمراً","عمل الثقلين إلى المحشر",22,"ر",1,0],["هل وَثِقتم من العَذابِ لهذا انتمُ","في لَظىً شديدِ الوَثاقِ",23,"ق",1,0],["هَل وَقفَةٌ بِعراصِهِ أَشفي بِها","مِن حُبِّ ساكِنهِ غَليلَ أوامي",24,"م",2,0],["هل وجه رب العرش باقٍ","إذا أدرك هذا الكون ريب المنون",25,"ن",1,0],["هل ورثنا كل أخطاء المرايا","وانعكاسات الأماني والحكايا",26,"ا",3,1],["هل وطاها من سامت الطود في العل","مِ رسوخا فقلت طه وطاها",27,"ه",2,0],["هل وطاها طودٌ له القدمُ الرا","سخ في العلمِ قلتُ طاها وطاها",28,"ه",2,0],["هل وهمى هادر على الروح مدرار","اروى مسام الروح واروى مداها",29,"ا",3,0],["هل وجدتم بمثله ما وجدنا؟","قد وجدنا بحبه ما نشاء",30,"ا",2,0],["هل وصفُكِ الأحوالَ يعكس ما الذي","يجري عليكِ ولا أراهُ يُفَسَّر",31,"ر",1,0],["هلوا علي القبر ان ماشفتها","هلوا علي الموت قارب من لدن",32,"ن",1,0],["هل ودعت شرفات القصر مبسمها","أم يكتم النجم ما في الظن يذهلُه",33,"ل",2,0],["هل وجه نور الدين غير سنا","صدع الدجى عن خجلة البدر",34,"ر",1,0],["هلْ وَجَدْنَا الدَّرْبَ..؟ نَدْرِي","أَنَّنَا فِيهِ السَّوَاءْ",35,"ا",2,0],["هل وعيت انتماءهم كيف يبدو؟","للسكاكين والخراب أباحك",36,"ك",1,0],["هل وصالي مع العناق قريب","أم لقاءٌ عند الممات يطيب؟",37,"ب",1,1],["هل وجهك الصوفي ضوء شرارة","لفحت جذوعيَ من علايَ إلى الثرى؟",38,"ر",2,0],["هلوكها هلاكه مسيقها","مطيعها طوية طريقها",39,"ق",3,0],["هلْ وفينا حقّهُ حين مضى","آه ما أنْدره هذا الوفاءْ",40,"ا",2,0],["هل وجب وصل حيران مسلوب الوقار","أم من الحبّ يذهب تِمسِماس",41,"س",1,0],["هل وارث \"الفاروق\" وهمٌ خالصٌ","أم جَهلُكُمْ بالعلمِ بابٌ موصَدُ",42,"د",1,0],["هَلوَساتِي خَطِيرَةٌ, وَانتِفاضا","تُ دَمِي لا يُطِيقُها إِنسانُ",43,"ن",1,0]]}