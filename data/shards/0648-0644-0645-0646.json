هُ فَقَد رَأى الحَقَّ الَّذي","لا شَكَّ فيهِ عِندَ ذي الإيقانِ",122,"ن",1,0],["وَلِمَنْ يَزُورُ ضَرِيحَكُمْ","وَلْهَانَ فِي زَيِّ الْوَلِيدْ",123,"د",1,0],["وَلِمَنْ بِمَدْحِ جَلاَلِكُمْ","أَغْرَاهُ ذُو الرَّأْيِ السَّدِيدْ",123,"د",1,0],["وَلَم نَهلِك لِمُرَّةَ إِذ تَوَلَّوا","فَساروا سَيرَ هارِبَةٍ فَغاروا",124,"ر",3,0],["ولمن في الدين قد اجتهدا","وعلى عثمان شهيد الدا",125,"د",2,0],["ولم نر علماً لم تكن منه وافقاً","على اصله والفرع والنوع والجنس",126,"س",1,0],["ولم نكُ يوماً آسفينَ لأنّنا","نُقاسمهُ ما هانَ عند التفجُّع",127,"ع",1,0],["وَلمن يَليني صحبة وَرحامة","بالخير يا خير العباد فبشر",128,"ر",1,0],["ولَمْ نَبِتْ وَذُبَالاتُ الشموعِ كَمَا","تَوَقَّدَت شَفَرَاتٌ في فَتىً كَدِنِ",129,"ن",1,0],["وَلَمْ نَعْهَدْكَ فِي سَرّاءِ حالٍ","وَلا ضَرّائِها إِلاّ شَكُورا",130,"ر",2,0],["وَلَم نَرَ تُركِياً سِواكَ مُبارِزاً","يُجَدِّلُ أَبطالاً بِغَيرِ سِلاحِ",131,"ح",1,0],["وَلَم نَرَ قَبلَهُ أَسَداً وَشَمساً","يَفيءُ عَلَيهِما الشعرُ الأَثيثُ",132,"ث",1,0],["ولم نعلم بأن في الزوايا","خبايا أيدت حزب الحسيب",133,"ب",1,0],["ولم نتهز من فائت العمر فرصة","ولم يغتنم خالي فراغ وصحة",134,"ه",1,0],["وَلَم نَعلَم بِأَن لا لَبثَ فيها","وَلا تَعريجَ غَيرَ الإِجتِيازِ",135,"ز",1,0],["ولمن أغنّي والفضاءُ الطلق","يسخر من قيودي",136,"ي",1,0],["ولمن أغنى إن لقيتك صامتا","ومراكب الألحان ملء سمائي",137,"ا",2,0],["ولم نَعْجَبْ لِفَيْضِ النِّيلِ إنِي","وإبراهيمَ عَلَّمَهُ الوَفاءَ",138,"ا",2,0],["ولم نَخُصَّ له يوماً بتَهْنئةٍ","أَيّامُه كلُّها مِمّا نُهنّاه",139,"ا",2,0],["ولم نَر لَيْثاً قبلَ رُؤْيتنا له","هِزَبْراً له في الكفِّ للقِرْنِ نابان",140,"ن",1,0],["ولم نَمدَحْهمُ عَبَثاً بقَوْلٍ","عَلَكْناه كما عُلِكَ الشَّكيم",141,"م",1,0],["ولِمَنْ أتَى حُسنَ الفِعا","لِ من الورى حُسْنُ المَقال",142,"ل",1,0],["ولم نَسمَعْ بأكرمَ منه طَبْعاً","وأبعدَ عن فعالِ المُستَطيل",143,"ل",1,0],["ولم نَقَضِ من حقِّ المطايا وقد سَمَتْ","لِلُقياهُ إلا دون ما هو واجب",144,"ب",1,0],["ولم نكُ نجهل ريبَ الزمان","وأنَّ المقيمَ به راحل",145,"ل",1,0],["وَلَم نُفرق التَفريق إِذ نَحنُ جيرة","فَقَد غالَنا دَهر تَجور نَوائبهُ",146,"ب",2,0],["وَلِمَن مَنزل تَعفت نَواحيهِ","وَأَقوى إِذ بانَ عَنهُ القَطين",147,"ن",1,0],["ولم نطل المقالة بالشكاوي","وإكثار التوجع والأنينا",148,"ن",2,0],["ولمَنْ تشبَّهَ بالغُرابِ ، فما مشى","مَشْيَ الغُرابِ ، ولامشَى كحمامِ",149,"م",1,0],["ولمن تقدِّمُ شِيحِها وخُزَامه","وتزفُّ من كلماتها الأزهارا ؟",150,"ر",2,0],["ولمن تطرِّزُ ثوبها وإلى متى","تبقى تُسامر ليلها ونهارا ؟",150,"ر",2,0],["ولَمَنْ رآكَ ولم يَمتْ من حِينِهِ","بسيوفِ خوفك إنّه لِمُعَمَّرُ",151,"ر",1,0],["ولمن إليهِ حديثُ كلِّ فضيلةٍ","من بَعْدِ خيرِ المرسلين يُساقُ",152,"ق",1,0],["ولمِْ نَسِينا حُقوقاً جَمَّمةً سلفَتْ","لزَلَّةٍ إنْ جَرتْ هَذا منَ الغَبَنِ",153,"ن",1,0],["ولِمَنْ أَلومُ وإِنَّما","عَيني عليَّ الجَانِيَه",154,"ي",2,0],["ولمنْ أراد من الأَكارم بغية","ألفى أبا سلمان فوقَ مراده",155,"د",2,0],["ولمن أشكو على برح الهوى","كبداً حرَّى وقلباً مستهاما",156,"م",2,0],["ولم نظفر بمثل علاه يوماً","بمطّلع بصير بالأُمور",157,"ر",1,0],["ولم ندرك سلافا تزدهينا","أم الأشراق من وجه المديرِ",158,"ر",1,0],["ولمن أسيرُ الى سواكُم في الهوى","والقلبُ في عرَصاتِكُم خلّفتُه",159,"ت",2,0],["ولمن تُلَبِّيهِ السماءُ وأَرضُها","مدداً إِلَيْكَ لَهُ مَلِيكاً أَوْ مَلَكْ",160,"ك",1,0],["ولمن يرى خَفْضَ النعيمِ مُحَرَّماً","يوماً تُرِيهِ لواءَكَ المنشورا",161,"ر",2,0],["ولمن مُناهُ أَنء تعيشَ مؤيِّداً","ومؤَيَّداً ومؤمِّناً ومؤمَّنا",162,"ن",2,0],["ولِمَنْ نمى سبأٌ بِسَبْيِ مُلُوكِها","واسْتَخْلَفَتْ أَذْوَاؤُهُ وقُيُولُهُ",163,"ل",2,0],["ولِمَنْ تَتَوَّجَ بِالمَكَارِمِ تاجُهُ","عُلْواً وكُلِّلَ بالهُدى إِكْلِيلُهُ",163,"ل",2,0],["ولم نحسن لموقعها هزيزا","فكل مقدر ما إِن يفوت",164,"ت",1,0],["ولم ندر ما هم فيه أو ما مآلهم","إِليه وما لاقوه من قسمة الجد",165,"د",1,0],["ولم ندر أن الردى قانص","بأشراكه في المكان الخفي",166,"ي",1,0],["ولم نعتبر بالذي قد سقته","المنايا بكاس دهاق روي",166,"ي",1,0],["ولمن ازمته بكف عداه يظ","لم ىيسا من ناصر ومجيب",167,"ب",1,0],["ولمن تباع حقوقه ودماؤه","بيع الخسائس عقب عام جدوب",167,"ب",1,0],["ولمن تعطّرت الطيوف وهوّمت","وتجاوبت بنفوسنا أنغاما",168,"م",2,0],["ولمن تبرّجت الطبيعة بعدما","أعطتك عهد سماحة وأمان",169,"ن",1,0],["ولم نبذل لمصر الخير إلا","وأجمعكم بنقمته يثور",170,"ر",1,0],["وَلَم نَشعُر بِجِدِّ البَينِ حَتّى","أَجَدَّ البَينَ سَيّارٌ عَنودُ",171,"د",1,0],["ولم نَعرِفْ غلاماً مَزْيَدِيّاً","يناديه السماحُ فلا يُجيبُ",172,"ب",1,0],["ولم نر ليثاً قبله جمُعت لهُ","شجاعته والجود والعلم والفهمُ",173,"م",1,0],["ولم نر لوماً في الحجابِ حقيقة","وهل لائمٌ في النعيمِ للقمرِ التمّ",174,"م",1,0],["وَلِمَن بَنادِقُ أهلِنا وَنِصا لُهُم","بَعضٌ على أعناق ِبَعض ٍتُشهَرُ؟",175,"ر",1,0],["وَلَم نَزَلْ ما استَوى طِفْلٌ على قَدَم ٍ","إلاّ لِيَدرِجَ في أعقابِ تا لينا !",176,"ن",2,0],["وَلَم نَزَلْ نَتَمَلا َّها مُرَوَّعَة ً","وَلَم تَزَلْ تَتَمَلا َّها مُريعينا",176,"ن",2,0],["وَلَم نَخشَ مِنهُ لِأَنَّ الفَتى","جَبانُ الجَنانِ شُجاعُ اللِسانِ",177,"ن",1,0],["ولم نر يوماً في جميع دروبهم","وأنحائها غير الهدى للشريعة",178,"ه",1,0],["ولم نزلْ في حِجابٍ من جَلالَتِكُمْ","ما بينَ مضْطَرِمٍ منَّا ومنسَجِمِ",179,"م",1,0],["ولم نَدْرِ كيفَ الحتفُ يعرِضُ للفتى","وما وجهُه إلّا الوجوهُ النّواضِرُ",180,"ر",1,0],["ولم نَدرِ لمَّا تَلثِمُ الكأسُ ثَغرَهُ","حُبَابٌ طَفا لاح مِن ثَغرِه دُرُّ",181,"ر",1,0],["ولم نزلْ كلَّما ضاق المكانُ بنا","نأوي هناك إلى أُنثَى تُوَسِّعُهُ",182,"ع",2,0],["ولِمن يَوَدُّك وُدُّهُ وصَفاءُهُ","ولمن يَريبك رَيْبُهُ وقِلاهُ",183,"ا",2,0],["وَلَم نَزلْ نحملُ من أثقالكمْ","ما عجزتْ عنه ضَليعاتُ البُدُنْ",184,"ن",1,0],["ولِمنْ ألومُ وإنّما بصري","هذي جنايتُهُ على بَدَني",185,"ي",1,0],["ولم نَرَ من خلال السِّجْفِ إلّا","عيوناً في الوصاوِصِ أوْ جبينا",186,"ن",2,0],["ولمن هَويتَ نجاحةٌ وفلاحةٌ","ولمنْ شَنِئتَ الكَبْتُ والإرغامُ",187,"م",1,0],["ولِمنْ تراهُ ساكناً في قصره","مُتنعّماً هذِي الحفائرُ تُحفرُ",188,"ر",1,0],["ولمن شئته أكلمه","حاش لله أن أكون أنا",189,"ن",2,0],["ولم ندر منها سوى أمرها","ونحن على وجهها برقع",190,"ع",1,0],["ولم نزل في عدم","نقرّ في أمِّ القرى",191,"ر",2,0],["ولم ندرك سوانا في","تجليه بنا قهرا",192,"ر",2,0],["ولم نقل مثل ما قد قال شاعرهم","وإنما هي إقبال وإدبار",193,"ر",1,0],["ولم نُلف كُنْه الكَوْن إِلا تَوهُّماً","وليْس بشيءٍ ثابِت هكذا الفيْنا",194,"ن",2,0],["ولم نَجدْ كبَنِي رَسلانَ مِن فئةٍ","تَرعى وِدادَ صديقٍ ليسَ تَنساهُ",195,"ا",2,0],["ولِمَنْ أقامَ على المودَّةِ حافظاً","حقّاً لِمنْ نكثَ العُهودَ وضيَّعا",196,"ع",2,0],["ولم نجِدْ قبلَهُ من أُمَّةٍ رَجُلاً","بَكَتْ عليهِ شُعوبُ الناسِ والأُمَمُ",197,"م",1,0],["ولم نزل قدما على الأيام","ننقل في الأصلاب والأرحام",198,"م",1,0],["وَلِمنْ حَارب الزَّمانَ حُسامٌ","وَلِمنْ حَاوَلَ الإخَاءَ خَليلُ",199,"ل",1,0],["وَلمنْ يُحارِبُ في الأَنَامِ بِأَسْرِهِمْ","عُتَقاءُ رَأْفَتِهِ وَبَعْضُ عِيالِهِ",200,"ل",2,0],["ولم نهجركمو أبداً ولكن","كتبنا في الطروس لكم سلاما",201,"م",2,0]]}