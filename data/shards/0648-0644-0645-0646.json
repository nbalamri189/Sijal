 تُحفرُ",178,"ر",1,0],["ولمن شئته أكلمه","حاش لله أن أكون أنا",179,"ن",2,0],["ولم ندر منها سوى أمرها","ونحن على وجهها برقع",180,"ع",1,0],["ولم نزل في عدم","نقرّ في أمِّ القرى",181,"ر",2,0],["ولم ندرك سوانا في","تجليه بنا قهرا",182,"ر",2,0],["ولم نقل مثل ما قد قال شاعرهم","وإنما هي إقبال وإدبار",183,"ر",1,0],["ولم نُلف كُنْه الكَوْن إِلا تَوهُّماً","وليْس بشيءٍ ثابِت هكذا الفيْنا",184,"ن",2,0],["ولم نَجدْ كبَنِي رَسلانَ مِن فئةٍ","تَرعى وِدادَ صديقٍ ليسَ تَنساهُ",185,"ا",2,0],["ولِمَنْ أقامَ على المودَّةِ حافظاً","حقّاً لِمنْ نكثَ العُهودَ وضيَّعا",186,"ع",2,0],["ولم نجِدْ قبلَهُ من أُمَّةٍ رَجُلاً","بَكَتْ عليهِ شُعوبُ الناسِ والأُمَمُ",187,"م",1,0],["ولم نزل قدما على الأيام","ننقل في الأصلاب والأرحام",188,"م",1,0],["وَلِمنْ حَارب الزَّمانَ حُسامٌ","وَلِمنْ حَاوَلَ الإخَاءَ خَليلُ",189,"ل",1,0],["وَلمنْ يُحارِبُ في الأَنَامِ بِأَسْرِهِمْ","عُتَقاءُ رَأْفَتِهِ وَبَعْضُ عِيالِهِ",190,"ل",2,0],["ولم نهجركمو أبداً ولكن","كتبنا في الطروس لكم سلاما",191,"م",2,0]]}