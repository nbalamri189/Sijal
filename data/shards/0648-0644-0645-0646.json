oem56278.html","الوافر"],[461,"غدا الدين من فرط المسرة باسما","https://www.aldiwan.net/poem15411.html","الطويل"],[464,"ولما حجبنا عنك سراً وجهرة","https://www.aldiwan.net/poem3390.html","عموديه"],[465,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[468,"إذا جاز تهديد عيسى بنا","https://www.aldiwan.net/poem59585.html","المتقارب"],[500,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[500,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[538,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[544,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[551,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[551,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[551,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[558,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[558,"جميع البرايا هي اليلمع","https://www.aldiwan.net/poem34380.html","المتقارب"],[558,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[558,"بنا المولى هو الأحرى","https://www.aldiwan.net/poem34525.html","الهزج"],[558,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[559,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[562,"لكل قلب حبيب ظل يهواه","https://www.aldiwan.net/poem52742.html","البسيط"],[562,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"],[562,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"],[586,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[587,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["وَلَم نَرَ كَالعُيونِ ظُبى سُيوفٍ","أَرَقنَ دَماً وَما رُمنَ الجُفونا",0,"ن",2,0],["وَلَم نَطرَحِ الأَسلابَ يَوماً لِنَكبَةٍ","وَإِن جَذَبَ المِقدارُ مِنّا المَجاذِبا",1,"ب",2,0],["وَلَم نَرَ مِثلَ مُبيَضَّ النَواحي","تُعَذِّبُهُ بِمُسوَدِّ الإِهابِ",2,"ب",1,0],["وَلَم نَرضَ بِالبَأسِ دونَ السَماحِ","وَلا بِالمَحامِدِ دونَ الجَدا",3,"ا",1,0],["ولَمْ نَغْتَرِبْ مُسْتَشْرِفينَ لثَرْوَةٍ","فَمَرْعى مَطايانا بِيَبْرينَ مُبْقِلُ",4,"ل",1,0],["ولَم نتَكلَّفْ نَظْمَهُنَّ لأنّنا","وجَدْنا المعالي فاخْتَرعْنا المَعانِيا",5,"ي",2,0],["وَلَم نَقتُلكُمُ سِرّاً وَلَكِن","عَلانِيَةً وَقَد سَطَعَ الغُبارُ",6,"ر",1,0],["وَلَم نَجلِس جَميعاً في خَلاءٍ","نُسَرُّ بِما أَقولُ وَما تَقولُ",7,"ل",1,0],["وَلِمَن عَصَاكَ وَظَنَّ أَنْ سَتُجِيرُهُ","أَنْصَارُ جَارٍ أَوْ سَحِيقُ مَكَانِ",8,"ن",1,0],["وَلَم نَزِد أَن ظَفِرنا مِلءَ أَعيُنِنا","بِالمُشتَري فَتَجَنَّبنا لَهُ زُحَلا",9,"ل",2,0],["وَلَم نَرَ سَيفاً باتِكَ الحَدِّ قَبلَهُ","تَناوَلَ سَيفاً دونَهُ فَتَقَلَّدا",10,"د",2,0],["وَلِمَنْ سِوَاكَ إِذَا تَضَرَّمَتِ القُرَى","أَشْفَى نَدىً فِي إِثْرِ كُل ضِرَامِ",11,"م",1,0],["ولم نرَ قصراً منه أعلى مظاهراً","وأرفع آفاقاً وأفسح ناديا",12,"ي",2,0],["ولم نُبدِ عُنفاً حين جئت وإنما","هتفنا جميعاً بالوفاق وبالرفق",13,"ق",1,0],["ولم نكُ ندري لاهتضام حقوقنا","أنحن من الأحرار أم نحن في رِق",13,"ق",1,0],["ولم نستفد إلا سقوط وِزارة","وتأليف أخرى مثل تلك بلا فرق",13,"ق",1,0],["ولم نكْسُها إلا من العُرف حُلّة","وهل يكتسي الديباج من يكتسى العرفا",14,"ف",2,0],["ولم نترك الحُسنى أوان جدالكم","وتلك لعمري شِيمة المتحلِّم",15,"م",1,0],["ولم نفتأ كذلك كل يوم","لشأفةِ واغرٍ مستأصلينا",16,"ن",2,0],["وَلَم نَفتَأَ غَدَاة هَب وهَال","لِخَيرَاتِ الكَوَاعب مُجتَلِينَا",17,"ن",2,0],["ولم نُمكِن قَتَادَتَنَا لِلمسٍ","وَلاَ سَلَمَاتِنَا لِلعَاصِبِينَا",17,"ن",2,0],["وَلَم نُملَك بغَيرِ بَنى نِزَارٍ","وَلَم نُعطِ الإِتَاوَةَ مُجتَبِينَا",17,"ن",2,0],["وَلَم نفتَأ كَذَلِكَ كُلَّ يَوم","لِشَأفَةِ وضاغِر مُستَأصِلينَا",17,"ن",2,0],["وَلَم نُقدُد لَهُم أُدُماً صِحَاحاً","وَلَم نَهتِك حِجَابَهُمُ الكَنِينَا",17,"ن",2,0],["ولم نزل نرجوه كالمُرْتجِي","طاعة عَاتٍ قبل تَدْويخه",18,"خ",2,0],["ولمْ نُسْقَ إلا بالوزير ويُمْنِهِ","فَبُورك في أيامه وعهودِها",19,"د",3,0],["ولمنْ عاش غايةٌ فليُبادِرْ","سَيرَ إعدامِه إلى إيجادِهْ",20,"د",2,0],["ولم ننلْ من جناه نَهْمَتَنا","وإن حظينا بمونِق الزهرِ",21,"ر",1,0],["ولم نزل من ثدِيِّ نعمته","إذا فقدنا الرضاع نرتضع",22,"ع",1,0],["ولم نر قط أغدر من زمان","ولا بنذوره في الغدر أوفى",23,"ف",2,0],["ولمن عفا عمن هفا متمادياً","يوما كعفوك كيف يُدعى صارما",24,"م",2,0],["ولمن سَقَى مُهجَ النفوسِ سيوفَهُ","عللاً كسقيك كيفَ يُدعَى راحما",24,"م",2,0],["ولمن حمى الدنيا حمايتكَ التي","شَهرتْك كيف يُعدُّ غيثاً ساجما",24,"م",2,0],["ولم نر مثل العلم زاداً مُقدَّماً","له محملٌ خِفٌّ وإن كان عاصما",25,"م",2,0],["ولم نَبع قطُّ دُنيانا بآخرةٍ","ومثلنا لا يبيع النقدَ بالدين",26,"ن",1,0],["ولمن تَيَّمتْهُ وسواسُ هَمٍّ","سائرَ الليلِ تحتَ صدرٍ شجيِّ",27,"ي",1,0],["وَلِمَن يَعجَبُ مِن بُغضي لَهُ","أَيُّها الجاهِلُ أَمري اِتّئِبِ",28,"ب",1,0],["وَلَم نَشتَمِل بِاللَيل وَالحَيُّ نائِمٌ","وَلَم نَستَتِر بِالرَوض وَاللَيلُ مُمتَدُّ",29,"د",1,0],["وَلِمَن حاوَلَ أَن يُغضِبَهُ","إِنَّهُ أَعَلى وَأَسمى خُلُقا",30,"ق",2,0],["وَلِمَن يُشاهِدُ فيهِ رَمزَ كَيانِهِ","وَلِمَن يُجيدُ لِغَيرِهِ تَصويرَهُ",31,"ه",1,0],["وَلِمَن يَقولونَ الفِرَنجَ حُماتُهُ","اللَهُ قَبلَ سُيوفِهِم حاميهِ",32,"ي",2,0],["ولمن هذه البنادق والاعلام","منكوسة وهذا المويل",33,"ل",1,0],["ولمن في حياته خالط النا","س كثيراً احبة واعاد",34,"د",1,0],["ولمن تقدم باسم","ولمن تأخر قمطرير",35,"ر",1,0],["ولم ننتفع بالعلم الا صبابة","تجرعها مثر بمشهد مترب",36,"ب",1,0],["ولم نك إذ منعت الوصل ندرى","ابخلاً كان ذلك أم دلالا",37,"ل",2,0],["ولمن صام الشهر من رمضان","فهو غرثان في النهار وصادي",38,"د",2,0],["ولمن جاء يبتغي حج بيت اللَه","والأجر من بعيد البلاد",38,"د",1,0],["ولمن أعطى ماله يتزكى","ولمن جاء طائعاً للجهاد",38,"د",1,0],["ولم ندر على البحر","جديدا عنك مأثورا",39,"ر",2,0],["وَلَم نَدَع لِلَيالي صافِياً فَدَعَت","بِأَن نَغَصَّ فَقالَ الدَهرُ آمينا",40,"ن",2,0],["وَلِمَن هَياكِلُ قَد عَلا الباني بِها","بَينَ الثُرَيّا وَالثَرى تَتَنَسَّقُ",41,"ق",1,0],["وَلِمَن يُغالِطُ في الحَقائِقِ نَفسَهُ","وَيَسومُها طَلَبَ المُحالِ فَتَطمَعُ",42,"ع",1,0],["وَلَم نَرَ شَيئاً يَحمِلُ العِبءَ حَملَهُ","وَيَستَصغِرُ الدُنيا وَيَحمِلُهُ طِرفُ",43,"ف",1,0],["وَلَم نَرَ مَلكاً قَطُّ يُدعى بِدونِهِ","فَيَرضى وَلَكِن يَجهَلونَ وَتَحلُمُ",44,"م",1,0],["وَلِمَن أَقَمتَ عَلى الهَوانِ بِبابِهِ","تَدنو فَيُوجأُ أَخدَعاكَ وَتُنهَمُ",45,"م",1,0],["وَلِمَن يُهينُ المالَ وَهوَ مُكَرَّمٌ","وَلِمَن يَجُرُّ الجَيشَ وَهوَ عَرَمرَمُ",45,"م",1,0],["وَلِمَن إِذا اِلتَقَتِ الكُماةُ بِمازِقٍ","فَنَصيبُهُ مِنها الكَمِيُّ المُعلَمُ",45,"م",1,0],["وَلَم نَملَل تَفَقُّدَكَ المَوالي","وَلَم نَذمُم أَيادِيَكَ الجِساما",46,"م",2,0],["ولم نُرزَقِ الوصلَ الذي عادَ فُرْقةً","ولم نعهدِ العُرسَ الذي صار مأتما",47,"م",2,0],["وَلَم نَفتَرِق حَتّى ثَنى الديكُ هاتِفاً","وَقامَ المُنادي بِالصَلاةِ يُنادي",48,"د",2,0],["وَلَم نُنصِفِ اللَيثَ اِقتَسَمنا نَوالَهُ","وَلَم نَقتَسِم حُمّاهُ إِذ أَقبَلَت تَردي",49,"ي",1,0],["وَلَم نَعُد مِنها إِلى طائِلٍ","غَيرِ الأَمانِيِّ وَتَضليلَها",50,"ل",3,0],["وَلَم نُعطِهِ حَقَّ الغَرامِ وَلَم نَكُن","لِنَبلُغَ مَفؤوضَ الأَسى بِالنَوافِلِ",51,"ل",1,0],["ولم نُعْطَ المُنى في القُرْبِ منه","فكَيفَ بها وقد شَطَّ المَزارُ",52,"ر",1,0],["وَلِمَن يَضيقُ عَنِ المَكارِمِ ضيقَةٌ","وَلِمَن تَفَسَّحَ في المَكارِمِ مُتَّسَع",53,"ع",1,0],["وَلَم نَتَزَوَّد لِلمَعادِ وَهَولِهِ","كَزادِ الَّذينَ استَعصَموا اللَهَ وَاتَّقَوا",54,"و",2,0],["وَلَم نَرَ بَدراً قَبلَهُ غابَ في الثَرى","وَلَم نَرَ طَوداً قَبلَهُ ضَمَّهُ القَبرُ",55,"ر",1,0],["ولِمَن نُفوسٌ رِيعَ من صَعَقاتها","عِزريلُ مُنطلقا