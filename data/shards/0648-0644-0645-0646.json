ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[549,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[549,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[549,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[549,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[556,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[556,"جميع البرايا هي اليلمع","https://www.aldiwan.net/poem34380.html","المتقارب"],[556,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[556,"بنا المولى هو الأحرى","https://www.aldiwan.net/poem34525.html","الهزج"],[556,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[557,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[560,"لكل قلب حبيب ظل يهواه","https://www.aldiwan.net/poem52742.html","البسيط"],[560,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"],[560,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"],[584,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[585,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["وَلَم نَرَ كَالعُيونِ ظُبى سُيوفٍ","أَرَقنَ دَماً وَما رُمنَ الجُفونا",0,"ن",2,0],["وَلَم نَطرَحِ الأَسلابَ يَوماً لِنَكبَةٍ","وَإِن جَذَبَ المِقدارُ مِنّا المَجاذِبا",1,"ب",2,0],["وَلَم نَرَ مِثلَ مُبيَضَّ النَواحي","تُعَذِّبُهُ بِمُسوَدِّ الإِهابِ",2,"ب",1,0],["وَلَم نَرضَ بِالبَأسِ دونَ السَماحِ","وَلا بِالمَحامِدِ دونَ الجَدا",3,"ا",1,0],["ولَمْ نَغْتَرِبْ مُسْتَشْرِفينَ لثَرْوَةٍ","فَمَرْعى مَطايانا بِيَبْرينَ مُبْقِلُ",4,"ل",1,0],["ولَم نتَكلَّفْ نَظْمَهُنَّ لأنّنا","وجَدْنا المعالي فاخْتَرعْنا المَعانِيا",5,"ي",2,0],["وَلَم نَقتُلكُمُ سِرّاً وَلَكِن","عَلانِيَةً وَقَد سَطَعَ الغُبارُ",6,"ر",1,0],["وَلَم نَجلِس جَميعاً في خَلاءٍ","نُسَرُّ بِما أَقولُ وَما تَقولُ",7,"ل",1,0],["وَلِمَن عَصَاكَ وَظَنَّ أَنْ سَتُجِيرُهُ","أَنْصَارُ جَارٍ أَوْ سَحِيقُ مَكَانِ",8,"ن",1,0],["وَلَم نَزِد أَن ظَفِرنا مِلءَ أَعيُنِنا","بِالمُشتَري فَتَجَنَّبنا لَهُ زُحَلا",9,"ل",2,0],["وَلَم نَرَ سَيفاً باتِكَ الحَدِّ قَبلَهُ","تَناوَلَ سَيفاً دونَهُ فَتَقَلَّدا",10,"د",2,0],["وَلِمَنْ سِوَاكَ إِذَا تَضَرَّمَتِ القُرَى","أَشْفَى نَدىً فِي إِثْرِ كُل ضِرَامِ",11,"م",1,0],["ولم نرَ قصراً منه أعلى مظاهراً","وأرفع آفاقاً وأفسح ناديا",12,"ي",2,0],["ولم نُبدِ عُنفاً حين جئت وإنما","هتفنا جميعاً بالوفاق وبالرفق",13,"ق",1,0],["ولم نكُ ندري لاهتضام حقوقنا","أنحن من الأحرار أم نحن في رِق",13,"ق",1,0],["ولم نستفد إلا سقوط وِزارة","وتأليف أخرى مثل تلك بلا فرق",13,"ق",1,0],["ولم نكْسُها إلا من العُرف حُلّة","وهل يكتسي الديباج من يكتسى العرفا",14,"ف",2,0],["ولم نترك الحُسنى أوان جدالكم","وتلك لعمري شِيمة المتحلِّم",15,"م",1,0],["ولم نفتأ كذلك كل يوم","لشأفةِ واغرٍ مستأصلينا",16,"ن",2,0],["وَلَم نَفتَأَ غَدَاة هَب وهَال","لِخَيرَاتِ الكَوَاعب مُجتَلِينَا",17,"ن",2,0],["ولم نُمكِن قَتَادَتَنَا لِلمسٍ","وَلاَ سَلَمَاتِنَا لِلعَاصِبِينَا",17,"ن",2,0],["وَلَم نُملَك بغَيرِ بَنى نِزَارٍ","وَلَم نُعطِ الإِتَاوَةَ مُجتَبِينَا",17,"ن",2,0],["وَلَم نفتَأ كَذَلِكَ كُلَّ يَوم","لِشَأفَةِ وضاغِر مُستَأصِلينَا",17,"ن",2,0],["وَلَم نُقدُد لَهُم أُدُماً صِحَاحاً","وَلَم نَهتِك حِجَابَهُمُ الكَنِينَا",17,"ن",2,0],["ولم نزل نرجوه كالمُرْتجِي","طاعة عَاتٍ قبل تَدْويخه",18,"خ",2,0],["ولمْ نُسْقَ إلا بالوزير ويُمْنِهِ","فَبُورك في أيامه وعهودِها",19,"د",3,0],["ولمنْ عاش غايةٌ فليُبادِرْ","سَيرَ إعدامِه إلى إيجادِهْ",20,"د",2,0],["ولم ننلْ من جناه نَهْمَتَنا","وإن حظينا بمونِق الزهرِ",21,"ر",1,0],["ولم نزل من ثدِيِّ نعمته","إذا فقدنا الرضاع نرتضع",22,"ع",1,0],["ولم نر قط أغدر من زمان","ولا بنذوره في الغدر أوفى",23,"ف",2,0],["ولمن عفا عمن هفا متمادياً","يوما كعفوك كيف يُدعى صارما",24,"م",2,0],["ولمن سَقَى مُهجَ النفوسِ سيوفَهُ","عللاً كسقيك كيفَ يُدعَى راحما",24,"م",2,0],["ولمن حمى الدنيا حمايتكَ التي","شَهرتْك كيف يُعدُّ غيثاً ساجما",24,"م",2,0],["ولم نر مثل العلم زاداً مُقدَّماً","له محملٌ خِفٌّ وإن كان عاصما",25,"م",2,0],["ولم نَبع قطُّ دُنيانا بآخرةٍ","ومثلنا لا يبيع النقدَ بالدين",26,"ن",1,0],["ولمن تَيَّمتْهُ وسواسُ هَمٍّ","سائرَ الليلِ تحتَ صدرٍ شجيِّ",27,"ي",1,0],["وَلِمَن يَعجَبُ مِن بُغضي لَهُ","أَيُّها الجاهِلُ أَمري اِتّئِبِ",28,"ب",1,0],["وَلَم نَشتَمِل بِاللَيل وَالحَيُّ نائِمٌ","وَلَم نَستَتِر بِالرَوض وَاللَيلُ مُمتَدُّ",29,"د",1,0],["وَلِمَن حاوَلَ أَن يُغضِبَهُ","إِنَّهُ أَعَلى وَأَسمى خُلُقا",30,"ق",2,0],["وَلِمَن يُشاهِدُ فيهِ رَمزَ كَيانِهِ","وَلِمَن يُجيدُ لِغَيرِهِ تَصويرَهُ",31,"ه",1,0],["وَلِمَن يَقولونَ الفِرَنجَ حُماتُهُ","اللَهُ قَبلَ سُيوفِهِم حاميهِ",32,"ي",2,0],["ولمن هذه البنادق والاعلام","منكوسة وهذا المويل",33,"ل",1,0],["ولمن في حياته خالط النا","س كثيراً احبة واعاد",34,"د",1,0],["ولمن تقدم باسم","ولمن تأخر قمطرير",35,"ر",1,0],["ولم ننتفع بالعلم الا صبابة","تجرعها مثر بمشهد مترب",36,"ب",1,0],["ولم نك إذ منعت الوصل ندرى","ابخلاً كان ذلك أم دلالا",37,"ل",2,0],["ولمن صام الشهر من رمضان","فهو غرثان في النهار وصادي",38,"د",2,0],["ولمن جاء يبتغي حج بيت اللَه","والأجر من بعيد البلاد",38,"د",1,0],["ولمن أعطى ماله يتزكى","ولمن جاء طائعاً للجهاد",38,"د",1,0],["ولم ندر على البحر","جديدا عنك مأثورا",39,"ر",2,0],["وَلَم نَدَع لِلَيالي صافِياً فَدَعَت","بِأَن نَغَصَّ فَقالَ الدَهرُ آمينا",40,"ن",2,0],["وَلِمَن هَياكِلُ قَد عَلا الباني بِها","بَينَ الثُرَيّا وَالثَرى تَتَنَسَّقُ",41,"ق",1,0],["وَلِمَن يُغالِطُ في الحَقائِقِ نَفسَهُ","وَيَسومُها طَلَبَ المُحالِ فَتَطمَعُ",42,"ع",1,0],["وَلَم نَرَ شَيئاً يَحمِلُ العِبءَ حَملَهُ","وَيَستَصغِرُ الدُنيا وَيَحمِلُهُ طِرفُ",43,"ف",1,0],["وَلَم نَرَ مَلكاً قَطُّ يُدعى بِدونِهِ","فَيَرضى وَلَكِن يَجهَلونَ وَتَحلُمُ",44,"م",1,0],["وَلِمَن أَقَمتَ عَلى الهَوانِ بِبابِهِ","تَدنو فَيُوجأُ أَخدَعاكَ وَتُنهَمُ",45,"م",1,0],["وَلِمَن يُهينُ المالَ وَهوَ مُكَرَّمٌ","وَلِمَن يَجُرُّ الجَيشَ وَهوَ عَرَمرَمُ",45,"م",1,0],["وَلِمَن إِذا اِلتَقَتِ الكُماةُ بِمازِقٍ","فَنَصيبُهُ مِنها الكَمِيُّ المُعلَمُ",45,"م",1,0],["وَلَم نَملَل تَفَقُّدَكَ المَوالي","وَلَم نَذمُم أَيادِيَكَ الجِساما",46,"م",2,0],["ولم نُرزَقِ الوصلَ الذي عادَ فُرْقةً","ولم نعهدِ العُرسَ الذي صار مأتما",47,"م",2,0],["وَلَم نَفتَرِق حَتّى ثَنى الديكُ هاتِفاً","وَقامَ المُنادي بِالصَلاةِ يُنادي",48,"د",2,0],["وَلَم نُنصِفِ اللَيثَ اِقتَسَمنا نَوالَهُ","وَلَم نَقتَسِم حُمّاهُ إِذ أَقبَلَت تَردي",49,"ي",1,0],["وَلَم نَعُد مِنها إِلى طائِلٍ","غَيرِ الأَمانِيِّ وَتَضليلَها",50,"ل",3,0],["وَلَم نُعطِهِ حَقَّ الغَرامِ وَلَم نَكُن","لِنَبلُغَ مَفؤوضَ الأَسى بِالنَوافِلِ",51,"ل",1,0],["ولم نُعْطَ المُنى في القُرْبِ منه","فكَيفَ بها وقد شَطَّ المَزارُ",52,"ر",1,0],["وَلِمَن يَضيقُ عَنِ المَكارِمِ ضيقَةٌ","وَلِمَن تَفَسَّحَ في المَكارِمِ مُتَّسَع",53,"ع",1,0],["وَلَم نَتَزَوَّد لِلمَعادِ وَهَولِهِ","كَزادِ الَّذينَ استَعصَموا اللَهَ وَاتَّقَوا",54,"و",2,0],["وَلَم نَرَ بَدراً قَبلَهُ غابَ في الثَرى","وَلَم نَرَ طَوداً قَبلَهُ ضَمَّهُ القَبرُ",55,"ر",1,0],["ولِمَن نُفوسٌ رِيعَ من صَعَقاتها","عِزريلُ مُنطلقاً بها ينطادُ",56,"د",1,0],["وَلِمَنْ عَصاكَ مدىً فإنْ بلغوا المدَى","فاللّهُ يَقْضِي ما يشاءُ ويَحكمُ",57,"م",1,0],["ولمَن تقدَّمَ فوقَ صهوةِ عاثرٍ","أشقَى وأخيبُ آخد بلجامهِ",58,"م",2,0],["وَلَم نَفُز مِنهُ إِلّا","بصدِّهِ وَدَلالِه",59,"ل",2,0],["وَلَم نَزَل نَخبِطُ البِلادَ بِأَخ","فافِ المَطايا وَالظِلُّ مُعتَدِلُ",60,"ل",1,0],["وَلِمَنْ يمدَحُ خَيْرَ البرايا","أنْ يَرَى الفقرَ عَطاءً حِسابا",61,"ب",2,0],["ولِمَنْبَعِ المَاءِ المَعِينِ براحَةٍ","رَاح الحَصَى وَلهُ بها تَسْبيحُ",62,"ح",1,0],["وَلِمَنْ تَعَلَّقَ بالصَّلِيبِ بِزَعمِهِم","لَعْناً يَعُودُ عليهمُ مكفولا",63,"ل",2,0],["ولِمَنْ لَيالٍ ما ذَمَمْنا عَهدَها","مُذ كُنّ إلاّ أنهُنّ شُجون",64,"ن",1,0],["وَلِمَن يَثني إِلَيهِ ال","حُسنُ أَعناقَ القُلوبِ",65,"ب",1,0],["وَلِمَن يَرنو بِعَينَي","رَشَإٍ أَحوى وَموقِ",66,"ق",1,0],["وَلِمَن يَدعو إِلَيهِ ال","حُسنَ مُرّارَ الطَريقِ",66,"ق",1,0],["وَلِمَن يُعنِقُ في المِش","يَةِ كَالطَرفِ العَتيقِ",66,"ق",1,0],["وَلَم نَحلُل بِدُنيانا اِختِياراً","وَلَكِن جاءَ ذاكَ عَلى اِضطِرارِ",67,"ر",1,0],["ولمن أُقيمت في البيو","ت عَلى كَرامتها المناوح",68,"ح",1,0],["ولمن يغلط في الحقائق نفسه","ويسومها طلب المحال فتطمع",69,"ع",1,0],["ولمن ساسَ في الممالك عدلا","وارتضى الحقَّ في العلا بنيانَه",70,"ن",2,0],["ولمن هتافٌ بالضِّفاف مُردّدٌ","أشجى من الوترِ الحنونِ وأرخمُ",71,"م",1,0],["ولمن عواصمُ مصرَ حاليةَ الذُّوى","تغزو بوارقُها النجومَ وتزحُمُ",71,"م",1,0],["ولمن هذه العيونُ","تغمَّرْنَ بالحوَرْ",72,"ر",1,0],["ولمن توشكُ الثُّدَى","وثبَةَ الطيرِ في السَّحَرْ",72,"ر",1,0],["ولمن رفَّتِ المبا","سِمُ واسترسل الشَّعَرْ",72,"ر",1,0],["ولم نكُ ندري يوم ذلك ما الهوى","ولا ما يعود القلب من خفقان",73,"ن",1,0],["ولم نَعْتَمِدْ مَغْنَاكَ غَدْواً ولم نزَلْ","نَؤُمُّ لفَصْلِ الحُكْمِ دارَ حَكِيمِ",74,"م",1,0],["وَلِمَنْ لاَقى شِتاءَ الْعُمْرِ فِي","زَهَرَاتِ الْبِرِّ بُشْرَى بِالرَّبِيعْ",75,"ع",1,0],["وَلِمَنْ تَمْلأُ الفَضَاءَ وَعِيداً","عُدَدٌ مِنْ حَدِيدِهِ الرَّعَّاد",76,"د",1,0],["وَلمِنْ عَنَائِي زَارِعاً أَوْ صَانِعاً","أَوْ شَائِداً صِرْحاً رِفِيعَ عِمَادِ",77,"د",1,0],["ولَم نَجْعَلْ تجارَتَنا اشتِرَاءَ الْ","حَمِيرِ لأَرْضِ دَوْسٍ أو مرادِ",78,"د",1,0],["ولَمْ نَدْرِ أَنَّ المَوْتَ باسِطُ كَفِّه","إلى الغُصْنِ في رَيْعَانِه وهو مُونِع",79,"ع",1,0],["ولم نبالِ فُروقاً شَتَّتْ أُمماً","عدنانُ غسّانُ أو غسّانُ عدنان",80,"ن",1,0],["ولم نَدعْ من رموزِ السحْر سانحةً","طافت بمعنى العُلا إلاَ لمحناها",81,"ا",3,0],["ولمن طواها الموتُ وهْ","يَ تذودُ عن عرضٍ مَصُون",82,"ن",1,0],["ولم نتحدَّ العروشَ؛ ولكنْ","هو الظلمُ زَلْزَلَ أطوادها",83,"د",3,0],["ولم نعتمد مغناك غدوا ولم نزر","رواحا لفصل الحكم دار حكيم",84,"م",1,0],["ولمن يمدح خير البرايا","أَنْ يَرَى الفَقْرَ عَطءً حِسابا",85,"ب",2,0],["وَلمْ نُعْطِهِ حَقّ الغَرَامِ، وَلم نكُنْ","لنَبْلُغَ مَفْرُوضَ الأسَى بالنّوَافِلِ",86,"ل",1,0],["ولم نبالِ فُروقاً شَتَّتتْ أُمماً","عدنانُ غسّانُ أو غسّانُ عدنان",87,"ن",1,0],["ولمن ساس في الممالك عدلا","وارتضى الحقّ في العلا بيانه",88,"ن",2,0],["وَلَم نَرَ غَير دردي بِكَأس","شربناها فَيا عبرات هات",89,"ت",1,0],["ولم نبل في الحالين الا لكي نرى","شؤن الليالي زينها وذميمها",90,"م",3,0],["ولمنيتي محي الكئيب لطفه","طرف يميت العاشقين كحبل",91,"ل",1,0],["ولم نره يوماً أقام لشأنه","مقاماً ولا كنى بذاك ولا ورى",92,"ر",2,0],["ولم نَروِ بعدُ الغلِيل","فَمَهلا ودَعنا لِحِين",93,"ن",1,0],["ولم نَجتَز المُبتَدا","فَسُرعانَ يأتي الخِتام",93,"م",1,0],["ولم نُنكِرُ عمودَ الصُّبحِ أبدَى","سناهُ الأفقَ والتَهَبَ التهابا",94,"ب",2,0],["وَلَم نَقبَل مِنَ الواشي","قَبول الجاهِلِ الخاطِل",95,"ل",1,0],["ولم نر دُرًّا ولا زهرةً","من التُّرب أصدافُها والكِمامُ",96,"م",1,0],["وَلِمَن يَبتَغى عُقوقُكَ ظَنٌّ","عَوَّدَتهُ صِفاتُكَ الإِكداءَ",97,"ا",2,0],["وَلَم نَرَ سَيلاً قَبلَهُ فاضَ مِن دَمٍ","وَلا قُضُباً هِندِيَّةً قَتَلَت خَنقا",98,"ق",2,0],["وَلَم نَرَ خَطباً نالَ مِنّا فَأَعقَبَت","إِساءَتُهُ نُعمى وَجارَ لِيَعدِلا",99,"ل",2,0],["وَلَم نَخَل أَنَّنا فيما نَعيشُ نَرى","قَبلَ الحِمامِ دَواءً يُذهِبُ الهَرَما",100,"م",2,0],["وَلِمَن لَهُ في كُلِّ عُضوٍ مَنزِلٌ","منّي عَلى قُربِ المَحَلِّ وَنائِهِ",101,"ا",3,0],["وَلَم نَزَل نَرِدُ الهَيجاءَ يَقدُمُنا","ماضٍ على الهَولِ وَرّادٌ إِذا عَزَما",102,"م",2,0],["ولِمنطِقِ التأْريخِ خَتمٌ بالدُّعا","لِعُلاهُ أَرِّخْ وهو خيرُ خِتامِ",103,"م",1,0],["وَلِمَن تَراهُ بائِساً","أَبداً لِذَيلِ التُركِ بائسْ",104,"س",1,0],["وَلِمَن أَزمّته بِكَفْ","فِ عِداهُ يَظلمُ وَهُوَ آئسْ",104,"س",1,0],["وَلِمَن غَدا في الرِّقِ لَيْ","سَ يَفوتُهُ إِلّا المناخِسْ",104,"س",1,0],["وَلِمَن تُباعُ حقُوقُهُ","وَدِماؤُهُ بَيع الخَسائِسْ",104,"س",1,0],["وَلِمَن يَرى أَوطانَهُ","خَرَباً وَأَطلالاً دَوارِسْ",104,"س",1,0],["وَلَم نُخطّئهم في كلّ مسألةٍ","فَكم كلامٍ لهم فازوا بأصوبهِ",105,"ب",2,0],["ولمن تركتَ الصافناتِ كأنَّها","موسومةٌ باللؤمِ وهي كرام",106,"م",1,0],["ولم نغتبق تلك الأحاديثَ قهوةً","وكم مجلسٍ طِيْبُ الحديثِ به خمر",107,"ر",1,0],["ولم نبتْ ليلةً كالروضِ حاليةٍ","نجني بها من صنوفِ اللهوِ ماشينا",108,"ن",2,0],["ولم نأمن سوى اللحظات رُسلاً","حذاراً من حسود أو خؤونِ",109,"ن",1,0],["ولم نكن اطحر إذا تحاشا","لنأتمن الشمال على اليمين",109,"ن",1,0],["ولم نك نَسْتَسْقِي الصِّبا ماءَ مُزْنِهِ","ونفتح مِن أبوابِهِ كلّ مغلقِ",110,"ق",1,0],["ولم نُفْشِ للألحاظ مكنونَ حبّنا","وأسرارِنا فيه فنستخدِم اللحظا",111,"ظ",2,0],["ولم نأت شيئاً يُسْخِط المجدَ فعلهُ","سوى أنّنا بِعْنا الوقارَ من اللَّعب",112,"ب",1,0],["ولم نَزَلْ في بيتِ خمّارها","نشرَبُها شهراً ومَثْنَاه",113,"ن",3,0],["ولم نكن ننزلُ فيه على","حُكْم من الأَيام نَشْناه",113,"ن",3,0],["وَلِمَن رَآهُ فَقَد رَأى الحَقَّ الَّذي","لا شَكَّ فيهِ عِندَ ذي الإيقانِ",114,"ن",1,0],["وَلِمَنْ يَزُورُ ضَرِيحَكُمْ","وَلْهَانَ فِي زَيِّ الْوَلِيدْ",115,"د",1,0],["وَلِمَنْ بِمَدْحِ جَلاَلِكُمْ","أَغْرَاهُ ذُو الرَّأْيِ السَّدِيدْ",115,"د",1,0],["وَلَم نَهلِك لِمُرَّةَ إِذ تَوَلَّوا","فَساروا سَيرَ هارِبَةٍ فَغاروا",116,"ر",3,0],["ولمن في الدين قد اجتهدا","وعلى عثمان شهيد الدا",117,"د",2,0],["ولم نر علماً لم تكن منه وافقاً","على اصله والفرع والنوع والجنس",118,"س",1,0],["ولم نكُ يوماً آسفينَ لأنّنا","نُقاسمهُ ما هانَ عند التفجُّع",119,"ع",1,0],["وَلمن يَليني صحبة وَرحامة","بالخير يا خير العباد فبشر",120,"ر",1,0],["ولَمْ نَبِتْ وَذُبَالاتُ الشموعِ كَمَا","تَوَقَّدَت شَفَرَاتٌ في فَتىً كَدِنِ",121,"ن",1,0],["وَلَمْ نَعْهَدْكَ فِي سَرّاءِ حالٍ","وَلا ضَرّائِها إِلاّ شَكُورا",122,"ر",2,0],["وَلَم نَرَ تُركِياً سِواكَ مُبارِزاً","يُجَدِّلُ أَبطالاً بِغَيرِ سِلاحِ",123,"ح",1,0],["وَلَم نَرَ قَبلَهُ أَسَداً وَشَمساً","يَفيءُ عَلَيهِما الشعرُ الأَثيثُ",124,"ث",1,0],["ولم نعلم بأن في الزوايا","خبايا أيدت حزب الحسيب",125,"ب",1,0],["ولم نتهز من فائت العمر فرصة","ولم يغتنم خالي فراغ وصحة",126,"ه",1,0],["وَلَم نَعلَم بِأَن لا لَبثَ فيها","وَلا تَعريجَ غَيرَ الإِجتِيازِ",127,"ز",1,0],["ولمن أغنّي والفضاءُ الطلق","يسخر من قيودي",128,"ي",1,0],["ولمن أغنى إن لقيتك صامتا","ومراكب الألحان ملء سمائي",129,"ا",2,0],["ولم نَعْجَبْ لِفَيْضِ النِّيلِ إنِي","وإبراهيمَ عَلَّمَهُ الوَفاءَ",130,"ا",2,0],["ولم نَخُصَّ له يوماً بتَهْنئةٍ","أَيّامُه كلُّها مِمّا نُهنّاه",131,"ا",2,0],["ولم نَر لَيْثاً قبلَ رُؤْيتنا له","هِزَبْراً له في الكفِّ للقِرْنِ نابان",132,"ن",1,0],["ولم نَمدَحْهمُ عَبَثاً بقَوْلٍ","عَلَكْناه كما عُلِكَ الشَّكيم",133,"م",1,0],["ولِمَنْ أتَى حُسنَ الفِعا","لِ من الورى حُسْنُ المَقال",134,"ل",1,0],["ولم نَسمَعْ بأكرمَ منه طَبْعاً","وأبعدَ عن فعالِ المُستَطيل",135,"ل",1,0],["ولم نَقَضِ من حقِّ المطايا وقد سَمَتْ","لِلُقياهُ إلا دون ما هو واجب",136,"ب",1,0],["ولم نكُ نجهل ريبَ الزمان","وأنَّ المقيمَ به راحل",137,"ل",1,0],["وَلَم نُفرق التَفريق إِذ نَحنُ جيرة","فَقَد غالَنا دَهر تَجور نَوائبهُ",138,"ب",2,0],["وَلِمَن مَنزل تَعفت نَواحيهِ","وَأَقوى إِذ بانَ عَنهُ القَطين",139,"ن",1,0],["ولم نطل المقالة بالشكاوي","وإكثار التوجع والأنينا",140,"ن",2,0],["ولمَنْ تشبَّهَ بالغُرابِ ، فما مشى","مَشْيَ الغُرابِ ، ولامشَى كحمامِ",141,"م",1,0],["ولمن تقدِّمُ شِيحِها وخُزَامه","وتزفُّ من كلماتها الأزهارا ؟",142,"ر",2,0],["ولمن تطرِّزُ ثوبها وإلى متى","تبقى تُسامر ليلها ونهارا ؟",142,"ر",2,0],["ولَمَنْ رآكَ ولم يَمتْ من حِينِهِ","بسيوفِ خوفك إنّه لِمُعَمَّرُ",143,"ر",1,0],["ولمن إليهِ حديثُ كلِّ فضيلةٍ","من بَعْدِ خيرِ المرسلين يُساقُ",144,"ق",1,0],["ولمِْ نَسِينا حُقوقاً جَمَّمةً سلفَتْ","لزَلَّةٍ إنْ جَرتْ هَذا منَ الغَبَنِ",145,"ن",1,0],["ولِمَنْ أَلومُ وإِنَّما","عَيني عليَّ الجَانِيَه",146,"ي",2,0],["ولمنْ أراد من الأَكارم بغية","ألفى أبا سلمان فوقَ مراده",147,"د",2,0],["ولمن أشكو على برح الهوى","كبداً حرَّى وقلباً مستهاما",148,"م",2,0],["ولم نظفر بمثل علاه يوماً","بمطّلع بصير بالأُمور",149,"ر",1,0],["ولم ندرك سلافا تزدهينا","أم الأشراق من وجه المديرِ",150,"ر",1,0],["ولمن أسيرُ الى سواكُم في الهوى","والقلبُ في عرَصاتِكُم خلّفتُه",151,"ت",2,0],["ولمن تُلَبِّيهِ السماءُ وأَرضُها","مدداً إِلَيْكَ لَهُ مَلِيكاً أَوْ مَلَكْ",152,"ك",1,0],["ولمن يرى خَفْضَ النعيمِ مُحَرَّماً","يوماً تُرِيهِ لواءَكَ المنشورا",153,"ر",2,0],["ولمن مُناهُ أَنء تعيشَ مؤيِّداً","ومؤَيَّداً ومؤمِّناً ومؤمَّنا",154,"ن",2,0],["ولِمَنْ نمى سبأٌ بِسَبْيِ مُلُوكِها","واسْتَخْلَفَتْ أَذْوَاؤُهُ وقُيُولُهُ",155,"ل",2,0],["ولِمَنْ تَتَوَّجَ بِالمَكَارِمِ تاجُهُ","عُلْواً و