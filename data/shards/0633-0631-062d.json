{"poems":[[55,"يا رفيقي قفا نضويكما","https://www.aldiwan.net/poem29724.html","الرمل"],[55,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[95,"قد قام عرشك في أعز مكان","https://www.aldiwan.net/poem11213.html","الكامل"],[95,"لا تحقر الدرهم من مسعد","https://www.aldiwan.net/poem11340.html","السريع"],[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[85,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[45,"سر حل حيث تحله النوار","https://www.aldiwan.net/poem9562.html","الكامل"],[101,"الشقيقتان","https://www.aldiwan.net/poem6547.html","عموديه"],[82,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[46,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[107,"يا ابن عوف سر حثيثا باللواء","https://www.aldiwan.net/poem43583.html","الرمل"],[107,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[48,"سرحوب عمن سرى لله مبتعثا","https://www.aldiwan.net/poem22129.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[102,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[82,"أخذتْ سفاقس منك عهدَ أمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=3768",""],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[53,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""],[151,"سرح سوادك والطروس سماء","https://www.aldiwan.net/poem47634.html","الكامل"],[170,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[240,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[242,"سرح جياد اللحظ في ذي البطاح","https://www.aldiwan.net/poem18121.html","السريع"],[266,"حباك عرفا حليها والوشاح","https://www.aldiwan.net/poem38348.html","الخفيف"],[371,"سرحت دمعي لا تسريح إحسان","https://www.aldiwan.net/poem17134.html","البسيط"],[408,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[409,"أحلى الهوى ما كان جهرا","https://www.aldiwan.net/poem33914.html","مجزوء الكامل"],[409,"كل ما في الأكوان من آياتك","https://www.aldiwan.net/poem34100.html","الخفيف"],[422,"بوركت يا دار سلمان التي رفعت","https://www.aldiwan.net/poem53894.html","البسيط"],[449,"سرحت في حسن فرساي النواظر وال","https://www.aldiwan.net/poem55991.html","عموديه"],[452,"لمن الديار عرفتها وكأنها","https://www.aldiwan.net/poem2172.html","الكامل"],[463,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[482,"ماذا الوقوف وقد بانوا على الطلل","https://www.aldiwan.net/poem15230.html","البسيط"],[534,"بعثت نحوي زادك الله من","https://www.aldiwan.net/poem37347.html","السريع"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107238","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122575","الكامل"],[755,"","https://poetry.dctabudhabi.ae/diwan/poem/121046","الخفيف"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104439","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48750","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123422","البسيط"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143131","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144075","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84498","المنسرح"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124018","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21665","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118299","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69403","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69384","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46485","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48208","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109467","الكامل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10505","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60826","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93544","الكامل"],[2469,"","https://poetry.dctabudhabi.ae/diwan/poem/203610","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137095",""],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84522","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130752","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130850",""],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101879","الرمل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113866","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200580","الخفيف"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62885","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102390","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138544",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216628",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77065","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86352","الرمل"],[4186,"","https://poetry.dctabudhabi.ae/diwan/poem/198652",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54477","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104924","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120505","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/101999","البسيط"],[4797,"سرحت فالقلص من عزبة تميم","https://www.poetsgate.com/ViewPoem.aspx?id=178126",""],[4927,"تَسْرِيْحُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=29718",""],[4935,"مفاخر مصر بالكذب","https://www.poetsgate.com/ViewPoem.aspx?id=129308",""],[4994,"سرّحي بالحب قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213307",""],[5002,"إرحل بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=202375",""],[5011,"سر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197862",""],[5111,"جموحُ","https://www.poetsgate.com/ViewPoem.aspx?id=212077",""],[5111,"سَبْكُ الحُروفِ","https://www.poetsgate.com/ViewPoem.aspx?id=212327",""],[5118,"تخيُّل","https://www.poetsgate.com/ViewPoem.aspx?id=129800",""],[5121,"هذا الْهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=216055",""],[5480,"لزيم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=21011",""],[5525,"لا تعقد الحبل","https://www.poetsgate.com/ViewPoem.aspx?id=7191",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5605,"حميمية لقاء..","https://www.poetsgate.com/ViewPoem.aspx?id=159461",""],[5616,"أفكار","https://www.poetsgate.com/ViewPoem.aspx?id=203325",""],[5691,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=205975",""],[5841,"قريته عكس ما يتلا","https://www.poetsgate.com/ViewPoem.aspx?id=34957",""],[5851,"ضوء من خفايا الروح","https://www.poetsgate.com/ViewPoem.aspx?id=175293",""],[5956,"لبّت مطالبَ أبِّها أنْؤونُ","https://www.poetsgate.com/ViewPoem.aspx?id=206255",""],[5970,"ساعة يؤنسني فيها الملك","https://www.poetsgate.com/ViewPoem.aspx?id=130672",""],[6056,"الأشقر المقضوض","https://www.poetsgate.com/ViewPoem.aspx?id=130331",""],[6302,"فَكُونيْ ... عيدَهُ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86203&r=&rc=1",""]],"verses":[["سَرحَةٌ أَعجَلَها البَينُ وَما","لُبِسَ الظَلُّ وَلا ذيقَ الجَنى",0,"ن",2,0],["سَرَحتُم سَفاهَتَكُم في العُقوقِ","وَلَم تَحفِلوا الحِلمَ لَمّا غَرَب",1,"ب",1,0],["سَرِّحْ بِحَيْثُ تَشَاءُ طَرْفَكَ لا يَقَعْ","إِلاَّ عَلَى مَا فَوْقَ كُلِّ بَيَانِ",2,"ن",1,0],["سَرِّّحْ بِهِ طَرْفَكَ وَاعْجَبْ لِمَا","يَنْجُمُ عَنْ تَصْرِيفِهِ المُحْكَمِ",3,"م",1,0],["سِرْ حَمِيداً إِلَى الخُلُودِ وَأَلْقِ العِ","بْءَ إِنَّ الحَيَاةَ عِبْءٌ ذَمِيمُ",4,"م",1,0],["سَرَحَتْ عنان الريح فهي وربما","أَلْقَتْ بساحته عصا التّسيارِ",5,"ر",1,0],["سَرَحَتْ بمخضرْ الجوانب يانعٍ","تنسابُ فيه أراقم الأنهارِ",5,"ر",1,0],["سِر حَلَّ حَيثُ تَحَلُّهُ النُوّارُ","وَأَرادَ فيكَ مُرادَكَ المِقدارُ",6,"ر",1,1],["سرحيني .. جمليني .. لوني","ظفري الشاحب إني مسرعة",7,"ع",2,0],["سرّحْتَ مالكِ من يمينِ سميحةٍ","والمال في اليمنى السميحة عانِ",8,"ن",1,0],["سُرُحٌ قَولُهُ إِذا ما اِستَمَرَّت","عُقدَةُ العِيِّ في لِسانِ الخَطيبِ",9,"ب",1,0],["سِرْ حثيثاً يا ابنَ عوفٍ إنّها","دُومَةُ الجندلِ والقومُ البِطاءْ",10,"ا",2,0],["سِرْ حَثيثاً أبا عُبيدةَ وَامْلأْ","أرضَ نَجرانَ هِمَّةً وَاجْتِهَادا",11,"د",2,0],["سرِّحوا الجيشَ وكُفُّوا إنّها","مَصرعُ الجيش وحَتفُ الفيلقِ",12,"ق",1,0],["سُرحوبُ عَمَّن سَرى لِلَّهِ مُبتَعَثاً","وَجَناءَ في الكورِ أَو في السَرحِ سُرحوبا",13,"ب",2,1],["سَرَحَاتٌ قُصِفَتْ مُحْضَأَةً","بَيْنَ مَنْكُوسَةِ إِكْلِيلٍ وَعَقْرَى",14,"ر",2,0],["سَرْحُهَا قدْ زَكَا وَسُنْدُسُهَا","أَبْدَعَ الْوَشْيَ فِيه منْ وَشَّى",15,"ش",2,0],["سرّحت لمحة ، فطالعها شيء","كأيماءة السراج الضعيف",16,"ف",1,0],["سرّحتْ مالكِ من يمين سميحة","ٍ والمال في المينى السميحة عان",17,"ن",1,0],["سُرُحِ العَنيقِ إذا ترفَّعَتِ الضُّحى","هَدَجَ الثَّفَالِ بِحِمْلِهِ المُتَثَاقِلِ",18,"ل",1,0],["سرَّحها اللَّه له بالسَّلْتِ","تعرفُهُ الأَنباط بالبَذْنَقْتِ",19,"ت",1,0],["سرّح سوادك والطروس سماء","ما للسماك لدى العروس علاء",20,"ا",2,1],["سرَحتُ في جوِّها الأنفاسَ فالتقطت","نسيمَ ريّا وأهدتْهُ إلى عِلَلي",21,"ل",2,0],["سِر حَيثُ شِئتَ مِنَ البِلادِ فَأَينَما","عَرَّستَ كُنتَ لَهُ مِنَ الأَضيافِ",22,"ف",1,0],["سَرِّحْ جِيَادَ الَّلحْظِ فيِ ذِي الْبِطَاحْ","قَدْ عَرْبَدَ النُّوَّارُ فِيهَا فَفاحْ",23,"ح",1,1],["سرحت سرعة مخافة دمعي","ومع الغيث لا يطاق السراح",24,"ح",1,0],["سَرَّحتُ دَمعيَ لا تَسريحَ إِحسانِ","فَلا تَلُمني عَلى تَصريحِ أَجفاني",25,"ن",2,1],["سِرْ حَيثُ شئتَ يَسِرْ لديكَ مُصاحباً","مِنْ نَصرِ مَولاكَ العَديدُ الأكثرُ",26,"ر",1,0],["سرحت طرفي في ريا","ض بديعه سطراً فسطراً",27,"ر",2,0],["سرح الطرف طرف فكرك وانظر","وتأمل إلى عجائب ذاتك",28,"ك",1,0],["سرِّحْ بها نظراً وانظر بها قمراً","فإنَّها تعجبُ الأَنظار ما نظَرَتْ",29,"ت",1,0],["سرحت في حسن فرساي النواظر وال","آمال تنشد يا أيأمنا عودي",30,"ي",1,1],["سُرحِ اليَدَينِ إِذا الحِدابُ تَرَقَّصَت","وَإِذا رُفِعنَ رَفيعَةَ المِشوارِ",31,"ر",1,0],["سرَّحتُ ذودَ الآمال فيه","بين جِذاعٍ إلى مثَاني",32,"ن",2,0],["سرَّحتُ أسودَ طرفي في خمائِلها","والشمسُ رافلةٌ في حُلَّةِ الأصُلِ",33,"ل",1,0],["سَرَّحْتُ طَرْفي مِنْهُ في جَنَّةٍ","لَمْ يَحْكِها في الحُسْنِ رَوْقٌ أَريضْ",34,"ض",1,0],["سَرَّحتُ طَرفِي في رِياضِ مَديحِهِم","وَتَركتُهُ يجري بغَيرِ عِنانِ",35,"ن",1,0],["سَرِحٌ تُكَلِفُهُ مُواهَقَةُ الصَّبا","مَرحُ البَذاذَةِ لا القَطيعُ المُحصَد",36,"د",1,0],["سرح الطّرف في ذراه ترى ث","مّ نعيماً به وملكاً كبيرا",37,"ر",2,0],["سرح بها اللحظ تجد روضة","غناء قد رقت حواشيها",38,"ي",3,0],["سر حرصت عليه ثم أذعته","وكذا يسر المطمئن ويجهر",39,"ر",1,0],["سِرُّ حَياةٍ وشَرُّ مَوتٍ","حياةُ نَفسٍ وَمَوْتُ قلبِ",40,"ب",1,1],["سرح القوائم يكتسين أطلة","مما يسري وقعها ويثيرها",41,"ر",3,0],["سرّحهُ الحسنُ بأم","شاطِ التّصابي ومشَطْ",42,"ط",1,0],["سرح تزل عنك الأوزار","وإن ترم أجر الأبرار",43,"ر",1,1],["سرح اليدين سبنداةُ مذكرةٌ","مفتولة عن بواني زورها العضدُ",44,"د",1,0],["سُرُحٍ إِذا رُمِيَت بِها مَجهولَةٌ","مَرتُ المَنازِلِ فارَقَت أَميالَها",45,"ل",3,0],["سرحا هذه المطايا لترعى","من حقول طابت أصولا وفرعا",46,"ع",2,0],["سرحتها من وثاقي اذ وثقت بها","والعجب اصل لما في النفس من داء",47,"ا",2,0],["سِر حَيثُ شِئتَ مِنَ البِلادِ تَجد بِها","لَكَ عِقدَ حَمدٍ مِن غَريبِ نِظامِهِ",48,"م",2,0],["سِر حَيثُ شِئتَ فَإِنَّ سَعدَكَ لَم يَدَع","في الشامِ دُونَكَ مِنبَراً مَقفُولا",49,"ل",2,0],["سر حَيث شئت وَكَيفَ شئت فَإِنَّما","تَطوي المَراحلَ في يَد الأَقدار",50,"ر",1,0],["سَرَح الألفاظَ في روض الفِكَرْ","بين من لقَّبْتُه بدرَ البَشَرْ",51,"ر",1,1],["سرحت طرف الطرف فيه فراح في","خببٍ يسير وما عليه غبار",52,"ر",1,0],["سَرَحَت بِ