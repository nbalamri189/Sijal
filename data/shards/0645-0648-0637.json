{"poems":[[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[88,"أيدري المسلمون بمن أصيبوا","https://www.aldiwan.net/poem10481.html","الوافر"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[31,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[93,"صوت سوريا الجميله","https://www.aldiwan.net/poem62756.html","عموديه"],[99,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[119,"كلامنا مر على أهلنا","https://www.aldiwan.net/poem41698.html","السريع"],[128,"هاتها واشرب فإن اليوم فصح","https://www.aldiwan.net/poem23717.html","الرمل"],[146,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[280,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[422,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[458,"أرجال لا ولا شبه رجال","https://www.aldiwan.net/poem61613.html","الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54126","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145627","الرمل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145153","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46542","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128718","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58353","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201898",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205024","المنسرح"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101595","الخفيف"],[3096,"","https://poetry.dctabudhabi.ae/diwan/poem/198785",""],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100740","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112623","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3722,"","https://poetry.dctabudhabi.ae/diwan/poem/202359","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123491","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123484","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94451","الوافر"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35055","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76695","السريع"],[4755,"مَوطِنِي.. لَكَأنَّ حُزنَكَ غَيمَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198525",""],[4782,"يَمَن الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=199200",""],[5057,"لستُ أخفيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197241",""],[5090,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=184309",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5351,"الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=202103",""],[5376,"لا تَسلْ عني فأنَّي","https://www.poetsgate.com/ViewPoem.aspx?id=198988",""],[5431,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=185085",""],[5431,"إصبع الجوع...","https://www.poetsgate.com/ViewPoem.aspx?id=199030",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5442,"نمت ولم يجف كراك الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=114769",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5720,"الْزَمِ البيتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211243",""],[5885,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=194688",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""],[6118,"عودة الشراع","https://www.poetsgate.com/ViewPoem.aspx?id=12625",""]],"verses":[["مُوَطَّأُ الأكْنافِ أبوابُهُ","لهُنَّ بالزّائِرِ تَرْحيبُ",0,"ب",1,0],["مُوَطَّأَ مالِكٍ عَزِّ البُخاري","وَدَع لِلَّهِ تَعزِيَةَ الكِتابِ",1,"ب",1,0],["مُوَطَّأُ أَكنافِ السَماحِ دَنَت بِهِ","خَلائِقُ زُهرٌ إِذ أَنافَ نِصابُ",2,"ب",1,0],["مُوَطَّأُ البَيتِ مَحمودٌ شَمائِلُهُ","عِندَ الحَمالَةِ لا كَزٌّ وَلا وَعِقُ",3,"ق",1,0],["مَوطِنٌ نَهوى سُهولَه","مِثلَما نَهوى رُباه",4,"ه",1,0],["موطن الحسن ثوى فيه السأم","وسرت أنفاسه في جوِّهِ",5,"ه",1,0],["مَوْطِئُ الأخمَصِ الَّذِي منه للقل","لبِ إذا مَضْجَعي أَقَضَّ وِطاءُ",6,"ا",2,0],["موطني ينأى ويدنو غيرَهُ","زمناً هنا حام وفادي",7,"د",2,0],["موطنهم سرا مناخ الحشا","وأننا عنهم لفي معزل",8,"ل",1,0],["موطني الأردن لكني به","كلما داويت جرحاً سال جرح",9,"ح",1,0],["موطَّأُ فإذا لُزَّت حفيظتُه","تكاشر الموتُ عن أنيابهِ العُصُلِ",10,"ل",1,0],["مُوَطّأُ دارِ العَدْلِ فَهَّمَتِ العِدى","مَغازِيهِ مَعنَى الصّيْدِ قَبْلَ الذّبائِح",11,"ح",1,0],["موطني آه موطني","شاقني ذكرك الحسن",12,"ن",1,0],["موطني العين اجهشت","والهوى في الحشا كمن",12,"ن",1,0],["موطن تنزل الملائك فيه","ومقام يَسُرُّ هذا الفؤادا",13,"د",2,0],["موطني في معقلِ الأحرارِ لا","موطنُ البغيِ وقد صال وجال",14,"ل",1,0],["موطّنا في ذاك لما فعلا","بنفسه من دونه أن يقتلا",15,"ل",2,0],["مَوطِنٌ عِندَهُ يَهي كُلَّ عَزمٍ","وَيولي قَذالَهُ كُلَّ مَسعَر",16,"ر",1,0],["موطئُ أكناف القضاء بعدله","وبالنظم والنثر البيان موطدُ",17,"د",1,0],["مَوْطن يُرسي ذوو","البرِّ بمرساه الجباها",18,"ا",3,0],["مَوْطِنَ المُسْتَبْسِلِ الحُرِّ الأَبِي","دُمْ سعيدًا في بُرُوج الشُّهُبِ",19,"ب",1,0],["موطَّداً على التقى مؤسَّسا","في شِيخةٍ حديثهم يجلو الأسى",20,"س",2,0],["موطأ الأَكناف","لَيسَ بِذي اِعتِساف",21,"ف",1,0],["موطّأة أخباره وعلومه","مدوّنة كم عالم بهما أكتفى",22,"ف",2,0],["مَوْطنَ اللّهوِ والخلاعةِ والقَص","فِ ومأوى عُلوقنا",23,"ن",2,0],["موطنُ الأرض يا جسومُ لكم","ولنا موطنٌ هو الفِطن",24,"ن",1,0],["موطننا حيثما يطيب لنا","وكل أرض عشنا بها رغدا",25,"د",2,0],["موطن الشاعر المحلّق منذ ال","بدء لكن بروحه لا بجسمه",26,"م",2,0],["موطن الأمجاد أضحى","بك للأوطان رائد",27,"د",1,0],["موطناً كان للمعارف بيتا","مثلما كان للشجاعة دارا",28,"ر",2,0],["موطناً لنفسهِ على الردى","وأن يكونَ لإمامهِ فدى",29,"د",2,0],["موطن لا يسحب الريط به","اِنَّما يُسحَبُ في الأَمنِ الازَارُ",30,"ر",1,0],["مُوَطَّا شِفاءٌ والشِّفاءُ كمُسْلِمٍ","إذا مُسْلِماً تُقْرِيه حَقَّاً تصدَّرَا.",31,"ر",2,0],["موطن الملك والخلافة والمج","د علته غضاضةٌ وامتهان",32,"ن",1,0],["مَوطِنُهم هِستيَةُ الأَبانِتَه","والبلدِ المعمورِ في دِيومِ",33,"م",1,0],["موطن حل فيه خير نبيّ","متحل بأشرف الأسماء",34,"ا",2,0],["موطن حلّ فيه خير البرايا","من حباه الاله نصرا وفتحا",35,"ح",2,0],["موطن فيه ثوى الهادى الذى","قد حوى الفضل وساد العربا",36,"ب",2,0],["موطدةٌ مبانيها بزاكي","زَكيُّ القِنس زاد الأس رصفا",37,"ف",2,0],["مَوطِنٌ مِن عَهدِ لُقمانَ عادٍ","دونَهُ مِن قُلَلِ الحَزنِ تَلُّ",38,"ل",1,0],["موطنهُ العالمُ أَجمعهُ","وَدينهُ السلامُ لا الفتنُ",39,"ن",1,0],["مُوطأ الأكناف رطب الجَنى","مقدّم السبق مُعلّى القداح",40,"ح",1,0],["مَوطِنِي.. لَكَأنَّ حُزنَكَ غَيمَةٌ","سَودَاءُ تَجلِسُ دَاخِلِي وتَقُومُ",41,"م",1,1],["موطن اليُمْن والأصالةِ يذوي","والأسى فيه يستبيح الصدورا",42,"ر",2,1],["موطِني أنتِ وانتمائِي وذاتي","واصطِفائِي من \"الكريمِ تعالى \"",43,"ل",2,0],["موطنُ العزِ والإباء","موطنٌ اسمه اليمنْ",44,"ن",1,0],["موطنُ الحبِ والسلام","صار بالشرِ ممتحنْ",44,"ن",1,0],["موطن العز قد علوت فخارا","وتساميت راية وشعارا",45,"ر",2,1],["موطن النور والرسالة والوح","ي ومن ذا في مجده يتمارى",45,"ر",2,0],["موطن العلم والدعاة ومهد ال","عدل لما غدا عليك دثارا",45,"ر",2,0],["موطن الطهر والهدى يا ملاذا","لبنيه وحكمة لا تجارى",45,"ر",2,0],["موطن الحفظ للجوار إذا ماال","جار في داهم المصاب استجارا",45,"ر",2,0],["موطن الحزم والشجاعة إن جا","ر الذي جار أو أساء الجوارا",45,"ر",2,0],["موطن العزم والبطولة لما","ظلت صرحا عليه نوقد نارا",45,"ر",2,0],["موطن العشق إن سرى فيك خل","يترع القلب في جنون السهارى",45,"ر",2,0],["موطن الأمن والأمان ومأوى","لشريد في الدرب عانى انكسارا",45,"ر",2,0],["موطن البذل والعطاء إذا ش","ح الغني وفي الجحود توارى",45,"ر",2,0],["موطن الخير والنماء نعيش ال","عمر دوما في عشقه نتبارى",45,"ر",2,0],["موطني خذني فدائياً فقد","ضَيَّعَ الباغين فيك الاشتباه",46,"ا",2,0],["موطني خذني فمادمت أبي","عَزَ في الأهوال من عَزَ أباه",46,"ا",2,0],["موطني ما غاب عني","زادَ من شوقي وحزني",47,"ن",2,0],["موطني حبي حياتي","نوره بين الحشايا",48,"ا",3,0],["موطن الروح كم قطعت الليالي","مُلهب الجفن دامعا بتشكِّ",49,"ك",1,0],["موطن كان منه أصل هدى الخلق","وفيه ابتدا الهدى بالظهور",50,"ر",1,0],["موطن من أسرى به ربه","إليه وأئتم به المرسلون",51,"ن",1,0],["موطني المطمئن عش مطمئنا","وتصدَّر عرش العلا وتهنا",52,"ن",2,1],["موطنَ العُربِ والصمودِ أقلني","من جدالٍ في عُربنا أو سجال",53,"ل",1,0],["مَوطنٌ أعطاكَ حُبَّاً .. وَسَمَا","بِكَ .. حتىٰ غَمَرَتكَ المِنَنُ",54,"ن",1,0],["موطني موطني سقتك الغوادي","والغوادي رواؤهن عميم",55,"م",1,0],["موطن يلقاك بالنعما فهل","تُحمد النعماء في كفر وسب",56,"ب",1,0],["موطني، ما رشفت وِرْدكَ إلا","عاد عنه فمي بحُرقةِ صادِ",57,"د",1,0]]}