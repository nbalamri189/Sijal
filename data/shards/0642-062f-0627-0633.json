َحيَتِ السُمرُ مِن طَعنِهِم","فَكادَت لِإِفراطِهِ تَحتَشِم",0,"م",1,0],["قَدْ أَسَرْتُمْ قَلْبِي فَهَلْ مِنْ فِدَاء","واشْتَرَيْتُمْ نَفْسِي فَهَلْ مِنْ إِقَالَهْ",1,"ل",2,0],["قَدِ اِستَعصى عَلى الحُكَماءِ مِنّا","كَما اِستَعصى عَلى الطِبِّ الجُذامُ",2,"م",1,0],["قد استعانَ بجاهي في تِجارَتِه","وباتَ باسمِ أبي حَفصٍ يُنَميِّها",3,"ي",3,0],["قَد أَسعَدَتني بَعدَ فَقدِكَ أَدمُعٌ","ذُرُفٌ وَخامَ الصَبرُ عَن إِسعادي",4,"د",2,0],["قَدِ اِستَوفَتِ النَعماءُ فيكَ تَمامَها","عَلَينا فَمِنّا الحَمدُ لِلَّهِ وَالشُكرُ",5,"ر",1,0],["قَدِ اِستَوفَتِ النَعماءُ فيكُم تَمامَها","عَلَينا فَمِنّا الحَمدُ لِلَّهِ وَالشُكرُ",6,"ر",1,0],["قَد اِستَبدَلَت بِالحِلمِ جَهلاً وَراجَعَت","وُثوباً شَديداً بِعدَ وَثبٍ مُبادِرِ",7,"ر",1,0],["قد استمّرا قروناً من حَنانهما","على الجزيرة في خَفق ومضطرب",8,"ب",1,0],["قد استأثروا بالحكم وارتزقوا به","وسَدُّوا على مَن حولهم منبع الرزق",9,"ق",1,0],["قد استَوْ ضحوه الأمر والأمر واضح","فأعياه إيضاح الحقيقة فاستعفى",10,"ف",2,0],["قد اسْتَحْوَذَت يا لَلخسار عليكم","شياطين إنْس صال فيكم مرَيدها",11,"د",3,0],["قد اسرجَ الحسن خدَّيه فدونكَ ذا","سراج خدٍّ على الأكباد وهَّاج",12,"ج",1,0],["قد أسرجت وعدت للهمّ ملجمة","فهي الكميت بإسراجٍ وإلجام",13,"م",1,0],["قد أسرج الشيب في فودي وألجمني","عما أعانيه من نقضٍ وإبرام",14,"م",1,1],["قَد أَسكَنَت أُكُرُ الرَصاصِ جُفونَهُ","فَكَأَنَّ أَكباداً تُجِنُّ غَليلا",15,"ل",2,0],["قَدْ أَسكَتَتْها لوعَةُ","الرُّوحِ الحزينِ الوَاجمهْ",16,"ه",1,0],["قد استطارت تبتغي","لنفسها أن تعلنا",17,"ن",2,0],["قد أسمعتكَ أنينها الأوطان","بضعيف صوت ملؤه الأشجانُ",18,"ن",1,1],["قد استودعوا التابوت شخصك ثم قد","طووا ذلك التابوت في باطن الترب",19,"ب",1,0],["قد أسرفوا في حكمهم وتعسفوا","ما شاء ذلكمو العميد وشاءوا",20,"ا",1,0],["قَد أَسقَطَ الطَفرَةَ في مُلكِهِ","مَن لَيسَ بِالعاجِزِ عَن قَلبِهِ",21,"ب",2,0],["قَدِ اِستَراحَت إِلى وَقتٍ رِقابُهُمُ","مِنَ السُيوفِ وَباقي القَومِ يَنتَظِرُ",22,"ر",1,0],["قِدِ اِستَقصَيتَ في سَلبِ الأَعادي","فَرُدَّ لَهُم مِنَ السَلبِ الهُجوعا",23,"ع",2,0],["قَدِ اِستَشفَيتَ مِن داءٍ بِداءٍ","وَأَقتَلُ ما أَعَلَّكَ ما شَفاكا",24,"ك",2,0],["قَد أَسخَطَ اللَهَ بِإِعزازِهِ ال","دُنيا وَأَرضاها بِإِذلالِهِ",25,"ل",2,0],["قَدِ اِستَبطَأَت مِنّي نَوارُ صَريمَتي","وَقَد كانَ هَمّي يَنفُذُ القَلبَ داخِلُه",26,"ل",2,0],["قَدِ اِستَبطَأتُ ناجِيَةً ذَمولاً","وَإِنَّ الهَمَّ بي فيها لَسامي",27,"م",2,0],["قَد أَسعَدَ اللَهُ امرَأً","أَرضاهُ مِنهُ بِقِسمِهِ",28,"م",2,0],["قَدِ اِستَبشَرَت مِنكَ اللَيالي وَإِنَّما","بَشاشَتُها في غَيرِكُم لِلتَمَلُّقِ",29,"ق",1,0],["قَد أَسكَرَت خَمرُ الصِبا عِطفَهُ","فَمادَ في بُردَيهِ مَخمورا",30,"ر",2,0],["قَد أَسبَلَ الظَلماءَ سِتراً دونَهُ","وَخلا بِأَبكارٍ مِنَ الأَفكارِ",31,"ر",1,0],["قَدَ اِسلَمَها الباكونَ إِلّا حَمامَةً","مُطَوَّقَةً بانَت وَبانَ قَرينُها",32,"ن",3,0],["قَد أَسكَرَ النُدمان","بِاللَحظِ وَالكاسِ وَالمِبسَم",33,"م",1,0],["قَدِ اِستَوى الناسُ وَماتَ الكَمال","وَنادَتِ الأَيّامُ أَينَ الرِجال",34,"ل",1,1],["قَد أَسحَبُ الزِقُّ يَأباني وَأُكرِهُهُ","حَتّى لَهُ في أَديمِ الأَرضِ أُخدودُ",35,"د",1,1],["قَد أَسبِقُ الجارِيَةَ الجونا","مِن قَبلِ تَثويبِ المُنادينا",36,"ن",2,1],["قَد أَسَأنا كُلَّ الإِساءَةِ فَاللَ","هُمَّ صَفحاً عَنّا وَغُفراً وَعَفوا",37,"و",2,0],["قَد أَسلُبُ المَلِكَ الجَبّارَ حِليَتَهُ","في مَأقِطٍ مِثل خَطِّ السَيفِ مَشهودِ",38,"د",1,0],["قَد أَسرَفَ الإِنسُ في الدَعوى بِجَهلِهِمُ","حَتّى اِدَّعوا أَنَّهُم لِلخَلقِ أَربابُ",39,"ب",1,1],["قَد أَسرَجوا بِكُمَيتٍ أَطلَقَت لُجُماً","وَلَم يَهِمّوا بِإِلجامٍ وَإِسراجِ",40,"ج",1,1],["قَد أَسنَدوا عَن مِثلِهِم ثُمَّ اِعتَلوا","فَنَموا بِإِسنادٍ إِلى الجَبّارِ",41,"ر",1,0],["قَد أَسلَمَ الرَجُلُ النُصرانُ مُرتَغَباً","وَلَيسَ ذَلِكَ مِن حُبٍّ لِإِسلامِ",42,"م",1,0],["قَدِ اِستَخفَيتُ كَالجَسدِ المُواري","وَلَكِنَّ الطَوارِقَ تَختَفيني",43,"ن",2,0],["قد أسأتُ التعبير فالله ربي","ما له في كل الوجود نظير",44,"ر",1,0],["قد استمروا وَنار الحرب موقدة","يكافحون وَلَم يأَخذهمُ السأم",45,"م",1,0],["قد استَسهَلوا نَفي امرئٍ وليسألوا","فؤادي عَن الهم الَّذي أَتجرَّع",46,"ع",1,0],["قد اِستَطاب فوق صد","رها الهوى رقاده",47,"ه",1,1],["قد اسودَّ ليلي بالسحاب فَلا أَرى","طَريقي به إلا إذا أَومض البرق",48,"ق",1,0],["قد استصرخت أم ربيت بحجرها","وإنك عنها غافل لست تسأل",49,"ل",1,0],["قَد اسود لَيل الظلم حتى كأَنَّه","ستار عَلى الأرض الفضاء سَديل",50,"ل",1,0],["قد استراحت إلى وقتٍ رقابهم","من السّيوف وباقي النّاس ينتظر",51,"ر",1,0],["قد استبدّتْ به حتى استبدّ به","عادي الرّدى وهو لا واهٍ ولا واني",52,"ن",2,0],["قد اسْتَحْيَيْتُ منكَ فلا تَكِلْني","إلى شيْءٍ سِوى عُذْرٍ جَميل",53,"ل",1,0],["قَدِ اِستَوَت في التَناهي","طوالُها وَالقِصارُ",54,"ر",1,0],["قَد أَسا جُرحي وَفارَقَني","فَاِندَمى الجُرحُ الَّذي اِندَمَلا",55,"ل",2,0],["قد أسفرتْ عن صُبْحِ يومٍ باسمٍ","برّاق سافرةِ المُنَى لمَاحها",56,"ح",3,0],["قد أسْكَر القومَ نصرٌ زائفٌ ظفروا","به، فلا تَعْذِلوا من بات مخمورًا",57,"ر",2,0],["قد استباحوا حرمان دينكم","ومنعوا الأرض الحياة والحبا",58,"ا",1,0],["قد استردّ السبايا كلّ منهزم","لم تبق في رقّها إلاّ سبايانا",59,"ن",2,0],["قد استباحوا حرمات دينكم","ومنعوا الأرض الحياة والحيا",60,"ا",1,0],["قد استحوذتْ يا للخسار عليكم","شياطينُ إنس صال منكم مَريدها",61,"د",3,0],["قَد أَسكَنتُهُ بَعد ما وطيء السُها","جَدثاً فَأَمسى فيهِ وَهُوَ رَهين",62,"ن",1,0],["قد اسلت العيون فيك عيونا","ولطحن القلوب دارت رحاكا",63,"ك",2,0],["قد أسعفنه يد الحظ العظيم من ال","عهد القديم بإحسان ووصلان",64,"ن",1,0],["قد استوت فوق عرش الوهم حاكمةٌ","مثل المقادير في منح وإكداء",65,"ا",2,0],["قد استوت نشوتي فيه وواحدة","من نوعها في مغاني بنت داوود",66,"د",1,0],["قد استحوذَ الشيطان جهلا عليهمُ","فأنساهُمُ ذكرَ القيامةِ والنشْرِ",67,"ر",1,0],["قد استسلمت مُهجتي للوُعود","فظلَّت بخِدرِ الرُؤى لن تعود",68,"د",1,0],["قد استوى الهجو والاطراء منه فكم","سب الفويسقُ من ذى عفة وعُلا",69,"ل",2,0],["قَد استَبَدُّوا بِمَيدَانِ المَفَاخِرِ ما","حَازَ الحِجَا مَن يُجَارِيهُم بِمَيدَانِ",70,"ن",1,0],["قَد استَولَى على الميدانِ فِيهِ","وللأبنَاءِ قَد نَفَضَ العِيَابَا",71,"ب",2,0],["قَد أَسمَعَت هَذي الظُبى مَن لا يَرى","آثارَها وَأَرَينَ مَن لا يَسمَعُ",72,"ع",1,0],["قَدِ اِستَحكَمت في أَضلُعي لَوعَةُ الصَدى","فَعُذراً فَإِنّي عَن صَبوحٍ أُرَقِّقُ",73,"ق",1,0],["قد أسرفت في بخس حظي ثم لم","تقنع بنحس الحظ وا