{"poems":[[55,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[64,"أجيرتنا بالجزع كيف خلصتم","https://www.aldiwan.net/poem52262.html","الطويل"],[47,"هل الفتح إلا البدر في الأفق المضحى","https://www.aldiwan.net/poem62690.html","الطويل"],[63,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[33,"إني ومن أحرم الحجيج له","https://www.aldiwan.net/poem41281.html","المنسرح"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[83,"سل عن سهادي وعن سقمي وعن جلدي","https://www.aldiwan.net/poem61364.html","البسيط"],[77,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"أريد ليان العيش في دار شقوة","https://www.aldiwan.net/poem23499.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[108,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[154,"أطع مولاك تظفر بالنجاح","https://www.aldiwan.net/poem68533.html","الوافر"],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[193,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[242,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[333,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[358,"ألا هل لقلب عنك قد فقد الصبرا","https://www.aldiwan.net/poem40238.html","الطويل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[371,"لمن والليالي غير معتبة الفتى","https://www.aldiwan.net/poem17742.html","الطويل"],[408,"رميت أسهم آمالي فلم تصب","https://www.aldiwan.net/poem46936.html","البسيط"],[412,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[415,"بنو منقذ ما أنقذوا من زمانهم","https://www.aldiwan.net/poem31690.html","عموديه"],[454,"لبيك يا منقذ الفصحى","https://www.aldiwan.net/poem986.html",""],[458,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[458,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[505,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[520,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[572,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2479","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48864","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122303","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96681","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[543,"","https://poetry.dctabudhabi.ae/diwan/poem/124975",""],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132878","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50014","البسيط"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45380","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109003","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33894","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93908","المجتث"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100415","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202847","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132571","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126929","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205610","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205678","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34603","الهزج"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114455","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114485","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40124","الوافر"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130525","السريع"],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4869,"الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=139687",""],[4869,"هم يحسبون الشاعر يدور احضان","https://www.poetsgate.com/ViewPoem.aspx?id=151639",""],[4980,"خَلَعتُ ثِيَابَ الصَّبرِ","https://www.poetsgate.com/ViewPoem.aspx?id=190630",""],[5277,"وطن الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=189276",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[5533,"الفَجْرُ قادِم","https://www.poetsgate.com/ViewPoem.aspx?id=176644",""],[5736,"السم في العسل","https://www.poetsgate.com/ViewPoem.aspx?id=211832",""],[5781,"مولودةٌ على شفاهٍ مجرّحة","https://www.poetsgate.com/ViewPoem.aspx?id=208985",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6225,"العُذر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81107&r=&rc=301",""],[6259,"أبا الفضل طال الليل أم خانني صبري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59424&r=&rc=72",""],[454,"لبّيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82670&r=&rc=34",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["وَما اِقتَعَدَ العُلى إِلّا شُجاعٌ","وَلا بَلَغَ المُنى إِلّا كَريمُ",0,"م",1,0],["وما أقَلْتَ أبا سُفيانَ حين طَوى","عَنكَ الهديةَ مُعَتّزاً بمُهديها",1,"ي",3,0],["وما اقتسم الأنفال إلا ممدِّحٌ","ملاها بأعراف المطهَّمةِ الجُرْدِ",2,"د",1,0],["وما أقُرّضُ نفسي كي أدلِّسَها","ولا أريغ لديك الحظَّ بالحيلِ",3,"ل",1,0],["وما اقتسمتْ شتّى الفضائل واحداً","فكاد من التقصير فيهنَّ يسلمُ",4,"م",1,0],["وما اقتسمَ العُشَّاقُ مُذْ صِرْتُ فيهِمُ","سوى سُؤْرِ وجدي والبقيَّةِ من حزني",5,"ن",2,0],["وَما أُقفِلَت عَنّا جَوانِبُ مَطلَبٍ","نُحاوِلُهُ إِلّا افتَتَحناهُ بِالفَتحِ",6,"ح",1,0],["وما أقولُ لِمَن طابَتْ عناصرُه","في رُتْبَةِ المجدِ وابيضَّتْ مَناسبُه",7,"ب",2,0],["وَما أَقَرَّ الظِباءَ بِالبَيتِ وَال","وُرقَ إِذا ما دَعَت عَلى فَنَنِ",8,"ن",1,0],["وَمًا أقُولُ أغُضُّ الطَّرفَ بَعدَكُمُ","حَتَّى أرَاكُم بِهِ كالشَّمسِ في الحَمَلِ",9,"ل",1,0],["وَمَا أقَاسِي مِنَ الأشجَانِ وَالألَمِ","مِن خَفقِ قَلبِي فَهَا يَدِي على كبِدِي",10,"د",2,0],["وما اقتادت الدنيا رجائي ودونها","أكُفُّ الرّجالِ اللاوياتُ المواعك",11,"ك",1,0],["وَما اِقتَتَلَ الحَيّانِ إِلّا سَفاهَةً","وَلَو صَحَّ وُدّي لِلمُحارِبِ حَيّاني",12,"ن",2,0],["وما أَقبلتَ إِلّا بعدَ ما قَدْ","سَقَيتَ الثَغْرَ مِن ثُغَر الأعادِي",13,"د",2,0],["وما أقبَحَ الأرضَ أرضَ الحمَى","إذا داسها غاصبٌ بالقَدَمْ!",14,"م",1,0],["وما أقَبحَ الجوَّ إن شَمَّ منه","عدوُّ البلاد رقيقَ النَّسَمْ!",14,"م",1,0],["وما أقل الذي أبغى وأيسره","لو كنت تنصف إن الحق عريان",15,"ن",1,0],["وَما إِقدامُ قُطرُمُشٍ مُعادٌ","وَلا عُمرٌ لَهُ عُمرٌ جَديدُ",16,"د",1,0],["وما اقترحا سواك وكلُّ نفس","تصرّفُ في اشتهاء واقتراح",17,"ح",1,0],["وما أقدر البارى على نصر نفسه","ولكنه يبلى اختياراً لمن يبلى",18,"ل",2,0],["وَما اِقترفوا فيه سفاحاً محرّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",19,"م",2,0],["وَمَا اَقْتَرَفْنَا بِبَطَالتَنِاَ","وَلَهْوِنَا بِالْجَهْرِ وَالْخُفْيَهْ",20,"ي",2,0],["وما أقلّكَ تذكيراً ومنفعةً","لأمةٍ بُليت بالعقمِ والوَرَم",21,"م",1,0],["وما أقسى حياتينا","على الفقر وأشقاها",22,"ه",2,0],["وَما أَقصرَ الآمال فيما لَدى الفَتى","طوالا وَلَحظ الدَهر يرمقه شَذرا",23,"ر",2,0],["وَما أَقولُ بَلَغتُم فَوقَ غايَتِها","هَذِي البِدايَةُ وَالغاياتُ تُرتَقَبُ",24,"ب",1,0],["وَما أَقبَلوا عِلماً بِما قالَ قاطِفٌ","وَلا أَعرَضوا عِلماً بِما قالَ حاطِبُ",25,"ب",1,0],["وما أقولُ لِمنْ قد جاء يسألني","عنكم ومثلي لا يَصبْوا إلى الكذبَ",26,"ب",1,0],["وَما اقتَضتِ الأَيّام إِلّا هِباتها","فألّا اقتَضتها قَبلَ أَن مَلأتَ صَدري",27,"ر",2,0],["وما أقفرت من ساكن بل من العلى","ومن نائل هامي السحاب غزير",28,"ر",1,0],["وما أقارن نفسي بالذين مضو","مهما سموت فليس النهر كالثمد",29,"د",1,0],["وما أقول وداعا بل أقول وعلى","في موطن الشمس ناجاني وناداني",30,"ن",2,0],["وما أقل صحابي في خمائلها","ماتوا على الجمر أو عاشوا على الحذر",31,"ر",1,0],["وما أقول البحارُ غاضت بأي","ديكم وحالت طبائعُ الدِّيَمِ",32,"م",1,0],["وما اقترحت سوى أن ترتضيها","وأن تحنو عليها من صَداقِ",33,"ق",1,0],["وما أقصرتنا من بني الغي عصبةٌ","بوسواسها إلا الإله أطالنا",34,"ن",2,0],["وما أقيم لنفسي حسن معذرة","أنا المسيء الذي ضلت مقاصده",35,"د",2,0],["وَمَا أَقَرُّوا عَلَى غِلِّ الصُّدُورِ لَهُ","بِذَاكَ حَتَّى رَأَوْا أَنْ لَمْ يَرَوْا مِثْلَهْ",36,"ل",2,0],["وَما أَقبَلُ نُصحَ النا","صِحي مِن شِدَّةِ الكَربِ",37,"ب",1,0],["وما أقول وفي برئي غداً أملٌ","حسبي من العمر ذكرى أمس والأثر",38,"ر",1,0],["وما أقول إذا ما جئت امدح من","جبريل خادمه واللّه مادحه",39,"ح",2,0],["وَما اِقتنعت منّي صروف الردى بما","أَصابت وهل من بعد ذلك مقنعُ",40,"ع",1,0],["وَمَا أَقَرَّ النَزْوَ حَتَّى اسْتَوْدَقا","لِلصُّلْحِ مِنْ صَقْعٍ وَطَعْن أَبْخَقا",41,"ق",2,0],["وما اقتَفَتِ الأشبالُ إلا أُسودها","فدُم لهمَا فَخراً ودُم لهُما ذُخرا",42,"ر",2,0],["وما أُقيمُ بدارٍ لا أعزُّ بها","ولا يقرُّ قراري حيثُ أُبتذَلُ",43,"ل",1,1],["وما أقَام قنا العَلْياء من أَوَدٍ","إلاّ اعوجاجُ قنا الخَطيّة الذُّبلِ",44,"ل",1,0],["وَما أَقالَت ذَوي الهَيئاتِ مِن يَمَنٍ","وَلا أَجارَت ذَوي الغاياتِ مِن مُضَرِ",45,"ر",1,0],["وما اقتنى بفعال الخير سابغةً","لا يهمل اللَه مخلوقاً تردّاها",46,"ا",3,0],["وَما أَقبَح الاعجابَ في المَرء وَالهَوى","وَأَحسَنُ مِنهُ القَول لَولا المُجاوب",47,"ب",1,0],["وَما أَقصَرَ اِسمَ الحُبِّ يا وَيحَ ذا الحُبِّ","وَأَطوَلَ بَلواهُ عَلى العاشِقِ الصَبِّ",48,"ب",1,1],["وما اقتناه شبابي","قد أتلفته العجوز",49,"ز",1,0],["وما اقسى ضمائرنا عليه","وقد رَّقت وكان ارقُّ لينا",50,"ن",2,0],["وما أقول سوى شيء أحسّ به","ولا يشكّكني من راح ينقده",51,"د",2,0],["وَما أَقمت عَلى الخيرات محتسباً","وَما استقمت فَما قَولي لَك استقم",52,"م",1,0],["وما اقتنص الاعداء منا سوى الذي","يشذّ فيغدوا ضاحياً متفردا",53,"د",2,0],["وما أقول بمدحي في مليك علا","بتاج خير الورى آبائه اعتصبا",54,"ب",2,0],["وما أقعدت لي ظلمة السجن عزمة","فما كل ليل حين يغشاك مرقدُ",55,"د",1,0],["وما اقترحتْ إلَّا كما اقترح المنى","غنيٌّ على وفر من الوقت والمال",56,"ل",1,0],["وما أقنعني فِعل","كَ يا مُختلق العُذرِ",57,"ر",1,0],["وما أقمتُ له ومنا وإن رجحت","دراتُهُ وهي خِفُّ كلِّ موزونِ",58,"ن",1,0],["وما أقولُ وأنت آخذٌ رسني","وحُكمُ حبِّكَ في أهلِ الهوى ماضِ",59,"ض",1,0],["وما اِقتَسموا ولا عَمدوا بِناهم","بِمَنصِبك القسيميِّ العِمادي",60,"د",2,0],["وما أقاسي من هموم وما","عالجت من رزء المنيات",61,"ت",1,0],["وَمَا اقْتَرَفْتُ مِنْ خَطَايَا غُبْثُ","وَالْفِعْلُ وَالْقَوْلُ ذَمِيمٌ غَثُّ",62,"ث",1,0],["وما أقبلت إلا أتانا بعلمها","مبشرنا يا حبذا ما به أتى",63,"ا",1,0],["وما اقول انا في سطوتك عآلم الغيب","لكنّ عيوني مآ شكت من عمآهآ",64,"ا",3,0],["وما اقول انا الفارس ومرسامي حصان","الحكم بِيد الناس .. وكلٍ ميوله",65,"ل",2,0],["وَمَا أقصدُ الوَدَاعَ تَاللهِ إنَّمَا","حَنِينٌ كَوَى عَينَيَّ عَينَيكِ تُبصِرَا",66,"ر",2,0],["وما أقوى على لقيا حبيبٍ","فكيف أصارع الصعباتِ أمرا",67,"ر",2,0],["وما أقاسيه يمحوه ببسمته","والثغر أجمل ما يلقاه أي حفي",68,"ف",2,0],["وما أقدموا في معركٍ عن شجاعةٍ","فكم ولوا الأدبار واستبشعوا الملقا",69,"ق",2,0],["وما اقترحت وما قد كنت مجترحاً","من الذنوب فإني ذو الخطيات",70,"ت",1,0],["وَمَا أَقَلَّ الذِي طابَتْ سَرِيْرتُهُ","يَمْضِي وَحِيْداً فلا يَحْمِيهِ إِنْسَانُ",71,"ن",1,0],["وما أقولُ إذا ما مهجتي نزفتْ","ماءَ الحياةِ ولا دمعًا غزا مقلي",72,"ل",2,0],["وما اقْتَرَفْتُ حصارَ البينِ في وَلِعٍ","ولا تَرفَّقْتُ بالأَحزانِ في حَزِنِ",73,"ن",1,0],["ومَا أقْسَى زَمَانُ الْذُلَّ عَيْبَاً","وإنْ صَاحَتْ بِنَا الْأيَّامُ هَوْنَا",74,"ن",2,0],["وما اقترفت يداي من المعاصي","كبائرها ومن لمم زهيد",75,"د",1,0],["وما أقاموا على غلوائهم ثقًة","بأنها مِنَّة ٌ يحتاجُها الزمنُ",76,"ن",1,0],["وما اقتضت الأيامُ إلا هباتها","فهلا اقتضتها قبل أن ملأت صدري",77,"ر",2,0],["وما أقارن نفسي بالذين مضوا","مهما سموت فليس النهر كالثمد",78,"د",1,0],["وما أقلّوا على غلّ الصّدورِ لهُ","بذاكَ حتّى رأوا أنْ لَمْ يروا مِثْلَهْ",79,"ل",2,0]]}