{"poems":[[53,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[62,"أجيرتنا بالجزع كيف خلصتم","https://www.aldiwan.net/poem52262.html","الطويل"],[45,"هل الفتح إلا البدر في الأفق المضحى","https://www.aldiwan.net/poem62690.html","الطويل"],[61,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[31,"إني ومن أحرم الحجيج له","https://www.aldiwan.net/poem41281.html","المنسرح"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[81,"سل عن سهادي وعن سقمي وعن جلدي","https://www.aldiwan.net/poem61364.html","البسيط"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[46,"أريد ليان العيش في دار شقوة","https://www.aldiwan.net/poem23499.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[121,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[151,"أطع مولاك تظفر بالنجاح","https://www.aldiwan.net/poem68533.html","الوافر"],[161,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[190,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[238,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[271,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[329,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[354,"ألا هل لقلب عنك قد فقد الصبرا","https://www.aldiwan.net/poem40238.html","الطويل"],[367,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[367,"لمن والليالي غير معتبة الفتى","https://www.aldiwan.net/poem17742.html","الطويل"],[403,"رميت أسهم آمالي فلم تصب","https://www.aldiwan.net/poem46936.html","البسيط"],[407,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[410,"بنو منقذ ما أنقذوا من زمانهم","https://www.aldiwan.net/poem31690.html","عموديه"],[450,"لبيك يا منقذ الفصحى","https://www.aldiwan.net/poem986.html",""],[454,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[454,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[459,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[459,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[501,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[516,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[568,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"]],"verses":[["وَما اِقتَعَدَ العُلى إِلّا شُجاعٌ","وَلا بَلَغَ المُنى إِلّا كَريمُ",0,"م",1,0],["وما أقَلْتَ أبا سُفيانَ حين طَوى","عَنكَ الهديةَ مُعَتّزاً بمُهديها",1,"ي",3,0],["وما اقتسم الأنفال إلا ممدِّحٌ","ملاها بأعراف المطهَّمةِ الجُرْدِ",2,"د",1,0],["وما أقُرّضُ نفسي كي أدلِّسَها","ولا أريغ لديك الحظَّ بالحيلِ",3,"ل",1,0],["وما اقتسمتْ شتّى الفضائل واحداً","فكاد من التقصير فيهنَّ يسلمُ",4,"م",1,0],["وما اقتسمَ العُشَّاقُ مُذْ صِرْتُ فيهِمُ","سوى سُؤْرِ وجدي والبقيَّةِ من حزني",5,"ن",2,0],["وَما أُقفِلَت عَنّا جَوانِبُ مَطلَبٍ","نُحاوِلُهُ إِلّا افتَتَحناهُ بِالفَتحِ",6,"ح",1,0],["وما أقولُ لِمَن طابَتْ عناصرُه","في رُتْبَةِ المجدِ وابيضَّتْ مَناسبُه",7,"ب",2,0],["وَما أَقَرَّ الظِباءَ بِالبَيتِ وَال","وُرقَ إِذا ما دَعَت عَلى فَنَنِ",8,"ن",1,0],["وَمًا أقُولُ أغُضُّ الطَّرفَ بَعدَكُمُ","حَتَّى أرَاكُم بِهِ كالشَّمسِ في الحَمَلِ",9,"ل",1,0],["وَمَا أقَاسِي مِنَ الأشجَانِ وَالألَمِ","مِن خَفقِ قَلبِي فَهَا يَدِي على كبِدِي",10,"د",2,0],["وما اقتادت الدنيا رجائي ودونها","أكُفُّ الرّجالِ اللاوياتُ المواعك",11,"ك",1,0],["وَما اِقتَتَلَ الحَيّانِ إِلّا سَفاهَةً","وَلَو صَحَّ وُدّي لِلمُحارِبِ حَيّاني",12,"ن",2,0],["وما أَقبلتَ إِلّا بعدَ ما قَدْ","سَقَيتَ الثَغْرَ مِن ثُغَر الأعادِي",13,"د",2,0],["وما أقبَحَ الأرضَ أرضَ الحمَى","إذا داسها غاصبٌ بالقَدَمْ!",14,"م",1,0],["وما أقَبحَ الجوَّ إن شَمَّ منه","عدوُّ البلاد رقيقَ النَّسَمْ!",14,"م",1,0],["وما أقل الذي أبغى وأيسره","لو كنت تنصف إن الحق عريان",15,"ن",1,0],["وَما إِقدامُ قُطرُمُشٍ مُعادٌ","وَلا عُمرٌ لَهُ عُمرٌ جَديدُ",16,"د",1,0],["وما اقترحا سواك وكلُّ نفس","تصرّفُ في اشتهاء واقتراح",17,"ح",1,0],["وما أقدر البارى على نصر نفسه","ولكنه يبلى اختياراً لمن يبلى",18,"ل",2,0],["وَما اِقترفوا فيه سفاحاً محرّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",19,"م",2,0],["وَمَا اَقْتَرَفْنَا بِبَطَالتَنِاَ","وَلَهْوِنَا بِالْجَهْرِ وَالْخُفْيَهْ",20,"ي",2,0],["وما أقلّكَ تذكيراً ومنفعةً","لأمةٍ بُليت بالعقمِ والوَرَم",21,"م",1,0],["وما أقسى حياتينا","على الفقر وأشقاها",22,"ه",2,0],["وَما أَقصرَ الآمال فيما لَدى الفَتى","طوالا وَلَحظ الدَهر يرمقه شَذرا",23,"ر",2,0],["وَما أَقولُ بَلَغتُم فَوقَ غايَتِها","هَذِي البِدايَةُ وَالغاياتُ تُرتَقَبُ",24,"ب",1,0],["وَما أَقبَلوا عِلماً بِما قالَ قاطِفٌ","وَلا أَعرَضوا عِلماً بِما قالَ حاطِبُ",25,"ب",1,0],["وما أقولُ لِمنْ قد جاء يسألني","عنكم ومثلي لا يَصبْوا إلى الكذبَ",26,"ب",1,0],["وَما اقتَضتِ الأَيّام إِلّا هِباتها","فألّا اقتَضتها قَبلَ أَن مَلأتَ صَدري",27,"ر",2,0],["وما أقفرت من ساكن بل من العلى","ومن نائل هامي السحاب غزير",28,"ر",1,0],["وما أقارن نفسي بالذين مضو","مهما سموت فليس النهر كالثمد",29,"د",1,0],["وما أقول وداعا بل أقول وعلى","في موطن الشمس ناجاني وناداني",30,"ن",2,0],["وما أقل صحابي في خمائلها","ماتوا على الجمر أو عاشوا على الحذر",31,"ر",1,0],["وما أقول البحارُ غاضت بأي","ديكم وحالت طبائعُ الدِّيَمِ",32,"م",1,0],["وما اقترحت سوى أن ترتضيها","وأن تحنو عليها من صَداقِ",33,"ق",1,0],["وما أقصرتنا من بني الغي عصبةٌ","بوسواسها إلا الإله أطالنا",34,"ن",2,0],["وما أقيم لنفسي حسن معذرة","أنا المسيء الذي ضلت مقاصده",35,"د",2,0],["وَمَا أَقَرُّوا عَلَى غِلِّ الصُّدُورِ لَهُ","بِذَاكَ حَتَّى رَأَوْا أَنْ لَمْ يَرَوْا مِثْلَهْ",36,"ل",2,0]]}