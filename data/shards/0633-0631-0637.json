{"poems":[[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[435,"لك التهاني بالزواج الحميد","https://www.aldiwan.net/poem40777.html","السريع"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59631","الخفيف"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105879","البسيط"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/76583","السريع"]],"verses":[["سرّ طواه نسيان","والقدّ لدن نشوان",0,"ن",1,0],["سرٌّ طهورٌ جاء تاريخه","اقترن العز بخيرٍ سعيد",1,"د",1,0],["سرَّ طرفي لما حبيتَ بطرفٍ","فاقَ سبقاً وراق وجهاً أغرَّا",2,"ر",2,1],["سرٌّ طوته فصول العام حاسدةً","لِفَضلِهِ إذ لَهُ السُلطانُ والشّانُ",3,"ن",1,0],["سرطانها أسد ويرعى سنبلا","ميزان عقربها لقوس صمت",4,"ت",1,0],["سرطواه الطين فهمّ نشرُه","معنى السجود لآدم تفهيما",5,"م",2,0],["سِرٌّ طَواهُ الحُبُّ فِي مُقلَةٍ","باحَت بِهِ في دِمعِها الهامِلِ",6,"ل",1,0]]}