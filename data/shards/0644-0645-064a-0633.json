ِ",225,"م",1,0],["لم يستطع رد الدموع وتمتمتْ","اجفانه والشوق تحبسه اللمى",226,"م",2,0],["لُمّيْ سِراعَ النَّجْمِ ، ثُمّ تَكَلَّمي","إنّي دَعَوتُكِ يا سَجاحُ لِمُبْرَمِ",227,"م",1,1],["لم يُسْعِدِ الحبُّ قلبا ليلة أحداً","إلا وأتبَعها في الصدر سكّينا",228,"ن",2,0],["لم يسترح أزواجها منها ولن..‏","‎ كم عاث فيهم كيدُها استعبادا ‏‎",229,"د",2,0],["لم يُسِئْ لي مثْلُهُ أيُّ حقودٍ","يتمنى أن أُسَجَّى في اللُّحودِ",230,"د",1,0],["لم يستجبْ رأَسُ الرُّعاة لمطلبي","ما دامتِ الأغنامُ مُلْكَ الأجنبي",231,"ب",2,1],["لم يستطعن الشُّرْبَ غَمَّستُ الشِّفا","هَ بذي المياه صَحَيْنَ بعدَ مَصَارعِ",232,"ع",1,0],["لم يستطيبوا الذل حتى هاجروا","لديارنا وأبي بهم محبورُ",233,"ر",1,0],["لم يستطعْ صرحُ الهناءة ينبني","ما كان إلا رملةَ جرداءا",234,"ا",3,0],["لم يستطع حتى النبي تخلصاً","من هذه الأدران في التبشيرِ",235,"ر",1,0],["لم يَسلَمْ - إنْ تعلمْ- إلا","ما دون شعور كالنعلِ..",236,"ل",1,0],["لم يسلموا من غدر أي منافقٍ","ومكيدةٍ إذْ قاوموا الإلحادا",237,"د",2,0],["لم يستطع مربوطُها أن يعتلي","شبْراً إذا هو خالف المِغضابا",238,"ب",2,0],["لم يستطع هو أن يطوّع عالَماً","متآمراً واغتاله فاْنْبَتّا",239,"ت",2,0],["لم يسألوا عنه وكان أَثيرَهمْ","لم يحفظوا عهداً وطابَ مُعاهِدا..",240,"د",2,0],["لم يستطع إنسٌ ولا جنٌّ لها","درباً ولا حتى الخيال تجَرَّأَ",241,"ا",1,0],["لم يستطع تقليدَ بعضِ وفائها","إلا مُمَثلُ سِينِما ومُنافقُ",242,"ق",1,0],["لَمْ يستَطِعْ دَرْءَ الرَّدَى فَبَكَى","والقَهْرُ أَدمَى القَلبَ بالنَّدَمِ",243,"م",1,0],["لَمْ يَستطِعْ مِنهُ الخروجَ لبُرهَةٍ","فَالبِئرُ أقدَارٌ ، وَخَانَتْهُ يَدُهْ",244,"د",2,0],["لم يسُغْ ضربُهُمْ لما هانَ بالقطْ","ميرِ أمثالُهُمْ ولا بالتَّقْتيرِ",245,"ر",1,0],["لمْ يَسمَعِ النَّهرُ دفقَ المَاءِ منْ حَجَرٍ","لَمَّا تَفَجَّرَ منْ قيظٍ وَ مَا رَمِضَا",246,"ض",2,0],["لَم يسغ للأمين تلقاء حسر","أن يُحل البقا لتلقين ذكر",247,"ر",1,0],["لم يسِلْ – والأنجمُ الزهراءُ نجمٌ","بعد نجمٍ تبتغي – منه الكلامُ",248,"م",1,0]]}