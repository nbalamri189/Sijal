ني مغرم","https://www.poetsgate.com/ViewPoem.aspx?id=200875",""],[5092,"أرص المحال","https://www.poetsgate.com/ViewPoem.aspx?id=161807",""],[5189,"دنيا فانيهْ","https://www.poetsgate.com/ViewPoem.aspx?id=204570",""],[5273,"ماتا على ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=215886",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[5363,"حيِّ الجبين","https://www.poetsgate.com/ViewPoem.aspx?id=144150",""],[5409,"للنفس ذاكرةٌ لا تعرف الكبرا","https://www.poetsgate.com/ViewPoem.aspx?id=155409",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5701,"لاحت على الشاطئ بستانا","https://www.poetsgate.com/ViewPoem.aspx?id=164672",""],[5718,"السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=214026",""],[5725,"همس العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191976",""],[5751,"ليالي سَجاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=214792",""],[5956,"عيونٌ تدري مقاصدنا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182273",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"الهلال الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=183341",""],[5956,"طلب استقالة","https://www.poetsgate.com/ViewPoem.aspx?id=183399",""],[5956,"غَنَمٌ هَرَبْنَ من الحظيرة للشارع","https://www.poetsgate.com/ViewPoem.aspx?id=183499",""],[5956,"هل ذاك حلم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183899",""],[5956,"التعَوُّد ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183923",""],[5956,"لا دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[5956,"الحِسّ الحيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=192121",""],[5956,"حتى المَكيف قد أقام حِدادا","https://www.poetsgate.com/ViewPoem.aspx?id=192400",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[5956,"كبرى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=193514",""],[5956,"نسيَ الجميع صديقهم","https://www.poetsgate.com/ViewPoem.aspx?id=194465",""],[5956,"بنتي رؤى كبلدة سُرَّ مَن رأى","https://www.poetsgate.com/ViewPoem.aspx?id=203445",""],[5956,"أعضاؤها لخدامتي تتسابقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205481",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6019,"ما لي أراني","https://www.poetsgate.com/ViewPoem.aspx?id=176718",""],[6031,"ونواةٍ لو أنَّ كلَّ نَواةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46335",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6225,"محِبٌّ . . وليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80919&r=&rc=188",""]],"verses":[["لَم يُستَمَل بِالذُلِّ جانِبُهُ","مُذ شَدَّ قَبضَتَهُ عَلى النَصلِ",0,"ل",1,0],["لَم يَسلُ هَمُّكَ مِن مالٍ تُفَرِّقُهُ","إِلّا تَعَشَّقَ أَطرافَ الأَنابيبِ",1,"ب",1,0],["لَم يَستَطِع ظاهِرَ الوَداعِ مِنَ ال","عَينِ فَأَوحى السَلامَ مُستَتِرا",2,"ر",2,0],["لَم يَسِر فيهِ مَن يُحاوِلُ أَجراً","عِندَ حَيٍّ مُؤَمَّلٍ أَو يُحابي",3,"ب",2,0],["لَم يَسلُ عَنكِ وَلَو سَلا","لَعَذَرتُهُ فَبِكِ افتَدى",4,"د",2,0],["لم يستجدّوا فيه شيئاً واكتفَوا","في كل حال منه بالسفساف",5,"ف",1,0],["لم يستطع مكترى حمار","فكيف للملك يستطيع",6,"ع",1,0],["لم يُسقَ فوه من الثغور شفاءه","فلوجنتيه من المدامع ساقي",7,"ق",2,0],["لم يسترح من له عين مؤرقة","وكيف يعرف طعم الراحة الأرِقُ",8,"ق",1,0],["لم يسمعوا نصحي لهم وكأنما","كانت على آذانهم اقفالها",9,"ل",3,0],["لم يسمعوا نصحى لهم","حتى اصاب القوم ضر",10,"ر",1,0],["لَم يَسلُكِ الأَرضَ قَومٌ قَبلَهُم سُبُلاً","وَلا الزَواخِرَ أَثباجاً وَشُطّانا",11,"ن",2,0],["لَم يُسلِمِ الكَرُّ في الأَعقابِ مُهجَتَهُ","إِن كانَ أَسلَمَها الأَصحابُ وَالشِيَعُ",12,"ع",1,0],["لم يُسْمَ في صَمَّاءَ مُعْضِلَةٍ","إِلّا تفرَّجَ باسمهِ الكَرْبُ",13,"ب",1,0],["لَم يَسِر ذِكرُ ما أَنالَ وَقَد سا","رَ مِنَ الشِعرِ في البِلادِ قَصيدُه",14,"د",2,0],["لَم يَسمَعوا بِالمَكرُماتِ وَلَم يُنِخ","في دارِهِم ضَيفٌ سِوى إِبليسِ",15,"س",1,0],["لم يسم جفنك جفنا","إلا وفيه حسام",16,"م",1,0],["لم يسر بعد البين وفد رقاده","إلا سرى معه خيالك وافدا",17,"د",2,0],["لم يَسفَحا فيه دماً وكأنَّما","رَشَحا الدماءَ أعالياً وأسافِلا",18,"ل",2,0],["لم يَسْرِ عارِضُه إلى أعدائِه","إلا ليُمطِرَهم دَماً متدفِّقا",19,"ق",2,0],["لم يَسِرْ حَينُهم إليهم ولكِنْ","زَجَروا نحوَه الجِيادَ وسَاروا",20,"ر",3,0],["لَم يَسأَلوا عَن وُلاةِ الجَورِ مَعدَلَةً","وَمِن إِساءَةِ أَهلِ السوءِ إِحسانا",21,"ن",2,0],["لَم يُسَوَّد وَجهُ الوِصالِ بِوَسمٍ ال","حُبِّ حَتّى تَكَشخَنَ العُشّاقُ",22,"ق",1,0],["لَم يُسلِهِ النَأيُ عَنها حينَ باعَدَها","وَلَم يَنَل بِالهَوى مِنها الَّذي طَلَبا",23,"ب",2,0],["لَم يَستَنِم لِلغاصِبينَ وَلم يُرِد","يَوماً عَلى حُكمِ الجُفاةِ نُزولا",24,"ل",2,0],["لَم يَستَدِر رِبابَةٍ وَنَحا","أَصلابَها وَشوَشُ القِرى حَشِدُه",25,"د",2,0],["لَمْ يُساوُوك في عُلاكَ وَقَدْ حا","لَ سناً مِنك دونَهم وسَناءُ",26,"ا",2,0],["لَم يُسقَ أَقطابَ سِقىً","يَشرَبُها في العُلَبِ",27,"ب",1,0],["لَم يَستَريحوا مِن شُرورِ دِيارِهِم","إِلّا بِرِحلَتِهِم إِلى الأَجداثِ",28,"ث",1,0],["لَم يَسقِكُم رَبُّكُم عَن حُسنِ فِعلِكُمُ","وَلا حَماكُم غَماماً سوءُ أَعمالِ",29,"ل",1,1],["لَم يسمع الناس حربا كالَّتي سلفت","في هَولها وَلأرزاء الورى قدمُ",30,"م",1,1],["لَم يستعر مدنيّةً شعبُ","إلا تبدله كَما يَصبو",31,"و",1,1],["لَم يَسلُبوها وَلَم يُعطوا بِها ثَمَناً","أَيدي النِعامِ فَلا أَسقاهُمُ الساقي",32,"ق",2,0],["لَم يَسْرِ فيهِ الطَّرْفُ مَذْهَبَ فِكْرةٍ","مَحْدُودَةٍ إِلَّا تَرَاجَعَ بِالمُنَى",33,"ا",1,0],["لَمْ يَسْتَعِر مِنْ بَاطِلٍ رَوْنَقاً","وَأَلهَمَّ المدَّاحَ بِالصدق",34,"ق",1,0],["لَمْ يَسِرْ بِالأَبِ المُشَيَّعِ شَعبٌ","وَهْوَ بَاكٍ كَمَا بِهِ الشَّعْبُ سَارَا",35,"ر",2,0],["لَمْ يُسَاوِمْ بِهِ فَيَنْعَمَ بَالاً","لاَ وَلَمْ يَرْعَ فِيهِ جَانِبَ آدِي",36,"د",2,0],["لَمْ يَسَعْهُ وَفِي الضَّمِيرِ خِلاَف","أَنْ يَرَى الاِعْتِدَالَ فِي المُنَآدِ",36,"د",1,0],["لَمْ يَسَعْهُ مِنَ البِلاَدِ سِوَى رَوْ","ضِ المَعَالِي وَمَنْبِتِ المَكْرُمَاتِ",37,"ت",1,0],["لَم يَسُؤكَ قَطُّ وَلا","عَنَّ مِثلُ مُدبِرِها",38,"ر",3,0],["لم يَسْمُ للأملاك في أوْجِهَا","ولا هَوَى للوَحْشِ في قَفْرِه",39,"ر",2,0],["لم يستكينوا للزمان ووعدِه","فالدهرُ أكذَبُ من نَبِيِّ سَجاح",40,"ح",1,0],["لم يستظلَّ بمثل عرشك مذ هوَى","عن عرشه فرعونُ ذو الأوتاد",41,"د",1,0],["لم يسعها الخباء بل لم يسعها","فوق ظهر الغبراء أيُّ مكان",42,"ن",1,0],["لم يَسَلْهُ سائلٌ عن معضل","حَيَّر الأَفهام إلاَّ أقنعه",43,"ع",2,0],["لم يُسَجِّل علومَه في كتاب","أو يُدَوِّنْ في مُعْجَمٍ آدابه",44,"ب",2,0],["لم يستكن وتري ولم يسكت فمي","فلتخرس الأفواه والأقلام",45,"م",1,0],["لمْ يَسْمَعُوا بالمَكْرُمَاتِ، وَلمْ يَنُحْ","في دارِهِمْ ضَيْفٌ سِوَى إبلِيسِ",46,"س",1,0],["لمْ يستدرْ في ربابة ٍ، ونحَا","أصْلابَها، وشوشُ القِرَى ، حشدُهْ",47,"د",2,0],["لم يسكن القلب من آلام لوعته","الا مديح ابي العباس مولانا",48,"ن",2,0],["لَم يُسَهِّدهُ مِن أُمَامَ خَيَالٌ","زَائِرٌ مُوهِناً وطَيفٌ مُلِمُّ",49,"م",1,0],["لم يستطعْ إطفاءَها","دمعٌ كما انخرقَ المَزادُ",50,"د",1,0],["لِمَ يستنزلُ الزمانُ جدودى","وهي من عزِّك المنيع بهَضْبِ",51,"ب",1,0],["لم يسألوا عن مقامي في رحالِهمُ","إلا أتيتُ على الأعذارِ والعِللِ",52,"ل",1,0],["لم يستفد منه المنازع في العلا","إلاّ الردى أو أن يرى حسراتهِ",53,"ت",2,0],["لم يسأموا شُربَ الطلا حتى بَدا","للفيلِ في سُمِّ الخياطِ ولوجُ",54,"ج",1,0],["لم يسلم السادات من","ذمّ فمن لك بالسلامه",55,"م",2,0],["لم يستتر من أباح الطرف فرج أخ","بل ليس مستترا من لا تساتره",56,"ر",2,0],["لم يسلَمِ الطفل الرضيع وأمّه","منها وتُردي الشيبَ والشبانا",57,"ن",2,0],["لَم يَسمعِ القلبُ فِيهِ للنّاهي","نَهياً ولا راحَ عنه بالسّاهي",58,"ي",1,1],["لم يسفر البدر عن عينٍ ممرّضة","كما سفرِت ولا عن مبسِم خِصر",59,"ر",1,0],["لم يَسَعِ الدّهرُ حين حلّ به","صُغْرَى عُلاَه فكيف كُبْرَاها",60,"ا",3,0],["لَم يَسكُنِ الأَعداءُ مِن فَرَقٍ بِها","حَتّى سَكَنتَ جَنادِلاً وَرِمالا",61,"ل",2,0],["لم يَسَلْ عمّا أُعاني","من هواني مستطيبُ",62,"ب",1,0],["لَمْ يَسْلُ عَنْ شَوْقٍ إلَيْهِ مِنْبَرٌ","لَم يَخْلُ مِنْ حِرْصٍ عَلَيْهِ مَوْضِعُ",63,"ع",1,0],["لَم يَسمَحِ الدَّهرُ مُذ ألفيتُ فيهِ بِأَن","رَأَيتَني راتِعاً في مَرتَعِ الجَذَلِ",64,"ل",1,0],["لَم يَستَطِع حَملاً لما أَوقَرتَه","فَهوى كَما يَهوي العَظيمُ الراسي",65,"س",2,0],["لَم يسلُ قَلبي عشقَ أَحمَرِ خدِّه","حَتّى أسال لي العذارَ الأَخضرا",66,"ر",2,0],["لَم يستهلّ لَنا مرآك مقتبلاً","حتّى تَكاملتَ بدراً غير مجحودِ",67,"د",1,0],["لَمْ يَسْرِ بَينَهُمُ الخَيالُ لِغَيْرةٍ","هَجَرَتْ مَخَافتَها المَنامَ عُيُونُ",68,"ن",1,1],["لَم يَستَزِر طَيفَهُ لَيلاً سِوى سَهَري","وَلا جِلاهُ عَلى عَيني سِوى فِكَري",69,"ي",1,0],["لم يُسْلِني عنك كرامُ الوَرى","بل زاد كُلُّ بك إذْكاري",70,"ر",2,0],["لَم يَسكُنِ الأَجفانَ إِلّا بَعدَ ما","أَمسى كَرانا ساكِنَ الأَجفانِ",71,"ن",1,0],["لم يسأل الله من جُلى مواهبه","إِلا وكنت له في السؤل أوله",72,"ل",2,0],["لَم يَسقِني أحدٌ فأشكو جَورَهُ","لكِن سُروري بالأميرِ سَقاني",73,"ن",2,1],["لَم يَسأَلِ الأَقوامَ عَن أَمرٍ وَكم","سَأَلوهُ مُدَّرعينَ ثَوبَ تَذّلُّل",74,"ل",1,0],["لم يسأم الخلقُ جدواه مُرَّددة","أو عيده وهو عند اليوم عيدان",75,"ن",1,0],["لم يستشرك لها وظنَّ برأيهِ","خيرا فخابَ عن الشِّيار وخانا",76,"ن",2,0],["لم يسمعوا لمجدكم بمثلها","في سالف الدنيا ولا قُدّامِها",77,"م",3,0],["لم يستعنْ ناصراً عليها ولم","يخجلْ وحيداً فيها ولا احتشما",78,"م",2,0],["لم يُسمِه الملكُ الكمالَ أو رأى","عن عفوه نقصانَ كلِّ مجتهِدْ",79,"د",1,0],["لم يسقها إلاَّ هواك وقدماً","لم يشقها إلاَّ جلالُك بعَلا",80,"ل",2,0],["لم يسع كل حياته","إلا إلى حسن الصنيع",81,"ع",1,0],["لم يستطع بسط كفيه لنائلة","شأن الأبي ونفس الحر لم تهن",82,"ن",1,0],["لم يسألِ الرَّحمَن بالهادي امْرُؤٌ","في ذَنْبِه يَرْجو الرِّضا إِلاَّ غَفَرْ",83,"ر",1,0],["لم يسمك الحُسنُ بيتاً للهوى بحَشاً","إلّا وكان له من فرعِها طُنُبُ",84,"ب",1,0],["لم يستطِعْ وتَراً يلَذُّ له سوى","أوتارِ كلِّ حَنيّةٍ مِرنانِ",85,"ن",1,0],["لم يستووا معه مذ كان في شرف","إلا كما يتساوى الماء والآل",86,"ل",1,0],["لم يستفد عاذلوه بالملام له","فأطلقوا جوده يمشي على رسنه",87,"ن",2,0],["لم يَسكنوا إلّا قِلا","لاً ليس يُرقى مُرتقاها",88,"ا",3,0],["لَم يَسكنوا إلّا القِلالَ وَلَم يُرَوْا","والنَّجم إلّا في رُؤوس هِضابِ",89,"ب",1,0],["لم يسلم الأمر إلى ربه","ولم يشاهد حكمة الحاكم",90,"م",1,0],["لم يستَطِعْ ضَرَراً لشخصكَ فانثَنى","كيداً ومدَّ إلى فَتاتِكَ مِعصَما",91,"م",2,0],["لم يَسْو بينُك ليلتي","نِ بأَلفِ عَامٍ مِنْ وِصَالِكْ",92,"ك",1,0],["لم يستطيعوا الصبر فاندفعوا إلى","ثغر السويس على سريع قطار",93,"ر",1,0],["لم يسدها إلا لمن أضحى على","إرضائه والبر خير مواظب",94,"ب",1,0],["لَم يستقرّ وبات يحرس دارهُ","حتّى تحرّى ما بها مِن أرسمِ",95,"م",1,0],["لَم يُسابِق إلى العُلا جَدُّهُ جَدُّ","كَ قِدماً وَلا أبوهُ أباكا",96,"ك",2,0],["لم يستمد الغيث نائله","لم تلق أرضاً تشتكي محلا",97,"ل",2,0],["لم يستر الشجر الكثيف فرارهم","عنا وإن لاذوا بألفي غاب",98,"ب",1,0],["لم يستطع جرعاً ونورّ ثغره","بالإبتسام وقال يا أم اسمعي",99,"ي",1,0],["لَم يَستَمِلكَ لِشادٍ أَو لِغانِيَة","بَيتٌ مِن الشِعر أَو بَيتٌ مِنَ الشَعَرِ",100,"ر",1,0],["لم يسلني عنهما من بعد بعدهما","مال ملكت ولا أهل ولا وطن",101,"ن",1,0],["لم يسلموه ساعة من أسلموا","وغَدَوْا له ولدينِهِ أنصارَا",102,"ر",2,0],["لم يسمعوا القرآن أول مرة","حتى أجادوا الشرح والتفسيرا",103,"ر",2,0],["لم يسمعوا نصح المشفَّعِ فيهمُ","عند القدير وهم أضل جناة",104,"ه",1,0],["لم يسبقوك وان سبقت بوالد","فكلاكما في الماثرات جواد",105,"د",1,0],["لم يستطع شربه وقد شربت","من دمه المرهفات شرباتِ",106,"ت",1,0],["لم يسمُّوه لا الهلال ولا البد","رَ وسَمَّوْهُ حين سَمَّوْا جُزَافا",107,"ف",2,0],["لَم يَسأَلونِيَ إِلّا عَن وَقائِعِهم","كَالبيعِ وَالرّهنِ وَالتّطليقِ والحِيَلِ",108,"ل",1,0],["لم يستمع قول الحسود وإن أتى","بمشوشات للنفوس الصَّافيهْ",109,"ي",2,0],["لم يُسْلِني عنهم فتى ذو وُدِّ","غير المليك الفيصل المُهَدّي",110,"د",2,0],["لم يسد غلظة ولكن بحق","واجب لم يزل وباستحقاقِ",111,"ق",1,0],["لم يَسعَ سعيكَ في العلا كِسرى ولا","دارا ولا الملكُ المتوّجُ قيصرُ",112,"ر",1,0],["لَم يسقطِ اللوى والمحنا طلل","كأنّه وشم رندٍ لاح أو خللُ",113,"ل",1,1],["لَم يَستملهُ علاكَ في هَذا المَلا","فَأَشاقَهُ ذاكَ العَلاءُ الأَرفَعُ",114,"ع",1,0],["لَم يَستَبح حرم العَقار وَإِنَّما","لَما أَضاءَ لَها سَقَطنَ فراشا",115,"ش",2,0]