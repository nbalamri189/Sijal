{"poems":[[53,"من لي برعبلة من البزل","https://www.aldiwan.net/poem29900.html","الكامل"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[55,"بأنس الحبيب يطيب السمر","https://www.aldiwan.net/poem26323.html","المتقارب"],[86,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[73,"أشمت بي فيك العدا","https://www.aldiwan.net/poem11893.html","مجزوء الكامل"],[88,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[72,"هل لك يا أرفع البرايا","https://www.aldiwan.net/poem19172.html","مخلع البسيط"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"أطبقت للنوم جفنا ليس ينطبق","https://www.aldiwan.net/poem65707.html","البسيط"],[89,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[43,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[45,"قل للأرند إذا أتى الروحين لا","https://www.aldiwan.net/poem64596.html","الكامل"],[61,"دمي عليك حرام","https://www.aldiwan.net/poem51327.html","المجتث"],[61,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[61,"عندي إذا مالروض أصبح ذابلا","https://www.aldiwan.net/poem51487.html","الكامل"],[61,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[66,"قم صاح نلتقط اللذات إن ذهلت","https://www.aldiwan.net/poem39064.html","البسيط"],[44,"يا هلالا غدا عليه المحاق","https://www.aldiwan.net/poem30017.html","الخفيف"],[31,"لم يقض ذو الشجو ممن شفه أربا","https://www.aldiwan.net/poem42634.html","البسيط"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[46,"لما ثوت في الأرض وهي لطيفة","https://www.aldiwan.net/poem22234.html","الكامل"],[46,"لم يسقكم ربكم عن حسن فعلكم","https://www.aldiwan.net/poem23225.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85406","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85362","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9870","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55056","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54908","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[45,"قُلْ للأرَنْدِ، إذا أتَى الرّوحَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=31160",""],[39,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[113,"ان الحبيب الذي باللطف افنانا","https://www.aldiwan.net/poem40461.html","عموديه"],[130,"لم يكن في إدارة الكأس ذم","https://www.aldiwan.net/poem54744.html","الخفيف"],[140,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[140,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[140,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[158,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[164,"ظهرت على قمم البروج ثلوج","https://www.aldiwan.net/poem47108.html","الكامل"],[184,"إن المحسد في النعيم","https://www.aldiwan.net/poem43292.html","مجزوء الكامل"],[184,"يا من تأزر في الحمام مستترا","https://www.aldiwan.net/poem43782.html","الطويل"],[195,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[227,"لم يسمع القلب فيه للناهي","https://www.aldiwan.net/poem50734.html","المنسرح"],[227,"يا أيها القمر المنسوب للبشر","https://www.aldiwan.net/poem51000.html","البسيط"],[227,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[233,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[252,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[273,"جلدا خليلي ما لنفسك تجزع","https://www.aldiwan.net/poem25489.html","الكامل"],[280,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[295,"يا طود مجد في المكارم راس","https://www.aldiwan.net/poem33242.html","الكامل"],[295,"وحياتكم يا ساكني أم القرى","https://www.aldiwan.net/poem33252.html","الكامل"],[303,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[346,"لم يسر بينهم الخيال لغيرة","https://www.aldiwan.net/poem20724.html","الكامل"],[347,"لما دعاني الهوى من ربة الكلل","https://www.aldiwan.net/poem15862.html","البسيط"],[362,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[364,"لا كنتما خلين قد لزماني","https://www.aldiwan.net/poem17290.html","الكامل"],[367,"العبد يهدي إلى المولى ويتحفه","https://www.aldiwan.net/poem4318.html","البسيط"],[369,"لم يسقني أحد فأشكو جوره","https://www.aldiwan.net/poem57017.html","الكامل"],[390,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[451,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[456,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[456,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[456,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[477,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[477,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[498,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[513,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[513,"يا سائلي عن فروض الجود أو سننه","https://www.aldiwan.net/poem12296.html","البسيط"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[556,"علم عظيم النفع للعالم","https://www.aldiwan.net/poem34181.html","السريع"],[560,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[573,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"]],"verses":[["لَم يُستَمَل بِالذُلِّ جانِبُهُ","مُذ شَدَّ قَبضَتَهُ عَلى النَصلِ",0,"ل",1,0],["لَم يَسلُ هَمُّكَ مِن مالٍ تُفَرِّقُهُ","إِلّا تَعَشَّقَ أَطرافَ الأَنابيبِ",1,"ب",1,0],["لَم يَستَطِع ظاهِرَ الوَداعِ مِنَ ال","عَينِ فَأَوحى السَلامَ مُستَتِرا",2,"ر",2,0],["لَم يَسِر فيهِ مَن يُحاوِلُ أَجراً","عِندَ حَيٍّ مُؤَمَّلٍ أَو يُحابي",3,"ب",2,0],["لَم يَسلُ عَنكِ وَلَو سَلا","لَعَذَرتُهُ فَبِكِ افتَدى",4,"د",2,0],["لم يستجدّوا فيه شيئاً واكتفَوا","في كل حال منه بالسفساف",5,"ف",1,0],["لم يستطع مكترى حمار","فكيف للملك يستطيع",6,"ع",1,0],["لم يُسقَ فوه من الثغور شفاءه","فلوجنتيه من المدامع ساقي",7,"ق",2,0],["لم يسترح من له عين مؤرقة","وكيف يعرف طعم الراحة الأرِقُ",8,"ق",1,0],["لم يسمعوا نصحي لهم وكأنما","كانت على آذانهم اقفالها",9,"ل",3,0],["لم يسمعوا نصحى لهم","حتى اصاب القوم ضر",10,"ر",1,0],["لَم يَسلُكِ الأَرضَ قَومٌ قَبلَهُم سُبُلاً","وَلا الزَواخِرَ أَثباجاً وَشُطّانا",11,"ن",2,0],["لَم يُسلِمِ الكَرُّ في الأَعقابِ مُهجَتَهُ","إِن كانَ أَسلَمَها الأَصحابُ وَالشِيَعُ",12,"ع",1,0],["لم يُسْمَ في صَمَّاءَ مُعْضِلَةٍ","إِلّا تفرَّجَ باسمهِ الكَرْبُ",13,"ب",1,0],["لَم يَسِر ذِكرُ ما أَنالَ وَقَد سا","رَ مِنَ الشِعرِ في البِلادِ قَصيدُه",14,"د",2,0],["لَم يَسمَعوا بِالمَكرُماتِ وَلَم يُنِخ","في دارِهِم ضَيفٌ سِوى إِبليسِ",15,"س",1,0],["لم يسم جفنك جفنا","إلا وفيه حسام",16,"م",1,0],["لم يسر بعد البين وفد رقاده","إلا سرى معه خيالك وافدا",17,"د",2,0],["لم يَسفَحا فيه دماً وكأنَّما","رَشَحا الدماءَ أعالياً وأسافِلا",18,"ل",2,0],["لم يَسْرِ عارِضُه إلى أعدائِه","إلا ليُمطِرَهم دَماً متدفِّقا",19,"ق",2,0],["لم يَسِرْ حَينُهم إليهم ولكِنْ","زَجَروا نحوَه الجِيادَ وسَاروا",20,"ر",3,0],["لَم يَسأَلوا عَن وُلاةِ الجَورِ مَعدَلَةً","وَمِن إِساءَةِ أَهلِ السوءِ إِحسانا",21,"ن",2,0],["لَم يُسَوَّد وَجهُ الوِصالِ بِوَسمٍ ال","حُبِّ حَتّى تَكَشخَنَ العُشّاقُ",22,"ق",1,0],["لَم يُسلِهِ النَأيُ عَنها حينَ باعَدَها","وَلَم يَنَل بِالهَوى مِنها الَّذي طَلَبا",23,"ب",2,0],["لَم يَستَنِم لِلغاصِبينَ وَلم يُرِد","يَوماً عَلى حُكمِ الجُفاةِ نُزولا",24,"ل",2,0],["لَم يَستَدِر رِبابَةٍ وَنَحا","أَصلابَها وَشوَشُ القِرى حَشِدُه",25,"د",2,0],["لَمْ يُساوُوك في عُلاكَ وَقَدْ حا","لَ سناً مِنك دونَهم وسَناءُ",26,"ا",2,0],["لَم يُسقَ أَقطابَ سِقىً","يَشرَبُها في العُلَبِ",27,"ب",1,0],["لَم يَستَريحوا مِن شُرورِ دِيارِهِم","إِلّا بِرِحلَتِهِم إِلى الأَجداثِ",28,"ث",1,0],["لَم يَسقِكُم رَبُّكُم عَن حُسنِ فِعلِكُمُ","وَلا حَماكُم غَماماً سوءُ أَعمالِ",29,"ل",1,1],["لَم يسمع الناس حربا كالَّتي سلفت","في هَولها وَلأرزاء الورى قدمُ",30,"م",1,1],["لَم يستعر مدنيّةً شعبُ","إلا تبدله كَما يَصبو",31,"و",1,1],["لَم يَسلُبوها وَلَم يُعطوا بِها ثَمَناً","أَيدي النِعامِ فَلا أَسقاهُمُ الساقي",32,"ي",1,0],["لَم يَسْرِ فيهِ الطَّرْفُ مَذْهَبَ فِكْرةٍ","مَحْدُودَةٍ إِلَّا تَرَاجَعَ بِالمُنَى",33,"ا",1,0],["لَمْ يَسْتَعِر مِنْ بَاطِلٍ رَوْنَقاً","وَأَلهَمَّ المدَّاحَ بِالصدق",34,"ق",1,0],["لَمْ يَسِرْ بِالأَبِ المُشَيَّعِ شَعبٌ","وَهْوَ بَاكٍ كَمَا بِهِ الشَّعْبُ سَارَا",35,"ر",2,0],["لَمْ يُسَاوِمْ بِهِ فَيَنْعَمَ بَالاً","لاَ وَلَمْ يَرْعَ فِيهِ جَانِبَ آدِي",36,"د",2,0],["لَمْ يَسَعْهُ وَفِي الضَّمِيرِ خِلاَف","أَنْ يَرَى الاِعْتِدَالَ فِي المُنَآدِ",36,"د",1,0],["لَمْ يَسَعْهُ مِنَ البِلاَدِ سِوَى رَوْ","ضِ المَعَالِي وَمَنْبِتِ المَكْرُمَاتِ",37,"ت",1,0],["لَم يَسُؤكَ قَطُّ وَلا","عَنَّ مِثلُ مُدبِرِها",38,"ر",3,0],["لم يَسْمُ للأملاك في أوْجِهَا","ولا هَوَى للوَحْشِ في قَفْرِه",39,"ر",2,0],["لم يستكينوا للزمان ووعدِه","فالدهرُ أكذَبُ من نَبِيِّ سَجاح",40,"ح",1,0],["لم يستظلَّ بمثل عرشك مذ هوَى","عن عرشه فرعونُ ذو الأوتاد",41,"د",1,0],["لم يسعها الخباء بل لم يسعها","فوق ظهر الغبراء أيُّ مكان",42,"ن",1,0],["لم يَسَلْهُ سائلٌ عن معضل","حَيَّر الأَفهام إلاَّ أقنعه",43,"ع",2,0],["لم يُسَجِّل علومَه في كتاب","أو يُدَوِّنْ في مُعْجَمٍ آدابه",44,"ب",2,0],["لمْ يَسْمَعُوا بالمَكْرُمَاتِ، وَلمْ يَنُحْ","في دارِهِمْ ضَيْفٌ سِوَى إبلِيسِ",45,"س",1,0],["لمْ يستدرْ في ربابة ٍ، ونحَا","أصْلابَها، وشوشُ القِرَى ، حشدُهْ",46,"د",2,0],["لم يسكن القلب من آلام لوعته","الا مديح ابي العباس مولانا",47,"ن",2,0],["لَم يُسَهِّدهُ مِن أُمَامَ خَيَالٌ","زَائِرٌ مُوهِناً وطَيفٌ مُلِمُّ",48,"م",1,0],["لم يستطعْ إطفاءَها","دمعٌ كما انخرقَ المَزادُ",49,"د",1,0],["لِمَ يستنزلُ الزمانُ جدودى","وهي من عزِّك المنيع بهَضْبِ",50,"ب",1,0],["لم يسألوا عن مقامي في رحالِهمُ","إلا أتيتُ على الأعذارِ والعِللِ",51,"ل",1,0],["لم يستفد منه المنازع في العلا","إلاّ الردى أو أن يرى حسراتهِ",52,"ت",2,0],["لم يسأموا شُربَ الطلا حتى بَدا","للفيلِ في سُمِّ الخياطِ ولوجُ",53,"ج",1,0],["لم يسلم السادات من","ذمّ فمن لك بالسلامه",54,"م",2,0],["لم يستتر من أباح الطرف فرج أخ","بل ليس مستترا من لا تساتره",55,"ر",2,0],["لم يسلَمِ الطفل الرضيع وأمّه