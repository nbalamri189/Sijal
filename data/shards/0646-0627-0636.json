{"poems":[[95,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[93,"يا صاح كم تفاحة غضة","https://www.aldiwan.net/poem8764.html","عموديه"],[63,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[83,"أهدت نجاتك عوذة المتخوف","https://www.aldiwan.net/poem61460.html","الطويل"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[146,"يا ماء لينة لو نقعت أوامى","https://www.aldiwan.net/poem58373.html","الكامل"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[376,"قاتل فقد وجب الجها","https://www.aldiwan.net/poem57192.html","مجزوء الكامل"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[558,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138359",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122740","الكامل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45420","البسيط"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137307",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58471","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121704","الخفيف"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143492","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85234","الطويل"],[4791,"بارق","https://www.poetsgate.com/ViewPoem.aspx?id=28410",""],[5136,"وغزال صاد قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=121737",""],[5848,"شاطي الدمام","https://www.poetsgate.com/ViewPoem.aspx?id=48953",""],[4442,"الدر في التاج غير الدر السدف","https://www.poetsgate.com/ViewPoem.aspx?id=171197",""],[6142,"جاء عنه نداؤه لعلي","https://www.poetsgate.com/ViewPoem.aspx?id=155700",""]],"verses":[["نَاضَلْتَ حَتَّى لَمْ تَدَعْ فِي جَعْبَةٍ","سَهْماً وَمِنْ حُجَجِ المُحِقِّ سِهَامُ",0,"م",1,0],["ناضِجَةٍ تَرتَجُّ في جَوِّها","مِثلَ اِرتِجاجِ الشَمسِ عِندَ المَغيب",1,"ب",1,0],["ناضلْتُ منه بذي السَّدادِ فما هَفَا","وضربْتُ منه بذي الفَقارِ فما نَبا",2,"ب",2,0],["ناضِل بِسَيفِ اللَهِ أَو بِكِتابِهِ","وَاِشبِع بِظَهرِ الطِرفِ بَطنَ المُصحَفِ",3,"ف",1,0],["ناضَلتُموهُ على الخِلافةِ بالّتي","رُدّتْ وفيكمُ حَدُّهَا المسنونُ",4,"ن",1,0],["ناضلننا بنوافذٍ مسمومةٍ","ووددتُ لو قبَّلتُ سهمَ الرامى",5,"م",2,0],["ناضِرَةٌ تَصلُحُ لِل","ناظِرِ وَالمُستَنشِقِ",6,"ق",1,0],["ناضَلَت عَنهُ بِالدُعاءِ وَيا رُب","بَ أَكُفٍّ سِلاحُهُنَّ الدُعاءُ",7,"ا",2,0],["ناضِل بِها أَرمَى الرُّماةِ","فأنتَ تَنضُلُ مَن تُناضِل",8,"ل",1,0],["ناضرة بعقدٍ من عَسجَد","ما انطبقت ولا زنَت بمردد",9,"د",1,0],["ناضَلتَ فيها الرَدى عَن نَفسِ ذائِدِها","وَالمَوتُ في مُهَجِ الفُرسانِ تَنتَضِلُ",10,"ل",1,0],["ناضلت عنا ما ونت لك همة","وحسام عزمك ما عراه فلول",11,"ل",1,0],["ناضَلتَ بارِئَها بِأفوَقَ راهِشٍ","هَيهاتَ إنَّ الحَقَّ غَيرُ الباطِلِ",12,"ل",1,0],["ناضَلتُ عَنّي نِضالَ الحُرِّ إِذ قَصَرَت","دوني العَشيرَةُ وَاِستَبطَأَت اِنصاري",13,"ر",2,0],["ناضل الجهل دُونَنَا فحمانا","صولانَ الضلالِ والطّغيانِ",14,"ن",1,0],["ناضلت عنها باللسان مجاهداً","وبمرقم وبهمة قعساء",15,"ا",2,0],["ناضرٌ ناظرٌ بإنسانِ إنس","نٍ خَيرٌ في دَستهِ علاّمه",16,"م",2,0],["ناضرُ الوردِ قيل مِن عَرَقِ المُخْتَا","رِ قد لاح في حَدائِقِ خَدِّ",17,"د",1,1],["ناضر النبت رقيق الجو","رطب الطل سجسج",18,"ج",1,0],["ناضحت رسوماً باليات كأنها","من الدرس خط في الحائف يكتبُ",19,"ب",1,0],["ناض من بين الهدب للعين بارق","منور ٍ ورموشك السود اظلمت به",20,"ب",2,1],["ناضري مما أداري","حاجباً منه وعينا",21,"ن",2,0],["ناضج الجرح يتمادى كنه يدوّر قطافي","وانت يا غايب قطفت الروح بغصونٍ ندية",22,"ي",2,0],["ناضلتم وجيوش الغاصبين به","مرصودة بعيون المال والزغف",23,"ف",1,0],["ناضيا ذا الفقار يدرأ عنه","بغباريه كيد كل مكيد",24,"د",1,0]]}