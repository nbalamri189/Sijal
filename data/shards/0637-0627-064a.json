{"poems":[[55,"جاء بها قالصة عن ساق","https://www.aldiwan.net/poem29930.html","الرجز"],[90,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[93,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[47,"أصبا الأصائل إن برقة منشد","https://www.aldiwan.net/poem63446.html","الكامل"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[63,"أربعاء حسامه مشهور","https://www.aldiwan.net/poem51674.html","الخفيف"],[99,"لمن الصمت والفؤاد المشرد","https://www.aldiwan.net/poem24603.html","الخفيف"],[99,"يا أميري أزف البين","https://www.aldiwan.net/poem24767.html","مجزوء الرمل"],[46,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[76,"أما لديك حلاوه","https://www.aldiwan.net/poem13273.html","المجتث"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142058","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[108,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[102,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[103,"داعِبِ الشرقَ باسماً وسعيداً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62410&r=&rc=2",""],[121,"عودة","https://www.aldiwan.net/poem24023.html","الخفيف"],[164,"أزلت بالصمصام شوك القنا","https://www.aldiwan.net/poem58933.html","السريع"],[203,"كوكب أبدلته ايديي الليالي","https://www.aldiwan.net/poem45366.html","الخفيف"],[215,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[287,"أدار ليلا قمر شمس راح","https://www.aldiwan.net/poem32831.html","السريع"],[309,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[333,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[347,"يا لذكرى طبريا","https://www.aldiwan.net/poem55337.html","مجزوء الرمل"],[386,"هاج رسم دارس طرباً","https://www.aldiwan.net/poem400.html",""],[406,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[422,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122532","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64232","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199586","المسحوب"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99983","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136316","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48970","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141254","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87861","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125461","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106843","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100926","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100345","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202775","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115709","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134196","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65344","السريع"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112370","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118015","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114109","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29274","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101347","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45071","الخفيف"],[4248,"","https://poetry.dctabudhabi.ae/diwan/poem/105548","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83528","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104540","الخفيف"],[4533,"","https://poetry.dctabudhabi.ae/diwan/poem/134281","الرمل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35134","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52135","الخفيف"],[4931,"أمجاد حبّي","https://www.poetsgate.com/ViewPoem.aspx?id=32488",""],[4984,"قَدُمَ الْعَهْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=201623",""],[5038,"رحيق الورد","https://www.poetsgate.com/ViewPoem.aspx?id=190110",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5183,"ألف أهلا","https://www.poetsgate.com/ViewPoem.aspx?id=185692",""],[5307,"","https://www.poetsgate.com/ViewPoem.aspx?id=10549",""],[5411,"طائر النَّار","https://www.poetsgate.com/ViewPoem.aspx?id=191637",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5539,"حزم البطولات","https://www.poetsgate.com/ViewPoem.aspx?id=192483",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""],[5739,"برج الهواوي ورادار العشير ..!","https://www.poetsgate.com/ViewPoem.aspx?id=130849",""],[5853,"صمت الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=175622",""],[5885,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=194688",""],[5975,"طائرٌ .. في قفص","https://www.poetsgate.com/ViewPoem.aspx?id=58510",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["طائِرَةً بِالقُرُبِ الخَفّاقِ","مُنفَلِتِ الدَلوِ مِنَ العَراقي",0,"ق",2,0],["طائرٍ في الفضاء عرضاً وطولاً","بجناح من القوى غير باد",1,"د",1,0],["طائِرٌ كانَ في الرُبى يَتَغَنّى","أَصبَحَ اليَومَ يَحمِلُ الأَصفادا",2,"ا",1,0],["طائِيُّكَ الأَدنى أَساءَ إِساءَةً","في أَمسِهِ الماضي وَأَحسَنَ في غَدِ",3,"د",1,0],["طائِرٌ مَدَّ مُستَريحاً جَناحَي","هِ اِستِراحاتِ مُتعَبٍ مَكدودِ",4,"د",1,0],["طائرٌ في الهواءِ فالبرقُ يَسري","دونَ أعلاه والحَمامُ يَطيرُ",5,"ر",1,0],["طائر أم رأت عيون الأماني","حُلُماً مثل غيره قد تبدد",6,"د",1,0],["طائراً ألفى على را","حتها وكراً أمينا",7,"ن",2,0],["طائِيَّةٌ لا أَبوها كانَ مُهتَضِما","وَلا مَضى بَعلُها لَحماً عَلى وَضَمِ",8,"م",1,0],["طايِب وَداعِب وَلاعِب","وَدَع سَجايا البَداوَه",9,"ا",3,0],["طائرٌ من دجلةِ","الخلد إلى لبلنان حنّا",10,"ن",2,0],["طائِرٌ يَشْدُو عَلَى فَنَنِ","جَدَّدَ الذِّكْرَى لِذِي شَجَنِ",11,"ن",1,1],["طائفٌ إنْ رُمتَه لم تلْقَه","وهو من جفنِكَ بين الهُدُب",12,"ب",1,0],["طائرٌ غرّدَ في دَوْحَتكم","علّم الأطيارَ معنى الطرب",12,"ب",1,0],["طائرٌ كان إن تغنَّى إلى الرو","ضِ شجا الحالياتِ من أغصانه",13,"ن",2,0],["طائراتٌ ترمي الصواعقَ لا تخْ","شى إلاهاً ولا تخافُ عبيدا",14,"د",2,0],["طائر ليس كالطيور، صقيلٌ","مستقيم الجناح، صُلب الذُّنابي",15,"ب",2,0],["طائر عشّه الوجود وقلب","ملهم عاشق وروح نبيلة",16,"ل",2,1],["طائرا عن عوالم الشر لما","أودع الله فيك روحا غسيله .",16,"ل",2,0],["طائراتٌ ترمي الصواعقَ لا تخْ","شى إلهً ولا تخافُ عبيدا",17,"د",2,0],["طائِشٌ كالسِّهامِ أو كالمَنايا","واللَّيالي تَغُرُّ حينًا وتَجْبَهْ",18,"ب",2,0],["طائرك الميمونُ أنى غدت","راياتُه البيضُ بُلّغن المنى",19,"ن",2,0],["طائفاً ينشدُ الذي ضلَّ منهُ","واقفاً كلَّ لحظةٍ لسؤالِ",20,"ل",1,0],["طائر الشوق بأضلاعي يصيح","طال عهد البعد من ذاك المليح",21,"ح",1,0],["طائِرُهُ المَيمونُ مُذ لَم يَزَل","ما طارَ إِلّا بِجَناحِ النَّجاح",22,"ح",1,0],["طائِعاً لِمَليكٍ","وَمِنَ الرِزقِ يَقنَعُ",23,"ع",1,0],["طائرٌ طوّق الوجود جناحا","ه وغنّاه أروع الأغنيات",24,"ت",1,0],["طائر عشّه الزمان ومهوى","جانِحَيه القلوب والأهواء",25,"ا",2,0],["طائرات اللب لا","يمشين الا ضاحكات",26,"ت",1,0],["طايفاتٍ يعتَسِفنَ مَعاً","مِن أَعالي حائِلٍ كُثُبا",27,"ب",2,0],["طائراتُ العِدَا تَسُدُّ فضاءً","وأساطيلُهم تشقُّ العُبابا",28,"ب",2,0],["طائع خاشع تقيٌّ نقيٌّ","ينقضي دهره صلاة وصوما",29,"م",2,0],["طائعةً جاءتك بل مضطرّة","منتشَطَ البَكرةِ من عِقالها",30,"ل",3,0],["طائيةً صعبت وأسهل لفظها","فانظر إلى الصعب المنيع المسهل",31,"ل",1,0],["طائراً خِلفَةٍ إذا وقَعَ البا","زِيُّ في الخافِقينِ طارَ الغرابُ",32,"ب",1,0],["طائرٌ قَلْبُ مَنْ يُغَنِّيهِ أولى","منه عند الغناءِ بالطيران",33,"ن",1,0],["طايف حكي عذالي","ما تصطاخه الأذان",34,"ن",1,0],["طَائِرِي سَاكنٌ وفكْرِي عَزُوفٌ","عَنْ فُضُولِ الْمُنَى وَلَحْظِي سَلِيمُ",35,"م",1,0],["طائر الأنس لدى","روضه قد صدحا",36,"ح",2,0],["طائر السعد بالأماني ترنم","ونسيم الصفا بأنسي تنسم",37,"م",1,1],["طائرٌ يسبحُ في جوِّ الخَيالْ","في سكونٍ وهُيامِ واختيالْ",38,"ل",1,1],["طائرُ الافصاحِ صاح","قد نأَى وجهُ العناءِ",39,"ا",2,0],["طائرٌ في الأفق لا تفتكر","بسوي الوحي الإلهي الملمّ",40,"م",1,0],["طائِرٌ وَكرُهُ عَلى كُلِّ غُصنٍ","وَهَواهُ مِلءُ الرُبى وَالتِلالِ",41,"ل",1,0],["طائرَ اللُّبِّ سابحاً في خيالِ","شردتهُ لواعجُ الوَلهَانِ",42,"ن",1,0],["طائرَ اللبِّ سابحاً في خيالٍ","عن مخازيكَ مغمضَ الأجفانِ",43,"ن",1,0],["طائرٌ ناطقٌ كتابٌ شهيدٌ","سُجِّلَت فيه صادقاتُ البَيانِ",43,"ن",1,0],["طائرةً في رائعات السنى","خاطرةً في الحللِ الراضيه",44,"ي",2,0],["طائراتٌ يقعنَ من دهش القو","مِ بما فى نفوسهم من معانى",45,"ن",2,0],["طائف طاف لا بانزر صاعٍ","كائلٌ كال لا بكيلٍ طفيفِ",46,"ف",1,0],["طائشٌ لم يفدك نصحٌ ووعظ","جامح ما ثنتْ هواك الخطوب",47,"ب",1,0],["طائر العقل واجب القلب مضنى","خطب همي يوم الفراق جليل",48,"ل",1,0],["طائف الأنس طاف يبدي سلاما","فاذكرا الشوق نحوه وسلاما",49,"م",2,1],["طائر قلبي من ظُبا مقلمة","كلّمهُ أغيدُ وسنانُ",50,"ن",1,1],["طائفة شريفة مباركه","وفي المعالي أبوا المشاركه",51,"ه",1,0],["طائرةٌ لكنّني مثلهَا","من فرحي ما بينَ تلك الزهور",52,"ر",1,0],["طائعة لزوجها ممتثلة","لأمره بحقه مشتغلة",53,"ه",1,0],["طَائِرٌ مِن أزَاهِرٍ بِرِياضٍ","لِمَعِينِ الحِيَاضِ كَيفَ يَشَاءُ",54,"ا",2,0],["طَائِرُ قَلبِي عَاكِفٌ فَوقَ غُصنٍ","زَاهِرٍ لِلقُلوبِ رَوحٌ وَقُوتُ",55,"ت",1,1],["طائِراتٍ عَلى جَناحِ حُبارى","سابِحاتٍ عَلى بُطونِ سُمانى",56,"ا",1,0],["طاير الزور للحضيض هويا","لست تعلو بباطل طائر الحق",57,"ق",1,0],["طائِرُ الفِكرِ قَد شَدا وَتَغَنّى","مُذ هَصَرتَ القَريضَ نَحيوَ غُصنا",58,"ن",2,1],["طائفة تخص من تعلما","وجملة آداب شيخ علما",59,"م",2,1],["طائِرٌ طارَ في الفَيافي مُسِفّاً","يا لِنسرٍ أَسفَّ في الطَيَرانِ",60,"ن",1,0],["طائرات ترمي بها صفحات ال","جو حتى عنت لها عقبانه",61,"ن",2,0],["طائرات للمعالي","تاركات للهجود",62,"د",1,0],["طائِرٌ شادٍ وَغُصنٌ مُنثَنٍ","وَالدُجى يَشرَبُ صَهباءَ الأَصيلِ",63,"ل",1,0],["طائفٌ مجالِسَها","لا يملُّه السأَمُ",64,"م",1,0],["طائرٌ كانَ في يميني فلما","ملقوهُ غنّى قليلاً وطارا",65,"ر",2,0],["طايع .. واعاند .. والشّعر دوم يصطاد","أبيات باني الحبّ فيها مباني",66,"ن",2,0],["طائر النحس تَلَظَّى فتفاءلْ","فلعل الفأل في السرب ينادي",67,"د",2,0],["طائرُ الشَوقِ نَسِيْ ألمي","عادَ والأشْواق ترْتحلُ",68,"ل",1,0],["طائية حرة طائية برعت في","فنها فغدا ما دونها لغطا",69,"ط",2,0],["طائف بالليل حيى","جاءني بالمسك ريا",70,"ي",2,1],["طايحه روحي لمطاليبك","مغرم هاوي وطلابك",71,"ك",1,0],["طائِرُ النَّارِ واقِفٌ عِنْدَ ظِلّي","يَحْرُسُ الفُلَّ وَالنَّدَى وَالدَّارا",72,"ر",2,0],["طائراتٍ بغير طيّارَ تغزو","وأخو العرْبِ راكبٌ ظهر عنسِ!!",73,"س",1,0],["طايرات لارعدت باسها بأس ن شديد","دكت حصون المعادين ماتخشى الخطر",74,"ر",1,0],["طائر الشوق كارتعاشِ وليدٍ","رام أُمّاً في راحتيها يقيلُ",75,"ل",1,0],["طائرة شعري على ثقلها تنوي المطير.","والجزاله مبتداها بربط الاحزمه.",76,"م",2,1],["طائر الفجر معْلمٌ في يقيني","ينشر الحب والرؤى بالحوارِ",77,"ر",1,0],["طائر أنت والفضاء رداء","وأنا ريشة بكم تستقيم",78,"م",1,0],["طائر حر طليق .... غرد","قيدوه... سجنوه.. في قفص",79,"ص",1,1],["طَائِرَاتٌ مِنْ فوقِنَا، يَرْجِعُ الرَّادَارُ","مِنْ دُونِهَا بِطَرْفٍ كَلِيلِ",80,"ل",1,0]]}