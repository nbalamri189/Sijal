{"poems":[[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104803","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83621","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139265","الخفيف"],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""]],"verses":[["قُل جَاءَنِى صَبٌ بَرَاهُ غَرَامُهُ","غادَرتُهُ لِجَنَابِكُم مِلتاحَا",0,"ح",2,0],["قَل جاءَت البشرى بقرب خلاصنا","إِنّ الخلاص يُشير لاِستِخلاصي",1,"ص",2,0],["قل جميلاً إذا أردت الكلاما","تجن عزاً مهنا مستداما",2,"م",2,1],["قلْ جاءَ وعْدُ الله أزْهقَ باطِلاً","فانظُرْ إلى الأصْنامِ كيْفَ تُساءُ ؟",3,"ا",2,0]]}