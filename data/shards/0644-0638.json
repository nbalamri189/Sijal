{"poems":[[57,"بدا من أبي الفضل الهوى المتقادم","https://www.aldiwan.net/poem26122.html","الطويل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[32,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[53,"تركنا لكم دنياكم وتخاضعت","https://www.aldiwan.net/poem61913.html","الطويل"],[40,"ولم أر معقورا به وسط معشر","https://www.aldiwan.net/poem7708.html","الطويل"],[30,"وحاجة لا يراها الناس أكتمها","https://www.aldiwan.net/poem5449.html","البسيط"],[51,"نهنه دموعك كل حي فان","https://www.aldiwan.net/poem63122.html","الكامل"],[35,"فوالله ثم والله إني لدائب","https://www.aldiwan.net/poem26026.html","الطويل"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[42,"أقول عشاء للطويل تعجبا","https://www.aldiwan.net/poem42335.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29340","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[136,"سبت لبه من بعد كبرته جمل","https://www.aldiwan.net/poem54770.html","الطويل"],[138,"أرقت وقد تصوبت النجوم","https://www.aldiwan.net/poem21031.html","الوافر"],[216,"خليدة ذاب القلب من حر شوقكم","https://www.aldiwan.net/poem37854.html","الطويل"],[286,"بحبيب القلوب معتمد الحلق","https://www.aldiwan.net/poem1374.html",""],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[310,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[463,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[466,"أحب مطال الوصل لا عن رضى به","https://www.aldiwan.net/poem15162.html","الطويل"],[469,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[520,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34413","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38843","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107190","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96568","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133836","الخفيف"],[1334,"","https://poetry.dctabudhabi.ae/diwan/poem/76576","الطويل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31491","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[3023,"","https://poetry.dctabudhabi.ae/diwan/poem/31533","الطويل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96113","الطويل"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82368","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129504","البسيط"],[533,"","https://poetry.dctabudhabi.ae/diwan/poem/111568","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86514","البسيط"],[3904,"","https://poetry.dctabudhabi.ae/diwan/poem/202487","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78357","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90899","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90847","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91000","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136751",""],[4858,"إلى روح الشهيد سيد قطب","https://www.poetsgate.com/ViewPoem.aspx?id=29820",""],[5111,"ضُلُوعِيْ تُصِفِّقُ","https://www.poetsgate.com/ViewPoem.aspx?id=212622",""],[5145,"نعم حلب العين اعتراف الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=108071",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5273,"عانس","https://www.poetsgate.com/ViewPoem.aspx?id=180576",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[243,"خيالك","https://www.poetsgate.com/ViewPoem.aspx?id=50484",""],[5809,"أشعر بيت","https://www.poetsgate.com/ViewPoem.aspx?id=205096",""],[6115,"الظفر في طاعة الله وبرّك والديك","https://www.poetsgate.com/ViewPoem.aspx?id=187918",""],[6152,"كفاكِ نوما","https://www.poetsgate.com/ViewPoem.aspx?id=203054",""]],"verses":[["لَظَلَّت تَشَكّى البَثَّ لَم تُخطِ كُنهَهُ","فَقَد مَلَأَت صَدري البَلايا العَظائِمُ",0,"م",1,0],["لَظَلَّ يُرعَدُ إِلّا أَن يَكونَ لَهُ","مِنَ الرَسولِ بِإِذنِ اللَهِ تَنويلُ",1,"ل",1,0],["لَظىً تَلفَحُ الحِرباءَحَتّى كَأَنَّهُ","أَخو جَرماتٍ بَزَّ ثَوبَيهِ شابِحُ",2,"ح",1,0],["لظلَّتْ على العافين أسْمَحَ بالندى","من الهاطلات البارقات الرواعد",3,"د",1,0],["لَظَلَّ قُطامِيٌّ وَتَحتَ لَبانِهِ","نَواهِضَ رُبدٌ ذاتُ ريشٍ مُسَبَّدِ",4,"د",1,0],["لَظَلَّ يَحسِبُ أَنَّ الأَرضَ قَد حَمَلَت","قُترَيهِ لَمّا عَلا عُرضِيَّهُ الثِقَلُ",5,"ل",1,0],["لَظَنَنتُ أَو أَيقَنتُ عِندَ مَنِيَّتي","أَنَّ المَصيرَ إِلى مَحَلِّ هَوانِ",6,"ن",1,0],["لَظَلَّ صَدى رَمسي وَإِن كُنتُ رِمَّةً","لِصَوتِ صَدى لَيلى يَهُشُّ وَيَطرَبُ",7,"ب",1,0],["لِظَمآنَ في ماءٍ أَحالَتهُ مُزنَةُ","بُعَيدَ الكَرى في مُدهُنٍ بَينَ أَطلُحِ",8,"ح",1,0],["لَظَلَّ مُصِيخاً سامِعاً ثُمَ إِنَّها","إِذا نَفَثَت لَم يَألُ إِلّا تَقَدُّما",9,"م",2,0],["لظل النهار رانيا وكأنه","إذا كش ثور من كريص منمّس",10,"س",1,0],["لَظَلَّ يُنَازِعُهَا لُبَّهُ","نِزَاعَ القَرِينِ حِبَالَ الرُّهُنْ",11,"ن",1,0],["لَظَلَّت عَلَينا الرُّسلُ تَتَرى ولَم نَكُن","لِنَتَّبَعَ فِيهَا مَا أتَتنَا بِه الرُّسلُ",12,"ل",1,0],["لِظُلمِ عَشيرَةٍ ظَلموا وَعَقّوا","وَغِبُّ عُقوقِهِم كُلَأٌ وَخيمُ",13,"م",1,0],["لَظَتْ بين أضلاعي لظىً من عذابكُم","وإني بنيران الهوى لَحَريقُ",14,"ق",1,0],["لظلومٍ لنفسهِ قد تناهَى","في الخطايا وكلِّ فعلٍ شنيع",15,"ع",1,0],["لظاه صدَّعتْ خلدي","وَسوْرته وَرتْ كبدي",16,"ي",1,0],["لَظللتُ مع لَمسي على قرطاسهِ","بِيدي أقولُ أراه سكراً يؤثرُ",17,"ر",1,0],["لظمآنٍ ببابلَ من سبيلٍ","إلى الماء الذي كتم البقيعُ",18,"ع",1,0],["لظى زفراتٍ ليس يبردُ حَرُّها","ونظم دموعٍ لا تُحلُّ عُقودها",19,"د",3,0],["لظميتُ من سيل السّماح بزاخرٍ","وضللتُ من سنن العلاء بسابل",20,"ل",1,0],["لظننت أن الفتح أصبح قائماً","فينا بدولة جعفر المتوكل",21,"ل",1,0],["لَظَهرُكَ أَحمى من مُحيّا عدوّهِ","وَيُسراكَ مِن يُمناهُ أَندى وَأَنفَعُ",22,"ع",1,0],["لَظى خَدِّهِ الزّاهي عَلى وَردِهِ ذَكَت","وَلَولا مِياهُ الحُسنِ كانَ بِها اِحتَرق",23,"ق",1,0],["لَظَنُّكَ فِي حبيكَ غَيرُ مُوَافِقٍ","وَذَنبٌ لَدى مَن بِالغَرامِ تَأَدَّبُوا",24,"ب",3,0],["لظلّ إِليها رانياً أَو لحطَّه","تخلَّبُ جَدوى والكلامُ الطرائف",25,"ف",1,0],["لظننّا الرجاء وجه مريب","وحسبنا الحياة فعلةَ جان",26,"ن",1,0],["لَظَمآنُ قَفرٍ أَبصَر الماءَ حَسرَةً","وَقَد ذيدَ عَن أَطرافِهِ بِالمَناصِلِ",27,"ل",1,0],["لَظَلَّ جَميلٌ أَسوَأَ القَومِ تَلَّةً","وَلكِنَّ قِرنَ الظَهرِ لِلمَرءِ شاغِلُ",28,"ل",1,0],["لَظلك يَلجأون بِكُل ضيق","وَيَتبعون رَأَيك حَيث شاءا",29,"ا",3,0],["لِظَمياءَ دارٌ كَالكِتابِ بِغَرزَةٍ","قِفارٌ وَبِالمَنحاةِ مِنها مَساكِنُ",30,"ن",1,1],["لظلت قراقير صياما بظاهر","من الضحل كانت قبل في لجج خضر",31,"ر",1,0],["لَظَلَّت سُيوفُ الهِندِ تَحصُدُ جَمعَكُم","حَصادَ زُروعٍ أَينَعَت لِلمَناجِلِ",32,"ل",1,0],["لظى تؤجج من دهر له نوب","من وقدها باتت الاحشاء في شعل",33,"ل",1,0],["لظبي المناصل والوشيج الذبل","شرف أناف عن السماك الأعزل",34,"ل",1,1],["لظى أمدته نكباء الرياح فهل","نكب الرياح علينا هاجها ضغن",35,"ن",1,0],["لظمآن نفرٍ أبصر الماء حرةً","وقد ذيد عن أطرافه بالمناصلِ",36,"ل",1,0],["لظبي قَد بَكَت عيني وَقالَت","أَنوح اِلى النُشورِ فَقُلت نوحي",37,"ح",2,0],["لظل الميمن جل اقتدارا","هي الشمس من غير حر يذبب",38,"ب",1,0],["لظهورها عز عظيم دائم","وبطونها كنز بلا أرصاد",39,"د",1,0],["لظهور أشرف كوكب بسماء سا","طنة ملوكانية التمكين",40,"ن",1,0],["لظلكما الظليل بعثت خودا","ذهت وسمت على الدرر الوسام",41,"م",1,0],["لظباءِ كاظمةٍ مقابلتي","غيظي من الرُّقباءِ بالكظم",42,"م",1,0],["لظلم فيك وظلمٍ فيكَ قد أرقت","عيني وقد شهدت لي الشهبُ والظلمث",43,"م",2,0],["لظللتُ عمري في الظّلام مكبّلاً","حتى تلقيتَ الشهادةَ \" سيدُ \"",44,"د",1,0],["لَظَى البِيْنِ يَسْرِي فِي ثَنَايَا دُرُوبِنَا","لِيُرْسِلَ وجْدًا فِيْ لَظَاهُ نُحَلِّقُ",45,"ق",1,0],["لظل العلى والمجد تحت دجنةٍ","من اللؤم في طخياء ذات دياجر",46,"ر",1,0],["لظرف الحشا المملوء من نار صبوتي","بحبك واكيه بكف القلا أوكا",47,"ك",2,0],["لظى الماضي يُؤرِّقُني بِلَوْمٍ","يَزيدُ بِطَعْمِ أيامي المرارا",48,"ر",2,0],["لظللت أؤمن أن أمتنا لها","يوم من الأمجاد أبيض ناصع",49,"ع",1,0],["لظلك لو يعلم الجدول","على العذب من مائه منزل",50,"ل",1,1],["لَظلَّ كلُ مشوقٍ حين يقرؤه","يعيده دون إعياءٍ ولامللِ",51,"ل",1,0],["لظّفر في طاعة الله وبرّك والديك","والخنا في طاعة النفس وابليس الرجيم",52,"م",1,1],["لظى غيابكِ كالنيران تحرقني","ومنكِ وحدكِ نار الشوق تحتطب",53,"ب",1,0]]}