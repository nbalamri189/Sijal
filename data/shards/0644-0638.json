{"poems":[[55,"بدا من أبي الفضل الهوى المتقادم","https://www.aldiwan.net/poem26122.html","الطويل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[30,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[51,"تركنا لكم دنياكم وتخاضعت","https://www.aldiwan.net/poem61913.html","الطويل"],[38,"ولم أر معقورا به وسط معشر","https://www.aldiwan.net/poem7708.html","الطويل"],[28,"وحاجة لا يراها الناس أكتمها","https://www.aldiwan.net/poem5449.html","البسيط"],[49,"نهنه دموعك كل حي فان","https://www.aldiwan.net/poem63122.html","الكامل"],[33,"فوالله ثم والله إني لدائب","https://www.aldiwan.net/poem26026.html","الطويل"],[39,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[40,"أقول عشاء للطويل تعجبا","https://www.aldiwan.net/poem42335.html","الطويل"],[132,"سبت لبه من بعد كبرته جمل","https://www.aldiwan.net/poem54770.html","الطويل"],[134,"أرقت وقد تصوبت النجوم","https://www.aldiwan.net/poem21031.html","الوافر"],[212,"خليدة ذاب القلب من حر شوقكم","https://www.aldiwan.net/poem37854.html","الطويل"],[281,"بحبيب القلوب معتمد الحلق","https://www.aldiwan.net/poem1374.html",""],[298,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[305,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[461,"أحب مطال الوصل لا عن رضى به","https://www.aldiwan.net/poem15162.html","الطويل"],[464,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[515,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"]],"verses":[["لَظَلَّت تَشَكّى البَثَّ لَم تُخطِ كُنهَهُ","فَقَد مَلَأَت صَدري البَلايا العَظائِمُ",0,"م",1,0],["لَظَلَّ يُرعَدُ إِلّا أَن يَكونَ لَهُ","مِنَ الرَسولِ بِإِذنِ اللَهِ تَنويلُ",1,"ل",1,0],["لَظىً تَلفَحُ الحِرباءَحَتّى كَأَنَّهُ","أَخو جَرماتٍ بَزَّ ثَوبَيهِ شابِحُ",2,"ح",1,0],["لظلَّتْ على العافين أسْمَحَ بالندى","من الهاطلات البارقات الرواعد",3,"د",1,0],["لَظَلَّ قُطامِيٌّ وَتَحتَ لَبانِهِ","نَواهِضَ رُبدٌ ذاتُ ريشٍ مُسَبَّدِ",4,"د",1,0],["لَظَلَّ يَحسِبُ أَنَّ الأَرضَ قَد حَمَلَت","قُترَيهِ لَمّا عَلا عُرضِيَّهُ الثِقَلُ",5,"ل",1,0],["لَظَنَنتُ أَو أَيقَنتُ عِندَ مَنِيَّتي","أَنَّ المَصيرَ إِلى مَحَلِّ هَوانِ",6,"ن",1,0],["لَظَلَّ صَدى رَمسي وَإِن كُنتُ رِمَّةً","لِصَوتِ صَدى لَيلى يَهُشُّ وَيَطرَبُ",7,"ب",1,0],["لِظَمآنَ في ماءٍ أَحالَتهُ مُزنَةُ","بُعَيدَ الكَرى في مُدهُنٍ بَينَ أَطلُحِ",8,"ح",1,0],["لَظَلَّ مُصِيخاً سامِعاً ثُمَ إِنَّها","إِذا نَفَثَت لَم يَألُ إِلّا تَقَدُّما",9,"م",2,0],["لَظَلَّت عَلَينا الرُّسلُ تَتَرى ولَم نَكُن","لِنَتَّبَعَ فِيهَا مَا أتَتنَا بِه الرُّسلُ",10,"ل",1,0],["لِظُلمِ عَشيرَةٍ ظَلموا وَعَقّوا","وَغِبُّ عُقوقِهِم كُلَأٌ وَخيمُ",11,"م",1,0],["لَظَتْ بين أضلاعي لظىً من عذابكُم","وإني بنيران الهوى لَحَريقُ",12,"ق",1,0],["لظلومٍ لنفسهِ قد تناهَى","في الخطايا وكلِّ فعلٍ شنيع",13,"ع",1,0],["لظاه صدَّعتْ خلدي","وَسوْرته وَرتْ كبدي",14,"ي",1,0],["لَظللتُ مع لَمسي على قرطاسهِ","بِيدي أقولُ أراه سكراً يؤثرُ",15,"ر",1,0],["لظمآنٍ ببابلَ من سبيلٍ","إلى الماء الذي كتم البقيعُ",16,"ع",1,0],["لظى زفراتٍ ليس يبردُ حَرُّها","ونظم دموعٍ لا تُحلُّ عُقودها",17,"د",3,0],["لظميتُ من سيل السّماح بزاخرٍ","وضللتُ من سنن العلاء بسابل",18,"ل",1,0],["لظننت أن الفتح أصبح قائماً","فينا بدولة جعفر المتوكل",19,"ل",1,0]]}