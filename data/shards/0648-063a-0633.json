{"poems":[[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[93,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[18,"لابنة حطان بن عوف منازل","https://www.aldiwan.net/poem23912.html","الطويل"],[69,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67337","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[108,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[132,"قيل لي أنت في مديحك تغلو","https://www.aldiwan.net/poem50545.html","الخفيف"],[353,"ومملوكة لي كلما رمت وطأها","https://www.aldiwan.net/poem20187.html","الطويل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[432,"فمن يك أمسى في بلاد مقامةٍ","https://www.aldiwan.net/poem536.html",""],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70933","الطويل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96464","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80024","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124769","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18048","الطويل"],[2432,"","https://poetry.dctabudhabi.ae/diwan/poem/147048","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107001","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65952","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4755,"لا شَأنَ لِي","https://www.poetsgate.com/ViewPoem.aspx?id=204158",""],[4953,"أبو خزيمة ووباء الكورونا!!!","https://www.poetsgate.com/ViewPoem.aspx?id=211118",""],[5102,"شاعر المليون","https://www.poetsgate.com/ViewPoem.aspx?id=14630",""],[5183,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=185639",""],[5421,"رمضان ولّى..","https://www.poetsgate.com/ViewPoem.aspx?id=212992",""],[5493,". ربيع الشعر .","https://www.poetsgate.com/ViewPoem.aspx?id=197946",""],[6056,"النقاش المحتدم","https://www.poetsgate.com/ViewPoem.aspx?id=156708",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["وَغَسّانُ ذَلَّت يَومَ جِلَّقَ ذِلَّةً","بِسَيِّدِها وَالأَريَحِيُّ المُنازِلُ",0,"ل",1,0],["وَغَسَلتُ مِنها راحَتي فَغَسَلتُها","مِن سائِرِ الأَوضارِ وَالأَدناسِ",1,"س",1,0],["وَغَسّانُ حَيٌّ عِزُّهُم في سِواهُمُ","يُجالِدُ عَنهُم مِقنَبٌ وَكَتائِبُ",2,"ب",1,0],["وغَسَلْتُ الذي جَمَعْتُ مِنَ الشع","رِ بِفَيْضٍ عليه غسْلَ صُخورِ",3,"ر",1,0],["وغَسْلُ طِمْريَ سَبْعاً من مُعاشَرَتي","في البِيدِ كلَّ شجاعِ القلبِ شَرّاعِ",4,"ع",1,0],["وَغَسَّانُ أصْلِي وَهُمْ مَعْقِلي","فنِعْمَ الأَرومَةُ والمَعْقِلُ",5,"ل",1,1],["وغسّانُ الحُمَةُ مُوازِرُهُ","على الأعداءِ وَهْوَ لَهُمْ وزيرُ",6,"ر",1,0],["وَغَسَّلَها بِكَوثَرِهِ","فَقَدَّسَها وَصَوَّنَها",7,"ن",3,0],["وغسَّلتك بصَوبٍ من مدامعها","مصرُ البريئةُ ترجو منك غُفْرانا!",8,"ن",2,0],["وَغُسلوىّ في مدح مَنْ يتَعالى","قدرهُ فوق ما أقولُ ويعْلُو",9,"ل",2,0],["وَغَسْلِيَ لا من وَطْئِها بَلْ لِوَ طْبها","تَرَى كُلَّ يَوْمٍ ذاكَ مِنِّي مُجَدَّدا",10,"د",2,0],["وَغَسلُ أَيّوبَ وَظَلَّ يونِسٍ","وَشَيخُ يَحيى إِذا شَكى وَهَنَ الكِبَر",11,"ر",1,0],["وَغَسّانُ حَيُّ عِزُّهُم في سِواهُمُ","تُجالِدُ عَنهُم حُسَّرٌ وَكَتائِبُ",12,"ب",1,0],["وغسل يديهم من جميع أمورهم","بتغويضهم فيه تنال المطامع",13,"ع",1,0],["وغسلت بالتفاني","وكان في الجسم رمسه",14,"س",2,0],["وغُسْل يدٍ قبل الطعام مبارَك","ومغفرة بعد الطعام لمذْنب",15,"ب",1,0],["وَغَسَّانُ الَّتِى مَلَكَت مَعَداًّ","شَآمِيَهَا وَمَن يَرعَى البَشَامَا",16,"م",2,0],["وغسلته العُلى وقالت","بوركت من طاهرٍ غسيل",17,"ل",1,0],["وغسل الميت يجعل تحت سترٍ","ويستر فرجه بالثوبِ سترا",18,"ر",2,0],["وغسل ثوبٍ في نهار الجمعه","فان هذا من قبيح البدعه",19,"ه",1,0],["وغسل يد قبل الطعام وبعده","ويكره بالمطعوم غير مقيّد",20,"د",1,0],["وَغَسّانَ حَتّى أَسلَمَت سَرَواتُنا","عَدِيّاً وَكانَ المَوتُ في حَيثُ أَوقَعا",21,"ع",2,0],["وغسلت من معروفهم","كلتا يدي بواحده",22,"د",2,0],["وغسلتها بالماء منك وقاحة","ليكون مثلك حظها مغسولا",23,"ل",2,0],["وغسل حوبه","وستر اللّه غداً عيوبه",24,"ه",1,0],["وَغَسلتُ رِجلي حاضِراً","وَمَسحتُ خُفِّيَ في السَّفَرْ",25,"ر",1,0],["وَغَسطَروفَ بنَ فيونٍ جَرَحا","بِرُمحِهِ في حُقِّهِ فَاِنطَرَحا",26,"ح",2,0],["وَغَسَلَ الجُرحَ وَعِرقاً مُرّاً","بِيضدِهِ فَتَّ وَحالاً ذَرّا",26,"ر",2,0],["وغَسَلتَنِي بِالنَّارِ، بَعدَ تَخَبُّطِي","مِن كَفِّ نَيرُونٍ إِلى شَمشُونِ!",27,"ن",1,0],["وَغَسْلُكَ لِليَدينِ يَقِيكَ شَرَّاً","مِن التَّشْخيصِ أَوْ مُرِّ الدَّواءِ",28,"ا",2,0],["و\"غسّانُ\" يُقطِّبُ بعدَ حُكمٍ","وللتقطيب حكمتُه النبيلهْ",29,"ل",2,0],["وغسلت الأرض من مستعمر","طامع بات يجر العطبا",30,"ب",2,0],["وغسلت قلبي في معين بهائه","واليوم حُزنا أدمعي تبكيه",31,"ي",2,0],["وغسلتُ منْ هذا الندَى أرقِي الذِي","كتبَ البيانُ بهِ شذًا مسْطورَا",32,"ر",2,0],["وغسلته / غسل ٍ للأ فكارمن نقص الفهم","ودفنته / دفن الأماني وهي متمكنه",33,"ن",2,0],["وغسلت العار الذي كان يؤذي","من يراه على جباه الأسود",34,"د",1,0]]}