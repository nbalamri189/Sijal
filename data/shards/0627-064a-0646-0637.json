{"poems":[[88,"سائلوا الليل عنهم والنهارا","https://www.aldiwan.net/poem10926.html","الخفيف"],[87,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[30,"يا قوم إني لم أكن لأسبكم","https://www.aldiwan.net/poem5075.html","الطويل"],[30,"ألكني إلى راعي الخليفة والذي","https://www.aldiwan.net/poem5167.html","الطويل"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[102,"عند مجهولة","https://www.poetsgate.com/ViewPoem.aspx?id=50413",""],[154,"هاك عن هذا النبي المصطفى","https://www.aldiwan.net/poem68447.html","الرمل"],[287,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138442",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138633",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91413","الرمل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34760","الهزج"],[5302,"عهد الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=201740",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""]],"verses":[["أَينَ طوفانُ صاحِبِ الفُلكِ يَروي","هَذِهِ النارَ فَهيَ تَشكو الأُوارا",0,"ر",2,0],["أينطق حكمة وحجا","لسان لا تقوّمه",1,"م",2,0],["أَيَنطِقُ في المَشارِقِ كُلُّ طَيرِ","وَيَبقى أَهلُها رَخَماً وَبوما",2,"م",2,0],["أَيَنطِقُها غَيري وَأُرمى بِدائِها","فَهَذا كِتابٌ حَقُّهُ أَن يُغَيَّرا",3,"ر",2,0],["أَيَنطِقُها غَيري وَأُرمى بِعَيبِها","فَكَيفَ أَلومُ الدَهرَ أَن يَتَغَيَّرا",4,"ر",2,0],["أين طريق السلوان","ألردف عبل ريان",5,"ن",1,0],["أين طعم الخمر والحب هنا","ولدي الكأس ملأى والحبيبه",6,"ب",2,0],["أي نطق قد روى إعجازه","عن سماع كل من كان معه",7,"ع",2,0],["أَينَ طَسمٌ وَجَديسٌ وَالأُلى","عَمَروا الدُنيا بِأَموالٍ وَآلِ",8,"ل",1,0],["أين طود الحلم الذي يخسأ إلا","جلال عن بصائر الأحلام",9,"م",1,0],["أين طه من الكليم المنادي","اخلع النعل حيث جئت الوادي",10,"د",2,0],["أين طوس من يثرب إذ ترامت","بابن موسى النوى عن الأوطان",11,"ن",1,0],["أَين طَرفٌ ما تلهّى","أَين قَلبٌ ما تسلّى",12,"ل",2,0],["أَئِن طُلِّقتِ أَصبَحتِ","عَنِ الإِسلامِ مُرتَدَّه",13,"د",2,0],["أين طيف من البراءات يبدو","حالما في مواكب الأفراح",14,"ح",1,0],["أَيْنَ طَلعُ ( الْبَدْرِِ ) يَرْنُو ، يَجْتَبِينا ؟","أََينِ مَجدٌ يَا ( صَلاحَ الدّيِنِ) فِينَا",15,"ن",2,0]]}