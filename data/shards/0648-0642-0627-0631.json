oem/140008","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62877","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127017","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45237","الطويل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104858","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91230","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91199","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117992","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117889","السريع"],[3785,"","https://poetry.dctabudhabi.ae/diwan/poem/107316","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111425","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105111","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114012","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83472","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58010","الطويل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96064","الطويل"],[4755,"حُداءُ الغَريب","https://www.poetsgate.com/ViewPoem.aspx?id=184578",""],[4883,"تعب راحة","https://www.poetsgate.com/ViewPoem.aspx?id=48437",""],[5136,"لن تسع الناس بالنوال ولا","https://www.poetsgate.com/ViewPoem.aspx?id=121753",""],[5183,"من وحي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=180196",""],[5183,"الموقف الحق","https://www.poetsgate.com/ViewPoem.aspx?id=180156",""],[5187,"حوار مع القلب","https://www.poetsgate.com/ViewPoem.aspx?id=29064",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[709,"خطبتَ المجدَ بالأسلِ العوالي","https://www.poetsgate.com/ViewPoem.aspx?id=2924",""],[5579,"مهرة","https://www.poetsgate.com/ViewPoem.aspx?id=186470",""],[5817,"حماة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=199671",""],[6019,"ل (عروس البحر) بعض النبض","https://www.poetsgate.com/ViewPoem.aspx?id=198963",""],[6031,"وقَارِئٍ يُوْقِرُ الأَسْمَاعَ مَنْطِقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46331",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""]],"verses":[["وَقارَعتُ مَن أَعياكَ قَبلَ قِراعِهِ","فَدامَجَني بَعدَ التَشاوُرِ وَالبُغضِ",0,"ض",1,0],["وَقارَعَني دَهري عَلَيهِ فَحازَهُ","أَلا إِنَّ أَقرانَ اللَيالي غَوالِبُ",1,"ب",1,0],["وَقارٌ يُهابُ وَنادٍ يُنابُ","وَحِلمٌ يُراحُ وَرَأيٌ يُغَبّ",2,"ب",1,0],["وَقارِب بِذي جَهلٍ وَباعِد بِعالِمٍ","جَلوبٍ عَلَيكَ الحَقَّ مِن كُلِّ مَجلَبِ",3,"ب",1,0],["وَقارَبَت مِن جَناحَيها وَجُؤجُئِها","سَكّاءَ تَثني إِلَيها لَيِّناً خَصِفا",4,"ف",2,0],["وَقارِيَةٍ أَحواضَ مَجدِكَ دونَها","ذِياداً يُبيلُ الحاضِناتِ سَخالَها",5,"ل",3,0],["وقارُكَ زادَ الملك عزاً وهيبةٌ","وسوَّغه في رحمة الله منهلا",6,"ل",2,0],["وقارك في حزم الأمور وَقارُه","وبشرك في صنع المعارف بشره",7,"ر",2,0],["وَقارَبتُ مِن كَفَّيَّ ثُمَّ نَزَعتُها","بِنَزعٍ إِذا ما اِستُكرِهَ النَزعُ مُحلِجِ",8,"ج",1,0],["وَقارَبَ حَتّى أَطمَعَ الغُمرَ نَفسَهُ","مُكاذَبَةً في خَتلِهِ وَخِداعِهِ",9,"ع",2,0],["وَقارَعتُمُ في الحَقِّ مَن كانَ أَهلُهُ","بِباطِلِ سَيبُختَ الضَلالِ وَذَكَّرا",10,"ر",2,0],["وَقارُ الحِلمِ يَقرَعُ كُلَّ جَهلٍ","وَعَزمُ الصَبرِ يَنهَضُ بِالجَليلِ",11,"ل",1,0],["وَقَارٌ بِلا كِبْرٍ وَصَفْحٌ بِلا أَذَىً","وَجُودٌ بِلا مَنٍّ وَحِلْمٌ بِلا ذُلِّ",12,"ل",1,0],["وَقارَعَني مُلكُ الشَبابِ فَأَصبَحَت","عُيونُ المَها الإِنسِيِّ تَنقُضُني نَقضا",13,"ض",2,0],["وَقارَفَت وَهيَ لَم تَجرَب وَباعَ لَها","مِنَ الفَصافِصِ بِالنُمِّيِّ سِفسيرُ",14,"ر",1,0],["وَقارِئِكُم يَرجو بِتَطريبِهِ الغِنى","فَآضَ كَما غَنّى لِيَكسَبَ زَلزَلُ",15,"ل",1,0],["وقَارَعْت مَن يَبْغِي قِرَاعِي منهم","بأَحْلامِ بَطْشٍ أَوْ بِطَيْش حلُومِ",16,"م",1,0],["وَقَارُهُ الرَّأْي مِنْ مَيَامِين","لاَ يُجَارُونً فِي مَجَالِ",17,"ل",1,0],["وقارَعْتَ حتَّى ليسَ في الأرضِ خالعٌ","وأَعطَيْتَ حتَّى ليسَ في الأرْضِ مُعْدِمُ",18,"م",1,0],["وقارنت في منزلي زوجة","أطالت وأنجب انجابها",19,"ب",3,0],["وَقاريءٌ يُمعن في دَرسِهِ","نَفس المُحبين فَدا نَفسِهِ",20,"س",2,1],["وَقارَعَت عَن ثُغورِ المُسلِمينَ قَناً","سُمرٌ مَوارِدُها اللَبّاتُ وَالثُغَرُ",21,"ر",1,0],["وقارها يخلب الحجى","وحسنها يخلب النظر",22,"ر",1,0],["وَقارَعَ مِن بُناةِ المَجدِ آلَ ال","مُظَفَّرِ عَنكِ أَنجادٌ كِرامُ",23,"م",1,0],["وَقَارِئِ الْحِلْيَةِ ذَا نَغَمٍ","تُزِيلُ عَنْ قَلْبِ صَدٍ غَيَّهْ",24,"ي",2,0],["وقارِبُنا يَسري على مائِكِ الذي","عَليهِ فؤادي ذابَ والمدمَعُ انتَثر",25,"ر",1,0],["وَقارِقَةٍ مِنَ الأَيّامِ لَولا","سَبيلُهُمُ لَزاحَت عَنكَ حينا",26,"ن",2,0],["وقارى تواريخ الملوك كأنه","لقد عاش من ذاك الزمان الى الآن",27,"ن",1,0],["وَقارٌ بِه تُرسى البسيطةُ عندما","نَمرُّ كمرِّ السحبِ أوتادها هبطا",28,"ط",2,0],["وَقارن السَعد تَوفيق العِناية مِن","مَولاك وَالحَظّ قَد والاك أَوفَرهُ",29,"ر",2,0],["وقارِب في العُلوم وكُن تَقيّاً","وإلا لِم دُعيتَ أبا التَّقِيِّ",30,"ي",1,0],["وقارنَ الحمدَ ثناءً بِما","أولَى فَنادَيتُهما سِيرا",31,"ر",2,0],["وقارٌ وتدبير وحسنُ سياسةٍ","وخلقٌ طيب النَّدِّ من غير ما نِدِّ",32,"د",1,0],["وقارَنَتْ مِنْكَ معروفًا بمَعْرِفَةٍ","ولم تَزَلْ تقرِنُ الإِحْسانَ بالْحَسَنِ",33,"ن",1,0],["وقارَفَ قَبْلَ الموتِ والبَعْثِ قَرْقَفاً","يعاجلُه منها مُميتٌ وباعِثُ",34,"ث",1,0],["وقارٌ تخفّ له الراسياتُ","وتسكنُ خافقةُ الصرصرِ",35,"ر",1,0],["وقارعوكم على العلا سفَهاً","فما وفى بالمدجَّج الحاسرْ",36,"ر",1,0],["وقارَكَ والتفتْ تَرَهُنَّ بِيضاً","كَبِرتَ فقلتُ مِسكينُ الكبيرُ",37,"ر",1,0],["وقاربتُ من خَطوِي رِضاً بقضائِهِ","ولي بين أحداثِ الزمانِ وُثوبُ",38,"ب",1,0],["وقارُهُ والعزْمُ من أمْرهِ","شُمُّ الرَّواسي وصُدورُ النَّصال",39,"ل",1,0],["وقاريّ القميص له ذماء","تقطع دونه مهج الضَّبابِ",40,"ب",1,0],["وقارَعْتَ الخُطوبَ السودَ حتّى","أرَضْتَ جوامحَ النّوَبِ العُضالِ",41,"ل",1,0],["وَقَارَبَ الكَمالا","وزَاحَمَ الرِّجالا",42,"ل",2,0],["وقاربوا أن يجعلوا ملة","عظيمة المتبوع والتابع",43,"ع",1,0],["وقارىء فكري لْلمحَاسِن تالياً","على دَرْس آيات الجمالِ يواظبُ",44,"ب",1,0],["وَقارِض هُمومَ النَّفسِ بِالسَّيرِ وَالسُّرى","عَلى ثِقَةٍ بِاللَهِ في نَيلِكَ الرِبحا",45,"ح",2,0],["وقارهم فرض على كل مسلم","وحبهم عقد وبغضهم كفر",46,"ر",1,0],["وَقارٌ كطوْدٍ في سُكونٍ ورِفْعةٍ","وبِشْر كَزَهرِ الرّوضِ أو هو أملَحُ",47,"ح",1,0],["وَقارَبوا سورَهُ والسّورُ راكبُه","أُسْدٌ وَلَو أَنَّهم وَقتَ الوغى ميلُ",48,"ل",1,0],["وقارعتُ بالبيضاء كل متوَّج","تُملك قسراً نفسه وحلائله",49,"ل",2,0],["وَقَارَنَ شَمْسَ خَدَّيْهِ بِكَأسٍ","وَمَا أبْهَى اقْتِرَانَ النَّيِّرَيْنِ",50,"ن",1,0],["وَقَارَضَنَا الضَّنَى كيلاً بِكَيْلٍ","فَيَا وَيْلاَهُ إنْ لَمْ أوفِ كَيْلَهْ",51,"ل",2,0],["وَقارعتُ عنها كلّ ملك متوّج","تُحيط به من حيث حلّ الكتائبُ",52,"ب",1,0],["وَقاري أُسودِ الغابِ بِالصِيدِ مِثلَما","إِذا اِضطَرَبَ الخَطِّيُّ مِن فَوقِ جُدرانِ",53,"ن",1,0],["وقارب واتئد فيما","تحاوله من العمل",54,"ل",1,0],["وَقارح هَمّ غَداةَ الذعرِ","بِالضَّربِ أَحياناً وَطَعنِ شَزرِ",55,"ر",1,0],["وقارن ذي البشاير خير بشرٍ","سعيدٍ خلَّد المولى اقترانَهْ",56,"ن",2,0],["وقارَعْتُها عمَّا أُريد بِهِمَّةٍ","طَموحٍ مَتَى أَقْرَعُ بِها لا أُقرَّعِ",57,"ع",1,0],["وقارئ في العلى حم سجدته","يقرا ويسجد والمحبوب رائيه",58,"ي",2,0],["وقارب وسددو واصمتن واترك الهوى","واياك أن تبثت ضميرك للغير",59,"ر",1,0],["وقارب وسدد واطو بسط بطالة","وبسط انبساط في الغواية والصد",60,"د",1,0],["وقارضته الود وزناً بوزن","وكيلا بكيل على ما أزادا",61,"د",2,0],["وقارئ القرآن أو من يروي","حديثه مفتقر للنحو",62,"و",1,0],["وقارعَ حتَّى كلُّ مضاء فكرةٍ","ثناه بحدِّ القول وهو كليلها",63,"ل",3,0],["وَقَارَع بالشُّورى حُرَيثُ بنُ جَابرٍ","وَفَازَ بِهَا لَوْلاَ الحُضَيْنُ بْنُ مُنْذِرِ",64,"ر",1,0],["وقارعَ دونها الحدثانَ مَلْكٌ","سما عنْ كلِّ فوقٍ فهو دون",65,"ن",1,0],["وَقارَفتُ في رَيق الشَبابِ مَخازِياً","أَلَحَّت عَلى ما كانَ من شرفِ القَدر",66,"ر",1,0],["وقارن البدر شمس المجد يا لك من","قران سعد جلا عنا الحناديسا",67,"س",2,0],["وَقارِن اِذا قارَنت حراً فَإِنَّما","يَزينُ وَيُزري بِالفَتى قُرناؤُه",68,"ا",3,0],["وقارع أهوالاً تنوء بحملها","ليوث الوغى لكنه الرجل الجلد",69,"د",1,0],["وقارن ما بين اسمه واسم أحمد","فجاحده لا شكَّ لله يجحد",70,"د",1,0],["وَقارَبتُ في أِشياءَ لَو أَنَّهُم مَعي","لِباعَدتُ حَتّى تَستَقيمَ التَوابِعُ",71,"ع",1,0],["وَقارَعَني ذُلانِ عَيش عَلَى النَّدى","كَما قارَعَ الغَيرانُ عَن بَيضَةِ الخِدرِ",72,"ر",1,0],["وقارة عدنان التي انتصبت لها","قناة لها من آل قيدرا كعب",73,"ب",1,0],["وقار وآداب وحلم وعفة","ورقة طبع ليس عنها بآبب",74,"ب",1,0],["وقار رئيس في إهابة ناسكٍ","وظرف أديبٍ في تبتل راهب",74,"ب",1,0],["وقارعت فيك الدهر حتى غلبته","فبعدك أضحى الدهر يوسعني قرعا",75,"ع",2,0],["وقاربنا حتى به اتحد الهوى","وما كان عنا بالبعيد المجانب",76,"ب",1,0],["وقارنت طلعة للبدر مشرقة","أضواؤها من رآها نوره بهره",77,"ر",2,0],["وقاراً فإن الدهرَ ألوى مُصمِّماً","وفي أذنه وقُرٌ لمن يخصم الألوا",78,"ل",3,0],["وقارحاً غيرَ التَّعْدَاءُ طَلْعَتَهُ","فليس تعرفُ الاَّ الردفَ والهَادي",79,"د",2,0],["وقارَبْتُ من مَرْمَى الأشُدّ رَمِيّةً","تُقَرْطِسُها منْ حادِثِ الدّهْرِ أسْهُمُ",80,"م",1,0],["وقارع عن دين الهدى في صوارم","بايماضها شمل الضلال تفرقا",81,"ق",2,0],["وَقارِبَ إِذا ما لَم تَجِد لَكَ حيلَةً","وَصَمِّم إِذا أَيقَنَتَ أَنَّكَ عاقِرُهْ",82,"ر",2,0],["وقارضته الود وزناً بوزن","وكيلا بكيل على ما ارادا",83,"د",2,0],["وَقارنَ بَدرُ المَجد شَمسَ نَزاهةٍ","قرانَ اعتزازٍ وَالدَوامُ تَكفَّله",84,"ل",2,0],["وَقارنت الأَحكامُ إِحكامَ وَضعِها","فَلَم يَشك ظَلّامٌ وَلم يَخشَ عادل",85,"ل",1,0],["وقارع حتى لم يدع سيف باسل","بمعترك الهيجاء غير مثلم",86,"م",1,0],["وقارن بالعز أنجاله","ولا برحوا في النعيم المقيم",87,"م",1,0],["وقارفوا ما حرّم الله من","أكل الرّبا والفحش والمسكرات",88,"ت",1,0],["وَقارَنَها سَعدُ السُعُودِ بِمنزِلٍ","يَدورُ عَلى قُطبِ السَعَادَةِ وَالحَمدِ",89,"د",1,0],["وقارسا أصبح برد اليوم","والخل أضحى قارصاً يا قوم",90,"م",1,0],["وقَارِيا ذاتُ لِسانِ البَربَرِ","جاءَت أَهالِيها وُفُوداً تَنبَرِي",91,"ي",1,0],["وقارعهم لما رآهم إذا دعوا","إلى الحق أبدوا عن دعاه النعاميا",92,"ي",2,0],["وقارعه إن شن العوادي مناجزاً","ببأس تحاماه العوادي الفوادح",93,"ح",1,0],["وقاربتُ البياضَ فجانبتني","مودةُ بيضها السُّودِ القرونِ",94,"ن",1,0],["وقارنها بدار عزت ملوكها","في أول دهر كانت فيه وقائع",95,"ع",1,0],["وَقاربوا بينَكُم يا قوم واِتّحدوا","وَأَصلِحوا ما اِستَطَعتم شَأنكُم حالا",96,"ل",2,0],["وقارَنَ شُكرَ الوالدين بشكره","له المنُّ والآلاءُ والحمدُ والمجدُ",97,"د",1,0],["وقاري وعلمي بالشراب وأهلهِ","وما نادَم القوم الكرام كذي الحجر",98,"ر",1,0],["و(قَارُونَ) الذي وَلَّى ثَرِيَّاً, عَاوَدَ الإثرَاءْ","وَجَدْتُ (زُلَيْخَةَ) الكُبْرَى عَجُوزَاً تُتقِنُ الإغراءْ",99,"ا",2,0],["وقارئ فتّش بأبياتي المُتعبة","عن بقايا تعب راحة، لقاه تْعَبي!",100,"ب",2,0],["وقارئ غازل أحلامي وأنا أرتبه","وبعثر سنيني الحلوة على مكتبي",100,"ب",2,0],["وقارب الناس في طباعهم","فالناس ما أنت عنهم بغن",101,"ن",1,0],["وقارعها الفاروق شرقاً ومغربا","فحطم سيف الشرك تحت صليبه",102,"ب",2,0],["وقارعته دون آماله","آلامه بالطعن والضرب",103,"ب",1,0],["وقارَبَ منهما ونأى","وقسَّم روحَهُ شِيعا",104,"ع",2,0],["وقارعني بأصعب مرتيه","وأمكن نابه حتى أغارا",105,"ر",2,0],["وَقَارَعْتَ الخُطُوبَ السُودَ حَتَّى","أرضتْ جوانحَ النّوبِ العضالِ",106,"ل",1,0],["وَقَارُهَا واحْتِرامُ الذَاتِ مَا مَنَعَا","أَمِيّرَةَ الدَهْرِ أَنْ تَرْقى إِلىَ الشُهُبِ",107,"ب",1,0],["وقارع بالخطوب عظيمَ صبرٍ","وكفَّ النفسَ عن لعقِ الفُتاتِ",108,"ت",1,0],["وقَارِبٌ داعبَ الأمواجَ ذاكرةً","لهُ .. ف منها تداعى البعضُ والكُلُّ",109,"ل",1,0],["وقَارِئٍ يُوْقِرُ الأَسْمَاعَ مَنْطِقُهُ","إذَا تَلا جَرَّعَ اللَّذاتِ والغُصَصَا",110,"ص",2,1],["وقار مهيب في القوام منطّق","وبرق من الأحداق في اللحظ لاهب",111,"ب",1,0]]}