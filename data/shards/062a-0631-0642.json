{"poems":[[53,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[93,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[88,"وفي الألعاب لم تر قط عيني","https://www.aldiwan.net/poem44395.html","الوافر"],[88,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"تأوب كالبدر في جنحه","https://www.aldiwan.net/poem18484.html","المتقارب"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[51,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[29,"غدا ابنا وائل ليعاتباني","https://www.aldiwan.net/poem6060.html","الوافر"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[79,"ترقّب إذا جنّ الظلام زيارتي","https://www.aldiwan.net/poem29565.html","الطويل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[62,"عليك أقمت أرسال الكلام","https://www.aldiwan.net/poem52266.html","الوافر"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[61,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[61,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[61,"قضى بوقوف الركب حق المواقف","https://www.aldiwan.net/poem51551.html","الطويل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[49,"ألا نحن في دار قليل بقائها","https://www.aldiwan.net/poem10315.html","الطويل"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[74,"تعلقته نشوان من خمر ريقه","https://www.aldiwan.net/poem12946.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[46,"ترقبن الهواء بلطف رب","https://www.aldiwan.net/poem23100.html","الوافر"],[8,"بالأرض أستاهم عجزا وأنفهم","https://www.aldiwan.net/poem21763.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42582","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54854","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54240","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[50,"أ\"حارثَ\" علِّلني وإنْ كنتُ مسهَبا","https://www.poetsgate.com/ViewPoem.aspx?id=15957",""],[45,"أُحاجِيكَ، هل للحُبّ كالدّارِ تَجمعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31224",""],[113,"بأية حجة منع الوصالا","https://www.aldiwan.net/poem40620.html","عموديه"],[113,"اخا الاشجان حي على الفلاح","https://www.aldiwan.net/poem41176.html","عموديه"],[118,"لهان علي أن ألقى حمامي","https://www.aldiwan.net/poem49367.html","الوافر"],[130,"سرى الطيف من لبنى فهاج الضنى وهنا","https://www.aldiwan.net/poem54730.html","الطويل"],[130,"زرنا الفتى دود فال المقتفي الكرما","https://www.aldiwan.net/poem54751.html","البسيط"],[140,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[141,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[148,"أصخ فلخير العالمين مناقب","https://www.aldiwan.net/poem68460.html","الطويل"],[148,"مديح نبي الله أزكى التعبد","https://www.aldiwan.net/poem68603.html","الطويل"],[158,"يساري في يمينك لا تزال","https://www.aldiwan.net/poem58723.html","الخفيف"],[158,"أيملك طرفي دمع عينيه قانيا","https://www.aldiwan.net/poem58942.html","الطويل"],[184,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[197,"بدت قمرا له حظي ليالي","https://www.aldiwan.net/poem45380.html","الوافر"],[233,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[278,"أيا بين ما سلطت إلا على ظلمي","https://www.aldiwan.net/poem60729.html","الطويل"],[280,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[295,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[296,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"],[296,"على الزعازع والأهوال والبأس","https://www.aldiwan.net/poem36834.html","البسيط"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[347,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[374,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[397,"مواكب خير ، موكب إثرموكب","https://www.aldiwan.net/poem4595.html","عموديه"],[399,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[400,"تشابه حالنا في كل فن","https://www.aldiwan.net/poem33386.html","الوافر"],[400,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[400,"أنار تشك ألهبت طي قرطاس","https://www.aldiwan.net/poem33727.html","الطويل"],[400,"على قدر قد جاء في ليلة القدر","https://www.aldiwan.net/poem33904.html","الطويل"],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[403,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[413,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[413,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[436,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[451,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[456,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[456,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[477,"عتاب يا حطيئة أم هجاء","https://www.aldiwan.net/poem37174.html","الوافر"],[496,"أغار على الصب من أنبه","https://www.aldiwan.net/poem3703.html","المتقارب"],[498,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[498,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[498,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[498,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[498,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[536,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[556,"أسقي نداماي من كاسي وأشرب ما","https://www.aldiwan.net/poem34312.html","البسيط"],[556,"مقام بني الصديق ذروة فرقد","https://www.aldiwan.net/poem34602.html","الطويل"],[561,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[573,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[584,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"]],"verses":[["تَرَقى الدُموعُ وَيَرعُوي جَزعُ الفَتى","وَيَنامُ بَعدَ تَفَرُّقِ الأَقرانِ",0,"ن",1,0],["تُرقي وَتَلذَعُ في القُلوبِ وَإِن يَشا","حَطَّ النَجومَ بِها مِنَ الأَبعادِ",1,"د",1,0],["تَرَقّوا عَليها كُلَّ مَجدٍ وَنَكَّسوا","بِأَطرافِها عَن عاقِداتِ السَباسِبِ",2,"ب",1,0],["تَرْقَى بِهِ فِي مَلَكُوتِ العُلَى","إَلى مَقَرِّ المَلإَ الهَانِي",3,"ن",2,0],["تَرقَّبْ عِقَابَ اللهِ فِيهِمْ هُنَيْهَة","تَجِدْ عِيدَهُمْ هَذَا تَحَوَّلَ مَأَتْمَا",4,"م",2,0],["ترقرقُ فيها مياه العلو","م جداول تجري ولا تنضب",5,"ب",1,0],["ترقرق منساباً به الماء والسنى","فلم أدر أيّ اللامعين يسيب",6,"ب",1,0],["تَرقى وَتَطعَنُ في العِنانِ وَتَنتَحي","وِردَ الحَمامَةِ إِذ أَجَدَّ حَمامُها",7,"م",3,0],["تَرَقَّيتُم إِليَّ صُعُودَ عِزٍّ","سَيَبهَرُكُم وَقُلتُم قَد هُجِينَا",8,"ن",2,0],["ترقى به محمود مرقى الهلال","فلاحظ الضدّ في نبحه",9,"ح",2,0],["ترقى ابن فضل الله في الفضل غاية","قضت ذلَّ شانيه وعزّ صفيه",10,"ي",2,0],["ترقع من فروتها صدعها","وحيلة الإنسان رقّاعه",11,"ع",2,0],["تَرَقّوا في النَخيلِ وَأَنسِئونا","دِماءَ سَراتِكُم يَومَ الكُلابِ",12,"ب",1,0],["تَرقى كَما تَرقى المَصا","عِدُ ثُمَّ تَهبِطُ كَالصُخورِ",13,"ر",1,0],["ترقرق ماء الحسن في وجهها الذي","هو البدر ليل التِمِّ أو هو أجمل",14,"ل",1,0],["ترقّب إذا جنّ الظلام زيارتي","فإنّي رأيت الليل أكتم للسرِّ",15,"ر",1,1],["تَرَقَّت لَهُ الأَسواءُ حَتّى اِرتَقَيتَهُ","فَقُمتَ بِها في بَعضِ ما تَتَنَكَّبُ",16,"ب",1,0],["ترقرقُ في شمائلهِ المساعي","وقاراً دونهُ رَعْنا شمامِ",17,"م",1,0],["تَرَقّى النُجومَ موهِناً مِن وَرائِها","طَلائِحُ قَد كادَت مِنَ الوَنيِ تَطلُعُ",18,"ع",1,0],["تَرقى رِياشُ جَناحَيهِ إِذا نَهَضَت","بِهِ قَوادِمُ أَخوالٍ وَأَعمامِ",19,"م",1,0],["ترقْرَقُ في نَواظِرها دُموعٌ","أحَبُّ إلى النَّواظرِ من كَراها",20,"ا",3,0],["تَرْقا الدُّموعُ ولي على آثارهم","دَمْعٌ رَقاه العاذلون فما رَقا",21,"ق",2,0],["تَرقرَقَ ماءُ الطَّبعِ في وَجَناتِه","تَرَقرُقَ إفرنْدِ السّيوفِ الرَّهائفِ",22,"ف",1,0],["تَرَقَّبَها الصَّيَّادُ يَوْماً فقادَها","كما قُدْتَ بالرِّفقِ الجَوادَ المُقيَّدا",23,"د",2,0],["تَرَقَّ مِنَ الدُنيا إِلى أَيِّ غايَةٍ","سَمَوتَ إِلَيها فَالمَنايا وَراؤُها",24,"ا",3,0],["تَرَقَّت مُناهُ طَودَ عِزٍّ لَوِ اِرتَقَت","بِهِ الريحُ فِتراً لَاِنثَنَت وَهيَ ظالِعُ",25,"ع",1,0],["تُرَقرِقُ ماءً مُقلَتايَ وَوَجهِهِ","وَيُذكي عَلى قَلبي وَوَجنَتِهِ الجَمرُ",26,"ر",1,0],["ترقَّت بُروجَ العزِّ فيهِ بَواذِخاً","لَها مِن صَميمِ العَزمِ وَالحَزمِ سُلَّمُ",27,"م",1,0],["تَرقَدُّ في رَيعانِها المُرقَدِّ","وَعاصِفٍ مِن آلِها المُشتَدِّ",28,"د",1,0],["تَرَقَّبنَ الهَواءَ بِلُطفِ رَبٍّ","قَديرٍ إِن تَرَكتِ لَهُ هَواكِ",29,"ك",1,1],["تَرَقُّشَ العَثِّ فِي بَطنِ الأَدِيمِ فَما","نَالُوا بِذلِكُمُ تَقوىً وَلا نَشَبا",30,"ب",2,0],["تَرقَّى فلمَّا اشتد ساعده عتا","وَبات يغيظ الشرقَ والشرق يكظم",31,"م",1,0],["ترقب سقوطاً يا ابن آدم قاتلا","فإنك لو تدري على جرف هار",32,"ر",1,0],["تَرقى إلى حرم أشم طرافه","يَسع الفَضاء وَلَيسَ بالمَنظور",33,"ر",1,0],["تُرقِّصُ الموجَ إنْ مَسَّتْهُ أجنحُها","كقلبِ آدمَ إذ مَسَّتْهُ حواءُ",34,"ا",2,0],["تَرَقَّبِي سِنَةَ الْحُرَّاسِ وانْطَلِقِي","بَيْنَ الْخَمَائِلِ مِنْ لُبْنَانَ وَارْتَادِي",35,"ي",1,0],["تَرْقى المَعَارِجَ مِن سَبِي","لَيْنِ المَضَاءِ وَالاجْتِهَادْ",36,"د",1,0],["ترِقُّ فِيهَا فَتَصْفُو","نُوراً وَتَخْلُصُ نَشْرَا",37,"ر",2,0],["تَرِقّ حَواشيهِ وَيَظرُفُ طَبعُهُ","وَآدابُهُ حَتّى يُقال تَبَغدَذا",38,"ذ",2,0],["ترقَّبَتْ مصرُ فيه الصُّبْحَ مبتسما","يلُوحُ بالْخَير والإسعادِ سَافرُه",39,"ر",2,0],["ترقرقُ في جِنْحِ الظَّلامِ فينجَلي","وَتُرْهِجُ في صَدْرِ النَّهارِ فيُظلِمُ",40,"م",1,0],["ترقَّبُ فينا العاذلينَ على الهوى","وما نال عيشاً قبلنا منْ ترقَّبا",41,"ب",2,0],["تَرقى النَّجومَ مَوهِنا مِن وَرائها","طَلاَئِحُ قَدْ كادت من الوَاني تطْلعُ",42,"ع",1,0],["ترقرق فيه ماء الحسن حتى","تقاطر منه شمائله وسالا",43,"ل",2,0],["ترقرق فيه ماء الحسن حتى","جلا بالوجه طالعة الصباح",44,"ح",1,0],["ترقرق عنده غدران ماءٍ","على ضفاتها أثر الهوامي",45,"م",2,0],["تَرَقَّى ِإلَى العَليَا عَلَى نُجبِ عَزمِهِ","وقَاسِي عَلَى إِدرَاكِهَا السَّهلَ والحَزنَا",46,"ن",2,0],["تَرقَى وتَسفُلُ مهما كُنتَ عَالِيَهَا","طِبقَ المُنَى وتَذُودَ الأَينَ والسَّامَا",47,"م",2,0],["ترقَّبوها من الجُودى كامنةً","في نقعها ككمون الشمس في الطَّفلِ",48,"ل",1,0],["تَرقى إِلَيهِ كُلَّ يَومٍ فَرسَخاً","وَسِواكَ يَرقى كُلَّ يَومٍ إِصبَعا",49,"ع",2,0],["ترقى إلى السبع الطباق ترقِّياً","حقيقاً ولم يعبر سفينا ولا جسرا",50,"ر",2,