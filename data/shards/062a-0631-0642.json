,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[416,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[416,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[439,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[453,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[458,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[458,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[458,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[464,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[479,"عتاب يا حطيئة أم هجاء","https://www.aldiwan.net/poem37174.html","الوافر"],[498,"أغار على الصب من أنبه","https://www.aldiwan.net/poem3703.html","المتقارب"],[500,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[500,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[500,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[500,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[500,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[538,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[558,"أسقي نداماي من كاسي وأشرب ما","https://www.aldiwan.net/poem34312.html","البسيط"],[558,"مقام بني الصديق ذروة فرقد","https://www.aldiwan.net/poem34602.html","الطويل"],[563,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[586,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"]],"verses":[["تَرَقى الدُموعُ وَيَرعُوي جَزعُ الفَتى","وَيَنامُ بَعدَ تَفَرُّقِ الأَقرانِ",0,"ن",1,0],["تُرقي وَتَلذَعُ في القُلوبِ وَإِن يَشا","حَطَّ النَجومَ بِها مِنَ الأَبعادِ",1,"د",1,0],["تَرَقّوا عَليها كُلَّ مَجدٍ وَنَكَّسوا","بِأَطرافِها عَن عاقِداتِ السَباسِبِ",2,"ب",1,0],["تَرْقَى بِهِ فِي مَلَكُوتِ العُلَى","إَلى مَقَرِّ المَلإَ الهَانِي",3,"ن",2,0],["تَرقَّبْ عِقَابَ اللهِ فِيهِمْ هُنَيْهَة","تَجِدْ عِيدَهُمْ هَذَا تَحَوَّلَ مَأَتْمَا",4,"م",2,0],["ترقرقُ فيها مياه العلو","م جداول تجري ولا تنضب",5,"ب",1,0],["ترقرق منساباً به الماء والسنى","فلم أدر أيّ اللامعين يسيب",6,"ب",1,0],["تَرقى وَتَطعَنُ في العِنانِ وَتَنتَحي","وِردَ الحَمامَةِ إِذ أَجَدَّ حَمامُها",7,"م",3,0],["تَرَقَّيتُم إِليَّ صُعُودَ عِزٍّ","سَيَبهَرُكُم وَقُلتُم قَد هُجِينَا",8,"ن",2,0],["ترقى به محمود مرقى الهلال","فلاحظ الضدّ في نبحه",9,"ح",2,0],["ترقى ابن فضل الله في الفضل غاية","قضت ذلَّ شانيه وعزّ صفيه",10,"ي",2,0],["ترقع من فروتها صدعها","وحيلة الإنسان رقّاعه",11,"ع",2,0],["تَرَقّوا في النَخيلِ وَأَنسِئونا","دِماءَ سَراتِكُم يَومَ الكُلابِ",12,"ب",1,0],["تَرقى كَما تَرقى المَصا","عِدُ ثُمَّ تَهبِطُ كَالصُخورِ",13,"ر",1,0],["ترقرق ماء الحسن في وجهها الذي","هو البدر ليل التِمِّ أو هو أجمل",14,"ل",1,0],["ترقّب إذا جنّ الظلام زيارتي","فإنّي رأيت الليل أكتم للسرِّ",15,"ر",1,1],["تَرَقَّت لَهُ الأَسواءُ حَتّى اِرتَقَيتَهُ","فَقُمتَ بِها في بَعضِ ما تَتَنَكَّبُ",16,"ب",1,0],["ترقرقُ في شمائلهِ المساعي","وقاراً دونهُ رَعْنا شمامِ",17,"م",1,0],["تَرَقّى النُجومَ موهِناً مِن وَرائِها","طَلائِحُ قَد كادَت مِنَ الوَنيِ تَطلُعُ",18,"ع",1,0],["تَرقى رِياشُ جَناحَيهِ إِذا نَهَضَت","بِهِ قَوادِمُ أَخوالٍ وَأَعمامِ",19,"م",1,0],["ترقْرَقُ في نَواظِرها دُموعٌ","أحَبُّ إلى النَّواظرِ من كَراها",20,"ا",3,0],["تَرْقا الدُّموعُ ولي على آثارهم","دَمْعٌ رَقاه العاذلون فما رَقا",21,"ق",2,0],["تَرقرَقَ ماءُ الطَّبعِ في وَجَناتِه","تَرَقرُقَ إفرنْدِ السّيوفِ الرَّهائفِ",22,"ف",1,0],["تَرَقَّبَها الصَّيَّادُ يَوْماً فقادَها","كما قُدْتَ بالرِّفقِ الجَوادَ المُقيَّدا",23,"د",2,0],["تَرَقَّ مِنَ الدُنيا إِلى أَيِّ غايَةٍ","سَمَوتَ إِلَيها فَالمَنايا وَراؤُها",24,"ا",3,0],["تَرَقَّت مُناهُ طَودَ عِزٍّ لَوِ اِرتَقَت","بِهِ الريحُ فِتراً لَاِنثَنَت وَهيَ ظالِعُ",25,"ع",1,0],["تُرَقرِقُ ماءً مُقلَتايَ وَوَجهِهِ","وَيُذكي عَلى قَلبي وَوَجنَتِهِ الجَمرُ",26,"ر",1,0],["ترقَّت بُروجَ العزِّ فيهِ بَواذِخاً","لَها مِن صَميمِ العَزمِ وَالحَزمِ سُلَّمُ",27,"م",1,0],["تَرقَدُّ في رَيعانِها المُرقَدِّ","وَعاصِفٍ مِن آلِها المُشتَدِّ",28,"د",1,0],["تَرَقَّبنَ الهَواءَ بِلُطفِ رَبٍّ","قَديرٍ إِن تَرَكتِ لَهُ هَواكِ",29,"ك",1,1],["تَرَقُّشَ العَثِّ فِي بَطنِ الأَدِيمِ فَما","نَالُوا بِذلِكُمُ تَقوىً وَلا نَشَبا",30,"ب",2,0],["تَرقَّى فلمَّا اشتد ساعده عتا","وَبات يغيظ الشرقَ والشرق يكظم",31,"م",1,0],["ترقب سقوطاً يا ابن آدم قاتلا","فإنك لو تدري على جرف هار",32,"ر",1,0],["تَرقى إلى حرم أشم طرافه","يَسع الفَضاء وَلَيسَ بالمَنظور",33,"ر",1,0],["تُرقِّصُ الموجَ إنْ مَسَّتْهُ أجنحُها","كقلبِ آدمَ إذ مَسَّتْهُ حواءُ",34,"ا",2,0],["تَرَقَّبِي سِنَةَ الْحُرَّاسِ وانْطَلِقِي","بَيْنَ الْخَمَائِلِ مِنْ لُبْنَانَ وَارْتَادِي",35,"ي",1,0],["تَرْقى المَعَارِجَ مِن سَبِي","لَيْنِ المَضَاءِ وَالاجْتِهَادْ",36,"د",1,0],["ترِقُّ فِيهَا فَتَصْفُو","نُوراً وَتَخْلُصُ نَشْرَا",37,"ر",2,0],["تَرِقّ حَواشيهِ وَيَظرُفُ طَبعُهُ","وَآدابُهُ حَتّى يُقال تَبَغدَذا",38,"ذ",2,0],["ترقَّبَتْ مصرُ فيه الصُّبْحَ مبتسما","يلُوحُ بالْخَير والإسعادِ سَافرُه",39,"ر",2,0],["ترقرقُ في جِنْحِ الظَّلامِ فينجَلي","وَتُرْهِجُ في صَدْرِ النَّهارِ فيُظلِمُ",40,"م",1,0],["ترقع أسمال أطفالها","وتحسو عروق يديها الإبر",41,"ر",1,0],["ترقَّبُ فينا العاذلينَ على الهوى","وما نال عيشاً قبلنا منْ ترقَّبا",42,"ب",2,0],["ترقّص الموج إذا مسّته أجنحها","كقلب آدم إذ مسّته حواء",43,"ا",2,0],["تَرقى النَّجومَ مَوهِنا مِن وَرائها","طَلاَئِحُ قَدْ كادت من الوَاني تطْلعُ",44,"ع",1,0],["ترقرق فيه ماء الحسن حتى","تقاطر منه شمائله وسالا",45,"ل",2,0],["ترقرق فيه ماء الحسن حتى","جلا بالوجه طالعة الصباح",46,"ح",1,0],["ترقرق عنده غدران ماءٍ","على ضفاتها أثر الهوامي",47,"م",2,0],["تَرَقَّى ِإلَى العَليَا عَلَى نُجبِ عَزمِهِ","وقَاسِي عَلَى إِدرَاكِهَا السَّهلَ والحَزنَا",48,"ن",2,0],["تَرقَى وتَسفُلُ مهما كُنتَ عَالِيَهَا","طِبقَ المُنَى وت