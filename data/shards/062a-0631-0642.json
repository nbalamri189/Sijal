//www.poetsgate.com/ViewPoem.aspx?id=166704",""],[5150,"أي قلب تملكين ...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203781",""],[5302,"عهد الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=201740",""],[5376,"عيش ذل يا قدسنا ما استطابا","https://www.poetsgate.com/ViewPoem.aspx?id=190450",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5409,"خلطاء من كل فج حضور","https://www.poetsgate.com/ViewPoem.aspx?id=155271",""],[5409,"عدتها والفكر منها","https://www.poetsgate.com/ViewPoem.aspx?id=155256",""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5569,"النبض والنبض الآخر","https://www.poetsgate.com/ViewPoem.aspx?id=60535",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5574,"في كنفِ الإلٰهِ مُهدهِداً بدراً","https://www.poetsgate.com/ViewPoem.aspx?id=206002",""],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5582,"أَرَى رَسْمَ سُعْدَى فِي فُؤادِيَ راسِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63581",""],[5582,"نَبا عضبُ السلوّ نبا","https://www.poetsgate.com/ViewPoem.aspx?id=63457",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5660,"ما أَصعَبَ الذِكرى عَلى الأَحبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=23715",""],[5691,"صهيل وصليل","https://www.poetsgate.com/ViewPoem.aspx?id=206153",""],[5720,"رسالة إلى ولدي ..","https://www.poetsgate.com/ViewPoem.aspx?id=198971",""],[5720,"تعليمُنا","https://www.poetsgate.com/ViewPoem.aspx?id=200439",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5768,"لِسانُ الضَّادِ فَخْرُ البلادِ !","https://www.poetsgate.com/ViewPoem.aspx?id=215276",""],[5880,"عيناك والأنجم","https://www.poetsgate.com/ViewPoem.aspx?id=210747",""],[5956,"توفي أحمدٌ صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=192504",""],[5989,"ليت أنك قد ذقتا","https://www.poetsgate.com/ViewPoem.aspx?id=181497",""],[6019,"رقصةٌ بفتنةِ الإشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=137042",""],[6032,"زائري في ليلة صيف","https://www.poetsgate.com/ViewPoem.aspx?id=181524",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[469,"ترق احاديث النسيم معانيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574802",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[6259,"ألمَّ خيالها بعد الهجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59388&r=&rc=36",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["تَرَقى الدُموعُ وَيَرعُوي جَزعُ الفَتى","وَيَنامُ بَعدَ تَفَرُّقِ الأَقرانِ",0,"ن",1,0],["تُرقي وَتَلذَعُ في القُلوبِ وَإِن يَشا","حَطَّ النَجومَ بِها مِنَ الأَبعادِ",1,"د",1,0],["تَرَقّوا عَليها كُلَّ مَجدٍ وَنَكَّسوا","بِأَطرافِها عَن عاقِداتِ السَباسِبِ",2,"ب",1,0],["تَرْقَى بِهِ فِي مَلَكُوتِ العُلَى","إَلى مَقَرِّ المَلإَ الهَانِي",3,"ن",2,0],["تَرقَّبْ عِقَابَ اللهِ فِيهِمْ هُنَيْهَة","تَجِدْ عِيدَهُمْ هَذَا تَحَوَّلَ مَأَتْمَا",4,"م",2,0],["ترقرقُ فيها مياه العلو","م جداول تجري ولا تنضب",5,"ب",1,0],["ترقرق منساباً به الماء والسنى","فلم أدر أيّ اللامعين يسيب",6,"ب",1,0],["تَرقى وَتَطعَنُ في العِنانِ وَتَنتَحي","وِردَ الحَمامَةِ إِذ أَجَدَّ حَمامُها",7,"م",3,0],["تَرَقَّيتُم إِليَّ صُعُودَ عِزٍّ","سَيَبهَرُكُم وَقُلتُم قَد هُجِينَا",8,"ن",2,0],["ترقى به محمود مرقى الهلال","فلاحظ الضدّ في نبحه",9,"ح",2,0],["ترقى ابن فضل الله في الفضل غاية","قضت ذلَّ شانيه وعزّ صفيه",10,"ي",2,0],["ترقع من فروتها صدعها","وحيلة الإنسان رقّاعه",11,"ع",2,0],["تَرَقّوا في النَخيلِ وَأَنسِئونا","دِماءَ سَراتِكُم يَومَ الكُلابِ",12,"ب",1,0],["تَرقى كَما تَرقى المَصا","عِدُ ثُمَّ تَهبِطُ كَالصُخورِ",13,"ر",1,0],["ترقرق ماء الحسن في وجهها الذي","هو البدر ليل التِمِّ أو هو أجمل",14,"ل",1,0],["ترقّب إذا جنّ الظلام زيارتي","فإنّي رأيت الليل أكتم للسرِّ",15,"ر",1,1],["تَرَقَّت لَهُ الأَسواءُ حَتّى اِرتَقَيتَهُ","فَقُمتَ بِها في بَعضِ ما تَتَنَكَّبُ",16,"ب",1,0],["ترقرقُ في شمائلهِ المساعي","وقاراً دونهُ رَعْنا شمامِ",17,"م",1,0],["تَرَقّى النُجومَ موهِناً مِن وَرائِها","طَلائِحُ قَد كادَت مِنَ الوَنيِ تَطلُعُ",18,"ع",1,0],["تَرقى رِياشُ جَناحَيهِ إِذا نَهَضَت","بِهِ قَوادِمُ أَخوالٍ وَأَعمامِ",19,"م",1,0],["ترقْرَقُ في نَواظِرها دُموعٌ","أحَبُّ إلى النَّواظرِ من كَراها",20,"ا",3,0],["تَرْقا الدُّموعُ ولي على آثارهم","دَمْعٌ رَقاه العاذلون فما رَقا",21,"ق",2,0],["تَرقرَقَ ماءُ الطَّبعِ في وَجَناتِه","تَرَقرُقَ إفرنْدِ السّيوفِ الرَّهائفِ",22,"ف",1,0],["تَرَقَّبَها الصَّيَّادُ يَوْماً فقادَها","كما قُدْتَ بالرِّفقِ الجَوادَ المُقيَّدا",23,"د",2,0],["تَرَقَّ مِنَ الدُنيا إِلى أَيِّ غايَةٍ","سَمَوتَ إِلَيها فَالمَنايا وَراؤُها",24,"ا",3,0],["تَرَقَّت مُناهُ طَودَ عِزٍّ لَوِ اِرتَقَت","بِهِ الريحُ فِتراً لَاِنثَنَت وَهيَ ظالِعُ",25,"ع",1,0],["تُرَقرِقُ ماءً مُقلَتايَ وَوَجهِهِ","وَيُذكي عَلى قَلبي وَوَجنَتِهِ الجَمرُ",26,"ر",1,0],["ترقَّت بُروجَ العزِّ فيهِ بَواذِخاً","لَها مِن صَميمِ العَزمِ وَالحَزمِ سُلَّمُ",27,"م",1,0],["تَرقَدُّ في رَيعانِها المُرقَدِّ","وَعاصِفٍ مِن آلِها المُشتَدِّ",28,"د",1,0],["تَرَقَّبنَ الهَواءَ بِلُطفِ رَبٍّ","قَديرٍ إِن تَرَكتِ لَهُ هَواكِ",29,"ك",1,1],["تَرَقُّشَ العَثِّ فِي بَطنِ الأَدِيمِ فَما","نَالُوا بِذلِكُمُ تَقوىً وَلا نَشَبا",30,"ب",2,0],["تَرقَّى فلمَّا اشتد ساعده عتا","وَبات يغيظ الشرقَ والشرق يكظم",31,"م",1,0],["ترقب سقوطاً يا ابن آدم قاتلا","فإنك لو تدري على جرف هار",32,"ر",1,0],["تَرقى إلى حرم أشم طرافه","يَسع الفَضاء وَلَيسَ بالمَنظور",33,"ر",1,0],["تُرقِّصُ الموجَ إنْ مَسَّتْهُ أجنحُها","كقلبِ آدمَ إذ مَسَّتْهُ حواءُ",34,"ا",2,0],["تَرَقَّبِي سِنَةَ الْحُرَّاسِ وانْطَلِقِي","بَيْنَ الْخَمَائِلِ مِنْ لُبْنَانَ وَارْتَادِي",35,"د",2,0],["تَرْقى المَعَارِجَ مِن سَبِي","لَيْنِ المَضَاءِ وَالاجْتِهَادْ",36,"د",1,0],["ترِقُّ فِيهَا فَتَصْفُو","نُوراً وَتَخْلُصُ نَشْرَا",37,"ر",2,0],["تَرِقّ حَواشيهِ وَيَظرُفُ طَبعُهُ","وَآدابُهُ حَتّى يُقال تَبَغدَذا",38,"ذ",2,0],["ترقَّبَتْ مصرُ فيه الصُّبْحَ مبتسما","يلُوحُ بالْخَير والإسعادِ سَافرُه",39,"ر",2,0],["ترقرقُ في جِنْحِ الظَّلامِ فينجَلي","وَتُرْهِجُ في صَدْرِ النَّهارِ فيُظلِمُ",40,"م",1,0],["ترقع أسمال أطفالها","وتحسو عروق يديها الإبر",41,"ر",1,0],["ترقَّبُ فينا العاذلينَ على الهوى","وما نال عيشاً قبلنا منْ ترقَّبا",42,"ب",2,0],["ترقّص الموج إذا مسّته أجنحها","كقلب آدم إذ مسّته حواء",43,"ا",2,0],["تَرقى النَّجومَ مَوهِنا مِن وَرائها","طَلاَئِحُ قَدْ كادت من الوَاني تطْلعُ",44,"ع",1,0],["ترقرق فيه ماء الحسن حتى","تقاطر منه شمائله وسالا",45,"ل",2,0],["ترقرق فيه ماء الحسن حتى","جلا بالوجه طالعة الصباح",46,"ح",1,0],["ترقرق عنده غدران ماءٍ","على ضفاتها أثر الهوامي",47,"م",2,0],["تَرَقَّى ِإلَى العَليَا عَلَى نُجبِ عَزمِهِ","وقَاسِي عَلَى إِدرَاكِهَا السَّهلَ والحَزنَا",48,"ن",2,0],["تَرقَى وتَسفُلُ مهما كُنتَ عَالِيَهَا","طِبقَ المُنَى وتَذُودَ الأَينَ والسَّامَا",49,"م",2,0],["ترقَّبوها من الجُودى كامنةً","في نقعها ككمون الشمس في الطَّفلِ",50,"ل",1,0],["تَرقى إِلَيهِ كُلَّ يَومٍ فَرسَخاً","وَسِواكَ يَرقى كُلَّ يَومٍ إِصبَعا",51,"ع",2,0],["ترقى إلى السبع الطباق ترقِّياً","حقيقاً ولم يعبر سفينا ولا جسرا",52,"ر",2,0],["تَرَقّى إِلى السَبعِ الطِباقِ بِجِسمِهِ","وَقَد أَشرَقَت أَملاكُها وَتَجلَّتِ",53,"ت",1,0],["تَرَقّى إِلَيها إِذ تَمَكَّنَ طيبُهُ","وَكادَ لَهيبُ الشَوقِ وَجداً يُذيبُهُ",53,"ه",1,0],["ترقى ذا إَلى درجاتِ هذا","ويرفع ذا منيع لا يزالُ",54,"ل",1,0],["ترق معانيها ويجزل لفظها","ويلهى بمعناها الغريب الملاهيا",55,"ي",2,0],["ترقى الأفاعي على الأشجار ساربة","للطير تسترها الأغصان والورَق",56,"ق",1,0],["ترقرقَ حسنها فيها فقالتْ","وفي الطاووسِ طبعُ الاختيالِ",57,"ل",1,0],["تَرِقُّ غُصونُ دَولَتِهِ","إِذا عودُ الزَمانِ عَسا",58,"س",2,0],["تَرِقُّ حَواشِي الدَّهْرِ فِي ظِلِّ مَجْدِهِ","وَتَظْرُفُ مِنْهُ شِيمَةُ الزَّمَن الْفَدْمِ",59,"م",1,0],["تَرقُصُ فيها مِياهُها رَقصاً","كَمُطرِبٍ بِالسَّماعِ مَسرورِ",60,"ر",1,0],["ترقّى إلى السَبع السَماوات صاعِداً","وَبارئه يُدنيهِ برّاً ويُكرمُ",61,"م",1,0],["ترقصُ الأَضلاعُ مني","إِنْ حداها منه ضرب",62,"ب",1,0],["ترقى به الأرض إذْ تدنو السماءُ له","كما سما ناهضٌ للمنحني العاسي",63,"س",2,0],["ترق مع استسهال كل صعوبة","الى أوج كل الفضل تظفر بسعدان",64,"ن",1,0],["ترق إلى استكمال علم بسرعة","كبان الى استكمال تشييد بنيان",64,"ن",1,0],["تَرقَ إِلى الباطِنِ مِن ظاهِرِ ما","شَرَعتُهُ فَعِندَما اِصمَت وَاِعتَزِل",65,"ل",1,0],["تَرْقا الدموعُ إذا كان الهوى نَغِلاً","وتأرقُ العين من دون الهوى النَغِل",66,"ل",1,0],["ترقى بها في المجد كلُّ مصدقٍ","وخابتْ مساعي كلُّ غاوٍ مكذِّبِ",67,"ب",1,0],["تَرْقَى إلى فلكِ العَلياءِ مُرْتَفِعاً","عِزّاً ويَجْري عَلَى ما تشتهي القَدَرُ",68,"ر",1,0],["ترقب صدق قولي يا خليلي","ولا تحسبه من قسم التمني",69,"ن",2,0],["ترقب صدق قولي فهو حق","ستنظره قريباً بالعيان",70,"ن",1,0],["ترقب منه غيث لطف ورحمة","تطهر هذا القطر من كل أنجاس",71,"س",1,0],["ترقب طلوع الشمس بالوصل واللقا","فنظمك بشرى بالتباشير للفجر",72,"ر",1,0],["تَرقا وَما رَقأت نُعماكَ عَن أَحَدٍ","بُورِكتَ بُورِكتَ من عالٍ وَمُنسَجِمِ",73,"م",1,0],["تَرَقرَقَ لؤلؤ الأَنداء فيها","كَما امتلأت عُيونُ من دُموعِ",74,"ع",1,0],["ترقُّ لنا تلك الشَّمائل مثلما","ترقُّ شمال أو تروق شمول",75,"ل",1,0],["ترقّ للناس ما تصفو ضمائرها","برقّةٍ كنسيم الروض في السحر",76,"ر",1,0],["تَرَقَّيْتَ فِي هَضْبَةِ العِزِّ عَنِّي","وأَهْوَيْتَ بي لِمَهيلٍ كَثيبِ",77,"ب",1,0],["ترقى الشعوب على سواعد أهلها","وتهون تحت سنابك الدخلاء",78,"ا",2,0],["ترقَّبتُ يوماً من لقائك نجتني","ثمارَ الإياب الحلوِ من غصنه اللَّدْنِ",79,"ن",1,0],["ترقَّت به هِمّاتُه قبلَ سِنِّه","إلى ذروةٍ خلَّوا له عن سَنامِها",80,"م",3,0],["تَرقرَقَ حُسناً فامتَرى كلُّ سامع","به وهو مخلوبُ الفؤاد طروبُهُ",81,"ب",2,0],["ترقُّ وفيها قسوةٌ جاهليُّة","هي الذَّمُّ إلاَّ في السيوف القواطع",82,"ع",1,0],["ترقُّ أحاديث النَّسيم معانياً","وتخفي إشارات البروق فيفهم",83,"م",1,0],["ترقب مقدمي واصفح كصفحي","وكف الصفح ساعدها الصفاء",84,"ا",2,0],["تَرِقُّ شَمائلُ مَن ذاقَهُ","وَتَلطُف شَمأَلُ مِن هَذَّبه",85,"ب",2,0],["ترقص الروحُ منه والقلب أيضاً","طائرٌ ناشرٌ من الوجد طيّا",86,"ي",2,0],["ترقَّى في قمَمِ المَعالي","وجازَ غُبارُهُ خامَ المُدَانِي",87,"ن",2,0],["ترَقَّتْ ببابِ اللهِ من قلبِ حِبِّهِ","نبِيِّ الهُدى خيرِ الوَرَى سيِّدِ الرُّسْلِ",88,"ل",1,0],["ترقُبُ السِّرَّ في سَمينٍ عَريضٍ","ربّ قولٍ منظَّمٍ مَنْسُوق",89,"ق",1,0],["ترقْرَقَ فيه سرُّكُمْ فأَقامَهُ","بهمَّتِكُمْ في شامِخاتِ المراتِبِ",90,"ب",1,0],["تَرَقرَقَ مائي مثلَما أنتَ ناِظِرٌ","تَرقرُقَ ماءِ البِشرِ في وجهِكَ الدُرَي",91,"ر",2,0],["ترقى وتسقط من أعلى مقامك في","حضيض جهلك بي يا خيبة الراقي",92,"ق",2,0],["ترقب سهام الله وانتظر البلا","فانهمو أهل المقام المؤيد",93,"د",1,0],["تَرَقَّت لِما فاقَت وراقَت تَبَرُّحاً","عَلى مُعتَلي بُرجِ البَديعِ المُشَيَّدِ",94,"د",1,0],["تَرقَّت إِليها بالسرى لممُ الدُّجى","وخِلْتُ الثُّريا وَدْعَةً فِي غَدائِر",95,"ر",1,0],["تَرَقْرَقَ دُرُّ الدَّمْعِ مِنْ مَتْنِ لَحْظِه","فَحَقَّقتُ أَنّ السَّيْفَ فِيهِ فَرْندُهُ",96,"د",2,0],["ترقى براق العلم بل رفرف التقى","إلى قاب قوس مدرك العقل عازب",97,"ب",1,0],["تَرقى سَعيدٌ وافر الحَزم وَالتُقى","وَحلّاك يا جَيد المَعالي قَلائدُ",98,"د",1,1],["ترقت به للمكرماتِ فضائلٌ","بها للعلى يرقى ويسمو ويصعدُ",99,"د",1,0],["ترقرق جدول في عارضيه","يلقب بالملاحه وهو عذب",100,"ب",1,1],["ترقّصت الأرض تحتهم","كما ترقص الخود ذات الوسام",101,"م",1,0],["تَرقُصُ الخَمرُ بِعِطفَيها دَلالاً","حينَ أَبدى الدّلالُ رَقص البنودِ",102,"د",1,0],["تَرَقرَقَ ماءٌ راقَ سَكباً وَمَنظَراً","وَلَم يَحْكِهِ في طَعمِهِ الشَّهدُ وَالقطرُ",103,"ر",1,0],["تَرقّ نَسيماً مِنهُ يَشفي غَليلَه","عَليلُ هُمومِ الدّهرِ وَهيَ شَدائِدُ",104,"د",1,0],["ترقّعُ الخطأ الدامي وتفتقهُ","كلاكما مستفزٌ أنتَ والخطأُ",105,"ا",1,0],["ترقرق أمواه العلى في وجوههم","أجل ويروح المجد فيهم ويغتدي",106,"د",2,0],["ترقرق ماء الحسن فوق جبينه","وشفت عن