{"poems":[[53,"يا أيها السيد الذي غمرت","https://www.aldiwan.net/poem62932.html","الكامل"],[93,"يا شاعر الحسن هذي روعة العيد","https://www.aldiwan.net/poem8808.html","عموديه"],[71,"بي من بنات المغل من","https://www.aldiwan.net/poem28418.html","مجزوء الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[101,"يُحبني كثيراً","https://www.poetsgate.com/ViewPoem.aspx?id=14386",""],[139,"أهدي إلى روض السلام","https://www.aldiwan.net/poem49052.html","مجزوء الرجز"],[156,"قال الطبيب","https://www.aldiwan.net/poem17099.html","عموديه"],[234,"لعلك ناظر في أمر من قد","https://www.aldiwan.net/poem50741.html","الوافر"],[276,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[406,"بين الريح والإعصار","https://www.aldiwan.net/poem10311.html","عموديه"],[447,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[463,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[572,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122726","البسيط"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137345",""],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54149","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64435","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92035","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216634","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44647","البسيط"],[4815,"جَفَّ البيان","https://www.poetsgate.com/ViewPoem.aspx?id=210473",""],[5351,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=202285",""],[5626,"يا زورق الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189562",""]],"verses":[["وكيف حملُ العقير راكبه","لا كيف أو قطعه به سَفره",0,"ر",2,0],["وَكَيفَ حَشَّت دِمَشقُ بَعدَ مِحنَتِها","وَاِستَرجَعَت كُلَّ مَسلوب وَمَفقودِ",1,"د",1,0],["وكيفَ حالُ مسلمٍ","أصبحَ في أسرِ التترْ",2,"ر",1,0],["وَكَيفَ حَواني مَنزِلي بَعدَ فَرقَد","عَلَيهِ الشُموس النَيِّرات حَواني",3,"ن",2,0],["وكيف حمدِيك إن أوليتَني حَسناً","وإنما العُرف من كفيك تقبيض",4,"ض",1,0],["وكيف حملت ركبَكِ في سلامٍ","فقرَّبِهم على القمر القرار؟",5,"ر",1,0],["وكيف حطمتِ إناء طيب","من بعدما ربيتِه شهوراً",6,"ر",2,0],["وكيف حال البدر","وضوء ذاك الثغر",7,"ر",1,0],["وكَيفَ حلَّقَ رُوحِي في مَعارجِهِ","كالصَّقرِ، أو كَيفَ أَحوِيهِ ويَحوِيني؟!",8,"ن",2,0],["وكيف حملتَ ردْفَك وهو دِعْصٌ","على قَدم أرقّ من اللّسانِ",9,"ن",1,0],["وَكَيفَ حيلة من عسى وَيصبح في","بحر محيط من الاوزار ملتطم",10,"م",1,0],["وكيف حرّك جيشاً لا سلاح له","ماهزّ سيفاً على الطغيان بتّارا؟",11,"ر",2,0],["وكيف حياة ذي لهف حزين","إِلى إدراك من يهوى مشوق",12,"ق",1,0],["وكيف حِذَاري من جفائك دانياً","وأنت على بُعد الديار وَصولُ",13,"ل",1,0],["وكيف حشَدتَ له وارتقيتَ","فلم تستطع طودَه المشمخِرّا",14,"ر",2,0],["وكيف حَواه اللَّحد والبحر عنده","نقيعةُ قلْتٍ أو صَرىً يتصَرَّمُ",15,"م",1,0],["وكيف حطّ مُلِظٌّ في بُلَهْنِيَةٍ","من ناعم العيش داراً غيرَ مِحْلالِ",16,"ل",1,0],["وَكَيْفَ حَالِي بَعْدَ مَنْ هَذِهِ","صِفَاتُ هَذَا الخَيْرِ فِيْهِ يَكُونْ",17,"ن",1,0],["وَكَيفَ حيُّ بِحَضرانٍ عَهدتُهُم","وَمَن أقامَ بِهِم بَعدي وَمَن رَحلا",18,"ل",2,0],["وكيف حوى التُربُ صدراً رحيباً","تضيق بهِ شامخاتُ القلَل",19,"ل",1,0],["وكيف حمل ذاك المجدُ ثكلهما","والثكل والله أمرٌ غير محتمل",20,"ل",1,0],["وكيف حصول الوهب ممن ملكته","وليس له في الملك ذرة شركة",21,"ه",1,0],["وَكَيفَ حال سقيمٍ قد يقال له","مات الطَبيبُ وَعاد الداء بالنكس",22,"س",1,0],["وكيف حواها الكوب والكوب جامد","يدور فلا يهتز في الكف عطفاه",23,"ا",2,0],["وَكَيفَ حالي وَإِني بَينَ مَن فَسَدوا","وَما لَهُم في فِعالِ السوءِ أَشباهُ",24,"ه",1,1],["وكيفَ حلَّتْ (بأندريوسَ) * طَلقَتُهُ","أرداهُ ما اهتَزَّ رِمشٌ فيهِ أو طَرَفُ",25,"ف",1,0],["وكيف حملن إليكَ العصور","لتضربَ في جوفهن الجَوَع",26,"ع",1,0],["وكيفَ حُبُّكَ في الآنامِ قاطِبَةً ؟","وكيفَ يَهْواكَ من راحوا ومن حضروا؟",27,"ر",3,0]]}