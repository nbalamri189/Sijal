{"poems":[[30,"أنسيت صحبتها ومن يك مقرفا","https://www.aldiwan.net/poem5255.html","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53056","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139712",""]],"verses":[["عَجفاءُ عارِيَةُ العِظامِ أَصابَها","حَدَثُ الزَمانِ وَجَدُّها العَثّارُ",0,"ر",1,0],["عُجْ فهذا غازي بن يوسف مأوى","كل عافٍ وهذه الشهباء",1,"ا",2,0],["عُجْ فها أوجه الرجاء من","يرات ولا تعتسف ردايا الركابِ",2,"ب",1,0],["عجف المعالي سماناً في نداه غدت","فلستَ تبصرها من بعد ذا عجفا",3,"ف",2,0]]}