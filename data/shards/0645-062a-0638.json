{"poems":[[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[369,"متظلما فيهم وكم","https://www.aldiwan.net/poem57129.html","مجزوء الكامل"],[451,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"]],"verses":[["مُتَظَلِّلٌ من طَوْله بحدائقٍ","مُتَمَرِّسٌ من حده بعِضاه",0,"ه",1,0],["مُتَظَلِّلينَ بأيْكَةٍ","مَنَعَ الهَجِيرُ ظِلالَها",1,"ل",3,0],["مُتظلِّماً فيهِم وكَم","مُتظلِّمٍ ويكونُ أظلَم",2,"م",1,1],["متظاهراً في الأصدقاء فَغَّرنا","هذا الشمولُ لبسمةِ الأّيام",3,"م",1,0]]}