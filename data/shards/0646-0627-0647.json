etsgate.com/ViewPoem.aspx?id=53053",""],[6142,"أمريضا بالسير بنت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=155735",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6151,"يا فارس الهيجاء يامن عزه","https://www.poetsgate.com/ViewPoem.aspx?id=120396",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["ناهيكِ ظُلماً أَن أَضَرَّ بِيَ الصَدى","بَرحاً وَنالَ البُرءَ عودُ أَراكِ",0,"ك",1,0],["ناهيكِ مِن سَهَرٍ بَرحٍ تَأَلَّفَهُ","شَوقٌ إِلى ما اِنقَضى مِن ذَلِكَ السَمَرِ",1,"ر",1,0],["نَاهِيكَ بِالمَعْرُوفِ يَجْرِي كَالنَّدَى","وَبِهِ سَقَاءٌ مِنْ بَنَانِ حِسانِ",2,"ن",1,0],["نَاهِيكَ بِالزِّينَاتِ مِمَّا أَبْدَعَتْ","كَفُّ الصَّنَاعِ وَفِطْنَةُ الرَّسَّامِ",3,"م",1,0],["نَاهِيكَ مِنْ رجُلٍ فَرْدٍ بِهِ اجْتَمَعتْ","كُلُّ الصِّفَاتِ الَّتِي تُرْضِيكَ فِي الرَّجُل",4,"ل",1,0],["ناهد النَودلَين محطوطة المت","نَين خود رجراجة وركانه",5,"ن",2,0],["ناهيكَ سهماً تسميه الورى قلماً","لهُ إلى غرَضِ العلياء تسديد",6,"د",1,0],["ناهيكَ بالليل والنهار لذي","أجرٍ وذكر أطراسٍ وأنفاس",7,"س",1,0],["ناهيك منهم بإمام مضى","وقائل بالعدل مأموم",8,"م",1,0],["ناهِيكَ من ثقةٍ سها","مُ القوم مُودَعَةٌ جِعابَهْ",9,"ب",2,0],["ناهداتٍ مطرّفاتٍ يمانع","نك رُمَّانَهُنَّ بالعُنَّابِ",10,"ب",1,0],["ناهيك من حسن الرواء جميله","عفِّ المغيب لدى الخلاء نظيفه",11,"ف",2,0],["ناهيك من صدر ومن تسنينه","ناهيك من ردف ومن تسنيفه",11,"ف",2,0],["ناهيك بالشيطان من فزَّاعة","وابن استِها فزَّاعةِ الشيطان",12,"ن",1,0],["ناهيك من صَمْتٍ بلا عيٍّ به","وكفاك مِنْ لسَنٍ بغير سَفاه",13,"ه",1,0],["ناهيكَ بِالسَبَبِ الشَرقِيِّ مِن نَسَبٍ","وَحَبَّذا سَبَبُ الإِسلامِ مِن رَحِمِ",14,"م",1,0],["ناهبتُه شوطَ الجِراءِ ففاتَنِي","جَذَعاً وقَصَّر عنه جَرْيُ القارحِ",15,"ح",1,0],["ناهَضتَهُم وَالبارِقاتُ كَأَنَّها","شُعَلٌ عَلى أَيديهُمُ تَتَلَهَّبُ",16,"ب",1,0],["ناهيكَ مِن حَرقٍ أَبيتُ أَقاسي","وَجُروحِ حُبٍّ ما لَهُنَّ أَواسِ",17,"س",1,1],["ناهيكَ مِنْ دِيَمٍ في طَيِّها زَغَبٌ","وزمجراتِ رعودٍ ضمَّها رَهَبُ",18,"ب",1,0],["ناهيكَ عِلقاً نَفيسا","في مِثلِهِ الصَبُّ يُعذَر",19,"ر",1,0],["ناهوكَ عَن حَسَنِ فِعلٍ آمِروكَ بِهِ","وَالآمِرونَ بِسوءِ الفِعلِ ناهونا",20,"ن",2,0],["ناهد في شبابها وأدوها","ضحوة بين دجلة والفرات",21,"ت",1,0],["نَاهِيكَ بِالتَّمْثِيلِ تَرْعَى فَنْهُ","فِي أُمَّةٍ حَمَدَتْ بِكَ التَّمْثِيلاَ",22,"ل",2,0],["نَاهِيكِ بِالخُلُقِ الْكَرِيمِ تَزِيدُهُ","لُطْفاً شَمَائِلُ مِنْ كَرِيمِ نِجَارِ",23,"ر",1,0],["نَاهِيكَ بِالْغَايَاتِ مِنْ","نُبْلٍ وَفَضْلٍ وَاعْتِزامِ",24,"م",1,0],["ناهيك مِنْ فنِّ وَمِنْ فِطَنٍ بِلا","زهْوٍ وَمِنْ ظرْف بِغيرِ تظرُّفِ",25,"ف",1,0],["نَاهِيكَ بِالحُزْنِ وَتَبْرِيحِهِ","بِالنَّفْسِ إِن خَالَطَهُ الذُّعْرُ",26,"ر",1,0],["نَاهِيكَ بِالألْفَاظِ مِمَّ","ا تجَوَّدَ اللَّبِقُ اللَّبِيبُ",27,"ب",1,0],["نَاهِيكَ بِالْوَشْيِ الأَنِيقِ وَقَدْ زَهَا","مَا شَاءَ فِي الدِّيبَاجَةِ الْحَسْنَاءِ",28,"ا",2,0],["نَاهِيكَ بِالرَّمْزِ العَظِيم وَقَدْ حَوَى","مَعْنَّى الرُّقِيِّ وَرُوحَ الاِسْتِقْلاَلِ",29,"ل",1,0],["نَاهِجاً نَهْجَهُ أَبِياً جَرِيئاً","رَاضِياً بِالْعَذَابِ وَالتَّسْهِيدِ",30,"د",1,0],["نَاهِيكُمُ بِالغُنْمِ مِنْ","غُنْمِ وَبِالشَّرَفِ اللُّبَابِ",31,"ب",1,0],["نَاهِيكَ بِالشِّيَمِ الْحِسَانِ وَقِسْطِهِ","مِنْ كُلِّهَا قِسْطِ الأَعَزِّ الأَمْجَد",32,"د",1,0],["نَاهِضاً أَو رَابِضاً حَتَّى بَدَتْ","آيَةُ الإِنْصَافِ تَجْلُوهَا إِياةُ",33,"ه",1,0],["نَاهِيكَ بِالْيَأْسِ الشَّدِيد وَقَدْ غَدَا","كَالنَّبْحِ مِنْ جَرَّاهُ نَحْبُ النَّاحِبِ",34,"ب",1,0],["ناهيكَ مِن نِعمَةٍ وَمُلكٍ","مَعَ النَبِيّينَ في الجِنانِ",35,"ن",1,0],["ناهيك من اطفاء أنوار الهدى","غشى الظلام وضل فيه الساري",36,"ر",2,0],["ناهيك من اعدام احبار التقى","فالدين لا يبقى بلا احبار",36,"ر",1,0],["ناهيك من قعص السراة فانهم","سور ادين المصطفى وسواري",36,"ر",2,0],["ناهيك من هلك الكرام فما بقي","رسم الكرام ولا حماة الجار",36,"ر",1,0],["ناهيك من جلدي يقيني بالرضا","والسخط في أن المقدر جاري",36,"ر",2,0],["ناهضاً بالثقيلِ من عِبء هذا","الوطن النَكدِ عابِئاً بالخفيف",37,"ف",1,0],["ناهيكَ من حُسن الرَّواءِ جميله","عفِّ المغيَّبِ في الخلاء نظيفه",38,"ف",2,0],["ناهيك عن صدر ومن تَسْنينه","ناهيك من ردفٍ ومن تسنيفه",38,"ف",2,0],["ناهيك من قعص السراة فإنهم","سور لدين المصطفى وسواري",39,"ر",2,0],["ناهيك ما لاقى معاذ من رسول","الله من زجر بتطويل السور",40,"ر",1,0],["ناهيك من يومٍ أغر محجلٍ","متميز من سائر الأيام",41,"م",1,0],["ناهيك منهُ إنارةً وإن اغتدى","في أعينِ الكُفَّارِ ليلاً أليلا",42,"ل",2,0],["ناهز الستين عمري إنما","لم أزل جم القوى جمّ الجدارهْ",43,"ر",2,0],["ناهيكَ مِن كَرَمٍ يَفوقُ بِهِ الحَيا","سَبقاً وَمِن بَأسٍ يَفوتُ الأَنجُما",44,"م",2,0],["ناهيت في طلب الدنيا فما سمحت","فصرت يملكني التعليل والكسلُ",45,"ل",1,0],["ناهيكَ مِن وَجهٍ لَهُ عابِسٍ","كَأَنَّهُ سُقلٌ عَلى بَيدَرِ",46,"ر",1,0],["نَاهِيكَ مِنْ نَظْمٍ وَمِنْ نَاظِمٍ","وَمِنْ مُبِينٍ مُقْتَضَى حِكْمَتِهِ",47,"ت",2,0],["ناَهِيكَ مِنْ قَوْمٍ حَوَوْا شَرَفاً","إِذْ رَفَضُوا الدُّنْيَا كَمَا الزِّنْيَهْ",48,"ي",2,0],["ناهدته فيها على أنها","تجعل بالصاروج كافوره",49,"ر",2,0],["ناهى الوَرى عَن فعل كل دنية","وَعَلى المَكارِم وَالوفاء محضض",50,"ض",1,0],["ناهيكَ مِن علمٍ عَلى علم ومن","شمسٍ مناظرةٍ لقطب أرفعِ",51,"ع",1,0],["ناهيكَ من نُسكٍ وحسنِ طويّةٍ","في دَهرِه لم يأتِ قطّ المنكرا",52,"ر",2,0],["ناهي زَمانٍ آمِرُ يَقتادُهُ","كَما أَرتَضي أَنّي يَقُدهُ يَنقَدِ",53,"د",1,0],["ناهيكَ للأزَماتِ من مُستَنقذٍ","مِنها وللغَمرات من خَوَّاضِ",54,"ض",1,0],["ناهيك عن رتبةٍ حازت بها شرفاً","إذ حل فيها إلهٌ جلَّ عن مَثَل",55,"ل",1,0],["ناهلْتُ فيهِ البدرَ شمساً تُوِّجَت","عند المِزَاجِ بكل نَجمٍ زاهرِ",56,"ر",1,0],["ناهضٌ بالعبءِ لو كلّفتهُ","ردّ أيام الصِّبا لاكْتَفلا",57,"ل",2,0],["ناهيك من شادنٍ شاد تغارُ على","أُذْن المُصطيخ إليه مُقلةُ",58,"ه",1,0],["ناهزَ حلمَ الكهول طفلا","وساد بين التميمتينِ",59,"ن",1,0],["ناهٍ دموعَك بالبنانِ تجمُّلا","نهياً مشقَّته على الأجفانِ",60,"ن",1,0],["ناهضَ ثِقلَ الدولتين فكفى ال","مُلكَ الطريفَ ما كفاه المتلَدا",61,"د",2,0],["ناهضتُ حبَّك والنحولُ يخونني","وكتمتُ سرّك والدموعُ تَشِي بي",62,"ب",2,0],["ناهِضٌ بالحزْمِ والعزمِ معاً","ليس بالغَمْرِ ولا النِّكسِ الوكِلْ",63,"ل",1,0],["ناهيك من درس غدت تشدو لنا","در السنوسي فضوعها نفحات",64,"ت",1,0],["ناه عقل العالمين","بالحبيب مولاي محمد",65,"د",1,0],["ناهيك من حلم ومن سؤدد","فيه ومن علم ومن رفد",66,"د",1,0],["ناهيكَ من آثاره الشريفه","في رَدِّهِ كيد بني حنيفه",67,"ه",1,0],["ناهِدَةٌ لَفّاءُ","وغَصَّةٌ وَطْفاءُ",68,"ا",2,0],["ناهَضتَهُم ذائِدَ الإِسلامِ تَقرَعُهُم","عَنهُ ثُلاثَ وَمَثنى بِالمَواحيدِ",69,"د",1,0],["نَاهِيْكَ مِنْ خَلْوَةٍ وَمُلْتَزَمٍ","وَرَشْفِ ثَغْرٍ وَرِيْقَةٍ خَصِرَهْ",70,"ر",2,0],["ناهيكَ بِالرافِعيِينَ الَّذينَ لَهُم","مِنَ المَآثِرِ ما يَستَنطِقُ الخَرَسا",71,"س",2,0],["ناهيكَ اسجاعهُ تلك التي نضخت","عيونُها الراحَ فيهِ نكهة الضرَبِ",72,"ب",1,0],["ناهيك من موقفٍ للخوف قد خضعت","فيه الرقاب فكل خاضع العنق",73,"ق",1,0],["نَاهِيكَ مِنْ بَلَدٍ يَوْمُ الأَسِيرِ بِهِ","شَهْرٌ وَلَيْلَتُهُ مَعْدُودَةٌ بِسَنَهْ",74,"ه",1,0],["ناهيك مما دهى من حادث جلل","فدان من كان يكفي الحادث الجللا",75,"ل",2,0],["نَاهِيكَ مِنَ فِضَّةٍ تَجري على ذهبٍ","ماءٌ مِنَ النُّورِ في ماءٍ مِنَ اللَّهَبِ",76,"ب",1,1],["ناهياً عَنْ هواك مِنْ","حيثُ تَنهى تُحَرِّض",77,"ض",1,0],["ناهيك من فضةٍ تجري على ذهبٍ","نُورٌ من الماءِ في نارٍ من العنب",78,"ب",1,0],["ناهيك بشر نشره ملأ الفَضا","ضاوي الجَبين أغره وَضاحه",79,"ح",2,0],["ناهيك راية عزة هُديت كَما","أهدى الصبا رياه من نسرينه",80,"ن",2,0],["ناهدته بالمشرفي","ي وسابق نهد ونشره",81,"ر",2,0],["ناهبي أرواح أملاك الورى","في وغاها وأهبي تيجانِها",82,"ن",3,0],["ناهضتهم في عارض متألق","لبست به شمس النهار حدادا",83,"د",2,0],["ناهبتُها الغُنمَ على طَيِّعٍ","أجرَدَ كالقِدح من السَّأسَمِ",84,"م",1,0],["ناهَبْتَهُمْ بِمَغْرِفٍ عَجّاج","ضَخمِ العَراقي مُكرَبِ العِناجِ",85,"ج",1,0],["ناهيك إن أطلقت يوماً قوايمها","لطرد سابقةٍ تعتزّ أو سابقْ",86,"ق",1,0],["ناهيك لما طمطمت","وناشدتني معتبهْ",87,"ب",2,0],["ناهي