{"poems":[[65,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[0,"أماوِي هل لي عندكم مِن معرس","https://www.aldiwan.net/poem61.html",""],[37,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[56,"أما آن أن يعتب المذنب","https://www.aldiwan.net/poem27661.html","المتقارب"],[74,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[51,"أتبكي لهذا الموت أم أنت عارف","https://www.aldiwan.net/poem62180.html","الطويل"],[46,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[54,"طال ليلي وساورتني الهموم","https://www.aldiwan.net/poem26703.html","الخفيف"],[77,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[50,"إذا شاقك ناقوس","https://www.aldiwan.net/poem62556.html","الهزج"],[52,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[48,"أمر الخالق فاقبل ما أمر","https://www.aldiwan.net/poem22740.html","الرمل"],[0,"أماويّ هل لي عندكم من معرّس","https://www.poetsgate.com/ViewPoem.aspx?id=4783",""],[56,"أَمَا آنَ أَنْ يُعْتِبَ المُذْنِبُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=13873",""],[119,"الى شيخون تنعطف الاماني","https://www.aldiwan.net/poem41257.html","عموديه"],[131,"فسوف ترى إن ردت الأوس حلفها","https://www.aldiwan.net/poem24206.html","الطويل"],[139,"بربك يا زيدان هل كنت تعلم","https://www.aldiwan.net/poem49175.html","الطويل"],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[203,"أبت عيناك إلا أن تصوبا","https://www.aldiwan.net/poem45562.html","الوافر"],[240,"نعمت زمانا مع المترفين","https://www.aldiwan.net/poem31598.html","المتقارب"],[240,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[275,"حفل الشارع والجمع لغط","https://www.aldiwan.net/poem35251.html","الرمل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[276,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[285,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[302,"تذكر بالحمى رشأ أغنا","https://www.aldiwan.net/poem33152.html","الوافر"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[353,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[354,"ليس وصف الفضل فضلا","https://www.aldiwan.net/poem15897.html","مجزوء الرمل"],[401,"وغودر علود لها متطاول","https://www.aldiwan.net/poem581.html",""],[409,"الحمد لله على كل حال","https://www.aldiwan.net/poem33479.html","السريع"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[420,"ونحن تركنا أرطبون مطرداً","https://www.aldiwan.net/poem4484.html","الطويل"],[422,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[425,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[435,"نسمات البان من العلم","https://www.aldiwan.net/poem40851.html","المتدارك"],[447,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132480","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18491","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123435","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100140","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96372","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59426","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136094","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136159","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80009","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79825","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79806","البسيط"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67362","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81900","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102055","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100965","الخفيف"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20400","البسيط"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137924",""],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121905","الوافر"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100929","الكامل"],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102023","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100298","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132527","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28327","الوافر"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28303","الوافر"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145732","الخفيف"],[3732,"","https://poetry.dctabudhabi.ae/diwan/poem/131942","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128933","المتدارك"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123507","الطويل"],[4181,"","https://poetry.dctabudhabi.ae/diwan/poem/58","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90834","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45013","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105515","الطويل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136440",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139486",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139677",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4709,"جمال يطوقني","https://www.poetsgate.com/ViewPoem.aspx?id=214866",""],[4578,"في ربيع عادنا عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=49443",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5277,"ظلالٌ وضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=206824",""],[5431,"وليس سوى التحنان عرْفٌ ومذهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=191897",""],[3294,"أين الوفاء وللوفاء دلايل","https://www.poetsgate.com/ViewPoem.aspx?id=173271",""],[5776,"حربُ الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=207245",""],[5829,"رسالة الى اوباما","https://www.poetsgate.com/ViewPoem.aspx?id=148336",""],[5842,"ويحكِ يادمشق .. ! / غسان عبد الفتاح","https://www.poetsgate.com/ViewPoem.aspx?id=174873",""],[6093,"إلا الخروج","https://www.poetsgate.com/ViewPoem.aspx?id=191466",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""]],"verses":[["وَغودِرَ أَكلاً لِلضِّباعِ وَطُعمَةً","لأَفتَخَ مِن لَحمِ القَتيلِ مَكاسِبُهْ",0,"ب",2,0],["وَغَوَّرنَ في ظِلِّ الغَضى وَتَرَكنَهُ","كَقِرمِ الهِجانِ الفادِرِ المُتَشَمِّسِ",1,"س",1,0],["وَغودِرَ في الحَيِّ المُقيمينَ رَحلُها","وَكانَ لَها باغٍ سِوايَ فَبَلَّتِ",2,"ت",1,0],["وَغولُ اللَجاجَةِ غَرّارَةٌ","تَجِدُّ وَتَحسَبُها تَلعَبُ",3,"ب",1,0],["وغوانٍ تغني عن الطيب والح","لي لهذا تسمى الملاح غواني",4,"ن",2,0],["وَغودِرَ في لَحدٍ كَريهٍ حُلولُهُ","وَتُعقَدُ مِن لِبنٍ عَلَيهِ السَقائِفُ",5,"ف",1,0],["وَغودِرَ وَجهُ العُرفِ أَسوَدَ بَعدَما","يُرى وَكَأَنَّهُ كَعابٌ تَصَنَّعُ",6,"ع",1,0],["وَغَويٌّ عاصٍ وَبِرٌّ تَقيٌّ","وَاِستَبانَ المَحمودُ وَالمَذمومُ",7,"م",1,0],["وغودِرَ شأوُ السابقينَ لسابقٍ","له مَهيَعٌ من حيثُ لم يعلموا قَصد",8,"د",1,0],["وغُودِرَ في أشياعهِ نَبأً وقدْ","مَحوْتَ به رسمَ الدّلالة فامّحى",9,"ح",2,0],["وَغوديتَ بِريقِ الخَم","رِ مَجَّتهُ العَناقيدُ",10,"د",1,0],["وَغَوِيِّ قَومٍ هَرَّني","دونَ الَّذي أَحبَبتُ كَلبُه",11,"ب",2,0],["وَغَويٌّ كَرَّ في حَيرَتِهِ","بَعدَ ما حَجَّ لِنُسكٍ وَاِعتَمَر",12,"ر",1,0],["وَغَوّرْنَ في ظلّ الغَضَا وَتَرَكْنَه","كقرم الهجانِ الفادر المتشمس",13,"س",1,0],["وغُولُ اللَّجَاجَة ِ غَرَّراة","ٌ تَجِدُّ، وَتَحسَبُها تَلْعَبُب!",14,"ب",1,0],["وغوث الاولياء ابو علي","عليا في لملمات الكروب",15,"ب",1,0],["وغُودِرَ وسط القوم لما اصطففتمُ","ثلاثةُ رَهْطٍ أَعرجانِ وأحْوَلُ",16,"ل",1,0],["وغواصة كالحوتِ تسبح خِفيةً","تطيح بمرماها سفائنُ عوّمُ",17,"م",1,0],["وَغودِرتَ في غبرٍ يُواري تُرابُها","ضَريحَكَ بِالأَيدي الحَواثي النَوابِثِ",18,"ث",1,0],["وَغُودِرَ مِن أَعلى ذُراها مُنَكَّساً","وَلا ذَنبَ إِلّا حُسنُها وَاِنتِظامُها",19,"م",3,0],["وغوثي حينَ يخذلني نصيري","وغيثي إن غدا ربعي جديبا",20,"ب",2,0],["وَغودِرتُ مُنفَرِداً بِالعَرا","وَقَد قَصَمَ المَوتَ تِلكَ العُرى",21,"ر",2,0],["وَغودِرَتِ الخِيامُ بِغَيرِ حامٍ","يُناضِلُ دونَهُنَّ وَلا وَليِّ",22,"ي",1,0],["وغوانيهِ يُنَثِّرنَ الهوى","من عيونٍ قتَلتني بالغلط",23,"ط",1,0],["وغواصةٍ تحتَ المياهِ تسلّلت","ونسّافةٍ فوقَ المياهِ اسبكرّت",24,"ت",1,0],["وَغوث يُستَغاث به وَسيف","يَصول عَلى النوائب غير نابي",25,"ب",2,0],["وَغُودِرَ مُحْيِي النَّدى لِلْفناءِ","وَعُوجِلَ بانِي الْعُلى بِانْهِدامِ",26,"م",1,0],["وَغوثاً يا فدتكَ النَفسُ غَوثاً","فقد شفَّ الأَسى جِسمي وأَضنى",27,"ن",2,0],["وغودرت لا يثني على حسن فعلي ال","جميل ولا يلوي على حسن طلعتي",28,"ي",1,0],["وغودر ما نلقيه منا غذاؤنا","لصفو الهوى من شوب كل أذية",28,"ه",1,0],["وَغُودِرَتِ الأَعِنَّةُ مُلْقياتٍ","بِلا كَفٍّ يُحَاذِيها وَسَاعِدْ",29,"د",1,0],["وَغَوِيُّ الناسِ مَن يَر","وي الَّذي لَم يَستِبِنهُ",30,"ن",2,0],["وغُوِدِرَ عِلوَدٌّ لَها مُتَطاوِلٌ","نَبيلٌ كَجُثمانِ الجَرادَةِ ناشِرُ",31,"ر",1,1],["وغودروا فيها فرادى وقد","نسيهم أهلهم والعيال",32,"ل",1,0],["وغورُهمْ كان يبدو لو سَبَرتَهُمُ","واللهِ ما نصحوا لمَّا استشرتَهُمُ",33,"م",1,0],["وغُود رَ صرعى في المَكَرّ كثيرة","وعاد إليه الفلُّ وهو حسيرُ",34,"ر",1,0],["وغُودِرْتَ في دار النَّعيم مخلَّداً","وفارقْتَ إذ فارقت ما كانَ فانيا",35,"ي",2,0],["وَغودِرَ فيها ابنا رِياحٍ وَحَبتَرٍ","تَنوشُهمُ طَيرٌ عِتاقٌ وأذؤُبُ",36,"ب",1,0],["وغوادي المزن به هطلت","كبنان القاسم بالنعم",37,"م",1,0],["وغودر المجد من أعلاه منهدما","لوقعه وطريق الحمد مجهولا",38,"ل",2,0],["وغُودرَ أعْلاها مَحَلاًّ اشَدَّها","مُصاباً فَراثِيكَ الحَطيمُ وزمزم",39,"م",1,0],["وغودر تيجانُ الملوك لدى الوغى","نِعالاً يَطاها سابحٌ ومُطَهَّمُ",39,"م",1,0],["وغودر في دار البلَى عَلَمُ الهدى","مزعزعَ آساسِ مُضعضعَ أركانِ",40,"ن",1,0],["وَغودِرَ أَهلُ الصَبرِ صَرعَي فَأَصبَحوا","تُعاوِرهُمُ ريحُ الصَّبا وَالجَنائِبِ",41,"ب",1,0],["وغُودِرَ شِلواً في الضَّريح مُلحَّباً","وحيداً إلى يوم المآب لما به",42,"ب",2,0],["وغوثاً لنا في فادح الخطب مفزعا","وغيثاً لنا في كالح الجدب مربعا",43,"ع",2,0],["وغودر هوَبرٌ وبنو مليكٍ","كمن قد ماتَ في زمنٍ فبارا",44,"ر",2,0],["وغور ماءهم بعد انفجار","وأخمد نارهم بعد اتقاد",45,"د",1,0],["وغوثي وَفَخْرِي وَافْتِخَارِي وَعدتِي","وكهفِي وَمَطْلُوبِي وكنْزِي وعمدَتِي",46,"ي",1,0],["وغواسق ومقاعد ومجامع","في غيب لاهوت الحما التنائ",47,"ا",2,0],["وغوان يخطرن في برد زهو","بين طبل على ترنم عود",48,"د",1,0],["وغواني التركِ مع عُشَّاقِها","كلَّما مدَّ الظلامُ الغَيهبا",49,"ب",2,0],["وغودر الأُفقُ معتلاً وأنجمه","من غائرٍ ضوؤه منها ومنكدرِ",50,"ر",1,0],["وغودر منها ذلك الضلعُ لوعةً","على الجمر من هذي الرزيَّة حانيا",51,"ي",2,0],["وغُودرت في شعاب الطف نسوَتهُم","يَجهشنَ وجداً متى طفلٌ لها نشجا",52,"ج",2,0],["وَغُودِرَ مُنْكَبَّا لِفِيهِ وَوَجْهِهِهِ","يُعَالجُ رُمْحاً ذَا سِنَانٍ وَثَعْلَبَا",53,"ب",2,0],["وَغُوصُوا بِحَارِي تَظْفَرُوا بِجَوَاهِرِي","وَتِبْرِي وَيَاقُوتِي وَدُرِّي وَمُرْجَانِي",54,"ن",2,0],["وغوت لمكروبٍ وغيث لجذبة","مفرّج لخطبٍ بحقب قد استطال",55,"ل",1,0],["وغوانٍ سمعن داعيَ م