{"poems":[[44,"من ذا الذي بإخائه وبوده","https://www.aldiwan.net/poem50302.html","الكامل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[99,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85352","الكامل"],[86,"لا تبكين من الليالي أنها","https://www.poetsgate.com/ViewPoem.aspx?id=26309",""],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[303,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[321,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[443,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[487,"لما يرى حبها فؤادي","https://www.aldiwan.net/poem24552.html","عموديه"],[563,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87244","الوافر"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146220","الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137716",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70957","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70929","البسيط"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100134","الوافر"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138145",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95557","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95500","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118393","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27387","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87319","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65943","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78301","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4802,"الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=34300",""],[4818,"كعبة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=203507",""],[5121,"إِنْتِعَاش","https://www.poetsgate.com/ViewPoem.aspx?id=52925",""],[5264,"يا جاهل","https://www.poetsgate.com/ViewPoem.aspx?id=152677",""],[5264,"أصل الحكاية","https://www.poetsgate.com/ViewPoem.aspx?id=185053",""],[5667,"هند","https://www.poetsgate.com/ViewPoem.aspx?id=214871",""],[5690,"لما يا ورد لم يذبلك شوقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=172223",""],[5691,"جِنين","https://www.poetsgate.com/ViewPoem.aspx?id=207074",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[1920,"جدّدْ لنا عمرا فالقدس تنتظرُ","https://www.poetsgate.com/ViewPoem.aspx?id=192531",""],[5956,"وردة النور زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=182348",""],[5956,"أعيش لحبِّها","https://www.poetsgate.com/ViewPoem.aspx?id=182375",""],[5956,"بالشعر أصنع وحدة قلبية ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182949",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"جُبُّ الكهولة الخانق","https://www.poetsgate.com/ViewPoem.aspx?id=192138",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"إن كان لا يُعطيك شعري بعضُهم","https://www.poetsgate.com/ViewPoem.aspx?id=194702",""],[5956,"نشتاق يا جَدِّي إليكِ وأسرتِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200897",""],[5956,"اصرخ فخيرُ البرِّ أن لا تسكت","https://www.poetsgate.com/ViewPoem.aspx?id=204411",""],[6068,"فِي الْحَيِّ أَلْمَى شَادِنٌ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175790",""],[6082,"بداياتي","https://www.poetsgate.com/ViewPoem.aspx?id=60173",""],[5190,"يا رائعَ النَّفَحاتِ عُد مُتَفَضِّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85081&r=&rc=156",""]],"verses":[["لَمّا يَقول الكاشِحونَ لَنا غَداً","وَعيونُهُم نَحوي وَنَحوَكَ تلمَحُ",0,"ح",1,0],["لَمّا يُرِد مِن جَميعٍ بَعدُ فَرَّقَهُ","وَما يُرِد بَعدُ مِن ذي فُرقَةٍ جَمَعا",1,"ع",2,0],["لم أيها الداعي هواك دعا","والدهر يأبى أن نظل مَعا",2,"ع",2,0],["لما يئست من الحَقي","قَةِ جئت تعبأ بالخيال",3,"ل",1,0],["لم أيام حرب كثرت","في عداهم داعيات الحرب",4,"ب",1,0],["لِما يُعانيهِ رَبُّ المالِ مِن تَعَسٍ","في أَرضِنا لا لِأَنَّ المالَ يُطغِينا",5,"ن",2,0],["لما يبق عرقٌ ساكن إلاّ نبضْ","وَلا دفينٌ مِنْ مُنى إلاّ انتفضْ",6,"ض",1,0],["لما يفعت وصرت علق مضنه","ونشأت نشء المقبل الموموق",7,"ق",1,0],["لما يسيّرُ بين الناس من مثل","في الجود غيرك باق غير مجدود",8,"د",1,0],["لما يرى حبها فؤادي","ايقنت أن المنى تأتى",9,"ت",2,1],["لمائة والألف من","هجرة ذخر الناجين",10,"ن",1,0],["لمائه كلُّنا أواني","ونحن في نفسه معاني",11,"ن",2,1],["لما يرى منهم من التثاقل","عن حربهم والعجز والتخاذل",12,"ل",1,0],["لما يُثني الزًّمانُ مِن افتِقادٍ","إلى وَجهَيكُما ومِن افتِقارِ",13,"ر",1,0],["لما يَرويهِ ضعفُ الرَأ","ي في الإِسناد عَن ضَبِّ",14,"ب",1,0],["لمائد في رحله","نشوان من غير جُرع",15,"ع",1,0],["لما يكتفى من طعام ولبس","وما يرتضى سكنا في الظلم",16,"م",1,0],["لمّا يَرمْ مقبضَ المأثور قَبْضَتُهُ","في حين ظلَّ على المأثور قد قَبَضا",17,"ض",2,0],["لمَّا يُضعْها السكرُ عن أصلها","ولم تُضعْها جِدَّة الطعم",18,"م",1,0],["لمَّا يملْه أخو لؤمٍ إلى بخلٍ","ولم تغيره عن بذل الندى حال",19,"ل",1,0],["لما يممت للسلوى سبيلاً","ولا أملت للجلي نفادا",20,"د",2,0],["لما يساعده الجناح لانه","حصّت قوادمه عن الطيران",21,"ن",1,0],["لم أيقظت في النفوس الأماني","وبعثتِ الرجاء ملء الضلوع",22,"ع",1,0],["لما يرى الطير انتخى وانقضّا","مستقنصاً يبدي وراه الركضا",23,"ض",2,0],["لمّا يفته الفضل يو","ما من طريف أو تليد",24,"د",1,0],["لمَّا يقُم من مهدِهِ","أو يَضطلع وكأن قَدِ",25,"د",1,0],["لما يغيض ماؤها اذ لم تخضه","سوابح الالحاظ والاوهام",26,"م",1,0],["لما ينافي وجود النشىء من ثقلٍ","فلو يخف لكنا التاجَ في الراس",27,"س",1,0],["لَمَّا يَنادِيهِم أنَا الدَّيَانُ لاَ","ظُلمٌ لَدَيَّ فَيَسمَعُ الثَّقَلاَنِ",28,"ن",1,0],["لما يُواجِهُ الفؤادُ مِن عِظمِ","جَلالَةِ المعبُودِ حتى صارَ لَم",29,"م",1,0],["لمائَتَانِ مَع ثلاثه عَشَر","في ذا الحساب البَيِّنِ المُشتَهَر",30,"ر",1,0],["لما يذق طعم الكرى حتى حوى","ما قد حوت أحباله قبض اليد",31,"د",1,0],["لما يزل يخلق العزاء لَنا","مطارفاً وَالأَسى يجدّدها",32,"د",3,0],["لَم أَئنِ عَنك عنان القَصد مُلتَجِئاً","إلا إَلَيكَ لِكَي أَنجو مِن الضَرم",33,"م",1,0],["لِما يَئِست وَلَم يَسمَح لململتي","قاضي الهَوى بِنَشيق من هَواك شَفى",34,"ف",2,0],["لما يزل من عقله جائعاً","ومن عظيم النُوك شبعانا",35,"ن",2,0],["ل ما يعلم الله كالوتر بين يدينه","يشدّني واصرخ : دخيلك تدوزنت",36,"ت",1,0],["لما يرقْهمْ سِحرُنا ونقاؤُنا","فتَكَالبوا مثلَ الجرادِ ببيدرِ",37,"ر",1,0],["لَمَّا يُرَقْرِقُ فِي فَصِيِحِي لَحْنُهُ","وَيُدَاعِبُ الشَّفَتَيْنِ بِاسْتِرْسَالِيَا",38,"ل",3,0],["لما يا جاهل تُحْكُم شعب","ولما علينا بجهل تِطُلْ",39,"ل",1,1],["لما يزعل نهر نيلك","يشاركه حزنه ماء ليطانك",40,"ك",1,0],["لماّ يميسُ كميسِ الغُصنِ داعبَهُ","عذبُ النسائِمِ . . والأحلامُ والنغَمُ",41,"م",1,0],["لما يا ورد لم يذبلك شوقٌ","لروضك والصدور عن الورودِ",42,"د",1,1],["لمّا يَجِدْ فِرْعَوْنُ مَنْ يُثْنيه عن","طُغيانِهِ فمضى بِهِ فُرْعُونُ !",43,"ن",1,0],["لما يرى الأفضال تغمره","ويفيض عنه الوابل الهطِلُ",44,"ل",1,0],["لمَّا يسيرُ فلا شيطانَ يتبعهُ","والأرضُ تعشقهُ والماءُ والثَّمرُ",45,"ر",1,0],["لما يغيب العاج عني أكتسي","‏ ‏ ثوب العذاب وأستطير كما الشررْ",46,"ر",1,1],["لمّا يغيبُ العاج عني أكتسي","ثوبَ الأساة وأستحيل مفتِّشا",47,"ش",2,1],["لما يصادقك امرؤ من زحلة","من أجله ستحبها لبنانا",48,"ن",2,0],["لما يعاملكَ اْسوَدٌ بكياسة","ستحبها من أجله الألوانا",48,"ن",2,0],["لمّا يطال الحُسْنُ أعلى ذروةٍ","في النفس يسكن نفسنا التخليدُ",49,"د",1,0],["لما يشيب المرء لا يلقى سوى","ألمٍ على ألمٍ بدون حبورِ",50,"ر",1,0],["لمّا يهل البدر أقرأ سورة","عن روحك السمحاء والمقدامِ",51,"م",1,0],["لمّا يهوديٌّ رمى زِبْلاً على","بيت المحمد جارِهِ وضوائقا",52,"ق",2,0],["لمّا يجيب الربُّ كل دعائنا","سترين مجداً زائداً عن مُنْيتِكْ",53,"ك",1,0],["لما يسير الحكمُ معوجَّ الخُطى","لا يكسب المحكوم إلا الضيعةَ",54,"ه",1,0],["لَمَّا يراني عَابِسًا","يَحْلُو لَهُ مَا عِشْتُهُ",55,"ت",2,0],["لما يُشجيك تعذيبي","لما تغتال بسماتي",56,"ت",2,0],["لمَّا يَدَع شيخاً يُقيمُ صلاتَهُ","أو طِفلةً في صَومِهَا أو مُطفِلا",57,"ل",2,0]]}