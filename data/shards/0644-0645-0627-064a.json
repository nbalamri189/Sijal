{"poems":[[42,"من ذا الذي بإخائه وبوده","https://www.aldiwan.net/poem50302.html","الكامل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85352","الكامل"],[84,"لا تبكين من الليالي أنها","https://www.poetsgate.com/ViewPoem.aspx?id=26309",""],[170,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[299,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[317,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[438,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[483,"لما يرى حبها فؤادي","https://www.aldiwan.net/poem24552.html","عموديه"],[559,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[559,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَمّا يَقول الكاشِحونَ لَنا غَداً","وَعيونُهُم نَحوي وَنَحوَكَ تلمَحُ",0,"ح",1,0],["لَمّا يُرِد مِن جَميعٍ بَعدُ فَرَّقَهُ","وَما يُرِد بَعدُ مِن ذي فُرقَةٍ جَمَعا",1,"ع",2,0],["لم أيها الداعي هواك دعا","والدهر يأبى أن نظل مَعا",2,"ع",2,0],["لما يئست من الحَقي","قَةِ جئت تعبأ بالخيال",3,"ل",1,0],["لم أيام حرب كثرت","في عداهم داعيات الحرب",4,"ب",1,0],["لِما يُعانيهِ رَبُّ المالِ مِن تَعَسٍ","في أَرضِنا لا لِأَنَّ المالَ يُطغِينا",5,"ن",2,0],["لما يبق عرقٌ ساكن إلاّ نبضْ","وَلا دفينٌ مِنْ مُنى إلاّ انتفضْ",6,"ض",1,0],["لما يفعت وصرت علق مضنه","ونشأت نشء المقبل الموموق",7,"ق",1,0],["لما يسيّرُ بين الناس من مثل","في الجود غيرك باق غير مجدود",8,"د",1,0],["لما يرى حبها فؤادي","ايقنت أن المنى تأتى",9,"ت",2,1],["لمائة والألف من","هجرة ذخر الناجين",10,"ن",1,0],["لمائه كلُّنا أواني","ونحن في نفسه معاني",11,"ن",2,1],["لما يرى منهم من التثاقل","عن حربهم والعجز والتخاذل",12,"ل",1,0]]}