{"poems":[[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[41,"بان الخليط بمن علقت فانصدعوا","https://www.aldiwan.net/poem42370.html","البسيط"],[30,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[27,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[28,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[28,"نكفي الأعنة يوم الحرب مشعلة","https://www.aldiwan.net/poem1282.html",""],[28,"يختلف الناس ما لم نجتمع لهم","https://www.aldiwan.net/poem5068.html","البسيط"],[28,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[28,"منا الخلائف والنبي محمد","https://www.aldiwan.net/poem5169.html","الكامل"],[28,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[28,"عفى المنازل آخر الأيام","https://www.aldiwan.net/poem5617.html","الكامل"],[31,"يا سكن قد والله رب محمد","https://www.aldiwan.net/poem42470.html","الكامل"],[39,"لمن ديار بهذا الجزع من ربب","https://www.aldiwan.net/poem53814.html","البسيط"],[142,"منا القلب عطفا بالمسيء برحمة","https://www.aldiwan.net/poem4458.html","الطويل"],[167,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[172,"لو أن ذا حسب نال السماء به","https://www.aldiwan.net/poem46073.html","البسيط"],[261,"إما ترينا وقد خفت مجالسنا","https://www.aldiwan.net/poem453.html",""],[268,"من كان في تاريخه بحاثا","https://www.aldiwan.net/poem35001.html","الكامل"],[268,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[268,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[346,"منا المدائح والمنائح منكم","https://www.aldiwan.net/poem20371.html","الكامل"],[351,"نستودع الله أرضا تنبت الطربا","https://www.aldiwan.net/poem40578.html","البسيط"],[438,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[438,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[444,"يا حار لا تجهل على أشياخنا","https://www.aldiwan.net/poem23928.html","الكامل"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[560,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[560,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[560,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[560,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"]],"verses":[["مِنّا المُعينُ عَلى النَدى بِفَعالِهِ","وَالبَذلِ في اللَزَباتِ بِالأَموالِ",0,"ل",1,0],["مِنَّا الأَنَاةُ وَبَعضُ القَومِ يَحسَبُنَا","إِنَّا بِطَاءٌ وفي إِبطَائِنَا سَرَعُ",1,"ع",1,0],["مِنَ اآثار النُسوعَ زَمانَ مَيٍّ","صَديقٌ لا تُحِبُّ بِهِ بَديلا",2,"ل",2,0],["مِنّا أَبو قَيسٍ وَمِنّا الحَوطان","وَاِبنُ زُهَيرٍ مُعلِماً وَالعَمران",3,"ن",1,0],["مِنّا الفَوارِسُ قَد عَلِمتَ وَرائِسٌ","تَهدي قَنابِلَهُ عُقابٌ تَلمَعُ",4,"ع",1,0],["مِنّا الَّذي يُحمَدُ مَعروفُهُ","وَيَفرُجُ اللَزبَةَ يَومَ الزِحام",5,"م",1,0],["مِنّا الرَسولُ وَكُلُّ أَزهَرَ بَعدَهُ","كَالبَدرِ وَهوَ خَليفَةٌ في المَوكِبِ",6,"ب",1,0],["مِنّا الفُروعُ اللَواتي لا يُوازِنُها","فَخرٌ وَحَظُّكَ في تِلكَ العَراقيبُ",7,"ب",1,0],["مِنّا الكَواهِلُ وَالأَعناقُ تَقدُمُها","وَالرَأسُ مِنّا وَفيهِ السَمعُ وَالبَصَرُ",8,"ر",1,0],["مِنّا إِلَيكَ كَفَقرِ مُمحِلَةٍ","تَرجو الرَبيعَ لِرُزَّمٍ عَشرِ",9,"ر",1,0],["مِنّا الخَلائِفُ وَالنَبِيُّ مُحَمَّدٌ","وَإِلَيهِمُ مُلكُ العِبادِ يَصيرُ",10,"ر",1,1],["مِنّا الَّذي اِختيرَ الرِجالَ سَماحَةً","وَخَيراً إِذا هَبَّ الرِياحُ الزَعازِعُ",11,"ع",1,1],["مِنّا الَّذي جَمَعَ المُلوكَ وَبَينَهُم","حَربٌ يَشِبُّ سَعيرُها بِضِرامِ",12,"م",1,0],["مِنّا العُهودَ وَلا يَكونَ وِصالُكُم","مَذقَ الحَديثِ بِلَطِّ دَينِ المُفرِضِ",13,"ض",1,0],["مِنّا الفَوارِسُ وَالأَملاكُ قَد عَلِمَت","عُليا مَعَدّ وَمِنّا كُلُّ ذي حَسَبِ",14,"ب",1,0],["منا القلب عطفا بالمسيء برحمة","فان كروب السيئات توالت",15,"ت",1,1],["مِنّا الَّذي جادَ بِالنَفسِ الخَطيرَةِ في","عِزِّ العَشيرَةِ حَتّى اِستَرحَلَ العَجَما",16,"م",2,0],["مِنّا الَّذي قامَ سُلطانُ العِراقِ لَهُ","جَلالَةً وَالمَدى وَالبُعدُ بَينَهُما",16,"م",2,0],["مِنّا الَّذي حازَ مِن ثاجٍ إِلى قَطَرٍ","وَصَيَّرَ الرَملَ مِن مالِ العَدُوِّ حِمى",16,"م",2,0],["مِنّا الَّذي حينَ عَدَّ الأَلفَ خازِنُهُ","لِضَيفِهِ قالَ ضاعِفها أَرى أَمَما",16,"م",2,0],["مِنّا الَّذي مِن نَداهُ ماتَ عامِلُهُ","غَمّاً وَأَصبَحَ في الأَمواتِ مُختَرَما",16,"م",2,0],["مِنّا الَّذي جادَ إِيثاراً بِما مَلَكَت","كَفّاهُ لا يَدَ يَجزِيها وَلا رَحِما",16,"م",2,0],["مِنّا الَّذي أَنهَبَ اِصطَبلاتِهِ كَرَماً","وَهيَ الجِيادُ اللَواتي فاتَتِ القِيَما",16,"م",2,0],["مِنّا الَّذي فَضَّ أَموالَ الخَزائِنِ في","غَوثِ الرَعِيَّةِ لا قَرضاً وَلا سَلَما",16,"م",2,0],["مِنّا الَّذي جَعَلَ الأَقطاعَ مِن كَرَمٍ","إِرثاً تَوَزَّعُهُ الوُرّاثُ مُقتَسَما",16,"م",2,0],["مِنّا الَّذي أَنفَقَ الأَموالَ عَن عَرضٍ","حَتّى رَأَى شِعبَ شَملِ العِزِّ مُلتَئِما",16,"م",2,0],["مِنّا المُسَوَّرُ تَعظيماً وَوالِدُهُ","كَذاكَ كانَ فَنَحنُ السادَةُ العُظَما",16,"م",2,0],["مِنّا الَّذي كُلَّ يَومٍ فَوقَ دارَتِهِ","داعٍ يُنادي إِلَيهِ الجائِعَ الضَرِما",16,"م",2,0],["مِنّا الَّذي لَم يَدَع ناراً بِساحَتِهِ","تذكى سِوى نارِهِ لِلضّيفِ إِن قَدِما",16,"م",2,0],["مِنّا الَّذي عامَ حَربِ النائِليِّ حَلا","يَومَ السُبَيعِ وَيَومَ الخائِسِ الغُمَما",16,"م",2,0],["مِنّا الَّذي مَنَعَ الأَعداءَ هَيبَتهُ","حَربَ البِلادِ فَما شَدّوا لَهُ حُزُما",16,"م",2,0],["مِنّا الَّذي ضُرِبَت حُمرُ القِبابِ لَهُ","بِالمَشهَدَينِ وَأَعطى الأَمنَ وَاِنتَقَما",16,"م",2,0],["مِنّا الَّذي أصحَبَ المُجتازَ مِن حَلَبٍ","إِلى العِراقِ إِلى نَجدٍ إِلى أَدَما",16,"م",2,0],["مِنّا الَّذي كُلَّ عامٍ بِالعِراقِ لَهُ","رَسمٌ سَنِيٌّ إِلى أَن ضُمِّنَ الرُجَما",16,"م",2,0],["مِنّا الَّذي رَكَزَ الرُمحَينِ ضاحِيَةً","وَجَوّزَ العَرَبَ العَرباءَ بَينَهُما",16,"م",2,0],["مِنّا أَبُو يُوسُفٍ وَالمُرتَجى حَسَنٌ","وَاِبنُ الإِمارَةِ وَالبَيتِ المُنيفِ هُما",16,"م",2,0],["مِنّا الَّذي أَبطَلَ الماشُوشَ فَاِنقَطَعَت","آثارُهُ وَاِنمَحى في الناسِ وَاِنطَسَما",16,"م",2,0],["مِنّا الأَميرُ أَبو فَضلٍ مَتى اِختَصَمَت","بَنُو الوَغى كانَ في أَرواحِها الحَكَما",16,"م",2,0],["منّا الأَميرُ حَوارِيٌّ وَوالِدُهُ","فَاِذكُرهُما فَلَقد طابا وَقَد كَرُما",16,"م",2,0],["مِنّا أَبو فاضِلٍ وَاللَوذَعيُّ أَبُو","مَذكُورٍ القرمُ فَلنَفخَر بِمثلِهِما",16,"م",2,0],["مِنّا الَّذي حَطَّ زُهداً عَن رَعِيَّتهِ","كُلَّ المُكُوسِ فَأَضحى الجَورُ مُنحَسِما",16,"م",2,0],["مِنّا الثَلاثَةُ وَالفردُ الَّذينَ لَقُوا","كَتائِباً كَأبي السَيّالِ حِينَ طَما",16,"م",2,0],["مِنّا الرِجالُ الثَمانُونَ الَّذينَ هُمُ","يَومَ القَطيعَةِ أَوفى مَعشَرٍ ذِمَما",16,"م",2,0],["مَنَّا النَّبِيُّ رَسُولُ اللهِ لَيْسَ لَهُ","شِبْهٌ يُقَاسُ بِهِ فِي الْعُجْمِ وَالْعَرَبِ",17,"ب",1,0],["منا الذي هو ما إن طرَّ شاربهُ","والعانسونَ ومنّا المُردُ والشِّيبُ",18,"ب",1,0],["مِنّا العشائرُ والبلادُ تمزَّقت","فمتى نلمُّ بِجِدِّنا الأشعاثا",19,"ث",2,0],["منّا السَّلامُ على ربوعِ أحبَّةٍ","مِنها ومنكنَّ الهوى يُدنينا",20,"ن",2,0],["منّا السلامُ على ما فيكِ من رممٍ","ومن قبورٍ وأطلالٍ تصابينا",21,"ن",2,0],["مِنَّا المَدائِحُ والمَنائِحُ مِنكُمُ","كُلٌّ بِما يُعْزَى إليهِ جَدِيرُ",22,"ر",1,1],["مِنّا السلام عَلَيكُم وَالتَحيّة ما","لَنا المُهيمن بِالستر الجَميل حَبا",23,"ب",2,0],["منا النجوم طوالع","وغوارب تحت السنا",24,"ن",2,0],["منا السعيد الذي ما غره أمل","ولا صبته ذوات الدل والهيف",25,"ف",1,0],["مِنّا إِذا بَلَغَ الصَبِيُّ فِطامَهُ","سائِسُ الأُمورِ وَحارِبُ الأَقوامِ",26,"م",1,0],["مِنّا النبيُّ والوصِيُّ صِنْوُهُ","ثُمّ البَتولُ والحسينُ والحَسَنْ",27,"ن",1,0],["منّا الوصالُ ومنكُمُ الهجرُ","وعلى إساءَتكمْ بنا الشّكرُ",28,"ر",1,1],["مِنَّا السَّلامُ على مَن لا سَلامَ لَنا","منهُ ولا بَرْدَ يُطفي غُلَّةَ الضَرَمِ",29,"م",1,0],["منا السَّلامُ عليكَ لكنْ يا تُرَى","هل مَن يُبلِّغُكَ السَّلامَ مُرَدَّدا",30,"د",2,0],["مِنَّا السَّلامُ بكل تَكْرِمةٍ على","مَن لم يَمُدَّ إلى وَداعٍ خِنصِرا",31,"ر",2,0],["مِنا السَّلامُ عليكَ حيثُ نَزَلْتَ مِن","شَرْقِ البِلادِ وغَرْبِها ولَكَ الثَّنا",32,"ا",1,0]]}