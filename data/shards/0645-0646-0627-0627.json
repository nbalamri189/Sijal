{"poems":[[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[43,"بان الخليط بمن علقت فانصدعوا","https://www.aldiwan.net/poem42370.html","البسيط"],[32,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[29,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[30,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[30,"نكفي الأعنة يوم الحرب مشعلة","https://www.aldiwan.net/poem1282.html",""],[30,"يختلف الناس ما لم نجتمع لهم","https://www.aldiwan.net/poem5068.html","البسيط"],[30,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[30,"منا الخلائف والنبي محمد","https://www.aldiwan.net/poem5169.html","الكامل"],[30,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[30,"عفى المنازل آخر الأيام","https://www.aldiwan.net/poem5617.html","الكامل"],[18,"يا حار لا تجهل على أشياخنا","https://www.aldiwan.net/poem23928.html","الكامل"],[33,"يا سكن قد والله رب محمد","https://www.aldiwan.net/poem42470.html","الكامل"],[41,"لمن ديار بهذا الجزع من ربب","https://www.aldiwan.net/poem53814.html","البسيط"],[148,"منا القلب عطفا بالمسيء برحمة","https://www.aldiwan.net/poem4458.html","الطويل"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[178,"لو أن ذا حسب نال السماء به","https://www.aldiwan.net/poem46073.html","البسيط"],[268,"إما ترينا وقد خفت مجالسنا","https://www.aldiwan.net/poem453.html",""],[275,"من كان في تاريخه بحاثا","https://www.aldiwan.net/poem35001.html","الكامل"],[275,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[353,"منا المدائح والمنائح منكم","https://www.aldiwan.net/poem20371.html","الكامل"],[358,"نستودع الله أرضا تنبت الطربا","https://www.aldiwan.net/poem40578.html","البسيط"],[447,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[447,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[556,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[567,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[567,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[567,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[567,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59600","الكامل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96567","الطويل"],[567,"","https://poetry.dctabudhabi.ae/diwan/poem/43036","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95557","الكامل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21664","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21667","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21661","المنسرح"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109582","البسيط"],[2351,"","https://poetry.dctabudhabi.ae/diwan/poem/202633","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74151","البسيط"],[3136,"","https://poetry.dctabudhabi.ae/diwan/poem/204087","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82806","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48421","البسيط"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128538","الكامل"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18584","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131197",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131046",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131030",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69904","الكامل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45312","الطويل"],[4702,"أمي .. عتاب وولاء","https://www.poetsgate.com/ViewPoem.aspx?id=155213",""],[4924,"مهما يقولون","https://www.poetsgate.com/ViewPoem.aspx?id=19688",""],[5083,"تَدَحْرُجُ الدُرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=53679",""],[5198,"المناجيم","https://www.poetsgate.com/ViewPoem.aspx?id=136104",""],[5595,"منّا اليك ومن ميسانَ نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=144640",""],[5605,"رجاء وطلب","https://www.poetsgate.com/ViewPoem.aspx?id=160587",""],[5851,"قلب بحجم الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=175288",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""]],"verses":[["مِنّا المُعينُ عَلى النَدى بِفَعالِهِ","وَالبَذلِ في اللَزَباتِ بِالأَموالِ",0,"ل",1,0],["مِنَّا الأَنَاةُ وَبَعضُ القَومِ يَحسَبُنَا","إِنَّا بِطَاءٌ وفي إِبطَائِنَا سَرَعُ",1,"ع",1,0],["مِنَ اآثار النُسوعَ زَمانَ مَيٍّ","صَديقٌ لا تُحِبُّ بِهِ بَديلا",2,"ل",2,0],["مِنّا أَبو قَيسٍ وَمِنّا الحَوطان","وَاِبنُ زُهَيرٍ مُعلِماً وَالعَمران",3,"ن",1,0],["مِنّا الفَوارِسُ قَد عَلِمتَ وَرائِسٌ","تَهدي قَنابِلَهُ عُقابٌ تَلمَعُ",4,"ع",1,0],["مِنّا الَّذي يُحمَدُ مَعروفُهُ","وَيَفرُجُ اللَزبَةَ يَومَ الزِحام",5,"م",1,0],["مِنّا الرَسولُ وَكُلُّ أَزهَرَ بَعدَهُ","كَالبَدرِ وَهوَ خَليفَةٌ في المَوكِبِ",6,"ب",1,0],["مِنّا الفُروعُ اللَواتي لا يُوازِنُها","فَخرٌ وَحَظُّكَ في تِلكَ العَراقيبُ",7,"ب",1,0],["مِنّا الكَواهِلُ وَالأَعناقُ تَقدُمُها","وَالرَأسُ مِنّا وَفيهِ السَمعُ وَالبَصَرُ",8,"ر",1,0],["مِنّا إِلَيكَ كَفَقرِ مُمحِلَةٍ","تَرجو الرَبيعَ لِرُزَّمٍ عَشرِ",9,"ر",1,0],["مِنّا الخَلائِفُ وَالنَبِيُّ مُحَمَّدٌ","وَإِلَيهِمُ مُلكُ العِبادِ يَصيرُ",10,"ر",1,1],["مِنّا الَّذي اِختيرَ الرِجالَ سَماحَةً","وَخَيراً إِذا هَبَّ الرِياحُ الزَعازِعُ",11,"ع",1,1],["مِنّا الَّذي جَمَعَ المُلوكَ وَبَينَهُم","حَربٌ يَشِبُّ سَعيرُها بِضِرامِ",12,"م",1,0],["مِنّا إِذا بَلَغَ الصَبِيُّ فِطامَهُ","سائِسُ الأُمورِ وَحارِبُ الأَقوامِ",13,"م",1,0],["مِنّا العُهودَ وَلا يَكونَ وِصالُكُم","مَذقَ الحَديثِ بِلَطِّ دَينِ المُفرِضِ",14,"ض",1,0],["مِنّا الفَوارِسُ وَالأَملاكُ قَد عَلِمَت","عُليا مَعَدّ وَمِنّا كُلُّ ذي حَسَبِ",15,"ب",1,0],["منا القلب عطفا بالمسيء برحمة","فان كروب السيئات توالت",16,"ت",1,1],["مِنّا الَّذي جادَ بِالنَفسِ الخَطيرَةِ في","عِزِّ العَشيرَةِ حَتّى اِستَرحَلَ العَجَما",17,"م",2,0],["مِنّا الَّذي قامَ سُلطانُ العِراقِ لَهُ","جَلالَةً وَالمَدى وَالبُعدُ بَينَهُما",17,"م",2,0],["مِنّا الَّذي حازَ مِن ثاجٍ إِلى قَطَرٍ","وَصَيَّرَ الرَملَ مِن مالِ العَدُوِّ حِمى",17,"م",2,0],["مِنّا الَّذي حينَ عَدَّ الأَلفَ خازِنُهُ","لِضَيفِهِ قالَ ضاعِفها أَرى أَمَما",17,"م",2,0],["مِنّا الَّذي مِن نَداهُ ماتَ عامِلُهُ","غَمّاً وَأَصبَحَ في الأَمواتِ مُختَرَما",17,"م",2,0],["مِنّا الَّذي جادَ إِيثاراً بِما مَلَكَت","كَفّاهُ لا يَدَ يَجزِيها وَلا رَحِما",17,"م",2,0],["مِنّا الَّذي أَنهَبَ اِصطَبلاتِهِ كَرَماً","وَهيَ الجِيادُ اللَواتي فاتَتِ القِيَما",17,"م",2,0],["مِنّا الَّذي فَضَّ أَموالَ الخَزائِنِ في","غَوثِ الرَعِيَّةِ لا قَرضاً وَلا سَلَما",17,"م",2,0],["مِنّا الَّذي جَعَلَ الأَقطاعَ مِن كَرَمٍ","إِرثاً تَوَزَّعُهُ الوُرّاثُ مُقتَسَما",17,"م",2,0],["مِنّا الَّذي أَنفَقَ الأَموالَ عَن عَرضٍ","حَتّى رَأَى شِعبَ شَملِ العِزِّ مُلتَئِما",17,"م",2,0],["مِنّا المُسَوَّرُ تَعظيماً وَوالِدُهُ","كَذاكَ كانَ فَنَحنُ السادَةُ العُظَما",17,"م",2,0],["مِنّا الَّذي كُلَّ يَومٍ فَوقَ دارَتِهِ","داعٍ يُنادي إِلَيهِ الجائِعَ الضَرِما",17,"م",2,0],["مِنّا الَّذي لَم يَدَع ناراً بِساحَتِهِ","تذكى سِوى نارِهِ لِلضّيفِ إِن قَدِما",17,"م",2,0],["مِنّا الَّذي عامَ حَربِ النائِليِّ حَلا","يَومَ السُبَيعِ وَيَومَ الخائِسِ الغُمَما",17,"م",2,0],["مِنّا الَّذي مَنَعَ الأَعداءَ هَيبَتهُ","حَربَ البِلادِ فَما شَدّوا لَهُ حُزُما",17,"م",2,0],["مِنّا الَّذي ضُرِبَت حُمرُ القِبابِ لَهُ","بِالمَشهَدَينِ وَأَعطى الأَمنَ وَاِنتَقَما",17,"م",2,0],["مِنّا الَّذي أصحَبَ المُجتازَ مِن حَلَبٍ","إِلى العِراقِ إِلى نَجدٍ إِلى أَدَما",17,"م",2,0],["مِنّا الَّذي كُلَّ عامٍ بِالعِراقِ لَهُ","رَسمٌ سَنِيٌّ إِلى أَن ضُمِّنَ الرُجَما",17,"م",2,0],["مِنّا الَّذي رَكَزَ الرُمحَينِ ضاحِيَةً","وَجَوّزَ العَرَبَ العَرباءَ بَينَهُما",17,"م",2,0],["مِنّا أَبُو يُوسُفٍ وَالمُرتَجى حَسَنٌ","وَاِبنُ الإِمارَةِ وَالبَيتِ المُنيفِ هُما",17,"م",2,0],["مِنّا الَّذي أَبطَلَ الماشُوشَ فَاِنقَطَعَت","آثارُهُ وَاِنمَحى في الناسِ وَاِنطَسَما",17,"م",2,0],["مِنّا الأَميرُ أَبو فَضلٍ مَتى اِختَصَمَت","بَنُو الوَغى كانَ في أَرواحِها الحَكَما",17,"م",2,0],["منّا الأَميرُ حَوارِيٌّ وَوالِدُهُ","فَاِذكُرهُما فَلَقد طابا وَقَد كَرُما",17,"م",2,0],["مِنّا أَبو فاضِلٍ وَاللَوذَعيُّ أَبُو","مَذكُورٍ القرمُ فَلنَفخَر بِمثلِهِما",17,"م",2,0],["مِنّا الَّذي حَطَّ زُهداً عَن رَعِيَّتهِ","كُلَّ المُكُوسِ فَأَضحى الجَورُ مُنحَسِما",17,"م",2,0],["مِنّا الثَلاثَةُ وَالفردُ الَّذينَ لَقُوا","كَتائِباً كَأبي السَيّالِ حِينَ طَما",17,"م",2,0],["مِنّا الرِجالُ الثَمانُونَ الَّذينَ هُمُ","يَومَ القَطيعَةِ أَوفى مَعشَرٍ ذِمَما",17,"م",2,0],["مَنَّا النَّبِيُّ رَسُولُ اللهِ لَيْسَ لَهُ","شِبْهٌ يُقَاسُ بِهِ فِي الْعُجْمِ وَالْعَرَبِ",18,"ب",1,0],["منا الذي هو ما إن طرَّ شاربهُ","والعانسونَ ومنّا المُردُ والشِّيبُ",19,"ب",1,0],["مِنّا العشائرُ والبلادُ تمزَّقت","فمتى نلمُّ بِجِدِّنا الأشعاثا",20,"ث",2,0],["منّا السَّلامُ على ربوعِ أحبَّةٍ","مِنها ومنكنَّ الهوى يُدنينا",21,"ن",2,0],["منّا السلامُ على ما فيكِ من رممٍ","ومن قبورٍ وأطلالٍ تصابينا",22,"ن",2,0],["مِنَّا المَدائِحُ والمَنائِحُ مِنكُمُ","كُلٌّ بِما يُعْزَى إليهِ جَدِيرُ",23,"ر",1,1],["مِنّا السلام عَلَيكُم وَالتَحيّة ما","لَنا المُهيمن بِالستر الجَميل حَبا",24,"ب",2,0],["منا النجوم طوالع","وغوارب تحت السنا",25,"ن",2,0],["منا السعيد الذي ما غره أمل","ولا صبته ذوات الدل والهيف",26,"ف",1,0],["مِنّا النبيُّ والوصِيُّ صِنْوُهُ","ثُمّ البَتولُ والحسينُ والحَسَنْ",27,"ن",1,0],["منّا الوصالُ ومنكُمُ الهجرُ","وعلى إساءَتكمْ بنا الشّكرُ",28,"ر",1,1],["مِنَّا السَّلامُ على مَن لا سَلامَ لَنا","منهُ ولا بَرْدَ يُطفي غُلَّةَ الضَرَمِ",29,"م",1,0],["منا السَّلامُ عليكَ لكنْ يا تُرَى","هل مَن يُبلِّغُكَ السَّلامَ مُرَدَّدا",30,"د",2,0],["مِنَّا السَّلامُ بكل تَكْرِمةٍ على","مَن لم يَمُدَّ إلى وَداعٍ خِنصِرا",31,"ر",2,0],["مِنا السَّلامُ عليكَ حيثُ نَزَلْتَ مِن","شَرْقِ البِلادِ وغَرْبِها ولَكَ الثَّنا",32,"ا",1,0],["منّا المودّة والوَلاءُ ومن يرد","بدلاً بآلِ محمد لا يُحببِ",33,"ب",1,0],["منا الخطاب وعقده المتنضد","يهدي إلى قصد السبيل ويُرشد",34,"د",1,1],["منا الذين استنشطوا الأَمرَ جهرةً","يُقَدِّمُهُم عارى الأَشاجع أَروعُ",35,"ع",1,1],["مَنَّا السَّلامُ عليكَ غيرَ مُودَّعٍ","وعلى ضريحٍ بِتَّ فيهِ مُوسَّدا",36,"د",2,0],["منا السلام عليه ما","فاض الغمام على اللحود",37,"د",1,0],["مِنّا الرَسولُ نَخيرُ الناسَ كُلَّهُمُ","وَلا نُحاشي مِن الأَقوامِ إِنسانا",38,"ن",2,0],["مِنّا الرِسولُ وَأَهلُ الفَضلِ أَفضَلُهُم","مِنّا وَصاحِبُهُ الصَدّيقُ في الغارِ",39,"ر",1,0],["مِنّا الخَلائِفُ وَالمُستَمطَرونَ نَدىً","وَقادَةُ الناسِ في بَدوٍ وَأَمصارِ",39,"ر",1,0],["مِنّا النَبِيُّ الأُمِيُّ سُنَّتُهُ","فاضِلَةٌ نافِعٌ تَعَلُّمُها",40,"م",3,0],["مِنّا الثَناءُ وَمِنكَ الصَيِّبُ الغَدِقُ","فَضلٌ يَعُمُّ وَشُكرٌ طَيِّبُ عَبِقُ",41,"ق",1,1],["منا السلام على دار اقام بها","ظبي تحجب عن اجفان مضناهُ",42,"ه",1,1],["مِنّا التبَّايِعةُ اليمانون الأُلى","ملكوا البسيطة سَلْ بذلك تُخْبرِ",43,"ر",1,1],["مِنا السَلام لعبد اللَه ما طلعت","شَمس فأشرق مِنها السَهل وَالجَبَل",44,"ل",1,0],["منا النبي الذي قد عاش مؤتمنا","وصاحباه وعثمان بن عفانا",45,"ن",2,0],["منا الصلاةُ عليهِ وَالسلامُ كما","تعُم آلا وَأَنصارا وَأَصحابا",46,"ب",2,0],["مِنّا الصّلاةُ عليكُمْ والسّلامُ إذا","ما كان للذِّكْرِ في الأفْواهِ ترْدادُ",47,"د",1,0],["منا الثناء إلى الأمائل كلما","لاقت جنابه باحتفال شيّق",48,"ق",1,0],["مِنّا الَّذي سَنَّ النَدى حاتمٌ","وَثابِتٌ منّا الخَطيبُ القَؤول",49,"ل",1,0],["منّا السلام عليك أجمعه","ما فاح من زهر الربى نشر",50,"ر",1,0],["منا الصحابة بل مصابيح الهدى","والأولياء الغرّ والأعلام",51,"م",1,0],["منا الجهابذة الأعاظم كلهم","لذوي المعارف والعلوم إمام",51,"م",1,0],["منا السلام على أهل الجهاد على","أُسد العرين على القوم الألى عظموا",52,"م",3,0],["منا الثَناءُ منكَ الدُعاءُ","فَلَكَ البَقاءُ لِيَوم النُشور",53,"ر",1,0],["منا المسرات والأفراح نامية","كانت بها عني الأحزان نابية",54,"ه",1,0],["مَنا اللَهُ أَن أَلقى حُمَيدَ بنَ بَحدَلٍ","بِمَنزِلَةٍ فيها إِلى النِصفِ مُعلَما",55,"م",2,1],["منا الوفا عرق ينبض لك ولو تجحدين","وْمنك العطا حقنا لو جاه من يدفنه",56,"ن",2,0],["منا الوفا ياوفي الروح يتعلم","وكل التعابير تبحر من شواطينا",57,"ن",2,0],["منّا إليها فَرْطُ وَجْدٍ ولَنا","منها إذا ذُكِرتْ سَحابةُ نَدِّ",58,"د",1,0],["منا المشايخ والعوارف والرياجيل الثقات","واهل القنا والسيف وقت الشدة وضيق النسم",59,"م",1,0],["منّا اليكَ ومن ميسانَ نهُديها","عرائسُ الشّعر في أبهى قوافيها",60,"ي",3,1],["منّا اليكَ مثالاً للنّهى رُفعت","يقظاتُ شعب ٍقد بانتْ معانيها",60,"ي",3,0],["مِنَّا الدعاء وهل غير الدُّعاءِ لنا","إِنَّ الدُّعاء رَفِيق القَولِ بالعَمَلِ",61,"ل",1,1],["منا السلام إلى المدائن كلها","تغريبنا أزرى بنا إزراء",62,"ا",1,0],["مِنَّا \"المَرَاعبَةُ\" الأُبَا","ةُ حَمَوْا مَرابِعَ حَوْضِنَا",63,"ن",2,0],["مِنَّا \"الزّعَابِنَةُ\" التُّقا","ةُ و\"أحمدٌ\" سَكَنُوا هُنَا",63,"ن",2,0],["مِنّا الزمانُ وخطْبُهُ يتعلُّمُ","وعلى خُطانا للعُلا يَتَرسّمُ",64,"م",1,1]]}