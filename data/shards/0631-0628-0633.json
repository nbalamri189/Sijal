{"poems":[[88,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[95,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[95,"أيها النائمون في الشرق من خفض","https://www.aldiwan.net/poem11402.html","الخفيف"],[74,"رب سوداء مقلة هيجت لي","https://www.aldiwan.net/poem18217.html","الخفيف"],[74,"قلت إذ عم علي بالندى","https://www.aldiwan.net/poem19037.html","المتقارب"],[87,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[87,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[47,"لا لصبر هجرتكم علم الله","https://www.aldiwan.net/poem65192.html","الخفيف"],[68,"رب سر لما تعمد قلبي","https://www.aldiwan.net/poem38468.html","الخفيف"],[54,"عللاني بصوت ناي وعود","https://www.aldiwan.net/poem27076.html","الخفيف"],[50,"رب ليل قطعته بانتحاب","https://www.aldiwan.net/poem10793.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141964","الطويل"],[108,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[108,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[108,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179294",""],[161,"نَعْيُ حَيٍّ","https://www.aldiwan.net/poem23653.html","الخفيف"],[186,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[228,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[234,"قد يزيد المدام للمرء طيبا","https://www.aldiwan.net/poem50798.html","الخفيف"],[396,"يا لطيف الطف بي فيجميع أحوالي","https://www.aldiwan.net/poem54515.html","عموديه"],[396,"حسين إعلم أن الشيطنه قد لها ناس","https://www.aldiwan.net/poem54560.html","عموديه"],[457,"رب ساق مقرطق من بني الفرس","https://www.aldiwan.net/poem13661.html","الخفيف"],[463,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[863,"","https://poetry.dctabudhabi.ae/diwan/poem/116086","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75776","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119956","السريع"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67690","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56109","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56648","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56651","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64552","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95564","الخفيف"],[1525,"","https://poetry.dctabudhabi.ae/diwan/poem/116111","الرمل"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107344","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125365","الخفيف"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89677","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111227","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93898","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93870","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93923","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93829","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201263","المنسرح"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115773","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74057","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126950","المديد"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110080","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205893","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133163","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133085","المديد"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133106","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83188","الرجز"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101284","الخفيف"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130283","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52135","الخفيف"],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[5393,"رب شيخ يمد للحق رجلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85468&r=&rc=35",""]],"verses":[["رُبَّ ساعٍ مُبصِرٍ في سَعيِهِ","أَخطَأَ التَوفيقَ فيما طَلَبا",0,"ب",2,0],["رُبَّ سَهْلٍ تَقَشَّعَ الْعَارِضُ الْهَطَّا","لُ عَنْهُ كَمَا يَمُرُّ الْجَهَامُ",1,"م",1,0],["رُبَّ سَيْفٍ جَلا بِهِ الخِفْرُ قُدْماً","بَارِقاً فِي طَلِيعَةِ الأَعْلامِ",2,"م",1,0],["رُبَّ سوداء مقلةٍ هيجتْ لي","داءَ وجدٍ أعظم بهِ من داء",3,"ا",2,1],["رَبّ سخَّر ليَ موسى مسعفاً","يا إلهاً سخَّر البحر لموسى",4,"س",2,0],["رُبَّ سَجعٍ كَمُرقِصِ الشِعرِ لَمّا","يَختَلِف لَحنُهُ وَلا إيقاعُه",5,"ع",2,0],["رُبَّ سامي البَيانِ نَبَّهَ شَأني","أَنا أَسمو إِلى نَباهَةِ شانِه",6,"ن",2,0],["رُبَّ سَيفٍ ضَرَبَ الجَمعُ بِهِ","في كُنوزِ البَحرِ مَطروحَ الكِسَر",7,"ر",1,0],["رُبَّ سِربٍ قاطِعٍ مَرَّ بِهِ","هَبَطَ الأَرضَ مَلِيّاً وَاِستَراح",8,"ح",1,0],["رُبَّ سِرٍّ بِجانِبَيكَ مُزالٍ","كانَ حَتّى عَلى الفَراعينِ غُمضا",9,"ض",2,0],["رُبَّ سَفرٍ أَتاكَ غَرثانَ مِن زا","دِ اللُهى أُشبِعَت نَوالاً خِماصُه",10,"ص",2,0],["رُبَّ سِرٍّ شَرَكتُ فيهِ ضَميري","وَطَواهُ اللِسانُ عِندَ التَلاقي",11,"ي",1,0],["رب سر لما تعمد قلبي","قتله ما وشى عليه لساني",12,"ي",1,1],["رَبُّ سُكرٍ جَعَلتُ مَوعِدَهُ الصُب","حَ وَساقٍ حَثَثتُهُ بِمَزيدِ",13,"د",1,0],["رُبَّ سِلمٍ قَد صارَ لي فيكِ حَرباً","رُبَّ نَفسٍ كَلَّفتُموها عِتابي",14,"ب",2,0],["رب سيّاحة أَتَت مِن بَعيد","تطلب الشمس صبة باللقاء",15,"ا",2,0],["رُبَّ سِرٍّ قَد حَلَّ جِسمَ صَغيرٍ","وَتَأَبّى عَلى شَديدِ المِحالِ",16,"ل",1,0],["رُبّ سرٍّ طوتهُ ظاهرةٌ حمقاء","يطوي البسيط برا وبحرا",17,"ر",2,0],["ربِّ سِنٍ أعولت أو ناجذٍ","بات من بعدك في ذُلِّ اليتامى",18,"م",2,0],["ربَّ سهم في الجو أصمى، وسهم","في الثرى عيَّ أن يصيد الذبابا!",19,"ب",2,0],["ربِّ سِنٍ أعولت أو ناجذٍ","كلُّ أقرانك يُقريك السلاما",20,"م",2,0],["رَبِّ سَلِّمْ روحي فَأنْتَ ملاذِي","يَوْمَ تُطْوَى صَحِيفَتِي وَ تُسَلَّمْ",21,"م",1,0],["رُبَّ سِلمٍ جَنَت مِن الشَر ما لَم","تَجنهِ الحَربُ حينَ دارَت رَحاها",22,"ا",3,0],["ربَّ سيفٍ مُذ قام يشرح شرحاً","عَلِمَت دينَ أحمد الجهلاءُ",23,"ا",2,0],["رُبَّ سِفرٍ أَضاسَ هَيكَلَ نورٍ","خَلَدَت فيهِ مُقلَتا شِكسبيرِ",24,"ر",1,0],["رُبَّ سِفرٍ مَحا قُصورَ الدهاقي","نِ وَأَعلى بِالمَجدِ كوخَ الفَقيرِ",24,"ر",1,0],["ربِّ سَقِّ دَيْرَ القصير فأني","نلتُ لذّاته وطيبَ نسيمِه",25,"م",2,0],["رب سلم سلم دعوة الممجد","إذ رأى جهنم والتعب قد اشتد",26,"د",1,0],["رب سلم وكن لي في حياتي والأرماس","وأصلح أهلي ومن لي به تعلق وامساس",27,"س",1,0],["ربَّ ساق مقرطق من بني الفرس","خلونا به بغير رقيبِ",28,"ب",1,1],["ربّ سميرٍ سقاطُ فيه","للهمِّ أنفَى من الشَّمولِ",29,"ل",1,0],["رُبَّ سَيفٍ رُبَّ ضَيفٍ","رُبَّ إفحامٍ لِخَصمِ",30,"م",1,0],["رُبَّ سَاعٍ لحَتفه وهوَ ممَّن","ظَنَّ بالسَّعى للعُلاَ يَتَوَصَّل",31,"ل",1,0],["رب ساقي قهوة تَحلو به","فنجانه إِن صَدّ أَو أَهدى بِها",32,"ه",2,1],["رب سيوف الهند مشحوذه","والخيل قبا والرماح اللدان",33,"ن",1,0],["رُبّ ساعٍ لِقَاعِدِ","واسلمي أمّ خالدِ",34,"د",1,1],["رب ساداتٍ سقاهم","ربهم كاساً طهورا",35,"ر",2,0],["رب سر أودعته في قلوب","كزجاج الأقداح منها استبينا",36,"ن",2,0],["رب سر مكتم","لم نجده مكتما",37,"م",2,0],["رب سلطانك النصير نصيري","وخلوص الدعا سيوفي ونبلي",38,"ل",2,0],["رب سار علي وتيرة نجم","فاقه واعتلى السماكين هامَا",39,"م",2,0],["رُبَّ ساقٍ وهو قاسٍ قلبُه","عِطفُه منذُ أدارَ الكأسَ لان",40,"ن",1,0],["رُبَّ سُهدٍ يراهُ كالشهدِ في دَف","عِ مُلِمٍّ عن عاجزٍ لَهفانِ",41,"ن",1,0],["ربِّ ساعِد عَلى البَيانِ لساني","في جمال قد ضاعَ فيه بياني",42,"ن",2,1],["رب سِر كتمتهُ فَكَأَنّي","اِخرس اِو ثَنى لِساني عَقل",43,"ل",1,1],["رَبِّ سامِح مِصرَ وَاِغفِر ذَنبَها","وَاِهدِها لِلرُشدِ في المُستَقبَلِ",44,"ل",1,0],["رب ساع حتفه فيما سعى","لج في السعي ولم يدر مما",45,"م",2,0],["رب سوداء في الكؤوس تبدت","تهب الروح نفحة في الحياة",46,"ه",1,1],["رب ساق أدارها وهو قاس","فألانت أعطافه وفؤاده",47,"د",2,0],["رب ساق أدار كاس حديث","هي أحلى من الشراب القديم",48,"م",1,0],["رب ساق قد لان عطفا ولكن","هو قاس قلباً إذا ما تجنى",49,"ن",2,0],["رب ساق سعى بها فأراني","طلعة الشمس في يد الأقمار",50,"ر",1,0],["رب سار بالحي آنس نارا","فأتى حانها مريد اقتباس",51,"س",1,0],["رب ساق سعى وحيى بكاس","وأتى الحجر في المطاف وزمزم",52,"م",1,0],["رب ساق قد نزه الشرب فيها","عن صدود وجفوة وملال",53,"ل",1,0],["رُب سمين كأنه الجبلُ","في كل جزء من جسمه حبل",54,"ل",1,1],["رب سيف يقضم الصخر","حسام هند وانى",55,"ن",2,1],["رُبّ ساع ليجتني طيب عيش","وهو يجني وليس يدري حمامه",56,"م",2,0],["ربّ سعيٍ أَصابَ نجحاً وَسعي","عادَ في الناس نجحه إِخفاقا",57,"ق",2,0],["رب سهم من ماحرجه","نافذ أصمى به ودجى",58,"ج",2,0],["رُبَّ سِربٍ لو جاءَ في عهد موسى","كَانَ لِلّهِ افضلَ الإِنعامِ",59,"م",1,1],["رُبَّ سارٍ بات في أركانه","ودَّ لو يَسبق سبَّاق البخار",60,"ر",1,0],["رَب سُبحانَك إِن الكَون","لا يَقَدر نَفسه",61,"ه",1,0],["رب سهل لي زيارة طيبةٍ","وبقبر المصطفى امسح وجنتي",62,"ي",1,0],["رب سلم ووفق يا كريم","للهدى اصلح جميع ما فسد",63,"د",1,0],["رب سلمنا أعذنا","من هوان واغتماص",64,"ص",1,0],["رُبَّ سكوتٍ عِيُّ","وَرُبَّ نُطق غَيُّ",65,"ي",1,0],["رب سوداء كالكؤوس تبدت","تهب الروح نفحة في الحياة",66,"ه",1,1],["رب سيد يحمي الخميس بعضب","ويجلي ظلام ليل الخميس",67,"س",1,0],["رُبّ سامعٍ نبأ","وَدَّ لو به صَمَمُ",68,"م",1,0],["رُبَّ سعدٍ يجيءُ للمرء عفواً","وشقاءٍ لكلن يجيءُ اضظرارا",69,"ر",2,0],["رب سمني بوسام العز من","سمة النصر بفرقان السمات",70,"ت",1,0],["رُبَّ سيل ٍمن المجازر قد طالَ","( فلسطينَ ) والليالي سُكونُ",71,"ن",1,0],["رب سلِّم ثمَّ بارك وعظِّما","ومجِّد ثمَّ فخِّم وصل كل الصلا",72,"ل",2,0],["رب سيف.. يخون عند التلاقي","ودليلٍ.. ولا يكون صدوقا",73,"ق",2,0]]}