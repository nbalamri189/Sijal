{"poems":[[87,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104566","الطويل"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137299",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74235","البسيط"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110747","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87650","الوافر"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130613","الطويل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141892","الطويل"],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""]],"verses":[["به هجر يتيمه","كلا جفنيك يعلمه",0,"م",2,1],["به هامت الأرواح في حال كونها","مجردة عن كل جسم وخاطر",1,"ر",1,0],["به هذّبَ اللَه الأمورَ سديدةً","وهيأ سهماً في العداةِ مُسدّدا",2,"د",2,0],["به هدانا الا له من بهم ال","كفر إلى نوره رحمته",3,"ت",2,0],["بِهِ هَزَّ أَعْطَافَ الزَّمَانِ وأَهْلَهُ","صَنِيعٌ لَهُ خِصْرٌ وَنَاهِيكَ مِنْ خِصْرِ",4,"ر",1,0],["به هنوا اباه اميل شامي","وهنوا امه ما تيلدا اسود",5,"د",1,0],["بِهِ هدى اللَه أَقواماً وَأَيدهُم","فَأَصبَحوا وَعَلى المنهاج قَد ساروا",6,"ر",3,0],["به هدى اللَه أقواما أعزبهم","دينا أذل به الأوثان وانقلبا",7,"ب",2,0],["بِهِ هتف المُؤَرّخ في هناهُ","وَما احلى البشارةَ بالخَليلِ",8,"ل",1,0],["به هن عباس العلى بل وهنه","بعباس ماضي البأس شمس المناقب",9,"ب",1,0],["به هبّ ريح منه أضحت سماؤه","وأقشع عنه غمّه وغمامه",10,"م",2,0],["به هامت الأفلاك عشقا بربها","وشعّت مدارات الجواري الكوانسِ",11,"س",1,0]]}