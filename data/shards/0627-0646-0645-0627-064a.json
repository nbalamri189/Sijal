oetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4056,"","https://poetry.dctabudhabi.ae/diwan/poem/143576","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4275,"","https://poetry.dctabudhabi.ae/diwan/poem/204552",""],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67625","الرمل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67646","الرمل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121293","الرمل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139276","الخفيف"],[4956,"دولة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=1392",""],[3591,"يا وجوه الجمال في أرض باري","https://www.poetsgate.com/ViewPoem.aspx?id=149479",""],[5136,"شيمتي رحمة الجهول","https://www.poetsgate.com/ViewPoem.aspx?id=121775",""],[4045,"يا أمير المؤمنين المرتضى","https://www.poetsgate.com/ViewPoem.aspx?id=200276",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5431,"نبعة النور مصر أرض السجود","https://www.poetsgate.com/ViewPoem.aspx?id=198662",""],[5542,"نحن أدرى","https://www.poetsgate.com/ViewPoem.aspx?id=10197",""],[5616,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=203430",""],[5691,"طغمة","https://www.poetsgate.com/ViewPoem.aspx?id=206083",""],[3856,"كَسَرَابٍ فِي أعيُنِ الظَّامِئينَا","https://www.poetsgate.com/ViewPoem.aspx?id=215914",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6093,"طفلةُ المَوصِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=187053",""],[6225,"سميرُ الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80929&r=&rc=198",""]],"verses":[["إِنَّما يَهلِكُ مِنّي ماجِدٌ","يولِغُ السَيفَ عَراقيبَ النَعَم",0,"م",1,0],["إِنَّما يُدَّخَرُ الما","لُ لِحاجاتِ الرِجالِ",1,"ل",1,0],["إِنَّما يُبكى لِمثلي أَنَّني","مُبتَلىً أَشكو إِلى غَيرِ رَحيم",2,"م",1,0],["إِنَّما يُكسِبُنا الحُزنُ","عَناءً لا غَناءَ",3,"ا",2,0],["إِنَّما يَحفَظُ التُقى الأَبرارُ","وَإِلى اللَهِ يَستَقِرُّ القَرارُ",4,"ر",1,1],["إنما يطلبُ الترفُّعَ بالبِز","زةِ والثروةِ الرجالُ التُّحوتُ",5,"ت",1,0],["إنما يشفعُ الكِرامُ من النا","س إلى كلّ ماجدٍ فعّالِ",6,"ل",1,0],["إنما يبكي شجيٌّ شَجَنَهْ","لا كما يبكي خليٌّ دِمنَهْ",7,"ن",2,1],["إنما يُستمالُ عن سمت رُشدٍ","من تَولاه رأيُك المأفون",8,"ن",1,0],["إِنَّما يَركَبُ الجَوادُ جَوادٌ","وَيَصونُ الذَمّارَ غَيرُ بَليدِ",9,"د",1,0],["ان ما يمليه علي يراعي","بعض ما في نفسي من الخطرات",10,"ت",1,0],["انما يحمد في الحر","بِ من السيف الذباب",11,"ب",1,0],["إنما يقدر الكرام كريم","ويقيم الرجال وزن الرجال",12,"ل",1,0],["إنما يبلغ الذي بلغوه","من حذا الحذو واقتفى الآثارا",13,"ر",2,0],["إِنَّما يُبكى شُعاعٌ نابِغٌ","كُلَّما مَرَ بِهِ الدَهرُ أَضاء",14,"ا",2,0],["إِنَّما يَسمَحُ بِالروحِ الفَتى","ساعَةَ الرَوعِ إِذا الجَمعُ اِشتَجَر",15,"ر",1,0],["إِنَّما يُنكِرُ الدِياناتِ قَومٌ","هُم بِما يُنكِرونَهُ أَشقِياءُ",16,"ا",2,0],["إِنَّما يَفخَرُ الكَريمُ أَبو المِس","كِ بِما يَبتَني مِنَ العَلياءِ",17,"ا",2,0],["إِنَّما يَستَميحُ نائِلَكِ الصَبُّ","وَيَشكو الهَوى إِلَيكِ العَميدُ",18,"د",1,0],["إِنَّما يَحفَظُ الأُمورَ وَيُتوي","هِنَّ بِحَزمٍ مُواشِكٍ أَو تَوانِ",19,"ن",1,0],["إِنَّما يُعرَفُ بِالفَض","لِ مَنِ الناسِ ذَوّهُ",20,"و",2,0],["إنما يفهم الشبيهُ شبيهاً","أيها البحر نحنُ لسنَا سواءَ",21,"ا",2,0],["إنّما يَنْعَمُ في الدّنْيا فَتىً","يدْفَعُ الجِدّ إليها في المزاح",22,"ح",1,0],["إِنَّما يَعرِفُ السُهادَ وَطولَ اللَي","لِ مَن حَبلُ وَصلِهِ مَصرومُ",23,"م",1,0],["إنما يعرفُ قدرَ العلمِ مَنْ","سهرَتْ عيناهُ في تحصيلِهِ",24,"ه",1,0],["إِنَّما يُدرك أَقصي الأَمل","ثابت القَلب عَلى ما عَزَما",25,"م",2,0],["إِنَّما يَنعَونَ نَفسي","إِذ تَداعَوا بِالرَحيلِ",26,"ل",1,0],["إنما يَذْكُرُ العَطِيَّةَ منْ كا","نتْ عَطاياهُ تارَةً بعدَ تارهْ",27,"ر",2,0],["إنَّما يُنقِصُ حَرفاً","في الحُسينِ بن عليّ",28,"ي",1,0],["إِنَّما يَعرِفُ الصَبابَةَ مَن با","تَ عَلى فُرقَةٍ مِنَ الأَحبابِ",29,"ب",1,0],["إِنَّما يَفتَضِحُ العا","شِقُ في وَقتِ الرَحيلِ",30,"ل",1,0],["إِنَّما يَشتَري المَحامِدَ حُرٌّ","طابَ نَفساً لَهُنَّ بِالأَثمانِ",31,"ن",1,0],["إنما يُذهبُ مالي","طولُ إدمانِ الشمول",32,"ل",1,0],["إنّما يُنْقَلُونَ مِنْ دارِ أعْما","لٍ إلى دارِ شِقْوَةٍ أو رَشَادِ",33,"د",1,0],["إنما يبكيني فراقُ حبيبي","وفراقُ الحبيب خطبٌ كبير",34,"ر",1,0],["إِنَّمَا يَبْتَغِي رِضَاهَا وَمَايُعْنَ","ى بِشُكْرٍ مِنْ غَيْرِهَا وَثَنَاءِ",35,"ا",2,0],["إِنَّما يَبْطِشُ ذُو الأَمرِ إِذا","لمْ يَخَفْ بَطْشَ الأُولى وَلَّوْهُ أَمْرَا",36,"ر",2,0],["إن ما يقدرُ النسيم عليهِ","بات صعبا علَيَّ بل مستحيلا",37,"ل",2,0],["إِنَّما يَخشى العِقابَ غَداً","مَن غَوى في شيبِهِ وَصَبا",38,"ب",2,0],["إِنَّما يهدمُ قيلُ الأَعادي","شَرَفاً لَم يُبنَ بِالمَشرَفِيِّ",39,"ي",1,0],["إنما يَقهرُ الخطوبَ حكيمٌ","ذو فؤادٍ على الخطوب جليد",40,"د",1,0],["إنما يا موت .. هل تدري متى","ترتخي فوق سرير من ملال ؟",41,"ل",1,0],["إنما يَبعَث النبيَّ إلى العالَمِ","بَيتٌ مُهَفْهفُ النورِ قاتِم",42,"م",1,0],["إنَّ ما يجتنيه من مُنكَرات العيشِ","من شَقْوةٍ البريئينَ يُجْنَى",43,"ن",2,0],["إنما يهرب الرجال من الذك","ر لما قد يثير في الأحشاء",44,"ا",2,0],["إنما يحسن المساء ويحلو","بك فاقعد أولا وهذي يميني",45,"ن",2,0],["إن مائي من بَعد بُعْدكم صا","ر أجاجاً وصار تبرى رَغَامَا",46,"م",2,0],["إِنَّمَا يُنكِرُ البَصِيرُ بِغيضَا","تِ الفُنُونِ المُفَتِّحُ الأقفَالا",47,"ل",2,0],["إنما يملك النفوس فتعصي","ناصحيها ما تشتهيه النفوس",48,"س",1,0],["إنما يصعبُ الدفينُ من الدا","ءِ وسهل ما كان غير دفين",49,"ن",1,0],["إنّما يحصرُ الإمامةَ باِثني","عشرَ الخاطئون وهو خطاءُ",50,"ا",2,0],["إنما يعلمنا الكاسانِ أنَّ","ساعة الأفراحِ دقَّتْ دقتينْ",51,"ن",1,0],["إنَّما يُبصِر الهوى صورة الوص","لِ بحيث الرقيب غير بصيرِ",52,"ر",1,0],["إنما يجدي جهاد عارم","وخصام ونضال وعناء !",53,"ا",2,0],["إنما يجدي إذا نبعثها","كهزيم الرعد تدوي في الفضاء",53,"ا",2,0],["إنما يجدي إذا ما أيقنوا","اننا كالغرب قوم أقوياء !",53,"ا",2,0],["إنّمَا يَرْقُبُ مِيقَات فَتْحٍ","هُو آتٍ في ضَمانِ النّجاح",54,"ح",1,0],["إنَّما يَحيى حَياةُ البَرايا","وَكَفاها مِن حَياً مُسْتَماح",54,"ح",1,0],["إنما يخلُد الكريم على الدهر","ويحيى يطيّب الأفعال",55,"ل",1,0],["إِنَّ ما يبصر أَو يسمع داعي الشجنِ","دَرِج الطفلُ إِليه ضاحِكاً مستبشرا",56,"ر",2,0],["إنّما يملكُ الفتى عقد قلبٍ","لِيجازى بالكسبِ والإكتسابِ",57,"ب",1,0],["إنّما يأسَفُ اللبيبُ لخطبٍ","ناله من سلوكِ غير الصوابِ",57,"ب",1,0],["أنِما يَقتلُ النيام ولا يقتلُ","يُقظانَ ذا سلاحٍ كمِيّا",58,"ي",2,0],["إنما يذكرون عمن وفيمن","مبهمات أحكامها منقوله",59,"ل",2,0],["إنما يطلب الأنام مراماً","سوف يبقى عن الأنام مصانا",60,"ن",2,0],["اِنَّما يُنكَرُ مِنهُ","من جُنونٍ فيهِ ثقلُه",61,"ل",2,0],["إنَّما يردعها عن ظلمه","وتماديها الرِّجالُ الصابرون",62,"ن",1,0],["إنما يعرف ذا الفضل هم","أهله في علمه والعمل",63,"ل",1,0],["إنما يخشاهم من حبه","منه ناء ويرى مقتربا",64,"ب",2,0],["إنما يرتادُ أرضَ ال","مَحْلِ مغرورٌ جَهولُ",65,"ل",1,0],["إنَّما يَرحمنا الله بهمْ","رَحمةً تَدفَعُ عنَّا النقما",66,"م",2,0],["إنما يستطرِفُ الرَّوعةَ مَن","نفَّرَتْ منه بقلبٍ مطمئنِّ",67,"ن",1,0],["إنما يرحم المحبَّ المجون","ويجنو على المشوقِ المشوق",68,"ق",1,0],["إِنَّما يَمدَحُ القَليلَ اِتِّفاقا","فَإِذا ما الكَثيرُ وافاهُ ذَمّا",69,"م",2,0],["إنما يجمع ما يجمعه","راغم الأنف لبعلِ امرأته",70,"ت",2,0],["إنَّمَا يَطلُبُ المَتَاعَ مِنَ النَّا","سِ سَفِيهٌ في رَأيهِ مَفتُونُ",71,"ن",1,0],["إنما يمتاز عن أشباهه","سيد يمدح وسط المشهد",72,"د",1,0],["إنّما يَحْكيكَ بَوَّانٌ أَوِ الصُّ","غَدُ أَوْ غُوطَةُ بَيْن الوادِيَيْنِ",73,"ن",1,0],["إِنَّما يَشْتَكي مِنَ الْبَيْنِ قَلْبٌ","قَدْ بُلي قَبْلَ بَيْنِهِ بالوِدادِ",74,"د",1,0],["إنّما يَفْرَحُ النَّجِيبُ إذا ما","شاهَدَ الإبْنَ في عدادِ النّجابِ",75,"ب",1,0],["إنَّ ما يبغِيه قَسرا","دونَهُ خَرطُ القَتَاد",76,"د",1,0],["إِنَّما يُعذَرُ الوَليدُ وَلا يع","ذَرُ مَن عاشَ في الزَمان عِتِيّا",77,"ي",2,0],["إِنَّما يَبكي الأُلى كانوا بِها","فَاِنتَأَوهُ بَعدَ ما شَطَّ المَزارُ",78,"ر",1,0],["إنّما يخشى الّذي يع","جل عن طيشِ السِّهامِ",79,"م",1,0],["إنّما يُعذِرُ في التّق","بيحِ من كان قبيحا",80,"ح",2,0],["إنما يطعمني الله كما","هو يسقيني ومنه المدد",81,"د",1,0],["إنما يشمل الحبور فؤادي","عندما يشمل الحبور ابن عمي",82,"م",2,0],["إِنما يَفخر الأَريب بدين","مَعَ برٍّ وعفة وَذمام",83,"م",1,0],["إنما يؤثر اليراع قديراً","شهد الحرب وابتلى الأبطالا",84,"ل",2,0],["إن ما يستحق قدرك عندي","من فروض الأعزة الكابرينا",85,"ن",2,0],["إنما يملك المحبة من يم","لك هذا الخلق العظيم المتينا",85,"ن",2,0],["إنما يعرف الجميل ذووه","ويجل البيان أهل البيان",86,"ن",1,0],["انما يمرح بي في","حلبة العشق لعوب",87,"ب",1,0],["إِنّما يَحسُنُ المَديحُ بِنَظمٍ","لو بَدا النظمُ في مديحِ حميدي",88,"د",2,0],["إنما يثمر عن فيض المزاج","أيها الساقي فبادر بالعلاج",89,"ج",1,0],["إنَّمَا يُسْعِرْهَا جُهَّالُهَا","حَطَبُ النَّارِ فَدَعْهَا تَشْتَعِلْ",90,"ل",1,0],["إنما يستضيء أهل التلقي","والترقي من ضوء تلك الذباله",91,"ل",2,0],["انما يؤتاه من","قد شاءه عز وجلا",92,"ل",2,0],["إِنَّما يُكرَمُ مَن كانَ مِنّا","لسِنانِ الحَقوِ مِنها قِرابا",93,"ب",2,0],["إِنَّما يَكفيكَ أَن يَأ","تيكَ في السرِّ رَسولُ",94,"ل",1,0],["إنّما ينفعنا صوبُ المطرْ","في ذرَى السيّد ذُهل بن عُمَرْ",95,"ر",1,1],["إنما يقظةُ الغرامِ غشته","فرمت قلبَه صريعاً غراما",96,"م",2,0],["إنما يفلح من يحفظه","بعد فهم وتوق من غلط",97,"ط",1,0],["إنما يحمد المخيلة يومٌ","أشرف الموت فوقه أو أطلا",98,"ل",2,0],["انما يشقى ببيّن","منك من بعدك يبقى",99,"ق",2,0],["إنمَا يَبنِي كَذا مَنْ خُلِقَتْ","نَفسُهُ سَالِمَةً مِنْ دَغَلِ",100,"ل",1,0],["إِنَّما يَفرَحُ الزَمانُ بِأَن يَف","رَحَ فيهِ وَغَمُّهُ بِاغتِمامِه",101,"م",2,0],["إنما ينكر الحقيقة غِرٌّ","أو لئيم أو حاسد مستاء",102,"ا",1,0],["إنما يَربحُ مَنْ إسنادُهُ","سِمةُ العجز ويبغي التَّعَبا",103,"ب",2,0],["انما يحفظ الاصيل اليد البي","ضاء لا يحفظ الهجين الفعالا",104,"ل",2,0],["إنَّما يُنجِدُ الفؤادَ على الشَّوْ","قِ فؤادٌ خالٍ من الإشتياقِ",105,"ق",1,0],["إِنَّما يَزهَدنَ فيهِ","حينَ يَعرِفنَ اِنكِسارَه",106,"ر",2,0],["إِنَّما يَكفيكَ مِنهُم","غَمزُ عَينٍ أَو إِشارَه",106,"ر",2,0],["إنما يزداد معرفة","بودادي حين يفقدني",107,"ن",2,0],["إنما يبصره في ملكه","مثله يمشي على سيرته",108,"ت",2,0],["إنما يدري بصحة ذا","من له في العلم مقدار",109,"ر",1,0],["إنما يبعث البلاغة أرسا","لاً إذا كانت الصحائف 