{"poems":[[75,"ما للمدام تديرها عيناك","https://www.aldiwan.net/poem11913.html","الكامل"],[95,"ماذا يريد من الحقيقة مسقط","https://www.aldiwan.net/poem11319.html","الكامل"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[74,"ما ضر من لم يجد في الحب تعذيبي","https://www.aldiwan.net/poem18226.html","البسيط"],[74,"نجم تولد بين الشمس والأسد","https://www.aldiwan.net/poem18547.html","البسيط"],[74,"حيتك غادية الحيا يا دار من","https://www.aldiwan.net/poem19983.html","الكامل"],[74,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[91,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[64,"للجسم إن داخلته روحه فرع","https://www.aldiwan.net/poem52158.html","البسيط"],[46,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[46,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[46,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[42,"يا ويح هذا الطرف ما غمضا","https://www.aldiwan.net/poem42315.html","الطويل"],[50,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[90,"الدهرُ بيَّن في كتابِ شهادة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19562&r=&rc=65",""],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[358,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[412,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[438,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[454,"ماذا يطوقه ؟","https://www.aldiwan.net/poem1011.html",""],[484,"مشاعر الحب نبض في مجاريها","https://www.aldiwan.net/poem37173.html","البسيط"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[563,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[580,"قد عجز المملوك عن خدمة","https://www.aldiwan.net/poem3055.html","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78152","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122081","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79984","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111125","الكامل"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104121","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202162","البسيط"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96035","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94293","الرمل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146320","المنسرح"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127384","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201362","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61271","الرجز"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34571","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95345","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111456","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77081","السريع"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44890","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107483","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101360","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36408","الدوبيت"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73226","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139117","السريع"],[4767,"جِنان الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=213975",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4875,"مشروبك الغازي","https://www.poetsgate.com/ViewPoem.aspx?id=133200",""],[4927,"عدوية","https://www.poetsgate.com/ViewPoem.aspx?id=80805",""],[5216,"ابني إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=187638",""],[5274,"أشواق دمشقية","https://www.poetsgate.com/ViewPoem.aspx?id=203450",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5317,"قالب عسل","https://www.poetsgate.com/ViewPoem.aspx?id=177085",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5376,"اِسجدْ إليهم واقْتربْ","https://www.poetsgate.com/ViewPoem.aspx?id=197472",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5464,"حكاية في ليل بهيّ","https://www.poetsgate.com/ViewPoem.aspx?id=27916",""],[5566,"المجد والعشاق","https://www.poetsgate.com/ViewPoem.aspx?id=192928",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5781,"خُدوشٌ على مَلْمَسِ الياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=202832",""],[6019,"طيفاً أُعانقُ في محرابَكَ الأجلا","https://www.poetsgate.com/ViewPoem.aspx?id=143419",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["لِلجَهورِيِّ أَبي الوَليدِ خَلائِقٌ","كَالرَوضِ أَضحَكَهُ الغَمامُ الباكي",0,"ك",2,0],["لِلْجَاهِلِيِّ لِسَانُهُ وَمَنِ الَّذِي","يَنْفِي مِنَ الفُصْحَى لِسانَ مُخَضْرَمِ",1,"م",1,0],["لِلجِنِّ بِاللَيلِ في حافاتِها زَجَلٌ","كَما تَجاوَبَ يَومَ الريحِ عَيشومُ",2,"م",1,0],["للجعفرين شهادة الأبرار","للعسكريّ وجعفر الطّيار",3,"ر",1,1],["للجودِ والعلمِ أقلامٌ براحتهِ","تجري المقاصدُ منها تحتَ مكتوب",4,"ب",1,0],["للجد والأب والابن امتدحت فيا","فوزي بها كلها أبهى من الشهد",5,"د",1,0],["للجامع المعمور خمسة أشهر","ما لي وصول في الجرائد يخزم",6,"م",1,0],["للجود في أموالها مثلما","في قصتيْ عبس وذُبيان",7,"ن",1,0],["للجَمالِ الَّذي يفيضُ على الدُّ","نيا لأشواقِ قلبيَ المشجونِ",8,"ن",1,0],["للجرح فوق القلب منه فتحة","تحكي فماً في صدره يتكلم",9,"م",1,0],["للجسم إن داخلته روحه فرع","والروح بالجسم عند البعث يمتسكُ",10,"ك",1,1],["لِلجودِ سَهمٌ في المَكارِمِ وَالتُقى","ما رَبُّهُ المُكدي وَلا المَسهومُ",11,"م",1,0],["لِلجَدبِ في أَموالِهِ مَرتَعٌ","وَمَقنَعٌ في الخِصبِ لِلقانِعِ",12,"ع",1,0],["لِلجودِ بابٌ في الأَنامِ وَلَم تَزَل","يُمناكَ مِفتاحاً لِذاكَ البابِ",13,"ب",1,0],["للجنِّ أو للعلمِ منذ تكدَّسَتْ","رَصَدٌ عليها قائمٌ وخفيرُ",14,"ر",1,0],["للجاهِلِيَّةِ رَسمٌ كان يُعجبها","في دهرِها فَعَفَتْ أيامُها وَعَفَا",15,"ف",2,0],["لِلجِزعِ ذي القَصرَينِ أَو فَوقَهُ","سَقياً لِذاكَ الجِزعِ مَستَعرِضا",16,"ض",2,0],["لِلجودِ مِن كِلتا يَدَيهِ مُحَرِّكٌ","لا يَستَطيعُ بُلوغَهُ الإِسكانُ",17,"ن",1,0],["للجهل حقٌّ رعاة الجهل تضمنه","له وَللعلم حق غير مضمون",18,"ن",1,0],["لِلْجَهْلِ فِيهِمْ سُلْطَةٌ أَمَّارَةٌ","بِالسُّوءِ غَيْرُ بَصِيرَةٍ بَعَوَاقِبِ",19,"ب",1,0],["للجود في أمواله احتكَام","لايلتقي راجيه والإعدامُ",20,"م",1,0],["للجود مغلوباً تراه ولم يكن","للجيش في الغزوات بالمغلوب",21,"ب",1,0],["للجوع كالجوعان أو إلى الظما","أو انتمى لضدّ كل منهما",22,"م",2,0],["لِلجودِ مِنهُ راحَةٌ شَلّا وَمُق","لَةُ ناظِرٍ أَعمى وَأَنفٌ أَجدَعُ",23,"ع",1,0],["لِلجونِ فيها عِيالٌ في أَفاحِصِها","بِجَوفَةٍ ما بِها أَثلٌ وَلا نَضَفُ",24,"ف",1,0],["لِلجَدّ صورة هَزلٍ حليها الأَدَبُ","فَلَيسَ يُنكر فيها اللهو وَاللَعبُ",25,"ب",1,1],["لِلجودِ ما تَحوي يَداهُ وَما حَوى","وَالمَجدُ ما يُخفي الحَياء وَيُظهِرُ",26,"ر",1,0],["لِلْجُودِ والبَأْسِ أَحزابٌ بِرَاحَتِهِ","ساقَتْ إِليه جيوشُ الشُّكْرِ أَحْزَابا",27,"ب",2,0],["للجفن من حب ليلى ما يؤرقه","وجدا وللقلب منها ما يمزقه",28,"ق",2,1],["للجاذبية مجذوبية لزمت","ومنهما ارتبط العالي بدانيها",29,"ي",3,0],["لِلجَمع فَلّوا وَما فَلّت عَزائمهم","وَهيَ المَواضي عَلى استئصالِ كُلّ عَمِ",30,"م",1,0],["للجسم ركوع يركعه","للقلب سجود يسجده",31,"د",2,0],["للجيش ديوانٌ ومالي به","أُنسٌ ولا عندي له عيشُ",32,"ش",1,0],["للجرّ عشرون الفرادى كل وتب","ومن وعن وفي وكي ومذ ورب",33,"ب",1,0],["لِلجيد حَلَت وَحَلَت عقدها وَلَكُم","حلت بِقَلبي وَحَلَت ريقَها الحالي",34,"ل",2,0],["للجود والنعمى تَدَانٍ إِنْ دَنَا","إِيهٍ وَلِلْبُخْلِ المُلِيمِ تَقَاصِ",35,"ص",1,0],["للجودِ فيه جعفرٌ","كرماً يعدُ البحرَ حسوه",36,"و",2,0],["للجعفريَّين ابتنَت دارها","بيض المساعي فوقَ خضراها",37,"ا",3,0],["للجود ذاماء براحته","وبكل راجية له نهر",38,"ر",1,0],["للجارِ والضَيفِ وباغي النَدى","حينَ يُباري خُلُقي أَخيلي",39,"ل",2,0],["للجد ما خلق الإنسان فالتمسن","بالجد حظك لا باللهو واللعب",40,"ب",1,0],["لِلْجود في ماله يومَ النَّوالِ خُطاً","تُفْنيه عَمْداً إِذا جاد أمْرُؤٌ خَطَأ",41,"ا",1,0],["للجهات الست كفاه ولي","لم يزل يهطل من غير رعود",42,"د",1,0],["للجود حين كبا غد يأت","الندى واري الزناد",43,"د",1,0],["للجزء تغيير عليه يدخل","منه زحافات ومنه علل",44,"ل",1,0],["للجفون الماء والقلب اللظى","ويحه ما هكذا التقسيم",45,"م",1,0],["للجمع والمنع قائمٌ أبداً","كالفيل لا تَنْثَني له رُكَب",46,"ب",1,0],["للجهل أفضل من علم نتائجه","سفك الدماء وظلم الجار للجار",47,"ر",1,0],["للجرح ما في الطب من بلسم","فبلسم الجرح دمُ الجارح",48,"ح",1,0],["للجُودِ تمنحُهُ للدّينِ تمنَعُهُ","للسّيْفِ تسْرِعُهُ للرُمْحِ تشْرعُهُ",49,"ع",2,0],["للجودِ في يمينه حوضٌ بَثَق","يؤمُّهُ العافون مِن كُلِّ أُفُق",50,"ق",1,0],["للجاشرية فضلها فتعجلا","إن كنتما تريان ذاك صلاحا",51,"ح",2,0],["للجنس والواحدة السُّماناه","وقد دمى لثته فأدماه",52,"ه",1,0],["لِلجِبالِ الشُمِّ بي كالطَّيرِ طار","أورَمى بي فَوقَ أَمواجِ البِحار",53,"ر",1,0],["لِلجَبانِ المَهزُومِ مضوتٌ وَعارٌ","والهُمَامِ العَزُومش رَفعُ الجبين",54,"ن",1,0],["لِلجودِ وَالنَجدَةِ أَخلاقَهُ","وَالعَدلُ وَالرِفقُ وَخَيرُ السَير",55,"ر",1,0],["لِلجَمالِ الغَضِّ دَولاتٌ تَدولُ","ثُم تَبدو دوَلُ الحُسنِ الكَبيرِ",56,"ر",1,0],["للجنِّ في غيطانها","ما لذَّ من أَلحانها",57,"ه",2,0],["للجود قد فتحت أبوابه كرماً","ورب باب فتى باللؤم أغلقه",58,"ق",2,0],["لِلجَنَّةِ لا النارِ أَراه أَهلاً","مَع رائِحَة الخُلدِ وَوجهِ الحورِ",59,"ر",1,0],["للَجفنِ منهُنَّ سِحرُ الغانياتِ وللسُّ","كرِ الثُّغورُ وَكُلٌّ بابِليَاتُ",60,"ت",1,0],["للجار حق فاعتمد بره","واحمل أذاه مغضياً ساترا",61,"ر",2,1],["للجسم قد يبدو الونَى متعباً","لكنه للروح ما أتعبا",62,"ب",2,0],["للجابريّة قد شحذت الضامي","سيف ٍ سليطن ساطين سطّامي",63,"م",2,1],["للجمر واللولو .. وجو الهوى جو","لمياء طارق مثلها مثل يلدا",64,"د",2,0],["لِلْجَمَاْلِ الأَصِيْلِº فِيْهَاْ أُصُوْلٌ","جَسَّدَتْهَا الْمَحَاْسِنُ الْعَرَبِيَّةْ",65,"ي",2,0],["للجدِّ البدري مُنْتَسِبٌ","وسَمِيٌ حلوٌ مَعناهُ",66,"ا",2,0],["للجهلِ في وطنِ الإيمانِ الويةٌ","وللحماقاتِ أحزابٌ وطغيان ُ",67,"ن",1,0],["للجود رب وللإنعام محمدة","تزيده والورى في الخير ما شكروا",68,"ر",3,0],["للجمال احدود وحدودك جمال","مثل بدرٍ منتصف شهره اكتمل",69,"ل",1,1],["للجمال احدود.. واحدودك جمال","وفي مسلسل حبنا.. كنت البطل",69,"ل",1,0],["للجد تحنانٌ على ولدٍ","مذ كان يرعى الإبل في النقب",70,"ب",1,0],["للجزية ادْفعْ مالكم","وارجُ الخلاصَ وارْتقبْ",71,"ب",1,0],["للجهل للموروث من","جيناتنا ثأرا يُذاع !!",72,"ع",1,0],["للجار ِ حق ٌّ لو عَلِمْت ِ ومثلُه ُ","حقُّ القرابة ِ فلتصوني المنهجا",73,"ج",2,0],["للجرح في لغة الفراق مدارك","والصدر ميدان دهته معارك",74,"ك",1,1],["للجود ف