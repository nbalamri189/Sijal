{"poems":[[73,"ما للمدام تديرها عيناك","https://www.aldiwan.net/poem11913.html","الكامل"],[93,"ماذا يريد من الحقيقة مسقط","https://www.aldiwan.net/poem11319.html","الكامل"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[88,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[72,"ما ضر من لم يجد في الحب تعذيبي","https://www.aldiwan.net/poem18226.html","البسيط"],[72,"نجم تولد بين الشمس والأسد","https://www.aldiwan.net/poem18547.html","البسيط"],[72,"حيتك غادية الحيا يا دار من","https://www.aldiwan.net/poem19983.html","الكامل"],[72,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[62,"للجسم إن داخلته روحه فرع","https://www.aldiwan.net/poem52158.html","البسيط"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[44,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[105,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[40,"يا ويح هذا الطرف ما غمضا","https://www.aldiwan.net/poem42315.html","الطويل"],[48,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[88,"الدهرُ بيَّن في كتابِ شهادة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19562&r=&rc=65",""],[220,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[233,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[320,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[351,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[403,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[429,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[447,"ماذا يطوقه ؟","https://www.aldiwan.net/poem1011.html",""],[477,"مشاعر الحب نبض في مجاريها","https://www.aldiwan.net/poem37173.html","البسيط"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[556,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[573,"قد عجز المملوك عن خدمة","https://www.aldiwan.net/poem3055.html","السريع"]],"verses":[["لِلجَهورِيِّ أَبي الوَليدِ خَلائِقٌ","كَالرَوضِ أَضحَكَهُ الغَمامُ الباكي",0,"ك",2,0],["لِلْجَاهِلِيِّ لِسَانُهُ وَمَنِ الَّذِي","يَنْفِي مِنَ الفُصْحَى لِسانَ مُخَضْرَمِ",1,"م",1,0],["لِلجِنِّ بِاللَيلِ في حافاتِها زَجَلٌ","كَما تَجاوَبَ يَومَ الريحِ عَيشومُ",2,"م",1,0],["للجعفرين شهادة الأبرار","للعسكريّ وجعفر الطّيار",3,"ر",1,1],["للجودِ والعلمِ أقلامٌ براحتهِ","تجري المقاصدُ منها تحتَ مكتوب",4,"ب",1,0],["للجد والأب والابن امتدحت فيا","فوزي بها كلها أبهى من الشهد",5,"د",1,0],["للجامع المعمور خمسة أشهر","ما لي وصول في الجرائد يخزم",6,"م",1,0],["للجود في أموالها مثلما","في قصتيْ عبس وذُبيان",7,"ن",1,0],["للجَمالِ الَّذي يفيضُ على الدُّ","نيا لأشواقِ قلبيَ المشجونِ",8,"ن",1,0],["للجرح فوق القلب منه فتحة","تحكي فماً في صدره يتكلم",9,"م",1,0],["للجسم إن داخلته روحه فرع","والروح بالجسم عند البعث يمتسكُ",10,"ك",1,1],["لِلجودِ سَهمٌ في المَكارِمِ وَالتُقى","ما رَبُّهُ المُكدي وَلا المَسهومُ",11,"م",1,0],["لِلجَدبِ في أَموالِهِ مَرتَعٌ","وَمَقنَعٌ في الخِصبِ لِلقانِعِ",12,"ع",1,0],["لِلجودِ بابٌ في الأَنامِ وَلَم تَزَل","يُمناكَ مِفتاحاً لِذاكَ البابِ",13,"ب",1,0],["للجنِّ أو للعلمِ منذ تكدَّسَتْ","رَصَدٌ عليها قائمٌ وخفيرُ",14,"ر",1,0],["للجاهِلِيَّةِ رَسمٌ كان يُعجبها","في دهرِها فَعَفَتْ أيامُها وَعَفَا",15,"ف",2,0],["لِلجِزعِ ذي القَصرَينِ أَو فَوقَهُ","سَقياً لِذاكَ الجِزعِ مَستَعرِضا",16,"ض",2,0],["لِلجودِ مِن كِلتا يَدَيهِ مُحَرِّكٌ","لا يَستَطيعُ بُلوغَهُ الإِسكانُ",17,"ن",1,0],["للجهل حقٌّ رعاة الجهل تضمنه","له وَللعلم حق غير مضمون",18,"ن",1,0],["لِلْجَهْلِ فِيهِمْ سُلْطَةٌ أَمَّارَةٌ","بِالسُّوءِ غَيْرُ بَصِيرَةٍ بَعَوَاقِبِ",19,"ب",1,0],["للجود في أمواله احتكَام","لايلتقي راجيه والإعدامُ",20,"م",1,0],["للجود مغلوباً تراه ولم يكن","للجيش في الغزوات بالمغلوب",21,"ب",1,0],["للجوع كالجوعان أو إلى الظما","أو انتمى لضدّ كل منهما",22,"م",2,0],["لِلجودِ مِنهُ راحَةٌ شَلّا وَمُق","لَةُ ناظِرٍ أَعمى وَأَنفٌ أَجدَعُ",23,"ع",1,0],["لِلجونِ فيها عِيالٌ في أَفاحِصِها","بِجَوفَةٍ ما بِها أَثلٌ وَلا نَضَفُ",24,"ف",1,0],["لِلجَدّ صورة هَزلٍ حليها الأَدَبُ","فَلَيسَ يُنكر فيها اللهو وَاللَعبُ",25,"ب",1,1],["لِلجودِ ما تَحوي يَداهُ وَما حَوى","وَالمَجدُ ما يُخفي الحَياء وَيُظهِرُ",26,"ر",1,0],["لِلْجُودِ والبَأْسِ أَحزابٌ بِرَاحَتِهِ","ساقَتْ إِليه جيوشُ الشُّكْرِ أَحْزَابا",27,"ب",2,0],["للجفن من حب ليلى ما يؤرقه","وجدا وللقلب منها ما يمزقه",28,"ق",2,1],["للجاذبية مجذوبية لزمت","ومنهما ارتبط العالي بدانيها",29,"ي",3,0],["لِلجَمع فَلّوا وَما فَلّت عَزائمهم","وَهيَ المَواضي عَلى استئصالِ كُلّ عَمِ",30,"م",1,0],["للجسم ركوع يركعه","للقلب سجود يسجده",31,"د",2,0],["للجيش ديوانٌ ومالي به","أُنسٌ ولا عندي له عيشُ",32,"ش",1,0]]}