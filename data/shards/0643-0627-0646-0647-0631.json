{"poems":[[44,"وساجع في فروع الأيك هيجني","https://www.aldiwan.net/poem50282.html","البسيط"],[39,"كأن هرير الغلي في جنباتها","https://www.aldiwan.net/poem7000.html","الطويل"],[89,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[54,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[54,"إذهب إلى بيت عذره","https://www.aldiwan.net/poem26979.html","المجتث"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[113,"وشادن تدار من","https://www.aldiwan.net/poem16584.html","مجزوء الرجز"],[185,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[415,"أو ما ترى التين في الغصون بدا","https://www.aldiwan.net/poem31673.html","عموديه"],[563,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143273","المنسرح"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132450","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61182","البسيط"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122870","المنسرح"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198657","المجتث"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102284","السريع"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105852","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65488","البسيط"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123842","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131035",""]],"verses":[["كَأَنَّهُ راهِبٌ في رأَسِ صَومَعَةٍ","يَتلو الزَبورَ وَنَجمُ الصُبحِ قَد طَلَعا",0,"ع",2,0],["كأن هرير الغلي في جنباتها","تغيظ غيرى عند بعض الضرائرِ",1,"ر",1,1],["كَأَنَّهُ رَابِضٌ لِلْوَثْبِ مُنْتَظِرٌ","فَرِيسَةً فَهْوَ يَرْعَاهَا وَلَمْ يَنَمِ",2,"م",1,0],["كَأَنَّهُ رَقٌّ خَفِيُّ الأَسطُرِ","وَذَنَبٌ كَالمُنصُلِ المُذَكَّرِ",3,"ر",1,0],["كَأَنَّهُ رَقمُ وَشيٍ","بِصُفرَةٍ وَبِحُمرَه",4,"ر",2,0],["كَأَنَّ هِرّاً جَنيباً تَحتَ غُرضَتِها","وَاِصطَكَّ ديكٌ بِرِجلَيها وَخِنزيرُ",5,"ر",1,0],["كَأَنَّهُ رَيحانة","تَشمها أَرواحَنا",6,"ن",2,0],["كأَنَّ هَرِيرَ حَملَتِنا عَلَيهِم","هَرِيرُ النّارِ أَشعَلَت العَرِينَا",7,"ن",2,0],["كَأَنَّهُ رتشيلد في عزِّه","كَأَنَّهُ روكفلر الموسرُ",8,"ر",1,0],["كأنّه رامٍ إلى غايةٍ","تَناوَلَ السّهْمَ بيُمْناه",9,"ا",2,0],["كأنه رب نعمة سلبت","أصبح بعد الجديد في خلق",10,"ق",1,0],["كأنه روض حق","بالحق قد طاب غرسه",11,"س",2,0],["كأنه رامَ في سَفاهتِهِ","عضَّ شَبا أذْنه بمِشْفِرِهِ",12,"ه",1,0],["كأنَّه راهبٌ في المسح ملتحفٌ","شدَّ المجدّ له وسطاً بزنّار",13,"ر",1,0],["كَأَنَّهُ رَمد مِما يَغمضها","لَكن أَدمعه تشفي مِن الرمَد",14,"د",1,0],["كأنه رسم منزل خلق","تعرفه العين ثم تنكره",15,"ه",1,0],["كأنّه روض ورد","جنّانه حبشيُّ",16,"ي",1,0],["كأنه روض سقاه الندى","ريا فأضحى بيته مزهرا",17,"ر",2,0],["كأنَّهُ رائِدٌ أو طالِعٌ نُجُداً","أو قائِدٌ وصُنُوف النَورِ أجنادُ",18,"د",1,0],["كأنّه روضةٌ غنّاءُ قد جمعت","من كلّ نوع من الأزهار أفنانا",19,"ن",2,0],["كأنه رب جيش قد طلعت له","ففرّ عنك بروح منه مغتنما",20,"م",2,0],["كأنه رب بستان عمارته","عليه لكن سواه يجتني الثمرا",21,"ر",2,0]]}