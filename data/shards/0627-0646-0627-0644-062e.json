ate.com/ViewPoem.aspx?id=159615",""],[5703,"لن أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=215194",""],[5781,"وخزةٌ في قلبٍ مكشوفٍ للوجع","https://www.poetsgate.com/ViewPoem.aspx?id=185317",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5842,"استغفرُ الله / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=135811",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5956,"ديمقراطية أمريكا وحلفائها","https://www.poetsgate.com/ViewPoem.aspx?id=192213",""],[5956,"شاعر يدافع عن صديقه","https://www.poetsgate.com/ViewPoem.aspx?id=192463",""],[5970,"بين الحياة وبين الموت ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=130605",""],[6093,"إلا الخروج","https://www.poetsgate.com/ViewPoem.aspx?id=191466",""],[199,"إنَّ الخليطَ أجدوا البينَ فانقذفوا","https://www.poetsgate.com/ViewPoem.aspx?id=22425",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6146,"حَدَتْ حُداةُ بني يحيى بن عثمانا","https://www.poetsgate.com/ViewPoem.aspx?id=122039",""],[5190,"الحق يسطع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85053&r=&rc=128",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""]],"verses":[["إِنَّ الخَلِيّ غَداةَ الجِزعِ عيدَ بِهِ","إِلى ضَميرِ مُعَنّى اللُبِ مَفتونِ",0,"ن",1,0],["إِنَّ الخِلافَةَ مُذ نَهَضتَ بِعِبئِها","هَدَأَ الضَميرُ بِها وَنامَ النُوَّمُ",1,"م",1,0],["إِنَّ الخُطوبَ الطارِقاتِ فَجَعنَنا","بِحِمى الأَبِيِّ وَجُنَّةِ المُستَلئِمِ",2,"م",1,0],["إِنَّ الخَفيفَ الحاذَينِ جَدَّلَهُ","مُعَيَّرٌ بِالقُعودِ وَالرَتَعَه",3,"ع",2,0],["إِنَّ الخَلائِفَ وَالأُلى فَخَروا","بِهِمُ عَلَينا قَبلُ أَو بَعدُ",4,"د",1,0],["إِنَّ الخِلافَةَ أَصبَحَت مَزويَّةً","عَن شَعبِها بِبَياضِها وَسَوادِها",5,"د",3,0],["إن الخلائق في الأقطارِ أجمعها","سوائمٌ أنت في التحقيق راعيها",6,"ي",3,0],["أن الخلافة أعلى الله مظهرها","أبقتْ لنا شرفاً والله يبقيها",6,"ي",3,0],["أنّ الخلافة في بنيهم أطلعت","قمراً به سعدُ الخليقةِ يكملُ",7,"ل",1,0],["أنّ الخلافة وهو شبل ليوثهم","قد حاط منها الدينَ ليث مُشبلُ",7,"ل",1,0],["إِنَّ الخَليفَةَ لِليَتامى عِصمَةٌ","وَأَبو العِيالِ يَشُفُّهُ الإِقتارُ",8,"ر",1,0],["إِنَّ الخِلافَةَ يا اِبنَ دَحمَةَ دونَها","لُجَجٌ تَضيقُ بِها الصُدورُ غِمارُ",8,"ر",1,0],["إِنَّ الخَليطَ أَجَدَّ الَبَينَ يَومَ غَدَوا","مِن دارَةِ الجَأبِ إِذ أَحداجُهُم زُمَرُ",9,"ر",1,0],["إِنَّ الخَليفَةَ قَد وارى شَمائِلَهُ","غَبراءُ مَلحودَةٌ في جولِها زَوَرُ",10,"ر",1,0],["إِنَّ الخِلافَةَ بِالَّذي أَبلَيتُمُ","فيكُم فَلَيسَ لِمَلكِها تَحويلُ",11,"ل",1,0],["إِنَّ الخِلافَةَ وَالنُبُوَّةَ وَالهُدى","رَغمٌ لِتَغلِبَ في الحَياةِ طَويلُ",11,"ل",1,0],["إن الخلافة والألآ","ف برغم ذي حسد وواغر",12,"ر",1,0],["إن الخلافة كائن أوتادُها","بعد الوليد إلى ابن أم حكيمِ",13,"م",1,1],["إِنَّ الخِيانَةَ وَالمَغالَةَ وَالخَنا","وَاللُؤمَ أَصبَحَ ثاوِياً بِالأَبطَحِ",14,"ح",1,0],["إِنَّ الخِلافَةَ مِن رَبّي حَباكَ بِها","لَم يُصفِها لَكَ إِلّا الواحِدُ الصَمَدُ",15,"د",1,0],["إِنَّ الخَليفَةَ لَم يُسَمِّكَ سَيفَها","حَتّى بَلاكَ فَكُنتَ عَينَ الصارِمِ",16,"م",1,0],["إِنَّ الخَليفَةَ قَد جَدَّت عَزيمَتُهُ","فيما يُريدُ وَما في جِدِّهِ لَعِبُ",17,"ب",1,0],["إِنَّ الخِلافَةَ لا تُلقى كَتائِبُها","كَما لَقيتَ بِعَوّادٍ وَصَنّاجِ",18,"ج",1,0],["إِنَّ الخِلافَةَ أَحمَدَت مِن أَحمَدِ","شِيَماً أَنافَ بِها عَلى الإِحمادِ",19,"د",1,0],["إِنَّ الخَليفَةَ هارونَ الَّذي وَقَفَت","في كُنهِ آلائِهِ الأَوهامُ وَالفِكَرُ",20,"ر",1,0],["إِنَّ الخُطوبَ طَوَينَني وَنَشَرنَني","عَبَثَ الوَليدِ بِجانِبِ القِرطاسِ",21,"س",1,0],["إِنَّ الخَليفَةَ لَيسَ يَرقُبُ بِالَّذي","طالَبتُ إِلّا أَن تَقولَ فَيَفعَلا",22,"ل",2,0],["إِنَّ الخِلافَةَ لَمّا اِهتَزَّ مِنبَرُها","بِجَعفَرٍ أُعطِيَت أَقصى أَمانيها",23,"ي",3,0],["إِنَّ الخَراجَ بِقِنِّسرينَ يَجمَعُهُ","تَدبيرُ يَقظانَ يَدري كَيفَ يُحيِيهِ",24,"ي",2,0],["إِنَّ الخَليطَ أَجَدَّ البَينَ فَاِنفَرَقا","وَعُلِّقَ القَلبُ مِن أَسماءَ ما عَلِقا",25,"ق",2,1],["إِنَّ الخُطوبَ غُدُوَّها وَرَواحَها","في الخَلقِ دائِبَةٍ تُجيلُ قِداحَها",26,"ح",3,1],["إِنَّ الخَلائِقَ في الدُنيا لَوِ اِجتَهَدوا","أَن يَحبِسوا عَنكَ هَذا المَوتَ ما حَبَسوا",27,"س",3,0],["إنّ الخطوبَ طَرَقْنَني في جنّة","أخْرَجْنني منها خروج المذنبِ",28,"ب",1,0],["إِنَّ الخَليفَةَ وَالخَليفَةَ قَبلَهُ","وَجَداكَ تِربَ نَصيحَةٍ وَعَزيمِ",29,"م",1,0],["إِنَّ الخِلافَةَ أَصبَحَت حُجُراتُها","ضُرِبَت عَلى ضَخمِ الهُمومِ هُمامِ",30,"م",1,0],["إِنَّ الخَليفَةَ لَمّا صالَ كُنتَ لَهُ","خَليفَةَ المَوتِ فيمَن جارَ أَو ظَلَما",31,"م",2,0],["إِنَّ الخَليفَةَ وَالأَفشينَ قَد عَلِما","مَنِ اِشتَفى لَهُما مِن بابَكٍ وَشَفى",32,"ف",2,0],["إِنَّ الخَليفَةَ حينَ يُظلِمُ حادِثٌ","عَينُ الهُدى وَلَهُ الخِلافَةُ مَحجَرُ",33,"ر",1,0],["إِنَّ الخِلافَةَ لَو جَزَتكَ بِمَوقِفٍ","جَعَلَت مِثالَكَ قِبلَةً لِلمَسجِدِ",34,"د",1,0],["إِنَّ الخَليفَةَ قَد عَزَّت بِدَولَتِهِ","دَعائِمُ الدينِ فَليَعزِز بِكَ الأَدَبُ",35,"ب",1,0],["إنَّ الخمولَ وقاني","ما كنتُ أخشى وأكرَهْ",36,"ه",1,1],["إِنَّ الخَليطَ أَجَدَّ فَاِحتَمَلا","وَأَرادَ غَيظَكِ بِالَّذي فَعَلا",37,"ل",2,1],["إِنَّ الخَبيبَ تَرَوَّحَت أَثقالُهُ","أُصُلاً فَدَمعُكَ دائِمٌ إِسبالُهُ",38,"ل",2,1],["إِنَّ الخَليطَ الَّذينَ كُنتُ بِهِم","صَبّاً دَعَوا لِلفِراقِ فَاِنطَلَقوا",39,"ق",3,1],["إِنَّ الخَليطَ مَعَ الصَباحِ تَصَدَّعوا","فَالقَلبُ مُرتَهَنٌ بِزَينَبَ موجِعُ",40,"ع",1,1],["إِنَّ الخَليطَ تَصَدَّعوا أَمسِ","وَتَصَدَّعَت لِفِراقِهِم نَفسي",41,"س",2,1],["إِنَّ الخَليطَ رائِحٌ","قَبلَ الصَباحِ يُبكِرُ",42,"ر",1,0],["إِنَّ الخَليطَ الَّذي تَهوى قَدِ اِئتَمَروا","بِالبَينِ ثُمَّ أُجِدَّ البَينُ فَاِبتَكَروا",43,"ر",3,1],["إِنَّ الخَليطَ مُوَدِّعوكَ غَدا","قَد أَجمَعوا مِن بَينِهِم أَفَدا",44,"د",2,1],["إنّ الخلافةَ حقَّها وتراثَها","لِمُدافعين عن الذّمارِ كِرامِ",45,"م",1,0],["إنّ الخلافةَ قد تَداركَ سُورَها","بأسٌ يُزيلُ شواهِقَ الأسوارِ",46,"ر",1,0],["إِنَّ الخَلائِفَ لا يُفارِقُ مُلكَهُم","لَيثٌ يَصولُ وَلا حُسامٌ يَضرِبُ",47,"ب",1,0],["إِنَّ الخَليفَةَ لَو صَكَّت عَزائِمُهُ","نَوائِبَ الدَهرِ ذي الحِدثانِ لَم تَنُبِ",48,"ب",1,0],["إِنَّ الخَليفَةَ لَيسَ يِعدُو عِلمُهُ","أَنَّ الأَميرَ حُسامُهُ المَسنونُ",49,"ن",1,0],["إِنَّ الخَليطً الَّذينَ كُنتُ بِهِم","صَبّاً لِلفِراقِ فَافتَرَقُوا",50,"ق",3,1],["إِنَّ الخَليطَ أَجَدّوا البَينَ فَاِنفَرَقوا","وَذاكَ مِنهُم عَلى ذي حاجَةٍ خُرُقُ",51,"ق",1,1],["إنّ الخبيرَ بكم أجَدَّ بخُلقكم","غيباً فجرَّدَ فيكمُ التنزيلا",52,"ل",2,0],["إِنَّ الخَليطَ أَجَدَّ البَينَ فَاِفتَرَقا","وَعُلِّقَ القَلبُ مِن أَسماءَ ما عَلَقا",53,"ق",2,0],["إِنَّ الخِلافَةَ لَم تَزَل","تَزهو وَتَفخَرُ بِالأَمينِ",54,"ن",1,1],["إِنَّ الخَليفَةَ ظِلٌّ يُستَظَلُّ بِهِ","عالٍ مَعَ الشَمسِ مَحفوفٌ بِأَطوادِ",55,"د",1,0],["إِنَّ الخَليفَةَ طَودٌ يُستَظَلُّ بِهِ","عالٍ مَعَ الشَمسِ مَحفوفٌ بِأَطوادِ",55,"د",1,0],["إِنَّ الخَليفَةَ قَد بَغى","وَإِذا أَبى شَيئاً أَبَيتُه",56,"ت",2,0],["إنَّ الخَلافَةَ لَنْ تَرْضى وَلا رَضِيَتْ","حَتّى عَقدْتَ لها في رَأسِكَ التَّاجا",57,"ج",2,0],["إن الخيال نهايةٌ في أمة","لسكونِها وبدايةُ الحركاتِ",58,"ت",1,1],["إن الخطوب نزلن بي","فتركنني عظما وَجلدا",59,"د",2,0],["إنِ الخصمُ لم يذعن الى ما تقيمه","من القسط كانَ السيف أَصدق برهان",60,"ن",1,0],["إن الخِلاف الَّذي جَد","د بيننا لا يسوى",61,"و",2,0],["إن الخلاف الَّذي طالَت مسافته","بين الطوائف بعد الموت ينحسم",62,"م",1,0],["إنَّ الخليعَ ورَهْطَهُ في عامِرٍ","كالقَلْبِ أُلبسَ جؤجؤاً وحزيما",63,"م",2,0],["إِنَّ الْخُطُوبَ الَّتِي ذَلَّلْتَ جَانِبَها","بِحُسْنِ رَأَيِكَ لَمْ تُقدَرْ لِمَقْدُورِ",64,"ر",1,0],["إنّ الخَيَالَ مِنَ الحَسْنَاءِ قَدْ طَرَقَا","فَبِتُّ مُرْتَفقاً مِنْ حُبِّها أَرِقا",65,"ق",2,1],["إن الخلافة كلما ذكر اسمها","شخصتْ إليك حواضرٌ، وبواد",66,"د",1,0],["إنّ الخلود وما تروي مزاعمهم","عن السعادة في الأخرى نقيضان",67,"ن",1,0],["إن الخليفة ليس بعدو علمه","أن الأمير حسامه المسنون",68,"ن",1,0],["إنَّ الخَلِيطَ الَّذِينَ كُنْتُ بِهِمْ","صَبَّاً دَعَوْا لِلْفِرَاقِ فکنْطَلَقُوا",69,"ق",3,1],["إنَّ الخَلِيطَ مَعَ الصَّباحِ تَصَدَّعُوا","فَکلقَلْبُ مُرْتَهَنٌ بِزَيْنَبَ مُوجَعُ",70,"ع",1,1],["إنّ الخلافةَ لا تشكو بمعضلةٍ","والحافظُ ال