ست كخوط البانة المياس","https://www.aldiwan.net/poem32736.html","الكامل"],[303,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[303,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[318,"يا من نعد به المجاز حقيقة","https://www.aldiwan.net/poem61807.html","الكامل"],[320,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[324,"حي المنابر بالسلام","https://www.aldiwan.net/poem44246.html","مجزوء الكامل"],[362,"هو الغرام أقام الحي أم ظعنوا","https://www.aldiwan.net/poem60629.html","البسيط"],[362,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[362,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[374,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[374,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[400,"ما ضاع ما ضاع ما أهداه لومه","https://www.aldiwan.net/poem33418.html","البسيط"],[407,"لله درك يا عقيلة جعفر","https://www.aldiwan.net/poem67512.html","الكامل"],[413,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[413,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[451,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[466,"إن الخضيب لفي بلاء مطبق","https://www.aldiwan.net/poem59853.html","الكامل"],[466,"إن الخضيب أقل ما يبلى به","https://www.aldiwan.net/poem59855.html","الكامل"],[481,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[498,"محاضر القوم لا تترك بها الأدبا","https://www.aldiwan.net/poem38080.html","البسيط"],[513,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[513,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[527,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[556,"إن الخريف هو الربيع الثاني","https://www.aldiwan.net/poem33745.html","الكامل"],[565,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[574,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"]],"verses":[["إِنَّ الخَلِيّ غَداةَ الجِزعِ عيدَ بِهِ","إِلى ضَميرِ مُعَنّى اللُبِ مَفتونِ",0,"ن",1,0],["إِنَّ الخِلافَةَ مُذ نَهَضتَ بِعِبئِها","هَدَأَ الضَميرُ بِها وَنامَ النُوَّمُ",1,"م",1,0],["إِنَّ الخُطوبَ الطارِقاتِ فَجَعنَنا","بِحِمى الأَبِيِّ وَجُنَّةِ المُستَلئِمِ",2,"م",1,0],["إِنَّ الخَفيفَ الحاذَينِ جَدَّلَهُ","مُعَيَّرٌ بِالقُعودِ وَالرَتَعَه",3,"ع",2,0],["إِنَّ الخَلائِفَ وَالأُلى فَخَروا","بِهِمُ عَلَينا قَبلُ أَو بَعدُ",4,"د",1,0],["إِنَّ الخِلافَةَ أَصبَحَت مَزويَّةً","عَن شَعبِها بِبَياضِها وَسَوادِها",5,"د",3,0],["إن الخلائق في الأقطارِ أجمعها","سوائمٌ أنت في التحقيق راعيها",6,"ي",3,0],["أن الخلافة أعلى الله مظهرها","أبقتْ لنا شرفاً والله يبقيها",6,"ي",3,0],["أنّ الخلافة في بنيهم أطلعت","قمراً به سعدُ الخليقةِ يكملُ",7,"ل",1,0],["أنّ الخلافة وهو شبل ليوثهم","قد حاط منها الدينَ ليث مُشبلُ",7,"ل",1,0],["إِنَّ الخَليفَةَ لِليَتامى عِصمَةٌ","وَأَبو العِيالِ يَشُفُّهُ الإِقتارُ",8,"ر",1,0],["إِنَّ الخِلافَةَ يا اِبنَ دَحمَةَ دونَها","لُجَجٌ تَضيقُ بِها الصُدورُ غِمارُ",8,"ر",1,0],["إِنَّ الخَليطَ أَجَدَّ الَبَينَ يَومَ غَدَوا","مِن دارَةِ الجَأبِ إِذ أَحداجُهُم زُمَرُ",9,"ر",1,0],["إِنَّ الخَليفَةَ قَد وارى شَمائِلَهُ","غَبراءُ مَلحودَةٌ في جولِها زَوَرُ",10,"ر",1,0],["إِنَّ الخِلافَةَ بِالَّذي أَبلَيتُمُ","فيكُم فَلَيسَ لِمَلكِها تَحويلُ",11,"ل",1,0],["إِنَّ الخِلافَةَ وَالنُبُوَّةَ وَالهُدى","رَغمٌ لِتَغلِبَ في الحَياةِ طَويلُ",11,"ل",1,0],["إن الخلافة والألآ","ف برغم ذي حسد وواغر",12,"ر",1,0],["إن الخلافة كائن أوتادُها","بعد الوليد إلى ابن أم حكيمِ",13,"م",1,1],["إِنَّ الخِيانَةَ وَالمَغالَةَ وَالخَنا","وَاللُؤمَ أَصبَحَ ثاوِياً بِالأَبطَحِ",14,"ح",1,0],["إِنَّ الخِلافَةَ مِن رَبّي حَباكَ بِها","لَم يُصفِها لَكَ إِلّا الواحِدُ الصَمَدُ",15,"د",1,0],["إِنَّ الخَليفَةَ لَم يُسَمِّكَ سَيفَها","حَتّى بَلاكَ فَكُنتَ عَينَ الصارِمِ",16,"م",1,0],["إِنَّ الخَليفَةَ قَد جَدَّت عَزيمَتُهُ","فيما يُريدُ وَما في جِدِّهِ لَعِبُ",17,"ب",1,0],["إِنَّ الخِلافَةَ لا تُلقى كَتائِبُها","كَما لَقيتَ بِعَوّادٍ وَصَنّاجِ",18,"ج",1,0],["إِنَّ الخِلافَةَ أَحمَدَت مِن أَحمَدِ","شِيَماً أَنافَ بِها عَلى الإِحمادِ",19,"د",1,0],["إِنَّ الخَليفَةَ هارونَ الَّذي وَقَفَت","في كُنهِ آلائِهِ الأَوهامُ وَالفِكَرُ",20,"ر",1,0],["إِنَّ الخُطوبَ طَوَينَني وَنَشَرنَني","عَبَثَ الوَليدِ بِجانِبِ القِرطاسِ",21,"س",1,0],["إِنَّ الخَليفَةَ لَيسَ يَرقُبُ بِالَّذي","طالَبتُ إِلّا أَن تَقولَ فَيَفعَلا",22,"ل",2,0],["إِنَّ الخِلافَةَ لَمّا اِهتَزَّ مِنبَرُها","بِجَعفَرٍ أُعطِيَت أَقصى أَمانيها",23,"ي",3,0],["إِنَّ الخَراجَ بِقِنِّسرينَ يَجمَعُهُ","تَدبيرُ يَقظانَ يَدري كَيفَ يُحيِيهِ",24,"ي",2,0],["إِنَّ الخَليطَ أَجَدَّ البَينَ فَاِنفَرَقا","وَعُلِّقَ القَلبُ مِن أَسماءَ ما عَلِقا",25,"ق",2,1],["إِنَّ الخُطوبَ غُدُوَّها وَرَواحَها","في الخَلقِ دائِبَةٍ تُجيلُ قِداحَها",26,"ح",3,1],["إِنَّ الخَلائِقَ في الدُنيا لَوِ اِجتَهَدوا","أَن يَحبِسوا عَنكَ هَذا المَوتَ ما حَبَسوا",27,"س",3,0],["إنّ الخطوبَ طَرَقْنَني في جنّة","أخْرَجْنني منها خروج المذنبِ",28,"ب",1,0],["إِنَّ الخَليفَةَ وَالخَليفَةَ قَبلَهُ","وَجَداكَ تِربَ نَصيحَةٍ وَعَزيمِ",29,"م",1,0],["إِنَّ الخِلافَةَ أَصبَحَت حُجُراتُها","ضُرِبَت عَلى ضَخمِ الهُمومِ هُمامِ",30,"م",1,0],["إِنَّ الخَليفَةَ لَمّا صالَ كُنتَ لَهُ","خَليفَةَ المَوتِ فيمَن جارَ أَو ظَلَما",31,"م",2,0],["إِنَّ الخَليفَةَ وَالأَفشينَ قَد عَلِما","مَنِ اِشتَفى لَهُما مِن بابَكٍ وَشَفى",32,"ف",2,0],["إِنَّ الخَليفَةَ حينَ يُظلِمُ حادِثٌ","عَينُ الهُدى وَلَهُ الخِلافَةُ مَحجَرُ",33,"ر",1,0],["إِنَّ الخِلافَةَ لَو جَزَتكَ بِمَوقِفٍ","جَعَلَت مِثالَكَ قِبلَةً لِلمَسجِدِ",34,"د",1,0],["إِنَّ الخَليفَةَ قَد عَزَّت بِدَولَتِهِ","دَعائِمُ الدينِ فَليَعزِز بِكَ الأَدَبُ",35,"ب",1,0],["إنَّ الخمولَ وقاني","ما كنتُ أخشى وأكرَهْ",36,"ه",1,1],["إِنَّ الخَليطَ أَجَدَّ فَاِحتَمَلا","وَأَرادَ غَيظَكِ بِالَّذي فَعَلا",37,"ل",2,1],["إِنَّ الخَبيبَ تَرَوَّحَت أَثقالُهُ","أُصُلاً فَدَمعُكَ دائِمٌ إِسبالُهُ",38,"ل",2,1],["إِنَّ الخَليطَ الَّذينَ كُنتُ بِهِم","صَبّاً دَعَوا لِلفِراقِ فَاِنطَلَقوا",39,"ق",3,1],["إِنَّ الخَليطَ مَعَ الصَباحِ تَصَدَّعوا","فَالقَلبُ مُرتَهَنٌ بِزَينَبَ موجِعُ",40,"ع",1,1],["إِنَّ الخَليطَ تَصَدَّعوا أَمسِ","وَتَصَدَّعَت لِفِراقِهِم نَفسي",41,"ي",1,1],["إِنَّ الخَليطَ رائِحٌ","قَبلَ الصَباحِ يُبكِرُ",42,"ر",1,0],["إِنَّ الخَليطَ الَّذي تَهوى قَدِ اِئتَمَروا","بِالبَينِ ثُمَّ أُجِدَّ البَينُ فَاِبتَكَروا",43,"ر",3,1],["إِنَّ الخَليطَ مُوَدِّعوكَ غَدا","قَد أَجمَعوا مِن بَينِهِم أَفَدا",44,"د",2,1],["إنّ الخلافةَ حقَّها وتراثَها","لِمُدافعين عن الذّمارِ كِرامِ",45,"م",1,0],["إنّ الخلافةَ قد تَداركَ سُورَها","بأسٌ يُزيلُ شواهِقَ الأسوارِ",46,"ر",1,0],["إِنَّ الخَلائِفَ لا يُفارِقُ مُلكَهُم","لَيثٌ يَصولُ وَلا حُسامٌ يَضرِبُ",47,"ب",1,0],["إِنَّ الخَليفَةَ لَو صَكَّت عَزائِمُهُ","نَوائِبَ الدَهرِ ذي الحِدثانِ لَم تَنُبِ",48,"ب",1,0],["إِنَّ الخَليفَةَ لَيسَ يِعدُو عِلمُهُ","أَنَّ الأَميرَ حُسامُهُ المَسنونُ",49,"ن",1,0],["إِنَّ الخَليطً الَّذينَ كُنتُ بِهِم","صَبّاً لِلفِراقِ فَافتَرَقُوا",50,"ق",3,1],["إِنَّ الخَليطَ أَجَدّوا البَينَ فَاِنفَرَقوا","وَذاكَ مِنهُم عَلى ذي حاجَةٍ خُرُقُ",51,"ق",1,1],["إنّ الخبيرَ بكم أجَدَّ بخُلقكم","غيباً فجرَّدَ فيكمُ التنزيلا",52,"ل",2,0],["إِنَّ الخَليطَ أَجَدَّ البَينَ فَاِفتَرَقا","وَعُلِّقَ القَلبُ مِن أَسماءَ ما عَلَقا",53,"ق",2,0],["إِنَّ الخِلافَةَ لَم تَزَل","تَزهو وَتَفخَرُ بِالأَمينِ",54,"ن",1,1],["إِنَّ الخَليفَةَ ظِلٌّ يُستَظَلُّ بِهِ","عالٍ مَعَ الشَمسِ مَحفوفٌ بِأَطوادِ",55,"د",1,0],["إِنَّ الخَليفَةَ طَودٌ يُستَظَلُّ بِهِ","عالٍ مَعَ الشَمسِ مَحفوفٌ بِأَطوادِ",55,"د",1,0],["إِنَّ الخَليفَةَ قَد بَغى","وَإِذا أَبى شَيئاً أَبَيتُه",56,"ت",2,0],["إنَّ الخَلافَةَ لَنْ تَرْضى وَلا رَضِيَتْ","حَتّى عَقدْتَ لها في رَأسِكَ التَّاجا",57,"ج",2,0],["إن الخيال نهايةٌ في أمة","لسكونِها وبدايةُ الحركاتِ",58,"ت",1,1],["إن الخطوب نزلن بي","فتركنني عظما وَجلدا",59,"د",2,0],["إنِ الخصمُ لم يذعن الى ما تقيمه","من القسط كانَ السيف أَصدق برهان",60,"ن",1,0],["إن الخِلاف الَّذي جَد","د بيننا لا يسوى",61,"و",2,0],["إن الخلاف الَّذي طالَت مسافته","بين الطوائف بعد الموت ينحسم",62,"م",1,0],["إنَّ الخليعَ ورَهْطَهُ في عامِرٍ","كالقَلْبِ أُلبسَ جؤجؤاً وحزيما",63,"م",2,0],["إِنَّ الْخُطُوبَ الَّتِي ذَلَّلْتَ جَانِبَها","بِحُسْنِ رَأَيِكَ لَمْ تُقدَرْ لِمَقْدُورِ",64,"ر",1,0],["إنّ الخَيَالَ مِنَ الحَسْنَاءِ قَدْ طَرَقَا","فَبِتُّ مُرْتَفقاً مِنْ حُبِّها أَرِقا",65,"ق",2,1],["إن الخلافة كلما ذكر اسمها","شخصتْ إليك حواضرٌ، وبواد",66,"د",1,0],["إن الخليفة ليس بعدو علمه","أن الأمير حسامه المسنون",67,"ن",1,0],["إنَّ الخَلِيطَ الَّذِينَ كُنْتُ بِهِمْ","صَبَّاً دَعَوْا لِلْفِرَاقِ فکنْطَلَقُوا",68,"ق",3,1],["إنَّ الخَلِيطَ مَعَ الصَّباحِ تَصَدَّعُوا","فَکلقَلْبُ مُرْتَهَنٌ بِزَيْنَبَ مُوجَعُ",69,"ع",1,1],["إنّ الخلافةَ لا تشكو بمعضلةٍ","والحافظُ اللَهُ والمنصورُ يعقوبُ",70,"ب",1,0],["إن الخرابيش التي حامت على","أو حول من يرتادهن ظنون",71,"ن",1,0],["إن الخلاف مشتتٌ ومفرقٌ","ما بين آباء لهم وبنينَا",72,"ن",2,0],["إن الخلافةَ نالَت من محاسِنِكُم","أوفى الحُظوظِ فأبدت منظراً عَجَبَاً",73,"ب",2,0],["إِن الخليفةَ للزمان وأهلِهِ","طَودٌ من الحَدَثانِ لا يتضعضَعُ",74,"ع",1,0],["إِنَّ الخَليفَةَ لَمّا رُقتَهُ شِيَماً","عَلِقتَ مِنهُ بِحَبلٍ لَيسَ يَنقَضِبُ",75,"ب",1,0],["إِنَّ الخِلافَةَ مُذ دَعَتكَ حُسامَها","وَرَدَت بِحَدِّكَ مَنهَلاً لَن يورَدا",76,"د",2,0],["إِنَّ الخَلائِفَ مُذ بَلَوكَ نَصاحَةً","جَعَلوا لَكَ الشَرَفَ الرَفيعَ مُقَرَّرا",77,"ر",2,0],["إِنَّ الخِلافَةَ لَم يُرَوَّع سِربُها","مُنذُ اِنتَضَتكَ فَكُنتَ عَضباً مُرهَفا",78,"ف",2,0],["إنّ الخلافةَ ما اصْطَفَتْك لنفسها","حتى اخْتُبِرت لكلِّ أمرٍ يُحْمَد",79,"د",1,0],["إنّ الخلافةَ لم تَزُلْ عن أصِلها","بل أصبحتْ في ملكِ ناظمِ شَمْلِها",80,"ل",3,1],["إن الخلافة ما أَتتْك عريبة","بل أَيِّمٌ أضحتْ تُزَفُّ لبَعْلِها",80,"ل",3,0],["إن الخطوب سقيني","كأس الأسى بصروفهنّه",81,"ن",2,1],["إن الخمول سرورٌ","لمن أراد السرورا",82,"ر",2,0],["إِنَّ الخَليطَ أَجدّوا البَينَ فَاِنقَذَفوا","وَأَمتَعوكَ بِشَوقٍ أَيَّةً صَرَفوا",83,"ف",3,1],["إِنَّ الخِلافَةَ لَم يَكُن لِيَطيقَها","إِلّا اِمرؤٌ لِلمُعضِلاتِ حَمولُ",84,"ل",1,0],["إن الخرافة دهر نحن نخلقه","بوهمنا وهو دجالٌ ومحتال",85,"ل",1,0],["إن الخلود لمن يطيق ميسّرٌ","فليمضِ طلاب الخلود ويقدموا",86,"م",3,0],["إنّ الخلافةَ مُذْ لاذت بحَوْزَته","لم يطمع النقصُ فيها لا ولا الزَّلَل",87,"ل",1,0],["إن الخلافَة مذ أُلبِسْت حُلَّتها","عَزَّت ولم تَلْقَ من مَسْعاك تقصيرا",88,"ر",2,0],["إِنَّ الخِلافَةَ مَع كَمالِ","جَمالِها وَبَهائِها",89,"ا",3,0],["إِنَّ الخَليفَةَ لا يُلِم","مُ بِمَن يُلِمُّ بِهِ المَخاوِف",90,"ف",1,0],["إِنَّ الخَليفَةَ خَيرُ مَن وَطِئَ الحَصا","مِن خَيرِ بادٍ في الأَنامِ وَحاضِرِ",91,"ر",1,0],["إنَّ الخَليطَ أجَدَّ البَينَ فانتَجعُوا","يومَ الوَدَاعِ فما جَاؤُوا ومَا رَتَعُوا",92,"ع",3,1],["إنَّ الخسارةَ في الجسارَةِ حَيثُما","قَتلُ المغيرِ على السِّياجِ يُباح",93,"ح",1,0],["إنّ الخِلافَةَ بانَ عنها رَبُّها","فالمؤمنون جميعُهُم أيتام",94,"م",1,0],["إنّ الخُصومَ قُضاتكم وسلاحُهُم","أحكامُهُم وجُنودُهم حُكَّام",94,"م",1,0],["إن الخلافةَ مدّت ظلّ سلطتِها","على بنيها ولاقى العتبُ إعتابا",95,"ب",2,0],["إِنَّ الخُدودَ بِلا نَبتٍ يُزَيِّنُها","رَبعُ الأَحِبَّةِ مِن سُكّانِهِ خالِ",96,"ل",1,0],["إِنَّ الخَلاعَةَ قَد خَلَعتُ لِباسَها","وَعَلِمتُ أَنَّ الجِدَّ خَيرُ لِباسِ",97,"س",1,0],["إنّ الخليفةَ دامَ وارفُ ظلّه","للدينِ وَالدنيا مقيل تنعّمِ",98,"م",1,0],["إنّ الخطوبَ تهولُ عندَ عُمومها","إِذ ليسَ من يُسلي ولا يتوجّعُ",99,"ع",1,0],["إِنّ الخليفةَ مدّ اللّه دولتهُ","رَآك أَحرى بتنويهٍ وتمجيدِ",100,"د",1,0],["إِنَّ الخُدودُ هِيَ الوُرودُ تَفَتَّحَت","وَالبَعضُ يَزعُمُ أَنَّها قَد رُشِّحَت",101,"ت",1,0],["إِنَّ الخَليفَةَ فَرعٌ حينَ تَنسُبُهُ","مِنَ الأَعاصي هِجانٌ خَيرُ مَنسوبِ",102,"ب",1,0],["إِنَّ الخَليفَةَ في يَدَي","هِ سَجالُ عَفوٍ وَاِنتِقامِ",103,"م",1,0],["إنّ الخليفةَ للقُصّادِ إن وفَدوا","بيتُ النَّدى وابْنُ عبد الواحدِ الرُّكُن",104,"ن",1,0],["إنّ الخَميسَ يكونُ أوّلَ طالعٍ","منه على عَيْنِ العَدُوِّ رَعيل",105,"ل",1,0],["إنّ الخليفةَ والتّأييدَ يَكنُفُه","لمّا اغتدَى لكفاةِ المُلْكِ مُختَبِرا",106,"ر",2,0],["إن الخيام كما علمت خيامُهم","لكن لها في النازحين ضليل",107,"ل",1,0],["إن الخبيث يُري السليمَ وداعةً","فيغش منه وهو ذئبٌ أدرَع",108,"ع",1,0],["إن الخليل كليم والكلام له","رق وفي الرق أعلاه ينظمه",109,"م",2,0],["إِنَّ الخِلافَةَ قَد تَبَيَّنَ نورُها","لِلنّاظِرينَ عَلى جَبينِ مُحَمَّدِ",110,"د",1,0],["إنَّ الخلاعات لفي فتيةٍ","لم يَلْبَسوا في الأُنس ثوب الوقار",111,"ر",1,0],["إنَّ الخوارج عن أمر أمرت به","جاءت إليك لعمري غير مفتقر",112,"ر",1,0],["إن الخيانة للأوطان أخطرها","حجر على الحق أو إرهاق أحرار",113,"ر",1,0],["إِنَّ الخَضيبَ لَفي بَلاءٍ مُطبِقٍ","ما بَينَنا في ذاكَ مِنهُ خِلافُ",114,"ف",1,1],["إِنَّ الخَضيبَ أَقَلُّ ما يُبلى بِهِ","أَلّا يَزالُ مُسَوَّدَ الأَطرافِ",115,"ف",1,1],["إن الخليط أجدِّ البين فابتكروا","لنية ثم ما عاجوا وما انتظروا",116,"ر",3,1],["إِنَّ الخَواتيمَ في طيِّ الغُيوبِ لنا","كذا لنا اللهُ في منشورِنا كتَبَا",117,"ب",2,0],["إن الخلافة والوزارة لم تزل","يا ابن الكفيل بنصرها تتكفل",118,"ل",1,0],["إن الخلافة لا يزال يمدها","من ربها التأييد والإلهام",119,"م",1,0],["إِنّ الْخُفاشَ يَرَى الظَّلامَ خَلِيْلَهُ","فإذَا تَحَلَّى بالضِّيا لم يُوجَدِ",120,"د",1,0],["إِنَّ الخَليفَةَ بَدرُ آلِ مُحَمَّدٍ","وَلِوائِلٍ أَصبَحتَ أَنتَ هِلالا",121,"ل",2,0],["إن الخريف هو الربيع الثاني","ونسيمه هو للغصون الثاني",122,"ي",1,1],["إِنَّ الخَوَافِي يَخْتَفِيْنَ وَإِنَّمَا","قَصْدُ الزَّمَانِ مِنَ الجَنَاحِ القَادِمَهْ",123,"ه",1,0],["إِنَّ الخيانَةَ وَالمَغالَةَ وَالخَنا","وَالغَدرَ أَترُكُهُ بِبَلدَةِ مُفسِدِ",124,"د",1,0]]}