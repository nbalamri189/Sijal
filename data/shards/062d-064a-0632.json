{"poems":[[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[4988,"فوز وفشيله","https://www.poetsgate.com/ViewPoem.aspx?id=185312",""]],"verses":[["حَيزومُ أقدِمْ إنّما هي كرّةٌ","عَجْلَى تُجاذبك العِنَانَ فتمرحُ",0,"ح",1,0],["حيزت بجند الحِيَل المجند","وأحرزت بالرأي والمهنّد",1,"د",1,0],["حِيز الكمالُ لراجحٍ من هاشمٍ","غَمْرٍ خلائقهُ كريمِ المرْضعِ",2,"ع",1,0],["حيّز الكون جميعاً قد زهى","وبهاءُ الغرب للشرقِ انتهى",3,"ه",2,0],["حَيَّزتَ بَل جَهَّيتَ بَل شَبَّهتَ بَل","جَسَّمتَ لَستَ بعَارِفِ الرَّحمنِ",4,"ن",1,0],["حيزآ نصيرة كلّ عاني ومظلوم","البارحه ي حسين خلّت أصيله",5,"ل",2,0],["حيزا سنام المجد وعزومها عزوم","ثقلت عليها حمول ماهي ثقيله",5,"ل",2,0],["حيزا حرار الكون وعلومها علوم","لكنّ حجب الصوت ما هو نفيله",5,"ل",2,0]]}