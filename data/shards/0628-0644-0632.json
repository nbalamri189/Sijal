{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[72,"قالوا تعشقتها عمياء قلت لهم","https://www.aldiwan.net/poem42973.html","البسيط"],[68,"أنظر إلى المجد كيف ينهدم","https://www.aldiwan.net/poem40298.html","المنسرح"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[427,"يا قلب زرت وما انطوى ذاك الجوى","https://www.aldiwan.net/poem46393.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101541","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6756","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87864","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112300","المنسرح"],[3621,"","https://poetry.dctabudhabi.ae/diwan/poem/198776","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216814","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111420","البسيط"],[5010,"الحب والشيب","https://www.poetsgate.com/ViewPoem.aspx?id=190350",""],[5038,"الحدباء تناديني","https://www.poetsgate.com/ViewPoem.aspx?id=195227",""],[5277,"جنّاتُ عاطفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192112",""],[5939,"أنت كلّي","https://www.poetsgate.com/ViewPoem.aspx?id=178585",""],[5956,"شكراً دعوتِ لطفلتي أن تشتفي","https://www.poetsgate.com/ViewPoem.aspx?id=202659",""],[6052,"كاسات الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=34649",""],[1333,"الشيب نبه ذا النهى فتنبها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56029&r=&rc=7",""]],"verses":[["بَلْ زَادَ عَقْلُكَ بَسْطَةً مِنْ بَعْدِهَا","حَتَّى أَحَاطَ بِكُلِّ شَيْءٍ يُعْقَلُ",0,"ل",1,0],["بَل زادَ وَجدِيَ فيها أَنَّها أَبَداً","لا تُبصِرُ الشَيبَ في فودي إِذا وَضَحا",1,"ح",2,0],["بَل زَعَموا أَن يَصُدَّنا جَزَعٌ","كانَت يَدُ اللَهِ فَوقَ ما زَعَموا",2,"م",3,0],["بل زَادَهم فيكَ حُبّاً ما فَعَلْتَ بهِم","مِنَ الجَمِيلِ وَذَنْبُ الحُبِّ مُغْتَفَرُ",3,"ر",1,0],["بَلْ زَادَهُ سِعَةً نَمُوُّ عَدِيدِهِمْ","فِي كَابِرٍ مُتَسَلْسِلٍ عَنْ كَابِرِ",4,"ر",1,0],["بل زاد شوقي للحبيب ورامةٍ","والأبرَقَينِ وما لمُنعرج لوى",5,"و",2,0],["بل زادني فَرط التهالكِ لوعةً","ستقضُّني حتى اموت شهيدا",6,"د",2,0],["بل زهدت في غيرها وما ونت","وأنها في كل بر برعت",7,"ت",1,0],["بَل زادَ نَفسي رَغبَةً فَتَهافَتَت","تَبغي اللُهى وَكَأَن بِها بَينَ اللَها",8,"ه",2,0],["بَل زَهرَةٌ فَوّاحَةٌ","عَبَثَت بِها أَيدي القَضاء",9,"ا",2,0],["بل زَعموا أنها تَدومُ لهُم","فسوقَ يدري الوَرَى بأن كذبوا",10,"ب",3,0],["بَلْ زايدُ الخيْر والأقبالُ تعرفُه","أوْصافُهُ طُرِّزَتْ في دارَةِ الشُهُبِ",11,"ب",1,0],["بل زاد شجوك أن تلقي لها مثلا","حيّاً على أنه في البعد كالحلم",12,"م",1,0],["بَل زادَ مِحنتَهُم وَيلاً وما عَرَفوا","دَعَوا وذَرُّوا الشَّعِيرَ الرَّافِعَ القُبَلا",13,"ل",2,0],["بَلْ زَادَهُ هَذَا التَّوَهُّمُ صَبْوَةً","وَتَعَلُّقًا فِيْ غَايةِ الإِحْكَامِ",14,"م",1,0],["بَلْ زَفَّها مُفْتَرٍ جَهْلاً إِلى وَزَغٍ","وَالْجَهْلُ يَعْزُفُ عَنْ كُلِّ الْبَراهِينِ",15,"ن",1,0],["بل زورقٌ في لجّةٍ,عصفتْ","ريحُ الهوى فتماوجَ البحرُ",16,"ر",1,0],["بل زِدتَني وغدَوْتَ كُلّي","طابتْ جِنانِكِ لي فَكُلْ لي",17,"ل",2,0],["بل زدتما ما خصَّصاه مِن نَدى","ليعوَّض المولى الوظيفة والجَدا",18,"د",2,0],["بل زادهم فينا ربيع ربوعنا","جشعاً ويدفع حشدهم حساد",19,"د",1,0],["بل زاد رغبة فتهافتت","تبغي اللهى وكأن بها بين اللها",20,"ه",2,0]]}