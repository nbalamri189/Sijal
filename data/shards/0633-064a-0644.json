بيل ..?","https://www.poetsgate.com/ViewPoem.aspx?id=193116",""],[5677,"عيد ميلادك","https://www.poetsgate.com/ViewPoem.aspx?id=179848",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""],[5792,"يحبونه","https://www.poetsgate.com/ViewPoem.aspx?id=180355",""],[5818,"ماتت","https://www.poetsgate.com/ViewPoem.aspx?id=180632",""],[5829,"البنت اللعوب","https://www.poetsgate.com/ViewPoem.aspx?id=152563",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[6052,"ثمار الخير","https://www.poetsgate.com/ViewPoem.aspx?id=35377",""],[6093,"سَيْلُ البَيَاضِ","https://www.poetsgate.com/ViewPoem.aspx?id=191152",""],[6093,"سيل جدة","https://www.poetsgate.com/ViewPoem.aspx?id=193649",""],[6127,"الأملُ الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=198207",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[6180,"الأعداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81071&r=&rc=5",""]],"verses":[["سُئِلوا العَوادَ فَجانَبوهُ فَعاودوا","وَالآنَ إِذ مَلَكَ الزَمانُ وَقيدوا",0,"د",3,0],["سَيْلٌ بِمُنْقَطَعٍ سَحِيقٍ غَوْرُهُ","لِلصَّخْرِ فِي مَهْوَاهُ شِبْهُ لَيانِ",1,"ن",1,0],["سَيلا مِنَ الدِعصِ أَغشَتهُ مَعارِفَها","نَكباءُ تَسحَبُ أَعلاه فَيَنسَحِبُ",2,"ب",1,0],["سيلقى عدوُّ الدين منك عزائماً","إليه بجرّار الكتائب تزحفُ",3,"ف",1,0],["سيلوح الداني به وهو قاص","ويلوح القاصي به وهو دان",4,"ن",1,0],["سئلت فلم تمنع ولم تعط نائلاً","فسيَّان لاذم عليك ولا حمدُ",5,"د",1,1],["سُئلتْ أجازَتنا لهم ولمثلهم","يروي الإجازة سيدٌ عن سيد",6,"د",1,0],["سُئِلَتْ وقد سَالتْ ففي صفحاتها","لِلرَّدِّ تَكْدِيحٌ على تكديحِ",7,"ح",1,0],["سئِلتَ فلم تحرم سواي وإنه","لوترٌ وإني لو أشاء لثائر",8,"ر",1,0],["سُئلوا كيف نَوْمَة التارِك المج","د فقالوا كَنوْمة التَعريس",9,"س",1,0],["سُئلَ الأيرُ ما تريدُ إلى الكعْ","ثبِ قال الدخولُ قيل ألا ادْخُلْ",10,"ل",1,1],["سيلاقى البغاة يوما ثقيلا","فيه لا ينفع الصديق الصديقا",11,"ق",2,0],["سَيلُ المَمالِكِ جارِفٌ مِن شِدَّةٍ","وَقُوىً وَأَنتُم في الطَريقِ نِيامُ",12,"م",1,0],["سُئِلتَ سِلماً عَلى نَصرٍ فَجُدتَ بِها","وَلَو سُئِلتَ بِغَيرِ النَصرِ لَم تُجِبِ",13,"ب",1,0],["سَيلٌ تَجَلَّلَ قُطرَيها فَطَبَّقَها","يَعُمُّ غائِرُها المَخفوضَ وَالأَكَما",14,"م",2,0],["سَيَلقى الَّذي يَلقى خُزَيمَةُ مِنهُمُ","لَهُم أُمُّ بَذّاخينَ غَيرَ عَقيمِ",15,"م",1,0],["سَيُلحِقُني حادي المَنايا بِمَن مَضى","أَخَذتُ شِمالاً أَو أَخَذتُ يَمينا",16,"ن",2,0],["سيلتقي القبحُ فيه","بدميةٍ من جمالِ",17,"ل",1,0],["سَيلٌ طَما لَو لَم يَذُدهُ ذائِدٌ","لَتَبَطَّحَت أولاهُ بِالبَطحاءِ",18,"ا",2,0],["سيلٌ طغى في بعلبكَّ وراعدٌ","ولهيبُ نارٍ ثارَ للتعذيبِ",19,"ب",1,1],["سُئلوا أترمون البلادَ بزائفٍ","وتُغرِّرون بسوقةٍ ومَوالِ",20,"ل",1,0],["سَيلٌ تَدافَعَ بِالآثامِ زاخِرُهُ","ما قُلتُ أَمسَكَ إِلّا اِنسابَ يَندَفِقُ",21,"ق",1,0],["سَيَلفُّنا الزَمَنُ المُفَرِّقُ بَينَنا","وَيَضُمُّنا العَهدُ الَّذي نَتَوَقَّعُ",22,"ع",1,0],["سُئِلُوا عن العلمِ القديمِ فزوَّروا","وأذى المزَوِّرِ أن يكونَ عليما",23,"م",2,0],["سَيلقَوْنَ بُؤساً بعد أمنٍ ونعمةٍ","فلا العيشُ فيّاحٌ ولا الظلُّ وارِفُ",24,"ف",1,0],["سُئِلتَ فَلَم تَبخَل وَلَم تُعطِ طائِلاً","فَسِيّانِ لا ذَمٌّ عَلَيكَ وَلا حَمدُ",25,"د",1,1],["سَيلقَى دُبرَكَ الصَلتُ","وَيَلقى قُبلَكَ الصَقرُ",26,"ر",1,0],["سَيَلقى كُلُّ مَن حَذِرَ المَنايا","فَضَع ثِقلَيكَ مِن دِرعٍ وَتُرسِ",27,"س",1,0],["سَيَلقون منا أُمة عَربية","تحارب حتىّ يثخنَ القتلُ وَالجرحُ",28,"ح",1,0],["سيلبثُ السرُّ وراءَ الستارْ","ويختفي الشلوُ ويُمحى الدمُ",29,"م",1,0],["سيلي فلا تُبقي على غُصَصٍ","رانتْ على قلبي ولا تذَري",30,"ر",2,0],["سيُلحقون فلسطيناً بأندلسٍ","ويَعْطفون عليها البيتَ والحرما",31,"م",2,0],["سئلت ما راق نفسي من محاسنها ؟","فقلت للناس : باديها وخافيها",32,"ي",3,0],["سيل عيني عند تلك البوادي","سال منه لاجلها عينان",33,"ن",1,0],["سيل همومي قد طغى عبابا","وجن حتى ملأ الشعابا",34,"ب",2,1],["سيلي جَوىً واِسألي تقريبهم كرماً","فربَّ سائلةٍ يرجى لها السولُ",35,"ل",1,0],["سيل جحاف فلا سهل ولا جبل","إلا أجاح مكاناً منه إن جحفا",36,"ف",2,0],["سيلُ الشجونِ غدا قلبي قرارته","ينصبُّ فيه وَمن عينيَّ ينهمع",37,"ع",1,0],["سيلقى غداً ما كان يسعى لمثله","ويُسقى صديداً في لظى وصليبا",38,"ب",2,0],["سيلقُون يوم الحشْر غِبٍّ فِعالِهم","وكُلُّ امرءٍ يُجْزَى بما هُو كاسِيُهْ",39,"ه",1,0],["سيلحقه من يقتدي بفعاله","فعما قريب فهو من قتلاها",40,"ا",3,0],["سيلٌ على ألواذِهِ","أُدمانُهُ أو أَنْوُقُهْ",41,"ق",2,0],["سيلقَى بها الكافي عهوداً وثيقةً","لقد زادها الإسلامُ حقاً وأكّدا",42,"د",2,0],["سيلُقي عصاهُ وادعاً كلُّ خابطٍ","على الرزقِ يطوِي أرضَه ويجوبُ",43,"ب",1,0],["سيلٌ من العلياءِ سالَ ومِنْ عُلى","قاضي القُضاة أخي المناقِبِ مَدُّهُ",44,"د",2,0],["سيلقى جزاء سيئا غبية إِذا","أرى سائر الاعمال في الحشر محضرا",45,"ر",2,0],["سيلوا هموا سلوا على الخطب مضوا","شيموا الندى جادوا ولوا فعدلوا",46,"ل",3,0],["سيل أتٌي والقلوب قرارهُ","درٌ ثمين والرواةُ تجاره",47,"ر",2,0],["سيلبسها سابغاً ضافياً","ويشربها عذبة صافيه",48,"ي",2,0],["سَيلقَى مِنَ الدَّيَّانِ ما هو أهلُه","وبالخِزي في الدُّنيا سَتبقى له الذِّكرى",49,"ر",2,0],["سيل إذا ذكر السخاء فحاتم","والحرب عنتر لا يقاس بعبده",50,"د",2,0],["سيلٍ يكلّي في مياريه وْيزوف","على كل عطشانٍ ومروي ونادي",51,"د",2,0],["سَيْلاً كَسَيْلِ الزَبدِ الغِطْماطِ","وعرَبٍ عَاتِينَ أَوْ أَنْباطِ",52,"ط",1,0],["سَيْلاً بِطاحاً وَجُنُوداً طَبَقَا","إِذَا قُدُور الأَكْثَرِينَ مَرَقا",53,"ق",2,0],["سيلقاه مكتوبا ويخزى به غداً","وأقربُ شيء منك يا غافلاً غدُ",54,"د",1,0],["سئِلَ الورى ما فوق كلِّ ملذَّةٍ","فالناس عمّاً قرَّروا ببديهة",55,"ه",2,1],["سُئِلوا فَأَبَوا فَلَقَد بَخِلوا","فَلَبِئسَ لَعَمرُكَ ما فَعَلوا",56,"ل",3,1],["سُئِلَ العَطاءَ فَلا بمَطلٍ يُجتَدى","مِنهُ المَقالُ وَلا بِوَعدٍ يُقتَضى",57,"ض",2,0],["سيلقى كلَّ عزّ","وإحساناً وبرّا",58,"ر",2,0],["سيلي لِلأَمامه مُستحق","لِأَن مَجيد صَنعته رَسول",59,"ل",1,1],["سيُلقى بكم في النار مع شعرائكم","إذا انعقدت في الحشر محكمة الشعر",60,"ر",1,0],["سيل الدموع من الثواكل","ضاع ما بين السيول",61,"ل",1,0],["سيلحق الهيجا مشيحا حمل","فيحجم العدو عن إقدامه",62,"م",2,0],["سيلقاكَ فكّاكاً لكلِّ عويصة","سريعاً إلى نصر الحقائقِ فاصِلا",63,"ل",2,0],["سيلقاكَ مهضومو الحقوقِ نصيرَهم","كما كنت للعافين عوناً مناضِلا",63,"ل",2,0],["سيلقى مناه وأقصى رضاه","بمولىً يراه فذاك المنى",64,"ا",1,0],["سَيَلقاكَ قِرنٌ لا تُريدُ قِتالَهُ","كَميُّ إِذا ما همَّ بالقِرنِ أَقصَدا",65,"د",2,0],["سيلحقهم أهل الفسوق إذا استوى","بحلية سبقٍ طرفها وحمارها",66,"ر",3,0],["سيَلقَى لدى الرّحْمنِ فضْلَ جهادِهِ","شَفيعاً كما يُرْضي النّبيَّ مُشَفَّعا",67,"ع",2,0],["سيلاً كما ارفض الجمان أَساله","أَحزانه في إِثر حب رباب",68,"ب",1,0],["سيلحقني بالحي من كل وجهة","أخو الريح من آل الوجيه ولاحق",69,"ق",1,0],["سئلت عن سيل أتي","والبيت منه قد سقط",70,"ط",1,1],["سيلٌ من الأحرار يجرف ما بنى","فوق الفساد مدبر وسياسي",71,"س",2,0],["سيلقى آلُ نادر منه نجماً","مضيئاً بين هاتيك النجومِ",72,"م",1,0],["سئلوا فما بخلوا وقد كسبوا","شرفاً وما غلبوا وما منعوا",73,"ع",3,1],["سئل بعضهم عن الدنيا فقال","معرفاً لها بأوجز مقالْ",74,"ل",1,0],["سيلبث ذاك السلاح المتين","بقعر المياه دفين الغرين",75,"ن",1,0],["سيلانةٌ بالنوى كم سال عندمها","والآن يا منيتي سُرت سرائرُنا",76,"ن",2,0],["سئلت عن دوا الخمار فقالت","كومة ثم نومة ثم عومه",77,"ه",1,0],["سيلقى إذا ولى أخاه فظاظة","لدى طمحات الدهر صلعاء صيلما",78,"م",2,0],["سيلبسنا بهاء غاب عنا","ويلهمنا صوابا عاد صبا",79,"ب",2,0],["سيلقى لفقد الصالح المجد حسرة","يغص بها منه اللها والمخنق",80,"ق",1,0],["سيُلدغ ُ الجاهل المغرور من قُبُل ٍ","ويحفظ ُ الدرس مصروعا ومضطربا !!",81,"ب",2,0],["سيل تحادر في مسيرته","قد ودع الإيمان والورعا",82,"ع",2,0],["سيل أسال الدمع منه دما","والحزن في أعماقه انطبعا",82,"ع",2,0],["سيل الهجوس اللي الى جاتني جات","كتها على عقلي من الماضي تهيل",83,"ل",1,0],["سيّلت لك دمّ قلب ٍ نابت ٍ به نخيل","وإن جف تفكيرك التفكير لاجفّ سال!",84,"ل",1,0],["سيلقى شجاكِ نَدِيْماً ويحْظى","بشعرِ الأسى من نضيرِ القصيدْ",85,"د",1,0],["سيلٌ يَهُدُّ مدائنا وقرى","حتى يُسَّوِي كلَّ ما انتصبا",86,"ب",2,0],["سيل فضل، عرمرم للأماني","جيش نبل، منظم جرار",87,"ر",1,0],["سيل الغرور اللي جمح مع مضيقه","جرّح ثرى واشجار واحجار واديه",88,"ي",2,0],["سئلت وما اسطعتُ الجوابَ ولم أزل","أقدم عذري ثم ما قبل العذر",89,"ر",1,0],["سيلعنهم ويحرقهم","وإن الله يعلينا",90,"ن",2,0],["سيلومني العشاقُ أني عابثٌ","بالحبِّ كالطفلِ الذي ذاقَ الملَلْ",91,"ل",1,0],["سيلا من الوجع المؤجج غاضبا","نارا تفور ..ولوعة تتوثبُ",92,"ب",1,0],["سيلقى من يؤمله تباباً","ويلقى من يغر به الحمام",93,"م",1,0],["سيلقى من المولى العظيم خزاية","ويصليه في يوم اللقاء جهنما",94,"م",2,0],["سيل الدماء غدا يغرقْك جارفه","فاسفك يجئْك أتيا حين يندفعُ",95,"ع",1,0],["سئلت مثقفة القنا عنه الوغى","فجرى بصدق القول فيه المخبر",96,"ر",1,0],["سيل السباب غدا في كلّ ثانيةٍ","سياسةً صاغها الحكّامُ والخطبا",97,"ب",2,0],["سيلُ التخبط لانوحٌ فيدركنا","ولاسفينٌ ولا خضرٌ لكي نقفوا",98,"ف",3,0],["سيلتهم المساء رغيف حزنٍ","إذا دمع الفقير عليه رَشْقُ",99,"ق",1,0],["سيلُ الجياع طغى يبغي سنابلها","كلّ العيون على من فزَّ ممتشقا",100,"ق",2,0],["سيلذّ في تحطيم كلّ مركبٍ !!","ويجامع الشكَ الحرون ويفظظُ",101,"ظ",1,0],["سيلُ الرصاصِ يشقُّ اليومَ أوردتي","أمامَ أعينِكم في أرضِ حطين",102,"ن",1,0],["سَيْلُ الضَّغَائِنِ قَدْ فَاتَ الزُّبَى وَ لَقَدْ","غَاصَتْ مُرُوءَتُنَا فِي الْوَحْلِ وَ الطِّينِ ..",103,"ن",1,0],["سيل من الكلمات في حلقي تحير","والصوت متهالك وفوحه سجينك",104,"ك",1,0],["سيله عجاج الخيل والبيض والقنا","وروس النشاما بالحزوم غثاه",105,"ا",2,0],["سئل الضرائر عن حقيقة ثغرها","يوما فقلن اللؤلؤ المكنون",106,"ن",1,0],["سئلته ماحصل يوم وجرحتك","وقال اجرح مدام انته ضمادي",107,"د",2,0],["س يلفّني اليقطينُ بعدَ توسّلي","ويذوبُ في نارِ الشفاهِ التوتُ",108,"ت",1,0],["سيلجئك الغرام لكلّ همّ","وشرّ الهمِّ في البنت اللعوب",109,"ب",1,0],["سيلقون ما ألقوا وألقي وإنما","قريضي من الدُّرَّ الذي يُتلقَّفُ",110,"ف",1,0],["سيل المعارف مجرى فاض واديه","ويمسك الجرف من في عمقه عزموا",111,"م",3,0],["سَيْلُ الَبيَاضِ عَلَى المَشَاعِرِ سَالا","فَكَسَا النُّفُوْسَ مَهَابةً وَجَلالا",112,"ل",2,1],["سَيْلُ البَيَاضِ عَلَى المَشَاعِرِ سَعْيُهُ","وَهَدِيْرُهُ التَّهْلِيْلُ لمَّا انثَالا",112,"ل",2,0],["سَي