{"poems":[[53,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[87,"يا مريضا بالمناصب","https://www.aldiwan.net/poem7766.html","مجزوء الرمل"],[30,"ألستم عائجين بنا لعنا","https://www.poetsgate.com/ViewPoem.aspx?id=20017",""],[182,"صنوَ الروح","https://www.aldiwan.net/poem50712.html","الرمل"],[310,"سيدي شأوك أعيى المحتذي","https://www.aldiwan.net/poem56495.html","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49558","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109415","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109929","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117913","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36394","الدوبيت"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5969,"مِنْ لَظى التعياءِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=199332",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["ذا رقابٍ كالمضاحي","وقرون كالمَداري",0,"ر",2,0],["ذا رُعين ثم أردى بعده","ذا نواسٍ ثم أردى ذا يَزَن",1,"ن",1,0],["ذا رئيس ذا وكيل","ذا على الاثنين عال",2,"ل",1,0],["ذا رَضْرَاضَةٌ وَطِئَتْ عَلَيْهَا","خَضَبْنَ بُطُونَ مُثْعَلَةٍ رِثَامِ",3,"م",1,0],["ذا رخيمُ الصَّوت قُمْرِيّا أتى","وسقى السَّمْعَ غَريدُ النّغمِ",4,"م",1,0],["ذا ربيع فاح رياه الشذي","فاغتنم لذاته من غير مهل",5,"ل",1,0],["ذا رونقٍ لو نواتيه المُنَى لجرى","مَعَ السّماحِ على تلك الأسارير",6,"ر",1,0],["ذاريات النقد من كفيه في","أبحر الإنعام أجرت سفنا",7,"ن",2,0],["ذَا رِفعَةُ الدَّرَجَاتِ حَقًّا مَا هُمَا","إِلاَّ سَواءً أو هُمَا شِبهَانِ",8,"ن",1,0],["ذا رابعُ السبي قال اللَه عنهُ وإن","أعدت ما قبلهُ ذا لا أعاوِدُهُ",9,"د",2,0],["ذاري الرياح يكاد يقصر إن جرى","عن جوده وجواده الطامي أذا",10,"ذ",2,0],["ذا رَوضُك قَد خامره عرفُ شَذا","لا نابَ صَفاءَ مَشرَع العَيش قَذى",11,"ذ",2,0],["ذا رأفة بالمؤمنين رحيما","صلوا عليه وسلموا تسليما",12,"م",2,1],["ذَا رَبُّ أُسْرَةٍ ، قَلِيْلٌ رِزْقُهُ","إِذْ قَلَّ كَسْبُ عَيْشِهِ ، هَلْ يَسْرُقُ ؟",13,"ق",1,0],["ذاري البرايا ذروهم وكذاك في","عمارهم أعمارهم نفح",14,"ح",1,0],["ذا رفيقي في دروبي","حَسْبُهُ بئرٌ لسري",15,"ر",2,0],["ذا روضُكم نفَسُ الأشواق ينفحُه","مِن صوْلة الشِّعْر أقباسًا من العَبَقِ",16,"ق",1,0],["ذا روعة قد أرعدت فرائصه","بتوبة من كل جرم خالصه",17,"ه",1,0]]}