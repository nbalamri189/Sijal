,[4764,"عروس الموت","https://www.poetsgate.com/ViewPoem.aspx?id=27726",""],[4764,"ابختصر كلي معك","https://www.poetsgate.com/ViewPoem.aspx?id=33635",""],[4578,"رق النرجس في وجه الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=49456",""],[4984,"الغفلة","https://www.poetsgate.com/ViewPoem.aspx?id=191140",""],[585,"عز العزاء وشق كل مقال","https://www.poetsgate.com/ViewPoem.aspx?id=161858",""],[5187,"الرغبة","https://www.poetsgate.com/ViewPoem.aspx?id=29794",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5225,"مدارات","https://www.poetsgate.com/ViewPoem.aspx?id=36080",""],[5281,"الخطبُ هدَّ مشاعري","https://www.poetsgate.com/ViewPoem.aspx?id=199701",""],[5344,"وداع الشتاء ..","https://www.poetsgate.com/ViewPoem.aspx?id=180698",""],[5437,"وقت الحصيله","https://www.poetsgate.com/ViewPoem.aspx?id=144441",""],[5455,"نديم الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=34411",""],[5463,"وينك عذولي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=34271",""],[5499,"اسعى لك","https://www.poetsgate.com/ViewPoem.aspx?id=35837",""],[5573,"الاماني والامل","https://www.poetsgate.com/ViewPoem.aspx?id=200216",""],[5573,"بشت الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=200323",""],[5651,"سفرَتْ فقال أدلّةُ السّفْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=107008",""],[5664,"لا يالقصيده","https://www.poetsgate.com/ViewPoem.aspx?id=176686",""],[5794,"حداء","https://www.poetsgate.com/ViewPoem.aspx?id=80287",""],[5848,"تعريف الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=51958",""],[5950,"المشهد الأخير ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128146",""],[5976,"شفته مع الصبيان","https://www.poetsgate.com/ViewPoem.aspx?id=32095",""],[6001,"الهوى ماطاب","https://www.poetsgate.com/ViewPoem.aspx?id=492",""],[6049,"شوفي بعينك","https://www.poetsgate.com/ViewPoem.aspx?id=35820",""],[6115,"ودعتك الله يوم شفتك مغادر","https://www.poetsgate.com/ViewPoem.aspx?id=180500",""],[6124,"يوم أن كنت المغني","https://www.poetsgate.com/ViewPoem.aspx?id=201236",""],[6185,"لنكبة وأخواتها !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87024&r=&rc=10",""]],"verses":[["وَالحَيَّةُ الرَقطاءُ تُر","دي أَبَداً بِغَيرِ سُم",0,"م",1,0],["وَالحَيدَرُ الصُرّادُ لَم","يَكُ غَيمُها إِلّا طِلالا",1,"ل",2,0],["والحياة موطنه","والطبيعة والسبل",2,"ل",1,0],["وَالحَيُّ قَيسٌ حُماةُ الناسِ مَكرُمَةً","إِذا القَنا بَينَ فَتقَي فِتيَةٍ خَطَرا",3,"ر",2,0],["وَالحَيِّ بَكرٍ عَلى ما كانَ عِندَهُمُ","مِنَ القَطيعَةِ وَالخِذلانِ وَالحَسَدِ",4,"د",1,0],["وَالحَيُّ قَيسٌ بِأَعلى المَجدِ مَنزِلَةً","فَاِستَكرَموا مِن فُروعٍ زَندُها واري",5,"ر",2,0],["وَالحَيِّ إِذ بَكَرَ الشِتاءُ عَلَيهِمُ","وَعَدَت شَآمِيَةٌ بِيَومٍ مُقمِرِ",6,"ر",1,0],["والحياض المُمللآَت من الشر","بِ إذا المِرزَمْ استهبَّ الحَرورا",7,"ر",2,1],["والحيا بالبرقِ معطٍ باسمُ","كعمادِ الدين جمَّاع الثنا",8,"ن",2,0],["والحيُّ يرتَعُ ثم يسرعُ برهةً","فإذا قضى أَرَبَيْهِ أمسى عاطِنا",9,"ن",2,0],["والحياةُ التي تخرُّ لها الأحْلامُ","موتٌ مُثَقَّلٌ كالقُيودِ",10,"د",1,0],["وَالحَياةُ حَنظَلَةٌ","في حُروفِها شُهُدُ",11,"د",1,0],["والحيُّ بالجَرْعَاءِ بين بُيوتِهمْ","أُسدٌ وعِينُ جآذرٍ وعِتَاقُ",12,"ق",1,0],["والحَيَّةَ الحَتفَةَ الرَقشاءَ أَخرَجَها","مِن جُحرِها آمِناتُ اللَهِ والقَسَمُ",13,"م",1,1],["وَالحَيُّ مُنقادٌ إِلى الفَناءِ","وَلرِزقُ لا بُدَّ إِلى اِنتِهاءِ",14,"ا",2,0],["والحِيرَةُ البيضاءُ فيه صَوارِمٌ","والخطُّ من غَسّانَ فيه ذوابل",15,"ل",1,0],["وَالحَيُّ غَسّانُ وَالأُلى أودِعوا ال","مُلكَ وَحازوا عِرنينَ ناصِبِها",16,"ب",3,0],["وَالحَيُّ دارٍ بِالَّذي هُوَ حّادِثٌ","وَلَهُ مِنَ الأَمَلِ المُضَلَّلِ دارِ",17,"ر",1,0],["وَالحَيُّ إِن يُعطَ البَقاءَ","فَإِنَّهُ يَفنى وَيَكبَر",18,"ر",1,0],["وَالحَيُّ لِلأَرضِ أَن يَهلِك فَطُعمَتُها","وَإِن يَعِش يُحيِ بَعضَ الأَربُعِ الدُرسِ",19,"س",1,0],["وَالحَيُّ لا بُدَّ راكِبٌ سَفَراً","وَتارِكٌ مِن وَرائِهِ ثِقَلَه",20,"ل",2,0],["وَالحَيُّ شاهِدُ رُزءِ خَطبٍ هائِلٍ","مِن كَونِ مَيتٍ تَحتَ أُنمُلٍ هائِلِ",21,"ل",1,0],["وَالحَيُّ تُخلِقُ جِسمَهُ حَرَكاتُهُ","فَيَكِلُّ وَهوَ يُحاذِرُ الإِسكانا",22,"ن",2,0],["وَالحَيُّ في العُمرِ مِثلُ الغِرِّ يَرقَأَُ في","سورِ العِدى وَإِلى حَتفٍ تَرَقّيهِ",23,"ق",3,0],["وَالحَيُّ لِلنَكباتِ يَس","تَقري وَيَرجِعُ لِلقَرِيّا",24,"ر",3,0],["وَالحَيُّ إِذ حاذَروا الصَباحَ وَقَد","خافوا مُغيراً وَسائِراً تَلِعا",25,"ع",2,0],["وَالحَياةُ مُعجِبَتي","ثمَّ مَع تَكَدُّرِها",26,"ر",3,0],["والحين لامنّي ولهة وجيتلك","قام ايتصيّدني .. الحزن .. وأصطادني",27,"ن",2,0],["والحي من كل الجوانب حافل","ببلابل تشجيك بالانغام",28,"م",1,0],["والحي لاح لنا من كل زاوية","منه البدور كساها مرط اجلال",29,"ل",1,0],["والحيّ بدءُ حياته","بعد التزام البيض حضناً",30,"ن",2,0],["والحىّ قد هَبَطتْ خيا","مُهُمُ وقعقعقت العمادُ",31,"د",1,0],["والحىُّ أولَى بالبِلى","شوقا إذا بَلىَ الجمادُ",31,"د",1,0],["وَأَلَحَّ يَلحى في الفِراقِ أَخا هَوىً","لَم يَقضِ مِن أَحبابِهِ أَوطارا",32,"ر",2,0],["وَالْحَيْرُ والْقَصْرُ والفاطُولُ جَنَّتُها","والْجَعْفَرِيُّ بِكَفِّ الدَّهْرِ مَزْمُومُ",33,"م",1,0],["وَالحَيُّ إِذ حاذَروا الصَباحَ وَخا","فوا ذا غَواشٍ وَسُوِّموا فَزَعا",34,"ع",2,0],["والحيرةُ البيضاءُ تذكرُ عهدَهم","حيثُ المناذرةُ الأماجدُ سادوا",35,"د",3,0],["والحَيَا لا يَسُحُّ إلا إذَا جَا","لَتْ يَميناً سَحَابُهُ وَشِمَالا",36,"ل",2,0],["والحين طيَّ ضمير الحينِ مكتتم","أو حرف أوله في شكله حُرفا",37,"ف",2,0],["وَالحَيُّ كَالمَيتِ وَيَبقى التُقى","وَالعَيشُ فَنّانِ فَحُلوٌ وَمُر",38,"ر",1,0],["وَالحَيُّ لَم يَخلُ مَن صاحَ وَمُتَنَبِّهِ","قالَت وَاِبثَثتُها شَوقي وَبُحتُ بِهِ",39,"ه",1,0],["والحياة الحياة قلبٌ وحقٌّ","فاصحب الدهر رائشاً أو مصيبا",40,"ب",2,0],["والحياةالحاية للأمة الحرّ","ةِ فوق الأغلالِ والتقييد",41,"د",1,0],["وَالحَيَّةُ البَيضاءُ بَلّا","عَةُ سِحرِ مَن سَحَر",42,"ر",1,0],["والحَيُّ قد حانَ انْطلاقٌ له","وقد حَدا الحادي مَطاياه",43,"ا",2,0],["والحَيُّ صرعَى كرىً في جُنْح داجيةٍ","كأنّهم منه في الأحشاء أَسرار",44,"ر",1,0],["والحَيُّ قد أزمَعوا سَيْراً غداةَ غدٍ","كُلٌّ أعدَّ له عَيْرانةً أُجُدا",45,"د",2,0],["والحيُّ قد رَكَزوا الرِّماحَ بمنزلٍ","فيه الظّباءُ ربائبُ الآساد",46,"د",1,0],["والحيُّ من سنبس أر","بابِ النُهى والحسَبِ",47,"ب",1,0],["والحيوان الكل والشجراء","الماسك الطير بلا أعضاء",48,"ا",2,0],["والحيّ إما خالفٌ أو حاضرٌ","خَيْطُ الكرى بجفنِه قد انعقَدْ",49,"د",1,0],["والحيُّ مثل الميت يؤمن من","رقصت فرائصهُ من الذُّعرِ",50,"ر",1,0],["والحي فيها عليل","حتى إذا مات يبرا",51,"ر",2,0],["والحياة لو علموا","كنهها هي اللعب",52,"ب",1,0],["والحَيُّ مُبْتَعدٌ والمَوْتُ مُقْتَرِبٌ","والآهُ مُنْكَشِفٌ والجَمرُ مُسْتَتِرُ",53,"ر",1,0],["والحَيُّ عَنْ يمنى الرُّبَى","يَا سَعْدُ أبْشرْ باللّقَا",54,"ق",2,0],["والحيُّ عن إنذارهِ مُتَغافِلٌ","حتى تَراهُ كطامعٍ بخُلودهِ",55,"د",2,0],["وَالْحَيُّ يَقْفُو مَنْ مَضَى","بِهِ الرَّدَى حَيْثُ سَلَكْ",56,"ك",1,0],["والحَييِّ الوقاحِ في السِّلم والحر","بِ وناهيك بالحَييِّ الوَقاح",57,"ح",1,0],["والحَيْنُ يظهر في وادي سوالِفِهِمْ","كما به في ثغور البِيْضِ مُنْكَمَأُ",58,"ا",1,0],["والحياة الأخرى أبر وأبقى","بعد عفو المهيمن الغفار",59,"ر",1,0],["والحيُّ أولى بالندى من بائدٍ","بالٍ وإن جاز الكواكب ما بنى",60,"ن",2,0],["وَالحي عَنهُ العِدا وَالأُسدُ هارِبَةٌ","حَيثُ البُيوتُ مِنَ العَسّالَةِ الذبلِ",61,"ل",1,0],["وَالحَيَا وَالخَدُّ وَرْدٌ وَمدَامْ","وَالطُّلَى وَالردفُ ظَبْيٌ وَكثيبْ",62,"ب",1,0],["وَالحَي قَد لاموه كُل اللوم","قالوا أبحت أرضنا للقوم",63,"م",1,0],["وَالحَيوان صامت وَناطق","وَفائق في علقه وَمائِق",64,"ق",1,0],["والحيُّ يهمِزُ بالرحيل ومُهجتي","جزَعاً لمقترب الرّحيلِ تسيلُ",65,"ل",1,0],["والحي من تجب الحياة لذاته","للذات ليس مخارج عن ذاته",66,"ت",2,0],["والحي من ليست حياة عينه","كلا ولا هي بعض غيرياته",66,"ت",2,0],["والحي من سلفي قحطان إنهم","يزرون بالنبط اللُّكن الملاعين",67,"ن",1,0],["والحيّ بمأرب من سَبأٍ","أودى بهم سيلُ العَرِمِ",68,"م",1,0],["وَالحَيُّ مِن غَطفانَ قَد نَزَلوا","مِن عِزِّةٍ في شامِخٍ صَعبِ",69,"ب",1,0],["والحيَّةُ الصِلُّ أدهى كلما انبعثت","من أنْ تمارسها الأرْمَاح والقضب",70,"ب",1,0],["والحي شبك حال دون حماهم","حلق الحديد وكل اجرد ضامر",71,"ر",1,0],["والحي مَعن حَزر كل مطرد","ورثوا المكارم كبراً عن كابر",71,"ر",1,0],["والحيّة الصماء في جحرها","والتنفل الرائغ والذرُ",72,"ر",1,0],["وَالحَيُّ عُرْضَةُ كُلّ سَهْمٍ صَائِبِ","وَمَصَائِبُ الدُّنيَا عَلَى أجْنَاسِ",73,"س",1,0],["وآل حير الخلق خير آل","من خلطوا الحب بالمعالي",74,"ي",1,0],["والحيد والكشحان منك وما حوت","منك المآزر والخلاخل مرهم",75,"م",1,0],["والحيا كلما سقى الأرض ريّاً","لذَّ لي من مشعشع الراح ربِّي",76,"ي",1,0],["وَالحَيُّ يَتلُوهُ فأوصَافُ الكَمَا","لِ هُمَا لأفقِ سَمَائِهَا قُطبَانِ",77,"ن",1,0],["وَالحِيرَةُ البَيضاءُ بُدِّلَ أنسُها","قَدَرٌ أَطاعَتهُ مَدائِنُ فارِسِ",78,"س",1,0],["والحيوان المسالم","يسرح في مأمن وأنس",79,"س",1,0],["والحيُّ من غَطفانَ قد نزَلُوا","مِنْ غزةٍ في شامخٍ صَعْبِ",80,"ب",1,0],["والحي يألم من وخز المقال ولا","تضني المضارب لحم الميت النخر",81,"ر",1,0],["والحي مع باب وراشدها كذا","وعمود خالد ثم راس الدهنة",82,"ه",1,0],["وَالحَيُّ قَحطانُ قِدماً ما يَزالُ لَها","مِنّا وَقائِعُ مِن قَتلٍ وَتَعذيبِ",83,"ب",1,0],["والحيُّ قد هبطت خيا","مهم وقعقعت العماد",84,"د",1,0],["وَالحَيُّ عِندَ القَيسِ حَيثُ اِنتَووا","مَن سَعفِ البَحرَينِ وَالساحِلِ",85,"ل",1,0],["وَالحَيضُ وَالنُفساءُ أَصلٌ واحِدٌ","عِندَ اِنقطاعِ الدَمِ يَغتَسِلانِ",86,"ن",1,0],["وَالحيّ في الأَحيا غَريبٌ راحلٌ","لا يَستقرّ مقرّه في قَبره",87,"ر",2,0],["وَالحَيُّ يَومَ أُشَيٍّ إِذ أَلَمَّ بِهِم","يَومٌ مِنَ الدَهرِ إِنَّ الدَهرَ مَرّارُ",88,"ر",1,0],["والحيّ يسقم أحيانا وأنت على","أتم عافية لا تعرف السقما",89,"م",2,0],["والحيِّ والقيُّومِ والكبيرِ","والحَكَمِ السَّميعِ والبصيرِ",90,"ر",1,0],["وَالحَيُّ مِن كَلبٍ وَجَرمٍ كُلُّها","بِالقاعِ يَومَ يَحُثُّها الجَلدُ",91,"د",1,0],["وَالحَيَّةُ البَيضاءُ بل","لاعَةُ سِحرِ مَن سَحَر",92,"ر",1,0],["والحيّ فيه الفتاة ترمقُني","حتى مضى شأو ذاك فانقطعا",93,"ع",2,0],["والحيا من راحتيه اغترفا","فسقى الأرض بغيث هتن",94,"ن",1,0],["والحي من رجس الرقيب مطهر","تطهير أهل البيت في القرآن",95,"ن",1,0],["والحي حيا بالحبيب وقربه","حيث الرقيب قضى كئيبا مبعدا",96,"د",2,0],["والحي من دنس الرقي","ب مطهر للإنس معتد",97,"د",1,0],["والحي اشرق والمطالع اعربت","عن يمن اقبال الغلام الانجب",98,"ب",1,0],["والحيُّ شمسُ الأفقِ تخبأ وجهها","منه حياءً من شموسِ خبائهِ",99,"ا",3,0],["وَأَلَحَّ يَكسو الأُكمَ وابِلُهُ","بِصَدى مِنَ الأَعباءِ يُقلِعُهُ",100,"ع",2,0],["والحيُّ قد جعلو