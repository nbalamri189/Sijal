{"poems":[[95,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[53,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[80,"غربان أغمات لا تعدمن طيبة","https://www.aldiwan.net/poem14231.html","البسيط"],[51,"والله والله ما أبالي متى","https://www.aldiwan.net/poem64195.html","المنسرح"],[33,"يا صاح هل تدري وقد جمدت","https://www.aldiwan.net/poem42572.html","الكامل"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[52,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[80,"","https://poetry.dctabudhabi.ae/diwan/poem/44491","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/3032","البسيط"],[80,"غربانَ أَغماتَ لا تَعدَمْنَ طَيّبةً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86947&r=&rc=154",""],[151,"سرح سوادك والطروس سماء","https://www.aldiwan.net/poem47634.html","الكامل"],[164,"رضاك عني رضا الباري به قرنا","https://www.aldiwan.net/poem58662.html","البسيط"],[164,"ظهرت عجائب قدرة الرحمن","https://www.aldiwan.net/poem59156.html","الكامل"],[164,"إني أعيذ علاك يا برقوق","https://www.aldiwan.net/poem59191.html","الكامل"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[276,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[325,"عاد العزيز فاهلا","https://www.aldiwan.net/poem67227.html","المجتث"],[366,"سمحت بالوصل بعد الهجر يا حسن","https://www.aldiwan.net/poem68047.html","البسيط"],[398,"يا أصفهان سقيت الغيث من كثب","https://www.aldiwan.net/poem53397.html","البسيط"],[398,"يا زائرا سائرا إلى طوس","https://www.aldiwan.net/poem53675.html","المنسرح"],[409,"ذبحت نفسك لكن لا بسكين","https://www.aldiwan.net/poem33379.html","البسيط"],[409,"عذرا إلى مولاي عذرا","https://www.aldiwan.net/poem33927.html","مجزوء الكامل"],[427,"ركبت بحرا من الدموع","https://www.aldiwan.net/poem46373.html","مخلع البسيط"],[438,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[457,"حيا الصبا ونعيمه","https://www.aldiwan.net/poem13621.html","مجزوء الكامل"],[518,"أتذكر اليوم ما لاقيت من كمد","https://www.aldiwan.net/poem67748.html","البسيط"],[563,"ريح التجلي وريح المصطفى ريحان","https://www.aldiwan.net/poem33720.html","المواليا"],[563,"الناس موصوفون بالأفعال","https://www.aldiwan.net/poem34198.html","الرجز"],[563,"والله والله ما هذا وجود الرب","https://www.aldiwan.net/poem34929.html","المواليا"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/107327","السريع"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54079","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39001","البسيط"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104483","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77520","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123360","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62668","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120087","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59310","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59311","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96736","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111289","الخفيف"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69220","الكامل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124410",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108978","البسيط"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26445","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87840","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125466","البسيط"],[2063,"","https://poetry.dctabudhabi.ae/diwan/poem/203937","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143198","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91944","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85183","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114530","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114058","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125799","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94768","البسيط"],[4407,"","https://poetry.dctabudhabi.ae/diwan/poem/203759","المجتث"],[4728,"يا غريب","https://www.poetsgate.com/ViewPoem.aspx?id=176951",""],[4858,"إلى ولدي الحبيب الدّكتور محمّد","https://www.poetsgate.com/ViewPoem.aspx?id=30638",""],[4859,"دثار الروح","https://www.poetsgate.com/ViewPoem.aspx?id=194793",""],[4988,"دامك أخو","https://www.poetsgate.com/ViewPoem.aspx?id=180735",""],[4988,"ريق الفخر يحتاج كفواً يبّله","https://www.poetsgate.com/ViewPoem.aspx?id=180840",""],[4988,"نزوحي .. نكهة الحاظر وعبق الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=182912",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5039,"بعض الحكي","https://www.poetsgate.com/ViewPoem.aspx?id=48122",""],[5055,"صفوف الظل","https://www.poetsgate.com/ViewPoem.aspx?id=101655",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5170,"96 جمعة","https://www.poetsgate.com/ViewPoem.aspx?id=176489",""],[5277,"قصارى القول..في رسول الله صلى الله عليه وآلهِ وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=212991",""],[5411,"هوَ ذاكَ أنْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=204689",""],[5443,"جنَّة الدُّنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185139",""],[5573,"ماجور باذن الله يا طيب الفال","https://www.poetsgate.com/ViewPoem.aspx?id=200105",""],[5582,"ما بالُ وُرْقِ الغَضَا تَشْدُو بِأَلْحانِ","https://www.poetsgate.com/ViewPoem.aspx?id=187313",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5648,"زود الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=157232",""],[5653,"يا شَاكِيَ الرَّمَدِ الذي بِشَكَاتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=26395",""],[5664,"مُمكنه","https://www.poetsgate.com/ViewPoem.aspx?id=46531",""],[4623,"للحب تبدو وان تخفى علامات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146688",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5950,"ياسيد الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=126263",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""]],"verses":[["وَاللهُ وَفَّقَكُمْ فَكَانَتْ نُصْرَةً","شَهِدَتْ لَكُمْ بِجَلالِهَا الأَقْوَامُ",0,"م",1,0],["واللّه واقيهِ الردى ومُسَهِّلٌ","ما قد رجا ومذَلِّلٌ ما استصعبا",1,"ب",2,0],["واللهوَ، والحسناءَ، والوترَ","المُرنّحَ، والغِنا",2,"ن",2,0],["واللهوُ والعَبَثُ البريءُ","الحلوُ مطمحُنا الأَخيرْ",3,"ر",1,0],["وَاللَهِ وَاللهِ لا نفَّرتُ اقعَها","وَلا تَطَيَّرَتِ الغِربانُ بِالعوَرِ",4,"ر",1,0],["وَاللَهِ وَاللَهِ ما أُبالي مَتى","ما مِتُّ يا سَلمُ بَعدَ ذا السَفَرِ",5,"ر",1,1],["وَاللَهِ وَالبَيتِ العَتيقِ لَقَد","ساوَيتِ عِندي جَنَّةَ الخُلدِ",6,"د",1,0],["وَاللَهِ وَاللَهِ رَبّي","أَقولُهُنَّ دِراكا",7,"ك",2,0],["وَاللَهِ وَاللَهِ ما أَنامُ وَلا","أَملِكُ عَيني دُموعَها طَرِبا",8,"ب",2,0],["وَاللَهِ وَاللهِ لا نفَّرتُ واقعَها","وَلا تَطَيَّرَتِ الغِربانُ بِالعوَرِ",9,"ر",1,0],["وَاللَهُ وَاللَهُ رَبّي المُستَغاثُ بِهِ","وَاللَهُ رَبّي بِهِ حَولي وَقُوَّتِيَه",10,"ت",3,0],["وَاللَهِ وَاللهِ لا نفَّرتُ واقعَها","وَلا تَطَيَّرَتِ للغِربان بِالعوَرِ",11,"ر",1,0],["واللّه ودّهم وأعطاهم حمى","سرّا علاه للسماك سماء",12,"ا",2,0],["والله والله لو قطعتني قطعاً","ما ازددت إلا ودادا خالصاً وثنا",13,"ن",2,0],["والله والله العظيم إلية","منى هي العظمى من الإِيمان",14,"ن",1,0],["والله والله العظيم قسامة","والله يعمل أنّني لصدوق",15,"ق",1,0],["وَاللَّهِ واللَّهِ لولا اللَّهُ يضللُ مَن","يشاءُ مِن خلقهِ فيما يريد بهِ",16,"ب",2,0],["واللهِ واللهِ لو كنّا ذوي أنفٍ","لما ترَكنا جداراً غيرَ مُنهدِم",17,"م",1,0],["وَاللهو ديني وَدار الظاعنين الى","دارى وَفي الحمى أَعمامي وَأَخوالي",18,"ل",2,0],["وَاللَهُ واقيهِ دَوماً","في رِحلَةِ وَمَقامِ",19,"م",1,0],["وَاللَه وَاللَه يا نور العُيونِ لَقَد","أَحيَيت مني فَؤادا كله شَجن",20,"ن",1,0],["وَاللَهِ وَاللَهِ لا أُنسِيتُ بِرَّكِ بي","وَلَو تَمَكَّنتُ من أَقصى خراسانِ",21,"ن",1,0],["وَاللَهِ وَاللَهِ حلفةً صَدَرَت","عَن مُخلِصٍ في الوَلاءِ مَغموسِ",22,"س",1,0],["واللّه وصى به في الذكر في سور","كم في الحواميم منه والطواسين",23,"ن",1,0],["والله والله العظي","م مؤكداً قسمي مبرا",24,"ر",2,0],["واللَه واللَه ما سقاني","كاس الردى غيرُ هجرِكم",25,"م",1,0],["واللهوُ خِدْنُ الصِّبا فمُذْ فُقِدَتْ","أَيامُه لم يكن بمحمودِ",26,"د",1,0],["واللهوُ مُقتِربُ الجنا","والعودُ مُقتَرِنٌ بنائه",27,"ا",3,0],["واللَه واللَه لا تشمت أعاديه","فالصفح أجمل بالمولى إذا قدرا",28,"ر",2,0],["والله والله يا عبد الهدى ريحانْ","أنت المقربْ وأنت الروح والريحانْ",29,"ن",1,0],["والله وحده هو المظهر لا","سواه في الماضي والإستقبال",30,"ل",1,0],["والله والله ما هذا وجود الربْ","فإنه من يقل هذا طغى في السبْ",31,"ب",1,1],["واللَهُ والمختارُ حضّا على","قَبُولِ مَن جاءَ مِنَ التائِبين",32,"ن",1,0],["والله والله لو بيعت حياتهما","بالروح أبذل فيها ما غلا الثمن",33,"ن",1,0],["وَاللَّهِ واللَّهِ هَذا لا نَظير لَهُ","وَإِنّني في يَميني صادِق قسَما",34,"م",2,0],["واللَه واللَه هذا عين مطلبهم","لا غيره ألف لا واللَه واللَه",35,"ه",1,0],["وَاللَه وَاللَه وَرَبِّ العَظمه","وَمن تَجَلّى للكليم كلَّمه",36,"ه",1,0],["والله ولو كانت الدنيا بأجمعها","تبقي علينا ويأتي رزقها رغدا",37,"د",2,1],["والله وَحِّدهُ ولا تعدل به","شيئاً تعالى الله من مُعادِلِ",38,"ل",1,0],["واللهو أعدل عادل","فينا وساقي الراح جائز",39,"ز",1,0],["وَاللَّهِ وَاللَّهِ وَاللَّهِ العَظِيمِ وَمَنْ","أنْشَا البَرِيَّةَ مِنْ طِينٍ وَأوْجَدهَا",40,"ه",2,1],["والله والله يا حبيبي","لا حلت عن حالة الوداد",41,"د",1,0],["وَاللَّهِ وَاللَّهِ وَاللَّهِ العَظِيمِ وَمَنْ","أنْشَا البريُّةَ مِنْ طِينٍ وَأنْشَاهَا",42,"ه",2,1],["والله والذكر الحكيم وما حوى","من آية غرا وقول فيصل",43,"ل",1,0],["وَاللّه واللّه إنّي لست مرتدعاً","عَنها ولو بدّلت وصلي بهجرانِ",44,"ن",1,0],["والله والله الذي أنشاكم","ثم على أقدامكم أمشاكم",45,"م",1,0],["واللَه والاملاك أدرى بما","قد قلته والناس طراً شهود",46,"د",1,0],["وَاللَهوُ يُحسِن بِالفَتى","ما لَم يَكُن شيبٌ يَشينه",47,"ن",2,0],["والله والله ذو مَنٍّ وَمَغفِرة","لثمَّ شَيء في الأخرى غَيرُ مَعلوم",48,"م",1,0],["واللَه واللَه ما لي بالبقا أربٌ","لكن بقيت لأقضي بالبكا وطري",49,"ر",2,0],["وَاللَّه وَاللَّه لَهَذا الفَتى","كانَ لِزازَ الزَمَنِ المُمحِل",50,"ل",1,0],["وَاللَهوُ يُلحِقُ مَغبوقاً بِمُصطَبِحٍ","وَالدَورُ سِيّانِ مَحثوثٌ وَمُنتَخَبُ",51,"ب",1,0],["وَاللَهوُ شَتّى وَالمُنى تَفتَرُّ لي","وَتَضُمُّ إِصباحي إِلى إِغلاسي",52,"س",2,0],["واللَّهوُ كالشهدِ حلوٌ في مذاقتِهِ","وأيُّ سُمٍّ ثَوَى في ذلكَ الشَّهَدِ",53,"د",1,0],["والله والله ثم الله ثالثةً","ما قصّر البين في قتلي ولا تركا",54,"ك",2,0],["واللهو خف عليهم ولما رأوا","ما فيه من طرب ومن ألحان",55,"ن",1,0],["والله والله إن التاركيه عَمُوا","عن شافياتٍ عِظِاتٍ كلّها سَدَدُ",56,"د",1,0],["وَاللهِ واللهِ لولا ضيقُ قَافِيَتي","فَصَّلتُهَا فعلى الأخنَانِ تفصيلُ",57,"ل",1,0],["وَاللَه واعِدُهم عزاً وَمنجزهم","شاكي السلاح لهم سيما تميزهم",58,"م",1,0],["والله والرحمن لا يسمى","بها سوى الله اختصاصا حتما",59,"م",2,0],["وَاللَه وَاللَه إِنّ الناس لَو صدقوا","لأسرعوا لعَوادي الدَهر وَاستبقوا",60,"ق",3,1],["واللَه واللَه إن حالي","يرق من عظمه الحسود",61,"د",1,0],["واللَهِ واللَهِ لو أن المشيئةَ لي","ما كُنتُ إنساناً او ما كُنتُ مخلوقا",62,"ق",2,0],["وَاللهِ وَاللهِ العَظِيمِ وَلَو","لاَ أن تَمَلَّ لَمَا أتمَمتُ إِملاَءَ",63,"ا",2,0],["والله ولاك ثم السيف فالتأمت","بك الفلول وأضحى الشمل ملتئما",64,"م",2,0],["واللَه واللَه لو كانت إذا بَرَزَت","نفس المُتَيَّم في يَدّيهِ ألقاها",65,"ه",2,0],["والله والله ربي","وتلك أقصى يميني",66,"ي",1,1],["والله واعرف المهلهل ما يخلّي كليب","وإلا انت خلّيت من دون الصواب الصواب",67,"ب",1,0],["والله وفّق للهدى أحبابه","فعساك يا حبّي تنال مّناكا",68,"ك",2,0],["واللهِ واللهِ لو تحكيْ محاجرُنا","عنِ الغرامِ لأمسى دمعُها غزلا",69,"ل",2,0],["والله واللي نعبده يالخوي / طوع","ماا طاح قدرك ياا بعيد الهقاوي",70,"ا",3,0],["والله ورب البيت ما ضيقي فلوس","رغم الفقر قانع ومشكاي ‫#‏لله‬",71,"ل",2,0],["والله واللي تجري آ بأمره الريح","مآ تستوي للطيب كفّ الشّحوحي",72,"ح",2,0],["والله والله طور الجسم دك فيا","عذالي لا تكثروا لم يجد الحائي",73,"ا",2,0],["والله وخطت شوارب جرحي الثاني","والجرح الأول نبت له لحيه وشابت",74,"ت",1,1],["والله وسنان العوالي على القرْب","مدام ضبح الخيل سرج الشفاعه",75,"ع",2,0],["والله والله ما سواه لنا","من مرددٍ لا إله إلا الله",76,"ل",2,0],["والله والله لا محيد لنا","عن بابه لا إله إلا الله",76,"ل",2,0],["والله والله مالنا مدد","من غيره لا إله إلا الله",76,"ل",2,0],["والله.. والله.. لولا الجاه والسِمعه","مسكنك دار(ن) عثره الوقت يمنعني ،",77,"ن",2,0],["واللهُ واصفُهُ ... واللهُ مادحُهُ","واللهُ أرسلَهُ بالهديِ للأممِ",78,"م",1,0],["واللهِ واللهِ الَّذي جَعْلَ المَوَّدَةَ","بَيْنَنا لا لَنْ أُغَيِّرَ مَوْقِفي...",79,"ف",2,1],["واللهِ واللهِ أَيْمانًا أصيحُ بها","لا والَّذي نزَّل القرآنَ تنزيلا",80,"ل",2,0],["والله وهبك الصبر في بحر الاهوال","وانت الذرى لاهب فالوقت معصير",81,"ر",1,0],["واللهِ واللهِ إِنِّي لَسْتُ مُرْتَدِعاً","عَنْها وَلَو بَدَّلَتْ وَصْلِي بِهِجْرانِي",82,"ن",2,0],["وَاللهِ وَاللهِ ما مِنْ بَعْدِ رِحْلَتِها","جَفْنِي اسْتَلَذَّ الكَرَى يَوْماً وَلا طَعِمَا",83,"م",2,0],["والله .. والله ماعكه","ولاني من اجناس تعميها",84,"ي",3,0],["والله والإشفاق يعلم أنني","لو أستطيع فدى لكنت لك الفدا",85,"د",2,0],["والله والله من تطري وسط عمر الاحزان","كل الفرح من لون 