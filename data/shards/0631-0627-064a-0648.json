{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[87,"رأى وجهه باردا جامدا","https://www.aldiwan.net/poem7552.html","المتقارب"],[63,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[147,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[159,"ومستنطق بالدمع عن أعين خرس","https://www.aldiwan.net/poem55651.html","الطويل"],[215,"مليح له المرآة أخت حبيبة","https://www.aldiwan.net/poem46298.html","الطويل"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[411,"إذا استشرت امرأ فاسبر له أبدا","https://www.aldiwan.net/poem49375.html","البسيط"],[463,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[466,"وصوب حيا جاشت غوارب سيبه","https://www.aldiwan.net/poem16396.html","الطويل"],[469,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[473,"رأى وجدي به فزها وصدا","https://www.aldiwan.net/poem60161.html","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77641","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145113","المجتث"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27863","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60871","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111275","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63030","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62822","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111396","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66101","البسيط"],[4767,"الأتست (قسم اعتماد الصرف)","https://www.poetsgate.com/ViewPoem.aspx?id=88157",""],[4811,"الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=198335",""],[161,"وَجهُ المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=204621",""]],"verses":[["رَأى وَرَقَ البيضِ الخِفافِ هَشائِماً","وَشَوكَ العَوالي ناسِلاً أَو مُنَزَّعا",0,"ع",2,0],["رأى وجهه باردا جامدا","فراح يسنّ عليه الجلم",1,"م",1,1],["رأى وجهَ العُلى حَسَناً جَميلا","فأصبحَ بالعُلى صبّاً عَميدا",2,"د",2,0],["رَأيٌ وَعَزمٌ مَضى حَدّاهُما فَنَبا","حَدُّ الخُطوبِ الَّتي قارَعتَها بِهِما",3,"م",2,0],["رَأى وَجْهَ مَنْ يَهْوى فَداخَلَ قَلْبَهُ","سُرُورٌ بهِ أَرْواهُ عَنْ فَرَحِ النَّفْسِ",4,"س",1,0],["رأى وجهه فيها جميلاً ورائعاً","فأمسى وفي الأحشاء منه غليلُ",5,"ل",1,0],["رأى وجهه رأى الخيال فشاقه","وأمسى بأحلام الخيال يصول",5,"ل",1,0],["رَأيٌ وَحَزمٌ ظاهِرُ سَدادُهُ","إِذا قَضى بِفَيصَلٍ في مَشهَدِ",6,"د",1,0],["رأيٌ وثيقٌ وإخلاصٌ ومعرفةٌ","بجُلِّ أحوالكَ اللاّتي تقاسيها",7,"ه",2,0],["رأى ودَّها طللا ممحِلا","فلفَّق ما شاء أن يَمحَلا",8,"ل",2,0],["رأى وَصَباً في الحالِ تكْتُمُهُ العُلى","فأخفى أساهُ بالنَّدى فِعْلَ حاذِقِ",9,"ق",1,0],["رأى وقفةَ البين خطباً فطيعاً","تذيب القلوبَ فتجري دموعاً",10,"ع",2,1],["رَأى وَجدي بِهِ فَزَها وَصَدّا","حَبيبٌ لي أُحِبُّ رِضاهُ جِدّا",11,"د",2,1],["رَأى وَزيراً في الجِنان في مَقَرّ","وَزاهِداً رَآه في نار سَقَر",12,"ر",1,0],["رأي وعقل وفهم","يتلو جلي جليّا",13,"ل",3,0],["رأى ورأوا فسد وما أصابوا","وأيقظ حزمه وجثوا نياما",14,"م",2,0],["رأى وجود الحق عين الذي","يطلبه في وحدة الكثر",15,"ر",1,0],["رأى وَمْضَ البريق فلا مناماً","وعاجَ على الطلولِ فلا براحا",16,"ح",2,0],["رأى وهن أركان المعالي فشادها","ولولاه كادت ان تؤول إلى الهدم",17,"م",1,0],["رَأَى وَجهَ من أَهوى عَذُولي فقالَ لي","أَرى وجهَ من تَهواه صار كَرِيهَا",18,"ه",2,1],["رأى ورقَ الأيّامِ ليس يَروقُني","فحاولَ وُدّي والنجيبُ نَجيبُ",19,"ب",1,0],["رَأى ورداً عَلى الوَجناتِ مِنهُ","مِن العُشّاقِ اِضحى في اِنتِهابِ",20,"ب",1,0],["رَاى وإِذا مِن جَنَّةِ الخُلدِ أُهبِطَت","أَثِينا وجَرَّتهُ بأَشعَارِهِ الشُّقرِ",21,"ر",1,0],["رأَى وما زاغَ منهُ الطَّرْفُ حينَ رأَى","بَعْضَ الجواميسِ يَمشي مَشْيَ مُنْظَلِمِ",22,"م",1,0],["رأى وجهاً به الآمال شعت","على من عنده عطفاً ولينا",23,"ن",2,0],["رأى وجه الحقيقةِ وجه ثكلى","وقد لاحت بوجهِ الثكلِ أمُ",24,"م",1,0],["رأى وَجْهًا تَمَنَّاهُ","على المرآةِ أغْرَاهُ",25,"ا",2,1]]}