{"poems":[[53,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[53,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[6,"ألا بان بالرهن الغداة الحبائب","https://www.aldiwan.net/poem383.html",""],[9,"يظن الناس بالملكي","https://www.aldiwan.net/poem21983.html","مجزوء الوافر"],[24,"صبحنا الحي حي بني جحاش","https://www.aldiwan.net/poem21861.html","الوافر"],[5,"ليجز الله من جشم بن بكر","https://www.aldiwan.net/poem278.html",""],[35,"ألم يحزنك يوم غدت حدوج","https://www.aldiwan.net/poem39174.html","الوافر"],[93,"يا ترب عصرك بيتي","https://www.aldiwan.net/poem11464.html","المجتث"],[30,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"أجمعت عمرة صرما فابتكر","https://www.aldiwan.net/poem21419.html","الرمل"],[23,"نصرنا رسول الله والدين عنوة","https://www.aldiwan.net/poem21586.html","الطويل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[29,"أعاذل نعم قوم الحرب قومي","https://www.aldiwan.net/poem6078.html","الوافر"],[29,"لعمري لقد ناطت هوازن أمرها","https://www.aldiwan.net/poem6165.html","الطويل"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[32,"جذام سيوف الله في كل موطن","https://www.aldiwan.net/poem27725.html","الطويل"],[43,"لام أناس أبا العشائر في","https://www.aldiwan.net/poem9746.html","المنسرح"],[43,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[43,"مغاني الشعب طيبا في المغاني","https://www.aldiwan.net/poem10596.html","الوافر"],[62,"بضاعة هرمس مكنونة","https://www.aldiwan.net/poem52211.html","المتقارب"],[45,"دموع عليها السكب ضربة لازم","https://www.aldiwan.net/poem65662.html","الطويل"],[28,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[28,"ولما دعا الداعون وانشقت العصا","https://www.aldiwan.net/poem5324.html","الطويل"],[28,"لقد فرجت سيوف بني تميم","https://www.aldiwan.net/poem5358.html","الوافر"],[61,"طوى الشوق لولا بارق يتألق","https://www.aldiwan.net/poem51510.html","الطويل"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[69,"من قال بالمرد فاحذر إن تصاحبه","https://www.aldiwan.net/poem28769.html","البسيط"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[52,"مر عيش علي قد كان لذا","https://www.aldiwan.net/poem27057.html","الخفيف"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[7,"كليني لهم يا أميمة ناصب","https://www.aldiwan.net/poem2017.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10206","الوافر"],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[32,"جذامُ سيوفُ اللهِ في كلّ موطنٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=16002",""],[6,"أَلاَبَانَ بالرَّهْنِ الغَدَاة َ الحَبَائِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14188&r=&rc=3",""],[113,"كل من لاذ بقطب الكون احمد","https://www.aldiwan.net/poem41149.html","عموديه"],[113,"سيدنا الشيخ على الخزام","https://www.aldiwan.net/poem41756.html","السريع"],[126,"مهما جرى حين مل الوصل مت هوى","https://www.aldiwan.net/poem50590.html","البسيط"],[130,"وخود راق منها ما تراه","https://www.aldiwan.net/poem54691.html","الوافر"],[132,"منعنا الرسول رسول المليك","https://www.aldiwan.net/poem21021.html","المتقارب"],[132,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[158,"مقامي تحت ظل الذل عار","https://www.aldiwan.net/poem58760.html","الوافر"],[158,"بكيت لأخفى بالدموع السوافح","https://www.aldiwan.net/poem58950.html","الطويل"],[193,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[197,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[216,"نأتك سليمى دارها لا تزورها","https://www.aldiwan.net/poem401.html",""],[220,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[233,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[235,"هنيئا هنيئا بعدما عز مهنأ","https://www.aldiwan.net/poem18032.html","الطويل"],[247,"أمسى سمير قد بان فانقطعا","https://www.aldiwan.net/poem2108.html","المنسرح"],[257,"عند قطب التصريف طولا وعرضا","https://www.aldiwan.net/poem35966.html","الخفيف"],[268,"سبحت في الماء كالبط","https://www.aldiwan.net/poem35271.html","المديد"],[268,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[269,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[280,"هنيئا أيها الملك المعظم","https://www.aldiwan.net/poem32628.html","الوافر"],[280,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[282,"يا قاضي البصرة ذا الوجه الأغر","https://www.aldiwan.net/poem44296.html","الرجز"],[301,"بعثت مثالا ما ظفرت بمثله","https://www.aldiwan.net/poem57661.html","الطويل"],[302,"ونبي الحمى من جانب الغور أبرقا","https://www.aldiwan.net/poem16872.html","الطويل"],[303,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[303,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[361,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[363,"أفاطم لو شهدت ببطن خبت","https://www.aldiwan.net/poem44361.html","الوافر"],[400,"بلد ما أقول فيها وقد","https://www.aldiwan.net/poem33911.html","الخفيف"],[403,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[413,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[416,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[426,"هذي الديار ديار بيت الدين","https://www.aldiwan.net/poem40289.html","الكامل"],[426,"يا صاحبي من الملام دعاني","https://www.aldiwan.net/poem40502.html","الكامل"],[436,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[436,"بدا لك نجم السعد واطلع النجح","https://www.aldiwan.net/poem34791.html","الطويل"],[450,"بضاعة بئر بالمدينة قد حكى","https://www.aldiwan.net/poem13859.html","الطويل"],[462,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[472,"وفارس في غمار الموت منغمس","https://www.aldiwan.net/poem2156.html","البسيط"],[473,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[488,"أبي فارسُ الصرماء عمرُو بنُ مالكٍ","https://www.aldiwan.net/poem656.html",""],[493,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[498,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[527,"بضع وخمسون مرت","https://www.aldiwan.net/poem37072.html","المجتث"],[541,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[549,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[560,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[565,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[573,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"]],"verses":[["بِضائِعُ قَولٍ عِندَ غَيرِيَ رِبحُها","وَعِندِيَ خُسراناتُها وَالوَضائِعُ",0,"ع",1,0],["بِضَربٍ يَنثُرُ الشَفَراتِ حَتّى","لَها في كُلِّ جانِحَةٍ غِرارُ",1,"ر",1,0],["بِضَوامِرٍ مِثلِ النُسو","رِ وَغِلمَةٍ مِثلِ الصُقورِ",2,"ر",1,0],["بِضُمَّرٍ أَسقَطَها","عَليهِمُ مَعَ النَدى",3,"د",2,0],["بِضَربٍ كَما اِشتَرَطَتهُ السُيوفُ","وَطَعنٍ كَما اِقتَرَحَتهُ الكُعوبُ",4,"ب",1,0],["بضَرْبَةٍ رَعْلاءَ أو طَعْنَةٍ","تَخاوَصَتْ منها عُيونُ الجِراحْ",5,"ح",1,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِها","كضما ذيدَ عَن ماءِ الحِياضِ الغَرائِبُ",6,"ب",1,0],["بِضَربِهِمُ حَبيكَ البَي","ضِ حَتّى ثَلَّموا العَجَما",7,"م",2,0],["بِضَربٍ يُلقِحُ الضِبعانُ مِنهُ","طَروقَتَهُ وَيَأتَنِفُ السِفادا",8,"د",2,0],["بِضَربٍ تَشخَصُ الأَبصارُ مِنهُ","وَطَعنٍ مِثلِ أَفراغِ الدِلاءِ",9,"ا",2,0],["بِضاحي النَقبِ حينَ خَرَجنَ مِنهُ","وَخَلفَ مُتونِ ساقَتِها الخَليجُ",10,"ج",1,0],["بِضْعٌ وَتِسْعُونَ مَرَّتْ","مِنَ السِّنِينِ الطِّوَالِ",11,"ل",1,0],["بِضَربٍ وَطَعنٍ بِالرَماحِ كَأَنَّهُ","حَريقٌ جَرى في غابَةٍ يَتَسَعَّرُ",12,"ر",1,0],["بضّة فعمة لميس رداح","غادة أحوريّة بهنانه",13,"ن",2,0],["بِضَربَةِ فَيصَلٍ تَرَكَت رَئيساً","عَلى الخَدَّينِ يَنحَطُ غَيرَ نامِ",14,"م",1,0],["بضرب لا دواء له وطعن","ترى منه الأساة مولينا",15,"ن",2,0],["بضرب يتبع الألِلىّ منه","فتاة الحيَّ وسطهم الرنينا",15,"ن",2,0],["بِضَرب تُتبِعُ الأَلِليَّ مِنهُ","فَتاةُ الحَيِّ وَسطَهُمُ الرَّنِينَا",16,"ن",2,0],["بِضَربٍ لاَ كَفَاءَ لَهُ وطَعن","تُرَى منه الأُساةُ مُوَلوِلينَا",16,"ن",2,0],["بِضِرابٍ تَأذَنُ الجِنُّ لَهُ","وَطِعانٍ مِثلِ أَفواهِ الفُقُر",17,"ر",1,0],["بِضَربٍ كَإيزاغِ المَخاضِ مُشاشُهُ","وَطَعنٍ كَأَفواهِ اللِقاحِ السَوادِرِ",18,"ر",1,0],["بَضَّ لي من نداكَ قبل استقائي","بكَ ريِّي وفَضْلَةٌ للشريبِ",19,"ب",1,0],["بِضَربٍ يَقُضُّ البَيضَ شِدَّةُ وَقعِهِ","وَطَعنٍ كَرَكضِ الخَيلِ تُفلى مِهارُها",20,"ر",3,0],["بِضَربٍ لا كِفاءَ لَهُ وَطَعنٍ","كَأَفواهِ المَزادِ لَهُ شَرارُ",21,"ر",1,0],["بِضَربَةِ سَيفٍ أَو بِنَجلاءَ ثَرَّةٍ","إِذا نَشَجَت مَجَّت دِماءَ الأَباهِرِ",22,"ر",1,0],["بَضَّةُ الخَدَّين وَالنَهدَينِ ما","سَفَرَت إِلّا رَأَيتُ القَمَرا",23,"ر",2,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِهِ","وَطَعنٍ كَإيزاعِ المَخاضِ تُؤامِ",24,"م",1,0],["بِضَربِ هامِ الكُماةِ تَمَّ لَهُ","كَسبُ الَّذي يَكسِبونَ بِالمَلَقِ",25,"ق",1,0],["بِضَربٍ يَعُمُّهُمُ جائِرٍ","لَهُ فيهِمِ قِسمَةُ العادِلِ",26,"ل",1,0],["بِضَربٍ أَتى الهاماتِ وَالنَصرُ غائِبُ","وَصارَ إِلى اللَبّاتِ وَالنَصرُ قادِمُ",27,"م",1,0],["بِضَربٍ هاجَ أَطرابَ المَنايا","سِوى ضَربِ المَثالِثِ وَالمَثاني",28,"ن",2,0],["بضاعة هرمس مكنونة","وشركته مع أقرونسِ",29,"س",1,1],["بِضَربٍ يَشيدُ المَجدَ في كُلِّ مَوقِفٍ","وَيُسرِعُ في هَدمِ الطُلى وَالجَماجِمِ",30,"م",1,0],["بِضَربي بِسَيفي ساقَ كُلُّ سَمينَةٍ","وَتَعليقِ رَحلي ماشِياً غَيرَ راكِبِ",31,"ب",1,0],["بِضَربٍ يَزيلُ الهامَ عَن مُستَقَرِّهِ","وَطَعنٍ بِأَطرافِ الرِماحِ الجَوائِفِ",32,"ف",1,0],["بِضَربٍ تَندُرُ القَصَراتُ فيهِ","وَطَعنٍ مِثلِ أَفواهِ النِهاقِ",33,"ق",1,0],["بِضَرْبٍ كَشَقِّ الأَتْحَميِّ تَرى له","جُيوبَ العَذارى في الخُدودِ تُمَزَّقُ",34,"ق",1,0],["بِضُمَّرٍ ما رَبَطناها مُسَوَّمَةً","إِلّا لِنَغزو بِها مَن باتَ يَغزونا",35,"ن",2,0],["بِضَربٍ تَرقُصُ الأَحشاءُ مِنهُ","وَتَبطُلُ مُهجَةُ البَطَلِ النَجيدِ",36,"د",1,0],["بضاعةٌ ما اشتراها غيرُ بائعها","بئسَ البضاعةُ والمبتاعُ والشاري",37,"ي",1,0],["بِضَجيج كَأَنَّهُ زَجل الرَع","دِ وَرَجف تَخاله زلزلا",38,"ل",2,0],["بِضَوءِ عَمُودِ الصُبحِ حَتّى كَأَنَّما","تَجَلّى عَمُودُ الصُبحِ يَوماً مُوَرَّدا",39,"د",2,0],["بِضَميرٍ لا لَهوَ فيهِ وَقَلبٍ","وَقَذَتهُ قَوارِعُ الدَهرِ وَقذا",40,"ذ",2,0],["بِضَرِمٍ يَمرَحُ في شِوارِهِ","في الحَلَقِ الصُفرِ وَفي أَسيارِهِ",41,"ر",2,0],["بِضَربٍ يَذوقُ المَوتَ مَن ذاقَ طَعمَهُ","وَتُدرِكُ مَن نَجّى الفِرارُ مَثالِبُه",42,"ب",2,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكِناتِهِ","وَطَعنٍ كَإيزاغِ المَخاضِ الضَوارِبِ",43,"ب",1,0],["بضَرْبَتَينِ لطُهْرِ الوَجهِ واحِدةٌ","وللذّراعينِ أُخرى ذاتُ إسراعِ",44,"ع",1,0],["بِضَمِيرٍ عَلى البَلاءِ نَقِيٍّ","وَفُؤَادِ عَلى المُصَابِ شَكُورِ",45,"ر",1,0],["بِضاعَةُ خاسِرٍ بارَت عَلَيهِ","فَباعَكَ بِالنَواةِ التَمرَتَينِ",46,"ن",1,0],["بضوء الدساتير استنارت ممالكٌ","تخبَّطُ في ليل من الجْهل مظلم",47,"م",1,0],["بضربٍ يُزيلُ الهَامَ عن سَكَناتِهِ،","وطعنٍ، كإيزاغِ المخاضِ تؤامِ",48,"م",1,0],["بِضَرْبٍ يُزِيلُ الهَامَ عَن سَكَنَاتِها","كما ذِيدَ عنْ ماءِ الحياضِ الغرائبُ",49,"ب",1,0],["بضعة الافراد من اهل العبا","اعظم الاقطاب اخلاقا واحمد",50,"د",1,0],["بضعة أصحاب العبا مرشد الوق","ت إمام القوم حلو الكلام",51,"م",1,0],["بضامرِى أبداً حب الحبيب ثوَى","قدّ الحشَا فغدا نَوَاكَ ملتبسَا",52,"س",2,0],["بَضِيرٌ بِالفُنُونِ وَمَا حَوَتهُ","ومِن حَوبِ الذُّنُوبِ وَقَاهُ فَاهُ",53,"ا",2,0],["بِضَربٍ يُذَبِّبُ دونَ النِهابِ","حذارَ الوَثائِرِ وَالخَنفَقيقِ",54,"ق",1,0],["بِضَربٍ تَرى الفِتيانَ فيهِ كَأَنَّهُم","ضَواري أُسودٍ فَوقَ لَحمٍ خَرادِلِ",55,"ل",1,0],["بضرب تسبحُ الآجال فيه","تطير إلى السمامنة الشَّرارُ",56,"ر",1,0],["بضائِعُنا المزجاةُ تنفقُ عندَه","وانفقها حوليه سوق المدائحِ",57,"ح",1,0],["بَضّاخَةٌ بِنَدى الذِفرى إِذا زُجِرَت","عاطَت خُزامَتُها الخَيشومَ وَاِختَضَعا",58,"ع",2,0],["بضرب هامات المغاوير عندهُ","أهنَّ حديد ام فهنَّ صخورُ",59,"ر",1,0],["بضربٍ يُزيلُ الهامَ عَن مُستَقَرِّهِ","وَطَعنٍ كإِيزاغِ المَخاضِ يَثورُها",60,"ر",3,0],["بضم رابع وربما كسر","لعلة تستوجب الذي ذكر",61,"ر",1,0],["بَضائِعُ الشِعرِ في سو","قِ فَضلِهِ لا تَبورُ",62,"ر",1,0],["بِضَوْءِ طُلوعِ الشمسِ بعْدَ غُروبِهَا","وَرَوْنَقِ صَقْلٍ لِلظُّبَى حِينَ تَصْدَأُ",63,"ا",1,0],["بِضَربَةٍ يَستَديرُ صاحِبُها","أَو طَعنَةٍ لَم تَكُن لَهُ بِدَعا",64,"ع",2,0],["بِضَجيعَي ضَريحِ رَوضَةِ مَثوا","كَ وَزَهرا العَلاءِ بِنتُكَ مَحضا",65,"ض",2,0],["بَضَّةٌ بيضاءُ حِلَّتُها","أبيضُ الرِّيشِ على البطِّ",66,"ط",1,0],["بضيقِ الذَّرعِ مِنكِ أضيقُ ذرعاً","فأَخفي ما يوَسوسُ أو فجودي",67,"د",2,0],["بضرب تَلبيه الجَماجم وَالطلا","وَطعن ذبالات الحشام منه تسرج",68,"ج",1,0],["بِضَمِّ أَحِبَّةٍ وَبِفَتحِ ثَغرٍ","وَكَسرِ عِدىً وَوَقفٍ فَهوَ مُحكَم",69,"م",1,0],["بِضيقِ جُفونِهِ وَسَّعتُ عُذري","فَزالَ العُذرُ عَنّي وَالمَلامُ",70,"م",1,0],["بِضَربٍ بِالدَفِّ وَإِن شاءَ زَمَر","فَأَطردهُ عَنّي بِدَقيقٍ يَنتَظِر",71,"ر",1,0],["بضائعه تجلو على نفائسا","ولست على هذا لها بزبون",72,"ن",1,0],["بضعف وذنب والذنوب موانع","عن الخير فاتركها لتنجو من الشقا",73,"ق",2,0],["بِضربةِ فيصلٍ تركتهُ شفعاً","وَشقّاهُ لقىً بطناً وظهرا",74,"ر",2,0],["بضعةٌ منك عجّلت لجنان ال","خلدِ قبل اِقتبال سنّ الشبابِ",75,"ب",1,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِهِ","وَيَنقَعُ مِن هامِ الرِجالِ بِمَشرَبِ",76,"ب",1,0],["بضربةِ فَيصَلٍ تركتهُ شَفعاً","وكان كأنَّهُ الجُلمودُ وِترا",77,"ر",2,0],["بضيا حَبْرِها الذي حل فيها","وتلقتْ علومَهُ الأحبارُ",78,"ر",1,0],["بَضَربٍ يَطير البَيضُ مِن حَرِّ وَقعِهِ","شَعاعاً كَما طارَ الشَرارُ عَن الجَمرِ",79,"ر",1,0],["بضعة السادات من أهل العبا","كوكب الإشراق تاج الأُمَرا",80,"ر",2,0],["بِضَربٍ يَفُضُّ الهامَ شِدَّةُ وَقعِهِ","وَوَخزٍ تَرى منه التَرائِبَ تَشخُبُ",81,"ب",1,0],["بضياءِ كوكب ربها بسمائها","أهدي الهناءَ لها كما تهديني",82,"ي",1,0],["بضياءِ طلعته وطلعة سعدهِ","داما لنا يتناشد القمرانِ",83,"ن",1,0],["بضائِعٌ لَكَ من بأسٍ ومن كَرَمٍ","محفوظَةٌ لكَ عند اللهِ مُدَّخَرَهْ",84,"ر",2,0],["بضائِعُهُمْ فِي مَتْجَرِ الحَرْبِ أَنْفُسٌ","رِضاكَ لَهَا فِي كُلِّ مَلْحَمَةٍ رِبْحُ",85,"ح",1,0],["بضاعةُ بئر بالمدينةِ قد حكى","بها المطرزيَّ الكسر لا غير فاعرفِ",86,"ف",1,1],["بضاعةُ مجدٍ ليس ينفكُّ سوقها","إذا جليت إلاَّ وجودك مربوح",87,"ح",1,0],["بضربة لم تكن مني مُخالَسةً","ولا تعجَّلتُها جُبنا ولا فَرقا",88,"ق",2,0],["بِضَربٍ في الجَماجِمُ ذي فُروغٍ","وَطَعنٍ مِثلِ تَعطيطِ الرِهاطِ",89,"ط",1,0],["بِضَربٍ يُطيرُ الهامَ عَن سَكِناتِهِ","وَإِصرادِ طَعنٍ وَالقَنا مُتَشاجِرُ",90,"ر",1,0],["بضرب البم تختمه","ونقر الزير تفتتح",91,"ح",1,0],["بضاعَتُهُ جهلٌ أَضرَّتْ بدينِهِ","ونحن كما يدري بِضاعَتُنا العلْمُ",92,"م",1,0],["بِضْعُ وخَمْسُونَ مَرَّتْ","عَلَيْكَ يا بْنَ عَلِيِّ",93,"ي",1,1],["بضَربٍ فيه تأثِيمٌ","وتفجيعٌ وارنانُ",94,"ن",1,0],["بِضَربٍ كَما اِختارَتْ شِفارُ مَناصِلٍ","وطعنٍ كما شاء الكَمِيُّ المداعسُ",95,"س",1,0],["بِضاعةٌ عندَ أهلِ الفضلِ رائجةٌ","وإنْ رَماها ذوُو بخْسٍ بإكسادِ",96,"د",1,0],["بِضَرْبٍ كما انْقَدّ جَيْبُ القميص","وَطَعْنٍ كما انحلّ عقدُ السِّقاءِ",97,"ا",2,0],["بضربٍ يذيبُ الشمسَ في الأُفق حرُّه","ويَحْرِقُ ما بَيْن القُلوبِ من الشَّحْنا",98,"ن",2,0]]}