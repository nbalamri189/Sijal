.html","الطويل"],[43,"لام أناس أبا العشائر في","https://www.aldiwan.net/poem9746.html","المنسرح"],[43,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[43,"مغاني الشعب طيبا في المغاني","https://www.aldiwan.net/poem10596.html","الوافر"],[62,"بضاعة هرمس مكنونة","https://www.aldiwan.net/poem52211.html","المتقارب"],[45,"دموع عليها السكب ضربة لازم","https://www.aldiwan.net/poem65662.html","الطويل"],[28,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[28,"ولما دعا الداعون وانشقت العصا","https://www.aldiwan.net/poem5324.html","الطويل"],[28,"لقد فرجت سيوف بني تميم","https://www.aldiwan.net/poem5358.html","الوافر"],[61,"طوى الشوق لولا بارق يتألق","https://www.aldiwan.net/poem51510.html","الطويل"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[69,"من قال بالمرد فاحذر إن تصاحبه","https://www.aldiwan.net/poem28769.html","البسيط"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[52,"مر عيش علي قد كان لذا","https://www.aldiwan.net/poem27057.html","الخفيف"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[7,"كليني لهم يا أميمة ناصب","https://www.aldiwan.net/poem2017.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10206","الوافر"],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[32,"جذامُ سيوفُ اللهِ في كلّ موطنٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=16002",""],[6,"أَلاَبَانَ بالرَّهْنِ الغَدَاة َ الحَبَائِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14188&r=&rc=3",""]],"verses":[["بِضائِعُ قَولٍ عِندَ غَيرِيَ رِبحُها","وَعِندِيَ خُسراناتُها وَالوَضائِعُ",0,"ع",1,0],["بِضَربٍ يَنثُرُ الشَفَراتِ حَتّى","لَها في كُلِّ جانِحَةٍ غِرارُ",1,"ر",1,0],["بِضَوامِرٍ مِثلِ النُسو","رِ وَغِلمَةٍ مِثلِ الصُقورِ",2,"ر",1,0],["بِضُمَّرٍ أَسقَطَها","عَليهِمُ مَعَ النَدى",3,"د",2,0],["بِضَربٍ كَما اِشتَرَطَتهُ السُيوفُ","وَطَعنٍ كَما اِقتَرَحَتهُ الكُعوبُ",4,"ب",1,0],["بضَرْبَةٍ رَعْلاءَ أو طَعْنَةٍ","تَخاوَصَتْ منها عُيونُ الجِراحْ",5,"ح",1,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِها","كضما ذيدَ عَن ماءِ الحِياضِ الغَرائِبُ",6,"ب",1,0],["بِضَربِهِمُ حَبيكَ البَي","ضِ حَتّى ثَلَّموا العَجَما",7,"م",2,0],["بِضَربٍ يُلقِحُ الضِبعانُ مِنهُ","طَروقَتَهُ وَيَأتَنِفُ السِفادا",8,"د",2,0],["بِضَربٍ تَشخَصُ الأَبصارُ مِنهُ","وَطَعنٍ مِثلِ أَفراغِ الدِلاءِ",9,"ا",2,0],["بِضاحي النَقبِ حينَ خَرَجنَ مِنهُ","وَخَلفَ مُتونِ ساقَتِها الخَليجُ",10,"ج",1,0],["بِضْعٌ وَتِسْعُونَ مَرَّتْ","مِنَ السِّنِينِ الطِّوَالِ",11,"ل",1,0],["بِضَربٍ وَطَعنٍ بِالرَماحِ كَأَنَّهُ","حَريقٌ جَرى في غابَةٍ يَتَسَعَّرُ",12,"ر",1,0],["بضّة فعمة لميس رداح","غادة أحوريّة بهنانه",13,"ن",2,0],["بِضَربَةِ فَيصَلٍ تَرَكَت رَئيساً","عَلى الخَدَّينِ يَنحَطُ غَيرَ نامِ",14,"م",1,0],["بضرب لا دواء له وطعن","ترى منه الأساة مولينا",15,"ن",2,0],["بضرب يتبع الألِلىّ منه","فتاة الحيَّ وسطهم الرنينا",15,"ن",2,0],["بِضَرب تُتبِعُ الأَلِليَّ مِنهُ","فَتاةُ الحَيِّ وَسطَهُمُ الرَّنِينَا",16,"ن",2,0],["بِضَربٍ لاَ كَفَاءَ لَهُ وطَعن","تُرَى منه الأُساةُ مُوَلوِلينَا",16,"ن",2,0],["بِضِرابٍ تَأذَنُ الجِنُّ لَهُ","وَطِعانٍ مِثلِ أَفواهِ الفُقُر",17,"ر",1,0],["بِضَربٍ كَإيزاغِ المَخاضِ مُشاشُهُ","وَطَعنٍ كَأَفواهِ اللِقاحِ السَوادِرِ",18,"ر",1,0],["بَضَّ لي من نداكَ قبل استقائي","بكَ ريِّي وفَضْلَةٌ للشريبِ",19,"ب",1,0],["بِضَربٍ يَقُضُّ البَيضَ شِدَّةُ وَقعِهِ","وَطَعنٍ كَرَكضِ الخَيلِ تُفلى مِهارُها",20,"ر",3,0],["بِضَربٍ لا كِفاءَ لَهُ وَطَعنٍ","كَأَفواهِ المَزادِ لَهُ شَرارُ",21,"ر",1,0],["بِضَربَةِ سَيفٍ أَو بِنَجلاءَ ثَرَّةٍ","إِذا نَشَجَت مَجَّت دِماءَ الأَباهِرِ",22,"ر",1,0],["بَضَّةُ الخَدَّين وَالنَهدَينِ ما","سَفَرَت إِلّا رَأَيتُ القَمَرا",23,"ر",2,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِهِ","وَطَعنٍ كَإيزاعِ المَخاضِ تُؤامِ",24,"م",1,0],["بِضَربِ هامِ الكُماةِ تَمَّ لَهُ","كَسبُ الَّذي يَكسِبونَ بِالمَلَقِ",25,"ق",1,0],["بِضَربٍ يَعُمُّهُمُ جائِرٍ","لَهُ فيهِمِ قِسمَةُ العادِلِ",26,"ل",1,0],["بِضَربٍ أَتى الهاماتِ وَالنَصرُ غائِبُ","وَصارَ إِلى اللَبّاتِ وَالنَصرُ قادِمُ",27,"م",1,0],["بِضَربٍ هاجَ أَطرابَ المَنايا","سِوى ضَربِ المَثالِثِ وَالمَثاني",28,"ن",2,0],["بضاعة هرمس مكنونة","وشركته مع أقرونسِ",29,"س",1,1],["بِضَربٍ يَشيدُ المَجدَ في كُلِّ مَوقِفٍ","وَيُسرِعُ في هَدمِ الطُلى وَالجَماجِمِ",30,"م",1,0],["بِضَربي بِسَيفي ساقَ كُلُّ سَمينَةٍ","وَتَعليقِ رَحلي ماشِياً غَيرَ راكِبِ",31,"ب",1,0],["بِضَربٍ يَزيلُ الهامَ عَن مُستَقَرِّهِ","وَطَعنٍ بِأَطرافِ الرِماحِ الجَوائِفِ",32,"ف",1,0],["بِضَربٍ تَندُرُ القَصَراتُ فيهِ","وَطَعنٍ مِثلِ أَفواهِ النِهاقِ",33,"ق",1,0],["بِضَرْبٍ كَشَقِّ الأَتْحَميِّ تَرى له","جُيوبَ العَذارى في الخُدودِ تُمَزَّقُ",34,"ق",1,0],["بِضُمَّرٍ ما رَبَطناها مُسَوَّمَةً","إِلّا لِنَغزو بِها مَن باتَ يَغزونا",35,"ن",2,0],["بِضَربٍ تَرقُصُ الأَحشاءُ مِنهُ","وَتَبطُلُ مُهجَةُ البَطَلِ النَجيدِ",36,"د",1,0],["بضاعةٌ ما اشتراها غيرُ بائعها","بئسَ البضاعةُ والمبتاعُ والشاري",37,"ي",1,0],["بِضَجيج كَأَنَّهُ زَجل الرَع","دِ وَرَجف تَخاله زلزلا",38,"ل",2,0],["بِضَوءِ عَمُودِ الصُبحِ حَتّى كَأَنَّما","تَجَلّى عَمُودُ الصُبحِ يَوماً مُوَرَّدا",39,"د",2,0],["بِضَميرٍ لا لَهوَ فيهِ وَقَلبٍ","وَقَذَتهُ قَوارِعُ الدَهرِ وَقذا",40,"ذ",2,0],["بِضَرِمٍ يَمرَحُ في شِوارِهِ","في الحَلَقِ الصُفرِ وَفي أَسيارِهِ",41,"ر",2,0],["بِضَربٍ يَذوقُ المَوتَ مَن ذاقَ طَعمَهُ","وَتُدرِكُ مَن نَجّى الفِرارُ مَثالِبُه",42,"ب",2,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكِناتِهِ","وَطَعنٍ كَإيزاغِ المَخاضِ الضَوارِبِ",43,"ب",1,0],["بضَرْبَتَينِ لطُهْرِ الوَجهِ واحِدةٌ","وللذّراعينِ أُخرى ذاتُ إسراعِ",44,"ع",1,0],["بِضَمِيرٍ عَلى البَلاءِ نَقِيٍّ","وَفُؤَادِ عَلى المُصَابِ شَكُورِ",45,"ر",1,0],["بِضاعَةُ خاسِرٍ بارَت عَلَيهِ","فَباعَكَ بِالنَواةِ التَمرَتَينِ",46,"ن",1,0],["بضوء الدساتير استنارت ممالكٌ","تخبَّطُ في ليل من الجْهل مظلم",47,"م",1,0],["بضربٍ يُزيلُ الهَامَ عن سَكَناتِهِ،","وطعنٍ، كإيزاغِ المخاضِ تؤامِ",48,"م",1,0],["بِضَرْبٍ يُزِيلُ الهَامَ عَن سَكَنَاتِها","كما ذِيدَ عنْ ماءِ الحياضِ الغرائبُ",49,"ب",1,0]]}