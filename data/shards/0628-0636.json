n/poem/72353","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139630",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4691,"ضوء مقتول(رثاء شريفة العلوي)","https://www.poetsgate.com/ViewPoem.aspx?id=137157",""],[4767,"دعوة صادقة","https://www.poetsgate.com/ViewPoem.aspx?id=178387",""],[4767,"إشراقة النور","https://www.poetsgate.com/ViewPoem.aspx?id=180450",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4830,"دمشق الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=195033",""],[4578,"ماذا تقول بمدحك الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=49340",""],[4862,"بضعٌ وخمسون","https://www.poetsgate.com/ViewPoem.aspx?id=177819",""],[4984,"لله تلك السوق","https://www.poetsgate.com/ViewPoem.aspx?id=215829",""],[3271,"الشعاع المقيد","https://www.poetsgate.com/ViewPoem.aspx?id=104118",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[3591,"ما أطعمتنا حسانٌ في مغانينا","https://www.poetsgate.com/ViewPoem.aspx?id=149377",""],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5135,"أستغفر الله","https://www.poetsgate.com/ViewPoem.aspx?id=206226",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5277,"نابُ النوى","https://www.poetsgate.com/ViewPoem.aspx?id=191464",""],[5356,"ليس ابتعاداً","https://www.poetsgate.com/ViewPoem.aspx?id=205812",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5409,"أبى الوضع عن جوره أن يكف","https://www.poetsgate.com/ViewPoem.aspx?id=155292",""],[5411,"ناقوس روحي","https://www.poetsgate.com/ViewPoem.aspx?id=187568",""],[5431,"أيحتاج ماء الغيم إنْ ظلّ بي يُروى !!","https://www.poetsgate.com/ViewPoem.aspx?id=201461",""],[5563,"أحلى الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=213091",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5582,"خَيالٌ سَرَى وَهْناً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=63489",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[6008,"من الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=60806",""],[6093,"زاد في هجره لا تسلْ","https://www.poetsgate.com/ViewPoem.aspx?id=203215",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6185,"بوح !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87022&r=&rc=8",""],[6259,"أبا الفضل طال الليل أم خانني صبري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59424&r=&rc=72",""],[3469,"نأتك أُمامة ُ إلا سَؤالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19196&r=&rc=14",""],[6320,"عَوْدَةُ الجَوَاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84341&r=&rc=38",""]],"verses":[["بِضائِعُ قَولٍ عِندَ غَيرِيَ رِبحُها","وَعِندِيَ خُسراناتُها وَالوَضائِعُ",0,"ع",1,0],["بِضَربٍ يَنثُرُ الشَفَراتِ حَتّى","لَها في كُلِّ جانِحَةٍ غِرارُ",1,"ر",1,0],["بِضَوامِرٍ مِثلِ النُسو","رِ وَغِلمَةٍ مِثلِ الصُقورِ",2,"ر",1,0],["بِضُمَّرٍ أَسقَطَها","عَليهِمُ مَعَ النَدى",3,"د",2,0],["بِضَربٍ كَما اِشتَرَطَتهُ السُيوفُ","وَطَعنٍ كَما اِقتَرَحَتهُ الكُعوبُ",4,"ب",1,0],["بضَرْبَةٍ رَعْلاءَ أو طَعْنَةٍ","تَخاوَصَتْ منها عُيونُ الجِراحْ",5,"ح",1,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِها","كضما ذيدَ عَن ماءِ الحِياضِ الغَرائِبُ",6,"ب",1,0],["بِضَربِهِمُ حَبيكَ البَي","ضِ حَتّى ثَلَّموا العَجَما",7,"م",2,0],["بِضَربٍ يُلقِحُ الضِبعانُ مِنهُ","طَروقَتَهُ وَيَأتَنِفُ السِفادا",8,"د",2,0],["بِضَربٍ تَشخَصُ الأَبصارُ مِنهُ","وَطَعنٍ مِثلِ أَفراغِ الدِلاءِ",9,"ا",2,0],["بِضاحي النَقبِ حينَ خَرَجنَ مِنهُ","وَخَلفَ مُتونِ ساقَتِها الخَليجُ",10,"ج",1,0],["بِضْعٌ وَتِسْعُونَ مَرَّتْ","مِنَ السِّنِينِ الطِّوَالِ",11,"ل",1,0],["بِضَربٍ وَطَعنٍ بِالرَماحِ كَأَنَّهُ","حَريقٌ جَرى في غابَةٍ يَتَسَعَّرُ",12,"ر",1,0],["بضّة فعمة لميس رداح","غادة أحوريّة بهنانه",13,"ن",2,0],["بِضَربَةِ فَيصَلٍ تَرَكَت رَئيساً","عَلى الخَدَّينِ يَنحَطُ غَيرَ نامِ",14,"م",1,0],["بضرب لا دواء له وطعن","ترى منه الأساة مولينا",15,"ن",2,0],["بضرب يتبع الألِلىّ منه","فتاة الحيَّ وسطهم الرنينا",15,"ن",2,0],["بِضَرب تُتبِعُ الأَلِليَّ مِنهُ","فَتاةُ الحَيِّ وَسطَهُمُ الرَّنِينَا",16,"ن",2,0],["بِضَربٍ لاَ كَفَاءَ لَهُ وطَعن","تُرَى منه الأُساةُ مُوَلوِلينَا",16,"ن",2,0],["بِضِرابٍ تَأذَنُ الجِنُّ لَهُ","وَطِعانٍ مِثلِ أَفواهِ الفُقُر",17,"ر",1,0],["بِضَربٍ كَإيزاغِ المَخاضِ مُشاشُهُ","وَطَعنٍ كَأَفواهِ اللِقاحِ السَوادِرِ",18,"ر",1,0],["بَضَّ لي من نداكَ قبل استقائي","بكَ ريِّي وفَضْلَةٌ للشريبِ",19,"ب",1,0],["بِضَربٍ يَقُضُّ البَيضَ شِدَّةُ وَقعِهِ","وَطَعنٍ كَرَكضِ الخَيلِ تُفلى مِهارُها",20,"ر",3,0],["بِضَربٍ لا كِفاءَ لَهُ وَطَعنٍ","كَأَفواهِ المَزادِ لَهُ شَرارُ",21,"ر",1,0],["بِضَربَةِ سَيفٍ أَو بِنَجلاءَ ثَرَّةٍ","إِذا نَشَجَت مَجَّت دِماءَ الأَباهِرِ",22,"ر",1,0],["بَضَّةُ الخَدَّين وَالنَهدَينِ ما","سَفَرَت إِلّا رَأَيتُ القَمَرا",23,"ر",2,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكَناتِهِ","وَطَعنٍ كَإيزاعِ المَخاضِ تُؤامِ",24,"م",1,0],["بِضَربِ هامِ الكُماةِ تَمَّ لَهُ","كَسبُ الَّذي يَكسِبونَ بِالمَلَقِ",25,"ق",1,0],["بِضَربٍ يَعُمُّهُمُ جائِرٍ","لَهُ فيهِمِ قِسمَةُ العادِلِ",26,"ل",1,0],["بِضَربٍ أَتى الهاماتِ وَالنَصرُ غائِبُ","وَصارَ إِلى اللَبّاتِ وَالنَصرُ قادِمُ",27,"م",1,0],["بِضَربٍ هاجَ أَطرابَ المَنايا","سِوى ضَربِ المَثالِثِ وَالمَثاني",28,"ن",2,0],["بضاعة هرمس مكنونة","وشركته مع أقرونسِ",29,"س",1,1],["بِضَربٍ يَشيدُ المَجدَ في كُلِّ مَوقِفٍ","وَيُسرِعُ في هَدمِ الطُلى وَالجَماجِمِ",30,"م",1,0],["بِضَربي بِسَيفي ساقَ كُلُّ سَمينَةٍ","وَتَعليقِ رَحلي ماشِياً غَيرَ راكِبِ",31,"ب",1,0],["بِضَربٍ يَزيلُ الهامَ عَن مُستَقَرِّهِ","وَطَعنٍ بِأَطرافِ الرِماحِ الجَوائِفِ",32,"ف",1,0],["بِضَربٍ تَندُرُ القَصَراتُ فيهِ","وَطَعنٍ مِثلِ أَفواهِ النِهاقِ",33,"ق",1,0],["بِضَرْبٍ كَشَقِّ الأَتْحَميِّ تَرى له","جُيوبَ العَذارى في الخُدودِ تُمَزَّقُ",34,"ق",1,0],["بِضُمَّرٍ ما رَبَطناها مُسَوَّمَةً","إِلّا لِنَغزو بِها مَن باتَ يَغزونا",35,"ن",2,0],["بِضَربٍ تَرقُصُ الأَحشاءُ مِنهُ","وَتَبطُلُ مُهجَةُ البَطَلِ النَجيدِ",36,"د",1,0],["بضاعةٌ ما اشتراها غيرُ بائعها","بئسَ البضاعةُ والمبتاعُ والشاري",37,"ر",2,0],["بِضَجيج كَأَنَّهُ زَجل الرَع","دِ وَرَجف تَخاله زلزلا",38,"ل",2,0],["بِضَوءِ عَمُودِ الصُبحِ حَتّى كَأَنَّما","تَجَلّى عَمُودُ الصُبحِ يَوماً مُوَرَّدا",39,"د",2,0],["بِضَميرٍ لا لَهوَ فيهِ وَقَلبٍ","وَقَذَتهُ قَوارِعُ الدَهرِ وَقذا",40,"ذ",2,0],["بِضَرِمٍ يَمرَحُ في شِوارِهِ","في الحَلَقِ الصُفرِ وَفي أَسيارِهِ",41,"ر",2,0],["بِضَربٍ يَذوقُ المَوتَ مَن ذاقَ طَعمَهُ","وَتُدرِكُ مَن نَجّى الفِرارُ مَثالِبُه",42,"ب",2,0],["بِضَربٍ يُزيلُ الهامَ عَن سَكِناتِهِ","وَطَعنٍ كَإيزاغِ المَخاضِ الضَوارِبِ",43,"ب",1,0],["بضَرْبَتَينِ لطُهْرِ الوَجهِ واحِدةٌ","وللذّراعينِ أُخرى ذاتُ إسراعِ",44,"ع",1,0],["بِضَمِيرٍ عَلى البَلاءِ نَقِيٍّ","وَفُؤَادِ عَلى المُصَابِ شَكُورِ",45,"ر",1,0],["بِضاعَةُ خاسِرٍ بارَت عَلَيهِ","فَباعَكَ بِالنَواةِ التَمرَتَينِ",46,"ن",1,0],["بضوء الدساتير استنارت ممالكٌ","تخبَّطُ في ليل من الجْهل مظلم",47,"م",1,0],["بضربٍ يُزيلُ الهَامَ عن سَكَناتِهِ،","وطعنٍ، كإيزاغِ المخاضِ تؤامِ",48,"م",1,0],["بِضَرْبٍ يُزِيلُ الهَامَ عَن سَكَنَاتِها","كما ذِيدَ عنْ ماءِ الحياضِ الغرائبُ",49,"ب",1,0],["بضعة الافراد من اهل العبا","اعظم الاقطاب اخلاقا واحمد",50,"د",1,0],["بضعة أصحاب العبا مرشد الوق","ت إمام القوم حلو الكلام",51,"م",1,0],["بضامرِى أبداً حب الحبيب ثوَى","قدّ الحشَا فغدا نَوَاكَ ملتبسَا",52,"س",2,0],["بَضِيرٌ بِالفُنُونِ وَمَا حَوَتهُ","ومِن حَوبِ الذُّنُوبِ وَقَاهُ فَاهُ",53,"ا",2,0],["بِضَربٍ يُذَبِّبُ دونَ النِهابِ","حذارَ الوَثائِرِ وَالخَنفَقيقِ",54,"ق",1,0],["بِضَربٍ تَرى الفِتيانَ فيهِ كَأَنَّهُم","ضَواري أُسودٍ فَوقَ لَحمٍ خَرادِلِ",55,"ل",1,0],["بضرب تسبحُ الآجال فيه","تطير إلى السمامنة الشَّرارُ",56,"ر",1,0],["بضائِعُنا المزجاةُ تنفقُ عندَه","وانف