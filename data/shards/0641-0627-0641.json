"https://www.aldiwan.net/poem34498.html","مجزوء الرجز"],[559,"لا فرق عندي بين الوتر والوتر","https://www.aldiwan.net/poem34505.html","البسيط"],[559,"عدم للوجود كالأمواج","https://www.aldiwan.net/poem34687.html","الخفيف"],[559,"إنما بيت عزتي وهو قلبي","https://www.aldiwan.net/poem34927.html","الخفيف"],[559,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[559,"إن الوجود له ذات وأسماء","https://www.aldiwan.net/poem35080.html","البسيط"],[559,"قد أحاط الوجود بالأشياء","https://www.aldiwan.net/poem35081.html","الخفيف"],[559,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[560,"تنبه قد بدى شمس العقار","https://www.aldiwan.net/poem69363.html","الوافر"],[563,"قد سر يوسف وفد جبريل الذي","https://www.aldiwan.net/poem52585.html","الكامل"],[563,"قضى في خلقه ذو العرش أمرا","https://www.aldiwan.net/poem52739.html","الوافر"],[563,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[563,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[565,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[568,"يا من يكاثر بالدفاتر","https://www.aldiwan.net/poem69662.html","مجزوء الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"]],"verses":[["فَأُفيضَت الخِلَعُ السَوا","دُ عَلَيَّ تَرشُقُها العُيونُ",0,"ن",1,0],["فَافْتَرَّ عَنْ قِصَر أَهَا","بَ بِفَجْرِهِ فَتَبَلَّجَا",1,"ج",2,0],["فأفْرَخَ رَوْعي إذ قَمَعْتُ بِهِ العِدا","وخَفَّضَ جَأشي حينَ رفَّعَ ناظِري",2,"ر",2,0],["فأفْياؤُهُمْ للمُسْتَجيرِ مَعاقِلٌ","وأبياتُهُمْ للمَكْرُماتِ مَغاني",3,"ن",2,0],["فَأَفنَيتُ دَمعي بِطولِ البُكا","فَما تَقدِرُ العَينُ أَن تَهمُلا",4,"ل",2,0],["فأفْلِقِ البيضَ واهْزُزْ كلَّ غالِبَةٍ","فالدّينُ في مَرَحٍ والكُفْرُ في وهَقِ",5,"ق",1,0],["فَافْطِنْ لَهُ إِنَّهُ غَيُورٌ","وَارْمِ إِلَيْهِ بِكُلِّ فَانِي",6,"ن",2,0],["فَافْتَحْ مَعَاقِلَهَا الْمُنِيفَاتِ الذُّرَى","وَانْشُرْ عَلَى شُرُفَاتِهَا الأَعْلاَمَا",7,"م",2,0],["فَأَفنَيتُها وَتَعالَلتُها","عَلى صَحصَحٍ كَرِداءِ الرَدَن",8,"ن",1,0],["فَأَفِض عَلَينا مِن سَمائِكَ حِكمَةً","تَأسو القُلوبَ فَإِنَّ رَأيَكَ أَحكَمُ",9,"م",1,0],["فَاِفعَل بِهِ اللَهُمَّ كَال","نَمروذِ فَهوَ بِها حَري",10,"ر",2,0],["فَأَفِض ضِياءَكَ في النَظارَةِ كُلِّها","وَاِقبِض عَلى الأَعمالِ قَبضَ القادِرِ",11,"ر",1,0],["فَافعَل بِجَهدِكَ ما تَشاءُ فَإِنَّني","بَعدَ المُعَظَّمِ لا أُبالي بِالرَدى",12,"د",2,0],["فَأَفنَينا جُموعَهُمُ بِثَأجٍ","وَكَرَّت بِالغَنائِمِ وَالنِهابِ",13,"ب",1,0],["فَافْعَلْ كَعِيسَى وَأَحْيِ المَيْتَ تُحْيِ بِهِ","أُمّاً عَلَى وَشْكِ أَنْ تَفْنَى مِنَ الأَلَمِ",14,"م",1,0],["فافْسَحْ لها أكْنافَ صفحك إنها","بكرٌ أتت تمشي على استحياءِ",15,"ا",2,0],["فأفتكر أن شئت علم السبب","هل يكون النور مثلَ السَدَف",16,"ف",1,0],["فَأَفسَدتَ تَغلِبَ كُلَّ الفَسادِ","وَشُمتَ القُيونَ وَأَكيارَها",17,"ر",3,0],["فَأَفحَمتُهُ حَتّى اِستَكانَ كَأَنَّهُ","قَريحُ سُلالٍ يَكتَفُ المَشيَ فاتِرُ",18,"ر",1,0],["فَأَفرَعَ في الرُبابِ يَقودُ بُلقاً","مُجَوَّفَةً تُذُبُّ عَنِ السِخالِ",19,"ل",1,0],["فَأُفٍّ لِلِحيانٍ عَلى كُلِّ حالَةٍ","فَذِكرُهُمُ في الذِكرِ شَرُّ ثَناءِ",20,"ا",2,0],["فافْخر بنفسك إنَّها النفس التي","كملت فما تبغي سوى تأبيدها",21,"د",3,0],["فافترّ من عجب وقال انظروا","لعاشقٍ يجني ويستعدي",22,"ي",1,0],["فأفاضَ الجودين عدلاً ومالاً","وحمى الجانبين حزناً وسهلا",23,"ل",2,0],["فافْخر بمعنى لحظكَ المعشوق","في كلِّ ما تأنيثهُ حقيقي",24,"ي",1,0],["فافْخر به سحب الحيا إن صابا","واسْتوتْ المياه والأخشابا",24,"ب",2,0],["فافْتح لها باب قبول يجتلى","وإن تجد عيباً فسدّ الخللا",24,"ل",2,0],["فَاِفهَموا قَولي فَفيهِ نَبَأٌ","أَيَّ مَعنى تَحتَ قَولي كَمنا",25,"ن",2,0],["فأفلتُّ من ذُؤبانهِ وأُسودِهِ","وحُرَّابِهِ إفلاتَ أَتوب تائبِ",26,"ب",1,0],["فافهمْ كلامي يا أبا مالكٍ","لا يُشبهُ العنوانَ ما في الكتابْ",27,"ب",1,0],["فافترَّ عن ثغره باسماً","فبان لي الدرُّ بفيهِ ولاحْ",28,"ح",1,0],["فافتح لعبدك بابَ العُذْر إنَّ لهُ","قدْماً بلُطفكَ باباً غير مسدُودِ",29,"د",1,0],["فافخرْ على أن الجلي","ل من الأمور لكم حقيرُ",30,"ر",1,0],["فأفادني فتحي لهُ","جاهاً ومعروفاً وقدرا",31,"ر",2,0],["فافتَرِصها وكفُّه لي مِلاء","من نوالٍ ووجهه ليَ خالي",32,"ل",2,0],["فأفحم عنه كل طالب حاجةٍ","وليس عليه لامرئٍ متكلَّمُ",33,"م",1,0],["فأفسدَ بيني وبينَ الملاح","وأوحشَ منِّي كؤوسَ المُدامهْ",34,"م",2,0],["فافككْ لساناً رهنتَه بجَداً","أو باعتذارٍ فلستَ قارونا",35,"ن",2,0],["فأفِئْ عليَّ ظلالَ عطفِكَ إنني","في مظلم الأرجاء غير كنين",36,"ن",1,0],["فافخر بعيشك يا عيال عيالِه","وبهم فكم بدأوا الجميلَ وكم ثَنَوا",37,"ن",3,0],["فَاِفتَنَّهُنَّ مِن السَواءِ وَماؤُهُ","بِثرٌ وَعانَدَهُ طَريقٌ مَهيَعُ",38,"ع",1,0],["فَأَفاقَ مَذعوراً يُقَلِّبُ طَرفَهُ","لِلرُعبِ في الأَبوابِ وَالحيطانِ",39,"ن",1,0],["فَاِفخَر بِما أَعطاكَ رَبُّكَ إِنَّهُ","فَخرٌ سَيَبقى في الزَمانِ مُسَطَّرا",40,"ر",2,0],["فَأَفرَعنَ في وادي الأُمَيِّرِ بَعدَما","ضَبا البيدَ سافي القَيظَةِ المَتَناصِرُ",41,"ر",1,0],["فافْتَكَّ منها بعُنْفٍ","كَفُّ الرَّدى أَبَويْها",42,"ه",2,0],["فأَفيقي يا خِرافي","وهَلُمِّي يا شِياهْ",43,"ه",1,0],["فَافْهِمي النَّاسَ إنَّما النَّاسُ خَلْقٌ","مُفْسِدٌ في الوجودِ غيرُ رشيدِ",44,"د",1,0],["فافعلْ مشيئَتكَ التي قَدْ شئتَها","وارحمُ جلالكَ من سماعِ خطابي",45,"ب",2,0],["فافخر بفضلك فهو لا أنسابه","تبلى ولا سلطانه لنقاد",46,"د",1,0],["فَاِفتَتَنَ الظَبيُ بِذي المَقالِ","وَزادَهُ شَوقاً إِلى اللآلي",47,"ي",1,0],["فَاِفزَع إِلى الزَمَنِ الحَكيمِ فَعِندَهُ","نَقدٌ تَنَزَّهَ عَن هَوىً وَنِزاعِ",48,"ع",1,0],["فَاِفتَرَقنا حَولاً فَلَمّا اِلتَقَينا","كانَ تَسليمُهُ عَلَيَّ وَداعا",49,"ع",2,0],["فَأَفنى وَما أَفنَتهُ نَفسي كَأَنَّما","أَبو الفَرَجِ القاضي لَهُ دونَها كَهفُ",50,"ف",1,0],["فافتح برفقٍ بابَ حكمتنا","واصبر فإنَّ لبابنا غَلَقا",51,"ق",2,0],["فافطن لسر الله فيك فإنه","لذوي النهى كالشمس في إشراقها",52,"ق",3,0],["فافطن لحكمتنا التي ضربت لها ال","أمثال واستنبط بها الأسرارا",53,"ر",2,0],["فافلاك تدبرها نجوم","تدور كما يدور المنجنونُ",54,"ن",1,0],["فأفلتَ ممسوخَ الإِهابِ مرمَّلاً","فلما رآه الثُعْلُبانُ تبسَّمَا",55,"م",2,0],["فَأَفاءَها وافي العَزيمَةِ صَدَّقَت","أَيامُهُ التَرغيبَ وَالتَرهيبا",56,"ب",2,0],["فَأَفادَ مُحسِنَكُم وَقالَ لِمُخطِئٍ","لا لَومَ في خَطَإٍ وَلا تَثريبا",56,"ب",2,0],["فَاِفخَر بِهِ وَبِمِصعَبٍ وَحَليفِهِ","إِنَّ الحُسَينَ أَجَلُّ مِن نَشناشِ",57,"ش",1,0],["فَأَفضَيتُ مِن قُربٍ إِلى ذي مَهابَةٍ","أُقابِلُ بَدرَ الأُفقِ حينَ أُقابِلُه",58,"ل",2,0],["فَاِفكُك جَوامِعَهُم بِمَنِّكَ إِنَّها","سُمِرَت عَلى أَيدي نَدىً وَطِعانِ",59,"ن",1,0],["فَأَفنى مِراحَ الداعِرِيَّةِ خَوضُها","بِنا اللَيلَ إِذ نامَ الدَثورُ المُلَفَّفُ",60,"ف",1,0],["فأفوزَ بالعَذْبِ النَّميرِ وينطوي","كَشْحُ الحسودِ على أليمِ عَذابِه",61,"ب",2,0],["فَاِفخَر فَما فَخرُكَ بَدعاً وَقَد","قامَ لِأَهلِ العَصرِ بُرهانُه",62,"ن",2,0],["فَافتُك بِهِم فَتكَ المُلوكِ وَلا تَلِن","فَيَصِحَّ ما قالَ السَوادُ الأَعظَمُ",63,"م",1,0],["فَاِفطَن لِتَضمينِ لَفظٍ فيكَ أَحسُبُهُ","قَد ضُمِّنَ الدُرَّ إِلّا أَنَّهُ كَلِمُ",64,"م",1,0],["فأفادَ الشّعرَ مُنَقِّحه","وأصابَ بمنطقِهِ اللّسنَا",65,"ن",2,0],["فافخرْ فإنّكَ من مُلوكٍ لم يَزَلْ","لهمُ قديمُ مَفَاخرِ الأزمانِ",66,"ن",1,0],["فأفنيتُ في الحربِ آلاتَها","وأَعدَدتُ لِلسِّلم أَوزَارَها",67,"ر",3,0],["فَاِفتَح بِجودِكَ قُفلَ دَهري إِنَّهُ","قُفلٌ وَجودُ يَدَيكَ لي إِقليدُ",68,"د",1,0],["فَاِفخَر فَما مِن سَماءٍ لِلنَدى رُفِعَت","إِلّا وَأَفعالُكَ الحُسنى لَها عَمَدُ",69,"د",1,0],["فَاِفزَع إِلى ذُخرِ الشُؤونِ وَغَربِهِ","فَالدَمعُ يُذهِبُ بَعضَ جَهدِ الجاهِدِ",70,"د",1,0],["فَآفَةُ ذا أَلّا يُصادِفَ مَضرِباً","وَآفَةُ ذا أَلّا يُصادِفَ ضارِبا",71,"ب",2,0],["فَاِفزَع إِلى قاضي الجَماعَةِ رَهبَةً","تَضَعِ العِنانَ بِخَيرِ راحَةِ سائِسِ",72,"س",1,0],["فأفاقَ واتَّخَذَ الخِداعَ سَجِيَّةً","لا يَسْتَحِي منها ولا يَتعفَّفُ",73,"ف",1,0],["فَاِفعَل في الغَيرِ ما تَهوى","وَأَكرِم بَيتَ سُكناك",74,"ك",1,0],["فَأَفنَينَ نَبتَ الحائِرينَ وَمائَهُ","وَأَجراعَ وادي النَخلِ أَكلاً وَتَشرابا",75,"ب",2,0],["فافَتْ مناقِبُهُ العُقُولَ فَوَصْفُهُ","ما ليسَ يُدْرَكُ في قُوَى الأفهامِ",76,"م",1,0],["فافخَرْ بتيجانِ المُلوكِ ومُلكِها","فلأنتَ غيرُ مُدافَعٍ خُلصانُها",77,"ن",3,0],["فافخَرْ فمِن أنسابكَ الفرْدوْسُ إن","عُدّتْ ومن أحسابِكَ التنزيل",78,"ل",1,0],["