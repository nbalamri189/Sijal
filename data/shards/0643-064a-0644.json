?id=178587",""],[5939,"هي كِبريائي عنكِ حالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=178588",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"البحر يسليني جدا","https://www.poetsgate.com/ViewPoem.aspx?id=183261",""],[5956,"الأسباب النفسية لأمراض الفصام","https://www.poetsgate.com/ViewPoem.aspx?id=183999",""],[5956,"لِمَ يقصد الدخلاء دوماً بحرنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=192186",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"مناجاة الأخ الميت","https://www.poetsgate.com/ViewPoem.aspx?id=192372",""],[5956,"العطاءُ الصَّافي","https://www.poetsgate.com/ViewPoem.aspx?id=194638",""],[5956,"شكراً سُمَيّةُ قد أزلتِ مخاوفي","https://www.poetsgate.com/ViewPoem.aspx?id=202641",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5956,"كل أب يخشى على ابنه خَشيةً مشروعة","https://www.poetsgate.com/ViewPoem.aspx?id=215770",""],[6093,"كالبُنِّ في المِغْلاةِ عانقَ هَيْلَا","https://www.poetsgate.com/ViewPoem.aspx?id=206941",""],[6124,"يا مالكا قلبي لما","https://www.poetsgate.com/ViewPoem.aspx?id=201239",""],[6345,"محمد الدرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78674&r=&rc=45",""]],"verses":[["كيْ لا يُنازِع فيهِ غيْرَ مُقَصّرٍ","جاري أبو عبدِ الإلاهِ الفاسي",0,"س",2,0],["كي لا أكون مرائياً بعبادتي","ولكي أكون بشكره متفنّنا",1,"ن",2,0],["كيلانِ لا يقنع من جودِكم","لو أنها كيلان في شرقها",2,"ه",2,0],["كيلا ترى أنيَ مستأهلٌ","يوماً عصيباً ما لَهُ ظِلُّ",3,"ل",1,0],["كيلا أرى أحداً يُقاتُ برزقه","غيري ويُوطَنُ بَعده أوطانَهُ",4,"ن",2,0],["كَي لا يُصَدِّعُ رَأسي صَوتُ نائِحَةٍ","وَلا تُقَطِّعَ قَلبي أَنَّةُ التَعِسِ",5,"س",1,0],["كَي لا أَرى فيها البَياضَ الَّذي","في الرَأسِ وَالعارِضِ مِنّي بَدا",6,"د",2,0],["كَي لا تَشُكَّ عَلى التَجَنُّبِ أَنَّها","عِندي بِمَنزِلَةِ المُحِبِّ المُكرَمِ",7,"م",1,0],["كيلوجُ مُؤْتَمِرٌ يُشاوِرُ صَحْبَهُ","والسّيفُ يضحكُ والمدافِعُ تسخرُ",8,"ر",1,0],["كَيلا يُرَوِّعَ ذَلِكَ ال","وَجهَ المَليحَ سَماعُ حِسّي",9,"س",2,0],["كيلوا بسيف الحق كيل السندره","ولم يقفْ مَرْحَبُهم لحيْدره",10,"ه",1,0],["كي لا ترى عين خسيس موقفي","ببابه منتظرا من الجدا",11,"ا",1,0],["كي لا يرى له شريكا في الذي","يهدى له من الثنا ويجبا",12,"ب",2,0],["كَي لا يَكون منّةٌ لعبدِ","وَسخَّرَ الخلقَ لهُ جَميعا",13,"ع",2,0],["كيلا يَرَى في الليل لون القِلى","والصدِّ والهجرانِ والبغضِ",14,"ض",1,0],["كَيْ لاَ يُرَى يَوْماً لِغِرَّتِهِ","تَخْدَعُهُ مَكْراً بَوَارِقُهُمْ",15,"م",1,0],["كي لا يرى الأغيار في الأكوانِ","بمقتضى شهوده الإحساني",16,"ي",1,0],["كَيلا أُخالِفُ قَولَ السابِقينَ بِما","قَد استَحالوا وَيَكفي القَلبَ ما فيهِ",17,"ي",2,0],["كي لا يَحتلَّ فِراقُهمُ","ويكونَ بعَيْنِيَ مَشْهَده",18,"د",2,0],["كَي لا تُحلِّلَ ما يُحر","رِمُه فحرَّمَ ما أَحَلا",19,"ل",2,0],["كَيلا تَضيفَ كَمداً إِلى كَمَد","فَلَيسَ لِلحاسِدِ الا ما حَسَد",20,"د",1,0],["كيلا تميد بأهليها وأودعها","لهم منافع إن ساروا وإن قطنوا",21,"ن",3,0],["كَي لا أُكذِّبَ في رجَائي آملاً","إنّ البخيلَ يُكذِّبُ التأميلاَ",22,"ل",2,0],["كي لا يقبل ذا حسنٍ سوى أسدِ","ولا يطوف بكاساتٍ سوى ملكِ",23,"ك",1,0],["كي لا يقبل ذا حسنٍ سوى بطلِ","ولا يطوف بكاساتٍ سوى ملكِ",24,"ل",2,0],["كيلا يكون ذكره مكررا","إذا أتى من بعد هذا فجرى",25,"ر",2,0],["كَي لِتَقضيني رُقَيَّةُ ما","وَعَدَتني غَيرَ مُختَلَسِ",26,"س",1,0],["كي لهُ يَهتفون بالشُكرِ دَوماً","فلهُ الكلّ ناصر ونصيرُ",27,"ر",1,0],["كي لا تبيت الأرض خا","ليةً من الثقل الصغير",28,"ر",1,0],["كي لا يضل طريق الحق طالبه","ولم يخب من إلى جدواك يفتقر",29,"ر",1,0],["كي لا يحس وحيدها ببكائها","ياويح من يؤذيه صوت الهامس",30,"س",1,0],["كي لا أرى اليوم الرهيب ولا المنا","ئح في الحمى والذل في الأوطان",31,"ن",1,0],["كي لا ترى الأيامُ أنّا فرصةٌ","للخارجينَ وضحكةٌ للحُسَّدِ",32,"د",1,0],["كَي لا تَهونَ عَلى الأَعمامِ حاجَتهُ","وَلا يُعَلَّلَ عَنها بِالمَواعيدِ",33,"د",1,0],["كي لأحظى بلثم خود إذا ما","أخذت نومها لها قام",34,"م",1,0],["كَيلا يَكون الخَلق شَيئاً وَاحِدا","فَتنقص القُدرة نَقصاً زائِدا",35,"د",2,0],["كيلا يعادي بعدها شاعراً","فشعره أفتك من نصله",36,"ل",2,0],["كي لا يقبل ذا ثغرس سوى أسدٍ","ولا يطوف بكاساتٍ سوى ملك",37,"ك",1,0],["كي لا أقول وجود كفك ناصري","أسرت جفونك يا سعاد رقادي",38,"د",2,0],["كَيلاَ نَصِيرَ مَصِيرَهُم فِي يَومِنَا","هَذَا وَنَطمَعُ مِنكَ بِالغفرَانِ",39,"ن",1,0],["كيلا تمر به حال ولا سنة","الا بقلب بذكر اللَه مشتغل",40,"ل",1,0],["كَي لا يَقُولَ الناسُ ما لإَحمَدَا","خَلَّفَ هذا القطرِ عَجزَا وَسُدَى",41,"د",2,0],["كَيلا يَكون لِلعدا تَسلّط","وَلا يَكون بِالوَرى تفرّط",42,"ط",1,0],["كيلو الصوير ثم سيلوس كذا","استرصلوا كبيس مرز غتانة",43,"ه",1,0],["كي لا تقول بلسان حالها","مقال هند ألق من لم يلق",44,"ق",1,0],["كي لا أراها تلتهي","بالكتب عن أحبابها",45,"ب",3,0],["كي لا يصيب اليتم بعضا منهم","فيعيش عيشة بائس متسكع",46,"ع",1,0],["كي لا تلاحقه فتدخل فاه أو","يبقى يشاهد وجهها المتجهما",47,"م",2,0],["كي لا ينالَكُمُ كَيدِي ومَقدِرَتي","فقد يُحاذَرُ منّي زَلَّةُ الغَلِقِ",48,"ق",1,0],["كي لا يتيه بفضله","في قومه الرجل الفضيل",49,"ل",1,0],["كي لا يرى أصل هجرةٍ وقلىً","فالنار في بدء أمرها شرر",50,"ر",1,0],["كي لا يكون لما ندبِّ","رُهُ من العمل افتضاح",51,"ح",1,0],["كي لا أراه في منامي سبى","نومي فكم لي في النواحي نواح",52,"ح",1,0],["كي لا يَغَار على الحبيب حبيبهُ","فيقولَ بات بغيرنا متَعِلِّلاَ",53,"ل",2,0],["كيلا يرى بِالصَفوِ صورة نَفسِه","فيمضهُ نخس الضَمير ودودُهُ",54,"د",2,0],["كَي لا تحل بها إِلّا مطهرة","في رقع نعليك فيها طيب من لثما",55,"م",2,0],["كي لا يكون المَلام منه على","مُعتدِل القدّ غير معتدِل",56,"ل",1,0],["كي لا يرى أثر بخدي أو يش","م شذاي منك فيظهر الأمران",57,"ن",1,0],["كي لا أرى سود الكلاب وجربها","قد انشبت أظفارها بضياغم",58,"م",1,0],["كيلا اكون به المسيئ وانما","عن سيئاتي كفرت حسناته",59,"ت",2,0],["كي لا أعيش مع العذاب مضيعا","لكنني أفنيت فيك شبابا",60,"ب",2,0],["كي لا تصيري جملةً أنكرتُها","في بعضِ سَطري،في مدى إنكاري",61,"ر",2,0],["كي لا يستعمل ثيابها الوقوق ،","ويُدخلنا إلى زفافه .",62,"ه",1,0],["كي لا نكون كمَنْ أتتهم عاصِفٌ","في مَركَب ٍ يخْلو من الرُّبَّان ِ",63,"ن",1,0],["كيلا ينام على وساد خافق))","ووقيته قلبي ولحفة صيفه",64,"ه",1,0],["كي لا ينام على وساد خافق","ووقيته قلبي ولفحة صيفه",65