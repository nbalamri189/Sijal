px?id=192293",""],[5956,"أحبك يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=192500",""],[5974,"تماهي","https://www.poetsgate.com/ViewPoem.aspx?id=215557",""],[6033,"نفرتُ إلى ربّي","https://www.poetsgate.com/ViewPoem.aspx?id=215800",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6096,"سؤال .. وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=177884",""],[6113,"احبك","https://www.poetsgate.com/ViewPoem.aspx?id=27054",""],[6152,"سيدة القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=203012",""],[6152,"ذكرتكِ في الهدا","https://www.poetsgate.com/ViewPoem.aspx?id=203177",""],[520,"أفي كل يوم انت باعث همة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577543",""],[6167,"جمهورية الخلفاء الراشدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85473&r=&rc=2",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""],[6213,"بحار الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85491&r=&rc=94",""],[6262,"اللغةُ لم تكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80118&r=&rc=16",""],[6305,"مَنْ يُرينِي الشِّعْر ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87327&r=&rc=0",""],[6315,"بيروت وأحاديث العرَّاف ... قراءة لأقداح الأنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87583&r=&rc=8",""],[4222,"أحبة قلبي طال ليلي بعدكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52773&r=&rc=65",""]],"verses":[["أُجيلُ لِحاظي لا أَرى غَيرَ ناقِصٍ","كَأَنَّ الوَرى نَقصٌ وَأَنتَ كَمالُ",0,"ل",1,0],["أَجيبي مُحِبّاً إِن تَوَهَّمَ مَنزِلاً","عَفا بَلَّ رُدْنَيْهِ مِنَ الدَّمعِ ساكِبُهْ",1,"ب",2,0],["أُجيبُ بِلُبنى مَن دَعاني تَجَلُّدا","وَبي زَفَراتٌ تَنجَلي وَتَعودُ",2,"د",1,0],["أجيبي تجافَتْ عنْ رُباكِ يدُ الرّدَى","ولا نَضِبَتْ أمْواهُ موْرِدِكِ الغَمْرِ",3,"ر",1,0],["أُجيبُ إِذا الداعي دَعاني وَأَحتَمي","بِأَبيَضَ مَصقولٍ ضَريبتُهُ عَضبِ",4,"ب",1,0],["أُجيلَت كَمَرِّ ذَنوبِ القَرى","فَأَلوى بِمَن حانَ إِشعالُها",5,"ل",3,0],["أَجِئتَ تَحوطُنا وَتَرُدُّ عَنّا","وَتَرفَعُنا إِلى أَوجِ السُعودِ",6,"د",1,0],["أجيرتنا بالرمل والرمل منزلٌ","مضى العيش فيه بالشبيبة حاليا",7,"ي",2,0],["أجيبك للفضل الذي أنت أهلُه","وأكتب مما قد أفدت الأماليا",8,"ل",3,0],["أجيلاً معي الأفكار فيها فإنها","مجال عقول للأنام وأفكار",9,"ر",1,0],["أَجيرانَ الزُبَيرِ غَرَرتُموهُ","كَما اِغتَرَّ المُشَبِّهُ بِالسَرابِ",10,"ب",1,0],["أَجيرانَ الزُبَيرِ بَرِئتُ مِنكُم","فَأَلقوا السَيفَ وَاِتَّخِذوا العِيابا",11,"ب",2,0],["أَجِئتَ تَسوقُ السيدَ خُضراً جُلودُها","إِلى الصَيدِ مِن خالَيَّ صَخرٍ وَخالِدِ",12,"د",1,0],["أَجيرانَ الزُبَيرِ غَرَرتُموهُ","كَأَنَّكُمُ الدَلادِلُ وَالقُهودُ",13,"د",1,0],["أَجِئتُم تَبَغَّونَ العُرامَ فَعِندَنا","عُرامٌ لِمَن يَبغي العَرامَةَ واسِعُ",14,"ع",1,0],["أجيبوا رقى الآسي النطاسي واحْذروا","مطفئة الرضف التي لا شَوى لها",15,"ه",2,1],["أَجِئتَ مُحَمَّداً عَظماً رَميماً","لِتُكذِبَهُ وَأَنتَ بِهِ جَهولُ",16,"ل",1,0],["أجيدٌ ويجدي عادتينا وإنما","لكل امرئٍ من دهره ما تعودا",17,"د",2,0],["أجيراننا حيى الربيع دياركُم","وإن لم يكن فيها لطرفيَ مربع",18,"ع",1,0],["أجيراننا حيَّى ديارَكم الحيا","وطافَ عليها للغمائمِ ساقي",19,"ي",1,1],["أجيراننا إن عفتم السفح منزلا","وأخليتموا من جانب الجزع موطنا",20,"ن",2,0],["أجيراننا بالشعبِ سُقياً لعهدكم","وإن كانَ عهداً حظّنا منه أشجان",21,"ن",1,0],["أجَيْئلةً عرفاء تَسحب رِجْلها","أجِدَّكَ لا يُرضيكَ مِدحةُ شاعِر",22,"ر",1,0],["أجئت تعزِّيني لأني آسف","وأني مفجوع وأني خائب",23,"ب",1,0],["أجيش للخليفة أم غمام","أظلَّ تساليا سمحا هتونا",24,"ن",2,0],["أُجيلَ الرَأيُ بَينَ يَدَيكَ حَتّى","تَبَيَّنَتِ الرَزانَةُ وَالحَصاةُ",25,"ه",1,0],["أجيرتنا بالجِزع كيف خلصتُمُ","نَجيَّاً وأخفيتمْ حديثَكُمُ عنِّي",26,"ن",2,1],["أَجيرانِنا أَزمَعوا عَن زَرودٍ","رَحيلاً وَما رابَهُم مِن زَرودِ",27,"د",1,0],["أَجيبوا صَدى جَلدٍ إِذا ما دَعاكُمُ","بِجُردٍ تُسامي المُلجِمينَ فُحولُها",28,"ل",3,1],["أجئت بي عتبات الخلد أم شركا","نصبت لي من خداع الوهم أم حلما",29,"م",2,0],["أَجِئنا الَّذي لَم يَأتِهِ الناسُ قَبلَنا","فَقَبلي مِنَ النِسوانِ وَالناسِ مَن أَحَب",30,"ب",1,0],["أجئتم تَعدُّون الجرائرَ جَمّةً","وليس بِحُرِّ من يَعُدُّ الجرائرا",31,"ر",2,0],["أجيبوا سِراعاً إنّها ساعةُ الوَغَى","وإنّا لَنخشَى أن يطولَ التأهُّبُ",32,"ب",1,0],["أَجيبي دنشوايَ فَإِن تَكوني","عَييتِ عَنِ الجَوابِ فَما عَيينا",33,"ن",2,0],["أَجِيءُ مُحمّداً فأرى أَغَيٌّ","يُرادُ بِمَنْ يَليهِ أم رَشادُ",34,"د",1,0],["أجيبي أين جُندكِ وَاسْأليهِ","لِمَنْ جَمَعَ السِّلاحَ وكيف غابا",35,"ب",2,0],["أَجِيبي أُمَّ كُلثومٍ أَجِيبي","تَرَامَتْ دعوةُ الدَّاعِي المُهيبِ",36,"ب",1,1],["أجيبي لم أر فحشاً","وربّ الشفعِ والوترِ",37,"ر",1,0],["أَجيبوا رَبَّكُم وَتَنَصَّفوهُ","فَإِنَّ العَبدَ أَولى بِالصَغارِ",38,"ر",1,0],["أَجيدَ قَلبُكَ لَمّا جادَهُم مَطَرٌ","أَم فاضَ هَمُّكَ لَمّا غاضَتِ الهِمَمُ",39,"م",1,0],["أجيب أَن افتح يا نَديمُ فإننا","بأمر من الوالي أتيناك نسرع",40,"ع",1,0],["أجئنا نُسائلُ عطفَ الحليف","ونرقبُ منه الندى والنوالا",41,"ل",2,0],["أُجِيدَتْ بمِرّيخِيةِ النّارِ فاغْتَدَى","لها زُحَلِيٌّ في الغَرائِزِ قارِس",42,"س",1,0],["أُجيٍبُ دَعَاءَهَا حَوْلاً فَحَوْلاً","وَأُذْنُ الدَّهْرِ سَامِعَةٌ جَوَابِي",43,"ب",2,0],["أَجِيبُونا إلى ما نَجْتَدِيكُمْ","مِنَ القولِ المُبَيَّنِ والسَّدادِ",44,"د",1,0],["أجئنا نَذْرَعُ الآفاقَ ذرعًا","لتحوينا به الأرضُ القفار؟",45,"ر",1,0],["أجيبي فلي صوت يقطعه الأسى","فقد لذ للقلب المعنى سؤالك",46,"ك",1,0],["أجِيرَانُنَا أذمَعُوا عَنْ زَرُودٍ","رَحيلاً، وَما رابهمْ مِنْ زَرُودْ",47,"د",1,0],["أجِيبُوني أجرِّعكُم هِجَاكُم","وما يَشفي الأوَارُ مِنَ الأوَامِ",48,"م",1,0],["أجيبت بهم في آلِ ساسانَ دعوَةٌ","بخيرِ عبادِ اللَهِ بادٍ وحاضِرِ",49,"ر",1,0],["أجيبُ طيفا زار عن زروةٍ","وأسأل الربعَ وأطلالَهْ",50,"ل",2,0],["أَجيراننا واللَّه إنّي لَخيركم","مُحبٌّ كنفسي إِذ أُحبُّ لَها الخيرا",51,"ر",2,0],["أجيبوا أكان الحب حلماً تبددت","أشعته عند الإقاق من الرقد",52,"د",1,0],["أجيبوا فلى رأيٌ يقرّ إلى مدى","قرار الجراز العضب في سدف الغمد",52,"د",1,0],["أجيرانَ وادي الأثْلِ هَلْ مِنْكُمُ وَصُلُ","لصَبٍّ على فُرقاكم دَمْعُه وَيْلُ",53,"ل",1,1],["أَجيبيهِ أَنّي ما أَزالَ مُقَرِّباً","بِنَفسي إِلى نَجمٍ يُقالُ لَهُ الشعرى",54,"ر",2,1],["أُجيبُ إِلى الرَدى فيهِ وَأَشكو","إِلَيهِ ما أَجِنُّ وَلا يُجيبُ",55,"ب",1,0],["أَجيرانَنا بِالغَورِ لَو أَنصَفَ الهَوى","جَزَيناكُمُ فيهِ دُموعاً وَأَشواقا",56,"ق",2,0],["أجيبوا له يا قومنا حيث قد غدا","إماماً فيا طوبى له ولحزبه",57,"ب",2,0],["أَجيراني بِذي سَلَمٍ عَلَيكُم","وَإِن شَطَّت دِيارُكُمُ سَلامي",58,"م",2,1],["أَجيرانَنا بِالرَقمَتَينِ عَلَيكُمُ","سَلامٌ كَعَرفِ المَندلِيِّ يَفوحُ",59,"ح",1,0],["أُجِيدُ وَسْمَ عُلاكمُ بالمديحِ لها","وأَخرجُ الدَّهرَ من إنعامكمْ عُلُطا",60,"ط",2,0],["أَجيرانَنا أَمّا أَحاديثُ ذِكرِكُم","فَما هِيَ إِلّا لِلعُيونِ مَفاتحُ",61,"ح",1,1],["أَجِئتَ عَلى القَلبِ مُستَأذِناً","فَقَد حَلَفَ القَلبُ لا تَدخُلُ",62,"ل",1,0],["أجيدي المدح ناظمتي أجيدي","لمريم إنها بحر الحُنُوِّ",63,"و",1,1],["أَجيبك عَن قَواف رائِعات","وَما بِالآل عَن ماءٍ بَديل",64,"ل",1,0],["أُجيبُ عن الشِعرِ مُستَرسِلاً","بِطَبعٍ شُجاعٍ وَقَلبٍ جَبانِ",65,"ن",1,0],["أجيبوا عباد اللّه صوت مناصح","دعاكم بصوت ماله من مناصر",66,"ر",1,0],["أجيرةَ القلب والفُسطَاطُ دَارُهُمُ","لم تُصقِبِ الدّارُ لكنْ أصقَبَ الكَلَفُ",67,"ف",1,0],["أجيرةَ قَلبي إن تَدانَوْا وإن شَطُّوا","ومُنيَةَ نَفسي أنْصَفُونِي أو اشْتَطُّوا",68,"ط",3,1],["أجيرةَ قَلبي والّذين هَواهمُ","تَوافقَ إعلانٌ عليه وإسرارُ",69,"ر",1,0],["أجيراننا لما جَفَوْتُم وبِنْتُم","ولم تمنحونا مرةً بلقاءِ",70,"ا",2,0],["أُجيب دواعي الشَّوق حيث دعونني","وإن أكثَرَتْ لومي على الحبِّ لوَّمُ",71,"م",1,0],["أجيرتنا إن فرّق الدهر بيننا","فودّكم في القلب غير مفرّق",72,"ق",1,0],["أجيبوا يا دهاة الار","ض بل يا غصة الألم",73,"م",1,0],["أجيبيني هل الحب انتقاص","لعزتنا فيرفضه الأبي",74,"ي",1,0],["أجيرانَ الحمى مَن لابن ليلٍ","أتى مسترشدا بكُمُ فتاها",75,"ا",3,0],["أجيرانَنا بالغور والركبُ مُتهِمُ","أيعلَمُ خالٍ كيف بات المتيَّمُ",76,"م",1,1],["أجيرانَنا أيامَ جمعٍ تعلّةً","سلوا النَّفْرَ هل ماضٍ من النَّفْرِ راجعُ",77,"ع",1,0],["أجيرانَنا أمسِ جار الفرا","قُ بيني وبينكُمُ واعتدى",78,"د",2,0],["أجيبوني فذا خطب عظيم","مهول وقعه وقع مخوف",79,"ف",1,0],["أجيرانها بالنَّعف ربَّ وسيلةٍ","وبثٍّ إلى جيرانها غير نافع",80,"ع",1,0],["أجيرانَ جيرونَ علَّ الزمان","يقربُ هذا المزارَ الشّسوعا",81,"ع",2,0],["أَجيءُ لِتَنظُرَ مِنّي إِلى","مَليحِ المَعاني",82,"ن",2,0],["أَجيءُ وَإِن كانَ يَومُ الخَميسِ","بِدَأبِيَ في الرايِ وَالأَبرِميسِ",83,"س",1,1],["أَجِئتُ بِذَنبٍ أَم أَتَيتُ بِزِلَّةٍ","فَأَلقاكَ ما بَينَ التَنَصُّلُ وَالعُذرِ",84,"ر",1,0],["أَجِيادُ قُضبٍ في قَلائِدَ لُؤلُؤٍ","وَحَياةُ دَوحٍ في عَصائِبِ عَسجَدِ",85,"د",1,1],["أجيرانَنا بالرقمتينِ نقضتُمُ","عهودي وكم راعيتُ بعدكُمُ العهْدا",86,"د",2,0],["أجيرانَنا صارتْ احاديثُ وصلِنا","لأهلِ الحمى بعدَ التفرُّقِ أسمارا",87,"ر",2,0],["أجيبوا عليلا قد تناسى قضايا الطو","ر مما بدا في العلويات الإنسانيه",88,"ي",2,0],["أجيبوا صريعا ما تواني عن المعا","لي بل يتعالى في اقتناص العنقائيه",88,"ي",2,0],["أجيء إلى الإسكندرية لم تقف","أكف بني المأمون عني ولا العطر",89,"ر",1,0],["أَجِيءُ إلَيْكُمُ إنْ شاءَ رَبِّي","فَمَنْزِلُكُمْ هَواهُ لَنَا قَدِيمُ",90,"م",1,1],["أجِيباني عنِ الموضوعِ فيما","حوارٌ كما جَواب نَهٍ حكيمِ",91,"م",1,1],["أجِيلوا نظرةً بيني بويهٍ","تَرَوْا سَعَةً على ضيق المجالِ",92,"ل",1,0],["أَجيرَتَنا لا جمَع اللَّه شَملَنا","فَما أَنتُمُ إلّا الذّئابُ الأطالسُ",93,"س",1,1],["أَجيرَةَ بَيتي ما لَكُم بِكُمُ السَهوُ","أَمَرَّ لَكُم شَجوٌ وَطابَ لي الشَجوُ",94,"و",1,1],["أُجِيبُ الجوابَ السَّهْلَ عَمَّا سُئِلْتُه","وَإِنَّ الَّذي يُشْكَى إِليْهِ الهَوَى صَعْبُ",95,"ب",1,0],["أَجِيرَانَنَا إِنَّا وَإِنْ بَرَّح الهَوَى","وَعزَّ عَلَيْنَا بُعْدُ مَنْ طَالَ بُعْدُهُ",96,"د",2,0],["أجيبا إلى داعي الهدي وتمنيا","على الله في الفردوس منية عارف",97,"ف",1,0],["أجيرانَ وادي الأثلِ ما فَعَلَ الأثلُ","وَما عِلمُكُم بالرَّملِ هَل سُقيَ الرِّملُ",98,"ل",1,1],["أجيعَ وشاحاهُ نحولاً وأُشبعَت","خَلاخيلُه مِن نعمَةٍ وأساوِره",99,"ر",2,0],["أجيل بها طرفي فينهل فوقها","من العبرات السمط في إثره السمط",100,"ط",1,0],["أجيب اختلاف شروق ذكاء","بيان جلي ونص جليل",101,"ل",1,0],["أجيبك بعد الصمت حيناً وحسبما","دعوت إليه أن أكون مجيبا",102,"ب",2,0],["أجيبي فقد طالت بك العام وقفتي","وطالت مناداتي وطال سؤاليا",103,"ي",2,0],["أُجيلُ في قبرِكِ عينيَّ في","مجالِ أرواحٍ وأمطار",104,"ر",1,0],["أجيلوا عليهم كل غوج 