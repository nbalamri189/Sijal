{"poems":[[55,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[65,"كفي أمميمة غرب اللوم والعذل","https://www.aldiwan.net/poem45834.html","البسيط"],[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[82,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[107,"ألا لا أرى في مصر إلا دعاويا","https://www.aldiwan.net/poem43396.html","الطويل"],[54,"لا صيد إلا بوتر","https://www.aldiwan.net/poem26974.html","مجزوء الرجز"],[48,"الغيب مجهول يحار دليله","https://www.aldiwan.net/poem23025.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[119,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[190,"إذا ما عابني أبناء جنسي","https://www.aldiwan.net/poem43601.html","الوافر"],[208,"قالوا تحب فلا تغار فقل لهم","https://www.aldiwan.net/poem53021.html","الكامل"],[266,"إن مسني بالبؤس دهري دائما","https://www.aldiwan.net/poem38202.html","الكامل"],[376,"إن مس مسقمتي من طرفها سقم","https://www.aldiwan.net/poem57123.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138291",""],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61144","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108529","الوافر"],[1878,"","https://poetry.dctabudhabi.ae/diwan/poem/202472","البسيط"],[1986,"","https://poetry.dctabudhabi.ae/diwan/poem/203835","المجتث"],[2032,"","https://poetry.dctabudhabi.ae/diwan/poem/121984","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87319","الرجز"],[2993,"","https://poetry.dctabudhabi.ae/diwan/poem/147741","المنسرح"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65140","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66581","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114500","الخفيف"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103563","الرمل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94405","البسيط"],[4698,"أنفاسُ أبها ..","https://www.poetsgate.com/ViewPoem.aspx?id=28639",""],[4778,"لكل شيءٍ أوان","https://www.poetsgate.com/ViewPoem.aspx?id=191070",""],[4791,"حكم الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=28438",""],[182,"بصيرا","https://www.poetsgate.com/ViewPoem.aspx?id=72827",""],[4978,"إن مس عين سليمان أخي ضرر","https://www.poetsgate.com/ViewPoem.aspx?id=188885",""],[5376,"كرامةُ النفسِ بالآلامِ تحملُها","https://www.poetsgate.com/ViewPoem.aspx?id=191883",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5512,"يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=205647",""],[5674,"يارب اني قد رجوتك شافه","https://www.poetsgate.com/ViewPoem.aspx?id=201521",""],[5725,"من منكما احلى","https://www.poetsgate.com/ViewPoem.aspx?id=194934",""],[5861,"هذا نداه","https://www.poetsgate.com/ViewPoem.aspx?id=188089",""],[5939,"قوليها","https://www.poetsgate.com/ViewPoem.aspx?id=178586",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5997,"لا تسألي","https://www.poetsgate.com/ViewPoem.aspx?id=214211",""]],"verses":[["إِن مَسَّني نابُ الرَدى لَم أَقُل","يَلَيتَ مَوتي كانَ ميلادي",0,"د",2,0],["إِن مَسَّني العُدْمُ فاِستَبْقي الحَياءَ وَلا","تُكَلِّفيني مَديحَ العُصبَةِ السَّفَلِ",1,"ل",1,0],["إن مسَّهم لفح الهجير أبلّهم","منه نسيم ثنائكَ المعطارِ",2,"ر",1,0],["إن مُسْتنهضيكَ يا حسنَ الحُسْ","نَى لمستنْهضُو فتىً نهَّاض",3,"ض",1,0],["إنْ مَسّني الضرُّ بِقَرْحِ الهَوى","فبرءُ دائي في الشرابِ القراح",4,"ح",1,0],["أَنُمسي عَبيداً يَملِكونَ نُفوسَنا","وَأَموالَنا مِن دونِنا وَالذَرارِيا",5,"ي",2,0],["إِن مَسَّهُ الرامي نَخَر","ذي مُقلَةٍ تَبكي مَدَر",6,"ر",1,0],["إِن مَسَّكُم ظَمَأٌ فَقَولُ نَذيرِكُم","لا ذَنبَ لي قَد قُلتُ لِلقَومِ اِستَقوا",7,"ق",3,0],["إِنْ مَسَّهُ الضَّيْمُ نَاجَى السَّيْفَ مُنْتَصِراً","أَوْ هَمَّهُ الأَمْرُ لَمْ يَعْلَقْ بِهِ الثَّبَطُ",8,"ط",1,0],["ان مسلم اخطأ اعتابه","فهو كئيب خاسر مكمد",9,"د",1,0],["إن مّسه نَصبُ الورودِ فإنه","سيُنيخُ من نعماك في أعطانِ",10,"ن",1,0],["أنمسّ بالنجوم بغير فهم","وأعبث بالتمائم والعطوف",11,"ف",1,0],["إن مَسَّه دَنَسُ الإجارة مرَّةً","فالماء يغسل عذرَ ذاك اذا اغتسلْ",12,"ل",1,0],["إن مسني بالبؤس دهري دائماً","دون الورى فأنا بذاك أفضل",13,"ل",1,1],["إن مسَّ مُسقِمَتي مِن طَرفِها سَقَمُ","فما ألمَّ بها مِن مَسَّه ألَمُ",14,"م",1,1],["ان مسنا فالبرء من رأس إلى","قدم بكل الجسم برقا قد سرى",15,"ر",2,0],["إن مس أن لغير ضر ناله","وكذاك فعل شبيهه يا صاح",16,"ح",1,0],["أنمساوية الجدين إني","أرى بخدودك الورد العجيبا",17,"ب",2,1],["إن مسني من جنابٍ كنت أعهد لي","فيه النعيم تكاليف من الشظف",18,"ف",1,1],["إن مست النار جسمي","أبديت طيب نسيمي",19,"ي",1,1],["إن مسني سغب قراني غربه","أو قلني ظمأ فرى فسقاني",20,"ن",2,0],["أَنّ مَسافَتكَ تزيد أزوَامَا","أُعدادُهَا ثَمَانِيَه تمامَا",21,"م",2,0],["إن مستشير أتاك منتصحاً","فامدد له كيف ما اشتهى الطولا",22,"ل",2,0],["إن مسّ تُونس من عصيانهم سقمٌ","فإنّ طاعتها من بعدُ تشفيها",23,"ي",3,0],["ان مسك الضر فاجأر بالدعاء كما","دعا به المبتلى ايوب ذو السقم",24,"م",1,0],["إِنْ مَسَّ شَمْسَ الضُّحى مِنْ لَمْعِها رَمَدٌ","كَحَلْنَها بِالعَجاجِ الأَعْوَجِيِّاتُ",25,"ت",1,0],["إن مستحسنَ الطباعِ جميعاً","هُوَ ما تُبدي من مُحيا بديعِ",26,"ع",1,1],["إن مسك الليل قد أعقبه","من سنى الأصباح كافورٌ عَبِق",27,"ق",1,0],["ان مسك العشق بحال مفزعه","تثبنى ولا تكوني امعه",28,"ه",1,0],["إن مسَّني العجز في إيفاءِ حقّكَ في","نظمي فعفوك يا مَولاي والسترُ",29,"ر",1,0],["إنْ مَسَّ قطرة ماءٍ منه مُلتبسٌ","أوْ شاغلتهُ طُيوفُ الليلِ في السَّحرِ",30,"ر",1,0],["إن مسّه الخير منّاعا لسائلهِ","أو مسّه الشر أمضى عمره جزعا",31,"ع",2,0],["إن مسحته راح بكفوفٍ تغار","منه لا عانق ورودٍ ناعمات",32,"ت",1,0],["ان مسّني شوق هرعت تحفني","اليك يا بصرى* أقاصيص الزمان",33,"ن",1,0],["إنّ مسّ عينَ سليمانٍ*أخي ضرر","فالقلب منّي لذاك الضر ينفطر",34,"ر",1,1],["ان مسَّها السوءُ ما نامت على شططٍ","كأنَّها رَغَمتْ في بأسها جللُ",35,"ل",1,0],["إنْ مَسهُ الشوْقُ أو أَنَّ الحنينُ بهِ","يَنُضَّه القَلْبُ من وهْجِ الحَشَا بَرْحا",36,"ح",2,0],["إنْ مسَّكِ الضُّرُّ نادي اللَّهَ ضارعةً","أيوبُ ناداهُ لمَّا نالَهُ التعبُ",37,"ب",1,0],["ان مسَّ جسمك وخزةٌ أدميتني","أنت الشجاعة في الورى يا عنترة",38,"ر",2,0],["ان مس جلدى ذرفها فعسى","اطفي لهيبا بالحشى يصلى",39,"ل",2,0],["إن مسّ طرفُكَ ليلةً..سترى له","وهجاً بليلٍ معتمٍ ..لسناه",40,"ا",2,0],["إنْ مَسَّ قلبَكِ الذِّكرَى هيّا فَغنّيها","ما حبُّنا سوَى يَنبوعٍ من مَعانيها",41,"ي",3,0],["إنْ مستشارُ السَّوءِ أوصى بالذي","يُجرِي دمي فالله يَنقُمُ منهما",42,"م",2,0],["إنْ مسَّنِيْ خيرٌ شكرتُ ؛ وإنْ","شرٌّ صبرتُ ؛ لأستزيدَ هُدىٰ",43,"د",2,0]]}