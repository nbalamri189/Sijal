{"poems":[[29,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[92,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[69,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[48,"ألا إنما الدنيا نحوس لأهلها","https://www.aldiwan.net/poem22324.html","الطويل"],[48,"يا سابحا يصهل في غرة","https://www.aldiwan.net/poem22419.html","السريع"],[48,"من عير الخيل إنسانا فقد خبلا","https://www.aldiwan.net/poem23161.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[47,"أخي إنّه يَوْمٌ أضَعتُ بهِ رُشْدِي","https://www.poetsgate.com/ViewPoem.aspx?id=32871",""],[164,"عاملت ربك وانتدبت خصالا","https://www.aldiwan.net/poem58816.html","الكامل"],[190,"يوصونني بالصبر والصبر كاسمه","https://www.aldiwan.net/poem43845.html","الطويل"],[203,"تميل بالأفلاك مثلي آمال","https://www.aldiwan.net/poem45367.html","الطويل"],[396,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[563,"رب موصول هو الناي الذي","https://www.aldiwan.net/poem33891.html","الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199616","المسحوب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132252","الكامل"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138802",""],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105065","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93620","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93681","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32951","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103025","البسيط"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88522","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4554,"","https://poetry.dctabudhabi.ae/diwan/poem/199563","المسحوب"],[1663,"الى امرئ نصبت قحطان رايتها","https://www.poetsgate.com/ViewPoem.aspx?id=93229",""],[5493,"سفر...","https://www.poetsgate.com/ViewPoem.aspx?id=203786",""],[5495,"منو بحالنه","https://www.poetsgate.com/ViewPoem.aspx?id=175423",""]],"verses":[["يُوَصِّلُ حَبلَيهِ إِذا جَنَّ لَيلُهُ","لِيَرقى إِلى جاراتِهِ بِالسَلالِمِ",0,"م",1,0],["يُوصِيكِ أن لا تطعمي","من مالِ رَبِّكِ في حُطَامِ",1,"م",1,0],["يُوصِيكِ أنْ تَدَعي المباهِجَ","واللذائذَ لِلئامِ",1,"م",1,0],["يُوصِي إلى الأُمَمِ الوصايا مِثْلَمَا","يُوصِي الأَبُ البَرُّ الرَّحِيمُ سَلِيلا",2,"ل",2,0],["يُوَصّينَ الرُواةَ إِذا أَلَمّوا","بِشُعثٍ مُكرَهينَ عَلى الفِطامِ",3,"م",1,0],["يُوَصّي الفَتى عِندَ الحِمامِ كَأَنَّهُ","يَمُرُّ فَيَقضي حاجَةً وَيَعودُ",4,"د",1,0],["يوصي الفَتى بِالأَمرِ مِن بَعدِهِ","كَأَنَّهُ مِن بَينِهِ عائِدُ",5,"د",1,0],["يوصي كَبيرُ أَعاديهِ أَصاغِرَهُم","بِقَصدِهِ فَليُعِدَّ النَبلَ وَالنَبَلا",6,"ل",2,0],["يوصل النور بعضهنَّ بألف","من سنينا إلى عيون الرائي",7,"ا",2,0],["يُوصِيكَ بي عَطفُ القرِيبِ، وَمَذهبٌ","في الرّشدِ، سهّلَهُ أمامكَ رَاشِدُ",8,"د",1,0],["يوصى بقتلهم القبائلَ بعضهم","بعضاً لكي يجد والَدْيكَ منَالا",9,"ل",2,0],["يوصونني بالصبر والصبر كاسمه","وهل نافر إلا يعود إلى الصبر",10,"ر",1,1],["يوصدُ أبوابَ السماءِ وإنما","عليهنَّ من هذي الكواكبِ أقفالُ",11,"ل",1,0],["يوصي لأولاد كرام أشراف","فقال قولا فيه عدل وإنصاف",12,"ف",1,0],["يوصل القوت إلى الروح به","من طريق الأذْن فالأذْن فم",13,"م",1,0],["يوص تدبر حجتي بقلبكا","في أسطر البابين قبل بابكا",14,"ك",2,0],["يوصل بعزم وماضيات الحدّي","يثقل ومن ثقله يثقّل غيره",15,"ه",1,0],["يوصف باتّباعهِ","اسلافَه ويُحْمدُ",16,"د",1,0],["يوصي بحفظ الجار وهو كفيله","والله وصانا بحفظ الجار",17,"ر",1,0],["يوصي الاحبة ألا تقبضوا بيد","إلا على الدين في سر وفي علن",18,"ن",1,0],["يوصف فيه بلد مقدس","أو مرسل أو ملك مقرب",19,"ب",1,0],["يُوصي بِها أَشياخَها لِشبابها","حفظاً وَيَعهد للصغير كَبيرها",20,"ر",3,0],["يُوصي بِهِ الماضي لِنيته إِلى","مِن بَعدِهِ فَيَقوم فيهِ وَيَفضل",21,"ل",1,0],["يوصف بالزهدِ وبالعباده","ويتجلَّى بحلى الزهاده",22,"ه",1,0],["يُوصُونَ في حِفظِ الطقوسِ بدِقَّةٍ","شيمٌ تكلُّفُها لقد اعياني",23,"ن",2,0],["يوصيكُمُ الصَبُّ المُقي","مُ بِقَلبِهِ خَيرَ الوَصِيَّه",24,"ه",1,0],["يوصي الأحبة أن لا تقبضوا أبدا","إلا على الدين في سرّ وفي علن",25,"ن",1,0],["يوصي أوائلُم بالقولِ آخرهم","وشرٌ مَن ذاق طعم النُوك مَن شابا",26,"ب",2,0],["يوصل للاسماع من بعد المدى","ما ناطق أراده معتمدا",27,"د",2,0],["يوصي على الوفد الذي ما يزوري","بحر المروة بين مد ويزوري",28,"ي",1,0],["يوصي أكابرهم منهم أصاغرهم","بسورة المجد ان المجد محروس",29,"س",1,0],["يوصيهُ ملحُ الدهرِ ألا ينجلِي","إلا إذا ضاقتْ بهِ الأوصالُ",30,"ل",1,0],["يوصلنه السره ويتاجل الموت","يم اركابنه وتعمه السجاجين",31,"ن",1,0]]}