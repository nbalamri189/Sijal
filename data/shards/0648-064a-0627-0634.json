{"poems":[[85,"أمولاي يا ابن السابقين إلى العلا","https://www.aldiwan.net/poem54264.html","الطويل"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[74,"أيا جنة الحسن التي قد تبرجت","https://www.aldiwan.net/poem19004.html","الطويل"],[26,"أساءلت رسم الدار أم لم تسائل","https://www.aldiwan.net/poem24083.html","الطويل"],[93,"مالي وما للرشء الأغيد","https://www.aldiwan.net/poem8803.html","عموديه"],[72,"وما زلت مذ وافى كتابك واقفا","https://www.aldiwan.net/poem42771.html","الطويل"],[91,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[87,"في القبر أم في فؤادي الواجف","https://www.aldiwan.net/poem7789.html","المنسرح"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[87,"أذعن للحسن عصي العنان","https://www.aldiwan.net/poem63009.html","السريع"],[82,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[46,"أيا زينة الدنيا وجامع شملها","https://www.aldiwan.net/poem29990.html","الطويل"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[71,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[35,"أيا شبه ليلى لا تراعي فإنني","https://www.aldiwan.net/poem25862.html","الطويل"],[77,"وقد كان لي منه شفيع مشفع","https://www.aldiwan.net/poem68933.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[201,"ذري القلب يطوي حبه ويواريه","https://www.aldiwan.net/poem39864.html","الطويل"],[203,"أبيت وجنبي ليس يحويه مضجع","https://www.aldiwan.net/poem45232.html","الطويل"],[203,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[228,"أيا قبلة مرت على ضفتي في","https://www.aldiwan.net/poem41448.html","الطويل"],[275,"القلب حصن حصين","https://www.aldiwan.net/poem35467.html","المجتث"],[302,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[408,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[505,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[510,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[519,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[580,"أيا شمسي منك أشرق بهجة","https://www.aldiwan.net/poem2994.html","الطويل"],[591,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"],[591,"ترى يا جيرة الشعب","https://www.aldiwan.net/poem17973.html","مجزوء الوافر"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107275","الطويل"],[724,"","https://poetry.dctabudhabi.ae/diwan/poem/107161","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145811","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120037","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59150","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59432","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96593","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132811","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102291","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101004","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105233","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109320","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96039","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53192","الوافر"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74284","الطويل"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145868","المتقارب"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124098","البسيط"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125990","الطويل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117029","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74032","السريع"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123945","السريع"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123942","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108329",""],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36714","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135241","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135763","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135731","الرجز"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116864","المتقارب"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29323","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76442","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111434","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101359","الوافر"],[4043,"","https://poetry.dctabudhabi.ae/diwan/poem/92459","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81728","البسيط"],[4320,"","https://poetry.dctabudhabi.ae/diwan/poem/133905","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83405","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77696","البسيط"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147309","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[4717,"وطيفٍ قد سقى سهدي خمارا","https://www.poetsgate.com/ViewPoem.aspx?id=199641",""],[4755,"مُغَرَّبٌ.. إِن حَلَّ, أَو هاجَرَا","https://www.poetsgate.com/ViewPoem.aspx?id=202602",""],[4791,"المجاريح","https://www.poetsgate.com/ViewPoem.aspx?id=28403",""],[4830,"وَحيُ الصَّبابات","https://www.poetsgate.com/ViewPoem.aspx?id=208638",""],[4869,"المال ..","https://www.poetsgate.com/ViewPoem.aspx?id=151709",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[4916,"ياشيب عيني","https://www.poetsgate.com/ViewPoem.aspx?id=135374",""],[4934,"ماني بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=32780",""],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[585,"ألا انظر وسل من شئت كيف الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=161914",""],[585,"لك الله من ربحٍ عددناه مغنما","https://www.poetsgate.com/ViewPoem.aspx?id=161857",""],[5183,"مصاب الدين","https://www.poetsgate.com/ViewPoem.aspx?id=180258",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[5219,"الطاهرة المطهرة","https://www.poetsgate.com/ViewPoem.aspx?id=194998",""],[404,"طيوُر الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=191631",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5431,"إلى الحر الثائر الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=183079",""],[709,"يا عصبة َ الحاجِ هذا لجَّ راحتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2955",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[5848,"الله يخليك","https://www.poetsgate.com/ViewPoem.aspx?id=48823",""],[5969,"ذَكرتُ خيالَ من أمسى هلالا","https://www.poetsgate.com/ViewPoem.aspx?id=198735",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6115,"الكذب شين","https://www.poetsgate.com/ViewPoem.aspx?id=180474",""],[6164,"حب وعرفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66047&r=&rc=56",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""]],"verses":[["ويا شمس هَدْيِ في سماء خلافةٍ","وأبناؤه الزُّهرُ المنيرةُ تجتَلَى",0,"ل",2,0],["وَيا شَرابِيَّ المُصَفَّياتِ","تَكونُ بِالراحِ مُيَسَّراتِ",1,"ت",1,0],["ويا شرعةً للحسن قلبي واجب","عليها متى ممنوع قربك جائز",2,"ز",1,0],["وَيَأشِبُني فيها الأولاءِ يَلونَها","وَلَو عَلِموا لَم يَأشِبوني بِطائِلِ",3,"ل",1,0],["وَيا شِياهاً تَتَّقي صَولَتي","قَلَّمتُ أَظفارِيَ فَاِستَأسِدي",4,"د",2,0],["وَيا شَرَفي إِن كُنتُ أَهلاً لِحاجَةٍ","تُشيرُ بِها أَو كُنتُ أَصلُحُ خادِمَك",5,"ك",1,0],["ويا شعر انت اليوم اكبر مرشد","لمن ضل عن قصد الطريق الملحب",6,"ب",1,0],["ويا شعر حرر ما تشاء من النهى","جزيئاً وبعد من تشاء وقرب",6,"ب",1,0],["ويا شبابا بدا له ثمر","ما كان غير الردى له قاطف",7,"ف",1,0],["ويا شهداء ناجوا بالبقاء","إذا سُمع الملائك هاتفينا",8,"ن",2,0],["وَيا شَديدَ العُجبِ مَهلاً فَما","مِن مُنكِرٍ أَنَّكَ زَينُ الحِسان",9,"ن",1,0],["ويا شؤوني وشأني كُلّهُ حَزَنٌ","فُضّي يَواقِيتَ دَمعي واحبِسي دُرَرك",10,"ك",1,0],["وَيا شَمسَ أَرضيها الَّتي تَمَّ نورُها","فَباهَت بِهِ الأَرضونَ شَمسَ بَهائِها",11,"ا",3,0],["وَيا شائِماً بَرقاً خَدوعاً وَسامِعاً","لِراعِدَةٍ دَجّالَةٍ في الرَواعِدِ",12,"د",1,0],["ويا شرفَ الفتاوىْ والدعاوى","على الدنيا لغيبَتِكَ السلامُ",13,"م",1,0],["وَيا شِبهَ لَيلى أَقصِرِ الخِطوَ إِنَّني","بِقُربِكِ إِن ساعَفتِني لَخَليقُ",14,"ق",1,0],["وَيا شِبهَ لَيلى رُدَّ قَلبي فَإِنَّهُ","لَهُ خَفَقانٌ دائِمٌ وَبُروقُ",14,"ق",1,0],["وَيا شِبهَها أَذكَرتَ مَن لَيسَ ناسِياً","وَأَشعَلتَ نيراناً لَهُنَّ حَريقُ",14,"ق",1,0],["وَيا شِبهَ لَيلى لَو تَلَبَّثتَ ساعَةً","لَعَلَّ فُؤادي مِن جَواهُ يُفيقُ",14,"ق",1,0],["وَيا شِبهَ لَيلى لَن تَزالَ بِرَوضَةٍ","عَلَيكَ سَحابٌ دائِمٌ وَبُروقُ",14,"ق",1,0],["ويا شرفا لا يستخص قبيله","ويا مثلا في الغابرين يسير",15,"ر",1,0],["وَيَا شَرِيكَيْ صَبَابَةٍ وَصِبىً","هُمَا هُمَا الْعُمْرُ أَوْ هُمَا أَغلَى",16,"ل",2,0],["وَيَا شَجْوَ أَطْفَالٍ ضِعَافُ تَرَكْتَهُمْ","وَكُنْتَ عَلَيْهِمْ مُشْفِقاً أَيَّ مُشْفِقِ",17,"ق",1,0],["ويا شرقُ هَلْ سَرَّ الطواغيتَ أنَّها","فويقَكَ أشلاءٌ مبعثرةٌ إربا",18,"ب",2,0],["ويا شعْرُ سارعْ فاقتَنصْ منْ لواعجي","شوارِدَ لا تُصطادُ إنْ لم تُسارِع",19,"ع",1,0],["ويا شبح الموت اذهبي وتصيّدي","عسى ولعلّ السهم يودي براميه",20,"ي",2,0],["ويا شدَّ ما ألقى من الحبِّ وحدهُ","فكيفَ وفي طبعِ الحبيبِ التمنعُ",21,"ع",1,0],["ويا شفةَ الوردِ إما لثمتِ","عيوناً تفتحُ في النرجسِ",22,"س",1,0],["وَيا شُعراءِ الأَرضِ ما أَصدَقَ النَدى","إِذا اِبتَسَمَت لَيلى وَما أَكذبَ الوَرَق",23,"ق",1,0],["ويا شعوراً تدلّت","فيكِ الدُّجى والحنين",24,"ن",1,0],["وَيا شَريفاً حلَّت شهامتُه","بكلِّ مجد ومفخرٍ شيمَه",25,"م",2,0],["ويا شرف الإسلام يا مَنْ صفاته","الحميدة حقّاً ما اجتمعنَ لإنسانِ",26,"ن",1,0],["ويا شامِتاً أَنِّي طَريدُ حِجابِهِ","لِيُخْزِكَ أَنِّي حُزْتُهُ بَيْنَ جَنْبَيَّا",27,"ي",2,0],["ويا شُؤونَ الحادِثاتِ غيرَهُمْ","مُرِّي على بُعْدٍ وأَبْعِدينِي",28,"ن",2,0],["ويا شؤم حربٍ عدتُ منها مُكلَّلاً","بنصرٍ لقاءَه خسرتُ حُروبا",29,"ب",2,0],["ويا شُموسَ الكُماة الشوسِ إن طلَعت","نجومُه في ظلامِ النّقع فاِنكَدري",30,"ر",2,0],["ويا شهدُ أَحلى منكَ عندي مَذَاقَةً","شرابُ رُضاب في مُقبَّلِها العذْبِ",31,"ب",1,0],["وَيَا شَرَفي لَمَّا غَدَوْتَ وَلِلْهَوى","عَلى جَسَدِي المُضْنى النَّحيل رُسُومُ",32,"م",1,0],["وَيَا شَوْقِي إِلى عَيْشٍ","مَضَى في ظِلّهِ الرَّحبِ",33,"ب",1,0],["ويا شهرُ لا تبعُد فأَنتَ وسيلَةٌ","وَذُو قَدَمٍ عندَ الحَبيبِ ادَّخَرنَاهُ",34,"ا",2,0],["ويا شهرُ لا تبعُد لكَ الخيرُ كلُّهُ","فيا رُبَّ محرومٍ بِبِرِّكَ أَولاهُ",34,"ا",2,0],["ويا شهرُ لا تبعُد لَكَ الخيرُ كلُّهُ","فيا رُبَّ مطرودٍ لجا منكَ آواهُ",34,"ا",2,0],["ويا شهرُ لا تبعُد لَكَ الخيرُ كلُّهُ","فيا رُبَّ حِبٍّ تحتَ ظلِّكَ ناجَاهُ",34,"ا",2,0],["وَيا شَيخَنا إِنَّ الفِراقَ أَذابَنا","وَهَدَّ قُوانا وَالتَّصَبُّرَ أَفناهُ",35,"ا",2,0],["ويا شهيداً أمور الدهر منتبهاً","كن حلسَ بيتك جمّ الصمت واعتزِل",36,"ل",1,0],["ويا شجرا ًمِن الأوجا","ع ِعمري فوقه ُغصُنُ",37,"ن",1,0],["ويا شموساً تدعي مثلهم","لو كانَ حقاً كنتِ لم تغربي",38,"ب",2,0],["ويا شرف الحضرتين الذي","بأنوار آرائه يهتدى",39,"د",2,0],["ويَا شَائِد البَيْت الذِي قد تَأسَّسَتْ","عَلَى هَامَةِ النجم السعيد قَواعِدُهْ",40,"د",2,0],["ويا شاهدا بالحق يا مرسلا دعا","لنيل حلال واجتناب محارم",41,"م",1,0],["ويا شمس السعود بلا غروب","ويا بدر السرور بلا سرار",42,"ر",1,0],["ويا شَفَتَى مىٍّ أَمَا لي إليكما","سبيلٌ وهذا الموتُ قد حلَّ دانيا",43,"ي",2,0],["ويا شَفَتَى مىٍّ أَمَا تَبذُلان لى","بشىءٍ وإن أَعطَيت أَهلى وماليا",43,"ي",2,0],["ويا شمس لا تجري على غير مخلص","بطاعته يدعو بها ويُجيبُ",44,"ب",1,0],["ويا شفاء النفس لو أنه","كان طبيب الداء من أمرضا",45,"ض",2,0],["ويا شادياً يروي الصدى صوتُ عوده","لعمري لقد غنَّيت غيرَ سَميع",46,"ع",1,0],["ويا شَبَحي العَوّاقَ لي عن مآرِبي","عَدِمْتُك بِنْ ما أَنت من قُرَنائي",47,"ا",2,0],["ويا شجرات البان من سفح رامة","أفيكن ظلّ للظبا الخفرات",48,"ت",1,0],["ويا شتان ما بين المعالي","وبين ألي الدناءة والحقارة",49,"ر",2,0],["ويا شمساً بها تجلى الدياجي","رماها الدهر عنها بالمغيب",50,"ب",1,0],["ويا شوق البلاد إلى مليك","يعالج من ممالكها سقاما",51,"م",2,0],["وَيا شموس المَعالي ان حددت اسى","بمثل حلته السوداء فاِشتملي",52,"ل",2,0],["وَيا شَمسها إِن حَل في الحُوت شَمسها","وَيا بَدرها الوَضاح إِن كسف البَدر",53,"ر",1,0],["ويا شعلة العز والمكرمات","ويا وحدة الشمل بعد الشتات",54,"ت",1,0],["ويا شفيع الورى في الهول والفضلا","كلّ تذكر ما قد قال أو فعلا",55,"ل",2,0],["ويا شبها في الطبع والوضع أننا","لعود ليالينا نعدّ الثوانيا",56,"ن",3,0],["وياشافعا في الخلق وقت معادهم","إذا زلت الأقدام والنار تزحف",57,"ف",1,0],["وَيا شَفيع المُذنِبينَ اِستَجِب","دَعوة حيّ آنس الحتفا",58,"ف",2,0],["ويا شقيق الخد حتى متى","تعذب الطرف وطرفي جنى",59,"ن",2,0],["ويا شرق كم يبقى بك الشر فاشيا","ويرجع باغي الخير عندك فاشلا",60,"ل",2,0],["ويا شلت يداً أولتك سوءاً","وما هي من عبيدك بالسواء",61,"ا",2,0],["ويا شاعراً عن حسن منظومه روت","اساور درٍ في يدي غادة الخدرِ",62,"ر",1,0],["وَيا شَباباً كَطيفٍ زارَني وَمَضى","هَل كُنتُ إِلّا لِعَينِ اللَهوِ إِنسانا",63,"ن",2,0],["ويا شمس حق الهاشمي محمد","لتظهر علينا في غيوب ومشهدِ",64,"د",1,0],["ويا شكورُ فاجعلنِّي شاكرا","لك بإصلاح المراد ظاهرا",65,"ر",2,0],["ويا شديدُ للعِدا أهلكْ بضارْ","يا نافعٌ واجعلْ إلينا النفعَ سارْ",66,"ر",1,0],["ويا شبه البدر في المدجنات","ويا خلف الغيث في الممحلاتُ",67,"ت",1,0],["وَيا شُعلَةَ النوتي تَخفِقُ في الدُجى","وَقَد هاجَمَتها الريحُ وَالنوءُ صافِرُ",68,"ر",1,0],["وَيا شرق قف واتبع صديقك واعتبر","فحتام في فرش الشقا تتقلب",69,"ب",1,0],["ويا شَمساً عَلِيمَةَ كُلِّ فِعلٍ","ويا ذِي الأَرضُ يا كُلَّ النُّهُورِ",70,"ر",1,0],["ويا شمساً تحجبها المنايا","برغمي أن تكور بانكساف",71,"ف",1,0],["ويا شد ما أغرته قرطبة وقد","أبشرتها خيلنا فكان لك الدر",72,"ر",1,0],["ويا شقيقةَ بدر التمِّ لو أمِنَتْ","كما أمنتِ بدورُ التم نقصانا",73,"ن",2,0],["ويا شرق لاسترداد عزك فانتبه","فذي فرصة إن جزتها اليوم تندم",74,"م",1,0],["وَيا شَفيع الوَرى قد جِئت مُعتَرِفاً","بِالذَنبِ فَاِشفَع بِمَن قد جاء مُعتَرِفا",75,"ف",2,0],["وَيا شَباباً ذَوى هَل كَرّة أَبَداً","وَيا خَليطاً نَأى هَل أَنتَ مُرتَجَعُ",76,"ع",1,0],["ويا شمس السنين المشرقات","أأخفيت السنا عن سنبلاتي",77,"ت",2,0],["ويا شموع الشقيقَ فاشتعلي","ويا بنانَ المنثورِ فاختضبي",78,"ب",2,0],["ويَا شَمْسَ المَآقِي مَنْ لِقلبي","إِذَا مَا ضَلَّتِ الْحَدَقُ الْمَدَارَا",79,"ر",2,0],["ويا شَظَايَا الحَربِ في صَدرِ ه","ذا الشَّعبِ, هل مِن حاقِنٍ ما جَرَى؟!",80,"ر",2,0],["ويا شعرها لا تنثني لي مع الريح","صورتك طول فراقنا مامسحها",81,"ح",3,0],["وياشراعاً له تنقادُ ذي سُفُني","متى وأينَ يشا أُلقي بمرساتي",82,"ت",2,0],["وياشيب عين الحُر لاذاق الافلاس","يلعن ابو حظ الليال اللعينه",83,"ن",2,0],["ويا شَلّالَ أفكاري","على الأذهانِ يَنْسكبُ",84,"ب",1,0],["وياشيب عيني كل ما اسج الاقدام","الدرب ضايع واسود الليل توّه",85,"و",2,0],["ويا شباب اليوم بسكم من تحجج بالمهور","اختر البنت الشريفة واستخر رب العباد",86,"د",1,0],["ويا شباب بني قومي لكم علمٌ","فوق الرؤوس فصونوا ذلك العلما",87,"م",2,0],["ويا شد ما صحتم لتفريق عنصرٍ","من العرب التفت عليه العناصر",88,"ر",1,0],["ويا شرق إن تغض العيون على القذى","غدوت بأيدي الغرب نهباً مقسما",89,"م",2,0],["ويا شيبة الحمد احتمل نبأة الأسى","فانك عمرو الملك غيل قصيره",90,"ر",2,0],["ويا شفار الجفون السمر قَدْكِ ففي","لحاظك البيض بالأقدام كم تثب",91,"ب",1,0],["ويا شقوة الساعي بنيل عفافها","أصاخ إلى قولِ الوُشاة الأراذلِ",92,"ل",1,0],["ويا شمس الجوى عودي","أذاب الصهدُ وجدانا",93,"ن",2,0],["ويا شعلة للهدى لم تزل","تضيء من الزمن الغابر",94,"ر",1,0],["وياشهماً أغراً حين تبلو","بلاء السهم في جوفِ الخفايا",95,"ا",3,0],["ويا شموسَ الكماة ِ الشوسِ إنْ طلعتْْ","نجومهُ في ظلامِ النَّفعِ فانكدري",96,"ر",2,0],["ويا شهيداً شرى أخراه محتسباً","لله ما صده كيد لمنتقم",97,"م",1,0],["ويا شوقنا للصحب في غمرةِ الرَّدى","وفي هدأة المثوى وفي رقدةِ العفر",98,"ر",1,0],["ويا شينها لا صارت أرضك منافيك","غريب في أرضك وناسك ودنياك",99,"ك",1,0],["ويا شَجَرَ المُسافِرِ عَنْ حِمانا","يُسلينا فَيهدينا ظِلالا",100,"ل",2,0],["ويا شغفًا رأينا فيهِ حُضنًا","يزيحُ المُغرياتِ ويحتوينا",101,"ن",2,0],["وياشينها لاشفت شايب عقله اصغر من صغير","ماقدّر الشيب الذي في وسط راسه له سنين",102,"ن",1,0],["ويا شِعْرُ هل لي أَنْ أَبُوحَ بِمُضْمَرٍ","من الحُبِّ أَصْلاني الذي لم أَكُنْ أصْلى!",103,"ل",2,0],["ويا شوق هل حد ويا سقم هل شفا","ويا صبر هل تدنو ويا دمع هل تجدي",104,"د",2,0]]}