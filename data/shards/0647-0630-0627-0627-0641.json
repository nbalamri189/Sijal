{"poems":[[280,"بشرى بإسفار صباح النجاح","https://www.aldiwan.net/poem25599.html","السريع"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127947","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126198","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114198","المجتث"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76724","الكامل"]],"verses":[["هَذا افتِتاحُ الصَومِ مُسْتَقبَلاً","عَن اختِتام بِالرّضى وافتِتاح",0,"ح",1,0],["هذا أفندينا الذي خضعت له","شم الملوك الغلب ابراهيم",1,"م",1,1],["هذا إفتِقارُ العبد للالهِ","يَسألُهُ فَوائدَ انتِباهِ",2,"ه",1,0],["هَذا افتِقَارِي وَحَالِي","مِنِّي بِهِ أنتَ أدرَى",3,"ر",2,0],["هذا أفاد وفاد غير مقصر","جهد المقل بان يموت مغوّضا",4,"ض",2,0]]}