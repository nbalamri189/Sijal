{"poems":[[55,"أيا أثلات القاع كم نضح عبرة","https://www.aldiwan.net/poem29874.html","الطويل"],[72,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[76,"ألا ساجل دموعي ياغمام","https://www.aldiwan.net/poem13249.html","الوافر"],[50,"ألا يا قمر الدار","https://www.aldiwan.net/poem63348.html","الهزج"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[234,"يا شاعرا جل عن أن","https://www.aldiwan.net/poem51265.html","المجتث"],[257,"بكا آمناً أن صار ستراً عَلى الحب","https://www.aldiwan.net/poem1439.html",""],[358,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[422,"أقول لسعد حين لام على الهوى","https://www.aldiwan.net/poem53950.html","الطويل"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[591,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107208","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64561","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49965","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81895","الطويل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101570","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118957","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135786","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135763","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5461,"زايل الشر ردا على قصيدة الأمير (سلطان بن عبد العز","https://www.poetsgate.com/ViewPoem.aspx?id=5063",""]],"verses":[["وَيا ظُعُناتِ الحَيِّ يَومَ تَحَمَّلوا","عُقِرتِ وَأَفنى اللَهُ نَسلَكِ مِن إِبلِ",0,"ل",1,0],["وَيا ظَبَياتِ الجِزعِ يَسنَحنَ غُدوَةً","لَقَد طُلَّ مَن تَرشُقنَ بِالأَعيُنِ النُجلِ",0,"ل",1,0],["وَيا ظَبيُ لَولا أَنَّ فيكَ مَحاسِناً","حَكَينَ الَّذي أَهوى لَما كُنتَ توصَفُ",1,"ف",1,0],["وَيا ظِلَّ الشَبابِ وَكُنتَ تَندى","عَلى أَفياءِ سَرحَتِكَ السَلامُ",2,"م",1,0],["وَيا ظِلَّةَ أَغصانٍ","عَلى شاطِءِ أَنهارِ",3,"ر",1,0],["ويا ظهرة الإيمان هل فيك منعة","وهيهات عزت منعة وظهير",4,"ر",1,0],["ويا ظريفاً بليغاً","أَرْبَى على البُلَغاء",5,"ا",2,0],["وَيا ظَمأي بينَ التَحجُّبِ وَالنَوى","إِلى زَمَني بَينَ التَجَنّب وَالعتبِ",6,"ب",1,0],["وَيا ظَبياً أَصرَّ عَلى تلافي","وَآيات التَجافي قَد تَلا لي",7,"ل",2,0],["ويا ظبية الوعساء من جانب الحمى","بَخلْتِ ولي دمع عليك كريم",8,"م",1,0],["ويا ظَمائي هذه شريعةٌ","يدعو إليها الواردين من صَدَرْ",9,"ر",1,0],["ويا ظالم المسكين والله أنّه","عليك ثقيل كالجبال وأكبرا",10,"ر",2,0],["ويا ظاهرُ اجعلني بأمرك ظاهراً","ويا باطنُ ارفع غفلتي والتلاهيا",11,"ي",2,0],["وَيا ظِباءَ الحِمَى لَا السَّرْبُ يُطْمِعُنِي","مِنْهُ السَّرابُ وَلَا مِنْ جِيرة الحَوَرُ",12,"ر",1,0],["ويا ظباءٌ غرّها جيدُها","ما أنت إلا ضحكة العُرّبِ",13,"ب",1,0],["وَيا ظَبيَةً فيها المَحاسِنُ جُمِّعَت","وَفي مِثلِها خَلعُ العِذارِ يَطيبُ",14,"ب",1,0],["ويا ظبية قد ساوم الظبي جيدها","بلا حضرو للظبي جيدك أوسم",15,"م",1,0],["ويا ظبى لحظه في غمد شرفته","أما أوتكم من العشاق مهجات",16,"ت",1,0],["ويا ظاهر اجعلني بنورك ظاهراً","على كل مخفي الظهور وما انجلى",17,"ل",2,0],["ويا ظبيةَ الأنس ارْعيي المرخَ وارتعي","بلا أَن تُراعي مالكِ اليوم صائدُ",18,"د",1,0],["وَيَا ظَاهِرُ أَظِهرْ لِي مَعَارِفَكَ التي","بِبَاطِنِ غَيْبِ الْغَيْبِ يا بَاطِنٌ وَلاَ",19,"ل",2,0],["ويا ظبيات الأنس نفراً عن الذي","يحب التي من حبه قلبها خالي",20,"ل",2,0],["ويا ظباء حاجر","ناشدْتُكن بالله",21,"ل",2,0],["ويا ظاعنين وما عرجوا","ومنثور دمعي كدرِّ العقود",22,"د",1,0],["ويا ظهير يا خبير يا زكي","فاكفنا شرَّ من شكا ومن شُكي",23,"ي",1,0],["ويا ظاهرٌ أيِّد لكلٍ جميعنا","بنصرٍ على الأعداء في الصبح والظهر",24,"ر",1,0],["ويا ظهيرُ أظهرنَّ نصري","بنيل ما أريده في الدهرِ",25,"ر",1,0],["ويا ظلمة الليل لا تبرحي","فقد غُيّبَ الفجر تحت الثرى",26,"ر",2,0],["ويا ظاهر يأبى الكمون ظهوره","ويا باطن حارت عقول الورى تاهوا",27,"ا",1,0],["وياظلال الوجيه اللي شوتها السمايم","مالقت بالمظامي مزبن تستجيره",28,"ر",2,0]]}