{"poems":[[55,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[74,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[53,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[93,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[64,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[47,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[68,"مغانم صفو العيش أسنى المغانم","https://www.aldiwan.net/poem38478.html","الطويل"],[68,"مباضع إسحاق الطبيب كأنها","https://www.aldiwan.net/poem38613.html","الطويل"],[17,"إذا المرء لم يدنس من اللؤم عرضه","https://www.aldiwan.net/poem1201.html",""],[52,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62237","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42604","الطويل"],[173,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[240,"بالقصر من بغداذ لا بطياس","https://www.aldiwan.net/poem31591.html","الرجز"],[266,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[280,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[287,"ذكر الصبا منه لي هاجت صبابات","https://www.aldiwan.net/poem32859.html","البسيط"],[309,"ما في الوجود ولا في الكون من أحد","https://www.aldiwan.net/poem16764.html","البسيط"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[369,"تصرف أحوالي على حكم أيامي","https://www.aldiwan.net/poem60644.html","الطويل"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[369,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[376,"لا تستطل بالذي تأتي به السحب","https://www.aldiwan.net/poem57528.html","البسيط"],[409,"عساه يرضى المغضب","https://www.aldiwan.net/poem34160.html","مجزوء الرجز"],[445,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[469,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[482,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38707","الطويل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34765","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46706",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64570","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50021","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122011","الطويل"],[1476,"","https://poetry.dctabudhabi.ae/diwan/poem/72993","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82550","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79902","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49543","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69317","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46459","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53199","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93738","البسيط"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100439","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75953","الرمل"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20700","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144166","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100200","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89117","الرجز"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131238",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135743","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135864","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135280","الرجز"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40158","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77141","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119605","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127227","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133142","المجتث"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101302","الخفيف"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99102","الطويل"],[4764,"مع ونات اشواقي","https://www.poetsgate.com/ViewPoem.aspx?id=25230",""],[5180,"عمان انهضي واستنهضي الشرق والغربا","https://www.poetsgate.com/ViewPoem.aspx?id=124951",""],[5313,"وبلدة قطعتها بضامر","https://www.poetsgate.com/ViewPoem.aspx?id=181095",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5591,"يالمنترب لبستك لباسين","https://www.poetsgate.com/ViewPoem.aspx?id=194067",""],[5992,"مُحَدَّبٌ عيناهُ في رأسِه","https://www.poetsgate.com/ViewPoem.aspx?id=41831",""],[463,"حماها بأطراف الرماحِ حماتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59996&r=&rc=52",""]],"verses":[["مُعَوَّدونَ مِنَ الأَيّامِ مَرتَبَةً","لا يَستَطيلُ إِلَيها كُلُّ صِنديدِ",0,"د",1,0],["معوّد سحر البيان فبينما","تروق ذوي الألباب أمست تروعها",1,"ع",3,0],["مُعَوّلاتٍ على غيثٍ تَيَمَّمُهُ","ما آب رائدُهُ إلا بإحمادِ",2,"د",1,0],["مُعَوَّدِ الإِلجام وَالإِسراجِ","وَالوَخد وَالذَميل وَالإِهماجِ",3,"ج",1,0],["معوَّدةٌ ألّا تُذَمَّ دموعُها","على السرِّ حتى السرُّ عُرْيانُ ذائِعُ",4,"ع",1,0],["مُعَوَّلُ آمالٍ يَرُحنَ نَسيئَةً","وَيُصبِحُ مُنسوها مَلِيّينَ بِالنَقدِ",5,"د",1,0],["مُعَوَّدَةٍ بِالبَسطِ إِلّا إِذا غَدَت","بِمَتنِ يَراعٍ أَو بِقائِمِ صارِمِ",6,"م",1,0],["مُعَوَّدَةٌ أَلّا تُسَلَّ نِصالُها","فَتُغمَدَ حَتّى يُستَباحَ قَتيلُ",7,"ل",1,0],["مُعَوَّدَةٌ أَلّا تُسَلَّ نِصالُها","فَتُغمَدَ حَتّى يُستَباحَ قَبيلُ",8,"ل",1,0],["مَعوجٌ إِذا أَمسى طَروبٌ إِذا غَدا","مُجِدّاً كَما غَنّى عَلى الأَيكِ أَخطَبُ",9,"ب",1,0],["مُعَوَّلٌ حِينَ يَسْتَوْلِي بِرَاكِبِهِ","خَرْقٌ كَأَنَّ مَطَايَا سَفْرِهِ هِيمُ",10,"م",1,0],["مُعَوَّدةٌ أَلَّا تَكُفَّ عِنَانَهَا","عَنِ الْجِدِّ إِلَّا أَنْ تَتِمَّ أُمُورُ",11,"ر",1,0],["مُعَوَّدَةٌ قَطْعَ الْفَيَافِي كَأَنَّهَا","خُدَارِيَّةٌ فَتْخَاءُ لَيْسَ لَهَا وَكْرُ",12,"ر",1,0],["مُعَوَّدَةٌ نَصرَ الإِلَهِ فَما غَزَت","مَنيعَ حِمىً إِلّا اِنثَنَت بِالغَنائِمِ",13,"م",1,0],["مَعَوَّدٌ ضَراعَةَ المَكّاسِ","كَفّاهُ لا تَدِرُّ بِالإِبساسِ",14,"س",1,0],["معودة ان تشرأب إلى السرى","كأني من جور الرباط اجيرها",15,"ر",3,0],["معودة أن تسترد عطاءها","فمن كان منها آخذا كان تاركا",16,"ك",2,0],["مُعَوَّدَةً سَبْيَ النفُوسِ وَقَتْلَها","وَمَا عَرَضَتْ جَيْشاً وَلا عَرَفَتْ غَزْوَا",17,"و",2,0],["معوَّدوا النَّصر مَحمودٌ بلاؤُهُمُ","وَالخَيلُ تَعثُرُ بِالأَشلاءِ وَالقُلَلِ",18,"ل",1,0],["مُعَوَّداً لفعالِ الخَيرِ قَدَّمَهُ","قُدّامَهُ فَلَهُ في الخَيرِ عاداتُ",19,"ت",1,0],["مَعولونَ عَلَيَّ إِحسانَهُ فَقراً","لِفَيضِ أَفضالِهِ يا نِعمَ مِن صَمَدِ",20,"د",1,0],["مُعوّدةً ما إن تغبّ عنِ الونى","ولا تَنثني يوماً وصايا من اللغبِ",21,"ب",1,0],["مُعوَّدةً في الجودِ والبأسِ والعُلا","لكُلِّ افتخارٍ وانتقامٍ وإنعام",22,"م",1,0],["مُعوِّدَةٌ أن تَنْثُرَ الدُّرَّ كَفُّه","لنا الكَلِمُ الأعلَى منَ القلَمِ الأعلى",23,"ل",2,0],["مُعوَّدةٍ ألا تَزالَ بنَجْمِها","رَجيماً إذا شيطانُ شَغْبٍ تَمَرّدا",24,"د",2,0],["معوّداً أن يفوتَ الناسَ كلهم","سَبقاً ويُدرِكه في مالِه الطَّلبُ",25,"ب",1,0],["مع وقار كامل","واللّه من هذا العجب",26,"ب",1,0],["معوَّذةٍ لَمْ يَسْرِ خطبٌ بِأَرْضِهَا","ولا عَرَفَتْ بالدَّهْرِ كَيْفَ نوائِبُهْ",27,"ب",2,0],["معودة طردَ العيوب غيوبُها","إذا حفِظتْ عوارتِها أسَلاتُها",28,"ت",3,0],["معوَّفة من صنعة الجود والحيا","وشائعها والجودُ ربُّ وشائع",29,"ع",1,0],["مُعَوَّدَةٌ أن تتركَ البيضَ في الوغى","محطمةً والسمهريَّ مُكَسَّرا",30,"ر",2,0],["مَعونَةً أَرجو لَها التَنفيسا","عَن مُهجَةٍ قارَبَت النَسيسا",31,"س",2,0],["مُعوَّدةٌ أَن لا تُسَلّ نِصالُها","وَفي حَدّها ماءُ المَنايا يَسيلُ",32,"ل",1,0],["مُعَوَّذَةُ الأَرحالِ لَم تَرقَ مَرقَباً","وَلَم تَمتَطِ الجونَ الثَلاثَ الأَثافِيا",33,"ي",2,0],["معوّج الرأسِ مسودٌّ بهِ نُقَطٌ","لكنَّ أسفلَه في هيئةِ القَدَمِ",34,"م",1,0],["معوقة قصدي مضيق رحابها","تناصبني رغم الأماني حرابها",35,"ه",2,0],["معودَّةٌ للبرِّ حينَ أَتيتَهُ","وجدت لَديهِ البشرَ والنائل الجَزَلا",36,"ل",2,0],["مُعَوَّدَةٌ طَعْنَ الْفَوَارِسِ فِي الْوَغَى","وَضَرْباً بِهِ قَدْ جَرَّحَ الدَّارِعَ الجُرْحُ",37,"ح",1,0],["مُعَوَّدَةٌ يوم النِّسار وبعدَهُ","إذا بَرَقَت بالموت يَصدُقُ خالُها",38,"ل",3,0],["معوِّدتي الغفرانَ لِلذَّنب وَالرِّضى","أَسَأتُ فُقولي قَد وَهبتُ لَكَ الذَّنبا",39,"ب",2,1],["مُعوَّدةً سبقَ السؤالِ صِلاتُها","فإن هي لم تسبق وإلاّ استراثها",40,"ث",3,0],["مُعَوَّدَةٍ عقراً وبذلاً كرامُها","لضَيفٍ وعافٍ من مُقِلٍّ ومُلفجِ",41,"ج",1,0],["معودةٍ ألاَّ تطبِّقَ روعةٌ","بها مذهباً والموت شتى المذاهب",42,"ب",1,0],["مُعَوَّدِينَ لِبَذلِ المالِ قَد جَعَلُوا","في رِزقِ كُلِّ عَدِيمٍ كُلَّ ما رُزِقُوا",43,"ق",3,0],["مَعَوَّدَةٌ بِهِم خَوضَ المَنايا","فَقَد عَرَفَت كَما عَرَفُوا القِتالا",44,"ل",2,0],["مُعَودةً أَن لا تَسيل نصالها","فَتَعمدَ حَتّى تُستَباح قَبيل",45,"ل",1,0],["معوّد باحتمال العبء مُدَّرع","بالحزم لم يثنه عن مطلب سأم",46,"م",1,0],["معوَّقات عَن المَسرى كَواكبُه","كَالذود عوَّقه الراعي لِيُحصيه",47,"ي",2,0],["معوَّضاً عن السرير الفاني","بسررٍ تبقى مدى الأزمان",48,"ن",1,0],["معوذاً بقل هو اللضه أحد","من شر كل حاسد إذا حسد",49,"د",1,0],["مَع وَامَلُول وَهِيَ الشَّمَالِيَه","أمَّا الجَنُوبِيَه بُعَيدَ فَامِيَه",50,"ه",1,0],["مَعَ وِلدان وَحورٍ","قاصِراتِ الطرفِ نفسِ",51,"س",1,0],["مُعَوَّداتٌ جِراحاتِ الخُدودِ إِذا","كانَ اللقاءُ وَطَعناً في مَآقيها",52,"ي",3,0],["معوَّدة هتك الجماجم أظهرت","سبيل امامينا خليل وراشد",53,"د",1,0],["معوّدةٌ ألا تجوسَ عمارةً","فترجَلَ إلا وهي من سكنِها قفْرُ",54,"ر",1,0],["معودة على أن لا تبالي","بفري مفاوز ناء مداها",55,"ا",3,0],["معودٍ في القطر بالمرورِ","مستظهراً غوامض الأمور",56,"ر",1,0],["معود أن يرد الخيل عابسة","في كل ثغر بثغر النصر مبتسم",57,"م",1,0],["معودةٍ إلا تباهي تربها","بغير دلالٍ يستثير هوى الصب",58,"ب",1,0],["معودةٌ أن تستذل وتزدري","فترضى ولا تنزو بها غضبات",59,"ت",1,0],["مع والديَّ وبنيَّ إخوتي","وكلّ من أحبّني ونسوتي",60,"ي",1,0],["مع والديَّ ومحبيّ التابعِ","صلِّ وسلِّمَنْ لطه الشافعي",61,"ي",1,0],["مع والديَّ ومع الولدانِ","وإخوتي محبّي في الزَّمانِ",62,"ن",1,0],["مُعَوَّدةً أَنَّها لا تُسَل","لُ إِلّا مُقَمقمةً لِلقِمَم",63,"م",1,0],["مُعَوَّدَة بَسطاً سِوى قَبضُها عَلى","أَعِنَّةٍ قَب الَعوجيات وَالجَردِ",64,"د",1,0],["معوَّدَة تحت الأسنّة والظُبا","ومسنونةٍ زُرق كأنياب أغوال",65,"ل",1,0],["معودة ان لا تسل نصالها","فتغمد حتى يستباح قتيل",66,"ل",1,0],["معوَّدةٌ خوضَ النّجيعِ من العدى","إذا انتجعَتْهُ أَلسنُ السُّمرِ بالوَخضِ",67,"ض",1,0],["مع ودق السحاب","ولبس عالي الثياب",68,"ب",1,0],["معولاً للكرام بالنوح أدمن","وأبح للدموع في كل موطن",69,"ن",1,1],["معوّدةٌ غصب العقول كأنّما","لها عند أرباب الرجال ودائعُ",70,"ع",1,0],["مَعَ .. وَناتِ أشواقي .. تِزيد الرَغبة .. في حلومي","وأنا كِلي حِكاية حِلم .. قَبل لا اكون إنسانه",71,"ن",2,1],["معوّدة أسيافهم ورماحهم","إلى اليوم في أيديهم تطعن القلبا",72,"ب",2,0],["معوداً بل سفتها بباتر","مهند يفري الطلى رسوب",73,"ب",1,0],["معودة تبدي الأذى عن طبيعة","بها غرست من قبل لا عن تطبع",74,"ع",1,0],["معولات بصراخ فادح","بشظايا مهجة الدين زنادا",7