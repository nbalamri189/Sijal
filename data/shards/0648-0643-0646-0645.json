{"poems":[[59,"قلبي برحمتك اللهم ذو أنس","https://www.aldiwan.net/poem24682.html","البسيط"],[44,"أحبب إذا أحببت حبا مقاربا","https://www.aldiwan.net/poem50403.html","الطويل"],[9,"ذريني لك الويلات آتي الغوانيا","https://www.aldiwan.net/poem21989.html","الطويل"],[53,"مواهب وهاب وقى بعضها بعضا","https://www.aldiwan.net/poem64942.html","الطويل"],[53,"مدحتك أكلأ النسرين ليلي","https://www.aldiwan.net/poem66705.html","الوافر"],[80,"فديت أبا عمرو من فتى","https://www.aldiwan.net/poem14181.html","المتقارب"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[64,"إذا ما لم تكن ملكا مطاعا","https://www.aldiwan.net/poem52352.html","الوافر"],[60,"إذا كنت في نعمة فارعها","https://www.aldiwan.net/poem30879.html","المتقارب"],[60,"وكن معدنا للحلم واصفح عن الأذى","https://www.aldiwan.net/poem30978.html","الطويل"],[60,"ترد رداء الصبر عند النوائب","https://www.aldiwan.net/poem31184.html","الطويل"],[68,"زمان الربيع","https://www.aldiwan.net/poem40962.html","المتقارب"],[54,"يا رب قد أبلاني","https://www.aldiwan.net/poem26628.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42588","الوافر"],[60,"وَكُنْ مُوسِرا شَئْتَ أو مُعْسِرا","https://www.poetsgate.com/ViewPoem.aspx?id=22817",""],[124,"سيل همومي قد طغى عبابا","https://www.aldiwan.net/poem49337.html","الرجز"],[132,"أأحبابنا منكم حياة لنا الوصل","https://www.aldiwan.net/poem50554.html","الطويل"],[164,"لقد أسرفت في بخس حظي وواجبي","https://www.aldiwan.net/poem59002.html","الطويل"],[164,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[173,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[189,"وحمام إذا ما كنت فيه","https://www.aldiwan.net/poem14083.html","الوافر"],[190,"هذا زمان له طريق","https://www.aldiwan.net/poem43533.html","مخلع البسيط"],[190,"لا تصحبن اميرا","https://www.aldiwan.net/poem43753.html","المجتث"],[236,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[276,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[309,"هون عليك نائب الدهر","https://www.aldiwan.net/poem16815.html","السريع"],[310,"ينهي إليك سلاما جارك الجنب","https://www.aldiwan.net/poem56608.html","البسيط"],[382,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[426,"وكن معدنا للحلم واصفح عن الأذى","https://www.aldiwan.net/poem4855.html","الطويل"],[443,"ترفّق فذا قلب على العذل لا يقوى","https://www.aldiwan.net/poem2504.html","الطويل"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[487,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[487,"يا ربنا اجعل خير عمري آخره","https://www.aldiwan.net/poem24529.html","عموديه"],[505,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[505,"بمعراجنا طر أنت للفلك الأعلى","https://www.aldiwan.net/poem37813.html","الطويل"],[505,"هذي العزيمة لما طار طائرها","https://www.aldiwan.net/poem38053.html","البسيط"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[556,"أؤمل أن أعيش ودون عيشي","https://www.aldiwan.net/poem47738.html","الوافر"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[563,"تمسك بغيب الغيب واترك سواه لا","https://www.aldiwan.net/poem33575.html","الطويل"],[563,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86752","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71009","المواليا"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129563","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59067","البسيط"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112743","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112961","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115983","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95580","الرجز"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121874","الطويل"],[2063,"","https://poetry.dctabudhabi.ae/diwan/poem/203938","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53038","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28026","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27539","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124768","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124785","الوافر"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103714","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137115",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94287","المتقارب"],[2993,"","https://poetry.dctabudhabi.ae/diwan/poem/147741","المنسرح"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74202","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11316","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62845","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63014","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126918","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86292","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21430","الطويل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122232","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135614","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70154","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77179","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77166","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127175","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93252","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123504","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45931","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133123","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113825","الوافر"],[408,"أضعت العمر في إصلاح حالك","https://www.poetsgate.com/ViewPoem.aspx?id=6955",""],[4767,"الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=90448",""],[5002,"حورية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=202370",""],[4119,"واحربا في الثغور من بلد","https://www.poetsgate.com/ViewPoem.aspx?id=16144",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5198,"هوى النفس","https://www.poetsgate.com/ViewPoem.aspx?id=155075",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5431,"تزوّدْ بالعفاف تعشْ أميرا ...","https://www.poetsgate.com/ViewPoem.aspx?id=200333",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5512,"الأب والبنون ..","https://www.poetsgate.com/ViewPoem.aspx?id=207955",""],[5550,"يكون الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=211259",""],[5720,"رسالة إلى ولدي ..","https://www.poetsgate.com/ViewPoem.aspx?id=198971",""],[5720,"الكِتْمَان","https://www.poetsgate.com/ViewPoem.aspx?id=208786",""],[5720,"لا تَحْزَنَنَّ","https://www.poetsgate.com/ViewPoem.aspx?id=214883",""],[5845,"أنسمة ُ طيبٍ أمْ صبا طيبة ً هبا","https://www.poetsgate.com/ViewPoem.aspx?id=198483",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""]],"verses":[["وَكُن مَعي طولَ دُنيايَ وَآخِرَتي","وَيَومَ حَشري بِما أَنزَلتَ في عَبَسِ",0,"س",1,0],["وَكُن مَعدَناً لِلحِلمِ واصفَح عَنِ الأَذى","فَإِنَّكَ راءٍ ما عَمِلتَ وَسامِعُ",1,"ع",1,0],["وَكُن مِن وَراءِ الجارِ حِصناً مُمَنَّعاً","وَأَوقِد شِهاباً يَسفَعُ الوَجهَ حامِيا",2,"ي",2,0],["وكن ماجداً لم يُغض عند هضيمةٍ","فلما أحبّ اللّه إغضاءَهُ أغضى",3,"ض",2,0],["وكنْ مُتوقِّعاً عَوداتِ ذمِّي","كذاتِ الحيض تنتظر القُرُوّا",4,"و",2,0],["وكن مُخبِري إِنَّني سائِلٌ","سُؤالَ مُدلٍّ عَلى مُسعَدِ",5,"د",1,0],["وَكُن ما بَينَ ذاكَ وَذاكَ حالا","فَلَن تُرضي العَدُوَّ وَلا الحَميما",6,"م",2,0],["وكنْ مَلِكاً حوَى مُلكاً كبيراً","بها أو ناسكاً سكنَ البقيعَا",7,"ع",2,0],["وَكُن مُوسِراً شِئتَ أُو مُعسِراً","فَلا بُدَّ تَلقى بِدُنياكَ غَمّ",8,"م",1,0],["وَكُن مَعدناً لِلحِلمِ وَاصفَح عَنِ الأَذى","فَإِنَكَ لاقٍ ما عَمِلتَ وَسامِعُ",9,"ع",1,1],["وَكُن مُوجِباً حَقَّ الصَديقِ إِذا أَتى","إِلَيكَ بِبرٍ صادِقٍ مِنكَ واجِبِ",10,"ب",1,0],["وَكُن موقِناً أَنَّ","شانيكَ أَبتَر",11,"ر",1,0],["وَكُن مَعَ الدَهرِ دَهراً","عُمراً كَما عُمرانِ",12,"ن",1,0],["وَكُنْ مُتَوَسِّطَاً فِي كُلِّ حَالٍ","لِتَأْمَنَ مَا تَخَافُ مِنَ الْعِنَادِ",13,"د",1,0],["وَكُنْ مُوسِرا شَئْتَ أو مُعْسِرا","لا بدَّ في الدني من الغم",14,"م",1,1],["وكن معيناً لأبٍ قد شابا","يبكي ويستبكي لي السحابا",15,"ب",2,0],["وكنْ مثلهم في كلِّ حال ولا تمِلْ","وخلِّ ولا تسأل سُرَاهُم إذا حَلُّوا",16,"ل",3,0],["وكن معه ما بين خوف مؤدب","وبين رجاء مؤذن بالرغائب",17,"ب",1,0],["وكن مع الخلق ما كانوا لخالقهم","واحذر معاشرة الأوغاد والسفل",18,"ل",1,0],["وَكُن مِثلَ ما قَد كانَ والِدُكَ الَّذي","تَلَقَّيتَهُ وَاِعمَل بِما كانَ عامِلا",19,"ل",2,0],["وكنْ مستصحِبا حطبا وقِدْرا","لكي تهتم في تَسْخينِ ماء",20,"ا",2,0],["وكن من الناس سامريّا","تستمسك العروة الوثيقة",21,"ق",2,0],["وكن مع القوم كيف كانوا","وكن كما أنت في الحقيقه",21,"ق",2,0],["وكن مع البهم واقنع","ترى القليل كثيرا",22,"ر",2,0],["وكن مستقيماً للجماعة تابعاً","ومن لم يتابع سنة الله يشذذ",23,"ذ",1,0],["وكن منذراً بينَ الورى ومبشِّراً","وبلِّغ جميعَ المسلمينَ وصيّتي",24,"ي",1,0],["وَكن من اذى الدارين حصتي فانني","اعدك لي من كل نائبة حسبا",25,"ب",2,0],["وكن من الشكر علي غاية","إن النعيم الصرف عن الشكر",26,"ر",1,0],["وَكُن مُعيني على كربِ الشتاءِ بها","لا حامَ حولَ حِمى راجيكم الكربُ",27,"ب",1,0],["وكن ماسكاً في حبل دينِ ابن مريمٍ","ومذهبِه المرفوعِ يوماً لواؤه",28,"ا",3,0],["وكن من المحسنينا","واعمل بهذي الوصيه",29,"ه",1,0],["وَكُن معدِناً لِلحُلمِ وَاِصفَح عَنِ الأَذى","فَإِنَّكَ راءٍ ما عَلِمتَ وَسامِعَ",30,"ع",1,1],["وكن مسعدا بالربع في فيض عبرة","لعل ثراها بالمدامع أن يرى",31,"ر",2,0],["وكن مرغِماً خَصمي بأمر مشَرِّفٍ","تُوفِّرُ لي منه الضمان المعَجَّلا",32,"ل",2,0],["وكن مفطراً بالبِرِّ والبَس على التقى","ثوابكَ وانزِع صومَك المتقبَّلا",32,"ل",2,0],["وكن محسنا برا شفيقاً ملاطفاً","ولا تك للسوّال في الرّد ناهرا",33,"ر",2,0],["وكن مخلصا عادات حسك بالنيا","ت تقلب أعيانا لديها تصافيا",34,"ي",2,0],["وكن مؤنسي إذا الأهل ذهب","عني وصرت موحشا بين التراب",35,"ب",1,0],["وكن مع الله ولا تخش السوى","ففي السوى اشهد بالوجود العدما",36,"م",2,0],["وكنْ مع أَهْلِ الفقرِ وارْضَ بحالِهِمْ","وخُذهُمْ عن الأَهلينَ يا صاحِبي أَهْلاَ",37,"ل",2,0],["وكنْ معَ اللهِ لا تبغِ السِّوى بدلاً","بِعَبرةٍ أصلحَتْ سُقْمَ العِباراتِ",38,"ت",1,0],["وكنْ مع الشَّرعِ ولازِمْ حكمَهُ","فظُلمَةُ القبرِ جَزاءُ من عدَا",39,"ا",1,0],["وَكُنْ مِثلَ الأُلى دَرَجوا وأبقَوْا","حديثاً ما لزهرته الرّياضُ",40,"ض",1,0],["وكن مغنياً لي يا غنيُّ عن الورى","وللفقر يا مغني أزل بك واقيا",41,"ي",2,0],["وكن مرشداً لي يا رشيد إلى المنى","وبالصبر وفِّر يا صبور الدواعيا",41,"ي",2,0],["وكن مثل سادات مضَوا مخلصين لم","يحولوا عن التقوى هم القادة الأُلى",42,"ل",2,0],["وكن مثل ما قد كنت في علمه بلا","وجود وجود الله لا يتكرر",43,"ر",1,0],["وَكُن مُتَمَتِّعاً بِبَقاء شبلٍ","نَجيب مِن عُلومك يَستَفيد",44,"د",1,0],["وكنْ مطيعاً لمن بالخير وصَّى لكْ","ولا تجيل العزايم وسْطَ ميدانكْ",45,"ك",1,0],["وكن مثل طعم الماء عذباً مبرداً","على الكبد الحري لكل صديق",46,"ق",1,0],["وكُنْ مُغِيثِي إذَا اشتد الظَّمَا وَشَكَا","جَفْنِي الحَرِيقُ لِدَمْعٍ جَارَ فِي الغَرَقِ",47,"ق",1,0],["وكُن محبّ محبّيه وناصِرَهُ","والزَم عداوةَ ومن أضحى يعاديهِ",48,"ي",2,0],["وكن محببا لنا في الخير","وحافظا من الشقى والضير",49,"ر",1,0],["وكن من امور الشر منقبض الحشا","ولازم على قبض الاعنة والزهد",50,"د",1,0],["وكُن مُجمِلاً ياذَا الجمالِ فإنّما","جمالُك أولى بالجميل من الفعل",51,"ل",1,0],["وكن مع الحق إِذا","ما نَصَّوك لا تهب",52,"ب",1,0],["وكن مسعفي فيما ألاقي من الأسى","فهجرك يا كل المنى ما نويته",53,"ت",2,0],["وكن ما حييت شفيقاً علي","فإني عليك شفيقٌ شفيق",54,"ق",1,0],["وكن مستظلاً بظل الغياث","لتحلب دَرَّ الغنى في حلب",55,"ب",1,0],["وكن من أعظم الخدماء عندي","بها صححت في الأخرى كمالي",56,"ل",2,0],["وكن مع حكمِ الله في كلِّ حالة","فقد فاز بالإدراك من قام بالحكم",57,"م",1,0],["وكن مركباً للأمر تحصل على المنى","ولا تكُ ذا قلب خليٍّ عن الجسم",57,"م",1,0],["وكن مكرما للخبز غير مهينه","وارغفة صغّر وللعجن جود",58,"د",1,0],["وكن مؤثرا إن كان في الزاد قلّة","ولا تتكلف تعجزنّ فتفند",58,"د",1,0],["وكن متصدقا سرا وجهرا","ولا تبخل وكن سمحا وهوبا",59,"ب",2,0],["وكن مقيماً منه حيث الصبا","تمتار مسكاً من اريج البطاح",60,"ح",1,0],["وكن معها على اوفى سرور","وعش في ظل عرش البطركيه",61,"ي",2,0],["وكن مثل طير تروح بطانا","وفي الغد تغدو غدوَّ الخماص",62,"ص",1,0],["وكن من الناس من أبيك فلا","أقرب منه مستوحشا وجلا",63,"ل",2,0],["وَكُن مُستعيناً بِالصَلاة عَلى الَّذي","تَرقى بِلا ريب إِلى حضرة القُدس",64,"س",1,0],["وكن من الإخوان مستوحشاً","وحشةَ إنسيٍّ بجنّان",65,"ن",1,1],["وكن مثلَ ركنٍ الدولةِ الحلوِ واصطنعْ","كما كان تاجُ الملَّةِ المرُّ يصنعُ",66,"ع",1,0],["وكن مُؤنسي في ظلمةِ القبرِ عندما","يصدُّ ذوو وُدي ويجفو الموالفُ",67,"ف",1,0],["وكن من اللّه في خوف وفي حذر","إذ لم ينل عفوه إلا مراقبه",68,"ب",2,0],["وَكُن مِمَّن لَهُ أُسديتَ بِرّاً","عَلى حَذر وَخُف مِنهُ النِكايَه",69,"ا",3,0],["وَكُن مُعيناً لِمن وافى حِماك لِكَي","يَرجو نِداكَ فان الحُر مِعوان",70,"ن",1,0],["وكن مسعفاً في الحشر منك بشربة","يُبلّ بها إذ تحتسيها أوامها",71,"م",3,0],["وكن من حميم عذاب الجحيم","عليهم لفرط الشقا ممطرا",72,"ر",2,0],["وكن محب محبيهم وناصرهم","فبغضهم وجلال الله يؤذيه",73,"ي",2,0],["وَكُن مَعقِلاً لِلحِلمِ واصفَح عَن الخَنى","فإِنَّكَ راءٍ ما حَييتَ وَسامِعُ",74,"ع",1,1],["وكن محباً لخير الخلق سيدنا","كنز الوجود وبحر الجود والامل",75,"ل",1,0],["وكن مع الصادقينَ غيرَ مُنفَصِلٍ","فَسِلكُ ما سَلَكُوه غَيرُ مُنفَصِمِ",76,"م",1,0],["وكن متداوياً بإدمان ذكره","تصحُّ وقد ترى به النور والصفا",77,"ف",2,0],["وَكُن مَولاي خازن كُل فَضلٍ","وَرُكناً للمعالي لا يَبيدُ",78,"د",1,0],["وَكُن مُنصِفا فيما تَرجح بَعدما","تدير الحجى فيما تَراهُ لِتَعذُرا",79,"ر",2,0],["وَكُن مقيلا سيدي عَثرَتي","فَأَنتَ رَب العَفو وَالرَحمَة",80,"ه",1,0],["وكن مشبها للصل في فرط لينه","إذا مس مسا وهو ما انفك لاسعا",81,"ع",2,0],["وكُنْ مُعيني على ذوي خُدَعٍ","إِن سالم القلبُ حارب النظرُ",82,"ر",1,0],["وكن مؤنسى في القبر ليلة وحدتى","ووسع فضا لحدى اذا هو ضيقا",83,"ق",2,0],["وكن مؤنسا لى حين أمسى ولم أجد","برمسى من عنى يزيل التوحشا",84,"ش",2,0],["وَكُن مُستَجيراً بِالنَبِيِّ وَآلِهِ","وَأَصحابِهِ خَيرَ القُرونِ الشَريفَةِ",85,"ه",1,0],["وكن ما حييت في اختلاطٍ وعزلةٍ","على منهج الأسلاف تلقاه شافيا",86,"ي",2,0],["وكن ممن تزهد ثم","قطَّع حبلها شَذَرا",87,"ر",2,0],["وَكُن مُفلِساً مِن رُؤيَةِ الكَونِ كُلِّهِ","تَكُن بِإِلاهِ العَرشِ أَغنى البَرِيَّةِ",88,"ه",1,0],["وكن من عابديه بجنح ليل","ولا تك في عبادته بخيلا",89,"ل",2,0],["وكن منها على حذر وإلا","هلكت فإنها أصل المهالك",90,"ك",1,0],["وكن ممن سعوا لله دوما","إذا حلوا بدار تستنير",91,"ر",1,0],["وكن موجتي في البحر تدوي وترعد","وتقذفني حورا بشط تواجدي",92,"د",2,0],["وكن معيني على ذوي خدع","إن سالم القلب خادع النظر",93,"ر",1,0],["وكن مؤنسي في مهجعي يوم مرجعي","إليك إذا استودعت يلقعه يهما",94,"م",2,0],["وكن مع الجار وابن العم نعم الرفيق","ولاتصيّد على الاجواد غراتها",95,"ت",3,0],["وَ كُنْ مُوَفِّقاً لِكُلِّ حَاكِمٍ","صَانَ الشُّعُوْبَ لِلأَمَانِ يَسْبِقُ",96,"ق",1,0],["وكن مثل الضياء إذا تراءى","لعتم الليل منتشرا سيمحو",97,"ح",2,0],["وكن منه في أمره كلّه","إلى كلّ مكرمة تبدره",98,"ر",2,0],["وكنْ مثلَ لقمانَ تنصحُهُم","روى نُصْحَ لقمانَ آيٌ مُبينُ",99,"ن",1,0],["وكنْ مُسْتَعدًّا ليوم الحساب","ووفّرْ من الزاد كلَّ اكتفاء",100,"ا",2,0],["وكنْ مع اللهِ .. إنّ اللهَ ناصرُ مَنْ","يسعى إليه .. بقلبٍ مُبصرٍ حَذِرِ",101,"ر",1,0],["وَكُنْ مَعَ اللهِ .. لَا تَترُكْ مَعِيَّتَهُ","فَكُلُّ خَيْر ٍ بِهِ يَسْتَلْهِمُ الرَّشَدَا",102,"د",2,0],["وكنْ معَ اللهِ في شكواكَ مُجتهداً","فاللهُ ( سُبْحَانه ) ذو المَنِّ يَكْلَؤُنَا",103,"ن",2,0],["وكنْ منْ أذى الدارينِ حصنى فانني","أعدكَ لي منْ كلَِ نائبة ٍ حسبا",104,"ب",2,0],["وكنْ مُخْبِتًا لله ربِّك واصطبرْ","فقد فاز فيها الصابرُ المتوكِّلُ",105,"ل",1,0],["وَكُنْ مُنْصِفَاً .. إنَّ أَحْزَانَنَا","مُقَسَّمَةً بَيْنَنَا بِالسَّوَاءِ",106,"ا",1,0]]}