{"poems":[[63,"لا سقيت حانة أترجة","https://www.aldiwan.net/poem51694.html","السريع"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[310,"سيان أن لبس التجمل أو عري","https://www.aldiwan.net/poem56550.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126756","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80254","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128086","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135940","الرجز"]],"verses":[["فَبَظْرُها إذ ولَدَتْ مِثلَهْ","أَولَى بعِقْدِ الدُّرِّ مِنْ جيدِها",0,"د",3,0],["فَبِظُلْمٍ منهمُ وكفْرٍ عَدَتْهُم","طَيِّبَاتٌ في تَرْكِهنَّ ابْتِلاءُ",1,"ا",2,0],["فَبظاهرٍ يجبُ التوجّه نحوها","وَبباطنٍ للواحد المتكبّرِ",2,"ر",1,0],["فبظلّ يحيى العرب تُحيي مجدَها","بعدَ التفتّح أَعصُراً ودُهورا",3,"ر",2,0],["فبظلِهِ قَد جَدَّ إِبرَاهيم في","تَوطيد هَذا السَدّ وَهُوَ الفاضِلُ",4,"ل",1,0],["فبظهره نيل المرام لطالب","تبديد شمل الحجفل المحشود",5,"د",1,0],["فبظهور العلمِ فيَّ أظهرا","عليَّ فضلكَ ولي فلتنصرا",6,"ا",1,0]]}