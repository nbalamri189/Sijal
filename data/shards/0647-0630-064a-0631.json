{"poems":[[95,"هذي رحاب دياب نشهدنا القرى","https://www.aldiwan.net/poem11181.html","الكامل"],[87,"قبر الوزير تحية وسلاما","https://www.aldiwan.net/poem62828.html","الكامل"],[71,"يا نازحين ودمعي نازح بهم","https://www.aldiwan.net/poem27985.html","البسيط"],[95,"هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31925",""],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[266,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[295,"نزح الرقيب وغارد اللاحي","https://www.aldiwan.net/poem11674.html","الكامل"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[382,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[449,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126770","الكامل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77446","الكامل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44949","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101998","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56126","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56573","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137854",""],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80053","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48913","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102723","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89559","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77340","البسيط"],[2469,"","https://poetry.dctabudhabi.ae/diwan/poem/203616","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137217",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137355",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94088","البسيط"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113865","الكامل"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/82777","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138622",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138551",""],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132012","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131243",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133284","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70101","الكامل"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131910","البسيط"],[4208,"","https://poetry.dctabudhabi.ae/diwan/poem/110723","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136422",""],[4578,"هذي رواية آدابٍ لذي أدبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49350",""],[4858,"إلى ولدي الحبيب الدّكتور محمّد","https://www.poetsgate.com/ViewPoem.aspx?id=30638",""],[4858,"سفرة وشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155076",""],[4875,"موجات الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=133586",""],[4955,"أنا مذ خلقتُ موحدًا","https://www.poetsgate.com/ViewPoem.aspx?id=190799",""],[4961,"الموتُ لا يمرُّ بهذهِ القِمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=50581",""],[4987,"ماهى اول غلا","https://www.poetsgate.com/ViewPoem.aspx?id=49570",""],[5092,"بالجرحِ أكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=163044",""],[5111,"صُوفيَّةُ الْهَوى","https://www.poetsgate.com/ViewPoem.aspx?id=212209",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5183,"مِشْكاة المَلاَغِز","https://www.poetsgate.com/ViewPoem.aspx?id=186412",""],[5186,"هذي رواية يوسف الصديق يا","https://www.poetsgate.com/ViewPoem.aspx?id=156461",""],[5237,"هذي رياح اليمن هب نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=113116",""],[5277,"راحلٌ..ورحيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187871",""],[5277,"إستصحاب أبي نؤاس في طلليّتهِ..","https://www.poetsgate.com/ViewPoem.aspx?id=210869",""],[5358,"لا تجرحي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183416",""],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[5444,"حيث لهيب الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=205073",""],[5512,"رثاء حبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=204150",""],[5533,"المعلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=177058",""],[5648,"ريح ضميرك","https://www.poetsgate.com/ViewPoem.aspx?id=154661",""],[5693,"أين أنتم يا صفاتي ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=35587",""],[6124,"والتينُ والزيتونُ","https://www.poetsgate.com/ViewPoem.aspx?id=109751",""],[6152,"نحو مكة","https://www.poetsgate.com/ViewPoem.aspx?id=204656",""],[6198,"عبق الذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79291&r=&rc=65",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""]],"verses":[["هَذِي رِحَابُ دِيَابُ نُشْهِدُنَا القِرَى","فِي رَسْمِهِ المَوْرُوثِ عَنْ عَدْنَانِ",0,"ن",1,1],["هَذي رُبوعُكُمُ وَتِلكَ رُبوعُنا","مُتَقابِلينَ نُعالِجُ الأَيّاما",1,"م",2,0],["هذي رسائلُ إخوانِ الصفاءِ كُفُوا","بها إذا أَعوزَ الخوان إخوانُ",2,"ن",1,0],["هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","نَوَاهِضاً بِالْقُبَّةِ الزَّرْقَاءِ",3,"ا",2,1],["هذي رجالاتُ الصباحِ أصبحت","بالبابِ أمثالَ النجوم الزهرِ",4,"ر",1,0],["هذي ربى الأثلات من يبرين","والقاتلات لنا عيون العين",5,"ن",1,1],["هذي ربوعُكِ بعدَ الأُنسِ مُوحِشةٌ","كأننا لم نكن فيها مقيمينا",6,"ن",2,0],["هَذي رسائِلُها تُناجي بِالتي","وَقَفَتْ عَلَيْهَا رَيْثَها ونجَاءَها",7,"ا",3,0],["هذي ربي لبنان مائجة","عجت بأعراس وأفراح",8,"ح",1,0],["هَذي رِئاستكم وعزّة مجدكم","نيطت بِكم يا معشر الأعيانِ",9,"ن",1,0],["هذي رموزٌ لست أعلم كنهها","فإذا أتيت مفسريها يهربوا",10,"ب",3,0],["هذي رسائله وطبع صفاته","قد نزهت عن شبهة وضريب",11,"ب",1,0],["هذي ربوع الطفّ فيك تضوّعت","مُذ فاحَ طيب شذاك فيها ينشرُ",12,"ر",1,0],["هَذي روايتُنا عَن اِشياخ الهَوى","فَإِن اِدَّعَيتُم غَيرَها فَأَروني",13,"ن",2,0],["هذي رِقاعَكُم بِالرَفدِ وافِدَة","وَلَيسَ عِندي بِحَمدِ اللَهِ تَوفير",14,"ر",1,1],["هذي ركائب أهل المجد قد وفدت","تطوي المفاوز أحزاناً بأحزان",15,"ن",1,0],["هذي رواية حرفة الأدب التي","لم يعنها الا الرفيق الريقُ",16,"ق",1,0],["هذي رسوم قد محاها البلى","وذي رسوم قد علاها العفاء",17,"ا",2,0],["هذي رسالة مدنف قد اعربت","لذويه يوم البين عن حالاته",18,"ت",2,0],["هذي رسالة ذي ود يصون بها","حفظ الوداد الى من حفظه صانا",19,"ن",2,0],["هذي رسائله فقفْ","متصفِّحاً أوراقَها",20,"ق",3,0],["هذي ربوعُ الأشرفيةِ كلّما","بانت تلفّت للرّبوع فؤادي",21,"د",2,0],["هذي رجالٌ أهلوا لشهودهِ","هذي شيوخُ الشاذليّة فاسنِد",22,"د",1,0],["هذي رُسومُ عُلومِ الدينِ تَندبهُ","ثَكلى عَليهِ وَلكن عَزَّها القَدرُ",23,"ر",1,0],["هَذي رِسالَةُ خَيرِ الخَلقِ باهِرَةً","كَغُرَّةِ الصُبحِ تَجلو فَحمَةَ الغَسَمِ",24,"م",1,0],["هذي رياض الحسن أغصانها","غرّد بالدوحة منها الهزار",25,"ر",1,1],["هذي رئاستك العلياء قائلة","حسبي بجرجي رئيساً حازماً وكفى",26,"ف",2,0],["هذي رياض الندى يا نفس مورقة","فيها غناك وفيها حسن مأواك",27,"ك",1,0],["هذي رياض زهت بورق","ناهيك بالمطربات منها",28,"ه",2,1],["هذي رسول لي إليك وليتني","كنت الرسول لها لمن تأتيه",29,"ي",2,0],["هَذي رَحيقٌ ما لَها أَكؤُسٌ","فَكَيفَ نَسقيها لِلُوّامِنا",30,"ن",2,0],["هذي رياحُ الحرْبِ هبَّتْ عندَهُ","هوجاً ولمْ تُرْسِل عليْهِ رُخاءَها",31,"ا",3,0],["هذي ربوعهم خلت من بعدما","كانت بها أملاكها تتنزل",32,"ل",1,0],["هذي ربوع محمدٍ عرصاتها","قد أقفرت واستوحشت اعلامها",33,"م",3,0],["هذي رياحين القريض شذية","تهدى لكل متوج بخصاله",34,"ل",2,0],["هذي رياضك لا تثني الصبا غصناً","فيها ولا الزهر في أفنانها خضل",35,"ل",1,0],["هذى رحاب الشافعي بحر الوفا","حبر الشريعة وابن عم المصطفى",36,"ف",2,1],["هَذي رواية يوسف الحَسن الَّتي","شَهدت لناظمها بِكاملِ رَسمها",37,"م",3,1],["هذي رعاياك من جهل بها مرض","أنت الطبيب لها والعلم يشفيها",38,"ي",3,0],["هذي رعاياك فوضى في مقاصدها","ولا سراة لها للرشد تهديها",38,"ي",3,0],["هذي رعاياك فوضى لا اجتماع لها","وللتخاذل داء قد فشا فيها",38,"ي",3,0],["هذي ربوع العلم موحشة","من أجل فقدك أيها البدر",39,"ر",1,0],["هذي رياض اثمرت","فكاهة كالرطب",40,"ب",1,1],["هذي رواية آدابٍ لذي أدبٍ","بالحسن راقت قلوب العجم والعرب",41,"ب",1,1],["هذي رسالة مَن يراكَ بقلبه","زَيْنَ الشّباب ولا يرى إلاكا",42,"ك",2,0],["هذي\" رجاءُ \"بعون الله قد صبرَتْ","عل الجراح , وقد أدمتْ حشاياها",43,"ا",3,0],["هذي ردات الحظ وقِلّ التوافيق","تكاتفنّ بقلب ساطي وسفّاح",44,"ح",1,0],["هذي رسالةُ مؤمنٍ","بالله يختمها اليقينْ",45,"ن",1,0],["هذي رسالتُكَ الخضراءُ في دمِنا","كمْ ذا تداوي ولمْ يمرضْ بها أحدُ",46,"د",1,0],["هذى رسومها بين الضلوع النحايل","هذى اللى على صدر القصيده وسام",47,"م",1,0],["هذي رجولتنا يا شامُ ناقصةٌ","فينا وجرحي مدىً بالجرحِ أكتملُ",48,"ل",1,0],["هَذِي رُؤَى صَلَوَاتِي عَرَّجَتْ أمَلًا","تَهِيمُ فِي ملكوتِ اللهِ فهْيَ سَنَا",49,"ن",2,0],["هذي رؤاكِ مع الخيالِ تجيئُني","وأنا وحيدٌ .. صامتاً أتألمُ",50,"م",1,0],["هذي رموزيَ تأتي","مفتاحها في يديها",51,"ي",3,1],["هذي رواية يوسف الصديق يا","شعبا يفت بعرقه التفريق",52,"ق",1,1],["هذي رياح اليمن هب نسيمها","أذكى من المسك العبيق شميمها",53,"م",3,1],["هذي ربوعُ بيوتِهم من بعدِهمْ","فيها ربوعٌ للردى وطلولُ",54,"ل",1,0],["هذي ربى بغدادَ صارتْ بلقعاً","وبنو أبي فيها الضِّرارَ تسامُ",55,"م",1,0],["هذي رسائلُكِ الصَمّاءُ يحْفظُها","عن ظهْرِ قلبٍ وقد باتتْ تُسَلّيهِ",56,"ي",2,0],["هذي رماح ٌ على آمادِها آنعصرت","وأزبدتْ من بريق ِالضربَ ماسحنا",57,"ن",2,0],["هذي ربُاها، وحسبي اليومَ عاصفةً","بالراسياتِ لتذروا زهَر َمرعانا",58,"ن",2,0],["هذي رسالةُ مهجتي كي تعرفي","أنَّ الزَّمانَ بلوعتي مفروشُ",59,"ش",1,0],["هَذي رِسَالةُ وَالدٍ لمُعَلِّمِ","باسْمِ الإَلهِ أَسُوقُها فَلْتعْلَمِ",60,"م",1,1],["هذي رساله لراع الكار","اللي بالاوهام مطاير",61,"ر",1,0],["هذي رحلي عشت فيها","أنوي مكثا ناب عنّي",62,"ن",2,0],["هذي رموزي فاحفظي في حِلّها","تقويمَ دهرٍ يشتهي أخلاقنا",63,"ن",2,0],["هذي ربوع البيت أزهر ركنها","وتزينت بمدامع العباد",64,"د",1,0],["هذي رسائلك (الزرقاء)... نائمةٌ","دفءُ الأصابع مرسوم على الورقِ",65,"ق",1,1],["هَذِى رُبُوعُكِ بينَ العَجزِ قدْ سَكَنَتْ","وَوَدَّعَتْ بِالأَسَى خَيْلاً.. وَفُرْسَانَا",66,"ن",2,0]]}