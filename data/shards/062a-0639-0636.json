{"poems":[[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[50,"تكثر ما استطعت من الخطايا","https://www.aldiwan.net/poem63365.html","الوافر"],[136,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[396,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[534,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[572,"بليت بحب ناسكة","https://www.aldiwan.net/poem69750.html","مجزوء الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35732","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49609","السريع"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123172","البسيط"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216540",""],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4918,"نجيب العيد","https://www.poetsgate.com/ViewPoem.aspx?id=31103",""],[5449,"صقيع","https://www.poetsgate.com/ViewPoem.aspx?id=189106",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5943,"كَشَفَتْ غطاها","https://www.poetsgate.com/ViewPoem.aspx?id=34277",""],[6093,"عَقِيْقَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=204951",""],[572,"بليتُ بحبِّ ناسِكَة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9217&r=&rc=74",""]],"verses":[["تُعَضِّلُ الأرضُ ضِيقاً عن جلالته","ويَسلُكُ الخُرْتَ عفواً لُطْفَ مُنْسَربِ",0,"ب",1,0],["تَعُضُّ نَدامَةً كَفَّيكَ مِمّا","تَرَكتَ مَخافَةَ النارِ السُرورا",1,"ر",2,0],["تَعُضُّ عَلَى اللِّجَامِ إِذَا تَبَدَّى","فَيَصعُبُ عَنهُ رَدعُكَ باللِّجَامِ",2,"م",1,0],["تُعَضِّلُ الأَرضَ مِنهُ وَهيَ مُثقَلَةٌ","قَد هَدَّها كَثرَةُ الأَقوامِ وَالثَقَلُ",3,"ل",1,0],["تعضض خمسك","ندامة والله",4,"ه",1,0],["تَعضِلُه الغَيرةُ من خُطَّابِه","إذا القريضُ طلبَ التبعُّلا",5,"ل",2,0],["تَعْضدُها الأُصُولُ","فاسْتَمْلِ ما أقولُ",6,"ل",1,0],["تَعَضُّ عَلَىَّ بِالإغْرِي","ضِ مِنْ أَطْرافِها البَلَحَا",7,"ح",2,0],["تَعُضُّ بِأَنيابِ المَنايا سُيوفُهُ","وَتَشرَبُ مِن أَخلافِ كُلِّ وَريدِ",8,"د",1,1],["تَعَضُّ من شوقٍ ومنْ حسرةٍ","على يَدَيْ لهفانَ مغبون",9,"ن",1,0],["تعضّ لا أختشي من عضّها ألماً","إذ نظمُ أسنانها في ثغرها انتثرا",10,"ر",2,0],["تِعْضَدْ لِهْ الدّنيا إذا هم وانتوى","لِهْ هَمْهِمَتْ والعقل فَعّل خيالها",11,"ل",3,0],["تَعضِبُ القَرنَ إِذا ناطَحَها","وَإِذا صابَ بِها المَردى اِنجَزَع",12,"ع",1,0],["تعض العين بي رمشي مع تأكيد","خجولة وكحلها بين الخناجر مال",13,"ل",1,0],["تعضُّ الشِّفاهُ بقايا الكلامِ","وتنطقُ عينيْ خريفَ اصفرار",14,"ر",1,0],["تَعَضُّ عَلَى أَنَامِلِهَا إِذَا مَا","رَأَتْ فَجْرًا لأُمَّتِنَا يَلُوحُ",15,"ح",1,0],["تعضُّ عليكَ بالأنيابِ عضًا","وعضُّ النارِ ليسَ كمنْ سواها",16,"ا",3,0],["تُعَضِّلُ في المَجَازِ على جَرِيءٍ","رَأَى الإبْداعَ في وَعْرِ الطَّرِيْقَةْ",17,"ق",2,0],["تعضّ عليَّ بالإعْرَا","ضِ من أطرافِهَا بَلَحَا",18,"ح",2,0]]}