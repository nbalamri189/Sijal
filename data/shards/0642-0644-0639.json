{"poems":[[72,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[72,"قل عوني على الزمان فأصبح","https://www.aldiwan.net/poem20465.html","الخفيف"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[68,"إن جزت بحي ساكنين العلما","https://www.aldiwan.net/poem1529.html",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[100,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[91,"سقوط بورت ارثور","https://www.poetsgate.com/ViewPoem.aspx?id=53022",""],[323,"إن الوليد أمير المؤمنين له","https://www.aldiwan.net/poem56352.html","البسيط"],[363,"غضب التراب","https://www.aldiwan.net/poem11592.html","عموديه"],[365,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[365,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[404,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"]],"verses":[["قلعت بها أوتاد كلّ معاند","وتمسكت هي للسما أسبابا",0,"ب",2,0],["قلَّ عوني على الزمان فأصبح","تُ صبوراً على مراد الزمان",1,"ن",1,1],["قَلعَةٌ صانَها الزَمانُ فَلَولا","كَيدُ نوجي لَبَشَّرتُ بَِلخُلودِ",2,"د",1,0],["قُلْ عبدُكم ذابَ اشتياقاً لكُمُ","حتى لو ماتَ من ضَنىً ما علما",3,"م",2,0],["قَلَعِيّةٌ وكأنّ مَشْتى الأزْدِ في","أرضِ السَّراة سَخَا بها لقَلاعها",4,"ع",3,0],["قلعتني يا شام ريح .. وريح","زرعتني هنا .. كروما عصيره",5,"ر",2,0],["قلعة صانها الزمان فلولا","كيد نوجي لبشرت بالخلود",6,"د",1,0],["قَلَعتَ بِيعَتَهُم عَن جَوفِ مَسجِدِنا","فَصَخرُها عِن جَديدِ الأَرضِ مَنسوفُ",7,"ف",1,0],["قلعوا الكروم وأحرقوا بيّارتي","غضِبَ الترابُ فأنبتَ الصبّارا",8,"ر",2,0],["قَلعْتَ القلعةَ العَلْياءَ بأساً","أحلَّ قطينَها دارَ الهَوان",9,"ن",1,0],["قَلعْتَ بتلكَ القلعةِ اليومَ شَوكةً","بها المُلْكُ دهراً كان دامي الشَّواكل",10,"ل",1,0],["قل على الباب فقير سائل","سائل الدمع ضعيف محتقر",11,"ر",1,0]]}