ae/diwan/poem/216541",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67976","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91760","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91444","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76500","الرمل"],[5186,"اليسر في العسرى على مقدارها","https://www.poetsgate.com/ViewPoem.aspx?id=156462",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5690,"سر أريحَّ الشمال سرْ بسلام","https://www.poetsgate.com/ViewPoem.aspx?id=172187",""],[469,"قلُّ عنائي أنّني فيه هائم","https://www.poetsgate.com/ViewPoem.aspx?id=39749",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5567,"صاغني الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82099&r=&rc=140",""]],"verses":[["قلعت بها أوتاد كلّ معاند","وتمسكت هي للسما أسبابا",0,"ب",2,0],["قلَّ عوني على الزمان فأصبح","تُ صبوراً على مراد الزمان",1,"ن",1,1],["قَلعَةٌ صانَها الزَمانُ فَلَولا","كَيدُ نوجي لَبَشَّرتُ بَِلخُلودِ",2,"د",1,0],["قُلْ عبدُكم ذابَ اشتياقاً لكُمُ","حتى لو ماتَ من ضَنىً ما علما",3,"م",2,0],["قَلَعِيّةٌ وكأنّ مَشْتى الأزْدِ في","أرضِ السَّراة سَخَا بها لقَلاعها",4,"ع",3,0],["قلعتني يا شام ريح .. وريح","زرعتني هنا .. كروما عصيره",5,"ر",2,0],["قلعة صانها الزمان فلولا","كيد نوجي لبشرت بالخلود",6,"د",1,0],["قَلَعتَ بِيعَتَهُم عَن جَوفِ مَسجِدِنا","فَصَخرُها عِن جَديدِ الأَرضِ مَنسوفُ",7,"ف",1,0],["قلعوا الكروم وأحرقوا بيّارتي","غضِبَ الترابُ فأنبتَ الصبّارا",8,"ر",2,0],["قَلعْتَ القلعةَ العَلْياءَ بأساً","أحلَّ قطينَها دارَ الهَوان",9,"ن",1,0],["قَلعْتَ بتلكَ القلعةِ اليومَ شَوكةً","بها المُلْكُ دهراً كان دامي الشَّواكل",10,"ل",1,0],["قل على الباب فقير سائل","سائل الدمع ضعيف محتقر",11,"ر",1,0],["قَلعة الصَدر المؤيد","بابها باب النَجاح",12,"ح",1,1],["قلعة الداوريِّ ذات الرَصانَهْ","حَفَظَت باهتمامه أَوطانَهْ",13,"ن",2,1],["قلع ملك وعزل عارض بهذا الشّوم","وعاد حر وزعيمه مبعر أخت البوم",14,"م",1,0],["قل عنده انا شاعر","وانظره كيف يموت جبنا",15,"ن",2,0],["قَلَّ عَنهُم صَبري وَلَم يَرحَموني","فَتَحَيَّرت كَالطَريدِ الشَريدِ",16,"د",1,0],["قلعةٌ لا لزخرفٍ شيّدوها","بل ليوم مجلجل هدار",17,"ر",1,0],["قلّ عَنّي عَناءُ عَقلي وَديني","وَدُخولي في العلم من كُلِّ باب",18,"ب",1,0],["قَلَعْتُ ثَنيَّتي كِبْراً وَوَهْناً","وقِدْماً كنتُ طلاَّعَ الثَّنايا",19,"ي",2,1],["قَلْعَتُكَ الشَّهْباءُ ما","زالتْ حُلاها مُذْهَبُهْ",20,"ب",2,0],["قل عجز والعكس صدرا جعلا","وفيه ما في الطرفين أعملا",21,"ل",2,0],["قُل عَارَضَ المَنقُولَ مَعقُولٌ وَمَا ال","أمرَانِ عِندَ العَقلِ يَتَّفِقَانِ",22,"ن",1,0],["قَلَعَت أسَاسَ بِنَائِكُم فَتهَدَّمَت","تِلكَ السُّقُوفُ وَخَرَّ لِلأركَانِ",22,"ن",1,0],["قلع الحُصون الشامِخات بِصولة","نَبوية مِنها العداة تَحيد",23,"د",1,0],["قَلَعوهخا منَ البساتينِ إذ ذا","كَ صغاراً خُضْراً وَهُنَّ غروسُ",24,"س",1,0],["قلعاً وبلعاً بلا مراقبةٍ","لله في عيلتي ولا شفقه",25,"ق",2,0],["قل عبد علوة لا أزال ببابها","وكلام أهل العذل فيها لا أعي",26,"ع",2,0],["قِلْ عَبِدْنا ان يُوبْ طاري لِكْ","لا عَتقْ لا بيع لا يِعْدَمْ",27,"م",1,0],["قِلَعٌ لَهَا بالمَشْرِقين مَشارقٌ","لَهَا بأقصى المَغْرِبين عُفود",28,"د",1,0],["قلع الباب التي عن حملها","عجزت ألف من القوم الفحول",29,"ل",1,0],["قلعة سامت السماء وضاهت","في المعالي أفلاكها العلويه",30,"ي",2,0],["قُل عِم صباحا يا ديارَهُمُ وَدُمْ","أَو عم مساءً يا لَوى إخوانه",31,"ن",2,0],["قل عبدكم يفديكمُ من دهره","بِالرُوح وَهيَ هديةُ الخلصاء",32,"ا",2,0],["قلع الجبالِ بالإبارِ أيسرُ","من قلع كبرٍ من قلوب يذكرُ",33,"ر",1,0],["قل عَلى الدنيا سلام واعترف","بمخاز رغم ود تقترف",34,"ف",1,1],["قلعا لعين لا تقر على قذى","نقع تعالى آن شق غبارها",35,"ر",3,0],["قلعة الدين قبلة الخلق مهوى","كل نفس غياث كل الحيارى",36,"ر",2,0],["قل عليك السلام أن جزت فيهِ","وعلى ساكنيهِ ألف سلامِ",37,"م",1,0],["قلُّ عنائي أنّني فيه هائم","وأيسرُ ما ألقى الدموعُ السواجمُ",38,"م",1,1],["قلعوا أظافر أمتي ولسانها","صلموا المسامع، أبطلوا فعل البصرْ",39,"ر",1,0],["قلعة من شموخها صلواتي","ملأ المجد كاستي ودناني",40,"ن",2,0]]}