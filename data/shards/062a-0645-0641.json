{"poems":[[53,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55150","الخفيف"],[463,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70800","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80006","الخفيف"],[463,"هلْ لقتيلٍ على اللِّوى ثائرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60089&r=&rc=145",""]],"verses":[["تم فيها النعيم كلَّ تمامٍ","وعلا قدره عن الإِخداجِ",0,"ج",1,0],["تَمَّ فِيكِ الجَمَالُ حَسّاً وَمَعْنىً","هَكَذَا هَكَذَا تَمَامُ الجَمَالِ",1,"ل",1,1],["تَمَّ فأبصرتَ أو سمعتَ به","ما لم تكن سامعاً ولا ناظرْ",2,"ر",1,0],["تم في عام طَمْقَغٍ أُحصيتْ مِنْ","بعدما هاجر النبي الهادي",3,"د",2,0],["تمَّ فيه ما كانَ ساءَ وسرَّا","فهو ملء الزمان نفعاً وضرَّا",4,"ر",2,0],["تمَّ فأبصرتَ أوْ سمعتَ بهِ","ما لمْ تكنء سامعاً ولا ناظرْ",5,"ر",1,0]]}