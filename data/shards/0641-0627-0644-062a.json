om/modules.php?name=Sh3er&doWhat=shqas&qid=64651&r=&rc=73",""]],"verses":[["فَاِلتِفاتاً إِلى القُرونِ الخَوالي","هَل تَرى اليَومَ غَيرَ قَرنٍ فَاني",0,"ن",2,0],["فالَتُّ لُبّاً مِن عَلائِقِ صَبوَةٍ","وَنَشِطتُ قَلباً مِن جَوىً مُتَخامِرِ",1,"ر",1,0],["فَاِلتَمِس بَعدَهُ المَجَرَّةَ وِرداً","وَتَزَوَّد مِنَ النُجومِ بِزادِ",2,"د",1,0],["فالتصقنا صدراً بصدر وبطناً","فوق بطن وعانةً فوق عانه",3,"ن",2,0],["فَاِلتَفَّ صَفقُهُما وَصُبحٌ تَحتَهُ","بَينَ التُرابِ وَبَينَ حِنوِ الكَلكَلِ",4,"ل",1,0],["فَاِلتامَ طائِقُها القَديمُ فَأَصبَحَت","ما إِن يُقَوِّمُ دَرءَها رِدفانِ",5,"ن",1,0],["فَاِلتَهَمَ الرَأسَ بِيافوخِهِ","وَالحَلقَ مِنهُ فَغرَةَ الجائِعِ",6,"ع",1,0],["فالتمسْ ما جاز في العق","لِ ودعْ ما ليس جائز",7,"ز",1,0],["فالتقى فيك حسنُ رأي أميرٍ","ووزيرٍ كلاهُما خيرُ والي",8,"ل",2,0],["فَاِلتَفَّتِ الشُهبُ حَولَ عَرشي","وَسارَ في طاعَتي الضِياء",9,"ا",2,0],["فالتِماحي إِلى العُيون كريهٌ","وَلَقَد كانَ نزهةَ اللَمّاحِ",10,"ح",1,0],["فَاِلتَفَتَ الديكُ إِلى الذَبيحِ","وَقالَ قَولَ عارِفٍ فَصيحِ",11,"ح",1,0],["فَاِلتَفَتَ الصَيادُ صَوبَ الصَوتِ","وَنَحوَهُ سَدَّدَ سَهمَ المَوتِ",12,"ت",1,0],["فَاِلتَفَتَ الماءُ إِلى الغَزالِ","وَقالَ حالُ الشَيخِ شَرُّ حالِ",13,"ل",1,0],["فَاِلتَفَتَ الغَديرُ لِلعُصفورِ","وَقالَ يُهدي مُهجَةَ المَغرورِ",14,"ر",1,0],["فَاِلتَفَتَ السُلطانُ فيمَن حَولَهُ","وَقالَ كَيفَ تَجِدونَ قَولَه",15,"ه",1,0],["فَالتَلَقّي لَهُ عَقابيلُ خَطبٍ","وَلِفَرطِ التَشييعِ أَيضاً خُطوبُ",16,"ب",1,0],["فَاِلتَهَنّي بِهِنَّ قَبلَ التَعَزّي","راهِنٌ وَالقَضاءُ قَبلَ التَقاضي",17,"ض",2,0],["فَآلَت لِحَمّامٍ فَفازوا بِصَفوِها","وَمَن يُعطِ أَثمانَ المَكارَمِ يُعظَمِ",18,"م",1,0],["فالتهابُ الحياءِ يَمزُجُ فيه","حُمرةَ الأُرجوانِ بالكافورِ",19,"ر",1,0],["فَاِلتَمَس ناصِحاً قَريباً مِنَ النُص","حِ لَطيفاً لِما تُريدُ مَكينا",20,"ن",2,0],["فَاِلتَقَينا فَرَحَّبَت ثُمَّ قالَت","عَمرَكَ اللَهُ اِئتِنا في المَقيلِ",21,"ل",1,0],["فَاِلتَقَينا وَلَم نَخَف ما لَقينا","لَيلَةَ الخَيفِ وَالمُنى قَد تَسوقُ",22,"ق",1,0],["فَاِلتَقَينا فَرَحَّبَت ثُمَّ قالَت","حُلتَ عَن عَهدِنا وَك