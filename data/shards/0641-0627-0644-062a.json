{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[86,"أيهذا الثرى إلام التمادي","https://www.aldiwan.net/poem10499.html","الخفيف"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[23,"سائل بني الأشعر إن جئتهم","https://www.aldiwan.net/poem21514.html","السريع"],[51,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[91,"رآني الله ذات يوم في الأرض أبكي من الشقاء","https://www.aldiwan.net/poem8734.html","عموديه"],[78,"كنت حلف الندى ورب السماح","https://www.aldiwan.net/poem14205.html","الخفيف"],[85,"من أعجب الأخبار أن الأرنبا","https://www.aldiwan.net/poem8001.html","الرجز"],[85,"يمامة كانت بأعلى الشجره","https://www.aldiwan.net/poem8013.html","الرجز"],[85,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[85,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[85,"كان لسلطان نديم واف","https://www.aldiwan.net/poem8052.html","الرجز"],[45,"لا أرى بالبراق رسما يجيب","https://www.aldiwan.net/poem10653.html","الخفيف"],[45,"لابس من شبيبة أم ناض","https://www.aldiwan.net/poem64634.html","الخفيف"],[28,"ألما على أطلال سعدى نسلم","https://www.aldiwan.net/poem5505.html","الطويل"],[61,"لو تداركتني بوعد غرور","https://www.aldiwan.net/poem51615.html","الخفيف"],[31,"حدثينا قريب ما تأمرينا","https://www.aldiwan.net/poem41277.html","الخفيف"],[31,"مرحبا ثم مرهبا بالتي قا","https://www.aldiwan.net/poem41862.html","الخفيف"],[31,"أيها القلب ما أراك تفيق","https://www.aldiwan.net/poem42211.html","الخفيف"],[31,"نام صحبي وبات نومي عسيرا","https://www.aldiwan.net/poem42530.html","الخفيف"],[102,"قم حبيبي وأطفئ المصباحا","https://www.aldiwan.net/poem33110.html","الخفيف"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[67,"إن خلق الشهود والعمال","https://www.aldiwan.net/poem18090.html","الخفيف"],[50,"قل لسعدى تحرجي","https://www.aldiwan.net/poem63989.html","مجزوء الخفيف"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[19,"ودع لميس وداع الصارم اللاحي","https://www.aldiwan.net/poem326.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54530","الخفيف"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6095","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[28,"ألما على أطلال سعدى نسلم","https://www.poetsgate.com/ViewPoem.aspx?id=22038",""],[78,"كُنتُ حِلفَ النَّدى وربَّ السَّماحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86665&r=&rc=7",""],[126,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[126,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[158,"من قوم المرء بالمكروه تثقيفا","https://www.aldiwan.net/poem59015.html","البسيط"],[183,"بيت كصدري ورزقي","https://www.aldiwan.net/poem14604.html","المجتث"],[195,"طرقتني فجر يوم المولد","https://www.aldiwan.net/poem39890.html","الرمل"],[195,"اذكريني كلما هب الندامى","https://www.aldiwan.net/poem39906.html","الرمل"],[202,"قد غزاني هواك أيدك الله","https://www.aldiwan.net/poem53292.html","البسيط"],[220,"روح الروح واسقني بمدام","https://www.aldiwan.net/poem55471.html","الخفيف"],[221,"هذه القصة لا شأن لها","https://www.aldiwan.net/poem41916.html","الرمل"],[227,"ومريض الجفون عذب السجايا","https://www.aldiwan.net/poem51131.html","الخفيف"],[233,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[318,"ذات حسن تسبي النهى كم جهلنا","https://www.aldiwan.net/poem61711.html","الكامل"],[326,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[351,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[351,"غيث أفراح الملا قد وكفا","https://www.aldiwan.net/poem40139.html","الطويل"],[351,"بزغت شمس أنسنا المسعود","https://www.aldiwan.net/poem40366.html","الخفيف"],[400,"عدة الصابرين إن ناب خطب","https://www.aldiwan.net/poem34120.html","الخفيف"],[406,"اصبر تنل ما ترجيه وتفضل من","https://www.aldiwan.net/poem32035.html","البسيط"],[418,"ركبت بحرا من الدموع","https://www.aldiwan.net/poem46373.html","مخلع البسيط"],[429,"كم نابل في طرفيك البابلي","https://www.aldiwan.net/poem12697.html","السريع"],[441,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[456,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[459,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[459,"أنت نجم الدين في أهل التقى","https://www.aldiwan.net/poem16227.html","الرمل"],[462,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[466,"صد عن دنياك إن لم","https://www.aldiwan.net/poem59550.html","مجزوء الرمل"],[473,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[493,"برق الربيع لنا برونق مائه","https://www.aldiwan.net/poem9761.html","الكامل"],[498,"خبط الظلام ولألأ الفجر","https://www.aldiwan.net/poem37558.html","أحذ الكامل"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[536,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[556,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"],[556,"يا قليل الصبر والجلد","https://www.aldiwan.net/poem34650.html","المديد"],[556,"حرك الذت آلة الأسماء","https://www.aldiwan.net/poem34973.html","الخفيف"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"]],"verses":[["فَاِلتِفاتاً إِلى القُرونِ الخَوالي","هَل تَرى اليَومَ غَيرَ قَرنٍ فَاني",0,"ن",2,0],["فالَتُّ لُبّاً مِن عَلائِقِ صَبوَةٍ","وَنَشِطتُ قَلباً مِن جَوىً مُتَخامِرِ",1,"ر",1,0],["فَاِلتَمِس بَعدَهُ المَجَرَّةَ وِرداً","وَتَزَوَّد مِنَ النُجومِ بِزادِ",2,"د",1,0],["فالتصقنا صدراً بصدر وبطناً","فوق بطن وعانةً فوق عانه",3,"ن",2,0],["فَاِلتَفَّ صَفقُهُما وَصُبحٌ تَحتَهُ","بَينَ التُرابِ وَبَينَ حِنوِ الكَلكَلِ",4,"ل",1,0],["فَاِلتامَ طائِقُها القَديمُ فَأَصبَحَت","ما إِن يُقَوِّمُ دَرءَها رِدفانِ",5,"ن",1,0],["فَاِلتَهَمَ الرَأسَ بِيافوخِهِ","وَالحَلقَ مِنهُ فَغرَةَ الجائِعِ",6,"ع",1,0],["فالتمسْ ما جاز في العق","لِ ودعْ ما ليس جائز",7,"ز",1,0],["فالتقى فيك حسنُ رأي أميرٍ","ووزيرٍ كلاهُما خيرُ والي",8,"ل",2,0],["فَاِلتَفَّتِ الشُهبُ حَولَ عَرشي","وَسارَ في طاعَتي الضِياء",9,"ا",2,0],["فالتِماحي إِلى العُيون كريهٌ","وَلَقَد كانَ نزهةَ اللَمّاحِ",10,"ح",1,0],["فَاِلتَفَتَ الديكُ إِلى الذَبيحِ","وَقالَ قَولَ عارِفٍ فَصيحِ",11,"ح",1,0],["فَاِلتَفَتَ الصَيادُ صَوبَ الصَوتِ","وَنَحوَهُ سَدَّدَ سَهمَ المَوتِ",12,"ت",1,0],["فَاِلتَفَتَ الماءُ إِلى الغَزالِ","وَقالَ حالُ الشَيخِ شَرُّ حالِ",13,"ل",1,0],["فَاِلتَفَتَ الغَديرُ لِلعُصفورِ","وَقالَ يُهدي مُهجَةَ المَغرورِ",14,"ر",1,0],["فَاِلتَفَتَ السُلطانُ فيمَن حَولَهُ","وَقالَ كَيفَ تَجِدونَ قَولَه",15,"ه",1,0],["فَالتَلَقّي لَهُ عَقابيلُ خَطبٍ","وَلِفَرطِ التَشييعِ أَيضاً خُطوبُ",16,"ب",1,0],["فَاِلتَهَنّي بِهِنَّ قَبلَ التَعَزّي","راهِنٌ وَالقَضاءُ قَبلَ التَقاضي",17,"ض",2,0],["فَآلَت لِحَمّامٍ فَفازوا بِصَفوِها","وَمَن يُعطِ أَثمانَ المَكارَمِ يُعظَمِ",18,"م",1,0],["فالتهابُ الحياءِ يَمزُجُ فيه","حُمرةَ الأُرجوانِ بالكافورِ",19,"ر",1,0],["فَاِلتَمَس ناصِحاً قَريباً مِنَ النُص","حِ لَطيفاً لِما تُريدُ مَكينا",20,"ن",2,0],["فَاِلتَقَينا فَرَحَّبَت ثُمَّ قالَت","عَمرَكَ اللَهُ اِئتِنا في المَقيلِ",21,"ل",1,0],["فَاِلتَقَينا وَلَم نَخَف ما لَقينا","لَيلَةَ الخَيفِ وَالمُنى قَد تَسوقُ",22,"ق",1,0],["فَاِلتَقَينا فَرَحَّبَت ثُمَّ قالَت","حُلتَ عَن عَهدِنا وَكُنتَ جَديرا",23,"ر",2,0],["فَالتَقينا إِنَّ اللقاءَ قَصيرٌ","فَاِنتَهزهُ وَخلِّ عَنكَ الذهولا",24,"ل",2,0],["فالتحفنا السماء بعد ستورٍ","وشفوفٍ مُذالةٍ وحجال",25,"ل",1,0],["فالتَجا لِلْعَفَافِ مَنْ كانَ يَوْماً","لا له يَخْطُرُ العَفافُ ببالِ",26,"ل",1,0],["فَاِلتَقَينا عَلى العِتا","بِ نُنادي وَنَنتَجي",27,"ي",1,0],["فَاِلتَقَينا بِحَديثٍ","مِن شَكاةٍ وَعِتابِ",28,"ب",1,0],["فَاِلتَجَّ أَعلاهُ ثُمَّ اِرتَجَّ أَسفَلُهُ","وَضاقَ ذَرعاً بِحَملِ الماءِ مُنصاحِ",29,"ح",1,0],["فالتمس نَهزَةَ حُبٍّ ومتاعِ","تحت أُفْقٍ صادحٍ صافي الشعاعِ",30,"ع",1,0],["فَالتُّرْبُ مِسْكٌ وَالْجَدَاوِلُ فِضَّةٌ","وَالْقَطْرُ دُرٌّ وَالْبَهَارُ نُضَارُ",31,"ر",1,0],["فَالْتَمَسْتُ الْخَلاَءَ أَخْبِطُ فِي","سُحْرةٍ عَادَ طَيْرُهَا أَعْشَى",32,"ش",2,0],["فَالْتَقّى الأَصْفِياءُ فِيهِ وَمَا","مِثْلُكَ مِمَّنْ يَسْتَكْثِرُ الأَصْفِياءَ",33,"ا",2,0],["فَاِلتَقَينا فَرَحَّبَت حينَ سَلَّم","تُ وَكَفَّت دَمعاً مِنَ العَينِ مارا",34,"ر",2,0],["فالتقَى بالرضا وبالفوز تاجا","ن وبالوُدِّ والصفا أُمتانِ",35,"ن",1,0],["فَآلَتْ لِهَمّامٍ، فَفازُوا بِصَفْوِهَا،","وَمَنْ يُعطِ أثمانَ المَكارِمِ يَعظُمِ",36,"م",1,0],["فالتِماحي إِلى العُيون كَريهٌ","وَلَقَد كانَ تُرفَةَ اللَّمّاحِ",37,"ح",1,0],["فالتمنّي حرفة الحَمْقَى فلا","تكنْ الأحمقَ إن شىءٌ رَحَلْ",38,"ل",1,0],["فالتفتْنَا للقلبِ حيناً وقلنا","أنتَ أنتَ المدارُ في كلِّ حالِ",39,"ل",1,0],["فالتبر ليس بتبر حين تنبذه","أيدي الصيارف بعد الحك تزييفا",40,"ف",2,0],["فالْتَزَّ عضوٌ بعضوٍ","مني وعِرْقٌ بِعرْق",41,"ق",1,0],["فالتقى الثغران رغم الحسد","وكلانا متعبُ القلب صدي",42,"ي",1,0],["فالتقَت كل فتاةٍ وفتى","فإذا الدنيا سلامٌ وابتسام",43,"م",1,0],["فالتقينا من العتاب طويلاً","بين صَفَّي ملامةٍ واعتذارِ",44,"ر",1,0],["فالتقينا معاً وشمرت الحر","ب على ساقها لسقي الحمام",45,"م",1,0],["فَالتَآخي وَالقُوى تَضرُمُه","هَل مُؤاخاة بِهذا الجَبلِ",46,"ل",1,0],["فالتقينا على مُراد الأماني","واشتفينا بلا تقدُّم وَعْدِ",47,"د",1,0],["فَاِلتَفَّ في غابِ المَكا","رِمِ عيصُهُ وَتَأَشَّبا",48,"ب",2,0],["فاِلتوتِ الشِباكُ","واِلتفَّت الأَشراكُ",49,"ك",1,0],["فَالتَقَينا بِالراحَتَينِ ضِياها","وَاِستَكفَتهُ بِالفِراشِ الشُموعُ",50,"ع",1,0],["فالتراب الذي يصير نُصارا","كالتراب الذي يصير حديدا",51,"د",2,0],["فَالتَهاني لَكُم بِنَيل الأَماني","بلّغت كُلّ منتمٍ آماله",52,"ل",2,0],["فَالتَهاني أرّخَت بشرى لَنا","بِالصَفا وافى سَمِيُّ المُصطَفى",53,"ف",2,0],["فَالتَهاني لِلأُنس أَرَّخن بَدءاً","أَقبل اِقبل فَذي لَيالي العيدِ",54,"د",1,0],["فالتقطت الجواهر التي قد حواها","وتتبعت كل معنى عجيب",55,"ب",1,0],["فالتِّبْرُ أُحرِقَ بالنيرانِ مُصْطَبِراً","على لظاها إلى أن عادَ إِبْريزا",56,"ز",2,0],["فالتَمس الماء من دموعي","فكم لها في الفلا سبيل",57,"ل",1,0],["فالتهَبَتْ فحمتُها جمرةً","من خمرةٍ قاتلةِ القاتلِ",58,"ل",1,0],["فالتقطناه واعتصرنان خمرا","سال تحت الاضراس فوق اللسان",59,"ن",1,0],["فالتطرقنّك ما بكر","ن غوادياً وسرين دُلجْا",60,"ج",2,0],["فالتمسْ ما تشاءُ مني تجدْني","كافلاً بالمُنى وبالآرابِ",61,"ب",1,0],["فالتُّقى ثُمَّ النَّدى قد شَهِدا","أنَّكَ الطَّيِّبُ خُبْراً وخَبَرْ",62,"ر",1,0],["فالتربُ ليس يجيزهُ متيمٌ","فيها وجاري الماء غير محلّل",63,"ل",1,0],["فَالَّتي تَسري إِلَيها","هِيَ خَيرٌ لَكَ مِنها",64,"ه",2,0],["فَاِلتَطَّ بِالبُرقَةِ شُؤبوبُهُ","وَالرَعدُ حَتّي بُرقَةَ الأَجوَلِ",65,"ل",1,0],["فالترب بين ممسك ومعنبر","من نوره بل مائه وروائه",66,"ا",3,0],["فالتبر تربٌ ي تلوُّنها","والترب في ممزوجها تبر",67,"ر",1,0],["فاِلتفِتْ نحوَها بعينِ قَبولٍ","فلها بالقَبولِ أسنى صداقِ",68,"ق",1,0],["فالتَّهاني نَزُفُّها لكَ راجي","نَ منَ اللهِ أن تَدومَ دُهورا",69,"ر",2,0],["فالتفت وانظر لأصلك لا","تفتخر يلحق بك الندم",70,"م",1,0],["فالتفت فالظل أنت له","وتواجد في الهوى تجد",71,"د",1,0],["فالتجلي إن قمت يوماً به لا","بك تعرف من أنت بالأضواء",72,"ا",2,0],["فالتَّداني من التَّنائي وما الرا","حةُ إلا في الكدِّ والإتعابِ",73,"ب",1,0]]}