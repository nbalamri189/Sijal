{"poems":[[53,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[93,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[64,"حكماؤنا وصفوا لنا صنما","https://www.aldiwan.net/poem52165.html","أحذ الكامل"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[47,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[51,"أين القرون الماضيه","https://www.aldiwan.net/poem63205.html","مجزوء الكامل"],[107,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[54,"سل بالصبوح غبوقا","https://www.aldiwan.net/poem26792.html","المجتث"],[50,"إشرب الراح ودعني","https://www.aldiwan.net/poem66604.html","مجزوء الرمل"],[50,"وعاذلة تعيب علي عادي","https://www.aldiwan.net/poem66632.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[92,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[136,"حى المنازل حول نهى الضال","https://www.aldiwan.net/poem54763.html","الطويل"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[164,"رثت لنحولي في هواها وذلتي","https://www.aldiwan.net/poem59010.html","الطويل"],[173,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[178,"وقهوة يترامى","https://www.aldiwan.net/poem46062.html","الخفيف"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[228,"يا ابنة الإثم هذه شفتايا","https://www.aldiwan.net/poem41596.html","الخفيف"],[240,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[242,"عللوني بالوصل قبل الممات","https://www.aldiwan.net/poem18082.html","الخفيف"],[242,"لله يوم شربنا فيه كأس منى","https://www.aldiwan.net/poem19743.html","البسيط"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[309,"يا رب يا عالم الحال","https://www.aldiwan.net/poem16759.html","المجتث"],[333,"أنت دنياي التي تهتف بي","https://www.aldiwan.net/poem54915.html","الرمل"],[415,"واعص اصطبارك إن تكفل أنه","https://www.aldiwan.net/poem32617.html","الكامل"],[422,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[445,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[447,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[447,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122103","البسيط"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82561","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77985","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105432","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52088","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118347","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47182","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106980","الرجز"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46743","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121142","الرمل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22553","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67996","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129389","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17483","الكامل"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77036","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81249","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81264","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104515","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66116","المتقارب"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33655","الرمل"],[4690,"زمانُ الوَصْل","https://www.poetsgate.com/ViewPoem.aspx?id=120304",""],[4927,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=29641",""],[4940,"مُكَابِرَة","https://www.poetsgate.com/ViewPoem.aspx?id=211961",""],[4994,"سرّحي بالحب قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213307",""],[5038,"رذاذ القسطل","https://www.poetsgate.com/ViewPoem.aspx?id=189378",""],[5080,"مدائن التمر","https://www.poetsgate.com/ViewPoem.aspx?id=184906",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5145,"راق الهواء ورقّت الخمر","https://www.poetsgate.com/ViewPoem.aspx?id=108073",""],[5725,"يا انيق العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203178",""],[5888,"عرش مملكتي","https://www.poetsgate.com/ViewPoem.aspx?id=214504",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5975,"أيا من كلما أدنوهُ حبّاً","https://www.poetsgate.com/ViewPoem.aspx?id=58785",""],[6089,"شغفُ القصائدِ","https://www.poetsgate.com/ViewPoem.aspx?id=214246",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["واعصِ الطباع إذا اطَّباك لحفظها","واختر عليه تَكُنْ من الأخيارِ",0,"ر",1,0],["وَاِعصَوصَبَت بَكَراً مِن حَرجَفٍ وَلَها","وَسطَ الدِيارِ رَذِيّاتٌ مَرازيحُ",1,"ح",1,0],["وَاِعصِمِ الأَسرارَ وَاِحجُب كُنهَها","عَن ذَوي العِلمِ وَأَربابِ الذَكاء",2,"ا",2,0],["وَاِعصِ في أَكثَرِ ما تَأتي الهَوى","كَم مُطيعٍ لِهَوى النَفسِ هَوى",3,"ه",3,0],["واعصره واكتفه بخابية","قد سدّ غامض بابها ردمُ",4,"م",1,0],["واعصِفْ عليهم بالقواضبِ عصفةً","تذرُ الرِقابَ الغُلْبَ وهي درينُ",5,"ن",1,0],["وَإِعصِ هَذا الرَكبَ الوُقوفَ وَإِن أَف","تَوكَ لَوماً في فَرطِ ذاكَ الوُقوفِ",6,"ف",1,0],["وَاعصِ الهَوى فيما دَعا","كَ لَهُ فَبِئسَ الداعِيَه",7,"ي",2,0],["واعْصْفُوا بالدِّهرِ إيماناً وصَبْرا","لا تَلِينُوا إنّها الأحداثُ تَتْرَى",8,"ر",2,0],["وَاِعصِ العَذولَ وَدَعهُ","يَنفُخ بِعَذلِكَ بوقا",9,"ق",2,0],["وأعصِ من لامكَ فيها","من نصيحٍ أو شفيق",10,"ق",1,0],["وأعصي عاذلي سرّاً وجهراً","وأجعل جاعةَ الشطّار زادي",11,"د",2,0],["واعصوصب الشر حتى لا ترى أَحداً","إلا يئن من الأرزاء والنوب",12,"ب",1,0],["وأعصاباً تَشُدُّ على الرَّزايا","إذا طاشَتْ وتَغلِبُها اتئادا",13,"د",2,0],["واعصِ العَذُولَ وقُل لَهُ إِن لاَم إِن","نِي هَائِمٌ لَم أَصغِ لِلعُذَّالِ",14,"ل",1,0],["وَأَعصاهُمُ في الأَمرِ وَالنَهيِ لِلهَوى","وَأَطوَعُهُم لِلَّهِ في الحَلِّ وَالعَقدِ",15,"د",1,0],["واعص مشير السوء فيهم فإنه","عدو لهم أو خادع في المشورة",16,"ه",1,0],["وَاِعصَ الذَّليلَ إِذا أَشارَ وَلا تَثِق","في الكائِناتِ بِكُلِّ مَن تَستَصحِبُ",17,"ب",1,0],["وَاعْصِ الرَّقِيبَ فإِنِّي","أُحِلُّ قَتْلَ الرَّقِيبِ",18,"ب",1,0],["وَاعصِ العَوَاذِلَ وَاقرِهَمًّا ضَائفاً","منعَ الرُّقَادَ نَجَاءَ حَرفٍ بازِلِ",19,"ل",1,0],["وَاِعصري ما اِستَطَعتِ قَلبي فَقَلبي","لَم يَزَل فيهِ مِن غَرامي بَقايا",20,"ا",3,0],["وَاِعصِ العَذولَ وَبِت لَوَردِ","الخَدِّ بِاللَحَظاتِ قاطِف",21,"ف",1,0],["وَاعْصِ شَرْخَ الشَّبَابِ مَا اسْطَعْتَ وَاعْلَمْ","أَنَّ رَيْبَ الْمَنُونِ لاَ بُدَّ آتِ",22,"ت",1,0],["وَاعْصِ إِبْلِيسَ وَاتَّخِذْهُ عَدُوّاً","إِنَّمَا يُفْلِحُ الذِينَ عَصَوْهُ",23,"و",2,0],["وأُعصمٌ بالذرى يلفيه معتصما","يلقيه في ذمة الموَّار قد سَهفا",24,"ف",2,0],["واعصمه من شر أو به","لكل ما عنه قد حال",25,"ل",1,0],["واعصري قلبي خمرا واملئى","كأس أيامك منها واشربي",26,"ي",1,0],["واعصِ اصْطبارَكَ إن تكفَّل أَنّه","لك مُسعدٌ فالهجرُ يُظهر حُوبَهُ",27,"ه",1,1],["واعصِ من لامك فيها طائعاً","لذَّة النَّفس فأُنسُ النَّفس ألزم",28,"م",1,0],["وأَعْصَمَ بالإِشْرَاكِ قائِدُ بَغْيِها","إِلَى مَلِكٍ رَبُّ السَّمواتِ عاصِمُهْ",29,"م",2,0],["واعصمني من الشيطا","ن في سعيي وفي كسبي",30,"ب",2,0],["وأعصى من يناصحني","لطوعي من يعاديني",31,"ن",2,0],["وَأَعْصُرٌ ذَهَبَتْ عَنِّي وَقَدْ خَتَمَتْ","رَحِيقَ أُنْسِي بِمِسْكٍ مِنْ لَيَالِيهَا",32,"ي",3,0],["وَاعصِ مَن لامَك في الرا","حِ تَعِش عَيشا لَذيذا",33,"ذ",2,0],["واعصمه فيما قد بقى","فلأنت أقدر من عصم",34,"م",1,0],["واعصم هواك بحبل الرشد مهتدياً","للنسل عزّاً فخير النسل رشدتُهُ",35,"ه",1,0],["وأعصلُ النابِ إن يُغْرَ الكماةُ به","كذلك الحربُ في أَنْيابِها عَصَل",36,"ل",1,0],["واعصوا صبت من خوف أروع تختشي","سطواته الآساد في الأعياص",37,"ص",1,0],["وأعصم بالصمعي ما لي من الردى","وأغسل بالصابوني ما بان من عسري",38,"ر",2,0],["واعصي امر الهوى ولا تتعلق","منك نفس بكل ظبي يمر",39,"ر",1,0],["واعْصِ العَذُولَ إذا وافاك منتصحِاً","فإنّه أَحْسَدُ الحسّادِ إنسانا",40,"ن",2,0],["وأعصر الرمان من","نهديك غمزاً بيدي",41,"د",2,0],["واعصي الوُشاةَ فَقَد عَصَيتُ أَقارِبي","وَوَصَلتُ حَبلَكِ واِرعوى عُذّالي",42,"ل",2,0],["واعصم القلب ولاطف","أمة تطلب رشدا",43,"د",2,0],["وَاِعصَوصَبَت فَتَدانى مِن مَناكِبِها","كَما تَقاذَفَتِ الخُرجُ المَجافيلُ",44,"ل",1,0],["واعصِ الهوى فالنفسُ تأ","مر بالفواحشِ والرِّيَب",45,"ب",1,0],["واعصُرْ غصونَ الأُنسِ من شَجر الهنا","وانشَقْ روائحَ مِسْكِه وكبائه",46,"ا",3,0],["واعصار مرت من رجال أماجد","على غيرهم ما احملتني عصورها",47,"ر",3,0],["واعصمي نفسك بالصبر الجميل","فهو في الشدة نعم المستعان",48,"ن",1,0],["وَاِعصوا الَّذي يُزجي النَمائِمَ بَينَكُم","مُتَنَصِّحاً ذاكَ السَمامُ المُنقَعُ",49,"ع",1,0],["واعصِمهُمُ فيما بقي من عُمرِ","خُذ بنواصِيهِم لِفعل البرِّ",50,"ر",1,0],["وَاِعصِها في حُظوظ ما تَشتَهيه","وَاِفعَل الخَيرَ عامِداً تَصطَفيهِ",51,"ه",1,0],["وَاِعصروا قَلبي المُفزع للحُس","ن أَماناً وَعوذوه بِ نوح",52,"ح",1,0],["وَاِعصِفي يا رِياح في مَسمَع الفَجر","يَفق عُنصر الثَرى مِن غُروره",53,"ر",2,0],["واعصب الجرح بمنسوج الحرير","ناعما يهفو إليه الأنعم",54,"م",1,0],["واعْصارُ ضِغْنٍ يُثِيرُ الحُقُودَ","ويُرْبي الصُّدُودَ ويُحْيي الذُّحُولا",55,"ل",2,0],["واعصِ مَن يَعذلُ في الوجدِ لِمَن","إنما يوماهُ نُورٌ وحسَن",56,"ن",1,0],["واعْصِفي في وَجْهِ سَفَّاحٍ بَغى","واشْحَذي فيكِ الرَّدَى وانْغَرِسي",57,"س",2,0],["وَاعْصِ الْعَوَاْذِلَ، إِنَّهُمْ مِنْ طِيْنَةٍ","وَثَنِيَّةٍº زُرِعَتْ بِهَا الأَلْغَاْمُ",58,"م",1,0],["وأعصي أمرَ نبضِ القلبِ قصدا","وإن غربًا يسيرُ أسيرُ شَرقَا",59,"ق",2,0],["واعصُري كرمةَ روحي","واشرَبي العشقَ وصُبّي",60,"ب",2,0],["واعْصِ الْجبانَ اذا أتاكَ برأْيهِ","فكليلُ عزْمهِ مثْلُ لومِ العذّلِ",61,"ل",1,0],["واعصرُ الآهَ في كأسٍ اعتقُهُا","فهل سمعتَ بآهٍ اصبحتْ خمرا",62,"ر",2,0],["وَأَعْصِرُ الشُّهْدَ تِرْيَاْقَاً لِعَاْرِضَتِيْ","وَأَنْحُتُ النَّصْرَ فَوْقَ الرُّمْحِ وَالْعَضَبِ",63,"ب",1,0],["واعص العواذل إن عذلن ولا","تعبأ بهنّ فإنه هذر",64,"ر",1,0],["واعصر الحب خمرةً واسقنيها","من رحيق اللمى وشهد الرضابِ",65,"ب",1,0],["وأعصرُ الحرفَ في أقداحِ أضلعِه","وأملأُ الدَّنَّ أسراراً بخابيتي",66,"ت",2,0],["واعصم سقاءك بالوكاء من الظما","ما في الفضاء امام قصدك ماء",67,"ا",2,0],["وأعصي فيهِ بالتقوى الأداني","وأقربُ من بعيدِ الدارِ .. أجري",68,"ر",2,0],["واعصرْ فمًا كلماتُهُ وكأنّها","مُزِجَتْ معانيها لأجلِكَ سُكّرَا",69,"ر",2,0],["وَاعصِفي غَضْبَةَ الأعَاصِير ، وارْمي","فَوْقَهُ مِنْ قَنابلٍ وحَديدِ",70,"د",1,0],["واعصم النفس أن تزل وهبني","حكمة فيها لا يضل جناني",71,"ن",2,0]]}