32258.html","الكامل"],[407,"أسلم بن عمر وقد تعاطيت خطة","https://www.aldiwan.net/poem67487.html","الطويل"],[426,"ساقي المدام فزند الشوق قد قدحا","https://www.aldiwan.net/poem40532.html","البسيط"],[434,"يا خازنا من رأى شمائله","https://www.aldiwan.net/poem2525.html","المنسرح"],[436,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[436,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[447,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[456,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[456,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[456,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[456,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[456,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[456,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[456,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[456,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[459,"مشمر للهول غير زمل","https://www.aldiwan.net/poem15400.html","الرجز"],[459,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"شمت الظبى وسللت كل صحيفة","https://www.aldiwan.net/poem3172.html","عموديه"],[462,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[462,"صحة الوجد بالجفون المراض","https://www.aldiwan.net/poem3588.html","عموديه"],[462,"كم بين اظعان الخليط الزائلِ","https://www.aldiwan.net/poem3603.html","عموديه"],[468,"أسلام إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem4655.html","الكامل"],[468,"أسلام هل لمتيم تنويل","https://www.aldiwan.net/poem4786.html","الكامل"],[477,"قل هكذا مد الشباك","https://www.aldiwan.net/poem37068.html","مجزوء الكامل"],[498,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[512,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[513,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[516,"عربي أنا","https://www.aldiwan.net/poem13728.html","عموديه"],[527,"يا أحمد بن محمد","https://www.aldiwan.net/poem37133.html","الكامل"],[536,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[556,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[556,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[556,"نحن أهل الشام سوط الله في","https://www.aldiwan.net/poem34357.html","الرمل"],[556,"أسلك طريق السلامه واغتنم عيدو","https://www.aldiwan.net/poem34587.html","المواليا"],[556,"يا نسبة أدخلت سلمان في النسب","https://www.aldiwan.net/poem34930.html","البسيط"],[565,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أسلفت تقبيلي لسالفتيه","https://www.aldiwan.net/poem2826.html","الكامل"],[573,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"]],"verses":[["أَسِل بِدَمعِكَ وادي الحَيِّ إِن بانوا","إِنَّ الدُموعَ عَلى الأَحزانِ أَعوانُ",0,"ن",1,1],["أَسلُبُ في الجَريِ إِلى رُبعِهِ","سَنطَلَةَ الذِئبِ وَشَأوَ الظَليم",1,"م",1,0],["أَسَلنَ بِالدَمِ وادي كُلِّ غامِضَةٍ","مِنَ العُيونِ كَماءِ المُزنِ لَم يَسِلِ",2,"ل",1,0],["أَسلَفتَهُ وَعداً عَلَيكَ تَمامُهُ","وَسَيُدرِكُ المَطلوبَ إِن لَم يَعجَلِ",3,"ل",1,0],["أُسَلِّمُ إِن أَرادَ اللَهُ أَمراً","فَأَترُكُ ما أُريدُ لِما يُريدُ",4,"د",1,0],["أُسَلِّمُ أمْري في الوُجودِ لعالِمٍ","أحاطَ بأَمْري منْهُ مرْأىً ومَسْمَعُ",5,"ع",1,0],["أسَلِيلَ مَجْدِهِمُ وَسِبْطَ فَخَارِهِمْ","وَمُؤَمَّلَ الْقَاصِي وَقَصْدَ الدَّانِي",6,"ن",2,0],["أَسلَمَتنا إِلى صُروفِ زَمانٍ","ثُمَّ لَم توصِها بِحِفظِ الوِدادِ",7,"د",1,0],["أَسلَمتُ نَفسي لِلهَوى وَأَظُنُّها","مِمّا يُجَشِّمُها الهَوى لا تَسلَمُ",8,"م",1,0],["أَسلافِ ساداتٍ سَما بِجُلوسِهِم","رَأسُ السَريرِ وَمَسنَدُ التَدريسِ",9,"س",1,0],["أسليلة الأصلين من شرف","محضن ونبل خالص حر",10,"ر",1,0],["أسَلِيلَ آلِ المَنْزِلاَوِيِّ الأُولَى","بَلَغُوا مِنَ العَلْيَاءِ أَرْفَعَ شَانِ",11,"ن",1,0],["أَسلَمتُمُ كُلَّ مُجتابٍ عَباءَتَهُ","وَكُلَّ مُخضَرَةِ القُربَينِ تُبتَقَرُ",12,"ر",1,0],["أَسلَمتَ أَحمَرَ وَاِبنَ عَبدِ مُحَرِّقٍ","وَوُجِدتَ يَومَإِذٍ أَزَبَّ نَفورا",13,"ر",2,0],["أَسلَمَني الصُبحُ لِلبَلايا","فَلا حَبيبٌ وَلا نَديمُ",14,"م",1,0],["أَسلَمَنا قَومُنا إِلى نُوَبٍ","أَيسَرُها في القُلوبِ أَقتَلُها",15,"ل",3,0],["أَسلَمُ أَفصى غَيرَ آلِ عُوَيمِرٍ","بَقِيَّةُ عِدّانٍ دِقاقٍ أُيورُها",16,"ر",3,1],["أَسلَمتُموهُ وَهوَ يَدعوكُمُ","بِالنَسَبِ الأَدنى وَبِالجامِعِ",17,"ع",1,0],["أَسلَمتُمُ حَذَرَ الطِعانِ أَخاكُمُ","بَينَ الكُدَيدِ وَقُلَّةَ الأَعرافِ",18,"ف",1,0],["أسلُ الغِنى عنك الذي","أغناكَ عنّي بالثراءِ",19,"ا",2,1],["أسلمتَ نَفسَكَ للهجاء ولو غدا","أو راح يملك فديةً منك افتدى",20,"د",2,0],["أسلمتني من يديك في يديَ ال","لَهِ وحَسْبي به من البشر",21,"ر",1,0],["أسلمتَها للقذع يلفَحُ وجهها","صبرتْ له كَرْهاً وإن لم تصبر",22,"ر",1,0],["أسَلُ الذي عطفَ الأعن","نَة والمواكبَ نحو بابِكْ",23,"ك",1,1],["اسلمْ على الأيامِ","مُعَمَّراً ألف عامِ",24,"م",1,1],["أَسلَمتَني لِلقَلبِ وَهوَ مُضَلَّلٌ","فَأَدرَّني وَأَضَرَّكَ اِستِسلامي",25,"ي",1,0],["أَسلَمتَني لِلعَقلِ وَهوَ مُضَلَّلٌ","فَأَضَرَّني وَأَضَرَّكَ اِستِسلامي",25,"ي",1,0],["أَسلابُهُم لِلظافِرينَ غَنيمَةٌ","وَجُسُمُهُم لِلحاجِلِ الغَرثانِ",26,"ن",1,0],["أَسلَمتُ لِلسُهدِ طَرفي وَالضَنى بَدَني","إِنَّ الصَبابَةَ لا يُرجى تَلافيها",27,"ي",3,0],["أسليمى لا تقطعي حبل وصلي","واقطعي إن أردت حبل وريدي",28,"د",2,0],["إسلم بروحك حرام","دى عين تقيم القيامة",29,"ه",1,0],["أسلم محمد سيدى","للوالدين وعش لمصرا",30,"ر",2,1],["أسليك فيه ولى فؤاد","يذوب للميت والحزين",31,"ن",1,0],["أَسلَمه الأَهلون حَتّى ابناه","وَخَذلت شِمالَه يمناه",32,"ه",1,0],["أَسلَمتُهُم لِعُيونِ اللَهِ تَحرُسُهُم","وَأَسلَموني لِظِلِّ اللَهِ في البَشَرِ",33,"ر",1,0],["أسلَمتَ لحيتَكَ الطويلَةَ للبلى","وثويتَ لا أجراً ولا محمودا",34,"د",2,0],["إِسلَم سَلِمتَ عَلى الأَيامِ ما بَقِيَت","قَرارِنُ الدَهرِ وَالأَيامُ وَالحِقَبُ",35,"ب",1,0],["إِسلَم وَلا زِلتَ في سِترٍ مِنَ النُوَبِ","وَعِش حَميداً عَلى الأَيّامِ وَالحِقَبِ",36,"ب",1,0],["إِسلَم أَبا جَعفَرٍ يَسلَم لَنا كَرَمٌ","وَبَيتُ مَجدٍ إِلى عُلياكَ مَردودِ",37,"د",1,0],["إِسلَم أَبا صالِحٍ لِلمَكرُماتِ فَقَد","أَحيَيتَها وَهيَ مِن مَوتٍ عَلى صَدَدِ",38,"د",1,0],["أَسلَمَتهُ يلى الرُقادِ رِجالٌ","لَم يَكونوا عَن وِترِهِم بِرُقودِ",39,"د",1,0],["إِسلَم أَبا عُثمانَ مِن حَتفِ الرَدى","في نِعمَةٍ تَحتاجُ كُلَّ حَسودِ",40,"د",1,0],["أَسلَمَني الصَبرُ إِلى هَجرِهِ","ما كانَ أَغناني عَنِ الصَبرِ",41,"ر",1,0],["اِسلَم أَبو العَبّاسِ واِب","قَ وَلا أَزالَ اللَهُ ظِلَّك",42,"ك",1,1],["اِسلَم أَميرَ المُؤمِنينَ لِسُنَّةٍ","أَحيَيتَها وَالناسُ حَيرى ضُلَّلُ",43,"ل",1,0],["اِسلَم لِدينِ مُحَمَّدٍ","فَإِذا سَلِمتَ فَقَد سَلِم",44,"م",1,0],["أَسلَمَهُ لِلزَعفَرانِ مِسلِمُه","أَحسَنُ مَن تَحمِلُ نَعلاً قَدَمُه",45,"م",2,0],["إِسلَم أَبا الصَقرِ لِلمَعروفِ تَصنَعُهُ","وَالمَجدِ تَبنيهِ في ذُهلِ بنِ شَيبانِ",46,"ن",1,0],["أَسلابُ يَومِ قُراقِرٍ كانَت لَنا","تُهدى وَكُلُّ تُراثِ أَبيَضَ خِضرِمِ",47,"م",1,0],["أسلَفَني الدهرُ عندَهنَّ يداً","حتَّى إذا استُحْسِنَت تَقضَّاها",48,"ا",3,0],["أُسَلِّمُ للأَيَّامِ أَم لا أُسَلِّمُ","وأَحمِلُ ظُلْمَ الدَّهْرِ أَمْ أتظَلَّمُ",49,"م",1,1],["إسلَم أبا الهيجاءِ للشرفِ الذي","نَجَمَت عُلاك به فكانَت أنجُما",50,"م",2,0],["أَسَلاسلَ البَرقِ الذي لحظَ الثَّرى","وَهَناً فوشَّحَ رَوضَه بسَلاسلِ",51,"ل",1,0],["اِسلُك مِنَ الطُرُقِ المَناهِج","وَاصبِر وَإِن حُمِّلتَ لاعِج",52,"ج",1,1],["اُسلُ عَنِ الدُنيا وَعَن ظِلِّها","فَإِنَّ في الجَنَّةِ ظِلّاً ظَليل",53,"ل",1,0],["إِسلَم هُديتَ وَكُن بِنَف","سِكَ عالِماً طَبّاً فَقيها",54,"ي",3,0],["أَسلاهُ