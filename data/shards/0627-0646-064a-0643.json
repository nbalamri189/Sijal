","الخفيف"],[433,"دون بيض الخدور سمر العوالي","https://www.aldiwan.net/poem12694.html","الخفيف"],[438,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[440,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[442,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[442,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[447,"إن يكن قتلنا الملوك خطاءً","https://www.aldiwan.net/poem23917.html","الخفيف"],[454,"غلب الجوع فهاتي المش هاتي","https://www.aldiwan.net/poem61231.html","الرمل"],[454,"ليس منا قال الحسود المعنى","https://www.aldiwan.net/poem61347.html","الخفيف"],[454,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[454,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[459,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[459,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[459,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[465,"أنة الحب زفرة وعويل","https://www.aldiwan.net/poem3412.html","عموديه"],[469,"يا رسولي خل عنك الظرف","https://www.aldiwan.net/poem59758.html","مجزوء الرمل"],[469,"أخلوق يسيل من كافور","https://www.aldiwan.net/poem60049.html","الطويل"],[471,"يبكي لما قلب الزمان جديده","https://www.aldiwan.net/poem4780.html","الكامل"],[496,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[506,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[514,"ما لهم أنكروا سوادا بخديه","https://www.aldiwan.net/poem67681.html","الخفيف"],[516,"حرت ماذا أقول فيما دهاني","https://www.aldiwan.net/poem12293.html","الخفيف"],[517,"وليس يزري السواد يوما بذي","https://www.aldiwan.net/poem48714.html","الخفيف"],[528,"إن ذا البلعمي والعين غين","https://www.aldiwan.net/poem46021.html","الخفيف"],[530,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[538,"إن يكن ولى الأمير فقد","https://www.aldiwan.net/poem69397.html","المديد"],[539,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[539,"ليس مصر وطنا لي","https://www.aldiwan.net/poem48138.html","عموديه"],[539,"إن يكن غيري تابا","https://www.aldiwan.net/poem48275.html","عموديه"],[543,"ليس يزري السواد بالرجل الشهم","https://www.aldiwan.net/poem34034.html","الخفيف"],[552,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[552,"أنكرت ليلة اعتنقنا حسامي","https://www.aldiwan.net/poem48020.html","الخفيف"],[554,"إني كثرت عليه في زيارته","https://www.aldiwan.net/poem68317.html","البسيط"],[559,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[559,"هذا وهذا ثم هذا بعده","https://www.aldiwan.net/poem34608.html","الكامل"],[561,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[563,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[568,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[577,"إني كساني أبو قابوس مرفلة","https://www.aldiwan.net/poem1803.html","البسيط"]],"verses":[["إِن يَكُن مُلكٌ فَمِثلي نالَهُ","أَو يَكُن حَتفٌ فَإِنّي لَم أُلَم",0,"م",1,0],["إِن يَكُن عيداً فَأَيّا","مُكَ أَعيادُ الخَليقَه",1,"ق",2,0],["إِن يَكُن في نَدى المُلوكِ سُبوغٌ","لِلمُرَجّي فَفي رَجايَ قُلوصُ",2,"ص",1,0],["إِن يَكُن تاجاً وَعَضداً فَاِبنُهُ","دُرَّةُ التاجِ وَدُملوجُ العَضُد",3,"د",1,0],["إِن يَكُن يَنفَعُ البُكاءُ عَلَيهِم","فَاِبكِ حَتّى تَموتَ يا مَحرومُ",4,"م",1,0],["إنْ يكُنْ لمْ يرْعَ عهْدي في الهَوى","فوَقاهُ اللهُ ربّي ورَعاهُ",5,"ا",2,0],["إِن يَكُنْ دَيْناً عَلَى الأَيْ","يَامِ قَدْ حَانَ التَّقَاضِي",6,"ض",2,0],["إِنْ يَكُنْ مَا تَأَرَّج الْجَوُّ مِنْهَا","وَاسْتَفَادَ الشَّذَى وَإِلاَّ فَمِمَّهْ",7,"م",2,0],["إِن يَكُن غابَ عَن جَبينِكِ تاجٌ","كانَ بِالغَربِ أَشرَفَ التيجانِ",8,"ن",1,0],["إِن يَكتُبوا لِيَ ذَنباً في مَوَدَّتِهِم","فَإِنَّما الفَخرُ في الذَنبِ الَّذي كَتَبوا",9,"ب",3,0],["إِنّي كَهَمِّكَ في الصَبابَةِ لَم أَزَل","أَلهو وَأَرتَجِلُ القَريضَ وَأَعشَقُ",10,"ق",1,0],["إِن يَكُن لي أَمَلٌ غَيرَ الرِضا","مِنكَ لا بُلِّغتُ ذاكَ الأَمَلا",11,"ل",2,0],["إِن يَكُ هَذا الدَهرُ أَودى بِهِ","وَصارَ مَسحاً لِمَجاري القِطار",12,"ر",1,0],["أن يكونوا على الزمان عتادي","فبعيد المنى قريب المنال",13,"ل",1,0],["إِنْ يَكُ البَدْرُ اسْتَوَى","فَوْقَ عَرْشٍ فُكَنِ",14,"ن",1,0],["إِن يَكُن في الكَنيفِ شَيءٌ تَخَبّا","هُ فَعِندي إِن شِئتَ فيهِ مَزيدُ",15,"د",1,0],["أن يكن مبدئين آباؤك الغرّ","فكن أنت يا أمين معيدا",16,"د",2,0],["ان يكن قد زايل القوم فما","لمساعيه عن القوم زيال",17,"ل",1,0],["إن يك العقل في دجى الشك نجماً","فخفيٌّ مثل السها وضيئل",18,"ل",1,0],["إن يكن أغمد الردى منه في القب","ر حساماً فذكره مسلول",18,"ل",1,0],["أَن يَكشِفَ الوَصَبَ الَّذي أَمسى بِهِ","فَأَجابَ دَعوَةَ شاكِرٍ مِحمادِ",19,"د",1,0],["إِن يَكُن في الحَياةِ خَيرٌ فَقَد أُن","ظِرتُ لَو كانَ يَنفَعُ الإِنظارُ",20,"ر",1,0],["إِن يَكُن صادِقَ الوِدادِ فَهَلّا","تَرَكَ الهَجرُ لِلوِصالِ مَكانا",21,"ن",2,0],["إِن يَكُن رَثَّ مِن رَقاشِ حَديثٌ","فَبِما نَأكُلُ الحَديثَ سَمينا",22,"ن",2,0],["إن يكسِي ما سيبليه الزمان فقدْ","كساه ما ليسَ يبلى نسج نساج",23,"ج",1,0],["إن يكن في العفاة ابسط كفًّا","فهو في المكرماتِ أبسط زندا",24,"د",2,0],["إن يكن بيتك الطويل فخاراً","إنَّ بيت الثنا عليك مديد",25,"د",1,0],["إن يكُ عشقي مفروضاً على","مهجتي إن لذاك اللحظ مسنون",26,"ن",1,0],["إِن يَكُن غَيَّبَكَ التَع","ظيمُ عَن لَحظِ عِياني",27,"ن",2,0],["إن يكن كلُّ ذاك فيك فهذا","مذهبٌ من مذاهبِ الفقهاءِ",28,"ا",2,0],["إن يَكُنْ عَنَّ مِنْ أخيك فَعَالٌ","جارَ فيه عن مذهب الأوفياءِ",29,"ا",2,0],["إن يكُ لم يُغنِ عنك شيئاً","وَقْعَ الهواضيم في حشاكا",30,"ك",2,0],["إنْ يكُنْ يطلبُ شتمي أمَّهُ","فلقد نال الذي مني طلبْ",31,"ب",1,0],["إن يكُنْ ذاك مُغْفَلاً عند عَبْدٍ","فهْو لي عند سيّدٍ مكتوبُ",32,"ب",1,0],["إن يكن عندك لي نُصْ","حٌ فما عِنْدي انْتِصَاحُ",33,"ح",1,0],["إن يكنْ عندك لُبٌّ","فأقاويلي صحاحُ",33,"ح",1,0],["إن يكن للزمان عيدٌ فأيَّا","مك عند الزمان من أعيادِهْ",34,"د",2,0],["إن يكن نُوِّلَ نيْلاً من يد","فلقد نَوَّلَ نيْلاً من فؤادِ",35,"د",1,0],["إن يكن فيّ ما ذكر","تَ وقد يكذبُ الخبرْ",36,"ر",1,0],["أنْيك الناس لعرسي","ه برمحٍ مستعار",37,"ر",1,0],["إن يكن ما فعلتَ بِرّاً لطيفاً","إن ميثاق شكره لغليظ",38,"ظ",1,0],["إن يكن جاء خيرُ باعثِ جوعٍ","فسيلقاك خير قاتِل جوع",39,"ع",1,0],["إن يكنِ الظلم منك يرهقها","فظلم مولاك غيرُ راهقها",40,"ق",3,0],["إن يَكُ آباؤكم بنوا لكُمُ","طوْداً من المجد يفرَعُ القمَما",41,"م",2,0],["إن يكُن الهدمُ نال ذِروتَها","فقد أُراها مَهيبةً بِكُمُ",42,"م",1,0],["إن يكنْ دائيَ الهوى فتيقَّنْ","أنهُ منذ كان داءُ الكرام",43,"م",1,0],["إن يكونوا أباعداً فالمعالي","نَسبٌ بينهم وبينك داني",44,"ن",2,0],["إِن يَكُن عِلمُ الوَرى يَشفيهِمُ","يا إِلَهي رُدَّ لِلناسِ الغَباء",45,"ا",2,0],["إِن يَكُ المَوتُ قِصاصاً أَيُّ ذَنبٍ لِلطَهارَه","وَإِذا كانَ ثَواباً أَيُّ فَضلٍ لِلدَعارَه",46,"ه",1,0],["إِن يَكُ المَوتُ رُقاداً بَعدَهُ صَحوٌ طَويل","فَلِماذا لَيسَ يَبقى صَحوُنا هَذا الجَميلِ",46,"ل",1,0],["إِن يَكُ المَوتُ هُجوعاً يَملَءُ النَفسَ سَلاما","وَاِنعِتاقاً لا اِعتِقالا وَاِبتِداءً لا خِتاما",46,"م",2,0],["إِن يَكُن مُشرِقاً لِعَينَيكَ إِنّي","لا أَراهُ مِن كُوَّةِ الكوخِ أَسوَد",47,"د",1,0],["إِن يَكُ المَوتُ قَد مَضى بِأَبيهِ","ما مَضى بِالشُعورِ فيكَ وَفِيّا",48,"ي",2,0],["إِن يَكُن يُرضيكَ هَجري","إِنَّ ذاكَ الهَجرَ وَصلُ",49,"ل",1,0],["ان يكن أحمد تنبأ في القو","م فما ان عليه من تثريب",50,"ب",1,0],["ان يكن رزقا فهو غير لذيذ","او يكون ماء فهو غير مريئ",51,"ي",2,0],["ان يكن النثر من الفضة","فالشعر ذهب",52,"ب",1,0],["أن يكن فوق هذه الأرض شيء","فيه قدسيّةٌ فهذا البناء",53,"ا",2,0],["إن يكن إثرك لم يهلك أسى","هو ملاك إليه أستشفعك",54,"ك",1,0],["إِن يَكُ في مِصرَ العَزيزَ إِنَّهُ","مِن المُحيط مُلكُهُ إِلى سَبا",55,"ا",1,0],["إِن يَكُن غَيرَ ما أَتَوهُ فَخارٌ","فَأَنا مِنكَ يا فَخارُ بَراءُ",56,"ا",2,0],["إِنْ يَكُ في العِزِّ له مِشْقَصٌ","ماضٍ فَقَدْ تاحَ لَهُ مَقْتَلُ",57,"ل",1,0],["إِن يَكُن صَبرُ ذي الرَزِيَّةِ فَضلاً","تَكُنِ الأَفضَلَ الأَعَزَّ الأَجَلّا",58,"ل",2,1],["إِن يَكُنِ البَضعُ ضَرَّ باطِنِها","فَرُبَّما ضَرَّ ظَهرَها القُبَلُ",59,"ل",1,0],["إِن يَكُن في الأَنامِ سَعدُ سُعودٍ","بَشَرِيّاً فَأَنتَ سَعدُ السُعودِ",60,"د",1,0],["إِن يَكُن ما طَلَبتُ حَقّاً يُطالِب","نَفسَهُ بِالوَفاءِ أَرضى غَريمِ",61,"م",1,0],["إِن يَكُن راعَكَ الفِراقُ فَعِندي","مِنهُ خَطبٌ أَعيا عَلَيَّ عَظيمُ",62,"م",1,0],["إِن يَكُ سَيفٌ خانَ أَو قَدَرٌ أَبى","وَتَأخيرُ نَفسٍ حَتفُها غَيرُ شاهِدِ",63,"د",1,1],["إِن يَكُ خالُها مِن آلِ كِسرى","فَكِسرى كانَ خَيراً مِن عِقالِ",64,"ل",1,1],["إِنّي كَذاكَ إِذا هَجَوتُ قَبيلَةً","جَدَّعتُهُم بِعَوارِمِ الأَمثالِ",65,"ل",1,0],["إِنّي كَتَبتُ إِلَيكَ أَلتَمِسُ الغِنى","بِيَدَيكَ أَو بِيَدَي أَبيكَ الهَيثَمِ",66,"م",1,1],["أَن يَكُ مِني قَد دَنا قَضاكا","رَبِّ فَبارِك لِيَ في لِقاكا",67,"ك",2,0],["إِن يَكُن ما كانَ مِنهُ","فَبِجُرمي وَفِعالي",68,"ل",2,0],["إن يكن من قميص يوسف قد س","ر أبوه لموقع التخصيص",69,"ص",1,1],["إِن يَكُن صَدَّنا عَنِ الراحِ ذو الأَم","رِ وَذو الأَمرِ في الأُمورِ مُطاعُ",70,"ع",1,0],["إِن يَكُن حُرِّمَ المُدامُ عَلَينا","فَلَدَينا الحَشيشُ وَالفُقّاعُ",70,"ع",1,0],["إِن يَكُ شُربُها حَراماً عَلى النا","سِ بِنَصِّ الكِتابِ وَالأَنباءِ",71,"ا",2,0],["إِن يُكَذِّب بِها عِداكَ فَقَد كَذ","ذَبَ مِن قَبلُ قَومُ لوطٍ وَعادُ",72,"د",1,0],["إن يكن مظهر يا زي","نب ربّ المعجزات",73,"ت",1,1],["إن يكن قد شقي الما","ضي فما أهنا البقيه",74,"ي",2,0],["إن يكن حلماً تولى مسرعاً","أجمل الأحلام ما ولى سريعا",75,"ع",2,0],["إن يكن ما كان دَيناً يقتضي","خلني أدفعه عنك دموعا",75,"ع",2,0],["إن يكُنْ سحركِ قد خُصّ بهِ","لحظُ طرفٍ منك أو لفظُ لسان",76,"ن",1,0],["إِن يَكُن أَسقَمَ الهَوى","بَعدَ تَصحيحَ وُدِّهِ",77,"د",2,0],["إِنّي كَشَفتُكِ أَزمَةً بِأَعِزَّةٍ","غُرٍّ إِذا غَمَرَ الأُمورَ بَهيمُها",78,"م",3,0],["إِن يَكُن في الأَرضِ شَيءٌ حَسَنٌ","فَهوَ في دورِ بَني عَبدِ المَلِك",79,"ك",1,1],["إِن يَكُن رَثَّ مِن أُناسٍ بِهِم كا","نَ يُداوى شَوقي وَيَسلُسُ ريقي",80,"ق",2,0],["إِن يُكدُ مُطَّرَفُ الإِخاءِ فَإِنَّنا","نَغدو وَنَسري في إِخاءٍ تالِدِ",81,"د",1,0],["إنْ يكنْ أشهرَ مني",