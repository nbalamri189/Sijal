{"poems":[[65,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[53,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[72,"وثقيل إذا بدا","https://www.aldiwan.net/poem42441.html","مجزوء الخفيف"],[91,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[91,"خدعوها بقولهم حسناء","https://www.aldiwan.net/poem44939.html","الخفيف"],[87,"خدعوها بقولهم حسناء","https://www.aldiwan.net/poem61201.html","عموديه"],[87,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[87,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[68,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54758","الخفيف"],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[87,"كلُّ حيٍّ على المنية غادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9597&r=&rc=87",""],[119,"يا رجال البطاح يا ساداتي","https://www.aldiwan.net/poem41205.html","عموديه"],[119,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[214,"قسما بفرط تلهبي وتلهفي","https://www.aldiwan.net/poem13350.html","الكامل"],[264,"نحن قوم للحاتمي عبيد","https://www.aldiwan.net/poem35505.html","الخفيف"],[353,"نظرت من خلل السج","https://www.aldiwan.net/poem20746.html","مجزوء الرمل"],[409,"وعلى نظم وقفنا رائق","https://www.aldiwan.net/poem33596.html","الرمل"],[438,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[484,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[520,"يا سيداً في أوصافه","https://www.aldiwan.net/poem12111.html","مجزوء الكامل"],[534,"صف قلبي من كدورات الذنوب","https://www.aldiwan.net/poem37520.html","الرمل"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[563,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[563,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[563,"إن عين الوجود ليس تنام","https://www.aldiwan.net/poem34186.html","الخفيف"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[563,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[580,"أخبروني عن مرهف القد مطبو","https://www.aldiwan.net/poem2698.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130161","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59588","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62720","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1256,"","https://poetry.dctabudhabi.ae/diwan/poem/146034","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77917","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104739","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109428","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82959","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94253","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108419",""],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199171","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131953","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128893","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135232","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111473","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54497","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139533",""],[4755,"كَغَريبٍ تَنَاهَشَتْهُ الهُمُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=187242",""],[4578,"في ربيع عادنا عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=49443",""],[5038,"بشائر النصر","https://www.poetsgate.com/ViewPoem.aspx?id=195223",""],[3591,"هكذا هكذا وإلاّ فلالا","https://www.poetsgate.com/ViewPoem.aspx?id=149456",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5199,"حبرى وقرطاسى","https://www.poetsgate.com/ViewPoem.aspx?id=150497",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[3294,"لي شوق لم أستطع لك بثه","https://www.poetsgate.com/ViewPoem.aspx?id=173262",""],[5533,"إنَّما الفَارُوْقٌ عَدْلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176963",""],[5628,"لست شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=178488",""],[5791,"حيود في نسق المحبرة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208644",""],[5956,"السماح والحب هُمَا وسيلتا لمِّ الشمل الأبديِّ","https://www.poetsgate.com/ViewPoem.aspx?id=204607",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""]],"verses":[["وعلى ندىً المُستَظهِرِ بنِ المقتَدِي","حامَ الرَّجاءُ يُظِلُّهُ التَّحقيقُ",0,"ق",1,0],["وعلينا إذ قضى حَكَمٌ","أن سَبَقْتَ الفطر في الأمدِ",1,"د",1,0],["وَعَلى نَحسِهِ فَقَد","قيلَ عَنهُ بِأَنَّهُ",2,"ن",2,0],["وعلى نشز فوق دجلة نستلقي","ابتغاء لراحة حين نتعب",3,"ب",1,0],["وعلينا من العفاف رقيب","دونه في التيقظ الرقباء",4,"ا",2,0],["وَعَلَينا مِنَ العَفافِ رَقيبٌ","تَعِبَت في مِراسِهِ الأَهواءُ",5,"ا",2,0],["وَعَلى نائِمٍ وَسَهرانَ فيها","أَجَلٌ لا يَنامُ بِالمِرصادِ",6,"د",1,0],["وَعَلَينا كَما عَلَيكُم حَديدٌ","تَتَنَزّى اللُيوثُ في قُضبانِه",7,"ن",2,0],["وَعَلى نِجادِكَ هالَتا","نِ مِنَ القَنا وَالدارِعين",8,"ن",1,0],["وَعَلى نُبُوَّتِكَ المُعَظَّمِ قَدرُها","قامَ الدَليلُ وَأُوضِحَ البُرهانُ",9,"ن",1,0],["وَعَلَى نَجِيبٍ خَافَتٍ لَمْ يَعْدُ مَا","يَشْكُوهُ ذُو دَنَفٍ مِنَ الأسْقَامِ",10,"م",1,0],["وَعَلَيْنَا أَبُو الصَّحَافَة فِي الشَّرْ","قِ رَئِيسٌ نِعْمَ الرَّئِيسُ الْهَادِي",11,"د",2,0],["وعلينا نحسو الشظايا، نصلي","لشموخ لم يلق فينا جبينا",12,"ن",2,0],["وعلينا نرى السباع، حماماً","ونسمي سود الحصى، ياسمينا",12,"ن",2,0],["وعلينا أن نستكين ونوصي","كل خفق في القلب أن يستكينا",12,"ن",2,0],["وعلى نائمٍ وسَهْرانَ فيها","أجلٌ لا ينامُ بالمرصار",13,"ر",1,0],["وعلينا لا زال من سره الفيا","ض ينهل وابل البركات",14,"ت",1,0],["وعلى نسبة المراتب حزب","عن يمين وآخر عن يسار",15,"ر",1,0],["وعلينا والمسلمين فأنا","لسعتنا عقارب الأكدار",15,"ر",1,0],["وعلى نواك فما له من مسعد","وعلى هواك فما له من مسعف",16,"ف",1,0],["وعلينا له الولا حيث أنا","ليس فينا لغيره وزن حبّهْ",17,"ب",2,0],["وَعَلَينا رُقَباءٌ","هَجروا نَومَ العُيُونِ",18,"ن",1,0],["وعلى نظم وقفنا رائق","في جواب لذكي مقول",19,"ل",1,1],["وعليَّ نظمُ قصائدٍ","ينثُرْنَ شمْلَ عداك قَصْدا",20,"د",2,0],["وعلينا من العفاف رقيب","حببت لي من مثله الرقباء",21,"ا",2,0],["وعلى نداك معولي","فيها فقد وقفت حماري",22,"ر",2,0],["وعَلَى نَفْسي أعِنّي وعَلَى","رَفْعِ ظُلْمٍ وابْتِداعٍ عَنْ قَريبِ",23,"ب",1,0],["وَعَلى نِشوَتِكُم أَردافُنا","كَالربابيحِ مِنَ الحَوكِ شَوارُ",24,"ر",1,0],["وعلى نفسك من ين","صح بالحق أَعِنه",25,"ن",2,0],["وعلينا من المهين عين","أوسعتنا تحقُّقاً وعيانا",26,"ن",2,0],["وعلينا من المهيمن عين","من رعته فإنه لا يضام",27,"م",1,0],["وعلينا في محكم الذكر قد نُصّْ","معشر للهدى بهم كلما اقتُصّْ",28,"ص",1,0],["وعلينا تلونت حضرات","بالتجلي جميعها أنوار",29,"ر",1,0],["وعلى نفسه يُنادِي جهاراً","وإِذا كلَّموه مَا يَتَكلَّم",30,"م",1,0],["وعلى نجيبي أن يكون مجَدَّدّا","وعلى وَجيبي أن يكون جِهارَا",31,"ر",2,0],["وعلينا من المهيمن عين","أوسعتنا تحققا وصلاحا",32,"ح",2,0],["وعلينا لسبطه حفظُ عَهد","مُستقلّ مُصحَّح الأسناد",33,"د",1,0],["وعلينا من العفاف رقيب","بقيت في مرامها الأهواءُ",34,"ا",2,0],["وعلينا أن يستهل على الشام","مكان الغيوث مال صبيب",35,"ب",1,0],["وعلى نَحْرِهِ وشاحان مِنْ شَذْ","ر بديعٍ ولؤلؤٍ منظوم",36,"م",1,0],["وَعَليَّ نعمٌ بِالتَودُد أَنعَمَت","لُطفاً وَسَعدي مسعد بِسُعادِ",37,"د",1,0],["وعلى نسلهما من قبل أن","يلداه قيل بارك كي يطيبا",38,"ب",2,0],["وَعَلى نداماك الكِرام","أدر حديث الاطلاع",39,"ع",1,0],["وعلينا الولا لأجلاف تيم","وعلينا البراء من شناها",40,"ا",3,0],["وَعلى نَبِىِّ الخَير دَائِماً","جَدِّد صَلاةً مَع سَلاَمٍ عضدَّ طَى",41,"ا",1,0],["وعلينا قد سن مدح علي","سيد تقصد الوفود رحابه",42,"ب",2,0],["وَعَلَينا لَوافِحٌ مِن هَجيرٍ","وَسِوانا عَلَيهِ تُرخى سُتورُ",43,"ر",1,0],["وَعلى نيةِ ذي القو","لِ مِنَ القَولِ دَليل",44,"ل",1,0],["وعلينا جلا خلاصة تبر","تذر اللب فيه طيش الفراش",45,"ش",1,0],["وعلى نداهُ لامهُ عذاله","لكنهُ عن سمع لوم يجمح",46,"ح",1,0],["وعلينا مدافع نصبوها","في اعالي الأبراج ترمي بملهب",47,"ب",1,0],["وعلينا خرق الذل ولم","نمش إلا الطريق الهاويه",48,"ي",2,0],["وعلى نغمة المياه الجوارى","تحت ظل من نخلها الباسقات",49,"ت",1,0],["وعلينا ألقى الهناء رداء","طرزته أشعة النيرات",50,"ت",1,0],["وعلينا نعماك كن باسطاً","وبشكر الشكور جد يا شكور",51,"ر",1,0],["وَعلَينا نُنمي الجَوابَ وإِن سا","ءَ فإِنَّ الإغرِيقَ ظَلُّوا بِهاجِس",52,"س",1,0],["وعلى نار الصبا قد غرسا","ورد خديه فلا يحترق",53,"ق",1,0],["وعلى نادي هواك اعتكفا","فغدا مأمنه في فرق",54,"ق",1,0],["وعلى نواحيه نواعي النوا","ح من البيوت تساجل الأنهارا",55,"ر",2,0],["وعلى نيلها لِكفيكَ فضلٌ","فهما بالنُّضارِ جاريتانِ",56,"ن",1,0],["وعلينا الآمال حثَّت كؤوساً","فشربنا من الأماني شرابا",57,"ب",2,0],["وعَلَينا بأَن نَمُوتَ وإِلَّا","أَكَلَتْنَا عِظامُنا واللُّحُومُ",58,"م",1,0],["وعلينا عاد عيد سعدهُ","قد نفى أثباته عنا النحوس",59,"س",1,0],["وَعَلى نَواصِي الْخَيلِ فاعْقِدْ خَيرَها","وَاشْدُدْ رِباطاً مِنْ هُدى الْقُرْآنِ",60,"ن",1,0],["وعلينا أنّا نقاسي جروجاً","وعليهن أن يرشن النبالا",61,"ل",2,0],["وعلينا أن لا ننام الليالي","من شجون تراكمت أجبالا",61,"ل",2,0],["وعلى نطنز تلاحقت شذانهم","لا دردر أولئك الشذان",62,"ن",1,0],["وعلى نفس الطريق الى بدينابه وينقاسى","نهاية قصةً شاعرك عايشها وكاتبها",63,"ب",3,0],["وعلى نهجه الرشاد دليل","والمثاني سبعاً له برهان",64,"ن",1,0],["وعلى ناظري غريم وداد","إن تأنى يوما على الدمع حثه",65,"ث",2,0],["وعَلِيٌّ نُوْرُ هَدْيٍ","في ظَلامِ التَّائِهِينا",66,"ن",2,0],["وعلى نغمة المنايا ورجْع ِال","موت تنمو وتستجدّ الحياةُ",67,"ه",1,0],["وعلى نوايايَ المكبّلةِ الظلالِ","أدسُّ أُغنيةً لأسمعَ .. كركرةْ",68,"ر",2,0],["وعلينا نحْسبهم مِنّا","ليكون الموطنُ متّحدا",69,"د",2,0],["وعلى نوارس ركبتيها رَفْرَفَتْ","أشواقُ أيّامي، ومَارَ المَرْمرُ!",70,"ر",1,0]]}