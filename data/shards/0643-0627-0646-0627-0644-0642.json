{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[65,"وروض زرته والأفق يصحي","https://www.aldiwan.net/poem45916.html","الوافر"],[36,"كأن القلب ليلة قيل يغدى","https://www.aldiwan.net/poem4876.html","الوافر"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[10,"ذكرت أخي بعد نوم الخلي","https://www.aldiwan.net/poem21082.html","المتقارب"],[32,"كأن القوم عشوا لحم ضأن","https://www.aldiwan.net/poem29447.html","الوافر"],[39,"كأم البيض تلحفه غدافا","https://www.aldiwan.net/poem7420.html","الوافر"],[40,"تهانفت واستبكاك رسم المنازل","https://www.aldiwan.net/poem7740.html","الطويل"],[87,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[87,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[87,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[64,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[47,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[47,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[51,"كأن الأرض قد طويت عليا","https://www.aldiwan.net/poem63207.html","الوافر"],[107,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[83,"عليل شاقه نفس عليل","https://www.aldiwan.net/poem61498.html","الوافر"],[52,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[52,"تثاقل ليلي فما أبرح","https://www.aldiwan.net/poem63978.html","المتقارب"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[159,"ذرى شجر للطير فيه تشاجر","https://www.aldiwan.net/poem55679.html","الطويل"],[185,"أشاقتك الهوادج والخدور","https://www.aldiwan.net/poem58780.html","الوافر"],[203,"تقاصر عمر الظلام الطويل","https://www.aldiwan.net/poem45365.html","المتقارب"],[211,"ألا من مبلغ غيلان عني","https://www.aldiwan.net/poem27961.html","الوافر"],[258,"ألا أبلغ لديك بني قريم","https://www.aldiwan.net/poem428.html",""],[285,"لنا مجلس ما فيه للهم مدخل","https://www.aldiwan.net/poem60713.html","الطويل"],[411,"لئن سممني الله","https://www.aldiwan.net/poem49696.html","الهزج"],[463,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[466,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[466,"كأن القنا والمشرفية بالضحى","https://www.aldiwan.net/poem15442.html","الطويل"],[469,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[482,"هي العيس دعها بي إلى حاجر تحدى","https://www.aldiwan.net/poem15248.html","الطويل"],[500,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[505,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[520,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[521,"كأن القلب ليلة قبل يغدي","https://www.aldiwan.net/poem48707.html","الوافر"],[743,"","https://poetry.dctabudhabi.ae/diwan/poem/45282","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62533","الوافر"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45183","الوافر"],[1051,"","https://poetry.dctabudhabi.ae/diwan/poem/111542","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72291","الطويل"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119077","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31595","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145102","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21671","المتقارب"],[1581,"","https://poetry.dctabudhabi.ae/diwan/poem/22610","الوافر"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17659","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96479","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11181","الطويل"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115283","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96024","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26167","الكامل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10413","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100854","الكامل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20542","المتقارب"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103951","الوافر"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145137","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102384","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138606",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91246","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69956","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86480","الوافر"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178119","الطويل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106744","البسيط"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131915","الوافر"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143620","الوافر"],[4691,"لطولِ تحرّقي قلبي رمادُ","https://www.poetsgate.com/ViewPoem.aspx?id=156021",""],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[4802,"حبيت وتوهم يدفنوني","https://www.poetsgate.com/ViewPoem.aspx?id=33012",""],[4904,"كانَ الْقِرى لَحْمي","https://www.poetsgate.com/ViewPoem.aspx?id=175727",""],[5004,"بساتيها للمسك فيها روائح","https://www.poetsgate.com/ViewPoem.aspx?id=181492",""],[4119,"لك الله إن حاربت فالنصر والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=16107",""],[4119,"أيا عاذلي في الحب مالي وللعذل","https://www.poetsgate.com/ViewPoem.aspx?id=16210",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5376,"أما في الدارِ أشواقٌ وشمسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=188450",""],[5376,"تئن على فراق الأهل درعا","https://www.poetsgate.com/ViewPoem.aspx?id=189706",""],[5431,"كأنّ القلبَ في ولهٍ كنودُ","https://www.poetsgate.com/ViewPoem.aspx?id=190336",""],[5431,"أخي الأزلي شاعر اليمن عبد الإله الشميري","https://www.poetsgate.com/ViewPoem.aspx?id=191123",""],[5736,"امتثال","https://www.poetsgate.com/ViewPoem.aspx?id=213791",""],[5956,"كل الأحبةِ ماتوا","https://www.poetsgate.com/ViewPoem.aspx?id=192338",""],[5956,"حول أحمد وسعاد","https://www.poetsgate.com/ViewPoem.aspx?id=193720",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""],[5956,"صححتُ في حلمي ثلاث قصائد","https://www.poetsgate.com/ViewPoem.aspx?id=201551",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[5994,"كلام في الظل","https://www.poetsgate.com/ViewPoem.aspx?id=184662",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[520,"هل القلب الا بضعة يتقلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577441",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""]],"verses":[["كَأَنَّ القَطامِيّاتِ فَوقَ رِحالِهِم","سِوى أَنَّها تَأبى دَنِيَّ المَطاعِمِ",0,"م",1,0],["كَأَنَّ القَطْرَ مِنْ سَبَلِ الغَوادي","عَلى زَهَراتِهِ الدُّرُّ النَّظيمُ",1,"م",1,0],["كَأَنَّ القَلبَ لَيلَةَ قيلَ يَغدى","بِلَيلى العامِرِيَةِ أَو يُراحُ",2,"ح",1,1],["كَأَنَّ القِيانَ الغُرَّ وَسطَ بُيوتِهِم","نِعاجٌ بِجَوٍّ مِن رُماحٍ خَلا لَها",3,"ل",3,0],["كَأَنَّ القَماريّ الهَواتِفَ بِالضُّحى","إِذا أَظهَرَت قيناتُ شربٍ صَوادِحُ",4,"ح",1,0],["كَأَنَّ القُتودَ إِذا شَدَّها","عَلى ذي وُسومٍ تُباري صِوارا",5,"ر",2,0],["كَأَنَّ القَومَ عُشّوا لَحمَ ضَأنٍ","فَهُم نَعِجونَ قَد مالَت طِلاهُم",6,"م",1,1],["كأن القيض رعَّثه بودع","من التوشيح أو قطع الوذيل",7,"ل",1,0],["كَأَنَّ القِطارَ حَرَّكَت في مَبيتِهِ","جَدِيَّةَ مِسكٍ في مُعَرَّسِ قافِلِ",8,"ل",1,0],["كَأَنَّ القُطرَ مِن شَوقٍ إِلَيها","سَما قَبلَ الأَساسِ بِها عِمادا",9,"د",2,0],["كَأَنَّ القُطرَ حينَ يُجيبُ قُطراً","ضَمائِرُ بَينَها مُتَناجِياتُ",10,"ت",1,0],["كَأَنَّ القَلبَ بَعدَهُمُ غَريبٌ","إِذا عادَتهُ ذِكرى الأَهلِ ذابا",11,"ب",2,0],["كَأَنَّ القَنا دونَ الخِيامِ نَوازِلاً","جَداوِلُ يُجريها الظَلامُ وَيُسكَبُ",12,"ب",1,0],["كَأَنَّ القِسِيَّ العاصِياتِ تُطيعُهُ","هَوىً أَو بِها في غَيرِ أُنمُلِهِ زُهدُ",13,"د",1,0],["كأن القَطارَ استخزنتها لآلِئاً","فمن جامدٍ في صفحتيها وذائبِ",14,"ب",1,0],["كَأَنَّ القُصورَ البيضَ في جَنَباتِهِ","خَضَبنَ مَشيباً نازِلاً بِسَوادِ",15,"د",1,0],["كَأَنَّ القِبابُ البيضَ وَالشَمسُ طَلقَةٌ","تُضاحِكُها أَنصافُ بَيضٍ مُفَلَّقِ",16,"ق",1,0],["كَأَنَّ القَومَ قَد دَفَنوا وَوَلَّوا","وَكُلٌّ غَيرُ مُلتَفِتٍ إِلَيّا",17,"ي",2,0],["كأنّ القومَ حين جَرَى عليهم","قضاءُ اللهِ عادٌ أو ثَمودُ",18,"د",1,0],["كَأَنَّ القَلبَ وَالسُلوانَ ذِهنٌ","يَحومُ عَلَيهِ مَعنىً مُستَحيلُ",19,"ل",1,0],["كَأَنَّ القَلبَ مِن حُبِّ","كِ مَوضوعٌ عَلى جَمرَه",20,"ر",2,0],["كَأَنَّ القُرونَ عَلى مَتنِها","أَساوِدُ شَتَّ بِها أَبطَحُ",21,"ح",1,0],["كَأَنَّ القَولَ مِن فيكِ","لَنا دُرٌّ وَياقوتُ",22,"ت",1,0],["كَأَنَّ القُرُنفُلَ والزَنجَبِيلَ","يُعَلُّ عَلى رِيقِها الأَطيَبِ",23,"ب",1,0],["كَأَنَّ القُصُورَ الحَافِلاَتِ بِحَشْدِهِمْ","رُسُومٌ خَلَتْ مِنْ نَابِتٍ وَطُلُولُ",24,"ل",1,0],["كأَنَّ القَمارِي والبَلابِلَ بَيْنَنَا","قِيانٌ وأَوراقُ الغُصُونِ سَتائِرُ",25,"ر",1,0],["كأَنَّ القَلبَ عِندَ دِيارِ سَلمَى","سَلِيمٌ أو رَهِينُ دَمٍ أسِيرُ",26,"ر",1,0],["كأنَّ القلوبَ أضلَّتْ قلوباً","فكانتْ لحاظُ العيونِ الدليلْ",27,"ل",1,0],["كَأَنَّ القَومَ إِذ جاءوا إِلَينا","مِنَ البَغضاءِ بَعدَ السِلمِ عورُ",28,"ر",1,0],["كَأَنَّ القَومَ مِن نَبلِ اِبنِ رُمحٍ","إِذا القَمراءُ تَلفَحُهُم سَعيرُ",29,"ر",1,0],["كَأَنَّ الْقَنانِي والصّوانِي لِناظِرٍ","نُجُومُ سَماءٍ سائِراتٌ وَأَبْرُجُ",30,"ج",1,0],["كأنَّ القَصدَ مِنْ أحداثِ","أزمانِيَ إزماني",31,"ن",2,0],["كان القريضُ مميَّلا","فعدلنه وأقمنَ صَغْوَهْ",32,"و",2,0],["كأنَّ القَنا ونحورَ الرجالِ","بِئارُ الحجيج وأشْطانُها",33,"ن",3,0],["كأنَّ القُروم الهادراتِ عشيَّةً","مراجلُنا في أزمْةٍ وشِتاءِ",34,"ا",2,0],["كأنَّ القَنا والمَشْرفيَّةَ بالضُّحى","لدى مأزقٍ غابت بصبحٍ كواكبهْ",35,"ب",2,1],["كأنَّ القنا أغضانُ بانٍ وبيضهم","جداول والزغف المضاعف غدران",36,"ن",1,0],["كأنَّ القدودَ الهيفَ وهي موائسٌ","أعرنَ التثنَي ذلك البانَ والرَّندا",37,"د",2,0],["كأن القُرى سكْرى ولا سكر بالقرى","كأن الربا ثكلى وما بالربا ثكل",38,"ل",1,0],["كأنَّ القَضايا من غَرامي عَقيمَةٌ","نتيجَتُها ذُلِّي وأِيهانُ أَحْوالي",39,"ل",2,0],["كأن القوافي حين تسعى لشكرهم","على الجمر تمشي أو على الشوك تسحب",40,"ب",1,0],["كَأَن القَلبَ لَيلَة قَبل يُغدي","بِلَيلى العامِرِيَّه أَو يُراح",41,"ح",1,1],["كَأَنَّ القُرُنفُلَ وَالزَنجَبيل","وَريحِ الخُزامي وَذوَُ العَسَلْ",42,"ل",1,0],["كأنَّ القضا المحتوم أفواه صُمْعهِم","فما ضربت إلا وحان قضاها",43,"ا",3,0],["كأنَّ القلعة الشهباء لمَّا","أحيط بها وشاح ضمَّ خصرا",44,"ر",2,0],["كَأَنَّ القَومَ لَمَّا عايَنوهُ","خِلالَ النَقعِ لَيسَ لَهُم قُلوبُ",45,"ب",1,0],["كان القناديل المدارة حولها","جفون رثت منهن أعن نرجس",46,"س",1,0],["كأن القنا فيها أنامل حاسبٍ","أجد بها في السرعة الجمع واللقط",47,"ط",1,0],["كأن القماري والبلابل حولها","قيان وأوراق الغصون ستائر",48,"ر",1,0],["كَأَنَّ القَنا تَلْقاهُ مِنْ أُنْسِهِ بِها","بِتُفّاحَتَيْ خَدٍّ ورُمّانَتَيْ صَدْرِ",49,"ر",1,0],["كان القياض لها في صفقة عقدت","من ساسة الشر تعريبًا بتهويد",50,"د",1,0],["كَأَنَّ القَلائِدَ في جيدِها","إِلى حَيثُ تَعقِدُ مِنها الرِعاثا",51,"ث",2,0],["كَأَنَّ القَومَ تَنَطَّقواهُم","ذُرى قَشعانَ أَو حَيدى وَعيرِ",52,"ر",1,0],["كأنّ القطوعَ والأَشِلَّةَ عُلَّقَت","على آبِدَينِ لاحقٍ إِطِلاهُما",53,"م",2,0],["كأن القنا الخطي فينا وفيه