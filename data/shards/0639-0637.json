w.poetsgate.com/ViewPoem.aspx?id=179163",""],[45,"وَصْلٌ تُقَارِبُ مِنْهُ ثُمّ تُبَاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31620",""],[47,"عَطَفتُ على عَمرِو بنِ تغلِبَ بَعدَما","https://www.poetsgate.com/ViewPoem.aspx?id=14764",""],[28,"ألستم عائجين بنا لعنا","https://www.poetsgate.com/ViewPoem.aspx?id=20017",""],[85,"يموت في الغابِ أو في غيرِه الأسدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9599&r=&rc=89",""]],"verses":[["عَطِّلِ الكَأسَ لا تُحِس","سَ النَديمَ المُعاطِيا",0,"ي",2,0],["عَطَفَ الدَهرُ فَرعَهُم فَرآهُ","بَعدَ بُعدِ الذَرى قَريبَ المَجاني",1,"ن",2,0],["عُطِّلَت مِنهُمُ المَقاري وَباخَت","في حِماهُم مَواقِدُ النيرانِ",1,"ن",1,0],["عَطَونَ بِأَعناقِ الظِباءِ وَأَشرَقَت","وُجوهٌ عَلَيها نَضرَةٌ وَنَعيمُ",2,"م",1,1],["عَطفاً عَلَينا أَن يَقولَ اِمرُؤٌ","إِنَّ عَلوقَ المَجدِ لَم تَرأَمِ",3,"م",1,0],["عَطِرونَ ما لِأُنوفِكُم مِن طيبِهِم","بَينَ المَجامِعِ غَيرَ شَمِّ المَرغَمِ",4,"م",1,0],["عَطفاً أَميرَ المُؤمِنينَ فَإِنَّنا","في دَوحَةِ العَلياءِ لا نَتَفَرَّقِ",5,"ق",1,0],["عَطَفنا إِلَيها بِالعَوالي أَسِنَّةً","شُروعاً كَأَذنابِ العِظاءِ الدَوالِفِ",6,"ف",1,0],["عَطَلَت رُباهُ مِنَ الصَفا","ءِ وَعُرِّيَت أَنقاضُهُ",7,"ض",2,0],["عَطَّلَ الدَهرُ مِن حِلاهُنَّ فينا","وَتَحَلّى الثَرى بِهِنَّ وَأَثرى",8,"ر",2,0],["عَطَفتُ لَهُ صَدرَ الأَصَمِّ وَتَحتَهُ","عَواطِفُ أَسبابِ الحُقودِ النَوافِرِ",9,"ر",1,0],["عَطِرَتْ بهِ الأرضُ الفَضاءُ كأنَّما","نُشِرَتْ علَيها الرَّوضَةُ الغنَّاءُ",10,"ا",2,0],["عَطَفَتْ رَكائِبُنا إِلى عَرَصاتِهِ","وعلى الجُنَينَةِ نَهْجُهُنَّ المُعْلَمُ",11,"م",1,0],["عَطشانُ أَدلى دَلوَهُ","خَوفَ المَنِيَّةِ في دِلاها",12,"ا",3,0],["عَطَفَ الأَحِبَّةُ كُلُّهُم وَكَأَنَّما","قَد وُكِّلَت بِتَعَلُّمِ الهِجرانِ",13,"ن",1,0],["عَطَفنا إِلى مَنزِلٍ حاضِرٍ","كَثيرِ اللَذاذَةِ مُستَبشِرينا",14,"ن",2,0],["عَطَفتُ عَلى أَسرارِكُم فَكَسَوتُها","قَميصاً مِن الكِتمانِ لا يَتَخَرَّقُ",15,"ق",1,0],["عَطَفتُ عَليهِ مَرَّةً فَتَرَكتُهُ","لِما كانَ يَرضى قَبلَها وَهوَ حاقِرُ",16,"ر",1,0],["عَطاءَ الإِلَهِ فَإِنَّ الإِلَ","هَ يَسمَعُ في الغامِضاتِ السِرارا",17,"ر",2,0],["عَطَّلتَ فَنَّ الشِعرِ بَعدَكَ وَاِنطَوى","أَجَلُ القَريضِ وَمَوسِمُ الشُعَراءِ",18,"ا",2,0],["عَطَّلتَ فَنَّ الكَهرَباءِ فَلَم نَجِد","شَيئاً يَعوقُ مَسيرَها إِلّاكا",19,"ك",2,1],["عَطاؤُهُ وَطَعنُهُ","ما غَيرُ دَقّ بِالحَنَك",20,"ك",1,0],["عَطفاً عَلَينا يا عَزيزُ فَإِنَّنا","بَعدَ المُعَظَّمِ عِندَكُم أَيتامُ",21,"م",1,1],["عَطايا يُصيبُ الحاسِدونَ بِحَمدِهِ","عَلَيها وَلَم يُحبَوا بِها فَيُحابوا",22,"ب",3,0],["عَطاءٌ وَلا مَنٌّ وَحُكمٌ وَلا هَوىً","وَحِلمٌ وَلا عَجزٌ وَعِزٌّ وَلا كِبرُ",23,"ر",1,0],["عَطِرٌ هُوَ المِسكُ السَطوعُ يَطيبُ في","شَمِّ العُقولِ أَريجُهُ المُتَنَسَّمُ",24,"م",1,0],["عَطاؤُهُ جَزلٌ وَصَولاتُهُ","صَولاتُ قَرمٍ لِقُرومٍ صَؤول",25,"ل",1,0],["عَطّافُهُ أَبيَضُ ذو رَونَقٍ","كَالرَجعِ في المُدجِنَةِ السارِيَه",26,"ي",2,0],["عَطِلَتْ حُلًى غَرَّاءُ من أخْلاَقِهِ","كَانَتْ بِهِ تُزْهَى عَلَى التِّيجَانِ",27,"ن",1,0],["عَطْفَ العُقَابِ عَلَى أَفْرَاخِهَا فَإِذَا","تَوَثَبُوا قَلِقَتْ مِنْ رَوْعِهَا الأكَمُ",28,"م",1,0],["عَطاياكَ تَغدو عَلى سابِحٍ","وَطَوراً عَلى بَغلَةٍ نَدبَه",29,"ب",2,0],["عَطاءُ فَتىً بَنى وَبَنى أَبوهُ","فَأَعرَضَ في المَكارِمِ وَاِستَطالا",30,"ل",2,0],["عَطابيلُ بيضٌ مِن ذُؤابَةِ عامِرٍ","رِقاقُ الثَنايا مُشرِفاتُ الحَقائِبِ",31,"ب",1,0],["عطيّة الرب السميع","رحم بها هذا الوطن",32,"ن",1,0],["عطفت على الأيام عطفة راحمٍ","وألبستها ثوب امتنانك ضافيا",33,"ي",2,0],["عطر الريح قد تشمّمت منه","إذ تشمّمته شذا اقحوانه",34,"ن",2,0],["عطا الخطيب الذي آل الخطيب به","فتّت مصيبتهم أكبادنا أسفا",35,"ف",2,0],["عَطِرِ الثِيابِ مِنَ العَبيرِ مُذَيَّلٍ","يَمشي الهُوَينا مِشيَةَ السَكرانِ",36,"ن",1,0],["عَطاءَ الَّذي أَعطى الخَليفَةَ مُلكَهُ","وَيَكفيهِ تَزفارُ النُفوسِ الحَواسِدِ",37,"د",1,0],["عَطَفتُ عَلَيكُم وُدَّ قَيسٍ فَلَم يَكُن","لَهُم بَدَلٌ أَقيانُ لَيلى وَكيرُها",38,"ر",3,0],["عَطاءُ اللَهِ تَكرِمَةً وَفَضلاً","بِسُخطِكَ لَيسَ ذَلِكَ عَن رِضاكا",39,"ك",2,0],["عَطاءُ اللَهِ مَلَّكَكَ النَصارى","وَمَن صَلّى لِقِبلَتِهِ وَصاما",40,"م",2,0],["عَطَفَت تُيوسُ بَني طُهَيَّةَ بَعدَما","رُوِيَت وَما نَهِلَت لِقاحُ الأَعلَمِ",41,"م",1,0],["عطسة العائف الذي بمناه","حسب الفأل فألها المزجورا",42,"ر",2,0],["عَطِفتُ عَلى عَمرِ اِبنِ تَغلِبَ بَعدَما","تَعَرَّضَ مِنّي جانِبٌ لَهُمُ صَلدُ",43,"د",1,1],["عَطوفٌ عَلَيهِم لا يُثَنّي جَناحَهُ","إِلى كَنَفٍ يَحنو عَلَيهِم وَيَمهَدُ",44,"د",1,0],["عطفت كأمثالِ القسيّ حواجباً","فرَمت غداةَ البين قلباً واجِبا",45,"ب",2,1],["عطارد دُهمِي المشتري غير خاسرٍ","إذا بيع حمدٌ في الورَى وثواب",46,"ب",1,0],["عطفت عليّ في زمنٍ حرُونٍ","وجدْتَ برغم أيامٍ شحاح",47,"ح",1,0],["عطارد الوقت أنت صاحبه","فقلت بالله صاحب القمر",48,"ر",1,0],["عطفاً أحال الدين والدنيا على","حالي فعندك يحسن اسْتعطافي",49,"ف",2,0],["عطفت على حالي بنظرة سائرٍ","وقد مدَّ فيها الدهر راحة هاتك",50,"ك",1,0],["عطفاً على ميتٍ من الفقر قد","أصبح في حالة مرحوم",51,"م",1,0],["عطَّلتَ هذا وهذا إذ رحلت وقد","خاب الرجاء فلا بانٌ ولا علم",52,"م",1,0],["عَطر اللّمى واللّفظ وأشواقي إلى","فمِي شادنٍ في الحالتين مفوَّه",53,"ه",1,0],["عطية منه تبغي","فقلتُ ألف عطيَّه",54,"ه",1,0],["عُطَارِدُهُ ما أخْبَتِ الحربُ نَارَها","ومِرِّيخُهُ ما دَامَتِ الحربُ تَوقدُ",55,"د",1,0],["عَطيَّةُ اللّه لا يَبْتَزُّهَا أحَدٌ","ليستْ كشيء مُعادٍ ثمَّ مَردُودِ",56,"د",1,0],["عطايا بين بشر واعتذارٍ","وليست بين إذلالٍ وعبس",57,"س",1,0],["عطايا تزورُ المستنيلَ ولو غدا","سرنديبُ أدنى داره وشلاهِط",58,"ط",1,0],["عطستْ وحُقّ لها العُطاسُ لأنها","مزكومةٌ أبداً تسيلُ مُخاطا",59,"ط",2,0],["عَطَّلتِ الأرباب لا قُدّستْ","وما ترى للأير تعطيلا",60,"ل",2,0],["عطايا تُعتفى منها العطايا","وعقلٌ تُسْتَقى منه العقولُ",61,"ل",1,0],["عطفاً عليَّ أبا الحسين فإنَّني","من أوليائك في الزمانِ الأقْدمِ",62,"م",1,0],["عُطاردٌ الحُلُوُ الظريفُ مسالماً","وبهرامٌ الشريرُ غيرَ مُسالمِ",63,"م",1,0],["عطفاً بني وهبٍ علَيْ","يَ فأنتُمُ في الفضل أنْتُمْ",64,"م",1,1],["عطفاً عليَّ أبا الحسي","نِ فإنَّ شافِعِيَ التحرُّمْ",64,"م",1,0],["عَطَفَ اللَّيْلُ هَيْدَبَيْهِ عليه","وتداعتْ سماؤُهُ بانهدام",65,"م",1,0],["عطايا لا يجمجمها كفور","ولا للشاكرين بها يدان",66,"ن",1,0],["عطايا بين بِشْرٍ واعتذارٍ","وليست بين عبس وامتنان",66,"ن",1,0],["عطفناك فا