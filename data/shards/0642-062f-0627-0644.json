[5273,"بيتان يوسفيان","https://www.poetsgate.com/ViewPoem.aspx?id=181586",""],[5277,"ساهر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=186510",""],[5277,"شمعةٌ في مهبّ الريحِ","https://www.poetsgate.com/ViewPoem.aspx?id=197557",""],[1021,"كم شب في القلب نارا","https://www.poetsgate.com/ViewPoem.aspx?id=47802",""],[5365,"مالم تقلهُ زرقاءُ اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=190408",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5431,"ليته كان شفّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=203703",""],[5512,"البدر أمسى هلالاً","https://www.poetsgate.com/ViewPoem.aspx?id=204347",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[402,"بلغت أعلى منصب توثيقا","https://www.poetsgate.com/ViewPoem.aspx?id=36002",""],[5848,"أنشودة التنهيد","https://www.poetsgate.com/ViewPoem.aspx?id=53209",""],[5864,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=190337",""],[5956,"حفيداي الطفلان أحمد وعابد","https://www.poetsgate.com/ViewPoem.aspx?id=206260",""],[5973,"أنين الروح","https://www.poetsgate.com/ViewPoem.aspx?id=13209",""],[6035,"رَغِبْتُ بفضحِكمْ في بعضِ شِعْرٍ !","https://www.poetsgate.com/ViewPoem.aspx?id=177506",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[6094,"من عاذلي من ذا الزمان السفيه","https://www.poetsgate.com/ViewPoem.aspx?id=186817",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[6142,"أمريضا بالسير بنت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=155735",""],[242,"هل لذي البعد من تدان يدوم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563711",""],[6352,"قم ناشد الأسلام عن مصابه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22753&r=&rc=14",""]],"verses":[["قَد أُلِّفَت أَشتاتُهُم في واحِدٍ","إِلّا يَكُنهُم أُمَّةً فَيَكادُ",0,"د",1,0],["قَدْ آلَ سامٍ إِلى النُّعمَى وَأَحسبُهُ","يشْكُو القَرارَ بِلاَ كَدٍّ وَلاَ شُغُلِ",1,"ل",1,0],["قَد آلَ مِنهُ وَأَبدى مِن جَناجِنِهِ","طولُ النَهارِ وَلَيلٌ دائِبٌ سَهِرُ",2,"ر",1,0],["قَد أُلبِسَ التاجَ المُعاوِدَ لُبسَهُ","في الحالَتَينِ مُمَلَّكاً وَمُؤَمَّرا",3,"ر",2,0],["قَد أَلقَتِ الغَرَبُ الآمالَ راغِبَةً","إِلَيكَ مِن مُجتَدٍ جَدوى وَمِن جانِ",4,"ن",1,0],["قَد أَلبَسَ اللَهُ عَبدَ اللَهِ أُبَّهَةً","مِن سَعيِ داوُدَ زادَت في مَساعيهِ",5,"ي",2,0],["قُدِ العَزمَ وَاِبقَ يا أَبا الفَتحِ سالِماً","فَقَد خَفَضَ الدَهرُ الجَناحَ لِتَرتَقي",6,"ق",2,0],["قَدْ أَلِفَتْ صُحْبَةَ الْقَنَا يَدُهُ","وَاعْتَادَ لَبَّيْكَ فِي السَّمَاحِ فَمُهْ",7,"م",2,0],["قد ألقتِ النارَ وجنتاهُ","فينا وقدْ صاحتِ الحريقا",8,"ق",2,1],["قَد أُلهِبَت فَتَذَهَّبَت فَكَأَنَّها","لِسُكونِ شَرِّ شِرارِها لَم تَلهَبِ",9,"ب",1,0],["قُدِ الأبطالَ للهيجاءِ وَاصْبِرْ","فَنِعمَ الصّبرُ فيها والثّباتُ",10,"ت",1,0],["قَدَّ التِهامِيَّ بِإِزميلِهِ","عَن قُدرَةٍ مَقروظَ آدامِها",11,"م",3,0],["قَد أَلبَسُ العَيشَ ذا الرِقاعِ وَلا","أَلبَسُ ثَوبَ الإِخاءِ مُنخَرِقا",12,"ق",2,1],["قد أُلبسَ البغضةَ هذا وذا","لا يَصْلُحُ الغِمدُ لسيْفينِ",13,"ن",1,0],["قد آلموني بالقَذي","فة وَالشتوم وأكثروا",14,"ر",3,0],["قَدُّ الوَلِيدَةِ في صَلْفَاءَ رَابِيَةٍ","حَوْلَ الوَسَائِدِ مِنْ بَيْضَاءَ مِعْطَارِ",15,"ر",1,0],["قد ألقيا اليه بالمقالد","وخرجا من طارف وتالد",16,"د",1,0],["قَدِ الْتَقَيْنَا مِنْ غَيْرِ سَابِقَةٍ","فِي دَار دُنْيَا بِأَهْلِهَا غَدِرَهْ",17,"ر",2,0],["قَدْ أَلَّهَتْ آمِنْحَتِيبَ وَإِنَّمَا","هِيَ مَجَّدَتْ فِي الْخَالِقِ المَخْلُوقَا",18,"ق",2,0],["قد ألفنا الردى كما تألف الغا","بات عصف الخريف بالأدواح",19,"ح",1,0],["قَدْ أَلْبَسَ اللهُ عَبْدَاللهِ أُبَّهَةً","مِنْ يَقظَانَ يَدْرِي كَيْفَ يُحْيِيهِ",20,"ي",2,0],["قد ألبس التقريبَ ثوبَ طلاوة","فبدا وشكلُ الحسن فيه أنيقُ",21,"ق",1,0],["قد ألفت الصبا وإن لحظتني","فيه من عاذلي لواحظ شوس",22,"س",1,0],["قد أَلِفَ الحىُّ من مسراكِ طارقةً","تبيتُ أحراسُهم منها على وجلِ",23,"ل",1,0],["قد ألجأ العاصي إِلى متابه","ولم يقل مستعجلا متى به",24,"ب",2,0],["قَدِ اِلتَصَقت فَخذاه والساقُ واحدٌ","وَمدَّ يديهِ باليمينِ وَباليُسرى",25,"ر",2,0],["قَد أَلَّفَت عُصَبُ اللُصو","صِ محاكِماً في كلِّ قِسمِ",26,"م",1,1],["قدُّ القضيب وطلعةُ ال","بدر المنير وعينُ ريم",27,"م",1,0],["قَد أَلزَموهُ كُلَفاً","وَأَينَ مِنهُ الكُلَفُ",28,"ف",1,0],["قَد أَلِفَ القُفصَةَ وَه","وَ حَولَها يُرَفرِفُ",28,"ف",1,0],["قَدْ أَلِفْتُ النَّوَى وَإِنْ عِشْتُ شَيْئاً","فَسَأَصْبُو إِلَى النَّوَى وَأَهِيمُ",29,"م",1,0],["قد ألْقَحَ الحَرْبَ العَوانَ فلم يدَعْ","حَيّاً بأجْوازِ الفَلاة لَقاحا",30,"ح",2,0],["قد أُلبِسَ الملكُ بهِ","أَنفَسَ تاجٍ جَوهَرا",31,"ر",2,0],["قد ألهموا الرشد بالتوفيق فانتظموا","في سلك من قربوا قرب اجتبا وقرا",32,"ر",2,0],["قد ألفنا ربوعه ومغانيَهُ الزواهي","أحبب بها من مغاني",33,"ن",2,0],["قد ألغزت لي في مسمى واحدٍ","وله مقاديرٌ تفاوت طولها",34,"ل",3,0],["قَد أَلبَسَ الإِيمانَ ظُلماً ظاهِراً","بِقَطعِ ما بِوَصلِهِ اللَهُ أَمَر",35,"ر",1,0],["قَد أَلَّف السحر في عَينيهِ سُقمُهُما","وَالفَتك وَالغَنج وَالتَفتير وَالحورا",36,"ر",2,0],["قَد أَلَفتُ الاِذلال مُذ حُلتَ عَنّي","فَتَعَطَّف عَلَيَّ بِالاِعزاز",37,"ز",1,0],["قدَّ الهوى قلبي لهُ مثلَ ما","قدَّ عليَّ في الوَغى مِرْحبا",38,"ب",2,0],["قدَّ الحوادث غاربٌ من حدِّه","فكأَنَّه في الخطب حدُّ حسام",39,"م",1,0],["قُدَّ النصيف اجبتها قد رقّ لي","فانقدّ مثل فؤادي المقدودِ",40,"د",1,0],["قُدِ الخيلَ والخيرَ بأْساً وجُودا","وصِلْ أَبَدَ الدهرِ عِيداً فَعِيدَا",41,"د",2,1],["قد ألقوا الرق طويلا ومن","يألف شيئا عكسه ببغض",42,"ض",1,0],["قد الهتمني شعر داود بها","رعبوبة من آل اسرائيلا",43,"ل",2,0],["قدّ السُّرى قدَّ النسو","عِ بُدْنَها والخُطْمِ",44,"م",1,0],["قَد أَلبَسَت مِنَ الرُقاقِ الناعِمِ","غَلائِلاً لَذيذَةَ المَطاعِمِ",45,"م",1,0],["قد ألف الحب بين المهجتين فلا","تثريب عني ووجه الحسن فتان",46,"ن",1,0],["قد أَلبسَ الحالُ منَّا كلَّ مُنَتَمِطٍ","حالاً وأَكسَبَ أهلَ الوجدِ إحْراقَا",47,"ق",2,0],["قَدْ ألِفتُ الأقاحَ إذْ نالَ منكُمْ","شَبهاً والخُدودُ فيها أقاحُ",48,"ح",1,0],["قد ألْبسَ الدُنيا ثِيابَ مفاخرٍ","ستَرَ الزّمانُ بها على عَوْراتِهِ",49,"ت",2,0],["قَدْ أَلْزَمُونا أَنْ نَدينَ بِكُفْرِهِمْ","ويَكُونُ شَرَّ الخَلْقِ مَنْ يَرْضَى بِهِ",50,"ب",2,0],["قَد أَلِفنَا ثَدىَ الفُنُونِ رَضاعاً","فارحَمي فَاطِم وَلا تَفطِمِينَا",51,"ن",2,0],["قد ألهَمَتها أمُّهَا فُجورُها","وهو وريثُ فاجرٍ في الآخِرَه",52,"ر",2,0],["قد ألبسوهُ الثِّيابَ البيضَ فاصطَبَغت","بحمرةٍ من دمِ الدَّمعِ الذي انهملا",53,"ل",2,0],["قدِ التَقَى الدِّينُ والدُّنيا بساحَتِها","كما الْتَقَى الكُحْلُ في الأجفانِ والكَحَلُ",54,"ل",1,0],["قد ألف الشيخ في التوحيد مختصراً","يكفي أخا اللب إيضاحاً وتبيانا",55,"ن",2,0],["قد آلمتك مصيبتي فعددتها","خطبا تسح له الجفون مخيفا",56,"ف",2,0],["قد أُلفت من زوجة مع ستة","من بعد ما بالموت راح اثنان",57,"ن",1,0],["قَد ألبستهُ العلياءُ بردَ علا","مطهّراً سالماً من الدرنِ",58,"ن",1,1],["قد ألَّهوا الاصنام فيهِ فراقهُ","التأليهُ حتى خانهُ الاحساس",59,"س",1,0],["قد ألَّهوهُ نعم فصار مسوَّداً","من بعدِ ماطفحت بدلٍ كاسُ",59,"س",1,0],["قد ألفتَ الإسراف في الجود حتى","خلتَ من كان مُسرفاً غيرَ مُسرف",60,"ف",1,0],["قَد أَلحَقَتني مِنّة في نِسبَةٍ","تَعلو عَلى الأَنسابِ مِثلَ الفَرقَدِ",61,"د",1,0],["قَد أُلبِسَ الوَقار وَالسَكينه","وَحَلّ في مَكانةٍ مَكينه",62,"ه",1,0],["قَدِ اِلتَظت مُهجَته مِن حَسَده","يا حرّ ما جرّ بِهِ لِكبدِه",63,"ه",1,0],["قد ألِفَ الخيرُ عُماناً فأغْ","ناها وروَّاها السحابُ الثقُّالْ",64,"ل",1,1],["قد ألبَس الكونَ فضلاً والورى كرماً","والأرضَ عدلاً فحيّتها السماواتُ",65,"ت",1,0],["قد ألفت الإحسان منك فتمّم","وتلاف أمري قبيل تلاقي",66,"ي",1,0],["قد ألف السائلون من يده ال","جود وألفوا في عوده ثمرا",67,"ر",2,0],["قد ألف البذل منك كف","به رأيناك الف حاتم",68,"م",1,0],["قد ألحق الدهر بالماضي حلاوتها","كأنها في حواشي العمر غلطات",69,"ت",1,0],["قَدِ اِلتَوى صَدغُهُ وَاِختَطَّ عارِضُهُ","كَأَنَّهُ أَلِفٌ مِن فَوقِهِ نونُ",70,"ن",1,1],["قدّ الصخور وهدّ الشامخات له","ومهّد الأرض أعلاها وأوطاها",71,"ا",3,0],["قد البسا حلل الفخار وهاهما","اخوا حجى وسواهما لسواها",72,"ا",3,0],["قد الحسام فإن يجز","ه صار يصلح للحسام",73,"م",1,0],["قد ألفناك ياعظيم خديما","لرحاب الهدى بكل تفان",74,"ن",1,0],["قد أَلفَ الهيجاءَ حتَّى ليلها","أغرابه يأنس في عُقابه",75,"ب",2,0],["قَد أَلحقتهم بالثريا رفعة","لَيسَ المعاد كَما تَرون إِلى الثرى",76,"ر",2,0],["قدَّ الدجى قدَّ الرباب فضرَّجت","آس الخضاب بحمرة الجريال",77,"ل",1,0],["قد ألبست كل البلاد يمينه","حلل الأمان وقد نضت عنها الخطر",78,"ر",1,0],["قد العزم واستنقذ ترائك من عدى","تباغت عليكم بالتمادي على الغصب",79,"ب",1,0],["قدَّ القلوبَ بسيف دَل","ل ينهب المهجات قدَّا",80,"د",2,0],["قد البس الجسم من نسج الضنا حللا","وجرع النفس من كأس الردى جرعا",81,"ع",2,0],["قد ألحف الغيم بانسكابه","والتحف الجوّ في سحابه",82,"ب",2,1],["قد أَلف السهاد دمعي بعدهم","والوجد قلبي والسقام جسدي",83,"د",2,0],["قد ألبسته من الترابِ لغيرة","قامت بها حباً له جلبابا",84,"ب",2,0],["قد التزمتُ هوى هذا الغزال كما","جعلت مدحي لمحيي الدين ملتزما",85,"م",2,0],["قد أَلانت قدرة اللَه لهُ","بمساعي قصده الدهرَ العنيدا",86,"د",2,0],["قد ألبسُ الليلَ حتَّى ينثني خَلَقاً","وأركبُ الهولَ بالغرِّ الغرانيقِ",87,"ق",1,1],["قَد أَلِفَ القَلبُ خِلافَ الَّذي","كرومَهُ مِن سَلوَةِ القَلبِ",88,"ب",1,1],["قد ألحدوك وما دروا ان ألحدوا","كل الفضائل والتقى والجودا",89,"د",2,0],["قَد أَلِفَت عَيني سَواد الدُجى","آنِسَةً بلونه الأَسفَع",90,"ع",1,0],["قد آل إلا موردا ثمدا","وغدا يرود المورد السبخا",91,"خ",2,0],["قد ألوعت برخائه ولطالما","قد أولعت بمديحه الشعراء",92,"ا",2,0],["قد التجأ الزهر لي في الخطرْ","لأني أرقُّ جميع البشر",93,"ر",1,1],["قد ألهّوا الغيد عباداً لشهوتهم","وشهوة العبد قيد غير منفصم",94,"م",1,0],["قد ألفت الصراع للقيد إرْثي","من محيطي ومن اأي وجدودي",95,"د",2,0],["قد ألجموا القمل أن ترزأ دماءهم","وألجموا في الكوى الجرذان والفارا",96,"ر",2,0],["قد الجنود إلى الميدان مغتبطا","وكن على مصر في باسائها حدبا",97,"ب",2,0],["قد الهبت خمر الصبا خدّه","فاتقدت في مهجتي منه نار",98,"ر",1,0],["قد ألبسوك من الحمام شارته","فادخل اليه من الأَهواءِ فاغتسل",99,"ل",1,0],["قَدْ أَلْبَسوا خَيْلَهُم أَمثالَ ما ادَّرَعُوا","وَاسْتَقْبَلُونا حُصُونا في ذرَى حُصُنِ",100,"ن",1,0],["قد التحى بظلال الآصفي وزي","ر مصر فرد جميع العالم البطل",101,"ل",1,0],["قد التمّ شمل الدين رغم حسوده","بسلطان مجد والوزير الذي اجتهد",102,"د",1,0],["قَدْ أَلفناهُمُ فما تُذكرُ الأو","طان