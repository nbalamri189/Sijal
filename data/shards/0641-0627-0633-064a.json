{"poems":[[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[119,"هيج البعد هواها","https://www.aldiwan.net/poem40431.html","عموديه"],[133,"أنا في الحضيض وأنا مريض","https://www.aldiwan.net/poem67446.html","الكامل"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[201,"يا نديمي في صبايا","https://www.aldiwan.net/poem39869.html","مجزوء الرمل"],[376,"جفن على شوك القتادة يطبق","https://www.aldiwan.net/poem57276.html","الطويل"],[385,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[543,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[543,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[563,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99983","الخفيف"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101800","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60896","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137406",""],[3720,"","https://poetry.dctabudhabi.ae/diwan/poem/146962","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85278","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85258","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111480","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90962","الخفيف"],[4767,"ثقل العبء","https://www.poetsgate.com/ViewPoem.aspx?id=178890",""],[4852,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=214379",""],[4984,"في عيدها ..","https://www.poetsgate.com/ViewPoem.aspx?id=196952",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5212,"صَمّاءٌ حَكَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=212063",""],[520,"خلعت عليك مواسم الأيام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577640",""],[463,"لو كانَ يرفقُ ظاعنٌ بمشيِّعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60141&r=&rc=197",""],[463,"كمِ النّوى قدْ جزعَ الصَّابرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60086&r=&rc=142",""]],"verses":[["فأسيافُهم بالأمنِ والخوف ترتمِي","وأيديهمُ بالمالِ والدَّمِ تنضَخُ",0,"خ",1,0],["فأسيافُهُ تلك العواري نصولُها","إلى اليوم لم تُعْرَفْ لهُنّ غُمود",1,"د",1,0],["فاسئلوه يا لقومي","مهجتي كيف كواها",2,"ا",3,0],["فأسيرَ مُستنِداً إليها في الوَرى","أفلا فؤاد بين العباد",3,"د",1,0],["فاسئلْ جبالَ الروم لمَّا طوَّقوا","أعناقَها من جَمعهم برِعانِ",4,"ن",1,0],["فأسير القيد يصلي","كاسه نارا إذا ما",5,"م",2,0],["فأَسيرُ والحَدَثانُ لي مُستَيقِظٌ","وأعودُ وهوَ من المهابَةِ مُطرِقُ",6,"ق",1,0],["فَأَسيغ ماء مَدامِعي","وَاغص بِالماءِ القراح",7,"ح",1,0],["فأَسيرٌ لم يُغنِ عنه قَتيلٌ","وقتيلٌ لم يُغنِهم عنهُ أسرى",8,"ر",2,0],["فأسِيرهُم لم يُغنِ عنهُ قَتيلُهمُ","وقَتيلُهم لم يُغنِ عنهُ أسيرُ",9,"ر",1,0],["فأسير سير الغافلين بقولهم","أبداً وأقصد مقصد الأقوام",10,"م",1,0],["فَأُسِيمُ الْكُرُوبَ فِي مَسْرَحِ الْقَلْ","بِ وَمَرْعَى الْحِجَابِ مَرْعَى وَخِيمُ",11,"م",1,0],["فأسيافنا صدأى وظمأى رماحنا","وإيماننا غرثى إلى جزر جزار",12,"ر",1,0],["فاسيافُه حمرٌ وُدُهْمُ جفانُه","وسَاحاتُه خُضْرٌ بها الوفدُ خَيّمَا",13,"م",2,0],["فاسئل جميع صفات الحمد عنه تجد","ان المعالي لهذا الشهم عشاق",14,"ق",1,0],["فاسئلوا الليل بعدكم هل غمضنا","فيه للنوم للمسرة جفنا",15,"ن",2,1],["فاسئل من اللَه تثبيتاً ومغفرة","ما سمي القلب إلا من تقبله",16,"ب",3,0],["فأسيافه من خصمه ترعف الدما","وأقلامه بالبذل والجود ترعف",17,"ف",1,0],["فَأَسِيرُ مُختَرِقاً إِلى لُبِّ الحِما","أَعتَانُ ثُمَّ لأَبلُغَنَّ المَركَبا",18,"ب",2,0],["فاسئل النيرات عمن اظلت","هم على الأرض قبلنا الخضراء",19,"ا",2,0],["فأسًى جاثمٌ على صدر طاوٍ","وعظام بدت ووجه كئيب",20,"ب",1,0],["ف - أسىً - رَوَى أيامَهم","بؤساً تحلَّى بالقَرَفْ",21,"ف",1,0],["فاسيقظت أختنا والجمع محتدم","صحت على غفلة في سوء أحوال",22,"ل",1,0],["فأسيخوا أقدامكم في ثراها","تحت نار الكفاح والاصطلاء",23,"ا",2,0],["فأَسيرُ حتَّى أَسْتَريحُ بِمُفردي","أَمشي وَحيداً والتَّفرُّدُ مُؤنسي",24,"س",2,0],["فاسئل إلاهك أن يديم حياته","لك ألف عامٍ بعد هذا العام",25,"م",1,0],["فاسئلْ أسودُ الغابِ كيفَ تفسَّحتْ","للشاءِ عنْ هذا العرينِ المسبعِ",26,"ع",1,0],["فاسئلْ منَ النَّاجي إذا بويعتْ","نفسٌ بنفسٍ ومنِ الخاسرُ",27,"ر",1,0]]}