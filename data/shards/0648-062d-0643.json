"],[498,"أما والنجوم المشرقات من العلى","https://www.aldiwan.net/poem37987.html","الطويل"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[527,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[536,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[549,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[549,"تراءت لنا يوم الأبيرق في الدجى","https://www.aldiwan.net/poem47785.html","الطويل"],[556,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[556,"لا بد للضيق في الدنيا من الفرج","https://www.aldiwan.net/poem34691.html","البسيط"],[556,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"],[560,"جاءت رسالة إبراهيم سافرة","https://www.aldiwan.net/poem52791.html","البسيط"],[560,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[565,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[567,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[584,"مليح كأن الحسن أصبح حاديا","https://www.aldiwan.net/poem17620.html","الطويل"]],"verses":[["وَحُك لِيَ بُردَ العُلى ضافِياً","أَحُك لَكَ أَمثالَهُ مِن لِساني",0,"ي",1,0],["وَحَكَّمَ ثَغري في إِناءِ رُضابِهِ","وَأَدنى جَوادي مِن إِناءِ حَليبِهِ",1,"ب",2,0],["وحَكى الشقيقُ بهِ اسْوِدادَ قُلوبِها","وأُعيرَ منهُنّ احْمِرارَ خُدودِ",2,"د",1,0],["وحَكَيْتُ كُرْسيَّ العَروسِ وزِدْتُهُ","أنّي ضَمِنْتُ سَعادَةَ الأزْواجِ",3,"ج",1,0],["وَحِكَّةً في نَواتِها كَدَبي","بِ النَملِ لا تَأتَلي بِها تَسري",4,"ي",1,0],["وَحُكمي بُكاءُ الدَهرِ فيما يَنوبُني","وَحُكمُ لَبيدٍ فيهِ حَولٌ مُجَرَّمُ",5,"م",1,0],["وحكمت فيه أيادِي الحيا","ولا أجابَ الله ممَّا اصطرخ",6,"خ",1,0],["وحكتَ رقيق اللفظ منفرداً به","وقد قيل إن الروض حاكَ فحاكى",7,"ك",2,0],["وحكيت إيماض الثغور فلا تسل","عن خافقٍ من أضلعٍ تحكيكا",8,"ك",2,0],["وحكت رونق الثغور إلى أن","ضحكت بالبكا ثغور العيون",9,"ن",1,0],["وحَكَتك الرياض في الحسنِ والطِّي","بِ وإن كانَ ذاك منها اعتداءَ",10,"ا",2,0],["وحكت دجلةُ انْهِلالَك بالنا","ئل والعلم واكتستْ لألاءَ",10,"ا",2,0],["وحكْتكَ الصَّمَّانُ في سَعَةِ الصدْ","رِ وإن كان صدرُكَ الدهناءَ",10,"ا",2,0],["وحكمةٌ للبَيْنِ مقلوبةٌ","وأيُّ أمرِ البينِ لم يُقْلَبِ",11,"ب",1,0],["وحَكاها في سناءٍ","ما اكتستْه من شَوارِ",12,"ر",1,0],["وحكيت أنك مذ أطفت به","في عيشة تقتاتها لمعه",13,"ع",2,0],["وحكىَ التَّيَقُّنُ أنَّهُ","رجلُ المكارمِ لا التوهُّمْ",14,"م",1,0],["وحكاها في اللون والريح والطع","مِ ولطفِ الدبيب في الجُسمان",15,"ن",1,0],["وَحُكومَةٌ ما إِن تُزَحزِحُ أَحمَقاً","عَن رَأسِها حَتّى تُوَلِّيَ أَحمَقا",16,"ق",2,0],["وَحَكَّمَت يَدُهُ الأَقلامَ في دَمِهِ","فَلَم تَصُنهُ وَلَم يَعدِل إِلى حَكَمِ",17,"م",1,0],["وَحُكومَةَ الأَشياخِ وَيحَكِ ما الَّذي","خالَفتِ فيهِ عُصبَةَ الفِتيانِ",18,"ن",1,0],["وَحَكَيتُهُ في الأَرضِ بَينَ مَواكِبَ","وَكَواعِبَ جَمَعَت سَنا وَسَناءَ",19,"ا",2,0],["وَحَكَم الحاكِمُ مَصرَ وَيحَها","قَد لَقيت مِن حُكمِهِ جَهدَ البَلا",20,"ا",1,0],["وَحَكيماً اِستَعصَت أَعِنَّتُهُ عَلى","كَذِبِ النَعيمِ وَتُرَّهاتِ الجاهِ",21,"ا",2,0],["وَحَكَيتُ فيها النيلَ كاظِمَ غَيظِهِ","وَحَكَيتُهُ مُتَغَيِّظاً لَم يَكظِمِ",22,"م",1,0],["وَحَكى في اللُحومِ فِعلَكَ في الوَف","رِ فَأَودى بِالعَنتَريسِ الكِنازِ",23,"ز",1,0],["وَحَكَمتُ في البَلَدِ العَراءِ بِناعِجٍ","مُعتادِهِ مُجتابِهِ مُغتالِهِ",24,"ل",2,0],["وحكمة هذا الستار سر","وأمر ميزانه عسيرُ",25,"ر",1,0],["وحكم التزويج فال","خلط هو الأمر الأشد",26,"د",1,0],["وَحَكى القَطرَ بَل أَبَرَّ عَلى القَط","رِ بِكَفٍّ عَلى البَرِيَّةِ تَندى",27,"د",2,0],["وحَكَّمَ السيفَ فيها عادلاً فَغدَت","وأهلُها جَزَرٌ للسيفِ أو نَفَلُ",28,"ل",1,0],["وحكى غديراً غادرَتْه لنا","خُضْرُ النباتِ يرُفُّ أخضرُه",29,"ر",2,0],["وحكى اخضرارٌ شابَ حُمْرَتَها","قَرصَ الأكفِّ أديمَ وجنَتِها",30,"ت",3,0],["وحَكَت من الرَّشإ الرَّبيبِ ثلاثةً","عيْناً وجِيداً مُفتِناً وإهابا",31,"ب",2,0],["وحُكمٌ يَفْرُقُ الأعداءُ منه","كأنك فيه فاروقُ الصَّحَابي",32,"ب",2,0],["وَحَكَت كَيفَ أَصبَحَت فِتيَةُ الكَه","فِ رُقوداً خِلواً وَكَيفَ الرَقيما",33,"م",2,0],["وَحَكى كَيوانُ صَقراً لائِذاً","بِجَناحِ النِسرِ لَمّا فَرَشا",34,"ش",2,0],["وَحَكى المَريخُ في صَنعَتِهِ","خَدَّ مَحبوبٍ بِلَحظٍ خُدِشا",34,"ش",2,0],["وَحَكى ذِراعُ الشاةِ مُودَعَ سُمَّهُ","حَتّى كَأَنَّ العُضوَ مِنهُ لِسانُ",35,"ن",1,0],["وحَكَتْ جَوْزاؤهُ ساقيةً","بنطاقٍ شُدّ في خَصْرٍ هضيم",36,"م",1,0],["وحَكّمَ في الجودِ العُفاةَ وهكذا","يُحكّمُ أطرافَ الظّبا في الجماجمِ",37,"م",1,0],["وحكى نَشْرَها النسيمُ ولكن","بعدما نامَ في حُجورِ البهارِ",38,"ر",1,0],["وَحكى الصارِمَ المُحَلّى سِوى أَنَّ","حُلاهُ جَواهِرُ الآدابِ",39,"ب",1,0],["وَحَكِّمي عَدلاً يَكُن بَينَنا","أَو أَنتِ فيما بَينَنا فَاِحكُمي",40,"م",2,0],["وَحُكمٍ لَهُ دونَ الدِيانَةِ سَورَةٌ","تُقيمُ عَلى جَمرِ العِقابِ وَتَقعُدُ",41,"د",1,0],["وحكيمٌ تَنْحَني شُمُّ الرُّؤوسْ","تَتلَقَّى من عِظاتٍ وَدُروسْ",42,"س",1,0],["وحُكّامُ عدلٍ شائعٍ ووزارةٌ","هي الشّعبُ أو رُوحٌ من الشّعبِ صالحُ",43,"ح",1,0],["وحُكْمكَ ماضٍ في الخلائِقِ نَافِذٌ","إذا شئتَ أمراً ليس من كونِهِ بُدُّ",44,"د",1,0],["وحَكَتهُم ذُرِّيَّةٌ كالدَّرَارِي","مِنْ بُطُونٍ زَكِيَّةٍ وظُهورِ",45,"ر",1,0],["وَحُكماً لِهَذا الدَهرِ صاحَ بِقائِمٍ","مِنَ العالَمِ اِجلُس أَو دَعا جالِساً قُمِ",46,"م",1,0],["وحكومة البلدان جمهورية","ما إن تطيع لمفردٍ سلطانا",47,"ن",2,0],["وحكم الله بهجرة الوطن","وطالما ابتلى بها أهل الفطن",48,"ن",1,0],["وَحَكَيْتِ مُنْجِيكِ الَّتِي فِي ظِلِّهَا","رُعِيَ اليَتِيمُ وَهِينَ وَجْهُ المُعْتَفِي",49,"ي",1,0],["وَحِكْمَةٌ في بَيَانٍ","إنَّ الْبَيَانَ لَسِحْر",50,"ر",1,0],["وحَكَتْهُمْ ذُرِّيَّة ٌ كالذَّرارِي","من بطونٍ زكية ٍ وظهورِ",51,"ر",1,0],["وحُكْمٌ كالدَّجى عُريانُ صافٍ","فلم يُنْكِرْ ، إذا انتَسبَ ، السَّوادا",52,"د",2,0],["وحكومة الأشباح ويحك ما الّذي","خالفت فيه عصبة الفتيان",53,"ن",1,0],["وحكومة ما إن تزحزح أحمقا","عن رأسها حتّى تولّي أحنقا",54,"ق",2,0],["وحكيماً کسْتعصَتْ أَعِنَّتُه على","كذبِ النعيمِ، وتُرَّهاتِ الجاه",55,"ا",2,0],["وحكت دار مية فلهذا","سح دمعي بالعارض الهتان",56,"ن",1,0],["وحكى الزمان بغدره اذ لم نجد","تمثاله الا على تمثاله",57,"ل",2,0],["وحكمة وكمال صين في ادب","قد لاح من قبة العرفان لامعه",58,"ع",2,0],["وحكاياتُ غَرامٍ لم تَمُتْ","سوفَ تَبقى قصةُ العِشْقِ سِنينا",59,"ن",2,0],["وحكومة السفهاء لم نعرف لها","وجهاً بهذا الموطن المشؤوم",60,"م",1,0],["وحكتْ فريضَ البحتري سلاسةً","وابن الحسين الفذَّ في الإحكامِ",61,"م",1,0],["وحَكَّ مِنَ الأرِض في وَجهِهِ","كَمَا حُكَّ لِلهَرشِ جَنبَ الصَّفَا",62,"ف",2,0],["وحكَّتْ على واسطٍ بَركْهَا","بيومٍ عسير أشابَ القرونا",63,"ن",2,0],["وَحَكَّمَكُم فينا الغَرامُ فَجُرتُمُ","وَكَم حَكَمَ المَولى بِما كَرِهَ العَبدُ",64,"د",1,0],["وَحُكمٌ بِلا جَورٍ وَفَضلٌ بِلا نَقصِ","أَضافَ الوَرى لِلدينِ خَيرَ إِضافَةٍ",65,"ه",1,0],["وحكم المواضي جائر لو أطعته","لأجرتْ شعوباً من دمائهم جريا",66,"ي",2,0],["وحكم فيمن كان أفتى بكفره","من العلماء الصالحين ذوى التقوى",67,"ا",1,0],["وحكمُ الرَّدى حكمُ العمومِ ولم يزلْ","بِروقيهِ في وجهِ البريّةِ يَنطحُ",68,"ح",1,0],["وَحُكَّم العِلجَ فيكُم مَع مَهانَتِهِ","يَقتادكُم لِهَواهُ حَيثُ يَنقَلبُ",69,"ب",1,0],["وحكم التَّعازى سُنّةٌ نَبوية","وإلا فمنك الحزمُ يَبْدو ويَصدُر",70,"ر",1,0],["وَحَكّمَهم في المُؤمنينَ لِحكمةٍ","بِبعضِ النَواحي وهوَ في ملكهِ أدرى",71,"ر",2,0],["وَحكّمهُ في ملكهِ فتحكّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",72,"م",2,0],["وَحكّمَ في الأديان صادق فهمهِ","إذاً لاِرتَضى الإسلام ديناً بعلمهِ",73,"ه",1,0],["وَحَكى فصدّقهُ اللبيبُ فَأفلحا","وَالحقُّ عندَ العاقلين مسلّمُ",74,"م",1,0],["وحكتْ دموعَ الغانياتِ عقودُها","لو لم يكن لعقودهنَّ نظام",75,"م",1,0],["وحكى صوتهنَّ أصواتَ داو","دَ فهبتْ سواجعُ الأطيارِ",76,"ر",1,0],["وحكت جداولها خلاخيلا وقد","اضحى خرير الماء من رناتها",77,"ت",3,0],["وَحَكَّمتِ سَيفَ الحَقِّ في عُنقِ الريا