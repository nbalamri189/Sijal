{"poems":[[55,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[29,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[53,"يا ليت شعري حين فارقتكم","https://www.aldiwan.net/poem66085.html","السريع"],[87,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[87,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[63,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[83,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[41,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[98,"أَفْرَاحُ الْوَادِي","https://www.poetsgate.com/ViewPoem.aspx?id=187843",""],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[280,"لولا قديم من عفافي تالد","https://www.aldiwan.net/poem25610.html","الكامل"],[445,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[469,"تباً لما اختلق الواشي وما نقلا","https://www.aldiwan.net/poem3504.html","عموديه"],[519,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[567,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48679","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48531","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62521","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72326","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96475","الكامل"],[1833,"","https://poetry.dctabudhabi.ae/diwan/poem/111110","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53054","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27726","الكامل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33897","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100845","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112365","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138519",""],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45243","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129449","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86506","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136902",""],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77694","البسيط"],[4701,"الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=176660",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[5026,"فراشة سكرى","https://www.poetsgate.com/ViewPoem.aspx?id=210477",""],[3591,"علمتني الشجو بأصوات الذي فتنا","https://www.poetsgate.com/ViewPoem.aspx?id=149378",""],[5187,"يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=37394",""],[5431,"الله رمى....","https://www.poetsgate.com/ViewPoem.aspx?id=213796",""],[2546,"قل للإمامِ ابنِ الإما م","https://www.poetsgate.com/ViewPoem.aspx?id=17165",""],[5790,"لولا قوامك والأعطاف والهيف","https://www.poetsgate.com/ViewPoem.aspx?id=112078",""],[5956,"قرُبَ الوداعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193570",""]],"verses":[["لَولا قِوامُ الدينِ ما اِستَوسَقَت","أَعناقُها في السَنَنِ الأَقوَمِ",0,"م",1,0],["لَولا قَبائِلُ مِن زَيدٍ تَلوذُ بِها","كانَت عَصاكَ الَّتي تُلحى وَتُقتَشَرُ",1,"ر",1,0],["لولا قضاءُ الله في مَعْشرٍ","ما طمع الطامِعُ في هَضْمي",2,"م",2,0],["لولا قضاء الله ما خاضوا الوغى","إن القضاء إذا أتى لا يُدفع",3,"ع",1,0],["لَولا قَضاءُ الملِكِ القَدير","لَما سَعى العِقدُ إِلى الخِنزير",4,"ر",1,0],["لولا قِراعُك لم يَهوِ الصليبُ ولم","يَعْلُ الأَذانُ بها ما أطَّتِ الإِبلُ",5,"ل",1,0],["لَولا قَبولِيَ نُصحَ العَزمِ مُرتَحِلاً","لَراكَضاني إِلَيهِ الرَحلُ وَالجَمَلُ",6,"ل",1,0],["لَولا قَضاؤُكَ بَينَ الحُكمِ وَالحَكَمِ","لَما جَرى السَيفُ في شَأوٍ مَعَ القَلَمِ",7,"م",1,1],["لَولا قُرَيشٌ وَحَقٌّ في الكِتابِ لَها","وَأَنَّ طاعَتَهُم تَهدي إِلى الرَشَدِ",8,"د",1,0],["لولا قُدومُكَ قبْلَ النّحْرِ أخّرَهُ","إلى قدومِك أهْلُ النفْعِ والضّرَرِ",9,"ر",1,0],["لولا قراصنةٌ عليها تآمروا","لم يَعْلُ نافارين هذا الميسمُ",10,"م",1,0],["لولا قراصنةٌ عليه تآمروا","لم يَعْلُ «نافارينَ» هذا المِيسَمُ",11,"م",1,0],["لولا قصيدي ولولا ما هتفت به","ما صرت كالبدر في حسن وتحنان",12,"ن",1,0],["لَولا قَديمٌ مِنْ عَفَافِيَ تَالِد","وَطَريفُ شَيْبٍ قَدْ ألَمّ حَديثُ",13,"ث",1,1],["لولا قَضاءُ فِراقِهِ وطَلبتَهُ","فِي غيرِ جَفْنِي ماثِلاً لَمْ تُلْفِهِ",14,"ف",2,0],["لولا قلاك لقد كانت خلائقه","إذا صددتَ على عاداته وصلا",15,"ل",2,0],["لولا قُدودُ غَوانيكُمْ وأنمُلُها","ما هزّ عِطفي ذِكرُ البانِ والعلَمِ",16,"م",1,0],["لولا قديمُ الموتِ لاصطَنَعَ الوَرَى","مَوتاً فماتَ النَّاسُ بالمُتَجدِّدِ",17,"د",1,0],["لولا قواك استوقفتك بيثربٍ","وبمكةَ الذكرى وأنت مزايل",18,"ل",1,0],["لولا قواعد لا تري","د لها انحلالاً وانتهاك",19,"ك",1,0],["لولا قعود الدهر بي لأتيته","نسترجع الماضي به أيَّاما",20,"م",2,0],["لولا قوامك يا قضيب البان","لم يحسن القضبان في الكثبان",21,"ن",1,1],["لولا قيام الوزن بالعروض","لما عرفنا صنعة القريض",22,"ض",1,0],["لولا قريش سقى اللَه الوجود بها","غوثاً من الأمن في غيث من الديم",23,"م",1,0],["لولا قريش نصرها ودفاعها","ألفيت منقطعاً بي الأسباب",24,"ب",1,0],["لولا قيام علي عنك في بدل","لم يطف غلتها بحر ولا قطر",25,"ر",1,0],["لولا قراع رماح الخطّ ما عرفت","لسمرها ميزة يوماً على القَصَبِ",26,"ب",1,0],["لولا قبولي ما رأيت وجودي","وبه مننت عليّ حال شهودي",27,"د",2,1],["لولا قُدومُكَ ما اِنجَلى","عَنّا الجَليلُ مِنَ الخُطوبِ",28,"ب",1,0],["لولا قليلون هانت حرفة كرمت","ايام كل طويل الباع مقصود",29,"د",1,0],["لولا قليلُ حراكٍ في تملمُلِهِ","لخِلتُهُ قطعةً من صمّ جلمودِ",30,"د",1,0],["لولا قريشٌ والذي ارتكبوه لم","تطمع بأن تردي الوصي مرادها",31,"د",3,0],["لَولا قُعودُ الدَهرِ بي عَنكِ لَم يَكُن","يُفَرِّقُنا شَيءُ سِوى المَوتُ فَاِعذِري",32,"ر",2,1],["لولا قراع كتائب الايام","وقعود أسباب الهوى وقيام",33,"م",1,1],["لولا قضاء اللَه في مهج الورى","نيطت إليك أزمة الآجال",34,"ل",1,0],["لولا قصائدك الغراء ما ذُكرت","يوماً ولا دوَّن التاريخ ماضيها",35,"ي",3,0],["لَولا قَواطِعُ لي أَشراكها نُصِبَت","لَزُرتُ قَبرك لا أَشكو مِن النَصبِ",36,"ب",1,0],["لولا قضاءُ الله أن تظما له","لسعى إليك من الجنانِ الكوثرُ",37,"ر",1,0],["لولا قضاء الله لارتد الردى","عن حُر وجهِك باكيًا يستغفرُ",37,"ر",1,0],["لولا قصور الحس في وصفها","أبحت للوجدان إطلاقها",38,"ق",3,0],["لولا قراصِنَةٌ تُحَطِّمُ مَركبي","ما عابَ خِضْرٌ زَورقي مُسْتَدْبِرا",39,"ر",2,0],["لولاق في وصفٍ خود وصف قوتها","لقلتُ هذه تدكُ الطود والقننا",40,"ن",2,0],["لولا قَداسَةُ ( مَكّةٍ ) ورَسُولُها","لتَسابَقَتْ لِرِحابِكِ العُبّادُ",41,"د",1,0],["لولا قصيدي بالحب منسجمٌ","خانته إمّا ...وقد سقته عمى",42,"م",2,0],["لولا قدومكَ ما انجلى","عنّا الجيلُ منَ الخطوبِ",43,"ب",1,0],["لولا قوامك والأعطاف والهيف","ما بت فيك بوجدٍ سحبه تكف",44,"ف",1,1],["لولا قدِ انبجستْ كواكب مجدكم","بالرغم عنه لما النوابغ لاحوا",45,"ح",3,0]]}