{"poems":[[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[82,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[82,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[46,"ملك جار إذ ملك","https://www.aldiwan.net/poem30142.html","مجزوء الخفيف"],[111,"همم الملوك أجلها أعظامها","https://www.poetsgate.com/ViewPoem.aspx?id=533",""],[113,"يا ربع كم لك من شجي هالك","https://www.aldiwan.net/poem16297.html","الكامل"],[164,"ملك سما ذو كمال زانه كرم","https://www.aldiwan.net/poem59106.html","البسيط"],[164,"لا تيأسن فالرجا كم فرجا","https://www.aldiwan.net/poem59113.html","الرجز"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[287,"يا ذا العذار الذي به عذري","https://www.aldiwan.net/poem32766.html","المنسرح"],[369,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[443,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[520,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[580,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[580,"حسنها كل ساعة يتجدد","https://www.aldiwan.net/poem3089.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138220",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104543","المديد"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56630","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47117","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94204","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93812","الخفيف"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46732","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58506","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90796","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73088","الخفيف"],[4583,"","https://poetry.dctabudhabi.ae/diwan/poem/130725","الكامل"],[5136,"نصر من الله وفتح قريب","https://www.poetsgate.com/ViewPoem.aspx?id=121520",""]],"verses":[["مُلكٌ جَرى الدَهرُ بِهِ زَهواً وَما","أَقصَرَهُ مُلاوةً إِذا رَها",0,"ا",1,0],["مَلَكٌ جاوَرَ التُرابَ فَلَمّا","مَلَّ نابَت عَنِ التُرابِ السَماءُ",1,"ا",2,0],["مُلْكٌ جديدٌ مثل طَبْعِ المُنصُلِ","نَمشُ الفرندِ عَلَيهِ صنع الصيقلِ",2,"ل",1,1],["مُلْكٌ جديدُ المعالي في حمى ملك","ماضٍ كما طُبِعَ الصمصامة الذكرُ",3,"ر",1,0],["مَلِكٌ جارَ إِذ مَلَك","لَيسَ يَرثي لِمَن هَلَك",4,"ك",1,1],["ملك جلالته وعزة شأنه","بمسابح القمرين جل مقامها",5,"م",3,0],["ملك جبلته على الحلم انطوت","إن الملوك تزينها أحلامها",5,"م",3,0],["مَلك جَناحاً خَيلَهُ وَرِماحَهُ","يَوم الوَغى مِن فتية وَملائك",6,"ك",1,0],["ملك جنى لا يرى سوءا بصاحبه","يرمي الفلا لا يرى بالمكث في الأجم",7,"م",1,0],["ملك جواد قوله وفعله","قد حرجا في غيره قدح الرجا",8,"ج",2,0],["مَلِكٌ جَلَّ قُدسُهُ عَن مِثالٍ","وَتَعالَت آلاؤُهُ عَن قِياسِ",9,"س",1,0],["مَلكٌ جَوادٌ لَولاهُ لَم يَكُ في","زَمانِنا ذا لِلشِعرِ مِن سِعرِ",10,"ر",1,0],["مَلِكٌ جُيوشُ النّصرِ حيث سَما له","يسْرِين تحت لوائه المَعْقود",11,"د",1,0],["ملك جلى الورى كرما","في العطايا وهو متلد",12,"د",1,0],["ملِكٌ جلالتُه كَفَتْهُ وشأنُه","عن زينةِ الألقابِ أو حَلْيِ الكنى",13,"ن",2,0],["ملك جناية سيفه وسنانه","في كل جبار عصاه جبار",14,"ر",1,0],["ملك جمل الكفالة لما","فوضت نحوه أمور الكفالة",15,"ل",2,0],["ملك جعلت المدح فيه فريضة","وجعلته فيمن سواه تنفلا",16,"ل",2,0],["مَلِكٌ جُندُه ملائكةُ اللَّ","ه فُرادى جاءَت إِليه ومَثْنى",17,"ن",2,0],["ملكٌ جودُه تقرَّب مِنَّا","مثلمَا فَضْلُه إِليْنا تَوَّدد",18,"د",1,0],["ملك جليل لنا سالت مكارمه","سيلا هنئنا به والأزمة انفرجت",19,"ت",1,0],["مَلِكٌ جَلَّت جلالتُه","أَن يَرى أَنوارَهُ البَصرُ",20,"ر",1,0],["ملك جميل الرأي يصحبه","فكلاهما بأخيه متصل",21,"ل",1,0],["ملك جلّ عن شبيه وكلّ","من ملوك الورى له نظراء",22,"ا",2,0],["ملك جلّ من شبيه فقل ما شئ","ت فيمن سما على الأنداد",23,"د",1,0],["مَلِكٌ جرى في الصّالحات إلى مدى","تَنْبَتُّ دون بلوغه الأقْدَادُ",24,"د",1,0],["ملك جليل أسفرت أسفاره","في ضمن إظهار العلى عما خفى",25,"ف",2,0],["ملك جل عن نظير وشبه","حار في وصفه ذووا الأوصاف",26,"ف",1,0],["مَلكٌ جَهِلنا قَبلَهُ سُبُلَ العُلا","حَتّى وَضَحنَ بِنَهجِهِ وَشِراعِهِ",27,"ع",2,0],["مَلِكٌ جائِرٌ أرومُ رِضاهُ","كُلَّ يوم بِذُلَةٍ واحتِيال",28,"ل",1,0],["ملك جمل طرس الملك مذ","لعلى ركن سرير العز شاد",29,"د",1,0],["مَلِكٌ جَلَّ أَن يدُانيهِ ملَكٌ","جَلَّ أو قلَّ رِفعةً وجَلاَلا",30,"ل",2,0],["ملكٌ جوادٌ عادلٌ نصبت لهُ","أيدي السعادة في السماءِ خياما",31,"م",2,0],["ملك جلاه عنفوان الصبا","يهتز في ريعانه كالقضيب",32,"ب",1,0]]}