{"poems":[[37,"لمن الديار بأبرق الحنان","https://www.aldiwan.net/poem38817.html","الكامل"],[31,"أذكرت عهدك فاعترتك صبابة","https://www.aldiwan.net/poem6097.html","البسيط"],[93,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[46,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[42,"أقوت تعرة فالإصغاء فالخال","https://www.aldiwan.net/poem42276.html","البسيط"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[15,"أمن رسوم نأيها ناحل","https://www.aldiwan.net/poem45250.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54640","الكامل"],[108,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[136,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[136,"حى المنازل حول نهى الضال","https://www.aldiwan.net/poem54763.html","الطويل"],[170,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[173,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[173,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[382,"أقوت عهودهم فأين ذمامي","https://www.aldiwan.net/poem59264.html","الكامل"],[382,"وقبيلة جهلاؤها عقلاؤها","https://www.aldiwan.net/poem66981.html","الكامل"],[475,"أقوت رواوة من أسماء فالسند","https://www.aldiwan.net/poem4666.html","البسيط"],[514,"حي المنازل أقفرت بسهام","https://www.aldiwan.net/poem750.html",""],[515,"حيا الحيا وطناً بإربل دارساً","https://www.aldiwan.net/poem1592.html",""],[519,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123387","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96677","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96490","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87841","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115624","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132706","البسيط"],[3225,"","https://poetry.dctabudhabi.ae/diwan/poem/146583","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86502","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86434","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105525","الكامل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22097","الكامل"],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22587","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66146","البسيط"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116070","الكامل"],[4778,"طال انحباس الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=193624",""],[927,"أَقْوَتْ مَغانيهم فأقوى الجسَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=106732",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5582,"أَبُدُورُ تَمٍّ كالبُدُورِ طَوالِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63530",""],[5582,"( نَفْسُ ) المُتَيَّمِ فِي الصَّبابَةِ شانُها","https://www.poetsgate.com/ViewPoem.aspx?id=63591",""],[6029,"أسمعتُمُ أنّ الورودَ تُضامُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=188861",""]],"verses":[["أَقوَت مَنازِلُها وَغَيَّرَ رَسمَها","بَعدَ الأَنيسِ تَعاقُبُ الأَزمانِ",0,"ن",1,0],["أَقوَت وَغَيَّرَ آيَها نَسجُ الصَبا","وَسِجالُ كُلِّ مُجَلجِلٍ مَحمودِ",1,"د",1,0],["أَقوَت وَباتَت كَالمَسامِعِ بَعدَها","لا شَيءَ يُطرِبُها وَلا يَشجيها",2,"ي",3,0],["أَقوَت فَلَم أَذكُر بها لَمّا خَلَت","إِلّا مِنىً لَمّا تَقَضّى المَوسِمُ",3,"م",1,0],["أَقوَت خَزائِنُهُم فَاِستَحدَثوا وَرَقاً","يَهفو مَعَ الريحِ إِلّا أَنَّهُ نَشَبُ",4,"ب",1,0],["أَقوَت تَعِرَّةُ فَالإِصغاءُ فَالخالُ","مِن آلِ أَسماءَ إِلّا النُؤىُ وَالآلُ",5,"ل",1,1],["أَقوَت مَعالِمُها وَغَيَّرَ رَسمَها","هوجُ الرِياحِ وَحِقبَةُ الأَيّامِ",6,"م",1,0],["أَقوَت مِنَ اللائي هُمُ أَهلُها","فَما بِها إِذ ظَعَنوا آمِلُ",7,"ل",1,0],["أَقْوَتْ مَعَاهِدُنَا وَكَانَتْ بِالهَوَى","مَعْمُورَةً فَإِخَالُهُنَّ خَرَائِبَا",8,"ب",2,0],["أقوت مسارحهُ، وأغطش ليله!","لا راقص فيه، ولا مترنم",9,"م",1,0],["أقوت معاهدها بعدي فألبسها","من بعد جدتها الأقواءُ ثوب بِلَى",10,"ل",2,0],["أَقوَت وأضحَت أيُهَا كَالوَشمِ في","رُسغِ الهَدِىِّ البَضَّةِ المِكسَالِ",11,"ل",1,0],["أَقْوتْ معاهدُهُمْ وشطَّ الوادي","فبقيتُ مقتولاً وشَطَّ الوادي",12,"د",2,1],["أَقوَت مَغانيهِم فَهُنَّ بِالبُكا","أَحَقُّ مِن وادي الغَضا وَالأَجرُعِ",13,"ع",1,0],["أَقوَت مَغانِيهم وَكانَت حِقبَةً","مَأوى الحِسانِ وَمَلعَبَ الفِتيانِ",14,"ن",1,0],["أقوَت عهودُهم فأين ذمامي","وخلت قلوبهمُ فأين مقامي",15,"م",2,1],["أَقوَت فَأَقوَت أَبحراً وَمعاهِداً","لم يُدرَ من إِقوائِها إِقواؤُها",16,"ا",3,0],["أَقوَت رُواوَةُ مِن أَسماءَ فالسَنَدُ","فالسَهبُ فالقاعُ مِن عَيرَينِ فالجُمُدُ",17,"د",1,1],["أَقوَت وَقَد كانَت تَحُلُّ بِجوِّها","حورُ المَدامِعِ مِن ظِباءِ الشامِ",18,"م",1,0],["أقوَت مرابِعُهُ وأوحشَ أُنسُهُ","وخَلَت مراتعهُ من الآرام",19,"م",1,0],["أقوَتْ بُيوتُ المالِ منذُ تعمّرتْ","فيها رُبوعٌ للنّدى ومَغانِ",20,"ن",1,0],["أَقْوَتْ مَغانيهم فأقوى الجَلدُ","رَبْعَانِ كلٌّ بعد سُكْنى فَدْفَدُ",21,"د",1,1],["أَقوَت مَرابِعُها فَما ضحت الحشا","منّي لَها بعد الربوع مرابعُ",22,"ع",1,0],["اقوت معالم دينكم وقواعد الا","سلام قد ساخت بلى ودروسا",23,"س",2,0],["أقوت وغيَّر رسمها من بعده","هوج الرياح وكل جون ماطر",24,"ر",1,0],["أَقوَت جَوانِبُهُ وَكُنتُ أَظُنُّهُ","سَيَدومُ في حِرزٍ مِنَ الأَهوالِ",25,"ل",1,0],["أقوت ربوعهم فشأنُ بيوتهم","بيتانِ ينصَبُ ذا وهذا يرفع",26,"ع",1,0],["اقوت بها عرصات العلم واندرست","منها المدارس إلا الرسم والطلل",27,"ل",1,0],["أقوت مغاني العلا يا حسن بهجتها","حتى كأن اسمها لغو يلوك فم",28,"م",1,0],["أقوت فهن من الأنيس خلاء","دمن محت آياتها الأنواء",29,"ا",2,1],["أقوت معالم أنسهم والوحش كم","راحت ومن أسيافهم أقواتها",30,"ت",3,0],["أَقوت مَعاهِد قَومِ يونانَ الأُلى","راضوا اللَّيالي وَالزَّمانُ شَرودُ",31,"د",1,0],["أَقوتُ عُكاظٌ بَعدَ ما حَلَّ القَضا","يَوماً بِنابِغَةِ القَريضِ زِيادِ",32,"د",1,0],["أقوت ثلاثة أعوامِ وغيّرها","نكُبٌ لها بعراص الدار تدويمُ",33,"م",1,0],["أقوت منازلها عصراً وغيرها","كر الأشدين من محلٍ ومن أمد",34,"د",1,0],["أقوت معاهد سلمى فهي أدراس","تعتادها من رياح البين أنفاس",35,"س",1,1],["أقوت مرابعها فلا طلل","باد ولا آثارها جدد",36,"د",1,0],["أَقوَت وَغَيَّرَ آيَها","مَرُّ الحَوادِثِ وَالسِنينِ",37,"ن",1,0],["أَقوت مَنازِلَ ذي طُوى","فَبِطاحِ مَكَّةَ فَالمَشاهِدِ",38,"د",1,0],["اقْوَتْ مَنازِلُهُمْ مِنْ بَعْدِهِمْ فَغَدَتْ","رَسْما كما خَطَّ فَوْقَ الكاغَدِ القَلَمُ",39,"م",1,0],["أقوَت مغانِيه وعُطِّل رَبعُهُ","ولرُبَّما هجرَ العرينَ الضَّيغَمُ",40,"م",1,0],["أقْوَتْ من الله الحليم قلوبهم","ما عاد فيهم فضله مأمول",41,"ل",1,0],["أَقْوَتْ مَغانيهم فأقوى الجسَدُ","رَبْعَانِ كلٌّ بعد سُكْنى فَدْفَدُ",42,"د",1,1],["أَقْوَتْ مَعالِمُها وَما دُهِيَتْ","مِنْ قَبْلِ ذَا الإِقْوا بِإِقْواءِ",43,"ا",2,0],["أَقْوَتْ مَغانِيهِ مِنْهُ بُرْهَةً وَعَفَتْ","وَما عَفَتْ مِنْهُ فِي قَلْبِي مَغانِيهِ",44,"ي",2,0],["أَقْوَتْ مَرابِعُها فَأَضْحَتْ فِي الحَشا","مِنِّي لَها بَعْدَ الرُّبُوعِ مَرابِعُ",45,"ع",1,0],["أَقْوَتْ غَداةَ البَيْنِ مِنْ سُكَّانِها","فَتَأَهَّلَتْها بَعْدَهُمْ صِيرانُها",46,"ن",3,0],["أقوَتْ وفيها عُدّةٌ من أهلها","وخلَتْ وفيها كَثْرةٌ وزِحامُ",47,"م",1,0]]}