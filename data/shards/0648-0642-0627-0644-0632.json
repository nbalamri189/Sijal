{"poems":[[74,"أقيما فروض الحزن فالوقت وقتها","https://www.aldiwan.net/poem18388.html","الطويل"],[74,"أمنزل سعدى بالعذيب سقاكا","https://www.aldiwan.net/poem19440.html","الطويل"],[40,"أمن آل وسنى آخر الليل زائر","https://www.aldiwan.net/poem7713.html","الطويل"],[185,"خليلى ليس الشوق أن تشحط النوى","https://www.aldiwan.net/poem58832.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56639","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108720","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89524","الطويل"]],"verses":[["وقال زماني هاكَ بعد تنعمٍ","كؤوس الأسى والحزن ملآى فقلت ها",0,"ت",3,0],["وقال زماني ما تضرُّ إساءتي","إذا استغفرت لي في الآثام يداكا",1,"ك",2,0],["وَقالَ زِيادٌ إِذ تَوارَت حُمولُهُم","أَرى الحَيُّ قَد ساروا فَهَل أَنتَ سائِرُ",2,"ر",1,0],["وَقالَ زَمِيلِى يَومض سالِفَةِ النَّقا","وَعَيناىَ مِن فَرطِ الهَوَى تَكِكفَانِ",3,"ن",1,0],["وقال زورا إن أمر الناس","بعد النبي صار للعباس",4,"س",1,0],["وقال زنه ولكن لو وزنت به","جميع أمته لاجتازهم عظما",5,"م",2,0],["وقال زمانك كيف التحامي","وناداك دهرك أين المفر",6,"ر",1,0],["وقال زمان العدل ليس بحاضرٍ","لنعدل حتى لا نفيت فتى وفرا",7,"ر",2,0],["وَقالَ زَعيمُ القَومِ لا بَل شَقيُّهُم","إِلى اِبنِ طَلالٍ أَرسِلوا فَهوَ أَحزَمُ",8,"م",1,0]]}