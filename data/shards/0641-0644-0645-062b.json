{"poems":[[79,"يا حسنها من أربع وديار","https://www.aldiwan.net/poem36462.html","الكامل"],[23,"إبك بكت عيناك ثم تبادرت","https://www.aldiwan.net/poem21321.html","الكامل"],[45,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[76,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[76,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140959",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12735","الكامل"],[439,"عظم المصاب وعمت الأكدار","https://www.aldiwan.net/poem811.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138232",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110453","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203793",""],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96444","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121075","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77917","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27686","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47123","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99081","الكامل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106425",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69962","الكامل"],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110653","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120405","الكامل"]],"verses":[["فلمِثْلِها ذُخِرَ الجَزاءُ ومثْلُهُ","مَنْ لا يُضيعُ صَنائِعَ الأحْرارِ",0,"ر",1,0],["فَلِمِثلُهُ وَلِمِثلُ ما يَدعو لَهُ","كانَ المُمَدَّحَ ثُمَّ غَيرَ كَهامِ",1,"م",1,0],["فَلِمِثلِهِ جَمَعَ العَرَمرَمُ نَفسَهُ","وَبِمِثلِهِ اِنفَصَمَت عُرى أَقتالِهِ",2,"ل",2,0],["فَلِمِثلِهِ مِن يَومِ خَطبٍ نازِلٍ","جَمَّت دُموعُ أَفاضِلِ الأَبناءِ",3,"ا",2,0],["فَلِمِثلِها مِن شِقَّةٍ","أَعدَدتُ مِثلَكَ مِن رَفيقِ",4,"ق",1,0],["فلمثله جمع العرمرم نفسه","وبمثله انقصمت عرى أقتاله",5,"ل",2,0],["فلِمثْلِ قُرْطُبةٍ يقلُّ بُكاءُ مَن","يَبْكِي بعَيْنٍ دَمْعُها متَفَجِّرُ",6,"ر",1,0],["فَلِمِثلِهِ بَكَتِ العُيونُ دِماءَها","وَلِمثلِهِ حَزِنَت عَلَيهِ الأَنفُسُ",7,"س",1,0],["فلمثل ذا يبكي الحليم كآبةً","ولمثل هذا تُنشَد الأشعارُ",8,"ر",1,0],["فلمثلك الإخلاص فرض واجب","من كل دان في الورى وبعيد",9,"د",1,0],["فلمثلكُم كرَمُ النُفُوس وطيبُها","وصَداقةُ الإخوان والخلاَّنِ",10,"ن",1,0],["فلمثلنا شرفُ الفدا","ء وعزة الحر الشهيد",11,"د",1,0],["فَلِمثلُ قَتلِكَ هَدَّ قَومَكَ كُلهُم","مَن كانَ يَحمِلُ عنهُمُ الاثقالا",12,"ل",2,0],["فلمثلِ هذا اليوم كنتَ مؤملاً","وإليه كنت على المدى متشوقا",13,"ق",2,0],["فلمثل هَذا يعملون","وَيطربون إِلى السماع",14,"ع",1,0],["فلمثل هذا يعمل الشخص الذي","هو في الحقيقة بالشريعة عامل",15,"ل",1,0],["فَلِمِثل هذا الصُّنْعِ تستبق النّهى","وعليه تنفطر الكِرَامُ كبودا",16,"د",2,0],["فلمثلها طرب الأمي","ر إلى طباهجة بقير",17,"ر",1,0],["فلمثلك الغارات يوم ملمة","والخارقات بباطن وبظاهر",18,"ر",1,0],["فَلمثلها الفَردوسُ مَوعودٌ بِهِ","مِن صادقٍ في وَعدِهِ لا يَخرمُ",19,"م",1,0],["فلمثله أن تفتدى معشوقة","ولمثلها ان تفتدي متعشقا",20,"ق",2,0],["فلمثل احمد في الورى","يتودد المتودد",21,"د",1,0]]}