{"poems":[[77,"يا حسنها من أربع وديار","https://www.aldiwan.net/poem36462.html","الكامل"],[23,"إبك بكت عيناك ثم تبادرت","https://www.aldiwan.net/poem21321.html","الكامل"],[43,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[74,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[74,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140959",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12735","الكامل"],[434,"عظم المصاب وعمت الأكدار","https://www.aldiwan.net/poem811.html",""]],"verses":[["فلمِثْلِها ذُخِرَ الجَزاءُ ومثْلُهُ","مَنْ لا يُضيعُ صَنائِعَ الأحْرارِ",0,"ر",1,0],["فَلِمِثلُهُ وَلِمِثلُ ما يَدعو لَهُ","كانَ المُمَدَّحَ ثُمَّ غَيرَ كَهامِ",1,"م",1,0],["فَلِمِثلِهِ جَمَعَ العَرَمرَمُ نَفسَهُ","وَبِمِثلِهِ اِنفَصَمَت عُرى أَقتالِهِ",2,"ل",2,0],["فَلِمِثلِهِ مِن يَومِ خَطبٍ نازِلٍ","جَمَّت دُموعُ أَفاضِلِ الأَبناءِ",3,"ا",2,0],["فَلِمِثلِها مِن شِقَّةٍ","أَعدَدتُ مِثلَكَ مِن رَفيقِ",4,"ق",1,0],["فلمثله جمع العرمرم نفسه","وبمثله انقصمت عرى أقتاله",5,"ل",2,0],["فلِمثْلِ قُرْطُبةٍ يقلُّ بُكاءُ مَن","يَبْكِي بعَيْنٍ دَمْعُها متَفَجِّرُ",6,"ر",1,0],["فَلِمِثلِهِ بَكَتِ العُيونُ دِماءَها","وَلِمثلِهِ حَزِنَت عَلَيهِ الأَنفُسُ",7,"س",1,0],["فلمثل ذا يبكي الحليم كآبةً","ولمثل هذا تُنشَد الأشعارُ",8,"ر",1,0]]}