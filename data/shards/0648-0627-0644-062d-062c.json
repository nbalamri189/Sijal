{"poems":[[55,"لا والذي قصد الحجيج لبيته","https://www.aldiwan.net/poem30726.html","الكامل"],[74,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[87,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[64,"تجربة المرء عن يقين","https://www.aldiwan.net/poem52144.html","مخلع البسيط"],[46,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[77,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[230,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[244,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[276,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[309,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[309,"الحمد لله الشهيد الحاضر","https://www.aldiwan.net/poem16868.html","الكامل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[435,"ما نزهة المرء إن سادت به الرتب","https://www.aldiwan.net/poem40744.html","البسيط"],[545,"والحجر والبيت والأستار حيز لكم","https://www.aldiwan.net/poem56852.html","الكامل"],[556,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[578,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138212",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126789","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48516","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62454","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25454","الرجز"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100618","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126125","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35799","الكامل"],[276,"","https://poetry.dctabudhabi.ae/diwan/poem/80491","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177829","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27898","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77345","الكامل"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130770","السريع"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144168","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94265","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140054",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87572","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112661","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138624",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199178","الرمل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199150","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216470","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95355","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125873","الكامل"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147249","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95036","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81938","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133116","البسيط"],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[6004,"قرابين العِدا","https://www.poetsgate.com/ViewPoem.aspx?id=33754",""],[6142,"ها إن أفئدة الورى لهجه","https://www.poetsgate.com/ViewPoem.aspx?id=155768",""]],"verses":[["وَالحِجرِ وَالحَجَرِ المُقَبَّلِ تَلتَقي","فيهِ الشِفاهُ وَرُكنِهِ المَحجوبِ",0,"ب",1,0],["والحجر المدنى إليه يداً","بأكرم الحالك والأصنع",1,"ع",1,0],["وَالحِجازُ النَبيلُ رَبعٌ مُصَلٍّ","مِن رُبوعِ الهُدى وَآخَرُ صائِم",2,"م",1,0],["والحجر الأصل والأداة ال","فرع وتدبيره يسيرُ",3,"ر",1,0],["وَالحَجُّ وَالغَزوُ مَقرونانِ في قَرَنٍ","فَاِذهَب فَأَنتَ زُعافُ الخَيلِ وَالإِبِلِ",4,"ل",1,0],["والحِجْرِ مُطَّلِعاً إليكَ تشَوُّقاً","والركْنِ مُهْتَزّاً إليكَ تشَوُّفا",5,"ف",2,0],["والْحُجَّةُ البَيْضاءُ أفْضَلُ مَقطَعاً","من نَصْلِ كُلِّ مُهنَّدٍ وشَبَاتِه",6,"ت",2,0],["وَالحِجازُ قِبلَتُهُم","وَالفُروضُ وَالقُرَب",7,"ب",1,0],["والحج مؤتمر التعارف والولا","للناس إن جَمَعَ الوفودَ الموسم",8,"م",1,0],["وَالحجب وَالعرش وَالكرسي بارزة","في عينه في رموز اللوح وَالقَلَم",9,"م",1,0],["والحجة الحبر الذي باهى به","أهل الرسالة خير كل مشفع",10,"ع",1,0],["وَالحجة الغَزالي أُستاذ المَلا","مُحيي عُلوم الدِين كَم مِن دائر",11,"ر",1,0],["وَالحَجُّ قَصدٌ ظاهِرٌ لِباطِنٍ","لَهُ مُعانٍ بِالرُسومِ تُعتَبَر",12,"ر",1,0],["والحَجُّ فَرضٌ مرّةً على الفتى","أن يأتيَ البَيتَ بحَمْلٍ الكُلَف",13,"ف",1,0],["وآل حجلان قد خضّبن فاعتمدوا","أسابراً تهتك المرجان بالحدقِ",14,"ق",1,0],["وَالحِجرُ وَالبَيتُ وَالأستارُ حِيزَ لَكُم","وَمَنحَرُ البُدنِ عِندَ الأَحجُرِ السودِ",15,"د",1,1],["والحِجْرُ والحَجَرُ الّذي لصفاتِهِ","أبَدَ الزّمانِ الضَّمُّ والتّقبيلُ",16,"ل",1,0],["وَالحِجرِ وَالحَجَرِ الأَحَمُّ تَأَلَقَّت","أَنوارُهُ فَأَبى الهُدى أَن تُكسَفا",17,"ف",2,0],["والحج أكبر نعمة للعبد من","مولى مواهبه بعدل واهب",18,"ب",1,0],["والحجّة الحسن الزاكي الّذي أنا في","وِداده لَم يَزَل قلبي به ولعا",19,"ع",2,0],["والحجة البيضاء في يدك التي","فتحت مجالاً للجهاد رحيبا",20,"ب",2,0],["والحج أنتَ وإنَّ فضلك عيدهم","والنحر للأموال في ثجّ وعج",21,"ج",1,0],["وَالحَجْرُ وَالصَمّانُ يَحْبُو أَوْجَمُهْ","وَلا مَعاً مُخَفِّقٌ فَعَيْهَمُهْ",22,"م",2,0],["والحجى اشرف رزق للعباد","إذ هو الراحة والمال شقا",23,"ق",2,0],["والحج والزكاة من أركانه","كالبيت لا يبنى بلا عمدانه",24,"ه",1,0],["وَالحَجَرُ وَالحَجَرُ الأَصَم","مُ بِطولِ مَسنٍ وَاِستِلامِ",25,"م",1,0],["وَالحج يقصد كل عام مرة","وَبك المضيضا كل وقت تقصد",26,"د",1,0],["والحجر والمسعى ومروة والصفا","والأبطحان وزمزم ومقام",27,"م",1,0],["والحجب ليس سوانا وهو خالقنا","ونحن مجلى له بالسمع والبصرِ",28,"ر",1,0],["وَالحَجُّ في الإِسلامِ أَكبَرُ مَعرِضٍ","وَكَفاهُ فَضلُ السَعيِ وَالجولانِ",29,"ن",1,0],["والحجر الدائر شعب خامسه","وجدول قد خصّ بالكفارسه",30,"ه",1,0],["والحجلُ في ذاك التهادي غدا","منه الفتى المعمود رهن البوار",31,"ر",1,0],["والحج أضحي طامساً ميقاته","بعد ازدحام الناس بالميقات",32,"ت",1,0],["والحُجْبُ تُرفَعُ عن أسرّة ماجدٍ","كالنّصْلِ لم يكهَمْ له غَرْبانِ",33,"ن",1,0],["والحج مبرور وطه المجتبى","يقبل شكوى من شكا الوزاره",34,"ر",2,0],["والحجر لو أن قلبي ركنه حجر","أضحى حطيماً على جدران كعبته",35,"ت",2,0],["والحجب والعرش والكرسي ما افتخرت","بمثله في بهاها في معاليها",36,"ي",3,0],["وَالحَجزُ يَجري كالكَثافة حيثما","ثِقَلُ الجسوم عَلىالكَثافة حَملهُ",37,"ل",2,0],["والحجَرُ الأسعدُ قَد أتانا","بحُجّةٍ ناصِعَة بُرهانا",38,"ن",2,0],["والحَجُّ لما خافَ من إتمامِهِ","بعُمرةٍ أحَلّ من إحرامِهِ",39,"ه",1,0],["والحجر الاسود في المحراب","شرقه صار بالاقتراب",40,"ب",1,0],["والحجر الذي عليه يرقى","الى الحجازية نعم المرقى",40,"ق",2,0],["والحجة الكبرى لدى","قوس التزل والصعود",41,"د",1,0],["وَالحَجُّ مُفتَرَضٌ عَلَيكَ وَشَرطُهُ","أَمنُ الطَريقِ وَصِحَّةُ الأَبدانِ",42,"ن",1,0],["والحجازي حسنٌ قد أرخه:","يوسف الجزار كأس قد قرش",43,"ش",1,0],["والحجازي من سمي حسنا ين","ظر ما خالف الشريعة صعبا",44,"ب",2,0],["والحجة العليا التي ما طأطأت","يومًا لمنتقم ولا لمناظر",45,"ر",1,0],["والحجب قد رفعت والبسط قد فرشت","وكم به كان ترحيب وتأهيل",46,"ل",1,0],["والحجم في المقدار مثل حجمه","فاعجب لشيءٍ نثره كنظمه",47,"ه",1,0],["والحجةَ الكبرى التي","تهْوِى على الباغي الضليل",48,"ل",1,0],["والحِجْرُ حنَّ لأدمعٍ فاضت على","خدِ الثرى متأثراً ببُكاكَ",49,"ك",1,0],["وآل حجَّةَ باتوا في لظى شجنٍ","يتلون في نوحهم سحي أماقينا",50,"ن",2,0],["والحجُّ قد تاهوا أناس به","رائحهم في أثر المفتدي",51,"د",2,0],["والحج لا تكسل وزر خير الورى","واترك ولوع الأهلِ والأوطانِ",52,"ن",1,0],["والحج فرضٌ لبيت الله محتتمٌ","إن استطعت فحج البيت واعتمر",53,"ر",1,0],["وَالحَجُّ ذَاكَ النُّسْكُ أَضْحَى صِبْغَةً","لِذَوِي الفُجُورِ كَصِبْغَةِ الحِرْبَاءِ",54,"ا",2,0],["والحج ما احتجت على متكبر","إلا وصوت خليلها بأذانه",55,"ن",2,0],["والحجرة الغراء بين ستورها","أسنى من الأقمار في هالاتها",56,"ت",3,0],["والْحَجّ ُ يَزْهُو ، عَاْمرا ً","نُوْرَ الْحَبِيبِ ، الْمُهْتَدَى",57,"د",2,0],["والحجة الكبرى ومن ختم ال","له العظيم بنوره حججه",58,"ج",2,0]]}