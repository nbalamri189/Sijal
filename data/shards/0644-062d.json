/poem/54914","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43759","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43652","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10206","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[104,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=37376",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[50,"ذكرت شبابي اللذَّ غير قريبِ","https://www.poetsgate.com/ViewPoem.aspx?id=19932",""],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""],[54,"أَيا للناسِ مِن خَبَرٍ طَريفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14500",""],[45,"لَوْ يَكُونُ الحِبَاءُ حَسْبَ الذي أنْت","https://www.poetsgate.com/ViewPoem.aspx?id=32064",""],[45,"لَيَالينا بَينَ اللّوَى، فمُحَجَّرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31220",""],[28,"ليبك على الحجاج من كان باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=16991",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[39,"لَحَى اللَّهُ قَوْماً أَسْلَمُوا يَوْمَ بَابِلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=4265",""],[29,"خَليليَّ قوما للرَّحيلِ، فإنّني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17434&r=&rc=7",""],[31,"مُنِعْتُ النَّوْمَ بِالسَّهَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18837&r=&rc=100",""],[88,"أرى عيشنا تأبى المنون امتداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19566&r=&rc=69",""]],"verses":[["لَحا اللَهُ دَهراً خانَني فيهِ أَهلُهُ","وَأَحشَمَني حَتّى اِحتَشَمتُ الأَدانِيا",0,"ي",2,0],["لَحَّبوا المَجدَ وَاِبتَنَوا","في المَعالي مَبانِيا",1,"ي",2,0],["لَحِقنَ طَريدَةً لَولا قَناها","لَطالَ رَواغُها لِلطارِدينا",2,"ن",2,0],["لَحَماني أَغَرُّ شيمَتُهُ الكَر","رُ وَنَصلٌ حَلِيُّهُ الإِحرامُ",3,"م",1,0],["لَحَبَّ إِلَيَّ بِالدَهناءِ مَلقىً","لِأَيدي العيسِ واضِعَةَ الرِحالِ",4,"ل",1,1],["لَحا اللَهُ هَذا الدَهرُ سَيفاً عَلى المُنى","أُوَصِّلُ آرابي بِها وَيُقَطِّعُ",5,"ع",1,0],["لَحا اللَهُ هَذا الدَهرَ ماذا جَرَتِ بِهِ","نَوائِبُهُ مِن مُؤلِمِ الوَقعِ مُظلِعِ",6,"ع",1,0],["لَحى اللَهُ اِمرَأً يَنضو حُساماً","فَيَجبُنُ وَهوَ مَلآنُ الضَميرِ",7,"ر",1,0],["لَحى اللَهُ دَهراً كَثيرَ العَدُوِّ","حَتّى الظَلامُ يُعادي النَهارا",8,"ر",2,0],["لِحَيٍّ عَلى الجَرعاءِ أَلأَمِ رِحلَةٍ","إِذا ظَعَنوا ساقوا العُيوبَ وَقادوا",9,"د",3,0],["لَحَيّا عَهدَهُنَّ حَيا العِهادِ","نَدىً يَغتَصُّ مِنهُ كُلُّ نادِ",10,"د",1,1],["لَحَقَّقتِ عِندي أَنَّ كُلٌّ صَبيحَةٍ","مُجاجَةُ سُمٍّ وَاللَيالي أَساوِدُ",11,"د",1,0],["لَحِقتُ أَبي نِزاعاً في المَعالي","وَعِرقاً في الشَجاعَةِ وَالسَماحِ",12,"ح",1,0],["لَحا اللَهُ دَهراً أَرانا الدِيا","رَ يَندُبُ فيها البَعيدَ القَريبُ",13,"ب",1,0],["لَحَيّاكَ مِنِّيَ عِندَ اللِقا","ءِ خَلقٌ عَجيبٌ وَخُلقٌ أَديبُ",13,"ب",1,0],["لِحاظٌ كَما شَقَّ العَجاجَ مُهَنَّدٌ","وَوَجهٌ كَما جَلّى الظَلامَ شِهابُ",14,"ب",1,0],["لَحاني هُذَيمٌ صاحبي لَيلَةَ النَّقا","عَلى شَيْمِ بَرقٍ شاقَني وَشَجاني",15,"ن",2,1],["لَحَى اللهُ مَنْ يَرْنُو إِلى أَمَدِ العُلا","بِعَيْنٍ مَتى تَلْحَظْ شَبا السَّيْفِ تَشْخَصِ",16,"ص",1,1],["لَحَى اللهُ دَهراً لا نَزالُ دَريئَةً","لِضَرَّاء يَرْمِينا بِها فَيُصِيبُ",17,"ب",1,1],["لَحاني على تَرْكِ الغِنى ومُعَرَّسي","جَديبٌ وجاري ضارِعُ الخَدِّ بائِسُ",18,"س",1,0],["لَحِقْتُ بِها شأْوَ المُجيدينَ قَبْلَها","وهَيْهاتَ أن يُؤْتَى بأمثالِها بَعْدي",19,"د",2,0],["لَحوني في القَريضِ فَقُلتُ أَلهو","وَما مِنّي الهِجاءُ وَلا المَديحُ",20,"ح",1,0],["لَحافِظٌ ما كانَ مِن عَهدِها","أَصدُقُها في كُلِّ حالاتي",21,"ت",2,0],["لَحاني فَلَمّا شامَ بَرقي وَأَمطَرَت","جُفوني بَكى لي موجَعاً لِكُروبي",22,"ب",2,0],["لَحا اللهُ أجْفانَ الغَواني فإنّها","تسوقُ الهَوى للقَلْبِ منْ حيثُ لا يَدْري",23,"ي",1,0],["لَحى اللَهُ مَولى السوءِ لا أَنتَ راغِبٌ","إِلَيهِ وَلا رامٍ بِهِ مَن تُحارِبُه",24,"ب",2,1],["لَحى اللَهُ عَهدَ القاسِطينَ الَّذي بِهِ","تَهَدَّمَ مِن بُنيانِنا ما تَهَدَّما",25,"م",2,0],["لِحىً بَيضاءُ يَومَ الرَأيِ هانَت","عَلى حُمرِ المَلابِسِ وَالخُدودِ",26,"د",1,0],["لَحِيٍّ لَقاحٍ تَأنَفُ الضَيمَ مِنهُمُ","جَحاجِحَةٌ شيبٌ وَصُيّابَةٌ مُردُ",27,"د",1,0],["لَحا اللَهُ يَوماً لَستُ فيهِ بِمُلتَقِ","مُحَيّاكِ مِن أَجلِ النَوى وَالتَفَرُّقِ",28,"ق",1,1],["لَحى اللَهُ أَدنانا إِلى اللُؤمِ زُلفَةً","وَأَعجَزَنا خالاً وَأَلأَمَنا أَبا",29,"ب",2,0],["لَحِقْتَ بِرَهْطِكَ الأَخْيَارُ تَثْوِي","كَمَثْوَاهُمْ مِنَ الْبَلَدِ الْيَبَابِ",30,"ب",1,0],["لحفاوة بمجشمٍ عن قومه","هجروا ولم يك روحه بالهاجر",31,"ر",1,0],["لَحِقَ اليَوْمَ بِالرِّفَاقِ أَمِينُ","كَيْفَ يَسْلُو هَذَا الفُؤَادُ الحَزِينُ",32,"ن",1,1],["لَحَى اللهُ الَّذِينَ بِهِمْ وَثَقْنَا","فَأَلْفَيْنَا وَفَيَّهُمُ يَخُونُ",33,"ن",1,0],["لِحَاظُهَا تَرْمِي سِهَامَ الْهَوَى","وَوَجْهُهَا يَنْشُرُ آيَ السَّلامْ",34,"م",1,0],["لِحَادِثَاتِ اللَّيَالِي فِي أَنَامِلِهِ","يَرَاعَةٌ وَلأَحْكَامِ القَضَاءِ فَمُ",35,"م",1,0],["لِحُسَامِ جَدِّكَ حِينَ أَسَّسَ مُلكَهُ","عَنَتِ الرِّقَابُ وَدَانَ كُلُّ حُسَامِ",36,"م",1,0],["لَحَى اللهُ المَطَامِعَ حَيْثُ حَلَّتْ","فِتِلْكَ أشَدُّ آفَاتِ السَّلامِ",37,"م",1,0],["لَحَفنَ الحَصى أَنيارَهُ ثُمَّ خُضنَهُ","نُهوضَ الهِجانِ الموعِثاتِ الجَواشِمِ",38,"م",1,0],["لَحِقنا فَراجَعنا الحُمولَ وَإِنَّما","يُتَلّي ذُباباتِ الوَداعِ المُراجِعُ",39,"ع",1,0],["لحا الله ديناً كل يوم بأهلها","تهدّ حصون أو تثلّ عروش",40,"ش",1,0],["لحى الله بأساء الحياة كأننا","نكبّل من حاجاتها بالأداهم",41,"م",1,0],["لَحِقتُ وَأَصحابي عَلى كُلِّ حُرَّةٍ","وَخودٍ تَبارى الأَحبَشِيَّ المَكارِيا",42,"ي",2,0],["لَحى اللَهُ الفَرَزدَقَ حينَ يُمسي","مُضيعاً لِلمُفَصَّلِ وَالمَثاني",43,"ي",1,0],["لَحَفَ الدَخيلُ قَطائِفاً وَمَطارِفاً","وَقَرى السَديفَ عَشِيَّةَ العُرواءِ",44,"ا",2,0],["لَحُقَّ لِقَيسٍ أَن يُباحَ لَهُ الحِمى","وَأَن تُعقَرَ الوَجناءُ إِن خَفَّ زادُها",45,"د",3,0],["لَحُبِّ الوافِدانِ إِلَيَّ موسى","وَجَعدَةُ لَو أَضاءَهُما الوُقودُ",46,"د",1,0],["لَحى اللَهُ ماءً مِن عُروقٍ خَبيثَةٍ","سَقَت سابِياءً جاءَ فيها مُخَمَّرا",47,"ر",2,0],["لَحَصادُ بارِقَ كانَ أَهوَنَ ضَيعَةً","وَالمِخلَبانِ وَدونَكَ المَنحورُ",48,"ر",1,0],["لَحِقنا بِأَبجَرَ وَالحَوفَزانِ","وَقَد مَدَّتِ الخَيلُ إِعصارَها",49,"ر",3,0],["لَحَمى فَوارِسُ يَحسِرونَ دُروعَهُم","خَلفَ المَرافِقَ حينَ تَدمى الأَذرُعُ",50,"ع",1,0],["لَحى اللَهُ مَن يَنبو الحُسامُ بِكَفِّهِ","وَمَن يَلِجُ الماخورَ في الحِجلِ يَرسُفُ",51,"ف",1,0],["لُحقُ التَوالي بِأَيديها إِذا اِندَفَعَت","أَعناقُهُنَّ بِسَومٍ فيهِ تَبغيلُ",52,"ل",1,0],["لَحَماكَ كُلُّ مُغاوِرٍ يَومَ الوَغى","وَلَكانَ شِلوُ عَدُوِّكَ المَأكولا",53,"ل",2,0],["لَحَبَّ بِنارٍ أوقِدَت بَينَ مُحلِبٍ","وَفَردَةَ لَو يَدنو مِنَ الحَبلِ واصِلُه",54,"ل",2,0],["لَحا اللَهُ هَذا الدَهرَ إِنّي رَأَيتُهُ","بَصيراً بِما ساءَ اِبنَ آدَمَ مولَعا",55,"ع",2,0],["لَحى اللَهُ صُعلوكاً مُناهُ وَهَمُّهُ","مِنَ العَيشِ أَن يَلقى لَبوساً وَمَطعَما",56,"م",2,0],["لِحُبِّكَ مِن قَلبي حِمىً لا يَحُلُّهُ","سِواكَ وَعَقدٌ لَيسَ خَلقٌ يَحُلُّهُ",57,"ل",2,1],["لَحى اللَهُ قَلباً لايَهيمُ صَبابَةً","إِلَيكَ وَعَيناً لاتَفيضُ دُموعُها",58,"ع",3,0],["لَحِقَ العودَ ناعِماً فَثَناهُ","وَهوَ صَعبٌ عَلى سِواهُ عَسيرُ",59,"ر",1,0],["لَحى اللَهُ مَن يَرعاكَ في القُربِ وَحدَهُ","وَمَن لايَحوطُ الغَيبَ حينَ تَغيبُ",60,"ب",1,0],["لَحا اللَهُ لِحياناً فَلَيسَت دِمائُهُم","لَنا مِن قَتيلي غَدرَةٍ بِوَفاءِ",61,"ا",2,1],["لَحا اللَهُ قَوماً لَم نَدَع مِن سَراتِهِم","لَهُم أَحَداً يَندوهُمُ غَيرَ ناقِبِ",62,"ب",1,1],["لحى الله دنيا لا تكون مطيَّةً","إلى دَرَكِ الأخرى تزَمُّ وتركب",63,"ب",1,0],["لحمزة جماعِ المحامدِ أنعمٌ","تشرّق في طلابها وتغرب",64,"ب",1,0],["لحاكَ الله يا مولايَ كم ذا","تصبّ من الأذى قبلِي وصَوبي",65,"ي",1,1],["لحاني فأجرَيت المدامعَ أنهراً","فقلتُ له دعهم يخوضوا ويلعبوا",66,"ب",3,0],["لحمي وعظمي على نعماه قد نبتا","كلّ النبات ولا كلت ولا نبتِ",67,"ت",1,0],["لحى الله ألاَّفاً بما يصنعونه","من الماءِ صرفاً فعل من لا يناصح",68,"ح",1,1],["لحظك في الفتكِ هو البَادي","يا فتنة الحاضر والبادي",69,"ي",1,1],["لحى الله الوشاة فإن تدانو","ولحّ الظبي عنَّا في النفور",70,"ر",1,0],["لحملة الحرب أو حمل الندى خلقت","فليس تنفكّ من شكرٍ لما حملت",71,"ت",1,0],["لحماك يا ابن المالكين ترقبت","فكَر الرَّجا رقبى العيون هلالها",72,"ل",3,0],["لحيته قطَّعت ذقنه","قلتُ من الأذن إلى الأذن",73,"ن",1,0],["لَحظاتُ أجفانِ الحبيبْ","رُسُل القلوب إلى القلوبْ",74,"ب",1,1],["لحظاتُهنَّ إذا رنونَ إلى الفتى","بلوى ولكنْ ريقُهنَّ غياثُ",75,"ث",1,0],["لحقوا بالكواكب الزُّهْرِ والعَي","يُوقُ نائي المَنالِ منْ هَبُّودِ",76,"د",1,0],["لحيةٌ أُهمِلتْ فسالت وفاضتْ","فإليها تُشير كفُّ المشيرِ",77,"ر",1,0],["لحيته في وجهه بظرُ","وأنفه في وجهه قبرُ",78,"ر",1,1],["لَحَقَقْنَ أن يُورِقن من ذاك النَدى","أو يحترقن بذلك المِقباس",79,"س",1,0],["لحاجتي إن بعثتها ليَ في","إسكاف والدير وجه متَّفق",80,"ق",1,0],["لحيتَ ليَ الزمانَ وأنت عُطلٌ","وضافرت الزمان وأنت والي",81,"ي",1,0],["لحوقٌ إذا خاضَ العجاجة شقَّها","فلا الشأو مقصورٌ ولا الوجه أقتمُ",82,"م",1,0],["لحا اللَّهُ هاتيكَ الهمومَ فإنها","همومُ ربيباتِ الحجالِ النواعِمِ",83,"م",1,0],["لَحقيقٌ بأنْ يُرَى","جَعرُهُ في تَكَلُّمِهْ",84,"م",2,0],["لِحَيٍّ جِياعٍ أَو لِضَيفٍ مُحَوَّلٍ","أُبادِرُ ذِكرا أَن يُلَجَّ بِهِ قَبلي",85,"ي",1,0],["لَحى اللَهُ صِرماً مِن كُلَيبٍ كَأَنَّهُم","جِداءُ حِجازٍ لاجِئاتٌ إِلى زَربِ",86,"ب",1,0],["لَحى اللَهُ أَرماكاً بِدِجلَةَ لا تَقي","أَذاةَ اِمرِئٍ عَضبِ اللِسانِ شَغوبِ",87,"ب",1,0],["لَحى اللَهُ قَيساً حينَ فَرَّت رِجالُها","عَنِ النَصَفِ السَوداءِ وَالكاعِبِ البِكرِ",88,"ر",1,0],["لَحُزتُ سَوادَها بِالسَيفِ حَتّى","تَفادى الكومُ عَن ذَكَرٍ حُسامِ",89,"م",1,0],["لَحى اللَهُ دَهراً ذَعذَعَ المالَ كُلَّهُ","وَسَوَّدَ أَشباهَ الإِماءِ العَوارِكِ",90,"ك",1,1],["لَحظَةٌ ثُمَّ صارَ ضِحكي وَجيبا","وَنَشيجا وَالنَومُ صارَ سُهادا",91,"ا",1,0],["لَحى اللَهُ صُعلوكاً إِذا جَ