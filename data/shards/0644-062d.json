207,"ب",1,0],["لحظةً يشتكي المتيمُ فيها","لوعةَ البينِ أو يبثُّ حنينه",208,"ن",2,0],["لَحا اللَهُ مَن لا يَنفَعُ الوَعدُ عِندَهُ","وَمَن حَبلَهُ إِن مُدَّ غَيرُ مَتينِ",209,"ن",1,0],["لحومهما الأعناب والرطب الذي","هو الحل، والدر الرحيق المسلسل",210,"ل",1,0],["لحكمةٍ يعلمها تعالى","يملا من أسرارها الأفعالا",211,"ل",2,0],["لَحى اللَهُ أَقواماً يَقولونَ إِنَّنا","وَجَدنا طَوالَ الدَهرِ لِلحُبِّ شافِيا",212,"ي",2,0],["لُحْ في السَّماءِ وغنِّ","أبناء الشَّقاوَةِ والخُطوب",213,"ب",1,0],["لحى اللهُ قوماً لم يُبالوا بأَسْهُمٍ","يُصوِّبها نحو الدِّيانَةِ ظَالِمُ",214,"م",1,0],["لَحى اللَهُ الفِراقَ وَلا رَعاهُ","فَكَم قَد شَكَّ قَلبي بِالنِبالِ",215,"ل",1,0],["لَحْدُ ذَاكَ الفَقِيدِ إِنْ ضَنَّتِ","السُّحْبُ سَقَتْهُ سُحْبٌ مِنَ الآمَاقِ",216,"ق",1,0],["لَحِقَ اليَوْمَ حَافِظٌ بِالمُجَلِّي","ينَ وَمَا كَانَ آخِراً فِي الطِّرَاد",217,"د",1,0],["لِحِكْمَةٍ شاءَهَا أَحَلَّ لَهُمُ","شُرْبَ الطَّلَى مِنْ نَهَى عَنْ السُّكْرِ",218,"ر",1,0],["لَحْظَةٌ فِيها اسْتبَانَتْ هَوْلَ مَا","إِثْمُهَا أَمْسِ عَلَيْهَا الْيَوْمَ جَرَّا",219,"ر",2,0],["لَحِقتَ بِمَنْ أَرَّخْتَهُمْ فكَأَنَّهُمْ","لِدَاتٌ لِعَهْدٍ لَمْ تُفَرِّقْهُ أَدهُرُ",220,"ر",1,0],["لَحْظُهَا خَاشِعُ الشُّعَاعِ وَتَدْعُو","هُ إِلَى الْكِبَرِ عِزَّةٌ بِالنُّهُودِ",221,"د",1,0],["لَحَظَ الرِّمَالَ القَاحِلاَتِ فَنُضِّرَتْ","وَازَّيَّنَتْ بِمَغَارِسٍ وَمَزَارِعِ",222,"ع",1,0],["لَحَظَ المَدَائِنَ وَالقُرَى فَتَجَمَّلَتْ","وَتَكَمَّلَتْ بِمَدَارِسٍ وَمَصَانعِ",222,"ع",1,0],["لَحَظَ الثَّقَافَةَ لِلعُقُولِ فَأَخْرَجَتْ","مَا طابَ مِنْ ثَمَرِ العُقْولِ اليَانعِ",222,"ع",1,0],["لحَظَ الرِّيَاضَةَ لِلجُسُومِ فَهَيَّأَتْ","نَشْئاً جَدِيدَاً عَزَائِمٍ وَنَوَازِعِ",222,"ع",1,0],["لَحَظَ العُلُومَ فَمَا تَرَى فِي رَوْضِةٍ","إِلاَّ ظِمَاءَ الطَّيْرِ حَوْلَ مَشَارِعِ",222,"ع",1,0],["لحَظَ الفُنُونَ فَعَادَ مُؤْتَنَفاً بِهَا","مَا كَانَ مِنْ فَضْلٍ قَدِيمٍ بَارعِ",222,"ع",1,0],["لِحَفَاوَةٍ بِمُجَشَّمٍ عَنْ قَوْمهِ","هَجْراً وَلَمْ يَكُ روحُهُ بِالهَجِرِ",223,"ر",1,0],["لَحا اللَهُ دَهراً لا يَزالُ يَمينُ","وَيَنقُضُ عَهداً أَكَّدَتهُ يَمينُ",224,"ن",1,1],["لَحى في البُكا لاحٍ فَقالوا أَلا هُدى","فَقُلتُ وَأسبَلتُ الدُموعَ أَلا اِنبذا",225,"ذ",2,0],["لَحا اللَهُ الزَمانَ أَباً","أسودُ بَنيهِ أَثخَنَها",226,"ن",3,0],["لَحا اللَهُ دَهراً حالَ بَيني وَبَينَكُم","وَحَرَّمَ وَصلَ الحُبِّ وَهوَ مُحَلَّلُ",227,"ل",1,1],["لَحَظوكَ أَوَّلَ لَحظَةٍ فَاِستَصغَروا","مَن كانَ يُعظَمُ فيهِمِ وَيُبَجَّلُ",228,"ل",1,0],["لَحى اللَهُ المَعاشَ بِفَرجِ أُنثى","وَلَو زَوَّجتَها مِن ذي رُعَينِ",229,"ن",1,0],["لُحْتَ فيهم فأدْرَكُوا صَوْلَةَ الشَّرْ","قِ ومَرَّتْ بِذِكْرِهم أَنْبِياؤه",230,"ا",3,0],["لحا الله قوماً صوّروا شرعة الهدى","أذاناً ببغضاء.. وحجّاً إلى الشرِّ",231,"ر",1,0],["لحا الله دنيا يصبحُ المرءُ آمنًا","أَذاها، ويُمسي في الضريح مُوسَّدا",232,"د",2,0],["لحُكمك هم أعلَنوا كارهين","ولو قدرُوا ناصَبُوك العداء",233,"ا",2,0],["لحا الله فزراً ما أظلَّ مكانهُ","وأعْجَبَهُ قَدْ فَاقَ كُلَّ عَجيب",234,"ب",1,0],["لحفظ \" الأنانياتِ \" سُنَّتْ مناهجٌ","على الخلق صَبَّتْ محنةً ومصائبا",235,"ب",2,0],["لحظ الحبيب أثار بين","النوم واللحظ الفتن",236,"ن",1,0],["لحقت فلسطينٌ بأندلسٍ اسىً","والشامُ ساوت مصرَها وعراقها",237,"ق",3,0],["لَحَا اللّهُ المَعاشَ بِفَرْجِ أُنثَى","ولو زوجتها منْ ذي رعينِ",238,"ن",1,0],["لَحَبَيْتُ اللّجَينَ والدُّرَّ واليَا","قُوتَ حَثْواً، وَكَانَ ذاكَ يَقِلّ",239,"ل",1,0],["لِحًى نُتِفَتْ، حتّى أُطيرَتْ سِبَالُهَا،","وأقفاءُ مَصْفُوعينَ في كلّ مَحضَرِ",240,"ر",1,0],["لحَزْمٍ وَلا تَنكِيلِ عِفْرِيتِ فِتْنَةٍ،","إذا اكتَحَلَتْ أنيابُ جَرْباءَ شارِفِ",241,"ف",1,0],["لِحَيِّ حَلالٍ يَعْصِمُ النَّاسَ أَمْرَهُمْ","إِذَا طَرَقَتْ إِحْدَى اللَّيَالِي بِمُعْظَمِ",242,"م",1,0],["لَحِقّ مولاهُ وأجنبيِّه","ما شئتَ من مرأى ومن حَبيِّه",243,"ب",3,0],["لَحانَ لما غرستُ لديك حَمْلٌ","وآن لما زرعتُ هناك حصْدُ",244,"د",1,0],["لَحَى اللَّهُ قَوْماً أَسْلَمُوا يَوْمَ بَابِلٍ","أَبَا خَالِدٍ تَحْتَ السُّيُوفِ البَوَارِقِ",245,"ق",1,1],["لحى اللَّهُ أرْماكاً بدِجْلَة ، لا تقي","أذاة َ امرِىء عَضْبِ اللّسانِ شَغوبِ",246,"ب",1,0],["لحبٍّ داخلٍ في الجوفِ،","فِ ذي قَرْحٍ عَلَى كَبِدي",247,"د",2,0],["لحا الله دنيا كل يوم بأهلها","تهدّ حصون اوتثل عروش",248,"ش",1,0]]}