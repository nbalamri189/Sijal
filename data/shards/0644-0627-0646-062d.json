{"poems":[[102,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[88,"إن كنتم تبذلون المال عن رهب","https://www.aldiwan.net/poem10919.html","البسيط"],[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[87,"يا رب ما حكمك ماذا ترى","https://www.aldiwan.net/poem8095.html","السريع"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[107,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[50,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[78,"يا هلالا في تجنيه","https://www.aldiwan.net/poem38858.html","مخلع البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140982",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[102,"زامر القفر العامر","https://www.poetsgate.com/ViewPoem.aspx?id=50393",""],[87,"يا ربِّ، ما حكمكَ؟ ماذا ترى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9649&r=&rc=139",""],[151,"يا عاذرا لامرئ قد هام في الحضر","https://www.aldiwan.net/poem47689.html","البسيط"],[385,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[505,"أمن النجوم إذا تحول سجفها","https://www.aldiwan.net/poem37983.html","الكامل"],[520,"لم يبق لابن دخان عند خالقه","https://www.aldiwan.net/poem12230.html","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48933","السريع"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26678","البسيط"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67382","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147326","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94663","البسيط"],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[5136,"نسيم بارد رطب","https://www.poetsgate.com/ViewPoem.aspx?id=121500",""],[5232,"ألحان السَّلام","https://www.poetsgate.com/ViewPoem.aspx?id=213566",""],[5956,"سُوَرُ الغَزَل ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182264",""],[5956,"الأديان والمذاهب والطوائف","https://www.poetsgate.com/ViewPoem.aspx?id=192181",""],[6070,"تَريَّثْ باستِماعِكَ للحديثِ","https://www.poetsgate.com/ViewPoem.aspx?id=192164",""],[520,"لم يبق لابن دخان عند خالقه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577626",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6259,"عصرت معدا معك الأناة ُ المعصرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59379&r=&rc=27",""],[6314,"الدرب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88074&r=&rc=9",""]],"verses":[["لأن حنايا والدي من خرائبٍ","فمن ما به أعطاكِ هذا وأسبغا؟",0,"غ",2,0],["لا نَحنُ مَوتى وَلا الأَحياءُ تُشبِهُنا","كَأَنَّنا فيكِ لَم نَشهَد وَلَم نَغِبِ",1,"ب",1,0],["لا نَحْفَلُ الدُّنيا تدور","بأَهلها أَو لا تَدورْ",2,"ر",1,0],["لا نَحنُ جِرمانُ لَنا حِصَّةٌ","وَلا بِرومانَ فَنُعطى فَتيل",3,"ل",1,0],["لِأَنَّ حِلمَكَ حِلمٌ لا تَكَلَّفُهُ","لَيسَ التَكَحُّلُ في العَينَينِ كَالكَحَلِ",4,"ل",1,0],["لا نُحِبُّ العَطاءَ نَمتاحُهُ مِن","كُم وَلا نَبتَغي لَدَيكُم نَوالا",5,"ل",2,0],["لِأَنَّ حُبَّكِ حُبٌّ","في القَلبِ مِنّي دَخيلُ",6,"ل",1,0],["لانَ حتى لو مَشى الذَّرْ","رُ عليهِ كادَ يُدْميهِ",7,"ي",2,0],["لأن حلمك حلمٌ لا تكلّفه","ليس التحكّل في العينين كالكحل",8,"ل",1,0],["لانَ حتَّى وَجَدَ اللِّينَ بِهِمْ","فجَفا ثُمَّ عَتا ثُمَّ اقْمَطرَّا",9,"ر",2,0],["لان حروفك عشبيّة","كعينيك يا بنّي الاهتمام",10,"م",1,0],["لا نحنُ جرمانُ لنا حصَّة ٌ","ولا برومانَ فتعطى فتيل",11,"ل",1,0],["لا نحمل الضيم ممن جار نتركه","وأرضه وجيمع العزّ في السفر",12,"ر",1,0],["لِأَن حالَت بِكَ الأَيّام عَني","فَإِني عَن وِدادَك لا أَحولُ",13,"ل",1,0],["لا نحنُ قومٌ عندنا بِفُهومِنا","ما كانَ من غيرِ المُهَيْمِنِ ساقِطُ",14,"ط",1,0],["لأن حوصلة الملعون لو فتحت","لأغنت الناس في مصر حواصلها",15,"ل",3,0],["لأَن حُسادي إِلَيها دَبوا","وَالمال عندَ الفُقَراء ذَنب",16,"ب",1,0],["لا نحن في الليل فنرضى الكَرى","ولا من الصّبح منُصُل",17,"ل",1,0],["لا نحسنُ الظنَّ إشفاقاً وقد ضمنت","لنا مساعيك أن يعنو لك القدر",18,"ر",1,0],["لانَّ حُضَيْناً قَامَ فِينَا بِخطْبَةٍ","مِنَ الحَقّ فِيهَا مِيتَةٌ لِلتَّجبَّرِ",19,"ر",1,0],["لأَنَّ حِبْرِيَ بِالفَرْدَوسِ مُنْدَلِقٌ","وَإِصْبُعُ الخُلْدِ مَعْجُونٌ بِعَسْجَدَتِي",20,"ت",2,0],["لأن حفظ الولا في خُلقكم سُننٌ","وعند هذا الفتى أضغاث أحلامِ",21,"م",1,0],["لأَنَّ حَمَاْةَ كَشَيْخِ الشُّيُوْخِ","تُدَرِّسُ تَاْرِيْخَنَا الْمُعْتَبَرْ",22,"ر",1,0],["لأن حجبتك عن عيني","سمر الخط والقضب",23,"ب",1,0],["لا نحبُّ الأرضَ كفرا ًحَرُبها","لا نريدُ الحقدَ ثأرا ً وانتقامْ",24,"م",1,0],["لأن حبي قويٌّ تلك عافيتي","قويّةٌ ومروءاتي وإخباتي",25,"ت",2,0],["لأن حبي قويٌّ تلك قافيتي","قويّةٌ وتراكيبي وأبياتي",25,"ت",2,0],["لا نحب الدين يبقى واحداً","أروع الأنباء تنويع النَّبا",26,"ب",2,0],["لأنَّ حماقَةَ المعتوهِ درسٌ","يعلمنا الخَذولَ مِنَ المُغيثِ",27,"ث",1,0],["لأن حوصلة الملعون لو فتحت","لا عيت الناس في مصرٍ حواصلها",28,"ل",3,0],["لأن حبيبتي غابت","ولم يُسمع لها صيحُ",29,"ح",1,0],["لا نحلها فلكلّ لومِ موضعٌ","والعرف في بعض المواضع ينكر",30,"ر",1,0],["لأن حكايات المحبة كذبةٌ","لأن خيانات الحبيب هي الأصلُ",31,"ل",1,0]]}