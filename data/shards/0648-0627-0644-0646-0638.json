{"poems":[[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[409,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[409,"أترى يعود من الحمى قلبي","https://www.aldiwan.net/poem34152.html","الكامل"],[463,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[500,"الشعر أصعب مذهبا ومصاعدا","https://www.aldiwan.net/poem10258.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87151","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137854",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48941","المنسرح"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124092","الكامل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[5039,"نجد واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=48112",""],[5039,"عفرى","https://www.poetsgate.com/ViewPoem.aspx?id=48141",""],[5508,"يا سيّدي قد رمُيتُ من زمني","https://www.poetsgate.com/ViewPoem.aspx?id=110835",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""]],"verses":[["وَالنَظمُ في سِلكٍ يُزَيَّنُ نَحرَها","ذَهَبٌ تَوَقَّدُ كَالشِهابِ الموقَدِ",0,"د",1,0],["والنظرةُ البَهْمَاءُ أفتكُ بالفتى","من كلِّ واضحةِ المرام وَقاح",1,"ح",1,0],["والنظم مفتقر إلى توضيحه","نثراً ففيه فوائد وفرائد",2,"د",1,0],["والنظم إن أجرى البراع به","أنساك لطف رقائق الهبي",3,"ب",2,0],["والنظرةُ الخُلسةُ والقُبلة لا","تدرِي وراء الشفَتين ما بَطَنْ",4,"ن",1,0],["والنظمُ بحرٌ والخواطرُ معبرٌ","فانظر إلى بحرِ القريض وفلكهِ",5,"ك",2,0],["وَالنَظم قَد أَوقفته لَك خدمة","لَم أَقض في الشكر الفَرائض وَالسِنَن",6,"ن",1,0],["والنظم من سبب التفرق قد بكى","وارتجت الاوتاد في ابياته",7,"ت",2,0],["والنظم بيتُ الشعر يألفُه","وكم عداه وحلَّ في النثر",8,"ر",1,0],["والنظرُ العمدُ حرامٌ إلى","حرمةِ بيتٍ أو إلى سترِ",9,"ر",1,0],["وَالنَّظمُ يَمنَعُنِي مِنَ استِيفَائِهَا","وَسَياقَةُ الألفَاظِ بالميزَانِ",10,"ن",1,0],["والنظم ضاق ببعضهم فحذفته","ولربما حذف الذي لم يجهل",11,"ل",1,0],["والنظرى ما احتاج للتأمّل","وعكسه هو الضروريّ الجلى",12,"ل",2,0],["وَالنَظم وَالنَثر وَالآيات بينة","ملءُ المَسامع في تَرتيب مَدحهم",13,"م",1,0],["وَالنَّظْمُ بَابٌ لِلرَّشَادَةِ مُفْرَعٌ","لِذَوِي القُلُوبِ وَمُحْسِنِي الإصْغَاءِ",14,"ا",2,0],["والنظره اللي تنكسر من خجلها","ماهيب لعيوني ابد سلم ٍ وكار",15,"ر",1,0],["والنظره اللي راح فيها قبايل","هذا وهي طرقة غطاها ثقيله",16,"ل",2,0],["والنظم والنثرُ قد أجدتهما","فيك فلا تتركِ الإجادةَ لي",17,"ل",2,0],["والنظا والخيل من ربع الجنوب","في ربا هضبة عنازه مشرفات",18,"ت",1,0],["والنظم أعيته التي سلفت","فنمت على آثارها جُزُلُ",19,"ل",1,0]]}