{"poems":[[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[309,"ما للفؤاد يفيض بالأكدار","https://www.aldiwan.net/poem16809.html","الكامل"],[445,"اليوم نادتك السيادة هيت لك","https://www.aldiwan.net/poem34848.html","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39012","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59691","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119964","الكامل"],[1893,"","https://poetry.dctabudhabi.ae/diwan/poem/146602","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65225","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112306","الطويل"],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[5829,"بوح الظمآن","https://www.poetsgate.com/ViewPoem.aspx?id=179846",""]],"verses":[["ولمقصدٍ قمراً تكون مقهقرا","في عين ناظره الأمام مؤمّما",0,"م",2,0],["ولمقلة عبراً تفيض دموعها","سحا كفيض الوابل المدرار",1,"ر",1,0],["ولِمُقْحِمٍ عينَيْكَ فِي رَهَجِ الوغى","خيلاً تَغصُّ بِهِنَّ أَقطارُ الفَلَكْ",2,"ك",1,0],["ولِمْ قَبَضَ النَّيْلَوْفَرُ الكفَّ خائِفاً","ولِمْ بَسَطَ السُّوْسانُ يُمناهُ راجِيا",3,"ي",2,0],["ولمْ قطرتْ أجفانُ مقلته دَمَا","وقفنا به رَبعاً شجتنا طلولُه",4,"ه",1,0],["ولمقلتي في روضتي","وجناته مرعى ومسرح",5,"ح",1,0],["ولمقلتيك ضمانة","ولظرف قامتك الرشيقه",6,"ق",2,0],["ولمقلة سفحت محاجرها دمي","لدُمىً تَضَمَنهُنَّ سفح مُحَجَّر",7,"ر",1,0],["ولمقلتيه من السّهام خزائنٌ","عجبا لها نفذت وليست تنفدُ",8,"د",1,0],["ولِم قَد مُنِعنَا عن تواصلها لِما","فيا ليتَ شعري هل عوالمُها كما",9,"م",2,0],["ولم قيدها بكل شروطها","كما قاله الأعلام من كل مهتد",10,"د",1,0],["ولمقلة نجلاءَ أردت خافقي","فلعلها تنهي الخصام وتحْسِمُ",11,"م",1,0]]}