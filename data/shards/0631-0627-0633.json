{"poems":[[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[93,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[54,"رأس ابن بنت محمد ووصيه","https://www.aldiwan.net/poem27392.html","الكامل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[23,"صلى الإله على الذين تتابعوا","https://www.aldiwan.net/poem21339.html","الكامل"],[72,"يا سيدا لا زال ممتحنا","https://www.aldiwan.net/poem20015.html","المنسرح"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"قولا لطوط أبي علي","https://www.aldiwan.net/poem66064.html","مخلع البسيط"],[89,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[85,"رأس من الثوم","https://www.aldiwan.net/poem6945.html","عموديه"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[69,"هويت أعرابية ريقها","https://www.aldiwan.net/poem28216.html","السريع"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[39,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[46,"لا تأنفن من احترافك طالبا","https://www.aldiwan.net/poem22704.html","الكامل"],[46,"حمى ثلاث في حميا علة","https://www.aldiwan.net/poem22841.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55092","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[100,"التاريخ السري .. للجدار العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=50343",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[51,"رأس أبي حفصٍ عظيم المَنْفعهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29551",""],[125,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[136,"نسمات رأس البر ما أشهاك","https://www.aldiwan.net/poem49120.html","الكامل"],[144,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[144,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[165,"يا سائلا عما يذكر في الفتى","https://www.aldiwan.net/poem67808.html","الكامل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[236,"مالك يا خدن السماح والباس","https://www.aldiwan.net/poem31592.html","الرجز"],[238,"فرجت من همي ومن بوسي","https://www.aldiwan.net/poem19716.html","الكامل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[372,"يا ابن إبراهيم نادرة","https://www.aldiwan.net/poem57248.html","المديد"],[378,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[394,"راسلت من أهواه أطلب زورة","https://www.aldiwan.net/poem53394.html","الكامل"],[395,"قيس وليلى","https://www.aldiwan.net/poem24310.html","عموديه"],[417,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[433,"قامت حروب الهوى على ساق","https://www.aldiwan.net/poem12314.html","المنسرح"],[433,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[433,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[440,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[462,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[462,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[462,"راسي الحبى في سلمه ونديه","https://www.aldiwan.net/poem16423.html","الكامل"],[465,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[496,"يا شيخ إنك شاعر","https://www.aldiwan.net/poem9874.html","مجزوء الكامل"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"اليوم ربك أعطى القوس باريها","https://www.aldiwan.net/poem52826.html","البسيط"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[563,"في فتح عكا برد نار معاطب","https://www.aldiwan.net/poem52976.html","الكامل"]],"verses":[["رَأسٌ يُدَبِّرُ في الخَفاءِ كَأَنَّهُ","قَدَرٌ يُدَبِّرُ مِن وَراءِ حِجابِ",0,"ب",1,0],["رأس الخليل يكاد يغدو حاسراً","لا شيء يدرأ عنه لذع النار",1,"ر",1,0],["رأس الحمار حرى بعرى دائمٍ","هل ينفع التعصيب رأس حمار",1,"ر",1,0],["رَأسُ اِبنِ بِنتِ مُحَمَّدٍ وَوَصِيِّهِ","يا لِلرِجالِ عَلى قَناةٍ يُرفَعُ",2,"ع",1,1],["راسِخُ الدِمنِ عَلى أَعضادِهِ","ثَلَمَتهُ كُلُّ ريحٍ وَسَبَل",3,"ل",1,0],["رَأسُ الكَتيبَةِ مَرثَدٌ وَأَميرُهُم","إِبنُ البُكَيرِ أَمامَهُم وَخَبيبُ",4,"ب",1,0],["رأس ورجل والضلع فهو كما","يقال من قرنه إلى قدمه",5,"م",2,0],["راسياً ثابتاً وإن خَلَت الدا","رُ جنابا وامتدَّ عهدُ اللقاءِ",6,"ا",2,0],["رأستَ بني الدنيا وليس بنازل","بمنزلةِ المرؤوس من أنت رائسه",7,"س",2,0],["رأسُ ابن عرسٍ ووجهُ نمسٍ","فاصفع بشر النعال والْطِمْ",8,"م",1,0],["راسل ذويها لو اجابوا سائلا","واجعل مدادك يا يراعي من دمى",9,"م",2,0],["رأس من الثوم وأخ","رى من صغار البصلِ",10,"ل",1,1],["رَأسُ الحِمايَةِ مَقطوعٌ فَلا عَدِمَت","كِنانَةُ اللَهِ حَزماً يَقطَعُ الذَنَبا",11,"ب",2,0],["رأسي بها شيبانُ والطرفُ منْ","نبهانَ والعذَّالُ فيها كلابْ",12,"ب",1,0],["راسٍ عَلى الدَهرِ إِن جاشَت زَلازِلُهُ","تَطوي الجِبالَ وَتَرميها بِتَحويلِ",13,"ل",1,0],["رَأَسنا وَجالَدنا المُلوكَ وَأُعطِيَت","أَوائِلُنا في الوَفدِ مَكرُمَةَ الوَفدِ",14,"د",1,0],["رَأسُ ابنِ آدَمَ أَصلُهُ وَفُروعُهُ","قَدَماهُ ضِدُّ النَبتِ وَالأَشجارِ",15,"ر",1,0],["راسَ الفَتى زَمَناً وَراسَ حِمامُهُ","فَغَدا الرَئيسُ كَأَنَّهُ لَم يَرأَسِ",16,"س",1,0],["رَأْسُ أَرْقَى حُكُومَةٍ","بِالْمَزَايَا لَكَ اعْتَرف",17,"ف",1,0],["رَأْسُ الحَصَافَةِ أَنْ يَكُو","نَ حِجاك غَلاَّباً فُؤادَكْ",18,"ك",1,0],["رَاسخِ العَزْم في كفاح الليَالي","بَاسمِ الوَجْه في قُطُوب الْعَوَادي",19,"د",2,0],["رأسُ مالِ المرءِ ما في رأسِه","من ذكاءٍ لا حُطامُ النَشُب",20,"ب",1,0],["رَأْسُه رَأْسُ مالِه وامتِلاءُ الرَّأْ","س خَيْرٌ من امْتِلاء الوِطَاب",21,"ب",1,0],["رأسي سوى رأسي الذي كان لي","يا سادتي بيني ، وبيني قفار",22,"ر",1,0],["رأسٌ من العَصَبِ السامي على قفص","من العظام إلى مهزولةٍ عُصِبا",23,"ب",2,0],["رأس أبي حفصٍ عظيم المَنْفعهْ","كم من يد أمستْ به مُمتَّعه",24,"ع",2,1],["رأسٌ جلاه الدهرُ حتى قرَّعه","فلم يَدع في جانبيْه قَزعهْ",24,"ع",2,0],["رأسي لربي وربي لن أطاطئه","ولن أذلك يا نفسي لديان",25,"ن",1,0],["رأسُ الوزارة ههنا فتلطفي","أدباً وأخفِي في المسير خطاكِ",26,"ك",1,0],["رَأسٌ تُراعُ لَهُ العُيونُ وَلَم تَزَل","قَبلَ العُيونِ بِهِ القُلوبُ تُرَوَّعُ",27,"ع",1,0],["راسِماتٍ لِلرامِساتِ يُناسِب","نَ وَيُنكِرنَ شَدقَماً وَجَديلا",28,"ل",2,0],["رَأسُ الفَتى وَجَبينُهُ وَمَقذُّهُ","وَالثَغرُ مِنهُ وَأَنفُهُ وَالمِنخَرُ",29,"ر",1,0],["رَأسهُ الضخمُ فاحمُ الشَعرِ رجلاً","ليسَ سبطاً وليس فيه اِلتواءُ",30,"ا",2,0],["رَأسُ العُلى وَأَنتَ قِمَّةُ الراس","أَسلَمتَني في حاجَتي إِلى الياس",31,"س",1,0],["رَأْسُ الرُّؤُوسِ وَخِيْرُهُمْ حَسَباً","وَأَجَّلُّهُمْ فِي نَفْسِ مَرْؤُوسِ",32,"س",1,0],["راسي الدعائمِ مَرفوع المعالمِ مش","حوذَ الصرائمِ لا تلحى له ذممُ",33,"م",1,0],["رأسكَ المَقصود قاصده","في هِجاءِ الدَّهرِ فاشتَركا",34,"ك",2,0],["رأس المعارف حكمةٌ تسمو بها","مرقاتها عن كونها ضوضاءَ",35,"ا",2,0],["راسَلتُ مَن أَهواهُ أَطلُبُ زَورَةً","فَأَجابَني أَوَ لَستَ في رَمَضانِ",36,"ن",1,1],["راسما فوق صفحة الرمل ما","كا ن من الشوق والأسى والحنين",37,"ن",1,0],["رأس الأكابر والأشراف من مضر","صدر الرئاسة فخر السادة النجب",38,"ب",1,0],["رَاسَلْتُهَا مادِحاً أَبَا حَسَنٍ","فَغَبَّرَتْ في طَرِيق سَبَّاقِ",39,"ق",1,0],["رأْسُهُ كالسِّنانِ لكنَّ أُخْرا","هُ حسامٌ يَفْرِي الخطوبَ صَقيلُ",40,"ل",1,0],["راسي حَصاة الحِلْمِ حيثُ تحللَتْ","عُقدُ الحُبا وارتاحَ كلُّ مدجّجِ",41,"ج",1,0],["رأسٌ مُطِلُّ عَلَى بابَيْ طُليْطِلَةٍ","يُومي إلى الكُفْرِ هَذَا مَوْعِدُ الكَفَرَهْ",42,"ر",2,0],["راسِخٌ يحلُم في حَبْوتهِ","فإذا ما ركبَ العزْمَ قَتلْ",43,"ل",1,0],["راسِخٌ منْ طودِ حِلْمٍ راجحٍ","ثابتُ الآساسِ عُلْوُيُّ البِنا",44,"ن",2,0],["راسِي الحُبى في سَلْمهِ ونَديِّهِ","ومعَ الحفيظةِ فالجرازُ المِصْدَعُ",45,"ع",1,1],["راسي حصاة الحلمِ والأطوادُ","طائشةٌ قريبُ العفو غير بعيده",46,"د",2,0],["رأسي ورجلي في حر أم","ك والمعلق من حمارك",47,"ك",1,0],["رأس العذول يد الاعراض كم صقعت","هزلا اذا ما أراد الجد بالكلم",48,"م",1,0],["رأسُ العَشائِرِ في لُبنانَ قاطِبةً","إليهِ تَبسُطُ عن طوعٍ أَياديها",49,"ي",3,0],["رأسٌ يُصفِّدُهُ نامي الصِبا عَبَثاً","بأَدهمِ الشَعْرةِ النَدّابِ ناميها",50,"ي",3,0],["رأسَ الثَمانِ وأربعينَ بِطيّهِ","مئتانِ مَعْ ألفٍ فبارَكَ ربُّكا",51,"ك",2,0]]}