"السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72426","الرجز"],[4675,"الإحتفال بالمولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=193538",""],[4755,"رَاسِلِينِي بمُلصَقٍ أَو بصُورةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183775",""],[4755,"واللهِ لا امرأَةٌ ولا رَجُلٌ حَكَى","https://www.poetsgate.com/ViewPoem.aspx?id=212887",""],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[4862,"بل إن طبعي المرجله","https://www.poetsgate.com/ViewPoem.aspx?id=55630",""],[4916,"مجروحه","https://www.poetsgate.com/ViewPoem.aspx?id=135385",""],[4955,"أعلنتها فلتسمعوا إعلاني","https://www.poetsgate.com/ViewPoem.aspx?id=199644",""],[4958,"هكذا تكلم المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=155102",""],[4984,"يوم المجاهد","https://www.poetsgate.com/ViewPoem.aspx?id=181624",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5136,"يا لها قبة تلألأ نورا","https://www.poetsgate.com/ViewPoem.aspx?id=121549",""],[5183,"قرينة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=186604",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5199,"كلنا لجل الملك والسعوديه فدى","https://www.poetsgate.com/ViewPoem.aspx?id=147704",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5232,"قرية النور","https://www.poetsgate.com/ViewPoem.aspx?id=212235",""],[5325,"نقضت بك الأيام أعلى منزل","https://www.poetsgate.com/ViewPoem.aspx?id=171979",""],[5327,"الصُّبحُ الغَائب","https://www.poetsgate.com/ViewPoem.aspx?id=140331",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5431,"ياعراق....","https://www.poetsgate.com/ViewPoem.aspx?id=207993",""],[5436,"لي فيك شكوى / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177539",""],[5459,"إصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200151",""],[5573,"وين اصبحت ياهارب","https://www.poetsgate.com/ViewPoem.aspx?id=200310",""],[5573,"انشد عن الي مر به","https://www.poetsgate.com/ViewPoem.aspx?id=202260",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5739,"راسبه والاّ ناجحه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126872",""],[5739,"الحرف دلاّل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127067",""],[5853,"قبلة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175708",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""],[5956,"آهِ لولا بعضُ أصحابي الغيارى","https://www.poetsgate.com/ViewPoem.aspx?id=193816",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6115,"بيض الله وجه بعض الشدايد والضروف","https://www.poetsgate.com/ViewPoem.aspx?id=180470",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[2220,"كان لي قلبٌ فلما ارتحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11725&r=&rc=595",""]],"verses":[["رَأسٌ يُدَبِّرُ في الخَفاءِ كَأَنَّهُ","قَدَرٌ يُدَبِّرُ مِن وَراءِ حِجابِ",0,"ب",1,0],["رأس الخليل يكاد يغدو حاسراً","لا شيء يدرأ عنه لذع النار",1,"ر",1,0],["رأس الحمار حرى بعرى دائمٍ","هل ينفع التعصيب رأس حمار",1,"ر",1,0],["رَأسُ اِبنِ بِنتِ مُحَمَّدٍ وَوَصِيِّهِ","يا لِلرِجالِ عَلى قَناةٍ يُرفَعُ",2,"ع",1,1],["راسِخُ الدِمنِ عَلى أَعضادِهِ","ثَلَمَتهُ كُلُّ ريحٍ وَسَبَل",3,"ل",1,0],["رَأسُ الكَتيبَةِ مَرثَدٌ وَأَميرُهُم","إِبنُ البُكَيرِ أَمامَهُم وَخَبيبُ",4,"ب",1,0],["رأس ورجل والضلع فهو كما","يقال من قرنه إلى قدمه",5,"م",2,0],["راسياً ثابتاً وإن خَلَت الدا","رُ جنابا وامتدَّ عهدُ اللقاءِ",6,"ا",2,0],["رأستَ بني الدنيا وليس بنازل","بمنزلةِ المرؤوس من أنت رائسه",7,"س",2,0],["رأسُ ابن عرسٍ ووجهُ نمسٍ","فاصفع بشر النعال والْطِمْ",8,"م",1,0],["راسل ذويها لو اجابوا سائلا","واجعل مدادك يا يراعي من دمى",9,"م",2,0],["رأس من الثوم وأخ","رى من صغار البصلِ",10,"ل",1,1],["رَأسُ الحِمايَةِ مَقطوعٌ فَلا عَدِمَت","كِنانَةُ اللَهِ حَزماً يَقطَعُ الذَنَبا",11,"ب",2,0],["رأسي بها شيبانُ والطرفُ منْ","نبهانَ والعذَّالُ فيها كلابْ",12,"ب",1,0],["راسٍ عَلى الدَهرِ إِن جاشَت زَلازِلُهُ","تَطوي الجِبالَ وَتَرميها بِتَحويلِ",13,"ل",1,0],["رَأَسنا وَجالَدنا المُلوكَ وَأُعطِيَت","أَوائِلُنا في الوَفدِ مَكرُمَةَ الوَفدِ",14,"د",1,0],["رَأسُ ابنِ آدَمَ أَصلُهُ وَفُروعُهُ","قَدَماهُ ضِدُّ النَبتِ وَالأَشجارِ",15,"ر",1,0],["راسَ الفَتى زَمَناً وَراسَ حِمامُهُ","فَغَدا الرَئيسُ كَأَنَّهُ لَم يَرأَسِ",16,"س",1,0],["رَأْسُ أَرْقَى حُكُومَةٍ","بِالْمَزَايَا لَكَ اعْتَرف",17,"ف",1,0],["رَأْسُ الحَصَافَةِ أَنْ يَكُو","نَ حِجاك غَلاَّباً فُؤادَكْ",18,"ك",1,0],["رَاسخِ العَزْم في كفاح الليَالي","بَاسمِ الوَجْه في قُطُوب الْعَوَادي",19,"د",2,0],["رأسُ مالِ المرءِ ما في رأسِه","من ذكاءٍ لا حُطامُ النَشُب",20,"ب",1,0],["رَأْسُه رَأْسُ مالِه وامتِلاءُ الرَّأْ","س خَيْرٌ من امْتِلاء الوِطَاب",21,"ب",1,0],["رأسي سوى رأسي الذي كان لي","يا سادتي بيني ، وبيني قفار",22,"ر",1,0],["رأسٌ من العَصَبِ السامي على قفص","من العظام إلى مهزولةٍ عُصِبا",23,"ب",2,0],["رأس أبي حفصٍ عظيم المَنْفعهْ","كم من يد أمستْ به مُمتَّعه",24,"ع",2,1],["رأسٌ جلاه الدهرُ حتى قرَّعه","فلم يَدع في جانبيْه قَزعهْ",24,"ع",2,0],["رأسي لربي وربي لن أطاطئه","ولن أذلك يا نفسي لديان",25,"ن",1,0],["رأسُ الوزارة ههنا فتلطفي","أدباً وأخفِي في المسير خطاكِ",26,"ك",1,0],["رَأسٌ تُراعُ لَهُ العُيونُ وَلَم تَزَل","قَبلَ العُيونِ بِهِ القُلوبُ تُرَوَّعُ",27,"ع",1,0],["راسِماتٍ لِلرامِساتِ يُناسِب","نَ وَيُنكِرنَ شَدقَماً وَجَديلا",28,"ل",2,0],["رَأسُ الفَتى وَجَبينُهُ وَمَقذُّهُ","وَالثَغرُ مِنهُ وَأَنفُهُ وَالمِنخَرُ",29,"ر",1,0],["رَأسهُ الضخمُ فاحمُ الشَعرِ رجلاً","ليسَ سبطاً وليس فيه اِلتواءُ",30,"ا",2,0],["رَأسُ العُلى وَأَنتَ قِمَّةُ الراس","أَسلَمتَني في حاجَتي إِلى الياس",31,"س",1,0],["رَأْسُ الرُّؤُوسِ وَخِيْرُهُمْ حَسَباً","وَأَجَّلُّهُمْ فِي نَفْسِ مَرْؤُوسِ",32,"س",1,0],["راسي الدعائمِ مَرفوع المعالمِ مش","حوذَ الصرائمِ لا تلحى له ذممُ",33,"م",1,0],["رأسكَ المَقصود قاصده","في هِجاءِ الدَّهرِ فاشتَركا",34,"ك",2,0],["رأس المعارف حكمةٌ تسمو بها","مرقاتها عن كونها ضوضاءَ",35,"ا",2,0],["راسَلتُ مَن أَهواهُ أَطلُبُ زَورَةً","فَأَجابَني أَوَ لَستَ في رَمَضانِ",36,"ن",1,1],["راسما فوق صفحة الرمل ما","كا ن من الشوق والأسى والحنين",37,"ن",1,0],["رأس الأكابر والأشراف من مضر","صدر الرئاسة فخر السادة النجب",38,"ب",1,0],["رَاسَلْتُهَا مادِحاً أَبَا حَسَنٍ","فَغَبَّرَتْ في طَرِيق سَبَّاقِ",39,"ق",1,0],["رأْسُهُ كالسِّنانِ لكنَّ أُخْرا","هُ حسامٌ يَفْرِي الخطوبَ صَقيلُ",40,"ل",1,0],["راسي حَصاة الحِلْمِ حيثُ تحللَتْ","عُقدُ الحُبا وارتاحَ كلُّ مدجّجِ",41,"ج",1,0],["رأسٌ مُطِلُّ عَلَى بابَيْ طُليْطِلَةٍ","يُومي إلى الكُفْرِ هَذَا مَوْعِدُ الكَفَرَهْ",42,"ر",2,0],["راسِخٌ يحلُم في حَبْوتهِ","فإذا ما ركبَ العزْمَ قَتلْ",43,"ل",1,0],["راسِخٌ منْ طودِ حِلْمٍ راجحٍ","ثابتُ الآساسِ عُلْوُيُّ البِنا",44,"ن",2,0],["راسِي الحُبى في سَلْمهِ ونَديِّهِ","ومعَ الحفيظةِ فالجرازُ المِصْدَعُ",45,"ع",1,1],["راسي حصاة الحلمِ والأطوادُ","طائشةٌ قريبُ العفو غير بعيده",46,"د",2,0],["رأسي ورجلي في حر أم","ك والمعلق من حمارك",47,"ك",1,0],["رأس العذول يد الاعراض كم صقعت","هزلا اذا ما أراد الجد بالكلم",48,"م",1,0],["رأسُ العَشائِرِ في لُبنانَ قاطِبةً","إليهِ تَبسُطُ عن طوعٍ أَياديها",49,"ي",3,0],["رأسٌ يُصفِّدُهُ نامي الصِبا عَبَثاً","بأَدهمِ الشَعْرةِ النَدّابِ ناميها",50,"ي",3,0],["رأسَ الثَمانِ وأربعينَ بِطيّهِ","مئتانِ مَعْ ألفٍ فبارَكَ ربُّكا",51,"ك",2,0],["رأس النقابة فاغتدت مختالة","في مطرف الأعزاز والأسعاد",52,"د",1,0],["رَأسٌ رَفَعتُ بِهِ حاليُ وَأنتَ فتىً","كَأَنَّ آراءَهُ يُنحَتنَ مِن جَبَلِ",53,"ل",1,0],["رَأْسٌ بِظَهْرِ النُّونِ إلاَّ أنَّهُ","سَامٍ فَقُبَّتُهُ بحيْثُ النُّوْنُ",54,"ن",1,0],["راسياً جانبَ الخوانِ فما يُحْ","سَبُ إِلا بعضَ الجبالِ الرواسي",55,"س",2,0],["رأسُ علمٍ تُحِلُّهُ رؤساءُ ال","علمِ في العلمِ في محلِّ الراس",56,"س",1,0],["راسه عليه ضفايه","ما ضفرّه بعقد",57,"د",1,0],["رَأس سِواكِ الحِبِّ صارَ جَوهَراً","فَتاهَ عجباً إِذ أَضاءَ مزهرا",58,"ر",2,1],["رَأس الأَماجِدِ مَن قَد يطرِقون لَهُ","مِنهُم رُؤوساً تدقّ الدّهرَ في السّحبِ",59,"ب",1,0],["راسِخُ الأَعراقِ رَيّانُ الثَرى","غَدِقٌ تُربَتُهُ لَيسَت تَجِف",60,"ف",1,0],["راسَلتهُم بِطيّب السَلام","مُعتَذِرا مُستَدفِع المَلامِ",61,"م",1,0],["رأس السَّلامة بغضها","وودادها رأس الخَطَرْ",62,"ر",1,0],["رأْساً مِن الأَنْداد إلَّا تَقْصِمُهْ","وَكانَ حَتّى رَنَّحَتْهُ صُكَّمُهْ",63,"م",2,0],["رأس البرية فخراً والورى ذنب","أفى وشتان بين الرأس والذنب",64,"ب",1,0],["راسلتها قالت: فراقُك حكمةٌ","من خالقي فاصبر فقد خطبوني!",65,"ن",2,0],["رأسها الواهي على صدري وفي","سكرة العينين جوع لهزالي",66,"ل",2,0],["رأسه عينه عند أقوام","كاللآلي في وجهه تتجلى",67,"ل",2,0],["رأسي به هوسٌ جديدٌ لا الذي","تدريه من هوسٍ قديمٍ فيه",68,"ه",1,1],["رأستَ في الدين إحداها وكنتَ أباً","للكلِّ ترعى لهذا الموطنِ الذِمما",69,"م",2,0],["رأس ملأت به حياةً دونها","باعُ المديح مدى الزمان قصير",70,"ر",1,0],["رأسه فوق القنا يشجي الذي","يتولاه ويشفي المبغضا",71,"ض",2,0],["رأس وقد بان عن جسم وطاف على","رمحٍ وترتيله القرآن ما بانا",72,"ن",2,1],["رأسٌ ترى طلعة الهادي البشير به","كأنما رفعوه عنه عنوانا",72,"ن",2,0],["رأسنا بمن راياته تخرق العلا","وقد عقدت في حضرة القدس بالنصر",73,"ر",1,0],["رأسُ مالِ الحَياةِ لم أستَفِد من","هُ سِوَى حَسرةٍ وذكرى تشوقُ",74,"ق",1,0],["راسخاتٌ كلما ناطحها","عاصف ناطح منها جبلا",75,"ل",2,0],["رأسُ المفاخر بابْن الَشاهقِ الراسِي","ويا ثِمالَ العُفَاةِ الطاعمَ الكاسي",76,"س",2,1],["رأس ابن بنت محمد ووصيه","كالبدر في افق الاسنه يطلع",77,"ع",1,0],["راس به خلق السماء وأرضها","للناظرين على قناة يرفع",77,"ع",1,0],["رأسك ارفع هذه حضرتي","وأنا الحقُّ فلا تنتعل",78,"ل",1,0],["رأسك ارفع ما الذي تبتغي","قلت مولاي حلولُ الأجل",78,"ل",1,0],["رأستَ فيه بعلوم بدتْ","فيك ولولا ذاك لم ترأس",79,"س",1,0],["رأس مال الحياة شيآن عندي","بهما للورى مع الدهر شغلُ",80,"ل",1,1],["راسلني القاضي أبو جعفرٍ","مُعاتباً بالكَلِم الفَصْل",81,"ل",1,1],["رَأسُ مالي تَركُ الفُضولِ وَما أَت","رُكُ مِن أَجلِ حُبِّكُم رَأسَ مالي",82,"ل",2,0],["راسخ كالطود لا 