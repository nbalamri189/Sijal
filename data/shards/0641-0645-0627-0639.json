 مالك",134,"ك",1,0],["فما عنك أمحى اللَه حزناً بغيره","ولا سفك دمع غير ما أنت مسفك",135,"ك",1,0],["فما عودتني مفردات بيانه","نفاقاً ولو لم يبق في الكف درهم",136,"م",1,0],["فما عرفت بها إلا زيانية","في كل عهدٍ وحظي عندهم ضرري",137,"ر",2,0],["فما عنَّاه من أمر","رياضتُه وقد هرِما",138,"م",2,0],["فما عزلُكم إلا خديعةُ ليلةٍ","وما سَرّ منه الشامتين خيالُ",139,"ل",1,0],["فما عضدُ الدين الجوادُ بحارِمٍ","ولا خاذلٍ اِن عزَّ مُجْدٍ وناصرُ",140,"ر",1,0],["فما على أهْلِ العُلى سُبَّةٌ","أنَّ بخورَ العودِ بعضُ الدخانْ",141,"ن",1,0],["فما عضد الدين الجوادُ فتى النَّدى","نظيراً لهُ في المكْرُماتِ بواجِدِ",142,"د",1,0],["فَما عَساني أَن أُرى قائِلاً","فيكَ وَأَنتَ الدُرُّ في القَطنِ",143,"ن",1,0],["فما عاينت عيناي بعدك منظراً","يسوءك إلا قلت قد رمقاني",144,"ن",2,0],["فما عسى بهرام وهو عبده","إذ كفر الصنع يكون صانعا",145,"ع",2,0],["فما عذر شعر لا يجود فيهم","وعذري مزاح بالعطاء مزال",146,"ل",1,0],["فَمَا عَرَفُوا التَّمَذْهُبَ في رِحالٍ","وَلا صَحِبُوهُ يَوْماً في ارْتِحالِ",147,"ل",1,0],["فَما عادَت لِذي يَمَنٍ رُؤوساً","وَلا ضَرَّت بِفُرقَتِها نِزارا",148,"ر",2,1],["فَما عِيف اِضطلاعي واِصطناعي","وَلا حِيف اِنصرافي واِنحرافي",149,"ي",1,0],["فما عندهم عجز عن الغيب دائماً","كما عندنا خوفاً عليهم من النكر",150,"ر",1,0],["فَمَا عُصِرَتْ وما جُعلت بدنٍّ","وما سُبكتْ زُجاجتُها بنارْ",151,"ر",1,0],["فَمَا عُذْرُكَ فِي أَنْ لاَ","تُرَى مِنْ سُكُرٍ طِيْنَهْ",152,"ن",2,0],["فما عدا ذلك فهو بدعة","في قول كل من تضم الشرعة",153,"ه",1,0]]}