tml","الوافر"],[400,"يا برهمي الشرع ربي الذي","https://www.aldiwan.net/poem33986.html","السريع"],[402,"لئن سممني الله","https://www.aldiwan.net/poem49696.html","الهزج"],[402,"تعال إلى الصواني مترعات","https://www.aldiwan.net/poem49698.html","الوافر"],[403,"همو علموا عيني سؤال المعالم","https://www.aldiwan.net/poem50112.html","الطويل"],[403,"يغالبني فرط الغرام على الصبر","https://www.aldiwan.net/poem50164.html","الطويل"],[403,"جسمي نحيل بالحب والحب","https://www.aldiwan.net/poem50202.html","المنسرح"],[406,"إن كنت في مصر مجهولا وقد شهرت","https://www.aldiwan.net/poem32041.html","البسيط"],[413,"عرفت صبابة هذي النياق","https://www.aldiwan.net/poem53927.html","المتقارب"],[413,"بوخز القنا والمرهفات البواتر","https://www.aldiwan.net/poem54013.html","الطويل"],[429,"لقيت حمامي إذ فقدت حميمي","https://www.aldiwan.net/poem12715.html","الطويل"],[434,"أبى الدهر إلا أن تلم نوازله","https://www.aldiwan.net/poem2576.html","الطويل"],[436,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[438,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[438,"عزاء وصبرا كل شيء فهالك","https://www.aldiwan.net/poem14469.html","الطويل"],[438,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[447,"مع صادق الشعر","https://www.aldiwan.net/poem970.html",""],[451,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[456,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[459,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[459,"ان شارك الأدوان أهل العلى","https://www.aldiwan.net/poem16007.html","السريع"],[459,"إذا شئت أن تلقى المناقب والعلى","https://www.aldiwan.net/poem16218.html","الطويل"],[466,"يا ذا الذي من بلا من","https://www.aldiwan.net/poem59636.html","السريع"],[511,"كأن رقيبا منك يرعى خواطري","https://www.aldiwan.net/poem67698.html","البسيط"],[513,"يا باذلاً رزق الورى ومانعا","https://www.aldiwan.net/poem12169.html","الرجز"],[513,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[527,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[538,"فما عادت لذي يمن رؤوسا","https://www.aldiwan.net/poem56837.html","الوافر"],[549,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[557,"تنبه قد بدى شمس العقار","https://www.aldiwan.net/poem69363.html","الوافر"],[565,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَما عَمَّمَتها الشَمسُ حَتّى رَأَيتُها","بِنَجدٍ تُساميها النِجادُ القَوابِلُ",0,"ل",1,0],["فَما عَرَفتني الأَرضُ غَيرَكَ مُطلَباً","وَلا بَلَغَتني العيسُ إِلّاكَ مَقصَدا",1,"د",2,0],["فَما عَن نَوالٍ مِن لُبَينى زِيارَتي","وَلا قِلَّةُ الإِلمامِ أَن كُنتُ قالِياِ",2,"ي",2,0],["فَما عَطَفوا عَلى أَحَدٍ بِفَضلٍ","وَلا عَرَفوا لِمَكرُمَةٍ ثُبوتا",3,"ت",2,0],["فَما عَمْرو إنْ قِيسَ يوْماً ببأسِهِ","وإنْ وصَفوهُ بالدّهاءِ فَما عَمْرُو",4,"ر",2,0],["فما عِندَكَ اللهمّ خيرٌ ثَوابُهُ","وأبْقى ودُنْيا المرْءِ خُدْعَةُ مغْتَرِّ",5,"ر",1,0],["فَما عاقَها عنْ نَيْلِها القَصْدَ عائِقٌ","ولا عَزّها يوْماً منَ اللهِ إمْدادُ",6,"د",1,0],["فَما عُتِرَ الظِباءُ بِحَيِ كَعبٍ","وَلا الخَمسونَ قَصَّرَ طالِبوها",7,"و",3,0],["فَما عَصَمَتني مِن زَماني فَضائِلي","وَلَكِن رَأَيتُ المَوتَ لِلحُرِّ أَعصَما",8,"م",2,0],["فَما عَهدُ إِسماعيلَ وَالعَيشُ ضَيِّقٌ","بِأَجدَبَ مِن عَهدٍ لَكُم سالَ عَسجَدا",9,"د",2,0],["فَما عوفِيَت مِقَتي مِن أَذىً","وَلا أُعفِيَت ثِقَتي مِن خَجَل",10,"ل",1,0],["فَما عابَ مِن شَيءٍ عَلَيهِ فَإِنَّهُ","قَد اِستَيقَنَت فيهِ نفوسُ يقينُها",11,"ن",3,0],["فما عمِلت رماح الخَط فيهم","كما عملته أقلام الصحافه",12,"ف",2,0],["فما علماء الجهل إلاّ مساقم","رمَت جهلاء العلم بالقُوَباء",13,"ا",2,0],["فَما عِبتُ مِن نارٍ أَضاءَ وَقودُها","فِراساً وَبَسطامَ بنَ قَيسٍ مُقَيَّدا",14,"د",2,0],["فَما عَرَفوا السِباقَ وَما تَجَلَّت","وُجوهُ التَيمِ مِن قَتَمِ الغُبارِ",15,"ر",1,0],["فَما عوفيتَ يَومَ تَحُضُّ قَيساً","فَفُضَّ الحَيُّ وَاِقتُنِصَ السَوامُ",16,"م",1,0],["فَما عَصماءُ لا تَحنوا لِإِلفٍ","تَرَعّى في ذُرى الهَضَبِ البَشاما",17,"م",2,0],["فَما عَرَّفَتني غَيرَ ما أَنا عارِفٌ","وَلا عَلَّمَتني غَيرَ ما كُنتُ أَعلَمُ",18,"م",1,0],["فما عندنا إلا شؤون حوافل","تجود عليه أو عيون سواهدُ",19,"د",1,0],["فما عِبتني إلا بما ليس عائبي","وكم جاهلٍ يُزري على خُلُقٍ محضِ",20,"ض",1,0],["فما عُذرُ مَنْ باع أسنى الحظو","ظِ بالوَكْسِ من مُوكِس ماطل",21,"ل",1,0],["فما عَلقتْ من قبلها النفسُ مَعْلقاً","ولا اتخذت من بعدها متعلَّلا",22,"ل",2,0],["فَما عانَقَت نورَ الكَواكِبِ في الدُجى","وَلا لَثَمَت فَجراً وَلا رَشَفَت طَلّا",23,"ل",2,0],["فما عرفت آخري","ولا عرفت اولي",24,"ي",1,0],["فما عاد عصفوري اليّ لشقوتي","وكان اليه في حياتي اخلادي",25,"ي",1,0],["فَما عَلى المَرءِ في الأَخلاقِ مِن حَرَجٍ","إِذا رَعى صِلَةً في اللَهِ أَو رَحِما",26,"م",2,0],["فَما عَرَفَ البَلاغَةَ ذو بَيانٍ","إِذا لَم يَتَّخِذكَ لَهُ كِتابا",27,"ب",2,0],["فما عهدُ أحبابي على البُعْدِ ضائعٌ","لديَّ ولا ظِلُّ الوفاءِ بقالصِ",28,"ص",1,0],["فما عذري إِذا أنا لم أقابِلْ","أياديَهُ بشُكْرٍ أو بسُكْرِ",29,"ر",1,0],["فما عثرة الساقي بكأس رويَّةٍ","بأغزرَ فيضاً من دمائِكما الغُزْرِ",30,"ر",1,0],["فَما عَلِقَتهُ خَبطَ عاشِيَةِ الدُجى","وَلَكِنَّها اِختارَتهُ بَعدَ اِرتِيادِها",31,"د",3,0],["فَما عَلِمَت طائيَّةٌ مَن أَبٌ لَها","وَلَو سَأَلَت عَن أَصلِها كُلَّ ناسِبِ",32,"ب",1,0],["فَما عادَ ذاكَ اليَومُ حَتّى أَناخَها","بِمَيسانَ قَد حُلَّت عُراها وَمَلَّتِ",33,"ت",1,0],["فما على كَفِّك الآسي بِمبِضَعِه","أنحَى ولكنّه أنحَى على الأملِ",34,"ل",1,0],["فَما عَسرةٌ فَاِصبِر لَها إِن لَقيتَها","بِدائِمَةٍ حَتّى يَكونُ لَها يُسرُ",35,"ر",1,0],["فما عنادُ الأماني","وما صراعُ الذبالِ",36,"ل",1,0],["فما على الورك الشهي ممزقا","وما على الصدر النظيف منظفا",37,"ف",2,0],["فما على الأرض عليمٌ بما","تجتمع الشهبُ له في القران",38,"ن",1,0],["فَما عيشَةُ الإِنسانِ صَفوٌ جميعُها","ولا آخرٌ من عمره نِدّ أوّلِ",39,"ل",1,0],["فَما عُدّ أَهلُ الرَأيِ والبَأسِ والنَدى","وَإِن كثُرُوا إِلّا وَوَفّى بِهِم عَدّا",40,"د",2,0],["فَما عَدِمتُ بِها لا جاحِداً عَدَماً","صَبراً يَقومُ مَقامَ الكَشفِ لِلكُرَبِ",41,"ب",1,0],["فَما عَلى الدَهرِ لَو رَقَّت شَمائِلُهُ","فَعادَ بِالوَصل أَو أَلقى يَدَ السَلَمِ",42,"م",1,0],["فما عبثاً رأيتُ عبيدَ تُرْكٍ","مملَّكةً على أحرارِ عُرْبِ",43,"ب",1,0],["فَما عَدَلَت في الحُكمِ يا صاحِ بَينَنا","أَفي العَدلِ مِنها أَن نُحِبَّ وَأَن نُجفى",44,"ف",2,0],["فَما عاجَ بي وَجدٌ عَلى رَسمِ مَنزِلٍ","فَأَعوَلتُ إِلّا حَنَّ وَجداً فَأَرزَما",45,"م",2,0],["فَما عَوهَجٌ أَدماءُ خَفّاقَةُ الحَشا","لَها شادِنٌ يَدعوهُ وِتراً خِوارُها",46,"ر",3,0],["فما عُرِفَ النّصيحُ من المُداجِي","ولا وضح الصّريحُ من المشوبِ",47,"ب",1,0],["فَما عَصَمَت نَفسَ المُقَدَّسِ دِرعُهُ","وَلا قَصَّرَت بِالمُستَكينِ عَلائِلُه",48,"ل",2,0],["فما عَلَى القَوْسِ مِنْ عَيْبٍ تُعَابُ به","إنِ انْحَنَتْ وَاستقامَ السَّهْمُ والوتَرُ",49,"ر",1,0],["فَما عَلَى غَيرِهِ لِلنَّاسِ مُعْتَمَدٌ","وَلا عَلَى غيرِهِ للناسِ تَعوِيلُ",50,"ل",1,0],["فما عاجِلٌ نَرْجوهُ إلاّ كآجِلٍ","ولا آجِلٌ نخشاه إلاّ كعاجلِ",51,"ل",1,0],["فما عَرَفوا الحقّ لمّا اسْتبانَ","ولا أبصروا الفَجرَ لمّا بدا",52,"ا",1,0],["فَما عُذرُ مَن قَد غَدا يَستَطيعُ","رُكوبَ السَبيلِ إِلى أَن تَجودا",53,"د",2,0],["فَما عُذري وَعِندَ اللَهِ عِلمي","إِذا كَذَبَت قَوائِلُ مُسنِداتُ",54,"ت",1,0],["فَما عَيبٌ عَلى الفَتَياتِ لَحنٌ","إِذا قُلنَ المَرادَ مُتَرجِماتِ",55,"ت",1,0],["فَما عَرَّجَت في شَأوِها أُمُّ جُندَبٍ","وَلا عَقَلَتها شَاؤُها وَعُروجُها",56,"ج",3,0],["فما عَبَدَتْ سِوَى الرّحمن رَبّاً","إذِ المعْبودُ نَسْرٌ والمُدانُ",57,"ن",1,0],["فَما عَيشُ مَن يَرجو هَلاكي بِضائِري","وَلا مَوتُ مَن قَد ماتَ قَبلي بِمُخلِدي",58,"د",2,0],["فما عَدَدْنا بَيَاضَها هَرَماً","حِينَ يُعَدّ البَيَاضُ في الهَرَم",59,"م",1,0],["فَمَا عَنْ أَمْرِكمْ بِهِمْ اشْتِغَالُ","وَمَا عَنْ أَمْرِهِمْ بِكُمْ اشْتِغَالُ",60,"ل",1,0],["فَما عُذرُها نَفسي فِداها وَلَم تَدَع","عَلى أَعظُمي لَحماً وَلَم تُبقِ لِيَ لُبّا",61,"ب",2,0],["فما عاد ينْغرُ جرحُ البلادِ","ولا يشتكي جسمُها من أَلَمْ",62,"م",1,0],["فما عاد يشكو الفقيرُ الطَّوَى","ولا عاد يشكو الغنيُّ البَشَمْ!",62,"م",1,0],["فما عاد يشكو الأسى شاعرٌ","ولا عاد يندب جور الزَّمان",63,"ن",1,0],["فما عاشَ حيٌّ أطالَ الهمومَ","ولا ماتَ حيٌّ أطالَ المِراحا",64,"ح",2,0],["فما عُدْنا نَذُوبُ إليك شوقًا","ولا بسَنَاك يأخذُنَا انْبهار",65,"ر",1,0],["فما عمر إن قيس يوما ببأسه","وإن وصفوه بالدهاء فما عمر",66,"ر",1,0],["فما عرف الخلاعة في بنات","ولا عرف التخنث في بنينا",67,"ن",2,0],["فما عرفت كفي التسول للغني","ولا صافحت كفاً تُمَدُّ الى المنح",68,"ح",1,0],["فما عهدت طروباً قبل زورتها","تلقاه من نغمات العود في ضجر",69,"ر",1,0],["فما عادة الاشراف الا شريفة","وعادات اهل الشرشر العوائد",70,"د",1,0],["فما عساك براع ما له غنم","تقول إن جاء جانبكم وزكاني",71,"ي",1,0],["فما عاملٌ إلا وأنت سِنانه","ولا راحةٌ إلا وأنت لها زندُ",72,"د",1,0],["فما عن وصيلك من صُبير","ولم أكُ بالسويمع للعذيل",73,"ل",1,0],["فما عكف عليها وارتشف","بالظرف أحلى رشفِ",74,"ف",1,0],["فما عيشُ الوحوش بخير عيشٍ","به طابت به حُمقا وجَهلا",75,"ل",2,0],["فَما عَلى طَيفِها لَو عادَ يَطرُقُنا","فَطالَما زارَ أَحياناً فَأَحيانا",76,"ن",2,0],["فما عن قلي يجفوا الموالي عبيدها","ولا بغضة ما يوجع الوالد الابنا",77,"ن",2,0],["فما عبد الرحمن من بات جاهدا","يصوره في فكره ويرتب",78,"ب",1,0],["فما عاقل يرمى صفا بزجاجة","ويحسب أن الصخر للكسر أقرب",78,"ب",1,0],["فَما عَزَّ إِلّا فاتِكٌ ذُو عَزيمَةٍ","جَريءٌ عَلى النّزلا يصرِّفُ نابُها",79,"ب",3,0],["فَما عاشَ فَالبَيتُ الرَفيعُ عِمادُهُ","يَطولُ عَلى الأَيّامِ وَالرَبعُ واسِعُ",80,"ع",1,0],["فَما عُظِّمَت قِدماً قُرَيشٌ وَوائِلٌ","عَلى الناسِ إِلّا بِاِرتِكابِ العَظائِمِ",81,"م",1,0],["فَما عاقِلٌ مَن لَم يُصدّق مُحمّداً","وَبُرهانهُ كالشمسِ قَد ظَهَرت ظُهرا",82,"ر",2,0],["فَما عَزَلوكَ مَسبوقاً وَلَكِن","إِلى الخَيراتِ سَبّاقاً جَوادا",83,"د",2,1],["فما عجيبٌ إن همتْ أدمعي","تجري بها عينايَ نهرينِ",84,"ن",1,0],["فَما عِظَمُ الرِجالِ لَهُم بِفَخرٍ","وَلَكِن فَخرُهُم كَرَمٌ وَخَيرُ",85,"ر",1,0],["فَما عالَمي غيرُ مَعنى الجَمالِ","أَهواكَ فيهِ َتَهوانيه",86,"ي",2,0