https://www.poetsgate.com/ViewPoem.aspx?id=194484",""],[5956,"سبقوا هتلر في نشر الإرهاب","https://www.poetsgate.com/ViewPoem.aspx?id=194646",""],[5956,"تَبّتْ يداْ وطن العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=194827",""],[5956,"السلام والإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=194894",""],[5956,"حارَ حناني","https://www.poetsgate.com/ViewPoem.aspx?id=195020",""],[6001,"روضة الجنه","https://www.poetsgate.com/ViewPoem.aspx?id=405",""],[6031,"عَاثَ الحِمامُ فما أبقَى وما تَرَكَا","https://www.poetsgate.com/ViewPoem.aspx?id=46283",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[415,"ذكَر الوفَاءَ خيالُك المُنتابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7775&r=&rc=5",""],[5555,"مَلاعِبُنَا الأُولَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87420&r=&rc=15",""],[454,"لا تخدعنك كثرة الزراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82674&r=&rc=38",""]],"verses":[["تَبتَني المَجدَ وَتَجتازُ النُهى","وَتُرى نارُكَ مِن ناءٍ طَرَح",0,"ح",1,0],["تَبَّتْ يداك مُفَدِّياً","ما تَبَّ من أحدٍ تَبابهْ",1,"ب",2,0],["تبتّل العود عند فقدكُمُ","وازدجر اللهو أيّ مزدَجرِ",2,"ر",1,0],["تَبَتَّلتَ لِلعِلمِ الشَريفِ كَأَنَّهُ","حَقيقَةُ تَوحيدٍ وَأَنتَ صَحابي",3,"ب",2,0],["تَبَّت يَدا مَن تابَ عَن رَشفِ الطَلى","وَالكَأسُ مُتَّقِدٌ كَخَدِّ فَتاةِ",4,"ت",3,0],["تَبتَغي تَقبيلَهُ","حينَ زالَت",5,"ت",1,0],["تَبَّت يَدي إِن ثَنَتني عَن زِيارَتِكُم","بيضُ الصِفاحِ وَلَو سُدَّت بِها طُرُقي",6,"ق",2,0],["تَبَّت يَدَا عَاذِلِيَّ فَوقَ وَجنَتِهِ","حَمَّالَةِ الوَردِ لاَ حَمَّالَةِ الحَطَبِ",7,"ب",1,0],["تَبَّت يَدا عاذِلي فيهِ وَوَجنَتُهُ","حَمّالَةُ الوَردِ لا حَمّالَةُ الحَطَب",8,"ب",1,0],["تَبَّت يَدٌ قَبَرَتهُ أَيُّ بَحرِ نَدىً","طَمى وَهَضبَةِ عِزٍّ ذاتِ أَركانِ",9,"ن",1,0],["تبتلعُ الأيرَ بشقِّ استها","مثل ابتلاع النوبةِ الباقه",10,"ق",2,0],["تبتغي بالذي فعلت صَغارى","ومقام الصغار غير مقامي",11,"م",2,0],["تَبتَغي بالسرى وصولاً إلى الحي","يِ مريحاً وَلَيسَ ثَمَّ وصول",12,"ل",1,0],["تَبْتَهِجُ العَيْنُ في رِياضٍ","أَنْضَرَها الماءُ وَالْهَواءُ",13,"ا",2,0],["تَبَتَّلَ زُهْداً فِي اللَّيَالِي وَطِيبِهَا","فَفِي طِيبِهَا الآفَاتُ وَالهَلِكَاتُ",14,"ت",1,0],["تَبْتَغِينَ الصَّلاحَ مِنْ كُلِّ وَجْهٍ","وَتُعَانِينَ شِقْوَةَ المُصْلِحِينَا",15,"ن",2,0],["تَبَّت يَدي كَيفَ لَم أَمُت إِذ","عاقَ تَكليمُكَ الصُماتُ",16,"ت",1,0],["تَبِتْ لَبُوني بِالقُرَيّة ِ أُمّناً","واسرحنا غباً بأكناف حائل",17,"ل",1,0],["تبتُ يا ربَّاهُ من كلِّ كِذَابْ","فاعفُ عنِّي وأجرْني مِنْ عَذَابْ",18,"ب",1,0],["تبتُ يا ربَّاه من كل مديحٍ","لم يجزْ فحواهُ في الشرعِ الصحيحِ",18,"ح",1,0],["تبتُ يا رباهُ من كل اغتيابِ","لأولى الفضل وأصحابِ الصوابِ",18,"ب",1,0],["تَبَّت يَدا مَرجِ الكُحولِ فَإِنَّهُ","أَفنَى الأَنامَ بِشِعرِهِ المَشؤُومِ",19,"م",1,1],["تَبْتَزُّنا حَيْثُ لا ندري وتَسْلُبُنا","أرواحَنا ولها سَلْبٌ واطلاقُ",20,"ق",1,0],["تبتسم الدنيا إلى ماجدٍ","منك حُسنيّ كريم النِجَار",21,"ر",1,0],["تبت يدا ابنِ سبا وكعب بعده","والمنتمي نسبا إلى ميمون",22,"ن",1,0],["تبّت يدا من عقّ والده وتبّْ","فإنّه وماله وما كسبْ",23,"ب",1,1],["تَبَّت يَدُ ابنِ زيادٍ من غويِّ هوىً","وَمارقٍ في غِمار الكُفرِ مَغمورِ",24,"ر",1,0],["تَبّت يدُ الدنيا وَأرغمُ أَنفها","ما بالها بِالفاضلينَ وجوجه",25,"ج",2,0],["تب توبه قبل تمسي ميت فان","ماينفعك طول خرنك والحنين",26,"ن",1,0],["تبت فهبني العفو في اللقاء","وأقبل إلهي المحض من ثنائي",27,"ا",2,0],["تبت يداها إن أخل بحسنه","وزن يضيق به الأديب النير",28,"ر",1,0],["تبتسم الأرضُ وهي كالحةٌ","منها ثغورٌ لها الحيا ظَلْمُ",29,"م",1,0],["تبت يداه فكم في كل بارحة","منه وإن عد فرداً من أبي لهب",30,"ب",1,0],["تبتز من جسمها رقطا السعال دما","ما سال ضاع به جزء من البدن",31,"ن",1,0],["تبتغي كلنا مواطن ليلى","وعيون الأعيان ما أسخاها",32,"ا",3,0],["تَبتْ يَدا كَاتِبٍ لَولاهُ ما خَرِبَتْ","مَعمُورةٌ أُسسَتْ بالعِلمِ والأَدبِ",33,"ب",1,1],["ت