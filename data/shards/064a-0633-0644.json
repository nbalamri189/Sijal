px?id=144431",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5431,"أبانا الروحي...","https://www.poetsgate.com/ViewPoem.aspx?id=210262",""],[5444,"رسالةٌ إلى نجم آفل","https://www.poetsgate.com/ViewPoem.aspx?id=205071",""],[5493,"إلى المنفى أعود","https://www.poetsgate.com/ViewPoem.aspx?id=197216",""],[5526,"زهور العشب","https://www.poetsgate.com/ViewPoem.aspx?id=192803",""],[5573,"ارموز خط وبعد شط ودلو بير وعمق طي","https://www.poetsgate.com/ViewPoem.aspx?id=200172",""],[5652,"آل رشيد من شمر","https://www.poetsgate.com/ViewPoem.aspx?id=177737",""],[5703,"عيون القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207967",""],[5776,"فراغُ الفهارس","https://www.poetsgate.com/ViewPoem.aspx?id=199333",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5969,"ذَكرتُ خيالَ من أمسى هلالا","https://www.poetsgate.com/ViewPoem.aspx?id=198735",""],[5969,"يُسَلينا التَفَكُرُ في المُحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=198976",""],[5975,"في ولاء آل بيت الرسول1","https://www.poetsgate.com/ViewPoem.aspx?id=53466",""],[6093,"كَمْ سَجِيْنٍ سِجْنُهُ مِنْهُ وَ فِيْهِ","https://www.poetsgate.com/ViewPoem.aspx?id=189723",""],[6115,"يسلمون اللى تعنوا في لزومي","https://www.poetsgate.com/ViewPoem.aspx?id=196472",""]],"verses":[["يَسلَمُ كَعبُ الرُمحِ مُستَأخِراً","وَيوقِعُ الإِقدامُ بِاللَهذَمِ",0,"م",1,0],["يَسُلُّ عَينَيهِ عَلى مِريَةٍ","عَن زَجَلِ الطَيرِ قُبَيلَ الشُروق",1,"ق",1,0],["يُسلِفُ الدَمعَ يَقيناً","بِرَدى اليَومِ العَصيبِ",2,"ب",1,0],["يَسُلُّ مِن فَكَّيهِ كَالحُسامِ","صَفيحَةً تَلعَبُ بِالكَلامِ",3,"م",1,0],["يسلو الشجيّ ولفظي كله غزل","ويستفيق وقلبي حشوه ألمُ",4,"م",1,0],["يُسْلِفون القِصاصَ مَن جَرَّحوه","قبل أن يجرحوه وزن السِّواءِ",5,"ا",2,0],["يسْلَم الوغْدُ عليه وله","إن رأى حُرَّاً هريرٌ وشُدُودُ",6,"د",1,0],["يَسلُبُني عَقلي بِحُسنِ وَجهِهِ","وَهوَ منَ الإِعجابِ بي كَالمُستَلَب",7,"ب",1,0],["يَسَلونَهُ فَيَكونُ نائِلُهُ الغِنى","وَيُقَصِّرونَ عَنِ السُؤالِ فَيَبتَدي",8,"د",2,0],["يَسلونَهُ فيها الأَناةَ وَقَد رَأَوا","لُجَجاً يَموجُ بِهِنَّ بَحرٌ طامِ",9,"م",1,0],["يُسلِمُ الدمعَ عليه نازحٌ","لو رآه أسلمَ الدمعَ قُزَح",10,"ح",1,0],["يُسلِمُ المَرءَ أَخوهُ","لِلمَنايا وَأَبوهُ",11,"و",2,1],["يَسْلُو أخو العقلِ عن دارِ الهُمومِ بها","ويَحْتَوي مَنزِلَ الأدواءِ والعِلَلِ",12,"ل",1,0],["يُسَلِّمنَ تَسليماً خَفِياً وَسَقَّطَت","كَما سَقَّطَت ظُلعٌ مِنَ السَيرِ حُسَّرُ",13,"ر",1,0],["يُسَلِّطُ المَاءَ على الحريقِ","ويَغرِسُ اللؤلؤَ في العَقيقِ",14,"ق",1,0],["يَسلُكُها بِنَيزَكٍ مُذَرَّحٍ","وَمِنسَرٍ أَقنى كَأَنفِ المِجدَحِ",15,"ح",1,0],["يَسلُقُ الحَربَ بِالحُروبِ وَيُمسي","عَصَراً في عُصارَةِ المُستَديرِ",16,"ر",1,0],["يَسلُكُ مَحمودٌ وَأَمثالُهُ","طَريقَ خاقانَ وَكُنداجِ",17,"ج",1,0],["يُسَلِّلُ أَرواحَ الكُماةِ انْسِلالُهُ","ويَرتاعُ منهُ المَوتُ والموتُ رائِعُ",18,"ع",1,0],["يَسْلُو الأُولَى عَبَدُوكَ أَمْسِ وَرُبَماَ","كُوفِئْتَ مِنْ عُرْفٍ بِالاسْتِنْكَارِ",19,"ر",1,0],["يُسَلْسِلُ اللَّفْظَ فَالألْبَابُ فِي طَرَبٍ","مِنْ نَشْوَةِ الرُّوحِ لاَ مِن نَشْوَةِ الرَّاحِ",20,"ح",1,0],["يُسْلَبُ القوتَ، ثم يؤمرُ أن يَنْ","عَتَ بالجود والنَّدى سحابه",21,"ب",2,0],["يسلون بالآثار بعد صحابها","ومثار حزني فيك بالآثار",22,"ر",1,0],["(يسلح) يومي ، يرى ميسرة","يرتئي (عيبان) ، يرنو ميمنه",23,"ن",2,0],["يُسلي التقادمُ عن ثُكْلٍ وعندهُمُ","ثُكْل عليه يُعينُ الجِدَّةَ القِدَم",24,"م",1,0],["يُسَلِّى قلوب الوالهين ملاحةً","ويذهب بالأحزان أيَّانَ يُعْرِبُ",25,"ب",1,0],["يسلِّم مهجتَهُ سائما","كما مدَّ راحتَه البائعُ",26,"ع",1,0],["يسلوهُ خوّانٌ بعهد وارد","غدرانَ غدر مالهن مغيضُ",27,"ض",1,0],["يسلم الأمر في أيام محنته","وإن تمكن من أعدائه نظرا",28,"ر",2,0],["يسلُّ اللحظُ منها مَشْرَفِيَّاً","لقتلي ثمّ يُغْمِدُه النُّعاسُ",29,"س",1,0],["يُسلّي فؤادي عن نسيبي مدحُهُ","فلا كان غيلان ولا ذُكِرت مَيُّ",30,"ي",1,0],["يَسُلُّ مِنَ الجُفونِ السودِ بيضاً","فَما أَنفَكُّ مِنها في قِتالِ",31,"ل",1,0],["يُسلِمُ من يَعتصمُ","به ومن يَلتَزِمُ",32,"م",1,0],["يُسليهِ لينُ مجسّها ويروقهُ","تَرقيشها عن سمِّ نابٍ ينقعُ",33,"ع",1,0],["يُسَلُّ لهمْ من الجَفنَينِ خوفاً","معَ اللّيلِ الكرَى والمَشرَفيّ",34,"ي",1,0],["يَسلّ الروح مِن بَدَني","بِعَينيهِ وَلا أَدري",35,"ر",2,0],["يَسَلُّ عَلى قَلبي الفُتور مُهنَّداً","مِن السَيف أَمضى حينَ يَغمدا وَيَنضى",36,"ض",2,0],["يَسلب القُرب قَلبَهُ","وَهُوَ بِالقَرب يَفرَح",37,"ح",1,0],["يَسلم خَدّاهُ عَلى لدغِها","وَلَدغُها في كَبدي باقي",38,"ي",1,0],["يُسْلي قلوبًَ العاشقين","عنِ الأَحبّة والحبائب",39,"ب",1,0],["يسليك بل ينسيك في الت","حقيق عن رشأ وعذرا",40,"ر",2,0],["يسلبون الورى خير ما يملكون","وقفوا مسدلين في الصباح الظلام",41,"م",1,0],["يَسُلُّونَ بينَ الأَمانِي وبيني","سيوفَ القِلى ورماحَ البِعادِ",42,"د",1,0],["يسليك عنه أن ملأتَ فؤادَه","من كلّ فائدةٍ تقالُ وتُفعَلُ",43,"ل",1,0],["يسلو عن الرفقاء من","أنسٍ به مسترفقُهْ",44,"ق",2,0],["يسلبن جيداً ولحظاً","من الظباء الرواني",45,"ن",2,0],["يُسلسِلُ دمعي بارقُ الحيِّ مَوهِناً","وتُضرِمُ أنفاسي الصَّبا والشَّمائلُ",46,"ل",1,0],["يَسُلُّ سُيُوفَ اللَّحْظِ مِنْهُ فَبِيضُهُ","إِذَا رامَ فَتْكَاً في المُحبِّين سُودُهُ",47,"د",2,0],["يَسلُّ عَلَيْنَا مُرْهَفاتِ لَواحِظٍ","لها كلَّ يَوْمٍ مِنْ يَدِ السِّحْرِ خَارِطُ",48,"ط",1,0],["يُسلّي لَفْظُكَ الصَّبَّ المُعَنَّى","وَيَشْفي ذِكْرُكَ الدَّنِفَ العَليلا",49,"ل",2,0],["يَسلو بِها قَلبي قَديم مَآربي","كانَت وَيَنزَع عَن أَسى وَحبور",50,"ر",1,0],["يَسلو المُحب عَن الحَبيب إِذا صَبا","تيهاً لِواشٍ آثمٍ خَنّاس",51,"س",1,0],["يسلبون الملك حتى أفسدوا","أمره رغم الملوك المصلحين",52,"ن",1,0],["يَسُلُّ من الجفونِ سيوفَ لحظٍ","بها يدعو القلوبَ إلى البِراز",53,"ز",1,0],["يسلم لنا حمدان من الأتلافي","خبر الفلاحي يكسر الاسرافي",54,"ف",2,0],["يُسَلسِلُها بِالدَّمعِ عَن معضلِ الهَوى","وَعَن قَلبِهِ المَجروحِ صَحَّ غَرامُهُ",55,"م",2,0],["يسل أبيض مثل النار ملتهباً","كأنه قلبه النار الذي اضطرما",56,"م",2,0],["يسل علينا من لحاظ جفونه","سيوفا أماتتنا وإن شاء أحيتنا",57,"ن",2,0],["يَسِلُّ رَأْياً كَالسَّيْفِ وَقْفَتُهُ","وَيَحْتَوِي سَيْفَهُ وَيُغْمدُهُ",58,"د",2,0],["يسلبنَ ألباب الرجال بنظرة","واللحظ مغناطيس كل جَنانِ",59,"ن",1,0],["يَسلّ حساماً راقصاً في عراصهِ","رَقيصَ سفيهٍ في عراصِ الملاعبِ",60,"ب",1,0],["يسلي المحبين طول النأي بينهمُ","ويلتقي طرف أخرى فيأتلف",61,"ف",1,1],["يسلبن أرباب العقول عقولهم","ويرغن منه حيلةً ونفارا",62,"ر",2,0],["يسَلّمُ حكمٌ كان بالقصد صوبنا","وان يحكم القاضي عليهم يسلم",63,"م",1,0],["يسْلو الحزين إذا ما نشْوَةٌ حدثت","حتى إذا ما صحا من سكرة نكسَا",64,"س",2,0],["يُسلي القَلبَ كالبُشرى بِروحٍ","ويُحيي الرُّوحَ كالماءِ الزُّلالِ",65,"ل",1,0],["يَسلُكُ في الكُلِّ طَريقَ النَدى","مُنَكَّباً عَن طُرُقِ الغَدرِ",66,"ر",1,0],["يسلسل دمعا فوق خديه مرسلا","ويروي حديثا في الجفا ما به خفا",67,"ف",2,0],["يسلسل عن عطاك حديث سهل","ويسنده إلى صلة ووهب",68,"ب",1,0],["يسلم غيباً وهو بالروح شاهدُ","ويحزن فقدا وهو بالقلب واجدُ",69,"د",1,1],["يسلُّ من العزمِ المُؤَيَّدِ صارماً","يودُّ القَضا أنْ لو غدا وهو حامله",70,"ل",2,0],["يَسُلُّ مُهَنَّداً وَيَسُلُّ عَزماً","فَيَفتِكُ في الوَغى بِمُهَنَّدَينِ",71,"ن",1,0],["يسلُّ النومَ عمداً من جُفوني","ويكويني بما في الخدِّ أوقدْ",72,"د",1,0],["يسلك الغور منجدا فاذا","غور يعدو محقوقفا في النجود",73,"د",1,0],["يسلّون أرواح العِدا من جسومهم","وشيكاً إذا ماهم صوارمهم سلّوا",74,"ل",3,0],["يَسلُكُ مِنها الصَعودُ مَن طَلَبَ ال","قَصدَ وَتَعوي سِباعُها كَلَبا",75,"ب",2,0],["يسلبن حلم الناسك الأواه","يسلمن جسمه إلى الدواهي",76,"ي",1,0],["يسلوا به المحزون هو والكيب","والمنهمك في شغل دنياه",77,"ا",2,0],["يَسُلّونَ السُيوفَ لِيَقتُلوني","وَقَد أَبطَنتُ مُحدَلَةً شِمالي",78,"ل",2,0],["يسلى عن الميت الشقيق شقيقه","فلو عاشر الخنساء ما ندبت صخرا",79,"ر",2,0],["يسُلُّ سُيوفاً ويرْمي نُصولاً","فتُهْدي نُجوماً وتُبْدي بُروقا",80,"ق",2,0],["يسليها ونار الحزن تذكو","ومنه القلب اصبح في كلام",81,"م",1,0],["يسلب البدر سناه إن بدا","في دياجي شعرها الوجه الجميل",82,"ل",1,0],["يُسَلسِلنَ بَرداً خالِصاً وَعُذوبَةً","شِفاءَ الغَليلِ وَالعُيونِ الحَواجِلِ",83,"ل",1,0],["يَسلُبُ الغُرُّ مِنهُم صِفَةَ الخا","لِقِ مِن علم الغَيبِ غَير مُبالِ",84,"ل",1,0],["يسلب العقل من الزاني ولو","لا ذِهاب العقل لم يزن أحد",85,"د",1,1],["يَسُلّ عليها المشرفيات جدولٌ","له ثغَبٌ عذبُ الرُضاب بَرودُ",86,"د",1,0],["يسلك القلب نهجهنّ إذا سر","ن وهل غيره بهن يتيم",87,"م",1,0],["يُسَلِّمُ صاحِبي فَيَقُدُّ شِبراً","بِهِ وَأَقُدُّ في رَدّي ذِراعا",88,"ع",2,0],["يسلّ من العزائم مرهفات","تسوم نواصي الحدثان جزا",89,"ز",2,0],["يسلحهم باسرارٍ تقيهم","عدوّاً لا ينام وَلا يخورُ",90,"ر",1,0],["يسل كهاما من لسان وكم نبا","وفي لمس أعراض الكرام يسنه",91,"ن",2,0],["يَسُلُّ مِن صارِمٍ وَنُطقٍ","عَضبَينِ في مَعرَكٍ وَنادِ",92,"د",1,0],["يَسلُبُ الأَلبابَ قَسرا","طَرفُها الماضي الصَقيل",93,"ل",1,0],["يسلو أخو اليأس حتى","يهنا ولا يتعنى",94,"ن",2,0],["يسلب اللب بتغريد فما","يظهر البلبل صوتا ونغم",95,"م",1,0],["يسلسل الليل بتذكاركم","مع المحبين إذا قيل جنَّ",96,"ن",1,0],["يسلّ من ألحاظه مذرباً","بغير أكباد الورى لم يغمد",97,"د",1,0],["يَسلُّ مِقوَلَهُ إِن شامَ مُنصُلَهُ","وَلِلخِطابِ كَما لِلحَربِ أَوطانُ",98,"ن",1,0],["يُسلم الروحَ فزادوا بالنواحْ","يذرفون الدمع دمع الحَزَنِ",99,"ن",1,0],["يسلم لي قسٌّ وسحبان وائل","ويرضى جرير مذهبي والفرزدق",100,"ق",1,0],["يسلّه الطيّب القرم الجسور العريب","تقول مفجوع في ذلّ اقصراه القراب",101,"ب",1,0],["يسلم لمهدي إلى نظامه","بتقديم ياء إذ تشدد لاما",102,"م",2,0],["يُسلبُ الحرفُ وتغدو","مهجةُ اللّصِ سحابة",103,"ب",2,0],["يسلمني الليل للإلهام في وسنٍ","ويطلب الناي قلبي ثم أسلمهُ",104,"م",2,0],["يَسَلْنِي نُخَاعِي : عَلامَ ارْتِجَافِي ؟","فَإِنِّي بِرَبِّي كَثِيِرُ السُّؤَالِ",105,"ل",1,0],["يسليكْ، ينسيكْ ضيقتكْ والكُرَب","ويعوِّضك عَن كُل غَايبْ",106,"ب",1,0],["يسلم إن رآه الصخر يسري","بليلٍ في الطريق إلى حراءِ",107,"ا",2,0],["يسلب عنها البرد قسرا كما","ينتزع الحلي ولم تدفع",108,"ع",1,0],["يُسلطنني انسيابك في عروقي","كما ينساب لحنا قد تغنّى",109,"ن",2,0],["يسلو بهم ليلُ الأسى، إذ أنهم","قد أسرجوا بصدورِهم قِنديلا",110,"ل",2,0],["يُسلِّمُني الضياعُ بكل ركنٍ","لأحلامٍ تسوِّرها القيودُ",111,"د",1,0],["يسلي طاغي الاحساس لَ حس بضيقه وكتمان","غياب الملهمه خلاه يشوف الاسم محبوبه",112,"ب",2,0],["يسلابها بحسابها والعلم هات ودوك ود","لامن دنا قرب الفنا للي يعيش بضل في",113,"ي",1,0],["يسلم ويسلم عِد ماخط قاريه","بالشعر حرفي من وصوفه تغنى",114,"ن",2,0],["يسلُّ بعينهِ اليمنى حساماً","على قلبي فيملئهُ خَبالا",115,"ل",2,0],["يسلّمُ لي با