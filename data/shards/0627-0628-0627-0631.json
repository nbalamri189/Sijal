{"poems":[[39,"أبارق أن يضغمكم الليث ضغمية","https://www.aldiwan.net/poem6871.html","الطويل"],[94,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[30,"نصبتم له قدرا فلما غلت لكم","https://www.aldiwan.net/poem5041.html","الطويل"],[63,"قضى بوقوف الركب حق المواقف","https://www.aldiwan.net/poem51551.html","الطويل"],[63,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[107,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[48,"أيعلم نجم طارق برزية","https://www.aldiwan.net/poem23016.html","الطويل"],[78,"يا ويلتا من موقف ما به","https://www.aldiwan.net/poem38997.html","الوافر"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[276,"هل عرس الظاعن المشيم","https://www.aldiwan.net/poem52049.html","مخلع البسيط"],[276,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[305,"ألم ترم الأطلال من حول جعشم","https://www.aldiwan.net/poem45455.html","الطويل"],[327,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[369,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[422,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[454,"هو الدين","https://www.aldiwan.net/poem977.html",""],[463,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[463,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[479,"إما تريني اليوم من لحمي الضبع","https://www.aldiwan.net/poem2158.html","الرجز"],[482,"أبارقا شمته بالغور لماحا","https://www.aldiwan.net/poem15196.html","الرجز"],[520,"رجونا قطع هجرك بالوصال","https://www.aldiwan.net/poem12224.html","الوافر"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62575","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105466","الطويل"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178071","الطويل"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206241",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108541","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100994","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101061","الطويل"],[1860,"","https://poetry.dctabudhabi.ae/diwan/poem/28796","البسيط"],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132214","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201697","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201311","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74212","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101232","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66320","السريع"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141508","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102730","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94387","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132192","الطويل"],[4875,"السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=133357",""],[5106,".. إِنَّ النِّفْطَ قَدْ جَبُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=151384",""],[5419,"وهل في الشعر يا أم ارحميني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=32254",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5558,"أردْتُ قطاف النجم من جانب البدْر","https://www.poetsgate.com/ViewPoem.aspx?id=211688",""],[5725,"اتى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189675",""],[5830,"وَ كُنْتُ السَّمَاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=200774",""],[5943,"أبا رامي حماك الله فاسلم","https://www.poetsgate.com/ViewPoem.aspx?id=37261",""],[5956,"كُلّنا نحيا بأعجوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184156",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""],[6093,"كمن سيغسل جلد الماء بالماء","https://www.poetsgate.com/ViewPoem.aspx?id=208607",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5957,"زرعت الحرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82433&r=&rc=71",""],[454,"هو الدين ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82679&r=&rc=43",""]],"verses":[["أبارق أن يضغمكم الليث ضغمية","يدع بارقاً مثل اليباب من السَّهْبِ",0,"ب",1,1],["أُباركُ في النَّاسِ أهلَ الطُّموحِ","ومَن يَسْتَلِذُّ ركوبَ الخطرْ",1,"ر",1,0],["أَبارَ بِكُم عَن دينِهِ كُلَّ ناكِثٍ","كَما الأُمَمُ الأولى أُبيرَت ثَمودُها",2,"د",3,0],["أباري بها دَمْعَ الحَيا وهو ذَارِفٌ","وأخلُفُه في رَبْعِها غيرَ ذارِفِ",3,"ف",1,0],["أَبارِقٌ بالغَديرِ أَذكَرَني","لَمْعَ الثَّنايا العِذابِ إذ لَمَعا",4,"ع",2,0],["أبَا رافعٍ لا يَرفعُ اللّهُ طاغيا","ولا يَدَعُ الخَصْمَ المُشاغِبَ نَاجيا",5,"ي",2,1],["أبا رافعٍ ما ذا لَقِيتَ بحُفرةٍ","طَوَتْ منكَ جبّاراً قضَى العُمرَ عاتيا",5,"ي",2,0],["أَبارِقُ هَذا المَوتِ سَبَّحَ رَبَّهُ","نَعَم وَأَعانَت أَكُمُهُ وَأَبارِقُه",6,"ق",2,0],["أبارزُ اللّهَ بعِصيانِهِ","وليسَ لي من دُونِهِ راحِمُ",7,"م",1,0],["أباريسُ أو برلين تحوى فتونها","إذا ازدهرت بالحسن كالكوكب السعد",8,"د",1,0],["أبارز اللَه بالخَطايا","واللَه سبحانه حليم",9,"م",1,0],["أَبارز بالقَبائح من يَراني","وأخفى الذنب وَهوَ بِهِ عَليم",10,"م",1,0],["إِبارِيَّةٍ هَوجاءَ مَوعِدُها الضُحى","إِذا أَرزَمَت جاءَت بِوِردٍ غَشَمشَمِ",11,"م",1,0],["أَبارَ الأَوَّلينَ وَكُلَّ قَرنٍ","وَعاداً مِثلَما بارَت ثَمودُ",12,"د",1,0],["أَبارِقٌ ما أَرى أم رأيةٌ نُشِرَتْ","أم كوكبٌ في سوادِ الّليلِ أم نار",13,"ر",1,0],["أبار بنور تقوى الله وجهاً","وقد يزهو على القمر المنير",14,"ر",1,0],["أبا راشد هذا اختيار موفق","وخير به وجه الزمان تهللا",15,"ل",2,0],["أبا راشد ما زيّن الحكم كالندى","وكالعدل فليهنأ به من تكفلا",15,"ل",2,0],["أبا راشد لا زلت للخير باذل","وللمكرمات الغر ما عشت موئلا",15,"ل",2,0],["أبارقٌ على الحمى أم شارقٌ","أم شمتَ من صبابتي ما لم تَشِمْ",16,"م",1,0],["أبارقٌ ما تَشيمُ عيني","أم المصابيحُ في الحُمولِ",17,"ل",1,0],["أبارَ من قيس قبيلاً والتَمَع","كأنما كانوا طعاماً فابتُلِع",18,"ع",1,0],["أبارقاً شِمتَه بالغَورِ لمّاحا","أهدَى لقلبِكَ أشجاناً وأتراحا",19,"ح",2,1],["أبارك في مباركها بياتاً","تبيت عراصه ملقى الرحال",20,"ل",1,0],["أباريقه قوم به امتلأوا وهم","نجوم بآفاق العلوم سواطع",21,"ع",1,0],["أبا راشد عش في زيادة نعمة","مقيَّدة من شكرك المتجدّدِ",22,"د",1,0],["أباري الورى شفع حفاة قواصداً","فذاك بسقيا من سحابك فائض",23,"ض",1,1],["أبارق ذاك الشِّعب هل أَضمر النّوى","تفرُّقهم أَو ضمَّهُنّ وَسيق",24,"ق",1,0],["أبارك واهنّي مِنْ يحبّه ويرضى به","تباريك مِنْ مثلي يهنّي معازيبه",25,"ب",2,0],["أبارزة النهدين باردة اللما","موردة الخدين موعدك السبت",26,"ت",1,0],["أباريس ما أنكرتنا عن جهالةٍ","وعند بني الدنيا بنا خُبر",27,"ر",1,0],["أباريس لولا ما بنا ما تقاصرت","نواظرنا عما حويت من الحسن",28,"ن",1,0],["أَبا رَبِيعَةَ إِنَّ الحَقَّ مَغْضَبَةٌ","آثَرْتَ قَومَكَ إِذْ نادَى مُنادِيها",29,"ه",2,1],["أباريس إن كانت على الأرض جنة","فأنت هي المأوى على رغم حاسد",30,"د",1,1],["أُبارح موقفي لم أروَ منه","ولكن التنوع من خصالي",31,"ل",2,0],["أُبارحُ عالمي ملآنَ سحراً","الى دنيا المصائب والهموم",32,"م",1,1],["أَبارق نَجد كَيفَ خلفت جيرَتي","بِحزوى وَهُم بَينَ الجَوانح خَيموا",33,"م",3,0],["أبارك للمولى السعيد بمنزل","جديد له بالعلم والفضل عامر",34,"ر",1,1],["أبارق في جنح ديماسِ","لاح لنا أم ضوء نبراسِ",35,"س",1,1],["أبارنها على الأمواج تحكي","عقاربَ فوق حيَّات تطير",36,"ر",1,1],["أبارزه لاهالعاً أو مولياً","ولا بد منا ماجدٌ يحرز المجدا",37,"د",2,0],["أبارق الثغر تبديه الثنيات","أم ضوء نار تجليه النيات",38,"ت",1,1],["أَبارِقُ عربٍ قد أزاح اللَياليا","فَضاءَت حصا لبنان لَيلاً لآليا",39,"ي",2,1],["أبارق ثغر من عذيب رضابه","قضت مهجتي بين العذيب وبارق",40,"ق",1,0],["ابارك بالورود وبالهدايا","وعلى الحساد ياروس السهاما",41,"م",2,0],["آبَارَ خَيمَتِهِ مَجْدَاً لَعَوْرَتِهِ","وَالرَّمْلُ فِيْ شَبَقٍ يَقَتاتُهُ وَثَنَا",42,"ن",2,0],["أبا رامي محملة عيوني","بنور رسالة الشعر الرصينِ",43,"ن",1,0],["أباريقه مثل النجوم وماؤه","على كثرة الوراد لا يترنق",44,"ق",1,0],["أباريقه عد النجوم وعرضه","البصري وصنعا في المسافة حددا",45,"د",2,0],["أباركُ باسمي يا براءُ مهنّئاً","وأرجو لك اليومَ الوفيرَ من الخير",46,"ر",1,0],["اباريق جيدٍ من لجين وعسجدٍ","يكركرها كالماء غنج الغرانق",47,"ق",1,0],["أُبَارِكُ فِي الكَوْنِ أَهْلَ النَّقَاءْ","وَ أَعْشِقُ كُلَّ البَهَا وَ الصَّفَاءْ",48,"ا",2,0],["أبا رامي حماك الله فاسلم","لمن في الله قد طلبوا الودادا",49,"د",2,1],["آبار نفط ، سمُّ غاز ، كهربا","خطُّ الحديد ، سفائنٌ تجري بكا",50,"ك",2,0],["أبارك ما لديك من المعالي","فما شاهدتُ بعد مداك حَدّا",51,"د",2,0],["أبا رُمَيثةَ إنَّ الشكرَ يشكرُكمْ","شكراً يليقُ بأقمارٍ ولألاءِ",52,"ا",2,0],["أبارز اللّه بقبح الخله","انتهك الزلة بعد الزله",53,"ه",1,0],["أبا رامي زرعتَ الحرفَ فينا","بصدقِ يراعةٍ تأتي اليقينا",54,"ن",2,1],["أبا راشد لا زلت للخير باذلا","وللمكرمات الغر ما عشت موئلا",55,"ل",2,0]]}