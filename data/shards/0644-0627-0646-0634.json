{"poems":[[110,"تأبط شرا","https://www.shoaraa.com/p12775",""],[82,"حبذا فتيان صدق أعرسوا","https://www.aldiwan.net/poem31454.html","الرمل"],[52,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[119,"هبوا طيفكم اعدى على الناي مسراه","https://www.aldiwan.net/poem40436.html","عموديه"],[128,"قالوا سيجمع أشعاري جهابذة","https://www.aldiwan.net/poem23789.html","البسيط"],[186,"لقد شغلتني دون شكركم البشرى","https://www.aldiwan.net/poem67072.html","الطويل"],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[353,"ذابت زبيدة من شوق لسيدها","https://www.aldiwan.net/poem20637.html","البسيط"],[382,"إلام إلام ظلما يا حسود","https://www.aldiwan.net/poem59453.html","البسيط"],[401,"إنا ذممنا على ما خيلت","https://www.aldiwan.net/poem626.html",""],[580,"زهادتي في جلستك","https://www.aldiwan.net/poem2820.html","مجزوء الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137639",""],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88634","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93596","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93694","الوافر"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83000","المتقارب"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[4755,"أنشودة المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=215431",""],[5122,"صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=34796",""],[5324,"رثاء والدي (رحمه الله)","https://www.poetsgate.com/ViewPoem.aspx?id=211105",""],[5431,"علّ القلوب من السماحة تلبسُ","https://www.poetsgate.com/ViewPoem.aspx?id=191469",""],[5431,"عنه الظلامُ بحول الله منكفئُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201569",""],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"نحن بالغيريين أقلُّ اهتماماً","https://www.poetsgate.com/ViewPoem.aspx?id=183330",""],[5977,"أشتاق لي","https://www.poetsgate.com/ViewPoem.aspx?id=213253",""],[6049,"اسمن عذارك","https://www.poetsgate.com/ViewPoem.aspx?id=35631",""],[6124,"قلبي لو هفا","https://www.poetsgate.com/ViewPoem.aspx?id=193659",""],[186,"لقد شغلتني دون شكركم البشرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55761&r=&rc=24",""],[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""]],"verses":[["لإن شككت بالحق إذنٌ فإنني","كفرت بعينٍ لا ترى الليل مظلما",0,"م",2,0],["لا نُشورٌ لِشَبابي بَعدَ ما","ماتَ مِن عُمري إلى يَومِ النُّشور",1,"ر",1,0],["لا نَشرَبُ الماءَ إِلا قالَ شارِبُنا","نِعمَ الأَميرُ كَفاهُ السَمعُ وَالبَصَرُ",2,"ر",1,0],["لان شط يا نور العيون مزاركم","فمن لمشوق ان تهوم جفناه",3,"ا",2,0],["لأن شعبي جزائي كان منه وكم","ناصرته في مجال الروع خذلاني",4,"ن",2,0],["لِأَنشُرَ طيبَ الحَمدِ مِن كُلِّ مَنطِقٍ","وَمِن كُلِ فكرٍ أَنشئ النَّظم وَالنَثرا",5,"ر",2,0],["لا نَشيدُ الأمواجِ رفَّةَ عن نَفس","ي ولم تَشفِها كؤوسُ الشمولِ",6,"ل",1,0],["لأُنشدَنَّكَ إذْ وَدَّعْتَها سَفَهاً","وَدِّعْ هُريرَةَ إنَّ الرَّكَبَ مُرتحِل",7,"ل",1,0],["لأنشدَهُ مع السارين بيتاً","له في كل قافيةٍ قصيد",8,"د",1,0],["لا نشتكي الوصم في الحرب ولا","نئن منها كنأنان السليم",9,"م",1,0],["لأَنَّ شعرَ لِحيتك","طُحلُب مَاءِ وَجْنَتك",10,"ك",1,0],["لأن شهور السرور تمر","كما لمع البرق في الظلمات",11,"ت",1,0],["لان شمخت بالطف عوج انوفكم","فبا لجدع قد كانَت احق واجدرا",12,"ر",2,0],["لأَنشدن الفَيافي عَن مَواطنهم","لَعَلَها عَنهُم تَروي لَنا خَبَرا",13,"ر",2,0],["لَأنشدها عَليك مِن المَراثي","نَوائح تَملأ الدُنيا عَويلا",14,"ل",2,0],["لأن شعيبا لأجل البنا","تِ أخدَمه اللَّه موسى كليمَه",15,"ه",1,0],["لأن شمس الضحى من أجله خلقت","فكيف عند نداه تخف في الحجب",16,"ب",1,0],["لا نَشتَكِي الجُوعَ إِلَّا زَخرَفُوهُ لنا","أَو حَوَّلُوا الصَّمتَ مِن عارٍ إلى دِينِ",17,"ن",1,0],["لأنشدته ..قال ويش العلم ويش","مايجيب العلم لك ، ورأس لاش",18,"ش",1,0],["لا نشتكي من جارَ إلا للذي","بَسطت يداهُ لخلقِه أِحسانا",19,"ن",2,0],["لانشوة إلاك أنت حبيبها","فعلام تُملأ بالفراق الأكؤسُ",20,"س",1,0],["لأن شعبيَ مجبولٌ بطيبته","عنه الظلامُ بحول الله منكفئُ",21,"ا",1,0],["لا نشربُ الماءَ في ذل إذا احتر بت","وجوفُنا يصطلي من نارها الرسنا",22,"ن",2,0],["لأن شكلك الكلي أول صادر من","من عرش الذات عرش الإرادتي",23,"ت",2,0],["‏ لا نشكر الأنسامَ وهي لطائفٌ","‏ ‏ لكنْ نذمُّ إذا هي الإعصارُ",24,"ر",1,0],["لا نشتكي في الحب خلاً كاذباً","لا ذل ..لا عدوان ...لا إرهاق",25,"ق",1,0],["لا نشتكي حرباً على إسلامنا","لا ظلم ..لا جوع ولا إزهاق",25,"ق",1,0],["لأنش عن الحار في روحي تبيزتي","وجرح الجفا دون سبه يصعب أعلاجه",26,"ج",2,0],["لانْشَقَّ بَحْرٌ مِنْ ضِيَاءٍ وَازْدَهَى فَجْرُ الهَنَا","لِيْ فِي هَوَاكًمْ قِصَّةٌ كَانَتْ سَرَابًا قَدْ دَنَا",27,"ن",2,0],["لأنشر طيب الحمد من كل منطق","ومن كل فكر أنشيء النظم والنثرا",28,"ر",2,0],["لا نشتكي اليومَ سوى لوعةٍ","كوّنها بُعدُكِ تكوينا",29,"ن",2,0],["لا نشتكي إلا صفاءاً غدا","بشفَةِ الذكرى يناجينا",29,"ن",2,0]]}