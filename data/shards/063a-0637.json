{"poems":[[53,"أرى بغداد قد أخنى عليها","https://www.aldiwan.net/poem30511.html","الوافر"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[55,"عيناي شامت دمي والشؤم في النظر","https://www.aldiwan.net/poem26366.html","البسيط"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[93,"هنيئاً أيها الملك الهمام","https://www.aldiwan.net/poem11307.html","الوافر"],[83,"يهني زمانك أعياد مجددة","https://www.aldiwan.net/poem54232.html","البسيط"],[27,"فلا خوف عليك ولن تراعي","https://www.aldiwan.net/poem5978.html","الوافر"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"يعقوب ويل أبيك أية هوة","https://www.aldiwan.net/poem66056.html","الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[28,"لولا يدا بشر بن مروان لم أبل","https://www.aldiwan.net/poem1236.html",""],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[44,"غطت يداك علي في لحدي","https://www.aldiwan.net/poem30259.html","الكامل"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[105,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[148,"الناس قد رحلوا وأنت مقيم","https://www.aldiwan.net/poem68438.html","الكامل"],[162,"لا تركنن إلى الهوى","https://www.aldiwan.net/poem67809.html","مجزوء الكامل"],[180,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[184,"سندانة من عمل الفخار","https://www.aldiwan.net/poem43760.html","الرجز"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[196,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[197,"لأمر فيه يرتفع لسحاب","https://www.aldiwan.net/poem45377.html","الوافر"],[202,"يا من بكى عند العتاب","https://www.aldiwan.net/poem53227.html","مجزوء الكامل"],[227,"خل من يأتم بالصل","https://www.aldiwan.net/poem50968.html","مجزوء الرمل"],[233,"يا رب كيف بلوتني بعصابة","https://www.aldiwan.net/poem31783.html","الكامل"],[254,"غطت البظراء لما","https://www.aldiwan.net/poem48436.html","مجزوء الرمل"],[266,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[277,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[298,"أغدوا واعد الحي الزبالا","https://www.aldiwan.net/poem45471.html","الوافر"],[318,"غطى الخديد بيميناه فقلت له","https://www.aldiwan.net/poem61774.html","البسيط"],[403,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[406,"انظر شماتة عاذلي وسروره","https://www.aldiwan.net/poem32559.html","الكامل"],[406,"ومهفهف بي من فتور جفونه","https://www.aldiwan.net/poem32567.html","الكامل"],[451,"غطست فيه حين بعثرت","https://www.aldiwan.net/poem61334.html","الخفيف"],[459,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[459,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[459,"الشعر ما علم العلياء واكتسبت","https://www.aldiwan.net/poem15439.html","البسيط"],[462,"غطت الثلوج الأرض فهي حمامة","https://www.aldiwan.net/poem3263.html","عموديه"],[477,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[551,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["غَطى قِمَمَ النَجادِ فَكُلُّ وادٍ","عَلى نَشَزاتِهِ سِبٌّ جَديدُ",0,"د",1,0],["غَطّى رِداءُ العِزِّ عَوراتِهِم","فَاِفتُضِحوا بِالذُلِّ أَيَّ اِفتِضاح",1,"ح",1,0],["غَطارِفةٌ إن حُورِبُوا أرْعَفوا القَنا","وإنْ سُئِلوا النُّعْمى لَدى السِّلْمِ أجزَلوا",2,"ل",3,0],["غَطّى هَواكِ عَلى قَلبي فَدَلَّهَهُ","وَالقَلبُ أَعظَمُ سُلطاناً مِنَ البَصَرِ",3,"ر",1,0],["غَطّى النَشازَ مَعَ الآكامِ فَاِشتَبَها","كِلاهُما في سَوادِ اللَيلِ مَغمورُ",4,"ر",1,0],["غَطَارِفَةٌ بَنَوْا مَجْداً جديداً","يَزِيدُ جَلالَهُ المَجْدُ القُدَامُ",5,"م",1,0],["غطّى الهوى عقلَهُ حتى إذا ظهرت","له المراشدُ أعشاه وأعماهُ",6,"ا",2,0],["غَطاريفٌ يَبيتُ الجارُ فيهِم","قَريرَ العَينِ في أَهلٍ وَمالِ",7,"ل",1,0],["غطّى ثناك على عبد الرحيم فما","ترنو لأنجمهِ أبصار أفهام",8,"م",1,0],["غطَّى عماكَ على هُداكَ فجئتني","وعلى بصيرةِ هادييك غمامُ",9,"م",1,0],["غَطَّت بِهِ الأَرضُ الفَضاءَ وَجَوَّها","وَكَسَت مَناكِبَها بِهِ الآكامُ",10,"م",1,0],["غَطا بِالعِثيَرِ البَيداءَ حَتّى","تَحَيَّرَتِ المَتالي وَالعِشارُ",11,"ر",1,0],["غَطاريفُ مِن قَيسٍ مَتى أَدعُ فيهُمِ","وَخِندَفَ يَأتوا لِلصَريخِ المُثَوِّبِ",12,"ب",1,0],["غطارفةٌ شُمّ العرانين قادةٌ","يَعُلّونَ أطرافَ الرّماحِ النواهِلِ",13,"ل",1,0],["غطارفةٌ مثل الجبال حُلومُهُمْ","تكونُ لهم شمُ الجبال هضابا",14,"ب",2,0],["غَطَّت يَداكَ عَلَيَّ في لَحدي","وَبَقيتَ ما مُدَّ المَدى بَعدي",15,"ي",1,1],["غَّطى جناحاكِ أطفالي فكُنتِ لهُمْ","ثغراً إذا استيقَظوا ، عِيناً اذا رقَدوا",16,"د",3,0],["غطفانُ هُبِّي للكريهةِ واغنمي","من تمرِ خيبرَ حظَّكِ المقسوما",17,"م",2,0],["غِطَمٌّ خِضَمُّ المَوج أورَقُ جَحفَلٌ","لُهامٌ كمِرْداةِ الصّفيحِ المُلَملَم",18,"م",1,0],["غَطّاهُ مِن أَنفِهِ وَفيهِ","وَمُقلَتَيهِ دَمُ الدِماغِ",19,"غ",1,0],["غَطَّى على المتبرعينَ مُبجِّل","بحياتِه لبلادِه يتبَّرع",20,"ع",1,0],["غطَّت على سُود الليالي ليلةٌ","وعلى المصائبِ كلِّهِنَّ مُصاب",21,"ب",1,0],["غطارفَ الحلةِ الفيحاءِ أنكُمُ","في كل مَكرمُةٍ فِرسانُ ميدان",22,"ن",1,0],["غطّى العيونَ فلم تَجِدْ نَظَراً","دمعٌ أعزُّ عليّ من نَظَري",23,"ر",2,0],["غط الهديرُ فغضَّت منه ثاغيةٌ","ورددت ثغيّها من خلفِها أُخر",24,"ر",1,0],["غَطَّتكَ من آذى ذنبك موجة","فيها الهلاك وما أراك تقوم",25,"م",1,0],["غَطّى عَلَيهِ بِالصَفا","أَهلُ المَوَدَّةِ وَالصَفاءِ",26,"ا",2,0],["غَطارفةٌ تَمضي العُصورُ وَذكرُهُم","فتيُّ شَبابٍ كُلَما شِخنَ أَيفَعا",27,"ع",2,0],["غطاؤُها جاء على مقدار","كأنما قد خطّ بالبركار",28,"ر",1,0],["غطّهُ مرّةً وأُخرى وأُخرى","قائل اِقرأ ولم يكن إقراءُ",29,"ا",2,0],["غطفانٌ ذاتُ الرقاعِ بواطٌ","دومةٌ والعشيرة الأبواءُ",29,"ا",2,0],["غطارفة شمُّ الأُنوفِ تسنَّموا","من الدولةِ الغَرّاءِ أعلى المراتبِ",30,"ب",1,0],["غطارفةٌ إذا انتسبوا ولكن","إذا عُدُّوا تصعلكَ الانتسابُ",31,"ب",1,0],["غَطَّيتَ ذنبَك بالبُكا","عنّي فلستُ بعارِفِه",32,"ه",1,0],["غَطَسوا في الماءِ جهلاً","وغطسنا في البواطي",33,"ي",1,0],["غَطّى الثَراءُ عَلى عُيوبِهِم وَكَم","مِن سَوءَةٍ غَطّى عَليها المالُ",34,"ل",1,0],["غطتِ البظراء لما","عاينت مفتاح ديري",35,"ر",2,1],["غَطارِفةٌ شُمٌّ تَرَبّوا أَعِزَّةً","فَما شَمَّ ريح الذُلِّ مِنهُم معاطسُ",36,"س",1,0],["غَطارِفَةٌ لهم سُلْطانُ عَدْلٍ","يَسُنُّ لهم مَكارِمَهم ويُسْني",37,"ي",1,0],["غَطارِفُ لا يَصُدُّ الضَيفُ عَنهُم","إِذا ما طَلَّقَ البَرَمُ العِيالا",38,"ل",2,0],["غَطّى الخَديدُ بِيَميناهُ فَقُلتُ لَهُ","رُحماكَ لا تَلقَني في مُنتَهى النَكَدِ",39,"د",1,1],["غَطا دمعها أَنسانُها فَكَأَنَّها","غَريق تَسامى فَوقه لُجَجُ البَحرِ",40,"ر",1,0],["غَطّى ظَلامُ الشّعْرِ من وَجناتِه","صُبحاً تضيءُ الأرضُ من إشراقهِ",41,"ق",2,0],["غَطّى الجمالُ على ذَميمِ فعالِهِ","والموتُ يَستُرهُ صِقالُ المُرهَفِ",42,"ف",1,0],["غطست فيه حين بعثرت","ورشته كالضياء المنغّم",43,"م",1,1],["غطاريف صيدٌ ما استكانوا لحادث","ولا أذعنوا للجائر المتعشرم",44,"م",1,0],["غطاريف أقيالٌ كأنَّ أكفَّهمْ","سحاب شتاءٍ أغفلته شمائله",45,"ل",2,0],["غطَّى شموس عُلومي من بلاغته","دجْنٌ مسفٌ نفوعٌ ودقهُ هللُ",46,"ل",1,0],["غطت الثلوج الأرض فهي حمامة","بيضاء منها الجليد غير مطوق",47,"ق",1,1],["غطت على طرفها الأطماع فانخدعت","وساقها الجشع الممقوت للحرب",48,"ب",1,0],["غَطارِفٌ كِرامٌ","بيضُ الوُجوهِ صيدُ",49,"د",1,0],["غطارفة شوس مساعير في الوغى","مداعيس في الهيجا إذا هي تنشب",50,"ب",1,0]]}