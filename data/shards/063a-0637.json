{"poems":[[53,"أرى بغداد قد أخنى عليها","https://www.aldiwan.net/poem30511.html","الوافر"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[55,"عيناي شامت دمي والشؤم في النظر","https://www.aldiwan.net/poem26366.html","البسيط"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[93,"هنيئاً أيها الملك الهمام","https://www.aldiwan.net/poem11307.html","الوافر"],[83,"يهني زمانك أعياد مجددة","https://www.aldiwan.net/poem54232.html","البسيط"],[27,"فلا خوف عليك ولن تراعي","https://www.aldiwan.net/poem5978.html","الوافر"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"يعقوب ويل أبيك أية هوة","https://www.aldiwan.net/poem66056.html","الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[28,"لولا يدا بشر بن مروان لم أبل","https://www.aldiwan.net/poem1236.html",""],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[44,"غطت يداك علي في لحدي","https://www.aldiwan.net/poem30259.html","الكامل"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[105,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""]],"verses":[["غَطى قِمَمَ النَجادِ فَكُلُّ وادٍ","عَلى نَشَزاتِهِ سِبٌّ جَديدُ",0,"د",1,0],["غَطّى رِداءُ العِزِّ عَوراتِهِم","فَاِفتُضِحوا بِالذُلِّ أَيَّ اِفتِضاح",1,"ح",1,0],["غَطارِفةٌ إن حُورِبُوا أرْعَفوا القَنا","وإنْ سُئِلوا النُّعْمى لَدى السِّلْمِ أجزَلوا",2,"ل",3,0],["غَطّى هَواكِ عَلى قَلبي فَدَلَّهَهُ","وَالقَلبُ أَعظَمُ سُلطاناً مِنَ البَصَرِ",3,"ر",1,0],["غَطّى النَشازَ مَعَ الآكامِ فَاِشتَبَها","كِلاهُما في سَوادِ اللَيلِ مَغمورُ",4,"ر",1,0],["غَطَارِفَةٌ بَنَوْا مَجْداً جديداً","يَزِيدُ جَلالَهُ المَجْدُ القُدَامُ",5,"م",1,0],["غطّى الهوى عقلَهُ حتى إذا ظهرت","له المراشدُ أعشاه وأعماهُ",6,"ا",2,0],["غَطاريفٌ يَبيتُ الجارُ فيهِم","قَريرَ العَينِ في أَهلٍ وَمالِ",7,"ل",1,0],["غطّى ثناك على عبد الرحيم فما","ترنو لأنجمهِ أبصار أفهام",8,"م",1,0],["غطَّى عماكَ على هُداكَ فجئتني","وعلى بصيرةِ هادييك غمامُ",9,"م",1,0],["غَطَّت بِهِ الأَرضُ الفَضاءَ وَجَوَّها","وَكَسَت مَناكِبَها بِهِ الآكامُ",10,"م",1,0],["غَطا بِالعِثيَرِ البَيداءَ حَتّى","تَحَيَّرَتِ المَتالي وَالعِشارُ",11,"ر",1,0],["غَطاريفُ مِن قَيسٍ مَتى أَدعُ فيهُمِ","وَخِندَفَ يَأتوا لِلصَريخِ المُثَوِّبِ",12,"ب",1,0],["غطارفةٌ شُمّ العرانين قادةٌ","يَعُلّونَ أطرافَ الرّماحِ النواهِلِ",13,"ل",1,0],["غطارفةٌ مثل الجبال حُلومُهُمْ","تكونُ لهم شمُ الجبال هضابا",14,"ب",2,0],["غَطَّت يَداكَ عَلَيَّ في لَحدي","وَبَقيتَ ما مُدَّ المَدى بَعدي",15,"ي",1,1],["غَّطى جناحاكِ أطفالي فكُنتِ لهُمْ","ثغراً إذا استيقَظوا ، عِيناً اذا رقَدوا",16,"د",3,0],["غطفانُ هُبِّي للكريهةِ واغنمي","من تمرِ خيبرَ حظَّكِ المقسوما",17,"م",2,0],["غِطَمٌّ خِضَمُّ المَوج أورَقُ جَحفَلٌ","لُهامٌ كمِرْداةِ الصّفيحِ المُلَملَم",18,"م",1,0],["غَطّاهُ مِن أَنفِهِ وَفيهِ","وَمُقلَتَيهِ دَمُ الدِماغِ",19,"غ",1,0],["غَطَّى على المتبرعينَ مُبجِّل","بحياتِه لبلادِه يتبَّرع",20,"ع",1,0],["غطَّت على سُود الليالي ليلةٌ","وعلى المصائبِ كلِّهِنَّ مُصاب",21,"ب",1,0],["غطارفَ الحلةِ الفيحاءِ أنكُمُ","في كل مَكرمُةٍ فِرسانُ ميدان",22,"ن",1,0],["غطّى العيونَ فلم تَجِدْ نَظَراً","دمعٌ أعزُّ عليّ من نَظَري",23,"ر",2,0],["غط الهديرُ فغضَّت منه ثاغيةٌ","ورددت ثغيّها من خلفِها أُخر",24,"ر",1,0]]}