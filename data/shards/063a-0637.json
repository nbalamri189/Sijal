المحال","https://www.poetsgate.com/ViewPoem.aspx?id=161807",""],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5150,"اللحن الخالد - دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=202798",""],[5225,"أصغي لصوتك ولا جاني نداك","https://www.poetsgate.com/ViewPoem.aspx?id=36750",""],[5246,"ما للحياة أراها تُبعِد الفُضَلا","https://www.poetsgate.com/ViewPoem.aspx?id=187093",""],[5277,"أين المها....أين الصوادحْ","https://www.poetsgate.com/ViewPoem.aspx?id=192053",""],[5277,"جوريّة قيسية","https://www.poetsgate.com/ViewPoem.aspx?id=200587",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[5351,"عشر همسات وهمسة","https://www.poetsgate.com/ViewPoem.aspx?id=202051",""],[5362,"صبحته عند المساء فقال لي","https://www.poetsgate.com/ViewPoem.aspx?id=170366",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5409,"شهد الليل غارة للغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=155312",""],[5409,"تأتي الحياة فترتدينا برهةً","https://www.poetsgate.com/ViewPoem.aspx?id=155301",""],[5411,"هذا نَصيبك منْ شِعْري","https://www.poetsgate.com/ViewPoem.aspx?id=185429",""],[5461,"يا سحايب سراة ابها","https://www.poetsgate.com/ViewPoem.aspx?id=8548",""],[5725,"اغرى العذول","https://www.poetsgate.com/ViewPoem.aspx?id=199894",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[6097,"التّيه","https://www.poetsgate.com/ViewPoem.aspx?id=197427",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[6218,"وطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65865&r=&rc=19",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[6259,"أبا الفضل طال الليل أم خانني صبري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59424&r=&rc=72",""],[402,"هنيئا أيها الملك الهمام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54058&r=&rc=910",""],[4222,"قد أهدي الإثراء في الإيفاض لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52869&r=&rc=161",""]],"verses":[["غطاريف من إنس يحاذر طيفهم","إذا خلفوا الأشلاء جان ومارد",0,"د",1,0],["غَطى قِمَمَ النَجادِ فَكُلُّ وادٍ","عَلى نَشَزاتِهِ سِبٌّ جَديدُ",1,"د",1,0],["غَطّى رِداءُ العِزِّ عَوراتِهِم","فَاِفتُضِحوا بِالذُلِّ أَيَّ اِفتِضاح",2,"ح",1,0],["غَطارِفةٌ إن حُورِبُوا أرْعَفوا القَنا","وإنْ سُئِلوا النُّعْمى لَدى السِّلْمِ أجزَلوا",3,"ل",3,0],["غَطّى هَواكِ عَلى قَلبي فَدَلَّهَهُ","وَالقَلبُ أَعظَمُ سُلطاناً مِنَ البَصَرِ",4,"ر",1,0],["غَطّى النَشازَ مَعَ الآكامِ فَاِشتَبَها","كِلاهُما في سَوادِ اللَيلِ مَغمورُ",5,"ر",1,0],["غَطَارِفَةٌ بَنَوْا مَجْداً جديداً","يَزِيدُ جَلالَهُ المَجْدُ القُدَامُ",6,"م",1,0],["غطّى الهوى عقلَهُ حتى إذا ظهرت","له المراشدُ أعشاه وأعماهُ",7,"ا",2,0],["غَطاريفٌ يَبيتُ الجارُ فيهِم","قَريرَ العَينِ في أَهلٍ وَمالِ",8,"ل",1,0],["غطّى ثناك على عبد الرحيم فما","ترنو لأنجمهِ أبصار أفهام",9,"م",1,0],["غطَّى عماكَ على هُداكَ فجئتني","وعلى بصيرةِ هادييك غمامُ",10,"م",1,0],["غَطَّت بِهِ الأَرضُ الفَضاءَ وَجَوَّها","وَكَسَت مَناكِبَها بِهِ الآكامُ",11,"م",1,0],["غَطا بِالعِثيَرِ البَيداءَ حَتّى","تَحَيَّرَتِ المَتالي وَالعِشارُ",12,"ر",1,0],["غَطاريفُ مِن قَيسٍ مَتى أَدعُ فيهُمِ","وَخِندَفَ يَأتوا لِلصَريخِ المُثَوِّبِ",13,"ب",1,0],["غطارفةٌ شُمّ العرانين قادةٌ","يَعُلّونَ أطرافَ الرّماحِ النواهِلِ",14,"ل",1,0],["غطارفةٌ مثل الجبال حُلومُهُمْ","تكونُ لهم شمُ الجبال هضابا",15,"ب",2,0],["غَطَّت يَداكَ عَلَيَّ في لَحدي","وَبَقيتَ ما مُدَّ المَدى بَعدي",16,"د",2,1],["غَّطى جناحاكِ أطفالي فكُنتِ لهُمْ","ثغراً إذا استيقَظوا ، عِيناً اذا رقَدوا",17,"د",3,0],["غطفانُ هُبِّي للكريهةِ واغنمي","من تمرِ خيبرَ حظَّكِ المقسوما",18,"م",2,0],["غِطَمٌّ خِضَمُّ المَوج أورَقُ جَحفَلٌ","لُهامٌ كمِرْداةِ الصّفيحِ المُلَملَم",19,"م",1,0],["غَطّاهُ مِن أَنفِهِ وَفيهِ","وَمُقلَتَيهِ دَمُ الدِماغِ",20,"غ",1,0],["غَطَّى على المتبرعينَ مُبجِّل","بحياتِه لبلادِه يتبَّرع",21,"ع",1,0],["غطَّت على سُود الليالي ليلةٌ","وعلى المصائبِ كلِّهِنَّ مُصاب",22,"ب",1,0],["غطارفَ الحلةِ الفيحاءِ أنكُمُ","في كل مَكرمُةٍ فِرسانُ ميدان",23,"ن",1,0],["غطّى العيونَ فلم تَجِدْ نَظَراً","دمعٌ أعزُّ عليّ من نَظَري",24,"ر",2,0],["غط الهديرُ فغضَّت منه ثاغيةٌ","ورددت ثغيّها من خلفِها أُخر",25,"ر",1,0],["غَطَّتكَ من آذى ذنبك موجة","فيها الهلاك وما أراك تقوم",26,"م",1,0],["غَطّى عَلَيهِ بِالصَفا","أَهلُ المَوَدَّةِ وَالصَفاءِ",27,"ا",2,0],["غَطارفةٌ تَمضي العُصورُ وَذكرُهُم","فتيُّ شَبابٍ كُلَما شِخنَ أَيفَعا",28,"ع",2,0],["غطاؤُها جاء على مقدار","كأنما قد خطّ بالبركار",29,"ر",1,0],["غطّهُ مرّةً وأُخرى وأُخرى","قائل اِقرأ ولم يكن إقراءُ",30,"ا",2,0],["غطفانٌ ذاتُ الرقاعِ بواطٌ","دومةٌ والعشيرة الأبواءُ",30,"ا",2,0],["غطارفة شمُّ الأُنوفِ تسنَّموا","من الدولةِ الغَرّاءِ أعلى المراتبِ",31,"ب",1,0],["غطارفةٌ إذا انتسبوا ولكن","إذا عُدُّوا تصعلكَ الانتسابُ",32,"ب",1,0],["غَطَّيتَ ذنبَك بالبُكا","عنّي فلستُ بعارِفِه",33,"ه",1,0],["غَطَسوا في الماءِ جهلاً","وغطسنا في البواطي",34,"ط",2,0],["غَطّى الثَراءُ عَلى عُيوبِهِم وَكَم","مِن سَوءَةٍ غَطّى عَليها المالُ",35,"ل",1,0],["غطتِ البظراء لما","عاينت مفتاح ديري",36,"ر",2,1],["غَطارِفةٌ شُمٌّ تَرَبّوا أَعِزَّةً","فَما شَمَّ ريح الذُلِّ مِنهُم معاطسُ",37,"س",1,0],["غَطارِفَةٌ لهم سُلْطانُ عَدْلٍ","يَسُنُّ لهم مَكارِمَهم ويُسْني",38,"ن",2,0],["غَطارِفُ لا يَصُدُّ الضَيفُ عَنهُم","إِذا ما طَلَّقَ البَرَمُ العِيالا",39,"ل",2,0],["غَطّى الخَديدُ بِيَميناهُ فَقُلتُ لَهُ","رُحماكَ لا تَلقَني في مُنتَهى النَكَدِ",40,"د",1,1],["غَطا دمعها أَنسانُها فَكَأَنَّها","غَريق تَسامى فَوقه لُجَجُ البَحرِ",41,"ر",1,0],["غَطّى ظَلامُ الشّعْرِ من وَجناتِه","صُبحاً تضيءُ الأرضُ من إشراقهِ",42,"ق",2,0],["غَطّى الجمالُ على ذَميمِ فعالِهِ","والموتُ يَستُرهُ صِقالُ المُرهَفِ",43,"ف",1,0],["غطست فيه حين بعثرت","ورشته كالضياء المنغّم",44,"م",1,1],["غطاريف صيدٌ ما استكانوا لحادث","ولا أذعنوا للجائر المتعشرم",45,"م",1,0],["غطاريف أقيالٌ كأنَّ أكفَّهمْ","سحاب شتاءٍ أغفلته شمائله",46,"ل",2,0],["غطَّى شموس عُلومي من بلاغته","دجْنٌ مسفٌ نفوعٌ ودقهُ هللُ",47,"ل",1,0],["غطت الثلوج الأرض فهي حمامة","بيضاء منها الجليد غير مطوق",48,"ق",1,1],["غطت على طرفها الأطماع فانخدعت","وساقها الجشع الممقوت للحرب",49,"ب",1,0],["غَطارِفٌ كِرامٌ","بيضُ الوُجوهِ صيدُ",50,"د",1,0],["غطارفة شوس مساعير في الوغى","مداعيس في الهيجا إذا هي تنشب",51,"ب",1,0],["غَطَّى عليه اللَّيْلُ أَسْتَارَهُ","فبات في خَفْض وعَيْشٍ خَصِيبْ",52,"ب",1,0],["غَطَفان سيِّدُهم أبوك وخيرُهم","ولدوك حين تذكروا الإحسانا",53,"ن",2,0],["غطاريفُ يَدعون الكريمَ أخاهم","وإن لم يكن فيهم له مِنهُمُ صَهرُ",54,"ر",1,0],["غطارفة جحاجحة أسود","صدور جحافل وبدور غلسِ",55,"س",1,0],["غَطارِفَةٌ ما ضَرَّ مَن راحَ يَجتَلِي","مَحاسِنَهُم أَن لا تُقابِلَهُ الشَّمسُ",56,"س",1,0],["غطمطم علم منه حقا يمد من","اراد على وفق الارادة فاستدر",57,"ر",1,0],["غطت محاسنَ وجهها عن ناظري","هيفاءُ لم أرَ في البريةِ شبهها",58,"ه",2,1],["غطارف من أبناء عمرو بن عامر","فروع لها طيب الأرومة والأصلِ",59,"ل",1,0],["غطارفةٌ تَندى بُطونُ اكفهم","إذا نشفتْ ماءَ السّماءِ الأَباطحُ",60,"ح",1,0],["غطي التراب على قريعك وابرزي","في الناس كاشفةً لهم عن ساقِ",61,"ق",1,0],["غطارفةٌ لا تعقبُ الشمسُ مثلهم","ولو أنَّها في أُفقها منك تعقب",62,"ب",1,0],["غطارفةٌ غرُّ المساعي تقيَّلوا","أباً فأباً كانوا غطارفةً غرَّا",63,"ر",2,0],["غطارفةٌ زهرُ الوجوه لو أنَّهم","بها قابلوا شهب السما أطفأوا الشهبا",64,"ب",2,0],["غطريف غطريف غطريف مخالبه","بلوعة الحب محماة عَلى النار",65,"ر",1,0],["غطارفة زهر مضوا لسبيلهم","ألهفى على تلك الغطارفة الزهر",66,"ر",1,0],["غَطُّوا بأذيال التجاوز منكم","صفحات جانٍ للندامة جاني",67,"ن",2,0],["غطى هواه عليه فاستغوى ولا","ينفك يخبط في عمى وشماس",68,"س",1,0],["غطاريف طلاعون كل ثنية","تناذر في الأقطار منها القبائل",69,"ل",1,0],["غطارفةة شم الأنوف تخالهم","جبال شروري بارزات المناكب",70,"ب",1,0],["غَطَفَانُ الحَرباءِ حولَ حِمَاهَا","أنشَدَت فى جَمَالِها حين زاغُوا",71,"غ",3,0],["غطي عليَّ هَواه حَتّى أَنَّني","لَو دُست في جَمر الغَضا لَم أَحسس",72,"س",1,0],["غَطارف قَد وازنتهم بِفخارهم","نعم أَنتَ مِنهُم بِالأُبوَّة اَرجح",73,"ح",1,0],["غطارفة ساسو البلاد فأحسنوا","سياستها حتى أقرت لمردف",74,"ف",1,0],["غطارفة أقمار تم وجوههم","مطاعيم للأضياف في الحرب نهاس",75,"س",1,0],["غطارفٌ وغيرهم زعانفٌ","ينتهزون فرص الغوائل",76,"ل",1,0],["غطّى على الحسن منكم قبحُ روحكم","يا ليتكم كنتمُ جسماً بلا روح",77,"ح",1,0],["غطّى على النفس جسمي في القديم وقد","نَمَوت واليوم غطّت نفسيَ البدنا",78,"ن",2,0],["غطّى عليهم شَقاهم","في العيش قبل المنايا",79,"ا",3,0],["غطى الضجيج على صوت الهداة به","وأخرست جلبة الآلات كل فم",80,"م",1,0],["غطى على مخلوقه الخالقُ","يدرك هذا العارف الحاذقُ",81,"ق",1,1],["غطائي بها حانيات الغصون","وفرشي بها الورق المنتثر",82,"ر",1,0],["غطّى العذارُ على خدّيه حين بدا","وشى السواد على لوح من الورَقِ",83,"ق",1,0],["غَطارف ضَرابون هبراً عَلى الطلى","إِذا ما اِشمَأز المارِد المُتَجبر",84,"ر",1,0],["غطى الكسوف عليه إلا لمعةً","فكأنه حسناء تحت نقاب",85,"ب",1,0],["غطارف عرفوا بالعرف واتصفوا","بالفضل والشرف الموفي بفخرهم",86,"م",1,0],["غطاريف غالوا حقوق العباد","وما ارتدعوا بالردى الغائل",87,"ل",1,0],["غطوا محياك الجميل ونورهم","من نوره لو كان وجهك باديا",88,"ي",2,0],["غَطَّتْ بساعِدٍ كماءٍ يجْرِي","وَجْهاً يفُوق الوَرْدَ تبَّ القَطْرِ",89,"ر",1,1],["غطاهما ليل نقع في حنادسه","تكور الأزهر ان الشمس والقمر",90,"ر",1,0],["غطارفة ما إن ينال فخارهم","ومعشر صدقٍ فيهم الجد والحد",91,"د",1,0],["غطاهما سقف كوخ","يحكى بقايا طلول",92,"ل",1,0],["غطاريف شبوا في العرين وقادة","لهم حسب في ذروة الفضل يُنسَب",93,"ب",1,0],["غطت بها الاشلاء منبسط الثرى","فرفاتها فوق الصعيد صعيدُ",94,"د",1,0],["غطاريف سباقون في حلبه الندى","بعباس مرفوع لهم علم الفخر",95,"ر",1,0],["غَطَّت مَحَاسِنُهُ عَلَى عَينِي فَمَا","أبصَرتُ شَيئاً غَيرَ بَدرِ كَمَالِ",96,"ل",1,0],["غطّوك بالأزهار إلا طلعة","للشمس صوّرها القدير مثالا",97,"ل",2,0],["غَطّى العجاجُ بهِ نجومَ سمائهِ","لتنوبَ عنها أَنجُمُ الخُرْصانِ",98,"ن",1,0],["غَطّتْ فضيلتُهُ نقيضةَ دهرِنا","عنّا وأَذهبَ حَقُّهُ بالباطلِ",99,"ل",1,0],["غطوا السماءَ بدمع بالدما اشتركا","سما الربى لا سما الاجرام والديم",100,"م",1,0],["غطى سواده ظلمة الليل ولا ريت","ضيّعتها واستوحشت فيّ الاعصاب",101,"ب",1,0