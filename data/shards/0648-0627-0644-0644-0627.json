{"poems":[[110,"أذن بمن في السرى","https://www.shoaraa.com/p11793",""],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[23,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem21428.html","السريع"],[66,"العشق في أزل الآزال من قدم","https://www.aldiwan.net/poem67671.html","البسيط"],[87,"ملَك بأفق الرمل هلّ كريما","https://www.aldiwan.net/poem7888.html","الكامل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[92,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[92,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[53,"بَنَفْسَجٌ جُمِعَتْ أوراقُهُ فحَكَى","https://www.poetsgate.com/ViewPoem.aspx?id=27234",""],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[369,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[463,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[563,"كم غادة كاملة في حسنها","https://www.aldiwan.net/poem34207.html","الرجز"],[567,"يا راحلين إلى الديار الباقيه","https://www.aldiwan.net/poem52885.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48844","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63872","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203741",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79958","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77845","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101895","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101032","البسيط"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131323","الرجز"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45503","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27827","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124616","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88567","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125842","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94868","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4728,"الأمل قبلة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176950",""],[4755,"الوَقتُ مَربُوطٌ إِلى كاحِلِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=186135",""],[4767,"ك ر ب ل ا","https://www.poetsgate.com/ViewPoem.aspx?id=199934",""],[4816,"نيست","https://www.poetsgate.com/ViewPoem.aspx?id=8485",""],[4862,"ماقال شوقي قاله تضليلا","https://www.poetsgate.com/ViewPoem.aspx?id=123991",""],[4927,"ضِيم الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=80798",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5573,"اتعبني التقسيم والطرح والضرب","https://www.poetsgate.com/ViewPoem.aspx?id=200090",""],[5652,"معك الضياغم راسية فوق منزال","https://www.poetsgate.com/ViewPoem.aspx?id=177976",""],[5837,"عبدالعزيز القنيدي","https://www.poetsgate.com/ViewPoem.aspx?id=181088",""],[5858,"دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=188129",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""]],"verses":[["واللابسين نفوساً منذ أن نُفخت","ضيقاً تنازعهم أن يَخلعوا الطينا",0,"ن",2,0],["وَاللابِسِ الخَيلَ بِخَيلٍ إِذا","ثارَ غُبارُ الكَبَّةِ الثائِرِ",1,"ر",1,0],["وَاللابِسِ الخَيلَ إِذا أَحجَمَت","كَاللَيثِ في غاباتِهِ الباسِلِ",2,"ل",1,0],["وَاللامِ بِالأَلِفِ المَعطوفِ مُؤتَلِفٌ","كِلاهُما واحِدٌ في السَبَقِ مَعناءُ",3,"ا",2,0],["واللافظات عن القيق مرقّقا","والباسمات عن الجمان نظيما",4,"م",2,0],["واللائِذينَ بدعوى الصبر مَجْبَنةً","مُستَعصِمينَ بحبلٍ منه مَوهون",5,"ن",1,0],["والَّلاقِحينَ نَتاجَها بأعزِّ ما","ملَكَتْ يمينٌ من حِمىً وذمار",6,"ر",1,0],["و\" اللاذقيةُ \" هل \" ربٌّ \" يقوم بها","أم ربُّها العَلمُ المحبوبُ يرتفع",7,"ع",1,0],["واللازَوَرْدِيَّة ُ تزهُو بزُرْقَتِهَا","وسطَ الرياضِ على حُمْرِ اليواقيتِ",8,"ت",1,0],["واللاذقيَّةُ عانَقت مَرسينَ مِن","إسكَندرُونةَ والقلَى لمُباعِد",9,"د",1,0],["واللاّبسونَ عليها كُلَّ سابغةٍ","تَدَرُّجُ الرِّيحِ دَبَّتْ في مُتونِ إضا",10,"ض",2,0],["واللامزُ المرتابُ سلْمٌ صدرُه","وجارةُ البيت التي لا تتَّقى",11,"ق",2,0],["واللات والعزى ظهورانِ له","بما وراهما وما ورا هبل",12,"ل",1,0],["واللازمَ التهذيبِ في أعمالهِ","مثلَ التزامِ الشِّعرِ حرفَ القافيَهْ",13,"ي",2,0],["واللابسِ الخشنِ البالي على بدنٍ","قوامُه الواهن الواهي من الزاد",14,"د",1,0],["واللابسُ الشرفُ الذي أَضحى به","متفرّداً من دونِ كلِّ لباس",15,"س",1,0],["واللاعبون فنونُهم","بين الدعابة والغرابه",16,"ب",2,0],["واللام مع ماض بقد ويرتدف","بالنون مع مضارع ولا حذف",17,"ف",1,0],["واللام نب والذي ينقص من","ذيل له كرأسه الذي زُكِن",18,"ن",1,0],["واللام كالكاف الذي جمعتَه","على استواءِ ما به وضعتَه",18,"ه",1,0],["واللام كالكاف الذي جمعته","في كل ما في وضعه حققته",18,"ه",1,0],["واللامُ في الإفراد كالتي مضت","في دورها وها هنا قد اقتضت",18,"ت",1,0],["واللام في التمثيل كالثلث على","حدٍّ سوا وفي انقسام مسجلا",18,"ل",2,0],["واللام في انفراده مثل الالف","وافتل لبسط حكمه كالبا عُرِف",18,"ف",1,0],["واللامُ نصبٌ ثم باءُ الخطّ في","إفراده وركبوا للمقتفي",18,"ي",1,0],["واللام في الرحمن والرحيم","يقاس في الإفراد بالتقسيم",18,"م",1,0],["واللازورد المعدني مصوّل","والزنجفور السحق فيه يدخل",18,"ل",1,0],["واللاحِقاتِ المُدرِكاتِ البغَضَا","وَالقاتِلاتِ المُهلِكَاتِ البغَضَا",19,"ض",2,0],["واللاّبسونَ دِلاصاً كلَّ سابغةٍ","ماذيةٍ احكمتها كفُّ داوُدِ",20,"د",1,0],["واللاّزمون الاسارى في بيوتهم","من المُلوك باغلال واصفادِ",20,"د",1,0],["واللازم العادة الحسنى تصير له","خليفة ما لها يسطيع نسيانا",21,"ن",2,0],["واللابسين رداءَ فخ","رهمُ تطرزه النجابه",22,"ب",2,0],["واللام لام اللَه في ألفاته","وَالميم ميم محمد المَيمون",23,"ن",1,0],["واللازم استكمال كل رضعه","بكل ما تبلغ حتى الجرعه",24,"ه",1,0],["واللابس الفخر من أعرقه خلعاً","لها من المجد أطراف وأذيال",25,"ل",1,0],["واللازورديُّ البديعُ حُسنُه","مثل عِذَارٍ كَطِرازٍ أَخْضَرِ",26,"ر",1,0],["وَاللاحِقونَ جِفانهُم قَمَعَ الذَرا","وَالمطعمونَ زَمانَ أَينَ المطعِمُ",27,"م",1,0],["واللامُ درعٌ له فيه يحصنه","من كلِّ سوءٍ ومكروهٌ من الأمرا",28,"ر",2,0],["وَاللاَّلَكَائِيُّ الإمامُ حَكَاهُ عَن","هُم هُم حَكَاهُ قَبلَهُ الطَّبَرَانِي",29,"ن",2,0],["واللاَّءِ فِي ضِمنِ التَّصَانِيفِ التِي","شُهِرَت فَلَم تَحتَج إِلى حُسبَانِ",29,"ن",1,0],["وَاللابس العَلياء ضافية الرَدا","وَعَن الدَنية قَلبه متجرد",30,"د",1,0],["واللاء لو سكتوا أثنَت حقائبهم","على سليمان مثل الناطق اللسن",31,"ن",1,0],["وَاللاَّمُ لِلمِلكِ وَشِبهِهِ وَفى","تَعدِيةٍ أيضاً وَتَعليلٍ قُفِى",32,"ف",2,0],["واللادوام لاشارة إلى","مطلقة تعم فيما جعلا",33,"ل",2,0],["واللاصقين بحيٍّ غير أصلهم","كالخالطين صقور الطير بالرَخم",34,"م",1,0],["واللاجئون أَمنكم لا أَبالكم","أم منهم يطلبون الأخذ بالثار",35,"ر",1,0],["واللاهجون بأرخهِ كلٌّ تلا","قد نال مجد الرتبةِ المتمايزَه",36,"ه",1,0],["وَاللاجِئون كِرامٌ كم وَكم سُلِبوا","مِنَ الحُقوقِ بِأَحكام الجَهالاتِ",37,"ت",1,0],["واللآلآ في ثغرها تضمّ العندمي","منه منهل كوثرٍ يودع الناهل ثمل",38,"ل",1,0],["واللّاتُ, والعُزَّى, وأُخرَى, على","مَخرُوقَةٍ.. يَسأَلنَ عَن شاغِلِكْ!",39,"ك",1,0],["واللامُ لاح الفنا للعين مذ وصلوا","والآ تلَتْ لامَها آهٌ بها نزلوا",40,"ا",1,0],["واللال ما يروي من النبت غرسا","شوفه قريب وعنه دروب حالت",41,"ت",1,0],["واللابسون بناطلاً من خلفها","سُسَتٌ وأزرارٌ لها تشكيلا",42,"ل",2,0],["وَالْلاْذِقِيَّةُ مَوْجُهَاْ مُتَلاْطِمٌ","يَحْدُوْ لَهُ الأُدَبَاْءُ وَالشُّعَرَاْءُ",43,"ا",2,0],["وَالْلاذِقِيَّةِ قُسِّمَتْ أَحْيَاْؤُهَاْ","فَتَذَمَّرَ الأَمْوَاْتُ º وَالأَحْيَاْءُ",44,"ا",2,0],["واللائذين بغير الله في أمل","والعائذين بغير الله طغيانا",45,"ن",2,0],["واللاجئين إذا ما أزمة أزمت","بالميتين ذوي الأجداث خذلانا",45,"ن",2,0],["واللاَم عند الراءِ أدغم مشبعاً","محضاً ّإذ الحرفان يقتربانِ",46,"ن",1,0],["واللا نهاية والمجهول ثم سرت","بي رعشةٌ كنت عرض البحر ترتسم",47,"م",1,0],["واللايمه ماتقضي بلومها ورب","لوقلت كم يدخل هوى من خلالك",48,"ك",1,0],["واللابه الي من قديمٍ سطرها","فخرآ ينومسنا على مر الاجيال",49,"ل",1,0],["واللاش وأهل المصالح لا تصاحبها","مهما صفت بالزمن ما تترك البورة",50,"ر",2,0],["و(اللاذقية )ثغر باسم وَلَها","(عفرين) إذ بسمت تستقبل القبلا",51,"ل",2,0],["واللام في الأبصار لاستغراقها","تستغرق الأبصار والألبابا",52,"ب",2,0],["واللاذقية سِيْفُ الصَّبرِ جمرته","لن يرهبَ القومُ غير اللهِ والأَجَلِ",53,"ل",1,0]]}