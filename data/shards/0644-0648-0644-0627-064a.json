{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"لولا يذم الركب عندك موقفي","https://www.aldiwan.net/poem29948.html","الكامل"],[88,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"يا قلب ويحك والمودة ذمة","https://www.aldiwan.net/poem8110.html","الكامل"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[87,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[30,"لولا يدا بشر بن مروان لم أبل","https://www.aldiwan.net/poem1236.html",""],[51,"لولا يزيد ابن منصور لما عشت","https://www.aldiwan.net/poem64126.html","البسيط"],[107,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[69,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[139,"إن كنت في الحسن بدرا","https://www.aldiwan.net/poem48857.html","المجتث"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[302,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[447,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[470,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[475,"لولا يزيد وتأميلي خلافته","https://www.aldiwan.net/poem4708.html","البسيط"],[500,"ما كان ليلي ليلا","https://www.aldiwan.net/poem9881.html","المجتث"],[556,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[556,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[558,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[558,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[563,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77509","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108579","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108980","البسيط"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27972","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28005","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27905","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27393","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77284","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100900","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204734","الكامل"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103175","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97963","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91194","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91952","الكامل"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17480","البسيط"],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203184",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121263","البسيط"],[5121,"البرزخ","https://www.poetsgate.com/ViewPoem.aspx?id=53928",""],[5302,"لما اغتالك الحلك","https://www.poetsgate.com/ViewPoem.aspx?id=201221",""],[5401,"أبو جهل","https://www.poetsgate.com/ViewPoem.aspx?id=85475",""],[5431,"طلقة الرحمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=200360",""],[5561,"ماضٍ مَنسيّ","https://www.poetsgate.com/ViewPoem.aspx?id=196537",""],[5674,"أجمل الشعر مصلوبا من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=189091",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5703,"لن أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=215194",""],[5848,"اطقها فالوجه","https://www.poetsgate.com/ViewPoem.aspx?id=51948",""],[5939,"وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=185513",""],[5956,"إذا شاخ الدمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183934",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5956,"دُمتَ المفيدَ لأوطاني ونهضتها","https://www.poetsgate.com/ViewPoem.aspx?id=194284",""],[5956,"هل البقاء للسامِين أم السامّين؟","https://www.poetsgate.com/ViewPoem.aspx?id=202501",""]],"verses":[["لَولا يَقينُ القَلبِ أَنَّكَ حَبسُهُ","لَعَصى وَهَمَّ عَليكَ بِالعُدوانِ",0,"ن",1,0],["لَولا يَذُمُّ الرَكبُ عِندَكَ مَوقِفي","حَيَّيتُ قَبرَكَ يا أَبا إِسحَقِ",1,"ق",1,1],["لَولا يَداهُ سَطا عَلى أَبدانِها","كَربُ المَخاضِ وَشَفَّها الإيلامُ",2,"م",1,0],["لولا يُدَالُ من الحبيب مُحبُّهُ","فتُدال من أحزانِهِ أفراحُه",3,"ح",2,0],["لَولا يَزيدُ بادئِاً ما شَرِبَت","مَروانُ بِالكَأس الَّتي بِها سَقى",4,"ا",1,0],["لَولا يَمينُ المَوتِ فَوقَ يَمينِهِ","فيها لَفاضَت مِن جَنىً وَمِياهِ",5,"ا",2,0],["لَولا يَدُ اللَهِ بِالجارَينَ ما سَلِما","وَعَينُهُ حَولَ رُكنِ الدينِ لَم يَقُمِ",6,"م",1,0],["لَولا يَدُ اللَهِ لَم نَدفَع مَناكِبَها","وَلَم نُعالِج عَلى مِصراعِها الأَرَبا",7,"ب",2,0],["لَولا يَدا بِشرِ بنِ مَروانَ لَم أُبَل","تَكَثُّرَ غَيظٍ في فُؤادِ المُهَلَّبِ",8,"ب",1,1],["لَولا يَزيدُ اِبنُ مَنصورٍ لَما عِشتُ","هُوَ الَّذي رَدَّ روحي بَعدَما مُتُّ",9,"ت",1,1],["لولا يَذودونَ قوماً عن جَوانبها","طاحت قواعدُها أو طارتِ القِمَمُ",10,"م",1,0],["لولا يُخاطِبُنَا بِقَدْرِ عُقُولِنَا","جَاءتْ معارفُهُ بما لم نَعْهَدِ",11,"د",1,0],["لولا يد تحدو وهاد ملهم","لم يبد منه الحزم والنكراء",12,"ا",2,0],["لولاي قطب سرورٍ","لما عليَّ استدرتمْ",13,"م",1,0],["لولا يباني ونثرى","لضاع سرُّ الخلود",14,"د",1,0],["لَولا يقيني أَنَّني بك لاحقٌ","لقهرتُها حتّى تذوقَ رداها",15,"ا",3,0],["لَولا يَقيني أنّني بك لاحقٌ","لطِفقت أسباب الحياة أقطّعُ",16,"ع",1,0],["لولا يخلد بالمكارم والتقى","أحد خلدت فأنت بر منعم",17,"م",1,0],["لِوَلائِهِم..واليَومَ ها أنتُم كَما","فَعَلوا، فَمَن منكُم أذ َلُّ وأفجَعُ ؟!",18,"ع",1,0],["لَولا يَزيد وَتأميلي خِلافَتَهُ","لَقُلتُ ذا مِن زمانِ الناسِ إِدبارُ",19,"ر",1,1],["لولا يرى الباب دوني","لطار في السقف ذعرا",20,"ر",2,0],["لَولايَ لَم يهتد الأَقوام كلُّهُمُ","سُبْلَ الكلامِ ولا طُرْقَ المقاييسِ",21,"س",1,0],["لولايَ لم يكُ للنّدى سيلٌ ولا","في الرَّوع إلجامٌ ولا إسْراجُ",22,"ج",1,0],["لَولايَ كان الدّهر من أهلِهِ","بغير أوضاحٍ ولا غُرّةِ",23,"ه",1,0],["لَولا يَزيدُ وَأَيّامٌ لَهُ سَلَفَت","عاشَ الوَليدُ مَعَ الغاوينَ أَعواما",24,"م",2,0],["لَولا يَزيدُ لَأَضحى المُلكُ مُطَّرَحاً","أَو مائِلَ السَمكِ أَو مُستَرخيَ الطِوَلِ",25,"ل",1,0],["لولاي ما بان علم حق","وعلم خلق والأنبياء",26,"ا",2,0],["لَولاي ما جَرَّ الخُيولُ العَرَبه","وَلا صَعدتُم فَوقَ ظَهر العَقَبه",27,"ه",1,0],["لَوْلا يُدَالي حَفْضُهُ القِدْحَ انْزَرَقْ","وَقَدْ بَنَى بَيْتاً خَفِيَّ المُنْزَبَقْ",28,"ق",1,0],["لولا يمين أميرنا ما خضبت","بدمائه الهنديةُ الصحصاحا",29,"ح",2,0],["لولا يكفكف يا روزا مقالته","بعض الدموع لكان الكون في خطر",30,"ر",1,0],["لولاي كان الفأر في","قومي قيد الأسد",31,"د",1,0],["لولا يهيمني حتى يعجزني","فيما ادعَّيت فأمسى منه ذا ملق",32,"ق",1,0],["لولاي ما كنت في سرٍّ أسرُّ به","عن الحبيبِ الذي يدرون لولايا",33,"ا",3,0],["لولاي ما ظهرت في الصور نفخته","فالروحُ من نفس الرحمنِ فادّكروا",34,"ر",3,0],["لولاي ما كان للأسماء من أثر","أنا المسمى فلي الأسماء والأثر",35,"ر",1,0],["لَولا يَراعَتُها تَهوى أَنامِلَها","لَم تَبكِ في يَدِها عِشقاً عَلى الوَرَق",36,"ق",1,0],["لولا يطولُ الشرحُ كُنَّا نَشرَحُ","جميعَ ما عنه الثٍّقاتُ صَحَّحُوا",37,"ح",3,0],["لولا يدٌ لابن اسماعيلَ تشملُنى","فضلاً كما شملت أثمارَها الشجر",38,"ر",1,0],["لولا يكون الحسن مظهر خالق","ما كان اذ يبدو لديه نكبر",39,"ر",1,0],["لولا يزيد ولولا قبله عمر","ألقت إليك معد بالمقاليد",40,"د",1,0],["لولا يقيني يقيني لا ندفعت إلى","مثوى الردى قبل أن تسعى إلى اللحد",41,"د",1,0],["لولاى لم تسكنِ الحياتُ من حَذَرِ","بَطْنَ الترابِ ولا الاسادُ في الأجَمِ",42,"م",1,0],["لَولا يَد التَوفيق حالَت بَين ذا","ذلت جِباه أَو رغمن أُنوف",43,"ف",1,0],["لَولا يَقيني بِالوجو","د لخلتُ أَني لَم أَرك",44,"ك",1,0],["لَولا يَجودَةُ وَالحَيُّ الَّذينَ بِها","أَمسى المَزالِفُ لا تَذكو بِها نارُ",45,"ر",1,0],["لولا يد سبقت له","لأمرته بالكفّ عني",46,"ن",2,0],["لَولا يَدٌ مِن أَبي الفاروقِ سابِغَةٌ","في اللَهِ وَالحَقِّ ما تُسدي وَما تَهَبُ",47,"ب",1,0],["لولا يمُنُّ بهِ رَبُّ العبادِ على","شيرازَ ما كان يرجو البرءَ من دائه",48,"ا",3,0],["لَوْلاَيَ لَوْلاَ سُطُوعِ الشَّمْسِ لانْسَحَقَتْ","مَلاَمِحُ السِّحْرِ فِي وَجْهِ الضِّيَا عِوَضَا",49,"ض",2,0],["لولاي يا غارقا في الوهم ما بسمت","لك النجوم ولم يرقص لك الفلك",50,"ك",1,0],["لولاي أعدي ليا هوجست راس الجبَلْ","يمدي وجود الشمالي في الحياه إنتهى",51,"ه",2,0],["لولاي لم تُخلق بنبضك دهشة","لا...لا ولم تدخل بعشقك (غينِسا)",52,"س",2,0],["لولايَ ما كنتَ لي شيئا ولا ذِكرا","أنا التي علَّمَتْكَ الحبَّ والطُّهرا",53,"ر",2,1],["لولايَ يا رجُلا ما كنتَ معتنقا","غير التسلُّطِ طبعا والنوى فِكرا",53,"ر",2,0],["لولا يقولون صبٌّ خرَّ من ولهٍ","هرقت روحي دماً يجري على ورقي",54,"ق",2,0],["لولا يقال النوى موتٌ لراحلةٍ","لصغت حولك عرشاً سورة الفلق",54,"ق",1,0],["لولايَ ما كانتْ صداقتُنا","ولَما حلا ما بيننا السمَرُ !",55,"ر",1,0],["لولايَ ماكانَ يَهوى أيَّ فاتنةٍ","وَما عرفتُ الهوَى وَالشوقَ لولاهُ",56,"ا",2,0],["لولاي اعدك فالمواقف راس مال","ما سقت لك شرهة وانا بالي طويل",57,"ل",1,0],["لولا يقينٌ بالإلهِ وبَعْثِهِ","لاستنزفَ الحزنُ النُّهَى المُلتاعا",58,"ع",2,0],["لولا يكون الحظ ألأمَ مجرمٍ","ما كان يلهو بالقلوب وينقمُ",59,"م",1,0],["لولا يشرِّدني بلاءٌ غيرُهُ","لَيَطِيبُ لي مِنْ قُرْبِهِ التشريدُ",60,"د",1,0],["لولا يحب إله الناس شاعرَهُ","ما أرسلَ البطلَ المغوارَ ينتصرُ..",61,"ر",1,0],["لولا يضير الظالمين وجودُهُ","لم يقتلوه لكي يُبَدَّد جودُهُ",62,"د",2,1]]}