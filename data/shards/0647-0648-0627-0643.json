gate.com/ViewPoem.aspx?id=187731",""],[5431,"خيانة الأوراق...","https://www.poetsgate.com/ViewPoem.aspx?id=202740",""],[5442,"سرى والدحى شوق إليه وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=114746",""],[5461,"تعال اسهر","https://www.poetsgate.com/ViewPoem.aspx?id=1311",""],[2944,"أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=188641",""],[5628,"طيش وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=191436",""],[5674,"قيس وليلى","https://www.poetsgate.com/ViewPoem.aspx?id=189085",""],[5744,"انا الأُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=207275",""],[5751,"عاشق الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=215010",""],[5783,"زوجتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=61545",""],[5785,"هواكم يا حياة الروح واجب","https://www.poetsgate.com/ViewPoem.aspx?id=131559",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5853,"أفول شعر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175720",""],[5872,"هواكم بقلبي لأحكامه نسخ","https://www.poetsgate.com/ViewPoem.aspx?id=120609",""],[5872,"هواكم بقلبي ما لنحكمه نسخ","https://www.poetsgate.com/ViewPoem.aspx?id=120616",""],[5956,"خذني إلهي نحو تركي","https://www.poetsgate.com/ViewPoem.aspx?id=194401",""],[5957,"أتاني هواك","https://www.poetsgate.com/ViewPoem.aspx?id=12042",""],[6075,"على بوابة الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190650",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[6144,"الورد","https://www.poetsgate.com/ViewPoem.aspx?id=13695",""],[6152,"ضجيج قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203169",""],[6189,"رسالة إلى أميرة الغرابة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83587&r=&rc=54",""],[6256,"بنغازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65923&r=&rc=11",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""]],"verses":[["هَواكِ سِترٌ عَلى قَلبي أَقيكِ بِهِ","مِن كُلِّ أُنثى لَها يُستَحسَنُ النَظَرُ",0,"ر",1,0],["هَواكَ الَّذي يَنهاضُ بَعدَ اِندِمالِهِ","كَما هاضَ حادٍ مُتعِبٌ صاحِبَ الكَسرِ",1,"ر",1,0],["هَواكَ هَوايَ عَلى كُلِّ حالِ","وَإِن مَسَّني فيكَ بَعضُ المَلالِ",2,"ل",1,1],["هواكِ الذي أبلاهُ حتى شنِئْتِهِ","وحتى رأيتِ الموتَ عِدْلاً لقربِهِ",3,"ب",2,0],["هَواكِ أَلَجَّ في عَيني قَذاها","وَخَلّى الشَيبَ يَلعَبُ في عِذاري",4,"ر",2,0],["هَواكِ هَواكِ وَالدُنيا شُؤونُ","وَلِلصَبَواتِ آوِنَةً سُكونُ",5,"ن",1,1],["هواكِ أصبحَ نَسْياً","كلوعتي مَنْسيّا",6,"ي",2,1],["هَواكِ غَبوقُ النَفسِ في كُلِّ لَيلَةٍ","وَذِكرُكُمو في كُلِّ يَومٍ صَبوحُها",7,"ح",3,0],["هَواكَ مُشابِهٌ فَرَساً جَموحاً","وَما أَلجَمَتهُ فَعَلَيكَ رَسنَه",8,"ن",2,0],["هواك بالنيل مثل إخوته","سيان مطويّه ومنتشره",9,"ر",2,0],["هواك اعتناق النّدى والغصون","لان غرامك غير الغرام",10,"م",1,0],["هواك غبوقُ النفسِ في كلِّ ليلة","ٍ وذكرتمو في كل يومٍ صبوحها",11,"ح",3,0],["هواك عندي مقيم في مواطنه","فإن تحوّل عن نعمائها اغتربا",12,"ب",2,0],["هواكم هو المطلوب ان مر او حلا","وفيه سواء عندنا الحلو والمر",13,"ر",1,0],["هواك ظننته لعبة","وحبك خلته كذبة",14,"ب",2,1],["هواك هوى بررت به","فمالك لا تبرينه",15,"ن",2,0],["هَواكَ أَذهَلَني عَن ذِكرِ كُلِّ هَوىً","فَما أَجيءُ بِشِعرٍ غَيرِ مُقتَضَبِ",16,"ب",1,0],["هَواكُم وَإِن لَم تُسعِفونا وَلَم تُجدوا","عَلى ما عَهِدتُم وَالنَوى لَم تَحِن بَعدُ",17,"د",1,1],["هواك يا من له اختيال","ما لي على مثله احتيال",18,"ل",1,1],["هواكم عاملا اضحى على تلفي","وها انا اليوم للهجران معسول",19,"ل",1,0],["هواك برى ما ترى من عظامي","فيا بدر سبحان من قد براك",20,"ك",1,0],["هَواكَ هَوايَ قَلبُكَ مِثلُ قَلبي","كَما تَهوى عَلى مَضمَضٍ هَويتُ",21,"ت",1,0],["هُوَ أَكرَم الكُرماء ان عصفت به","ريح السماح وأجود الاجواد",22,"د",1,0],["هَواكَ بَحرٌ عَميقٌ لا قَرارَ لَهُ","وَها أَنا الآنَ مِنهُ غُصتُ في اللُجَجِ",23,"ج",1,0],["هواك أثار بقلبي الأسى","وجار على كبدي الداميه",24,"ي",2,0],["هواكم بقلبي والفؤاد مقيم","وشوقي إليكم مقعد ومقيم",25,"م",1,1],["هَواكَ يَأَبى سِوى سُهدِي وَتَعذِيبي","وَسِحرُ عَينَيكَ يُغرِيني وَيُغري بِي",26,"ب",2,1],["هَواكَ وَلا تكذب عَلَيكَ أَميرُ","وَأَنتَ رَهينٌ في يَدَيهِ أَسيرُ",27,"ر",1,1],["هَواكِ دَعا عَيني تَفيض عُيونها","وَداعي الهَوى يا هِند لَيسَ سِوى العينِ",28,"ن",1,0],["هَواك بِفاتر الأَجفان زِنهُ","وَسَمعك عَن سَماع العذل صنهُ",29,"ه",1,1],["هو أكفَى الخَلْقِ للوفْدِ ندىً","وبه أيضاً عنِ الخَلْقِ اكتفائي",30,"ا",2,0],["هواكُم إن دَنَت دارٌ وإن بَعُدَت","كما عهدتُم وبُرحُ الوجدِ ما بَرحا",31,"ح",2,0],["هَواكَ أَخطَأَني قَصدِي وكُنتُ أَرى","أَنَّ الهَوى مِنكَ يُدنِيني فأَقْصاني",32,"ن",2,0],["هواك هواك في قرب وبعد","يعاصاني الغداف بلون ناز",33,"ز",1,0],["هواكم هو الدنيا وأعلم أنه","يبيِّضُ يومَ الحشر سودَ الصحائفِ",34,"ف",1,0],["هواك إذ أجحف بي","بأي علق فتكا",35,"ك",2,0],["هَواكُم جَلِيسي لا يُفَارِقُ مُهجَتي","وَلَو طَرفَةً حَتَّى نُوَسَّدَ فِي القَبرِ",36,"ر",1,0],["هواك لا نوار الملامة ملمع","فلا بد من يبلى به يتشعشع",37,"ع",1,1],["هواك فناء مطلق فبعصره","على الخلق تعميم المنية شال",38,"ل",1,0],["هواك نعيم في البقاء مخلد","وجاحد ايات الملاحه كافر",39,"ر",1,0],["هواك على الأحداث لو مر زايرا","لما تم تحت الأرض اصلا مجاور",39,"ر",1,0],["هواكم بسوداء الفؤاد إلى المدى","مقيم وصبري ماله ألفةٌ معي",40,"ع",2,0],["هَواكَ أراكَ ذاكَ الغَيَّ رُشدا","فصرتَ تَرى صلاحَك في الفسادِ",41,"د",1,0],["هواك أثار العيس تقتادها نجد","ويحدو بها من ثائر الشوق ما يحدو",42,"د",2,1],["هواكم لا تغيره اللّيالي","وصبري عنكمُ قد لا يكونُ",43,"ن",1,0],["هَواك بِالوَجدِ مَقصور عَلى خَلَدي","وَإِنّني فيهِ طولَ العُمرِ مَمدودُ",44,"د",1,0],["هو أكثمٌ في حلمه هو عامرٌ","في بَأسهِ هو حاتم في جودهِ",45,"د",2,0],["هواك هو الذخر العظيم فمن هوى","هنيئا له بشراه يا نعم ما حوى",46,"ح",3,1],["هواك على مر الجديدين لا ببلى","وأنت على مر التعتب مستحلى",47,"ل",2,1],["هَواكِ أَتاني وَهُوَ ضَيْفٌ أُعِزُّهُ","فأَطْعَمْتُهُ لَحْمي وأَسْقَيْتُهُ دَمي",48,"ي",1,0],["هواك ليلاي لا أبغي به بدلاً بها","رغبت وعنها معشر رغبوا",49,"ب",3,0],["هواكِ يا غايةَ الآمالِ أبردُهُ","أحرُّ ما بين أحشائِى من النّارِ",50,"ر",1,0],["هَواك لواك اليوم عن كل غرفة","سماوية في جنة وَنَعيم",51,"م",1,0],["هواك لواك اليوم عن كل نفحة","إِلهية تسري بكل نَسيم",51,"م",1,0],["هواك لواك اليوم عن كل شيمة","مكرمة تَسمو بكل كَريم",51,"م",1,0],["هواك لواك اليوم عن رتب العلا","فألحقك الهوءا بكل لَئيم",51,"م",1,0],["هواك لواك اليوم عن كرم التقى","فأَنتَ غَني بعده كعديم",51,"م",1,0],["هواك لواك اليوم عن سبل الهدى","فأصبحت للأَحباب غير نديم",51,"م",1,0],["هواك لواك اليوم عن درجاتهم","فقلبك للمحبوب غير سليم",51,"م",1,0],["هواك بقلبه أضحى مُقيماً","وعنه لا يزول إلى المَعاد",52,"د",1,0],["هواك لم يُبق لي روحاً ولا ذهباً","وإن رضيت فَسَهلٌ كُلّ ما ذهبا",53,"ا",1,0],["هواكم بقلبي طائر يستفزني","ولم يتخذ إلا فؤادي له وكرا",54,"ر",2,0],["هواك هو الدُّنيا ونَيلُك ملكُها","وهجرُكَ مقرونٌ بكلِّ هوانِ",55,"ن",1,1],["هواك مقيم لا يحول وإن يحل","من البعد ما بيني وبينك حائل",56,"ل",1,0],["هَواك راحة قَلبي في مَتاعبِهِ","وَالقَلب يَبرد مِن أَبراد لاهبه",57,"ه",1,0],["هواكم بقلبي ما لأحكامه نسخ","ومن أجله جفني بمدمعه يسخو",58,"خ",2,1],["هواك لقد أجرى دموعي صبابة","وصدّك نيران الجفا في الحشا أذكى",59,"ك",2,0],["هواك أحاط بي من كل صوب","وأغرقني بلجته سناكا",60,"ك",2,0],["هَواكَ هَوىً تُجَدِّدُهُ اللَيالي","وَلا يَبلى عَلى مَرِّ العُهودِ",61,"د",1,0],["هواكم صار ديني","يا عرب وادي العقيق",62,"ق",1,1],["هواك فلست أقربه غرور","وأنت لكل من يأتي سرير",63,"ر",1,1],["هَواكُم الدَمعُ الصَبِّ كَم في النَوى اجرى","فَهَلّا قَضيتُم في الغَرامِ لَهُ أَجرا",64,"ر",2,1],["هُو اكلمينضس المختار حبراً","ليرعى بالعصا لا بالحسامِ",65,"م",1,0],["هواك أضرم ناراً","بين الجوانح مني",66,"ن",2,0],["هَواك بِهِ فَخرٌ عَلى كُلِّ عاشقٍ","فَفاخرْ بِصبٍّ حازمِ الرَأي صائب",67,"ب",1,0],["هواكَ وإلا فالهوانُ لذي هوىً","وفيكَ وإلا فالمحبةُ ضائِعَه",68,"ع",2,0],["هواك يُرَدّ هوى من يرى","وليس يُرى لهواك مَرَدْ",69,"د",1,1],["هواك في اللهو لا تطعه","ولازم الباب لا تدعه",70,"ه",1,0],["هواكَ وكّلَ بالعينينِ متصلاً","من الدموعِ يُباريَ جريهُ المَطرا",71,"ر",2,1],["هواكَ والقلبُ في مكانِ","عن سائرِ الجسمِ مُفردانِ",72,"ن",1,1],["هواك بتعمير الايالة دائماً","وترجو الأهالي ان يطول لك العمر",73,"ر",1,0],["هواك السجن يا هيفا","بكت كالقلب ِأصفادي",74,"د",2,0],["هَوَاكِ صَامَ وَقَامَ الدَّهْرَ مُبْتَسِماً","كَيْ لَايَرَى النَّحْسَ مَعْقُوداً عَلَى خَدِّيْ",75,"د",2,0],["هَوَاكِ بَينَ العَيشِ والمَوتِ ما","يَزَالُ يَرجُو قَتلَةً شَافِيَةْ",76,"ف",3,0],["هواك بدو نووا للقلب بالشدة","ورياض قلبي لشوف البدو محتاجه",77,"ج",2,0],["هواك ماهو في حياتي فريضه","إن طرت أو وقّعت ما انته على البال",78,"ل",1,0],["هواك خفي الشوق يضمره الجفا","بريق وفي عينيك أشعله الأسرُ",79,"ر",1,0],["هواكِ كشِعري ..، أينَ مني سيذهبُ؟","وشعريْ كظِلِّيْ ..ليسَ ليْ منهُ مَهْرَبُ !",80,"ب",1,1],["هواكِ أوتادُه في العُمقِ غائرةٌ","يحتلُّ ذاتيْ ويُسقي الحسَّ مُنْسِكِبَا",81,"ب",2,0],["هواكِ يحكُمني ذاتًا وذاتيةً..","هِيَّ الحقيقةُ محْضًا لم أقلْ كَذِبَا",81,"ب",2,0],["هواك يسكن في لبّ الفؤاد وكم","فاض الحنين به ثم انتشى طربا",82,"ب",2,0],["هواك شعري وقيثاري وأغنيتي","وحبر حرفي شموس منك تدنيني",83,"ن",2,0],["هواك عمري وأحلامي وأمنيتي","ورجع صوتك في صمتي يناجيني",83,"ن",2,0],["هَواكَ أَعَلَّني دَهْراً هَواكا","شِفائي عَلَّني يَوماً أَراكا",84,"ك",2,1],["هواكَ فراشةٌ تهفو لنارٍ","فأنتَ لهيبُها وأنا القتيلُ",85,"ل",1,0],["هواكِ سعادةٌ ورضاكِ فَرضٌ","ووصلكِ جنّةُ وجفاكِ نارُ",86,"ر",1,0],["هواكِ بحارٌ حَوَتْ لوعتي","وقلبيْ يذوبُ لكي يُبحرا",87,"ر",2,0],["هواكِ بأمرِ الهوى ساكني","وإنْ بُدِّلَ الأمرُ أو غُيِّرا",87,"ر",2,0],["هواك وحدك دون الآخرين له","يومٌ ترى الأرض فيه كلّها دمنا",88,"ن",2,0],["هواكِ أبو ظَبِي أنتِ الأصيلهْ","وقد هبَّتْ نسائمُكِ العليلهْ",89,"ل",2,1],["هواكِ لو يشترى بالعمرِ أدفعهُ","طوعاً لأطفي الجوى في القلبِ يستعرُ",90,"ر",1,0],["هواكِ دنيا كنتُ أرسُمها","على غصونِ القلبِ والشَّجرِ",91,"ر",1,0],["هواك ناسك تهجاني تراتيله","والشوق قبل ارسمه يرسم بكراسي",92,"س",2,0],["هواك لو جار في عين الرضى لايق","والسخط ماله بموق العين امآريّة",93,"ي",2,0],["هواك رضائي هوائي","هوائي هواك رضائي رضاك",94,"ك",1,0],["هواك أراك ولست بمرأى","أراني وأنت سوى ما أراك",95,"ك",1,0],["هَوَاكِ أَصبَحَ دُرَّهْ","مَالِي عَلِيهِ بِقُدْرَهْ",96,"ر",2,1],["هواكِ اليوم بادٍ في فؤادي","يصوغُ محب