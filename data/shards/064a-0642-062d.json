{"poems":[[30,"لقد كذب الحي اليمانون شقوة","https://www.aldiwan.net/poem5024.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[199,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[466,"يقحمه ويمسكه قديرا","https://www.aldiwan.net/poem15484.html","الوافر"],[466,"يغشى سراة لقاح الحي منزله","https://www.aldiwan.net/poem15684.html","البسيط"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96366","الوافر"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21446","الطويل"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33014","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""]],"verses":[["يُقَحِّمُهُم في السِندِ سَيفُ اِبنُ أَحوَزٍ","وَفُرسانُهُ شُهبٌ يُشَبُّ وَقودُها",0,"د",3,0],["يقحمها على جموع الروم","وينثني بفتحها المروم",1,"م",1,0],["يَقحَمنَ جانِبَ زَورِهِ وَجَبينِهِ","وَلَهُ عَلى آثارِهِنَّ سَحيلُ",2,"ل",1,0],["يُقَحِّمُهُ ويُمسكُه قَديراً","شديدُ البأسِ والعِطْفُ الوقورُ",3,"ر",1,1],["يُقحِّم النفس في الهول المخوف وعن","تقحيمه العِرض يُفى هيِّباً فَرِقا",4,"ق",2,0],["يُقحّمُ في الخبارِ ويختليني","وضغثُ المختلي كَلأٌ وَخيمُ",5,"م",1,0],["يُقَحِّم من غَرّا أَقاحيمَ عَرَّضَت","لَهُ تَحتَ لَيلٍ ذي سُدودٍ حُيودُها",6,"د",3,0],["يُقَحِّمُها عَمرو القَنا وَعُبَيدَةٌ","مُفدىً خِلالَ النَقعِ بِالأُمِ وَالأَبِ",7,"ب",1,0],["يُقّحمها المهالكَ في زحامٍ","بنات الرعد فيه لها هَدير",8,"ر",1,0],["يقحمه والنصر في غرته","كأنما في الليل لاح كوكب",9,"ب",1,0]]}