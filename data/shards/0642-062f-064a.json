iewPoem.aspx?id=21802",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[80,"لو أنّ ربعَ شبابي غيرُ مندرسِ","https://www.poetsgate.com/ViewPoem.aspx?id=3326",""],[46,"إنّما نحنُ في ضلالٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18126",""],[35,"أأطْلالُ دارٍ مِنْ سُعَادَ بيَلْبَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=22171",""],[35,"أَتَاني وَدُوني بَطنُ غَوْلٍ وَدُونَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=22000",""],[99,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[97,"تحت الباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63593&r=&rc=140",""],[20,"إِن للدهرِ صولة فاحذرنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69769&r=&rc=10",""],[20,"أَبلِغ خليلي عند هند فلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70013&r=&rc=35",""],[88,"اشر فعل البرايا فعل منتحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19521&r=&rc=24",""],[88,"قد يطفح اللؤم حتى ان صاحبه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19581&r=&rc=84",""],[87,"بادرِ الفرصة َ ، واحذر فوتَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23999&r=&rc=261",""]],"verses":[["قَد يُذَلُّ العَزيزُ ما لَم يُشَمِّر","لِاِنطِلاقٍ وَقَد يُضامُ الأَبِيُّ",0,"ي",1,0],["قَد يُجيبُ العِزُّ مَن أَقعَدَهُ","عَن طِلابِ العِزِّ خَوفٌ وَعَدَم",1,"م",1,0],["قَد يَقدَعُ المَرءُ وَإِن كانَ اِبنَ عَم","وَيَقطَعُ العُضوَ الكَريمَ لِلأَلَم",2,"م",1,0],["قَد يَبلُغُ الرَجُلُ الجَبانُ بِمالِهِ","ما لَيسَ يَبلُغُهُ الشُجاعُ المُعدَمُ",3,"م",1,1],["قَد يَنفُذُ الحِلمُ عَلى غَرزَةٍ","بِمُحفِظاتِ الغادِرِ المُجرِمِ",4,"م",1,0],["قَد يَهلِكُ النَسرُ وَفي ريشِهِ","عَونُ الرَدى الجاري مَعَ الأَسهُمِ",4,"م",1,0],["قَد يوعَكُ اللَيثُ لا لِذِلَّتِهِ","عَلى اللَيالي وَيَسلَمُ الوَعِلُ",5,"ل",1,0],["قَد يَأمَنُ المَرءُ سَهماً فيهِ مَوقِعُهُ","وَقَد يَخافُ الَّذي يَنأى وَيَنحَرِفُ",6,"ف",1,0],["قَد يَسبُقُ الخَيلَ تاليها وَإِن كَثُرَت","مِنها الفَوارِطُ يَومَ الجَريِ وَالسَلَفُ",6,"ف",1,0],["قَد يَنزِلُ العالي مِنَ الصِياصي","وَقَد يُطيعُ الرَأسُ وَهوَ عاصي",7,"ي",1,0],["قَد يَنزِعُ اللينَ الكَريمُ","وَيَلبِسُ الخُلُقَ الشَريسا",8,"س",2,0],["قَد يورِقُ العودُ يَوماً وَهوَ ذو يَبَسٍ","وَتُقبَسُ النارُ مِن ذي نِعمَةٍ حَصِرِ",9,"ر",1,0],["قَد يَسقُطُ العَودُ الجَلي","دُ وَيَنهَضُ النَضوُ الطَليحُ",10,"ح",1,0],["قَد يُنتِجُ المَرءُ العِشارَ بِجِدِّهِ","وَسِواهُ يَعتامُ الفُحولَ وَيُلقِحُ",11,"ح",1,0],["قَد يَنسَخُ الخَوفَ الأَما","نُ وَيَغلُبُ اليَأسَ الرَجا",12,"ج",2,0],["قَدْ يَخْبَأَ الْمَحْبُوبَ فِي مَكْرُوهِهَا","مَنْ يَخْبَأَ الْمَكْرُوهَ فِي الْمَحْبُوبِ",13,"ب",1,0],["قَد يَجمَعُ المَرءُ مالاً ثُمَّ يُسلَبُهُ","عَمّا قَليلٍ فَيَلقى الذُلَّ وَالحَرَبا",14,"ب",2,0],["قَد يَترُكُ الدَهرُ في خَلقاءَ راسِيَةٍ","وَهياً وَيُنزِلُ مِنها الأَعصَمَ الصَدَعا",15,"ع",2,0],["قَد يُعوِزُ الحازِمُ المَحمودُ نِيَّتُهُ","بَعدَ الثَراءِ وَيُثري العاجِزُ الحَمِقُ",16,"ق",1,0],["قُدَّ يا لَيلُ مِن سَوادِكَ ثَوباً","لِلدَراري وَلِلضُحى جِلبابا",17,"ب",2,0],["قَد يَشهَدُ الحَربَ بِالزَغفِ المُضاعَفِ أَق","وامٌ وَيَشهَدُها مَن لِبسُهُ اليَلَبُ",18,"ب",1,0],["قَديمٌ كَوَقفِ العاجِ ثُبِّتَ حَولَهُ","مَغارِزُ أَوتادٍ بِرَضمٍ مُوَضَّنِ",19,"ن",1,0],["قد يبتغي أوجالسهى","ويخون همته عتاده",20,"د",2,0],["قَدْ يَخْدُرُ اللَّيْثُ حَتَّى لا يُخَالُ بِهِ","بَأْسٌ وَيَحْفِزُهُ جَرْسٌ فَيَقْتَحِمُ",21,"م",1,0],["قَدْ يُمَارُونَ بِالكَلامِ إِبَاءً","وَبِهِمْ غَيْرُ مَا يُبِيْنُ الكَلامُ",22,"م",1,0],["قَد يَشيبُ الفَتى وَلَيسَ عَجيباً","أَن يُرى النَورُ في القَضيبِ الرَطيبِ",23,"ب",1,1],["قَد يكتمُ المرءُ حُبَّه حِقَبَاً","وهوَ عَمِيدٌ وَقَلبُهُ كَمِدُ",24,"د",1,0],["قَد يُترَكُ الأَرحَبِيُّ الوَهمُ أَركُبَها","كَأَنَّ غارِبَهُ يَأفوخَ مَأمومُ",25,"م",1,0],["قد يعجز الصرّيع عنه","إذا يحاول أن يروزه",26,"ز",2,0],["قد يطلب الحق طيّاش فيُبطله","ما كل طالب حقّ نال مطلوبا",27,"ب",2,0],["قد يَقبُح الشيء وضعاً وهو من حسن","كالنعشُ يدهش مرأىً وهو من شجر",28,"ر",1,0],["قد يَستلِذّ الفتى ما أعتاد من ضرر","حتى يرى في تعاطيه المسرّات",29,"ت",1,0],["قد يطربون لشتم المرء صاحبه","كأنما الشتم مدعاة إلى الطرب",30,"ب",1,0],["قد يحسب الإنسان آماله","والموت مصغٍ نحوه يسمع",31,"ع",1,0],["قَد يُؤسَرونَ فَما يُفَكَّ أَسيرُهُم","وَيُقَتَّلونَ فَتَسلَمُ الأَوتارُ",32,"ر",1,0],["قَد يَعلَمُ الناسَ أَنَّ التَيمَ أَلأَمُهُم","أَأُخبِرُ الناسَ لُؤمَ التَيمِ أَم أَذَرُ",33,"ر",1,0],["قديمة راحٍ في يمين حديثةٍ","من السنّ عن شيخ التصابي محدّثه",34,"ث",2,1],["قديم قصد وثناء أو هوى","ما ضلَّ سعيٌ فيهما ولا غوى",35,"غ",3,0],["قد يسبِقُ الخير طالبٌ عَجِلٌ","ويرهَقُ الشرُّ مُمعِناً هَرَبُهْ",36,"ب",2,0],["قد ينظر الفهدُ إلى ظبية","وينظر الظبْيُ إلى الفهدِ",37,"د",1,0],["قد يعودُ الحميدُ غير حميدٍ","إن عَكَسْتَ العقول عن إحمادِهْ",38,"د",2,0],["قد يجيد الفارس الطع","نةَ بالرمح المعار",39,"ر",1,0],["قد يضرط الشعرُ حيناً","في لحيةِ البيهقيِّ",40,"ي",1,0],["قد يقعِد المرءَ طولُ رحلتِه","ويُصمتُ الرَّحل طولُ إنقاضه",41,"ض",2,0],["قديرٍ متى شاء الإبانَة نالها","وإن شاء تدقيقاً أدقّ وأغمضا",42,"ض",2,0],["قديمه مطرب ومحدثه","فهو جديد الجديد والخَلِق",43,"ق",1,0],["قديرٌ من الخرفان كان رضيفُه","شِواءً من الرُّقط الثقيل مغارما",44,"م",2,0],["قد يَفْرقُ المجنون من كَيَّتي","ويصعقُ العِفريت من رجمي",45,"م",2,0],["قد يربع المرءُ في دارٍ محافَظةً","وليس إلا الأثافي السفعُ والحُمَمُ",46,"م",1,0],["قد يُحَثُّ الجوادُ غيرَ بطيءٍ","ويُهَزُّ الحسامُ غيرَ كهام",47,"م",1,0],["قد يفِي للصديقِ غير أمينِهْ","ويخونُ الصديقَ غيرُ ظنينِهْ",48,"ن",2,1],["قد يعظُم الشيء بتعظيمه","وربما هان بتهوينه",49,"ن",2,0],["قَديمٌ تَرى الأَصواءَ فيهِ كَأَنَّها","رِجالٌ قِيامٌ عُصِّبوا بِسُبوبِ",50,"ب",1,0],["قُدَيديمَةَ التَجريبِ وَالحِلمِ أَنَّني","أَرى غَفَلاتِ العَيشِ قَبلَ التَجارِبِ",51,"ب",1,1],["قَد يَصيرُ الشَيكُ إِكليلاً لِلمَلكٍ أَو نَبي","وَيَصيرُ الوَردُ في عُروَةِ لِصٍّ أَو بَغي",52,"ي",1,0],["قَد يَقيني الخَطَرَ الشَوكُ الَّذي يَجرَحُ كَفّي","وَيَكونُ السُمُّ في العِطرِ الَّذي يَملَءُ أَنفي",52,"ي",1,0],["قَد يُرزَقُ الخافِض