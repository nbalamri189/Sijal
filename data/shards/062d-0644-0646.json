{"poems":[[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[438,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96696","الرمل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139321",""],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104766","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62919","السريع"],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""]],"verses":[["حلَّ نوراً بآدَمٍ فاِستَنارَ الص","صلبُ منه والجبهة الغرّاءُ",0,"ا",2,0],["حُلَّ نقاب الجوّ عن واصلٍ","يفقُدُ تيهاً صلفَ الهاجرِ",1,"ر",1,0],["حلّ نامورَ فُؤادي فهو ما","لِسواه قطّ فيهِ مشترك",2,"ك",1,0],["حُلنَ عنّي وقد تعرقنَ لحمي","وبرينَ العِظامَ بَريَ العودِ",3,"د",1,0],["حَلَنا بهِ زِرّاً حَلَلنا بهِ ذُرًى","على شُرَفٍ ما قَد جَرَت قَطُّ فِى الفِكرِ",4,"ر",1,0],["حَلُّ نظامِ الدين في حَلِّهِ","وعقدُهُ في غُلّةِ اللاذِبِ",5,"ب",1,0],["حلنا فينا .. ولا نقدر .. نطوله","غافلين أحساس ما فيه أهتمام",6,"م",1,0]]}