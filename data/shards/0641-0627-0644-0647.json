,"https://www.poetsgate.com/ViewPoem.aspx?id=212197",""],[5512,"إلى العرب","https://www.poetsgate.com/ViewPoem.aspx?id=204925",""],[5587,"إرادة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=191323",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5704,"صعُبَ الكلام على الكلام...","https://www.poetsgate.com/ViewPoem.aspx?id=200003",""],[5725,"احبس الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=195395",""],[5781,"فاكهةُ الشِّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185318",""],[5906,"في الحكمة/ الغرور / بَينَ الغُرورِ","https://www.poetsgate.com/ViewPoem.aspx?id=188517",""],[5939,"مكرُ الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=185494",""],[5944,"ارحم الصب","https://www.poetsgate.com/ViewPoem.aspx?id=212972",""],[5956,"تحنان للخلد المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=182999",""],[5957,"الرحيل الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179589",""],[5969,"لمن عاش الذي فينا","https://www.poetsgate.com/ViewPoem.aspx?id=199241",""],[5969,"مِنْ لَظى التعياءِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=199332",""],[5970,"قالوا اصطبر قلت إن الصبر قد نفذا","https://www.poetsgate.com/ViewPoem.aspx?id=130634",""],[5973,"تعجلت الرحيل إلي الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22123",""],[5989,"خلي فؤادي ...","https://www.poetsgate.com/ViewPoem.aspx?id=181564",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6056,"حلايا الحووور","https://www.poetsgate.com/ViewPoem.aspx?id=156712",""],[6120,"يَا قَلْبِي دَعْ عَنْكَ الْأَمَلَ","https://www.poetsgate.com/ViewPoem.aspx?id=214879",""],[6124,"يوم الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=194529",""],[6124,"خاتم الأشعار","https://www.poetsgate.com/ViewPoem.aspx?id=201323",""],[563,"ألا يا من بدا فينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56275&r=&rc=5",""],[6229,"قلادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65192&r=&rc=17",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[6302,"فَكُونيْ ... عيدَهُ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86203&r=&rc=1",""]],"verses":[["فَالهَوى وأَيسرُه","ما تَرينَ مِن وَجَلِي",0,"ل",2,0],["فالهَجْرُ أرْوَحُ والأماني ضلّةٌ","إنْ حالَ عَهْدٌ أو أرابَ خَليلُ",1,"ل",1,0],["فالهدى من سبيله والحُمَيْدَى","من نواه والبرُّ من أزْوَادِهْ",2,"د",2,0],["فالْهُ عن نِسبةٍ نصيبُكَ منها","لفظةٌ نِصفُها المُقدَّم قحطُ",3,"ط",1,0],["فالْهُ عما فات منه","ما إلى النجم مراقي",4,"ق",2,0],["فألهَى امْرَأً تسكينُهُ متحركاً","وأبكى امرَأً تحريكهُ منه ساكنا",5,"ن",2,0],["فالهُدى حيث تطلعُ الشمسُ مِنْهُ","والندى حيث تستهِلُّ دجونه",6,"ن",2,0],["فالْهُ في المهرجان لهو مُريح","مُستَجِمٍّ لذلك الدَّيْدانِ",7,"ن",1,0],["فالهُ عنها تَهُن عليك يقيناً","بأبي أنتَ يا فتى الفتيان",8,"ن",1,0],["فالهوى والشَّبابُ والمرحُ المع","سولُ تشدو أَفنانهُ ونَسِيمُهْ",9,"م",2,0],["فَالْهُ ودَعْ عنكَ أحادِيثَهم","سَيُصْبِحُ الذَّاكِرُ كالنّاسِي",10,"س",2,0],["فَأَلهَ عَن نَبوَةِ الأَخِلّاءِ إِذ كا","نَ عَتيداً في كُلِّ عودٍ دُخانُه",11,"ن",2,0],["فَالهَواءُ البَسيطُ في جَمرَةِ القَي","ظِ سَمومٌ وَفي الرَبيعِ نَسيمُ",12,"م",1,0],["فَاِلهُ عَن حالَتَي سُرورٍ وَحُزنٍ","فَإِلى غايَةٍ مَجاري الأُمورِ",13,"ر",1,0],["فألْهُو على رِقْبَةِ الكاشحينَ","بمفْعمةِ السُّوق خُرسِ البُرَى",14,"ا",1,0],["فَالهُضبُ أَوحَشَ مِمَّن كانَ يَسكُنُهُ","هَضبُ الوِراقِ فَما جادَت لَهُ الجَمَدُ",15,"د",1,0],["فَالهِلالُ المُنيفُ وَالبَدرُ وَالفَر","قَدُ وَالصُبحُ وَالثَرى وَالماءُ",16,"م",3,0],["فَالهَبيتُ لا فُؤادَ لَهُ","وَالثَبيتُ ثَبتُهُ فَهَمُه",17,"م",2,0],["فَالْهَوى لي قدَرٌ غَالِبٌ","كَيْفَ أَعْصي القَدَرَ الغَالِبا",18,"ب",2,0],["فالهُدى حيث تطلعُ الشمسُ مِنْهُ","والندى حين تستهِلُّ دجونه",19,"ن",2,0],["فالهبر مثلي ثم مث","لك أردني التابعية",20,"ي",2,0],["فالهبر من أهلها أحمى لحوزته","في معرض الذب يوم الروع عن دار",21,"ر",1,0],["فالهبر تطربني وتعجب","ني ملامحه الرصينة",22,"ن",2,0],["فالهبر في دنيا الهمالة","رغم أنف الفضل أوحد",23,"د",1,0],["فالهَىْ عن الرِّيف يا فَقْعاً بقَرقَرةٍ","وابغى النزولَ على اليَربوع والوَرَلِ",24,"ل",1,0],["فَأَلهَبَ حَرباً بِأَصبارِها","فَلَم أَكُ فيها ضَعيفَ القُوى",25,"ا",1,0],["فالهمز من ذي اللين مبدلاً أتى","وقل من عين وهاء يا فتى",26,"ت",2,0],["فَأَلهَبتِ الحَماسَةُ كَفَّ بِشرٍ","فَصَعَّدَ سَيفُهُ المَصدورُ جَمرا",27,"ر",2,0],["فالهُ بها لَهوَ الحكيم الذي","لم يُنسِه حاضِرُه ماضِيَه",28,"ي",2,0],["فَالْهَاشِمِيَّةُ بَعْدَ قُرْبِ مَزَارِهَا","شَطَّتْ نَوَاهَا مَا أَمَرَّ نَوَاهَا",29,"ا",3,1],["فَالْهَاشِمِيَّةُ ذِكْرُهَا مِنْ طِيبِهِ","قَدْ طَيَّبَ الأَسْمَاعَ وَالأَفْوَاهَا",29,"ا",3,0],["فالهوى عندي شعور","فاق أشهى كلِّ عَذْبِ",30,"ب",1,0],["فالهوى قاسٍ ظلومٌ","قاتلٌ لي أو مُهينُ",31,"ن",1,0],["فالهواء الصحيح يدعى عليلا","والمصاب اللديغ يسمى سليما",32,"م",2,0],["فالهوى يلعب بالقلب كما","لتعب الذرة في قلب الهواء",33,"ا",2,0],["فَالهَمُّ لَيلٌ وَهيَ صُبحٌ وَما","لَيلٌ بِلا صُبحٍ بِمَطرودِ",34,"د",1,0],["فَالهَنا وَالبَسطُ حالي","وَشِعاري وَدِثاري",35,"ي",1,0],["فالهزار الغريب قد يتغنى","وبجنبيه عاصفات الشجون",36,"ن",1,0],["فالهوى فاق حدودي","وتجلي ما اختفا",37,"ف",2,0],["فَالهَوى عُذري وَصَبري وَائلي","وَالأَسى مرّي وَضدّي من كلابِ",38,"ب",1,0],["فالهِنْدُ تَقْتُلُ بالنِّيرانِ أنْفُسَها","وعندَها أنَّها إذْ ذاكَ تُحْييها",39,"ي",3,0],["فالهيكل السفلي كالعرش العلِي","والسرُّ ربٌّ والدعا ألحان",40,"ن",1,0],["فأُلِّهَ ثم قُدِّس ثم أُحيِي","كما قد مات من ثمر المُحال",41,"ل",1,0],["فالهالك الملعون قد جمعت به","أسواؤه طرّاً معاً لدهائه",42,"ا",3,0],["فالهجرة الأولى إلى الرحمن بالإِ","خلاص في سر وفي إعلان",43,"ن",1,0],["فالهدى فيما أنى عن أحمد","خَلِّنَا من قول ذي قول جريح",44,"ح",1,0],["فالهَوى يترك العَزيزَ أَخا السَطوة","في حالة الذَليل الرَكيكِ",45,"ك",1,0],["فالْهُ عني فقد لهوتُ بظبي","هو طول الزمان برٌّ وَدودُ",46,"د",1,0],["فالهمومُ التي سبتْ كلُّ قلبٍ","كلُّ قلبٍ منها طليقُ السَّراح",47,"ح",1,0],["فَالهُ بِراحٍ قَد صَفَت مِنَ الكَدَر","كَأَنَّها في الجامِ شَمسٌ في قَمَر",48,"ر",1,0],["فَالهَمُّ لَيسَ يَراكَ في لَيلِ الصِبى","فَاِنعَم فَلَيسَ يَراكَ إِن هُوَ أَقمَرا",49,"ر",2,0],["فَاِلْهُ بِنا بَينَ بُدورِ الغَدرِ","مَع جاهِلِ الرِدفِ حَليمِ الخَصرِ",50,"ر",1,0],["فَالهُ بِنا فَالحَيا قَد اِنتَصَبَت","مِنهُ عَلى كُلِّ بِركَةٍ نَردُ",51,"د",1,0],["فَاِلهُ ما دامَ لِلشَقيقِ خَلوقٌ","تَنثُرُ السُحبُ فيهِ مِسكَ الضَبابِ",52,"ب",1,0],["فالهلال مبتسم","يمتطي بها السحبا",53,"ب",2,0],["فأَلْهَبَ خوفاً ليس يخبو حريقُهُ","وأعقب سكراً ليس يصحو مُفيقُهُ",54,"ق",2,0],["فالهجر ليل والوصال صباح","قد راق في حان الوفا مشروبهم",55,"م",1,0],["فإلَهُ الورى له محبوبٌ","واسمه المصطفى شفاء القلوب",56,"ب",1,0],["فَأَلْهَتْكَ بَسَاتِيْنُ","كَ ذَاتُ النَّوْرِ والزَّهْرِ",57,"ر",1,0],["فَالهَدى فيهِم ضارِبٌ أَطنابَهُ","وَالحَقُّ مَلِقٌ في الوَرى بِجِرانِ",58,"ن",1,0],["فالهَمّ أَودَى عِلّةٍ بَشَريَّةٍ","إنَّ الهَمُومَ زَمانَهُ المَهمُومِ",59,"م",1,0],["فالهوى العذريُّ فردوسٌ بهِ","يجتني الرَغدَ اللبيب الارشدُ",60,"د",1,0],["فالهطلُ عند نزول الغيث واكفهُ","قد ضرني ضرراً ما مثله ضررُ",61,"ر",1,0],["فالهلك كلّ الهلك هلك من ادعى","فيه الورى دعوى بغير بيان",62,"ن",1,0],["فالهم مطرود إذا طلعت","كاساتها واللهو مطرد",63,"د",1,0],["فالهجو قذف والرثاء نياحة","والعتب ذل والمديح سؤال",64,"ل",1,0],["فالهاوتانِ فكبكبٌ فتجاوب","فالبوص فالأفراغ من أشقاب",65,"ب",1,0],["فأَلهاهُ عن بيضِ الدُّمَى حَذَرُ الظُّبى","وأَسْلاهُ خُوْفُ الطَّعْنِ عَنْ كلِّ نَجْلاءِ",66,"ا",2,0],["فالهُجْرُ قد أَنْفَدَ صبري وفي","نَفادِهِ للعُمْرِ إِنفادُ",67,"د",1,0],["فالهواء الصحيح يدعى عليلا","واللديغ المصاب يدعى سليما",68,"م",2,0],["فآلة الحقن على ذلها","تطهر المصران من فضله",69,"ل",2,0],["فالهاء فيه هاء سكت كلمت","والنون من تنوينه قد أبدلت",70,"ت",1,0],["فَآله خيرُ آلٍ بَيتُهُم عَلَمٌ","بِفَضلِهِ وَالَّذي يَشناه كَالعَدمِ",71,"م",1,1],["فَالهج بِكَعبَتِه الغرا وَطيبَته","وَناد في النادِ لا يلهيكَ تغفيلُ",72,"ل",1,0],["فالهوى فضَّاح قطُّ لا يجدي","لا تحاول لومي لا تغيرعزمي",73,"ي",1,0],["فالهول يعصف والحوادث تلتظي","لهباً ذكت نيرانه بضرام",74,"م",1,0],["فإلهٌ يدعو إليه البرايا","من أقاموا لارتضيه الإها",75,"ا",3,0],["فَأَلهاهُمُ بِاِثنَينِ مِنهُم كِلاهُما","بِهِ قارِبٌ مِنَ النَجعِ دَميمُ",76,"م",1,0],["فألهاهم صيدهم في الجبال","فلا يعلمون بها ما الخبر",77,"ر",1,0],["فالهجر أوحشني والضر امرضني","والصبر انحلني والفكر هيمني",78,"ن",2,0],["فالهنا كل الهنا في التوأم","آتني الصهباء ناراً ذائبه",79,"ه",1,0],["فالهِجرةُ الأولَى إِلى الرَّحَمنِ بال","إخلاصِ في سٍِّ وفي إعلانِ",80,"ن",1,0],["فالهجر الأول الى الرحمن بال","إخلاص في سر وفي اعلان",80,"ن",1,0],["فَالهُوَينا مَركَبٌ ما خِلتُهُ","يُشرِكُ البادونَ فيهِ الحَضَرا",81,"ر",2,0],["فالهج يذكر الله وارض بحكمه","لا روح للفقراء دون لقائه",82,"ا",3,0],["فألهمك الرحمن ما كان مضمرا","من الحق تجلوه بنور الضمائر",83,"ر",1,0],["فَأَلهَجُ كُلَّما اِستَذكَرتُ مجداً","أَضاعَتهُ الشَبيبَةُ بِالأَغاني",84,"ن",2,0],["فَالهَولُ يَركَبُهُ الفَتى","حَذَرَ المَخازي والسَآمَه",85,"م",2,0],["فالهَمُّ فيه ثِقَلٌ","وَمنهُ أَصلَ السْقَمِ",86,"م",1,0],["فَالهَوى الفَضّاحُ يُدعى","عِندَنا الفَتح المُبين",87,"ن",1,0],["فَالهَوا ماءٌ تَهادى","وَالنَّدى ماءٌ رَكَد",87,"د",1,0],["فألهمت في سرها بين يديه","أن أرضعيه فإذا خفت عليه",88,"ه",1,0],["فَالهَمُّ بَيضاتُ الخُدو","رِ هُناكَ لا النَعَمُ المُراحُ",89,"ح",1,0],["فالهَوى هُوّةُ وللنفسِ داءٌ","إن آفة النفوسِ هَواها",90,"ا",3,0],["فالْهَجْ بذكرِ الحِبِّ إن","تَكُ بالصبابة مُعلِنا",91,"ن",2,0],["فالهجرُ أَفْتَلُ مَا يكون عَلَى الفتى","إنْ كَانَ طبعاً فِي الهوى يَتودَّد",92,"د",1,0],["فالهجو طب داء جهل الأنفس","واسمع فقول الهجو يا ابن الأقعس",93,"س",1,0],["فالهامِيانِ رحْمةً للورى","نوالُهُ والمَطَرُ الصَّيِّبُ",94,"ب",1,0],["فإله السماء قد ضمن الرز","ق عليه ويقتضي بالدعاء",95,"ا",2,0],["فَأَلهَبَت قَلبي بِذاكَ اللَظى","وَهاجَ مِنّي في الحَشى جُلُّ نار",96,"ر",1,0],["فَالهَوى داءٌ دَفينٌ","وَيحَ مَن يوماً اتاهُ",97,"ه",1,0],["فالهنا عم إذ تولد لكن","لرزايا الطفوف جدد ذكرا",98,"ر",2,0],["فالهالكونَ على الحقيقةِ ليس ينتفعونَ","بالقُدَّاس والقُربانِ",99,"ن",1,0],["فَالهِلالُ المنير بِالشَمس يَسعى","طالع بِالبَها بِأَوجِ السُعود",100,"د",1,0],["فالهوج من كرب الجسوم سواكن","والهوج من كرب النفوس سواف",101,"ف",1,0],["فإلهنا ونبينا وكتابنا","لم يتّصف بالخلف فيها اثنان",102,"ن",1,0],["فالهم يفرق من لآليء فرقها","والحزن يطفأ عن سناها ال