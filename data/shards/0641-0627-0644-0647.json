{"poems":[[63,"قل في الهوى حيلي","https://www.aldiwan.net/poem45722.html","المقتضب"],[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[51,"أيا ابن رجاء وابنه الخير لا يزل","https://www.aldiwan.net/poem66382.html","الطويل"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"من يكن يكرم اللئام فقد أضحوا","https://www.aldiwan.net/poem66495.html","الخفيف"],[92,"راعها منه صمته ووجومه","https://www.aldiwan.net/poem38890.html","الخفيف"],[56,"قل لهضيم الكشح مياس","https://www.aldiwan.net/poem58569.html","الكامل"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[66,"لا تصاحب من الأنام لئيما","https://www.aldiwan.net/poem38588.html","الخفيف"],[74,"لا العطايا ولا الرزايا بواق","https://www.aldiwan.net/poem12952.html","الخفيف"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[46,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[76,"عاتب ظلت له عاتبا","https://www.aldiwan.net/poem39497.html","البسيط"],[51,"غابن الحمد حقَّهُ مغبُونهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30800",""],[122,"يا مدعي عام اللواء","https://www.aldiwan.net/poem23712.html","مجزوء الكامل"],[122,"الناس ما الناس عبدان القوى بهم","https://www.aldiwan.net/poem23728.html","البسيط"],[122,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[122,"الهبر عاد","https://www.aldiwan.net/poem23760.html","مجزوء الكامل"],[140,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[205,"ألم تر أني كرهت الحروب","https://www.aldiwan.net/poem27984.html","المتقارب"],[220,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[221,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[223,"كم ساعة آلمني مسها","https://www.aldiwan.net/poem55108.html","السريع"],[235,"فالهاشمية بعد قرب مزارها","https://www.aldiwan.net/poem19736.html","الكامل"],[252,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[252,"يا عيوني ارحميني","https://www.aldiwan.net/poem25014.html","مجزوء الرمل"],[259,"غير بدع إذا ظلمت بدهر","https://www.aldiwan.net/poem38184.html","الخفيف"],[259,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[280,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[302,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[326,"سامحيني إذا شدوت وألقيت","https://www.aldiwan.net/poem54921.html","الخفيف"],[350,"الحبيب الشرود","https://www.aldiwan.net/poem950.html",""],[351,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[374,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[374,"أذوب إذا رأيت يسوع يوما","https://www.aldiwan.net/poem59292.html","الطويل"],[374,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[400,"يا قوم فرض الهجرتين بحاله","https://www.aldiwan.net/poem33398.html","الكامل"],[400,"فاروعني يا صفي الدين ما","https://www.aldiwan.net/poem33983.html","الرمل"],[402,"ربة اللوم أقصري فض فوك","https://www.aldiwan.net/poem50140.html","الخفيف"],[429,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[462,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[466,"قد نشر الروض من الزهر حبر","https://www.aldiwan.net/poem60041.html","الرجز"],[466,"يا أيها الرشأ الذي قد عذرا","https://www.aldiwan.net/poem60101.html","الكامل"],[466,"يا نجم قد لاحت نجوم القطر","https://www.aldiwan.net/poem60136.html","الرجز"],[466,"أجلنار يلوح أم خد","https://www.aldiwan.net/poem60179.html","المنسرح"],[466,"أمهات الثمار بين الروابي","https://www.aldiwan.net/poem60440.html","السريع"],[477,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[549,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[556,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[556,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[565,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"]],"verses":[["فَالهَوى وأَيسرُه","ما تَرينَ مِن وَجَلِي",0,"ل",2,0],["فالهَجْرُ أرْوَحُ والأماني ضلّةٌ","إنْ حالَ عَهْدٌ أو أرابَ خَليلُ",1,"ل",1,0],["فالهدى من سبيله والحُمَيْدَى","من نواه والبرُّ من أزْوَادِهْ",2,"د",2,0],["فالْهُ عن نِسبةٍ نصيبُكَ منها","لفظةٌ نِصفُها المُقدَّم قحطُ",3,"ط",1,0],["فالْهُ عما فات منه","ما إلى النجم مراقي",4,"ق",2,0],["فألهَى امْرَأً تسكينُهُ متحركاً","وأبكى امرَأً تحريكهُ منه ساكنا",5,"ن",2,0],["فالهُدى حيث تطلعُ الشمسُ مِنْهُ","والندى حيث تستهِلُّ دجونه",6,"ن",2,0],["فالْهُ في المهرجان لهو مُريح","مُستَجِمٍّ لذلك الدَّيْدانِ",7,"ن",1,0],["فالهُ عنها تَهُن عليك يقيناً","بأبي أنتَ يا فتى الفتيان",8,"ن",1,0],["فالهوى والشَّبابُ والمرحُ المع","سولُ تشدو أَفنانهُ ونَسِيمُهْ",9,"م",2,0],["فَالْهُ ودَعْ عنكَ أحادِيثَهم","سَيُصْبِحُ الذَّاكِرُ كالنّاسِي",10,"س",2,0],["فَأَلهَ عَن نَبوَةِ الأَخِلّاءِ إِذ كا","نَ عَتيداً في كُلِّ عودٍ دُخانُه",11,"ن",2,0],["فَالهَواءُ البَسيطُ في جَمرَةِ القَي","ظِ سَمومٌ وَفي الرَبيعِ نَسيمُ",12,"م",1,0],["فَاِلهُ عَن حالَتَي سُرورٍ وَحُزنٍ","فَإِلى غايَةٍ مَجاري الأُمورِ",13,"ر",1,0],["فألْهُو على رِقْبَةِ الكاشحينَ","بمفْعمةِ السُّوق خُرسِ البُرَى",14,"ا",1,0],["فَالهُضبُ أَوحَشَ مِمَّن كانَ يَسكُنُهُ","هَضبُ الوِراقِ فَما جادَت لَهُ الجَمَدُ",15,"د",1,0],["فَالهِلالُ المُنيفُ وَالبَدرُ وَالفَر","قَدُ وَالصُبحُ وَالثَرى وَالماءُ",16,"م",3,0],["فَالهَبيتُ لا فُؤادَ لَهُ","وَالثَبيتُ ثَبتُهُ فَهَمُه",17,"م",2,0],["فَالْهَوى لي قدَرٌ غَالِبٌ","كَيْفَ أَعْصي القَدَرَ الغَالِبا",18,"ب",2,0],["فالهُدى حيث تطلعُ الشمسُ مِنْهُ","والندى حين تستهِلُّ دجونه",19,"ن",2,0],["فالهبر مثلي ثم مث","لك أردني التابعية",20,"ي",2,0],["فالهبر من أهلها أحمى لحوزته","في معرض الذب يوم الروع عن دار",21,"ر",1,0],["فالهبر تطربني وتعجب","ني ملامحه الرصينة",22,"ن",2,0],["فالهبر في دنيا الهمالة","رغم أنف الفضل أوحد",23,"د",1,0],["فالهَىْ عن الرِّيف يا فَقْعاً بقَرقَرةٍ","وابغى النزولَ على اليَربوع والوَرَلِ",24,"ل",1,0],["فَأَلهَبَ حَرباً بِأَصبارِها","فَلَم أَكُ فيها ضَعيفَ القُوى",25,"ا",1,0],["فالهمز من ذي اللين مبدلاً أتى","وقل من عين وهاء يا فتى",26,"ت",2,0],["فَأَلهَبتِ الحَماسَةُ كَفَّ بِشرٍ","فَصَعَّدَ سَيفُهُ المَصدورُ جَمرا",27,"ر",2,0],["فالهُ بها لَهوَ الحكيم الذي","لم يُنسِه حاضِرُه ماضِيَه",28,"ي",2,0],["فَالْهَاشِمِيَّةُ بَعْدَ قُرْبِ مَزَارِهَا","شَطَّتْ نَوَاهَا مَا أَمَرَّ نَوَاهَا",29,"ا",3,1],["فَالْهَاشِمِيَّةُ ذِكْرُهَا مِنْ طِيبِهِ","قَدْ طَيَّبَ الأَسْمَاعَ وَالأَفْوَاهَا",29,"ا",3,0],["فالهوى عندي شعور","فاق أشهى كلِّ عَذْبِ",30,"ب",1,0],["فالهوى قاسٍ ظلومٌ","قاتلٌ لي أو مُهينُ",31,"ن",1,0],["فالهواء الصحيح يدعى عليلا","والمصاب اللديغ يسمى سليما",32,"م",2,0],["فالهوى يلعب بالقلب كما","لتعب الذرة في قلب الهواء",33,"ا",2,0],["فَالهَمُّ لَيلٌ وَهيَ صُبحٌ وَما","لَيلٌ بِلا صُبحٍ بِمَطرودِ",34,"د",1,0],["فَالهَنا وَالبَسطُ حالي","وَشِعاري وَدِثاري",35,"ي",1,0],["فالهزار الغريب قد يتغنى","وبجنبيه عاصفات الشجون",36,"ن",1,0],["فالهوى فاق حدودي","وتجلي ما اختفا",37,"ف",2,0],["فَالهَوى عُذري وَصَبري وَائلي","وَالأَسى مرّي وَضدّي من كلابِ",38,"ب",1,0],["فالهِنْدُ تَقْتُلُ بالنِّيرانِ أنْفُسَها","وعندَها أنَّها إذْ ذاكَ تُحْييها",39,"ي",3,0],["فالهيكل السفلي كالعرش العلِي","والسرُّ ربٌّ والدعا ألحان",40,"ن",1,0],["فأُلِّهَ ثم قُدِّس ثم أُحيِي","كما قد مات من ثمر المُحال",41,"ل",1,0],["فالهالك الملعون قد جمعت به","أسواؤه طرّاً معاً لدهائه",42,"ا",3,0],["فالهجرة الأولى إلى الرحمن بالإِ","خلاص في سر وفي إعلان",43,"ن",1,0],["فالهدى فيما أنى عن أحمد","خَلِّنَا من قول ذي قول جريح",44,"ح",1,0],["فالهَوى يترك العَزيزَ أَخا السَطوة","في حالة الذَليل الرَكيكِ",45,"ك",1,0],["فالْهُ عني فقد لهوتُ بظبي","هو طول الزمان برٌّ وَدودُ",46,"د",1,0],["فالهمومُ التي سبتْ كلُّ قلبٍ","كلُّ قلبٍ منها طليقُ السَّراح",47,"ح",1,0],["فَالهُ بِراحٍ قَد صَفَت مِنَ الكَدَر","كَأَنَّها في الجامِ شَمسٌ في قَمَر",48,"ر",1,0],["فَالهَمُّ لَيسَ يَراكَ في لَيلِ الصِبى","فَاِنعَم فَلَيسَ يَراكَ إِن هُوَ أَقمَرا",49,"ر",2,0],["فَاِلْهُ بِنا بَينَ بُدورِ الغَدرِ","مَع جاهِلِ الرِدفِ حَليمِ الخَصرِ",50,"ر",1,0],["فَالهُ بِنا فَالحَيا قَد اِنتَصَبَت","مِنهُ عَلى كُلِّ بِركَةٍ نَردُ",51,"د",1,0],["فَاِلهُ ما دامَ لِلشَقيقِ خَلوقٌ","تَنثُرُ السُحبُ فيهِ مِسكَ الضَبابِ",52,"ب",1,0],["فالهلال مبتسم","يمتطي بها السحبا",53,"ب",2,0],["فأَلْهَبَ خوفاً ليس يخبو حريقُهُ","وأعقب سكراً ليس يصحو مُفيقُهُ",54,"ق",2,0],["فالهجر ليل والوصال صباح","قد راق في حان الوفا مشروبهم",55,"م",1,0],["فإلَهُ الورى له محبوبٌ","واسمه المصطفى شفاء القلوب",56,"ب",1,0],["فَأَلْهَتْكَ بَسَاتِيْنُ","كَ ذَاتُ النَّوْرِ والزَّهْرِ",57,"ر",1,0]]}