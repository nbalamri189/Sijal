,"الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103005","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32448","المنسرح"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102736","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72452","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76703","البسيط"],[4691,"السيد المقيم","https://www.poetsgate.com/ViewPoem.aspx?id=114273",""],[4702,"مديت كفي وكفيت مدي","https://www.poetsgate.com/ViewPoem.aspx?id=155466",""],[4748,"أتردد للمكان","https://www.poetsgate.com/ViewPoem.aspx?id=4191",""],[4767,"طود العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=94353",""],[4788,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=132283",""],[4802,"أبعاد","https://www.poetsgate.com/ViewPoem.aspx?id=32337",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[4578,"عينا بمنشور الهوى جيت والياً","https://www.poetsgate.com/ViewPoem.aspx?id=49614",""],[4927,"الْعِشْقُ الأَبْيَض","https://www.poetsgate.com/ViewPoem.aspx?id=29733",""],[4984,"هي مهلة","https://www.poetsgate.com/ViewPoem.aspx?id=178907",""],[4991,"شاغلتني","https://www.poetsgate.com/ViewPoem.aspx?id=183314",""],[5038,"رحماك خذني","https://www.poetsgate.com/ViewPoem.aspx?id=195431",""],[5061,"انت عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=154887",""],[5111,"جَمَرُ الكَلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=212329",""],[5122,"ليلي والنجوم","https://www.poetsgate.com/ViewPoem.aspx?id=29715",""],[5152,"أنا .. من أنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=184362",""],[5190,"قطوف دانية ( 5 )","https://www.poetsgate.com/ViewPoem.aspx?id=153480",""],[5216,"عَيناكِ بَحْر","https://www.poetsgate.com/ViewPoem.aspx?id=187653",""],[5277,"لا يأسَ مع الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=198843",""],[5277,"قالت","https://www.poetsgate.com/ViewPoem.aspx?id=213099",""],[5376,"قد سامك الشؤمُ ما في وجهِكَ البشْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=188445",""],[5431,"أمطريني ماء طهركْ","https://www.poetsgate.com/ViewPoem.aspx?id=183436",""],[5431,"تبارك الخلدُ في عينيك يارجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=186687",""],[5431,"مهما فعلت وكيفما ...","https://www.poetsgate.com/ViewPoem.aspx?id=198603",""],[5461,"من بلاه الله","https://www.poetsgate.com/ViewPoem.aspx?id=5231",""],[5463,"زاد شكّك في غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=30343",""],[5463,"بنت حمران النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=30882",""],[5525,"نبض الحب","https://www.poetsgate.com/ViewPoem.aspx?id=7303",""],[5606,"وأول حروف اسمي على صدرك ونبضك تكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=197790",""],[5652,"ياغايبه عن شوف عيني فقدتك","https://www.poetsgate.com/ViewPoem.aspx?id=135934",""],[5652,"فقر وصندقه","https://www.poetsgate.com/ViewPoem.aspx?id=178103",""],[5694,"اعشقك نجد","https://www.poetsgate.com/ViewPoem.aspx?id=132105",""],[5732,"اخترت بعد الدار عن قرب الانجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177853",""],[5749,"الدوا والطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=29663",""],[5781,"قلبٌ وذرَّاتُ رماد ...","https://www.poetsgate.com/ViewPoem.aspx?id=176650",""],[5790,"أعشق البيض ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=112098",""],[5848,"كلي حلالك","https://www.poetsgate.com/ViewPoem.aspx?id=49226",""],[5956,"هيئتها كرؤوسُ العيس","https://www.poetsgate.com/ViewPoem.aspx?id=183158",""],[5956,"العيش الصَّحيح","https://www.poetsgate.com/ViewPoem.aspx?id=183590",""],[5973,"أرْقصْ علي إيقاعات أعصابي","https://www.poetsgate.com/ViewPoem.aspx?id=13761",""],[6038,"مجرد أوهام 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25701",""],[6100,"مات النمل ياواد النمل","https://www.poetsgate.com/ViewPoem.aspx?id=52591",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""]],"verses":[["أعشبت أرمدة الأزمان في","مقلتيّ ، جلمدت شمسي ونجمي",0,"م",2,0],["أعُشّاقَ غيْرِ الواحدِ الأحَدِ الباقي","جُنونُكُمُ واللهِ أعْيَ على الرّاقي",1,"ق",2,1],["أعشو إلى ديرِها الأقصى وقد لمعت","تحت الدجى فكأنَّ الدَّير مشكاة",2,"ه",1,0],["أَعشَقُ الحُسنَ وَالمَلاحَةَ وَالظُر","فَ وَأَهوى مَحاسِنَ الأَخلاقِ",3,"ق",1,0],["أَعشَقُ المُرْدَ والنّكَارِيشَ والشِّي","بَ وعندي مِثْلُ البنينَ البَناتُ",4,"ت",1,1],["أعشابنا بالماء أخرج صبغها","حاطت به زمناً وأنعم طبخُها",5,"خ",3,1],["أعشق الأنوارَ من","تاجِكَ هذا تترامى",6,"م",2,0],["أَعشَقُ وَحدي وَيُؤخَذونَ بِهِ","كَالتُركِ تَغزو فَتُؤخَذُ الخَزَرُ",7,"ر",1,0],["أعَشناكِ وَعِشنا بِ","كِ إِنَّ العَيشَ مَحبوبُ",8,"ب",1,0],["أعشق الزُّهرَ في السماء فأشدو","وَهوَ في الأَرض يعشق الأزهارا",9,"ر",2,0],["أعشق الليلَ وما لي والضحى","عشت يا ليل: ألا فانسدل",10,"ل",1,0],["أعشَقُ النُبْلَ في جلالةِ معنا","هُ وأهوَى الإقدامَ في عَزَماته",11,"ت",2,0],["أعشرون ألفا قلبهم قلب مؤمن","بأوجههم نور اليقين ينور",12,"ر",1,0],["أعشقك من عادني فوّل سنيني","لين صرت آخذ مع نفسي قراري",13,"ر",2,0],["آعشق حكيك وأحفظه يا ضنيني","حفظ أبن تيميّه ل حكي البخاري",13,"ر",2,0],["أعشق الحسن دوحة وغديرا","وبيانا سمحا وفجرا مندّى",14,"د",2,0],["أعشِقتِ مثلَكِ في السماء","اختاً تَحِنُّ الى اللقاء",15,"ا",2,0],["أعشقُ الحبَّ والحبيبَ لأني","في هوى الحبِّ والحبيب قتيلُ",16,"ل",1,0],["أَعشُقُ الصَدقَ لا أَقولُ سِوى الحَ","قّ وَلَو جارَ في الحَياةِ عَلَيّا",17,"ي",2,1],["اعشى النواظر والبصير إذا دجى","خطب عليه فطرفه لم يبصر",18,"ر",1,0],["أَعْشَى العُيونَ بِها الْتِماعُ حَديدِهِمْ","فَتَشابَهَتْ لامَاتُهُمْ إذْ تَلْمَعُ",19,"ع",1,0],["أعشارُ قَلبي قُطِّعَت فَتَقَطَّعَت","بِمُدى الأَعادي يَومَ عاشوراءِ",20,"ا",2,0],["أَعشو بِعَينٍ وَأُخرى قَد أَضَرَّ بِها","رَيبُ الزَمانِ فَأَمسى ضَوؤُها خَمَدا",21,"د",2,0],["أعشق الموت فكرة في خيالي","أتحدى بها قضاء القضاء",22,"ا",2,0],["أعِشْ لنا سالماً مَولىً نَعيشُ به","وأحْيِه هو بأْسا في الورى ونَدى",23,"د",2,0],["اعشَق فَإِنَّكَ لا مَحالَةَ تَعذِرُ","فَإِذا عَشِقتَ فَقُل لَنا مَن يَقبَلُ",24,"ل",1,1],["أَعشاق أَبكار المَكارم وَالعُلا","عَلى حين لا عان بِهنَّ وَلا واني",25,"ن",2,0],["اعشقوا الثلج في سفوح جبال ال","أرض والورد في سفوح التلال",26,"ل",1,0],["أعشق الكرم والعرائش والنب","ع وأحيا عمري حياة إله",26,"ه",1,0],["أعشى الدليلَ دجى الدلالِ فسائلوا","فلك الأزِرّةِ عن مطالعِ بدرِه",27,"ر",2,0],["أعشى عليه ضِراماً بات يُلهِبهُ","بخاطري وهو عندي ساكنٌ فيه",28,"ي",2,0],["أعشى عيونَ الشهبِ حتى لم يدَعْ","طرْفاً لها إلا قَضى أن يُطْرَفا",29,"ف",2,0],["أعشَبَ قومٌ بولاياتهم","والنصح يُرضيه برعي الهشيمْ",30,"م",1,0],["أَعشبتُمُ فَبطِنْتُ في مَرعاكُمُ","والدهرُ يَقْنَعُ لي بفضلِ الجِرَّةِ",31,"ه",1,0],["أَعشَبَ خَدّي مِنَ البُكاءِ وَقَد","أَورَقَ غُصنُ الهَوى عَلى كَبِدي",32,"د",2,0],["أعشق الورد لما يظ","هر لي من وجناته",33,"ت",2,0],["اعشقِ الحسنَ إن أردت التلاقي","واتصال الأرواح بالأرواح",34,"ح",1,0],["إعشقْ إذنْ لا بدَّ أنْ تعشقْ","ألعِشقُ مِثل الموتِ لا تَقلقْ",35,"ق",1,1],["أعشيَتَ بالدمع أجفاني لتخدعَني","يا حبُّ كي لا أرى ما تُضمرِ الحجب",36,"ب",1,0],["أعشاق الملاحة خبرونا","بأوصاف الحبيب وسامرونا",37,"ن",2,1],["أعشَيتُ سَبَّاقَ البَيَانِ وَرُبَّمَا","أعطَيتُ رَاحَتَهُ عِنَانَ مُبَرِّزِ",38,"ز",1,0],["اعشقُ المعجبَ ما جالَ وصال","واذا مالَ فمالي مذهبُ",39,"ب",1,0],["اعشقوا الباقي الأتمّ جمالا","فهواه في كلّ حال ساقي",40,"ق",2,0],["أعشق السهد والبكار وأنيني","والتصابي إذا الظلام اكفهرا",41,"ر",2,0],["أَعُشَّاقَ المُدامَةِ إِن جَزِعتُم","لِفُرقَتِها فَلَيسَ مَكانَ صَبرِ",42,"ر",1,0],["أعشق كالبلبل الزهور كما","لها أغنّي كالبلبل الغرد",43,"د",1,0],["أعشق السُّحب إذا ما زحفت","تمنح الكون نثار الدرر",44,"ر",1,0],["أعشق الزهر وأهوى لثمه","إن عدمت الحظ من خدود خال",45,"ل",1,0],["أعشاق سبخاها وحلال ربعها","بسوء مناخ في اراض صغيرة",46,"ر",2,0],["أعشاشها في صفوف","موضونة في المساند",47,"د",1,0],["أعشرؤة من قد كان جنكيز جدَّه","أماتت دما فيهم تقدس بالطهر",48,"ر",1,0],["اعشقْ جمال البرايا","نماذجًا لا فُرَادَى",49,"د",2,1],["أعشق أرباب الذقون شهوةً","وكل من لحيته في يده",50,"ه",1,0],["اعشت البيض عينه فهو لا ين","ظر الا اسنة ونصالا",51,"ل",2,0],["أعشق السالف الطريّ وأهوى","ريَّ ذاك المفلّج المعسول",52,"ل",1,0],["أَعشَقُ وَحدي فَيُؤخَذونَ بِهِ