{"poems":[[102,"وجوه دخانية في مرايا الليل","https://www.aldiwan.net/poem24840.html","عموديه"],[79,"أعشاق غير الواحد الأحد الباقي","https://www.aldiwan.net/poem35913.html","الطويل"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"رفعت رايتي على العشاق","https://www.aldiwan.net/poem42791.html","الخفيف"],[58,"أعشق المرد والنكاريش والشيب","https://www.aldiwan.net/poem58629.html","الخفيف"],[64,"أعشابنا بالماء أخرج صبغها","https://www.aldiwan.net/poem52213.html","الكامل"],[99,"أحسد الشيب على رأسك","https://www.aldiwan.net/poem24404.html","مجزوء الرمل"],[52,"ماذا عليهم وما لهم خرسوا","https://www.aldiwan.net/poem62399.html","المنسرح"],[52,"ألا يا طيب قد طبت","https://www.aldiwan.net/poem64849.html","الهزج"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85508","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[112,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=34733",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[203,"سائلوه متى يفيق الذي جن","https://www.aldiwan.net/poem45613.html","الخفيف"],[227,"أعشق الصدق لا أقول سوى الحق","https://www.aldiwan.net/poem39697.html","الخفيف"],[265,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[279,"جلدا خليلي ما لنفسك تجزع","https://www.aldiwan.net/poem25489.html","الكامل"],[286,"الشوق أذكى النار في أحشائي","https://www.aldiwan.net/poem32893.html","الكامل"],[304,"غادرني سهمه أعشى وغادره","https://www.aldiwan.net/poem45495.html","البسيط"],[332,"أنا أحيى كطائر حطم القي","https://www.aldiwan.net/poem54965.html","الخفيف"],[368,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[370,"اعشق فإنك لا محالة تعذر","https://www.aldiwan.net/poem17082.html","الكامل"],[384,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[398,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[436,"سفحت عيون الغيث أدمع قطره","https://www.aldiwan.net/poem12612.html","الكامل"],[436,"خذوا لقلبي أمانا من تجنيه","https://www.aldiwan.net/poem12768.html","البسيط"],[436,"ما زال يخدع قلبه حتى هفا","https://www.aldiwan.net/poem12801.html","الكامل"],[461,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[461,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[556,"واكبدا أحرق الهوى كبدي","https://www.aldiwan.net/poem68369.html","المنسرح"],[561,"أنا أدرى كنه ذاته","https://www.aldiwan.net/poem33517.html","مجزوء الرمل"],[561,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"]],"verses":[["أعشبت أرمدة الأزمان في","مقلتيّ ، جلمدت شمسي ونجمي",0,"م",2,0],["أعُشّاقَ غيْرِ الواحدِ الأحَدِ الباقي","جُنونُكُمُ واللهِ أعْيَ على الرّاقي",1,"ق",2,1],["أعشو إلى ديرِها الأقصى وقد لمعت","تحت الدجى فكأنَّ الدَّير مشكاة",2,"ه",1,0],["أَعشَقُ الحُسنَ وَالمَلاحَةَ وَالظُر","فَ وَأَهوى مَحاسِنَ الأَخلاقِ",3,"ق",1,0],["أَعشَقُ المُرْدَ والنّكَارِيشَ والشِّي","بَ وعندي مِثْلُ البنينَ البَناتُ",4,"ت",1,1],["أعشابنا بالماء أخرج صبغها","حاطت به زمناً وأنعم طبخُها",5,"خ",3,1],["أعشق الأنوارَ من","تاجِكَ هذا تترامى",6,"م",2,0],["أَعشَقُ وَحدي وَيُؤخَذونَ بِهِ","كَالتُركِ تَغزو فَتُؤخَذُ الخَزَرُ",7,"ر",1,0],["أعَشناكِ وَعِشنا بِ","كِ إِنَّ العَيشَ مَحبوبُ",8,"ب",1,0],["أعشق الزُّهرَ في السماء فأشدو","وَهوَ في الأَرض يعشق الأزهارا",9,"ر",2,0],["أعشق الليلَ وما لي والضحى","عشت يا ليل: ألا فانسدل",10,"ل",1,0],["أعشَقُ النُبْلَ في جلالةِ معنا","هُ وأهوَى الإقدامَ في عَزَماته",11,"ت",2,0],["أعشرون ألفا قلبهم قلب مؤمن","بأوجههم نور اليقين ينور",12,"ر",1,0],["أعشقك من عادني فوّل سنيني","لين صرت آخذ مع نفسي قراري",13,"ر",2,0],["آعشق حكيك وأحفظه يا ضنيني","حفظ أبن تيميّه ل حكي البخاري",13,"ر",2,0],["أعشق الحسن دوحة وغديرا","وبيانا سمحا وفجرا مندّى",14,"د",2,0],["أعشِقتِ مثلَكِ في السماء","اختاً تَحِنُّ الى اللقاء",15,"ا",2,0],["أعشقُ الحبَّ والحبيبَ لأني","في هوى الحبِّ والحبيب قتيلُ",16,"ل",1,0],["أَعشُقُ الصَدقَ لا أَقولُ سِوى الحَ","قّ وَلَو جارَ في الحَياةِ عَلَيّا",17,"ي",2,1],["اعشى النواظر والبصير إذا دجى","خطب عليه فطرفه لم يبصر",18,"ر",1,0],["أَعْشَى العُيونَ بِها الْتِماعُ حَديدِهِمْ","فَتَشابَهَتْ لامَاتُهُمْ إذْ تَلْمَعُ",19,"ع",1,0],["أعشارُ قَلبي قُطِّعَت فَتَقَطَّعَت","بِمُدى الأَعادي يَومَ عاشوراءِ",20,"ا",2,0],["أَعشو بِعَينٍ وَأُخرى قَد أَضَرَّ بِها","رَيبُ الزَمانِ فَأَمسى ضَوؤُها خَمَدا",21,"د",2,0],["أعشق الموت فكرة في خيالي","أتحدى بها قضاء القضاء",22,"ا",2,0],["أعِشْ لنا سالماً مَولىً نَعيشُ به","وأحْيِه هو بأْسا في الورى ونَدى",23,"د",2,0],["اعشَق فَإِنَّكَ لا مَحالَةَ تَعذِرُ","فَإِذا عَشِقتَ فَقُل لَنا مَن يَقبَلُ",24,"ل",1,1],["أَعشاق أَبكار المَكارم وَالعُلا","عَلى حين لا عان بِهنَّ وَلا واني",25,"ن",2,0],["اعشقوا الثلج في سفوح جبال ال","أرض والورد في سفوح التلال",26,"ل",1,0],["أعشق الكرم والعرائش والنب","ع وأحيا عمري حياة إله",26,"ه",1,0],["أعشى الدليلَ دجى الدلالِ فسائلوا","فلك الأزِرّةِ عن مطالعِ بدرِه",27,"ر",2,0],["أعشى عليه ضِراماً بات يُلهِبهُ","بخاطري وهو عندي ساكنٌ فيه",28,"ي",2,0],["أعشى عيونَ الشهبِ حتى لم يدَعْ","طرْفاً لها إلا قَضى أن يُطْرَفا",29,"ف",2,0],["أعشَبَ قومٌ بولاياتهم","والنصح يُرضيه برعي الهشيمْ",30,"م",1,0],["أَعشبتُمُ فَبطِنْتُ في مَرعاكُمُ","والدهرُ يَقْنَعُ لي بفضلِ الجِرَّةِ",31,"ه",1,0],["أَعشَبَ خَدّي مِنَ البُكاءِ وَقَد","أَورَقَ غُصنُ الهَوى عَلى كَبِدي",32,"د",2,0],["أعشق الورد لما يظ","هر لي من وجناته",33,"ت",2,0],["اعشقِ الحسنَ إن أردت التلاقي","واتصال الأرواح بالأرواح",34,"ح",1,0]]}