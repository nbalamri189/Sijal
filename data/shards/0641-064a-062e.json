{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"باح بالمضمر الدفين","https://www.aldiwan.net/poem30183.html","مجزوء الخفيف"],[63,"طرقت أميمة والكواكب جنح","https://www.aldiwan.net/poem45775.html","الكامل"],[63,"ونفحة من ربا ذي الأثل قابلني","https://www.aldiwan.net/poem45794.html","البسيط"],[3,"جزى الله الأغر جزاء صدق","https://www.aldiwan.net/poem88.html",""],[77,"والله لو كانت حياتي في يدي","https://www.aldiwan.net/poem35842.html","الكامل"],[42,"يروح بها الماشي لقاءك أو يغدو","https://www.aldiwan.net/poem50419.html","الطويل"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[93,"أحننت من شوق إلى لبنان","https://www.aldiwan.net/poem11270.html","الكامل"],[93,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[83,"أمولاي يا ابن السابقين إلى العلا","https://www.aldiwan.net/poem54264.html","الطويل"],[88,"سكنا ولم يسكن حراك التبدد","https://www.aldiwan.net/poem45021.html","الطويل"],[72,"أعمال برك في حلي امتداحك يا","https://www.aldiwan.net/poem20040.html","البسيط"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[72,"في خده وعذاره الفتان","https://www.aldiwan.net/poem20288.html","الكامل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[72,"لهفي على غادة إذا أسفرت","https://www.aldiwan.net/poem20618.html","المنسرح"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[92,"غناه الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[89,"لكل طلوع يا ذكاء أفول","https://www.aldiwan.net/poem44942.html","الطويل"],[85,"عصفورتان في الحجاز","https://www.aldiwan.net/poem7997.html","مجزوء الرجز"],[85,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[56,"في خده خال كأن","https://www.aldiwan.net/poem58605.html","مجزوء الكامل"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[61,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[61,"خطرات هي العلا وارتياح","https://www.aldiwan.net/poem51733.html","الخفيف"],[61,"وأغن كالرشإ الغرير","https://www.aldiwan.net/poem51775.html","مجزوء الكامل"],[66,"أين في الحمى عرب","https://www.aldiwan.net/poem40097.html","المقتضب"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[97,"أنت وحي العبقرية","https://www.aldiwan.net/poem24802.html","مجزوء الرمل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[31,"لم تر العين للثريا شبيها","https://www.aldiwan.net/poem41276.html","الخفيف"],[31,"مرحبا ثم مرهبا بالتي قا","https://www.aldiwan.net/poem41862.html","الخفيف"],[74,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[81,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[81,"دنف قضى عز الجمال بهونه","https://www.aldiwan.net/poem61471.html","الكامل"],[102,"تعلقها قلبي ولم أدر ما اسمها","https://www.aldiwan.net/poem33028.html","الطويل"],[48,"أنعت ديكا من ديوك الهند أحسن","https://www.aldiwan.net/poem63253.html","الرجز"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[46,"إذا أنت لم تحضر مع القوم مسجدا","https://www.aldiwan.net/poem22931.html","الطويل"],[15,"فيخفق مرة ويفيد أخرى","https://www.aldiwan.net/poem45280.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55014","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"تحية موجزة","https://www.poetsgate.com/ViewPoem.aspx?id=179384",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[45,"يا فضل فيم الصدود والغضب","https://www.poetsgate.com/ViewPoem.aspx?id=33097",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""]],"verses":[["فَيَخرُجُ الأَرقَمُ مِن ضَيغَمٍ","وَيَخرُجُ الضَيغَمُ مِن أَرقَمِ",0,"م",1,0],["في خِمارٍ مِنَ اللَمى","وَقَميصٍ مِنَ اللَعَس",1,"س",1,0],["في خُرَّدٍ بيضِ التَّرائِبِ أَقبَلَتْ","تَشكو إِليَّ خُصورُها الأَكفالا",2,"ل",2,0],["في خُرّدٍ عُرُبٍ أَكفالُها رُجُحٌ","هِيفٍ حَمَلنَ عَلى الكُثبانِ أَغصانا",3,"ن",2,0],["فَيُخفِقُ تارَةً وَيُفيدُ أُخرى","وَيَفجَعُ ذا الضَغائِنِ بِالأَريبِ",4,"ب",1,0],["في خفْضِ عيْشٍ لا تُكَلِّفُ منّة ال","إنْسانِ مَطْعمَهُ ولا سُقْياهُ",5,"ي",3,0],["فَيُخبِرُنا ما بالُ صَرمِكَ بَعدَ ما","رَضيتَ وَما غَيَّرتَ مِن خُلُقٍ بَعدُ",6,"د",1,0],["في خَطبِ مِصرَ لِبُطرُسٍ أَخمَدتَها","مَشبوبَةً كانَت عَلى الأَبوابِ",7,"ب",1,0],["فَيَخالُها الراؤونَ قَد","قَرَّت وَلَيسَ بِها قَرار",8,"ر",1,0],["فِي خَيْرِ مَنْ رَفَعَ الضَّلالَةَ بِالهُدَى","عَنْ قَوْمِهِ وَالجَهْلَ بِالعِرْفَانِ",9,"ن",1,0],["فِي خَيْرِ مَنْ خَبَرَتْهُ","مِنْ حَاكِمٍ وَحَكِيمِ",10,"م",1,0],["فيُخجلُ منك الشمسَ شمسُ هدايةٍ","ويحسُدُ منك البدرُ بدراً مكمَّلا",11,"ل",2,0],["فيخطَف أشلاءً من القوم حيَّةً","ولم يُقِدِ المقتول منها ولم يَدِ",12,"د",1,0],["في خنصر العدّ أو جيد الرجاء بها","خير القلائد أو خير الخواتيم",13,"م",1,0],["في خدِّها ذهبٌ أنادي غوثه","يا أيُّها المصري يا ذا النون",14,"ن",1,0],["في خدِّه وعذاره الفتَّان","عوّذ سناه بزخرفٍ ودخان",15,"ن",1,1],["في خدِّه التبريّ هانَ نشبي","وقيمة الفضَّة دون الذهب",16,"ب",1,0],["في خدِّها شامةٌ معنبرةٌ","يا نعمةٌ بالشقيق مزهرةٌ",17,"ه",1,0],["فيخرُجن حيناً حائناً ما انتحينَه","وإن تخذ التسبيحَ منهنَّ مَفزعا",18,"ع",2,0],["فَيَخُفُّ في الرَجُلِ الحَليمِ وَقارُهُ","وَيُراجِعُ الشَيخَ المُسِنَّ غُرورُهُ",19,"ر",2,0],["فَيَخَالُ الكونَ يُناجيهِ","وجَمالَ العالَمِ يُسْعِدُهُ",20,"د",2,0],["فيخفى ضياء منك للعين باهرٌ","ويظهر نور للنجوم ضئيل",21,"ل",1,0],["في خامِلٍ مِنَ الرِيا","ضِ لا نَدٍ وَلا حَسَن",22,"ن",1,0],["في خِلالِ الخُطوبِ ما راعَ إِلّا","أَنَّها دونَ صَبرِكُم وَجَمالِه",23,"ل",2,0],["في خِلالٍ لَفَتَت زَهرَ الرُبى","وَسَجايا أَنِسَت الشَربَ الدِنانا",24,"ن",2,0],["في خِوانِهِ","كُلُّ ما يَجِب",25,"ب",1,0],["في خَدِّهِ خَالٌ كأَنَّ","أَنامِلاً صَبَغَتْهُ عَمْدَا",26,"د",2,1],["في خَطِّهِ مِن كُلِّ قَلبٍ شَهوَةٌ","حَتّى كَأَنَّ مِدادَهُ الأَهواءُ",27,"ا",2,0],["في خَميسٍ مِنَ الأُسودِ بَئيسٍ","يَفتَرِسنَ النُفوسَ وَالأَموالا",28,"ل",2,0],["في خَفضِ عَيشٍ وَظِلِّ مَملَكَةٍ","قَد كانَ يَصفو بِها لَنا الحَلَبُ",29,"ب",1,0],["فَيَخْضِبُ من دمائِكُمُ العوالي","ويَنقَعُ من صديدِكُمُ الجُزوعا",30,"ع",2,0],["في خَميسٍ كاللَّيلِ وجهُكَ مصبا","حٌ تَجلَّى ضياه بل إصباحُ",31,"ح",1,0],["في خَدِّه وردٌ حَما","ةُ من القِطافِ بعَقرَبِ",32,"ب",1,0],["في خِيامِهِم قَمَرٌ","بِالصِفاحِ مُحتَجِبُ",33,"ب",1,0],["في خَطِّ ذي قَلَمٍ أَو نُطقِ ذي شَفَةٍ","فَقَد عَرَفناكَ مِنها أَيَّ مَعرِفَةٍ",34,"ه",1,0],["في خيالاتٍ غوال","وأمانٍ ذهبيه",35,"ي",2,0],["في خلقها الإنْسيِّ من وحشيّةٍ","كُحْلٌ وحُسْنُ تَلَفُّتٍ وَنِفارُ",36,"ر",1,0],["في خَميسٍ تُغَمِّضُ الشمسُ عيناً","فوقه من مَهيلِ نَقْعٍ مُثارِ",37,"ر",1,0],["في خَلاءٍ مِنَ الأَنيسِ وَأَمنٍ","فَشَفَينا غَلَيلَهُ وَاِشتَفَينا",38,"ن",2,0],["في خَلاءٍ كَيما يَرَينَكَ عِندي","فَيُصَدِّقنَني فَداكَ قَبيلي",39,"ي",1,0],["في خُضرِ عودٍ بِالأَراكِ مُوَشَّحٍ","أَو رَأسِ طَودٍ بِالغَمامِ مُعَمَّمِ",40,"م",1,0],["في خَدِّهِ رَونَقُ الحُسامِ","وَحَدُّهُ بَينَ مُقلَتَيهِ",41,"ه",1,0],["في خَدِّ موسى نَقطُ خالٍ رائِقٍ","نَورُ العِذارِ مُحَلَّأٌ مِن نونِهِ",42,"ن",2,0],["فيخطفُ لوْني فرطُ ما أنا واجدٌ","بها وبما يُلقى هواها على وهمي",43,"ي",1,0],["في خَطوِهِ كَالمِسَكِ المُرتَدِّ","فَالقِرنُ دَوماً عِندَهُ يُعَدّي",44,"د",2,0],["في خُضرَةٍ شَبَّ لَها التَصفيرُ","كَأَنَّما نيطَ بِها التَنويرُ",45,"ر",1,0],["فَيُخبِرَ بِالتَقصيرِ عَنكَ مُؤَنِّباً","وَتَسكُبَ دَمعاً حَيثُ لا يَنفَعُ الدَمعُ",46,"ع",1,0],["فَيُخفِقُ مَرَّةً وَيُفيدُ أُخرى","وَيُلحِقُ ذا المَلامَةِ بِالأَريبِ",47,"ب",1,1],["في خَيالٍ مَرحٍ أو فلسفَهْ","أبصرَ الدُّنيا بعيني آدمِ",48,"م",1,0],["فِي خَمْسَ عَشْرَ مِنَ السِّنِينِ أَتَيْتَ مَا","لَمْ يَأْت غَيْرُكَ مِنْ سِنِينَ طِوالِ",49,"ل",1,0],["فِي خِدْمَةِ الأَرْضِ الَّتِي هِيَ أُمُّنا","يَتَأَلَّفُ المَتْبُوعُ قَلْبَ التَّابِعِ",50,"ع",1,0],["في خُشُوعٍ يُشِيدُ باسمْ فُؤَادٍ","مِثْلَمَا رَدَّدَ المُصَلِّي أَذَانَهْ",51,"ن",2,0],["فيخرُّ في ساح الجها","د، ولا ثواب ولا مثيب!",52,"ب",1,0],["في خَلْقِه وخُلْقِه المكتمِل","كاد يكون مضربا للمثل",53,"ل",1,0],["في خَلْقِ آدَمَ يَا لَهُ تَجْهِيلا","مِمَّن عَصَى بعدَ القتيلِ قتيلا",54,"ل",2,0],["في خفض عيش وظل مملكة","قد كان يصفو لما بها الحلب",55,"ب",1,0],["فيخطىء الغيُّ بك المَراشدا","ويسلك الجورْ بك المآسدا",56,"د",2,0]]}