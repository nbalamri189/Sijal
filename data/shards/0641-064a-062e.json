ps://www.aldiwan.net/poem27791.html","الوافر"],[506,"أصبحت مثل الجنان في الصدر","https://www.aldiwan.net/poem2463.html","المنسرح"],[515,"يا صاح لست من الغرام بصاح","https://www.aldiwan.net/poem12056.html","الكامل"],[515,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[538,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[551,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[551,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[558,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[562,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[562,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[562,"لاحت فقلنا كوكب الصبح بان","https://www.aldiwan.net/poem52897.html","السريع"],[575,"طرفي عن وجهك لم يطرف","https://www.aldiwan.net/poem2912.html","السريع"],[587,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["فَيَخرُجُ الأَرقَمُ مِن ضَيغَمٍ","وَيَخرُجُ الضَيغَمُ مِن أَرقَمِ",0,"م",1,0],["في خِمارٍ مِنَ اللَمى","وَقَميصٍ مِنَ اللَعَس",1,"س",1,0],["في خُرَّدٍ بيضِ التَّرائِبِ أَقبَلَتْ","تَشكو إِليَّ خُصورُها الأَكفالا",2,"ل",2,0],["في خُرّدٍ عُرُبٍ أَكفالُها رُجُحٌ","هِيفٍ حَمَلنَ عَلى الكُثبانِ أَغصانا",3,"ن",2,0],["فَيُخفِقُ تارَةً وَيُفيدُ أُخرى","وَيَفجَعُ ذا الضَغائِنِ بِالأَريبِ",4,"ب",1,0],["في خفْضِ عيْشٍ لا تُكَلِّفُ منّة ال","إنْسانِ مَطْعمَهُ ولا سُقْياهُ",5,"ي",3,0],["فَيُخبِرُنا ما بالُ صَرمِكَ بَعدَ ما","رَضيتَ وَما غَيَّرتَ مِن خُلُقٍ بَعدُ",6,"د",1,0],["في خَطبِ مِصرَ لِبُطرُسٍ أَخمَدتَها","مَشبوبَةً كانَت عَلى الأَبوابِ",7,"ب",1,0],["فَيَخالُها الراؤونَ قَد","قَرَّت وَلَيسَ بِها قَرار",8,"ر",1,0],["فِي خَيْرِ مَنْ رَفَعَ الضَّلالَةَ بِالهُدَى","عَنْ قَوْمِهِ وَالجَهْلَ بِالعِرْفَانِ",9,"ن",1,0],["فِي خَيْرِ مَنْ خَبَرَتْهُ","مِنْ حَاكِمٍ وَحَكِيمِ",10,"م",1,0],["فيُخجلُ منك الشمسَ شمسُ هدايةٍ","ويحسُدُ منك البدرُ بدراً مكمَّلا",11,"ل",2,0],["فيخطَف أشلاءً من القوم حيَّةً","ولم يُقِدِ المقتول منها ولم يَدِ",12,"د",1,0],["في خنصر العدّ أو جيد الرجاء بها","خير القلائد أو خير الخواتيم",13,"م",1,0],["في خدِّها ذهبٌ أنادي غوثه","يا أيُّها المصري يا ذا النون",14,"ن",1,0],["في خدِّه وعذاره الفتَّان","عوّذ سناه بزخرفٍ ودخان",15,"ن",1,1],["في خدِّه التبريّ هانَ نشبي","وقيمة الفضَّة دون الذهب",16,"ب",1,0],["في خدِّها شامةٌ معنبرةٌ","يا نعمةٌ بالشقيق مزهرةٌ",17,"ه",1,0],["فيخرُجن حيناً حائناً ما انتحينَه","وإن تخذ التسبيحَ منهنَّ مَفزعا",18,"ع",2,0],["فَيَخُفُّ في الرَجُلِ الحَليمِ وَقارُهُ","وَيُراجِعُ الشَيخَ المُسِنَّ غُرورُهُ",19,"ر",2,0],["فَيَخَالُ الكونَ يُناجيهِ","وجَمالَ العالَمِ يُسْعِدُهُ",20,"د",2,0],["فيخفى ضياء منك للعين باهرٌ","ويظهر نور للنجوم ضئيل",21,"ل",1,0],["في خامِلٍ مِنَ الرِيا","ضِ لا نَدٍ وَلا حَسَن",22,"ن",1,0],["في خِلالِ الخُطوبِ ما راعَ إِلّا","أَنَّها دونَ صَبرِكُم وَجَمالِه",23,"ل",2,0],["في خِلالٍ لَفَتَت زَهرَ الرُبى","وَسَجايا أَنِسَت الشَربَ الدِنانا",24,"ن",2,0],["في خِوانِهِ","كُلُّ ما يَجِب",25,"ب",1,0],["في خَدِّهِ خَالٌ كأَنَّ","أَنامِلاً صَبَغَتْهُ عَمْدَا",26,"د",2,1],["في خَطِّهِ مِن كُلِّ قَلبٍ شَهوَةٌ","حَتّى كَأَنَّ مِدادَهُ الأَهواءُ",27,"ا",2,0],["في خَميسٍ مِنَ الأُسودِ بَئيسٍ","يَفتَرِسنَ النُفوسَ وَالأَموالا",28,"ل",2,0],["في خَفضِ عَيشٍ وَظِلِّ مَملَكَةٍ","قَد كانَ يَصفو بِها لَنا الحَلَبُ",29,"ب",1,0],["فَيَخْضِبُ من دمائِكُمُ العوالي","ويَنقَعُ من صديدِكُمُ الجُزوعا",30,"ع",2,0],["في خَميسٍ كاللَّيلِ وجهُكَ مصبا","حٌ تَجلَّى ضياه بل إصباحُ",31,"ح",1,0],["في خَدِّه وردٌ حَما","ةُ من القِطافِ بعَقرَبِ",32,"ب",1,0],["في خِيامِهِم قَمَرٌ","بِالصِفاحِ مُحتَجِبُ",33,"ب",1,0],["في خَطِّ ذي قَلَمٍ أَو نُطقِ ذي شَفَةٍ","فَقَد عَرَفناكَ مِنها أَيَّ مَعرِفَةٍ",34,"ه",1,0],["في خيالاتٍ غوال","وأمانٍ ذهبيه",35,"ي",2,0],["في خلقها الإنْسيِّ من وحشيّةٍ","كُحْلٌ وحُسْنُ تَلَفُّتٍ وَنِفارُ",36,"ر",1,0],["في خَميسٍ تُغَمِّضُ الشمسُ عيناً","فوقه من مَهيلِ نَقْعٍ مُثارِ",37,"ر",1,0],["في خَلاءٍ مِنَ الأَنيسِ وَأَمنٍ","فَشَفَينا غَلَيلَهُ وَاِشتَفَينا",38,"ن",2,0],["في خَلاءٍ كَيما يَرَينَكَ عِندي","فَيُصَدِّقنَني فَداكَ قَبيلي",39,"ي",1,0],["في خُضرِ عودٍ بِالأَراكِ مُوَشَّحٍ","أَو رَأسِ طَودٍ بِالغَمامِ مُعَمَّمِ",40,"م",1,0],["في خَدِّهِ رَونَقُ الحُسامِ","وَحَدُّهُ بَينَ مُقلَتَيهِ",41,"ه",1,0],["في خَدِّ موسى نَقطُ خالٍ رائِقٍ","نَورُ العِذارِ مُحَلَّأٌ مِن نونِهِ",42,"ن",2,0],["فيخطفُ لوْني فرطُ ما أنا واجدٌ","بها وبما يُلقى هواها على وهمي",43,"ي",1,0],["في خَطوِهِ كَالمِسَكِ المُرتَدِّ","فَالقِرنُ دَوماً عِندَهُ يُعَدّي",44,"د",2,0],["في خُضرَةٍ شَبَّ لَها التَصفيرُ","كَأَنَّما نيطَ بِها التَنويرُ",45,"ر",1,0],["فَيُخبِرَ بِالتَقصيرِ عَنكَ مُؤَنِّباً","وَتَسكُبَ دَمعاً حَيثُ لا يَنفَعُ الدَمعُ",46,"ع",1,0],["فَيُخفِقُ مَرَّةً وَيُفيدُ أُخرى","وَيُلحِقُ ذا المَلامَةِ بِالأَريبِ",47,"ب",1,1],["في خَيالٍ مَرحٍ أو فلسفَهْ","أبصرَ الدُّنيا بعيني آدمِ",48,"م",1,0],["فِي خَمْسَ عَشْرَ مِنَ السِّنِينِ أَتَيْتَ مَا","لَمْ يَأْت غَيْرُكَ مِنْ سِنِينَ طِوالِ",49,"ل",1,0],["فِي خِدْمَةِ الأَرْضِ الَّتِي هِيَ أُمُّنا","يَتَأَلَّفُ المَتْبُوعُ قَلْبَ التَّابِعِ",50,"ع",1,0],["في خُشُوعٍ يُشِيدُ باسمْ فُؤَادٍ","مِثْلَمَا رَدَّدَ المُصَلِّي أَذَانَهْ",51,"ن",2,0],["فيخرُّ في ساح الجها","د، ولا ثواب ولا مثيب!",52,"ب",1,0],["في خَلْقِه وخُلْقِه المكتمِل","كاد يكون مضربا للمثل",53,"ل",1,0],["في خَلْقِ آدَمَ يَا لَهُ تَجْهِيلا","مِمَّن عَصَى بعدَ القتيلِ قتيلا",54,"ل",2,0],["في خفض عيش وظل مملكة","قد كان يصفو لما بها الحلب",55,"ب",1,0],["فيخطىء الغيُّ بك المَراشدا","ويسلك الجورْ بك المآسدا",56,"د",2,0],["* في خريدة القصر: \" أرى بناتي في أغمات من عدمٍ","يغزلن للناس ما يملكن قطميرا\"",57,"ر",2,0],["فَيَخرُج مالُكَ المجهول شَمساً","يُرِكَ الجضهلَ عنه قَد تَوَلاّ",58,"ل",2,0],["فَيُخبِرَهُ بِأَنَّ العَقلَ عِندي","جُرازٌ لا أَفَلُّ لا أَفَلُّ وَلا أَنيثُ",59,"ث",1,0],["فيخطف الباب العرانين نظمه","ويصبو شباب الحي منه وشيبه",60,"ب",2,0],["في خَدِّه تَسْعَى عقارب صُدْغِه","تحمى بها عن ثغره رشَفاتُه",61,"ت",2,0],["فَيَخرُجُونَ في ثِيَابٍ خَلِقَه","كُلٌّ ذَلِيلٌ لِلذِىِ قَد خَلَقَه",62,"ه",1,0],["فَيُخبِرَهُم أَنَّ الصَحيفَةَ مُزِّقَت","وَأَنّ كُلّ ما لَم يَرضَهُ اللَهُ مُفسَدُ",63,"د",1,0],["فَيُخرِجُها فَيَطرَحُها بِأَرضٍ","وَيُرقِدُها وَقَد سَقَطَ الرِداءُ",64,"ا",2,0],["فيخفيه لا يقراه إلا لجاهل","يغر به الغوغا الطغام ويجلب",65,"ب",1,0],["في خَدِّها رَوضٌ مِنَ الوَردِ عَلى الن","نسرينِ بِالأَلحاظِ مِنها يُجتَنى",66,"ا",1,0],["فَيَخشاهُ جَبّارٌ وَيَرجُوهُ خائِفٌ","وَأَرمَلَةٌ قَد ماتَ هُزلاً عيالُها",67,"ل",3,0],["فَيَختلِطُوا بِنا إِلاّ افتَرَقنَا","عَلَيهِم بِالسَّماحَةِ مُفضِلينَا",68,"ن",2,0],["فيُخبِر هل آثارُ لهوِى كعَهْدِها","هناك إذِ الأيامُ تُعطِي وتُنصِف",69,"ف",1,0],["في خيرِ مسجدٍ وخير دارِ","وَقبرهُ واللَّه خير قبرِ",70,"ر",1,0],["في خَلاءِ الأَرضِ حَتّى قادَهُ","تَبَعَ المُهرِ بمَنحٍ وَاِجتِلابِ",71,"ب",1,0],["فيَخالُنا الرائي قُبَيلَ","العودِ من رميِ الجمارِ",72,"ر",1,0],["في خاطر الوطن الغالي وذمّته","نواشيء في ثراه البكر أشبالُ",73,"ل",1,0],["في خَيالي وَريبَةٌ في جَبيني","وَسُوَيداءُ في دَمي",74,"ي",1,0],["في خدّ مَنْ يَتمّنى من دمي","رَشْحٌ وفي كَفَّيْه منه خِضاب",75,"ب",1,0],["في خصلَتَينِ يَفوقُ آدَمَ فيهِما","وَهُما لِأَهلِ الحَقِّ واضِحتانِ",76,"ن",1,0],["فَيَخِرُّ لِلَّهِ المُهَيمِنِ ساجِداً","لِيَقولَ ذو الجَبروتِ وَالسُلطانِ",76,"ن",1,0],["في خَدِّهِ وَردٌ وَلَكِن طَرفُهُ","أَضحى بِنَبلِ الغَنجِ مِنهُ يَحرُسُ",77,"س",1,0],["في خَدِّهِ وَثَناياهُ وَمُقلَتِهِ","وَفي عِذارَيهِ لِلمَعشوقِ بُستانُ",78,"ن",1,0],["فَيَخِرُّ عَن كَثَبٍ بِناؤُكُمُ","وَكَذاكَ ما يُبنى عَلى الرَملِ",79,"ل",1,0],["في خَميسٍ مَجرٍ يُغَمغِمُ بِالتَه","ليلِ أَبطالُهُ وَبِالتَكبيرِ",80,"ر",1,0],["فيِ خَمْسَ عَشْرَةَ بَعْدَ الأَلْفِ مَعْ مِائَةٍ","مَضَى سَرِيعاً إِلَى رَوْحٍ وَرَيْحَانِ",81,"ن",1,0],["فَيَخْلُفُ مَنْ خَلَفْتَ أَبَاكَ جَدٌّ","لَهُ قَدْ سَادَ كُلَّ أَبٍ أَبِيِّ",82,"ي",1,0],["فِي خِدْمَةِ الْمَوْلَى","شَرَابُهُ احْلَوْلَى",83,"ل",2,0],["في خدّهِ من بقايا اللثمِ تجميش","وبي لِتَشويشِ ذاك الصُّدغ تَشويشُ",84,"ش",1,1],["في خلعةٍ لو رآها يوم يلبسها","نمرود قبل وجه الأرض أو سجدا",85,"د",2,0],["فيخققُ هذا القلبُ آخرَ خَفقةٍ","بما فيهِ من وَجدٍ على هذهِ الحال",86,"ل",1,0],["فِي خُلْقِهِ سَرَسٌ وَلَيْ