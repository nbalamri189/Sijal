"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[567,"مالك موفور فما باله اكسبك","https://www.aldiwan.net/poem69501.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[575,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[585,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["وَقَد وَسَمَت حَوافِرُها كُؤوساً","وَمِن عَلَقِ الدِماءِ لَها عُقارُ",0,"ر",1,0],["وَقَد وَرَدوا بِصُدورِ الرِماحِ","كَما صَدَروا بِصُدورِ الشِفارِ",1,"ر",1,0],["وَقَدْ وَلَدَتْهُمْ مِنْ قُرَيْشٍ سَراتُها","على نَمَطَيْ بَيْضاءَ مِنْ سِرِّ فَقْعَسِ",2,"س",1,0],["وَقَدْ وَرِثْناهُما غُرّاً جَحا جِحةً","أَريبُهُمْ في الندى بِالحمْدِ مَخْدوعُ",3,"ع",1,0],["وقد ورِثْتَ أبا إسحاقَ جُرأَتَهُ","في مأزِقٍ حاضِراهُ النّصْرُ والظّفَرُ",4,"ر",1,0],["وقُدورُهُمْ يَعِدُ القِرى إرْزامُها","والرَّعْدُ ليسَ يهُمُّ بالإرزامِ",5,"م",1,0],["وقد وَلَدَتْني عُصْبَةٌ ضمَّ جَدَّهُمْ","وجَدَّ بَني ساقي الحَجيجِ عُروقُ",6,"ق",1,0],["وقد وَلِهتْ شَوْقاً إليهِ وِزارةٌ","لَها في بَني إسحاقَ مَثْوًى ومنْزِلُ",7,"ل",1,0],["وقد وفَوْا إذا ضمنوا يومَ الوَغى","رِيَّ القَنا للأَسْل النَّواهلِ",8,"ل",1,0],["وَقَد وَثِقَت بِالصِدقِ مِنكَ فَأَصبَحَت","تَزيدُكَ بُعداً كُلَّما زِدتَها قُربا",9,"ب",2,0],["وَقَدْ وُجِدَ الْمُخْتَارُ فِي الْحَفْلِ مُنْصِتاً","لَهُ وحَبَا كَعْباً عَلَيْهِ وَحَسَّانا",10,"ن",2,0],["وَقَدْ وَرَدَتْ نَهْرَ الْمَجَرَّةِ سَحْرَةً","غَوَائِصَ فِيهِ مِثْلَ مَا تَفْعَلُ الْبَطُّ",11,"ط",1,0],["وَقَد وَقَفتُ عَلى السِتّينِ أَسأَلُها","أَسَوَّفَت أَم أَعَدَّت حُرَّ أَكفاني",12,"ي",1,0],["وَقَد وَلَدَتها أُمُّها وَهيَ حامِلٌ","فَيا عَجباً إِنّي أَرى أَمرُها نُكرا",13,"ر",2,0],["وَقَد وَعَدتني النَفسُ عَنهُم بِسَلوَةٍ","وَلَكِن إِذا ما قُمتُ في الحَشرِ بِالكَفَن",14,"ن",1,0],["وَقَد وَسَموني بِالَّتي لَستُ أَهلَها","وَلَم يُمنَ أَمثالي بِأَمثالِها قَطُّ",15,"ط",1,0],["وقد ولدتك من دبر خداجاً","فجئت بمنظر كالدبر قذر",16,"ر",1,0],["وقد وقفت بُدر دُورٍ شديد","ولم تأمن من الموج انقذافه",17,"ف",2,0],["وقد وصلوا ما بين ثان وثالث","بمعقود سقف بالصخور مُشيَّد",18,"د",1,0],["وَقَد وَقَعَت قَوارِعُها بِتَيمٍ","وَقَد حَذَّرتُ لَو حَذَروا العِقابا",19,"ب",2,0],["وَقَد وَجَداني حينَ مُدَّت حِبالُنا","أَشَدَّ مُحاماةً وَأَبعَدَ مَنزَعا",20,"ع",2,0],["وَقَد وَجَدوكَ أَكرَمَهُم جُدوداً","إِذا نُسِبوا وَأَثبَتَهُم مَقاما",21,"م",2,0],["وقد وعظتنا الحال منه كأنه","خطيب رقى من صهوة النعش منبرا",22,"ر",2,0],["وقد وجدت معاني الفضل باهرةً","فإن قدرت على أوصافها فصف",23,"ف",1,0],["وقدوم عيد كان من طرب إلى","لقياك تخترق الصيام وتسبق",24,"ق",1,0],["وقد وَعْدت بفكي من شدائده","وعداً فأنْجَزَ حرُّ القوم ما وعدا",25,"د",2,0],["وقد وجبتْ لي بالمودّة حُرمةٌ","ومن بعدها ثنتان بالمدح والصبر",26,"ر",1,0],["وقد وقفوا للحائنات وشمَّروا","لهنَّ إلى الأنصاف سوقاً وأذرعا",27,"ع",2,0],["وقد وعدت عنك الأماني مواعداً","مَطَلنَ بها والحادثات فواجع",28,"ع",1,0],["وَقَد وَعَدَتكَ مَوعِداً لَو وَفَت بِهِ","كَمَوعودِ عُرقوبٍ أَخاهُ بِيَثرِبِ",29,"ب",1,0],["وَقُدورٌ هَدَرَت فَه","يَ عَلى الجَمرِ تَفورُ",30,"ر",1,0],["وَقَد وَلَدَتكَ فَقالَ الوَرى","أَلَم تَكُنِ الشَمسُ لا تُنجَلُ",31,"ل",1,0],["وَقَد وَجَدتَ مَجالَ القَولِ ذا سَعَةٍ","فَإِن وَجَدتَ لِساناً قائِلاً فَقُلِ",32,"ل",1,0],["وَقَد وَجِلَت قُلوبٌ مِنكَ حَتّى","غَدَت أَوجالُها فيها وِجالا",33,"ل",2,0],["وَقَد وَصَلَ المُهرُ الَّذي فَوقَ فَخذِهِ","مِنِ اِسمِكِ ما في كُلِّ عُنقٍ وَمِعصَمِ",34,"م",1,0],["وَقَد وَثِقَت بِالوَصلِ مِنكَ فَأَصبَحَت","تَزيدُكَ بُعداً كُلَّما زِدتَها قُربا",35,"ب",2,0],["وَقَد وَرَدوهُ وارِدَ البَحرِ بَيتَهُ","فَما ظَنُّهُم بِالبَحرِ زيدَ إِلى البَحرِ",36,"ر",1,0],["وَقَد وَرَدَت أَهواؤُهُنَّ فُؤادَهُ","وَلاحُبَّ إِلّا حُبُّ عَلوَةَ فارِطُه",37,"ط",2,0],["وَقَد وَلِيَ التَدبيرَ أَشوَسُ عِندَهُ","خِلالُ السَدادِ كُلُّها وَشَرائِطُه",37,"ط",2,0],["وَقَد وَثِقتُ بِآمالي الَّتي سَلَفَت","وَحُسنِ ظَنِّيَ في الحاجاتِ بِالحَسَنِ",38,"ن",1,0],["وقد وافاك مَوْكِبُهُم","فكنْ حرّاً كما يَجِبُ",39,"ب",1,0],["وقد وضحَتْ سطورُ البيضِ فيه","كما وَضَحتْ سطورٌ في كِتابِ",40,"ب",1,0],["وَقَد وَفى دَهرُنا وَكانَت","حِبالُ ميعادِهِ رِثاثا",41,"ث",2,0],["وَقُدورٍ بِما حَوَت راسِياتٍ","وَجِفانٍ مَملُوَّةٍ كَالجَوابي",42,"ب",2,0],["وَقُدودٍ كَأَنَّما شُدَّ عَقدُ ال","بَندِ مِنها عَلى قَضيبِ أَراكِ",43,"ك",1,0],["وقد وَقَفَ المصباحُ وقفةَ حارسٍ","رقيبٍ على الأسرار داعٍ إلى الجِدِّ",44,"د",1,0],["وقد وَسِعَتْهُمُ الحلقاتُ منها","وَأَحمَتهُنَّ للهَيجاءِ نارُ",45,"ر",1,0],["وقَد وَردت ماءَ الصباحِ بِأَعيُنٍ","نَوائِمَ في رَأيِ العيونِ سَواهِدِ",46,"د",1,0],["وَقَد وَلَّتِ الشَمسُ مُحتَثَّةً","إِلى الغَربِ بِطَرفٍ كَحيلِ",47,"ل",1,0],["وَقَد وَقَفَ اللَيلُ لا يَهتَدي","فَتَخطو بِهِ لِلثُرَيّا قَدَم",48,"م",1,0],["وَقَدّوا أَديمَ القَومِ حينَ تَرَفَّعَت","لَهُم لَيلَةٌ أُخرى كَما حَلَّقَ النَسرُ",49,"ر",1,0],["وَقُدورٌ كَأَنَّهُنَّ قُرومٌ","هُدِرَت بَينَ جِلَّةٍ وَبِكارِ",50,"ر",1,0],["وَقُدودٌ كَأَنَّهُنَّ غُصونٌ","وَخُدودٌ كَأَنَّها التُفّاحُ",51,"ح",1,0],["وَقد وَصَفَتْ لِي الناس منها عَجائِباً","كأَوْجُهِ غِيدٍ ما لَهُنَّ سُفُورُ",52,"ر",1,0],["وقد وَلّتِ الظّلماءُ تقفو نجومَها","وقد قام جيشُ الفجرِ للّيل واصْطفّا",53,"ف",2,0],["وقد وقعَتْ منك الهديّةُ إذ أتَتْ","مواقعَ برد الماء من غَلَل الصدر",54,"ر",1,0],["وقد وفَد الأسطولُ والبحرُ طالبَيْ","ندى مُزْمعي هيجاءَ هذا لذا أخ",55,"خ",1,0],["وَقَد وَعَدَت صَفَداً في غَدٍ","وَكَم وَعَدَتكَ وَلا تُصفَدُ",56,"د",1,0],["وَقَد وَعَدَتنا نائِلاً ثُمَّ أَخلَفَت","وَقالَت لَنا يَومَ الفِراقِ نَسيتُ",57,"ت",1,0],["وَقَد وَثَبَت في بَزلِها وَثبَ حَيَّةٍ","وَما قُتِلَت إِلّا بِأَسوَدَ ساكِتِ",58,"ت",1,0],["وَقَد وَجَدنا مَقالَ الناسِ ذا زِنَةٍ","فَكَيفَ يُنكَرُ أَنَّ الفِعلَ يَتَّزِنُ",59,"ن",1,0],["وقُدُورُهْم مثلُ الهِضَابِ رَواكِداً","وجِفانُهُمْ كَرحِيبةِ الأفيافِ",60,"ف",1,0],["وقد وطِئَ الحَصى ببَني بُدورٍ","صِغارٍ ما قَرُبْنَ من التّمامِ",61,"م",1,0],["وقد وَقَعَ التفريقُ والكُلّ واحد","فأرواحُنا خَمْرٌ وأشباحُنا كَرْم",62,"م",1,0],["وقد وجدت مكان القول ذا سعةٍ","فإن وجدت لساناً قائلاً فقل",63,"ل",1,0],["وقد وَصَفْت لي كُنْهَ يوْمي عَواطِفٌ","مِنَ ا