{"poems":[[53,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[53,"لبست الوغى قبل ثوب الغبار","https://www.aldiwan.net/poem30457.html","المتقارب"],[63,"دعت أم عمرو ويلها ثم أقبلت","https://www.aldiwan.net/poem46075.html","الطويل"],[63,"مجد على هامة العيوق مرفوع","https://www.aldiwan.net/poem46099.html","البسيط"],[63,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[63,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[55,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem26545.html","الطويل"],[77,"أمولاي إن الشعر ديوان حكمة","https://www.aldiwan.net/poem36078.html","الطويل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[71,"ومملوكة عندي حديث نتاجها","https://www.aldiwan.net/poem3851.html","الطويل"],[71,"رعى الله قوماً في دمشق أعزة","https://www.aldiwan.net/poem4005.html","الطويل"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[88,"ألا من مبلغ عني زنيما","https://www.aldiwan.net/poem44393.html","الوافر"],[88,"أرى الأتراك في دار الخلافه","https://www.aldiwan.net/poem44827.html","الوافر"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[27,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[27,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[72,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[51,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[51,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[16,"ذهبت من الهجران في غير مذهب","https://www.aldiwan.net/poem27693.html","الطويل"],[70,"يومنا يوم مطير","https://www.aldiwan.net/poem42877.html","مجزوء الرمل"],[43,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[43,"بقائي شاء ليس هم ارتحالا","https://www.aldiwan.net/poem10117.html","الوافر"],[43,"فراق ومن فارقت غير مذمم","https://www.aldiwan.net/poem10570.html","الطويل"],[45,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem11436.html","الطويل"],[45,"شهي إلى الأيام تقليلها وفري","https://www.aldiwan.net/poem63634.html","الطويل"],[45,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[45,"كم من وقوف على الأطلال والدمن","https://www.aldiwan.net/poem66661.html","البسيط"],[61,"شوى أثوابه قشب","https://www.aldiwan.net/poem51770.html","مجزوء الوافر"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[66,"يا من غدا للأنام غيثا","https://www.aldiwan.net/poem39069.html","مجزوء البسيط"],[66,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[97,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[80,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[74,"وقد غشي النبت بطحاءه","https://www.aldiwan.net/poem13216.html","المتقارب"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[52,"هي الدار إلا أنها منهم قفر","https://www.aldiwan.net/poem27048.html","الطويل"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[52,"فتنت قلبك العيون الملاح","https://www.aldiwan.net/poem27139.html","الخفيف"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[50,"ألا يا اسقياني بالرحيق فنيت","https://www.aldiwan.net/poem64738.html","الطويل"],[46,"هي الراح تلقي الرمح من راحة الفتى","https://www.aldiwan.net/poem22196.html","الطويل"],[46,"أودى السرور بدار كلها حزن","https://www.aldiwan.net/poem23448.html","البسيط"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140982",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[51,"وقد أغتدي للطير والطير هُجَّعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=25879",""]],"verses":[["وَقَد وَسَمَت حَوافِرُها كُؤوساً","وَمِن عَلَقِ الدِماءِ لَها عُقارُ",0,"ر",1,0],["وَقَد وَرَدوا بِصُدورِ الرِماحِ","كَما صَدَروا بِصُدورِ الشِفارِ",1,"ر",1,0],["وَقَدْ وَلَدَتْهُمْ مِنْ قُرَيْشٍ سَراتُها","على نَمَطَيْ بَيْضاءَ مِنْ سِرِّ فَقْعَسِ",2,"س",1,0],["وَقَدْ وَرِثْناهُما غُرّاً جَحا جِحةً","أَريبُهُمْ في الندى بِالحمْدِ مَخْدوعُ",3,"ع",1,0],["وقد ورِثْتَ أبا إسحاقَ جُرأَتَهُ","في مأزِقٍ حاضِراهُ النّصْرُ والظّفَرُ",4,"ر",1,0],["وقُدورُهُمْ يَعِدُ القِرى إرْزامُها","والرَّعْدُ ليسَ يهُمُّ بالإرزامِ",5,"م",1,0],["وقد وَلَدَتْني عُصْبَةٌ ضمَّ جَدَّهُمْ","وجَدَّ بَني ساقي الحَجيجِ عُروقُ",6,"ق",1,0],["وقد وَلِهتْ شَوْقاً إليهِ وِزارةٌ","لَها في بَني إسحاقَ مَثْوًى ومنْزِلُ",7,"ل",1,0],["وقد وفَوْا إذا ضمنوا يومَ الوَغى","رِيَّ القَنا للأَسْل النَّواهلِ",8,"ل",1,0],["وَقَد وَثِقَت بِالصِدقِ مِنكَ فَأَصبَحَت","تَزيدُكَ بُعداً كُلَّما زِدتَها قُربا",9,"ب",2,0],["وَقَدْ وُجِدَ الْمُخْتَارُ فِي الْحَفْلِ مُنْصِتاً","لَهُ وحَبَا كَعْباً عَلَيْهِ وَحَسَّانا",10,"ن",2,0],["وَقَدْ وَرَدَتْ نَهْرَ الْمَجَرَّةِ سَحْرَةً","غَوَائِصَ فِيهِ مِثْلَ مَا تَفْعَلُ الْبَطُّ",11,"ط",1,0],["وَقَد وَقَفتُ عَلى السِتّينِ أَسأَلُها","أَسَوَّفَت أَم أَعَدَّت حُرَّ أَكفاني",12,"ي",1,0],["وَقَد وَلَدَتها أُمُّها وَهيَ حامِلٌ","فَيا عَجباً إِنّي أَرى أَمرُها نُكرا",13,"ر",2,0],["وَقَد وَعَدتني النَفسُ عَنهُم بِسَلوَةٍ","وَلَكِن إِذا ما قُمتُ في الحَشرِ بِالكَفَن",14,"ن",1,0],["وَقَد وَسَموني بِالَّتي لَستُ أَهلَها","وَلَم يُمنَ أَمثالي بِأَمثالِها قَطُّ",15,"ط",1,0],["وقد ولدتك من دبر خداجاً","فجئت بمنظر كالدبر قذر",16,"ر",1,0],["وقد وقفت بُدر دُورٍ شديد","ولم تأمن من الموج انقذافه",17,"ف",2,0],["وقد وصلوا ما بين ثان وثالث","بمعقود سقف بالصخور مُشيَّد",18,"د",1,0],["وَقَد وَقَعَت قَوارِعُها بِتَيمٍ","وَقَد حَذَّرتُ لَو حَذَروا العِقابا",19,"ب",2,0],["وَقَد وَجَداني حينَ مُدَّت حِبالُنا","أَشَدَّ مُحاماةً وَأَبعَدَ مَنزَعا",20,"ع",2,0],["وَقَد وَجَدوكَ أَكرَمَهُم جُدوداً","إِذا نُسِبوا وَأَثبَتَهُم مَقاما",21,"م",2,0],["وقد وعظتنا الحال منه كأنه","خطيب رقى من صهوة النعش منبرا",22,"ر",2,0],["وقد وجدت معاني الفضل باهرةً","فإن قدرت على أوصافها فصف",23,"ف",1,0],["وقدوم عيد كان من طرب إلى","لقياك تخترق الصيام وتسبق",24,"ق",1,0],["وقد وَعْدت بفكي من شدائده","وعداً فأنْجَزَ حرُّ القوم ما وعدا",25,"د",2,0],["وقد وجبتْ لي بالمودّة حُرمةٌ","ومن بعدها ثنتان بالمدح والصبر",26,"ر",1,0],["وقد وقفوا للحائنات وشمَّروا","لهنَّ إلى الأنصاف سوقاً وأذرعا",27,"ع",2,0],["وقد وعدت عنك الأماني مواعداً","مَطَلنَ بها والحادثات فواجع",28,"ع",1,0],["وَقَد وَعَدَتكَ مَوعِداً لَو وَفَت بِهِ","كَمَوعودِ عُرقوبٍ أَخاهُ بِيَثرِبِ",29,"ب",1,0],["وَقُدورٌ هَدَرَت فَه","يَ عَلى الجَمرِ تَفورُ",30,"ر",1,0],["وَقَد وَلَدَتكَ فَقالَ الوَرى","أَلَم تَكُنِ الشَمسُ لا تُنجَلُ",31,"ل",1,0],["وَقَد وَجَدتَ مَجالَ القَولِ ذا سَعَةٍ","فَإِن وَجَدتَ لِساناً قائِلاً فَقُلِ",32,"ل",1,0],["وَقَد وَجِلَت قُلوبٌ مِنكَ حَتّى","غَدَت أَوجالُها فيها وِجالا",33,"ل",2,0],["وَقَد وَصَلَ المُهرُ الَّذي فَوقَ فَخذِهِ","مِنِ اِسمِكِ ما في كُلِّ عُنقٍ وَمِعصَمِ",34,"م",1,0],["وَقَد وَثِقَت بِالوَصلِ مِنكَ فَأَصبَحَت","تَزيدُكَ بُعداً كُلَّما زِدتَها قُربا",35,"ب",2,0],["وَقَد وَرَدوهُ وارِدَ البَحرِ بَيتَهُ","فَما ظَنُّهُم بِالبَحرِ زيدَ إِلى البَحرِ",36,"ر",1,0],["وَقَد وَرَدَت أَهواؤُهُنَّ فُؤادَهُ","وَلاحُبَّ إِلّا حُبُّ عَلوَةَ فارِطُه",37,"ط",2,0],["وَقَد وَلِيَ التَدبيرَ أَشوَسُ عِندَهُ","خِلالُ السَدادِ كُلُّها وَشَرائِطُه",37,"ط",2,0],["وَقَد وَثِقتُ بِآمالي الَّتي سَلَفَت","وَحُسنِ ظَنِّيَ في الحاجاتِ بِالحَسَنِ",38,"ن",1,0],["وقد وافاك مَوْكِبُهُم","فكنْ حرّاً كما يَجِبُ",39,"ب",1,0],["وقد وضحَتْ سطورُ البيضِ فيه","كما وَضَحتْ سطورٌ في كِتابِ",40,"ب",1,0],["وَقَد وَفى دَهرُنا وَكانَت","حِبالُ ميعادِهِ رِثاثا",41,"ث",2,0],["وَقُدورٍ بِما حَوَت راسِياتٍ","وَجِفانٍ مَملُوَّةٍ كَالجَوابي",42,"ب",2,0],["وَقُدودٍ كَأَنَّما شُدَّ عَقدُ ال","بَندِ مِنها عَلى قَضيبِ أَراكِ",43,"ك",1,0],["وقد وَقَفَ المصباحُ وقفةَ حارسٍ","رقيبٍ على الأسرار داعٍ إلى الجِدِّ",44,"د",1,0],["وقد وَسِعَتْهُمُ الحلقاتُ منها","وَأَحمَتهُنَّ للهَيجاءِ نارُ",45,"ر",1,0],["وقَد وَردت ماءَ الصباحِ بِأَعيُنٍ","نَوائِمَ في رَأيِ العيونِ سَواهِدِ",46,"د",1,0],["وَقَد وَلَّتِ الشَمسُ مُحتَثَّةً","إِلى الغَربِ بِطَرفٍ كَحيلِ",47,"ل",1,0],["وَقَد وَقَفَ اللَيلُ لا يَهتَدي","فَتَخطو بِهِ لِلثُرَيّا قَدَم",48,"م",1,0],["وَقَدّوا أَديمَ القَومِ حينَ تَرَفَّعَت","لَهُم لَيلَةٌ أُخرى كَما حَلَّقَ النَسرُ",49,"ر",1,0],["وَقُدورٌ كَأَنَّهُنَّ قُرومٌ","هُدِرَت بَينَ جِلَّةٍ وَبِكارِ",50,"ر",1,0],["وَقُدودٌ كَأَنَّهُنَّ غُصونٌ","وَخُدودٌ كَأَنَّها التُفّاحُ",51,"ح",1,0],["وَقد وَصَفَتْ لِي الناس منها عَجائِباً","كأَوْجُهِ غِيدٍ ما لَهُنَّ سُفُورُ",52,"ر",1,0],["وقد وَلّتِ الظّلماءُ تقفو نجومَها","وقد قام جيشُ الفجرِ للّيل واصْطفّا",53,"ف",2,0],["وقد وقعَتْ منك الهديّةُ إذ أتَتْ","مواقعَ برد الماء من غَلَل الصدر",54,"ر",1,0],["وقد وفَد الأسطولُ والبحرُ طالبَيْ","ندى مُزْمعي هيجاءَ هذا لذا أخ",55,"خ",1,0],["وَقَد وَعَدَت صَفَداً في غَدٍ","وَكَم وَعَدَتكَ وَلا تُصفَدُ",56,"د",1,0],["وَقَد وَعَدَتنا نائِلاً ثُمَّ أَخلَفَت","وَقالَت لَنا يَومَ الفِراقِ نَسيتُ",57,"ت",1,0],["وَقَد وَثَبَت في بَزلِها وَثبَ حَيَّةٍ","وَما قُتِلَت إِلّا بِأَسوَدَ ساكِتِ",58,"ت",1,0],["وَقَد وَجَدنا مَقالَ الناسِ ذا زِنَةٍ","فَكَيفَ يُنكَرُ أَنَّ الفِعلَ يَتَّزِنُ",59,"ن",1,0],["وقُدُورُهْم مثلُ الهِضَابِ رَواكِداً","وجِفانُهُمْ كَرحِيبةِ الأفيافِ",60,"ف",1,0],["وقد وطِئَ الحَصى ببَني بُدورٍ","صِغارٍ ما قَرُبْنَ من التّمامِ",61,"م",1,0],["وقد وَقَعَ التفريقُ والكُلّ واحد","فأرواحُنا خَمْرٌ وأشباحُنا كَرْم",62,"م",1,0],["وقد وجدت مكان القول ذا سعةٍ","فإن وجدت لساناً قائلاً فقل",63,"ل",1,0],["وقد وَصَفْت لي كُنْهَ يوْمي عَواطِفٌ","مِنَ الشّرّ تَغْيِيري عليها وإبْدالي",64,"ل",2,0],["وقدوة الزّهاد بعد الهادي","وصاحب الهجرة والجهاد",65,"د",1,0],["وَقَد وَفَدْنَا وَهَؤُلاَءِ هُمُ الصَّحْبُ","وَهَذَا النَّادِي فَايْنَ خَلِيلُ",66,"ل",1,0],["وَقَد وَثِقَت نَفسي بِأَنّي عِندَهُ","سَأَزدادُ عِزّاً ما بَقيتُ وَأُفلِحُ",67,"ح",1,0],["وَقَد وَضَعَتهُ وَاِحتَمَلَتهُ كرهاً","وَفي أَحشائِها أَربى اِرتِكاضا",68,"ض",2,0],["وقد وقف الطبُّ الحديثُ حِيالَها","عَيِيّاً يكادُ العجزُ يقتُله غمّا",69,"م",2,0],["وقدودُ الهِيفِ في رَوْضاتِه","قُضُبٌ تمْرَحُ بين القُضُب",70,"ب",1,0],["وقد ولفت أجزاؤه فتحكمت","على نسبة ترضي بواسطة الربق",71,"ق",1,0],["وقد وطَّد اللهُ لكَ الوطائدا","فلا يَجِدكَ اللهُ إلا شائدا",72,"د",2,0],["وقد وقفوا للحائناتِ وشمَّروا","لهن إلى الأنصَاف ساقاً وأذرعا",73,"ع",2,0]]}