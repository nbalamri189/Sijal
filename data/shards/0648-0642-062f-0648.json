طَ الشَيبُ في لِمَّتي","بِشَيءٍ مِنَ الشَعرِ الأَشهَبِ",91,"ب",1,0],["وقد وقفَ الدُّجى فزعاً يصلي","وظلمةُ ذنبهِ ملءُ الوجودِ",92,"د",1,0],["وقد وهى جسمي وقل القوى","وكنت من قبل قويّ الجنان",93,"ن",1,0],["وقد وهبتك روحي لا اسر بها","فان قبلت تكن من اعظم المنن",94,"ن",1,0],["وَقَدْ وَقَفْتُ بجِسْمٍ في عِراصِهم","كآخرِ القَيْدِ في ساعاتِ بينهم",95,"م",1,0],["وقد وُلِّيت أسيافُه مُحْكَمَ القَضَا","وتقضي على تَلْفِ العدا ضَبَواتُها",96,"ت",3,0],["وقد وافاه تاريخ هناء","تدوم لك المكارم والسعاده",97,"د",2,0],["وقد ولَغتْ في الصُّدورِ الرِّماحُ","وصَلّتْ لبِيض السيوف الطُّلى",98,"ا",1,0],["وَقُدودِ السَروِ في","خَصرِ مُلاءٍ وَرِياطِ",99,"ط",1,0],["وَقَد وَكَّلتُهُ وَشَرَطتُ أَن لا","يُفارِقَ ساعَةً لِلحُكمِ بابا",100,"ب",2,0],["وَقَدْ وَرَدْنَا بِمَا أَمْلَى عَلَيْهِ لَنَا","بَحْراً أُمِدَّ بِأَبْحُرٍ لَهَا حُبُكُ",101,"ك",1,0],["وقد وقفت نجدٌ لطوسون وقفة","وكادت عليه الدائرات تدولب",102,"ب",1,0],["وقد وقف الإسلام أحرج موقف","وكل عدو ضده متألب",102,"ب",1,0],["وقد وردت والوارداتُ تزفّها","بمجلَى تَجلِّي الحسنِ فوق منصّةِ",103,"ه",1,0],["وقد ودهن رشاقة في","الطعن كالسمر الرشاق",104,"ق",1,0],["وقد وَهبت عينيَّ بعضَ جمالِها","وكانت إلى كلِّ الحسانِ شَفيعتي",105,"ي",1,0],["وَقَد وصلت إِلى هذا الجناب وَلي","فيك الظنونومن وافى حماك حمى",106,"م",2,0],["وقَدْ وافَيْتُها عَبْدَاً صُراحاً","فَكَيْفَ أعيبُ مِلْكِي بالإباقِ",107,"ق",1,0],["وَقَدْ وَسَمَتْنِي الأَرْبَعُونَ بِمَرِّها","وَحالَتْ بِشَيْبِي لِلْشَّبِيبَةِ حالُ",108,"ل",1,0],["وَقُدودٍ مِثلِ الغُصونِ عَلى كُث","بِ النَقا عِندَ ضَمِّنا لِلعِناقِ",109,"ق",1,0],["وقد وجم الروض لا نبته","نضير ولا طيره شاديه",110,"ي",2,0],["وقد ولينا وعزلنا كما","أنت فلم نصغر ولم تعظم",111,"م",1,0],["وَقَدُومٌ يَسُنُّ شَهْراً ولا يقْ","طَعُ شِبْراً كَأَنَّهُ أفكارِي",112,"ي",1,0],["وَقَد وَرِث العُلا فَرضا وَرَدّا","أَمييرا عَن أَمير عَن أَمير",113,"ر",1,0],["وقد وقَفَ الأمرُ في وَقْفةٍ","فلا يَنْتقِضْ ما لديك انْبَرم",114,"م",1,0],["وقد وَتّد اللّيلُ النُّجومَ مُطنِّباً","جُفوني بأهدابي إليها وخَيّما",115,"م",2,0],["وقد وعَد الجميلَ الكَفُّ منه"