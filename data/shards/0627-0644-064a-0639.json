{"poems":[[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[0,"أرانا موضعين لأمر غيب","https://www.aldiwan.net/poem60.html","الوافر"],[93,"إلى الأديب العبقري","https://www.aldiwan.net/poem9842.html","السريع"],[54,"ما زال عصياننا لله يسلمنا","https://www.aldiwan.net/poem27397.html","البسيط"],[27,"عفا نهيا حمامة فالجواء","https://www.aldiwan.net/poem5656.html","الوافر"],[27,"أراح الحي من إرم الطراد","https://www.aldiwan.net/poem5709.html","الوافر"],[47,"إباء إباء البكر غير مذلل","https://www.aldiwan.net/poem25207.html","الطويل"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[72,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[51,"تظلّم شِعري إلى القاسمِ","https://www.aldiwan.net/poem66302.html","المتقارب"],[70,"إلى عدلكم أنهي حديثي وأنتهي","https://www.aldiwan.net/poem43042.html","الطويل"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[28,"إليك سمت يا ابن الوليد ركابنا","https://www.aldiwan.net/poem5010.html","الطويل"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[66,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[22,"إذا قلت أني آيب أهل بلدة","https://www.aldiwan.net/poem22010.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54976","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[77,"أنورُ سناءَ لاحَ في مشْرِق الغرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33315",""],[22,"إذا قُلْتُ أَنِّي آيبٌ أَهْلَ بَلْدَة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19751",""],[50,"ما ردَّ سلوتهُ إلى إطربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=17920",""],[94,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[27,"عفا نهيا حمامة َ فالجواءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16338&r=&rc=2",""],[115,"لشماء بعد شتات النوى","https://www.aldiwan.net/poem20958.html","المتقارب"],[129,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[132,"فإن يك رأسي كالثغامة نسله","https://www.aldiwan.net/poem24160.html","الطويل"],[161,"تدارك من زمانك ما افدتا","https://www.aldiwan.net/poem59135.html","الوافر"],[179,"إلى عمان","https://www.aldiwan.net/poem50694.html","الوافر"],[187,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[213,"أهل خبر فيه النجيد لنا يروى","https://www.aldiwan.net/poem37825.html","الطويل"],[236,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[271,"أمن قفص الى شرك وفخ","https://www.aldiwan.net/poem35026.html","الوافر"],[276,"رويد الليالي كم تصر على الغدر","https://www.aldiwan.net/poem25559.html","الطويل"],[279,"سرى موهناً طيف الخيال المؤرق","https://www.aldiwan.net/poem2481.html","الطويل"],[281,"إذا عز نفسي عن هواك قصورها","https://www.aldiwan.net/poem60737.html","الطويل"],[299,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[301,"ألم ترم الأطلال من حول جعشم","https://www.aldiwan.net/poem45455.html","الطويل"],[305,"يا سعد قلبي حزين","https://www.aldiwan.net/poem16802.html","المجتث"],[306,"إليك ومنك الحمد ربي مدى الدهر","https://www.aldiwan.net/poem56532.html","الطويل"],[350,"لما دعاني الهوى من ربة الكلل","https://www.aldiwan.net/poem15862.html","البسيط"],[365,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[387,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[417,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[417,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[417,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[430,"إلى علياك تبتسم المعالي","https://www.aldiwan.net/poem39834.html","الوافر"],[430,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[462,"ومن آل المظفر عبقري","https://www.aldiwan.net/poem16032.html","الوافر"],[462,"أقول لمنطيق من الحي أفوه","https://www.aldiwan.net/poem16098.html","الطويل"],[501,"من بات ملتحفا في ذيل منقبتي","https://www.aldiwan.net/poem38000.html","البسيط"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[563,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[565,"أحبابنا لو تعلمون بحالنا","https://www.aldiwan.net/poem895.html",""],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِلى عَضُدِ الدّينِ الذي ساغَ مَشْرَبي","بهِ بعدَما أشْجى الزّمانُ وأجْرَضا",0,"ض",2,0],["إلى عُمَرَ بن عبْدِ اللهِ حنّتْ","رِكابِي فهْيَ تسْتَبِقُ اسْتِباقا",1,"ق",2,0],["إِلَى عَمْرو هِنْدٍ حَيْثُ يَخْتَصِمُ الْعُلى","وَيُشْهَدُ نَصْلُ السَّيْفِ فِي حَوْمَةِ الْحَرْبِ",2,"ب",1,0],["إِلى عِرقِ الثَرى وَشَجَت عُروقي","وَهَذا المَوتُ يَسلِبُني شَبابي",3,"ب",2,0],["إلى على عهدي وما كنت في","مهمة مخلف ميعادي",4,"د",2,0],["إِلى عُلَيجَينِ لَم تُقطَع ثِمارُهُما","قَد طالَما سَجَدا لِلشَمسِ وَالنارِ",5,"ر",1,0],["إِلى عَبدِ العَزيزِ سَمَت عُيونُ ال","رَعِيَّةِ إِن تُخُيِّرَتِ الرِعاءُ",6,"ا",2,0],["إِلى عَبدِ العَزيزِ شَكَوتُ جَهداً","مِنَ البَيضاءِ أَو زَمَنِ القَتادِ",7,"د",1,0],["إِلى عَرَبٍ لاتَختَشي غَلبَ غالِبٍ","ذُؤابَةِ حَيِّ عامِرٍ وَالمُحَجَّلِ",8,"ل",1,0],["إلى عدلهِ يشكو الزمان فإنه","خديمٌ يغادِي أمرهُ ويراوح",9,"ح",1,0],["إلى عليّ الاسم والفعل وال","ألفاظ والرتبة والحيم",10,"م",1,0],["إلى عدلكَ المُشْتَكَى كُلُّهُ","فحَسْبي بعدْلِكَ من حاكمِ",11,"م",1,0],["إِلى عَدلِكُم أُنهي حَديثي وَأَنتَهي","فَجودوا بِإِقبالٍ عَلَيَّ وَإِصغاءِ",12,"ا",2,1],["إِلى عَرَفاتِ اللَهِ يا خَيرَ زائِرٍ","عَلَيكَ سَلامُ اللَهِ في عَرَفاتِ",13,"ت",1,1],["إِلى عُقدَةِ الجَوفِ حَتّى شَفَت","بِماءِ الجُراوِيِّ بَعضَ الصَدى",14,"ا",1,0],["إِلى عَلِيِّ بَني الفَيّاضِ بَلَّغَني","سُرايَ مِن حَيثُ لا يُسرى وَإِدلاجي",15,"ج",2,0],["إِلى عُمَرٍ أَقبَلنَ مُعتَمِداتِهِ","سَراعاً وَنِعمَ الرَكبُ وَالمُتَعَمَّدُ",16,"د",1,0],["إِلى عَينَيهِ تَنتَسِبُ المَنايا","كَما اِنتَسَبَ الرِماحُ إِلى رُدَينِ",17,"ن",1,0],["آلى عَلى غِمدِهِ أَلّا يُراجِعَهُ","إِلّا إِذا عادَ مُحمَرّاً مِنَ العَلَقِ",18,"ق",1,0],["إِلى عَجُزٍ كَالبابِ شُدَّ رِتاجُهُ","وَمُستَتلِعٍ بِالكورِ ذي حُبُكٍ سُمرِ",19,"ر",1,0],["إِلى عِدَى اللّهِ منَ الجلالِقِ","وعابدِي المَخلوقِ دونَ الخالقِ",20,"ق",1,0],["إِلى عَيْنِ شَمْسٍ قدْ لَجَأْتُ وَحَاجَتِي","طَلاَقَةُ جَوٍّ لَمْ يُدَنَّسْ بِأَرْجَاسِ",21,"س",1,0],["إِلى عَلِيٍّ سيْفِها فِي الوَغَى","وَصَوتِهَا المَسْمُوعِ فِي المِنْبَرِ",22,"ر",1,0],["إلى عمرِ هندٍ حيثُ يخْتَصِمُ العلا","ويَشْهَدُ نَصْلُ السَّيفِ في حَومَة الحرب",23,"ب",1,0],["إلى عجزٍ بالباب شدَّ رتاجهُ","ومستتلعٍ في الكور في حبكٍ سمرِ",24,"ر",1,0],["إلى \" عبيدة \" شوقه ونزاعه","إِنَّ الْمُحبَّ مُعذَّبٌ بِحِبَابِه",25,"ب",2,0],["اليعربيّون لا حقد ولا غضب","قد يسلب الحقّ بين الحقد والغضب",26,"ب",1,0],["إلى عبد العزيز سمتْ عيونُ","رّعِيّة ِ، إنْ تُخُيّرَتِ الرِّعاءُ",27,"ا",2,0],["إِلى عَمَرَينِ إِلى غَيقَةٍ","فَيَليَلَ يَهدي رَبَحلاً رَجوفا",28,"ف",2,0],["اليعربيِّ الشمرى المرتضَى","وذِى الدِّينِ والإيمانِ والإسلامِ",29,"م",1,0],["إِلى عَلَمٍ ناءٍ كَأَنَّ مَسافَهُ","مُخَلَّلُ كِتّانٍ مِنَ النَأيِ وَالبُعدِ",30,"د",1,0],["إلى علم تطيع الله فيه","على ثقة وتعرف ما جهلتا",31,"ت",2,0],["إلى عمانَ نَاداني إيابي","ورَكْبُ الشوق يَمْشي في رِكابي",32,"ب",2,1],["إلى علم التواريخ اقتدارا","بحسبان يهون به السديد",33,"د",1,0],["إلى عَلَمِ الدُّنيا وغَيْثِ بِقَاعِها","سعيد الذي من كَفِّهِ عُرِفَ الجَدْوَى",34,"و",2,0],["إِلى عَضُدِ الدينِ الوَزيرِ سَمَت بِنا","رَكائِبُ آمالٍ طَواها السُرى نُجبُ",35,"ب",1,0],["إلى عربيةٍ ظَعَنَت حنيني","وبينَ رصافةٍ قلبي وكرخ",36,"خ",1,0],["إلى عرْضَة الأمواتِ في عرْصة الحَشرِ","آخر الدَّهْرِ",37,"ر",1,0],["إلى عَلَم من دار سُعْدَى فشاقني","ومن يَرَ آثارَ الأحبّة يَشْتَقِ",38,"ق",1,0],["إِلى عَضُدِ الْمُلْكِ امْتطَيْتُ غَرائِباً","مُحَرَّمَةٌ إِلاّ عَلّي ظُهُورُها",39,"ر",3,0],["إلى علٍ وأَسفلٍ","ويمنةٍ وميسره",40,"ر",2,0],["إِلى عَيثَةِ الأَطهارِ غَيَّرَ رَسمَها","بَناتُ البِلى مَن يُخطِئِ المَوتَ يَهرَمِ",41,"م",1,0],["إلى عريب الحمى","النازلين الكثيب",42,"ب",1,0],["إِلى عابدِ الرحمنِ في فاس وهو عن","محمّدٍ جدَّ الأحمد الأوّل الذكرِ",43,"ر",1,0],["إِلى عَداها بِزَورِ القَولِ وَالخَطَلِ","قالوا بِأَرخَصِ قَولي في هَواهُ غَلا",44,"ل",2,0],["إلى عالِمٍ ما مِنْ بليغٍ مُبادِرٍ","يُباريهِ فَضْلاً أو فقيةٍ مُباكت",45,"ت",1,0],["إِلى عَمرٍو وَمِن عَمرٍو أَتَتني","أَخى النَجداتِ وَالحِلمِ الرَصينِ",46,"ن",1,0],["إلى عليٍّ عليِّ القدر مرجعها","نقيبُ أَشرافٍ غرّ السَّادة النُّجبا",47,"ب",2,0],["إلى عَلَمٍ من الأَعلام فردٍ","تفيض علومه فيض البحور",48,"ر",1,0],["إلى عهد أيام عبد العزيز","مجدّد أحكام إتقانها",49,"ن",3,0],["إلى علياك تبتسم المعالي","وتجلو بالتهاني خير طلعه",50,"ع",2,1],["إلى علياك وافت بنت فكر","لتصدح في الثنا الوافي العطيرِ",51,"ر",1,0],["إلى عميد الرؤساءِ انبرتْ","تُلاحِكُ الغارِبَ بالمِنسَمِ",52,"م",1,0],["إلى عميد الرؤساء انبرتْ","تحتَ بني الحاجِ بناتُ العزيمْ",53,"م",1,0],["إلى عميد الدولة اشتطَّت بنا","موائرٌ لا تُقتفَى آثارُها",54,"ر",3,0],["إلى عميد الدولة استرجع ال","نافرُ أنساً وأَوَى الهاربُ",55,"ب",1,0],["إِلى عَضُدٍ لدين اللهِ يَحْمي","مُعاقدَه من الشَّرِّ المُتاحِ",56,"ح",1,0],["إلى عضد الدين الجوادِ ابن عِزِّهِ","نجارٌ كشمس الصُّبح حين تجلَّتِ",57,"ت",1,0],["إلى عليٍّ نَمَتْنا عُصبَةٌ طَهُرَتْ","وكلُّ آبائِنا في طِينِهِمْ طَهُروا",58,"ر",3,0],["إلى عقَباتِها العِقبانُ تأوي","وتمدَحُ في ضراغِمِها السّعالي",59,"ل",2,0],["إلى عملِ الإحسانِ أسبَقُ أهلِهِ","وفي خدمِةِ السُّلطانِ أمضى رِجالهِ",60,"ل",2,0],["إلى عدلكم نشكوا بنا ما فعلتموا","فقد وحياة الحب خنتم وما خنا",61,"ن",2,0],["إلى علي بعده جميعا","قد جمعوا الشريف والوضيعا",62,"ع",2,0]]}