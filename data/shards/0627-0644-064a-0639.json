َذا المَوتُ يَسلِبُني شَبابي",3,"ب",2,0],["إلى على عهدي وما كنت في","مهمة مخلف ميعادي",4,"د",2,0],["إِلى عُلَيجَينِ لَم تُقطَع ثِمارُهُما","قَد طالَما سَجَدا لِلشَمسِ وَالنارِ",5,"ر",1,0],["إِلى عَبدِ العَزيزِ سَمَت عُيونُ ال","رَعِيَّةِ إِن تُخُيِّرَتِ الرِعاءُ",6,"ا",2,0],["إِلى عَبدِ العَزيزِ شَكَوتُ جَهداً","مِنَ البَيضاءِ أَو زَمَنِ القَتادِ",7,"د",1,0],["إِلى عَرَبٍ لاتَختَشي غَلبَ غالِبٍ","ذُؤابَةِ حَيِّ عامِرٍ وَالمُحَجَّلِ",8,"ل",1,0],["إلى عدلهِ يشكو الزمان فإنه","خديمٌ يغادِي أمرهُ ويراوح",9,"ح",1,0],["إلى عليّ الاسم والفعل وال","ألفاظ والرتبة والحيم",10,"م",1,0],["إلى عدلكَ المُشْتَكَى كُلُّهُ","فحَسْبي بعدْلِكَ من حاكمِ",11,"م",1,0],["إِلى عَدلِكُم أُنهي حَديثي وَأَنتَهي","فَجودوا بِإِقبالٍ عَلَيَّ وَإِصغاءِ",12,"ا",2,1],["إِلى عَرَفاتِ اللَهِ يا خَيرَ زائِرٍ","عَلَيكَ سَلامُ اللَهِ في عَرَفاتِ",13,"ت",1,1],["إِلى عُقدَةِ الجَوفِ حَتّى شَفَت","بِماءِ الجُراوِيِّ بَعضَ الصَدى",14,"ا",1,0],["إِلى عَلِيِّ بَني الفَيّاضِ بَلَّغَني","سُرايَ مِن حَيثُ لا يُسرى وَإِدلاجي",15,"ج",2,0],["إِلى عُمَرٍ أَقبَلنَ مُعتَمِداتِهِ","سَراعاً وَنِعمَ الرَكبُ وَالمُتَعَمَّدُ",16,"د",1,0],["إِلى عَينَيهِ تَنتَسِبُ المَنايا","كَما اِنتَسَبَ الرِماحُ إِلى رُدَينِ",17,"ن",1,0],["آلى عَلى غِمدِهِ أَلّا يُراجِعَهُ","إِلّا إِذا عادَ مُحمَرّاً مِنَ العَلَقِ",18,"ق",1,0],["إِلى عَجُزٍ كَالبابِ شُدَّ رِتاجُهُ","وَمُستَتلِعٍ بِالكورِ ذي حُبُكٍ سُمرِ",19,"ر",1,0],["إِلى عِدَى اللّهِ منَ الجلالِقِ","وعابدِي المَخلوقِ دونَ الخالقِ",20,"ق",1,0],["إِلى عَيْنِ شَمْسٍ قدْ لَجَأْتُ وَحَاجَتِي","طَلاَقَةُ جَوٍّ لَمْ يُدَنَّسْ بِأَرْجَاسِ",21,"س",1,0],["إِلى عَلِيٍّ سيْفِها فِي الوَغَى","وَصَوتِهَا المَسْمُوعِ فِي المِنْبَرِ",22,"ر",1,0],["إلى عمرِ هندٍ حيثُ يخْتَصِمُ العلا","ويَشْهَدُ نَصْلُ السَّيفِ في حَومَة الحرب",23,"ب",1,0],["إلى عجزٍ بالباب شدَّ رتاجهُ","ومستتلعٍ في الكور في حبكٍ سمرِ",24,"ر",1,0],["إلى \" عبيدة \" شوقه ونزاعه","إِنَّ الْمُحبَّ مُعذَّبٌ بِحِبَابِه",25,"ب",2,0],["اليعربيّون لا حقد ولا غضب","قد يسلب الحقّ بين الحقد والغضب",26,"ب",1,0],["إلى عبد العزيز سمتْ عيونُ","رّعِيّة 