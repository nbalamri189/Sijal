{"poems":[[55,"كل شيء من الزمان طريف","https://www.aldiwan.net/poem29965.html","الخفيف"],[74,"وبديع الجمال لم ير طرفي","https://www.aldiwan.net/poem18756.html","الخفيف"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[87,"إيدسن ماذا ترى في الكهرباء","https://www.aldiwan.net/poem7589.html","الرمل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[101,"في المقهى","https://www.aldiwan.net/poem6248.html","عموديه"],[68,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[99,"يا ربيعاً جمل الله به","https://www.aldiwan.net/poem24973.html","الرمل"],[107,"رددي أخبار عمرو وعمر","https://www.aldiwan.net/poem43077.html","الرمل"],[50,"دق معنى الخمر حتى","https://www.aldiwan.net/poem65285.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[108,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[92,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[146,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[168,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[226,"صدقت فيما حكت عنك الدموع","https://www.aldiwan.net/poem55268.html","الرمل"],[234,"أنتم في المنام حلمي وأنتم","https://www.aldiwan.net/poem51136.html","الخفيف"],[259,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[287,"كلما حادثني ابن الخيمي","https://www.aldiwan.net/poem32841.html","المتقارب"],[302,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[347,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[369,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[376,"كلما حث في نداماه رطلا","https://www.aldiwan.net/poem56963.html","البسيط"],[385,"ويح قلبي من طرفه الفتاك","https://www.aldiwan.net/poem48826.html","الخفيف"],[399,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[409,"كم أقاسي في الهوى من شغل","https://www.aldiwan.net/poem33482.html","الرمل"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[457,"رب أحوى أحور الجفن","https://www.aldiwan.net/poem13860.html","مجزوء الرمل"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[563,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[563,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145673","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70791","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70774","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75794","الرمل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75793","الرمل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124705","الرمل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102275","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45399","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108777","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49553","المتقارب"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96482","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52058","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110272","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28600","الرمل"],[2318,"","https://poetry.dctabudhabi.ae/diwan/poem/98131","المديد"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93583","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205783","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204506","الخفيف"],[3077,"","https://poetry.dctabudhabi.ae/diwan/poem/113641","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87580","الخفيف"],[3769,"","https://poetry.dctabudhabi.ae/diwan/poem/111112","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103048","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73316","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73419","الخفيف"],[4680,"طال ليلي والليالي تطولٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194238",""],[4767,"وردتي","https://www.poetsgate.com/ViewPoem.aspx?id=175104",""],[4767,"بحور القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179966",""],[4767,"شباك الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210275",""],[4775,"مغامرات عنتر","https://www.poetsgate.com/ViewPoem.aspx?id=175219",""],[4823,"طائر الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=188281",""],[4927,"ما هذه البنت","https://www.poetsgate.com/ViewPoem.aspx?id=29609",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[5135,"الهجرُ صِبْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=201960",""],[5277,"أقداحُ السدى","https://www.poetsgate.com/ViewPoem.aspx?id=191717",""],[5330,"أحببتك أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=15589",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5491,"يا نديمي","https://www.poetsgate.com/ViewPoem.aspx?id=215015",""],[5525,"بالي","https://www.poetsgate.com/ViewPoem.aspx?id=843",""],[5628,"الى الملاك نرجس","https://www.poetsgate.com/ViewPoem.aspx?id=178458",""],[5628,"وداعاً أيتها البسمة","https://www.poetsgate.com/ViewPoem.aspx?id=178491",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[5667,"آهِ من أرضِ دبي","https://www.poetsgate.com/ViewPoem.aspx?id=214804",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5829,"أزرق","https://www.poetsgate.com/ViewPoem.aspx?id=200760",""],[5883,"جند حماس","https://www.poetsgate.com/ViewPoem.aspx?id=23878",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5956,"زرعنا كزبرة لا تطلع","https://www.poetsgate.com/ViewPoem.aspx?id=183152",""],[6056,"الجبين المستدير","https://www.poetsgate.com/ViewPoem.aspx?id=130330",""],[6093,"هامَ قلبيْ فيهِ وجْدا","https://www.poetsgate.com/ViewPoem.aspx?id=176097",""],[6152,"عيناك وطن","https://www.poetsgate.com/ViewPoem.aspx?id=203050",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""]],"verses":[["كُلَّما حَزَّتِ النَوائِبُ فينا","أَطلَعَتنا عَلى الكُلومِ القُروفُ",0,"ف",1,0],["كلَّما حدتُ عن هواه أتاني","سهمُ ألحاظه كسهم النميري",1,"ي",1,0],["كلَّما حُمِّلَ أعباء العلا","ذلَّ في عزٍّ كما ذلَّ القَعودُ",2,"د",1,0],["كلما حطّ رحلَهُ بك ضيفٌ","باتت الليلَ رِجلُها لا تُحَطُّ",3,"ط",1,0],["كُلَّما حَدَّثَ أَصغَت وَإِذا قالَت تَرَنَّح","أَحَفيفُ المَوجِ سِرٌّ ضَيَّعاهُ لَستُ أَدري",4,"ي",1,0],["كلما حركه في خلقه","ذهب العقل وجنّ العقلاء",5,"ا",2,0],["كُلَّما حَثَّتِ الرِكابَ لِأَرضٍ","جاوَرَ الرُشدُ أَهلَها وَالذَكاءُ",6,"ا",2,0],["كُلَّما حُصِّلَت مَساعي قُرَيشٍ","طِبتَ فَرعاً في مُنتَماها وَأَصلا",7,"ل",2,0],["كلما حدقت فيها ضحكت","وتعرى الثلج في أسنانها",8,"ن",3,0],["كُلَّما حاوَلوا الهَوادَةَ مِنّا","شاهَدوا الحَيلَ مُشرِفاتِ الهَوادي",9,"د",2,0],["كلما حاولها أعجزه","قصر الطرف عن الصرح المنيف",10,"ف",1,0],["كُلَّما حاوَلتِ أَمراً جَلَلا","غامَرَت أَنفُسُنا في المُقتَحَمْ",11,"م",1,0],["كُلَّما حاوَلَها النا","ظِرُ مِن طَرفِ الجُفونِ",12,"ن",1,0],["كلُّ ما حولنا يشفُّ عن الحبّ","ويفضي بسرِّهِ المستورِ",13,"ر",1,0],["كلّما حلّقت بأُفْقِ مكانٍ","تركتْ فيه كلَّ شيءٍ حصيدا",14,"د",2,0],["كلما حاق بالعروبةِ خَطْبٌ","كان شطًّا تُلْقِي عليه الأمانا",15,"ن",2,0],["كلما حدِّثت عن نجم بدا","حدثتني النفس أن ذاك أنا",16,"ن",2,0],["كل ما حف بالحياة جميل","غير أن البقاء فيها قليل",17,"ل",1,0],["كلَّما حُقّق الشفاهُ لفنٍّ","من سَقام الأيام أحدثنَ فَنّا",18,"ن",2,0],["كُلُّ ما حُمَّ أَن يَكونَ قَريبٌ","وَالَّذي لا يُحَمُّ ناءٍ نَعيطُ",19,"ط",1,0],["كلما حاولت تدوين رثا","أذكر الموت فيعروني الخشوع",20,"ع",1,0],["كلَّما حثَّنِي اشتياقي إليكمْ","قلتُ لَبَّيْكَ أنتَ نعم المنادي",21,"د",2,0],["كلما حاولتُ قرباً","رام صَدِّي ثم صَرْفي",22,"ف",2,0],["كُلَّما حادَثَني اِبنُ الخيمي","قُلتُ هَذا حَدَثٌ لَيسَ حَديثا",23,"ث",2,1],["كُلَّما حنَّ إِلى السَفح هوىً","بلَّ ردنَيه من الأَجفان سَفحُ",24,"ح",1,0],["كلما حاولت اندبه","خانني دمعي فلم يعن",25,"ن",1,0],["كلّما حنَّ إلى ذاتِ الغَضا","أنشأَتْ أنفاسُه فيها اضْطِراما",26,"م",2,0],["كلّما حاذَروا طَوارقَ دهْرٍ","أَيقظُوهُ وباتُوا رُقودا",27,"د",2,0],["كلَّما حثَّ في نَداماهُ رَطلاً","قالَ مَن ودَّ رَطلنا نسقِيه",28,"ه",1,1],["كُلَما حَنَّ شَبَّ لي جَمر شَوق","لَيسَ يُطفيهِ دَمع طَرفي الباكي",29,"ك",2,0],["كلما حّقق الزمان لقلبي","حلما صورت حياتي سواه",30,"ه",1,0],["كلما حاولت أن يعذرني","إذ رماني بسهام العُذّل",31,"ل",1,0],["كلمّا حَوَّمَتْ أَدارَتْ جناحاً","عَدَّ في ريشهِ الصَّبا والشَّمالا",32,"ل",2,0],["كلَّما حَنَّ تَمادى","وإِذا أوْعَدَ أخلفْ",33,"ف",1,0],["كل ما حولهم وإن لجَّ بالمع","نىَ هراءٌ وكله بُهتان",34,"ن",1,0],["كلّما حنّتْ لأرضِ المُنحنى","وكَلاها أقرحَ السَّوْقُ كُلاها",35,"ا",3,0],["كل ما حاولوه أبعد عنهم","لا تلمهم أضلهم من هدانا",36,"ن",2,0],["كلما حاولوا بأن يطفئوني","حرقوا بي فكان أمري فاشي",37,"ش",2,0],["كلما حيا بكاس قلت زد","فإذا عاودني قلت أعد",38,"د",1,0],["كلما حرَّك الرياحُ غصونا","واستهلّتْ عينُ الصبير رِهاما",39,"م",2,0],["كلما حال بيننا البعدُ واجتا","ح مرورَ الشهور والأعوام",40,"م",1,0],["كلما حدث أَبدى أَنجما","راجماً سلوان ذاك البلج",41,"ج",1,0],["كلما حملتُ أَشجاني الصبا","أَثقلت أَعطافه من أَلَمي",42,"ي",1,0],["كلما حدّث عنّي معشر","أقسمت أنّي لم أخطر ببال",43,"ل",1,0],["كلما حلها أرتنا كيف مس","رى السرور في الأرواح",44,"ح",1,0],["كلَّما حلّت لمرآه الحُبا","رفعت نعلَيه فوقَ الحُدقِ",45,"ق",1,0],["كُلَّما حَكَّموا اللُهى بِالنَدى في ال","مالِ نادى ما لي وَلِلتَحكيمِ",46,"م",1,0],["كلما حرَّك البنانَ لخيرٍ","قدر اللَه أن نثاب ونرزق",47,"ق",1,0],["كلما حدث عني نفسه","حل أثناء حباه وعقد",48,"د",1,0],["كلما حَلّ بلدة أو أتاها","تركت خيله بها أخدودا",49,"د",2,0],["كُلَّمَا حَاوَلْتُ طَوراً","قَادَهُ أيْمَنُ طَيرْ",50,"ر",1,0],["كُلَّما حاوَلُوا انحِطاطَ مَبانِي","كَ بَناها لَكَ الإِلهُ وَأَعلى",51,"ل",2,0],["كلما حانتِ الصلاةُ توافيها","وتخلو لِلّه في نجواها",52,"ا",3,0],["كُلَّما حارَبَنا ضَوء الضُّحى","حالَفَ الصُّبحُ عَلَينا وَابتَسَم",53,"م",1,0],["كلّ ما حيٍّ وإِن أُمِروا","وَاردوا الحوض الّذي وَرَدوا",54,"د",3,0],["كُلَّما حاوَلت قُرباً","مِنهُ أَولاني بعادا",55,"د",2,0],["كلما حل وافد من ربى لب","نان حملته من الشوق ما بي",56,"ب",2,0],["كلما حاولت من الماء قرباً","أبعدوها فحدّقت فيه حسرى",57,"ر",2,0],["كلَّما حدَّثت قلبي سلوةٌ","عن هواهم قال لي لا يمكنُ",58,"ن",1,1],["كلّما حنّت ورنّت","هيّجت منّي شُجون",59,"ن",1,0],["كلَّما حنَّ منيَ القَلبُ قال ال","عقلُ مهلاً فانتَ لستَ بصاحب",60,"ب",1,0],["كلما حاولت تخفيف الأسى","زادني من لوعة الشوق جفاها",61,"ا",3,0],["كلما حاولت منى راحتيه","غصن أكرومة دنا فتدلى",62,"ل",2,0],["كلما حاولت مقامك قوم","كان حجراً عليهم محجورا",63,"ر",2,0],["كُلَّما حاوَلَت لَهُنَّ رُجوعا","دَفَعتَها اللَجّاتُ مِنها إِلَيها",64,"ه",2,0],["كلما حط عن الثغر الخمار",