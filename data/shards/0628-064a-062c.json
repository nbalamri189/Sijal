{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[190,"دهر رمتني بريبه ريبه","https://www.aldiwan.net/poem44177.html","المنسرح"],[412,"جسمي نحيل بالحب والحب","https://www.aldiwan.net/poem50202.html","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106767","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91321","الكامل"],[4802,"سلامة قلبك الأصفى","https://www.poetsgate.com/ViewPoem.aspx?id=32674",""],[4924,"الكرامة","https://www.poetsgate.com/ViewPoem.aspx?id=34876",""],[4929,"ازهر الرأس","https://www.poetsgate.com/ViewPoem.aspx?id=199507",""],[5158,"للحلم للشعر وأشياء أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=59128",""],[5277,"نصيفةُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=191050",""],[5598,"وشم على قافية الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=214173",""],[6259,"جسمي نحيل بالحُبّ والحبِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59412&r=&rc=60",""]],"verses":[["بيَ جُرْحٌ مضى عليه زمانٌ","حِرْتُ في أمرِه وأمرِ أُساته",0,"ت",2,0],["بي جرب وهو يشتكي جربا","شعلي حكاكي وشعله جربه",1,"ب",2,0],["بي جَرَبٌ واقِعٌ مَضاريهِ","أَمضى مِنَ المُرهِفاتِ في النَقبِ",2,"ب",1,0],["بي جويّ للحسين","يولم قلبي ويقرح",3,"ح",1,0],["بِي جُؤذُرٌ قَد بَرَى فُؤَادي","حَتَّى غَدَا بالهوى جُذُاذَا",4,"ذ",2,1],["بي جركسيٌّ مِن فُنون لحاظِه","أَضحى يغار لَهُ الغَزالُ الأَفتَخُ",5,"خ",1,1],["بي جن ابن كلب لايكشف ولايخفى","واليني أوّل جهلته وانت الاولى لي",6,"ل",2,0],["بيجيك يوم تعتذر لي بأسف","وبقولك خل الزعل ينفعك روح",7,"ح",1,0],["بي جنونٌ يفوقُ ضعفَ جنون ال","العاشقينا..، فهل لوصلٍ دروبُ؟",8,"ب",1,0],["بي جرح .. لامنه براني . براني !","يحطب أمل صبري .. من اقصاه لاقصاه",9,"ا",2,0],["بي جرحُ عمرٍ وما من بلسمٍ ويدٍ","تربّتُ الآهَ حين الآهُ تضنيني",10,"ن",2,1],["\"بيجو\" يُبيح الدُنى في ليلنا حقدا","و\"شالُ\" ضامٍ إلى الدماء كم لَعِقَا",11,"ق",2,0],["بي جربٌ واقعٌ مضاربهُ","أمضى من المرهفات في الضرب",12,"ب",1,0]]}