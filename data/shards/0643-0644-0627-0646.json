,"https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[5956,"الأنثى طهورة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181856",""],[5956,"كلانا في الوداد له شعور","https://www.poetsgate.com/ViewPoem.aspx?id=181882",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"إذا لم يزُرْني","https://www.poetsgate.com/ViewPoem.aspx?id=182018",""],[5956,"بهدْي العقل","https://www.poetsgate.com/ViewPoem.aspx?id=184521",""],[5956,"انقلاب","https://www.poetsgate.com/ViewPoem.aspx?id=192329",""],[5956,"كلما الطيف يلوح","https://www.poetsgate.com/ViewPoem.aspx?id=192770",""],[5956,"إشعاع الإنسانية في الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=204680",""],[5957,"إن بعد العسر يسرا","https://www.poetsgate.com/ViewPoem.aspx?id=180664",""],[5977,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=213250",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6102,"ميرا","https://www.poetsgate.com/ViewPoem.aspx?id=185071",""],[6120,"مَتَى لِلبَعْضِ نَعْتَرِفُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=215668",""],[6142,"أنائحة مثلي على العرصة القفرا","https://www.poetsgate.com/ViewPoem.aspx?id=155746",""],[6201,"بقايا سهر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87484&r=&rc=8",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[463,"لمن صاغياتٌ في الحبلِ طلائحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60011&r=&rc=67",""],[6302,"اشْتِبَاهْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86226&r=&rc=24",""],[6341,"ابنة النخل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87280&r=&rc=9",""],[5190,"صراعات نفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78307&r=&rc=20",""],[5190,"المفترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78333&r=&rc=46",""]],"verses":[["كِلانا لَهُ السَبقُ المُبِرُّ إِلى العُلى","وَإِن كانَ في نَيلِ العَلاءِ إِمامي",0,"م",2,0],["كِلانا تَضرِبُ الأَيّامُ فيهِ","بِجُرحٍ مِن نَوائِبِها رَغيبِ",1,"ب",1,0],["كِلا ناظِرَيْهِ نَحْوَهُ مُتَشاوِسٌ","يُعاتِبُ لَحْظاً رَدَّهُ الرُّعْبُ وانِيا",2,"ي",2,0],["كُلُّ أُنثى سِواكِ عِندي شِمالٌ","غَيرُ مُحبوبَةٍ وَأَنتِ يَمينُ",3,"ن",1,0],["كِلانا مُحِبٌّ وَلَكِنَّنا","نُدافِعُ عَن حُبِّنا بِالصُدودِ",4,"د",1,0],["كِلانا عَلى ما كانَ مِن ذاكَ مُكرَهٌ","يُحاوِلُ أَمراً لَم يَجِد مِنهُ مَخرَجا",5,"ج",2,0],["كِلانا مَشوقٌ أَنضَجَ الشَوقُ قَلبَهُ","يُعالِجُ جَمراً في الحَشا مُتَأَجِّجا",5,"ج",2,0],["كِلانا غَنيٌّ عَن أَخيهِ حَياتَهُ","وَنَحنُ إِذا مِتنا أَشَدُّ تَغانِيا",6,"ي",2,0],["كِلانا جاهِدٌ أَدنو وَينأى","كَذَلِكَ ما اِستَطَعتُ وَما اِستَطاعا",7,"ع",2,0],["كِلانا يُرائي أَنَّهُ غَيرُ ظالِمٍ","فَأَعزَبتُ حِلمي أَو هُوَ اليَومَ أَعزَبا",8,"ب",2,0],["كِلانا عَلَتهُ كُبرَةٌ فَكَأَنَّما","رَمَتهُ سِهامٌ في المَفَارِقِ نُصَّلُ",9,"ل",1,0],["كِلانا مَشوقٌ وَالسَبيلُ مُمَهَّدٌ","إِلى الوَصلِ لَولا ذَلِكَ المُتَغَشمِرُ",10,"ر",1,0],["كِلانا لَهُ عُذرٌ فَعُذري شَبيبَتي","وَعُذرُكَ أَنّي هِجتُ سَيفاً مُجَرَّدا",11,"د",2,0],["كِلانا مَريضانِ في بَلدَةٍ","وَكَيفَ يَعودُ مَريضٌ مَريضا",12,"ض",2,0],["كِلانا به عرٌ فَمَن يَرَنا يَقُلُ","عَلى حُسنِها جَرباء تُعدي وَأَجرَبُ",13,"ب",1,0],["كِلانَا فَاقِدٌ أُمَّا","وَمَفْطُورُ الحَشَى غَمَّا",14,"م",2,1],["كلانا جاريان على سهول","بأبناء العروبة آهلات",15,"ت",1,0],["كلانا في الأخاء لنا مواضٍ","ضّمِنّ لنا النجاح بكل آت",15,"ت",1,0],["كل أنواع ذلك العيش قد ذق","ت وما زال من جديد وبالِ",16,"ل",1,0],["كلانا طريحُ الجسم بالٍ فلو دَرَت","إذاً ندَبتني في الثرى من ندبتها",17,"ت",3,0],["كلانا فائض الأجفان مهما","بكى حنقاً بكيت عليه رحمه",18,"ه",1,0],["كلانا على الأيام باكٍ وإنما","أشدّ البلا بين الحشا كلّ كامن",19,"ن",1,0],["كِلا نُزُلَيْهِ صيفُهُ وشتاؤُهُ","خلافٌ لما أهواهُ غيرُ مُصاقبِ",20,"ب",1,0],["كِلانا اجتنى ما يشتهي من خليله","فأغصانُ ما نهواهُ مُنهَصِراتُ",21,"ت",1,0],["كلانا ادعى أن الفضيلة في الهوى","له وكلانا صادق ليس يُدفَع",22,"ع",1,0],["كلانا واجد في النا","س ممن حلَّه خلفا",23,"ف",2,1],["كِلانا مُسيءٌ في تَجَنّيهِ غالِطٌ","فَما حَسَنٌ مِنكَ الصُدودُ وَلا مِنّي",24,"ن",2,0],["كِلانا بَكى أَو كادَ يَبكي صَبابَةً","إِلى إِلفِهِ وَاِستَعجَلَت عَبرَةً قَبلي",25,"ل",2,0],["كلانا ملّم بالصواب بزعمه","ولكن صوت المبطلين هو العالي",26,"ل",2,0],["كلانا اذا خاض العجاجة مبسل","ولكنما ابسالهم غير ابسالي",26,"ل",2,0],["كلانا رشاد على زورق","كسير وموج عنيف شقِى",27,"ق",2,0],["كلانا غريب في المضاجع ليله","طويل وليل العالمين قصير",28,"ر",1,0],["كِلانا غُصُنٌ شَطْبُ","فَذَا بالٍ وذا رَطْبُ",29,"ب",1,1],["كِلانا بِها ذِئبٌ يُحَدِّثُ نَفسَهُ","بِصاحِبِهِ وَالجَدُّ يُتعِسُهُ الجَدُّ",30,"د",1,0],["كِلانا مُظهِرٌ لِلناسِ بُغضاً","وَكُلٌ عِندَ صاحِبِهِ مَكينُ",31,"ن",1,1],["كِلانا بِهِ عَرٌّ يَخافُ قِرافُهُ","عَلى الناسِ مَطلِيُّ المَساعِرِ أَخشَفُ",32,"ف",1,0],["كِلانا لَنا قَومٌ لَنا يُحلِبونَهُ","بِأَحسابِهِم حَتّى يَرى مَن يُخَلَّفُ",33,"ف",1,0],["كِلانا بَطينٌ جَنبُهُ ظاهِرُ الكُسى","وَفي الناسِ مَن يُمسي وَيُصبِحُ طاوِيا",34,"ي",2,0],["كِلانا عَلى ما عَوَّدَتهُ طِباعُهُ","مُقيمٌ وَكُلٌّ في الزِيادَةِ يَجهَدُ",35,"د",1,1],["كِلانا سَوادٌ في بَياضِ فَما الَّذي","تَمُنُّ بِهِ حَتّى تُشاهَدَهُم قَبلي",36,"ي",1,0],["كلانا عليل فلا تجزعي","ودمعك تسبقه أدمعي",37,"ع",2,1],["كِلاني إِنَّ راحاتي تَأَتَّت","لِقَلبي في البُكاءِ وَفي العَويلِ",38,"ل",1,0],["كِلانا أَرادَ الصَرمَ ما اِسطاعَ جاهِداً","فَأَعيا قَريباً مِنَ السَماحَةِ وَالصَرمِ",39,"م",1,0],["كُلُّ أُنثى وَإِن دَنَت لِوِصالٍ","أَو نَأَت فَهيَ لِلرَبابِ فِداءُ",40,"ا",2,0],["كِلانا عَلى ما يَسلِبُ النَفسَ حِلمَها","مِنَ الأَمرِ لا راضٍ وَلا هُو غاضِبُ",41,"ب",1,0],["كِلانا إِذا ما نالَ شَيئاً أَفاتَهُ","وَمَن يَحتَرِث حِرثي وَحَرثَكَ يُهزَلِ",42,"ل",1,0],["كِلانا طَوى كَشحاً عَنِ الحَيِّ بَعدَما","دَخَلنا عَلى كِلابِهِم كُلَّ مَدخَلِ",42,"ل",1,0],["كِلانا يُمَنّى في الخَلاءِ جَليسَهُ","صَفاءً وَوُدّاً ما بَقينا مُخَلَّدا",43,"د",2,0],["كِلانا طَوى البيدَ في ليلِهِ","فأضْعفُنا يَتَشَكّى الوَجى",44,"ا",1,0],["كِلانا واجِدٌ في النا","سِ مِمَّن مَلَّهُ نِدّا",45,"د",2,0],["كِلانا يَدَّعي في الخَمرِ عِلماً","فَدَعني لا أَقولُ وَلا تَقولُ",46,"ل",1,0],["كلانا واجد راضٍ","كلانا شاكر شاكي",47,"ي",1,0],["كل إنسانٍ عدوي","كان إنسان صديقي",48,"ي",1,0],["كلانا يريد الحق فيما يَقوله","وإني وإياه إلى غاية نجري",49,"ر",2,0],["كِلاني لِما بي عاذِليَّ كَفاني","طَويتُ زماني برهةً وطواني",50,"ن",2,1],["كلانا يا شقيقُ هوى الأغاني","قَلي عهدٌ عليك ولي ذمامُ",51,"م",1,0],["كِلاَنَا نَأَى عن أَهْلِهِ وعَشِيرِهِ","ليَلْقَاه فيها أَهْلُه وعَشَائِره",52,"ر",2,0],["كِلانَا بَطينٌ جَنْبُهُ، ظاهرُ الكِسَى ،","وَفي النّاسِ مَن يُمسِي وَيُصْبحُ عارِيَا",53,"ي",2,0],["كلانا يكابدُ مُرَّ الفراق","على كبدَينا ، ولَذْعَ النَّوى",54,"ا",1,0],["كلانا على ما كلف النفس من رضى","أضرّ به نأي الأحبّة والهجر",55,"ر",1,0],["كِلانَا لعهُ قَوْمٌ هُمُ يُحْلِبُونَهُ","بأحْسابِهمْ حَتى يَرَى منْ يُخَلَّفُ",56,"ف",1,0],["كلُّ أُنثى أُحِبُّ .. أوّلُ أُنثى..","ليس عندي في الحبّ .. حبٌّ أخيرُ",57,"ر",1,0],["كِلانا أَرَادَ الصَّرْمَ، ما کسْطَاعَ جَاهِداً،","فَأَعْيَا قَريباً مِ السَّمَاحَة ِ والصَّرْمِ",58,"م",1,0],["كلانا تخشبنا الأمنيات","وتعصرنا الذكريات العنيفه",59,"ف",2,0],["كُل آن نَراهُ فَصل رَبيع","في ذُراهُ وَمدَّة العُمر عُرسا",60,"س",2,0],["كِلانا رَدَّ صاحِبَهُ بِيَأسٍ","وَتَأنيبٍ وَوِجدانٍ بَعيدِ",61,"د",1,0],["كل آن بنا غرام ووجد","وهيام للسيد الرواس",62,"س",1,1],["كِلانا يَرى ثَوبَ الوِصالِ مُمَزَّقًا","بِكَفِّكِ خَرْقًا واسعًا لم يُرَقَّعِ",63,"ع",1,0],["كلانا إذاً يا خل ضامن لوعة","وكل على سر الفؤاد أمين",64,"ن",1,0],["كلانا محب ليس يدري حبيبه","هواه وكلٌّ يا سمير غبين",64,"ن",1,0],["كلانا له داء يداويه بالمنى","وهل تنفع الأمال وهي ظنون",64,"ن",1,0],["كلانا احتسى كأس الغرام بكرهه","وكل عراه من هواه جنون",64,"ن",1,0],["كلانا على بعد المسافة بيننا","تلاقي على ألحاظه القمران",65,"ن",1,0],["كِلانا يُسَوِّدُهُ قَومُهُ","عَلى ذَلِكَ النَسَبُ المُظلِمُ",66,"م",1,1],["كِلانا إِذا فَكَّرتَ فيهِ عَلى شَفا","وَقَد مَرَّ في التَعليلِ وَالمَطلِ ما كَفا",67,"ف",2,1],["كلانا به جرح ولكن جرحها","به الدم من لحظي وجرحي بلا دم",68,"م",1,0],["كُلانيَ أَكْلاً لم يَرَ النّاسُ مِثْلَهُ","ولا تَهْضِما جَنبيَّ وَازْدَرِداني",69,"ن",2,0],["كلانا غني عن أخيه فإن نمت","فدون التلاقي منكر ونكير",70,"ر",1,0],["كلانا يراها وهيهاتَ ما","تَوَجَّعَ بالثكلِ كالثاكلِ",71,"ل",1,0],["كلانا بهِ وجدٌ ولكنهُ الهوى","دلالٌ وهجرانٌ ويأس ومطمعُ",72,"ع",1,0],["كِلانا عَدُوٌّ لَو يَرى في عَدُوِّهِ","مَساغاً وَكُلٌّ في العِدا غَيرُ مُجمِلِ",73,"ل",1,0],["كلانا لهذا النوى جازع","فماذا إزاء النوى نفعل",74,"ل",1,0],["كِلانا شاعِرٌ بِالظُلمِ يَرثي","بِلاداً بِالمَظالِمِ تسترقُ",75,"ق",1,0],["كِلانا مِحبٌّ صدّع البين شَملَه","وكل مُحِبّ بالفِراقِ يضام",76,"م",1,0],["كلانا لأصلٍ واحدٍ ولمَنبتٍ","تفرّع غُصْنانَا وما اختلف النَّجْر",77,"ر",1,0],["كلانَا لأصلٍ واحد ولوالدٍ","إذا ما دعانا الانتسابُ نصير",78,"ر",1,0],["كلانا وإن طال التفرُّق بيننا","لصاحبه وافٍ مقيمٌ على العهد",79,"د",1,0],["كِلانا يُنادي يا نِزارُ وَبَينَنا","قَناً مِن قَنا الخَطِيِّ أَو مِن قَنا الهِندِ",80,"د",1,0],["كُلّاً نُهَنّيهِ بِمَقدَمِهِ","وَبِكَ الهَناءُ لِمَقدَمِ الشَهرِ",81,"ر",1,0],["كِلانا تراءَى في محيّاكِ وجهُهُ","ومرآتُها عيني التي تأخذُ المعنى",82,"ن",2,0],["كِلانا شاقهُ وَطنٌ وأهلٌ","لعمركِ ما هوايَ سِوى هواك",83,"ك",1,0],["كِلانا محبٌّ والهوى فيكِ واحدٌ","ولكنَّهُ يخفي الغرامَ وأنطُق",84,"ق",1,0],["كلانا يَحنُّ إلى أرضِه","وعيشٍ مضى بين عذبٍ ورَطبِ",85,"ب",1,0],["كلانا له نورٌ وحوليهِ ظُلمةٌ","فَنَحنُ على بُعدِ المزارِ رَفيقان",86,"ن",1,0],["كِلاَنَا عَلَى أقْصَى الهَوَادَةِ والهَوَى","فَلا عَذَلٌ يُقْصِي ولا غَزَلٌ يُفْصِي",87,"ص",2,0],["كِلانا قريحٌ بِالفِراقِ فُؤادُهُ","فَلي وَلَها إِلفٌ نَأى وَهَديلُ",88,"ل",1,0],["كلانا منجز في القصد وعداً","ولكن الفتى فلك يدار",89,"ر",1,0],["كلُّ اِنتظامٍ آيلٌ لاِنصرام","ما هذهِ الدنيا بدارِ المُقام",90,"م",1,1],["كِلانا ذو اِعتزازٍ بِاِنتسابٍ","إِليكَ رفيعُ همٍّ ذو تليدِ",91,"د",1,0],["كلانا برته ليالي الهموم","وضيع في زحمة الموكب",92,"ب",1,0],["كِلانا في الرِياض حَليف شَجوٍ","وَأَشجانٍ وَشَوق وَاِشتِياقِ",93,"ق",1,0],["كِلانَا في حَشِيَّتِهِ عَليلٌ","فما يُغنِي العَلِيلُ عَنِ العَلِيلِ",94,"ل",1,0],["كِلانا لَهُ سُكرٌ وَصَحوٌ بِسُكرِهِ","فَلَيسَ لَهُ لُبٌّ وَلَيسَ لَنا لُبُّ",95,"ب"