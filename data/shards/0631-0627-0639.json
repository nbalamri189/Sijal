ومك","https://www.poetsgate.com/ViewPoem.aspx?id=177929",""],[5732,"الجادل اللي","https://www.poetsgate.com/ViewPoem.aspx?id=177913",""],[5732,"اللي سباني بالهوى فارع الطول","https://www.poetsgate.com/ViewPoem.aspx?id=177944",""],[402,"حييت يا ذات المقام السامي","https://www.poetsgate.com/ViewPoem.aspx?id=36330",""],[5821,"يوم السبت - مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=114115",""],[5848,"محمد بن زايد","https://www.poetsgate.com/ViewPoem.aspx?id=48970",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5956,"راعي المواهب","https://www.poetsgate.com/ViewPoem.aspx?id=193927",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""],[6008,"ترحيبيه بالإمير فهد بن بدر آل سعود","https://www.poetsgate.com/ViewPoem.aspx?id=60995",""],[6019,"فراشة في الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=53049",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6056,"الصافنات المساريج","https://www.poetsgate.com/ViewPoem.aspx?id=130506",""],[6056,"غارس الورد","https://www.poetsgate.com/ViewPoem.aspx?id=130527",""],[6056,"نار الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=156700",""],[6056,"الأصل غلاّب","https://www.poetsgate.com/ViewPoem.aspx?id=156709",""],[6115,"اذا كان مايعجبك قول الحقيقه","https://www.poetsgate.com/ViewPoem.aspx?id=180488",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[6143,"حسبنا أن نتفق","https://www.poetsgate.com/ViewPoem.aspx?id=34953",""]],"verses":[["راعَت حَصى نَجدٍ بِأَخفافِها","بَعدَ اِلتِزامي بِثَرى بابِلِ",0,"ل",1,0],["راعَنا الدّهْرُ بالخُطوبِ فجِئْنا","نَرْتَجي منْ عُلاكَ حُسْنَ الصّنيعِ",1,"ع",1,0],["راعُوا فُؤادي بالصُّدودِ وما رَعَوْا","عَهْداً لهُمْ حافَظْتُهُ ورَعَيْتُهُ",2,"ت",2,0],["راعَني فَقدُ شَبابي وَأَنا","لا أُراعُ اليَومَ مِن فَقدِ مَشيبي",3,"ب",2,0],["راعَهُ أَن يَرى عَلى جانِبَيهِ","رَصَداً مِن مَكايِدِ الإِنسانِ",4,"ن",1,0],["راعَيتَهُم حَتّى عَلِمتَ بِأَنَّهُم","بَلَغوا أَشُدَّهُمُ عَلى الأَزمانِ",5,"ن",1,0],["راع نفسي هذا المقام","بما استعصى عليها وقد يروع المقام",6,"م",1,0],["رَاعَنِي صِدْقُهُ فَخُيِّلَ لِي","أَنَّ عَيْنَ العَزِيزِ تَرْعَانَا",7,"ن",2,0],["رَاعَنَا خَطْبُهُمْ وَكَانَ جَسِيماً","مَسْبَحَ الحُوتِ هَلْ شَبِعْتَ رَمِيمَا",8,"م",2,1],["رَاعَ الْعُقُولَ بِآيَتَيْنِ تَرَاءتَا","فِي أُفْقِهِ المُتَهَلِّلِ البَسَّامِ",9,"م",1,0],["راعي نجوم الأفق في الليل ما دَجا","وأقرب من عينيَّ للنوم أَنجُمُ",10,"م",1,0],["راعيتَ فيها سنَةً نبوِيّةً","تَروي الثّقاتُ حديثه المشهورا",11,"ر",2,0],["رَاعِيَاً كانَ مُسجِحَاً فَفَقَدنَا","هُ وَفَقدُ المُسِيمِ هُلكُ السَّوَامش",12,"م",2,0],["راعَ الفِراقُ فُؤاداً كُنتَ تُؤنِسُهُ","وَذَرَّ بَينَ الجُفونِ الدَمعَ وَالسَهَدا",13,"د",2,0],["راعٍ ومرعىً فلا رعيَّتُهُ","يُلقى لها مُشتكٍ ولا عُشُبُهْ",14,"ب",2,0],["راعيتَ حقي بذي عينٍ مُقَوَّتةٍ","أجريت رزقي عليه غير تقويتِ",15,"ت",1,0],["راع قلبي مشيبُ رأسٍ خليسِ","راع جهلي والكَيْس بالتكييسِ",16,"س",1,1],["راع فؤادي منك ما راعَهْ","ولاعه صدك ما لاعَهْ",17,"ع",2,1],["راعت الناسَ يومَ ذلك حتَّى","قال قومٌ أخَيْلُهُم أم سَعالي",18,"ل",2,0],["راع المها شيبي وفيه أمانُها","مِنْ أنْ تصيدَ رميَّهنَّ سِهامي",19,"م",2,1],["راعني شخصُهُ وراع بشَخْصي","بقر الإنس ساكناتِ الخيام",20,"م",1,0],["راعني بالمشيبِ عمَّا نهى عن","ه بآي الكتابِ ذي الإحكام",20,"م",1,0],["راعَنا أَن يَزولَ عَنّا وَإِنّا","لَم نُطِق أَن نُطيلُ جيلَ حَياتِه",21,"ت",2,0],["راعَها مِنِّيَ الحُبُّ السُكو","تُ فَذَمَّت تَبَلُّدي",22,"د",2,0],["راعَكَ الدُستورُ مُنتَصِراً","فَأَثَرتَ الجُندَ بِالعَمَمِ",23,"م",1,0],["راعها منهُ صَمتُهُ ووجُومُهُ","وشَجاها شُحُوبُهُ وسُهومُهْ",24,"م",2,1],["راعَ الظَلامُ بِها أَوانِسَ تَرتَمي","مِثلَ الظِباءِ مِنَ الرُبى يَهوينا",25,"ن",2,0],["راعَتكِ رائِعَةُ البَياضِ بِعارِضي","وَلَوَ أَنَّها الأولى لَراعَ الأَسحَمُ",26,"م",1,0],["راعَني ما يَروعُ مِن وافِدِ الشَي","بِ طُروقاً وَرابَني ما يَريبُ",27,"ب",1,0],["راعٍ أَراهُ الحَقُّ قَصدَ سَبيلِهِ","فَغَدا يُناضِلُ دونَهُ وَيُرادي",28,"د",2,0],["راعَ مَعروفُهُ فَأَربى وَبدرُ ال","أُفقِ رَيعٌ مُستَأنَفٌ مِن هِلالِه",29,"ل",2,0],["راعَت فُؤادي حينَ زارَت رَوعَةً","مِنها ظَلِلتُ كَأَنَّني مَخمورُ",30,"ر",1,0],["راعٍ يَسيرُ القومُ تح","تَ لواءِ مَنكبِه وَسايس",31,"س",1,0],["راعٍ لنا يَجتاحُ دَثْرَ سَوامِه","وأبٌ لنا يسطو على أولادِه",32,"د",2,0],["راعَني يا يَزيدُ صَوتُ الغُرابِ","بِحِذاري لِلبَينِ مِن أَحبابي",33,"ب",2,1],["راعي الأَنامِ بِعَينٍ غَيرِ راقِدَةٍ","قَد وُكِّلَت في أُمورِ المُلكِ بِالسَهَرِ",34,"ر",1,0],["راعَ أَحزابَ العِدى بِيَراعٍ","طالَما أَنشى السَحابَ الثِقالا",35,"ل",2,0],["راعني حولُك الرهيب فخارت","عزماتي ولم يعد ليَ حول",36,"ل",1,0],["راعِفاتُ القنا تَلَوّنُ فيها","عَذَبَاتٌ كَمِثلِ مُصْحَفِ قاري",37,"ر",2,0],["راعَني مَنظَرُهُ لَمّا بَدا","رُبَّما أَرتاعُ بِالشَيءِ الحَسَن",38,"ن",1,0],["راعَ الفُؤادَ تَفَرُّقُ الأَحبابِ","يَومَ الرَحيلِ فَهاجَ لي أَطرابي",39,"ب",2,1],["راعه في الحربِ من أبطالِها","مُستطيرُ البأسِ ما شاء اقتَحمْ",40,"م",1,0],["راعتِ الأملاكَ في أجنادهم","وَانْتحَتْ تغزو الخواقينَ العِظاما",41,"م",2,0],["رَاعَ المنابرَ خطبُ مِنبركَ الذي","نَسفَ الجبالَ ومال بالأسوارِ",42,"ر",1,0],["رَاعَ صَمصامُه وشاعَ له في ال","أرضِ ذِكرٌ مُجلجِلٌ رنّانُ",43,"ن",1,0],["راعه جعفرٌ بقولٍ مُبينٍ","فرأى الحقَّ واضحاً واليقينا",44,"ن",2,0],["راع الكتائبَ واستولت مهابتُهُ","على القواضبِ تَلقاه فتحتشمُ",45,"م",1,0],["راعَهُم حَيّاً وَمَيِتاً فَاِتَقوا","همَّةً جَبّارةً لَم تُخذَلِ",46,"ل",1,0],["راعني أمرهُ فنبَّهتُ مَنْ حَوْ","لِيَ ذُ عْراً بصرخةٍ في السُّكون",47,"ن",1,0],["راعَيتَ جانِبَها بِلَحظٍ حازِمٍ","فَطِنٍ بِعَقرَبِ عِلَّةٍ وَدَبيبِها",48,"ب",3,0],["راعِتْ قلوبَ العِدا أَنباءُ بِعْثَتِهِ","كَنَبْأَةٍ أَجْفَلَتْ غَفْلاً مِنَ الغَنَمِ",49,"م",1,0],["راعتهم بكم البروق كأنما","جرَّدتُمُوهَا في السحابِ نُصُولا",50,"ل",2,0],["راعَهُ مِن سُعادَ إِذ وَدَّعَتهُ","في ثَلاثٍ مِن مُلكِها أَغيادِ",51,"د",1,0],["راعٍ لِأَحسابِنا وَذِمَّتِنا","يُمسي دُواراً وَيَغتَدي نُصُبا",52,"ب",2,0],["راعي الذِراعَينِ لِتَحريزِها","مِن مَشرَبٍ غارَ إِلى مَشرَبِ",53,"ب",1,0],["راعَتكَ دُنياكَ مِن ريعَ الفُؤادُ وَما","راعَتكَ في العَيشِ مِن حُسنِ المُراعاةِ",54,"ه",1,1],["راعِدٌ تَحتَهُ صَلَف","وَدَمٌ كُلُّهُ ظَلَف",55,"ف",1,1],["راعَها أَجدَلٌ مِنَ الطَيرِ أَو با","زٍ فَمودٍ قَبلَ الوُصولِ وَواصِل",56,"ل",1,0],["راع يعيد إلى الإسلام سيرته","يرعى بنيه وعين الله ترعاه",57,"ا",2,0],["راع المقام فؤادَ لَيلى فاِختفت","في ظهر زينب وَهي في رجفان",58,"ن",1,0],["راعها النور وهي في ظلمة ال","كون فخفَّت إليه تطوي ظلامَه",59,"م",2,0],["راعَ الطُّغاةَ شُعاعُهُ فتساءلوا","مَنْ نَصَّ هذا الكوكبَ الوقَّادا",60,"د",2,0],["راعهُ عاصفٌ يرجُّ السماوا","تِ وموجٌ يضجُّ ملءَ البحورِ",61,"ر",1,0],["راعَني مِن نُفوسِكُنَّ جَمالٌ","يَتَجَلّى في هالَةٍ مِن جَلالِ",62,"ل",1,0],["راعَني منها بَنَانٌ ناعِمٌ","كَسِيُورِ القِدِّ في مثلِ البَرَد",63,"د",1,0],["رَاع الكِنانَةَ رُزْءُ عَبْدِ القَادِرِ","وَجَرَى القَضَاءُ بِأَيِّ حُكْمٍ قاهِرِ",64,"ر",1,1],["رَاعَتْ حِلاَهَ وَلَمْ يُخَلِّ","دُ مِثْلَ ذِكْرَاهُ كِتَابُ",65,"ب",1,0],["رَاعَ آفَاقَهَا نَعْيكَ حَتَّى","لَكَأَنَّ النَّعِيَّ بُوقُ التَّنَادِي",66,"د",2,0],["رَاعِي الغزَالَةَ وَالقَضَاءَ فُلاَتَها","يرْعى مُهَاةَ المَاءِ رعيَ كفِيلِ",67,"ل",1,0],["رَاعَتْ حُلِيُّ الْبَدِيعِ فِيهِ","بَيْنَ المُنَابَاةِ وَالطِّبَاقِ",68,"ق",1,0],["رَاعَ أَلْبَابَنا بِكُلِّ بَيَانٍ","وبَديعٍ ما كَانَ بِالأَمْسِ فِكْرَا",69,"ر",2,0],["رَاعَنَا قَدُّهَا الرَّشِيقُ وَقَدْ تَكْ","فِي فُتُوناً رَشَاقَةٌ بِالْقُدُودِ",70,"د",1,0],["رَاعَ دِيبَاجَةً وَرَاقَ انْسِجَاماً","وَخَلاَ مِنْ مَآخِذِ التَّعقِيدِ",71,"د",1,0],["رَاعَتْ حَشَايَ بِنَوْحٍ","حَمَامَةٌ فِي ارِْتِيَادِ",72,"د",1,0],["رَاعَتْ مَنَاقِبُكَ الَّتِي","فِي الْبَدْوِ ذَاعَتْ وَالْحَضَرْ",73,"ر",1,0],["رَاعَ العُيُونَ جَمَالُ هَذَا المَنْظَرِ","لِلّهِ دَرُّكَ مِنْ صَبَاحٍ مُسْفِرِ",74,"ر",1,1],["رَاعٍ تَخَيَّرَ خِطَّةً فَغَدَا بِهَا","وَمِثَالُهُ بَيْنَ الرُّعَاةِ فَرِيدُ",75,"د",1,0],["راعه أنَّ عمره يتلاشى","مثل ما تُخمد الأعاصير شمعةْ",76,"ع",2,0],["راعِفٌ مِمّا جَرى دَمُهُ","حَسِبوا عرنينَهُ وَدَجا",77,"ج",2,0],["راع خلف الستور ما اظهرته","من جمال فكيف ما في خفاها",78,"ا",3,0],["راعني ما يروغ من وافد الشي","ب طروقاُ، ورابني ما يريب",79,"ب",1,0],["راعنا أنّ يزول عنّا ، وإنّا","لم نطق أن نطيل حبل حياته",80,"ت",2,0],["راع قلبي الرّحيل حتّى تولّيتم","فأشهى المنى إليّ الرّحيل",81,"ل",1,0],["رَاعَني مَنْظَرُهُ، لَمّا بَدا،","رُبَّما أَرْتَاعُ بِکلشَّيْءِ الحَسَنْ",82,"ن",1,0],["راعت سلانيك دار الملك فانتبهت","من ذاك طهران تخشى امر تبريزا",83,"ز",2,0],["راعها منهُ صَمتُه ووجُومُه","وشجاها شكوبهُ وسُهُومهُ",84,"م",2,1],["راعَني الدَهر كَما قَد","رَعت مَصراً بِالفُراق",85,"ق",1,0],["راعني بالنفار وهو غزال","ولعمري النفار طبع الظباء",86,"ا",1,0],["راعَيتُ فيهِ قَرابَةً مَوصولَةً","وَحَفِظتُ فيهِ وَصِيَّةَ الأَجدادِ",87,"د",1,0],["راعيتَ حقَّ الله فيه ولم يكن","شيءٌ عليك سوى العبادةِ أَغلبا",88,"ب",2,0],["راع المعالي منه جود لم يزل","يمرى دما أمواله بالسفك",89,"ك",1,0],["راعَ فيهِ الكَرى تَباريحُ شَوقٍ","وَخَيالٌ جُنحَ الظَلامِ يَزورُ",90,"ر",1,0],["راعى قضيّةَ إنسانيّةٍ شرعَتْ","رعيَ العهودِ بذا سمّوْهُ إنسانا",91,"ن",2,0],["راع بالْخَطِّىِّ والخط العِدَا","فالكَتيبات له كالكُتب",92,"ب",1,0],["راعي القطيع مسلم","يعطي الفتىّ به الحفاره",93,"ر",2,0],["راعَهم ما رَأوهُ منهُ فراموا","قتلهُ كيفَ تقتلُ القتلاءُ",94,"ا",2,0],["راعَهُم بَعدَ رَقدَةٍ رَقَدوها","دَعوَةٌ مِن صَمَحمَحٍ غَيرِ كابِ",95,"ب",1,0],["راعيتهم من مقلتي","بالعارضين الممطرين",96,"ن",1,0],["راع هذا الهدير يا مرسل البرق","كؤوساً رأبتها بصدوعي",97,"ي",1,0],["راعه أن يكون وحي صباه","وحيَ روح يستلهم الأقدارا",98,"ر",2,0],["راعني منك صدودٌ رائعُ","بعد ما قد راقني منك وصالُ",99,"ل",1,0],["راعني إذْ أنت جنبي","مخفياً ماكنت تبدي",100,"د",2,0],["راعى الله طيفاً زراني من خيالها","فوافي ولكن حال من دونه السهد",101,"د",1,0],["راعتكِ غارة أعلاجٍ على سفنٍ","ملَّاحُهم يمتطي للقَدرِ مرزابا",102,"ب",2,0],["راعيت فيها للوفاء أذمةً","إنّ الوفاء أحق شيء روعي",103,"ع",2,0],["راعها منه مقلةٌ تنفث السحر","ووجه يضيء حسنا وبشرى",104,"ر",2,0],["راعني في موكبٍ صوّره","خالقُ الكونِ عَلَى لوح الفضا",105,"ا",1,0],["راعفَ المنقارِ خفافَ الحشا","من رآه خاله طيراً 