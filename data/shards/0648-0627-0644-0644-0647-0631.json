{"poems":[[95,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[23,"والله ربي لا نفارق ماجدا","https://www.aldiwan.net/poem21417.html","الكامل"],[58,"إني ببابك لا ودي يقربني","https://www.aldiwan.net/poem58643.html","البسيط"],[51,"لولا يزيد ابن منصور لما عشت","https://www.aldiwan.net/poem64126.html","البسيط"],[51,"والله ربك إنني","https://www.aldiwan.net/poem64308.html","مجزوء الكامل"],[52,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[52,"يا بان ضاق المذهب","https://www.aldiwan.net/poem64810.html","مجزوء الكامل"],[189,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[402,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11016.html","عموديه"],[415,"وكل ملك إلى زوال","https://www.aldiwan.net/poem31672.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38925","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62584","البسيط"],[1404,"","https://poetry.dctabudhabi.ae/diwan/poem/34867","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60870","الكامل"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21211","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139968","الرجز"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66370","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131289",""],[5205,"سما أكباد ارباب النهى انفطرت","https://www.poetsgate.com/ViewPoem.aspx?id=120993",""],[5324,"عين السماء على العراق تسيلُ .","https://www.poetsgate.com/ViewPoem.aspx?id=207659",""],[5413,"أحد عشر كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=208597",""],[5910,"لِي في الهوى حَرْفَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=206237",""],[5956,"الذين رأينا الخير والفخر وأنت منهم","https://www.poetsgate.com/ViewPoem.aspx?id=193435",""],[5976,"وبْل القصيد .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30535",""]],"verses":[["وَاللهُ رَاعِيكَ أَلَيْسَ الَّذِي","جَاءَكَ فِي الحَالَيْنِ مِنْ عِنْدِهِ",0,"د",2,0],["وَاللَهِ رَبّي لا نُفارِقُ ماجِداً","عَفَّ الخَليقَةِ ماجِدَ الأَجدادِ",1,"د",1,1],["وَاللَهِ رَبّي لا نُفارِقُ أَمرَهُ","ما كانَ عَيشٌ يُرتَجى لِمَعادِ",1,"د",1,0],["واللّهِ رَبِّ النّبِيِّ المُصْطَفَى قَسَماً","بَرّاً وَحَقِّ مِنى والبَيْتِ ذِي الحُجُبِ",2,"ب",1,0],["وَاللَهِ رَبِّ مِنىً وَالراقِصاتِ بِها","لَأَشكُرَنَّ يَزيداً حَيثُما كُنتُ",3,"ت",1,0],["وَاللَهِ رَبِّكَ إِنَّني","لَأُجِلُّ وَجهَكَ عَن فِعالِك",4,"ك",1,1],["وَاللَهِ رَبِّ مُحَمَّدٍ","ما إِن غَدَرتُ وَلا نَوَيتُه",5,"ت",2,0],["وَاللَهِ رَبِّ مُحَمَّدٍ","إِنّي بِبانَةَ مُعجَبُ",6,"ب",1,0],["واللهِ ربِّ مِنىً وما جَمعتْ","وكفى بذاك لمُقْسِمٍ حَلَفا",7,"ف",2,0],["وَاللَّهَ رَبّي أَسأَلُ","وهو الكَريم المفضِلُ",8,"ل",1,0],["وَاللَهُ رَبٌّ قادِرٌ إيجادُهُ","السَبعُ العُلى رَفعاً بِغَيرِ عَمَدِ",9,"د",1,0],["والله راعيك أليس الذي","جاءك في احالين من عنده",10,"د",2,0],["والله رب العباد باق","وهالك نده وشركه",11,"ك",2,0],["وَاللَّه ربّي قَد أَجاب دعاءَها","لدعائها مِن قَلبِها وَلِسانِها",12,"ن",3,0],["والله رب السما والأرض لو خلت","الآفاق من كلمة التوحيد لانطبقا",13,"ق",2,0],["والله رب البيت والمشعر","والله أن لو قتل البحتري",14,"ر",2,0],["واللهُ رَبيِّ لَم يَزَل متكلِّماً","وَكَلاَمُهُ المَسمُوعُ بالآذَانِ",15,"ن",1,0],["واللهُ رَبُّ العرشِ قَالَ حَقِيقَةً","حضم مَع طَهَ بِغَيرِ قِرَانِ",15,"ن",1,0],["وَاللهُ رَبِي لَم يَزَل ذَا قُدرَةٍ","وَمَشِيئَةٍ وَيَلِيهُمَا وَصفَانِ",15,"ن",1,0],["وَاللهُ رَازِقُهُ بِهَذَا الاعتَبا","رِ وَلَيسَ بِالإِطلاَقِ دُونَ بَيَانِ",15,"ن",1,0],["وَاللهُ رَبِّي قَد أعَانَ بِكَسرِ ذَا","وَبِقَطعِ ذَا سُبحَانَ ذِي الإحسَانِ",15,"ن",1,0],["والله ربُ العرش مُطّلعٌ على","أني لصفو الوِد فيكم مُضْمِرُ",16,"ر",1,0],["واللَه ربي إن سلمتُ لآثرن","فيه بضربة جازم لم يقصد",17,"د",1,0],["واللهُ راضٍ عنه والخلقُ له","يدعونَ مهما كبّروا وأحرموا",18,"م",3,0],["وَاللَهُ رَبّي ما تُكَيَّفُ ذاتُهُ","بِخَواطِرِ الأَوهامِ وَالأَذهانِ",19,"ن",1,0],["واللَّه ردّ كيدهم","وغيظهم في نحرهم",20,"م",1,0],["واللَه ربي اسئل","وهو الكريم المفضل",21,"ل",1,0],["والله راضٍ عنكم ورسوله","ومن الزمان اليكم ايماء",22,"ا",2,0],["والله ربي مستم نوره أبدا","لذا سواطع أنوار الهدى بهرت",23,"ت",1,0],["والله رأسك شامخ لاينحني...","فكما نخيلك باسق وأصيلُ",24,"ل",1,0],["والله ربكَ صبَّ فيك أدلة","تُغنيكَ عنْ كتبٍ تبثُّ غرورا",25,"ر",2,0],["واللهُ ربُّ العرشِ يعلمُ أنَّني","لا أنثني عنها بِصِدقِ ودادِ",26,"د",1,0],["والله رفّعكم من أجل أمّتكم","أمٍّ بفضل تفانيها الجميعُ نجا",27,"ج",2,0],["والله رفّع نحو العدن نجْلتنا ال","عُظمى هنادي وناياً دون أن تَلِجا",27,"ج",2,0],["والله رهنت العمر لين آخر شْروقه","بيديك يا صاحبي .. واللي تودّه .. سوْ .. !!",28,"و",1,0]]}