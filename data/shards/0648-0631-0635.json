{"poems":[[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[93,"ألا نبي لو طبعنا الشمس يوما","https://www.aldiwan.net/poem8791.html","عموديه"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[563,"شخصت لطلعة وجهك الأشخاص","https://www.aldiwan.net/poem34426.html","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137760",""],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123750","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216788","الطويل"],[4859,"رصاصة النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=187409",""],[4888,"عشرون عاما من العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=207743",""],[5102,"عيد الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=18921",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5616,"الجوع.. الجوع!","https://www.poetsgate.com/ViewPoem.aspx?id=205221",""],[5674,"الحب عانق بسمتي","https://www.poetsgate.com/ViewPoem.aspx?id=189095",""],[5674,"رحيل قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=196439",""]],"verses":[["وَرَصَدتُ النُجومَ مُنذُ أَضاءَت","في سَماءِ الدُجى فَأَحكَمتُ رَصدي",0,"د",2,0],["وَرَصَّعناهُ بِالشُهبِ الدَراري","لَما زُدناكَ فَخراً أَو مَديحا",1,"ح",2,0],["ورصّوا كبنيانٍ فخيمٍ صُفوفَهُ","لكي تُرهِبوا الأعداءَ من غيرِ حملة",2,"ه",1,0],["ورصاص الأتباع يزأر","كالرعد وقد مد طارق زحفه",3,"ف",2,0],["ورصاص من أحببته ذهبٌ كما","ذهبُ الذي لم ترض عنه رصاص",4,"ص",1,0],["ورصد الصروف أجل نتا","ئِج من رصد سنبلة وسهى",5,"ه",2,0],["ورَصَّعتَ من كنزِ العلومِ حواشياً","كترصيعِ دُرٍّ في نضارِ المناطقِ",6,"ق",1,0],["ورصّعه بالحسن المُسَوَّم واجْلُهُ","بكل سعيد في المناظر طيب",7,"ب",1,0],["ورصاصة النسيانِ قد صوبتُها","نحوَ الذي يوماً أراد خضوعي",8,"ع",2,0],["وَرَصَّعَتْ تَاجَهَا بِالدُّرِّ مُتَّقِدًا","وَقَلّدَتْهُ الّذي أضحى له السَّبَقُ",9,"ق",1,0],["ورصيدُ كل المبدعينَ تجاوُبٌ","فلتقبلوني بينكم من يستفيدْ",10,"د",1,0],["وَرَصيدُهَا مِمَّا تَرَكْ-","-تَ لِفَاقَةٍ أَغْلَى رَصِيدِ",11,"د",1,0],["ورصفتهم رصف الحجارة بانياً","للدين فيهم صرحك المشهودا",12,"د",2,0],["وَرَصَّعَ فِي نَظْمِهِ دُرَّهُ","عَلَى السَّبْكِ مِنْهُ بِمَرْجانِهِ",13,"ن",2,0],["وَرصَّعْتُمْ قُصُورَكُمُ مَرَايَا","لِتَنطِقَ بِالبَهاءِ وَبالجَمَالِ",14,"ل",1,0],["ورصفتُ أضلاعي لكم درب السلام","ابقوا بقلبي قد يطيب هنا المقام",15,"م",1,1],["ورصفت أضلاعي لتمشي فوقها","ما بال روحي في فراقك خائره",16,"ر",2,0]]}