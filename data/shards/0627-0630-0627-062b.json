{"poems":[[65,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[88,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[88,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[87,"إذا ثار يوما عليك العدا","https://www.aldiwan.net/poem7556.html","المتقارب"],[51,"ماذا يريك الزمان من عبره","https://www.aldiwan.net/poem62113.html","المنسرح"],[68,"أطعت داعي الهوى رغما على العاصي","https://www.aldiwan.net/poem40648.html","البسيط"],[82,"أقول لبرق شمته في غمامه","https://www.aldiwan.net/poem31298.html","الطويل"],[46,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[33,"هاج فؤادي موقف","https://www.aldiwan.net/poem42226.html","مجزوء الرجز"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[22,"ما أدري إذا لاقيت عمروا","https://www.aldiwan.net/poem21708.html","الوافر"],[50,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[124,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[164,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[173,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[190,"تظلم شرطي وغماز بابه","https://www.aldiwan.net/poem43261.html","الطويل"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[215,"أطوف بأحلامي عليكم لعنى","https://www.aldiwan.net/poem46319.html","الطويل"],[215,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[308,"إذا ثنى سلب الألباب عطفه","https://www.aldiwan.net/poem58313.html","البسيط"],[353,"إذا ثبتت بين القلوب مودة","https://www.aldiwan.net/poem20161.html","الطويل"],[369,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[457,"لله من فوارة قد أرسلت","https://www.aldiwan.net/poem13744.html","الكامل"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[469,"قلبي ببيض المعالي هائم دنف","https://www.aldiwan.net/poem3449.html","عموديه"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126157","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56208","الوافر"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35738","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96500","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118366","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53093","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93734","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100218","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45813","الطويل"],[4755,"لأني كلما انزَلَقُوا ثَبَتُّ","https://www.poetsgate.com/ViewPoem.aspx?id=184178",""],[4755,"لِأَنَّ الحُرَّ يَأبَى مَن يَجُورُ","https://www.poetsgate.com/ViewPoem.aspx?id=202738",""],[4840,"لك الله من برق بدا متبسما","https://www.poetsgate.com/ViewPoem.aspx?id=129156",""],[5083,"بَشيرُ السَعد","https://www.poetsgate.com/ViewPoem.aspx?id=53761",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5431,"قصيدة تفكيكية","https://www.poetsgate.com/ViewPoem.aspx?id=215486",""],[5776,"خارطة الثورة اليمانية","https://www.poetsgate.com/ViewPoem.aspx?id=199935",""]],"verses":[["إذا ثارَ رَيْعانُ العَجاجِ تلثَّموا","على غُرَرٍ تَسْتَوْقِفُ العَيْنَ شُدَّخِ",0,"خ",1,0],["إِذا ثارَ دُكَّت أَجبُلٌ وَتَخَشَّعَت","بِحارٌ وَأَمضى اللَهُ ما هُوَ كاتِبُه",1,"ب",2,0],["إِذا ثُرتَ ماجَت هِضابُ الشَآمِ","وَباتَت تَرامى بِثُوّارِها",2,"ر",3,0],["إِذا ثارَ في يَومِ الوَغى مالَ مَنكِبٌ","مِنَ الأَرضِ وَالأَطوادِ وَاِنهالَ مَنكِبُ",3,"ب",1,0],["إِذْ أَثَرْتَ الحَرْبَ العَوَانَ عَلَى البَغْ","يِ وَكُلُّ لَهُ عَلَيْكَ مُعِينُ",4,"ن",1,0],["إذا ثار يوما عليك العدا","وخفت من الحقد والحاقد",5,"د",1,1],["إِذا ثَوى في القُبورِ ذو خَطَرٍ","فَزُرهُ فيها وَاِنظُر إِلى خَطَرِه",6,"ر",2,0],["إِذا ثَناها نَسيمُ الرَقصِ مِن مَرَحٍ","عَجِبتَ مِن هَزِّ أَغصانٍ وَأَدعاصِ",7,"ص",1,0],["إذا ثارَ صكَّ الصّدْرَ بالخفّ شِرّةً","وطارَ به في القفْرِ وَحْيُ زِمامِهِ",8,"م",2,0],["إِذا ثَوى جارُ قَومٍ في بِلادِهِمِ","فَجارُهُ نازِلٌ في رَأسِ غُمدانِ",9,"ن",1,0],["إِذا ثَلاثٌ كَالدُمى","وَكاعِبٌ وَمُسلِفُ",10,"ف",1,0],["إِذا ثَبَتَت أُخرى النَدى في مُحَمَّدٍ","فَلَم تَتَزَحزَح بِالحِمامِ أَوائِلُه",11,"ل",2,0],["إِذا ثارَ الغُبارُ خَرَجنَ مِنهُ","كَما خَرَجَت مِنَ الغَدَرِ السِراحُ",12,"ح",1,0],["إِذا ثَنَتهُ الغُصونُ جَلَّلَني","فَينانُ ما في أَديمِهِ جُوَبُ",13,"ب",1,0],["إذا ثار ما بين الحجا بين والحشا","فكل سكون يستثير رواقدي",14,"ي",1,0],["إذا ثقلت أيام ملك على الورى","فأيامك الحسنى تواريخ أنعم",15,"م",1,0],["إِذا ثَوَّبَ الداعي بِها يالَ عامِرٍ","أَتَت مِثلَ أُسدِ الغابِ غُلبٌ رِقابُها",16,"ب",3,0],["إذا ثبت الريب استهان بأمره","توهّمَه عرسا فأصبح هائما",17,"م",2,0],["إذا ثبتت للمرء ذلت بمكرها","قديماه من طود لنقض ثباتها",18,"ت",3,0],["إذا ثار وجدى قلت تلك بقية","من العيش يحييني بها ذلك الوجد",19,"د",1,0],["إذا ثغره الوهّاج أرسل لمحةً","أضاءت له دنيا بمرآه تجمُل",20,"ل",1,0],["إذا ثنى سلب الألباب عطفه","البادي التأود لا الخطيه السلب",21,"ب",1,1],["إذا ثَبتَتْ بَيِنَ القُلُوبِ مَوَدَّةٌ","فَلا تَخْشَ مِن نَقْضٍ بِنَقْلِ الحَواسدِ",22,"د",1,1],["إذا ثلاثٌ تأثّفَتْهُ له","لم يُخْشَ في المُشكلاتِ مَنْهَؤها",23,"ا",3,0],["إِذا ثنى الغصنَ وقعُ الطير مُغْتَرِداً","عليه صَفَّقَ فيه النهرُ مُطَّرِدَا",24,"د",2,0],["إذا ثَقُلتْ وُسوق الرأي أقعَى","يَحُكُّ بظهره من غير عسرِ",25,"ر",1,0],["إذا ثقُلَ الحِملُ قامت به","وإن ظَلعتْ نهضَتْ أجلدا",26,"د",2,0],["إذا ثنى قدَّه في ثني زورته","فحسبي المؤنسانِ الإلفُ والألف",27,"ف",1,0],["إِذَا ثَنَا فِيهَا الهَجِيرَ بَقْبَقا","يَضِجُّ نابَاه إِذَا مَا أَصْلَقا",28,"ق",2,0],["إِذا ثَنَى فَرْغَ اللَهَاةِ قُمْقُمُهْ","وَرَدَّها عُثْنُونُهُ وَغَلْصَمُهْ",29,"م",2,0],["إذا ثوب كساه الطرز فانظر","بطانته ولا تنظر طرازه",30,"ز",2,0],["إذا ثار العراك تراه ليثاً","شديداً في الوغا والخصم شاةُ",31,"ه",1,0],["إذا ثقلت حملاً رواعد مزنةٍ","حسبت عشار النوق للرعد تطلق",32,"ق",1,0],["إِذا ثَوَّبَ الداعي بِها زَعزَعَت لَهُ","مُتونَ القَنا الخَطّيِّ بَينَ العَساكِرِ",33,"ر",1,0],["إذا ثار الفساء بهم تغنوا","ألم تربع على الدِّمن المثول",34,"ل",1,0],["إذا ثويت بنا تثوى لدى ملا","وقف على ما به تأتي مسامعه",35,"ع",2,1],["إذا ثنت كأْس الثناء عطفه","لم يخلُ بيت المال من معربد",36,"د",1,0],["إذ أثبَتُوهُ بِكَونِ ذِي الأجسَادِ حَا","دِثَةً فلاَ تَنفَكُّ عَن حِدَثَانِ",37,"ن",1,0],["إِذا ثارَ نَقع الخَيل كَاللَيل أَومضت","بوارقه كَالبَرق بَل إِنَّها أَضوا",38,"و",2,0],["إذا ثار في الصفين نقع عجاجة","يخوض عجاج النقع شعثاً ذوائبه",39,"ب",2,0],["إذا ثبَتَتْ راقَ العُيون ثَباتُها","أو انقلبَتْ رابَ النّفوسَ انقِلابُها",40,"ب",3,0],["إِذا ثارَ مِن أَرض الحَطيم عُدتَ بِهِ","جِياد بِها جَيش العَدو تَحَطَما",41,"م",2,0],["إذا ثارَ الجَفَافُ عليَّ يَومًا","بَصَقتُ دَمِي عليهِ وما التَفَتُّ",42,"ت",1,0],["إِذا ثَارَت حَجُورُ فَكُلُّ صَخرٍ","وكُلُّ سَحَابَةٍ مَعَها تَثُورُ",43,"ر",1,0],["إذا ثار نفع للخلاف وأشكلت","مسالكه كان الرئيس المحكما",44,"م",2,0],["إذا ثُلِمَتْ تَخِذنا للمَنايا","أَظافِرَنا وحَسبُكَ يا غَليلي",45,"ل",2,0],["إذا ثار يوم الروع أيقظ عزمة","تكاد من الجوزاء تدرك ثارها",46,"ر",3,0],["إذا ثملت بكأسٍ من حروفٍ","تقرّ له -ندامى الشعر- أجرا",47,"ر",2,0],["إذا ثار ثار فلا عاصم","من الشعب إن حانت الملحمه",48,"م",2,0]]}