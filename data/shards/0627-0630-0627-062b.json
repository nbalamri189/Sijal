{"poems":[[63,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[86,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[86,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[85,"إذا ثار يوما عليك العدا","https://www.aldiwan.net/poem7556.html","المتقارب"],[49,"ماذا يريك الزمان من عبره","https://www.aldiwan.net/poem62113.html","المنسرح"],[66,"أطعت داعي الهوى رغما على العاصي","https://www.aldiwan.net/poem40648.html","البسيط"],[80,"أقول لبرق شمته في غمامه","https://www.aldiwan.net/poem31298.html","الطويل"],[44,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[31,"هاج فؤادي موقف","https://www.aldiwan.net/poem42226.html","مجزوء الرجز"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[22,"ما أدري إذا لاقيت عمروا","https://www.aldiwan.net/poem21708.html","الوافر"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[118,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[158,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[167,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[184,"تظلم شرطي وغماز بابه","https://www.aldiwan.net/poem43261.html","الطويل"],[184,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[209,"أطوف بأحلامي عليكم لعنى","https://www.aldiwan.net/poem46319.html","الطويل"],[209,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[301,"إذا ثنى سلب الألباب عطفه","https://www.aldiwan.net/poem58313.html","البسيط"],[346,"إذا ثبتت بين القلوب مودة","https://www.aldiwan.net/poem20161.html","الطويل"],[362,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[450,"لله من فوارة قد أرسلت","https://www.aldiwan.net/poem13744.html","الكامل"],[456,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[456,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[462,"قلبي ببيض المعالي هائم دنف","https://www.aldiwan.net/poem3449.html","عموديه"]],"verses":[["إذا ثارَ رَيْعانُ العَجاجِ تلثَّموا","على غُرَرٍ تَسْتَوْقِفُ العَيْنَ شُدَّخِ",0,"خ",1,0],["إِذا ثارَ دُكَّت أَجبُلٌ وَتَخَشَّعَت","بِحارٌ وَأَمضى اللَهُ ما هُوَ كاتِبُه",1,"ب",2,0],["إِذا ثُرتَ ماجَت هِضابُ الشَآمِ","وَباتَت تَرامى بِثُوّارِها",2,"ر",3,0],["إِذا ثارَ في يَومِ الوَغى مالَ مَنكِبٌ","مِنَ الأَرضِ وَالأَطوادِ وَاِنهالَ مَنكِبُ",3,"ب",1,0],["إِذْ أَثَرْتَ الحَرْبَ العَوَانَ عَلَى البَغْ","يِ وَكُلُّ لَهُ عَلَيْكَ مُعِينُ",4,"ن",1,0],["إذا ثار يوما عليك العدا","وخفت من الحقد والحاقد",5,"د",1,1],["إِذا ثَوى في القُبورِ ذو خَطَرٍ","فَزُرهُ فيها وَاِنظُر إِلى خَطَرِه",6,"ر",2,0],["إِذا ثَناها نَسيمُ الرَقصِ مِن مَرَحٍ","عَجِبتَ مِن هَزِّ أَغصانٍ وَأَدعاصِ",7,"ص",1,0],["إذا ثارَ صكَّ الصّدْرَ بالخفّ شِرّةً","وطارَ به في القفْرِ وَحْيُ زِمامِهِ",8,"م",2,0],["إِذا ثَوى جارُ قَومٍ في بِلادِهِمِ","فَجارُهُ نازِلٌ في رَأسِ غُمدانِ",9,"ن",1,0],["إِذا ثَلاثٌ كَالدُمى","وَكاعِبٌ وَمُسلِفُ",10,"ف",1,0],["إِذا ثَبَتَت أُخرى النَدى في مُحَمَّدٍ","فَلَم تَتَزَحزَح بِالحِمامِ أَوائِلُه",11,"ل",2,0],["إِذا ثارَ الغُبارُ خَرَجنَ مِنهُ","كَما خَرَجَت مِنَ الغَدَرِ السِراحُ",12,"ح",1,0],["إِذا ثَنَتهُ الغُصونُ جَلَّلَني","فَينانُ ما في أَديمِهِ جُوَبُ",13,"ب",1,0],["إذا ثار ما بين الحجا بين والحشا","فكل سكون يستثير رواقدي",14,"ي",1,0],["إذا ثقلت أيام ملك على الورى","فأيامك الحسنى تواريخ أنعم",15,"م",1,0],["إِذا ثَوَّبَ الداعي بِها يالَ عامِرٍ","أَتَت مِثلَ أُسدِ الغابِ غُلبٌ رِقابُها",16,"ب",3,0],["إذا ثبت الريب استهان بأمره","توهّمَه عرسا فأصبح هائما",17,"م",2,0],["إذا ثبتت للمرء ذلت بمكرها","قديماه من طود لنقض ثباتها",18,"ت",3,0],["إذا ثار وجدى قلت تلك بقية","من العيش يحييني بها ذلك الوجد",19,"د",1,0],["إذا ثغره الوهّاج أرسل لمحةً","أضاءت له دنيا بمرآه تجمُل",20,"ل",1,0],["إذا ثنى سلب الألباب عطفه","البادي التأود لا الخطيه السلب",21,"ب",1,1],["إذا ثَبتَتْ بَيِنَ القُلُوبِ مَوَدَّةٌ","فَلا تَخْشَ مِن نَقْضٍ بِنَقْلِ الحَواسدِ",22,"د",1,1],["إذا ثلاثٌ تأثّفَتْهُ له","لم يُخْشَ في المُشكلاتِ مَنْهَؤها",23,"ا",3,0],["إِذا ثنى الغصنَ وقعُ الطير مُغْتَرِداً","عليه صَفَّقَ فيه النهرُ مُطَّرِدَا",24,"د",2,0],["إذا ثَقُلتْ وُسوق الرأي أقعَى","يَحُكُّ بظهره من غير عسرِ",25,"ر",1,0],["إذا ثقُلَ الحِملُ قامت به","وإن ظَلعتْ نهضَتْ أجلدا",26,"د",2,0],["إذا ثنى قدَّه في ثني زورته","فحسبي المؤنسانِ الإلفُ والألف",27,"ف",1,0]]}