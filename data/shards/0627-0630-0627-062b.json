{"poems":[[63,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[86,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[86,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[85,"إذا ثار يوما عليك العدا","https://www.aldiwan.net/poem7556.html","المتقارب"],[49,"ماذا يريك الزمان من عبره","https://www.aldiwan.net/poem62113.html","المنسرح"],[66,"أطعت داعي الهوى رغما على العاصي","https://www.aldiwan.net/poem40648.html","البسيط"],[80,"أقول لبرق شمته في غمامه","https://www.aldiwan.net/poem31298.html","الطويل"],[44,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[31,"هاج فؤادي موقف","https://www.aldiwan.net/poem42226.html","مجزوء الرجز"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[22,"ما أدري إذا لاقيت عمروا","https://www.aldiwan.net/poem21708.html","الوافر"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"]],"verses":[["إذا ثارَ رَيْعانُ العَجاجِ تلثَّموا","على غُرَرٍ تَسْتَوْقِفُ العَيْنَ شُدَّخِ",0,"خ",1,0],["إِذا ثارَ دُكَّت أَجبُلٌ وَتَخَشَّعَت","بِحارٌ وَأَمضى اللَهُ ما هُوَ كاتِبُه",1,"ب",2,0],["إِذا ثُرتَ ماجَت هِضابُ الشَآمِ","وَباتَت تَرامى بِثُوّارِها",2,"ر",3,0],["إِذا ثارَ في يَومِ الوَغى مالَ مَنكِبٌ","مِنَ الأَرضِ وَالأَطوادِ وَاِنهالَ مَنكِبُ",3,"ب",1,0],["إِذْ أَثَرْتَ الحَرْبَ العَوَانَ عَلَى البَغْ","يِ وَكُلُّ لَهُ عَلَيْكَ مُعِينُ",4,"ن",1,0],["إذا ثار يوما عليك العدا","وخفت من الحقد والحاقد",5,"د",1,1],["إِذا ثَوى في القُبورِ ذو خَطَرٍ","فَزُرهُ فيها وَاِنظُر إِلى خَطَرِه",6,"ر",2,0],["إِذا ثَناها نَسيمُ الرَقصِ مِن مَرَحٍ","عَجِبتَ مِن هَزِّ أَغصانٍ وَأَدعاصِ",7,"ص",1,0],["إذا ثارَ صكَّ الصّدْرَ بالخفّ شِرّةً","وطارَ به في القفْرِ وَحْيُ زِمامِهِ",8,"م",2,0],["إِذا ثَوى جارُ قَومٍ في بِلادِهِمِ","فَجارُهُ نازِلٌ في رَأسِ غُمدانِ",9,"ن",1,0],["إِذا ثَلاثٌ كَالدُمى","وَكاعِبٌ وَمُسلِفُ",10,"ف",1,0],["إِذا ثَبَتَت أُخرى النَدى في مُحَمَّدٍ","فَلَم تَتَزَحزَح بِالحِمامِ أَوائِلُه",11,"ل",2,0],["إِذا ثارَ الغُبارُ خَرَجنَ مِنهُ","كَما خَرَجَت مِنَ الغَدَرِ السِراحُ",12,"ح",1,0],["إِذا ثَنَتهُ الغُصونُ جَلَّلَني","فَينانُ ما في أَديمِهِ جُوَبُ",13,"ب",1,0]]}