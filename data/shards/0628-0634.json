اغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[91,"شاعر الدير","https://www.poetsgate.com/ViewPoem.aspx?id=14221",""],[105,"كم دون مية من عينٍ أحاذرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54907&r=&rc=77",""]],"verses":[["بِشُرْبٍ كَوَلْغِ الذِّئْبِ راعَتْهُ نَبْأَةٌ","وَأَكْلٍ كَنَوْشِ الصَّقْرِ مِمّا يَنالُهُ",0,"ل",2,0],["بُشرى فقد أنجَزَ الأيامُ ما وَعَدَتْ","وقلّما صَدَقَتْ مِنها المَواعيدُ",1,"د",1,0],["بُشْراكَ قَدْ ظَفِرَ الرّاعي بِما ارْتادا","وبَثَّ في جَنَباتِ الرَّوضِ أذْوادا",2,"د",2,1],["بشَمائِلٍ مُزِجَ الشِّماسُ بِلينِها","كالماءِ أُشْرِبَهُ السِّنانُ اللَّهْذَمُ",3,"م",1,0],["بَشِّر مِنىً بِظَلومٍ أَن تَحُلَّ بِها","وَبَشِّرِ البَيتَ وَالأَركانَ وَالحَرَما",4,"م",2,1],["بُشْرَاكَ إِنَّ اللهَ أَكْملَ عِيدَنَا","بِالْعَفْوِ مِنْكَ وَمِنْهُ بِالْغُفْرَانِ",5,"ن",1,0],["بُشْرَى تَقُومُ لَهَا الدُّنْيَا عَلَى قَدَمِ","حَتَّى بِهَا اللَّهُ حَيَّى النَّصْرِ فِي الْقِدَمِ",6,"م",1,1],["بُشْراكَ للمُلْكِ في عُلْياكَ تمْهيدُ","وفي زَمانِكَ للأفْراحِ تجْديدُ",7,"د",1,1],["بُشْرَى أَتَتْ مِثْلَ الصَّبَاحِ لِنَاظرِ","لَمْ تُعْزَ نِسْبَتُهَا إِلَى كَذَّابِ",8,"ب",1,0],["بَشَرْتُ حُرُوفَ الْكَتْبِ عِنْدَ الْتِبَاسِهَا","وَتَبْشُرُ حَدَّاهُ حُرُوفُ الْكَتَائِبِ",9,"ب",1,0],["بُشْرَى يَقُومُ لَهَا الزَّمَانُ خَطِيباً","وَتَأَرَّجُ الآفَاقُ مِنْهَا طِيبَا",10,"ب",2,1],["بِشُجاعِ الجَنانِ يَحتَفِرُ الظُل","ماءَ ماضٍ عَلى البِلادِ خَشوفِ",11,"ف",1,0],["بَشَّروهُ بِالتَداني وَنَسوا","أَنَّهُ ذاكَ العِصامِيُّ الأَبي",12,"ب",2,0],["بُشراكِ يا دُنيا وَبُشرانا مَعاً","هَذا الوَزيرُ أَبو الوَليدِ فَتاكِ",13,"ك",1,0],["بَشيرٌ بِأَعيادٍ تُوافيكَ بَعدَهُ","كَما يَنسُقُ النَظمَ المُوالي وَيَرصُفُ",14,"ف",1,0],["بُشراكَ عُقبى صِحَّةٍ","تَجري إِلى غَيرِ اِنتِهاءِ",15,"ا",2,0],["بَشَرٌ ناصِعٌ وَخَدٌّ أَسيلٌ","وَمُحَيّاً طَلقٌ وَطَرفٌ غَضيضُ",16,"ض",1,0],["بُشراكَ دُنيا غَضَّةٌ","في ظِلِّ إِقبالٍ ظَليل",17,"ل",1,0],["بِشُبّانٍ يَرَونَ القَتلَ مَجد","وَشيبٍ في الحُروبِ مُجَرَّبينَا",18,"ن",2,0],["بشعرك يا محمد عزدين","له بعد الإلاه بك اعتصام",19,"م",1,1],["بِشُعثٍ عَلَيها غَيّرَ السَيرُ مِنهُمُ","صَفاءَ وُجوهٍ وَهيَ لَم تَتَشَنَّنِ",20,"ن",1,0],["بشراك إن كان الذي أملته","والكائدون تميزوا أو كادوا",21,"د",3,0],["بِشِبْهِ مَا جَوَّدَتْ نَظْماً قَرِيحَتُهُ","فِي خَيْرِ مَا جَوَّدَتْهُ أَلْسُنُ العَجَمِ",22,"م",1,0],["بِشُعثٍ عَلى أَكوارِ شُدقٍ رَمى بِهِم","رَهاءَ الفَلا نائي الهُمومِ القَواذِفِ",23,"ف",1,0],["بشائرٌ تسمعُ الدنيا وساكنها","إذا دعا باسمك الأعلى مُناديها",24,"ي",3,0],["بشرى كما وَضَحَ الزمانُ وأجملُ","يُغشي سَناها كلَّ من يتأمَّلُ",25,"ل",1,1],["بشرٌ كثير قد نُعوا لمَّا نُعِي","قاضيّ القضاة وغاب في الأطباقِ",26,"ق",1,0],["بشعر لا تزال تنوط منه","بجيد بدائع الدنيا عقودا",27,"د",2,0],["بِشُعثٍ عَلى شُعثٍ مَغاويرَ بِالضُحى","إِذا ثَوَّبَ الداعي لِرَوعٍ وَنَدَّدا",28,"د",2,0],["بِشرٌ أَبو مَروانَ إِن عاسَرتَهُ","عَسِرٌ وَعِندَ يَسارِهِ مَيسورُ",29,"ر",1,0],["بشرَّتُ نفس إذ رأيتك بالغنى","ووثِقْتُ حين سمعت قولَك لي ثِقِ",30,"ق",1,0],["بِشَوقٍ مِنكِ مُعتادِ","وَطَيفٍ غَيرِ مُعتادِ",31,"د",1,0],["بشرْ أمير المعالِي باتِّصالِ هناً","يَحِفُّه السعدُ من أقصى جوانبه",32,"ه",1,1],["بشرنا الفتح بعاداتنا","لديكَ وهي المنّ والمنح",33,"ح",1,1],["بشرني الدهر بقصدٍ به","بدا على أصحابي النجح",34,"ح",1,1],["بشراك إن السرى والعود مبرور","وإن سعيك عند الله مشكور",35,"ر",1,1],["بشرك فيها بارقٌ","يضيء والبرّ المطر",36,"ر",1,0],["بشراك يا وطناً تقادم عهده","بحمى العواصم لا بسفح الأجرع",37,"ع",1,0],["بشهر ربيعٍ قد أتيتُ مهنئاً","وكلّ زماني منه شهر ربيع",38,"ع",1,0],["بشفاعةٍ مقبولةٍ تذر الغنى","خبراً لمبتدإ الرجا في الحال",39,"ل",1,0],["بشِّروا بيته الذي طالَ قدراً","بغلامٍ في العالمين عليم",40,"م",1,0],["بشرى شمائلكم بطلعة كوكبٍ","يومي إليه بالسعود بنانها",41,"ه",2,1],["بَشَّرَ البرقُ بالحيا وسنا الصب","ح بأن يَقلبَ الدُّجى أضواءَ",42,"ا",2,0],["بشيمةٍ منه وكفٍّ آئسه","ما برِحتْ للمكرمات سائسه",43,"س",2,0],["بِشُرَّدٍ تُقْتدى مواقعُها","بألف صينٍ وألف أندلُس",44,"س",1,0],["بشتم إذا بات يصلى به","توهَّم أنِّيَ حرَّقتُهُ",45,"ه",1,0],["بشمتُ بالأمس من خبائثكم","فالخمصُ منكمْ خيرٌ من البَشمِ",46,"م",1,0],["بشعرِكَ عَيْبٌ فاحشٌ غيرَ أَنَّهُ","إذا عُدَّ زَيْن لم يزل لك زائنا",47,"ن",2,0],["بِشَنعاءَ بَينَ الأَصلِ لا يَستَطيعُها","إِذا القَومُ هابوها السَخيفُ المُزَلَّمُ",48,"م",1,0],["بِشاعِرٍ عَبقَرِيٍّ في قَصائِدِهِ","عِطرٌ وَخَمرٌ وَسِحرٌ رائِقٌ عَجَبُ",49,"ب",1,0],["بُشرى نَسَينا كُلَّ شَيءٍ قَبلَها","الناسَ وَالدَولاتَ وَالأَجيالا",50,"ل",2,0],["بُشرايَ هَذا اليَومَ قَد","قامَت عَلى الواشي القِيامَه",51,"م",2,0],["بِشَمسِ الضُحى وَبِبَدرِ الدُجى","عَلى يَمنَتي وَعَلى يَسرَتي",52,"ت",2,0],["بِشَتمي وَعَوراتُهُم أَظهَرُ","أَخافُ الفَلاةَ فَأَرمي بِها",53,"ه",2,0],["بشُعَاعِهِ الخَلاّبِ يَغْمُرُها","بِبَسْماتِ الجَمَالْ",54,"ل",1,0],["بِشَبا سِناني في الطَعا","ن وَحَدّ سَيفي في الضرابْ",55,"ب",1,0],["بشعور الأحياء من كل جيل","وبفقد الشعور في الأموات",56,"ت",1,0],["بشرع هام في النا","س هاشمه وأعجمه",57,"م",2,0],["بَشَّرَ بِالدارِ وَبِال","أَهلِ السُراةَ الغُيَّبا",58,"ب",2,0],["بَشاشَتُهُ لَذَّةٌ في العُيونِ","وَنَغمَتُهُ لَذَّةٌ في الأُذُن",59,"ن",1,0],["بُشرى إِلى الوادي تَهُزُّ نَباتَهُ","هَزَّ الرَبيعِ مَناكِبَ الأَدواحِ",60,"ح",1,0],["بُشرى الإِمامُ مُحَمَّدٌ","بِخِلافَةِ اللَهِ القَدير",61,"ر",1,0],["بُشرى الخِلافَةِ بِالإِما","مِ العادِلِ النَزِهِ الجَدير",61,"ر",1,0],["بَشَرٌ تَصَوَّرَ غايَةً في آيَةٍ","تَنفي الظُنونَ وَتُفسِدُ التَقِيّسا",62,"س",2,0],["بِشِعرِكَ إِنَّهُ ضَمَدٌ","مِنَ الحَقِّ الَّذي وَجَبا",63,"ب",2,0],["بِشَهباءَ مِن ماءِ الحَديدِ كَأَنَّها","جِبالُ شَرَورى أُضرِمَت لِوُقودِ",64,"د",1,0],["بِشرُهُ وَالرُواءُ مِنهُ وَلِلسَي","فِ جَمالانِ حَليُهُ وَصِقالُه",65,"ل",2,0],["بِشاهِقَةِ البَذَّينِ قَبرُ مُحَمَّدٍ","بَعيدٌ عَنِ الباكينَ في كُلِّ مَأتَمِ",66,"م",1,0],["بِشَهباءَ لَم تُشرَب نِفاقاً قُلوبُهُم","شَآمِيَّةٍ تَتلو الكِتابَ المُنَشَّرا",67,"ر",2,0],["بشَمْعٍ أُعِيرَ قُدودَ الرِّماحِ","وسُرْجٍ ذُراها وألوانها",68,"ن",3,0],["بِشَرابٍ يُشبِهُ التُّفْ","فَاحَ طِيباً واحمِرارا",69,"ر",2,0],["بَشَرٌ كمِصباحِ الحَيا وخَلائِقٌ","تَخبو لبَهْجَتِها مصابيحُ الرُّبا",70,"ب",2,0],["بِشُعثٍ مُعَطَّلَةٍ كَالقِسِيِّ","غَزَونَ مَخاضاً وَأُدّينَ حولا",71,"ل",2,0],["بِشَمسٍ بَدَت قَب","لَ رَفعِ الخِبا",72,"ب",2,0],["بِشَمسِ الدينِ لَم تُطِقِ الرَعايا","فَكيفَ وَقَد تَبَدَّلَ بِالنَجيبِ",73,"ب",1,1],["بُشرايَ قَد تَنَبَّهَ لي الطالِعُ السَعيد","قَد زارَني الحَبيبُ فَذا اليَومُ يَومُ عيد",74,"د",1,1],["بِشَمسِ الحُمَيّا","وَبَدرِ المُحَيّا",75,"ي",2,0],["بِشامِخِ الأَنفِ قَوّامٍ عَلى قَدَمٍ","يَشكو الصَبابَةَ عَن أَنفاسِ مَهجورِ",76,"ر",1,0],["بشمالٍ تثني عليها جنوباً","بهبوبٍ يقلقلُ الكورَ زعزَع",77,"ع",1,0],["بُشرى الغَنِيِّ أَبي البَناتِ تَتابَعَت","بُشَراؤُهُ بِالفارِسِ المَولودِ",78,"د",1,0],["بِشُحوبِهِ في المَجدِ أَشرَقَ وَجهُهُ","لا يَستَنيرُ فَعالَ مَن لَم يَشحُبِ",79,"ب",1,0],["بشَّروني لمَّا جربْتُ وقالوا","لا تخفْ قد لبستَ ثوباً مدنَّرْ",80,"ر",1,1],["بِشَتيتٍ نَبتُهُ رَتِلِ","طَيِّبِ الأَنيابِ وَالطَعمِ",81,"م",1,0],["بُشرى كَما أَسفَرَ وَجهُ الصَباح","وَاِستَشرَفَ الرائِدُ بَرقاً أَلاح",82,"ح",1,1],["بُشرى تَهادى في وِشاحٍ مُذهَبٍ","قَلِقٍ وَتَسحَبُ مِن ذُيولٍ جونِ",83,"ن",1,0],["بِشافِيَةِ الأَحزانِ حَيَّجَ شَوقَها","مُجامَعَةُ الأُلّافِ ثُمَّ زِيالُها",84,"ل",3,0],["بَشِّرْ شُعوبَ المسلمينَ بطائرٍ","سَعْدٍ فما للنّحسِ منكَ ذمامُ",85,"م",1,0],["بَشِّرْ شُعوبَ المسلمينَ بنهضةٍ","تَدَعُ الشُّعوبَ النّاهضينَ حَيارى",86,"ر",2,0],["بُشرى التَماثيلِ إِنَّ القَومَ ما اِجتَمَعوا","إِلّا عَلى صَنَمٍ أَو حَولَ تِمثالِ",87,"ل",1,0],["بَشِّروا يا قَومُ إِنّي لَأَرى","في مَصيرِ النيلِ رَأيَ المُنذِرينْ",88,"ن",1,0],["بَشِّر بِأَصدَقِ أَنباءِ المُنى أُمَماً","أَنحى الزَمانُ عَلَيها بِالأَباطيلِ",89,"ل",1,0],["بَشيرُ الغَيبِ يُلمَحُ في يَدَيهِ","كِتابٌ لا يَضِلُّ وَلا يَخونُ",90,"ن",1,0],["بَشِّرِالناسَ بِعَهدٍ صالِحٍ","يَحسُدُ الآخَرَ فيهِ الأَوَّلُ",91,"ل",1,0],["بُشرى الحَجيجِ إِذا سارَ البُخارُ بِهِ","غَداً فَأَنساهُ سَيرَ الأَينُقِ النُجُبِ",92,"ب",1,0],["بُشرى المَشارِقِ إِنَّ البَعثَ مُدرِكُها","وَبارَكَ اللَهُ في النُعمى الَّتي وَهَبا",93,"ب",2,0],["بَشيرُ بنُ سعدٍ يا عُيينَةُ قادِمٌ","فهل أنتَ بالجمعِ المضلَّلِ راجِعُ",94,"ع",1,0],["بَشِيرُ بنُ سعدٍ والذين أصابَهم","أذاكم رَمَوْكُمْ بالقُرُومِ المصاعِبِ",95,"ب",1,0],["بَشِّرْ حُم