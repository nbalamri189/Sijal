l","الطويل"],[410,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[413,"لا زلت يا ملك الإسلام في نعم","https://www.aldiwan.net/poem31697.html","عموديه"],[420,"لله منزل جابر من منزل","https://www.aldiwan.net/poem54076.html","الكامل"],[420,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[420,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[420,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[436,"ترددنا الى الدار","https://www.aldiwan.net/poem12642.html","الهزج"],[443,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[443,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[455,"سقت مستهلات الحيا المتضاعف","https://www.aldiwan.net/poem13843.html","الطويل"],[456,"أهذا هو الفنان نسمعه فنا","https://www.aldiwan.net/poem61703.html","الطويل"],[461,"بكرت عليه ضلة تعذلينه","https://www.aldiwan.net/poem55848.html","الطويل"],[461,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[461,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[461,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[461,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[461,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[464,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[464,"تحوي القلوب له مكاسر لطفه","https://www.aldiwan.net/poem16147.html","الكامل"],[467,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[467,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[467,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[467,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[473,"وأوقدت ناري باليفاع فلم تدع","https://www.aldiwan.net/poem4659.html","الطويل"],[480,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[503,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[517,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[518,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[565,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[566,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[566,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[570,"ولها من الأوتار حين تجسها","https://www.aldiwan.net/poem69596.html","الكامل"],[573,"أخي والله خير من أخيكم","https://www.aldiwan.net/poem59471.html","الوافر"],[858,"","https://poetry.dctabudhabi.ae/diwan/poem/95961","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22544","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/13","الوافر"],[1047,"","https://poetry.dctabudhabi.ae/diwan/poem/29389","البسيط"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18994","الطويل"],[1140,"","https://poetry.dctabudhabi.ae/diwan/poem/29467","الطويل"],[390,"أَلا حَيِّيا الدّارَ المُحيلَ رُسُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=4656",""]],"verses":[["تُرَدِّدُ ما لَها مِمَّن يَعيها","سِوى اَلإِطراقِ مِنها وَالوُجومِ",0,"م",1,0],["تَرُدُّ سِهامي الحادِثاتُ طَوائِشاً","وَفي قَوسِ عَزمي لَو تَبَوَّعَ مَنزِعُ",1,"ع",1,0],["تَرُدُّ يَدَيْهِ عنْ وِشاحِكِ عِفّةٌ","وعِرْضٌ صَقيلٌ لا يُزَنُّ بأدْناسِ",2,"س",1,0],["تَردي كما نَسَلَتْ سَراحينُ الغَضى","قُبْلَ العُيونِ بجنّةٍ منْ عَبْقَرِ",3,"ر",1,0],["تَرُدُّ شُعاعَ الشّمْسِ عنهمْ أسِنّةٌ","تَذوبُ على أطرافِهِنَّ أياتُها",4,"ت",3,0],["ترَدَّدَ فيهِ الظَّلْمُ حتّى كأنّهُ","على الشَّيْمِ مِن ظَنّي إذا ذِيقَ إسْفِنْطُ",5,"ط",1,0],["تُرَدُّ على أعقابِهنَّ دُموعُنا","وقد وَجدَتْ لولا الوُشاةُ مَجاريا",6,"ي",2,0],["تَردُ الأُجاجَ مرَنَّقاً ولَطالَما","وردَتْ بأكْنافِ العُذَيْبِ بَرودا",7,"د",2,0],["تَرُدُّ مَعطوفَ الضَجيعِ عَلى","غَيلٍ كَأَنَّ الوَشمَ فيهِ خِلَل",8,"ل",1,0],["تَرَدَّفنَ خَشباءَ القَرينِ وَقَد بَدا","لَهُنَّ إِلى أَهلِ السِتارِ زِيالُها",9,"ل",3,0],["تَرَدَّفنَ خُرشوماً تَرَكنَ بِمَتنِهِ","كُدوحاً كَآثارِ الفُؤوسِ القَواطِعِ",10,"ع",1,0],["تَرَدَيتَ مِن أَلوانِ نورٍ كَأَنَّها","زَرابِيُّ وَاِنهَلَّت عَلَيكَ الرَواعِدُ",11,"د",1,0],["تردّده والصمت في الليل سائد","بلحن ضئيل في الدُجُنَّة مُبهَم",12,"م",1,0],["تَرَدَّيتَ في زَوراءَ يَرمي بِمَن هَوى","رُؤوسَ الحَوامي جولَها المُتَطاوِحُ",13,"ح",1,0],["تَرَدَّينا المَحامِلَ قَد عَلِمتُم","بِذي نَجَبٍ وَكُسوَتُنا الحَديدُ",14,"د",1,0],["تَرُدُّ عَلَيهِم لَيلَةٌ أَهلَكَتهُمُ","وَعامٌ وَعامٌ يَتبَعُ العامَ قابِلُ",15,"ل",1,0],["تَرُدُّ المَرءَ قافِلَةً يَداهُ","بِعامِلِ صَعدَةٍ وَالنَحرُ دامي",16,"م",2,0],["تُرَدِدُ بالنَّابَينِ بَعدَ حَنِينِها","صَرِيفَاً كما رَدَّ الأغانيَ أخطَبُ",17,"ب",1,0],["تَرَ دارَ وادي عَينِ قا","صِرَ مَنزِلاً رَحباً مُطِلّا",18,"ل",2,0],["تَرِدُ الدُموعُ لِما تُجِنُّ ضُلوعُهُ","تَترى إِلى وَجَناتِهِ أَو نَحرِهِ",19,"ر",2,0],["تردُّ الرَّدى عنكَ المحبُّون فدية","تكون لهم في التربِ مجداً مؤيَّدا",20,"د",2,0],["تردي وأنتَ تحبها","وكذا تكون الساحره",21,"ر",2,0],["تردّ عن عرضه الأنقى فتبصرها","محمرَّة من دما التبر الذي هرَقه",22,"ق",2,0],["تردَّدَ في أفقِ الوزارة شخصه","كما ردُّدت شهب السماء المنازل",23,"ل",1,0],["تردُّ صفاء العيش مثلَ صفائها","وتكشفُ عن ذي الكرب غاشية الكربِ",24,"ب",1,0],["تردَّى عليها حَمْدَ حُرٍّ ولم تكن","لتكمُلَ إلا وهو بالحمد مُرتدِ",25,"د",1,0],["تردَّى مُضيعُ الماءِ والمال في لظى","وَغَالتهُ من أفعالِه الشنعِ أغوالُ",26,"ل",1,0],["ترد له غصنَ الشباب وقد ذوى","رطيباً كغصن البانة المتمايلِ",27,"ل",1,0],["تَرُدُّ عَلى الظِمءِ الطَويلِ نِطافَها","إِذا شَوَتِ الجَوزاءُ وُرقَ الجَنادِبِ",28,"ب",1,0],["تَرِدُ المَناهِل وَهيَ ماءٌ سائِغٌ","وَتَعودُ عَنها وَالمَناهِلُ نارُ",29,"ر",1,0],["تَرُدُّنا عَنهُ أَمواجٌ يَلوذُ بِها","سَميكَةٌ كَالنَجيعِ اليابِسِ القَني",30,"ن",2,0],["تَرَدَّدَ ظَنُّ الناسِ فينا وَأَكثَروا","أَقاويلَ مِنها ما يَطيبُ وَيَخبُثُ",31,"ث",1,0],["تَرُدّ السِنان إِذا أَمَّها","شَبا حَدِّهِ عَن قَويم السَنَنْ",32,"ن",1,0],["تردده في خير لحن سمعته","وتنشده شعراً على خير انشاد",33,"د",1,0],["تردّ على الليالي كل سهم","ولا يرددن سهمك حين ترمى",34,"م",2,0],["تَرُدُّ عَنكَ يَداهُ كُلَّ عادِيَةٍ","إِنساً يَعِثنَ فَساداً أَو شَياطينا",35,"ن",2,0],["تَرُدُّ المِياهَ إِلى حَدِّها","وَتُبلي جِبالَ الصَفا وَالحَديد",36,"د",1,0],["تَرِدُ الطِعانَ المُرَّ عَن فُرسانِهِ","وَتُنازِلُ الأَبطالَ عَن أَبطالِهِ",37,"ل",2,0],["تَرُدُّ عَنهُ قَنا الفُرسانِ سابِغَةٌ","صَوبُ الأَسِنَّةِ في أَثنائِها دِيَمُ",38,"م",1,0],["تُردي عدوَّاً كاشِحاً وتُبِيدُهُ","وتُنيلُ معتفياً وتكشِفُ مُعْضِلا",39,"ل",2,0],["تَرُدُّ السُيوفُ الماضِياتُ قَضاءَها","إِلى قَلَمٍ يومي لَها أَينَ تَضرِبُ",40,"ب",1,0],["تُرَدُّ شَذاةُ الدَهرِ مِنهُ بِمُسرِعٍ","إِلى المَجدِ لا الواني وَلا المُتَقاعِسِ",41,"س",1,0],["تَرَدَّدَتِ الأَيّامَ فيهِ وَأَقبَلَت","قِباحُ اللَيالي وَهيَ بادِيَةُ الحُسنِ",42,"ن",1,0],["تُرَدِّدُني بَينَ المَدينَةِ وَالَّتي","إِلَيها قُلوبُ الناسِ يَهوي مُنيبُها",43,"ب",3,0],["تُرَدُّ إِلى شُعاعَةَ حينَ يَنمي","وَلا يَنمى إِلى حَسَبٍ كَريمِ",44,"م",1,0],["ترد اليد بالخيب","ة عن أقربها مجنى",45,"ن",2,0],["تردَّها حُلَّةً مفوَّفَةً","تخلُبُ بالحُسنِ من تَردّاها",46,"ا",3,0],["ترَدَّيتُه حتَّى رأَيتُ رِداءَهُ","يَرِقُّ بمنشورٍ من الصبحِ لم يُطْوَ",47,"و",1,0],["تَردي عَلى مُطمَئِنّاتٍ مَواطِئُها","تَكادُ مِن وَقعِهِنَّ الأَرضُ تَنصَدِعُ",48,"ع",1,0],["تَرِدهُ وَلَمّا يُخرِجِ السَوطُ شَأوَها","مَروحاً جَنوحَ اللَيلِ ناجِيَةَ الغَدِ",49,"د",1,0],["تَرَدَّ رِداءَ الصَبرِ عِندَ النَوائِبِ","تَنَل مِن جَميلِ الصَبرِ حُسنَ العَواقِبِ",50,"ب",1,1],["تُردي صُروفَ الدَهرِ وَهيَ سَواكِنٌ","إِنَّ السُكونَ لَها مِنَ الحَرَكاتِ",51,"ت",1,0],["تَردَّدَ واستأنى لوعدٍ وموثقٍ","وأدبرَ مخنوقاً وقد غُصَّ بالوعدِ",52,"د",1,0],["تُرَدَّد بالتكريهِ رُسْلُ نواظري","ومن شيمَ الإِنصافِ أن تكرَم الرّسلُ",53,"ل",1,0],["تردّ الرّدى عن ذِمرِها فكأنّها","تَذَرّعُ من سُخْطِ الأسِنّةِ بالعفوِ",54,"و",1,0],["تُرْدي عُداةَ اللَّه منك إشارةٌ","والسّقْطُ يحرقُ كثرَةَ الآجامِ",55,"م",1,0],["