{"poems":[[46,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[107,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[54,"يا قلب ويحك خنتني وفعلتها","https://www.aldiwan.net/poem27202.html","الكامل"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[107,"يا سوء ما حمل البريد ويا لها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54968&r=&rc=138",""],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[228,"في ليلة حالكة كالهموم","https://www.aldiwan.net/poem39701.html","السريع"],[234,"يأيها المعشوق لا فارقت","https://www.aldiwan.net/poem50918.html","السريع"],[257,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[309,"يا نفس هذا الذي تأتينه عجب","https://www.aldiwan.net/poem16775.html","البسيط"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[354,"هم رغبتي فلماذا في قد زهدوا","https://www.aldiwan.net/poem15620.html","البسيط"],[370,"أبني زياد أنتم في قومكم","https://www.aldiwan.net/poem44533.html","الكامل"],[435,"سعد العلياء جلا ثغرا","https://www.aldiwan.net/poem40840.html","المتدارك"],[463,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[545,"واستيقنت أنها مثابرة","https://www.aldiwan.net/poem56741.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48629","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96726","الكامل"],[1075,"","https://poetry.dctabudhabi.ae/diwan/poem/200324","الكامل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29668","الكامل"],[1347,"","https://poetry.dctabudhabi.ae/diwan/poem/144473","البسيط"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45489","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202988","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3813,"","https://poetry.dctabudhabi.ae/diwan/poem/105688","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44637","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36632","الدوبيت"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124119","الرجز"],[4767,"مقام الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=179965",""],[4767,"لواء العدل","https://www.poetsgate.com/ViewPoem.aspx?id=180688",""],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[4927,"ثلاث ثورات، والقادم أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=80803",""],[5030,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=215790",""],[5111,"قمَرانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212125",""],[5121,"نُزْهَة","https://www.poetsgate.com/ViewPoem.aspx?id=49545",""],[5273,"الريم","https://www.poetsgate.com/ViewPoem.aspx?id=179936",""],[5402,"مليكة الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=215511",""],[5452,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=119185",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""]],"verses":[["وَاِستَيقَنوا إِذ جاشَ بَحرُكَ وَاِرتَقى","ذاكَ الزَئيرُ وَعَزَّ ذاكَ الزارُ",0,"ر",1,0],["وَاِستَيقَنَت أَنَّ الأُلى نُكِبَت بِهِم","كانوا أَبَرَّ خَلائِفاً وَطِباعا",1,"ع",2,0],["وَاِستَيقَظوا حَقّاً بِها وَكَأَنَّهُم","حَلَموا بِها في النَومِ لَمّا قُلتَها",2,"ت",3,0],["واستيقنوا ان خلقا لا يجيء به","وانه خارج عن طاقة الفطر",3,"ر",1,0],["واستيأسوُا منها ، ومن مُتخشِّبٍ","عَنتَاً كصِلِّ الرّملِ يَنْفُخ غاضبا",4,"ب",2,0],["واستيقنت أن الألى نكبت بهم","كانوا أبر خلائقاً وطباعا",5,"ع",2,0],["وَاِستَيقَنَت أَنَّ كُلَّ المُلكِ مُنتَزَعٌ","وَلَو تَمَكَّثَ في أَربابِهِ حِينا",6,"ن",2,0],["وَاِستَيقَظَ الشاعِرُ من سَكرَتِه","وَحَوَّلَ العَينَ الى شَمعَتِه",7,"ه",1,0],["واستيأس الآس من المُلْتَقى","فَهْوَ من الرِعدة خفّاق",8,"ق",1,0],["واِستَيقظوا وَأَرادَ اللَهُ غَفلَتُكُم","لِيَنفُذَ القَدرُ المَحتومُ في الأَزلِ",9,"ل",1,0],["واستيقني أن بعد الموت مجتمعاً","للعالمين فتأتي العجم والعرب",10,"ب",1,0],["واستيقنوا أن لا إله وخالقاً","سوى اللَه جل اللَه ربي وفاطري",11,"ر",2,0],["وَاِستَيقَظا لَوعَتي مِن بَعدِ رَقدَتِها","حَتّى إِذا قامَ وَجدي فيهِمُ قَعَدوا",12,"د",3,0],["واستيقنوا منّا بوَقعٍ صادقٍ","هَرَبوا وليس أوانَ ساعةِ مَهرَبِ",13,"ب",1,0],["واستيقظ أعين نرجسه","ترعى محياه بغير كرى",14,"ر",2,0],["واستيقظوا للتِّراتِ لمّا","نامت عيونٌ على الذُّحولِ",15,"ل",1,0],["وَاِستَيقَنَت أَنَّها مُثابِرَةٌ","وَأَنَّها بِالنَجاحِ مُتَّحَفَهْ",16,"ه",1,1],["واستيقظت وهي لا تدري بما صنعت","ولو درت فضلت من خوفها الهربا",17,"ب",2,0],["وَاِستيقنت منّي الرحيلَ غديّةً","مِن بعدِ ما ودّعتها بسلامِ",18,"م",1,0],["واستيق من تيم خرائد أنس","من ثيب أو كاعب كالجؤذر",19,"ر",1,0],["وَاِستَيقظُوا فَالسَيلُ قَد بَلَغَ الرُبى","وَعَلَت غَوارِبُهُ عَلى القُريانِ",20,"ن",1,0],["واستيقظ الدهر حرباً بعد رقدته","سلماً علي وأيام الفتى دول",21,"ل",1,0],["واستيقظ الصحب لحين يقظتي","وأدوا المفروض مع فريضتي",22,"ي",1,0],["وَاِستَيقَنَت أَنَّ الصَليف مُنعَسِف","كَأَنَّها غَلثى من الرَخم تَدِف",23,"ف",1,0],["وَاستيقَن القَوم البوار كَأَن اس","رافيل جاءَ وَفي يَديهِ الصور",24,"ر",1,0],["وَاستيقنوا بِالمَوت نيل مرامهم","فَالكل مِنهم ضاحك مَسرور",24,"ر",1,0],["واستيقظ العقل بما قد رأى","واتحد الرائي ومرآه",25,"ا",2,0],["وإِستئصالُ إِسرائيلَ قِدماً","وإِبني عاليَ الحِبرِ الهُمَامِ",26,"م",1,0],["واستيقضوا من سبات الجهل واجتنبوا","أهل الجهالة في شام وفي يمن",27,"ن",1,0],["وأَستِيُوخا أُمَّهُ من إِيفِرس","سَبى أَبُوهُ في ضِفَافِ سِلَّيس",28,"س",1,0],["وَاَستيقِنوا يَوم الحِساب لِأَنَّها","في وَجهِها النيران وَالجَناتُ",29,"ت",1,0],["واستَيسر خوضُنا دُجى الإِظلامِ","جِئناكَ عَلى الرؤوسِ كالأَقلامِ",30,"م",1,0],["واستيعذ من شرور الإنس","والجن والهوى وشر النفس",31,"س",1,0],["واستيقظت والنور ملءُ جفونِها","لو لا الضياءُ لسيطر الإغفاء",32,"ا",2,0],["واستيقظت تلك الفروع فراعها","أن لم يكن فيما تريد حصول",33,"ل",1,0],["وَاسْتَيْقَظَتْ أَبْهَى الطُّيُوْرِ، وَلَحَّنَتْ","أَلْحَاْنَهَاْ، وَتَرَنَّمَتْ لَمَّاْ سَرَىْ",34,"ر",2,0],["وَاسْتَيْقَظَ الشُّرَفَاْءُ بَعْدَ سُبَاْتِهِمْ","مِنْ نَوْمِهِمْ، وَاسْتَنْفَرَ الْمُخْتَاْرُ",35,"ر",1,0],["واستيأسوا لكنّ موسى قالها:","\"كلا..\" بإيمان كوضحِ نهارِ",36,"ر",1,0],["وَاسْتَيْقَظَتْ أيَّامُهَا وَتَهَوَّمَتْ","كَالسَّائِحَاتِ ..تَجّمُّلا وَتَنَوُّعَا",37,"ع",2,0],["وَاسْتَيْقَظَ الْغَيْمُ فَوْقِي وَالضِّيَاءُ غَفَى","وَالدِّيِمَةُ ارْتَعَشَتْ فَانْكَبَّ مَا فِيِهَا",38,"ي",3,0],["واستيقظَ الضَّوءُ المُسافرُ في دمي","وَغَفا على شَفَةِ القصيدِ سُؤالُ",39,"ل",1,0],["واستيقظ القلب الصغير كأنه","وجد الخشوع بأجمل الايات",40,"ت",1,0],["واستيقنت مهج أن لا خيار لها","إلا اتّباع رسول دينه انتصرا",41,"ر",2,0],["واستيقظت من نومها نشوةٌ","أخمدها بردُ الشتاءِ القريب",42,"ب",1,0],["واستيقظ الشبح المنسيُّ في خلدي","شوطا يثير غباري كيف أنهيها",43,"ي",3,0]]}