{"poems":[[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[57,"عاص مسيء مذنب متعتب","https://www.aldiwan.net/poem26508.html","الكامل"],[88,"حولوا النيل واحجبوا الضوء عنا","https://www.aldiwan.net/poem10516.html","الخفيف"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"عاصيت كل هوى مطاع","https://www.aldiwan.net/poem65391.html","مجزوء الكامل"],[91,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[87,"بات المعنى والدجى يبتلى","https://www.aldiwan.net/poem7887.html","السريع"],[99,"فيم الغدو غداً وأين رواحي","https://www.aldiwan.net/poem24401.html","الكامل"],[71,"قل للذي ما تأدب","https://www.aldiwan.net/poem29159.html","عموديه"],[42,"قولها أحسن شيء","https://www.aldiwan.net/poem42323.html","مجزوء الرمل"],[54,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[133,"صور تلوح لخاطر المعمود","https://www.aldiwan.net/poem67437.html","الكامل"],[234,"يا دهر كم يشتد حربك","https://www.aldiwan.net/poem51209.html","مجزوء الكامل"],[333,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[463,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[466,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[466,"يا بهاء الدهر والدي","https://www.aldiwan.net/poem15369.html","مجزوء الرمل"],[466,"يا راكب الهوجاء لولا البرى","https://www.aldiwan.net/poem15376.html","السريع"],[505,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[556,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[558,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[558,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122664","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104576","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96720","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64669","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89720","السريع"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110341","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27738","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109404","الكامل"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22595","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58362","السريع"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79717","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65116","الكامل"],[3143,"","https://poetry.dctabudhabi.ae/diwan/poem/144415","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66323","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91301","الرمل"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36022","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131051",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133219","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131654",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54393","الكامل"],[4733,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=191255",""],[4767,"الجروح النازفة","https://www.poetsgate.com/ViewPoem.aspx?id=179252",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4767,"خروج الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199425",""],[4862,"عاصفة الحزم هي الأرفع","https://www.poetsgate.com/ViewPoem.aspx?id=177023",""],[5074,"الضَّيغم الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=153941",""],[5198,"ضحكتك حفلة","https://www.poetsgate.com/ViewPoem.aspx?id=135389",""],[5232,"شموخ الأرز","https://www.poetsgate.com/ViewPoem.aspx?id=212986",""],[5273,"سحر حماة","https://www.poetsgate.com/ViewPoem.aspx?id=181588",""],[5431,"قصيدة تفكيكية (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215499",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5956,"الطائر الثرثار","https://www.poetsgate.com/ViewPoem.aspx?id=213433",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""]],"verses":[["عاصِيٍ ناصِحَهُ الأَق","رَبَ وُدّاً وَرَفيقَه",0,"ق",2,0],["عاصٍ مُسيءٌ مُذنِبٌ مُتَعَتِّبٌ","أَخفى رِضاهُ وَأَظهَرَ الغَضَبا",1,"ب",2,1],["عاصِفٌ صانَ مُلكَكُم وَحَماكُم","وَكَفاكُم بِالأَمسِ خَطباً جَسيما",2,"م",2,0],["عاصَى العزاءُ عن الشبا","ب فطاوعَ الدمعُ الغزيرُ",3,"ر",1,0],["عاصيتُ كل هوى مطاعِ","وملكت قلبي بالزماعِ",4,"ع",1,1],["عاص فلم يصل في","حياته أو يصم",5,"م",1,0],["عاصمة النيل أزدهِى وأنجلي","واتخِذي اليوم صنوف الحلى",6,"ل",2,0],["عاصيتُ فيه الداء وهو مغالِب","عاصٍ على الهادينَ والنُصَّاحِ",7,"ح",1,0],["عاصي يزيد الشريعة","يدعوه ثوراً ويصبغه",8,"ه",1,0],["عاصِباً بِالنَبتِ زُرعاً","وَمَعَ الزَرعِ قُضُوبا",9,"ب",2,0],["عاصِفُ السَيرِ إِذا","ما بِهِ السَيرُ غَلا",10,"ل",2,0],["عاصفٌ عاتٍ تمنّيت له","هَدأةً أينَ له ما تطلبين",11,"ن",1,0],["عاصِفٌ يَرتَمي وَبَحرٌ يُغيرُ","أَنا بِاللَهِ مِنهُما مُستَجيرُ",12,"ر",1,1],["عاصفٌ مر فجلّى وانجلى","بدت الشمسُ به أبهى سناء",13,"ا",2,0],["عاصف باده الرّبى ودخان","أين منك الشّقيق والأقحوان",14,"ن",1,1],["عاصِيك كَوثَرُنا لنا في وِردِهِ","طَعمُ الخُلودِ ونَكهةٌ من شَهدِه",15,"ه",1,0],["عاصيْتَنى حتى لقد","أوهمَتني أني أحُبك",16,"ك",1,0],["عاصفٌ إثر عاصف ونجوم","ورجوم تغلى على الأحقاب",17,"ب",1,0],["عاصيتُ حكم العاذلين وسامني","فأطعتُه حكمَ العسوف الجائرِ",18,"ر",1,0],["عاصفٌ بالمُلوكِ لا هُجْنةٌ في","هِ ولكن قَبولهُ والجَدُّ",19,"د",1,0],["عاصفاتُ الزَّعْزَعِ والهوُ","جُ وأطْوادُ الجبالِ",20,"ل",1,0],["عاصِفَةٌ ايْسَرُ اِرقالِها","يحسدهُ الهَيْقُ وأمُّ الرِّئالْ",21,"ل",1,0],["عاصٍ يصدُّ وطائعٌ بيدِ الرضا","غيباً يمدُّ للجميع موائدُ",22,"د",1,0],["عاصراً فكرَهُ عَصراً","في يَتيماتِ اللالي",23,"ي",1,0],["عاصي الوشاة وَزارَني متستِّراً","باللّيل بعد هجوع طرف السّاهرِ",24,"ر",1,0],["عاصى الشَبابَ فَراحَ غَيرَ مُفَنَّدِ","وَأَقامَ بَينَ عَزيمَةٍ وَتَجَلُّدِ",25,"د",1,1],["عاصى العَزاءَ غَداةَ البَينِ مُنهَمِلٌ","مِنَ الدُموعِ جَرى في إِثرِ مُنهَمِلِ",26,"ل",1,0],["عاصيك عاصي اللهَ في أحوالِهِ","وَمُطيعُ أمرِكَ في الزَّمانِ مُطيعُهُ",27,"ع",2,0],["عاصيتُ فيهِ ذوي الحِجا مِن أُسرتي","وأطعتُ فيهِ مكارمي وتودُّدي",28,"د",2,0],["عاصَتهُ في صيرانهِ صيرانُه","أبداً ومِن آرامهِ آرامُهُ",29,"م",2,0],["عاصانِيَ الوَفْدُ وانقادَتُ شَكائِمُها","مُطِيعةً أَمرَ إِدْلاجي وَتأَوبي",30,"ب",2,0],["عاصفاتُ الرياحِ بالأمرِ تجرى","فتميدُ الأغصانُ بالأغصانِ",31,"ن",1,0],["عاص الهَوى إِن الهَوى مركب","يَصعب بَعد اللينِ مِنهُ الذَليل",32,"ل",1,1],["عاصيتها وعففت عن لذاتها","ومضيت تطلب في سواها مطلبا",33,"ب",2,0],["عاصمته من كلِّ سوءٍ كما","قد عصم الساعدُ بالقلب",34,"ب",1,0],["عاصي هواه ماله دون الذي","سواه فتنة خلقه من عاصمِ",35,"م",1,0],["عاصِمٌ يا اِبنَ عَقيلٍ","أَفسَحَ العالَمِ باعا",36,"ع",2,1],["عاصفاً زعزَعاً","يقلَعُ أوتاداً وأطناباً",37,"ب",2,0],["عاصف الحب لم يدع لي برا","أرتجيه وبالهوي أضناني",38,"ن",2,0],["عاصتك قومٌ بالأسُود تشبّهت","أرأيت قطّا في القطوط استأسدا",39,"د",2,0],["عاصرتهم فبذذتهم","وشأوتهم طراً بصبرك",40,"ك",1,0],["عاصم لو رآك للذكر تتلو","لغدا في الملا لإثرك تالي",41,"ل",2,0],["عاصمَ الآدابِ وَضّاحَ البَيانْ","حازمَ الأَفكارِ سحّارَ اللسانْ",42,"ن",1,1],["عاصٍ عَلى المَلامِ وَالتَأنيبِ","فَاِشتَرَفَت مِن جانِبَي كَئيبِ",43,"ب",1,0],["عاص العذول إذا سبتك الغيد","وسطت عليك نواظر وقدود",44,"د",1,1],["عاص أتاك يمد الكف مفتقرا","ووجههُ عن سواك الدهر مصروفُ",45,"ف",1,1],["عاصِفاتٍ عَلَيهِ تَعتَنِقُ المَو","جَ وَتَعدو لِغَيرِ ما مِعراجِ",46,"ج",1,0],["عاصر شنب ما نقل سبله لذيب","وعنفقة مثل راس القوبره",47,"ر",2,0],["عاصيكمُ لم يقضِ إلاّ نحبَهُ","من دهرهِ ومطيعكم إلاّ الوَطَرْ",48,"ر",1,0],["عاصمةٌ من مهدِها ولم تزل","تَبَسَّمَ الدَّهرُ لها أو أدبرَا",49,"ر",2,0],["عاصفةٌ كم نسفتْ من الطريق الذي","مرت به ولَم تزل هائجةً زاحفة",50,"ف",2,0],["عاصٍ إليك إلىَّ عاصٍ لن يرى","يوم الحساب سوى الجحيم اللاسعة",51,"ع",2,0],["عاصفٌ هبَّت بأمرِ ال","لهِ والأمر تنزَّل",52,"ل",1,0],["عاصفة الحزم هي الأرفع","عاصفة العزة فلتقلع",53,"ع",1,1],["عاصفةٌ هبت منجدةً","لليمن الحرّ لكي يرجع",53,"ع",1,0],["عَاصِفٌ يَقْحَمُ الجَحِيْمَ وَ يَدْوِي","كَهَزِيْمِ الرُّعُوْدِ حَيْثُ البَلاءُ",54,"ا",2,0],["عاصف هواه يتل قلبي يتلّه","الشوق له موجود ماراح ماراح",55,"ح",1,0],["عاصي وتختصرُ الدنيا مواسمُهُ","من زنبقِ العطرِ شلالي وريحاني",56,"ن",2,0],["عاصي مَنِ النغمُ المجهولُ نادَمَهُ؟","حتى الجنونِ وكان الفنُّ رحباني",56,"ن",2,0],["عَاصٍ ولكنْ ذنبُهُ كَفَضيلةٍ","يُغْري الذينَ عَنِ الصَّبابَةِ تابوا",57,"ب",3,0],["عاصٍ كأنّ به مجرى لأدمعنا","دهرا تُلازمه ..عن وقفها استعصى",58,"ص",2,0],["عاصرَ الزيتِ في ابتهاجٍ، أَبِنْ لي","غير ذا الزيت ما تكونُ العصارة؟!",59,"ر",2,0],["عاصرتُه زمناً وغصتُ بكُنْهِه","وأنا سعيدٌ أنه عني انقلعْ",60,"ع",1,0],["عاْصفٌ مَسْعُوْرُ يَهْوَىْ دَمِعَتِيٍ","مِثْلُ طِفْلٍ عَاْشِقٌ شُرْبَ الْلَبَنْ",61,"ن",1,0],["عاصِفَاتٌ دُمُوعِي؛ لَيسَ لِي ذَنبٌ","ذَنبُها- مُقلَتِي - كَم أَدمَنَتْ دَمعا",62,"ع",2,0]]}