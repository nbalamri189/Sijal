{"poems":[[65,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[65,"ألا ليت شعري هل أرى الدور بالحمى","https://www.aldiwan.net/poem45807.html","الطويل"],[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[79,"جلا الحق قلبي حتى أنارا","https://www.aldiwan.net/poem36501.html","المتقارب"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[90,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[90,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"أيا ثقفي أراك الذي","https://www.aldiwan.net/poem11456.html","المتقارب"],[53,"قدمت قدوم البدر بيت سعوده","https://www.aldiwan.net/poem61823.html","الطويل"],[72,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[47,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[33,"لقد حببت نعم إلي بوجهها","https://www.aldiwan.net/poem42251.html","الطويل"],[33,"ألا يا حبذا نجد","https://www.aldiwan.net/poem42468.html","الهزج"],[76,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[35,"ألا فاسأل الركبان هل سقي الحمى","https://www.aldiwan.net/poem25709.html","الطويل"],[35,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[35,"بنفسي من لا بد لي أن أهاجره","https://www.aldiwan.net/poem25922.html","الطويل"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[33,"لقد حببتْ نعمٌ إليها بوجهها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18934&r=&rc=197",""],[119,"بأية حجة منع الوصالا","https://www.aldiwan.net/poem40620.html","عموديه"],[151,"أبى القلب أن ينسى المعاهد من برسا","https://www.aldiwan.net/poem47636.html","الطويل"],[173,"صعود العلا إلا عليك حرام","https://www.aldiwan.net/poem1666.html",""],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[287,"بكم قلبي عليل ما يبل","https://www.aldiwan.net/poem32664.html","الوافر"],[355,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[371,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[376,"ببعض الدمى قام بعض الفتن","https://www.aldiwan.net/poem57084.html","البسيط"],[463,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[505,"واد أبو البركات يوما يجتلي","https://www.aldiwan.net/poem37789.html","الكامل"],[505,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[511,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[556,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[556,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[556,"ألم تسأل الطلل الدارسا","https://www.aldiwan.net/poem47752.html","المتقارب"],[556,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[563,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37986","الطويل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99987","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67842","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1194,"","https://poetry.dctabudhabi.ae/diwan/poem/206180","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64716","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11175","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69423","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28035","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27390","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129952","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94019","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94269","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58330","الطويل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102361","الطويل"],[3196,"","https://poetry.dctabudhabi.ae/diwan/poem/204325","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36768","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135500","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102754","الطويل"],[4755,"دَعَا الشِّعرُ يا قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183641",""],[4929,"وضوحٌ في طريق المآلات","https://www.poetsgate.com/ViewPoem.aspx?id=202053",""],[1194,"ألم تر أن النفس يرديك شرها","https://www.poetsgate.com/ViewPoem.aspx?id=91922",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"نورس الصوبين","https://www.poetsgate.com/ViewPoem.aspx?id=186441",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"أهاجك رسم بالديار الدوائر","https://www.poetsgate.com/ViewPoem.aspx?id=128849",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5550,"يحبُّ الحرُّ","https://www.poetsgate.com/ViewPoem.aspx?id=211130",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"الوسواس الخناس يحطِّم كبارَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192093",""],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""]],"verses":[["وَمن أَجلِها أُبدي الخُضوعَ لِقَومِها","وَأَمحَضُهُم وُدِّي وَأُوطِئُهُم خَدّي",0,"د",2,0],["وَمِن أَجلِها أُبدي خُضوعاً وَأَمتَري","دُموعاً وَأَطوي رَيِّقَ العُمرِ باكِيا",1,"ي",2,0],["ومُناجِزٌ جعلَ الأريكةَ صهْوَةً","عرَبيّةً والمُتّكا القَرْبوسا",2,"س",2,0],["ومنْ أجْلِ خمْرِكَ جُبْنا الفَلا","وخُضْنا الدُّجى وقطَعْنا القِفارا",3,"ر",2,0],["وَمِن آجِنٍ أَولَجَتهُ الجَنو","بُ دِمنَةَ أَعطانِهِ فَاِندَفَن",4,"ن",1,0],["ومن أجل الناس في عصره","بالمعجب المطرب من شعره",5,"ه",1,0],["ومن أجل مقتي للمخانيث أنكرت","يدي أن تُحَلّىَ في الجنان أساورا",6,"ر",2,0],["ومن أجل هذا قد نرى كل فاعل","إلى الناس في كلّ الفِعال ينيب",7,"ب",1,0],["ومن أجله جيء الذبيحان بالفدى","وصين دمٌ بين الدماءِ مطهَّر",8,"ر",1,0],["ومن أجل ما راعى من البين قوله","كليني لهمٍّ يا أميمةَ ناصبِ",9,"ب",1,0],["ومن أجل ذلك تجري النجو","م طوْراً نحوساً وطوراً سعودا",10,"د",2,0],["ومن أجلك استكسى الشَّمَال برودَهُ","وأقبل مزفُوفاً بها في بُرُودِهِ",11,"د",2,0],["وَمِن أَجلِهِ أَضحى المُقَطَّمُ شامِخاً","يُنافِسُ حَتّى طورَ سيناءَ في القَدرِ",12,"ر",1,0],["وَمِن أَجلِ طَيفِكِ عادَ مُظلِمُ لَيلِهِ","أَحظى لَدَيهِ مِن مُضيءِ نَهارِهِ",13,"ر",2,0],["وَمِن أَجلِ ذاتِ الخالِ أَعمَدتُ ناقَتي","أُكَلِّفُها سَيرَ الكَلالِ مَعَ الظَلعِ",14,"ع",1,0],["وَمِن أَجلِ ذاتِ الخالِ آلَفُ مَنزِلاً","أَحِلُّ بِهِ لا ذا صَديقٍ وَلا زَرعِ",14,"ع",1,0],["وَمِن أَجلِ ذاتِ الخالِ يَومَ لَقيتُها","بِمُندَفَعِ الأَخبابِ سابَقَني دَمعي",14,"ع",2,0],["وَمِن أَجلِ ذاتِ الخالِ عُدتُ كَأَنَّني","مُخامِرُ داءٍ داخِلٍ وَأَخو رِبعِ",14,"ع",1,0],["وَمِن أَجلِ الهَوى أُدنى","لِمَن لَم أَرضَهُ مَعضا",15,"ض",2,0],["وَمِن أَجلِكَ اِهتَزَّ القَضيبُ عَلى النَقا","وَأَشرَقَ نُوّارُ الرُبى يَتَفَتَّقُ",16,"ق",1,0],["وَمِن أَجلِها أَحبَبتُ مَن لا يَحُبُّني","وَمَن لا يَزالُ الدَهرُ فيها مُعادِيا",17,"ي",2,0],["وَمِن أَجلِها صاحَبتُ قَوماً تَعَصَّبوا","عَلَيَّ وَلَم يَرعُوا حُقوقَ جَوارِيا",17,"ي",2,0],["وَمِن أَجلِها سُمّيتُ مَجنونَ عامِرٍ","فِداها مِنَ المَكروهِ نَفسي وَمالِيا",18,"ي",2,0],["وَمِن أَجلِها أَحبَبتُ مَن لا يُحِبُّني","وَباغَضتُ مَن قَد كُنتُ حيناً أُعاشِرُه",19,"ر",2,0],["ومن أجلِ ذلك لا غَيرِهِ","رأى الغَنَويُّ بها ما رَأى",20,"ا",1,0],["وَمِنْ أَجْلِ ذَاتِ الخالِ أَعْمَلْتُ نَاقتي","أُكَلِّفُها سَيْرَ الكَلالِ مَعَ الظَّلْعِ",21,"ع",1,0],["ومن اجلِ ذاتِ الخالِ آلفُ منزلاً،","تَحِلُّ بِهِ لا ذا صَدِيقٍ وَلاَ زَرْعِ",21,"ع",1,0],["ومن اجفانه قد سل بيضا","وعلم قدم السمر اعتدالا",22,"ل",2,0],["ومن أجلهم حبّي لها وتشوّقي","وإن غلاء الدار بالجار قد أمسى",23,"س",2,0],["وَمِن أَجلِ قُرباكُم حُسِدتُ وَسُدِّدَت","إِلَيَّ نِصالٌ لِلعِدى وَسِهامُ",24,"م",1,0],["وَمِن أجلِّ موجِبات الطردِ","فاِحذَر جميعَ ما مَضى في المولدِ",25,"د",1,0],["وَمِن أَجفانِهِنَّ السودِ يَومَ ال","تَفَرُّقِ لِلسِيوفِ البيضِ سَلّوا",26,"ل",3,0],["وَمُناجِدٍ بَطَلٍ دَبَبتُ لَهُ","تَحتَ الغُبارِ بطَعنَةٍ خَلسِ",27,"س",1,0],["وَمِن أَجلِها أَبكي جُفوناً وَأَتَّقي","جُفوناً وَأَخشاها جُفوناً عَوادِيا",28,"ي",2,0],["ومِن أجلِ ذلكَ قالُوا بَخِل","تَ عَلَينا وهُم بَخِلُوا والزَّمَن",29,"ن",1,0],["ومن اجتنى ثمرَ النفوس بما حفا","والجوّ أقتمُ والمَرادُ جَفافُ",30,"ف",1,0],["ومناجيب محصنات توحَّدْ","ن بأن لا يلدنَ إلا الذُّكورا",31,"ر",2,0],["ومن اجْتَلى نورَ الهُدَى من قبرِهِ","بصَحيحِ قلبٍ رُكْنُهُ لم يُهْدَمِ",32,"م",1,0],["ومُناجَاتي بمُوسى نَشْأَتي","مذْ تَلاشَتْ أَوضَحَتْ لي الرَّقَمَا",33,"م",2,0],["وَمِن أجلِ مَا بِي أبدَتِ الشَّمسُ بِالضُّحَى","شُحُوب ضَنًى قَبلَ الجُنوحِ إِلى الحَجبِ",34,"ب",1,0],["ومن أجلِ وَسْواسِ هذا الغرامِ","أقام العزيزُ بدار الهَوانِ",35,"ن",1,0],["ومن أجلها لمّا مررتَ بدارها","وقد أوحَشَتْ منها شَجَتْنِي طلولُها",36,"ل",3,0],["وَمِن أَجلِ أنّك أنكرتَهُ","بِعَينك ظَلتَ له لامِسا",37,"س",2,0],["وَمن أَجلِ أنّكَ تَسْتَبينُ على الكرى","أهوى الرُّقادَ ولاتَ حين رُقادِ",38,"د",1,0],["ومن أجل هذا قال أهل طريقنا","خيال وظل ما عن الحق وافد",39,"د",1,0],["وَمِن أَجل أَن ودَّت على الحبِّ أَنّها","على جِيدها تبدو عُقوداً بدورُها",40,"ر",3,0],["ومَنْ أَجَلَّ إلهُ النَّاسِ رُتْبَتَهُ","حتَّى علاَ وهَوَى الأملاكُ في صَبَبِ",41,"ب",1,0],["ومن أجله تشتاق نفسي للحمى","وأين الحمى مني وأين المشغّر",42,"ر",1,0],["وَمِنْ أَجْلِهِ خَفَّتْ عَلَيَّ الْمَسَالِكُ","وَمَا الدَّمْعُ إلاَّ شَافِعِي وَهُوَ مَالِكُ",43,"ك",1,0],["ومن أجاز خلعه","رأى اضطراراً وجبا",44,"ب",2,0],["ومن أجل ذا أرجوه إذا كان غافرا","ومن أجل ذا قد صح مني رجائيا",45,"ي",2,0],["ومن أجل ذا أرجوه إذ لم يكافني","ولكن بلطف منه كان ابتدائيا",45,"ي",2,0],["وَمِنْ أَجْلِ مَغْناها بِنَجْدٍ تَشُوقُني","مَرابِعُهُ كُثْبانُها وَالأَباطِحُ",46,"ح",1,0],["ومن أجرى عتاق الخيل قبّاً","فأوطأها المتالع والحثاما",47,"م",2,0],["وَمِن أَجلِها كَلَّفتُها النَصَّ وَالسُرى","وَأَشعَثُ قَد نَبَّهَتهُ وَهُوَ ناعِسُ",48,"س",1,0],["وَمِن أَجلِها أَحبَبتُ لَيلى لِأَنَّهُ","كَما فَرعُها وَحفُ الأَنابِيبِ أَدعَجُ",49,"ج",1,0],["وَمن أجلِهِ الإنسانُ يُلقي بنفسِهِ","عياناً على المكروهِ في حالةِ العُسرى",50,"ر",2,0],["ومن أجل ذا لم يدخل الكبر قلبهم","على موجد الصنع الذي جل من صنع",51,"ع",1,0],["ومن أجل مَنْ هو رابعٌ لثلاثةٍ","جار وذاك هو الإله القاسم",52,"م",1,0],["ومن أجله قد رقّ جسمي صبابةً","ويا ليتَهُ لمّا رآه عليه رقّ",53,"ق",1,0],["ومن أجل هذا أصبح العود يضرب","فإني لصب أن يفوز بقربها",54,"ه",2,0],["ومن أجال في مجاليها النظر","لها بأعين العنايات نظر",55,"ر",1,0],["وَمنْ أجلهِ قد حَرّمتْ لحمَ مثلهِ","بَراهِمةٌ في شَرْعِها وَهنودُ",56,"د",1,0],["ومن أجل إِيواء النبي ونصره","يحبكم قلبي وغيركم الأصل",57,"ل",1,0],["ومن أجل ذاك السقم في جفن عينها","سهرت فلم أعرف رقاداً ولا غمضا",58,"ض",2,0],["وَمَن أَجمَعَت آراء كُلٍّ بِأَنَّهُ","وَحيدٌ لِأَشتاتِ الفَضائل جامِعُ",59,"ع",1,0],["ومن أجله شادوا المدارس فخمةً","ولولاه لم تعقد بها حلقات",60,"ت",1,0],["ومن أجملا أتلان تأتي أراز مَعْ","فتىً عبد الرحمان عبداً بلا دوسِ",61,"س",1,0],["ومن أجل ذا أكنى يعلوى وزينب","وأكثر من ذكراي رامة أو حزوى",62,"و",2,0],["ومِن أَجلِ مَن يُردِي شَقِيقٌ شَقِيقَهُ","لِفَوزٍ.. وهَل بَينَ الشَّقِيقَينِ فائِزُ؟!",63,"ز",1,0],["ومَنْ أجَّجَ النيرانَ في دارِ جارِهِ","سيصبحُ منها دارُهُ في ائتِجاجِ",64,"ج",1,0],["ومن أجل ذا أرجوه إذ لم يكلفني","ولكن بلطف منه كان ابتدائيا",65,"ي",2,0],["وَمِنْ أجْلِهِ أَحْبَبْتُ إسْمي وَأَحْرُفي","إِذا ما رَأَتْهُ العَيْنُ غَنَّى الهَوَى لِيا",66,"ي",2,0],["وَمِنْ أجْلِهِ أَحْبَبْتُ بوحي وَأَحْرُفي","إِذا ما رَأَتْهُ العَيْنُ غَنَّى الهَوَى لِيا",67,"ي",2,0],["ومن أجل هذا قلت فيضاً وغيظةً","فمت كمداً أن قد علاك الهدى حقاً",68,"ق",2,0],["ومن أجله كان الجواب مطولاً","ليجبر من نظمي إذاً كل قاصر",69,"ر",1,0],["ومن أجل هذا الاعتقاد رماكمو","بأبذى لسان من رماكم فأبكما",70,"م",2,0],["ومنْ أجْل الوصول إلى مرادي","فإني لنْ أفرّط في الصُمود",71,"د",1,0],["ومن أجل هذا رحمة الحق تسبق ان","تقاما له من أجل روح النبوتي",72,"ت",2,0],["ومن أجل غيرك دع غَيْرَتَيك","وإلا تُحَطِّم بيتا منيعا",73,"ع",2,0],["ومناجيبُ محصناتُ توَّحد","نَ بأنْ لا يلدنَ إلأاَّ الذُّكورا",74,"ر",2,0]]}