{"poems":[[572,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114275","الطويل"],[4691,"حافظ القرآن الماجن","https://www.poetsgate.com/ViewPoem.aspx?id=174368",""],[5433,"كثر الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=36227",""],[5606,"ترى مافي حبيش الاسنامه","https://www.poetsgate.com/ViewPoem.aspx?id=194247",""],[5781,"بحرٌ بما يكفي لحُبٍّ وعاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=202850",""],[5956,"إلى كذوب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182541",""],[6125,"لَهَاهُ العِزُّ والمرتعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210905",""]],"verses":[["كَذَوْبِ الفِضَّةِ البَيْضَا","ءِ فَوْقَ العَنْبَرِ الشِّحْرِي",0,"ر",2,0],["كذواتِ الأكراشِ ليست ترى المغ","نَم إلا أَن تملأ الأكراشا",1,"ش",2,0],["كَذَوائِبِ الحَفَأِ الرَطيبِ غَطا بِهِ","غَيلٌ وَمَدَّ بِجانِبَيهِ الطُحلُبُ",2,"ب",1,0],["كَذُوبٌ لَعَمرُ اللهِ مَن قَالَ أحمَدٌ","لَهُ شَبَهٌ فِيمَا سَيُوجَدُ أو هَلَك",3,"ك",1,0],["كذوبٌ يدّعي الإصلاح َ زورًا","وليس َ له صلاحٌ أو نقاءُ",4,"ا",2,0],["كذوبه يالهوجس اللي على الخاطر تجي ، وتروح","بغيت أزبن ذراها ، واستريح وماتهيالي",5,"ل",2,0],["كذوب ومفتري والكذب خيبه","ولو يلبس علي راسه عمامه",6,"م",2,0],["كَذوبٌ فما قبَّلتُهُ وَأَجاعَني","وَلا اسْتَوْحَشَتْ عَيْني بَريقَ جَمالِهِ",7,"ل",2,0],["كذوبي هل هنالك من مزيدِ‎","من الإهمال لي بعد العهودِ؟‎",8,"د",1,1],["كذوبي لست أفهمكم أ قُلتم‎","وداعاً للصداقة والوعودِ ؟‎",8,"د",1,0],["كذوبٌ ما نرى إلا","فجيعاً ظنَّ لن يُفجعْ",9,"ع",1,0]]}