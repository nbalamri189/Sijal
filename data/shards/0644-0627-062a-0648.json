{"poems":[[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[42,"ليت شعري عن خليلي ما الذي","https://www.aldiwan.net/poem50429.html","الرمل"],[71,"لو أن طلاب المطالب عندهم","https://www.aldiwan.net/poem3725.html","الكامل"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[83,"أم الحسن تتكلم","https://www.aldiwan.net/poem54200.html","مخلع البسيط"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[51,"إنفاق أيام الحياة على","https://www.aldiwan.net/poem64031.html","أحذ الكامل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"عاد للأرض مع الصيف صباها","https://www.aldiwan.net/poem62805.html","عموديه"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[45,"مهرج صبوحك سعده لم ينحس","https://www.aldiwan.net/poem64611.html","الكامل"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[28,"كم للملاءة من أطلال منزلة","https://www.aldiwan.net/poem5379.html","البسيط"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[58,"لا تودع السر إلا عند ذي كرم","https://www.aldiwan.net/poem30863.html","البسيط"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[69,"يا ناقلا إلي قول حاسدي","https://www.aldiwan.net/poem28784.html","الرجز"],[74,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[74,"لا تودعن ولا الجماد سريرة","https://www.aldiwan.net/poem13199.html","الكامل"],[105,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[67,"إن خلق الشهود والعمال","https://www.aldiwan.net/poem18090.html","الخفيف"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[46,"إن شربوا الراح فما شربنا","https://www.aldiwan.net/poem22420.html","السريع"],[46,"لم أرض رأي ولاة قوم لقبوا","https://www.aldiwan.net/poem22632.html","الكامل"],[46,"إرفع مجنك أو ضع للفتى قدر","https://www.aldiwan.net/poem22827.html","البسيط"],[46,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[46,"إن أكلتم فضلا وأنفقتم فض","https://www.aldiwan.net/poem23434.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85495","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[43,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"مَهْرِجْ صَبُوحَك سَعْدُه ُلم يُنْحَسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31143",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[116,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[129,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[135,"لا توصني بلازم وواجب","https://www.aldiwan.net/poem20985.html","الرجز"],[187,"لا توحشنك خيبة الأمل","https://www.aldiwan.net/poem43466.html","الكامل"],[212,"وجه جميل بلا وحي أطوف به","https://www.aldiwan.net/poem46303.html","البسيط"],[226,"معشر القبط يا بني مصر في السر","https://www.aldiwan.net/poem55112.html","الخفيف"],[230,"لا تؤاخذني على تق","https://www.aldiwan.net/poem51129.html","مجزوء الرمل"],[233,"عذرا فقلبي ما عليه اعتذار","https://www.aldiwan.net/poem14839.html","السريع"],[236,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[238,"أيها القرم الهمام المرتضى","https://www.aldiwan.net/poem19300.html","الرمل"],[260,"شنف السمع مطربا بالسماع","https://www.aldiwan.net/poem35817.html","الخفيف"],[319,"رباعيات الخيام","https://www.aldiwan.net/poem63242.html","عموديه"],[362,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[378,"تب إنما الأعمار برق خلب","https://www.aldiwan.net/poem59435.html","الكامل"],[392,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[392,"ياكريم الوجه ضاقت وأنت بالعالم عليم","https://www.aldiwan.net/poem54488.html","عموديه"],[392,"يا تار كالصلاة الفرض كم ذا حرام","https://www.aldiwan.net/poem54497.html","عموديه"],[392,"ضاعت الأعمار في قيل وقال","https://www.aldiwan.net/poem54510.html","عموديه"],[392,"إنما الدنيا حراف وهراف وزراف","https://www.aldiwan.net/poem54554.html","عموديه"],[403,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[404,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[406,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[410,"لا توص عند الموت","https://www.aldiwan.net/poem31621.html","عموديه"],[410,"لا تودعن سمع أخ شكية","https://www.aldiwan.net/poem32058.html","الرجز"],[417,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[459,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[515,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[552,"لا توعدني الشر ترهبني","https://www.aldiwan.net/poem47817.html","أحذ الكامل"],[559,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"]],"verses":[["لا تُوَلِّ الأَظعانَ عَيناً فَما تَر","جِعُ إِلّا بِناظِرٍ مَطروفِ",0,"ف",1,0],["لا تُوقِدِ المِصْباحَ واعْلَمْ أنّ لي","منْ وَجْهِ مَنْ أحْبَبْتُهُ مِصْباحا",1,"ح",2,0],["لا تُؤاخِ الدَهرَ جِبساً راضِعاً","مُلهَبَ الشَدِّ سَريعَ المَنزَعَه",2,"ع",2,0],["لَأَتوا إِلَيكَ بِكُلِّ ما أَمَّلتَهُ","مِنهُم وَكانَ لَكَ الجَزاءُ الأَوفَرُ",3,"ر",1,0],["لاَ تُؤْخَذُ الدُّنْيَا اجْتِدَا","ءً تُؤْخَذُ الدُّنْيَا غِلاَبَا",4,"ب",2,0],["لا تُؤْمنُ الزَّلاَّتُ وَالحَكَمُ الهَوى","فِي الفَرْقِ بَيْنَ صوابِهَا وَضَلالِهَا",5,"ل",3,0],["لا توقدوا لي مصباح","يكفاني ضاوه والشم",6,"م",1,0],["لا توجعوا بملامِكم كبدِي","فملامكم ضربٌ من الضرْب",7,"ب",1,0],["لا توحش العلياء من نسلهم","ولا ترى الشنعاء من فقده",8,"د",2,0],["لا تولني البتراء إنك من","نجرٍ يشاكل غيرَه البُترُ",9,"ر",1,0],["لا توحش الأرض من شيبان إنهمُ","قومٌ يكونون حيثُ المجدُ مذ كانوا",10,"ن",3,0],["لا تُؤَجِّل لِغَدٍ لَيسَ غَدٌ","غَيرَ يَومٍ كَالَّذي ضاعَ وَتاها",11,"ا",3,0],["لا تؤمل تجددا","لزجاج قد انكسر",12,"ر",1,0],["لا تورِثُ القَومَ وَلَو","كانوا البَنينَ البَرَرَه",13,"ر",2,0],["لا تُؤذِيَنّي وَاسقِني ما أَبتَغي","فِعلَ اِمرِئٍ طَلقٍ كَريمِ المَعطَسِ",14,"س",1,0],["لا توجِبَن لِكَريمِ أَصلِكَ مِنَّةً","لَو كُنتَ مِن عُكلٍ لَكُنتَ كَريما",15,"م",2,0],["لا توقِدُ النارَ إِلّا أَن تُثَقِّبَها","بِالعودِ في مِفضَلِ الخِزِّيَّةِ الغالي",16,"ل",2,0],["لا تُولِعا بالمَشوقِ لومَكُما","وإنْ تمادَى غَرامُه وَلَعا",17,"ع",2,0],["لا تُوَدِعِ السِرَّ إِلّا عِندَ ذي كَرَمٍ","وَالسَرُّ عِندَ كِرامِ الناسِ مُكتومُ",18,"م",1,1],["لا تودِعوا سِرَّكُم نَواظِرَهُ","فَهيَ عَلى السِرِّ غَيرُ مُؤتَمَنَه",19,"ن",2,0],["لا توهِ جِسمَكَ بِالسِلاحِ وَثِقلِهِ","إِنّي عَلَيكَ مِنَ الغِلالَةِ أَشفَقُ",20,"ق",1,0],["لا توقِظوا الشَرَّ مِن قَومٍ فَقَد غَنِيَت","دِيارُكُم وَهيَ تُدعى مَوطِنَ النِعَمِ",21,"م",1,0],["لا توازى لذَّةُ الحكمِ بما","ذاقَها المرءُ إذا المرْ انعزلْ",22,"ل",1,0],["لا تودعِ السرَّ النساءَ فما النسا","أهلٌ لما يُودَعْنَ مِنْ أسرارِ",23,"ر",1,0],["لا تؤذني بحجةِ النصحِ فما","أسمعني السوءَ سوى مبلِّغي",24,"ي",1,0],["لا تُورِثُ الأَحشاءَ إِلّا غُلَّةً","وَالماءُ يَنقَعُ غُلَّةَ الأَحشاءِ",25,"ا",2,0],["لا تودِعَنَّ وَلا الجَمادَ سَريرَةً","فَمِنَ الصَوامِتِ مايُشيرُ فَيَنطِقُ",26,"ق",1,1],["لا تُؤثِري العيشَ الذّليلَ وجَانِبِي","خُلُقَ الضَّعيفِ وشِيمةَ المُسْتَسْلِمِ",27,"م",1,0],["لا تُولهِ منك التفاتةَ سامعٍ","إنّا نَشدُّ لسانَه بِعِقالِ",28,"ل",1,0],["لا تُوَطِّنْ قلوبَهُمْ بِهِجَاءٍ","إنها منْ سُطاكَ في بَلْبالِ",29,"ل",1,0],["لا توعِدَنّي بِاللِقا","ءِ وَقَد شَرِبتُ دَمَ الأَساوِد",30,"د",1,0],["لا توحِشُ الوَحدَةُ أَصحابَها","إِنَّ سُهَيلاً وَحدَهُ فارِدُ",31,"د",1,0],["لا تولِدوا وَإِذا أَبى طَبعٌ فَلا","تئِدوا وَأَكرِم بِالتُرابِ مُصاهِرا",32,"ر",2,0],["لا تودِعِ السِرَّ مِزماراً فَيوعلِنهُ","بِجَهلِهِ بَعدَ طولِ الصَمتِ وَالخَرَسِ",33,"س",1,0],["لا تُؤَبِّل أَخاكَ يَوماً إِذا ما","تَ فَما كانَ مَوضِعَ التَأبيلِ",34,"ل",1,0],["لا تُوَلّوا أُمورَكُم أَيدِيَ النا","سِ إِذا رُدَّتِ الأُمورُ إِلَيكُم",35,"م",1,0],["لا توقظنّي إن هجعت من الكرى","حتى يغرد في الصباح هزار",36,"ر",1,0],["لاَ تُوَارَى سَرِيرَةٌ عَنْكَ مِمَّا","قَدْ يُوَارِيهِ فِي طَوَاياهُ صَدْرُ",37,"ر",1,0],["لا تُوسِعُوا الأَقدارَ لَوْ","مًا، أو تقولوا: الجَدُّ عَاثِر",38,"ر",1,0],["لا تُؤثِرُ الوَجهَ عَلى القَذالِ","فَاختَلَفَتْ في وابِلَي نِبالِ",39,"ل",1,0],["لا توقظوه بالدموع فربّما","أغفى لطول سُهاده وعنائه",40,"ا",3,0],["لا توحشي دارَ الرشيد فانها","وقفٌ على الإبراق والإرعاد",41,"د",1,0],["لا تُؤذينَّي واسْقِني ما أبْتَغِي","فِعْلَ امْرىءٍ طًلقٍ كًرِيمِ المَعطِس",42,"س",1,0],["لا تُؤاتيكَ وَإِن صَحَوتَ وَإِن أج","هَدَ في العارِضَينِ مِنكَ القَتيرُ",43,"ر",1,0],["لا تؤمل من الخؤن ذماما","ما لذي الخدعة الخؤن ذمام",44,"م",1,0],["لا تُؤَاخذني بذنبي إننّي","تائبٌ من كل ذنبٍ قد فَنِى",45,"ن",2,0],["لا توصِني بِلازِمٍ وَواجِبِ","إِنّي سَمِعتُ أَعجَبَ العَجائِبِ",46,"ب",1,1],["لا توحشنّك خيبة الأمل","خطأ الطيب إصابة الأجل",47,"ل",1,1],["لا توح لا توح شعرا إنني غزلٌ","والشعر يحزنني والحسن يأسرني",48,"ن",2,0],["لا تُوَلّوا وُجوهَكُم شَطرَ مَن عَكَّ","رَ ما في قُلوبِنا من صَفاءِ",49,"ا",2,0],["لا تؤاخذني على تَقْ","بيلِ خدِّيك ووَرْدِكْ",50,"ك",1,1],["لا توحِشِ الطَرفَ فَأَنتَ الَّذي","يَسري غَرامي نَحوهُ كَيفَ سار",51,"ر",1,0],["لا تُؤَمِّل سِواهُ فَهوَ كَفيلٌ","لِمَساعيكَ بِالنَجاحِ ضَمينُ",52,"ن",1,0],["لاَ تُوَاخِذْنِي بِجُرْمٍ قَدْ مَضَى","عَنْ قِلىً أَسْلَفْتُهُ لاَ عَنْ رِضَى",53,"ض",2,0],["لا تولّي في حلبة الحبّ ظهراً","وتلقّ الهوى بصدر شجاع",54,"ع",1,0],["لا توحِش النَّفسَ بخوفِ الظنون","واغنم من الحاضرِ أمنَ اليقين",55,"ن",1,0],["لا تؤخران كنت تَقبل نصحي","لَذّة أَمكنت مَع النُدَماء",56,"ا",2,0],["لا توعدن اللَه منك بتوبةٍ","وتني بها بل جدِّد الإحواذا",57,"ذ",2,0],["لا تؤذي المسكين","فيورثك تمحين",58,"ن",1,0],["لا تؤاخذهم بذنبي إن ذنبي جيم ميم","واعف عني وامح ذنبي",59,"ي",1,0],["لا تؤذ مسلم فللمسلم كثيرا احترام","والوالي العدل فرض به يتم النظام",60,"م",1,0],["لا تؤاخذنا بسو أعمالنا","إنها ياربنا شر الخصال",61,"ل",1,0],["لا تودوه أو تصافوا ما بها خير ولكن","خير ما فيها الكفاف",62,"ف",1,0],["لا تُؤَمِّل عندَ كربٍ غيرَ مَنْ","لانْفِراج الكَربِ يَدْعوه الأنام",63,"م",1,0],["لا توردن على سمعي من الْكَلِمِ","عند الملاقاة إلا طيِّبَ الحكمِ",64,"م",1,1],["لا تُودِعِ السَّرَّ وَشّاءً يبوحُ بهِ","فما رعى غَنَماً في الدَّوِّ سِرْحانُ",65,"ن",1,0],["لا توص عند الموت","إلا بالوديعة والديون",66,"ن",1,1],["لا تُودَعنْ سَمع أخٍ شكيّةً","فالقلبُ أولى بالذي أَجَنَّا",67,"ن",2,1],["لا تؤاخِذْ بدمي ناظِرَهُ","وقَتيلُ الحبّ يأبى أن يفادى",68,"د",2,0],["لا توسعاني بالهوى ملامة","إن الجمال قائدي إلى الهوى",69,"ا",1,0],["لا توسعنِّي من نوا","لك فوق ما يسَعُ امتداحي",70,"ح",2,0],["لا تؤدي سلامَكُم نحوها الري","حُ ولا طَيفُها مطايا الهُجودِ",71,"د",1,0],["لا تُوعدَنِّي الشرَّ تُرهبنِي","فلربّما لم ينجنِي حَذرُهْ",72,"ر",2,1],["لا تؤمل من سواه أملاً","إنما يسقيك من قد زرعك",73,"ك",1,0]]}