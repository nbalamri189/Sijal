180191",""],[5190,"جرح نازف","https://www.poetsgate.com/ViewPoem.aspx?id=62017",""],[309,"يا جَميل إِن سرّ اللَه عَلي الخَلق باق","https://www.poetsgate.com/ViewPoem.aspx?id=42834",""],[307,"هلْ زجّ في الأملِ القنوطُ سقاما","https://www.poetsgate.com/ViewPoem.aspx?id=213805",""],[5343,"امسح دموعك،","https://www.poetsgate.com/ViewPoem.aspx?id=132672",""],[5362,"لمعت في ظلام رأسي شهابا","https://www.poetsgate.com/ViewPoem.aspx?id=170375",""],[5409,"قابلت نعيك من ربوع الشام","https://www.poetsgate.com/ViewPoem.aspx?id=155479",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5463,"أنا غرامك يوم كنتي عن غرامي تبحثين","https://www.poetsgate.com/ViewPoem.aspx?id=32341",""],[5490,"يادار غزة","https://www.poetsgate.com/ViewPoem.aspx?id=176357",""],[5510,"لا تعذليه","https://www.poetsgate.com/ViewPoem.aspx?id=206146",""],[5512,"ربيعٌ أم خريف","https://www.poetsgate.com/ViewPoem.aspx?id=204667",""],[5525,"ردي على الصوت","https://www.poetsgate.com/ViewPoem.aspx?id=947",""],[5533,"حُلْم","https://www.poetsgate.com/ViewPoem.aspx?id=176768",""],[3369,"يا إلهي أنت بر","https://www.poetsgate.com/ViewPoem.aspx?id=118165",""],[5628,"بصيص","https://www.poetsgate.com/ViewPoem.aspx?id=178456",""],[5628,"الشاعر والعاذلة","https://www.poetsgate.com/ViewPoem.aspx?id=178469",""],[5628,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=178505",""],[5655,"عُوجا علي أرضهم غداً ولِجا","https://www.poetsgate.com/ViewPoem.aspx?id=107217",""],[5660,"وَ الوَجدُ يَربَحُ وَ النَّوى تَقتاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=35775",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5845,"كلُّ شيءٍ منكمْ عليكمْ دليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=15454",""],[5906,"في الحكمة /النميمة / لا تول للنّمام بالا","https://www.poetsgate.com/ViewPoem.aspx?id=189629",""],[5943,"ياإله الكون فاشهدْ","https://www.poetsgate.com/ViewPoem.aspx?id=35153",""],[5950,"عمر ومسافة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128118",""],[5957,"ماء الود","https://www.poetsgate.com/ViewPoem.aspx?id=215529",""],[5977,"لا تؤذ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213062",""],[6069,"وحق نصف اسمه الأخير لقد","https://www.poetsgate.com/ViewPoem.aspx?id=105704",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[6152,"لا تؤلميني بالغياب","https://www.poetsgate.com/ViewPoem.aspx?id=203774",""],[3155,"إلى قُمْريَّة الشط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75612&r=&rc=35",""]],"verses":[["لا تُوَلِّ الأَظعانَ عَيناً فَما تَر","جِعُ إِلّا بِناظِرٍ مَطروفِ",0,"ف",1,0],["لا تُوقِدِ المِصْباحَ واعْلَمْ أنّ لي","منْ وَجْهِ مَنْ أحْبَبْتُهُ مِصْباحا",1,"ح",2,0],["لا تُؤاخِ الدَهرَ جِبساً راضِعاً","مُلهَبَ الشَدِّ سَريعَ المَنزَعَه",2,"ع",2,0],["لَأَتوا إِلَيكَ بِكُلِّ ما أَمَّلتَهُ","مِنهُم وَكانَ لَكَ الجَزاءُ الأَوفَرُ",3,"ر",1,0],["لاَ تُؤْخَذُ الدُّنْيَا اجْتِدَا","ءً تُؤْخَذُ الدُّنْيَا غِلاَبَا",4,"ب",2,0],["لا تُؤْمنُ الزَّلاَّتُ وَالحَكَمُ الهَوى","فِي الفَرْقِ بَيْنَ صوابِهَا وَضَلالِهَا",5,"ل",3,0],["لا توقدوا لي مصباح","يكفاني ضاوه والشم",6,"م",1,0],["لا توجعوا بملامِكم كبدِي","فملامكم ضربٌ من الضرْب",7,"ب",1,0],["لا توحش العلياء من نسلهم","ولا ترى الشنعاء من فقده",8,"د",2,0],["لا تولني البتراء إنك من","نجرٍ يشاكل غيرَه البُترُ",9,"ر",1,0],["لا توحش الأرض من شيبان إنهمُ","قومٌ يكونون حيثُ المجدُ مذ كانوا",10,"ن",3,0],["لا تُؤَجِّل لِغَدٍ لَيسَ غَدٌ","غَيرَ يَومٍ كَالَّذي ضاعَ وَتاها",11,"ا",3,0],["لا تؤمل تجددا","لزجاج قد انكسر",12,"ر",1,0],["لا تورِثُ القَومَ وَلَو","كانوا البَنينَ البَرَرَه",13,"ر",2,0],["لا تُؤذِيَنّي وَاسقِني ما أَبتَغي","فِعلَ اِمرِئٍ طَلقٍ كَريمِ المَعطَسِ",14,"س",1,0],["لا توجِبَن لِكَريمِ أَصلِكَ مِنَّةً","لَو كُنتَ مِن عُكلٍ لَكُنتَ كَريما",15,"م",2,0],["لا توقِدُ النارَ إِلّا أَن تُثَقِّبَها","بِالعودِ في مِفضَلِ الخِزِّيَّةِ الغالي",16,"ل",2,0],["لا تُولِعا بالمَشوقِ لومَكُما","وإنْ تمادَى غَرامُه وَلَعا",17,"ع",2,0],["لا تُوَدِعِ السِرَّ إِلّا عِندَ ذي كَرَمٍ","وَالسَرُّ عِندَ كِرامِ الناسِ مُكتومُ",18,"م",1,1],["لا تودِعوا سِرَّكُم نَواظِرَهُ","فَهيَ عَلى السِرِّ غَيرُ مُؤتَمَنَه",19,"ن",2,0],["لا توهِ جِسمَكَ بِالسِلاحِ وَثِقلِهِ","إِنّي عَلَيكَ مِنَ الغِلالَةِ أَشفَقُ",20,"ق",1,0],["لا توقِظوا الشَرَّ مِن قَومٍ فَقَد غَنِيَت","دِيارُكُم وَهيَ تُدعى مَوطِنَ النِعَمِ",21,"م",1,0],["لا توازى لذَّةُ الحكمِ بما","ذاقَها المرءُ إذا المرْ انعزلْ",22,"ل",1,0],["لا تودعِ السرَّ النساءَ فما النسا","أهلٌ لما يُودَعْنَ مِنْ أسرارِ",23,"ر",1,0],["لا تؤذني بحجةِ النصحِ فما","أسمعني السوءَ سوى مبلِّغي",24,"ي",1,0],["لا تُورِثُ الأَحشاءَ إِلّا غُلَّةً","وَالماءُ يَنقَعُ غُلَّةَ الأَحشاءِ",25,"ا",2,0],["لا تودِعَنَّ وَلا الجَمادَ سَريرَةً","فَمِنَ الصَوامِتِ مايُشيرُ فَيَنطِقُ",26,"ق",1,1],["لا تُؤثِري العيشَ الذّليلَ وجَانِبِي","خُلُقَ الضَّعيفِ وشِيمةَ المُسْتَسْلِمِ",27,"م",1,0],["لا تُولهِ منك التفاتةَ سامعٍ","إنّا نَشدُّ لسانَه بِعِقالِ",28,"ل",1,0],["لا تُوَطِّنْ قلوبَهُمْ بِهِجَاءٍ","إنها منْ سُطاكَ في بَلْبالِ",29,"ل",1,0],["لا توعِدَنّي بِاللِقا","ءِ وَقَد شَرِبتُ دَمَ الأَساوِد",30,"د",1,0],["لا توحِشُ الوَحدَةُ أَصحابَها","إِنَّ سُهَيلاً وَحدَهُ فارِدُ",31,"د",1,0],["لا تولِدوا وَإِذا أَبى طَبعٌ فَلا","تئِدوا وَأَكرِم بِالتُرابِ مُصاهِرا",32,"ر",2,0],["لا تودِعِ السِرَّ مِزماراً فَيوعلِنهُ","بِجَهلِهِ بَعدَ طولِ الصَمتِ وَالخَرَسِ",33,"س",1,0],["لا تُؤَبِّل أَخاكَ يَوماً إِذا ما","تَ فَما كانَ مَوضِعَ التَأبيلِ",34,"ل",1,0],["لا تُوَلّوا أُمورَكُم أَيدِيَ النا","سِ إِذا رُدَّتِ الأُمورُ إِلَيكُم",35,"م",1,0],["لا توقظنّي إن هجعت من الكرى","حتى يغرد في الصباح هزار",36,"ر",1,0],["لاَ تُوَارَى سَرِيرَةٌ عَنْكَ مِمَّا","قَدْ يُوَارِيهِ فِي طَوَاياهُ صَدْرُ",37,"ر",1,0],["لا تُوسِعُوا الأَقدارَ لَوْ","مًا، أو تقولوا: الجَدُّ عَاثِر",38,"ر",1,0],["لا تُؤثِرُ الوَجهَ عَلى القَذالِ","فَاختَلَفَتْ في وابِلَي نِبالِ",39,"ل",1,0],["لا توقظوه بالدموع فربّما","أغفى لطول سُهاده وعنائه",40,"ا",3,0],["لا توحشي دارَ الرشيد فانها","وقفٌ على الإبراق والإرعاد",41,"د",1,0],["لا تُؤذينَّي واسْقِني ما أبْتَغِي","فِعْلَ امْرىءٍ طًلقٍ كًرِيمِ المَعطِس",42,"س",1,0],["لا توزع الفكر فيها لا تقوم به","الا المقادير والزم جانبا وسطا",43,"ط",2,0],["لا تُؤاتيكَ وَإِن صَحَوتَ وَإِن أج","هَدَ في العارِضَينِ مِنكَ القَتيرُ",44,"ر",1,0],["لا تؤمل من الخؤن ذماما","ما لذي الخدعة الخؤن ذمام",45,"م",1,0],["لا تُؤَاخذني بذنبي إننّي","تائبٌ من كل ذنبٍ قد فَنِى",46,"ن",2,0],["لا توصِني بِلازِمٍ وَواجِبِ","إِنّي سَمِعتُ أَعجَبَ العَجائِبِ",47,"ب",1,1],["لا توحشنّك خيبة الأمل","خطأ الطيب إصابة الأجل",48,"ل",1,1],["لا توح لا توح شعرا إنني غزلٌ","والشعر يحزنني والحسن يأسرني",49,"ن",2,0],["لا تُوَلّوا وُجوهَكُم شَطرَ مَن عَكَّ","رَ ما في قُلوبِنا من صَفاءِ",50,"ا",2,0],["لا تؤاخذني على تَقْ","بيلِ خدِّيك ووَرْدِكْ",51,"ك",1,1],["لا توحِشِ الطَرفَ فَأَنتَ الَّذي","يَسري غَرامي نَحوهُ كَيفَ سار",52,"ر",1,0],["لا تُؤَمِّل سِواهُ فَهوَ كَفيلٌ","لِمَساعيكَ بِالنَجاحِ ضَمينُ",53,"ن",1,0],["لاَ تُوَاخِذْنِي بِجُرْمٍ قَدْ مَضَى","عَنْ قِلىً أَسْلَفْتُهُ لاَ عَنْ رِضَى",54,"ض",2,0],["لا تولّي في حلبة الحبّ ظهراً","وتلقّ الهوى بصدر شجاع",55,"ع",1,0],["لا توحِش النَّفسَ بخوفِ الظنون","واغنم من الحاضرِ أمنَ اليقين",56,"ن",1,0],["لا تؤخران كنت تَقبل نصحي","لَذّة أَمكنت مَع النُدَماء",57,"ا",2,0],["لا توعدن اللَه منك بتوبةٍ","وتني بها بل جدِّد الإحواذا",58,"ذ",2,0],["لا تؤذي المسكين","فيورثك تمحين",59,"ن",1,0],["لا تؤاخذهم بذنبي إن ذنبي جيم ميم","واعف عني وامح ذنبي",60,"ي",1,0],["لا تؤذ مسلم فللمسلم كثيرا احترام","والوالي العدل فرض به يتم النظام",61,"م",1,0],["لا تؤاخذنا بسو أعمالنا","إنها ياربنا شر الخصال",62,"ل",1,0],["لا تودوه أو تصافوا ما بها خير ولكن","خير ما فيها الكفاف",63,"ف",1,0],["لا تُؤَمِّل عندَ كربٍ غيرَ مَنْ","لانْفِراج الكَربِ يَدْعوه الأنام",64,"م",1,0],["لا توردن على سمعي من الْكَلِمِ","عند الملاقاة إلا طيِّبَ الحكمِ",65,"م",1,1],["لا تُودِعِ السَّرَّ وَشّاءً يبوحُ بهِ","فما رعى غَنَماً في الدَّوِّ سِرْحانُ",66,"ن",1,0],["لا توص عند الموت","إلا بالوديعة والديون",67,"ن",1,1],["لا تُودَعنْ سَمع أخٍ شكيّةً","فالقلبُ أولى بالذي أَجَنَّا",68,"ن",2,1],["لا تؤاخِذْ بدمي ناظِرَهُ","وقَتيلُ الحبّ يأبى أن يفادى",69,"د",2,0],["لا توسعاني بالهوى ملامة","إن الجمال قائدي إلى الهوى",70,"ا",1,0],["لا توسعنِّي من نوا","لك فوق ما يسَعُ امتداحي",71,"ح",2,0],["لا تؤدي سلامَكُم نحوها الري","حُ ولا طَيفُها مطايا الهُجودِ",72,"د",1,0],["لا تُوعدَنِّي الشرَّ تُرهبنِي","فلربّما لم ينجنِي حَذرُهْ",73,"ر",2,1],["لا تؤمل من سواه أملاً","إنما يسقيك من قد زرعك",74,"ك",1,0],["لا توصيني بكتمان الهوى","يا رعاك الله أخشى أن أجن",75,"ن",1,0],["لا تُؤَمِّلْ نَيْلَ شيءٍ منهُما","ما عليها المَلَوانِ اختلفَا",76,"ف",2,0],["لا تؤاخذني بما أسلفته","وتفضل من شكاتي بالشفا",77,"ف",2,0],["لا تُؤخِّرْ أبداً شر","بَ صَبوحٍ للغبوق",78,"ق",1,0],["لا تودعي السرَّ نماماً فيُظهرَه","بين الأنامِ بوجهٍ منه مرهوقِ",79,"ق",1,0],["لا توقظِي وَجَعي فيهِ الذي فيهِ","أو تسألي قلقي مِن أينَ آتيهِ",80,"ه",1,1],["لا تُؤلِمي ألمي لا تُقلِقي قلقي","دعيهما فهما في آخر الرَّمقِ",81,"ق",1,1],["لا توقّى الدّهاسَ من حدم اليَوْ","م ولا المُنْتَضَى من الخبراتِ",82,"ت",1,0],["لا توحِشُ النَفرَ الكِرا","مَ فَأَنتَ مِن نَفَرٍ كِرامِ",83,"م",1,0],["لا تَوَهَّمهُ بَعيداً","إِنَّما الآتي قَريبُ",84,"ب",1,0],["لا تُؤثر النوم في حال تَضن بِها","لَكم تَنام طَويلاً بَعدها وَكَم",85,"م",1,0],["لا تؤثرن قَومك للحميه","وَنسبة في الأَصل يعربيه",86,"ه",1,0],["لا توزع الفكر فيما لا تقوم به","إلا المقادير والزم جانباً وسطا",87,"ط",2,0],["لا توجعوا تلك القلوب فحسبها","خام من الزمان الجافي",88,"ف",2,0],["لا تُؤذِ فتُؤذ معابقةً","فبما عاملتَ أخي استلمِ",89,"م",1,0],["لا تُوهَمَنَّ فَإِنَّ أَيسَرَ جُودِهِ","لَو سَحَّ في بَلَدٍ لَسالَ غَدِيرُهُ",90,"ر",2,0],["لا تولني إلا رضا","ك فانني برضاك قانع",91,"ع",1,0],["لأتَوا بكُلِّ مُصِيبَةٍ وَلَد كدَكوا ال","إسلاَمَ فَوقَ قَواعِدِ الأركَانِ",92,"ن",1,0],["لاَ تُوحِشَنَّكَ غُربَةٌ بَينَ الوَرَى","فَالنَّاسُ كَالأموَاتِ فِي الحَيَّانِ",92,"ن",1,0],["لا تؤثر الأدنى على الأعلى فتح","رم ذا وذا يا ذلة الحرمان",92,"ن",1,0],["لا تؤثر الأدنى على الأعلى فان","تفعل رجعت بذلة وهوان",92,"ن",1,0],["لا تؤثروا الدنيا على غيرها","ففرق ما بينهما واضح",93,"ح",1,0],["لا تؤخِّر يوماً غداة سرورٍ","لعشيٍّ وفته قبل فواتك",94,"ك",1,0],["لا توعدني بقوم انت ن