,"من جلق يوم عظيم الشان",10,"ن",1,0],["يوم خانت عهوده في اخيه","امة قد غوت وطال عماها",11,"ا",3,0],["يوم خان وهالخيانه إيه .. بالله","آية اللي نافق بقوله عشيره",12,"ر",2,0],["يومٌ خلعت عليها ليل عجاجةٍ","شهب الأسنة في دجاها تزهر",13,"ر",1,0],["يَوْمُ خَزَازَى يُعِيدُ دَوْرَتَهُ","وَبِئْسَ جُنْدٌ ليَوْمِ مَعْرَكَةِ",14,"ه",1,0]]}