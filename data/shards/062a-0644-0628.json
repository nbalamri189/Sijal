{"poems":[[65,"أقول لسعد وهو خلي بطانة","https://www.aldiwan.net/poem45699.html","الطويل"],[44,"تلبس لي يوم التقينا عويمر","https://www.aldiwan.net/poem50342.html","الطويل"],[24,"إن يدركك موت أو مشيب","https://www.aldiwan.net/poem21858.html","الوافر"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[53,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[93,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[93,"ما لهند وكل حسناء هند","https://www.aldiwan.net/poem8807.html","عموديه"],[93,"غلط القائل إنا خالدون","https://www.aldiwan.net/poem62825.html","عموديه"],[64,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[47,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[47,"تلبست للحرب أثوابها","https://www.aldiwan.net/poem64561.html","المتقارب"],[51,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[71,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[92,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[92,"بلية القلب الحساس","https://www.poetsgate.com/ViewPoem.aspx?id=178943",""],[93,"الموده","https://www.poetsgate.com/ViewPoem.aspx?id=53023",""],[93,"السماء","https://www.poetsgate.com/ViewPoem.aspx?id=53418",""],[53,"بكيتَ فلم تترك لعيْنِكَ مدمعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29517",""],[214,"تلبست وجها من حديد لمطلهم","https://www.aldiwan.net/poem13457.html","الطويل"],[234,"جعل الله كل عصر جديدا","https://www.aldiwan.net/poem51171.html","الخفيف"],[240,"ستارة ترخى على مجلس","https://www.aldiwan.net/poem31909.html","السريع"],[287,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[358,"صبرا وإلا فماذا ينفع الحزن","https://www.aldiwan.net/poem39757.html","البسيط"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[498,"وصفر كأطراف العوالي قدودها","https://www.aldiwan.net/poem67369.html","الطويل"],[500,"تلبس لباس الرضا","https://www.aldiwan.net/poem10255.html","المتقارب"],[567,"لكل قلب حبيب ظل يهواه","https://www.aldiwan.net/poem52742.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122556","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96970","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101486","الخفيف"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/141744","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104551","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63869","الطويل"],[898,"","https://poetry.dctabudhabi.ae/diwan/poem/205185","الطويل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99981","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62486","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16899","المنسرح"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177901","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203746",""],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117638","الوافر"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95553","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95559","الرمل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35777","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121545","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113781","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109547","الوافر"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2356,"","https://poetry.dctabudhabi.ae/diwan/poem/105646","الرجز"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83216","المديد"],[3002,"","https://poetry.dctabudhabi.ae/diwan/poem/73571","المتقارب"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79725","الرمل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121368","الطويل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124636","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216706","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216617","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135500","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40141","الرجز"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17774","الطويل"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111321","الطويل"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103303","المتقارب"],[4755,"ولِي شَوقٌ بهَجرِكِ ما تَأَسَّى","https://www.poetsgate.com/ViewPoem.aspx?id=186714",""],[4767,"غريب تناجيب","https://www.poetsgate.com/ViewPoem.aspx?id=88151",""],[4767,"المقام العالي","https://www.poetsgate.com/ViewPoem.aspx?id=179947",""],[4788,"يتيمه ي/ السعاده","https://www.poetsgate.com/ViewPoem.aspx?id=132273",""],[4797,"من لابتي مّره الى جدي افطيس","https://www.poetsgate.com/ViewPoem.aspx?id=71831",""],[4829,"شمّا وأم الجماجم","https://www.poetsgate.com/ViewPoem.aspx?id=34256",""],[3271,"الشعاع المقيد","https://www.poetsgate.com/ViewPoem.aspx?id=104118",""],[5277,"طفوفٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=199895",""],[5351,"نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=202600",""],[5431,"قفا نبك ماباتت عليه نفوسنا ...","https://www.poetsgate.com/ViewPoem.aspx?id=211671",""],[5490,"خضر عروش الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176332",""],[5843,"الدرب خطوه","https://www.poetsgate.com/ViewPoem.aspx?id=51284",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5976,"رحنا وطي .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30521",""],[5997,"العذراء","https://www.poetsgate.com/ViewPoem.aspx?id=214229",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[161,"قصيدتي :عن العشر","https://www.poetsgate.com/ViewPoem.aspx?id=152235",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6058,"وليدة من رحم شبة المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=192259",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""],[6300,"أنا يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81626&r=&rc=3",""]],"verses":[["تَلَبَّثْ قَليلاً يَرْمِ طَرْفي بِنَظرَةٍ","إِلى رَبواتٍ تُنبِتُ النَّفَلَ الجَعْدا",0,"د",2,0],["تَلَبَّسَ لي يَومَ التَقَينا عوَيمِرٌ","بِجابَلَقٍ في جِلدِ أَخنَسَ باسِلِ",1,"ل",1,1],["تَلَبَّثنا وَفَرَّطنا رِجالاً","دُعوا وَإِذا الأَنامُ دُعوا أَجابوا",2,"ب",3,0],["تُلبِسُ الأوجُهُ الكواسف نوراً","وهي مِنْ بَعْدُ للعقولِ سَلُوبُ",3,"ب",1,0],["تلبَّسُ أصنافاً من البزِّ خلقةً","حريراً وديباجاً وريطاً مُقَطَّعا",4,"ع",2,0],["تلبَسُ التَّاجَ فالقِيانُ لديْها","واضعات لتاجها الأذقانا",5,"ن",2,0],["تَلبِسُ التِبرَ مِئزَراً وَوِشاحاً","كُلَّما أَشرَقَت وَغابَت ذُكاءُ",6,"ا",2,0],["تَلبِسُ الثَوبَ يَومَها وَهيَ تَطري","ه وَتَطريهِ عِندَها كُلُّ خَودِ",7,"د",1,0],["تَلبَثُ الأَفياءُ ما دامَ الغُصون","فَإِذا ما ذَهَبَت لا يَبقَ في",8,"ي",1,0],["تلبث فيها مستحماً بها","يمضي عليك الفصل والفصلُ",9,"ل",1,0],["تَلَبَّث فَما الدَربُ الأُصَمُّ بِمُسهِلٍ","إِلَيها وَلا ماءُ الخَليجِ بِناضِبِ",10,"ب",1,0],["تَلَبَّستُ لِلحَربِ أَثوابَها","وَقُلتُ أَنا الرَجُلُ البُحتُري",11,"ي",1,1],["تَلبَسوا أَثوابَ عِزٍّ","فَاِسمَعوا قَولي وَعوهُ",12,"و",2,0],["تلبَّسَ أثوابَ الرياءِ تَصَنُّعا","ليغسلَ عنهُ الذمَّ والطبعُ أغلبُ",13,"ب",1,0],["تلْبَسُ العَذْرَاءُ فِي أَوْجِ العُلَى","مِنْهُ أَبْهَى حُلَلِ القَلْبِ الْوَدِيعْ",14,"ع",1,0],["تَلَبَّدَ مِثلَ ظَليلِ الغمام","وراحتْ به غُمَمٌ تُكْشَف",15,"ف",1,0],["تلبَّد لكن ما حكاه غمام","وناح ولكن أين منه حمام",16,"م",1,1],["تلبس الثوب يومها وهي تطريه ،","وتطريه عندها كلّ خوذ",17,"ذ",1,0],["تلبس التير مئزرا ووشاحا","كلما أشرقت وغابت ذكاء",18,"ا",2,0],["تلبَّسُ أصنافاً من البزِّ خلعة","حريراً وديباجاً وريْطاً مُقطَّعا",19,"ع",2,0],["تلبست وجها من حديد لمطلهم","وقلت به ألقاهم في المشاهد",20,"د",1,1],["تُلْبِسُ الملكَ والخلافة عزّاً","وتَغِيظ العدا وتُشْجِي الحسودا",21,"د",2,0],["تُلبِسُها بَهجَةَ أَنوارِهِ","أَروَعُ ما في فَضلِهِ لَبسُ",22,"س",1,0],["تلبسُ دارُ العَدلِ مِن عَدلِهِ","يَومَينِ في الأُسبوعِ تَزيينا",23,"ن",2,0],["تلبس بثوب الدهر في كل حالة","وجل في ميادين الفنون بفرسان",24,"ن",1,0],["تَلبَّسوا بِلباس الحلم مَلأمة","فَالحلم مُكتمل وَاللؤم مكتمنُ",25,"ن",1,0],["تلبثتُ في باب التواضع واقفاً","بأبوابها بين التباعد والقرب",26,"ب",1,0],["تَلبَّسها جهلاً بأنك لم تكن","لتنزِعَها لو كنتَ تنزِعُ سؤدُدا",27,"د",2,0],["تَلبَّسنَ مِن شَمسِ الأَصيلِ غَلائِلاً","فَأَشرَقنَ في الظلماءِ بِالخِلعِ الصُفرِ",28,"ر",1,0],["تلبس لباس الرضا","وخل الأمور لمن يملكُ",29,"ك",1,1],["تَلَّبسَ النَّاسُ بالأخلاقِ واشتَبَهوا","فالكلُّ قبلَ اختبارِ النَّقْدِ أشباهُ",30,"ا",2,0],["تُلَبّي صَوتَ من ناداكَ جهرا","لمنفَعَةٍ وما لَبَّيتَ صَوتي",31,"ت",2,0],["تلبي بنو عبس بن غطفان فتيةٌ","لهم قتات صبراً بأيدي الأجانب",32,"ب",1,0],["تلبس العُري لا كساءٌ يقيها","لفحةُ البرد لا وقود اصطلاءِ",33,"ا",2,0],["تلبّست بالدّنيا، فلمّا تنكّرت","تمنيّت زهداً حين لا يمكن الزُّهد",34,"د",1,0],["تُلبِّي بلفظٍ يقرعُ الذّهنَ سُجعُهُ","فينقذُ أَسماعَ العقولِ مِن الصَّمم",35,"م",1,0],["تَلبَّسْن ثوباً عُصْفُريّاً تخالها","إذا لحظتها العينُ فيه عَرائسا",36,"س",2,0],["تلبَّس عملاق بن غيداق للشقا","وللحزن والإفلاس أثواب حارس",37,"س",1,1],["تَلْبِسُهُ مِنْ طَمَعِ غَفْلَةٌ","بِالْمَطْعَمِ المَلْذُوذِ وَالُّلبْسِ",38,"س",1,0],["تلبَّس الكونُ بالاشراق والنور","لما بدا مَقْدَم السلطان تيمورِ",39,"ر",1,1],["تَلبِسُ سَمّورَةً مُشَمَّرَةً","تَصونُ أَطرافَها مِنَ العَفَرِ",40,"ر",1,0],["تلبس الحسن فوق قمصانها ثو","باً وتكساه حلّةً عريانه",41,"ن",2,0],["تلبس البدر وشاحا","وتناجي الأَنجما",42,"م",2,0],["تلبس من حباب الماءِ درعاً","أعارته منيته حُساما",43,"م",2,0],["تلبس المجد والفضائل بردا","وشيه بالندى وبيض الأَيادِى",44,"د",2,0],["تلبس المرء كبيراً حلة","من وقار وصغيرا مئزرا",45,"ر",2,0],["تَلَبَّسَ أَثوابَ الظَلامِ لِظُلمِهِ","وَلَم يَدرِ أَنَّ اللَهَ ذا الطولِ خاذِلُه",46,"ل",2,0],["تلبسوا لقراع الحرب بزتها","فأصبحوا من وراء الجسر قد عبروا",47,"ر",3,0],["تلبانة بلدي والعلم أخدمه","وفي العروض مقالي شارح الحزن",48,"ن",1,0],["تلبَسُ كلَّ مجسَدٍ مُرَحَّل","تكرمةً على بني المرحَّل",49,"ل",1,0],["تلبس امرٌ بالدين قالوا","عقيدته لقد أمست حميده",50,"ه",1,1],["تلبس لا كون ذاك قد جرى","وان يرد ان لم يكن قد ذكرا",51,"ر",2,0],["تلبس في ثنائكم","أبهى حلي وحلل",52,"ل",1,0],["تَلبَسُ الخاتَمَ في خَصرِها","وَتُريكَ الرِدفُ زُنّارا",53,"ر",2,0],["تلبس لباس الرضا بالقضا","وخل الأمور لمن يملكُ",54,"ك",1,1],["تلبسين الدر حلياً بينهم","وعليك الضر غلا من قدم",55,"م",1,0],["تلبسنَ من شمسِ الأصيلِ غلائلاً","وأشرقن في الظلماءِ في الخلعِ الصفر",56,"ر",1,0],["تَلَبَّسنَ أبراداً وأَبرَزنَ أَوجُهاً","حِسَاناً وأَظهَرنَ الجمَانَ المَخرَّصَا",57,"ص",2,0],["تلبيها إذا نشرت شذاها","على الأفنان أرواح الأنيس",58,"س",1,0],["تلبس الصب يا أُخَيّ على الصب","ب كلبس الثياب فوق الثياب",59,"ب",1,0],["تلبّس بالأنوار من حيث نشأةٍ","ومَن ثوبُه الأنوارُ لم يخشَ من لَبْسِ",60,"س",1,0],["تُلْبِسُ بَيتَ اللَّهِ وَشيَ يَمَنٍ","يَقَرأ آياتكَ مِن أَعلامِها",61,"م",3,0],["تَلَبَّطَ ما بَينَ الثَماني وَقَلهَبٍ","بِحَيثُ تَلاقى خَمصُهُ المُتَكاوِسُ",62,"س",1,0],["تلبي دماءاً رحن هدراً ونسوة","على هزل أسرى طوت كل منسم",63,"م",1,0],["تلبَّس للحرب أثوابها","وقال أنا الشاعرُ البحتري",64,"ي",1,1],["تَلَبَّسَنِي هَوَاكِ, وأَسْكَرَتْنِي","هُمُومٌ كُنتُ أَحسَبُهُنَّ مَسَّا",65,"س",2,0],["تلبي رغبة الأصحاب أنساً","وتعطيهم إذا شاؤوا مزيدا",66,"د",2,0],["تلبس الإسلام جلباباً وتُخفي","تَحته للظلم أظفاراً ونصلا",67,"ل",2,0],["تلبست الحزن والناس تلبس في فرحها هدوم","وتقهويت الألم كيف ٍ به الأوجاع مسطوره",68,"ر",2,0],["تلبس من العنّاب زين الملابيس","يوم المزاين مع ارجال الحمايل",69,"ل",1,0],["تلبّسني كَلِبْسِكَ للردائ