{"poems":[[93,"بات والكأس في الظلام","https://www.aldiwan.net/poem62746.html","عموديه"],[91,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[91,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[64,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85793","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85862","الخفيف"],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[563,"إنما الإيمان نور","https://www.aldiwan.net/poem33785.html","مجزوء الرمل"],[563,"اسقني من مدامة القدوس","https://www.aldiwan.net/poem34435.html","الخفيف"],[563,"نورطه المصطفى منه جيمع الكائنات","https://www.aldiwan.net/poem34720.html","الرمل"],[580,"قالوا التحى فاسل عنه قلت لهم","https://www.aldiwan.net/poem2989.html","السريع"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126857","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66782","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38939","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130809",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94269","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76523","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76503","الرمل"],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""]],"verses":[["وَهوَ ساهٍ كَأَنَّما","بِسِواها لَهُ مَرام",0,"م",1,0],["وهو سماء قد علت","تضيئ فيها الانجم",1,"م",1,0],["وهو سرور للذي","فيه السرور قد نضب",2,"ب",1,0],["وهو سبع بحفرة","حين مرقونس احتضر",3,"ر",1,0],["وهو سماء قد علت","تضيء فيها الأنجمُ",4,"م",1,0],["وهو سر مكتم","في ضمير الكواكب",5,"ب",1,0],["وهْوَ سيفُ اللهِ في الأرض على","مَنْ طغَى وامتازَ بالجهلِ وضَلّْ",6,"ل",1,0],["وَهوَ سارٍ بَينَ العَوالِمِ لَم تَح","صُرهُ مِن رَوضِ قَبرِهِ أَرجاءُ",7,"ا",2,0],["وهو سر الله فينا","وطريق الصالحين",8,"ن",1,0],["وهو ستر الأشياء بالنص فانٍ","في عيون المحقق المطموس",9,"س",1,0],["وهو سر ليس يخلو منه شيء في الورى","لكن الستر عليه من شخوص النسمات",10,"ت",1,0],["وهو سِوَى عارضٍ وذاك لَمىً","سالَ على الخدِّ مِنْه أَو ذَابا",11,"ب",2,0],["وهو ساقي العِطاش بالطفّ لمّا","أن أحاطت بالطاهرين لئامُ",12,"م",1,0],["وهو سَيفي ولِساني ويدي","ونَصيري أبداً لم يزلِ",13,"ل",1,0],["وَهوَ سَماعُ سيّدي الإِمامِ","الأَمجَدِ السميدَعِ الهمامِ",14,"م",1,0],["وهو سؤلي وغايتي ومرادي","وهو كهفي إذا استقلت العثارا",15,"ر",2,0],["وَهْوَ سَمَاءٌ دونَه السماء","وما أقَلَّتْ مثلَهُ الغبراء",16,"ا",2,0],["وهو سر العصا لموسى فألقت","عنده الساحرون سلما عصاها",17,"ا",3,0],["وهو سعر صغته من ادبٍ","لم تشبه شائبات الكذب",18,"ب",1,0],["وهو سعيد دهرنا في عصره","دام لنا مؤيدا بنصره",19,"ه",1,0],["وَهُوَ سر الحَياة اذ وجد المظ","لوم فيه الدوا وَفيه الافاده",20,"د",2,0],["وَهُوَ ساقيه وَحاميه وَخا","دمه من غير اجر يُستَفاد",21,"د",1,0],["وَهْوَ سَوَاءٌ فِي الثَّرَى وَضِغْثُ","مَنْ لَمْ يَنَلْهَا إِذْ عَلاَهُ اللَّهْثُ",22,"ث",1,0],["وهو سهم صائب قد فوَّقَته","في سبيل الله أبطالٌ بواسل",23,"ل",1,0],["وهو سر الله في الخلق سرى","دائما لولاه داموا في انسدام",24,"م",1,0]]}