{"poems":[[90,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[74,"لسقيا لمشمش بستانكم","https://www.aldiwan.net/poem18691.html","المتقارب"],[53,"شرب البيهقي والبين ناء","https://www.aldiwan.net/poem9232.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43874","الخفيف"],[53,"شَرِب البيهقيُّ والبينُ ناءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27258",""],[369,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[398,"عناني من الهم ما قد عناني","https://www.aldiwan.net/poem53405.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64408","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59538","الطويل"],[3071,"","https://poetry.dctabudhabi.ae/diwan/poem/34880","الرجز"]],"verses":[["لسقوط الرداء عن منكبيها","نهض الفنّ قائماً باحترام",0,"م",1,0],["لسقياً لمشمش بستانكم","فنعم الشراب ونعم الغذا",1,"ذ",2,1],["لسَقَتْهُ عدواتي جُرَعَ الموْ","تِ ولاجْتثّهُ الهجاءُ اجتثاثا",2,"ث",2,0],["لسقاَمٍ أَذابَنِي","وشُحوبٍ عَلانِيَهْ",3,"ه",1,0],["لسَقَتْهُ عداوتي جُرَعَ الموْ","تِ ولاحْتثّهُ الهجاءُ اجتثاثا",4,"ث",2,0],["لسَقاهُ القَطْرُ ما سُقِّيتُه","وسَقاني الثّغْرُ ما يَسْقي البَشاما",5,"م",2,0],["لِسَقمٍ أَلَحَّ عَلى سيدٍ","بِهِ قَد غَفرتُ ذُنوبَ الزَمانِ",6,"ن",1,0],["لسقوا لفخر غودرت","معه البواسق كالرذايا",7,"ا",3,0],["لسقي ذماء النفس تعتلج الجوى","عليك وقلبٌ للغرام مُجيب",8,"ب",1,0],["لسَقرِ قَرٍ سقرِ نفر","وما تارنَّه",9,"ن",2,0]]}