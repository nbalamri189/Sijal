{"poems":[[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[91,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[63,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[63,"أرى الشاعر الملحي راح بنا صبا","https://www.aldiwan.net/poem51803.html","الطويل"],[51,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[54,"تبدى فأين الغصن من ذلك الغصن","https://www.aldiwan.net/poem26624.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85655","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[136,"ألا يا جبرائيل نماك دود","https://www.aldiwan.net/poem54855.html","الوافر"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[147,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[190,"دموع العين أربعة تباع","https://www.aldiwan.net/poem43629.html","الوافر"],[274,"لما رأيت البز والشاره","https://www.aldiwan.net/poem26749.html","الرجز"],[354,"لبيت لما دعتني ربة الحجب","https://www.aldiwan.net/poem15534.html","البسيط"],[371,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[409,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[520,"ولي حرمة الضيف الغريب وحرمة","https://www.aldiwan.net/poem12270.html","الطويل"],[563,"حرارة عشقه تعطي بروده","https://www.aldiwan.net/poem34565.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103123","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97002","المتقارب"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34770","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77632","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77604","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77500","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136101","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124452",""],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124354",""],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89627","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52118","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75867","الطويل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102359","المتقارب"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145059","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112679","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112619","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91296","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133261","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90882","الكامل"],[4830,"القلم الحر","https://www.poetsgate.com/ViewPoem.aspx?id=195004",""],[4927,"جَلِيْدُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29843",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5092,"تحت ظلال الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=180066",""],[5121,"مُنَاجَاةٌ وِجْدَانِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=33502",""],[5121,"سَلَّةُ الْوَرْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=213917",""],[5369,"قومي يا نؤوم","https://www.poetsgate.com/ViewPoem.aspx?id=177446",""],[5382,"أعيش كأنّى","https://www.poetsgate.com/ViewPoem.aspx?id=211405",""],[5612,"طُفْ يا رَبيعْ","https://www.poetsgate.com/ViewPoem.aspx?id=187544",""],[5674,"يا أحلى دواويني","https://www.poetsgate.com/ViewPoem.aspx?id=186990",""],[5691,"ترتيلة مقدسية","https://www.poetsgate.com/ViewPoem.aspx?id=206355",""],[5736,"هو ذا سبيلي","https://www.poetsgate.com/ViewPoem.aspx?id=203852",""],[5781,"جنونٌ على مراشِفِ الضَّوء","https://www.poetsgate.com/ViewPoem.aspx?id=198553",""],[6056,"أبجدية حروفك","https://www.poetsgate.com/ViewPoem.aspx?id=130326",""],[6093,"أعمى البصيرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=203773",""],[6251,"الأرقم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76494&r=&rc=34",""],[572,"نَفَد الدّجَى وأَتى الصَّباحُ حميدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9240&r=&rc=97",""]],"verses":[["وَأَحْضِرُ تَعْلِيلاً لِشَوْقِيَ بِالْمُنَى","وَيَطْرُقُ وَجْدٌ غَالِبٌ فَأَغِيبُ",0,"ب",1,0],["وأحضر الحساب عن","كبائري واللمم",1,"م",1,0],["وإحضاري إذا حَبَّرْتُ شِعْراً","لتسمعَ ما أُحَبِّرُ والسَّلامُ",2,"م",1,0],["وأحضَرَنا محبوسةً طولَ ليلِها","معذَّبةً بالنارِ مُسْعَرةً كَرْبا",3,"ب",2,0],["وَأُحضِرَتِ الشُحَّ النُفوسُ فَكُلُّها","إِذا هِيَ هَمَّت بِالسَماحِ تَجَنَّبَت",4,"ت",1,0],["وَأَحضَرتُ في يَومِ الخَميسِ لِخِلعَةٍ","وَأُبتُ عِشاءً وَهيَ فارِغَةٌ مِنّي",5,"ن",2,0],["واحضري ساعة موتي","وانظري كيف أَموتُ",6,"ت",1,0],["وَأَحْضُرُ الشُّعَرَاءَ اللُّسْنَ قدْ وَقَفُوا","وَلِلْبَيانِ فِعَالُ الصَّارِمِ الذَّرِبِ",7,"ب",1,0],["وأحضَرَكَ الكِرامَ لِتَفتَفِيهَا","وليتَ زَمانَ حضرَتِهِ يَعودُ",8,"د",1,0],["وَأَحضَرتُ عِندَ البَيتِ رَهطي وَإِخوَتي","وَأَمسَكتُ مِن أَثوابِهِ بِالوَصائِلِ",9,"ل",1,0],["وَأَحضَرُهُم في الخَطبِ إِن عَزَّ خاطِرٌ","إِذا شاعِرٌ أَكدى وَأُفحِمَ خاطِبُ",10,"ب",1,0],["وأحضرت المحجوا بعد تندي","وصار لهم على الرحل اجتماع",11,"ع",1,0],["وَأَحضَروا المُلهَينِ لَم يَترُكوا","طَبلاً وَلا صاحِبَ زَمّارَه",12,"ر",2,0],["وَأَحضَرَتني مِن غَيبي لَتَشهَدني","جَمالُها في حِجابٍ غَيرَ مُحتَجِبِ",13,"ب",1,0],["وَأَحضَرَني مِن مَجلِسِ الأُنسِ حَضرَةً","لِعَيشي بِها خَفضٌ وَقَدري بِها نَصبُ",14,"ب",1,0],["واحضر إذا ما شئت تدريسه","ترى له يخضع من حققا",15,"ق",2,0],["وأحضرتموني في صدور مجالس","سرت بعلاكم وهي أعلى من النجم",16,"م",1,0],["وأحضرهم لهم وله بوجه","إليه منه يولي الكل جوده",17,"د",2,0],["وأحضروا له ابن قيس فحضر","أعني أبا موسى وقالوا لا تذر",18,"ر",1,0],["وأحضره الوجوب فغاب فيه","ذهولاً في الشهود عن الشهود",19,"د",1,0],["وأحضى الحمام لدى العتب ذا","لسان تلجلج في عذره",20,"ر",2,0],["وأحضر بالعيّ في مجلس","وعلمي في الكتب مستودع",21,"ع",1,0],["وَأَحضَروه بَينَهُم مَشويّاً","لِيَأكُلوه لا تَقل هَنيّا",22,"ي",2,0],["وَأَحضَروا الحِمار دون وَسوسه","وَأَدخَلوه مَعهُ في المَدرَسَه",23,"ه",1,0],["وَأَحضَر الأَكل لَهُ وَالشربا","وَشقّ بطيخاً وَأَلقى اللبّا",24,"ب",2,0],["وأحضر بحلى الريحان متشح","وأحمر برداء الورد مشمول",25,"ل",1,0],["واحضر مجالسهم والقط نفائيسهم","واشهد عرائسهم واعكف على الادب",26,"ب",1,0],["وَأحضَروه وَهوَ في وَثاقه","لِسوء ما قَدم مِن شَقاقه",27,"ه",1,0],["وأحضَرَ شَاهِدَي مَحوٍ وَمَحوٍ","وَقَد شرَطا العُذوبَةَ والعَذَابا",28,"ب",2,0],["وأَحضَرَ شَاهِدَي مَحوٍ وَمَحوٍ","وقَد شَرَط العُذُوبَةَ وَالعذابا",29,"ب",2,0],["وأَحضَرَهُ العَداوةَ من قَريبٍ","بضَربٍ بينَه وقدُ احتِراقِ",30,"ق",1,0],["وَأَحضَروهُ صَخرَةً مَلساءَ","وَقالوا أَخلِص عِندَها الدُعاءَ",31,"ا",2,0],["واحضر عشيّة باب البحر مغتبطا","فربّما نفّست عن نفس محزون",32,"ن",1,0],["وَأَحضُرُ جَمعاً أَنتَ فيهِ جَمالُهُ","أُشنِّفُ سَمعِي مِنكَ بِاللؤلؤِ الرَّطبِ",33,"ب",1,0],["وأحضرت عذري عليه الشهود","إِن عاذراً وإن تاركا",34,"ك",2,0],["واحضر إذا خطب الإمام فكن لما","يلقى الإمام من العظات فهيما",35,"م",2,0],["وأحضرِ القلبَ بكلِ حال","في سائرِ الأقوالِ والأفعال",36,"ل",1,0],["وأحضَرَ السبطَ لهذا الأمرِ","فقال ذا لا يبنغي في السر",37,"ر",1,0],["وَاحضر إِليّ وَذق مَعي","ظَلمَ المَدامةِ وَالأَغنّْ",38,"ن",1,0],["واحضر إذا حضر المحتوم من أجلى","وقت احتضارى وأمضى الأمر عزريل",39,"ل",1,0],["واحضر إذا حضر المحتوم من أجلى","وقت احتضارى بثغر منك مبتسم",40,"م",1,0],["واحضر دروس مديح حضرة أحمد","تحمد ورتل ما حفظت ورتب",41,"ب",1,0],["واحضنْ بدفئك أُمّاٍ للعُلى ثَكلتْ","لعينها قرّةً مُذ أينعتْ ثمرا",42,"ر",2,0],["وَأَحْضِنُ مِنْ \\\"بَنَاْتِ الْهِنْدِ\\\" أُنْثَىْ","لَهَاْ مِنْ أَجْوَدِ الْغِزْلاْنِ جِيْدُ",43,"د",1,0],["واحضر للشيخين قلبا مهذبا","بحبهما أهدي السلام إليهما",44,"م",2,0],["وأحضن فيكِ عُلا كبريائي","وألمسُ نجمكِ أبقى عليّا",45,"ي",2,0],["وَاحْضُنْ ضُلُوعِي رُبَّ كَتْفِي جَاذِعٌ","مِنْ مُسْلِمٍ مَا نَاءَ عَنِّي دَاهِمَا",46,"م",2,0],["وَاحْضِنْ بِنُورِ الصَّبَاحِ بُلْبُلَتتِي","وَقُلْ صَبَاحُ الْخَيْرَاتِ لِلرُّؤْدِ",47,"د",1,0],["وأُحضرت المشانق من عدوٍ","وشُيّدت السجونُ لمن يحوم",48,"م",1,0],["وأحْضنُ نفسى سدىً لا أرانى","عن الأمس حلماً ووهْماً نسانى",49,"ن",2,0],["واحْضُنْ بزَهْرِكَ - يا رَبيعُ - جَوانِحي","فشَذاكَ دَوْماً مُنْيَتي ومُرادي",50,"د",2,0],["واحضن أسايَ رهيف الحسِّ يمطرني","يا واحة الشعر ياأحلى دواويني",51,"ن",2,0],["واحضُنيني بحَنانٍ","فأنا عُدتُّ لِذاتي",52,"ت",2,0],["واحضن فؤادا كم تلهفَ للحياةِ","فقد سئمتُ من المعيشَِ قتيلا",53,"ل",2,0],["وَاحْضُنْ خُفوقَ هُنَيْهاتٍ فَبي لَهَجٌ","إلى سُفورِ وَجيعٍ لا خَباياهُ",54,"ي",3,0],["وإحضنيني قلم من بين أصابع كفوفك","آتداعى ، على ضمّة بنانك ،، سعيد",55,"د",1,0],["وأحضرُ كي أنيرَ ظلامَ فكر ٍٍ","حضورَ البدرِ جاء على وتيرَةْ",56,"ر",2,0],["وأحضن أضوائي فرارا من الدجى","وأحمل أندائي هروبا من الضما",57,"م",2,0],["واحضَرْ فإنَّ العيشَ ليسَ بِطَيّبٍ","لأَخي الصَفا ما كنتَ عنهُ بَعيدَا",58,"د",2,0]]}