{"poems":[[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[90,"أن من حاز في العلوم إجازه","https://www.aldiwan.net/poem45000.html","الخفيف"],[87,"قل للمؤيد ما دهاك","https://www.aldiwan.net/poem7356.html","مجزوء الكامل"],[45,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10683","الطويل"],[92,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[119,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[133,"بين العواصف والرياح","https://www.aldiwan.net/poem67447.html","مجزوء الكامل"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[242,"ألمم بمكناسة فموردها","https://www.aldiwan.net/poem18187.html","المنسرح"],[443,"حيا بكاس السرى سا في الأغاريد","https://www.aldiwan.net/poem2596.html","البسيط"],[457,"لا أحب الجليس فظا غليظا","https://www.aldiwan.net/poem13718.html","الخفيف"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[543,"رب الندى والهدى والفضل والحسب","https://www.aldiwan.net/poem48290.html","عموديه"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101509","الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88616","المتقارب"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134226","الوافر"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82509","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96513","الكامل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199044","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87681","الطويل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124711","الطويل"],[3055,"","https://poetry.dctabudhabi.ae/diwan/poem/131358","الطويل"],[216,"","https://poetry.dctabudhabi.ae/diwan/poem/56567","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97100","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139580",""],[463,"نديمي وما الناسُ إلا السكارى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60053&r=&rc=109",""],[402,"يا مصر خطبك خطب الشرق اجمعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54018&r=&rc=870",""],[6355,"هلال رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66597&r=&rc=57",""]],"verses":[["تَلَجْلَجَ الْبَرْقُ إِذْ طَارَ النَّعْيُ بِهِ","وَاسْتَشْعَرَتْ وِقْرَهُ الْوَخَّادَةُ الرُّسُمُ",0,"م",1,0],["تلجأ الناس في الحياة إليه","هَرَباً من جهالة وخّازه",1,"ز",2,0],["تلج الثياب وكلها","فرج يضيق لها سواك",2,"ك",1,0],["تَلَجُّ دُموعي بِالجُفونِ كَأَنَّما","جُفوني لِعَيني كُلِّ باكِيَةٍ خَدُّ",3,"د",1,0],["تُلَجلِجُ مُضغَةً فيها أَنيضٌ","أَصَلَّت فَهيَ تَحتَ الكَشحِ داءُ",4,"ا",2,0],["تَلَجّينَ حَتّى يَذهَبَ اليَأسُ بِالهَوى","وَحَتّى تَكادَ النَفسُ عَنكِ تَطيبُ",5,"ب",1,0],["تلجلجتْ بدخيل القول \" ألسنة \"","للعرب كانت قديماً زِينةَ الكتب",6,"ب",1,0],["تَلِجُ العقولَ عباقراً ونوابغاً","وتُمحِّصُ المعقولَ والمنقولا",7,"ل",2,0],["تلجلج بحر العلم فيهم مطمطما","تراثا عن الهادي وحدث عن البحر",8,"ر",1,0],["تَلِجُ الظلامَ ولا تَهاب","ولها مع البرقِ التهاب",9,"ب",1,0],["تَلِجُ الخُدورَ على البدون","تُصغي إلى حُور الجِنان",9,"ن",1,0],["تَلِجّينَ حَتّى يُزرِىَ الهَجرُ بالهَوَى","وحَتّى تَكادَ النَّفسُ عَنكِ تَطِيبُ",10,"ب",1,0],["تَلِجُ مِنْ قُبَبِ الْقُلُوبِ بِهَا","مُخْتَالَةً وَالسُّرُورُ يَُرْشُِدُهَا",11,"د",3,0],["تلجلج الدمع في الآفاق ثم جرى","لما انبرى بين تردادٍ وترديد",12,"د",1,0],["تَلِجُ الأذن قبل أن يَسْتَتِمَ القو","لَ منه النكات ذماً وحَمْدَا",13,"د",2,0],["تَلجلَجَ في وصفها المحدَثون","وحُدِّثَ رِضوانُ عنها فحارا",14,"ر",2,0],["تلجْلَجا تَخالَجا","تَوالَجا فاضْطَّرَبَا",15,"ب",2,0],["تُلجِي الضرورَاتُ في بعضِ الأمور إلَى","فِعلِ الفتَى بعضَ ما يُخلُّ بالأدبِ",16,"ب",1,0],["تلج القلوب بلا حجابٍ قبل أن","يلج المسامعَ لفظها المأثورُ",17,"ر",1,0],["تلجلجهم بشبا مقول","ذليق تمضمض في ريق صل",18,"ل",1,0],["تلجلج باسمك الناعي فلجّت","حيارى فيك لجلجت الخطايا",19,"ي",2,0],["تَلِجُ السنونَ بيوتَهم وَتَرى لهُم","عَن جارِ بَيتهم ازوِرارَ الناكِبِ",20,"ب",1,1],["تلج الظهور طوى الطراد بطونها","في كل يوم طليعةٍ ومغار",21,"ر",1,0],["تلج بثجاج من السحب هامل","كسرب سرت أيدي الصبا بقيادها",22,"د",3,0],["تلجلَجَ مِنها المَنطق العَذب وَاِنثَنَت","عَلى خَجَلٍ تحمرُّ مِنها المَلامح",23,"ح",1,0],["تلجلجتُ خور القريتين مُشَمِّراً","وشبلي معي والماء في أول الجزرِ",24,"ر",1,0],["تلجلج عزمي في الفؤاد زمانا","وما طلته أن لا يكون فكانا",25,"ن",2,1],["تَلَجْلَجَ مِنّي كلُّ عُضْوٍ ومَفْصِلٍ","كأنّي ملسوع ولا أجد الرقيَا",26,"ي",2,0],["تلجى له الحق سبحانه","كما قد تجلى بوادي طوى",27,"و",2,0],["تلجُّ على إهلاك أنفسها العدا","وأعظم إهلاك النفوس لجاجها",28,"ج",3,0],["تلجلجَ في وصفها المحدثون","وحدثَ رضوانُ عنها فخارا",29,"ر",2,0],["تلجلج البرق إذ طار النعي به","واستشعرت وقة الوخادة الرسم",30,"م",1,0],["تلجلجتْ مهجتي بين الضلوع فما","مثلي على صفعات الذنب يقتدر",31,"ر",1,0]]}