{"poems":[[53,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[77,"من لي بذكرى كلما أوجستها","https://www.aldiwan.net/poem36702.html","الكامل"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"البرق في كانونه قد نفخ","https://www.aldiwan.net/poem18532.html","السريع"],[92,"يا صميم الحياة إني وحيد","https://www.aldiwan.net/poem38927.html","الخفيف"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"اللى يحب الجمال","https://www.aldiwan.net/poem6807.html","عموديه"],[45,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem11438.html","الطويل"],[61,"عقبى دوائك صحة تغشاكا","https://www.aldiwan.net/poem51498.html","الكامل"],[61,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[61,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[66,"لم تتبع الأمر إلا كان أو كادا","https://www.aldiwan.net/poem38505.html","البسيط"],[66,"شربنا سلافا بلا آنيه","https://www.aldiwan.net/poem38521.html","المتقارب"],[97,"طوى السنين وشق الغيب والظلما","https://www.aldiwan.net/poem24940.html","البسيط"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[74,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[48,"قد سلم الصوم على الفطر","https://www.aldiwan.net/poem63344.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[113,"عذري اليك غرام لا اكيفه","https://www.aldiwan.net/poem40885.html","عموديه"],[113,"قد حرت مذ رمشت عيناك بالحور","https://www.aldiwan.net/poem41105.html","عموديه"],[126,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[126,"أيا عين جودى بالدموع السواجم","https://www.aldiwan.net/poem50525.html","الطويل"],[130,"خليلى لا لا تبديبا لى التلكيا","https://www.aldiwan.net/poem54683.html","الطويل"],[140,"لست أقضى إذا رأيتك نذرا","https://www.aldiwan.net/poem58427.html","الخفيف"],[141,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[142,"سطا جيش أهواء على من بكم لاذا","https://www.aldiwan.net/poem4459.html","الطويل"],[148,"مديح نبي الله أزكى التعبد","https://www.aldiwan.net/poem68603.html","الطويل"],[158,"تلاطم بحر جيشه وماجا","https://www.aldiwan.net/poem58954.html","الوافر"],[184,"والهف للمرء الذي","https://www.aldiwan.net/poem43737.html","مجزوء الكامل"],[208,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[208,"أوميض برق بالحمى يتوهم","https://www.aldiwan.net/poem13505.html","الطويل"],[208,"شمس المنازل قد أنارت بالفرح","https://www.aldiwan.net/poem13556.html","الكامل"],[229,"رعى الله بالبطحاء أيامنا التي","https://www.aldiwan.net/poem44565.html","الطويل"],[233,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[233,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[233,"ألا ياسمي الإمام الوصي","https://www.aldiwan.net/poem32115.html","المتقارب"],[235,"لئن غربت شمس تبدت من الشرق","https://www.aldiwan.net/poem19521.html","الطويل"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[273,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[278,"نشدتك لا تعدم الراح راحا","https://www.aldiwan.net/poem60715.html","المتقارب"],[302,"سرى البرق من نجد فهيج لي شجوي","https://www.aldiwan.net/poem16861.html","الطويل"],[347,"وسحار الجفون يريك نارا","https://www.aldiwan.net/poem15638.html","الوافر"],[351,"فؤادي لدى الغيد الحسان رهين","https://www.aldiwan.net/poem39741.html","الطويل"],[362,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[364,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[374,"سهر صالح ينير العقولا","https://www.aldiwan.net/poem59171.html","الخفيف"],[400,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[406,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[413,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[426,"من الصبابة تثني القد نيروز","https://www.aldiwan.net/poem40501.html","البسيط"],[426,"كحلت بالسحر وبالدعج","https://www.aldiwan.net/poem41429.html","المتدارك"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[456,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[459,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[459,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[462,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[462,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[466,"يا نجم أبراج الربى","https://www.aldiwan.net/poem59659.html","مجزوء الكامل"],[477,"من لي بوصفه يوما في محاكمة","https://www.aldiwan.net/poem37040.html","البسيط"],[498,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[498,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[504,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[527,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[538,"ألم تأرق لضوء البرق","https://www.aldiwan.net/poem56864.html","الهزج"],[549,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[560,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[573,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["وَسَحَبتُ مِن خُلَعِ الخَلائِفِ طارِفاً","لَحَظاتِ كُلِّ مُعانِدٍ طَمّاحِ",0,"ح",1,0],["وَسَحابُ جُودِ يَميِيِنهِ لاَ يَنْثَني","تَسْكابُهَا عَنْ وَابِلٍ هَتَّانِ",1,"ن",1,0],["وَسَحَابِ دَمْعٍ كُلَّمَا أَمْطَرْتُهُ","غَيْرَ الْقَتَادِ بِمَضْجَعِي لاَ تُنْبِتُ",2,"ت",1,0],["وسحر لفظ بأدنى ما ينمقه","عقاد ألسنة نفاث أرواح",3,"ح",1,0],["وسحبهُ تفتح أبوابها","والبرقُ فيما بيننا كالخوَخ",4,"خ",1,0],["وسَحَاباً مِنَ الرُّؤى يتهادى","في ضميرِ الآزالِ والآبادِ",5,"د",1,0],["وسحْرُ السَّماءِ الشَّجيّ الوديعُ","وسحْرُ المروجِ الشهيّ العَطِرْ",6,"ر",1,0],["وسحائب جون تدهدها","اعاصير تمرّ",7,"ر",1,0],["وسحبة الرمش فيها","من بابل السحر باقي",8,"ي",1,0],["وَسُحّي دُموعاً هامِلاتٍ كَأَنَّما","لَها آمِرٌ يَرفَضُّ مِن تَحتِ حاجِبي",9,"ب",2,0],["وسَحابُ عافِيَةٍ يَعُمُّكَ وَبْلُها","سَعَةً كما عَمَّ العُفَاةَ نَداكا",10,"ك",2,0],["وسِحْنَ بجانِبَيْ سَيحانَ حتى","رَجَعْنَ وفجُّه المعمورُ بِيدُ",11,"د",1,0],["وسحبت برد الكبرياء مفوفا","بالعجب لما صرت من طلابه",12,"ب",2,0],["وَسُحبُ نَفعِكَ إِن هَبَّت عَواصِفُها","رَأى لَها الشَوسُ إِرعاباً وَإِرعادا",13,"د",2,0],["وَسَحَّت عَلَيهِم","غُيوثُ الغُيوبِ",14,"ب",1,0],["وسحر عينيك إني مقسم بهما","لا تسألي القلب عن إخلاصه قسما",15,"م",2,0],["وَسُحْبٌ بأجوافِ الكنائن أُودعت","شآبيبها نبلٌ من الزنج لا قطرُ",16,"ر",1,0],["وَسَحَبتُ أَردانَ الظَلامِ عَلى السُرى","طولاً وَمزَّقتُ الذُيولَ عِثارا",17,"ر",2,0],["وَسُحبُكَ شَتّى مِن عَذابٍ وَرَحمَةٍ","فَمِن عارِضٍ يَسقي وَآخَرَ يَصعَقُ",18,"ق",1,0],["وَسَحَّبَ القَصفُ ذُيولَ الصِبا","في عَسكَرِ العيدانِ وَالزَمرِ",19,"ر",1,0],["وسحرُ الطبيعةِ في عُرْيها","إذا هتَكَ الفجرُ عنها الشُّفوفْ",20,"ف",1,0],["وسحاب جود يمينه لا ينثني","تسكابها عن وابل هتان",21,"ن",1,0],["وسحر طرفك والعضب الغميدبه","لكل قلب متى ما شاء يطرفه",22,"ف",2,0],["وسحر عينيك لم أأنس ببارقة","الا وثغرك يلوي برقه بصري",23,"ي",1,0],["وسحاباً يُروِى العبادَ لُجْيناً","خالصاً إن ضنَّ السحابُ بمائه",24,"ا",3,0],["وسحّى دماً بعد الدموعِ التي جَرَتْ","فحق بأن نقضى حقوقَ اللوازمِ",25,"م",1,0],["وَسُحَّا مَصُونَ الدَّمعِ في عَرصَاتِهَا","وَمُرَّا عَلَى آى الدِّيَارِ وحَيِّيَد",26,"ي",2,0],["وسحابا للجود يرعُد وعدا","ثم يَندىَ كفاًّ ويَبرُقُ بِشرا",27,"ر",2,0],["وَسَحابَةٌ لِلطالِبي","نَ سِوايَ صادِقَةُ المَخيلَه",28,"ل",2,0],["وسحب نوال الفيض تهمى بوابل","يعممه والمسلمين ومن لاذا",29,"ذ",2,0],["وَسَحَّ غَمامُ الراحَةِ المُستَهِلَّةِ","تَيَمَّن بِهِ وانوِ التَبرُّكَ باسمِهِ",30,"ه",1,0],["وسح النبل وبلاً واستجاشت","سحائبُه على الدنيا عجاجا",31,"ج",2,0],["وسحبت ذيل شبيبتي","متنزّها في سرّ كرّه",32,"ر",2,0],["وسحب الغيث قد حلت","نبات الروض بالقطر",33,"ر",1,0],["وسحاب مزن ام غمام ماطر","ام بحر جود بالمكارم منعم",34,"م",1,0],["وسحاب جودك من نداه رشاشة","تكفي وعن قلبي يزول بها الترح",35,"ح",1,0],["وسحت على أعلام سلع مرنة","غمائم بالنوء الروي استهلت",36,"ت",1,0],["وَسَحابُ نَداهُ يَن","هَلُّ وَالماءُ يَصطَفَن",37,"ن",1,0],["وَسُحبُ المَكارِمِ لا تَستَهِلُّ","وَنارُ المَظالِمِ لا تَخمَدُ",38,"د",1,0],["وَسُحبُ مَواهِبِهِ يَستَهِلُّ","وَبَحرُ مَكارِمِهِ يَطفَحُ",39,"ح",1,0],["وَسُحِّي عَلَيْنَا بِالْهِدَايَةِ وَالتُّقَى","وَرَوِّي حَشَانَا بِالْمَعَارِفِ وَالصِّدْقِ",40,"ق",1,0],["وسَحقاً لأرضِ عَفَّرَت هامَ أهلِها","إذا حلَّ فيها ثعلبٌ صار داغرا",41,"ر",2,0],["وسِحْرَ بَيَانٍ فاتَ كُلَّ مُفَوَّهٍ","فباتَ عَلَيه قارِعاً سِنَّ نادِمِ",42,"م",1,0],["وَسَحَّ كَما غَلَبَ الْمُسْتَها","مَ وَجْدٌ فَأَجْرى دُمُوعاً وَباحا",43,"ح",2,0],["وسحابة الأذيال من كل نسمة","معنبرة والليل يزمع أن يقوى",44,"ق",3,0],["وَسَحّارِ الجُفونِ يُريكَ ناراً","بِأَمواهِ البِحارِ تَزيدُ وَقدا",45,"د",2,1],["وَسحر جُفون الغيد قَد أَذهَب القُوى","لحاظ مَها هاروت عَنهنَّ قَد رَوى",46,"ر",3,0],["وسَحبُه الأذيالَ سَحبانُكمْ","يَرتجِلُ الخُطبةَ مُمْساه",47,"ا",2,0],["وَسُحبِ يَدٍ لَم تَهمِ إِلّا بِأَحمَرٍ","فَفي الحَربِ أَو في السِلمِ بِالدَمِ وَالتِبرِ",48,"ر",1,0],["وسحابُ الجفون تَسكُبُ دمعاً","من عيونٍ كأنَّ فيها سيولا",49,"ل",2,0],["وسحائب الإِقبال قد سكبت","وبْلَ الهنا لإِزالة المحل",50,"ل",1,0],["وسحابُ مِنهُ تعلَّمَتِ السُّحْ","بُ وإن لم تُشبِهْهُ كيفَ تصوبُ",51,"ب",1,0],["وسحَّ على منازلنا بنجدٍ","مُلِثُّ القطر تسكاباً وسَجْما",52,"م",2,0],["وسحر بابل مبثوثٌ بمقلتها","أم صارمٌ سنةٌ غنجٌ وتلويزُ",53,"ز",1,0],["وسحائب كفيه تحكي","سحبان الديمة حين تجي",54,"ج",2,0],["وسحاب البخور يهطل منه","ماء ورد يزجي النسيمُ قطاره",55,"ر",2,0],["وسحابِ جودٍ عن يمي","نك عمَّ ربعي مغدِقُهْ",56,"ق",2,0],["وسحرتني بخلائقٍ","كنَّ العيون فكنّ دُعجْا",57,"ج",2,0],["وسحُّوا على البيداء ماءً بروقهُ ال","ظُّبى وغَواديه الطُّلى والجماجمُ",58,"م",1,0],["وسَحابٌ هاطِلٌ مُسْحَنْفِرٌ","يُبْدِلُ الغَبْراءَ خِصْباً وغِنى",59,"ن",2,0],["وسحَّ نقسي بتسطير الثناء فلم","تسفح دموعي بين العذر والعذل",60,"ل",1,0],["وسح سحاب النبل فوق ربوعها","وسالت وصالت من ظباك الجداول",61,"ل",1,0],["وَسَحائِبُ الأَنهارِ قَد","زانَت سَماءَ الخُرَّمِ",62,"م",1,0],["وسحلته يد التاريخ مفخرة","تروى على الدهر أجيالا فأجيالا",63,"ل",2,0],["وسحرُ عُيونٍ حينَ يرمِشُ طرفُها","تُريعُ قُلوبَ العاشِقينَ بزَلْزالِ",64,"ل",1,0],["وسحَّ على الأَقوامِ وابِلُ فيضِهِ","أَباعدِهِمْ في نهجِهِمْ والأقارِبِ",65,"ب",1,0],["وسحبُ أَياديكَ فيّاضة","على واردٍ وعلى صَادر",66,"ر",1,0],["وسِحْرٌ ما بَعَثْتَ بِهِ إلَيْنا","فَرِيدَ الدَّهْرِ أَمْ سِحْرُ الْبَيانِ",67,"ن",1,0],["وَسَحَّ الماءُ مِن مُستَح","لَبٍ بِالماءِ سَحّاحِ",68,"ح",1,0],["وسحّبتُ أثوابَ الملوك على الثّرى","وغيريَ من حَلْيِ المكارمِ عاطلُ",69,"ل",1,0],["وسُحْبٌ أطبَقَتْ ولها دُخانٌ","إلى أوجِ السَّماءِ لهُ صُعودُ",70,"د",1,0],["وسِحْرُهُ حَقٌّ فكم","قد حَقَّ بي وقد حاقْ",71,"ق",1,0]]}