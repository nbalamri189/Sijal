?id=130504",""],[6102,"عِندَما قالَ حِذائِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=184457",""],[6167,"طقوس كونية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85543&r=&rc=26",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[572,"لا وَعينٌ تُدِيرُ باللّحظِ خمرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9314&r=&rc=171",""]],"verses":[["وَسَحَبتُ مِن خُلَعِ الخَلائِفِ طارِفاً","لَحَظاتِ كُلِّ مُعانِدٍ طَمّاحِ",0,"ح",1,0],["وَسَحابُ جُودِ يَميِيِنهِ لاَ يَنْثَني","تَسْكابُهَا عَنْ وَابِلٍ هَتَّانِ",1,"ن",1,0],["وَسَحَابِ دَمْعٍ كُلَّمَا أَمْطَرْتُهُ","غَيْرَ الْقَتَادِ بِمَضْجَعِي لاَ تُنْبِتُ",2,"ت",1,0],["وسحر لفظ بأدنى ما ينمقه","عقاد ألسنة نفاث أرواح",3,"ح",1,0],["وسحبهُ تفتح أبوابها","والبرقُ فيما بيننا كالخوَخ",4,"خ",1,0],["وسَحَاباً مِنَ الرُّؤى يتهادى","في ضميرِ الآزالِ والآبادِ",5,"د",1,0],["وسحْرُ السَّماءِ الشَّجيّ الوديعُ","وسحْرُ المروجِ الشهيّ العَطِرْ",6,"ر",1,0],["وسحائب جون تدهدها","اعاصير تمرّ",7,"ر",1,0],["وسحبة الرمش فيها","من بابل السحر باقي",8,"ي",1,0],["وَسُحّي دُموعاً هامِلاتٍ كَأَنَّما","لَها آمِرٌ يَرفَضُّ مِن تَحتِ حاجِبي",9,"ب",2,0],["وسَحابُ عافِيَةٍ يَعُمُّكَ وَبْلُها","سَعَةً كما عَمَّ العُفَاةَ نَداكا",10,"ك",2,0],["وسِحْنَ بجانِبَيْ سَيحانَ حتى","رَجَعْنَ وفجُّه المعمورُ بِيدُ",11,"د",1,0],["وسحبت برد الكبرياء مفوفا","بالعجب لما صرت من طلابه",12,"ب",2,0],["وَسُحبُ نَفعِكَ إِن هَبَّت عَواصِفُها","رَأى لَها الشَوسُ إِرعاباً وَإِرعادا",13,"د",2,0],["وَسَحَّت عَلَيهِم","غُيوثُ الغُيوبِ",14,"ب",1,0],["وسحر عينيك إني مقسم بهما","لا تسألي القلب عن إخلاصه قسما",15,"م",2,0],["وَسُحْبٌ بأجوافِ الكنائن أُودعت","شآبيبها نبلٌ من الزنج لا قطرُ",16,"ر",1,0],["وَسَحَبتُ أَردانَ الظَلامِ عَلى السُرى","طولاً وَمزَّقتُ الذُيولَ عِثارا",17,"ر",2,0],["وَسُحبُكَ شَتّى مِن عَذابٍ وَرَحمَةٍ","فَمِن عارِضٍ يَسقي وَآخَرَ يَصعَقُ",18,"ق",1,0],["وَسَحَّبَ القَصفُ ذُيولَ الصِبا","في عَسكَرِ العيدانِ وَالزَمرِ",19,"ر",1,0],["وسحرُ الطبيعةِ في عُرْيها","إذا هتَكَ الفجرُ عنها الشُّفوفْ",20,"ف",1,0],["وسحت شآبيب الرضا ببشامها","ولافتئت مغبوطة بشبابها",21,"ب",3,0],["وسحاب جود يمينه لا ينثني","تسكابها عن وابل هتان",22,"ن",1,0],["وسحر طرفك والعضب الغميدبه","لكل قلب متى ما شاء يطرفه",23,"ف",2,0],["وسحر عينيك لم أأنس ببارقة","الا وثغرك يلوي برقه بصري",24,"ر",2,0],["وسحاباً يُروِى العبادَ لُجْيناً","خالصاً إن ضنَّ السحابُ بمائه",25,"ا",3,0],["وسحّى دماً بعد الدموعِ التي جَرَتْ","فحق بأن نقضى حقوقَ اللوازمِ",26,"م",1,0],["وَسُحَّا مَصُونَ الدَّمعِ في عَرصَاتِهَا","وَمُرَّا عَلَى آى الدِّيَارِ وحَيِّيَد",27,"ي",2,0],["وسحابا للجود يرعُد وعدا","ثم يَندىَ كفاًّ ويَبرُقُ بِشرا",28,"ر",2,0],["وَسَحابَةٌ لِلطالِبي","نَ سِوايَ صادِقَةُ المَخيلَه",29,"ل",2,0],["وسحب نوال الفيض تهمى بوابل","يعممه والمسلمين ومن لاذا",30,"ذ",2,0],["وَسَحَّ غَمامُ الراحَةِ المُستَهِلَّةِ","تَيَمَّن بِهِ وانوِ التَبرُّكَ باسمِهِ",31,"ه",1,0],["وسح النبل وبلاً واستجاشت","سحائبُه على الدنيا عجاجا",32,"ج",2,0],["وسحبت ذيل شبيبتي","متنزّها في سرّ كرّه",33,"ر",2,0],["وسحب الغيث قد حلت","نبات الروض بالقطر",34,"ر",1,0],["وسحاب مزن ام غمام ماطر","ام بحر جود بالمكارم منعم",35,"م",1,0],["وسحاب جودك من نداه رشاشة","تكفي وعن قلبي يزول بها الترح",36,"ح",1,0],["وسحت على أعلام سلع مرنة","غمائم بالنوء الروي استهلت",37,"ت",1,0],["وَسَحابُ نَداهُ يَن","هَلُّ وَالماءُ يَصطَفَن",38,"ن",1,0],["وَسُحبُ المَكارِمِ لا تَستَهِلُّ","وَنارُ المَظالِمِ لا تَخمَدُ",39,"د",1,0],["وَسُحبُ مَواهِبِهِ يَستَهِلُّ","وَبَحرُ مَكارِمِهِ يَطفَحُ",40,"ح",1,0],["وَسُحِّي عَلَيْنَا بِالْهِدَايَةِ وَالتُّقَى","وَرَوِّي حَشَانَا بِالْمَعَارِفِ وَالصِّدْقِ",41,"ق",1,0],["وسَحقاً لأرضِ عَفَّرَت هامَ أهلِها","إذا حلَّ فيها ثعلبٌ صار داغرا",42,"ر",2,0],["وسِحْرَ بَيَانٍ فاتَ كُلَّ مُفَوَّهٍ","فباتَ عَلَيه قارِعاً سِنَّ نادِمِ",43,"م",1,0],["وَسَحَّ كَما غَلَبَ الْمُسْتَها","مَ وَجْدٌ فَأَجْرى دُمُوعاً وَباحا",44,"ح",2,0],["وسحابة الأذيال من كل نسمة","معنبرة والليل يزمع أن يقوى",45,"ق",3,0],["وَسَحّارِ الجُفونِ يُريكَ ناراً","بِأَمواهِ البِحارِ تَزيدُ وَقدا",46,"د",2,1],["وَسحر جُفون الغيد قَد أَذهَب القُوى","لحاظ مَها هاروت عَنهنَّ قَد رَوى",47,"ر",3,0],["وسَحبُه الأذيالَ سَحبانُكمْ","يَرتجِلُ الخُطبةَ مُمْساه",48,"ا",2,0],["وَسُحبِ يَدٍ لَم تَهمِ إِلّا بِأَحمَرٍ","فَفي الحَربِ أَو في السِلمِ بِالدَمِ وَالتِبرِ",49,"ر",1,0],["وسحابُ الجفون تَسكُبُ دمعاً","من عيونٍ كأنَّ فيها سيولا",50,"ل",2,0],["وسحائب الإِقبال قد سكبت","وبْلَ الهنا لإِزالة المحل",51,"ل",1,0],["وسحابُ مِنهُ تعلَّمَتِ السُّحْ","بُ وإن لم تُشبِهْهُ كيفَ تصوبُ",52,"ب",1,0],["وسحَّ على منازلنا بنجدٍ","مُلِثُّ القطر تسكاباً وسَجْما",53,"م",2,0],["وسحر بابل مبثوثٌ بمقلتها","أم صارمٌ سنةٌ غنجٌ وتلويزُ",54,"ز",1,0],["وسحائب كفيه تحكي","سحبان الديمة حين تجي",55,"ج",2,0],["وسحاب البخور يهطل منه","ماء ورد يزجي النسيمُ قطاره",56,"ر",2,0],["وسحابِ جودٍ عن يمي","نك عمَّ ربعي مغدِقُهْ",57,"ق",2,0],["وسحرتني بخلائقٍ","كنَّ العيون فكنّ دُعجْا",58,"ج",2,0],["وسحُّوا على البيداء ماءً بروقهُ ال","ظُّبى وغَواديه الطُّلى والجماجمُ",59,"م",1,0],["وسَحابٌ هاطِلٌ مُسْحَنْفِرٌ","يُبْدِلُ الغَبْراءَ خِصْباً وغِنى",60,"ن",2,0],["وسحَّ نقسي بتسطير الثناء فلم","تسفح دموعي بين العذر والعذل",61,"ل",1,0],["وسح سحاب النبل فوق ربوعها","وسالت وصالت من ظباك الجداول",62,"ل",1,0],["وَسَحائِبُ الأَنهارِ قَد","زانَت سَماءَ الخُرَّمِ",63,"م",1,0],["وسحلته يد التاريخ مفخرة","تروى على الدهر أجيالا فأجيالا",64,"ل",2,0],["وسحرُ عُيونٍ حينَ يرمِشُ طرفُها","تُريعُ قُلوبَ العاشِقينَ بزَلْزالِ",65,"ل",1,0],["وسحَّ على الأَقوامِ وابِلُ فيضِهِ","أَباعدِهِمْ في نهجِهِمْ والأقارِبِ",66,"ب",1,0],["وسحبُ أَياديكَ فيّاضة","على واردٍ وعلى صَادر",67,"ر",1,0],["وسِحْرٌ ما بَعَثْتَ بِهِ إلَيْنا","فَرِيدَ الدَّهْرِ أَمْ سِحْرُ الْبَيانِ",68,"ن",1,0],["وَسَحَّ الماءُ مِن مُستَح","لَبٍ بِالماءِ سَحّاحِ",69,"ح",1,0],["وسحّبتُ أثوابَ الملوك على الثّرى","وغيريَ من حَلْيِ المكارمِ عاطلُ",70,"ل",1,0],["وسُحْبٌ أطبَقَتْ ولها دُخانٌ","إلى أوجِ السَّماءِ لهُ صُعودُ",71,"د",1,0],["وسِحْرُهُ حَقٌّ فكم","قد حَقَّ بي وقد حاقْ",72,"ق",1,0],["وسحباً تجر بأسواقهم","ألست أميرهم البارحه",73,"ح",2,0],["وسحبان نطق في الدروس فصاحة","فدع من له في درسه عيّ باقل",74,"ل",1,0],["وسِحر البيانِ غداةَ الطَعا","نِ يردًّ ا