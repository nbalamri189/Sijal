افر"],[421,"لست أنسى الأحباب ما دمت حيا","https://www.aldiwan.net/poem46398.html","الخفيف"],[429,"للصيد فضل في ثمان فوائد","https://www.aldiwan.net/poem40762.html","الكامل"],[429,"يا حلية الآداب في","https://www.aldiwan.net/poem41009.html","مجزوء الكامل"],[429,"ورد الكتاب مصرحا ومسطرا","https://www.aldiwan.net/poem41038.html","الكامل"],[432,"أخي دع البطالة واله عنها","https://www.aldiwan.net/poem12467.html","الوافر"],[437,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[437,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[441,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[441,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[452,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[453,"نبئت أنك عن قرب ستسعدنا","https://www.aldiwan.net/poem61373.html","البسيط"],[458,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[458,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[464,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[464,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[465,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[468,"تهن بعيدك يا من غدا","https://www.aldiwan.net/poem59786.html","المتقارب"],[479,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[479,"قالوا هي الخضراء أرض فلاحة","https://www.aldiwan.net/poem37186.html","الكامل"],[479,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[500,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[500,"قالت غزيلة الغوير","https://www.aldiwan.net/poem37771.html","مجزوء الكامل"],[538,"كثر الله زمرة الأغبياء","https://www.aldiwan.net/poem48311.html","عموديه"],[551,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[551,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[558,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[558,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[558,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[558,"صدق الكتاب لمن به يتمسك","https://www.aldiwan.net/poem34273.html","الكامل"],[562,"صبرا بني الباحوط إن فقيدكم","https://www.aldiwan.net/poem52518.html","الكامل"],[562,"قف عند تربة يوسف الجلخ الذي","https://www.aldiwan.net/poem52519.html","الكامل"],[562,"في طي هذا اللحد شهم من بني","https://www.aldiwan.net/poem52653.html","الكامل"],[562,"بالماء يحيي الأرض مولاك الذي","https://www.aldiwan.net/poem52731.html","الكامل"],[575,"لعلوي جربت لا لانخفاضي","https://www.aldiwan.net/poem2751.html","الخفيف"],[575,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[585,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["وَلِذِكرَى ذاكَ الزَّمانِ حَيازِي","مِي تَلَوَّى بِالزَفرَةِ الصُّعْداءِ",0,"ا",2,0],["وَلُذْنا بأطرافِ القَوافي وحَسْبُنا","مِنَ الفَخرِ أنْ نُهدي إليه القَوافِيا",1,"ي",2,0],["ولُذْتُ الى الآمالِ وهْيَ سَفاهَةٌ","ومِلْتُ الى الأطْماعِ وهْيَ غُرورُ",2,"ر",1,0],["ولذْتُ بهِمْ منْ صَوْلَةِ الدّهْرِ عائِداً","كما جنَحَ الطّيْرُ المَروعُ الى وَكْرِ",3,"ر",1,0],["ولُذْتُمْ منَ الدّهْرِ الظَّلومِ بناصِرٍ","يَرُدُّ شَباةَ الدّهْرِ مَفْلولَةَ الحَدِّ",4,"د",1,0],["ولِذاكَ ما أهْدَتْ عُلاهُ هَديّةً","قد أعْرَبَتْ عنْ بأسِهِ وسَماحِهِ",5,"ح",2,0],["ولذا تسبيح يشهر","ولذا هوّت سجود",6,"د",1,0],["ولذّة العلم من تَذَوَّقها","أضرب عن شهده وعن ضَربه",7,"ب",2,0],["ولذلك الخدّ الخليليّ اللظى","لو ينتحي الصنم الأصمّ لجذّذا",8,"ذ",2,0],["ولذ بحماه للمكارم والهدى","تجد علمه يقري وأضيافه تقرى",9,"ر",2,0],["ولَذَّتْ أحاديثي الرجالُ وأعرضتْ","سُليمى وريَّا عن حديثي ومَهْدَدُ",10,"د",1,0],["ولذي الوزارة والإمارة صاعدٍ","رأيٌ أبَى أن لا يكون مُسدّدا",11,"د",2,0],["ولذاك قيل منوِّلٌ ومهنئٌ","نعماه حين يُنكِّدُ الأنكادُ",12,"د",1,0],["ولذاك مادحُهُ يقو","لُ مُصَدَّقاً وسواه يَزْعُمْ",13,"م",1,0],["ولذكَّرْتَ ذا وذاك جميعاً","سنَنَ الملك في بني ساسان",14,"ن",1,0],["ولذاك قَدَّمَك الملوكُ ولم تزلْ","بقديم مثلِك للملوكِ ديادِنا",15,"ن",2,0],["وَلِذا اِزدادَ بُعداً كُلَّما اِزدَدتُ اِقتِرابا","وَأُراني كُلَّما أَوشَكتُ أَدري لَستُ أَدري",16,"ي",1,0],["وَلِذاكَ قَد صَيَّرتُ قَلبي نَحلَةً","يا جَنَّتي حَتّى يَحومَ عَلَيكِ",17,"ك",1,0],["وَلِذٍّ كَطَعمِ الصَرخَدِيِّ طَرَحتُهُ","عَشِيَّةَ خِمسِ القَومِ وَالعَينُ عاشِقُه",18,"ق",2,0],["وَلَذيذُ الحَياةِ أَنفَسُ في النَف","سِ وَأَشهى مِن أَن يُمَلَّ وَأَحلى",19,"ل",2,0],["وَلِذا اِسمُ أَغطِيَةِ العُيونِ جُفونُها","مِن أَنَّها عَمَلَ السُيوفِ عَوامِلُ",20,"ل",1,0],["ولذاك رفق قوامها","لما هدا إيقادُها",21,"د",3,0],["وَلَذّاتُ أَهلِ الفَضلِ بيضٌ نَقِيَّةٌ","وَأَلسُنُ أَهلِ الصِدقِ لا تَتَلَجلَجُ",22,"ج",1,0],["وَلُذنا بِمَلكٍ لَيسَ يُخلِفُ وَعدَهُ","إِذا مَوعِدُ الوَسمِيِّ أَخلَفَ أَو أَلوى",23,"و",2,0],["وَلِذا أَنَّ مُنتَهى غايَةِ السُك","رِ حَرامٌ في سائِرِ الأَديانِ",24,"ن",1,0],["وَلُذتُ بِظِلِّ الأَعتِرافِ وَإِن جَنى","مَحافَةَ إِعراضٍ إِذا جِئتُ بِالعُذرِ",25,"ر",1,0],["وَلِذاكَ لَم يَرَني بِمَنظَرِ شاعِرٍ","تَبغي قَصائِدُهُ جَوائِزَ قَصدِهِ",26,"د",2,0],["وَلِذاكَ قيلَ مِنَ الظُنونِ جَلِيَّةٌ","صِدقٌ وَفي بَعضِ القُلوبِ عُيونُ",27,"ن",1,0],["وَلِذاكَ أَعرَقَتِ الخِلافَةُ بَعدَما","عَمِرَت عُصوراً وَهيَ عِلقٌ مُشئِمُ",28,"م",1,0],["وَلِذاكَ كانوا لا يُرأَّسُ مِنهُمُ","مَن لَم يُجَرَّب حَزمُهُ مُرؤوسا",29,"س",2,0],["وَلِذاكَ شِعري فيكَ قَد سَمِعوا بِهِ","سِحرٌ وَأَشعاري لَهُم أَشعارُ",30,"ر",1,0],["وَلِذَلِكَ اِعتَلَّ النَسيمُ وَأُلبِسَت","شَمسُ الأَصيلِ شُحوبَ شاكٍ مَدنَفِ",31,"ف",1,0],["وَلِذاكَ الثَناءُ فيهِ اِنتِظامٌ","وَلِذاكَ العَطاءُ فيهِ اِنتِثارُ",32,"ر",1,0],["وَلِذاكَ قَد كانَت مَنازِلُهُ","تَنبو بِساكِنِها وَتُقلِقُهُ",33,"ق",2,0],["ولِذاكَ أَظْهَرَتِ انْكِسَارَ جُفُونها","دَعْدٌ وآذَنَ خَدُّها بِتَوَرُّدِ",34,"د",1,0],["ولذا تَراكَ عيونُنا وقلوبُنا","مثلَ الشّهابِ على سَواءِ الهام",35,"م",1,0],["ولذا صار كل ليْثٍ هِزَبْرٍ","قانعاً من زمانِهِ بالغريف",36,"ف",1,0],["وَلِذي الهامَةِ قَد نُص","صَت عَلى مِثلِ الكُراعِ",37,"ع",1,0],["وَلِذي الثَغرِ الَّذي يُط","بِقُ بِالشَدقِ التَساعي",37,"ع",2,0],["وَلِذي الوَجعاءِ مُفضا","ها ذِراعٌ في ذِراعِ",37,"ع",1,0],["ولذي السرّةَ والأعكا","نِ والثدي المفكّك",38,"ك",1,0],["ولذاتها ثم آلامها","فأَسبلت من ذكرها أَدمعي",39,"ي",1,0],["ولذيذُ أحلامٍ وقد طاب الكرى","وتزايلت صورٌ هناك تواركي",40,"ي",1,0],["وَلَذيذُ الحَياةِ ما كانَ فَوضى","لَيسَ فيها مُسَيطِرٌ أَو أَميرُ",41,"ر",1,0],["ولذت بهم من صولة الدهر عائذا","كما جنح الطير المروع إلى وكر",42,"ر",1,0],["ولذت إلى الآمال وهي سفاهة","وهونت فيك الخطب وهو عسير",43,"ر",1,0],["ولِذا أَقلَقتَ أشتَى لَيلَةٍ","حامِلًا صُرَّتَكَ الأخرى ومِلحَك",44,"ك",1,0],["ولَذاك إِيهام يضلِّلُ أُمةً","وسلاحُ كل مضلِّلٍ إيهام",45,"م",1,0],["ولذاك قد صبّرت قلبي نحلة","يا جنّتي يحوم عليك",46,"ك",1,0],["ولذاك قد صبّرت قلبي نحلة","يا جنّتي كيما يحوم عليك",47,"ك",1,0],["ولذاك قيل منوِّلٌ ومهنىء","نعماه حين يُنكِّدُ الأنكادُ",48,"د",1,0],["ولذا اظلمت الدنيا وقد","زلزلت بالناس من فرط الحزن",49,"ن",1,0],["ولذ بأعتاب شمس المرسلين وقل","يا أكرم الخلق مالي من ألوذبه",50,"ه",1,0],["ولذت بسامي ظله وهو لاخفا","وسيلتنا العظمى إلى المتعالي",51,"ل",2,0],["ولُذْ بحِماهُ وانتبذ عنكَ غيرهُ","ولا ترْجُ من عمرو فتيلاً ولا زيدِ",52,"د",1,0],["ولذاك نُحْتُ على إخائك مثلما","ناحَ الحمامُ على الربيع الباكرِ",53,"ر",1,0],["وَلِذاكَ ما ظَنّوا نُفوسُهُمُ لَهُم","إِلّا وَأَنتَ عَلى التَرَحُّلِ مُزمِعُ",54,"ع",1,0],["وَلِذا قَصَدتَ فَلا بَرِحتَ مُوَفَّقاً","فيما تَجودُ بِهِ وَفيما تَمنَعُ",54,"ع",1,0],["وَلَذاكَ أَشرَفُ في النُفوسِ وَلَم يَزَل","رَمَضانُ يَفضُلُ دائِماً شَوّالا",55,"ل",2,0],["وَلِذاكَ حُقِّقَ ظَنُّهُ فيما أَتى","وَظُنونُ أَهلِ الخافِقينَ تَوَهُّمُ",56,"م",1,0],["ولذاك عمرو النحو مض","روبٌ وزيدٌ ضارب",57,"ب",1,0],["ولذاك أَرسى كَلْكَلاً خشعتْ لهُ","شُمُّ الحصونِ فسُوِّيتْ بصُحونِ",58,"ن",1,0],["وَلِذُلِّ ذاكَ يَعِزُّ ذا وَكَذاكمُ","لِنُحوسِ قَومٍ جَدُّ قَومٍ يَسعَدُ",59,"د",1,0],["وَلِذا كَتبتُ عَلى ثَراهُ مُؤرِّخاً","في مَنزلِ الأَخيارِ إِبراهيمُ",60,"م",1,0],["وَلِذاكَ نالَ كَما تؤرِّخُ عِندَهُ","أَسنى الكَرامةِ في النَعيمِ الخالدِ",61,"د",1,0],["وَلِذا أَتى التاريخ يَدعو قائِلاً","كُتِبَت لروجِينا الحَياةُ الدائِمةْ",62,"م",2,0],["وَلِذاكَ في تاريخها ناحَت عَلى","بَدرٍ أَتاهُ لَدى التَمامِ مَحاقَهْ",63,"ق",2,0],["وَلِذاكَ خَطَّ مُؤرِّخوهُ بِلَحدِهِ","يا قَبرَ اِبرهيمَ جاورَكَ الرِضى",64,"ض",2,0],["وَلِذا كَتَبَتُ مُؤرِّخاً نَظمي بِها","إِن النَعيمَ صَفا لِسمَعانَ الصَّفا",65,"ف",2,0],["وَلِذا هَتَفَتُ مُؤرِّخاً في إِثرها","بِجِوارِ سَيدةِ المَراحِمِ سَيِّدهْ",66,"د",2,0],["وَلِذا مُؤرِّخُهُ بَكاهُ قائِلاً","لَهَفِي لَوَ اُنَّكَ تَشتَري يا يُوسُفُ",67,"ف",1,0],["وَلِذاكَ أَدرَكَ في مَراتعِ رَبِّهِ","أَرَّخَتُ حَظَّ سَعادةِ الأَبرارِ",68,"ر",1,0],["وَلذا نَسيمُ العَرشِ كُلّ صَبيحةٍ","أَرِّخ يَهُبُّ عَلى ثَراهُ بِالرِضَى",69,"ض",2,0],["وَلِذةُ أَعيُنٍ نامَت وَلَكن","سَيعقُبُ نَومَها دَمعٌ حَريرُ",70,"ر",1,0],["ولذكركم في مِسْمَعىَّ لَذاذةٌ","كالماء عذبا في لَهاةِ الصّادي",71,"ي",1,0],["وَلِذي النورِ أشرقَ السوطُ كالمص","باحِ منهُ والجبهةُ الغرّاءُ",72,"ا",2,0],["وَلِذاكَ النِصابِ صَورَةُ كَفٍّ","وُضِعَت مِنهُ مَوضِعَ الأَذنابِ",73,"ب",1,0],["ولذخرنا آل الصباح","وإنّهم نعم السواعد",74,"د",1,0],["ولذا تفاوتتِ الحسانُ فهذهِ","أختُ الوفا والغدرُ شيمة هاتهِ",75,"ت",2,0],["ولذاكَ الدلالِ يتركُ من عز","ذليلاً فكلُّ صبٍّ ذليلُ",76,"ل",1,0],["ولِذَاك لا يَصْفُو الثناءُ لفاعل","خيراً ولا يُجْزاه إن لم يُتْمم",77,"م",1,0],["وَلذكره المَرفوع مُقتَرِنٌ إِلى","ذِكرِ الإِلَهِ فَلَيسَ يَفتَرِقانِ",78,"ن",1,0],["وَلِذُبَّلٍ تَحتَ العَجاجِ كَأَنَّما","أَرفَعنَ مِن خِرصانِها ذُبّالا",79,"ل",2,0],["وَلِذاكَ غِلظَةُ ظالِمٍ","مُتَجَبِّرٍ مُتَمَرِّدِ",80,"د",1,0],["وَلُذْ بِحِمَاهُ فِإِنَّ حِمَاهُ","أَمَانٌ لِمَنْ قَدْ بَرَتْهُ الْمِحَنْ",81,"ن",1,0],["ولذا شطحنا مذ مدحنا ذاتَ من","بصفاته أمسى الصفاء مقيما",82,"م",2,0],["ولذَّ لهم فسادٌ كان منهم","كسم