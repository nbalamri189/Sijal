{"poems":[[63,"هذه دارها على الخلصاء","https://www.aldiwan.net/poem45779.html","الخفيف"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[77,"أما وخيال في المنام يزور","https://www.aldiwan.net/poem36492.html","الطويل"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[77,"عبد العزيز خليفة الله الذي","https://www.aldiwan.net/poem36624.html","الكامل"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[72,"قاضي القضاة المرتجى دمت ذا","https://www.aldiwan.net/poem18681.html","السريع"],[72,"تذكرت مصرا والأخلاء والدهرا","https://www.aldiwan.net/poem18713.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"ولقد رأيتك واليا مستعليا","https://www.aldiwan.net/poem61839.html","الكامل"],[51,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[51,"عطفا بني وهب علي","https://www.aldiwan.net/poem66309.html","مجزوء الكامل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"لما رأيت الورد في خديك","https://www.aldiwan.net/poem9049.html","عموديه"],[38,"يا عجبا للدهر شتى طرائقه","https://www.aldiwan.net/poem7734.html","الطويل"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[62,"بالنار صنعتها وفيها","https://www.aldiwan.net/poem52236.html","مجزوء الكامل"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[66,"وحقك إني قانع بالذي تهوى","https://www.aldiwan.net/poem38475.html","الطويل"],[66,"ضعف رأسي وقلة الإيمان","https://www.aldiwan.net/poem39039.html","الخفيف"],[66,"أما والهوى لو ذقت طعم الهوى العذري","https://www.aldiwan.net/poem39526.html","الطويل"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[44,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[81,"أهدت نجاتك عوذة المتخوف","https://www.aldiwan.net/poem61460.html","الطويل"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[52,"هذا الفراق وكنت أفرقه","https://www.aldiwan.net/poem26805.html","الكامل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[75,"يا ذا البديهة في المقال أما كفت","https://www.aldiwan.net/poem69033.html","الكامل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[48,"قل لاسماعيل ذي الخال","https://www.aldiwan.net/poem64388.html","مجزوء الرمل"],[48,"قل لذي الوجه المترك","https://www.aldiwan.net/poem66290.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85645","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39672","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[77,"أدارهم بين الأجارع فالسدر","https://www.poetsgate.com/ViewPoem.aspx?id=34094",""],[77,"أما وخيال في المنام يزور","https://www.poetsgate.com/ViewPoem.aspx?id=34134",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[91,"روحي فداك","https://www.poetsgate.com/ViewPoem.aspx?id=53148",""],[91,"يا جنتي","https://www.poetsgate.com/ViewPoem.aspx?id=53151",""],[51,"أنَّى تماطلني وأنت جَوَادُ","https://www.poetsgate.com/ViewPoem.aspx?id=27799",""]],"verses":[["وَلِذِكرَى ذاكَ الزَّمانِ حَيازِي","مِي تَلَوَّى بِالزَفرَةِ الصُّعْداءِ",0,"ا",2,0],["وَلُذْنا بأطرافِ القَوافي وحَسْبُنا","مِنَ الفَخرِ أنْ نُهدي إليه القَوافِيا",1,"ي",2,0],["ولُذْتُ الى الآمالِ وهْيَ سَفاهَةٌ","ومِلْتُ الى الأطْماعِ وهْيَ غُرورُ",2,"ر",1,0],["ولذْتُ بهِمْ منْ صَوْلَةِ الدّهْرِ عائِداً","كما جنَحَ الطّيْرُ المَروعُ الى وَكْرِ",3,"ر",1,0],["ولُذْتُمْ منَ الدّهْرِ الظَّلومِ بناصِرٍ","يَرُدُّ شَباةَ الدّهْرِ مَفْلولَةَ الحَدِّ",4,"د",1,0],["ولِذاكَ ما أهْدَتْ عُلاهُ هَديّةً","قد أعْرَبَتْ عنْ بأسِهِ وسَماحِهِ",5,"ح",2,0],["ولذا تسبيح يشهر","ولذا هوّت سجود",6,"د",1,0],["ولذّة العلم من تَذَوَّقها","أضرب عن شهده وعن ضَربه",7,"ب",2,0],["ولذلك الخدّ الخليليّ اللظى","لو ينتحي الصنم الأصمّ لجذّذا",8,"ذ",2,0],["ولذ بحماه للمكارم والهدى","تجد علمه يقري وأضيافه تقرى",9,"ر",2,0],["ولَذَّتْ أحاديثي الرجالُ وأعرضتْ","سُليمى وريَّا عن حديثي ومَهْدَدُ",10,"د",1,0],["ولذي الوزارة والإمارة صاعدٍ","رأيٌ أبَى أن لا يكون مُسدّدا",11,"د",2,0],["ولذاك قيل منوِّلٌ ومهنئٌ","نعماه حين يُنكِّدُ الأنكادُ",12,"د",1,0],["ولذاك مادحُهُ يقو","لُ مُصَدَّقاً وسواه يَزْعُمْ",13,"م",1,0],["ولذكَّرْتَ ذا وذاك جميعاً","سنَنَ الملك في بني ساسان",14,"ن",1,0],["ولذاك قَدَّمَك الملوكُ ولم تزلْ","بقديم مثلِك للملوكِ ديادِنا",15,"ن",2,0],["وَلِذا اِزدادَ بُعداً كُلَّما اِزدَدتُ اِقتِرابا","وَأُراني كُلَّما أَوشَكتُ أَدري لَستُ أَدري",16,"ي",1,0],["وَلِذاكَ قَد صَيَّرتُ قَلبي نَحلَةً","يا جَنَّتي حَتّى يَحومَ عَلَيكِ",17,"ك",1,0],["وَلِذٍّ كَطَعمِ الصَرخَدِيِّ طَرَحتُهُ","عَشِيَّةَ خِمسِ القَومِ وَالعَينُ عاشِقُه",18,"ق",2,0],["وَلَذيذُ الحَياةِ أَنفَسُ في النَف","سِ وَأَشهى مِن أَن يُمَلَّ وَأَحلى",19,"ل",2,0],["وَلِذا اِسمُ أَغطِيَةِ العُيونِ جُفونُها","مِن أَنَّها عَمَلَ السُيوفِ عَوامِلُ",20,"ل",1,0],["ولذاك رفق قوامها","لما هدا إيقادُها",21,"د",3,0],["وَلَذّاتُ أَهلِ الفَضلِ بيضٌ نَقِيَّةٌ","وَأَلسُنُ أَهلِ الصِدقِ لا تَتَلَجلَجُ",22,"ج",1,0],["وَلُذنا بِمَلكٍ لَيسَ يُخلِفُ وَعدَهُ","إِذا مَوعِدُ الوَسمِيِّ أَخلَفَ أَو أَلوى",23,"و",2,0],["وَلِذا أَنَّ مُنتَهى غايَةِ السُك","رِ حَرامٌ في سائِرِ الأَديانِ",24,"ن",1,0],["وَلُذتُ بِظِلِّ الأَعتِرافِ وَإِن جَنى","مَحافَةَ إِعراضٍ إِذا جِئتُ بِالعُذرِ",25,"ر",1,0],["وَلِذاكَ لَم يَرَني بِمَنظَرِ شاعِرٍ","تَبغي قَصائِدُهُ جَوائِزَ قَصدِهِ",26,"د",2,0],["وَلِذاكَ قيلَ مِنَ الظُنونِ جَلِيَّةٌ","صِدقٌ وَفي بَعضِ القُلوبِ عُيونُ",27,"ن",1,0],["وَلِذاكَ أَعرَقَتِ الخِلافَةُ بَعدَما","عَمِرَت عُصوراً وَهيَ عِلقٌ مُشئِمُ",28,"م",1,0],["وَلِذاكَ كانوا لا يُرأَّسُ مِنهُمُ","مَن لَم يُجَرَّب حَزمُهُ مُرؤوسا",29,"س",2,0],["وَلِذاكَ شِعري فيكَ قَد سَمِعوا بِهِ","سِحرٌ وَأَشعاري لَهُم أَشعارُ",30,"ر",1,0],["وَلِذَلِكَ اِعتَلَّ النَسيمُ وَأُلبِسَت","شَمسُ الأَصيلِ شُحوبَ شاكٍ مَدنَفِ",31,"ف",1,0],["وَلِذاكَ الثَناءُ فيهِ اِنتِظامٌ","وَلِذاكَ العَطاءُ فيهِ اِنتِثارُ",32,"ر",1,0],["وَلِذاكَ قَد كانَت مَنازِلُهُ","تَنبو بِساكِنِها وَتُقلِقُهُ",33,"ق",2,0],["ولِذاكَ أَظْهَرَتِ انْكِسَارَ جُفُونها","دَعْدٌ وآذَنَ خَدُّها بِتَوَرُّدِ",34,"د",1,0],["ولذا تَراكَ عيونُنا وقلوبُنا","مثلَ الشّهابِ على سَواءِ الهام",35,"م",1,0],["ولذا صار كل ليْثٍ هِزَبْرٍ","قانعاً من زمانِهِ بالغريف",36,"ف",1,0],["وَلِذي الهامَةِ قَد نُص","صَت عَلى مِثلِ الكُراعِ",37,"ع",1,0],["وَلِذي الثَغرِ الَّذي يُط","بِقُ بِالشَدقِ التَساعي",37,"ع",2,0],["وَلِذي الوَجعاءِ مُفضا","ها ذِراعٌ في ذِراعِ",37,"ع",1,0],["ولذي السرّةَ والأعكا","نِ والثدي المفكّك",38,"ك",1,0],["ولذاتها ثم آلامها","فأَسبلت من ذكرها أَدمعي",39,"ي",1,0],["ولذيذُ أحلامٍ وقد طاب الكرى","وتزايلت صورٌ هناك تواركي",40,"ي",1,0],["وَلَذيذُ الحَياةِ ما كانَ فَوضى","لَيسَ فيها مُسَيطِرٌ أَو أَميرُ",41,"ر",1,0],["ولذت بهم من صولة الدهر عائذا","كما جنح الطير المروع إلى وكر",42,"ر",1,0],["ولذت إلى الآمال وهي سفاهة","وهونت فيك الخطب وهو عسير",43,"ر",1,0],["ولِذا أَقلَقتَ أشتَى لَيلَةٍ","حامِلًا صُرَّتَكَ الأخرى ومِلحَك",44,"ك",1,0],["ولَذاك إِيهام يضلِّلُ أُمةً","وسلاحُ كل مضلِّلٍ إيهام",45,"م",1,0],["ولذاك قد صبّرت قلبي نحلة","يا جنّتي يحوم عليك",46,"ك",1,0],["ولذاك قد صبّرت قلبي نحلة","يا جنّتي كيما يحوم عليك",47,"ك",1,0],["ولذاك قيل منوِّلٌ ومهنىء","نعماه حين يُنكِّدُ الأنكادُ",48,"د",1,0]]}