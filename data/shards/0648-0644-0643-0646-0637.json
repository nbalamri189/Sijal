{"poems":[[47,"تعست فما لي من وفاء ولا عهد","https://www.aldiwan.net/poem63524.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[139,"نعم أذكرتني حين هبت صبا نجد","https://www.aldiwan.net/poem49118.html","الطويل"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[409,"خليلي سيرا بي إلى ذلك السرب","https://www.aldiwan.net/poem34156.html","الطويل"],[411,"تكدر لي من كنت أرجو صفاءه","https://www.aldiwan.net/poem49938.html","الطويل"],[484,"دخلت مداخلا لا بد منها","https://www.aldiwan.net/poem37588.html","الوافر"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101201","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101037","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65937","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82836","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91130","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94633","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57980","الوافر"],[4677,"إليه .....","https://www.poetsgate.com/ViewPoem.aspx?id=204572",""],[4984,"ويرهقك السعي","https://www.poetsgate.com/ViewPoem.aspx?id=215650",""],[5848,"الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=53098",""],[6068,"فذا فرض وذا قصدًهْ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175911",""]],"verses":[["ولَكِنَّ طَبعاً لَيسَ لي فيهِ حيلَةٌ","وَلا مَذهَبٌ في الهَزلِ عِندي وَلا الجِدِّ",0,"د",1,0],["ولكِنّ طَوداً لم يُحَلْحَلْ رَسِيُّهُ","وفارعَةً قَعْساء لم تُتَسَنَّم",1,"م",1,0],["ولكن طلابَ الرزقِ عنه يصدني","ولا جائزاً أن يلتقي الضد بالضدِ",2,"د",1,0],["ولكن طواغيت البغاة تقاعسوا","خوارج فيما بينهم قد تحزبوا",3,"ب",3,0],["ولكنَّ طبع الدهر خفض ذوي العلى","ورفع ذوي جهل وتعظيم ذي نَصْب",4,"ب",1,0],["ولكِنَّ طَبعاً للزّمانِ عَرَفْتُهُ","فماليَ لا أَسْلُو ولا أتصَبَّرُ",5,"ر",1,0],["ولكن طانني ربي فأمسى","على يدها افتخاري فليصنها",6,"ن",3,0],["ولكن طعن ذلك في لساني","وشعلة تلك في وسط الفؤاد",7,"د",1,0],["ولكن طيب المسك لا بد ذائع","يشق إلى مستنشقيه الحوائلا",8,"ل",2,0],["ولكن طلاب العز أولى من الثوى","على حالة الارغام بين الرغائب",9,"ب",1,0],["وَلكِن طيبُ ذكرِكَ لَيسَ إِلا","وَطيبُ الذِكر يستدعي الثَناءَ",10,"ا",2,0],["وَلكن طَبيب القَوم يَعلم أَنَّهُ","إِذا ما التقينا أَنّ حانطه مثري",11,"ر",2,0],["ولكنَّ طرفي ظلَّ يحسدُ مسمعي","بذكرٍ من الأطيابِ قد جاءِ أطيبا",12,"ب",2,0],["ولكن طَبْعُنَا لم نَشْكُ دهراً","ولو يسطو بذي ظفر وناب",13,"ب",1,0],["ولكن طال بُعدك والتجافي","هسيس الشوَق أرَّق مقلتيَّا",14,"ي",2,0],["ولكن طول المدى لفها","بصبر تعزز بالحذر",15,"ر",1,0],["ولكن طفلةٍ لا سولفت تستيقظ الأزهار","خذتني للضياع وقلت لجلك باعكس الطاره",16,"ر",2,0],["ولكن طلع أحلامي","بوجه فاتن ردًّهْ",17,"د",2,0]]}