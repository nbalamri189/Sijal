s://www.poetsgate.com/ViewPoem.aspx?id=1356",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5694,"بلشة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=132102",""],[5720,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199926",""],[5829,"بلبل الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=176836",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[5851,"المدينة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=175306",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[5883,"اسامة","https://www.poetsgate.com/ViewPoem.aspx?id=17912",""],[5885,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=194688",""],[192,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=16376",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[5956,"الوطن العربي","https://www.poetsgate.com/ViewPoem.aspx?id=192339",""],[5977,"الغائب الحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=213085",""],[5977,"بوحي فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=214580",""],[6003,"أزقة مجنونه","https://www.poetsgate.com/ViewPoem.aspx?id=188917",""],[6003,"يا بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=189046",""],[6090,"البدر أشرق أم جبين سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=170910",""],[6209,"فطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82548&r=&rc=17",""],[6225,"وثيقة ُ العفو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78062&r=&rc=147",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""]],"verses":[["يا بلاد الامريك انا معزو","ك على رزء قد ابى ان يهونا",0,"ن",2,0],["يا بلدا ما فيه","ذو ناظر يبكيه",1,"ه",1,0],["يا بَلائي مِن غَزالٍ","قَد سَبا قَلبي وَلُبّي",2,"ب",2,0],["يا بَلائي وَيا تَقَلقُلَ أَحشا","ئي وَنَفسي لِطائِرٍ نَعّابِ",3,"ب",1,0],["يا بَلائي قَد طُلتَ حَتّى لَوَ اَنّي","مِن حَديدٍ لَذابَ ذاكَ الحَديدُ",4,"د",1,0],["يا بلبل الروض غرِّد","فأنت أنت السجاع",5,"ع",1,0],["يَا بِلاَدِي هَلْ فِي الْعَنَاءِ كَمَا عَا","نَيْتِهِ مِنْ ضُرُوبِ الاسْتِعْبَادِ",6,"د",1,0],["يَا بِلاَدِي إِليْكِ يَهْفُو فُؤَادِي","كَلَّ آنٍ شَوْقاً وَيَلْتَاعُ وَجْدَا",7,"د",2,0],["يَا بُلْبُلَ الْبَلَدِ الأَمِينِ وَمُؤنِسَ الْ","لَيْلِ الْحَزِينِ بِمُطْرِبِ الأَصْدَاءِ",8,"ا",2,0],["يا بلادي إلّي يقولون عنها","منك ناري ولي دخان اتّقادي",9,"د",2,0],["يا بلادي هذي الرّبى والسواقي","في ضلوعي تنهّدات شوادي",9,"د",2,0],["يا بلدةً كدَّتِ التاريخَ سيرتُها","وقرَّحت من رُواة الشعر أجفانا",10,"ن",2,0],["يا بلدةً، يَحْمَرُّ -من","خَجَلٍ بها- وَجْهُ الهلال",11,"ل",1,0],["يا بلادي : وأنثني أشغل التفتيش","عنّي ، وعن بلادي الصريعة",12,"ع",2,0],["يا بلادي التي يقولون عنها :",".منك ناري ولي دخان اتقادي",13,"د",2,0],["يا بَلاَئِي قط طُلْتَ حَتَّى لَوَ أنِّي","من حديد لذاب ذاك الحديد",14,"د",1,0],["يا بلادة حسّي . وقمّة حنيني","يا أختياري ..لا .. يا عشواء .. أختياري",15,"ر",2,0],["يَا بَلِيدَ الزَّمَانِ يَا غَيبَةَ السب","بِ أَلَستَ الدَّوِيَّ الحَلِيفَ الذَّميمَا",16,"م",2,0],["يا بَلْدَتي إنْ يَغِب مَغْناك عن نظري","فإنه في سَوادِ القلب لم يَغِب",17,"ب",1,0],["يا بِلادي كَفاكِ هزءاً بِنَفسي","إِنَّ نَفسي حسامُكِ المَطرورُ",18,"ر",1,0],["يا بلبلاً يصدح في غصنه","فيرقص الوادي على لحنه",19,"ه",1,1],["يا بلبلاً غرِداً غني فأشجانا","لم يبق قلبٌ وما روّاه ألحانا",20,"ن",2,1],["يا بلادي يا مشرق النور والفن","ومهد العلوم والأديان",21,"ن",1,0],["يا بلبلاً غَنّى فَهاجَ بَلابلي","حوشيت مِن غَدر الزَمان وَغشّهِ",22,"ه",1,1],["يا بَلدةً قرَأَت فَأخَّرَ بعلَها ال","شرعيَّ عن إِتيانها أَقراؤُها",23,"ا",3,0],["يَا بَلائِي مِنَ التِي خَتَلَتْنِي","بِدَلاَلِ بِهِ تُصَادُ النُّفُوسُ",24,"س",1,1],["يا بلبل الكرسىّ الأنطاكي في","نغماته طربت لها الأطيار",25,"ر",1,0],["يا بلاداً فيها جرى النيلُ عَذبا","فسقاها ووسع الأرض خصبا",26,"ب",2,1],["يا بلاء السماء والأرضِ مهلاً","زاد ما عاد منك عندي وجلّا",27,"ل",2,1],["يا بلدةً ما زال يعظمُ قدرُهَا","في كلِّ ناحية ويعظمُ شانها",28,"ن",3,0],["يا بلدة أصبحت لبنان ناضرة","بين البلاد بها حييت من بلد",29,"د",1,1],["يا بلدة الحزْمِ اشكري ذا العلا","شكراً على نيل المنى والمراد",30,"د",1,0],["يا بلائي وموضعَ السر مني","وسُروري هلاَّ رحمتَ الغريبا",31,"ب",2,0],["يا بِلادي يا مُنى قَلبيَ إِن","تَسلَمي لي أَنتِ فَالدُنيا هَدَرْ",32,"ر",1,0],["يا بِلادي أَرشِفيني قَطرَةً","كُلُّ ماءٍ غَيرَ ما فيكَ كَدَرْ",32,"ر",1,0],["يا بلدة تعلي الجهول","وتخفض الفذ اللسن",33,"ن",1,0],["يا بلاد اللَه البسيطة موري","أسفاً واسقطي له يا سماء",34,"ا",2,0],["يا بليغا يروم حصر علاه","أيطول السماك ذو تقصير",35,"ر",1,0],["يا بليغا بنو القريض لديه","ما اصروا واستكبروا استكبارا",36,"ر",2,0],["يا بَلدَ الله الأمين الذي","قد زَاغَ عَنه بَصَرُ الكافِر",37,"ر",1,0],["يا بَليغاً كُل لَفظٍ مِنهُ قَد","ضَمنت فيهِ مَعانٍ لا تَعد",38,"د",1,0],["يا بلدة ليس فيها","للعلم والفضل سوق",39,"ق",1,1],["يا بلاد الخيرات والنور حقا","يلا بلاد الاخيار والابرار",40,"ر",1,0],["يا بلادي مالي لا ارى غير واطيء","ثراك ألما يبقى في الناس لائم",41,"م",1,0],["يا بل إذن ولم ألم كأن أيا","لكن معا فريد كي خمس هيا",42,"ي",2,0],["يا بلادي وتلك قصة شعب","شتتته مظالم الأضداد",43,"د",1,0],["يا بلبل الأَلباب يا شمخشال","يا من أَقرت بالمزار عينا",44,"ن",2,0],["يا بليغا أتى قريضُك يهمي","غِبَّ شوق بوبل أنس لهائم",45,"م",1,1],["يا بليلاً أوحش عود الأراك","أغرقت في البين فأين أراك",46,"ك",1,1],["يا بُلبل الأَشواق من","قَلبي عَلى ذا الغُصن صِح",47,"ح",1,0],["ياب لي في مسمعي همسا","حرّكت من قلبي اجراسه",48,"س",2,0],["يا بِلادي وَأَنتِ أَخصَبُ أَر","ضِ اللَهِ ما لي أَراكِ مَرعىً وَبيلا",49,"ل",2,0],["يا بِلادي وَكَم دُموعي تَحلو","في هَواها وَكَم يَلَذُّ عَذابي",50,"ب",2,1],["يا بِلادي فِداكِ كُلُّ عَزيزٍ","لا تَذِلّي وَجاهِدي تَستَفيدي",51,"د",2,0],["يا بُلبُلَ الأَغصانِ حالُكَ في الهَوى","حالي وَلَكِن أَنتَ فيه مُوَفَّقُ",52,"ق",1,0],["يا بلاداً تضمها كلمات","هي أقوى من مدفع وحسام",53,"م",1,0],["يا بلبل الأفراح في دوح المنى","وهزار أنس الواله المشتاق",54,"ق",1,0],["يا بِلادي أَنتَ رُوحي","كَيفَ أَحيى إِمّا تَنأين",55,"ن",1,0],["يا بلبلاً لَوتِ الرَّياحُ جناحَهُ","فغدا يكافِحُها بغير جنَاح",56,"ح",1,0],["يا بلقسي وأراني قد فديت","أنفس الأنفس من عشاقه",57,"ه",1,0],["يا بلبلاً راقت له وردةٌ","فراح يُشجيها بصافي غناهْ",58,"ه",1,1],["يا بلداً فيه الخنا قد جُمعا","تالله ما أجمله مستنقعا",59,"ع",2,1],["يا بلدةً جمعتْ جهلاً وإرهاقا","وما حوت أبداً علما وأخلاقا",60,"ق",2,1],["يا بلبلاً آوى إليّ وطارا","زحمته غربانٌ فطار فرارا",61,"ر",2,1],["يا بلبل الصبح اقترب","انا سامع وحدي غناكا",62,"ك",2,1],["يا بلبل الروض الأريض ترنّمِ","وارو الحقيقة في بيانك واسلمِ",63,"م",1,1],["يا بلبلاً أطربني سجعُهُ","ما أروع السجع وما أروعَكْ",64,"ك",1,1],["يا بِلاداً حُجِبَت مُنذُ الأَزَل","كَيفَ نَرجوكِ وَمِن أَيّ سَبيل",65,"ل",1,0],["يا بِلاد الفِكر يا مَهدَ الأُلى","عَبدوا الحَقَّ وَصَلّوا لِلجَمال",65,"ل",1,0],["يا بليغا أتى قريضك يهمي","همي بحر أزرى بصوب الغمائم",66,"م",1,1],["يا بلاداً كم فتاةٍ وفتىً","يبعَثُ الشوقَ إِليها زَفرَةً",67,"ه",1,0],["يا بلبل الروض جدّدتَ القديم للصب","تبكي بلا دمع والعاشق دموعه صب",68,"ب",1,1],["يا بليغاً ان رام نظم القوافي","علم الناس كيف نثر اللآلي",69,"ل",2,0],["يا بُلبُلَ الشُعَراءِ أَذواكَ الرَدى","في ساعَةٍ عَن غُصنِكَ المَيّادِ",70,"د",1,0],["يا بلاد الخيرات بل جنة الدنيا","بفردوس ربعها المترامي",71,"م",2,0],["يا بلبل الروض ما للحظِّ فرقنا","ونحن صنوان في سجع وتأويه",72,"ي",2,0],["يا بليغاً فاق سحبان العِراب","سامي الإفصاح في فصل الخطاب",73,"ب",1,0],["يا بِلادي أَخلَصتك الخَير وَاِست","عفَيت وِدي إِلَيك مِن كُل مِين",74,"ن",1,0],["يا بِلادي وَأَنتَ أَضيق مِن رز","قي مَجالاً وَدُون اخرات أُذني",74,"ن",2,0],["يا بِلادي كَفْكِفي دَمْعَ الأَسى","بِدَمي أَفْديكِ لا تنْتَكسي",75,"س",2,0],["يابلابل غرّدي باحلى تغاريد اللحن","عاد عيدك يا وطنا وكل عامٍ لك يعود",76,"د",1,1],["يا بلادي.. وليتَني كنتُ أدري","نَحوَ ماذا يَسِيرُ هذا القَطِيعُ",77,"ع",1,0],["يا بِلادًا تَعَاهَدَت كُلَّ لِصٍّ","وانكَسَرنا بِبَابِها مُهطِعِينا",78,"ن",2,0],["يا بِلادًا تَأَخَّرَ الفَتحُ عنها","لم يَعُد في الدُّروبِ إِلَّا النِّقاطُ",79,"ط",1,0],["يا بلادًا.. صَغيرُها صار كَهلًا","ليس يَدري مِن أَيِّ قَبرٍ تَخَرَّج",80,"ج",1,0],["يا بلادي لا تُغلِقِي البابَ إِنَّا","دون صَبرٍ، وعَقرَبُ الوَقتِ أَعرَج",80,"ج",1,0],["يابلا الموضوع تسلم والسلام","سمني مجنون لأجل جنونها",81,"ن",3,0],["يَا \\\"بَلْطَجِيُّ\\\" لَقَدْ مَضَىْ","لَيْلُ الطُّغَاْةِ بِمَاْ حَمَلْ",82,"ل",1,0],["يا بليل الأفراح أن تك مطربي","أرخ بدا جد الختان وأزهر",83,"ر",1,0],["يا بلاداً حملتها في ضلوعي","فرمتني على رصيفِ الزمانِ",84,"ن",1,0],["يا بلادي أما علمتِ بأنّي","في ذُرى المجدِ قد هجرتُ مكاني",84,"ن",2,0],["يا بِلادًا تَفوحُ مَجدًا وحُسْناً","وعليها تسيلُ خيرُ دِمَاءِ",85,"ا",2,0],["يَا بُلْبُلَ الدَّوْحِ غَرِّدْ وَ ابْتَهِجْ طَرَبَاً","فَذَاكَ غُصْنُ الهَوَى الميَّادُ يَنْتَظِرُ",86,"ر",1,0],["يابلبل الأفراح غرد","فوق مسمعنا وغن",87,"ن",1,0],["يا بلدةً طيبةً معمورةً","اللهُ في قرانه اسماكِ",88,"ك",1,0],["يا بلسمًا في شعوري فاضَ وانسكبا","ريّانُ والقطْرُ شهدٌ رقرقَ العَجَبا",89,"ب",2,1],["يا بلادي ما اغتربنا ما نأيْنا","طالما أنّا رجعنا فالتقَينا",90,"ن",2,1],["يا بلادي ، هاكِ قلبي إنه","قلب حرٍّ ما ارتضي في العمر شَينا",90,"ن",2,0],["يا بلادي مرحباً نحن هنا","قد رجعنا لكِ أجناداً وعَونا",90,"ن",2,0],["يا بِلادِي ، وأنتِ نبضُ مِدَادِي","و\\\" اْدخُلُوهَا \\\" نُورٌ بِوَحيِ الأَمينِ",91,"ن",1,0],["يابلسم المجروح ياطب اﻻطباب","غروٍ حواني بالغلا واحتويته",92,"ت",2,0],["يا بُلبلَ الحبِّ إنَّ الحُبَّ أشجاني","واسيتَ قلبي وقدْ خفَّفتَ أحزاني",93,"ن",2,1],["يا بلبلَ الحبِّ إني في الهوى غردٌ","أما سمعتَ بحقِّ الله ألحاني ؟!",93,"ن",2,0],["يا بلبلَ الحبِّ هذا الحبُّ أعبدُهُ","للَّهِ , والحبِّ بعد اللهِ إيماني .",93,"ن",2,0],["يا بلادي ويا محل ودادي","يا عمان عليك مني السلام",94,"م",1,0],["يا بلْسماً طالما أنْدتْ طراوتُهُ","جرحاً تجارتْ له في الليلِ آماقُ",95,"ق",1,0],["يا بُلْبُلَ الْعُشَّاقِ مُذْ نادَيْتَني","لَبَّاكَ قَلْبي والْحَنينُ تَولَّدَا",96,"د",2,0],["يا بلادي ان في القلبِ لنزفٌ","عشْتُ فيه عبراتٍ وعليلا",97,"ل",2,0],["يا بلسما للأسقام شافية","يا فرقداً نوره من الألق",98,"ق",1,0],["يا بلاداً من صيفها وشتاها","وقع الناس بين قاسٍ وظالم",99,"م",1,0],["يابلاداً على الجراح تشظّت","ودمُ الحزن في الشفاه جديدُ",100,"د",1,0],["يابلادي أما شبعت ثُبورا","كلّ مافيك مجحفٌ وغثاءُ",101,"ا