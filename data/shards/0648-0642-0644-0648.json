{"poems":[[53,"أنفس قد ظمئن ليس إلى الماء","https://www.aldiwan.net/poem64025.html","الخفيف"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[93,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[94,"يا عذارى الجمال والحب والأحلام","https://www.aldiwan.net/poem38951.html","الخفيف"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[63,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62218","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[93,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[27,"يا دار كَبشة تلك لم تتغيَّر","https://www.poetsgate.com/ViewPoem.aspx?id=22827",""],[119,"لك عند عبدك موطن في قلبه","https://www.aldiwan.net/poem40937.html","عموديه"],[132,"هجرت بعدك العيون الرقادا","https://www.aldiwan.net/poem50641.html","الطويل"],[147,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[203,"رأت الملاح على السماء كواكبا","https://www.aldiwan.net/poem45379.html","الكامل"],[228,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[242,"لئن كان ورد الخد أبدع في الصبغ","https://www.aldiwan.net/poem19495.html","الطويل"],[275,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[275,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[333,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[447,"قفوا أيها الركبان نودعكم منا","https://www.aldiwan.net/poem14339.html","الطويل"],[463,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[469,"لو تبصر الخلجان حيث","https://www.aldiwan.net/poem3373.html","عموديه"],[505,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[556,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[563,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[563,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[563,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[563,"من لعبد بجسمه السقم بادي","https://www.aldiwan.net/poem34600.html","الخفيف"],[563,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138329",""],[666,"","https://poetry.dctabudhabi.ae/diwan/poem/147421","الكامل"],[822,"","https://poetry.dctabudhabi.ae/diwan/poem/89630","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48671","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77493","الرجز"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44789","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62475","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79857","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79849","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79866","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79802","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108724","البسيط"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101576","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49600","المتقارب"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87863","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125455","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108471","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104964","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124763","الطويل"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111159","الكامل"],[2362,"","https://poetry.dctabudhabi.ae/diwan/poem/198790","الكامل"],[2603,"","https://poetry.dctabudhabi.ae/diwan/poem/134214","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93925","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109801","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87437","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145069","الخفيف"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103823","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91339","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91760","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139410",""],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93293","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123513","المتقارب"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35061","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83183","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4814,"نكهة الأشياء","https://www.poetsgate.com/ViewPoem.aspx?id=194101",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4858,"حافلة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=138780",""],[5106,"مِهْرَجَانُ الشَّمْس .","https://www.poetsgate.com/ViewPoem.aspx?id=153972",""],[5186,"أبدا تعن عليكم الأرباح","https://www.poetsgate.com/ViewPoem.aspx?id=156526",""],[5455,"دمعة ملك","https://www.poetsgate.com/ViewPoem.aspx?id=34431",""],[5542,"لغة الحجارة","https://www.poetsgate.com/ViewPoem.aspx?id=10192",""],[5595,"يا أولَ الماضين َ في آذارهِ","https://www.poetsgate.com/ViewPoem.aspx?id=144523",""],[5720,"الْحَجِيْجَ","https://www.poetsgate.com/ViewPoem.aspx?id=205913",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[5943,"كلَّما وجَّهتُ وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=11287",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[1706,"في بطحاء مكة","https://www.poetsgate.com/ViewPoem.aspx?id=102862",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6237,"لكل صابونة ليفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77876&r=&rc=18",""]],"verses":[["وقلوبٌ شفاؤهنَّ من السُّق","م نُهود الثُّديِّ فوق الصدور",0,"ر",1,0],["وَقُلوبٍ بَلِيَت فيها المُنى فَهيَ رُفات","ما أَنا أَعمى فَهَل غَيرِيَ أَعمى لَستُ أَدري",1,"ي",1,0],["وَقُلوبُهُم قَد أَسرَعَت ضَرَباتُها","وَطَظُنُّها وَقَفَت عَنِ الخَفَقانِ",2,"ن",1,0],["وقلوبٌ مضيئةٌ كنُجومِ اللّيلِ","ضَوّاعَةٌ كَغَضِّ الوُرودِ",3,"د",1,0],["وَقُلوبٌ مُوَطَّناتٌ عَلى الرَو","عِ كَأَنَّ اِقتِحامَها اِستِسلامُ",4,"م",1,0],["وقلوبَ الكلامِ تَخفِقُ رُعْباً","تَحتَ ثِنْيَيْ لِوائِها الخَفَّاقِ",5,"ق",1,0],["وقَلُوصِ مَأْرُبَةٍ بَغَيْتُ هِبَابَهَا","في مَوْرِدٍ نَائِي المَوَارِدِ مَصْدَرِ",6,"ر",1,0],["وقَلوصاً كلّفْتُ إذْ قَلَصَ الظّل","لُ مَكاناً بغيرِ ظِلٍّ جَديرا",7,"ر",2,0],["وقلوبُ النجوم ترجُفُ أن يج","تازَ يوماً إلى مَداها الْحُدودا",8,"د",2,0],["وقلوبهم قد أسرعت ضرباتها","وتظنّها وقفت عن الخفقان",9,"ن",1,0],["وقَلُوصِ مَأْرُبَة ٍ بَغَيْتُ هِبابَها","في موردٍ نائي المورد مصدر",10,"ر",1,0],["وقلوب اهل الحال مدحك انسها","هو انت في اهل الولاية شمسها",11,"ه",2,0],["وقلوبُ الورى تطيرُ بلا عق","لٍ وكانت مثل الرواسي شدادَا",12,"د",2,0],["وَقُلوبٍ قَضى لَها العِزُّ وَالنَخ","وَةُ أَلّا تَحُلَّها أَوغامُ",13,"م",1,0],["وَقلوبُ العتاةِ فيها عيونٌ","طَمَستها مِن شركهم أقذاءُ",14,"ا",2,0],["وقلوبهنَّ على الحليِّ كذي الليا","لي إن عدمنَ البدرَ كانتْ سودا",15,"د",2,0],["وقُلوبُ الشَبابِ تَنبِضُ لِلحُ","بِّ وَتَأوي إِلى عَذارى الخُدورِ",16,"ر",1,0],["وَقُلْ وَاعْتَرِفْ بِالْعَجْزِ فِيهِ قَصِيدَةً","وَإِنْ كُنْتَ مِنْ أَهْلِ الإِجَادَةِ وَالنَّبْغِ",17,"غ",1,0],["وقلوبُنا كعيونِنا شَخَصَت إلى","باريسَ تِلكَ النجمةِ الزَّهراء",18,"ا",2,0],["وقلوبُهم مما غدوا عبَّادُه","لا تَقبَلُ التأثيرَ والتليينا",19,"ن",2,0],["وقلوبُكم لأكفّكم جمّاعَةٌ","وجهادُكم لسِلاحِكم ضمَّام",20,"م",1,0],["وقلوب طوافح بسرور","وابتهاج ولوعة وغرام",21,"م",1,0],["وقلوب مخمورة بالأماني","وقلوب إلى الأماني ظماء",22,"ا",2,0],["وقلوا لعينيكم تقول وقد جرت","شئون مآقيها بما عندنا ذعنا",23,"ن",2,0],["وقلوبُ أعدائي الذين أخافُهم","مغلولةٌ لِيَ في جسوم أحبَّتي",24,"ي",1,0],["وقلوعها راياتها","في الجوّ خافقه الذوائب",25,"ب",1,0],["وقُلوبُ النَّاسِ تنْقادُ لنا","وهي في محفَلِنا لا تشعُرُ",26,"ر",1,0],["وقلوبٌ حُشين في الموت باللّوْ","عاتِ ما خُرْنَ فيك بالإلتِياعِ",27,"ع",1,0],["وقلوبٌ ساكناتٌ","وجَنانٌ مستريحُ",28,"ح",1,0],["وقلوب الأنام طوع يديه","كلنا كالجفون من عينه",29,"ه",1,0],["وقل وما أنا ممن بالتكلف قد","أتى إليكم خلافا للمناحيس",30,"س",1,0],["وقلوبنا في بحر عشقته هوت","تبغي اللقا لا تعرف الإنقاذا",31,"ذ",2,0],["وقلوب كأنما البغض فيها","جمر نار تبدو من الأجساد",32,"د",1,0],["وقلوب أهل ودادكم تشتاقكم","وإلى لذيذ لقائكم ترتاح",33,"ح",1,0],["وقلوبنا قد ادركت آمالها","فوفي الزمان وكان قبلا يخلف",34,"ف",1,0],["وقلوبنا فرط المرارة والهوان","وفرط خيبات طوال",35,"ل",1,0],["وَقُلوبُنا قَرحى وَماءُ عيونِنا","جارٍ وأَعناقُ البَريَّةِ خُضَّعُ",36,"ع",1,0],["وقلوب أهل البغي باقية كما","خلقت تفيض ضغائناً وتفور",37,"ر",1,0],["وَقُل وَقَعت بِالَّذي أَعجبكا","يَا أَيُّها البَهيم ما أَعجَبَكا",38,"ك",2,0],["وُقُلوبُنا نَبعُ المَكا","رِمِ لَيسَ يَنضَبُ وَالمَحامِدْ",39,"د",1,0],["وقلوبٌ تقلبت في ضرام البُع","د لا تعجبوا إذا ما شَواها",40,"ا",3,0],["وقلوباً رففتِ شوقاً إليه","لكِ وافى فلا تشقّي الضلوعا",41,"ع",2,0],["وقُل ولا تحفل بغيظ أنفسٍ","قد تركت لغيِّها رشادَها",42,"د",3,0],["وقلوبُ أبناءِ النبي تفطَّرت","عطشاً بقفرٍ أرمضت أشلاءها",43,"ا",3,0],["وقُل وإن صُمَّ سمعٌ من أخي حَسدٍ","فسرَّني أنه ما فارق الصمما",44,"م",2,0],["وقل ولكن بلسان مُرهفٍ","واجعل دماء القوم في جوابه",45,"ب",2,0],["وقل وحدث فلا خوفٌ ولا حرجٌ","عليك من كل موصولٍ ومهجور",46,"ر",1,0],["وقلوب تضج في لهب اليأ","سِ من الفوز بين غير وغيره",47,"ر",2,0],["وقُل وأعِدْ عنه لا عن جِفانٍ","وزد حُبْسَةً فيه تزَدَدْ بياناً",48,"ن",2,0],["وقل وشتت صد واهزم ودمرن","أعادينا لاتبق منهم ولا تذر",49,"ر",1,0],["وَقُلوبٌ بِالحُبِّ تَخفِقُ وَلهى","وَعُيونٌ تَرى المَعاني الخَفِيَّه",50,"ي",2,0],["وقلوباَ أودَعتَ فيها سعيراً","أبدَ الدهرِ ناره في اشتعالِ",51,"ل",1,0],["وقلوبهم من هولِ ذلك أجفلت","رعباً فزاد الهولُ من أجفالها",52,"ل",3,0],["وقلوبها بالثكل تشعل","والمدامع تمطر",53,"ر",1,0],["وقل ولم تدع الأشجان منك سوى","قلب الفريسة إذ ينتاشها الأسد",54,"د",1,0],["وقل وعليكم إن يسلم بغضهم","مجيبا وجوبا لا تجزه لمبتد",55,"د",1,0],["وقلوب تطايرت لو شيك","البين منا كأن ناف نفاها",56,"ا",3,0],["وقلوبنا بيد المصاب كأنها","في كف مالك خازن النيران",57,"ن",1,0],["وقلوب مصر تفطرت خفقاتها","يا ويح قلبي ما لهن غناء",58,"ا",2,0],["وقل وخيار القول ما قال سامع","صدقت به من ساكن البدو والحضر",59,"ر",1,0],["وقلوبنا بالهم تصدع والأسى","صدع الزجاج",60,"ج",1,0],["وقل وافى كبير بني عبيد","وجاد على الأحبة بالتداني",61,"ن",2,0],["وقلوب العشاق تتبع الغيد","تبارى أفراسها الجاريات",62,"ت",1,0],["وقلوب لا تنثني في الذي تبغي","ولو حال في نار