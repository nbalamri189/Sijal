{"poems":[[87,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[33,"إن من تهوى مع الفجر ظعن","https://www.aldiwan.net/poem41295.html","الرمل"],[240,"يا بأبي المختلس المستلب","https://www.aldiwan.net/poem32142.html","السريع"],[358,"ليهن ورق الحمى في الأيك تغريد","https://www.aldiwan.net/poem40400.html","البسيط"],[463,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[475,"صاح هل أبصرت","https://www.aldiwan.net/poem4687.html","مجزوء الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48546","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62502","البسيط"],[1884,"","https://poetry.dctabudhabi.ae/diwan/poem/203968","المنسرح"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105286","الرمل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199811","المسحوب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100236","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118874","الدوبيت"],[3245,"","https://poetry.dctabudhabi.ae/diwan/poem/143679","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131077",""],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44664","المجتث"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86374","الكامل"],[4830,"سُلافُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=202444",""],[5496,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=213695",""],[5700,"خريف","https://www.poetsgate.com/ViewPoem.aspx?id=207501",""],[5956,"الطبيبة النجيبة عنايات محمد صامولي","https://www.poetsgate.com/ViewPoem.aspx?id=196798",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6152,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=201869",""],[463,"جمَّ لها الوادي وعزَّ الذائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60032&r=&rc=88",""]],"verses":[["مَوِّه عَلى الناسِ أَو غالِطهُمُ عَبَثاً","فَلَيسَ تَكتُمُهُم ما لَيسَ يَنكَتِمُ",0,"م",1,0],["مَوهِناً تَمشي بِها بَغلَتُها","في عَثانينَ مِنَ الحَجِّ ثُكَن",1,"ن",1,0],["مَوهِبَةٍ جادَ بِها الدَهرُ لي","ثُمَّ سَطا مُرتَجِعاً ما وَهَب",2,"ب",1,0],["مَوّهت باب الرَجا مِنهُ بتبرِ ثنا","وَهَل عَلى باب أَهل الفَضل تَحديدُ",3,"د",1,0],["مَوهِبةٌ فاجئةٌ لم تُحتَسَبْ","ولم تسوِّفْه بها المَواعدُ",4,"د",1,0],["مَوهِناً شُبَّت لِعَينَي","كَ فَلَم تُوقَد نَهارا",5,"ر",2,0],["موهماً أنه رسول من الل","ه أتى يستعيد مجد الدين",6,"ن",1,0],["مؤهَّل للعُلا جارٍ بقالَبها","عرفتُه ملكاً إن قام أو جلسا",7,"س",2,0],["موهبة لم تزل لسؤددها","تسمو الأماني وتطمح الهمم",8,"م",1,1],["موهنا بت علي","ه في بكاء ونحيب",9,"ب",1,0],["موهب مامزنته صفوة زلال","سلسبيل من رحيق سلسلي",10,"ل",2,0],["موهت حين حمت بنجد بيتها","فسألت بالغورين عن أبياتها",11,"ت",3,0],["موه للناس عن بديع الحسنِ","واجعله على الحبيب مثل الحصنِ",12,"ن",1,1],["موهت وصلك حتى","إذا كتبت كتابي",13,"ب",2,1],["موهته اشعة الشمس بالتب","ر فخلناه كالطراز المعلم",14,"م",1,0],["مَوهوبَةٌ مِن كَريمٍ","إِلى المَكارمِ يُنسَبْ",15,"ب",1,0],["موهت عنك بحاجر وبلعلع","ولأنت من تلك العبارة مقصدي",16,"د",2,0],["موَّهتُ دمعي بكفِّ الصبرِ مُحتّسباً","وربَّ دمعٍ لسرِّ القلبِ مُستَرِقِ",17,"ق",1,0],["موهوبة للعلا بالشعر هائمة","يغفو ويصحو على أنفاسها النغم",18,"م",1,0],["مُوهنٌ كَاهِلي بِثُقل البَلايَا","غَيرَ أَنَّي عَلَى المَدَى لاَ أَذِلُّ !",19,"ل",1,0],["موهوبة من ربها موسوعةٌ","في العلم والإيمان وهي الأصلَحُ",20,"ح",1,0],["موهباتي أغنياتي","رقصاتي للحبايبْ",21,"ب",1,0],["موهوبُ شعرٍ وموسيقى وفلسفةٍ","مِن ربه مانحِ القدْرات والجودِ",22,"د",1,0],["موهت عنكِ مدامعي حتى إذا","هاجت جفوني أحرقت أجزائي",23,"ا",3,0],["موهبة ٌ فاجئة ٌ لم تحتسبْ","ولم توفهْ بها المواعدُ",24,"د",1,0]]}