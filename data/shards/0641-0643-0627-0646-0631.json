{"poems":[[73,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[51,"سلام على قبر النبي محمد","https://www.aldiwan.net/poem62046.html","الطويل"],[48,"شعر كساه الدهر صبغة حاذق","https://www.aldiwan.net/poem23248.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[146,"لو يهتدى وصفى إلى شغفى","https://www.aldiwan.net/poem58374.html","أحذ الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[463,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[484,"صفر تجلى مسفرا","https://www.aldiwan.net/poem37052.html","مجزوء الكامل"],[572,"لبس القباء فلم يعبه وأيقنوا","https://www.aldiwan.net/poem69464.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83292","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53927","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100358","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138696",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108238","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130439","الكامل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18760","الوافر"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34571","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95371","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[5187,"زيارة لقصر العظم","https://www.poetsgate.com/ViewPoem.aspx?id=29065",""],[5280,"تراءت","https://www.poetsgate.com/ViewPoem.aspx?id=189574",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""]],"verses":[["فَكانَ رَأيُكَ فيها رايَةً طَلَعَت","بِالنَصرِ فَاِنجابَتِ اللأواءُ وَالكُرَبُ",0,"ب",1,0],["فَكانَ رَسولُ اللَهِ مِفتاحَ رَحمَةٍ","مِنَ اللَهِ أَهداها لِكُلِّ مُوَحِّدِ",1,"د",1,0],["فَكَأَنَّ روحَكَ لَم يَحُلَّ بِشَخصِهِ","وَالراحُ ما دَبَّت لَهُ في مَفصِلِ",2,"ل",1,0],["فكأنّ روحاً عائداً من طيبةٍ","فيه شبابُ ملوكِها يتبسمُ",3,"م",1,0],["فَكَأَنَّ رَحْليِ فَوْقَ أَحْقَبَ قَارِب","مِمَّا يَقِيظُ بِأَظْرُبٍ فَيُرَامِلِ",4,"ل",1,0],["فكأن راحَتك الربيعُ فما","تُخلى الرّبَى من روضة أُنُفِ",5,"ف",1,0],["فكأنّ روضَ الفضلِ لم يك غانياً","عَن أيّ ما رزءٍ ودمعٍ يهمعُ",6,"ع",1,0],["فكان رضاه ما رضيتم لحزمه","وليس الَّذي يأبى رضاكم بحازم",7,"م",1,0],["فكأنَّ روضَ الحَزْنِ تنشره الصَّبا","ما ظَلْتُ من قرطاسها أتصفَّحُ",8,"ح",1,0],["فكأن روح الجد قد","بعثت بها بعد الممات",9,"ت",1,0],["فَكَأَنَّ رَوْنَقَ وَجْهِهِ مِنْ سَيْفِهِ","وَكَأَنَّ حِدَّةَ سَيْفِهِ مِنْ رَائِهِ",10,"ا",3,0],["فَكَأَنَّ رَبَّكَ عِندَ خَلقِكَ قَد أبى","أَن لا تَكونَ مُكمِلاً تَكيملا",11,"ل",2,0],["فكان روضاً به الأزْهارُ مُونقةٌ","أنوارُها تَزْدَرِي بالبَدْر في الغَسَقِ",12,"ق",1,0],["فكأن رجع رغاء سرحهم","غليانها ان عرَّس الزمل",13,"ل",1,0],["فكأن ري فؤاده أن يرتوي","سبط الهدى وودائع الرحمن",14,"ن",1,0],["فكأن ربّ المال يأخذ من ليا","لي بائس فيطول منه قرار",15,"ر",1,0],["فكان رأس مظهري دعوته","فخاف منه القدح في دولته",16,"ه",1,0],["فكأن ربع تشوقي وخيالها","دمن ألم بها فقال سلام",17,"م",1,0],["فَكانَ رَواحُها لِلحَيِّ كَعبٍ","وَكانَ غُدوها لِبَني تَميمِ",18,"م",1,0],["فكأن ريا الكأس حين ندبته","للكأس أنهض في حشاه جناحا",19,"ح",2,0],["فكأن رايات الامام بجنحه","حمر الذوائب بالدم المتصبب",20,"ب",1,0],["فكان رجائي ضد ما قد رأيته","من الدهر إذ ما لي عليه نصير",21,"ر",1,0],["(فكان رئيس عصابة كفر)","لديه العلى جهد إمكانها",22,"ن",3,0],["فكأنَّ ربك قال فيها أن تكو","نَ فمثلت ما شاء صنعة قادرِ",23,"ر",1,0],["فكان ربيعي من هواطلِ خَرفِها","وحانَ شتائي بعدما بَلَغَ الصّيفا",24,"ف",2,0],["فكأنَّ ربَّ الكونِ طاغية ٌ","بالزهْوِ يشعرُ كلّما قتلا",25,"ل",2,0]]}