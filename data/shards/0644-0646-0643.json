{"poems":[[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133818","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112747","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27268","الهزج"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141183","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[4869,"بيني وبينك","https://www.poetsgate.com/ViewPoem.aspx?id=151718",""],[5344,"شوف غيري ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180713",""],[5652,"ماغير صوتك لا ندهني ولبيت","https://www.poetsgate.com/ViewPoem.aspx?id=136695",""],[5848,"اللهم إني عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=48895",""],[6075,"بين الذكرى والأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=213327",""],[6100,"اشتقت لأنفاسك","https://www.poetsgate.com/ViewPoem.aspx?id=52589",""],[6100,"كحيلان","https://www.poetsgate.com/ViewPoem.aspx?id=52549",""]],"verses":[["لنِكُن نحنُ مَن تصلي لنا الدنيا","وتنهارُ دوننَا إعظاما",0,"م",2,0],["لنكون فيك مدى الزمان على عشم","يا رب صل على النبي وآله",1,"ه",1,0],["لنكرٍ قام في نفسي","على عقلي وبالعكس",2,"س",1,0],["لنكس من أبراجها كل شامخ","وسكن من أفلاكها كل دوار",3,"ر",1,0],["لنكوننَّ إذا صح الحجى","حجراً صلداً ولا هذا الوجود",4,"د",1,0],["لنك تعايشت بسنيني سنينك","وانا مضيّع في سنينك سنيني",5,"ن",2,0],["لنّك ومن مثلك شباه الدناميت","روّح ..و شف غيري فراغك يمَلِّي..",6,"ل",2,0],["لنك حبيب الامس واليوم حطيت","في وسط صدري لك مقامات وصروح",7,"ح",1,0],["لنّك اكبر من محبة يا الحبيب الوافي","ولنّ قلبي دايم مقصر وحبك سابق !",8,"ق",1,0],["لِنَكْتُبَ قِصَّةً تَبْقَى","مَنَارًا لِلْمُحِبِّينَا",9,"ن",2,0],["لنك اذا بانت على الكون غيبتّك \"","يكون سدك اخر الوقت عابك",10,"ك",1,0],["لنك وطن في داخلك كتلة اوطان","عندك مصير المعضله صك بابه",11,"ب",2,0]]}