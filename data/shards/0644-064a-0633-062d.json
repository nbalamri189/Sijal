{"poems":[[95,"إلى الأديب العبقري","https://www.aldiwan.net/poem9842.html","السريع"],[90,"كل شيء من عالم الذرات","https://www.aldiwan.net/poem44975.html","الخفيف"],[53,"ليس حمد الجفون في مريها النوم","https://www.aldiwan.net/poem7940.html","الخفيف"],[53,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[53,"أيها السيد الجليل أدام الله","https://www.aldiwan.net/poem65813.html","الخفيف"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[47,"يا أبا نهشل وداع مقيم","https://www.aldiwan.net/poem64594.html","الخفيف"],[51,"شدة الحرص ما علمت وضاعه","https://www.aldiwan.net/poem62170.html","الكامل"],[51,"كل حي كتابه معلوم","https://www.aldiwan.net/poem63100.html","الخفيف"],[33,"من رسوم باليات ودمن","https://www.aldiwan.net/poem41291.html","الرمل"],[33,"ولقد قلت إذ تطاول هجري","https://www.aldiwan.net/poem42565.html","الخفيف"],[48,"عيشتي سلتي ورمسي غمدي","https://www.aldiwan.net/poem23542.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85468","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54902","الخفيف"],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[53,"ليس حمد الجفون في مريها النو","https://www.poetsgate.com/ViewPoem.aspx?id=26055",""],[59,"أَكْثَرَ النَّاسُ في النِّسَاءِ وَقالُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14206&r=&rc=3",""],[113,"من لوجدي وحيرتي والتهابي","https://www.aldiwan.net/poem16216.html","الطويل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[435,"ليس حسن الخضاب زين كفي","https://www.aldiwan.net/poem41029.html","الخفيف"],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[466,"ليس حملي مجرد الزين والظر","https://www.aldiwan.net/poem15385.html","الخفيف"],[556,"لعنة الله على من","https://www.aldiwan.net/poem47303.html","مجزوء الرمل"],[580,"ليس حظي من الهوى","https://www.aldiwan.net/poem2881.html","مجزوء الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39046","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145808","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16719","الخفيف"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44930","الخفيف"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105223","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64549","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95572","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/199973","الخفيف"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70355","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35909","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110080","الخفيف"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36068","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4134,"","https://poetry.dctabudhabi.ae/diwan/poem/100558","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33563","الرمل"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101166","الرمل"],[4701,"في آخر السطر","https://www.poetsgate.com/ViewPoem.aspx?id=207126",""],[5150,"فتاة اسكندرونه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202917",""],[5409,"لم ينل من علاك كل أثيم","https://www.poetsgate.com/ViewPoem.aspx?id=155489",""],[5459,"فلق الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=201909",""],[5784,"ليس ذنبي","https://www.poetsgate.com/ViewPoem.aspx?id=189911",""],[5953,"ليس حبسي بضائري إن أتاح الل","https://www.poetsgate.com/ViewPoem.aspx?id=93880",""],[5957,"ليس حبي من هيام وشغب","https://www.poetsgate.com/ViewPoem.aspx?id=128188",""]],"verses":[["ليس حديثاً مفترى إن أقل","أولاد سركيس كأولادي",0,"د",2,0],["ليس حسن الأعمال في الناس إلاّ","حسن ما يُضمرون من نيّات",1,"ت",1,0],["ليس حمدُ الجفون في مَرْيها النوْ","مَ ولا نَفيِها أَذى الأَقذاءِ",2,"ا",2,1],["ليس حَمْد الخصْيَان في الناس إلا","شِدَّةَ الصبرِ عند شَقِّ الفِقَاحِ",3,"ح",1,0],["ليس حظّي بدون حَظّكَ منه","بل أبى اللَّهُ أنْ أكونَ نديدَك",4,"ك",1,0],["لَيسَ حُبّيكَ لِلصِبا","لَستَ فيهِ بِأَوحَدِ",5,"د",1,0],["لَيسَ حَوكَ القَريضِ بالِغَ ما في","كَ بِوَصفٍ فَيُكتَفى بِالقَصيدِ",6,"د",1,0],["لَيسَ حُزني عَلى العِراقِ وَما يُل","بِسُها الدَهرُ مِن نَعيمٍ وَبوسِ",7,"س",1,0],["لَيسَ حَيٌّ بِمُستَقيلٍ بِما وَل","لَت بِهِ مِنهُ ساعَةٌ بَعدَ ساعَه",8,"ع",2,0],["لَيسَ حَزمُ الفَتى يَجُرُّ لَهُ الرِز","قَ وَلا عاجِزاً يُعَدُّ العَديمُ",9,"م",1,0],["لَيسَ حُبٌّ فَوقَ ما أَحبَبتُهُ","غَيرَ أَن أَقتُلَ نَفسي أَو أُجَنّ",10,"ن",1,0],["لَيسَ حُبّي لَها بِبِدعَةِ أَمرٍ","قَد أَحَبَّ الرِجالُ قَبلي وَبَعدي",11,"د",2,0],["لَيسَ حالُ المَخبولِ فيما يُلاقي","مِثلَ حالِ المَطوِيِّ وَالمَخبونِ",12,"ن",1,0],["لَيسَ حقاً وَلا قَريباً إليه","أَن يقاس الباكي عَلى المُتباكي",13,"ك",2,0],["لَيْسَ حُكْمُ الْجَمْهُورِ فِيهَا بِحُكمٍ","وَلِحِينٍ قَدْ يُخْدَعُ الْجَمْهُورُ",14,"ر",1,0],["ليس حميداً سائقٌ كعاتل","شمّر لكي تَسبُلَ ذيلَ الرافل",15,"ل",1,0],["ليس حمد الجفون في مريها النو","م ولنفيها أذى الأقذاء",16,"ا",2,1],["ليسَ حبُ النساءِ جهداً ولكنَ","قُرْبُ مَنْ لاَ تُحِبُّ جُهْدُ الْبَلاءِ",17,"ا",2,0],["لَيسَ حَسناءُ أَسفَرَت عَن جَمال","مثل شوها تَسترت بِحِجاب",18,"ب",1,0],["لَيسَ حَيٌّ يَبقى وَإِن بَلَغَ الكَب","رَةَ إِلّا مَصِيرُهُ لِزَوالِ",19,"ل",1,0],["ليس حسن الخضاب زين كفي","لا وثغري العذب اللمى والرضاب",20,"ب",1,1],["ليس حزما من بصير رصين","فدعاني شأن قاض حليم",21,"م",1,0],["ليس حملي مُجرَّد الزيْن والظَّر","فِ مسح الأيدي ونفضِ الغُبارِ",22,"ر",1,1],["لَيس حَظّي وهْوَ حظّي","في الورى إلّا قليلا",23,"ل",2,0],["ليس حظي مِنَ الهَوَى","غيرَ عَضِّ الأَنامِل",24,"ل",1,1],["ليسَ حَرْبٌ أمَرَّ مِنْ صَدِّ حِبٍّ","لا ولا أسْمَرٌ كسُمْرِ الجُفونِ",25,"ن",1,0],["ليس حزناً هذا الأسى والبكاءُ","يا نجُوماً بها السَّماءُ تُضَاءُ",26,"ا",2,1],["ليس حبي حرمته بفساد","رب حب فيه صلاح فساد",27,"د",1,0],["لَيسَ حَدُّ الحُسامِ أَكفى وَأَغنى","مِن أَخٍ ذي كِفايَةٍ وَغِناءِ",28,"ا",2,1],["لَيسَ حَلي الدَواةَ يَنفَعُ شَيئاً","إِن تَخَلَّيتَ مِن حُلى الآداب",29,"ب",1,0],["ليس حزني على الربوع البرالي","إن حزني لصالح وحنيني",30,"ن",2,0],["ليس حظي ينبت يا متعال","الجلال إلا على معاذي وحيلي",31,"ل",2,0],["ليس حسن الوجوه معيار فضل","إن حسن الصفات جلّ حسابَا",32,"ب",2,0],["لَيسَ حِزبُ الأَحرارِ مَن يَحكُمُ النا","سَ بِسَوطٍ بَل ذاكَ حِزبُ العَبيدِ",33,"د",1,0],["ليس حسن الحديث قرب رجال","عند أرباب علمه النقّاد",34,"د",1,1],["ليس حظي من الحبائب إلا","لوعة أو تأسف أو غرام",35,"م",1,1],["ليس حب الاوطان في لبس خز","واختيال تغار منه النساء",36,"ا",2,0],["لَيسَ حزنُ النَّفسِ إِلّا","ظلّ وَهمٍ لا يَدوم",37,"م",1,0],["لَيسَ حَليمٌ بِنادِمٍ أَبَداً","وَلا سَفيهٌ بِعادِمٍ نَدَمَه",38,"م",2,0],["ليسَ حقٌّ لَها فليسَ عليها","من حِسابٍ يَدِقُّ يومَ القِيامِ",39,"م",1,0],["لَيسَ حَمدي وَلَيسَ ذَمِّيَ إِلّا","بَعدَ صَبرٍ وَبَعدَ طولِ اِختِبارِ",40,"ر",1,0],["ليس حظ العين إلا في العيان","فأجل طرفك في أهل الزمان",41,"ن",1,0],["ليس حاس كاس الهوية إلا","وهو يحسو سلافة الأهواء",42,"ا",2,0],["ليسَ حظِّي منك إلا","أنَّني فيك ملومُ",43,"م",1,1],["ليس حقاً من يواسي قومه","يترامى بسهام عن سلام",44,"م",1,0],["لى سحبةُ القوس فى شجو الكمان لي","أناقةُ الحزنِ لى لحنى الذى عَزَفُوا",45,"ف",3,0],["ليس حبي فيكِ وهماً لا ولا","حبُّنا لاسكندرونٍ كان دونَهْ",46,"ن",2,0],["ليس حلما ما كان منه ولكن","قد تأنى حتى يتم البناء",47,"ا",2,0],["ليس حلمًا مستحيلاً ..فغدًا","بسمةُ البشرى ستُنسِينا الشّقا ..",48,"ق",2,0],["ليس حبًّا هذا الذي صحّٙ عندي","إنني من دينِ الغرام برٙاءُ",49,"ا",2,0],["ليس حبسي بضائري إن أتاح الل","ه من بعد طول حبسي بفضله",50,"ل",2,1],["ليس حبي من هيام وشغب","يا طبيبي في شقائي والوصب",51,"ب",1,1]]}