{"poems":[[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48810","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120019","المنسرح"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128017","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102022","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58517","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4859,"صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=194213",""],[6344,"شعلة من وقود الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87982&r=&rc=22",""]],"verses":[["ما لصحف العشيرة اليوم تهوي","بالعداوات بينها وتهيم",0,"م",1,0],["ما لصغاري باكين شوقا","منهم إلى الخبز في الزوايا",1,"ا",3,0],["ما لصب فيك أخوا الخنسا حشاه ولا","أبو معاذله صبر المحن",2,"ن",1,0],["ما لصبر فرّ في معركة","لم يكن للوجد فيها من براح",3,"ح",1,0],["ما لصرف البين لم يترك لنا","طود عز شامخ إلا وهذا",4,"ذ",2,0],["ما لِصَبٍّ يُحِبني غير صَبٍّ","من عُيونٍ تسيلُ منها عيونُ",5,"ن",1,0],["ما لصحبي عاد ليلاً وظلام","ما لنوري قد تغشّاهُ القتام",6,"م",1,0],["مالصنعاء كلمّا انزاحَ همٌّ","أقبل الويلُ داعياً للكفاح",7,"ح",1,1],["مَالَ صَوبَ العُيُونِ مُقْتَفِيًا","شَكْلَهُ فَاسْتَقَامَ مُعْتَدِلَا",8,"ل",2,0]]}