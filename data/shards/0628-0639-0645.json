{"poems":[[47,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[52,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[47,"عَزَمْتُ عَلى المَنَازِلِ أنْ تَبينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31886",""],[146,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[164,"أحسنت في تدبير أمرك يا حسن","https://www.aldiwan.net/poem58795.html","الكامل"],[240,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[415,"كعهدك بانات الحمى فوق كثبها","https://www.aldiwan.net/poem31848.html","الطويل"],[435,"بعمامة سودا أتى رب السنا","https://www.aldiwan.net/poem40699.html","الكامل"],[463,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[463,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[470,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[473,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[473,"يامن إذا زاره صديق","https://www.aldiwan.net/poem59680.html","مخلع البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67837","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96565","الطويل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18227","الطويل"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101137","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47493","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64540","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49975","الكامل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102060","البسيط"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146070","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201715","الطويل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139355",""],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110641","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26212","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76173","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201321","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201193","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202726","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74179","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11248","البسيط"],[3382,"","https://poetry.dctabudhabi.ae/diwan/poem/144924","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89148","الكامل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103782","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133236","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40121","الرمل"],[4691,"مللتك شوقا أقام قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=81257",""],[4764,"كلام اعيال","https://www.poetsgate.com/ViewPoem.aspx?id=33644",""],[5431,"تصوف...","https://www.poetsgate.com/ViewPoem.aspx?id=182977",""]],"verses":[["بِعَمرِكَ تَدري أَيُّ شَأنَيَّ أَعجَبُ","فَقَد أَشكَلا باديهِما وَالمُغَيَّبُ",0,"ب",1,1],["بِعَمرِكَ كَيفَ نَرضى ما أَبانا","مِنَ الدُنيا وَنَسخَطُ ما يَجينا",1,"ن",2,0],["بِعَمنِ مَنصورٍ المُغيري جِمالَهُ","وَقَلبي لَهُ هَذا مِنَ الحِلمِ أَعوَجُ",2,"ج",1,0],["بعُمْرِكَ كَيفَ نَرْضَى مَا أبَانَا","منَ الدّنْيَا، وَنَسخَطُ ما رَضِينَا",3,"ن",2,0],["بعميد الدولةِ الأرضُ تُطوَى","حين لا ترجو النجومُ خَلاصا",4,"ص",2,0],["بع منه مهجتهُ وخذ ما عندهُ","عوضاً يكن منه المثمن والثَّمنْ",5,"ن",1,0],["بِعِمادِ الدينِ اِستَقادَ حَرونُ ال","حَظِّ لي وَاِستَجابَتِ الآمالُ",6,"ل",1,0],["بعماءٍ كنت به أزلا","بمحمّد من جا بالبلجِ",7,"ج",1,0],["بِعُمْريَ أو شرخِ الشبيبةِ ما غَلا","وقد عزَفَت نفسي عَن الهَجْرِ والقِلى",8,"ل",2,0],["بعمامةٍ سودا أتى رب السنا","فغدا الرجا سمو على النبراسِ",9,"س",1,1],["بعميد الرؤساء انتشرتْ","سُننُ المَجد وقد كُنَّ دُفِنَّا",10,"ن",2,0],["بعميدِ الرؤساءِ اعتدلتْ","لكُمُ أعمدةُ المجد الممالَهْ",11,"ل",2,0],["بِعَميق ِوَجْدِكَ..عَلَّ في شُطآنِها","جُرْفا ً تُلامِسُه ُ فَلا يَتَفَطَّرُ!",12,"ر",1,0],["بع مقتناك وعد نحوي تجد بدلاً","عما تغادر من مالٍ وأولاد",13,"د",1,0],["بِعَمِّيَ المَرتَضى عَلِيٍّ","عَلامَ لَم تُنقِذِ العَمامَه",14,"م",2,0],["بعمر لعمري فِي الْبَطَالَةِ ضَائِعِ","زَمَانُ الصِّبَا وَلى سَرِيعاً بِعَزْمَةِ",15,"ه",1,0],["بعَماءَ من طولِ البكاءِ كأَنَّما","بها رَمَدٌ أَو طَرفُها متخازرُ",16,"ر",1,0],["بِعَمّي سَقى اللَهُ الحِجازَ وَأَهلَهُ","عَشِيَّةَ يَستَسقي بِشَيبَتِهِ عُمَر",17,"ر",1,1],["بعميدها المهدي قامت في الورى","عمد الهدى وبها استقام قوام",18,"م",1,0],["بعِمامَةٍ مِنْ خدِّهِ","أَوْ خَدُّهُ مِنْها اسْتَرَقْ",19,"ق",1,0],["بعملك ما لاقيت مولاي منمها","وما سبباه يا مليك لشقوتي",20,"ي",1,0],["بعمومة في الأزْد عزَّ نصابُه","وخُؤولةٍ لقريشَ طاب فخارُهُ",21,"ر",2,0],["بعمره أقسم الديان بارئنا","في النور تنزيله الفرقان مستطر",22,"ر",1,0],["بعمي وخالي ذلك الخال إنه","ختام على ماء الحياة لشاربه",23,"ب",2,1],["بعمرك ما سر الوجود بغامض","وإن جهلتْ منَّا اليمين شمالها",24,"ل",3,0],["بعمرو وبالزُّهريّ والسَّلفِ الأَولى","بهم ثَبتت رجلاك عند المقاومِ",25,"م",1,1],["بعميدها المهدي قامت للورى","عمد الهدى ولهن قام دعام",26,"م",1,0],["بِع مَن جَفاكَ وَلا تَبخَل بِسِلعَتِهِ","وَاِطلُب بِهِ بَدَلاً إِن رامَ تَبديلا",27,"ل",2,0],["بعمران لا تفرقوا بالنساء أَتى","توفاهم تخيرون لَهُ اِنجلا",28,"ل",2,0],["بعُمريَ لم أدفع ضريبة حاكم","عليّ ولكن للحياة ضرائب",29,"ب",1,1],["بعمري كم تجرعتُ الرزايا","ولكن ما تجرعت الدنايا",30,"ي",2,1],["بعمائمٍ تعلو على التيجان","ما أذعنت للظلم والطغيان",31,"ن",1,0],["بعم رَسول اللَه طالَ فَخارهُم","وَنالوا بِهِ مَجداً رَفيعاً وَسُؤددا",32,"د",2,0],["بِعُمرِ كَسكَرَ طابَ اللَهوُ وَالطَرَبُ","وَاليادَكاراتُ وَالأَدوارُ وَالنُجُبُ",33,"ب",1,1],["بعمامة من خده","أو خده منها سرق",34,"ق",1,0],["بعمامة كغمامة","كبرت على لعب الكور",35,"ر",1,0],["بعماد هذا الدين والملك الذي","تتبادر الاملاك لثم ركابه",36,"ب",2,0],["بعمر مديد في سرور ونعمة","وعز وإقبال وأوفر نعمة",37,"ه",1,0],["بعماد الدّين أضْحَتْ عُرْوَةُ الد","دينِ مَعصوباً بها الفتحُ المبينْ",38,"ن",1,1],["بعمر الصبا حرمتني الصبا","وأهدت إليّ الأسى والحمولا",39,"ل",2,0],["بعمري لا رضخت ولا يهزني هالزمن لو طال","ولا همني ،، جنون الحب لأي ابعاد ياخذنا",40,"ن",2,0],["بعمر الورد ايه الورد وحنا يالغلا اطفال","وكيف إنا تحدينا ظروف(ن) ،، ما تساعدنا",40,"ن",2,0],["بعمق الروح تسكن ياحبيبي","ويحضنك الفؤاد ولا يراك",41,"ك",1,0]]}