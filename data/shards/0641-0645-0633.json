{"poems":[[71,"مرسى السيادة سدة سيفية","https://www.aldiwan.net/poem3983.html","الكامل"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[62,"كرات دستنبوية نضدت","https://www.aldiwan.net/poem52398.html","السريع"],[97,"يا غلة المتلهف الصادي","https://www.aldiwan.net/poem24996.html","أحذ الكامل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"]],"verses":[["فَمَسَرَّةٌ لِلمُسنِتينَ مَساءَةٌ","سَبَقَت لِسَرحِ سَوامِهِ وَالكيسِ",0,"س",1,0],["فَمُستَنكِرٌ كَيفَ اِستَحالَت بَشاشَتي","كَمُستَنكِرٍ في عاصِفِ رَعشَةِ الغُصنِ",1,"ن",1,0],["فَمَسّاهُم وَبُسطُهُمُ حَريرٌ","وَصَبَّحَهُم وَبُسطُهُمُ تُرابُ",2,"ب",1,0],["فمستديرُ الشكلِ ذو سُمْرَةٍ","كأنَّهُ جُمْجُمةُ العنبرِ",3,"ر",1,0],["فمسحت بالقبلات أدمعها","وطبعت ميثاقي على فمها",4,"ه",2,0],["فَمَسَحَت جُنوبُنا المَضاجِعا","وَلَم أَكُن لِلنَومِ قَبلَ طائِعا",5,"ع",2,0],["فَمَسَحْتُهَا حَتَّى اطْمَأَنَّ فُؤَادُها","وَنَفَيْتُ رَوْعَتَهَا بِرَأْيٍ مُحْصَدِ",6,"د",1,0]]}