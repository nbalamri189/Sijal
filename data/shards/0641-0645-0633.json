{"poems":[[71,"مرسى السيادة سدة سيفية","https://www.aldiwan.net/poem3983.html","الكامل"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[62,"كرات دستنبوية نضدت","https://www.aldiwan.net/poem52398.html","السريع"],[97,"يا غلة المتلهف الصادي","https://www.aldiwan.net/poem24996.html","أحذ الكامل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[143,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[169,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[259,"بالله ضع قدميك فوق محاجري","https://www.aldiwan.net/poem35507.html","الكامل"],[259,"لم أنس بحمص أنس العي","https://www.aldiwan.net/poem35550.html","المتدارك"],[270,"هلا التفت لكي نحييك","https://www.aldiwan.net/poem35361.html","أحذ الكامل"],[282,"نجم القاضي الشرف الفلكي","https://www.aldiwan.net/poem32682.html","المتدارك"],[298,"هل من يعين على التجلد ساعة","https://www.aldiwan.net/poem36292.html","عموديه"],[322,"ما الناس إلا في رماق وصالح","https://www.aldiwan.net/poem56355.html","الطويل"],[349,"أراني البعض في بعضي","https://www.aldiwan.net/poem15758.html","الهزج"],[364,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[380,"أمير لج في هجري","https://www.aldiwan.net/poem48791.html","مجزوء الوافر"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[458,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[458,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[461,"بقيت لكل مكرمة وبأس","https://www.aldiwan.net/poem16169.html","الوافر"],[465,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[515,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[551,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[575,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"]],"verses":[["فَمَسَرَّةٌ لِلمُسنِتينَ مَساءَةٌ","سَبَقَت لِسَرحِ سَوامِهِ وَالكيسِ",0,"س",1,0],["فَمُستَنكِرٌ كَيفَ اِستَحالَت بَشاشَتي","كَمُستَنكِرٍ في عاصِفِ رَعشَةِ الغُصنِ",1,"ن",1,0],["فَمَسّاهُم وَبُسطُهُمُ حَريرٌ","وَصَبَّحَهُم وَبُسطُهُمُ تُرابُ",2,"ب",1,0],["فمستديرُ الشكلِ ذو سُمْرَةٍ","كأنَّهُ جُمْجُمةُ العنبرِ",3,"ر",1,0],["فمسحت بالقبلات أدمعها","وطبعت ميثاقي على فمها",4,"ه",2,0],["فَمَسَحَت جُنوبُنا المَضاجِعا","وَلَم أَكُن لِلنَومِ قَبلَ طائِعا",5,"ع",2,0],["فَمَسَحْتُهَا حَتَّى اطْمَأَنَّ فُؤَادُها","وَنَفَيْتُ رَوْعَتَهَا بِرَأْيٍ مُحْصَدِ",6,"د",1,0],["فَمَساعي الأَجدادِ لَن يَبعُدَ العَه","دُ بِها وَهيَ وُضَّحٌ في الحالِ",7,"ل",1,0],["فَمَسرَحُ لَذّتي وَمَراحُ لَهوِي","هُنالِكُمُ وَجِيرَتِيَ الكِرامُ",8,"م",1,0],["فَمَسُّ الأَرضِ أَو أَلقى عَلِيّاً","عَلى رَحلي وَراحِلَتي حَرامُ",8,"م",1,0],["فمسامعي مثلي بحبّك قد غدت","تهوَى حديثك مثلما أهواكا",9,"ك",2,0],["فمسرّة قلبي رؤية عي","ني طائعها أو عاصيها",10,"ه",2,0],["فمساحبُ الأذيالِ منكِ على","مُقَلٍ وأفئدةٍ تُفدّيك",11,"ك",1,0],["فَمُساجِلُهُ في المَجدِ يُبا","ري الحُصنَ عِتاقاً بِالرَّمَكِ",12,"ك",1,0],["فمسحتُها حتى اطمأْنَّ فؤادُهُ","وأَعدتُ بعدئذ عليه سؤالا",13,"ل",2,0],["فَمُستَلَبٌ مِنهُ رِياشٌ وَمُكتَسٍ","وَعارٍ وَمِنهُم مُترِبٌ وَفَقيرُ",14,"ر",1,0],["فَمَسنونُ التُقى مِنّي","وَمَفروضُ الهُدى فَرضي",15,"ي",1,0],["فمسائل الفقهاء مُنشَدةٌ على","آثارهنَّ مدائح الشُّعراء",16,"ا",2,0],["فَمَسَّ بِكَفِهِ صُدري","لِيُطفئ واقد الجَمر",17,"ر",1,0],["فمسبلاً فيها بقايا أدمع","فناشداً فيها قلوباً وحشا",18,"ا",1,0],["فمسلم ينظره من علٍ","وكافر ذو ناظرٍ مطرِقِ",19,"ق",1,0],["فمستبردٌ يَهنَى بأوّلِ شَربةٍ","ومستكثِرٌ يثنى له ويزيدُ",20,"د",1,0],["فمُستَجْديكَ غانٍ عنْ سَحابٍ","ومُسْتعديك غانٍ عنْ نِزالِ",21,"ل",1,0],["فَمَسَّكَ من دونِ قَصدٍ فَمات","وأبقاكَ نجماً من الأنْجُمِ !",22,"م",1,0],["فمستقبل أضحى بشكرك يبتدي","وماض وقد أمسى بذكرك يختم",23,"م",1,0],["فَمِسْنَ غصوناً واِطّلَعْن أهِلَّةً","وفُحْنَ عبيراً أو سُلافاً معتّقا",24,"ق",2,0],["فمسائِي من السُّهَادِ صَباحي","وصبَاحي من السَّوَادِ مَسَائِي",25,"ي",1,0]]}