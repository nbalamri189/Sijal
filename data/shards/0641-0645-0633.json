{"poems":[[73,"مرسى السيادة سدة سيفية","https://www.aldiwan.net/poem3983.html","الكامل"],[93,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[45,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[64,"كرات دستنبوية نضدت","https://www.aldiwan.net/poem52398.html","السريع"],[99,"يا غلة المتلهف الصادي","https://www.aldiwan.net/poem24996.html","أحذ الكامل"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[173,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[264,"بالله ضع قدميك فوق محاجري","https://www.aldiwan.net/poem35507.html","الكامل"],[264,"لم أنس بحمص أنس العي","https://www.aldiwan.net/poem35550.html","المتدارك"],[275,"هلا التفت لكي نحييك","https://www.aldiwan.net/poem35361.html","أحذ الكامل"],[287,"نجم القاضي الشرف الفلكي","https://www.aldiwan.net/poem32682.html","المتدارك"],[303,"هل من يعين على التجلد ساعة","https://www.aldiwan.net/poem36292.html","عموديه"],[327,"ما الناس إلا في رماق وصالح","https://www.aldiwan.net/poem56355.html","الطويل"],[354,"أراني البعض في بعضي","https://www.aldiwan.net/poem15758.html","الهزج"],[369,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[385,"أمير لج في هجري","https://www.aldiwan.net/poem48791.html","مجزوء الوافر"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[463,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[466,"بقيت لكل مكرمة وبأس","https://www.aldiwan.net/poem16169.html","الوافر"],[470,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[520,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[580,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104566","الطويل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44996","الخفيف"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128285","الوافر"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79443","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89713","الرمل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76802","الطويل"],[2080,"","https://poetry.dctabudhabi.ae/diwan/poem/124619","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177826","الكامل"],[2246,"","https://poetry.dctabudhabi.ae/diwan/poem/116767","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132318","الوافر"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102533","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140044",""],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102350","الطويل"],[3148,"","https://poetry.dctabudhabi.ae/diwan/poem/203635","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145036","الطويل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125985","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52977","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36760","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95324","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69983","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146767","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107132","الطويل"],[5121,"لذيذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33869",""],[5398,"عيناك ترنو للبقاء","https://www.poetsgate.com/ViewPoem.aspx?id=37218",""],[5431,"لقد آنس الأرواح حزنٌ مقعرُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198970",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5459,"وباء الفرنَجة","https://www.poetsgate.com/ViewPoem.aspx?id=203965",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""],[5612,"رسولَ اللهِ ضاعَ الحُبُّ مِنّا","https://www.poetsgate.com/ViewPoem.aspx?id=179714",""],[5725,"كبائر عينيها","https://www.poetsgate.com/ViewPoem.aspx?id=210282",""],[6102,"طَلَقَةُ الرَّحمَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=186256",""],[6142,"من فالق الكبش من قرن إلى قدم","https://www.poetsgate.com/ViewPoem.aspx?id=155714",""],[6187,"أتذكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82158&r=&rc=2",""],[6209,"كفران","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82547&r=&rc=16",""]],"verses":[["فَمَسَرَّةٌ لِلمُسنِتينَ مَساءَةٌ","سَبَقَت لِسَرحِ سَوامِهِ وَالكيسِ",0,"س",1,0],["فَمُستَنكِرٌ كَيفَ اِستَحالَت بَشاشَتي","كَمُستَنكِرٍ في عاصِفِ رَعشَةِ الغُصنِ",1,"ن",1,0],["فَمَسّاهُم وَبُسطُهُمُ حَريرٌ","وَصَبَّحَهُم وَبُسطُهُمُ تُرابُ",2,"ب",1,0],["فمستديرُ الشكلِ ذو سُمْرَةٍ","كأنَّهُ جُمْجُمةُ العنبرِ",3,"ر",1,0],["فمسحت بالقبلات أدمعها","وطبعت ميثاقي على فمها",4,"ه",2,0],["فَمَسَحَت جُنوبُنا المَضاجِعا","وَلَم أَكُن لِلنَومِ قَبلَ طائِعا",5,"ع",2,0],["فَمَسَحْتُهَا حَتَّى اطْمَأَنَّ فُؤَادُها","وَنَفَيْتُ رَوْعَتَهَا بِرَأْيٍ مُحْصَدِ",6,"د",1,0],["فَمَساعي الأَجدادِ لَن يَبعُدَ العَه","دُ بِها وَهيَ وُضَّحٌ في الحالِ",7,"ل",1,0],["فَمَسرَحُ لَذّتي وَمَراحُ لَهوِي","هُنالِكُمُ وَجِيرَتِيَ الكِرامُ",8,"م",1,0],["فَمَسُّ الأَرضِ أَو أَلقى عَلِيّاً","عَلى رَحلي وَراحِلَتي حَرامُ",8,"م",1,0],["فمسامعي مثلي بحبّك قد غدت","تهوَى حديثك مثلما أهواكا",9,"ك",2,0],["فمسرّة قلبي رؤية عي","ني طائعها أو عاصيها",10,"ه",2,0],["فمساحبُ الأذيالِ منكِ على","مُقَلٍ وأفئدةٍ تُفدّيك",11,"ك",1,0],["فَمُساجِلُهُ في المَجدِ يُبا","ري الحُصنَ عِتاقاً بِالرَّمَكِ",12,"ك",1,0],["فمسحتُها حتى اطمأْنَّ فؤادُهُ","وأَعدتُ بعدئذ عليه سؤالا",13,"ل",2,0],["فَمُستَلَبٌ مِنهُ رِياشٌ وَمُكتَسٍ","وَعارٍ وَمِنهُم مُترِبٌ وَفَقيرُ",14,"ر",1,0],["فَمَسنونُ التُقى مِنّي","وَمَفروضُ الهُدى فَرضي",15,"ي",1,0],["فمسائل الفقهاء مُنشَدةٌ على","آثارهنَّ مدائح الشُّعراء",16,"ا",2,0],["فَمَسَّ بِكَفِهِ صُدري","لِيُطفئ واقد الجَمر",17,"ر",1,0],["فمسبلاً فيها بقايا أدمع","فناشداً فيها قلوباً وحشا",18,"ا",1,0],["فمسلم ينظره من علٍ","وكافر ذو ناظرٍ مطرِقِ",19,"ق",1,0],["فمستبردٌ يَهنَى بأوّلِ شَربةٍ","ومستكثِرٌ يثنى له ويزيدُ",20,"د",1,0],["فمُستَجْديكَ غانٍ عنْ سَحابٍ","ومُسْتعديك غانٍ عنْ نِزالِ",21,"ل",1,0],["فَمَسَّكَ من دونِ قَصدٍ فَمات","وأبقاكَ نجماً من الأنْجُمِ !",22,"م",1,0],["فمستقبل أضحى بشكرك يبتدي","وماض وقد أمسى بذكرك يختم",23,"م",1,0],["فَمِسْنَ غصوناً واِطّلَعْن أهِلَّةً","وفُحْنَ عبيراً أو سُلافاً معتّقا",24,"ق",2,0],["فمسائِي من السُّهَادِ صَباحي","وصبَاحي من السَّوَادِ مَسَائِي",25,"ي",1,0],["فمستنصرٌ باللَهِ ورّثَ سعدهُ","لمستعصمٍ باللَهِ أرّثَ أسعدا",26,"د",2,0],["فَمَساويكَها بِها كُلُّ يَومٍ","في رِياضِ مِن اِصطِباحِ الراح",27,"ح",1,0],["فمسنا كيف شئت ولا تكلنا","إلى تدبيرنا يا ذا المعالي",28,"ل",2,0],["فمسَّكَ وردَ خدَّيهِ السَّوافي","وعَنْبَر مِسْكَ صدغَيْهِ الغبارُ",29,"ر",1,0],["فمستأسد يبري إلى متنمر","ومعتسف يأوي إلى متعسق",30,"ق",1,0],["فَمسر الخَير موسوم بِهِ","وَمسر الشَر مَوسوم بِشر",31,"ر",1,0],["فمسّح عنه الترب اذ مس جلده","وقد نام نوم النافر المتفرد",32,"د",1,0],["فمستنم العرضان فالجبّ ذو الصفا","فحيث استقرت حول مكر الأوانس",33,"س",1,0],["فمسود بين الورى ومسود","وجه النهى بصحائف مسودة",34,"ه",1,0],["فمُسّا ترابَ الأرض منها خلقتُما","ومنها المعاد والمصيرُ إلى الحشرِ",35,"ر",1,0],["فمستورُ الحقائِقِ مِنهُ شَمسٌ","وطُرقُ الشَّرعِ إمنَةُ الفُجَاجِ",36,"ج",1,0],["فمستودع سرّ أفشاه فلم تلم","بلى أنت مليوم كما ضقت بالسر",37,"ر",1,0],["فمسة سال من حليب","ينصب في داخل السقاء",38,"ا",2,0],["فمستودع ضاع الذي كان عنده","ومستودع ما عندَه غير ضائع",39,"ع",1,0],["فمسكنا السكانَ وانهزم البي","تُ لدينا خوفاً من الطاقات",40,"ت",1,0],["فمسرحها ذكرى لإبداع فنها","وساحتها ذكرى لعرض المسائل",41,"ل",1,0],["فمسست لسان مريم حتى","نطقت بين قومها بنشيد",42,"د",1,0],["فمسقط الرأس أحّبْ","من رأس مال يُكتسب",43,"ب",1,0],["فَمَسيل باناسٍ إِلى","بَطحاءِ وادٍ مُحتَرَم",44,"م",1,0],["فَمَسيل باناسٍ إِلى","بِطحاءَ في رَوض أَغَن",45,"ن",1,0],["فَمسبِّحٌ ومقدسٌ وممجدٌ","ومعظمٌ ومكبِّر ومهلِّلُ",46,"ل",1,0],["فمسحت هامهم بسطوة قادر","مسخت جبابرة الوغى أطفالا",47,"ل",2,0],["فَمسطر التاريخ أَعربَ قائِلاً","بِيَمينِ يوسف وَردةُ الشاروني",48,"ن",2,0],["فمستن السيول بحافتيه","فمجرى ذلك العذب الزلال",49,"ل",1,0],["فمُسْخِطُ السلطان في البريهْ","مُعَرِّضُ النفس على المنيَّهْ",50,"ه",1,0],["فمسند فضل من أبيه مؤثلا","ومن عمه قد عم مدّته النصر",51,"ر",1,0],["فمسرورٌ بهِ قلبي","إذا ما السّكرُ انراقا",52,"ق",2,0],["فمسكتُ دمعي في الوداعِ تصبُّراً.","ودموعُ عيني في الخفاءِ دماءُ",53,"ا",2,0],["فمستنيَ السبع العجاف بقحطها","ورغم رياح الموت مازلتُ أُثمرُ",54,"ر",1,0],["فمسحت ضرعيها فدرت حالباً","رسلاً يظن له المعين رسيلا",55,"ل",2,0],["فمستعمرٌ غاب عن أرضنا","وآخر نعجَز أن نُخرجَه",56,"ج",2,0],["فمستحسن الأعطاف يغني عن الغنى","ومستعذب الألفاظ يسلي عن السلوى",57,"و",2,0],["فَمَسْراكَ السليبُ يَسِحُّ دمْعاً","وتنْتَحِبُ المآذِنُ والبُراقُ",58,"ق",1,0],["فمستصغر الاشواق يكوي جوانبي","وكل أتونٍ تبتديه الصغائرُ",59,"ر",1,0],["فَمُسَلسَلُنا جِدُّ طَوِيلٍ","لا تَلوِي مِشنَقَةٌ عُنُقَهْ",60,"ق",2,0],["فمسها من فم الهادي رضاب شفا","فشوفيت وانجلى في الحال قاذيها",61,"ي",3,0],["فمسكونا خرجت بساكنيها","وعدت بحمد ربك تحتويها",62,"ي",3,0],["فمساء ثغرِكِ منزلٌ","وأنا أحبُّ تَشَرُّدي",63,"د",2,0]]}