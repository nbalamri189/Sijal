://poetry.dctabudhabi.ae/diwan/poem/83520","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4764,"موقعة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=33892",""],[4972,"يا فراشاً من المَدَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=94900",""],[4984,"تعيدك للأمس أيامُنا","https://www.poetsgate.com/ViewPoem.aspx?id=215388",""],[4119,"يا ليت أن الصد مصدود","https://www.poetsgate.com/ViewPoem.aspx?id=16113",""],[5121,"هَذَيَان","https://www.poetsgate.com/ViewPoem.aspx?id=213491",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5277,"قصارى القول..في رسول الله صلى الله عليه وآلهِ وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=212991",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5754,"مَا طبعوا سيوفهم من الحدق","https://www.poetsgate.com/ViewPoem.aspx?id=191643",""],[5853,"بتُ أخشى","https://www.poetsgate.com/ViewPoem.aspx?id=175714",""],[6089,"نهر البصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=212970",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""]],"verses":[["مَظْهَرُ الوَحْي مَطْلَعُ الحَقّ معْنَى","الخَلْقِ فتْحُ المُهَيْمِنِ الفتّاح",0,"ح",1,0],["مِظَنَّةُ آثامٍ وَأُمُّ كَبائِرٍ","يُقَصِّرُ عَن أَدنى مَعايِبِها العَدُّ",1,"د",1,0],["مَظْلومَةٌ فِيهَا فَإِنْ لَمْ تُقْلِهَا","مِنْ عِزَّةٍ كَيْفَ القِلَى لِلظَّالِمِ",2,"م",1,0],["مظاهر أقمار مراتبُ أنجم","منازلُ بالنصر العزيز أواهلُ",3,"ل",1,0],["مظفر الجدّ مشاء على جدد","من حلمه اللدن أو من حربه الشرس",4,"س",1,0],["مظفر الجدّ من حظٍّ ومن نسبٍ","مبصرٌ بخفيّ الرشد مِدْراك",5,"ك",1,0],["مظلومَ ما أنت بمظلومةٍ","في حُكمِ أهلِ الشرق والغَربْ",6,"ب",1,0],["مظلومَ قد أنهبتِ أرواحنا","وكلُّنا راضونَ بالنَّهبِ",6,"ب",1,0],["مظفَّرٌ بالتي يحاولها","لا يُعدِم الله سالماً ظَفره",7,"ر",2,0],["مظفّراً هز عطفيها مظفَّرةً","إذا تلقت صدوراً صرن أكتافا",8,"ف",2,0],["مظلومةٌ ظلّامةٌ أبداً","مُنيَتْ بِمُتَّهِم بِمُتَّهَمِ",9,"م",1,0],["مُظاهِرُ سِربَالي حَديدٌ عَلَيهِما","عَقيلاً سُيوفٍ مِخذَمٌ وَرُسوبُ",10,"ب",1,0],["مظهر الشمس في الوجود علوا","ونشاط الأفلاك في الدوران",11,"ن",1,0],["مَظلومَةُ القَدِّ في تَشبيهِهِ غُصُناً","مَظلومَةُ الريقِ في تَشبيهِهِ ضَرَبا",12,"ب",2,0],["مظاهرٌ بين أثوابِ الجمال وقد","أغناهُ ذلك عن حَلْيٍ وعن حُلَلِ",13,"ل",1,0],["مُظاهِرٌ ثوبَ حِدادٍ على","ثوب بياضٍ عُلَّ بالوَرْسِ",14,"س",1,0],["مُظَفَّرٌ ما تَكادُ تَسري مِنَ الآ","فاقِ إِلّا بِمُفرِحٍ بُرُدُه",15,"د",2,0],["مَظِنَّةُ خَمّارينَ تُمسي لَئيمَةً","أُقَيوامُهُ في أَهلِها وَأَراهِطُه",16,"ط",2,0],["مُظَفَّرٌ لَم نَزَل نَلقى بِطَلعَتِهِ","كَواكِبَ السَعدِ وَالطَيرِ المَيامينا",17,"ن",2,0],["مُظَفَّرٍ في الحَربِ ما سِرُّها","بِظاهِرٍ عَن حَظرِ تَحصينِهِ",18,"ن",2,0],["مظلومَةُ الحُسنِ إن شبَّهتُ طَلْعَتَها","صُبحاً يسالمُ في إشراقِه الظُّلَما",19,"م",2,0],["مُظَفَّرُ الغَزوِ لم تُحْرَمْ صَوارِمُه","ما أمَّلْته ولم تُخْفِقْ عَواسِلُه",20,"ل",2,0],["مظلومةُ القدِّ في تشبيهها غصنا","مظلومةُ الريقِ في تشبيهها ضَرَبَا",21,"ب",2,0],["مظلومةُ القدِّ في تشبيهها غصناً","مظلومةُ الريقِ إذ قلنا هي الضَرَبُ",22,"ب",1,0],["مظهرُ الحقِّ للنبوّةِ سبحا","نكَ ربّاً فرد الجلال قديرا",23,"ر",2,0],["مَظلومة سيقت إِلى ظالم","نغّص مغداها وَمَسراها",24,"ا",3,0],["مُظَفَّرٌ مَن قَد أَبانَ مَكرا","وَماتَ خَوفاً مِنهُما وَذُعرا",25,"ر",2,0],["مُظْهِرٍ شَجّةَ الْجَبِينِ عَلَى البُرْ","ءِ كما أَظهرَ الهلالَ البَرَاءُ",26,"ا",2,0],["مُظَلَّلُ مِحجَرِ العَينَي","نِ جَيبُ قَميصِهِ قِدَدُ",27,"د",1,0],["مُظلِمُ النِسبَةِ لايُع","رَفُ إِلّا بِالسِراجِ",28,"ج",1,0],["مظلومةٌ باللَّحظِ وَجْنتُها","وجفونُها جُبلتْ على الظُّلْمِ",29,"م",1,1],["مُظفَّرٌ لا تُردُّ عزْمتُهُ","ومَن يَردُّ الكتابَ عن أجلِهْ",30,"ل",2,0],["مُظْهِراً ما كنتُ أُخْفي من قَدِي","مِ حديثٍ صانهُ منّيَ طَي",31,"ي",1,0],["مظاهرُ ليس بِها ما يخيفُ","ولكنَّما خاف مَنْ يَظْلِمُ",32,"م",1,0],["مظهراً أني كنتُ أحمل نفساً","لم يكن للشكوك فيها خطورُ",33,"ر",1,0],["مَظلومَةٌ في جِوارِ الخَوفِ ظالِمَةٌ","وَالنَفسُ مُؤذِيَةٌ مَن راحَ يُؤذيها",34,"ي",3,0],["مَظْلُومَةُ لَيْسَ لَهَا مُنْصِفٌ","مَنْجُودَةٌ أَخْطَاتِ الْمُنْجِدَا",35,"د",2,0],["مظاهر سر ابرز الامر نوعها","فتنحط حينا بعد ما هي تشمخ",36,"خ",1,0],["مظاهر الحكم الحسنا طريقته","وسيره حكمة من أبدع الحكم",37,"م",1,0],["مظهر المجد هيكل السعد مولى ال","خلق من قبل خلق طين وماء",38,"ا",2,0],["مظاهره العليا وأوصاف ذاته","تسامت عن التعريف في شعر ناظم",39,"م",1,0],["مظهر جلت معالي سره","فهو في تعريفه جزء وكل",40,"ل",1,0],["مظاهر أسرار بواطن رمزها","أشائر آيات تدل على اللَه",41,"ل",2,1],["مظلم الحس والبصيرة كالتم","ثال خلو من الحجا والذكاء",42,"ا",2,0],["مُظلمٌ مُوحِشٌ كثير الأفاعي","والسَّعالي المُستهوياتِ الطَرائد",43,"د",1,0],["مُظفَّرٌ مالمغرورِ يُطالِبُهُ","في الأرض من ملجأ عنهُ ولا وَزَرِ",44,"ر",1,0],["مظاهرٌ بهرتنا عند رؤيتها","وأجرت الدمع سيلاً من مآقينا",45,"ن",2,0],["مُظَفَّرٌ مَن تُظِلُّهُ هَذِهِ ال","راياتُ لا مَن تُظِلُّهُ الصُلُبُ",46,"ب",1,0],["مُظَفَّراً لَم يَزَل في مَنعِ حَوزَتِهِ","يَستَخدِمُ العِزَّ وَالتَأييدَ وَالظَفَرا",47,"ر",2,0],["مظفرُ الجيش فما حطه","للحرب إلاّ حط ما حطّما",48,"م",2,0],["مظهرٌ لي ودّا ويأباهُ قلبي","دون من أصطفيه من جلاسي",49,"س",2,0],["مظفر ظفرة الله بي","عقوبة جاءت لمقدار",50,"ر",1,1],["مُظلِمَ الأَرجاءِ لا يُر","فَعُ لِلساري مَنارُه",51,"ر",2,0],["مُظاهِرَ عِزٍّ لا يَرِثُّ جَديدُهُ","وَمُلكٍ عَلى رَغمِ العِدى غَيرِ مَحدودِ",52,"د",1,0],["مَظِنَّةُ إتِْلافِ الْمُحِبِّ الْعَواذِلُ","أَلاَ لاَ رَعَى الرَّحْمَانُ مَنْ هُوَ عَاذِلُ",53,"ل",1,1],["مظاهرات عليهم يوم بأسهم","لونان جُونٌ وأخرى فوقها حُمرُ",54,"ر",1,0],["مظالمهُ عمّت وجمّت ذنوبُهُ","فأنكرَها إذ ليسَ فيهِ حياء",55,"ا",2,0],["مظللة في غورها وَنجودها","وَمدت لاهل الفضل شمس سعودها",56,"ه",2,0],["مُظَفَّرُ الْعَزْمِ ما تَأْلُو مُوَفَّقَةً","آراؤُهُ بَيْنَ إِيْرادٍ وَإِصْدارِ",57,"ر",1,0],["مظفرَ الدينِ