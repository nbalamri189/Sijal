ي لدعوة مستقل","https://www.aldiwan.net/poem34755.html","الوافر"],[439,"وفي غيابات أطباق الخطوب شج","https://www.aldiwan.net/poem34760.html","البسيط"],[439,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[439,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[439,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[439,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[439,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[458,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[461,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[461,"مظفر الدين إن فاق الرجال فقد","https://www.aldiwan.net/poem15173.html","البسيط"],[461,"عجائب أرض الله شتى كثيرة","https://www.aldiwan.net/poem16409.html","الطويل"],[461,"أكفكف عن سمع الأمير مدائحي","https://www.aldiwan.net/poem16411.html","الطويل"],[461,"مظفر الدين والنداء لذي","https://www.aldiwan.net/poem16414.html","المنسرح"],[461,"وإني ومدح الفارس الشهم يزدن","https://www.aldiwan.net/poem16415.html","الطويل"],[464,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[464,"إن هم الأمير أصلحه الله","https://www.aldiwan.net/poem3364.html","عموديه"],[479,"يا فم حف بالورود شفاها","https://www.aldiwan.net/poem37004.html","الخفيف"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"يا حداة العيس مهلا فالحمى","https://www.aldiwan.net/poem37639.html","الرمل"],[500,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[500,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[515,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[542,"زعم العبد طاهر","https://www.aldiwan.net/poem34048.html","مجزوء الخفيف"],[551,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[553,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[562,"اليوم قبة بيت القدس قد رفعت","https://www.aldiwan.net/poem52525.html","البسيط"],[562,"قلب الخليفة يقظان يجرده","https://www.aldiwan.net/poem52786.html","البسيط"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[575,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[575,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"]],"verses":[["مَظْهَرُ الوَحْي مَطْلَعُ الحَقّ معْنَى","الخَلْقِ فتْحُ المُهَيْمِنِ الفتّاح",0,"ح",1,0],["مِظَنَّةُ آثامٍ وَأُمُّ كَبائِرٍ","يُقَصِّرُ عَن أَدنى مَعايِبِها العَدُّ",1,"د",1,0],["مَظْلومَةٌ فِيهَا فَإِنْ لَمْ تُقْلِهَا","مِنْ عِزَّةٍ كَيْفَ القِلَى لِلظَّالِمِ",2,"م",1,0],["مظاهر أقمار مراتبُ أنجم","منازلُ بالنصر العزيز أواهلُ",3,"ل",1,0],["مظفر الجدّ مشاء على جدد","من حلمه اللدن أو من حربه الشرس",4,"س",1,0],["مظفر الجدّ من حظٍّ ومن نسبٍ","مبصرٌ بخفيّ الرشد مِدْراك",5,"ك",1,0],["مظلومَ ما أنت بمظلومةٍ","في حُكمِ أهلِ الشرق والغَربْ",6,"ب",1,0],["مظلومَ قد أنهبتِ أرواحنا","وكلُّنا راضونَ بالنَّهبِ",6,"ب",1,0],["مظفَّرٌ بالتي يحاولها","لا يُعدِم الله سالماً ظَفره",7,"ر",2,0],["مظفّراً هز عطفيها مظفَّرةً","إذا تلقت صدوراً صرن أكتافا",8,"ف",2,0],["مظلومةٌ ظلّامةٌ أبداً","مُنيَتْ بِمُتَّهِم بِمُتَّهَمِ",9,"م",1,0],["مُظاهِرُ سِربَالي حَديدٌ عَلَيهِما","عَقيلاً سُيوفٍ مِخذَمٌ وَرُسوبُ",10,"ب",1,0],["مظهر الشمس في الوجود علوا","ونشاط الأفلاك في الدوران",11,"ن",1,0],["مَظلومَةُ القَدِّ في تَشبيهِهِ غُصُناً","مَظلومَةُ الريقِ في تَشبيهِهِ ضَرَبا",12,"ب",2,0],["مظاهرٌ بين أثوابِ الجمال وقد","أغناهُ ذلك عن حَلْيٍ وعن حُلَلِ",13,"ل",1,0],["مُظاهِرٌ ثوبَ حِدادٍ على","ثوب بياضٍ عُلَّ بالوَرْسِ",14,"س",1,0],["مُظَفَّرٌ ما تَكادُ تَسري مِنَ الآ","فاقِ إِلّا بِمُفرِحٍ بُرُدُه",15,"د",2,0],["مَظِنَّةُ خَمّارينَ تُمسي لَئيمَةً","أُقَيوامُهُ في أَهلِها وَأَراهِطُه",16,"ط",2,0],["مُظَفَّرٌ لَم نَزَل نَلقى بِطَلعَتِهِ","كَواكِبَ السَعدِ وَالطَيرِ المَيامينا",17,"ن",2,0],["مُظَفَّرٍ في الحَربِ ما سِرُّها","بِظاهِرٍ عَن حَظرِ تَحصينِهِ",18,"ن",2,0],["مظلومَةُ الحُسنِ إن شبَّهتُ طَلْعَتَها","صُبحاً يسالمُ في إشراقِه الظُّلَما",19,"م",2,0],["مُظَفَّرُ الغَزوِ لم تُحْرَمْ صَوارِمُه","ما أمَّلْته ولم تُخْفِقْ عَواسِلُه",20,"ل",2,0],["مظلومةُ القدِّ في تشبيهها غصنا","مظلومةُ الريقِ في تشبيهها ضَرَبَا",21,"ب",2,0],["مظلومةُ القدِّ في تشبيهها غصناً","مظلومةُ الريقِ إذ قلنا هي الضَرَبُ",22,"ب",1,0],["مظهرُ الحقِّ للنبوّةِ سبحا","نكَ ربّاً فرد الجلال قديرا",23,"ر",2,0],["مَظلومة سيقت إِلى ظالم","نغّص مغداها وَمَسراها",24,"ا",3,0],["مُظَفَّرٌ مَن قَد أَبانَ مَكرا","وَماتَ خَوفاً مِنهُما وَذُعرا",25,"ر",2,0],["مُظْهِرٍ شَجّةَ الْجَبِينِ عَلَى البُرْ","ءِ كما أَظهرَ الهلالَ البَرَاءُ",26,"ا",2,0],["مُظَلَّلُ مِحجَرِ العَينَي","نِ جَيبُ قَميصِهِ قِدَدُ",27,"د",1,0],["مُظلِمُ النِسبَةِ لايُع","رَفُ إِلّا بِالسِراجِ",28,"ج",1,0],["مظلومةٌ باللَّحظِ وَجْنتُها","وجفونُها جُبلتْ على الظُّلْمِ",29,"م",1,1],["مُظفَّرٌ لا تُردُّ عزْمتُهُ","ومَن يَردُّ الكتابَ عن أجلِهْ",30,"ل",2,0],["مُظْهِراً ما كنتُ أُخْفي من قَدِي","مِ حديثٍ صانهُ منّيَ طَي",31,"ي",1,0],["مظاهرُ ليس بِها ما يخيفُ","ولكنَّما خاف مَنْ يَظْلِمُ",32,"م",1,0],["مظهراً أني كنتُ أحمل نفساً","لم يكن للشكوك فيها خطورُ",33,"ر",1,0],["مَظلومَةٌ في جِوارِ الخَوفِ ظالِمَةٌ","وَالنَفسُ مُؤذِيَةٌ مَن راحَ يُؤذيها",34,"ي",3,0],["مَظْلُومَةُ لَيْسَ لَهَا مُنْصِفٌ","مَنْجُودَةٌ أَخْطَاتِ الْمُنْجِدَا",35,"د",2,0],["مظاهر سر ابرز الامر نوعها","فتنحط حينا بعد ما هي تشمخ",36,"خ",1,0],["مظاهر الحكم الحسنا طريقته","وسيره حكمة من أبدع الحكم",37,"م",1,0],["مظهر المجد هيكل السعد مولى ال","خلق من قبل خلق طين وماء",38,"ا",2,0],["مظاهره العليا وأوصاف ذاته","تسامت عن التعريف في شعر ناظم",39,"م",1,0],["مظهر جلت معالي سره","فهو في تعريفه جزء وكل",40,"ل",1,0],["مظاهر أسرار بواطن رمزها","أشائر آيات تدل على اللَه",41,"ل",2,1],["مظلم الحس والبصيرة كالتم","ثال خلو من الحجا والذكاء",42,"ا",2,0],["مُظلمٌ مُوحِشٌ كثير الأفاعي","والسَّعالي المُستهوياتِ الطَرائد",43,"د",1,0],["مُظفَّرٌ مالمغرورِ يُطالِبُهُ","في الأرض من ملجأ عنهُ ولا وَزَرِ",44,"ر",1,0],["مظاهرٌ بهرتنا عند رؤيتها","وأجرت الدمع سيلاً من مآقينا",45,"ن",2,0],["مُظَفَّرٌ مَن تُظِلُّهُ هَذِهِ ال","راياتُ لا مَن تُظِلُّهُ الصُلُبُ",46,"ب",1,0],["مُظَفَّراً لَم يَزَل في مَنعِ حَوزَتِهِ","يَستَخدِمُ العِزَّ وَالتَأييدَ وَالظَفَرا",47,"ر",2,0],["مظفرُ الجيش فما حطه","للحرب إلاّ حط ما حطّما",48,"م",2,0],["مظهرٌ لي ودّا ويأباهُ قلبي","دون من أصطفيه من جلاسي",49,"ي",1,0],["مظفر ظفرة الله بي","عقوبة جاءت لمقدار",50,"ر",1,1],["مُظلِمَ الأَرجاءِ لا يُر","فَعُ لِلساري مَنارُه",51,"ر",2,0],["مُظاهِرَ عِزٍّ لا يَرِثُّ جَديدُهُ","وَمُلكٍ عَلى رَغمِ العِدى غَيرِ مَحدودِ",52,"د",1,0],["مَظِنَّةُ إتِْلافِ الْمُحِبِّ الْعَواذِلُ","أَلاَ لاَ رَعَى الرَّحْمَانُ مَنْ هُوَ عَاذِلُ",53,"ل",1,1],["مظاهرات عليهم يوم بأسهم","لونان جُونٌ وأخرى فوقها حُمرُ",54,"ر",1,0],["مظالمهُ عمّت وجمّت ذنوبُهُ","فأنكرَها إذ ليسَ فيهِ حياء",55,"ا",2,0],["مظللة في غورها وَنجودها","وَمدت لاهل الفضل شمس سعودها",56,"ه",2,0],["مُظَفَّرُ الْعَزْمِ ما تَأْلُو مُوَفَّقَةً","آراؤُهُ بَيْنَ إِيْرادٍ وَإِصْدارِ",57,"ر",1,0],["مظفرَ الدينِ دُعاءَ مَن رَمى","كَلكَلَهُ الدَهرُ عَلَيهِ وَبَرَك",58,"ك",1,0],["مُظَفَّرُ دينِ اللَهِ أَهدى قُدومُهُ","إِلى القُدسِ أَمناً لا يَزالُ وَتَأنيسا",59,"س",2,0],["مُظَفَّرُ دينِ اللَهِ كُن في زَمانِنا","سُلَيمانَ لَمّا جاءهُ عَرشُ بَلقيسا",59,"س",2,0],["مُظَفَّرِ أَظفارٍ إِذا مَدَّ باعَهُ","سَطا بِنُيوبٍ حَدُّها لَيسَ بِالنابي",60,"ي",1,0],["مُظَفَّرَ الدينِ لا فارَقتَ تَهنِئَةً","بِما يُوافي بِسُؤلِ النَفسِ وَالأَرَبِ",61,"ب",1,0],["مُظاهَرَةُ الإِخوانِ أَمرٌ مُقَرَّرٌ","عَلَيهِ يَدورُ الشَأنَ فَاِستَوصِ بِالخَلِّ",62,"ل",1,0],["مُظلِمٌ ضَيِّقُ الفَنا","وَيلَهُ كَيفَ يَصنَعُ",63,"ع",1,0],["مظاهر تبدو للعيون وتختفى","وأسرارها العليا وراء قيودي",64,"ي",1,0],["مظهراً آثار سرٍّ باهرٍ","مُستمدّاً بِالفيوض النَبَويّه",65,"ي",2,0],["مَظِنَّتي حيثُ حَلَّ العِزُّ حُبْوتَه","والذُّلُّ لم أرهُ يوماً ولم يَرَني",66,"ن",2,0],["مظلومةٌ أبداً بكلِّ مفازَةٍ","مقتولةٌ صَبراً وإن لم تصبرِ",67,"ر",1,0],["مُظفَّرٌ كاسمِهِ نداه","في الرَّوع نابٌ له وظُفرُ",68,"ر",1,0],["مظهر للجميل يستر قبيحك","غافر الذنب شاكر للشكور",69,"ر",1,0],["مَظَلٌّ عِراقيُّ الثَّرى ومَقيلُ","أَلا قَلَّما تصفو مع البينِ عيشةٌ",70,"ه",1,0],["مظهرٌ من صنعه منقبة","حيَّر الأفكار فيها والعقولا",71,"ل",2,0],["مظهر أيّده الله وكم","أرجو منه فوق هذا مظهرا",72,"ر",2,0],["مُظاهِرِ لامَتَيْ بَغْيٍ ومكرٍ","ومُصْلِتِ صارِمَيْ قالٍ وقيلِ",73,"ل",1,0],["مُظاهِرٌ بَيْنَ لَيْلَيْ كُرْبَةٍ ودُجىً","لا يُرْتَجى لَهُما فَجْرٌ ولا سَحَرُ",74,"ر",1,0],["مُظَلَّلةً بِعَوالي الرِّماحِ","مُكَلَّلَةً بِطِوالِ الهوادي",75,"د",2,0],["مظالِمُ أَظْلَمَ حَقُّ المُحِقِّ","بِهِنَّ وأَشْرَقَ رَيْبُ المُرِيبِ",76,"ب",1,0],["مُظَلَّلَةً بالخافِقاتِ كَأَنَّها","ظِباءٌ تَهادى فِي ذرَا الأَيْكِ والطَّلْحِ",77,"ح",1,0],["مُظاهِرَ مَا أَوْرَثَتْكَ الجدودُ","من الحُلَلِ المُلْبساتِ الجُدُودا",78,"د",2,0],["مُظَفَّرٌ حازَ تاجَ مُلْكٍ","كُلِّلَ من نظمِ كلِّ فخْرِ",79,"ر",1,0],["مظالم لو رُفعن إلى كريم","لكان بسدّ عورتها حقيقا",80,"ق",2,0],["مظفَّرٌ في مساعيهِ ومَطْلبهِ","في سعده ينجح الأفْدامُ والبَهَمُ",81,"م",1,0],["مظفر الدين إنْ فاقَ الرجال فقد","فاق الجياد بيوم الطَّردِ أشْهبهُ",82,"ب",2,1],["مُظفَّرُ دينِ اللّهِ والماجِدُ الذي","تَزيدُ بهِ الدُّنْيا بَهاءً وتَحْسُنُ",83,"ن",1,0],["مُظفَّرُ دينِ اللّهِ والماجِدُ الذي","إذا سِيلَ لمْ يبْخَلْ وإِنْ لم يُسَلْ أجْدا",84,"د",2,0],["مُظفَّرَ الدينِ والنِّداءُ لذي","نُبْلٍ كريمِ البَنانِ والحَسَبِ",85,"ب",1,1],["مُظَفَّرُ دينِ اللّهِ والعَلَمُ الذي","بهِ يُقْتَدى في نَجْدَةٍ وتكَرُّمِ",86,"م",1,0],["مظلومُ بينٍ لا يُرجَّن عدلُهُ","وأسير حبٍ لا يُفَكُّ إِساره",87,"ر",2,0],["مظهرٌ بالمديح أن كان مجاناً","تباريح عروة بن حزام",88,"م",1,0],["مظهر الإبتسام في كل حين","ليتني كنت منشأ الابتسام",89,"م",1,0],["مظاهر أسرار الحروف وقد غدت","مرائي لما أبداه سر الرباعية",90,"ي",2,0],["مظهر السر الإلهي الذي","لم يقم في عالم الملك مثاله",91,"ل",2,0],["مَظاهرٌ بِحُكمها بارِزَةٌ","تَجْلو من السِّرِّ الخَفِيِّ طَرَفَا",92,"ف",2,0],["مَظاهِرٌ أيَّدَها مَفاخِرٌ","ببيْتِنا كَثيرةٌ مُجتمِعَهْ",93,"ع",2,0],["مظاهِرُ الحَضَراتِ انْجابَ حُنْدُسُها","بشمسِ قدسِكَ عنها فهي بلْجاءُ",94,"ا",2,0],["مظفر تظفر طلابه","بالشرف الأقصى من المطلب",95,"ب",1,0],["مُظهِرٌ سوءَ فِعلهِ","ملعَّنٌ لا يُسايرُ",96,"ر",1,0],["مُظلماتٍ مِن بعدِ أَن أوقدت في","ها اللّيالي نوراً يلوح ونارا",97,"ر",2,0],["مُظَفَّرونَ تُصيبُ الحَربُ أَنفُسَهُم","إِذا الفِرارُ تَمَطّى بِالمَحاييدِ",98,"د",1,0],["مِظلَّةٌ فوقَها قامتْ تُظلِّلُها","راياتُ أجنحةِ الأملاكِ كالخِيَمِ",99,"م",1,0],["مُظَفَّرٌ نائبٌ في أرضِ واقِفِهِ","مُبارِزٌ غالِبٌ دُنياهُ بالظَّفَرِ",100,"ر",1,0],["مظلومةُ الفمِ من خمرٍ ومن بَرَدِ","مخلوقةُ الخُلْقِ من غدرٍ ومن مَلَل",101,"ل",1,0],["مظفَّرُ الرأي مدلول بفطنته","على الإصابة يقظان وإن هجد",102,"د",1,0],["مظفَّرُ النَّصرِ منعوتٌ بهمته","إلى العزائِم مدلولٌ على الغلَبِ",103,"ب",1,0]]}