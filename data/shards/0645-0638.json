{"poems":[[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[93,"يا أمتي تنكري نصح امريء","https://www.aldiwan.net/poem11288.html","الكامل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[72,"أهلا بطيف على الجرعاء مختلس","https://www.aldiwan.net/poem19016.html","البسيط"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[51,"يا غصنا من لؤلؤ رطب","https://www.aldiwan.net/poem8331.html","السريع"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[85,"مرحبا بالفتى العظيم الشان","https://www.aldiwan.net/poem7532.html","الخفيف"],[43,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[62,"ورافل في صوان الحسن مشتمل","https://www.aldiwan.net/poem52300.html","البسيط"],[62,"نيلوفر يسبح في لجة","https://www.aldiwan.net/poem52376.html","السريع"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[45,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[45,"نسعى وأيسر هذا السعي يكفينا","https://www.aldiwan.net/poem66668.html","البسيط"],[45,"عند ظباء الرمل أو عينه","https://www.aldiwan.net/poem66816.html","السريع"],[61,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[69,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[102,"كم قائل لو كنت تلقاها","https://www.aldiwan.net/poem33025.html","السريع"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[50,"إن عمرا فاعرفوه","https://www.aldiwan.net/poem63981.html","مجزوء الرمل"],[76,"مظلومة باللحظ وجنتها","https://www.aldiwan.net/poem38882.html","أحذ الكامل"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/70278","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"]],"verses":[["مَظْهَرُ الوَحْي مَطْلَعُ الحَقّ معْنَى","الخَلْقِ فتْحُ المُهَيْمِنِ الفتّاح",0,"ح",1,0],["مِظَنَّةُ آثامٍ وَأُمُّ كَبائِرٍ","يُقَصِّرُ عَن أَدنى مَعايِبِها العَدُّ",1,"د",1,0],["مَظْلومَةٌ فِيهَا فَإِنْ لَمْ تُقْلِهَا","مِنْ عِزَّةٍ كَيْفَ القِلَى لِلظَّالِمِ",2,"م",1,0],["مظاهر أقمار مراتبُ أنجم","منازلُ بالنصر العزيز أواهلُ",3,"ل",1,0],["مظفر الجدّ مشاء على جدد","من حلمه اللدن أو من حربه الشرس",4,"س",1,0],["مظفر الجدّ من حظٍّ ومن نسبٍ","مبصرٌ بخفيّ الرشد مِدْراك",5,"ك",1,0],["مظلومَ ما أنت بمظلومةٍ","في حُكمِ أهلِ الشرق والغَربْ",6,"ب",1,0],["مظلومَ قد أنهبتِ أرواحنا","وكلُّنا راضونَ بالنَّهبِ",6,"ب",1,0],["مظفَّرٌ بالتي يحاولها","لا يُعدِم الله سالماً ظَفره",7,"ر",2,0],["مظفّراً هز عطفيها مظفَّرةً","إذا تلقت صدوراً صرن أكتافا",8,"ف",2,0],["مظلومةٌ ظلّامةٌ أبداً","مُنيَتْ بِمُتَّهِم بِمُتَّهَمِ",9,"م",1,0],["مُظاهِرُ سِربَالي حَديدٌ عَلَيهِما","عَقيلاً سُيوفٍ مِخذَمٌ وَرُسوبُ",10,"ب",1,0],["مظهر الشمس في الوجود علوا","ونشاط الأفلاك في الدوران",11,"ن",1,0],["مَظلومَةُ القَدِّ في تَشبيهِهِ غُصُناً","مَظلومَةُ الريقِ في تَشبيهِهِ ضَرَبا",12,"ب",2,0],["مظاهرٌ بين أثوابِ الجمال وقد","أغناهُ ذلك عن حَلْيٍ وعن حُلَلِ",13,"ل",1,0],["مُظاهِرٌ ثوبَ حِدادٍ على","ثوب بياضٍ عُلَّ بالوَرْسِ",14,"س",1,0],["مُظَفَّرٌ ما تَكادُ تَسري مِنَ الآ","فاقِ إِلّا بِمُفرِحٍ بُرُدُه",15,"د",2,0],["مَظِنَّةُ خَمّارينَ تُمسي لَئيمَةً","أُقَيوامُهُ في أَهلِها وَأَراهِطُه",16,"ط",2,0],["مُظَفَّرٌ لَم نَزَل نَلقى بِطَلعَتِهِ","كَواكِبَ السَعدِ وَالطَيرِ المَيامينا",17,"ن",2,0],["مُظَفَّرٍ في الحَربِ ما سِرُّها","بِظاهِرٍ عَن حَظرِ تَحصينِهِ",18,"ن",2,0],["مظلومَةُ الحُسنِ إن شبَّهتُ طَلْعَتَها","صُبحاً يسالمُ في إشراقِه الظُّلَما",19,"م",2,0],["مُظَفَّرُ الغَزوِ لم تُحْرَمْ صَوارِمُه","ما أمَّلْته ولم تُخْفِقْ عَواسِلُه",20,"ل",2,0],["مظلومةُ القدِّ في تشبيهها غصنا","مظلومةُ الريقِ في تشبيهها ضَرَبَا",21,"ب",2,0],["مظلومةُ القدِّ في تشبيهها غصناً","مظلومةُ الريقِ إذ قلنا هي الضَرَبُ",22,"ب",1,0],["مظهرُ الحقِّ للنبوّةِ سبحا","نكَ ربّاً فرد الجلال قديرا",23,"ر",2,0],["مَظلومة سيقت إِلى ظالم","نغّص مغداها وَمَسراها",24,"ا",3,0],["مُظَفَّرٌ مَن قَد أَبانَ مَكرا","وَماتَ خَوفاً مِنهُما وَذُعرا",25,"ر",2,0],["مُظْهِرٍ شَجّةَ الْجَبِينِ عَلَى البُرْ","ءِ كما أَظهرَ الهلالَ البَرَاءُ",26,"ا",2,0],["مُظَلَّلُ مِحجَرِ العَينَي","نِ جَيبُ قَميصِهِ قِدَدُ",27,"د",1,0],["مُظلِمُ النِسبَةِ لايُع","رَفُ إِلّا بِالسِراجِ",28,"ج",1,0],["مظلومةٌ باللَّحظِ وَجْنتُها","وجفونُها جُبلتْ على الظُّلْمِ",29,"م",1,1],["مُظفَّرٌ لا تُردُّ عزْمتُهُ","ومَن يَردُّ الكتابَ عن أجلِهْ",30,"ل",2,0],["مُظْهِراً ما كنتُ أُخْفي من قَدِي","مِ حديثٍ صانهُ منّيَ طَي",31,"ي",1,0],["مظاهرُ ليس بِها ما يخيفُ","ولكنَّما خاف مَنْ يَظْلِمُ",32,"م",1,0],["مظهراً أني كنتُ أحمل نفساً","لم يكن للشكوك فيها خطورُ",33,"ر",1,0],["مَظلومَةٌ في جِوارِ الخَوفِ ظالِمَةٌ","وَالنَفسُ مُؤذِيَةٌ مَن راحَ يُؤذيها",34,"ي",3,0],["مَظْلُومَةُ لَيْسَ لَهَا مُنْصِفٌ","مَنْجُودَةٌ أَخْطَاتِ الْمُنْجِدَا",35,"د",2,0]]}