{"poems":[[85,"فمنهج النصرا","https://www.aldiwan.net/poem54206.html","مخلع البسيط"],[463,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2467","المنسرح"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20385","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62748","الوافر"]],"verses":[["يقوت هو حمرا","والعنق من بلّار",0,"ر",1,0],["يقوت شِعاثاً مقترين بفضلها","أطابت له أو جانبته المقَاوِتُ",1,"ت",1,0],["يَقوتُ شِبلَينِ عِندَ مُطرِقَةٍ","قَد ناهَزا لِلفِطامِ أَو فُطِما",2,"م",2,0],["يَقوتُ فيها لِحامَ القَومِ شيعَتَهُ","وَردَينِ قَد آزَرا حَصّاءَ مسغابا",3,"ب",2,0],["يقوتُهُمُ من الزادِ المهيّا","روائِح شمهِ فهمُ عِجافُ",4,"ف",1,0]]}