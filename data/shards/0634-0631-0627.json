دل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5219,"إلى أرض الإسراء","https://www.poetsgate.com/ViewPoem.aspx?id=194255",""],[5225,"مسير العاشقينا","https://www.poetsgate.com/ViewPoem.aspx?id=18633",""],[5277,"أخلّاءُ الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=185552",""],[5354,"همس القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=192159",""],[5358,"عسى ألا غيابَ","https://www.poetsgate.com/ViewPoem.aspx?id=27544",""],[5409,"شر الخصال صداقة مكذوبة","https://www.poetsgate.com/ViewPoem.aspx?id=155427",""],[5409,"ردوا إلى أريافكم ردوا","https://www.poetsgate.com/ViewPoem.aspx?id=155262",""],[5431,"لاأبعدَ الله من في حبهم صدقوا","https://www.poetsgate.com/ViewPoem.aspx?id=197622",""],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5493,". شرُّ البلية .","https://www.poetsgate.com/ViewPoem.aspx?id=197092",""],[5561,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=197276",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5660,"وَيحَ الأَماني إِذا كانَت مِنَ العَدَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=36845",""],[5688,"زدني من الحبر","https://www.poetsgate.com/ViewPoem.aspx?id=200692",""],[5784,"من لا خلاق","https://www.poetsgate.com/ViewPoem.aspx?id=202628",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5894,"شقيقة بدر لا جحود ولا غش","https://www.poetsgate.com/ViewPoem.aspx?id=131422",""],[5912,"جزيرة روحي","https://www.poetsgate.com/ViewPoem.aspx?id=205005",""],[5953,"إلى سفينة نوح منتهى طلبي","https://www.poetsgate.com/ViewPoem.aspx?id=93859",""],[5956,"ما دامت الأكوان لا تهتم بي","https://www.poetsgate.com/ViewPoem.aspx?id=183925",""],[5956,"الترشيد والإحسان هما الطريق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=184316",""],[5956,"الجانبان","https://www.poetsgate.com/ViewPoem.aspx?id=193911",""],[5956,"حربُ تَشرين التحريرية","https://www.poetsgate.com/ViewPoem.aspx?id=194123",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[5997,"آن الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=214295",""],[6093,"في حَضْرةِ الشَّايِ","https://www.poetsgate.com/ViewPoem.aspx?id=205625",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""],[6115,"الايالله طلبنا الواحد العالي عظيم الجاه","https://www.poetsgate.com/ViewPoem.aspx?id=181362",""],[6152,"ذكرتكِ في الهدا","https://www.poetsgate.com/ViewPoem.aspx?id=203177",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[6213,"الجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76303&r=&rc=51",""],[6228,"باع الثمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85974&r=&rc=11",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""],[581,"أَطردتني حذر الهجاء ولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69748&r=&rc=35",""],[6363,"السلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86617&r=&rc=11",""]],"verses":[["شَراءُ المَوتِ لِلعِزِّ","بِبَيعِ الضَيمِ لا يَغلو",0,"ل",2,0],["شَرُّ اللِباسِ لِباسٌ لا نُزوعَ لَهُ","وَالقَبرُ مَنزِلُ جارٍ غَيرَ مُنتَقِلِ",1,"ل",1,0],["شَرابَينِ لا مَقتٌ مِنَ اللَهِ فيهِما","عَليَّ وَلا وَقعٌ مِنَ السَوطِ تَشقيقُ",2,"ق",1,0],["شَراباً حَلالاً يَتركُ المَرءَ صاحياً","وَلا يَتَولّى يَقلِصُ الخَمرَ وَالقارا",3,"ر",2,0],["شَرُّ القُيونِ حَديثاً عِندَ رَبَّتِهِ","قَينا قُفَيرَةَ مَسروحٌ وَزَعّابُ",4,"ب",1,0],["شَرُّ الخَليقَةِ مَن عَلِمنا مِنكُمُ","حَوضُ الحِمارِ وَشَرُّ مَن لَم يُخلَقِ",5,"ق",1,0],["شَراهُ زُهَيرُ بنُ الأَغَرِّ وَجامِعٌ","وَكانا قَديماً يَركَبانِ المَحارِما",6,"م",2,0],["شراب دار مديحِي","وافاكَ يخدمُ بابا",7,"ب",2,0],["شرابان حلّا طائعين كلاهما","ولم يأتيا كرهاً بعصر ولا حفر",8,"ر",1,0],["شراب وبستان وقطر سحابة","إذا قطرت أنواؤها ليس تخلف",9,"ف",1,0],["شَرَّ الشَرابِ الخَمرُ يُصبِحُ صَبُّها","قَيدَ الضَنى وَيَبيتُ رَهنَ خِبالِ",10,"ل",1,0],["شرُّ الذُّنوبِ لديكم أن يُقالَ لكم","كُفُّوا الأذى ودعوا التَّضليلَ والكَذِبا",11,"ب",2,0],["شر المصائب ما يجيء مفاجئا","كالسيل يطغى في الصباح فيجرف",12,"ف",1,0],["شراعك في الفِنيقيين جلَّى","وذكرك في الصليبين شاعا",13,"ع",2,0],["شر البلية أن يكون زعيما","من لا يسالم في الرجال كريما",14,"م",2,1],["شَرُّ الحُكومَةِ أَن يُساسَ بِواحِدٍ","في المُلكِ أَقوامٌ عِدادُ رِمالِهِ",15,"ل",2,0],["شِراكُها كورُها وَمِشفَرُها","زِمامُها وَالشُسوعُ مِقوَدُها",16,"د",3,0],["شَرُّ البِلادِ مَكانٌ لا صَديقَ بِهِ","وَشَرُّ ما يَكسِبُ الإِنسانُ ما يَصِمُ",17,"م",1,0],["شَرابُهُ النَشحُ لا لِلرِيِّ يَطلُبُهُ","وَطَعمُهُ لِقَوامِ الجِسمِ لا السِمَنِ",18,"ن",1,0],["شَرابٌ يُفضُّ الطين ُعنه إذا بدا","ثلاثةَ أيامٍ وقد شَبَّ لا شبَّا",19,"ب",2,0],["شَرُّ أَيّامي هُوَ اليَومُ الَّذي","أَقبَلُ الدُنيا بِديني عِوَضا",20,"ض",2,0],["شَرُّ الأَوائِلِ وَالأَواخِرِ ذِمَّةٌ","لَم تُصطَنَع وَصَنيعَةٌ لَم تُشكَرِ",21,"ر",1,0],["شَراباً عُظمُهُ لِلشَربِ شِربٌ","وَسائِرُهُ اِرتِفاقٌ لِلرِفاقِ",22,"ق",1,0],["شَرَابُنَا صَفْوُ مَاءٍ لا يُمَازِجُهُ","إِلَّا حَدِيثٌ كَنُوَّارِ الرُّبَى نَزِهُ",23,"ه",1,0],["شَرابُ الأَماني لَو عَلِمتَ سَرابُ","وَعُتبى اللَيالي لَو فَهِمتَ عِتابُ",24,"ب",1,1],["شراب الموت ماذا ذقت منه","وكيف يكون إن رفع الحجاب",25,"ب",1,0],["شرُّ القُضاةِ سَجِيّةً وأضَرُّهم","قاضٍ يرى الإنصافَ غَيْرَ حلالِ",26,"ل",1,0],["شَرُّ الخلائِقِ مَن يَسوسُ فلا يَرى","أنّ السياسةَ حِكْمةٌ وسَدادُ",27,"د",1,0],["شرُّ البليَّةِ من يَبيعُ بلادَه","منها إذا جدَّ البلاءُ بمقعدِ",28,"د",1,0],["شرُّ السياسةِ أن تَسودَ بَنِي الدُّنَى","غَصْباً وتلتهمَ الدُّنَى اسْتعمارا",29,"ر",2,0],["شرُّ الجُنودِ غداةَ الحربِ مُنْقَلَباً","مَن كان يزعُمُ أن الحقَّ يَنهزِمُ",30,"م",1,0],["شرُّ الشُّعوبِ من الحياةِ مكانةً","شعبٌ بأيدي الجاهلين يُساقُ",31,"ق",1,0],["شرائعُ للحضارةِ نَزدريها","وإن فُتِنَ الغُواةُ بها فُتونا",32,"ن",2,0],["شرُّ العجائبِ في زَمانِكَ أن ترى","شَعْباً يُباعُ على يدِ الدَلّالِ",33,"ل",1,0],["شرُّ الجرائرِ أن يَخُطَّ أثيمُها","حُمرَ الصحائفِ من دم المقتولِ",34,"ل",1,0],["شَرُّ الجَرائِرِ وَالمَساوي عِندَكُم","شَمَمُ الأَبِيِّ وَنَخوَةُ الغَيرانِ",35,"ن",1,0],["شَرُّ الجُناةِ وَأَدنى الناسِ مَنزِلَةً","مَن خانَ أُمَّتَهُ أَو راحَ يُؤذيها",36,"ي",3,0],["شرائعُ الخيرِ يُلقيها مُحبّبةً","شيخُ النَّبيِّينَ يَبغي البِرَّ واللَّطَفَا",37,"ف",2,0],["شَراباً إِن تُزاوِجهُ بِماءٍ","تَوَلَّدَ مِنهُما دُرَرٌ كِبارُ",38,"ر",1,0],["شَرُّ الحَياةِ بَسيطَةٌ مَذمومَةٌ","عَمَدَت لَها بِالسوءِ كَفُّ الغالِثِ",39,"ث",1,0],["شَرابُكَ بِئسَ الشَيءُ سَرَّ وَإِنَّما","أَفادَ سُروراً باطِلاً حينَ أَسكَرا",40,"ر",2,0],["شَرُّ أَشجارٍ عَلِمتُ بِها","شَجَراتٌ أَثمَرَت ناسا",41,"س",2,1],["شَرُّ الزَمانِ زَمانُ أَشيَبَ دالِفٍ","وَصِباهُ أَنفَسُ وَقتِهِ وَأَجَلُّهُ",42,"ل",2,0],["شَرُّ النِساءِ مُشاعاتٌ غَدَونَ سُدىً","كَالأَرضِ يَحمِلنَ أَولاداً مُشاعينا",43,"ن",2,0],["شَراحِيلُ إِذ لا يَمنَعُونَ نِساءهُم","وَأَفناهُمُ خدّاً فَخَدّاً تَنَقُّلا",44,"ل",2,0],["شرّ البلاد بلادٌ لا صديق بها","وشرّ ما يكسب الإنسان ما يصم",45,"م",1,0],["شرائعُ الناس بهذا الوجودْ","أعجزُ من أنْ تقهرَ العاطفهْ",46,"ه",1,0],["شراعنا الخفَّاق لن يَسكُنا","لليأس مهما مزَّقتهُ الرياحْ",46,"ح",1,0],["شَرُّ الْعِيَالِ عَلَيْهِمُ وَأَعَقُّهُمْ","لَهُمُ وَيَزَعُمُهمْ عَلَيْهِ عِيَالاَ",47,"ل",2,0],["شرَاهُمْ بِآلامٍ تَحَمَّلَ ضيْمَهَا","وَمَا السَّيِّدُ المَعْبودُ إِلاَّ الَّذي يَشْرِي",48,"ر",2,0],["شرُّ الأَنامِ البَاسِمو","ن وفِي جَوَانِحِهِمْ لَهِيبُ",49,"ب",1,0],["شراعي الموعد الخطر","وبحري الجمر والشرر",50,"ر",1,0],["شَرُّ المُحِبّينَ مَعشَرٌ قَد","أَزمَعَ أَحبابُهُم فَعاشوا",51,"ش",3,0],["شر الورى: عَقِبٌ، أطغاهمو لقبٌ","إذا سألتهمو، قالوا: ورِثناه!",52,"ا",2,0],["شر الغرور سكون ذي بصر الى","عيش تمزقه يد الأخطار",53,"ر",1,0],["شراة سراة لا يخط غبارهم","وإن أبلحت فوق الأمور أمور",54,"ر",1,0],["شر السياسية أن تسود بني الدنى","غصبا وتلتهم الدنى استعمارا",55,"ر",2,0],["شرابنا صفوُ ماءٍ ، لاَ يمازجهُ","إِلاَّ حَدِيثٌ كَنُوَّارِ الرُّبَا نَزِهُ",56,"ه",1,0],["شر الاحبة صاحب الاغراض","والمكثر التعنيف والاعراض",57,"ض",1,1],["شَرَابُه غَنفَرٌِّ","أوأسوَدُ النَّمَلِيَّه",58,"ي",2,0],["شَراني بِبَخسٍ وَهُوَ في الحُسنِ يُوسُفٌ","وَما بِاعَني إِلّا بِأَرخَصِ ما اِشتَرى",59,"ر",2,0],["شرائطُ المجد كلٌّ فيه قد جُمِعتْ","جمعَ حروِف التهجِّى في أبي جادِ",60,"د",1,0],["شرابها من حليبٍ ما يخالطه","ماء وليس حليب النوق كالبقر",61,"ر",1,0],["شر الورى بمساوى الناس مشتغل","مثل الذباب يراعي موضع العلل",62,"ل",1,0],["شَرُّ الأَخِلّاءِ مَن تَسري عَقارِبُهُ","لا خَيرَ في آدِمٍ يُطوى عَلى نَغلِ",63,"ل",1,0],["شراب المعلوات به سراب","ومنتجع الندى طلل محيل",64,"ل",1,0],["شرارة نيران العقول وانما","شرارة نيران العقول شرورُ",65,"ر",1,0],["شَرابِيَّةٌ سِلكُها كَالغُبارِ","تَرى عَينُ لابِسِها ما يَسُرُّ",66,"ر",1,0],["شَرابي دُموعي وَالدِّماءُ مِزاجُها","فَهُنِّئتَ كاساتِ اِبنَةِ الكَرمِ وَالكَرَم",67,"م",1,0],["شَرابُكَ في السَحابِ إِذا عَطِشنا","وَخُبزُكَ عِندَ مُنقَطِعِ التُرابِ",68,"ب",1,1],["شَرابُكَ في السَرابِ إِذا عَطِشنا","وَخُبزُكَ عِندَ مُنقَطِعِ التُرابِ",69,"ب",1,0],["شرابُهم سرابُ","وعذبُهم عذابُ",70,"ب",1,0],["شرائطها في الاربعين تجملت","فحافظ بها الاحوال من غير نقصان",71,"ن",1,0],["شَرائفٌ في اللّيالي رُصِّعَتْ عَجَباً","منها ذَوائبُ للظَّلْماء تُرْخيها",72,"ي",3,0],["شِراكُ نَعْلٍ له الهلالُ عُلاً","ما مِن سماء إلا يُوَطَّؤها",73,"ا",3,0],["شرُّ الخطية شيءٌ لا يُحَدُّ فإن","فرَّطتَ أفرطتَ يا ويل الذي فرَطا",74,"ط",2,0],["شر المذاهب مذهب القبائل","يقتل بري من غير ذنب غافل",75,"ل",1,1],["شرابها الخمر والكوثر مع السلسبيل","يارب يارب يا معطي العطا الجزيل",76,"ل",1,0],["شَرائفها زرق الأَسنة وَالقَنا","دَعائمها وَالطَعن وَالضَرب سورُها",77,"ر",3,0],["شرابُهم شرابٌ سُكَّريٌّ","وممّا يشتهون لحوم ضان",78,"ن",1,0],["شرائِعُ مُوجِباتٌ أَن تُدَانَا","بدائِعُ مانِعاتٌ أَنْ تُدانَى",79,"ن",2,0],["شَرَائِعُ كُنْتَ مُبْدِعَها وَكَانَا","عَلَى مسعاكَ فِيهَا دائِبَيْنِ",80,"ن",1,0],["شَرَّابُ أَنقُع أَجوازِ الفَلاةِ إذَا","مَا كَانَ شُرْبُ دمِ الأَعداءِ من صَدَدِهْ",81,"د",2,0],["شرائِعُ خَلَّدَها فِي الأَنَا","مِ من كُلِّ أَرْضٍ وَفِي كلِّ جيلِ",82,"ل",1,0],["شرابها الصل إن تظما وإن سغبت","فالقار تطعم لا القيصوم والسمقا",83,"ق",2,0],["شر الهدنات ما كانت على دخنٍ","فالحرب أهون من دخن الهدنات",84,"ت",1,0],["شرّ البليّة في الحروب أسيرُها","يُسلَى القتيلُ ويُعذَر المهزومُ",85,"م",1,0],["شرائط نعما كم وإحسان جودكم","ترى جذبكم ضَبْعي وحملَكُمُ ثقلي",86,"ل",2,0],["شرارة قلبٍ ليس يخفَى حريقُه","وزحمة عين ليس يطفو غريقُها",87,"ق",3,0],["شَرُّ الحِزاميِّينَ ذو السِنِّ مِنهُم","وَخَيرُ الحِزاميِّينَ يَعدِلُهُ الكَلبُ",88,"ب",1,1],["شرابك زائد الحاسين عقلا","ولم يك هكذا الشرب القديم",89,"م",1,0],["شر ألم فلم تملكك نكبته","على الإله فبشر منه ما دفعا",90,"ع",2,0],["شُرافَةُ الشَّوقِ لا زالت تَطولُ إلى","أنْ طاوَلتْ قُممَ الأفلاكِ ثمََّّ عَلتْ",91,"ت",1,1],["شر البحر للاحسان ولجود والندى","اليه فضولي ما يلا متعطشا",92,"ش",2,0],["شَرابُهُمُ إِذا ظَمِئُوا","حَميمٌ يورِثُ الطَحِلا",93,"ل",2,0],["شرُّ العقوبةِ يا سلمى على رجلٍ","عقوبةٌ من صروف الدّهر في الشَّعَرِ",94,"ر",1,0],["شراب طهور في كؤوس نظيفة","كريم به الساقي ومنه العطا الجم",95,"م",1,0],["شَرابُهُ العِلمُ في كُتْبٍ تُنادِمُهُ","سِرّاً فيطرَبُ لا بالعُودِ والهَزَجِ",96,"ج",1,0],["شَرُّ الجَهالةِ ما كانَتْ على كِبَرٍ","تُسَوِّدُ الشَيْبَ مِثْلَ الحِبْرِ على الوَرَقِ",97,"ق",1,0],["شَرابٌ لأهلِ الله يَروى بهِ الظَما","ويَرَوى بما يُرويهِ دانٍ وشاسِعُ",98,"ع",1,0],["شرابُهُمُ سُرورٌ وادِّكارُ","وشَدْوُهُمُ اخْتِيارٌ واقْتِرَاحُ",99,"ح",1,0],["شَرُّ المُلوكِ وَشَرُّها حَسَباً","في الناس مَن عَلِموا وَمَن جَهِلوا",100,"ل",3,0],["شَرائِطُهُ في الحُبِّ غَيْرُ وَفيَّةٍ","وَكَيْف تُوفى مِنْ حَبيبٍ شَرائِطُ",101,"ط",1,0],["شَرابٌ لذيذٌ خِلتُ يا صاح أَنَّهُ","رُضابُ الثَّنايا وَهوَ أحلَى مِنَ الشّهدِ",102,"د",1,0],["شَرابٌ يَبعثُ الأَشباحَ حَتّى","لَوَ انِّي مُقعَدٌ عُمرِي مَشَيتُ",103,"ت",1,0],["شَرابٌ يُنهِضُ الأَرواحَ حَت