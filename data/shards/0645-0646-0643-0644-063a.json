{"poems":[[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[55,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[95,"بلغت من عيشي أعز مرام","https://www.aldiwan.net/poem11394.html","الكامل"],[49,"ما زال معتلج الهموم بصدره","https://www.aldiwan.net/poem25274.html","الكامل"],[87,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[87,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[64,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[76,"وصقيل إفرند الشباب بطرفه","https://www.aldiwan.net/poem12854.html","الكامل"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[92,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[309,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[358,"تقارن النيران الشمس والقمر","https://www.aldiwan.net/poem40339.html","البسيط"],[358,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[376,"طال الزمان وما ثناه ولا انثنى","https://www.aldiwan.net/poem57023.html","الكامل"],[415,"عقائل الحي أم سرب المها سنحا","https://www.aldiwan.net/poem32604.html","البسيط"],[469,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[469,"ما بأراك الحمى إلى سلمه","https://www.aldiwan.net/poem3415.html","عموديه"],[482,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[556,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[589,"لله عينا من رأى","https://www.aldiwan.net/poem69382.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138307",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38961","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96463","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136338","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49932","البسيط"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124018","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108557","الكامل"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123780","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49549","البسيط"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17396","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100895","البسيط"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/132083","السريع"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74288","الكامل"],[3192,"","https://poetry.dctabudhabi.ae/diwan/poem/125327","الكامل"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89106","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117948","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117940","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36716","الكامل"],[3853,"","https://poetry.dctabudhabi.ae/diwan/poem/124002","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95371","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81703","البسيط"],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""]],"verses":[["مِن كُلِّ غَيداءَ قَد مالَ النَعيمُ بِها","كَما تَخايَلَ بِالبُردَينِ نَشوانُ",0,"ن",1,0],["مِن كُلِّ غادِيَةٍ سُلافَةُ بارِقٍ","وَمِنَ الرِياضِ رَطيبُها وَعَميمُها",1,"م",3,0],["مِنْ كُلِّ غَانِيَةٍ بَغَالِيَةِ الحِلَى","فِي النَّفْسِ عَمَّا يُقْتَنَى بِحُطَامِ",2,"م",1,0],["مِن كُلِّ غَدّارٍ يُقِرُّ بِذَنبِهِ","فَيَكونُ أَعظَمُ ذَنبِهِ في عُذرِهِ",3,"ر",2,0],["من كل غازٍ صحابىٍّ له ثقة","بالله لا تفصم البلوى اواخيها",4,"ي",3,0],["مِن كُلِّ غاوٍ في طَوِيَّةِ راشِدٍ","عاصي الظَواهِرِ في سَريرَةِ طَيِّعِ",5,"ع",1,0],["من كل غائرة المشَقِّ تخالُها","شِدقاً تثاءبَ أو ملاحِظَ أنجلا",6,"ل",2,0],["مِن كُلِّ غِربيبِ الأَديمِ لَوَ اِنَّهُ","قَبلَ النَعيبِ لَعيفَ مِنهُ غُرابُ",7,"ب",1,0],["مِن كُلِّ غَيثٍ لِلسَماحَةِ واكِفٍ","يَهمي وَقِرنٍ في الوَغى هَدّارِ",8,"ر",1,0],["من كلِّ غازٍ شامخٍ في صدره","زاهي الوسامِ ، مدِّوخِ الأمصار",9,"ر",1,0],["مِنْ كُلِّ غَادٍ عَلَى يُمنَاه مُستَلِماً","وَكُلّ صَادٍ إلَى نُعْمَاهُ مُلْتَمسا",10,"س",2,0],["من كل غانية بالحسن قاصرة","هيفاء خد لجة مواجة الكفل",11,"ل",1,0],["مِن كُلّ غالية تَزهو بِغاليةٍ","فَيرخص الغاليان المال وَالعمرُ",12,"ر",1,0],["مِن كُلِّ غَوثٍ في الملمّة مَلجأ","أَو كُلِّ غَيثٍ حَيث عُدّ سَماحُ",13,"ح",1,0],["من كلِّ غُصنٍ تَجتَني ثَمراتُهُ","ثمَرَ القُلوبِ وما أراها تُجتَنَى",14,"ن",2,0],["من كلِّ غيدَاءَ مِكسالٍ إذا انتبهَت","تنَفَّستْ عن نسيم الرَّوضِ إذْ نَفَحَا",15,"ح",2,0],["من كلّ غانيةٍ إذا استجليتها","سلبت فؤادك من يد الأحزان",16,"ن",1,0],["من كل غاد في ذمَّة اللحظ وسا","رٍ بليلٍ في ضوء مبتسمه",17,"م",2,0],["مِن كلَّ غانيةٍ بيضاءَ حاليةٍ","ممكورةٍ تَخِذَتْ مِن صونِها حُجُبا",18,"ب",2,0],["مِن كلّ غرثان الجنانِ من الش","شَنعاءِ ملآنٍ من الحزمِ",19,"م",1,0],["مِن كلّ غَرثانِ الشّوى من خنىً","مُستَمَعِ الأقوالِ في المحفِلِ",20,"ل",1,0],["من كل غيث في السنين","إذا الكواكب خاويه",21,"ي",2,0],["من كل غيداءٍ لنا من نورها","يوم وليل مشمس أو مقمر",22,"ر",1,0],["مِن كُلِّ غِرّيدٍ بِلَحنٍ مُنعشٍ","كَالنّاي صَوتاً في السّماعِ رَخيما",23,"م",2,0],["مِن كلِّ غَضٍّ نَضيرٍ لا نَظيرَ لَهُ","وَكلّ زاهٍ بَهِيٍّ فاخِرٍ نَضرِ",24,"ر",1,0],["مِن كُلِّ غَرَّاءِ الجَبِينِ كَأَنَّهَا","رَشَأٌ أَحَمُّ المُقلَتَينِ مُرَبَّبُ",25,"ب",1,0],["من كل غانية هيفا خدلجة","كانما قدها غصن من البان",26,"ن",1,0],["مِن كُلِ غَمرٍ باحث في ظلفه","عَن حَتفِهِ مُتَنمردٍ مُتَماد",27,"د",1,0],["من كلِّ غانيةٍ كحلآء راميةٍ","عن مُقْلتي رشأً في السِّرب مبهوتِ",28,"ت",1,0],["من كلّ غيداء ملء الدرع ما برزت","إلّا وزايل نفس المجتلى النكد",29,"د",1,0],["من كل غانيةٍ يجول وشاحها","وعلى معاصمها يغوص الدملج",30,"ج",1,0],["من كلّ غُصنٍ كالحسامِ مُجَوهَرٍ","يهتَزُّ عجباً ما عليه غُبارُ",31,"ر",1,0],["منْ كلِّ غاديةٍ ما باشرَتْ بلداً","إلا ترنَّحَ ضاحي تُرْبِهِ وشدا",32,"د",2,0],["من كلّ غصنٍ نضير مورقٍ خضَرٍ","وكل نورٍ نضيد مونق خضل",33,"ل",1,0],["مِن كُلِّ غَيداءَ في تَفريدِها صَحَلٌ","كأَنَّ أَعكانِها طَيُّ الصَواميرِ",34,"ر",1,0],["من كلّ غضبان كالرئبالِ معترِكاً","إِن صارعوه على أشبالهِ صَرَعا",35,"ع",2,0],["من كل غيداء عروب بضة","رعبوبة عيطاء ذات رونق",36,"ق",1,0],["من كل غطريف له نجدة","يدعو بمن يلقاه لا منجدا",37,"د",2,0],["مِن كُلِّ غطريف وَلَيث باسل","ينمى لحيدرة وَقرم قسور",38,"ر",1,0],["من كل غانية يكاد حجابها","ينشق مقدودا بسيف الحاجب",39,"ب",1,0],["مِن كُلِّ غِطرِيفٍ يُبَاشِرُ مِن","نارِ الحُرُوبِ مِن سُهاهَا اقتِدَاح",40,"ح",1,0],["من كل غمرٍ لو تبدّل جهلُه","علماً لأضحى عالم الأسرار",41,"ر",1,0],["من كل غُمر لم تَرضْه كريهةٌ","ومُعاودِ الغمراتِ غير مغمّرِ",42,"ر",1,0],["من كل غِرٍّ جاهلٍ مُتَعمِّقٍ","قلباً فما للكيدِ منهُ سِبارُ",43,"ر",1,0],["من كل غان كأن الليل طرته","والشمس غرته والسحر منطقه",44,"ق",2,0],["من كل غانية بلطف حديثها","ودلالها تذر الفؤاد مقطعا",45,"ع",2,0],["من كل غ انية تخال جبينها","بدراً تألق نوره أو كوكبا",46,"ب",2,0],["مِن كُلِّ غَيداء التَثَنّي ألبِسَت","أَعطافها بُرد الشَباب المُسدلِ",47,"ل",1,0],["من كل غيداء ملء الدرع خرعبة","كأنّ مسكاً على أنفاسها سحرا",48,"ر",2,0],["من كل غر في الوغا فاذا انجلت","عنه غيابتها فاي مجرب",49,"ب",1,0],["مِنْ كلِّ غرَّاءَ مبيّضٍ جوانِبُها","بالوَدْقِ مشرقةٌ منها الأَسارير",50,"ر",1,0],["من كل غانية زهت بجمالها","ودلالها كالروضة الغناء",51,"ا",2,0]]}