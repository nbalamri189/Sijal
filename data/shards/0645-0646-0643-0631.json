oetsgate.com/ViewPoem.aspx?id=198230",""],[5225,"السحابة","https://www.poetsgate.com/ViewPoem.aspx?id=30819",""],[5232,".. الشاعرة الحسناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=211254",""],[5273,"أضغاث معنى","https://www.poetsgate.com/ViewPoem.aspx?id=192312",""],[5431,"مفتاح باب الخلد أحجيتي","https://www.poetsgate.com/ViewPoem.aspx?id=199777",""],[5443,"درس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185153",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[3856,"وغَرِقنَا حِينَ طِرنَا؛ عِندَما","https://www.poetsgate.com/ViewPoem.aspx?id=215912",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[6093,"بئرٌ معطلةٌ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176094",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""]],"verses":[["مِن كُراتٍ وَطَرفُهُنَّ سُجُوٌّ","نَظَرَ الأُدمِ مِن ظِباءِ الخَريفِ",0,"ف",1,0],["مُنكَرِساً تَحتَ الغُصونِ كَما","أَحنى عَلى شِمالِهِ الصَيقَل",1,"ل",1,0],["مِن كُردُفانَ إِلى مِصرٍ إِلى جَبَلٍ","عَلَيهِ كَلَّمَهُ موسى بنُ عِمرانِ",2,"ن",1,0],["مُنكِرَاتٍ بأنفُسٍ عَارِفَاتٍ","بِعُيُونٍ هَوَامِلِ التَّسجَامِ",3,"م",1,0],["مِنْ كَرْمَةٍ تَهَبُ المكارمَ للفتى","فتراهُ بين شجاعةٍ وسَمَاحِ",4,"ح",1,0],["من كرم يستبي مُعاشِرَهُ","وعشرةٍ لا نذُمُّ مَخبرَها",5,"ر",3,0],["مَن كَرَمسيسَ في المُلوكِ حَديثاً","وَلِرَمسيسٍ المُلوكُ فِداءُ",6,"ا",2,0],["مًُنكَرَاتٍ لِلجَنِّ فيها عزيفٌ","كَإختِلاَطِ الضَّوضَاءِ بالضَّوضَاءِ",7,"ا",2,0],["مُنكِراً عُرفَهُ وَأَيُّ ثَناءٍ","بَينَ إِنكارِهِ وَبَينَ اِعتِرافي",8,"ف",2,0],["من كر مهلوكا تلقيته","بصارم ما هان من كرمه",9,"م",2,0],["منكر رقص عاقد الطيلسان","وجلوس القضاة بين المغاني",10,"ن",2,1],["مُنكَرَةٌ كلَّما طلبتُ ولَو","شاءَت لَكانَت بالحقِّ مُعتَرِفَه",11,"ه",1,0],["من كرام الناس والخلفا","فإليه الجود ينتسب",12,"ب",1,0],["منكراً من أرسُمٍ معرفة","لبست للبين حزناً واكتئابا",13,"ب",2,0],["من كرامٍ سادةٍ لم يُخلَقوا","بين أشراف الورى إلاَّ كراما",14,"م",2,0],["مِن كُرومٍ كَريمَةٍ وَمُحالٌ","أَن تَكونَ الكُرومِ إِلّا كَرمَه",15,"م",2,0],["مِن كَرْمِ إكرامٍ بِدَنِّ ديانةٍ","لا خمرة قد داسها الفلاح",16,"ح",1,0],["منكرة صرفا وفي علمية","بمعلوم علم اللَه في أزلية",17,"ه",1,0],["منكر وهو في التحقيق معرفة","له به عنه فيه وهو ذا عجب",18,"ب",1,0],["مُنكرة الإِحسان وَالمَعروفِ","مِثلك حَقّا بِالهَلاك كوفي",19,"ي",1,0],["من كره في الفخار صاع","وباعه في العلا فترُ",20,"ر",1,0],["من كرم لقمان إذ حياه بسر","قد أنقذ أيوب من تقطع أوصال",21,"ل",1,0],["مِن كُرومٍ تَمايَلَت بِعَناقي","دَ كَجَعدِ الزُنوجِ وَالحُبشانِ",22,"ن",1,0],["من كرَّس العمر المديد لأخذها","ولنشرها كنشيء الأجيال",23,"ل",1,0],["مَن كَرِهَ المَوت امتحن","مَن اِشتَرى الدون غبن",24,"ن",1,0],["من كَرِهَ الجَوابا","لَم يُكثر الخِطابا",25,"ب",2,0],["مُنكَرها مَعروف","نفارُها أُلوف",26,"ف",1,0],["من كَرمُتْ مَناقبُهْ","وكثُرتْ مواهبُهْ",27,"ه",1,0],["منكراً ذاته ولما يصعِّر","خده أو تَفُز به الخيلاءُ",28,"ا",2,0],["من كرامٍ قد استرقُّوا لباس ال","حمد والناس تسترقّ الحريرا",29,"ر",2,0],["منك رباعُ العُلى برغمي","خلت ورغم الحجى الأصيل",30,"ل",1,0],["من كريماتٍ على الله لها","ضرب العصمة خدراً وسجافا",31,"ف",2,0],["من كربِّ العُلا تفرّ‍َدَ حُكماً","لم يغب نور ذاته عن مكانِ",32,"ن",1,0],["من كربِّ العُلا يديرُ نظاماً","يشملُ الكونَ بين قاصٍ ودانِ",32,"ن",1,0],["مُنكَرٌ تَفزَعُ الكَواكِبُ في الظَل","ماءِ مِنهُ وَتَجزَعُ الظَلماءُ",33,"ا",2,0],["مِن كِرام رَتَقَت بَيضُهُمُ","فُرَجَ المَجدِ وَكانَت ثُغَرا",34,"ر",2,0],["مِن كِرام أَدَّبَ الدَّهرُ بِهِم","بَعدَ ما كانَ عَلى الأَحرارِ يَجني",35,"ن",2,0],["من كرام تنال منها العطايا","فَاليها او لا تشدن رحلا",36,"ل",2,0],["من كربلاء ومن أَرض الغريِّ غَدَت","تُزجَى الرَكايب حدواً مِن هُنا وَهُنا",37,"ن",2,0],["من كَرمَ دِيوَةٍ لجاوَه سُنِد","مايةُ زام مَع ثلاثينَ عُدِد",38,"د",1,0],["من كريمٍ له المكارم تنهى","عن كريمٍ به اقتدى الكرماء",39,"ا",2,0],["من كربّ الكون لا بل من سواه","عادل في الخلق برٌّ بالأمم",40,"م",1,0],["مِن كَرِيمٍ آباؤُهُ كُرَمَاءُ","نَسَبٌ طَاهِرٌ حَبَاهُ الإِلاَهُ",41,"ه",1,0],["من كرام عم شاماً ويمن","نيلهم فهو كأنواء السحب",42,"ب",1,0],["من كرام لم يقبضوا المالَ إلاّ","بَسطوه في طاعَة الرحمان",43,"ن",1,0],["من كرمة التكريم قدما كونت","فاشرب بها كأس الوصال مباحا",44,"ح",2,0],["مُنكَرٌ ما أقول سل عَبراتي","وتفهَّم إذا سألت بُكائي",45,"ا",3,0],["من كرامٍ سموا على الناس بالفض","وعزُّوا به عن الأنداد",46,"د",1,0],["من كرام وهب المجد لهم","من معاليه الذي قد رجحا",47,"ح",2,0],["من كرام قد زكت أحسابهم","وتزكَّت في معالي الحسب",48,"ب",1,0],["من كرام بهم المجد سما","واغتنى الدهر بهم بعد العفا",49,"ف",2,0],["من كرامٍ أعراقهم قد تنقَّت","لم يدنِّس سوءٌ لهم أثوابا",50,"ب",2,0],["من كرامٍ سادوا بمجد وجودس","فيه أهلُ الثرى بقسم سواء",51,"ا",2,0],["من كرامٍ أضحى لهم كلُ شىءٍ","خاضعا والزمان أبدى خشوعا",52,"ع",2,0],["من كرامٍ منهم أبوه الذي لي","س له في سواهم أنداد",53,"د",1,0],["من كرامٍ عمَّ الوجود نداهم","فنداهم على الوجود مطير",54,"ر",1,0],["من كرام لم تلد أم العلى","مثلها في سرمد الدهر كراما",55,"م",2,0],["من كراماتك التي ليس للسُّ","يولِ منها توقُّفٌ وانتهاء",56,"ا",2,0],["من كريمٍ يملك قلوب ورقاب","كلّ صوت يصبح لصوته صدى",57,"د",2,0],["من كرمةِ الرُّوحِ عَنقودانِ ما اعْتُصرا","والكأسُ ينتظرُ العنقودَ معصورا",58,"ر",2,0],["من كرمَةِ الأحلامِ يَعصُرُ خمرَةً","ويَعُبُّ مِلءَ شُجونِهِ كي يَسكَرا",59,"ر",2,0],["من كرْمه الريان أكؤسنا","للأحمر الرمان أغنيتي",60,"ت",2,0],["مَنْ كرسولِ الله محِبٌّ","هو حقاً قائدُهُ الأولْ",61,"ل",1,0],["منكره ثم النكير بصحة","هما يسألان العبد في القبر مقعدا",62,"د",2,0],["مُنكِرٌ في كُلِّ جِسمٍ صِحةً","أو فؤادًا عاقِلًا، أو مَبسَما",63,"م",2,0],["من كرمة التيه قد صغنا حكاياتنا","كؤوس بوح مدى الأيام تسقينا",64,"ن",2,0],["من كرِّ مكْرِ الغانيات بصخرها","فاسلمْ بنفسك أيُّها الإنسانُ !",65,"ن",1,0],["مِن كَريم آباؤُهُ كرماء","بِالكَمالات ربه أولاه",66,"ه",1,0],["منْكَرٌ في موطِني البالي نَما","ونكيرٌ غاصَ في عُمْقِ القلم ْ",67,"م",1,0]]}