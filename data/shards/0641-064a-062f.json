 صنعاء أمرا","https://www.aldiwan.net/poem44520.html","مجزوء الوافر"],[366,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[366,"روحات وصلتها بابتكار","https://www.aldiwan.net/poem17775.html","الخفيف"],[380,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[380,"أسلموني لسهادي","https://www.aldiwan.net/poem48796.html","مجزوء الرمل"],[403,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[405,"بين من يعطي ومن يأخذ","https://www.aldiwan.net/poem49888.html","مجزوء الرمل"],[409,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[432,"كوكب لاح بين بدر وشمس","https://www.aldiwan.net/poem12312.html","الخفيف"],[432,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[439,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[439,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[458,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[458,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[458,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[458,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[458,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[461,"أثني عليه حسنا وجهه","https://www.aldiwan.net/poem15683.html","السريع"],[461,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[477,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[479,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[500,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[504,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[505,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[505,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[515,"قد أتتني تلك اليد البيضاء","https://www.aldiwan.net/poem12004.html","الخفيف"],[558,"ربما يكذب حسادي علي","https://www.aldiwan.net/poem33569.html","الرمل"],[558,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[561,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[562,"في دار مولاي عبد القادر انتظمت","https://www.aldiwan.net/poem52710.html","البسيط"]],"verses":[["في دَولَةٍ تُرْخي ذَوائِبها على","عِزٍّ يُلاذُ بظِلِّهِ المَمْدودِ",0,"د",1,0],["فِي دَارِ قَحْطٍ وَقَفْرٍ ثُمَّ بَيْنَ عِدىً","ذَوِي شُرُورٍ وَأَهْوَاءٍ وَأَهْوَالِ",1,"ل",1,0],["في دِنشِوايَ وَأَنتَ عَنّا غائِبٌ","لَعِبَ القَضاءُ بِنا وَعَزَّ المَهرَبُ",2,"ب",1,0],["في دورِهِنَّ شُؤونُهُنَّ كَثيرَةٌ","كَشُؤونِ رَبِّ السَيفِ وَالمِزراقِ",3,"ق",1,0],["في دَولَةِ الملكِ المُعَظَّمِ خَمسَةٌ","لا يُؤمَنونَ عَلى قُشورِ الطُحلُبِ",4,"ب",1,1],["في دَولَةٍ تَبقى بَقا","ءَ الدَهرِ آمِنَةَ الفَناءِ",5,"ا",2,0],["فَيُدرِكُنا فَغَمٌ داجِنٌ","سَميعٌ بَصيرٌ طَلوبٌ نَكِر",6,"ر",1,0],["فَيُدرِكُ ثَأراً ثُمَّ لَم يُخطِهِ الغِنى","فَمِثلُ أَخي يَوماً بِهِ العَينُ قَرَّتِ",7,"ت",1,0],["فِي دَوْحَةِ الصَّيْدْنَاوِيِّ الَّتِي بَسَقَتْ","إلى العَنَانِ هُمَا فِي النُّبْلِ صِنْوَانِ",8,"ن",1,0],["فِي دَوْحَةِ الصِّيدَنَاوِيِّ الَّتِي بَسَقَتْ","إِلَى العَنَانِ هُمَا فِي النِّيلِ صِنْوَانِ",9,"ن",1,0],["فَيَدعو بِبُعدٍ وَسُحقٍ لَهُم","وَيُسحَبُ فيهِم لِذاتِ الضَرَم",10,"م",1,0],["في دُرَّةِ الأَصدافِ مُع","تَنِفاً بها رَدعُ الخَلُوق",11,"ق",1,0],["في دار مولانا النقيب","بوجه مولانا الأمير",12,"ر",1,0],["فَيَدعونا الفُؤادُ إِلى هَواها","وَيَكرَهُ أَهلُ جَهمَةَ أَن تُزارا",13,"ر",2,0],["في داره حين يغدو من وضائعه","مال تنافسه الغربان والرَخَمُ",14,"م",1,1],["في دَعةِ الله وفي حفظه","مسراك والعود بعزمٍ نجيح",15,"ح",1,0],["في دَعة الله سرْ وعدْ في","بشارة تجتلي بشاره",16,"ر",2,1],["في دَعَة الله سرْ سعيداً","ممدّح الحلق والخلائق",17,"ق",1,1],["فيدركُ ثأرَ الله أنصارُ دينه","ولله أوْسٌ آخرون وخزْرجُ",18,"ج",1,0],["في دولتي أنا مغصوبٌ وفي زمني","عوديَ ظمئَى بلا ريٍّ ولا بللِ",19,"ل",1,0],["فيدٌ كصفحةِ سَيْفِه","ويدٌ كشفرتِهِ الحذوم",20,"م",1,0],["في دَنَّها هِيَ راحٌ","وَفي الحَشا هِيَ روحُ",21,"ح",1,0],["فيدٌ على عين له ذرافة","ويد على قلب له مصدوع",22,"ع",1,0],["فيد على عين له ذرافةذ","ويد على قلب له مصدوع",23,"ع",1,0],["في دار أمجد سمح","مهذب مفضال",24,"ل",1,0],["في دِيارٍ مِنَ الخَلائِفِ دَرسٍ","وَمَنارٍ مِنَ الطَوائِفِ طَمسِ",25,"س",1,0],["فَيُداري لِيَعصِمَ الغَدَ مِنهُم","وَالمُداراةُ حِكمَةٌ وَدَهاءُ",26,"ا",2,0],["فَيَدٌ مُسَلِّمَةٌ وَطَرفٌ شاخِصٌ","وَحَشىً يَذوبُ وَمَدمَعٌ مَسفوحُ",27,"ح",1,0],["فَيَدُ الهَوى تَهوي بِروحي في الضَنى","وَيَدُ النَوى تَنأى بِضَرِّ جَناني",28,"ن",2,0],["فَيَدُ الجَنوبِ تَلُفُّها","لفَّ الجَحافلِ بالجحافِل",29,"ل",1,0],["فَيَداكَ في عُنقِ الزَمانِ غَلائِلٌ","وَنَداكَ في جيدِ الأَنامِ قَلائِدُ",30,"د",1,0],["في دولةٍ في مقرِّ العزِّ ثابتةٍ","تُمْلي العلى من سجاياهُ على الدوَلِ",31,"ل",1,0],["في دَهرِيَ الأَوَّلِ المَذمومِ أَعرِفُهُم","فَالآنَ أُنكِرُهُم في دَهرِيَ الثاني",32,"ي",1,0],["في دَولَةٍ بَيضاءَ هارونِيَّةٍ","مُتَكَنِّفاها النَصرُ وَالتَمكينُ",33,"ن",1,0],["في دَولَةٍ لَحَظَ الزَمانُ شُعاعَها","فَاِرتَدَّ مُنقَلِباً بِعَينَي أَرمَدِ",34,"د",1,0],["في دَوحَةٍ عاجَ خَيرُ المُرسَلينَ بِها","مِن قَبل بعثَتِهِ لِلعُربِ وَالعَجَمِ",35,"م",1,0],["في ديرِ بيرةِ دادخينِ حُورٌ","في الباعِ عنْ سلوانِهنَّ قصورُ",36,"ر",1,1],["في دولةٍ للمسلمين تشوقُهم","أيّامُها وتهَزُّهم ذِكراها",37,"ا",3,0],["في ديارٍ لدى النجاشيِّ غُبْرٍ","ظلَّ فيها سَوادُهم مغمورا",38,"ر",2,0],["في دُجى لَيلِنا وَطَيِّ الحَواشي","مُدنَفُ الريحِ في قَصيرِ النَقاءِ",39,"ا",2,0],["في دَولَةٍ لِلَهِ عالِيَةِ الذُرى","دُعِمَت بِآياتِ الكِتابِ المُحكَمِ",40,"م",1,0],["في دَمي من تُراثه","نفحةُ البدوِ والحضَرْ",41,"ر",1,0],["في دولةٍ ممدودة الطِراف","مشدودة البُهْرة بالأطراف",42,"ف",1,0],["فِي دَوْلَةٍ بَلَغَتْ بِالْعَدْلِ مَنْزِلَةً","عَلْيَاءَ كَالشَّمْسِ فِي بُعْدٍ وَفِي نُورِ",43,"ر",1,0],["فِي دِفَّتَيْ سِفْرٍ تَضَمَّنَ مَا غَلاَ","مِنْ حِكْمَةِ الأَحْقَابِ وَالأَجْيَالِ",44,"ل",1,0],["فِي دُجَى المَعْضِلاَتِ رَأْيُكَ هَادٍ","وَأَوْلُو الأَمْرِ رَأْيُهُمْ فِيكَ عَالِ",45,"ل",1,0],["فِي دَارِ فَرْنَانِ مَهْرَجَانُ","جَاوَزَ فِي الحَقِّ كُلَّ حدْسِ",46,"س",1,0],["فِي دَارِ وَالدِهِ شَهِدْتُ نُمُوَّهُ","أَيَّامَ يَدْرُجُ نَاعِمَ الأَظْفَارِ",47,"ر",1,0],["فَي دَارِه هَذهِ تَجَلَّت","إِحْدَى مَبَرَّاتِهِ العَدَادِ",48,"د",1,0],["في دمع بسمتها وفي صلواتها","نُعْمَى تُطلُّ على العزاء وتشرق",49,"ق",1,0],["في دارِ إِسلامٍ وَسِلمٍ لِلعِدا","ضامَ النَصارى أَهلها وَمَجوسُ",50,"س",1,0],["في دمي من هواك حمّى البراك","ين العواتي وألف دنيا تزلزل",51,"ل",1,0],["في دولة الأدياك كا","ن من السُّعاةِ، أو الخدم",52,"م",1,0],["في دولتي أنا مغصوبٌ وفي زمني","عودي ظمِىء ٌ بلا ريٍّ ولا بللِ",53,"ل",1,0],["فيدرك الآثار والطرائدا","ويَنحل الأغلال والقلائدا",54,"د",2,0],["في دِيار الروم قَوم","مِنهُم يَبدو الضِياء",55,"ا",2,1],["في دفتر معدودة","فيه الكبائر والصغائر",56,"ر",1,0],["في دمعها ووسد الترابا","خدودها النواضر الراطابا",57,"ب",2,0],["فيُدخِلُني الحُبُّ خِدرَ الغَرام","فأبصِرُ في الخِدرِ حوريَّتي",58,"ي",1,0],["في دَولَةٍ بِكَ نالَت فَوقَ بُغيَتِها","في مَن عَصى فَعَصا أَعدائِها شُعَبُ",59,"ب",1,0],["في دَولَةٍ جَعَلَ اللَهُ الكَريمُ لَها","حَوادِثَ الدَهرِ أَنصاراً وَأَعوانا",60,"ن",2,0],["فَيُدني الَّذي يُدني وَيُقصى الَّذي يُقصي","صَلاحٌ بِهِ كانَ اسمُنا خَيرَ أُمَّةٍ",61,"ه",1,0],["في دولةِ الملكِ المنصور أنت فسر","في حيث ما شئت منها واسحب الذهبا",62,"ب",2,0],["في دولة المنصور كان اباده","لولا وقته حماية الرحمن",63,"ن",1,0],["في دارِ قَومٍ لَو رآهُم مالِكٌ","وَهُمُ بِأَحسَنِ مَنظَرٍ وَرُواءِ",64,"ا",2,0],["في دون ذا طب للبهلول موفقه","في السوق مفتضحا بالدلق والطلب",65,"ب",1,0],["في دِيارِ العَزيزِ مِن أَرضِ كَلبٍ","بَينَ أَحياءِ عامِرٍ وَجَنابِ",66,"ب",1,0],["في دلالٍ تجرُّ مثلَ الطواوي","سِ على عجبهنَّ فضلُ الإزارِ",67,"ر",1,0],["فيدخرونه قوتا وزاداً","الى يوم القيامة والتنادي",68,"د",2,0],["في دار ليلى يصنع الدهر صنعه","فيجرم لا رأيٌ لديه ولا عقلُ",69,"ل",1,0],["في دَمعَةِ التُعَساءِ سِرٌّ كامِنٌ","هُوَ خَلفَ لَيلِ الظالِمينَ صباحُ",70,"ح",1,0],["في دِمائِنا شَرَفٌ","في عُروقِنا حَسَبُ",71,"ب",1,0],["فيدخل والشعث الخماص كأنما","وجوههم شمس الضحى حين تطلع",72,"ع",1,0],["في دَولَةٍ لا يُذِلُّ الدَهرُ ناصِرَها","وَلا تَروعُ اللَيالي مَن يُواليها",73,"ي",3,0],["في دُهمَةٍ تَمَسُّهُ","كَالذَهَبِ المُحَرَّقِ",74,"ق",1,0],["في دير ياسين وفي أخواتها","ذبح اَلأهالي مثل سرج نعاج",75,"ج",1,0],["في دار من خبزه عليه","ألف رقيبٍ بألف عين",76,"ن",1,0],["في دياجي الحروف من كلماتكْ","لاح بدرُ المعنى لنا من هباتكْ",77,"ك",1,1],["في دولة لا تداني دلّها دول","مذلة كل صعب لا يقاد أبي",78,"ب",2,0],["فِي دَوْلَة أَتَّتْ وفَتَّتْ مِنْ جَنَى","مَعْرُوفها ما نَاسَبَ العِرْفانا",79,"ن",2,0],["فيدى لَكُم رَهنٌ بِيَومٍ مُفسِد","وَبِوَقعَةٍ فيها عِقابٌ صيلَمُ",80,"م",1,0],["في دَولَةٍ سُلطانُها","ما مِثلَهُ سُلطانُ",81,"ن",1,0],["في دارِهِ يُؤتى الحَكَم","وَبابُهُ بابُ الحَرَم",82,"م",1,0],["في دَولَةٍ سارَت بِأَجمَل سيرَةٍ","فينا فَما لِلعَدلِ عَنها مَعدِلُ",83,"ل",1,0],["في دَولَةِ العادِلِ المَلكِ المَهيبِ رَأَي","نا الذيبَ في القَفرِ لَم تَحفَل بِهِ الشاةُ",84,"ه",1,0],["فيد من مصطفى للندى","ويد من مصطفى للسنان",85,"ن",1,0],["في درئِهم عن قاتلٍ لأخيهِ عن","عمدٍ قصاصاً إِذ عَفا الأبوانِ",86,"ن",1,0],["فَيدُ العُلا وَفَقا إِلى ميلادِها","جَعَلَت كَواكِبُ سَعدِها دُرَّيَه",87,"ي",2,0],["في دمى من لحنك الماضي بقايا نغم","لم تزل تشدو بها روحي ويرويها فمي",88,"ي",1,1],["في دولةٍ غَرّاءَ عُرْوَتُها","بِيَدِ السُّعودِ فليس تَنْفَصِم",89,"م",1,0],["في دَولةٍ مَوْعودةٍ بدَوامها","مَحْسودةٍ أيّامُها بَينَ الدُّوَل",90,"ل",1,0],["في دَسْتِه قَمرٌ في دِرعهِ أَسد","في حَفْلِه مَلِكٌ في سرِّه مَلَك",91,"ك",1,0],["في دولةٍ مَحْسودةٍ عَلياؤها","ما شاقَ تَغْريدُ الحَمامِ الهُتَّف",92,"ف",1,0],["في دولةٍ غَضّةٍ طُولُ البقاء لها","ماإن يَزالُ على الأيّام مُشتَرَطا",93,"ط",2,0],["في دولةٍ غرّاءَ دائمةٍ","مادامَ صَومٌ مُعقِباً فِطرا",94,"ر",2,0],["في دولةٍ من صُروفِ الدَّهْرِ آمنةٍ","وعيشةٍ لا تَرَى عن وِرْدِها صَدَرا",95,"ر",2,0],["في دولةٍ تُصْمِي العِدا وسَعادةٍ","تُنْمي على الأزمانِ والآباد",96,"د",1,0],["فيُديرُ في أثنائهنَ كلامه","ك