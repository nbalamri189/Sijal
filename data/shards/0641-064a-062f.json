tps://www.aldiwan.net/poem7249.html","المجتث"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[61,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[44,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[44,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"في دير بيرة دادخين حور","https://www.aldiwan.net/poem28805.html","الكامل"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[52,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55135","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54979","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54743","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142070","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[106,"ديك غير وديك","https://www.poetsgate.com/ViewPoem.aspx?id=179736",""],[51,"لازلتَ تبلغُ أقصى السُؤْلِ والأملِ","https://www.poetsgate.com/ViewPoem.aspx?id=30336",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""]],"verses":[["في دَولَةٍ تُرْخي ذَوائِبها على","عِزٍّ يُلاذُ بظِلِّهِ المَمْدودِ",0,"د",1,0],["فِي دَارِ قَحْطٍ وَقَفْرٍ ثُمَّ بَيْنَ عِدىً","ذَوِي شُرُورٍ وَأَهْوَاءٍ وَأَهْوَالِ",1,"ل",1,0],["في دِنشِوايَ وَأَنتَ عَنّا غائِبٌ","لَعِبَ القَضاءُ بِنا وَعَزَّ المَهرَبُ",2,"ب",1,0],["في دورِهِنَّ شُؤونُهُنَّ كَثيرَةٌ","كَشُؤونِ رَبِّ السَيفِ وَالمِزراقِ",3,"ق",1,0],["في دَولَةِ الملكِ المُعَظَّمِ خَمسَةٌ","لا يُؤمَنونَ عَلى قُشورِ الطُحلُبِ",4,"ب",1,1],["في دَولَةٍ تَبقى بَقا","ءَ الدَهرِ آمِنَةَ الفَناءِ",5,"ا",2,0],["فَيُدرِكُنا فَغَمٌ داجِنٌ","سَميعٌ بَصيرٌ طَلوبٌ نَكِر",6,"ر",1,0],["فَيُدرِكُ ثَأراً ثُمَّ لَم يُخطِهِ الغِنى","فَمِثلُ أَخي يَوماً بِهِ العَينُ قَرَّتِ",7,"ت",1,0],["فِي دَوْحَةِ الصَّيْدْنَاوِيِّ الَّتِي بَسَقَتْ","إلى العَنَانِ هُمَا فِي النُّبْلِ صِنْوَانِ",8,"ن",1,0],["فِي دَوْحَةِ الصِّيدَنَاوِيِّ الَّتِي بَسَقَتْ","إِلَى العَنَانِ هُمَا فِي النِّيلِ صِنْوَانِ",9,"ن",1,0],["فَيَدعو بِبُعدٍ وَسُحقٍ لَهُم","وَيُسحَبُ فيهِم لِذاتِ الضَرَم",10,"م",1,0],["في دُرَّةِ الأَصدافِ مُع","تَنِفاً بها رَدعُ الخَلُوق",11,"ق",1,0],["في دار مولانا النقيب","بوجه مولانا الأمير",12,"ر",1,0],["فَيَدعونا الفُؤادُ إِلى هَواها","وَيَكرَهُ أَهلُ جَهمَةَ أَن تُزارا",13,"ر",2,0],["في داره حين يغدو من وضائعه","مال تنافسه الغربان والرَخَمُ",14,"م",1,1],["في دَعةِ الله وفي حفظه","مسراك والعود بعزمٍ نجيح",15,"ح",1,0],["في دَعة الله سرْ وعدْ في","بشارة تجتلي بشاره",16,"ر",2,1],["في دَعَة الله سرْ سعيداً","ممدّح الحلق والخلائق",17,"ق",1,1],["فيدركُ ثأرَ الله أنصارُ دينه","ولله أوْسٌ آخرون وخزْرجُ",18,"ج",1,0],["في دولتي أنا مغصوبٌ وفي زمني","عوديَ ظمئَى بلا ريٍّ ولا بللِ",19,"ل",1,0],["فيدٌ كصفحةِ سَيْفِه","ويدٌ كشفرتِهِ الحذوم",20,"م",1,0],["في دَنَّها هِيَ راحٌ","وَفي الحَشا هِيَ روحُ",21,"ح",1,0],["فيدٌ على عين له ذرافة","ويد على قلب له مصدوع",22,"ع",1,0],["فيد على عين له ذرافةذ","ويد على قلب له مصدوع",23,"ع",1,0],["في دار أمجد سمح","مهذب مفضال",24,"ل",1,0],["في دِيارٍ مِنَ الخَلائِفِ دَرسٍ","وَمَنارٍ مِنَ الطَوائِفِ طَمسِ",25,"س",1,0],["فَيُداري لِيَعصِمَ الغَدَ مِنهُم","وَالمُداراةُ حِكمَةٌ وَدَهاءُ",26,"ا",2,0],["فَيَدٌ مُسَلِّمَةٌ وَطَرفٌ شاخِصٌ","وَحَشىً يَذوبُ وَمَدمَعٌ مَسفوحُ",27,"ح",1,0],["فَيَدُ الهَوى تَهوي بِروحي في الضَنى","وَيَدُ النَوى تَنأى بِضَرِّ جَناني",28,"ن",2,0],["فَيَدُ الجَنوبِ تَلُفُّها","لفَّ الجَحافلِ بالجحافِل",29,"ل",1,0],["فَيَداكَ في عُنقِ الزَمانِ غَلائِلٌ","وَنَداكَ في جيدِ الأَنامِ قَلائِدُ",30,"د",1,0],["في دولةٍ في مقرِّ العزِّ ثابتةٍ","تُمْلي العلى من سجاياهُ على الدوَلِ",31,"ل",1,0],["في دَهرِيَ الأَوَّلِ المَذمومِ أَعرِفُهُم","فَالآنَ أُنكِرُهُم في دَهرِيَ الثاني",32,"ي",1,0],["في دَولَةٍ بَيضاءَ هارونِيَّةٍ","مُتَكَنِّفاها النَصرُ وَالتَمكينُ",33,"ن",1,0],["في دَولَةٍ لَحَظَ الزَمانُ شُعاعَها","فَاِرتَدَّ مُنقَلِباً بِعَينَي أَرمَدِ",34,"د",1,0],["في دَوحَةٍ عاجَ خَيرُ المُرسَلينَ بِها","مِن قَبل بعثَتِهِ لِلعُربِ وَالعَجَمِ",35,"م",1,0],["في ديرِ بيرةِ دادخينِ حُورٌ","في الباعِ عنْ سلوانِهنَّ قصورُ",36,"ر",1,1],["في دولةٍ للمسلمين تشوقُهم","أيّامُها وتهَزُّهم ذِكراها",37,"ا",3,0],["في ديارٍ لدى النجاشيِّ غُبْرٍ","ظلَّ فيها سَوادُهم مغمورا",38,"ر",2,0],["في دُجى لَيلِنا وَطَيِّ الحَواشي","مُدنَفُ الريحِ في قَصيرِ النَقاءِ",39,"ا",2,0],["في دَولَةٍ لِلَهِ عالِيَةِ الذُرى","دُعِمَت بِآياتِ الكِتابِ المُحكَمِ",40,"م",1,0],["في دَمي من تُراثه","نفحةُ البدوِ والحضَرْ",41,"ر",1,0],["في دولةٍ ممدودة الطِراف","مشدودة البُهْرة بالأطراف",42,"ف",1,0],["فِي دَوْلَةٍ بَلَغَتْ بِالْعَدْلِ مَنْزِلَةً","عَلْيَاءَ كَالشَّمْسِ فِي بُعْدٍ وَفِي نُورِ",43,"ر",1,0],["فِي دِفَّتَيْ سِفْرٍ تَضَمَّنَ مَا غَلاَ","مِنْ حِكْمَةِ الأَحْقَابِ وَالأَجْيَالِ",44,"ل",1,0],["فِي دُجَى المَعْضِلاَتِ رَأْيُكَ هَادٍ","وَأَوْلُو الأَمْرِ رَأْيُهُمْ فِيكَ عَالِ",45,"ل",1,0],["فِي دَارِ فَرْنَانِ مَهْرَجَانُ","جَاوَزَ فِي الحَقِّ كُلَّ حدْسِ",46,"س",1,0],["فِي دَارِ وَالدِهِ شَهِدْتُ نُمُوَّهُ","أَيَّامَ يَدْرُجُ نَاعِمَ الأَظْفَارِ",47,"ر",1,0],["فَي دَارِه هَذهِ تَجَلَّت","إِحْدَى مَبَرَّاتِهِ العَدَادِ",48,"د",1,0],["في دمع بسمتها وفي صلواتها","نُعْمَى تُطلُّ على العزاء وتشرق",49,"ق",1,0],["في دارِ إِسلامٍ وَسِلمٍ لِلعِدا","ضامَ النَصارى أَهلها وَمَجوسُ",50,"س",1,0],["في دمي من هواك حمّى البراك","ين العواتي وألف دنيا تزلزل",51,"ل",1,0],["في دولة الأدياك كا","ن من السُّعاةِ، أو الخدم",52,"م",1,0],["في دولتي أنا مغصوبٌ وفي زمني","عودي ظمِىء ٌ بلا ريٍّ ولا بللِ",53,"ل",1,0],["فيدرك الآثار والطرائدا","ويَنحل الأغلال والقلائدا",54,"د",2,0]]}