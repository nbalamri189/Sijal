{"poems":[[79,"قد كان قلبي مهما","https://www.aldiwan.net/poem36739.html","المجتث"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[74,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[66,"ما زلت أطفو في بحار الهوى","https://www.aldiwan.net/poem67630.html","البسيط"],[53,"وقائل إن أبا حفصل أحمق محتاج إلى ضرب","https://www.aldiwan.net/poem8501.html","السريع"],[53,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[53,"صبرا أمير المؤمنينا","https://www.aldiwan.net/poem66412.html","مجزوء الكامل"],[93,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[64,"وطائر يخرج من حفرة","https://www.aldiwan.net/poem52239.html","السريع"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"قد حثني بالكأس أو في فجره","https://www.aldiwan.net/poem26999.html","الكامل"],[50,"عليك باليأس من الناس","https://www.aldiwan.net/poem64343.html","السريع"],[50,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[50,"وشادن أهيف ذي غنة","https://www.aldiwan.net/poem66266.html","السريع"],[50,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[92,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[242,"هذا ضريحك يا أبا غالب","https://www.aldiwan.net/poem18054.html","الكامل"],[438,"بأبي سقيم الجفن صحح","https://www.aldiwan.net/poem12496.html","مجزوء الكامل"],[438,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[445,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[473,"وشادن صادني وتم له","https://www.aldiwan.net/poem60362.html","المنسرح"],[549,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122670","المنسرح"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66763","الرجز"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102040","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64147","المنسرح"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96304","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109052","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108513","الكامل"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123784","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48232","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27146","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205878","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58371","السريع"],[3005,"","https://poetry.dctabudhabi.ae/diwan/poem/34710","الرجز"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103466","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99349","الكامل"],[3713,"","https://poetry.dctabudhabi.ae/diwan/poem/144978","البسيط"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90030","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131231",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86580","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44688","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199100","البسيط"],[5887,"قال السجين","https://www.poetsgate.com/ViewPoem.aspx?id=35277",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["حَتَّى إِذَا صَحَّ قَصْدِي","صَارَ الْمَقَامُ حَجَابَا",0,"ب",2,0],["حتى إذا صرنا إلى المقصد","بعد مسير منصب مجهد",1,"د",1,0],["حتى إذا صلّى الحسام بطوعهم","صلَّت رؤوس عدًى بغير تطوع",2,"ع",1,0],["حتَّى إذا صغت في قاضي القضاة حُلا","مدحٍ تطهر فكرٌ بارعٌ وفمُ",3,"م",1,0],["حَتّى إِذا صَيَّرَني في الهَوى","إِلى مَكانٍ ما لَهُ شَطُّ",4,"ط",1,0],["حتى إذا صار إلى حالةٍ","تجمعُ ضَعْفَ الباهِ والكَسْبِ",5,"ب",1,0],["حتّى إذا صادمتُ خرطومَها","باليأسِ تنزيلا وتأويلا",6,"ل",2,0],["حتى إذا صارت إلي","ك هَدَيْتَ هَدْيَ الراشدينا",7,"ن",2,0],["حَتّى إِذا صارَت بِداحِيَةٍ","مَمدودَةٍ أَطرافَها صُفرِ",8,"ر",1,0],["حَتّى إِذا صارَت بِمُنعَرِجٍ","وَقَفَت كَمُنتَبِهٍ مِنَ السُكرِ",8,"ر",1,0],["حتى إذا صار مثل الماء فارم على","محلوله مثله من فاحم الشعرِ",9,"ر",1,0],["حتى إذا صار رماداً بلا","محَشَّةٍ تنشف في البحرِ",10,"ر",1,0],["حَتّى إِذا صَدَروا وَالخَيلُ صائِمَةٌ","مِن بَعدِ ما صُلَّتِ الأَسيافُ في القِمَمِ",11,"م",1,0],["حَتّى إِذا صَغَتِ الظِلا","لُ بُعَيدَ هَروَلَةِ العَساقِل",12,"ل",1,0],["حَتّى إِذا صُهبُ الجَنادِبِ وَدَّعَت","نَورَ الرَبيعِ وَلاحَهُنَّ الجُدجُدُ",13,"د",1,0],["حَتّى إِذا صَغا خِيارُ الجُندِ","وَقالَ يا حَربُ اِهزِلي وَجُدّي",14,"ي",1,0],["حَتّى إِذا صَبَّ المِزاجَ تَبَسَّمَت","عَن ثِغرِها فَحَسِبتُها عَن ثَغرِه",15,"ر",2,0],["حَتّى إِذا صارَ إِلى ما اِشتَهى","وَعَدَّهُ الناسُ مِنَ الناسِ",16,"س",1,0],["حَتّى إِذا صَبَّها مُفَدَّمَةً","تَضحَكُ عَن جَوهَراتِ لِآلِ",17,"ل",1,0],["حتى إذا صرتَ إلى حاضرٍ","منه إذا ليس له خَلفُ",18,"ف",1,0],["حتى إذا صار كسرى","بعد العديدِ المجهّر",19,"ر",1,0],["حتّى إذا صيَّرها بَراحا","وعاينوا حريمَها مُباحا",20,"ح",2,0],["حتى إذا صَوَّحَتْ آمالهُ ورأى","أن الأماني التي غرّته عُدْنَ هبا",21,"ب",2,0],["حتى إذا صح الصحيح","ومحص الذهب القيون",22,"ن",1,0],["حتى إذا صدَعوا السُّرادقَ أطرقت","تلك اللواحظُ من أغرَّ هِجانِ",23,"ن",1,0],["حَتَّى إِذا صَادَفَتْهُ تُرْبَتُكُمْ","تَبَيَّنَ الضُّرُّ أَنَّهُ كَاذِبْ",24,"ب",1,0],["حتى إذا صانوه عن","قُربي ولا صَوْنَ الحريمِ",25,"م",1,0],["حتى إذا صرفَ الصُروفَ وردّها","فجرَتْ بطاعةِ صِرفِه في ردّه",26,"د",2,0],["حَتَّى إِذَا صابَتْ بِقُرٍّ وانْثَنَى","ثَمَرُ الغِوَايَةِ مُؤْذِناً بِصِرَامِ",27,"م",1,0],["حَتّى إِذا صِرتُ في مَحَبَّتِهِ","مُقَيَّدَ القَلبِ بِالصَباباتِ",28,"ت",1,0],["حتى إذا صقلوا تُرابك وازدهت","ممّا تناثر من سناه الأحقب",29,"ب",1,0],["حتى إذا صارت إلى المفتون","أعني الذي لقب بالمأمون",30,"ن",1,0],["حَتَّى إذا صِبغَةُ الدُجى نَصَلَت","هَبَّ مِنَ النَّومِ خائِفاً فَزِعا",31,"ع",2,0],["حتى إذا صار بخُمِّ جاءَه","جبريلُ بالتبليغِ فيهم فنَزَلْ",32,"ل",1,0],["حتى إذا صدقتك قلت تبصري","مرآك تعتقدي به وتخالي",33,"ل",2,0],["حتى إذا صار طَلْعُها بَلَحاً","قالوا تَوَقَّعْ بلوغَ بُسْرتها",34,"ت",3,0],["حتى إذا صَحَرت شمسُ النهار وقد","أفضى الجُميل وزال الحزمُ والنَّسَقُ",35,"ق",1,0],["حَتَّى إِذا صَح وَطالَ ريشه","وَصارَ لا يُمكن من يَحوشَه",36,"ه",1,0],["حتى إذا صار أمناً","ذاك الذي كان رعبا",37,"ب",2,0],["حتى إذا صاد الدجى بازُ الضحى","وغدا الغراب على الدجنّة ناعبا",38,"ب",2,0],["حتى إذا صَلّى توُفَّى قائماً","حسبته حيّاً فاستمرّت طالعَه",39,"ع",2,0],["حتى إِذا صدعَ الألبابَ واعظُها","بخطبةٍ فَجَّرتْ أمواهَ أجفانِ",40,"ن",1,0],["حَتّى إِذا صاحَ الغُرابُ بِبَينِهِم","فَضَحَ الفِراقُ صَبابَةَ المَحزونِ",41,"ن",1,0],["حتَّى إذا صَارَ جَبَل قَفَاصي","في مَطلَعِ النَّعشِ وُقِيتَ الباسِ",42,"س",1,0],["حَتّى إِذا صِدنا الوُحوشَ فَلم نَدَع","مِنهُنَّ غَيرَ مَعالمٍ وَطُلولِ",43,"ل",1,0],["حتى إذا صدقت في العون همتهم","وجاءها النصر وانجابت غواشها",44,"ه",2,0],["حَتّى إِذا صارَ اِنفِلاق الفَجر","أَلقى بِهِم نارَه حَتّى تَسري",45,"ي",1,0],["حَتّى إِذا صارَ قَريبَ الصُّبح","وَبانَ ذو نجحٍ كَذا وَربح",45,"ح",1,0],["حتى إذا صِرنا إلى مَنْزلٍ","مُصوَّقِ الحيطانِ والقبّه",46,"ب",2,0],["حَتّى إِذا صُبحُ الدُجى جَلّى الظُلَم","صاروا إِلى اللَهِ وَفازوا بالنعَم",47,"م",1,0],["حتى إذا صاروا إزاء المكرعِ","بحيث لا يغتال سهم الأجرعِ",48,"ع",1,0],["حتى إذا صدر العنا","ب اليه عن حنق الصدور",49,"ر",1,0],["حتى إذا صَرَّخَتْ عَنَّا عواقبه","كانت لنا عِظَةٌ منه وتعنيف",50,"ف",1,0],["حتى إذا صرعتهُ سورتها","قمراً عليه الشُهب تأتلقُ",51,"ق",1,0],["حتى إذا صرعت كمياً منهما","باتا وذا جان وذاك شهيدُ",52,"د",1,0],["حتى إذا صبرهم أكدى أتيح لهم","مدبر محكم التدبير والنظر",53,"ر",1,0],["حَتّى إِذا صارَ في دَورِ الكَمالِ بَدا","مِنهُ الضِياءُ عَلى الدُنيا وَمَن فيها",54,"ي",3,0],["حتى إذا صدرت بالمرخ وانقطعت","عنها الرمال إلى بيداء ذي علم",55,"م",1,0],["حتى إذا صعد الدعا","جاء الجواب على الأثر",56,"ر",1,0],["حتى إذا صدعتهم ال","عزمات والحجج المبينة",57,"ن",2,0]]}