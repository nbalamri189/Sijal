ملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[31,"ذكر القلب ذكرة أم زيد","https://www.aldiwan.net/poem42654.html","الخفيف"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"بسجود القسيس يوم السجود","https://www.aldiwan.net/poem62586.html","الخفيف"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[68,"ما بين ضال المنحنى وظلاله","https://www.aldiwan.net/poem1518.html",""],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9962","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55117","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55034","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54954","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[91,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""],[31,"ذَكَرَ القَلْبُ ذِكْرَة ً أُمَّ زَيْدٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18749&r=&rc=12",""]],"verses":[["وَبَذَلتَ أَجسادَ الكُماةِ لِوَحشَةٍ","فَعَلِمنَ أَنَّكَ أَنتَ فيهِ الظافِرُ",0,"ر",1,0],["وبذَّ الحَيا إذْ جادَ والليثَ إذ سَطا","على القِرْنِ في أُكْرومَةٍ وصِيالِ",1,"ل",1,0],["وَبِذابِلي وَمُهَنَّدي نِلتُ العُل","لا بِالقَرابَةِ وَالعَديدِ الأَجزَلِ",2,"ل",1,0],["وَبَذَلنا لَكَ مِنّا","ودَّنا مَحضاً صَريحا",3,"ح",2,0],["وبذَلْتُ وُسْعي واجْتِهادي مِثْلَما","يَلْقى لمُلْكِكَ سيْفُ أمْرِكَ عامِرُ",4,"ر",1,0],["وَبَذَرتُم في أَرضِنا وَزَرَعتُم","فَرَأَينا ما يُعجِبُ الزُرّاعا",5,"ع",2,0],["وَبِذرَةً أَنبَتَت خَبالا","وَأَثمَرَت عاجِلَ الخَرابِ",6,"ب",1,0],["وَبِذِكرى صَخرَ نَفسي","كُلَّ يَومٍ كَلِفَه",7,"ف",2,0],["وَبِذَاكَ أَشْهَدْتَ البِلادَ مَدَاك فِي","إِنْجَاحِ مَا بَسَطَتْهُ مِنْ آمالِهَا",8,"ل",3,0],["وَبَذَلْتِ فِيهَا مَا بَذَلْتِ","تَكَرُّماً وَوَهَبْتِهَا لِي",9,"ي",1,0],["وَبَذَلْتَ بِذلَكَ فِي الفِدَاءِ","فَأُبْتَ بِالذِّكْرِ الجَمِيلِ",10,"ل",1,0],["وبذا عرّف الورى أنّ قول ال","مرء في الحرب قد يَفوق الحُساما",11,"م",2,0],["وَبَذَلتُ ذا رَحلي وَكُنتُ بِهِ","سَمحاً لَهُم في العُسرِ وَاليُسرِ",12,"ر",1,0],["وبذل جاهٍ ومالٍ مع توفرهِ","أربى وزاد فقلنا بذل مزّاح",13,"ح",1,0],["وبذل كريم ليس ينفكُّ مالُهُ","كرائمُهُ مبذولةٌ ونفائسه",14,"س",2,0],["وبَذْري يسير كبذر القرَا","حِ واعلم بأني قراحٌ مُغِلُّ",15,"ل",1,0],["وبذْلَةُ الوجه أحياناً تُجدّده","كما تجددُ سيفاً كَفُّ صاقلِهِ",16,"ل",2,0],["وَبَذَذتَ جالِنوسَ حِكمَتَهُ","وَالعِلمَ رِسطاطاليسَ وَالشِيَما",17,"م",2,0],["وَبَذَلتُ نَفسي كَي تَسي","لَ إِذا يَسيل بِها النَجيعُ",18,"ع",1,0],["وبذلت الجهد الجهيد فتيا","تصلح التغلراف والتلفونا",19,"ن",2,0],["وَبَذَلتَ ما عَشِقَتهُ نَفسُكَ كُلَّهُ","حَتّى بَذَلتَ لِهَذِهِ صِحّاتِها",20,"ت",3,0],["وَبِذي الأَراكَةِ مِن مَصيفٍ لابِسٍ","نَسجَ الرِياحِ وَمَربَعٍ مَهضوبِ",21,"ب",1,0],["وَبِذي اليَمينَينِ الَّذي ما مِثلُهُ","لِمُشيرِ أَخماسٍ إِلى أَسداسِ",22,"س",1,0],["وَبِذي الغَضا سَكَنٌ لِقَلبِ مُتَيَّمٍ","حُنِيَت أَضالِعُهُ عَلى جَمرِ الغَضا",23,"ض",2,0],["وَبِذي الكُلاعِ قَدَحتَ مِن زَندِ القَنا","حَرباً بِإِتلافِ الكُماةُ وَلوعا",24,"ع",2,0],["وَبَذَلتَ لِلمُدّاحِ صَفوَ خَلائِقٍ","لَو أَنَّها لِلبَحرِ طابَ مَشارِبا",25,"ب",2,0],["وَبِذِلّةِ أهلِ السبت قَضَى","ويذلّ له أهْلُ الأحدِ",26,"د",1,0],["وَبِذي الأَثلِ مِن دُوَينِ تَبوكٍ","أَرَّقَتنا وَلَيلَةَ الأَخرابِ",27,"ب",1,0],["وبذا تلقّى آدمٌ منْ رَبّهِ","عَفْواً وفاءَ ليُونُسَ اليَقطين",28,"ن",1,0],["وبذاك حسبك أن تجرر لأمة","وبحسبِ قومٍ أن تُجَرّ ذُيول",29,"ل",1,0],["وَبِذَبحِ الَّذي ذَكَرتُم بِأَنَّ ال","لاهَ لَم يُثبِتِ اِسمَهُ في العَبيدِ",30,"د",1,0],["وَبِذي طَعمٍ شَتيتٍ","بارِدٍ عَذبِ اللِثاتِ",31,"ت",1,0],["وبذلِكَ الشِّعبِ اليَماني مُنْيةٌ","للصبّ قد بَعُدَتْ على آمالِهِ",32,"ل",2,0],["وبِذَاتِ الشّيح عنّي إنْ مَرَرْ","تَ بِحَيٍّ من عُرَيْبِ الجِزعِ حَيْ",33,"ي",1,0],["وَبِذابِلي وَمُهَنَّدي نِلتُ العُلا","لا بِالقَرابَةِ وَالعَديدِ الأَجزَلِ",34,"ل",1,0],["وَبِذَلِكَ اللُّطْفِ الَّذِي خُصَّتْ بِهِ","مِصْرٌ أَمَلْتَ أَبِيَّهَا فَأُمِيلاَ",35,"ل",2,0],["وَبَذَلْتِ فِي الإِحْسَانِ بَذْلَكِ مِنْ قُوَى","فِكْرٍ وَمِنْ سعْيٍ وَمِنْ بِرٍّ خَفِي",36,"ي",1,0],["وَبَذَلْتِ فَضْلاً مِنْ نَدَاكِ لِبَارِعٍ","فِي فَنِّهِ أَوْ نَاظِمٍ أَوْ نَائِرِ",37,"ر",1,0],["وَبَذَرْتَ فِي أَخلاَقِهَا وَخِلاَلِهَا","أَزْكَى البُذُورِ فَآذَنَتْ بِنَمَاءِ",38,"ا",2,0],["وَبذَرْنا به القُلوبَ صِغاراً","وكِرَامَ النُّفُوسِ والمُهَجَاتِ",39,"ت",1,0],["وبذَّت سُكَينَةَ بنتَ الحسينِ","وعائشةً في بيانٍ ودين",40,"ن",1,0],["وبذلتَ في إنقاذ «رو","ما» ما لديك من الجهود!",41,"د",1,0],["وبذلتمو أرواحَكُم لبلادكُمْ","ثَمَنًا، وجَلَّ المشترِي والمشتَرّى!",42,"ر",2,0],["وبَذَلْنا عن طيبِ نفس له الما","لَ، وعشْنَا عَيْشَ الجِيَاع العُرَاة",43,"ه",1,0],["وبذالك حسبك ان تجرر لامة ... وبحسب قوم أن تجر ذبول","شهد البرية كلها لك بالعلى ... إن البرية شاهد مقبول",44,"ل",1,0],["وبذي وتلك كِفايتي شَرَفاً","يُرضِي العُلا ويَسُرَّ قبرَ أبي",45,"ب",2,0],["وبذرتَ للأوطانِ أشرفَ بذرةٍ","ستطول أفراعٌ لها وأصول",46,"ل",1,0],["وبذذت ((جالينوس)) حكمته","والعلم ((رسططا ليس)) والشّيما",47,"م",2,0],["وَبِذي الأَثْلِ مِنْ دُوَيْنِ تَبوكٍ","أقتنا، وليلة َ الأخرابِ",48,"ب",1,0]]}