955,"أنا مذ خلقتُ موحدًا","https://www.poetsgate.com/ViewPoem.aspx?id=190799",""],[5010,"الشّعرُ أرقى منزلاً","https://www.poetsgate.com/ViewPoem.aspx?id=190225",""],[585,"مهلاً وبعض اللوم والتفنيد","https://www.poetsgate.com/ViewPoem.aspx?id=161943",""],[5121,"يَا عِيدُ مَرحَى","https://www.poetsgate.com/ViewPoem.aspx?id=33497",""],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[5121,"غَرِّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=183758",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5186,"\"وبذاك يحلو قول \"\"يا سعد\"\"\"","https://www.poetsgate.com/ViewPoem.aspx?id=156452",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5338,"القلب شوقا للقاء طموح","https://www.poetsgate.com/ViewPoem.aspx?id=187677",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5409,"منعاك عز على العراق الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=155480",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5431,"علّ القلوب من السماحة تلبسُ","https://www.poetsgate.com/ViewPoem.aspx?id=191469",""],[5457,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=213117",""],[835,"بات ساجي الطرف والشوق يلح","https://www.poetsgate.com/ViewPoem.aspx?id=40614",""],[5538,"الله يقسم من أضاع فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=142624",""],[5612,"ته يا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=193283",""],[5644,"لمن تكتبين؟","https://www.poetsgate.com/ViewPoem.aspx?id=204499",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5756,"الاولي والتالي","https://www.poetsgate.com/ViewPoem.aspx?id=5415",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5956,"في القناعة سعادة","https://www.poetsgate.com/ViewPoem.aspx?id=184034",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""],[6093,"إنَّ للمجد بقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=181652",""],[463,"نظرة ٌ منكِ ويومٌ بالجريبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59977&r=&rc=33",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""]],"verses":[["وَبَذَلتَ أَجسادَ الكُماةِ لِوَحشَةٍ","فَعَلِمنَ أَنَّكَ أَنتَ فيهِ الظافِرُ",0,"ر",1,0],["وبذَّ الحَيا إذْ جادَ والليثَ إذ سَطا","على القِرْنِ في أُكْرومَةٍ وصِيالِ",1,"ل",1,0],["وَبِذابِلي وَمُهَنَّدي نِلتُ العُل","لا بِالقَرابَةِ وَالعَديدِ الأَجزَلِ",2,"ل",1,0],["وَبَذَلنا لَكَ مِنّا","ودَّنا مَحضاً صَريحا",3,"ح",2,0],["وبذَلْتُ وُسْعي واجْتِهادي مِثْلَما","يَلْقى لمُلْكِكَ سيْفُ أمْرِكَ عامِرُ",4,"ر",1,0],["وَبَذَرتُم في أَرضِنا وَزَرَعتُم","فَرَأَينا ما يُعجِبُ الزُرّاعا",5,"ع",2,0],["وَبِذرَةً أَنبَتَت خَبالا","وَأَثمَرَت عاجِلَ الخَرابِ",6,"ب",1,0],["وَبِذِكرى صَخرَ نَفسي","كُلَّ يَومٍ كَلِفَه",7,"ف",2,0],["وَبِذَاكَ أَشْهَدْتَ البِلادَ مَدَاك فِي","إِنْجَاحِ مَا بَسَطَتْهُ مِنْ آمالِهَا",8,"ل",3,0],["وَبَذَلْتِ فِيهَا مَا بَذَلْتِ","تَكَرُّماً وَوَهَبْتِهَا لِي",9,"ل",2,0],["وَبَذَلْتَ بِذلَكَ فِي الفِدَاءِ","فَأُبْتَ بِالذِّكْرِ الجَمِيلِ",10,"ل",1,0],["وبذا عرّف الورى أنّ قول ال","مرء في الحرب قد يَفوق الحُساما",11,"م",2,0],["وَبَذَلتُ ذا رَحلي وَكُنتُ بِهِ","سَمحاً لَهُم في العُسرِ وَاليُسرِ",12,"ر",1,0],["وبذل جاهٍ ومالٍ مع توفرهِ","أربى وزاد فقلنا بذل مزّاح",13,"ح",1,0],["وبذل كريم ليس ينفكُّ مالُهُ","كرائمُهُ مبذولةٌ ونفائسه",14,"س",2,0],["وبَذْري يسير كبذر القرَا","حِ واعلم بأني قراحٌ مُغِلُّ",15,"ل",1,0],["وبذْلَةُ الوجه أحياناً تُجدّده","كما تجددُ سيفاً كَفُّ صاقلِهِ",16,"ل",2,0],["وَبَذَذتَ جالِنوسَ حِكمَتَهُ","وَالعِلمَ رِسطاطاليسَ وَالشِيَما",17,"م",2,0],["وَبَذَلتُ نَفسي كَي تَسي","لَ إِذا يَسيل بِها النَجيعُ",18,"ع",1,0],["وبذلت الجهد الجهيد فتيا","تصلح التغلراف والتلفونا",19,"ن",2,0],["وَبَذَلتَ ما عَشِقَتهُ نَفسُكَ كُلَّهُ","حَتّى بَذَلتَ لِهَذِهِ صِحّاتِها",20,"ت",3,0],["وَبِذي الأَراكَةِ مِن مَصيفٍ لابِسٍ","نَسجَ الرِياحِ وَمَربَعٍ مَهضوبِ",21,"ب",1,0],["وَبِذي اليَمينَينِ الَّذي ما مِثلُهُ","لِمُشيرِ أَخماسٍ إِلى أَسداسِ",22,"س",1,0],["وَبِذي الغَضا سَكَنٌ لِقَلبِ مُتَيَّمٍ","حُنِيَت أَضالِعُهُ عَلى جَمرِ الغَضا",23,"ض",2,0],["وَبِذي الكُلاعِ قَدَحتَ مِن زَندِ القَنا","حَرباً بِإِتلافِ الكُماةُ وَلوعا",24,"ع",2,0],["وَبَذَلتَ لِلمُدّاحِ صَفوَ خَلائِقٍ","لَو أَنَّها لِلبَحرِ طابَ مَشارِبا",25,"ب",2,0],["وَبِذِلّةِ أهلِ السبت قَضَى","ويذلّ له أهْلُ الأحدِ",26,"د",1,0],["وَبِذي الأَثلِ مِن دُوَينِ تَبوكٍ","أَرَّقَتنا وَلَيلَةَ الأَخرابِ",27,"ب",1,0],["وبذا تلقّى آدمٌ منْ رَبّهِ","عَفْواً وفاءَ ليُونُسَ اليَقطين",28,"ن",1,0],["وبذاك حسبك أن تجرر لأمة","وبحسبِ قومٍ أن تُجَرّ ذُيول",29,"ل",1,0],["وَبِذَبحِ الَّذي ذَكَرتُم بِأَنَّ ال","لاهَ لَم يُثبِتِ اِسمَهُ في العَبيدِ",30,"د",1,0],["وَبِذي طَعمٍ شَتيتٍ","بارِدٍ عَذبِ اللِثاتِ",31,"ت",1,0],["وبذلِكَ الشِّعبِ اليَماني مُنْيةٌ","للصبّ قد بَعُدَتْ على آمالِهِ",32,"ل",2,0],["وبِذَاتِ الشّيح عنّي إنْ مَرَرْ","تَ بِحَيٍّ من عُرَيْبِ الجِزعِ حَيْ",33,"ي",1,0],["وَبِذابِلي وَمُهَنَّدي نِلتُ العُلا","لا بِالقَرابَةِ وَالعَديدِ الأَجزَلِ",34,"ل",1,0],["وَبِذَلِكَ اللُّطْفِ الَّذِي خُصَّتْ بِهِ","مِصْرٌ أَمَلْتَ أَبِيَّهَا فَأُمِيلاَ",35,"ل",2,0],["وَبَذَلْتِ فِي الإِحْسَانِ بَذْلَكِ مِنْ قُوَى","فِكْرٍ وَمِنْ سعْيٍ وَمِنْ بِرٍّ خَفِي",36,"ف",2,0],["وَبَذَلْتِ فَضْلاً مِنْ نَدَاكِ لِبَارِعٍ","فِي فَنِّهِ أَوْ نَاظِمٍ أَوْ نَائِرِ",37,"ر",1,0],["وَبَذَرْتَ فِي أَخلاَقِهَا وَخِلاَلِهَا","أَزْكَى البُذُورِ فَآذَنَتْ بِنَمَاءِ",38,"ا",2,0],["وَبذَرْنا به القُلوبَ صِغاراً","وكِرَامَ النُّفُوسِ والمُهَجَاتِ",39,"ت",1,0],["وبذَّت سُكَينَةَ بنتَ الحسينِ","وعائشةً في بيانٍ ودين",40,"ن",1,0],["وبذلتَ في إنقاذ «رو","ما» ما لديك من الجهود!",41,"د",1,0],["وبذلتمو أرواحَكُم لبلادكُمْ","ثَمَنًا، وجَلَّ المشترِي والمشتَرّى!",42,"ر",2,0],["وبَذَلْنا عن طيبِ نفس له الما","لَ، وعشْنَا عَيْشَ الجِيَاع العُرَاة",43,"ه",1,0],["وبذالك حسبك ان تجرر لامة ... وبحسب قوم أن تجر ذبول","شهد البرية كلها لك بالعلى ... إن البرية شاهد مقبول",44,"ل",1,0],["وبذي وتلك كِفايتي شَرَفاً","يُرضِي العُلا ويَسُرَّ قبرَ أبي",45,"ب",2,0],["وبذرتَ للأوطانِ أشرفَ بذرةٍ","ستطول أفراعٌ لها وأصول",46,"ل",1,0],["وبذذت ((جالينوس)) حكمته","والعلم ((رسططا ليس)) والشّيما",47,"م",2,0],["وَبِذي الأَثْلِ مِنْ دُوَيْنِ تَبوكٍ","أقتنا، وليلة َ الأخرابِ",48,"ب",1,0],["وبذكر أهلها تلك السجايا","فيشرق من تذكّرها الظلام",49,"م",1,0],["وَبَذرت لي حُب المَنا","وَنَصبت لي شرك المِنَن",50,"ن",1,0],["وَبَذل لِلنضار بَغَير مِن","عَلى مِقدار مَوجودي وَحالي",51,"ل",2,0],["وَبَذلت روحك في رِضاهُ وَكُلَّما","مَلَكت يَمينك لَم تَقُم بِوَفائِهِ",52,"ه",1,0],["وبذاك الطوفان نجيت نوحا","وحفظت النجي في سيناء",53,"ا",2,0],["وبذاك قد شهد الرسو","ل وقال أقضاكم على",54,"ل",2,0],["وبذر الرؤوس والرقابا","ونثل الكبود والعيابا",55,"ب",2,0],["وبذكر اللهِ فالهجْ لا تكنْ","بسوى الله تعالى مُشْتَغِلْ",56,"ل",1,0],["وبِذِى الأثلةِ استَهَلَّت رَوَايَا","مِنهُ حتى سَقَتهُ سَقياً عَمِيمَا",57,"م",2,0],["وبِذِى العُنَّةِ الأضَاةِ مَغَانٍ","هُنَّ مِن مُوجِبَاتِ سَحِّ الدُّمُوعِ",58,"ع",1,0],["وبذلي الجهدَ في تقويم نفسي","وسَيري في الطريقِ المستنيرِ",59,"ر",1,0],["وبذكرِ ذي سلمٍ وسَلع والصفا","روّحْ فؤاداً للغرام ملازما",60,"م",2,0],["وبذكر حسن ظباءِ مكةَ داوما","جرحت ظبي البرحاءِ ويحكَ داوما",60,"م",2,0],["وَبَذلِ الرُعبِ في عاصٍ وَباغٍ","وَبَسطِ العَدلِ في قاصٍ وَدانِ",61,"ن",1,0],["وَبَذَلتَ حُمرَ المالِ في تَنفيذِهِم","أَيّامَ عَزَّ عَلَيهِمُ وِجدانُهُ",62,"ن",2,0],["وَبَذلُ النَدى وَالعُرفَ في الخَلقِ حُورَها","فَمِن أُثرٍ يَحلو لَكَ الحِسُّ نورَها",63,"ه",2,0],["وَبَذّوا بِمَعنٍ جُودَ أَوسٍ وَحاتمٍ","وَلا يَستَوي بَحرٌ خِضَمٌّ وَخلجانُ",64,"ن",1,0],["وبذلك المغنى اشبب منشدا","لا بالرباب وزينب ومعاد",65,"د",1,0],["وبذلتُ ما عندي له من حجّة","وإن احتقرتُ له الذي عندي",66,"د",2,0],["وَبِذاكَ الإعراضُ مِن غَيرِ ذَنبٍ","مَظهراً في سَطوَةِ الاِقتِدارِ",67,"ر",1,0],["وَبَذَلُوا فِي الأَمْرِ طَاقَتَهُمْ","إِذْ فَاتَهُمْ أَنْ يَقْرَبُوا نُهْيَهْ",68,"ي",2,0],["وبذاك جرت عادات الحق","ق تعالى ذي اللطف البهج",69,"ج",1,0],["وبذلت كلي رغبة في وصلها","حتى تعامى الدهولي عن بعضه",70,"ض",2,0],["وبذل ندى يأتيك قبل ندائه","سريعاً كما يأتي الوكون طيورها",71,"ر",3,0],["وَبِذاكَ آثَرَكَ الإِلَهُ عَلَيهِمُ","يا مُؤثِراً أوزعت شُكرَ المُؤثرِ",72,"ر",1,0],["وَبَذَلتَ روحي في هَواكَ حَقيقَة","وَلَزِمتَ بابَكَ بُكرَةً وَعَشِيَّةً",73,"ه",1,0],["وبِذا قَنَعْتُ مِن الأَحِب","َّةِ لا أزورُ ولا أُزارُ",74,"ر",1,0],["وَبِذُلّي لَدَيهِ لاقَيتُ عِزّي","وَبِفَقري إِلَيهِ نِلتُ غَنائي",75,"ا",3,0],["وَبَذَّ في إِفطارِهِ","بِنُطقِهِ أَهلَ البِذا",76,"ذ",2,0],["وَبَذَلت كُلّ الجهد في طَلَب الرضى","مِن ذي العَطاءِ فمن يعدّكَ مُسرِفا",77,"ف",2,0],["وبذلْتُ جُهْدِي في ارتيادِ تَصادُقٍ","فأبَوا به إلاّ ازديادَ تعاد",78,"د",1,0],["وبذاك النّطَرِ السّامي له","فاق في الآفاقِ كُلَّ النّظراء",79,"ا",2,0],["وَبَذَلتَ لي مَلَقاً وَقُلتَ كَرامَةً","أَسدَلتَها دونَ الرَجاءِ حِجابا",80,"ب",2,0],["وبذَلتَ مالكَ دونَ دينكَ مُوقِناً","أن لستَ قبلَ الحَشرِ بِالمعتاضِ",81,"ض",1,0],["وبذكره أبداً يُكَر","رَرُ بيننا وبه يُردَّد",82,"د",1,0],["وبذاتك الكبرى أَجدتَّ فيا له","من كِبر جودٍ فائقِ الآراء",83,"ا",2,0],["وَبذرتَ الودَّ بِالقَو","لِ فَلَم تَزكُ البذورُ",84,"ر",1,0],["وَبِذكرِ فَضلِكُمُ اِغتِبا","قي كلَّ يَومٍ وَاِصطِباحي",85,"ح",2,0],["وبذلتَ نفسك لِلأئِمَّةِ راعياً","لِعهودِهم في السرِّ والإعلانِ",86,"ن",1,0],["وبذلْنا النّفوسَ ثَمَّ ولم","نَنْكلْ ضراباً من دُونِه وطِعانا",87,"ن",2,0],["وبذلكما منه لما قد عرفتما","وحققتما من لفظه ومعانيه",88,"ي",2,0],["وبذا أجيب مسائلي في حفرتي","وبه ختام القول عند سياقي",89,"ق",2,0],["وبذاك تنكسر القلو","ب وعل بعد الكسر جبرا",90,"ر",2,0],["وبذلت النفيس في الأخذ عنه","سامحاً بالأوطان والأوطار",91,"ر",1,0],["وبذلت أموال الخزائن بعدما","هرمت وراء خواتم الخزان",92,"ن",1,0],["وبذلتَ جودَك للعُفاةِ فما لهم","وِردٌ سواهُ وليس عنهُ مَصدَرُ",93,"ر",1,0],["وبذلتُ جَهدِي بالنِّيابَةِ عنه باُلنْ","نَزرِ القليلِ من الكثير البا