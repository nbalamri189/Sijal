{"poems":[[79,"أيا عمر العدل الذي مطل المدى","https://www.aldiwan.net/poem36059.html","الطويل"],[53,"ذق أبا جعفر مغبة جرمك","https://www.aldiwan.net/poem65807.html","الخفيف"],[47,"رأت وخط شيب في عذاري فصدت","https://www.aldiwan.net/poem62645.html","الطويل"],[47,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[47,"سقى دار ليلى حيث حلت رسومها","https://www.aldiwan.net/poem65675.html","الطويل"],[82,"وذات عين من الغزلان فاترة","https://www.aldiwan.net/poem31276.html","البسيط"],[54,"تبدى فأين الغصن من ذلك الغصن","https://www.aldiwan.net/poem26624.html","الطويل"],[54,"قضى وطرا من لذة ونعيم","https://www.aldiwan.net/poem26690.html","الطويل"],[50,"من أنا في موقف الحساب إذا","https://www.aldiwan.net/poem65021.html","المنسرح"],[50,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[78,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[47,"تُرِيكَ الذي حُدّثتَ عَنهُ منَ السِّحْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31341",""],[234,"هنتك أمير المؤمنين سعادة","https://www.aldiwan.net/poem50779.html","الطويل"],[234,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[287,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[303,"أجارك الله هذا الحلف والجار","https://www.aldiwan.net/poem36816.html","عموديه"],[463,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[466,"تدل عليه عبقة هاشمية","https://www.aldiwan.net/poem15654.html","الطويل"],[466,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16179.html","الطويل"],[567,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48599","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48806","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116012","الرجز"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82531","البسيط"],[1973,"","https://poetry.dctabudhabi.ae/diwan/poem/145496","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110621","البسيط"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128679","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138578",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138707",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45744","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36750","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34583","الطويل"],[4802,"خليل أنا عندي حكي","https://www.poetsgate.com/ViewPoem.aspx?id=33011",""],[5277,"وااهٍ على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=197630",""],[5376,"قلْنا لذي العربانِ ما الخطْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=197733",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""]],"verses":[["هَنَتْ عَيْنَكَ الْيَقْظَى مِن اللهِ عِصْمَةٌ","كَفَتْ وَجْهَ دِينِ اللهِ مَوْقِعَ شَيْنِهِ",0,"ن",2,0],["هُنْتَ عندي فلا مديحُك يُهْدِي","لي سروراً ولا أُساء بذَمّك",1,"ك",1,0],["هَنَتكَ أَميرَ المُؤمِنينَ بِشارَةٌ","إِلَيكَ عَلى كَرهِ الأَعادي تَأَدَّتِ",2,"ت",1,0],["هَنَتكَ أَميرَ المُؤمِنينَ بِشارَةٌ","مِنَ الشَرقِ جاءَت بِالبَيانِ المُصَرِّحِ",3,"ح",1,0],["هَنَتكَ أَميرَ المُؤمِنينَ مَواهِبٌ","مِنَ اللَهِ مَشكورٌ لَدَيكَ جَسيمُها",4,"م",3,0],["هَنّتْ بلحظٍ ولفظٍ فالهوى بهما","يخوض قلبي من عيني ومن أذني",5,"ن",2,0],["هَنَتكَ أَميرَ المُؤمِنينَ خِلافَةٌ","أَتَتكَ عَلى طَيرِ السَعادَةِ وَاليُمنِ",6,"ن",1,0],["هَنَتكَ أَميرَ المُؤمِنينَ سَلامَةٌ","بِرُغمِ عَدوٍّ في الحَديدِ كَظيمِ",7,"م",1,0],["هُنتَ عَلى الخالِقِ الجَليلِ فَما","يَنظُرُ في قِصَّتي وَلا عَمَلي",8,"ل",2,0],["هنتُ على الخالقِ الجليل فما","ينظرُ في قصّتي ولا زلَلي",9,"ل",2,0],["هنَّتْكَ نُعمى تَمَّتْ سوابغُها","كما اسْتَتمَّ الهلالُ في كَملِهْ",10,"ل",2,0],["هْنتكْ، أمِيرَ المُؤمِنينَ، كِفَايَةٌ","مِنَ الله، في الأعداءِ، نابهةُ الذّكرِ",11,"ر",1,0],["هنتك أمير المؤمنين سعادةٌ","وإقبالُ عِزّ جاء بالنُّجح مقرونَا",12,"ن",2,1],["هَنَّتك أعيادُك الّتي بك قد","هُنِّئن يا أوحدَ الزمانين",13,"ن",1,0],["هُنِّتَ رَغماً لِأُنوفِ العِدا","بِعامِ خَمسٍ وَثَمانينا",14,"ن",2,0],["هنتمْ عَلَى كلِّ شعبٍ من تخاذِلكمْ","شأنَ العبيدِ وباقي الناس أحرار",15,"ر",1,0],["هنَتْكَ وشائحُ علَّقتَها","يدَ الملك عُروتُها ما تُحَلّْ",16,"ل",1,0],["هنَتْك القوافي يابن عمِّ محمَّدٍ","مَعيبٌ ومذمومٌ بها منْ يَعيبُها",17,"ب",3,0],["هنَتْكَ القوافي الباهِراتُ بلاغَةً","ننامُ كِلانا وهي واخِدةٌ تَسْري",18,"ر",2,0],["هنَّتْ بهِ نفسَها الدُّنيا وقد هُدِيت","بعدلهِ واهتدَت للحقِّ عن حِكَمِ",19,"م",1,0],["هنت بالعشقِ يا معذبتي بع","د اعتزاز بالفضل واستكبار",20,"ر",1,0],["هنتمُ كلكم عليه فلا غُي","يابكم يتقي ولا الحُضَّارا",21,"ر",2,0],["هنتم غداة جعلتهم في معاوية","حتى الوصي فأما الحق لم يهن",22,"ن",1,0],["هُنتُ ولولا أنت يا","مُعذّبى لم أهُن",23,"ن",1,0],["هَنتك أُكرومَةٌ جُلّلتَ نِعمَتها","أَنمت وَليَّك وَاجتَثَّت أَعاديكا",24,"ك",2,1],["هنتك أمير الجود خير هديَّة","تقدَّمها الإيمان واليمن والفخرُ",25,"ر",1,1],["هنتك بالعيد إذ وافى إليك ولو","ألقت لها رشداً هنت بك العيدا",26,"د",2,0],["هنت بملكٍ نفيسٍ","أيامُ سعدٍ مُخلَّد",27,"د",1,0],["هنت المصطفى به ثم قالت","لك في السبط عظم الله اجرا",28,"ر",2,0],["هنت وعزت جده فتحولت","تلك التهاني وانتفى البشر",29,"ر",1,0],["هنت مَناصبكم يا ابن العلاء بِكُم","لِأَنَّها لَكُم في المَجد تَنتَسب",30,"ب",1,0],["هنته قَوس الكرات قَوساً","وَهوَ سِهامُ المُنا يَريشُ",31,"ش",1,0],["هنتك أمير المؤمنين خلافةٌ","جمعتَ بها أهواءَ أُمَّةِ أحمدِ",32,"د",1,0],["هنت وتغربت وغديت شعر وهوى وجسم نحيل","وصرت احسد الطفل الصغير اللي تحب تجالسه .",33,"س",2,0],["هنتمْ وهانَ منَ العداةِ لواؤُكمْ","وعليكمُ الخنزيرُ ظلماً صالا",34,"ل",2,0],["هُنْتُمْ وما هانتْ مضاربُنا","ولنا سماءُ الكونِ والشهْبُ",35,"ب",1,0],["هنتُ في أهلي واستبيحتْ","ربوعي ورمتني بدائها الخرساءُ",36,"ا",2,0]]}