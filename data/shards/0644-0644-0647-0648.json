{"poems":[[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[95,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[85,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[53,"لله وراق مررنا به","https://www.aldiwan.net/poem64649.html","السريع"],[87,"سويجع النيل رفقا بالسويداء","https://www.aldiwan.net/poem63685.html","البسيط"],[45,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[68,"لله وادي الغرس حين حللته","https://www.aldiwan.net/poem40659.html","الكامل"],[82,"لله شمس كان أولها السها","https://www.aldiwan.net/poem31264.html","الكامل"],[46,"الهوى ظالم وأنت ظلوم","https://www.aldiwan.net/poem30121.html","الخفيف"],[46,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[71,"لله ورد سرنا","https://www.aldiwan.net/poem28383.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55106","الكامل"],[108,"عصبة الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=179423",""],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[119,"لي قلب على المحبة قد شب","https://www.aldiwan.net/poem40874.html","عموديه"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[189,"لله وافر كمثرى ذكرت به","https://www.aldiwan.net/poem14622.html","البسيط"],[208,"أنا والله أرحم العشاقا","https://www.aldiwan.net/poem53213.html","الخفيف"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[286,"يا رب إن شفيعي من ذنوبي في","https://www.aldiwan.net/poem1390.html",""],[286,"لله أبعث رغبتي متيقناً","https://www.aldiwan.net/poem1401.html",""],[303,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[422,"لله والدة المليك وما بنت","https://www.aldiwan.net/poem53919.html","الكامل"],[441,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[466,"ملك الشكر نوال","https://www.aldiwan.net/poem16095.html","مجزوء الرمل"],[558,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[567,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83288","الكامل"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122531","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122789","المديد"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110732","الكامل"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104448","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122378","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62539","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62527","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64773","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56636","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109276","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128721",""],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48209","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48230","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87372","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67976","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112367","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62965","السريع"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91521","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3871,"","https://poetry.dctabudhabi.ae/diwan/poem/145928","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103026","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40129","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70118","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77026","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97086","الكامل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117300","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66125","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66142","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77687","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4791,"اجمع الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=36959",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[259,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=180839",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5461,"يبكي الصوت والنظرات تشكي","https://www.poetsgate.com/ViewPoem.aspx?id=1308",""],[5704,"لبيك يا أقصى","https://www.poetsgate.com/ViewPoem.aspx?id=191599",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5989,"يا راحلاً قد شاقهُ الغرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=181565",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""]],"verses":[["للهِ وَقْفَتُنا التي ضمِنَتْ لنا","شَجَناً غَداةَ تَفَرّقَ الجيرانُ",0,"ن",1,0],["للهِ وَثَبْتَهُمْ إذَا اسْتَبْقَتْ","فِيهَا النُّهَى وَتَبَارَتِ المُنَنُ",1,"ن",1,0],["للهِ وجهتك التي نلنا بها","أَجرَ الجهاد وبغيةَ الآمالِ",2,"ل",1,0],["للَه ورّاقٌ مررنا به","في صَفِّ أصحابِ القراطيسِ",3,"س",1,1],["لِلَّهِ وادٍ كَما يَهوى الهَوى عَجَبٌ","تَرَكتَ كُلَّ خَلِيٍّ فيهِ ذا داءِ",4,"ا",2,0],["لِلَّهوِ آوِنَةٌ تَمُرُّ كَأَنَّها","قُبَلٌ يُزَوَّدُها حَبيبٌ راحِلُ",5,"ل",1,0],["لِلَّهِ وادي الغَرسِ حينَ حَلَلتُهُ","زَمَناً كَأَنَّ العَيشَ فيهِ مَنامُ",6,"م",1,1],["للّه واصفةٌ مُعَرَّسَ سادةٍ","وهناً لعينك باضطراب لسانِ",7,"ن",1,0],["لِلهَوى جُرأَةٌ وَمِنكَ صُدودٌ","لَيسَ لي مِنكُما مُحِبٌّ رَحيمُ",8,"م",1,0],["لِلَّهِ وَخدُ المَهاري أَيَّ مَكرُمَةٍ","هَزَّت وَأَيَّ غَمامٍ قَلقَلَت خَضِلِ",9,"ل",1,0],["للهِ وردٌ سرَّنا","في كلِّ عامٍ قربُهُ",10,"ه",1,1],["لِلهِ وَثْبَتُكِ الْبَدِيعَةٌ","إِذْ وَثبْتِ لِتطْلُعِي",11,"ع",2,0],["للهِ وَجْهُكِ إِنْ سفَرْتِ فَإِنَّهُ","وَجْهُ المُنَى فِي عَيْنِ مُسْتَجْلِيكِ",12,"ك",1,0],["للَّهو، لا للنقض والإبرام","سابحة في عالم الأحلام",13,"م",1,0],["لِلَّهْو فيها حوانيتٌ وأنديةٌ","وللصلاة محاريبٌ وعُبَّاد",14,"د",1,0],["للهوى والغرام في اللب ساكن","كم وكم حرك الغرام السواكن",15,"ن",1,0],["لله وجد فيهم أخفيته","فيما أظن وإنما يخفيني",16,"ن",2,0],["للهِ وافرُ كمثرى ذَكرتُ به","ما كنتُ أَعْهَد في أيامىَ الأُوَلِ",17,"ل",1,1],["للهوى في جوانحي نار شوقٍ","كل يومٍ تزيد فيه احتراقا",18,"ق",2,0],["للهِ والحقِّ اغضَبَنَّ وإن تمُت","مُستشهداً أحياكَ حمدُ الحامد",19,"د",1,0],["لله وهو كئيبٌ خائفٌ وَجلٌ","من الذنوبِ حزين القلبِ ذو ألمِ",20,"م",1,0],["لله وسلتُ النبيَّ محمداً","أكرمْ بتلك وسيلةً لله",21,"ل",2,0],["للهِ وَللمثلِ الأعلى","وَلوجه الأُمةِ والوطنِ",22,"ن",1,1],["لِلَهِ وَجهُ شُجاعٍ إِنَّ آيَتَهُ","كَالصُبحِ مُبصِرَةٌ لَم يَمحُها الغَضَبُ",23,"ب",1,0],["لله والدةُ المليك وما بَنَتْ","من جامعٍ رَحبِ الفناء مُنَمْنَمِ",24,"م",1,1],["لِلّهِ وَردٌ ناضِرٌ في سَوسَن","غَضٌّ حَيا اِستِحيائِهِ يَحمِيهِ",25,"ي",2,0],["لله والمجدِ والحفيظة وال","عزائم العالياتِ والهممِ",26,"م",1,0],["لله والمجدِ هم فروعاً","تمّت بإقبالها الأصولُ",27,"ل",1,0],["للْهَوى عاصٍ وبالعَلِْ","ياء صَبٌّ مُسْتَهامُ",28,"م",1,0],["لِلَّهِ واشٍ رَعى زَوراً أَلَمَّ بِنا","لَو كانَ يَمنَعُنا في النَومِ أَحلاما",29,"م",2,0],["للهوى كالمَلام داعٍ فإنْ قُل","تِ بتركِ الداعي إذَنْ فاترُكيهِ",30,"ي",2,0],["لِلَهِ وَفَّيتَ الأَمانَةَ حَقَّها","وَبَذَلتَ فيها طارِفاً وَتَليدا",31,"د",2,0],["للهوى طريق مطرق","ينهب العقول ويخطف",32,"ف",1,0],["للهوى عِزةٌ ولولاهُ والشَّه","وَةُ لم تَخدُمِ الرجالُ النساءَ",33,"ا",2,0],["لِلهَوَى حُكمٌ يَجُورُ بِهِ","وَعَلَى السُّلطانِ سُلطانُ",34,"ن",1,0],["للَه وكف أكفك اللاتي غدت","في الجدب تستجدي الوفود سحابها",35,"ب",3,0],["للَه وصلك ما احيلا","ه وهجرك ما امرا",36,"ر",2,0],["للّه والعرش المقدس والحمى","هذا السلام وذلك التبجيل",37,"ل",1,0],["للهو آونة نمر خلسة","كأنها تقبيل ثغر راحل",38,"ل",1,0],["للّه وقفتنا بوا","دي المنحنى تحت البشامْ",39,"م",1,0],["لله وذنان الكريم إذا","طلع الردى قطع المَدى وثبا",40,"ب",2,0],["للّه وقعة كربلاء فيا لها","من وقعة بين الوقايع صيلم",41,"م",1,0],["للهِ وَصلُكِ ما أَغلاهُ يومَ شَرىً","وَشهدُ ريقِكِ ما أَحلاهُ مُشْتارَا",42,"ر",2,0],["للهوى جرأة وللرأي حكم","والبرايا لديهما شيعتان",43,"ن",1,0],["للهوى نفحة يفوح شذاها","في فؤاد المحب ما زال رطبا",44,"ب",2,0],["للّه ورنح بذكر طيبة قلبي","وانزل بحمى في ذمام أكرم جيران",45,"ن",1,0],["لله وردٌ رقَّ تحت نِقابه","حاولت منه قبلةً فتعصْفَرا",46,"ر",2,0],["لله وقفتُنا بالسفح كم سفحتْ","من أدمعٍ لونُها درٌّ ومرجانُ",47,"ن",1,0],["لِلَّه وجنتُهُ وَقَلبي والهَوى","فالكلُّ جمرٌ قد تأَججَّ حَرُّهُ",48,"ر",2,0],["لله وا أسفي إن الهوى أَسَفٌ","قَدْ كَانَ قلبي وفيه الحيُّ سُكان",49,"ن",1,0],["للهِ وِقفةُ باسلٍ خُذِلت لَهَا","كلُّ العِدى والعالَمون شُهود",50,"د",1,0],["للّهوِ في نهاري","في اللّيلِ للسّمَر",51,"ر",1,0],["لله وافٍ جارُه منه في","ظلٍّ ظليلٍ وجَنى غَضِّ",52,"ض",1,0],["لِلَّهِ وَجهٌ لا يُحَدُّ بِصورَةٍ","وَلِرَبِّنا عَينانِ ناظِرَتانِ",53,"ن",1,0],["لِلهَوى وَالطِّلا غُرورٌ وَأُنسٌ","وَالتئامٌ وَضمّةٌ باحتيال",54,"ل",1,0],["للهوى العذريّ فيهم ذمَّةٌ","مستحيل بينهم أن تخفرا",55,"ر",2,0],["لله وادي النيربين وظله","لا الرقمتان ورامة والأبرق",56,"ق",1,0],["للَه وقفتها بذي سلم ضحىً","ودموعها وقفت على الأجفان",57,"ن",1,0],["للّهِ وَجهُكَ وَالوجوهُ كأنّما","حطّت بها أوقار هِيت وقارَها",58,"ر",3,0],["لِلّهِ وَفقٌ بِتاريخٍ يوبّدهُ","أَسما لا سَمى عَبيد اللَه مُذ خُلِقا",59,"ق",2,0],["لِلهَوى وَالبَطالَة صِرتُ حلفاً","وَرِحتُ قَرينَ خَسراني وَغَبني",60,"ن",2,0],["للَه وقعة كربلا","تركت مدامعنا ذروفه",61,"ف",2,1],["للَه واديها الخصيب الفايح","وماؤه العذب الفرات السارح",62,"ح",1,0],["للَه ووقت أشرقت أنواره","بسنا نبي في الذنوب شفيع",63,"ع",1,0],["لله والمجدِ والتاريخُ ما فَعَلَتْ","ابْنااكِ الغُرُّ اذْ سالَ العِراقُ دَما",64,"م",2,0],["لله والامْجادِ والتارِيخِ ما","شادَ الجُدُودُ لَنا منَ الاحْساب",65,"ب",1,0],["لله وقت كان ين","ظمنا كما نظم الفريد",66,"د",1,0],["للَهِ وقفتهم على الجرعاءِ من","بان النقا مرّت كحُلم النائم",67,"م",1,0],["للهوى منك همٍ يا حبيبي طويل","والله اللي رمى قلبي بحومة غلاك",68,"ك",1,0],["لله وقفتنا بأم","اللخم إذ حمي اللهب",69,"ب",1,0],["للهِ والزَّيتونُ أينَ جذورُهُ","تبقى إذا ما طارتِ الأغصانُ؟",70,"ن",1,0],["للهوى أصبو وأجثو","راكعاً قلبي كليمُ",71,"م",1,0],["للَّهْو فاذهب ودعنا يا ابن جلدتنا","فما التقينا وما أبديت منتحبا",72,"ب",2,0],["للهوى والشباب حكم علينا","نافذاً كان سرنا أم شجانا",73,"ن",2,0],["للهوى حس اذا لامس زهرك","ينعش القلب اذا جاني حسيسه",74,"س",2,0],["للَّهْوِ إن طُلِبُوا لبُّوا بلا كسلٍ","وَإِنْ هُمُ طُلِبُوا للذودِ انقلبوا",75,"ب",3,0],["للهوى قلبُهُ، وللشجوِ عَينا","هُ ، وللعالمينَ كلُّ هباتِهْ",76,"ت",2,0],["للهول والأخطار وِجْهتُهُ","عَرَفتهُ من سيمائه الطرقُ .",77,"ق",1,0],["لله وقفته في كربلا وسطا","بين الوغى والخبا يحمي بها الثقلا",78,"ل",2,0]]}