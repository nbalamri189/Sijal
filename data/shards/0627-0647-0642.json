{"poems":[[121,"الغدر","https://www.aldiwan.net/poem24021.html","الرمل"],[438,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127382","الرمل"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107539","الخفيف"],[5111,"نِيْلا","https://www.poetsgate.com/ViewPoem.aspx?id=212502",""],[5121,"مارد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=33705",""],[5431,"أن يظلّوا كشعلة مستنيره...","https://www.poetsgate.com/ViewPoem.aspx?id=198462",""],[5431,"دثرتني بنورها صنعاءُ...","https://www.poetsgate.com/ViewPoem.aspx?id=200425",""]],"verses":[["آهِ، قَلبي اليومَ يُخْفِي دَمعةً","هل رأيْتُمْ دَمعاتٍ في الخَفا",0,"ف",2,0],["آه قد ذُبْتُ غراماً وجوى","وعدمت الصّبرَ وعداً وانتظارا",1,"ر",2,0],["آه قد أدركت سر ال","حسن في ورد الخدود",2,"د",1,0],["آهٍ قَدْ شيلَ رَأْسُهُ بِقَناةِ","مُطْرَحاً جِسْمُهُ بِأَرْضِ فَلاةِ",3,"ه",1,0],["آه قد جئتَ بعد وقتك يا خن","جر ويلاهُ ليتني كنتُ أعلم",4,"م",1,0],["آهَ... قَيْسٌ أيْنَ ليْلَا ؟!","فيْ هَوَاها القَلْبُ نَيْلَا",5,"ل",2,1],["آهِ قلبي فزّ انتفاضًا وخرّا","مثلَ زلزالٍ هزّني واسْتعرّا",6,"ر",2,1],["آهِ قلبي ممزقٌ من هزيعٍ","ليس يُرضي سوى المرايا الحقيره",7,"ر",2,0],["آهِ قلبي ملّوع ومعنّى","طال ليلٌ وغربةٌ وشقاءُ",8,"ا",2,0],["آه قلبي جراحها هل ستبقى","في نزيفٍ مطوّلٍ لا انتهاءُ",8,"ا",2,0]]}