{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[23,"وما اهتز عرش الله من موت هالك","https://www.aldiwan.net/poem21575.html","الطويل"],[51,"رأيتك لا تلذ لطعم شيء","https://www.aldiwan.net/poem7982.html","الوافر"],[51,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[85,"إلى ابن محمد أهدي كتابي","https://www.aldiwan.net/poem7792.html","الوافر"],[43,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[45,"أناة أيها الفلك المدار","https://www.aldiwan.net/poem63597.html","الوافر"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10371","الطويل"],[90,"بين الأحبة والبدر","https://www.poetsgate.com/ViewPoem.aspx?id=178942",""],[126,"ألا إنما دنياكم مثل حية","https://www.aldiwan.net/poem50483.html","الطويل"],[140,"أيا ولد الحصين وما حصين","https://www.aldiwan.net/poem58367.html","الوافر"],[140,"أؤمل بعد هذا الأسر حلا","https://www.aldiwan.net/poem58406.html","الطويل"],[364,"وددت لو ان القلب كان لساني","https://www.aldiwan.net/poem17123.html","الطويل"],[413,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[413,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[413,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[451,"شربنا مذاب النار بعد فكاكها","https://www.aldiwan.net/poem61705.html","الطويل"],[456,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[456,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[459,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[513,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[556,"يا طالبا للحجر المكرم","https://www.aldiwan.net/poem34086.html","الرجز"]],"verses":[["وَما أَهوى مُصافَحَةَ الغَواني","إِذا اِشتَغَلَت بَناني بِالعِنانِ",0,"ن",1,0],["وَمَا اهْتَزَّ قَدٌّ لِلْغُصُونِ مُرَنِّحٌ","وَمَا افْتَرَّ ثَغْرٌ لِلْبُرُوقِ شَنِيبُ",1,"ب",1,0],["وَمَا أَهَابَتْ بِجُنْدِ اللهِ فَاصْطَدَمَتْ","كَتَائِبُ الغِيَرِ الدَّهْمَاءِ بِالشُّهُبِ",2,"ب",1,0],["وما أهل البلاد سوى عيالٍ","على العمل الذي هم يحسنونا",3,"ن",2,0],["وما اهتزاز الأثير إلا","عُلالة نزرة الجلاء",4,"ا",2,0],["وَما اِهتَزَّ عَرشُ اللَهَ مِن مَوتِ هالِكٍ","سَمِعنا بِهِ إِلّا لِسَعدٍ أَبي عَمرِ",5,"ر",1,1],["وما أُهدي إليك من امتياحي","أحبَّ إليك مِن حُسْن الثناءِ",6,"ا",2,0],["وما أهَّلوا بذري لِذاك وإن زكا","ولكن لكم خِيمٌ يُريع به البَذر",7,"ر",1,0],["وما أهدى له إلا فؤادي","وما بين الفؤاد من الصميم",8,"م",1,0],["وَما أَهداكِ لِلجَدوى عَلَيهِ","لَوَ أَنَّكِ تَقدِرينَ عَلى فَعالِ",9,"ل",1,0],["وَما أَهلُ المَنازِلِ غَيرُ رَكبٍ","مَطاياهُم رَواحٌ وَاِبتِكارُ",10,"ر",1,0],["وَما أَهلُ التَحَنُّؤُ وَالتَحَلّي","إِلى أَهلِ التَحَلُوِّ وَالتَحَنّي",11,"ي",1,0],["وما اهْتَزَّ بابُ السِّجْنِ إِلا تَفَطَّرتْ","قُلُوبٌ لنا خَوْف الرَّدى وكُبُودُ",12,"د",1,0],["وَما أَهلُ طَودٍ مُكفَهِرٍّ حُصونُهُ","مِنَ المَوتِ إِلّا مِثلُ مَن حَلَّ بِالصَحرِ",13,"ر",1,0],["وما أهون الآلام لو كان سرُّها","يباح ، ولكن أحمل الوجد والصبرا",14,"ر",2,0],["وما أهلُها إلا كمِثْلِ مُسافر","إلى داره الأخرى وعَرَّسَ فيها",15,"ي",3,0],["وما أهجوك أنك أهلُ هجوٍ","ولكنّى أجرِّبُ فيكَ ضربي",16,"ي",1,0],["وما أهوىَ سوى البَيداء داراً","وأفراساً تَضيعُ بها وإبلا",17,"ل",2,0],["وَما أَهمَلَ الدَمعَ الَّذي هُوَ هاملٌ","بَريءٌ مِنَ الإِهمالِ وَالهَمَلانِ",18,"ن",1,0],["وما أهنا شموسَ الراح تترى","وقد أخَذَتْ عن البدر التمام",19,"م",1,0],["وما أَهنا المدام بكفِّ ساقٍ","كمثل البدر أشرق واستنارا",20,"ر",2,0],["وما أهرقت من دمع كريم","جرى من لوعة الوجد اللئيم",21,"م",1,0],["وما أُهدرت إلاّ وفي دمنا لها","حقوق وأحكامٌ على الجبنِ والغدر",22,"ر",1,0],["وما أهلَّ وسعى","مزدلِفٌ معرِّفُ",23,"ف",1,0],["وما أهلوكِ يومَ خلوتِ منهم","بأوّلِ غَدرةٍ للدهر عندي",24,"ي",1,0],["وما أهديته من صفو ودي","فليس مدى الزمان بمستعاد",25,"د",1,0],["وما أهون الدنيا عليك وإنها","لتكبر في عين الملوك وتعظم",26,"م",1,0],["وما اهتدوا منها إلى شيء ولا","فاز بها سوى الشجاع الضيغم",27,"م",1,0]]}