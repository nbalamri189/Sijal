{"poems":[[55,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[90,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[90,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[23,"وما اهتز عرش الله من موت هالك","https://www.aldiwan.net/poem21575.html","الطويل"],[53,"رأيتك لا تلذ لطعم شيء","https://www.aldiwan.net/poem7982.html","الوافر"],[53,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[87,"إلى ابن محمد أهدي كتابي","https://www.aldiwan.net/poem7792.html","الوافر"],[45,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[47,"أناة أيها الفلك المدار","https://www.aldiwan.net/poem63597.html","الوافر"],[48,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10371","الطويل"],[92,"بين الأحبة والبدر","https://www.poetsgate.com/ViewPoem.aspx?id=178942",""],[132,"ألا إنما دنياكم مثل حية","https://www.aldiwan.net/poem50483.html","الطويل"],[146,"أيا ولد الحصين وما حصين","https://www.aldiwan.net/poem58367.html","الوافر"],[146,"أؤمل بعد هذا الأسر حلا","https://www.aldiwan.net/poem58406.html","الطويل"],[371,"وددت لو ان القلب كان لساني","https://www.aldiwan.net/poem17123.html","الطويل"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[422,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[422,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[458,"شربنا مذاب النار بعد فكاكها","https://www.aldiwan.net/poem61705.html","الطويل"],[463,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[463,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[466,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[520,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[563,"يا طالبا للحجر المكرم","https://www.aldiwan.net/poem34086.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112857","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76613","المتقارب"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77394","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21631","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100408","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115656","الطويل"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138837",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76463","الطويل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99151","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78358","الوافر"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18798","البسيط"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147523","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4578,"أصم ناعيك سمع الفضل حين نعى","https://www.poetsgate.com/ViewPoem.aspx?id=49472",""],[4902,"ياصغير مايكبرني لقب","https://www.poetsgate.com/ViewPoem.aspx?id=22586",""],[4929,"اصوغ الشعر عن نبضي انتطاقا","https://www.poetsgate.com/ViewPoem.aspx?id=202455",""],[4478,"لئنْ أقمتُ بحيثُ الفيضُ في رجبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=15023",""],[5536,"سيف دولتنا عليا !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76355&r=&rc=33",""]],"verses":[["وَما أَهوى مُصافَحَةَ الغَواني","إِذا اِشتَغَلَت بَناني بِالعِنانِ",0,"ن",1,0],["وَمَا اهْتَزَّ قَدٌّ لِلْغُصُونِ مُرَنِّحٌ","وَمَا افْتَرَّ ثَغْرٌ لِلْبُرُوقِ شَنِيبُ",1,"ب",1,0],["وَمَا أَهَابَتْ بِجُنْدِ اللهِ فَاصْطَدَمَتْ","كَتَائِبُ الغِيَرِ الدَّهْمَاءِ بِالشُّهُبِ",2,"ب",1,0],["وما أهل البلاد سوى عيالٍ","على العمل الذي هم يحسنونا",3,"ن",2,0],["وما اهتزاز الأثير إلا","عُلالة نزرة الجلاء",4,"ا",2,0],["وَما اِهتَزَّ عَرشُ اللَهَ مِن مَوتِ هالِكٍ","سَمِعنا بِهِ إِلّا لِسَعدٍ أَبي عَمرِ",5,"ر",1,1],["وما أُهدي إليك من امتياحي","أحبَّ إليك مِن حُسْن الثناءِ",6,"ا",2,0],["وما أهَّلوا بذري لِذاك وإن زكا","ولكن لكم خِيمٌ يُريع به البَذر",7,"ر",1,0],["وما أهدى له إلا فؤادي","وما بين الفؤاد من الصميم",8,"م",1,0],["وَما أَهداكِ لِلجَدوى عَلَيهِ","لَوَ أَنَّكِ تَقدِرينَ عَلى فَعالِ",9,"ل",1,0],["وَما أَهلُ المَنازِلِ غَيرُ رَكبٍ","مَطاياهُم رَواحٌ وَاِبتِكارُ",10,"ر",1,0],["وَما أَهلُ التَحَنُّؤُ وَالتَحَلّي","إِلى أَهلِ التَحَلُوِّ وَالتَحَنّي",11,"ن",2,0],["وما اهْتَزَّ بابُ السِّجْنِ إِلا تَفَطَّرتْ","قُلُوبٌ لنا خَوْف الرَّدى وكُبُودُ",12,"د",1,0],["وَما أَهلُ طَودٍ مُكفَهِرٍّ حُصونُهُ","مِنَ المَوتِ إِلّا مِثلُ مَن حَلَّ بِالصَحرِ",13,"ر",1,0],["وما أهون الآلام لو كان سرُّها","يباح ، ولكن أحمل الوجد والصبرا",14,"ر",2,0],["وما أهلُها إلا كمِثْلِ مُسافر","إلى داره الأخرى وعَرَّسَ فيها",15,"ي",3,0],["وما أهجوك أنك أهلُ هجوٍ","ولكنّى أجرِّبُ فيكَ ضربي",16,"ب",2,0],["وما أهوىَ سوى البَيداء داراً","وأفراساً تَضيعُ بها وإبلا",17,"ل",2,0],["وَما أَهمَلَ الدَمعَ الَّذي هُوَ هاملٌ","بَريءٌ مِنَ الإِهمالِ وَالهَمَلانِ",18,"ن",1,0],["وما أهنا شموسَ الراح تترى","وقد أخَذَتْ عن البدر التمام",19,"م",1,0],["وما أَهنا المدام بكفِّ ساقٍ","كمثل البدر أشرق واستنارا",20,"ر",2,0],["وما أهرقت من دمع كريم","جرى من لوعة الوجد اللئيم",21,"م",1,0],["وما أُهدرت إلاّ وفي دمنا لها","حقوق وأحكامٌ على الجبنِ والغدر",22,"ر",1,0],["وما أهلَّ وسعى","مزدلِفٌ معرِّفُ",23,"ف",1,0],["وما أهلوكِ يومَ خلوتِ منهم","بأوّلِ غَدرةٍ للدهر عندي",24,"د",2,0],["وما أهديته من صفو ودي","فليس مدى الزمان بمستعاد",25,"د",1,0],["وما أهون الدنيا عليك وإنها","لتكبر في عين الملوك وتعظم",26,"م",1,0],["وما اهتدوا منها إلى شيء ولا","فاز بها سوى الشجاع الضيغم",27,"م",1,0],["وما أهوى حراماً لا","معاذَ الله في الدين",28,"ن",1,0],["وما اهتز غصن أو نحى الباب قاصد","وما جن ليل أو شجى صوت ألحان",29,"ن",1,0],["وما اهلُها إلا أبو القاسم الّذي","من الفرض ان يُثني عليه ويمدحا",30,"ح",2,0],["وما اهتجت إلا وقد هيجت","ك دواع الى البلد النارح",31,"ح",1,0],["وَما اِهتَزَّتِ الأَغصانُ إِلّا لِأَنَّها","تُصَلّي فَمِنها ما يَقومُ وَيَركَعُ",32,"ع",1,0],["وَما أَهلُ الشَويِّ لَنا بِأَهلٍ","وَلا راعي المَخاضِ لَنا بِراعِ",33,"ع",1,1],["وما اهتزَّ منه العطف الا لحينه","تشحَّط مقتول وخرَّ طعين",34,"ن",1,0],["وما اهتزّت الأغصانُ إلا وهزني","لحسن القدود الهيف وجد وإشفاق",35,"ق",1,0],["وما أهداكها السبعي إلاّ","لتشفع في جرائِمه القباح",36,"ح",1,0],["وَما أَهل لَيلى بين ذاكَ سشوى امرىء","يرى العَيش اوصابا واخر مبهما",37,"م",2,0],["وما اهتزت غصون الروض الا","تمنّت حسن قدّك في القدود",38,"د",1,0],["وَما أَهدت صبا الاِسحار نَوما","اِلى عَين غَدَت في أَسر غين",39,"ن",1,0],["وَما أَهَلَّ بِهِ الداعي وَما وَقَفَت","عُليا رَبيعَة تَمي بِالحَصا الحَصَبا",40,"ب",2,0],["وما اهتز من قناتك غصنها","ولا فاض إلا من حسامك نهرها",41,"ر",3,0],["وَما اِهتَزَّ من قَدِّ قَنا تَحتَ طَلعَةٍ","مِنَ البَدرِ أَبدَت أَم خَبَتها البَراقِعُ",42,"ع",1,0],["وما اهتدى للمعاني من يؤرخه","بهديه لجنان الخلد قد رفعا",43,"ع",2,0],["وما أهاب ولا يزلزلني غضب","الشجاعة ورث والعاقل غزير",44,"ر",1,0],["وما أهرقت وجهي فيه ماءً","ولا أطمثتُ إيماني نفاقا",45,"ق",2,0],["وما أهل به الداعي وما وقفتْ","عُليا ربيعة تزمي بالحصا الحصبا",46,"ب",2,0],["وما أهديتني إلا جراحاً","وما سددت إلا سمهريا",47,"ي",2,0]]}