{"poems":[[3,"فؤاد لا يسليه المدام","https://www.aldiwan.net/poem206.html",""],[88,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[53,"وفي أربع مني خلت منك أربع","https://www.aldiwan.net/poem8667.html","الطويل"],[47,"ألم تر تغليس الربيع المبكر","https://www.aldiwan.net/poem63604.html","الطويل"],[47,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[46,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[50,"كتمت الحب يا حكم","https://www.aldiwan.net/poem65230.html","مجزوء الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[47,"وفي أربع مني حلت منك أربع","https://www.poetsgate.com/ViewPoem.aspx?id=33078",""],[98,"أندونيسيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66469&r=&rc=145",""],[275,"دهاني يا غزالة ما دهاك","https://www.aldiwan.net/poem35233.html","الوافر"],[275,"تصباك ما في النجم من لمعات","https://www.aldiwan.net/poem35636.html","الطويل"],[280,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[309,"لله أحبابنا بالأبرق العلم","https://www.aldiwan.net/poem16893.html","البسيط"],[382,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[435,"يا رب عفوا فإني","https://www.aldiwan.net/poem39827.html","المجتث"],[556,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126842","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86691","البسيط"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18510","المتقارب"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70745","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141269","المتقارب"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2250,"","https://poetry.dctabudhabi.ae/diwan/poem/145173","الوافر"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143182","الوافر"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123450","الطويل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123451","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137303",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99440","السريع"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145115","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94464","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72799","الطويل"],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[4927,"الشهيد محمود بن عبد الرزاق الدغيم","https://www.poetsgate.com/ViewPoem.aspx?id=79607",""],[5605,"القول تصدقه الفعال","https://www.poetsgate.com/ViewPoem.aspx?id=160027",""],[5612,"رسولَ اللهِ ضاعَ الحُبُّ مِنّا","https://www.poetsgate.com/ViewPoem.aspx?id=179714",""],[6225,"عَولَمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80968&r=&rc=237",""]],"verses":[["وَفي أَرضِ الحِجازِ خِيامُ قَومٍ","حَلالُ الوَصلِ عِندَهُمُ حَرامُ",0,"م",1,0],["وَفي أَرضِ يونانَ شاهَدتُهُ","فَأَيُّ جَمالٍ إِلَيهِ اِنتَهى",1,"ا",1,0],["وفي أربعٍ منّي خَلَتْ منك أربعٌ","فلستُ بدارٍ أيَّها هاجَ لي كربي",2,"ي",1,1],["وَفي أُرجُوانِيٍّ مِنَ النورِ أَحمَرٍ","يُشابُ بِإِفرِندٍ مِنَ الرَوضِ أَخضَرِ",3,"ر",1,0],["وَفي أَرضِ الدَيالِمِ هامُ قَتلى","نِظامُ السَهلِ مِنها وَالحُزونِ",4,"ن",1,0],["وَفي أَرشَقِ الهَيجاءِ وَالخَيلُ تَرتَمي","بِأَبطالِها في جاحِمٍ مُتَوَقِّدِ",5,"د",1,0],["وَفي أَردافِها ثِقَلٌ","وَفي أَترابِها هَضَمُ",6,"م",1,0],["وفي أرضها أَو أفقها صوتُ مُحْنَقٍ","كأنَّ صداهُ الغيبُ لو يتكلّمُ",7,"م",1,0],["وفي أربع مني حلت منك أربع","فما أنا أدري أيها هاج لي كربي",8,"ي",1,1],["وفي أراضها أو أفقها صوت محنق","كأنّ صداه الغيب ، لو يتكلّم !",9,"م",1,0],["وفي أرضِ الأعاجمِ طالَ أسري","فهَل هذا الأسارُ بلا فكاك",10,"ك",1,0],["وفي أربُعِ الأمواتِ أذكرُ موقفي","على تُرَبٍ مَحجوجةٍ ورفات",11,"ت",1,0],["وفِي أَرْساغِها أرَنٌ إلَى مَنْ","طَلَبْتَ بِها ولَوْ يَأْوِي لِسَرْغِ",12,"غ",1,0],["وفي ارضا بقضاء اللَه سيدنا","الخير للعبد والأرزاق بالقسم",13,"م",1,0],["وفي أردنِ ابنِ اللَه قمتُ مسبِّحاً","على نهره من فخره المتدارك",14,"ك",1,0],["وفي ارتكاب المعاصي","انفقت مدة عمري",15,"ر",2,0],["وَفي أَرجاءِ دِجْلَةَ مؤْبِداتٌ","وَأَدواءٌ تريد لَها عِلاجا",16,"ج",2,0],["وفي أرضِ الحِجازِ لهم قديماً","لواءٌ كان مرتفع الدعامِ",17,"م",1,0],["وفي إرثه سر عليه سترته","وفي حكم إيثاري إليّ رددته",18,"ه",1,0],["وَفي اِرتِقاك العلا قالت مُؤرخةً","محمد حافظ الدِيوان مَحمود",19,"د",1,0],["وَفي أَربَعينَ تَوَفَّيتُها","وَعَشرٍ مَضَت لي مُستَبصَرُ",20,"ر",1,0],["وفي أرض أهلِ الجودِ كلُّ غمامةٍ","غوادٍ تُرَوِّى أرضَهم وروائح",21,"ح",1,0],["وفي أرضنا تزأر النّائبات","وتهدر جيّاشةً كالبحور",22,"ر",1,0],["وفي أرشه إن صم كلم معلناً","وكلم مولاهُ الذي يتوكل",23,"ل",1,0],["وفي أرض الجزائر هام قلبي","بمعسول المراشف كوثري",24,"ي",1,0],["وفي أرض العراق بلاد يمن","وحيث حللت بالبلد الحرام",25,"م",1,0],["وفي آربرني لا تسل كيف حالهم","ألم تسمع الأنعام قد صادمت نمرا",26,"ر",2,0],["وفي اري برني منهم كل خادرٍ","وفي قلعة السلطان جيش معضدُ",27,"د",1,0],["وفي ارض كولمب تنور ضؤها","مناجيب من لبنان غر المناقب",28,"ب",1,0],["وَفي اِرتوائي إِلى ذر بزمزم ما","يلفى لبدن مِنهُ وَهوَ مَهزولُ",29,"ل",1,0],["وفي ارتجاج الردف داعٍ إلى","نونٍ وياءٍ قبل ما كاف",30,"ف",1,0],["وفي أرضها شب الرسول محمد","ومن أفقها انبث الهدى يتفجر",31,"ر",1,0],["وفي أرزه السامي الممرَّد في العلا","علائم فخرٍ أبهرت شاسع البعدِ",32,"د",1,0],["وفي أرضهِ قطُب المجرةِ قد جرت","زواهرُهُ في صحنِ ساحتِهِ جريا",33,"ي",2,0],["وفي أربي سرٌ يدقُّ عن النُّهى","هو القصد من ارسال هذي القصيدة",34,"ه",1,0],["وَفِيْ أَرْضِ الْمَعَرَّةِ ثَاْرَ شَعْبٌ","وَقَاْدَ الزَّحْفَ أَبْطَاْلٌ كِرَاْمٌ",35,"م",1,0],["وفي أرض الجنوب لنا رجال","وهذا الغرب مَيَّزَهُ النِضَالُ",36,"ل",1,0],["وفي أرْضِ الحِجازِ يلوحُ غيْمٌ","وفي مِصْرَ الخِلافُ والافْتِراقُ",37,"ق",1,0],["وفي أرض النبوَّةِ في","فلسطين الدِّما بحرُ",38,"ر",1,0]]}