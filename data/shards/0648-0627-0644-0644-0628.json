{"poems":[[90,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[48,"سمى ابنه أسدا وليس بآمن","https://www.aldiwan.net/poem22104.html","الكامل"],[48,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[48,"جنت الغوارس واستقل أخو الغني","https://www.aldiwan.net/poem22806.html","الكامل"],[48,"نفس الفتى وليست له جسدا","https://www.aldiwan.net/poem23148.html","الكامل"],[48,"خير وشر وليل بعده وضح","https://www.aldiwan.net/poem23521.html","البسيط"],[48,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[173,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[230,"أهجر النوم في طلاب العلاء","https://www.aldiwan.net/poem55222.html","الخفيف"],[266,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[309,"يا نسيم الأسحار","https://www.aldiwan.net/poem16906.html","عموديه"],[366,"ان من يحفظ المودة أحرى","https://www.aldiwan.net/poem68108.html","الخفيف"],[408,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[484,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117106","الخفيف"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131333","الرجز"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199820","المسحوب"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91864","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[6144,"النشال","https://www.poetsgate.com/ViewPoem.aspx?id=21684",""]],"verses":[["واللبيب الذي تعلَّم إتيا","ن المعالي من خسّة الأوغاد",0,"د",1,0],["وَاللُبُّ حاوَلَ أَن يُهَذِّبَ أَهلَهُ","فَإِذا البَرِيَّةُ ما لَها تَهذيبُ",1,"ب",1,0],["وَاللُبُّ حارَبَ فينا","طَبعاً يُكابِدُ حَربَه",2,"ب",2,0],["وَاللُبُّ حُرفٌ وَالجَهالَةُ نِعمَةٌ","وَالكَيّسُ الفَطِنُ الشَقيُّ الكائِسُ",3,"س",1,0],["وَاللُبُّ يَحمِلُ مِن هَواجِسِهِ","ما لَيسَ ناهِضَةً بِهِ البُزلُ",4,"ل",1,0],["وَاللُبُّ حارَبَ تَركيباً يُجاهِدُهُ","فَالعَقلُ وَالطَبعُ حَتّى المَوتِ خَصمانِ",5,"ن",1,0],["واللّبيبُ اللّبيبُ مَنْ لَيسَ يَغْترْ","رُ بِكُوْنٍ مَصيرُهُ للفَسادِ",6,"د",1,0],["وَاللَّبيبُ الحُرُّ لا يَخدَعُهُ","لمَعانُ الآلِ عَن حِفظِ المَزادِ",7,"د",1,0],["وَاللَبيبُ اللَبيبُ مَن دارَ في الأَر","ضِ لِعلمٍ يناله أَو ثَراء",8,"ا",2,0],["واللبيب الأريب من كان للأمرين","كفواً وباذل النفس كفو",9,"و",1,0],["واللَبن والأحجار","من تحت لطف اللَه خير غفار",10,"ر",1,0],["وَاللَبيب الاديب ذو العَقل وَالفَض","ل لَدَيه التَمويه لَم يَستَمِرّا",11,"ر",2,0],["واللّبْثُ عندَكَ لم يَطلْ لِمَلاَلةٍ","أيَملّ عَذْبَ الماءِ قلبُ الصَّادي",12,"د",2,0],["واللبس من الخلق المحمود ضافية","تنسل إليك الورى من كل ما حدب",13,"ب",1,0],["واللبس فيه موجب التأخير","عند استواء العرف والتنكير",14,"ر",1,0],["واللبيب اللبيب جد عليم","بسجايا هذا الزمان المريب",15,"ب",1,0],["والُّلبُّ مِنّي ناطفٌ مُحَيَّرُ","وإنّني طولَ المَدى مُسَيَّرُ",16,"ر",1,0],["واللّبس سيدي نكلس الطّوق","في جيده إيهلك العشاق",17,"ق",1,0],["واللبن المروب الظريف","ورحت صاح للقصير تجري",18,"ي",1,0],["وَاللَّبيبُ الَّذي يحير جَواباً","يَحسَبُ الكُلَّ إِسوَةً في الخِبالِ",19,"ل",1,0],["وَاللَّبيبُ اللَّبيبُ مَن خافَ يَوماً","وَاِتَّقى اللَّهَ في جَميلِ الفعالِ",19,"ل",1,0],["وَاللبيب اللبيب من دار في الدن","يا بما يُرتَضَى من الإنسان",20,"ن",1,0],["واللب يثمر ما اجتلاك فإن تَبِنْ","عنه حُلاكَ فكل لب عاقر",21,"ر",1,0],["واللبيب اللبيب من عرف الح","ق فوفى لخصمه وأخيه",22,"ي",2,0],["واللبة من صدرها يخطفها بزرارها","آدي اللي ناسياه قوانينها ودستورها",23,"ر",3,0]]}