ps://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5764,"حديث نفس","https://www.poetsgate.com/ViewPoem.aspx?id=161806",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[5897,"بين رمضان والعيد","https://www.poetsgate.com/ViewPoem.aspx?id=156847",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[5938,"ثمانية قام الوجود بها فهل","https://www.poetsgate.com/ViewPoem.aspx?id=181423",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["بِهِنَّ فُلولٌ مِن وَريدي عُتَيبَةٍ","وَنَضخُ نَجيعٍ مِن ذُؤابِ بنِ قارِبِ",0,"ب",1,0],["بِهِ نَظَمَ اللهُ الشَّتَاتَ فَأَصْبَحَتْ","نُفُوسُ الْبَرَايَا وَهْيَ آمِنَةُ السِّرْبِ",1,"ب",1,0],["بِهِندٍ وَهِندٌ هَمُّهُ غَيرَ أَنَّها","تَرى البُخلَ وَالعِلّاتِ في الوَعدِ مَغنَما",2,"م",2,0],["بِهِنَّ يُعِزُّ اللَهُ حينَ يُعِزُّنا","وَإِن كانَ أَمرٌ يا سَخينَ فَظيعُ",3,"ع",1,0],["بِهِنَّ نَعامٌ بَناها الرِجا","لُ تُبقي النَفائِضُ فيها السَريحا",4,"ح",2,0],["بهنَّ له عَليَّ عظيم فضل","يقصِّر دونه شكري العظيم",5,"م",1,0],["بِهِنَّ يُباهي بَطنُ حَوّاءَ وَاِحتَوى","عَلَيهُنَّ بَطنُ الأَرضِ وَهوَ فَخورُ",6,"ر",1,0],["بِهِنَّ وَما يَدرينَ ما الذَنبُ خَشيَةٌ","وَمِن عَجَبٍ تَخشى الخَطيئَةَ حورُ",6,"ر",1,0],["بِهِ نِلتُ مِن حَظّي الَّذي نِلتُ أَوَّلاً","وَأَدرَكتُ ما قَد كُنتُ أَدرَكتُ مِن خَصمي",7,"م",2,0],["بِهِنَّ لَقوا بِمَكَّةَ مُلحِديها","وَمَسكِنَ يُحسِنونَ بِها الضَرابا",8,"ب",2,0],["بِهِنَّ نَكَحنا غالِياتِ نِسائِنا","وَكُلُّ دَمٍ مِنّا عَلَيهِنَّ واجِبِ",9,"ب",1,0],["بِهِنَّ يُحابونَ أَختانَهُم","وَيَشفونَ كُلَّ دَمٍ مُقصَدِ",10,"د",1,0],["بِهِنَّ لَقوا بِالعَرضِ أَصحابَ خالِدٍ","وَلَو كانَ غَيرَ الحَقِّ لاقوا لَأُنكِرا",11,"ر",2,0],["بِهِنَّ المُدلَجونَ بَدَوا وَساروا","وَإِيّاهُنَّ يَتبَعُ كُلُّ مَجرِ",12,"ر",1,0],["بِهِندِيَّةٍ بيضٍ إِذا ما تَناوَلَت","مَكانَ الصَدى مِن رَأسِ عاصٍ تَجَعجَعا",13,"ع",2,0],["بِهِنَّ شَفى الرَحمَنُ صَدري وَقَد جَلا","عَشا بَصَري مِنهُنَّ ضَوءَ ظَلامِ",14,"م",1,0],["بِهِندٍ وَأَترابٍ لِهِندٍ إِذِ الهَوى","جَميعٌ وَإِذ لَم نَخشَ أَن يَتَصَدَّعا",15,"ع",2,0],["بِهِ نُطَفٌ زُرقٌ قَليلٌ تُرابُها","جَلا الماءُ عَن أَرجائِها فَهوَ حائِرُ",16,"ر",1,0],["بِهنانَةٌ خُلِقَت أُنثى مُؤَنَّثَةً","إِذ في الكَثيرِ مِنَ النِسوانِ تَذكيرُ",17,"ر",1,0],["به نصرةُ الأحساب إن قام داغِلٌ","يفاخره أو ذو لسان يجادل",18,"ل",1,0],["بِهِ نَطحَرُ الأَقذاءَ عَن سَرَياتِنا","وَنَلقى إِذا نَأبى الجِنانَ تَغَرَّدا",19,"د",2,0],["بِهِنَّ أُدينُ مَن يَبغي أَذاتي","مُدايَنَةَ المُدايِنِ فَليَدَنّي",20,"ن",2,0],["بهن دروء من نحاز وغدة","لها ذربات كالثدي النواهد",21,"د",1,0],["بهنّ يلتفُّ مُرتقىً وَيُرى","ينشقُّ عنهنَّ فيه مُنحدَرُ",22,"ر",1,0],["بِهِ نَصَرَ الوَهْمُ الحَقِيقَةَ نُصْرَةً","تُضِيءٌ نُجُوماً مِنْ فُضُولِ ثِقَابِ",23,"ب",1,0],["بِهِنَّ تَنْأَى تُخُومُ مِصْرٍ","إلى النِّهَايَاتِ فِي الفَضَاءِ",24,"ا",2,0],["بِهِنَّ أَبَدْنَا جَمْعَهُم فتبدّدوا","وكانَ يُلاقي الحَيْنَ مَنْ هُوَ فاجرُ",25,"ر",1,0],["بهن تركت الالف رغما وانه","لترك حياة النفس بين شعابها",26,"ب",3,0],["بهنَّ ولا بغلاظِ الرقابِ","قِباحِ الوجوهِ خِباثِ الكُلى",27,"ا",1,0],["بهندٍ، وأترابٍ لهندٍ، إذِ الهوى","جميعٌ، وإذ لم يخشَ أن يتصدعا",28,"ع",2,0],["به نهنيك لفظا والهناء له","معنا لأنك لو لم تبد لم يرق",29,"ق",1,0],["به نفرةٌ من دَنايا الأمورِ","كما ذَعَر السربَ نَبعٌ أرَنْ",30,"ن",1,0],["بِهِنَّ مِنَ الدَّاءِ الّذِى أنا عارفٌ","وَلا يَعرِفُ الأَدواءَ إِلاّ طَبِيبُهَا",31,"ب",3,0],["بهِ نالَهم كالسامريّة فتنةٌ","ولكِن محلّ العجلِ قَد عَبَدوا الثورا",32,"ر",2,0],["بَهنانَةٌ يَتستَعيرُ القَومَ أَعيُنَهُم","حَتّى تَرُدِّ إِلى ذي النيقَةِ البَصَرى",33,"ر",2,0],["به نزل الروح الأمين مصدقاً","على قلب عبد كان بالحق يصدع",34,"ع",1,0],["بِهِ نُصِرَ الإِسلامُ حَتّى كَأَنَّما","أَتى الناسَ مِن بَعدِ الرَّسولِ رَسولُ",35,"ل",1,0],["بِهِنَّ تَحوي سُبِيّاً ثُمَّ تَقسِمُها","كَما يَصِيدُكَ وَحشَ القَفرَةِ الفَرَسُ",36,"س",1,0],["بِهِنَّ شُموسُ الحُسنِ تَمسي غَوارِباً","وَفيهِنَّ أَقمارَ السُعودِ طَوالِعُ",37,"ع",1,0],["بِهِ نالَ عزا وَاِفتِخارا وَسوددا","وَمَجداً بِه صَعب الحَديد يَلين",38,"ن",1,0],["بهِنَّ يَهدِيهمُ","إلى سَبيلِ الرَّشاد",39,"د",1,0],["بِهِنَّ قَتَلنا من نزارٍ حُماتَها","فما إِن ترى إلَّا ذليلاً وتاعِسا",40,"س",2,0],["به نُصِبَتْ خيامُ الحبِّ، فيها","من الأشواقِ والذِّكرى بريق",41,"ق",1,0],["به نتسلى عنهم بعد فقدهم","وما مات من أبقى إماماً معظما",42,"م",2,0],["بهنَّ غذاء للعقولِ وشِرْعَةٌ","تسوغ وتصفو عندهنَّ المشاربُ",43,"ب",1,0],["به نصر الإسلام في كل توطن","وحلّت بأهل الزيغ منه القواصمُ",44,"م",1,0],["بِهِنَّ شَعَبْتَ عِصِيَّ الشِّقاقِ","وعنهُنَّ أَوْضَحْتَ سُبْلَ الرَّشادِ",45,"د",1,0],["به نفرةٌ من سَرجه ولجامه","لفقدك مع لينٍ لديه وإسهالِ",46,"ل",1,0],["بهنْديٍّ إِلى مدْحي تَرقَّوْا","وقد يُهْدي بخِرِّيتٍ فَريقُ",47,"ق",1,0],["به نبتت رياض ناضرات","تنافح زهرها والثمر ريف",48,"ف",1,0],["به نشر الندى من بعد طي","وأنشر دارس الكرم المحيل",49,"ل",1,0],["بهنانةٌ ممكورةٌ خَمصانَةٌ","قد جرَّدتْ مِن لحظِها حُساما",50,"م",2,0],["بَهَنانَةٌ لَعوبٌ","غَرثى الوِشاحِ رُودُ",51,"د",1,0],["به نخاطب أهل الإتفاق على","سر عظيم من الأسرار مكتوم",52,"م",1,0],["بِهِ نَدوكَ المُترَفَ المُختالا","إِنَّ لَنا عِزّاً رَسا وَطالا",53,"ل",2,0],["بِهِنَّ أَهتَدي في سَيرِهِ كُلٌّ بارِجٍ","تَوَغَّلَ في بَحرِ الكِيانِ الَّذي طَمى",54,"م",2,0],["بِهِ نَجد الطوابي بِالمَدافعْ","وَبِالأَبس الَّذي يَخشاه طامعْ",55,"ع",1,0],["بِهِ نلت الهَنا وَسَمَوت عزاً","وَزدت بِهِ عَلى الأقيال قَدرا",56,"ر",2,0],["به نَاطَتْ عُرى آدا","بها البصرةُ والكوفَه",57,"ف",2,0],["بهنَّ رفعتَ من أعلامِ عِلْمٍ","ثَوَتْ دهراً منكَّسةَ الرؤوس",58,"س",1,0],["بهنّ كُلّ دَعيّ","نتفَ الزّرَازير يُنْتفْ",59,"ف",1,0],["بِهِ نَحْنُ فِي عَيْشٍ هَنِيءٍ وَنُزْهَةٍ","طَلُوعُ اللَّيَالي لَمْ يَدَعْ لَيْلَ شُبْهَةٍ",60,"ه",1,0],["بهن تجمعت الطيبات","بأشجارها وبأنهارها",61,"ر",3,0],["بِهِ نُصْرَةُ الأحْبَابِ إنْ قَامَ مَاجِدٌ","يُفَاخِرُهُ أوْ ذُو لِسَانٍ يُجَاوِبُ",62,"ب",1,0],["به نَضحُ حِنَّاء جديدٌ كأَنَّه","لما استشربَت منه الأَناملُ راعف",63,"ف",1,0],["به نظل في ظلال وسرر","لولاه كنا في ضلال وسعر",64,"ر",1,0],["به نعانق أحلاماً تراودنا","لا ينبت الحب من غير المحبينا",65,"ن",2,0],["به نجدُ الصيدَ الغريبَ ومنظراً","أنيقاً ورَخصاتِ الأناملِ خُرَّدا",66,"د",2,0],["بِهِ نَعشَ اللَهُ آمالنا","كَما نَعشَ الأَرض صَوبُ الحَيا",67,"ا",1,0],["بِهِنّ كُلومٌ بَينَ دَامٍ وجَالِبِ","رِيَاحٌ وَمَا فِيهَا جَنُوبٌ وَشَمأَلُ",68,"ل",1,0],["به نصر الله الخليفة منهم","وثبت ملكا كاد عنه يزول",69,"ل",1,0],["بِهِ نَدَعُ الكَمِيَّ عَلى يَدَيهِ","يَخِرُّ تَخالُهُ نَسراً قَشيبا",70,"ب",2,0],["به نرجوا علوا فوق خلق","عليه اللَه صلى ما دوايا",71,"ا",3,0],["به نلنا السعادةَ حينَ وافى","لنا من كُلِّ ما تمشي وِقاءُ",72,"ا",2,0],["بهِ نُسفت ثلثُ مدرَّعاتٍ","كمثل عصافةٍ بالريح تُذرى",73,"ر",2,0],["بِهِ نَصَّ النبيُ على عَليٍ","عليُ الطُهر مَولاهُ أراه",74,"ه",1,0],["بهندٍ وحبيها إذا الذكر عادني","تكاد بقلبي تذهب الخفقات",75,"ت",1,0],["بهنّ يصبح فكري","مغرى الفؤاد ويمسي",76,"س",2,0],["بِهَنا المُرتَضى اصطبحنا فملنا","كَالنشاوى إِذ عاقروا الخَندريسا",77,"س",2,0],["بِهِنَّ يُداني عَرضُ كُلِّ تَنوفَةٍ","يَموتُ صَدىً دونَ المِياهِ غُرابُها",78,"ب",3,0],["بَهنانَةٌ خَودٌ رزانٌ عقيلَةٌ","تُصمِي الكُماةَ بطعنةٍ نجلاءِ",79,"ا",2,0],["بِهنَّ وَإِن يَغدو بِقبضة مُغتال","جِهاد عَلى كَرّ الزَمان حَياتنا",80,"ن",2,0],["بِهنّ إِذا ما أَرهَفت يَوم تِجوال","إِذا لَم تَثوروا بِالحُسام المهنَّد",80,"د",1,0],["به نصبوا غايات عزو رفعة","فناهيك من رفع وناهيك من نصب",81,"ب",1,0],["به نفع الورى لا شك ينمو","وذكر علاه في مصر وشام",82,"م",1,0],["بِهِ نُسِخت كُتبُ النَحاةِ وَمُزِّقَت","فَصارَت هَباءً طارَ في كُلِّ أَراضِ",83,"ض",1,0],["بِهِ نُسِخت كُتبُ النحاةِ وَأُهمِلت","فَلَستَ تَرى يَوماً عَليهِنَّ رَونَقا",84,"ق",2,0],["بهنانة من حر نار بعادها","كاد الفؤاد من اللوافح يحرق",85,"ق",1,0],["بهنَّ اسيافُ أَجفانٍ قد اِمتزجت","مياهها بمياهِ الغنج والكَحل",86,"ل",1,0],["به نال موسى فضله يوم طوره","ورد له إذ خر بعض شعوره",87,"ه",1,0],["به نال ابليس الذي نال وارتدى","غداة تردّى الكبر بُرداً من الكفر",88,"ر",1,0],["به نال عباسٌ وخدمة جده","علاً لم ينله من تأخر او مضى",89,"ض",2,0],["به نار محمر الشقيق توقدت","ولولاه ما صاح الحمام من البرد",90,"د",1,0],["به نالتْ بنانُ يَدى وطالتْ","أَمامَ الزَّفِ قَادِمَتَا جَنَاحي",91,"ح",2,0],["به نجح المطالب والأماني","وليس ي