tml","البسيط"],[442,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[444,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[454,"سقت مستهلات الحيا المتضاعف","https://www.aldiwan.net/poem13843.html","الطويل"],[454,"كأن رقوم الضرب طير حوائم","https://www.aldiwan.net/poem13891.html","الطويل"],[460,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[463,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[463,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[463,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[463,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[463,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[463,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[463,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[466,"أوجداً وذياك الحمى ومنازله","https://www.aldiwan.net/poem3610.html","عموديه"],[479,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[484,"إن الأهاويل في جنب الوصول إلى","https://www.aldiwan.net/poem24293.html","البسيط"],[515,"كأن رقيبا منك يرعى خواطري","https://www.aldiwan.net/poem67698.html","البسيط"],[517,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[540,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[566,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[569,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[588,"ورب أحوى أحور لم يزل","https://www.aldiwan.net/poem17610.html","السريع"],[635,"","https://poetry.dctabudhabi.ae/diwan/poem/200377","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/124800","الطويل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20479","الوافر"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20471","البسيط"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18076","الطويل"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10414","الطويل"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/123615","الطويل"],[965,"","https://poetry.dctabudhabi.ae/diwan/poem/46009","الطويل"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18713","الطويل"],[1093,"","https://poetry.dctabudhabi.ae/diwan/poem/75808","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18982","الطويل"]],"verses":[["كأنّ رُواتي عَلَّموهُنَّ مَنطِقي","فهُنَّ إذا غَرَّدْنَ أنشَدْنَ أشعاري",0,"ر",2,0],["كَأَنَّ رِماحَهُم أَشطانُ بِئرٍ","لَها في كُلِّ مَدلَجَةٍ خُدودُ",1,"د",1,0],["كأنّ رَبيعاً كان للنّاسِ شهْرُهُ","رَبيعاً سَقاهُ عارضٌ منْكَ مُمْطِرُ",2,"ر",1,0],["كأنّ رؤوسَ القومِ عندَ صَلاتِهمْ","وقد أوْمأتُ للأرْضِ صُفْر شَواشِيها",3,"ي",3,0],["كَأَنَّ رِجلَيهِ مِن حُسنِ اِحمِرارِهِما","ما رَقَّ مِن شُعَبِ المَرجانِ فاِتَّسَعا",4,"ع",2,0],["كَأَنَّ رَحلي وَقَد لاَنَت عَريكَتُها","كَسَوتُهُ جَورَفاً أَقرابُهُ خَصِفا",5,"ف",2,0],["كَأَنَّ رَبَّكَ أَوْحَى أَنْ تُجَاوِرَهُ","حَتّى تَقَرَّ بِهِ فِي مُزْدَجَى القُرَبِ",6,"ب",1,0],["كَأَنَّ رِجلَيهِ رِجلاً مُقطِفٍ عَجِلٍ","إِذا تَجاوَبَ مِن بُردَيهِ تَرنيمُ",7,"م",1,0],["كَأَنَّ رِضابَهُ مِن ماءِ كَرمٍ","تَرَقرَقَ في الزُجاجِ وَقَد أَحالا",8,"ل",2,0],["كَأَنَ رَضيخَ المَروِ مِن وَقعِها بِهِ","خَذاريفُ مِن بَيضٍ رَضيخٍ رَضيضُها",9,"ض",3,0],["كَأَنَّ رَحلي وَقَد لانَت عَريكَتُها","عَلى أَحَمَّ أَجَمِّ الرَوقِ مَذعورِ",10,"ر",1,0],["كَأَنَّ رُسومَهُ بُسِطَت عَلَيها","ثِيابُ الوَشي أَو لَبِسَ النِمارا",11,"ر",2,0],["كَأَنَّ راكِبَها يَهوي بِمُنخَرِقٍ","مِنَ الجَنوبِ إِذا ما رَكبُها نَصِبوا",12,"ب",3,0],["كَأَنَّ رِجلَيهِ مِسماكانِ مِن عُشَرٍ","صَقبانِ لَم يَتَقَشَّر عَنهُما النَجَبُ",12,"ب",1,0],["كأنّ رياض الطَرس خدُّ مورّدٌ","يُطَرْزه وشيُ العذار من الحِبْرِ",13,"ر",1,0],["كأن رياح الجوّ عند هبوبها","تغنّي وهذا الموج في البحر يرقص",14,"ص",1,0],["كان ردءاً للحق مرتدي التق","وى فكانت طول الحياة لباسه",15,"س",2,0],["كَأَنَّ ريحَ المِسكِ مُستَحَمَّهُ","ما يَنبَغي لِلمُسلِمينَ ذَمُّهُ",16,"م",2,0],["كَأَنَّ رَبابَهُ الضُلّالَ فيهِ","نَعامٌ جافِلٌ لاقى نَعاما",17,"م",2,0],["كَأَنَّ رُسومَ الدارِ ريشُ حَمامَةٍ","مَحاها البِلى فَاستَعجَمَت أَن تَكَلَّما",18,"م",2,0],["كَأَنَّ رِياحَ اللَحمِ حينَ تَغَطمَطَت","رِياحُ عَبيرٍ بَينَ أَيدي العَواطِرِ",19,"ر",1,0],["كأن رغاءهن بكل فجٍّ","إذا أرتحلوا نوائح معولات",20,"ت",1,1],["كَأَنَّ ريحَهُمُ في الناسِ إِذ خَرَجوا","ريحُ الحِشاشِ إِذا ما بَلَّها المَطَرُ",21,"ر",1,0],["كَأَنَّ ريحَهُمُ في الناسِ إِذ بَرَزوا","ريحُ الكِلابِ إِذا ما بَلَّها المَطَرُ",22,"ر",1,0],["كأنَّ راحته الحسنى وأنمله","بحرٌ يمدُّ إلى العافين خلجانا",23,"ن",2,0],["كأن ربك لم يخلق لمسغبةٍ","سواهم من جميع الناس إنسانا",24,"ن",2,0],["كَأَنَّ رِحالَ المَيسِ حينَ تَزَعزَعَت","عَلى قَطَواتٍ مِن قَطا عالِجٍ حُقبِ",25,"ب",1,0],["كَأَنَّ رِجالَ الأَوسِ تَحتَ لَبانِهِ","وَما جَمَعَت جَلٌّ مَعاً وَعَتيبُ",26,"ب",1,0],["كَأَنَّ رَيطَةَ جَبّارٍ إِذا طُوِيَت","بَهوُ الشَراسيفِ مِنها حينَ تَنخَضِدُ",27,"د",1,0],["كَأَنَّ رِزَّ حُداةٍ في طَوائِفِهِم","نَوحَ الحَمامِ يُغَنّي غايَةَ العُشَرِ",28,"ر",1,0],["كان روض وكان زهر وصدا","ح فما منها اليوم شيء باق",29,"ق",1,0],["كأنّ رواية الأشواق عود","على بدء وما كمل الكتاب",30,"ب",1,0],["كَأَنَّ رَحيلي كانَ مِن كَفِّ طاهِرٍ","فَأَثبَتَ كوري في ظُهورِ المَواهِبِ",31,"ب",1,0],["كَأَنَّ رُؤوسَ أَقلامٍ غِلاظٍ","مُسِحنَ بِريشِ جُؤجُؤَةِ الصِحاحِ",32,"ح",1,0],["كَأَنَّ رَقيباً مِنكِ سَدَّ مَسامِعي","عَنِ العَذلِ حَتّى لَيسَ يَدخُلُها العَذلُ",33,"ل",1,0],["كَأَنَّ رِقابَ الناسِ قالَت لِسَيفِهِ","رَفيقُكَ قَيسِيٌّ وَأَنتَ يَمانِ",34,"ن",1,0],["كَأَنَّ رُكامَ الثَلجِ تَحتَ صُدورِها","جِبالٌ زَرودٍ كُثبُها تَتَرَبَّعُ",35,"ع",1,0],["كَأَنَّ رُؤوسَ الأَزدِ خُبطانُ حَنظَلٍ","تَخِرُّ عَلى أَكتافِهِم حينَ وَلَّتِ",36,"ت",1,0],["كَأَنَّ رِكابَنا في كُلِّ فَجٍّ","إِذا دَبَّ الكُحَيلُ مِنَ الغُرورِ",37,"ر",1,0],["كَأَنَّ رِجالَ الداعِرِيَّةِ تَحتَها","قِلاصُ نَعامٍ يَنتَحيها ظَليمُها",38,"م",3,0],["كَأَنَّ رِحالَ المَيسِ ضَمَّت حِبالُها","قَناطِرَ طَيِّ الجَندَلِ المُتَلاجِمِ",39,"م",1,0],["كأنَّ رماحَ الخَطِّ حولَ بيوتِهِم","على صَهَواتِ الخيلِ دُرّاً مُبَدَّدا",40,"د",2,0],["كَأَنَّ ريقَتَها بَعدَ الكَرى اِغتُبِقَت","مِن طَيِّبِ الراحِ لَمّا يَعدُ أَن عَتُقا",41,"ق",2,0],["كانَ رَسولُ اللَهِ يَدعو إِلى","مَدرَجَةِ الحَقِّ وَدارِ السَلام",42,"م",1,0],["كان رؤيا منام","طيفك المسحور",43,"ر",1,0],["كأنّ رُمْحَكَ في تصريفه قَلَمٌ","مجاولاً بطويل الذابل اليزَنِ",44,"ن",1,0],["كَأَنَّ رُماتَها تَفري فُؤادي","بِأَنفَذ ما تَريشُ مِنَ النِبالِ",45,"ل",1,0],["كَأَنَّ رُؤوسَ الصِيدِ لم تكُ خشَّعاً","لدى بابه المرجوِّ بالأمس حاجبُه",46,"ب",2,0],["كَأَنَّ رُباها لِلمَمالِكِ مِنبَرٌ","يَقومُ عَلَيهِ الدَهرُ يوسِعُها زَجرا",47,"ر",2,0],["كأَنّ رِماحَهُم سَيلٌ مُطِلٌّ","وأَمساكٌ بَأَيدي مُورِدينا",48,"ن",2,0],["كانَ رِزْقِي مِنْ جَدِّهِ وأبيه","أَيَّ رِزْقٍ مُيَسَّرٍ مَوْفورِ",49,"ر",1,0],["كأنّ رقيبَ النجمِ أجدَلُ مَرْقَبٍ","يُقلِّبُ تحتَ الليل في ريشه طَرفا",50,"ف",2,0],["كانَ رِقّاً تالِداً أوّلُهُ","فأتَى الفضْلُ بِرقٍّ مُستَفاد",51,"د",1,0],["كَأَنَّ رَبعاً كَاِسمِهِ جادَهُ","مُنفَهِقُ الأَرجاءِ مِهمارُ",52,"ر",1,0],["كَأَنَّ رِجالَ الهِندِ حَولَ إِنائِها","عَكوفٌ عَلى خَيلٍ تُديرُ مُتونَها",53,"ن",3,0],["كَأَنَّ رِيقَتَها صَهباءُ صافِيَةٌ","يا حُسنَها فِضَّةً في مُذهَبٍ جارِ",54,"ر",1,0],["كَأَنَّ رَجائي بَعدَما اِنتَظَرَت بِهِ","عَلى عاقِلٍ بِالشَعفِ أَو جَبَلٍ صَلدِ",55,"د",1,0],["كَأَنَّ رِياضاً فُرِّقَت في حَديثِها","عَلى أَنَّ بَدواً بَعضُهُ كَبُرودِ",56,"د",1,0],["كَأَنَّ رَحلي وَقَد زالَ النَهارُ بِنا","يَومَ الجَليلِ عَلى مُستَأنِسٍ وَحِدِ",57,"د",1,0],["كَأَنَّ ريقَتَها بَعدَ الكَرى اِغتَبَقَت","مِن ماءِ أَصهَبَ في الحانوتِ نَضّاحِ",58,"ح",1,0],["كَأَنَّ رَيِّقَهُ لَمّا عَلا شَطِب","أَقرابُ أَبلَقَ يَنفي الخَيلَ رَمّاحِ",58,"ح",1,0],["كَأَنَّ ريقَتَها بَعدَ الكَرى اِغتَبَقَت","صَهباءَ صافِيَةً بِالمِسكِ مَختومَه",59,"م",2,0],["كَأَنَّ رَيَّقَهُ لَمّا عَلا شَطِباً","أَقرابُ أَبلَقَ يَنفي الخَيلَ رَمّاحِ",60,"ح",1,0],["كَأَنَّ رِعالَهُنَّ بِوارِداتٍ","وَقَد نَكَّبنَ أَسفَلَ ذاتِ هامِ",61,"م",1,1],["كأن رغاها عند أبيات مالك","نشاصُ الثريا مكفهراً صبيرها",62,"ر",3,0],["كأن رقيباً منك سد مسامعي","عن العذل حتى ليس يدخلها عذل",63,"ل",1,0],["كأنّ رقاب النّاس قالت لسيفه:","رفيقك قيسيٌّ وأنت يماني",64,"ن",2,0],["كأن رؤوس أقلامٍ غلاظاً","مسحن بريش جوجئه الصحاح",65,"ح",1,0],["كأنّ رُضابَها مِسْكٌ شَنينٌ","على راحٍ تُخالِطُ ماءَ شَنّه",66,"ن",2,0],["كان رسول الله في شبابه","لا يدع الرزق وطرق بابه",67,"ه",1,0],["كأَنَّ رَيِّقَهُ شُؤبُوبُ غاديةَ","لَمَّا تَقَفَّى رَقيبَ النَّقع مُسطارا",68,"ر",2,0],["كأَنَّ رِبحَ المِسكِ في كأسِها","إذا مَزَجناها بِماءِ السَّما",69,"م",2,0],["كأن روحك في الادهار عاصفةٌ","هبّت تمزّق أجيالاً وتذريها",70,"ي",3,0],["كان ريحانةَ المناذرةِ الغُرِ","وراح الأرواح في غسّانه",71,"ن",2,0],["كَأَنَّ رُؤوسَ الناسِ إِذ سَمِعوا بِها","مُدَمَّغَةٌ مِن هازِماتٍ أَمائِمِ",72,"م",1,0],["كان رِدْءاً لِمصْرَ إِنْ جَارَ دهْرٌ","وصِمَاماً لأمْنِها إِنْ تَعَدَّى",73,"د",2,0],["كأنَّ رُفائيلَ في كَفِّهِ","يُعيدُ الفُنونَ وأَعْصارها",74,"ر",3,0],["كأن رداء الروض من رقم صانع","لطيف التهدي في الصناعة والحذق",75,"ق",1,0],["كان رأسي في يدي مثل اللّفافه","وأنا أمشي . كباعات الصحافه",76,"ف",2,1],["كأنّ رُكامَ الثّلجِ، تحتَ صُدورِها،","جِبالُ زَرُودٍ، كُثْبُهَا تَتَرَيّعُ",77,"ع",1,0],["كأنّ رُؤوس الأزْدِ خُطْبَانُ حَنظلٍ","تَخِرّ عَلى أكْتافِهِمْ حِينَ وَلّتِ",78,"ت",1,0],["كأنَّ رؤوسَ القومِ عنْ عقبِ السُّرى","بها في دوادي لعبة ٍ المترجِّحِ",79,"ح",1,0],["كأن رباها للمالك منبرٌ","يقوم عليه الدهر يوسعها زجرا",80,"ر",2,0],["كأنَّ رِحالَ القوْمِ، حينَ تَزَعْزَعَتْ","على قَطَواتٍ مِن قطا عالجٍ، حُقْبِ",81,"ب",1,0],["كَأَنَّ رَيِّقَهُ شُؤبوبُ غادِيَةٍ","لَمّا تَقَفّى رَقيبُ النَفعِ مُسطارا",82,"ر",2,0],["كَأَنَّ ريحَ المِسكِ في كَأسِها","إِذا مَزَجناها بِماءِ السَما",83,"م",2,0],["كأن رياضاً في مثاني حروفه","أرجن بأنفاس الثغور البواس