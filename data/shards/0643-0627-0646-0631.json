خُدودُ",1,"د",1,0],["كأنّ رَبيعاً كان للنّاسِ شهْرُهُ","رَبيعاً سَقاهُ عارضٌ منْكَ مُمْطِرُ",2,"ر",1,0],["كأنّ رؤوسَ القومِ عندَ صَلاتِهمْ","وقد أوْمأتُ للأرْضِ صُفْر شَواشِيها",3,"ي",3,0],["كَأَنَّ رِجلَيهِ مِن حُسنِ اِحمِرارِهِما","ما رَقَّ مِن شُعَبِ المَرجانِ فاِتَّسَعا",4,"ع",2,0],["كَأَنَّ رَحلي وَقَد لاَنَت عَريكَتُها","كَسَوتُهُ جَورَفاً أَقرابُهُ خَصِفا",5,"ف",2,0],["كَأَنَّ رَبَّكَ أَوْحَى أَنْ تُجَاوِرَهُ","حَتّى تَقَرَّ بِهِ فِي مُزْدَجَى القُرَبِ",6,"ب",1,0],["كَأَنَّ رِجلَيهِ رِجلاً مُقطِفٍ عَجِلٍ","إِذا تَجاوَبَ مِن بُردَيهِ تَرنيمُ",7,"م",1,0],["كَأَنَّ رِضابَهُ مِن ماءِ كَرمٍ","تَرَقرَقَ في الزُجاجِ وَقَد أَحالا",8,"ل",2,0],["كَأَنَ رَضيخَ المَروِ مِن وَقعِها بِهِ","خَذاريفُ مِن بَيضٍ رَضيخٍ رَضيضُها",9,"ض",3,0],["كَأَنَّ رَحلي وَقَد لانَت عَريكَتُها","عَلى أَحَمَّ أَجَمِّ الرَوقِ مَذعورِ",10,"ر",1,0],["كَأَنَّ رُسومَهُ بُسِطَت عَلَيها","ثِيابُ الوَشي أَو لَبِسَ النِمارا",11,"ر",2,0],["كَأَنَّ راكِبَها يَهوي بِمُنخَرِقٍ","مِنَ الجَنوبِ إِذا ما رَكبُها نَصِبوا",12,"ب",3,0],["كَأَنَّ رِجلَيهِ مِسماكانِ مِن عُشَرٍ","صَقبانِ لَم يَتَقَشَّر عَنهُما النَجَبُ",12,"ب",1,0],["كأنّ رياض الطَرس خدُّ مورّدٌ","يُطَرْزه وشيُ العذار من الحِبْرِ",13,"ر",1,0],["كأن رياح الجوّ عند هبوبها","تغنّي وهذا الموج في البحر يرقص",14,"ص",1,0],["كان ردءاً للحق مرتدي التق","وى فكانت طول الحياة لباسه",15,"س",2,0],["كَأَنَّ ريحَ المِسكِ مُستَحَمَّهُ","ما يَنبَغي لِلمُسلِمينَ ذَمُّهُ",16,"م",2,0],["كَأَنَّ رَبابَهُ الضُلّالَ فيهِ","نَعامٌ جافِلٌ لاقى نَعاما",17,"م",2,0],["كَأَنَّ رُسومَ الدارِ ريشُ حَمامَةٍ","مَحاها البِلى فَاستَعجَمَت أَن تَكَلَّما",18,"م",2,0],["كَأَنَّ رِياحَ اللَحمِ حينَ تَغَطمَطَت","رِياحُ عَبيرٍ بَينَ أَيدي العَواطِرِ",19,"ر",1,0],["كأن رغاءهن بكل فجٍّ","إذا أرتحلوا نوائح معولات",20,"ت",1,1],["كَأَنَّ ريحَهُمُ في الناسِ إِذ خَرَجوا","ريحُ الحِشاشِ إِذا ما بَلَّها المَطَرُ",21,"ر",1,0],["كَأَنَّ ريحَهُمُ في الناسِ إِذ بَرَزوا","ريحُ الكِلابِ إِذا ما بَلَّها المَطَرُ",22,"ر",1,0],["كأنَّ راحته الحسنى وأنمله","بحرٌ يمدُّ إلى العافين خلجانا",23,"ن",2,0],["كأن ربك لم يخلق لمسغبةٍ","سواهم من جميع الناس إنسانا",24,"ن",2,0],["كَأَنَّ رِحالَ المَيسِ حينَ تَزَعزَعَت","عَلى قَطَواتٍ مِن قَطا عالِجٍ حُقبِ",25,"ب",1,0],["كَأَنَّ رِجالَ الأَوسِ تَحتَ لَبانِهِ","وَما جَمَعَت جَلٌّ مَعاً وَعَتيبُ",26,"ب",1,0],["كَأَنَّ رَيطَةَ جَبّارٍ إِذا طُوِيَت","بَهوُ الشَراسيفِ مِنها حينَ تَنخَضِدُ",27,"د",1,0],["كَأَنَّ رِزَّ حُداةٍ في طَوائِفِهِم","نَوحَ الحَمامِ يُغَنّي غايَةَ العُشَرِ",28,"ر",1,0],["كان روض وكان زهر وصدا","ح فما منها اليوم شيء باق",29,"ق",1,0],["كأنّ رواية الأشواق عود","على بدء وما كمل الكتاب",30,"ب",1,0],["كَأَنَّ رَحيلي كانَ مِن كَفِّ طاهِرٍ","فَأَثبَتَ كوري في ظُهورِ المَواهِبِ",31,"ب",1,0],["كَأَنَّ رُؤوسَ أَقلامٍ غِلاظٍ","مُسِحنَ بِريشِ جُؤجُؤَةِ الصِحاحِ",32,"ح",1,0],["كَأَنَّ رَقيباً مِنكِ سَدَّ مَسامِعي","عَنِ العَذلِ حَتّى لَيسَ يَدخُلُها العَذلُ",33,"ل",1,0],["كَأَنَّ رِقابَ الناسِ قالَت لِسَيفِهِ","رَفيقُكَ قَيسِيٌّ وَأَنتَ يَمانِ",34,"ن",1,0],["كَأَنَّ رُكامَ الثَلجِ تَحتَ صُدورِها","جِبالٌ زَرودٍ كُثبُها تَتَرَبَّعُ",35,"ع",1,0],["كَأَنَّ رُؤوسَ الأَزدِ خُبطانُ حَنظَلٍ","تَخِرُّ عَلى أَكتافِهِم حينَ وَلَّتِ",36,"ت",1,0],["كَأَنَّ رِكابَنا في كُلِّ فَجٍّ","إِذا دَبَّ الكُحَيلُ مِنَ الغُرورِ",37,"ر",1,0],["كَأَنَّ رِجالَ الداعِرِيَّةِ تَحتَها","قِلاصُ نَعامٍ يَنتَحيها ظَليمُها",38,"م",3,0],["كَأَنَّ رِحالَ المَيسِ ضَمَّت حِبالُها","قَناطِرَ طَيِّ الجَندَلِ المُتَلاجِمِ",39,"م",1,0],["كأنَّ رماحَ الخَطِّ حولَ بيوتِهِم","على صَهَواتِ الخيلِ دُرّاً مُبَدَّدا",40,"د",2,0],["كَأَنَّ ريقَتَها بَعدَ الكَرى اِغتُبِقَت","مِن طَيِّبِ الراحِ لَمّا يَعدُ أَن عَتُقا",41,"ق",2,0],["كانَ رَسولُ اللَهِ يَدعو إِلى","مَدرَجَةِ الحَقِّ وَدارِ السَلام",42,"م",1,0],["كان رؤيا منام","طيفك المسحور",43,"ر",1,0],["كأنّ رُمْحَكَ في تصريفه قَلَمٌ","مجاولاً بطويل الذابل اليزَنِ",44,"ن",1,0],["كَأَنَّ رُماتَها تَفري فُؤادي","بِأَنفَذ ما تَريشُ مِنَ النِبالِ",45,"ل",1,0],["كَأَنَّ رُؤوسَ الصِيدِ لم تكُ خشَّعاً","لدى بابه المرجوِّ بالأمس حاجبُه",46,"ب",2,0],["كَأَنَّ رُباها لِلمَمالِكِ مِنبَرٌ","يَقومُ عَلَيهِ الدَهرُ يوسِعُها زَجرا",47,"ر",2,0],["كأَنّ رِماحَهُم سَيلٌ مُطِلٌّ","وأَمساكٌ بَأَيدي مُورِدينا",48,"ن",2,0],["كانَ رِزْقِي مِنْ جَدِّهِ وأبيه","أَيَّ رِزْقٍ مُيَسَّرٍ مَوْفورِ",49,"ر",1,0],["كأنّ رقيبَ النجمِ أجدَلُ مَرْقَبٍ","يُقلِّبُ تحتَ الليل في ريشه طَرفا",50,"ف",2,0],["كانَ رِقّاً تالِداً أوّلُهُ","فأتَى الفضْلُ بِرقٍّ مُستَفاد",51,"د",1,0],["كَأَنَّ رَبعاً كَاِسمِهِ جادَهُ","مُنفَهِقُ الأَرجاءِ مِهمارُ",52,"ر",1,0],["كَأَنَّ رِجالَ الهِندِ حَولَ إِنائِها","عَكوفٌ عَلى خَيلٍ تُديرُ مُتونَها",53,"ن",3,0],["كَأَنَّ رِيقَتَها صَهباءُ صافِيَةٌ","يا حُسنَها فِضَّةً في مُذهَبٍ جارِ",54,"ر",1,0],["كَأَنَّ رَجائي بَعدَما اِنتَظَرَت بِهِ","عَلى عاقِلٍ بِالشَعفِ أَو جَبَلٍ صَلدِ",55,"د",1,0],["كَأَنَّ رِياضاً فُرِّقَت في حَديثِها","عَلى أَنَّ بَدواً بَعضُهُ كَبُرودِ",56,"د",1,0],["كَأَنَّ رَحلي وَقَد زالَ النَهارُ بِنا","يَومَ الجَليلِ عَلى مُستَأنِسٍ وَحِدِ",57,"د",1,0],["كَأَنَّ ريقَتَها بَعدَ الكَرى اِغتَبَقَت","مِن ماءِ أَصهَبَ في الحانوتِ نَضّاحِ",58,"ح",1,0],["كَأَنَّ رَيِّقَهُ لَمّا عَلا شَطِب","أَقرابُ أَبلَقَ يَنفي الخَيلَ رَمّاحِ",58,"ح",1,0],["كَأَنَّ ريقَتَها بَعدَ الكَرى اِغتَبَقَت","صَهباءَ صافِيَةً بِالمِسكِ مَختومَه",59,"م",2,0],["كَأَنَّ رَيَّقَهُ لَمّا عَلا شَطِباً","أَقرابُ أَبلَقَ يَنفي الخَيلَ رَمّاحِ",60,"ح",1,0],["كَأَنَّ رِعالَهُنَّ بِوارِداتٍ","وَقَد نَكَّبنَ أَسفَلَ ذاتِ هامِ",61,"م",1,1],["كأن رقيباً منك سد مسامعي","عن العذل حتى ليس يدخلها عذل",62,"ل",1,0],["كأنّ رقاب النّاس قالت لسيفه:","رفيقك قيسيٌّ وأنت يماني",63,"ن",2,0],["كأن رؤوس أقلامٍ غلاظاً","مسحن بريش جوجئه الصحاح",64,"ح",1,0],["كأنّ رُضابَها مِسْكٌ شَنينٌ","على راحٍ تُخالِطُ ماءَ شَنّه",65,"ن",2,0],["كان رسول الله في شبابه","لا يدع الرزق وطرق بابه",66,"ه",1,0],["كأَنَّ رَيِّقَهُ شُؤبُوبُ غاديةَ","لَمَّا تَقَفَّى رَقيبَ النَّقع مُسطارا",67,"ر",2,0],["كأَنَّ رِبحَ المِسكِ في كأسِها","إذا مَزَجناها بِماءِ السَّما",68,"م",2,0],["كأن روحك في الادهار عاصفةٌ","هبّت تمزّق أجيالاً وتذريها",69,"ي",3,0],["كان ريحانةَ المناذرةِ الغُرِ","وراح الأرواح في غسّانه",70,"ن",2,0],["كَأَنَّ رُؤوسَ الناسِ إِذ سَمِعوا بِها","مُدَمَّغَةٌ م