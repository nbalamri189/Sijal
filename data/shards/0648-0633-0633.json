{"poems":[[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[119,"بدا للنصر صبح مستنير","https://www.aldiwan.net/poem41089.html","عموديه"],[139,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[234,"أسهم أصاب القلب أم لحظك الشزر","https://www.aldiwan.net/poem51047.html","الطويل"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122546","الوافر"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145608","المجتث"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96613","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64747","المتقارب"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122457","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130125","الطويل"],[3372,"","https://poetry.dctabudhabi.ae/diwan/poem/198805",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""]],"verses":[["وَسُسنا الأَمرَ حينَ خَلا إِلَينا","بِأَهواءِ النُفوسِ فَما اِستَقاما",0,"م",2,0],["وَسُسْتَ الْوَرَى بِالْعَدْلِ حَتَّى تَشَوُّقَاً","إِلَيْكَ الْتَوَى جِيدُ الدُّهُورِ الْقَدَائِمِ",1,"م",1,0],["وسست الملك بالعدل ابتهاجاً","به والعدل رونقه نضير",2,"ر",1,0],["وسست أمورَ الجندِ أي سياسةٍ","وماجئت في أمر السياسة من أمرِ",3,"ر",1,0],["وسُسْ أهلَ عصرِك فيما يَقِلُّ","ويكثر حتى يبذل السلام",4,"م",1,0],["وسُسْتَهُمُ حَزْماً بما لم يَسُسهُمُ","بمعشاره يوماً زيادٌ ولا عَمْرو",5,"ر",2,0],["وسُسْتَهُم بالتُّقى في القولِ والعَملِ","تُمْضي القضايا بِلا حَيْفٍ ولا زَلَلِ",6,"ل",1,0],["وسُستُم أهلَ دَولَتِكم بِحملِ ال","جِفانِ وبالطَّعانِ وبالضِّراب",7,"ب",1,0],["وسست نمرود حتى","تمت له الهرمان",8,"ن",1,0],["وَسُستُ أُمورُ العالمين سياسةً","بها الآن عادت للزمان الشبائبُ",9,"ب",1,0],["وسُسْتَ الرَّعايا فغادَرْتَها","لِعَدلِكَ شاكرةً حامِدَهْ",10,"د",2,0],["وَسُستُمُ المُلكَ أيقَاظاً وَقَد رَقَدُوا","ومَن يُقارِن أيقاظاً برُقَّادِ",11,"د",1,0],["وسس رعاياك بالشرع العزيز تفز","وخذ لكل ضعيف من قويهم",12,"م",1,0],["وَسُستَ بني السودان بالرأيِ حازِماً","فَلانَت عَواصيها ودانت أسودُها",13,"د",3,0],["وسُسْتَ العواصف حتى استكانت","لظلك مبسوطة الانصياعِ",14,"ع",1,0],["وسست جندك والرحمن يكلؤه","سياسة ما يعفى إثرها ندم",15,"م",1,0],["وسست فما أعياك درك قضية","منالا ولا خانتك بينة الفكر",16,"ر",1,0]]}