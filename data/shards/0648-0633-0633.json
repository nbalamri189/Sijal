{"poems":[[85,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[113,"بدا للنصر صبح مستنير","https://www.aldiwan.net/poem41089.html","عموديه"],[133,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[183,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[227,"أسهم أصاب القلب أم لحظك الشزر","https://www.aldiwan.net/poem51047.html","الطويل"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"]],"verses":[["وَسُسنا الأَمرَ حينَ خَلا إِلَينا","بِأَهواءِ النُفوسِ فَما اِستَقاما",0,"م",2,0],["وَسُسْتَ الْوَرَى بِالْعَدْلِ حَتَّى تَشَوُّقَاً","إِلَيْكَ الْتَوَى جِيدُ الدُّهُورِ الْقَدَائِمِ",1,"م",1,0],["وسست الملك بالعدل ابتهاجاً","به والعدل رونقه نضير",2,"ر",1,0],["وسست أمورَ الجندِ أي سياسةٍ","وماجئت في أمر السياسة من أمرِ",3,"ر",1,0],["وسُسْ أهلَ عصرِك فيما يَقِلُّ","ويكثر حتى يبذل السلام",4,"م",1,0],["وسُسْتَهُمُ حَزْماً بما لم يَسُسهُمُ","بمعشاره يوماً زيادٌ ولا عَمْرو",5,"ر",2,0],["وسُسْتَهُم بالتُّقى في القولِ والعَملِ","تُمْضي القضايا بِلا حَيْفٍ ولا زَلَلِ",6,"ل",1,0]]}