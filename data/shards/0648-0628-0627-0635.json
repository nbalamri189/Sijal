{"poems":[[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[443,"شكراً لما تولى من الإنعام","https://www.aldiwan.net/poem2566.html","الكامل"],[563,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123688","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126152","الرجز"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104738","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133944","الكامل"],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""]],"verses":[["وَبِأصحابك الذين همُ بَعْ","دَكَ فينا الهُداةُ وَالأوْصِياءُ",0,"ا",2,0],["وَباصَ وَلاصَ مِن مَلَصٍ مَلاصٍ","وَحوتُ البَحرِ أَسوَدُ أَو مِلاصِ",1,"ص",1,0],["وبإصْفائهِ إذا القومُ خانوا","وبتَدبيرِه إذا الأمرُ جَدّا",2,"د",2,0],["وبأصلك الزاكي وثقت وإنكم","تصفون لي ورداً من الإكرام",3,"م",1,0],["وبأصحاب المختار ومن","بالسر أناروا كل دجي",4,"ج",2,0],["وبأصحابك الهداة الألى من","ك لقد أتحفوا بأكمل سيب",5,"ب",1,0],["وباصطحاب السفر","للصين أو أندلس",6,"س",1,0],["وَبأَصلِهِ ذَاكَ الَّذِى مِن نُورِكُم","أَبرَزتَهُ قَبلَ الوُجُودِ وَمُوجَدِ",7,"د",1,0],["وبأصغريه فضيلتان فحبه","في قلبه ومديحه في فيه",8,"ي",2,0],["وبأصواتها الملائك عجت","مذ قضى واستمرت الأحزان",9,"ن",1,0]]}