{"poems":[[55,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[56,"دليتني بغرور وعدك","https://www.aldiwan.net/poem27520.html","الكامل"],[29,"لعل فراق الحي للبين عامدي","https://www.aldiwan.net/poem5733.html","الطويل"],[23,"إن الذوائب من فهر وإخوتهم","https://www.aldiwan.net/poem21254.html","البسيط"],[23,"بطيبة رسم للرسول ومعهد","https://www.aldiwan.net/poem21547.html","الطويل"],[74,"سيدي والذي له صدقات","https://www.aldiwan.net/poem18777.html","الخفيف"],[53,"جعل الله مهربا وامتطى الليل مركبا","https://www.aldiwan.net/poem8650.html","مجزوء الخفيف"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[53,"تتجافى جنوبهم","https://www.aldiwan.net/poem65083.html","مجزوء الخفيف"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[53,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[53,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[53,"يا أخي من أبي وما كان يزني","https://www.aldiwan.net/poem66744.html","الخفيف"],[87,"أعفريت من الجن","https://www.aldiwan.net/poem7746.html","مجزوء الوافر"],[87,"أهل القدود التي صالت عواليها","https://www.aldiwan.net/poem62992.html","البسيط"],[82,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[107,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[50,"قد غمس الزنبور صفرة","https://www.aldiwan.net/poem66229.html","السريع"],[48,"سفكت دم الدنان وما تشكت","https://www.aldiwan.net/poem23074.html","الوافر"],[48,"ما كان في الأرض من خير ولا كرم","https://www.aldiwan.net/poem23450.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54980","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23555","المنسرح"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[47,"أَعْفَى ذِرَاعَيْهِ وأَنْحَى على","https://www.poetsgate.com/ViewPoem.aspx?id=31681",""],[87,"أَهلَ القُدودِ التي صالت عَوَاليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9579&r=&rc=69",""],[135,"أميم أجدي عافي الرزء واجشمي","https://www.aldiwan.net/poem24009.html","الطويل"],[164,"صدود ولا ذنب وعتب ولا عتبا","https://www.aldiwan.net/poem59007.html","الطويل"],[178,"جدد البين كروبا","https://www.aldiwan.net/poem46061.html","مجزوء الرمل"],[181,"خليقان هلهالان لا خير فيهما","https://www.aldiwan.net/poem4504.html","الطويل"],[189,"هلال في قضيب في كثيب","https://www.aldiwan.net/poem14117.html","الوافر"],[189,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[242,"أعفر وجهي في ثراك المعطر","https://www.aldiwan.net/poem18195.html","الطويل"],[253,"خلقت امرأ لا أخلط الجد بالهزل","https://www.aldiwan.net/poem1317.html",""],[259,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[259,"ياعظيم الشأن","https://www.aldiwan.net/poem25013.html","مجزوء الرمل"],[308,"أعف عنه وقلبي نهب ناظره","https://www.aldiwan.net/poem58249.html","البسيط"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[366,"ألا ان ديني فاعلموه هو الهوى","https://www.aldiwan.net/poem68139.html","الطويل"],[406,"تهميش على دفتر الصداقة","https://www.aldiwan.net/poem6760.html","عموديه"],[412,"بعثن غداة تقويض الخيام","https://www.aldiwan.net/poem50124.html","الوافر"],[412,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[463,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[469,"سرى وأقبل يقفو إثره القمر","https://www.aldiwan.net/poem3626.html","عموديه"],[520,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[556,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[556,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[574,"ولست إذا ما سرني الدهر ضاحكا","https://www.aldiwan.net/poem52009.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122582","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122808","الوافر"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112442","الكامل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205225","البسيط"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45206","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119872","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96692","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65072","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108730","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49588","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69346","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69412","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113747","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28060","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93458","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104673","الوافر"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22540","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216387",""],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132074","الطويل"],[3791,"","https://poetry.dctabudhabi.ae/diwan/poem/145991","الكامل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88566","المتقارب"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136810",""],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45931","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29453","المتقارب"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117229","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139471",""],[778,"اعف قلبي من العتا","https://www.poetsgate.com/ViewPoem.aspx?id=89207",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[5460,"يا أبا عيسى إليك المشتكى","https://www.poetsgate.com/ViewPoem.aspx?id=200746",""],[5783,"دفاع عن شرف القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=36934",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5937,"بريئة","https://www.poetsgate.com/ViewPoem.aspx?id=211895",""],[6096,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=177138",""],[6359,"عمّان البلد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69088&r=&rc=2",""]],"verses":[["أَعِفُّ وَفي قَلبي مِنَ الحُبِّ لَوعَةٌ","وَليسَ عَفيفاً تارِكُ الحُبِّ سالِيا",0,"ي",2,0],["أُعفيكَ مِمّا لا تُحِبُّ وَما","سُدَّت عَلَيَّ مَذاهِبُ الأُفُقِ",1,"ق",1,0],["أَعِفُّ عَنِ الجارِ القَريبِ مَزارُهُ","وَأَطلُبُ أَشطانَ الهُمومِ الأَباعِدِ",2,"د",1,0],["أَعِفَّةٌ ذُكِرَت في الوَحيِ عِفَّتُهُم","لا يَطمَعونَ وَلا يُرديهِمُ الطَمَعُ",3,"ع",1,0],["أَعَفَّ وَأَوفى ذِمَّةً بَعدَ ذِمَّةٍ","وَأَقرَبَ مِنهُ نايِلاً لا يُنَكَّدُ",4,"د",1,0],["أعف بالله عن تواقيع قوم","أجحفوا عندها بحالي السعير",5,"ر",1,0],["اعفُ عنّي فقد رَكِبْ","تُ من الأمر معطبا",6,"ب",2,0],["أعْفَيْتَ وجهَ مُحَرَّم لم يعتقد","وَفْراً ولم يَكُ بالسؤالِ مُوَقَّحا",7,"ح",2,0],["أعف عنا ذنوبنا","للوجوه الخواشع",8,"ع",1,0],["أعف عنا ذنوبنا","للعيون الدوامع",8,"ع",1,0],["أعفَّ العُفاةَ فقد أصبحت","عطاياه تنتجع المنتجِع",9,"ع",1,0],["أعفى البريةِ عن جُرم وأجملُها","صفْحاً وإن سيمَ وتراً فهو ثعبان",10,"ن",1,0],["أعفى بحاجاتي وقد حمَّلتُه","ما لا تُحمَّلُ خِلْقَةٌ من طين",11,"ن",1,0],["اعفُ عنِّي وأقِلْني عَثْرتي","يا عياذي لمُلمَّاتِ الزمن",12,"ن",1,0],["اعفُ عني خطيئتي بالذي يُعْ","طيكَ ما تشتهي من القحطبيَّهْ",13,"ي",2,0],["أعفريت من الجن","أم القائد دى وَيت",14,"ت",1,1],["أَعِفُّ مِن حَليِها عَمّا يُجاوِرُهُ","وَمِن غَلائِلِها عَمّا يُدانيها",15,"ي",3,0],["أَعَفافاً أم نجدةً كنت فيها","قَسْوَرَ الغيل والكريهةُ غولُ",16,"ل",1,0],["أعِفَّاءُ النُّفوسِ ذَوِي حِفاظٍ","عليهم كلُّ فاحشةٍ حَرامُ",17,"م",1,0],["أعفّ مَن في بيته أمّهُ","وهي على العِفّةِ سحّاقه",18,"ق",2,0],["أَعِفَّكَ عَن يَسارٍ تَبتَغيهِ","رِجالٌ مِن بَني حَوّاءَ عُفكُ",19,"ك",1,0],["أَعفى المَنازِلَ قَبرٌ يُستَراحُ بِهِ","وَأَفضَلُ اللُبسِ فيما أَعلَمُ الكَفَنُ",20,"ن",1,0],["أَعَفِيفُ يَا زَيْنَ الشَّبَابِ","وَبهْجَةَ الزَّمَنِ العَبُوسْ",21,"س",1,0],["أَعَفَا مِثَالُكِ غَيْرَ مَا","أَبْقَتْ لَنَا الذِّكْرَى مِثَالاَ",22,"ل",2,0],["أعْفِ أخاك المريض من حرجٍ","أعفاهُ منهُ الإلهُ في زُبُرِهْ",23,"ه",1,1],["أعفا القَطينُ فما به مُتَنَفَّسٌ","وَخلا العَرينُ فما به ضِرغام؟",24,"م",1,0],["أَعْفَى ذِرَاعَيْهِ وأَنْحَى على","لِحْيَتِهِ بالنَّتْفِ يُحْفِيهَا",25,"ي",3,1],["أعفُّ من حليها عما يجاوره","ومن خلائلها عما يدانيها",26,"ي",3,0],["أَعَفَّ وَأَجدى نائِلاً لِعَشيرَةٍ","وَأَكرَمِ مَخلودٍ لَدى كُلِّ مَجلِسِ",27,"س",1,0],["أعفف آمالي فما أنا قابل","وإن ظفرت كفى بغيركم هبا",28,"ب",2,0],["أَعْفِيانيَ عَنْ مَلامٍ","بِالَّذِي يَعْفُو الذُّنُوبا",29,"ب",2,0],["أَعَفْراءُ كم مِنْ زَفْرَةِ قد أَذَقْتِني","وحزْنٍ أَلَجَّ العيْنَ بالهَمَلانِ",30,"ن",1,0],["أعفُّ عن الكبائر فيه جُهدي","وأسمح بالصغير من الذنوب",31,"ب",1,0],["أَعَفُّ معْ ما أُلاقِي عند مقدرتي","فلستُ فيه على أمرٍ بمتَّهم",32,"م",1,0],["أعف يا ربّ عن ثريّا فهذا","ما جنوه لا ما جنته يداها",33,"ا",3,0],["أُعَفِّرُ وَجْهِي فِي ثَرَاكَ الْمُعَطَّرِ","لِتَنْظُرَ مِنْ لَأْوْى فُؤَادِي الْمُفَطَّرِ",34,"ر",1,1],["اعف اذا ما اوحشت انس خلوتي","ذوات الشفاه اللعس والاعين النجل",35,"ل",1,0],["اُعْفُ عَني أو أَدِِنّي","بُحْ بما ترضاهُ مِنّي",36,"ن",2,1],["اُعْفُ عني ياإلهي","إنَّ هَمّي زاد كَمّا.",37,"م",2,0],["أعف عنه وقلبي نهب ناظره","فما حصلت على وزر ولا وزر",38,"ر",1,1],["اعفُ عنّي يا رب إن ضاع عمري","بين شكّى وحرقتي وكئوسي",39,"ي",1,0],["أَعفّ عَنِ الفَحشاء ضَميري وَما عَلى","لِساني جُناح حَيثُما طابَ مَشرَبي",40,"ب",2,0],["أعفو ، إذا ركبَ الصديقُ الأصعب","وإذا رماني بالسِّهامِ وصوَّبا",41,"ب",2,1],["أَعَفُّ عَن الخَنا عند اِنتِباهي","وَأَحلُمُ عنه في حال المَنامِ",42,"م",1,0],["أَعفُّ وَلي عِندَ داعي الهَوى","دُموعٌ تُجيبُ وَقَلبٌ يَجِب",43,"ب",1,0],["أعِفُّ عن جمّته مفْعَماً","تُناهزُ الوُرَّادُ تيَّارَهْ",44,"ر",2,0],["اعفُّ عنه وتغروني لواحظهُ","فليس لي منهُ وزرٌ لا ولا وزر",45,"ر",1,0],["أعف من فوق الثرى قدرة","وهو على إمضائها أقدر",46,"ر",1,0],["أَعِفُّ وما الفحشاءُ منّي بعيدةٌ","وحسبِيَ من صَدٍّ عن الأمرِ إثْمُهُ",47,"م",2,0],["أَعفّ وأَسبابُ المطامعِ جمّةٌ","وَأَعلم وَالأَلبابُ يخدعها المكرُ",48,"ر",1,0],["أَعِف لدى عسرى وأَبدي تجملا","وَلا خير فيمن لا يعفُّ لدى العسرِ",49,"ر",1,0],["أعَفُّ الناسِ في الخَلواتش ثَوبا","وأطهرُهم مِن التَّبِعاتِ بُردا",50,"د",2,0],["أعف عن الكتمان يا أُمُّ مالِكٍ","وَما كُلُّ مَن يَهوَى يَعِفُّ وَيَكتُمُ",51,"م",1,0],["أعَفُّ بَنيك خَتلُ الذِّئبِ فيهِ","مُخالَسَةً وَمَكرُ أَبي الحُصَينِ",52,"ن",1,0],["أعفيف في شرع الصبابة واحد","رب السدير ومن نمت بخباء",53,"ا",2,0],["أعفيف فانشق من شذاها واقتطف","من وردها واهجر حديث مراء",53,"ا",2,0],["أَعفِهِ يا رَبِّ مِن واحِدَةٍ","ثُمَّ لا أَحفَلُ أَنواعَ التَلَف",54,"ف",1,0],["أعفُّ عنه وتغزوني لواحظهُ","فليس لي منهُ وزرٌ لا ولا وزر",55,"ر",1,0],["أَعِفُّ وَأَستَحيي كَما قَد أَمَرَتني","فَأَعطِ سِوايَ ما بَدا لَكَ وَاِنحَلِ",56,"ل",1,1],["أعف أهل الزمان قاطبة","نفسا وأعفاهم وقد قدرا",57,"ر",2,0],["أَعفُّ عنها وَلي عينٌ تُخالسها","إنّ المحبّينَ بِالأبصارِ فسّاقُ",58,"ق",1,0],["أعف عمّن ظلمك","أعط من قد حرمك",59,"ك",1,0],["أَعْفِ مِنْ برِّكَ هذا","فَمِنَ البِرِّ عُقوقُ",60,"ق",1,0],["أعفى ابن أسعد بالندى ربع الصدى","وافتكَّ بالفصال أغلال الأسي",61,"س",2,0],["أعفُّ إذا شاءت وأعْفُو إذا نَبَتْ","أميرُ الهوى والرأي والقولِ والفعل",62,"ل",1,0],["أَعَفُّ الناسِ مُعتَجِراً بِبُردٍ","وَأَبهى الناسِ مُعتَصِباً بِتاجِ",63,"ج",1,0],["أَعِفُّ وَلا أَجزِيهِ جَهلاً بِجَهلِهِ","وَلا آكُلُ اللَحمَ الَّذي هُوَ آكِلُه",64,"ل",2,0],["أعَفِّر خَدّي حولَ تُربةِ طَيِّباً","فتُربُ رسولِ اللَهِ أزهى من التِب