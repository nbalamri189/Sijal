wan.net/poem47191.html","مجزوء الرجز"],[554,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[554,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[554,"من مبلغ عني بنى مالك","https://www.aldiwan.net/poem47397.html","السريع"],[554,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[554,"ولما استقلت بابن حمد ركابه","https://www.aldiwan.net/poem48111.html","الطويل"],[556,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[561,"في كل جنس من الأجناس معلوم","https://www.aldiwan.net/poem34094.html","البسيط"],[561,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[565,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[570,"سلام على الأطلال وحش خيامها","https://www.aldiwan.net/poem69505.html","الطويل"],[578,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[578,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[589,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28064","الوافر"]],"verses":[["وَكَم عُصبَةٍ أَوضَعَت في الضَلالِ","تُنَقِّبُ عَن يَومِها الأَروَنانِ",0,"ن",1,0],["وَكَم عَجَموني فَاِنسَلَلتُ مُهَذَّباً","وَأَثَّرَ عودي في النُيوبِ العَواجِمِ",1,"م",1,0],["وَكَم عَدوٍّ إِذا شاغَبتَ دَولَتَهُ","يَزوَرُّ عَن طاعَتَيهِ السَمعُ وَالبَصَرُ",2,"ر",1,0],["وَكَم عَدُوٍّ مَشَت فيهِ رِماحُهُمُ","فَاِستَنصَرَ الرَكضَ مِن جَرداءَ قَيدودِ",3,"د",1,0],["وَكَم عادَ في إِحدى عَواليهِ هامَةً","لِجَبّارِ قَومٍ قَطَّرَتهُ شَباتُها",4,"ت",3,0],["وكَمْ عَبْرَةٍ بلَّتْ وِشاحاً ومِحْمَلاً","بِها زَفْرَةٌ أدْمَتْ مَسالِكَ أنْفاسي",5,"س",2,0],["وكمْ عائِلٍ أغنَوْا وكمْ خائِفٍ حمَوْا","وكم معْدِمٍ أثْرَوْهُ جوداً وأتْرَفوا",6,"ف",3,0],["وَكَمْ عَبْرَةٍ مَسْفُوحَةٍ كُلَّمَا جَرَتْ","يُحَدِّثُ مِنْهَا عَنْ دَمِي كُلُّ عَنْدَمِ",7,"م",1,0],["وكَمْ عِبْرَةٍ أبْدَيْتَ تلْعَبُ بالنُّهى","فتَنْحَرِفُ الأذْهانُ منّا عنِ القَصْدِ",8,"د",1,0],["وَكَمْ عَاتَبْتُ فِيهِ النَّفْسَ لَوْماً","فَإِنْ عُوقِبْتُ رَاعَنِي المُلامُ",9,"م",1,0],["وَكَمْ عَاشِقٍ يَسْلُو رَزَايَاهُ بِالْهَوَى","وَقَدْ يَجْتَلِي وَجْهَ النَّعِيمِ تَوَهُّمَا",10,"م",2,0],["وَكَم عَسَفَت مِن مَنهَلٍ مُتَخَطَأٍ","أَفَلَّ وَأَقوى بِالجِمامِ طَوامِ",11,"م",1,0],["وَكَم عَرَستَّ بَعدَ السُرى مِن مُعَرِّسٍ","بِهِ مِن كَلامِ الجِنِّ أَصواتٌ سامِرِ",12,"ر",1,0],["وكم عزمة ملّيت نفسيَ صدقها","وقد عرفت مني مواعد ليّانِ",13,"ن",1,0],["وكم عزمةٍ جردت منها إلى العدا","حساماً به داءُ الضلالةِ يُحْسَمُ",14,"م",1,0],["وكم علا بي أنشازاً تسلقها","وشاب في السير تصعيداً بتصويب",15,"ب",1,0],["وكم عند الحكومة من رجال","تراهم سادة وهم العبيد",16,"د",1,0],["وكم عاقل قد عدّه الناس أحمقاً","وما هو لو يُبْلَى سوى متحامق",17,"ق",1,0],["وكم عِبَر مطويّة في صورفه","فهل من مُجيل فيه طرف اعتباره",18,"ر",2,0],["وكم عاقب اللوام والشيب في الهوى","محبًّا وفي جلد المحبّ دُباغ",19,"غ",1,0],["وكم عاشقٍ يا ظبي خلفت قلبه","مُعار جناح محسن الطيران",20,"ن",1,0],["وكم عطفت لذا من بعد هذا","وكانَ العطف والبذل اشْتمالا",21,"ل",2,0],["وكم عائبٍ قد عابني وهو صادقٌ","وأدبرَ عنّي والذي فيه أَعيَبُ",22,"ب",1,1],["وكم عزَّ الذليل بلا قتالٍ","وكم ذلَّ العزيزُ مع القتالِ",23,"ل",1,0],["وكم عاتبٍ أهدى إليك عتابَه","فكافأته بالجاه والنائل الجزلِ",24,"ل",1,0],["وكم عكفنا على الظن الجميل به","فما عكفنا بطاغوتٍ ولا وثن",25,"ن",1,0],["وَكَم عَزمَةٍ لي عاقَها الدَهرُ عَنهُمُ","وَلِلدَهرِ في بَعضِ الأُمورِ حِرانُ",26,"ن",1,0],["وكم عض هذا الموت من واسعى المنى","وكم غالَ هذا الموت من آمني السرب",27,"ب",1,0],["وَكَم عَينٍ مُقَبَّلَةِ النَواحي","كَحيلٌ بِالجَنادِلِ وَالرِمالِ",28,"ل",1,0],["وَكَم عَينِ قِرنٍ حَدَّقَت لِنِزالِهِ","فَلَم تُغضِ إِلّا وَالسِنانُ لَها كُحلُ",29,"ل",1,0],["وكم عند برقٍ لاح من أيمن الحِمَى","عَنِيٍّ مَطولٍ لو يَشَاءُ قَضانِي",30,"ن",2,0],["وكم عاقدٍ عِرْنينَ عِزٍّ تركتَهُ","ومارنُهُ من وسمِ حَدِّكَ معلوبُ",31,"ب",1,0],["وَكَم عانَيتُ قَبلَكَ مِن جَميلٍ","قَبيحِ الفِعلِ عِندَ الإِجتِداءِ",32,"ا",2,0],["وَكَم عاتِبٍ بِالرَيِّ يَثلِمُ عَتبُهُ","مَضارِبُ سَيفي أَو يَهيضُ جَناحي",33,"ح",2,0],["وَكَم عَن جَنابٍ لَو تَلَبَّثَ لَم يَؤب","إِلى أَهلِهِ إِلّا بِكُرسوعِ مِرفَقِ",34,"ق",1,0],["وَكَم عَرَضَت لي حاجَةٌ فَتَقَيتُها","بِكَفَّيَّ بَعدَ اليَومِ لا أَستَقيلُها",35,"ل",3,0],["وَكَم عَصا اللَهَ مِن قَومٍ فَأَهلَكَهُم","بِالريحِ أَو غَرَقاً بِالماءِ طوفانا",36,"ن",2,0],["وكم عَبْدٍ تَذَكَّرَ فِعْلَ مَولىً","فحَنَّ إلى سَجاياه الرِّقاقِ",37,"ق",1,0],["وكم عَذُولٍ ناصحٍ","قلتُ له وقد نَصَح",38,"ح",1,0],["وَكَم عايَنتَ مِن مَلِكٍ عَزيزٍ","تَخَلّى الأَهلُ عَنهُ وَهُم حُضورُ",39,"ر",1,0],["وَكَم عايَنتَ مُستَلِباً عَزيزاً","تَكَشَّفُ عَن حَلائِلِهِ الخُدورُ",39,"ر",1,0],["وَكَم عِبرَةٍ لِلناظِرينَ تَكَشَّفَت","فَخانَت عُيونَ الناظِرينَ جُفونُ",40,"ن",1,0],["وَكَم عَنَّفتُهُ في قَطعِ حَبلي","وَإِن وَصَلَ الأَنامَ فَما أَفادا",41,"د",2,0],["وَكَم عَلَلنا بِها الأَرواحَ ثانِيَةً","إِذ عَينُها لَم تَكُن بِالمَنِّ آنِيَةً",42,"ه",1,0],["وكم عبرت بلا فرحٍ ليالٍ","وكم بالله أعيادٌ تمرُّ",43,"ر",1,0],["وكم عزْمةٍ خضنا بها هَوْلَ لُجّةٍ","كَصارِمِكَ الماضي ونائِلِكَ الغمرِ",44,"ر",1,0],["وكَم عَزَماتٍ كالسيوفِ صوادِق","تجرّدها أيدي الأَماني الكواذِبِ",45,"ب",1,0],["وَكَم عَدَوِيَّةٍ مِن سِرِّ عَمرٍو","لَها حَسَبٌ إِذا اِنتَسَبَت حَسيبُ",46,"ب",1,0],["وَكَم عاثِرٍ مِنّا أَخَذتَ بِضَبعِهِ","فَأَضحى لَهُ في قُلَّةِ المَجدِ مَطلَعُ",47,"ع",1,0],["وَكَم عاجِمٍ عودي تَكَسَّرَ نابُهُ","إِذا لانَ عيدانُ اللِئامِ وَخاروا",48,"ر",3,0],["وَكَم عُصبَةٍ قَد سَقَت مِنكُمُ ال","خِلافَةَ صاباً بِأَكوابِها",49,"ب",3,0],["وَكَمْ عَمَّرَ الوالِي بلاداً وَأَخْرَبُوا","وَكَمْ آنَسَ الوالِي قُلوباً ونَفَّرُوا",50,"ر",3,0],["وَكَم عادٍ أَبادَ وَكَم ثَمودٍ","أَتاها صالِحٌ ذاتَ المِرارِ",51,"ر",1,0],["وَكم عُشتُ مِن سَنَةٍ في الزَمانِ","وَجاوَزتُ مِن رَجَبٍ أَو صَفَر",52,"ر",1,0],["وَكَم عُضَّ مُغبَرُّ البَنانِ تَنَدُّما","عَلى ما جَنى قَبلُ البُنانُ المُوَرَّسُ",53,"س",1,0],["وكم عديمٍ سَددْتَ خَلَّتَهُ","وكم عليلٍ شَفيتَ من عِللِه",54,"ل",2,0],["وكم على النَّهْرِ أَوْصالاً مُقَسَّمَةً","تَقَسَّمَتْها المَنايا فَهْيَ أَشْطارُ",55,"ر",1,0],["وكم عناق له وقُبْلهْ","في كِذبةٍ لفظُها مُعادُ",56,"د",1,0],["وكم عَيْنٍ تُؤَمّلُ أن تَراني","وتَفْقِدُ عندَ رؤيَتِيَ السّوادا",57,"د",2,0],["وَكَمْ عَلِقتْ كَفُّ امْرِئٍ ذيَ حفيظَةٍ","بِحبْلي فَما أًوْهَيْتُ مِرَّتَهُ نَكْثا",58,"ث",2,0],["وكم عينٍ مُكَحَّلَةً بسحر","لها في القبر بالترب اكتحال!",59,"ل",1,0],["وكم عجموا عودي على الدين فانثنت","كلالا عن المر الصليب العواجم",60,"م",1,0],["وكم عَزْمة ٍ خضنا بها هَوْلَ لُجّة","ٍ كصارمك الماضي، ونائللك الغمر",61,"ر",1,0],["وَكَمْ عَصَى الله مِنْ قَوْمٍ فأهلكهمْ","بالرّيحِ، أوْ غَرَقاً بِالمَاءِ طُوفَانَا",62,"ن",2,0],["وكم عان به صعد المعالي","وقوم جهرة بهداه عوج",63,"ج",1,0],["وكم عيون عليه خفيةً سألوا","وكم عيونَ عليهِ خيفةً سالوا",64,"ل",3,0],["وَكَم عاذِلٍ فيها أَشارَ بِهَجرِها","فَأَدّى إِلى أَسماعِنا خَبَراً إِدّا",65,"د",2,0],["وَكَم عَضَدَ الرِماحَ وَمُشرِعيها","بِعَزمٍ كانَ أَعرَفَ بِالمَقاتِل",66,"ل",1,0],["وكم عجب أوحى إلى عبده به","فدونك تجميلا ولا تطلب الفسرا",67,"ر",2,0],["وكم عند الزمانِ لنا وعودٌ","وتنجيزُ لها بيديك يُرجى",68,"ج",2,0],["وكم على عطاه جادت حيل","نال بها الطالب ما يشاء",69,"ا",2,0],["وكم عاشرتُ من عُصَبٍ ولكنْ","تَخذْتُكَ من أُلوفهُمُ أَليفي",70,"ف",2,0],["وَكَم عِظامِ ذُنوبٍ فيه مُوثَقَةٍ","أَقلُّها لِحَصاةِ القَلبِ تَنتَهِبُ",71,"ب",1,0],["وَكَم عاتِقٍ لَم تَترُكِ الخِدرَ ساعَةً","تُقلِّبُ كَفَّيها لَهُ وَهيَ ثاكِلُ",72,"ل",1,0],["وَكَم عاشَ مِثلي في نَداكَ مُؤَمِّلاً","عَظيماً يُرَجّى لِلأُمُورِ العَظائِمِ",73,"م",1,0],["وكم عائذ يوما بجاهك صنته","وأنجبته من فادحات الجرائم",74,"م",1,0],["وَكم عالمٍ منهُم بدَت شمسُ علمهِ","وَآخرَ في أفقِ الوغا طالع بدرا",75,"ر",2,0],["وَكَم عَبدوا كالهندِ ناراً تأجّجت","وَكَم عَبدوا عِجلاً وكَم عَبدوا ثورا",76,"ر",2,0],["وَكَم عاقلٍ لمّا أصاخَ لقولهِ","وَشامَ المُحيّا بالسجودِ له خرّا",76,"ر",2,0],["وَكَم عاقلٍ منهم تحقّق صدقهُ","ولكِن قضاءُ اللَّه قَد حجَرَ الحجرا",76,"ر",2,0],["وَكَم عَبدوا وسطَ الكنائسِ شكلهُ","كَصورةِ عيسى وَالحَوارين والعذرا",76,"ر",2,0],["وكم عبرة أرسلتها إثر عبرة","لمست بها جرحا تناساه آسيه",77,"ي",2,0],["وكم عزني بالأماني التي","أرتني أنَّ زماني بخيلْ",78,"ل",1,0],["وكم عذل العُذّال عنكِ وَعَنَّفُوا","وموجُ الهوى في أبحرِ القلبِ عرعرا",79,"ر",2,0],["وكم عَلَويٍّ فاطميٍّ مفضَّل","ولكنّهمْ ما فيهم لك ثانِ",80,"ن",1,0],["وكم عاذلٍ أنكَرَ الوجدَ فيك","عليَّ فلمَّا رآك اعتَرَف",81,"ف",1,0],["وكم عارفٍ قد جاء ليلة سبته","يفيض سنا الأنوار كالعارف السبت",82,"ت",1,0],["وكم عن لي منها صوار مهى بها","فعاينت حتفي كامنا بعيونها",83,"ن",3,0],["وكم عَرَبيّاتٍ بَكينَ بُكاءَها","وكنَّ معَ النعماءِ مُبتسمات",84,"ت",1,0],["وكم عليها دماءُ المسلمين جَرَت","وكم تساقطَ فيها من سراياك",85,"ك",1,0],["وَكَمْ عَزَيْتُ حَدِيثَ الآنِساتِ بِها","ولِي إلى الأُنْسِ إغْذَاذٌ وَإرْقالُ",86,"ل",1,0],["وكم عُقَدٍ حُلَّتْ بعزمك لم تكن","تُحَلُّ بعزمٍ مِنْ سِواك ولا رُقا",87,"ق",2,0],["وَكَمْ عَبْرَةٍ لِي وَما بَيْنَنا","سِوى أَنْ تَكِلَّ بَناتُ الْمَوامِي",88,"م",2,0],["وَكَمْ عَصَفَتْ فِي جانِبِيْكَ فَلَمْ تَبِتْ","لَها قَلِقاً وَالطَّوْدُ لا يَتَزَحْزَحُ",89,"ح",1,0],["وَكَم عَزمَةٍ لَكَ شاذِيَّةٍ","إِلى المَجدِ تَأويبُها أَو سُراها",90,"ا",3,0],["وَكَم عَسكَرٍ حازَهُ جَيشُهُ","فَفازَ بِإِحسانِهِ الشامِلِ",91,"ل",1,0],["وَكَم عاذِلٍ قَلبي وقد لجَّ في الهَوى","وما عادِلٌ في شِرعة الحبِّ عاذلُه",92,"ل",2,0],["وَكَم عبرةٍ لا تملكُ العَينُ ردَّها","وَجأتُ بها مَقروحَ جَفنيَ إِذ أَغفى",93,"ف",2,0],["وَكَم عاذِلٍ فيه يُنمِّق عذلَه","وَواشٍ يَشي تَنميسَ إِفكٍ بِتَدليسِ",94,"س",1,0],["وَكَم عاصيتُ فيها من نَصوحٍ","أَقالَ اللَه من نُصحي عِثارَه",95,"ر",2,0],["وكم عالم بالشرع ناه عن الردى","بموجبه في حال يسر وعسرة",96,"ه",1,0],["وَكَم عفوتُ وَكم حاولت سلمهمُ","وَما لِحربِ حسودٍ يرتجى سلمُ",97,"م",1,0],["وكم عبرة تجري علي تأسفاً","وقد فات ما لا يسترد بعبرة",98,"ه",1,0],["وكم عصبةٍ ضلت عن الحق فاهتدت","بطرق الهدى من فيضي المتقاطر",99,"ر",1,0],["وَكَم عَذولي بِدَومٍ في قَولٍ بِموجَبِهِ","نِعمٌ وَلَكِن عَنِ الإِنصافِ خَطَّتُهُ",100,"ت",2,0],["وَكَم عَلا شَأنُهُ بِالذِكرِ في سورٍ","لَكِن في نونٍ ما يُصبيكَ نَكتَتُهُ",100,"ت",2,0],["وَكَم عَطَفت عَلى مِثلي بِمرحمة","وَالحَظّ يَمنَع مِن إيصال برِّكَ لي",101,"ل",2,0],["وَكَم عَزيز أَذَلَّتهُ المُنون وَما","اِن صَدّها عَنهُ مِن مال وَلا خول",102,"ل",1,0],["وَكَم عَذول تَلا كتب المَلام عَلى","سَمعي وَلكِنَّني لَم أَدرِ كَيفَ تَلا",103,"ل",2,0],["وكم عَضّني زمَنٌ مُزمِنٌ","بنابٍ منَ الخَطْبِ فيه عضَل",104,"ل",1,0],["وَكَم عادَتُكَ الظُلمُ","وَكَم سيرَتُكَ الخَبطُ",105,"ط",1,0],["وَكَم عارَضَت عُمرَ الرِقاعَةِ فَاِنقَضَت","إِذا ما هِيَ اِنقَضَّت عَلى الرَأسِ قَشعَما",106,"م",2,0],["وَكَم عادَيتُ فيهِ النَفسَ الصَديقَةَ","بَصيرَةُ الحُبِّ أَلا يَنظُرَ البَصَرُ",107,"ر",1,0],["وكم عز لقى في بطن ذل","وكم أتت المصائب بالهبات",108,"ت",1,0],["وَكَم عالِمٍ أَحيَيتَ من بَعدِ عالِمٍ","عَلى حين صاروا كالهَشيم المُحَطَّمِ",109,"م",1,0],["وكم عقروا في سُوحِها من عقيرة","أُهِلَّتْ لغير اللّه جهلاً على عمد",110,"د",1,0],["وكم عابرٍ في زورق فيه ما درى","أبحر لديه أم لديه صعيد",111,"د",1,0],["وكم عسى أنا أملي من محاسنه","ومن يوم حصرها في النظم فهو غبي",112,"ب",2,0],["وَكَم عسفت جِبالاً طالَما عجزت","عَنها الوعول من الأدغال وَالشُعَبِ",113,"ب",1,0],["وكم عام منعنا القطر فيه","فأمطرَنا لجيناً أو نضارا",114,"ر",2,0],["وكم على وجنة القرطاس من يده","تفاخرت ببديع الخط لا ماتُ",115,"ت",1,0],["وكم عبرةٍ جدَعَتْ أنفَها","يمينُ الجلالِ فلم ينكِرِ",116,"ر",1,0],["وكم علقتُ بصبري","ولات حينَ عُلوقي",117,"ق",2,0],["وكم عيونٍ أصبحتْ عندكم","معدودةً في جُملة الأسهُمِ",118,"م",1,0],["وكم عُدْتَ منهُ بفتحِ الفُتوحِ","كم عادَ لي منكَ عَهْدَ العِهادِ",119,"د",1,0],["وكم عُقِرَتْ دونَ عُقْرِ الحياضِ","سَوَامِي وأُزَّتْ أَمامَ الإِزاءِ",120,"ا",2,0],["وكم عَسَفُوا بَحْراً ولا بَحْرَ لِلنَّدى","وخاضُوا سَرابَ البيدِ نهياً ولا نِهْيا",121,"ي",2,0],["وكم عَجَزَتْ عنَّا ذواتُ قوائِمٍ","فَعُجْنا بِعُوجٍ مَا لَهُنَّ قوائِمُ",122,"م",1,0],["وكم عادت لنا عودا حميدا","وكم جادت لنا جودا سخيا",123,"ي",2,0],["وكم عزفتُ عن الإثراء ينشدني","وما بكيتُ على الآتى ولا والماضي",124,"ض",2,0],["وكم عادةٍ لله في النصر عندَه","تَضمَّن باستمرارها وتَكفَّلا",125,"ل",2,0],["وكم عثرتْ بذنبٍ كان سهواً","فكنتَ بأن تَغمّدَه حقيقا",126,"ق",2,0],["وكم عالجوها بخُرِق الأكفّ","ورأيُك في طبِّها أحذقُ",127,"ق",1,0],["وكم عزمةٍ مرتاضةٍ قد ركبتُها","فخضْتُ بها الحاجاتِ وهْي غِمارُ",128,"ر",1,0],["وكم على وادي الغضا من كبِدٍ","يحكم فيها بسوى العدل الكَمَدْ",129,"د",1,0],["وكم عَجَمتْهُ النائباتُ فردَّها","رِداداً وعاد النَّبْعُ وهو صليبُ",130,"ب",1,0],["وكم عارٍ مدْحٍ مُثْقِلٍ لمناقبي","وإنْ كان لي لما نطقتُ به عُذْرُ",131,"ر",1,0],["وكمْ عندي من ثناءٍ يودُّهُ","نسيم الخزامى حين يُتْلى وينشرُ",132,"ر",1,0],["وكم عزَّ خلقٌ باسمهِ بعد ذلَّةٍ","وعاد غنياً عنه من هو محوج",133,"ج",1,0],["وكم علَّم البيض الذُّكور يراعهُ","عناق المنايا وافتضاض الوقائع",134,"ع",1,0],["وكم عادلَ الوجد في غادةٍ","متى ألفتْ فالقلى عادها",135,"د",3,0],["وكم عاطل من لذَّةٍ زان جيده","ندى ملكٍ ضنَّ الحيا وهو جائد",136,"د",1,0],["وكم على أطلالِهم مِن مدمعٍ","اجراهُ تغريدُ الحمامِ السُّجَّعِ",137,"ع",1,0],["وكم عاقها عن شغلها بصراخة","إذا ما دعتها منه صرخة صاعق",138,"ق",1,0],["وكم عبثت فينا الثعاليب تدين","أفاعل آساد لقمعي همتي",139,"ت",2,0],["وكم عسعست أحزان شوقي كأنني","توضأت مع يعقوب في عين قصتي",139,"ت",2,0],["وكم عَشَوْنا بجنّاتِ النّعيم إلى","سَناءِ نارَينِ من جَمْرٍ ومن قُطُرِ",140,"ر",1,0],["وكم عنق رام الشقاق وصورة","أبادهما عن أمره المسح والمسخ",141,"خ",1,0],["وكَمْ عَوَّدَ اللهُ الجَمِيلَ فَفَرَّجَ ال","خُطُوبَ وَقَدْ كانَتْ تُشِيبُ النّواصِيا",142,"ي",2,0],["وكم علا في سُؤْدُدٍ","ظهرَ ثَبيرٍ وإِضَمْ",143,"م",1,0],["وكم على رِفْقٍ به","قوَّضَ بيتاً وهَدَمْ",144,"م",1,0],["وكم عظيمِ أُناسٍ قد سطوتَ به","لم يُغنِ عنه فتيلاً ذلك العِظَمُ",145,"م",1,0],["وكم عُصبةٍ حَطَّتْ لديه رحالَها","فأتْرَبَ عافيها وعزّ ذليلُها",146,"ل",3,0],["وكم عطفنا منكمُ مُعرِضاً","فلم نجدْ من معرضٍ مَعْطَفا",147,"ف",2,0],["وَكم عُصبةٍ باتتْ بظلٍّ سعادةٍ","تخطّفها أو أولج النّحْس سَعدها",148,"د",3,0],["وَكَمْ عَبرَةٍ كَفكَفتُ منهُ تجمّلاً","فلمّا أَبَتْ مرَّتْ على غُلوائِهَا",149,"ا",3,0],["وَكَم عائِبٍ لي وَدَّ أَنّي وَلَدتُهُ","وَلَو كَرُمَت أَعرافُهُ وَزَكا الأَصلُ",150,"ل",1,0],["وكم عنده في حَض","رةٍ أوقاتُها تُغنمْ",151,"م",1,0],["وكم علوا سلهباً قيد الأوابد في","يوم الوغا وحساماً للدماءِ ظمي",152,"م",2,0],["وكم عرفت بربي مشكلاً قصرت","عنه العقول عقول العرْب والروم",153,"م",1,0],["وكم علينا يُعتَدى","وكم علينا يُفتَرى",154,"ر",2,0],["وكم علمٍ جنى مالاً وجاهاً","وكم مالٍ جَنَى حربَ السِّباقِ",155,"ق",1,0],["وَكَمْ عَاذِلٍ لَوْ كَانَ يُصْغَى لِعَذْلِهِ","وَلاَئِمَةٍ لَو كَانَ يَنْهَى مَلاَمُهَا",156,"م",3,0],["وكم عاشقٍ هانَتْ عليه حياتُه","على وَصْلِها فاستعذبَ الضَرْبَ والطعْنَا",157,"ن",2,0],["وكَمْ عابِدٍ من قبلهِ لابن مريمٍ","رآه فَأَضْحَى كافراً بابْنِ مريم",158,"م",1,0],["وَكَمْ عُدَاةٍ أَقْوالهم كَتَبُوا","وَكَمْ عِداةٍ وَفوا بِها كَتَبُوا",159,"ب",3,0],["وَكَم علمتُه نظمَ القوامي","فَلما قالَ قافيةً هجاني",160,"ن",2,0],["وَكَم عَلَّمتُهُ نَظمَ القَوافي","فَلَمّا قالَ قافِيَةً هَجاني",161,"ن",2,0]]}