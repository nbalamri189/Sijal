{"poems":[[91,"منذ افترقنا لم أذق وسنا","https://www.aldiwan.net/poem62782.html","عموديه"],[85,"ولقد ظننتك يا محمد","https://www.aldiwan.net/poem7540.html","أحذ الكامل"],[97,"هل تأمرين فأفتدي وأقيك","https://www.aldiwan.net/poem24413.html","الكامل"],[113,"أرأيت يا حلول الشمائل","https://www.aldiwan.net/poem40609.html","عموديه"],[141,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[233,"ما كنت أحسب أن عه","https://www.aldiwan.net/poem31757.html","مجزوء الكامل"],[301,"ولقد ظفرت بليلة كاساتها","https://www.aldiwan.net/poem57626.html","الكامل"],[351,"لولا البشائر في لقا الأحباب","https://www.aldiwan.net/poem40779.html","الكامل"],[403,"لأبي العلاء فضائل مشهورة","https://www.aldiwan.net/poem50211.html","الكامل"],[413,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[429,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[429,"لو أنها سمحت بطيف عائد","https://www.aldiwan.net/poem12592.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[549,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[573,"عانقته حتى ظننت بأنني","https://www.aldiwan.net/poem2919.html","الكامل"],[573,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"]],"verses":[["وَلَقَد ظَفِرتُ بِمَركَبٍ لَجِبٍ","فَخَرَجتُ أَطوي السَهلَ وَالحُزُنا",0,"ن",2,0],["ولقد ظننتك يا محمد في","فن الكتابة حاذقا فهما",1,"م",2,1],["ولقد ظمئتِ فكدتُ أبذلُ مدمعي","لو كنتُ أعلم أنه يرويكِ",2,"ك",1,0],["ولقد ظلمت ورمح قد","ك يا لطيف الذات عادل",3,"ل",1,0],["وَلَقَد ظَفِرتَ بِما يَعِزُّ مَرامُهُ","إِلّا عَلَيكَ فَدُم عَزيزاً وَاِسلَمِ",4,"م",1,0],["وَلَقَد ظَنَنتُ وَفاءَكُم","بِالعَهدِ لي أَبَداً يَقومُ",5,"م",1,0],["ولقد ظفرت بليلةٍ كاساتها","يسعى بها الرشأ الغرير الأحور",6,"ر",1,1],["وَلَقَد ظَفَرت بِما أَروم وَأَبتَغي","فَمنعت عَنهُ تعتُّبي وَعِتابي",7,"ب",2,0],["وَلَقَد ظَنَنتُ بِكَ الجَميل فَكُن كَما","أَمَّلتُ تَغنَم مِدحَةٌ وَثناءَ",8,"ا",2,0],["ولقد ظفِرْتُ به برغم عواذلي","وضمَمْتُه ولَثِمْتُ وَرْدَ خدوده",9,"د",2,0],["ولَقَدْ ظَنَنْتُ الشِّعْرَ أَصْبَحَ نِقْسُهُ","مِسْكاً وأَمْسَى طِرْسُه كافُورا",10,"ر",2,0],["ولقد ظمِئْتُ وما ظفِرْتُ ببلّةٍ","من ذاكَ العذْبِ الشنيبِ الباردِ",11,"د",1,0],["ولقد ظننتُ بها وراءَ لثامها","خيراً فكشَّفَ قُبحَها الإسفارُ",12,"ر",1,0],["ولقد ظهرتَ بمعشرٍ ضلوا","فظلَّ الفضلُ فيهم حائراً متلدّدا",13,"د",2,0],["ولقد ظفرت من المديح بمعدن","يأتيك جوهره كما تختار",14,"ر",1,0],["ولقد ظهرتُ فليس يُخفِي شُهرتِي","في النّاسِ إدراجٌ ولا إدماجُ",15,"ج",1,0],["ولقد ظننتُ بأَنَّ مِنْ ضَمِّي له","كان انحناءُ ضُلوعِهِ وضُلُوعِي",16,"ي",1,0],["ولقد ظَفِرْتُ ملءِ آمالي به","ووصلتُ منه لغير نأْيِ النائِلِ",17,"ل",1,0]]}