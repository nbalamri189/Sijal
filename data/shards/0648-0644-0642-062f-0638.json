{"poems":[[93,"منذ افترقنا لم أذق وسنا","https://www.aldiwan.net/poem62782.html","عموديه"],[87,"ولقد ظننتك يا محمد","https://www.aldiwan.net/poem7540.html","أحذ الكامل"],[99,"هل تأمرين فأفتدي وأقيك","https://www.aldiwan.net/poem24413.html","الكامل"],[119,"أرأيت يا حلول الشمائل","https://www.aldiwan.net/poem40609.html","عموديه"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[240,"ما كنت أحسب أن عه","https://www.aldiwan.net/poem31757.html","مجزوء الكامل"],[308,"ولقد ظفرت بليلة كاساتها","https://www.aldiwan.net/poem57626.html","الكامل"],[358,"لولا البشائر في لقا الأحباب","https://www.aldiwan.net/poem40779.html","الكامل"],[412,"لأبي العلاء فضائل مشهورة","https://www.aldiwan.net/poem50211.html","الكامل"],[422,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[438,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[438,"لو أنها سمحت بطيف عائد","https://www.aldiwan.net/poem12592.html","الكامل"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[469,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[520,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[580,"عانقته حتى ظننت بأنني","https://www.aldiwan.net/poem2919.html","الكامل"],[580,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126791","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103117","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110392","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64172","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115671","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134084","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91835","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54472","الكامل"],[5431,"النارنج قصة عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=202098",""],[5582,"طَرَقَ الخَيالُ دُجَىً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186905",""],[4623,"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""]],"verses":[["وَلَقَد ظَفِرتُ بِمَركَبٍ لَجِبٍ","فَخَرَجتُ أَطوي السَهلَ وَالحُزُنا",0,"ن",2,0],["ولقد ظننتك يا محمد في","فن الكتابة حاذقا فهما",1,"م",2,1],["ولقد ظمئتِ فكدتُ أبذلُ مدمعي","لو كنتُ أعلم أنه يرويكِ",2,"ك",1,0],["ولقد ظلمت ورمح قد","ك يا لطيف الذات عادل",3,"ل",1,0],["وَلَقَد ظَفِرتَ بِما يَعِزُّ مَرامُهُ","إِلّا عَلَيكَ فَدُم عَزيزاً وَاِسلَمِ",4,"م",1,0],["وَلَقَد ظَنَنتُ وَفاءَكُم","بِالعَهدِ لي أَبَداً يَقومُ",5,"م",1,0],["ولقد ظفرت بليلةٍ كاساتها","يسعى بها الرشأ الغرير الأحور",6,"ر",1,1],["وَلَقَد ظَفَرت بِما أَروم وَأَبتَغي","فَمنعت عَنهُ تعتُّبي وَعِتابي",7,"ب",2,0],["وَلَقَد ظَنَنتُ بِكَ الجَميل فَكُن كَما","أَمَّلتُ تَغنَم مِدحَةٌ وَثناءَ",8,"ا",2,0],["ولقد ظفِرْتُ به برغم عواذلي","وضمَمْتُه ولَثِمْتُ وَرْدَ خدوده",9,"د",2,0],["ولَقَدْ ظَنَنْتُ الشِّعْرَ أَصْبَحَ نِقْسُهُ","مِسْكاً وأَمْسَى طِرْسُه كافُورا",10,"ر",2,0],["ولقد ظمِئْتُ وما ظفِرْتُ ببلّةٍ","من ذاكَ العذْبِ الشنيبِ الباردِ",11,"د",1,0],["ولقد ظننتُ بها وراءَ لثامها","خيراً فكشَّفَ قُبحَها الإسفارُ",12,"ر",1,0],["ولقد ظهرتَ بمعشرٍ ضلوا","فظلَّ الفضلُ فيهم حائراً متلدّدا",13,"د",2,0],["ولقد ظفرت من المديح بمعدن","يأتيك جوهره كما تختار",14,"ر",1,0],["ولقد ظهرتُ فليس يُخفِي شُهرتِي","في النّاسِ إدراجٌ ولا إدماجُ",15,"ج",1,0],["ولقد ظننتُ بأَنَّ مِنْ ضَمِّي له","كان انحناءُ ضُلوعِهِ وضُلُوعِي",16,"ي",1,0],["ولقد ظَفِرْتُ ملءِ آمالي به","ووصلتُ منه لغير نأْيِ النائِلِ",17,"ل",1,0],["وَلَقد ظفرتم بالسعا","دة مُذ رَبِحتم بالمبيعِ",18,"ع",1,0],["ولقد ظهرت مظاهرُ أبدعتها","بصفات حسنأنت ذات صفاتها",19,"ت",3,1],["ولقد ظننتُ لقآءَها","حُلماً كعادتهِ عَبَر",20,"ر",1,0],["وَلَقد ظَل يَقتفيهِ إِلى أَن","عاقَهُ عَن مَرامه وَالتقاه",21,"ا",2,0],["ولقد ظفرت بكل جبار فلم","تترك لها عند العوادي ثارا",22,"ر",2,0],["ولقد ظمئتُ إلى الفرا","تِ بكلَّ ذي كرمٍ ومجدِ",23,"د",1,1],["ولقد ظننت بأن عندك رقة","فتخيبي ظنى فما أقساك",24,"ك",1,0],["ولقد ظل روض ودي نضيرا","مورقاً مثمراً فاينع زهرا",25,"ر",2,0],["وَلَقَد ظنت الدَهر منا يشتفي","بجميع ذا فإِذا بهِ لم يكتف",26,"ف",1,0],["ولقد ظمئتُ فهل سبي","لٌ نحوَ ذاكَ السّلسبيلِ",27,"ل",1,0],["ولقد ظننت المال أعظمَ منحة","حتى سخت بفؤاده الأرزاقُ",28,"ق",1,0],["[ وَلَقَدْ ظَلَلْتُ أَرَى الرَّشادَ ضَلالَةً","وَأَرَى الضَّلالَةَ فِي هَواكِ رَشادِي ]",29,"د",2,0],["ولقد ظهرت له معجزات","في الورى نورها يزيد سناه",30,"ا",2,0],["ولقدْ ظَهَرَتْ في مَقْتَلِهِ","آياتٌ لأولي الأبصار",31,"ر",1,0],["ولقد ظَفرتُ على الرياض بِزهرةٍ","شهباءَ تَرقصُ في دُنَا الأشذاءِ",32,"ا",2,0]]}