 من جنت يده عليه شقاءه","https://www.poetsgate.com/ViewPoem.aspx?id=155259",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5419,"هي وقطتها","https://www.poetsgate.com/ViewPoem.aspx?id=52033",""],[5431,"أجمل القول ماارتضته العقولُ","https://www.poetsgate.com/ViewPoem.aspx?id=198172",""],[5431,"جدّ باهظ...","https://www.poetsgate.com/ViewPoem.aspx?id=202658",""],[5512,"ذكرى النظرة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=204332",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5937,"ستٌ وعشرون احتراقاً","https://www.poetsgate.com/ViewPoem.aspx?id=211885",""],[5956,"لماذا سُمِّي الصِّهرُ صهرا؟","https://www.poetsgate.com/ViewPoem.aspx?id=204009",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""]],"verses":[["يَتَجارَيانِ وَيَحسَبانِ إِضاعَةً","مُكثَ العِشاءِ وَإِن يُغيما يَفقِدا",0,"د",2,0],["يَتَجاذَبُ القُطرانِ مِن فَضلَيهِما","ذَيلَ الفَخارِ وَلَيسَ ذا بِعُجابِ",1,"ب",1,0],["يَتَجَلّى كَأَنَّهُ صُحُفُ الأَب","رارِ مَنشورَةً بِيَومِ المَآبِ",2,"ب",1,0],["يتجاوب التكبير في جنباتها","فتُعيده غرُّ الجياد صهيلا",3,"ل",2,0],["يتجلّى في لحنها مشهد الحبّ","أوان الوصال والهجران",4,"ن",1,0],["يتجلّى ربّ السموات والأر","ض علينا بعدله والحنان",5,"ن",1,0],["يتجلّى النعيم فيهم فتبكي","أعين السعي من نعيم البَطاله",6,"ل",2,0],["يتجلَّى عن نَاظِرَيَّ عَشَا الجَهْ","ل بألفاظه العذَابِ الطِّرَاءِ",7,"ا",2,0],["يتجلّى تنسُّمُ الريح من غا","ية تسعين فرسخاً فيطير",8,"ر",1,0],["يتجافى عن الذُنوب اللواتي","قد أمَضَّتْهُ أيّما إمْضاض",9,"ض",1,0],["يتجافى عُودها عن سخلةٍ","أبدا في بطنها مُرتكضَهْ",10,"ض",2,0],["يَتَجَلّى سِرُّ النُبُوَّةِ فينا","ذَكِروهُم فَرُبَّ خَيرٍ كَبيرِ",11,"ر",1,0],["يَتَجَنّى وَلَعَمري","حَقُّهُ أَن يَتَجَنّى",12,"ن",2,0],["يَتَجَلّى ضِياؤُهُ فَيُجَلّي","ظُلمَةَ الحادِثِ المُضِبِّ ضِياؤُه",13,"ا",3,0],["يَتَجَلّى لِلراغِبينَ بِوَجهٍ","تَلبَسُ الأَرضُ حَليَها مِن جَمالِه",14,"ل",2,0],["يَتجاذَبونَ الحِبرَ من مَلمومَةٍ","بَيضاءَ تَحْمِلُها عَلائِقُ أَربَعُ",15,"ع",1,0],["يَتَجاوَبنَ بِالرَنينِ وَيَذرِف","نَ دُموعاً تَفيضُ فَيضَ المَزادِ",16,"د",1,0],["يَتَجَنّى مِن بَعدِ ما باتَ طَوعي","وَيَسقيني مِنَ المُدامَةِ رَيِّ",17,"ي",1,0],["يَتَجَنَّبُ الآثامَ ثُمَّ يَخافُها","فَكَأَنَّما حَسَناتُهُ آثامُ",18,"م",1,0],["يَتَجَنَّى بِسوءِ خُلْقٍ عَلَى النا","سِ وَنَفْسٍ ظَلومَةٍ كَفَّارَهْ",19,"ر",2,0],["يتجاذبون الغارَ تحت سمائه","يتناشدونَ ملاحمَ الشعراءِ",20,"ا",2,0],["يَتَجَنَّبُ الزينَاتِ فِي أَلْفَاظِهِ","حَذَرَ الغُمُوضِ وَخَشْيَةَ الإِمْلاَلِ",21,"ل",1,0],["يتجارى النسر إثر الأجدل","تسبق الطير إذا سابقها",22,"ه",2,0],["يتجاوب الإغراء في كلماتها","كتجاوب الأوتار بالنغمات",23,"ت",1,0],["يَتَجَلَّدونَ ضَرورَةً مَعَ عامِهِم","لَمّا دَنَوتَ بِأَيِّ داهِيَةٍ رُموا",24,"م",3,0],["يتجابدان الروض شرك عنانه","هذاك نبّهه وهذا بلّه",25,"ل",2,0],["يتجنى كأنَّ قاضي الجنايا","تِ نصيرٌ لقدهِ الممشوقِ",26,"ق",1,0],["يَتَجَلَّى مَا بَيْنَ طَوْرٍ وَرَقْمٍ","مُسْفَرَ الْوَجْهِ هَائِجاً لِلدَّوَاخِلْ",27,"ل",1,0],["يتجلَّى في النقسِ شمسَ نهارٍ","في دُجى اللَّيلِ تبعثُ الأَنوارا",28,"ر",2,0],["يَتَجاوَبنَ صَهيلاً في الدُجى","أِرِناتٍ بَينَ صَلصالٍ وَجُش",29,"ش",1,0],["يتجنين والتجني ضروب","تارة محرم وطوراً مباح",30,"ح",1,0],["يتجرّأون على الفتاوى بعدم","كسرت لهم أوهامهم أقفالها",31,"ل",3,0],["يتجرَّع المرَّ الزعاف وإنَّما","كأس الصدود أقلُّ ما تتجرع",32,"ع",1,0],["يتجنّى على المَشوقِ ذُنوباً","يجتنيها ثنائِياً وانتزاحا",33,"ح",2,0],["يَتَجلَّى النَّقْعُ والفقْرُ إذا","صرَّحَ الشَّرَّانِ جَدْب ورهَبْ",34,"ب",1,0],["يتجلَّى رمّانهنَّ فإن شكّكت فان","ظر في الأوجه الجلنارا",35,"ر",2,0],["يتجلى الحق منه","بالحبيب مولاي محمد",36,"د",1,0],["يتجَرَّدونَ له لنُصرَةِ دينِهِ","ذُهلاً عن الأَرواحِ والأَبدَانِ",37,"ن",1,0],["يَتجلَّى له نورٌ","إن ذاك النورَ قُدسي",38,"ي",1,0],["يَتَجَنَّبُ الهَفَواتِ في خَلَواتِهِ","عَفُّ السَريرَةِ غَيبُهُ كَالمَشهَدِ",39,"د",1,0],["يتجلّى بنا ونحن شهود","باطلٌ نحن كلنا وانمحاء",40,"ا",2,0],["يتجلى بنا ونحن كواوٍ","أضمرت بين كاف أمرٍ ونونِهْ",41,"ن",2,0],["يتجلى في كل شيء ولكن","ما له في بصائر القوم كنهُ",42,"ه",1,0],["يتجلى بفعله فنراه","ظاهراً باطناً بعين العيان",43,"ن",1,0],["يتجلى بي تارة فيريني","وجهه الحق في أجل نعيم",44,"م",1,0],["يتجلّى بالذي يُب","ديه في أهل ابتهال",45,"ل",1,0],["يتجلّى حيثما شاء بها","محض تقدير له قد تبعه",46,"ع",2,0],["يتجلى بنا فنعرف منه","ما عرفنا منا بغير نزاع",47,"ع",1,0],["يتجلى وتارة يتحلى","فنرى في الوجود قبضاً وبسطا",48,"ط",2,0],["يتجلى بهم علينا فندري","كيف عنهم بهم غدا في استتار",49,"ر",1,0],["يتجلى هو في الكون بها","لا بها مزدلف في قرح",50,"ح",1,0],["يتجلى بطلعة أرشدتني","لكمالي وخيرتي وفلاحي",51,"ح",2,0],["يَتَجَنَّبُ المَرْءُ البَلاءَ وطالما","فاتَتْهُ داهيةٌ فصادَفَ داهيَهْ",52,"ي",2,0],["يتجنب الأهوال بالطرق التي","أجرى بموجبها السفين وسيرا",53,"ر",2,0],["يتجثمون عناء ترحال ولا","يجنون فائدة تعود من السفر",54,"ر",1,0],["يَتَجَلّى كَمالُهُ في عُيونٍ","زَيَّنَتها حَواجِبٌ وَطفاءُ",55,"ا",2,0],["يتجرَّين فتنجرُّ","عليهنَّ الجرائرْ",56,"ر",1,0],["يتجلَّى رمّانهنَّ فإن شك","ككت فانظر في الأوجه الجلنارا",57,"ر",2,0],["يَتَجشّمُ المَسرى ولَم يَنظر إلى","ما قالهُ المتطيّر المتعيفُ",58,"ف",1,0],["يتجشّم الحربَ الزبونَ كأنّه","في الحربِ حيدرةٌ غداة حنينِ",59,"ن",1,0],["يتجاوبن بالصياح مُشِيرا","تٍ إليه في ذاكَ بالتسليم",60,"م",1,0],["يتجلّى في الموت عمر غويّ","هو سرّ الخلود بعد المنون",61,"ن",1,0],["يتجنى على الزمان وماذا","يصنع الدهر بالجبان الكسول",62,"ل",1,0],["يتَجلى لأناس أنسوا","باللطيف البر أنس الأمنا",63,"ن",2,0],["يتجاذبون من العداوة بينهم","أهداب ذي حبك بها محبوك",64,"ك",1,0],["يتجاوبن بالبكا وله الأح","شاء بح الأصوات غرثى صواد",65,"د",1,0],["يتجلى لها بنفس عليَّ","بل عليٌّ هو الذي جلاها",66,"ا",3,0],["يتجلَّى أعلاهُ عن بَدْر تمٍ","ويباري ردفاه دِعْصي رِمال",67,"ل",1,0],["يتجاوبن بالاشارة سرا","بحديث يشجي ذوي الاقدار",68,"ر",1,0],["يَتجارين في غناءٍ شجيٍّ","أَسعداني يا نخلتي حلوانِ",69,"ن",1,0],["يتجنى ظلما فيحدث لي وج","د إذا صد عاتبا أو تجنى",70,"ن",2,0],["يتجلّى الإقبال منه وبالوال","د تبدو نجابة المولود",71,"د",1,0],["يتجلّى البدر تحت دجىً","من محيّاه ومن شعره",72,"ر",2,0],["يتجلى من أسرته","بارق البشرى على سُرُرِه",72,"ر",2,0],["يتجلّى بدراً ويسمح بحراً","ويرينا إقدامه ليثَ غابِ",73,"ب",1,0],["يَتَجارى النَحلُ مَهما تَفلَت","رَبَّ ما أَعذَبَ ذاكَ الشَنَبا",74,"ب",2,0],["يتجنى عليَّ ظلماً فاشكو","سؤ حالي له فيبدي عتابه",75,"ب",2,0],["يَتَجَمَّع لَكُم قَدَى الرَّملِ جُندٌ","مِن عِبِدّى وَمِن مُلوكٍ وَصيدِ",76,"د",1,0],["يتجلببن بالسواد فما أبد","عها نرة وما أحلاها",77,"ا",3,0],["يَتَجَمَّلُ الملكُ الخِضَمُّ بفضلِهِم","وَبِذكرِهِم تَتَجَمَّلُ الأَخبارُ",78,"ر",1,0],["يَتجافى فَإِذا لاحظته","رَجع الصُّدغُ إِلَيهِ فَانسَدَل",79,"ل",1,0],["يتجارون كالزلازل نشاوى","ويهبّونَ كالنسيم سكارى",80,"ر",2,0],["يَتَجَنَّى فَإِن نَطَقْتُ بِعُذْرِي","رَدَّهُ ظالمِاً لَهُ وَتَظَنَّي",81,"ن",2,0],["يَتَجلّى صُبحُ رَأيك في","لَيلِها فَاِنجاب مُظلِمُها",82,"م",3,0],["يَتَجلّى في ذُراهُ كَما","تَسكُنُ الأَبراجَ أَنجُمُها",82,"م",3,0],["يَتَجلىَّ على زُمرُّد اورا","قٍ كما صُفَّ لؤلؤٌ مَنثورُ",83,"ر",1,0],["يَتَجَافَى عَنِ المَضَاجِعِ جَنْبِي","وَتُقَضِّي لَكَ الجُفونُ سُجُودا",84,"د",2,0],["يتجاوبن على العجف شجى","بحنينٍ أورث الصم انصداعا",85,"ع",2,0],["يتجافى عليه ردف ثقيل","ضاق عن وسع حجمه الملبوس",86,"س",1,0],["يَتَجارَونَ بالفَسادِ وكلٌّ","مُستَعِدٌّ بعَضبِهِ للَّحاقِ",87,"ق",1,0],["يَتَجَلَّى عَنْهُ العَجاجُ كَما انْجَا","بَ دُجَى اللَّيْلِ عَن جَبِيْنِ البَدْرِ",88,"ر",1,0],["يتجنى علي من غير ذنب","ويريني من الدلال فنونا",89,"ن",2,0],["يتجنى تيها فيرضي اللواحي","ويغيض المتيم المعمودا",90,"د",2,0],["يَتَجلّى في سماءٍ","تَخلبُ العَقل فيُخلَب",91,"ب",1,0],["يتجشم الفراء في ترقيعها","بعد المشقة في قريب الشقة",92,"ق",2,0],["يَتَجلّى الإخلاصُ فيهِ وَنُبلُ الط","طَبعِ في لَفظِهِ وَفي مَعناهُ",93,"ا",2,0],["يَتَجاذَبُونَ المَجد لَم يَسعوا لَهُ","وَالقَوسُ لا تُعطى سِوى باريها",94,"ي",3,0],["يَتجَهّزُ ،يصحَبُ جرّارا","وبُذورًا والصبرَ مُعينا",95,"ن",2,0],["يتَجانفُونَ عنِ المقاهي مثلما","جَنفَتْ عن الهِرِّ الجَنيبَ العِرمسُ",96,"س",1,0],["يتجمهرُ الأعداءُ منهمْ خادعٌ","متستّرٌ بالدينِ أو مُتشدّقُ",97,"ق",1,0],["يَتَجمْهرونَ على المَنونِ كأنّهم","من مُوقفِ السّبط الشّهيدِ تَمَغْنطوا",98,"ط",3,0],["يتجلى تحت العجاجة كالبدر","تمام في ليلة ليلاء",99,"ا",2,0],["يتجلى حبُّكِ في بطلٍ","يترفَّعُ عزاً وجلالا",100,"ل",2,0],["يتجلى نورُهُ منكِ سنا","حولَ وجهٍ من بلادي ترسمينَهْ",101,"ن",2,0],["يتجشم الجلل الأشم بجده","ينقض مثل الصقر في هباته",102,"ت",2,0],["يتجاذبان إليه فضل عزيمة","تشتد تحت الورد والأصدار",103,"ر",1,0],["يتجلى اللطف عنه كما","يتجلى الورد في غصنه",104,"ن",2,0],["يتجلى معنى الأنوثة فيها","لك والشعر للعذارى شعائر",105,"ر",1,0],["يتجاملان كخائفٍ من خائف","يخشى عواقب سره لو باحا",106,"ح",2,0],["يتجلى سمكها بين الملا","كلما تاريخها قد بعدا",107,"د",2,0],["يتجمع الأنصار لل","فأرين تعلو البلبلةْ",108,"ل",2,0],["يتجلى بروحك الكون شعرا","قاب قوس على السديم يميلُ",109,"ل",1,0],["يتجلى من كرمه يتدلى","في انثيالٍ مقارصٍ ثمّ قارظْ!!",110,"ظ",1,0],["يتجلَّى بين المسامِ جمالٌ","يتلالى تحتَ السِّوارِ سوارُ",111,"ر",1,0],["يتجافى جسدي عن مضجعي","وامتناع الطيف أقسى بلوتي",112,"ي",1,0],["يتجاهل الأنهارَ ، يزعم أنه","لابد أن يظمى لألّا يظْمى",113,"م",2,0],["يتجاوبُ الجَدَّانِ عبر بيوتهم","كتجاوب الأبواب والمفتاحِ",114,"ح",1,0],["يَتَجَاوَبَانِ لذا وذَاكَ بجوِّهَا","زَجَلٌ يَطِنُّ بِرَجْعِهِ ويُنيمُ",115,"م",1,0],["يتجاذبنه العوالم حبا","لمزايا فعاله وسماته",116,"ت",2,0],["يتجاهلُ الكلماتِ حين تحفهُ","ويصبّ في اللحظاتِ قسوةَ يأسهِ",117,"س",2,0]]}