{"poems":[[505,"دع طيش نفسك لا تسمع دعاويها","https://www.aldiwan.net/poem37716.html","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128274","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95510","الكامل"],[5038,"حزني يغني","https://www.poetsgate.com/ViewPoem.aspx?id=189872",""]],"verses":[["دع طيش نفسك لا تسمع دعاويها","فالوهم عنوان خافيها وباديها",0,"ي",3,1],["دع طمعاً يورثك المذلة","ولا تخف من عيلة وقلة",1,"ه",1,0],["دع طوف حلمك لو وهي","وتعبت من نفخ الجراب",2,"ب",1,0],["دع طول سُهدك في هواك","وغزالةً هجرت حماك",3,"ك",1,1],["دَعْ طُيورَ الْعُشِّ تبْني","وابْنِ لي عُشّاً لحزْني",4,"ن",2,1]]}