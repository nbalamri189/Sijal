{"poems":[[53,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[89,"دار الصديق ولا تأمن بوادره","https://www.aldiwan.net/poem8229.html","البسيط"],[148,"منا القلب عطفا بالمسيء برحمة","https://www.aldiwan.net/poem4458.html","الطويل"],[214,"مولاي عز الطلب","https://www.aldiwan.net/poem13321.html","مجزوء الرجز"],[234,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[236,"ما ذا أثار بقلبي السائق الغرد","https://www.aldiwan.net/poem44592.html","البسيط"],[266,"شكت شجي وبكت يوم النوى شجنا","https://www.aldiwan.net/poem38169.html","البسيط"],[276,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[369,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[521,"بزينب المم قبل ان يرحل الركب","https://www.aldiwan.net/poem48740.html","الطويل"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77944","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27624","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77343","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93732","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93879","المتقارب"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[5213,"حي ربوعا بالعذيب درسا","https://www.poetsgate.com/ViewPoem.aspx?id=170491",""],[5845,"عسى منْ خفي اللطفِ سبحانهُ لطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=15452",""]],"verses":[["وقل في صاحب لم يلف إلا","حكيماً في مذاهبه ظريفا",0,"ف",2,0],["وَقَلَّ فِي النَّاسِ مَنْ جَرَّبْتُهُ فَرَأَى","بَيْنَ الْحَقِيقَةِ وَالْبُهْتَانِ فُرْقَانَا",1,"ن",2,0],["وقل فزتموا مني بقرب ورحمة","مخصصة فضلا ونلتم هدايتي",2,"ي",1,0],["وقل في الدهر العطا","وزاد فيه العطب",3,"ب",1,0],["وقَلَّ في واجب الحِف","ظ عنه دفعي ونصري",4,"ر",2,0],["وقل فقد أمكن التبليغ في وطن","ما خاب عبد إليه قاصداً يفد",5,"د",1,0],["وقل في الدهر من تصفو موارده","الا تجرع منها الآسن الأجنا",6,"ن",2,0],["وَقل فزت يا عَبد الرَحيم برحمة","وَمغفرة يوم المَلائك يصطَفوا",7,"ف",3,0],["وقَلَّ في حَرْبِ مَنْ تَلْقاهُ فكْرتُه","فيما به من هوَى مَن ليس يَلْقاه",8,"ا",2,0],["وَقَلَّ في تَسمِيَةِ قَتلَةٌ","في مِثلِها تُخلَعُ أَديانُ",9,"ن",1,0],["وَقُل في تَجنيها لَكَ الذَنبُ اِنَّما","عتابُك من عاتَبت فيما لَهُ عَتب",10,"ب",1,0],["وقل فيه يا الله حقق مقاصدي","وبالعفو يا رحمن كن لي معافيا",11,"ي",2,0],["وقل في تجريده خبير","من نفي أو من شبهه فخير",12,"ر",1,0],["وقل في ثالثة حذف لمن","أتى بقطع بعد أن لها خبن",13,"ن",1,0],["وقل فَلا قلب لي","يقوى عَلى حربهم",14,"م",1,0],["وقل فيه محسان كما جاء نصه","بالسنة الأرسالُ فالمحسنُ الله",15,"ل",2,0],["وَقُل في مَقامٍ لا يُساميهِ فاخِرٌ","بِفَخرٍ وَفَضلٍ لا يُدانيهِ فاضِلُ",16,"ل",1,0],["وقل في انتباه والصباح وفي المسا","ونوم من المروي ما شئت تهتد",17,"د",1,0],["وَقُل في عَليٍّ ما تَشاء مِن الثَنا","خَدين المَعالي الغر وَابن خَدينها",18,"ن",3,0],["وقل في التهاني لك الحظ أبشر","برفعة شان على رغم شاني",19,"ن",2,0],["وَقلّ في الأَرض مَن يَرضى الحَياة كَما","تَأتيهِ عَفواً وَلَم يَحكم بِهِ الضّجرُ",20,"ر",1,0],["وقل في حنين الجذع ما شئت واعتبر","بمعراجه واقصر خطابك أو زد",21,"د",1,0],["وقل فلان يتندى كرما","فهو ند أَخذه ما قَدُما",22,"م",2,0],["وقل فؤاد الصب رهن ربعكم","فيا عساها ان تجود ياعسى",23,"س",2,0],["وقلْ فزتَ ياعبدَ الرحيمَ برحمة","ٍ ومغفرة ٍ يومَ الملائكُ تصطفُّ",24,"ف",1,0]]}