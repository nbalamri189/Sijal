om/ViewPoem.aspx?id=89153",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5388,"صباحك شعر","https://www.poetsgate.com/ViewPoem.aspx?id=206905",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5431,"ثورة الشعب العربي..كانت وماتزال..","https://www.poetsgate.com/ViewPoem.aspx?id=195277",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5542,"ليس هذا عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=10193",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5596,"تتابُع الأكدار","https://www.poetsgate.com/ViewPoem.aspx?id=206775",""],[5672,"حكاية","https://www.poetsgate.com/ViewPoem.aspx?id=206557",""],[5736,"إن الذي سوّا السنا سوّاك","https://www.poetsgate.com/ViewPoem.aspx?id=203833",""],[5758,"العاتِرِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=200505",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5781,"مقاليدُ العشقِ بيدي!","https://www.poetsgate.com/ViewPoem.aspx?id=208762",""],[402,"لمصر سيوف في حديث جهادها","https://www.poetsgate.com/ViewPoem.aspx?id=35447",""],[5790,"تملكت من سيد أصيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111889",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5858,"رسالة الى البردوني","https://www.poetsgate.com/ViewPoem.aspx?id=195176",""],[5970,"نحن يا أيام أضياف لديك","https://www.poetsgate.com/ViewPoem.aspx?id=130588",""],[5975,"جارة","https://www.poetsgate.com/ViewPoem.aspx?id=53131",""],[5975,"قلبي في هواك ... بخيلُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53281",""],[6097,"شَقائقُ ال\"نَيْسَانِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=190671",""],[6142,"وطلاب رشدٍ فوق نجب حدت بهم","https://www.poetsgate.com/ViewPoem.aspx?id=155740",""],[520,"فؤاد يجم الشوق والوجد يحرق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577588",""],[831,"حيوا الأريكة والسلطان والعلما","https://diwany.org/%D8%AD%D9%8A%D9%88%D8%A7-%D8%A7%D9%84%D8%A3%D8%B1%D9%8A%D9%83%D8%A9-%D9%88%D8%A7%D9%84%D8%B3%D9%84%D8%B7%D8%A7%D9%86-%D9%88%D8%A7%D9%84%D8%B9%D9%84%D9%85%D8%A7/","البسيط"],[6213,"شق النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76280&r=&rc=37",""],[463,"لو كنتُ دانيتُ المودَّة َ قاصيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60285&r=&rc=341",""],[6316,"في رثاء الشيخ بن باز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65165&r=&rc=0",""]],"verses":[["وَطُل وَصُل وَاِعفُ وَهَب وَاِنتَقِم","وَاِبقَ وَدُم وَاِعلُ وَثِب وَاِسلَمِ",0,"م",1,0],["وَطَلَبنا الوَفاءَ حَتّى إِذا عَ","زَ رَضينا بِالمَطلِ وَالتَسويفِ",1,"ف",1,0],["وَطُلنا بِسِبطَي أَحمَدٍ وَوَصِيِّهِ","رِقابَ الوَرى مِن مُتهِمينَ وَمُنجِدِ",2,"د",1,0],["وطُلاّبِ مَجْدٍ دونَ ما يَبْتَغونَهُ","أعالِي رُباً لا يُسْتَطاعُ امْتِطاؤُها",3,"ا",3,0],["وطَلَبْتِنا وعلى المُضَيَّحِ فالحِمى","مَغْدى النّجائِبِ والمَراحُ عَقيقُ",4,"ق",1,0],["وَطَلَعْنَ مِنْكَ عَلَى الْبِلاَدِ بِطَارِقٍ","لِلْفَتْحِ وَالنَّصْرِ الَّذِي يُسْتَقْبَلُ",5,"ل",1,0],["وَطَلَعْتَ بَدْراً لاَ يُخَافُ مُحَاقُهُ","يَوْماً وَلاَ يُخْشَى عَلَيْهِ أُفُولُهُ",6,"ل",2,0],["وَطِلاءٍ خُسرُوانِيٍّ إِذا","ذاقَهُ الشَيخُ تَغَنّى وَاِرجَحَنّ",7,"ن",1,0],["وطلعت في أفُقِ الخلافة نَيِّراً","تجلو ظلامَ الظلم والإضلالِ",8,"ل",1,0],["وطلّقها على جهل ثلاثاً","كذلك يجهل الرجل الغَضوب",9,"ب",1,0],["وطلبنا تعلّة لنفوس","ليس يشفي عليلها التعليل",10,"ل",1,0],["وطلق جبين قضى حسنه","ببين على سلوتي الطالق",11,"ق",1,0],["وطلعة شمل الخيلان وجنتها","فعمها خالها قوداء شمليل",12,"ل",1,0],["وطلُوعُ المولود فيه بشَيرٌ","بسرورٍ لأَهْله مولودِ",13,"د",1,0],["وَطَلَّتُهُ تَبكي وَتَضرِبُ نَحرَها","وَتَحسِبُ أَنَّ المَوتَ كُلَّ عَتادِ",14,"د",1,0],["وطلبت اسباب الغنى من بابه","فوجدت ان الباب دوني موصد",15,"د",1,0],["وطلبت الوصل ملحا","حاً فاعياني الطلاب",16,"ب",1,0],["وَطَلَبوا الأَمر وَحاوَلَوا المَدى","وَبايَعوا راشدَهم مُحَمّدا",17,"د",2,0],["وَطَلَعتَ مِن وادي المُلو","كِ عَلَيكَ غارُ الفاتِحين",18,"ن",1,0],["وطلعُها منسبكٌ","من ذوبها المنسكبِ",19,"ب",1,0],["وَطَلَبتُ مِنكِ مَوَدَّةً لَم أُعطَها","إِنَّ المُعَنّى طالِبٌ لا يَظفَرُ",20,"ر",1,0],["وَطَليحٍ مِنَ الوَداعِ تُعَنّي","هِ نَوىً غَربَةٌ وَوَجناءُ حَرفُ",21,"ف",1,0],["وطَلعةً سالَم ضوءُ صُبحِها","ظلامَها والصُّبحُ حَربٌ للظُّلَمْ",22,"م",1,0],["وَطَلعَةٌ كَالهِلالِ مُشرِقَةٌ","تُزهى عَلى غُصنِ قَدِّكَ النَضِرِ",23,"ر",1,0],["وَطَلعَةٌ كَجَبينِ الشَمسِ لَو لَمَعَت","يَوماً لِمُغتَبِقٍ بِالراحِ لَاِصطَبَحا",24,"ح",2,0],["وطليحَ أسفار وعلّته","قتالة لَم تشف في بلدِ",25,"د",1,0],["وطَلَبتِ الضدَّ لأوجِدَهُ","وجموحي في الصدِّ فَلَم أَجِدِ",26,"د",1,0],["وطُلوعِ راياتٍ وقَودِ جَحافلٍ","وقِراعِ أَبطالٍ وكَرِّ جِيادِ",27,"د",1,0],["وَطَلَعتَ في دَرَجِ العُلى حَتّى إِذا","جِئتَ النُجومَ نَزَلتَ فَوقَ الفَرقَدِ",28,"د",1,0],["وَطَلَبتَ وُدّي وَالتَنائِفُ بَينَنا","فَنَداكَ مَطلوبٌ وَمَجدُكَ طالِبُ",29,"ب",1,0],["وطلعتَ والحقُّ المبينُ مُشَرَّدٌ","يَبغِي المُقامَ وأين منه مُقامُ",30,"م",1,0],["وَطَلَبتُ الكَبيرَ بِالأَصغَرِ الأَص","غَرِ إِنَّ الكَبيرَ بَعدَ الصَغيرِ",31,"ر",1,0],["وَطَلَبتَ بِالخَلَقِ المُرَقَّعِ شَأوَنا","فَلَتَرجِعَنَّ وَبَظرُ أُمِّكَ يُرعَدُ",32,"د",1,0],["وَطِلابُ الرَبابِ مِن دونِها السَي","فُ سِفاهٌ وَالطَيفُ مِنها عَذابُ",33,"ب",1,0],["وَطَلُّ قَتيلٌ فَلَم يُدَّكَر","وَغُلَّ أَسيرٌ فَما أُطلِقا",34,"ق",2,0],["وَطَلَبتُ ذا القَرنَينِ حَتّى فاتَني","رَكضاً وَكِدتُ بِأَن أَرى داأُودا",35,"د",2,0],["وطلاقهن لغير ذنب كان","قبلا قد صدر",36,"ر",1,0],["وطلَبْتُ عِنْدَكَ راحًة وعلى","قَدْرِ اعتِقادي كانَ إِدْلالي",37,"ل",2,0],["وطلب الصيت به قديما","والذكر فوق الأرض مستديما",38,"م",2,0],["وَطَلعَتُ حَرْبٍ المُرَادَاة دُونَهَا","أَبَى أَنْ يُذَادَ الورْدُ عَنْهَا فَأَوْرَدَا",39,"د",2,0],["وطَلْحَةُ والحجّاجُ منهُمْ وَحَاطِبٌ","وليسَ ابنُ عوّامٍ بناسٍ ولا عمرِو",40,"ر",2,0],["وَطَلَعْتَ كالأَمِل الوَسِيمِ يَحُفُّه","نُورُ المَهابة في جَلالِ جَلائه",41,"ا",3,0],["وطلعةٌ كخدودِ الزهرِ غازلها","من الأصائِل أطيافٌ وألوانُ",42,"ن",1,0],["وطلعت في حذر تطلّ","على البرية من بعيد",43,"د",1,0],["وطلق هذه الدنيا بتاتا","طلاقك لا اليك ولا تليني",44,"ن",2,0],["وطلَبتُ عونَ قريحتي فوجدتُها","سمحاءَ تبذُل خيرَها مِعوانا",45,"ن",2,0],["وطلعة بيد الرحمن قد مسحت","فراح مظهرها يسمو عن المثل",46,"ل",1,0],["وطلق الكل سرا فالمعيشة إن","يمر عمر الفتى للَه باللَه",47,"ل",2,0],["وطلاً كعين الديك","تحسدها النضارة",48,"ر",2,0],["وطلعتَ فانجابَ القتامُ واشرقت","أقطارُها حتى رأى من لا يرى",49,"ر",2,0],["وطلت باعا وأدركت الذين جروا","ورحت أدرك من نيل العلا أملي",50,"ل",2,0],["وطَلعةٍ زانَها الباري بقُدرتهِ","فخطّها لكتابِ الحُسنِ عُنْوانا",51,"ن",2,0],["وطل أقاح أم رحيق معطر","وأسهم لحظ أم حسام مجرد",52,"د",1,0],["وَطَلَيتُم تيجانَكُم بِاللُبانِ","وَعَشِقتُم من الجَمالِ نُجومَه",53,"ه",1,0],["وطلعتَ مَعْ شمسِ الضحى لعيوننا","شمساً ولُحْت مع الهلالِ هِلالا",54,"ل",2,0],["وَطَلَبتُ مِن قَلبي السُلُو","وَ فَقالَ لَيسَ بِمُمكِنِ",55,"ن",1,0],["وَطُلِ الناسَ كَما طُل","تَهُمُ باعاً بَقاءا",56,"ا",3,0],["وَطَلِّقْ بِنْتَ ضَيْرِكَ أُمَّ دَفْرٍ","يُطَلِّقْكَ الْهَوَانُ بِلا تَرَاخِ",57,"خ",1,0],["وطلعت كواكب التهاني","من فلك السطور والمباني",58,"ي",1,0],["وَطلت مَكانا في العلا وَمَكانة","كانك شمس في مَنازل أَسعد",59,"د",1,0],["وَطلقت ذابان الثلات وَلَم أعد","اليهوَمالي فيه وَهو شغوب",60,"ب",1,0],["وَطَلعَة نور التم أَم نور أَحمَد","تشعشع حَتّى شق ساطعه التربا",61,"ب",2,0],["وَطَلَّقْتُ الْمُنى لا الْعَزْمُ يَوْماً","لَهُنَّ وَلا الرَّكائِبُ لِلذَّمِيلِ",62,"ل",1,0],["وَطُلَّ دَمُ الأَعداءِ حَتّى دِيارُهُم","رُسومٌ عَوافٍ بَعدَهُم وَطُلولُ",63,"ل",1,0],["وطلبتُ منه جزاء ذلك قبلةً","فأبى وراح تغزلي في البارد",64,"د",1,0],["وطلسم سر الذات رمز به اهتدى","إليها رجال الحق من كل ناظر",65,"ر",1,0],["وطلقت فيها عالم الحس بتة","لتعلم أني لا أقول برجعة",66,"ه",1,0],["وَطَلّابُ التِراتِ بِها طَلوبٌ","ذَكِيٌّ لا يُحالِفُهُ الهُجودُ",67,"د",1,0],["وطلاب المجد والأوطا","ن والخيل العراب",68,"ب",1,0],["وَطَلَعَت شَمسُ الضُحى","عَلَيَّ مِن وَجهِ القَمَر",69,"ر",1,0],["وَطَلَبتُمُ الإِحسانَ مِن","هُ عَلى إِساءَتِكُم إِلَيهِ",70,"ي",2,0],["وطُلوعُه في مَوكبٍ ودَّتْ له","كُلُّ الجَوارحِ لو تَحَوَّلَ أَعيُنا",71,"ن",2,0],["وطلَبْتُ بالأدبِ الغنَى فحُرِمتُه","فعَلِمْتُ ما كُلُّ السّديدِ مُصيبا",72,"ب",2,0],["وَطَلقٌ كَما اِستَدَرَيتَ هَزَّةَ ذابِلٍ","وَجَزلٌ كَما اِستَدعَيتَ وَثبَةَ صارِمِ",73,"م",1,0],["وَطَلاقُ الحُصونِ مِن غَيرِ حَربٍ","بِدعَةٌ سَنَّها بِبَيروتَ سامَه",74,"م",2,0],["وَطَلعَةُ مَولانا يُطالِعُ عَبدَهُ","وَكُلُّ رُبوعٍ كانَ فيها رُبوعُها",75,"ع",3,0],["وطلعتَ في دين ابن مريم بغتةً","بدراً يشقُّ الظلمة الحنديسا",76,"س",2,0],["وَطُلول بِاللَوى بالية","جَدد البَلوى وَما رَثَت بَلاها",77,"ا",3,0],["وطلق الدنيا الغرور الشرود","ذي غدرها معروف معهود",78,"د",1,0],["وطلبتُم أن أجيبكمُ","فأطعتُ الأمر مُمْتثِلا",79,"ل",2,0],["وطُلتُ بهِ من كَان قِدماً مُطاولي","وسامَيتُ في العَلياء كلَّ مُسَامي",80,"م",2,0],["وطلبتم مني اختيار محقق","أهل العلوم بعصرنا تقفوه",81,"و",2,0],["وطلبتم سبل السلام فأهلاً","ببلوغ المرام من إحسانك",82,"ك",1,0],["وطلبت مني أن أجي","ز مؤلفاتي لا أزيد",83,"د",1,0],["وطُلْتُ عَمّن يُسامِيني ففخرُهُم","أن يبلغوا إن سمَتْ هِمَّاتُهم قَدَمي",84,"م",2,0],["وطلعت كالقمر المنير إذا بدا","زاه بأنوار المحاسن زاهر",85,"ر",1,0],["وطلبنا عفو المهيمن عنَّا","وأغظنا الأعداء والإلحادا",86,"د",2,0],["وطلّ على اطلالها من بشيرها","يبشر ان البذل هام وهامر",87,"ر",1,0],["وطَلَبْنَاهُ من الجا","رِي على الرَّسْمِ بِدَيْنِ",88,"ن",1,0],["وطلبتُ العلومَ فيها على مث","لِك مُحيي شريعةِ الإسلامِ",89,"م",1,0],["وطلت هذا الورى بالفضل أجمعهم","لكنما الرزق لم يحرز بإمكان",90,"ن",1,0],["وطَلَعْتَ للمُتَأَمِّلِينَ بِغُرَّةٍ","كالشمسِ يَحْسِرُ دونَها أَبصارُها",91,"ر",3,0],["وطِلابُ مأْوىً قبلَ حِينِ أَوانِهِ","فَالدَّهْرُ أَجْمَعُهُ لِيَ اسْتِنْفارُ",92,"ر",1,0],["وطلَعن في ليلٍ يُضلّ وسكرةُ ال","تفريق توهِمُنيهِ نورا هاديا",93,"ي",2,0],["وطلَع النيروزُ بسعوده","عليك جذلانَ إليك مبتَسِمْ",94,"م",1,0],["وطلعت بالإقبال أشرف طالع","من أُفقهِ وقدِمتَ أسعدَ مقدَمِ",95,"م",1,0],["وطلعةٌ تُشرِقُ الدياجي","منها وأقمارُها أُفولُ",96,"ل",1,0],["وطلبتُ منه بسلمهِ وبحربهِ","نَصْفاً فأعيا حاسراً ومقنَّعا",97,"ع",2,0],["وطلوعها شعثاً كأنَّ عجاجَها","بالقاع أسنمةُ الغمام المُثقل",98,"ل",1,0],["وطلقت عقلي في هواكم جهالة","