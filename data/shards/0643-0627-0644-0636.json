{"poems":[[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38212","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109808","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87458","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141636","الكامل"],[4955,"أهلا أخي قد قالها متمسكا","https://www.poetsgate.com/ViewPoem.aspx?id=203744",""],[4958,"على قدر التعلق","https://www.poetsgate.com/ViewPoem.aspx?id=59099",""],[5431,"ياطيبَ أفئدةٍ بالحب تغتسلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187259",""],[5952,"يا ذا الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=210795",""],[6226,"حَيْرَةُ الأَسْئِلَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87719&r=&rc=9",""]],"verses":[["كَالضوءِ في الشَّمسِ يَبدو غَيرَ مُنتقلٍ","وَفي الأَهِلَّةِ كَم يَبدو بمنتقلِ",0,"ل",1,0],["كالضابطي الملك أرباب الرتبْ","الطالبي الاتساع المكتسبْ",1,"ب",1,0],["كالضارب المضروب أيضا والحسن","وكلها بعائد قد اقترن",2,"ن",1,0],["كالضوء يصغر جرمه في نفسه","ويفيض عنه النور من مصباحه",3,"ح",2,0],["كالضأن تحسَبُ عَلفها حبّالها","لكنهُ في الحقِّ عَلف العالفِ",4,"ف",1,0],["كالضرس تقلعه ليسلم غيره","وعلى الذي باينت حزنك بادِ",5,"د",1,0],["كالضبعِ كشَّر عن نيوبِ الحقد إذ","فتكَ اللعينُ بإخوةِ الإيمانِ",6,"ن",1,0],["كالضَّوْءِ نَحْنُ، أَلَمْ نَكُنْ!","فَعَلامَ لَمْ نَرَ ظِلَّنا؟",7,"ن",2,0],["كالضوء سرعته ولهان منفعلُ","في دربه عبقت أكباد من وصلوا",8,"ل",3,0],["كالضيف أنت وأنت أنت مضيفنا","باللحن بالأنغام بالقيثارِ",9,"ر",1,0],["كالضَوءِ يَعبرُ أشْوَاقِي ويَأسِرُنِي","كَفِّي تُعَالِجُهُ والخَوفُ والوَجلُ",10,"ل",1,0]]}