{"poems":[[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[53,"أسنة هذا المجد آل المهلب","https://www.aldiwan.net/poem30689.html","الطويل"],[6,"أسنى ضوء صحرة بالفقرة","https://www.aldiwan.net/poem391.html",""],[54,"فوهاء شوهاء يبدي الكيد مضحكها","https://www.aldiwan.net/poem27499.html","البسيط"],[47,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[51,"وقائل كيف تهجو","https://www.aldiwan.net/poem61920.html","المجتث"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"يا يوم عرج بل وراءك يا غد","https://www.aldiwan.net/poem63475.html","الكامل"],[45,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[52,"ما صائدات ليس بارهات","https://www.aldiwan.net/poem27190.html","الرجز"],[46,"إقنع بما رضي التقي لنفسه","https://www.aldiwan.net/poem22285.html","الكامل"],[46,"أمامة كيف لي بإمام صدق","https://www.aldiwan.net/poem22478.html","الوافر"],[46,"الشيب أزهار الشباب فما له","https://www.aldiwan.net/poem22705.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21028","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[6,"أَسَنَا ضَوْءِ نَارِ صُحْرَة","https://www.poetsgate.com/ViewPoem.aspx?id=17539",""],[133,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[133,"إلى ابن أما إمام البدو والحضر","https://www.aldiwan.net/poem54830.html","الطويل"],[224,"قص لي سيرة الذين أحبوا","https://www.aldiwan.net/poem39720.html","الخفيف"],[236,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[238,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[238,"فرجت من همي ومن بوسي","https://www.aldiwan.net/poem19716.html","الكامل"],[283,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[365,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[430,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[516,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[525,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[563,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[576,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"]],"verses":[["أَسِنَّةُ فِهرٍ في صُدورِ جِيادِهِم","كَأَنَّ قَناها لِلجِيادِ مَقاوِدُ",0,"د",1,0],["أَسِنَّةُ هَذا المَجدِ آلُ المُهَلَّبِ","وَفُرّاطُهُ في كُلِّ شَرقٍ وَمَغرِبِ",1,"ب",1,1],["أَسَنى ضَوءِ صُحرَةَ بِالفُقرَةِ","أَبصَرتَ أَم تَنَصُّبَ بَرقِ",2,"ق",1,1],["أَسنانُها أُضعِفَت في حَلقِها عَدَداً","مُظَهَّراتٌ جَميعاً بِالرَواويلِ",3,"ل",1,0],["أَسِنَّتُهُ إِذا لاقى طِعاناً","صَوارِمُهُ إِذا لاقى ضِرابا",4,"ب",2,0],["أسْنِدْ إليّ تجدْني","كبعض من تَسْتسِدُّ",5,"د",1,0],["أسندتْ ركنَها إليه فأرسى","ولقد كان زالَ كُلَّ مزالِ",6,"ل",1,0],["أسِنَّتُها نُوَّارُها وثمارُها","جماجمُ والأغصانُ بوعٌ وأذرُعُ",7,"ع",1,0],["أَسنِد صُدورَ اليَعمَلاتِ بِوَقفَةٍ","في الماثِلاتِ كَأَنَّهُنَّ المُسنَدُ",8,"د",1,0],["أَسنى صَنائِعَهُ إِلَيَّ وَما يَني","أَثَرٌ يَلوحُ عَلَيَّ مِن آثارِهِ",9,"ر",2,0],["أسنّةُ الأعداءِ في حربه","أطعنُ منها إبَرٌ في ثمام",10,"م",1,0],["أسنانُهُ كاللؤلؤِ المفتنِّ","منَ المفاريدِ لجبرِ الوهنِ",11,"ن",1,0],["أَسِنَّةٌ غَيرُ مُنَكَّساتٍ","مِن قَصَبِ الريشِ مُجَرَّداتِ",12,"ت",1,0],["أَسنى فِعالِكَ ما أَرَدتَ بِفِعلِهِ","رَشداً وَخيرُ كَلامِكَ التَسبيحُ",13,"ح",1,0],["أَسُنَّتُنا المَآلُ إِلى صَعيدٍ","فَما بالُ الأَسِنَّةِ وَالصِعادِ",14,"د",1,0],["أَسنَيتُ مِن مَرِّ السِنينَ وَلَم أُرِد","أَسنَيتُ مِن ضَوءِ السَنا البَهّارُ",15,"ر",1,0],["أُسِندُ ظَنِّي إلى المليكِ ومَن","يَلجَا إلَيهِ فلَم يَنَلهُ الضُرّ",16,"ر",1,1],["أسْنِدوا «البيتَ» بالصدور، فقد ما","دَ، وخانتْ جدرانهنَّ الدَّعائم",17,"م",1,0],["اسنم يَمَسُّ من القلوب شَغافها","فكأن أحرفه انتظمْن نشيدا",18,"د",2,0],["أَسَنَا ضَوْءِ نَارِ صُحْرَة َ بالقُفْ","رَة ِ أَبصرتَ أمْ تَنصَّبَ بَرقُ",19,"ق",1,1],["أسنَى صَلاَةٍ وتَسلِيمٍ بِهِ حُلِيَت","عَلَى الخُلاَصَةِ مِن أَبنَاءِ عَدنَانِ",20,"ن",1,0],["أسنَى سَلاَمٍ شَذَاهُ مِن شَمَائِلِهِ","وَمِن سَنَاهُ سَنَاهُ الكَاسِفُ القَمَرِ",21,"ر",1,0],["أَسنِدي رَأسَكِ الجَميلَ إِلى صَد","ري وَأَصغي أُسمِعكِ ما لَيسَ يَفنى",22,"ن",2,0],["أَسنَدَ تَدبيرَها إِلى رَأيِهِ ال","جَزلِ فَنِعمَ العِمادُ وَالسَنَدُ",23,"د",1,0],["أَسَنَّتْ فِي سِيَادَتِهَا فَشَنَّتْ","عَلَيْهَا الْحَمْدَ وَهْوَ أَجَلُُّ زَرْدِ",24,"د",1,0],["أَسْنَاهُمُ خَلْقاً وَأَحْسَنُهُمْ","خُلُقاً وَأَخْلَقُهُمْ بِتَنْفِيسِ",25,"س",1,0],["أَسِنَّتُهُم وَاللَيلُ نَقعٌ نُجومُهُ","رُجومٌ بِأَكبادِ الأَعادي أَوافِلُ",26,"ل",1,0],["أسنَى به دَهْري العطِيْ","يةَ لي وجودُ الدَّهرِ نَزر",27,"ر",1,0],["أسناء برق لاح أم","ثغر الحبيب لنا ابتسم",28,"م",1,1],["أَسِنَّتُها للمُهْتَدِينَ كواكِبٌ","وأَعلامُها للمُسْلِمينَ مَعَالِمُ",29,"م",1,0],["أسنده نصر إلى مقلد","عن منقذ وهو أبو أشباله",30,"ل",2,0],["أَسناهُمُ نَسَباً أَزكاهُمُ حَسَباً","أَعلاهُمُ قُرَباً مِن بارِئِ النَّسَمِ",31,"م",1,0],["أسنى الورَى نسباً أوفَى الملا رُتَباً","عفوٌ لهُ عَجَباً عن وِزْرِ مُجتَرِمِ",32,"م",1,0],["أَسْنَى الملوكِ عَطايا كُلَّما نفِدَت","وأَشرفُ الخَلْق جوداً كلَّما عَدَلا",33,"ل",2,0]]}