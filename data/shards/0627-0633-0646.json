ttps://poetry.dctabudhabi.ae/diwan/poem/95370","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95330","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40129","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111051","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36384","الدوبيت"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123515","البسيط"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22105","الخفيف"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134252","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62093","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139471",""],[4797,"ياصاحبي والله ماعندي سنااب","https://www.poetsgate.com/ViewPoem.aspx?id=180555",""],[4578,"زف المدام على الصفا خدٍ وقد","https://www.poetsgate.com/ViewPoem.aspx?id=49400",""],[4578,"مصر الغرام فؤادي في هوى الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49405",""],[4927,"يا قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4540",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[307,"مساءُ البهاء","https://www.poetsgate.com/ViewPoem.aspx?id=213699",""],[5411,"غربة..","https://www.poetsgate.com/ViewPoem.aspx?id=191552",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5621,"صلاة الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=24567",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[6152,"مناجاة العشر الأواخر","https://www.poetsgate.com/ViewPoem.aspx?id=204735",""],[242,"فرجت من همي ومن بوسي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563732",""]],"verses":[["أَسِنَّةُ فِهرٍ في صُدورِ جِيادِهِم","كَأَنَّ قَناها لِلجِيادِ مَقاوِدُ",0,"د",1,0],["أَسِنَّةُ هَذا المَجدِ آلُ المُهَلَّبِ","وَفُرّاطُهُ في كُلِّ شَرقٍ وَمَغرِبِ",1,"ب",1,1],["أَسَنى ضَوءِ صُحرَةَ بِالفُقرَةِ","أَبصَرتَ أَم تَنَصُّبَ بَرقِ",2,"ق",1,1],["أَسنانُها أُضعِفَت في حَلقِها عَدَداً","مُظَهَّراتٌ جَميعاً بِالرَواويلِ",3,"ل",1,0],["أَسِنَّتُهُ إِذا لاقى طِعاناً","صَوارِمُهُ إِذا لاقى ضِرابا",4,"ب",2,0],["أسْنِدْ إليّ تجدْني","كبعض من تَسْتسِدُّ",5,"د",1,0],["أسندتْ ركنَها إليه فأرسى","ولقد كان زالَ كُلَّ مزالِ",6,"ل",1,0],["أسِنَّتُها نُوَّارُها وثمارُها","جماجمُ والأغصانُ بوعٌ وأذرُعُ",7,"ع",1,0],["أَسنِد صُدورَ اليَعمَلاتِ بِوَقفَةٍ","في الماثِلاتِ كَأَنَّهُنَّ المُسنَدُ",8,"د",1,0],["أَسنى صَنائِعَهُ إِلَيَّ وَما يَني","أَثَرٌ يَلوحُ عَلَيَّ مِن آثارِهِ",9,"ر",2,0],["أسنّةُ الأعداءِ في حربه","أطعنُ منها إبَرٌ في ثمام",10,"م",1,0],["أسنانُهُ كاللؤلؤِ المفتنِّ","منَ المفاريدِ لجبرِ الوهنِ",11,"ن",1,0],["أَسِنَّةٌ غَيرُ مُنَكَّساتٍ","مِن قَصَبِ الريشِ مُجَرَّداتِ",12,"ت",1,0],["أَسنى فِعالِكَ ما أَرَدتَ بِفِعلِهِ","رَشداً وَخيرُ كَلامِكَ التَسبيحُ",13,"ح",1,0],["أَسُنَّتُنا المَآلُ إِلى صَعيدٍ","فَما بالُ الأَسِنَّةِ وَالصِعادِ",14,"د",1,0],["أَسنَيتُ مِن مَرِّ السِنينَ وَلَم أُرِد","أَسنَيتُ مِن ضَوءِ السَنا البَهّارُ",15,"ر",1,0],["أُسِندُ ظَنِّي إلى المليكِ ومَن","يَلجَا إلَيهِ فلَم يَنَلهُ الضُرّ",16,"ر",1,1],["أسْنِدوا «البيتَ» بالصدور، فقد ما","دَ، وخانتْ جدرانهنَّ الدَّعائم",17,"م",1,0],["اسنم يَمَسُّ من القلوب شَغافها","فكأن أحرفه انتظمْن نشيدا",18,"د",2,0],["اسنى الفضائل يبدي شر صفحته","كان ضد الرزايا دونه كلل",19,"ل",1,0],["أَسَنَا ضَوْءِ نَارِ صُحْرَة َ بالقُفْ","رَة ِ أَبصرتَ أمْ تَنصَّبَ بَرقُ",20,"ق",1,1],["أسنَى صَلاَةٍ وتَسلِيمٍ بِهِ حُلِيَت","عَلَى الخُلاَصَةِ مِن أَبنَاءِ عَدنَانِ",21,"ن",1,0],["أسنَى سَلاَمٍ شَذَاهُ مِن شَمَائِلِهِ","وَمِن سَنَاهُ سَنَاهُ الكَاسِفُ القَمَرِ",22,"ر",1,0],["أَسنِدي رَأسَكِ الجَميلَ إِلى صَد","ري وَأَصغي أُسمِعكِ ما لَيسَ يَفنى",23,"ن",2,0],["أَسنَدَ تَدبيرَها إِلى رَأيِهِ ال","جَزلِ فَنِعمَ العِمادُ وَالسَنَدُ",24,"د",1,0],["أَسَنَّتْ فِي سِيَادَتِهَا فَشَنَّتْ","عَلَيْهَا الْحَمْدَ وَهْوَ أَجَلُُّ زَرْدِ",25,"د",1,0],["أَسْنَاهُمُ خَلْقاً وَأَحْسَنُهُمْ","خُلُقاً وَأَخْلَقُهُمْ بِتَنْفِيسِ",26,"س",1,0],["أَسِنَّتُهُم وَاللَيلُ نَقعٌ نُجومُهُ","رُجومٌ بِأَكبادِ الأَعادي أَوافِلُ",27,"ل",1,0],["أسنَى به دَهْري العطِيْ","يةَ لي وجودُ الدَّهرِ نَزر",28,"ر",1,0],["أسناء برق لاح أم","ثغر الحبيب لنا ابتسم",29,"م",1,1],["أَسِنَّتُها للمُهْتَدِينَ كواكِبٌ","وأَعلامُها للمُسْلِمينَ مَعَالِمُ",30,"م",1,0],["أسنده نصر إلى مقلد","عن منقذ وهو أبو أشباله",31,"ل",2,0],["أَسناهُمُ نَسَباً أَزكاهُمُ حَسَباً","أَعلاهُمُ قُرَباً مِن بارِئِ النَّسَمِ",32,"م",1,0],["أسنى الورَى نسباً أوفَى الملا رُتَباً","عفوٌ لهُ عَجَباً عن وِزْرِ مُجتَرِمِ",33,"م",1,0],["أَسْنَى الملوكِ عَطايا كُلَّما نفِدَت","وأَشرفُ الخَلْق جوداً كلَّما عَدَلا",34,"ل",2,0],["أَسند الفعل لِلطَبيعة كفراً","بِالمعز المذل رَب العِباد",35,"د",1,0],["أسنى صديقٍ للصّداقةِ قائِمٍ","كالشعر بالأوتاد والأسباب",36,"ب",1,0],["أَسنى الأَماني كُلِّها","وَأَجَلُّ مِنها ما يُنالْ",37,"ل",1,1],["أَسنى صَديقك شَخصٌ لَستَ تَعرفُهُ","وَمَن عَرَفت فَصاحِبْه عَلى دخلِ",38,"ل",1,0],["أَسنى الهديّةِ لَيمونٌ حُبيتَ بِهِ","مِقدارُهُ مِن بُحورِ الجودِ مَضنونُ",39,"ن",1,0],["أَسنى الصّلاةِ وَالسّلامْ","ما مالَ نَجمٌ لِلمَغيبْ",40,"ب",1,0],["إِسنادها عَن كُلِّ ثَبتٍ حافِظٍ","ثِقَة صَدوق في البرِيَّةِ خَيّرِ",41,"ر",1,0],["أسنانُها مائةٌ أو زِدْن واحدةً","كأنّها حين يبدو وَجْهُها غُولُ",42,"ل",1,0],["أَسِنَّةٌ خُضِّبَت أَطرافُها بِدَمٍ","أَو دَستَجٌ نَزَعوهُ مِن جِراحاتِ",43,"ت",1,0],["أسنيت أعطية العفاة من اللهى","كرما وأَدنيت الرَّجاء النازحا",44,"ح",2,0],["أسنى السلام عليه ما هبت صبا","وشدا على الأغصان ورق حمام",45,"م",1,0],["أَسْنَى البَرِيّةِ أَفْعالاً وأَفْصحُ أَقْ","والاً وأَرْجَحُ أَخْوالاً وأَعْماماً",46,"م",2,0],["أسنى مُلوك الوَرى في بابِ حضرَتِهِ","يَغُضُّ طَرفاً وَيَحكي أَصغَر الخَدمِ",47,"م",1,0],["أسنا خدَّيهِ أبدى لهبا","أم سنا الكاس لهم أبدى ضَراما",48,"م",2,0],["أَسِنَّةٌ زُرقٌ بِأَجفانِهِ","أَم جالَتِ البيضُ المَصاليتُ",49,"ت",1,0],["أسِنَّتُهَا 