{"poems":[[47,"عمرت أبا إسحاق ما صلح العمر","https://www.aldiwan.net/poem63637.html","الطويل"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84874","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66510","المجتث"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127188","المجتث"]],"verses":[["فَلِم جِئتُ طَوعَ الشَوقِ مِن بُعدِ غايَتي","إِلى غَيرِ مُشتاقٍ وَلَم رَدَّني بِشرُ",0,"ر",1,0],["فَلِم جَزوهُ بختلٍ","وَلِم لَقوهُ بِغَدرِ",1,"ر",1,0],["فَلمجد وَالده الهَنا بسعوده","وَبِهِ يَنال الفَضل أَشرَف مَقصَد",2,"د",1,0],["فلم جفوت إلى أن","لحالي الصخر رَقّا",3,"ق",2,0],["فلم جفوت إلى أن","لحالي الضحر رقا",4,"ق",2,0]]}