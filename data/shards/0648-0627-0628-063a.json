{"poems":[[55,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[57,"ألا تعجبون كما أعجب","https://www.aldiwan.net/poem26533.html","المتقارب"],[79,"وقف الغرام على ثناك لساني","https://www.aldiwan.net/poem36047.html","الكامل"],[44,"أحبب إذا أحببت حبا مقاربا","https://www.aldiwan.net/poem50403.html","الطويل"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"خير أيام الفتى يوم نفع","https://www.aldiwan.net/poem62155.html","الرمل"],[68,"لا تصاحب من الأنام لئيما","https://www.aldiwan.net/poem38588.html","الخفيف"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[131,"أعباس إن الذي بيننا","https://www.aldiwan.net/poem24257.html","المتقارب"],[147,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[154,"عن الحب في الهادي استحال سلونا","https://www.aldiwan.net/poem68587.html","الطويل"],[173,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[185,"مللت بصنعاء الأحاديث والمنى","https://www.aldiwan.net/poem59054.html","الطويل"],[203,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[354,"كن كالزناد يقد نارا قحه","https://www.aldiwan.net/poem15606.html","الكامل"],[376,"رأى الورد من خديه يحتمل المحلا","https://www.aldiwan.net/poem57230.html","الطويل"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[438,"وأبغضت فيك النخل والنخل يانع","https://www.aldiwan.net/poem12426.html","الطويل"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[447,"وقيت ببردي ظهر جلدي على البرد","https://www.aldiwan.net/poem14365.html","الطويل"],[447,"عزاء وتسليما وصبرا فما يجدي","https://www.aldiwan.net/poem14446.html","الطويل"],[466,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[469,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[479,"وإني لأقري الهم حين يضيفني","https://www.aldiwan.net/poem2167.html","الطويل"],[543,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[556,"إلى كم أقود قوما","https://www.aldiwan.net/poem47833.html","المضارع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138716",""],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119313","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16849","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65037","الرمل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6762","المتقارب"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124311",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49956","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114027","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52074","الرجز"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20467","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200236","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205061","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204709","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204446","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204433","المتقارب"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/82777","السريع"],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11298","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123931","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110035","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18716","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114311","البسيط"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17777","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54369","الكامل"],[4227,"","https://poetry.dctabudhabi.ae/diwan/poem/144290","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73423","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83464","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83200","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58146","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72608","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72428","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72482","الكامل"],[4931,"شاعِر عنِادي","https://www.poetsgate.com/ViewPoem.aspx?id=32631",""],[4971,"وأَبِغضُ الضَّيْفَ ما بي جُلُّ مَأْكِله","https://www.poetsgate.com/ViewPoem.aspx?id=82620",""],[5185,"شمس العماد","https://www.poetsgate.com/ViewPoem.aspx?id=118566",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5302,"ولي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=200125",""],[592,"سؤال فهل مفت من القوم ينظم","https://www.poetsgate.com/ViewPoem.aspx?id=128819",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5431,"خيمة بؤسٍ...وقصعةِ بردِ","https://www.poetsgate.com/ViewPoem.aspx?id=183414",""],[5480,"(هذا الزمن) في غلاء المهور","https://www.poetsgate.com/ViewPoem.aspx?id=4166",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5689,"لمذا خلقت لماذا أعود","https://www.poetsgate.com/ViewPoem.aspx?id=143408",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[6093,"فمن باع ودي ليس عندي كمن شرى","https://www.poetsgate.com/ViewPoem.aspx?id=203940",""],[6123,"تناهوا فاسألوا ابن أبي البيد","https://www.poetsgate.com/ViewPoem.aspx?id=84627",""],[5724,"ثوروا على الباغي الذليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55147&r=&rc=14",""]],"verses":[["وَاِبغِ العُلى أَبداً فَكَم طَلَبٍ","قَد باتَ مِن نَيلٍ عَلى صَدَدِ",0,"د",1,0],["وَأَبغي رِضاهُ عَلى جَورِهِ","فَيَأبى عَلَيَّ وَيَستَصعِبُ",1,"ب",1,0],["وَابْغِ المَزِيدَ بشْكُرِ رَبِّكَ ولتَثِقْ","بِمُضَاعَفِ الإِنْعَامِ وَالإِحْسَانِ",2,"ن",1,0],["وَأَبغِض إِذا أَبغَضتَ بُغضاً مُقارِباً","فَإِنَّكَ لا تَدري مَتى أَنتَ راجِعُ",3,"ع",1,0],["وابغ ازدياداً بنشْر أنعُمها","لا تخف إحسانها فتكفُرَها",4,"ر",3,0],["وَاِبغِ ما اِستَعتَ عَنِ الناسِ الغِنى","فَمَنِ اِحتاجَ إِلى الناسِ ضَرَع",5,"ع",1,0],["وَاِبغِ مِنهُم مُجانِساً يوجِبُ الضَم","مَ فَقَد يَصحَبُ الكَريمَ الكَريمُ",6,"م",1,0],["وَأَبغَى عَلى زَوجٍ لَئِيمٍ كِلاَهُما","إِذَا التَمرُ في أَعفَاجِهِنَّ تَقَرقَرا",7,"ر",2,0],["وأبغضْتُ فيكِ النّخْلَ والنخلُ يانعٌ","وأعْجَبَني مِن حُبّكِ الطلْحُ والضّال",8,"ل",1,0],["وَأَبغِض إِلَيَّ بِأَتَيانِها","إِذا أَنا لَم أَنسَها أُدفَعُ",9,"ع",1,0],["وَاِبغِ النَباهَةَ وَالثَراءَ بِعَزمَةٍ","لَم يَثنِها لَومٌ وَلا تَفنيدُ",10,"د",1,0],["وَأَبغَضَ رَبُّ العَرشِ مَن لَم يُحبَّهُ","وَلَولا هَوىً فيهِ تَحَرَّيتُ كَسبَهُ",11,"ه",1,0],["وَأَبغَضُ شَيءٍ عِندَهُ لا وَإِنَّهُ","لِيَهوى نَعم لَو أَنَّ فيها ثَوى العُمرِ",12,"ر",1,0],["وَأبغضتُ أَصوَاتاُ بها أَعجَمِيَّةً","وَزُرقاً لراياتِ الإِمارةِ ذُوَّدَا",13,"د",2,0],["وأَبغضتُ فيكِ الليل من أَجلِ كوكبٍ","على ظلمات الحزن فيهِ تبسما",14,"م",2,0],["وَاِبغِ المَسيرَ إِلى العُلى كَالنَفسِ في","أَفكارِها وَالجِسمُ مِنها قاعِدُ",15,"د",1,0],["وأَبغَضُ شَيءٍ فيهِ شَيءٌ أُحِبُّهُ","فَياطَيفَه أَهلاً وَيا لَيلُ لا أَهلا",16,"ل",2,0],["وابغي الدنوَّ من الأَتونِ المُصطلي","أي قلبيَ المشحونِ كلَّ ذَكاء",17,"ا",2,0],["وأَبغضت فيكِ النَّخْلَ والنَّخلُ يانعٌ","ويُعْجِبُنِي من أَجلِكِ السِّدْرُ والضَّالُ",18,"ل",1,1],["وأبغضت من حبي لهم يانع الأشى","ومن أجلهم أهوى السماوة والصعوى",19,"و",2,0],["وأبغض من عادى الإله وحزبه","ولو أن ولدي أو أبي كان أو جدي",20,"د",2,0],["وأبغض محبوب إِذا حل في الثَرى","وأَمسى بذاك الترب ممترع الخد",21,"د",1,0],["وأبغي بزوْراء العراقِ مَسَرَّةً","ومن يَبْغِها يوماً ببغداد يجْهلِ",22,"ل",1,0],["وأبغي شفاءً بالشفاه وأتقى","فريقكِ معسولٌ وقدك عسّال",23,"ل",1,0],["وأبغي صواب الظّنّ أعلم أنّه","إذا طاش ظنُّ المرء طاشت مقادره",24,"ر",2,0],["وأَبغَضُ ما عندِي التحبُّبُ مِنهُمُ","وبُغضُهمُ واللهِ عندِي هُوَ الحبُّ",25,"ب",1,0],["وأبغِي صلاحَ شأنِي","بمنْ همُّه فسادِي",26,"د",2,0],["وأَبغضَ العيشَ ذو اللبِّ الأصيل وما","إِن أبغض العيشَ إِلاّ بعدما بغُضا",27,"ض",2,0],["وأبغى وفاء ليس يبغون بعضه","وأحمل جورا في ولاهم وأعدل",28,"ل",1,0],["وابغ الكفاح لنصره","ان شاط ظلماً بالشطط",29,"ط",1,0],["وَاِبغِ مِنَ العَيشِ ما تُسَرُّ بِهِ","إِن عَذَلَ الناسُ فيهِ أَو عَذَروا",30,"ر",3,0],["وابْغِ أُخْرى دائمٌ في","ها نَعيمٌ وشَقاءُ",31,"ا",2,0],["وَأَبغَضتُ نَفسي لِعِصيانِها","وَعاتَبتُها بِأَشَدِّ العِتابِ",32,"ب",1,0],["وأَبغض أيام الضلال جميعَها","ولا سيما يوماً بدارة جلجل",33,"ل",1,0],["وأَبغي مداراةَ الرَّفيق كأنّني","لمن اْبتغي منه الوصالَ مُجاهِدُ",34,"د",1,0],["وابغض الكاشحَ هوناً ما عسى","ان يُرى بعدُ لكَ الخِلّ الأوَد",35,"د",1,0],["وَأبغَضُ الناسِ لَهُمْ","وَاشٍ أتَى بِالخَلَلِ",36,"ل",1,0],["وَأَبغض بَغيضكَ بُغضاً رُوَيداً","إِذا أَنتَ حاوَلتَ أَن تَحكُما",37,"م",2,0],["وأبغض أن أرى المرآة كيلا","ينغّص وحدتي فيها خيالي",38,"ي",1,0],["وأبغض كل مخلوق أراه","كأن الخلق كلهم عداتي",39,"ت",2,0],["وأبغي الركض مثلهموا فأعيى","وأعجز إن أطِلْ معهم مسيرا",40,"ر",2,0],["وأبغضت الجميل لأن حبي","به يختص من دون الدميم",41,"م",1,0],["وأبغض هذين بغض العدى","وأهواهما مثل معشوقتي",42,"ي",1,0],["وَاِبغوا وَجوروا واِرجموا واصلبوا","فَالرّوحُ فينا جَوهَرٌ لا يُضام",43,"م",1,0],["وأبغض أعداءه الناكثين","كبغض البنان لوجه الإباب",44,"ب",1,0],["وابغ المكاسبَ من أزكى مطالبها","من حيث تحمدُ حتى ينفدّ الأجلُ",45,"ل",1,0],["وابغ البقا بالفنا تبسط بنيل منى","على بساط الهنا في ظل عزهم",46,"م",1,0],["وابغ الختان لسبع ان اردت وخذ","شعرا وزنه بورق او ذهيبهم",46,"م",1,0],["وابغي حديثك لي مع لقاك","فارعى الثريا معا والقمر",47,"ر",1,0],["وابغِ الكَمالَ بما تنحوهُ من عَمَلٍ","ان الكَمالَ يُرَى في كالم العَمَلِ",48,"ل",1,0],["وابغِ الصِراعَ لأَنَّهُ","من شِيمةِ الشهمِ الشجيعِ",49,"ع",1,0],["وَأَبغَض أَخلاق النِساءِ أَشَدَّهُ","إِلَيَّ فَلا تولن أَهلي تَشَدُّدا",50,"د",2,0],["وَابْغِ الخُمُولَ تَرُقْ لَكَ الخَمَائِلُ مِنْ","مُنَاكَ لَيْسَ لَهَا فِي الروَّضِ مِنْ مَثَلِ",51,"ل",1,0],["وَأُبغِضُ إِرقاصاً إِلى رَبِّ دارِهِ","لَئيمٌ لَهُ كِتَّانَتانِ وَمِطرَفُ",52,"ف",1,0],["وابغوا لحرّانَ الخلاصَ فكم بها","حرّانُ قلبٍ نحوكم مُلتاحُهُ",53,"ح",2,0],["وابغ العلى بفوارس قد آثروا","لثم الرماح على الظباء الكنس",54,"س",1,0],["وابغِ التكسُّبَ مع عِلمٍ ليَحرُسَهُ","إنَّ التكسبَ فيه عزَّةُ الرَّجُل",55,"ل",1,0],["وَأُبغضُ مَن بِهِ أَثَرُ الَمعاصي","وإِن كُنَّا سَواءً في البِضاعَة",56,"ه",1,0],["وَاِبغِ الوَسيلَةَ بِاِنتِصا","رِكَ أَن قصدت أجلَّ ناصِر",57,"ر",1,0],["وَاِبغِ بِهِ الإِكراما","وَصِل بِهِ الأَرحاما",58,"م",2,0],["وَاِبغِ ثَراءَ العِلمِ حَيثُ كانا","فَاللَهُ لَم يَخصُص بِهِ إِنسانا",59,"ن",2,0],["وابغِ السلامةَ واعتبرْ بمن انقضى","أين الأكاسرة الذين تقدموا",60,"م",3,0],["وابغ الكرامة في ترك الفخار به","فأكرم الناس عند الله أتقاها",61,"ه",2,0],["وابغ رضا الله في مدح تقدمه","لفارق بين مفضال ومفضول",62,"ل",1,0],["وابغ لنفسك ما ترقيها به","والجسم دعه في الحضيض الاسفل",63,"ل",1,0],["وابغيك تنسى الحزن متّييب لبعاد","تجعل ليال الحبّ يالنّاي نادي",64,"د",2,0],["وأَبِغضُ الضَّيْفَ ما بي جُلُّ مَأْكِله","إلا تَنَفُّجُهُ حَوْلِى إِذا قَعَدَا",65,"د",2,1],["وابغ الكمال بأحمد ، واذكر نهى","فنساء مصر لمصر أول بارقه",66,"ق",2,0],["وأبغض يوم تنأي وال","زيّانب كلّها سمج",67,"ج",1,0],["وأبغض مخدوعا يعض اليد التي","رعته وقد مد الذراع لعميان",68,"ن",1,0],["وأبغض أهل الكفر لكن أخافهم","فلست أريهم ما يسيء ويولم",69,"م",1,0],["وأبغضهم في الله جل جلاله","كما قد أحب المهتدين وما غفل",70,"ل",1,0],["وأبغض حقاً قلوباً كصخرٍ","تَراني وتمضي لأصلبَ وحدي",71,"د",2,0],["وأبغى لها كوشه عسى عمرك طويل","وانته تعرف هالبنت عندي لوحده",72,"د",2,0],["وَأَبْغَضُ ما يَكُونُ عَلَى الغَوانِي","سَوادُ مَفارِقٍ أَضْحَى بَياضَا",73,"ض",2,0],["وأبغي على الدهر حتى يثور","ضجرت وقلت زماني لدود؟",74,"د",1,0],["وأبغضتُ حتى ريقَ سحابةٍ","ولاسيما إن رقَّ في لعس الظل",75,"ل",1,0],["وأبغضُ مِهذاراً صفيقاً مخبَّلاً ًً","تَخالُ حديثَ الغِرِّ سيلاً مُثرثرا",76,"ر",2,0],["وأبغض من وضعت إليّ فيه","لساني معشر منهم أذود",77,"د",1,0],["وابغوا الحياة كريمة","في ظل دستور نبيل",78,"ل",1,0]]}