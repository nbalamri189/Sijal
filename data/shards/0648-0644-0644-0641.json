{"poems":[[55,"ورب غاو رميت منطقه","https://www.aldiwan.net/poem29914.html","المنسرح"],[55,"لاموا ولو وجدوا وجدي لقد عذروا","https://www.aldiwan.net/poem30432.html","البسيط"],[65,"إلى الأمن يفضي بالفتى ما يحاذر","https://www.aldiwan.net/poem45876.html","الطويل"],[65,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[65,"خليلي مس المطايا لغب","https://www.aldiwan.net/poem46120.html","المتقارب"],[65,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[95,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[95,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[56,"نصحت فأخلصت النصيحة للفضل","https://www.aldiwan.net/poem27501.html","الطويل"],[90,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[74,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[74,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[47,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[82,"ثلاثة أفلاك عن العين مضمره","https://www.aldiwan.net/poem31435.html","الطويل"],[89,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[33,"أباكرة في الظاعنين رميم","https://www.aldiwan.net/poem41810.html","الطويل"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[50,"طرحتم من الترحال ذكرا فغمنا","https://www.aldiwan.net/poem66141.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[56,"نصحتُ فأخلصتُ النصيحة َ للفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=14464",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[33,"أَبَاكِرَة ٌ في الظَّاعِنينَ رَمِيمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19059&r=&rc=322",""],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[285,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[333,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[422,"إن جئت آل سلمى أو مغانيها","https://www.aldiwan.net/poem54145.html","البسيط"],[438,"ألحق بنفسج فجري وردتي شفقي","https://www.aldiwan.net/poem12386.html","البسيط"],[438,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[445,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[457,"وافى الربيع بترنام الفواخيت","https://www.aldiwan.net/poem13672.html","البسيط"],[466,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[551,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[580,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86758","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86752","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137662",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48745","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70686","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59691","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133828","الوافر"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130713","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49933","البسيط"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100976","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101069","المجتث"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77679","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52088","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109776","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47188","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60981","الطويل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102160","المجتث"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100775","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54428","المتقارب"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204236","الطويل"],[4674,"سعوا لنيل العلا","https://www.poetsgate.com/ViewPoem.aspx?id=210593",""],[4782,"أحجية الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206799",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5756,"أول الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=5365",""],[5851,"وصية مرتحلة","https://www.poetsgate.com/ViewPoem.aspx?id=175272",""],[6045,"شباب الحلوة","https://www.poetsgate.com/ViewPoem.aspx?id=123996",""]],"verses":[["وَلِلفَتى مِن وَقارِهِ جُنَنٌ","إِن كَثُرَت مِن عَدوٍ الشِكَكُ",0,"ك",1,0],["وَلِلفَتى في ظَلامِ اللَيلِ مَعذِرَةٌ","وَما لَهُ في الضُحى إِن ضَلَّ مِن عُذُرِ",1,"ر",1,0],["وَلَلْفَقْرُ خَيْرٌ مِنْ غِنىً في مَذَلَّةٍ","إِذا أَخَذَتْ مِنّا الجُدودُ العَواثِرُ",2,"ر",1,0],["وَلَلْفَقْرُ خَيْرٌ مِنْ أَبٍ ذي دَناءَةٍ","إذَا هُزَّ لِلْفَخْرِ ابْنهُ عادَ مُفْحَما",3,"م",2,0],["ولِلْفَخْرِ أُعْنى بِهِ لا الغِنَى","فَعَنْ كِسْرِ بَيْتيَ جِيبَ العَرَبْ",4,"ب",1,0],["وللفؤادِ وَجيبٌ في جَوانِبهِ","كما يَهُزُّ الجَناحَ الطائِرُ الحَذِرُ",5,"ر",1,0],["وَلِلفُقراءِ عائِدَةٌ وَرُحمٌ","وَلا يُقصى الفَقيرُ وَلا يَعيلُ",6,"ل",1,0],["وَلِلْفِكْرِ وَالإِفْصَاحِ عَنْهُ طَرَائِفٌ","دَوَانِي قُطُوفٌ لِلْمُجِدِّيَنَ فِي الطَّلَبْ",7,"ب",1,0],["وَلِلفِدَى كَالنَّدَى حَالٌ مُنَزَّهَةٌ","فِي حُكْمِهَا يَنْفُسُ المَجْهُولُ مَعْلُومَا",8,"م",2,0],["وَلِلفَضلِ في الفَضلِ اِبنِ يَحيى مَواعِظٌ","إِنِ اِتَّعَظَ الفَضلُ اِبنُ مَروانَ بِالفَضلِ",9,"ل",1,0],["وللفقر بين الناس وجهٌ تبينّت","به حسنات المرء وهي ذنوب",10,"ب",1,0],["وللفظه يزداد رأي مديره","وحجاه وهو القهوة الصهباء",11,"ا",2,0],["وللفظة عمرية عمرية","بين البيان تجول والتبيين",12,"ن",1,0],["وَلِلفَجعِ العَتيقِ مُحَرِّكاتٌ","مُهَيَّجَةٌ مِنَ الفَجعِ الجَديدِ",13,"د",1,0],["وَلِلفَتى مُهلَةٌ في الحُبِّ واسِعَةٌ","ما لَم يَمُت في نَواحي رَأسِهِ الشَعرُ",14,"ر",1,0],["وللفلك النّارِيِّ مِنهُنَّ كَفَّةٌ","ترى النّارَ فيها للبخور مُسَعّره",15,"ر",2,0],["وَلِلْفَتَى مُهْلَةٌ فِي الدَّهْرِ إِنْ ذَهَبَتْ","أَوْقَاتُهَا عَبَثَاً لَمْ يَخْلُ مِنْ نَدَمِ",16,"م",1,0],["وَلِلفِتيَةِ اِنحازوا قَليلاً فَإِنَّهُ","لَنا في أُمورٍ قَد خَلَونَ ظَلومُ",17,"م",1,0],["وَلِلْفَجَاجِ وَحُمْلاَنِ النَّعاجِ","وَأَطْيارِ الدَّجاجِ وَأَنْواعِ السَّمامِينِ",18,"ن",1,0],["وَلِلفَضلِ صَولاتٌ عَلى صُلبِ مالِهِ","تَرى المالَ فيها بِالمَهانَةِ مُذعِنا",19,"ن",2,0],["وَلِلفَضلِ حِصنٌ في يَدَيهِ مُحَصَّنٌ","إِذا لَبِسَ الدَرعَ الحَصينَةَ وَاكتَنى",19,"ن",2,0],["ولِلْفُؤَادِ وجِيبٌ تَحْتَ أَبْهَرِهِ","لدْمَ الوَلِيدِ وَرَاء الغَيْبِ بِالحَجَرِ",20,"ر",1,0],["وَلِلْفَوَاخِتِ فِي أَفْنَانِهَا هَزَجٌ","قَدْ مَاجَ مِنْ لَحْنِهِنَّ السَّهْلُ وَالْفُرُطُ",21,"ط",1,0],["وللفَضْلِ في الفضْلِ بنِ يحيى مَواعظٌ","إن اتعظَ الفضلُ بنُ مروانَ بالفضلِ",22,"ل",1,0],["وللفلك الأسمى ، فضول لسرها","ففي كلّ نجم منه عين رقيب",23,"ب",1,0],["وَلِلْفِتْيَة ِ: کنْحَازُوا قَليلاً فَإنَّهُ","لنا في أمورٍ قد خلونَ ظلوم",24,"م",1,0],["وَلِلفَتى مِن مالِهِ ما قَدَّمَت","يَداهُ قَبلَ مَوتِهِ لا ما اِقتَنى",25,"ا",1,0],["وللفضل أيضاً في معاوية أعتقد","ردافته تفضيلها لا يضيع",26,"ع",1,0],["وَلِلْفُصُوصِ جَوْلَةٌ وَصَوْلَةٌ","تُحَيِّرُ الأَلْبابَ أَوْ تُطِيشُها",27,"ش",3,0],["وللفكر الجموح خطا","أميّزها فأضطرب",28,"ب",1,0],["وللفكر الجموح أعي","ش ما يثنيني النصب",28,"ب",1,0],["وللفَضْلِ ما تَنفكُّ تُعنَى بأهلِه","عنايةَ مِفْضال كثيرِ التَكَرُّم",29,"م",1,0],["وللفضائل أهلٌ في الورى أبداً","وما برحتم مدى الأيام أهليها",30,"ي",3,0],["وللفتوحِ من الخيراتِ أَجْمَعُها","أَبو الفتوحِ الذي صُفِّي من الرَّنَقِ",31,"ق",1,0],["وللفتى بالموتِ شُغْل فما","يصنعُ باللَدْنِ وبالمُرهَفِ",32,"ف",1,0],["وللفجائِعِ أَقدارٌ وأَفْجَعُها","للنَّفْسِ حَيْثُ ترى أَظفارَها تَقَعُ",33,"ع",1,0],["وللفواقع أحداق بلا هدب","من اللجين كأحداق المباهيت",34,"ت",1,0],["وللفتى حالةٌ تَنْضوهُ شيمتُه","رغماً وما كل إعراضٍ من المَلَلِ",35,"ل",1,0],["ولِلْفَتى غائِلٌ يَغُولُهُ","يا ابْنَةَ عَجْلانَ مِنْ وَقْعِ الحُتُومْ",36,"م",1,0],["وللفَمِ مِنِّي دُيونُ عليه","بغير الأَسِنَّةِ لا تُقْتَضَى",37,"ض",2,0],["وللفتق في الأفلاك مبدا نهاية","وفيه نهايات قضت ببداية",38,"ه",1,0],["وَللفلك الأَعلى مِن الأَرض أَسرَعَت","نُجوم شَواريخ بِها الرَكب يَهتَدي",39,"د",2,0],["وَللفطن البروجي باحتشام","غناءٌ في مَعانيها تَليد",40,"د",1,0],["وللفور أبلغ باردي فنستن","مولى الجنود ليرسل جندا",41,"د",2,0],["وللفريق الذي أدلى بحيلته","فضل الفريق الذي أدلى بتهديد",42,"د",1,0],["وللفلَكِ الدوَّار عظم عجائب","وفي دهرنا للدائراتِ مدارُ",43,"ر",1,0],["وللفوز بالعز المنيف تواضعوا","أقولُ وَهبهم أقدموا أو تراجعوا",44,"ع",3,0],["وللفتى يوشع في الأفق قد وقفت","شمس النهار لأمر فيه تعجيل",45,"ل",1,0],["وللفحشاء تصهال طويل","وغرغرة وعصف في الجبال",46,"ل",1,0],["وللفقيرِ وجوهٌ ليس يحصرُها","عدّ وكلّ وجود فهو واديه",47,"ي",2,0],["وللفرقدين به نسبة","فلا تنس ذكر الكرام الجياد",48,"د",1,0],["وللفتى بين رَيْعانِ الصَّبا سُبُلٌ","إلى مِقَات الغواني غير ممقوتِ",49,"ت",1,0],["وللِفاروُقِ رُجحان وفَضلٌ","على عُثمَانَ ذي النورينِ عالي",50,"ل",2,0],["وللفضل والإحسان والبأس \"سبق\"ه","وللملك والإسلام والعلم عضدُه",51,"د",2,0],["وللفصاحة من ألفاظه دررٌ","تغلو فراشدها من غير تنضيد",52,"د",1,0],["وللفضائل فيه","مجلى حسان الحسان",53,"ن",1,0],["وَلِلفَجر نَهرٌ خاضهُ اللَيل فَاِعتَلَت","شوى أَدهَم الظَلماءِ مِنهُ حُجُولُ",54,"ل",1,0],["وللفارس المدعو نخوة فارس","يرافقه الرفقي في مُلتقى الوعر",55,"ر",1,0],["وللفنا حينما حالي به وصلا","اصبحتُ الطف من مر النسيم على",56,"ا",1,0],["وللفرع بالأصل ابتداءٌ وحيثما","تكامل أصلُ المرء فالمرء تَابِعُ",57,"ع",1,0],["وللفلك الجوال بالناس جولة","كما ذكروا والأمرُ من بعدِه الأمر",58,"ر",1,0],["وللفقير حنين","بجنبهم وأنين",59,"ن",1,0],["وللفراق ذهول في مواقفه","كم يضحك المرء أحياناً وينتحب",60,"ب",1,0],["وللفقير وجوه ليس يحصرها","غير الحبيب مفيض الفضل مسديه",61,"ي",2,0],["وَلِلفُلكِ وَالخَيمِ حالاً سَعى","يَرومُ قَناةً بِها اِستَودَعا",62,"ع",2,0],["وللفضلِ في سوقِ أَفضالهِ","بضائعٌ نافقةٌ نافعَهْ",63,"ع",2,0],["وللفطر رسم للسرور وسنّة","ومثلك من أحيا لنا سنة الفطر",64,"ر",1,0],["وللفتى في حقوقِ اللهِ موعظةٌ","ليسَ السجودُ اتضاعًا، إنه شَمَمُ",65,"م",1,0],["وللفراق مذاق الملح في شفتي","فاسكب غيابك فوق الجرح ياساقي",66,"ق",2,0],["وَلِلفَلِّ بُوقٌ يَبُثُّ الفِرَى","وَأَيدِى فَسَادٍ لَمَّا تُحَشّ",67,"ش",1,0],["وللفؤاد أنينٌ في وشائجه","كماء مزنٍ به معصورٌ وممطورُ",68,"ر",1,1],["وللفخر ناس وللتواريخ بيبان","وللموت سوق وللتجارب عناوين",69,"ن",1,0],["وللفُقَاعاتِ دهرٌ كان يصعدُ بي","بألفِ حُلْمٍ لتهوِي بعدَها القَدمُ",70,"م",1,0],["وللفضل آلٌ وصحبٌ على","مغانيه تشدو ويوما ترد",71,"د",1,0]]}