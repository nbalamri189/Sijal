,[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94388","البسيط"],[4423,"","https://poetry.dctabudhabi.ae/diwan/poem/124242","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72861","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72862","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4764,"كبوة جواد","https://www.poetsgate.com/ViewPoem.aspx?id=34021",""],[5002,"حقّ الحبِّ...","https://www.poetsgate.com/ViewPoem.aspx?id=202378",""],[5002,"بلسم الأرواح....","https://www.poetsgate.com/ViewPoem.aspx?id=214825",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[585,"خذوا بيدي فالدهر جاشت غواربه","https://www.poetsgate.com/ViewPoem.aspx?id=161927",""],[5150,"مقدمة للحب","https://www.poetsgate.com/ViewPoem.aspx?id=202787",""],[5150,"إلام الصمت يا عرب ..؟؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202873",""],[5431,"بكف الله ممزوجا بلوني....","https://www.poetsgate.com/ViewPoem.aspx?id=200700",""],[5563,"مدعوجة العينين ( نبطية )","https://www.poetsgate.com/ViewPoem.aspx?id=212820",""],[5582,"أعذّالي أعذّالي","https://www.poetsgate.com/ViewPoem.aspx?id=63558",""],[5629,"ديرة الامجاد","https://www.poetsgate.com/ViewPoem.aspx?id=184502",""],[5720,"نُخبَة العِلم","https://www.poetsgate.com/ViewPoem.aspx?id=215713",""],[5801,"الجروح","https://www.poetsgate.com/ViewPoem.aspx?id=28390",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""]],"verses":[["في كتمها عنهم اذا فكرتمو","ما ليس في الاظهار من اخطار",0,"ر",1,0],["في كتاب حوى المحاسن في الشع","ر وأرعى جوائز الأمثال",1,"ل",1,0],["في كتاب جُعلت قفلا عليه","من يمين ما أومأت بسواكا",2,"ك",2,0],["في كِتابِ الفَخرِ لِلداخِلِ باب","لَم يَلِجهُ مِن بَني المُلكِ أَمير",3,"ر",1,0],["في كِتابٍ حَوى المَحاسِنَ في الشِع","رِ وَأَوعى جَوائِزَ الأَمثالِ",4,"ل",1,0],["فيكَ تَجْثو عرائسُ الأمَلِ العذْ","بِ تُصَلِّي بِصَوتهِ المحبوبِ",5,"ب",1,0],["فيكَ تنمو زَنابقُ الحُلُمِ العذْ","بِ وتَذوي لَدى لَهيبِ الخُطوبِ",5,"ب",1,0],["فِي كُتبٍ مَأثورَةٍ كلُّهَا","كالرَّوْضَةِ الدَّائِمَةِ الزَّهْرِ",6,"ر",1,0],["فِي كُتْبِهِ لِلْعُرْبِ تَارِيخُ بِهِ","يُجْلَى الْعَتِيدُ وَلاَ يَغِيبُ عَهِيدُ",7,"د",1,0],["في كتاب الأيام نوع من الرسم","وفيه التفكير بالألوان",8,"ن",1,0],["فَيَكتَسي المشوقُ","ما كُسيَ المعشوقُ",9,"ق",1,0],["في كتب شيت قد وصفن خلاله","وبكتب إدريس سناء سماته",10,"ت",2,0],["فيكَتِسبُ اللئيمُ به هَواناً","ويكتسِبُ الكريمُ بهِ جَلالا",11,"ل",2,0],["فيكَ تَحلو الحياةُ يا زهرَ","ةَ العمر وتنمو العقول والأَجسامُ",12,"م",1,0],["في كِتاب بصدق وَعد كَريم","مِن كَريم عَلى الوَفا مَقصور",13,"ر",1,0],["فَيكتبُ ما أملي تبر","رعاً مِن غير إملالِ",14,"ل",1,0],["فَيَكتُبُ غَيرَ الَّذي قالَهُ","وَيَقرَأُ غَيرَ الَّذي يُكتَبُ",15,"ب",1,0],["فيك تبدو في المجالي","من سنا عرش وكرسي",16,"ي",1,0],["في كتابِ حاكه طرّازه","رحمة بالفضل إن يُمحَّقا",17,"ق",2,0],["في كتابٍ خيرُ ما قيل به","إنه من روحه قد بثقا",17,"ق",2,0],["فيكَ توارتْ أدواتُ العُلا","وفي ثراكَ استترَ البدرُ",18,"ر",1,0],["في كتابٍ أياتُهُ محكماتٌ","من كلامِ المهيمنِ الرحمنِ",19,"ن",1,0],["فيكتسب المكارم وهى علق","نفيس لا يعار ولا يباع",20,"ع",1,0],["في كتابِ الله إذ جاء به","مُخبراً عنهم لهم مستفهما",21,"م",2,0],["فِي كُتبِهِ قَد قَالَه مِن مُوجَزٍ","وإبَانَةٍ وَمَقَالَةٍ بِبَيَانِ",22,"ن",1,0],["فِي كُتبِهِ طُرًّا وَقَرَّرَ قَولَ ذِي ال","إثبَاتِ تَقرِيراً عَظِيمَ الشَّانِ",22,"ن",1,0],["فيكَ تسري الريحُ بالمسك الشميم","فيكَ يحيى العظمُ والعظمُ رميم",23,"م",1,0],["في كِتابِ التَسهيلِ بحثهُم","أَيُّ بَحثٍ فيهِ غَدوا طَبقَه",24,"ق",2,0],["فيكتبها النهرُ في شدوهِ","بجناتها وبأقفارها",25,"ا",1,0],["في كِتابي إِلَى مَدَى الاََجَلِ","فَإلَيْكُمْ تَوَسُّلي وَسِنادي",26,"ي",1,0],["فيكتسي بحلل الجمال","ويتحلى بحلى الكمال",27,"ل",1,0],["فيكتفي لذاك بالكفافِ","ويكتسي هناك بالعفافِ",28,"ف",1,0],["فيكتسح الإغريق يكساهم إلى","أساطيل آخيل فيشفق للبلا",29,"ل",2,0],["فَيَكتُمُ المَرءُ العُلُومَ النَّافِعَه","عَن طَالِبٍ لَهَا وَيَغدُو مَانِعَه",30,"ه",1,0],["فيكتمور مَنويل فرعُ الملك مالكهُ","عن قِنس مجدٍ لقد جلَّت عناصرُهُ",31,"ر",2,0],["في كتابي عجائب مثبتات","ليتني ما لقيتها في بقائي",32,"ا",3,0],["في كتابِ الشفا الشريف تهنّى","إذ حواه القاضي الشريف الرشدي",33,"ي",1,1],["في كتاب الإحياء أحيا قلوبا","شيخنا الغزالي كانت مواتا",34,"ت",2,1],["في كتابه غُرَرٌ","كلُّها له ذِمَمُ",35,"م",1,0],["في كتابٍ يحتويها مثل اي قطعة جماد","اقصى احساسٍ وصلها به ظماها اكتمل",36,"ل",1,0],["في كتابي دوّْنْتُ حرَّى دمُوعي","مثل أثلام رسْمُهَا حرثُ في جدْبْ",37,"ب",1,0],["في كتابِ الأقدارِ علمٌ وسرٌّ","ما ابتلاءٌ إلا يُذاق أنِينا",38,"ن",2,0],["في كتاب يتلونه ليناجوا","ربهم فيه وهو نعم المناجى",39,"ج",2,0],["فيكتب آي المجد في كل صفحةٍ","وما يجهل الأمي ما هو كاتبه",40,"ب",2,0],["في كتابي بعضُ شعرٍ","لفؤادٍ قد تجرَّحْ",41,"ح",1,0],["فيَكتبُ سِفرَ حاضرِنا","كما الماضين قد كتبوا",42,"ب",3,0],["فيكتبني غلى مزمار وجدٍ","ويعزفني بأشواقي وفنّي",43,"ن",2,0],["فيك تشقى العين وانتي ماانتحبتي","من شقا عيني ولا همّك سهدها",44,"د",3,0],["فَيَكْتُبُ ما أُمِلُّ تَبَ","رُّعاً مِنْ غَيْرِ إِمْلالِ",45,"ل",1,0],["في كتاب المجد ماخلو سطر","أمتلى بفعولهم وأصبح دليل",46,"ل",1,0],["فيكتبُ ما يروقُ له بِحبٍّ","لعل(الشعرَ) يرضي مَنْ أحبَّهْ",47,"ب",2,0],["في كتابُه جايه وروح","للروح طريق معلوم",48,"م",1,0],["فيكتنز انتعاشاً من سناها","ويَرجِعُ عنده العزمُ الدَّهاقُ",49,"ق",1,0]]}