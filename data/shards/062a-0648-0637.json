{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[90,"أرى الحق لم يغش البلاد وإنما","https://www.aldiwan.net/poem44826.html","الطويل"],[48,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[190,"قالوا أتى العيد قلت العيد عادته","https://www.aldiwan.net/poem43794.html","البسيط"],[371,"همومي أراها اليوم من أمسها أسمى","https://www.aldiwan.net/poem17332.html","الطويل"],[371,"وكيف بأن يلقى سلاحي متنه","https://www.aldiwan.net/poem17786.html","الطويل"],[406,"أيا شعب مصر","https://www.aldiwan.net/poem10307.html","عموديه"],[445,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[447,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[488,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[568,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122314","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38972","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136331","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50040","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200904","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74290","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90894","الوافر"],[5431,"دُنيا غرورٌ فكن في الدون مرتفعا !!","https://www.poetsgate.com/ViewPoem.aspx?id=201400",""],[1638,"رشا من بني الأتراك صاد بصاده","https://www.poetsgate.com/ViewPoem.aspx?id=123935",""],[5740,"تندغ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=211474",""],[6056,"سواليف الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=130511",""]],"verses":[["توطن مذ رأى رمشي كناساً","بقلبٍ للمراح ذراه غابا",0,"ب",2,0],["توطّن قَفر الأرض مُبتعداً بها","إلى حيث لا أنس ولا طائر يَزقو",1,"ق",2,0],["تَوَطَّأَتِ الفَطيمَ عَلى اِعتِمادٍ","فَما أَبقَت عَلَيهِ وَلا اِتَّقَتهُ",2,"ت",2,0],["توطنت مختلف البلاد","واحدة المغرس والميلاد",3,"د",1,0],["توطن الفقر في قعبي ومحبرتي","توطّن الجن جنّ الدور في الدور",4,"ر",1,0],["تَوَطَّأَ مِنّي صَخرَةً وَتَظُنُّها","إِذا آهِ لَم أُعلِن بِها صَخرَةَ صَمّا",5,"م",2,0],["تُوَطَّأُ أَعناقٌ فَتَنمي حُقودُها","وَهَل هِيَ بِالمَوطوءِ ما فَعَلَ الواطي",6,"ط",2,0],["توطِّيء أكْنَافَها حينَما","تُصانُ الحقوقُ ولا تُسْلَبُ",7,"ب",1,0],["تُوَطِّئُهُنَّ لحمْلِ الكُماةِ","وتُوطِئُهُنَّ صدورَ الأعادي",8,"د",2,0],["توطن دار منه كانت خرابة","وأقفر من صنعا البهية أوطانا",9,"ن",2,0],["تَوَطَّأُ أَغلَظَ حِزّانِهِ","كَوَطءِ القَوِيِّ العَزيزِ الذَليلا",10,"ل",2,0],["تَوَطَّنَتِ الأَشواقُ سَوداءَ قَلبِهِ","فَتَرفَعُهُ ظَرفاً وَتَحفِضُهُ ظَرفا",11,"ف",2,0],["توطَّن ذاكَ الثَّغْرَ عِشْقِي ولم يزل","على باب ذَاكَ الثَّغرِ من قلبي الرِّفدُ",12,"د",1,0],["توطن متن البصيلات فإنها ال","مآرب ان يوما تعطل مطلب",13,"ب",1,0],["تَوَطَّنَه شَمساً فَلَم يَكُنِ السّهى","يُساميهِ كَعباً أَو يُزاحمه كِتفَا",14,"ف",2,0],["تَوَطّن العلياءَ بَيتاً لَه","وَلَيسَ كَالعَلياءِ يَبدو وَطَن",15,"ن",1,0],["توطن قلبي الحب فهو ملازمه","وفي الجسم مني قد تبدت علائمه",16,"م",2,1],["توطّد الملك إذا وليّ أمانته","واستبشرت حسن مَرعاه رعاياه",17,"ا",2,0],["توّطنْ على ما خفته من مكاره","فليس بمجديك الأسى والتبرم",18,"م",1,1],["توطن في الحَدباء حَتّى تَشَوقت","لَهُ البَلدة الزَوراء في آخر الأَمر",19,"ر",1,0],["توطن في طرابلس فأضحت","به البلد الأمين مدى الزمان",20,"ن",1,0],["تؤطرُ الحزن تقسو في تمرّدها","وتنزف الوقت لغوا عابثا بشِعا",21,"ع",2,0],["توطأ هام النسر منعة حسنه","فما البدر إذ عدوة الا بعبده",22,"د",2,0],["توطنوا من قلاع العز أمنعها","وحلقوا في سماء المجد عقبانا",23,"ن",2,0],["توطنتيّ العذاب جروح ، تسكن في خفا جوفي","بعد ماعانت الوجدان لأجلك كثرة الأسفار",24,"ر",1,0]]}