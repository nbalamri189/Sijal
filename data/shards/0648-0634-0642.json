x?id=15448",""],[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[5897,"الحياء في لحظات الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=157485",""],[5918,"طَوى الآفاقَ","https://www.poetsgate.com/ViewPoem.aspx?id=54708",""],[5956,"تفانيتَ من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=194014",""],[5975,"هذي حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=58788",""],[5997,"العذراء","https://www.poetsgate.com/ViewPoem.aspx?id=214229",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6035,"لاتردّي قلبي ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151971",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""],[6125,"حاشا وكلا أنْ أُبدِّلَ ديني","https://www.poetsgate.com/ViewPoem.aspx?id=212872",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[463,"تغربْ فالبدار الحبيبة ِ دارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60062&r=&rc=118",""],[5190,"صراعات نفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78307&r=&rc=20",""],[6352,"قم ناشد الأسلام عن مصابه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22753&r=&rc=14",""],[572,"عاداتُ طيفِكَ أّن يعاوِدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9254&r=&rc=111",""]],"verses":[["وشقا بها جيبا على صدر مربع","من الثكل شقت كالجيوب أعاشبه",0,"ب",2,0],["وَشَقيتُ مِنهُ بِقُربِهِ وَبِعادِهِ","وَأَخو الشَقاءِ إِلى الشَقاءِ مُوَفَّقُ",1,"ق",1,0],["وَشَقِيقَةٌ شَقَّتْ مَرَارَتَهَا","مِنْ حُزْنِهَا إِذْ بَانَ مُنْجِدُهَا",2,"د",3,0],["وشقّت جيوبَ الزهر فيك كمائمٌ","يرفُّ بها الريحان عن خَضِلٍ نَدي",3,"د",2,0],["وشّققت الجُيوب لكم رجال","ولطمّت الخدود لكم نساء",4,"ا",2,0],["وَشَقَّ إِلى نَفسِ الدُمُستُقِ جَيشُهُ","بِأَرضِ سُلامٍ وَالقَنا مُتَشاجِرُ",5,"ر",1,0],["وشقيت بالأولاد بع","ضهمُ لكلِّي قد قصم",6,"م",1,0],["وشقّ السهاد سما مقلتي","فيومئذ أضلعي واهيه",7,"ي",2,0],["وشقيقةٍ قالت أراك مُفكراً","حتى أراك من السكينة نائما",8,"م",2,0],["وَشَقاءٌ يُوَلِّدُ الرِفقَ فينا","لَهُوَ الخَيرُ بِالشَقاءِ نَزِيّا",9,"ي",2,0],["وشقيٍّ طافَ المدينَةَ يستج","دي ليَحْيَا فخيَّبوه احتقارا",10,"ا",1,0],["وشَقيقٍ بِخَدِّهِ","مُهَجَ الخَلْقِ شَقَّقَ",11,"ق",2,0],["وشقوة اجيال مشوا في حياتهم","كما قد تلقوه على نهج اجيال",12,"ل",1,0],["وَشَقائِقُ النُعمانِ آ","بَت بِالخُدودِ مُخَمَّشاتِ",13,"ت",1,0],["وشققتَ شأوَ الحاسدينَ ففي المدَى","تجري وهُمْ نُظَّارةُ الميدانِ",14,"ن",1,0],["وَشَقيقُ بنُ فاتِكٍ حَذَرَ العا","رِ عَلَيهِنَّ فارَقَ الدَهناءَ",15,"ا",2,0],["وشَقيقٍ جادَه الغي","ثُ رَواحاً وابتِكارا",16,"ر",2,0],["وشَقَّ على لونِ الخدودِ شَقائقاً","رأَته عيونُ السِّربِ أبهى وأصلَحا",17,"ح",2,0],["وَشُقَّ جَيبُ الفَلَقِ المُبيَضِّ","عَرَضتُ خَيلي فَأَجَدتُ عَرضي",18,"ض",2,0],["وشقِيَّا ينسى تَفَاقُمَ بلواه","ويبلَى لغيره في الشقاءِ",19,"ا",2,0],["وشقيقٌ يُشَقّ عن أُقحُوانٍ","لِنقابِ النّقا عَلَيهِ خَفيرُ",20,"ر",1,0],["وشقَّ الشقيقُ الثوبَ عنهُ كثاكل","عليها ثيابٌ للدما ليس تنتضى",21,"ض",2,0],["وَشَقَّ عَصا الجيرانِ يَومَ تَرَحَّلوا","نَوىً بِالكُلَيبِيّاتِ عَنكَ تَجورُ",22,"ر",1,0],["وَشَقيُّ قَومٍ لا كَما زَعَمَ اِسمُهُ","بارى عُلاكَ فَما جَرى حَتّى كَبا",23,"ب",2,0],["وَشَقَ آذانَنا كَيما نَعيشُ بِها","وَجابَ للسَمعِ أَصماخاً وَآذانا",24,"ن",2,0],["وَشَقَّ الأَرضَ فَاِنبَجَسَت عيوناً","وَأَنهاراً مِنَ العَذبِ الزُلالِ",25,"ل",1,0],["وَشَقَّ ثَراها عَن أَقاحٍ كَأَنَّها","تَهادَت بِمِسكٍ نَفحُها وَالأَجارِعُ",26,"ع",1,0],["وَشَقَّقَ أَعرافَ السَحابِ اِلتِماعَةٌ","كَما اِنصَدَعَت بِالمَشرِفِيِّ القَوانِسُ",27,"س",1,0],["وَشِقوَةٌ غَشِيَت وَجهي بِنَضرَتِهِ","أَبَرُّ بي مِن نَعيمٍ جَرَّ إِشحابي",28,"ب",2,0],["وشَقَّتْ لِيَ اللَّيْلَ عَنْ جَيْبِهِ","بِلَذَّتِهَا وضَجِيعِي وَسِنْ",29,"ن",1,0],["وشقَّ الروضَ بالألحا","نِ من غصنٍ إلى غُصنِ",30,"ن",1,0],["وشَقِيقُ نُعْمانٍ شَكَتْ","صَفَحاتُه مِن لَطْمِ لاطِمْ",31,"م",1,0],["وَشَقَقنَ أَردِيَةَ الضَغائِنِ بِالرَدى","مِن بَعدِ ما شَمَلَت قُلوبَ إِيادِ",32,"د",1,0],["وشقيقاته يمتن النياعا","ويهن له القلوب ضمائد",33,"د",1,0],["وشقّ لحودا تعبّ الفساد","وتنجرّ تبتلع المفسدا",34,"د",2,0],["وشقّت الصمت والأنسام تحملها","تحت السكينه من دار إلى دار",35,"ر",1,0],["وشقَّ عليه أن يصوِّر نفسَه","على غير ما قد عُوِّدَت أن تُصوَّرا",36,"ر",2,0],["وشقيقُك القَمرُ المُدِلُّ بلُطفه","نَشوانُ ، يَصحو تارةً ويُغام",37,"م",1,0],["وشَقَّ على \" الهاتفِ\" الهاتفون","وضجَّ من الأسطُرِ المرِقَم",38,"م",1,0],["وشقاء يولّد الرفق فينا","لهو الخير بالشّقاء تريّا",39,"ي",2,0],["وشقيقة ٍ قالت أراه مُفكراً","حتى أراه من السكينة نائما",40,"م",2,0],["وشقوتي أن برَت جسمي بجفوتها","وهجرها ما لها في الدهر إرضاءُ",41,"ا",2,0],["وشقاءِ الوُجود","بسناءِ الوُعود",42,"د",1,0],["وشقوا بيومٍ أوحدٍ في جنسهِ","فاتت مناقبه الزمانَ الأوَّلا",43,"ل",2,0],["وَشَقَّ لَهُ مِن إِسمِهِ لِيُجِلَّهُ","فَذو العَرشِ مَحمودٌ وَهَذا مُحَمَّدُ",44,"د",1,0],["وَشَقيقٍ تَرَاهُ يسرج فِي الرَّوْ","ضِ إِذَا مَا بدا بغير شِهابِ",45,"ب",1,0],["وشقيق شُقِّقت أَطْمارُه","كدموعِ العارضِ المُنتحِب",46,"ب",1,0],["وشقت رياحين السّواقى بُرودها","براب لها لما سَرى وهْو قارِس",47,"س",1,0],["وشقَّ وميضُ البرقِ ثوباً منَ الدجى","كأنْ لم يكنْ يُجلى بضوء سناكِ",48,"ك",1,0],["وشقَّ لهُ في الأفقِ فانسابَ هارباً","كما انسابَ في بطنِ الجداولِ سَلْسالُ",49,"ل",1,0],["وشقائق مثل الخدو","دِ لُطِمنَ فاشتعلت بنارِ",50,"ر",1,0],["وشقيقه يزهو بتلك الوجنة ال","حماء تحت الثامة السوداء",51,"ا",2,0],["وشقراء وادي الشام تبكي تأسفا","عليك بدمع فوق صدر تنهدا",52,"د",2,0],["وشق عليه الليل للذيل جيبه","وغيظا عليه انشق وانفلق الفجر",53,"ر",1,0],["وشقراء أشقاها عتابى فحاولت","عقابا لروحي أن تطيل عقابي",54,"ي",1,0],["وشقِيقُ العُلا الَّذي بَشَّر اللّ","هُ بِه في تِلاوةِ القرآنِ",55,"ن",1,0],["وشقائق كست الرُّبا نسجِها","حُلَلا كتضْريج الخدود الأحمر",56,"ر",1,0],["وشقائقاً قبَّلتها من خدهِ","حتى رثى لذبُولها نَعمَانُ",57,"ن",1,0],["وَشق اسمه من أَحرف اسم الهه","فَذو العرش محمود وَهَذا محمد",58,"د",1,0],["وَشق عَلى أَسمائهم من عَلى اسمه","عَلى الاصل فهو البر والقَوم أَبرار",59,"ر",1,0],["وشقيقة كالغصنِ في غلْوائه","عصفتْ به ريحُ المنونِ فمالا",60,"ل",2,0],["وشقائقُ النعمانِ في قيعانِها","تقطيعُ أكبادٍ وشقُّ مرائر",61,"ر",1,0],["وشق 