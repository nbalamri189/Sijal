x?id=29945",""],[4119,"يا ليت أن الصد مصدود","https://www.poetsgate.com/ViewPoem.aspx?id=16113",""],[5136,"ما للعواذل لا كانوا ولا خلقوا","https://www.poetsgate.com/ViewPoem.aspx?id=121637",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5354,"طغى التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=187577",""],[5376,"على مشارفِ عيد اللهِ مبتسمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205890",""],[5431,"بانيو وكأس ...وبرد الخيام!","https://www.poetsgate.com/ViewPoem.aspx?id=201925",""],[5461,"قالوا علامك","https://www.poetsgate.com/ViewPoem.aspx?id=5041",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5732,"قالوا علامك","https://www.poetsgate.com/ViewPoem.aspx?id=177885",""],[5732,"البارحه يازبن بالقلب هوجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177848",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[6008,"الواسطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=60803",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[6093,"عقيم","https://www.poetsgate.com/ViewPoem.aspx?id=192353",""],[6115,"قالو عللامك مع الأيام متغير","https://www.poetsgate.com/ViewPoem.aspx?id=180495",""]],"verses":[["قالوا عَجِبنا لِمِصرٍ يَومَ مَصرَعِهِ","وَقَد عَجِبتُ لَهُم مِن ذَلِكَ العَجَبِ",0,"ب",1,0],["قالوا عشِقتَ معيب الحسن قلت لهم","كُفّوا الملام فما قلبي بمُنزَجر",1,"ر",1,0],["قالوا عن الفتحِ قد بعدتَ فهل","ذكرك عند الصحاب بالنسب",2,"ب",1,1],["قالوا عهدناك ذا شعرٍ نلذّ به","ما باله قد تولى حسنهُ الآتي",3,"ي",1,1],["قالوا على شيخ الأحزاب","في العباسية الجديدة",4,"ه",1,1],["قالوا عَلَيكَ الشَمسَ فَاِقصِد نَحوَها","وَالشَمسُ نائِيَةٌ عَنِ السُفّارِ",5,"ر",1,0],["قالوا عرفناهُ فمن يَعلقْ به","يَعلقْ بِخزْيٍ دائمٍ ونكالِ",6,"ل",1,0],["قالوا عليكَ صلاةُ اللّهِ إنّ بنا","ما اللّهُ يعلمُ من عَزْمٍ وإصرارِ",7,"ر",1,0],["قالوا عَهِدناكَ مِن أَهلِ الرَشادِ فَما","أَغواكَ قُلتُ اِطلُبوا مِن لَحظِهِ السَبَبا",8,"ب",2,0],["قالوا عَسى أن تنيل الشعب ثورته","سعادة غير أَنَّ الشعب ما سعدا",9,"د",2,0],["قالوا عليٌّ شاعرٌ فأجبت بل","ساقٍ عصير الرم ملء دنانه",10,"ن",2,0],["قالوا علِيٌّ غدا نَقيباً","قلتُ مَتَى لم يكنْ نقيبَا",11,"ب",2,1],["قالوا عليك: أُجاج الماء، قلت لهم","بل ماؤُك العَذْب سيالٌ بكل فم",12,"م",1,0],["قالوا: عجبنا كيف نصدق في الهوى","وتَعِفُّ في شرخ الشبيبة مئْزَرا؟",13,"ر",2,0],["قالوا: عليل، فقلنا: هل إليه سَرَى","من المحبين أنَّاتٌ وأشجان؟",14,"ن",1,0],["قالوا: عبدنا ربَّ موسى وحدَهُ","قلنا: عبدتم ذا الرَّنين الأصْفرا",15,"ر",2,0],["قالوا: عليٌّ شاعرٌ، فأجبت: بل","ساقٍ؛ عصيرُ الكرم ملءُ دِنانه",16,"ن",2,0],["قالوا: عجبنا! ما لشعرك نَائحًا","في العيد؟ ما هذا بشدو معيِّد",17,"د",1,0],["قالوا عن ؟((حورية)) أمتلئت","فتنا ، أغلى ما في الأغلى",18,"ل",2,0],["قالوا علمت فقلت علّم","ني بحكمته العُلُومَا",19,"م",2,0],["قالوا عَلَيَّ وَلَم أَملِك فَيالَيتَهُم","حَتّى اِنتَحَيتُ عَلى الأَرساغِ وَالثُنَنِ",20,"ن",1,0],["قالوا عشقتَ صغيراً قلتُ أرتعُ في","روض المحاسن حتى يدركَ الثَّمَرُ",21,"ر",1,1],["قالوا عذولك غيظا مات قلت وكم","عليّ لله من فضل وتخفيف",22,"ف",1,0],["قالوا عشقت فقلت كم من فتنةٍ","لم تغنِ فيها حكمةُ الحكماء",23,"ا",2,1],["قالوا عَيينا فَاِبدُري وَقَد زَعَموا","أَن قَد مَضى مِنهُمُ رَكبٌ فَقَد نَصَبا",24,"ب",2,0],["قالوا علا نيل مصر في زيادته","حتى لقد بلغ الأهرام حين طمى",25,"م",2,1],["قالوا عَلَيهِ الطَيرُ حامَ كَرامَةً","قُلت الكَواسر قَد تَحوم عَلى الجيف",26,"ف",1,0],["قالوا عَشِقْتَ وذاك شَيءٌ إنّما","قد كنتُ أَخشَى أن يُقالَ فقِيلا",27,"ل",2,0],["قالُوا عَسى ثَقُلَت عَلي","هِ فَباعَها مِن غَير عُدمِ",28,"م",1,1],["قالوا عسى عز الأنا","م أردت قال فمن أريده",29,"د",2,0],["قالوا عساك مرجِّمٌ فتبَيَّنِ","هيهات ليس بناظري إن غَرَّني",30,"ن",2,1],["قالوا عدوّك فاحتقره جاهلٌ","من لي على فضلي بحظ الجاهلِ",31,"ل",1,0],["قالوا عصيتَ العاذلين وليس من","شرط الصَّبابة طاعة التعنيفِ",32,"ف",1,0],["قالوا على الإصلاح لست بسائل","وربضت في كنف الفساد مقيما",33,"م",2,0],["قالوا عُزِلَت فقلتُ ذلِك عَن رِضىً","هذا الرِّضَى لُغزٌ مِن الألغاز",34,"ز",1,0],["قالوا علي قيل وابن حارثة","وابن أبي قحافة في الثالثة",35,"ه",1,0],["قالوا علي وابن كعب مهم","ثم ابن مسعود وعدوا فيهم",35,"م",1,0],["قالُوا عِذارُك مُخْبِر عن لوعتي","فأَجبتهم هيهات بل هو سائل",36,"ل",1,0],["قَالُوا عَليٌّ فَقُلْتُ قَدْراً","قَالوا كَوَافِي فَقُلْتُ قَلْبِي",37,"ي",1,0],["قالوا عَميدَ بَني النُصارِ قُلتُ لَهُم","بَل رُكنِ كُلِّ اِمرِئٍ في يَعرُبٍ اِنتَسَبا",38,"ب",2,0],["قالوا عَساكر شعره قَد أَقبَلَت","في خَدّه كَالعارض المتهللِ",39,"ل",1,1],["قالوا عَلِقْتَ بهِ كبيراً سِنُّهُ","بادي العِذارِ وإنَّ ذا لنكيرُ",40,"ر",1,1],["قالوا عَشِقتَ كَثيرَ البُخلِ مُمتَنِعاً","فَقُلتُ هَيهاتَ عَنكُم غابَ أَطيَبُهُ",41,"ه",1,1],["قالوا عليل قلت مجهوداً بما","لا تستطيع أعارب وأعاجم",42,"م",1,0],["قَالوا عَلِمتَ بِحُمّى الحِبِّ قلتُ لَهم","نَعَم وَقَد صِرتُ مِن حُمّاهُ مَغموما",43,"م",2,1],["قالوا عَلَيهِ فيهِ حَيوانُ","وَكثر الدَليلُ وَالبُرهان",44,"ن",1,0],["قالواعُمان ٌفقلتُ الصَوت ُفي لغتِي","الأولَى ومندِيل ُدَمعي حين َيَنذرِفُ",45,"ف",1,0],["قالوا عليك بماء زمزم قلت ما","في ماء زمزم ما يبل أوامي",46,"م",2,0],["قالوا عشقت وأنت أعمى","ظبياً كحيل الطرف ألمى",47,"م",2,1],["قالوا عليك القلوب وقف","حقاً وغيري فماله إن",48,"ن",1,0],["قالوا عشقتَ سواهُ ثم نسيتَهُ","هيهات أن أنسى الحبيبَ الأولا",49,"ل",2,0],["قالوا عهدناه على مرقب","يحمل كالضرغامة الصارم",50,"م",1,0],["قالوا عَشِقتَ صَغيرَةً فَأَجَبتُهُم","أَشهى المَطِيِّ إِلَيَّ ما لَم يُركَبِ",51,"ب",1,1],["قالوا عَجَيباً كَيفَ ذاَ فَأجَابَهُمْ","عِندي لَهَا وَجهُ عَلَيهِ تُصَوَّرُ",52,"ر",1,0],["قالوا على جهة الاغباء أَغرب من","عَنقاءَ شَكلاً وَهَذا غَير اغباء",53,"ا",2,1],["قَالُوا عَلِيمٌ وَهوَ ذُو عِلمٍ وَيُع","لَمُ غَايَةَ الإِسرَارِ وَالإعلاَنِ",54,"ن",1,0],["قالوا عَلى الجَيشِ لَو أَمَّرتَ مُكتَهِلاً","فَما غُلامٌ وَنار الحَربِ يُذكيها",55,"ي",3,0],["قالوا على من بكاهم يا مؤرخه","قلت الذي قد بكاه العلم والعمل",56,"ل",1,0],["قالوا عقوبته الجفا","ويسا إليه كما يسى",57,"س",2,1],["قالوا عجيب كيف زال وإنّهُ","علمٌ يفوق كواكب الجوزاء",58,"ا",2,0],["قالوا عهدناك حليف الهوى","فلم تغيرت عن العهد",59,"د",1,1],["قالوا عل