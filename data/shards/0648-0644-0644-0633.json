{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[79,"أيوسف دم للملك تعلي بناءه","https://www.aldiwan.net/poem35699.html","الطويل"],[88,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[85,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[74,"قالوا أضاءت سماء الشام قلت لهم","https://www.aldiwan.net/poem18666.html","البسيط"],[74,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[40,"وللسر حالات فمنه جماعة","https://www.aldiwan.net/poem7698.html","الطويل"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[47,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[68,"ومجلس لذة أمسى دجاه","https://www.aldiwan.net/poem40674.html","الوافر"],[76,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[48,"تحفظ بدينك يا ناسكا","https://www.aldiwan.net/poem22753.html","المتقارب"],[48,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1940","المتقارب"],[139,"ما للحوادث تنئينا وتدنينا","https://www.aldiwan.net/poem49191.html","البسيط"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[234,"ولما هززت السيف ثم اشتملته","https://www.aldiwan.net/poem51149.html","الطويل"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[240,"خليفة الله الذي وعوده لا تخلف","https://www.aldiwan.net/poem31820.html","مجزوء الرجز"],[266,"نغاضب بالهجران منكم فنحلم","https://www.aldiwan.net/poem38192.html","الطويل"],[285,"أفيض دموع أم سيول تموج","https://www.aldiwan.net/poem60699.html","الطويل"],[353,"مازلت رطب لسان","https://www.aldiwan.net/poem20736.html","المجتث"],[369,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[454,"الجود والمجد","https://www.aldiwan.net/poem973.html",""],[457,"أجل حديث لا يمل دوامه","https://www.aldiwan.net/poem13898.html","الطويل"],[463,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[466,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[505,"أصاحب بيتي كل ما قام في الورى","https://www.aldiwan.net/poem37812.html","الطويل"],[556,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53879","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64273","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38983","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18493","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59655","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62524","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133861","السريع"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77439","البسيط"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132834","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49965","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49945","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79821","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48955","المتقارب"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1682,"","https://poetry.dctabudhabi.ae/diwan/poem/198769","الوافر"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127859","الرجز"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104791","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48221","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131322","الرجز"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101268","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104964","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93701","البسيط"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26164","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137399",""],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113870","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74160","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132529","المجتث"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110781","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20562","الطويل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126923","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66478","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91800","البسيط"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132075","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135415","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95351","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132184","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102745","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73636","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66119","الطويل"],[4755,"مأساة سُهَيل اليَمَاني ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=209084",""],[4927,"عشق ورغد","https://www.poetsgate.com/ViewPoem.aspx?id=29945",""],[585,"يا ساحة المجد أين المعجب الصلف","https://www.poetsgate.com/ViewPoem.aspx?id=161925",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5358,"حبات الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=21760",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5596,"مكة روحي","https://www.poetsgate.com/ViewPoem.aspx?id=206716",""],[5616,"كمل النصاب","https://www.poetsgate.com/ViewPoem.aspx?id=203468",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5776,"لوحةٌ رسَمَها دمُ الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199919",""]],"verses":[["وَلِلسَيرِ اِلتِدامٌ في المَطايا","وَلِلبَينِ اِحتِدامٌ في الصُدورِ",0,"ر",1,0],["وللسّهامِ حَفيفٌ في مَسامِعِهمْ","كالنّحْلِ ألْقَيْتَ في أبْياتِهِ الضَّرَما",1,"م",2,0],["وللسعد ميداناً وللعز معقلاً","وللدين محراباً وللملك مجلسا",2,"س",2,0],["وَلِلسِياسَةِ فينا كُلَّ آوِنَةٍ","لَونٌ جَديدٌ وَعَهدٌ لَيسَ يُحتَرَمُ",3,"م",1,0],["وَلِلسَوطِ فيها مَجالٌ كَم","تَنَزَّلَ ذو بَرَدٍ مُنهَمِر",4,"ر",1,0],["وللسبيكة تاج فوق مفرقها","تودُّ دُرُّ الدراري لو تُحلّيها",5,"ي",3,0],["وللسيوف بروقٌ كلما لمعت","تُزجي الدماء وريح النصر يُزجيها",5,"ي",3,0],["وللسعادة معنًى شاهد أبداً","بأنَّ طالعَ أفقِ الشام مسعود",6,"د",1,0],["وللسيادة معنًى ليس يدركه","من طالب الذكر إلا باحثٌ فهِمُ",7,"م",1,0],["وللسيف حيناً مرقدٌ في حجابه","وحيناً مهبٌّ صادق ومُصمَّمُ",8,"م",1,0],["ولِلسَّماحِ كهولٌ لا كِفاءَ لهمْ","يغشاهُم الدهرَ سُؤّالٌ وضِيفان",9,"ن",1,0],["وَلِلسِرِّ حالاتٌ فَمِنهُ جَماعَةٌ","وَمِنهُ نَجِيّانِ وَأَحزَمُها الفَردُ",10,"د",1,1],["وللسعادة ايام قد انصرمت","اما شقائي فهذا غير منصرم",11,"م",1,0],["وللسعود غدوّ في صبائحها","وللميامن مسرى في لياليها",12,"ي",3,0],["وَلِلسَيفِ ذو الحَدَّينِ أَجنى عَلى العِدى","وَأَبأَسُ في الجُلّى مِنَ السَيفِ ذي الحَدِ",13,"د",1,0],["وَلِلسَمعِ الأَغاني وَالغَواني","لِأَعيُنِنا وَلِلشَمِّ البَخورُ",14,"ر",1,0],["وَلِلسَعدِ طَرفٌ بِهِ كالِئٌ","يُراعي الهِزبَرَ وَيَحمي الأَجَم",15,"م",1,0],["وَلِلسِبكِ رُدَّ كَسيرُ الزُجاجِ","وَلا يُسبَكُ الدُرُّ إِن يَنكَسِر",16,"ر",1,0],["وَلِلسَمُراتِ في الأَشجارِ عَيبٌ","إِذا ماقالَ مُخبِرُهُنَّ حِضنَه",17,"ن",2,0],["وللسّرّ منّي موضعٌ لا يناله","نديمٌ ولا يفضي إليه شراب",18,"ب",1,0],["وَلِلسَّمَاءِ خُيُوطٌ غَيْرُ وَاهِيَةٍ","تَكَادُ تُجْمَعُ بِالأَيْدِي فَتُرْتَبَطُ",19,"ط",1,0],["وَلِلسَوطِ فيها مَجالٌ كَما","تَنَزَّلَ ذو بَرَدٍ مُنهَمِر",20,"ر",1,0],["وللسياسة تبدي كل آونةٍ","من رقش أثوابها للناس تلوينا",21,"ن",2,0],["وللسَّوْسَن المفتوحِ أبواقُ فضة","تُقابل من حمرِ الشَّقيق مَطارِدا",22,"د",2,0],["وَلِلسَّرابِ خِياناتٌ عَلى فَمِهِ","كَأَنَّها هُزءُ شَيطانٍ بِإِنسانِ",23,"ن",1,0],["وللسيف غِمْد مثل جفْني يسُلُّه","ويُغمده في قلب كلّ فتى جَلدْ",24,"د",1,0],["وللسحر تأثير ولا باس بالرقى","بأم الكتاب أو دعاء يرفع",25,"ع",1,0],["وَلِلسَماحِ وَالنَدى","تَليدُهُ وَالمُطرَفُ",26,"ف",1,0],["وللسقم في أعضاي مرغى ومرتع","وللهم في أحشاي مغنى ومغنم",27,"م",1,0],["وَلِلسَّيِّدِ الْمَأْمُولِ فِيهِمْ مَكارِمٌ","تُساحُ بِأرْزاقِ الْعُفاةِ وَتُمْزَجُ",28,"ج",1,0],["وَلِلسِّراجِ بَقَاءٌ","مَادامَ رَطْبَ اللِّسانِ",29,"ن",1,0],["وللسّماءِ نطاقٌ من كَواكِبها","عُقدْنَ منه على أعطافها حُبُك",30,"ك",1,0],["وَلِلسُها مُسامِرُ سُهادُهُ","إِذا اِنتَحى بِاللَيلِ أَو لِلفَرقَدِ",31,"د",1,0],["وللسابغاتِ بحورٌ تمورُ","وللسابحاتِ سفينٌ يَعُومُ",32,"م",1,0],["ولِلسِّتْرِ والصَّبْرِ الجَمِيلِ تَأَخَّرَا","فأَمَّهُمَا حِرْصِي وَكَانَا إِمامَيَّا",33,"ي",2,0],["وللسرور كما للحزن أدمعه","من أنعم الله هذا المنظر العجب",34,"ب",1,0],["وللسُنَّة الغرّاء أعذبُ موردٍ","يحق لنا إِجلالُه واحترامُه",35,"م",2,0],["وللسيفِ لم يعدَمْ مَضاءً وزينةً","بنصلٍ وجفنٍ جهدَ قيْنٍ ولا جالي",36,"ل",2,0],["وللسابق المنقول من ظهر لاحقٍ","إلى سبعة مما تنخّلها الفالي",36,"ل",2,0],["وللسَّراةِ من الإسلام شافِعُهُ","بني العُلى ومشاري الخلق والأمَمِ",37,"م",1,0],["وللسِّرِّ حكمٌ لا يُفارِقُ أَهلَهُ","وللدِّينِ من بيتِ النَّبيِّ رِجَالُ",38,"ل",1,0],["وللسّرِّ منّي بين جنبيه مَسكَنٌ","حميٌّ أبيٌّ شاحطٌ مُتمنِّعُ",39,"ع",1,0],["وللسعي تحصيل وفيه سعاية","فإياك تعنى فالخصوص عناية",40,"ه",1,0],["وللسّعد نورٌ مستفيضٌ ضياؤُهُ","لديكَ به ما دمتَ تُمْسي وتُصبحُ",41,"ح",1,0],["وَلِلسُّقّاطِ أمثالٌ فمنها","تمثُّلُهم لَدى الشّيءِ المُريبِ",42,"ب",1,1],["وَلِلسّعدِ إِذ أَرَّخت حاوٍ بدرّة","وَلا زالَ مَيموناً عَليكَ مُباركا",43,"ك",2,0],["وَلِلسَيفُ نَغشاهُ وَيَفري شُئونَهُ","وَكانَ الحَيا لِلمُفلِحِ المُتَشَعِّبِ",44,"ب",1,0],["وللسرح حاميه وللمحل قاتله","وللملك كافيه وللدين كافله",45,"ل",2,0],["وللسر المصون مقام صدق","بقلبي لا أفضُّ له ختاما",46,"م",2,0],["وللسمو إشراق يزيح دجى الوغى","وللبيض في هام العداة غروب",47,"ب",1,0],["وللسواقي كل ما تشتهي","تنشقاً من عرفها الوفرِ",48,"ر",1,0],["وَلِلسَعادة أَسبابٌ مُقَدَّرة","في سابق العلم لا كَسبٌ وَتَحصيلُ",49,"ل",1,0],["وللسابق البادي من الفَضل رُتبةٌ","تُقَصِّر بالتالي وإن بَلَغَ العُذرَا",50,"ر",2,0],["وللسعي بين المروتين مهرولاً","سعى وبجلباب الخضوع تجلببا",51,"ب",2,0],["وللسّيد المعروف بالفضل مادِحٌ","فقد امنكت فيه القوافي الشّوارِدُ",52,"د",1,0],["وللسَلم آياتٌ إذا ما انْتَدوا لها","فكلّهم وسطَ النَّديِّ بلا نَدِّ",53,"د",1,0],["وللسيوف إذا الموت الزؤامُ غدا","في حدِّها هو والأرواحُ يختصِمُ",54,"م",1,0],["وللسيفِ في غِمده كامناً","بكف