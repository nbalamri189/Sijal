{"poems":[[95,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[51,"قطع الموت كل عقد وثيق","https://www.aldiwan.net/poem62184.html","الكامل"],[71,"رب خولي بدا من","https://www.aldiwan.net/poem28299.html","مجزوء الرمل"],[107,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[107,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[107,"عرف الزمان مصارع الأبطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54867&r=&rc=37",""],[228,"في ليلة حالكة كالهموم","https://www.aldiwan.net/poem39701.html","السريع"],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[262,"ما للموله من سكره لا يفيق","https://www.aldiwan.net/poem2656.html","المجتث"],[287,"أي ركن وهى من العلماء","https://www.aldiwan.net/poem32295.html","الخفيف"],[305,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[325,"اليوم تحسدها الدنيا دمنهور","https://www.aldiwan.net/poem67229.html","البسيط"],[415,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[543,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[580,"يا من تجنيه جنايات","https://www.aldiwan.net/poem2981.html","السريع"],[438,"","https://poetry.dctabudhabi.ae/diwan/poem/58919","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64324","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37925","المجتث"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70759","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25340","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78170","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109330","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53145","المنسرح"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77299","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76128","المديد"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141200","الدوبيت"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101611","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66613","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133254","البسيط"],[4120,"","https://poetry.dctabudhabi.ae/diwan/poem/142548","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133185","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66096","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58040","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[4702,"اشتكي لوسادتي دنياي واسمعها تنوح","https://www.poetsgate.com/ViewPoem.aspx?id=155113",""],[4717,"ميمون","https://www.poetsgate.com/ViewPoem.aspx?id=204118",""],[4728,"حزم ما هو مثل حزم الظامي","https://www.poetsgate.com/ViewPoem.aspx?id=176900",""],[4816,"حرف شعرا تسامى","https://www.poetsgate.com/ViewPoem.aspx?id=199485",""],[4916,"دندنه","https://www.poetsgate.com/ViewPoem.aspx?id=136925",""],[585,"حييت من وطنٍ كالركن مستلم","https://www.poetsgate.com/ViewPoem.aspx?id=161912",""],[5185,"الدرع","https://www.poetsgate.com/ViewPoem.aspx?id=117928",""],[5606,"الجدران كثيره","https://www.poetsgate.com/ViewPoem.aspx?id=194421",""],[5732,"من يم خلي","https://www.poetsgate.com/ViewPoem.aspx?id=177891",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5848,"أفضل طريقة للحياة","https://www.poetsgate.com/ViewPoem.aspx?id=51941",""],[5848,"تعريف الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=51958",""],[5883,"اسامة","https://www.poetsgate.com/ViewPoem.aspx?id=17912",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""]],"verses":[["مَنْ يُمَهِّدْ لَهُ السَّبِيلَ يُهَييءْ","عَثْرَةً وَاقِعاً بِهَا الظَّلامُ",0,"م",1,0],["مَن يَمُت لا يَمُت فَقِيداً ومن يَح","يَى فلا ذُو إلٍ ولا ذُو ذِمَامِ",1,"م",1,0],["مَن يَمُت عَن مِنَّةٍ عِندَ يَتيم","فَرَحيمٌ سَوفَ يُجزى مِن رَحيم",2,"م",1,0],["مَن يَمُت يَعدَمِ النَصيحَةَ وَالإِش","فاقَ مِن كُلِّ ناصِحٍ وَشَفيقِ",3,"ق",1,0],["مَنْ يمتْ فيَّ يقلْ خد","ي هُدوا سبْلَ الرشادِ",4,"د",1,0],["مَنْ يملكُ السَّيل الأتيَّ إذا انْتحَى","مِلءَ الشِّعابِ ويُمسِكُ التيّارا",5,"ر",2,0],["مَن يَمنَعُ الأَمرَ يَقضي اللَهُ واقِعَهُ","وَيَدفَعُ الحَقَّ مِن وَحيٍ وَتَنزيلِ",6,"ل",1,0],["مَن يَمنَعُ اللَيثَ أَن يَعتَزَّ أَو يَثِبا","ما قيمَةُ السَيفِ إِن جَرَّدتَهُ فَنَبا",7,"ب",2,1],["مَن يُمسِكُ العَرشَ إِن هَزَّت دَعائِمَهُ","هوجُ العَظائِمِ وَالأَهوالِ فَاِنقَلَبا",7,"ب",2,0],["من يمنع النوب الثقال مغامراً","فيها بهمة قائلٍ فعال",8,"ل",1,0],["من يَمنَع الأَهوالُ أَن تُطعِمَه","وَلا يَرى في كُلِّ جُرحٍ حِكَم",9,"م",1,0],["مَن يَمتَطيها كَالذِئابِ عَوابِساً","قُبّاً وَيوطِئُها القَنا العَسّالا",10,"ل",2,0],["مَن يَميلُ كَأَنَّهُ في التَثَنّي","غُصنُ البانَه",11,"ه",1,0],["مَن يَمُت فَلَيمُت مَماتَ أَبي القا","سِمِ عَن عِفَّةٍ وَطيبِ ثَناءِ",12,"ا",2,0],["مَن يُمسِ مِن آلِ يَحيى مُغتَبِطاً","في عِصمَةِ الأَمرِ ما لَم يَغلِبِ القَدَرُ",13,"ر",1,0],["مِن يُمنِ إِقبالِها ما قَد نُؤَرِّخُهُ","عَلى نُمُوٍّ عَلَت قَدراً دَمَنهورِ",14,"ر",1,0],["مَن يَملُّ الحياةَ أمْ مَنْ عَليهِ","مِن تَوالي أنفاسهِ تَثْقيلُ",15,"ل",1,0],["مِن يمينٍ لِشِمالٍ","كُرَة في صَولَجَانِ",16,"ن",1,0],["من يمنعُ العذَّالَ أَن يَذْهَبُوا","ويمنعُ العُشَّاقَ أَن ياتُوا",17,"ت",3,0],["من يمنَحِ العشرينَ والعشرَ الصِبا","ففؤادُه المعْذورُ لا المعذولُ",18,"ل",1,0],["من يملك القول المبين فإنه","لا يحذر الأجناد وهي خضارم",19,"م",1,0],["من يُمِلْ عرشَه يُمِلْهُ بمأثو","رٍ يُميلُ العروشَ والأعراشا",20,"ش",2,0],["من يمنة فيها ومن يسرة","قنطرة واقفة تذهب",21,"ب",1,0],["مَن يَمَّمَ النّاسَ أَضحى","يُهانُ مِنهمُ ويُجفَى",22,"ف",2,0],["مَنْ يمدَحنَّكم مدحَ الأئمة لَه","ل العدل كان مصيباً غير ممجوج",23,"ج",1,0],["من يمسح أرى للأقرع شعرا","وبمسح أبرا الجراح الكبارا",24,"ر",2,0],["مَنْ يَمْنَعُ الخائِنَ ذا الحِمامِ","وَالقَدَرَ النازِلَ بِالأَحْتامِ",25,"م",1,0],["مِنِّي مَقاذِيفَ مِدَقٍّ مِفْدَغِ","يُوهِي عِظامَ الرَأْسِ إِنْ لَمْ يَدْمَغِ",26,"غ",1,0],["مَن يَملأُ البَحر المُحيط جَواهِراً","أَو يَلبَس الشَمس السَنى النوراني",27,"ن",2,0],["من يمنع الأعداء عنا متى","جاس خلال الدار جواسها",28,"س",3,0],["منيمها سلمه ومؤمنها","مسهرها عزمه مخوفها",29,"ف",3,0],["مَن يَمنَع الغَيثَ اِستَهَلَّ عَميمُهُ","بِصَواعِقِ الإِبراقِ وَالإِرعادِ",30,"د",1,0],["مَن يَمُت مِنهُم يُذِقه أَسىً","أَو يَعش أَلقاه في نَكَدِ",31,"د",1,0],["مَن يَمَّم بابهَ ينَل مطْلَبَه","مَن طاف به فهْو على النَّارِ حرامْ",32,"م",1,0],["من يمت ألف مرةٍ كل يومٍ","وهو حي يستهون الموت مره",33,"ر",2,0],["من يمنح الشيء الذي ما بعده","منح يكن كالمانع الصداف",34,"ف",1,0],["من يمنه زال ما بالعين من رمد","وتلك فاضت بعذب ليس بالثمد",35,"د",1,0],["مَنْ يَمْلأُ الأَرْضَ عَدْلاً بَعْدَما مُلِئَتْ","جَوْراً وَتَكْشِفُ عمَّاها صَوارِمُهُ",36,"م",2,0],["مِن يَمِينِ الثَّدييَنِ مَصَّ ومَا مَسَّ","يَساراً بَل دامَ مِنهُ إباءُ",37,"ا",2,0],["من يمن يمناك فاض النيل منبجسا","أروى الألوف ونبع الماء مهراق",38,"ق",1,0],["من يملأ النفوسَ بالأماني","مخضَرةِ الأطرافِ والذيول",39,"ل",1,0],["من يمتحنا يلقى زاخراً","يذهل الألباب عذباً للورود",40,"د",1,0],["مَنْ يَمُتْ في عِزَّةِ فَهْوَ السَّعِيدْ","في صُدورِ المجدِ مرفوعَ العِمادْ",41,"د",1,0],["من يَمتطي الجهلَ على غِرَّةٍ","فعن قليلٍ يرتدي عثرهْ",42,"ر",2,0],["من يمّ نظم ليمٍّ ملؤه دررٌ","للعلم يُنقل هذا اللؤلؤ الرطب",43,"ب",1,0],["من يمين ومن يسار وكل ما تنوي تروح","تبتلش بالضيق لو اني على الدرب الفسيح",44,"ح",1,0],["مَنْ يَمْنحُ الطِّفْلَ البَرِئَ لِسَاعَةٍ","نَوْمًا قَريرًا بَعْدَ لَيْلٍ روَّعَهْ",45,"ع",2,0],["من يماري في سيوفه لك عليّ اثلمها","موقفٍ يستدعي قْطامي سليل قْطامي",46,"م",2,0],["من يمره يسومه للعنا والعويل","مفرداته شوارد طرقته مذهبه",47,"ب",2,0],["من يميز كيف انا صغت الكتابه","يجني كنوز الدرر من لون فنّي",48,"ن",2,0],["من يمسك الزعزع النكباء عاصفةً","أو يدرأ السيل منصباً عن الأكم",49,"م",1,0],["من يمنحون بلادهم أمناً ،فلا","يبقى لكيد العابثين مكان",50,"ن",1,0],["من يمدح الأجواد ماهو بغلطان","هذي سلوم الناس في كل ديره",51,"ر",2,1],["من يم خلي ما تجينا العلومي","كن العواني قطعن عن تهامه",52,"م",2,0],["من يميز في طريق الشر حسن الاختيار","من صرخ في كل قلب مظلم بصوت النذير",53,"ر",1,0],["منْ يملكونَ الرُّواقَ الآن سمسرهم","من غلّفوا في قناني الضّوءِ أكفانا!",54,"ن",2,0],["من يمدحونك لا تصدقهم وخذها من خبير","كلامهم لو ظاهره رحمه مبطّن بالعذاب",55,"ب",1,0],["من يمد يديه ويقول ( هاك ) تجيه ( هات )","ومن تقنّع بالغموض يتجرّد بالوضوح",56,"ح",1,0],["مَنْ يُمسك الحِبَّ للدكتور يَخْتِنُه","أو يأخذُ اليدَّ ، روحي للحبيبِ فِدِا",57,"د",2,0],["من يماري البصر ساعة دنا ثم تدلىّ","غاب قوسين أو أدنى بسرعة وصوله",58,"ل",2,0]]}