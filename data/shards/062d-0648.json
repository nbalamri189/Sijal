لليل عاف لعله","https://www.aldiwan.net/poem22994.html","الطويل"],[46,"ترقبن الهواء بلطف رب","https://www.aldiwan.net/poem23100.html","الوافر"],[46,"وفر هذا الفتى مديد بسيط","https://www.aldiwan.net/poem23155.html","الخفيف"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[76,"حوراء داعبها الهوى في حور","https://www.aldiwan.net/poem38843.html","الكامل"],[76,"يا ليلة ليس في ظلمائها نور","https://www.aldiwan.net/poem39305.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85429","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/57715","المجتث"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140971",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16670","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19254","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19772","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202641","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30435","الخفيف"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11042","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9922","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9860","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42628","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42664","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54896","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54652","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54877","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54585","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54525","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1926","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[95,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=721",""],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[22,"مَا أَدْرِي إذا لاقَيْتُ عَمْراً","https://www.poetsgate.com/ViewPoem.aspx?id=19735",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[0,"لمن الديار غشيتها بسحام","https://www.poetsgate.com/ViewPoem.aspx?id=4786",""],[57,"تعاظمنى ذنبى","https://www.poetsgate.com/ViewPoem.aspx?id=10859",""],[45,"عاوَدََ القلْبَ بَثُّهُ وَخَبالُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32125",""],[28,"بكت عين محزون فطال انسجامها","https://www.poetsgate.com/ViewPoem.aspx?id=20996",""],[51,"نفَّرتْ هِيفَك الليالي وغيدَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=28487",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[101,"جدّدي يا رشيدُ للحبّ عَهْدَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62414&r=&rc=6",""],[95,"طلل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=240&r=&rc=3",""]],"verses":[["حَواها العِدا عَنّي فَأَصبَحنَ بِالحِمى","عَواطِلَ مِن آبي عَليقٍ وَصافِنِ",0,"ن",1,0],["حَوامِلَ ناحِلينَ عَلى ذُراها","حَوانِيَ يَنجَذِبنَ بِمُنحَنينا",1,"ن",2,0],["حَواقِلَةٌ مِثلُ الصَقورِ وَفِتيَةٌ","إِذا ماحَناني طارِقٌ دَعَموا ظَهري",2,"ر",2,0],["حَوامِلاً إِلى العِدى خَطِّيَّةً","تُعيرُ طَرفَ البَطَلِ المُقَطَّرِ",3,"ر",1,0],["حوشيتِ أَن أَلقاكَ سارِقَ لَحظَةٍ","تَلِدُ الوَفاءَ وَأُمُّ عَهدِكِ عاقِرُ",4,"ر",1,0],["حَوَّلنَ عَنُه نَواظِراً مُزوَرَّةً","نَظَرَ القِلى وَلَوَينَ عَنهُ خُدودا",5,"د",2,0],["حَوى المَجدَ يا قَيسَ بنَ عَيلانَ ماجِدٌ","وَجَلَّ فَما يُلقى لَهُ فيهِ حاسِدُ",6,"د",1,0],["حَوامي جِبالٍ رَعاها الحِمامُ","فَسَوّى بِهِنَّ الثَرى وَالجُنوبا",7,"ب",2,0],["حَوى خَرَزاتِ المُلْكِ بالبَأسِ والندىً","وغُصْنُ الصِّبا لَدْنُ المَهَرّةِ مائِسُ",8,"س",1,0],["حَوى عُنفُوانَ المَكْرَعِ الناسُ قَبلَنا","وأوْرَدَنا أعْقابَ شِرْبٍ مُصَرَّدِ",9,"د",1,0],["حَوامِلَ للحاجاتِ تُلقى رِحالُها","إِلى ماجِدٍ رَحْبِ الفِناءِ هُمامِ",10,"م",1,0],["حَولَ قَيسٍ مُستَلئِمِينَ بِكَبشٍ","قَرَظِيٍّ كَأَنَّهُ عَبلاءُ",11,"ا",2,0],["حَولي تَنفُضُ اِستُكَ مِذرَوَيه","لِتَقتُلَني فَها أَنا ذا عُمارا",12,"ر",2,1],["حَوى كُلَّ حُسنٍ في الكَواعِبِ شَخصُه","فَلَيسَ بِها إِلّا عُيوبُ الحَواسِدِ",13,"د",1,0],["حَودٌ رَداحٌ هَيفاءُ فاتِنَةٌ","تُخجِلُ بِالحُسنِ بَهجَةَ القَمَرِ",14,"ر",1,0],["حَولي ذَوّ الآكالِ مِن وائِلٍ","كَاللَيلِ مِن بادٍ وَمِن حاضِرِ",15,"ر",1,0],["حَواسِرٌ عَن خُدودٍ عايَنَت عِبَراً","وَلاحَها وَعَلاها غُبرَةٌ كُسُفُ",16,"ف",1,0],["حَوِّلوا النيلَ وَاِحجُبوا الضَوءَ عَنّا","وَاِطمِسوا النَجمَ وَاِحرِمونا النَسيما",17,"م",2,1],["حَوى ما حَوى مِن مَجدِهِم وَنِجارِهِم","وَزادَ فَأَعيا المادِحينَ وَأَفحَما",18,"م",2,0],["حَوى قَصبَ السَبقِ أَهلُ العِراقِ","وَعَطَّرَ ذِكرُهُم الأَندِيَه",19,"ه",1,1],["حَوالَيهِ أَشلاءُ الوُحوشِ نَضيدَةٌ","غَريضٌ عَلى مُستكرهٍ صائِكِ الدَفرِ",20,"ر",1,0],["حوراً تُعَلَّلُ بِالعَبيرِ جُلودُه","بيضُ الوُجوهِ نَواعِمُ الأَجسامِ",21,"م",1,0],["حَواجِرُها العُليا وَأَركانُها الَّتي","بِها مِن مَغافيرِ العِنازِ أَفارِقُ",22,"ق",1,0],["حَواجِبٌ كَالحِبالِ سودٌ","إِلى عَثانينَ كَالمَخالي",23,"ي",1,0],["حَوّاءُ قَرحاءُ أَشراطِيَّةٌ وَكَفَت","فيها الذِهابُ وَحَفَّتها البَراعيمُ",24,"م",1,0],["حَواريُّ النَبِيِّ وَمِن أُناسٍ","هُمُ مِن خَيرِ مَن وَطِئَ النِعالا",25,"ل",2,0],["حَوائِماً تَمنعُهُ أَن يَرقُدا","إِلّا غِشاشاً حافِياً مُسَهَّدا",26,"د",2,0],["حوراء جاءت وكل في مسرّته","لاهٍ وراحت وكل طرفه باك",27,"ك",1,0],["حوى منك قرماً بأسه ضامن له","بذلّ أعاديه وعزّ الأصادق",28,"ق",1,0],["حورُ العُيونِ يَمِسنَ غَيرَ جَوادِفٍ","هَزَّ الجَنوبِ نَواعِمَ العيدانِ",29,"ن",1,0],["حَوَينا أَبا زيقٍ وَزيقاً وَعَمَّهُ","وَجَدَّةُ زيقٍ قَد حَوَتها المَقانِبُ",30,"ب",1,0],["حَوَت هانِئً يَومَ الغَبيطَينِ خَيلُنا","وَأَدرَكنَ بِسطاماً وَهُنَّ شَوازِبُ",30,"ب",1,0],["حَوضُ الحِمارِ أَبو الفَرَزدَقِ فَاِعرِفوا","مِنهُ قَفاً وَمُقَلَّداً وَعِذارا",31,"ر",2,0],["حوقُ الحِمارِ أَبوكَ فَاِعلَم عِلمَهُ","وَنَفاكَ صَعصَعَةُ الدَعِيُّ المُسبَعُ",32,"ع",1,0],["حَوضُ الحِمارِ أَبو الفَرَزدَقِ فَاِعلَموا","عَقَدَ الأَخادِعِ وَاِنشِناجَ المِرفَقِ",33,"ق",1,0],["حَوَتِ اللُؤمَ وَالسَفاةَ جَميعاً","فَاِحتَوَت ذاكَ كُلُّهُ في قَرارِ",34,"ر",1,0],["حوته العلى قبل الحجورِ وهزَّهُ","حديث الثنا من قبل ما هزَّه المهد",35,"د",1,0],["حوى فلكي عند الوزير وطالما","أزيحت بجدوى راحتيه عوائقي",36,"ي",1,1],["حوى الدهر من علياه أشرف نسخةٍ","فقابلها يوم المفاخر بالأصل",37,"ل",1,0],["حوالة الصبّ قد أعيت وحيلتهُ","على لقاك فقل لي كيف أحْتال",38,"ل",1,0],["حوالتي قد أعجزت حيلتي","فانْهض عسى ينجح محتال",39,"ل",1,0],["حوراء إلاَّ أنها قد أسكنت","قلبي الذي تبلّته وهو جهنم",40,"م",1,0],["حوَت أمد الدنيا من المجدِ وانْبرت","تشقّ إلى الأخرى صنوف زحام",41,"م",1,0],["حوَيت ذُرا المجد لما حويت","فنون العلوم وأفنانها",42,"ن",3,1],["حوت كنانة سهماً من براعته","لا تعرف اليمن إلا حينَ تحويه",43,"ي",2,0],["حَوَيتَ بكُلّي كُلَّ كُلِّكَ يا قُدسي","تُكاشِفُني حَتى كَأَنَّكَ في نَفسي",44,"ي",1,1],["حوراءُ في وَطَفٍ قنواءُ في ذَلَفٍ","لَفَّاء في هَيَفٍ عجزاءُ في قَبَبِ",45,"ب",1,0],["حولَها مِنْ نِجَارِها عينُ رملٍ","ليس ينفكُّ صَيدُها أُسدَ غابِ",46,"ب",1,0],["حُوَّلٌ قُلَّبٌ لو انْغَلَّ يوماً","في خُروتٍ لأزْلَقته الخُروتُ",47,"ت",1,0],["حورٌ سحرنَ وما نَفَثنَ بِرُقيةٍ","فبلغنَ ما لا يبلغُ النُفَّاثُ",48,"ث",1,0],["حولك الصِّيدُ من رجالك كالجن","نان والهاشميُّ يفرع صيدَكْ",49,"ك",1,0],["حول خدٍّ فيه ماءٌ","واقفٌ للعين جاري",50,"ر",2,0],["حوسبتْ عينه بما","زيد في رحب دبرهِ",51,"ر",2,0],["حَوصاء خوصاءُ ذات عين","زرقاء في زرقة المَضيره",52,"ر",2,0],["حوى من المجد كنزاً لم يكن أحد","يحويه إلا بمالٍ غير مكنوز",53,"ز",1,0],["حُوَّلِهِ في الخطوب قُلَّبِهِ","حيّتِهِ في الدهاء نَضْنَاضه",54,"ض",2,0],["حوَّضتَ ودّاً لكي تُسقى على ظمأ","فما سُقيتَ ولا أغناك تحويضُ",55,"ض",1,0],["حُويلاءُ تَزني لا تراقبُ قُبحها","ولا نَتنَ حشَّيها المجيفينِ والإبِط",56,"ط",1,0],["حوى دوني الحليلة ثم أنحى","يُريغ إلى حليلته اللطيفا",57,"ف",2,0],["حوك امرئٍ لم يكن من قبل مكتسباً","بالشعر سأَّالةً للناس ملحافا",58,"ف",2,0],["حُوَّلٌ يغرقُ المداهون منه","في غمار يَرونها كالضحالِ",59,"ل",1,0],["حَوْلي وقد لظَّاهُ نَقْمٌ ينْقَمُهْ","لكنَّه ينهاه عني كرمُهْ",60,"م",2,0],["حُورُ المكارِم يَتَّمتْك وعِينُها","لا الشعرُ محفوفاً بحورٍ عين",61,"ن",1,0],["حَوامِلُ حاجاتٍ ثِقالٍ تَرُدُّها","إِلى حَسَنِ النُعمى سَواهِمُ نُسَّلُ",62,"ل",1,0],["حَوراءُ عَجزاءُ لَم تُقذَف بِفاحِشَةٍ","هَيفاءُ رُعبوبَةٌ مَمكورَةُ القَصَبِ",63,"ب",1,0],["حَوارِيَّةٌ لا يَقرَبُ الذَمُّ بَيتَها","مُطَهَّرَةٌ يَأوي إِلَيها مَطَهَّرُ",64,"ر",1,0],["حوبَيبَ اِبنُ عَتّابٍ أَرى الأَمرَ جَنبَةً","فَلا وَرَعٌ إِنَّ القِناعَ بِجُندَبِ",65,"ب",1,1],["حَولَ الصُخورِ النائِماتِ عَلى الثَرى","وَعَلى حَواشي الجَدوَلِ المُنسابِ",66,"ب",1,0],["حَولَها النورُ الَّذي يَجيء وَتَرضى بِالدَياجي","أَمِنَ الحِكمَةِ قَتلُ القَلبِ صَبراً لَستُ أَدري",67,"ي",1,0],["حَوى في شِعرِهِ عَبَثُ اِبنِ هاني","وَزادَ عَلَيهِ فَلسَفَةَ المَعَرّي",68,"ر",2,0],["حَوَت دارُ السَميرِ هَدِيَّتَيهِ","وَتَحوي هَذِهِ الأَوراقُ شُكري",68,"ر",2,0],["حَولَهُ عُصبَةُ سوءٍ كُلَّما","جاءَ إِدّاً أَقبَلَت مُعتَذِرَه",69,"ر",2,0],["حَولي إِذا أَرخى الظَلامُ سُجوفَهُ","لَيلانِ لَيلُ دُجى وَلَيلُ شُكوكِ",70,"ك",1,0],["حَولَهُ الكَونُِ في وَغىً","وَهوَ وَالكَونُ في وِئام",71,"م",1,0],["حَوى حَيُّ أَحياءٍ شِتيرَ اِبنَ خالِدٍ","وَقَد طَمَعَت في غُنمِ آخَرَ جَعفَرُ",72,"ر",1,0],["حَوَينَ جَميعَ الحُسنِ حَتّى كَأَنَّما","يَلوحُ بِها في وَجنَةِ اليَمِّ خيلانُ",73,"ن",1,0],["حوزِيَّةً طُوِيَت عَلى زَفَراتِها","طَيَّ القَناطِرِ قَد نَزَلنَ نُزولا",74,"ل",2,0],["حَوْلَ حِبِّي فهوَ قدْ","وَدَّعَ آفَاقَ الحَيَاة",75,"ه",1,0],["حول الحقيقة في الحياة طوافي","ولها برغم الكاشحين هتافي",76,"ي",1,1],["حواريين أوفدنا ثقاةً","إذا ترك البلاغ لهم فصاحا",77,"ح",2,0],["حَواهُ في سُبُحاتِ الطُهرِ قَبلَهُمُ","نورانِ قاما مَقامَ الصُلبِ وَالرَحِمِ",78,"م",1,0],["حَولَكَ الصالِحونَ طابوا وَطابَت","أَكَماتُ الإِمامِ مِنهُم وَقاعُه",79,"ع",2,0],["حَولٌ تُسائِلُ فيهِ كُلُّ نَجيبَةٍ","سَبَقَت إِلَيكَ مَتى يَحولُ فَتَلحَقُ",80,"ق",1,0],["حَولَ سُدَّةٍ","حَقُّها الرَغَب",81,"ب",1,0],["حَولَ عَرشِهِ عَجَمٌ","حَولَ عَرشِهِ عَرَبُ",82,"ب",1,0],["حَولَها الحَوائِمُ ما","يَنقَضي لَها قَرَبُ",82,"ب",1,0],["حُوَّماً فَوقَ جِبالٍ لَم تَكُن","لِلرِياحِ الهوجِ يَوماً بِوِطاء",83,"ا",2,0],["حَوَت دَمَكَ الأَرضُ في أَنفِها","زَكِيّاً كَأَنَّكَ عُثمانُها",84,"ن",3,0],["حَولَ اِستَرلَتزَ كانَ المُتلَقّى","وَاِصطِدامُ النَسرِ بِالمُستَنسِرين",85,"ن",1,0],["حَوَت رِقَّ القَواضِبِ وَالعَوالي","فَلَمّا ضُفتُها حَوَتِ اليَراعا",86,"ع",2,0],["حَوالى لُجَّةٍ مِن لازَوَردٍ","تَعالى اللَهُ خَلقاً وَاِبتِداعا",86,"ع",2,0],["حَوالِبُ الماذِيِّ مِن","زَهرِ الرِياضِ الشَيِّرَه",87,"ر",2,0],["حَوَتِ الجَمالَ فَلَو ذَهَبتَ تَزيدُها","في الوَهمِ حُسناً ما اِستَطَعتَ مَزيدا",88,"د",2,0],["ح