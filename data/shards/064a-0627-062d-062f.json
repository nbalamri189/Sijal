{"poems":[[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[68,"يا هلالا من سلطة العي حيي","https://www.aldiwan.net/poem38473.html","الخفيف"],[71,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[236,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[302,"صاح إن جزت بذي الأثل فحي","https://www.aldiwan.net/poem33082.html","الرمل"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[358,"انحل الجسم يا هذيم الغرام","https://www.aldiwan.net/poem40591.html","عموديه"],[438,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[469,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[505,"يا حداة العيس مهلا فالحمى","https://www.aldiwan.net/poem37639.html","الرمل"],[505,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[505,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[505,"هب نشر العرار من متكين","https://www.aldiwan.net/poem37763.html","الخفيف"],[505,"طار نحو الحبيب شحرور قلبي","https://www.aldiwan.net/poem37945.html","الخفيف"],[563,"بلغوا الحي من عريب كنانه","https://www.aldiwan.net/poem33686.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122738","الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39135","الخفيف"],[978,"","https://poetry.dctabudhabi.ae/diwan/poem/73897","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123144","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94293","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205775","الخفيف"],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5894,"يا حداة السرى بحث المطي","https://www.poetsgate.com/ViewPoem.aspx?id=131438",""],[5956,"في مسبح الليل","https://www.poetsgate.com/ViewPoem.aspx?id=182054",""]],"verses":[["يا حَديداً يَنسابُ فَوقَ حَديدٍ","كَاِنسِيابِ الرَقطاءِ فَوقَ الرَغامِ",0,"م",1,0],["يا حُداةَ المَطِيِّ ها نورُ نَجمِ ال","دينِ قَد لاحَ يا حُداةَ المَطِيِّ",1,"ي",1,0],["يا حداةَ العيسِ هذا منزلٌ","حُقَّ لي أني عليهِ أقِفُ",2,"ف",1,0],["يا حداة الركب الحجازي ميلوا","فبنعمان للركاب مقيل",3,"ل",1,1],["يا حدة الرمد الذي","لا يستفيق من القطور",4,"ر",1,0],["يا حُداةَ العيس أَقصى أَملي","وَقفَةٌ بين كَداءٍ وكُدي",5,"ي",1,0],["يا حُداة الظعنِ هل من وقفةٍ","برُبى طيبةَ تَشفي المُستَهاما",6,"م",2,0],["يا حداة الركبان والليل داج","والبراري يغشى رباها الظلام",7,"م",1,0],["يا حُداةَ العيسِ مهلاً إنّ لي","وسطَ الأحداجِ قلباً مُستطارا",8,"ر",2,0],["يا حُداةَ الركَابِ لا وأَل القا","صدُ منكم غير الحمى أن يجورا",9,"ر",2,0],["يا حداة العيس راحت كقسيّ","رامياتِ البيد منها بسهامِ",10,"م",1,0],["يا حداة العيس مهلا فالحمى","شمسه لاحت وقد هلَّ هلاله",11,"ل",2,1],["يا حداة الجمال يوم تداعت","نحون أرض الهدى ودار الكرامه",12,"م",2,0],["يا حُداةَ العِيسِ إنْ سِرتُمْ إلى","بُقْعَةٍ ماجَ بِها بحرُ المِنَنْ",13,"ن",1,0],["يا حُداةَ الجِمالِ مِتْكينُ لاحَتْ","ما وُقوفُ الحادي على تِبْرينِ",14,"ن",1,0],["يا حُداةَ النِّياقِ والعِشْقُ دينٌ","زَمْزِموا الصَّوتَ يا حُداةَ النِياقِ",15,"ق",1,0],["يا حداة المطيِّ للحيِّ قولوا","عن فؤادي وبينوا هيمانه",16,"ن",2,0],["يا حُداةَ الإبلِ الهيمِ قِفًُوا","لي فَواقاً يا حُداة الإبِلِ",17,"ل",1,0],["يا حُداةَ القُلوب ما العَدْلُ هذا","أتْبعُوها أجْسادَها أوْ دَعُوها",18,"ه",2,0],["يا حُداةَ العيسِ مَهلاً فَعَسى","يَبلُغُ الصَّبُّ لَدَيكُم أَمَلا",19,"ل",2,1],["يا حُداة بالمطايا","يممّوا خير البقاع",20,"ع",1,1],["يا حداة الركب هل من وقفة","حجها ميقاته النعيم",21,"م",1,0],["يا حداة الرياح ماذا لقيتم","من ركوب الأهوال والأخطار",22,"ر",1,0],["يا حداة العيس ما للعيس قد","أخذت تطوي حزون الأرض طي",23,"ي",1,0],["يا حداة السرى بحث المطي","عرجوا نحو بغيتي في العشي",24,"ي",1,1],["يا حديثا من حبيب مثلَ لحنٍ","وزَّعَ الإحساس أنوارا وظِلا",25,"ل",2,0]]}