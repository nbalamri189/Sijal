{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[54,"تضمنت لي الحاج","https://www.aldiwan.net/poem27199.html","الهزج"],[52,"وضعت قناعي وارتببت نجادي","https://www.aldiwan.net/poem63903.html","الطويل"],[128,"هاتها واشرب فإن اليوم فصح","https://www.aldiwan.net/poem23717.html","الرمل"],[173,"اليوم سر العلا واستبشر الأدب","https://www.aldiwan.net/poem1607.html",""],[382,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111796","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65140","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89207","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216733","المتقارب"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147278","المتقارب"],[5701,"أراني كالفراشة حين يبدو","https://www.poetsgate.com/ViewPoem.aspx?id=164654",""],[5567,"حمام الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82096&r=&rc=137",""]],"verses":[["فَأَنأى وَأَقرَبُ أوبِ الظَلي","مِ يَنتَظِرُ الطُعمَ رِئلانُهُ",0,"ن",2,0],["فَإِن أَيقَنتَ بِالشُربِ","وَما يَحويهِ عَربَدتا",1,"ت",2,0],["فَإِنَّ أُيورَ العامِرِيّينَ زَعفَةٌ","إِذا طَعَنَت في غَيرِ وَجهِ سَدادِ",2,"د",1,0],["فأنا يا عوف نشوان أسى","وخماري اليوم آلام وبرح",3,"ح",1,0],["فَإِنَّ أَيّامَها طرزُ الزَمانِ إِذ","عُدَّت وَتاجٌ بِهِ الأَعيادُ تَعتَصِبُ",4,"ب",1,0],["فأنأى نُفورِ القلب بغضُ أقاربٍ","وأقربُ أنس المرء حبُّّ الأباعد",5,"د",1,0],["فأنا يؤت بالمآثم فاصرف","أوجه العذر للعفو الغفور",6,"ر",1,0],["فانا يا مالكي عبدٌ","عَلَى العهدِ اقاما",7,"م",2,0],["فإنّ أيّامكم كانت مواسمها","وغير أيّامكم كانت مواسيها",8,"ي",3,0],["فإن أيامك الغر التي ابتهجت","مواسمٌ كلها حظ وأعراس",9,"س",1,0],["فآناً يقرّب بين العداة","وآنا يفرّق شمل الولاء",10,"ا",2,0],["فإن أينعت لحظتي ساعة","فلابد بعد ترى خيبتي",11,"ت",2,0],["فأنأى عنك لا كرها ولكن","أخاف إذا دنوت من احتراقي",12,"ي",1,0],["فأنَّا يمم العشاق وجها","تكونين الهوى بلدا أمينا",13,"ن",2,0]]}