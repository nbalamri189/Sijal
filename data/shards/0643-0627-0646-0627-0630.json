{"poems":[[65,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[48,"يا أمة ما لها عقول","https://www.aldiwan.net/poem23578.html","مجزوء البسيط"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[303,"سامح الله الحمامه","https://www.aldiwan.net/poem36251.html","عموديه"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[498,"وأعفر المسك تلقاه فتحسبه","https://www.aldiwan.net/poem67310.html","البسيط"],[572,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66772","السريع"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101505","الخفيف"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44570","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64135","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63939","المنسرح"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34514","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202072","الرجز"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67404","السريع"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110271","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32415","المنسرح"],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""]],"verses":[["كأنّ آذانَها الأقْلامُ جاريَةً","بِما نَبا السّيْفُ عنهُ في مَجاريها",0,"ي",3,0],["كأنَّ أذْناهُما لسامعه","صوتُ رحا الجَشِّ منه جشّاش",1,"ش",1,0],["كانَ إِذ سَوّاكَ سَوّاكَ بِلا عَقل وَروح","فَالَّذي تَفعَلُ إِثمٌ قالَ إِنّي لَستُ أَدري",2,"ي",1,0],["كَأَنَّ أَذنابَها في الكَرِّ أَلوِيَةٌ","عَلَى سَفِينٍ لِأَمرِ الرِّيحِ مُرتَسِمِ",3,"م",1,0],["كانَ إِذا ما دَجا ظَلامٌ","صاحَ بِأَجمالِهِ وَهاها",4,"ا",3,0],["كأنّ أُذْنَيْه أعطَتْ قلبَه خبَراً","عنِ السماءِ بما يلقى من الغِيَرِ",5,"ر",1,0],["كان إذْ ضمَّته كالزه","رةِ ضَمَّتها كمامه",6,"م",2,0],["كَأَنَّ آذَريونَها لَما اِبتَدَر","وَالياسَمينُ حَولُهُ مِثلُ الدُرَر",7,"ر",1,0],["كَأَنَّ أُذنَيهِ في حُسنِ اِنتِصابِهِما","إِذا هُما اِنتَصَبا لِلحِسِّ زُجّانِ",8,"ن",1,0],["كَأَنَّ أُذْنَيْهِ إِذَا","رِيْعَ بِشَخْصٍ فَاخْتَلَطْ",9,"ط",1,0],["كان إذا الحربُ مَرَتْها القَنا","وأحجمتْ عنها البَهاليلُ",10,"ل",1,0],["كان إذ ذاك للصبابة سرٌّ","فيهِ معنى الإسعاد والإِثراءِ",11,"ا",2,0],["كَأَنَّ آذَريونَها","أَسوَدَه وَأَحمَرُهْ",12,"ر",2,0],["كأنَّ آذريونَها","من فوقِ تلك القُضُبِ",13,"ب",1,1],["كان إِذا ما صَحَحْتَ في حبّه اعت","لَّ وإن زدتَ صبوةً نَقَصا",14,"ص",2,0],["كَأَنَّ أَذنابَ ما قَد كانَ صيدَ لَنا","مِن أَبرَميسَ وَرايٍ بِالشُبَيكاتِ",15,"ت",1,0],["كأنَّ أُذِنى ماوَعَتْ ما قدْ وَعتْ","أمْ جَهِلَ الفُؤادُ مِنِّى ما عَقَلْ",16,"ل",1,0],["كَانَ إذَا شُبَّتْ لَهُ نَارُهُ","يَرْفَعُهَا بِالسَّيِّدِ الْقَاتِلِ",17,"ل",1,0],["كان إذ ذاك طائراً في القضاء","ملك ينتحي ربوع السماء",18,"ا",2,0],["كان إذومين من الخيام","قد جاء عادياً على الأقدام",19,"م",1,0],["كانَ إِذا نِمتُ قالَ قُم فَإِذا","قُمتُ سَما بي لِأَعظَمَ الرُتَبِ",20,"ب",1,0],["كانَ أذكى وللغباواتِ طعمٌ","لا يسمّى وفي المسافاتِ تُهنا",21,"ن",2,0]]}