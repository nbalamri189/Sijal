{"poems":[[57,"أن التي حدثتك قد كذبت","https://www.aldiwan.net/poem26440.html","المنسرح"],[79,"وسائلة عن الحسن بن يحيى","https://www.aldiwan.net/poem35981.html","الوافر"],[79,"لما رأت راية القيسي زاحفة","https://www.aldiwan.net/poem36344.html","البسيط"],[49,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[64,"قالت حرمت الغنى من حيث أوتيه","https://www.aldiwan.net/poem52289.html","البسيط"],[64,"يقولون أبق المال واجمعه ممسكا","https://www.aldiwan.net/poem52509.html","الطويل"],[30,"زارت سكينة أطلاحا أناخ بهم","https://www.aldiwan.net/poem5052.html","البسيط"],[71,"قال لها الشيخ واصليني","https://www.aldiwan.net/poem28176.html","مخلع البسيط"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[50,"وأنمر الجلدة صيرته","https://www.aldiwan.net/poem64451.html","السريع"],[50,"ومعتد بالذي تحوي أنامله","https://www.aldiwan.net/poem64499.html","البسيط"],[52,"يا طيب عبدة ويلي منك يا طيبي","https://www.aldiwan.net/poem64854.html","البسيط"],[50,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[325,"يقولون جاهدا يا جميل بغزوة","https://www.aldiwan.net/poem67092.html","الطويل"],[463,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[463,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[534,"على عصر الشبيبة كل حين","https://www.aldiwan.net/poem37469.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122781","المتقارب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202123","الطويل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90646","المتقارب"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11920","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49546","البسيط"],[1786,"","https://poetry.dctabudhabi.ae/diwan/poem/121951","السريع"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115271","المجتث"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137473",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200615","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204493","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115674","الوافر"],[3088,"","https://poetry.dctabudhabi.ae/diwan/poem/145095","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65185","السريع"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11250","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87362","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97937","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32660","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114472","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44682","المجتث"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199077","البسيط"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4278,"","https://poetry.dctabudhabi.ae/diwan/poem/144414","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83485","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72746","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120352","الوافر"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[4830,"القلبُ الجَموح","https://www.poetsgate.com/ViewPoem.aspx?id=200251",""],[4830,"وقالوا صِفْ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=203356",""],[5092,"الأميرة","https://www.poetsgate.com/ViewPoem.aspx?id=164964",""],[5277,"نديانةُ العبق","https://www.poetsgate.com/ViewPoem.aspx?id=197752",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5376,"من مبلغ الريم عن لهفي لما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=188559",""],[5431,"زرياب وآلته ...","https://www.poetsgate.com/ViewPoem.aspx?id=205152",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""],[5804,"حوار معا الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=191224",""],[5971,"ياكاذبا اصبح في كذبه","https://www.poetsgate.com/ViewPoem.aspx?id=181203",""],[5975,"وسائلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=58501",""],[6093,"سَيْرٌ رِيَاضِي","https://www.poetsgate.com/ViewPoem.aspx?id=187112",""],[6269,"رحيل لم يحدث بعد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87854&r=&rc=16",""],[5567,"شغف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81761&r=&rc=29",""]],"verses":[["فَقُلتُ كَالمُشتَهي لِما ذَكَرَت","اِنطَلِقي أَتَّبِعكِ فَاِنطَلَقَت",0,"ت",1,0],["فقُلْتُ كأنْ بمَقْدَمِهِ فقالَتْ","بِشارَتُك الصّواهِلُ والنّجوعُ",1,"ع",1,0],["فَقُلْتُ كَانَ لَك الرَّحْمَانُ بَعْدِي مَا","سِوَاهُ مُعْتَمَدٌ وَالرَّأْيُ مُعْتَمِلُ",2,"ل",1,0],["فَقُلتُ كَما شاءَت وَشاءَ لَها الهَوى","قَتيلُكِ قالَت أَيَّهُم فَهُمُ كُثرُ",3,"ر",1,0],["فقلت كلّا ولكن طوله عجبٌ","بمثله شُغِل السُّمار والسمر",4,"ر",1,0],["فَقُلتُ كَذَلِكُم آنَستُ قَبلا","وَكانَ اللَهُ بِالنَجوى عَليما",5,"م",2,0],["فقلتُ كُفِّي فليس العُدْمُ منقصةً","وإنما المرءُ بالأخلاقِ والشِيَمِ",6,"م",1,0],["فقلت كلانا لا محالةَ هالكٌ","فأهوَنُ عندي من فنائِي فناؤهُ",7,"ا",3,0],["فَقُلتُ كَيفَ بِأَهلي حينَ عَضَّ بِهِم","عامٌ لَهُ كُلُّ مالٍ مُعنِقٌ جَزَرُ",8,"ر",1,0],["فقلتْ كيفَ فقالتْ","سُتَيْتَةٌ بسُبَيْعَهْ",9,"ه",1,0],["فَقُلتُ كَفُّ أبِي عثمان قد جَمَعَت","بَينَ الرَّدى والنَّدا والصَّابِ والعَسَلِ",10,"ل",1,0],["فَقُلتُ كُفّوا بَعضَ سُخرِيَّكُم","فَلَيسَ بِالهَيِّنِ ما لاقى",11,"ق",2,0],["فَقُلتُ كَأسَكَ خُذها قالَ مُحتَجِزاً","حَسبي الَّذي أَنا فيهِ أَيُّها الرَجُلُ",12,"ل",1,0],["فَقُلتُ كَلّا سَيَجزي مَن لَهُ كَرَمٌ","شَوقاً بِشَوقٍ وَتَقريباً بِتَقريبِ",13,"ب",1,0],["فقلت كفاني قد عرفت مكانها","بقطر بل حيث السفين تعوم",14,"م",1,0],["فَقُلتُ كَلّا وَهَل مِثلي يَليقُ بِهِ","مَدحُ الرِجالِ فَكَم جُرحٍ قَدِ اِلتَأَما",15,"م",2,0],["فَقُلتُ كَفاني الغانِياتُ وَحَربُها","وَأَيُّ جِهادٍ غَيرَهُنَّ أُريدُ",16,"د",1,0],["فقلت كانت هَناتٌ لستُ أذكرها","يجزي بها اللّهُ أقواماً بما صنعوا",17,"ع",3,0],["فقلتُ كريمٌ هزّه طيبُ أصله","وواحدُ قومٍ شاقه مدحُ أوحدِ",18,"د",1,0],["فَقُلتُ كَذَا أَقُولُ وكُلُّ قَوْلٍ","عَدا هذينِ تَطْرُقُهُ الرُّدودُ",19,"د",1,0],["فَقُلتُ كَفاني سِوَى الغانِمَينِ","بَنُوا غانِمٍ وَبَنُوا غانِمِ",20,"م",1,0],["فقلت كفاني أن يصافحني الردى","بحب بني طه كفاني من فخر",21,"ر",1,0],["فقلتُ كما قال ذو صبوةٍ","أبت نفسُهُ بعدُ إلا نِزاعا",22,"ع",2,0],["فَقُلتُ كَالشَهدِ يَحلو عِندَ كُلِّ فَمٍ","وَفي القُلوبِ لَهيبٌ مِنهُ يَستَعِرُ",23,"ر",1,0],["فقلتُ كُفّي فما تُغْني مُقارعتي","في أزْمَةٍ ضاعَ في أثْنائِها الأدب",24,"ب",1,0],["فَقلتُ كُفُّوا ولا تَعِيبوا","مِن بَعدِهِ غَابَتِ السِّباعُ",25,"ع",1,0],["فَقُلتُ كَأَنَّهُ هُوَ مِن بِعيدٍ","وَجَلَّت غُرَّةُ المَلِكِ الهُمامِ",26,"م",1,0],["فقلت كلا ولكن","اساء بينك حالي",27,"ل",2,0],["فَقُلتُ كَيفَ صادَتني سُلَيمى","وَلَمّا أَرمِها حَتّى رَمَتني",28,"ن",2,0],["فقلت كي لا تراني","بباب دارك قائم",29,"م",1,0],["فقلت : كلٌّ له من جنّتي ثمرٌ","فلا يسبّنّ ضيفي باقي الثمر",30,"ر",1,0],["فقلت كيف بآلامي تهنئني","فقال آلامنا للفن لذات",31,"ت",1,0],["فقلت كذاك شيمتكم ملال","وغدر لا ترون له فكاكا",32,"ك",2,0],["فقلت: كفاني الإله العميد ال","قديم ويكفي العميد الجديدا",33,"د",2,0],["فقلتُ كيف القولُ عن ذا وهل","يُوصفُ الإخفاء غيرُ الغراب",34,"ب",1,0],["فَقُلتُ كَريمٌ لَهُ هِمَّةٌ","يَنالُ فَأُدرِكُ ما أَطلُبُ",35,"ب",1,0],["فَقُلتُ كفوا لَيسَ لي من ضحىً","فَتِلكَ شمسي لم تزل في اِستتار",36,"ر",1,0],["فقلت كفى ولا تؤذيه سيدتي","فكل نفسٍ بها هم تولاها",37,"ا",3,0],["فقلتُ كذبتِ وقلتِ المُحال","فبالإفكِ باللهِ لا تقُسمي",38,"م",2,0],["فَقُلتُ كُلوا مِنها فَقالوا تَجَمُّزاً","أَتُطعِمُنا ناووسَ قَومٍ مِنَ العُجمِ",39,"م",1,0],["فقلتُ كلا الذي أجنيه ليسَ لهُ","شوكٌ وما أنتَ جانٍ شوكُهُ جانِ",40,"ن",1,0],["فَقُلتُ كَفا جَميعاً","وَأَمهلاني قَليلا",41,"ل",2,0],["فقلت كلا بحمد الله ليس سوى","ربي عليه اعتمادي في مدى غرضي",42,"ض",2,0],["فَقُلتُ كَذَلِكَ مَن عَضَّهُ","مِنَ الدَهرِ ناباهُ والمخلبانِ",43,"ن",1,0],["فقلت: كُفّي وارتعي","يُنبيكِ عنه خَبَره",44,"ر",2,0],["فَقُلت كلّا وَلكِن ما لَنا وَلَهُ","يكفيهِ أَنَّهُ مَيتٌ طيَّ أَرماسِ",45,"س",1,0],["فقلت كفاه الفخر إن الذي به","حوى شرف الاسلام نال به العزا",46,"ز",2,0],["فقلت كفتكم الدنيا اذاها","فذا البرجيس ينعب اذ بخور",47,"ر",1,0],["فقلت كسرى وآل شرعته","فقال كنا بجيشه وفدا",48,"د",2,0],["فقلتُ كَمَنْ ترجّى من دليلٍ","يأنُّ بطيّهِ قلبٌ قريحُ",49,"ح",1,0],["فقلتُ كفاكمُ اِضراَمَ قلبي","فدونُكمُ كِعابَ الحيّ تُرْبا",50,"ب",2,0],["فقلتُ كزئبقٍ في كَفِّ طفلٍ","أبى اِلاّ بكفِّ الطّفلِ لِعْبا",50,"ب",2,0],["فقلتُ كفاكِ بيْ أسرًا , فقالتْ","لَعَمْرُكَ في هواكَ أنا الأسيرَهْ",51,"ر",2,0],["فقلت كلا فلن أهواك من نزقٍ","يظل طول المدى في غصةِ النزقِ",52,"ق",1,0],["فقلتُ كلا ولكن ألبسي ولهي","ثوباً من الحب يكسو العشقَ بالخُلقِ",52,"ق",1,0],["فقلت كفاني بعيني دموع","تئن فؤادا وعين الشآمْ",53,"م",1,0],["فقلت كيف وغيداء مهفهفة","نجلاؤها ان بدت بالطيف سلانا",54,"ن",2,0],["فقلت كلا ...معي قلبي سيأكله","أكل الجناة لتنزيلٍ من السور",55,"ر",1,0],["فقلت كفّوا عن التهريج إن يدي","غير التي كان فيها يصدح القلم",56,"م",1,0],["فقلتُ كم صالحٍ في الدينِ مجتهدٍ","أمسى وجنَّةُ ربِّ الكونِ مأواهُ",57,"ا",2,0],["فقلت: كلا، انه كاذب","عرقوب لا يبلغ عرقوبه",58,"ب",2,0],["فقلتُ كلٌّ يوفّيكَ النعيمَ على","أن تتبعَ الآل .. آلَ البيتِ والركنِ",59,"ن",1,0],["فَقُلْتُ: كَلَامُكَ العَسَلُ المُصَفَّى","بِلَا شَكٍّ وَلا أَدْنَى اعْتِرَاضِ",60,"ض",1,0],["فقلت كلامًا لم أفسِّره غامضا","عليك سلام الله ما الحزن يُحملُ",61,"ل",1,0],["فقلتُ :كن سَكَنِي قال :اسكني رئتي","وقال :إن الهوى شاءَ الذي شينا",62,"ن",2,0]]}