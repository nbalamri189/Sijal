tps://www.poetsgate.com/ViewPoem.aspx?id=110822",""],[5736,"وصية","https://www.poetsgate.com/ViewPoem.aspx?id=203884",""],[5781,"أحلامٌ مُفكَّكةٌ ووِسادةٌ خالية","https://www.poetsgate.com/ViewPoem.aspx?id=202844",""],[5994,"لحن المدى","https://www.poetsgate.com/ViewPoem.aspx?id=184588",""],[6093,"الجذر ذاكرة النبات","https://www.poetsgate.com/ViewPoem.aspx?id=208005",""],[6125,"عَيْنِي مسهَّدةٌ وقَلْبِي واجِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=210913",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""]],"verses":[["كَالجَنابِ المَمطورِ يَزدَحِمُ الوُر","رادُ فيهِ وَالمَنزِلِ المَألوفِ",0,"ف",1,0],["كالجاهليّة غير أنّ مغارهم","في نهب كلّ خطيئة وجناح",1,"ح",1,0],["كالجنة الزهراء إلا أنَّ لي","من أدمعي فيها حميماً آن",2,"ن",1,0],["كَالجِنِّ ضَرّابينَ لِلرِقابِ","دَأبَ اِمرِئٍ لِلوَجَلى رَكّابِ",3,"ب",1,0],["كَالجَوابي لا تَني مُترَعَةً","لِقِرى الأَضيافِ أَو لِلمُحتَضِر",4,"ر",1,0],["كالْجِنِّ تهوَى الليلَ في وثَباتِها","وتَفِرُّ ذُعْراً من بُزوغِ صَباح",5,"ح",1,0],["كالجيشِ مهزومَ الكتائبِ فلَّه","ظَفَرٌ ورَقَّ عدوَه لفلوله",6,"ل",2,0],["كالجَوابي، لا تَني مُتْرَعَة ً","لقِرَى الأضيافِ أو للمتحضِر",7,"ر",1,0],["كالجبل الابلن ما هزه","من زمر الحساد هذا العوق",8,"ق",1,0],["كالجوهر المحض في كنز البها انتسقوا","ما بين غوث جليل عارف وولى",9,"ل",2,0],["كالجوهرِ الشفاف تنثر لؤلؤَا","فالقطْهُ ممن سرَّهُ مَا أعْلنَا",10,"ن",2,0],["كَالجَلاميدِ في المَسيلِ عَلاهُنَّ","مِنَ الماءِ خُضرَةٌ وَاِسمِرارُ",11,"ر",1,0],["كالجاهليَّة بالإسلام قد غُسِلت","ذنوبُها ونفى الإسلامُ ما اجتُرِما",12,"م",2,0],["كالجَور أو كالظُلْم أو كالغَدْر","وأنجمُ الجوزاء فيه تسري",13,"ر",2,0],["كَالْجَزُولِي ذِي دَلاَئِلِ خَيْرَا","تٍ وَأَتْبَاعِهِ هُدَاةِ النّاسِ",14,"س",1,0],["كالجمع لفظ مفرد لكنه","قد ضم افراد العداد الاكثر",15,"ر",1,0],["كالجمع يشمل كل فرد منهم","لكنه فرد بهم معدود",16,"د",1,0],["كَالجيدِ مِنها جيدُها","وَكَمُقلَتَيهِ مُقلَتاها",17,"ا",3,0],["كالجلنارة أو صفاء عقيقة","أو لمع نار أو وميض بروق",18,"ق",1,0],["كالجفْنِ أُطبِقَ ليلاً ثُمَّ فُتِّقَ في","صُبْحٍ أَضاءَ لأبصارٍ وأَحساس",19,"س",1,0],["كالجسم ينمي بالحرارة قوةً","وبما ترى أنفاسه تتنفس",20,"س",1,0],["كَالجِنِّ تَعرِفُها إِذا ما أَقبَلَت","وَتَكادُ تُنكِرُها مَعَ الإِدثارِ",21,"ر",1,0],["كالجمال الذي تهيأ للنوم","طويلا مع الشتاء الصديق",22,"ق",1,0],["كالجحفل اللجب الذي تعنو له","أمم ويشخر بالظما والجوع",23,"ع",1,0],["كَالجِذعِ إِلّا لِيفَهُ المَأبورِ","مُرَكَّبٍ في صَلَبٍ مَزفورِ",24,"ر",1,0],["كَالجُندِ في خُضرِ المَلابِسِ حاوَلوا","أَمراً فَبَينَ مُقَلِّصٍ وَمُشَمِّرِ",25,"ر",1,0],["كالجواري إذا لتحف","ن قصارَ الملاحف",26,"ف",1,0],["كالجاثليق على عُصيّتِه","يغدو وداراً خلفَهُ القَسُّ",27,"س",1,0],["كالجمع في تخاصم مع خاتم","إن أطلقا أو قيدا للناظم",28,"م",1,0],["كالجاحمِ المشبوبِ أو كالهاطل ال","مصبوبِ أو كالباشقِ المتسرعِ",29,"ع",1,0],["كَالجُدَرِيِّ الَّذي يُقالُ لَهُ","مُبارَكٌ وَهُوَ أَلفُ مَشئومِ",30,"م",1,0],["كالجِذْعِ شُذِّبَ حتى طالَ ثم هَفَا","ذاك السَّبيب فقلنا إنه سَعَف",31,"ف",1,0],["كَالجَبَلِ الشاهِقِ الهِضاب إِذا","أَشرَفتَ مِن رُعنِهِ عَلى أَكَمِه",32,"م",2,0],["كَالجَدوَلِ المُنقادِ إِلّا أَنَّهُ","لا يُحتَشى في الغِمدِ مِن جَرَيانِهِ",33,"ه",1,0],["كالجرح ينكأ جرحاً غير مندملٍ","وكالمريض يرى وهناً على وهن",34,"ن",1,0],["كالجيش لما ان رماه بالحصى","غشت شارتها على الابصار",35,"ر",1,0],["كالجِسرِ وَالبَابِ الذِي تركيبُهُ","بجِوَارِهِ لِمَحَلَّةٍ مِن بَانِ",36,"ن",1,0],["كَالجَفنِ فيهِ اليَماني بَعدَ جِدَّتِهِ","يَبلى وَيَصفَرُّ بَعدَ الخُضرَةِ العودُ",37,"د",1,0],["كالجوِّ لا يوجد إِظلامه","إِلا إِذا ما عُدِمَ النَّيِّرُ",38,"ر",1,0],["كالجَنَّة الفَيحاء تُص","بِح من جوى كجهنّمِ",39,"م",1,0],["كالجمر خداها فان سبحت","في الماء زاد توهج الجمر",40,"ر",1,0],["كالجو زهِرّ تراهُ من تضادُدِهِ","إن أسعد الرأس منه أنحس الذنب",41,"ب",1,0],["كالجوهري مشى بثوب أخضر","وبكفه سبحٌ م الفيروزج",42,"ج",1,0],["كَالجَمرِ تَحتَ الرَماد","مِن فَوقِهِ النَدُّ فاح",43,"ح",1,0],["كالجحفل الجرار دون لقائه","للطامعين منية وشقاء",44,"ا",2,0],["كالجمر تلفح كف حاملها","فتظنُّه منها على خطر",45,"ر",1,0],["كالجَنَّةِ الزَهراء طافَ بكرمِها","عنابها فَتَناثَرَت أَعنابُها",46,"ب",3,0],["كالجسم فيه غيرُ عضوٍ تعشق ال","مستور منه وتحمد المكشوفا",47,"ف",2,0],["كالجسم أعوزها الرقاد فهوَّمت","هرباً من العنت الذي يعتادها",48,"د",3,0],["كالجدولِ الرَّقراقِ يمشي هادئاً","في خِلسةٍ بيْنَ النُّفوسِ يُسقسِقُ",49,"ق",1,0],["كالجلنارِ تفتحتْ إكمامُها","وهي التي تشقى بمسِّ النارِ",50,"ر",1,0],["كالجسم والأحياز والجهة التي","ينفونها ذاك الفريق الفاتن",51,"ن",1,0],["كالجرح يُبنى على فسادٍ","بظاهرٍ الصّلاحِ",52,"ح",1,0],["كالْجَوْزةِ الصّماءِ تَحوي مَغنماً","خُشُبُ القُشور، قُلوبهمْ بيضاءُ",53,"ا",2,0],["كَالجَزْرِ في حَزَنٍ يُرْخي سَتائِرَهُ","يا لَيْتَهُ المَدُّ في مَلْقى الصِّبا عَرِمُ",54,"م",1,0],["كالجمر تحرقني بلا رفق وفي","نفث الصبابات ابتغيت المغنما",55,"م",2,0],["كالجذر ذاكرة النبات وإن يكن","داء به ستراه في الأوراق",56,"ق",1,0],["كالجنِّ تختالُ ابْتداءً مُذْ أبَتْ","فتزيغُ لم يرقبْ خُطَاها القَائفُ",57,"ف",1,0],["كالجُرح ينزِفُ من عليَائِه ألمًا","حتى تذوقَ هواهُ حرقة ودم ُ",58,"م",1,0]]}