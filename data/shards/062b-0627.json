 يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[467,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[467,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[467,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[482,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[498,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[503,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[503,"نحن الرفاعية الأعلام ما برحت","https://www.aldiwan.net/poem38016.html","البسيط"],[509,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[518,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[554,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[554,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[554,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[554,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[556,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[561,"ثمرات على غصون الحوادث","https://www.aldiwan.net/poem33556.html","الخفيف"],[565,"ثار الدخان فلم يظهر له لهب","https://www.aldiwan.net/poem52769.html","البسيط"],[570,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[854,"","https://poetry.dctabudhabi.ae/diwan/poem/29473","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10407","الطويل"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/203554","الطويل"],[901,"تذكرَ ليلى حسنَها وصَفَاءها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27396&r=&rc=0",""]],"verses":[["ثالِثَ الناظِرَينِ عِز","زاً وَلِلنَفسِ ثانِيا",0,"ي",2,0],["ثابِتٌ في طينَةِ المَجدِ إِذا","مَنصِبٌ أَمسى زَليقَ القَدَمَينِ",1,"ن",1,0],["ثارَ بِهِ الجَهلُ فَاِبتَسَمتُ لَهُ","وَرُبَّ جانٍ عِقابُهُ الضَحِكُ",2,"ك",1,0],["ثارَت حَرارَتُها في الصَدرِ فَاِشتَعَلَت","كَأَنَّما هِيَ نارٌ أُطعِمَت سَعَفا",3,"ف",2,0],["ثائِرٌ راقبَ منْهُ فُرصَةً","ثمّ لمّا أمْكَنَتْهُ بطَشا",4,"ش",2,0],["ثاوِياً ماثِلاً يُقَلِّبُ زُرقاً","رَمَّها القَينُ بِالعُيونِ حُشورا",5,"ر",2,0],["ثَأَرتَ اللَيالي وَأَقعَدتَها","بِمَصقولِ عَزمِكَ عَن ثارِها",6,"ر",3,0],["ثارت عجاجته واليوم محتجبٌ","والنقع يؤثر غيماً من دياجيها",7,"ي",3,0],["ثار طرّادهم يجيش بنسّا","فات سُفن لهم سَجرن الوطيسا",8,"س",2,0],["ثَأَرتَ المِسمَعَينِ وَقُلتَ بوؤوا","بِقَتلِ أَخي فَزارَةَ وَالخِيارِ",9,"ر",1,0],["ثاوٍ على حلب ولكن جوده","ينهلُّ منه على الفرات النيل",10,"ل",1,0],["ثارَ إليَّ بلومٍ لا يلائمني","فصحّ لي إنما في العقل ثوران",11,"ن",1,0],["ثاقِب الرأي نافذ الفكر فيها","غير ذي فَتْرة ولا إبْطاءِ",12,"ا",2,0],["ثابتُ الحالِ في الزلازل مُنْها","لٌ لسُؤّالهِ انهيالَ الكثيبِ",13,"ب",1,0],["ثاقبُ الفِكرِ ما تمهَّلَ في الرأْ","يِ شديدُ الإسداء والإلحام",14,"م",1,0],["ثاقب الجمرة إن حرَّكته","وترى الحلم عليه إن سكن",15,"ن",1,0],["ثأر سيبقى فتقه","دهراً بغير رائب",16,"ب",1,0],["ثابت انت والليالي توالى","خالد انت والسنون تدول",17,"ل",1,0],["ثارَ بِعَبدِ اللَهِ ثائِرُ الحَسَد","وَزَعم الغابَ أَتى غَيرَ الأَسَد",18,"د",1,0],["ثابَت سَلامَتُهُ وَأَقبَلَ صَحوُهُ","إِلا بَقايا فَترَةٍ وَسَقامِ",19,"م",1,0],["ثَأَرَ المُلوكُ وَظَلَّ عِندَ إِبائِهِ","يَرجو وَيَأمَلُ عَفوَهُ المَثؤورُ",20,"ر",1,0],["ثارَت عَلى الحامي العَتيدِ وَأَقسَمَت","بِسِواهُ جَلَّ جَلالُهُ لا تَحتَمي",21,"م",2,0],["ثَأرُ عُثمانَ لِمَروانٍ مَجاز","وَدَمَ السِبطِ أَثارَ الأَقرَبون",22,"ن",1,0],["ثابِتٌ وَذِروَتُهُ","في الفَضاءِ تَضطَرِبُ",23,"ب",1,0],["ثاقِبُ الرَأيِ ثابِتُ الحِلمِ لا يَق","دِرُ أَمرٌ لَهُ عَلى إِقلاقِ",24,"ق",1,0],["ثاني الخَليفَةِ في النَدى","وَشَبيهُهُ كَرَماً وَنِدُّه",25,"د",2,0],["ثانِيَ اللَيلِ ثالِثَ البيدِ وَالسَي","رِ نَديمَ النُجومِ تِربَ السُهادِ",26,"د",1,0],["ثاني وُجوهُ الخَيلِ مُقَوَّرَةٌ","في الكَرِّ حَتّى تَستَقِلَّ الصَريع",27,"ع",1,0],["ثابِتٌ في المَكَرِّ إِذ راحَ لِلفُر","سانِ عَن جانِبِ الصَريعِ مَجالُ",28,"ل",1,0],["ثاوٍ مَضى وَالجودُ تِلوٌ لَهُ","لا أَوَّلٌ يُرجى وَلا ثانِ",29,"ن",1,0],["ثاروا بِنا فَطَفِقتُ حينَ أَراهُم","حَذِراً أُذَكِّرُ ذِكرَكُم وَأُؤَنِّثُ",30,"ث",1,0],["ثاني عِنانِ الحادِثاتِ وَفارِسٌ","أَمسى جَوادُ الدَهرِ مِنهُ يَلهَثُ",30,"ث",1,0],["ثارَت بِنا تَطوي القِفارَ فَعِندَما","آنَستُ نارَكَ قُلتُ لِلرَكبِ اُمكُثوا",30,"ث",3,0],["ثارَ العَجاجُ فَكُنتُ أَوَّلَ صائِلٍ","وَعَلا الضِرامُ فَكُنتُ أَوَّلَ مُصطَلِ",31,"ل",1,0],["ثابِتٌ عِندَ المَعالي فَضلُهُ","هل يُطيقُ اللَّيلُ للصُّبح جُحود",32,"د",1,0],["ثابتٌ كالطود في معتركٍ","جائلِ الأبطال خفّاقِ العَذَبْ",33,"ب",1,0],["ثانيهِ في كَبِدِ السَماءِ وَلَم يَكُن","لِاِثنَينِ ثانٍ إِذ هُما في الغارِ",34,"ر",1,0],["ثانِياً مِن زِمامِ وَجناءَ حَرفٍ","عاتِكٍ لَونُها يُخالُ خِضابا",35,"ب",2,0],["ثارَ القَتامُ بِهِم دُخاناً وَاِرتَمى","زَندُ الحَفيظَةِ مِنهُمُ بِشَرارِ",36,"ر",1,0],["ثارَ الزمانُ عليَّ ثورةَ جاهلٍ","هاجَتْهُ نافضةُ الحلومِ فصالا",37,"ل",2,0],["ثارَت عَلَيهِ شُعوبُهُ وَهُمومُهُ","فَتَأَلَّبَ الطوفانُ وَالبُركانُ",38,"ن",1,0],["ثارت بصالح نخوة قذفت به","في وجه اقبح ظالم متمادِ",39,"د",1,0],["ثَأَرتُ بِهِ بِما اِقتَرفَت يَداهُ","فَظَلَّ لَها بِنا يَومٌ غَشومُ",40,"م",1,0],["ثاوِياتٌ ما بَينَ دارٍ لَقيطٍ","ما يُزايِلنَها فَكُتّابُ بَحرِ",41,"ر",1,0],["ثاوِياتٍ عَلى البَليخِ مَحلّاً","في قِبابٍ أَو يَنثَنينَ قُصورا",42,"ر",2,0],["ثابت الوضع لَيسَ يَبدو حراكٌ","فيه حَتّى حسبته تمثالا",43,"ل",2,0],["ثارَت عَلى شرق الفرات وَغربه","حربٌ كَما شاءَ الدفاع عوان",44,"ن",1,0],["ثاروا عَلى العلم باسم الدين واِحتقروا","من ليس في زمرة الثوار منخرطا",45,"ط",2,0],["ثاقب العقل ثابت الحلم لا يق","در أمرٌ له على إقلاق",46,"ق",1,0],["ثاروا على القيد حتى انحلَّ واقتحموا","على الطواغيتِ حِصنَ الظلم فانهارا",47,"ر",2,0],["ثار الى حيث النبيُّ موعدا","ومبرقاً بسيفه ومرعدا",48,"د",2,0],["ثِانيَاتٌ قَطائِفَ الخَزِّ والدِّي","باَجِ فَوقَ الخُدُورِ والأَنماطِ",49,"ط",1,0],["ثَابِرْ عَلَى تِلْكَ العَزَائِمِ ذَائِداً","عنْ مِصْرَ تضرِبُ فِي البِلاَدِ مُطَوِّفَا",50,"ف",2,0],["ثابَتْ إلى فَرَحٍ كَذَ","لِكَ تَوبَةُ المُتَسَرِّعِ",51,"ع",1,0],["ثَأَرْتَ لِلشَّرْقِ مِنْ دَهْرٍ قَضَاهُ وَلاَ","ذِكْرَى لَهُ غَيْرُ مَا يُحْكَى عَنِ السَّلَفِ",52,"ف",1,0],["ثَابِرُوا فِي وَثْبِكُمْ وَلْتَهْنِنَا","فِي تَلاَشِينَا الهَنَاتُ الهَيِّنَاتُ",53,"ت",1,0],["ثاراتُ طارقٍ الأولى تُؤَرِّقُهم","وما لما تتركُ الثاراتُ نسيانُ",54,"ن",1,0],["ثارت نفوس الناس فيه، ولن ترى","كالشعب حين يصاب في أقواته",55,"ت",2,0],["ثابروا جهدكم لا تسأموا","قد بدوا لي فتح أمر منتظر",56,"ر",1,0],["ثابت اليك عصائب وهبيه","من أسد ذي يمن وأسد نزار",57,"ر",1,0],["ثاروا صباح القصف لكنهم","يوم انتصار الثورة استسلموا",58,"م",3,0],["ثائر يحمل البلاد قلوبا","في حشاه وشعلة في اعتقاده",59,"د",2,0],["ثَأَرْتُ بِهِ وَمَا افْتَرَقَتْ يَدَاهُ","فَظَلَّ لَهَا بِنَا يَوْمٌ غَشُومُ",60,"م",1,0],["ثار الشبابُ ومن مثلُ الشباب اذا","ريعَ الحمى وشُواظُ الغَيْرَةِ احتدما",61,"م",2,0],["ثَاني وُجُوهِ الخَيلِ مُقْوَرّةً","في الكَرّ حتّى يَستَقِلّ الصّرِيعْ",62,"ع",1,0],["ثاراتُ يَعْرُبَ ظَمأى في مَراقِدِها","تَجاوزتها سُقاةُ الحَيِّ نِسيانا",63,"ن",2,0],["ثارات يعرب ظمأى في مصارعها","تجاوزتها سقاة الحيّ نسيانا",64,"ن",2,0],["ثأرَ الملوك، وظلَّ عندَ إبائه","يرجو ويأمن عفوه المثؤور",65,"ر",1,0],["ثاو بمثوى الانقطاع عن الورى","في كثرة وحدي مع الجدران",66,"ن",1,0],["ثاني الخمسة اصحاب العبا","صهر طه مقتدى كل ولي",67,"ل",2,0],["ثار عجاج الدرب لما انبرت","تشق بالاجفان تلك الشقاق",68,"ق",1,0],["ثاني الوزير بن والقرم المهاب ومن","من ازره قام عن دين الهدى وزر",69,"ر",1,0],["ثاب العزاءُ وحان الأخذُ بالثار","قد عاد في غابه الضّرغامةُ الضاري",70,"ر",2,1],["ثافراً وهو قريب","وهو جم اللفتات",71,"ت",1,0],["ثَاقِبُ الذِّهنِ في العَوِيصِ مُضِىءُ","لَيلِهِ الدَّاجِى الدَّجُونِ البَهِيمَا",72,"م",2,0],["ثاروا لِقَتلِ مُحَمَّدٍ فَنَهاهُمُ","عَنهُ وَجاهَدَ أَحسنَ التّجهادِ",73,"د",1,0],["ثاروا إلى الحرب إذ حانت مصارعهم","وضاقت الأرض عمن جاش منه دم",74,"م",1,0],["ثار الغبار كليل شك مظلم","فنضا من الأغماد صبح يقين",75,"ن",1,0],["ثآليل كفر قد أبانت رؤسها","فإن هي لم تحسم تداعت بها الادوا",76,"و",2,0],["ثار شَوقي إلى الحِمى","وَهوى الخُرَّد الدُمى",77,"م",2,1],["ثَأَرتَ مُزَاحِماً وسَرَرتَ قَيساً","وكُنتَ لِمَا هَمَمتَ بِه فَعولا",78,"ل",2,0],["ثاوِياً ثمّة في الحرزِ الأمين","في جوارِ المُصطفى أكرمِ جار",79,"ر",1,0],["ثارَ فيها أوباشُهم كوحوشٍ","بانَ مِنها للقانصِ الأخفياءُ",80,"ا",2,0],["ثاوٍ ثَوى مِنهُ في قَلبي جَوى ضَرم","يَشبُّ كَالسَيفِ حَداً وَالسِنان شَبا",81,"ب",2,0],["ثاء ثوينا نجتني زَهَرَ المنى","من كل غصن في نقا قد مالا",82,"ل",2,0],["ثارت الدنيا عليه اذ وهى","وكذا الدنيا على الواهي تثور",83,"ر",1,0],["ثائِرَةً كَالهَولِ في ساحِهِ","وَبِالرُؤى من بيضِ اِشباحِه",84,"ه",1,0],["ثائِرَةٌ كَالمَوجِ إِن تَلعِب","الأَرواحُ في طَيّاتِهِ يُزيدِ",85,"د",1,0],["ثابتُ الجَأشِ عندما يَقلَقُ الجَي","شُ ويَخشَى رَيبَ الحمامِ أُسُودُه",86,"د",2,0],["ثاقبُ الفَهمِ إن يَغب عنه أَمرٌ","كامنٌ فهوَ بالذكاءِ شَهيدُه",86,"د",2,0],["ثابتُ الجأشِ باسمُ الثَّغرِ","والأبطالُ في لُجَّةِ الدماءِ تَخُوضُ",87,"ض",1,0],["ثار القريض بقلب كاد يعصيه","لولا البوارقلاحت من قوافيه",88,"ي",2,0],["ثائرٌ في كلِّ يومٍ","لا تَرى إلا رضاكَ",89,"ك",1,0],["ثابِتُ الجَأشِ إِذا جاشَت لَدى ال","غَيضِ في المَحفَلِ أَكبادُ الرِجالِ",90,"ل",1,0],["ثابِتٌ في الخَيرِ وَالشَرِّ مَعاً","لِذَوي الطَيشِ لَدى الحالَينِ قالي",90,"ل",2,0],["ثاروا وقد نذروا للحقّ أنفسَهُم","وفي سبيل العلا والمجد ما نذروا",91,"ر",3,0],["ثَأري إِليهِ وفودُ الشكرِ مضحيةً","وَالفخر مُصطبحاً والأجر مُعتبقا",92,"ق",2,0],["ثارَت بِهِ ضُمَّرٌ قُبٌّ مُقَلَّدَةٌ","كَالقِدحِ يُجذِمُها صوحانُ أَو ثَقَفُ",93,"ف",1,0],["ثار في صدري إذ ناديته","إسترح يا قلب من هذا العذاب",94,"ب",1,0],["ثالثها الإحياء للعلوم","والرابع العمل بالمعلوم",95,"م",1,0],["ثالثها حرص على طلبه","كمثل حرص الكلب في مطلبه",95,"ه",1,0],["ثائر كل ثائر","مثل بركان استعر",96,"ر",1,0],["ثار وراءَ الرَّكْبِ مُستَعْجلاً","يَلُفُّ أُولاهُ بأُخراه",97,"ا",2,0],["ثاقبُ الرأي لم يَخِبْ قاصدٌ منْ","هُ بحالٍ ولم يَفُتْ مَقْصود",98,"د",1,0],["ثابتُ جأْشٍ عند الحِفاظِ إذا","قلقَلَ نَفْسَ الجبَانِ مَجشؤها",99,"ا",3,0],["ثاني اثنين ، يا خيول قريش","هل سيجدي فيكن كبح الجماح",100,"ح",1,0],["ثاني اثنين ، والعدو قريب","وحفي