{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"فخرت قحطان أن كان لها","https://www.aldiwan.net/poem29738.html","الرمل"],[53,"ورب غاو رميت منطقه","https://www.aldiwan.net/poem29914.html","المنسرح"],[55,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[77,"يا هلالا يا قضيبا يا رشا","https://www.aldiwan.net/poem35869.html","الرمل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[27,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[72,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[72,"أشعت حبي في القاصي وفي الداني","https://www.aldiwan.net/poem20230.html","البسيط"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[89,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[85,"ما جل فيهم عيدك المأثور","https://www.aldiwan.net/poem62883.html","الكامل"],[85,"في مهرجان الحق أو يوم الدم","https://www.aldiwan.net/poem62949.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[43,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"ما لها أولعت بقطع الوداد","https://www.aldiwan.net/poem63473.html","الخفيف"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[45,"أصدود غلا بها أم دلال","https://www.aldiwan.net/poem65596.html","الخفيف"],[45,"ضاعف من بثي وأحزاني","https://www.aldiwan.net/poem66820.html","السريع"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[31,"حن قلبي من بعد ما قد أنابا","https://www.aldiwan.net/poem42655.html","الخفيف"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[105,"عرش القياصر والقضاء إذا جرى","https://www.aldiwan.net/poem43116.html","الكامل"],[102,"عهد الجدود سقاك صوب عهاد","https://www.aldiwan.net/poem33003.html","الكامل"],[13,"يقول لي الخلي وبات جلساً","https://www.aldiwan.net/poem2201.html","الوافر"],[48,"حي ربع الغنى وأطلال حسن","https://www.aldiwan.net/poem63392.html","الخفيف"],[50,"قم خليلي فانظر أراك بصيرا","https://www.aldiwan.net/poem63816.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85369","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85403","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85375","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140936",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39668","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21052","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55026","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[13,"لَقَدْ قَالَ الخَلِيُّ وَقَالَ حُلْساً","https://www.poetsgate.com/ViewPoem.aspx?id=180796",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[45,"كَلّفَني، فَوْقَ الذي أسْتَطيعْ","https://www.poetsgate.com/ViewPoem.aspx?id=31119",""],[85,"ما جلَّ فيهم عيدُك المأْثورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9602&r=&rc=92",""]],"verses":[["ثالِثَ الناظِرَينِ عِز","زاً وَلِلنَفسِ ثانِيا",0,"ي",2,0],["ثابِتٌ في طينَةِ المَجدِ إِذا","مَنصِبٌ أَمسى زَليقَ القَدَمَينِ",1,"ن",1,0],["ثارَ بِهِ الجَهلُ فَاِبتَسَمتُ لَهُ","وَرُبَّ جانٍ عِقابُهُ الضَحِكُ",2,"ك",1,0],["ثارَت حَرارَتُها في الصَدرِ فَاِشتَعَلَت","كَأَنَّما هِيَ نارٌ أُطعِمَت سَعَفا",3,"ف",2,0],["ثائِرٌ راقبَ منْهُ فُرصَةً","ثمّ لمّا أمْكَنَتْهُ بطَشا",4,"ش",2,0],["ثاوِياً ماثِلاً يُقَلِّبُ زُرقاً","رَمَّها القَينُ بِالعُيونِ حُشورا",5,"ر",2,0],["ثَأَرتَ اللَيالي وَأَقعَدتَها","بِمَصقولِ عَزمِكَ عَن ثارِها",6,"ر",3,0],["ثارت عجاجته واليوم محتجبٌ","والنقع يؤثر غيماً من دياجيها",7,"ي",3,0],["ثار طرّادهم يجيش بنسّا","فات سُفن لهم سَجرن الوطيسا",8,"س",2,0],["ثَأَرتَ المِسمَعَينِ وَقُلتَ بوؤوا","بِقَتلِ أَخي فَزارَةَ وَالخِيارِ",9,"ر",1,0],["ثاوٍ على حلب ولكن جوده","ينهلُّ منه على الفرات النيل",10,"ل",1,0],["ثارَ إليَّ بلومٍ لا يلائمني","فصحّ لي إنما في العقل ثوران",11,"ن",1,0],["ثاقِب الرأي نافذ الفكر فيها","غير ذي فَتْرة ولا إبْطاءِ",12,"ا",2,0],["ثابتُ الحالِ في الزلازل مُنْها","لٌ لسُؤّالهِ انهيالَ الكثيبِ",13,"ب",1,0],["ثاقبُ الفِكرِ ما تمهَّلَ في الرأْ","يِ شديدُ الإسداء والإلحام",14,"م",1,0],["ثاقب الجمرة إن حرَّكته","وترى الحلم عليه إن سكن",15,"ن",1,0],["ثأر سيبقى فتقه","دهراً بغير رائب",16,"ب",1,0],["ثابت انت والليالي توالى","خالد انت والسنون تدول",17,"ل",1,0],["ثارَ بِعَبدِ اللَهِ ثائِرُ الحَسَد","وَزَعم الغابَ أَتى غَيرَ الأَسَد",18,"د",1,0],["ثابَت سَلامَتُهُ وَأَقبَلَ صَحوُهُ","إِلا بَقايا فَترَةٍ وَسَقامِ",19,"م",1,0],["ثَأَرَ المُلوكُ وَظَلَّ عِندَ إِبائِهِ","يَرجو وَيَأمَلُ عَفوَهُ المَثؤورُ",20,"ر",1,0],["ثارَت عَلى الحامي العَتيدِ وَأَقسَمَت","بِسِواهُ جَلَّ جَلالُهُ لا تَحتَمي",21,"م",2,0],["ثَأرُ عُثمانَ لِمَروانٍ مَجاز","وَدَمَ السِبطِ أَثارَ الأَقرَبون",22,"ن",1,0],["ثابِتٌ وَذِروَتُهُ","في الفَضاءِ تَضطَرِبُ",23,"ب",1,0],["ثاقِبُ الرَأيِ ثابِتُ الحِلمِ لا يَق","دِرُ أَمرٌ لَهُ عَلى إِقلاقِ",24,"ق",1,0],["ثاني الخَليفَةِ في النَدى","وَشَبيهُهُ كَرَماً وَنِدُّه",25,"د",2,0],["ثانِيَ اللَيلِ ثالِثَ البيدِ وَالسَي","رِ نَديمَ النُجومِ تِربَ السُهادِ",26,"د",1,0],["ثاني وُجوهُ الخَيلِ مُقَوَّرَةٌ","في الكَرِّ حَتّى تَستَقِلَّ الصَريع",27,"ع",1,0],["ثابِتٌ في المَكَرِّ إِذ راحَ لِلفُر","سانِ عَن جانِبِ الصَريعِ مَجالُ",28,"ل",1,0],["ثاوٍ مَضى وَالجودُ تِلوٌ لَهُ","لا أَوَّلٌ يُرجى وَلا ثانِ",29,"ن",1,0],["ثاروا بِنا فَطَفِقتُ حينَ أَراهُم","حَذِراً أُذَكِّرُ ذِكرَكُم وَأُؤَنِّثُ",30,"ث",1,0],["ثاني عِنانِ الحادِثاتِ وَفارِسٌ","أَمسى جَوادُ الدَهرِ مِنهُ يَلهَثُ",30,"ث",1,0],["ثارَت بِنا تَطوي القِفارَ فَعِندَما","آنَستُ نارَكَ قُلتُ لِلرَكبِ اُمكُثوا",30,"ث",3,0],["ثارَ العَجاجُ فَكُنتُ أَوَّلَ صائِلٍ","وَعَلا الضِرامُ فَكُنتُ أَوَّلَ مُصطَلِ",31,"ل",1,0],["ثابِتٌ عِندَ المَعالي فَضلُهُ","هل يُطيقُ اللَّيلُ للصُّبح جُحود",32,"د",1,0],["ثابتٌ كالطود في معتركٍ","جائلِ الأبطال خفّاقِ العَذَبْ",33,"ب",1,0],["ثانيهِ في كَبِدِ السَماءِ وَلَم يَكُن","لِاِثنَينِ ثانٍ إِذ هُما في الغارِ",34,"ر",1,0],["ثانِياً مِن زِمامِ وَجناءَ حَرفٍ","عاتِكٍ لَونُها يُخالُ خِضابا",35,"ب",2,0],["ثارَ القَتامُ بِهِم دُخاناً وَاِرتَمى","زَندُ الحَفيظَةِ مِنهُمُ بِشَرارِ",36,"ر",1,0],["ثارَ الزمانُ عليَّ ثورةَ جاهلٍ","هاجَتْهُ نافضةُ الحلومِ فصالا",37,"ل",2,0],["ثارَت عَلَيهِ شُعوبُهُ وَهُمومُهُ","فَتَأَلَّبَ الطوفانُ وَالبُركانُ",38,"ن",1,0],["ثارت بصالح نخوة قذفت به","في وجه اقبح ظالم متمادِ",39,"د",1,0],["ثَأَرتُ بِهِ بِما اِقتَرفَت يَداهُ","فَظَلَّ لَها بِنا يَومٌ غَشومُ",40,"م",1,0],["ثاوِياتٌ ما بَينَ دارٍ لَقيطٍ","ما يُزايِلنَها فَكُتّابُ بَحرِ",41,"ر",1,0],["ثاوِياتٍ عَلى البَليخِ مَحلّاً","في قِبابٍ أَو يَنثَنينَ قُصورا",42,"ر",2,0],["ثابت الوضع لَيسَ يَبدو حراكٌ","فيه حَتّى حسبته تمثالا",43,"ل",2,0],["ثارَت عَلى شرق الفرات وَغربه","حربٌ كَما شاءَ الدفاع عوان",44,"ن",1,0],["ثاروا عَلى العلم باسم الدين واِحتقروا","من ليس في زمرة الثوار منخرطا",45,"ط",2,0],["ثاقب العقل ثابت الحلم لا يق","در أمرٌ له على إقلاق",46,"ق",1,0],["ثاروا على القيد حتى انحلَّ واقتحموا","على الطواغيتِ حِصنَ الظلم فانهارا",47,"ر",2,0],["ثار الى حيث النبيُّ موعدا","ومبرقاً بسيفه ومرعدا",48,"د",2,0],["ثِانيَاتٌ قَطائِفَ الخَزِّ والدِّي","باَجِ فَوقَ الخُدُورِ والأَنماطِ",49,"ط",1,0],["ثَابِرْ عَلَى تِلْكَ العَزَائِمِ ذَائِداً","عنْ مِصْرَ تضرِبُ فِي البِلاَدِ مُطَوِّفَا",50,"ف",2,0],["ثابَتْ إلى فَرَحٍ كَذَ","لِكَ تَوبَةُ المُتَسَرِّعِ",51,"ع",1,0],["ثَأَرْتَ لِلشَّرْقِ مِنْ دَهْرٍ قَضَاهُ وَلاَ","ذِكْرَى لَهُ غَيْرُ مَا يُحْكَى عَنِ السَّلَفِ",52,"ف",1,0],["ثَابِرُوا فِي وَثْبِكُمْ وَلْتَهْنِنَا","فِي تَلاَشِينَا الهَنَاتُ الهَيِّنَاتُ",53,"ت",1,0],["ثاراتُ طارقٍ الأولى تُؤَرِّقُهم","وما لما تتركُ الثاراتُ نسيانُ",54,"ن",1,0],["ثارت نفوس الناس فيه، ولن ترى","كالشعب حين يصاب في أقواته",55,"ت",2,0],["ثَأَرْتُ بِهِ وَمَا افْتَرَقَتْ يَدَاهُ","فَظَلَّ لَهَا بِنَا يَوْمٌ غَشُومُ",56,"م",1,0],["ثار الشبابُ ومن مثلُ الشباب اذا","ريعَ الحمى وشُواظُ الغَيْرَةِ احتدما",57,"م",2,0],["ثَاني وُجُوهِ الخَيلِ مُقْوَرّةً","في الكَرّ حتّى يَستَقِلّ الصّرِيعْ",58,"ع",1,0],["ثأرَ الملوك، وظلَّ عندَ إبائه","يرجو ويأمن عفوه المثؤور",59,"ر",1,0]]}