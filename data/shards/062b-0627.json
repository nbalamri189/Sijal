m37652.html","الخفيف"],[498,"نحن الرفاعية الأعلام ما برحت","https://www.aldiwan.net/poem38016.html","البسيط"],[504,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[513,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[549,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[556,"ثمرات على غصون الحوادث","https://www.aldiwan.net/poem33556.html","الخفيف"],[560,"ثار الدخان فلم يظهر له لهب","https://www.aldiwan.net/poem52769.html","البسيط"],[565,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"]],"verses":[["ثالِثَ الناظِرَينِ عِز","زاً وَلِلنَفسِ ثانِيا",0,"ي",2,0],["ثابِتٌ في طينَةِ المَجدِ إِذا","مَنصِبٌ أَمسى زَليقَ القَدَمَينِ",1,"ن",1,0],["ثارَ بِهِ الجَهلُ فَاِبتَسَمتُ لَهُ","وَرُبَّ جانٍ عِقابُهُ الضَحِكُ",2,"ك",1,0],["ثارَت حَرارَتُها في الصَدرِ فَاِشتَعَلَت","كَأَنَّما هِيَ نارٌ أُطعِمَت سَعَفا",3,"ف",2,0],["ثائِرٌ راقبَ منْهُ فُرصَةً","ثمّ لمّا أمْكَنَتْهُ بطَشا",4,"ش",2,0],["ثاوِياً ماثِلاً يُقَلِّبُ زُرقاً","رَمَّها القَينُ بِالعُيونِ حُشورا",5,"ر",2,0],["ثَأَرتَ اللَيالي وَأَقعَدتَها","بِمَصقولِ عَزمِكَ عَن ثارِها",6,"ر",3,0],["ثارت عجاجته واليوم محتجبٌ","والنقع يؤثر غيماً من دياجيها",7,"ي",3,0],["ثار طرّادهم يجيش بنسّا","فات سُفن لهم سَجرن الوطيسا",8,"س",2,0],["ثَأَرتَ المِسمَعَينِ وَقُلتَ بوؤوا","بِقَتلِ أَخي فَزارَةَ وَالخِيارِ",9,"ر",1,0],["ثاوٍ على حلب ولكن جوده","ينهلُّ منه على الفرات النيل",10,"ل",1,0],["ثارَ إليَّ بلومٍ لا يلائمني","فصحّ لي إنما في العقل ثوران",11,"ن",1,0],["ثاقِب الرأي نافذ الفكر فيها","غير ذي فَتْرة ولا إبْطاءِ",12,"ا",2,0],["ثابتُ الحالِ في الزلازل مُنْها","لٌ لسُؤّالهِ انهيالَ الكثيبِ",13,"ب",1,0],["ثاقبُ الفِكرِ ما تمهَّلَ في الرأْ","يِ شديدُ الإسداء والإلحام",14,"م",1,0],["ثاقب الجمرة إن حرَّكته","وترى الحلم عليه إن سكن",15,"ن",1,0],["ثأر سيبقى فتقه","دهراً بغير رائب",16,"ب",1,0],["ثابت انت والليالي توالى","خالد انت والسنون تدول",17,"ل",1,0],["ثارَ بِعَبدِ اللَهِ ثائِرُ الحَسَد","وَزَعم الغابَ أَتى غَيرَ الأَسَد",18,"د",1,0],["ثابَت سَلامَتُهُ وَأَقبَلَ صَحوُهُ","إِلا بَقايا فَترَةٍ وَسَقامِ",19,"م",1,0],["ثَأَرَ المُلوكُ وَظَلَّ عِندَ إِبائِهِ","يَرجو وَيَأمَلُ عَفوَهُ المَثؤورُ",20,"ر",1,0],["ثارَت عَلى الحامي العَتيدِ وَأَقسَمَت","بِسِواهُ جَلَّ جَلالُهُ لا تَحتَمي",21,"م",2,0],["ثَأرُ عُثمانَ لِمَروانٍ مَجاز","وَدَمَ السِبطِ أَثارَ الأَقرَبون",22,"ن",1,0],["ثابِتٌ وَذِروَتُهُ","في الفَضاءِ تَضطَرِبُ",23,"ب",1,0],["ثاقِبُ الرَأيِ ثابِتُ الحِلمِ لا يَق","دِرُ أَمرٌ لَهُ عَلى إِقلاقِ",24,"ق",1,0],["ثاني الخَليفَةِ في النَدى","وَشَبيهُهُ كَرَماً وَنِدُّه",25,"د",2,0],["ثانِيَ اللَيلِ ثالِثَ البيدِ وَالسَي","رِ نَديمَ النُجومِ تِربَ السُهادِ",26,"د",1,0],["ثاني وُجوهُ الخَيلِ مُقَوَّرَةٌ","في الكَرِّ حَتّى تَستَقِلَّ الصَريع",27,"ع",1,0],["ثابِتٌ في المَكَرِّ إِذ راحَ لِلفُر","سانِ عَن جانِبِ الصَريعِ مَجالُ",28,"ل",1,0],["ثاوٍ مَضى وَالجودُ تِلوٌ لَهُ","لا أَوَّلٌ يُرجى وَلا ثانِ",29,"ن",1,0],["ثاروا بِنا فَطَفِقتُ حينَ أَراهُم","حَذِراً أُذَكِّرُ ذِكرَكُم وَأُؤَنِّثُ",30,"ث",1,0],["ثاني عِنانِ الحادِثاتِ وَفارِسٌ","أَمسى جَوادُ الدَهرِ مِنهُ يَلهَثُ",30,"ث",1,0],["ثارَت بِنا تَطوي القِفارَ فَعِندَما","آنَستُ نارَكَ قُلتُ لِلرَكبِ اُمكُثوا",30,"ث",3,0],["ثارَ العَجاجُ فَكُنتُ أَوَّلَ صائِلٍ","وَعَلا الضِرامُ فَكُنتُ أَوَّلَ مُصطَلِ",31,"ل",1,0],["ثابِتٌ عِندَ المَعالي فَضلُهُ","هل يُطيقُ اللَّيلُ للصُّبح جُحود",32,"د",1,0],["ثابتٌ كالطود في معتركٍ","جائلِ الأبطال خفّاقِ العَذَبْ",33,"ب",1,0],["ثانيهِ في كَبِدِ السَماءِ وَلَم يَكُن","لِاِثنَينِ ثانٍ إِذ هُما في الغارِ",34,"ر",1,0],["ثانِياً مِن زِمامِ وَجناءَ حَرفٍ","عاتِكٍ لَونُها يُخالُ خِضابا",35,"ب",2,0],["ثارَ القَتامُ بِهِم دُخاناً وَاِرتَمى","زَندُ الحَفيظَةِ مِنهُمُ بِشَرارِ",36,"ر",1,0],["ثارَ الزمانُ عليَّ ثورةَ جاهلٍ","هاجَتْهُ نافضةُ الحلومِ فصالا",37,"ل",2,0],["ثارَت عَلَيهِ شُعوبُهُ وَهُمومُهُ","فَتَأَلَّبَ الطوفانُ وَالبُركانُ",38,"ن",1,0],["ثارت بصالح نخوة قذفت به","في وجه اقبح ظالم متمادِ",39,"د",1,0],["ثَأَرتُ بِهِ بِما اِقتَرفَت يَداهُ","فَظَلَّ لَها بِنا يَومٌ غَشومُ",40,"م",1,0],["ثاوِياتٌ ما بَينَ دارٍ لَقيطٍ","ما يُزايِلنَها فَكُتّابُ بَحرِ",41,"ر",1,0],["ثاوِياتٍ عَلى البَليخِ مَحلّاً","في قِبابٍ أَو يَنثَنينَ قُصورا",42,"ر",2,0],["ثابت الوضع لَيسَ يَبدو حراكٌ","فيه حَتّى حسبته تمثالا",43,"ل",2,0],["ثارَت عَلى شرق الفرات وَغربه","حربٌ كَما شاءَ الدفاع عوان",44,"ن",1,0],["ثاروا عَلى العلم باسم الدين واِحتقروا","من ليس في زمرة الثوار منخرطا",45,"ط",2,0],["ثاقب العقل ثابت الحلم لا يق","در أمرٌ له على إقلاق",46,"ق",1,0],["ثاروا على القيد حتى انحلَّ واقتحموا","على الطواغيتِ حِصنَ الظلم فانهارا",47,"ر",2,0],["ثار الى حيث النبيُّ موعدا","ومبرقاً بسيفه ومرعدا",48,"د",2,0],["ثِانيَاتٌ قَطائِفَ الخَزِّ والدِّي","باَجِ فَوقَ الخُدُورِ والأَنماطِ",49,"ط",1,0],["ثَابِرْ عَلَى تِلْكَ العَزَائِمِ ذَائِداً","عنْ مِصْرَ تضرِبُ فِي البِلاَدِ مُطَوِّفَا",50,"ف",2,0],["ثابَتْ إلى فَرَحٍ كَذَ","لِكَ تَوبَةُ المُتَسَرِّعِ",51,"ع",1,0],["ثَأَرْتَ لِلشَّرْقِ مِنْ دَهْرٍ قَضَاهُ وَلاَ","ذِكْرَى لَهُ غَيْرُ مَا يُحْكَى عَنِ السَّلَفِ",52,"ف",1,0],["ثَابِرُوا فِي وَثْبِكُمْ وَلْتَهْنِنَا","فِي تَلاَشِينَا الهَنَاتُ الهَيِّنَاتُ",53,"ت",1,0],["ثاراتُ طارقٍ الأولى تُؤَرِّقُهم","وما لما تتركُ الثاراتُ نسيانُ",54,"ن",1,0],["ثارت نفوس الناس فيه، ولن ترى","كالشعب حين يصاب في أقواته",55,"ت",2,0],["ثَأَرْتُ بِهِ وَمَا افْتَرَقَتْ يَدَاهُ","فَظَلَّ لَهَا بِنَا يَوْمٌ غَشُومُ",56,"م",1,0],["ثار الشبابُ ومن مثلُ الشباب اذا","ريعَ الحمى وشُواظُ الغَيْرَةِ احتدما",57,"م",2,0],["ثَاني وُجُوهِ الخَيلِ مُقْوَرّةً","في الكَرّ حتّى يَستَقِلّ الصّرِيعْ",58,"ع",1,0],["ثأرَ الملوك، وظلَّ عندَ إبائه","يرجو ويأمن عفوه المثؤور",59,"ر",1,0],["ثاو بمثوى الانقطاع عن الورى","في كثرة وحدي مع الجدران",60,"ن",1,0],["ثاني الخمسة اصحاب العبا","صهر طه مقتدى كل ولي",61,"ي",1,0],["ثار عجاج الدرب لما انبرت","تشق بالاجفان تلك الشقاق",62,"ق",1,0],["ثاني الوزير بن والقرم المهاب ومن","من ازره قام عن دين الهدى وزر",63,"ر",1,0],["ثاب العزاءُ وحان الأخذُ بالثار","قد عاد في غابه الضّرغامةُ الضاري",64,"ر",2,1],["ثافراً وهو قريب","وهو جم اللفتات",65,"ت",1,0],["ثَاقِبُ الذِّهنِ في العَوِيصِ مُضِىءُ","لَيلِهِ الدَّاجِى الدَّجُونِ البَهِيمَا",66,"م",2,0],["ثاروا لِقَتلِ مُحَمَّدٍ فَنَهاهُمُ","عَنهُ وَجاهَدَ أَحسنَ التّجهادِ",67,"د",1,0],["ثاروا إلى الحرب إذ حانت مصارعهم","وضاقت الأرض عمن جاش منه دم",68,"م",1,0],["ثار الغبار كليل شك مظلم","فنضا من الأغماد صبح يقين",69,"ن",1,0],["ثآليل كفر قد أبانت رؤسها","فإن هي لم تحسم تداعت بها الادوا",70,"و",2,0],["ثار شَوقي إلى الحِمى","وَهوى الخُرَّد الدُمى",71,"م",2,1],["ثَأَرتَ مُزَاحِماً وسَرَرتَ قَيساً","وكُنتَ لِمَا هَمَمتَ بِه فَعولا",72,"ل",2,0],["ثاوِياً ثمّة في الحرزِ الأمين","في جوارِ المُصطفى أكرمِ جار",73,"ر",1,0],["ثارَ فيها أوباشُهم كوحوشٍ","بانَ مِنها للقانصِ الأخفياءُ",74,"ا",2,0],["ثاوٍ ثَوى مِنهُ في قَلبي جَوى ضَرم","يَشبُّ كَالسَيفِ حَداً وَالسِنان شَبا",75,"ب",2,0],["ثاء ثوينا نجتني زَهَرَ المنى","من كل غصن في نقا قد مالا",76,"ل",2,0],["ثارت الدنيا عليه اذ وهى","وكذا الدنيا على الواهي تثور",77,"ر",1,0],["ثائِرَةً كَالهَولِ في ساحِهِ","وَبِالرُؤى من بيضِ اِشباحِه",78,"ه",1,0],["ثائِرَةٌ كَالمَوجِ إِن تَلعِب","الأَرواحُ في طَيّاتِهِ يُزيدِ",79,"د",1,0],["ثابتُ الجَأشِ عندما يَقلَقُ الجَي","شُ ويَخشَى رَيبَ الحمامِ أُسُودُه",80,"د",2,0],["ثاقبُ الفَهمِ إن يَغب عنه أَمرٌ","كامنٌ فهوَ بالذكاءِ شَهيدُه",80,"د",2,0],["ثابتُ الجأشِ باسمُ الثَّغرِ","والأبطالُ في لُجَّةِ الدماءِ تَخُوضُ",81,"ض",1,0],["ثائرٌ في كلِّ يومٍ","لا تَرى إلا رضاكَ",82,"ك",1,0],["ثابِتُ الجَأشِ إِذا جاشَت لَدى ال","غَيضِ في المَحفَلِ أَكبادُ الرِجالِ",83,"ل",1,0],["ثابِتٌ في الخَيرِ وَالشَرِّ مَعاً","لِذَوي الطَيشِ لَدى الحالَينِ قالي",83,"ي",1,0],["ثاروا وقد نذروا للحقّ أنفسَهُم","وفي سبيل العلا والمجد ما نذروا",84,"ر",3,0],["ثَأري إِليهِ وفودُ الشكرِ مضحيةً","وَالفخر مُصطبحاً والأجر مُعتبقا",85,"ق",2,0],["ثارَت بِهِ ضُمَّرٌ قُبٌّ مُقَلَّدَةٌ","كَالقِدحِ 