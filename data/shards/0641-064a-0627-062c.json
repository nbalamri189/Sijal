om/ViewPoem.aspx?id=206966",""],[5776,"(أُتْسُوعةُ الهلاك )","https://www.poetsgate.com/ViewPoem.aspx?id=205841",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5996,"وما ذاك إلا عارض من طماعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181339",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6189,"قراءة في جسد اللؤلؤة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83584&r=&rc=51",""],[6299,"ألا أمُّ عَمْروٍ أجْمَعَتْ فکسْتَقَلَّتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19677&r=&rc=2",""]],"verses":[["فيا جاحداً أجر النبي وربما","تُنكّر أضدادٌ من الجنس توأما",0,"م",2,0],["فَيا جَبَلَ الرَيّانِ إِن تَعَر مِنهُمُ","فَإِنّي سَأَكسوكَ الدُموعَ الجَوارِيا",1,"ي",2,0],["فَيا جُنَّتي إِن رَماني الزَمانُ","وَيا صاحِبي إِن جَفاني صِحابي",2,"ب",2,0],["فيا جَبَلَ الرَّيانِ أينَ مَوارِدٌ","تَرَكْتُ لها ماءَ الأُنَيْعِمِ صادِيا",3,"ي",2,0],["فَيا جَبَلَي نَعمانَ إِن آنَ بُعدُهُم","فَإِنّي سَأَكسوكَ دُموعَ الجَوارِيا",4,"ي",2,0],["فَيا جَنبُ قَد أَسلَفتَ في الحَزنِ دينَةً","عَسَت تُقتَضى مِن أُمِّ جَنبٍ دُيونُها",5,"ن",3,0],["فيا جفنه الماضي وأحمر خدّه","رفيقك قيسي وأنت يماني",6,"ن",2,0],["فَيا جَزَعي تَعَزَّ فَلَيسَ صَبرٌ","وَيا ظَمَأي تَسَلَّ فَلَيسَ رِيُّ",7,"ي",1,0],["فَيا جارَتي وَأَنتِ غَيرُ مُليمَةٍ","إِذ ذُكِرتُ وَلا بِذاتِ تَقَلَّتِ",8,"ت",1,0],["فيا جدثا في طيِّه نام شوكت","سقاك مُلِثٌّ ذو بعاع من السحب",9,"ب",1,0],["فَيا جَزى اللَه بَني فاطِمَةٍ","عَن مَصرَ خَيرَ ما أَثابَ وَجَزى",10,"ا",1,0],["فَيا جَبينَ السَعدِ لي","وَيا عُيونَ الفَلَكِ",11,"ك",1,0],["فيا جِيرةً شطَّتْ بهم غُربةُ النَّوَى","ولاعهدُهم يُنْسَى ولا الوُدُّ يُنْسَخُ",12,"خ",1,0],["فيا جَبَلاً هَدّ الزمانُ هضابَهُ","أما كنتَ بالتمكين في العزّ راسيا",13,"ي",2,0],["فيا جاعلاً من عَفْوِهِ وانتقامِهِ","جنى النحل طَعْمَيْه وَسَمّ الأراقمِ",14,"م",1,0],["فَيا جَولَةً لا تَجحَديهِ وَقارَهُ","وَيا سَيفُ لا تَكفُر وَيا ظُلمَةُ اِشهَدي",15,"د",2,0],["فيا جامعَ المالِ بخلاً بهِ","رويدَكَ وانظرْ لمنْ تجمعُ",16,"ع",1,0],["فيا جابراً دُمْ معاذاً وها","أنا عُمَرٌ وَهْيَ لي ساريَهْ",17,"ي",2,0],["في أَجرُعٍ خَلفَ الرَبيعُ بِهِ اِبنَهُ","كَرَماً فَأَخصَبَ رَبوَةً وَقَرارا",18,"ر",2,0],["فيا جفونُ استقرّي","عاد الرّقادُ شهيّا",19,"ي",2,0],["فَيا جودَ كَفَّيهِ اِمحُ آثارَ بَأسِهِ","فَإِنَّ عَلَيهِ أَرشَ حَبسي وَلَم أَجنِ",20,"ن",1,0],["فيا جبلاً من رحمةِ اللّه باذِخاً","إليه يفِرُّ العُرْفُ في زمَن النُّكر",21,"ر",1,0],["فيا جعفر العَلياء يا جعفرَ النّدى","ويا جعفرَ الهيجاء يا جعفرَ النصر",21,"ر",1,0],["فَيا جازِيَ الفِتيانِ بِالنِعمِ اِجزِهِ","بِنُعماهُ نُعمَى وَاِعفُ إِن كانَ أَظلَما",22,"م",2,0],["فَيَا جِسْمَ مَحْمُودَ بِتْ في سُكُونٍ","وَيَا عَيْنَ سَامٍ اهْنَيءِ بِالْكرَى",23,"ر",2,0],["فيا جبالُ اقذفي الأحجارَ من حُمَمٍ","ويا سَمَاءُ امْطِري مُهْلاً وغِسْلينَا",24,"ن",2,0],["فيا جَبرَ اللهُ ذاك الكسير","ويا خَسِرَ الصفقةَ الرابح",25,"ح",1,0],["فيا جدثا حواه لست قبرا","ولكن أنت في الدنيا وسام",26,"م",1,0],["في اجتِنَابِ الأتَايِ لِلمرءِ ذَامُ","إِذ بِهِ تُكرَمُ الضيوفُ الكِرَامُ",27,"م",1,1],["فيا جبل الطُّورِ لا فارقتكَ","سحائبُ يُشفَى بهنَّ الأُوامُ",28,"م",1,0],["فيا جامعا شمل الهدى برجاله","على الطاعة أبشر بالسعادة والنصر",29,"ر",1,0],["فيا جعفرا يا ابن الكرام وإنما","ينوء بأثقال الرجال عظيمها",30,"م",3,0],["فَيا جَزَعي مَهلاً عَساهُ يَعودُ لي","وَيا كَبِدي صَبراً عَلى ما كَواكَ بِهِ",31,"ه",1,0],["فيا جيرة العاصي شريعة حبكم","وحقكم ديني وخير شريعتي",32,"ي",1,0],["فَيا جيرة الشعب اليَماني بحقكم","صلوا أَو مرو اطيف الخيال يَزور",33,"ر",1,0],["فَيا جَدِّي نَهَضْتَ وَيا زمَانِي","جَنَيْتَ فَكُنْتَ أَحْسنَ مُسْتَقِيلِ",34,"ل",1,0],["فَيا جيرةً كانوا وكنّا بقربهم","نُذِلُّ تَصاريفَ الزَمان ونُرغمُ",35,"م",1,0],["فَيا جنّةً عيني بِها لَو تخيّرت","لَما اِستبدلتها العَين في جَنّة الخلدِ",36,"د",1,0],["فَيا جارُ أَحبابي وَإِن هِجتِ لي الأَسى","سَقاكِ فَروّاكِ السَحاب مُبَكِرا",37,"ر",2,0],["فيا جبل التحقيق والزهد والتقى","ويا من به قد كان يفتخر الدهر",38,"ر",1,0],["فيا جزاك الله خير ما جَزى","مادَح أصحاب العبا مرتجزا",39,"ز",2,0],["فيا جَبَلاً ساروا به لضريحه","يُطاول بالمجد الجبال الرَّواسيا",40,"ي",2,0],["فيا جبلاً أطَلَّ من المعالي","عَلَيْنا لا تزول ولا تزال",41,"ل",1,0],["فيا جفنُ لا تنفك في الحفظ دائما","وإن كنتَ في لجٍ من البحر عائما",42,"م",2,0],["فيا جامِعَ الإِسلامِ شَمْلاً وتارِكاً","دِيارَ الأَعادِي مُوحِشاتِ المعاهِدِ",43,"د",1,0],["فيا جامع الأموال ان كنت حاكما","وان كنت زرّاعا وان كنت تاجرا",44,"ر",2,0],["فَيا جَنَّةَ الدُنيا وَيا مُنتَهى المُنى","وَيا نورَ عَيني هَل إِلَيكِ سَبيلُ",45,"ل",1,0],["فَيا جاهِلاً هُدْيَ النّبِيِّ وأَهْلِهِ","وأصْحابِهِ والتّابعينَ الأكارِمِ",46,"م",1,0],["فيا جَذَلِي إِن كنتَ في الخلدِ حاضراً","ويا أَسفي إِذ كنْتُ عَنهُ مغَيَّبَا",47,"ب",2,0],["فيا جَوَى القلبِ تَضَاعَفْ فقد","تَرَحَّلَ الحيُّ وأَقْوى اللِّوى",48,"و",2,0],["فيا جاهلاً شوقي لو أنك عالم","لا وشكت أن تحنو علي وترحما",49,"م",2,0],["فَيا جُند السَعيد بَلغت مَجداً","فَزد فيما دعيت إِلَيهِ نصحا",50,"ح",2,0],["فيا جامع المال كن راشدا","لدى الروع لا ذخر إلا التقى",51,"ق",2,0],["فيا جبل العاصي ويا معقل الأذى","أأنت على الترك الأباة منيع",52,"ع",1,0],["فيا جدثاً في طيه فاح طيبه","فليس الثريا من ثراه بأرفعا",53,"ع",2,0],["فيا جيرة قد يمموا أجرع الحمى","سلوا الأفق الشرقي مما تجهَّما",54,"م",2,0],["فيا جوانح ذوبي","فالهجر أودى بصبري",55,"ي",1,0],["فيا جبل الحلوم بلا خلاف","ويا بحر العلوم الزاخزات",56,"ت",1,0],["فيا جدوَ إِن قادتك عين زهيدةٌ","لأُذنى وشرُّ الوصلِ فى من يلاطف",57,"ف",1,0],["فيا جازيَ الفتيان بالنِّعَم اجزِه","بنعماه نُعمى واعفُ إِن كان مجرِما",58,"م",2,0],["فِي أَجَمٍ مِن الرِّماحِ غابُها","وَقُلْتُ جِدّاً يَرْتَمِي إِعْتَابُها",59,"ب",3,0],["فيا جيرة الشعب اليماني بحقكم","أغيثوا شديد الحزن فهو أسير",60,"ر",1,0],["فيا جسدا أضناه شوق كأنه","إذا نضيت عنه الثياب قضيب",61,"ب",1,0],["فيا جاهلا سل عارفا بقلبيلتي","تراني اصلا للوفا وعماده",62,"د",2,0],["فَيا جاهِلاً كالفرخ في قعر بيضة","ململمة تحت الدجاج أَسير",63,"ر",1,1],["فيا جنةً الفردوس حيّي مبارَكا","إليكِ به يسعى مع الفوز موكِب",64,"ب",1,0],["فَياجائِزاً نَحوَ الأَحِبَّةِ زَائِراً","تَحَمَّلَ مِنى يَومَ تَاتِى مَعاذِراً",65,"ر",2,0],["فيا جرجس اهنأ بصهر له","عواطف شهم ونفس كريم",66,"م",1,0],["فَيا جَمالَ بَني الدُنيا وَبَهجَتَهُم","وَاِبنَ الأُولى هُم جَمالُ الكُتبِ وَالسِيَرِ",67,"ر",1,0],["فيا جنتي بل جنتي يوم فاقتي","ويا وزري ان خفت في الحشر أوزارا",68,"ر",2,0],["فيا جبلاً من قدرة اللَه باذخاً","وبحر ندىً نادي الوجود به ندي",69,"د",2,0],["فيا جنح ليل الحظ زد من صباحه","فقد خفقت بالنصر ألوية الفجر",70,"ر",1,0],["فيا جيرة الجرعاء قد طال هجركم","فمنوا بوصل أو فمنوا بإسعاد",71,"د",1,0],["في اجر محيي سنة ماتت فذا","ك مع الرسول رفيقه بجنان",72,"ن",1,0],["فيا جملُ يسلى خليلٌ خليله","إذا لم يجدْ يا جملُ في وُده عُتْبَى",73,"ب",2,0],["فيا جنتي للنائبات عددتها","ويا عدتي أسطو بها وعديدي",74,"د",2,0],["فيا جيرة الشعب اليماني بحقكم","حنا نيكمو إن الفؤاد كسير",75,"ر",1,0],["في أجمع صلحت بأدمُع سفحت","وأضلع لفحت رمضى من الزّنج",76,"ج",1,0],["فيا جزاك الله أوفى ما جزى","مجاهداً رضا الأله مقصده",77,"د",2,0],["فيا جوهراً زان الوجود بهاؤه","وسبحان بارى جوهر اللطف والبر",78,"ر",1,0],["فَيا جمرُ ذَوِّب ذلك الثلج وافنِهِ","وَيا ثَلجُ لا تُخمِد لَهُ لَهَبَ الحَرِّ",79,"ر",1,0],["فيا جارتي بعدما بيننا","وما كان بيتكِ مني أمم",80,"م",1,0],["فيا جارتي ماذا المطالُ أعن قلى","أم اعترضت حلو الأمور أمورُ",81,"ر",1,0],["فيا جفن عَيْني كَيفَ تطمع فِي الْهوى","بنوم ونوم العاشقين محرم",82,"م",1,0],["فيا جوهراً يعلو على كل جوهرٍ","بلا عَرَضٍ في ذاتِهِ هُوَ قائِمُ",83,"م",1,0],["فيا جاهلاً قَدرَ الذي انتَ باذلٌ","لقد جِئتَ بالقَدرِ الثمينِ مُرخَّصا",84,"ص",2,0],["في اجِتلاها خمرةٌ ما واصلت","مدنفاً إِلا رَأَيتَ الهَمّ بان",85,"ن",1,0],["فَيا جَنةَ الفَردوس إِن هِيَ أَقبلت","وَيا زفرةَ النيران إِن أَعرضت جَفا",86,"ف",2,0],["فيا جَنَّة فِيها العَذابُ وَلم أخَف","حُلُولَ عذابٍ في الجنانِ النَّواضِر",87,"ر",1,0],["فيا جائراً عن غيه ليس يرعوي","ويا ظالماً من غيره يتظلم",88,"م",1,0],["فيا جائراً بالأمر والنهي في الهوى","رويداً فقد أسرفت بالنهي والأمر",89,"ر",1,0],["فيا جنةً فيها النعيم مخلد","وإن كنت قد صاليت فيها جهنما",90,"م",2,0],["فيا جملة العشاق أين ولوعُكم","فشهرتكم في حبه ما بها بأس",91,"س",1,0],["فَيا جَهلُ واصِلنا وَيا عِلمُ فَاِبتَعِد","وَيا حُمقُ لازِمنا وَيا عَقلُ جانِبِ",92,"ب",1,0],["فيا جاعدٌ صبراً ويا ناصر عَزًى","فللحرِّ عزمٌ ما يقاومُهُ الصَّلْدُ",93,"د",1,0],["فيا جاهلا إن سامك الضيم والوجل","سل الفضل أهل الفضل قدما ولا تسل",94,"ل",1,0],["فيا جِراحي وأحزاني ويا وجعي","صبراً جميلاً فقد خانوا وقد خذلوا",95,"ل",3,0],["فَيا جَمالُ، رَعاكَ اللهُ يا رَجُلُ","يا دَوْحَةً، في بَهاها الشِّعرُ يُرْتَجَلُ",96,"ل",1,0],["فيا جيش مصر العرب لا مصر وحدها","رأت بك للداء العضال دواء",97,"ا",2,0],["فيا جواداً جدن من كفه","سحائب الجود ثقالا رزان",98,"ن",1,0],["في اجتراء عليه رابع عشر","شهر صوم في جمعة غراء",99,"ا",2,0],["فيا جيرتي ناءَ الحبيبُ ولا أرى","بأطلالِهِ الجرداء غيرَ نواحِ",100,"ح",1,0],["فيا جيرةَ الصوبينِ ما بالُ دجلةٍ","تنائيهِ منْ تحتِ الجسورِ سيولُ",101,"ل",1,0],["فَيَا جِيرَةً فِي الشَّام سَقْيًا لأَرْضِكُمْ","وَرَعْيَاً لِمَنْ غنّى لِمَشْرِقِهَا عُمْرَا",102,"ر",2,0],["فيا جيش لا نلت الأذى دونك الذي","هبطنا ألى الأعماقأذ كبان يهذر",103,"ر",1,0],["فيا جائلاً وسطَ الترابِ بدمعِهِ","أما في ظلامِ الدمعِ ضوءٌ يصدُّهُ",104,"د",2,0],["فيا جامعَ المسفاة غابَ مؤذنٌ","أجابَ نداءَ اللهِ خيرَ ودودِ",105,"د",1,0],["فيا جُمعةً جُمعةً","فأسْبِتْ على مَنْ كُبِتْ",106,"ت",1,0],["فيا جبل الرحمن ربيت بالتجل","لى في عالم التسطير بالواحديتي",107,"ت",2,0],["فيا جيرتي إذ للزمان نضارة","وعودي نضار والخيام جميع",108,"ع",1,0],["فيا جليلا \" علا في عرشِ عزّّتهِ","ويا قريبا دنى للسر يقتربُ",109,"ب",1,0],["فيا جنة الدنيا تنثُّ مصائبٌ","وعند جُموح العُسر ينبلج اليسر",110,"ر",1,0],["فَيَا جَارَتِي وأنْتِ غَيْرُ مُلِيمَة ٍ","إذا ذُكِرَتْ ولا بِذَاتِ تَقَلَّتِ",111,"ت",1,0]]}