{"poems":[[108,"تأبط شرا","https://www.shoaraa.com/p12775",""],[53,"أقول لركب رائحين لعلكم","https://www.aldiwan.net/poem29626.html","الطويل"],[53,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[34,"وخبرتماني أن تيماء منزل","https://www.aldiwan.net/poem4943.html","الطويل"],[27,"لولا ابن حكام وأشراف قومه","https://www.aldiwan.net/poem4433.html","الطويل"],[72,"لنجم هلال الدولة الحسن عسكر","https://www.aldiwan.net/poem20190.html","الطويل"],[70,"يعز علي فقدك يا علي","https://www.aldiwan.net/poem42403.html","الوافر"],[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"أمينتي في عامها","https://www.aldiwan.net/poem8068.html","مجزوء الرجز"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[80,"أباد حياتي الموت إن كنت ساليا","https://www.aldiwan.net/poem31246.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[69,"سلام على نفسك الزاكيه","https://www.aldiwan.net/poem29245.html","المتقارب"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[102,"هواك أصبح نسيا","https://www.aldiwan.net/poem32994.html","المجتث"],[52,"تبدى فأين الغصن من ذلك الغصن","https://www.aldiwan.net/poem26624.html","الطويل"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[8,"وأي فتى ودعت يوم طويلع","https://www.aldiwan.net/poem21830.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[90,"تذكر العهود","https://www.poetsgate.com/ViewPoem.aspx?id=178985",""],[91,"أبو غازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67923&r=&rc=203",""],[133,"في اجتناب الأتاي للمرء ذام","https://www.aldiwan.net/poem54743.html","الخفيف"],[143,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[161,"خذوا حظكم منها إلى مطلع الفجر","https://www.aldiwan.net/poem58969.html","الطويل"],[187,"ألا ذرفت عيني ودام سجومها","https://www.aldiwan.net/poem43334.html","الطويل"],[194,"لقد راعني بدر الدجى بصدوده","https://www.aldiwan.net/poem12997.html","الطويل"],[211,"أيا حسنا قد حاز كل فضيلة","https://www.aldiwan.net/poem13394.html","الطويل"],[272,"فؤادي بربع الظاعنين أسير","https://www.aldiwan.net/poem52084.html","الطويل"],[281,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[298,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[354,"علام يلوم العاذلون على وجدي","https://www.aldiwan.net/poem40389.html","الطويل"],[381,"لمن طلل بعد القطين تغيرا","https://www.aldiwan.net/poem49255.html","الطويل"],[404,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[417,"سلمه الرب من الأسواء","https://www.aldiwan.net/poem53860.html","الرجز"],[417,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[417,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[417,"لك الخير شأن الجفن يحرس عينه","https://www.aldiwan.net/poem54247.html","الطويل"],[440,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[467,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem50386.html","الطويل"],[530,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[576,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[576,"يأيها الغصن الذي قد ذوى","https://www.aldiwan.net/poem2769.html","السريع"]],"verses":[["فيا جاحداً أجر النبي وربما","تُنكّر أضدادٌ من الجنس توأما",0,"م",2,0],["فَيا جَبَلَ الرَيّانِ إِن تَعَر مِنهُمُ","فَإِنّي سَأَكسوكَ الدُموعَ الجَوارِيا",1,"ي",2,0],["فَيا جُنَّتي إِن رَماني الزَمانُ","وَيا صاحِبي إِن جَفاني صِحابي",2,"ب",2,0],["فيا جَبَلَ الرَّيانِ أينَ مَوارِدٌ","تَرَكْتُ لها ماءَ الأُنَيْعِمِ صادِيا",3,"ي",2,0],["فَيا جَبَلَي نَعمانَ إِن آنَ بُعدُهُم","فَإِنّي سَأَكسوكَ دُموعَ الجَوارِيا",4,"ي",2,0],["فَيا جَنبُ قَد أَسلَفتَ في الحَزنِ دينَةً","عَسَت تُقتَضى مِن أُمِّ جَنبٍ دُيونُها",5,"ن",3,0],["فيا جفنه الماضي وأحمر خدّه","رفيقك قيسي وأنت يماني",6,"ن",2,0],["فَيا جَزَعي تَعَزَّ فَلَيسَ صَبرٌ","وَيا ظَمَأي تَسَلَّ فَلَيسَ رِيُّ",7,"ي",1,0],["فَيا جارَتي وَأَنتِ غَيرُ مُليمَةٍ","إِذ ذُكِرتُ وَلا بِذاتِ تَقَلَّتِ",8,"ت",1,0],["فيا جدثا في طيِّه نام شوكت","سقاك مُلِثٌّ ذو بعاع من السحب",9,"ب",1,0],["فَيا جَزى اللَه بَني فاطِمَةٍ","عَن مَصرَ خَيرَ ما أَثابَ وَجَزى",10,"ا",1,0],["فَيا جَبينَ السَعدِ لي","وَيا عُيونَ الفَلَكِ",11,"ك",1,0],["فيا جِيرةً شطَّتْ بهم غُربةُ النَّوَى","ولاعهدُهم يُنْسَى ولا الوُدُّ يُنْسَخُ",12,"خ",1,0],["فيا جَبَلاً هَدّ الزمانُ هضابَهُ","أما كنتَ بالتمكين في العزّ راسيا",13,"ي",2,0],["فيا جاعلاً من عَفْوِهِ وانتقامِهِ","جنى النحل طَعْمَيْه وَسَمّ الأراقمِ",14,"م",1,0],["فَيا جَولَةً لا تَجحَديهِ وَقارَهُ","وَيا سَيفُ لا تَكفُر وَيا ظُلمَةُ اِشهَدي",15,"د",2,0],["فيا جامعَ المالِ بخلاً بهِ","رويدَكَ وانظرْ لمنْ تجمعُ",16,"ع",1,0],["فيا جابراً دُمْ معاذاً وها","أنا عُمَرٌ وَهْيَ لي ساريَهْ",17,"ي",2,0],["في أَجرُعٍ خَلفَ الرَبيعُ بِهِ اِبنَهُ","كَرَماً فَأَخصَبَ رَبوَةً وَقَرارا",18,"ر",2,0],["فيا جفونُ استقرّي","عاد الرّقادُ شهيّا",19,"ي",2,0],["فَيا جودَ كَفَّيهِ اِمحُ آثارَ بَأسِهِ","فَإِنَّ عَلَيهِ أَرشَ حَبسي وَلَم أَجنِ",20,"ن",1,0],["فيا جبلاً من رحمةِ اللّه باذِخاً","إليه يفِرُّ العُرْفُ في زمَن النُّكر",21,"ر",1,0],["فيا جعفر العَلياء يا جعفرَ النّدى","ويا جعفرَ الهيجاء يا جعفرَ النصر",21,"ر",1,0],["فَيا جازِيَ الفِتيانِ بِالنِعمِ اِجزِهِ","بِنُعماهُ نُعمَى وَاِعفُ إِن كانَ أَظلَما",22,"م",2,0],["فَيَا جِسْمَ مَحْمُودَ بِتْ في سُكُونٍ","وَيَا عَيْنَ سَامٍ اهْنَيءِ بِالْكرَى",23,"ر",2,0],["فيا جبالُ اقذفي الأحجارَ من حُمَمٍ","ويا سَمَاءُ امْطِري مُهْلاً وغِسْلينَا",24,"ن",2,0],["فيا جَبرَ اللهُ ذاك الكسير","ويا خَسِرَ الصفقةَ الرابح",25,"ح",1,0],["فيا جدثا حواه لست قبرا","ولكن أنت في الدنيا وسام",26,"م",1,0],["في اجتِنَابِ الأتَايِ لِلمرءِ ذَامُ","إِذ بِهِ تُكرَمُ الضيوفُ الكِرَامُ",27,"م",1,1],["فيا جبل الطُّورِ لا فارقتكَ","سحائبُ يُشفَى بهنَّ الأُوامُ",28,"م",1,0],["فيا جامعا شمل الهدى برجاله","على الطاعة أبشر بالسعادة والنصر",29,"ر",1,0],["فيا جعفرا يا ابن الكرام وإنما","ينوء بأثقال الرجال عظيمها",30,"م",3,0],["فَيا جَزَعي مَهلاً عَساهُ يَعودُ لي","وَيا كَبِدي صَبراً عَلى ما كَواكَ بِهِ",31,"ه",1,0],["فيا جيرة العاصي شريعة حبكم","وحقكم ديني وخير شريعتي",32,"ي",1,0],["فَيا جيرة الشعب اليَماني بحقكم","صلوا أَو مرو اطيف الخيال يَزور",33,"ر",1,0],["فَيا جَدِّي نَهَضْتَ وَيا زمَانِي","جَنَيْتَ فَكُنْتَ أَحْسنَ مُسْتَقِيلِ",34,"ل",1,0],["فَيا جيرةً كانوا وكنّا بقربهم","نُذِلُّ تَصاريفَ الزَمان ونُرغمُ",35,"م",1,0],["فَيا جنّةً عيني بِها لَو تخيّرت","لَما اِستبدلتها العَين في جَنّة الخلدِ",36,"د",1,0],["فَيا جارُ أَحبابي وَإِن هِجتِ لي الأَسى","سَقاكِ فَروّاكِ السَحاب مُبَكِرا",37,"ر",2,0],["فيا جبل التحقيق والزهد والتقى","ويا من به قد كان يفتخر الدهر",38,"ر",1,0],["فيا جزاك الله خير ما جَزى","مادَح أصحاب العبا مرتجزا",39,"ز",2,0],["فيا جَبَلاً ساروا به لضريحه","يُطاول بالمجد الجبال الرَّواسيا",40,"ي",2,0],["فيا جبلاً أطَلَّ من المعالي","عَلَيْنا لا تزول ولا تزال",41,"ل",1,0],["فيا جفنُ لا تنفك في الحفظ دائما","وإن كنتَ في لجٍ من البحر عائما",42,"م",2,0],["فيا جامِعَ الإِسلامِ شَمْلاً وتارِكاً","دِيارَ الأَعادِي مُوحِشاتِ المعاهِدِ",43,"د",1,0],["فيا جامع الأموال ان كنت حاكما","وان كنت زرّاعا وان كنت تاجرا",44,"ر",2,0],["فَيا جَنَّةَ الدُنيا وَيا مُنتَهى المُنى","وَيا نورَ عَيني هَل إِلَيكِ سَبيلُ",45,"ل",1,0],["فَيا جاهِلاً هُدْيَ النّبِيِّ وأَهْلِهِ","وأصْحابِهِ والتّابعينَ الأكارِمِ",46,"م",1,0],["فيا جَذَلِي إِن كنتَ في الخلدِ حاضراً","ويا أَسفي إِذ كنْتُ عَنهُ مغَيَّبَا",47,"ب",2,0],["فيا جَوَى القلبِ تَضَاعَفْ فقد","تَرَحَّلَ الحيُّ وأَقْوى اللِّوى",48,"و",2,0]]}