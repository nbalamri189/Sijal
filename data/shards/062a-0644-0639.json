iwan/poem/49590","الرجز"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116941","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114029","المنسرح"],[3657,"","https://poetry.dctabudhabi.ae/diwan/poem/202208","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76696","السريع"],[4748,"أتردد للمكان","https://www.poetsgate.com/ViewPoem.aspx?id=4191",""],[4750,"خارطة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=180399",""],[4764,"مواني غير","https://www.poetsgate.com/ViewPoem.aspx?id=27763",""],[4908,"عهود وأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=211503",""],[585,"أنا في الطائف أستوحي الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=161867",""],[5111,"مَرَاكِبُ الرَّجَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212131",""],[5121,"مَلاَذ","https://www.poetsgate.com/ViewPoem.aspx?id=94051",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5225,"الضحكه الكذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25598",""],[5317,"قالب عسل","https://www.poetsgate.com/ViewPoem.aspx?id=177085",""],[5461,"إنتحار موجه","https://www.poetsgate.com/ViewPoem.aspx?id=5982",""],[5525,"زل الطرب","https://www.poetsgate.com/ViewPoem.aspx?id=911",""],[5572,"الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=53485",""],[5574,"هارون","https://www.poetsgate.com/ViewPoem.aspx?id=205997",""],[5720,"جمالُ الروح ..","https://www.poetsgate.com/ViewPoem.aspx?id=198836",""],[5739,"عيون حظ ٍ مفلسه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127068",""],[402,"سوى الحب لا تشفي الفؤاد المكلما","https://www.poetsgate.com/ViewPoem.aspx?id=36334",""],[5790,"حذار سيوف الهند من أعين الترك","https://www.poetsgate.com/ViewPoem.aspx?id=112099",""],[5848,"محمد بن زايد","https://www.poetsgate.com/ViewPoem.aspx?id=48970",""],[5848,"تلعثم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=53100",""],[5937,"حتى يليقَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=211823",""],[5970,"يوقد النقمة في قلب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=130620",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""]],"verses":[["تَلعَبُ بي الغائِباتُ واغِلَةً","كَما تَهُزُّ الزَعازِعُ الغُضُنا",0,"ن",2,0],["تَلعَبُ بِالنائِباتِ أَنفُسُنا","كَأَنَّها في أَكُفِّنا زَلَمُ",1,"م",1,0],["تَلعاءَ عالِيَةِ الأَردافِ تَحسَبُها","رِشاءَ عاديَّةٍ مُستَحصَدِ الطُوَلِ",2,"ل",1,0],["تَلَعَّبَ باعِثٌ بِذِمَّةِ خالِدٍ","وَأَودى عِصامٌ في الخُطوبِ الأَوائِلِ",3,"ل",1,0],["تَلَعَّبُ بالعِزهاةِ لَم يَدرِ ما الصِّبا","وَيَيأَس مِن أُمِّ الوَليدِ المُجَرِّبُ",4,"ب",1,0],["تَلعَبُ لَعبَ الصَغيرِ جَهلاً وَقَد","عَمَّمَكَ الدَهرُ عِمَّةَ الكِبَرِ",5,"ر",1,0],["تَلَعَّبَ الحُبُّ بِقَلبي كَما","تَلَعَّبَ السِنَّورُ بِالفارَه",6,"ر",2,0],["تَلعَبُ لِعبَ السَرابِ في قَدَحِ ال","قَومِ إِذا ما حَبابُها اِتَّصَلا",7,"ل",2,0],["تِلعابَةٌ تَعكِفُ النِساءُ بِهِ","يَأخُذنَ مِن جِدِّهِ وَمِن لَعِبِه",8,"ب",2,0],["تلع الجيد فوق قدٍّ رَشيقٍ","زانه الشعر مرسلاً يتذبذب",9,"ب",1,0],["تلعب بالألواح أمواجها","كأَنما مركبها راقص",10,"ص",1,0],["تَلعَبُ لَعْبَ الصّغيرِ، بَلْهَ، وقَد","عمّمَك الدَّهرُ عمة َ الكِبَرِ",11,"ر",1,0],["تَلَعَّبَ بِالخِلافَةِ هاشِمِيٌّ","بِلا وَحيٍ أَتاهُ وَلا كِتابِ",12,"ب",1,1],["تلعبُ في كأسها إِذا مُزِجتْ","كأَنَّما يستفزُّها طَرَبُ",13,"ب",1,0],["تلعب بالموت يداه إذا","مالعب الرعب بقلب الحنان",14,"ن",1,0],["تلعبُ المدامُ بهِ","كلما احتسى يثبُ",15,"ب",1,0],["تلعب بالقلب كيف شاءت","وإن يكن طبعه الاباء",16,"ا",2,0],["تلعب بالأبصار أنوارُها","لِعْب الأمانِي بِمفاليسها",17,"س",3,0],["تلعَّبَ ريَّانُ الشباب بقَدِّه","تلعُّبَ أيدي الريحِ بالغُصُن الرطبِ",18,"ب",1,0],["تلعبُ السُرْجُ على أرجائها","فتحاكى أنملَ المُرتَعب",19,"ب",1,0],["تلْعبُ الجِنَّانُ في أجْوازِهِ","فبساريه من الطَّيْفِ خَبَلْ",20,"ل",1,0],["تَلَعثَمَ فيهِ كُلَّ رَبٍّ فَصاحَةً","فَعَيّوا سِوى قاضي الجَماعَةِ مُنذِرِ",21,"ر",1,0],["تَلْعَبُ بِالْمَرْءِ اللَّيَالِي كَمَا","قَدْ تَلْعَبُ الأَقْلاَمُ بِالنَّقْسِ",22,"س",1,0],["تلعَّبَ بِى حبّيكِ حتى تشابهت","عظامى وأعوادُ الشكاعى الضعائف",23,"ف",1,0],["تلعب بالمنقلة والضامة","ولم تخف من ربك الملامة",24,"ه",1,0],["تلعب المنقلة والضامة","ولم تخف شدائد القيامة",24,"ه",1,0],["تَلْعبُ بالرُّؤوسِ بين الأَرْجُلِ","إذا ارتمتْ بالمُعلَمِين البُسُلِ",25,"ل",1,0],["تلعبت بالتوحيد حتى كأنما","تحدّثُ عن غول ببيداءِ سملقِ",26,"ق",1,1],["تلعب فيها الوحوشُ موحشةض الأ","رجاءِ لا مؤنِسٌ ولا بَشَرُ",27,"ر",1,0],["تلعبت الأيام بي فتركنني","أجب السنام حائرا حين أنظر",28,"ر",1,0],["تلعب فيه كل مياسة","ميس غصون تحت روح الرواح",29,"ح",1,0],["تلعب بقلبي وقلبي انت فيه","مثل لعب العاصفه بالخيزران",30,"ن",1,0],["تلعب بنا خلاّن فرغتنا كما لعب الكور","وأن اقبلت صاحوا لها ان دبّرت صاحوا لها",31,"ل",3,0],["تِلعثَمت وكَبا فِكري/يحاول يضبط التصوير","لقى كِلي على بعضي/بِنثرَ الودِ مَشغوله",32,"ل",2,0],["تلعثمتْ في شفاهِ الحرفِ قافيتي","أهواكِ صمتاً وللأنفاسِ إطْرَاقُ",33,"ق",1,0],["تلعب الريح وقد مرت بها","مثلما يلعب بالقلب السرور",34,"ر",1,0],["تَلَعْثَمَتِ القَصَائِدُ فِيْ لِسَانِيْ","فَأنْتِ الْفكْرُ مَنْهَجُه السَّنَاءُ",35,"ا",2,0],["تَلْعَبُ الأَنَّاتُ اخْتِرَاقاً بِقَدِّي","كَالدُّمَى أُمْسِي وَالدُّجَى أَخَّاذُ",36,"ذ",1,0],["تلعب هجوسه من لحنها مواويل","بين التغلي والجفا والموده",37,"د",2,0],["تلعب باحساسي ياليت اتذكر","اني بشر واحساس مايلعبوا به",38,"ب",2,0],["تلعبين الدور متقن بامتثال","مسرحية وكنت انا فيها البطل",39,"ل",1,0],["تلعب الموجه وللغبه هدير...","والقمر من فضته رش البحر...",40,"ر",1,0],["تلعب وانا .. ما عاد لي بالطرب شف","لعبك بروحي بدل الفرح بجراح",41,"ح",1,1],["تلعب تضن السالفة لعبة اطفال","وتغازل الهجران بعيونك السود",42,"د",1,0],["١- تلعْثمَ القوْلُ يا \"هارونُ\" بيْن فمي","والزّنبقاتُ تقاسي جمْرةَ الكَلِمِ",43,"م",1,1],["تلعثمتْ أَحرُفي في ثغرِها وأبتْ","تلكَ القصائدُ تفسيراً لتقصيري !",44,"ر",2,0],["تلعب الدنيا على ناب ٍ وناب.","في لياليها ....... دقايق مضرسه.",45,"س",2,0],["تلعقها غرا لعوبا من الصبا","فما شب إلا راح ولهان مغرما",46,"م",2,0],["تلعب فيهم بالكلام تلعبا","كما تلعب الأمواج في البحر بالفلك",47,"ك",1,0],["تلعب وما شفت ف طريقك تشيله","وتحوس حزني كنّك تقول له : ( باح )",48,"ح",1,0],["تلعثم الشوق من ليل امس والنور لاح","يكتب خطوط الفراق ويرجع يعيدها",49,"د",3,1],["تلعثم الشوق يومك رحت والنور لاح","يكتب خطوط الفراق وعيني تعيدها",49,"د",3,0],["تلعثمتْ مثل غيمٍ فامتلأتُ ندىً","آاآهٍ ، ولا شيء أشهى من تَلعثُمِها",50,"م",3,0],["تلعب الأيام بي في دارها","وتسميني لها الضيف الكريم",51,"م",1,0],["تلعب بقلبي شماله واليمين","مشكله ماتقبل انصاف الحلول",52,"ل",1,0],["تَلعَبُ الأهواءُ في صَدرِ الفَتى","رَيثَما تَطوي المَنايا أَمَلَه",53,"ل",2,0]]}