{"poems":[[95,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[47,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[48,"عنصر واحد وما القار في هي","https://www.aldiwan.net/poem22774.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[139,"كما عاذل في عادل القد لام","https://www.aldiwan.net/poem49130.html","السريع"],[193,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[264,"في دياجي الحروف من كلماتك","https://www.aldiwan.net/poem35950.html","الخفيف"],[318,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[422,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[447,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59781","الكامل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25317","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56352","الكامل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36213","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27232","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27823","الكامل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216599",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93647","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133265","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36675","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36484","الدوبيت"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6142,"الفضل ما بين النبي وصنوه","https://www.poetsgate.com/ViewPoem.aspx?id=155733",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["عَنْ صَادِقِ الرَّمْزِ بِإِبْعَادِهِ","وَكَاذَبَ الإَيْمَانِ فِي وَعْدِهِ",0,"د",2,0],["عَن صاحِبِ السَبَبِ القَوِيِّ وَناشِدِ ال","حَقِّ المُؤَكَّدِ وَالذِمامِ الواجِب",1,"ب",1,0],["عُنصُرٌ واحِدٌ وَما القارَ في هي","تَ لَعَمري كَالمِسكِ في خِرخازِ",2,"ز",1,1],["عُنْصُرٌ طَاهِرٌ وَنُبْلٌ وَصِدْقٌ","وَذَكَاءٌ مِنْ حَظِّ كُلِّ قِسِيمِ",3,"م",1,0],["عُنْصُرٌ قَدْ أَصَابَ مِنْ","هُ ابْنُ حَمْدانَ مَا أَحَبْ",4,"ب",1,0],["عنْ صَخْرَةٍ مَلْسَاءَ راسِخةٍ","لاَ مَدَّ يُوهِنُها وَلاَ جَزْرا",5,"ر",2,0],["عنصره أفئدةُ الناسِ إذ","ما ثَم قلبٌ لم يكن فيه هامْ",6,"م",1,0],["عَن صدقهِ فيما اِدّعى فتسبّحُ","قَد صمَّ جاحدهُ فأنّى يفلحُ",7,"ح",1,0],["عن صفاتٍ بكعبة الذات طافت","إذ أفاضت أسماء حسنى صفاتك",8,"ك",1,0],["عنصر الأنفس منا واحد","وكذا الجسم جميعاً عمنا",9,"ن",2,0],["عنصر طيب وأصل كريم","وجميل قد خصّ منهم وعمَّا",10,"م",2,0],["عَنْ صِدْقِ غَيْبٍ بالكِتَابِ يَبُثُّهُ","أَوْ بَرْحِ شَوْقٍ بالرَّسُولِ يَقُولُهُ",11,"ل",2,0],["عن صالح الأعمال قد قعدت بنا","همم وهن لضده سبقت بنا",12,"ن",2,0],["عن صباح ان جنّ ليلُ ضلال","عن سراج ما إن له من خمود",13,"د",1,0],["عن صادق العزمات أنصاريَّها","منصور أعلام الجهاد مؤيد",14,"د",1,0],["عَنْ صادِقِ الْقَوْلِ الاِمامِ جَعْفَرِ","فَلِلْكِتابِ فَتِّشَنْ وَاعْتَبِرِ",15,"ر",1,0],["عَنْ صِبْيَةٍ كَأَفْرُخِ الدَجَاجِ","يا فَضْلُ يا ابْن الأَنْجُم الأَبْراجِ",16,"ج",1,0],["عَنْ صَلَدٍ مِنْ كِيحِنَا لا تَكْلِمُهْ","أَصَمَّ تَرْمِي بِالأَعادِي قُحَمُهْ",17,"م",2,0],["عن صيبه حدّث وقل ما شيت لا","تذكر بني ثعلٍ برشق الأسهمِ",18,"م",1,0],["عُنصرُ الأَرواحِ فينا واحدٌ","وَكَذا الأَجسامُ جِسم عَمَّنا",19,"ن",2,0],["عن صحوة الأجسادِ بعد رقودها","وقيامِها للحشر والميزانِ",20,"ن",1,0],["عن صحو العبد سكران بدا","عالم الأمرِ له فافتنا",21,"ن",2,0],["عن صومنا فيكون ذاك الصوم لي","نقصاً وفي حقِّ الإله كمالا",22,"ل",2,0],["عَنْ صاحبي مَا لِيْ مرَدّاتْ","عِنْدِهْ دوايَه يَا معازيب",23,"ب",1,0],["عَن صَوت داعي الخناصم مَسامعهم","وَإِن دعابهم داعي الهُدى سَمَعوا",24,"ع",3,0],["عنصر طيّب وأصل كريم","ونجارٌ لدى الفخار مقدم",25,"م",1,0],["عن صحبة النجيل","ودائه الدخيل",26,"ل",1,0],["عنصر طاهر وقلب نقى","فاض نورا وحكمة وهاما",27,"م",2,0],["عَن صفرَةِ عاشقيك في الهُجرانِ","ينبيك سَفَرجَلٌ جَناه الجاني",28,"ي",1,1],["عَن صَدريَ ما كادَ يَزولُ الغُصَصُ","إِذ ضاعَ حِبالَتي وَضاعَ القَنَصُ",29,"ص",1,1],["عن صعاليكي وعن أجيالهم","عن رجالي السادة المستبسلين",30,"ن",1,0],["عَن صَهيل الخَيل لا يُل","هيه تعزافُ القيانِ",31,"ن",1,0],["عنصر الفضل بن محمودٍ وهل","عنصر يشبه ذاك العنصرا",32,"ر",2,0],["عن صبايا مشعشعاتٍ تغني","سومرياتٍ مثل خمر المساء",33,"ا",2,0],["عُنْصُريٌّ بعُرفه بيضُ( أمريكا )","نُضار وسائرُ النّاس طينُ",34,"ن",1,0],["عن صروح وعن طموح وعن إداره","عن قياده عن إراده عن بصيره",35,"ر",2,0],["14- عَنْ صُورَةٍ بِطَبِيعَةٍ كَانَتْ هُنَا","لِمَلِيحَةٍ ذَاتِ الرُّبَى أَفْنَانِ",36,"ن",1,0],["عَنْ صَبَاحٍ تَبَسَّمَا","بَعْدَ أنْ جَفَّ بالثَّرَى",37,"ا",1,0],["عن صح هذا صح ذا أو لا فلا","فكلاهما في الحكم مستويان",38,"ن",1,0],["عَنْ صُورَةٍ للْإِلَهِ مَاثِلَةٍ","وَصُورَةٍ للْهَبَاءِ مَاثِلَةِ",39,"ه",1,0]]}