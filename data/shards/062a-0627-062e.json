budhabi.ae/diwan/poem/111261","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132337","الطويل"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131470",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48310","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129462","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119464","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54486","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94636","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4691,"بماذا يكنّي والكنايات محرقة","https://www.poetsgate.com/ViewPoem.aspx?id=215324",""],[4702,"\" بنو أمية وآل البيت \"","https://www.poetsgate.com/ViewPoem.aspx?id=155050",""],[4767,"مخابز","https://www.poetsgate.com/ViewPoem.aspx?id=180939",""],[4816,"العيون","https://www.poetsgate.com/ViewPoem.aspx?id=8503",""],[463,"قالوا رضيتَ قلتُ ما أجدى الغضبْ","https://www.poetsgate.com/ViewPoem.aspx?id=14619",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5335,"اطعن","https://www.poetsgate.com/ViewPoem.aspx?id=35185",""],[5747,"سراميد","https://www.poetsgate.com/ViewPoem.aspx?id=61656",""],[5837,"مسمّى مزامل","https://www.poetsgate.com/ViewPoem.aspx?id=177547",""],[5848,"يصير خير","https://www.poetsgate.com/ViewPoem.aspx?id=53208",""],[5931,"دمعة الفقد !","https://www.poetsgate.com/ViewPoem.aspx?id=181122",""],[5956,"أنا في انتظارك يا حبيب أبيكا","https://www.poetsgate.com/ViewPoem.aspx?id=193292",""],[6002,"أَلاَ أَيُّهَا الْحَادِي تَرَنَّمْ وَزَمْزِمِ","https://www.poetsgate.com/ViewPoem.aspx?id=210297",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""],[6144,"مدارسنا ومدارسهم","https://www.poetsgate.com/ViewPoem.aspx?id=21675",""],[5309,"تآخوا كما قال المسيح وأحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573811",""],[6308,"انكسارات آخر الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87730&r=&rc=8",""],[4222,"ولم أنس بالزرقاء يوم وداعنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52892&r=&rc=184",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""]],"verses":[["تَأخُذُ مِنهُنَّ الفَلا وَتُبقي","سَجِيَّةً مِن كَرَمٍ وَعِتقِ",0,"ق",1,0],["تأخرت عنكم يا بنيَّ ويا أبي","وما أنا إلاّ البعض ماضٍ جميعه",1,"ه",1,1],["تأخر يا غلام وخلّ خالاً","ينادمني على خدِّ الغلامهْ",2,"م",2,0],["تأخَّر عن عصرِ الكرام وفاقهم","فكانَ وكانوا مثل بسمٍ وعنوان",3,"ن",1,0],["تأخذ الحقَّ للمُحقِّ وتنهى","عن ركوب العَداء أهلَ العداءِ",4,"ا",2,0],["تأخَّر من ثوابك ما أرَجِّي","وما بعد الذي أنظرت بَعْدُ",5,"د",1,1],["تَأَخَّرَ عَن وَقتِ الهَناءِ لِأَنَّهُ","لَهُ كُلَّ يَومٍ مِن جَنابِكَ مَوسِمُ",6,"م",1,0],["تَأَخَّرَ أَقوامٌ وَأَسرَعتَ لِلَّتي","تُغَلَّلُ نُشّابَ الكَمِيِّ المُزاحِفِ",7,"ف",1,0],["تأخذُ للقُوتِ منه سَهماً","وللنَّدَى سائرَ السِّهامِ",8,"م",1,0],["تَأخيرُهُ النَيروزَ وَالخَراجا","وَلَو أَرادَ أَخذَهُ لَراجا",9,"ج",2,0],["تَأخيرُ شِدقَيهِ وَطولَ خَدِّهِ","تَلقى الظِباءُ عَنَتاً مِن طَردِهِ",10,"د",2,0],["تَأخُذُ الأَيدي مَظالِمَها","ثُمَّ تَستَذري إِلى عُصُرِه",11,"ر",2,0],["تَأَخُّرُ أَبيَضِ الفَودَينِ ظُلمٌ","إِذا شَمِطَ القَرائِنُ وَاللِداتُ",12,"ت",1,0],["تَأَخُّرُ الشَيبِ عَنّي مِثلُ مَقدَمِهِ","عَلى سِوايَ وَوَقتُ الشَيبِ ما حَضَرا",13,"ر",2,1],["تأخّرَ عن جيْشِ الصّباحِ لضُعْفِه","فأوْثَقَهُ جيشُ الظّلامِ إسارا",14,"ر",2,0],["تأخذُنا الصَّيحةُ كُلَّ يومِ","فما تَلذُّ مُقْلةٌ بنَوْمِ",15,"م",1,0],["تأخر القوم في بغداد من كسل","وكَم تأخر قوم عندهم كسل",16,"ل",1,0],["تأَخر يا أُماه بعد ذهابه","نديمٌ وإن الصبح قد كادَ يطلع",17,"ع",1,0],["تأَخرت بعد الأربعين كأنما","أماميَ في سيري إليهِ ورائي",18,"ي",1,0],["تأخذُ القلبَ هَزةٌ من تسا","قيه وينسى بسحرهِ آلامَه",19,"م",2,0],["تأخذُ الظالمينَ صيحتهُ الكبْ","رى وتستعذبُ السماءُ رنينه",20,"ن",2,0],["تأخر السيف وشارط الندى","يا غبن من يشارط المهندا",21,"د",2,0],["تَأْخُذُ أَخْذَ الجَمِيلِ فِيْما","تَبْغِي وَتَنْهَي عَنِ الْقَبِيحِ",22,"ح",1,0],["تآخى الفراتيون فيه وصافحت","يَدَ الحلَّةِ الفيحاءِ بالعهد مَوْصل",23,"ل",1,0],["تأخّرت عن وعد الهوى يا حبيبنا","وما كنت عن وعد الهوى تتأخرُ",24,"ر",1,0],["تأخرت يا أغلى الرجال ، فليلنا","طويل ، وأضواء القناديل تسهرُ",24,"ر",1,0],["تأخّرت .. فالساعات تأكل نفسها","وأيامنا فى بعضها تتعثّرُ",24,"ر",1,0],["تأخرت عنّا .. فالجياد حزينة","وسيفك من أشواقه ، كاد يكفرُ",24,"ر",1,0],["تأخرت عنا .. فالمسيح معذّبٌ","هناك ، وجرح المجدلية أحمرُ ..",24,"ر",1,0],["تأخذ الفارس الكمي صراعا","حين يأبى الكماة إلا احتيالا",25,"ل",2,0],["تَأَخَّرَ بَعثاً وَهوَ فَضلاً مُقَدَّمُ","مِنَ النَجم أَهدى بَل مِنَ الغَيثِ أَكرَمُ",26,"م",1,0],["تأخذ أسلاب عقول الورى","بمنطق يسكر كالقهوة",27,"ه",1,0],["تأخَّرتِ الرسائلُ منك عنّي","وأبَطتْ عن تعهّدِيَ الرِقاعُ",28,"ع",1,0],["تأخر جبريلُ الأمينُ وقد رأى","له رُتبةً تسمو على كل رتبةِ",29,"ه",1,0],["تَأَخَّرتُ أَستَبقي الحَياةَ فَلَم أَجِد","لِنَفسي حَياةً مِثلَ أَن أَتَقَدَّما",30,"م",2,0],["تَأَخَّرَ مَنْ تَقَدَّمَ حِينَ أَجْرَى","مِنَ العَلْيَا إِلَى الأَمَدِ القَصِيِّ",31,"ي",1,0],["تَأَخَّرَ عَنْكَ الْمَدْحُ لا عَنْ تَجَنُّبٍ","وَلكِنَّهُ الْمَعْشُوقُ فِيهِ دَلالُ",32,"ل",1,0],["تأخر عنها الأكثرون فأعرضوا","لما علموا في قطعها من مشقة",33,"ه",1,0],["تأخّر إذ هزّ الزمان قناته","سناناً وأضحى من تقدّمه كعبا",34,"ب",2,0],["تَأَخّر عَهداً وَهوَ بِالفَضل أَوّل","وَعَهد إمام المُرسلين أَخيرُ",35,"ر",1,0],["تأخذُ الأقوامُ من آدابه","وأبَى القابسُ أن يَجني الضِّراما",36,"م",2,0],["تَأَخَّرتُ في حَملِ السَلامِ عَلَيكُمُ","لَدَيها لِما قَد حُمِّلَت مِن سَمائِمِ",37,"م",1,0],["تَأَخَّرتُ مِن بَعدِ الأَحِبَّةِ مُدَّةً","وَلَو أَنَّ لي أَمراً لَكُنتُ المُقَدَّما",38,"م",2,0],["تأخذ من أحبّتي أصدقَهم","وداً وأوفاهم إذا عزّ الوفا",39,"ا",1,0],["تَأَخَّرتَ عَنّي وَالغَرامُ غَريمُ","وَما ملَّ قربَ الأَكرَمين كَريمُ",40,"م",1,1],["تأخَّرتُ عن قَومٍ ولا غَرْوَ أنَّني","سأسبِقُهُمْ والجِدُّ مِعوانُ",41,"ن",1,1],["تأْخُذُ الآراء عنه رشدها","فيُريها الرّشدَ والرَّأْي السَّديدا",42,"د",2,0],["تأخّر عن ترك التقدّم إذ رأى","حياة الفتى في الدهر أن يتقدّما",43,"م",2,0],["تآخت وإن تنسب إلى كل موطن","وباعدها هم وبان خصام",44,"م",1,0],["تأخَّر في قياد المجد عنها","وخاتَمَها فكان كمن بداها",45,"ا",3,0],["تأخذ الأبصارَ مني شارة","تدع الشيخ فتىً مستشرطا",46,"ط",2,0],["تأخذ حقَّ العزّ قسراً وسُطاً","والأسد لا تعاب بالتغطرسِ",47,"س",1,0],["تأخَّرتِ بالصمصامِ وهو مصمِّم","وخالفتِ رأيَ الرمح وهو سديدُ",48,"د",1,0],["تأخذ ما تشاء من حظَّيْهما","مقترحاً محتكما وتَنْتَصِبْ",49,"ب",1,0],["تاخذات أهلة الأفق زهواً","والثريا تيهاً نعالاً ولجما",50,"م",2,0],["تأخرت لما قدمتهم علاكم","علي وتأبى الأسد سبق الثعالب",51,"ب",1,0],["تأخر عن مفروض حقك برهة","وفيض ندى كفيك لا يتأخر",52,"ر",1,0],["تأخر عن كتبي الجواب وإنّما","تأخر برد الماء عن كبدٍ حرَّى",53,"ر",2,1],["تأخَّرتُ عن صَوغ القرِيض له قَصدا","لِكَى يمدحُوا جمَعا وأمدَحُه فردَا",54,"د",2,1],["تأخذ مِنّا واحداً واحداً","بل تأخذ الأمْثَلَ فالأمثلا",55,"ل",2,0],["تأخّرْتَ حتى كدَدْتَ الرسولَ","وحتى سئمتُ من الانتِظارِ",56,"ر",1,1],["تَأخذُ الكأسَ منكَ واضحةَ الكَفِّ","وتعطيكَها وَفيها خِضابُ",57,"ب",1,0],["تأخرّ حَيْنُه ولقد رماه","فأخطأه بأحجارٍ صِلابِ",58,"ب",1,0],["تأخرت الأبطال حتى كأنني","ظننت مع العقبان ودت قرارها",59,"ر",3,0],["تأخذ الأرض من قواه وتعطي","وهو أسخى يداً وقلباً وعقلا",60,"ل",2,0],["تَأخذه منكنَّ إِذ لا يَبقى","مَعكُنَّ شَيء مِن تُراثي حَقّا",61,"ق",2,0],["تأخر في لفظ الزمان وإنه","بمعناه في أعيانه متقدم",62,"م",1,0],["تأخر عني الخير والخود والرخا","وواصل خيمي لا رخيمي وخيمها",63,"م",3,0],["تأخير إنعامك لا فاتني","في ليلة الميلاد عني عجب",64,"ب",1,0],["تأخير رسمي يا حليف الندى","قد زاد في همي وأفكاري",65,"ر",2,0],["تأخرت الأعلام عن مستقرها","وفر محاميها موقر المخاصم",66,"م",1,0],["تَأَخر الأَخبار","يُؤذن بِالبوار",67,"ر",1,0],["تأخر من جاراه في حلبة العلى","وقدمه إقدامه وقديمه",68,"م",2,0],["تأخذ بالحزم على قانص","يريغها من قبل الدبر",69,"ر",1,0],["تَأخُذُ ما تُعطي فَما بِالُنا","نُكثِرُ فِيما لا يَدُومُ الخِصام",70,"م",1,0],["تَأَخَّرَ عَنهُم ظَاهِراً وَهوَ باطِناً","لَدى اللهِ مَحبُوبٌ مُقَدَّمُ مَظهَرُ",71,"ر",1,0],["تأخرت عنها خدمة لم أجد لها","سوى حاسد خذلان في زِيِّ عاتب",72,"ب",1,0],["تاخذ المأخوذ أخذ المغتصب","لاتهيد له ولا تعطيه هود",73,"د",1,0],["تأخذهم منه على غفلة","في حال تفريط ولا يشعرون",74,"ن",1,0],["تأخر ذي الإقدام والحزم ربما","ينال به خيراً ويستسهل الصعبا",75,"ب",2,1],["تأخذ منه الجن فوق ما أخذ","فهو طعام الجن حين ينتبذ",76,"ذ",1,0],["تأخى مع الافضال جعفر مخلصا","وآخاه قوم فات منهم خلوصه",77,"ص",2,0],["تأخَّر في لَفظِ الزَّمانِ وإنَّهُ","بِمَعناهُ في أعيانِهِ مُتَظاهِرُ",78,"ر",1,0],["تأخذ الصيد بالصفاح","وبألحاظها تصيد",79,"د",1,0],["تأخذ الروح قاح بقاح","لا طلع لي ولا أزيد",79,"د",1,0],["تَأَخرتَ عَن تَطلابِ ذاكَ تَقدُّما","سَعدتَ بِهِ إِذ كانَ غَيرُكَ قَد شَقِي",80,"ق",2,0],["تأخذ في كواكب العواء","وهو يسمى حارث السماء",81,"ا",2,0],["تأخذُ العُلا","عَن أَبٍ وأمّ",82,"م",1,0],["تأخُذُ الرّيحُ عنْ حُلاهُ وتأبى","أن تُباري هُبوبُها جَريانَهْ",83,"ن",2,0],["تأخر عنها حادث الدهر برهة","فعاشت كما شاءت زمانا تقدما",84,"م",2,0],["تَأَخَّرَ الفَتوى عَنِ المُراجَعَة","إِلّا لِحِفظِ سَوَّغ المُسارَعَه",85,"ه",1,0],["تأخر عن مداك البحر لما","جريت فلم نسميه أخاكا",86,"ك",2,0],["تأَخّرَ قلبي عندهمْ مُتخلِّفاً","وخالفْتُهمْ في عَزْمتي والتّقدُّمِ",87,"م",1,0],["تأخير سعيي إليهِ كان عن كظمٍ","كم مانعٍ قد أتى قصدي يقاهرهُ",88,"ر",2,0],["تأخذ الشمس اهبة من ضياها","ثم تهدى إلى النهار اهابا",89,"ب",2,0],["تأخر في السلوان أسرع في الهوى","وكلّ عصا للحبّ تلقفُ منطقهْ",90,"ق",2,0],["تاخذ من التاريخ ما هبّ ودبّ واستكن","بعْقولها من دون تمحيص الخبر وترتّبه",91,"ب",2,0],["تأخيرُ توصيلِ ما أنتجتموه لنا","بدا لدى الكل منا ليس محتملا",92,"ل",2,0],["تاخذك معشوق في دنيا الترف","وترجعك باذغاث حلم ما طرق",93,"ق",1,0],["تأخذ ما تشاء من حظيمها","مقترحاً محتكما وتنتصبْ",94,"ب",1,0],["تأخرت مما قددها عن رثايه","وإن كنت أرثيه بوجدي الملازم",95,"م",1,0],["تآخى اثنان والإسلام يزهو","بفاروق الهداية والتعامي",96,"م",2,0],["تآخى ذانك الفتيان حقا","وعاشا بالأخوة في سلام",96,"م",1,0],["تاخذك الايام وتوديك وتردك","يخونك الوقت وتعود علي الوافي",97,"ف",2,0],["تاخذني [ الوحده ] عن الناس لبعيد","وأغيب وأنسى في مكاني مكاني",98,"ن",2,0],["تاخذ قصيدي من مسمّى مزامل","ويصير في كل المنابر لك حضور",99,"ر",1,0],["تاخذك مني برغبتك .. لكن وش يصير","لو تركتي بحور وقتك بليا يختها",100,"ت",3,0],["تاخذني الجفوه على محمل الجد","وتجف من جرح التجافي اغادير",101,"ر",1,0],["تأخير أنباء الحِمام مفضّل","ويؤخر الإيلام والتشويكا",102,"ك",2,0],["تَأَخَّرْتُ رَغْمًا وَالْكَرِيمُ مُدَبِّرٌ","عَسَى يَجْعَلِ التَّأْخِيرَ عَيْنَ التَّقَدُّمِ",103,"م",1,0],["تأَخّرْ قليلاً عن أبيكَ تَأدُّباً","فمثِلُكَ من رَاعَى أَبَاهُ تأدُّباً",104,"ب",2,0],["تاخذ ولادنا وبفلوسنا وبالتيلة","اشطر ما فيهم ما يكسبش عشا ليلة",105,"ل",2,0],["تَآخَوا كَما قالَ المسيحُ وَأَحمَدُ","فَما الحُبُّ إِلا ثَروَةٌ لا تُحَدَّدُ",106,"د",1,1],["تأخَّرَ الوقتُ ما غنَّيْتَ ضحَكَتَها","مرُّوا جميعَاً... جميعَاً أخَّرُوا الوَقْتَا",107,"ت",2,0],["تأخر قلبي عندهم مختلفا","وخالفتهم في عزمتي والتقدم",108,"م",1,0],["تأخرتِ.. والمشتاقُ لا يتأخرُ","وبي لهفةٌ يا عذبةَ الصوتِ تكبرُ",109,"ر",1,1]]}