{"poems":[[57,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[107,"أتين بهن من شوق غليل","https://www.aldiwan.net/poem44052.html","الوافر"],[50,"أحقا منك أنك لن تراني","https://www.aldiwan.net/poem64482.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[79,"أشارت غداة البين من خلل السجف","https://www.poetsgate.com/ViewPoem.aspx?id=34201",""],[93,"كلوا واشربوا","https://www.poetsgate.com/ViewPoem.aspx?id=53344",""],[146,"أبى الله إلا أن تجود وتنعما","https://www.aldiwan.net/poem58433.html","الطويل"],[226,"هو البعد آلامه تقتل","https://www.aldiwan.net/poem55297.html","المتقارب"],[412,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[463,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[466,"اذا موسم زان الزمان وروده","https://www.aldiwan.net/poem15355.html","الطويل"],[469,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[475,"ما لجديد الموت يا بشر لذة","https://www.aldiwan.net/poem4767.html","الطويل"],[484,"على الناهضين نهوض الكرام","https://www.aldiwan.net/poem37616.html","المتقارب"],[558,"سبقت بمعروف وصلى ثنائيا","https://www.aldiwan.net/poem68372.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[1429,"","https://poetry.dctabudhabi.ae/diwan/poem/200356","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101004","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53102","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93713","الكامل"],[2502,"","https://poetry.dctabudhabi.ae/diwan/poem/35000","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65992","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100364","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67595","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91762","الطويل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[4859,"أسمال!","https://www.poetsgate.com/ViewPoem.aspx?id=215565",""],[5081,"الله","https://www.poetsgate.com/ViewPoem.aspx?id=185837",""],[5431,"فإنّ الناس كلّهمُ طغاةُ!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200427",""],[5804,"لا أقنع بالدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=184441",""],[6035,"عَمائمُ الحقد حرفُ الإفك طَرَّزَها .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177145",""],[6093,"نسيمٌ خادع (الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=188632",""],[6259,"علا بك نجمُ الدين فاشتدَّ ناصره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59378&r=&rc=26",""]],"verses":[["فَلا ضَحِكَ الواشونَ يا فَوزُ بَعدَكُم","وَلا جَمَدَت عَينٌ جَرَت بِسُكوبِ",0,"ب",1,0],["فلا ضجعةٌ والصبحُ شَمْطاءُ حاسِرٌ","ولا هَجْعةٌ والليلُ عذراءُ ناهدُ",1,"د",1,0],["فَلا ضَعْفٌ يَعوقُ ولا لُغُوبٌ","ولا وَلَدٌ يَشوقُ ولا حَلِيلُ",2,"ل",1,0],["فَلا ضَحِكَت وَقَد غُيِّبتَ عَنّي","وَلا رَقَأَت مَدامِعُ مَن سَلاكا",3,"ك",2,0],["فَلا ضَيْرَ إِنَّ الله يُعْقِبُ عَوْدَةً","يَهُونُ لَهَا بَعْدَ الْمُواصَلَةِ الصَّدُّ",4,"د",1,0],["فَلا ضَبَابٌ وَلا غَمَامٌ","وَلا ظَلاَمٌ وَلا ضِياءُ",5,"ا",2,0],["فلا ضَيْرَ إِنِ اللهَ أَعْطَى وَنَالَني","مواقِفَ تُرجَى غَيْرَ مَنٍّ ولا فخرِ",6,"ر",1,0],["فلا ضاع معنى يستضاء بنوره","جناني ولا خطت بناني في حرف",7,"ف",1,0],["فلا ضحايا الطّوى","ولا يبصرون الذي تصنعون",8,"ن",1,0],["فلا ضحِك الإصباحُ إلا نَحلْتَهُ","ببهجِتك الغرّاءِ ثغرا ومبِسما",9,"م",2,0],["فلا ضيع الله أجر المحب","وخيب آمال من يعذل",10,"ل",1,0],["فَلا ضَوءُ شَمسُ الدين تَقشع غيمها","وَلا الغَيمُ مِنها مانِع الضَوءِ ساتِرُهُ",11,"ر",2,0],["فلا ضامها يُتمٌ وأنت لها أبٌ","ولا عرفَتْ يا بعلَها كيف تُرمِلُ",12,"ل",1,0],["فلا ضربِ اِلا الهبرُ في قِمَم العدى","ولا جودَ الا ساجمٌ اِثرَ ساجمِ",13,"م",1,0],["فلا ضرجت في الدوح للورد وجنةٌ","ولا اهتزَّ من هيف الغصون قوامُ",14,"م",1,0],["فَلا ضَيرَ إِنَّ اللَهَ يا بِشرُ ساقَني","إِلى بَلَدٍ جاوَرتُ فيهِ خَلائِفُه",15,"ف",2,0],["فلا ضاع حق له طالب","ولا جانب الحر حقا يضام",16,"م",1,0],["فَلا ضَيرَ لَم تَلحَقكَ مِنّي مَلامَةٌ","أَسَأتَ بِنا عوداً وَأَحسَنتَ بادِيا",17,"ي",2,0],["فلا ضَعفُ الصِّغار أخلَّ منهم","بِمنفَعةٍ ولا هَرَمُ الكِبارِ",18,"ر",1,0],["فلا ضير آن عرضتها ووقفتها","لوقع القنا كيما يضرجها الدم",19,"م",1,0],["فلا ضوءَ إلا ما ذكا من شواظها","يشُق الدجى في زفرة ودلوع",20,"ع",1,0],["فلأضرمنَّ بأدمعي في أضلعي","ما شئت من جمر الأسى المتوقد",21,"د",1,0],["فَلأضربَنَّ بِهِ الزَمان كَأَنَّني","لاقَيت ساعده بِحَدِّ يَماني",22,"ن",2,0],["فَلا ضَيرَ إِن كانَت قُرَيشٌ عِداً لَنا","يُصيبونَ مِنّا مَرَّةً وَنَصيبُ",23,"ب",1,0],["فلا ضاقت الدنيا ولا ضاق مسلك","علي ولا أمري وعزمي بهين",24,"ن",1,0],["فلا ضير أن قصَّرت عن شأو سابق","فتى مثله في السبق فات فتىً مثلي",25,"ل",2,0],["فَلأَضرِبَنَّ به ضِرامَ معاشرٍ","تَغلي عداوتُهم كغلي المِرجَلِ",26,"ل",1,0],["فلا ضيرَ أن السيفَ ينْبُو وإنما","ترى الليثَ عن أكلِ الفَريسة يُحجم",27,"م",1,0],["فَلا ضير في ضَيم الزَمان وَإِن جَنى","وَلا عَتبَ إِن طالَت أَو اقتصرت محن",28,"ن",1,0],["فلا ضرورة إشارة إلى","ممكنة تعم عند العقلا",29,"ل",2,0],["فلا ضمير يردّ الصوتَ ياوطني","والشعب منهزم بالصمت مخنوق",30,"ق",1,0],["فلا ضرٌّ ولا نفْعٌ","يعودُ عليه حاشاهُ",31,"ا",2,0],["فلا ضوءٌ يظلُّ إلى اشتعالٍ","ولاطيرٌ يُصادقه الرماةُ",32,"ا",2,0],["فلا ضغائنَ أو حزنٌ يُلمُّ بنا","وقد أرحنا من الترَّحالِ والسَّفَرِ",33,"ر",1,0],["فلا ضمير بني الإنسان أَدْرَكَكُمْ","ولا تَقَرَّبَ منْ أرْواحكمْ رَشَدُ",34,"د",1,0],["فَلا ضَيْرَ إنْ هَزَّ الهَوَى قَلْبَ عاقِلٍ","فقدْ هَزَّتِ الأنْسَامُ جَامِدةَ الخَشَبْ",35,"ب",1,0],["فلا ضوءَ شمس الدين يقشعُ غيمها","ولا الغيمُ منها مانعُ الضوء ساتره",36,"ر",2,0]]}