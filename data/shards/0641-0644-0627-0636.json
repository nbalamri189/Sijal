{"poems":[[55,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[62,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[105,"أتين بهن من شوق غليل","https://www.aldiwan.net/poem44052.html","الوافر"],[48,"أحقا منك أنك لن تراني","https://www.aldiwan.net/poem64482.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[77,"أشارت غداة البين من خلل السجف","https://www.poetsgate.com/ViewPoem.aspx?id=34201",""],[91,"كلوا واشربوا","https://www.poetsgate.com/ViewPoem.aspx?id=53344",""],[142,"أبى الله إلا أن تجود وتنعما","https://www.aldiwan.net/poem58433.html","الطويل"],[221,"هو البعد آلامه تقتل","https://www.aldiwan.net/poem55297.html","المتقارب"],[406,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[458,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[461,"اذا موسم زان الزمان وروده","https://www.aldiwan.net/poem15355.html","الطويل"],[464,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[470,"ما لجديد الموت يا بشر لذة","https://www.aldiwan.net/poem4767.html","الطويل"],[479,"على الناهضين نهوض الكرام","https://www.aldiwan.net/poem37616.html","المتقارب"],[553,"سبقت بمعروف وصلى ثنائيا","https://www.aldiwan.net/poem68372.html","الطويل"]],"verses":[["فَلا ضَحِكَ الواشونَ يا فَوزُ بَعدَكُم","وَلا جَمَدَت عَينٌ جَرَت بِسُكوبِ",0,"ب",1,0],["فلا ضجعةٌ والصبحُ شَمْطاءُ حاسِرٌ","ولا هَجْعةٌ والليلُ عذراءُ ناهدُ",1,"د",1,0],["فَلا ضَعْفٌ يَعوقُ ولا لُغُوبٌ","ولا وَلَدٌ يَشوقُ ولا حَلِيلُ",2,"ل",1,0],["فَلا ضَحِكَت وَقَد غُيِّبتَ عَنّي","وَلا رَقَأَت مَدامِعُ مَن سَلاكا",3,"ك",2,0],["فَلا ضَيْرَ إِنَّ الله يُعْقِبُ عَوْدَةً","يَهُونُ لَهَا بَعْدَ الْمُواصَلَةِ الصَّدُّ",4,"د",1,0],["فَلا ضَبَابٌ وَلا غَمَامٌ","وَلا ظَلاَمٌ وَلا ضِياءُ",5,"ا",2,0],["فلا ضَيْرَ إِنِ اللهَ أَعْطَى وَنَالَني","مواقِفَ تُرجَى غَيْرَ مَنٍّ ولا فخرِ",6,"ر",1,0],["فلا ضاع معنى يستضاء بنوره","جناني ولا خطت بناني في حرف",7,"ف",1,0],["فلا ضحايا الطّوى","ولا يبصرون الذي تصنعون",8,"ن",1,0],["فلا ضحِك الإصباحُ إلا نَحلْتَهُ","ببهجِتك الغرّاءِ ثغرا ومبِسما",9,"م",2,0],["فلا ضيع الله أجر المحب","وخيب آمال من يعذل",10,"ل",1,0],["فَلا ضَوءُ شَمسُ الدين تَقشع غيمها","وَلا الغَيمُ مِنها مانِع الضَوءِ ساتِرُهُ",11,"ر",2,0],["فلا ضامها يُتمٌ وأنت لها أبٌ","ولا عرفَتْ يا بعلَها كيف تُرمِلُ",12,"ل",1,0],["فلا ضربِ اِلا الهبرُ في قِمَم العدى","ولا جودَ الا ساجمٌ اِثرَ ساجمِ",13,"م",1,0],["فلا ضرجت في الدوح للورد وجنةٌ","ولا اهتزَّ من هيف الغصون قوامُ",14,"م",1,0],["فَلا ضَيرَ إِنَّ اللَهَ يا بِشرُ ساقَني","إِلى بَلَدٍ جاوَرتُ فيهِ خَلائِفُه",15,"ف",2,0],["فلا ضاع حق له طالب","ولا جانب الحر حقا يضام",16,"م",1,0],["فَلا ضَيرَ لَم تَلحَقكَ مِنّي مَلامَةٌ","أَسَأتَ بِنا عوداً وَأَحسَنتَ بادِيا",17,"ي",2,0]]}