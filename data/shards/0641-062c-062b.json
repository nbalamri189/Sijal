{"poems":[[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56695","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100988","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108463","الكامل"],[2943,"","https://poetry.dctabudhabi.ae/diwan/poem/111342","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127810","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107501","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97074","الطويل"],[4830,"سُهادُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=210983",""],[5007,"سهم الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=142374",""],[5691,"سجال(3)","https://www.poetsgate.com/ViewPoem.aspx?id=206442",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5943,"دمعٌ بعيني لايكفكفه الملل","https://www.poetsgate.com/ViewPoem.aspx?id=11286",""]],"verses":[["فَجَثّهُ القَدَرُ الجاري لِيَفجَعَها","بِطيب مِن فَوَيقِ النَجمِ مَجثوثِ",0,"ث",1,0],["فجثا الدهر لديهم خاضعاً","وأتى نحو حماهم يترامى",1,"م",2,0],["فجثا يصرفها على نهج امرئٍ","خبر الليالي كيدها ومحالها",2,"ل",3,0],["فجثا يصرف خيزرانة ملكه","تصريف لا وكلٍ ولا خوار",3,"ر",1,0],["فجثت لدى ذاك السرير وقبلت","وجهاً صبيحاً لا بشاشة بعده",4,"د",2,0],["فجثا لها من آل ها","شم كل أصيد أعلما",5,"م",2,0],["فجثوتُ والركبانُ حولي جُثَّماً","وعليهِمُ مطر السَّخا نَضّاحا",6,"ح",2,0],["فجثت على قدميهِ تنثر شعرها","وتنوح ناديةَ وتقرع صدرها",7,"ه",2,0],["فجثا قرب طفلها آخذاً عن","ها يهزُّ السريرُ كالغلمانِ",8,"ن",1,0],["فجثمانه تحت الخيول ورأسه","على الرمح في أنواره يخجل البدرا",9,"ر",2,0],["فجَثَوتُ بباكَ مُرتجياً","أَبوجهِ الوامقِ تُصِدُهُ",10,"د",2,0],["فجَثَوْتُ أعْتَصِرُ الثَّرَى بِمَرَارَةٍ","وإذا بذكْرَى الصَّابرَات وِقاءُ",11,"ا",2,0],["فجثا القريض جلالة لما رأى","هذا الجمال وللجمال جلالُ",12,"ل",1,0],["فجثت على باب الكبير كسيرة","تحنو عليها أدمع خرساءُ",13,"ا",2,0],["فجثوتُ فوق القهرِ ألعقُ دمعَهُ","نارًاتغشاني بها حزنُ الأملْ",14,"ل",1,0]]}