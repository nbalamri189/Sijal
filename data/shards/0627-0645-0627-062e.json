{"poems":[[95,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[29,"لولا ابن حكام وأشراف قومه","https://www.aldiwan.net/poem4433.html","الطويل"],[53,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[51,"يا من يسر بنفسه وشبابه","https://www.aldiwan.net/poem10325.html","الكامل"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62301","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[146,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[202,"ألا عظة إن الزمان خؤون","https://www.aldiwan.net/poem51871.html","الطويل"],[301,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[370,"بلغت أول عمري أرذل العمر","https://www.aldiwan.net/poem17712.html","البسيط"],[406,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[420,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[467,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[517,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[567,"أأنت على عهد المحبة ماكث","https://www.aldiwan.net/poem830.html",""],[578,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20468","البسيط"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20963","البسيط"]],"verses":[["أَمَّا خَلائِقُهُ فَقُلْ مَا شِئْتَ فِي","جَمِّ المُرُوءةِ رَاسِخِ الإِيمَانِ",0,"ن",1,0],["أَما خِفتَني يا جَنبُ إِذ بِتَّ لاعِباً","وَباتَت لِقاحي ما تَجِفُّ عُيونُها",1,"ن",3,0],["أم اختيرت الدنيا على تلك زوجةً","لشيءٍ سوى تعجِيلها حاجةَ البعلِ",2,"ل",1,0],["أَمّا خَيالُكِ يا بَخيلَ","ةُ فَهوَ مِثلُكِ في النُفورِ",3,"ر",1,0],["أَمّا خُطاكَ إِلى العَمى فَسَريعَةٌ","وَإِلى الهُدى فَأَراكَ مُنقَبِضَ الخُطا",4,"ا",1,0],["أَم أَخبَرَت أَنَّ اِبنَ أَيّوبٍ قَضى","فَتَكادُ مِن حُزنٍ عَليهِ تَمورُ",5,"ر",1,0],["أمَ اخْبَطَ خَبْطَ الفِيلِ هَامَةَ رَأْسِهِ","بِحَردٍ فَلا يُبْقِي مِنَ العَظَمِ بَاقِيا",6,"ي",2,0],["أَمَّا خَليلٌ فَتَأْبَى","لَهُ مَزَايَاهُ نَدّا",7,"د",2,0],["أَم أَخْرَسَتْهُ سِنَةٌ ذاقَهَا","بيْنَ نَدَامَى هُمًّدٍ خُرسِ",8,"س",1,0],["أمّا خزائنُ مالِهِ فمباحةٌ","فاستوهِبوا من علمه المحزونِ",9,"ن",1,0],["أما خجلتْ من كرِّهِ وجِلادِه","فوارسُ كَفَّتْ عنه وهي صُفُون",10,"ن",1,0],["أَم آخِذٌ في العتب أَنتَ وتاركي","حَرضاً وأَنتَ الآخذُ التَرّاكُ",11,"ك",1,0],["أَمّا خَديعَةٌ أَحلامٍ أُغَرَّ بِها","في يَقظَتي فَلَمّا جاءَت عَلى فِكري",12,"ر",2,0],["أَمَا خِفتَ أني بسيفِ الهُدى","مليكِ البريّة أسْتَنْصِرَ",13,"ر",1,0],["أمَّا خمائله وأيّ خمائل","فالسندسُ المخضرُّ والإستبرق",14,"ق",1,0],["أما خشيتَ رجال الحيِّ قلتُ لها","شجاعةُ الجبِّ تستغني عن الحيلِ",15,"ل",1,0],["أمَا خشيتَ المنايا من مَناصلِها","فقلتُ والقلبُ لا يُطوى على وَجلِ",16,"ل",1,0],["أم اخترت خلا غيرنا بعد بيننا","لودك أم قد غيرتك الحوادث",17,"ث",1,0],["أَما خِفْت منْ قِصَّتِي أَنْ تشِيع","فَيُكتَبَ في حَالِها مَحْضر",18,"ر",1,0],["أَما خَليلي فَإِنّي لَستُ مُعجَلُهُ","حَتّى يُؤامِرَ نَفسَيهِ كَما زَعَما",19,"م",2,1],["أَمّا خَليلي أَبو بَحرٍ فَإِنَّ لَهُ","عِندي مُحَبَّرَةٌ حُمراً حَواشيها",20,"ه",2,1]]}