{"poems":[[95,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[29,"لولا ابن حكام وأشراف قومه","https://www.aldiwan.net/poem4433.html","الطويل"],[53,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[51,"يا من يسر بنفسه وشبابه","https://www.aldiwan.net/poem10325.html","الكامل"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62301","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[146,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[202,"ألا عظة إن الزمان خؤون","https://www.aldiwan.net/poem51871.html","الطويل"],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[371,"بلغت أول عمري أرذل العمر","https://www.aldiwan.net/poem17712.html","البسيط"],[408,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[422,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[469,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[519,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[569,"أأنت على عهد المحبة ماكث","https://www.aldiwan.net/poem830.html",""],[580,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96979","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136217","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132857","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20468","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33854","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60942","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137227",""],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129830","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85028","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59483","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123492","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94798","الطويل"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20963","البسيط"],[4755,"هَا قَدْ أَسَالَ دَمِي.. وخَطَّا","https://www.poetsgate.com/ViewPoem.aspx?id=187695",""],[4578,"بشاير وافتنا بسعد محمدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49407",""],[4927,"الْعِشْقُ الأَبْيَض","https://www.poetsgate.com/ViewPoem.aspx?id=29733",""],[5072,"هو عيدكم","https://www.poetsgate.com/ViewPoem.aspx?id=51804",""],[1420,"احذر بني من القران العاشر","https://www.poetsgate.com/ViewPoem.aspx?id=87636",""],[5299,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=210542",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5493,"سبيل الألم","https://www.poetsgate.com/ViewPoem.aspx?id=197683",""],[5848,"طفلة نجديه","https://www.poetsgate.com/ViewPoem.aspx?id=53355",""],[5939,"بوريو","https://www.poetsgate.com/ViewPoem.aspx?id=185514",""],[5939,"بسكوتة!","https://www.poetsgate.com/ViewPoem.aspx?id=195175",""],[5956,"زميلي في السجن ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183659",""],[6069,"بعثت الكتاب فأهلاً به","https://www.poetsgate.com/ViewPoem.aspx?id=105695",""]],"verses":[["أَمَّا خَلائِقُهُ فَقُلْ مَا شِئْتَ فِي","جَمِّ المُرُوءةِ رَاسِخِ الإِيمَانِ",0,"ن",1,0],["أَما خِفتَني يا جَنبُ إِذ بِتَّ لاعِباً","وَباتَت لِقاحي ما تَجِفُّ عُيونُها",1,"ن",3,0],["أم اختيرت الدنيا على تلك زوجةً","لشيءٍ سوى تعجِيلها حاجةَ البعلِ",2,"ل",1,0],["أَمّا خَيالُكِ يا بَخيلَ","ةُ فَهوَ مِثلُكِ في النُفورِ",3,"ر",1,0],["أَمّا خُطاكَ إِلى العَمى فَسَريعَةٌ","وَإِلى الهُدى فَأَراكَ مُنقَبِضَ الخُطا",4,"ا",1,0],["أَم أَخبَرَت أَنَّ اِبنَ أَيّوبٍ قَضى","فَتَكادُ مِن حُزنٍ عَليهِ تَمورُ",5,"ر",1,0],["أمَ اخْبَطَ خَبْطَ الفِيلِ هَامَةَ رَأْسِهِ","بِحَردٍ فَلا يُبْقِي مِنَ العَظَمِ بَاقِيا",6,"ي",2,0],["أَمَّا خَليلٌ فَتَأْبَى","لَهُ مَزَايَاهُ نَدّا",7,"د",2,0],["أَم أَخْرَسَتْهُ سِنَةٌ ذاقَهَا","بيْنَ نَدَامَى هُمًّدٍ خُرسِ",8,"س",1,0],["أمّا خزائنُ مالِهِ فمباحةٌ","فاستوهِبوا من علمه المحزونِ",9,"ن",1,0],["أما خجلتْ من كرِّهِ وجِلادِه","فوارسُ كَفَّتْ عنه وهي صُفُون",10,"ن",1,0],["أَم آخِذٌ في العتب أَنتَ وتاركي","حَرضاً وأَنتَ الآخذُ التَرّاكُ",11,"ك",1,0],["أَمّا خَديعَةٌ أَحلامٍ أُغَرَّ بِها","في يَقظَتي فَلَمّا جاءَت عَلى فِكري",12,"ر",2,0],["أَمَا خِفتَ أني بسيفِ الهُدى","مليكِ البريّة أسْتَنْصِرَ",13,"ر",1,0],["أمَّا خمائله وأيّ خمائل","فالسندسُ المخضرُّ والإستبرق",14,"ق",1,0],["أما خشيتَ رجال الحيِّ قلتُ لها","شجاعةُ الجبِّ تستغني عن الحيلِ",15,"ل",1,0],["أمَا خشيتَ المنايا من مَناصلِها","فقلتُ والقلبُ لا يُطوى على وَجلِ",16,"ل",1,0],["أم اخترت خلا غيرنا بعد بيننا","لودك أم قد غيرتك الحوادث",17,"ث",1,0],["أَما خِفْت منْ قِصَّتِي أَنْ تشِيع","فَيُكتَبَ في حَالِها مَحْضر",18,"ر",1,0],["أم أخذهم أرثي وفاضل نحلتي","أم جهلهم حقي وقد عرفوني",19,"ن",2,0],["اما خاف مولاه العظيم ومكره","وكيف ومكر الله ما فوقه مكر",20,"ر",1,0],["أَمَا خَشِيَت عيناك عيناً تُصِيبُها","وغُصنُكَ ذا إذ مَالَ أن يَتَقَصَّفَا",21,"ف",2,0],["أَما خَليلي فَإِنّي لَستُ مُعجَلُهُ","حَتّى يُؤامِرَ نَفسَيهِ كَما زَعَما",22,"م",2,1],["أما خِلاط فعين الله تكلأها","والله كافيك ما تخشى وكافيها",23,"ي",3,0],["أَمِ اِختَرَمَت كَفُّ المَنِيَّةِ كَفَّهُ","فَأَصبَحَ مِمَّن غَيَّبَتهُ المَقابِرُ",24,"ر",1,0],["أمِ اخترت إظهارَ الملالةِ والقلى","فما لي بُدٌّ مِنْ هواك ولا عذرُ",25,"ر",1,0],["اما خلائقه فعرف ازاهر","وارق من خمر حوتها صرفد",26,"د",1,0],["أما خَدّي البدر المنيرُ فلم غدَت","تحُلّ به ضدّ القضّة عقرَبُ",27,"ب",1,0],["أمَّا خميسٌ فترى مربَّعي","خَمساً بحُكمٍ آفهَمِ النَّظمَ وَعِ",28,"ع",1,0],["اما خليفة الولى اخلاص","محمد البخشي فخاص الخاص",29,"ص",1,0],["أَم أَخرَجوا أَثمارَها وَنَباتَها","وَالنَخلَ ذاتَ الطَلعِ وَالقِنوانِ",30,"ن",1,0],["أَما خافَ إِغراقَيهِ في بَحرِ مَدمَعٍ","إِذا ماجَ يَوماً أَغرَقَ البَحرَ وَالبَرّا",31,"ر",2,0],["أما خلقّ الإلهُ لكم عقولاً","وأيم الله ليس لكم عقولُ",32,"ل",1,0],["أما خص بالقرآن أقصر سورة","به مبتغيها للمضاهاة دائخ",33,"خ",1,0],["أما خاف زنجي الظلام الذي غدا","بخرصان شهب الافق للطرق حاميا",34,"ي",2,0],["أما خجلت عيناك حين تفرَّست","برؤيا ملاكٍ فاق في حسن صورةِ",35,"ه",1,0],["أَمّا خَليلي أَبو بَحرٍ فَإِنَّ لَهُ","عِندي مُحَبَّرَةٌ حُمراً حَواشيها",36,"ه",2,1],["أَم أَخطَأَتْ عَينَاكَ يا","رَعدًا يُحِيلُ اللَّيلَ شَطَّا!",37,"ط",2,0],["أما ختنه وافي بميلاد من به","تجلى بأفق العلى كل فرقد",38,"د",1,0],["أَمْ أَخْلَفَتْ عَفْرَاْءُ وَعْداً، وَانْزَوَتْ","مَهْجُوْرَةً مَكْسُوْرَةً لَمْ تَنْهَضِ",39,"ض",1,0],["أم أخدع ُ الأطفال َ بالحلوى ؟ لكي","يستثمروا خُدعي وينسوا مَوتَنا",40,"ن",2,0],["أما خراسان تعود منابتا","للعشب ليس لأهلها من جابر",41,"ر",1,0],["أمَا خِفْتَ مِنْ عَيْنِ الرَّقِيبِ وَإخْوَتِي","إذَا خَبرُوا بِالأمْر،ظَهْرُكَ يُقْصَمُ؟",42,"م",1,0],["أَمَا خُطى \"حَسن بن مَأمون\" مَضتْ","هَيابة تَسعَى عَلى استحياء",43,"ا",2,0],["أما خطايَ ففي طريقٍ مقفرٍ","فيهِ الدَّليلُ يتيهُ بي كيْ أشرُدَا",44,"د",2,0],["اما خطفت لك نجمٍ فالسما عالي","والا زرعتك غمامة حسن ورديه",45,"د",3,0],["أم اخترنا بأن نحيا","كأحرارٍ إلى حينِ؟",46,"ن",1,0],["أم اختارَ الهَوَى جسمًا رقيقًا","لقلبِ فراشةٍ تشتاقُ رِقّي",47,"ق",2,0],["أمَا خلقت بني الإنسان في كَبَدٍ","أما تخفِّف عنه بعض ما يذَرُ؟",48,"ر",1,0],["أما خاف يهتك مستوره","أما خاف يظهر مسروقه",49,"ق",2,0]]}