{"poems":[[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[27,"لولا ابن حكام وأشراف قومه","https://www.aldiwan.net/poem4433.html","الطويل"],[51,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[49,"يا من يسر بنفسه وشبابه","https://www.aldiwan.net/poem10325.html","الكامل"],[66,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[142,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[198,"ألا عظة إن الزمان خؤون","https://www.aldiwan.net/poem51871.html","الطويل"],[297,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[366,"بلغت أول عمري أرذل العمر","https://www.aldiwan.net/poem17712.html","البسيط"],[402,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[416,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[464,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[514,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[564,"أأنت على عهد المحبة ماكث","https://www.aldiwan.net/poem830.html",""],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["أَمَّا خَلائِقُهُ فَقُلْ مَا شِئْتَ فِي","جَمِّ المُرُوءةِ رَاسِخِ الإِيمَانِ",0,"ن",1,0],["أَما خِفتَني يا جَنبُ إِذ بِتَّ لاعِباً","وَباتَت لِقاحي ما تَجِفُّ عُيونُها",1,"ن",3,0],["أم اختيرت الدنيا على تلك زوجةً","لشيءٍ سوى تعجِيلها حاجةَ البعلِ",2,"ل",1,0],["أَمّا خَيالُكِ يا بَخيلَ","ةُ فَهوَ مِثلُكِ في النُفورِ",3,"ر",1,0],["أَمّا خُطاكَ إِلى العَمى فَسَريعَةٌ","وَإِلى الهُدى فَأَراكَ مُنقَبِضَ الخُطا",4,"ا",1,0],["أَم أَخبَرَت أَنَّ اِبنَ أَيّوبٍ قَضى","فَتَكادُ مِن حُزنٍ عَليهِ تَمورُ",5,"ر",1,0],["أَمَّا خَليلٌ فَتَأْبَى","لَهُ مَزَايَاهُ نَدّا",6,"د",2,0],["أَم أَخْرَسَتْهُ سِنَةٌ ذاقَهَا","بيْنَ نَدَامَى هُمًّدٍ خُرسِ",7,"س",1,0],["أمّا خزائنُ مالِهِ فمباحةٌ","فاستوهِبوا من علمه المحزونِ",8,"ن",1,0],["أما خجلتْ من كرِّهِ وجِلادِه","فوارسُ كَفَّتْ عنه وهي صُفُون",9,"ن",1,0],["أَم آخِذٌ في العتب أَنتَ وتاركي","حَرضاً وأَنتَ الآخذُ التَرّاكُ",10,"ك",1,0],["أَمّا خَديعَةٌ أَحلامٍ أُغَرَّ بِها","في يَقظَتي فَلَمّا جاءَت عَلى فِكري",11,"ر",2,0],["أَمَا خِفتَ أني بسيفِ الهُدى","مليكِ البريّة أسْتَنْصِرَ",12,"ر",1,0],["أمَّا خمائله وأيّ خمائل","فالسندسُ المخضرُّ والإستبرق",13,"ق",1,0],["أما خشيتَ رجال الحيِّ قلتُ لها","شجاعةُ الجبِّ تستغني عن الحيلِ",14,"ل",1,0],["أمَا خشيتَ المنايا من مَناصلِها","فقلتُ والقلبُ لا يُطوى على وَجلِ",15,"ل",1,0],["أم اخترت خلا غيرنا بعد بيننا","لودك أم قد غيرتك الحوادث",16,"ث",1,0],["أَما خِفْت منْ قِصَّتِي أَنْ تشِيع","فَيُكتَبَ في حَالِها مَحْضر",17,"ر",1,0]]}