{"poems":[[95,"كلانا فاقد أما","https://www.aldiwan.net/poem11342.html","مجزوء الوافر"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[91,"أرأفي يا سماء بالمفجوع","https://www.aldiwan.net/poem44911.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85584","البسيط"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104469","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108052","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139471",""],[4954,"دعْني أنوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=208896",""],[5121,"نَبْضُ السَّهَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=216074",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5894,"أبسحر عينك قد وصلت بكائي","https://www.poetsgate.com/ViewPoem.aspx?id=131410",""],[5956,"ازحفْ أيا أرتينُ ازحف للعُلا","https://www.poetsgate.com/ViewPoem.aspx?id=205127",""]],"verses":[["أَرَأَفَتْ هَذِهِ الدُّنْيَا","لَنَا فِي رَاحِهَا سُمَّا",0,"م",2,0],["أُرافِقُ مِن شَكلِهِ ضَيغَماً","يُرافِقُ مِن نَفسِهِ ثَعلَبا",1,"ب",2,0],["أرأفي يا سماء بالمفجوع","بضراعاته وتلك الدموع",2,"ع",1,1],["ارأف بشعب بغاة الشر قد قصدوا","إثارة الشر فيه وهو ما قصدا",3,"د",2,0],["أرافعهم ترضى إلى أي معشر","أعق وهم أولى من المدح بالهجا",4,"ج",2,0],["ارأفوا يا حسان بالمعمودِ","واتقوا اللهَ في الطلى والخدودِ",5,"د",1,1],["أرأف العالمين من آل ياسي","ن أولى المجد خاتم الأوصياء",6,"ا",2,0],["اِرأفْ أيا ربّي بِعبدٍ واهِنٍ","إلّا أُسيْم فإنّها باللّائمِ",7,"م",1,0],["أُرَافِقُ الوَتَرَ الْمَشْغُولَ فِي شَغَفٍ","فَيَخْتَفِي شَغَفِي فِي شُرْفَةِ الوَتَرِ",8,"ر",1,0],["أرافق النجم في العليا ولي ألق","بأحرف زاد من تهويمها وتر",9,"ر",1,0],["أرافق بصبك يا جليل ولا تبح","بهواك عرضي يا ضيا لظلماء",10,"ا",2,0],["ارأفْ أيا أرتين خذنا كلَّنا","لملاعب كيلا نزيدَ ترَهُّلا",11,"ل",2,0]]}