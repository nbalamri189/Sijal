.poetsgate.com/ViewPoem.aspx?id=206072",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[6180,"الأعداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81071&r=&rc=5",""],[6190,"إباء الورد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86998&r=&rc=4",""],[6210,"ألق السلام على القباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78228&r=&rc=20",""],[454,"يزهو القريض به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82684&r=&rc=48",""]],"verses":[["سَيَظَلُّ يعبُدُ ذكرياتِكِ","لا يَمَلُّ ولا يَميلْ",0,"ل",1,0],["سيظل قلبي في الجوانح مزعجي","حتى تسيل مع الركاب دموعي",1,"ع",2,0],["سيُظْفِرُهُ بالمُنى زجْرُه","إلى ابن المظفَّرِ عِيسَ الرَّجاءِ",2,"ا",2,0],["سيظهرُ قصدُكم يا حابسيهِ","ونيتُكُمْ إذا نُصِبَ الصّراطُ",3,"ط",1,0],["سيظهر الحق وضّاحاً فيفضحهم","إلا إذا كابروا إلا إذا كتموا",4,"م",3,0],["سَيَظَلُّ ذَاكَ اليَومُ فِي تَارِيخِهِ","أَبَداً لأَشْرَفِ حَادِثٍ تَذْكَارَا",5,"ر",2,0],["سيظل شعرك يا عليّ مردداً","ما غرّد القمري في بستانه",6,"ن",2,0],["سيظل طيفك مائلاً لي: في الكرى","في الصحو، في الآصال، في الأسحار",7,"ر",1,0],["سيظلّ يشدو كالجداول لا ولم","ينضب غناه ولم يجفّ الجام",8,"م",1,0],["سيظل هذا النهر منجرداً","يهوى براكبه إلى البحر",9,"ر",1,0],["سيظهر ما أخفى ويخفيه حاسدي","ويعلم أين المضمرات الصحائح",10,"ح",1,0],["سيظل ما بقي الزمان","لكل مقتبس شهاب",11,"ب",1,0],["سيظل هذا الشعب يذكر زائد","بالفضل فهو بكل فضلٍ أخلق",12,"ق",1,0],["سَيَظَلُّ العراقُ يَنزِفُ حَتى","يُؤذِنَ اللَّيلُ كُلُّهُ بالزَّوا ل ِ",13,"ل",1,0],["سيظهرُ عاجِلاً نُوراً خَفيّاً","وينساقُ الأمورَ به انتظامُ",14,"م",1,0],["سيظل ممتهن الحقوق مكبلا","لا الدمع يسعهده ولا أناته",15,"ت",2,0],["سيظل منتصبا ترفُّ عَلَى","جنباته أَيّامه الغر",16,"ر",1,0],["سَيَظَلُّ الوُجودُ يُنشِدُ مَغنا","هُ وَيَروي فَم الزَمانِ رَوِيَّه",17,"ي",2,0],["سَيظَلُّ فَضْلُ مُحمَّدٍ فَوْقَ النُّهى","والعَقْلِ والتفكيرِ والتّبْيانِ",18,"ن",1,0],["سيظل اسمك 