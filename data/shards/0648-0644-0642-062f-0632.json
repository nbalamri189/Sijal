{"poems":[[55,"يا غريب الدار عن وطنه","https://www.aldiwan.net/poem26043.html","المديد"],[31,"هاج حزن القلب منها طائف","https://www.aldiwan.net/poem42517.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[235,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[261,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[458,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[464,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[551,"عج بوادي البشام علك أن تق","https://www.aldiwan.net/poem47214.html","الخفيف"],[551,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[575,"شاب فيه العذار فازددت عجباً","https://www.aldiwan.net/poem2880.html","الخفيف"]],"verses":[["وَلَقَد زادَ الفُؤادَ شَجاً","طائِرٌ يَبكي عَلى فَنَنِه",0,"ن",2,0],["وَلَقَد زادَ فُؤادي حَزَناً","قَولُها لي إِرعَ سِرّي يا عُمَر",1,"ر",1,0],["وَلَقَدْ زَادَهُ شَجىً أَنَّ سُوقَ ال","عِلمِ كَانَتْ فِيْ مِصْرَ سُوقَ كَسَادِ",2,"د",1,0],["وَلَقَدْ زَارَهُ سَعِيدٌ قَدِيماً","أَيُّ بِيْتٍ فِي عَهْدِهِ كَانَ أَسْعَدْ",3,"د",1,0],["وَلَقَدْ زِدْتَنَا صَنِيعاً وَهَلْ تَأْتِي","صَنِيعاً إِلاَّ إِذَا كَانَ عِدا",4,"د",2,0],["وَلَقَد زينَتِ الخِلافَةُ مِنهُم","بِإِمامِ الهُدى أَبي العَباسِ",5,"س",1,0],["ولقد زارنا به الغيث واستقضاه","عهداً بأن تدوم عهاده",6,"د",2,0],["ولقد زففتُ لكم كنائنَ خِدرِهِ","فكرمتُمُ صِهراً ووالِيَ عُذْرَةِ",7,"ه",1,0],["ولقد زنت عيني برؤية غيره","جهلاً ورجمُ الدمع حدُّ المحصنِ",8,"ن",1,0],["وَلَقَد زارَني عشيّة جمعٍ","مِنكُمُ زائرٌ على الأحلامِ",9,"م",1,0],["ولقد زارني فأَرَّق عيني","حادثٌ أقعد الحِجى وأقاما",10,"م",2,0],["ولقد زَادَهُ جَمالاً وحُسْناً","زَادَ نُوْحِي من الغَرامِ وَوَيْلِي",11,"ي",1,0]]}