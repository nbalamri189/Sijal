{"poems":[[57,"يا غريب الدار عن وطنه","https://www.aldiwan.net/poem26043.html","المديد"],[33,"هاج حزن القلب منها طائف","https://www.aldiwan.net/poem42517.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[266,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[463,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[469,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[556,"عج بوادي البشام علك أن تق","https://www.aldiwan.net/poem47214.html","الخفيف"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[580,"شاب فيه العذار فازددت عجباً","https://www.aldiwan.net/poem2880.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126821","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137341",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[1032,"","https://poetry.dctabudhabi.ae/diwan/poem/147083","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56024","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75733","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49942","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127965","الخفيف"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128752","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110315","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93700","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137313",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94253","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93817","الخفيف"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138921",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132550","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62931","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103055","الخفيف"],[4045,"","https://poetry.dctabudhabi.ae/diwan/poem/34753","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81936","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136599",""],[4677,"زيتونة","https://www.poetsgate.com/ViewPoem.aspx?id=203969",""],[4858,"إلى روح الشهيد سيد قطب","https://www.poetsgate.com/ViewPoem.aspx?id=29820",""],[5072,"قلب ٌ غزاها","https://www.poetsgate.com/ViewPoem.aspx?id=51897",""],[5431,"ستظلُ دهرا في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=197517",""],[5644,"دلل فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=207324",""],[469,"جفني الذي يرد الكرى متأسنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574830",""]],"verses":[["وَلَقَد زادَ الفُؤادَ شَجاً","طائِرٌ يَبكي عَلى فَنَنِه",0,"ن",2,0],["وَلَقَد زادَ فُؤادي حَزَناً","قَولُها لي إِرعَ سِرّي يا عُمَر",1,"ر",1,0],["وَلَقَدْ زَادَهُ شَجىً أَنَّ سُوقَ ال","عِلمِ كَانَتْ فِيْ مِصْرَ سُوقَ كَسَادِ",2,"د",1,0],["وَلَقَدْ زَارَهُ سَعِيدٌ قَدِيماً","أَيُّ بِيْتٍ فِي عَهْدِهِ كَانَ أَسْعَدْ",3,"د",1,0],["وَلَقَدْ زِدْتَنَا صَنِيعاً وَهَلْ تَأْتِي","صَنِيعاً إِلاَّ إِذَا كَانَ عِدا",4,"د",2,0],["وَلَقَد زينَتِ الخِلافَةُ مِنهُم","بِإِمامِ الهُدى أَبي العَباسِ",5,"س",1,0],["ولقد زارنا به الغيث واستقضاه","عهداً بأن تدوم عهاده",6,"د",2,0],["ولقد زففتُ لكم كنائنَ خِدرِهِ","فكرمتُمُ صِهراً ووالِيَ عُذْرَةِ",7,"ه",1,0],["ولقد زنت عيني برؤية غيره","جهلاً ورجمُ الدمع حدُّ المحصنِ",8,"ن",1,0],["وَلَقَد زارَني عشيّة جمعٍ","مِنكُمُ زائرٌ على الأحلامِ",9,"م",1,0],["ولقد زارني فأَرَّق عيني","حادثٌ أقعد الحِجى وأقاما",10,"م",2,0],["ولقد زَادَهُ جَمالاً وحُسْناً","زَادَ نُوْحِي من الغَرامِ وَوَيْلِي",11,"ل",2,0],["ولقد زيّنت وطابَ شذَاها","بهمامٍ عمّ الورى أفضالا",12,"ل",2,0],["ولقد زكت فيكِ الغصونُ وصافحت","قمَمَ الجبال وهامةَ الأَفلاك",13,"ك",1,0],["وَلَقَد زادَ رفعة قَدر مَجدي","بِمَديح عَلى مَعاليه أَوقف",14,"ف",1,0],["ولقد زارني الخيالُ فما صا","دفَ منِّي الخيالُ إلاَّ خيالا",15,"ل",2,0],["ولقد زها منثوره الباهي كما","باهى وضاءَ الدر والمرجانُ",16,"ن",1,0],["وَلَقَد زَرعت مَدائحي في مربع","فاعشو شب الكذر الَّذي لا يعشب",17,"ب",1,0],["ولقَد زَجْرتُ من البَوارِح مرَّةً","قبلَ التّفرُّق مَرَّها وصياحها",18,"ح",3,0],["ولقد زاد في الحباء فدعنى","أشكر الله ماحييت وأحمد",19,"د",1,0],["ولقد زورَّ الخيال لعيني","طيف ظبي باالكرخ والزوراء",20,"ا",2,0],["وَلَقَد زارَنِي المَشِيبُ فَما كا","نَ وَقاراً بَل كانَ في الأُذنِ وَقرا",21,"ر",2,0],["ولقد زهت وزهوت فيها","في المواقف والمجامع",22,"ع",1,0],["وَلَقد زَكوا وَالعرْب في أَهوائِها","تَتقاسم الأَنصاب وَالأَزلاما",23,"م",2,0],["ولقد زينت المحاماة لما","في سماها جلوا محياك بدرا",24,"ر",2,0],["ولقد زينته رقة طبع","بحلى الحسن تسترق النجاشى",25,"ش",2,0],["ولقد زان جيدها منكسمط","من تحلى بمثله أن يعطل",26,"ل",1,0],["ولقد زانه سماح وبأس","بهما يرغم العتل الحسود",27,"د",1,0],["ولقد زودت بخفي حنين","بعد شهر فخابت المسعاة",28,"ه",1,0],["ولقد زهِدتُ فكنتُ أولَ زاهدٍ","ولقد رغبتُ فَرُمْتُ خيرَ مَرَامِ",29,"م",1,0],["ولقد زين المكارم مسعا","ك كما زين العقود النظام",30,"م",1,0],["وَلَقَد زُرتِ دارَها وَأَرى الأُخ","تَ تُؤَدّي لِلأُختِ حَقَّ الزِيارَه",31,"ر",2,0],["ولقد زلزلت الأرضون من","جزع والدهر قد شق الردا",32,"ا",1,0],["ولقد زجرت النفس وهي","تهمُّ في طلب المعالي",33,"ل",2,0],["ولقد زادَ سَناه ونحُولي","فكلانا لهلال العِيد حاكي",34,"ك",2,0],["ولقد زرعت على الدروب مشاعلًا","حتى يراها بالليالي العائدون",35,"ن",1,0],["ولقدْ زكتْ أيام عمركَ كلّها","حتى تلقيتَ الشهادةَ \" سيدُ",36,"د",1,0],["ولقد زرعت َ بروضِها روح َ المُنى","لكن نسيت َ .. وكان فيك َ قِوامُها",37,"م",3,0],["ولقد زرعت محبتي","زهرَ الوفاء وعنبره",38,"ر",2,0],["ولقد زهدت بذي المباهجِ كلها","واخترت قلبك لا أريد بديلا",39,"ل",2,0],["ولقد زنت عيني برؤية وجهه","جهلاً ورجم الدمع حد المحصن",40,"ن",1,0]]}