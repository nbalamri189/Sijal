{"poems":[[53,"سبغت نعمة ودام صفاء","https://www.aldiwan.net/poem7955.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138329",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40128","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90921","الكامل"],[5376,"عمَّ السماءَ فضائلٌ وسناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188367",""]],"verses":[["سَبغتْ نِعمةٌ ودام صفاءُ","ووقاك الحوادثَ الأكْفاءُ",0,"ف",3,1],["سبغت على الزوجين أكبر نعمة","بمحبة بين القلوب تؤلف",1,"ف",1,0],["سَبَغَتْ على الإسلام بيض حُجُوله","وَاِختالَ في أَوضاحِها جبهاتُهُ",2,"ت",2,0],["سبغين من عز ومن حظ فيا","نعم الغلام المستفاد مهندا",3,"د",2,0],["سبغَ القلوبَ محبَّةً ومودَّةً","ماز الشهورَ وكلُّه آلاءُ",4,"ا",2,0]]}