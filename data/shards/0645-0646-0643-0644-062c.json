oetry.dctabudhabi.ae/diwan/poem/96746","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72277","الكامل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117085","الرجز"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111176","الكامل"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128301","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79812","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69321","الكامل"],[2032,"","https://poetry.dctabudhabi.ae/diwan/poem/121984","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100358","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131259",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119641","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127063","السريع"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73148","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35112","البسيط"],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5409,"مروا به وسط الدساكر","https://www.poetsgate.com/ViewPoem.aspx?id=155277",""],[5582,"عُجْ بِالمَطِيِّ عَلَى رُسُومِ البانِ","https://www.poetsgate.com/ViewPoem.aspx?id=63599",""],[243,"يوم ارتوى الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=20960",""],[6069,"سفرت فخلت سواد معجرها","https://www.poetsgate.com/ViewPoem.aspx?id=105666",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""]],"verses":[["مِن كُلِّ جِسمٍ تَقتَضيهِ حُفرَةٌ","فَكَأَنَّهُ مِن طينِها مَخلوقُ",0,"ق",1,0],["مِن كُلِّ جُرشُعَةِ الهَواجِرِ زادَها","بُعدُ المَفاوِزِ جُرأَةً وَضَريرا",1,"ر",2,0],["مِن كُلِّ جَزّارٍ يَرومُ الصَدرَ في","نادي المُلوكِ وَجَدُّهُ غَنّامُ",2,"م",1,0],["من كل جيَّاشِ العِنان إِذا جَرى","يومَ الرِّهانِ فسبقُه مضمونُ",3,"ن",1,0],["من كلّ جسمٍ يَحتْسي من ريحِهِ","روحاً يقُيم بخلقهِ أشكالا",4,"ل",2,0],["من كلّ جذلان كأنّ رُوحَهُ","عن جسمه من شدّةِ السكرِ نَزَح",5,"ح",1,0],["مِن كُلِّ جَبّارِ القُوى مُتَمَرِّدٍ","يَعلو الخُطوبَ مُساوِراً وَثّابا",6,"ب",2,0],["مِن كُلِّ جِسمٍ كَأَنَّهُ عَرَضٌ","يَكادُ لُطفاً بِاللَحظِ يُنتَهَبُ",7,"ب",1,1],["مِن كُلِّ جائِلَةِ النِسعَينِ ضامِرَةٍ","مُشتاقَةٍ حَمَلَت عِبءً لِمُشتاقِ",8,"ق",1,0],["من كُلّ جائشةِ العَشِيّ مُفِيئةٍ","بالمَيْرِ خَيرَ مَرَافدٍ وصِحاف",9,"ف",1,0],["من كل جُرحِ سائلٍ","تمتدُّ أَلسِنةٌ فصاح",10,"ح",1,0],["من كل جاريةٍ للشعرِ راويةٍ","كأنها غُصُنٌ الرَّوْض مَيَّاد",11,"د",1,0],["من كل جاموسةٍ لعنبلها","رأس بقرنيه يفلق الحجرا",12,"ر",2,0],["مِن كُلِّ جائِلَةِ الوِشاحِ تَخالُها","بَدراً عَلى الغُصنِ الرَّطيبِ تَأَلَّقا",13,"ق",2,0],["مِن كُلِّ جائِلَةِ الوِشاحِ تَهُزُّ غُص","نَ البانِ في أَعلى الكَثيبِ المائِرِ",14,"ر",1,0],["من كلِّ جَفنٍ بين عَيني بَين","وإنَّما تَسهرُ عَينٌ لِعَين",15,"ن",1,1],["من كل جيش عتد عرمرم","وحار موار العجاد الأقتم",16,"م",1,0],["مِن كلَّ جائلةِ الوشاحِ رشيقةٍ","مِن فوقِ خَصرٍ كالجَديلِ قَصيفِ",17,"ف",1,0],["من كلَّ جائلةِ الوَضينِ أذابَها","الاِعمالُ بينَ النصَّ والاِرقالِ",18,"ل",1,0],["من كل جندي أبق","ما للهلال الأحمر",19,"ر",1,0],["من كلِّ جامِعِ طَوْرٍ في جوامِعِنا","وكلِّ حاضِرِ قلبٍ في حَضائِرِنَا",20,"ن",2,0],["مِن كُل جائِلَةِ الوِشاحِ غَريرَةٍ","غَنيَت مَحاسِنُها عَنِ التَّحسينِ",21,"ن",1,0],["من كل جهم الوجه لي","ثيِّ الأظافر والمخالبْ",22,"ب",1,0],["مِنْ كُلّ جَرْدَاءَ قدْ طَارتْ عَقيقتُهَا","وكلِّ أجْردَ مُستَرْخي الأبَازينِ",23,"ن",1,0],["مِنْ كُلّ جَدْوَلَ كَالْحُسَامِ إذا انْبَرى","فِي حُسْنِ رَوْنَقِهِ وَصَفْوِ صِقَالِ",24,"ل",1,0],["من كلِّ جائلةِ الوشاحِ كأنَّها","من عفر وجرة أمُّها نعمانِ",25,"ن",1,0],["من كل جبار عنيد لم يزل","يأوي لشيطان إليه مريد",26,"د",1,0],["مِن كُلِّ جِلفٍ لم يَكُن مُصَرَّمَا","جَعدٍ يُرَى منه التصنُّعُ رَيثَمَا",27,"م",2,1],["من كل جسم بالحسام موزع","عن كل صدر بالسهام مسهم",28,"م",1,0],["من كل جنس براً أصنافه وذرا","أشباحه بين مكسور ومنجرد",29,"د",1,0],["من كلِّ جانحةٍ تُقاذِفُها الرُّبى","ويشوقها الأنجاد والأغوارُ",30,"ر",1,0],["مِن كُلِّ جائِلَةِ الوِشاحِ تَدَيَّرَت","مِن غَورِهِ الأَدنى إِلى جَولانِهِ",31,"ه",1,0],["منكل جائلة الوشاح يهزها","مح الشباب اللدن هز البان",32,"ن",1,0],["من كل جهمي ومعتزل ومن","والاهما من حزب جنكسخان",33,"ن",1,0],["من كل جؤذر رملةٍ ثمل","لي من سلافة خده ثملُ",34,"ل",1,0],["من كل جامعة سخت بإغاثة","وحكومة أبدت لنا أفضالها",35,"ل",3,0],["من كل جهم الوجه يرعف انفه","حقداً وينطق بالهراء فيسهب",36,"ب",1,0],["مِن كُلِّ جمَّاء الحُجوم بَضَّةٍ","صَامِتِة الخِلخالِ غَرثاء الحَشا",37,"ا",1,0],["من كل جيش زف مقتحما","بطلٌ تحدم أيما بطل",38,"ل",1,0],["من كلّ جوّاظٍ له عرض القِفا","علَمٍ كثير النفخ غير سمين",39,"ن",1,0],["من كل جواظ عريض القفا","عن حلية الإنصاف عريانا",40,"ن",2,0],["من كل جرداء تباري القطا","وكل يعبوب يجاري الرياح",41,"ح",1,0],["مِن كلِّ جائلةِ الوشاحِ يزينُها","قدٌّ يميلُ معَ النَّسيمِ ولينهِ",42,"ن",2,0],["من كل جارحة جراح في الحشا","يبقى حديث شؤونها ماثورا",43,"ر",2,0],["مِن كُلِّ جَفنٍ يَسِلُّ سَيفاً","صارَ لَها غِمدُهُ رِئاسا",44,"س",2,0],["من كل جنسٍ طيور الدوح تنشدها","كأنَّ سكَّانها طير عصافيرُ",45,"ر",1,0],["من كل جانٍ يستحل ال","جرم من خلف الستائر",46,"ر",1,0],["مِنْ كُلِّ جائِلَةِ الوِشاحِ كأَنَّها","مِنْ عُفْرِ وَجْرَةَ أَمْ مَها نَعْمانِ",47,"ن",1,0],["من كل جازي يد بالزاد تطعمه","غلا ومن آكل الثدي الذي رضعا",48,"ع",2,0],["من كل جائلة الوشاح إذا","قامت وناء بردفها الخصر",49,"ر",1,0],["من كُلِّ جبارٍ تَهدَّدَ رَهْطَهُ","تَبَّتْ يَداهُ مِنْ لَعينٍ مُزبِدِ",50,"د",1,0]]}