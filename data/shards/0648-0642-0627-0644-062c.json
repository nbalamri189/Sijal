{"poems":[[74,"لما رأى الظبي طرف حبي","https://www.aldiwan.net/poem18684.html","مخلع البسيط"],[87,"سألت حبيبي في قبلة","https://www.aldiwan.net/poem7041.html","المتقارب"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29338","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[571,"صحا من تصابيه الفؤاد المشوق","https://www.aldiwan.net/poem1929.html","الطويل"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121076","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102140","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86279","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114439","المتقارب"],[5419,"للكبار فقط","https://www.poetsgate.com/ViewPoem.aspx?id=32270",""],[5535,"سأودعك السر الذي قد كتمته","https://www.poetsgate.com/ViewPoem.aspx?id=201513",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""]],"verses":[["وقال جفنٌ لم سقيمٌ","يا ليتني مت قبل هذا",0,"ذ",2,0],["وقال جرحت بوقع الشفاه","خدودي وذنبك لا يحتمل",1,"ل",1,0],["وقال جواريهم لعل قلوصه","بدار ابن اوفى صبة اللف ألف",2,"ف",1,0],["وقال جدُّ الناظم","مستَنَدُ الأَعاظِمِ",3,"م",1,0],["وَقالَ جَميعُ الناسِ أَينَ مَصِيرُنا","فَأَضمَرَ مِنها خُبثَ نَفس مُمَزَّقُ",4,"ق",1,0],["وقال جمرى بكلامكم وقد","أنا الذي أشبه أعطافا وقد",5,"د",1,0],["وقال جليسي ما لوجهك اصفرا","فقلت له بالرغم عني صبغته",6,"ت",2,0],["وقال جعلت البدر فيهن مشرقاً","ضياءً ونوراً في الظلام إذا ادلهم",7,"م",1,0],["وقال جليسُ ذا كرني","أنا فجليسُكُم فردى",8,"د",2,0],["وَقالَ جنَت مقلتاكَ الذنوب","فَقُلتُ ذنوب الحشا ماهيَه",9,"ي",2,0],["وَقالَ جِبريلُ من رَب يبشرنا","بِصَوت وَحي لَدى تاريخ عَبدِهِم",10,"م",1,0],["وقال جل الناظم","مستند الأعاظم",11,"م",1,0],["وقالَ جنيتَ على وجنتي","فقُلتُ له العبدُ فيما جنى",12,"ن",2,0],["وقال : جميع الحلول ستأتي","عليكم بشيءٍ يحلّ الوسطْ",13,"ط",1,0],["وقال جليسي ما لوجهك أصفراً","فقلت له بالرغم مني صبغته",14,"ت",2,0],["وقال جميع الخلق والدين واحد","وما غيره نطق ففي الأرض يقبر",15,"ر",1,0],["وقال جن الظلام فيه","مازحني عاذلي وما جن",16,"ن",1,0]]}