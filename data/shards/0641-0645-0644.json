"],[5989,"يا راحلاً قد شاقهُ الغرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=181565",""],[6019,"يوم اللغة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=201467",""],[6031,"يا أَخَا هَاشِمَ أهْلا","https://www.poetsgate.com/ViewPoem.aspx?id=46348",""],[6081,"قالت أما راعك المشيب فقد","https://www.poetsgate.com/ViewPoem.aspx?id=186818",""],[6093,"لَوْلاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=184905",""],[520,"فما استنشقت ريح الصباح خياشم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577633",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""]],"verses":[["فَمَلَكنا بِذَلِكَ الناسَ حَتّى","مَلَكَ المُنذِرُ بِنُ ماءِ السَماءِ",0,"ا",2,0],["فمُلْكُك فيها ما أجلَّ جلالَهُ","وسيْفُكَ ما أسْطى وكفُّكَ ما أنْدى",1,"د",2,0],["فمُلْكُكُمْ بسُليْمانَ بْنِ داوُدَ في","العِزِّ مُلْكُ سُليْمانَ بْنِ داوودِ",2,"د",1,0],["فمُلْكُكَ مَنْصورُ اللِّواءِ سَعيدُهُ","وظِلُّكَ خفّاقُ الرواقِ مَديدُهُ",3,"د",2,0],["فمُلْكُكَ للأمْلاكِ لا شكّ غالِبٌ","وعُمْرُكَ للأعْمارِ لا شكّ وارِثُ",4,"ث",1,0],["فَمُلُوكُهَا وَشُعُوبُهَا يَلْقَوْنَهُ","بِأَعَزِّ مَا ادَّخَرُوا مِنَ الإكْرَامِ",5,"م",1,0],["فملك الكفر خائب","كاحدقت به النوائب",6,"ب",1,0],["فملكٌ بلا جور وحكمٌ بلا هوًى","وأزرٌ بلا وِزْرٍ وعزّ بلا كبر",7,"ر",1,0],["فملكك حقّ واضح الصبح أشرقت","سعادته كالظهر يا واحد العصر",7,"ر",1,0],["فملتُ إلى خانٍ مُرثٍّ بناؤُه","مميلَ غريقِ الثوب لهفانَ لاغِبِ",8,"ب",1,0],["فملت بها إلى رحلي فكانت","ألذّ مطيةٍ بطناً وظهرا",9,"ر",2,0],["فَمُلِّئْتَهُ لا باذلاً حُرَّ وَجههِ","ومُلِّئتُما فَضلاً من الله صائنا",10,"ن",2,0],["فَمِلتُ بِها مَيلَ النَزيفِ وَنازَعَت","رِدائِيَ وَالمَيسورِ خَيرٌ مِنَ العُسرِ",11,"ر",1,0],["فَمَلَأتَ هاتيكَ الأَباطِحِ وَالرُبى","بِجُسومِهِم وَمَلَأتَهُم أَهوالا",12,"ل",2,0],["فَمِلءُ جَوانِحي حُزنٌ مُذيبٌ","وَمِلءُ مَحاجِري دَمعٌ سَخينُ",13,"ن",1,0],["فَمَلَلنا وَلَم يَكُ الداءُ يَحمي","أَن تَمَلَّ الأَرواحُ وَالأَجسامُ",14,"م",1,0],["فَمَلَّكَ دَهرُ السوءِ صاعِدَ مَجدِهِم","يَدَي هابِطٍ يا لِلقَنا وَالمَقانِبِ",15,"ب",1,0],["فملأتُ آفاقَ البِلادِ بمَنْطِقٍ","لولا الثَّناءُ عليكَ عادَ وُجُوما",16,"م",2,0],["فَمٌ لِيَحيى ريحُهُ مُنتِنٌ","لَم يُرَ يَوماً مِثلُهُ قَطُّ",17,"ط",1,1],["فَمِل نَحوَ إِخوانِ الصَفاءِ وَلا تَقُل","فَإِنَّني إِلى قَومٍ سِواكُم لَأَميَلُ",18,"ل",1,0],["فَمَلَكتُ الأَطرافَ مِنهُ وَسلَّط","تُ عَلَيهِ تَطابُقَ الرَخَّينِ",19,"ن",1,0],["فَمِلآنَ يَثنِ الصَبرُ نَفسِيَ أَو تَمُت","إِذا اِنبَتَّ حَبلٌ مِن حِبالِكِ فَاِنقَضَب",20,"ب",1,0],["فَمِل طَرَباً بَينَ ظِلٍّ هَفا","رَطيبٍ وَماءٍ هُناكَ اِنثَعَب",21,"ب",1,0],["فَمِل عَن طَريقِ شِهابٍ سَرى","فَأَهوى وَوادي أَتِيٍّ حَمَل",22,"ل",1,0],["فَمِلءُ العَينِ قَصرٌ قَد تَراهُ","جَديدَ البابِ داخِلُهُ خَرابُ",23,"ب",1,0],["فَمِل عَن بَني حَوّاءَ مِن نَسلِ آدَمٍ","لِتَنزِلَ بَينَ الحُوِّ وَالأُدمِ وَالعُفرِ",24,"ر",1,0],["فَمَلَّكَ بِاللَيطِ الَّذي تَحتَ قِشرِها","كَغِرقيءِ بَيضٍ كَنَّهُ القَيضُ مِن عَلُ",25,"ل",1,0],["فَمِلنا وَنازَعنا الحَديثَ أَوانِساً","عَلَيهِنَّ جَيشانِيَّةٌ ذاتُ أَغيالِ",26,"ل",1,0],["فمِلْتُ به أَجْتَرُّهُ نَحْوَ جَمْرَةٍ","لها بارِقٌ للضَّيْفِ غَيْرُ يَمانِ",27,"ن",1,0],["فَمِلْنا إِلَى وادٍ كَأَنَّ تِلاعَهُ","مِنَ الْعَصْبِ مَوْشِيُّ الْحَبائِكِ مُذْهَبُ",28,"ب",1,0],["فملت الوصلَ .. والأقمار أمزجةٌ ناريّةٌ .. قلّما وفّتْ بما تعِدُ","أوّاه! سيّدةَ الأقمارِ! سيدتي! أوّاهِ! لو تجد الأقمار ما نجدُ",29,"د",1,0],["فَمَلَكْنَا بذَلك النَّاسَ إذْ ما","مَلكَ المُنْذرُ بنُ ماءِ السًّماءِ",30,"ا",2,1],["فملكك فيها ما أجل جلاله","وسيفك ما أسطى وكفك ما أندا",31,"د",2,0],["فملككم بسليمان بن داود في","الدهر ملك سليمان بن داود",32,"د",1,0],["فم لك تقسو على أمّة","سقتك الوداد مصفّى زلالا",33,"ل",2,0],["فَمٌّ ليس كالمَدعي قولةً","وليس كآخَرَ يَسترحِم",34,"م",1,0],["فَمَلِّكِ المكارمَ القوائدا","تمليكَك الحرائرَ الولائدا",35,"د",2,0],["فملْ طرباً بينَ ظلٍّ هفا","رطيبٍ وماءٍ هناكَ اانثعبْ",36,"ب",1,0],["فَمِل لِكَتَابِ اللهِ والسُّنُّةِ التى","بِها سَالِكٌ المَورِ المُضَلِّلِ مُرتَدَع",37,"ع",1,0],["فملكتَّهُ عنانَ الأمرِ وامتزجتْ","لدى كهولتهِ باللحم والعصبِ",38,"ب",1,0],["فملكتها روحي ومالي ومهجتي","وأصفيتها مني المحبة والودا",39,"د",2,0],["فملكهم من آدم منتظمٌ","إلى المليك الطاهر المستظهرِ",40,"ر",1,0],["فملوكها في الجاهلية أنتمُ","ولأنتم الخلفاءُ في الإيمان",41,"ن",1,0],["فملكك من يلحظ معانيه لم يجد","سوى دفع مكروه وتفريج كربة",42,"ه",1,0],["فملكك يايحيى هو الجر والثنا","إذا كان ملك الظالمين هو الإِثمُ",43,"م",1,0],["فملكك تفريجٌ من الله عنهم","وعنك فشكر الله فرض به حتمُ",43,"م",1,0],["فملا اشتد أَكلُ السيفِ فيهم","وأَعيا خضطبُ حدّيه عِلاجا",44,"ج",2,0],["فَمِلنا إِلى رَحبِ المَباءَةِ ماجِدٍ","عَظيمِ المَقاري غَيرِ جِبسٍ كُنابِثِ",45,"ث",1,0],["فَمِلتُ لِلهَجرِ لا عَن رَغبَةٍ وَرِضىً","لكن أُعدُّ لَدى التَحقيقِ مَهجوراً",46,"ر",2,0],["فملت إلى اليهود رجاء حرّ","أعاشرُ منه مأمونا رشيدا",47,"د",2,0],["فملكت شكر ملدّد","وجمعت أجرك في ثوابه",48,"ب",2,0],["فملكن إحساسي عليّ","فطاف قلبي حولهنّه",49,"ن",2,0],["فملاحةٌ وسماحة وصراحةٌ","ورجاحةٌ بالعقل فاشكر واحمد",50,"د",1,0],["فملكاً نقيل إذا ما كبا","وعرشاً تقيمُ إذا ما انقلب",51,"ب",1,0],["فَمُلِّيتَ عُمْرَكَ ما تابعتْ","لنا بُكَرُ الدَّهْرِ آصالَها",52,"ل",3,0],["فَمُلوكُ الأَرضِ تَنقادُ لَهُ","طاعَةً تَخضَعُ في تيجانِها",53,"ن",3,0],["فَمَلَأنا الدِلاءَ حَتّى عُراها","عَلَقاً بَرَّدَ القُلوب السِقاما",54,"م",2,0],["فملتُ إلى ذيالكَ الصوتِ ساجداً","وقد خَرّتِ الأطوادُ مثلي لخشية",55,"ه",1,0],["فملكتُ قلباً طاهراً وحرمتُهُ","عَطفي وليني بعدَ لينِ قياد",56,"د",1,0],["فَمُلكُ صَلاحِ الدينِ وارٍ زِنادُهُ","بِهِ مُستَتِبّاً في سَحيلٍ وَمُبرَمِ",57,"م",1,0],["فَملاذُ أوزارِ الحروب لواؤهُ","وَمدى مسير العزّ والتمكينِ",58,"ن",1,0],["فملاك كل فضيلة وحقيقة","بيديك تعرف وضعها إن بدلوا",59,"ل",3,0],["فملأتَ الزَمان أَمناً وَفَوزاً","يا مَسيحاً لم تَرْقَهُ المُسحاءُ",60,"ا",2,0],["فمِلكُ مثليَ لا يغلُو بما بَذَلَ ال","مبتاعُ فيه ولا يُستام بالقِيَمِ",61,"م",1,0],["فملوكها شرف الملوك وربعها","خير الربوع وأهلها نعم الورى",62,"ر",2,0],["فمليكُه المرهوب يُعدِمه ندىً","فيعودُ حيّ العَود بعدَ مماتِه",63,"ت",2,0],["فَمَلَّأْتَها هَدياً وبِرّاً وسُودَداً","وبأساً عَلَى أعدائِهنَّ وجُودا",64,"د",2,0],["فَمُلِّيتُما نُص