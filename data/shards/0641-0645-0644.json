{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"الحمد لله كم لله من جود","https://www.aldiwan.net/poem36544.html","البسيط"],[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[77,"هلم فما بيني وبينك ثالث","https://www.aldiwan.net/poem36673.html","الطويل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[72,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"بدت لي غادة لم تبد إلا","https://www.aldiwan.net/poem62863.html","الوافر"],[51,"أيا ابن رجاء وابنه الخير لا يزل","https://www.aldiwan.net/poem66382.html","الطويل"],[29,"لأسماء محتل بناظرة البشر","https://www.aldiwan.net/poem6183.html","الطويل"],[91,"لله ما أحلى البشير وقوله","https://www.aldiwan.net/poem62655.html","عموديه"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[61,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem51442.html","الطويل"],[66,"فم ليحيى ريحه منتن","https://www.aldiwan.net/poem38596.html","السريع"],[66,"أجلك إن يسخ الزمان وتبخل","https://www.aldiwan.net/poem39062.html","الطويل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[31,"لعمري لقد بينت في وجه تكتم","https://www.aldiwan.net/poem42627.html","الطويل"],[74,"ألا أفصح الطير حتى خطب","https://www.aldiwan.net/poem12838.html","المتقارب"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[50,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[46,"أرى كفرطاب أعجز الماء حفرها","https://www.aldiwan.net/poem22649.html","الطويل"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[15,"أمن منزل عاف ومن رسم أطلال","https://www.aldiwan.net/poem45252.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30498","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[6,"فَمَلَكْنَا بذَلك النَّاسَ","https://www.poetsgate.com/ViewPoem.aspx?id=17537",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"الحمد لله كم لله من وجود","https://www.poetsgate.com/ViewPoem.aspx?id=33883",""],[96,"إلي أبناء الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=15720",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[74,"ألا أفصَحَ الطّيرُ، حتى خَطَبْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13963&r=&rc=4",""]],"verses":[["فَمَلَكنا بِذَلِكَ الناسَ حَتّى","مَلَكَ المُنذِرُ بِنُ ماءِ السَماءِ",0,"ا",2,0],["فمُلْكُك فيها ما أجلَّ جلالَهُ","وسيْفُكَ ما أسْطى وكفُّكَ ما أنْدى",1,"د",2,0],["فمُلْكُكُمْ بسُليْمانَ بْنِ داوُدَ في","العِزِّ مُلْكُ سُليْمانَ بْنِ داوودِ",2,"د",1,0],["فمُلْكُكَ مَنْصورُ اللِّواءِ سَعيدُهُ","وظِلُّكَ خفّاقُ الرواقِ مَديدُهُ",3,"د",2,0],["فمُلْكُكَ للأمْلاكِ لا شكّ غالِبٌ","وعُمْرُكَ للأعْمارِ لا شكّ وارِثُ",4,"ث",1,0],["فَمُلُوكُهَا وَشُعُوبُهَا يَلْقَوْنَهُ","بِأَعَزِّ مَا ادَّخَرُوا مِنَ الإكْرَامِ",5,"م",1,0],["فملك الكفر خائب","كاحدقت به النوائب",6,"ب",1,0],["فملكٌ بلا جور وحكمٌ بلا هوًى","وأزرٌ بلا وِزْرٍ وعزّ بلا كبر",7,"ر",1,0],["فملكك حقّ واضح الصبح أشرقت","سعادته كالظهر يا واحد العصر",7,"ر",1,0],["فملتُ إلى خانٍ مُرثٍّ بناؤُه","مميلَ غريقِ الثوب لهفانَ لاغِبِ",8,"ب",1,0],["فملت بها إلى رحلي فكانت","ألذّ مطيةٍ بطناً وظهرا",9,"ر",2,0],["فَمُلِّئْتَهُ لا باذلاً حُرَّ وَجههِ","ومُلِّئتُما فَضلاً من الله صائنا",10,"ن",2,0],["فَمِلتُ بِها مَيلَ النَزيفِ وَنازَعَت","رِدائِيَ وَالمَيسورِ خَيرٌ مِنَ العُسرِ",11,"ر",1,0],["فَمَلَأتَ هاتيكَ الأَباطِحِ وَالرُبى","بِجُسومِهِم وَمَلَأتَهُم أَهوالا",12,"ل",2,0],["فَمِلءُ جَوانِحي حُزنٌ مُذيبٌ","وَمِلءُ مَحاجِري دَمعٌ سَخينُ",13,"ن",1,0],["فَمَلَلنا وَلَم يَكُ الداءُ يَحمي","أَن تَمَلَّ الأَرواحُ وَالأَجسامُ",14,"م",1,0],["فَمَلَّكَ دَهرُ السوءِ صاعِدَ مَجدِهِم","يَدَي هابِطٍ يا لِلقَنا وَالمَقانِبِ",15,"ب",1,0],["فملأتُ آفاقَ البِلادِ بمَنْطِقٍ","لولا الثَّناءُ عليكَ عادَ وُجُوما",16,"م",2,0],["فَمٌ لِيَحيى ريحُهُ مُنتِنٌ","لَم يُرَ يَوماً مِثلُهُ قَطُّ",17,"ط",1,1],["فَمِل نَحوَ إِخوانِ الصَفاءِ وَلا تَقُل","فَإِنَّني إِلى قَومٍ سِواكُم لَأَميَلُ",18,"ل",1,0],["فَمَلَكتُ الأَطرافَ مِنهُ وَسلَّط","تُ عَلَيهِ تَطابُقَ الرَخَّينِ",19,"ن",1,0],["فَمِلآنَ يَثنِ الصَبرُ نَفسِيَ أَو تَمُت","إِذا اِنبَتَّ حَبلٌ مِن حِبالِكِ فَاِنقَضَب",20,"ب",1,0],["فَمِل طَرَباً بَينَ ظِلٍّ هَفا","رَطيبٍ وَماءٍ هُناكَ اِنثَعَب",21,"ب",1,0],["فَمِل عَن طَريقِ شِهابٍ سَرى","فَأَهوى وَوادي أَتِيٍّ حَمَل",22,"ل",1,0],["فَمِلءُ العَينِ قَصرٌ قَد تَراهُ","جَديدَ البابِ داخِلُهُ خَرابُ",23,"ب",1,0],["فَمِل عَن بَني حَوّاءَ مِن نَسلِ آدَمٍ","لِتَنزِلَ بَينَ الحُوِّ وَالأُدمِ وَالعُفرِ",24,"ر",1,0],["فَمَلَّكَ بِاللَيطِ الَّذي تَحتَ قِشرِها","كَغِرقيءِ بَيضٍ كَنَّهُ القَيضُ مِن عَلُ",25,"ل",1,0],["فَمِلنا وَنازَعنا الحَديثَ أَوانِساً","عَلَيهِنَّ جَيشانِيَّةٌ ذاتُ أَغيالِ",26,"ل",1,0],["فمِلْتُ به أَجْتَرُّهُ نَحْوَ جَمْرَةٍ","لها بارِقٌ للضَّيْفِ غَيْرُ يَمانِ",27,"ن",1,0],["فَمِلْنا إِلَى وادٍ كَأَنَّ تِلاعَهُ","مِنَ الْعَصْبِ مَوْشِيُّ الْحَبائِكِ مُذْهَبُ",28,"ب",1,0],["فَمَلَكْنَا بذَلك النَّاسَ إذْ ما","مَلكَ المُنْذرُ بنُ ماءِ السًّماءِ",29,"ا",2,1],["فملكك فيها ما أجل جلاله","وسيفك ما أسطى وكفك ما أندا",30,"د",2,0],["فملككم بسليمان بن داود في","الدهر ملك سليمان بن داود",31,"د",1,0],["فم لك تقسو على أمّة","سقتك الوداد مصفّى زلالا",32,"ل",2,0],["فَمٌّ ليس كالمَدعي قولةً","وليس كآخَرَ يَسترحِم",33,"م",1,0],["فَمَلِّكِ المكارمَ القوائدا","تمليكَك الحرائرَ الولائدا",34,"د",2,0],["فملْ طرباً بينَ ظلٍّ هفا","رطيبٍ وماءٍ هناكَ اانثعبْ",35,"ب",1,0]]}