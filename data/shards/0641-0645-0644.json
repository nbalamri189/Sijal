{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"الحمد لله كم لله من جود","https://www.aldiwan.net/poem36544.html","البسيط"],[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[77,"هلم فما بيني وبينك ثالث","https://www.aldiwan.net/poem36673.html","الطويل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[72,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"بدت لي غادة لم تبد إلا","https://www.aldiwan.net/poem62863.html","الوافر"],[51,"أيا ابن رجاء وابنه الخير لا يزل","https://www.aldiwan.net/poem66382.html","الطويل"],[29,"لأسماء محتل بناظرة البشر","https://www.aldiwan.net/poem6183.html","الطويل"],[91,"لله ما أحلى البشير وقوله","https://www.aldiwan.net/poem62655.html","عموديه"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[61,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem51442.html","الطويل"],[66,"فم ليحيى ريحه منتن","https://www.aldiwan.net/poem38596.html","السريع"],[66,"أجلك إن يسخ الزمان وتبخل","https://www.aldiwan.net/poem39062.html","الطويل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[31,"لعمري لقد بينت في وجه تكتم","https://www.aldiwan.net/poem42627.html","الطويل"],[74,"ألا أفصح الطير حتى خطب","https://www.aldiwan.net/poem12838.html","المتقارب"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[50,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[46,"أرى كفرطاب أعجز الماء حفرها","https://www.aldiwan.net/poem22649.html","الطويل"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[15,"أمن منزل عاف ومن رسم أطلال","https://www.aldiwan.net/poem45252.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30498","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[104,"سيدة الاقمار","https://www.poetsgate.com/ViewPoem.aspx?id=16826",""],[6,"فَمَلَكْنَا بذَلك النَّاسَ","https://www.poetsgate.com/ViewPoem.aspx?id=17537",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"الحمد لله كم لله من وجود","https://www.poetsgate.com/ViewPoem.aspx?id=33883",""],[96,"إلي أبناء الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=15720",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[74,"ألا أفصَحَ الطّيرُ، حتى خَطَبْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13963&r=&rc=4",""],[133,"لقد كنت أحجو الناس جل إختلافهم","https://www.aldiwan.net/poem54807.html","الطويل"],[136,"من بعد حمزة يحمي حوزة الأدب","https://www.aldiwan.net/poem49177.html","البسيط"],[161,"رضيتك مولاتي وارضيتني عبدا","https://www.aldiwan.net/poem58680.html","الطويل"],[161,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[161,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[161,"خذ الملك يا يحيى إليك بقوة","https://www.aldiwan.net/poem58881.html","الطويل"],[161,"تألق نور العدل وانطفأ الظلم","https://www.aldiwan.net/poem58882.html","الطويل"],[161,"تلاطم بحر جيشه وماجا","https://www.aldiwan.net/poem58954.html","الوافر"],[165,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[183,"سترت حبك في قلب إليك صبا","https://www.aldiwan.net/poem67063.html","البسيط"],[187,"بلوت المسلمين بكل أرض","https://www.aldiwan.net/poem43946.html","الوافر"],[187,"دمع تحدر في انسيابه","https://www.aldiwan.net/poem44153.html","مجزوء الكامل"],[198,"حسب الغواني أنهنه","https://www.aldiwan.net/poem39806.html","مجزوء الكامل"],[198,"بأبي وأمي من مددت لها يدي","https://www.aldiwan.net/poem39903.html","الكامل"],[200,"تمايل دهرك حتى اضطرب","https://www.aldiwan.net/poem45666.html","المتقارب"],[230,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[236,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[248,"وقرى باعث أسيد حرباً","https://www.aldiwan.net/poem1934.html","الخفيف"],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[271,"أصلا برزت لنا بلا ميعاد","https://www.aldiwan.net/poem35449.html","الكامل"],[283,"ومفترة عن كالجمان المنظم","https://www.aldiwan.net/poem32422.html","الطويل"],[306,"طل بالأمير لواء خير الدين","https://www.aldiwan.net/poem56391.html","الكامل"],[311,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[378,"بزغت في بروجها الأضواء","https://www.aldiwan.net/poem66989.html","الخفيف"],[410,"يا ناصر الدين يا بن الأكرمين ومن","https://www.aldiwan.net/poem32250.html","البسيط"],[430,"مذ جئت اسلامبول شمت محاسنا","https://www.aldiwan.net/poem40076.html","الكامل"],[433,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[440,"أهنيك يا عيد الرغائب عيدا","https://www.aldiwan.net/poem34786.html","الطويل"],[440,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[440,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[440,"هو النصر والتمكين أدرك طالبه","https://www.aldiwan.net/poem34818.html","الطويل"],[440,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[440,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[440,"ليهن لك العيد الذي بك يهنينا","https://www.aldiwan.net/poem34859.html","الطويل"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[440,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[449,"وما جرى من دمعه الاّ الذي","https://www.aldiwan.net/poem53780.html","الرجز"],[459,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[459,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[459,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[459,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[469,"وستر لصاحبه نيقة","https://www.aldiwan.net/poem59806.html","المتقارب"],[483,"بجزع الحمى ظبي حمى ذلك الحمى","https://www.aldiwan.net/poem24477.html","عموديه"],[483,"طفنا بكعبة حسن قد ألفنا بها","https://www.aldiwan.net/poem24495.html","عموديه"],[496,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[516,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[530,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[552,"ومنتقبات بالجمال أتيننا","https://www.aldiwan.net/poem47839.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[576,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["فَمَلَكنا بِذَلِكَ الناسَ حَتّى","مَلَكَ المُنذِرُ بِنُ ماءِ السَماءِ",0,"ا",2,0],["فمُلْكُك فيها ما أجلَّ جلالَهُ","وسيْفُكَ ما أسْطى وكفُّكَ ما أنْدى",1,"د",2,0],["فمُلْكُكُمْ بسُليْمانَ بْنِ داوُدَ في","العِزِّ مُلْكُ سُليْمانَ بْنِ داوودِ",2,"د",1,0],["فمُلْكُكَ مَنْصورُ اللِّواءِ سَعيدُهُ","وظِلُّكَ خفّاقُ الرواقِ مَديدُهُ",3,"د",2,0],["فمُلْكُكَ للأمْلاكِ لا شكّ غالِبٌ","وعُمْرُكَ للأعْمارِ لا شكّ وارِثُ",4,"ث",1,0],["فَمُلُوكُهَا وَشُعُوبُهَا يَلْقَوْنَهُ","بِأَعَزِّ مَا ادَّخَرُوا مِنَ الإكْرَامِ",5,"م",1,0],["فملك الكفر خائب","كاحدقت به النوائب",6,"ب",1,0],["فملكٌ بلا جور وحكمٌ بلا هوًى","وأزرٌ بلا وِزْرٍ وعزّ بلا كبر",7,"ر",1,0],["فملكك حقّ واضح الصبح أشرقت","سعادته كالظهر يا واحد العصر",7,"ر",1,0],["فملتُ إلى خانٍ مُرثٍّ بناؤُه","مميلَ غريقِ الثوب لهفانَ لاغِبِ",8,"ب",1,0],["فملت بها إلى رحلي فكانت","ألذّ مطيةٍ بطناً وظهرا",9,"ر",2,0],["فَمُلِّئْتَهُ لا باذلاً حُرَّ وَجههِ","ومُلِّئتُما فَضلاً من الله صائنا",10,"ن",2,0],["فَمِلتُ بِها مَيلَ النَزيفِ وَنازَعَت","رِدائِيَ وَالمَيسورِ خَيرٌ مِنَ العُسرِ",11,"ر",1,0],["فَمَلَأتَ هاتيكَ الأَباطِحِ وَالرُبى","بِجُسومِهِم وَمَلَأتَهُم أَهوالا",12,"ل",2,0],["فَمِلءُ جَوانِحي حُزنٌ مُذيبٌ","وَمِلءُ مَحاجِري دَمعٌ سَخينُ",13,"ن",1,0],["فَمَلَلنا وَلَم يَكُ الداءُ يَحمي","أَن تَمَلَّ الأَرواحُ وَالأَجسامُ",14,"م",1,0],["فَمَلَّكَ دَهرُ السوءِ صاعِدَ مَجدِهِم","يَدَي هابِطٍ يا لِلقَنا وَالمَقانِبِ",15,"ب",1,0],["فملأتُ آفاقَ البِلادِ بمَنْطِقٍ","لولا الثَّناءُ عليكَ عادَ وُجُوما",16,"م",2,0],["فَمٌ لِيَحيى ريحُهُ مُنتِنٌ","لَم يُرَ يَوماً مِثلُهُ قَطُّ",17,"ط",1,1],["فَمِل نَحوَ إِخوانِ الصَفاءِ وَلا تَقُل","فَإِنَّني إِلى قَومٍ سِواكُم لَأَميَلُ",18,"ل",1,0],["فَمَلَكتُ الأَطرافَ مِنهُ وَسلَّط","تُ عَلَيهِ تَطابُقَ الرَخَّينِ",19,"ن",1,0],["فَمِلآنَ يَثنِ الصَبرُ نَفسِيَ أَو تَمُت","إِذا اِنبَتَّ حَبلٌ مِن حِبالِكِ فَاِنقَضَب",20,"ب",1,0],["فَمِل طَرَباً بَينَ ظِلٍّ هَفا","رَطيبٍ وَماءٍ هُناكَ اِنثَعَب",21,"ب",1,0],["فَمِل عَن طَريقِ شِهابٍ سَرى","فَأَهوى وَوادي أَتِيٍّ حَمَل",22,"ل",1,0],["فَمِلءُ العَينِ قَصرٌ قَد تَراهُ","جَديدَ البابِ داخِلُهُ خَرابُ",23,"ب",1,0],["فَمِل عَن بَني حَوّاءَ مِن نَسلِ آدَمٍ","لِتَنزِلَ بَينَ الحُوِّ وَالأُدمِ وَالعُفرِ",24,"ر",1,0],["فَمَلَّكَ بِاللَيطِ الَّذي تَحتَ قِشرِها","كَغِرقيءِ بَيضٍ كَنَّهُ القَيضُ مِن عَلُ",25,"ل",1,0],["فَمِلنا وَنازَعنا الحَديثَ أَوانِساً","عَلَيهِنَّ جَيشانِيَّةٌ ذاتُ أَغيالِ",26,"ل",1,0],["فمِلْتُ به أَجْتَرُّهُ نَحْوَ جَمْرَةٍ","لها بارِقٌ للضَّيْفِ غَيْرُ يَمانِ",27,"ن",1,0],["فَمِلْنا إِلَى وادٍ كَأَنَّ تِلاعَهُ","مِنَ الْعَصْبِ مَوْشِيُّ الْحَبائِكِ مُذْهَبُ",28,"ب",1,0],["فملت الوصلَ .. والأقمار أمزجةٌ ناريّةٌ .. قلّما وفّتْ بما تعِدُ","أوّاه! سيّدةَ الأقمارِ! سيدتي! أوّاهِ! لو تجد الأقمار ما نجدُ",29,"د",1,0],["فَمَلَكْنَا بذَلك النَّاسَ إذْ ما","مَلكَ المُنْذرُ بنُ ماءِ السًّماءِ",30,"ا",2,1],["فملكك فيها ما أجل جلاله","وسيفك ما أسطى وكفك ما أندا",31,"د",2,0],["فملككم بسليمان بن داود في","الدهر ملك سليمان بن داود",32,"د",1,0],["فم لك تقسو على أمّة","سقتك الوداد مصفّى زلالا",33,"ل",2,0],["فَمٌّ ليس كالمَدعي قولةً","وليس كآخَرَ يَسترحِم",34,"م",1,0],["فَمَلِّكِ المكارمَ القوائدا","تمليكَك الحرائرَ الولائدا",35,"د",2,0],["فملْ طرباً بينَ ظلٍّ هفا","رطيبٍ وماءٍ هناكَ اانثعبْ",36,"ب",1,0],["فَمِل لِكَتَابِ اللهِ والسُّنُّةِ التى","بِها سَالِكٌ المَورِ المُضَلِّلِ مُرتَدَع",37,"ع",1,0],["فملكتَّهُ عنانَ الأمرِ وامتزجتْ","لدى كهولتهِ باللحم والعصبِ",38,"ب",1,0],["فملكتها روحي ومالي ومهجتي","وأصفيتها مني المحبة والودا",39,"د",2,0],["فملكهم من آدم منتظمٌ","إلى المليك الطاهر المستظهرِ",40,"ر",1,0],["فملوكها في الجاهلية أنتمُ","ولأنتم الخلفاءُ في الإيمان",41,"ن",1,0],["فملكك من يلحظ معانيه لم يجد","سوى دفع مكروه وتفريج كربة",42,"ه",1,0],["فملكك يايحيى هو الجر والثنا","إذا كان ملك الظالمين هو الإِثمُ",43,"م",1,0],["فملكك تفريجٌ من الله عنهم","وعنك فشكر الله فرض به حتمُ",43,"م",1,0],["فملا اشتد أَكلُ السيفِ فيهم","وأَعيا خضطبُ حدّيه عِلاجا",44,"ج",2,0],["فَمِلنا إِلى رَحبِ المَباءَةِ ماجِدٍ","عَظيمِ المَقاري غَيرِ جِبسٍ كُنابِثِ",45,"ث",1,0],["فَمِلتُ لِلهَجرِ لا عَن رَغبَةٍ وَرِضىً","لكن أُعدُّ لَدى التَحقيقِ مَهجوراً",46,"ر",2,0],["فملت إلى اليهود رجاء حرّ","أعاشرُ منه مأمونا رشيدا",47,"د",2,0],["فملكت شكر ملدّد","وجمعت أجرك في ثوابه",48,"ب",2,0],["فملكن إحساسي عليّ","فطاف قلبي حولهنّه",49,"ن",2,0],["فملاحةٌ وسماحة وصراحةٌ","ورجاحةٌ بالعقل فاشكر واحمد",50,"د",1,0],["فملكاً نقيل إذا ما كبا","وعرشاً تقيمُ إذا ما انقلب",51,"ب",1,0],["فَمُلِّيتَ عُمْرَكَ ما تابعتْ","لنا بُكَرُ الدَّهْرِ آصالَها",52,"ل",3,0],["فَمُلوكُ الأَرضِ تَنقادُ لَهُ","طاعَةً تَخضَعُ في تيجانِها",53,"ن",3,0],["فَمَلَأنا الدِلاءَ حَتّى عُراها","عَلَقاً بَرَّدَ القُلوب السِقاما",54,"م",2,0],["فملتُ إ