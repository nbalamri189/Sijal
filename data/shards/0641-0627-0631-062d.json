م غيبه النسيان ..... !؟","https://www.poetsgate.com/ViewPoem.aspx?id=190687",""],[5819,"مات الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=215658",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5847,"جمرة الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=1296",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5861,"وَرَجعْتَ!!","https://www.poetsgate.com/ViewPoem.aspx?id=192660",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5943,"يامعذِّبَ مهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=20466",""],[5943,"قصيدة في أعضاء موقع العز أحمد عبد الباقي عاشور رح","https://www.poetsgate.com/ViewPoem.aspx?id=34296",""],[5953,"دع النادبات المعولات على الورى","https://www.poetsgate.com/ViewPoem.aspx?id=93814",""],[5974,"هاج القريض","https://www.poetsgate.com/ViewPoem.aspx?id=215845",""],[5994,"لحن المدى","https://www.poetsgate.com/ViewPoem.aspx?id=184588",""],[5997,"بعثريني","https://www.poetsgate.com/ViewPoem.aspx?id=214249",""],[6070,"الشَّمسُ تَغربُ والضِّياءُ ينادي","https://www.poetsgate.com/ViewPoem.aspx?id=189948",""],[6090,"يا نجم بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170919",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""],[6102,"عَيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182765",""],[6124,"ليل وموعد","https://www.poetsgate.com/ViewPoem.aspx?id=128746",""],[6124,"خانت غنائي","https://www.poetsgate.com/ViewPoem.aspx?id=194521",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""],[6143,"ربما كنت هباء","https://www.poetsgate.com/ViewPoem.aspx?id=33256",""],[6167,"نداء الأمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85478&r=&rc=7",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""],[6268,"عودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82936&r=&rc=22",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["فَاِرحَل وَعُد بِوَديعَةِ ال","رَحمَنِ أَنتَ وَصاحِباك",0,"ك",1,0],["فَارْحَمْ حَشَاكَ وَشَارِكْ","فَتَاكَ فِي تَسْبِيحِهْ",1,"ح",2,0],["فأرحامكم لا تطلبَّنكم فإِنها","عَوَاتمُ لم يهجعْ بليل طليبها",2,"ب",3,0],["فارْحم عداتي فإني قد رحمتهمُ","مما أرى منهمُ في الشامِ حرَّانا",3,"ن",2,0],["فَأَرِحْ بفضلِكَ إنَّ بَحْرَكَ لم يَغِضْ","واظْفَرْ بمَدْحِي إنَّ بحري ما نُزحْ",4,"ح",1,0],["فأَرِحْني من المِطال بإنجا","زٍ وشيكٍ مُحَلِّلٍ عنك حقدي",5,"د",2,0],["فَاِرحَموا اليَومَ عاشِقاً","في يَدِ البَينِ مُرتَهَن",6,"ن",1,0],["فارْحَمْ تَعَاسَتَهُ ونُحْ","مَعَهُ على أَحْلامِهِ",7,"ه",1,0],["فَاِرحَل بِحِفظِ اللَهِ جَلَّ صَنيعُهُ","مُستَعفِياً إِن شِئتَ أَو مَعزولا",8,"ل",2,0],["فَأَرحامُ شِعرٍ يَتَصِلنَ لَدُنَّهُ","وَأَرحامُ مالٍ لا تَني تَتَقَطَّعُ",9,"ع",1,0],["فَاِرحَل فَأَرضُ اللَهِ واسِعَةُ الفَضا","طُولاً وَعَرضاً شَرقُها وَالمَغرِبُ",10,"ب",1,0],["فَاِرحَم شَقِيّاً في هَواكَ فَما","يَبغي وَإِن أَعتَقتَهُ عِتقا",11,"ق",2,0],["فَارْحَمْ شَبَابَ فَتَىً أَلْوَتْ بِنَضْرَتِهِ","أَيْدِي الضَّنَى فَغَدَا لَحْماً عَلَى وَضَمِ",12,"م",1,0],["فَاِرحَمي مُغرَماً بِحُبِّكِ لاقى","مِن جَوى الحُبِّ وَالحَفيظَةِ جَهدا",13,"د",2,0],["فارْحَمْ لبيباً يَوْماً دَعَاكَ وَقد","بَلَّغَتِ الجوع رُوحَهُ اللَّبَّهْ",14,"ب",2,0],["فارْحَمْهُمُ إنْ أَبْصَرُوا كَعْكَةً","في يَدِ طِفْلٍ أَوْ رَأَوْا تَمْرَه",15,"ر",2,0],["فَاِرحَل ذَميماً أَو أَقِم عائِذاً","مُلّيتَ مِن غِلٍّ وَأَدواءِ",16,"ا",2,0],["فأرِحْ مِنْ لَذْعِ عَذْلٍ مِسْمَعَي","وعنِ القلبِ لِتلكَ الرّاء زَي",17,"ي",1,0],["فأرحام شعر يتصلن لدنه","وأرحام مالٍ ماتني تتقطع",18,"ع",1,0],["فَارْحَمْ فُؤَاداً أَنْتَ أَبْلَيْتَهُ","وَمُقْلَةً لَوْلاكَ لَمْ تَأْرَقِ",19,"ق",1,0],["فَارْحَمْ فَدَيْتُكَ صَبَّاً","إِلَى لُقَاكَ يَخِفُّ",20,"ف",1,0],["فارحمي مُغترِباً ليس اسمُه","في رُبا لُبنانَ بالمغترب",21,"ب",1,0],["فأرِحْ فيهِ مِنْ مُبَاشَرَةِ المَجْ","دِ بِلَهْوٍ مِنْ غَيْرِهِ، أوْ سُرُورِ",22,"ر",1,0],["فارحم لترحم واغتنم","اجري وكن للكسر جابر",23,"ر",1,0],["فارحمُوا المبتَلى بكمُ فهو يهوا","كُم ورقُّوا لمن لكم صار رِقّاً",24,"ق",2,0],["فارحَمِى عَاشِقاً عَمِيداً اشجَتهُ","دَارِسَاتُ الأطلاَلِ والآنَاءِ",25,"ا",2,0],["فَاِرحَميهِ إِنَّهُ يَهذي بِكُم","هائِمٌ صَبُّ قَدَ اودى قَلبُهُ",26,"ب",2,0],["فَأَرَحتَهُم بِاليَأسِ مِن ذا المُرتَقى","فَلَهُم نُكوصٌ دونَهُ وَنُدودُ",27,"د",1,0],["فَاِرحَم غَنِيّاً عالَ وَاِرثِ لِتائِهٍ","قَد ضَلَّ وَاِعذِر صَبرَهُ إِن عيلا",28,"ل",2,0],["فارحل كما تشتهي وتهوى","عن اهتبال إلى اهتبال",29,"ل",1,0],["فارحم صبا قد صب الدم","ع على الخدين كما العلق",30,"ق",1,0],["فَاِرحَم أَباكَ فَلو أَبصَرتَ عَبرَتَهُ","وَكُلَّما كَفَّ مِن شأَنٍ لَها وَكَفا",31,"ف",2,0],["فَاِرحَل أَخي راشِداً عَن أَرضِ شاطِبَةٍ","فَما المُقامُ بِها إِلا مِنَ الهونِ",32,"ن",1,0],["فارحم فديتك مدنفا","عدم التجلّد في وجودك",33,"ك",1,0],["فَاِرحمي طيبةُ صبّاً مُغرما","بكِ إن يرجُ اللِقا أو ييأسِ",34,"س",1,0],["فاِرحَل بِعيسٍ لا يرى","فيها لَدى الفلواتِ رابِخ",35,"خ",1,0],["فارحمي فانياً من الوجد يشقى","بغرام مؤجّجٍ غير فان",36,"ن",1,0],["فارحم فديتك مهجةً","أودى بها الحزن العميق",37,"ق",1,0],["فَارحَل تُشَيِّعُكَ الأَرواحُ جازِعَةً","في ذِمَّةِ القَبر بعدَ اللَهِ يا عُمَرُ",38,"ر",1,0],["فَأَرِحني مِن شاغِلِ الهَمِّ وَاِعتِق","مِنهُ رِقّي بِدَنِّ خَمرٍ عَتيقِ",39,"ق",1,0],["فَاِرحَل مَتى آنَستَ ذُلّاً وَلا","يَعتاقُكَ التالِدُ وَالطارِفُ",40,"ف",1,0],["فارحموا عاشقاً عَصَى النصح في الحبِّ","عليكم لما أطاع غرامَه",41,"م",2,0],["فارحمي ضعفي وظرفي","واسألي دمعي السموحِ",42,"ح",1,0],["فأرحني من الهموم براحٍ","تصدر الهم عن موارد صدري",43,"ر",2,0],["فاِرحم مؤلفها عَبد الرَحيم وَكُن","حماه من هم دنياه واحمراه",44,"ا",2,0],["فارحموني ترحموا أنفسكم","واعلموا أنكم في أثرنا",45,"ن",2,0],["فارحمي الناس فللن","اس عيونٌ وقلوب",46,"ب",1,0],["فارحمه يا ظالم","واظلمه يا راحم",47,"ا",3,0],["فارحميه يا ريح من صمته الدا","جى وردى أحلامه للصواب",48,"ب",1,0],["فارحميها لتشرب النور","من ذلك الجبين",49,"ن",1,0],["فَاِرحَم بِحَقِّكَ حرقتي","وَتَولعي بِكَ وَالهِيام",50,"م",1,0],["فارحَمْ فتىً أحبابهُ في قلبه","وإلى وصالٍ لا يُطيقُ وُصولا",51,"ل",2,0],["فارح