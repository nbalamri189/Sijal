{"poems":[[55,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[53,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[101,"ماذا أقول له","https://www.aldiwan.net/poem5882.html","عموديه"],[46,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[33,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[76,"أأدعو فلا تلوي وأنت قريب","https://www.aldiwan.net/poem12861.html","الطويل"],[77,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[50,"أأدميت بالماء القراح جبينها","https://www.aldiwan.net/poem65302.html","الطويل"],[52,"خليلي إن العسر سوف يفيق","https://www.aldiwan.net/poem62322.html","الطويل"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[52,"خليليَّ إنَّ العسرَ سوف يفيقُ","https://www.poetsgate.com/ViewPoem.aspx?id=31086",""],[139,"أأدنو إلى موتتي طائعا","https://www.aldiwan.net/poem48945.html","المتقارب"],[177,"أآدابي على كبري تضاع","https://www.aldiwan.net/poem4391.html","عموديه"],[369,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[556,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137575",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50023","المتقارب"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35705","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101061","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205026","الوافر"],[2969,"","https://poetry.dctabudhabi.ae/diwan/poem/35025","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74212","الطويل"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203627",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108171","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91816","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131230",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5219,"يا مدعي الحب","https://www.poetsgate.com/ViewPoem.aspx?id=193970",""],[5273,"وعود بالهجران","https://www.poetsgate.com/ViewPoem.aspx?id=59180",""],[5277,"مدرسةُ العظام","https://www.poetsgate.com/ViewPoem.aspx?id=194482",""],[5956,"إني لَأجثو فوق قبرك شاكراً","https://www.poetsgate.com/ViewPoem.aspx?id=193484",""],[5964,"أجدك ما ينفك طيفك سارياً","https://www.poetsgate.com/ViewPoem.aspx?id=181301",""]],"verses":[["أَأَدَعُ الدُنيا وَلَم تَدَعني","يَلعَبُ بي عَناؤُها المُعَنّي",0,"ن",2,0],["أَأُدرِكُ مِن أُمِّ الحكيِّمِ غبطَةً","بِها خَبَّرَتني الطَيرُ أَم قَد أَنى لَها",1,"ل",3,0],["أأدعو لِغوْثي قاسماً وعزيمتي","فتُغْني ولا يُغْني ندَى كفِّهِ الغمر",2,"ر",1,0],["أَأَدهَمُ هَكَذا تُقنى المَعالي","وَتُقنى بِالقَواضِبِ وَالعَوالي",3,"ا",3,0],["أأدعي أنني أصبحت أكرهه؟","وكيف أكره من في الجفن سكناه؟",4,"ا",2,0],["أَإِدريسُ ضاعَ المَجدُ بَعدَكَ كُلُّهُ","وَرَأيُ الَّذي يَرجوهُ بَعدَكَ أَضيَعُ",5,"ع",1,0],["أَأَدنَيتَها ثُمَّ جانَبتَها","فَسَوفَ تَرى غِبَّ إِدنائِكا",6,"ك",2,0],["أَأَدعو فَلا تَلوي وَأَنتَ قَريبُ","وَأَشكو فَلا تُشكي وَأَنتَ طَبيبُ",7,"ب",1,1],["أأدعو إلهي بالسّعادةِ عندكُمْ","وأنتم دَراريُّ السعود التي تَسري",8,"ر",2,0],["أَأَدمَيتَ بِالماءِ القَراحِ جَبينَها","لِتَسمَعَ في صَحنِ الزُجاجِ أَنينَها",9,"ن",3,1],["أََأََدماءُ لا أَسطيعُ في قِلَّةِ الثَرا","خُزوراً وَوَشياً وَالقَليلُ مُحيقُ",10,"ق",1,0],["أَأَدلَلتِ بِما عِندي","مِنَ الشَوقِ فَأُقصيتُ",11,"ت",1,0],["أأدماءُ لا أستطيعُ في قلة الثرا","خزوزاً ووشياً والقليلُ محيقُ",12,"ق",1,0],["أأدنو إلى موتتي طائعاً","وألقى بنفسي إلى التهلكهْ",13,"ه",1,1],["أآدَابِي عَلَى كِبَرِي تُضَاعُ","وَعَرفُ المِسكِ مِن نَثرِي يُذَاعُ",14,"ع",1,1],["أأدنَيْتَني حتّى إذا ما ملكْتَني","صدَدتَ وعندي زَفْرةٌ ونَحيب",15,"ب",1,0],["أَأَدنو إِليك بمحض الوِداد","وتبعُدُ عنّي وداداً وَدارا",16,"ر",2,0],["أأدرك أحكام رب السماء","وهاتيك أخفى بغير مراء",17,"ا",2,0],["أَأَدهى وأَكيس ممَّن يساوي","على الوجه بشراً وفي الصّدر غِلاّ",18,"ل",2,0],["أَأَدهَنُ رَأسي أَو تَضاعَفُ كِسوَتي","وَرَأسُكَ مَعفورٌ وَأَنتَ سَليبُ",19,"ب",1,1],["أإدريس إنا وفدها فيك نازلاً","كبير الأماني راجح الحق في الوزن",20,"ن",1,0],["أإدريس إن كانت لضيفٍ كرامة","لديك فضيف النيل أبلغ من يثني",20,"ن",2,0],["أإدريس إن تدني العدالة وافداً","عليك فأهل النيل أكرم من تدنى",20,"ن",2,0],["أإدريس كم للنيل عندك من يد","تناقلها التاريخ قرناً إلى قرن",20,"ن",1,0],["أأديب أم شاعر أم حكيم","أم مغن له من الجن نغمه",21,"م",2,0],["أأدفع لؤمه عني بلؤم","إذن أنا مثله جان أثيم",22,"م",1,0],["أَأَدرَكَكَ الحِمامُ وَأَنتَ سارٍ","وَكُلُّ فَتىً لِمَصرَعِهِ حمامُ",23,"م",1,0],["أَأَدخل مِن باب السَلام عَشية","إِلى حَرَم فيهِ العُقوق محرم",24,"م",1,0],["أأدرت خمراً في كؤو","سك هذه أم سم صل؟",25,"ل",1,0],["أإِدي تحرمنا المنام وتبتغي","لعيوننا وسن العيون النوم",26,"م",1,0],["أَأَدعو رِجالاً لَيسَ مثلي يؤمّهم","بَدَوا مثلَ أَفعى أُلبِست ريشَ طاووس",27,"س",1,0],["أآدم ما بنوك سوى ضوارٍ","فشأنهم اعتداءٌ واغتيال",28,"ل",1,0],["أأدنو كي أراك على يقين","وأبصر ما وراءك من وئام",29,"م",1,0],["أ أدعي عجبا ؟ سلوان من غرست","في خافقي أبدا سهما فأرداه",30,"ا",2,0],["أأدنو ؟ إنْ دنوتُ يكونُ بعداً","وكم في القربِ قد تمسي قصيّا",31,"ي",2,0],["أأدعو غيره كلا فربّي","له الاخلاص َحتمٌ للتمام",32,"م",1,0],["أ أ دق بابك ثم يفتح نجلُكمْ","عمّارُ لي ماذا جرى مات الألى..؟",33,"ل",2,0],["أأدخل تحت الضيم والبيد والسرى","وأيدي المطايا الناعجات عتاديا؟",34,"ي",2,0]]}