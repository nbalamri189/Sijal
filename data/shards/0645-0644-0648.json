m60657.html","المتقارب"],[364,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[364,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[364,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[364,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[400,"يا مسجد الإسراء","https://www.aldiwan.net/poem6713.html","عموديه"],[400,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[403,"خلعت ردا التشبيب عن منكب الفكر","https://www.aldiwan.net/poem33905.html","الطويل"],[406,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[406,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[409,"مل وأبدى تجهم السأم","https://www.aldiwan.net/poem32538.html","المنسرح"],[441,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[443,"عفوت حتى لا أريد العتاب","https://www.aldiwan.net/poem56002.html","عموديه"],[458,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[458,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[458,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[458,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[458,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[461,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[477,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[486,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[514,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[515,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[515,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[515,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[515,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[515,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[515,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[515,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[515,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[529,"ما نظرت عيناي كالأهجر","https://www.aldiwan.net/poem37381.html","السريع"],[551,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[558,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[575,"ملوك يحوزون الممالك عنوة","https://www.aldiwan.net/poem3108.html","الطويل"]],"verses":[["مُلوكٌ وَإِخوانٌ كَأَنِّيَ بَعدَهُم","عَلى قُرَبٍ مِن خِمسِ يَومٍ عَمَرَّدِ",0,"د",1,0],["مُلوكٌ إذا اسْتَلّوا الظُّبا استَنْهَضَ الرّدى","صَوارِمُ دبّتْ فوقَهُنَّ نِمالُ",1,"ل",1,0],["مُلوكٌ دَأبُهُم شَرَفٌ وَمَجدٌ","وَدَأبُ سِواهُم طَرَبٌ وَكاسُ",2,"س",1,0],["مُلوكٌ يُرى أَحياؤُهُم فَخرَ دَهرِهِم","وَيَخلُفُ مَوتاهُم ثَناءٌ مُخَلَّفُ",3,"ف",1,0],["مُلوكٌ لَبِسنا الدَهرَ في جَنَباتِهِم","رَقيقَ الحَواشي مِثلَما فُوِّفَ البُردُ",4,"د",1,0],["مُلوكُ بَني العَبّاسِ في الكُتبِ سَبعَةٌ","وَلَم تَأتِنا عَن ثامِنٍ لَهُمُ كُتبُ",5,"ب",1,0],["ملؤوا الشارع الكبير لأمر","في كبير العقول غير كبير",6,"ر",1,0],["ملوك على كل الملوك ثلاثة","لها الحكم دون الناس في الفتق والرتق",7,"ق",1,0],["مُلوكٌ وَأَخوالُ المُلوكِ وَفيهِمُ","غُيوثُ الحَيا يُحيِ البِلادَ مَطيرُها",8,"ر",3,0],["مُلوكاً عَلى الناسِ لَم يُملَكوا","مِنَ الدَهرِ يَوماً كَحِلِّ القَسَم",9,"م",1,0],["مُلوكٌ وَأَبناءُ المُلوكِ كَأَنَّنا","سَواري نُجومٍ طالِعاتٍ بِمَشرِقِ",10,"ق",1,0],["مُلوكٌ وَأَبناءُ المُلوكِ إِذا اِنتَشَوا","أَهانوا الصَبوحَ وَالسَديفَ المُسَرهَدا",11,"د",2,0],["ملوك إذا قام الزمان لمفخرٍ","غدا بليالي ملكهم متجمّلا",12,"ل",2,0],["ملوّز الطرف أهلاً","كل الحلا إن تحلى",13,"ل",2,1],["ملوكيٌّ بعيد الرأ","ي من زيغ ومن عَثر",14,"ر",1,0],["مُلوكٌ وَأَحكامٌ وَأَصحابُ نَجدَةٍ","إِذا شوغِبوا كانوا عَلَيها أُلي شَغبِ",15,"ب",1,0],["مَلولٌ لا يَدومُ عَلى وَلاءٍ","وَلَكِن لا يَدومُ عَلى عِداءِ",16,"ا",2,0],["مُلوكُ الدَهرِ بِالوادي أَقاموا","عَلى وادي المُلوكِ مُحَجَّبينا",17,"ن",2,0],["مَلَؤوا الدُنيا عَلى قِلَّتِهِم","وَقَديماً مُلِئَت بِالمُرسَلين",18,"ن",1,0],["مَلولَةٌ ما يَدومُ لَيسَ لَها","مِن مَلَلٍ دائِمٍ بِها مَلَلُ",19,"ل",1,0],["مَلومُكُما يَجِلُّ عَنِ المَلامِ","وَوَقعُ فَعالِهِ فَوقَ الكَلامِ",20,"م",1,1],["ملوكٌ همُ حاطُوا الخِلافةَ بعدَما","تهضَّمها أعداؤُها وتنوَّخُوا",21,"خ",3,0],["مُلوكٌ لَهُم عادَةٌ في القِرى","تَوارَثَها حَسَبٌ عَن حَسَب",22,"ب",1,0],["مُلوكٌ تَوَلّى صاعِدٌ إِرثَ فَخرِها","وَشارَكَها في مُعلِياتِ اِنتِسابِها",23,"ب",3,0],["مَلومٌ عَلى بَذلِ التِلادِ مُفَنَّدٌ","وَلا مَجدَ إِلّا لِلمَلومِ المُفَنَّدِ",24,"د",1,0],["مُلوكٌ وَساداتٌ عِظامٌ جُدودُهُم","وَأَخوالُهُ مِن أَمجَدينَ أَشاوِسِ",25,"س",1,0],["مُلوكٌ إِذا اِلتَفَّت عَلَيهِم مُلِمَّةٌ","رَأَيتُهُمُ فيها أَضَرَّ وَأَنفَعا",26,"ع",2,0],["مُلوكٌ يَعُدّونَ الرِماحَ مَخاصِراً","إِذا زَعزَعوها وَالدُروعَ غَلائِلا",27,"ل",2,0],["مُلوكٌ يَبتَنونَ تَوارَثوها","سُرادِقَها المُقاوِلُ وَالقِبابا",28,"ب",2,0],["مُلوكٌ تَسوسُ المُسلِمينَ وَغَيرَهُم","إِذا أَنكَرَت كانَت شَديداً نَكيرُها",29,"ر",3,0],["مُلوكٌ لُهُم ميراثُ كُلِّ مَشورَةٍ","وَبِاللَهِ طاوي الأَمرِ مِنهُم وَناشِرُه",30,"ر",2,0],["مُلوكٌ وَأَبناءُ المُلوكِ وَسادَةٌ","لَهُم سُؤدَدٌ عَودٌ عَلى الناسِ قاهِرُ",31,"ر",1,0],["مُلوكٌ وَأَبناءُ المُلوكِ أَتَتهُمُ","مِنَ اللَهِ بِالفُرقانِ مِنهُ رَسائِلُه",32,"ل",2,0],["مُلوكٌ تَرى الأَقوامَ يَتَّبِعونَنا","إِلَينا اِنتَهَت حاجاتُها وَرَجيلُها",33,"ل",3,0],["مُلوكٌ إِذا طَمَّت عَلَيكَ بُحورُها","تَطَحطَحتَ في آذِيِّها المُتَصادِمِ",34,"م",1,0],["مُلُوكُهُمُ حَلْيُ المدائحِ ما اكتسوا","حَلاها وثغرُ المجدِ إمّا تبسَّما",35,"م",2,0],["ملوكٌ لا يَمَلُّون العَطايا","ولا يأبَون في الرَّوعِ النِّزالا",36,"ل",2,0],["مَلُومٌ ويخضَعُ بعدَ المَلامِ","فيلذَعُ لَوْماً ويأسو خُضُوعا",37,"ع",2,0],["ملوكٌ إذا الأيامُ دامَت رماحُهم","حَسِبتَهم الأيامَ صَدراً ومَنكِبا",38,"ب",2,0],["ملوكٌ ذُلَّلَت بهمُ رقابٌ","كما عزَّت بعزِّهِمُ رقابُ",39,"ب",1,0],["مُلوكاً حَذَوا في الجودِ حَذوَ أَبيهِمُ","فَفي كُلِّ وَصفٍ مِن نَداهُ لَهَم قِسمُ",40,"م",1,0],["مُلوكٌ إِذاّ أَلقى الزَمانُ حِبالَهُ","جَعَلتُهُمُ في كُلِّ نائِبَةٍ ذُخري",41,"ي",1,0],["مُلوكٌ بِهِم ظَلَّ","وادي حَماه",42,"ه",1,0],["مُلوكٌ لَهُم شَرَفٌ آخَرٌ","يُخَبَّرُ عَن شَرَفٍ أَوَّلِ",43,"ل",1,0],["مَلْوِيَّةٌ فِي جِيدِهَا الْعَثَاكِلُ","مَعْقُودَةٌ فِي رَأْسِهَا الْفَلائِلُ",44,"ل",1,0],["مَلولٌ لِمَن يَهواكَ مُستَطرِفُ الهَوى","أَخو شَهَواتٍ تَبذُلُ المَذقَ وَالنَزرا",45,"ر",2,0],["مُلوكَ الكِنانَةِ سيروا بِها","فَقَد نَشَطَت بَعدَ طولِ المَلَلْ",46,"ل",1,0],["مُلوكٌ وَأَبطالٌ يَروعُكَ مِنهُمو","شِهابُ الوَغى سَعدٌ وَصاحِبُهُ عَمرُو",47,"ر",2,0],["ملُّوا الحياةَ وملّتهم معاقلُهم","كلٌّ بغيضٌ وكلٌّ بعدُ مملول",48,"ل",1,0],["مُلوكٌ أَصابَتها مُلوكٌ بِحَقِّها","وَما بيعَ آجالٌ لَها إِذ أُطِلَّتِ",49,"ت",1,0],["مَلّوا قِراهُ وَهَرَّتهُ كِلابُهُمُ","وَجَرَّحوهُ بِأَنيابٍ وَأَضراسِ",50,"س",1,0],["مُلوكٌ إِذا خاضوا الوَغى فَسُيوفُهُم","مَقابِضُها مِسكٌ وَسائِرُها دَمُ",51,"م",1,0],["مُلوكٌ وَإِخوانٌ تَرى بِسَماحِهِم","مِنَ البِشرِ في ديباجِ أَوجُهِهِم طَرزا",52,"ز",2,0],["مُلوكٌ لِلَذّاتِ الشَبابِ تَواضَعوا","وَلَم يَحلِفوا فيها بِذَمٍّ وَلا حَمدِ",53,"د",1,0],["مَلؤوا البيوتَ بِمالِهِ ولوِ اشْتَكَى","مَلؤوا بِأَوْلادِ الحَزِينِ حُبُوسا",54,"س",2,0],["مُلُوكُ المُلوِك وأبنْاؤهَا","وفوْقَ الهَوادي تكونُ القِمَم",55,"م",1,0],["مُلوكُ القَريَتَينِ تَنازَعَتهُ","وَأَخلاقٌ تَسودُ وَلا تُسادُ",56,"د",1,0],["مُلوكٌ إِذا هابَ العَطاءَ مَعاشِرٌ","وَضَربَ الطُلى سَنّوهُما وَتَعَجَّبوا",57,"ب",3,0],["مُلوكٌ وَإِخوانٌ إِذا ما أَتَيتُهُم","أُحَكَّمُ في أَموالِهِم وَأُقَرَّبُ",58,"ب",1,0],["مُلوكُنا الصالِحونَ كُلُّهُم","زيرُ نِساءٍ يَهَشُّ لِلزِيَرَه",59,"ر",2,0],["ملونة وَلَيسَ هناك صبغ","بألوان حوت كل البهاء",60,"ا",2,0],["ملوّحات بأذرُعٍ عَجَبٍ","تحذرهنّ النهودُ والشّعْرُ",61,"ر",1,0],["ملؤها الخمرةُ نوراً وشذاً","نَسَمَتْ وائتلقتْ فخَّارتاها",62,"ا",3,0],["مُلُوكُ الضَّادِ وَالرُّؤَسَاءُ حَلُّوا","ضُيُوفاً فِي رِحَابِ مَلِيكِ مِصْرِ",63,"ر",1,0],["مُلوكُ هَاشِمَ فَخْرُ الضَّاد مِنْ قِدَمٍ","فِي كُلِّ مَمْلَكَةٍ قَدْ شَرَّفوا الضَّادا",64,"د",2,0],["مُلوك فَضل عَليهُمُ حلل","بِنَسج العُلا وَالوَقار تيجانُ",65,"ن",1,0],["ملوك ملوك الالمين بأسرهم","وعلة عليا دولة الملة الغرا",66,"ر",2,0],["ملولةٌ ما لها عهدٌ يدوم لها","يوماً وليس لها عهدٌ وإيفاءُ",67,"ا",2,0],["مُلوكٌ تَوارَثُ في مُلكِها","وَأَفعالُها العُرفُ مَجداً تَليدا",68,"د",2,0],["ملوم على بذل البضائع في الندى","وما تاجرٌ في المكرُمات بخاسِر",69,"ر",1,0],["مُلوكٌ أَمَّنوا خَيلي وَرَجلي","مُكابَدَةَ الهَواجِرِ وَالهَواجِل",70,"ل",1,0],["ملوكَ الورى والدهر طفلٌ وفهيم","تربى صغيراً غير زاكٍ وزاكيا",71,"ي",2,0],["ملوك تربى الدهر في حصن ملكهم","فهم هو محصون ملوك البسيطة",72,"ه",1,0],["ملوك وزنا الالف منهم بواحد","فخفوا ولم نحصى بوزن خصاله",73,"ل",2,0],["مُلوكُ نِزارٍ قَبلَ عادٍ وَتُبَّعٍ","وَكَعبَتُها اللّاتي إِلَيها مَثابُها",74,"ب",3,0],["مُلوكٌ هُمُ الشُمُّ الرَواسي رَزانَةً","إِذا ما اِستَخَفَّ الحِلمَ حَقٌّ وَباطِلُ",75,"ل",1,0],["مُلُوكٌ هُمُ أَردُوا لَبيداً وَغادَرَت","صُدورُ قَناهُم تُبَّعاً يَتَمَلمَلُ",76,"ل",1,0],["ملوخيَّةٌ سَبَقتْ وقْتَها","وجاءت كهيئةِ خُضْر الزَّغَب",77,"ب",1,0],["ملوك لهم الأرض","فمن غور إلى تحد",78,"د",1,0],["مُلوكٌ يَرَونَ العَدلَ حَقّاً عَلَيهِم","حِسانُ الوِجوهِ يَهتَدي بِهِم العَمي",79,"م",2,0],["مُلوكٌ يُقاضونَ النُفوسَ إِلى السَما","وَيَنهي بِأَيديهِم ضَميرٌ مدوّدُ",80,"د",1,0],["مَلولٌ كُلَّما أَرخَصتُ مِنّي","دُموعي رَغبَةً فيهِ تَغالا",81,"ل",2,0],["مَلولٌ يُريني جَنّ