://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[6093,"أيِّيْ وأيُّكِ إنْ قامَ الهَوى نَكَلا","https://www.poetsgate.com/ViewPoem.aspx?id=177625",""],[6152,"انت امبراطوري","https://www.poetsgate.com/ViewPoem.aspx?id=204954",""],[520,"مل وقد ملت الى وداده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577475",""],[2588,"شاخصة (حجر طفل)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65632&r=&rc=64",""],[6259,"ألمتْ ودوني من تهامة بيدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59367&r=&rc=15",""],[4222,"بملك مصر أهني مالك الأمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52891&r=&rc=183",""]],"verses":[["مُلوكٌ وَإِخوانٌ كَأَنِّيَ بَعدَهُم","عَلى قُرَبٍ مِن خِمسِ يَومٍ عَمَرَّدِ",0,"د",1,0],["مُلوكٌ إذا اسْتَلّوا الظُّبا استَنْهَضَ الرّدى","صَوارِمُ دبّتْ فوقَهُنَّ نِمالُ",1,"ل",1,0],["مُلوكٌ دَأبُهُم شَرَفٌ وَمَجدٌ","وَدَأبُ سِواهُم طَرَبٌ وَكاسُ",2,"س",1,0],["مُلوكٌ يُرى أَحياؤُهُم فَخرَ دَهرِهِم","وَيَخلُفُ مَوتاهُم ثَناءٌ مُخَلَّفُ",3,"ف",1,0],["مُلوكٌ لَبِسنا الدَهرَ في جَنَباتِهِم","رَقيقَ الحَواشي مِثلَما فُوِّفَ البُردُ",4,"د",1,0],["مُلوكُ بَني العَبّاسِ في الكُتبِ سَبعَةٌ","وَلَم تَأتِنا عَن ثامِنٍ لَهُمُ كُتبُ",5,"ب",1,0],["ملؤوا الشارع الكبير لأمر","في كبير العقول غير كبير",6,"ر",1,0],["ملوك على كل الملوك ثلاثة","لها الحكم دون الناس في الفتق والرتق",7,"ق",1,0],["مُلوكٌ وَأَخوالُ المُلوكِ وَفيهِمُ","غُيوثُ الحَيا يُحيِ البِلادَ مَطيرُها",8,"ر",3,0],["مُلوكاً عَلى الناسِ لَم يُملَكوا","مِنَ الدَهرِ يَوماً كَحِلِّ القَسَم",9,"م",1,0],["مُلوكٌ وَأَبناءُ المُلوكِ كَأَنَّنا","سَواري نُجومٍ طالِعاتٍ بِمَشرِقِ",10,"ق",1,0],["مُلوكٌ وَأَبناءُ المُلوكِ إِذا اِنتَشَوا","أَهانوا الصَبوحَ وَالسَديفَ المُسَرهَدا",11,"د",2,0],["ملوك إذا قام الزمان لمفخرٍ","غدا بليالي ملكهم متجمّلا",12,"ل",2,0],["ملوّز الطرف أهلاً","كل الحلا إن تحلى",13,"ل",2,1],["ملوكيٌّ بعيد الرأ","ي من زيغ ومن عَثر",14,"ر",1,0],["مُلوكٌ وَأَحكامٌ وَأَصحابُ نَجدَةٍ","إِذا شوغِبوا كانوا عَلَيها أُلي شَغبِ",15,"ب",1,0],["مَلولٌ لا يَدومُ عَلى وَلاءٍ","وَلَكِن لا يَدومُ عَلى عِداءِ",16,"ا",2,0],["مُلوكُ الدَهرِ بِالوادي أَقاموا","عَلى وادي المُلوكِ مُحَجَّبينا",17,"ن",2,0],["مَلَؤوا الدُنيا عَلى قِلَّتِهِم","وَقَديماً مُلِئَت بِالمُرسَلين",18,"ن",1,0],["مَلولَةٌ ما يَدومُ لَيسَ لَها","مِن مَلَلٍ دائِمٍ بِها مَلَلُ",19,"ل",1,0],["مَلومُكُما يَجِلُّ عَنِ المَلامِ","وَوَقعُ فَعالِهِ فَوقَ الكَلامِ",20,"م",1,1],["ملوكٌ همُ حاطُوا الخِلافةَ بعدَما","تهضَّمها أعداؤُها وتنوَّخُوا",21,"خ",3,0],["مُلوكٌ لَهُم عادَةٌ في القِرى","تَوارَثَها حَسَبٌ عَن حَسَب",22,"ب",1,0],["مُلوكٌ تَوَلّى صاعِدٌ إِرثَ فَخرِها","وَشارَكَها في مُعلِياتِ اِنتِسابِها",23,"ب",3,0],["مَلومٌ عَلى بَذلِ التِلادِ مُفَنَّدٌ","وَلا مَجدَ إِلّا لِلمَلومِ المُفَنَّدِ",24,"د",1,0],["مُلوكٌ وَساداتٌ عِظامٌ جُدودُهُم","وَأَخوالُهُ مِن أَمجَدينَ أَشاوِسِ",25,"س",1,0],["مُلوكٌ إِذا اِلتَفَّت عَلَيهِم مُلِمَّةٌ","رَأَيتُهُمُ فيها أَضَرَّ وَأَنفَعا",26,"ع",2,0],["مُلوكٌ يَعُدّونَ الرِماحَ مَخاصِراً","إِذا زَعزَعوها وَالدُروعَ غَلائِلا",27,"ل",2,0],["مُلوكٌ يَبتَنونَ تَوارَثوها","سُرادِقَها المُقاوِلُ وَالقِبابا",28,"ب",2,0],["مُلوكٌ تَسوسُ المُسلِمينَ وَغَيرَهُم","إِذا أَنكَرَت كانَت شَديداً نَكيرُها",29,"ر",3,0],["مُلوكٌ لُهُم ميراثُ كُلِّ مَشورَةٍ","وَبِاللَهِ طاوي الأَمرِ مِنهُم وَناشِرُه",30,"ر",2,0],["مُلوكٌ وَأَبناءُ المُلوكِ وَسادَةٌ","لَهُم سُؤدَدٌ عَودٌ عَلى الناسِ قاهِرُ",31,"ر",1,0],["مُلوكٌ وَأَبناءُ المُلوكِ أَتَتهُمُ","مِنَ اللَهِ بِالفُرقانِ مِنهُ رَسائِلُه",32,"ل",2,0],["مُلوكٌ تَرى الأَقوامَ يَتَّبِعونَنا","إِلَينا اِنتَهَت حاجاتُها وَرَجيلُها",33,"ل",3,0],["مُلوكٌ إِذا طَمَّت عَلَيكَ بُحورُها","تَطَحطَحتَ في آذِيِّها المُتَصادِمِ",34,"م",1,0],["مُلُوكُهُمُ حَلْيُ المدائحِ ما اكتسوا","حَلاها وثغرُ المجدِ إمّا تبسَّما",35,"م",2,0],["ملوكٌ لا يَمَلُّون العَطايا","ولا يأبَون في الرَّوعِ النِّزالا",36,"ل",2,0],["مَلُومٌ ويخضَعُ بعدَ المَلامِ","فيلذَعُ لَوْماً ويأسو خُضُوعا",37,"ع",2,0],["ملوكٌ إذا الأيامُ دامَت رماحُهم","حَسِبتَهم الأيامَ صَدراً ومَنكِبا",38,"ب",2,0],["ملوكٌ ذُلَّلَت بهمُ رقابٌ","كما عزَّت بعزِّهِمُ رقابُ",39,"ب",1,0],["مُلوكاً حَذَوا في الجودِ حَذوَ أَبيهِمُ","فَفي كُلِّ وَصفٍ مِن نَداهُ لَهَم قِسمُ",40,"م",1,0],["مُلوكٌ إِذاّ أَلقى الزَمانُ حِبالَهُ","جَعَلتُهُمُ في كُلِّ نائِبَةٍ ذُخري",41,"ر",2,0],["مُلوكٌ بِهِم ظَلَّ","وادي حَماه",42,"ه",1,0],["مُلوكٌ لَهُم شَرَفٌ آخَرٌ","يُخَبَّرُ عَن شَرَفٍ أَوَّلِ",43,"ل",1,0],["مَلْوِيَّةٌ فِي جِيدِهَا الْعَثَاكِلُ","مَعْقُودَةٌ فِي رَأْسِهَا الْفَلائِلُ",44,"ل",1,0],["مَلولٌ لِمَن يَهواكَ مُستَطرِفُ الهَوى","أَخو شَهَواتٍ تَبذُلُ المَذقَ وَالنَزرا",45,"ر",2,0],["مُلوكَ الكِنانَةِ سيروا بِها","فَقَد نَشَطَت بَعدَ طولِ المَلَلْ",46,"ل",1,0],["مُلوكٌ وَأَبطالٌ يَروعُكَ مِنهُمو","شِهابُ الوَغى سَعدٌ وَصاحِبُهُ عَمرُو",47,"ر",2,0],["ملُّوا الحياةَ وملّتهم معاقلُهم","كلٌّ بغيضٌ وكلٌّ بعدُ مملول",48,"ل",1,0],["مُلوكٌ أَصابَتها مُلوكٌ بِحَقِّها","وَما بيعَ آجالٌ لَها إِذ أُطِلَّتِ",49,"ت",1,0],["مَلّوا قِراهُ وَهَرَّتهُ كِلابُهُمُ","وَجَرَّحوهُ بِأَنيابٍ وَأَضراسِ",50,"س",1,0],["مُلوكٌ إِذا خاضوا الوَغى فَسُيوفُهُم","مَقابِضُها مِسكٌ وَسائِرُها دَمُ",51,"م",1,0],["مُلوكٌ وَإِخوانٌ تَرى بِسَماحِهِم","مِنَ البِشرِ في ديباجِ أَوجُهِهِم طَرزا",52,"ز",2,0],["مُلوكٌ لِلَذّاتِ الشَبابِ تَواضَعوا","وَلَم يَحلِفوا فيها بِذَمٍّ وَلا حَمدِ",53,"د",1,0],["مَلؤوا البيوتَ بِمالِهِ ولوِ اشْتَكَى","مَلؤوا بِأَوْلادِ الحَزِينِ حُبُوسا",54,"س",2,0],["مُلُوكُ المُلوِك وأبنْاؤهَا","وفوْقَ الهَوادي تكونُ القِمَم",55,"م",1,0],["مُلوكُ القَريَتَينِ تَنازَعَتهُ","وَأَخلاقٌ تَسودُ وَلا تُسادُ",56,"د",1,0],["مُلوكٌ إِذا هابَ العَطاءَ مَعاشِرٌ","وَضَربَ الطُلى سَنّوهُما وَتَعَجَّبوا",57,"ب",3,0],["مُلوكٌ وَإِخوانٌ إِذا ما أَتَيتُهُم","أُحَكَّمُ في أَموالِهِم وَأُقَرَّبُ",58,"ب",1,0],["مُلوكُنا الصالِحونَ كُلُّهُم","زيرُ نِساءٍ يَهَشُّ لِلزِيَرَه",59,"ر",2,0],["ملونة وَلَيسَ هناك صبغ","بألوان حوت كل البهاء",60,"ا",2,0],["ملوّحات بأذرُعٍ عَجَبٍ","تحذرهنّ النهودُ والشّعْرُ",61,"ر",1,0],["ملؤها الخمرةُ نوراً وشذاً","نَسَمَتْ وائتلقتْ فخَّارتاها",62,"ا",3,0],["مُلُوكُ الضَّادِ وَالرُّؤَسَاءُ حَلُّوا","ضُيُوفاً فِي رِحَابِ مَلِيكِ مِصْرِ",63,"ر",1,0],["مُلوكُ هَاشِمَ فَخْرُ الضَّاد مِنْ قِدَمٍ","فِي كُلِّ مَمْلَكَةٍ قَدْ شَرَّفوا الضَّادا",64,"د",2,0],["مُلوك فَضل عَليهُمُ حلل","بِنَسج العُلا وَالوَقار تيجانُ",65,"ن",1,0],["ملوك ملوك الالمين بأسرهم","وعلة عليا دولة الملة الغرا",66,"ر",2,0],["ملولةٌ ما لها عهدٌ يدوم لها","يوماً وليس لها عهدٌ وإيفاءُ",67,"ا",2,0],["مُلوكٌ تَوارَثُ في مُلكِها","وَأَفعالُها العُرفُ مَجداً تَليدا",68,"د",2,0],["ملوم على بذل البضائع في الندى","وما تاجرٌ في المكرُمات بخاسِر",69,"ر",1,0],["مُلوكٌ أَمَّنوا خَيلي وَرَجلي","مُكابَدَةَ الهَواجِرِ وَالهَواجِل",70,"ل",1,0],["ملوكَ الورى والدهر طفلٌ وفهيم","تربى صغيراً غير زاكٍ وزاكيا",71,"ي",2,0],["ملوك تربى الدهر في حصن ملكهم","فهم هو محصون ملوك البسيطة",72,"ه",1,0],["ملوك وزنا الالف منهم بواحد","فخفوا ولم نحصى بوزن خصاله",73,"ل",2,0],["مُلوكُ نِزارٍ قَبلَ عادٍ وَتُبَّعٍ","وَكَعبَتُها اللّاتي إِلَيها مَثابُها",74,"ب",3,0],["مُلوكٌ هُمُ الشُمُّ الرَواسي رَزانَةً","إِذا ما اِستَخَفَّ الحِلمَ حَقٌّ وَباطِلُ",75,"ل",1,0],["مُلُوكٌ هُمُ أَردُوا لَبيداً وَغادَرَت","صُدورُ قَناهُم تُبَّعاً يَتَمَلمَلُ",76,"ل",1,0],["ملوخيَّةٌ سَبَقتْ وقْتَها","وجاءت كهيئةِ خُضْر الزَّغَب",77,"ب",1,0],["ملوك لهم الأرض","فمن غور إلى تحد",78,"د",1,0],["مُلوكٌ يَرَونَ العَدلَ حَقّاً عَلَيهِم","حِسانُ الوِجوهِ يَهتَدي بِهِم العَمي",79,"م",2,0],["مُلوكٌ يُقاضونَ النُفوسَ إِلى السَما","وَيَنهي بِأَيديهِم ضَميرٌ مدوّدُ",80,"د",1,0],["مَلولٌ كُلَّما أَرخَصتُ مِنّي","دُموعي رَغبَةً فيهِ تَغالا",81,"ل",2,0],["مَلولٌ يُريني جَنَّةَ الخُلدِ وَصله","وَهِجرانُهُ جَمرُ اللَظى كَيفَ يَحرِقُ",82,"ق",1,0],["مُلوكٌ جُلَّهم مُغرىً بظلم","وَمَشغولٌ بُلَهوٍ أَو بُراح",83,"ح",1,0],["ملُوكٌ بِهَا ليلٌ كِرام أَعِزَّةٌ","لَهُمْ شِيَمٌ مَرْضِيَّةٌ ومَنَازِعُ",84,"ع",1,0],["مُلوكٌ أَجاروا عَلى دَهرِهِم","وَبَذَّت أَياديهِمُ مَن سِواها",85,"ا",3,0],["مُلوكٌ بَنَوا شَرَفاً باذِخاً","فَقَد شُيِّدَت بِالمَعالي بُناها",85,"ا",3,0],["مُلوكُ الأَرضِ كُلُّهُم نِظامُ ال","فِرِندِ وَأَنتَ واسِطَةُ المُنَظَّم",86,"م",1,0],["مُلوكُ الأَرضِ مَأمومونَ كُلٌّ","مُصَلٍّ خَلفَه