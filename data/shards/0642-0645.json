النر","https://www.poetsgate.com/ViewPoem.aspx?id=29565",""],[32,"رمى الله، في عيني بثينة َ، بالقذى","https://www.poetsgate.com/ViewPoem.aspx?id=15917",""],[88,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""],[85,"لك في الأرض والسماءِ مآتمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9626&r=&rc=116",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""],[61,"أَمِنَ العيونِ ترومُ فَقْدَ عَنائِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59468&r=&rc=1",""]],"verses":[["قُمتَ قِيامَ الرُمحِ في نُصرَتي","مُرافِدَ اللِهذَمِ بِالعامِلِ",0,"ل",1,0],["قُمتَ عَنها بَعدَما عَجَّ بِها","وَرَمى أَوسُقَها بُزلُ الجِمالِ",1,"ل",1,0],["قَمَرٌ غاضَ ضَوؤُهُ في المَحاقِ","يَومَ جَدَّ اِنطِلاقُهُ وَاِنطِلاقي",2,"ق",2,1],["قُم نُبادِر مَرمى الزَمانِ بِبَينٍ","فَسِهامُ الخُطوبِ في الأَفواقِ",2,"ق",1,0],["قَمَرٌ عَلى غُصنٍ يُرَنِّحُهُ","مَرُّ اللِحاظِ وَلَيسَ يَرشُقُهُ",3,"ق",2,0],["قَمَرٌ يَهابُ المَوتُ ضَوءَ جَبينِهِ","وَاليَومَ خَوّارُ العَجاجِ غَسوقُ",4,"ق",1,0],["قَمَرٌ إِذا اِستَخجَلتَهُ بِعِتابِهِ","لَبِسَ الغُروبَ وَلَم يَعُد لِطلوعِ",5,"ع",1,0],["قُمنا نِجَلّي وَراءَ اللَثمِ كُلَّ فَتىً","كَأَنَّ حِليَتَهُ في صَفحَةِ القَمَرِ",6,"ر",1,0],["قم تجد في الكون ظلماً محدثاً","قتل العدل وباسم العدل قاما",7,"م",2,0],["قُمْتُمْ بِأَمْرِ اللهِ فِي أَقْطَارِهَا","مَا بَيْنَ غِلْظَةِ قُدْوَةٍ وَلِيَانِ",8,"ن",1,0],["قِمَّةٌ تَزْحَمُ السّمَاكَ وَقَلْبٌ","أَثَر اللَّبْثَ فِي حَضِيضِ الإِذَالَهْ",9,"ل",2,0],["قُمْ سَقِّني والأفْقُ يَقْرَعُ بابَهُ","مِنْ أوّلِ الفَجْرَيْنِ ضيْفٌ وارِدُ",10,"د",1,1],["قُمْتَ بِأَمْرِ أَنْتَ أَهْلٌ لَهُ","فَلْتَأَتِ هَذَا الأمْرَ مِنْ بَابهِ",11,"ب",2,0],["قَمَعُوا بِهَا الأَعْدَاءَ حَتَّى أَذْعَنُوا","وَالْبِيضُ مِنْ عَلَقِ النَّجيعِ رِوَاءُ",12,"ا",2,0],["قُمنا إِلَيكُم وَلَم يَبرُدنا","نَضحٌ عَلى حَميِنا قَرارُ",13,"ر",1,0],["قُمنَ رَمزاً لِعُصورٍ قَد خَلَت","أَشرَقَ العِلمُ عَلَيها وَاِزدَهَر",14,"ر",1,0],["قُم وَاِمحُ ما خَطَّت يَمينُ كُرومَرٍ","جَهلاً بِدينِ الواحِدِ القَهّارِ",15,"ر",1,0],["قُم يا اِبنَ مِصرَ فَأَنتَ حُرٌّ وَاِستَعِد","مَجدَ الجُدودِ وَلا تَعُد لِمَراحِ",16,"ح",1,0],["قُم وَصَفِّق وَاِستَحِر وَاِسجَع وَنُح","وَاِروِ عَن إِسحاقَ مَأثورَ الخَبَر",17,"ر",1,0],["قُم فَاِسقِنيها مِن سُلافٍ صانَها","عَصّارُها في الدَنِّ حَولاً كامِلا",18,"ل",2,1],["قَمَرٌ عَلى غُصنٍ يَميلُ بِهِ الصِبا","فَكَأَنَّهُ مِن خَمرِ عانَةَ مُنتَشي",19,"ش",2,0],["قَمَرُ الأُفقِ إِن تَأَمَّلتَ وَالشَمسُ","هُما يُكسَفانِ دونَ النُجومِ",20,"م",1,0],["قَمَرٌ هَوى في التُربِ تُحثى فَوقَهُ","لِلَّهِ ما حازَ الثَرى المُنهالُ",21,"ل",1,0],["قُم تَأَمَّل وَأَنتَ أَبصَرُ مِنّي","هَل تَرى بِالغَميمِ مِن أَجمالِ",22,"ل",1,0],["قَمَرانِ في النادي رَفيعا مَحتِدٍ","في المَجدِ فَرعا سُؤدُدٍ مُتَخَيَّرِ",23,"ر",1,0],["قمنا حواليها فما خلتنا","إلا جراداً ف خصيب نزل",24,"ل",1,0],["قَميصُ أُنثاهُمُ يَنقَدُّ مِن قُبُلٍ","وَقمصُ ذُكرانِهِم تَنقَدُّ مِن دُبُرِ",25,"ر",1,0],["قَموسِ الذُرى تيهٍ كَأَنَّ رِعانَها","مِنَ البُعدِ أَعناقُ العِيافِ الصَوادِفِ",26,"ف",1,0],["قَموسٍ بِخِمسِ الرَكبِ تَيهآءَ ما يُرى","بِها الناسُ إِلّا أَن يَمُرّوا بِها سَفرا",27,"ر",2,0],["قَموسَ الذُرى في الآلِ يَمَّمتُ خَطمَهُ","حَراجيجَ بَلّاها الوَجيفُ المُواخِدُ",28,"د",1,0],["قُمْ هاتها والجو أزهرُ باسمٌ","شمساً تحلُ من الزجاجة في قَمَرْ",29,"ر",1,0],["قمنا أمامك والنيران صائلة","تدكّ منك على الأركان أركانا",30,"ن",2,0],["قمت في وجهها اردّد طرفي","ساكتاً والضمير منّي ينادي",31,"د",2,0],["قِمنٌ بِما ساءَ الأَعادي مَوقِفي","وَالدَهرُ يَبرُزُ لي مَعَ الأَقرانِ",32,"ن",1,0],["قَمَرٌ كَأَنَّ بِعارِضَيهِ كِلَيهِما","مِسكاً تَساقَطَ فَوقَ وَردٍ أَحمَرِ",33,"ر",1,0],["قَمَرٌ دونَ حُسنِهِ الأَقمارُ","وَكَثيبٌ مِنَ النَقا مُستَعارُ",34,"ر",1,1],["قَمَعَ التَوامِكِ في جِفا","نِ الحورِ تُصبِحُ جامِدَه",35,"د",2,0],["قم هاتها في الليلِ راحاً كما","توقدت شعلةُ مصباح",36,"ح",1,1],["قمراً نراهُ أم مليحاً أمردا","ولحاظهُ بين الجوانح أم ردى",37,"د",2,1],["قمْ لنحرِ العدى ونحر العطايا","وابقَ تسعى إلى حماكَ الوفود",38,"د",1,0],["قم للعلى والعلوم مشتملاً","ثيابَ سرَّاءَ ذات تجديد",39,"د",1,0],["قمْ يا غلام وهاتها في حبه","صفراء مشرقةً كما وضح الشفق",40,"ق",1,0],["قمرٌ يقول سناه يا قمر الدّجى","فضح التكلّف وجنة المتشبّه",41,"ه",1,0],["قمرٌ نجتليهِ ملءَ عيونٍ","وصدورٍ بَرَاعةً وضياءَ",42,"ا",2,0],["قَمَرْتُهُ الفرخَ على ضُغائه","فما يفي وكِعْتُ عن دوائِهِ",43,"ا",3,0],["قمر يجود بأن أراه حسرةً","ويضن بالإرشاف والإلماس",44,"س",1,0],["قمعيِّةٍ ذاتِ فَمٍ واسعٍ","يصبُو إليه من به ثَلْطهْ",45,"ط",2,0],["قميئة الخَلق على أنها","أعتقُ في الدنيا من الحِنطه",45,"ط",2,0],["قمر العالمين تهدى إليه ال","شمس في حلَّةٍ من التتريف",46,"ف",1,0],["قمر رأى قمراً يجود بنفسه","فبكى عليه بعبرة لا تَذرِفُ",47,"ف",1,0],["قَمَرانِ ضَمَّهُما التُرابُ وَما عَرَف","تُ سِواهُما قَمَرَينِ ضَمَّهُما الثَرى",48,"ا",1,0],["قُم عُدَّ آلَفَ السِنينِ عَلى الحَصى","أَتَعُدُّ شِبهَ فَضيلَةٍ لِحُصاةِ",49,"ه",1,0],["قُم حَدِّثِ الناسَ عَن لُبنانَ كَيفَ نَجا","مِنَ الطُغاةِ العُتاةِ البيض وَالسودِ",50,"د",1,0],["قَمَرٌ واحِدٌ يُطِلُّ عَلَينا","وَعَلى الكوخ وَالبِناءِ المُوَطَّد",51,"د",1,0],["قُم بادِرِ اللَذاتِ قَبلَ فَواتِها","ما كُلُّ يَومٍ مِثلُِ هَذا مَوسِمُ",52,"م",1,0],["قُم بِنا يانَديمُ نَس","بُقُ أَذانَ المُؤَذِّنِ",53,"ن",1,0],["قُم بِنا قَد طَلَعَ الفَج","رُ وَقَد أَشرَقَ نَجمُه",54,"م",2,0],["قَمَرٌ شَرِبتُ لَهُ الفِرا","قَ المُرَّ بِالكَأسِ الدِهاقِ",55,"ق",1,0],["قُم بِنا إِن شِئتَ عِندي","أَو أَكُن إِن شِئتَ عِندَك",56,"ك",1,0],["قَمَرٌ غابَ عَن جُفونك مَرآ","هُ وَسُكنَاهُ في سَواد فُؤادِكْ",57,"ك",1,0],["قمت في نظمه ثلاثين عاماً","ثم لم تسأم طول تلك السنينا",58,"ن",2,0],["قم إلى الأهرام واخشع واطَّرح","خِيلة الصِّيد وزهو الفاتحين",59,"ن",1,1],["قمتم عن السادات مَن","حبا وأعطى ووهب",60,"ب",1,0],["قمت بالبين وما جرعني","وحملت الشَّطر مما جرعك",61,"ك",1,0],["قم فعظنا فهذه هامة أبن ال","شمس اين النحاس والتاجان",62,"ن",1,0],["قُم تَرى الأَرضَ مِثلَما","كُنتُمو أَمسِ مَلعَبا",63,"ب",2,0],["قُم تَأَمَّل بَنيكَ في الشَرقِ زَينُ ال","تاجِ مِلءُ السَريرِ نورُ العَواصِم",64,"م",1,0],["قُم تَحَدَّث أَبا عَلِيٍّ إِلَينا","كَيفَ غامَرتَ في جِوارِ الأَراقِم",64,"م",1,0],["قُم لِلمُعَلِّمِ وَفِّهِ التَبجيلا","كادَ المُعَلِّمُ أَن يَكونَ رَسولا",65,"ل",2,1],["قُم فَشاهِد لَوِ اِستَطَعتَ قِياماً","حَسرَةَ الشِعرِ وَاِلتِياعِ خَيالِه",66,"ل",2,0],["قُمِ اِبنِ الأُمَّهاتِ عَلى أَساسٍ","وَلا تَبنِ الحُصونَ وَلا القِلاعا",67,"ع",2,0],["قُم تَرَ القَومَ كُتلَةً","مِثلَ مَلمومَةِ الصَخَر",68,"ر",1,0],["قُمِ اِنظُر وَأَنتَ المالِئُ الأَرضَ حِكمَةً","أَأَجدى نَظيمٌ أَم أَفادَ نَثيرُ",69,"ر",1,0],["قُم إِنِ اِسطَعتَ مِن سَريرِكَ وَاِنظُر","سِرَّ ذاكَ اللِواءِ وَالأَجنادِ",70,"د",1,0],["قُم فَحَدِّث عَنِ السِنينِ الخَوالي","وَفُتوحِ المُمَلَّكينَ الصيدِ",71,"د",1,0],["قُم غَنِّ وِلدانَ الجِنانِ وَحورِها","وَاِبعَث صَداكَ فَكُلُّنا أَرواحُ",72,"ح",1,0],["قُم صِفِ الخُلدَ لَنا في مُلكِهِ","مِن جَلالِ الخُلقِ وَالصُنعِ العَجَب",73,"ب",1,0],["قُم تَأَمَّل هَذِهِ الدارُ وَفى","لَكَ مِن طُلّابِها الجَمعُ الأَرِب",73,"ب",1,0],["قُم مِن صُفوفِ الحَقِّ تلقَ كَتيبَةً","مَلمومَةً وَتَرَ الصُفوفَ سَواءَ",74,"ا",2,0],["قَمَرٌ لاقى خُسوفاً فَاِنزَوى","لَيسَ مِن آبائِهِ إِلّا نَبيه",75,"ه",1,0],["قُم سابِقِ الساعَةَ وَاِسبِق وَعدَها","الأَرضُ ضاقَت عَنكَ فَاِصدَع غِمدَها",76,"د",3,1],["قُم ناجِ جِلَّقَ وَاِنشُد رَسمَ مَن بانوا","مَشَت عَلى الرَسمِ أَحداثٌ وَأَزمانُ",77,"ن",1,1],["قُم سُلَيمانُ بِساطُ الريحِ قاما","مَلَكَ القَومُ مِنَ الجَوِّ الزِماما",78,"م",2,1],["قَمَرُ الحَجيجِ إِذا بَدا","دارُ الحَجيجِ عَلَيهِ هالَه",79,"ل",2,0],["قُم أَبا نُواس","أُنظُرِ النَشَب",80,"ب",1,0],["قُم أَيِّدِ الحَقَّ في الدُنيا أَلَيسَ لَهُ","كَتيبَةٌ مِنكَ تَحتَ الأَرضِ خَرساءُ",81,"ا",2,0],["قُم يا خَطيبَ الجَمعِ هاتِ مِنَ الحَلي","ما كُنتَ تَنثُرُهُ عَلى آذانِهِ",82,"ن",2,0],["قُم تَرَ الدُنيا كَما غادَرتَها","مَنزِلَ الغَدرِ وَماءَ الخادِعين",83,"ن",1,0],["قُم لِلهِلالِ قِيامَ مُحتَفِلٍ بِهِ","أَثنى وَبالَغَ في الثَناءِ وَغالى",84,"ل",2,0],["قُم نادِ أَنقَرَةً وَقُل يَهنيكِ","مُلكٌ بَنَيتِ عَلى سُيوفِ بَنيكِ",85,"ك",1,1],["قُم في فَمِ الدُنيا وَحَيِّ الأَزهَرا","وَاِنثُر عَلى سَمعِ الزَمانِ الجَوهَرا",86,"ر",2,1],["قُم قَبِّلِ الأَحجارَ وَالأَيدي الَّتي","أَخَذَت 