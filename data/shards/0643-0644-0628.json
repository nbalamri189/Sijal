 الواعي","https://www.poetsgate.com/ViewPoem.aspx?id=188863",""],[5431,"دثروني...تتمة","https://www.poetsgate.com/ViewPoem.aspx?id=196860",""],[5431,"بانيو وكأس ...وبرد الخيام!","https://www.poetsgate.com/ViewPoem.aspx?id=201925",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5458,"لن يظل الورد ذابل","https://www.poetsgate.com/ViewPoem.aspx?id=113361",""],[5493,"مدن السراب","https://www.poetsgate.com/ViewPoem.aspx?id=197089",""],[835,"بات ساجي الطرف والشوق يلح","https://www.poetsgate.com/ViewPoem.aspx?id=40614",""],[5516,"يا موطن المجد","https://www.poetsgate.com/ViewPoem.aspx?id=214142",""],[5739,"راسبه والاّ ناجحه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126872",""],[5739,"الوتين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155469",""],[5776,"مُذَكّرةُ قائد بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=199334",""],[5943,"أماهُ رُدِّي، لاتموتي ، اِنهضي","https://www.poetsgate.com/ViewPoem.aspx?id=60759",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[5970,"كل بصفحة وجه العيش متبول","https://www.poetsgate.com/ViewPoem.aspx?id=130578",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[2575,"يا فرحة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=22532",""],[6124,"كلب السكة","https://www.poetsgate.com/ViewPoem.aspx?id=159637",""],[6142,"كل بيتٍ حواه فهو عكاظٌ","https://www.poetsgate.com/ViewPoem.aspx?id=155687",""],[469,"لا ومن قصر الوصال ومن صي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574791",""],[6229,"مرآةُ عصرنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65213&r=&rc=36",""],[463,"جمَّ لها الوادي وعزَّ الذائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60032&r=&rc=88",""]],"verses":[["كُلُّ باكٍ يُبكى عَلَيهِ وَإِن طا","لَ بَقاءٌ وَالثاكِلُ المَثكولُ",0,"ل",1,0],["كُلٌُّ بِآنٍ غَيْرُ ذِكْ","رِكَ فَهْوَ شُغْلِي كُلَّ آنِ",1,"ن",1,0],["كل بَيْتٍ كَمَنْبِتِ الزَّهْرِ حُسْناً","وَشَذاً أَوْ كَمرْقِعِ الآرَامِ",2,"م",1,0],["كُلُّ بَني حُرَّةٍ مَصيرُهُمُ","قُلٌّ وَإِن أَكثَرَت مِنَ العَدَدِ",3,"د",1,0],["كلّ بيتٍ كأنه حان سكرٍ","حيث صفى سلافه الرَّاوُوق",4,"ق",1,0],["كُلُّ بَلاءٍ عَلَيَّ مِنّي","فَلَيتَني قَد أُخِذتُ عَنّي",5,"ن",2,1],["كلبٌ عوى مُستقتِلاً","والحَيْنُ يَستعوي كلابهْ",6,"ب",2,0],["كل بيت قد قلته فيك أرثي","آهة لي جاءت من الاعماق",7,"ق",1,0],["كل بيت منه اذا عصروه","دمعة ثرّة على الاداب",8,"ب",1,0],["كلب إذا خوّفته","صقر إذا أمّنت كاسر",9,"ر",1,0],["كُلُّ بَيتٍ تَحِلُّهُ يَستَوي عِن","دَكَ في الزُهدِ ضيقُهُ وَاِتِّساعُه",10,"ع",2,0],["كَلْبٌ قَبيلي وكَلْبٌ خيرُ مَنْ وَلَدَتْ","حَوَّاءُمِنْ عَرَبٍ غُرٍّ ومِنْ عَجَمِ",11,"م",1,1],["كُلُّ بيتٍ يجيءُ يبرز فيه","لكَ من جوهَرِ الفصاحَةِ لونُ",12,"ن",1,0],["كلُّ بِرٍّ يَشوبُه كَدَرُ المَطْ","لِ حَقيقٌ بأن يكونَ عُقُوقا",13,"ق",2,0],["كل به قيس إذا جنَّ الدجى","نزع الإِباءَ وباح بالبرحاءِ",14,"ا",2,0],["كل برق يبين","ومضه كذاب",15,"ب",1,0],["كُلُّ بَحرٍ يَسطو بِجَدولِ غَمرٍ","جامد فيه وهوَ بالسَّيلِ جَاري",16,"ر",2,0],["كُلُّ بَيْتٍ كَنَسِيجِ الرْ","رَوْضِ حُسْنَاً وَطَلالَهْ",17,"ل",2,0],["كلُّ بيتٍ فيهِ نسيبٌ ومدحٌ","مستجادٌ منْ مستكنِّ ضميري",18,"ر",2,0],["كُلُّ بَحْرٍ إنْ شِئْتَ فِيهِ اخْتَبِرنِي","لا تُكَذِّبْ فَإنَّنِي يَقْطِينَهْ",19,"ن",2,0],["كلّ بليغ في صفاتك أعجَمٌ","وكلُّ ملومٍ في نوالك لائم",20,"م",1,0],["كُلٌّ بِمَعقِلِهِ يُمضي حُكومَتَهُ","في حِزبِهِ بِجَميلِ القَولِ وَالراءِ",21,"ا",2,0],["كُلُّ بَني بَرمَكٍ كَريمٌ","أَستَغفِرَ اللَهَ غَيرَ واحِد",22,"د",1,1],["كُلِّ بَيضاءَ كَالمَهاةِ اِستَعارَت","لَكَ أُمَّ الغَزالِ عَيناً وَجيدا",23,"د",2,0],["كُلُّ بَيْتٍ للْهَدْمِ ما تَبْتَني الوَرْ","قاءُ والسّيّدُ الرّفيعُ العِمادِ",24,"د",1,0],["كلٌّ بيُمنِ الإلهِ تمَّ لها","وكلُّ خيرٍ أتى فمن قِبَله",25,"ل",2,0],["كلبٌ يَهِرُّ إذا ما جاءَ زائِرُهُ","حتَّى إِذا جاءَ مُهْدي تُحْفةٍ نَبسا",26,"س",2,0],["كلُّ بَيْضاءَ منهُما تمْنَعُ الفا","رِسَ أنْ يجْعَلَ الفِرَارَ نَصيرا",27,"ر",2,0],["كُلُّ بَذْلٍ كَمَا بَذَلتَ خَلِيقٌ","بِجَزَاءٍ مِنَ الفَخَارِ وِفَاقِ",28,"ق",1,0],["كُلُّ بِمَسْعَاهُ يَفُوزُ وَمَنْ يُنِبْ","عَنْهُ الحَوَادِثَ لَمْ يَفُزْ بِمُرَادِ",29,"د",1,0],["كُلَّ بَيْتٍ دَبَّ الشَّقَاقُ إِلَيْهِ","نَالَ مِنْهُ مَالاَ تَنَالُ الأَعَادِي",30,"د",2,0],["كُلُّ بُرْجٍ مُترَامٍ حَفَرَتْ","بَعدَهُ فِي عُمُقِ الظَّلْمَاءِ بِئْرَا",31,"ر",2,0],["كُلٌّ بِهِ مِنْ شَاهِدٍ أَوْ غَائِبِ","أَثْنَى عَلَيْكِ وَقَدْ ثَنَى بِدُعَاءِ",32,"ا",2,0],["كلُّ بَيْتٍ قدْ عَافَ أحْجارَهُ الصُّمَّ","وأَضْحَى دَماً ولَحْماً وجِلْدا",33,"د",2,0],["كلُّ بَيْتٍ بِهِ غِناءٌ وَشَدْوٌ","عَلَّمَ الطيْرَ إِنْ شَدَتْ أَنْ تُجيدا",34,"د",2,0],["كلُّ بيتٍ فيه سعدٌ ماثلٌ","في إطارِ من حَانٍ وحنين",35,"ن",1,0],["كلبٌ ينم على الجُنْاةُ","تمشي العدالة في خُطاهْ",36,"ا",2,1],["كلبٌ عصاميّ بنتْ","أركانَ دولته يداه",36,"ا",2,0],["كلبٌ وضيعُ الأصل لا","ليثٌ، ولا ليثٌ نماه",36,"ا",2,0],["كل برميل إلى الدور ..؟ نعم","وإلى المقهى ..؟ جواسيس الخلافه",37,"ف",2,0],["كلُّ بيتٍ فيه سعدٌ ماثلٌ","في إطارٍ من حَنانٍ وحنين",38,"ن",1,0],["كلٌّ بِمَعْقِلِهِ يُمضي حُكومَتَه ،","مِنْ بُرْج لَهوٍ، إلى آفاق سَرّاءِ",39,"ا",2,0],["كُلُ بَيت إِذا تَأَصَلَت مَعَنا","يَقيناً ظَنَنتَني سِحارا",40,"ر",2,0],["كُلُ بَيت تَكاد تَشرَبَهُ الأَر","واح لُطفاً إِذا أُدير غفارا",40,"ر",2,0],["كُلٌّ بَرد بحيلة","إِلّا لِحاظك وَالمُنونا",41,"ن",2,0],["كل بيتٍ في قرارته","جثةٌ خرساء مرنان",42,"ن",1,0],["كُلٌّ بِما تُحدِثُ الأَيّامُ مُرتَهَنٌ","وَكُلُّ غايَةِ مَوجُودٍ إِلى عَدَمِ",43,"م",1,0],["كَلِبَ البَردُ عَلَينَا","بَينَ حَزنٍ وَدَمِيثٍ",44,"ث",1,0],["كُلٌّ بذي الدُنيا رَهينةُ ساعةٍ","فَإِذا أَتَت لا يُرتَجى تَأخيرُها",45,"ر",3,0],["كلٌّ بميدانِ للذائذِ والهوى","تَلقى عواطِفَه بغيرِ عنانِ",46,"ن",1,0],["كلّ بميدان اللذائذِ والهوى","يجري وما تلقى لديهِ عنانا",47,"ن",2,0],["كلُّ بدرٍ لهُ سماءٌ ولا يع","رفُ للحسنِ كالبيوتِ سماءُ",48,"ا",2,0],["كلُّ بيتٍ لهُ قطينٌ وإن كا","نَ تساوى في كل