{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[93,"يا مائساً عن غض بان","https://www.aldiwan.net/poem11165.html","مجزوء الكامل"],[93,"حبذا الشعر خاطر يبعث النور","https://www.aldiwan.net/poem11377.html","الخفيف"],[4,"ما إن تعري المنون من أحد","https://www.aldiwan.net/poem21157.html","المنسرح"],[72,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[64,"كل بلاء علي مني","https://www.aldiwan.net/poem67538.html","مخلع البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[89,"انت ما ان تخففين مصابي","https://www.aldiwan.net/poem44901.html","الخفيف"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[56,"كلب قبيلي وكلب خير من ولدت","https://www.aldiwan.net/poem58498.html","البسيط"],[43,"أي شعري نظرت فيه لضب","https://www.aldiwan.net/poem10637.html","الخفيف"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[97,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[87,"أهلال بين هاله","https://www.aldiwan.net/poem8365.html","مجزوء الرمل"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[67,"أهوى والمشيب قد حال دونه","https://www.aldiwan.net/poem18134.html","الخفيف"],[75,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[48,"لا يصرفنك عن قصف وإصباء","https://www.aldiwan.net/poem10400.html","البسيط"],[48,"كل بني برمك كريم","https://www.aldiwan.net/poem62613.html","مجزوء البسيط"],[50,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[76,"صحيفة كتبت ليت بها وعسى","https://www.aldiwan.net/poem39283.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54812","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[100,"بين الرجل والطريق","https://www.poetsgate.com/ViewPoem.aspx?id=50371",""],[101,"اكْشفوا التُرْبَ عن الكَنْز الدفينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62427&r=&rc=19",""],[48,"لا يَصرفَنَّك ،عن قَصْفٍ وإصْباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24834&r=&rc=4",""],[109,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[109,"أفديك ظبيا إن سطا","https://www.aldiwan.net/poem16601.html","مجزوء الكامل"],[120,"ليتديواني يكون له","https://www.aldiwan.net/poem49354.html","المديد"],[169,"أيدي الحوادث في الأيام والأمم","https://www.aldiwan.net/poem1667.html",""],[173,"أيها النحرير علماً","https://www.aldiwan.net/poem4390.html","عموديه"],[182,"تمضي النفوس كبيرها وصغيرها","https://www.aldiwan.net/poem67022.html","الكامل"],[197,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[197,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[199,"للحسان الدلال والخيلاء","https://www.aldiwan.net/poem45375.html","الخفيف"],[211,"آه وما أشهى بكاها","https://www.aldiwan.net/poem46774.html","مجزوء الرمل"],[225,"لك في الشعر يا نسيم معان","https://www.aldiwan.net/poem55214.html","الخفيف"],[259,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[261,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[275,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[305,"الشكر لله لا أحصي عليه ثنا","https://www.aldiwan.net/poem56388.html","البسيط"],[322,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[348,"لم أنل في الشباب ما نلته عن","https://www.aldiwan.net/poem20749.html","الخفيف"],[353,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[364,"قفا معي في هذه المعاهد","https://www.aldiwan.net/poem60949.html","السريع"],[377,"قد أومضت حكمة الإنجيل عن رسل","https://www.aldiwan.net/poem59236.html","البسيط"],[391,"طلب الراحة في الدنيا محال","https://www.aldiwan.net/poem54543.html","عموديه"],[402,"أمل بهذا الدهر خائب","https://www.aldiwan.net/poem46510.html","مجزوء الكامل"],[403,"كيف لا تفتح صندوقا وقد","https://www.aldiwan.net/poem33378.html","الرمل"],[403,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[405,"سبحان من سخر الأقوام كلهم","https://www.aldiwan.net/poem50008.html","البسيط"],[409,"دنياي ناشزة فإن فارقتها","https://www.aldiwan.net/poem31884.html","الكامل"],[432,"حسن ملاوي عوده","https://www.aldiwan.net/poem12759.html","مجزوء الكامل"],[445,"كل بأودية المدينة مغرم","https://www.aldiwan.net/poem23813.html","الكامل"],[458,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[458,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[458,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[458,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[461,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[465,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[479,"طلع الصباح فأشرقت","https://www.aldiwan.net/poem36930.html","مجزوء الكامل"],[479,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[491,"كل بيت بثلاث يزدهي","https://www.aldiwan.net/poem26669.html","الرمل"],[567,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[575,"ما أخشن الدهر على لينه","https://www.aldiwan.net/poem2772.html","السريع"]],"verses":[["كُلُّ باكٍ يُبكى عَلَيهِ وَإِن طا","لَ بَقاءٌ وَالثاكِلُ المَثكولُ",0,"ل",1,0],["كُلٌُّ بِآنٍ غَيْرُ ذِكْ","رِكَ فَهْوَ شُغْلِي كُلَّ آنِ",1,"ن",1,0],["كل بَيْتٍ كَمَنْبِتِ الزَّهْرِ حُسْناً","وَشَذاً أَوْ كَمرْقِعِ الآرَامِ",2,"م",1,0],["كُلُّ بَني حُرَّةٍ مَصيرُهُمُ","قُلٌّ وَإِن أَكثَرَت مِنَ العَدَدِ",3,"د",1,0],["كلّ بيتٍ كأنه حان سكرٍ","حيث صفى سلافه الرَّاوُوق",4,"ق",1,0],["كُلُّ بَلاءٍ عَلَيَّ مِنّي","فَلَيتَني قَد أُخِذتُ عَنّي",5,"ن",2,1],["كلبٌ عوى مُستقتِلاً","والحَيْنُ يَستعوي كلابهْ",6,"ب",2,0],["كل بيت قد قلته فيك أرثي","آهة لي جاءت من الاعماق",7,"ق",1,0],["كل بيت منه اذا عصروه","دمعة ثرّة على الاداب",8,"ب",1,0],["كلب إذا خوّفته","صقر إذا أمّنت كاسر",9,"ر",1,0],["كُلُّ بَيتٍ تَحِلُّهُ يَستَوي عِن","دَكَ في الزُهدِ ضيقُهُ وَاِتِّساعُه",10,"ع",2,0],["كَلْبٌ قَبيلي وكَلْبٌ خيرُ مَنْ وَلَدَتْ","حَوَّاءُمِنْ عَرَبٍ غُرٍّ ومِنْ عَجَمِ",11,"م",1,1],["كُلُّ بيتٍ يجيءُ يبرز فيه","لكَ من جوهَرِ الفصاحَةِ لونُ",12,"ن",1,0],["كلُّ بِرٍّ يَشوبُه كَدَرُ المَطْ","لِ حَقيقٌ بأن يكونَ عُقُوقا",13,"ق",2,0],["كل به قيس إذا جنَّ الدجى","نزع الإِباءَ وباح بالبرحاءِ",14,"ا",2,0],["كل برق يبين","ومضه كذاب",15,"ب",1,0],["كُلُّ بَحرٍ يَسطو بِجَدولِ غَمرٍ","جامد فيه وهوَ بالسَّيلِ جَاري",16,"ر",2,0],["كُلُّ بَيْتٍ كَنَسِيجِ الرْ","رَوْضِ حُسْنَاً وَطَلالَهْ",17,"ل",2,0],["كلُّ بيتٍ فيهِ نسيبٌ ومدحٌ","مستجادٌ منْ مستكنِّ ضميري",18,"ر",2,0],["كُلُّ بَحْرٍ إنْ شِئْتَ فِيهِ اخْتَبِرنِي","لا تُكَذِّبْ فَإنَّنِي يَقْطِينَهْ",19,"ن",2,0],["كلّ بليغ في صفاتك أعجَمٌ","وكلُّ ملومٍ في نوالك لائم",20,"م",1,0],["كُلٌّ بِمَعقِلِهِ يُمضي حُكومَتَهُ","في حِزبِهِ بِجَميلِ القَولِ وَالراءِ",21,"ا",2,0],["كُلُّ بَني بَرمَكٍ كَريمٌ","أَستَغفِرَ اللَهَ غَيرَ واحِد",22,"د",1,1],["كُلِّ بَيضاءَ كَالمَهاةِ اِستَعارَت","لَكَ أُمَّ الغَزالِ عَيناً وَجيدا",23,"د",2,0],["كُلُّ بَيْتٍ للْهَدْمِ ما تَبْتَني الوَرْ","قاءُ والسّيّدُ الرّفيعُ العِمادِ",24,"د",1,0],["كلٌّ بيُمنِ الإلهِ تمَّ لها","وكلُّ خيرٍ أتى فمن قِبَله",25,"ل",2,0],["كلبٌ يَهِرُّ إذا ما جاءَ زائِرُهُ","حتَّى إِذا جاءَ مُهْدي تُحْفةٍ نَبسا",26,"س",2,0],["كلُّ بَيْضاءَ منهُما تمْنَعُ الفا","رِسَ أنْ يجْعَلَ الفِرَارَ نَصيرا",27,"ر",2,0],["كُلُّ بَذْلٍ كَمَا بَذَلتَ خَلِيقٌ","بِجَزَاءٍ مِنَ الفَخَارِ وِفَاقِ",28,"ق",1,0],["كُلُّ بِمَسْعَاهُ يَفُوزُ وَمَنْ يُنِبْ","عَنْهُ الحَوَادِثَ لَمْ يَفُزْ بِمُرَادِ",29,"د",1,0],["كُلَّ بَيْتٍ دَبَّ الشَّقَاقُ إِلَيْهِ","نَالَ مِنْهُ مَالاَ تَنَالُ الأَعَادِي",30,"د",2,0],["كُلُّ بُرْجٍ مُترَامٍ حَفَرَتْ","بَعدَهُ فِي عُمُقِ الظَّلْمَاءِ بِئْرَا",31,"ر",2,0],["كُلٌّ بِهِ مِنْ شَاهِدٍ أَوْ غَائِبِ","أَثْنَى عَلَيْكِ وَقَدْ ثَنَى بِدُعَاءِ",32,"ا",2,0],["كلُّ بَيْتٍ قدْ عَافَ أحْجارَهُ الصُّمَّ","وأَضْحَى دَماً ولَحْماً وجِلْدا",33,"د",2,0],["كلُّ بَيْتٍ بِهِ غِناءٌ وَشَدْوٌ","عَلَّمَ الطيْرَ إِنْ شَدَتْ أَنْ تُجيدا",34,"د",2,0],["كلُّ بيتٍ فيه سعدٌ ماثلٌ","في إطارِ من حَانٍ وحنين",35,"ن",1,0],["كلبٌ ينم على الجُنْاةُ","تمشي العدالة في خُطاهْ",36,"ا",2,1],["كلبٌ عصاميّ بنتْ","أركانَ دولته يداه",36,"ا",2,0],["كلبٌ وضيعُ الأصل لا","ليثٌ، ولا ليثٌ نماه",36,"ا",2,0],["كل برميل إلى الدور ..؟ نعم","وإلى المقهى ..؟ جواسيس الخلافه",37,"ف",2,0],["كلُّ بيتٍ فيه سعدٌ ماثلٌ","في إطارٍ من حَنانٍ وحنين",38,"ن",1,0],["كلٌّ بِمَعْقِلِهِ يُمضي حُكومَتَه ،","مِنْ بُرْج لَهوٍ، إلى آفاق سَرّاءِ",39,"ا",2,0],["كُلُ بَيت إِذا تَأَصَلَت مَعَنا","يَقيناً ظَنَنتَني سِحارا",40,"ر",2,0],["كُلُ بَيت تَكاد تَشرَبَهُ الأَر","واح لُطفاً إِذا أُدير غفارا",40,"ر",2,0],["كُلٌّ بَرد بحيلة","إِلّا لِحاظك وَالمُنونا",41,"ن",2,0],["كل بيتٍ في قرارته","جثةٌ خرساء مرنان",42,"ن",1,0],["كُلٌّ بِما تُحدِثُ الأَيّامُ مُرتَهَنٌ","وَكُلُّ غايَةِ مَوجُودٍ إِلى عَدَمِ",43,"م",1,0],["كَلِبَ البَردُ عَلَينَا","بَينَ حَزنٍ وَدَمِيثٍ",44,"ث",1,0],["كُلٌّ بذي الدُنيا رَهينةُ ساعةٍ","فَإِذا أَتَت لا يُرتَجى تَأخيرُها",45,"ر",3,0],["كلٌّ بميدانِ للذائذِ والهوى","تَلقى عواطِفَه بغيرِ عنانِ",46,"ن",1,0],["كلّ بميدان اللذائذِ والهوى","يجري وما تلقى لديهِ عنانا",47,"ن",2,0],["كلُّ بدرٍ لهُ سماءٌ ولا يع","رفُ للحسنِ كالبيوتِ سماءُ",48,"ا",2,0],["كلُّ بيتٍ لهُ قطينٌ وإن كا","نَ تساوى في كلِّهنَّ البناءُ",48,"ا",2,0],["كل باكٍ بعد نوحي","بالتباكي يتباهى",49,"ا",3,0],["كلُّ بَيتٍ يُطِلُّ منهُ على أَف","هامِ أَهلِ النُهى محَيّاً جَميلُ",50,"ل",1,0],["كلبس صوفٍ جعلُهُ عمامهْ","وقد علاها بالنوى علامهْ",51,"ه",1,0],["كل بيداء يحسب الآل ماء","ضمنها من هجيرها الظمآن",52,"ن",1,0],["كُلٌّ بِنُعْماه فِي رِياضٍ","يَشْدُو بِها طائِرٌ مُرِنَّا",53,"ن",2,0],["كلٌّ بِلقياكَ مسرورٌ ومبتهجٌ","لكنّ أوفرَهُم حظّاً بذاك أنا",54,"ن",2,0],["كُلُّ باغي الخَيرِ يَوماً","راكِبُ الهَولِ الكَبيرِ",55,"ر",1,0],["كُلُّ بِكْرٍ ما افتضَّها مِن فُحولِ الشَّ","عْرِ عِندِي يَالَيتَ ذا في الغَواني",56,"ي",1,0],["كُلّ بَيت لَدَيهِ أعرب مَبناه","أُدَباءٌ عَلَيهِ كانَت عِيالا",57,"ل",2,0],["كُلُّ بيضاءَ إن نظرتَ إليها","نَسجَ الظَّعْنُ دونها الشَّمسَ سِترا",58,"ر",2,0],["كُلُّ بني الحضرةِ قد ذمَمْتُهم","ذَمَّ فتىً في القُربِ منهم زاهد",59,"د",1,0],["كلٌّ بإنجيله يروي حقيقتَه","عن روح قُدسٍ وما يرويه صدقنا",60,"ن",2,0],["كل برشرع الله إلى","ذكر مولانا إذا حققت آل",61,"ل",1,0],["كلبٌ يسودُ على الأُسودِ","ويرتقي أعلى المراتبْ",62,"ب",1,0],["كل بحث مغلق تفتحه","بعدما يعجز عنه الثقلان",63,"ن",1,0],["كل بيتِ حوى قصوراً من الحس","ن فللّه من بناه وشيَّد",64,"د",1,0],["كُلُّ بما عندَه مُستشِرٌ فَرِحٌ","يرى السَّعادةَ فيما نالَ واعتقَدا",65,"د",2,0],["كلٌّ بها كَلِفٌ ومن يزهدْ يكُنْ","في زُهْدِهِ متكلِّفاً مُتَكارها",66,"ر",3,0],["كلبٌ يُجاذبُ كفُّهُ","أُنشوطةً والكلبُ عاوِ",67,"و",1,0],["كلٌّ بأودية المدينةِ مُغْرَمُ","وهوى ثراها في القلوب مُحكّمُ",68,"م",1,1],["كلّ بعيدٍ في السُّرَى شوطُها","تسابِق الفارسَ بالراجلِ",69,"ل",1,0],["كلّ بيضاء تمنَّى الكُحلُ لو","أنه ما بين جفنَيها الكَحَلْ",70,"ل",1,0],["كلّ بيت ماثلٌ من دونكم","هضبةً أو سائرٌ سيرَ المثَلْ",70,"ل",1,0],["كلّ بيضاءَ سمينٌ متنُها","ضمَّنَتها السحرَ هيفاءُ دقيقَهْ",71,"ق",2,0],["كُلْ بنابَيْك ملءَ جنبيك لحمي","وتخذَّلْ عنّي متى قلتُ نصرا",72,"ر",2,0],["كلِبدةِ الليثِ وَسَطاً وحسنُها","كالوشي تُكساهُ الدُّمَى الخرائدُ",73,"د",1,0],["كلبٌ أتى الليثَ فأغراه بي","وقال وهو الفاجرُ الكاذبُ",74,"ب",1,0],["كلُّ بَعيدِ رائعٌ صِيتُه","كذَّب فرطَ الخَبرِ الخُبْرُ",75,"ر",1,0],["كلُّ بيضاءَ قبلتْ بالسويداوات","في عمرتي فرادى وجمع",76,"ع",1,0],["كلُّ بيضاءَ حجبوها بسمرا","فأدنى مزارها لن يراما",77,"م",2,0],["كُلٌّ بأرض ٍ ..لا أبا لأبيهِمُو","اليابِساتُ نَأتْ بِهِم والأبحُرُ",78,"ر",1,0],["كل براحته الكتا","ب وحسبه ذاك الشعار",79,"ر",1,0],["كل بفضلك شاهد","وعليك كلهمو جزوع",80,"ع",1,0],["كل بيت بثلاث يزدهي","في اعتبار المكتري والمشتري",81,"ي",1,1],["كلُّ بيتٍ أَعَمُّ طِيباً وأذْكى","أرْجاً من تنفُّسِ الأحبابِ",82,"ب",1,0],["كلُّ بني الدنيا يُرَى جائراً","تخْييرُهُ علَّةُ تَجْبِينِه",83,"ن",2,0]]}