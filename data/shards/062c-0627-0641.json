{"poems":[[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[71,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[107,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[52,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[47,"في الشَّيبِ زَجْرٌ لهُ، لوْ كانَ يَنزَجِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31278",""],[136,"وبأني قد تصفحت الورى","https://www.aldiwan.net/poem54780.html","الخفيف"],[164,"الحمد لله حمدا ليس يحصيه","https://www.aldiwan.net/poem58981.html","البسيط"],[203,"جافيتني والذنب ذنبك","https://www.aldiwan.net/poem45608.html","مجزوء الكامل"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129513","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112952","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86505","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133290","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72472","الكامل"],[5409,"وادي ارجيوس حسبي ما أقاسيه","https://www.poetsgate.com/ViewPoem.aspx?id=155365",""],[5764,"الاصدقاء الثلاثه","https://www.poetsgate.com/ViewPoem.aspx?id=175121",""],[5829,"تلك الفتاة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=190585",""]],"verses":[["جافي المَضاجِعِ لا يَنفَكُّ في لَجَبٍ","يَكادُ يُقمِرُ مَن لَآلائِهِ القَمَرُ",0,"ر",1,0],["جافٍ ويبكي مِنْ جفائي كَمَنْ","يشكو جراحاً وَهْوَ رامي السهامْ",1,"م",1,0],["جافٍ يَبيتُ الخطبُ يَقْرَعُ قَوْمَه","ويَبيتُ في دَعَةٍ رَخِيَّ البالِ",2,"ل",1,0],["جافَ الحُداءَ إِذا ما لَجَّ أَتعَبَها","حَتّى تَزاوَرَ أَو فيهِ لَها وَزَرُ",3,"ر",1,0],["جافٍ عَنِ البيضِ إِذا ما غَدا","لَم يَبكِ في دارٍ وَلَم يَطرَبِ",4,"ب",1,0],["جافِلاتٍ فَوقَ عوجٍ عُجُلٍ","رُكَّبَت فيها مَلاطيسُ سُمُر",5,"ر",1,0],["جَافَيْتِ مَهْدَ الذُّلِّ مُعْتَزَّةً","فَطاوِلِي الدُّنْيَا ولا تُقْصِرِي",6,"ر",2,0],["جَافِيَاً وَالرِّفْقُ فِي جَفُوتِهِ","حَدِباً فِي خَيْرِ مَعْنَىً لِلحَدَبْ",7,"ب",1,0],["جافَى المَضَاجعَ ما يَنفَكُّ مِن لَجبٍ،","يَكَادُ يُقْمِرُ مِنْ لألائهِ القَمَرُ",8,"ر",1,0],["جَافِلاَتٍ يَتَبَارَينَ بِنَا","كَالقَطَا يَنحو إِلَى بَاقِى الوَشَل",9,"ل",1,0],["جافي المضاجع مصغى السمع منتصب","يجيب مسألة من لا يناديه",10,"ي",2,0],["جافيتني والذنبُ ذنبك","وظلمتني فالله حسبُكْ",11,"ك",1,1],["جافتك أفراح الحية","وضمّك الألم الوجيع",12,"ع",1,0],["جافي جنوب رجال عن مضاجعها","وبات يولع أشجاناً بأكباد",13,"د",1,0],["جافوا المقام وقاموا في مساجدهم","يبكون حباً وشوقاً والسوى هجدوا",14,"د",3,0],["جاف فلا يطوى بحدك فافهما","فما بعد هذا للمدراك غاية",15,"ه",1,0],["جافت مضاجعَها الرِجالُ وغادَرَت","أَزواجَها فكأَنَّهنَّ أراملُ",16,"ل",1,0],["جافي الكرى أجفانه","فغدت زيارته لمام",17,"م",1,0],["جافى بهمته الكرى","عن مقلتيه من الفطام",18,"م",1,0],["جافٍ عَنِ الدَفَّينِ مَرفَقُهُ","غَوجُ اللَبانِ أُمِرَّ مَصنَعُهُ",19,"ع",2,0],["جافيت عيني عن مضاجع غفوها","عمن يرجى عفوه عن هفوها",20,"ه",2,0],["جاف اللئيم وحاذر أن تجاوره","فاللؤم كل شريف من مراميه",21,"ي",2,0],["جافيني النوم مدري ليه جافيني ؟","وجا / فيني من الذكريات اللي يكفيني",22,"ن",2,1],["جافتك من بعد الوصال ذكاء","فجراح قلبك مالها إشفاءُ",23,"ا",2,1]]}