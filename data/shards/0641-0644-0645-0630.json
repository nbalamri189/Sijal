{"poems":[[78,"فأين الزيج والقانو","https://www.aldiwan.net/poem39000.html","مجزوء الرمل"],[354,"إذا المولى لعبد صار سمعا","https://www.aldiwan.net/poem15853.html","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48339","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48440","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77059","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44898","الخفيف"]],"verses":[["فلِمْ ذا يطلُبُ الرزقَ","طِلابَ العاجزِ الهِمَّه",0,"م",2,0],["فَلَم ذا في الأَحَبِّ إِلَيهِ يَنفي","مَقالَةَ مَن يَقولُ بِهِ تَجَلّى",1,"ل",2,0],["فلِمْ ذا يَصوبُ الدّمْعُ والطرفُ شاخِصٌ","وأطْوي الحَشا لهْفاً على لهَب الجَمْرِ",2,"ر",1,0],["فلِمْ ذا نهَتْ غَيْثَها أنْ يَصوبَ","وما منعَتْ ربْعَها أن يَشوقا",3,"ق",2,0],["فَلَم ذا عَدَلتُ عَن ذاكَ قُل لي","أَدلالا قاطَعَتني أَم ملالا",4,"ل",2,0],["فلمذا إِذن هَجَرت وَلَم تَهْ","جُرَ قَلبي يا مَنيتي وَمُرادي",5,"د",2,0]]}