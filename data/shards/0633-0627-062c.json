",""],[5957,"حبي الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=12485",""],[5957,"لأنكَ فجريَ الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=176901",""],[5974,"خمرُ شفاهها","https://www.poetsgate.com/ViewPoem.aspx?id=200326",""],[6093,"تمويه","https://www.poetsgate.com/ViewPoem.aspx?id=200186",""],[6124,"سأجرجر ذيل الخيبة","https://www.poetsgate.com/ViewPoem.aspx?id=174944",""],[6125,"أنا ابنُ السَّيفِ عرَّابُ المَنَايا","https://www.poetsgate.com/ViewPoem.aspx?id=210963",""],[6152,"قلبي ينبض بكِ","https://www.poetsgate.com/ViewPoem.aspx?id=204527",""],[6328,"وقفة ندم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82140&r=&rc=15",""],[572,"سَاجِلْ بفصلِكَ من أَردْتَ وباهِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9225&r=&rc=82",""]],"verses":[["سَأَجْني حُروباً تُتَقَّى غَمَراتُها","وَتُحْقَنُ فيهنَّ الدِّماءِ وَتُسْفَكُ",0,"ك",1,0],["سَأَجهَلُ بَعدَ هَذا الحِلمِ حَتّى","أُريقُ دَمَ الحَواضِرِ وَالبَوادي",1,"د",2,0],["سَأَجعَلُ نَفسي لَهُم جُنَّةً","فَلا تُكثِري بي مِنَ اللائمَه",2,"م",2,0],["سَأَجِدُّ فِي طَلَبِي فَأَسْتَدْنِي بِهِ","زَمَناً أَصِيرُ وَفِي يَدَيَّ عِنَانِي",3,"ن",2,0],["سأجري عليها الدمع غير مُضيَّع","وأندُبُ قاعاً من هناك فقاعا",4,"ع",2,0],["سَأَجعَلُ نَقدَ أُمِّكَ غَيرَ دَينٍ","وَأُنسيكَ العِتابَ فَلا عِتابا",5,"ب",2,0],["سأجعل شكري مثل ميت كما تشا","ليعظم رب العالمين لي الأجرا",6,"ر",2,0],["ساجع يورق المنابر ميساً","فتلذّ الأسجاع فوقَ الغصون",7,"ن",1,0],["ساجي اللّواحظ خمريّ مقبله","داجي الذوائب بدريّ محيَّاه",8,"ا",2,0],["ساجلَتْ جاهَهُ سحائبُ عُرفٍ","من يَمينَيْهِ دائماتُ الصَّبيبِ",9,"ب",1,0],["ساجِعاً سَجعاً شَجِيّا","ذاكِراً تِلكَ الدِيار",10,"ر",1,0],["سأجهر بالحق الذي يكتمونه","وان قطعوا بالسيف يا حق اوصالي",11,"ل",2,0],["ساجِعُ الشَرقِ طارَ عَن أَوكارِهِ","وَتَوَلّى فَنٌّ عَلى آثارِهِ",12,"ر",2,1],["سَأَجْمَحُ في حُبِّ البطالةِ والصِّبا","وإِنْ لامَ فيهِ عاذِلٌ ونَصِيحُ",13,"ح",1,0],["سَأَجعَلُهُ حَكَماً في النُفوسِ","وَلَو نابَ عَنهُ لِساني كَفاني",14,"ن",2,0],["سأجلُبُها أشباهَ ما حمَلَتْهُ من","أسنَّتِها جرداً مُقَسطلَةً غُبْرا",15,"ر",2,0],["سَأَجهَدُ في شُكرٍ لِنُعماكَ إِنَّني","أَرى الكُفرَ لِلنَعماءِ ضَرباً مِنَ الكُفرِ",16,"ر",1,0],["سَأُجزيكَ مَعروفَ الَّذي نِلتَني بِهِ","بِكَفَّيكَ فَاِسمَع شِعرَ مَن قَد تَنَخَّلا",17,"ل",2,0],["سَأُجزيكَ مِن سَوآتِ ما كُنتَ سُقتَني","إِلَيهِ جُروحاً فيكَ ذاتَ كِلامِ",18,"م",1,1],["سأجعلُ المَدْحَ فيكم جُلَّ مأرُبتي","وهل يَعافُ زهيرُ المَدْحَ في هَرِمِ",19,"م",1,0],["سأجشم نفسي عن مصاحبة الشرى","ونص المهاري القود ما قد تجشما",20,"م",2,0],["ساجيةَ الظِّلالِ مُقرِّطاتٍ","ظُروفَ الراحِ من زَنجٍ ورُومِ",21,"م",1,0],["سَأَجزي رَهطَ جَسّاسٍ","كَحَذوِ النَعلِ بِالنَّعلِ",22,"ل",1,0],["سَأُجَزّي بَقاءَ أَيّامِ عُمري","بَينَ بَثّي وَعَبرَتي وَاِكتِئابي",23,"ب",2,0],["سَأَجهَدُ عَزمي وَالمَطايا فَإِنَّني","أَرى العَفوَ لا يُمتاحُ إِلّا مِنَ الجَهدِ",24,"د",1,0],["سَأَجهَدُ حَتّى أُبلِغَ الشِعرَ شَأوَهُ","وَإِن كانَ لي طَوعاً وَلَستُ بِجاهِدِ",25,"د",1,0],["سَأَجتَنِبُ الدارَ الَّتي أَنتُمُ بِها","وَلَكِنَّ طَرفي نَحوَكُم سَوفَ يَعدِلُ",26,"ل",1,0],["ساجٍ كَما يَرنو إِلى عُوّادِهِ","شاكٍ وَيَلتَمِحُ العَزيزَ ذَليلُ",27,"ل",1,0],["سَأَجعَلُ عِرضي جُنَّةً دونَ عِرضِها","وَديني فَيَبقى عِرضُ لَيلى وَدينُها",28,"ن",3,0],["سَأَجتَنِبُ الدارَ الَّتي أنتُمُ بِها","وَلَكنَّ طَرفي نَحوَها سَوفَ يَعمَلُ",29,"ل",1,0],["سأجعل حجّتي ماسرجسايا","رضيتُ بذاك حجّي واعتماري",30,"ر",2,0],["سأجزيك شراً بِالَّذي قد عملته","من الشر إني يا سليمي لأقدر",31,"ر",1,0],["سأَجدّ مرتحلاً إلى دار البلى","بعد المقام وَلا يَطول رَحيلي",32,"ل",2,0],["سَاجِداً لِلهِ لاَ يَرْ","ضَى لِمَخْلُوقٍ سُجُودا",33,"د",2,0],["سَأَجزيكِ أَو يَجزِيكِ عَنّي مُثَوِّبٌ","وَقَصرُكِ أَن يُثنى عَلَيكِ وَتُحمَدي",34,"د",2,0],["ساجليني يا ربّة الحسن أشوا","قي وعاني معي الغرام المعنّي",35,"ن",2,0],["ساجي الرياحِ كأنما حلَفَ الصَّبا","أن لا يمُرَّ عليه غيرُ عليله",36,"ل",2,0],["سأَجْزِيهِ بِها رَصَداتِ شُكْرٍ","على عدواءِ داري واجتنابي",37,"ب",2,0],["سأجزِيكَ من سَوْءاتِ ما كنتَ سُقتَني","إلَيْهِ جُرُوحاً فِيكَ ذاتَ كِلامِ",38,"م",1,0],["سأَجْتَنِببُ الدَّارَ الّتي أَنْتُمُ بِهَا","ولكنّ طرفي نحوكم سوفَ يعدل",39,"ل",1,0],["سأجري عليها الدمعَ غير مضيع","وأنوب قاعاً من هناك فقاعا",40,"ا",1,0],["ساجعُ الشؤقِ طارَ عن أوكاره","وتَوَلَّى فنٌّ على آثاره",41,"ر",2,1],["ساجَلتها مني الأَماني وَقالَت","هاكَ رقي وَدّاً وَهَذا كِتابي",42,"ب",2,0],["سأجزيهِ بسفح الدمع منه","وأحرمه الكرى دهرىً طويلا",43,"ل",2,0],["ساجِل بِراحَتِكَ البِحارَ فَإِنَّها","بَحرٌ تَضَمَّنَ مِن بَنانِكَ أَبحُرا",44,"ر",2,0],["سَأَجعَلُ نَفسي لَهُ جُنَّةً","بِشاكي السِلاحِ نَهيكٍ أَريب",45,"ب",1,0],["سَأَجعَلُ نَفسي لِلمَتالفِ عُرضَةً","وَأَقذِفُها لِلمَوتِ وَالمَوتُ أَكرَمُ",46,"م",1,0],["سَأَجعَلُها لأَجمَعِكُم شِعاراً","وَقَد يَمضي اللِسانُ بِما يَقولُ",47,"ل",1,0],["سأجهد النفسَ حتى أَغتْدي وأُرَى","عبداً لمولايَ يَرضاه ويُرِضْيهِ",48,"ي",2,0],["سأجعل وُدّي بالثناء مُكَلّلاً","عليك وصَمْتي عنك لي فيك شاتم",49,"م",1,0],["سَأَجعَلُهُ لي عُدَّةً وَذَخيرَةً","أَعِزُّ بِهِ وَالعِزُّ خَيرٌ مِنَ المالِ",50,"ل",1,0],["سَأَجزيكُم بِما أَبلَيتُموني","وَقَد يَأتي الثَوابُ مِنَ الكَريمِ",51,"م",1,0],["سَأجهدُ نَفسي في اِبتِكارِ قَصيدَةٍ","فَتونِ المَعاني لَذَّةِ المُتَرَنِّمِ",52,"م",1,0],["سأجعل لي إلى نيل المعالي","مكارم نجل محمود عتادا",53,"د",2,0],["سأجعل نجمي ساطعاً فوقَ رَمسِهِ","فقد كان ذا نفسٍ من النَّجمِ أرفعا",54,"ع",2,0],["سَأَجْعَلُ هَمِّي فِي الشَّدائِدِ هِمَّتِي","فَكَمْ كرْبَةٍ بِالْهَمِّ فُرِّجَ ضِيقُها",55,"ق",3,0],["سَأَجمَعُ بِالشَمولِ شَتَيتَ شَملي","لِكَي آسو أَسى قَلبي الجَريحِ",56,"ح",1,0],["ساجعٌ حَنَّ إلى ذاتِ جَناحِ","والدُجى في الأُفْقِ كالسِتْرِ المُزاحِ",57,"ح",1,1],["سَأَجعل ديدني كَأسي وَأنسي","بذكرك في اِصطِباحي وَاِغتِباقي",58,"ق",2,0],["سأجمعُ أَشتاتَ العزيمةِ قاذِفاً","بأيدي المطايا تَلطِمُ البِيدَ دُمَّغا",59,"غ",2,0],["ساجلَتْ فضْلَكَ الكُفاةُ ولكنْ","غَرَبٌ عُودُهمْ وعُودُكَ نَبْعه",60,"ع",2,0],["ساجي الرَّنا يَمشي بقَدٍّ أَهْيفٍ","يهزؤُ بالغُصْنِ الرطيب إنْ مَشا",61,"ا",1,0],["سأجعلهم ما عشت أهلي وجيرتي","وأسلو بهم عن مفرد الناس والجمع",62,"ع",1,0],["سأجزيه على النعماء شكراً","بما يرضيه من عبدٍ شكور",63,"ر",1,0],["ساجي اللواحظ ورديُّ الخدود له","خالٌ من الزنج فوق الثغر مرباط",64,"ط",1,0],["ساجي المحيا عريض الخد يحسدهُ","بدر السما ولذاك البدر ينخسفُ",65,"ف",1,0],["سأجعل الصبر في جيك معتصما","لعل رأيك لي بالخير ينعطف",66,"ف",1,0],["سأجعل فوق أكوار المطايا","وكوري بالصباح وبالعشيه",67,"ي",2,0],["سأَجري مع الناس في شوطهم","فَعالاً بغيضاً وقولاً وديدا",68,"د",2,0],["ساجي اللواحظ في هيمانه قلق","صاح من الحب في أعطافه ثمل",69,"ل",1,0],["ساجدٌ للصليب منهُ وما","يعرفُ دينَ الصليبِ والزنَّار",70,"ر",1,0],["سَأَجعَلُ بَغضَتي لِلدَهرِ فَرَضا","وَأَسلُكُ ذَمَّهُ طولاً وَعَرضا",71,"ض",2,1],["سآجر نفسي عن تقاضيه راضياً","إلى أن أراه ساخطاً بعد فعله",72,"ل",2,0],["سأجمل نفسي عنك فعل مخفف","وابقي على ودي وشكر لساني",73,"ن",2,1],["سَأَجيبُ داعي الحُبِّ مُنقاداً لَهُ","إِن كانَ مَن أَحبَبتُ غَيرَ مُجاوِبي",74,"ب",2,0],["سأجعله ما عشت عيداً معظما","وأوصي به بعدي إذا مت يجعل",75,"ل",1,0],["ساجِلْ بفصِّك مَنْ أرَدْتَ وباهِهِ","فكفى به كدًّا لِقَلْبِ الحاسِدِ",76,"د",1,1],["سَأَجْهَدُ إِمَّا لِلمَنايا أَو المُنَى","قُصَاراي إِمّا النَّصْرُ أَو ما جَنَى النَّصْلُ",77,"ل",1,0],["ساجلت في العلياء اهراما لنا","بل مجد فعلك زاد عنها طولا",78,"ل",2,0],["سَأَجئ هَذِهِ الدار يَوماً لاحِقاً","مَن غادَروا بِالقَلب برح سَعير",79,"ر",1,0],["سأجْزِيك شكري ما حَييت فإن أمتْ","أُبقِّ ثناءً فيكَ يَبْقى إلى الحَشرِ",80,"ر",1,0],["ساجعُ الورقِ على الأغصانِ غنَّى","أطربَ الخالِيَ واجتاحَ المُعنَّى",81,"ن",2,1],["سأَجمَع في ذمّ الزَمان وَذمّهم","كَجمع أَبي جادِ الحروفَ من الهجا",82,"ج",2,0],["سأجعلُ في تلك الصّفاتِ تَغَزُّلي","بنَظْمٍ عجيبٍ يُعْجِزُ بنَ دؤادِ",83,"د",1,0],["ساجِي الجُفونِ وَقاحُ الوَجْهِ ماجِنُهُ","مفرَّغُ البالِ عَمَّنْ باتَ يَهواهُ",84,"ا",2,0],["سأجعل فيك الصبر للقلب حيلة","وأخضع لو يُجدي لديك بنا الذل",85,"ل",1,0],["ساجلتها بدموع طلُّ وابلها","زانَ الحدائق تقليداً وتوشيحا",86,"ح",2,0],["سأجهدُ العين في طعم المنام عسى","وسائل الفكر تلقاه فتخدعه",87,"ع",2,0],["سأجعل قرباني الى الله حبه","وحب بنيه الطهر آل محمد",88,"د",1,0],["ساجي اللحاظ تريك صنعه عينه","فتكاتِ مسنون الغرار صنيعِ",89,"ع",1,0],["ساجي اللحاظ رحيب الصدر أسلمه","زاهي الجبين شنيب الشغر أح