ن فقد لانت حواشيه","https://www.aldiwan.net/poem50733.html","البسيط"],[229,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[235,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[249,"لقد دافعت علقمة بن عمرو","https://www.aldiwan.net/poem2090.html","الوافر"],[252,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[261,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[270,"ليالي النوى حتام ترخين برقعا","https://www.aldiwan.net/poem35627.html","الطويل"],[280,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[282,"دعا داعي الصباح إلى الصبوح","https://www.aldiwan.net/poem32829.html","الوافر"],[298,"ساجع حن إلى ذات جناح","https://www.aldiwan.net/poem36843.html","عموديه"],[353,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[364,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[364,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[402,"سقى العقيق فالديار فاللوى","https://www.aldiwan.net/poem46428.html","الرجز"],[403,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[416,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[429,"راقت لعينيك يوم البين دمياط","https://www.aldiwan.net/poem40264.html","البسيط"],[429,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[437,"في طول عمرك عمن قد مضى خلف","https://www.aldiwan.net/poem2602.html","البسيط"],[441,"ألا شغف الفؤاد بحب ليلى","https://www.aldiwan.net/poem14328.html","الوافر"],[458,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[464,"قالوا الإمام عماد الدين معتقل","https://www.aldiwan.net/poem3120.html","عموديه"],[464,"قم نديمي فاسفك دم الزق","https://www.aldiwan.net/poem3306.html","عموديه"],[468,"سأجعل بغضتي للدهر فرضا","https://www.aldiwan.net/poem59922.html","الوافر"],[513,"إلى الله أشكو من بداني بوصله","https://www.aldiwan.net/poem67707.html","الطويل"],[515,"سأجمل نفسي عنك فعل مخفف","https://www.aldiwan.net/poem12297.html","الطويل"],[553,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[564,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[567,"ساجل بفصك من أردت وباهه","https://www.aldiwan.net/poem69735.html","الكامل"],[586,"ملامك لا ربط لديه ولا حل","https://www.aldiwan.net/poem17642.html","الطويل"]],"verses":[["سَأَجْني حُروباً تُتَقَّى غَمَراتُها","وَتُحْقَنُ فيهنَّ الدِّماءِ وَتُسْفَكُ",0,"ك",1,0],["سَأَجهَلُ بَعدَ هَذا الحِلمِ حَتّى","أُريقُ دَمَ الحَواضِرِ وَالبَوادي",1,"د",2,0],["سَأَجعَلُ نَفسي لَهُم جُنَّةً","فَلا تُكثِري بي مِنَ اللائمَه",2,"م",2,0],["سَأَجِدُّ فِي طَلَبِي فَأَسْتَدْنِي بِهِ","زَمَناً أَصِيرُ وَفِي يَدَيَّ عِنَانِي",3,"ي",1,0],["سأجري عليها الدمع غير مُضيَّع","وأندُبُ قاعاً من هناك فقاعا",4,"ع",2,0],["سَأَجعَلُ نَقدَ أُمِّكَ غَيرَ دَينٍ","وَأُنسيكَ العِتابَ فَلا عِتابا",5,"ب",2,0],["سأجعل شكري مثل ميت كما تشا","ليعظم رب العالمين لي الأجرا",6,"ر",2,0],["ساجع يورق المنابر ميساً","فتلذّ الأسجاع فوقَ الغصون",7,"ن",1,0],["ساجي اللّواحظ خمريّ مقبله","داجي الذوائب بدريّ محيَّاه",8,"ا",2,0],["ساجلَتْ جاهَهُ سحائبُ عُرفٍ","من يَمينَيْهِ دائماتُ الصَّبيبِ",9,"ب",1,0],["ساجِعاً سَجعاً شَجِيّا","ذاكِراً تِلكَ الدِيار",10,"ر",1,0],["سأجهر بالحق الذي يكتمونه","وان قطعوا بالسيف يا حق اوصالي",11,"ي",1,0],["ساجِعُ الشَرقِ طارَ عَن أَوكارِهِ","وَتَوَلّى فَنٌّ عَلى آثارِهِ",12,"ر",2,1],["سَأَجْمَحُ في حُبِّ البطالةِ والصِّبا","وإِنْ لامَ فيهِ عاذِلٌ ونَصِيحُ",13,"ح",1,0],["سَأَجعَلُهُ حَكَماً في النُفوسِ","وَلَو نابَ عَنهُ لِساني كَفاني",14,"ن",2,0],["سأجلُبُها أشباهَ ما حمَلَتْهُ من","أسنَّتِها جرداً مُقَسطلَةً غُبْرا",15,"ر",2,0],["سَأَجهَدُ في شُكرٍ لِنُعماكَ إِنَّني","أَرى الكُفرَ لِلنَعماءِ ضَرباً مِنَ الكُفرِ",16,"ر",1,0],["سَأُجزيكَ مَعروفَ الَّذي نِلتَني بِهِ","بِكَفَّيكَ فَاِسمَع شِعرَ مَن قَد تَنَخَّلا",17,"ل",2,0],["سَأُجزيكَ مِن سَوآتِ ما كُنتَ سُقتَني","إِلَيهِ جُروحاً فيكَ ذاتَ كِلامِ",18,"م",1,1],["سأجعلُ المَدْحَ فيكم جُلَّ مأرُبتي","وهل يَعافُ زهيرُ المَدْحَ في هَرِمِ",19,"م",1,0],["سأجشم نفسي عن مصاحبة الشرى","ونص المهاري القود ما قد تجشما",20,"م",2,0],["ساجيةَ الظِّلالِ مُقرِّطاتٍ","ظُروفَ الراحِ من زَنجٍ ورُومِ",21,"م",1,0],["سَأُجَزّي بَقاءَ أَيّامِ عُمري","بَينَ بَثّي وَعَبرَتي وَاِكتِئابي",22,"ي",1,0],["سَأَجهَدُ عَزمي وَالمَطايا فَإِنَّني","أَرى العَفوَ لا يُمتاحُ إِلّا مِنَ الجَهدِ",23,"د",1,0],["سَأَجهَدُ حَتّى أُبلِغَ الشِعرَ شَأوَهُ","وَإِن كانَ لي طَوعاً وَلَستُ بِجاهِدِ",24,"د",1,0],["سَأَجتَنِبُ الدارَ الَّتي أَنتُمُ بِها","وَلَكِنَّ طَرفي نَحوَكُم سَوفَ يَعدِلُ",25,"ل",1,0],["ساجٍ كَما يَرنو إِلى عُوّادِهِ","شاكٍ وَيَلتَمِحُ العَزيزَ ذَليلُ",26,"ل",1,0],["سَأَجعَلُ عِرضي جُنَّةً دونَ عِرضِها","وَديني فَيَبقى عِرضُ لَيلى وَدينُها",27,"ن",3,0],["سَأَجتَنِبُ الدارَ الَّتي أنتُمُ بِها","وَلَكنَّ طَرفي نَحوَها سَوفَ يَعمَلُ",28,"ل",1,0],["سأجعل حجّتي ماسرجسايا","رضيتُ بذاك حجّي واعتماري",29,"ر",2,0],["سأجزيك شراً بِالَّذي قد عملته","من الشر إني يا سليمي لأقدر",30,"ر",1,0],["سأَجدّ مرتحلاً إلى دار البلى","بعد المقام وَلا يَطول رَحيلي",31,"ي",1,0],["سَاجِداً لِلهِ لاَ يَرْ","ضَى لِمَخْلُوقٍ سُجُودا",32,"د",2,0],["سَأَجزيكِ أَو يَجزِيكِ عَنّي مُثَوِّبٌ","وَقَصرُكِ أَن يُثنى عَلَيكِ وَتُحمَدي",33,"د",2,0],["ساجليني يا ربّة الحسن أشوا","قي وعاني معي الغرام المعنّي",34,"ن",2,0],["سأجزي رهط جساس","كحذو النعل بالنعل",35,"ل",1,0],["ساجي الرياحِ كأنما حلَفَ الصَّبا","أن لا يمُرَّ عليه غيرُ عليله",36,"ل",2,0],["سأَجْزِيهِ بِها رَصَداتِ شُكْرٍ","على عدواءِ داري واجتنابي",37,"ب",2,0],["سأجزِيكَ من سَوْءاتِ ما كنتَ سُقتَني","إلَيْهِ جُرُوحاً فِيكَ ذاتَ كِلامِ",38,"م",1,0],["سأَجْتَنِببُ الدَّارَ الّتي أَنْتُمُ بِهَا","ولكنّ طرفي نحوكم سوفَ يعدل",39,"ل",1,0],["سأجري عليها الدمعَ غير مضيع","وأنوب قاعاً من هناك فقاعا",40,"ا",1,0],["ساجعُ الشؤقِ طارَ عن أوكاره","وتَوَلَّى فنٌّ على آثاره",41,"ر",2,1],["ساجَلتها مني الأَماني وَقالَت","هاكَ رقي وَدّاً وَهَذا كِتابي",42,"ي",1,0],["سأجزيهِ بسفح الدمع منه","وأحرمه الكرى دهرىً طويلا",43,"ل",2,0],["ساجِل بِراحَتِكَ البِحارَ فَإِنَّها","بَحرٌ تَضَمَّنَ مِن بَنانِكَ أَبحُرا",44,"ر",2,0],["سَأَجعَلُ نَفسي لَهُ جُنَّةً","بِشاكي السِلاحِ نَهيكٍ أَريب",45,"ب",1,0],["سَأَجعَلُ نَفسي لِلمَتالفِ عُرضَةً","وَأَقذِفُها لِلمَوتِ وَالمَوتُ أَكرَمُ",46,"م",1,0],["سَأَجعَلُها لأَجمَعِكُم شِعاراً","وَقَد يَمضي اللِسانُ بِما يَقولُ",47,"ل",1,0],["سأجهد النفسَ حتى أَغتْدي وأُرَى","عبداً لمولايَ يَرضاه ويُرِضْيهِ",48,"ي",2,0],["سأجعل وُدّي بالثناء مُكَلّلاً","عليك وصَمْتي عنك لي فيك شاتم",49,"م",1,0],["سَأَجعَلُهُ لي عُدَّةً وَذَخيرَةً","أَعِزُّ بِهِ وَالعِزُّ خَيرٌ مِنَ المالِ",50,"ل",1,0],["سَأَجزيكُم بِما أَبلَيتُموني","وَقَد يَأتي الثَوابُ مِنَ الكَريمِ",51,"م",1,0],["سَأجهدُ نَفسي في اِبتِكارِ قَصيدَةٍ","فَتونِ المَعاني لَذَّةِ المُتَرَنِّمِ",52,"م",1,0],["سأجعل لي إلى نيل المعالي","مكارم نجل محمود عتادا",53,"د",2,0],["سأجعل نجمي ساطعاً فوقَ رَمسِهِ","فقد كان ذا نفسٍ من النَّجمِ أرفعا",54,"ع",2,0],["سَأَجْعَلُ هَمِّي فِي الشَّدائِدِ هِمَّتِي","فَكَمْ كرْبَةٍ بِالْهَمِّ فُرِّجَ ضِيقُها",55,"ق",3,0],["سَأَجمَعُ بِالشَمولِ شَتَيتَ شَملي","لِكَي آسو أَسى قَلبي الجَريحِ",56,"ح",1,0],["ساجعٌ حَنَّ إلى ذاتِ جَناحِ","والدُجى في الأُفْقِ كالسِتْرِ المُزاحِ",57,"ح",1,1],["سَأَجعل ديدني كَأسي وَأنسي","بذكرك في اِصطِباحي وَاِغتِباقي",58,"ي",1,0],["سأجمعُ أَشتاتَ العزيمةِ قاذِفاً","بأيدي المطايا تَلطِمُ البِيدَ دُمَّغا",59,"غ",2,0],["ساجلَتْ فضْلَكَ الكُفاةُ ولكنْ","غَرَبٌ عُودُهمْ وعُودُكَ نَبْعه",60,"ع",2,0],["ساجي الرَّنا يَمشي بقَدٍّ أَهْيفٍ","يهزؤُ بالغُصْنِ الرطيب إنْ مَشا",61,"ا",1,0],["سأجعلهم ما عشت أهلي وجيرتي","وأسلو بهم عن مفرد الناس والجمع",62,"ع",1,0],["سأجزيه على النعماء شكراً","بما يرضيه من عبدٍ شكور",63,"ر",1,0],["ساجي اللواحظ ورديُّ الخدود له","خالٌ من الزنج فوق الثغر مرباط",64,"ط",1,0],["ساجي المحيا عريض الخد يحسدهُ","بدر السما ولذاك البدر ينخسفُ",65,"ف",1,0],["سأجعل الصبر في جيك معتصما","لعل رأيك لي بالخير ينعطف",66,"ف",1,0],["سأجعل فوق أكوار المطايا","وكوري بالصباح وبالعشيه",67,"ي",2,0],["سأَجري مع الناس في شوطهم","فَعالاً بغيضاً وقولاً وديدا",68,"د",2,0],["ساجي اللواحظ في هيمانه قلق","صاح من الحب في أعطافه ثمل",69,"ل",1,0],["ساجدٌ للصليب منهُ وما","يعرفُ دينَ الصليبِ والزنَّار",70,"ر",1,0],["سَأَجعَلُ بَغضَتي لِلدَهرِ فَرَضا","وَأَسلُكُ ذَمَّهُ طولاً وَعَرضا",71,"ض",2,1],["سآجر نفسي عن تقاضيه راضياً","إلى أن أراه ساخطاً بعد فعله",72,"ل",2,0],["سأجمل نفسي عنك فعل مخفف","وابقي على ودي وشكر لساني",73,"ي",1,1],["سَأَجيبُ داعي الحُبِّ مُنقاداً لَهُ","إِن كانَ مَن أَحبَبتُ غَيرَ مُجاوِبي",74,"ي",1,0],["سأجعله ما عشت عيداً معظما","وأوصي به بعدي إذا مت يجعل",75,"ل",1,0],["ساجِلْ بفصِّك مَنْ أرَدْتَ وباهِهِ","فكفى به كدًّا لِقَلْبِ الحاسِدِ",76,"د",1,1],["سَأَجْهَدُ إِمَّا لِلمَنايا أَو المُنَى","قُصَاراي إِمّا النَّصْرُ أَو ما جَنَى النَّصْلُ",77,"ل",1,0]]}