{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[47,"مستجير الهوى بغير مجير","https://www.aldiwan.net/poem25293.html","الخفيف"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[89,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[85,"ما جل فيهم عيدك المأثور","https://www.aldiwan.net/poem62883.html","الكامل"],[62,"تصعيد هذا الدهر والتصويب","https://www.aldiwan.net/poem52503.html","الكامل"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[49,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[49,"سبحان علام الغيوب","https://www.aldiwan.net/poem10349.html","مجزوء الكامل"],[49,"أين المفر من القضاء","https://www.aldiwan.net/poem10381.html","مجزوء الكامل"],[49,"المرء في تأخير مدته","https://www.aldiwan.net/poem62014.html","الطويل"],[49,"رب أمر يسوء ثم يسر","https://www.aldiwan.net/poem62071.html","الخفيف"],[49,"الخلق مختلف جواهره","https://www.aldiwan.net/poem62115.html","الكامل"],[49,"ما يرتجى بالشيء ليس بنافع","https://www.aldiwan.net/poem62159.html","الكامل"],[49,"لا عيش إلا الموت يقطعه","https://www.aldiwan.net/poem62171.html","السريع"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[49,"الدهر يوعد فرقة وزوالا","https://www.aldiwan.net/poem63071.html","الكامل"],[49,"الهرص داء قد أضربمن","https://www.aldiwan.net/poem63074.html","مجزوء الكامل"],[49,"كن عند أحسن ظن من ظنا","https://www.aldiwan.net/poem63145.html","الكامل"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[80,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[44,"ضاحكن من أسف الشباب المدبر","https://www.aldiwan.net/poem29983.html","الكامل"],[105,"من يسعد الأوطان غير بنيها","https://www.aldiwan.net/poem43401.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"سبحان علام الغيوب","https://www.aldiwan.net/poem62447.html","مجزوء الكامل"],[50,"غلط الفتى في قوله","https://www.aldiwan.net/poem63839.html","مجزوء الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[113,"قطعوا من فؤادي الأوصالا","https://www.aldiwan.net/poem41685.html","الخفيف"],[118,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[130,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[140,"كان الوداد منغصا لوشاتنا","https://www.aldiwan.net/poem58379.html","الكامل"],[141,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[184,"دنيا ختام نعميها بحمامها","https://www.aldiwan.net/poem43307.html","الوافر"],[184,"الناس يخدع بعضهم بعضا","https://www.aldiwan.net/poem43665.html","الكامل"],[209,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[233,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[233,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[248,"حتام تخدع عزمي الآمال","https://www.aldiwan.net/poem15007.html","الكامل"],[279,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[301,"تفنى العواصف والغمام خيامنا","https://www.aldiwan.net/poem57762.html","الكامل"],[359,"يا أيها الظبي الذي","https://www.aldiwan.net/poem68056.html","مجزوء الكامل"],[362,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[362,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[362,"نشر المنى طاوي السهوب","https://www.aldiwan.net/poem60995.html","مجزوء الكامل"],[369,"ولقلما حكم الزمان","https://www.aldiwan.net/poem57299.html","مجزوء الكامل"],[369,"كتبت جفونك فوق خدك أسطرا","https://www.aldiwan.net/poem57467.html","الكامل"],[406,"كتم الجوى القلب القريح","https://www.aldiwan.net/poem32502.html","مجزوء الكامل"],[456,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[513,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"]],"verses":[["وَلَقَلَّما شَرِقَت أَسِنَّتُهُ","إِلّا وَصَفوُ الحَمدِ يُشرِقُهُ",0,"ق",2,0],["ولِقُلَّتَيْ أرْوَنْدَ رَنّةُ ثاكِلِ","حرّانَ حينَ ثَوى أبو الأيْتامِ",1,"م",1,0],["وَلِقَلبي مِن حُسنِ وَجهِكَ شُغلٌ","عَن هَوى قاصِراتِ تِلكَ القُصورِ",2,"ر",1,0],["ولَقلَّ ما يُجْدِي على متبجِّحٍ","ذكْرٌ يُماتُ بنَشْرِه فيُبادُ",3,"د",1,0],["ولقلَّ ما ينجو امرؤٌ من مثلها","بالرأي إلّا أنْ يكونَ أصيلا",4,"ل",2,0],["ولقلَّ ما جاد امرؤٌ ليستْ له","نفسٌ ترى حدَّ الزمانِ فليلا",4,"ل",2,0],["وَلَقَلَّما يُصبِحنَ إِلّا شُزَّباً","يَركَبنَ مِن عَرَضِ الحَوادِثِ حالا",5,"ل",2,0],["وَلِقَلبي كَما لِقَلبِكَ أَحلا","مٌ حِسانٌ فَإِنَّهُ غَيرُ جَلمَد",6,"د",1,0],["ولِقلبي شوق إليك أراه","عن قريب يجرُّني للّحود",7,"د",1,0],["وَلَقُلتُ يا قَومُ اُنظُروا اِنجيلَكُم","هَل فيهِ مِن قَلَمِ الفَقيدِ سُطورُ",8,"ر",1,0],["ولقلَّما عادَ الرجاءُ مصدِّقاً","حيثُ التَوى وتعثَّر المطلُوبُ",9,"ب",1,0],["وَلَقَلَّ يَومٌ ذَرَّ شارِقُهُ","إِلّا سَمِعتَ بِهالِكٍ يُنعى",10,"ا",1,0],["وَلَقَلَّ مَن تَصفو خَلائِقُهُ","وَلَقَلَّ مَن يَصفو لَهُ المَحيا",10,"ا",1,0],["وَلَقَلَّ ما تَبقى فَكُن مُتَوَقَّعاً","وَلَقَلَّ ما يَصِفو سُرورُكَ إِن صَفا",11,"ا",1,0],["وَلَقَلَّ ما يَنجو الفَتى ال","مَحمودُ مِن لَطخِ العُيوبِ",12,"ب",1,0],["وَلَقَلَّ ما تَنفَكُّ مِن","حَدَثٍ يَجيءُ لِيَذهَبا",13,"ب",2,0],["وَلَقَلَّما تُبقي الخُطوبُ عَلى","أَشَرِ الشَبابِ وَحَرِّ وَقدَتِهِ",14,"ت",2,0],["وَلَقَلَّ اِمرُؤٌ يُفارِقُ ما يَع","تادُ إِلّا وَقَلبُهُ مُقشَعِرٌّ",15,"ر",1,0],["وَلَقَلَّ ما تَصفو طَبائِعُهُ","وَيَصِحُّ باطِنُهُ وَظاهِرُهُ",16,"ر",2,0],["وَلَقَلَّ يَومٌ مَرَّ بي أَو لَيلَةٌ","لَم يَقرَعا كَبِدي بِخَطبٍ رائِعِ",17,"ع",1,0],["وَلَقَلَّ ما جَرَتِ الخُطوبُ فَلَم","تَخطُر عَلى قَلبٍ تُرَوِّعُهُ",18,"ع",2,0],["وَلقَلَّ ما تَلقى أَغَرَّ لِنَفسِهِ","مِن لاعِبٍ مَرِحٍ بِها مُختالِ",19,"ل",1,0],["وَلَقَلَّ ما تَصفو الحَياةُ لِأَهلِها","حَتّى تُبَدَّلَ مِنُهُم أَبدالا",20,"ل",2,0],["وَلَقَلَّ ما دامَ السُرورُ لِمَعشِرٍ","وَلَطالَما خانَ الزَمانُ وَغالا",20,"ل",2,0],["وَلَقَلَّ ما تَرضى خِصالاً مِن أَخٍ","آخَيتَهُ إِلّا سَخِطتَ خِصالا",20,"ل",2,0],["وَلَقَلَّ ما تَسخو بِخَيرٍ نَفسُهُ","حَتّى يُقاتِلَها عَلَيهِ قِتالا",20,"ل",2,0],["وَلَقَلَّ ما تَلقى اللَئي","مَ عَلَيكَ إِلّا مُستَطيلا",21,"ل",2,0],["وَلَقَلَّ ما اِعتَقَدَ اِمرُؤٌ هِبَةً","إِلّا رَأَيتَ لَهُ بِها ضَنّا",22,"ن",2,0],["ولَقَلَّما يصحو امرؤ حكَمَت","فيهِ كُؤوسُ الأَعيُنِ النُّجُلِ",23,"ل",1,0],["وَلَقَلَّمَا يبقى رمادُهُمُ إذا","طارَتْ بِهِ في الجَوِّ ريحٌ صَرْصَرُ",24,"ر",1,0],["وَلَقَلَّما عَبَّيتُ خَيلَ مَدائِحي","إِلّا رَجَعتُ بِهِنَّ غَيرَ مُظَفَّرِ",25,"ر",1,0],["وَلَقَلَّما أَرضى اِمرُؤٌ أَوطانَهُ","حَتّى تَراهُ بِنَفسِهِ يَفديها",26,"ي",3,0],["ولقلبي فيك الغُلوُّ وأنَّى","لِلِساني في مَدْحِكَ الغُلواءُ",27,"ا",2,0],["وَلَقَلَّما يَنجو الفَتى","بِتُقاهُ مِن لُطَخِ العُيوبِ",28,"ب",1,0],["وَلَقَلَّ ما طَلَبَ الفَتى","لِأَخيهِ عَيباً لَم يَجِده",29,"د",2,0],["وَلَقَلَّما نَزَلَ الخَيالُ بِمُقلَةٍ","رَوعاءَ نافِرَةٍ بِغَيرِ رُقادِ",30,"د",1,0],["ولقلبي والنار شأن عظيم","كل آنٍ لظاهما يتعالى",31,"ل",2,0],["ولقلب الأخلاق يطعنه الغر","ويجري دماء كالماء",32,"ا",2,0],["ولِقَلبِهِ في كُلِّ مَعنًى جَولَةٌ","فَتَرَاهُ مِن معنًى جَائِلا",33,"ل",2,0],["ولقلتُ ما هذا بأوّلِ ناقضٍ","عهدا ولا هذا بأوّلِ غادرِ",34,"ر",1,0],["وَلَقَلَّما يَصِفُ المَحاسِنَ واصِفٌ","إِلّا وَظَلَّ بِحُسنِهِ مُتَمَثِّلا",35,"ل",2,0],["ولقل ما يجد امرؤ من نفسه","طوع الرويّة في قصور ذمامها",36,"م",3,0],["ولقلّما تلقى بها أحدا","متنزّها يحمي له عرضا",37,"ض",2,0],["ولقلبينا سؤالٌ وجواب","لا تقل إنّا مع العتب غضاب",38,"ب",1,0],["وَلَقَلَّما طَرَقَ الخَيالُ قَريحَةً","بِالدَمعِ جَرياً لِلجُفونِ مَنامُها",39,"م",3,0],["وَلَقَلَّما وَجَدَ المَريضُ لِدائِهِ","بُرءاً إِذا كانَ الطَبيبَ المُسقِمُ",40,"م",1,0],["ولقلما يخشى الحوادث من غدا","وله إلى آل الزبيرِ مآل",41,"ل",1,0],["ولقلّما تلفى المترجم غالباً","الا يقصِّر في الذي أداه",42,"ا",2,0],["ولقلما يبقى على مطر السما","خامٌ تراه على البلى مقصورا",43,"ر",2,0],["وَلَقُلت لَيسَ بعاقِل","من في هَوى الغُزلان هام",44,"م",1,0],["ولقلّما غَرِيَ الحسودُ بفاضلٍ","مُتَنقِّصاً إلاّ وزيدَ تَمكُّنا",45,"ن",2,0],["ولَقلّتِ الأرواحُ لو نَثَروا له","لو كانتِ الأرواحُ مِمّا يُنثَر",46,"ر",1,0],["ولقلَّما يسلو المُحبْ","بُ أخو الحِفاظ عن الحبيب",47,"ب",1,0],["ولقلَّما حكمَ الزَّما","نُ عَلى امرئٍ إِلا وحافا",48,"ف",2,1],["ولقلَّما يجني زماني بعدها","إلا لقيتُ بما جناهُ مُيسَّرا",49,"ر",2,0],["ولَقَلَّما تَبقى وكم","تَبقى معَ التّعذيبِ رُوحُ",50,"ح",1,0],["ولقلَّدتك على الأمور قلائداً","جيدُ الزمان بحلْيهنَّ ثقيلُ",51,"ل",1,0],["ولقلت إن الصوم ليس بواجب","فيه وأن الفطر غير حرام",52,"م",1,0]]}