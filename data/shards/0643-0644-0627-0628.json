{"poems":[[55,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[90,"لنا ملك وليس له رعايا","https://www.aldiwan.net/poem44793.html","الوافر"],[90,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[23,"كلاب وتيم ألصقا ابن أخيهما","https://www.aldiwan.net/poem21504.html","الطويل"],[74,"مرحبا بالنظم يأتي","https://www.aldiwan.net/poem18489.html","مجزوء الرمل"],[91,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[45,"قد سمعنا ما قلت في الأحلام","https://www.aldiwan.net/poem10523.html","الخفيف"],[45,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[30,"فرب ربيع بالبلاليق قد رعت","https://www.aldiwan.net/poem5246.html","الطويل"],[30,"ألم أرم عنكم إذ عجزتم عدوكم","https://www.aldiwan.net/poem5418.html","الطويل"],[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[104,"جنى عليك الحسن يا وردتي","https://www.aldiwan.net/poem33063.html","أحذ المديد"],[54,"يا دهر يا صاحب الفجيعات","https://www.aldiwan.net/poem27201.html","المنسرح"],[48,"رأيت قضاء الله أوجب خلقه","https://www.aldiwan.net/poem22113.html","الطويل"],[78,"رجاء دون أقربه السحاب","https://www.aldiwan.net/poem39489.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62228","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43845","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[211,"أبى قومنا إلا الفرار ومن تكن","https://www.aldiwan.net/poem27898.html","الطويل"],[366,"لا تأمن الدهر ان الدهر خوان","https://www.aldiwan.net/poem68052.html","البسيط"],[369,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[369,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[449,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[454,"لم تغن عن هفوات النفس آداب","https://www.aldiwan.net/poem980.html",""],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[463,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122536","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88602","البسيط"],[804,"","https://poetry.dctabudhabi.ae/diwan/poem/73831","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64177","البسيط"],[930,"","https://poetry.dctabudhabi.ae/diwan/poem/132401","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62451","الوافر"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73535","الكامل"],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18377","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49571","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118384","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28068","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18081","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93533","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141194","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94034","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94083","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93875","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93877","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58477","المتقارب"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67974","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62941","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62929","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110097","الكامل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140277",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91093","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117860","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93259","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139541",""],[4743,"ألم تر ليثا ما الذي ختمت به","https://www.poetsgate.com/ViewPoem.aspx?id=186662",""],[4778,"التاريخ يعيد نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=196522",""],[4858,"من وحي أدائي العمرة","https://www.poetsgate.com/ViewPoem.aspx?id=139900",""],[4862,"أيا عمرو بن هندٍ لاتلمنا","https://www.poetsgate.com/ViewPoem.aspx?id=55366",""],[4915,"ذاتٌ مغرورة","https://www.poetsgate.com/ViewPoem.aspx?id=211339",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[4988,"أقضب لسانك","https://www.poetsgate.com/ViewPoem.aspx?id=196640",""],[5191,"اغتراب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=212654",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5369,"قومي يا نؤوم","https://www.poetsgate.com/ViewPoem.aspx?id=177446",""],[5431,"الرحمى ....","https://www.poetsgate.com/ViewPoem.aspx?id=215240",""],[5458,"كلاب مسعورة","https://www.poetsgate.com/ViewPoem.aspx?id=113373",""],[5496,"مابال قلبى!","https://www.poetsgate.com/ViewPoem.aspx?id=213942",""],[5533,"عَجيبٌ أَمْرُ أُمِّتنا","https://www.poetsgate.com/ViewPoem.aspx?id=176269",""],[5533,"ذَهَبَ الشَّباب","https://www.poetsgate.com/ViewPoem.aspx?id=177714",""],[5853,"من أجل سوريا ..الأبية","https://www.poetsgate.com/ViewPoem.aspx?id=175672",""],[6093,"تَزيدُ قناعتيْ حِيْناً فحيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177693",""],[6093,"السَّمَهَّى","https://www.poetsgate.com/ViewPoem.aspx?id=211002",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""]],"verses":[["كِلابٌ تُبَصبِصُ خَوفَ الهَوانِ","وَتَنبَحُ بَينَ يَدَي مَن غَلَب",0,"ب",1,0],["كُلُ اِبنِ أُنثى وَإِن طالَت سَلامَتُهُ","يَوماً عَلى آلَةٍ حَدباءَ مَحمولُ",1,"ل",1,0],["كلاب للأجانب هم ولكن","على أبناء جِلدتهم أسود",2,"د",1,0],["كل ابنِ آدم مقهور بعادات","لهنّ يَنقاد في كل الارادات",3,"ت",1,1],["كِلابٌ وَتَيمٌ أَلصَقا اِبنَ أَخيهِما","وَلَولاهُما كانوا عَبيدَ بَني بَكرِ",4,"ر",1,1],["كلّ إبن لي وبنت","كشكال لي وشبحه",5,"ح",2,0],["كل ابيات شعرها نغمات","فاستمع ساعة الى النغمات",6,"ت",1,0],["كُلُّ آبائِهِ كِرامُ بَني الدُن","يا وَلَكِنَّهُ كَريمُ الكِرام",7,"م",1,0],["كُلُّ اِبنِ سابِقَةٍ يُغيرُ بِحُسنِهِ","في قَلبِ صاحِبِهِ عَلى الأَحزانِ",8,"ن",1,0],["كِلاباً نَبَحنَ اللَيثَ مِن كُلِّ جانِبٍ","فَعادَ عُواءً بَعدَ نَبحٍ هَريرُها",9,"ر",3,0],["كِلابٌ وَكَعبٌ ذِروَتانِ تَلاقَتا","بِمَجدَينِ لا زَوجِ الخَلِيَّةِ نائِلُه",10,"ل",2,0],["كِلابٌ أَغارَت في فَريسَةِ ضَيغَمٍ","طُروقاً وَهامٌ أُطعِمَت صَيدَ أَجدَلا",11,"ل",2,0],["كلاَّ بل النَّفسُ التي تَضْعُفُ","تصطنعُ البأْسَ فلا تعرفُ",12,"ف",1,0],["كِلابُ حَيٍّ إِذا حَضَرتُ فَإِن","غِبتُ فُواقاً فَأُسدُ غاباتِ",13,"ت",1,0],["كِلابٌ تَغاوَت أَو تَعاوَت لِجيفَةٍ","وَأَحسَبُني أَصبَحتُ أَلأَمَها كَلبا",14,"ب",2,0],["كِلابٌ لَوْ سَأَلْتَهُمُ تُرَاباً","لَقالوا عِنْدَنا انْقَطَعَ التُّرَابُ",15,"ب",1,0],["كلا بل الطير حرّ","هناك في النغمات",16,"ت",1,0],["كِلاَبٌ وكَعْبٌ لاَ يَبِيتُ أَخُوهُمُ","ذَلِيلاً ولاَ تُعْيِي عَلَيْهِ المَسَالِكُ",17,"ك",1,0],["كُلُّ أَبلَجٍ رَكَضَت","أسدُهُ بِضُمَّرِها",18,"ر",3,0],["كَلّا بَلِ المُصطَفى شَفيعي","حَقّاً يَقيناً بِلا شُكوكِ",19,"ك",1,0],["كلُّ ابنِ أنثى في الْحَياةِ إِلى مدىً","والمرءُ في الدُّنيا إِلى مِيقاتِهِ",20,"ت",2,0],["كِلابٌ وَما تَفعَل كِلابٌ فَإِنَّها","وَكَعبٌ سَراةَ البَيتِ ما لَم تَهَدِّمِ",21,"م",1,0],["كُل اِبن أُنثى فان المَوت يَصرعَه","قَد اِستَوى فيهِ أَشياخ وَشُبّان",22,"ن",1,0],["كُلُّ ابنِ مُنْجِبةٍ بصَدْرِ جَوادِه","في الرَّوْعِ يَغْشَى حَدَّ كُلِ سِنان",23,"ن",1,0],["كُلٌّ أبو القاسمِ المأْمولُ كُنيتُه","كذا قضَى اللهُ ربُّ العَرْشِ في الأزَل",24,"ل",1,0],["كل ابنائها يذوق جمال ال","علم حتى شريرهم والخسيس",25,"س",1,0],["كل ابن آدم خطاء وخيرهم","التائبون ورب العرش تواب",26,"ب",1,0],["كلّ أبٍ سيماه في وجه ابنه","يرَوْن منه مثل ما يروونا",27,"ن",2,0],["كلُّ آباءٍ له ما احتكم ال","شرفُ الفارعُ والبيتُ الأصيلُ",28,"ل",1,0],["كلُّ ابن ذات أربعٍ تحسبه","ذاتَ جَناحين إذا تَمطَّرا",29,"ر",2,0],["كلّ ابن آدم خطّاء وخيرُهُمو","من أنفق العمرَ أوّاباً فما بخِلا",30,"ل",2,1],["كُلُّ ابنِ مُحصَنةٍ بالزَّغفِ مُلتحِفٌ","ثَوباً وبالمغفرِ العادي مُنتقِبُ",31,"ب",1,0],["كل ابن حرب ببرد الصبر مشتمل","بأَساً وفي مستشار النقع ملتثم",32,"م",1,0],["كِلابٌ تَهِرُّ إِلى شاعِرٍ","وَتَكشِفُ لِلشَّرِّ أَنيابَها",33,"ب",3,0],["كلابسٍ مِطرفاً مرُخٍ جوانبهُ","تضاحِكُ البيضُ من أَطرافِه السودا",34,"د",2,0],["كلاب المزابل آذينني","بأبوالهن على باب داري",35,"ي",1,1],["كلاب مثل ورد الروض لونا","تصاد بهَا وحوش أو ذئابُ",36,"ب",1,0],["كُلٌّ أَبوه آدمٌ وَطلابُهُ","إِرثُ الخِلافَةِ مِن أَبيهِ آدَمِ",37,"م",1,0],["كِلابٌ عَوَت لا قَدَّسَ اللَهُ أَمرَها","فَجاءَت بِصَيدٍ لا يَحِلُّ لِآكِلِ",38,"ل",1,0],["كلاَّ بذلتَ ولا مَنٌّ ولا مَذَلٌ","ولا اعتلالٌ ولا ليٌّ ولا جَنَف",39,"ف",1,0],["كل ابن انثى سوف يع","لو فوقه الترب المهيل",40,"ل",1,0],["كُلُّ اِبنِ أُختٍ زائِدٌ أَهلَ أُمِّه","وَأَنتَ اِبنَ أُختي ناقِصٌ غَيرَ زائِدِ",41,"د",1,1],["كِلابِيَّةً وَبرِيَّةً حَنثَرِيَّةً","نَأَتكَ وَخانَت بِالمَواعيدِ وَالذِمَم",42,"م",1,0],["كُل ابن معركة يشق","دُجى الوَغى في خَير أَهبه",43,"ب",2,0],["كُلاَّ بِفَردِ قياسٍ نِصفَ إصبَعِكُم","في كلٍّ راسٍ لِتَكفِيكَ التطاويلُ",44,"ل",1,0],["كلاب عاديات بل ذئاب","ولكن فوق أظهرهم ثياب",45,"ب",1,0],["كلا بل الألمعي اللوذعي بدا","منه بدائع أسجاع وأشعار",46,"ر",1,0],["كلا بل الكون أمسى مشرقاً بسنا","إقبال نجل سعيد سعده ظاهر",47,"ر",1,0],["كلا بل الدهر قد تصدى","يريد رمي النهى بأولق",48,"ق",1,0],["كلا بل الأفراح أبدت طالعاً","حظى الزمان بحظه الموفور",49,"ر",1,0],["كِلابٌ وَلكنها فُضِّلَتْ","على بَعضِ قومِ مَشوا في الثِّيابِ",50,"ب",1,0],["كل ابن هيجاء تغذى بما","تحلبه اللدن فلن يعظما",51,"م",2,0],["كلابٌ مثلُ وردِ الرَّوْضِ لوناً","يُصاد بِهَا وحوشٌ أَو ذِئابُ",52,"ب",1,0],["كِلابٌ بالعَواصمِ عاويات","وبالخابورِ رامحةٌ زَبُونُ",53,"ن",1,0],["كِلابٌ على جُندِ العَواصمِ كاسمِها","كِلابٌ لها دونَ البيوتِ هَرِيرُ",54,"ر",1,0],["كلُّ ابنِ انثَى يعتزي لفُلانةٍ","والعزُّ في أَن يعتزي لفُلانِ",55,"ن",1,0],["كلابس مطرفاً مرخ ذوائبه","يميل كالغصن لما مال ترديدا",56,"د",2,0],["كل ابن رابش أَمرٌ إن دعوت له","خير البَرية أَضحى جد بوران",57,"ن",1,0],["كل ابن أنثى لا محالة صائر","قنصاً لمخلب ذلك الصياد",58,"د",1,0],["كلابهم فهالها بطشهما","هرت وهدت شديد الذعر",59,"ر",1,0],["كِلابٌ بَغَونا فَوقَ سُودِ سَفِينِهِم","يَسُوقُهُمُ داعي المَنَايا تَعَمُّدا",60,"د",2,0],["كلاب البر والعقبان","تنهش لحمها حتما",61,"م",2,0],["كلابٌ دسن شيبته","وناصع لحيةٍ تبدو",61,"و",1,0],["كلُّ ابن سابقةٍ إِذا ابتدر المَدى","فلغير غُرَّتِه يمينُ اللاطم",62,"م",1,0],["كلاب حرب غدت في الحرب إذ نشبت","أظفارها بدم الأطهار تختضب",63,"ب",1,0],["كلاب تعاوت ضلل الله سعيها","فجاءت بصيد لا يحل لآكل",64,"ل",1,0],["كلّ ابن آدم قد أتاها عنوة","أمسى الغداة بسحرها مسكونا",65,"ن",2,0],["كلُّ ابنِ آدمَ مخطئٌ ،وخيارُهم","مَن راح يُصلحُ فاسداً ويُجدِّدُ",66,"د",1,0],["كلاب القوم قد نبحت علينا","لأنا لم نعد نحمي العرينا",67,"ن",2,0],["\"كُلُّ ابنِ آدمَ خطَّاءٌ\" سوايَ فمَن","يَعيبُني عابَ مِن دُنياهُ أَحسنَها",68,"ن",3,0],["كلاب تقود الجند نحو خنادق","لتكشف فيها ما تحرك أو دبا",69,"ب",2,0],["كل ابوكم ينحرق به حرق ويهون","ناري ان شبّت ترى ماهي رحيمه",70,"م",2,0],["كلّ ابن آدم أوّالٌ إلى العطبِ","وكلّ عيشٍ لنا وهمٌ من الكذبِ",71,"ب",1,1],["كلّ ابتلاءٍ سيأتي بعده فرجٌ","مثل البراري تشافي ملحها السحبُ",72,"ب",1,0],["كلاب الترك نُكثا باغتونا","وقائدهم (أتاتُرك) المشوم!",73,"م",1,0],["كلاب لاختبارٍ مصنعيٍّ","تَذللنا على المعنى أصاخا",74,"خ",2,0],["كلاب الروم تنبح لا لجوع","ولا ظمأ يهد