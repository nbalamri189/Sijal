{"poems":[[55,"وقفنا لهم من وراء الخطو","https://www.aldiwan.net/poem30668.html","المتقارب"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[95,"إني أقمت على التعلة","https://www.aldiwan.net/poem11123.html","مجزوء الكامل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[29,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[53,"قالوا أأرهنت دما","https://www.aldiwan.net/poem65721.html","مجزوء الرجز"],[45,"رويدك أيها الملك الجليل","https://www.aldiwan.net/poem9757.html","الوافر"],[30,"يسقين بالموماة زغبا نواهضا","https://www.aldiwan.net/poem5464.html","الطويل"],[68,"وحق من لا سواهم عندي القسم","https://www.aldiwan.net/poem39644.html","البسيط"],[48,"أيا والي المصر لا تظلمن","https://www.aldiwan.net/poem23005.html","المتقارب"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[108,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[119,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[136,"يا من جعلتم رضا المولى تجارتكم","https://www.aldiwan.net/poem54756.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[203,"تقاصر عمر الظلام الطويل","https://www.aldiwan.net/poem45365.html","المتقارب"],[208,"لسان الفتى حتف الفتى حين يجهل","https://www.aldiwan.net/poem53017.html","الطويل"],[240,"خليفة الله الذي","https://www.aldiwan.net/poem31808.html","مجزوء الرجز"],[240,"يا من إذا ضنت الأيام جائرة","https://www.aldiwan.net/poem31815.html","البسيط"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[275,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[280,"فديتك ما هذا التراخي وإنما","https://www.aldiwan.net/poem25402.html","الطويل"],[285,"بنفسي من تضيء به الدياجي","https://www.aldiwan.net/poem60619.html","الطويل"],[310,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[369,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[396,"رسول الله جئنا زائر ينا","https://www.aldiwan.net/poem54467.html","عموديه"],[445,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[447,"تشفلط جلدي والليالي تشفلط","https://www.aldiwan.net/poem14310.html","الطويل"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[520,"أصبت في خير أعضائي وأعضادي","https://www.aldiwan.net/poem12069.html","البسيط"],[556,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138418",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83309","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83307","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138818",""],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123435","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70923","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71025","الطويل"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122924","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64473","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64411","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78168","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1828,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113789","الكامل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69470","البسيط"],[2293,"","https://poetry.dctabudhabi.ae/diwan/poem/198994","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144192","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65152","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132708","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48315","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48295","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48444","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126949","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109963","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109914","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35565","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75691","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135069","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83345","المجتث"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133206",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67482","السريع"],[3591,"أشد عوادي الدهر خلق لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=149432",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5533,"زَفَاف","https://www.poetsgate.com/ViewPoem.aspx?id=179727",""],[5561,"على قارعة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=195028",""],[5809,"اولاد تسعة","https://www.poetsgate.com/ViewPoem.aspx?id=205339",""],[6070,"تَمامُ العقلِ يحلو بالكلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=188890",""],[6093,"خُلقنا هكذا سودا وبيضا","https://www.poetsgate.com/ViewPoem.aspx?id=176237",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5616,"أننسى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1925&r=&rc=0",""]],"verses":[["وَمَن أَمطَرَتهُ سَماءُ الغِنى","هَوى في سيولِ قَراراتِها",0,"ت",3,0],["وَمِنْ أَمِيرٍ بَنَاهَا دَوْلَةً أُنُفاً","قَامَتْ عَلَى أَثَرٍ مِنْ مَجْدِهَا تَرِبِ",1,"ب",1,0],["وَمِنِ امْتِدَاحٍ خَالَهُ الْ","أُدَبَاءُ فِيَّ وَلَسْتُ أَهْلَهْ",2,"ل",2,0],["وَمَنْ أَمْكَنَتْهُ فُرْصَةٌ غَيْرَ عَالِمٍ","بِمَا بَعْدَهَا فَلْيَنْهَبِ الصَّفْوَ مَغْنَمَا",3,"م",2,0],["وَمِنّا مَن يُجيزُ حَجيجَ جَمعٍ","وَإِن خاطَبتَ عَزَّكُمُ خِطابا",4,"ب",2,0],["وَمَن أُمسي وَأُصبِحُ لا أَراهُ","وَيَطرُقُني إِذا هَجَعَ النِيامُ",5,"م",1,0],["ومن أمنِ نفس أن تخاف ولم يكن","لتأمن من مكروهة لا تروعها",6,"ع",3,0],["ومن أماديحي له","من كيسه لا سرقه",7,"ق",2,0],["وَمَن أَمَرَ الحُصونَ فَما عَصَتهُ","أَطاعَتهُ الحُزونَةُ وَالسُهولُ",8,"ل",1,0],["وَمِن أَمرِ حَزمٍ قَد وَلَيتَ نَجِيَّهُ","بِرَأيٍ جَميعٍ مُستَمِرٍّ قُوى الحَبلِ",9,"ل",1,0],["وَمَن أُمَوَّهُ بِالذِكرى لِغَيرِهِمُ","مُعَرِّضاً بِسِواهُمِ وَالمُرادُ هُمُ",10,"م",1,0],["وَمَن أَمَّنَتهُ خُطوبُ المَنونِ","تَخَوَّفَ مِن هَرَمٍ أَو خَرَف",11,"ف",1,0],["ومِن أُمّ النّجُومِ عليه دِرْعٌ","يُحاذِرُ أن يُمَزّقَها الطّعَانُ",12,"ن",1,0],["ومن أمسى له طه ظَهيرًا","فقد آوَى إلى رُكن شديد",13,"د",1,0],["ومن امتطى ظهر الخلاف لأمرهم","لازال وهو منكد مقهور",14,"ر",1,0],["ومن أمَارَتِكُم في الناس أنَّكُمُ","لا تُذكُرونَ وِإن جَلَّت إِمَارَتَكُم",15,"م",1,0],["وَمِن أُمّه نورٌ بدا عند وضعهِ","بهِ عينُها من مكّةٍ أبصرت بصرى",16,"ر",2,0],["ومن أملِ الناسِ ما لا يُنالْ","كما أنَّ في الناسِ من لا يُنيلْ",17,"ل",1,0],["ومن أمن الآفات عجباً برأيه","أحاطت به الآفات من حيث يجهلُ",18,"ل",1,0],["وَمَن أُمورُ الدينِ وَال","دُنيا بِهِ مُتَّسِقَه",19,"ق",2,0],["وَمَن أَمِنتُ بِهِ دَهري وَحادِثَهُ","وَلَستُ أَخشاهُ إِن داجى وَإِن صافا",20,"ف",2,0],["ومن أمة أمية جئت للورى","بشعب على نيل العلى يتدرب",21,"ب",1,0],["ومن أموالِنا صُنعَت لتودي","بكلِّ فتىً همامٍ ألمعيِّ",22,"ي",1,0],["ومن أمّ دفرٍ حذّرَ الناس قبلنا","فإيّاكَ والتعريج منها على دفر",23,"ر",1,0],["وَمَنْ أَمَلِي لِزَوْرَتِهِ غُرُورٌ","وَمَنْ نَوْمِي لِفُرْقَتِهِ غِرارُ",24,"ر",1,0],["وَمَن أمَّ بَيتاً أَنتَ ركنُ فَخارهِ","فَلا وزراً يَخشاه بعد وَلا وِزرا",25,"ر",2,0],["ومَنِ امتطى ظَهْرَ الزّمانِ جَرَتْ به","غُلوَاءُ طاغٍ للعنانِ مُقلَّد",26,"د",1,0],["ومن أمور بقلبي","تطول فيها الشكيه",27,"ه",1,0],["ومن أمر مهول قد عرانا","أتينا هار بين وشاردينا",28,"ن",2,0],["ومَنْ أُمُّهُ أَجْيادُ والرُّكْنُ ظِئرُهُ","ومُرْضِعُهُ البَطحاءُ والحِجْرُ مَهْدُهُ",29,"د",2,0],["ومن أمل المغرور يحسب للذي","يجيء ولم يحسب لما منه يقلط",30,"ط",1,0],["ومِن أَمَلِي في سيّد الوزراء لي","مطاعمُ يَغْنَى عن سواها كَسوبُها",31,"ب",3,0],["ومن آمن لم يخش ضيما ولا عنى","فنحن أسود الكون في كل رتبة",32,"ه",1,0],["ومن أمنت على سري ليحفظه","فيما يعود بإصلاح وإفساد",33,"د",1,0],["ومَنْ أمَّ جَمْعاً والمطيُّ لواغبٌ","تماطل مِضْماضَ الكَرى وتماكسُ",34,"س",1,0],["ومن امتطى متن الخطا فليبتعد","منه فليس يفيده مهما اعتنى",35,"ن",2,0],["ومن امتطى متن الفخار ففي سبي","ل الحق من قبل الأسنة قد ركب",36,"ب",1,0],["وَمِن أُمَّةِ الأَلمانِ جَيشٌ عَرَمرَمٌ","يَسيرُ بِهِ مِن أَبعَدِ الأَرضِ عاهِلُه",37,"ل",2,0],["وَمِن أُمراءِ الشَرقِ حَولَكَ عُصبَةً","سُطاكَ كَرسيها وَشَمُّ حُصونِها",38,"ن",3,0],["وَمَن اِمتَطى للاختلاس مطيةً","قذفت بِهِ في الهُلكِ حينَ يُحاكَم",39,"م",1,0],["ومن أمهات طاهرات من الخنا","تؤدبنا في حبهم فتأدبنا",40,"ن",2,0],["ومن أُمَمٍ ما أُوزِعَتْ شُكرَ عَذبه","فصبَّ عليها الله سَوطَ عذابه",41,"ب",2,0],["ومن أميُنك إنْ أهملتَ ما لك في","دارِ تؤلفُ بين الهِرِّ والفار",42,"ر",1,0],["ومن أمركم حتفُ الكفور وحبسُه","فدأبكمُ الهيجاء والعفو والقسْرُ",43,"ر",1,0],["ومن أمارة هذا أن تؤوِّلَ ما","أشكَل عليك إظهاراً لخافيه",44,"ي",2,0],["ومن أمثالهن اذا انتشينا","ترانا نجتني ثمر الغرام",45,"م",1,0],["ومن أمتن الأشياء قدر تشده","يمينك تطوي عنه كل شديدة",46,"ه",1,0],["ومن أمد القوى حتى يحصل في","من كان هيأها حتى بدا الأثر",47,"ر",1,0],["وَمِن أُمَّهُ مِن فاقة عادَ مَثرياً","وَيَرجع بَعدَ الذُل وَالفَقر مسعدا",48,"د",2,0],["ومن أمين الندى فاعقد يديك على","أوفى البريَّةِ في أوفى الندى ذمما",49,"م",2,0],["ومنا من تكلم بعد موت","فأخبر عن مصير الميتينا",50,"ن",2,0],["ومنا من رأى جبريل شفعاً","ومنا في النبي الغائلونا",50,"ن",2,0],["ومنا من أبرَّ اللَه ربي","له قسماً وقل المقسمونا",50,"ن",2,0],["ومنا من كسرتم يوم أودَى","عليه من لواء أربعينا",50,"ن",2,0],["ومنا مدرك بن أبي صعيرة","ومُذكوا الحرب ثم المخمدونا",50,"ن",2,0],["ومن أَمسى بحيِّ بني صَريح","إِلى حَرسٍ وحيّ بني عدان",51,"ن",1,0],["ومنا منفذ الطين","وأصحاب اللحى الحمر",52,"ر",1,0],["ومنا من صما يوماً","فقد هرّب في المصر",52,"ر",1,0],["ومنا من تمشّى يم","سح البلدان كالنسر",52,"ر",1,0],["وَمَن أَمطَرَني حَتّى","ثَناني مُونِقاً زَهري",53,"ر",2,0],["ومن امتطى سحَّ العُبابِ فإنهُ","يصغي إلى صوغ المعاني الأزهَرِيَّه",54,"ه",1,0],["وَمِن إِمامِ الهُدى المَنصورِ يَلحَقُهُ","قَهرُ الأُمورِ وَحَزمٌ حينَ يَقتَرِعُ",55,"ع",1,0],["ومن أم صبيان وسحر وبغضة","ومن ربط ذي عرس تكلف في عرس",56,"س",1,0],["ومن امره اعطى حينا لزادهم","اخو الفرق من كالريض قدر من التمر",57,"ر",1,0],["ومن أملي أنْ يسترقّكُما الهوى","فننجو جميعاً أو نُصاب جميعا",58,"ع",2,0],["ومن امتطى بعلاهُ كاهل دهره","وإليه في كلّ الفنون يُشارُ",59,"ر",1,0],["ومنا مطلق من بعد اسر","يكابد فيه سجناً واعتقالا",60,"ل",2,0],["ومَنْ أمَّ بحْرَ الجودِ والعِلْمِ لا يُرَى","على غيْرِ مَولانا ابْن نصْرٍ معَرِّجا",61,"ج",2,0],["ومنْ أمّل الموْلى الخليفةَ يوسُفاً","فلا مَقْصَدٌ ينأى ولا يتعذَّرُ",62,"ر",1,0],["ومَن أمّل العُقْبَى لديكَ فضدّهُ","يُرَدُّ على الأعقابِ منهُ ويُنْكَصُ",63,"ص",1,0],["ومن أمية لا تبقي وإن كثرت","بالطعن والضرب أجساداً ولا مهجا",64,"ج",2,0],["ومن امتطى صهوات خدمة ربه","خدمته واستاقت إليه حبورا",65,"ر",2,0],["ومَن أَمِنَ الحَيَّاتِ أَرداهُ سُمُّها","كذاكَ الذي أَمسَى سميرَ العقاربِ",66,"ب",1,0],["ومن إمارة هذا أن تؤول ما","يحتاج شرعاً لتأويل وتنبيه",67,"ي",2,0],["وَمن أَمّ وِردَ اِبن يَحيى الرِضا","فَكَيفَ يحاذر أَن يَعطَشا",68,"ش",2,0],["ومن اِمتَطى من كل علم ذروة","ما نالها من قبله متسنم",69,"م",1,0],["ومن أمكم قد نال مجداً وسؤدداً","وفي بابكم لم يسط للمنتمي عسر",70,"ر",1,0],["وَمَن أَمات وَأَحيا","جَلاله وَجَمالُه",71,"ل",2,0],["ومن أمسى تابعاً هدي الذين مضت","أعمارهم في الهدى طمعاً لنيل الثواب",72,"ب",1,0],["ومن إمام كان لي وصله","إلى كحيل العين بالسحر",73,"ر",1,0],["ومن أمل الجدوى لديه كأنما","يؤمل مآء من سعير هشيم",74,"م",1,0],["ومَنِ اْمتَطَى خَيلَ القَصَائِدِ واْقتَفَى","أَثرَ الأُلَى فِي نَظمِهَا وبِنَائِهَا",75,"ا",3,0],["ومن أمن الدهر فى صرفه","أتاه من الأمن ما يحذره",76,"ر",2,0],["ومن أَمْثالِهِ ذَكَرٌ وأُنْثَى","يَرُومُ وِدَادَها يَوْمَ التَّصافِي",77,"ف",2,0],["ومَن أمِنَ القِصاصَ أساءَ دوما","وتعرُكُهُ على وجعٍ شؤونُ",78,"ن",1,0],["ومنّا مَن أتى في يومِ سبتٍ","ومنّا مَن أتى في يومِ جُمْعةْ",79,"ع",2,1],["ومنّا مَن أتى مِن قبلِ شهرٍ","وآخرُ لم يتمِّمْ غيرَ سبعةْ",79,"ع",2,0],["وَمِنْ أمثالهِ خلقٌ كثيرٌ","تراهُمْ بالحَديثِ بلا زِمامِ",80,"م",1,0],["ومنَّا من له بدنٌ وروحٌ","بلونٍ واحدٍ ،مَنعَ النقيضا",81,"ض",2,0],["ومن أم طفل كلما در ثديها","هفا قلبها حزنا وعز اصطبارها",82,"ر",3,0],["وَمِنا مؤبد بالسُجون عَذابهم","وَفينا بَعد مَحكوم حكم اعدام",83,"م",1,0],["وَمِنا مؤبد بِالسُجون عذابهم","وَمصفدين رقابهم بغلال",84,"ل",1,0],["ومِنّا من يرى في الخيش خزاً","ومنّا مَن يضايقهُ الحرير ! !",85,"ر",1,0]]}