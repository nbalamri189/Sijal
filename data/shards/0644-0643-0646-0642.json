sgate.com/ViewPoem.aspx?id=203199",""],[4444,"غلبت عليكم هذه القدريه","https://www.poetsgate.com/ViewPoem.aspx?id=85456",""],[5703,"طفلةٌ بلهاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210566",""],[5736,"رجل شرقي","https://www.poetsgate.com/ViewPoem.aspx?id=208226",""],[5737,"الفقد","https://www.poetsgate.com/ViewPoem.aspx?id=177805",""],[5790,"لا أستزيدك ودا","https://www.poetsgate.com/ViewPoem.aspx?id=111903",""],[5818,"أنا لست لِصًّا سيّدي","https://www.poetsgate.com/ViewPoem.aspx?id=193190",""],[5853,"زهرة الاشجان","https://www.poetsgate.com/ViewPoem.aspx?id=175718",""],[5875,"شيّب المهاريف","https://www.poetsgate.com/ViewPoem.aspx?id=187017",""],[5907,"تعب ضيقه!","https://www.poetsgate.com/ViewPoem.aspx?id=176258",""],[5912,"لجة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=205020",""],[5923,"سورية الميساء","https://www.poetsgate.com/ViewPoem.aspx?id=150626",""],[5943,"حراس القدس ملائكة","https://www.poetsgate.com/ViewPoem.aspx?id=45279",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"‏ بم سوف تشعر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=185413",""],[5956,"خوفي تحقق","https://www.poetsgate.com/ViewPoem.aspx?id=194821",""],[5956,"سوريّةُ العربية","https://www.poetsgate.com/ViewPoem.aspx?id=204722",""],[5957,"أبدعتَ في دور المحب","https://www.poetsgate.com/ViewPoem.aspx?id=53702",""],[6035,"ياابن الوليد وياسعد وياعمرو","https://www.poetsgate.com/ViewPoem.aspx?id=175127",""],[6127,"رحلة الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=192766",""],[5014,"غريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76217&r=&rc=13",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6238,"قلب قزح...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86772&r=&rc=1",""],[6294,"غَادري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69311&r=&rc=28",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""]],"verses":[["لَكِنَّ قَوْمِي إِذَا ضَنُّوا تَدَارَكَهُمْ","سَخَاءُ مُعْتَذِرٍ عَنْ أَلْفِ مُخْتَزِنِ",0,"ن",1,0],["لَكِنَّ قَوْمِي أَبْرَارُ القُلُوبِ بِهِ","دَعِ المُرِيبَ الَّذِي يَدْعُو إِلَى وَهَمِ",1,"م",1,0],["لَكِنْ قَضَى الشَّرْقُ أَنْ يَشْقَى أَفَاضِلُهُ","وَأَنْ يَكُونَ جَزَاءَ العَامِلِ الكَلِمُ",2,"م",1,0],["لكن قائده ما كان يَمْأنه","ولا يُبالي بأمرٍ من مَعانته",3,"ت",2,0],["لَكِن قَضاءُ اللَهِ وَال","أَحكامِ تَنفُذُ في البَرِيَّه",4,"ي",2,0],["لكن قومي وإن كانوا ذوِي عددٍ","ليسوا من الشرِّ في شيء ولا الخير",5,"ر",1,0],["لكِنَّ قَلْبي وهوَ","مُخْضَلُّ الجوانبِ بالدُّمُوعْ",6,"ع",1,0],["لَكِن قَراكُم صَفحَهُ مَن لَم يَزَل","وَأَبوهُ فيكُم رَحمَةً وَغِياثا",7,"ث",2,0],["لكن قضى اللّه وانتهى بطلٌ","كنا لريب الزمان ندخره",8,"ر",2,0],["لكنْ قضاءَ الله فينا سابقٌ","لا عالم يُجْدى ولا مُتَعَلَّمُ",9,"م",1,0],["لَكِنَّ قَصدِى استِعَارَاتٌ مُرَشَّحضة","فِيها جِنَاسٌ للَِفّ النَّشرِ مُعتَضِدُ",10,"د",1,0],["لكنْ قنا في لظاها","من كُتْرْ شوقْها بعَدْلَكْ",11,"ك",1,0],["لَكِن قَعَدتَ وَأَغرَيتَ الخُطوبَ بِهِم","مُذَلِّلاً مِن صُروفِ الدَهرِ ما صَعُبا",12,"ب",2,0],["لكن قريبا عليك نلقي","قد قعد النقش يا سوار",13,"ر",1,0],["لَكِنَّ قَصدي أَن يُطَهِّرَ ذِكرُهُ","صَدري وَيَشفِيَ ما يكنُّ جناني",14,"ن",2,0],["لَكِن قَسوتَ فَما رَثيتَ لِذي","كَمَدٍ وَلا تَحنو عَلى صَبِّ",15,"ب",1,0],["لكن قلب العبد قد تخلى","شاهد وكانت منه السواتر",16,"ر",1,0],["لكنَّ قَرنكَ قَد وَهَى","فاحتاجَ مِن ساقي دِعامَه",17,"م",2,0],["لكن قواها كيف يمكن سترُها","وهي التي سَفَرَت ولم تتبرقع",18,"ع",1,0],["لكن قولكم التوقف في الت","عيين قول عل فيه ذهولا",19,"ل",2,0],["لكن قراءة خاف ربك ربما","كادت تصحح ما تراه عليلا",19,"ل",2,0],["لكنّ قُدرةَ من يَطوي الظّلامَ عن الدْ","دنيا وينشُرُ في آفاقِها الفَلقَا",20,"ق",2,0],["لكن قتل العبد ليس على","ملاكه في فعله درك",21,"ك",1,0],["لكن قد اقتسموها","وأشرقوني بريقي",22,"ق",2,0],["لَكِن قَعَيدَةُ بَيتِنا مَجفُوَّةٌ","بادٍ جَناجِنُ صَدرِها وَلَها غِنى",23,"ا",1,0],["لكن قلبك لم تضرم شرارته","من نار قلبي ولا من زندي الواري",24,"ر",2,0],["لَكِنْ قَنِعْتُ فَلَمْ أَرْغَبْ إِلَى أَحَدٍ","وَالْحُرُّ يَحْمِلُ عَنْ إِخْوَانِهِ كَلَّهْ",25,"ل",2,0],["لكن قضى والموت ما إن يتقى","منه فباء العرب بالخسران",26,"ن",1,0],["لَكن قِيامي بِحُسن الشُكر أَلزَمَني","أَني أَصوم لِتكفير عَن النعم",27,"م",1,0],["لكن قدم سعت به في تلفي","اعددت لها جوائزاً من قبلي",28,"ي",1,0],["لكِنَّ قولَة َحَقٍّ يَكتفونَ بهَا","يُقالُ عنهَا غداً وَفَّتْ كما يَجِبُ",29,"ب",1,0],["لَكنَّ قَوماً طَغوا جوراً عَلى عَجَلٍ","فَكُنتَ أَعجَل مِن سَهمٍ إِلى هَدَفِ",30,"ف",1,0],["لكن قلوب الخلق ربي لفاحصٌ","وما بالكلى قدامه واضحٌ جلي",31,"ل",2,0],["لكن قفوت بما تيسر كل ذي","فكر يساعد في مديحك مقولا",32,"ل",2,0],["لكنَّ قلبي صادقٌ","حرٌّ لعهدِ الحبِّ ذاكر",33,"ر",1,0],["لكن قضاء الملك الرحمن","يُذِل ذا القوة والسلطان",34,"ن",1,0],["لكنّ قلبي لا يرن بحب ذي","قلب أصم الطبع ليس يجيب",35,"ب",1,0],["لكن قول الحق ليس بضائر","تكراره عن كل ما اخبار",36,"ر",1,0],["لكن قلبي ما تذكَّر أنسَهَا","إلا تَأجَّجَ شوقُه وتَسَعَّرا",37,"ر",2,0],["لكن قصرت بحقكم","وصرفت بغيركم عمرا",38,"ر",2,0],["لَكن قُرآناً إَلَيكَ مَجاذِبي","وَفَضيلة شَهدت بِها أَعدائي",39,"ا",2,0],["لكن قد قيل تولّد من","أنثى في الأصل ومن ذكر",40,"ر",1,0],["لكن قصرن فما عسى يا رب لو","اعطين من عمر الحواسد طولا",41,"ل",2,0],["لَكِن قَدِ اختَلَفَا فَعِندَ فَرِيقِكُم","مَا إن أُرِيدَت قَطُّ بِالتِّبيَانِ",42,"ن",1,0],["لَكِنَّ قَولَ مُحَمَّدٍ وَالجَهمِ فِي","قَلبِ المُوَحِّدِ لَيسَ يَجتَمِعَانِ",42,"ن",1,0],["لكن قلبك في القساوة جاز حد","الصخرة والحصباء في أشجان",42,"ن",1,0],["لكن قضاء الله أخر نشأتي","لرثائهم ولعا بذاك متيما",43,"م",2,0],["لَكن قَلبي أَوقَدت نِيرانه","فَجرى اللِسان ليطفي الإِيقادا",44,"د",2,0],["لكن قياسَهُمُ هذا نفيساً تَرَى","كَالسِلِّبارِ وَمِجدَافِ السَفَايِينِ",45,"ن",1,0],["لَكِن قِيَاسُهَا نَفِيسُ زَايِد","إفهَمَ عَنِّي هَذِهِ القَوَاعِد",46,"د",1,0],["لَكنّ قاتِلهُ مَن لا يُعاب بهِ","مَن كانَ يُدعى قَديماً بيضة البلدِ",47,"د",1,0],["لكنَّ قلبي بين قرطقه","علقٌ وبين ملاعب القرط",48,"ط",1,0],["لكن قومي حاسدي","وتاركي بمعزل",49,"ل",1,0],["لكن قضى القدر المتاح بأن نرى","خصمين يصطرعان دون خصام",50,"م",1,0],["لكن قواك يصدني جبروتها","ويعيدني متخاذل الأقدام",50,"م",1,0],["لكن قَضى حُبُّ الوَظائِفِ أَنَّهُم","يَستَسلِمونَ وَيَأمرونَ بِالإِستِكانَه",51,"ن",2,0],["لكن قصارى ما سينتجه الأسى","عمرٌ تذوب حياته بِرَسيس",52,"س",1,0],["لكن قضى اللّه أمراً لا مرد له","وكان حتما عليه منه في الأزل",53,"ل",1,0],["لكِن قَضى القَومُ الَّذينَ تُظِلُّهُ","أَكنافُهُم فَغَدا طَريدَ الياسِ",54,"س",1,0],["لكن قلبي ضاع من حبها","وقلبها ضاع من العجب",55,"ب",1,0],["لكن قيرانوس وافى بالعجل","إليه فامتطى على خير العجل",56,"ل",1,0],["لكن قصدى واللبيب يفهم","لا جل عين ألف عين تكرم",57,"م",1,0],["لكن قناديل الهوى","في نور رشدي كالحمم",58,"م",1,0],["لكن قلوب المخلصين تأججت","ناراً وسالت في الخدود مدامع",59,"ع",1,0],["لكنَّ قومي وان كانوا ذوي عدد","ليسوا من الشر في شيءٍ ولا شان",60,"ن",1,0],["لكن قصارى الجهد منها أنها","لبست عليك ملاءَة الأحزان",61,"ن",1,0],["لكنَّ قلبي قد غدا متنكراً","وبذي الخديعةِ قط لا يتفكَّرُ",62,"ر",1,0],["لكنَّ قَوْمِي وَلَمْ أَنْقُضْ عُهُودَهُمُ","نامَوا عَلَى غَفْلَةٍ عنِّي ونِسْيانِ",63,"ن",1,0],["لكنْ قد جَفَّ القَضَا من المليكِ العادِلِ","وليتَ قد صارَ عنَّا لناطقٍ وقائِلِ",64,"ل",1,0],["لكن قضى حسداً أعاديك الألى","ملئت قلوبُهم من الأوغار",65,"ر",1,0],["لكنَّ قَلْبِى بَايَعَتْهُ جَوَارِحِي","أَنْتَ المَلِيكُ وَ نَحْنُ لَيْسَ سِوَى خَدَمْ",66,"م",1,0],["لكنَّ قلبيَ بالذي","يؤوي فؤادُكِ جاهل",67,"ل",1,0],["لكنَّ قلبي رغم نورِك في الدجى","ما دمتِ أنتِ بعيدةً يتَحسَّر",68,"ر",1,0],["لكن قلبي مالها فيه مثقال ..",".. وش قرب البشت الحساوي من الكوت",69,"ت",1,0],["لكن قبل لا انسى بنبهك دامك","مسلم وباقي كم شهر يدخل الصوم",70,"م",1,0],["لكن قبل تمشين انا مسروق","..من صدري قبل شوي وش شلتي",71,"ت",2,0],["لكنَّ قد صدقَ (ابنُ أوسٍ ) قولُهُ","هاتيكَ أشواقي اِليهِ راجِعَهْ",72,"ع",2,0],["لكنّ قوماً فيهمُ رسلُ الهدَى","سيحققونَ المجدَ والمأمُولاً",73,"ل",2,0],["لكنّ قلبي خانني","حين استُثير وما وعى",74,"ع",2,0],["لكنّ قيعآنك سوآت العرآيآ","حتى ولو اعشبت مآيوم مديت",75,"ت",1,0],["لكنّ قلبيَ قد قامت قيامته","حين انثنيتُ به عنها ولم أَرِد",76,"د",1,0],["لَكِنَّ قَوْماً مِنَ الْهِنْدُوْسِ مَاْ فَقِهُوْا","فِقْهَ الرِّجَاْلِº وَلاْ فِقْهَ الْقَوَاْرِيْرِ",77,"ر",1,0],["(لكن قصدي البعد يذكيها لظىً)","عِنْدَ الفِرَاقِ نُشُوبُها وَ المَوْقِدُ",78,"د",1,0],["لكنّ قلبي بحرَ جودكَ قاصدٌ","متأمِّلٌ في نظرةٍ جبَّارة",79,"ر",2,0],["لكنَّ قاتِلَ \"نُوحٍ\" حَسْبَ ما سَمِعتْ","أُذْنايَ مِنهُ إلى نَصْرِ إلإلهِ سَعى",80,"ع",2,0],["لكن قلبَك كم يقسو ولو رشقتْ","سهامُه سَدَّ ذي القَرْنين لانهدَمَا",81,"م",2,0],["لكنّ قلبيْ أعاد اللهُ خِلقتهُ","من بعد موتٍ ليحيا بعدما صُرعا",82,"ع",2,0],["لكن َّ قنديل َ الأماني لا يزا","ل ُ هناك َ فاركض ْ نحوه كي تُشعِلَه",83,"ل",2,0],["لكنَّ قلبي لم يعد يهوى الصبا","ماعادت الأهواء لي أهواءُ",84,"ا",2,0],["لكن قولة أح مالي بها صح","زود ٍ على مابي تزايد جروحي",85,"ح",2,0],["لكنّ قومي وإن كانوا ذوي عدد","ليسوا من الشرّ في شيء وإنا هم نا",86,"ن",2,0],["لكن قنا الخط قامات الرجال وقا","مات العوائق فيه البان والضالُ",87,"ل",1,0],["لكنَّ قوماً لِلجّهالةِ تَرتَضي","والدِّينُ باقٍ بِالجَّهالَةِ مُبتلى",88,"ل",2,0],["٦- لكن قومي لم يراعوا حقها","وتسابقوا طلبا لغير لغات",89,"ت",1,0],["لكن قلبي بك لوحدك تاثر","وروحي على حبك اراها امغصوبه",90,"ب",2,0],["لكنَّ قلبَكَ ما انفكَّتْ تُساوِرُهُ","وغيرتي عَظُمَتْ والروحُ مَأواها",91,"ا",3,0],["لَكِنْ قَتَلْتَ بِجُنْحِ الوَجْدِ مُهْجَتَنَا","هَلاَّ تَبَقَّى لِهَذَا الحُبِّ أَسْوَاقُ؟",92,"ق",1,0],["لكنَّ قلبي إذ روَتهُ دموعهُ","يدعوكِ كوني للأسى مِنديلا",93,"ل",2,0],["لكن قلبك لم يرد إلا الهدى","للناكبين طرائق الإيمان",94,"ن",1,0],["لكنّ قلبي قلب أمٍّ مُرضعٍ","ورضيعها بمضاءِ سيفِك يُصلبُ",95,"ب",1,0],["لكن قلبك في البطالة غافل","ما كان ذا هم وذا إشغال",96,"ل",1,0],["لكن قبل ترحل : تذكرت انسان","غالي ولكن ، بالمفارق يقلدك",97,"ك",1,0],["لكن قاضي العشق حكمه مثلما","يُذكر بآيات الكتاب المحكمي",98,"م",2,0],["لكن قبلته التي طُبعت على","خدّ الصباح تعود فجرا تُشرقُ",99,"ق",1,0],["لكنّ قلبا مخلصا","لاقى على طعنٍ منونه",100,"ن",2,0],["لكنّ قلبي زنديقٌ بنشوته","من فرط لذّته ضلّت دوافعه!",101,"ع",2,0],["لكنّ قلبيَ لم يهجر مودته","