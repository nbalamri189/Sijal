{"poems":[[63,"قد أغتدي والصبح في إقدامه","https://www.aldiwan.net/poem51434.html","الرجز"],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[186,"زر مضجعا قد ثوى فيه بن جرجس من","https://www.aldiwan.net/poem61171.html","البسيط"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[369,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110343","البسيط"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141224","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65172","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132731","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132721","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[1703,"هي المطامع في صدر الألى طمعوا","https://www.poetsgate.com/ViewPoem.aspx?id=49841",""],[4953,"أبو خزيمة ووباء الكورونا!!!","https://www.poetsgate.com/ViewPoem.aspx?id=211118",""]],"verses":[["وقَلَّ سَيرُ كأسِه وجامِه","قد أُلهِمَ الطَّاعةَ في إلهامِه",0,"م",2,0],["وقل سيري ولا تقفي انتِكاصاً","وانتَ فَسَلْ ولا تقفِ انقِطاعا",1,"ع",2,0],["وقل سيري فما يَعْيَا دليلٌ","حَدا من قبلكم فَهَدَى وضاعا",1,"ع",2,0],["وقل سيري اتباعَ أخي افتِداءٍ","مَشَت من خَلفه الأمم اتباعا",1,"ع",2,0],["وَقل سَقاكَ الرِّضَى فيما نؤرِّخُهُ","أَيا ثَرى فيهِ حَلَت نِعمةَ اللَّهِ",2,"ه",1,0],["وَقُل سِلامُ اللَهِ في كُلِّ ضُحىً","عَلَيكُم يا ساكِني هَذا المَحَل",3,"ل",1,0],["وقَلَّ سُؤْراً لكم منّا قصائدُنا","حِياضُ مَدْحِكُمُ قَدْ أُترِعَتْ سُؤَرا",4,"ر",2,0],["وقل سرت بي في الليل ذعبلة","تهدي صدور المهرية البزل",5,"ل",1,0],["وقل سلامٌ على اليخ الذي طويت","بطيه حجة الفصحى بأكفان",6,"ن",1,0],["وقل سائلا : كيف يا قبره","حويت الزمان وحزت الفخارا",7,"ر",2,0],["وقُل سقاك إلاهُ العالمين حيا","يُحيي معاهد أنس منك مُؤتلف",8,"ف",1,0],["وقل سالكاً نهج الحقيقة إننا","فقدنا عظيما ناهضاً بالعظائم",9,"م",1,0],["وقل سقتك ربيع الناس غادية","تغشي ثراك بارزام وارهام",10,"م",1,0],["وقلْ سلاح الضعفا الشكايهْ","لا سيما لله ذي الكفايهْ",11,"ه",1,0],["وقل سلام على أرض جنت عسلاّ","لغيرنا ولنا لم تجن مسمارا",12,"ر",2,0],["وَقُلْ: سَمْعاً أُطِيْعُكِ يَا حَياتي","لَعَلَّ اللهَ يَأْذنُ بِانقضَاءِ",13,"ا",2,0]]}