{"poems":[[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[93,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[93,"أبقى ويرفض حولي عقد خلاني","https://www.aldiwan.net/poem11271.html","البسيط"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[72,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[2,"مرج الدين فأعددت له","https://www.aldiwan.net/poem25039.html","الرمل"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[44,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[69,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[48,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[50,"ومعذل هجر اللئام حديثه","https://www.aldiwan.net/poem63976.html","الكامل"],[46,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39563","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/1027","الخفيف"],[106,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[44,"أحسِنْ بأيَّامِ العقيقِ وأطيبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15651&r=&rc=11",""],[107,"الناس كلهم شراء عطائه","https://www.aldiwan.net/poem16192.html","الكامل"],[184,"أين الفرار من المنية أين لي","https://www.aldiwan.net/poem43529.html","الكامل"],[202,"سلسل الشعر فوق وجه فحاكى","https://www.aldiwan.net/poem53056.html","الخفيف"],[280,"اسقني الخندريس تسبى عروسا","https://www.aldiwan.net/poem32731.html","الخفيف"],[326,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[377,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[400,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[426,"سل سبيلا لتسقي سلسبيلا","https://www.aldiwan.net/poem39889.html","الخفيف"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[459,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[477,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[498,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[498,"يا عليل القلب ما أغفلكا","https://www.aldiwan.net/poem37931.html","الرمل"],[507,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""]],"verses":[["سَلِسِ المُعَذَّرِ لاحِقٍ أَقرابُهُ","مُتَقَلِّبٍ عَبَثاً بِفَأسِ المِسحَلِ",0,"ل",1,0],["سَلِسُ العِنانِ إِلى القِتالِ فَعَينُهُ","قَبلاءُ شاخِصَةٌ كَعَينِ الأَحوَلِ",0,"ل",1,0],["سَلِسٍ مُقَلَّدُهُ أَسي","لٍ خَدُّهُ مَرِعٍ جَنابُه",1,"ب",2,0],["سَلِسَت عَراقيهِ فَكُلُّ قَبيلَةٍ","مِن حِنوِهِ قَلِقَت إِلى مِسمارِ",2,"ر",1,0],["سَلْسَلْتَهَا فِي كِتَابٍ كُلُّهُ غُرَرٌ","مِنَ المَحَامِد لَمْ تُوصَمْ بِأَدْرَانِ",3,"ن",1,0],["سَلْسَلْتَهُ فِي كِتَابٍ كُلُّهُ غُرَرٌ","مِنَ المَحَامِدِ لَمْ تُوصَمْ بِأَدْرَانِ",4,"ن",1,0],["سلست في انقيادها بعد أن قد","أظهرت لي تمنّعاً وحصانه",5,"ن",2,0],["سلّ سيف المزج فارتعشت","وغدت تنزور من اللهث",6,"ث",1,0],["سَلِسٌ بِالعَطاءِ حَتّى كَأَنّا","نَبتَغي عِندَهُ حِجارَةَ لابَه",7,"ب",2,0],["سَلِسَ المَرسِنِ مَمحوصَ الشَوى","شَنِجَ الأَنساءِ مِن غَيرِ فَحَج",8,"ج",1,0],["سَل ساكِني الزَوراءَ وَالأُمَمَ الَّتي","حَضَرَت وَظَلَّلَها رِواقُ القَسطَلِ",9,"ل",1,0],["سَلِسَ اللُبانَةِ وَالرَجاءِ بِبابِهِ","كَثَبَ المُنى مُمتَدَّ ظِلِّ المَطلَبِ",10,"ب",1,0],["سلسلَ الدمعَ فوقَ خدَّيَّ لما","زادَ في حسنِهِ البديعِ جنوني",11,"ن",2,0],["سَلِسُ الكَلامِ عَلى السَماعِ كَأَنَّهُ","سِنَةٌ تَرَقرَقُ بَينَ جَفنَي ناعِسِ",12,"س",1,0],["سَلسالَةُ الطَعمِ إِسفَنطٌ مُعَتَّقَةٌ","بِشُربِها قَيِّمُ الحانوتِ أَوصاني",13,"ن",2,0],["سَلِسَ المُقَلَّدِ لا أُخَفِّضُ جاشَهُ","إِلّا تَقاذَفَ غَربُهُ بِطِماحِ",14,"ح",1,0],["سَلِسٍ بِلَيِّنَةِ المَذاقِ رَقيقَةٍ","كَالدَمعِ تَخلِطُ لينَها بِجِماحِ",15,"ح",1,0],["سَل سَبيلَ الحَياةِ عَن سَلسَبيلِ","لا تُخَبَّر عَن غَيرِ وِردٍ وَبيلِ",16,"ل",1,1],["سلسبيلٌ من حكمةٍ وبيانٍ","فَجّرَ اللّهُ منهما إلهامَه",17,"م",2,0],["سلسلتْ فيه المُنى أنغامَها","وهي تشدو بالرحيقِ الخالدِ",18,"د",1,0],["سَلَّ سَيفَ الهَوى عَلَيَّ وَنادى","يا لِثَأرِ الأَعمامِ وَالأَخوالِ",19,"ل",1,0],["سلس اليراع بكفهن","سلاسةَ العذب الزلال",20,"ل",1,0],["سلْ «سُرُّ من را»: أباق في مرابضها","من جيشها الباسِلِ المغْوَار أفراد؟",21,"د",1,0],["سلسَ اللُّبانة ِ والرجاءِ ببابهِ","كَتَبَ المُنَى مُمْتَدَّ ظل المَطْلَبِ",22,"ب",1,0],["سلسالَها وَنَسيمُها مِن لُطفِهِ","وَعَبيرُها مِن بَعض طيب ثَنائِهِ",23,"ا",3,0],["سلس القياد يطيع كل ممارس","لا يستطيع دفاع ما هو لاق",24,"ق",1,0],["سَلسَلَ الشَّعرَ فوق وجهٍ فحاكى","ظلمةَ الليل فوق ضوء الصباحِ",25,"ح",1,1],["سَلسَبيلاً لِحَسوِها سَل سَبيلاً","فَسِواها لِلنَفسِ لَيسَ أَنيسا",26,"س",2,0],["سل سيف الإسلام من غمده البا","لي تروى الدماء منه جفونه",27,"ن",2,0],["سَلَّ سَيفاً مِن غمد حلم رَزين","أَكَلتُهُ سَفاهة السُفَهاءِ",28,"ا",2,0],["سل سورة الأنعام والأعراف تلَ","قَ نصوصها في هذه بوفاق",29,"ق",1,0],["سل سبيلاً لتسقي سلسبيلاً","راق ورداً وراق كل لبيبِ",30,"ب",1,1],["سلسالةٌ إن لم أكن عرفتُها","رشفاً فقد عرفتُها تفرُّسا",31,"س",2,0],["سَلْسالُ وِرْدٍ للظِّماء مُثْعِلٍ","أو أيْهَمُ الصَّهوة ضخم الكلْكل",32,"ل",1,0],["سلسبيل منطقه","كم به العقول سبى",33,"ب",2,0],["سِلْسِلَةٌ أَوسَطُها","بواسِطٍ ذو جَحْفَلِ",34,"ل",1,0],["سَلْسَلَتْكَ النَّفسُ طَيشاً للعُلى","غيرُ طيشِ النَّفسِ من سَلْسَلَكَا",35,"ك",2,0],["سَلِساتِ القِيادِ كُمتاً وَدُهماً","وَوِراداً تَرى بِها تَحجيلا",36,"ل",2,0]]}