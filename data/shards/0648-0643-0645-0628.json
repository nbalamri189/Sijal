ttps://www.aldiwan.net/poem3152.html","عموديه"],[462,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[477,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[498,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[498,"ما رفرف السعد إلا في محاضرنا","https://www.aldiwan.net/poem37998.html","البسيط"],[504,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[512,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[513,"هي البدر من سنة البدر أملح","https://www.aldiwan.net/poem12055.html","الطويل"],[520,"لسائل الدمع عن بغداد أخبار","https://www.aldiwan.net/poem1307.html",""],[522,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[534,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[536,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[549,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[549,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[549,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[556,"في كل جنس من الأجناس معلوم","https://www.aldiwan.net/poem34094.html","البسيط"],[573,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[573,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[573,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[584,"حموا بكعوب السمر بيض الكواعب","https://www.aldiwan.net/poem17441.html","الطويل"],[584,"خذ من حديثي ما يغنيك عن نظري","https://www.aldiwan.net/poem17531.html","البسيط"],[584,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"]],"verses":[["وَكَم بَزلاءَ صيحَ بِها إِلَيهِ","تَطاطَ لَها تَجُزكَ فَما تَطاطا",0,"ط",2,0],["وَكَم بَينَ كَفَّيهِ إِذا اِحتَدَمَ الرَدى","وَبَينَ العَوالي مِن زِمامٍ وَمَن عَقدِ",1,"د",1,0],["وَكَم بَينَ ذي أَنفٍ حَمِيٍّ وَحامِلي","مَوارِنَ قَد عُوَّدنَ جَذبَ الأَخِشَّةِ",2,"ه",1,0],["وكَم بها مِن ظِباءٍ","حلَّتْ سرارةَ وادي",3,"ي",1,0],["وكَمْ بالجُنَيْنَةِ منْ شادِنٍ","يَصيدُ بعَيْنَيْهِ لَيْثَ الثّرى",4,"ا",1,0],["وكمْ باكٍ كأنّ الجيدَ منها","يُوَشِّحُ منْ مَدامِعِهِ بعِقْدِ",5,"د",1,0],["وَكَم بَطَلٍ تَرَكتُ بِها طَريح","يُحَرِّكُ بَعدَ يُمناهُ الشِمالا",6,"ل",2,0],["وَكَم بَطَلٍ تَرَكتُ نِساهُ تَبكي","يُرَدِّدنَ النُواحَ عَلَيهِ حُزنا",7,"ن",2,0],["وكم بيتِ مالٍ في الجهادِ بذلتَه","وأقرضت منه اللهَ ما اللهُ يَعْلمُ",8,"م",1,0],["وكم بشّرتَنْي بالوفاء مقالة","فلما انتهت للفعل كانت مناعيا",9,"ي",2,0],["وكم بتّ فيها أخبط الليل رامياً","إليها بلحظ الطارق المتنوّر",10,"ر",1,0],["وَكَم بَلَدٍ شَتَتناهُنَّ فيهِ","ضُحىً وَعَلا مَنابِرَهُ الغُبارُ",11,"ر",1,0],["وكم بجودِ عليٌّ","أغنى رجا الوفد كفّه",12,"ف",2,0],["وكم بين ذي سوءٍ تعدَّاهُ سُوؤُهُ","مُريداً لما يأتيه يبغي ويَشغَبُ",13,"ب",1,0],["وكم بين مكروه يُحَسُّ وقوعُهُ","وآخرَ معدوم الإطاقة واللَّممْ",14,"م",1,0],["وَكَم بَخِلَت أَروى بِما لا يُضيرُها","وَكَم قَتَلَت لَو كانَ يودى قَتيلُها",15,"ل",3,0],["وَكَم بَعَثَتهُ لِلحَياةِ مِنَ البِلى","قَريحَةُ فَنّانٍ فَأَورَقَ وَاِخضَلّا",16,"ل",2,0],["وَكَم بائِعٍ ديناً بِدُنيا يَرومُها","فَلَم تَحصَلِ الدُنيا وَلَم يَسلَمِ الدينُ",17,"ن",1,1],["وكم بها سدماً تمتد واسعة","فيها النجوم عناقيد عناقيد",18,"د",1,0],["وكم باسم منهم إذا كان حاضراً","ولكن متى ما غالب عنك يُقطّب",19,"ب",1,0],["وَكَم بُلتِ في حُلَلٍ مِن حَريرٍ","وَكَم قَد كَسَرتِ مِنَ الآنِيَه",20,"ي",2,0],["وَكَم بَعَثوا جُيوشاً مِن أَماني","أَتَت دارَ السَعادَةِ في أَمانِ",21,"ا",2,0],["وَكَم باتوا عَلى هَرجٍ وَمَرجِ","وَقالوا المالُ مَبذولٌ لِجورجي",21,"ي",1,0],["وَكَم بَنَيتَ بِهِم مَجداً فَما نَسَبوا","في الهَدمِ ما لَيسَ في البُنيانِ مِن صَخَبِ",22,"ب",1,0],["وكم بجَيٍّ شريدُ النوم مقلتُه","يراقبُ البرقَ من أطرافِ كرمانِ",23,"ن",1,0],["وَكَم بَسَطَ الخِضرُ بنُ أَحمَدَ غايَةً","مِنَ المَجدِ لا يَقفو مَسافَتَها الخِضرُ",24,"ر",1,0],["وَكَم بَحَثوهُ عَن طِباعِ تَكَرُّمٍ","يَرُدُّ الزَمانَ صاغِراً عَن طِباعِهِ",25,"ع",2,0],["وَكَم بَدَأَت وَثَنَّت مِن مَبيتٍ","عَلى مَضَضٍ وَجافَت مِن مَقيلِ",26,"ل",1,0],["وَكَم بِالجَزيرَةِ مِن رَوضَةٍ","تُضاحِكُ دِجلَةُ ثِغبانَها",27,"ن",3,0],["وَكَم بادَ جَمعٌ أُلو قُوَّةٍ","وَحِصنٌ حَصينٌ وَقَصرٌ مَشيدُ",28,"د",1,0],["وَكَم بَذَلتُ طَريفي وَالتَليدَ لَكُم","طَوعاً وَأَرضَيتُ عَنكُم كُلَّ مُختَصِمِ",29,"م",1,0],["وكم بلَّغوني أقاويلَهُ","ويحلفُ باللهِ ما قالها",30,"ل",3,0],["وَكَم بِالخَيفِ مِن خَدٍّ صَقيلٍ","يُحَرِّمُ لَثمَهُ ماضٍ صَقيلُ",31,"ل",1,0],["وَكَم باطِلٍ ذائِعٍ قَيَّضَت","أَباطيلَهُ تُرَّهاتٌ أُخَر",32,"ر",1,0],["وكمْ بِتَّ يقظانَ الجفونِ مُسهَّداً","تُريهِ شُموسَ الرأيِ في غَسَقِ الدُّجى",33,"ج",2,0],["وَكَم باتَ ثانِيَ عِرسٍ لَهُ","فَأَصبَحَ بَينَهُما ثالِثُ",34,"ث",1,0],["وَكَم بَدَأَ الحَيُّ في حاجَةٍ","فَأَعجَلَهُ قَدَرٌ يَنتَحي",35,"ي",1,0],["وَكَم بُسِطَ البَنانُ فَعادَ صِفراً","وَزارَ الجودُ كَفّاً ذاتَ كَفِّ",36,"ف",1,0],["وَكَم بَرَّ مِثلَ البَبرِ نَجلٌ أَباً لَهُ","وَكانَ لَهُ كَالضَبِّ يَغدُرُ بِالحِسلِ",37,"ل",1,0],["وَكَم بَذَّ مِن قُرَحٍ","مَدى الجَذَعِ الأَزلَمِ",38,"م",1,0],["وكم بلَدٍ فارقْتُه مُتَلَهِّماً","عليكَ غَداةَ البيْنِ قلْبُ هُمامهِ",39,"م",2,0],["وكم بينَ رِيفِ الشأم والكَرْخِ مَنْهَلاً","مَوارِدُهُ ممزوجةٌ بسِمامهِ",39,"م",2,0],["وكم به قَتلى منَ القساوسِ","تندبُ للصُّلبانِ والنُّواقسِ",40,"س",1,0],["وكم بها حَقَّرَ من كنائسِ","بدَّلتِ الآذانَ بالنّواقِسِ",40,"س",1,0],["وكم بَعَثْتُ سُؤالاً كاشِفاً نَبَأً","عنه فلم أقضِ مِن عِلْمي به وَطَرا",41,"ر",2,0],["وكم بعثت بالمبشرات","على موات الحق منشرات",42,"ت",1,0],["وَكَم بَطَلٍ تَرَكتُ بِها طَريحاً","يُحَرِّكُ بَعدَ يُمناهُ الشِمالا",43,"ل",2,0],["وكَمْ بَعَثْتَ حَيَاةً","فِي قَلْبِ صَخْرٍ فَدَرّا",44,"ر",2,0],["وَكَمْ بَكَيْتَ فَأَبْكيْتَ","وَادِي النِّيلِ نَهْرَا",44,"ر",2,0],["وكم بَطلٍ في الأرضِ غابَ وذكرهُ","يُحلِّق في الآفاقِ ليسَ بغائبِ",45,"ب",1,0],["وَكم بدا يحمل لوحاً وَمَا","خطّ عَلَيْهِ بعض أقوالك",46,"ك",1,0],["وكم بالسجن مظلومٌ","له سَجَّانُه رَقَّا",47,"ق",2,0],["وكم بين ذي سوءٍ تعدَّاهُ سُوءُهُ","مُريداً لما يأتيه يبغي ويَشغَبُ",48,"ب",1,0],["وكم به عز منصورا اخوضعة","مسفه وجهه بالخزي منكوت",49,"ت",1,0],["وكم بنفحته في السالكين ثوى","بالقلب والنطق عرفان وتشميت",49,"ت",1,0],["وكم بجذبته نال العناية من","رب البرية بعد القطع ممقوت",49,"ت",1,0],["وكم باباً طرقناه","وبالنجوى توسَّلنا",50,"ن",2,0],["وكَم بَيدَاءَ في المَشتَاةِ جَابُوا","لِتَر ئِيبِ الرِّمَامِ مِنَ الجِبَالِ",51,"ل",1,0],["وكم بغيتَ ولكن كنتُ مصطبراً","وكان يحتمل البلواءَ جثماني",52,"ن",2,0],["وكم به لرجال الجدّ من أربٍ","نام المقصّر عنه وهو مدَّخر",53,"ر",1,0],["وكم بذلا فداءك من نحور","ببيض الهند أو سمر الرّماح",54,"ح",1,0],["وَكَم بُقعَةٍ أَوحى لَها فَتَشَرَّفَت","مِنى تاهَ لَمّا أَن أَتاها وَعُرِّفَت",55,"ت",1,0],["وَكَم بيعَةٍ في الأَرضِ رُدَّتِ لِمَسجِدِ","عَلى رَغمِ أَعداءٍ بُغاةٍ وَحُسَّدِ",56,"د",1,0],["وَكَم باطِلٍ وَلّى بِهِ وَهوَ طآئح","رَسولٌ لأَسرارِ المُنافِقِ فاضِحُ",57,"ح",1,0],["وكم بين مطبع إلى متكلف","وكم بين ذي حق إلى قائل إفكا",58,"ك",2,0],["وكم بعير عود له جلدٌ","أوهنهُ في قيامه قتبه",59,"ب",2,0],["وَكَم بَينَنا مِن مُسلِمين جُدودُهم","نَصارى على الشيطانِ قَد أَحرزوا النصرا",60,"ر",2,0],["وَكَم بها أنوارُ أجرٍ صاعِده","فَاِحرص عليها إِن تَكُن ذا رشدِ",61,"د",1,0],["وكم به سطر إلى آخر","كالصدر للصدر دنا فاغتنق",62,"ق",1,0],["وكم به معنى أنام الجوى","وكم به معنى أتى بالأرق",62,"ق",1,0],["وكم بحثَ الناسُ في أصلها","وأي الوبا كانَ في جيلها",63,"ل",3,0],["وكم بينَ الطروبِ وذي شجونٍ","إذا أبصرتُ كلاً في اضطرابِ",64,"ب",1,0],["وكم بينَ النحاسِ وإن جلوهُ","وبينَ توهجِ الذهبَ الشديدِ",65,"د",1,0],["وكمْ بها من أكحلٍ إن رنا","سلتْ لكَ الأجفانُ بتارا",66,"ر",2,0],["وكم ببذل الندى أحيا المحاميدا","وكم برغم العدى أردى الصناديدا",67,"د",2,0],["وكم بنات بها بدوراً","كانت وصارت بنات نعش",68,"ش",1,0],["وكم بقعةٍ أربابُها ضَلَّ سعيُهم","فَجَلاَّهم قَسْراً وَبُقْعَتُهم غُفْل",69,"ل",1,0],["وَكَم بِكرٍ وَهَبتُكَ مِن دِمائي","وَتَأبى يا ظَلومُ عَلَيَّ بِكرا",70,"ر",2,0],["وَكم بائِسٍ ظَلَمته الحَياةُ","يَخالُ سوادَكَ ظلمَةَ نَعشِه",71,"ه",1,0],["وكم بأعالي كربلا من حفائر","بها جُثَثُ الأبرار ليس تعاد",72,"د",1,0],["وَكَم بُليتُ بِأَغمارٍ وُجودُهُم","لَمّا بَلَوتُهُم سِيّانِ وَالعَدَمُ",73,"م",1,0],["وكَم بَينَ عَرشٍ من لجينٍ وعَسجدٍ","يُصاغُ وعرشٍ من سناءٍ ومِن ذِكر",74,"ر",1,0],["وكم بَينَ مَجدِ الدين والعلم والتقى","ومجدِ القصُورِ الشم والعَسكَر المَجرِ",74,"ر",1,0],["وَكَم بِهَواهُ مِن عانٍ مُعنّى","يَبيتُ يَخافُ اطلاقَ السراحِ",75,"ح",1,0],["وكم بعدُ عندي في الضمير بشائرٌ","تجلّ عن التصريح بالعدّ والحدّ",76,"د",1,0],["وكم بل صادي القلب من نهل ظمما","وراق ولكن اللذاذة في العل",77,"ل",1,0],["وكم بتنا وطرفُ النَّجمِ يرنو","وأغصانُ الحِمى تحنو عَلينا",78,"ن",2,0],["وَكَمْ بتُّ وَالأَفراحُ فِي غُرفَاتِنَا","إِلَى أَن تَجَلى الصُّبح فِي صُورَةِ الخودِ",79,"د",1,0],["وَكَمْ بَدْرَةٍ بادَرَتْ بِالغِنَى يَدِي","إِلَى إِمَّةٍ قَدْ يَمَّمَتْ كَنَفِي مَثْوَى",80,"و",2,0],["وَكَمْ بَرَزَ الرَّوْضُ فِي حُلَّةٍ","تَوَلَّتْ يَدُ الْغَيْثِ تَفْوِيفَها",81,"ف",3,0],["وَكَمْ باتَ يَخْذُلُنِي مَنْ أَعا","نَ فَضْلِي وَيُسْلِمُنِي مَنْ حَمانِي",82,"ي",1,0],["وَكَمْ بُزَّ مِنْ مانعٍ لِلْجِوارِ","وَضُيِّعَ مِنْ حافِظٍ لِلذِّمامِ",83,"م",1,0],["وَكَم بَينَنا وَالدارُ مِنّا قَريبَةٌ","إِذا نَحنُ حاوَلنا الزِيارَةَ من عَلَم",84,"م",1,0],["وَكَم بَرَزَت لِروحي مِن حِماكُم","مُحَجَّبَةً عَنِ الفِطَنِ اللَبيبِ",85,"ب",1,0],["وكم بعت لي من شجون وحركت","كوامن أشواق بقلبي ومهجتي",86,"ي",1,0],["وَكَم بين وجهٍ سالَ في التربِ ماؤهُ","وبين محيّا منكَ يحيي الوَرى نضرا",87,"ر",2,0],["وَكم باتَ يَكفينا المهمّات رعيه","مطيفاً بنا أَمناً لطيفاً بنا رقبى",88,"ب",2,0],["وكم بذلتم لنا وعودا","ولم تدم منكم الوعود",89,"د",1,0],["وَكَمْ بَاتَ المُسِئُ قَرِيرَ عَيْنٍ","وَسَيفُكَ إذْ حَلُمْتَ قَرِيرَ جَفْنِ",90,"ن",1,0],["وَكَم بِبَذل الأَيادي نال مَأمله","مُستَعطف غُصن بان غَير مُنعطفِ",91,"ف",1,0],["وَكَم بَنينا لإِعراب الثَناء لَهُ","بَيتاً سِوى جوده لا شَيءَ يعمرهُ",92,"ر",2,0],["وَكَم بِتُّ عَطشاناً إِلى مَورِدِ اللَمى","وَإِن كُنتُ في بَحرِ الدُموعِ غَريقا",93,"ق",2,1],["وَكَم باتَ وَالتَغريدُ يَهفو بِعَطفِهِ","فَأَصبَحَ مَنهوكَ القَوامِ دَقيقا",93,"ق",2,0],["وكم به منتهزٌ للقُرصَةِ","وراجعٍ عن قِرنه بِغُصَّةِ",94,"ه",1,0],["وَكَم باتَ سَهراناً لِمَجد يَجدهُ","وَكَم باتَ لا بَكرى اِرتِقاباً لضيفان",95,"ن",1,0],["وكم ببكدر والغريط سادات","أهل الورع والفقه والعبادات",96,"ت",1,0],["وكم بوعْدِ وصله أَطْمَعَني","حتّى إذا اسْتَنْجَزْتهُ الوعْد لَوى",97,"ا",1,0],["وكم بخيل تراه في الأنام ولا","والله لا كان لا مِنّا ولا فينا",98,"ن",2,0],["وكم بت أشكو حر شوقي بأضلعي","كمن بات يشكو في المضاجع سهرانا",99,"ن",2,0],["وكم بَشَّر السلوان قلبي مغالطاً","ونار الهوى تطوى بذيل تجلُّدي",100,"ي",1,0],["وكم برز الأَعداء في حومة الوغى","وثغر الرَّدى يفترّ عن ناب كاشر",101,"ر",1,0],["وكم باسقاتٍ بالرّصافة أقعدت","على عجزها حيث استطال فسيلها",102,"ه",2,0],["وكم بذلوا من أنفَس الماس ما غلا","فلم يرغبوا إلاَّ بذكر مخلَّد",103,"د",1,0],["وكم بالهوى لما خلعنا عذارنا","اعضض تفاح الخود المكتبا",104,"ب",2,0],["وكم بيتِ شعرٍ كان عنقاءَ مُغربٍ","فصارَ عصى الأعْمى لمعقولِه البعكي",105,"ك",2,0],["وكم بيضاءَ مسكيٍّ قناها","من الإغرِيضِ حسناءِ الجميعِ",106,"ع",1,1],["وكم بَذَلْتُ لَهَا فِي الشَّوْقِ مكتئِباً","غُروبَ جفنَيْنِ مَا تشكُو من الأَيْنِ",107,"ن",1,0],["وكم بارَوْا هُوِيَّ النجْم تهوي","بِهِم فِي البِيدِ أَفئدةٌ هواءُ",108,"ا",2,0],["وكم بَدَّلُوا مِنْ وَجْهِ راعٍ وحافِظٍ","وُجُوهَ المنايا السُّودِ والحَدَقِ الحُمْرِ",109,"ر",1,0],["وكم بات طرفي ساهراً وهو راقد","وبالطيف منها إن سرت فيه قانع",110,"ع",1,0],["وكم بها متحف أثير","يفوح من مجده الدهان",111,"ن",1,0],["وكم بها نعمة ولكن","هل يجذب النعمة افتتان",111,"ن",1,0],["وكم بِلَوى الشقيقة ومن فؤادٍ","أسير لو تكلم قال آها",112,"ا",3,0],["وكم بلدةٍ باتت تسالم أختَها","وبينهما حربٌ عليك زَبونُ",113,"ن",1,0],["وكم بنجدٍ لك من قاتلٍ","لم يتحرَّجْ من مقام الأثيمْ",114,"م",1,0],["وكم بمديحكم بددت درَّاً","على القرطاس ما استمددت نِقسا",115,"س",2,0],["وكم بذاتِ الرمل من نافرةٍ","بغير أَشراك الشبابِ لم تُصَدْ",116,"د",1,0],["وكم بَكَْرةٍ منها لمدحك قُدتُها","فقرّت ومن أخلاقها الغَشْمُ والشَّغْبُ",117,"ب",1,0],["وكم بخيلٍ بتسليمٍ لعزَّتِهِ","يُعفرُ الخد للرحمن في وَجَل",118,"ل",1,0],["وكم بخلوا ومالُكَ مُستباحٌ","يظلُّ رغائباً في كل نادِ",119,"د",1,0],["وكم برموا وأنت رحيبُ بالٍ","تُلاقي الهولَ جذْلانَ الفؤادِ",119,"د",1,0],["وكم بدروبِ بغدادٍ حديثاً","يسرُّك نشره في كل نادِ",119,"د",1,0],["وكم بعثت بي منك محسنة المنى","إلى خير مصحوب وللدهر تقبيح",120,"ح",1,0],["وكم بنداكَ عَلا خاملٌ","وأورق من ماحلٍ وهو صلد",121,"د",1,0],["وكم بارقٍ حاشاك شمتُ سحابهُ","فشمتُ سحاباً وجهُ بارقهُ جهم",122,"م",1,0],["وكم بي من رشف اللمى فضل نشوةِ","وما الرّيق إلاَّ خمرةٌ كأسها الفم",123,"م",1,0],["وكم بلينا بمن أودى تسيطرهم","بنا وقامت لهم دعوى بلا طلب",124,"ب",1,0],["وكم بنى دسائساً وفوقه","صار البناء كلُّه منهدما",125,"م",2,0],["وكم بَصائِرُ قومٍ في الهَوى انْطَمَسَتْ","نالَتْ شُروقَ فُتوحٍ من بَصائِرِنَا",126,"ن",2,0],["وكم بالدُّعاء لكم كل عام","بمكة من معلنٍ جَاهر",127,"ر",1,0],["وكم بقيت حسبةً في الظّلوم","وتلك الذَّخيرةُ للذّاخر",127,"ر",1,0],["وكم بخُدودِ نِسوَتِهم وأيدي","فوارسِهِم توقّد من شِهابِ",128,"ب",1,0],["وكم بين فياض البديهة سابق","وآخر يكدي فكره حين يكدح",129,"ح",1,0],["وكم بدور على البدرية انخسفت","ولم يعد لبدور منه إبدار",130,"ر",1,0],["وَكَم بشر بِالمُصطَفى قَد تَتابَعَت","وَأَفصَحهم نُطقاً بِتِلكَ مَسيحُ",131,"ح",1,0],["وَكَم بَذَلوا لِلَّهِ جَهدَ نُفوسِهِم","فَصاروا بِذاكَ البَذلِ مِن سادَةِ الوَرى",132,"ر",2,0],["وكم بين بحرٍ موقف الفيض في الثرى","وبحرٍ على وجه الثرى نفعه يجري",133,"ر",2,0],["وَكم بينَ بَحرٍ مِن مياهٍ تلاطَمت","وبحرٍ التُّقَى والجُدِ والعِلمِ والبِرِّ",133,"ر",1,0],["وكم بين ثاوٍ في فلاةٍ بمَهمَةٍ","ومَن جرَّ ذيل العِزِّ في الحُلَلِ الخُضرِ",133,"ر",1,0],["وكم بينَ مَن يغزو لِدينِ مُحمَّدٍ","لِينصرَهُ نصراً وينشُرَه نَشرا",134,"ر",2,0],["وكم بيننا حائلٌ هائلٌ","وأوْهَمَ أنْ ليس من جائلِ",135,"ل",1,0],["وَكَم بَحثوه عَن خَفايا عيوبِه","فَشاعتْ مَعانٍ تصطفيها المسامعُ",136,"ع",1,0],["وكم بِتْنَا به واللّيلُ داجٍ","نُمِيط من الجَوى ما لن يُماطا",137,"ط",2,0],["وَكم بغَوْا دهراً فلم يظفِروا","مِنِّي في المَزْلَقِ بالعَثْرةِ",138,"ه",1,0],["وكم بليت بأقوام سواسية","في حكم أمر بعين الحس موهوم",139,"م",1,0],["وكم بِيعةٍ قد أَصبحت وهْي جامعٌ","وكم كافرٍ أَضحى بها وهْو مُسْلم",140,"م",1,0],["وكَم بذَل الصَّدَّ من بُخْلِه","ومن عَجبٍ باذلٌ بَاخلُ",141,"ل",1,0],["وكم بَيْن مَنْ لَيْلُه قائِمٌ","إِلى مَنْ على جنبِه قَدْ وَجَب",142,"ب",1,0],["وكَمْ بِتُّ أرعى مِنْ بُدُورٍ طَوالِعٍ","وَأَرْعَى عُهوداً مِنْ شُموسٍ غواربِ",143,"ب",1,0],["وَكَمْ بَليدٍ بِظَهْرِ الغَيْبِ حَدَّثنا","وَذِي ذَكاءٍ رَأَيْناهُ مِنَ الحُمُرِ",144,"ر",1,0],["وَكَمْ بَدا عاقِلٌ يَوْماً وَليْسَ لَهُ","فِكْرٌ وَلَيْسَ بِمَنْسُوبٍ إلى البَشَرِ",144,"ر",1,0],["وَكَمْ بِهَا مِنْ مَصُونةٍ صُلْنا","يَحْجبها غَيْرهَا ويَحْمِيها",145,"ي",3,0]]}