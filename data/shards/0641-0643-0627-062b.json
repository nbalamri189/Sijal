{"poems":[[463,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143290","الوافر"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"]],"verses":[["فكاثروا أبياتَهُ بعددٍ","من عمركم وسايروا محالَه",0,"ل",2,0],["فكاثره بهز بعد هز","فإن الزبد بالمخض الكثير",1,"ر",1,0],["فكاثر في الجميع بهم خُزاعاً","فأجذم باليسار لنا اليمينا",2,"ن",2,0],["فكاثروه فالفوا غير ما نكس","ماضي الشبا غير هياب ولا أرم",3,"م",1,0]]}