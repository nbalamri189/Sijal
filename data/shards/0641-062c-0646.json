an/poem/69974","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101347","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127203","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94364","الطويل"],[4406,"","https://poetry.dctabudhabi.ae/diwan/poem/147676","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76740","الوافر"],[4778,"هجير الحر","https://www.poetsgate.com/ViewPoem.aspx?id=198845",""],[1901,"لا تعجبوا إن قلتُ بانتْ سعادْ","https://www.poetsgate.com/ViewPoem.aspx?id=160414",""],[585,"إيه دمشق هنا الشهيد الأطهر","https://www.poetsgate.com/ViewPoem.aspx?id=161939",""],[5100,"انقلاب","https://www.poetsgate.com/ViewPoem.aspx?id=207702",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5183,"الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=186490",""],[5183,"الحمول","https://www.poetsgate.com/ViewPoem.aspx?id=186610",""],[5277,"حديثُ الأحداق","https://www.poetsgate.com/ViewPoem.aspx?id=191115",""],[5413,"وبي مالا يبوح الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=201608",""],[5510,"غزل الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=205752",""],[5512,"الأم ( غفوت )","https://www.poetsgate.com/ViewPoem.aspx?id=204345",""],[5704,"يا سعد من ترك الدنيا بما فيها ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200013",""],[5720,"جمعيةُ التحفيظِ","https://www.poetsgate.com/ViewPoem.aspx?id=199528",""],[5725,"وجه تجسد بالمحاسن أجملا","https://www.poetsgate.com/ViewPoem.aspx?id=213320",""],[5751,"قرويةٌ هذي الأغاني","https://www.poetsgate.com/ViewPoem.aspx?id=215017",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5829,"جند الحق","https://www.poetsgate.com/ViewPoem.aspx?id=176838",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5830,"يا وهم مالي ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=201912",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[6124,"جنون الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=159483",""]],"verses":[["فَجَنى نَسيمَ الشيحِ مِن نَجدٍ لَهُ","حُرَقُ الحَشى وَتَحَلُّبُ الآماقِ",0,"ق",1,0],["فَجُنَّ بِكُنَّ اللُّبُّ مِنّي عَلى النَّوى","وَمَا بِيَ لولا حُبُّكنَّ جُنُونُ",1,"ن",1,0],["فَجَنبَي صَوأَرٍ فَنِعافِ قَوٍّ","خَوالِدَ ما تَحَدَّثُ بِالزَوالِ",2,"ل",1,0],["فَجَنَونا جَنىً شَهِيّاً حَلِيّاً","وَقَضَوا جوعَهُم وَما يَأكُلونا",3,"ن",2,0],["فجنوا على الاجداد في اجداثهم","وجنوا على الابناء والاحفاد",4,"د",1,0],["فَجَنُوبُ أَثبِرَةٍ فَمَلحَدُها","فَالسِدرَتانِ فَما حَوى دَسمُ",5,"م",1,0],["فَجَنِّبِ الزَهوَ في الدُنيا فَلَو زُهِيَت","غُرُّ الغَمامِ لَذُمَّ القَطرُ إِذ نَزَلا",6,"ل",2,0],["فَجَنَّدَ الجُنودَ والكتَائبا","وقَوَّدَ القُوَّادَ والمقَانبا",7,"ب",2,0],["فجنت بها واختل منها شعورها","زماناً إلى ان جاءَها الموت يسرع",8,"ع",1,0],["فَجُنُوبِ عَرْوَى فَالقِهَادِ غَشِتُهَا","وَهْناً فَهَيَّجَ لي الدُّمُوعَ تَذَكُّرِي",9,"ر",2,0],["فجنَى ما شاءَ حتى لم يَدَعْ","في أصيصٍ زهرةً إلَّا جناها",10,"ا",3,0],["فجنّت بها نشوات الصبا","وفاضت بصدر الضحا الأمرد",11,"د",1,0],["فَجُنوبِ عَرْوَى فالقِهَادِ غَشِيتُها","وَهْناً . فهَيَّجَ لي الدموعَ تَذَكُّري",12,"ر",2,0],["فَجَنَيت نُوراً لِلمُنى","لَم يَدرِ طارقة الذُبولِ",13,"ل",1,0],["فَجَنى أَهلُها مِنَ الماءِ مالاً","إِنَّ رَيَّ الثَرى يُفيدُ الثَراءَ",14,"ا",2,0],["فَجَنِّبوني أَذاكُم قَبلَ آبِدَةٍ","تَأتي غِشاشاً فَلا تُبقي وَلا تَذَرُ",15,"ر",1,0],["فجَنَتْ لها منك التجاربُ مُجْتَنىً","كلُّ الأَطايبِ حين تُذْكَر دون",16,"ن",1,0],["فَجَنبَي عَسيبٍ لا أَرى غَيرَ ماثِلٍ","خَلاءً مِنَ الآثارِ إِلاّ الرَوامِسا",17,"س",2,0],["فجنحنا إلى العنا","ق فزاد التأثر",18,"ر",1,0],["فَجُنْدِيَ تدبيري وسيفي عزيمتي","وقلبي إذا نازلتُ في الحرب ضِرْغامي",19,"م",2,0],["فَجَنبِ عُنَيزَةٍ فَذَواتِ خَيمٍ","بِها الغُزلانُ وَالبَقَرُ الرِتاعِ",20,"ع",1,0],["فجنيتُ زهراً ناضراً وشممتهُ","وبشّمةٍ أنضرتُ زَهراً ذابلا",21,"ل",2,0],["فجنيتِ من تلكَ الأزاهرِ باقةً","والطلُّ فيها كالدَموعِ يجول",22,"ل",1,0],["فَجُنودُهُ الأُسدُ الضَواري ما لَها","إِلّا القَنا يَومَ الوَغى آجامُ",23,"م",1,0],["فَجَنَّبَها الهَضبَ تَردي بِهِ","كَما شَجَرَ القارِبُ الأَحقَبُ",24,"ب",1,0],["فجنةُ الخلدِ ما أَنفكُّ أَحسبها","إذا انفردت بها دون الورى سقرا",25,"ر",2,0],["فجُنَّ بأهوائِه الآثمات","يرى بحرها ماله من نفاد",26,"د",1,0],["فَجَنانُهُ بِجُمودِهِ وَرواؤُهُ","بِخُمودِهِ وَلِحاظُهُ بِكَلالِهِ",27,"ل",2,0],["فجناه في لبنان غُصناً ناضراً","وعليه ثَمْرٌ للفضائل مونِعٌ",28,"ع",1,0],["فجنِّبوني عفوَكم عنه غداً","أكنْ لكم منه ولي منتصِرا",29,"ر",2,0],["فجنح آمالي كوجه الضُّحى","مذ لاح في ناديك أمَّ الفلاحْ",30,"ح",1,0],["فَجُنَّ هُدُوّاً وَالثِيابُ كَأَنَّها","مِنَ الطَلِّ بَلَّتها الرِهامُ النَواشِعُ",31,"ع",1,0],["فجنيتَ منهم واجتليتَ وجوهَهم","زهراً فأَنت المجتَني والمجْتَلي",32,"ل",2,0],["فجناننا قبل اليرا","ع منظم أبهى القصيد",33,"د",1,0],["فجنيتُ من خدَّيهِ ورداً فانبرى","لحظٌ أراش سهامَهُ ورماني",34,"ن",2,0],["فجنابه لا يستباح، وجاره","لا يستضام، ونبعه لا يقصد",35,"د",1,0],["فجنود تموج كاللج في الني","ل وأخرى تموج في الصحراء",36,"ا",2,0],["فجنَّت جنوناً من دلالاتٍِ منيخةٍ","ومن رَجُلٍ عاري الأشاجِعِ شاحِبِ",37,"ب",1,0],["فجنيتَ لا عجلاً ولا متواكلاً","والعمر يلقى الجهدَ من أكماتهِ",38,"ت",2,0],["فجنيت ما لا يجتنى","وحطبت ما لا يحطب",39,"ب",1,0],["فجني الورد فيه","وأنا أمنع قطفه",40,"ف",2,0],["فجنى الإسلام عزاً واستقر","ليته لم يفقدِ الحصنَ الحصين",41,"ن",1,0],["فَجُنَّتُ مِن الشَيبِ وَاِستَرجَعَت","وَأَنفَرَها فَوقَ إِنفارِها",42,"ر",3,0],["فجنى ما جنى وغير عجيبٍ","إنَّما السوء عادةَ الطلقاءِ",43,"ا",2,0],["فجنوبُ عكا فالسواحلُ إنها","أرضُ تذوب بها اللقاحُ وتُهزَلُ",44,"ل",1,0],["فجنى الثناء مجملاً ومفضلاً","وحوى الهناء مكملاً ومتمما",45,"م",2,0],["فَجنابُكُم صافٍ كَرِيمٌ وَاسِعٌ","فبِهِ تَوَسَّلنا لِرَبّ باقِ حَى",46,"ا",1,0],["فجنى بها عز الأمان وخلفه","يوم يجرعه الشراب صديدا",47,"د",2,0],["فجنابه للمعتلي وسحابه","للمعتفي وعقابه للمعتدي",48,"د",2,0],["فجناب شمس الدين أمنع معقل","للاّئذين من الزمان الأنكد",49,"د",1,0],["فجني يبتغي غمي","وإنسي يبتغي أُنسي",50,"س",2,0],["فجُنودُ أتبَاعِ الرَّسُولِ مَلاَئِكٌ","وَجُنُودُهُم فَعَسَاكِرُ الشَّيطانِ",51,"ن",1,0],["فَجَنَى عَلَى المعنَى جِنَايَةَ جَاحِدٍ","وَجنَى عَلَى الألفَاظِ بِالعُدوَانِ",51,"ن",1,0],["فَجُنَّ الطَيرُ بِاِسمِ اللَهِ حَتّى","تَدَلّى اللَهُ وَالسَبعُ العَوالي",52,"ل",2,0],["فجنيت من ثمر المنى أملي","وهصرت يانع قضبة المُلدِ",53,"د",1,0],["فجنيتُ مِن ثَمَرِ المُنَآ أملي","وهصَرتُ يانعَ قُضبَةِ المُلدِ",54,"د",1,0],["فجنيت نور الفضل من أوراقها","عطر الغلائل طيب الأغراس",55,"س",1,0],["فجنابُ الشيخ حجي حَبّذا","هُوَ مِنْ حجٍ ومن مُعْتمِرِ",56,"ر",1,0],["فجنبي تجافي عن مضاجعه أسىً","ولا جف جفني من هواك ولا الخد",57,"د",1,0],["فَجنى العلم مِنهُ غَضاً طَريا","وَدَرى ما يَكون قَبل الهُجومِ",58,"م",1,0],["فَجَنَّبَكَ الإِلَهُ هُوانَ شانٍ","وَأَرجَعَ مَجدَكَ الماضي مُهابا",59,"ب",2,0],["فَجنَّت كَما جَنَّ الظَّلامُ وَأَفرَغَت","عَلينا كَإِفراغِ الدِّلاءِ الحَوافل",60,"ل",1,0],["فجنى جنى وجناتها","وافتض غير مقصر",61,"ر",1,0],["فجنبها عن خطة الضيم وانتضى","عزيمته واختار قرع البواترِ",62,"ر",1,0],["فجن جنونه وجرى","وكل الكون قد رابه",63,"ب",2,0],["فجنيت منتظم اللئالي مبسماً","وجنيت منتثر اللئالي منطقا",64,"ق",2,0],["فَجُنَّ جُنوناً لا تَلُمهُ فَإِنَّهُ","رَأى سَوءَةً مِن واسِعِ الشِدقِ أَهلَبا",65,"ب",2,0],["فجنّدْ جُنودَ النّصرِ تبتَدِرُ الوَغى","وقد راعَ من نارِ الحُروبِ التِهابُها",66,"ب",3,0],["فَجنبُهُ خافقُ الجنابِ","نابي مبلبَلُ",67,"ل",1,0],["فجنة مثلها للقلب شائقة","قد حرَّضت قلب مشتاق وولهان",68,"ن",1,0],["فجنى ورد وجنة ليس يذوي","وحنا غصن قامة مختاله",69,"ل",2,0],["فجنيت أحقاد الرجال وما جنوا","حقدًا من «الآمال» والأفكارِ",70,"ر",1,0],["فجنان قد علقتها يد الفن","بأوج العلى بغير عناء",71,"ا",2,0],["فجنينا الزهر منتظما","ثم غادرناه متتثرا",72,"ر",2,0],["فجنيتُ أثمارَ الهمو","مِ من الهوى فيما اجتنيتُ",73,"ت",1,0],["فَجَنَّبَهُ أهلُ العُلُومِ تَوَرُّعاً","وَذَلِكَ عَادَاتُ النُّجُومِ الثَّوَاقِبِ",74,"ب",1,0],["فجنى ثمار رياضها","في يتمه هذا الغلام",75,"م",1,0],["فجناب هذا الحبر أصبح موردا","عذبا لقصاد العلوم ومصدرا",76,"ر",2,0],["فَجَنِّبهُ واحذَر أن تُحَسِّنَ فِعلَهُ","وحَذِر جميع الناس عن كلِ مائِقِ",77,"ق",1,0],["فَجُندُ الأَغارِقِ حُلَّت عَرَاهُم","وَفالاسُ فَوقَ الأُلمِبَ تَرَاهُم",78,"م",1,0],["فجندله لا حراك به","وأهوى يصل بشكته",79,"ه",1,0],["فَجَندَلَ كِيرَانُس أَلستُرَ هليُساً","وإخرُومِيُوساً وَهوَ كاللَّيثِ كاسِرُ",80,"ر",1,0],["فَجناهُ غارسهُ وَذاقَ ثَمارهُ","وَاختارَ نقلتهُ إِلى بُستانِه",81,"ن",2,0],["فجناح الجديد أثقل من أن","فيه وكر النسر السماوي يطرق",82,"ق",1,0],["فجنى ورد جنة ليس يذوي","وحنا غصن قامة مختاله",83,"ل",2,0],["فجنّاتها جَنَّت وكم حيَّر الجنا","جَناناً بايناعٍ وأدهش جانيا",84,"ي",2,0],["فجنَتْ عليك ويا لها ممَّا جنَتْ","لهفي عليك فكَم خشيتُ الحُسَّدا",85,"د",2,0],["فجنين بالأسماع نور حديثنا","وكرعن في الشكوى كروع الصادي",86,"د",2,0],["فجَنبَ من بشرك عن جنابي","ونفّرَ طير حظي من رباك",87,"ك",1,0],["فجنبنا العذاب إلهي واعفو","فلا حرا نطيق ولا غراما",88,"م",2,0],["فجنبوني نفثاتِ الهوى","فالقلبِ أضحى حفَنةً من رَماد",89,"د",1,0],["فجنى البغاة جنايتين فطعنةٌ","في النبل والأخرى الدم المتفجر",90,"ر",1,0],["فجنوني بحر مضطربٌ","في الجَزر يميتُ وفي المدِّ",91,"د",1,0],["فجنينا الثمار أينع ما يُج","نَى وكم ضاق بالأكول وِعاه",92,"ا",2,0],["فجناه بنوك ينعاً كما شا","ؤا لذا لم تجد بهم مَهزولا",93,"ل",2,0],["فجناني مشكاة طور التجلي","ولساني خلية اليعسوب",94,"ب",1,0],["فجناسُها نبضٌ يموجُ بخافقي","وطباقُها قدْ مسَّهُ الإشفاقُ",95,"ق",1,0],["فجُنَّ بها فؤادي رغمَ أنفي","جنونًا ما عرفتُ لهُ مُثَنَّى",96,"ن",2,0],["فجُنّ شعري ودسَّ الليلُ ثورتَه","مع التراتيلِ فاخضلَّ الندى النادي",97,"د",2,0],["فجنّةُ اللهِ في إرضاءِ والدةٍ","هذي مقولةُ حقٍّ قالها رسلُ",98,"ل",1,0],["فجنة الخلد إن أحسنت تسكنها","أو تستقر بنار في مهاويها",99,"ي",3,0],["فجنوا ثمارَ جهودهم ممزوجةً","بسعادةٍ هي في القلوبِ جواهرُ",100,"ر",1,0],["فجنتْ عليك المهلكات بدائها","ودعتكَ موجوع الصبابة مبتلى",101,"ل",2,0],["فجَناهُ سَعْدٌ ليس يعرِفُهُ المدى","أو مَنْ تَعَدّتْهُ المواسمُ فانقلَبْ",102,"ب",1,0],["فجندك يا روح الوجود ملائك","ورسل وأقطاب لصون يتيمتي",103,"ت",2,0],["فجند الحق ان قلنا فعلنا","وان ثرنا فابلينا البلاء",104,"ا",2,0],["فجندُ اللهٍ ممأمور بأمرٍ","وبالرحمنِ ندفعُ بالمواجدْْ",105,"د",1,0],["فَجَنَى هَشِيمُ الرَّوْضِ إِثْرَ زُهُورِهِ","وَ هَوَى رَبِيعُ العُمْرِ حِمْلاً مُثْقَلاً",106,"ل",2,0],["فجنيتُ منكَ الخوخ َ وال","تفاح َََواسْتخلَصتُ زُبدَكْ",107,"ك",1,0],["فجُنَّ الفقرُ يا عاري","وألقى النارَ بالغارِ.",108,"ر",1,0]]}