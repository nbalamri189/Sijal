3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146853","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111051","الكامل"],[3998,"","https://poetry.dctabudhabi.ae/diwan/poem/34825","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97093","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103150","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139525",""],[4858,"نذير الثّلج","https://www.poetsgate.com/ViewPoem.aspx?id=155081",""],[4875,"وجهة نظر","https://www.poetsgate.com/ViewPoem.aspx?id=133197",""],[2177,"بنفسي من ناء عن الأهل مبعد","https://www.poetsgate.com/ViewPoem.aspx?id=127087",""],[5156,"تداولت الأكف على سرير","https://www.poetsgate.com/ViewPoem.aspx?id=99156",""],[5376,"يا قاصدَ البيتِ قفْ للهِ وابتهلِ","https://www.poetsgate.com/ViewPoem.aspx?id=205906",""],[5430,"هموم","https://www.poetsgate.com/ViewPoem.aspx?id=1445",""],[5431,"ثورة فكرية ....","https://www.poetsgate.com/ViewPoem.aspx?id=207487",""],[5443,"دموع اليراع في ليل الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=185143",""],[5553,"جنحان اللقا","https://www.poetsgate.com/ViewPoem.aspx?id=185921",""],[5563,"دعوها فإنَّها مأمورة","https://www.poetsgate.com/ViewPoem.aspx?id=214572",""],[5650,"غوايةُ الموجِ الغَدور","https://www.poetsgate.com/ViewPoem.aspx?id=177956",""],[5690,"أسيرُ وقلبي في الغرام أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172162",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5818,"عرب","https://www.poetsgate.com/ViewPoem.aspx?id=200202",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[6008,"بمناسبة شفاء الملك عبدالله بن عبدالعزيز","https://www.poetsgate.com/ViewPoem.aspx?id=61399",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[520,"يا ملطق العبرات وهي غزار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577509",""],[572,"أَكْفِنَا يا عَذُولُ شرَّ لسانِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9418&r=&rc=275",""]],"verses":[["أَكفَيتَني ما قَد حَذِرتُ وُقوعَه","أَم ما كُفيتُ مِنَ الَّذي لَم أَحذَرِ",0,"ر",1,0],["أَكُفُّ بَني عَدنانَ تَستَمطِرُ الظُبى","وَتَأنَفُ مِن جودِ الغَمائِمِ بِالعَهدِ",1,"د",1,0],["أكُفٌّ سِباطٌ تُمْتَرى نَفَحاتُها","إذا لمْ يكُنْ في دَرِّ جاذِبةٍ غَزْرُ",2,"ر",1,0],["أكفى مقيل إن كب","بأخيه في شوط جواده",3,"د",2,0],["أَكَفكِفُ مِن فَرطِ الصَبابَةِ عَبرَة","فَتَنتُقُ عَيني تارَة وَأُغيضُها",4,"ض",3,0],["أُكفَى وأُعفى غيرَ ما مُتجشِّمٍ","تعباً ولا نصباً من الأنصابِ",5,"ب",1,0],["أَكُفُّ الناسِ غيرَك تحت كفِّي","وقابُ الناس غيرك دون قابي",6,"ب",2,0],["أكُفُّ الغواني بالخنا خَضِراتُ","وهنَّ بأقران الهوى ظَفراتِ",7,"ت",1,1],["أَكفٌّ عن الهافينَ طرّاً صوافحٌ","وهنَّ من الباغين مُنتصراتُ",7,"ت",1,0],["أكفأتُ لومَك كلَّه ومججتُهُ","يا لائمي فأَمِحْهُ من يمتاحُه",8,"ح",2,0],["إكفِ الضعافَ اللائي أنت ثمالُهُمْ","مُؤَنَ العناء فإنهنّ شِدادُ",9,"د",1,0],["أكف يدي حِلماً وفضلَ تكرمٍ","وإني لرحب الذرع بالبسط والقبض",10,"ض",1,0],["أكفُّكُمُ في الأرضِ أعينُ مائِها","وأقدامُكم فيها مِراس الزلازلِ",11,"ل",1,0],["أكفلْتَ نَغْلَي شيخةٍ","ولدتهما من غيرِ طائلْ",12,"ل",1,0],["أكفُّكُمُ في الأرضِ أعينُ مائِها","وأقدامكم فيها مَراسي الزلازلِ",13,"ل",1,0],["أكفكف بالأيدي بوادر أدمعي","ويأبين إلا أن يفضن جواريا",14,"ي",2,0],["أكفاك يا شيح المؤي","د ما جرى أم ما كفاك",15,"ك",1,0],["أَكفانُ وَشيٍ فُصِّلَت","بِرَقائِقِ الذَهَبِ الفَتين",16,"ن",1,0],["اِكفِني دِقَّةَ اللِئامِ بِتَخفي","فِكَ ما جادَ مِن خَراجي الثَقيلِ",17,"ل",1,0],["أَكَفُّ اِبنِ لَيلى أَم يَدٌ عامِرِيَّةٌ","أَمِ الفاضِلاتُ الناسِ أَيدي بَني سَعدِ",18,"د",1,0],["أُكَفكِفُ عَبرَةَ العَينَينِ مِنّي","وَما بَعدَ المَدامِعِ مِن كَلامِ",19,"م",1,0],["أكفُفْ يَدَيْك عَنِ اللِّئامِ ولو","أضحَتْ يَداكَ من الغِنى صِفْرا",20,"ر",2,0],["أَكُفُّ تَغلبَ أنواءُ الحَيا الجاري","ونارُ بأسِهِمُ أذكى من النارِ",21,"ر",1,1],["أَكُفُّ لِساني عَن صَديقي وَإِن أَجَأ","إِلَيهِ فَإِنّي عارِقٌ كُلَّ مَعرَقِ",22,"ق",1,0],["اِكفِف لِحاظَكَ وَاِغمِد ذا الفِقارِ فَما","عَليكَ في قَتلَةِ العُشّاقِ مِن عَجَلِ",23,"ل",1,0],["أَكُفُّهُمُ لِلمَكرُماتِ مَفاتِحٌ","وَذِكرُهُمُ لِاِسمِ الكِرامِ فَواتِحُ",24,"ح",1,0],["أَكفاءَهُ تَلِدُ الرِجالُ وَإِنَّما","وَلَدَ الحُتوفُ أَساوِداً وَأُسودا",25,"د",2,0],["أَكُفاً في المَكارِمِ قَدَّمَتها","قُرونٌ أُورِثَت مِنا قُرونا",26,"ن",2,0],["أَكُفُّ الدَمعَ عَن خَديَّ مِنها","وَيَأبى دَمعُها إِلّا اِنحِدارا",27,"ر",2,0],["أُكَفكِفُها جاهِداً عَنهُمُ","وَتَغلِبُ صَبري فَما تَنشَحُ",28,"ح",1,0],["أَكفِئ سَوامَكَ في الدُنيا مُياسَرَةً","وَأَعرِضَن عَن قَوافي الشِعرِ تُكفِئُها",29,"ا",3,1],["أَكُفُّ غَرْبَ دُمُوعِي وَهْيَ جَارِيَةٌ","خَوْفَ الرَّقِيبِ وَقَلْبِي جدُّ مُلْتُاعِ",30,"ع",1,0],["أَكْفَى مُقِيلٍ إِنْ كَبَا","بِأَخِيهِ فِي شَوْطٍ جَوَادُهْ",31,"د",2,0],["اكفكف عبرة في جنب أخرى","وذلك دينها أبدا وديني",32,"ن",2,0],["أُكَفْكِفُ عَنْهُمْ صُحْبَتِي وَإخَالُهُمْ","مِنَ الذُّلِّ يَعْراً بِالتَّلاَعَةِ أعْفَرَا",33,"ر",2,0],["إكْفِني دِقّةَ اللّئَامِ بتَخْفي","فِكَ ما آدَ مِنْ خَرَاجِي الثّقِيلِ",34,"ل",1,0],["أُكَفْكِفُ عَبْرَةَ العَيْنَيْنِ مِنّي،","وَمَا بَعْدَ المَدَامِعِ مِنْ مَلامِ",35,"م",1,0],["إكفِ الضعافَ اللاتي أنت ثمالُهُمْ","مُؤَنَ العناء فإنهن شِدادُ",36,"د",1,0],["اكفكف دمعي والرزايا تذيعه","فحزني قطين والدموع شريد",37,"د",1,0],["أَكفف مَلامك حَيثما أَحتكم الهَوى","يا عاذِلي وَأَقَلَّ مِن تَعنيفي",38,"ف",2,0],["أُكَفكِفُ دَمعَها الجَارِى بِكفي","ولَم يَكُ لِلدُّمُوعِ مِن انقِطَاعِ",39,"ع",1,0],["أكف الكرام السادة الغر إنها","شفاء السقيم الجاسم والناحل المضنى",40,"ن",2,0],["أكفكف إن تسيل دموع عيني","إذا نظرت أحبتها العيون",41,"ن",1,0],["اكفنيهم يمزجة من مداد","فوق فصل بلفظة من كلام",42,"م",1,0],["اكفني ذلكَ الصدودَ فإني","لا أىرى الصدَّ غيرَ طالعَ نحسِ",43,"س",1,0],["أكف عن الإخوان شرة عثرتي","وأسلم من قيل وكثرة قال",44,"ل",1,0],["أَكُفُّهُمُ وَإِن بَذَلوا جُمودٌ","وَأَنفُسُهُم وَإِن كَرّوا صِغارُ",45,"ر",1,0],["أكُفُّ أَكُفِّي عَنْ تِلاَدِي تَقَذُّراً","لَهُ إِنْ دَنَتْ مِنْهُ أَكُفُّ يَدَيْ دَنِي",46,"ي",1,0],["أَكُفُّ مَنثورِها يَدعو بِطولِ بَقا","ءِ الصاحِبِ بنِ عَلِيٍّ بَسط أَيديها",47,"ي",3,0],["أَكُفُّهُمُ السُحبُ يَهمي جَداها","وَفيها الصَواعِقُ تُصمي عِداها",48,"ا",3,0],["أُكَفكِفُ الدَّمعَ بِخَدّي قانِياً","فَانثَني مِن أَدمُعي خاضِبَ كَف",49,"ف",1,0],["أُكَفكِفُ الدَّمعَ بِخَدَّيَّ أَسىً","فَيَملَأُ الكَفَّينِ كُلَّما وَكَف",50,"ف",1,0],["اُكفُف مَلامي وَلا تَزِد أَلَمي","حَسبِيَ ما بي مِنَ الهَوى وَكَفى",51,"ف",2,0],["أَكفُّهُم يَومَ النِزالَ صَواعِقٌ","وَلَكِنَّها عِندَ النَوالِ بُحورُ",52,"ر",1,0],["أَكفى الكفاةِ مَشرِقاً وَمَغرِباً","وَأَنجَبُ العُجم نصاباً وَالعَرَب",53,"ب",1,0],["أَكُفُّ كَفٍّ عَيوفٍ أن أنال بها","زادَ اللّئيمِ فأَطْوي بَطْنَ طَيّان",54,"ن",1,0],["أَكُفُّ منه ما بَدَر","وأكتُمُ الصّحْبَ الخَبر",55,"ر",1,0],["أَكُفُّهُمُ سُبطٌ وَأَعراضُهُم حِمىً","وَأَقوالُهُم فِعلٌ وَأَموالُهُم نَهبُ",56,"ب",1,0],["اكفر بنفسك إن هاجرتَ مُغترباً","تجد ثواباً يزين النفس بالمِنَن",57,"ن",1,0],["أَكفكف الدَمع جُهدي وَهُوَ يَسبِقُني","وَاِستُر الحُب وَالأَشواق تَفضَحَني",58,"ن",2,0],["أَكفكف كُلَما ذَكَروا دُموعي","فَتَعصيني وَتَأبى غَير جودي",59,"د",2,0],["أكفكِفُ أسراب المدامع والْهوى","يقول أذيعي سرَّه وأضيعي",60,"ع",2,0],["أَكفهم سبط وأَعراضِهِم حمىً","وَأَحلامهم طود وَأَموالهم نَهبُ",61,"ب",1,0],["أكَفّرَ البعدُ عَنهم ما جَنَوهُ أم ال","أيّام أنْسَتْكَ بعد البَينِ ما صَنَعُوا",62,"ع",3,0],["أُكفكِفُ من عَينيَّ خشية","من الواشي أَنْ يدري بها فتسيل",63,"ل",1,0],["أُكفْكفُ عبرة الملهوف فيها","وتحتَ أضالعي نار الجحيم",64,"م",1,0],["أُكفكفُ بعدهم دمعاً كريماً","جرى من لوعة الوجد اللَّئيم",65,"م",1,0],["أُكفكفُ من عيني بوادرَ عَبرة","وأبكي لبرقٍ شِمْتُه يتبسَّمُ",66,"م",1,0],["اِكفِ الذي استكفَوْك واحملْ لهم","ما تَحمِلُ الصُّمُّ الأهاضيبُ",67,"ب",1,0],["أكفكفُ بالحمى نَزواتِ عيني","وقد غَصَّتْ بأدمعها الغُروبُ",68,"ب",1,0],["أكَفْكِفُ عنْ سَمعِ الأميرِ مَدائحي","مَخافَةَ ظَنٍّ أنَني أبْتَغي رِفْدا",69,"د",2,1],["اكفهم للخطب كف وهي","فينا قبل تسجد فيها القبل",70,"ل",1,0],["أكفهم أمهات الصفاح","متى ظمئت أوردتها وريدا",71,"د",2,0],["أكفكف غربَ الدمعِ والدمعُ جاهل","واستنجد السلوان وهو حليم",72,"م",1,0],["أكفُّهمُ قوابضُ للمواضي","وهنَّ بواعثُ القدرِ المتاح",73,"ح",1,0],["أكفكِفُ الدمعَ خوفَ الكاشحينَ على","مواطنٍ أقفرتْ منهمْ وآثارِ",74,"ر",1,0],["أكفكِفُ أدمعي فيها مِراراً","مِنَ الواشي وأُطلِقُها مِرارا",75,"ر",2,0],["أكفيل آل محمد ووليهم","من حيث عرف وليهم إنكار",76,"ر",1,0],["أَكفُّهُم لِلمُجتَدين الغِنى","وَدورُهُم في النائِباتِ الحِمى",77,"ا",1,0],["اكْفِنَا يَاعَذُولُ شَرَّ لِسَانِكْ","وَالْهُ عَنَّا فَشَانُنَا غَيْرُ شَانِكْ",78,"ك",1,1],["أُكفُفْ ندى كفَّيْكَ رُبَّ زيادةٍ","نَقَصَتْ فَكَانَ الفضلُ للنُّقْصَانِ",79,"ن",1,0],["اكفُفْ سحابَ نوال مُذْ هطلْتَ به","غَرَّقتني منه قبل الوَبْل بالبَللِ",80,"ل",1,0],["أَكْفُفْ أَيَاديك عنِّي إِنَّني رجلٌ","أَخافُ منها على نَفْسي من البَطَرِ",81,"ر",1,0],["اكفلت في الدنيا الخلود وأين قد","ذهب الجدود فمن حمامك لا مفر",82,"ر",1,0],["أكَفُّكَ بالقَناةِ أشَفُّ حسنا","بها أم كفُّ أختِكَ في السَّوار",83,"ر",1,0],["اكف بحور والسيوف جداول","وتمدح احياء الفخار كبارها",84,"ر",3,0],["أكف سواك لو أجرت عيونا","أرى شرفي لنائلها أبيا",85,"ي",2,0],["أكفُّ لسان الدمع إن يشكوَ الهوى","كأن لسان السقم لا يُحسنُ الشكوى",86,"ك",3,1],["أكف لسانَ الدمع أن أشكوَ الهوى","كأن لسان السقم لا يحسن الشكوى",87,"ك",3,1],["أَكفُ بالشعرِ ينشده","يريدُ إِيضاحَه فَليُلغزه",88,"ز",2,0],["اِكفِهِ شاةَ مَنيعٍ وَحدَها","يَومَ لا يُصبِحُ في البَيتِ عَلَف",89,"ف",1,0],["اِكفِهِ ذاتَ سُعالٍ شَهلَةً","مُتِّعَت في شَرِّ عَيشٍ بِالخَرَف",89,"ف",1,0],["اِكفِهِ يا رَبِّ وَقصاءَ الطُلى","أَلحِمِ الكِتفَينِ مِنها بِالكَتِف",89,"ف",1,0],["أكفُّ عواذلي عنه بوَفري","وجَوذ الجُود هطَّالٌ سِجام",90,"م",1,0],["أكُفرَاً بعد رَدِّ المَوتِ عني","وبَعدَ عَطائِكَ المائةَ الرِّتاعا",91,"ع",2,0],["أكفهم من حديد إذا","سألت وأوجههم من صخورِ",92,"ر",1,0],["أكفكم أندى من الغيث راحة","تصوب فتستجدي نداها بحورها",93,"ر",3,0],["أكفهم ترمي ولادم طافح","وألحاظهم تصمي القلوب وترشق",94,"ق",1,0],["إكفاؤهم خلف الروي ويجي","مع اختلافه بقرب المخرج",95,"ج",1,0],["أَكفى الكِفاةِ لَقَد تَهَلَّلَت الدُنى","مِن