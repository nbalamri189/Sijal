{"poems":[[55,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[91,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[87,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[47,"صيرتني غاية العشاق كلهم","https://www.aldiwan.net/poem64522.html","البسيط"],[68,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[89,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[92,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[52,"يا رحمة الله حلي في منازلنا","https://www.aldiwan.net/poem63828.html","البسيط"],[108,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[234,"ظلموا البين والنوى والرقيبا","https://www.aldiwan.net/poem51215.html","الخفيف"],[412,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[422,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[422,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[447,"من لائمي إن سفحت الدمع من مقلي","https://www.aldiwan.net/poem14476.html","البسيط"],[510,"الحسد","https://www.aldiwan.net/poem61088.html","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96995","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39048","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122309","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34798","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70948","المديد"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112382","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112424","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66590","الخفيف"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130557","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136924",""],[4960,"المَنكِب البَرزَخي","https://www.poetsgate.com/ViewPoem.aspx?id=210746",""],[5190,"كفرت بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=153362",""],[5431,"ليلى والذئاب....","https://www.poetsgate.com/ViewPoem.aspx?id=207188",""],[5728,"لا أَذاق الله عيناً وسنَا","https://www.poetsgate.com/ViewPoem.aspx?id=191182",""],[5851,"وصية مرتحلة","https://www.poetsgate.com/ViewPoem.aspx?id=175272",""],[6259,"إعترافي بعظم فضلك فضلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59392&r=&rc=40",""]],"verses":[["لا أَذُمُّ الإِسراءَ في طَلَبِ العِز","زِ وَلَكِن في فُرقَةِ العُشّاقِ",0,"ق",1,0],["لا أذُمُّ الزمانَ ما كنتَ ترعى","يا أبا الصَّقرِ حُرمَتي وذِمامي",1,"م",2,0],["لا اذكر الادب الذي يتمته","الا اكد له بدمعي اشرق",2,"ق",1,0],["لا اذى بعد البوا","ر فخفف وجلك",3,"ك",1,0],["لا إذ من العادات ما لا يستوى","فيه البكات لكونهم درجات",4,"ت",1,0],["لا أَذكُرُ الدُنيا إِلَيكَ فَرُبَّما","كَرِهَ الحَديثَ عَنِ الأَجاجِ المُغرَقُ",5,"ق",1,0],["لا أَذكُرُ الدَهرَ يَوماً مِنكَ أَبهَجَني","وَالدَهرُ يَبعَثُ مِنّي الحُزنَ وَالعِبَرا",6,"ر",2,0],["لا أَذمُمُ الدَهرَ في أَمرٍ رُميتُ بِهِ","وَلا أَقولُ حَصاةُ الحَظِّ ما رَشَحَت",7,"ت",1,0],["لا أَذْكُرُ اللَّهْوَ إِلَّا أَنْ تُذَكِّرَنِي","وَرْقَاءُ تَدْعُو هَدِيلاً بَيْنَ أَغْصَانِ",8,"ن",1,0],["لا أذُم الدهر هذي سُنة","للهنا حال وللأحزان حال",9,"ل",1,0],["لا أَذكُرُ الجَنَّةَ المَغبوطَ ساكِنُها","وَقَد نَسيتُ وَعيدَ اللَهِ بِالنارِ",10,"ر",1,0],["لا أذكرُ الصَّهْباء حي","ن تُشَابُ بالماء الزُّلال",11,"ل",1,0],["لا أَذُم الفراق في بُعد مَنْ قَدْ","سكنَ العينَ والحشا والقلوبا",12,"ب",2,0],["لا أَذُمُّ الزَمانَ إِذ كنت منه","ما بِدَهرٍ سَخا بِمثلك بُخلُ",13,"ل",1,0],["لا أذُمُّ الشَّيْبَ ينهاني به","وَرَعي حين بدا عن كلّ ذام",14,"م",1,0],["لا أذوق الكرى ولا أطعمُ الغم","ضَ ولا تَنثني لطيفٍ وسادي",15,"د",2,0],["لا أذخر الدمع مخصوص به أحد","من بعد أمي وأمي غاية الأمل",16,"ل",1,0],["لا أذْهبَ اللهُ شرّاً اسمهُ الحسدُ","عمّنْ رأوا أنّهم شيئٌ وهُمْ عدَمُ",17,"م",1,1],["لا أذْهبَ اللهُ عنهُمْ ما بهِ اتّحدُوا","شرٌّ وضُرٌّ بهِ أعمارُهُمْ قُزُمُ",17,"م",1,0],["لا أذهبَ اللهُ عنهُمْ ما بهِ بعِدُوا","شرٌّ بهِ نقصُوا والنّقْصُ مُقْتَحَمُ",17,"م",1,0],["لا أذم الزمان وهو محلىً","بأبي المصطفى علاً وبهاءا",18,"ا",3,0],["لا أذوقُ المَنامَ إلّا غِراراً","لا أنالُ الوِصالَ إِلّا أمالي",19,"ل",2,0],["لا اذم العيس للعيس يدٌ","في تلاقينا وللاسفار نجح",20,"ح",1,0],["لا أَذوقُ النّومَ ذابَت مُهجتي","مِن ضَنى السُّهدِ وَمسَّ العينَ قرحُ",21,"ح",1,0],["لا أُذيل الآمالَ بعدك إنِّي","بَعْدَها بالآمالِ حقُّ بَخيلِ",22,"ل",1,0],["لا أذُبُّ الكلبَ عن عسلٍ","فيه ذُبَّانُ الخرا نقع",23,"ع",1,0],["لا أذمُمِ الدنيَا إذا","ما غَيّرَت حالاتها",24,"ت",3,0],["لا أُذيعُ الشّعرَ إِلاّ","بعدما يُبتلى عَلَيها",25,"ي",3,0],["لاَ أَذُمُّ الزَّمَانَ إِذْ كُنْتَ فِيهِ","يَا سَحابَ النَّدَى لِرِزْقِي كَفِيلاَ",26,"ل",2,0],["لا أذم الأرض ما كانت دما","وسما العلياء ما كانت غبارا",27,"ر",2,0],["لا إِذا الطُّروَادُ بادُوا وَإِذَا","خَرَقَ الزَّرقاءَ لِلجَوِّ العَوِيل",28,"ل",1,0],["لا أذم الهجر في الهجر لنا","بسطة العيش واسباب الغلاب",29,"ب",1,0],["لا أُذنَ تسمع يا أنا، فالمَعذِرَة","بُحَّت بلا جدوى هناك الحُنجرَة",30,"ر",2,1],["لا أُذنَ تَسمَعُ مَا فِي الشِّعرِ مِن طَرَبٍ","لا عَقلَ يُدركُ مَا فِي الشِّعرِ مِن فَحوَى",31,"و",2,0],["لا أُذْنَ تَسمَعُهُ ، لا نَقدَ يَدفَعُهُ","لا نَهرَ مِنهُ إِذَا اْشتَدَّ الصَّدَى يُروَى",31,"و",2,0],["لاأذنَ تسمعُ للضعيف شكاية","صوت القوي مجلجلا ما يُسمعُ",32,"ع",1,0],["لا أَذاق الله عيناً وسنَا","أبصرتْ سلمى ولم تعشق مِنى",33,"ن",2,1],["لا أذهبَ اللهُ حرفاً كنتُ أكتبهُ","فما أتيتُ لأمضي مِثلما زعموا",34,"م",3,0],["لا أذمّ الزمان إذ كنتَ فيه","ما لدهر سخا بمثلك بخلُ",35,"ل",1,0]]}