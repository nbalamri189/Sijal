{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[65,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[73,"لنا حاكم أعمى سديد قضاؤه","https://www.aldiwan.net/poem3886.html","الطويل"],[53,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[53,"مالي إذا زدت حبا زدت مقلية","https://www.aldiwan.net/poem66437.html","البسيط"],[72,"وأسود شيخ في الثمانين سنه","https://www.aldiwan.net/poem42792.html","الطويل"],[30,"وقائلة لي ما فعلت إذا التقت","https://www.aldiwan.net/poem5459.html","الطويل"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[82,"فؤادي نجيب والجلال نجيب","https://www.aldiwan.net/poem31549.html","الطويل"],[46,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[46,"جعلت فداك عبد الله عندي","https://www.aldiwan.net/poem30541.html","الوافر"],[50,"ومقرور مزجت له شمولا","https://www.aldiwan.net/poem10777.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[173,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[235,"له لدعاء أمير المسلمين ارتياحة","https://www.aldiwan.net/poem4037.html","الطويل"],[242,"هل لذي البعد من تدان يدوم","https://www.aldiwan.net/poem19071.html","الخفيف"],[280,"جناني عامر بهوى جناني","https://www.aldiwan.net/poem25501.html","الوافر"],[463,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[545,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104099","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87266","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70835","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62505","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119888","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72308","الطويل"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64707","المتقارب"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124311",""],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206183",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[1973,"","https://poetry.dctabudhabi.ae/diwan/poem/145498","الطويل"],[2128,"","https://poetry.dctabudhabi.ae/diwan/poem/143662","المنسرح"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111095","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53081","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53183","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109464","البسيط"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116829","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129859","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93419","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58371","السريع"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115670","الطويل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216562",""],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89080","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52971","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62895","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62867","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62937","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108327",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131267",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114427","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77024","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72587","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76685","الطويل"],[1901,"زمانك هذا حربُ كل نَبيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=160403",""],[4903,"وَأضخمَ هنديّ النَجارِ تُعدّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=96540",""],[5199,"كلنا لجل الملك والسعوديه فدى","https://www.poetsgate.com/ViewPoem.aspx?id=147704",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""],[5848,"شفة غياب","https://www.poetsgate.com/ViewPoem.aspx?id=53330",""],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[1395,"على منزل كان الحبيب به قل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605517",""],[6171,"لا فِتَةٌ عَلى بَوابةِ العَام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84672&r=&rc=2",""]],"verses":[["لَهُ لَغَطٌ مِنِ اِصطِكاكِ رِماحِهِ","تَنِقُّ عَواليها نَقيقَ العَلاجِمِ",0,"م",1,0],["لهُ لَفْتةُ الخِشْفِ الأغَنِّ ونَظْرَةٌ","بأمثالِها في عُقدَةِ السِّحْرِ يُنفَثُ",1,"ث",1,0],["لَهُ لَهجَةٌ خَرساءُ يَجري بِها القَضا","تَرى فُصحاءَ الناسِ في جَنبِها بُكما",2,"م",2,0],["له لَقَبٌ من التجمي","شِ يشبه نَفْسَه الجذِلَهْ",3,"ل",2,0],["له لدينا حلاواتٌ لذاذتُها","تشفي القلوب وتجلوها من الرّيْن",4,"ن",1,0],["لَهُ لِحيَةٌ مُبيَضَّةٌ مُستَديرَةٌ","أُشَبِّهُهُ فيها عُقاباً مُطَوَّقا",5,"ق",2,0],["لَهُ لَيلَةُ البَيضاءِ إِذ أَنا خائِفٌ","لِذَنبي وَإِذ قَلبي كَثيرُ البَلابِلِ",6,"ل",1,0],["لَهُ لَقَبٌ لِباغي الخَيرِ سَهلٌ","وَكَيدٌ حينَ تَبلوهُ مَتينُ",7,"ن",1,0],["له لَوْلَبٌ في العين ليس يديره","لذي ظمإٍ حَيث المياهُ تلوبُ",8,"ب",1,0],["لَهُ لِواءُ نَدىً ما هَزَّ عامِلَهُ","إِلّا أَراكَ لِواءَ البُخلِ مَنكوسا",9,"س",2,0],["لَهُ لُمَةٌ مِنَ الكُتّابِ بيضٌ","قَضَوا حَقَّ الزِيارَةِ وَالوِدادِ",10,"د",1,0],["لَهُ لَقَبٌ يَليقُ بِناطِقيهِ","بَديعٌ لَيسَ يُعجَمُ في الكِتابِ",11,"ب",1,0],["لهلاكي يبرى العدو سهاماً","يرتميني وأنني غير رام",12,"م",1,0],["لَهُ لمَعَاتُ المشرَفي ازْدَهَتْ بِهِ","عَلَى كلِّ أَبْنَاءِ الغُمُودِ صَيَاقِلُهْ",13,"ل",2,0],["لَهُ لجَبٌ كادَت مِراراً لِهَولِهِ","تَقَطَّعُ بَينَ المُسلِمينَ العَلائِقُ",14,"ق",1,0],["لَه لحيةٌ مقصوصةٌ من جذورها","تُترجِمُ عنهُ أنّ في نفسهِ أمرا",15,"ر",2,0],["لهُ لدعَاءِ أَميرِ المُسلمينَ ارتِياحَةٌ","كأن غريضًا أو مُخارِقًا غناهُ",16,"ه",1,1],["لِهِلاَلِ الْهُدَى سَعِيدِ الْمَعَالِي","مَنْ بِهِ سَعِدَ الْبَيَانُ الْوَسِيمُ",17,"م",1,0],["لَهُ لَهَجٌ بِمُخْتَرعِ المَعَالي","كَمَادِحِهِ بِمُخْتَرعِ المَعَانِي",18,"ن",2,0],["له لونٌ يخبِّرُ عن وجوه ال","جِنانِ وقد توغّلَ في الجحيمِ",19,"م",1,0],["لَهُ لَحَظاتٌ عَن حَفافي سَريرِهِ","إِذا كَرَّها فيها عِقابٌ وَنائِلُ",20,"ل",1,0],["لهُ لسانانِ من قرنٍ إلى قَدمِ","لا ينطُقانِ بغير السّحرِ والحِكَمِ",21,"م",1,1],["لِهَلاك مِن رامَ الخَلاصْ","مِنهُم فَأدركه الأَجلْ",22,"ل",1,0],["له لونٌ كخافية الغُدا","فِ الطائرِ الوعرى",23,"ر",2,0],["له للسلم من سرَّاه بَرْد","ومن بأساهُ للحرب اضطَرام",24,"م",1,0],["له لحظيريه القرب بعدا","ولفنا يخرق السمع الأصما",25,"م",2,0],["له لي عذل خف لا شك عنده","ولكن أتاني منه وهو ثقيل",26,"ل",1,0],["له لدى الجمع فرقٌ يستضىءُ بهِ","كالجمع في فرقهِ ما زالَ يُلقيهِ",27,"ي",2,0],["لَهُ لِحْيةٌ لا سَقَاهَا الحَيَا","إِليها يُساقُ حَديثُ الحَدَثْ",28,"ث",1,0],["له لِمَّةٌ علت على كل لِمَّة","تُضل المدارى في مُثَنَّى ومُرسل",29,"ل",1,0],["لَهْ لسانٍ بالذكر دومه رَطِب","وحسن خلقٍ فيه تضرب به عجاب",30,"ب",1,0],["لهلَّ إلى ذُراكَ بها سُرُورٌ","بِقُرْبِكَ أُشْرِبَتْهُ وَهْيَ طين",31,"ن",1,0],["له لسان بذكر الله عوده","وخاطر في جلال اللَه جوّال",32,"ل",1,0],["لَهُ لِبَدٌ كَجَناحِ الظَليم","بِيضُ الأَسافِلِ حُمرُ الذُرى",33,"ا",1,0],["له لون ما بين الصباح وليلهِ","إذا نطق العصفور أو غرد الصقرُ",34,"ر",1,0],["له لحاظ مرضى بلا سقم","سكرى من الغنج تسكر الصاحي",35,"ح",2,0],["له لهب تأجج في فؤادي","مقيم لا اطيق عليه صبرا",36,"ر",2,0],["له لفتات نحو أسنمة الحمى","وحَنَّةُ مشتاق وأنة مكمد",37,"د",1,0],["له لفتة نحو التسلي يكفها","حنين وأحوال المحبين أهوال",38,"ل",1,0],["له لسان ولكن ليس يقطعه","من الخناجر حدٌّ أو من القُضُب",39,"ب",1,0],["لهُ لحظَةٌ فيها لنا اليُسرُ بالغنى","وأخرى رموقٌ للعدُوِّ بمرصَدِ",40,"د",1,0],["له لون ذي عشق وحسن معشّق","لذلك فيه ذلّةٌ ومراح",41,"ح",1,0],["لَهُ لببٌ مِن شُهبَةٍ بَينَ دُهمَةٍ","كَعام صُدودٍ بَعدَ يَومِ وِصَالِ",42,"ل",1,0],["لهُ لِسانٌ إنْ تُثَقِّلْ لَهُ","كَفّتَهُ طارَ على حَبّه",43,"ب",2,0],["له لحظات ما تسل سيولها","وتغمد الا في فؤادي بلا شك",44,"ك",1,0],["لِهْ لِهْ مَعي فِيْ القَلْب مِلْيَاه","وْلَي لَي مَعَهْ لَي غِبْتْ خِلَّه",45,"ل",2,0],["له لسان في الطريق عالي","دان له فيه ذوو المعالي",46,"ي",1,0],["له ليتماروا من الألبان","وكان يدعى بابي الضيفان",46,"ن",1,0],["لهلوله قال البشير مؤرخاً","اللَه أحمد ضاء نور محمد",47,"د",1,0],["لهلاك جبار بغىٍ فطردته","قد جال شرقاً في البلاد ومغربا",48,"ب",2,0],["له لين متنكَ في المنتصى","وبشرُك في النَّظرِ الأَشْوَسِ",49,"س",1,0],["لهُ لحظةٌ غيرُ مأمونَةٍ","كما يَلْحَظُ الحَاسِدُونَ النِّعَمْ",50,"م",1,0],["له لقبٌ معناه خالفَ لفظَه","وما كلُّ من يُعطي الخِلالَ خَلِيلُ",51,"ل",1,0],["له لطف اخلاق يضن بها الصبا","تزيد على الريحان في طيبة العطرِ",52,"ر",1,0],["لهُ لاحَ ذَيَّاكَ الإِزار مُعلَّقاً","ومن كل دَبَّابٍ وذي أَربَعٍ مَملُو",53,"ل",2,0],["له لدى الجمع فرق يستضيء به","وبالعبودية الخلصا يؤديه",54,"ي",2,0],["له لمعانٌ في دجى النقع ما بدا","لكوكبةٍ إلا ألم بها الرعب",55,"ب",1,0],["له لفظٌ وثغرٌ كاللئالي","فاسمع ما اراهُ بالعيانِ",56,"ن",1,0],["لَهُ لَفتات أَم الخَشف تَرنو","بِعَين تَذكر العَذري شَجوه",57,"و",2,0],["لهلا كوخان أملي المدح في أوراقي","مثل شحرور على منبر دوح راقي",58,"ق",2,1],["له لجج خضر كما اخضرت الربى","الى أُخَرٍ بيضٍ كما ابيضت الكثب",59,"ب",1,0],["له لحيةٌ مثل المِجن تعلقتْ","بأنفِ موشىًّ بالسعوطِ كريهِ",60,"ي",2,0],["لهُ لونُ مَا بين النّهارِ ولَيلهِ","إذَا سَقسَقَ العصفور أو غلّس الصقرُ",61,"ر",1,0],["لهل الفزعه لمن ينتخى ماله عضيد","من لحقه الضيم من جور وقتً به ردى",62,"د",2,0],["لهُ لنبوءةِ العينين كي لا","يزِلّ بغفلةِ المعنى وقوفي",63,"ف",2,0],["له لقب يومي لأكرم منصب","إلى كرم يعز مع أسم يناسبه",64,"ب",2,0],["له لذةٍ لا فارقته الرتابه","له طعنةٍ مثل الجفا بين الاحباب",65,"ب",1,0],["له لبد من نجدةٍ وبسالة","تخر له الأبطال للأنف والفم",66,"م",1,0],["له لمة تعلو على كلّ لمة","تضل المدارى في مثنى ومرسل",67,"ل",1,0],["لهُ لُونُهُ الفِضّي ، يَغدُو مُحَلقاً","وتَعلُو على بَحرِ الملماتِ أبحُرُ",68,"ر",1,0]]}