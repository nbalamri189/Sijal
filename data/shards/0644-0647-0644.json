{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[71,"لنا حاكم أعمى سديد قضاؤه","https://www.aldiwan.net/poem3886.html","الطويل"],[51,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[51,"مالي إذا زدت حبا زدت مقلية","https://www.aldiwan.net/poem66437.html","البسيط"],[70,"وأسود شيخ في الثمانين سنه","https://www.aldiwan.net/poem42792.html","الطويل"],[28,"وقائلة لي ما فعلت إذا التقت","https://www.aldiwan.net/poem5459.html","الطويل"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[80,"فؤادي نجيب والجلال نجيب","https://www.aldiwan.net/poem31549.html","الطويل"],[44,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[44,"جعلت فداك عبد الله عندي","https://www.aldiwan.net/poem30541.html","الوافر"],[48,"ومقرور مزجت له شمولا","https://www.aldiwan.net/poem10777.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[167,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[228,"له لدعاء أمير المسلمين ارتياحة","https://www.aldiwan.net/poem4037.html","الطويل"],[235,"هل لذي البعد من تدان يدوم","https://www.aldiwan.net/poem19071.html","الخفيف"],[273,"جناني عامر بهوى جناني","https://www.aldiwan.net/poem25501.html","الوافر"],[456,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[538,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"]],"verses":[["لَهُ لَغَطٌ مِنِ اِصطِكاكِ رِماحِهِ","تَنِقُّ عَواليها نَقيقَ العَلاجِمِ",0,"م",1,0],["لهُ لَفْتةُ الخِشْفِ الأغَنِّ ونَظْرَةٌ","بأمثالِها في عُقدَةِ السِّحْرِ يُنفَثُ",1,"ث",1,0],["لَهُ لَهجَةٌ خَرساءُ يَجري بِها القَضا","تَرى فُصحاءَ الناسِ في جَنبِها بُكما",2,"م",2,0],["له لَقَبٌ من التجمي","شِ يشبه نَفْسَه الجذِلَهْ",3,"ل",2,0],["له لدينا حلاواتٌ لذاذتُها","تشفي القلوب وتجلوها من الرّيْن",4,"ن",1,0],["لَهُ لِحيَةٌ مُبيَضَّةٌ مُستَديرَةٌ","أُشَبِّهُهُ فيها عُقاباً مُطَوَّقا",5,"ق",2,0],["لَهُ لَيلَةُ البَيضاءِ إِذ أَنا خائِفٌ","لِذَنبي وَإِذ قَلبي كَثيرُ البَلابِلِ",6,"ل",1,0],["لَهُ لَقَبٌ لِباغي الخَيرِ سَهلٌ","وَكَيدٌ حينَ تَبلوهُ مَتينُ",7,"ن",1,0],["له لَوْلَبٌ في العين ليس يديره","لذي ظمإٍ حَيث المياهُ تلوبُ",8,"ب",1,0],["لَهُ لِواءُ نَدىً ما هَزَّ عامِلَهُ","إِلّا أَراكَ لِواءَ البُخلِ مَنكوسا",9,"س",2,0],["لَهُ لُمَةٌ مِنَ الكُتّابِ بيضٌ","قَضَوا حَقَّ الزِيارَةِ وَالوِدادِ",10,"د",1,0],["لَهُ لَقَبٌ يَليقُ بِناطِقيهِ","بَديعٌ لَيسَ يُعجَمُ في الكِتابِ",11,"ب",1,0],["لهلاكي يبرى العدو سهاماً","يرتميني وأنني غير رام",12,"م",1,0],["لَهُ لمَعَاتُ المشرَفي ازْدَهَتْ بِهِ","عَلَى كلِّ أَبْنَاءِ الغُمُودِ صَيَاقِلُهْ",13,"ل",2,0],["لَهُ لجَبٌ كادَت مِراراً لِهَولِهِ","تَقَطَّعُ بَينَ المُسلِمينَ العَلائِقُ",14,"ق",1,0],["لَه لحيةٌ مقصوصةٌ من جذورها","تُترجِمُ عنهُ أنّ في نفسهِ أمرا",15,"ر",2,0],["لهُ لدعَاءِ أَميرِ المُسلمينَ ارتِياحَةٌ","كأن غريضًا أو مُخارِقًا غناهُ",16,"ه",1,1],["لِهِلاَلِ الْهُدَى سَعِيدِ الْمَعَالِي","مَنْ بِهِ سَعِدَ الْبَيَانُ الْوَسِيمُ",17,"م",1,0],["لَهُ لَهَجٌ بِمُخْتَرعِ المَعَالي","كَمَادِحِهِ بِمُخْتَرعِ المَعَانِي",18,"ي",1,0],["له لونٌ يخبِّرُ عن وجوه ال","جِنانِ وقد توغّلَ في الجحيمِ",19,"م",1,0],["لَهُ لَحَظاتٌ عَن حَفافي سَريرِهِ","إِذا كَرَّها فيها عِقابٌ وَنائِلُ",20,"ل",1,0]]}