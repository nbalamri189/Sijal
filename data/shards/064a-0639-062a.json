3,"","https://poetry.dctabudhabi.ae/diwan/poem/74075","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91381","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216576","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69992","البسيط"],[3985,"","https://poetry.dctabudhabi.ae/diwan/poem/177942","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81936","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117220","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120198","الكامل"],[4797,"تالي عصير","https://www.poetsgate.com/ViewPoem.aspx?id=29435",""],[4874,"القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=176613",""],[4929,"لغة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=199221",""],[4119,"خذوا حديث غرامي عن ضنا بدني","https://www.poetsgate.com/ViewPoem.aspx?id=16232",""],[5136,"يا راقد الليل لم تشعر لمن سهرا","https://www.poetsgate.com/ViewPoem.aspx?id=121584",""],[5145,"يا أرض إن أردت أن تفاخري","https://www.poetsgate.com/ViewPoem.aspx?id=108178",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5219,"ذكريات العيد","https://www.poetsgate.com/ViewPoem.aspx?id=193952",""],[5358,"الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=21884",""],[5387,"البيت الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=53667",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5480,"سبعة قوافي","https://www.poetsgate.com/ViewPoem.aspx?id=35173",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5614,"شموخ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=4261",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[402,"دعا الوفاء وهذا وقت تبيان","https://www.poetsgate.com/ViewPoem.aspx?id=36473",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5956,"الغبي بوش","https://www.poetsgate.com/ViewPoem.aspx?id=192356",""],[5956,"أرسلتُ من أموالكم لمياتمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193833",""],[5957,"ليس حبي من هيام وشغب","https://www.poetsgate.com/ViewPoem.aspx?id=128188",""],[6031,"إِنَّا إِذَا جَارَ الزَّمانُ وَسَامَنا","https://www.poetsgate.com/ViewPoem.aspx?id=46270",""]],"verses":[["يَعتَرِفُ الناسُ في مَطالِبِهِ","وَيَلتَقي عِندَ بابِهِ السُبُلُ",0,"ل",1,0],["يَعتَرِقُ اللَحمَ عَلى بارِقٍ","وَيَنتَقي العَظمَ بِرَملِ الشَقيق",1,"ق",1,0],["يَعتَسُّهُ الذِؤبُ في الظَلماءِ مُرتَفَقاً","عَلى رَحايلَ مُلقاةٍ وَأَقطاعِ",2,"ع",1,0],["يَعتادُ ذِكرُكَ ما تَهَزَّمَ مِرجَلٌ","وَطَغى تَغَيُّضُ بُرمَةٍ أَعشارِ",3,"ر",1,0],["يُعتِقُ مِن رِقِّ الهَوانِ عاتِقاً","عَجَّ مِنَ الضَيمِ عَجيجَ الموقَرِ",4,"ر",1,0],["يَعتِبُ أَحياناً وَفي عَتبِهِ","يَهيجُ ما يُخفي مِنَ السُقمِ",5,"م",1,0],["يعْتَدُّ بِها مَلْكٌ شهْمٌ","لوْ رامَ بِها الشّعْرَى لحِقا",6,"ق",2,0],["يَعْتَزُّ مِنْكَ بِتَاحٍ ثَابِتٍ أبَداً","وَمِنْ بَنِيكَ بِأعْضَادٍ وَأَرْكَانِ",7,"ن",1,0],["يَعْتَزُّ مِنْكَ بِتَذْكَارٍ يُتَوِّجُهُ","وَمِنْ بَنِيكَ بِأَعْضَادٍ وَأَرْكَانِ",8,"ن",1,0],["يَعتادُني شَوقٌ فَأَذكُرُها","مِن غَيرِ ما نَسَبٍ وَلا صِهرِ",9,"ر",1,0],["يعتلّ عنك النسيمُ سائره","وتحمل السقمَ أعينُ الغيد",10,"د",1,0],["يَعتريكَ المَحَاقُ ثم يخلِّي","كَ شبيهَ القُلامة الحَجْناءِ",11,"ا",2,0],["يعتدُّ ما يعمِد الشقي بهِ","نيلاً ولم يَعْدُ نفعُهُ بصره",12,"ر",2,0],["يعتدُّ إبداءهُ محاسنَهُ","نَيْلاً لحرَّانَ هَيَّجت حَسَره",12,"ر",2,0],["يَعتمدُ العامدُ إتيانَها","فلا يرى القومُ بها باسا",13,"س",2,0],["يَعْتاش من طَبلها ومن حَرِها","شرَّ معاشٍ لشرِّ مُعْتاش",14,"ش",1,0],["يعتدي سيداً مرجَّىً مخوفاً","فإذا أسخط المرجين خافا",15,"ف",2,0],["يعتري السامعين منه حنين ال","نيب فرَّقتَهُنَّ بعد اقترانِ",16,"ن",1,0],["يَعتَفنَهُ عِندَ تينانٍ بِدِمنَتِهِ","بادي العُواءِ ضَئيلِ الشَخصِ مُكتَسِبِ",17,"ب",1,0],["يَعتَرَضُ الحِرمانُ في مَطلَبي","وَيَحكُمُ الخَزّارُ في شِعري",18,"ر",2,0],["يَعتَمِدُ السُلطانَ مِنهُ عَلى","مُبارِكِ الطائِرِ مَيمونِهِ",19,"ن",2,0],["يَعتادُني طَربي إِلَيكِ فَيَغتَلي","وَجدي وَيَدعوني هَواكِ فَأَتبَعُ",20,"ع",1,0],["يَعتَذِرُ الرُشدُ إِلى ضَلالِهِ","وَيَقرَأُ العَقلُ عَلى جُنونِهِ",21,"ن",2,0],["يَعتَادُني بِالشامِ بِرُّكَ واصِلاً","طَوراً وَطوراً في بِلادِ الأَرمَن",22,"ن",1,0],["يَعتَذِرُ المَوتُ إِلى شَفرَتِهِ","وَتَقصُرُ الآجالُ عَن عِتابِهِ",23,"ب",2,0],["يعتبُ والذنبُ لهُ خطةٌ","يحقُّ للعاقِلِ منها ابتسامْ",24,"م",1,0],["يَعتَمِدُ العَينَ اِعتِمادَ الكَرى","وَيَنتَحي القَلبَ اِنتِحاءَ الكَمَد",25,"د",1,0],["يَعتَدَّ مِثلَ أُبُوَّةٍ لَكَ تِسعَةٍ","بيضِ الوُجوهِ أَعِزَّةٍ أَخيارِ",26,"ر",1,0],["يَعتادُ أُدحِيَةً بُنينَ بَقَفرَةٍ","مَيثاءَ يَسكُنُها اللَأى وَافَرقَدُ",27,"د",1,0],["يَعتَريهِ مِن مُحِبٍّ شَوقُهُ","نازِحِ الدارِ غَرِيبٍ ذي شَجَن",28,"ن",1,0],["يَعتادُهُ كُلُّ مَحفوفٍ مَفارِقُهُ","مِنَ الدِهانِ عَلَيهِ سَحقُ أَمساحِ",29,"ح",1,0],["يَعتامُ جِلَّتَها وَيَقصُرُ شَؤوَها","بِمُؤَنَّفٍ سَلبِ الشَباةِ مُذَلَّقِ",30,"ق",1,0],["يَعتادُ عَينَيكَ مِن تَذَكُّرِها","رِمصانُ مِثلُ العَوائِدِ الخُرُدِ",31,"د",1,0],["يَعتَريهِ الوَسواسُ مِنكِ فَيُضحي","كَالغَريبِ المُكِبِّ بَينَ القُعودِ",32,"د",1,0],["يَعْتَادُهَا مِنْ لَحْنِه مَا اسْتَسْلَفَتْ","فَتُعِيدُهُ نَوْحاً عَلَيْهِ طويلاَ",33,"ل",2,0],["يَعْتَدُّهُ حَيْثُ الزَّمَانُ مُسَالِمٌ","لِيَكُفَّ مِنْ غرْبِ الزمَانِ الحَالِقِ",34,"ق",1,0],["يعتاقُ إبدعي ارتباكُ عواطفي","فاذا مَلكتُ عواطفي فسأُبدِع",35,"ع",1,0],["يَعْتَرِضُ الحِرْمانُ في مَطْلبي،","وَيَحْكُمُ الخَزّازُ في شِعْري",36,"ر",2,0],["يعتادُ أدحية َ بنينَ بقفزة","ٍ مَيْثَاءَ يَسْكُنُها الَّلأى والفَرْقَد",37,"د",1,0],["يعتاد قنص الأسد في وثباته","درب بأحوال النزال خبير",38,"ر",1,0],["يَعتامُهُ مِن جوعِهِ فَلَرُبَّما","يَغتَالُهُ فَيَمُوتُ مِيتَةَ فاسِقِ",39,"ق",1,0],["يعتصم الخائفُ من أمنهِ","في قُلّتَىْ عهدٍ ومثياقِ",40,"ق",1,0],["يَعتَصِمُ الحِلمُ بِجَنبَي حَبوَتي","إِذا رِياحُ الطَيشِ طارَت بِالحُبى",41,"ا",1,0],["يعترض السحب في سماها","وهولنا في النهار فرقد",42,"د",1,0],["يَعتادُ أَبوابَكَ الهَناءُ وَيَه","ديهِ إِلَيها الرَوحاتُ وَالبُكَرُ",43,"ر",1,0],["يَعتادُ رَبعَكَ كُلُّ عيدٍ مُقبِلٍ","وَيَؤُمُّ رَبعَ عَدُوِّكَ العَوّادُ",44,"د",1,0],["يَعتَري عَبد الرَحيم بِلا","وارع حق الصحب وَالرحم",45,"م",1,0],["يَعتَذِرُ العاذِلُ فيهِ إِلى ال","عاشِقِ إِذ يَلقاهُ مِن حَزمِهِ",46,"م",2,0],["يَعتَنِقُ الأَعداءَ مِثلَ اِعتنا","قِ العاشِقِ المَعشوقَ مُستَهتِرا",47,"ر",2,0],["يعتد منها رحمة قدسية","فيبوء للرحمن بالتقديس",48,"س",1,0],["يَعتادُها كُلُّ مُسبِلٍ لَجِبٍ","جَونٍ رُكامٍ سَحابُهُ رُجُحُ",49,"ح",1,0],["يَعتَسُّ مَنزِلَهُنَّ أَطلَسُ جائِعٌ","طَيّانُ يُتلِفُ مالَهُ وَيُضيعُ",50,"ع",1,0],["يَعْتاده خَجَلٌ لذاكَ فما يُرَى","في الرَوْعِ منه الخَدُّ غيرَ مُوَرَّد",51,"د",1,0],["يعتاض من تطهير إثمٍ ها هنا","فيما تطهِّره رسومُ القُوَّم",52,"م",1,0],["يَعتاد في أَلحاظِنا لِودادِهِ","فَكَأَنَّها جُندٌ لَديه وَعسكَرُ",53,"ر",1,0],["يَعتَصِبُ المَجد عَلى نَفسِهِ","وَقَد يُبيحُ الطَعن غَيرَ المُباح",54,"ح",1,0],["يَعْتَلِي من طَرْفِهِ في مَهْمَهٍ","دونَ أَنْ يُكْلَمَ مَعْنَى الكَلِمِ",55,"م",1,0],["يعتد زاداً كثيفاً للمعاد غدا","مثل الفتى عامر الزاكي فتى خلف",56,"ف",1,0],["يعتز جليسهما بهما","ويبيت الحاسد كالابلد",57,"د",1,0],["يعتجر الشَّملةَ حيطاناً إذا","قَرَّ ويحتشُّ إذا ما استرزقا",58,"ق",2,0],["يعتقبون دَرَجاً ذروتَها","تعاقُبَ العقودِ في الصّعادِ",59,"د",1,0],["يعتاده الطير لم يفقد له سلبٌ","فكلُّ سابغةٍ يعتدُّها كفن",60,"ن",1,0],["يعتلُّ خفّاق النسيم بنشره","حتى يخاف لضعفه أن يقبضا",61,"ض",2,0],["يعتقدون الامورَ دَوراً","والناسَ كالزرع والحصاد",62,"د",1,0],["يعتد بالشكر لمولى نعمة","لا يتبع النعمة باعتداده",63,"د",2,0],["يَعْتَادُهَا الشَّوْقُ ثُمَّ يَمْنَعُهَا","خَوْفُ العدَا وَالحَسُودَةِ المَكِرَهْ",64,"ر",2,0],["يَعتَدِلُ التاجُ فَوقَ مَفرِقِهِ","عَلى جَبينٍ كَأَنَّهُ الذَهَبُ",65,"ب",1,0],["يعتادني شوقي إلى الطف فكن","مشاركي في شوقي المعتاد",66,"د",1,0],["يَعْتَقبُ الْمَرْءُ بِها حَالُهُ","بِوَطْئِهِ الْحَزْنَ إلَى الْوَعْسِ",67,"س",1,0],["يَعتريه عند بذل ال","مال أمثال الجنون",68,"ن",1,0],["يعتال نَسعى وضينِ الخِدرِ مَحزمُهُ","مُسانِدٌ شَدَّ منه الدَّايُ والطَّبَقُ",69,"ق",1,0],["يعتلي غفرانه فلها","بين سبط الزهر تجعيد",70,"د",1,0],["يعتاضُ خيلك بالتراب ترائباً","مِنهم وهاماً بالسيوفِ فليقا",71,"ق",2,0],["يَعْتَزُّ أَعْناقَ الصِعابِ اللُجَّنِ","مِن الأَوَابِي بِالرِياضِ المِخْضَنِ",72,"ن",1,0],["يَعْتَزُّ أَقْران العِدَى تَهَضُّمُهْ","كَاللَيْث أَجْراز العَبِيطِ وَضَمُهْ",73,"م",2,0],["يَعْتَقِم الأَجْدالَ وَالخُصُوما","وَيَعْتَقِي بِالعُقَمِ التَعْقِيما",74,"م",2,0],["يَعتمد الإنصاف في المُجادلة","لا يَقصد اللجاج وَالمماحلة",75,"ه",1,0],["يَعتَصِمُ الحِلمُ بِحَنبَي حُبوَتِي","إِذَا رِياحُ الطَّيشِ طارَت بِالحِبَى",76,"ب",2,0],["يعتدّ بالفضلِ للعافي ويشكرُه","كأنّ عافيهِ يحبوهُ ويرفِدُهُ",77,"د",2,0],["يَعتَريني توهّمُ البينَ حتَّى","يَعتَريني توهمُ الأشواقِ",78,"ق",1,0],["يعتاده ندماءُ صدقٍ فيهم","للْمُكرمات عوائد وشمائلُ",79,"ل",1,0],["يَعتادُهُ من حبيبه عِدَةٌ","بزَورةٍ لا يصحّ مَوعِدُها",80,"د",3,0],["يَعتَادُنا حرُّ الصَّيانةِ كلَّما","خطرتْ به الذِّكرى خلالَ الأضلعِ",81,"ع",1,0],["يعتاده التَبلُّدُ","عُقَبى الهوى دمَع يكِفْ",82,"ف",1,0],["يعتقل الرجح في النديّ وما","في كفّه منه غير أنبوب",83,"ب",1,0],["يعتزُّ نفساً يحيِّي اللَهُ طلعتَهُ","يصبو بذكراه قلبٌ ساءَه كربٌ",84,"ب",1,0],["يعتق اللَه من جهنم نفساً","شاء مكسيمس اَن تُحَلَّ وتُعتَق",85,"ق",1,0],["يعتادُ قبرَك للبُكا أَسفاً بِما","قَد كان أَضحَكَهُ الَّذي أَبكاهُ",86,"ا",2,0],["يعتلي الفجر فيهما ذا حياء","وتمر الرياح ذات خضوع",87,"ع",1,0],["يَعتَلي الدَهرُ إِذ عَلا عاجِزُ القو","مِ وَيُنَمّي لِلمُستَتِمِّ الحَميدِ",88,"د",1,0],["يعتاضُ عن وردِ الخدود ويكتفي","من قلةِ الدِّينارِ قهراً بالشَّقا",89,"ق",2,0],["يعتز جارهم كالضيف عندهم","والصون يكنفه من كل محذور",90,"ر",1,0],["يَعتَني بي وَلَستُ غَيرَ تُرابٍ","وَأُجازيهِ جَفوَةً وَهوَ نورُ",91,"ر",1,0],["يعتقد الفوز في ولائكما","ويوقن النجح في إيابكما",92,"م",2,0],["يعتصبن العصائب الناصريا","ت فيحللن منك عقداً وح