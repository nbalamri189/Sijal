{"poems":[[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[72,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[45,"حاشاك من ذكر ثنته كئيبا","https://www.aldiwan.net/poem10895.html","الكامل"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[22,"هل تعرف الدار مذ عامين أو عاما","https://www.aldiwan.net/poem21648.html","البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11120","الكامل"],[100,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[115,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[135,"حق على شعراء مصر رثاكا","https://www.aldiwan.net/poem49172.html","الكامل"],[160,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[270,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[322,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[364,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[443,"ما كان ذنبي يا أعز الناس","https://www.aldiwan.net/poem56049.html","عموديه"],[453,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[453,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"]],"verses":[["وَجَحلٌ سَليمٌ قَد كَشَفنا جِلالَهُ","وَآخَرُ في أَنضاءِ مِسحٍ مُسَربَلُ",0,"ل",1,0],["وجحفل لجبّ تطفو غواربه","كأنما تبّع في أثره تبع",1,"ع",1,0],["وجحيمٍ تَؤُجُّ تَحْتَ فَرادِي","سَ كأَحلامِ شاعرٍ مجنونِ",2,"ن",1,0],["وَجَحاجَحُ الأَزدِ بنِ غَوثٍ حَولَهُ","فِرَقاً يَهُزّونَ اللِحاءَ الشيبا",3,"ب",2,0],["وَجَحفَلٍ لِجَدالِ البَحثِ مُجتَمِعٌ","كَأَنَّهُ لِجِلادِ الحَربِ مَحشودُ",4,"د",1,0],["وَجَحفَلٍ كَبَهيمِ اللَيلِ مُنتَجِعٍ","أَرضَ العَدُوِّ بِبُؤسى بَعدَ إِنعامِ",5,"م",1,0],["وَجَحَدوا كِتابَهُم إِلَيهِ","وَحَرَّفوا قُرآنَهُم عَلَيهِ",6,"ه",1,0],["وجحفلٌ تحتهم الإيوانُ","كلّهموا كسرى أنوشروانُ",7,"ن",1,0],["وجحاجحٌ بيضُ الوجُوه أعزةُ","غُرٌ كأنهمُ نجومٌ تزهرُ",8,"ر",1,0],["وجحيما تحتلّ أجساد من جاءوا","يرمون عنده الإحتلالا",9,"ل",2,0],["وجحجاح الحمى القطب الدسوقي","بعيد الغاية القرم الخطير",10,"ر",1,0],["وجحافلُ في طولِ مصر وعرضها","كانت تساقُ إلى الوغى بنداكا",11,"ك",2,0],["وجحيمه منهم أضر عليه من","حر الجحيم ومن حميم آن",12,"ن",1,0],["وجَحفَلُها يضيقُ البرُّ عنهُ","وفيهِ كلُّ مقدامٍ عدي",13,"ي",1,0],["وَجَحفَلٍ لَجِبٍ جَمٍّ صَواهِلُهُ","عَودٍ يُجِدُّ مَتونَ السَهلِ وَاللوبِ",14,"ب",1,0],["وجُحودُ مَن جَحَد الصباحَ إذا بدا","من بعدِ ما انتشرَتْ له الأضواء",15,"ا",2,0],["وجحدت قبلة عهدنا وهجرت س","عة حبنا وكسرت لي اجراسي",16,"ي",1,0],["وجحيم من عدا","وات كأن الكون قبر",17,"ر",1,0],["وجحود الذي تخص به الحبَّ","لأمضى من كل داء عيى",18,"ي",2,0]]}