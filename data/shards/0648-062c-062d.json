{"poems":[[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[74,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[47,"حاشاك من ذكر ثنته كئيبا","https://www.aldiwan.net/poem10895.html","الكامل"],[68,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[22,"هل تعرف الدار مذ عامين أو عاما","https://www.aldiwan.net/poem21648.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11120","الكامل"],[102,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[119,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[139,"حق على شعراء مصر رثاكا","https://www.aldiwan.net/poem49172.html","الكامل"],[164,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[275,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[327,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[369,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[449,"ما كان ذنبي يا أعز الناس","https://www.aldiwan.net/poem56049.html","عموديه"],[458,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[458,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96974","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64938","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124299","البسيط"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90698","الطويل"],[1653,"","https://poetry.dctabudhabi.ae/diwan/poem/32558","الرجز"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89521","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74174","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112286","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108043","الكامل"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202280","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109916","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91786","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131286",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77117","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58018","الكامل"],[5136,"هنيت بالإقبال والنصر","https://www.poetsgate.com/ViewPoem.aspx?id=121574",""],[5147,"مددنا بصائرنا لا العيونا","https://www.poetsgate.com/ViewPoem.aspx?id=166673",""],[5186,"تلك الخمائل ما تمايل بأنها","https://www.poetsgate.com/ViewPoem.aspx?id=156464",""],[5186,"أبدع الله في الورى تجنيسه","https://www.poetsgate.com/ViewPoem.aspx?id=156436",""],[5190,"الكذبة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=153355",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5431,"سيصيرُ ثغري وردة وتزقزقُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197913",""],[5829,"ليلة العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=210434",""],[5956,"يا رب حَسّنْ صحتي لأحِبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=194000",""],[6093,"ذات موصدة","https://www.poetsgate.com/ViewPoem.aspx?id=204990",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""]],"verses":[["وَجَحلٌ سَليمٌ قَد كَشَفنا جِلالَهُ","وَآخَرُ في أَنضاءِ مِسحٍ مُسَربَلُ",0,"ل",1,0],["وجحفل لجبّ تطفو غواربه","كأنما تبّع في أثره تبع",1,"ع",1,0],["وجحيمٍ تَؤُجُّ تَحْتَ فَرادِي","سَ كأَحلامِ شاعرٍ مجنونِ",2,"ن",1,0],["وَجَحاجَحُ الأَزدِ بنِ غَوثٍ حَولَهُ","فِرَقاً يَهُزّونَ اللِحاءَ الشيبا",3,"ب",2,0],["وَجَحفَلٍ لِجَدالِ البَحثِ مُجتَمِعٌ","كَأَنَّهُ لِجِلادِ الحَربِ مَحشودُ",4,"د",1,0],["وَجَحفَلٍ كَبَهيمِ اللَيلِ مُنتَجِعٍ","أَرضَ العَدُوِّ بِبُؤسى بَعدَ إِنعامِ",5,"م",1,0],["وَجَحَدوا كِتابَهُم إِلَيهِ","وَحَرَّفوا قُرآنَهُم عَلَيهِ",6,"ه",1,0],["وجحفلٌ تحتهم الإيوانُ","كلّهموا كسرى أنوشروانُ",7,"ن",1,0],["وجحاجحٌ بيضُ الوجُوه أعزةُ","غُرٌ كأنهمُ نجومٌ تزهرُ",8,"ر",1,0],["وجحيما تحتلّ أجساد من جاءوا","يرمون عنده الإحتلالا",9,"ل",2,0],["وجحجاح الحمى القطب الدسوقي","بعيد الغاية القرم الخطير",10,"ر",1,0],["وجحافلُ في طولِ مصر وعرضها","كانت تساقُ إلى الوغى بنداكا",11,"ك",2,0],["وجحيمه منهم أضر عليه من","حر الجحيم ومن حميم آن",12,"ن",1,0],["وجَحفَلُها يضيقُ البرُّ عنهُ","وفيهِ كلُّ مقدامٍ عدي",13,"ي",1,0],["وَجَحفَلٍ لَجِبٍ جَمٍّ صَواهِلُهُ","عَودٍ يُجِدُّ مَتونَ السَهلِ وَاللوبِ",14,"ب",1,0],["وجُحودُ مَن جَحَد الصباحَ إذا بدا","من بعدِ ما انتشرَتْ له الأضواء",15,"ا",2,0],["وجحدت قبلة عهدنا وهجرت س","عة حبنا وكسرت لي اجراسي",16,"س",2,0],["وجحيم من عدا","وات كأن الكون قبر",17,"ر",1,0],["وجحود الذي تخص به الحبَّ","لأمضى من كل داء عيى",18,"ي",2,0],["وجحفل كالدبا جاء الدباب به","ومن ثنية هرشي نحوكم طلعا",19,"ع",2,0],["وجَحْفلٍ جَذِلِ الأَعلامِ جَدَّلَهُ","بِجَحْفَلٍ يَجْعَلُ الأَعلامَ أَعْلاماً",20,"م",2,0],["وجَحْفَلٍ شابَ مِنْهمْ طِفْلُهُمْ فَرَقاً","وعادَ فيهِ الضُّحا فالنُّقْعُ كالطَّفَلِ",21,"ل",1,0],["وجحفَل من صحاب المصطفى صبُر","على اقتحام الظبا بالمأزق الوغوي",22,"ي",1,0],["وجحدُكمُ إيّايَ ماتعلمونهُ","وإقرارُكم عندي بذلكَ سيَّانِ",23,"ن",1,0],["وَجَحشُهُم قَد باتَ مَنهوبَ القِرى","وَمِثلُ أَعوادِ الشُكاعى كَلبُهُم",24,"م",1,0],["وجحفلٍ قذَف الأرجاء ذي لجبٍ","عرمرم كزهاء الليل منسجلِ",25,"ل",1,0],["وجَحفَلين أعضَّ الكفر حَدَّهما","رَمى بك اللَهُ بُرجيها فهدَّمها",26,"ه",2,0],["وَجَحفَلاً تَستَخِفُّ الأَرضَ وَطأتُهُ","تَخُرُّ لِلخَيلِ فيهِ الأُكمُ وَالحَدَبُ",27,"ب",1,0],["وَجُحُودُ أوصَافِ الإِلهِ وَنَفيُهُم","لِعُلُوِّهِ وَالفَوقِ للرَّحمنِ",28,"ن",1,0],["وَجحفل قاتم الأَعماق منسدل","كَالغَيث كُل مَحل مِنهُ ممطور",29,"ر",1,0],["وجحيم القَومِ أمسى عِندَما","خبطوا في لجّجٍ في ظُلُمات",30,"ت",1,0],["وجحدت آدابي وهنّ جحدنني","إن لم أنج يومي وأمسي الصارما",31,"م",2,0],["وجحفلا كالليل مستحيلا","يملأ حزن الأرض والسهولا",32,"ل",2,0],["وجحيمُ ربٍّ خالدٌ وأُوارُ نا","رٍ تُسجِرُ الخاطي المُذابَ بذاتِهِ",33,"ت",2,0],["وَجحيم نيران الخلي","ل لديّ مثل الجنة",34,"ه",1,0],["وجحيش ما جاع قط ولا اخ","نى عليه من دهره حدثان",35,"ن",1,0],["وجحفلا يتهادى في أكفهم","من المنى والمنايا جحفل لجب",36,"ب",1,0],["وجَحَدْتُ بَيْعَةَ حَيْدَر","وَعَدَلْتُ عنه إلى عُمَرْ",37,"ر",1,0],["وَجَحَدتُ طوراً قيمَةُ المُبتاعِ لي","مِنهُ وطوراً قُلتُ دَعهُ أَشطُرا",38,"ر",2,0],["وجحدتُه التوحيدَ في أفضاله","وزعمتُ أنَّ له شريكاً في النَّدَى",39,"د",2,0],["وجحفل من يعرب الشم كالأسد","في الوثبة والهصر",40,"ر",1,0],["وجحفل أعدائنا الإنكليز","يملأ سهل الفلا والحزونا",41,"ن",2,0],["وجحيمها بلثامها ووشاتها","ومثير شر حقودها شيطانها",42,"ن",3,0],["وجحود رئيسه كان منه","آمنا فافترى وخان رئيسه",43,"س",2,0],["وجَحَدتِ حُبّاً قَد غَدَا أَثَراً","وغَدَوْتِ بَعدَ فَنَائِهِ ذِكرَى",44,"ر",2,0],["وجحَافلُ الشِّركِ اللَّعينِ تكَالبِتْ","والحربُ منْ كيْدِ العِدَا هيجَاءُ",45,"ا",2,0],["وجحدت الدين لكن","صرت في الخارج قسا",46,"ا",1,0],["وجحافل الأشواق هدت قلعتي","في كلّ ركن نزوةٌ تتحرقُ",47,"ق",1,0],["وجحافل الارهاب تلقى حتفها","موتوا بغيظ حين لا يجدي الحنق",48,"ق",1,0],["وجحدتُ أحياناً بفضلك راجياً","منك السماح عسى تُمارس صفحكا",49,"ك",2,0],["وجَحدتَ خارطةَ الوصولِ لغايةٍ","وهجرتَ درباً للإيابِ مُعَبَّدَةْ",50,"د",2,0],["وجَحَدْتَنِي وسَبَحْتَ في لألائها","فَحُرِمْتَ عيشاً في جِناني راغِدا",51,"د",2,0],["وجَحَافِلُ الشَّيْبِ المُرِيعِ تَرَاجَعَت","لمّا رَأَت مِن عَزمِكَ المُتَوَقِّدِ",52,"د",1,0]]}