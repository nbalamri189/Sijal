m/ViewPoem.aspx?id=15121",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[5409,"نعيك هز أرجاء البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=155455",""],[5447,"التلال المستقلة","https://www.poetsgate.com/ViewPoem.aspx?id=208325",""],[5459,"أراك تَحنّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=203153",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5582,"أَتَعْرِفُ أَطْلالاً لِهِنْدٍ غَوارِثَا","https://www.poetsgate.com/ViewPoem.aspx?id=186765",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5616,"وثن","https://www.poetsgate.com/ViewPoem.aspx?id=203456",""],[5628,"لا أمل في البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=178512",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[5952,"أقيموا على أخلاقنا اليوم مأتما","https://www.poetsgate.com/ViewPoem.aspx?id=197109",""],[5952,"في يوم مولده","https://www.poetsgate.com/ViewPoem.aspx?id=207804",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[6056,"الموادع","https://www.poetsgate.com/ViewPoem.aspx?id=130142",""],[6115,"لاتكتلف للي يدور على فرقاك","https://www.poetsgate.com/ViewPoem.aspx?id=180476",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""],[2625,"بدأتُ باسمِ اللهِ ربيِّ وَصاحِبِي","https://diwany.org/%D8%A8%D8%AF%D8%A3%D8%AA%D9%8F-%D8%A8%D8%A7%D8%B3%D9%85%D9%90-%D8%A7%D9%84%D9%84%D9%87%D9%90-%D8%B1%D8%A8%D9%8A%D9%91%D9%90-%D9%88%D9%8E%D8%B5%D8%A7%D8%AD%D9%90%D8%A8%D9%90%D9%8A/","الطويل"],[5190,"ملل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85046&r=&rc=121",""]],"verses":[["وَلا تَأنَسوا أَنَّ الجِيادَ بِشُكلِها","فَيا رُبَّما أَردَتكُمُ نَزَواتُها",0,"ت",3,0],["وَلا تَأمَنوا صَولَ النُفوسِ وَإِن غَدَت","مَضارِبُها مَفلولَةً وَظُباتُها",0,"ت",3,0],["ولا تأسَوا على الوطن المفدّى","ففي شبانه لكم الكفاء",1,"ا",2,0],["ولا تأمننَّ عروض الزمان","فإنَّ الزمان فعول فعول",2,"ل",1,0],["ولا تأمنوني إن جرى الصلحُ مرةً","فقد تعطف الحربُ الضروس فتضرِس",3,"س",1,0],["ولا تأس من رجعتي إن محو","ت سوء اقتراف بحسن اعتراف",4,"ف",1,0],["ولا تَأْسَ مِنْ حادِثاتِ الدُّهُورِ","فخَلْفَ الدَّياجيرِ فَجْرٌ جَديدْ",5,"د",1,0],["ولا تامل من الأموات عفوا","وإن كان الحسين اباك دعوى",6,"ع",3,0],["وَلا تَأخُذهُ مِن شَفَتَي فَقيهِ","وَلا تَهجُر مَعَ الدينِ العُلوما",7,"م",2,0],["وَلا تَأمَنَنَّ الحَربَ إِنَّ اِشتِغارُها","كَضَبَّةَ إِذ قالَ الحَديثُ شُجونُ",8,"ن",1,0],["وَلا تَأخُذَنّي بِقَولِ الوُشاةِ","فَإِنَّ لِكُلِّ زَمانٍ رِجالا",9,"ل",2,0],["وَلا تَأَرّى لِما في القِدرِ تَرصُدُهُ","وَلا تَقومُ بِأَعلى الفَجرِ تَنتَطِقُ",10,"ق",1,0],["وَلا تَأخُذ عَنِ الأَعرابِ لَهواً","وَلا عَيشاً فَعَيشُهُم جَديبُ",11,"ب",1,0],["وَلا تَأَمَنَن أَن يَحشُرَ اليَومَ رَبُّهُ","لَهُ بَصرٌ مِن قُدرَةٍ وَلَهُ سَمَعُ",12,"ع",1,0],["وَلا تَأمَن فَإِنَّ النَفسَ أَضحَت","إِلى النَكراءِ كَالريحِ الخَريقِ",13,"ق",1,0],["وَلا تَأمَنُ في الحِندِ","سِ مِن وَطئِكَ فاعوسَك",14,"ك",1,0],["وَلا تَأمَنَنَّ الحادِثاتِ فَإِنَّها","تَرُدُّ لُيوثَ الغابِ مِثلَ الضَياوِنِ",15,"ن",1,0],["وَلاَ تَأمَنُوا الدَهرَ الخَؤُونَ فإِنَّهُ","عَلى كُلِّ حالٍ بِالوَرى يَتَقَلَّبُ",16,"ب",1,0],["ولاَ تأخُذُ الكُومُ الجِلادُ رِماحَها","لِتَوْبَةَ في نَحْسِ الشّتاءِ الصَّنابِرِ",17,"ر",1,0],["ولا تَأمَنَن مِن مُبغِضٍ قُربَ دارِهِ","ولا مِن مُحبٍّ أَن يَمَلَّ فَيبعُدا",18,"د",2,1],["وَلا تَأْسَ مِنْ وَقْعِ الْخُطُوبِ وَإِنْ جَفَتْ","عَلَيْكَ فَإِنَّ النَّاسَ مَرْعَى النَّوائِبِ",19,"ب",1,0],["ولا تَأكُلُوا مالاً بإِثْمٍ ولا تَكُنْ","مُعانِدُهُ بالتُّرَّهاتِ وبِالغَضْبِ",20,"ب",1,0],["ولا تأخذ بعثَرةِ كلّ قومٍ","ولكن قل هلمّ إلى الطريق",21,"ق",1,0],["ولا تأردنه يوماً بمحتمل","ولا لتقديسه الأردن امكانا",22,"ن",2,0],["ولا تأمنوا إطراقَه إنّ كيْده","ليَستخرج الضبَّ الخبيثَ من الكُدَى",23,"د",2,0],["ولا تأخذن بعضا من البعض غِيرة","فكلُّ له منكم لديه مقام",24,"م",1,0],["ولا تأتلي حتى تعفى مكانه","وتغسله والجور بالعدل يغسل",25,"ل",1,0],["ولا تائبا من كل ذئب وخاطر","ووهم وإلباس وتكدر أكلتي",26,"ت",2,0],["وَلا تائبٌ مِنهم وهل ثمَّ توبةٌ","وَهُم لا يرَون الوِزرَ في نفسهِ وِزرا",27,"ر",2,0],["ولا تأمنِ الماءَ يخلو بها","فيولدها من بناتِ الحببْ",28,"ب",1,0],["ولا تَأوَّبَني بعد السهاد كَرى","إلا وبتُّ لِطَيفٍ منك معتنِقا",29,"ق",2,0],["وَلا تَأمَنوا مَع عَفوِهِ أَن يُصيبَكُم","بِقارِعَةٍ فَالماءُ وَالنارُ في الزَندِ",30,"د",1,0],["وَلا تأنس بعهد من أناس","اذا عهدوا فَلَيسَ لهم وَفاء",31,"ا",2,0],["وَلا تَألّق بَرق الأَبرقين سناً","إِلّا وَحرَّم أَجفان الشجي وَسَنا",32,"ن",2,0],["وَلا تَأخُذوا عَمَّن رَوى لَكُم الهَوى","وَلكن اِذا شِئتُم خُذوا عَن مُحَرّب",33,"ب",1,0],["ولا تأْمنوا لِينَ أخلاقِه","فشدّةُ بأْسِ القنا أنْ تَلينا",34,"ن",2,0],["ولا تأْمَنا غَيْران أصبحَ دُونَها","ببِيضٍ وسُمْرٍ يَكْنُفُ البِيضَ والسُّمرا",35,"ر",2,0],["ولا تأمن وخف وار","ج علام الخفيات",36,"ت",1,0],["ولا تأوَّد منه القدُّ معتدلاً","إلاّ أبان الّذي في البانِ من أود",37,"د",1,0],["ولا تأمنِ الأحداثَ واخشَ بَيَاتها","فكم نسفت دوراً وكم كسفت نوراً",38,"ر",2,0],["ولا تألُ جهداً في اصْطِفائي فانني","نَهوضٌ بآدايِ المُلوكِ كَفيلُ",39,"ل",1,0],["وَلا تَأَتِنا إِلّا عَلى ظَهرِ عَزمَةٍ","إِذا رَكَضَت في اللَهوِ كانَ لَها السَبقُ",40,"ق",1,0],["ولا تأمنوا الأضغان وهي دفينةٌ","فذو الحزمِ مَن هاب الغيوب وخافا",41,"ف",2,0],["وَلا تَأمَنوا أَمراً بغير رَوِيَّةٍ","لديهِ ولا رأيٍ عليهِ مُبَيَّتِ",42,"ت",1,0],["وَلا تَأمَنوا وَالشرّ ينتجُ بِالأَذى","وَقَد سَحَّ وَدْقِي أَنْ تَسيلَ شِعابي",43,"ب",2,0],["ولا تأمن الخلان إِلّا أَقلهم","عليك إِذا كانت صداقتهم مكرا",44,"ر",2,0],["وَلا تَأخُذ مِن السُفليِّ عَهداً","فَمن عاداته نَقض العُهود",45,"د",1,0],["ولا تأسفنَّ على فوتِهِ","فليس يُفيد عليه الأسَفْ",46,"ف",1,0],["ولا تأمنن الدهر بعدي حرة","وقد نكح البيض الحرائر حنطب",47,"ب",1,1],["ولا تأمَنوا مَنْ أتَى وهوَ مُسْتَن","فَرٌ في حِذَاءِ الذي قدْ غَزَاهَا",48,"ا",3,0],["ولا تأمَنوا مُبْرِقَاتِ الوُعُود،","وإنْ ضُخِّمَتْ، فَارِغٌ محْتَوَاهَا",48,"ا",3,0],["ولا تأمنن صروف الزمان","فشيمته الغدر فيمن أمن",49,"ن",1,0],["وَلا تَأتِيَنّي إِذا جِئتَني","فَإِنّي إِذا جِئتَني أَذهُبُ",50,"ب",1,0],["ولا تأمنن الثائرين ولا تنم","فإن أخا الهيجاء ليس بنائم",51,"م",1,0],["ولا تأنسا بالورد بعدي وأعربا","مقال ابن عبد الله يخدع ساجيا",52,"ي",2,0],["وَلا تَأْمَنَنْ فَوْتَ الوَفاةِ لِحَالَةٍ","فلا قَشْعَماً تُبقِي شعوبٌ ولا فَرْحا",53,"ح",2,0],["ولا تأمنا سَلْمَ الزّمانِ فإنّهُ","صديقٌ لما صافاه غيرُ صديقِ",54,"ق",1,0],["وَلا تَأتِيَنَّ الأُمورَ الَّتي","تَعيبُ عَلى الناسِ أَمثالَها",55,"ه",2,1],["ولا تَأثُرَنَّ حديثَ امرىءٍ","فشَرُّ الحديثِ على الآثرِ",56,"ر",1,0],["ولا تأفل بشمسك عن سمائى","فمهما غبت أحشائى تذوب",57,"ب",1,0],["ولا تأسف على بذل العطايا","فخير المال ما أخذ الملاح",58,"ح",1,0],["ولا تأكله بعد الذبح إما","تردى من قريبٍ أو بعيد",59,"د",1,0],["ولا تأكله إن واراه ليلٌ","وغيبه الظلامُ بظهرِ بيدِ",59,"د",1,0],["ولا تأكل قتيلة كلب قومٍ","ولم يك بالمكلب والصيود",59,"د",1,0],["ولا تأمنوا التغيير إن دام فِعلُه","ولم يَنْهَهُ عن ذاك شيخُ بني حرب",60,"ب",1,0],["ولا تأخذِ الأشياء من غير وجهها","فإنَّ وجودَ العدل في غيرِ خلقِهِ",61,"ق",2,0],["ولا تأخذ إلا لقاءً زوراً فإنه","حقيقتكم إن راح عنكم وإن غدا",62,"د",2,0],["ولا تأنفا أن تسألا وتسلّما","فما خشيَ الإنسان شراً من الكبَر",63,"ر",1,0],["ولا تأمريني بالسداد فإنني","رأيت الكثير المال غير مخلّدِ",64,"د",1,0],["ولا تالف سوى خلع العذار","فلازم باب حانات العقار",65,"ر",1,0],["ولا تأت أمراً لا ترجّى تمامه","ولا موردا ما لم تجد حسن مصدر",66,"ر",1,0],["وَلا تَأمَنُوا المَكرُوهَ فيهِ لأنَّهُ","يُوَاصِلُ مَكروهَاتِ كُلِّ المَصَايِبِ",67,"ب",1,0],["ولا تأخذ المعيوب والسخل واجتنب","كرائمها واطلب كطلبك للرفد",68,"د",1,0],["ولا تأس في الدنيا على فوت فائت","وإن عظمت بين الجوانح بلواه",69,"و",3,0],["وَلا تَأنَس بِعَهدٍ مِن أُناسٍ","عُهودُهُمُ اختِلاقٌ وَاِفتِراءُ",70,"ا",2,0],["ولا تأّوّه مشتاق به طرب","إلى الأحبّة إلّا زاد في حزني",71,"ن",2,0],["ولا تأكل السمن فيه ولا","سمينا وكن منهما ذا اهتياب",72,"ب",1,0],["وَلا تَأَمَنوا كَيدَ النِساءِ وَأَمسِكوا","عُرى المالِ عَن أَبنائِهِنَّ الأَصاغِرِ",73,"ر",1,0],["ولا تامه وجد ولا شفه جوى","ولا بات مسلوب الفؤاد من التبل",74,"ل",1,0],["ولا تأخذن بالعنف ذا نخوة وذا","إباء تهج ناراً مضرمة شرا",75,"ر",2,0],["ولا تأس فالتاريخ يا شيخ حافظ","لأعمالك الكبرى وآمالك الجلى",76,"ل",2,0],["وَلا تَأخُذوا مِنهم إِفالاً وأبكراً","وَأُترك في بيتٍ بصعدة مظلمِ",77,"م",1,0],["ولا تأبه لداعٍ أو لناعٍ","أبيتَ اللوم خطباً أو خطابا",78,"ب",2,0],["ولا تأسى على محن الليالي","فما في ذا عليها من جناح",79,"ح",1,0],["ولا تأمنا لُبسَ السَّقامِ أَمنتما","جريرتَه فالسقم للموتِ رَائِدُ",80,"د",1,0],["ولا تأمَنوا ثَغرَ الهُمامِ فإنّهُ","يُقَهقِهُ في أبصارِكُم وهو يَزأَرُ",81,"ر",1,0],["ولا تأمَنا ذِكرَ الحِمى إنْ طَربْتُما","علي زَفرتي أنْ يستطيرَ وقودُها",82,"د",3,0],["ولا تأمَنَنَّ حليماً رمتَ هَضْمَتَه","أنْ يركبَ الجهلَ عُرياناً بلا قَتَبِ",83,"ب",1,0],["ولا تأمن الإظلام فالنجر طالع","ولا تلتبس بالضوء فالشمس تغرب",84,"ب",1,0],["وَلا تَأمنوا حُبّاً عَلى طَيّ لَوعةٍ","وَلَكن إِذا شئتم صِلوه بشرحه",85,"ح",2,0],["وَلا تَأسفوا لَيث الشَرى قاد قَلبَه","كَريمٌ جَليلُ الوالدين كَريم",86,"م",1,0],["ولا تألفت الأضدادُ في شجني","الماءُ في أَعيني والنارُ في كبدي",87,"د",2,0],["ولا تأكلوا من طيرها ودبيبها","فما هن إلا من لحوم الخلائقِ",88,"ق",1,0],["ولا تألوا جهدا عن النوح والطما","صدوراً بها الايمان أثرى وأثمرا",89,"ر",2,0],["ولا تأله مشتاق ولا عمرت","طريق حق ولا رويت مرائيه",90,"ي",2,0],["وَلاَ تَأسَّفْ عَلَى مَيْلِ الزَّمَانِ إِلَى","وَغْدٍ فَمِنْ طَبْعِهِ مَيْلٌ لِذِي مَيَلِ",91,"ل",1,0],["وَلا تَأتي عَلى مِقدار مَهدٍ","وَلا المهدى لَهُ أَبداً بِحال",92,"ل",1,0],["ولا تأتي إلى غاب","ولا تقرُبُ من غار",93,"ر",1,0],["ولا تارك رأيا رآه تلونا","ولا قارع عند الندى سن نادم",94,"م",1,0],["ولا تاج الا ما توليت عقده","على جبهة الملك المكنى بقاسم",94,"م",1,0],["ولا تأسف على ما فات منها","وبادر في حياتك أن تطيعا",95,"ع",2,0],["ولا تأوَّهَ لما حُزَّ مَنحرُهُ","إلا وللرُّوح بالتهليل إعلان",96,"ن",1,0],["ولا تَأْسَوْا عَلى الماضي فَفِيهِ","لَنا عِبَرٌ اذا اعْتَبَرَ اللَّبِيبُ",97,"ب",1,0],["وَلا تَأيَسا أَن يَشعَبَ الصَدعَ بَعدَهُ","أَريبٌ كَفَرعِ النَبعَةِ المُتَزَعزِعِ",98,"ع",1,0],["ولا تأخذ من المعلوم إلا","حلالا طيبا عطرا ثراه",99,"ر",3,0],["ولا تأمن عدوّاً واطَّرحه","فإن الضدّ غدّار حقود",100,"د",1,0],["ولا تأمن لسمى ترى الطبع غلاب","يا ما عزيزٍ بين ديره وديره",101,"ر",2,0],["ولاتأنفْ من الأخوانِ نُصحاً","فمن آفاتِ عقلِ المرءِ كِبْرُهْ",102,"ر",2,0],["ولآتآخذك حولهآ حميّه","بيفوتك الليل والسآري",103,"ر",2,0],["وَلا تَأْسَفْ عَلى مَجْدٍ تَوَلّى","فَلَيسَ يَعودُ لَو شابَ الصَّباءُ",104,"ا",2,0],["ولا تأمنوا غدر الزمان فإنه","وإن لان لم يبرح لنا مترصدا",105,"د",2,0],["ولاَ تأسا أنْ يشعبَ الصدعَ بعدهُ","أريبٌ كفرع النبعة ِ المتزعزعِ",106,"ع",1,0],["ولا تأسفن على فائت","لو العمر من بعض ركابه",107,"ب",2,0],["ولا تأمنن من خون الله إنهم","ذوو المكر فاحذرهم وكن غير خامل",108,"ل",1,0],["ولا تأسف فما حي بباقٍ","وهل تنجو الزروع من الحصاد",109,"د",1,0],["ولا تأسَي، بَشيرُ الكلِّ بعضٌ","يجيءُ البدرُ في إثرِ الأهِلّة",110,"ل",2,0],["ولا تأسَفَنَّ على هَجْر مَنْ","متى جئتَهُ هَبَّ كي يمنعَك",111,"ك",1,0],["وَلا تُأوِّلْ لِمِصرٍ أيَّ مُعْجِزَة ٍ","إنَّ الحَقائِقَ لا يَقْبَلْنَ تأويلا",112,"ل",2,0],["وَلا تأْمَنَنْ قَوْماً تَراهُمْ أَصادِقاً","وَإِنْ نابَتْ الأَحْداثُ كانُوا حَوادِثَا",113,"ث",2,0],["[ وَلا تأَلَّيْتُ فِي أَسْرِ الصَّبابَةِ مِنْ","سَلاسِلٍ مِنْ هَوَى سُعْدَى وَأَغْلالِ ]",114,"ل",1,0],["ولا تألم حين البرد رجّ دمي","وقد رآني ضحىً والعظم قد وهنا",115,"ن",2,0],["ولا تأملي أن يعودَ الفؤادُ","الى المستحيل الذي ودّعه ْ",116,"ع",2,0],["ولا تأل للأخلاق في السعي باذرا","فأزكى ثمارا ما يمد بذورها",117,"ر",3,0],["ولا تأسوا فإنَّ المرء يبلى","ويبْلى منذ أنْ ينسى فطامهْ",118,"م",2,0],["ولا تأْملنَّ الخير من حسن منطقٍ","ومن خلفِهِ لَدْغٌٌ يجيئ مغمْغَمَا",119,"م",2,0],["ولا تأجج في هذا الفؤادِ هوىً","ولا بكت ب اِشتياقٍ أعينٌ ذُرُفُ",120,"ف",1,0],["ولا تأخذنْ في محملِ الجدِّ مِقْوَلي","فلستُ فطيناً لو تظاهرتُ واعيا",121,"ي",2,0],["ولاتآمن الدنيا على كل منهاج","لو هي صفت لك يوم باكر تشيني",122,"ن",2,0],["ولا تأمن النقّال ما بين ذاك وذاك","مثل ماعطاء هذاك ينقل عنه زيّه",123,"ي",2,0],["ولا تأمن الحية ولا تأمن الداب","أذهن لخطو الرجل فوق الرمالي",124,"ل",2,0],["وَلا تَأمَنُوا المَكرُوهَ فيهِ لأنَّهُ","يُوَاصِلُ مَكروهَ",125,"ه",1,0],["ولا تأبه لقولٍ من حزينٍ","عصاهُ الشعر في يومٍ حزينِ",126,"ن",1,0]]}