لكامل"],[360,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[370,"يا ذاكرا أهل الندى من قبله","https://www.aldiwan.net/poem17299.html","الكامل"],[381,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[381,"أنحلت يا دمع جسمي فارفقن به","https://www.aldiwan.net/poem59216.html","البسيط"],[381,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[397,"شتمت من تيمني مغالطا","https://www.aldiwan.net/poem53602.html","الرجز"],[404,"أغلى الهدايا","https://www.aldiwan.net/poem6722.html","عموديه"],[404,"بسلامة الصدر الحياة تطيب","https://www.aldiwan.net/poem6747.html","عموديه"],[405,"لا تغدروا إن هذا الغدر منقصة","https://www.aldiwan.net/poem490.html",""],[406,"فيم الجفا وعلام الصد والملل","https://www.aldiwan.net/poem46541.html","البسيط"],[413,"أحبابنا من لي لو","https://www.aldiwan.net/poem32430.html","مجزوء الهزج"],[436,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[456,"يا حامل الثمر الرفاف من جذل","https://www.aldiwan.net/poem61313.html","البسيط"],[456,"هذي وصيتك النفيسة لم تزل","https://www.aldiwan.net/poem61640.html","الكامل"],[456,"مهلا وريقات الخريف تمتعى","https://www.aldiwan.net/poem61662.html","الكامل"],[461,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[461,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[461,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[467,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[473,"شتان حين ينث الناس فعلهما","https://www.aldiwan.net/poem4665.html","البسيط"],[482,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[498,"عشرون من عمري تنفيتها","https://www.aldiwan.net/poem10242.html","السريع"],[508,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[518,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[518,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[532,"لو تصلح النيات لم يفسد","https://www.aldiwan.net/poem37217.html","السريع"],[554,"قل للذين تناكصت ثقتي","https://www.aldiwan.net/poem47331.html","أحذ الكامل"],[578,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[578,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/124796","الرجز"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"],[1124,"","https://poetry.dctabudhabi.ae/diwan/poem/53","الخفيف"]],"verses":[["شَتّانَ ما وَجْدي ووَجْدُ حَمامَةٍ","تُبْدي الصَّبابَةَ في الحَنينِ وأكْتُمُ",0,"م",1,0],["شَتّانَ يا سَيِّدَتي بَينَنا","شَتّانَ مِن وُدِّكُمُ وُدّي",1,"د",2,0],["شَتّانَ ما يَومي عَلى كورِها","وَيَومُ حَيّانَ أَخي جابِرِ",2,"ر",1,0],["شَتانَ فِيمَنْ تَوَلَّى أَمْرَ أُمَّتِهِ","مَا بَيْنَ مُعْتَقِبٍ أَوْ غَيْرِ مُعْتَقِبِ",3,"ب",1,0],["شَتَّانَ بَيْنَ طَلِيقِ قَوْمٍ يَبْتَنِي","مُلْكاً وَبَيْنَ مُغَلَّلٍ مِسْكِينِ",4,"ن",1,0],["شَتَّى مَزَايَاكَ الَّتِي أَبْرزْنَهَا","بِرِعَايَةِ المُتَعَهِّدِ اليَقْظَانِ",5,"ن",1,0],["شَتَّانَ بَيْنَ الشَّاعِرِ المَطْبُوعِ فِي","إِبْدَاعِهِ وَاللاَّقِطِ النُّظَّامِ",6,"م",1,0],["شَتَّانَ مَا بَيْنَ الَّذِي يُدْنِينَهُ","وَمَكَانَهُ العَالِي مِنَ الإِلْهَامِ",7,"م",1,0],["شَتَّانَ مَا بَيْنَ بَيْتٍ تُسْتَجَدُّ بِهِ","قُوَى الشُّعُوبِ وَبَيْتٍ صَائِنِ الرِّمَمِ",8,"م",1,0],["شَتَّانَ بَيْنَ نُضَارَةٍ مَوْقُوتَةٍ","فَارَقْتَهَا وَنُضَارَةٍ لِدَوامِ",9,"م",1,0],["شَتَّى فَضَائِلُهُ فَإنْ وُصِفَتْ فَهَلْ","يَقْضِي نَثِيرٌ حَقَّهَا وَنَظِيمُ",10,"م",1,0],["شت أن معين مبارك","بعد وقفة ان كبيرا",11,"ر",2,1],["شَتَمتُ مُجاشِعاً بِبَني كُلَيبٍ","فَمَن يوفي بِشَتمِ بَني رِياحِ",12,"ح",1,1],["شَتَمتُما قائِلاً بِالحَقِّ مُهتَدِياً","عِندَ الخَليفَةِ وَالأَقوالُ تَنتَضِلُ",13,"ل",1,1],["شتان ما حالي وحالك أنت في","غرفِ الجنان ومهجتي في النار",14,"ر",1,0],["شتَّان ما بيني وبين حمامةٍ","صدحت فمن مسترجعٍ ومرَجَّع",15,"ع",1,0],["شتَّان ما بيني وبين صفاتكم","يعقوب عندكم وعندي حزنه",16,"ه",1,0],["شتّى عيوبٍ لم يُعَبْ غيرُهُ","بها من الناس ولم يُثلبِ",17,"ب",1,0],["شتَّان بين اثنين هذا مُوعدٌ","بتسلب الدنيا وهذا واعدُ",18,"د",1,0],["شتان ما بين عباسٍ وصاحبه","في الفضل والخير عند اللَّه والناس",19,"س",1,0],["شتّانَ بينَ الحالتَيْ","نِ من المُواصل الصَّرومِ",20,"م",1,0],["شَتيتاً يَرتَوي الظَمآنُ مِنهُ","إِذا الجَوزاءُ أَجحَرَتِ الضِبابا",21,"ب",2,0],["شتت الدهر شملنا لشقائي","بعد جمع له ودهري قلب",22,"ب",1,0],["شتان بين الشعب وهو منقيد","يشكو الاذى والشعب وهو طليق",23,"ق",1,0],["شَتّى فَضائِلَ في الرِجالِ كَأَنَّها","شَتّى سِلاحٍ مِن قَنا وَصِفاحِ",24,"ح",1,0],["شَتّانَ جَفلُ الدُموعِ بَينَهُما","شَوقُ مُحِبٍّ وَنَأيُ مَحبوبِ",25,"ب",1,0],["شَتيمُ المُحَيّا لا يُخاتِلُ قِرنَهُ","وَلَكِنَّهُ بِالصَحصَحانِ يُنازِلُه",26,"ل",2,0],["شَتَّى الخِلالِ يروحُ إما سالباً","نِعَمَ العِدا قَسراً وإما مُنعِما",27,"م",2,0],["شتَّتتْ شملَها الشَّمالُ وأمسَت","كالغرابيبِ عُذِّبَتْ باغترابِ",28,"ب",1,0],["شَتَّتَ حُبُّ الدُنيا جَماعَتَهُم","فيها فَقَد أَصبَحوا وَهُم شِيَعُ",29,"ع",1,0],["شُتِّتَ بَعدَ التَجميعِ شَملُهُمُ","فَأَصبَحوا في البِلادِ قَد تاهوا",30,"ا",1,0],["شَتَّتَّ شَملَ المالِ بَعدَ وُفورِهِ","وَجَمَعتَ شَملَ الناسِ بَعدَ شَتاتِها",31,"ت",3,0],["شتى غرائبها وأعجبها فتى","يغدو لمهجته عليك حسودا",32,"د",2,0],["شَتّانَ بَينَهُما في كُلِّ نازِلَةٍ","نَهجُ القَضاءِ مُبينٌ فيهِما جَدَدُ",33,"د",1,0],["شتانَ يابنَ فلانٍ","تعاستي وسُعودُكْ",34,"ك",1,1],["شّتى حقوقٍ لها ضاقَ الوفاءُ بها","فهلْ يكونُ وَفاءً أنني كمِد",35,"د",1,0],["شَتّى المَحاسِنِ لِلوَضاءَةِ رَيطَةٌ","أَبَداً عَلَيهِ وَلِلحَياءِ نِقابُ",36,"ب",1,0],["شَتَّى مَناقِبُها تَوارَثَ قومُها","أحسابَ يَعْرُبَ في الزّمانِ الخالي",37,"ل",2,0],["شتيمٌ تَحامى الضارِياتُ عَرينَهُ","يُكشِّرُ عَن أَنيابِهِ وَيُصلقِمُ",38,"م",1,0],["شَتَمَ الأُلَى صدقوه ألا يَدَّعوا","ما لم يَرَوْا شَطَطاً وألا يَكذبوا",39,"ب",3,0],["شَتّانَ ما بين صَرْحٍ ثابتٍ رُفِعَتْ","منه القِبابُ وصَرْحٍ واهنٍ خُسِفا",40,"ف",2,0],["شَتّى يُحَسِّنُها التَشابُهُ مِثلَما","تُستَحسَنُ الأَلفاظُ لِلتَجنيسِ",41,"س",1,0],["شَتّى فَكُلٌّ يُشتَكي ما بِهِ","لا يُذهِبُ الرَحمَنُ شَكوانا",42,"ن",2,0],["شَتَّتَهُم حادِثٌ فَأَفرَدَني","مِنهُم وَكانَ مُشتاقَ لَحَظاتي",43,"ت",2,0],["شَتَونَ حَتّى إِذا ما صِفنَ ذَكَّرَها","مِن مَنهَلٍ مَورِداً فَاِشتَقنَ وَاِختاقا",44,"ق",2,0],["شَتّانَ ما بَيني وَبَينَ صَحابَتي","وَالعيسُ بي وَبِهِم تَمُدُّ بُراها",45,"ه",2,1],["شَتّانَ بَينَكَ يا قَبيصُ وَبَينَهُ","أَنتَ الذَميمُ وَلَستَ كَالمَحمودِ",46,"د",1,0],["شَتّانَ ذا مِنها وَإِرسالَها","أَدالِجٌ أَنتَ وَلَم تَعهَدِ",47,"د",1,0],["شَتَمتُ فُرَيخَ الزِنجِ عِرضي خَسارَةً","فَإِن كُنتَ كَعبِيّاً وَكُنتَ حَبيبي",48,"ب",2,0],["شَتّانَ مَجدودٌ وَمَن جَدُّهُ","كَالكَعبِ إِن تَرحَل بِهِ يَرتُبِ",49,"ب",1,0],["شَتَونا وَصِفنا وَاِرتَبَعنا فَلَم يَدُم","شِتاءٌ وَزالَ القَيظُ عَنّا وَناجِرُ",50,"ر",1,0],["شَتّانَ مَأمونٌ وَذو خُلسَةٍ","كَأَنَّهُ مِن عَجَلٍ بّارِقُ",51,"ق",1,0],["شتاءٌ وَريحٌ في دجى اللَيل زعزعُ","يَكاد بها سقفُ المنازل يقلعُ",52,"ع",1,1],["شتان بين الدار تبسط ظلمة","وَالدار فيها تسطع الأنوار",53,"ر",1,0],["شتَّى مواكبَ من حورٍ وآلهةٍ","لها التفاتٌ إلى الماضي وإصغاءُ",54,"ا",2,0],["شَتَّانَ فِي كَشْفِ السَّرَائِرِ بَيْنَها","طَرَباً وَبَيْنَ مَقَاطِرِ الأقْلاَمِ",55,"م",1,0],["شَتَّى الفِئَاتِ بِكَ اعْتَزْتْ وَأَسْعَدَهَا","مَا خَصَّهَا بِحَنَانِ رَأْيكِ العَالي",56,"ل",2,0],["شَتَّانَ بَيْنَ صَحِيفةٍ بِمُتُونِهَا","وَشُرُوحِهَا فَيَّاضةِ الأَنْهَارِ",57,"ر",1,0],["شَتَّى مُبرَّاتُكِ تُقْضَى بِهَا","حَوَائِجُ الحَالِ وَيُرْعَى المَالْ",58,"ل",1,0],["شتَّانَ مَنْ هُوَ في جَهَنَّمَ ثاوياً","أبداً وَمَنْ هُوَ في الجِنانِ مخلَّدُ",59,"د",1,0],["شتيتٌ مِنَ الحُسْنِ في مفردٍ","فمنها المراضُ ومنها الصِّحاح",60,"ح",1,0],["شَتّانَ نَحنُ سَكَنتَ طوبى آمِناً","وَسَكَنت حَيثُ يَروعَني الناقوسُ",61,"س",1,0],["شَتيتِ المَراكِزِ أَحوى اللِثاتِ","كَدُرٍّ تَنَضَّدَ فيهِ أُشُر",62,"ر",1,0],["شَتّانَ بَيْن النيِّراتِ ومَنْ بِهِ","سُبُلُ البُطُولَةِ والْحَياةِ تُنَار",63,"ر",1,0],["شتانَ بين فتىً يموتُ مجالِداً","وفتىً يموتُ بجُرْعةِ الفينيك",64,"ك",1,0],["شتّى أساليبُ الحياةِ ولا أرَى","للمجدِ غيرَ طريقهِ المسلوك",64,"ك",1,0],["شتان بينك -إذ حَجَجْتَ- وبين مَن","زاروا -كما زرتَ- الحطيم زمزما",65,"م",2,0],["شتَّى فئاتٍ يهدفُون لغايةٍ","فكأنهم سِفْرٌ بألفِ غِلاف",66,"ف",1,0],["شتان بين مواقعٍ ومواقعِ","كلتاهما تشكو الضلوعُ أوارها",67,"ر",3,0],["شتم الأعرجُ طوْدًا شامخًا","حينما أعجزه أن يطلعه",68,"ع",2,0],["شتَّان بينهما: هذا يَفُوح به","زهْرٌ، وذاك ليوم النصر إبَّان",69,"ن",1,0],["شتان بيني وبينَ لاقطها:","بات قريرًا، وبتُّ في كمد",70,"د",1,0],["شتان بين الداعيي","ن وحبذا أمر الصلاح",71,"ح",1,0],["شتّى مواكب من روح وآلهة","لها التّفات إلى الماضي وإصغاء",72,"ا",2,0],["شتانَ بينَ الحالَتَيْ","نِ من المُواصل والصَّرومِ",73,"م",1,0],["شتَّ شعبُ الحيِّ بعدَ التئامْ","وشجاكَ الرَّبعُ ربعُ المقامْ",74,"م",1,1],["شَتِيتِ المَرَاكِزِ أَحْوَى اللِّثات","ثاتِ، كدرٍّ تنضدَ، فيه أشر",75,"ر",1,0],["شتان ما بين العلي بماله","والسيد الصدر العلي بحاله",76,"ل",2,0],["شتان بين شعوري في حقيقته","وبين رجعك يا أصداء أفكاري",77,"ر",2,0],["شتَّان من جَفنُهُ بالنوم مغترقٌ","ومن خواطره باللَّيل تَعتَبِرُ",78,"ر",1,0],["شتَّان بين لاقائمين بليله","للخوف أو للشوق والنّوام",79,"م",1,0],["شتّى اللغاتِ فقُلْ في هاتف غردٍ","أو صاهلٍ جَرِسٍ أو باغمٍ غزِلِ",80,"ل",1,0],["شِتَاؤُهَا حَتْفُ مَنْ يَقَرُّ بِهَا","بِثَلْجِهَا الْمُسْتَدَرِّ وَالْقَرِّ",81,"ر",1,0],["شَتيمٌ أَبو شِبلَينِ أَخضَلَ مِتنَهُ","مِنَ الدَجنِ يَومٌ ذو أَهاضيبَ ماطِرُ",82,"ر",1,0],["شَتَّتُّ شملُ الدمعِ لما شَتَّتوا","شَمْلي وصِحْتُ به بَدادِ بَدادِ",83,"د",1,0],["شتاء وصيف دائبان كلاهما","وبينهما للحادثات مجال",84,"ل",1,0],["شتّان ما بين محصور ومصطبح","على النعيم وضرب الطبل والزير",85,"ر",1,0],["شتَّت اللَّه شَملهم فتولّوا","مِثلَما سارَ في السيوف الغُثاءُ",86,"ا",2,0],["شَتَّتَّ صَبْرِي وظاهرت الشجونَ على","قلبِي وَسُقْتَ إلى أَجْفانِي الأَرَقا",87,"ق",2,0],["شَتَّتَ شَملَ سُلُوِّهِ","وَجَمَعتَ بِالأَشجانِ شَملَه",88,"ل",2,0],["شتى الطرائق والعقائد والهوى","غُلْفُ القلوب وراءَ كل ظنون",89,"ن",1,0],["شَتيمٌ تَرَبَّعَ في عانَةٍ","حِيالٍ يُكادِمُ فيها كِداما",90,"م",2,0],["شَتَّتَنَ ما بيني وبي","نك في الهوى لو كنت عاذر",91,"ر",1,0],["شَتِيمِ الوَجهِ هِلبَاجٍ هِدانٍ","