{"poems":[[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[55,"أخلفت يا سيدتي وعدي","https://www.aldiwan.net/poem26403.html","السريع"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[93,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[93,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[93,"حييت يا ذات المقام السامي","https://www.aldiwan.net/poem11379.html","الكامل"],[93,"بالعلم يدرك أقصى المجد من أمم","https://www.aldiwan.net/poem11392.html","البسيط"],[93,"إنا نحيي حفلكم ويسرنا","https://www.aldiwan.net/poem11405.html","الكامل"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[27,"شتمت مجاشعا ببني كليب","https://www.aldiwan.net/poem5702.html","الوافر"],[27,"شتمتما قائلا بالحق مهتديا","https://www.aldiwan.net/poem5979.html","البسيط"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"قل للرفيقين اللذين كلاهما","https://www.aldiwan.net/poem20213.html","الكامل"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"خجلت خدود الورد من تفضيله","https://www.aldiwan.net/poem10876.html","الكامل"],[51,"ما في حياة عبيد الله منفعة","https://www.aldiwan.net/poem64621.html","البسيط"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[29,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[89,"الشمس قد غربت فلاح وراءها","https://www.aldiwan.net/poem44892.html","الكامل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[45,"كم من حنين إليك مجلوب","https://www.aldiwan.net/poem11046.html","المنسرح"],[28,"فإن تهدموا داري فإن أرومتي","https://www.aldiwan.net/poem5488.html","الطويل"],[61,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[49,"حتى متى يستفزني الطمع","https://www.aldiwan.net/poem62168.html","المنسرح"],[49,"قولا لمن يرتجي الحياة أما","https://www.aldiwan.net/poem65356.html","المنسرح"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[97,"أدركت عندك يوميَ الموعودا","https://www.aldiwan.net/poem24761.html","الكامل"],[44,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[69,"شتان يابن فلان","https://www.aldiwan.net/poem28899.html","المجتث"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[74,"وصقيل إفرند الشباب بطرفه","https://www.aldiwan.net/poem12854.html","الكامل"],[105,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[105,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[81,"هذا أوان فضيحتي لبيك يا","https://www.aldiwan.net/poem61444.html","البسيط"],[40,"هاج محل الحي أحزانا","https://www.aldiwan.net/poem42277.html","السريع"],[52,"يا دهر يا صاحب الفجيعات","https://www.aldiwan.net/poem27201.html","المنسرح"],[48,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[48,"شتان ما بيني وبين صحابتي","https://www.aldiwan.net/poem66177.html","الكامل"],[50,"أقبيص لست وإن جهلت ببالغ","https://www.aldiwan.net/poem63891.html","الكامل"],[50,"يا طول هذا الليل لم أرقد","https://www.aldiwan.net/poem63954.html","السريع"],[50,"لقد ودعت حبي وهام رقيبي","https://www.aldiwan.net/poem64804.html","الطويل"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"دع القوم سلوا بالضغائن بينهم","https://www.aldiwan.net/poem22527.html","الطويل"],[46,"ما ركب الخائن في فعله","https://www.aldiwan.net/poem23026.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85495","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55185","السريع"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67300","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142068","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6126","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[51,"شغَلَ المُحبَّ عن الرسو","https://www.poetsgate.com/ViewPoem.aspx?id=30515",""],[39,"شتَّ شعبُ الحيِّ بعدَ التئامْ","https://www.poetsgate.com/ViewPoem.aspx?id=4269",""],[31,"صَحَا القَلْبُ عَنْ ذِكْرِ أُمِّ البَنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18902&r=&rc=165",""]],"verses":[["شَتّانَ ما وَجْدي ووَجْدُ حَمامَةٍ","تُبْدي الصَّبابَةَ في الحَنينِ وأكْتُمُ",0,"م",1,0],["شَتّانَ يا سَيِّدَتي بَينَنا","شَتّانَ مِن وُدِّكُمُ وُدّي",1,"د",2,0],["شَتّانَ ما يَومي عَلى كورِها","وَيَومُ حَيّانَ أَخي جابِرِ",2,"ر",1,0],["شَتانَ فِيمَنْ تَوَلَّى أَمْرَ أُمَّتِهِ","مَا بَيْنَ مُعْتَقِبٍ أَوْ غَيْرِ مُعْتَقِبِ",3,"ب",1,0],["شَتَّانَ بَيْنَ طَلِيقِ قَوْمٍ يَبْتَنِي","مُلْكاً وَبَيْنَ مُغَلَّلٍ مِسْكِينِ",4,"ن",1,0],["شَتَّى مَزَايَاكَ الَّتِي أَبْرزْنَهَا","بِرِعَايَةِ المُتَعَهِّدِ اليَقْظَانِ",5,"ن",1,0],["شَتَّانَ بَيْنَ الشَّاعِرِ المَطْبُوعِ فِي","إِبْدَاعِهِ وَاللاَّقِطِ النُّظَّامِ",6,"م",1,0],["شَتَّانَ مَا بَيْنَ الَّذِي يُدْنِينَهُ","وَمَكَانَهُ العَالِي مِنَ الإِلْهَامِ",7,"م",1,0],["شَتَّانَ مَا بَيْنَ بَيْتٍ تُسْتَجَدُّ بِهِ","قُوَى الشُّعُوبِ وَبَيْتٍ صَائِنِ الرِّمَمِ",8,"م",1,0],["شَتَّانَ بَيْنَ نُضَارَةٍ مَوْقُوتَةٍ","فَارَقْتَهَا وَنُضَارَةٍ لِدَوامِ",9,"م",1,0],["شَتَّى فَضَائِلُهُ فَإنْ وُصِفَتْ فَهَلْ","يَقْضِي نَثِيرٌ حَقَّهَا وَنَظِيمُ",10,"م",1,0],["شت أن معين مبارك","بعد وقفة ان كبيرا",11,"ر",2,1],["شَتَمتُ مُجاشِعاً بِبَني كُلَيبٍ","فَمَن يوفي بِشَتمِ بَني رِياحِ",12,"ح",1,1],["شَتَمتُما قائِلاً بِالحَقِّ مُهتَدِياً","عِندَ الخَليفَةِ وَالأَقوالُ تَنتَضِلُ",13,"ل",1,1],["شتان ما حالي وحالك أنت في","غرفِ الجنان ومهجتي في النار",14,"ر",1,0],["شتَّان ما بيني وبين حمامةٍ","صدحت فمن مسترجعٍ ومرَجَّع",15,"ع",1,0],["شتَّان ما بيني وبين صفاتكم","يعقوب عندكم وعندي حزنه",16,"ه",1,0],["شتّى عيوبٍ لم يُعَبْ غيرُهُ","بها من الناس ولم يُثلبِ",17,"ب",1,0],["شتَّان بين اثنين هذا مُوعدٌ","بتسلب الدنيا وهذا واعدُ",18,"د",1,0],["شتان ما بين عباسٍ وصاحبه","في الفضل والخير عند اللَّه والناس",19,"س",1,0],["شتّانَ بينَ الحالتَيْ","نِ من المُواصل الصَّرومِ",20,"م",1,0],["شَتيتاً يَرتَوي الظَمآنُ مِنهُ","إِذا الجَوزاءُ أَجحَرَتِ الضِبابا",21,"ب",2,0],["شتت الدهر شملنا لشقائي","بعد جمع له ودهري قلب",22,"ب",1,0],["شتان بين الشعب وهو منقيد","يشكو الاذى والشعب وهو طليق",23,"ق",1,0],["شَتّى فَضائِلَ في الرِجالِ كَأَنَّها","شَتّى سِلاحٍ مِن قَنا وَصِفاحِ",24,"ح",1,0],["شَتّانَ جَفلُ الدُموعِ بَينَهُما","شَوقُ مُحِبٍّ وَنَأيُ مَحبوبِ",25,"ب",1,0],["شَتيمُ المُحَيّا لا يُخاتِلُ قِرنَهُ","وَلَكِنَّهُ بِالصَحصَحانِ يُنازِلُه",26,"ل",2,0],["شَتَّى الخِلالِ يروحُ إما سالباً","نِعَمَ العِدا قَسراً وإما مُنعِما",27,"م",2,0],["شتَّتتْ شملَها الشَّمالُ وأمسَت","كالغرابيبِ عُذِّبَتْ باغترابِ",28,"ب",1,0],["شَتَّتَ حُبُّ الدُنيا جَماعَتَهُم","فيها فَقَد أَصبَحوا وَهُم شِيَعُ",29,"ع",1,0],["شُتِّتَ بَعدَ التَجميعِ شَملُهُمُ","فَأَصبَحوا في البِلادِ قَد تاهوا",30,"ا",1,0],["شَتَّتَّ شَملَ المالِ بَعدَ وُفورِهِ","وَجَمَعتَ شَملَ الناسِ بَعدَ شَتاتِها",31,"ت",3,0],["شتى غرائبها وأعجبها فتى","يغدو لمهجته عليك حسودا",32,"د",2,0],["شَتّانَ بَينَهُما في كُلِّ نازِلَةٍ","نَهجُ القَضاءِ مُبينٌ فيهِما جَدَدُ",33,"د",1,0],["شتانَ يابنَ فلانٍ","تعاستي وسُعودُكْ",34,"ك",1,1],["شّتى حقوقٍ لها ضاقَ الوفاءُ بها","فهلْ يكونُ وَفاءً أنني كمِد",35,"د",1,0],["شَتّى المَحاسِنِ لِلوَضاءَةِ رَيطَةٌ","أَبَداً عَلَيهِ وَلِلحَياءِ نِقابُ",36,"ب",1,0],["شَتَّى مَناقِبُها تَوارَثَ قومُها","أحسابَ يَعْرُبَ في الزّمانِ الخالي",37,"ل",2,0],["شتيمٌ تَحامى الضارِياتُ عَرينَهُ","يُكشِّرُ عَن أَنيابِهِ وَيُصلقِمُ",38,"م",1,0],["شَتَمَ الأُلَى صدقوه ألا يَدَّعوا","ما لم يَرَوْا شَطَطاً وألا يَكذبوا",39,"ب",3,0],["شَتّانَ ما بين صَرْحٍ ثابتٍ رُفِعَتْ","منه القِبابُ وصَرْحٍ واهنٍ خُسِفا",40,"ف",2,0],["شَتّى يُحَسِّنُها التَشابُهُ مِثلَما","تُستَحسَنُ الأَلفاظُ لِلتَجنيسِ",41,"س",1,0],["شَتّى فَكُلٌّ يُشتَكي ما بِهِ","لا يُذهِبُ الرَحمَنُ شَكوانا",42,"ن",2,0],["شَتَّتَهُم حادِثٌ فَأَفرَدَني","مِنهُم وَكانَ مُشتاقَ لَحَظاتي",43,"ت",2,0],["شَتَونَ حَتّى إِذا ما صِفنَ ذَكَّرَها","مِن مَنهَلٍ مَورِداً فَاِشتَقنَ وَاِختاقا",44,"ق",2,0],["شَتّانَ ما بَيني وَبَينَ صَحابَتي","وَالعيسُ بي وَبِهِم تَمُدُّ بُراها",45,"ه",2,1],["شَتّانَ بَينَكَ يا قَبيصُ وَبَينَهُ","أَنتَ الذَميمُ وَلَستَ كَالمَحمودِ",46,"د",1,0],["شَتّانَ ذا مِنها وَإِرسالَها","أَدالِجٌ أَنتَ وَلَم تَعهَدِ",47,"د",1,0],["شَتَمتُ فُرَيخَ الزِنجِ عِرضي خَسارَةً","فَإِن كُنتَ كَعبِيّاً وَكُنتَ حَبيبي",48,"ب",2,0],["شَتّانَ مَجدودٌ وَمَن جَدُّهُ","كَالكَعبِ إِن تَرحَل بِهِ يَرتُبِ",49,"ب",1,0],["شَتَونا وَصِفنا وَاِرتَبَعنا فَلَم يَدُم","شِتا