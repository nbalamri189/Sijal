064.html","البسيط"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[48,"يا دار ما فعلت بك الأيام","https://www.aldiwan.net/poem65255.html","الكامل"],[46,"لا تطيعي هواك أيتها النف","https://www.aldiwan.net/poem22141.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[8,"أيا دار سلمى بالحرورية اسلمي","https://www.aldiwan.net/poem21840.html","الطويل"],[76,"وحومة غادرت فرسانها","https://www.aldiwan.net/poem39265.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/204571","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16633","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30462","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9897","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43884","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[106,"ذكرى شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179690",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"يا نجوم","https://www.poetsgate.com/ViewPoem.aspx?id=50456",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"بين النجف وأمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=178944",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[44,"أَقَشيبَ رَبعِهِم أَراكَ دَريسا","https://www.poetsgate.com/ViewPoem.aspx?id=64051",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[94,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""],[72,"سهرت عليكِ لواحظُ الرقباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57649&r=&rc=7",""]],"verses":[["وَبَلَوتُ مِن سُكرِ الشَبا","بِ أَجَنُّ مِن سُكرِ المُدامِ",0,"م",1,0],["وبلَّ دِرعِي ومهري صوبُ غاديَةٍ","فالبرقُ يضحكُها والرَّعدُ يُبكيها",1,"ي",3,0],["وَبلائِي ثَلاثَةٌ طَرَقَتْنِي","بِسُهادٍ وَلَوْعَةٍ وَانْتحابِ",2,"ب",1,0],["وبلَغْتَ غايَةَ سُؤدَدٍ لمْ يُلْفِهِ","كِسْرى ولا عَلِقَتْهُ هِمّةُ قَيصَرِ",3,"ر",1,0],["وبَلَّتْ نِجادَ السّيْفِ منّيَ أدْمُعٌ","تُصانُ على الجُلَّى ويَبْذُلُها الحُبُّ",4,"ب",1,0],["وبَلَغْتَ في السِّنّ القَريبَةِ رُتْبَةً","نهَضَ الحَسودُ لَها فعَزَّ لُحوقُ",5,"ق",1,0],["وَبَلايا ما تَنقَضي وَرَزاي","ما لَها مِن نِهايَةٍ وَخُطوبُ",6,"ب",1,0],["وبلِّغْ أماناتِ المَشوقِ ولا تقُلْ","ترحّلَ مُخْتاراً لعلّ لهُ عُذْرا",7,"ر",2,0],["وبَلَعْتَ كالكَبّونِ فَضْلَ عَصيدَةٍ","وشرِبْتَ منْ ماءِ العَصيرِ مجاجا",8,"ج",2,0],["وبلِّغْ عُلىً للبُعْدِ منّي ألوكَةً","بأعْطَرِ منْ عرْفِ الصِّبا المُتَنَفَّسِ",9,"س",1,0],["وَبَلوتُ أَخلاقَ الرِجالِ وَفِعلَهُم","فَشَبِعتُ عِلماً مِنهُمُ وَتَجارِبا",10,"ب",2,0],["وَبَلدَةٍ يَرهَبُ الجَوّابُ دُلجَتَها","حَتّى تَراهُ عَلَيها يَبتَغي الشِيَعا",11,"ع",2,0],["وَبَلدَةً مِثلِ ظَهرِ التُرسِ موحِشَةٍ","لِلجِنِّ بِاللَيلِ في حافاتِها زَجَلُ",12,"ل",1,0],["وَبَلِيَّتي مِن ضيقِ مُقلَتِها","إِن خيفَ فَتكُ الأَعيُنِ النُجُلِ",13,"ل",1,0],["وَبَلاغَةٍ إِن عُدَّ أَهلوها","فَأَنتَ لَهُم زَعيم",14,"م",1,0],["وَبَلَوْتَ الشَّقَاءَ مِنْ كُلِّ لَوْنٍ","مَا بِهِ رَحْمَةٌ وَمَا بِكَ لِينُ",15,"ن",1,0],["وَبَلَتْ جَوْرَ دَهْرِهَا فَرَأَتْهُ","سَبَباً فِي انْتِصَافِهَا لِلهَضِيمِ",16,"م",1,0],["وبُلِّغتَ في النَجْلِ الكريم سعادةً","تَقَرُّبها عيناً وينعَمُ بالُكا",17,"ك",2,0],["وبلَّغتَه آمالَه كيف شاءها","فَبُلِّغْتَ يا مولايَ ما أنت آملْ",18,"ل",1,0],["وبليلةِ الميلاد كم من رحمةٍ","نشرَ الإِلَهُ بها ومن نعماءِ",19,"ا",2,0],["وبلغتَ من رُتب السعادة مبلغاً","أبعدتَ فيه مرتقاك العالي",20,"ل",2,0],["وَبَلِّغ إِن عَرَضتَ بَني نُمَيرٍ","وَأَخوالَ القَتيلِ بَني هِلالِ",21,"ل",1,0],["وبلدة لا ينال الذئب أفرخها","ولا وحَى الوِلْدةِ الداعين عرعارِ",22,"ر",1,1],["وَبَلَّغَهُ أَمانِيَهُ جَميعاً","وَكانَ لَهُ مِنَ الحَدَثانِ جارا",23,"ر",2,0],["وبلغتَ ما بلغ الحسابُ براحةٍ","عرِفتْ أصابعُ بحرها بوفاء",24,"ا",2,0],["وبلغها عنِّي أتمّ تحيَّةٍ","عليل الصبا يُروي بفيه صحيحها",25,"ح",3,0],["وبليت منه بدور عشقٍ دائمٍ","مثل الهلالِ إذا استسرَّ تجدَّدا",26,"د",2,0],["وبليغ تنضد المدح فيه","وهو أبهى منه وأنضر نهدا",27,"د",2,0],["وبلاغة أما الطروس برقشها","فلكم صفت في الواصفين مرقَّشا",28,"ش",2,0],["وبلية الإنسان منه وإنما","بك يا شفيع المذنبين تشفعي",29,"ع",2,0],["وبليغ لو قام أهل المعاني","قال أسنى من قولهم في منامهْ",30,"م",2,0],["وبلغت ما لا سوّلته شبيبتي","وفعلت ما لا ظنَّه شيطاني",31,"ي",1,0],["وَبَلبلةٌ لأهل البَرِّ تجري","فكلٌّ من أذاها في ضُروبِ",32,"ب",1,0],["وبَلَّتْ دماً مِنْ بعد دمع رداءه","لدى خلوات منه أجفانُه الغُزر",33,"ر",1,0],["وبلَّت برأس التُّرَّكشِّ وأعصفت","له تحت منسوج العجاج المشبرق",34,"ق",1,0],["وبلَّغهُ مبْلَغَ الصالحين","وأرقدَ عَيْنَيْهِ من نائم",35,"م",1,0],["وَبَلابِلٌ كانَت تَإِنُّ سَجينَةً","أَطلَقَتها عَلى أَطَرتَها أَسرابا",36,"ب",2,0],["وَبِلُبنانَ رَجفَةٌ تَتَمَشّى","في يَنابيعِه وَفي نَسَماتِه",37,"ت",2,0],["وَبَلَغَت أَصواتُهُم عَرشَهُ","في لَيلَةٍ مُقمِرَةٍ صافِيَه",38,"ه",1,0],["وَبَلِيَّتي كَفَلٌ عَلَيهِ ذُؤابَةٌ","مِثلُ الكَثيبِ عَلَيهِ صِلٌّ مُطرِقُ",39,"ق",1,0],["وَبَلَغتُ ذاكَ وَلَم أَكُن","فيهِ لَحَقٌّ بِالمُضيعِ",40,"ع",1,0],["وبلبل الروض اني كان منبره","فهو الخطيب فلا عيّ ولا حصر",41,"ر",1,0],["وبلغت ما بلغته عن عقيدة","فما كنت غراراً ولا كنت مغرورا",42,"ر",2,0],["وبليلتين أضاءتا كلتاهما","كانت لنا أفقا وعزك فرقدا",43,"د",2,0],["وَبَلَغتِ مِن إيمانِها وَرَجائِها","ما يَبلُغُ المِحرابُ مِن مُتَعَبِّدِ",44,"د",1,0],["وَبَلَغتَ مِن بابِ الخِلافَةِ سُدَّةً","لِسُتورِها التَمسيحُ وَالتَقبيلُ",45,"ل",1,0],["وَبُلِّغَتِ الرَسائِلُ لا جَناحٌ","يَجوبُ بِها البِحارَ وَلا أَداةُ",46,"ه",1,0],["وَبَلَغتَ بَيتاً بِالحِجا","زِ يُبارِكُ الباري حِيالَه",47,"ل",2,0],["وبَلابِلٌ لَوْ أَنّهُنَّ مآكلٌ","لَمْ تُخطىءِ الغِسْلينَ والزَّقُّوما",48,"م",2,0],["وَبِلُبَّيكُما الأَصيلَينِ أَن تَف","رُقَ صُمُّ الرِماحِ بَينَ الجِيادِ",49,"د",1,0],["وبلطفه عذب الجَنا","ة وأنضرَ الغصن الرطيب",50,"ب",1,0],["وبلِّغ ندامايَ الذين توقَّعوا","لقائيَ بعدَ اليوم ألّا تلاقيا",51,"ي",2,0],["وبلِّغا ظبيةً في جَيَّ مسكنُها","ظِلُّ النعيمِ وتأبَى ظِلَّ أفنانِ",52,"ن",1,0],["وبلية المشتاق إن حرم الهوى","يقظان واجتمعت لديه راقدا",53,"د",2,0],["وبَلدَةٍ لا تُرامُ خائِفَةٍ","زَوراءَ مُغبَرَّةٍ جَوانِبُها",54,"ب",3,1],["وَبَلَوتُ أَكثَرَ أَهلِها فَإِذا","كُلُّ امرِئٍ في شَأنِهِ يَسعى",55,"ا",1,0],["وَبُلَّغتُ ما أَمَّلتُ فيكَ سِوى البَقا","وَما رُمتُهُ إِلّا الوُقوفَ عَلى الدَفنِ",56,"ن",1,0],["وَبِلَفظي إِذا نَطَقتُ وَفَضلي","وَجِدالي عَن مَنصِبي وَجَلادي",57,"ي",1,0],["وبلونا نار حب","لم نذق فيها أمانا",58,"ن",2,0],["وبلائي أني أسميه ظلما","وهو لفظ ما جاء في القاموس",59,"س",1,0],["وبلدةٍ لَطَمَتْ أيدي القلاصِ بنا","منها وجوهَ قفارٍ بُرْقِعتْ ظُلَما",60,"م",2,0],["وَبَلَغتَ مَجهودَ الخَلائِقِ آخِذاً","فيها بِشَأوِ خَلائِقٍ لَم تُجهَدِ",61,"د",1,0],["وَبَلَغْنَا بِالْوُدِّ مَا لَمْ يَنَلْهُ","بِحَيَاةِ الْقُرْبَى ذَوُو الأَرْحَامِ",62,"م",1,0],["وَبَلَغنا وَاللَهِ وَصلَكَ أُخرى","بَعدَ عَهدٍ فَقُلتُ يا عَبدَ كَلّا",63,"ل",2,0],["وَبُلّا بِذِكرِ الهَوى غُلَّةً","بِصَدرِ كَريمٍ صَبا ما صَبا",64,"ب",2,0],["وَبَلَّت نِجادي عَبرَةٌ مُستَهِلَّةٌ","أُكَفكِفُ مِنها بِالبَنانِ تَصَنُّعا",65,"ع",2,0],["وَبَلِّغ تَحِيّاتي إِلَيها وَصَبوَتي","وَكُن بَعدَها عَن سائِرِ الناسِ أَعجَما",66,"م",2,0],["وبلوتُ أسباب الحياة وقستُها","فَإِذا التَعاوُنُ قُوَّةٌ وَنَجاحُ",67,"ح",1,0],["وبلاداً أحبَّها","ركنُها قد تهدًّما",68,"م",2,0],["وبلغة العار عند الجوع تلفظها","نفس لها عن قبول العار رادع",69,"ع",1,0],["وَبَلَغتَ أَفضَلَ ما تُري","دُ مِنَ المَكارِمِ وَالفَضائِل",70,"ل",1,0],["وَبَلدَةٍ جُبتُها وَحدي بِيَعمَلَةٍ","إِذا السَرابُ عَلى صَحرائِها اِضطَرَبا",71,"ب",2,0],["وَبَلَّغَتْكَ اللّيالِي ما تُؤَمِّلُهُ","وَلا تَعَدَّتْ إلَى أَيَّامِكَ الغِيَرُ",72,"ر",1,0],["وَبَلِيَّتِي عِرسٌ بُلِيتُ بِمَقْتِها","والبَغْلُ مَمْقُوتٌ بغَيرِ قيامِ",73,"م",1,0],["وبلَغتَ قُطرَ الأرْضِ بالعزْمِ الذي","لم تُؤتَهُ الأفلاكُ في الدّوَرَانِ",74,"ن",1,0],["وَبَلدَةٍ فيها زَوَر","صَعراءَ تَخطى في صَعَر",75,"ر",1,1],["وَبِلادٍ في بِلادٍ","أَوحَشُ البُلدانِ طُرقا",76,"ق",2,0],["وَبَلَغتُ ما بَلَغَ اِمرُؤٌ بِشَبابِهِ","فَإِذا عُصارَةُ كُلُّ ذاكَ أَثامُ",77,"م",1,0],["وَبِلالٌ يَحكي اِبنَ تَمرَةَ في الخِفَّةِ","أَوفى مِن عَنتَرَ اِبنِ زَبيبَه",78,"ب",2,0],["وَبِلادٍ وَرَدْتُها ذَنَبَ السِّرْ","حانِ بينَ المَهاةِ والسَّرْحانِ",79,"ن",1,0],["وَبِلادٍ زَعِلٍ ظِلمانُها","كَالمَخاضِ الجُربِ في اليَومِ الخَدِر",80,"ر",1,0],["وَبَلِّغ عِقالاً أَنَّ خُطَّةَ داحِسٍ","بِكفَّيكَ فَاِستَأخِر لَها أَو تَقَدَّمِ",81,"م",1,0],["وَبلدَةٍ صَحْصَحْتَ مِنها الرُّبا","بِفَيْلَقٍ كالسَّيْلِ دَفَّاعِ",82,"ع",1,0],["وبلغي أَهلها سَلامي","تعطُّفاً منك أَو سماحا",83,"ح",2,0],["وبلطف تعهدتني الى أن","زال ضعفي واشتد لين عظامي",84,"م",2,0],["وبَلَوْتَ من صَلفِ الطُّغاةِ وعَسْفِهم","فيها الليالي والسنين شِدَادا",85,"د",2,0],["وبلّغ فيه والده أموراً","عدوهما بها شرق رديّ",86,"ي",1,0],["وبلغ الصّمّ بلاغ الداعي","وأسمعتهم حجّة الوداع",87,"ع",1,0],["وبلبلت ألسنَهم أسماءُ","فكثرت في حبها الأسماءُ",88,"ا",2,0],["وبُلِّغْتُ أَقْواماً تَجِيشُ صُدُورُهُمْ","عليَّ وإِني منهُمُ فارغُ الصَّدرِ",89,"ر",1,1],["وَبَلايا 