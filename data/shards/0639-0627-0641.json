يكَ صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=190498",""],[4994,"يُحبُّهُ اللهُ وأُحبُّهُ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=208943",""],[5002,"حقبةُ الألم.....","https://www.poetsgate.com/ViewPoem.aspx?id=210848",""],[5147,"سر الهوى العذري مودع","https://www.poetsgate.com/ViewPoem.aspx?id=166721",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5277,"عينُ القطا","https://www.poetsgate.com/ViewPoem.aspx?id=191592",""],[5277,"للهجرتينِ طريقٌ واحدٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=206347",""],[5293,"تحذير","https://www.poetsgate.com/ViewPoem.aspx?id=186130",""],[5363,"يا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=144178",""],[5398,"مصاب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=37122",""],[5464,"يا أخت مكة","https://www.poetsgate.com/ViewPoem.aspx?id=701",""],[5732,"ذابت الروح","https://www.poetsgate.com/ViewPoem.aspx?id=177904",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[5956,"وخْزٌ في زَند ابنتي آن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213372",""],[6093,"عودتنا اللطف يا ألله في القدر","https://www.poetsgate.com/ViewPoem.aspx?id=211355",""],[6142,"ثنى الإمام عن الدنيا تورعه","https://www.poetsgate.com/ViewPoem.aspx?id=155724",""],[5309,"عاش الجهول معظما مرفوعا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573813",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""]],"verses":[["عافوا المَذَلَّةَ في الدُنيا فَعِندَهُمُ","عِزُّ الحَياةِ وَعِزُّ المَوتِ سِيّانِ",0,"ن",1,0],["عافَ القَديمَ وَقَد كَسَتهُ يَدُ البِلى","خَلَقَ الأَديمِ فَهانَ في خُلقانِهِ",1,"ن",2,0],["عافَ في مَنفاهُ أَن يَدنو بِهِ","عَفوُ ذاكَ القاهِرِ المُغتَصِبِ",2,"ب",1,0],["عَافَاكَ رَبُّكَ كيْفَ تَضْطَلِعُ القوَى","بِأَقَلِّ مَا حُمِّلْتَ مِن أَحْمَالِهَا",3,"ل",3,0],["عافَتا الماءَ فَلَم نُعطِنهُما","إِنَّما يُعطِنُ مَن يَرجو العِلَل",4,"ل",1,0],["عافية بشرت بعافية السل","طان أكرم بيمنها الصاحب",5,"ب",1,1],["عافيهِ عِلْقُ صيانةٍ","وثَراؤُه تُرْس اتِّقاءِ",6,"ق",3,0],["عافِيه من بَذْلِ اللُّهَى","والمُرْتجِيه على التُّخوم",7,"م",1,0],["عافَ الزَمانُ بَني الدُنيا وَقَيَّدَهُ","وَالطَيرُ يُحبَسُ مِنها جَيِّدُ النَغَمِ",8,"م",1,0],["عافي الجَبا غَيرَ أَصداءٍ يُطِفنَ بِهِ","وَذو قَلائِدَ بِالأَعطانِ عَرّاجِ",9,"ج",1,0],["عافي الرِقاقِ مِنهَبٍ مَبوحِ","وَفي الدِهاسِ مِضبَرٍ ضَروحِ",10,"ح",1,1],["عافته أطلال الديا","ر ومجه وادى الأراك",11,"ك",1,0],["عافَ بِالدُنيا بِناءً بَعدَ ما","خَطَبَ الدُنيا وَأَهدى وَمَهَر",12,"ر",1,0],["عافوكَ خَصَّكَ مَكروهٌ فَعَمَّهُمُ","ثُمَّ اِنجَلى فَتَجَلَّت أَوجُهٌ شُحُبُ",13,"ب",1,0],["عافَ الوقوفَ على المحلِّ العافي","وأقامَ إلفَ مَوَدَّةِ الأُلاّفِ",14,"ف",1,1],["عافِ مِنَ السُقمِ مُبتَلىً بِهَوى","مانَفَعَت فيهِ عوذَةٌ وَرُقى",15,"ق",2,0],["عافوا المَنازِلَ مِن نَجدٍ وَساكِنِهِ","فَما دَرَيتُ لِأَنّى طِيَّةٍ عَمَدوا",16,"د",3,0],["عافاني اللَهُ مِمّا بِتَّ جانِيَهُ","فَلَم يَزَل مِن جِناياتي يُعافيكا",17,"ك",2,0],["عاف للذعر حين أَبصر فهداً","فرس الجو سنبل الخضراء",18,"ا",2,0],["عافَ الحياةَ على نواكَ طليقةً","وأتاك ينشدها بعينِ سجينِ",19,"ن",1,0],["عاف نزري إذ خاف تأكيد ضَرِّي","فاستحقَّ الجفاءَ إذ عاف نزرا",20,"ر",2,0],["عافَ أوتارَهُ وال","عَزْفَ عافَ الطَّرَبْ",21,"ب",1,0],["عافت ثُدِيَّ المُحالِ","يَنِزُّ منها الأوام",22,"م",1,0],["عَافٍ كَوَشِي فِرندٍ أو كَوَشمٍ يَدٍ","أسَفَّ فِيهِ النَّؤرَ الرَّجعَ مَن وَشَمَه",23,"م",2,0],["عافُوا الظَواهِرَ مِن أُمِّ القُرى وَبَنَوا","أَبياتَهُم عِزَّةً في سِرِّ وَاديها",24,"ي",3,0],["عاف مدح اللئام واستحمل الصب","ر فأدنى إليه كل منيع",25,"ع",1,0],["عافِيَةً لِلحَسودِ مُمرِضَةٌ","وَصِحَّةٌ وَهِيَ لِلعِدى سَقَمُ",26,"م",1,0],["عافَ الوُرودَ فَماتَ مِن ظَمَأ بِهِ","لما أَتى يَتَنَفَّسُ الصُعَداءَ",27,"ا",2,0],["عافَ نَعَمْ حُبّاً للا سِفْلَةٌ","أَطرَبَني فيهِ الذي قالا",28,"ل",2,1],["عافَ السَّديفَ وقد ألمَّ بسُدْفةٍ","فأرادني وأذابَني وغَذاني",29,"ن",2,0],["عافتْ عَيوفاً نَفْسي الغداةَ ولم","يَرْوَ بلُقْيا ظَمياءَ مظمؤها",30,"ا",3,0],["عافنا واعف عنا واكف كل أذيه","واكشف الجور عنا والبلاو والبليه",31,"ي",2,0],["عافني من علة أنت بها","عالم من قبل إيجاد البشر",32,"ر",1,0],["عافَ سمعي ذكرَ المحلِّ العافي","واصطفاءَ البكاءِ بالمُصْطافِ",33,"ف",1,1],["عافت من الشيب وسما ما اغتبطتُ به","يا ليت عالطَ هذا الوسمِ أغفلني",34,"ن",2,0],["عافَ الأجانبَ واسترعاه همَّته","موفَّقٌ بأخيه عن سواه غنِي",34,"ن",2,0],["عافيتَ أهلَ الأرض من سَقَمٍ","عرَضوا له بالمال والأهلِ",35,"ل",1,0],["عاف البقايا أنه مُنتَتِجٌ","في معشر لا يشربون السُّؤرا",36,"ر",2,0],["عاف الدنايا منذ كان وإنما","عاف الديانا حين فاقَ بَني الدُّنى",37,"ن",2,0],["عافتْ جميمَ النبتِ مِن شوقٍ الى","أعطانِهنَّ به وطيبَ المكرَعِ",38,"ع",1,0],["عافوا الإِتاوَةَ وَاِستَقَت أَسلافُهُم","حَتّى اِرتَوَوا عَلَلاً بِأَذنِبَةِ الرَدى",39,"ا",1,0],["عافوا العذَارَ بِصَفحَتَيهِ وَما دَرَوا","أنَّ الفِرندَ مِن كُلِّ مُهَنَّدِ",40,"د",1,0],["عافت من المجد ورود منهل","وارده متبع للصادر",41,"ر",1,0],["عافوا القرارَ وليس غير قرارهمْ","أوْ بردِهمْ موتاً بحدّ طعانِ",42,"ن",1,0],["عافوا رِضاكَ فَعاقَتهُم بِعَقوَتِهِم","عَنِ الحَياةِ مَناياهُم لِمَوعودِ",43,"د",1,0],["عافُوا الرَّدَى غَضّا وَرُضتَ صِعابهَمُ","فَجَنَوهُ مِن وَرَقِ الصَّوارِمِ يانِعا",44,"ع",2,0],["عافَ الحَشيَّةَ حَتَّى إذ غُصِبتُ بِه","مِن كَثكَثٍ مِن خِضابِ المَعنِ رَضراض",45,"ض",1,0],["عاف النهار مخافة الرقباء","فسرى يضمّخ حلة الظلماء",46,"ا",2,1],["عافوا شهيَّ العدل والإحسان أم","غصوا بهذا الماء وهو نمير",47,"ر",1,0],["عافاكَ ربّي وَأَرجو اللَّه يَشفيكا","مِن كلِّ داءٍ وَباِسمِ اللَّه أَرقيكا",48,"ك",2,1],["عافَ الِحصار الضَّيِّق الَحِرجَ الذي","زُحلٌ يَلي تَدبِيَرهُ المشتَري",49,"ر",2,0],["عاف المناصب والمراتب لم يمل","إلا لنشر فضيلة وكمال",50,"ل",1,0],["عافه من بلائه واجره","انه من بلائه يستجير",51,"ر",1,0],["عاف خفض العيش في برد الظلال","وامتطى للمجد نزاع الشوى",52,"ش",3,0],["عافت سيوفك في الهيجا لحومهم","فهن يأكلن منها إكلة البشم",53,"م",1,0],["عافصها بوثبة شَديده","محكماً أَنيابه الحَديده",54,"ه",1,0],["عافت أخا دمعي العقيقَ وثغرُها","أمسى يَضيءُ به أخ