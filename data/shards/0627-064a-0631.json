{"poems":[[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[77,"يا مصطفى من قبل نشأة آدم","https://www.aldiwan.net/poem35897.html","الكامل"],[86,"أيا صوفيا حان التفرق فاذكري","https://www.aldiwan.net/poem10676.html","الطويل"],[86,"أي رجال الدنيا الجديدة مهلاً","https://www.aldiwan.net/poem10706.html","الخفيف"],[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[93,"ألقى الدجى الستر فقم طائفا","https://www.aldiwan.net/poem11062.html","السريع"],[93,"أي رزء دهاك يا سمعان","https://www.aldiwan.net/poem11258.html","الخفيف"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[88,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[72,"قل لابن مولانا العزيز ومن له","https://www.aldiwan.net/poem19014.html","الكامل"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[72,"يا رب ليل بته متنعما","https://www.aldiwan.net/poem19598.html","الكامل"],[72,"إيري يحاربني وعبدي منشد","https://www.aldiwan.net/poem20330.html","الكامل"],[51,"يا عجبا من خالد في صبره وجلده","https://www.aldiwan.net/poem9997.html","مجزوء الرجز"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"أيركب عمرو حوله من يحفه","https://www.aldiwan.net/poem64606.html","الطويل"],[51,"أيرضى الأمير أطال الإله","https://www.aldiwan.net/poem65407.html","المتقارب"],[51,"أيا ابن المعلى كن معلى ولا تكن","https://www.aldiwan.net/poem65791.html","الطويل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[91,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[70,"تائه ما أصلفه","https://www.aldiwan.net/poem42818.html","مجزوء الرمل"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"أيري وأيرك يا كوي","https://www.aldiwan.net/poem65529.html","مجزوء الكامل"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[49,"نطقت بنو أسد ولم تجهر","https://www.aldiwan.net/poem64211.html","الكامل"],[97,"يا من طلبت الشعر هاك تحيتي","https://www.aldiwan.net/poem24853.html","الكامل"],[97,"أنتِ إن تؤمني بحبي كفاني","https://www.aldiwan.net/poem24975.html","الخفيف"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"أي روح لي في الريح القبول","https://www.aldiwan.net/poem31315.html","الرمل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[44,"هل الله لو أشركت كان معذبي","https://www.aldiwan.net/poem30006.html","الطويل"],[44,"أي رأي وأي عقل صحيح","https://www.aldiwan.net/poem30056.html","الخفيف"],[69,"لقد آذى الشهود بغير حق","https://www.aldiwan.net/poem29171.html","الوافر"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[48,"أيري لا يعدمني عرابدا","https://www.aldiwan.net/poem66258.html","الرجز"],[50,"أيري له فضل على آيارهم","https://www.aldiwan.net/poem64752.html","الكامل"],[46,"صاح ما تضحك البروق شماتا","https://www.aldiwan.net/poem22423.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54996","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55166","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43832","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54309","الطويل"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[96,"موكب الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=17479",""],[80,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[51,"أيركب عمرٌ حوله من يحفُّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29278",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""]],"verses":[["أَيُرجِعُ مَيتاً رَنَّةٌ وَعَويلُ","وَيَشفى بِأَسرابِ الدُموعِ غَليلُ",0,"ل",1,1],["أَيُرجى مَداهُ بَعدَما ضَحِكَت بِهِ","أَمامَ المَعالي غُرَّةٌ وَحُجولُ",1,"ل",1,0],["أيَرومُ مخْلوقٌ ثَناءَكَ بعْدَما","أثْنَى علَى أخْلاقِكَ الخلاّقُ",2,"ق",1,0],["أَيُرضيكَ أَن تَغشى سَنابِكُ خَيلِهِم","حِماكَ وَأَن يُمنى الحَطيمُ وَزَمزَمُ",3,"م",1,0],["أَي رِجالَ الدُنيا الجَديدَةِ مَهلاً","قَد شَأَوتُم بِالمُعجِزاتِ الرِجالا",4,"ل",2,1],["أَيَرغَبانِ عَنِ الحُسنى وَبَينَهُما","في رائِعاتِ المَعالي ذَلِكَ النَسَبُ",5,"ب",1,0],["أَي رِجالَ الدُنيا الجَديدَةِ مُدّوا","لِرِجالِ الدُنيا القَديمَةِ باعا",6,"ع",2,1],["أي رائد الظلماء جاوز إلى","تلك المغاني من حصون الهدى",7,"ا",1,0],["أَيُّ رُزْءٍ دَهَاكَ يَا سَمْعَانُ","هُزَّ مِنْ هَوْلِ وَقْعِهِ لُبْنَانُ",8,"ن",1,1],["أَيُّ رُزْءٍ أَلَمَّ بِالعَلَمِ الفَرْ","دِ فَأَلْقَى الخُشُوعَ فِي الأَعْلامِ",9,"م",1,0],["أيُرفِع قَدْر العلم يَنطِق ناظماً","ويُوضَع قدر العلم ينطق ناثرا",10,"ر",2,0],["أيرد عن عتبات بابك جيّد","والزّيف يا ذا الإنتقاد يجوز",11,"ز",1,0],["أيّ ردينيّ بغى حربه","من ندمٍ للسنِّ لم يقرع",12,"ع",1,0],["إيري بجانب كسّها في جحرها","عرف المحل فباتَ دون المنزل",13,"ل",1,0],["إيري يحاربني وعبدي منشدٌ","الرأي قبل شجاعة شجعان",14,"ن",1,1],["أيْرُ غُلام أيْرُهُ","أعْظَمُ ما في جسدهْ",15,"د",2,0],["أيركب عمرو في الزنوج ولم يزل","يبيت عروساً للزنوج بلا مهر",16,"ر",1,0],["أيركب عمرٌو حوله من يحفُّهُ","ويُعوِزُني قوتٌ أعولُ به عِرسِي",17,"س",2,1],["أيرضى الأمير أطال الإله","بقاء الأمير عزيزاً مطاعا",18,"ع",2,1],["أيرضى مُعيرٌ من كتابٍ بنسخِه","وتأبى عليه ذاك جُرتَ مليكا",19,"ك",2,0],["أيرودُ رائدُك الكُفاةَ وفي","أدْنى ديارِك عَيْمةُ العِيمِ",20,"م",1,0],["أَيُّ رِجالَ الشَرقِ أَبناءَ القُروم","لا تَناموا آفَةُ الماءِ الرُكود",21,"د",1,0],["أَيُّ رَوضٍ زاهِرٍ","لَم أَصِل أَن أَقطُفَه",22,"ف",2,0],["أيريدون بكم أن تجمعوا","رقة الدين إلى الخلق الهزيل",23,"ل",1,0],["أَيَرى العُجمُ مِن بَني الظِلِّ وَالما","ءِ عَجيباً أَن تُنجِبَ البَيداءُ",24,"ا",2,0],["أَيري وَأَيرُكَ يا كُوَي","رَةَ في حِرِ اِمِّكَ ما أَرَكَّك",25,"ك",1,1],["أيريدون أن أمص نزيفي؟","لا جدارٌ أنا ولا ببغاء!",26,"ا",2,0],["أيرهَبُ جانبَ الأعداءِ ميلاً","وسيفُ الدَّولةِ الرُّكنُ الشَّديدُ",27,"د",1,0],["أَيَرومُ شَتمي مِنهُمُ رَجُلٌ","في وَجهِهِ عِبَرٌ لِمَن فَكَّر",28,"ر",1,0],["أيُرادُ تفصيلٌ لما عندي وكم","قلبٍ وموجز أمره في لفظة",29,"ه",1,0],["أي روح أحسه أي سر","في جناحيك كلما ظللاني",30,"ي",1,0],["أي روح أحسه أي سحر","سكبت فيّ هاته العينان",30,"ن",1,0],["أيّ رزءٍ جاءتْ به الرّيحُ في الما","ءِ وأفشَتْهُ من لسانِ النّعِيِّ",31,"ي",1,0],["أيّ رَوْحٍ ليَ في الرّيحِ القَبولِ","وَسُرَاها من رسومي وطلولي",32,"ل",2,1],["أيّ رزءٍ حكاهُ مِقْوَلُ ناعٍ","صمّ هذا الزمانُ عمّا يقولُ",33,"ل",1,0],["أَيُرضِخُنا رَضخَ النَوى وَهوَ مُصمِتٌ","وَيَأكُلُنا أَكلَ الدَبا وَهوَ جائِعُ",34,"ع",1,0],["أَيَرضى بِضَعفٍ في وَسائِلِهِ اِمرُؤٌ","لَهُ حَرَكاتٌ كُلُّهُنَّ وَسائِلُ",35,"ل",1,0],["أَيُّ رَأيٍ وَأَيُّ عَقلٍ صَحيحِ","لَم يُخَوِّفكَ سانِحي وَبَريحي",36,"ي",1,1],["أيرضى المسلمونَ لهمْ بهذا","وقدْ سرَّ النصارى واليهودا",37,"د",2,0],["أَيُرضيكَ رَبّي أَن يُقادوا لِحَتفِهِم","قِيادَ الأُسارى أَوثَقَتها الأَداهِمُ",38,"م",1,0],["أيَّ رأسٍ حَملت يا حاملَ الإي","مانِ سمحاً والبِرَّ صَفْواً طَهورا",39,"ر",2,0],["أي رئوبين غطِّ وَجهك حَتّى","لا يُرى الأَنف أَنهُ مَهشوم",40,"م",1,0],["أَي رئوبين أَينَ أَلواح موسى","وَالوَصايا فَكلهن قَويم",40,"م",1,0],["أَي رئوبين أَي شَعب تُنادي","إِن رَبّاً أَباده لَحَكيم",40,"م",1,0],["أَي رئوبين هَل قَرَأت شكسبي","ر بَلى أَنتَ شاعر مَشئوم",40,"م",1,0],["أَيُّ رَسمٍ لِآلِ هِندٍ وَدارِ","دَرَسا غَيرَ مَلعَبٍ وَمَنارِ",41,"ر",1,1],["أيريَ لا يعدمُني عرابدا","قد قرّرَ الليل له المواعدا",42,"د",2,1],["أَيري لَهُ فَضلٌ عَلى آيارِهِم","وَإِذا أَشَظَّ سَجَدنَ غَيرَ أَوابِ",43,"ب",1,1],["أَيُرَجَّونَ أَن أَعودَ إِلَيهِم","لا تُرَجّوا فَإِنَّني لا أَعودُ",44,"د",1,0],["أَيُريد الراعي الصديّ ليروى","فَلَقَد أَلقى دلوه في الدلاء",45,"ا",2,0],["أَيُرينا طلوعه من جديد","فيك نجمٌ للعلم لاقى أفولا",46,"ل",2,0],["أيُرى جناحُكَ في السماء كعهده","متوشّحاً فَلقَ الصباح الساغرِ",47,"ر",1,0],["أيُرى شراعك في العباب كعهده","مُتقلّداً حَلَقَ السحاب الماطرِ",47,"ر",1,0],["أيّ رسول أو نبيّ قبله","لم يطلب الرزق ويبغ سبله",48,"ه",1,0],["أَيُّ رُوحٍ كَنَفْحَةِ الطِّيبِ فِي قَا","رُورَةٍ قَلَّ أُذْنُهَا لِلنَّسِيمِ",49,"م",1,0],["أَيَرْجِعُ صَوْتٌ بَعْدَ أَلْفٍ وَنَيِّفٍ","إِلَيْكَ وَلاَ تَنْبُو بِهِ حُجُبُ الرَّدَى",50,"د",2,0],["أَيَرْضَى لِنُعْمَى نَالَهَا قَمِنٌ بِهَا","فَلاَ قَوْلَ فِي الأَذْهَانِ أَعْذَبُ مَوْرِدَا",50,"د",2,0],["أَيَرسُمُ مَوْصُوفاًفَتِلْكَ صِفَاتُهُ","حَقَائِقَ حَلاَّهَا الْخَيَالُ وَخَلَّدَا",50,"د"