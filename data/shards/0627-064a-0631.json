/poem2578.html","الكامل"],[443,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[453,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[453,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[477,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[479,"أترافق الخود الحسان وتدعي","https://www.aldiwan.net/poem37179.html","الكامل"],[479,"أينفى الاعتصاب بنفي سبع","https://www.aldiwan.net/poem37607.html","الوافر"],[495,"يقولون لي لا تحب الوصي","https://www.aldiwan.net/poem9767.html","المتقارب"],[500,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[503,"منحت أمير المؤمنين نصيحة","https://www.aldiwan.net/poem21720.html","الطويل"],[515,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[529,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[533,"أيرجو ربيع أن يؤوب وقد ثوى","https://www.aldiwan.net/poem413.html",""],[536,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[538,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[538,"من كان ينوي فيك مصر بأنه","https://www.aldiwan.net/poem48210.html","عموديه"],[551,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[558,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[575,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[575,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[586,"عفا الله عن قوم عفا الصبر منهم","https://www.aldiwan.net/poem17715.html","الطويل"],[586,"يا مدع أن الغرام بقلبه","https://www.aldiwan.net/poem17974.html","الكامل"]],"verses":[["أَيُرجِعُ مَيتاً رَنَّةٌ وَعَويلُ","وَيَشفى بِأَسرابِ الدُموعِ غَليلُ",0,"ل",1,1],["أَيُرجى مَداهُ بَعدَما ضَحِكَت بِهِ","أَمامَ المَعالي غُرَّةٌ وَحُجولُ",1,"ل",1,0],["أيَرومُ مخْلوقٌ ثَناءَكَ بعْدَما","أثْنَى علَى أخْلاقِكَ الخلاّقُ",2,"ق",1,0],["أَيُرضيكَ أَن تَغشى سَنابِكُ خَيلِهِم","حِماكَ وَأَن يُمنى الحَطيمُ وَزَمزَمُ",3,"م",1,0],["أَي رِجالَ الدُنيا الجَديدَةِ مَهلاً","قَد شَأَوتُم بِالمُعجِزاتِ الرِجالا",4,"ل",2,1],["أَيَرغَبانِ عَنِ الحُسنى وَبَينَهُما","في رائِعاتِ المَعالي ذَلِكَ النَسَبُ",5,"ب",1,0],["أَي رِجالَ الدُنيا الجَديدَةِ مُدّوا","لِرِجالِ الدُنيا القَديمَةِ باعا",6,"ع",2,1],["أي رائد الظلماء جاوز إلى","تلك المغاني من حصون الهدى",7,"ا",1,0],["أَيُّ رُزْءٍ دَهَاكَ يَا سَمْعَانُ","هُزَّ مِنْ هَوْلِ وَقْعِهِ لُبْنَانُ",8,"ن",1,1],["أَيُّ رُزْءٍ أَلَمَّ بِالعَلَمِ الفَرْ","دِ فَأَلْقَى الخُشُوعَ فِي الأَعْلامِ",9,"م",1,0],["أيُرفِع قَدْر العلم يَنطِق ناظماً","ويُوضَع قدر العلم ينطق ناثرا",10,"ر",2,0],["أيرد عن عتبات بابك جيّد","والزّيف يا ذا الإنتقاد يجوز",11,"ز",1,0],["أيّ ردينيّ بغى حربه","من ندمٍ للسنِّ لم يقرع",12,"ع",1,0],["إيري بجانب كسّها في جحرها","عرف المحل فباتَ دون المنزل",13,"ل",1,0],["إيري يحاربني وعبدي منشدٌ","الرأي قبل شجاعة شجعان",14,"ن",1,1],["أيْرُ غُلام أيْرُهُ","أعْظَمُ ما في جسدهْ",15,"د",2,0],["أيركب عمرو في الزنوج ولم يزل","يبيت عروساً للزنوج بلا مهر",16,"ر",1,0],["أيركب عمرٌو حوله من يحفُّهُ","ويُعوِزُني قوتٌ أعولُ به عِرسِي",17,"س",2,1],["أيرضى الأمير أطال الإله","بقاء الأمير عزيزاً مطاعا",18,"ع",2,1],["أيرضى مُعيرٌ من كتابٍ بنسخِه","وتأبى عليه ذاك جُرتَ مليكا",19,"ك",2,0],["أيرودُ رائدُك الكُفاةَ وفي","أدْنى ديارِك عَيْمةُ العِيمِ",20,"م",1,0],["أَيُّ رِجالَ الشَرقِ أَبناءَ القُروم","لا تَناموا آفَةُ الماءِ الرُكود",21,"د",1,0],["أَيُّ رَوضٍ زاهِرٍ","لَم أَصِل أَن أَقطُفَه",22,"ف",2,0],["أيريدون بكم أن تجمعوا","رقة الدين إلى الخلق الهزيل",23,"ل",1,0],["أَيَرى العُجمُ مِن بَني الظِلِّ وَالما","ءِ عَجيباً أَن تُنجِبَ البَيداءُ",24,"ا",2,0],["أَيري وَأَيرُكَ يا كُوَي","رَةَ في حِرِ اِمِّكَ ما أَرَكَّك",25,"ك",1,1],["أيريدون أن أمص نزيفي؟","لا جدارٌ أنا ولا ببغاء!",26,"ا",2,0],["أيرهَبُ جانبَ الأعداءِ ميلاً","وسيفُ الدَّولةِ الرُّكنُ الشَّديدُ",27,"د",1,0],["أَيَرومُ شَتمي مِنهُمُ رَجُلٌ","في وَجهِهِ عِبَرٌ لِمَن فَكَّر",28,"ر",1,0],["أيُرادُ تفصيلٌ لما عندي وكم","قلبٍ وموجز أمره في لفظة",29,"ه",1,0],["أي روح أحسه أي سر","في جناحيك كلما ظللاني",30,"ي",1,0],["أي روح أحسه أي سحر","سكبت فيّ هاته العينان",30,"ن",1,0],["أيّ رزءٍ جاءتْ به الرّيحُ في الما","ءِ وأفشَتْهُ من لسانِ النّعِيِّ",31,"ي",1,0],["أيّ رَوْحٍ ليَ في الرّيحِ القَبولِ","وَسُرَاها من رسومي وطلولي",32,"ل",2,1],["أيّ رزءٍ حكاهُ مِقْوَلُ ناعٍ","صمّ هذا الزمانُ عمّا يقولُ",33,"ل",1,0],["أَيُرضِخُنا رَضخَ النَوى وَهوَ مُصمِتٌ","وَيَأكُلُنا أَكلَ الدَبا وَهوَ جائِعُ",34,"ع",1,0],["أَيَرضى بِضَعفٍ في وَسائِلِهِ اِمرُؤٌ","لَهُ حَرَكاتٌ كُلُّهُنَّ وَسائِلُ",35,"ل",1,0],["أَيُّ رَأيٍ وَأَيُّ عَقلٍ صَحيحِ","لَم يُخَوِّفكَ سانِحي وَبَريحي",36,"ي",1,1],["أيرضى المسلمونَ لهمْ بهذا","وقدْ سرَّ النصارى واليهودا",37,"د",2,0],["أَيُرضيكَ رَبّي أَن يُقادوا لِحَتفِهِم","قِيادَ الأُسارى أَوثَقَتها الأَداهِمُ",38,"م",1,0],["أيَّ رأسٍ حَملت يا حاملَ الإي","مانِ سمحاً والبِرَّ صَفْواً طَهورا",39,"ر",2,0],["أي رئوبين غطِّ وَجهك حَتّى","لا يُرى الأَنف أَنهُ مَهشوم",40,"م",1,0],["أَي رئوبين أَينَ أَلواح موسى","وَالوَصايا فَكلهن قَويم",40,"م",1,0],["أَي رئوبين أَي شَعب تُنادي","إِن رَبّاً أَباده لَحَكيم",40,"م",1,0],["أَي رئوبين هَل قَرَأت شكسبي","ر بَلى أَنتَ شاعر مَشئوم",40,"م",1,0],["أَيُّ رَسمٍ لِآلِ هِندٍ وَدارِ","دَرَسا غَيرَ مَلعَبٍ وَمَنارِ",41,"ر",1,1],["أيريَ لا يعدمُني عرابدا","قد قرّرَ الليل له المواعدا",42,"د",2,1],["أَيري لَهُ فَضلٌ عَلى آيارِهِم","وَإِذا أَشَظَّ سَجَدنَ غَيرَ أَوابِ",43,"ب",1,1],["أَيُرَجَّونَ أَن أَعودَ إِلَيهِم","لا تُرَجّوا فَإِنَّني لا أَعودُ",44,"د",1,0],["أَيُريد الراعي الصديّ ليروى","فَلَقَد أَلقى دلوه في الدلاء",45,"ا",2,0],["أَيُرينا طلوعه من جديد","فيك نجمٌ للعلم لاقى أفولا",46,"ل",2,0],["أيُرى جناحُكَ في السماء كعهده","متوشّحاً فَلقَ الصباح الساغرِ",47,"ر",1,0],["أيُرى شراعك في العباب كعهده","مُتقلّداً حَلَقَ السحاب الماطرِ",47,"ر",1,0],["أيّ رسول أو نبيّ قبله","لم يطلب الرزق ويبغ سبله",48,"ه",1,0],["أَيُّ رُوحٍ كَنَفْحَةِ الطِّيبِ فِي قَا","رُورَةٍ قَلَّ أُذْنُهَا لِلنَّسِيمِ",49,"م",1,0],["أَيَرْجِعُ صَوْتٌ بَعْدَ أَلْفٍ وَنَيِّفٍ","إِلَيْكَ وَلاَ تَنْبُو بِهِ حُجُبُ الرَّدَى",50,"د",2,0],["أَيَرْضَى لِنُعْمَى نَالَهَا قَمِنٌ بِهَا","فَلاَ قَوْلَ فِي الأَذْهَانِ أَعْذَبُ مَوْرِدَا",50,"د",2,0],["أَيَرسُمُ مَوْصُوفاًفَتِلْكَ صِفَاتُهُ","حَقَائِقَ حَلاَّهَا الْخَيَالُ وَخَلَّدَا",50,"د",2,0],["أَيُرَادُ لِي مِنْ فَضْلِ مَا مَجُدَا بِهِ","إِرْثٌ إِذَنْ جَهِلَ الزَّمَانُ وَفَائِي",51,"ا",2,0],["أَيَرْجِعُ العَهْدُ الَّذِي يجْرِي بِهِ","قَوْلِي هَنِيئاً فِي فُؤَادِ السَّامِعِ",52,"ع",1,0],["أَيُّ رَاجِ وَالجُودُ حَقٌّ عَلَيْهِ","لَمْ يُصِبْ مِنْهُ مَا وَرَاءَ النِّصَابِ",53,"ب",1,0],["أَيُّ رُزْءٍ شَجَا بَنِيهِ وَأَدْمَى","فِي الحَشَى كُلَّ مُعْجَبٍ وَمُرِيدِ",54,"د",1,0],["أَيَرَىَ فِي الشَّامِخَ المُنْدَاحِ مِنْ","دُونِهِ كَيْفَ مَآلُ الكِبْرِيَاءْ",55,"ا",2,0],["أَيَرَى وَالبَحْرُ مَرْدُودٌ إِلى","مُلْتَقَى حَدَّيْهِ مَا حَدُّ البَقَاءْ",55,"ا",2,0],["أَيَرَى الضِّدَّيْنِ مِنْ خَفْضٍ وَمِنْ","رِفْعَةٍ صَارَا إِلى شَيْءٍ سَوَاءْ",55,"ا",2,0],["أَيَرْقَى إِلَى أَوْجِ الكَمَالِ مُصَعِّدٌ","وَيَعْدُونه دُونَ الأَوْجِ نُقْصَانُ زَادِهِ",56,"د",2,0],["أَيَرْقَى إِلَى أَوْجِ الكَمَالِ مُصَعِّدٌ","وَيعْدُوهُ دُونَ الأَوْجِ نُقْصَانُ زَادِهِ",56,"د",2,0],["أَيُّ رَجْعٍ يُعِيدُ إِيقَاعَها الرَّائِعَ","بَينَ التَّكْبِيرِ وَالتَّهْلِيلِ",57,"ل",1,0],["أَيَرُوعُكَ الحَشْدُ الَّذِي بِكَ يَحْتَفِي","مِنْ غُرِّ فِتْيَانٍ وَصِيدِ رِجالِ",58,"ل",1,0],["أَيَرَى فِي البَعْضِ مِنْهَا شَفَقاً","أَمْ يَرَى فِي البَعْضِ مِنْهَا سَحَرَا",59,"ر",2,0],["أَيُّ رِفْدٍ كَرِفْدِكُمْ مَا رَأَيْنَا","قَبْلَهُ المَجْدَ وَهْوَ يُمْنَح رِفْدَا",60,"د",2,0],["أيراها ورقاء من رفرفِ الخلد","وتبقى لديك ماء وطينا",61,"ن",2,0],["أَيُّ رَوضَةٍ عَبِقَ ال","جَوُّ مِن مُعَطَّرِها",62,"ر",3,0],["أَيُّ رَبيعٍ وَشى حَياتي","كانَ الحَيا فيهِ وَالحَياءُ",63,"ا",2,0],["أيركَبُها هذا فَتَنتهِبُ الثرَى","وتنهبُ رِجْلَيَّ الحصَى والجنادِلُ",64,"ل",1,1],["أيُرديك سهم بين جنبيك طائش","وقد كنت سهمًا في الملمَّات ماضيا؟",65,"ي",2,0],["أيُّ ركب دبَّ في جوْف الفلاةْ","يَقْتَفي التاريخُ في شوق خطاهْ؟",66,"ا",2,1],["أيّ ركب من هنا يسري وما","باله يسري إلى غير فلاح",67,"ح",1,0],["أيرى جناحك في السّماء كعهده","متوحشا فلق الصّباح السّاغر",68,"ر",1,0],["أيّ رزءٍ جارتْ به الريحُ في الما","ءِ وأفشتهُ من لسانِ النعيّ",69,"ي",1,0],["أيركب عمرٌ حوله من يحفُّهُ","ويُعوِزُني قوتٌ أعولُ به عِرسِي",70,"س",2,1],["أيرضى أن يكون أخاه مَطْلٌ","فتى أبواه مَكْرُمَة ٌ وَمْجْد",71,"د",1,0],["أىرى اراك مواصلي بعد الجفا","وأقول أحسن هاجري بوصال",72,"ل",1,0],["أيروم كلب السوق جحد مناقبي","والشمس ضاحية بكل بلاد",73,"د",1,0],["أيروق الطرف شيءٌ بعدكم","لا وربّ البيت في هزل وجدّ",74,"د",1,0],["ايرجى صلاح الملك والأمر قد غدا","لمن لم يكن زي الملوك له زيا",75,"ا",1,0],["ايرمى امرء جهلا إلى فوق راسه","بما أن رماه عاد للراس هاشما",76,"م",2,0],["أَيرجو أَن يزور وأَن يزارا","خيال لو نفخت عليه طارا",77,"ر",2,1],["أيرجو رحمة الرحمن عبد","يحب عدوه سراً وجهرا",78,"ر",2,0],["أَيَرى العدوُّ وقد تعدَّى طَورَهُ","ألاّ أَشُقَّ صِماخَهُ بِزَئيري",79,"ي",1,0],["أَيَرون الدعاءَ ما كان منهُ","لَهُما أو دعا وخاب الدعاءُ",80,"ا",2,0],["أيروم تقييدي بمطلق عذله","اني أرى جهل العذول مركبا",81,"ب",2,0],["أيرضيك أن تلقى المنادى قائلاً","فتىً ميتُ الإحساس عاش بلا ذنب",82,"ب",1,0],["أَيُّ روحٍ أَرَقَّ من روحِ أُختٍ","تَهبُ الجهدَ لا تُبالي العَسيرا",83,"ر",2,0],["أيرجِعَ من يرجوك للدّهر صاغراً","وأنت على كلّ الأمور قدير",84,"ر",1,0],["أَيَرى ذا الزورِ في دا","رِكَ يا مَولايَ زورُ",85,"ر",1,0],["أَيَرومُ إِدراكَ المُطَه","هَمَةِ السَوابِقِ وَهوَ مُقعَد",86,"د",1,0],["أَيُرى لِلَيلَتِنا الَّتي","سَمُحَ الزَمانُ بِها إِيابُ",87,"ب",1,0],["أَيَرُوضُ خِصْبُ الْوَصْلِ بُسْتَانَ","الْمُنَى فَلَطَالَمَا مَحْلُ الْنَّوَى أَذْوَاهُ",88,"ا",2,0],["أي رَوعٍ أسكنته في فؤادٍ","كان في فادحِ الحوادثِ جَلدا",89,"د",2,0],["أَيرضيكَ يا مولايَ أنك كلما","تروم اتساعاً في نفوذِك ضَيَّقُوا",90,"ق",3,0],["أيرضيكَ يومٌ بالحدودِ تجاوزُوا ال","حدودَ به فيما يُهينُ ويُرهِقُ",90,"ق",1,0],["أير ينام الليل وهو يقوم","حامى الأهاب كأنه يحموم",91,"م",1,1],["أَيَرجِعُ عَصرٌ بالجَزيرة رائِقُ","تَقَضّى وَأَبقى حسرةً ما تُفارِقُ",92,"ق",1,1],["إيري عليه كأنه وتدٌ","قد علقت فيه دبة البزر",93,"ر",1,0],["أيري على أنه طويلُ"