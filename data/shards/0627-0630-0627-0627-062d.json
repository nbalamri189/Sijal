{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[53,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[63,"وفتيان صدق إن يهب بهم العدا","https://www.aldiwan.net/poem45890.html","الطويل"],[9,"ألا حي ميا إذ أجد بكورها","https://www.aldiwan.net/poem21932.html","الطويل"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[83,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[88,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[51,"أرى الصبر محمودا وعنه مذاهب","https://www.aldiwan.net/poem8316.html","الطويل"],[51,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[51,"إذا أحدقوا بي في المكر حجزتهم","https://www.aldiwan.net/poem65735.html","الطويل"],[51,"إذا احتضر الشح النفوس فخالد","https://www.aldiwan.net/poem65962.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[29,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[29,"وبالجزع من خفان صاحبت عصبة","https://www.aldiwan.net/poem6109.html","الطويل"],[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[45,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[45,"خطته فلم تحفل به الأعين الوطف","https://www.aldiwan.net/poem65143.html","الطويل"],[45,"منى النفس في أسماء لو تستطيعها","https://www.aldiwan.net/poem64701.html","الطويل"],[28,"جر المخزيات على كليب","https://www.aldiwan.net/poem5238.html","الوافر"],[28,"بئست لقوحا ذي العيال امتنحتما","https://www.aldiwan.net/poem5598.html","الطويل"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[66,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[69,"إذا أحببت نظم الشعر فاختر","https://www.aldiwan.net/poem28483.html","الوافر"],[31,"ألا تجزي عثيمة ود صب","https://www.aldiwan.net/poem41326.html","الوافر"],[52,"إذا أحسست في خط فتورا","https://www.aldiwan.net/poem26602.html","الوافر"],[50,"وأرض تهب الريح فيها مريضة","https://www.aldiwan.net/poem62270.html","الكامل"],[50,"أراك اليوم لي وغدا لغيري","https://www.aldiwan.net/poem62296.html","الوافر"],[50,"أجارتنا أخطأت حظك فاخرجي","https://www.aldiwan.net/poem63987.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39587","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[132,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem24176.html","الطويل"],[133,"لعمرك ما مقلاء عود عودها","https://www.aldiwan.net/poem54852.html","البسيط"],[136,"من بعد حمزة يحمي حوزة الأدب","https://www.aldiwan.net/poem49177.html","البسيط"],[161,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[161,"لصومك شهر الصوم يكسى من الفجر","https://www.aldiwan.net/poem59111.html","الطويل"],[165,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[167,"إذا أحصيت أدوات الكفاة","https://www.aldiwan.net/poem47112.html","المتقارب"],[199,"ألوت بأهل اللوى المهرية النجب","https://www.aldiwan.net/poem51984.html","البسيط"],[230,"وكأس تعيد العسر يسرا وتجتني","https://www.aldiwan.net/poem51087.html","الطويل"],[251,"لا تسألن في الحب عن أشجانه","https://www.aldiwan.net/poem15041.html","الرجز"],[281,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[283,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[298,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[306,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[306,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[323,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[354,"دع الأجفان تسلب منك جسما","https://www.aldiwan.net/poem39960.html","الوافر"],[367,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[381,"قفوا بالناجيات على زرود","https://www.aldiwan.net/poem49202.html","الوافر"],[406,"إذا أحببت أن تبقى","https://www.aldiwan.net/poem49412.html","مجزوء الوافر"],[406,"إذا أحببت أن تحظى بسحر","https://www.aldiwan.net/poem49570.html","الوافر"],[406,"تكدر لي من كنت أرجو صفاءه","https://www.aldiwan.net/poem49938.html","الطويل"],[417,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[440,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[459,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[459,"بيضاء في لجة خضراء سابحة","https://www.aldiwan.net/poem55881.html","البسيط"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[459,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[459,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[459,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[459,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[459,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[462,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[462,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[462,"أظن القوافي ساورتها صبابة","https://www.aldiwan.net/poem15311.html","الطويل"],[462,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[462,"إذا أحببت فاصبر للرزايا","https://www.aldiwan.net/poem16088.html","الوافر"],[469,"إذا احتجب الصديق عن الصديق","https://www.aldiwan.net/poem59796.html","الوافر"],[469,"إذا أحسنت تربية لحمد","https://www.aldiwan.net/poem60496.html","الكامل"],[559,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[563,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"]],"verses":[["إِذا اِحتَمَيتُ بِهِ أَحمي عَلى كَبِدي","كَيفَ اِجتَناني إِذا أَسلَمنَني جُنَني",0,"ن",2,0],["إِذا أَحجَمَ الأَقوامُ دونَ ثَنِيَةٍ","تُجيزُ إِلى بَحبوحَةِ المَجدِ أَطلَعا",1,"ع",2,0],["إِذا اِحتَبى بِالعُشُبِ الوادي","وَاِنحَلَّ فيهِ الواكِفُ الغادي",2,"د",2,1],["إِذا احْتَضَنوا بِيضَ الصَّوارِمِ أَوْمَضَتْ","بِحُمْرِ المَنايَا وَالرُّؤوسُ غُمودُها",3,"د",3,0],["إِذا اِحمَرَّ آفاقُ السَماءِ وَأَعصَفَت","رِياحُ الشِتاءِ وَاِستَهَلَّت شُهورُها",4,"ر",3,0],["إِذا اِحتَبى لِلفَتاوى فَهوَ مالِكُها","وَإِن حَبا خَجِلَت مِن جودِهِ السُحُبُ",5,"ب",1,0],["إِذا اِحتَفَّتِ الأَعلامُ بِالآلِ وَاِلتَقَت","أَنابيبُ تَنبو بِالعُيونِ العَوارِفِ",6,"ف",1,0],["إذا احتفل الإيوان يوم مشورة","ومضطرب الآراء من كل ذي حجرِ",7,"ر",1,0],["إذا احتفلت مصر بشوقي فمالها","تُقيم على الأحرار في العلم حاجرا",8,"ر",2,0],["إذا أحصى الضعيف عليه ذنباً","أتت يمناك بالكرم الغفور",9,"ر",1,0],["إذا احتج محتجٌ على النفس لم تكد","على قَدَرٍ يُمنَى لها تتعتّبُ",10,"ب",1,0],["إذا أحسن المدحَ امرؤ كان حُسْنُه","للابِسِه قبحاً إذا هو أقبحا",11,"ح",2,0],["إذا أحْسَنُوا جُوزُوا جَزَاءً مُضَاعَفاً","وما اقتَرَفُوا من سَيِّئٍ مُتَغَمَّدُ",12,"د",1,0],["إذا أحسَّ البَكْرُ منه جَرَسا","لَطَّ العَسِيبَ باستِه واخْرَمَّسا",13,"س",2,0],["إذا أحدقوا بي في المَكَرِّ حجزتُهم","بسورٍ من الضرب الدراك وخندقِ",14,"ق",1,1],["إذا احتضر الشحُّ النفوسَ فخالدٌ","هناك جوادُ النفس بالنفس والأهلِ",15,"ل",1,1],["إذا احترشَ الأفعى بمرجوع نفخة","دهاها بأضراس حِداد أو الْتَهَمْ",16,"م",1,0],["إِذا اِحتَضَرَ الناسُ المِياهَ نُفيتُمُ","عَنِ الماءِ حَتّى يُصبِحَ الحَوضُ خالِيا",17,"ي",2,0],["إِذا اِحتَثَّها الرُكبانُ كانَ أَلَذَّها","إِلى ذي الصِبا ذو ضِغنِها وَحَرونُها",18,"ن",3,0],["إِذا اِحتَجَبَت بَناتُ الأَرضِ عَنهُ","تَبَسَّرَ يَبتَغي فيها البِسارا",19,"ر",2,0],["إِذا أَحبابُهُ أَمسَوا عَشِيّاً","أَعَدّوا وَاِستَعَدّوا لِلبَوارِ",20,"ر",1,0],["إِذا اِحتَدَمَت أَكبادُهُم مِن صَبابَةٍ","تَضَرَّمَ مِنها في جَوانِحِهِم رَضفُ",21,"ف",1,0],["إِذا اِحتَرَبَت يَوماً فَفاضَت دِماؤُها","تَذَكَّرَتِ القُربى فَفاضَت دُموعُها",22,"ع",3,0],["إِذا اِحتَرَقَت مَآشِرُها أَشالَت","أَكارِعَ في جَواشِنِها قِصارا",23,"ر",2,0],["إِذا اِحتَلَبوا شاتَيهِما في إِنائِهِم","بَدا طَعمُ صابٍ في الإِناءِ وَعَلقَمِ",24,"م",1,0],["إذا احتازها البَعلُ الجديدُ مُعَرِّساً","أقاما على البَعلِ المُفارقِ مأتَما",25,"م",2,0],["إذا احتفلَ النَّدِيُّ فأنتَ أَرْيٌ","وإن حَمِيَ الحديدُ فأنتَ صابُ",26,"ب",1,0],["إِذا اِحتَجَبوا نَمَّت عَلَيهِم خِلالَهُم","كَذا المِسكُ يَخفى جُرمُه وَهوَ فائِحُ",27,"ح",1,0],["إِذا أَحسَنَ الأَقوامُ أَن يَتَطاوَلوا","بِلا نِعمَةٍ أَحسَنتَ أَن تَتَطَوَّلا",28,"ل",2,0],["إذا أحببْتَ نظمَ الشعرِ فاخترْ","لنظمِكَ كلَّ سهلٍ ذي امتناعِ",29,"ع",1,1],["إِذا اِحتَفَلَت عُثَيمَةُ قُلتُ شَمسٌ","وَإِن عَطِلَت عُثَيمَةُ قُلتُ ريمُ",30,"م",1,0],["إِذا أَحسَستَ في خَطِّ فُتوراً","وَحَظِّيَ وَالبَلاغَةِ وَالبَيانِ",31,"ن",1,1],["إِذا اِحتَرَقَت مَجَّت سَراباً كَأَنَّهُ","مِن المنظِرِ الأَعلى مُلاءُ الغَواسِلِ",32,"ل",1,0],["إِذا أَحبَبتَ ذا فارَقتَ هَذا","كَأَنَّ فِراقَهُ حَتمٌ عَلَيكا",33,"ك",2,0],["إِذا أَحرَقَتني الكَأسُ داوَيتُ حَرَّها","بِمَثلوجَةٍ في نَظمِ دُرٍّ مُفَلَّجِ",34,"ج",1,0],["إذا أحصيت للأجسام عمراً","فكيف تعدُ أعمار العقول",35,"ل",1,0],["إذا احتواهُ الصعيدُ ليلاً","وهيمنتْ نَسمة المساءِ",36,"ا",2,0],["إذا احترَسَ الموْتُ المُسَلّطُ مُهْجَةً","فللنّفْسِ فيها بالمَقاديرِ حارِس",37,"س",1,0],["إِذَا احْتَلَّ قَلْباً مُطْمَئِنَّاً تَحَرَّكَتْ","وَسَاوِسُهُ في الصَّدْرِ واخْتَلَّ وَكْدُهُ",38,"د",2,0],["إِذَا أَحْسَنَتْ يَوْماً أَسَاءَتْ ضُحَى غَدٍ","فَإِحْسَانُهَا سَيْفٌ عَلَى النَّاسِ جَائِرُ",39,"ر",1,0],["إِذَا أَحرَجَتْهُ فِي الشَّآمِ فَإِنَّهُ","لَيعتَاضُ مِنها بِالكِنَانَةٍ موثِلاَ",40,"ل",2,0],["إِذَا أَحْجَمْتُ وَالإِقْدَامُ حَقِّي","وَهَانَ عَلَى كرَامَتِيَ الْعَسِيرُ",41,"ر",1,0],["إذا أحل العلياء قبة ميس","ون فأدنى ديارها العوصاء",42,"ا",2,0],["إِذا أَحزَنوا تَغشَ الجِبالَ رِجالُنا","كَما اِستَوفَزَت فُدرُ الوُعولِ القَراهِبِ",43,"ب",1,0],["إِذا احرَ نَجمَ النَّادِى عليها وقُسِّمَت","ونَاحَت نَواحِيهَأ وشّبَّ وَقُودُها",44,"د",3,0],["إذا أحس شُعُوبيًّا يعارضها","في مجدها ملَكتهُ سورةُ الغضبِ",45,"ب",1,0],["إذا احيت الأبناء ذكر أبيهم","فأنت الذي أحيا له المجد والعليا",46,"ي",2,0],["إذا أحسنوا احسنت فيهم ومن أسى","جررت عليه ذيلي العفو والستر",47,"ر",1,0],["إِذا أَحَسَّ نَبأَةً ريعَ وَإِن","تَطامَنَت عَنهُ تَمادى وَلَها",48,"ا",1,0],["إذا أُحصيتُ أدواتُ الكفاةِ","فليسَ أَداتي إلاَّ دَواتي",49,"ي",1,1],["إذا احتَبَوا فالجبالُ الشمُّ راسخةٌ","وإن حَبَوا فالغمامُ الجَوْدُ مُنْسَكِبُ",50,"ب",1,0],["إذا احتثَّها الساقي الأغنّ حسبتها","نجوم الثريّا لُحْنَ في راحة البدر",51,"ر",1,0],["إذا احتبى في دَسته يَوماً فَمن","كِسرى أنو شروانُ في إيوانِهِ",52,"ن",2,0],["إِذا احْتَبى أَبُو الْمُرَجّا فِيهِمُ","فَهامُنا مائِلَةٌ عُرُوشُها",53,"ش",3,0],["إِذا اِحتَدَمَت نارُ