poetry.dctabudhabi.ae/diwan/poem/132601","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132932","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52994","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62945","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123919","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48282","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48417","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216379","المجتث"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70164","الوافر"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107047","البسيط"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95806","السريع"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141135","المتقارب"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28702","الهزج"],[4927,"رسالة الى بلال الحبشي","https://www.poetsgate.com/ViewPoem.aspx?id=4585",""],[4119,"خذوا حديث غرامي عن ضنا بدني","https://www.poetsgate.com/ViewPoem.aspx?id=16232",""],[5061,"ياوطن","https://www.poetsgate.com/ViewPoem.aspx?id=147162",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5459,"شقاق ..","https://www.poetsgate.com/ViewPoem.aspx?id=195209",""],[5670,"يا رب لا تحرمنّي الظل والحدبا","https://www.poetsgate.com/ViewPoem.aspx?id=215250",""],[5956,"جمالك بات يسقيني الهوانا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182530",""],[5956,"تخاطب حبيبها","https://www.poetsgate.com/ViewPoem.aspx?id=185180",""],[5956,"إذا احتاج الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=193858",""],[6093,"إذا أحَاطتْ بِمغرورٍ منيَّتُه","https://www.poetsgate.com/ViewPoem.aspx?id=176073",""],[6093,"ومعطاءٍ شكوتُ إليه دَيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177862",""],[6152,"إشراقة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203712",""],[463,"خاطرْ بها إما ردى أو مرادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60030&r=&rc=86",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["إِذا اِحتَمَيتُ بِهِ أَحمي عَلى كَبِدي","كَيفَ اِجتَناني إِذا أَسلَمنَني جُنَني",0,"ن",2,0],["إِذا أَحجَمَ الأَقوامُ دونَ ثَنِيَةٍ","تُجيزُ إِلى بَحبوحَةِ المَجدِ أَطلَعا",1,"ع",2,0],["إِذا اِحتَبى بِالعُشُبِ الوادي","وَاِنحَلَّ فيهِ الواكِفُ الغادي",2,"د",2,1],["إِذا احْتَضَنوا بِيضَ الصَّوارِمِ أَوْمَضَتْ","بِحُمْرِ المَنايَا وَالرُّؤوسُ غُمودُها",3,"د",3,0],["إِذا اِحمَرَّ آفاقُ السَماءِ وَأَعصَفَت","رِياحُ الشِتاءِ وَاِستَهَلَّت شُهورُها",4,"ر",3,0],["إِذا اِحتَبى لِلفَتاوى فَهوَ مالِكُها","وَإِن حَبا خَجِلَت مِن جودِهِ السُحُبُ",5,"ب",1,0],["إِذا اِحتَفَّتِ الأَعلامُ بِالآلِ وَاِلتَقَت","أَنابيبُ تَنبو بِالعُيونِ العَوارِفِ",6,"ف",1,0],["إذا احتفل الإيوان يوم مشورة","ومضطرب الآراء من كل ذي حجرِ",7,"ر",1,0],["إذا احتفلت مصر بشوقي فمالها","تُقيم على الأحرار في العلم حاجرا",8,"ر",2,0],["إذا أحصى الضعيف عليه ذنباً","أتت يمناك بالكرم الغفور",9,"ر",1,0],["إذا احتج محتجٌ على النفس لم تكد","على قَدَرٍ يُمنَى لها تتعتّبُ",10,"ب",1,0],["إذا أحسن المدحَ امرؤ كان حُسْنُه","للابِسِه قبحاً إذا هو أقبحا",11,"ح",2,0],["إذا أحْسَنُوا جُوزُوا جَزَاءً مُضَاعَفاً","وما اقتَرَفُوا من سَيِّئٍ مُتَغَمَّدُ",12,"د",1,0],["إذا أحسَّ البَكْرُ منه جَرَسا","لَطَّ العَسِيبَ باستِه واخْرَمَّسا",13,"س",2,0],["إذا أحدقوا بي في المَكَرِّ حجزتُهم","بسورٍ من الضرب الدراك وخندقِ",14,"ق",1,1],["إذا احتضر الشحُّ النفوسَ فخالدٌ","هناك جوادُ النفس بالنفس والأهلِ",15,"ل",1,1],["إذا احترشَ الأفعى بمرجوع نفخة","دهاها بأضراس حِداد أو الْتَهَمْ",16,"م",1,0],["إِذا اِحتَضَرَ الناسُ المِياهَ نُفيتُمُ","عَنِ الماءِ حَتّى يُصبِحَ الحَوضُ خالِيا",17,"ي",2,0],["إِذا اِحتَثَّها الرُكبانُ كانَ أَلَذَّها","إِلى ذي الصِبا ذو ضِغنِها وَحَرونُها",18,"ن",3,0],["إِذا اِحتَجَبَت بَناتُ الأَرضِ عَنهُ","تَبَسَّرَ يَبتَغي فيها البِسارا",19,"ر",2,0],["إِذا أَحبابُهُ أَمسَوا عَشِيّاً","أَعَدّوا وَاِستَعَدّوا لِلبَوارِ",20,"ر",1,0],["إِذا اِحتَدَمَت أَكبادُهُم مِن صَبابَةٍ","تَضَرَّمَ مِنها في جَوانِحِهِم رَضفُ",21,"ف",1,0],["إِذا اِحتَرَبَت يَوماً فَفاضَت دِماؤُها","تَذَكَّرَتِ القُربى فَفاضَت دُموعُها",22,"ع",3,0],["إِذا اِحتَرَقَت مَآشِرُها أَشالَت","أَكارِعَ في جَواشِنِها قِصارا",23,"ر",2,0],["إِذا اِحتَلَبوا شاتَيهِما في إِنائِهِم","بَدا طَعمُ صابٍ في الإِناءِ وَعَلقَمِ",24,"م",1,0],["إذا احتازها البَعلُ الجديدُ مُعَرِّساً","أقاما على البَعلِ المُفارقِ مأتَما",25,"م",2,0],["إذا احتفلَ النَّدِيُّ فأنتَ أَرْيٌ","وإن حَمِيَ الحديدُ فأنتَ صابُ",26,"ب",1,0],["إِذا اِحتَجَبوا نَمَّت عَلَيهِم خِلالَهُم","كَذا المِسكُ يَخفى جُرمُه وَهوَ فائِحُ",27,"ح",1,0],["إِذا أَحسَنَ الأَقوامُ أَن يَتَطاوَلوا","بِلا نِعمَةٍ أَحسَنتَ أَن تَتَطَوَّلا",28,"ل",2,0],["إذا أحببْتَ نظمَ الشعرِ فاخترْ","لنظمِكَ كلَّ سهلٍ ذي امتناعِ",29,"ع",1,1],["إِذا اِحتَفَلَت عُثَيمَةُ قُلتُ شَمسٌ","وَإِن عَطِلَت عُثَيمَةُ قُلتُ ريمُ",30,"م",1,0],["إِذا أَحسَستَ في خَطِّ فُتوراً","وَحَظِّيَ وَالبَلاغَةِ وَالبَيانِ",31,"ن",1,1],["إِذا اِحتَرَقَت مَجَّت سَراباً كَأَنَّهُ","مِن المنظِرِ الأَعلى مُلاءُ الغَواسِلِ",32,"ل",1,0],["إِذا أَحبَبتَ ذا فارَقتَ هَذا","كَأَنَّ فِراقَهُ حَتمٌ عَلَيكا",33,"ك",2,0],["إِذا أَحرَقَتني الكَأسُ داوَيتُ حَرَّها","بِمَثلوجَةٍ في نَظمِ دُرٍّ مُفَلَّجِ",34,"ج",1,0],["إذا أحصيت للأجسام عمراً","فكيف تعدُ أعمار العقول",35,"ل",1,0],["إذا احتواهُ الصعيدُ ليلاً","وهيمنتْ نَسمة المساءِ",36,"ا",2,0],["إذا احترَسَ الموْتُ المُسَلّطُ مُهْجَةً","فللنّفْسِ فيها بالمَقاديرِ حارِس",37,"س",1,0],["إِذَا احْتَلَّ قَلْباً مُطْمَئِنَّاً تَحَرَّكَتْ","وَسَاوِسُهُ في الصَّدْرِ واخْتَلَّ وَكْدُهُ",38,"د",2,0],["إِذَا أَحْسَنَتْ يَوْماً أَسَاءَتْ ضُحَى غَدٍ","فَإِحْسَانُهَا سَيْفٌ عَلَى النَّاسِ جَائِرُ",39,"ر",1,0],["إِذَا أَحرَجَتْهُ فِي الشَّآمِ فَإِنَّهُ","لَيعتَاضُ مِنها بِالكِنَانَةٍ موثِلاَ",40,"ل",2,0],["إِذَا أَحْجَمْتُ وَالإِقْدَامُ حَقِّي","وَهَانَ عَلَى كرَامَتِيَ الْعَسِيرُ",41,"ر",1,0],["إذا أحل العلياء قبة ميس","ون فأدنى ديارها العوصاء",42,"ا",2,0],["إِذا أَحزَنوا تَغشَ الجِبالَ رِجالُنا","كَما اِستَوفَزَت فُدرُ الوُعولِ القَراهِبِ",43,"ب",1,0],["إِذا احرَ نَجمَ النَّادِى عليها وقُسِّمَت","ونَاحَت نَواحِيهَأ وشّبَّ وَقُودُها",44,"د",3,0],["إذا أحس شُعُوبيًّا يعارضها","في مجدها ملَكتهُ سورةُ الغضبِ",45,"ب",1,0],["إذا احيت الأبناء ذكر أبيهم","فأنت الذي أحيا له المجد والعليا",46,"ي",2,0],["إذا أحسنوا احسنت فيهم ومن أسى","جررت عليه ذيلي العفو والستر",47,"ر",1,0],["إِذا أَحَسَّ نَبأَةً ريعَ وَإِن","تَطامَنَت عَنهُ تَمادى وَلَها",48,"ا",1,0],["إذا أُحصيتُ أدواتُ الكفاةِ","فليسَ أَداتي إلاَّ دَواتي",49,"ي",1,1],["إذا احتَبَوا فالجبالُ الشمُّ راسخةٌ","وإن حَبَوا فالغمامُ الجَوْدُ مُنْسَكِبُ",50,"ب",1,0],["إذا احتثَّها الساقي الأغنّ حسبتها","نجوم الثريّا لُحْنَ في راحة البدر",51,"ر",1,0],["إذا احتبى في دَسته يَوماً فَمن","كِسرى أنو شروانُ في إيوانِهِ",52,"ن",2,0],["إِذا احْتَبى أَبُو الْمُرَجّا فِيهِمُ","فَهامُنا مائِلَةٌ عُرُوشُها",53,"ش",3,0],["إِذا اِحتَدَمَت نارُ الوَغى اِقتَحموا الرَّدى","عَلى كُلِّ مَحبوكِ الفَرا شَيظَمٍ نَهدِ",54,"د",1,0],["إِذا اِحتَساها أخو سِرّ بجُنحِ دُجىً","يَكادُ يظهرُ ما تُخفي جوانحُهُ",55,"ح",2,0],["إِذا أحكم الإنسانُ ظاهرَ منصبٍ","وَباطِنَه علماً مَضى فيه عزمهُ",56,"م",2,0],["إِذا أحضَرَت تُرخي الفِحاح ملاءةً","فَتحَسُبها تَخشى مِنَ الأعيُنِ اللعطا",57,"ط",2,0],["إِذا أحيَتِ الأنواءُ أرضاً فإنّما","بِأنوائهم تحيى المكارم والفخرُ",58,"ر",1,0],["إِذا أَحنَقَت أَدرَجتُ فَضلَ زِمامِها","فَجالَ عَلَيها الضَفرُ حَولاً مِنَ الغَرضِ",59,"ض",1,0],["إِذا اِحتَكَم الهَوى العُذريُّ فينا","يُنفِّذُ مِن مواضيهنَّ حُكما",60,"م",2,0],["إِذا اِحتَفَلَ النُهى في نَهيِ وَجدي","أَبى إِلّا اِنتِهاكاً لا اِنتِهاءَ",61,"ا",2,0],["إِذا أَحيا بِمِنطِقِهِ فُؤادي","إِذابَ النَفس بِالصَد المُبيد",62,"د",1,0],["إذا أحبَبتَ أن تبقى","مصونَ الجاهِ والقَدرِ",63,"ر",1,1],["إذا أحبَبْتَ أن تحظى بِسِحرٍ","فلا تختَرْ على لَفْظي وشِعْري",64,"ي",1,1],["إذا أحدثَتْ لنفسي تَغَيُّراً","فإنِّي يَعي غَيري ولا أتغَّيرُ",65,"ر",1,0],["إذا احتاجك السُّلطان تعلم أنَّه","بذلك يمتاز المقلُّ من المثري",66,"ر",2,0],["إِذا أَحْفَتِ الفُرْسانُ غُرَّ جِيادِهِ","خَصَفْتُ بوجهي مَا تَمزَّقَ من نَعْلِي",67,"ل",2,0],["إذا احتبى كاتبُهم","قلتَ كميٌّ طعَنا",68,"ن",2,0],["إذا أحطنَ بها من كلِّ ناحيةٍ","حنَّت لهنَّ بثديٍ كلُّه حَلَمُ",69,"م",1,0],["إذا احتذت أرجلُها بالحصا","خدَّمها الإسآدُ بالعَندَمِ",70,"م",1,0],["إذا أحدُ الحِبَّين كان ممرَّضاً","فأوفى الحبيبين الذي يَتَبدّلُ",71,"ل",1,0],["إذا احتبى منشدُهنَّ خلته","يمانياً ينشِّرُ الوقائعا",72,"ع",2,0],["إذا احتبت حلقة النادي بعزِّهِمُ","نصُّوا الدسوت ومدّوا دونها السُّمُطا",73,"ط",2,0],["إذا أحسَّ فترةً","لجَّ عليها ونفَرْ",74,"ر",1,0],["إذا أحسَّ الهُونَ صاختْ به","نخوتُه أو طارَن أو قيلَ كادْ",75,"د",1,0],["إذا أحسَّ نبأةً","كشَّ لها وفحَّا",76,"ح",2,0],["إذا احتبى ينسبُ علياءه","دار عليه قُطُبُ الناسبِ",77,"ب",1,0],["إذا أحسنتُ في قولٍ أُساءُ ال","فعالَ كأنّ إحساني ذنوبُ",78,"ب",1,0],["إذا أحبّوا غايةً حَرَّموا","دون مداها أن تُحَلَّ الحُبَى",79,"ا",1,0],["إذا احتبت الغلب الرقاب وجاذبت","رادءَ العُلى والمجد أيدي المجامعِ",80,"ع",1,0],["إذا احتبوا فالجبال الشمُّ راسخةٌ","وإنْ لقوا فضواري معركٍ قُصفُ",81,"ف",1,0],["اذا احتبست خلت الرياح جرت ضحى","على قصب الآجامِ وهي زعازعُ",82,"ع",1,0],["اذا احتدمت نيرانُها في جوانحي","فَزْعتُ إِلى دمْعٍ بها مُتَحدِّرِ",83,"ر",1,0],["إذا أحْبَبْتَ فاصْبرْ للرَّزايا","فإنَّ مُقارنَ الحُبِّ البَلاءُ",84,"ا",2,1],["إِذا اِحتَجَبَ الصَديقُ عَنِ الصَديقِ","بِلا سَبَبٍ فَذاكَ مِنَ القُعوقِ",85,"ق",1,1],["إِذا أَحسَنتَ تَربِيَةً لِحَمدٍ","وَخِفتَ عَلَيهِ مِن قِصَرِ البَقاءِ",86,"ا",2,1],["إذا احتجبت مُتْنا وعِشنا إذا بدت","وإن أفرطت في الهجر قلنا لها رفقا",87,"ق",2,0],["إذا أحرزتَ مالَ الأرضِ طُرّاً","فما لَكَ فوقَ عَيْشكَ من تَراقِ",88,"ق",1,0],["إذا احتشمت لطم الخدود أكفها","فقد جعلت حزناً على الهام لطمها",89,"م",3,0],["إذا أحرقت نار الغرام جوانحي","فليس ملام اللائمين بضائرى",90,"ر",2,0],["إذا أَحْبَبْتُ أو أبغضتُ شخْصاً","فعن علمٍ به حبّي وبُغَضِي",91,"ي",1,1],["إِذا احْترثَ الناسُ ما يَجْمعون","فإِنَّ الجِياد يَكُنَّ احْتِرَاثِي",92,"ث",2,0],["إِذا أُحْضِرَت الشطرن","جُ فالويلُ لمن يَحْضُر",93,"ر",1,0],["إذا احتاج َالظلام ُإلى نهَارٍ","لهُم بَابٌ أقِيم َلكيْ يُدَ