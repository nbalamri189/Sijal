{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[32,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[466,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[541,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122563","البسيط"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[1674,"","https://poetry.dctabudhabi.ae/diwan/poem/145598","البسيط"],[5005,"على عتبة العمر..","https://www.poetsgate.com/ViewPoem.aspx?id=202133",""]],"verses":[["يَعسِفونَ الذُرى وَيَع","تَسِفونَ المَوامِيا",0,"ي",2,0],["يَعسِفنَ وَاللَيلُ بِها مُعَسكَرُ","مَهامِهاً جِنّانُهُنَّ سُمَّرُ",1,"ر",1,0],["يَعسِفُ البيدَ بِها سَمحَجٌ","مُكرَبُ الرُسغِ مُبِرُّ الكِدام",2,"م",1,0],["يعسعس في ليلٍ من الود مبهمٍ","ولم تره يبدو لو جشر الصبح",3,"ح",1,0],["يعسلُ الذِّئبُ إلى معركهِ","شايمَ الأرزاقِ عند الثعلبِ",4,"ب",1,0],["يَعسِفنَ عَرضَ الثَنايا بَعدَ أَطوُلِها","وَكُلَّ سَهبٍ دُقاقِ التُربِ مَوّارِ",5,"ر",1,0],["يَعسِلنَ في المشي أعطافاً كما عسَلَت","فوقَ الفَوارِسِ بالرّاياتِ أرماح",6,"ح",1,0],["يعسف الصعبة رائضها","ولها بالعسف تدليل",7,"ل",1,0],["يعسى بها مرهف كالغصن نعمه","ماء النعيم عليه النور والورق",8,"ق",1,0],["يعسعسُ الليلُ مصحوباً بأدمعه","في مقلتيكَ وضوءُ الصبحِ منكسرُ",9,"ر",1,0]]}