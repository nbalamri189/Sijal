{"poems":[[85,"يا خير من ملك الملوك بجوده","https://www.aldiwan.net/poem54266.html","الكامل"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[47,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[104,"ليت لي من جماعة السار قوما","https://www.aldiwan.net/poem32968.html","الخفيف"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[47,"إنّما الغَيّ أنْ يكونَ رَشيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31696",""],[113,"غب استلام مواطيء الأستاذ","https://www.aldiwan.net/poem16255.html","الكامل"],[371,"أي شأن لا يباح به","https://www.aldiwan.net/poem17294.html","المديد"],[406,"تشكو الفتاوى","https://www.aldiwan.net/poem6741.html","عموديه"],[469,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[505,"أطلق الصب في الهوى تقييده","https://www.aldiwan.net/poem37687.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48642","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62469","الكامل"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101338","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128275","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64634","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48273","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67997","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117242","الكامل"],[4755,"مطر القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=200000",""],[4830,"سُهادُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=210983",""],[1901,"أرهقْتنا الأيامُ بسطاً وقبضاً","https://www.poetsgate.com/ViewPoem.aspx?id=160385",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5376,"لا تأمنن من الشيوخ فإنهم","https://www.poetsgate.com/ViewPoem.aspx?id=202163",""],[5408,"دمعة حزن","https://www.poetsgate.com/ViewPoem.aspx?id=190864",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5770,"سأزف للموتى بشارة","https://www.poetsgate.com/ViewPoem.aspx?id=178250",""],[5956,"يتدفق اليخضور","https://www.poetsgate.com/ViewPoem.aspx?id=182038",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[6102,"غَنِيمَةُ العُمر !!","https://www.poetsgate.com/ViewPoem.aspx?id=184543",""]],"verses":[["يتدارسون من الدعاء صحائفاً","كيما يطيلُ الله في بُقياكا",0,"ك",2,0],["يَتَداوى مِن كَثرَةِ المالِ بِالإِق","لالِ جوداً كَأَنَّ مالاً سَقامُ",1,"م",1,0],["يَتَدافَعنَ بِالأَكُفِّ وَيَعرِض","نَ عَنلَيا عَوارِضاً وَخُدودا",2,"د",2,0],["يَتَدَنّى رَبابُهُ حينَ يَنأى","مُستَقِلّاً عَلى العُيونِ نَشاصُه",3,"ص",2,0],["يتداعى إذا تسلَّط وعدٌ","أو وعيد عليه عند العودي",4,"د",2,0],["يتدلَّلون على الزمان كما اشتَهت","شهواتُها قُبُّ البطون وِحام",5,"م",1,0],["يَتَدافَعْنَ بالأكُفّ وَيَعْرِضْ","نَ عَلَيْنَا عَوَارِضاً وَخُدُودَا",6,"د",2,0],["يَتَدفَق السحر الحَلال مموّهاً","مِن أَسطُر كَالصارم الهَذاذ",7,"ذ",1,0],["يَتَداعى إِذ دَعَوتَ بِهِ","حينَ يَلقى الشِركَ أَوثانُ",8,"ن",1,0],["يتدافعون سؤالها وجوابه","ورعاً, ولا يستسهلون وبالها",9,"ل",3,0],["يتدفقون إذا الجذوب تلاحقت","كالسيل زل عن اليفاع العالي",10,"ل",2,0],["يتداعى متيَّماً عن ترائ","لأولى الركب برق أم عبيده",11,"د",2,0],["يتداولون الحكم غير منفذٍ","من كثرة التغيير والإبدال",12,"ل",1,0],["يتداركون الشاعر المطبوع من","أغلاله والمخلصَ المجبولا",13,"ل",2,0],["يتداركون تخلّصاً والموت بَيْ","نَ عيونهم هلاّ ارعَوَوْا زمنَ المهلْ",14,"ل",1,0],["يتدافعون إلى الوغى","فكأنهم سيل البطاح",15,"ح",1,0],["يتَدلى من الغصون علينا","مائسات وَالنبت زان ترابه",16,"ب",2,0],["يتدبرون بكل معنى حكمة","وبكل رأي يرتئيه دليلا",17,"ل",2,0],["يتدانى من الفضيلة طبعاً","وإلى الطبع ترجع الأشياء",18,"ا",2,0],["يتدارسُ الملأُ المقدَّسُ عنده","حِكماً بَهرنَ من الورى عرَّافَها",19,"ف",3,0],["يتداوى برقى أحلامكم","مَن بأفعى رزئه قد لُسعا",20,"ع",2,0],["يتدفى كل عالم بشؤون","مقتضى سر كونه أبداها",21,"ا",3,0],["يتدافعْنَ بالأكفِّ ويعرضْ","نَ وجوهاً لهنَّ ضوءٌ سَنيُّ",22,"ي",1,0],["يَتدافعن في هَوادج تَزهو","بِالتصاوير تَشبه الطاووسا",23,"س",2,0],["يتدرعن بالحديد ويقذفن","بنار بها الحديد يلين",24,"ن",1,0],["يَتدانَى منك شوقاً","يمش بالدَّلِّ اضطرابا",25,"ب",2,0],["يَتَداوَلُونَ بِقَولِهِم لِلّهِ كَم","قد حازَ أُوذِسُ من جَلِيلِ مَزِية",26,"ه",1,0],["يتدللون عليك في خلواتهم","متنعمين بروضة الإقبال",27,"ل",1,0],["يَتَدَافَعُونَ.. ولِلخُطُورَةِ حَولَهُم","شُهُبٌ مُذَنَّبَةٌ, ورِيحٌ صَرصَرُ",28,"ر",1,0],["يتدانى الطيفُ لناظرتي","وسُهادُ الشوقِ يُبَعِّدُهُ",29,"د",2,0],["يتداعَى لسقمها كلُ جسمٍ","وتَرضُّ القلوبَ باللحظِ رَضّا",30,"ض",2,0],["يتدافعون بلحمِهم وعظامِهم","للقدسِ أقصى والردى مطلوبُ",31,"ب",1,0],["يتدافعون بكل أمر خيسة","كي يجعلوا وجه القبيح جميلا",32,"ل",2,0],["يتدافعون على جناح حنينهم","ولهم محاريبُ العيونِ ستدمَعُ",33,"ع",1,0],["يتدبرون بكل معنى حجة","وبكل رأيٍ يرتأيه دليلا",34,"ل",2,0],["يتدافعون كأنما قُرعت طبولٌ للإغارة","يتزاحمون وليس يثنيهم شواظٌ أو حرارة",35,"ر",2,0],["يتدفق اليخضورُ منك فأنتشي","بجمال يخضور يُحِق مشيئتي",36,"ت",2,1],["يَتَدَلَّى مُلاعِبًا نَسَماتٍ","خَطَرَتْ بَينَ هَمهَماتِ الوادِي !",37,"د",2,0],["يَتَدَحرَجُ \" الدِّبشِيُّ \" فَوقَ مَثِيلِهِ","وَعَلَى سِوَى \" الدِّبشِيِّ \" لا يَتَدَحرَجُ",38,"ج",1,0]]}