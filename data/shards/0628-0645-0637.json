{"poems":[[55,"وفى ذا السرور بتلك الكرب","https://www.aldiwan.net/poem30751.html","المتقارب"],[73,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[45,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[47,"يا برق أفرط في اعتلائك","https://www.aldiwan.net/poem10204.html","مجزوء الكامل"],[30,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[63,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[63,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[47,"يا بَرْقُ أفرِطْ في اعْتِلائِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=32832",""],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[280,"كفاني الحر منتجع الغمام","https://www.aldiwan.net/poem25530.html","الوافر"],[280,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[445,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[466,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[466,"يفر الخطب قد أمهي شباه","https://www.aldiwan.net/poem16107.html","الوافر"],[519,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66687","الكامل"],[824,"","https://poetry.dctabudhabi.ae/diwan/poem/29485","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38366","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59781","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119886","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25323","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49936","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108597","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123051","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28516","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88654","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100211","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89025","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216494","المجتث"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86497","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119617","الكامل"],[4918,"عطني قربك بالحلال","https://www.poetsgate.com/ViewPoem.aspx?id=32378",""]],"verses":[["بِمَطرورَةِ الصَدرِ خَفّاقَةٍ","تَطيرُ مَجاذيفُها كَالعَذَب",0,"ب",1,0],["بِمطهَّمٍ نَهدٍ كَأَنَّ مُرورَهُ","سَيلٌ تَدافَعَ مِن مُتونِ تِلاعِ",1,"ع",1,0],["بِمُطَّرِدٍ جَلسٍ عَلَتهُ طَريقَةٌ","لِسَمكِ عِظامٍ عُرِّضَت لَم تُنَصَّبِ",2,"ب",1,0],["بِمُطَّرِدِ الآذِيِّ جَونٍ كَأَنَّما","زَفى بِالقَراقيرِ النَعامَ المُطَرَّدا",3,"د",2,0],["بِمُطلِقِ اليُمنى طَويلِ الفائِقِ","عَبلِ الشَوى مُقارِبِ المَرافِقِ",4,"ق",1,0],["بِمِطالِهِ إِنّي أَعُد","دُ مِطالَهُ مِن غَيرِ رائِك",5,"ك",1,0],["بِمُطَّلِعِ الرِهانِ إِذا تَراخى","لَهُ أَمَدٌ أَلَحَّ بِهِ وَثابا",6,"ب",2,0],["بمُطمِعاتٍ حُصَّنَتْ ديارُها","نِجارُ خَطيِّ القَنا نِجارُها",7,"ر",3,0],["بمُطوَّقٍ طوْقَ المحامدِ ساحبٍ","بُرْدَ المكارمِ بالثَّناءِ مُسَوَّرِ",8,"ر",1,0],["بِمِطَالِهِ، إنّي أعُدُّ","مِطَالَهُ عَنْ غَيرِ رَائِكْ",9,"ك",1,0],["بمطالعها ثمّ البرجِ","وبكلّ الرسل وصحبهم",10,"م",1,0],["بِمَطْلَعِهِ تَجَلَّتْ كُلُّ جُلَّى","كَنورِ الصُّبْحِ يَذْهَبُ بالظَّلامِ",11,"م",1,0],["بِمَطْلَعِ يَحيى غار كلُّ مخالِف","ومِنْهُ اسْتماح السّلمَ كلُّ مُحارِبِ",12,"ب",1,0],["بمطايا مثْلِ الحنايا لها الرَّكْ","بُ سهامٌ قد سُدّدَتْ للمَضاء",13,"ا",2,0],["بمَطْعَمِ سَلْمٍ لا يُمَلُّ مَساغُهُ","ومَطْعَمِ حَرب لا يُساغُ مرَارُهُ",14,"ر",2,0],["بمُطاردِ الأيام في آمالهِ","كَطِرادِه في مأزقِ الهَيْجاءِ",15,"ا",2,0],["بمِطْعانٍ إذا ذَلَّ المُحامي","ومِطْعامٍ إذا خَوَتِ النُّجومُ",16,"م",1,0],["بمطهَّمٍ مثلِ الظّليمِ إذا","ما شدّ قُلْتُ بأنّهُ صَقْرُ",17,"ر",1,0],["بِمَطِيٍّ لا يُبالي","نَ عَلى الأَيْنِ الدُّؤوبا",18,"ب",2,0],["بمطهَّرٍ لِمطهّرين أبوّةً","نالوا العُلى ومكارماً لم تَنْفَدِ",19,"د",1,0],["بِمِطعامٍ إِذا الأَشوالُ راحَت","إِلى الحُجُراتِ لَيسَ لَها فَصيلُ",20,"ل",1,0],["بِمَطلَعِ مَجدٍ في ذُرى العِزِّ وَالعُلى","مِنَ الشّرفِ الأَعلى بِأَسمى المَراتِبِ",21,"ب",1,0],["بمطاول الكف الخضيب ترفعاً","يذر الثواقبَ في الحضيض الأوهد",22,"د",1,0],["بمطهر الإراس مرهوب الطسا","والبأس ضرار اليدين تفوعِ",23,"ع",1,0],["بِمَطَرٍ لَيْسَ بِثَلْجٍ صَرْدِ","وَقُلْتُ عَمْداً قاصِداً لِعَمْدِي",24,"د",2,0],["بمطَوقٍ ومنطّقٍ ومُوَشَّح","ومُخَلْخَل ومُسَوّرَ ومُدمَلجِ",25,"ج",1,0],["بمطهَّم قيد الأوا","بد فوقه عبل السواعد",26,"د",1,0],["بمُطلق الجود كم قيّدت من مُهَج","فلا طوى الدهر من نُعماك ما انتشرا",27,"ر",2,0],["بِمَطروفَةِ الأَجفانِ عائِرَةِ القَذى","تَقودُ زِمامَ النَّجمِ وَهوَ حَسيرُ",28,"ر",1,0],["بمطاف املاك السماء وحسبها","فخراً ان أعتبرت هناك مزارها",29,"ر",3,0],["بمطايا كأنهن حنايا","ترتعي جمرة الهجير سغوبا",30,"ب",2,0],["بمطرب لفظه إن قال قلنا","سماعاً للموشّح بالسماح",31,"ح",1,0],["بمطلب إن عداها","ترتد وهي جحيم",32,"م",1,0],["بمطارف للزهر قد نشرت","تكسو ربى نجد وأبطحها",33,"ح",3,0],["بمطّهم مثل الظليم فلم","يُعرَف لديه النهم والرَّكل",34,"ل",1,0],["بمطر أيامك سعاده وبفرش ألحافك دلال","وبحنان الغيد قلبي راح آلمك واحتويك",35,"ك",1,0]]}