{"poems":[[55,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[54,"قل لغصن البان الذي يتثنى","https://www.aldiwan.net/poem27333.html","الخفيف"],[54,"قل لغصن البنِ الذي يتثنى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14635&r=&rc=4",""],[415,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[505,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58527","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73322","الخفيف"],[4830,"قُلْ لِغزالٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215202",""]],"verses":[["قُل لِغَريمي بِدُيونِ الهَوى","يا حَبَّذا مِنكَ مِطالُ الغَريم",0,"م",1,0],["قل لغرابِ البين تبّاً لهُ","إذا تعاطى القولَ في مَذهبِ",1,"ب",1,0],["قُل لِغُصنِ البانِ الَّذي يَتَثَنّى","تَحتَ بَدرِ الدُجى وَفَوقَ النَقاء",2,"ا",2,1],["قل لغصن البنِ الذي يتثنى ،","تحتَ بدرِ الدّجى ، وفوْق النقاءْ",3,"ا",2,1],["قُل لِغيثِي الهتونِ في أزمةِ المح","لِ وغَوثِي إن أرهَقَتْنِي الخطُوبُ",4,"ب",1,0],["قلْ لغزلانٍ بِقِيعانِ النَّقا","أَجْهَدوا السَّيْرَ وعزَّ المُلْتَقى",5,"ق",2,1],["قل لِغُصنِ الأَراكِ وَيْحَكَ تحكي","قدَّ مَحْبوبَتي ولم تخشَ مِنِّي",6,"ي",1,1],["قُل لِغَرسِ الدِّينِ الأَميرِ الُمرَجَّى","وَالذي ما لِمَجدِهِ مِن مِثَالِ",7,"ل",1,1],["قُلْ لِغَزالٍ بعدَ وصلٍ جَفا","يأملُ منكَ الصّبُّ أنْ تَنصِفا",8,"ف",2,1],["قُلْ لغزالٍ قد تناءى الكرى","مُوَدِّعاً طَرْفاً دَمَاً أذرَفا",8,"ف",2,0]]}