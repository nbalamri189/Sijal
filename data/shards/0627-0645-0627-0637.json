{"poems":[[65,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[53,"ولما رأيت البين قد جد جده","https://www.aldiwan.net/poem66697.html","الطويل"],[91,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[47,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[42,"رأتني خضيب الرأس شمرت مئزري","https://www.aldiwan.net/poem42314.html","البسيط"],[50,"قل للعروضي عبد","https://www.aldiwan.net/poem66566.html","المجتث"],[48,"قد حاطت الزوج حرة سألت","https://www.aldiwan.net/poem22217.html","المنسرح"],[79,"أشارت غداة البين من خلل السجف","https://www.poetsgate.com/ViewPoem.aspx?id=34201",""],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[234,"شكوت إليها لا شكوت صبابتي","https://www.aldiwan.net/poem50726.html","الطويل"],[240,"أماطت لثاما وأبدت هلالا","https://www.aldiwan.net/poem31610.html","المتقارب"],[240,"يا من له قدم في الفضل راسخة","https://www.aldiwan.net/poem31827.html","البسيط"],[254,"أي المنازل بعد الحي تعترف","https://www.aldiwan.net/poem2106.html","البسيط"],[275,"لطلعة حسنها انهزم الإياس","https://www.aldiwan.net/poem35348.html","الوافر"],[303,"ألا كل مجد عرضة للتهدم","https://www.aldiwan.net/poem36812.html","عموديه"],[333,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[412,"أرى منك وجه الصد لا يتغير","https://www.aldiwan.net/poem50160.html","الطويل"],[435,"أراك سخي الدمع طال بك الأمر","https://www.aldiwan.net/poem41064.html","الطويل"],[469,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[487,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[563,"إلي الذات سيري في مراتب أسماء","https://www.aldiwan.net/poem33559.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83315","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122614","الطويل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101202","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59258","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56284","الكامل"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146944","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49915","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49600","المتقارب"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104465","السريع"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48228","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96028","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102507","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141224","المتقارب"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107027","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74212","الطويل"],[3135,"","https://poetry.dctabudhabi.ae/diwan/poem/105698","المتقارب"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99311","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59464","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105144","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123511","الطويل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22083","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115312","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35451","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101938","الطويل"],[4684,"يغتالنا خببا","https://www.poetsgate.com/ViewPoem.aspx?id=201573",""],[4815,"إربد في زمن الكورونا (الأقحوانة)","https://www.poetsgate.com/ViewPoem.aspx?id=211062",""],[4847,"قل هو الحب وطن","https://www.poetsgate.com/ViewPoem.aspx?id=175537",""],[4927,"سِفرُ الْغَرَاْم","https://www.poetsgate.com/ViewPoem.aspx?id=29829",""],[5038,"روض الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=195236",""],[5121,"بُلْبُلٌ وَلَكِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=33586",""],[5279,"المصيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=183492",""],[5362,"أماطت في الدجى عنها الخمارا","https://www.poetsgate.com/ViewPoem.aspx?id=170385",""],[333,"هجرة وميثاق","https://www.poetsgate.com/ViewPoem.aspx?id=98235",""],[5431,"لوحة الحرب غرنيكا-وعذاب السوريين","https://www.poetsgate.com/ViewPoem.aspx?id=192961",""],[5493,". أماط الصبح أستار الدياجي .","https://www.poetsgate.com/ViewPoem.aspx?id=197566",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5704,"السلام عليك ايها القمر٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=202946",""],[5790,"لولا قوامك والأعطاف والهيف","https://www.poetsgate.com/ViewPoem.aspx?id=112078",""],[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[5956,"طباعي لم تُرض طباع أبي رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=192148",""],[6156,"أَمَاطَتْ لِثَاماً عَنْ أَقَاحِي الدَّمَائِثِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17593&r=&rc=9",""]],"verses":[["أماطَ والليلُ أثيثُ الجَناحْ","عنْ مَبْسِمِ الشّمْسِ لِثامَ الصّباحْ",0,"ح",1,1],["أماطَتْ عن الخَدِّ اللّئَامَ فأطْلَعَتْ","هِلالاً علَى غُصْنٍ وغُصْناً علَى حِقْفِ",1,"ف",1,0],["أَماطَ عَنِ الأَعرابِ ذُلُّ إِتاوَةٍ","تَساوى البَوادي عِندَها وَالحَواضِرُ",2,"ر",1,0],["أماطتْ رداء الخزِّ عن حُرِّ وجهِها","ولم تخشَ من داياتها والحواضن",3,"ن",1,0],["اما طريق العز فهو","لمن يسير عليه وعر",4,"ر",1,0],["أَماطَ حِمى الإِسلامِ مِن كُلِّ شُبهَةٍ","وَقامَ بِعَدلٍ واضِحٍ غَيرِ مُشكِلِ",5,"ل",1,0],["أماطَ عَنِ العَذْبِ اللِّثامِ لِثامَه","فعادَ بديباجِ الحَياء مُلَثَّما",6,"م",2,0],["أَماطَت كِساءَ الخَزِّعَن حُرِّ وَجهِها","وَأَدنَت عَلى الخَدَّينِ بُرداً مُهَلهَلا",7,"ل",2,0],["أما طلتم جميعاً","إلى أبي عثمانِ",8,"ن",1,0],["أَماطَتِ السوءَ عَن ضَمائِرِها","فَلاقَت الخَيرَ في إِماطَتِها",9,"ت",3,0],["أماطت عن الخد اللثام فأطلعت","هلالا على غصن وغصنا على حقف",10,"ف",1,0],["أَماطَت لِثاماً عَن أَقاحِ الدَمائِثِ","بِمِثلِ أَساريعِ الحُقوفِ العَثاعِثِ",11,"ث",1,1],["أَماطتْ عنِ الخدَّيْنِ فضلَ قِناعِها","وقالت أَنِسياناً لنا أم تَناسيَا",12,"ي",2,0],["أَماطَت لِثاماً وَأَبدَت هِلالاً","وَراشَت نِبالاً وَسَلَّت نِصالا",13,"ل",2,1],["أَماطَ عَنّي الأَذى شِعرٌ بَعَثتَ بِهِ","مُنَقَّحاً كُلُّ بَيتٍ مِنهُ مَصنوعُ",14,"ع",1,0],["أَمّا طُفَيلٌ فَنَجّاهُ أُخو ثِقَةٍ","مِن آلِ أَعوَجَ يَعدو وَهوَ مُشتَرِفُ",15,"ف",1,0],["أماطت عن محيّاها نقاباً","وقلبي فيه للحبّ انبجاس",16,"س",1,0],["أَماطوا الأَذى عنهمْ بحدِّ سيوفِهم","وَلم تنطلِ الأوهامُ يوماً عليهمِ",17,"م",1,0],["أم أطيل السجود في معبد الل","ل وحيدا فتشرقي من جديد",18,"د",1,0],["أَماطَت يَداهُ الفَقر بِالجودِ وَالنَدى","وَقارَنه في النَيل من كان يَقتُرُ",19,"ر",1,0],["أماطت عن الوجه المنير لثامه","فاشرق منه البدر اذ بسم الثغر",20,"ر",1,0],["أماط لثاماً فاجتلِ القمر الأدنى","وألقى وشاحا فاجتنٍ الغصنَ اللّدنا",21,"ن",2,1],["أما طت عن محيا القطر سترا","فيا للّه ما تحت الستار",22,"ر",1,0],["أماط الستر عن وجه الغمام","فتيمني بكحل منه خال",23,"ل",1,0],["أماطت وكنا بالعشي لثامَها","فأصبحت الأنوار تشرق للرائي",24,"ا",2,0],["أَماطوا قِناعَ المَكرُماتِ وَقَد جَلوا","مُحَيّا المَعالي بَعدَ أَن كانَ اِسحَما",25,"م",2,0],["أماطَ ملوكَ الدَّولَتين فَطحطَحَت","مَفاخِرَ أهلِ الدولتينِ مَفاخِرُه",26,"ر",2,0],["أماطت جنا فكري وشقت فم الثنا","وداست على أنف العدى فبدت حسرا",27,"ر",2,0],["أماط جهل أبي جهل بمجهلة","أرخت لعتبة فيها سجف عتباه",28,"ا",2,0],["أماط الهوى عن واضحي برقعَ الشِّركِ","فوحّدتُ من أهواه عن هوّة الشركِ",29,"ك",1,1],["أماط جهل أبي جهل لمجهلة","قد عاقبت عقبة لما بغي وجفا",30,"ف",2,0],["أماط جهل أبي جهل بمجهلة","قد شيبت شبيه إذ أرضع النقما",31,"م",2,0],["أما طريق ذوي النفاق فإنها","تفنى إلى دهر الدهور وتندثرْ",32,"ر",1,0],["أماطت عن الشمس المنيرة برقعاً","فغيبنا عن أعين الناس نورها",33,"ه",2,0],["أما طرفك المستَطرف الحُبّ مُقصرُ","ولا مُستقِر قلبُكَ المتقلّبُ",34,"ب",1,0],["أما طَيَشتْ لُبَّهُ نَظْرةٌ","على خطّة كلّما اشتدَّ لانا",35,"ن",2,0],["أماط لما أن بدا عن سناً","غرته ذاك الحجاب المذال",36,"ل",1,0],["أماطت نقابَ الخَزِّ عنِ وجهِها الأسْنى","فتاةٌ تُضَاهي الشمسَ بالفخرِ أو أسْنى",37,"ن",2,1],["أما طلل يا سعد هذا فتسئل","نزالي فهذي الدار إن كنت تنزل",38,"ل",1,1],["أماطت لنا ذات الخمار خمارها","فهامت بها أرواحنا قبل خمرها",39,"ر",3,1],["أَمَّا طريقُ يا أخي الباحَه","مِن حدِّ سيبانٍ بها السَّمَاحَه",40,"ه",1,0],["أماطت بذات الخمار الخمارا","وصيرت الليل منها النهارا",41,"ر",2,1],["أماط الدجى عن صبح طلعته الغرا","فنادى الحي حي على المسرى",42,"ر",2,1],["أَماط عنهم بحق كل ذي حُجُب","وَزادَ في نَشب بالجود من سحب",43,"ب",1,0],["أَماطَ ثِياب النَوم عَن جسم ناظِري","كَأَني بِميقات الصَبابة محرم",44,"م",1,0],["أماط الظلام بأنواره","ضفقل في بيان أماط الظلم",45,"م",1,0],["أما طلاب المعالي فاستهين به","وأكرمت بعده الاوراق والذهب",46,"ب",1,1],["أماطَ عنا حُبى الأَوزارِ حينَ حَبا","رجاءَ خيرِ الحِبا للقانطِ اليَؤُسِ",47,"س",1,0],["أماطتْ قناعاً لو أماطتهُ قَبلها","على البدر ما انفكَّ الخسوفُ من البدرِ",48,"ر",1,0],["أَماطَت نِقاباً لَطِيفاً عَلَيها","بَدِيعَ المَحاسنِ صُنعَ يَدَيها",49,"ه",2,0],["أَمّا طَبيبانا فَفوذاليرُ","ما بَينَ دُرّاعِ العِدى مَحصورُ",50,"ر",1,0],["أماطت عن بياض الجيد جعداً","فلاح من الصباح سنا عمود",51,"د",1,0],["أماط العنا عنا بشرع هو الغنى","لمتبعيه اذ به محى القحط",52,"ط",1,0],["أَماطَت كِساءَ الخَزِّ عَن حُرِّ وَجهِها","وَأَرخَت عَلى المتنَينِ بُرداً مُهَلهَلا",53,"ل",2,1],["إما طواكَ سُلُوُّ غانيةٍ","فهواكَ لا مَللٌ ولا فَنَدُ",54,"د",1,0],["أَماطَت عَن مَحاسِنِها الخِمارا","فَغادَرَتِ العُقولَ بِها حيارى",55,"ر",2,1],["أماط الله حجبَ العلم عنهم","فبان وضوحه بعد الخفاء",56,"ا",2,0],["أماط حجاب الريب عن كل مشكل","بأحسن رأي مستقيم مسدد",57,"د",1,0],["أمّا طراْبلْسُ فانْهارتْ مودعةً","إشراقة الثَّغْر والإصباحَ والشَّنَبَا",58,"ب",2,0],["أماطُوا لثامَاً بوجهِ اللئامْ","وَ شدّوا رِحالاً بركبِ المَنيَّهْ",59,"ي",2,0],["إِمَّا طَلَبتُكَ كَأسَ الحُبِّ تُوكِلَنِي","إِلَى حَبِيبِكَ فَالمَطلُوبُ مَيسُورُ",60,"ر",1,0],["أَمَاْطَتْ حِجَاْباً، فَبَاْنَ الْهِلاْلُ","وَأَرْسَلَ بِالنُّوْرِ نَحْوِيْ سَفِيْرَاْ",61,"ر",2,0],["أَما طافَ سُؤْلُ الْوالِهينَ بِروعِهِ","إِذا لَمْ يُذَكّرْهُ اللِّقاءُ الْقَديمُ",62,"م",1,0],["أَمَا طِرْتَ مِثْلِي مِن رُبُوعٍ تَعِيِشُهَا ؟","نُفُوسٌ تُعَانِي مِنْ خُمُولٍ بِلاَ حَدْسِ ؟!",63,"س",1,0],["أَمَّا طَيْرِي غَابَ عَنِّي رَغْمَ جُرْحِي","يَا سَمَائِي سَاعِدِينِي كَيْ أَصِيرْ",64,"ر",1,0],["أماطت في الدجى عنها الخمارا","فباهى الليل بالضوء النهارا",65,"ر",2,1],["أم أطيل السجود في معبد اللي","لِ وحيداً فتشرقي من جديدِ",66,"د",1,0],["أم أُطبقَ الأفقُ البهيُ فلم تعدْ","عيناك يُمتعها الجمالُ الرافلُ",67,"ل",1,0],["\"أماطَ الصّبحُ أستارَ الدَّياجِي","وَأعلنَ للورَى فجرَ انبلاجِي",68,"ج",2,1],["أَمَا طِرْتُ فِي أُفْقِ فِكْرِي أَمَا","سَمَوْتُ سَما غايَةٍ لَنْ تُسامَى",69,"م",2,0],["أماطته وجاءتني وقال:","أبي ذا بعد طول البين أبا",70,"ب",2,0],["أماط اللثام ورد السلاما","فتهنا غراما بمن قد أتانا",71,"ن",2,0],["أماط ذاك الدجى في صبح غرته","وعاد في الليل والواشون ما عرفوا",72,"ف",3,0],["أما طوّرَ الفنانُ حتى أداءَهُ","من الناي للجيتار ثم تَقَدَّما؟",73,"م",2,0],["أمّا طباعك لا تُرضي طباع أبٍ","مهما يوجّهْكَ يمكثْ منك معتلجا",74,"ج",2,1],["أَمَاطَتْ لِثَاماً عَنْ أَقَاحِي الدَّمَائِثِ","بِمِثْلِ أَسَارِيعِ الحُقُوفِ العَثَاعِثِ",75,"ث",1,1]]}