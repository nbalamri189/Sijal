{"poems":[[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"ولما رأيت البين قد جد جده","https://www.aldiwan.net/poem66697.html","الطويل"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[40,"رأتني خضيب الرأس شمرت مئزري","https://www.aldiwan.net/poem42314.html","البسيط"],[48,"قل للعروضي عبد","https://www.aldiwan.net/poem66566.html","المجتث"],[46,"قد حاطت الزوج حرة سألت","https://www.aldiwan.net/poem22217.html","المنسرح"],[77,"أشارت غداة البين من خلل السجف","https://www.poetsgate.com/ViewPoem.aspx?id=34201",""],[164,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[229,"شكوت إليها لا شكوت صبابتي","https://www.aldiwan.net/poem50726.html","الطويل"],[235,"أماطت لثاما وأبدت هلالا","https://www.aldiwan.net/poem31610.html","المتقارب"],[235,"يا من له قدم في الفضل راسخة","https://www.aldiwan.net/poem31827.html","البسيط"],[249,"أي المنازل بعد الحي تعترف","https://www.aldiwan.net/poem2106.html","البسيط"],[270,"لطلعة حسنها انهزم الإياس","https://www.aldiwan.net/poem35348.html","الوافر"],[298,"ألا كل مجد عرضة للتهدم","https://www.aldiwan.net/poem36812.html","عموديه"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[406,"أرى منك وجه الصد لا يتغير","https://www.aldiwan.net/poem50160.html","الطويل"],[429,"أراك سخي الدمع طال بك الأمر","https://www.aldiwan.net/poem41064.html","الطويل"],[464,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[479,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[482,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[558,"إلي الذات سيري في مراتب أسماء","https://www.aldiwan.net/poem33559.html","الطويل"]],"verses":[["أماطَ والليلُ أثيثُ الجَناحْ","عنْ مَبْسِمِ الشّمْسِ لِثامَ الصّباحْ",0,"ح",1,1],["أماطَتْ عن الخَدِّ اللّئَامَ فأطْلَعَتْ","هِلالاً علَى غُصْنٍ وغُصْناً علَى حِقْفِ",1,"ف",1,0],["أَماطَ عَنِ الأَعرابِ ذُلُّ إِتاوَةٍ","تَساوى البَوادي عِندَها وَالحَواضِرُ",2,"ر",1,0],["أماطتْ رداء الخزِّ عن حُرِّ وجهِها","ولم تخشَ من داياتها والحواضن",3,"ن",1,0],["اما طريق العز فهو","لمن يسير عليه وعر",4,"ر",1,0],["أَماطَ حِمى الإِسلامِ مِن كُلِّ شُبهَةٍ","وَقامَ بِعَدلٍ واضِحٍ غَيرِ مُشكِلِ",5,"ل",1,0],["أماطَ عَنِ العَذْبِ اللِّثامِ لِثامَه","فعادَ بديباجِ الحَياء مُلَثَّما",6,"م",2,0],["أَماطَت كِساءَ الخَزِّعَن حُرِّ وَجهِها","وَأَدنَت عَلى الخَدَّينِ بُرداً مُهَلهَلا",7,"ل",2,0],["أما طلتم جميعاً","إلى أبي عثمانِ",8,"ن",1,0],["أَماطَتِ السوءَ عَن ضَمائِرِها","فَلاقَت الخَيرَ في إِماطَتِها",9,"ت",3,0],["أماطت عن الخد اللثام فأطلعت","هلالا على غصن وغصنا على حقف",10,"ف",1,0],["أَماطَت لِثاماً عَن أَقاحِ الدَمائِثِ","بِمِثلِ أَساريعِ الحُقوفِ العَثاعِثِ",11,"ث",1,1],["أَماطتْ عنِ الخدَّيْنِ فضلَ قِناعِها","وقالت أَنِسياناً لنا أم تَناسيَا",12,"ي",2,0],["أَماطَت لِثاماً وَأَبدَت هِلالاً","وَراشَت نِبالاً وَسَلَّت نِصالا",13,"ل",2,1],["أَماطَ عَنّي الأَذى شِعرٌ بَعَثتَ بِهِ","مُنَقَّحاً كُلُّ بَيتٍ مِنهُ مَصنوعُ",14,"ع",1,0],["أَمّا طُفَيلٌ فَنَجّاهُ أُخو ثِقَةٍ","مِن آلِ أَعوَجَ يَعدو وَهوَ مُشتَرِفُ",15,"ف",1,0],["أماطت عن محيّاها نقاباً","وقلبي فيه للحبّ انبجاس",16,"س",1,0],["أَماطوا الأَذى عنهمْ بحدِّ سيوفِهم","وَلم تنطلِ الأوهامُ يوماً عليهمِ",17,"م",1,0],["أم أطيل السجود في معبد الل","ل وحيدا فتشرقي من جديد",18,"د",1,0],["أَماطَت يَداهُ الفَقر بِالجودِ وَالنَدى","وَقارَنه في النَيل من كان يَقتُرُ",19,"ر",1,0],["أماطت عن الوجه المنير لثامه","فاشرق منه البدر اذ بسم الثغر",20,"ر",1,0],["أماط لثاماً فاجتلِ القمر الأدنى","وألقى وشاحا فاجتنٍ الغصنَ اللّدنا",21,"ن",2,1],["أما طت عن محيا القطر سترا","فيا للّه ما تحت الستار",22,"ر",1,0],["أماط الستر عن وجه الغمام","فتيمني بكحل منه خال",23,"ل",1,0],["أماطت وكنا بالعشي لثامَها","فأصبحت الأنوار تشرق للرائي",24,"ا",2,0]]}