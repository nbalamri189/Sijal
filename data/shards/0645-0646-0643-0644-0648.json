diwan/poem/90904","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4343,"","https://poetry.dctabudhabi.ae/diwan/poem/123792","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58091","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72515","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139659",""],[4690,"جزاء","https://www.poetsgate.com/ViewPoem.aspx?id=175480",""],[5064,"شرعنَة","https://www.poetsgate.com/ViewPoem.aspx?id=199133",""],[5145,"مقل الظباء إذا رمين قواصد","https://www.poetsgate.com/ViewPoem.aspx?id=108154",""],[5213,"قف بي على أبرق الحمى أو الاثل","https://www.poetsgate.com/ViewPoem.aspx?id=170512",""],[5246,"وصف رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=187032",""],[5337,"كم قد تؤمل نفس نيل منيتها","https://www.poetsgate.com/ViewPoem.aspx?id=171247",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[469,"ما بأراكِ الحمى إلى سلمه","https://www.poetsgate.com/ViewPoem.aspx?id=76542",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["مِن كُلِّ وَضّاحِ الجَبينِ مُغامِرٍ","عِندَ العَظائِمِ بِاِسمِهِ مَهتوفِ",0,"ف",1,0],["مِن كُلِّ وَجهٍ نِقابُ العارِ نُقبَتُهُ","كَالعِرِّ مَرَّ عَليهِ القارُ وَالقَطَرُ",1,"ر",1,0],["منْ كُلِّ وَضّاحِ المُحَيّا صَهّالْ","بَضيعُهُ خاظٍ وهادِيهِ عالْ",2,"ل",1,0],["مِنْ كُلِّ وطّاءٍ على قِمَمِ العِدا","بحَوافِرٍ خُلِقَتْ منَ الجُلْمودِ",3,"د",1,0],["منْ كلِّ واجِبَةٍ كَغارِبِ ناقَةٍ","أو كلِّ عَوْجاءٍ كعُنْقِ بَعيرِ",4,"ر",1,0],["مِن كُلِّ وَضاحٍ إِذا شَهِدَ الوَغى","رَوّى الأَسِنَّةَ مِن دَمِ الأَكبادِ",5,"د",1,0],["مِن كُلِّ واضِحَةِ اللَبّاتِ تَبسِمُ عَن","مُرَتَّلٍ زانَهُ التَأشيرُ وَالشَنَبُ",6,"ب",1,0],["مِن كُلِّ وَضّاحِ الجَبينِ تَخالُهُ","بَدراً فَإِن شَهِدَ الوَغى فَغَضَنفَرا",7,"ر",2,0],["من كل وضاح الجبين إذا اجتبى","تلقاه معصوباً بتاج فخار",8,"ر",1,0],["من كل وضاح الجبين كأنه","نجم وجنح النقع ليل مسبلُ",9,"ل",1,0],["من كل وضّاح الجبي","ن أغرّ كالبدر المنير",10,"ر",1,0],["مِن كُلِّ واضِحَةِ الذِفرى مُنَعَّمَةٍ","غَرّاءَ لَم يَغذُها بُؤسٌ وَلا وَبَدُ",11,"د",1,0],["من كل وثاب اذا","اغريته اقتحم الصعابا",12,"ب",2,0],["مِن كُلِّ وَضّاءِ المَآثِرِ فائِتٍ","زُهرَ النُجومِ بِذَهرِهِ السَيّارِ",13,"ر",1,0],["مِن كُلِّ وَسنانٍ بِغَيرِ الكَرى","تَنتَبِهُ الآجالُ مِن هُدبِهِ",14,"ب",2,0],["مِن كُلِّ واضِحَةٍ إِذا هِيَ أَقبَلَت","عايَنتَ دُراً في الثُغورِ نَضيدا",15,"د",2,0],["منكَ لو كانت تباع","أشتريهَا بالحياه",16,"ه",1,0],["من كلّ واقعةٍ ترَى منقارها","ماءً كسلسال اللجين نميرا",17,"ر",2,0],["من كلّ وحشيّ يُسابقُ ظِلَّهُ","حتى أتاه مسابقُ اللحظانِ",18,"ن",1,0],["من كلّ وَرْدٍ رائقٍ كسميِّهِ","فتخالُ من شَفَقٍ له سربالا",19,"ل",2,0],["مِن كُلِّ وَحشِيِّ الطِّباعِ كَأَنَّهُ","بَينَ القَنا الخَطِّيِّ لَيثٌ مُخْدَرُ",20,"ر",1,0],["من كلّ وردٍ ما يشاكلُ لونَهُ","إلا تورّدُ وجنةِ المحبوبِ",21,"ب",1,0],["مِن كُلِّ وارِسَةِ القَميصِ كَأَنَّما","نَشَأَت تُعَلُّ بِريقَةِ الصَفراءِ",22,"ر",3,0],["من كلِّ واضِحَةِ الجَبينِ يَزيُنها","بأسُ الكُماةِ ونجدةُ الأبطالِ",23,"ل",1,0],["من كلِّ وضّاحِ الجبينِ مُعمَّمٍ","وكأنّه مما يُهابُ مُعصَّبُ",24,"ب",1,0],["مِنْ كُلِّ وَغْدٍ يَكَادُ الدَّسْتُ يَدْفَعُهُ","بُغْضاً وَيَلْفِظُهُ الدِّيوانُ مِنْ مَلَلِ",25,"ل",1,0],["مِنْ كُلِّ وَضَّاحِ الْجَبينِ كَأَنَّهُ","قَمَرٌ تَوَسَّطَ جُنْحَ لَيْلٍ أَسْوَدِ",26,"د",1,0],["مِنْ كُلِّ وَثَّابَةٍ جَسُورِ","كَأَنَّهُ صَائِلُ الأُسُودِ",27,"د",1,0],["من كل وجهٍ يَعْربيّ","نمَّ عن كَرَم الخصال",28,"ل",1,0],["من كلّ واقعة ٍ تَرَ منقارها","ماءً كسلسال اللجين نميرا",29,"ر",2,0],["من كلّ وضّاح الجبين مغامر","يغشى المعامع مستثيرا نارها",30,"ر",3,0],["من كل وضَّاءِ المآثر فائتٍ","زُهرَ النجومِ بزهْره السيّار",31,"ر",1,0],["من كل واد اشرقت قيعانه","ورق صوت اللطف من اطيارها",32,"ر",3,0],["من كلِّ وضاح الجبين تخاله","في هفوة الهيجاء عصباً مفصلا",33,"ل",2,0],["مِن كُلِّ وَغدٍ زَنيمٍ ما لَهُ نَسَبٌ","يُدرى وَلَيسَ لَهُ دينٌ وَلا أَدبُ",34,"ب",1,0],["من كلِّ وقَّادِ السِّباقِ كأنما","في كلِّ ذابلةٍ ذُبالٌ مسرج",35,"ج",1,0],["مِن كُلِّ والِعَةٍ بِحِرَّتِها إِذا","ظَمِئَت تُعَلَّلُ بِالسَرابِ الساحِرِ",36,"ر",1,0],["من كلّ وثّابٍ وكل طمرَّةٍ","في متنها خيسٌ لكلِّ غَضَنفَر",37,"ر",1,0],["مِن كُلِّ واضِحَةِ الثَنايا طَرفُها","يُبدي السَقامَ وَلَيسَ فيهِ سَقامُ",38,"م",1,0],["من كُلِّ واضحةِ الجَبين كأَنَّها","قَمَرٌ يُنيرُ مِن الفُروع غياهبا",39,"ب",2,0],["من كل وجه قبلة يأتمها","كم من إمام مستقيم أورع",40,"ع",1,0],["من كُلِّ وَجناء غَرّاءٍ مُسوَّمةٍ","تَعدو فَتَقوى فَلا تَدنو مِن النَصبِ",41,"ب",1,0],["مِن كُلِّ وَضّاحٍ إِذا أَفنى النَدى","من كَفِّهِ المال اِقتَنى بقناهُ",42,"ا",2,0],["من كل واضحة الجبين خريدةً","سترت حجايل زندها أحجالها",43,"ل",3,0],["من كلّ وافي الحلم معتدل ال","أخلاقِ ما لم يُلقَ بالجهلِ",44,"ل",1,0],["من كل وسنان نام عن لاعج الش","وق وما بالحبِّ من ألمه",45,"م",2,0],["من كلِّ واحدةٍ سلت في ظلّه","عن عشب محنيةٍ وظلّ أراك",46,"ك",1,0],["مِن كُلِّ وَضّاحِ الجَبينِ كَأَنَّهُ","رَوضٌ خَلائِقُهُ لَهُ أَزهارُ",47,"ر",1,0],["من كلّ وضّاحِ الجبينِ كأنّما","مسحَتْ عليهِ راحةُ الإقبالِ",48,"ل",1,0],["من كلِّ واضحةٍ كأنّ جَبينَها","قبَسٌ تقنّع في خِمارِ دُخانِ",49,"ن",1,0],["من كلِّ وضّاحٍ إذا","عَرَضتْ له رِيَبٌ أباها",50,"ا",3,0],["من كلِّ وضّاحِ الجبين كأنّه","عَضبٌ جلاه الصَّيقلون صقيلُ",51,"ل",1,0],["من كلّ وضّاح الجبين كأنّه","قمرٌ وممتدِّ القناةِ عَشَنَّقِ",52,"ق",1,0],["من كل وضاح الجبين كأنه","بدر التمام محوَّطٌ بتمائم",53,"م",1,0],["مِن كُلِّ وَردٍ خاضَ بَحراً مِن دَمٍ","فَنَجا بِلَونِ الأَحمَرِ المَذمومِ",54,"م",1,0],["من كل وَجهٍ فيه تجلى","ظلمة الليل البهيمه",55,"م",2,0],["من كلِّ وضّاح الجبينِ محصِّل","لعلومِ نوعيْ سنّةٍ وكتابِ",56,"ب",1,0],["من كل وافية الينوب مشلوَحَة","عطايا عند اللي عطاه جزيل",57,"ل",1,0],["من كل وضاح الفخار لهاشم","يعزى علا ولآل غالبٍ ينتمي",58,"م",2,0],["من كل وطفاء يوزى البرق مزنتها","كأنما ثغر سعدى ضاحك فيها",59,"ي",3,0],["من كل وسواس لها خناس","أطلقتني من ربقة الأفلاس",60,"س",1,0],["مِن كُلِّ واضحةِ الخدَّين بهكنة","تشابه الظَّبيَ بِالألحاظِ والجيدِ",61,"د",1,0],["من كل وضاح الجبين نوره","استعار نور الشمس منه قبسا",62,"س",2,0],["مِنْ كُلِّ واحِدَةٍ تَرِفُّ بِهَوْدَجٍ","كادَتْ تُقَبِّلُ رَأْسَها الَجْوْزَاءُ",63,"ا",2,0],["من كل وسنان الجفون محبةً","سهران من وجد عليه مؤرق",64,"ق",1,0],["مِن كُل وَضاح الجَبين مُلثم","بِعذاره كَلا وَغَير مُلتم",65,"م",1,0],["من كل واضحة الجَبين كأنّها","قَمرالدّجُنّة لوَّحته غلائِلُ",66,"ل",1,0],["من كلِّ وَضّاحٍ كأنَ جبينهُ","قَمرٌ يلوحُ سَناهُ تحْتَ التّاجِ",67,"ج",1,0],["مِن كُلِّ واضِحَةِ السَراةِ فَريدَةٍ","في رَوضَةٍ أُنُفٍ تَمُجُّ ظِلالَها",68,"ل",3,0],["من كل وجناء علكوم شمردلة","عرندس عنتريس ما بها جنب",69,"ب",1,0],["منكِ لو نال ساعدي ضمَّةَ التو","ديع أدركتُ غاية المطلوبِ",70,"ب",1,0],["من كل وضاح المجادة عمره","يومان يوم ندىً ويوم طعان",71,"ن",1,0],["مِن كُلِّ وَضّاحِ النَقِيّبَةِ سَمحِها","حُرٍّ كَريمِ المُنتَمي عَلّامِ",72,"م",1,0],["مِنْ كُلِّ وَجْهٍ لِي عَلَيِهِ مَلاَمَةٌ","وَلَهُ عَلَيَّ غَضَاضَةٌ وَتَكَلُّفُ",73,"ف",1,0],["من كل واضحةٍ الترا","ئب سهلةِ الخدين عَينا",74,"ن",2,0],["من كُلّ وادي التُّقى يسقى الغمامُ بهِ","فيستهلُّ شروقَ الضَّرعِ باللَّبَنِ",75,"ن",1,0],["مِن كُلّ واضِحَة الجَبينِ كَأَنَّها","قَمَرٌ تَكَشَّفَ عَن سَناهُ حِجابُ",76,"ب",1,0],["من كل وضاح الجبين لهاشم","ينمى لرأس الفخر والعلياء",77,"ا",2,0],["من كل وتر ان يسل حسامة","راحت جمةع عداته آحادا",78,"د",2,0],["من كل وجه تلك ثابتة له","لا تهضموها يا أولي البهتان",79,"ن",1,0],["من كل ورقاء تتلو من صحيفتها","أخرى تراجعها في منطق لسن",80,"ن",1,0],["مِن كُلِّ وَرَّادِ الوَغى بِحُسامِهِ","وَالحَتفُ مُعتَرِض طَريقَ المَصدَرِ",81,"ر",1,0],["من كلِ وضَاح الجبين يشقُ من","أنواره فلقُ الصباحِ ويُجتلى",82,"ل",2,0],["مِن كُل وضاح الاسرة عيلم","وَيجير في الجَليَّ وَلَيسَ يجارا",83,"ر",2,0],["من كل وضاح الجبين تحققت","في حد ماضي سيفه احلامها",84,"م",3,0],["من كل وطفاء لفاء الرباب همت","ماء نقياً على زغف تقيات",85,"ت",1,0],["من كل وضاح الجبين مغامر","ضرباً وللبيض الرقاق ضريب",86,"ب",1,0],["من كل وضاح المحيا باسم","حتى المنيه ما اعترته شحوب",87,"ب",1,0],["من كلّ ورقاء في الأفنان صادحةٍ","بين الحدائقِ فيحاء زهراء",88,"ا",2,0],["مِن كُل وقاد القوى متيقظ","نيرانهُ تَعلو بِغَير زِناد",89,"د",1,0],["من كلّ وضّاح الجيب","ن فتىً أغرّ محجَّلِ",90,"ل",1,0],["من كل وجه فهو أجدر بالتي","زفَّت له والفضل مهر الماهر",91,"ر",1,0],["من كُلِّ وَضّاح الجَبي","ن أَغرّ وَضّاء الحسب",92,"ب",1,0],["من كل والهة حسرى يعنفها","على عجاف المطى بالسير مدلجه",93,"ج",2,0],["من كل وضاح الجبين أغر ذي","شمم وعز بالشباب معربد",94,"د",1,0],["مِن كُل وَجهٍ كَشمس في تنقُّلها","منازلاً مِن قُلوب برّجت برجا",95,"ج",2,0],["من كل وهاب لكم","نعمى هبات وافرهْ",96,"ر",2,0],["مِنْ كُلِّ وَسْنانِ العُيونِ لَمْ يَزَلْ","يَحْجُبُ جَفْنَ الصَّبِّ عَنْ مَنامِهِ",97,"م",2,0],["من كل وضَاّحِ الجبينِ سامِ","مُنتَجَبٍ من إرم بن سام",98,"م",1,0],["من كل وضاح الجبين قد اغتدى","قمراً بآفاق المعالي مشرقا",99,"ق",2,0],["مِن كلّ وجهٍ كأَنّ صورتَه","بدرٌ ولكنّ ليلَه شَعَرُ",100,"ر",1,0],["من كل واضحة المحيا ان مشت","يعطف لقلب المستهام قوام",101,"م",1,0],["من كل وضاح الأسرة مشرق","كالبدر إلا أنه لم يغرب",102,"ب",1,0],["من كل وضاح الجبين عليه من","صبح الصباحة نور حسن باهر",103,"ر",1,0],["من كل وضاح عليه مشرف","للبشر فوق جبينه عنوان",104,"ن",1,0],["من كل وضاح المحيا للندى","من فوق غرته بدا قنديل",105,"ل",1,0],["من كل وضاح السنا بجبينه","للبشر أيدي اليمن خطت أحرفا",106,"ف",2,0],["من كل واضحة الأنوار فاضحة","لما تلألأ من نور ونوّار",107,"ر",1,0],["من كل وضاح الجبين إذا بدت","قسماته أربت على ابن المنذر",108,"ر",1,0],["من كل واضحةِ الخدِّينِ ناعمةٍ","كأنما سُقِيَتْ مشمولةً دَهَقَا",109,"ق",2,0],["من كل وار وكل سار","وكل بار له اشتهار",110,"ر",1,0],["من كل وضاحٍ قصير الخطى","إلى الدنيّات طويل النجاد",111,"د",1,0],["منْ كُلّ وكْرِ ينْسِلون يَؤُمُّهُم","رأس الخَنا ،يَتَسابَقون إذا دَعا",112,"ع",2,0],["مِنْ كُلِّ وَعْثٍ رِحْلَةٌ بدَأتْ","لا الخَطْوُ مَلَّ ولَمْ تَمَلْ أَنْتَا",113,"ت",2,0],["من كلّ واضحة الجبين كأنها","بدرٌ نكتفه ظلامٌ راكد",114,"د",1,0],["من كل وضاحة الخدين ساجية ال","طرفين تنتهب الأكباد بالمقل",115,"ل",1,0],["من كل ورق قطاة صفرد صرد","وهدهد وطيور فيه تندفع",116,"ع",1,0],["من كل وغد لئيم الأصل قد حملت","به العواهر لا ينمى الى نسب",117,"ب",1,0],["من كل وجه والقتال فقائم","حتى يكون الضد ذا إذلال",118,"ل",1,0],["مِنْ كُلِّ واضِحَةِ الخَدَّيْنِ بَهْكَنَةٍ","مَيَّاسَةٍ فِي بُرُودِ الحُسْنِ وَالتِّيهِ",119,"ي",2,0],["من كل وسنان نام عن لاعج الش","شوق وما بالحبِّ من ألمه",120,"م",2,0],["من كل وصفٍ مذموم يفهمُ من نفسه","وبعد تخلّيهِ بالضدِّ يتحلّى",121,"ل",2,0]]}