{"poems":[[72,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[51,"لخالد زوجة يلقمها","https://www.aldiwan.net/poem63991.html","المنسرح"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[45,"صككت على سليمان بن وهب","https://www.aldiwan.net/poem63522.html","الوافر"],[66,"صرف المدام به السرور مخصص","https://www.aldiwan.net/poem38488.html","الكامل"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[46,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[288,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[404,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"]],"verses":[["صكَّت به الأجرام من فوقنا","ودار بالآفاقِ منَّا فلخ",0,"خ",1,0],["صكّ عِجان استها بفَيْشته","كصكَّة المنجنيق بالحجرِ",1,"ر",1,0],["صُكّوا عَلى شارِفٍ صَعبٍ مَراكِبُها","حَصّاءَ لَيسَ لَها هُلبٌ وَلا وَبَرُ",2,"ر",1,0],["صَكَكتَ عَلى سُلَيمانَ بنِ وَهبٍ","أَبا حَسَنٍ بِديوانِ البَريدِ",3,"د",1,1],["صَكَّت ظُباكَ رُؤوسَهُم وَجُسومَهُم","فَالهامُ تُنثَرُ وَالضُلوعِ تُقَصَّصُ",4,"ص",1,0],["صكَّت الأَلسنُ المسامعَ حتى","لقيَتْ من ضجيجكُم ما كفاها",5,"ا",3,0],["صَكَّهُمُ الدَهرُ صَكَّ أَعمى","تَكتُبُ أَيدي الفَناءِ صَكَّه",6,"ك",2,0],["صَكّاءَ ذِعلِبَةٍ إِذا اِستَدبَرتَها","حَرَجٍ إِذا اِستَقبَلَتها هِلواعِ",7,"ع",1,0],["صك المسامع لما جاءنا خبر","يا ليته ما أتانا ذلك الخبر",8,"ر",1,0]]}