{"poems":[[74,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[53,"لخالد زوجة يلقمها","https://www.aldiwan.net/poem63991.html","المنسرح"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[47,"صككت على سليمان بن وهب","https://www.aldiwan.net/poem63522.html","الوافر"],[68,"صرف المدام به السرور مخصص","https://www.aldiwan.net/poem38488.html","الكامل"],[104,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[48,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[292,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[409,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64601","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100996","البسيط"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198612","البسيط"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84524","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132721","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26141","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85279","الرجز"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143831","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105530","الكامل"],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[5304,"العشق","https://www.poetsgate.com/ViewPoem.aspx?id=155916",""],[5512,"ساحت دماء","https://www.poetsgate.com/ViewPoem.aspx?id=204166",""],[6049,"شوفي بعينك","https://www.poetsgate.com/ViewPoem.aspx?id=35820",""],[6115,"صكّه الدهر فالجبهه بمشعابه!","https://www.poetsgate.com/ViewPoem.aspx?id=185782",""]],"verses":[["صكَّت به الأجرام من فوقنا","ودار بالآفاقِ منَّا فلخ",0,"خ",1,0],["صكّ عِجان استها بفَيْشته","كصكَّة المنجنيق بالحجرِ",1,"ر",1,0],["صُكّوا عَلى شارِفٍ صَعبٍ مَراكِبُها","حَصّاءَ لَيسَ لَها هُلبٌ وَلا وَبَرُ",2,"ر",1,0],["صَكَكتَ عَلى سُلَيمانَ بنِ وَهبٍ","أَبا حَسَنٍ بِديوانِ البَريدِ",3,"د",1,1],["صَكَّت ظُباكَ رُؤوسَهُم وَجُسومَهُم","فَالهامُ تُنثَرُ وَالضُلوعِ تُقَصَّصُ",4,"ص",1,0],["صكَّت الأَلسنُ المسامعَ حتى","لقيَتْ من ضجيجكُم ما كفاها",5,"ا",3,0],["صَكَّهُمُ الدَهرُ صَكَّ أَعمى","تَكتُبُ أَيدي الفَناءِ صَكَّه",6,"ك",2,0],["صك الخطوب بخطب اسمه جلد","والق الامور بحلم شخصه جبل",7,"ل",1,0],["صَكّاءَ ذِعلِبَةٍ إِذا اِستَدبَرتَها","حَرَجٍ إِذا اِستَقبَلَتها هِلواعِ",8,"ع",1,0],["صك المسامع لما جاءنا خبر","يا ليته ما أتانا ذلك الخبر",9,"ر",1,0],["صَكَّ العِدَى أَخْلَقَ مَرْمَرِيسا","لا يَمْلِكُ الناسُ لَهُ تَأْيِيسا",10,"س",2,0],["صُكَّ الخطوب بخطب السمه جَلَدٌ","والْقَ الأمور بحلم شخصه جَبَل",11,"ل",1,0],["صَكّوا وجوه العوادي وهي تزجرهم","إلى المصارع ما طاشوا ولا ذُعروا",12,"ر",3,0],["صك إذا لحظته المقلة انقشعت","عني سحاب العدى واستدرك الفرج",13,"ج",1,0],["صك كريم به الدنيا قد ابتهجت","في مقلتي، وأحبائي قد ابتهجوا",13,"ج",3,0],["صكت قواضبه الرقاب وَغادر أل","أَبطال في الهيجآء كالأَشخاص",14,"ص",1,0],["صك الأقاليم ناعي الفضل فاعتصمت","خوف الهلاك بتمويه وايهام",15,"م",1,0],["صَكٌّ بِليتَيهِ إِذا لَم يُرثَمِ","فَهوَ يَزُكُّ دائِمَ التَزَغُمِ",16,"م",1,0],["صك عليه ختم قاضي البلد","لا يستطيع حجده من أحد",17,"د",1,0],["صكَّ النسيم فراخ الغيث فانزعجت","ينفضن أجنحةً من عنبر الزغب",18,"ب",1,0],["صك تنمنم في المداد فقل","وشم بدا في وجنة البدر",19,"ر",1,0],["صك الجباه له من حوله زجل","الى عنان السما يعلو وينتصب",20,"ب",1,0],["صكّت تقاليد القبايل بلا افراق","لكن بعيده والنظر يبتصر فوق",21,"ق",1,0],["صكَّ الأسى بدمٍ ، في الصَّخرِ دوَّنهُ","سهمُ الوصيِّةِ في الآفاقِ ينطلقُ",22,"ق",1,0],["صكيت.. درفه.. وحدةٍ لجل.. تبقين","واني ..على ..الاسرار حرصٍ ...ما ابوحي",23,"ح",2,0],["صكّه الوقت فالجبهه بمشعابه","بعدها لاهتنى وقته ولا نامي",24,"م",2,0]]}