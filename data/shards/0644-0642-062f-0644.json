طلبي","https://www.aldiwan.net/poem10337.html","البسيط"],[46,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[71,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[54,"لقد لطف الرحمن بابنة قاسم","https://www.aldiwan.net/poem26853.html","الطويل"],[77,"أقول لذي قامة كالقضيب","https://www.aldiwan.net/poem69009.html","المتقارب"],[52,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem63925.html","الطويل"],[48,"لقد لقي المرء من دهره","https://www.aldiwan.net/poem22227.html","المتقارب"],[48,"لقد لجنت بالمال خوصاء ضامر","https://www.aldiwan.net/poem23446.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62242","الوافر"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8238","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19247","الوافر"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10980","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10276","البسيط"],[108,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[79,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[87,"جعلتُ حُلاها وتمثالها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9586&r=&rc=76",""],[119,"هجرت فطال يا حب الملام","https://www.aldiwan.net/poem40592.html","عموديه"],[125,"لقد لاح من هند هدى راح لائحاً","https://www.aldiwan.net/poem23819.html","الطويل"],[136,"خليلى لا لا تبديبا لى التلكيا","https://www.aldiwan.net/poem54683.html","الطويل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[159,"أما مسعد يختصني بابتكاره","https://www.aldiwan.net/poem55662.html","الطويل"],[186,"مضت عن دار جبرائيل عيد","https://www.aldiwan.net/poem61170.html","الوافر"],[186,"برحمة الله ديمتري قضى فبكى","https://www.aldiwan.net/poem61185.html","البسيط"],[215,"لقد لامني لما بخلت بخاطري","https://www.aldiwan.net/poem46567.html","الطويل"],[216,"لقد لذ لي هذا الكتاب وشرحه","https://www.aldiwan.net/poem37862.html","الطويل"],[216,"لقد لذ لي الظبي الأغن عتابه","https://www.aldiwan.net/poem37877.html","الطويل"],[243,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[274,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[284,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[294,"لقد لقيت صباحاً","https://www.aldiwan.net/poem11657.html","المجتث"],[309,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[370,"جهادك حكم الله ليس بمصدود","https://www.aldiwan.net/poem17172.html","الطويل"],[381,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[407,"لك الحمد حمدا باللغات جميعها","https://www.aldiwan.net/poem33400.html","الطويل"],[410,"لنفسك لم لا عذر قد نفذ العذر","https://www.aldiwan.net/poem50166.html","الطويل"],[420,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[461,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[467,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[467,"وافى كتابك مخصوصاً بأربعة","https://www.aldiwan.net/poem3236.html","عموديه"],[467,"لقد لج دمعي ليلة السفح بالسفح","https://www.aldiwan.net/poem3581.html","عموديه"],[480,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[561,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"],[565,"لقد لبى ابن كتسلفيس لما","https://www.aldiwan.net/poem52577.html","الوافر"],[578,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[685,"","https://poetry.dctabudhabi.ae/diwan/poem/31530","الوافر"],[937,"","https://poetry.dctabudhabi.ae/diwan/poem/29371","الطويل"],[1098,"","https://poetry.dctabudhabi.ae/diwan/poem/18406","الوافر"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28937","الطويل"],[1163,"لقد لامني عند القبور على البكا","https://www.poetsgate.com/ViewPoem.aspx?id=18226",""]],"verses":[["لَقَد لَسَبَتني مِن عَقارِبِ كَيدِهِم","دُيوبٌ إِذا جَنَّ الظَلامُ لَسوعُ",0,"ع",1,0],["لَقَد لاقَيتُ مِن كَلَفي بِلُبنى","بَلاءَ ما أُسيغَ بِهِ الشَرابا",1,"ب",2,0],["لَقَد لَمستُ مُعَرّاهُ فَما وَقَعَت","مِمّا لَمَستُ يَدي إِلّا عَلى وَتِدِ",2,"د",1,0],["لَقَد لَقِيَتنا أُمُّ عَمرٍو بِصادِقٍ","مِنَ الصَرمِ أَو ضاقَت عَلَيهِ الخَلائِقُ",3,"ق",1,0],["لَقَد لايَنوهُ في المَقالِ وَأَضمَروا","قُلوباً عَلى الأَحقادِ مُنطَوِياتِ",4,"ت",1,0],["لقد لبس الجوّ اللطيف فزانه","بما فيه من غرّ المحاسن لبسه",5,"س",2,0],["لَقَد لُمتِنا يا أُمَّ غَيلانَ في السُرى","وَنِمتِ وَما لَيلُ المَطِيِّ بِنائِمِ",6,"م",1,0],["لَقَد لاحَ وَسمٌ مِن غَواشٍ كَأَنَّها ال","ثُرَيّا تَجَلَّت مِن غُيومٍ نُجومُها",7,"م",3,0],["لَقَد لَعَنَ الرَحمَنُ جَمعاً يَقودُهُم","دَعِيُّ بَني شِجعٍ لِحَربِ مُحَمَّدِ",8,"د",1,1],["لَقَد لاقَيتُمُ خِزياً وَذُلّاً","جَهيزاً باقِياً تَحتَ الوَريدِ",9,"د",1,0],["لَقَد لَقِيَت قُرَيظَةُ ما عَذاها","وَحَلَّ بِحِصنِها ذُلٌّ ذَليلُ",10,"ل",1,1],["لَقَد لَقِيَت قُرَيظَةُ ما سَآها","وَما وَجَدَت لِذُلٍّ مِن نَصيرِ",11,"ر",1,1],["لقد لَفظْنَا منكِ مَلْفُوظةً","وقد مججنا منك ممجوجَهْ",12,"ج",2,0],["لَقَد لاقى المَطِيَّ بِجَنبِ عُفرٍ","حَديثٌ لَو عَجِبتَ لَهُ عَجيبُ",13,"ب",1,0],["لَقَد لَبِسَتهُ الأَرضُ حِلياً كَأَنَّهُما","أَياديكَ فيهِ لَم تَزَل ذاتُ رَونَقِ",14,"ق",1,0],["لَقَد لَطَمت كَفُّ الفَتاةِ هَجينَها","أَلا بَتَر الرَّحمنُ رَبِّي يَمينَها",15,"ه",2,1],["لقد لف ذاك النعش في يوم سيره","براية مصر وهي أثكل فاقد",16,"د",1,0],["لقد لبسوا له الأزياء شتى","فلم يقبل سوى التجريد زيا",17,"ي",2,0],["لقد لامني يا هند في الحب لائم","محب إذا عُدّ الصحاب حبيب",18,"ب",1,1],["لَقَد لَبّى زَعيمُكُمُ النِداءَ","عَزاءً أَهلَ دِمياطٍ عَزاءَ",19,"ا",2,1],["لَقَد لَعِبَ البَينُ المُشِتُّ بِها وَبي","وَزَوَّدَني في السَيرِ ما زَوَّدَ الضِبّا",20,"ب",2,0],["لَقَد لَجَأَ الإِسلامُ مِن سَيفِ جَعفَرٍ","إِلى صارِمٍ في النائِباتِ حُسامِ",21,"م",1,0],["لقد لَبِسَ الإسلامُ شَرقاً ومغرِباً","بسيفِ ابنِ عبدِ اللهِ ظِلاًّ مُمدَّدا",22,"د",2,0],["لَقَد لَحِقتُ بِأولى الخَيلِ تَحمِلُني","لَمّا تَذاءَبَ لِلمَشبوبَةِ الفَزَعُ",23,"ع",1,1],["لَقَد لَعِبتُ وَجَدَّ المَوتُ في طَلَبي","وَإِنَّ في المَوتِ لي شُغلاً عَنِ اللَعِبِ",24,"ب",1,1],["لَقَد لَبِسَ الأَفشينُ قَسطَلَةَ الوَغى","مِحَشّاً بِنَصلِ السَيفِ غَيرَ مُواكِلِ",25,"ل",1,0],["لَقَد لَبِستَ أَميرَ المُؤمِنينَ بِها","حَلياً نِظاماهُ بَيتٌ سارَ أَو مَثَلُ",26,"ل",1,0],["لقد لَؤُمَ الحمامُ فإن رضينا","بما يجني فنحنُ إذنْ لئامُ",27,"م",1,0],["لَقَد لُفَّ في أَكفانِهِ الفَضلُ كُلُّهُ","وَساقَ العُلا جَهراً إِلى التُرَبِ حامِلُه",28,"ل",2,0],["لَقَد لَطَفَ الرَحمَنُ بِاِبنَةِ قاسِمٍ","وَدافَعَ عَنها بِالجَميلِ مِنَ الصُنعِ",29,"ع",1,1],["لقد لعبت بي صُرُوفُ الزَّمان","كلعبِ الفتى والفتى بالكُرَة",30,"ر",2,0],["لَقَد لامَني المَولى عَلَيها وَإِنَّما","يَلومُ عَلى حَوراءَ تُبدِعُ بِالخَدِّ",31,"د",1,0],["لَقَد لَقِيَ المَرءُ مِن دَهرِهِ","عَجائِبَ يُغلِثُها الغالِثُ",32,"ث",1,1],["لَقَد لَجَنت بِالمالِ خَوصاءُ ضامِرٌ","وَكَيفَ لَها أَنَّ اللُجَينَ لَجينُ",33,"ن",1,1],["لَقَد لعبت كَثيرا","حتّى تعبت فَنامي",34,"ي",1,0],["لَقَدْ لاَقَتْ رَحَى كلْب صَبَاحاً","رَحَى لُقْمَانَ تَلْتَهِمُ الطَّحِينَا",35,"ن",2,0],["لَقَد لامَني فيها أَخٌ ذو قَرابَةٍ","حَبيبٌ إِلَيهِ في مَلامَتِهِ رُشدي",36,"د",2,0],["لَقَد لَجَّ ميثاقٌ مِنَ اللَهِ بَينَنا","وَلَيسَ لِمَن لَم يوفِ لِلَّهِ مِن عَهدِ",36,"د",1,0],["لَقَد لَبِسوا لَهُ الأَزياءَ شَتّى","فَلَم يَقبَل سِوى التَجَربُدَ زِيّا",37,"ي",2,0],["لَقَد لامَني في حُبِّ لَيلى أَقارِبي","أَبي وَاِبنُ عَمّي وَاِبنُ خالي وَخالِيا",38,"ي",2,1],["لَقَد لَمَستُ مُعَرّاها فَما وَقَعَت","مِمّا لَمَستُ يَدي إِلّا عَلى وَتَدِ",39,"د",1,0],["لقد لاذ بالإِنصاف طول حياته","ومن لاذ بالإنصاف لم يخش عاديا",40,"ي",2,0],["لقد لبس الأذفنش منها ملاءة","من اللؤم تأباها الملوك الأكابر",41,"ر",1,0],["لقد لبِس البرُّ قَسطالها","فأما أبوكَ فدنيا الحضا",42,"ض",2,0],["لقد لاموا ضل الرأي منهم","ومفتون بحبك لا يلام",43,"م",1,0],["لقد لاح من هند هدى راح لائحاً","وظلت طيورٌ في الهواء سوانحا",44,"ح",2,1],["لَقَد لاَمني في حُبِّ مَن تَامَ حُبُّهَا","فُؤَادِىَّ حَتَّى أن أَطَلتُ التَّشَكِيَا",45,"ي",2,0],["لَقَد لاقَوا بِنُصرَتِهِم قُرَيشاً","كَما لاقَت بِأَشقاها ثَمودُ",46,"د",1,0],["لَقَد لَؤُمَ الدَهرُ الَّذي عَنكَ عاقَني","وَإِن لُمتُهُ مِن بَعدِ ذا كُنتُ أَلأَما",47,"م",2,0],["لَقَدْ لاحَ ضَوْءُ الصُّبْحِ يحملُ رايةً","يَشُقُّ جَلابيبَ الدُّجى عَنْ نهارِهِ",48,"ر",2,0],["لَقَد لَحِقَت بِطِفليها وَأَبقَت","لَهُ طِفلينِ في سوءِ اِنتِحابِ",49,"ب",1,0],["لَقَد لَبِسَتَ جهادَ البِرِّ مِن قِدَمٍ","أَرَّختُ وَاليَوم أَنتَ اللابِسُ الظَفَرا",50,"ر",2,0],["لقد لامني لما بخلت بخاطري","عليه ولم آمن ضلالته فيه",51,"ه",1,1],["لَقَدْ لَذَّ لي هذا الكتابُ وشرحُهُ","أنيقٌ ومعناه أراقَ لمسمعي",52,"ع",2,1],["لقد لذَّ لي الظبي الأغن عتابُهُ","ويذكر زلاتي وفي الوصلِ يرمزُ",53,"ز",1,1],["لقد لاقت الدرعية الهدم والفنا","ولكنها قامت بما كان يوجب",54,"ب",1,0],["لقد لبسنا من الأبرادِ أفخرَها","لما جَرَرنا ذيولُ العصبِ تزيينا",55,"ن",2,0],["لَقَدْ لَبِسَتْ بِكَ الدُّنْيَا جَمالاً","فَلَوْ كَانَتْ يَداً كنْتَ السِّوَارا",56,"ر",2,0],["لقد لقيت صباحاً","بيضاً حساناً صباحا",57,"ح",2,1],["لَقد لَبِست للبعدِ عنهُ كآبة","فَمُذ قبّلت كفّيه فارَقت الودبا",58,"ب",2,0],["لَقَد لَقِحَت بَعدَ الحِيالِ مَطالِبٌ","تَوَلَّدُ ما بَينَ الشِجاعَةِ وَالجودِ",59,"د",1,0],["لقد لَطَّفوا الجزءَ الكثيف كأنهم","ملائكةٌ يَحوون ذا الجزء ملموسا",60,"س",2,0],["لقد لامني في حبها كل جاهل","وصار مني من كنت أحسبه خِدْنا",61,"ن",2,0],["لَقَد لفظتني كُلَّ أَرضٍ وَبَلدَةٍ","وَما لفظتني عَن مَواطنها مِصرُ",62,"ر",1,0],["لقد لامني في هواك العذولُ","وألقى على السمعِ قولاً ثقيلا",63,"ل",2,0],["لقد ليموا بما نقموا وإني","لأوسعُهم بما حسدوك عُذرا",64,"ر",2,0],["لقد لان عود المجد بعدك ذاهباً","وقد كان حيناً لا يلين على العجم",65,"م",1,0],["لقد لبستم فؤادي من جوانحه","شوقاً فردوا فؤادي أو خذوا جسدي",66,"د",2,0],["لقد لجَّ دمعي ليلةَ السّفح بالسّفحِ","ولا غرو أن تبكي البخيلة بالسّمحِ",67,"ح",1,1],["لقد لازمَ القلبَ المعنَّى ببينِهمْ","خُفُوقٌ على طولِ المدى ووجيبُ",68,"ب",1,0],["لقد لذ لي في مروة الحب والصفا","إلى وصلهم سعي وقد طاب لي شربي",69,"ب",2,0],["لقد لبَّى ابنُ كَتْسَلفِيسَ لمَّا","دعاهُ إليهِ خالِقهُ العظيمُ",70,"م",1,1],["لقد لقيتُ نصباً","وقد سُقيت وَصَبَا",71,"ب",2,1],["لَقَد لاقَيتَ يَومَ ذَهَبتَ تَبغي","بِجَزمِ نُبايِعٍ يَوماً أَمارا",72,"ر",2,1],["لَقَد لَقِيَت شَولٌ بِجَنبَي بُوانَةٍ","نَصِيّاً كَأَعرَافِ الكَوَادِنِ أَسحَما",73,"م",2,0],["لَقَد لاقَت مَسَرّاتُهُمُ إِفتِضاحاً","وَفِئنا بِالنِساءِ عَلى المَطِيِّ",74,"ي",1,0],["لقد لامني عند القبور على البكا","رفيقي لتذرافِ الدموع السوافكِ",75,"ك",1,1],["لقد لامني عند القبور على البكا","رفيقي لتذارف الدموع iiالسوافك",76,"ك",1,1]]}