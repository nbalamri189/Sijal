{"poems":[[33,"لمن الديار رسومها قفر","https://www.aldiwan.net/poem42527.html","الكامل"],[275,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[566,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38054","المجتث"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138061","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25314","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121328","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119640","البسيط"],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[5606,"الرجل كلمته تظهرمدى مستواه","https://www.poetsgate.com/ViewPoem.aspx?id=194430",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""]],"verses":[["وَزَبَرجَدٌ وَمِنَ الجُمانِ بِهِ","سَلسُ النِظامِ كَأَنَّهُ جَمرُ",0,"ر",1,0],["وزبيدةُالسلطانةُ العظمى التي","كانت لديها تَربُضُ الآساد",1,"د",1,0],["وَزَبَدُ البَحرِ لَهُ كَتيتُ","تَراهُ وَالحوتُ لَهُ نَئِيتُ",2,"ت",1,0],["وزبدةُ القولِ إني","راضٍ وصلتَ وإنْ لا",3,"ل",2,0],["وَزُبْدَةُ القَوْلَيْنِ ما ذَكَرْنا","وَعُمْدَةُ الدَّلِيْلِ ما سَطَرْنا",4,"ن",2,0],["وَزُبْدَةُ الْقَوْلِ هُنا التَّجَزِّيْ","فِي الضَّبْطِ وَالْحِفْظِ وَهذا يُجْزِيْ",5,"ي",1,0],["وَزَبَدُ الماءِ لَهُ كَتِيتُ","تَرَاهُ وَالحُوتُ لَهُ نَئِيتُ",6,"ت",1,0],["وزبانها ذو التكنتين وطارق","والصودحي وقانس متسمت",7,"ت",1,0],["وزبرةٌ كأنها","رخانِ في خَشتٍ ذَرِب",8,"ب",1,0],["وزبّر السيف في الأعداء فانهزت","من سوء فتكٍ ولا راءٍ كمن سمعا",9,"ع",2,0],["وزبونه إليا جاه ماهو مْتفحص","لنّه بافعاله خطيرٍ ومشهور",10,"ر",1,0],["وزبدة القول يا من تقبلون الوصاه","لاتخاوي بخيل ولا تجادل حقير",11,"ر",1,0],["وزبونٌ يهذي هناكَ زميلٌ","لمْ يُصَفّقْ لمآتمٍ في العبارهْ!",12,"ر",2,0],["وَزَبورُ داْوودِ الَّتِي أَسْفَاْرُها","فِيْ غَيْهَبٍ لِلْحُزْنِ وَالْإِجْهَاْدِ.",13,"د",1,0]]}