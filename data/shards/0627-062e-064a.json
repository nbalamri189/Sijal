بسيط"],[504,"بلغت المنى وحللت الحرم","https://www.aldiwan.net/poem2400.html","المتقارب"],[512,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[536,"آخي إن الفراق على الجميع","https://www.aldiwan.net/poem47563.html","عموديه"],[536,"أنادي رصيفا لي هناك وإنني","https://www.aldiwan.net/poem48139.html","عموديه"],[539,"تولت رجالي بالغنائم والغنى","https://www.aldiwan.net/poem680.html",""],[549,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[556,"لمن أشتكي ما بي وما بي هو الله","https://www.aldiwan.net/poem33587.html","الطويل"],[562,"لك الفوز والبشرى فسعدك قد نجم","https://www.aldiwan.net/poem889.html",""],[562,"أخي بالوفا بالود بالخلق الأسنى","https://www.aldiwan.net/poem897.html",""],[565,"أخي بل رئيسي بل أميري وسيدي","https://www.aldiwan.net/poem69543.html","الطويل"],[565,"أخي لا تروعني بميل إلى أخ","https://www.aldiwan.net/poem69636.html","الطويل"],[565,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[565,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[568,"أخي والله خير من أخيكم","https://www.aldiwan.net/poem59471.html","الوافر"],[571,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[585,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"]],"verses":[["أُخَيَّ جَبراً لَكَ مِن عَثرَةٍ","لا بُدَّ لِلعاثِرُ أَن يوهَنا",0,"ن",2,0],["أُخَيَّ مَن باعَ دُنياهُ وَزُخرُفَها","بِصَونِهِ كانَ عِندي غَيرَ مَغبونِ",1,"ن",1,0],["أَخي وَاِبنُ عَمّي وَاِبنُ حَمدٍ فَإِنَّهُ","تَباريحُ قَلبي خاّلِياً وَغَرامي",2,"م",2,0],["أُخَيَّ لا رَغِبَت عَيني وَلا أُذُني","مِن بَعدِ يَومِكَ في مَرأى وَمُستَمَعِ",3,"ع",1,0],["أَخي ما أَقَلَّ التابِعيكَ إِلى الثَرى","وَإِخوانُكَ الأَدنونَ مِن قَبلِها كُثرُ",4,"ر",1,0],["أُخَيَّ أَمَا تَرْتاحُ لِلسَّيْرِ إِذْ بَدا","سَناً لِحُشاشَاتِ الدُّجُنَّةِ لافِظُ",5,"ظ",1,0],["أُخَيَّ أقِمْ أعْناقَهُنَّ لحاجِزٍ","فهُنَّ على بَطْحاءِ نَجْدٍ نَواشِزُ",6,"ز",1,0],["أُخَيَّ إِلى كمْ تَتْبَعُ الغَيْثَ رائِداً","وفي غير أرضٍ تُنْبِتُ العِزَّ تَحْرُثُ",7,"ث",1,0],["أَخي لَن تَنالَ العِلمَ إِلّا بِسِتَّةٍ","سَأُنبيكَ عَن تَفصيلِها بِبَيانِ",8,"ن",1,1],["أّخِي فَتْرَةُ السَّلُوَانِ جَاءَ رَسُولُهَا","وَقَدْ أَسْعَفَ النَّفْسَ الأبيّةَ سُولُهَا",9,"ل",3,1],["أخي لا تَقُلْ كَذِباً إنْ نَطَقْتَ","فللنّاسِ في الصِّدْقِ فَضْلٌ وَضَحْ",10,"ح",1,1],["أَخي وَاللَهِ قَد مُلِئَ الوِطابُ","وَداخَلَني بِصُحبَتِكَ اِرتِيابُ",11,"ب",1,1],["أُخَيَّ إِمّا تَكُ وَدَّعتَنا","وَحالَ مِن دونِكَ بُعدُ المَزار",12,"ر",1,0],["أَخِي العُرْفَانِ وَالأَدَبِ الْمُذَكِّي","فَتَى الفِتْيَانِ بِالْخُلُقِ العُجَابِ",13,"ب",1,0],["أَخِي مَزَاحٍ وَرِفْقٍ","مُسْتَلْطَفِ التَّشْبِيبِ",14,"ب",1,0],["أَخَيْرُ شَبابِ العَصْرِ نُبْلاً وَهِمَّةً","طَفَرْتَ إِلَى العُلْيَا فَجُزْتَ المَرَاقِيَا",15,"ي",2,0],["أَخِي وِدّاً وَكُنْتُ أَوَدُّ","لَوْ لَمْ تَغْدُهُ يُتْمَا",16,"م",2,0],["أَخي قَفَراتٍ دَبَّبَت في عِظامِهِ","شُفافاتُ أَعجازِ الكَرى وَهوَ أَخضَعُ",17,"ع",1,0],["أَخي شُقَّةٍ رَخوِ العِمامَةِ مَنَّهُ","بِتَطلابِ حاجاتِ الفُؤادِ طَلوبُها",18,"ب",3,0],["أَخَيلُكَ أَم خَيلي تَدارَكنَ هانِئً","يُثِرنَ عَجاجاً بِالغَبيطَينِ أَصهَبا",19,"ب",2,0],["أَخَيلُكَ أَم خَيلي بِبَلقاءَ أَحرَزَت","دَعائِمَ عَرشِ الحَيِّ أَن يَتَضَعضَعا",20,"ع",2,0],["أَخي ثِقَةٍ يَهتَزُّ لِلعُرفِ وَالنَدى","بَعيدِ المَدى في النائِباتِ صَبورِ",21,"ر",1,0],["أخي دون إخواني إذا الحربُ شمَّرت","حسامٌ بحدَّيه فُلولٌ من الضربِ",22,"ب",1,0],["أخي ثقةٍ لو أصبح الناسُ كلهم","عليَّ معاً حِزباً لأصبح من حزبي",22,"ب",2,0],["أخي وإلفي وتربي كان مولدُنا","معاً وربَّتْني الأيامُ حيث رَبَا",23,"ب",2,0],["أخْيَبُ ذي قوس رمى ظبيةً","من هتف الدهر به قَوِّس",24,"س",1,0],["أُخيَّك لا تستطِش حِلمَهُ","فما سَهمُهُ عنك بالأطيش",25,"ش",1,0],["أخي ما أخي لا مُرْتجي الخير خائبٌ","عليه ولا ذو المدح فيه بآثمِ",26,"م",1,0],["أَخَيالُ خَصمٍ أَتَّقي نَزَواتِهِ","أَم أَنتَ يا هَذا خَيالُ خَدينِ",27,"ن",1,0],["اخي الى الموت سلك","اخي قضى اخي هلك",28,"ك",1,1],["اخي عن النور تولى","راحلا الى الحلك",28,"ك",1,0],["اخي اخي اني انا","ديك ولا جواب لك",28,"ك",1,0],["اخي اخي ماذا من","الاسباب عني شغلك",28,"ك",1,0],["أخي أقبل على من المنايا","وهات حديثك العذب الشهيا",29,"ي",2,0],["أَخي عَبدَ الحَليمِ وَلَستُ أَدري","أَأَدعو الصِهرَ أَم أَدعو الإِخاءَ",30,"ا",2,0],["أخي ماذا دهاكَ وما أصابَكْ","دعوتُك ثم لم أسمعْ جوابَكْ",31,"ك",1,1],["أَخي عِندَ جِدِّ الحادِثاتِ وَإِنَّما","أَخوكَ الَّذي يَأتي الرِضا حينَ تَغضَبُ",32,"ب",1,0],["أَخي إِنَّهُ يَومٌ أَضَعتُ بِهِ رُشدي","وَلَم أَرضَ هَزلي في اِنصِرافي وَلا جِدّي",33,"ي",1,1],["أُخَيَّ إِنَّ الصِبا اِستَمَرَّ بِهِ","سَيرُ اللَيالي فَأَنهَجَت بُرُدُه",34,"د",2,0],["أَخَيالَ عَلوَةَ كَيفَ زُرتَ وَعِندَنا","أَرَقٌ يُشَرِّدُ بِالخَيالِ الزائِرِ",35,"ر",1,0],["أَخي مِن بَني قَطَنٍ لا يَزا","لُ يَميرُ القُبورَ وَيُخلي الدِيارا",36,"ر",2,0],["أَخَيالاتُ خُرَّدٍ أَم خَيالا","تُ سِباعٍ وَحشِيَةٍ في غِياضِ",37,"ض",1,0],["أُخَيَّ مَتى خاصَمتَ نَفسَكَ فَاِحتَشِد","لَها وَمَتى حَدَّثتَ نَفسَكَ فَاِصدُقِ",38,"ق",1,1],["أَخي وَاِبنُ عَمّي سابَقَتني خِصالُهُ","إِلى شَرَفٍ أَو سابَقَتهُ خِصالي",39,"ي",1,0],["أَخي ثِقَةٍ في كُلِّ أَمرٍ يَنوبُني","وَعِندَ جَسيمِ الأَمرِ لا يَتَغَيَّبُ",40,"ب",1,0],["أَخي ما أَخي ما مِن أَخٍ كانَ مِثلَهُ","لِلَيلَةِ ريحٍ لِلقِرى وَنَصيرِ",41,"ر",1,0],["أَخي وَخَليلي التَغلِبِيَّ وَدونَهُ","سَخاويُّ تَنضى في الفَيافي رِكابُها",42,"ب",3,0],["أَخي ثِقَةٍ لا تُتلِفُ الخَمرُ مالَهُ","وَلَكِنَّهُ قَد يُهلِكُ المالَ نائِلُه",43,"ل",2,0],["أَخي أَنَّ أَملاكاً تَوافَوا إِلى البِلى","وَكانَت لَهُم في مُدَّةِ العَيشِ آياتُ",44,"ت",1,0],["أُخَيَّ أَما تَرى دُنياكَ داراً","تَموجُ بِأَهلِها وَلَها بُحورُ",45,"ر",1,0],["أَخَيَّ أَضَعتَ أُموراً أَراكَ","لِنَفسِكَ فيها قَليلُ النَظَر",46,"ر",1,0],["أُخَيَّ إِذا الجَديدانِ اِستَدارا","أَرَتكَ يَداهُما حَصداً وَزَرعا",47,"ع",2,0],["أَخَيَّ ما سَكَنَت ريحٌ وَلا عَصَفَت","إِلّا لِتُؤذِنَ بِالنُقصانِ وَالتَلَفِ",48,"ف",1,0],["أُخَيَّ آخِ المُصَفّى ما اِستَطَعتَ وَلا","تَستَعذِبَنَّ مُؤاخاةَ الأَخِ النَطِفِ",48,"ف",1,0],["أُخَيَّ عِندي مِنَ الأَيّامِ تَجرِبَةٌ","فيما أَظُنُّ وَعِلمٌ بارِعٌ شافِ",49,"ف",1,0],["أُخَيَّ إِنّا لَنَحنُ الفائِزونَ غ