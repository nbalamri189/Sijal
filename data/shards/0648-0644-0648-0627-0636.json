{"poems":[[65,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[53,"إذا أبو قاسم جادت لنا يده","https://www.aldiwan.net/poem64109.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[303,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[466,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91078","الكامل"],[5064,"رُواء","https://www.poetsgate.com/ViewPoem.aspx?id=199109",""],[5790,"بديع الحسن ما هذا التجني","https://www.poetsgate.com/ViewPoem.aspx?id=112154",""],[5842,"يا شام (د. جمال مرسي)","https://www.poetsgate.com/ViewPoem.aspx?id=65846",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""]],"verses":[["ولوْ أضْمَرَتْ فيهِ العَداوَةَ أنْفُسٌ","لحدّثَ عن أسرارِهِنَّ قُلوبُها",0,"ب",3,0],["ولو أضاءتْ لنا أنوار غُرّته","تَضاءل النَّيران الشمس والقمر",1,"ر",1,0],["وَلَو أَضاعَ الناسُ هَذا الدُنيا","لَقَعَدوا يَبغونَهُ سِنينا",2,"ن",2,0],["ولو أضاءتْ بجوِّ الغربِ دعوته","لَدانَ بالرفقِ أَو عَنْ غيّه لصحا",3,"ح",2,0],["ولو أَضعف المسرى البعيدُ جيادهُ","لأوجف بالعزم الجريِّ وأوسعا",4,"ع",2,0],["ولو اضحى لهذي الارض قلب","سمعنا منه رجفان الوجيب",5,"ب",1,0],["وَلَواضحٌ عذرُ النَواظرِ إن تكن","نظرت أَحاسنَ ما سواه قِباحا",6,"ح",2,0],["ولَوْ أضحَيتُ قُربَكِ لَنْ ترَيَنِي","لأنَّي كُنتُ مُحترِقًا طَوِيلا",7,"ل",2,0],["ولو أضحى على تلفي مصرا","لقلت معذبي بالله زدني",8,"ن",2,0],["ولَو أَضحَتِ الدُّنيَا جَحِيماً ، فَغَرِّدَا","بَعِيدَيْنِ عَن سِربٍ قَلاهُ نِظَامُ",9,"م",1,0],["ولو أضمرت للأنواء حرباً","لما طلعت لهيبتك الغيوم",10,"م",1,0]]}