فيف"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113038","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127365","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127380","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91589","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36734","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86394","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[5644,"كان دربا من عناد","https://www.poetsgate.com/ViewPoem.aspx?id=199956",""],[6213,"صدور الحادثات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76270&r=&rc=27",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[5190,"حكايتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78304&r=&rc=17",""]],"verses":[["علّنا نستفيق من رقدة الفق","ر فنَغنَى بفيضك المزداد",0,"د",1,0],["عَلَّني أحمدٌ من الدُّوشاب","شَربةً بَغَّضَتْ قِنَاعِ الشبابِ",1,"ب",1,1],["عَلَّني أَستَريحُ مِنهُم فَقَد صا","روا كَظِلّي في جَيئَتي وَذَهابي",2,"ب",2,0],["علَّني أَستطيعُ أَنْ أَتغنَّى","لجمالِ الدُّجى بوحيِ العُيونِ",3,"ن",1,0],["عَلَّنيهِ خوطُ إِسحِلَةٍ","لانَ مَتناهُ لِمُهتَصِرِه",4,"ر",2,0],["عَلَّنيهِ بدرٌ من الأنسِ يا مَنْ","ظنَّ بالبدرِ أنّه إنسيُّ",5,"ي",1,0],["عَلَّني مِنهُ أَشتَفي","بِالنَسيمِ المَضَمَّخِ",6,"خ",1,0],["عَلَّني أَسرى عَلى مِنهاجِهِ","أَو أُوافي مَعهُ ذاكَ البَلَد",7,"د",1,0],["علَّني أعلَمُ بعضَ","العِلمِ ما مَعنى السُرور",8,"ر",1,0],["علّني أرشِدُ إن أوقَدتُها","ذلكَ الضائِعَ منّي في الضباب",9,"ب",1,0],["عَلَّني أروي قصيدي","حين يوحي شِعْرُ جِنّي",10,"ن",2,0],["علّني ألقى غرامي في","سمائي بعد حين",11,"ن",1,0],["علّني انظر في صفحتها","مأتم عرسي",12,"ي",1,0],["عُلَندى مِصَكّاً قَد أَضَرَّ بِعانَةٍ","لِما شَذَّ مِنها أَو عَصاهُ عَذومُ",13,"م",1,0],["عَلَنداةُ أَسفارٍ إِذا نالَها الوَنى","وَماجَت بِها أَنساعُها وَضُفورُها",14,"ر",3,0],["علّنا مِن بَعد نَهل فَشَفى","علّة الصابي بِتَعليل المصابِ",15,"ب",1,0],["علّني أرسم منها","عالما تخفي شعوره",16,"ه",1,0],["علَّني أن أراه يوماً فيطفي","نار وجدٍ فيب القلب ذات وقودِ",17,"د",1,0],["علّنا نَلقَى خَيالاً مِنكم","بلذيذ الذّكر وَهناً عَلّنا",18,"ن",2,0],["علّنا من وجه هذا ال","لوح أن نمحو سطورا",19,"ر",2,0],["علَّنا نحظى وتُسْعدنا","بالحِظا في الدهر أقدار",20,"ر",1,0],["علنا ننتهي على نغم حلو","كحلمين من رؤى العشاق",21,"ق",1,0],["علندي كأن الحص خالط لونه","اذا الخطو عن أعلى صلاه تقربا",22,"ب",2,0],["علنا أن نجلل كل عضب","نجيعاً من دمائكم ثخينا",23,"ن",2,0],["عَلَّنِّي أن أبثها بعض ما لي","من تصابي من بان عن مغناها",24,"ا",3,0],["علَّني أهتدي إلى نور طيفٍ","فرطُ شوقي له أضاع منامي",25,"م",2,0],["علني ألقى حياتي في الردى","فايزاً منه بأوفى النعم",26,"م",1,0],["علَّنا نقطع الزمان سكارى","لا نبالي بما جرى يا نديم",27,"م",1,0],["علني أسطو على شي","ء أغنيه نشيد",28,"د",1,0],["علني أدرك كنهي","فأرى جسمي وروحي",29,"ي",1,0],["علّني أَنسى بهذا","ما قَضى دَهري وَصارا",30,"ر",2,0],["عَلّنيها بُعَيد هَدءٍ نَدِيمي","وَالثُرَيّا لِلغَربِ تَهوى سَريعَه",31,"ع",2,0],["علنا أن نبل حر غليل","زاد بالبين حرقة والتهابا",32,"ب",2,0],["علَّني بذكر من حلَّ فيها","ان قلبي يطيب بالتعليل",33,"ل",1,0],["علّني ألهو بأحلام ِ المعاني","إن شربتُ الرّوحَ في جوفي القحيل",34,"ل",1,0],["علني أشرككم في موقف","بيراع أو حسام ذكر",35,"ر",1,0],["علنا بعد التجافي","يلتقي حبل الودادِ",36,"د",1,0],["علنا نصير خيانة من أجلها","عصب الحياة مذلة ويضير",37,"ر",1,0],["علّ نار الشجو تُذكي نخوةً","في الأَُلى اعتادوا مع الدهر المصابا",38,"ب",2,0],["علّني يا بنتَ أنفاس الرُّبى","أجتني منكِ الثمارَ الناضره",39,"ر",2,0]]}