{"poems":[[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[51,"علني أحمد من الدوشاب","https://www.aldiwan.net/poem8651.html","الخفيف"],[91,"خرج الناس يشترون هدايا","https://www.aldiwan.net/poem8746.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[76,"ورضاب كأنه ما يمج الن","https://www.aldiwan.net/poem38849.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/4775","الرمل"],[130,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[198,"أوقديها وذريها في حشايا","https://www.aldiwan.net/poem39942.html","الرمل"],[255,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[329,"بعد حين ستواريني كما","https://www.aldiwan.net/poem55021.html","مجزوء الرمل"],[329,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[338,"كأني كسوت الرحل جونا رباعيا","https://www.aldiwan.net/poem45420.html","الطويل"],[338,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[354,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[454,"ها هو الشحاذ لصق البنك","https://www.aldiwan.net/poem61577.html","مجزوء الرمل"],[465,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[507,"يا وفود الله فزتم بالمنى","https://www.aldiwan.net/poem2397.html","الرمل"],[559,"إن للإحسان نورا","https://www.aldiwan.net/poem34550.html","مجزوء الرمل"]],"verses":[["علّنا نستفيق من رقدة الفق","ر فنَغنَى بفيضك المزداد",0,"د",1,0],["عَلَّني أحمدٌ من الدُّوشاب","شَربةً بَغَّضَتْ قِنَاعِ الشبابِ",1,"ب",1,1],["عَلَّني أَستَريحُ مِنهُم فَقَد صا","روا كَظِلّي في جَيئَتي وَذَهابي",2,"ب",2,0],["علَّني أَستطيعُ أَنْ أَتغنَّى","لجمالِ الدُّجى بوحيِ العُيونِ",3,"ن",1,0],["عَلَّنيهِ خوطُ إِسحِلَةٍ","لانَ مَتناهُ لِمُهتَصِرِه",4,"ر",2,0],["عَلَّنيهِ بدرٌ من الأنسِ يا مَنْ","ظنَّ بالبدرِ أنّه إنسيُّ",5,"ي",1,0],["عَلَّني مِنهُ أَشتَفي","بِالنَسيمِ المَضَمَّخِ",6,"خ",1,0],["عَلَّني أَسرى عَلى مِنهاجِهِ","أَو أُوافي مَعهُ ذاكَ البَلَد",7,"د",1,0],["علَّني أعلَمُ بعضَ","العِلمِ ما مَعنى السُرور",8,"ر",1,0],["علّني أرشِدُ إن أوقَدتُها","ذلكَ الضائِعَ منّي في الضباب",9,"ب",1,0],["عَلَّني أروي قصيدي","حين يوحي شِعْرُ جِنّي",10,"ن",2,0],["علّني ألقى غرامي في","سمائي بعد حين",11,"ن",1,0],["علّني انظر في صفحتها","مأتم عرسي",12,"ي",1,0],["عُلَندى مِصَكّاً قَد أَضَرَّ بِعانَةٍ","لِما شَذَّ مِنها أَو عَصاهُ عَذومُ",13,"م",1,0],["عَلَنداةُ أَسفارٍ إِذا نالَها الوَنى","وَماجَت بِها أَنساعُها وَضُفورُها",14,"ر",3,0],["علّنا مِن بَعد نَهل فَشَفى","علّة الصابي بِتَعليل المصابِ",15,"ب",1,0],["علّني أرسم منها","عالما تخفي شعوره",16,"ه",1,0],["علَّني أن أراه يوماً فيطفي","نار وجدٍ فيب القلب ذات وقودِ",17,"د",1,0],["علّنا نَلقَى خَيالاً مِنكم","بلذيذ الذّكر وَهناً عَلّنا",18,"ن",2,0],["علّنا من وجه هذا ال","لوح أن نمحو سطورا",19,"ر",2,0]]}