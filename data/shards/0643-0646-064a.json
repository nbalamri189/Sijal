poetsgate.com/ViewPoem.aspx?id=1310",""],[5480,"خزني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=1587",""],[5480,"(هذا الزمن) في غلاء المهور","https://www.poetsgate.com/ViewPoem.aspx?id=4166",""],[5480,"حال الموده","https://www.poetsgate.com/ViewPoem.aspx?id=6943",""],[5480,"حساب الغلى","https://www.poetsgate.com/ViewPoem.aspx?id=34459",""],[5480,"يا وجد","https://www.poetsgate.com/ViewPoem.aspx?id=35636",""],[5525,"فكرة","https://www.poetsgate.com/ViewPoem.aspx?id=7178",""],[5525,"أنا النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=860",""],[5526,"روعة الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=204615",""],[5572,"الدمع والقنديل","https://www.poetsgate.com/ViewPoem.aspx?id=53589",""],[5573,"ترجمتك في صمتي بوح","https://www.poetsgate.com/ViewPoem.aspx?id=200071",""],[5573,"تدرين انا محتار ياكثر اساميك","https://www.poetsgate.com/ViewPoem.aspx?id=200072",""],[5573,"الله وكيلي","https://www.poetsgate.com/ViewPoem.aspx?id=200181",""],[5652,"فقر وضيق","https://www.poetsgate.com/ViewPoem.aspx?id=142797",""],[5690,"كنيسةٌ لبني مارون قد بنيت","https://www.poetsgate.com/ViewPoem.aspx?id=172259",""],[5747,"الرجم","https://www.poetsgate.com/ViewPoem.aspx?id=61672",""],[5756,"اربع خناجر","https://www.poetsgate.com/ViewPoem.aspx?id=5190",""],[402,"لغت أقصى العمر الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36477",""],[5829,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=162454",""],[5848,"أيات الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=48976",""],[5848,"خمسة عشر ماتوا علشان صندق","https://www.poetsgate.com/ViewPoem.aspx?id=53364",""],[5848,"الخطا شين","https://www.poetsgate.com/ViewPoem.aspx?id=53176",""],[5848,"ليل السهر","https://www.poetsgate.com/ViewPoem.aspx?id=48819",""],[5937,"غيمتان","https://www.poetsgate.com/ViewPoem.aspx?id=211886",""],[5948,"قلتُ ونفسي جَمُّ تأوُّهُها","https://www.poetsgate.com/ViewPoem.aspx?id=100621",""],[6093,"كُنْ يا عُبيدُ على حذر(مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181611",""],[6115,"معكازي رفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=180537",""],[6115,"سلام ياديره عليها الزمن طاف","https://www.poetsgate.com/ViewPoem.aspx?id=181383",""],[6131,"على سلَّمِ المَوتِ نهْتديْ","https://www.poetsgate.com/ViewPoem.aspx?id=189334",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""]],"verses":[["كُنَّ يَبكينَ قَبلَهُ مِن وَداعي","فَبُكاهُنَّ بَعدَهُ مِن سَلامي",0,"م",2,0],["كَنِيسَةُ اللهِ بِهِ بَلَغَتْ","غَايَتَهَا مِنْ رِفْعَةِ الشَّأنِ",1,"ن",1,0],["كُن ياقَوِيُّ لِذا الضَعي","فِ وَيا عَزيزُ لِذا الذَليلِ",2,"ل",1,0],["كنيةُ السَّفاح أهداها له","مع ميراثِ النبيّ المتَّبَعْ",3,"ع",1,0],["كنيته شِقَّةُ السلامة وال","سلمِ سلامٌ لتلك في الشقق",4,"ق",1,0],["كنّ ينبن عنك في الليل","الطويل اللازب",5,"ب",1,0],["كَنيسَةٌ صارَت إِلى مَسجِدِ","هَدِيَّةُ السَيِّدِ لِلسَيِّدِ",6,"د",1,1],["كَنيسَةٌ كَالفَدَنِ المُعتَلي","وَمَسجِدٌ كَالقَصرِ مِن أَصيَدِ",6,"د",1,0],["كُنينا وَأُمِّرنا وَغُنمُ يَدَيكَ في","تَرادُفِ أَيّامِ العُلا وَاِعتِقابِها",7,"ب",3,0],["كنيسةُ اليهودِ في","إنقاذِها مصالحُ",8,"ح",1,1],["كَنّي عَلى حَقباءُ تَتلو لَواحِقاً","غَدَونَ بِإِمساءٍ يُطالِبنَ مَنهَلا",9,"ل",2,0],["كن يا دعيُّ إلى الأمجاد منتسباً","فإنما المرءُ مأمون على النسب",10,"ب",1,0],["كن يا ظَلام من الضياء ومن أَتى","متهدداً لي في الضياء مجيري",11,"ر",2,0],["كني محمدٍ نسبي مفيدي","ودادك والهوى أمر بديّ",12,"ي",1,0],["كنيتن بين الضلوع المستعلّه","لو أبزفرها .. تفاضت مقلتيني",13,"ن",2,0],["كن يا زمانُ على ما أشتهيهِ فلي","فضلٌ ذوو الفضلِ تدريهِ وتقدرهُ",14,"ر",2,0],["كَنَيتُ عَنِ المَحبُوبِ بالغَيرِ غَيرةً","وَقَلبي بَرِيءٌ في هَوَاهُ مِنَ الشِّركِ",15,"ك",1,0],["كَنيسَةً حَدَرَت عادٌ حِجارَتَها","مِنَ الجِبالِ الَّتي شَرقِيَّ لُبنانا",16,"ن",2,0],["كن يا عريفي بعيدا","عن مثل هذى المزالق",17,"ق",1,0],["كنَّ يُسمِعنني غِناءً رَخيماً","أو يغازلنني بصوتِ الطيور",18,"ر",1,0],["كِنيُّ أبيه بُورِك اسْماً وكُنْيَةً","على النَّجلِ من وَسميْهما كرَمُ النَّجرِ",19,"ر",1,0],["كَنِيُّ خيرِ عبادِ اللهِ كُلِّهمُ","من شائدي دُوَلٍ أو شارعي مِلَل",20,"ل",1,0],["كَنَى باسم عِزِّي أنه اغتاله الردى","ونفسي عَنَى لو كان يعلَم من يكني",21,"ن",2,0],["كُن يا نَديمي طيبَ النَفسِ","فَيَومُنا أَحسَنُ مِن أَمسِ",22,"س",1,1],["كنيفهم وما يقال","في مثله والاسم دال",23,"ل",1,0],["كَنيلِكَ العِلْمَ إذا نِلْتَهُ","وكُنْتَ في أَربْابِهِ الأَكْبَرا",24,"ر",2,0],["كن يا زماني كيف شئتَ فلن ترى","شخصَ المذلّةِ لائذاً بلُباني",25,"ن",2,0],["كُنْ يا أباهُ كإبراهيمَ حينَ سَخا","لرَبِّهِ بابنهِ في ذلكَ الجَبَلِ",26,"ل",1,0],["كَنِيتُ عنِ اسمِهَا والإسمُ بادٍ","إذا ما الإسْمُ أَصْدَرَ مَنْ تَجَنَّبْ",27,"ب",1,0],["كَن يَدَّعي الشِعرَ قَومٌ لَو وَزَنَت بِهِم","هَدَرَت بَحراً وَساحوا سَيحَ أَوشالِ",28,"ل",1,0],["كنيُّ المصطفى وكفى ارتفاعاً","بمن يُكْنى بِكُنْيَتِهِ الرفيعه",29,"ع",2,0],["كُن يا اِبنَ وُدّي صَموتاً","فَالصّمتُ لِلمَرءِ حِرزُ",30,"ز",1,1],["كنيفُ الحمق قد طابَ","لَدَى جعلان ذا الخلق",31,"ق",1,0],["كنيّةِ القومِ من ذي الغضبةِ احتملوا","مستحقبينَ فؤاداً ما له فاد",32,"د",1,0],["كن يا إلهي مسعداً ومساعداً","لي في الشدايد يا عظيم الملتقى",33,"ق",2,0],["كِنْ يا غزال الحيّ معنىً لطيفِ","حلْو البشاشه والثغَر منك بسّام",34,"م",1,0],["كنيت عن ذكرها إذ لا أبوح به","لكن أتيت به كالدر منتظما",35,"م",2,0],["كُنّيتُ نَفسي كُنيَةً في شَعري","أَنا أَبو الفَقرِ وَأُمِّ الفَقرِ",36,"ر",1,0],["كن يا أمير المؤمنين مُسربلاً","بالفوز ما غنى الهزار على الشجر",37,"ر",1,0],["كن يا فؤادي رَحمَةً من عَبرةٍ","تَدمَى ولا تكُ قسوةً من جَوهَرِ",38,"ر",1,0],["كنيفٌ ولكنْ سُتِّرتْ جُدُراتُه","بِزَرّ قميص واشتمالِ رِداءِ",39,"ا",2,0],["كَنّيتُ عنها بذكر النجم تورية","وفي الكناية إجمال وتفسيرُ",40,"ر",1,0],["كنَّ ينطفنَ حياة","فغدونَ اليوم جلمد",41,"د",1,0],["كن يا سليمان الوزير مؤَازراً","للخاضعين وجارماً من يجرمُ",42,"م",1,0],["كن يوسف الحسن الذي","من طينه الحسن خلق",43,"ق",1,0],["كنيت عنه بالذي عنيته","وعند ما قنيته ثنيته",44,"ه",1,0],["كن يا أبا الفتح مفتاح النجاح لنا","وصارماً في خطوب الدهر إصليتا",45,"ت",2,0],["كنيتُ عنك بقولي أنت فاتنتي","فأصبحت كل حسناء تقول أنا",46,"ن",2,1],["كنَيِّر بان أَو شَمس النَهار بَدَت","أَو غادة خطرت بِالأَعيُن الدعج",47,"ج",1,0],["كنيته الغر أبو محمد","وأمه الزهراء بنت أحمد",48,"د",1,0],["كَنّي محصّل مِلك لولاي","باريس مَعْ لندن والاملاك",49,"ك",1,0],["كنيسة شُيِّت بالله مبهجةٌ","على اسمك المرتجى يا عرش مولاكِ",50,"ك",1,1],["كن يا زمان وهجرها إني فتى","لولا الغرام لفادح لم أخضع",51,"ع",1,0],["كُن يا رسولَ اللَهِ مَوئِلَ آثِمٍ","أضحىَ حليفَ الضُرّ والأَرزاءِ",52,"ا",2,0],["كنيسةٌ رُفِعَت فيها منابرُها","تَهدِي الوفودَ إلى التقوَى مواعظُها",53,"ظ",3,1],["كن يا فؤاد كما عهدتك آنفا","من ذا يلام على هوى وتصاب",54,"ب",1,0],["كنيت عنك بمن سواك موريا","بهوى سعاد وما هويت سعادا",55,"د",2,0],["كن يا ابنَ حرّازٍ لودِّي مُحرِزاً","لك في العهودِ تَليدُها وطريفُها",56,"ف",3,0],["كنيسةٌ جاءَ في تاريخها نبَأٌ","فلنسدي لِلَّه تسبيحاً وترتيلا",57,"ل",2,0],["كنيسة تلك أم كناس","وغلمة أم قطيع جؤذر",58,"ر",1,0],["كنّي اقرا على طرّت جبينك تقول","انا قلبي يحبك يا حبيبي تعال",59,"ل",1,0],["كني عطيتك بالوفى دوم ميثاق","وكنك خوي كفو مافيه حيله",60,"ل",2,0],["كني سجين بين..افراج ..واعدام","وكنك سجن وانا بنفسي بنيتك",61,"ك",1,0],["كني على لكزس وكنك بوانيت","يعني على ما قيل ماني بمرتاب",62,"ب",1,0],["كنّي تعودت ألم الضيق في عيني","ولا اقدر اخبي عن العالم تفاصيله",63,"ل",2,0],["كنّي عطيت العين من عينه قلاص","حتى سكر قلبي بنظرة حنينه",64,"ن",2,0],["كني شرار وصالي الهم كبريت","انا احترقت ولكن ابيه وابيه",65,"ي",2,0],["كني على مهوى المقادير وقفت","وقفة يتيمٍ حاير العقل بخطاه",66,"ا",2,0],["كنّي بدون اصحآب وْمآ عندي اقرآب","واحآول ازرع ( أي وآحد ) بدآلي",67,"ل",2,0],["كني اشوفك بالشوآرع تحومين","ومآبآقي إلا تقدحين السجآره",68,"ر",2,0],["كنّي مطية للشقا بين الأجلاف","لا روح تفهمني ولا قلب حاني",69,"ن",2,0],["كني ملكة الكون والعالم أذهالي","وكني كشفت البحر عن جملة احجابه",70,"ب",2,0],["كني وعيت الشعر وثبٍ وزلزال","وانتي الثبات اللي يوطد رصينه",71,"ن",2,0],["كنى أحس إن التعب قال : انا جاي","ومن دون روحي جبت روحي .. وجيته !",72,"ت",2,0],["كنيسةُ أهلِ عيسى دنَّسوها","كذا بالمسجدِ الأقصى حصارُ",73,"ر",1,0],["كنيف ديوانك مختوم","وأنت في دينك مزكوم",74,"م",1,1],["كُن يا حبيبُ على الدوامِ مغرداً","واصدحْ بشِعركَ بكرةً وأصيلا",75,"ل",2,0],["كُنْ يا طبيبَ القلب مبتدعاً","مُتشفّعاً بهما من البلوى",76,"و",2,0],["كنْ يا عراقُ أبا الحياةِ وأصلَها","شيخَ الزَّمانِ وسيِّداً وحَصُورا",77,"ر",2,0],["كُنِّي تكنْ قالَ الصدى لي عابرًا","ما شاءَمنْ أعماقه المتدفقهْ",78,"ق",2,0],["كني اشوفك : ترسمين","وأسمي يزيّن دفترك",79,"ك",1,0],["كنّي مع نجوم اللّيالي توظّفت","أساهر النّجمات حل المباتي",80,"ت",2,0],["كني المرماي بالنبل السليل","هو سباني الغر مزهاي بوشام",81,"م",1,0],["كني على بغلن عقب صفوة الخيل","طبع الزمن يرخى .. ومراتن فشده",82,"د",2,0],["كني أسير ٍ ما تهنىّ بسدّه","ولا مكبّل في سجون الغرايب",83,"ب",1,0],["كنّي أنا المخطي فدستور لْعتاب","ولازم علَّي آتوب وأرضي جهاده..",84,"د",2,0],["كني فغزوة رمحها سار معتد","عكر الوطيس اللي دماها تسيله",85,"ل",2,0],["كني سمعتك وكل العين منتثره","دمعٍ صرختي ما بين السيف والحافر",86,"ر",1,0],["كني بجبين الشمس .. والليل مفروق","وكني بدمعٍ .. فوق خده نضايد",87,"د",1,0],["كنّي أشوف بمبسمه روعة الغيم","وفياض تزهر في معاليق صدري",88,"ر",2,1],["كنّي بواد(ن) حدابه سيل","أرعبني الحزن بصياحه",89,"ح",2,0],["كني مع حالي مجهول","يبني لك صبري وتهد",90,"د",1,0],["كني وانا لاشفت حظرت معاليك","ضايع بلا احساس تايه وغادي",91,"د",2,0],["كني وانا اراقب مرافيك بادلاج","عاقل وانا سايح لبس بردة اخبيل",92,"ل",1,0],["كني وانا واقف على اطلال هداج","استنطق الي كان ينطق لي اقبيل",92,"ل",1,0],["كني بعد عينه غريبٍ عن الدار","وكنه بلادي وأكثر أكثر بلادي",93,"د",2,0],["كنيسةٌ لبني مارون قد بنيت","بجلّقٍ وغدا كالطور مرآها",94,"ا",3,1],["كني صويبٍ مالقى من يداويه","جر الونين وخالفته الرجاوي",95,"ا",3,0],["كني اللي حط بشفاه من جمر المليل","لا قدر يرميه للناس وزرا يبلعه",96,"ع",2,0],["كنيسة الله به بلغت","غايتها من رفعة الشا",97,"ش",2,0],["كن يا جند النيل عظيماً","ليثاً أو سبعً أو نسرا",98,"ر",2,0],["كني ب دمعك ذبّل عيونك الحور","وادري بعد .. رجليك ماعاد تحملك",99,"ك",1,0],["كني على شان السهر بس مخلوق","ما عاد عندي للسهر قابليّه",100,"ي",2,0],["كني أبد ما اخطيت وانتي تغاضين","عن غلطة الشاطر ما دام انه يمون",101,"ن",1,0],["كني غدير وكأنه من عمر ظامي","ولاعمري اخلفت مع حزني مواعيدي",102,"د",2,0],["كنيسَةٌ أنتِ ، هاقد جئتُ ، لا تذري","عينايَ مأسورةً في لعنةِ الحِرْمِ",103,"م",1,0],["كَنَيتهُ طرحُ نون كنيتِهِ","إذا تهجّيتَهَا ستفقهها",104,"ه",3,0],["كُنْ يا عُبَيدُ عَلىَ حَذَرْ","قَدْ فَازَ مَنْ هَجَرَ الغَرَرْ",105,"ر",1,1],["كني اقلّب على الجمر والملي","واشهد ان الجوف يشعل لواهيبي",106,"ب",2,0],["كني صويب طعنته بين الاكتاف","طايح ثلاث ايام مجروح ضامي",107,"م",2,0],["كنْ يَا صَديقي كهذا الطيرِ مُنْبَسِطًا","عزمًا يُسارعُ في نبضٍ وَ فيْ حُسُنِ",108,"ن",1,0],["كَنَّيتُ في شعري فما فادني","في ثورتي إلا الكلامُ الصريحْ",109,"ح",1,0]]}