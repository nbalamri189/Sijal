{"poems":[[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[88,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[49,"متى تتقضى حاجة المتكلف","https://www.aldiwan.net/poem62177.html","السريع"],[46,"أيأتي نبي يجعل الخمر طلقة","https://www.aldiwan.net/poem23498.html","الطويل"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/8786","الطويل"],[106,"على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179312",""],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[142,"إذا أنت ترحم عبدك الخائف المضنى","https://www.aldiwan.net/poem4462.html","الطويل"],[148,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[197,"يا من لنضو طريح","https://www.aldiwan.net/poem45153.html","المجتث"],[227,"كللت ودك لي بالبر والنفل","https://www.aldiwan.net/poem50842.html","البسيط"],[301,"أقسمت ما سجعت ورق الحمائم في","https://www.aldiwan.net/poem57890.html","البسيط"],[413,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[429,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[459,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[480,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[513,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[536,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[556,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[573,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"]],"verses":[["وَما أَكَلَ الخَطبُ مِن عِزِّنا","وَكُنّا لَهُ سَلَعاً أَو مُرارا",0,"ر",2,0],["وَمَا أَكْفَتِ اللَّقُيا وَإِنْ بعُدَ المَدَى","ويَا قُرْبَ مَا بَيْنَ المُعَجِّلِ والوَانِي",1,"ي",1,0],["وما أكل المطاعم لألتِذاذ","ولكن للحياة بها دوام",2,"م",1,0],["وما اكتَنَّ مُكْتَنٌّ ولا وفْرَ عنده","فلم يصْلَ نيرانَ الهُموم اللَّوازِمِ",3,"م",1,0],["وَما أَكرَمَ العَبدَ الحَريصَ عَلى النَدى","وَأَشرَفَ نَفسَ الصابِرِ المُتَعَفِّفِ",4,"ف",1,0],["وَما أَكَلا زادي وَلَكِن أَكَلتُهُ","وَقَد نَبَّهاني لِلسُرى وَاِستَفَزّاني",5,"ي",1,0],["وما أكثرَ المُثني علَيكَ ديانَةً","لو أنَّ حِماماً كانَ يَثنيهِ مَن يُثني",6,"ن",2,0],["وَما أَكثَرَ الإِخوانِ حينَ تَعُدُّهُم","وَلَكِنَّهُم في النائِباتِ قَليلُ",7,"ل",1,0],["وما اكتفوا بارتياد البحر، بل سَبَحُوا","كالجنِّ في عالم الأفلاك والسُّدُم",8,"م",1,0],["وما اكتوت الأيدي ولا احترق الحشا","بجمر كجمر لا يُشَب ولا يخبو",9,"ب",2,0],["وما اكؤس الاحسان دارت بفضلكم","على فتية حنوا إذا الليل قد جنا",10,"ن",2,0],["وما أكثرت من عددٍ","فإن جميعها سلب",11,"ب",1,0],["وما أكابد ناراً","يروه نوراً أمامي",12,"ي",1,0],["وما أُكافِيك إلاّ عن هَوىً رَسَخَتْ","أصولُه فيك لم يَنْقُصْ ولم يَحُل",13,"ل",1,0],["وما اكتسى خدها من لؤلؤٍ عرقاً","لكنها وردةٌ بالطل قد رشحت",14,"ت",1,0],["وما اكتحلت عينايَ بالغمض بعدهم","كما اكتحلت بالغمض أعينهم بعدي",15,"د",2,0],["وما أكتَمَ البرّاض عنكَ وفِعلَهُ","وعندكَ أخبارُ اللطيمَةِ والمسْكِ",16,"ك",1,0],["وما اكتنفت يوم السلام من العُلى","أسِرَّتها والخاشفاتُ المخاذمُ",17,"م",1,0],["وما آكل ليلا وقد باء مفطرا","وذاك أوان الصوم عجل بفطرتي",18,"ت",2,0],["وما أكلف نعماك التي سبقت","أبا الفوارس إلا القوت والجاري",19,"ي",1,0],["ومَا اكتأبت منا القُلوبُ سِوى لكَى","يكُونَ سرورٌ للكَآبةِ تَالِيا",20,"ي",2,0],["وما أكواننا إلا ليال","وفيها أشرقت منك الشموع",21,"ع",1,0],["وما اكتفت بِكَتْب نُو","ن الصُّدْغِ حتى مَشَقَتْ",22,"ت",1,0]]}