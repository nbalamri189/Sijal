{"poems":[[55,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[79,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[90,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[51,"متى تتقضى حاجة المتكلف","https://www.aldiwan.net/poem62177.html","السريع"],[48,"أيأتي نبي يجعل الخمر طلقة","https://www.aldiwan.net/poem23498.html","الطويل"],[48,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/8786","الطويل"],[108,"على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179312",""],[108,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[148,"إذا أنت ترحم عبدك الخائف المضنى","https://www.aldiwan.net/poem4462.html","الطويل"],[154,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[203,"يا من لنضو طريح","https://www.aldiwan.net/poem45153.html","المجتث"],[234,"كللت ودك لي بالبر والنفل","https://www.aldiwan.net/poem50842.html","البسيط"],[308,"أقسمت ما سجعت ورق الحمائم في","https://www.aldiwan.net/poem57890.html","البسيط"],[422,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[438,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[466,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[487,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[520,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[543,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[563,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[580,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87166","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34427","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63992","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77627","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123441","الرجز"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198680","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19973","الوافر"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17738","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74292","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11296","الوافر"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123943","الطويل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103612","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126929","البسيط"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127814","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45852","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95337","الرجز"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72431","الرجز"],[4782,"من يخبر الصبح...؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=198725",""],[4915,"أُمُّ الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=213097",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[5358,"حبات الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=21760",""],[5431,"تُضاء بنا الأكوان حبا ولن نُطفا","https://www.poetsgate.com/ViewPoem.aspx?id=193477",""],[5431,"الحسين...","https://www.poetsgate.com/ViewPoem.aspx?id=215715",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""]],"verses":[["وَما أَكَلَ الخَطبُ مِن عِزِّنا","وَكُنّا لَهُ سَلَعاً أَو مُرارا",0,"ر",2,0],["وَمَا أَكْفَتِ اللَّقُيا وَإِنْ بعُدَ المَدَى","ويَا قُرْبَ مَا بَيْنَ المُعَجِّلِ والوَانِي",1,"ن",2,0],["وما أكل المطاعم لألتِذاذ","ولكن للحياة بها دوام",2,"م",1,0],["وما اكتَنَّ مُكْتَنٌّ ولا وفْرَ عنده","فلم يصْلَ نيرانَ الهُموم اللَّوازِمِ",3,"م",1,0],["وَما أَكرَمَ العَبدَ الحَريصَ عَلى النَدى","وَأَشرَفَ نَفسَ الصابِرِ المُتَعَفِّفِ",4,"ف",1,0],["وَما أَكَلا زادي وَلَكِن أَكَلتُهُ","وَقَد نَبَّهاني لِلسُرى وَاِستَفَزّاني",5,"ن",2,0],["وما أكثرَ المُثني علَيكَ ديانَةً","لو أنَّ حِماماً كانَ يَثنيهِ مَن يُثني",6,"ن",2,0],["وَما أَكثَرَ الإِخوانِ حينَ تَعُدُّهُم","وَلَكِنَّهُم في النائِباتِ قَليلُ",7,"ل",1,0],["وما اكتفوا بارتياد البحر، بل سَبَحُوا","كالجنِّ في عالم الأفلاك والسُّدُم",8,"م",1,0],["وما اكتوت الأيدي ولا احترق الحشا","بجمر كجمر لا يُشَب ولا يخبو",9,"ب",2,0],["وما أكرم الصحراء .. تصدى .. ونمنمت","لنا برد ظل كالنعيم رطيب",10,"ب",1,0],["وما أكبرت نفسي سوى الحقّ قوّة","وإن كان في الدّنيا لها النّهي والأمر",11,"ر",1,0],["وما أكرم النسيان والعفو منكم","إذا لم يضع حق ولم يحتسب وتر",11,"ر",1,0],["وما اكؤس الاحسان دارت بفضلكم","على فتية حنوا إذا الليل قد جنا",12,"ن",2,0],["وما أكثرت من عددٍ","فإن جميعها سلب",13,"ب",1,0],["وما أكابد ناراً","يروه نوراً أمامي",14,"م",2,0],["وما أُكافِيك إلاّ عن هَوىً رَسَخَتْ","أصولُه فيك لم يَنْقُصْ ولم يَحُل",15,"ل",1,0],["وما اكتسى خدها من لؤلؤٍ عرقاً","لكنها وردةٌ بالطل قد رشحت",16,"ت",1,0],["وما اكتحلت عينايَ بالغمض بعدهم","كما اكتحلت بالغمض أعينهم بعدي",17,"د",2,0],["وما أكتَمَ البرّاض عنكَ وفِعلَهُ","وعندكَ أخبارُ اللطيمَةِ والمسْكِ",18,"ك",1,0],["وما اكتنفت يوم السلام من العُلى","أسِرَّتها والخاشفاتُ المخاذمُ",19,"م",1,0],["وما آكل ليلا وقد باء مفطرا","وذاك أوان الصوم عجل بفطرتي",20,"ت",2,0],["وما أكلف نعماك التي سبقت","أبا الفوارس إلا القوت والجاري",21,"ر",2,0],["ومَا اكتأبت منا القُلوبُ سِوى لكَى","يكُونَ سرورٌ للكَآبةِ تَالِيا",22,"ي",2,0],["وما أكواننا إلا ليال","وفيها أشرقت منك الشموع",23,"ع",1,0],["وما اكتفت بِكَتْب نُو","ن الصُّدْغِ حتى مَشَقَتْ",24,"ت",1,0],["وَما اِكتَفى بِالجَفا حَتّى رَمى خلَدي","عَمداً بسهم لَياليهِ فَأَصماني",25,"ن",2,0],["وَما اِكتفت بِقَبيح الذنب تصنعُهُ","حَتّى أَصرَّت عَلَيه حينَ تَرتَكِبُ",26,"ب",1,0],["وما اكتفيتَ بأن أُلْفيتَ مُتّبعاً","في الجود حتى لقد أُلفِيت مُبْتَدعا",27,"ع",2,0],["وَما اِكتَفى بِصَيدِه وَلا اِقتَنع","بَل شَرَهاً زادَ وَأَعماه الطَمَع",28,"ع",1,0],["وما اكتفى باللحن وال","تخليط حتى لحنا",29,"ن",2,0],["وما اكتحلت عيني بمثل ابن يوسف","ولست أحاشي الشمس من ذا ولا البدرا",30,"ر",2,0],["وَما اِكتَحَلَت بِهِ عَينٌ فَتَبقى","مُسَلَّمَةَ الضَميرِ مِنَ الذُنوبِ",31,"ب",1,0],["وَما أَكثَرَ التَعويلُ إِلّا لَجاجَةٌ","وَما السِرُّ بَينَ الناسِ إِلّا وَدائِعُ",32,"ع",1,0],["وَما أُكر الرُمان في أَصله سوى","نُهود عَلَيها حالك الشعر ينثر",33,"ر",1,0],["وَما اِكتَسَبَ المَحامِدَ طالِبوها","بِمِثلِ البِشرِ وَالوَجهِ الطَليقِ",34,"ق",1,0],["وما اكتفيتُ بتمهيد الطريق لهم","بل رمتُ تشتيت منها شمل كلٍ كم",35,"م",1,0],["وما أكثر الداعي بنا لهداية","وما للهدى منا سوى الهد والهدم",36,"م",1,0],["وما أكثر الأقوام إلا ثعالبا","تروغ ولا يجلي لديها بطائل",37,"ل",1,1],["وما اكتسبتم بوفر تبخلون به","وفي مكارمه حسن الثنا اكتسبا",38,"ب",2,0],["وما اكتملَ الرثاءُ عليك مني","ولو صارت مياه البحر حِبرا",39,"ر",2,0],["وَما أَكرم الحُر الَّذي صارَ باذِلاً","كَرائم أَموال لِصَون الكَرائم",40,"م",1,0],["وما أكلت عندهم أكالا","وألية الكبش وزيد آلي",41,"ي",1,0],["وما اكتفى الحب كشف الشمس منه أذى","حتى انثنى يخجل الاغصان حين يمي ل",42,"م",3,0],["وما اكتفيت بتمهيد الطريق لهم","بل رمت تشتيت منها شمل كل كمي",43,"م",2,0],["وما اكتسا من شعره بوفرة","إلا رأيت الصبح بالليل اكتسا",44,"س",2,0],["ومااكتست بشجون النفسِ أوردةٌ","الا تسامت هبات النور تلقاه",45,"ا",2,0],["وما أَكثرَ المُدَّعينَ الحقيقةَ","والمُدَّعي ساذجٌ ودَعيُّ",46,"ي",1,0],["وما اكترثت لأموالٍ رزئت بها","وقمت بالعبء عند الله محتسبا",47,"ب",2,0],["وما أكبَرْتُ سِحْرَكِ غيرَ أني","لقد أكْبَرْتُ قُدْرَتَهُ تعالى",48,"ل",2,0],["وما أكثر الآلام تعوي كأنها","ترانيم اعصارٍ يهب بنا عصفا",49,"ف",2,0],["وماأكثر الخلق الكنود بمؤمنٍ","ولو جئته حرصا سيضني تنمّره",50,"ر",2,0],["وماأكفر الإنسان إنْ لجَّ فكره","يقرّ بإعجاز الحياة وينكره!!",50,"ر",2,0],["وما اكتَفَيتَ ، فأرسَلتَ الجَرادَ الى","زَرعِي ، فأكبَرتُهُ في حَلْقِهِم أَسَلا",51,"ل",2,0],["وما أكبرُ الأصنامِ إلاَّ خلافنا","فهلْ عُمْرُ إبراهيمَ في دمنا رَدْحُ !",52,"ح",1,0]]}