poetsgate.com/ViewPoem.aspx?id=99715",""],[6023,"ألؤلؤٌ نظمُ هذا الثُّغر أم حبب","https://www.poetsgate.com/ViewPoem.aspx?id=123853",""],[6064,"وإني وإن أُلبسْتُ ثوبَ خصاصة","https://www.poetsgate.com/ViewPoem.aspx?id=96329",""],[6093,"أضْجَرتني _يا غبيُّ_ لا تسلِ ( المنسرح )","https://www.poetsgate.com/ViewPoem.aspx?id=176487",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["وَما اِرتاعَ مَطلوبٌ يَكونُ وَراءَهُ","بِأَغلَبَ مِن آلِ النَبِيِّ هِجانِ",0,"ن",1,0],["وَما أَرَبي بِسُؤالِ الطُلو","لِ إِلّا تَذَكُّرُ ماضي زَماني",1,"ن",2,0],["وَما أُريقَ بِأَعلى الخَيفِ مِن عَلَقٍ","تُوجى لَهُ البُدُنُ المُلقاةُ وَالجُزُرُ",2,"ر",1,0],["وَما أَراكِ أَرى في الناسِ قائِلَةً","لاقى أَبو الفَضلِ ما لَم يَلقَهُ لاقِ",3,"ق",1,0],["وَما أَرى اِثنَينِ حَالَ الناسُ بَينَهُما","مِثلي وَمِثلَكِ في جَهدٍ وَإِضرارِ",4,"ر",1,0],["وَما أَرى مِثلَكُم في الناسِ مِن بَشَرٍ","فَقَد رَأَيتُ بِهِ حَيّاً وَنِسوانا",5,"ن",2,0],["وَمَا أَرْسِلَتْ خَيْلُ الصَّبَاحِ عَلَى الدُّجَى","فَتُبْصِرُهَا مِنْ أَشْهَبٍ خلْفَ أَدْهَمِ",6,"م",1,0],["وَما أَرادَ بِها نُعمى يُثابُ بِها","إِن قالَ كَلمَةَ مَعروفٍ بِها نَفَعا",7,"ع",2,0],["وَما أَرجوهُ مِن بَلَدٍ","بِهِ ضاقَ الرَجاءُ وَبي",8,"ب",2,0],["وما أرضها إلا خزائنُ رحمةٍ","وما قد سما من فوق ذاك غطاؤُها",9,"ا",3,0],["وما ارتجفت بجُنح الليل إلا","لتضحك فيه مما يزعمونا",10,"ن",2,0],["وما ارتحلت عنا الركائب وحدها","ولكن روحي للركائب تالِ",11,"ل",1,0],["وَمَا أرضَى بِغَيرِ بَلاَءِ سُوءٍ","لِهَمدَان التربُّص والأَنِينَا",12,"ن",2,0],["وَمَا أَرضَى لهُم أَلاَّ يَضُرُّوا","عَدُوَّهُمُ وأَلاَّ يِنفَعُونَا",12,"ن",2,0],["وما أرقت حتَّى سريت كأنما","مقامكَ فيها كانَ طيف منام",13,"م",1,0],["وما أرى اللّه امرَأً وجهَهُ","إلا أراهُ ولداً طيّبا",14,"ب",2,0],["وما أرَى التقصير يُخشَى على","فعلك بل يُخشى على شاكرِهْ",15,"ر",2,0],["وما أراه على حال تعف له","أنثى ولو حمقت حتى تكون دُغَه",16,"غ",2,0],["وما أردتَ بإغباب الندى قسماً","إجمامَ مالكَ بل إجمام حَسْراكا",17,"ك",2,0],["وما أرجّي سماحاً منه مُطَّرفاً","لكن سماحاً تليداً فيه لم يزلِ",18,"ل",1,0],["وما ارتفعت كهمَّتك الثريّا","ولا وألتْ كجاريك الوعولُ",19,"ل",1,0],["وما أُراني يفوزُ مُطَّرحي","وما أُراني يخيبُ مُعتامي",20,"م",2,0],["وما أُراني سَجيسَ الدهر جازيَهُ","بمثل مَدْحي به يَحيَى بن خاقان",21,"ن",1,0],["وَما أَرضُ عَبّادٍ إِذا ما هَبَطتَها","بِحَزنٍ وَلا أَعطانُها بِجُدوبِ",22,"ب",1,0],["وَما أَرواحُنا إِلّا أَسارى","وَما أَجسادُنا إِلّا سُجونُ",23,"ن",1,0],["وَما أَربَت عَلى العِشرينَ سِنّي","فَكَيفَ مَلِلتُ مِن طولِ البَقاءِ",24,"ا",2,0],["وَما أَرضى لِمُقلَتِهِ بِحُلمٍ","إِذا اِنتَبَهَت تَوَهَّمَهُ اِبتِشاكا",25,"ك",2,0],["وَما أَرضَتكَ مِن مُهَجِ المَوالي","غَداةَ رُزِئتَها مُهَجُ العَبيدِ",26,"د",1,0],["وَما ارتَبتُ في آلِ المُدَبِّرِ أَنَّهُم","إِذا اِنتَسَبَت غُرُّ المَكارَمِ آلُها",27,"ل",3,0],["وَما أَرجو لِطَيبَةَ غَيرَ رَبّي","وَغَيرَ اِبنِ الوَليدِ بِما أَعانا",28,"ن",2,0],["وما أُرقِّع ثوباً فيك منخرقاً","لكن أرقِّع جُرحاً غير ملتئم",29,"م",1,0],["وَما أَرَّقَ الأجفانَ إِلّا بَلابِلٌ","تُسامِرُها بَينَ الضلوعِ بَلابِلي",30,"ل",2,0],["وَما أَرغَتِ الكَأسُ في كَفِّهِ","وَلَكِنَّها ضَحِكَت عَن سُرورِ",31,"ر",1,0],["وَما أَروى وَإِن كَرُمَت عَلَينا","بِأَدنى مِن مُؤَقَّفَةٍ حَرونِ",32,"ن",1,1],["وما أُرَى بَيتَ مالِ المسلمينَ دَرَى","مِنْ أَيْنَ تأتي لهُ الأكياسُ وَالبِدَرُ",33,"ر",1,0],["وَما أَرى كُلَّ قَومٍ ضَلَّ رُشدُهُمُ","إِلّا نَظيرَ النَصارى أَعظَموا الصُلُبا",34,"ب",2,0],["وَما أَرى دَرَجاتِ الفَضلِ مُغنِيَةً","عَنِ الفَتى عادَ مَحثوثاً لِإِدراجِ",35,"ج",1,0],["وَما أَرضاكَ رَأيٌ مِن دُرَيدٍ","غَداةَ يَرومُ قُرباً مِن خُناسِ",36,"س",1,0],["وَما أَرَّقَتهُ الحادِثاتُ وَكُلُّنا","إِذا نابَ خَطبٌ ساهِرُ اللَيلِ آرِقُه",37,"ق",2,0],["وَما اِرتابَ في لُقيا الرَدى وَكَأَنَّهُ","حَديثٌ أَتى مِن كاذِبٍ يُبطِلُ الزَعما",38,"م",2,0],["وما أرى هل في غدٍ لي ثواء","بالخلدِ أمْ مثوايَ نارُ الجحيمْ",39,"م",1,0],["وما أرغب المرء في عيشه","ولكن قصاراه سكنى الجدث",40,"ث",1,0],["وما أرَبي إلاّ مُعَرّسُ مَعْشَرٍ","همُ الناسُ لا سُوقُ العروسِ ولا الشطّ",41,"ط",1,0],["وَما أَرضى اِنتِصافاً مِن سِواكُم","وَأُغضي مِنكَ عَن ظُلمٍ صُراحِ",42,"ح",1,0],["وما أرَى الموتَ إلّا باسطاً يدَهُ","مِن قبْلِ أن يُمْكِنَ المأسور إفْلاَتُ",43,"ت",1,0],["وما أرْتَجي منْ بُقْعَةٍ قدْ هجَوْتها","لقدْ ظَفِرَتْ بي فهْيَ تُعْمِلُ أطْرافي",44,"ي",1,0],["وما أرخصت قدرهم كثرةٌ","ولا هان غثٌ، وعزَّ سَمين",45,"ن",1,0],["وما أرتَضِيها مدةَ العمرِ خلّةً","ولا أصطفيها لو أخلَّد فيهَا",46,"ي",3,0],["وما أردتُ سلُواّ عن محبّته","إلا وقلبي على كُلِّى يُساعدُهُ",47,"د",2,0],["وَما أَراكَ بِما قَد كانَ مُقتَنِعاً","حَتّى يَبيدَ الهِلالِيّونَ كُلُّهُمُ",48,"م",1,0],["وما ارتفع الدنى به لفضل","على الأعلى ولكن بالقيام",49,"م",1,0],["وما أرى الدنيا سوى دولتي","ومن فنونِ الحبِّ هذا الجنونْ",50,"ن",1,0],["وما أرى قلبهُ يرقُ لنا","كأنما قلبهُ من الحجرِ",51,"ر",1,0],["وما أراها سوى الزمان أما","يدورُ فيها النعيمُ والنقمُ",52,"م",1,0],["وما ارى أعجبَ من جدوَلٍ","ينضبُ والأمواهُ في النهرِ",53,"ر",1,0],["وما ارتبتُ منه غير أنّ صدودَه","شجاني ومن يرتابُ بالقمرِ البدرِ",54,"ر",1,0],["وَما أَرابَكَ حَتّى","صَرَمتَ بِالهَجرِ حَبلي",55,"ل",2,0],["وَما أَراني بَعدُ مِن","داءِ الهَوى بِمُفرِقِ",56,"ق",1,0],["وَما أَرى لي بَينَهُم دَولَةً","تَرفَعُ مِن شَأني وَمِن قَدري",57,"ر",2,0],["وَما أَرَدتُ تَناسيه لأسلوَه","إِلّا وَذكرَّنيه هَزّةُ الغُصُن",58,"ن",1,0],["وما أرسلت من قفصٍ أتاني","وقلبي فيه وجداً بات طائر",59,"ر",1,0],["وَما ارفض من واهى العراكل مسجم","وَقوّم من نبت الثرى كل ساجد",60,"د",1,0],["وَما أربي إلا الرُّصافةُ لَوْ دَنَتْ","وَهل لِلْهوى إلا الرُّصَافةُ مَذْهبُ",61,"ب",1,0],["وَما أَرَبِي لَهُ فِي ماءِ مُزْنٍ","وَقَدْ وَدَّعْتُ مِنْهُ حَياً مَطِيرا",62,"ر",2,0],["وَما ارْتَشَفْتُ ثَنايا الْعَيْشِ عِنْدَكُمُ","إِلاّ وَجَدْتُ بِها مِنْ جُودِكُمْ شَنبَا",63,"ب",2,0],["وما أُرجّي من خافقٍ قرعتْ","صفاتَه النائباتُ فانصدعا",64,"ع",2,0],["وَما أَرضى بِها بَدَلاً","وَلَكِن تَحكُمُ الصورَةُ",65,"ر",2,0],["وما ارى أشباه","او ما ارى اشباح",66,"ح",1,0],["وَما أَرى بَرّي سِوى","قَولُ الفُجورِ قَد فَجَر",67,"ر",1,0],["وَما أَردى الحَسود عَلى هَواها","سِوى هَمٍّ 