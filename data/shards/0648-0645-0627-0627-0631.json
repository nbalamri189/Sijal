المهدي إذ حجبت","عينيه عن وجهه من نوره الحجب",147,"ب",1,0],["وما ارتاد قومٌ مسنتون لقوتهم","وضيفانهم بالزرع أو غيره زرعا",148,"ع",2,0],["وما ارْتاحَتِ الرُّكْبان إلا لأنّه","تُطارِحُنا بَثّ الهَوى ونُطارِحُ",149,"ح",1,0],["وما ارْتاعَتِ الشهبانِ إلا لأنهُ","تعالَى لهُ قَدْرٌ على الشهْبِ طامِحُ",149,"ح",1,0],["وما أرسلوا الا خلائف قبله","إلى الأمم الأولى ليهدي رشيدها",150,"د",3,0],["وما أرخصت تلك الدموع لهونها","عليها ولكن عز من حل في الثرى",151,"ر",2,0],["وما ارهق الطيف الزيارة بعدما","أعل فؤاداً كاد يندك جانبه",152,"ب",2,0],["وَما ارتضيتُ بَديلاً أَصطفى أَبَداً","اللَه يَعلم من أَهوى وَما أَجِد",153,"د",1,0],["وَما أَرضى سِوى خلِّي خَليلاً","وَلَيسَ يَفيد نصحك يا خَلِي لي",154,"ل",2,0],["وما أرهفت آذانًا","ولم آنَسْ بقُطَّانِ",155,"ن",1,0],["وما أرض عصته ولا سماء","ففيم يغول أنجمها انكدار",156,"ر",1,0],["وما ارعويتم ففاجأتم جزائرنا","في الارخيل وما فيهن مغتنم",157,"م",1,0],["وما أرادَ بهذا الأمرِ من مثلٍ","والامرُ أوضحُ من نارٍ على علمِ",158,"م",1,0],["وما ارعويت عن الدنيا وزخرفها","مع أنها بابتسام الثغر غرّاره",159,"ر",2,0],["وَما أَرَدناهُمُ عَن غَيرِ مَعذِرَةٍ","مِنّا وَلَكِنَّهُ قَد كانَ ما كانا",160,"ن",2,0],["وَما اِرتاعَ فَاِنصاعَ بَل ظَلَّ فيهِم","يُجيلُ مُثَقَّفَهُ وَيليهِم",161,"م",1,0],["وما أرجي سوى توحيد خالقنا","إذا بقيت وحيداً في دجى جدثي",162,"ث",2,0],["وما أَرى بلدةً أُخرى تُماثِلُها","في الحُسْنِ من مصرَ حتى مُنْتَهى الصِّينِ",163,"ن",1,0],["وما أراد وأعني بالقميص وقد","جاءوا عليه بشيء من دم كذب",164,"ب",1,0],["وما ارتبت أن نواصي الجياد","حبال المآرب إذ تجذب",165,"ب",1,0],["وَما اِرتَدّ حتّى رَدّ شرذمةً عدت","عَلى قَومِهِ بِالفَتكِ من كُلّ جانِبِ",166,"ب",1,0],["وَما أُريدُهُما إِلّا لِرُؤيَتِها","فَإِن تَأَبَّت فَما لي فيهِما أَرَبُ",167,"ب",1,0],["وَما أَرَدتُ الجاها","لَكن أَرَدتُ اللَه",168,"ه",1,0],["وما ارتجاجُ قناتي بالسنان سوى","إيماضُ بارقةٍ من ثغرِ بسامِ",169,"م",1,0],["وما أرتجي إلا شفاعتك التي","بها يبلغ الراجي ثواب مثيب",170,"ب",1,0],["وما أرضى السياسة دون قولي","بأن الخبز تسييسٌ وحتف",171,"ف",1,0],["وما أرى الدرَّ يقوى أنْ يُنافسَها","وهيَ التي كلُّ ما فيها هو الدُّرُّ",172,"ر",1,0],["وَ مَا أَرَقَّ نِدَاءَ القَلْبِ مِنْ شَفَةٍ","ظَمْأَى لِثَغْرِ حَبِيْبٍ بَاتَ يُحْتَضَرُ",173,"ر",1,0],["وما ارتمى به التحقيق في مدحي","ما يرتمي بالنصارى في نبيهم",174,"م",1,0],["وما أربابُها أصحابُ فضلٍ","فغابتُها تعاقرُها الذئابُ",175,"ب",1,0],["وماأرجو لوصلكم مكانا","ففي قلبي مكانكمُ هناكا",176,"ك",2,0],["وَمَا أَرَى الشعرَ إِلاَّ البيتَ يجمعُنَا","صَدْرًا وَقَافِيَّةً والبَحرُ مَغنَاكِ",177,"ك",1,0],["وما أرى لي سواك معتمداً","عليك بعد الإله منَّكلي",178,"ل",2,0],["وَمَا أَرْوَعَ الْفَجْرَ بَعْدَ الدُّجَى","وَفَجْرِي لِقَاؤُكِ حُلْمِي الدَّوَامْ",179,"م",1,0],["وما ارتوتْ دجلةُ من عِشقِها","وأنت معنى عِشقِها والبريقْ",180,"ق",1,0],["وما ارتفعوا بقوّتهم لنصرٍ","ولا صانوا البلاد أمامَ هِزةْ",181,"ز",2,0],["وما أرى غيره يشاكله","فأسأله باللهِ عنه ما صنعا",182,"ع",2,0],["وما أراه بروض الخدِّ ورد رباً","أم حنَّةٌ بدم العشَّاق تختصبُ؟",183,"ب",1,0],["وما أرَبى في العيش لولا محبتي","لنفع محبّ أو مَضَرّةِ كاشح",184,"ح",1,0],["وما أرى الشِّعرَ لائقاً بكمُ","فأنتَ بغلٌ في هئيةِ الرَّجُل",185,"ل",1,0],["وما أرض نجد عن دياري قريبة","ولكن من أهواه منزله رغد",186,"د",1,0],["وما أرضت طموح النفس مني","قصائد ذات موضوع مفيد",187,"د",1,0]]}