{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[55,"بات المحبان في خوف وإشفاق","https://www.aldiwan.net/poem26227.html","البسيط"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[34,"بانت لبينى فهاج القلب من بانا","https://www.aldiwan.net/poem4941.html","البسيط"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[86,"سكت فأصغروا أدبي","https://www.aldiwan.net/poem10513.html","مجزوء الوافر"],[83,"لمن قبة حمراء مد نضارها","https://www.aldiwan.net/poem54346.html","الطويل"],[88,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[37,"وقفعت على أطلالها وتكاثرت","https://www.aldiwan.net/poem7467.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا سيدا لم يلتبس عرضه","https://www.aldiwan.net/poem62000.html","السريع"],[51,"قالوا هجاك أبو المزاق قلت لهم","https://www.aldiwan.net/poem65433.html","البسيط"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[51,"جربت شعري أبلو كيف طاعته","https://www.aldiwan.net/poem66476.html","البسيط"],[29,"خليلي قوما للرحيل فإنني","https://www.aldiwan.net/poem6047.html","الطويل"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[43,"أتنكر يا ابن إسحاق إخائي","https://www.aldiwan.net/poem9444.html","الوافر"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[28,"لو جمعوا من الخلان ألفا","https://www.aldiwan.net/poem5634.html","الوافر"],[97,"قلب تقسم بين الوجد والألم","https://www.aldiwan.net/poem24873.html","البسيط"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[74,"وأروع أمجد قرظته","https://www.aldiwan.net/poem12957.html","المتقارب"],[39,"وما أروى وإِن كرمت علينا","https://www.aldiwan.net/poem53689.html","الوافر"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[46,"لو كنتم أهل صفو قال ناسبكم","https://www.aldiwan.net/poem22122.html","البسيط"],[46,"قد أسرجوا بكميت أطلقت لجما","https://www.aldiwan.net/poem22259.html","البسيط"],[46,"سجايا كلها غدر وخبث","https://www.aldiwan.net/poem22838.html","الوافر"],[46,"أيعلم نجم طارق برزية","https://www.aldiwan.net/poem23016.html","الطويل"],[46,"إذا ألف الشيء استهان به الفتى","https://www.aldiwan.net/poem23337.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147478","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/72017","الطويل"],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[128,"هو الحق ما قال الحكيم فإنها","https://www.aldiwan.net/poem50484.html","الطويل"],[142,"عذب من الماء قد سدت موارده","https://www.aldiwan.net/poem58328.html","البسيط"],[143,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[160,"فرائد زانها حسن النظام","https://www.aldiwan.net/poem59119.html","الطويل"],[199,"بالله يا بدر السما هل درى","https://www.aldiwan.net/poem45569.html","السريع"],[199,"حكمة الله في القلوب فما","https://www.aldiwan.net/poem45594.html","المنسرح"],[199,"تضرب كالقلب شفه السقم","https://www.aldiwan.net/poem45636.html","المنسرح"],[199,"يا من يرى الفخر بأجداده","https://www.aldiwan.net/poem45660.html","السريع"],[229,"وأتهمني مولاي أني اتهمته","https://www.aldiwan.net/poem51011.html","الطويل"],[235,"بمن أباحك قتلي","https://www.aldiwan.net/poem31775.html","المجتث"],[235,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[252,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[259,"حبيب القلب أضحى فيه حاضر","https://www.aldiwan.net/poem35756.html","الوافر"],[271,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[275,"يقر بعيني أن أزور مغانيا","https://www.aldiwan.net/poem25630.html","الطويل"],[280,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[280,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[298,"هلم ننشد يا صاحبي معا","https://www.aldiwan.net/poem36288.html","عموديه"],[320,"خليل العمر أبدلني","https://www.aldiwan.net/poem67152.html","مجزوء الوافر"],[342,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[353,"على حكم الهوى أدر المداما","https://www.aldiwan.net/poem39957.html","الوافر"],[364,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[364,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[364,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[364,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[366,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[371,"باتت أساطير الهوى تتلى","https://www.aldiwan.net/poem57176.html","السريع"],[371,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[371,"فيما يقال مقيم قيل قد سارا","https://www.aldiwan.net/poem57428.html","البسيط"],[403,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[409,"مضت لداتي وإخواني وأفردني","https://www.aldiwan.net/poem32044.html","البسيط"],[416,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[432,"أصابت سهام البأس قلب المطامع","https://www.aldiwan.net/poem12663.html","الطويل"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[441,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[458,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[458,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[458,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[458,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[515,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[529,"لا أترك الإلحاحا","https://www.aldiwan.net/poem37470.html","مجزوء الرجز"],[542,"تفرقوا ودعوني","https://www.aldiwan.net/poem34042.html","المجتث"],[551,"ومن عجائب أمري أنني أبدا","https://www.aldiwan.net/poem47272.html","البسيط"],[551,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[551,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[551,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[551,"هذي المصيبة ما أبقت لنا أبدا","https://www.aldiwan.net/poem47865.html","البسيط"],[551,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[558,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[563,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"بدا له في غدانا","https://www.aldiwan.net/poem2697.html","المجتث"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[575,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"]],"verses":[["وَما اِرتاعَ مَطلوبٌ يَكونُ وَراءَهُ","بِأَغلَبَ مِن آلِ النَبِيِّ هِجانِ",0,"ن",1,0],["وَما أَرَبي بِسُؤالِ الطُلو","لِ إِلّا تَذَكُّرُ ماضي زَماني",1,"ي",1,0],["وَما أُريقَ بِأَعلى الخَيفِ مِن عَلَقٍ","تُوجى لَهُ البُدُنُ المُلقاةُ وَالجُزُرُ",2,"ر",1,0],["وَما أَراكِ أَرى في الناسِ قائِلَةً","لاقى أَبو الفَضلِ ما لَم يَلقَهُ لاقِ",3,"ق",1,0],["وَما أَرى اِثنَينِ حَالَ الناسُ بَينَهُما","مِثلي وَمِثلَكِ في جَهدٍ وَإِضرارِ",4,"ر",1,0],["وَما أَرى مِثلَكُم في الناسِ مِن بَشَرٍ","فَقَد رَأَيتُ بِهِ حَيّاً وَنِسوانا",5,"ن",2,0],["وَمَا أَرْسِلَتْ خَيْلُ الصَّبَاحِ عَلَى الدُّجَى","فَتُبْصِرُهَا مِنْ أَشْهَبٍ خلْفَ أَدْهَمِ",6,"م",1,0],["وَما أَرادَ بِها نُعمى يُثابُ بِها","إِن قالَ كَلمَةَ مَعروفٍ بِها نَفَعا",7,"ع",2,0],["وَما أَرجوهُ مِن بَلَدٍ","بِهِ ضاقَ الرَجاءُ وَبي",8,"ب",2,0],["وما أرضها إلا خزائنُ رحمةٍ","وما قد سما من فوق ذاك غطاؤُها",9,"ا",3,0],["وما ارتجفت بجُنح الليل إلا","لتضحك فيه مما يزعمونا",10,"ن",2,0],["وما ارتحلت عنا الركائب وحدها","ولكن روحي للركائب تالِ",11,"ل",1,0],["وَمَا أرضَى بِغَيرِ بَلاَءِ سُوءٍ","لِهَمدَان التربُّص والأَنِينَا",12,"ن",2,0],["وَمَا أَرضَى لهُم أَلاَّ يَضُرُّوا","عَدُوَّهُمُ وأَلاَّ يِنفَعُونَا",12,"ن",2,0],["وما أرقت حتَّى سريت كأنما","مقامكَ فيها كانَ طيف منام",13,"م",1,0],["وما أرى اللّه امرَأً وجهَهُ","إلا أراهُ ولداً طيّبا",14,"ب",2,0],["وما أرَى التقصير يُخشَى على","فعلك بل يُخشى على شاكرِهْ",15,"ر",2,0],["وما أراه على حال تعف له","أنثى ولو حمقت حتى تكون دُغَه",16,"غ",2,0],["وما أردتَ بإغباب الندى قسماً","إجمامَ مالكَ بل إجمام حَسْراكا",17,"ك",2,0],["وما أرجّي سماحاً منه مُطَّرفاً","لكن سماحاً تليداً فيه لم يزلِ",18,"ل",1,0],["وما ارتفعت كهمَّتك الثريّا","ولا وألتْ كجاريك الوعولُ",19,"ل",1,0],["وما أُراني يفوزُ مُطَّرحي","وما أُراني يخيبُ مُعتامي",20,"م",2,0],["وما أُراني سَجيسَ الدهر جازيَهُ","بمثل مَدْحي به يَحيَى بن خاقان",21,"ن",1,0],["وَما أَرضُ عَبّادٍ إِذا ما هَبَطتَها","بِحَزنٍ وَلا أَعطانُها بِجُدوبِ",22,"ب",1,0],["وَما أَرواحُنا إِلّا أَسارى","وَما أَجسادُنا إِلّا سُجونُ",23,"ن",1,0],["وَما أَربَت عَلى العِشرينَ سِنّي","فَكَيفَ مَلِلتُ مِن طولِ البَقاءِ",24,"ا",2,0],["وَما أَرضى لِمُقلَتِهِ بِحُلمٍ","إِذا اِنتَبَهَت تَوَهَّمَهُ اِبتِشاكا",25,"ك",2,0],["وَما أَرضَتكَ مِن مُهَجِ المَوالي","غَداةَ رُزِئتَها مُهَجُ العَبيدِ",26,"د",1,0],["وَما ارتَبتُ في آلِ المُدَبِّرِ أَنَّهُم","إِذا اِنتَسَبَت غُرُّ المَكارَمِ آلُها",27,"ل",3,0],["وَما أَرجو لِطَيبَةَ غَيرَ رَبّي","وَغَيرَ اِبنِ الوَليدِ بِما أَعانا",28,"ن",2,0],["وما أُرقِّع ثوباً فيك منخرقاً","لكن أرقِّع جُرحاً غير ملتئم",29,"م",1,0],["وَما أَرَّقَ الأجفانَ إِلّا بَلابِلٌ","تُسامِرُها بَينَ الضلوعِ بَلابِلي",30,"ل",2,0],["وَما أَرغَتِ الكَأسُ في كَفِّهِ","وَلَكِنَّها ضَحِكَت عَن سُرورِ",31,"ر",1,0],["وَما أَروى وَإِن كَرُمَت عَلَينا","بِأَدنى مِن مُؤَقَّفَةٍ حَرونِ",32,"ن",1,1],["وما أُرَى بَيتَ مالِ المسلمينَ دَرَى","مِنْ أَيْنَ تأتي لهُ الأكياسُ وَالبِدَرُ",33,"ر",1,0],["وَما أَرى كُلَّ قَومٍ ضَلَّ رُشدُهُمُ","إِلّا نَظيرَ النَصارى أَعظَموا الصُلُبا",34,"ب",2,0],["وَما أَرى دَرَجاتِ الفَضلِ مُغنِيَةً","عَنِ الفَتى عادَ مَحثوثاً لِإِدراجِ",35,"ج",1,0],["وَما أَرضاكَ رَأيٌ مِن دُرَيدٍ","غَداةَ يَرومُ قُرباً مِن خُناسِ",36,"س",1,0],["وَما أَرَّقَتهُ الحادِثاتُ وَكُلُّنا","إِذا نابَ خَطبٌ ساهِرُ اللَيلِ آرِقُه",37,"ق",2,0],["وَما اِرتابَ في لُقيا الرَدى وَكَأَنَّهُ","حَديثٌ أَتى مِن كاذِبٍ يُبطِلُ الزَعما",38,"م",2,0],["وما أرى هل في غدٍ لي ثواء","بالخلدِ أمْ مثوايَ نارُ الجحيمْ",39,"م",1,0],["وما أرغب المرء في عيشه","ولكن قصاراه سكنى الجدث",40,"ث",1,0],["وما أرَبي إلاّ مُعَرّسُ مَعْشَرٍ","همُ الناسُ لا سُوقُ العروسِ ولا الشطّ",41,"ط",1,0],["وَما أَرضى اِنتِصافاً مِن سِواكُم","وَأُغضي مِنكَ عَن ظُلمٍ صُراحِ",42,"ح",1,0],["وما أرَى الموتَ إلّا باسطاً يدَهُ","مِن قبْلِ أن يُمْكِنَ المأسور إفْلاَتُ",43,"ت",1,0],["وما أرْتَجي منْ بُقْعَةٍ قدْ هجَوْتها","لقدْ ظَفِرَتْ بي فهْيَ تُعْمِلُ أطْرافي",44,"ي",1,0],["وما أرخصت قدرهم كثرةٌ","ولا هان غثٌ، وعزَّ سَمين",45,"ن",1,0],["وما أرتَضِيها مدةَ العمرِ خلّةً","ولا أصطفيها لو أخلَّد فيهَا",46,"ي",3,0],["وما أردتُ سلُواّ عن محبّته","إلا وقلبي على كُلِّى يُساعدُهُ",47,"د",2,0],["وَما أَراكَ بِما قَد كانَ مُقتَنِعاً","حَتّى يَبيدَ الهِلالِيّونَ كُلُّهُمُ",48,"م",1,0],["وما ارتفع الدنى به لفضل","على الأعلى ولكن بالقيام",49,"م",1,0],["وما أرى الدنيا سوى دولتي","ومن فنونِ الحبِّ هذا الجنونْ",50,"ن",1,0],["وما أرى قلبهُ يرقُ لنا","كأنما قلبهُ من الحجرِ",51,"ر",1,0],["وما أراها سوى الزمان أما","يدورُ فيها النعيمُ والنقمُ",52,"م",1,0],["وما ارى أعجبَ من جدوَلٍ","ينضبُ والأمواهُ في النهرِ",53,"ر",1,0],["وما ارتبتُ منه غير أنّ صدودَه","شجاني ومن يرتابُ بالقمرِ البدرِ",54,"ر",1,0],["وَما أَرابَكَ حَتّى","صَرَمتَ بِالهَجرِ حَبلي",55,"ي",1,0],["وَما أَراني بَعدُ مِن","داءِ الهَوى بِمُفرِقِ",56,"ق",1,0],["وَما أَرى لي بَينَهُم دَولَةً","تَرفَعُ مِن شَأني وَمِن قَدري",57,"ر",2,0],["وَما أَرَدتُ تَناسيه لأسلوَه","إِلّا وَذكرَّنيه هَزّةُ الغُصُن",58,"ن",1,0],["وما أرسلت من قفصٍ أتاني","وقلبي فيه وجداً بات طائر",59,"ر",1,0],["وَما ارفض من واهى العراكل مسجم","وَقوّم من نبت الثرى كل ساجد",60,"د",1,0],["وَما أربي إلا الرُّصافةُ لَوْ دَنَتْ","وَهل لِلْهوى إلا الرُّصَافةُ مَذْهبُ",61,"ب",1,0],["وَما أَرَبِي لَهُ فِي ماءِ مُزْنٍ","وَقَدْ وَدَّعْتُ مِنْهُ حَياً مَطِيرا",62,"ر",2,0],["وَما ارْتَشَفْتُ ثَنايا الْعَيْشِ عِنْدَكُمُ","إِلاّ وَجَدْتُ بِها مِنْ جُودِكُمْ شَنبَا",63,"ب",2,0],["وما أُرجّي من خافقٍ قرعتْ","صفاتَه النائباتُ فانصدعا",64,"ع",2,0],["وَما أَرضى بِها بَدَلاً","وَلَكِن تَحكُمُ الصورَةُ",65,"ر",2,0],["وما ارى أشباه","او ما ارى اشباح",66,"ح",1,0],["وَما أَرى بَرّي سِوى","قَولُ الفُجورِ قَد فَجَر",67,"ر",1,0],["وَما أَردى الحَسود عَلى هَواها","سِوى هَمٍّ طَمى وَهمى ركاما",68,"م",2,0],["وما أرَى كالفَزارِيّينَ مِن عُصَبٍ","مُشْتَقَة من مَعانيها أساميها",69,"ي",3,0],["وما أرَى مثلَك في طُولِ ما","أَلُفُّ أنجاداً بأَغوار",70,"ر",1,0],["وما ارتَدَّ مُنْحازٌ فَرُدَّ بذِلّةٍ","إلا الدّينِ إلاّ سُرعةَ النَّفَسِ ارْتَدا",71,"د",2,0],["وما ارتابَ بي الأحبابُ إلا بأنّهم","إذا نُظِروا كانوا الّذينَ أَرابوا",72,"ب",3,0],["وَما اِرتِياحي أَميرٌ في يَدَي رَغَبٍ","وَلا اِرتِياعي أَسيرٌ في يَدَي رَهَبِ",73,"ب",1,0],["وما أَرى إِلا هَوىً مُقبِلاً","أقبلَ مَن أَهواهُ أَو وَلَّى",74,"ل",2,0],["وما أرَى لكَ ممَّا أنتَ كاسِبُهُ","شَيئاً سِوى الحَمدِ مَشدوداً على الثقَلِ",75,"ل",1,0],["وما أراكمُ توجَّعتُم لصاحِبكم","ولا عَرفتُم لما يلقاهُ مِقدارا",76,"ر",2,0],["وما أرى لي مشرباً","أرضاه إلا مشربك",77,"ك",1,0],["وما أرى لي بحُسنِ الصَّبرِ بَعْدَهُمُ","وإن تجلَّدتُ خوفَ الشّامِتين يَدا",78,"د",2,0],["وما أرى غيرهم فيمن يناظرهم","من يُسأل الخير أو تطوى له البيد",79,"د",1,0],["وما أرْسِلِ الناعي به يوم موتِه","سوى صممٍ أصمى صَميمِ المَسامِعِ",80,"ع",1,0],["وَمَا أَرْصَدَتْ يمناكَ للضَّيْفِ من قِرىً","وَمَا بسطَتْ علْيَاكَ للعلمِ من بِرِّ",81,"ر",1,0],["وما أرزمت شوقاً لورد وراءها","ولا ذكرت مرعى رعته ومعطنا",82,"ن",2,0],["وما ارتابَ هذا الملكُ أنك شمسُه","تعُمُّ فتضفُو تارةً وتزولُ",83,"ل",1,0],["وما أرضى لسانا دون قلبٍ","وهل يكفي من السيف الصِّقالُ",84,"ل",1,0],["وما ارتبتُ حتى رأيتُ اليمي","نَ تُعقَد في الحقِّ عنها اليسارُ",85,"ر",1,0],["وما أرَبِي إلى سُقيا ربوعٍ","لها من مقلتي سارٍ وغادي",86,"ي",1,0],["وما ارْتدتِ النّساءُ منَ الحُليّ","وما اعْتمرَ الشّيوخُ منَ العمَائرْ",87,"ر",1,0],["وما أريد سوى بشر وتكرمة","إن الكرامة في حقي هي المال",88,"ل",1,0],["وَمَا أَرَى لِي مَنْهَجاً","إِليْكَ إلاّ بالرَّجا",89,"ج",2,0],["وما أرى غَيرَ إِفكٍ","وتُرَّهاتِ الأماني",90,"ي",1,0],["وما أُريد سوى عينِ المحال فلا","سبيلَ يوماً إلى تبليغ آمالي",91,"ل",2,0],["وما أراقوه على وادي مِنىً","عند الجِمارِ من نَجيعٍ سائلِ",92,"ل",1,0],["وما أَرَبِي إلّا لقاءُ عصابةٍ","ذوي مُهَجاتٍ ما حَلَوْنَ لذائقِ",93,"ق",1,0],["وما أراقوه من جاري دمٍ بمنىً","وأنشروا من نَجيعٍ ثَمَّ مَرْموسِ",94,"س",1,0],["وما أرى الصّبرَ لِي رأياً فأسألَهُ","والقصدُ يُغْرِي به مَن كان مقتصدا",95,"د",2,0],["وما أردتَ على الهَوْ","لِ نَجْدَةً منك جُندا",96,"د",2,0],["وما أراقوه في وادي مِنى زُمَراً","عند الجِمارِ من الكُومِ المسنّاتِ",97,"ت",1,0],["وما ارتشاف زلال الماء في ظمأ","يوماً باعذب من تكرار مدحهم",98,"م",1,0],["وَما أَرضَة البَيتِ الحَرامِ تَعَقَّبَت","كِتابَ قُرَيشٍ إِذ نَفَت كُلَّ ما يُنفى",99,"ف",2,0],["وما أراد القوم في ابتدائهم","به من الخلاص من أعدائهم",100,"م",1,0],["وما أَردنا رضانا","لكن أَردْنا رَضَاه",101,"ا",2,0],["ومَا أَرْضُها مَلثومةٌ بِمبَاسمٍ","ولكنَّها ملثومَةٌ بضمائِر",102,"ر",1,0],["وَمَا ارْتَابَ في عليائِه قَطُّ حَاسِدٌ","إِلى أَنْ يقولُوا زالَ عَنْه ارْتِيابُه",103,"ب",2,0]]}