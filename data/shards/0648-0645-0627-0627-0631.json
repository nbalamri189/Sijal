{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[55,"بات المحبان في خوف وإشفاق","https://www.aldiwan.net/poem26227.html","البسيط"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[34,"بانت لبينى فهاج القلب من بانا","https://www.aldiwan.net/poem4941.html","البسيط"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[86,"سكت فأصغروا أدبي","https://www.aldiwan.net/poem10513.html","مجزوء الوافر"],[83,"لمن قبة حمراء مد نضارها","https://www.aldiwan.net/poem54346.html","الطويل"],[37,"وقفعت على أطلالها وتكاثرت","https://www.aldiwan.net/poem7467.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا سيدا لم يلتبس عرضه","https://www.aldiwan.net/poem62000.html","السريع"],[51,"قالوا هجاك أبو المزاق قلت لهم","https://www.aldiwan.net/poem65433.html","البسيط"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[51,"جربت شعري أبلو كيف طاعته","https://www.aldiwan.net/poem66476.html","البسيط"],[29,"خليلي قوما للرحيل فإنني","https://www.aldiwan.net/poem6047.html","الطويل"],[91,"أبعدك يعرف الصبر الحزين","https://www.aldiwan.net/poem62758.html","عموديه"],[43,"أتنكر يا ابن إسحاق إخائي","https://www.aldiwan.net/poem9444.html","الوافر"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[28,"لو جمعوا من الخلان ألفا","https://www.aldiwan.net/poem5634.html","الوافر"],[97,"قلب تقسم بين الوجد والألم","https://www.aldiwan.net/poem24873.html","البسيط"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[74,"وأروع أمجد قرظته","https://www.aldiwan.net/poem12957.html","المتقارب"],[39,"وما أروى وإِن كرمت علينا","https://www.aldiwan.net/poem53689.html","الوافر"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[46,"لو كنتم أهل صفو قال ناسبكم","https://www.aldiwan.net/poem22122.html","البسيط"],[46,"قد أسرجوا بكميت أطلقت لجما","https://www.aldiwan.net/poem22259.html","البسيط"],[46,"سجايا كلها غدر وخبث","https://www.aldiwan.net/poem22838.html","الوافر"],[46,"أيعلم نجم طارق برزية","https://www.aldiwan.net/poem23016.html","الطويل"],[46,"إذا ألف الشيء استهان به الفتى","https://www.aldiwan.net/poem23337.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147478","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/72017","الطويل"],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[126,"هو الحق ما قال الحكيم فإنها","https://www.aldiwan.net/poem50484.html","الطويل"],[140,"عذب من الماء قد سدت موارده","https://www.aldiwan.net/poem58328.html","البسيط"],[141,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[158,"فرائد زانها حسن النظام","https://www.aldiwan.net/poem59119.html","الطويل"],[197,"بالله يا بدر السما هل درى","https://www.aldiwan.net/poem45569.html","السريع"],[197,"حكمة الله في القلوب فما","https://www.aldiwan.net/poem45594.html","المنسرح"],[197,"تضرب كالقلب شفه السقم","https://www.aldiwan.net/poem45636.html","المنسرح"],[197,"يا من يرى الفخر بأجداده","https://www.aldiwan.net/poem45660.html","السريع"],[227,"وأتهمني مولاي أني اتهمته","https://www.aldiwan.net/poem51011.html","الطويل"],[233,"بمن أباحك قتلي","https://www.aldiwan.net/poem31775.html","المجتث"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[233,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[250,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[257,"حبيب القلب أضحى فيه حاضر","https://www.aldiwan.net/poem35756.html","الوافر"],[269,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[273,"يقر بعيني أن أزور مغانيا","https://www.aldiwan.net/poem25630.html","الطويل"],[278,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[278,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[296,"هلم ننشد يا صاحبي معا","https://www.aldiwan.net/poem36288.html","عموديه"],[318,"خليل العمر أبدلني","https://www.aldiwan.net/poem67152.html","مجزوء الوافر"],[340,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[347,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[351,"على حكم الهوى أدر المداما","https://www.aldiwan.net/poem39957.html","الوافر"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[362,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[362,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[362,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[364,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[369,"باتت أساطير الهوى تتلى","https://www.aldiwan.net/poem57176.html","السريع"],[369,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[369,"فيما يقال مقيم قيل قد سارا","https://www.aldiwan.net/poem57428.html","البسيط"],[400,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[406,"مضت لداتي وإخواني وأفردني","https://www.aldiwan.net/poem32044.html","البسيط"],[413,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[429,"أصابت سهام البأس قلب المطامع","https://www.aldiwan.net/poem12663.html","الطويل"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[438,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[456,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[456,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[456,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[456,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[513,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[527,"لا أترك الإلحاحا","https://www.aldiwan.net/poem37470.html","مجزوء الرجز"],[540,"تفرقوا ودعوني","https://www.aldiwan.net/poem34042.html","المجتث"],[549,"ومن عجائب أمري أنني أبدا","https://www.aldiwan.net/poem47272.html","البسيط"],[549,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[549,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[549,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[549,"هذي المصيبة ما أبقت لنا أبدا","https://www.aldiwan.net/poem47865.html","البسيط"],[549,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[556,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"بدا له في غدانا","https://www.aldiwan.net/poem2697.html","المجتث"],[573,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[573,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"]],"verses":[["وَما اِرتاعَ مَطلوبٌ يَكونُ وَراءَهُ","بِأَغلَبَ مِن آلِ النَبِيِّ هِجانِ",0,"ن",1,0],["وَما أَرَبي بِسُؤالِ الطُلو","لِ إِلّا تَذَكُّرُ ماضي زَماني",1,"ي",1,0],["وَما أُريقَ بِأَعلى الخَيفِ مِن عَلَقٍ","تُوجى لَهُ البُدُنُ المُلقاةُ وَالجُزُرُ",2,"ر",1,0],["وَما أَراكِ أَرى في الناسِ قائِلَةً","لاقى أَبو الفَضلِ ما لَم يَلقَهُ لاقِ",3,"ق",1,0],["وَما أَرى اِثنَينِ حَالَ الناسُ بَينَهُما","مِثلي وَمِثلَكِ في جَهدٍ وَإِضرارِ",4,"ر",1,0],["وَما أَرى مِثلَكُم في الناسِ مِن بَشَرٍ","فَقَد رَأَيتُ بِهِ حَيّاً وَنِسوانا",5,"ن",2,0],["وَمَا أَرْسِلَتْ خَيْلُ الصَّبَاحِ عَلَى الدُّجَى","فَتُبْصِرُهَا مِنْ أَشْهَبٍ خلْفَ أَدْهَمِ",6,"م",1,0],["وَما أَرادَ بِها نُعمى يُثابُ بِها","إِن قالَ كَلمَةَ مَعروفٍ بِها نَفَعا",7,"ع",2,0],["وَما أَرجوهُ مِن بَلَدٍ","بِهِ ضاقَ الرَجاءُ وَبي",8,"ب",2,0],["وما أرضها إلا خزائنُ رحمةٍ","وما قد سما من فوق ذاك غطاؤُها",9,"ا",3,0],["وما ارتحلت عنا الركائب وحدها","ولكن روحي للركائب تالِ",10,"ل",1,0],["وَمَا أرضَى بِغَيرِ بَلاَءِ سُوءٍ","لِهَمدَان التربُّص والأَنِينَا",11,"ن",2,0],["وَمَا أَرضَى لهُم أَلاَّ يَضُرُّوا","عَدُوَّهُمُ وأَلاَّ يِنفَعُونَا",11,"ن",2,0],["وما أرقت حتَّى سريت كأنما","مقامكَ فيها كانَ طيف منام",12,"م",1,0],["وما أرى اللّه امرَأً وجهَهُ","إلا أراهُ ولداً طيّبا",13,"ب",2,0],["وما أرَى التقصير يُخشَى على","فعلك بل يُخشى على شاكرِهْ",14,"ر",2,0],["وما أراه على حال تعف له","أنثى ولو حمقت حتى تكون دُغَه",15,"غ",2,0],["وما أردتَ بإغباب الندى قسماً","إجمامَ مالكَ بل إجمام حَسْراكا",16,"ك",2,0],["وما أرجّي سماحاً منه مُطَّرفاً","لكن سماحاً تليداً فيه لم يزلِ",17,"ل",1,0],["وما ارتفعت كهمَّتك الثريّا","ولا وألتْ كجاريك الوعولُ",18,"ل",1,0],["وما أُراني يفوزُ مُطَّرحي","وما أُراني يخيبُ مُعتامي",19,"م",2,0],["وما أُراني سَجيسَ الدهر جازيَهُ","بمثل مَدْحي به يَحيَى بن خاقان",20,"ن",1,0],["وَما أَرضُ عَبّادٍ إِذا ما هَبَطتَها","بِحَزنٍ وَلا أَعطانُها بِجُدوبِ",21,"ب",1,0],["وَما أَرواحُنا إِلّا أَسارى","وَما أَجسادُنا إِلّا سُجونُ",22,"ن",1,0],["وَما أَربَت عَلى العِشرينَ سِنّي","فَكَيفَ مَلِلتُ مِن طولِ البَقاءِ",23,"ا",2,0],["وَما أَرضى لِمُقلَتِهِ بِحُلمٍ","إِذا اِنتَبَهَت تَوَهَّمَهُ اِبتِشاكا",24,"ك",2,0],["وَما أَرضَتكَ مِن مُهَجِ المَوالي","غَداةَ رُزِئتَها مُهَجُ العَبيدِ",25,"د",1,0],["وَما ارتَبتُ في آلِ المُدَبِّرِ أَنَّهُم","إِذا اِنتَسَبَت غُرُّ المَكارَمِ آلُها",26,"ل",3,0],["وَما أَرجو لِطَيبَةَ غَيرَ رَبّي","وَغَيرَ اِبنِ الوَليدِ بِما أَعانا",27,"ن",2,0],["وما أُرقِّع ثوباً فيك منخرقاً","لكن أرقِّع جُرحاً غير ملتئم",28,"م",1,0],["وَما أَرَّقَ الأجفانَ إِلّا بَلابِلٌ","تُسامِرُها بَينَ الضلوعِ بَلابِلي",29,"ل",2,0],["وَما أَرغَتِ الكَأسُ في كَفِّهِ","وَلَكِنَّها ضَحِكَت عَن سُرورِ",30,"ر",1,0],["وَما أَروى وَإِن كَرُمَت عَلَينا","بِأَدنى مِن مُؤَقَّفَةٍ حَرونِ",31,"ن",1,1],["وما أُرَى بَيتَ مالِ المسلمينَ دَرَى","مِنْ أَيْنَ تأتي لهُ الأكياسُ وَالبِدَرُ",32,"ر",1,0],["وَما أَرى كُلَّ قَومٍ ضَلَّ رُشدُهُمُ","إِلّا نَظيرَ النَصارى أَعظَموا الصُلُبا",33,"ب",2,0],["وَما أَرى دَرَجاتِ الفَضلِ مُغنِيَةً","عَنِ الفَتى عادَ مَحثوثاً لِإِدراجِ",34,"ج",1,0],["وَما أَرضاكَ رَأيٌ مِن دُرَيدٍ","غَداةَ يَرومُ قُرباً مِن خُناسِ",35,"س",1,0],["وَما أَرَّقَتهُ الحادِثاتُ وَكُلُّنا","إِذا نابَ خَطبٌ ساهِرُ اللَيلِ آرِقُه",36,"ق",2,0],["وَما اِرتابَ في لُقيا الرَدى وَكَأَنَّهُ","حَديثٌ أَتى مِن كاذِبٍ يُبطِلُ الزَعما",37,"م",2,0],["وما أرى هل في غدٍ لي ثواء","بالخلدِ أمْ مثوايَ نارُ الجحيمْ",38,"م",1,0],["وما أرغب المرء في عيشه","ولكن قصاراه سكنى الجدث",39,"ث",1,0],["وما أرَبي إلاّ مُعَرّسُ مَعْشَرٍ","همُ الناسُ لا سُوقُ العروسِ ولا الشطّ",40,"ط",1,0],["وَما أَرضى اِنتِصافاً مِن سِواكُم","وَأُغضي مِنكَ عَن ظُلمٍ صُراحِ",41,"ح",1,0],["وما أرَى الموتَ إلّا باسطاً يدَهُ","مِن قبْلِ أن يُمْكِنَ المأسور إفْلاَتُ",42,"ت",1,0],["وما أرْتَجي منْ بُقْعَةٍ قدْ هجَوْتها","لقدْ ظَفِرَتْ بي فهْيَ تُعْمِلُ أطْرافي",43,"ي",1,0],["وما أرخصت قدرهم كثرةٌ","ولا هان غثٌ، وعزَّ سَمين",44,"ن",1,0],["وما أرتَضِيها مدةَ العمرِ خلّةً","ولا أصطفيها لو أخلَّد فيهَا",45,"ي",3,0],["وما أردتُ سلُواّ عن محبّته","إلا وقلبي على كُلِّى يُساعدُهُ",46,"د",2,0],["وَما أَراكَ بِما قَد كانَ مُقتَنِعاً","حَتّى يَبيدَ الهِلالِيّونَ كُلُّهُمُ",47,"م",1,0],["وما ارتفع الدنى به لفضل","على الأعلى ولكن بالقيام",48,"م",1,0],["وما أرى الدنيا سوى دولتي","ومن فنونِ الحبِّ هذا الجنونْ",49,"ن",1,0],["وما أرى قلبهُ يرقُ لنا","كأنما قلبهُ من الحجرِ",50,"ر",1,0],["وما أراها سوى الزمان أما","يدورُ فيها النعيمُ والنقمُ",51,"م",1,0],["وما ارى أعجبَ من جدوَلٍ","ينضبُ والأمواهُ في النهرِ",52,"ر",1,0],["وما ارتبتُ منه غير أنّ صدودَه","شجاني ومن يرتابُ بالقمرِ البدرِ",53,"ر",1,0],["وَما أَرابَكَ حَتّى","صَرَمتَ بِالهَجرِ حَبلي",54,"ي",1,0],["وَما أَراني بَعدُ مِن","داءِ الهَوى بِمُفرِقِ",55,"ق",1,0],["وَما أَرى لي بَينَهُم دَولَةً","تَرفَعُ مِن شَأني وَمِن قَدري",56,"ر",2,0],["وَما أَرَدتُ تَناسيه لأسلوَه","إِلّا وَذكرَّنيه هَزّةُ الغُصُن",57,"ن",1,0],["وما أرسلت من قفصٍ أتاني","وقلبي فيه وجداً بات طائر",58,"ر",1,0],["وَما ارفض من واهى العراكل مسجم","وَقوّم من نبت الثرى كل ساجد",59,"د",1,0],["وَما أربي إلا الرُّصافةُ لَوْ دَنَتْ","وَهل لِلْهوى إلا الرُّصَافةُ مَذْهبُ",60,"ب",1,0],["وَما أَرَبِي لَهُ فِي ماءِ مُزْنٍ","وَقَدْ وَدَّعْتُ مِنْهُ حَياً مَطِيرا",61,"ر",2,0],["وَما ارْتَشَفْتُ ثَنايا الْعَيْشِ عِنْدَكُمُ","إِلاّ وَجَدْتُ بِها مِنْ جُودِكُمْ شَنبَا",62,"ب",2,0],["وما أُرجّي من خافقٍ قرعتْ","صفاتَه النائباتُ فانصدعا",63,"ع",2,0],["وَما أَرضى بِها بَدَلاً","وَلَكِن تَحكُمُ الصورَةُ",64,"ر",2,0],["وما ارى أشباه","او ما ارى اشباح",65,"ح",1,0],["وَما أَرى بَرّي سِوى","قَولُ الفُجورِ قَد فَجَر",66,"ر",1,0],["وَما أَردى الحَسود عَلى هَواها","سِوى هَمٍّ طَمى وَهمى ركاما",67,"م",2,0],["وما أرَى كالفَزارِيّينَ مِن عُصَبٍ","مُشْتَقَة من مَعانيها أساميها",68,"ي",3,0],["وما أرَى مثلَك في طُولِ ما","أَلُفُّ أنجاداً بأَغوار",69,"ر",1,0],["وما ارتَدَّ مُنْحازٌ فَرُدَّ بذِلّةٍ","إلا الدّينِ إلاّ سُرعةَ النَّفَسِ ارْتَدا",70,"د",2,0],["وما ارتابَ بي الأحبابُ إلا بأنّهم","إذا نُظِروا كانوا الّذينَ أَرابوا",71,"ب",3,0],["وَما اِرتِياحي أَميرٌ في يَدَي رَغَبٍ","وَلا اِرتِياعي أَسيرٌ في يَدَي رَهَبِ",72,"ب",1,0],["وما أَرى إِلا هَوىً مُقبِلاً","أقبلَ مَن أَهواهُ أَو وَلَّى",73,"ل",2,0],["وما أرَى لكَ ممَّا أنتَ كاسِبُهُ","شَيئاً سِوى الحَمدِ مَشدوداً على الثقَلِ",74,"ل",1,0],["وما أراكمُ توجَّعتُم لصاحِبكم","ولا عَرفتُم لما يلقاهُ مِقدارا",75,"ر",2,0],["وما أرى لي مشرباً","أرضاه إلا مشربك",76,"ك",1,0],["وما أرى لي بحُسنِ الصَّبرِ بَعْدَهُمُ","وإن تجلَّدتُ خوفَ الشّامِتين يَدا",77,"د",2,0],["وما أرى غيرهم فيمن يناظرهم","من يُسأل الخير أو تطوى له البيد",78,"د",1,0],["وما أرْسِلِ الناعي به يوم موتِه","سوى صممٍ أصمى صَميمِ المَسامِعِ",79,"ع",1,0],["وَمَا أَرْصَدَتْ يمناكَ للضَّيْفِ من قِرىً","وَمَا بسطَتْ علْيَاكَ للعلمِ من بِرِّ",80,"ر",1,0],["وما أرزمت شوقاً لورد وراءها","ولا ذكرت مرعى رعته ومعطنا",81,"ن",2,0],["وما ارتابَ هذا الملكُ أنك شمسُه","تعُمُّ فتضفُو تارةً وتزولُ",82,"ل",1,0],["وما أرضى لسانا دون قلبٍ","وهل يكفي من السيف الصِّقالُ",83,"ل",1,0],["وما ارتبتُ حتى رأيتُ اليمي","نَ تُعقَد في الحقِّ عنها اليسارُ",84,"ر",1,0],["وما أرَبِي إلى سُقيا ربوعٍ","لها من مقلتي سارٍ وغادي",85,"ي",1,0],["وما ارْتدتِ النّساءُ منَ الحُليّ","وما اعْتمرَ الشّيوخُ منَ العمَائرْ",86,"ر",1,0],["وما أريد سوى بشر وتكرمة","إن الكرامة في حقي هي المال",87,"ل",1,0],["وَمَا أَرَى لِي مَنْهَجاً","إِليْكَ إلاّ بالرَّجا",88,"ج",2,0],["وما أرى غَيرَ إِفكٍ","وتُرَّهاتِ الأماني",89,"ي",1,0],["وما أُريد سوى عينِ المحال فلا","سبيلَ يوماً إلى تبليغ آمالي",90,"ل",2,0],["وما أراقوه على وادي مِنىً","عند الجِمارِ من نَجيعٍ سائلِ",91,"ل",1,0],["وما أَرَبِي إلّا لقاءُ عصابةٍ","ذوي مُهَجاتٍ ما حَلَوْنَ لذائقِ",92,"ق",1,0],["وما أراقوه من جاري دمٍ بمنىً","وأنشروا من نَجيعٍ ثَمَّ مَرْموسِ",93,"س",1,0],["وما أرى الصّبرَ لِي رأياً فأسألَهُ","والقصدُ يُغْرِي به مَن كان مقتصدا",94,"د",2,0],["وما أردتَ على الهَوْ","لِ نَجْدَةً منك جُندا",95,"د",2,0],["وما أراقوه في وادي مِنى زُمَراً","عند الجِمارِ من الكُومِ المسنّاتِ",96,"ت",1,0],["وما ارتشاف زلال الماء في ظمأ","يوماً باعذب من تكرار مدحهم",97,"م",1,0],["وَما أَرضَة البَيتِ الحَرامِ تَعَقَّبَت","كِتابَ قُرَيشٍ إِذ نَفَت كُلَّ ما يُنفى",98,"ف",2,0],["وما أراد القوم في ابتدائهم","به من الخلاص من أعدائهم",99,"م",1,0],["وما أَردنا رضانا","لكن أَردْنا رَضَاه",100,"ا",2,0],["ومَا أَرْضُها مَلثومةٌ بِمبَاسمٍ","ولكنَّها ملثومَةٌ بضمائِر",101,"ر",1,0],["وَمَا ارْتَابَ في عليائِه قَطُّ حَاسِدٌ","إِلى أَنْ يقولُوا زالَ عَنْه ارْتِيابُه",102,"ب",2,0]]}