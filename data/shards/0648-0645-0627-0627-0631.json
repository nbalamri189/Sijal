جيعٍ ثَمَّ مَرْموسِ",94,"س",1,0],["وما أرى الصّبرَ لِي رأياً فأسألَهُ","والقصدُ يُغْرِي به مَن كان مقتصدا",95,"د",2,0],["وما أردتَ على الهَوْ","لِ نَجْدَةً منك جُندا",96,"د",2,0],["وما أراقوه في وادي مِنى زُمَراً","عند الجِمارِ من الكُومِ المسنّاتِ",97,"ت",1,0],["وما ارتشاف زلال الماء في ظمأ","يوماً باعذب من تكرار مدحهم",98,"م",1,0],["وَما أَرضَة البَيتِ الحَرامِ تَعَقَّبَت","كِتابَ قُرَيشٍ إِذ نَفَت كُلَّ ما يُنفى",99,"ف",2,0],["وما أراد القوم في ابتدائهم","به من الخلاص من أعدائهم",100,"م",1,0],["وما أَردنا رضانا","لكن أَردْنا رَضَاه",101,"ا",2,0],["ومَا أَرْضُها مَلثومةٌ بِمبَاسمٍ","ولكنَّها ملثومَةٌ بضمائِر",102,"ر",1,0],["وَمَا ارْتَابَ في عليائِه قَطُّ حَاسِدٌ","إِلى أَنْ يقولُوا زالَ عَنْه ارْتِيابُه",103,"ب",2,0],["وما أرضاكَ حتَّى زِدتَ فَضلا","بِكسوةِ حاضِرٍ مِنهم وباد",104,"د",1,0],["وَما أَرادَ بِهِ إِلا تَقرُّبَهُ","مِنكُم لِيُحرز في سبق العلا قَصَبا",105,"ب",2,0],["وما أراد سوى التمويه خيفة ما","أعددته وسوى التضليل لم يرم",106,"م",1,0],["وما أَرَبُ الخفيفِ الرُّوحِ إلا","خفيفُ الروحِ ذو جسمٍ خفيف",107,"ف",1,0],["وَما أَراه راحَ مُستَقيما","لَكن رَأَيت ذَوقه سَليما",108,"م",2,0],["ومَا أَرِقَتْ عَيْنٌ لَها فِيهِ لَيْلَةً","فَخَفَّ عَلَيْها الحُبُّ وَهُوَ ثَقِيلُ",109,"ل",1,0],["وما أربي جود السحاب بما به","إذا امحلت سحب الدماء السواكب",110,"ب",1,0],["وما أرى خير الأنام كلهم","إلا الوصي الطاهر الأمينا",111,"ن",2,0],["وما أربي وأنا الُمستطيع","القويُّ المطاع الذي يُرهب",112,"ب",1,0],["وَما ارْمَأَزَّ الأُسْحُمانُ الأَسْحَمُ","تَهْوِي الدَواهِي حَوْلَهُ وَيَسْلَمُ",113,"م",1,0],["وما أرى للجود معدناً سوى","أبناء خير المرسلين ذي اللوا",114,"ل",3,0],["وما أَراها لكَ بِدْعاً ولو","كانَتْ ثَلاثاً وثَلاثيناً",115,"ن",2,0],["وما أرى الوصف يبدي ما انطوى","حذراً من شاهد غلطت فيه التعابير",116,"ر",1,0],["وما أراني أحكي سر مجتمع","أسلوبنا فيه ما أعلاه أسلوبا",117,"ب",2,0],["وما أرى قولي يفي بالذي","شاهدته بالعين في ذا المجال",118,"ل",1,0],["وما أردنا ضره مرة","فيما يعاني شهد الله",119,"ه",1,0],["وما أرى سائر ما قلته","يغني ولا أحسبه يكفي",120,"ف",2,0],["وَما أَرادَهُ