udhabi.ae/diwan/poem/90808","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45025","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45026","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45040","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81936","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83475","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83182","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72898","الطويل"],[416,"عقدتْ لموسى بالرصافة ِ بيعة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22403",""],[4767,"مواجهة","https://www.poetsgate.com/ViewPoem.aspx?id=215693",""],[4926,"بمحمَّدٍ وببنته وببعلها","https://www.poetsgate.com/ViewPoem.aspx?id=171100",""],[5046,"أنشكو سقاما.. !","https://www.poetsgate.com/ViewPoem.aspx?id=200960",""],[5064,"دروب التّائهين","https://www.poetsgate.com/ViewPoem.aspx?id=200051",""],[4478,"أعينيَّ لا تستعجلاَ الدمعَ وانظرا","https://www.poetsgate.com/ViewPoem.aspx?id=15121",""],[5186,"بمحياك يا هلال العام","https://www.poetsgate.com/ViewPoem.aspx?id=156438",""],[5273,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=28764",""],[5273,"أراودها","https://www.poetsgate.com/ViewPoem.aspx?id=191953",""],[5273,"ماتا على ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=215886",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5362,"أيا حجة الاسلام يا علم الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=170357",""],[5431,"على لسان نازح سوري...","https://www.poetsgate.com/ViewPoem.aspx?id=209152",""],[5518,"يا حبيب الله","https://www.poetsgate.com/ViewPoem.aspx?id=188939",""],[5612,"بشير الخير","https://www.poetsgate.com/ViewPoem.aspx?id=192486",""],[5612,"ته يا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=193283",""],[5725,"وحين التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=206233",""],[5847,"المولد النبوي الشريف لعام 1435 ه","https://www.poetsgate.com/ViewPoem.aspx?id=176834",""],[6019,"وترفُضُ عينايَ فوضى احتمال !!","https://www.poetsgate.com/ViewPoem.aspx?id=61794",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""]],"verses":[["بِمَحنِيَّةٍ قَد آزَرَ الضالُ نَبتَه","مَجِرَّ جُيوشٍ غانِمينَ وَخُيَّبِ",0,"ب",1,0],["بِمُحَبِّبٍ فِي قَلْبِ كلِّ مُوَادِعٍ","وَمُبَغَّضٍ فِي وَجْهِ كُلِّ مُصَادِمِ",1,"م",1,0],["بمَحلٍّ ترودُ عيناهُ منه","بين مرعى الظباء والحيتان",2,"ن",1,0],["بِمُحتَفِظينَ إِن فَضَّلتُمونا","عَلَيهِم في القَديمِ وَلا غِضابِ",3,"ب",1,0],["بِمُحَمَّدٍ وَمُكَفَّرٍ وَمُحَسَّدٍ","وَمُسَوَّدٍ وَمُمَدَّحٍ وَمُعَذَّلِ",4,"ل",1,0],["بِمُحَمَّدٍ صارَ الزَمانُ مُحَمَّداً","عِندي وَأَعتَبَ بَعدَ سَوءِ فِعالِهِ",5,"ل",2,1],["بِمَحَلَّةٍ أُنُفٍ يُكَلِّفُها","قَومٌ أَرى فيهِم ذَوي غِمرِ",6,"ر",1,0],["بمَحِلّةِ الفُقَهاءِ لا يَعْشُو الفَتى","ناري ولا تُنْضي المَطِيَّ عَزائمي",7,"م",2,0],["بِمُحَمَّدٍ يَبْقَى السُّلُوُّ لنَا","وَتَعِيشُ خَالِدَةً معالِيكَا",8,"ك",2,0],["بِمَحَبَّةِ القُرآنِ كُنت موكّلاً","حَتّى رَثى لَكَ لَوحُكَ المَدروسُ",9,"س",1,0],["بِمَحنِيَّةٍ قَد آزَرَ الضالُ نَبتَها","مَجِرَّ جُيوشٍ غانِمينَ وَخُيَّبِ",10,"ب",1,0],["بمحمد والطيبين ومن إذا","ذكروا بهم بركات فضلك تستهل",11,"ل",1,0],["بمحمد خير الورى والمرتضى","والبضعة الزهرا وبضعتها الحسن",12,"ن",1,1],["بمحبوب شمس فاقت الشمس في الضحى","لها قمرٌ فاقت به قمراً نما",13,"م",2,0],["بمحمدٍ وزرَ الورى وبما لهم","في كُلِّ يوم ندى ويوم كفاحِد",14,"ح",2,0],["بمحاسنٍ لو كان يمكن صوغُها","أغنت غزال الإنس عن خَلخالهِ",15,"ل",2,0],["بمحاجر من حاجر أقذاء قد","طردت ضيوف الطيف جاءت طوّفا",16,"ف",2,0],["بمحضر قطب الأوليا ابن محمد","أبي بكر المشهور فضلا فما يكنا",17,"ن",2,0],["بمُحَجَّبٍ بالأُرجُوانِ مُقَنَّعِ","بالرَّيطِ رَهّافِ السَّدِيفِ مُخايلِ",18,"ل",1,0],["بمحَزّر معد المجلّى يتبعُ ال","هرشيذ يلقى المدلقين جياعا",19,"ع",2,0],["بِمحمّدٍ والبعضُ كان متمّما","اللَّهُ قَد صلّى عليهِ وسلّما",20,"م",2,0],["بِمحامدٍ حمدَ الإله أتى بِها","بِفتوحهِ لا حفظَ لا تَعليما",21,"م",2,0],["بِمحمّدٍ نور المعارفِ شاملُ","لَولاهُ ما عرفَ الفضائل فاضلُ",22,"ل",1,1],["بِمحبّيكَ مِن فَنوا بكَ حبّاً","وَلَهُم بِالفناءِ كان البقاءُ",23,"ا",2,0],["بمحله حرم غدا ام ملجأ","ام كعبة الراجين حين تيمموا",24,"م",3,0],["بمحْمَرٍّ ومصفَرٍّ","مِن الأنوار تَزْدانُ",25,"ن",1,0],["بِمُحَمَّدٍ شادَت قَوا","عِدُ مَجدِها وَعَلا بِناها",26,"ا",3,0],["بِمُحَمَّدٍ نَالَتْ سَناً إِذْ نُورُهُ الْ","أَسْمَى لِشَرْيَانِ السَّنَا كَيْمُوسُ",27,"س",1,0],["بِمُحَمَّدٍ نَالَتْ عُلاً وَمُحَمَّدٌ","آثَارُه ُلِمِعَى الْعُلاَ كَيْلُوسُ",27,"س",1,0],["بِمُحَمَّدٍ نَالَتْ غِنًى وَمُحَمَّدٌ","بِنَدَاهُ بُسْتَانُ الْغِنَى مَغْرُوسُ",27,"س",1,0],["بِمُحَمَّدٍ نَالَتْ مُنًى وَمُحَمَّدٌ","بِلُهَاهُ شُرَّادُ الْمُنَى مَحْبُوسُ",27,"س",1,0],["بِمُحَمَّدٍ جَلَّتْ لِأَنَّ مُحَمَّداً","تَعْنُو لِعَرْشِ جَلاَلِهِ بَلْقِيسُ",27,"س",1,0],["بِمُحَمَّدٍ جَمُلَتْ لِأَنَّ مُحَمَّداً","تَصْبُو إِذَا يَبْدُو نُهىً وَنُفُوسُ",27,"س",1,0],["بِمُحَمَّدٍ شَرُفَتْ لِأَنَّ مُحَمَّداً","شَرَفٌ لَهُ بَيْنَ الْوَرَى قُدْمُوسُ",27,"س",1,0],["بِمُحَمَّدٍ نَالَتْ سُعُوداً بَعْدَمَا","أَخْنَتْ عَلَيْهَا بِالْخُمُولِ نُحُوسُ",27,"س",1,0],["بِمُحَمَّدٍ قَدْ سُرَّ وَجْهُ كَمَالِهَا","وَلَقَدْ خَلاَ الأَزْمَانُ وَهْوَ عَبُوسُ",27,"س",1,0],["بِمُحَمَّدٍ فَرْعُ الْهُمَامِ مَلِيكِنَا","شَمْسِ الْهُدَى حَيِيَ الْحَيَا الْمَرْمُوسِ",27,"س",1,0],["بِمُحَمَّدٍ لِلَّهِ دَرُّ مُحَمَّدٍ","قَدْ نُوِّرَ الإِقْرَاءُ وَالتَّدْرِيسُ",27,"س",1,0],["بمحمد صلوا عليه وسلموا","قد أشرق الكون البهيم المظلم",28,"م",1,1],["بمحمّدٍ وببنتِه وببعلها","أهل الفضائل والمكارم والندى",29,"د",2,1],["بمحمّدنا ختم الرسل","فرجوتك معدوم الحيل",30,"ل",1,0],["بمحض أورادٍ ولا أذكارِ","ولا بصومٍ طال في النهارِ",31,"ر",1,0],["بمحمّدك المحمود ومن","يهدي للحقّ بلا عوج",32,"ج",1,0],["بمحيّاها اهتدائي مثلما","يهتَدي بالنَّجمِ سارٍ في الظلام",33,"م",1,0],["بمحجل وَمثقف وَمهند","وَعصابة حازة بفضل محمد",34,"د",1,0],["بمحمد خطر المحامد يعظم","وَعقود تيجان العقود تنظم",35,"م",1,1],["بمحكمة الإسلام غرداية تعلو","وداود قاضيها الهمام له الفضل",36,"ل",1,1],["بمحمد بن الأعرج الشهم اللبيب","ذي الفضل والآداب والخلق العجيب",37,"ب",1,1],["بمحمد صلى عليه وآله","رب الخلائق ما جرى الملوان",38,"ن",1,0],["بِمَحالَةٍ تَقِصُ الذُبابَ بِطَرفِها","خُلِقَت مَعاقِمُها عَلى مُطَوائِها",39,"ه",2,1],["بِمَحافِظٍ يَسمو بِحُسنِ صِفاتِهِ","وَفَضائِلَ قَد زانَها بِحُلى الجَلالِ",40,"ل",1,0],["بِمُحَمّدٍ حمدت مَقاصِديَ الَّتي","مِن حَمدِهِ فازَت بِأَكرَم بنيةِ",41,"ه",1,1],["بِمُحكمِ التَنزيل بِالتَوارة بِال","إِنجيل بِالصُحف بِأَسرار النبا",42,"ا",1,0],["بمَحْكيَ عَيْنٍ منه إذ يَسِمُ الثَّرَى","لك الخيلُ يَضحِي للبلادِ قَرار",43,"ر",1,0],["بمحمدٍ وَوَصِيِّهِ وَاِبنَيهِما","وَبِعابِدٍ وَبِباقِرَينِ وَكاظِمِ",44,"م",1,1],["بمحمدٍ وَوَصِيَّه وَاِبنَيهما","الطاهِرَينِ وَسيدِ العُبّادِ",45,"د",1,1],["بمحدُودٍ فأشرحُه ولا في","قُوى الأقلام تسطيرُ اشتياقي",46,"ق",2,0],["بمحمد المختار خاتمِ رسله","طه على فضل الجميع قد احتوى",47,"و",2,0],["بمحمَّدٍ فُتلتْ قُوَى أملي","ورَعين آمالي وأُسمنَّا",48,"ن",2,0],["بمحزَمٍ كما طويتَ بُردةً","ومَلجَم كما نشرتَ عن سَفَطْ",49,"ط",1,0],["بمحمد رُدّت على أعقابها","عن ساحتي غُشْمُ الحوادث نُكَّصا",50,"ص",2,0],["بمُحصَداتٍ غيرِ منْقوضةٍ","تسخرُ من بيضِ الظُّبى والرماحْ",51,"ح",1,0],["بمحابِرٍ تَسْقي مَزابِرَها","فسِدامُها منْ مَتْحِها غَلَلُ",52,"ل",1,0],["بمحاسنٍ تحكي زمانَ","الأمنِ أو وصل الملاح",53,"ح",1,0],["بمحبّهِ المشتاقِ ما بحلتهِ","بعد النوى من صفرةٍ ووساوس",54,"س",1,0],["بِمَحْضِ جَلالٍ عِندهُ الكُلُّ خاضِعٌ","بِروحِ جَمالٍ سِرُّها دائماً يَسْري",55,"ر",2,0],["بمحيى الدين يدعى حيث أحيى","لدين الله ذلك نعم مدح",56,"ح",1,0],["بمُحمَّدٍ وأبي مُحمَّدَ أشرَقَتْ","دارُ الإمارةِ كالثُرَيَّا تَنْجَلي",57,"ل",2,0],["بِمُحَيَّا بَاهِرٍ حَسَنِ","قَدْ سَبَانِي لَذَّةَ الوَسَنِ",58,"ن",1,0],["بمحمد كل المحامد زاهيه","ومكارم الاخلاق فيه ساميه",59,"ي",2,1],["بمحبة دفعتك نحو بلادهم","أبوية وضحت وضوح نهار",60,"ر",1,0],["بمحيّا الشهم الهمام وثيق","قد هُدينا إلى سواء الطريقِ",61,"ق",1,1],["بمحمد بن محمد","ذي الطول والنسب القصير",62,"ر",1,0],["بمحبَّةٍ لذاعةٍ حرَّى لمن","يغدو نظيركِ ظالماً لمحبّةِ",63,"ب",2,0],["بمحلّةٍ خضراءَ أفرغَ حليّها ال","ذهبيّ ضاغَةُ قَطرها المسكُوب",64,"ب",1,1],["بمحرثها الجم المحاسن جنةٌ","بما قد حوى منها غدا وهو مفرد",65,"د",1,0],["بمُحمّدٍ خيرِ البريّةِ مَحْتِداً","وأجلِّ مَنْ صلّى الصلاةَ وصاما",66,"م",2,0],["بمحمد خير الورى","ما بين عجم أو عربْ",67,"ب",1,0],["بمحاسن حوت المآزر لا تهن","عبداً اليك من الغلالة أحوجا",68,"ج",2,0],["بمحمدٍ وبحبِّ ألِ محمدٍ","علقَتْ وسائلُ فارس بن محمد",69,"د",1,1],["بمحذوَّةٍ حَذْوَ اللسانِ شبيهةٍ","أَوائِلُها من حُسْنِها بالأَواخر",70,"ر",1,0],["بمحاسنٍ مقرونةٍ بمحاسنٍ","وبدائعٍ موصولة ببدائع",71,"ع",1,0],["بِمُحَمَّدٍ رَضِيَ الإلهُ خَلِيفَةً","فِي الأَرْضِ فَهُو بِذاكَ راضٍ مُرْتَضَى",72,"ض",2,0],["بمحضِ دمعِكمْ عليه","والنحيبِ رَاجِعُ",73,"ع",1,0],["بمحمد بن عبيد الشهم الذي","شاعت محاسنه بكل زمان",74,"ن",1,0],["بِمَحطُوطَةِ المَتنَينِ جَمٌّ عِظامُها","لَها بَشَرٌ صافٍ وَجِسمٌ مُنَعَّمُ",75,"م",1,0],["بِمُحمَرَّةِ الأَجسادِ مُبيَضَّةِ الذُرا","كَمِثلِ سَقيطِ الطِلِّ فَوقَ الشَقائِقِ",76,"ق",1,0],["بمحسن وحسين","قد سرَّ قلب محمد",77,"د",1,0],["بِمحقُ الخَطبُ وَلا يَبقى عَلي","مُشكِلٍ حالَ اِشتِباكات الظُلَم",78,"م",1,0],["بِمَحْبِسِ الهَدْيِ وَبَيْتِ المَسْدَنِ","وَرَبِّ وَجْهٍ مِنْ حِرَاءٍ مُنْحَنِي",79,"ن",2,0],["بمحرّم شهر به","حسن افتتاح وانتشارْ",80,"ر",1,0],["بمحمد عزي فلا أخش","ى من الايام غدرا",81,"ر",2,0],["بمحسن سايغ احسانه","صير أحرار الورى أعبدا",82,"د",2,0],["بمحمّدٍ عشنا بكامل ديننا","وبأحمد فزنا وقد نلنا المرام",83,"م",1,1],["بمحبوبة عندي شهيٍّ حديثُها","رمتني فصادتني بألحاظ مُغْزلِ",84,"ل",1,0],["بمحمد بن معمَّر عَمرت","طرُق الهدى واستوسق المجدُ",85,"د",1,0],["بمحمّدِ بنِ معمرٍ بهمُ","حَسبٌ ومفتخر إذا عُدُّوا",85,"د",3,0],["بمحّمد بن أبي المُعمّر جُلُّهُ","وصَميمَهُ ولُبابه وخيارُهُ",86,"ر",2,0],["بِمَحبَسِنا يَومَ الكُفافَةِ خَيلَنا","لِنَمنَعَ سَبيَ الحَيِّ إِذ كُرِهَ الرَدُّ",87,"د",1,0],["بِمَحبِسِ ضَنكِ وَالرِماحُ كَأَنَّها","دَوالي جَرورٍ بَينَها سَلَبٌ جُردُ",87,"د",1,0],["بِمُحَّمَدٍ وَبِما يَجيءُ بِهِ","مِن سُنَّةِ البُرهانِ وَالح