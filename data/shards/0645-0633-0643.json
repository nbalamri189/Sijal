,"طير الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=175287",""],[192,"يا كاعب","https://www.poetsgate.com/ViewPoem.aspx?id=9857",""],[5943,"كفكف دموعكَ","https://www.poetsgate.com/ViewPoem.aspx?id=11276",""],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""],[5952,"قد هاجت الصبحَ أشواقٌ إلى وطنِ","https://www.poetsgate.com/ViewPoem.aspx?id=197113",""],[5956,"زميلي في السجن ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183659",""],[5957,"لَكَ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=12232",""],[5993,"الشعر ديوان العرب وانت بومه","https://www.poetsgate.com/ViewPoem.aspx?id=186756",""],[6056,"راسي يافهد شابي","https://www.poetsgate.com/ViewPoem.aspx?id=130323",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[6068,"مسكتْ بحدّ الخنجر -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175933",""],[6115,"قالو عللامك مع الأيام متغير","https://www.poetsgate.com/ViewPoem.aspx?id=180495",""],[6127,"عذبٌ لَمَاك","https://www.poetsgate.com/ViewPoem.aspx?id=188486",""],[5309,"مسكينة جمعية الأمم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573954",""],[6198,"بحر غريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79234&r=&rc=8",""],[399,"إلى عيني الحزينتين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68239&r=&rc=64",""],[6222,"يا تائهون على الدروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1930&r=&rc=1",""],[6245,"حالات مطرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87629&r=&rc=0",""],[5190,"شموع ودموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85041&r=&rc=116",""]],"verses":[["مِسكِيَّةُ النَفَحاتِ تَحسَبُ تُربَها","بُردَ الخَليعِ مُعَطَّرَ الأَردانِ",0,"ن",1,0],["مِسكِيَّةَ النَفحاتِ يَشرُفُ أَصلُها","عَن بابِلٍ وَيجلُّ عَن قُطرَبُّلِ",1,"ل",1,0],["مِسْكُ الخِتَامِ بِهَا دُعَاءٌ خَالِصُ","لَكُمُ بِعَيْشِ رَفَاهَةٍ وَأَمَانِ",2,"ن",1,0],["مَسْكَنٌ يَجْمَعُ المَسَرَّاتِ فِيهِ","سَكَنٌ تَنْتَهِي إِلَيْهِ الأَمَانِي",3,"ن",2,0],["مسكيَّة الأقلام في أطراسها","بين القصائد سجداً أو ركعاً",4,"ع",2,0],["مسكيَّة الخال أمَّا ورد وجنتها","فبالجنى من عيونِ الناس مبلول",5,"ل",1,0],["مَسْكَنُها في حشا أبي حَسَنٍ","لا أسكن الله روحه جسدَهْ",6,"د",2,0],["مَسكَنُكِ القَلبُ فَلا","تَرضي لَهُ بِالوَصَبْ",7,"ب",1,0],["مسكت باليد المليحة","قلبا لها انفطر",8,"ر",1,0],["مِسكِيَّةُ النَفَحاتِ إِلّا أَنَّها","وَحشِيَّةٌ بِسِواهُمُ لا تَعبَقُ",9,"ق",1,0],["مُسكِري إِن سُقيتُ مِنهُ بِعَيني","أُرجُوانٌ مِن خَمرِ خَدَّيهِ صِرفُ",10,"ف",1,0],["مِسكينُ مَن غَرَّتِ الدُنيا بِآمالِه","كَم قَد تَلاعَبَتِ الدُنيا بِأَمثالِه",11,"ل",2,1],["مِسكاً وَقَدَّرَ إِنشاءَ الوَرى طَينا","نَحنُ الفِداءُ لِمَن أَبقى لَنا خَلَفاً",12,"ف",2,0],["مسكينة بلهاء لا","تدري الزمان ولا فنونه",13,"ن",2,0],["مِسكاً وَجادِيَّ العَبير فَأَشرَقا","حَتّى كَأَنَّ دَماً يُقالُ أَصابَهُ",14,"ب",2,0],["مسكينةً تطوين بحرَ الليالْ","قد عزَّكِ المرسى بشطآنِهِ",15,"ه",1,0],["مُسكَّناً وبعدَهُ مُحَرَّكا","كنُونِ كُنَّا وكراءِ سَرَّكا",16,"ك",2,0],["مَسْكِنٌ لَوْ بَنَوهُ تِبْراً لَمَا أَعْ","لَوهُ قَدْراً فِي أَعْيُنِ النُّقَّادِ",17,"د",1,0],["مسكُ دارينَ وخمرُ الأندرينا","أخذتْ قلبي وصبري والكرى",18,"ر",2,0],["مسكتُمْ من خِناقةِ أفعُوانٍ","شديدِ البطش يأبى الإنصِراعا",19,"ع",2,0],["مسكية الشم واطرافها","يظنها الناظر زيق العذار",20,"ر",1,0],["مسكري إن شربت منه بلحظي","بشهي من خمر خديه صرد",21,"د",1,0],["مسكين هاللي الكلام برضيه","زيادة الخير أحسن وأخير",22,"ر",1,0],["مسكين ما ذاق طعم العشق منذ بدا","ولا استفزّته من لقمان أرواح",23,"ح",1,0],["مسكين سامحه الإِله بذنبه","فلقد تفوه بالحديث المفترا",24,"ر",2,0],["مسكين مغلوب على أحبابه","من غير ذنب سابق هجروه",25,"و",2,0],["مسكنا فتنة ثارت فثار لها","هذا المقال الذي ضلت مساعيه",26,"ي",2,0],["مسكين لا حرجٌ عليه إذا بكى","وإذا هنالك راح ينشد سولا",27,"ل",2,0],["مسكينُ لا يشكو ويندبُ حظه","ونصم دون شكاتهِ الآذانا",28,"ن",2,0],["مسكية النفحات الا انها","عن عرفها ينبيك غيب غراسها",29,"س",3,0],["مسكية الاوصاف الا انها","يسوى مديحك نشرها لا يعبق",30,"ق",1,0],["مسْكٌ وشُهْدٌ جُمِعا","في شعلة مُتَّقده",31,"د",2,0],["مسك يَفوح وانوار تَلوح عَلى","فضى خد بماء الحسن مَطلول",32,"ل",1,0],["مسكين ما له قرار","ولا لقلبه سكون",33,"ن",1,0],["مسكية الأنفاس ذات محاسن","تنمي اللبيب حميدة الآثار",34,"ر",1,0],["مسكية الأنفاس في لهواتها","كالشهد يشفى كل عبد موجع",35,"ع",1,0],["مِسكٌ تَمَسَّكَ بَعضُهُ في بَعضِهِ","وَالبَعضُ سالَ فَفاحَ في الأَرجاءِ",36,"ا",2,0],["مَسكية أَنفاسُها فَكَأَنَّما","هَبَت نَسائِمُها بِنَشر كَباءِ",37,"ا",2,0],["مسكين مسكين من قرب إلى المجزره","وقد دنا منه سكنى القبر والمقبره",38,"ر",2,1],["مِسْكِيَّةُ النفحات يسْطعُ طيبها","ما افتضَّ ربّ الحان ختم دنانها",39,"ن",3,0],["مسكينة هذي العروبة ما درت","ما عارها الباقي وما هو عاركم",40,"م",1,0],["مسكينة إن من خانوك أوقحهم","أهلوك أو من تراءوا شبه أهليك",41,"ك",1,1],["مسكته كلتا الراحتين فيختفي","وجه الغزالة تارة ويبين",42,"ن",1,0],["مسكين يلمع له في الكون برق الحق","فيفتتن وهو عاشق وهو حر رق",43,"ق",1,1],["مسك له الكل طيب عرف","معنى له الكل كالمباني",44,"ن",2,0],["مسكيةِ الأَنفاسِ طيبةٍ بِلا","طيبٍ وحالية الجمالِ بلا حُلي",45,"ل",2,0],["مُسَكِّن الأَرضِ بعد ما اضْطَربَت","ومُصلِحُ الدَّهْر بعد مَا فَسَدَا",46,"د",2,0],["مِسْكٌ وخَمْرٌ وبَرَدْ","رِضابهُ لِذَا رفَدْ",47,"د",1,1],["مسكني بلدة بها ينقل الما","ء إلى الناس فوق ظهر الدواب",48,"ب",1,0],["مسكين من يَطبُخ الفاس","وَيريد مَرَق مِن حَديده",49,"ه",1,0],["مسكين من يصحب الناس","وَيريد مَن لا يُريدُه",49,"ه",1,0],["مسكين سَمور مِن غير اِودان","ما عاد يروح لِسَمّورَه",50,"ر",2,0],["مسكين عمر دار لَوطان","راح الجَزاير وَتونس",51,"س",1,0],["مسكيُّ ريق مَن يذْقه يهم","من لذة السكر وساقيه صاح",52,"ح",1,0],["مَسَكْنا دموعاً أن تذوب من الهوى","وسرّاً بألفاظ الدموع مترجما",53,"م",2,0],["مِسْكٌ غَزَالٌ قَضِيبٌ نَيِّرٌ غَسَقٌ","زَهْرٌ خَلِيجٌ رَبِيعٌ وَرْدَةٌ شَرَرُ",54,"ر",1,0],["مَسكية انى فَضَضت خِتامَها","عَبق الشَذاءُ بِنَشرِها الفَضّاح",55,"ح",1,0],["مسكن لوجع الأضراس","وللصداع وعروق الراس",56,"س",1,0],["مسكه عرف كل معنى بديع","روقه فوقه الروي على لا",57,"ل",2,0],["مسك المحبة في الاكوان قد فاحا","وسيل أهل الحما في الربع قد ساحا",58,"ح",2,1],["مسكر باللحاظ تحسب في أح","فان عينيه حانة الخمار",59,"ر",1,0],["