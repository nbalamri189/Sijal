,"https://www.aldiwan.net/poem15245.html","الكامل"],[475,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[480,"بجيم جمال الله أسأل منيتي","https://www.aldiwan.net/poem24547.html","عموديه"],[493,"أحاجيك أناجيك","https://www.aldiwan.net/poem9862.html","الهزج"],[498,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[498,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[498,"يا عيون النرجس الغض ألا","https://www.aldiwan.net/poem38029.html","الرمل"],[503,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[512,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[522,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[536,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[536,"تبدت نجوم الفن في أفق الغرب","https://www.aldiwan.net/poem48272.html","عموديه"],[541,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[549,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[549,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[549,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[549,"ونجلاء لا ترقا لها الدهر دمعة","https://www.aldiwan.net/poem47909.html","الطويل"],[549,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[556,"ربنا من لطفه لا يدرك","https://www.aldiwan.net/poem33505.html","الرمل"],[556,"قل لمن قال عن ذوي العرفان","https://www.aldiwan.net/poem33820.html","الخفيف"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[571,"حدثني الشوق عن تباريحي","https://www.aldiwan.net/poem3653.html","المنسرح"],[573,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["وَنَجَّذَني صَرفُ الزَمانِ وَوُقَّرَت","عَلى الحِلمِ نَفسي وَاِنقَضى نَزَوانُها",0,"ن",3,0],["وَنَجوى قَد شَهِدتُ وَعُدتُ أُلقي","عِنانَ فَمي إِلى قَلبٍ كَتومِ",1,"م",1,0],["وَنَجا الغاوِيُّ يُفَدّي مُهرَهُ","خَزِيَ المَوقِفِ قَد ليمَ وَلاما",2,"م",2,0],["وَنَجا مِن زَحمَةِ المَو","تِ وَلِلمَوتِ زِحامُ",3,"م",1,0],["وَنَجيبَةٍ نَهَضَ الزَمانُ بِها","مِن بَعدِ ما قَعَدَت بِها العُقُلُ",4,"ل",1,0],["وَنُجومٌ تَنوبُ عَنها العَوالي","مِن سَماءِ العَجاجِ في الآفاقِ",5,"ق",1,0],["وَنَجا المَغرورُ مِن جامِحِها","مُفلِتَ الشَحمَةِ حَلقَ المُزدَرِد",6,"د",1,0],["وَنَجمَينِ يَقصُرُ عَن نَيلِنا","مِنَ الطالِعاتِ الذُرى وَالرَوابي",7,"ب",2,0],["وَنَجلٍ تَغَلغَلَ فيها الطَعا","نُ وَاِنشَقَّ عَنها النَجيعُ الصَبيبُ",8,"ب",1,0],["وَنَجدٌ دارُها وَبِهِ","شَبا الخَطِّيَّةِ المُلْدِ",9,"د",1,0],["ونَجيبَةٍ مَمْغوطَةٍ أنْساعُها","تَخْدي بمَعْروقِ العِظامِ نَحيفِ",10,"ف",1,0],["ونَجَوتُ مُنصَلِتاً ولَم أكُ ناصِلاً","سِيمَ المُروقَ فلَم يُعِنْهُ الفُوقُ",11,"ق",1,0],["وَنَجَوْتَ مَنْجَى الْبَدْرِ بَعْدَ مُحَاقِهِ","تَهْوِي كَمَا يَهْوِي بِجَوٍّ أَجْدَلُ",12,"ل",1,0],["ونجعَلُ منْك اليومَ عيداً ومَشْهَداً","نُشيعُ منَ الذّكْرِ الحَكيمِ بهِ شُهْدا",13,"د",2,0],["وَنَجْتَابُ مِنْ سَرْدِ الْيَقيِنِ مَدَارِعاً","يُكَيِّفُهَا مَنْ يَجْتَبي وَيُنيبُ",14,"ب",1,0],["وَنَجَّدَني عِلمٌ تَوالَت فُنونُهُ","كَما يَتَوالى في النِظامِ سِخابُ",15,"ب",1,0],["وَنَجا رَبيعَةُ يَومَ ذَلِكَ مُرهَقاً","لا يَأتَلي في جودِهِ يَجري",16,"ر",2,0],["ونجباء العرب في ال","أوطان والمهاجر",17,"ر",1,0],["وَنَجَوْا بِعِزَّتِهَا وَبِاسْتِقْلالِهَا","مِنْ حَوْزَةِ الآسَادِ الآجَامِ",18,"م",1,0],["ونجمدُ فيغفلة هكذا","ونمرَح في لهونا واللعِب",19,"ب",1,0],["وَنَجلُو عِظلِمَ الهبواتِ عنَّا","بِغُرٍّ بِالفِعَالِ مُحَجَّلِينَا",20,"ن",2,0],["وَنَجداً حَيثُ أَورَقَ كُلُّ عُودٍ","وآنَقَ نَبتُهُ المُتَاَنِّقِينَا",20,"ن",2,0],["وَنَجنِبُ ما أَلقى الوَجيهُ وَلاحِقٌ","إِلى كُلِّ ما أَبقى الجَديلُ وَشَدقَمُ",21,"م",1,0],["وَنَجني جِناياتٍ عَلَيهِ يُقيلُها","وَنُخطِئُ أَحياناً إِلَيهِ فَيَحلَمُ",21,"م",1,0],["وَنَجا اِبنُ خَضراءِ العِجانِ حُوَيرِثٌ","يَغلي الدِماغُ بِهِ كَغَليِ الزِبرِجِ",22,"ج",1,0],["وَنَجا أَراهِطُ أَبعَطوا وَلَوَ اِنَّهُم","ثَبَتوا لَما رَجَعوا إِذاً بِسَلامِ",23,"م",1,0],["وَنَجا اِبنُ قَيسٍ في بَقِيَّةِ يَومِهِ","وَبِهِ الرِماقُ مُوَلِّياً بِجُروحِ",24,"ح",1,0],["وَنَجا وَأَفلَتَ مِنهُمُ مُتَسَرِّعاً","فَلُّ قَليلٌ هارِبٌ يُتَمَزَّعُ",25,"ع",1,0],["وَنَجا وَأَفلَتَ مِنهُمُ مَن قَلبُهُ","شَعفٌ يَظَلُّ لِخَوفِهِ يَتَصَدَّعُ",25,"ع",1,0],["ونجل من بني الآداب أفدي","حلاه بالصغير وبالكبير",26,"ر",1,1],["ونجوماً من الأحبَّة سارت","يا ترى هل لسيرِها من رجوع",27,"ع",1,0],["ونجا فَلُّهم على فَلِّ خَيْلٍ","كُنّ أقبلن كالقطا الأرسالِ",28,"ل",1,0],["ونَجمعُ المالَ نرجو أن يُخَلِّدنا","وقد أبىَ قبلنا تخليدَ قارون",29,"ن",1,0],["ونجومٌ مسعودةٌ لم يُصبْها","نحسُ بَهرام لا ولا كيوان",30,"ن",1,0],["وَنَجّى اِبنُ بَدرٍ رَكضُهُ مِن رِماحِنا","وَنَضّاخَةُ الأَعطافِ مُلهِبَةُ الحُضرِ",31,"ر",1,0],["ونُجومَ اللَّيلِ تُضاحِكُهُ","ونَسيمَ الغابِ يُطَارِدُهُ",32,"د",2,0],["ونجومُ السَّماءِ فيهِ شموعٌ","أَوْقَدَتْها للحُبِّ روحُ القُرونِ",33,"ن",1,0],["وَنجمان زَينٌ لِلزَمان اِحتواهما","بِقُرطبةَ النكداء أَو رُندَةَ القَبرُ",34,"ر",1,0],["ونُجانب الوطنيّ من أشيائنا","ولو أنّه من أحسن الموجود",35,"د",1,0],["ونجيب مهذب من نجيب","هدَّبته تجارب الأحوال",36,"ل",1,0],["وَنَجيبَةٍ بَينَ العَقا","ئِلِ هَمُّها لا يَنسَلي",37,"ل",2,0],["وَنِجادَ لَم يُطاوَل ضَحوَةً","نالَهُ الفَجرُ عِشاءً بِالقِصَر",38,"ر",1,0],["وَنَجيبَةٍ بَينَ الطُفولَةِ وَالصِبا","عَذراءَ تَشرَبُها القُلوبُ وَتَعلَقُ",39,"ق",1,0],["وَنَجّى الكِنانَةَ مِن فِتنَةٍ","تَهَدَّدَتِ النيلَ نيرانُها",40,"ن",3,0],["وَنَجيبٌ مُهَذَّبٌ مِن نَجيبٍ","هَذَّبَتهُ تَجارِبُ الأَحوالِ",41,"ل",1,0],["ونجعل جسمه روحاً لطيفاً","فيمتزجان في الكنّ الكنينِ",42,"ن",1,0],["ونجلها من ذهب صابغ","ماجدة أحبلها ماجد",43,"د",1,0],["ونجلهما منهما عالم","جريء على خصمه مقدم",44,"م",1,0],["ونجعل ما يطير السحق عنها","هباءً لا يحس به ضئيلا",45,"ل",2,0],["ونجعل حبَّ سنبلنا طحينا","نخمّره على مهل طويلا",45,"ل",2,0],["وَنَجارُ المَجدِ نَبعٌ","شُقَّ مِن فَرعَيهِ عودُك",46,"ك",1,0],["وَنُجومُ مَن عاداكَ في أُهوِيَّةٍ","بَخَعَت بِطالِعِ نَجمِكَ المَسعودِ",47,"د",1,0],["وَنَجّاهُ مِن وافي الحَمائِلِ أَنَّهُ","تَلَقّاكَ غَضباناً فَأَلقى الحَمائِلا",48,"ل",2,0],["وَنُجومٌ إِذا تَوَقَّدنَ في الخَط","بِ تَوَهَّمتَ في النُجومِ أُفولا",49,"ل",2,0],["وَنَجّى أَبا المِنهالِ ثانٍ كَأَنَّهُ","يَدا سابِحٍ في غَمرَةٍ يَتَذَرَّعُ",50,"ع",1,0],["وَنَجّى طُفَيلاً مِن عُلالَةِ قُرزُلٍ","قَوائِمُ يَحمي لَحمَهُ مُستَقيمُها",51,"م",3,0],["وَنُجِّدَ بِالثَرى لَكَ بَيتُ هَجرٍ","وَأَسرَعَتِ الأَكُفُّ إِلَيهِ نَقلَك",52,"ك",1,0],["وَنَجلو بِأَيّامِ السُرورِ وَنورِها","لَيالِيَ أَحزانٍ بِها العَيشُ مُظلِمُ",53,"م",1,0],["وَنَجيُّهُ في سِرِّهِ وَوَصيُّهُ","في أَمرِهِ وَصَفيُّهُ مِن بَعدِهِ",54,"د",2,0],["ونجابةٌ وَقْفٌ عَلَيهم فضلُها","مَنقولةٌ منهم إلى الأولادِ",55,"د",1,0],["ونَجائبٍ مثل القِسيِّ ضوامرٍ","وَصَلَت بقطعِ سَباسِبٍ وسهوبِ",56,"ب",1,0],["وَنَجا اِبنُ خائِنَةِ البُعولَةِ لَو نَجا","بِمُهَفهَفِ الكَشحَينِ وَالآطالِ",57,"ل",1,0],["وَنَجيبَةٍ جاءَت بِأَوحَدِ أَمجَدٍ","قَد فاتَ طَولاً أَيدِيَ النُجَباءِ",58,"ا",2,0],["وَنُجِلُّ شيعَتَهُ وَنُكرِمُ حِزبَهُ","وَنَصونُ بَعدَ نَبِيِّهِ الإِسلاما",59,"م",2,0],["وَنَجّاكَ مِن أَزدِ العِراقِ كَتائِبٌ","لِقَحطانِ أَهلِ الشامِ لَمّا اِستَهَلَّتِ",60,"ت",1,0],["ونجمُ الليل يركضُ في الدياجي","كأنّ الصُّبْحَ يطلبُهُ بثار",61,"ر",1,0],["ونَجا ابنُ حفصونٍ ومَن يكنِ الرَّدى","والسيفُ طالبُهُ فليسَ بناجِ",62,"ج",1,0],["ونجعلَ من حشرجاتِ الرجال","تحيَّةَ شادٍ لأنخابنَا",63,"ن",2,0],["ونجمُنا ما زال طَلْقَ السَّنى","يُطالع الأفقَ ويلقَى البطاحْ",64,"ح",1,0],["ونجَّى قابِضاً وَرْدٌ سَبُوحٌ","يمرُّ كأَنَّهُ مِرِّيخُ غالِ",65,"ل",1,0],["ونجوم السماءِ تعجب منّا","كيف تبقى من بعدنا وتمرُّ",66,"ر",1,0],["ونجمة مالت ونجمة","حلفت ما تتاخر",67,"ر",1,0],["وَنُجِلُّهَا أَبَداً بِذِكْرَى أَنَها","صَانَتْ حَقِيقَتنا مِنَ الإِحْقارِ",68,"ر",1,0],["وَنَجَوْتَ مِنْ حَرَبِ الحَياةِ","فَحَبَّذَا هَذَا المصِيرْ",69,"ر",1,0],["وَنُجُومُ الْعُلَى رَوَانٍ شَوَاهِدْ","يَتَطلَّعْنَ مِنْ عَلٍ ذَاهِلاَتِ",70,"ت",1,0],["وَنَجْتَازُ هَذَا الفَضَاءَ رَحِيباً","فَأَمَّا بِنَا فَهْوَ لَمْ يَرْحُبِ",71,"ب",1,0],["وَنَجا لِلحُسنِ مِن ضَرَرٍ","لا لَمىً أَبقى وَلا نَجلا",72,"ل",2,0],["وَنَجدَةٌ خيلَت لِمَسمَعِهِ","أَنَّ أَبا الشِبلِ حينَ زارَ رَغا",73,"غ",2,0],["ونجا فاروقُها فاستبشرت","وصفا الدهر فكانت بُشْرَيَيْنْ",74,"ن",1,0],["وَنَجْمَعُ مِنْ زَهْرِهِ ما نَشَاءُ","ونَرْفُلُ في ثَوْبِهِ الْمُخْمَلِ",75,"ل",1,0],["وَنَجُرُّ الذُّيولَ في غَيْرِ نُكْرٍ","طَاهِرِي النَّفْسِ طاهِري الْجِلْبابِ",76,"ب",1,0],["ونجى قابض ورد سبوح","يَمْرُّ كأنهُ مريخُ غالِ",77,"ل",1,0],["ونجعل فيها منك عيدا ومشهدا","نشيع من الذكر الحكيم به شهدا",78,"د",2,0],["ونجا بمهجته وأسلم قومه","متسربلين رواعف المران",79,"ن",1,0],["ونَجا ابنُ حَمراءِ العجانِ حويرثٌ","يغلي الدِّماغُ بهِ كغليِ الزبرجِ",80,"ج",1,0],["ونجمٌ تَغَوَّرَ من حُبّها","ونجمٌ عليها ادَّنى فادَّلى",81,"ا",1,0],["وَنُجُومٌ، إذا تَوَقّدْنَ في الخَطْ","بِ حُبّاً يُرْضُونَ فيه الرّسُولا",82,"ل",2,0],["ونَجْمنا يَسْطَعُ بين السُّعودِ","وحضْرتُنَا في الورَى عَالِيَهْ",83,"ي",2,0],["ونجلٌ بالممالِك والمعالىِ","وإنْ أمواله أصبحن مَرْعَى",84,"ع",2,0],["وَنجلَ فتى هجاه وكان شيخا","له في العلم لو تُرعَى الذمام",85,"م",1,0],["وَنَجل الحارِث القاضِي هجاه","وَبِالدِّين الحَنيفِ لَهُ اعتِصام",85,"م",1,0],["ونجمع في مساجدنا وكنا","نديم بها الاقامة والآذانا",86,"ن",2,0],["ونُجَلِّى غَوَامِضاً قَد خَفَاهَا","في القَضَايَا نُبِينُ سِحرَ البَيَانِ",87,"ن",1,0],["ونَجعَلُ حَليَهَا فِيهَا فَتُمسِى","تَذُمَّ لَهَا اللآلِىءَ والجُمَانَا",88,"ن",2,0],["ونُجومٌ مِثْلُ الدَّراهِمِ أَحْدَقْ","نَ ببَدرٍ في الجَوِّ كالدّينارِ",89,"ر",1,0],["ونجمك ثاقبٌ وفناك رحب","وظلك في جوانبه مديدَ",90,"د",1,0],["ونجتني من الحديث المشتهى","نوادرا مثل قطيف الزهر",91,"ر",1,0],["وَنَجدَةٌ لَو لِلَيثِ الغابِ أَيسَرُها","عَلا البِقاعَ وَلم يَستَذرِ بِالأُجُمِ",92,"م",1,0],["ونجله الفاضل المدعو محمد من","ساس الحكومة بالتدبير يفتكر",93,"ر",1,0],["ونجم ملكك اضحى السعد طالعه","والعز يخدمه والنصر والظفر",94,"ر",1,0],["ونجترع الخطايا كل وقت","بأرض ما بها رأى رشيد",95,"د",1,0],["ونجومُ الليل تَحْكي","لؤلؤاً فوق بَنَفْسَج",96,"ج",1,0],["وَنَجلوها عَلى النَدمانِ بِكراً","كَقَرنِ الشَمسِ في جُنحِ الظَلامِ",97,"م",1,0],["وَنَجا وَالريحُ لا تَط","مَعُ مِنهُ في لِحاقِ",98,"ق",1,0],["وَنُجومُ السَماءِ يَنظُرنَ شَزراً","كُلَّما تَنظُرُ الوُشاةُ بِحِقدِ",99,"د",1,0],["وَنَجَمَت في لِمَّتي","طَوالِعٌ كَالشُهُبِ",100,"ب",1,0],["ونجاح الأمور في كلّ قصدٍ","لحبيبي محمّد بن سعاده",101,"د",2,0],["ونجابة النجباء اسرع","ما يشب بها الجنين",102,"ن",1,0],["ونجل قديم المجد غير حديثه","وليس حديث في العلا كقديم",103,"م",1,0],["ونجل أولي الجود الذين اكفهم","على الدهر يستسقى بهن من الصدى",104,"د",2,0],["ونجل قدرك والثريا في الثرى","ان قيل يشبه شكلها العنقود",105,"د",1,0],["ونجومٍ فوقنا مُشرقةٍ","لتُرينا بعدَ ضيقٍ فرَجا",106,"ج",2,0],["ونجزعُ من تنائينا فنبكي","ونشبكُ للتَّداني ساعِدَينا",107,"ن",2,0],["ونجومُه في مُقلتيكِ ضياؤها","والقلبُ عندكِ مُهتدٍ وضليل",108,"ل",1,0],["ونجمع قبلاتٍ بها قد سمحتِ أو","تسمّحتِ ما بينَ التمنُّعِ والبذلِ",109,"ل",1,0],["ونَجْداً يَسْتَخِفُّ الشمّ حِلْماً","نَحا رضْوى وَحَطَّ عَلى ثَبيرِ",110,"ر",1,0],["ونَجْعَةٌ لِفَارِط ورائِد","وعِصْمَةٌ لِقَائِمٍ وقاعد",111,"د",1,0],["وَنَجيبُ العِلمِ مَعقولٌ وَقَد","أُنشِطَ الجَهلُ إِذَن بَعدَ عِقالِ",112,"ل",1,0],["وَنجمةً لامعةً","في شرقها والمغرب",113,"ب",1,0],["ونجّيا للَه في غاره الأنور","والليل قاتم الجلباب",114,"ب",1,0],["وَنجمٍ دونه الأهوا","لُ بينَ الدلوِ وَالعَقرب",115,"ب",1,0],["ونجمَ عَدْلٍ لا انكَدَر","محا منَ الجَوْرِ الأَثَر",116,"ر",1,0],["ونِجادُ كتابتِه أبداً","بالدُّرِّ تُرصِّعُه يَده",117,"د",2,0],["ونجومُ اللَّيلِ يَجْلو بينها","غُرةَ البدرِ لنا فَضْلُ الضياء",118,"ا",2,0],["وَنَجَّاكَ خَوَّارُ العِنانِ مُقلِّصٌ","طويلُ عِمادِ الصَّدرِ من خيلك الشُهبِ",119,"ب",1,1],["وَنُجومُ الأَفقِ إِن كَثُرَت","لَم تُكاثِر عِدَّةَ الرُقَبا",120,"ب",2,0],["ونَجوتَ مُنفرداً بنَف","سِكَ لا تُلامُ ولا تُذمَّم",121,"م",1,0],["ونجوت من نارٍ غدت","بزناد شرِّكَ تنقدح",122,"ح",1,0],["وَنجا بتَوبتِهِ الصحيحةِ مذ رأى","سِجنَ الجحيم مُؤَبَّداً بلَظائِهِ",123,"ا",3,0],["وَنجومُهُ الزُهرُ الَّتي تهدي الوَرى","وَليوثُهُ اِن غابَ لَيثُ الغابِ",124,"ب",1,0],["ونجّي الرمال والوحش والبي","د وطيف الشحوب والأدواء",125,"ا",