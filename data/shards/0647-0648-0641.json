html","الكامل"],[283,"من يرجي خيرا من ابن عنين","https://www.aldiwan.net/poem32370.html","الخفيف"],[298,"نفحتنا بنشرها المستطاب","https://www.aldiwan.net/poem33332.html","الخفيف"],[343,"بنت الدلال اما كفاك دلالا","https://www.aldiwan.net/poem55333.html","الكامل"],[367,"لا تقبلوا قول الوشاة فإنهم","https://www.aldiwan.net/poem16909.html","الكامل"],[404,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[404,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[410,"قسم الهوى دهر المروع بالنوى","https://www.aldiwan.net/poem32359.html","الكامل"],[433,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[453,"لي حبيب حسن الود","https://www.aldiwan.net/poem13625.html","مجزوء الرمل"],[454,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[462,"هو في ناديه طود راسخ","https://www.aldiwan.net/poem15398.html","الرمل"],[462,"وائلوا بي إلى أغر هجان","https://www.aldiwan.net/poem15692.html","الخفيف"],[465,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[465,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[465,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[465,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[465,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[466,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[501,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[501,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[501,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[501,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[501,"أقلق الحاسد مني","https://www.aldiwan.net/poem38095.html","مجزوء الرمل"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[515,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[516,"أيها السيد الذي أنا عبده","https://www.aldiwan.net/poem12085.html","الخفيف"],[539,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[544,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[559,"نحن المراتب بالوجود مرتبه","https://www.aldiwan.net/poem33526.html","الكامل"],[559,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[559,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[559,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[568,"ونديم مخالف","https://www.aldiwan.net/poem69628.html","مجزوء الخفيف"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"]],"verses":[["هُوَ في الأَجسامِ مِنكُم","وَهوَ مِنّا في القُلوبِ",0,"ب",1,0],["هُوَ في يَدَيكَ وَديعَةٌ لِرَعِيَّةٍ","تُثني بِأَلسِنَةٍ عَلَيكَ فِصاحِ",1,"ح",1,0],["هُوَ في الناسِ ظاهِرٌ غَيرَ حَرفٍ","واحِدٍ في هِجائِهِ يُخفيهِ",2,"ي",2,0],["هُوَ في ضَمانِ العَزمِ يَعبِسُ وَجهُهُ","لِلخَطبِ وَالخُلُقِ النَدي الضَحّاكِ",3,"ك",1,0],["هُو فِي كُلِّ مَوْطِنٍ عَرَبِيٍّ","طَوْقُ وَرْقَائِهِ وَقَيْدُ الرِّيمِ",4,"م",1,0],["هو في النشاط كمرجل","يغلي فيسمعنا أزيزه",5,"ز",2,0],["هو في الخليقة ذو عجائب سرّها","أعيا اللبيب وأعجز المتفطنا",6,"ن",2,0],["هو في الناس صاحب الأمر والنه","ي مطاع في النقض والإبرام",7,"م",1,0],["هو في القول ما اعتمد","غير ما ذاق واختبر",8,"ر",1,0],["هو في قدره حقير ولكن","جمعه مُوصل إلى العظمات",9,"ت",1,0],["هو في الناس قدره متعالٍ","لم يَطُل صرح إيفلٍ أنشازه",10,"ز",2,0],["هُوَ في الرومِ مُقيمٌ","وَلَهُ في الشامِ قَلبُ",11,"ب",1,0],["هو في القلب وهو أبعد من نج","م الثريّا فهو القريب البعيدُ",12,"د",1,0],["هو فخر امته التي عزت به","ان فاخرت برجالها الاقوام",13,"م",1,0],["هو في زورتي سلامي عليه","وهو شعري الذي يشايع حسي",14,"س",2,0],["هو في المهرجان حى شهيد","يجتلى غرس فضله كيف أجنى",15,"ن",2,0],["هُوَ في المِهرَجانِ حَيٌّ شَهيدٌ","يَجتَلي عُرسَ فَضلِهِ كَيفَ أَجنى",16,"ن",2,0],["هُوَ فيهِ بَديعُ كُلِّ زَمانٍ","ما بَديعُ الزَمانِ ما أَسجاعُه",17,"ع",2,0],["هُوَ في المُلكِ بَدرُهُ المُتَجَلّي","حُفَّ بِالهالَتَينِ مِن بَرلُمانِه",18,"ن",2,0],["هُوَ في الغِنى غَرسي وَغَرسُكَ في العُلى","أَنّى اِنصَرَفتَ وَأَنتَ غَرسُ اللَهِ",19,"ه",1,0],["هو في العلم آخرُ","وهْو في الظُّلم سابقُ",20,"ق",1,1],["هو في الدُّنيا حياةٌ تُشْتَهَى","وهو في الأُخْرَى نَجاةٌ للبَشَرْ",21,"ر",1,0],["هو في الإشراقِ كالنُّور الذي","سالَ في بدرٍ ويومَ الخندقِ",22,"ق",1,0],["هو في الحفيرةِ دُونَ حِصنِ مُحمدٍ","جَثَمَ الحِمامُ عليه قبل قيامهِ",23,"م",2,0],["هُوَ فَوقَكُم لِلأَمنِ ظِلٌّ سابِغٌ","لَو أَنَّ ظِلّاً قَد أَضاءَ وَنَوَّرا",24,"ر",2,0],["هُوَ في عَيني جَديدٌ دائِماً","وَسِواهُ الدَهرُ في عَيني خَلَق",25,"ق",1,0],["هو في نارها الشديدة حرا","ن وفي زمهريرها مقرور",26,"ر",1,0],["هو في نظمه يقلد طيراً","سبقته وإِنَّ فيَّ ابتكارا",27,"ر",2,0],["هو في الأفق بعيدٌ وهو دانِ","هو لي نفسي وروحي وكِياني",28,"ي",1,0],["هو فجرُ النبوغِ يصدحُ فيه","كلُّ من أطلقَ الهوى وجدانَه",29,"ن",2,0],["هُوَ فَصْلٌ تَخْتَالُ فِيهِ غُصُونُ الرْ","رَوْضِ فِي حِلْيَةٍ مِنَ الأَزْهَارِ",30,"ر",1,0],["هُوَ فَيْلَسُوفٌ سِيرَةً وَسَرِيرَةً","مُتَطَابِقُ الأَقْوَالِ وَالأَفعَالِ",31,"ل",1,0],["هُوَ فِي القَومِ وَاحِدٌ بِعُلاَهُ","جَاءَ فِي فَتْرَةٍ مِنَ الآحَادِ",32,"د",1,0],["هُوَ فِي الْحَدِثِ مِنَ الْبِنَاءِ غَرِيبُةٌ","زَانَ الْقَدِيمُ جِوَارَهَا بِغَرَائِبِ",33,"ب",1,0],["هُوَ فَخْرُ الشَّبَابِ وَهْوَ الفَتَى","يَحْفَظُهُ اللهُ فَاقِدُ النُّظَرَاءِ",34,"ا",2,0],["هو في كلا حاليك أنت غرامهُ","وعلى كلا حاليه ذاك المغرمُ",35,"م",1,0],["هُوَ في سُفرَتَينِ مِن أَدَمِ الطا","ئِفِ في سَلَّتَينِ في مِنديلِ",36,"ل",1,0],["هُوَ في الشَّمْسِ والْكَوَاكِب نُورٌ","وَهْوَ في الأَرْض وَالْجِبَالِ رَكَانَه",37,"ن",2,0],["هو في مَيْعَةِ الصِّبا وتَراهُ","مُطْرِقَ الرَّأسِ في خُشُوعِ الكِهَالِ",38,"ل",1,0],["هو في الزهر نفحةٌ من أريجٍ","عرفتها جوانبُ البستان",39,"ن",1,0],["هو في الطيْر نغمةٌ ولهاةٌ","صوتها العذب فاق صوْت الكمان",39,"ن",1,0],["هو في البيدِ واحةٌ من نعيمٍ","طوّقتها سواعِدُ الكثبان",39,"ن",1,0],["هو في البحرِ موْجةٌ تتهادى","فاحتوتْها الرمالُ بالأحضان",39,"ن",1,0],["هو في النيلِ نسمةٌ تُنعِشُ الرو","حَ وتحكي نضارةَ الشطئان",39,"ن",1,0],["هُو في البدرِ حينما يطلعُ البد","رُ وفي الروضِ حينَما يتَثَنَّى",40,"ن",2,0],["هو في الطبِّ من كِبار نُحاته","وهو في النحوِ من كِبارِ أُساته",41,"ت",2,0],["هو في فَمِ الدُّنْيا حَدِيثٌ خالِدٌ","يَحْلُو على الأَيَّامِ حين يُكَرَّر",42,"ر",1,0],["هو في كِتَاب الدَّهْر سَطْرٌ مَجَادَةٍ","خَشَعَتْ لِهَيْبَةِ ما حَواه الأسْطُرُ",42,"ر",1,0],["هو في الطبِّ أَبقْراطُ وفي","حَلْبة الشعرِ إمامُ الشعراء",43,"ا",2,0],["هو في كتاب العمرِ أَوَّلُ صَفْحَةٍ","بُدِئتْ بِبِسْمِ اللّهِ وَالتَّحْمِيدِ",44,"د",1,0],["هُو في مِصْرَ مَنارٌ كُلَّما","أَرْسَلَ الأضواءَ في مِصْرَ هَداها",45,"ا",3,0],["هو فليسوفٌ، قام ينشر فضله","بين البرية فليسوفٌ ثان",46,"ن",1,0],["هو في الفصول ممثلٌ","آنًا، وآونةً خطيب",47,"ب",1,0],["هو في حلبْةِ الجهاد لواءٌ","وهْو في الاقتصاد ربُّ اللواء",48,"ا",2,0],["هُوَ فصلٌ تَختالُ فيهِ غُصونُ ال","رَّوْضِ في حِلْيَة ٍ مِنَ الأَزْهَارِ",49,"ر",1,0],["هو فجلا النّبوغ يصدح فيه","كلّ من أطلق الهوى وجدانه",50,"ن",2,0],["هُوَ في القَلب إِن دَنا أَو سار","مَدداً يا أَنيس كُل غَريب",51,"ب",1,0],["هو في محبتكم نسيج زمانه","فذ وان هو كله نقصان",52,"ن",1,0],["هو في آل علي معرق","ذو اتصال بالحسين والحسن",53,"ن",1,0],["هو في منصب الولاية والاق","طاب جيش يحف بالسلطان",54,"ن",1,0],["هو فذ في معاني حسنه","وانا فيه بطور الوجد فذ",55,"ذ",1,0],["هو في السادات اعيان الحمى","عظماء القوم طرا صاحب اليد",56,"د",1,0],["هو في العصر اذ تعد رجال","الله لاشك اول الاعداد",57,"د",1,0],["هو في الدجى بدرٌ ينير وفي الضحى","شمسٌ لها في كل أفْقٍ مطلعُ",58,"ع",1,0],["هو فارسُ الإسلام يحفظ بالظُّبا","من دينه الأطرافَ والأوساط",59,"ط",1,0],["هو في الحقيقة خارج","عن طعم ذوقك أو مشمك",60,"ك",1,0],["هو فيهم وليس منهم ولكن","ربّ رأي أعدى أمرأ من صديق",61,"ق",1,0],["هوَ فردُ الوجودِ ما خلق اللَ","هُ لهُ في كماله نظراءَ",62,"ا",2,0],["هوَ في غنيةٍ عن الخلقِ طرّاً","وَهمُ الكلُّ عنه دون غناءِ",63,"ا",2,0],["هوَ فردٌ باللَّه والكلّ منه","ليس ثانٍ هنا وليس ثناءُ",64,"ا",2,0],["هُوَ فَوقَ الجِبالِ وَعلٌ وَفي السَه","لِ عِقابٌ وَفي المَعابِرِ حُوتُ",65,"ت",1,0],["هُوَ في البلادِ ولا إخالكَ جاهلاً","بمثابةِ الأرواحِ بالأبدانِ",66,"ن",1,0],["هو في الحبِّ قبلةٌ","وجهت كلَّ وجهة",67,"ه",1,0],["هو فاضل العصر الذي في مصره","انشاء قهوة لفظه تنشيني",68,"ن",2,0],["هو في الحياة وسيلتي وذخيرتي","لهجوم موت للأنام مفاجي",69,"ج",2,0],["هُوَ فاتِحٌ هُوَ خاتَمٌ هُوَ حاشِر","هُوَ عاقِبٌ هُوَ شافِعٌ لِلجاني",70,"ن",2,0],["هُوَ فارِسُ اليَومِ العَبوسِ وَواهِبُ الجُ","ردِ السَوابِقِ وَالخَطيبُ المِصقَعُ",71,"ع",1,0],["هو في الحالتين غَيثٌ ولَيثٌ","يُرتَجى وَعدُهُ ويُخشى وَعيدُه",72,"د",2,0],["هو فينا بريحها","عبق قد تعطرا",73,"ر",2,0],["هو في يمين اللَه سيف مصلت","يفرى به الرحمن هام المجرم",74,"م",1,0],["هو في المراوعة الخصيبة آية","بشرية شهدت به الثقلان",75,"ن",1,0],["هُوَ في الجَلالة قال سيده له","سل ما تحب فأَنتَ خير عبادي",76,"د",2,0],["هُوَ في غَفلَةٍ وَأَيّامه تَف","تُلُ في غَزل عَزلِهِ بِاليَدَينِ",77,"ن",1,0],["هُوَ في الزُهدِ والعِبادَةِ فَردٌ","وهو في الفَضل جامعُ الآدابِ",78,"ب",1,0],["هو في الغرام تغيرت احواله","ان الغرام يغير الاحوالا",79,"ل",2,0],["هُوَ في الفُؤادِ إذا دنا وتناءى","ومناهُ أحسنَ أو إليَّ أساءَ",80,"ا",2,0],["هو فرض عين والأدل","ة بالذي قلنا شهود",81,"د",1,0],["هو في جبين الدهر غرّته","يا دهر تطمسه على عمد",82,"د",1,0],["هُو في الدُّجَى كالشَمعِ يَقْطُرُ دمعُهُ","نَاراً فتحرقُه مياهُ جُفُونِهِ",83,"ن",2,0],["هو في دولة النّدى والمعالي","مُبدئٌ دون غيره ومُعيدُ",84,"د",1,0],["هو في القرطاس خمسٌ","وثلاثٌ في الهجاء",85,"ا",2,0],["هو فني الذي تغلغل في","الفن وأعطى الحياة سرا عظيما",86,"م",2,0],["هو في ناديه طوْدٌ راسِخٌ","فاذا خاضَ وغىً كانَ حُساما",87,"م",2,1],["هو في الحِلْمِ شامخٌ ذو هِضاب","وبهِ في نَزالهِ خِضْرِمِيَّهْ",88,"ي",2,0],["هو فحلُ الفحولِ لا فرقَ بين ال","ورد مما يلسُّ والقُلامِ",89,"م",1,0],["هو في الأيام ممدَّحٌ وأبوه","مات مؤَّبنا وأراك أنت مؤنَّبا",90,"ب",2,0],["هو في الأنام كشهرهِ في العام","بل كزمانهِ في سالف الأزمان",91,"ن",1,0],["هو في السلم والوغى واهب","الآلاف جوداً وهازم الآلاف",92,"ف",1,0],["هو في الجمال بثينة النادي فلا","عجبٌ لمن أضحى جميل جماله",93,"ل",2,0],["هو في الوغى عمرو وفي","بذل النّدى كعبُ بن مامه",94,"م",2,0],["هوَ فَجرُ الإسلامِ.. أعظَمُهُ","أنَّهُ ذلكَ الفَتى الأنِفُ",95,"ف",1,0],["هوَ فَجرُ الإسلامِ.. لؤلؤهُ","آلُهُ، والعَوالِمُ الصَّدَفُ",95,"ف",1,0],["هو في كونه يعيد ويبدي","وهو في كلِّ حاجةٍ مسؤلُ",96,"ل",1,0],["هو في مكافحة الشؤن منكدٌ","ما رام صفو العز إلا هانا",97,"ن",2,0],["هو في حضرَةِ البِدايَةِ بَدْءٌ","قام للمُرْسَلينَ طُرًّا خِتاما",98,"م",2,0],["هو في المجدِ وحدَهُ مُتَعالٍ","وتَراني بالذُّلِّ والوجدِ وَحْدي",99,"د",2,0],["هو في الأَرضِ تلَظَّى","ومُقامي في السَّماءِ",100,"ا",2,0],["هو في الجفونِ السّودِ من فَتياتهِ","أو في الجفونِ البيضِ منْ فِتيانهِ",101,"ن",2,0],["هو فوقَ علمِكُمُ به فتأمّلوا","فيه فللأنظارِ فيه مَطرَحُ",102,"ح",1,0],["هو في وَجنةِ الزّمانِ إذا ما","نَسبوهُ إليه كالتّوريدِ",103,"د",1,0],["هو في النّديِّ على السّريرِ مسرّةٌ","وإذا اِستوى بالسّرْجِ خطبٌ مُونِقُ",104,"ق",1,0],["هو في الناس مثل ذا اليوم فيهم","ند في فضله فأعوز نده",105,"د",2,0],["هوَ فَخرُ التَّاريخِ كم به باهى","مَا مَضى مِن عُصُورِهِ الغَابرينَا",106,"ن",2,0],["هُوَ في الشَرِّ قبائِلٌ وَمُرَوٍّ","لَيتَهُ ماتَ قَبلَها فَاِستَراحا",107,"ح",2,0],["هو في الشئون مشبه ومنزه","دون الشئون وذاته مستغربه",108,"ب",2,0],["هو في المحاسن كلها فرد أحد","أنا من أعز أولى النهى وأجلها",109,"ه",2,0],["هو في القلب مقيم بل أنا","هو لا بل هو دوني وجدا",110,"د",2,0],["هو في بيت هوى منغلق","وأنا في رفرف منفسح",111,"ح",1,0],["هُوَ في الصَّحْوِ لِي أَخٌ","وَعَدُوٌ إِذَا انْتَشَى",112,"ش",2,0],["هو في الدَّسْتِ جَالِسٌ وعَطايا","هُ إِلى الخَلْقِ والأَقاليم تَسْرِي",113,"ر",2,0]]}