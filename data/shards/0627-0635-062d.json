?id=5189",""],[5756,"قصة حياة","https://www.poetsgate.com/ViewPoem.aspx?id=5435",""],[5829,"من شرفتي","https://www.poetsgate.com/ViewPoem.aspx?id=202676",""],[5881,"غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=183810",""],[5943,"نشوة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=41591",""],[5943,"يا أنَّةَ الصَّدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=61778",""],[5956,"ضياع طفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184565",""],[6089,"كوفيد","https://www.poetsgate.com/ViewPoem.aspx?id=213750",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[6115,"العصا خير من سيفٍ صقيلٍ في يدين الجباني","https://www.poetsgate.com/ViewPoem.aspx?id=181612",""],[6213,"ميناء المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76248&r=&rc=5",""],[463,"سلْ بالغويرِ السائقَ المغلِّسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60106&r=&rc=162",""],[4222,"أصح عيون الغانيات مريضها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52821&r=&rc=113",""]],"verses":[["أَصحَرَ اللَيثُ العِفِرنى فَاِنثَنى","يَطلُبُ اليَربوعُ في الأَرضِ وَجارا",0,"ر",2,0],["أَصحَبُ مَن لا أَلومُ صُحبَتَهُ","غَيرَ نَزورِ النَدى وَلا جَحِدِ",1,"د",1,0],["أَصَحيحٌ ما قيلَ عَنكَ وَحَقٌّ","ما سَمِعنا مِنَ الرُواةِ الشُهودِ",2,"د",1,0],["أَصَحيحٌ بَكَيتَ لَمّا أَتى الوَف","دُ وَنابَتكَ رِعشَةُ الرِعديدِ",2,"د",1,0],["أَصَحا فُؤادُكَ أَيَّ حينِ أَوانِ","أَم لَم يَرُعكَ تَفَرُّقُ الجيرانِ",3,"ن",1,0],["أصحبُ المرء فهو منيَ مَمْطُو","رٌ ولكنْ واديه لي مَجْدوبُ",4,"ب",1,0],["أصحابُ مالكٍ الذي لم يَعْدُهُ","من كُلِّ علم محضُه وصُراحُه",5,"ح",2,0],["أصحت وصابتْ ففيها كل منفعةٍ","وربما أصعقت يوماً لأشرار",6,"ر",1,0],["أَصْحَبْتُه في ليله ونهارهِ","خوفاً يؤرِّقُ مُقلةَ الوسنان",7,"ن",1,0],["أَصِحُّ فَلا أُمنى بِشَكوٍ مِنَ الهَوى","وَأَصحو فَلا أَصبو وَلا أَتَوَلَّعُ",8,"ع",1,0],["أَصحَبتُهُ أَمَلي وَمِثلُ خِلالِهِ","كَرُمَت فَأَعطَت راغِباً ما أَمَّلا",9,"ل",2,0],["أَصحابُ زَبدٍ وَأَيّامٍ لَهُم سَلَفَت","مَن حارَبوا أَعذَبوا عَنهُ بِتَنكيلِ",10,"ل",1,0],["أصحابُها كحمائمٍ","ناحَتْ على أقفاصِها",11,"ه",2,0],["أَصحَوتَ أَم أَنتَ اِمرِئٌ تَبلى وَما","يَصحو فُؤادٌ مِنكَ لَيسَ بِبالِ",12,"ل",1,0],["أَصحَرتَ إِذ دَبّوا الخَمَر","شُكراً وَحَرٌّ مِن شُكُر",13,"ر",1,0],["أَصحابُ لَيكَةَ أُهلِكوا بِظَهيرَةٍ","حَميَت وَعادٌ بِالرِياحِ الصَرصَرِ",14,"ر",1,1],["أَصَحَوتَ اليَومَ أَم شاقَتكَ هِر","وَمِنَ الحُبِّ جُنونٌ مُستَعِر",15,"ر",1,1],["أَصحَبُ الناس ومنهم","حذري مثل وثوقي",16,"ي",1,1],["أَصَحِيحٌ أَنَّ رُومَا حَفِظَتْ","مِنْ جَلالِ العِزَّةِ القَعْسَاءِ غبْرَا",17,"ر",2,0],["أَصَحِبْتَهُ وَالنجْمُ نُصْبَ عُيُونِهِ","وَالشَّأْوُ أَوْجَ القُبَّةِ الزَّرْقَاءِ",18,"ا",2,0],["أصحيحٌ طوى المماتُ عليّاً","فطوى شاعراً فريد البيان",19,"ن",1,0],["أصحيحٌ أن الخطوبَ أصابت","كِ وأنّ الأمراضَ هَدَّتْكِ هدّا",20,"د",2,0],["أصحيحٌ عاد السلامُ إلى الكو","ن وأضحى ظِلاً به ممدودا",21,"د",2,0],["أصحوت أم أنت امرؤٌ تبلى وما","يصحو فؤادٌ منك ليس ببال",22,"ل",1,0],["اصحو واسكر في جفاه وقربه","فاعذر لسكران برونق صاح",23,"ح",1,0],["أصحابه الغر بالكرا","م الزهر أصحاب البنود",24,"د",1,0],["أصحب من لا أود صحبته","ومن أذوق البعاد في قربه",25,"ب",2,0],["أصحّ ما إن رأيته عيني","في مركز العقل والصواب",26,"ب",1,1],["أَصْحَرْتَ إِذْ مَدَّ بِالْمِدّانِ سَيْلُهُمُ","وَاللَّيْثُ لا يُتَّقى مِنْ غَيْرِ إِصْحارِ",27,"ر",1,0],["أَصحو بِلا ماءٍ وَلا شَجَرٍ وَلا","بِرٍّ وَلا خُبزٍ لَدَيَّ أَفُتّهُ",28,"ت",2,0],["أصَحُّ عيونِ البابلّيةِ ما اعْتَلاّ","وأمضَى سُيوفِ اللّحْظِ في القَلْبِ ما كلا",29,"ل",2,1],["أصحابنا في مصر قد ضيعوا","أصحابهم واستصحبوا الذكرى",30,"ر",2,1],["أصحرَ في إثر العدوّ عنهما","أغلبُ ما واثب إلا فَرَسا",31,"س",2,0],["أَصَحَّ اِعتِزاماً مِن خَؤونٍ عَلى قِلىً","وَأَنفذ حُكماً مِن غَرامٍ عَلى صَبِّ",32,"ب",1,0],["أصحابُ موسى بعدَه في عِجْلِهم","فُتِنوا وأنتَ بأملَحِ الغِزلانِ",33,"ن",1,0],["أصَحُّ كَلامٍ مَدحُهُ فَهْوَ مذهبٌ","لنا فيهِ قولٌ واحدٌ ليسَ أقوالُ",34,"ل",1,0],["أصَحُّ من خَطَّ قِرطاساً وأبلَغُ مَن","أملَى وأفصَحُ مَنْ بالضَّادِ قد نَطقَا",35,"ق",2,0],["أصَحُّ الناسِ في الغَمَراتِ رأْياً","وأهداهُمْ إلى سُبُلِ الرَّشادِ",36,"د",1,0],["أَصَحُّ القومِ في الغَمَراتِ رِأياً","وأَجلى رُؤْيةً وأَجَلُّ حَزْما",37,"م",2,0],["أَصَحُّ الكاتبينَ يداً وفكراً","وأَضبَطُ حاسِباً من كاتبَيهِ",38,"ي",2,0],["اصحَّ الحلمُ عهدَكَ لا حؤُولٌ","لهُ واصحَّ وعدَكَ لا مِطالُ",39,"ل",1,0],["اصحبِ الأَخيار وارغب فيهم","ربَّ من صحبته مثلُ الجرب",40,"ب",1,0],["أَصَحَوتَ عَن أُمِّ البَني","نَ وَذِكرِها وَعَنائِها",41,"ا",3,1],["أصحابه جاهدوا عنه وما نكلوا","حتّى قضَوا بين منحورٍ ومنجدلِ",42,"ل",1,0],["أصِحُّ فلا أٌُزارُ وليسَ هذا","بإنصافٍ وأمرَضُ لا أعاد",43,"د",1,0],["أصحب البذل والندى في يساري","ورفيقي في عسرتي حسن رفقي",44,"ق",2,0],["اصحبْ زمانَك صِدْقاً","وغَابِه إنْ تَغابا",45,"ب",2,1],["اصحب خليلك إن صافى وإن عافى","وكن حمولا وقل شكراَ لمن عافى",46,"ف",2,0],["اصحب طويل الباع واغنم بره","واهجر قصير الباع واحذر شره",47,"ه",1,1],["أصحاب خير الورى أخيار ملته","خير القرون نجوم الدهر والزمن",48,"ن",1,0],["أصحُّ وأقوى ما رويناهُ في الندى","عن الخبر المأثورِ منذُ قديمِ",49,"م",1,1],["اصحابكم والآل اصحاب السنا","وعلى محبين الجناب ومقتدى",50,"د",2,0],["أصحب أستاذي إِلى داره","في ذلك اليوم الرهيب الأخير",51,"ر",1,0],["أَصَحُّ وَأَقْوى ما سَمِعْناهُ في النَّدى","مِنَ الْخَبَرِ المَأْثُورِ مُنْذُ قَديمِ",52,"م",1,1],["اصْحَبْ ذَوي الْقَدْرِ وَاسْتَعِدّ بِهِم","وَعَدِّ عَنْ كُلِّ ساقِطٍ سَفِلَهْ",53,"ل",2,1],["أَصَحَّ اللَهُ جِسمَك ذو العَلاءِ","وَأَعقَبكَ السَلامَةَ في الدَواءِ",54,"ا",2,1],["أصحروا للمرج أجلي للعمى","فلقد أصحر أصحاب السرب",55,"ب",1,1],["أصحَب الصاحبَ ما صاحبني","وأكفُّ اللومَ عنه والعذل",56,"ل",1,0],["أصحوت من راح الشباب المسكر","أم لست عن نشواته بالمقصر",57,"ر",1,1],["أصحابُهُ الخَائِضُو بَاسَ الوَغى تَرَكُوا","أَعدَاءَهُم طرَحا لِلطَّيرِ قَد حَدَقا",58,"ق",2,0],["أصحابهُ كشموسٍ في مراكزِها","لنورِها في قلوبِ الحلق سطعان",59,"ن",1,0],["أَصحْنُهُ بالمِسْكِ والزَّبادي","من كلّ لونٍ لذّة الفُؤادِ",60,"د",1,0],["أصحرت لما احتدمت نار الوغى","إصحار ليث الغاب من شتانه",61,"ه",1,0],["أَصْحَرَ كالضيغم من غايته","وهو مهيب سطوة الإطراق",62,"ق",1,0],["أصحَابُهُا هُم حَافِظُوا الإِسلاَمِ لا","أصحَابُ جَهمٍ حَافِظُو الكُفرَانِ",63,"ن",1,0],["أصحاب بدر والألى قد بايعوا","أزكى البرية بيعة الرضوان",63,"ن",1,0],["أصحابها أهل التخرص والتنا","قض والتهاتر قائلو البهتان",63,"ن",1,0],["أصحابُكَ الخَلفاءً أعيانُ الوَرَى","وولاتُكَ الأعلامُ أيِّ ولاةِ",64,"ه",1,0],["أصحابه مُؤانِساتِ قُربِهِ","فوقَفُوا بينَ يديه فَبِهِ",65,"ه",1,0],["اصحو لمعتل النسيم","كأن طبعك لي تنسم",66,"م",1,0],["أصحاب لا يرعوا الجميل ولا لهم","حسب يردّهم لصدق وفاء",67,"ا",2,0],["أصَحُّ عندي مِن قياسِ العَرضِ","يُهديكَ في النَّتخِ بهذي الأرضِ",68,"ض",1,0],["أصح هوى من ليس يصحو من الهوى","ولا صح من داء دفين يخامره",69,"ر",2,0],["أصحابه في الحرب تحمي به","كأنه الليث حمى شبله",70,"ل",2,0],["اصحَّ من بيض النعام عرية","قد ثنِّيت اردافها نمارقا",71,"ق",2,0],["أصحيفة الوطن العزيز الباقي","أهلا بمطلع نورك البراق",72,"ق",1,1],["أصحو ولفظي نقلٌ","لمن يعب المداما",73,"م",2,0],["أصحب النجم وأسمو نحوه","إن نأتي صاحب بين الرجال",74,"ل",1,0],["أصحبتك الفضل اذ لا انت تعرفه","حقا ولا لك في استصحابه أرب",75,"ب",1,1],["أصحَبتُها كلتا يَدَيَّ وما رأتْ","عَينايَ منها مِعْصماً ونُهودا",76,"د",2,0],["أصحب الحين حياتي","يا شقيق العين شوقا",77,"ق",2,0],["أَصحو وَمِن خمر لما","هُ العذب نَشوان طَرب",78,"ب",1,0],["أَصحرت فيهِ فاِنثَنَت فرسانه","وَثبتّ حيث الراسياتُ تَميدُ",79,"د",1,0],["أصحراء أنت الكون بل أنت أكبر","ومرآك في عينيَّ أبهى وأبهر",80,"ر",1,1],["أصحراء ضميني إليك فإنني","وحقك من سكنى المدائن أضجر",80,"ر",1,0],["أصحو فارشف ثغره","فينوب عن رشف العقار",81,"ر",1,0],["أَصحُوا فمَذهَبكم يا قوم قد ذهبت","أَيامُهُ الغُرُّ وانحلت عقائِدُهُ",82,"د",2,0],["أَصحابنا لا يعرفون مودّةً","إِلا لدى الحاجات وَالآفاتِ",83,"ت",1,1],["أَصحاب أَيام الصبا","مثلَ الظِباءِ الكُنَّس",84,"س",1,0],["أصحاب بأس في العدا لكنهم","بالدين فيما بينهم رحماء",85,"ا",2,0],["أصحاب صدق وأنصار غطارفة","قد أيدوا الحق والهيجاء هوجاء",86,"ا",2,0],["اصحابه الغر كم شدوا وكم وثبوا","على العدو وسيف النصر مسلول",87,"ل",1,0],["أصحابُ باس على الأعداء إ ذ جعلوا","لحمَ العداةِ غذاء الذئبِ والرخمِ",88,"م",1,0],["إصحب خياراً ورِدْ بيضاء بهكنةً","بكراً على قلب ذي العفاف صوّالهْ",89,"ل",2,0],["أَصَ