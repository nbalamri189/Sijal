{"poems":[[53,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[55,"يا أبا الفضل هيجتك الرسوم","https://www.aldiwan.net/poem26139.html","الخفيف"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[77,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[9,"ألم تروا للعجب العجيب","https://www.aldiwan.net/poem21914.html","الرجز"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[71,"إن وعظ الجوزي في المسجد الجامع","https://www.aldiwan.net/poem3747.html","الخفيف"],[93,"ألقى الدجى الستر فقم طائفا","https://www.aldiwan.net/poem11062.html","السريع"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[88,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"أقناعة من بعد طول جفاء","https://www.aldiwan.net/poem25382.html","الكامل"],[72,"ليس يخشى من نجم سعد سقوطا","https://www.aldiwan.net/poem20578.html","السريع"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"إن وهب بن سليما","https://www.aldiwan.net/poem61889.html","مجزوء الرمل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[51,"خساسة البيهقي والبينِ","https://www.aldiwan.net/poem66485.html","المنسرح"],[26,"ألا هل أتى أم الحويرث مرسل","https://www.aldiwan.net/poem24081.html","الطويل"],[43,"أنوك من عبد ومن عرسه","https://www.aldiwan.net/poem9615.html","السريع"],[45,"قصة التل فاسمعها عجابه","https://www.aldiwan.net/poem10889.html","الخفيف"],[45,"واسوأتا من رأيك العازب","https://www.aldiwan.net/poem10893.html","السريع"],[61,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[61,"تزداد منعا إذا ما رمت إسعافا","https://www.aldiwan.net/poem51555.html","البسيط"],[66,"أنصفته جهدي ولي ما أنصفا","https://www.aldiwan.net/poem39532.html","الكامل"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[44,"يا عليلا حشا الجوانح نارا","https://www.aldiwan.net/poem30255.html","السريع"],[44,"أنوح بن عمرو إن ما حم واقع","https://www.aldiwan.net/poem30311.html","الطويل"],[87,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[69,"إن وادي الباب قد أذكرني","https://www.aldiwan.net/poem28833.html","الرمل"],[31,"جن قلبي فقلت يا قلب مهلا","https://www.aldiwan.net/poem41849.html","الخفيف"],[31,"طال ليلي واعتادني أطرابي","https://www.aldiwan.net/poem42649.html","الخفيف"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"بني مصر ما للطامعين وما لكم","https://www.aldiwan.net/poem43152.html","الطويل"],[105,"سلام أيها الملك الهمام","https://www.aldiwan.net/poem43407.html","الوافر"],[81,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[21,"دار قومي في منزل غير ضنك","https://www.aldiwan.net/poem36190.html","الخفيف"],[48,"أنعت ديكا من ديوك الهند أحسن","https://www.aldiwan.net/poem63253.html","الرجز"],[50,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[46,"أجزاء دهر ينقضين ولم يكن","https://www.aldiwan.net/poem22576.html","الكامل"],[46,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[46,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[46,"يكفيك أدما سليط ماأريق له","https://www.aldiwan.net/poem23302.html","البسيط"],[46,"إذا لؤم الفتى لم يخشى مما","https://www.aldiwan.net/poem23313.html","الوافر"],[46,"إجتنب الناس وعش واحدا","https://www.aldiwan.net/poem23414.html","السريع"],[19,"خُذلت على ليلة ساهره","https://www.aldiwan.net/poem338.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85441","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30487","الطويل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55063","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55173","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55101","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55182","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199501","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[100,"لِعينيكَ يا مَوطني","https://www.poetsgate.com/ViewPoem.aspx?id=183583",""],[45,"يا سَوءتَا مِنْ رَأيكَ العازِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31568",""],[51,"يا عصمة ً لستُ منها باغياً بدلا","https://www.poetsgate.com/ViewPoem.aspx?id=30264",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19021&r=&rc=284",""],[87,"مَحَا الْبَيْنُ مَا أَبْقَتْ عُيُونُ الْمَهَا مِنِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23864&r=&rc=126",""]],"verses":[["أَنوماً أَلَذُّ عَلى ذِلَّةٍ","وَيَعرى مِنَ الذُلِّ أَضدادِيَه",0,"ي",2,0],["إِنَّ وَجدي بِفَقدِ فَوزٍ وَإِشفا","قي عَلَيها وَالدَهرُ دَهرٌ غَشومُ",1,"م",1,0],["أنَوْماً وإغْفاءً علَى سِنَةِ الكَرى","وما نامَ طرْفٌ في حِماها ولا أغْفى",2,"ف",2,0],["أَنْوَارُهُ فِي سَمَاءِ الْعَدْلِ نَيّرَةٌ","تَبْدُو وَآثارُهُ أَسْرَى مِنَ الْمَثَلِ",3,"ل",1,0],["أَنُورَ سَنَاءٍ لاَحَ فِي مَشْرقِ الْغَرْبِ","وَفَرْعَ اعْتِلاَءٍ لاَحَ فِي دَوْحَةِ الْعُرْبِ",4,"ب",1,1],["أُنوفُهُم مِالفَخرِ في أُسلوبِ","وَشَعَرُ الأَستاهِ بِالجَبوبِ",5,"ب",1,0],["إِن وَضَعنا عَنهُ بِبَيداءَ قَفرٍ","أَو قَرَنّا ذِراعَهُ بِوَظيفِ",6,"ف",1,0],["إِنَّ وَعظَ الجَوزِيِّ في المَسجِدِ الجا","مِعِ وَعظٌ مُزَهَّدٌ في الدينِ",7,"ن",1,1],["أنوارها شبه جراح جرت","منها دماء المجد فوق الثرى",8,"ا",1,0],["أَنَّ وَقَدْ عَلِمُوا مِنْ جَارِهِمْ قُدُماً","وَمِنْ غُزَاةِ الرُّومِ مَا عَلِمُوا",9,"م",3,0],["إِنْ وَرَدْنَا الحَوْمَاتِ تَشْتَعِلُ الأَفْ","كَارِ فِي نَارِهَا اشْتِعَالَ الْهَشِيمِ",10,"م",1,0],["إن وجدي هو الجحيم ولولا","أدمعي أحرقتني الأتراح",11,"ح",1,0],["إن وجه الحق بادٍ","كسراج في مناره",12,"ر",2,0],["أَنُوَّامٌ تقول بني لُؤَيَّ","قَعِيدَ أَبِيكِ أَم مُتَنَاوِمُونَا",13,"ن",2,0],["أَنواعُ زَهرٍ وَاِلتِفافُ حَدائِقٍ","وَصَفاءُ ماءٍ وَاِعتِدالُ هَواءِ",14,"ا",2,0],["إن وجدنا وسميّ جدواهُ في الدن","يا وجدنا في الدين منه وليَّا",15,"ي",2,0],["إنَّ وزني في الرأي وزنٌ ثقيل","فاسألِ الرأيَ عنه لا الأهواءَ",16,"ا",2,0],["أنوءُ به فيما عرا وأعدُّهُ","لساناً وسيفاً في الخطاب وفي الخَطْبِ",17,"ب",1,0],["إنَّ ودَّانَ لا تَوَدُّ خَصِيَّاً","فاصْحُ عنها فَقَلْبُهَا عنك صاحي",18,"ح",2,0],["إنَّ وهب بن سليما","ن بنِ وهبِ بن سعيدِ",19,"د",1,1],["أنوفكم أعني بما قلت آنفاً","بني مخلدٍ حيَّ الأنوفَ جدوعها",20,"ع",3,0],["أنوفُ قومٍ تَمنَّوْا","لك العثار دَوامي",21,"م",2,0],["إن وعدا أخلفاك ما وعدا","أو حدّثا حدثاك بالمَيْن",22,"ن",1,0],["أَنوءُ بِهِ فيها فَيَأمَنُ جانِبي","وَلَو كَثُرَت فيها لَدَيَّ البَوارِقُ",23,"ق",1,0],["أَنوَكُ مِن عَبدٍ وَمِن عِرسِهِ","مَن حَكَّمَ العَبدَ عَلى نَفسِهِ",24,"س",2,1],["إِن وَجَدتُم فيهِ شِباكَ أَبيكُم","كُنتُم دونَ غَيرِكُم أَربابَه",25,"ب",2,0],["إِن وَقَفَت سوقُكَ لَو أَكسَدَت","بِضاعَةٌ مِن شِعرِكَ الخائِبِ",26,"ب",1,0],["أنَوَالُهُ يومَ النَّدى أَمْ بِشْرُهُ","وسَطاهُ يومَ الرَّوْعِ أَمْ إقدامُه",27,"م",2,0],["إن وَفَّرَ السَّيفَ يومَ الرَّوْعِ تالِدُه","أعادَ تَوفيرَه بالبَذْلِ إتلافا",28,"ف",2,0],["أَنوي السُلُوَّ لَهُ فَيَثنِيَ عَزمَتي","وَجهٌ لَهُ لَو قابَلَ البَدرَ اِختَفى",29,"ف",2,0],["إِن وَرَدتَ الهَيجاءَ يا سائِقَ العي","سِ وَشارَفتَ دَوحَها وَالنَخيلا",30,"ل",2,0],["إِنَّ وَجهَ الحُمّى لَوَجهٌ صَفيقٌ","حينَ تَسطو بِهِ نَهاراً جَهارا",31,"ر",2,0],["أَنوحَ بنَ عَمروٍ إِنَّ ما حُمَّ واقِعٌ","وَلِلأَجنُبِ المُستَعلَياتِ مَصارِعُ",32,"ع",1,1],["أَنُوحُ لِبُعْدِي عَنْهُ حُزْناً وَلَوْعَةً","كَمَا نَاحَ مِنْ شَوْقٍ جَمِيلٌ عَلَى بُثْنِ",33,"ن",1,0],["إنَّ وادي البابِ قدْ أذْكرني","جنَّةَ المأوى فللهِ العجبْ",34,"ب",1,1],["إِنَّ وَجهاً أَبصَرتُهُ لَيلَةَ البَد","رِ عَلَيهِ اِبتَنى الجَمالُ وَحَلّا",35,"ل",2,0],["إِنَّ وَجدي بِقُربِكُم أُمَّ عَمروٍ","مِثلُ وَجدِ الصَدي بِبَردِ الشَرابِ",36,"ب",1,0],["إن وصفتَ المُلكَ يطويه البلَى","فَصِفِ الأحلامَ تستهوي النِّياما",37,"م",2,0],["أَنَوماً عَلى الزلزالِ أَم لا يَهولُكُم","تَخَمُّطُ هَذا الصائِلِ المُتَجَهِّمِ",38,"م",1,0],["أَنَوماً يا مُحَمَّدُ عَن بِلادٍ","أَباحَ حَريمَها الأَهلُ النِيامُ",39,"م",1,0],["إِن وَعَدَ الوَصلَ سينُ طُرَّتِهِ","قَرَأتُ في عارِضَيهِ لَفظَةَ لا",40,"ل",2,0],["إِنَّ وَجّاً وَما يَلي بَطنَ وَجٍّ","دارَ قَومي بِرَبوةٍ وَرُتوقِ",41,"ق",1,0],["إِن وَقَفَ الديكُ ثَنى بِالشَدِّ","وَالوَثبُ مِنهُ مِثلَ وَثبَ الفَهدِ",42,"د",1,0],["إِنَّ وَعدَ الكَريمِ دَينٌ عَلَيهِ","فَاِقضِ وَاِظفَر بِهِ عَلى الغُرَماءِ",43,"ا",2,0],["أَنوارُ مَهلاً كَم ثَوى مِن رَبرَبٍ","نورٍ وَلاحَت في الدُجى أَنوارُ",44,"ر",1,0],["إِن وَطِئَت هالِكَ الوَغى فَرَسٌ","فَجِسمُهُ بَعدَ رَوحِهِ مَدَرُ",45,"ر",1,0],["أَنوارُ تُحسَبُ مِن سَنا الأَنوارِ","وَمِنَ البَوارِ مَهاً عَرَضنَ بَواري",46,"ي",1,1],["إِن وَدَّعوهُ فَما يَدري بِما صَنَعوا","أَو قَطَّعوهُ فَما يَنتابُهُ أَلَمُ",47,"م",1,0],["أَنوءُ مَعَ الخُطوبِ إِلى أُمورٍ","لِشَخصِيَ دونَ مَوقِعِها اِصطِلامُ",48,"م",1,0],["إِنَّ وَفاةَ النِكسِ في جُبنِهِ","مِثلُ وَفاةِ الفارِسِ المُعلَمِ",49,"م",1,0],["أَنوءُ بِرِجلٍ بِها ذِهنُها","وَأَعيَت بِها أُختُها الغابِرَه",50,"ر",2,0],["أَنوار منذ دفنت جسمك ناعما","لي بالقبور صبابة وولوع",51,"ع",1,0],["أنوار أن الصب مات سروره","يوم الفراق فقلبه في مأتم",52,"م",1,0],["أَنُوحُ على نَفْسِي وأَندبُ نُبْلَهَا","إِذا أَنا في الضَّرَّاءِ أَزمعْتُ قتلَهَا",53,"ل",3,1],["إنّ وادي الظَّلامِ يَطْفَحُ بالهَوْ","لِ فما أبْعَدَ ابتسامَ القُلوبِ",54,"ب",1,0],["أَنْوَارِ مَيْمُونِ النَّقِيبَةِ مَاجِدٍ","ثَبْتِ الحَصَاةِ مِنَ الطِّرَازِ الفَائِقِ",55,"ق",1,0],["إِنْ وَأَلَ القَوْمُ فَمِنْ بَأْسِهِ","يَأْوَوْنَ فِي الضَّيْمِ إِلَى مُؤْئِلِ",56,"ل",1,0],["أَنْوَارُ وَحْيِكَ تَخْلبُ الأ","لْبابَ فِي قَسَمَاتِ دُرِّكْ",57,"ك",1,0],["أَنْوَارُهَا تُهدِي وَعَنْهَا","الطَّرْفُ يَرْجَعُ فِي كِلاَلِ",58,"ل",1,0],["أَنْوَارُ وَجْهِكَ طَالَعْتنَا اليَوْمَ مِنْ","بُرْجٍ حَلَلْتَ بِهِ لِغَيْرِ زِيَالِ",59,"ل",1,0],["أنوء إذا وقفت بحمل ثوبي","وأعثر حين أمشي بالظلالِ",60,"ل",1,0],["إِن وَعى مِنّي الأُصولَ ضُحىً","فَرَّعَت آراؤُهُ أُصُلا",61,"ل",2,0],["أنوح للمستضعفين وإنّني","أشقى من الأيتام والضعفاء",62,"ا",2,0],["إن وحَّدتْ بين أقوام ثقافتهُم","فلن نُفرِّقَ ذاتَ البَيْن بُلدان",63,"ن",1,0],["أنوما وإغفاء على سنة الكرى","وما نام طرف في حماها ولا أغفا",64,"ف",2,0],["أَنُوءُ بوَجهٍ كأَخبارِ (كانَ)","بجَنبَينِ مِن حَرفِ جَرٍّ وظَرفْ",65,"ف",1,0],["إنْ وَقفَتْ سُوقُكَ، أوْ أكسدتْ","بِضَاعَةٌ مِنْ شِعرِكَ الخائِبِ",66,"ب",1,0],["إن وهزّيك بالأشعار أنسُجُها","للغافل المتعدي جدُّ مَنْ غفلا",67,"ل",2,0],["إنَّ وَجْهاً أَبْصَرْتُهُ لَيْلَة َ البَدْ","رِ عَلَيْهِ کبْتَنَى الجَمَالُ وَحَلاّ",68,"ل",2,0],["أَنُوحُ لِبُعْدِي عَنْهُ حُزْناً وَلَوْعَة ً","كمانا من شوقٍ \" جميلٌ \" عاى َ \" بثنِ \"",69,"ن",1,0]]}