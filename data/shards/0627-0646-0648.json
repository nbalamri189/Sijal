64,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[468,"أنفع ما استعملته الياس","https://www.aldiwan.net/poem59934.html","السريع"],[468,"في الحشر علق يده منجل","https://www.aldiwan.net/poem60249.html","السريع"],[505,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[514,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[514,"أنوارك الخاطفة لعقولنا تسترق","https://www.aldiwan.net/poem20917.html","المواليا"],[515,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[538,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[551,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[553,"إن ورد الخدود والحدق النجل","https://www.aldiwan.net/poem68241.html","الخفيف"],[558,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[558,"إن وجها كنت أنظره","https://www.aldiwan.net/poem34469.html","المديد"],[562,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[567,"قامر باللهو في هوى قمر","https://www.aldiwan.net/poem69678.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَنوماً أَلَذُّ عَلى ذِلَّةٍ","وَيَعرى مِنَ الذُلِّ أَضدادِيَه",0,"ي",2,0],["إِنَّ وَجدي بِفَقدِ فَوزٍ وَإِشفا","قي عَلَيها وَالدَهرُ دَهرٌ غَشومُ",1,"م",1,0],["أنَوْماً وإغْفاءً علَى سِنَةِ الكَرى","وما نامَ طرْفٌ في حِماها ولا أغْفى",2,"ف",2,0],["أَنْوَارُهُ فِي سَمَاءِ الْعَدْلِ نَيّرَةٌ","تَبْدُو وَآثارُهُ أَسْرَى مِنَ الْمَثَلِ",3,"ل",1,0],["أَنُورَ سَنَاءٍ لاَحَ فِي مَشْرقِ الْغَرْبِ","وَفَرْعَ اعْتِلاَءٍ لاَحَ فِي دَوْحَةِ الْعُرْبِ",4,"ب",1,1],["أُنوفُهُم مِالفَخرِ في أُسلوبِ","وَشَعَرُ الأَستاهِ بِالجَبوبِ",5,"ب",1,0],["إِن وَضَعنا عَنهُ بِبَيداءَ قَفرٍ","أَو قَرَنّا ذِراعَهُ بِوَظيفِ",6,"ف",1,0],["إِنَّ وَعظَ الجَوزِيِّ في المَسجِدِ الجا","مِعِ وَعظٌ مُزَهَّدٌ في الدينِ",7,"ن",1,1],["أنوارها شبه جراح جرت","منها دماء المجد فوق الثرى",8,"ا",1,0],["أَنَّ وَقَدْ عَلِمُوا مِنْ جَارِهِمْ قُدُماً","وَمِنْ غُزَاةِ الرُّومِ مَا عَلِمُوا",9,"م",3,0],["إِنْ وَرَدْنَا الحَوْمَاتِ تَشْتَعِلُ الأَفْ","كَارِ فِي نَارِهَا اشْتِعَالَ الْهَشِيمِ",10,"م",1,0],["إن وجدي هو الجحيم ولولا","أدمعي أحرقتني الأتراح",11,"ح",1,0],["إن وجه الحق بادٍ","كسراج في مناره",12,"ر",2,0],["أَنُوَّامٌ تقول بني لُؤَيَّ","قَعِيدَ أَبِيكِ أَم مُتَنَاوِمُونَا",13,"ن",2,0],["أَنواعُ زَهرٍ وَاِلتِفافُ حَدائِقٍ","وَصَفاءُ ماءٍ وَاِعتِدالُ هَواءِ",14,"ا",2,0],["إن وجدنا وسميّ جدواهُ في الدن","يا وجدنا في الدين منه وليَّا",15,"ي",2,0],["إنَّ وزني في الرأي وزنٌ ثقيل","فاسألِ الرأيَ عنه لا الأهواءَ",16,"ا",2,0],["أنوءُ به فيما عرا وأعدُّهُ","لساناً وسيفاً في الخطاب وفي الخَطْبِ",17,"ب",1,0],["إنَّ ودَّانَ لا تَوَدُّ خَصِيَّاً","فاصْحُ عنها فَقَلْبُهَا عنك صاحي",18,"ح",2,0],["إنَّ وهب بن سليما","ن بنِ وهبِ بن سعيدِ",19,"د",1,1],["أنوفكم أعني بما قلت آنفاً","بني مخلدٍ حيَّ الأنوفَ جدوعها",20,"ع",3,0],["أنوفُ قومٍ تَمنَّوْا","لك العثار دَوامي",21,"م",2,0],["إن وعدا أخلفاك ما وعدا","أو حدّثا حدثاك بالمَيْن",22,"ن",1,0],["أَنوءُ بِهِ فيها فَيَأمَنُ جانِبي","وَلَو كَثُرَت فيها لَدَيَّ البَوارِقُ",23,"ق",1,0],["أَنوَكُ مِن عَبدٍ وَمِن عِرسِهِ","مَن حَكَّمَ العَبدَ عَلى نَفسِهِ",24,"س",2,1],["إِن وَجَدتُم فيهِ شِباكَ أَبيكُم","كُنتُم دونَ غَيرِكُم أَربابَه",25,"ب",2,0],["إِن وَقَفَت سوقُكَ لَو أَكسَدَت","بِضاعَةٌ مِن شِعرِكَ الخائِبِ",26,"ب",1,0],["أنَوَالُهُ يومَ النَّدى أَمْ بِشْرُهُ","وسَطاهُ يومَ الرَّوْعِ أَمْ إقدامُه",27,"م",2,0],["إن وَفَّرَ السَّيفَ يومَ الرَّوْعِ تالِدُه","أعادَ تَوفيرَه بالبَذْلِ إتلافا",28,"ف",2,0],["أَنوي السُلُوَّ لَهُ فَيَثنِيَ عَزمَتي","وَجهٌ لَهُ لَو قابَلَ البَدرَ اِختَفى",29,"ف",2,0],["إِن وَرَدتَ الهَيجاءَ يا سائِقَ العي","سِ وَشارَفتَ دَوحَها وَالنَخيلا",30,"ل",2,0],["إِنَّ وَجهَ الحُمّى لَوَجهٌ صَفيقٌ","حينَ تَسطو بِهِ نَهاراً جَهارا",31,"ر",2,0],["أَنوحَ بنَ عَمروٍ إِنَّ ما حُمَّ واقِعٌ","وَلِلأَجنُبِ المُستَعلَياتِ مَصارِعُ",32,"ع",1,1],["أَنُوحُ لِبُعْدِي عَنْهُ حُزْناً وَلَوْعَةً","كَمَا نَاحَ مِنْ شَوْقٍ جَمِيلٌ عَلَى بُثْنِ",33,"ن",1,0],["إنَّ وادي البابِ قدْ أذْكرني","جنَّةَ المأوى فللهِ العجبْ",34,"ب",1,1],["إِنَّ وَجهاً أَبصَرتُهُ لَيلَةَ البَد","رِ عَلَيهِ اِبتَنى الجَمالُ وَحَلّا",35,"ل",2,0],["إِنَّ وَجدي بِقُربِكُم أُمَّ عَمروٍ","مِثلُ وَجدِ الصَدي بِبَردِ الشَرابِ",36,"ب",1,0],["إن وصفتَ المُلكَ يطويه البلَى","فَصِفِ الأحلامَ تستهوي النِّياما",37,"م",2,0],["أَنَوماً عَلى الزلزالِ أَم لا يَهولُكُم","تَخَمُّطُ هَذا الصائِلِ المُتَجَهِّمِ",38,"م",1,0],["أَنَوماً يا مُحَمَّدُ عَن بِلادٍ","أَباحَ حَريمَها الأَهلُ النِيامُ",39,"م",1,0],["إِن وَعَدَ الوَصلَ سينُ طُرَّتِهِ","قَرَأتُ في عارِضَيهِ لَفظَةَ لا",40,"ل",2,0],["إِنَّ وَجّاً وَما يَلي بَطنَ وَجٍّ","دارَ قَومي بِرَبوةٍ وَرُتوقِ",41,"ق",1,0],["إِن وَقَفَ الديكُ ثَنى بِالشَدِّ","وَالوَثبُ مِنهُ مِثلَ وَثبَ الفَهدِ",42,"د",1,0],["إِنَّ وَعدَ الكَريمِ دَينٌ عَلَيهِ","فَاِقضِ وَاِظفَر بِهِ عَلى الغُرَماءِ",43,"ا",2,0],["أَنوارُ مَهلاً كَم ثَوى مِن رَبرَبٍ","نورٍ وَلاحَت في الدُجى أَنوارُ",44,"ر",1,0],["إِن وَطِئَت هالِكَ الوَغى فَرَسٌ","فَجِسمُهُ بَعدَ رَوحِهِ مَدَرُ",45,"ر",1,0],["أَنوارُ تُحسَبُ مِن سَنا الأَنوارِ","وَمِنَ البَوارِ مَهاً عَرَضنَ بَواري",46,"ي",1,1],["إِن وَدَّعوهُ فَما يَدري بِما صَنَعوا","أَو قَطَّعوهُ فَما يَنتابُهُ أَلَمُ",47,"م",1,0],["أَنوءُ مَعَ الخُطوبِ إِلى أُمورٍ","لِشَخصِيَ دونَ مَوقِعِها اِصطِلامُ",48,"م",1,0],["إِنَّ وَفاةَ النِكسِ في جُبنِهِ","مِثلُ وَفاةِ الفارِسِ المُعلَمِ",49,"م",1,0],["أَنوءُ بِرِجلٍ بِها ذِهنُها","وَأَعيَت بِها أُختُها الغابِرَه",50,"ر",2,0],["أَنوار منذ دفنت جسمك ناعما","لي بالقبور صبابة وولوع",51,"ع",1,0],["أنوار أن الصب مات سروره","يوم الفراق فقلبه في مأتم",52,"م",1,0],["أَنُوحُ على نَفْسِي وأَندبُ نُبْلَهَا","إِذا أَنا في الضَّرَّاءِ أَزمعْتُ قتلَهَا",53,"ل",3,1],["إنّ وادي الظَّلامِ يَطْفَحُ بالهَوْ","لِ فما أبْعَدَ ابتسامَ القُلوبِ",54,"ب",1,0],["أَنْوَارِ مَيْمُونِ النَّقِيبَةِ مَاجِدٍ","ثَبْتِ الحَصَاةِ مِنَ الطِّرَازِ الفَائِقِ",55,"ق",1,0],["إِنْ وَأَلَ القَوْمُ فَمِنْ بَأْسِهِ","يَأْوَوْنَ فِي الضَّيْمِ إِلَى مُؤْئِلِ",56,"ل",1,0],["أَنْوَارُ وَحْيِكَ تَخْلبُ الأ","لْبابَ فِي قَسَمَاتِ دُرِّكْ",57,"ك",1,0],["أَنْوَارُهَا تُهدِي وَعَنْهَا","الطَّرْفُ يَرْجَعُ فِي كِلاَلِ",58,"ل",1,0],["أَنْوَارُ وَجْهِكَ طَالَعْتنَا اليَوْمَ مِنْ","بُرْجٍ حَلَلْتَ بِهِ لِغَيْرِ زِيَالِ",59,"ل",1,0],["أنوء إذا وقفت بحمل ثوبي","وأعثر حين أمشي بالظلالِ",60,"ل",1,0],["إِن وَعى مِنّي الأُصولَ ضُحىً","فَرَّعَت آراؤُهُ أُصُلا",61,"ل",2,0],["أنوح للمستضعفين وإنّني","أشقى من الأيتام والضعفاء",62,"ا",2,0],["إن وحَّدتْ بين أقوام ثقافتهُم","فلن نُفرِّقَ ذاتَ البَيْن بُلدان",63,"ن",1,0],["أنوما وإغفاء على سنة الكرى","وما نام طرف في حماها ولا أغفا",64,"ف",2,0],["أَنُوءُ بوَجهٍ كأَخبارِ (كانَ)","بجَنبَينِ مِن حَرفِ جَرٍّ وظَرفْ",65,"ف",1,0],["إنْ وَقفَتْ سُوقُكَ، أوْ أكسدتْ","بِضَاعَةٌ مِنْ شِعرِكَ الخائِبِ",66,"ب",1,0],["إن وهزّيك بالأشعار أنسُجُها","للغافل المتعدي جدُّ مَنْ غفلا",67,"ل",2,0],["إنَّ وَجْهاً أَبْصَرْتُهُ لَيْلَة َ البَدْ","رِ عَلَيْهِ کبْتَنَى الجَمَالُ وَحَلاّ",68,"ل",2,0],["أَنُوحُ لِبُعْدِي عَنْهُ حُزْناً وَلَوْعَة ً","كمانا من شوقٍ \" جميلٌ \" عاى َ \" بثنِ \"",69,"ن",1,0],["إن واعدت مطلت لو أوعدت وصلت","فعل الوعيد وحبل الفتك بالخبر",70,"ر",1,0],["إن وجهاً رأيته ليلة السب","تِ رماني بحبه وتولى",71,"ل",2,1],["أنورٌ آبقٌ تَبكيه","أرواح العُلى مُزنا",72,"ن",2,0],["ِإن وَافَاكُم ضَيفٌ فَكُونُوا","لِحَقِّ الضَّيفِ مِنهُ مَانِعِينَا",73,"ن",2,0],["إِن وُجِّهَت قِبِلَت في القَلبِ تَورِيَّةً","فيها إكتِفَاءٌ ولَفظُ الكُلِّ مُتَّحِدُ",74,"د",1,0],["أنوى بان ألقي بآمالي على","ملك علا تثويبه تثوى به",75,"ب",2,0],["إِنْ واصَلَ النِّسْيانَ لِي فِي الْهَوى","فَإِنَّيِ وَاصَلْت ذِكْراهُ",76,"ه",1,0],["أنوارُ شمسِ المَعالي فيه ظاهرةٌ","في الضوء شمسٌ وفي الإظلامِ مقْباس",77,"س",1,0],["أنوحُ كما ناحتْ ولكنْ مدامعي","تَفيض وما تَنْدَى لهن مَدامع",78,"ع",1,0],["إِن وَازَنتها وما وازَت قصائدُهم","فربَّما وازنَ الدرّ المثاقيلُ",79,"ل",1,0],["أنوماً ووعدُ الحادثاتِ وعيدُ","وحادي المنايا ليس عَنْهُ مَحيدُ",80,"د",1,1],["إن ودعوا ذاهباً لم تلق حزنهمو","من أنه سار بل من أنهم رجعوا",81,"ع",3,0],["إن وجها أحبه لخليق","بهيامي بكل قال وقيل",82,"ل",1,0],["أنُوحُ كَما نَاحَتْ هَديلاً حمامةٌ","على روضةٍ مخضرّةٍ شجراتُها",83,"ت",3,0],["إِن وَفَّق الحَظُّ لهُ فارَةً","يُسرِعُ في ساعَتِهِ يخبرُ",84,"ر",1,0],["أَنوارُهُ كانَت بِجَبهَةِ آدم","لا تَختَفي عَمَّن لهُ عَينانِ",85,"ن",1,0],["أنُوحُ حَماماً كلَّما ذُكِرَ الشَّرقُ","وَأَبكِي غَمَاماً كُلَّمَا لَمَعَ البَرقُ",86,"ق",1,1],["أَنْوَارُهُ هامُوا لَها فَذَكَرْتُ مَا","نَسِيَتْ نَوَارٌ مِن هَوىً وهُيَامِ",87,"م",1,0],["أَنوْماً عَلَى مِثْلِ هَدِّ الصَّفاةِ","وَهَزْلاً وَقَدْ أَصْبَحَ الأَمْرُ جِدَّا",88,"د",2,0],["أَنوارُ خَاطِرِهِ ثَواقِبُ دونها ال","مِشكاة حَلَّ زُجاجَها المِصباحُ",89,"ح",1,0],["إِنَّ وَصفَ الصَّفِيِّ يُعجِزُ مَن أك","ثَرَ شَدَّ الأَطنابِ بِالإِطنابِ",90,"ب",1,0],["إنّ وجدي بك يا حلو","اللمى أرق جفني",91,"ن",2,0],["إِنَّ وجوهَ الحيله","في البُخلِ مُستحيلَه",92,"ه",1,0],["أَنوحُ ما ناحَ الحَمامُ غُدوَةً","هَيهاتَ ما قصدُ الحَمام قَصدي",93,"ي",1,0],["أَنوحُ اِلتياعاً في نواحي نواح","فَيرحمني اللاحي لِفَرطِ نواحِ",94,"ح",1,1],["إن وصلا نسخته بجفاءٍ","عابه الناس يا رقيق الحواشي",95,"ي",1,0],["أَنوارُ حِكمَتِهِ بِالمَنطِقِ اِئتَلَفَت","فَاللَفظُ كَالزَيتِ وَالمَعنى إِضاءَتُهُ",96,"ت",2,0],["انوح كل صباحِ","وكل مغربِ شمس",97,"س",1,0],["انوارها تسطع في صحنها","مثل حباب الخمر في الاكؤس",98,"س",1,0],["ان وعدت الآن تمضي","بعد لأي ثم تغرب",99,"ب",1,0],["أَنوح كَما ناحَ الحَمام المُطَوَّقُ","أعلّل آمالي إِذا اللَيل عَسعَسا",100,"س",2,0],["أنَوماً وَقَد بَانَ الخَليطُ تَذُوقُ","ودار كزعم العادلات مذيق",101,"ق",1,1],["ان وَرد الرِياضِ بِالكَف","فِ وورد الخدود بِالفم يَقطف",102,"ف",1,1],["اِنَّ وَجدي كل يَوم في اِزدِياد","وَالهَوى يَأتي عَلى غَيرِ المُراد",103,"د",1,1],["إن وتَر الدّهرُ ثأر","أو نُسِيَ العَهدُ ذَكَر",104,"ر",1,0],["أَنوطُ حاجي بِرَحبِ البالِ واسِعِهِ","إِن يُنطَ حاجٌ بِواني الخَطوِ مِصلاعِ",105,"ع",1,0],["أَنَوماً وَأَلحاظُ الخُطوبِ سَواهِرُ","وَسَعياً وَأَفراسُ الحَوادِثِ تَركُضُ",106,"ض",1,1],["إِن ورد الحَمام أَرفق بِالصَ","ب المَعنى مِن فرقة الأَحباب",107,"ب",1,0],["إنْ وَرَدْنا منهلاً من نَيلكم","ما صَدَرْنا عنكم إلاَّ ورودا",108,"د",2,0],["أنوء بأعباء المروءة حاملاً","من الهمّ ما لا تستطيع الأباعر",109,"ر",1,0],["أَنوءُ بشكرها وأَفوزُ منها","بما يوفي الثراءَ إلى العديم",110,"م",1,0],["إنَّ وُرْقاً ناحت على الغصن شجواً","أنا منها بذلك النَّوح أولى",111,"ل",2,0],["إن واعدت حبها فالميم مبسمها","والياء طرتها والحاجب النونُ",112,"ن",1,0],["أنواعهُ غريبة الألفاظِ","نوع الأجٌ ثم نوعٌ غاظي",113,"ي",1,0],["أنوح كنوح الحمام اغتدى","ترنّمهُ بالضحى يغتنم",114,"م",1,0],["أَنْورُكِ أَمْ أَوْقَدْتِ بالليلِ نارَكِ","لباغٍ قِراكِ أَوْ لباغٍ جوارَكِ",115,"ك",1,1],["أنوح في نخل نوح الحمائم في","فن من الأيك أو رأسي من النخل",116,"ل",1,0],["إن وجد العزَّ وراءَ جانبٍ","مشَى ولو على عوامل القنا",117,"ن",2,0],["إن وهبتْ كنتَ عُبابَ بحرها","أو رُهبتْ كنت شَبا حسامِها",118,"م",3,0],["أنّ وراء خَلَّتي","يداً تسدُّ الخِلَلا",119,"ل",2,0],["إن وفى يوماً فللغدر وإن","ضمّ شملاً فلصدعٍ وزيال",120,"ل",1,0],["أنُوَّامَ ليلٍ قصَّر اليومُ عمرَه","سلوا ببقاء الليل من لم يغمِّض",121,"ض",1,0],["إن وُصفت تيَّمها وصفُها","أو نُسبتْ أعجبها الناسبُ",122,"ب",1,0],["أن وعد اليوم بالوصال غداً","أخلفك الوعد منهُ أو مطّلك",123,"ك",1,0],["إِن وَعَدوا لَم يُنجِزوا الوَعدَ أَو","يَشيبَ مِن مَطلِهِمُ الراسُ",124,"س",1,0],["إِن واجَرَ الأَمرَدَ أَو مُلتَحي","واجَرَ مِن مَهدٍ إِلى لَحدِ",125,"د",1,0],["إنّ وهماً تملّك زائلٌ لو","ساكَنتْهُم ارادةٌ لا تُصدُّ",126,"د",1,0],["إن ورَتْ للقِرى فبالنّدّ تُورى","أو لحربٍ فبالوَشيعِ القصيدِ",127,"د",1,0],["أنوارك الخاطفة لعقولنا تسترق","ومعاطفك للقلوب القاسية تسترق",128,"ق",1,1],["إن وقد الهجير فليس إلا","ظلال من عقاب أو عقاب",129,"ب",1,0],["إن واعَدتهُ بالوفاءِ قُلُوبُنا","ما كان وعدُ الحُرِّ بالمكذُوب",130,"ب",1,0],["إِنَّ وَجدي كَما عَهِدتَ صَريحٌ","ما بِخَلْق سواك فيه نصيبُ",131,"ب",1,0],["إِنَّ وَردَ الخُدودِ وَالحَدَقَ النُج","لَ وَما في الثُغورِ مِن أُقحُوانِ",132,"ن",1,1],["أنواره هي أرواح البرية في","أجسادهم قدرت من سالف القدمِ",133,"م",1,0],["أنواره الشريف للخافقين وقد","غص الزمان بها من شدة العظمِ",133,"م",1,0],["إن وجهاً كنت أنظرُهُ","يختفي عني فأظهره",134,"ه",1,1],["إنَّ وضْعَ القريضِ بين يديهِ","وإلى بابهِ المُؤَيَّدِ حَمْلهْ",135,"ل",2,0],["إن وَتَرَتْ قَلْبَكَ الهمومُ فما","مِثْلُ انتصارٍ بالنَّاي والوَتَرِ",136,"ر",1,0],["إن ولاية النبي المرضي","خلاف ما لبعضكم من بعض",137,"ض",1,0]]}