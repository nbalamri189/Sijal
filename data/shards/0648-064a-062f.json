{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[55,"بكت عيني على جسمي","https://www.aldiwan.net/poem26096.html","الهزج"],[77,"يا طالبا من جاره إسكرفجا","https://www.aldiwan.net/poem36648.html","الكامل"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[71,"كل ذي أبنة له واحد يعلوه","https://www.aldiwan.net/poem3820.html","الخفيف"],[35,"أمن طلل أقوى من الحي ماثله","https://www.aldiwan.net/poem39102.html","الطويل"],[54,"أنا من علمت إذا دعيت لغارة","https://www.aldiwan.net/poem27416.html","الكامل"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[88,"لعمرك لو كانت حديدا جسومنا","https://www.aldiwan.net/poem45054.html","الطويل"],[27,"علام تلوم عاذلة جهول","https://www.aldiwan.net/poem5960.html","الوافر"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[47,"ويد يراها الدهر غير ذميمة","https://www.aldiwan.net/poem25248.html","الكامل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"فديت محيا في مسائله ينمي","https://www.aldiwan.net/poem19669.html","الطويل"],[72,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[51,"أحذر أهل الأرض حد ابن طالب","https://www.aldiwan.net/poem8507.html","الطويل"],[51,"ليهنك أن قد مر من صدر دولة","https://www.aldiwan.net/poem62950.html","الطويل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[91,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[14,"تقول ألا أقصر من الغزو واشتكى","https://www.aldiwan.net/poem38294.html","الطويل"],[38,"ويدني ذراعيه إذا ما تبادرا","https://www.aldiwan.net/poem7727.html","الطويل"],[85,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[85,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[43,"لم لا يغاث الشعر وهو يصيح","https://www.aldiwan.net/poem10608.html","الكامل"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"عليك السلام أيها القمر البدر","https://www.aldiwan.net/poem63569.html","الطويل"],[45,"سقيت الغوادي من طلول وأربع","https://www.aldiwan.net/poem64652.html","الطويل"],[45,"زائر زارني ليسأل عن حالى","https://www.aldiwan.net/poem65201.html","الخفيف"],[45,"أنزاعا في الحب بعد نزوع","https://www.aldiwan.net/poem64684.html","الخفيف"],[28,"سلوت عن الدهر الذي كان معجبا","https://www.aldiwan.net/poem5463.html","الطويل"],[61,"ويدر دجا يسعى به غصن رطب","https://www.aldiwan.net/poem51381.html","الطويل"],[61,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[61,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[58,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[66,"هجرت بعدك القلوب الجسوما","https://www.aldiwan.net/poem40293.html","الخفيف"],[97,"طلق شجونك في ثرى الأحبابِ","https://www.aldiwan.net/poem24392.html","الكامل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"لا عذر للعاذل في الكاس","https://www.aldiwan.net/poem26916.html","السريع"],[52,"يا قلب ويحك خنتني وفعلتها","https://www.aldiwan.net/poem27202.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"أعاذل ما غنيت عن المدام","https://www.aldiwan.net/poem65243.html","الوافر"],[48,"أيا من لا يرام له كلام","https://www.aldiwan.net/poem65251.html","الوافر"],[46,"بني آدم بئس المعاشر أنتم","https://www.aldiwan.net/poem22161.html","الطويل"],[46,"يا نفس آه لمتجر متنزر","https://www.aldiwan.net/poem22699.html","الكامل"],[46,"قالت معاشر كل عاجز ضرع","https://www.aldiwan.net/poem22938.html","البسيط"],[46,"لا يغبطن ماش فوارس شزب","https://www.aldiwan.net/poem23253.html","الكامل"],[46,"إن شئتما أن تنسكا فاسكنا","https://www.aldiwan.net/poem23553.html","السريع"],[46,"تروم شفاء ما الأقوام فيه","https://www.aldiwan.net/poem23612.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85526","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141023",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19708","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55191","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54526","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54206","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[45,"زَائرٌ زَارَني ليَسْألَ عَنْ حَالي","https://www.poetsgate.com/ViewPoem.aspx?id=32174",""],[46,"يا نَفسُ! آهِ لِمَتْجَرٍ مُتَنزِّرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=20274",""],[46,"بني آدمٍ بئسَ المعاشِرُ أنتمُ،","https://www.poetsgate.com/ViewPoem.aspx?id=18003",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وَيَدٌ تَصولُ عَلى الحُسامِ شَجاعَةً","فَتَكادُ تَبسُطُها بِغَيرِ حُسامِ",0,"م",1,0],["وَيَدٌ لِلدَهرِ مَوهوبٌ لَها","إِن أَساءَ الدَهرُ يَوماً وَأَلاما",1,"م",2,0],["وَيُدخِلُ أَطرافَ القَنا كُلَّ مُهجَةٍ","بِها أَبَداً غِلٌّ عَلَيهِ دَخيلُ",2,"ل",1,0],["وَيَدٍ إِذا اِستَمطَرتَ عابِرَ مُزنِها","دَفَقَت عَلَيكَ مِنَ الزُلالِ السَلسَلِ",3,"ل",1,0],["ويَدي مُكَرَّمَةٌ فلا أعْطو بِها","مِنَحاً على أعْطافِهِنَّ هَوانُ",4,"ن",1,0],["ويَدٌ يَتيهُ بِها اليَراعُ على الظُّبا","ويُشابُ فيها بالنّجيعِ النّائِلُ",5,"ل",1,0],["ويَدْنو شأوُ حاسدِهِمْ ويَنْأى","عليهِ مَناطُ مَجدِهمُ مَنالا",6,"ل",2,0],["وَيَدعوني إِلى الحَربِ","فَأَدعوهُ إِلى السِلمِ",7,"م",1,0],["ويَدُلُّ أنّكَ قدْ نَبَذْتَ تَداوِياً","ويَدُلُّ أنّكَ قدْ ترَكْتَ عِلاجا",8,"ج",2,0],["وَيَدُ الإِلَهِ مَعَ الجَماعَةِ فَاِضرِبوا","بِعَصا الجَماعَةِ تَظفَروا بِنَجاحِ",9,"ح",1,0],["وَيَداهُ في أَصلِ أَيدَي غُلامَي","هِ التِذاذاً وَآخَرٌ لِقَفاهُ",10,"ا",2,0],["وَيُدرِكُ غَيري عِندَ غَيرِكِ حَظَّهُ","بِشِعري وَيُعييني بِه ما أُحاوِلُه",11,"ل",2,0],["وَيَدُلُّ ضَيفي في الظَلامِ عَلى القِرى","إِشراقُ ناري أَو نُباحُ كِلابي",12,"ي",1,0],["ويدخلها يتيم القوم طفلاً","فتُخرجه لهم يَفَعاً غلاما",13,"م",2,0],["ويد يجمع الشفاه عليها","كلما قد ومددتها التقبيل",14,"ل",1,0],["ويدفن في التراب اسمه دفن جسمه","فلم يتفقّده من الناس فاقد",15,"د",1,0],["وَيَدعوكَ المُكَلَّفُ بَعدَ جَهدٍ","وَعانٍ قَد أَضَرَّ بِهِ الكُبولُ",16,"ل",1,0],["وَيَدمى أَظَلّاها عَلى كُلِّ حَرَّةٍ","إِذا اِستَعرَضَت مِنها حَريزاً تُناقِلُه",17,"ل",2,0],["وَيَدٍ يَراها الدَهرُ غَيرَ ذَميمَةٍ","تَمحو إِساءَتَهُ إِلَيَّ وَتَغفِرُ",18,"ر",1,1],["ويدفعني عن قوت يوميَ معشرٌ","وأنت عليهم نافذُ النهي والأمر",19,"ر",1,0],["ويدعو إليه المعتفين ثناؤهُ","كما يستدلّ الطالب الرّوض بالشمّ",20,"م",1,0],["ويدعو حماه طالباً بعد طالب","إلى المال يستجدى أو العلم يستجلى",21,"ل",2,0],["ويُدعَى أَبوه طالباً وكفاكُمُ","به طِيرةً أن المنيّةَ طالبُ",22,"ب",1,0],["ويدجو عليه ليلُهُ ونهارهُ","وأنتم شموس أشرقتْ وبدور",23,"ر",1,0],["ويَدرُّ درُّكَ للألى يبغونَهُ","عفواً بلا مسح ولا إبساس",24,"س",1,0],["ويدُ اللَه تلك ناصر دين ال","لَهِ ليثُ البِراز لا العِرّيس",25,"س",1,0],["ويدُ البخيل لما استفاد قرارةٌ","ويدُ الجواد لما استفاد مَسِيلُ",26,"ل",1,0],["ويدمُجُ أسبابَ المودةِ بيننا","مودتُنا الأبرارَ من آلِ هاشمِ",27,"م",1,0],["وَيَدُ الفَتى هِنري تُطَوِّقُها","فَحَسَدتُ ذاكَ الطَوقَ في الخَصرِ",28,"ر",1,0],["وَيَدَّعي الفَضلَ وَالنَبالَه","مَن يَسلُبُ العامِلَ الرَغيفا",29,"ف",2,0],["وَيَدفَعُ لِلمَوتِ بِالأَبرِياءِ","وَيَحسَبُهُ مَعشَرٌ دَيِّنا",30,"ن",2,0],["وَيَدفَعُ الشَيخُ اِلتَوى عودُهُ","وَصارَ مِثلَ الرُمَّةِ البالِيَه",31,"ه",1,0],["وَيَدعونَني كَهلاً وَقَد عِشتُ حِقبَةً","وَهُنَّ عَنِ الأَزواجِ نَحوي نَوازِعُ",32,"ع",1,0],["وَيُدني ذِراعَيهِ إِذا ما تَبادَرا","إِلى رَأسِ صِلٍّ قائِمِ العَينِ أَسفَعُ",33,"ع",1,1],["ويدب في ذيل العروس إذا مشت","وينال قبل فم الحليل لثامها",34,"م",3,0],["وَيُدَلَّلونَ إِذا أُريدَ قِيادُهُم","كَالبُهمِ تَأنَسُ إِذ تَرى التَدليلا",35,"ل",2,0],["وَيَدُ المُلكِ تَستَجيرُ يَدَيهِ","وَالسَرايا تَدعوهُ وَالأَعلامُ",36,"م",1,0],["وَيَدٌ لَها كَرَمُ الغَمامِ لِأَنَّهُ","يَسقي العِمارَةَ وَالمَكانَ البَلقَعا",37,"ع",2,0],["وَيَدٌ كَأَنَّ قِتالَها وَنَوالَها","فَرضٌ يَحِقُّ عَلَيكَ وَهوَ تَبَرُّعُ",38,"ع",1,0],["وَيَدُقُّ بِالصَدرِ الحِجارَ كَأَنَّهُ","يَبغي إِلى ما في الحَضيضِ سَبيلا",39,"ل",2,0],["ويدٌ لكم تِركان ثوبي إنه","من بعد سرق قصائدي مربوح",40,"ح",1,0],["ويدٌ تَهُدُّ المالَ راحَتُها","أبداً ويعمُرُ ظهرَها القُبَلُ",41,"ل",1,0],["وَيَدنو قَرارُ البَحرِ طَوراً وَرُبَّما","تَباعَدَ حَتّى لا يُنالَ لَهُ قَعرُ",42,"ر",1,0],["وَيَدعونَ بِالأَسماءِ مَثنىً وَمَوحَداً","إِذا حَضَروا بابَ الرُواقِ المُرَفَّعِ",43,"ع",1,0],["وَيَدٌ لاتَزالُ تَرمي بِأَحجا","رٍ مِنَ اللَقمِ تُعجِزُ المَنجَنيقا",44,"ق",2,0],["وَيدٌ لايَزالُ يَصرَعُها الجو","دُ وَرَأيٌ في الخَطبِ غَيرُ صَريعِ",45,"ع",1,0],["وَيَدعو القَطا فيها القَطا فَيُجيبُهُ","تَوائِمُ أَطفالٍ مِنَ السَبسَبِ المَحلِ",46,"ل",1,0],["ويدر دجا يسعى به غصن رطب","دنا نوره لكن تناوله صعب",47,"ب",1,1],["ويدٌ كَصَوْبِ المُزنِ يَغ","مُرُ سَجلُها سَجلَ المُساجِل",48,"ل",1,0],["ويدٌ تَساوى الناسُ في معروفِها","فيدُ المُقِلِّ تنالُه والمُكثِر",49,"ر",1,0],["ويَدٌ تُعيدُ الماء في أقلامِها","جُوداً وتكسو الطِّرْسَ نُوراً حَاشِدا",50,"د",2,0],["وِيَدنو بِها في الصَفِّ حَتّى يَزيرُها","حِمامُ المَنايا تَقَطرُ المُوتَ وَالدَما",51,"م",2,0],["وَيَدي تُدنيهِ نَح","وَ وِسادي",52,"ي",1,0],["وَيَدَينِ ثَنَت عِنانَ يَراعٍ","أَنبَتَت في الطُروسِ دُرّاً نَظيما",53,"م",2,0],["ويدٌ كعيسى كم شَفَت من علةٍ","وأَست صريعَ وجيعةٍ وعذابِ",54,"ب",1,0],["ويد تمتد نحوي كيدٍ","من خلال الموج مُدّت لغريق",55,"ق",1,0],["وَيَدٍ يَظَلُّ المالُ يَسقُطُ كَيدُهُ","فيها سُقوطَ الهاءِ في التَرخيمِ",56,"م",1,0],["وَيَدرُجُ مِنهُ السِلمُ ما تَنشُرُ الوَغى","فَطَوراً إِلى طَيٍّ وَطَوراً إِلى نَشرِ",57,"ر",1,0],["وَيُدمي الشِفارَ وَيَحني القَنا","وَيَحمي الذِمارَ وَيَرعى الهَمَل",58,"ل",1,0],["وَيَدخُلونَ عاجِلاً بَغداذا","فَلَم يَرَ الكَذّابُ ذا وَلا ذا",59,"ذ",2,0],["وَيَدخُلُ الآذانَ مِن أَمسِهِ","مِن تَحتِ إِكليلٍ مِنَ الآسِ",60,"س",1,0],["وَيَدٍ بِوَجهٍ مُطلَقٍ شَيَّعتَها","كَبَرَت عَلى عافيكَ وَاِستَصغَرتَها",61,"ت",3,0],["وَيَدُلُّ الورَى على اللَّهِ بالتَّوْ","حيدِ وَهْوَ المَحَجَّةُ البَيْضاءُ",62,"ا",2,0],["وَيَدعوها إِلى الطُنبورِ حِذقٌ","إِذا دارَت مُعَتَّقَةُ المُدامِ",63,"م",1,0],["وَيَدخُلُ حُبُّهُ في كُلِّ قَلبٍ","مَداخِلَ لا تُقَلقِلُها المُدامُ",64,"م",1,0],["وَيَدعوا الطَبيبَ المَرءُ وافاهُ حَينُهُ","رُوَيدَكَ إِنَّ الأَمرَ جُلَّ عَنِ الطِبِّ",65,"ب",1,0],["وَيَدُلُّني أَنَّ المَماتَ فَضيلَةٌ","كَونُ التَريقِ إِلَيهِ غَيرَ مُيَسَّرِ",66,"ر",1,0],["وَيَدَّعي الرُتبَةَ العُليا أَخَسُّهُم","فَما يُجابُ لَهُم داعٍ إِذا ضَرَعوا",67,"ع",3,0],["وَيَدايَ في دُنيايَ وَهِيَ حَبيبَةٌ","كَيَدَي أَبي لَهبٍ غَداً في الآجِلِ",68,"ل",1,0],["وَيَدَّعي الإِخلاصَ في دينِهِ","وَهوَ عَنِ الإِلحادِ في القَولِ كان",69,"ن",1,0],["وَيَدرُسُ إِن أَرادَ كِتابَ موسى","وَيُضمِرُ إِن أَحَبَّ وَلاءَ شَعيا",70,"ع",3,0],["ويدري غواة الشعر من هو مفرد","ولكنَّ من لم يغو بالشعر لا يدري",71,"ر",2,0],["ويد كأنّ نوالها وقتالها","فرضٌ يحقّ عليك وهو تبرّع",72,"ع",1,0],["وَيَدٌ تُعانِقهُ برغم مَنيَّةٍ","وفَمٌ يُقَبِّلُهُ برغم حِمامِ",73,"م",1,0],["ويَدٌ تُمسكُ اليراعَ وأخرى","في ارتعاشٍ تمرُّ فوقَ جبينكْ",74,"ك",1,0],["ويدفع الشباب في ال","وحول والمخاطر",75,"ر",1,0],["ويد الغزالة فوق أشرِف مِغزل","والبدر كلَّ ملاوة في منزل",76,"ل",1,0],["ويدخلُ المجتثَّ أَيضاً أَجمعَهْ","ولا يكونُ في سوى ذي الأربعَهْ",77,"ه",1,0],["وَيَدٌ لِسيِّدِ مِصْرَ عِنْدَ يَدٍ بَنَت","دُسْتُورَها لِلْجِيلِ بَعْدَ الجِّيلِ",78,"ل",1,0],["وَيُدَمِّرُ النَّسَّافُ شُمَّ قِلاَعِهِ","فَيُثِيرُهَا منْثُورَةً كَغُبارِ",79,"ر",1,0],["وَيَدُكُّ مِنْ شُوسِ الرِّجَالِ مَعَاقِلاً","فَيَظَلُّ شَكْلُ المَوْتِ شَكْلَ دَمَارِ",79,"ر",1,0],["وَيَدْرِي فَتَاهُمْ أَيْنَ مَطْلَبُ قُوتِه","إِذَا جَامِعِيٌّ زَاغَ عَنْهُ وَلَمْ يَدْرِ",80,"ر",1,0],["وَيَدْفَعُهُمْ حُبُّ أَوْطَانِهِمْ","وَيَجْمَعُهُمْ شَرَفُ المَقْصِدِ",81,"د",1,0],["وَيُدْرِكُ أَقْصَى الآمِلِينَبِجُودِهِ","كَأَنَّ لَهَّ وُجْداً وَما هُوَ وَاجِدُ",82,"د",1,0],["وَيَدْفَعُ تَضْلِيلَ الَّذِينَ افْتِرَاؤُهُمْ","عَلَى اللهِ حَقٌّ وَالحَرَامُ لَهُمْ حِلُّ",83,"ل",1,0],["وَيَدْعُو العِلْمُ صُونُوهَا تَصُنْكُمْ","فَمَا أَنْ يُسْتَجَابَ لَهُ دُعَاءُ",84,"ا",2,0],["وَيَدٍ لَم تخطّ إِلّا كِتابَ ال","لَهِ ذَنباً وَلَم تُمَدَّ لِوَكزِ",85,"ز",1,0],["ويدٌ تستهل من غير ما ضَنْ","نٍ ومَنٌّ يَمُنُّ من غير مَنِّ",86,"ن",1,0],["وَيُدْرِكُ ما يُعْيِي الْجَحَافِلَ وَحْدَهُ","وَيَبْلُغُ شَأْواً يُعْجِزُ الْجْمعُ مَفْرَدا",87,"د",2,0],["وَيداً إنْ سكنت في يومِها","هزّت السيف غداً والقلمَا",88,"م",2,0],["ويدِبُّ في الصحراء ليثًا كاسرًا","ويغوصُ تحتَ الماء كالتمساحِ",89,"ح",1,0],["ويدعو السماءَ لمن حرَّروهُ","فتفتحُ أبوابها للدعاء",90,"ا",2,0],["ويداري السُّهْدَ أو يرنو إلى","ظله، يختال في ثوبٍ نسائي",91,"ا",2,0],["ويدّعي أنهم قالوا : أن ليس لها","عمّ ويعتصر الدعوى وينتزف",92,"ف",1,0],["ويُدرِكَ أينَ صفوُ الماء عنه","وريِّقُهُ إذا وَرَدَ اللصابا",93,"ب",2,0],["وَيَدٌ مَا تَزَالُ تَرْمي بِأحْجَا","رٍ مِنَ اللُّقْمِ تُعجِزُ المَنْجَنيقَا",94,"ق",2,0],["ويَدُلُّني، أنّ المَماتَ فضيلَةٌ،","كونُ الطّريقِ إلَيهِ غيرَ مُيَسَّر",95,"ر",1,0],["ويدعو الطبيبَ المرءُ، وافاهُ حَينُهُº","رُوَيدَك! إنّ الأمرَ جلّ عن الطّبّ",96,"ب",1,0],["وَيدورُ هَمْسٌ في الجَوانِحِ ما الَّذي","بِالثَّوْرَةِ الحَمْقاءِ قَدْ أَغْراني؟",97,"ن",2,0]]}