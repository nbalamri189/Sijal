حَاكَهَا القِبْطُ",223,"ط",1,0],["وَيُدْنِي إِلَى بَعْضِهَا بَعْضَهَا","كَضَمِّ الأَحِبَّةِ زُوَّارَهَا",224,"ر",3,0],["ويدخل الرد على المعتزلة","عليهم في نقض باقي المسألة",225,"ه",1,0],["ويدفع الأعداء عن حمائه","ويقتل المراق من أعدائه",225,"ه",1,0],["ويدعي بعض من ادعاه","منهم فقال إنه إله",225,"ه",1,0],["ويدعو الله في السرِّ","وفي الجَهْرِ بإِبقائك",226,"ك",1,0],["ويَداه لا اليُسرى ليُسْ","رٍ لا ولا اليُمْنى ليمنِ",227,"ن",1,0],["ويدٌ لها في كُلِّ جيدٍ كاسْمِها","مننٌ يُقَلدُها بلا اسْتِيجابِها",228,"ب",3,0]]}