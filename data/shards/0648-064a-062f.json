,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[413,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[413,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[413,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[413,"ورد السرور وطاف بحانها","https://www.aldiwan.net/poem54038.html","الكامل"],[413,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[413,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[413,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[429,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[429,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[429,"شق الكمال عليه جيب سواده","https://www.aldiwan.net/poem12595.html","الكامل"],[441,"سألنا فقالوا هذه جنة الورد","https://www.aldiwan.net/poem55934.html","عموديه"],[450,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[451,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[456,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[456,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[456,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[459,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[459,"ولما التقينا والمعالي مضيئة","https://www.aldiwan.net/poem16106.html","الطويل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[466,"وذي حلة من نسيج الزمان","https://www.aldiwan.net/poem60014.html","الكامل"],[475,"صباه الهوى ما أحوج الخلو أن يصبو","https://www.aldiwan.net/poem15336.html","الطويل"],[480,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[481,"لمن الديار عفون بالجزع","https://www.aldiwan.net/poem2073.html","أحذ الكامل"],[493,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[498,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[498,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[498,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[498,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[513,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[513,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[527,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[536,"مقامك دون موقعه النجوم","https://www.aldiwan.net/poem47936.html","عموديه"],[536,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[536,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[536,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[536,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[542,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[549,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[549,"لو أنصف القلب لما ودكم","https://www.aldiwan.net/poem47399.html","السريع"],[556,"معرفة الله عند عارفه","https://www.aldiwan.net/poem33563.html","المنسرح"],[556,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[556,"مقام بني الصديق ذروة فرقد","https://www.aldiwan.net/poem34602.html","الطويل"],[560,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"],[560,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"],[565,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[565,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[565,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[573,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"]],"verses":[["وَيَدٌ تَصولُ عَلى الحُسامِ شَجاعَةً","فَتَكادُ تَبسُطُها بِغَيرِ حُسامِ",0,"م",1,0],["وَيَدٌ لِلدَهرِ مَوهوبٌ لَها","إِن أَساءَ الدَهرُ يَوماً وَأَلاما",1,"م",2,0],["وَيُدخِلُ أَطرافَ القَنا كُلَّ مُهجَةٍ","بِها أَبَداً غِلٌّ عَلَيهِ دَخيلُ",2,"ل",1,0],["وَيَدٍ إِذا اِستَمطَرتَ عابِرَ مُزنِها","دَفَقَت عَلَيكَ مِنَ الزُلالِ السَلسَلِ",3,"ل",1,0],["ويَدي مُكَرَّمَةٌ فلا أعْطو بِها","مِنَحاً على أعْطافِهِنَّ هَوانُ",4,"ن",1,0],["ويَدٌ يَتيهُ بِها اليَراعُ على الظُّبا","ويُشابُ فيها بالنّجيعِ النّائِلُ",5,"ل",1,0],["ويَدْنو شأوُ حاسدِهِمْ ويَنْأى","عليهِ مَناطُ مَجدِهمُ مَنالا",6,"ل",2,0],["وَيَدعوني إِلى الحَربِ","فَأَدعوهُ إِلى السِلمِ",7,"م",1,0],["ويَدُلُّ أنّكَ قدْ نَبَذْتَ تَداوِياً","ويَدُلُّ أنّكَ قدْ ترَكْتَ عِلاجا",8,"ج",2,0],["وَيَدُ الإِلَهِ مَعَ الجَماعَةِ فَاِضرِبوا","بِعَصا الجَماعَةِ تَظفَروا بِنَجاحِ",9,"ح",1,0],["وَيَداهُ في أَصلِ أَيدَي غُلامَي","هِ التِذاذاً وَآخَرٌ لِقَفاهُ",10,"ا",2,0],["وَيُدرِكُ غَيري عِندَ غَيرِكِ حَظَّهُ","بِشِعري وَيُعييني بِه ما أُحاوِلُه",11,"ل",2,0],["وَيَدُلُّ ضَيفي في الظَلامِ عَلى القِرى","إِشراقُ ناري أَو نُباحُ كِلابي",12,"ي",1,0],["ويدخلها يتيم القوم طفلاً","فتُخرجه لهم يَفَعاً غلاما",13,"م",2,0],["ويد يجمع الشفاه عليها","كلما قد ومددتها التقبيل",14,"ل",1,0],["ويدفن في التراب اسمه دفن جسمه","فلم يتفقّده من الناس فاقد",15,"د",1,0],["وَيَدعوكَ المُكَلَّفُ بَعدَ جَهدٍ","وَعانٍ قَد أَضَرَّ بِهِ الكُبولُ",16,"ل",1,0],["وَيَدمى أَظَلّاها عَلى كُلِّ حَرَّةٍ","إِذا اِستَعرَضَت مِنها حَريزاً تُناقِلُه",17,"ل",2,0],["وَيَدٍ يَراها الدَهرُ غَيرَ ذَميمَةٍ","تَمحو إِساءَتَهُ إِلَيَّ وَتَغفِرُ",18,"ر",1,1],["ويدفعني عن قوت يوميَ معشرٌ","وأنت عليهم نافذُ النهي والأمر",19,"ر",1,0],["ويدعو إليه المعتفين ثناؤهُ","كما يستدلّ الطالب الرّوض بالشمّ",20,"م",1,0],["ويدعو حماه طالباً بعد طالب","إلى المال يستجدى أو العلم يستجلى",21,"ل",2,0],["ويُدعَى أَبوه طالباً وكفاكُمُ","به طِيرةً أن المنيّةَ طالبُ",22,"ب",1,0],["ويدجو عليه ليلُهُ ونهارهُ","وأنتم شموس أشرقتْ وبدور",23,"ر",1,0],["ويَدرُّ درُّكَ للألى يبغونَهُ","عفواً بلا مسح ولا إبساس",24,"س",1,0],["ويدُ اللَه تلك ناصر دين ال","لَهِ ليثُ البِراز لا العِرّيس",25,"س",1,0],["ويدُ البخيل لما استفاد قرارةٌ","ويدُ الجواد لما استفاد مَسِيلُ",26,"ل",1,0],["ويدمُجُ أسبابَ المودةِ بيننا","مودتُنا الأبرارَ من آلِ هاشمِ",27,"م",1,0],["وَيَدُ الفَتى هِنري تُطَوِّقُها","فَحَسَدتُ ذاكَ الطَوقَ في الخَصرِ",28,"ر",1,0],["وَيَدَّعي الفَضلَ وَالنَبالَه","مَن يَسلُبُ العامِلَ الرَغيفا",29,"ف",2,0],["وَيَدفَعُ لِلمَوتِ بِالأَبرِياءِ","وَيَحسَبُهُ مَعشَرٌ دَيِّنا",30,"ن",2,0],["وَيَدفَعُ الشَيخُ اِلتَوى عودُهُ","وَصارَ مِثلَ الرُمَّةِ البالِيَه",31,"ه",1,0],["وَيَدعونَني كَهلاً وَقَد عِشتُ حِقبَةً","وَهُنَّ عَنِ الأَزواجِ نَحوي نَوازِعُ",32,"ع",1,0],["وَيُدني ذِراعَيهِ إِذا ما تَبادَرا","إِلى رَأسِ صِلٍّ قائِمِ العَينِ أَسفَعُ",33,"ع",1,1],["ويدب في ذيل العروس إذا مشت","وينال قبل فم الحليل لثامها",34,"م",3,0],["وَيُدَلَّلونَ إِذا أُريدَ قِيادُهُم","كَالبُهمِ تَأنَسُ إِذ تَرى التَدليلا",35,"ل",2,0],["وَيَدُ المُلكِ تَستَجيرُ يَدَيهِ","وَالسَرايا تَدعوهُ وَالأَعلامُ",36,"م",1,0],["وَيَدٌ لَها كَرَمُ الغَمامِ لِأَنَّهُ","يَسقي العِمارَةَ وَالمَكانَ البَلقَعا",37,"ع",2,0],["وَيَدٌ كَأَنَّ قِتالَها وَنَوالَها","فَرضٌ يَحِقُّ عَلَيكَ وَهوَ تَبَرُّعُ",38,"ع",1,0],["وَيَدُقُّ بِالصَدرِ الحِجارَ كَأَنَّهُ","يَبغي إِلى ما في الحَضيضِ سَبيلا",39,"ل",2,0],["ويدٌ لكم تِركان ثوبي إنه","من بعد سرق قصائدي مربوح",40,"ح",1,0],["ويدٌ تَهُدُّ المالَ راحَتُها","أبداً ويعمُرُ ظهرَها القُبَلُ",41,"ل",1,0],["وَيَدنو قَرارُ البَحرِ طَوراً وَرُبَّما","تَباعَدَ حَتّى لا يُنالَ لَهُ قَعرُ",42,"ر",1,0],["وَيَدعونَ بِالأَسماءِ مَثنىً وَمَوحَداً","إِذا حَضَروا بابَ الرُواقِ المُرَفَّعِ",43,"ع",1,0],["وَيَدٌ لاتَزالُ تَرمي بِأَحجا","رٍ مِنَ اللَقمِ تُعجِزُ المَنجَنيقا",44,"ق",2,0],["وَيدٌ لايَزالُ يَصرَعُها الجو","دُ وَرَأيٌ في الخَطبِ غَيرُ صَريعِ",45,"ع",1,0],["وَيَدعو القَطا فيها القَطا فَيُجيبُهُ","تَوائِمُ أَطفالٍ مِنَ السَبسَبِ المَحلِ",46,"ل",1,0],["ويدر دجا يسعى به غصن رطب","دنا نوره لكن تناوله صعب",47,"ب",1,1],["ويدٌ كَصَوْبِ المُزنِ يَغ","مُرُ سَجلُها سَجلَ المُساجِل",48,"ل",1,0],["ويدٌ تَساوى الناسُ في معروفِها","فيدُ المُقِلِّ تنالُه والمُكثِر",49,"ر",1,0],["ويَدٌ تُعيدُ الماء في أقلامِها","جُوداً وتكسو الطِّرْسَ نُوراً حَاشِدا",50,"د",2,0],["وِيَدنو بِها في الصَفِّ حَتّى يَزيرُها","حِمامُ المَنايا تَقَطرُ المُوتَ وَالدَما",51,"م",2,0],["وَيَدي تُدنيهِ نَح","وَ وِسادي",52,"ي",1,0],["وَيَدَينِ ثَنَت عِنانَ يَراعٍ","أَنبَتَت في الطُروسِ دُرّاً نَظيما",53,"م",2,0],["ويدٌ كعيسى كم شَفَت من علةٍ","وأَست صريعَ وجيعةٍ وعذابِ",54,"ب",1,0],["ويد تمتد نحوي كيدٍ","من خلال الموج مُدّت لغريق",55,"ق",1,0],["وَيَدٍ يَظَلُّ المالُ يَسقُطُ كَيدُهُ","فيها سُقوطَ الهاءِ في التَرخيمِ",56,"م",1,0],["وَيَدرُجُ مِنهُ السِلمُ ما تَنشُرُ الوَغى","فَطَوراً إِلى طَيٍّ وَطَوراً إِلى نَشرِ",57,"ر",1,0],["وَيُدمي الشِفارَ وَيَحني القَنا","وَيَحمي الذِمارَ وَيَرعى الهَمَل",58,"ل",1,0],["وَيَدخُلونَ عاجِلاً بَغداذا","فَلَم يَرَ الكَذّابُ ذا وَلا ذا",59,"ذ",2,0],["وَيَدخُلُ الآذانَ مِن أَمسِهِ","مِن تَحتِ إِكليلٍ مِنَ الآسِ",60,"س",1,0],["وَيَدٍ بِوَجهٍ مُطلَقٍ شَيَّعتَها","كَبَرَت عَلى عافيكَ وَاِستَصغَرتَها",61,"ت",3,0],["وَيَدُلُّ الورَى على اللَّهِ بالتَّوْ","حيدِ وَهْوَ المَحَجَّةُ البَيْضاءُ",62,"ا",2,0],["وَيَدعوها إِلى الطُنبورِ حِذقٌ","إِذا دارَت مُعَتَّقَةُ المُدامِ",63,"م",1,0],["وَيَدخُلُ حُبُّهُ في كُلِّ قَلبٍ","مَداخِلَ لا تُقَلقِلُها المُدامُ",64,"م",1,0],["وَيَدعوا الطَبيبَ المَرءُ وافاهُ حَينُهُ","رُوَيدَكَ إِنَّ الأَمرَ جُلَّ عَنِ الطِبِّ",65,"ب",1,0],["وَيَدُلُّني أَنَّ المَماتَ فَضيلَةٌ","كَونُ التَريقِ إِلَيهِ غَيرَ مُيَسَّرِ",66,"ر",1,0],["وَيَدَّعي الرُتبَةَ العُليا أَخَسُّهُم","فَما يُجابُ لَهُم داعٍ إِذا ضَرَعوا",67,"ع",3,0],["وَيَدايَ في دُنيايَ وَهِيَ حَبيبَةٌ","كَيَدَي أَبي لَهبٍ غَداً في الآجِلِ",68,"ل",1,0],["وَيَدَّعي الإِخلاصَ في دينِهِ","وَهوَ عَنِ الإِلحادِ في القَولِ كان",69,"ن",1,0],["وَيَدرُسُ إِن أَرادَ كِتابَ موسى","وَيُضمِرُ إِن أَحَبَّ وَلاءَ شَعيا",70,"ع",3,0],["ويدري غواة الشعر من هو مفرد","ولكنَّ من لم يغو بالشعر لا يدري",71,"ر",2,0],["ويد كأنّ نوالها وقتالها","فرضٌ يحقّ عليك وهو تبرّع",72,"ع",1,0],["وَيَدٌ تُعانِقهُ برغم مَنيَّةٍ","وفَمٌ يُقَبِّلُهُ برغم حِمامِ",73,"م",1,0],["ويَدٌ تُمسكُ اليراعَ وأخرى","في ارتعاشٍ تمرُّ فوقَ جبينكْ",74,"ك",1,0],["ويدفع الشباب في ال","وحول والمخاطر",75,"ر",1,0],["ويد الغزالة فوق أشرِف مِغزل","والبدر كلَّ ملاوة في منزل",76,"ل",1,0],["ويدخلُ المجتثَّ أَيضاً أَجمعَهْ","ولا يكونُ في سوى ذي الأربعَهْ",77,"ه",1,0],["وَيَدٌ لِسيِّدِ مِصْرَ عِنْدَ يَدٍ بَنَت","دُسْتُورَها لِلْجِيلِ بَعْدَ الجِّيلِ",78,"ل",1,0],["وَيُدَمِّرُ النَّسَّافُ شُمَّ قِلاَعِهِ","فَيُثِيرُهَا منْثُورَةً كَغُبارِ",79,"ر",1,0],["وَيَدُكُّ مِنْ شُوسِ الرِّجَالِ مَعَاقِلاً","فَيَظَلُّ شَكْلُ المَوْتِ شَكْلَ دَمَارِ",79,"ر",1,0],["وَيَدْرِي فَتَاهُمْ أَيْنَ مَطْلَبُ قُوتِه","إِذَا جَامِعِيٌّ زَاغَ عَنْهُ وَلَمْ يَدْرِ",80,"ر",1,0],["وَيَدْفَعُهُمْ حُبُّ أَوْطَانِهِمْ","وَيَجْمَعُهُمْ شَرَفُ المَقْصِدِ",81,"د",1,0],["وَيُدْرِكُ أَقْصَى الآمِلِينَبِجُودِهِ","كَأَنَّ لَهَّ وُجْداً وَما هُوَ وَاجِدُ",82,"د",1,0],["وَيَدْفَعُ تَضْلِيلَ الَّذِينَ افْتِرَاؤُهُمْ","عَلَى اللهِ حَقٌّ وَالحَرَامُ لَهُمْ حِلُّ",83,"ل",1,0],["وَيَدْعُو العِلْمُ صُونُوهَا تَصُنْكُمْ","فَمَا أَنْ يُسْتَجَابَ لَهُ دُعَاءُ",84,"ا",2,0],["وَيَدٍ لَم تخطّ إِلّا كِتابَ ال","لَهِ ذَنباً وَلَم تُمَدَّ لِوَكزِ",85,"ز",1,0],["ويدٌ تستهل من غير ما ضَنْ","نٍ ومَنٌّ يَمُنُّ من غير مَنِّ",86,"ن",1,0],["وَيُدْرِكُ ما يُعْيِي الْجَحَافِلَ وَحْدَهُ","وَيَبْلُغُ شَأْواً يُعْجِزُ الْجْمعُ مَفْرَدا",87,"د",2,0],["وَيداً إنْ سكنت في يومِها","هزّت السيف غداً والقلمَا",88,"م",2,0],["ويدِبُّ في الصحراء ليثًا كاسرًا","ويغوصُ تحتَ ال