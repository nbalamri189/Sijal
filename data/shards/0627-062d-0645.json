://www.aldiwan.net/poem11013.html","عموديه"],[399,"لا تقف بعد عزم شهر الصيام","https://www.aldiwan.net/poem46417.html","الخفيف"],[402,"أحمد ربي على ضياء","https://www.aldiwan.net/poem49428.html","مخلع البسيط"],[403,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[407,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[413,"أحمد الله بك الحال التي","https://www.aldiwan.net/poem54018.html","الرمل"],[413,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[413,"إن جئت آل سلمى أو مغانيها","https://www.aldiwan.net/poem54145.html","البسيط"],[429,"أحمد الآبي فيه أبنة","https://www.aldiwan.net/poem12447.html","الرمل"],[429,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[429,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[429,"ما لمن في الهوى من خلاق","https://www.aldiwan.net/poem12686.html","الخفيف"],[438,"أحمل نفسي فوق ما لا تطيقه","https://www.aldiwan.net/poem14396.html","الطويل"],[451,"إلى ابن حبيب من ثنائي أجله","https://www.aldiwan.net/poem61789.html","الطويل"],[456,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[456,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[456,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[456,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[459,"ملأ العصر بل الدهر علا","https://www.aldiwan.net/poem15397.html","الرمل"],[459,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[459,"وكريم الملتقى ذو لسن","https://www.aldiwan.net/poem16152.html","الرمل"],[459,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[462,"أحب الحمى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[466,"أحمد لا تكس ابا أحمد","https://www.aldiwan.net/poem60406.html","البسيط"],[468,"ما ضر جيراننا إذ انتجعوا","https://www.aldiwan.net/poem4742.html","المنسرح"],[477,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[498,"أشكو إلى الله تباريح الهوى","https://www.aldiwan.net/poem37731.html","الرجز"],[498,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[498,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[535,"إن يكن ولى الأمير فقد","https://www.aldiwan.net/poem69397.html","المديد"],[538,"أحمامة حلبت شؤونك أسجما","https://www.aldiwan.net/poem56754.html","البسيط"],[551,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[556,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[556,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[556,"حضرة الغيب سترها الأشياء","https://www.aldiwan.net/poem35077.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أُحَمِّلُها الشَوقَ القَديمَ فَتَنبَري","بِأَجلادِ عاني القَلبِ جَمِّ المَشاغِفِ",0,"ف",1,0],["أَحمَدُ اللَهَ أَنَّني ما تَقَصّي","تُ وَإِنَّ الَّذي طَلَبتُ طَفيفُ",1,"ف",1,0],["أَحمَدُ كَم لي عَليكَ مِن كَمَدٍ","باقٍ وَمِن جودِ أَدمُعٍ سَرِبِ",2,"ب",1,0],["أَحْمَالُ جِصِّ وَآجُرٍّ تُعَاقِبُهَا","وَجَرَّ أَلْوَاحِ صَخْرِ فَوْقَ أَعْجَالِ",3,"ل",1,0],["أَحمَدُ اللَهَ إِذ سَلِمتَ لِمِصرٍ","قَد رَماها في قَلبِها مَن رَماكا",4,"ك",2,1],["أَحمَدُ اللَهَ إِذ سَلِمتَ لِمِصرٍ","لَيسَ فيها لِيَومِ جِدٍّ سِواكا",4,"ك",2,0],["أَحمَدُ اللَهَ إِذ سَلِمتَ لِمِصرٍ","وَوَقاها بِلُطفِهِ مَن وَقاكا",4,"ك",2,0],["أَحمَدتَ عاقِبَةَ الدَواءِ","وَنِلتَ عافِيَةَ الشِفاءِ",5,"ا",2,1],["أَحَمُّ رَجوفٌ مُستَهِلٌّ رَبابُهُ","لَهُ فِرَقٌ مُسحَنفَراتٌ صَوادِرُ",6,"ر",1,0],["أَحْمَدْتَ مَا شَاءَ الوَفَاءُ فِيهَا","وَحَمَدْتَ مَا شَاءَ الودَادُ وَدُودَهَا",7,"د",3,0],["أَحْمِسُ الأَوَّلُ ابْتِدَاءٌ جَمِيلٌ","أَطْرَبَ السَّامِعِينَ وَالنَّاظِرِينَا",8,"ن",2,0],["أَحُمَاةَ مِصْرَ وَطَالِبِي اسْتِقْلالَهَا","أَيَّامَ صَالَ المَوْتَ وَهْوَ زُؤامُ",9,"م",1,0],["أَحمي حِماهُم وَأَرمي في مُعارِضُهُم","وَأَستَقيلُ إِذا ما رِجلُهُم هَوَتِ",10,"ت",1,0],["أَحَمَّ الشَوى فَرداً كَأَنَّ سَراتَهُ","سَنا نارِ مَحزونٍ بِهِ الحَيُّ ساهِرِ",11,"ر",1,0],["أَحَمَّ عِلافِيٌّ وَأَبيَضُ صارِمٌ","وَأَعيَسُ مَهريٌّ وَأَشَعثُ ماجِدُ",12,"د",1,0],["أحماة أطفال الأيامى أنكم","جدراء بالتعظيم والإجلال",13,"ل",1,0],["أَحمي حِمايَ بِأَعلى المَجدِ مَنزِلَتي","مِن خِندِفٍ وَالذُرى مِن قَيسِ عَيلانا",14,"ن",2,0],["أَحمَوا عَلَيكَ فَلا تَجوزُ بِمَنهَلٍ","ما بَينَ مِصرَ إِلى قُصورِ عُمانِ",15,"ن",1,0],["أَحمي مَواسِمَ تَشفي كُلَّ ذي خَطَلٍ","مُستَرضَعٍ بِلِبانِ الجِنِّ مَسلوسِ",16,"س",1,0],["أَحمَدُ اللَهَ فَلا نِدَّ لَهُ","بِيَدَيهِ الخَيرُ ما شاءَ فَعَل",17,"ل",1,0],["أَحمي حَريمي أَن يُبا","حَ وَلَستُ أَحمي مالِيَه",18,"ي",2,0],["أَحمَدُ اللَهَ عَلى ما","سَرَّ مِن أَمري وَساءَ",19,"ا",2,0],["أحمدُ الله الذي قد","جعلَ الشمس ضياء",20,"ا",2,0],["أحمر الخد زاد منه لهيبي","ليت ورد الخدود كان نصيبي",21,"ب",2,1],["أحمد الله لا أزال معنًّى","بأمورٍ تأتي على رغم أنفي",22,"ي",1,0],["أحمد الله كم أجود في الخل","قِ مقالاً وما يفيد المقال",23,"ل",1,1],["أحمد شب يا قريش فتيهي","في الغوايات واسرحي في الشقاء",24,"ا",2,0],["أحمدُ اللَّه نيةً وثناءَ","غُدوةً بل عَشيَّةً بل مساءَ",25,"ا",2,1],["أحْمى فأرْعَى وآوى مَنْ يُطيفُ به","في حيثُ يأمن من خوفٍ ومن سَغَبِ",26,"ب",1,0],["أحمدُ اللَّه مُبدِئاً ومُعيداً","حمدَ من لم يزل إليه مُنيبا",27,"ب",2,1],["أحمدُ اللّه حمدَ شاكرِ نُعْمَى","قابلٍ شُكر ربِّه غيرِ آبِ",28,"ب",1,1],["أحمدُ اللَّه يا أبا سهلٍ السه","لَ مرامِ النوال للطُلّابِ",28,"ب",1,0],["أَحمَى علينا نَخلُكُم ذِيخَهُ","فكيف ما يحملُ في ذِيخِهِ",29,"خ",2,1],["أحميك من مورد قصدتِ له","لا ينتهي وردُهُ إلى صدرِ",30,"ر",1,0],["أحمدُ الله إذ أراني عيداً","لا أرى فيه فوق أمرِك أمرا",31,"ر",2,0],["أحملُ الأمر وهو عبءٌ ثقيلٌ","للأخلاءِ حملَ بعضيَ بعضا",32,"ض",2,0],["أحمد الله ما وردت من الإخ","وان غير المكَدَّر المطروق",33,"ق",1,0],["أحمد الخالق الذي لو رعاني","لم يَكِل حاجتي إلى مخلوق",34,"ق",1,0],["أحمدُ اللَّهَ ما كذا وعدتْني","عنك فحواك من وثاقةِ عقدِك",35,"ك",1,0],["أحمل الوزرَ والأمانةَ والدي","نَ جميعاً وكلّ ثقلٍ ثقيلِ",36,"ل",1,1],["أحملُ الدين في الحقوقِ وإن أُث","قِلْتُ والحقُّ قائمٌ قانونه",37,"ن",2,0],["أحمدَ الحمدِ يا أبا حسن الحسْ","نَى إذا الظهرُ أثقلتهُ ديونه",37,"ن",2,0],["أحمدَ الحمدِ يا أبا حسن الحُسْ","نَى إذا القلبُ حَالفتْه شُجونه",37,"ن",2,0],["أَحمَرُ تَحسِبُ لَونَ الوَرسِ خالَطَهُ","كَأَنَّهُ حينَ يَهوي مُدبِراً حَجَرُ",38,"ر",1,0],["أَحَمُّ حَديدُ الطَرفِ أَوحَشَ لَيلَةً","وَأَعوزَهُ أَذخارُهُ وَالمَكاسِبُ",39,"ب",1,0],["أَحمي مَكانَك مِن قَلبي وَأمنعُه","كَما حَمى الحاجِبُ الإِسلامَ بِالباتِرْ",40,"ر",1,0],["أحمد كان مثل بحر رحيب","موجه فوق لجه كالكثيب",41,"ب",1,1],["أحمد كان شاعراً وحكيما","وباسرار النفس كان عليما",41,"م",2,0],["أحمد لا يفنى وان كان في قبر","عفته الايام عظماً رميما",41,"م",2,0],["أحمد كان في الزعامة للشعر","وفي العلم بالحياة عظيما",41,"م",2,0],["احمد الباريء الذي يتساوى","عنده ايماني به وجحودي",42,"د",2,0],["احمل الى مصر تحية اختها","بغداد ان سألتك عن بغدادا",43,"د",2,0],["احمد رحيلك ان كا","نت المنايا مطايا",44,"ا",3,0],["أحملها لأنها","تغشّى في الزمن",45,"ن",1,0],["أَحَمَلتَ دَيناً في حَياتِكَ مَرَّةً","أَحَمَلتَ يَوماً في الضُلوعِ غَليلا",46,"ل",2,0],["أَحَمَلتَ ظُلماً مِن قَريبٍ غادِرٍ","أَو كاشِحٍ بِالأَمسِ كانَ خَليلا",46,"ل",2,0],["أَحَمَلتَ مِنّا بِالنَهارِ مُكَرَّراً","وَاللَيلِ مِن مُسدٍ إِلَيكَ جَميلا",46,"ل",2,0],["أَحَمَلتَ طُغيانَ اللَئيمِ إِذا اِغتَنى","أَو نالَ مِن جاهِ الأُمورِ قَليلا",46,"ل",2,0],["أَحَمَلتَ في النادي الغَبِيِّ إِذا اِلتَقى","مِن سامِعيهِ الحَمدَ وَالتَبجيلا",46,"ل",2,0],["أَحمُدُكَ اللَهَ وَأُطري الأَنبِياء","مَصدَرَ الحِكمَةِ طُرّاً وَالضِياء",47,"ا",2,1],["أَحْمَرٌ كالخِضَابِ في صَفْحِ هادِيهِ","مِنَ الهادِياتِ مِثْلُ الخِضَابِ",48,"ب",1,1],["اِحمَد عُفاتَكَ لا فُجِعتَ بِفَقدِهِم","فَلَتَركُ ما لَم يَأخُذوا إِعطاءُ",49,"ا",2,0],["أَحمَرُ مِثلُ النُحاسِ في قَشَرٍ","تَدمى فَلا فِضَّةٌ وَلا ذَهَبه",50,"ب",2,0],