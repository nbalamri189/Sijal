x?id=201167",""],[5127,"حديثُ النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177309",""],[5183,"أَلْفَرَاهيدِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=186453",""],[5193,"من وحي العزّة","https://www.poetsgate.com/ViewPoem.aspx?id=213569",""],[5320,"إلى الرغيف","https://www.poetsgate.com/ViewPoem.aspx?id=43255",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5351,"الكرار من جديد","https://www.poetsgate.com/ViewPoem.aspx?id=202211",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5574,"غادة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205988",""],[5596,"رد على قصيدة حمزة بن عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=206717",""],[5638,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=198121",""],[1890,"المرء يجمع والزمان يفرق","https://www.poetsgate.com/ViewPoem.aspx?id=16448",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[6056,"الأصل غلاّب","https://www.poetsgate.com/ViewPoem.aspx?id=156709",""],[6097,"ألا يا خاطب الحسنا","https://www.poetsgate.com/ViewPoem.aspx?id=186339",""],[242,"أقول لمن يصيخ الى اصطراخ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563805",""],[402,"وزنيجة حسناء كالمسك لونها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54063&r=&rc=915",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""]],"verses":[["وَزِنوا الكَلامَ وَسَدِّدوهُ فَإِنَّهُم","خَبَؤوا لَكُم في كُلِّ حَرفٍ مَزلَقا",0,"ق",2,0],["وَزِنْجِيَّةٍ حَسْنَاءَ كَالمِسْكِ لَوْنُهَا","بَدَا قَدهَا كَالسَّمْهَرِيِّ المُقَوَّمِ",1,"م",1,1],["وَزَنّا الكَأسَ فارِغَةً وَمُلأى","فَكانَ الوَزنُ بَينَهُما سَواءَ",2,"ا",2,0],["وَزَندي وَهوَ زَندُكَ لَيسَ يَكبو","وَناري وَهيَ نارُكَ لَيسَ تَخبو",3,"ب",2,0],["وزناد القول لا يس","مح في وجهي بقدحه",4,"ح",2,0],["وزِنْ ذنوبي بما أسلفتُ من حسنٍ","فإنني لستُ أخشى ظُلمَ ميزانك",5,"ك",1,0],["وَزَندُكَ مِن زِنادٍ وارِياتٍ","إِذا لَم يُحمَدِ الزَندُ الصَلودُ",6,"د",1,0],["وَزَنتُ بِسِرِّ المَوتِ فَلسَفَةَ الوَرى","فَشالَت وَكانَت جَعجَعاتٍ بِلا طَحنِ",7,"ن",1,0],["وَزَنَت أُمَيَّةُ أَمرَها فَدَعَت لَهُ","مَن لَم يَكُن غُمراً وَلا مَجهولا",8,"ل",2,0],["وَزَنوا الرِجالَ فَكانَ ما","أَعطَوا عَلى قَدَرِ الزِناتِ",9,"ت",1,0],["وَزَنّا قيمَةَ الدَهماءِ مِنهُ","وَوَفَّينا القِيانَ بِهِ الصَداقا",10,"ق",2,0],["وَزَنوا الأَصالَةَ مِن حِجاهُ وَإِنَّما","وَزَنوا بِها طَوداً مِنَ الأَطوادِ",11,"د",1,0],["وَزِنديقٌ يَكادُ الجِذعُ يَمشي","إِلَيهِ وَيَستَخِفُّ لَهُ الشَريطُ",12,"ط",1,0],["وَزَنّا بِهِ أَخطارَ قَومٍ فَخَفَّضَت","مَواقِعُ مِنهُم عَن تَرَفُّعِ حالِهِ",13,"ل",2,0],["وَزِنْجيَّةٍ عُرِفَتْ بالإباقِ","فليسَ لها راحَةٌ من وثاقِ",14,"ق",1,1],["وَزِنِ الكَلامَ إِذا نَطَقتَ وَلا تَكُن","ثَرثارَةً في كُلِّ نادٍ تَخطُبُ",15,"ب",1,0],["وزنتَ العينَ فاكحلْها","بطلعتها بمجراها",16,"ا",3,0],["وزندٍ عاطلٍ يحظى بمدحٍ","ويُحرَمُهُ الذي فيه السوارُ",17,"ر",1,0],["وَزِنِ العُقولَ فان ظَفرتَ براجحٍ","فاستبقِ كنزَك لا يَكُنْ بِمُضيَّعِ",18,"ع",1,0],["وزَنبقةً وسطَ بَلُّورةٍ","على رفرفِ الشمسِ عند الزَّوالْ",19,"ل",1,0],["وُزِنَتْ بخالِصِ عَسجَد لا فِضّةٍ","حَقّاً لبائِعِها على مُبْتاعِها",20,"ع",3,0],["وَزُنُودِ عَاجٍ عُرِّقَتْ بِزُمُرُّدٍ","آيَاتُ حُسْنٍ فِي شُكُولِ زُنُودِ",21,"د",1,0],["وَزِنَ الَّتِي دَفَعَتْ ضَلاَلَكَ بِالْهُدَى","وَسَوَادَ مَكْرِكَ بِاليَدِ البَيْضَاءِ",22,"ا",2,0],["وَزَنْتَ خَمْسِينَ وَلِي مِثْلُهَا","مِنْ مُنْصِفٍ حَقِّكَ مِنْ بَاطِلي",23,"ل",2,0],["وَزنتُ سَماءَ المَجدِ مِنكَ بِكَوكَبٍ","رَجَمتُ بِهِ عَنها مَن اِستَرَقَ السَمعا",24,"ع",2,0],["وزن صالح الأعمال بالخوف والرجا","هما جنة للصالحات وسور",25,"ر",1,0],["وزِندِيقٌ يَكادُ الجِدْعُ يَمشِي","إليهِ ،ويَستَخِفُّ لَهُ الشَّرِيطُ",26,"ط",1,0],["وزند وجدي بربات الحجال على","عهدي به كعشيات الصبا واري",27,"ر",2,0],["وزَندُكِ هذا أم نُضارٌ وفضةٌ","وريقُك أم صرفُ المدامة أم شَهْدُ",28,"د",1,0],["وزَنجِيةٍ جَاذبتُ جَانِبَ سِرِّهَا","ومَيسُورِهَا مُستَفهِماً كُنهَ سِرِّهَا",29,"ر",3,1],["وزنوا دم الشهداء بمد محابر","العلما فكان الحبر أرجح إذ رسب",30,"ب",1,0],["وزنبورها فيها مقارن صرصر","وطبوعها باللسع للبقّ يسعد",31,"د",1,0],["وزنْجية الآباء كَرْخيّة الجَلَب","عَبِيريّة الأنفاس كَرْميّة النَّسَبْ",32,"ب",1,1],["وَزِنْهَا بِالْمُنَظَّمِ مِنْ كَلاَمٍ","تَجِدْهَا كَالْغِنَاءِ مِنَ الصُّرَاخِ",33,"خ",1,0],["وَزَنْدُها المَقدُوحُ غَيرُ صالِد","قد حَصْحَصَ الحَق فَما مِنْ جاحِدِ",34,"د",1,0],["وَزند خطيبِها علقتْ بزندٍ","لها فتمثلا غصنيْنِ سارا",35,"ر",2,0],["وَزنَينا بِعُيونٍ","وَرُجِمْنا بِظُنونِ",36,"ن",1,0],["وَزن كُلّ إِنسان بِمقدار فَضله","فَأَنتَ عَلى الإنصاف وَالعَدل أَقدَرُ",37,"ر",1,0],["وزِنِ الوَرى وَزْناً بقِسطاسِ النُّهى","وانْقُدْ رِجالَ الاسْطِناعِ رَجاحا",38,"ح",2,0],["وزناد همي في دجا","ليل البلايا ينقدح",39,"ح",1,0],["وَزِناد الأَشواق نا","راً بِأَحشائي يَقدح",40,"ح",1,0],["وَزَنّا الكأسَ فارِغَةً وملأى","وكانَ عيارُها عندي سَواءَ",41,"ا",2,1],["وَزنَّاه بِالدُنيا فَزادَ وَإِنَّما","يُبَيِّنُ أَقدار الرِجال اختِبارُها",42,"ر",3,0],["وَزَنْدٌ يُنِيرُ الشَّرْقَ والغَرْبَ قَدْحُهُ","جَدِيرٌ بأَنْ يَسْتَلحِقَ المَحْقَ والوَهْيا",43,"ي",2,0],["وزُنامٌ بالزمر يعزف طوراً","وبنانٌ بالعود تضرب تاره",44,"ر",2,0],["وزَنْتَ بذكر المالِ مجدَك في العلا","فكان وِزانُ المجد عندك أثقلا",45,"ل",2,0],["وزَنَّاهُمُ بالناس بيتاً وأنفُساً","فزلّت موازينٌ وزادوا وثمَّروا",46,"ر",3,0],["وزَنتُ بحلمي جهلَه لا أجيبه","فللّه مِنَّا مَن تمكَّن راجحا",47,"ح",2,0],["وزَنْدَينِ لو لم يُمسَكا في دَمالجٍ","لَسالا من الأكمامِ سَيلَ الجَداوِلِ",48,"ل",1,0],["وزِنْتُ وهُمْ فانظر إِلينا وقد عَلَوْا","لخفَّتهمْ لمَّا انْحَطَطْتُ لرُجْحَاني",49,"ن",2,0],["وَزَنتَ لَهُ في القَولِ رَطلاً كَرَطلِهِ","وَكِلتَ لَه في الفِعل صاعاً كَصاعِه",50,"ع",2,0],["وزنبق مجلس بين الندامى","كشيخ حاز لطفاً في وقار",51,"ر",1,1],["وزن ما تقول قبل الكلام","فقد يعدم الرأي من لم يزن",52,"ن",1,0],["وزناد وجد قد وثق","ت بأَنّه في كفّ قادح",53,"ح",1,0],["وَزَنْجٍ شَبَّبُوا لَمَّا شَجَاهُمْ","مُغَنٍّ خِلْتُه زرقا اليمامَهْ",54,"ه",1,1],["وزنجية عرفت بالإباق","فليس لها راحة في الوثاق",55,"ق",1,1],["وزنبقاً وآسا","وليلنا ليالي",56,"ي",1,0],["وزن من الملفوظ كالإطلاق","وامنع من الموضوع باتفاق",57,"ق",1,0],["وَزِندكَ حينَ تُنسَبُ مِن نُميرٍ","كَريمٌ مِن زِنادِ المَجدِ واري",58,"ر",2,0],["وزندان من مرخ على ظهر سهوق","هجف رعى الأشوال وهو صغير",59,"ر",1,0],["وَزَنْدُكَ الواري فهلْ مِنْ مُصْطَلي","لسانُ فَخْرِكَ العليِّ المُعْتَلي",60,"ل",2,0],["وزنت جيد العلى من بحر فكرك في","منظومة درراً بهى من الدرر",61,"ر",1,0],["وَزن الكَلامِ اِذا نَطَقت فَإِنَّما","يُبدي عُقول ذَوي العُقولِ المنطِق",62,"ق",1,0],["وَزن الكَلامِ اِذا نَطَقت وَلا تَكُن","ثَرثارَة في كُل نادٍ يُخطَب",63,"ب",1,0],["وَزِنْجِيُّ ليل بات روميّ ثلجه","أغرّ يريني منه تحجيل أدهم",64,"م",1,0],["وزني صحيح فإني عادل حكم","بالله وزني لهذا صح ميزاني",65,"ن",2,0],["وزنهُ بالعدلِ شرعاً كلّ آونة","واسلك به خلفه من حيثُ ما سلكا",66,"ك",2,0],["وزنجبارُ العلا لما لها وصلت","أخبارُ فضلٍ به أغنت عن الخبرِ",67,"ر",1,0],["وزنت إخواني لا مريةً","بكفَّتَيْ خُبْري وتجريبي",68,"ي",1,1],["وَزَندَي عَفارٍ في السِلاحِ وَقادِحٍ","إِذا شِئتُ أَورى قَبلَ أَن يَبلُغَ السَأَم",69,"م",1,0],["وزنجيةٍ إن تلد أبيضاً","ينمُّ عليه البياضُ دخيلا",70,"ل",2,0],["وَزِنّ حيّا اللهَ بِّرَاقها","ولام حيا الله دُحمى ولام",71,"م",1,0],["وزُنبوعُنا بَعضُهُ مثلَ ما","نظرتَ إلى الذهبِ الأملَسِ",72,"س",1,0],["وَزَنجِبَار جَزيرةٌ عَظِيمَه","بِأَربَعِينَ خُطبَةً قَدِيمَه",73,"ه",1,0],["وزَنُوا الرياحَ ووزَّعوا شمس الضحى","ليلاً فأمست فى الديار تُوزَّع",74,"ع",1,0],["وزنوا الضوءَ فى الفضاءِ وكالو","هُ بذاك المكيالِ والميزان",75,"ن",1,0],["وزن الرجال وأكرمنّ فحولهم","فمن الرجال أساود وأماحي",76,"ح",2,0],["وزَنَّيْتُمْ عجوزَكُمُ وكانتْ","حَصاناً لا يُشَمُّ لها خِمارُ",77,"ر",1,0],["وزِنتَهُ بِحجالٍ لاَ كِفَاءَ لَهَا","وليسَ فِي مسجدِ الحمراءِ من حجَلِ",78,"ل",1,0],["وزنجيةٍ لم تعرف الزنج طفلةٍ","خميصة بطنٍ مسها عندك العطش",79,"ش",1,1],["وَزند في الجَلالة غَير كاب","نَماه إِلى المَعارف كُل كابر",80,"ر",1,0],["وزنُوا جمالك في الورى فرجحت","والمعهودُ عدلُ الشّمس في الميزان",81,"ن",1,0],["وزن الرقايق من أضحى يحررها","ووصفه بفنون العلم والعمل",82,"ل",1,0],["وزندك في الورى أورى نجاحاً","وأفطن بينهم من أن تُرابا",83,"ب",2,0],["وزند قلبٍ متى الأشواق تقدحه","فإن دمعي عن صُوّانه الشرر",84,"ر",1,0],["وَزِنوا الرِجال فَربّما","في خفّة الميزان ثقلُ",85,"ل",1,0],["وَزِنَةُ المُضَارِعِ اسمُ فَاعِلِ","مِن غَيرِ ذِى الثَّلاَثِ كالمُوَاصلِ",86,"ل",1,0],["وزند خبا من بعد ما أضرم الوغى","واورى ضراماً في حشى الدين ما خبا",87,"ب",2,0],["وَزُنودٌ مُحصداتٌ","يَخفرُ الزَّندُ رَفيقَه",88,"ق",2,0],["وزنت شيبك بالتقوى تمارسها","خيرُ الكمال كمال المرء في الهرم",89,"م",1,0],["وزِن رجالاً بموازينهِمْ","لذاك قد يجي تبايُنُهُمْ",90,"م",1,0],["وزند أخيل رماه قتيلا","لديه على زنث ولوا فلولا",91,"ل",2,0],["وَزَنبق طهرهِ المخضلُّ نامٍ","كَنَشر المسك في طَي الرِياحِ",92,"ح",1,0],["وزند الوجد أورى في ضميري","وقد صار الفضاء على سما",93,"م",2,0],["وزنات ربّك مذ ربحتَ بضعفها","ناداك ربّك أيها العبد الأمين",94,"ن",1,1],["وَزِنت يَومي وَعَلق","ت في صَحيفة أَمسي",95,"س",2,0],["وَزِنِ الأُمور وأَعط كُلاًّ حقّه","واخصصه بالأوْلى به والأَلْيَقِ",96,"ق",1,0],["وُزُنُ الأَحلامِ إِن هُم وازَنُوا","صادِقوا البَأسِ إِذا البَأسُ نَصَع",97,"ع",1,0],["وزنجيّ ألمّ بغصن نور","وقد زفّت لنا بنت الكروم",98,"م",1,1],["وزنجية فات الكؤوس بنحرها","قلايد ياقوت عليها الجواهر",99,"ر",1,0],["وَزِنجِيٍّ أَلَمَّ بِنَورِ لَوزٍ","وَفي كاساتِنا بِنتُ الكرومِ",100,"م",1,1],["وزندك لم يصلد ورأيك لم يفل","وعزمك لم ينكص وسيفك ما فلا",101,"ل",2,0],["وَزِنَى المَحَارٍمٍ تِلْكَ أَقْتَمُ ظُلْمَةً","بِسَوَادِهَا مِنْ لَيْلَةٍ لَيْلاَءِ",102,"ا",2,0],["وزن روح درّاكٍ ووالِ ودادَه","وربَّ أدوبٍ ازدروه إذا دارا",103,"ر",2,0],["وَزْنُنا كأُمّتِنا","بعدَ خِفَّةٍ رجَحا",104,"ح",2,0],["وَزِنْ كَلامِي بِالآهاتِ يَسْكُنُكُمْ","فَيضُ المحَبَّةِ، أَوْ فَارفق بِإعدَامِي",105,"م",2,0],["وزنزانة الشعر ضجت هديلا","وصَيَّرَتِ السجن وكر غرام",106,"م",1,0],["وَزِنِيهِ من بوحِ المشاعرِ أحرفاً","حتى يُخَفِّرُ فيهما خداكِ",107,"ك",1,0],["وزن الأمور به على ميزانه","فهو الهدى وهَدَيِّه الجبار",108,"ر",1,0],["وزِنْ بين الأمور بوزنِ قِسطٍ","مبادِؤُهُ الفضيلةُ واللُّبابُ",109,"ب",1,0],["وزن الشوائب كالدقيق وهكذا","نشريه كره