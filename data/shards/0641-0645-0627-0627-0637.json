{"poems":[[99,"أجر غربتي أيها العائد","https://www.aldiwan.net/poem24928.html","المتقارب"],[76,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[124,"أهواك والحب داء أيما داء","https://www.aldiwan.net/poem49314.html","البسيط"],[164,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[285,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[287,"أدر يا نديمي علينا عقارا","https://www.aldiwan.net/poem32782.html","المتقارب"],[323,"رباعيات الخيام","https://www.aldiwan.net/poem63242.html","عموديه"],[422,"متى أرى هذه الأيام مسعفة","https://www.aldiwan.net/poem54090.html","البسيط"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[482,"ماذا الوقوف وقد بانوا على الطلل","https://www.aldiwan.net/poem15230.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34437","الهزج"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137747",""],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33101","الطويل"],[984,"","https://poetry.dctabudhabi.ae/diwan/poem/122195","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96681","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101376","الطويل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93751","الطويل"],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5413,"ألبوم الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=200536",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5616,"انا","https://www.poetsgate.com/ViewPoem.aspx?id=207396",""],[5809,"خلي القلب","https://www.poetsgate.com/ViewPoem.aspx?id=205408",""],[6019,"وترفُضُ عينايَ فوضى احتمال !!","https://www.poetsgate.com/ViewPoem.aspx?id=61794",""],[6164,"تنفيس .. وتقديس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66067&r=&rc=76",""]],"verses":[["فما اطلعوا اليوم بالبشريات","ولا عللوا بالتلاقي غدا",0,"د",2,0],["فَما أُطري إِذا أَطرَيتُ إِلّا","حَمِيّاً أَو حَبيباً أَو حَميما",1,"م",2,0],["فما أطلقتِ صيحةَ مُستجيرٍ","ولا شرَدْتِ عن عينٍ مناما",2,"م",2,0],["فما أطيق نعيماً إن ظفرت به","بعد الذي بز عني يوم إثرائي",3,"ا",2,0],["فما أطمع الشيطان في أخذ ثاره","وحل عرى الإسلام في كل من أغوى",4,"و",2,0],["فَما أَطْفَأْتَ مِنْ نارٍ لَهِيباً","إِلى أَنْ عُدْتَ تُذْكِيها سَعِيرا",5,"ر",2,0],["فَما أَطيَبَ الشُّربَ لا سِيَّما","عَلى الوَردِ مِثلَ خُدودِ العَذارى",6,"ر",2,0],["فما أطالَ النومُ عمرًا ولا","قَصَّرَ في الأعمارِ طولُ السَّهر",7,"ر",1,0],["فما أطعتُ الهوى فيما يرادُ به","ولا تطرَّيت بين الناي والعود",8,"د",1,0],["فما أطيرُ بأخٍ","محلِّقاً ما لم تطِرْ",9,"ر",1,0],["فما اطَّباني مرآها وقد نزحتْ","عنها الظباءُ ذواتْ الأعينِ النُّجُلِ",10,"ل",1,0],["فَما أَطيبَ القلبا","وَما أَرحبَ الصدرا",11,"ر",2,0],["فما أطهر الطفل قلبا نقيا","بنسيان زخرف هذي الدنى",12,"ن",2,0],["فَما أَطيَبَ الكَأسَ الَّتي اِعتَضتُ مِنكُم","وَلَكِنَّها لَيسَت بِريمٍ أُعانِقُه",13,"ق",2,0],["فما أطاقوا الولوج في نفق","وما أطاقوا الصعود في جبل",14,"ل",1,0],["فَما أطابَت قلبي حذام وزينب","وَلا شاقَني ربعُ العذيب ولعلعُ",15,"ع",1,0],["فما اطفأت نار احشائه","بل سطرت سقمه أسطرا",16,"ر",2,0],["فَما أَطوع الدَمعَ العصيّ لما قضت","دَواعي العَوادي في قُلوبِ الأَحبة",17,"ه",1,0],["فما أطلع الاقبال سعداً موقتا","على جبهة إلا وأبدله نحسا",18,"س",2,0],["فَما أَطيب الدُّنيا لدى اِبن سَبيلها","إِذا لَم تُلاحظه بِعَين غَضوب",19,"ب",1,0],["فما أطاقوا ولا نالوا سوى نُغب","غرفا من البحر أو رشفا من الديم",20,"م",1,0],["فما أطولَ الساعاتِ عندَ انتظار مَنْ","إذا طلعتْ فارقتَ غمَّكَ كيفما",21,"م",2,0],["فَما اطَّبَأَتْ قَلْبِي حَذامِ وَزَيْنَبٌ","وَلا شاقَنِي رَبْعُ العُذَيْبِ وَلَعْلَعُ",22,"ع",1,0],["فما اطفات في الظلماء نارا","ولا نكست. من زلل عقالا.",23,"ل",2,0],["فماأطولَ الليلَ الذي لا ينامُهُ","وماأقصرَ الليلَ الذي أنتَ نائمُهْ",24,"ه",1,0],["فَما أَطفَأَتنِي قُطيراتُ دَمعٍ","وَدَمعِيَ أَورَثَ نارَ اشتعال",25,"ل",1,0],["فما أَطْلَقَ الحُسْنُ مِنِّي السَّراحَ","بَلى .. أنا أَطْلَقْتُ منه السَّراحْ!",26,"ح",1,0]]}