{"poems":[[63,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[51,"أصبح يعقوب وتبجيله","https://www.aldiwan.net/poem65394.html","السريع"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"دع الوقوف على الأطلال والدمن","https://www.aldiwan.net/poem66519.html","البسيط"],[43,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[45,"لأي شيء صددت عني","https://www.aldiwan.net/poem66840.html","مجزوء البسيط"],[61,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[49,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[80,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[44,"لا يشمت الأعداء بالموت إننا","https://www.aldiwan.net/poem30316.html","الطويل"],[87,"إن سرنديب على حسنها","https://www.aldiwan.net/poem8197.html","السريع"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[48,"إن عنان النطاف","https://www.aldiwan.net/poem66218.html","المنسرح"],[50,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[50,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[50,"نغص طيب العيش تنصيب","https://www.aldiwan.net/poem64819.html","السريع"],[46,"لا تلحقني مينا إن نطقت به","https://www.aldiwan.net/poem23039.html","البسيط"],[76,"قول كأن فريده","https://www.aldiwan.net/poem39502.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54934","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[106,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[106,"الإنسان الآلي","https://www.poetsgate.com/ViewPoem.aspx?id=179449",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[124,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[142,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[142,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[143,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[166,"لا يشرف الرذل بأن يكتسي","https://www.aldiwan.net/poem47105.html","السريع"],[206,"أهدي لذي المجد الرفيع وذي الصفا","https://www.aldiwan.net/poem921.html",""],[210,"قسما بفرط تلهبي وتلهفي","https://www.aldiwan.net/poem13350.html","الكامل"],[223,"لا يشقنا أرب","https://www.aldiwan.net/poem41901.html","المقتضب"],[229,"قد أغتدي والليل في دجاه","https://www.aldiwan.net/poem51274.html","الرجز"],[270,"لا يشفق الغازي على مغزوه","https://www.aldiwan.net/poem34978.html","الكامل"],[275,"مهج تساق إلى الردى فتشاق","https://www.aldiwan.net/poem25476.html","الكامل"],[280,"مهلا بني الصوفي إنكم","https://www.aldiwan.net/poem60697.html","البسيط"],[280,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[285,"عقد بدا في الليل منفسخ فلا","https://www.aldiwan.net/poem39344.html","الكامل"],[298,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[302,"عودي للهوكِ","https://www.aldiwan.net/poem65692.html","الكامل"],[304,"يا آخذا مني بأذيالي","https://www.aldiwan.net/poem16757.html","السريع"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[353,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[380,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[393,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[406,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[416,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[458,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[458,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[461,"اضطرار الحر الكريم إلى الدو","https://www.aldiwan.net/poem16005.html","الخفيف"],[479,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[499,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[505,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[506,"الدين يشكو بليه","https://www.aldiwan.net/poem2390.html","المجتث"],[514,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[515,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[562,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[567,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[567,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"]],"verses":[["لا يَشْتَكي نَأْيَ مَسْراهُ أخو سَفَرٍ","تُدنِيهِ مِنهُمْ خُطا المَهْريَّةِ الذُلُلِ",0,"ل",1,0],["لا يَشرَبُ الخَمرَ إِلّا مَن لَهُ ذِمَمٌ","وَلا يَبيتُ لَهُ جارٌ عَلى وَجَلِ",1,"ل",1,0],["لا يشْمَتُ الأعْداءُ كونَكَ في الثّرى","فالموْتُ حُكْمٌ ليسَ يُخْشى عارُهُ",2,"ر",2,0],["لا يَشِحّونَ عَلى المالِ وَما","عُوُّدوا في الحَيِّ تَصرارا اللِقَح",3,"ح",1,0],["لا يَشتَكون المَوتَ إِن نَزَلَت بِهِم","شَهباءُ ذاتُ مَعاقِمٍ وَأُوارِ",4,"ر",1,0],["لا يَشهَدونَ نَجِيَّ القَومِ بَينَهُمُ","تُقضى الأُمورُ عَلى تَيمٍ وَما شَعَروا",5,"ر",3,0],["لا يشتكي ضيفٌ له كِظَّةً","لكنه يقتله الجوع",6,"ع",1,0],["لا يشتهي من مُهَفْهَفٍ جَيَداً","بل يشتهي من عُجارمٍ جَيَدَهْ",7,"د",2,0],["لا يشتكي الناسُ عنفهُ وكذا","لا تشتكي ضعفهُ ولا خوره",8,"ر",2,0],["لا يشتري المال بالثناء ولا","تظل تُفدي صِرارُه بِدَره",8,"ر",2,0],["لا يُشفق المستعيدُ نائله","من وشك إملاله وإعراضه",9,"ض",2,0],["لا يشتري الحمدَ بل يُعطي اللُّهى هِبةً","لا حمدَ للمشتري في الجُود بالثمنِ",10,"ن",1,0],["لا يَشهُرونَ عَلى مُخالِفِهِم","سَيفاً يَقومُ مَقامَهُ العَذَلُ",11,"ل",1,0],["لِأَيِّ شَيءٍ صَدَدتَ عَنّي","يا بائِناً بِالعَزاءِ مِنّي",12,"ن",2,1],["لا يَشرَبُ الماءَ إلا غَصَّ من حَذَرٍ","ولا يُهَوِّمُ إلا راعَهُ الحُلُمُ",13,"م",1,0],["لا يَشغَلَنَّكَ لَو وَلَيتَ عَنِ الَّذي","أَصبَحتَ فيهِ وَلا لَعَلَّ وَلا عَسى",14,"ا",1,0],["لا يشربُ الرّوحَ من جُثمانِ ذي زَردٍ","حَتَّى يَرى الحدّ مِنهُ يَأكلُ الزّرَدا",15,"د",2,0],["لا يَشمَتِ الأَعداءُ بِالمَوتِ إِنَّنا","سَنُخلي لَهُم مِن عَرصَةِ المَوتِ مَورِدا",16,"د",2,1],["لا يُشْبِهُ الْوَالِدُ مَوْلُودَهُ","مِنْهُمْ وَلا الْمَوْلُودَ مِنْهُمْ أَبُوهْ",17,"و",2,0],["لا يَشبَعونَ وَما يَزالُ طَعامُهُم","شَعباً أَشَلَّ وَأُمَّةً مِكسالا",18,"ل",2,0],["لا يَشتَكي ذُلَّ الهَوا","نِ وَلا يَمَنُّ إِذا وَفى",19,"ف",2,0],["لا يشرَحُ القوْمُ وحشيَّ الغريب لهُ","ولا يُسائِلُ عن تلك الأحاجيّ",20,"ي",1,0],["لا يَشغَلَنَّكَ غَيرُ ما","تَهوى فَكُلُّ العَيشِ فانِ",21,"ن",1,0],["لا يشتريها إلّا ابن زانيةٍ","أو قلبطان يكون مَن كانا",22,"ن",2,0],["لا يَشرَبُ الخَمرَ وَلَكِنَّهُ","يَأكُلُها أَكلَ اِمرِئٍ عادِ",23,"د",1,0],["لا يَشتَهي اللَيلَ مِن تَقَلُّبِهِ","ظَهراً لِبَطنٍ تَقَلُّبَ الصُرَدِ",24,"د",1,0],["لا يَشتَهي المَوتَ وَيُمنى بِهِ","كَرهاً وَطيبُ العَيشِ تَعذيبُ",25,"ب",1,0],["لا يَشعُرُ العودُ بِالنارِ الَّتي أَخَذَت","فيهِ وَلا الأَصهَبُ الداريُّ إِذ سُحِقا",26,"ق",2,0],["لا يَشْمَئِزُّ على اللِّسا","نِ وَلا يَشِذُّ عنِ القُلوبْ",27,"ب",1,0],["لاَ يَشْعُرُونَ بِأَنَّ تِلْكَ","منَ الْفوَادحِ في الْخَسَائرْ",28,"ر",1,0],["لا يَشمَتَنَّ الأعادي","فَلَيسَ بِالمَوتِ عارُ",29,"ر",1,0],["لاَ يَشمتَنَّ بها الأعْداءُ إِن رُزِئتْ","إنَّ الكُسُوفَ له في الشمس أَوْقاتُ",30,"ت",1,0],["لا يشتكي خصمه منه مواربة","أو تشتكي أُذناه فاحش الكلم",31,"م",1,0],["لا يشبه الناس: إحساسًا وعاطفة","ويشبه الناسَ: تركيبًا وأعضاء",32,"ا",2,0],["لا يشتكي مثلما يشكو الورى سقما","ولا يهاب رسول الموت إن جاء",32,"ا",2,0],["لا يشكُ عَصْرُكُمُو قماءةَ ثوبه","بل أَظْهروا العملاق في جلبابه",33,"ب",2,0],["لا يشمتوا ما في ختام","ك مغمز للشامتين",34,"ن",1,0],["لا يشهدُ المغنمَ إلا لكي","يقسِمَ في الغازين أنفالَهْ",35,"ل",2,0],["لا يُشمِت الحسَّادَ أنَّ مطالبي","عادت إلىَّ بصفقةِ المغبونِ",36,"ن",1,0],["لا يَشتَكونَ إِلَيكَ نائِبَةً سِوى","تَقصيرِهِم عَن شُكرِ هَذي الأَنعُمِ",37,"م",1,0],["لا يشرُفُ الرذلُ بأن يَكتسي","من الغِنى تاجاً وديباجا",38,"ج",2,1],["لا يشتكي إلا فراقكم فقد","أضناه حبكم فجودوا بالوفا",39,"ف",2,0],["لا يشتكي لسوى الدموع مصابه","وعذوله مما به لا يشتفي",40,"ي",1,0],["لا يشقَّنا أَربُ","نَحنُ كلنا عصبُ",41,"ب",1,1],["لا يَشْتكي من تَعَبٍ وجَاه","ولا تَنَدّى عَرَقاً جَنْباه",42,"ا",2,0],["لا يُشفِقُ الغازي على مَغزوِّه","بل يستخفُّ بحلفهِ وعدوِّهِ",43,"و",2,1],["لا يُشْتَكَى في عَصْرِهِ بِإِضَافَةٍ","وَلَهُ بِمَا يَسَعُ المُنَى إِطْلاقُ",44,"ق",1,0],["لا يَشْهَرَنَّ عَلَيَّ سَيْفُكُمُ","سَيْفاً بِهِ فِي الْحَقِّ لَمْ يَصُلِ",45,"ل",1,0],["لا يَشْتَكُونَ لَدَيْهِ الْمَحْلَ فِي سَنَةٍ","يَشْكُو بِها السَّغَبَ الْمَقْرِيُّ وَالقَارِي",46,"ر",2,0],["لا يشغل المشغول ان شغل بدا","والاجتماع به الزمان تكفلا",47,"ل",2,0],["لا يشبعانِ وَلا يُروى غليلهما","والعذبُ يُغري بإِفراطٍ وَإِلحاح",48,"ح",1,0],["لا يشغل الزوج المحبّ لزوجه","إلا الممات فانّه لا يُمهلُ",49,"ل",1,0],["لا يشبه العالم في ذاته","كذاك في وصف وأفعال",50,"ل",1,0],["لا يشمتُ الحسّاد موتك إنّه","كَأسٌ له كلّ الورى متجرّعُ",51,"ع",1,0],["لا يَشمتنَّ بموتِ ذا من بعدهِ","فَالموتُ منهُ بالنواصي يسفعُ",51,"ع",1,0],["لا يَشوب المطل في عدة","لا وَلا في القَول تَرديدُ",52,"د",1,0],["لا يُشهر السَيف في خطب يُحاولهُ","إِلّا عَلى وَقعة تَزهو بِها السَيرُ",53,"ر",1,0],["لا يَشتَفي الا بِسَبي بَناتِهِ","وَحُداتُها التَخويفُ وَالاِيعادُ",54,"د",1,0],["لا يَشين النَوال منه بِمُطلٍ","إِنَّ طوق العَطاء بِالمُطلِ غُلُّ",55,"ل",1,0],["لا يشوب الوصل بالصّدّ ويا","ربَّ إلفٍ لا يشوب الوصل بالصد",56,"د",1,0],["لا يُشفِق البخلاءُ من غضبي ولا","أرضَى بفضل عطيّةِ المتكرّمِ",57,"م",1,0],["لا يشرب الراحَ لأن تُسكِره","لكن لأن يجذُبها حسنَ الخُلُقْ",58,"ق",1,0],["لا يشمتنّ وإن أقام مؤخَّراً","لابدّ أن يقفوك ذاك المَصرعا",59,"ع",2,0],["لا يشتكيك وإن طال الجفاءُ به","إلّا إليك بإخفاءٍ وإظهارِ",60,"ر",1,0],["لا يَشينُ المجدَ المُنيفَ ولا يَنْ","قِصُ قدر الشَّريف في الأشْراف",61,"ف",1,0],["لا يشتهون وذي أنانية سوى","أنا ترى عميا مع البصراء",62,"ا",2,0],["لا يَشتَكونَ المَوتَ غَير تَغَمغُمٍ","حَكَّ الجِمالِ جُنوبَهُنَّ مِنَ الشَذا",63,"ا",1,0],["لا يشغلُ حيّزا في عهدهِ الجسدُ","وتكْتفيْ بالدعا الأمعاءُ والمَعِدُ",64,"د",1,0],["لا يشهَدون صلاةً","الا لمعنى التّقيه",65,"ي",2,0],["لا يُشكَرُ النادي ويعبَقُ طيبُه","إلّا إذا غنّى ثناهُ المُطرِبُ",66,"ب",1,0],["لا يشتكي بلد حلت به ظمأ","والركض يمطر من أعطافها عرقا",67,"ق",2,0],["لا يَشتَكي أَلَمَ السِنينَ وَلا يُرى","قَنِعاً بِمَكرُمَةٍ إِذا لَم يَزدَدِ",68,"د",1,0],["لا يَشتَكِ المَرْءُ غَدرَ البينِ مُتَّهِماً","إذ ليسَ بَينَهُما شيءٌ من الذِمَمِ",69,"م",1,0],["لا يَشْتَفِي مِنْهُ النَّظَرُ","لو ضربْتَهُ لَقَطَرْ",70,"ر",1,0],["لا يَشْغَلْنَكَ عن العُلاَ","خَوْدٌ تُمَنِّيْكَ الزِّيَارَهْ",71,"ر",2,0],["لا يَشْربُون سوى الدِّماءِ مُدامَةً","إِذ يَنْشَقُون من الأَسنَّة سَوْسَنَا",72,"ن",2,0]]}