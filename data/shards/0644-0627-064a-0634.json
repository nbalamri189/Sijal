",""],[6152,"الحب الصادق لا يبلى","https://www.poetsgate.com/ViewPoem.aspx?id=205870",""],[831,"ذكرى جلوسك مظهرُ الأوطانِ","https://diwany.org/%D8%B0%D9%83%D8%B1%D9%89-%D8%AC%D9%84%D9%88%D8%B3%D9%83-%D9%85%D8%B8%D9%87%D8%B1%D9%8F-%D8%A7%D9%84%D8%A3%D9%88%D8%B7%D8%A7%D9%86%D9%90/","الكامل"]],"verses":[["لا يَشْتَكي نَأْيَ مَسْراهُ أخو سَفَرٍ","تُدنِيهِ مِنهُمْ خُطا المَهْريَّةِ الذُلُلِ",0,"ل",1,0],["لا يَشرَبُ الخَمرَ إِلّا مَن لَهُ ذِمَمٌ","وَلا يَبيتُ لَهُ جارٌ عَلى وَجَلِ",1,"ل",1,0],["لا يشْمَتُ الأعْداءُ كونَكَ في الثّرى","فالموْتُ حُكْمٌ ليسَ يُخْشى عارُهُ",2,"ر",2,0],["لا يَشِحّونَ عَلى المالِ وَما","عُوُّدوا في الحَيِّ تَصرارا اللِقَح",3,"ح",1,0],["لا يَشتَكون المَوتَ إِن نَزَلَت بِهِم","شَهباءُ ذاتُ مَعاقِمٍ وَأُوارِ",4,"ر",1,0],["لا يَشهَدونَ نَجِيَّ القَومِ بَينَهُمُ","تُقضى الأُمورُ عَلى تَيمٍ وَما شَعَروا",5,"ر",3,0],["لا يشتكي ضيفٌ له كِظَّةً","لكنه يقتله الجوع",6,"ع",1,0],["لا يشتهي من مُهَفْهَفٍ جَيَداً","بل يشتهي من عُجارمٍ جَيَدَهْ",7,"د",2,0],["لا يشتكي الناسُ عنفهُ وكذا","لا تشتكي ضعفهُ ولا خوره",8,"ر",2,0],["لا يشتري المال بالثناء ولا","تظل تُفدي صِرارُه بِدَره",8,"ر",2,0],["لا يُشفق المستعيدُ نائله","من وشك إملاله وإعراضه",9,"ض",2,0],["لا يشتري الحمدَ بل يُعطي اللُّهى هِبةً","لا حمدَ للمشتري في الجُود بالثمنِ",10,"ن",1,0],["لا يَشهُرونَ عَلى مُخالِفِهِم","سَيفاً يَقومُ مَقامَهُ العَذَلُ",11,"ل",1,0],["لِأَيِّ شَيءٍ صَدَدتَ عَنّي","يا بائِناً بِالعَزاءِ مِنّي",12,"ن",2,1],["لا يَشرَبُ الماءَ إلا غَصَّ من حَذَرٍ","ولا يُهَوِّمُ إلا راعَهُ الحُلُمُ",13,"م",1,0],["لا يَشغَلَنَّكَ لَو وَلَيتَ عَنِ الَّذي","أَصبَحتَ فيهِ وَلا لَعَلَّ وَلا عَسى",14,"ا",1,0],["لا يشربُ الرّوحَ من جُثمانِ ذي زَردٍ","حَتَّى يَرى الحدّ مِنهُ يَأكلُ الزّرَدا",15,"د",2,0],["لا يَشمَتِ الأَعداءُ بِالمَوتِ إِنَّنا","سَنُخلي لَهُم مِن عَرصَةِ المَوتِ مَورِدا",16,"د",2,1],["لا يُشْبِهُ الْوَالِدُ مَوْلُودَهُ","مِنْهُمْ وَلا الْمَوْلُودَ مِنْهُمْ أَبُوهْ",17,"و",2,0],["لا يَشبَعونَ وَما يَزالُ طَعامُهُم","شَعباً أَشَلَّ وَأُمَّةً مِكسالا",18,"ل",2,0],["لا يَشتَكي ذُلَّ الهَوا","نِ وَلا يَمَنُّ إِذا وَفى",19,"ف",2,0],["لا يشرَحُ القوْمُ وحشيَّ الغريب لهُ","ولا يُسائِلُ عن تلك الأحاجيّ",20,"ي",1,0],["لا يَشغَلَنَّكَ غَيرُ ما","تَهوى فَكُلُّ العَيشِ فانِ",21,"ن",1,0],["لا يشتريها إلّا ابن زانيةٍ","أو قلبطان يكون مَن كانا",22,"ن",2,0],["لا يَشرَبُ الخَمرَ وَلَكِنَّهُ","يَأكُلُها أَكلَ اِمرِئٍ عادِ",23,"د",1,0],["لا يَشتَهي اللَيلَ مِن تَقَلُّبِهِ","ظَهراً لِبَطنٍ تَقَلُّبَ الصُرَدِ",24,"د",1,0],["لا يَشتَهي المَوتَ وَيُمنى بِهِ","كَرهاً وَطيبُ العَيشِ تَعذيبُ",25,"ب",1,0],["لا يَشعُرُ العودُ بِالنارِ الَّتي أَخَذَت","فيهِ وَلا الأَصهَبُ الداريُّ إِذ سُحِقا",26,"ق",2,0],["لا يَشْمَئِزُّ على اللِّسا","نِ وَلا يَشِذُّ عنِ القُلوبْ",27,"ب",1,0],["لاَ يَشْعُرُونَ بِأَنَّ تِلْكَ","منَ الْفوَادحِ في الْخَسَائرْ",28,"ر",1,0],["لا يَشمَتَنَّ الأعادي","فَلَيسَ بِالمَوتِ عارُ",29,"ر",1,0],["لاَ يَشمتَنَّ بها الأعْداءُ إِن رُزِئتْ","إنَّ الكُسُوفَ له في الشمس أَوْقاتُ",30,"ت",1,0],["لا يشتكي خصمه منه مواربة","أو تشتكي أُذناه فاحش الكلم",31,"م",1,0],["لا يشبه الناس: إحساسًا وعاطفة","ويشبه الناسَ: تركيبًا وأعضاء",32,"ا",2,0],["لا يشتكي مثلما يشكو الورى سقما","ولا يهاب رسول الموت إن جاء",32,"ا",2,0],["لا يشكُ عَصْرُكُمُو قماءةَ ثوبه","بل أَظْهروا العملاق في جلبابه",33,"ب",2,0],["لا يشرف اليوم بعقل مقتر","والسيد الأقعس من نال الغنى",34,"ا",1,0],["لا يشمتوا ما في ختام","ك مغمز للشامتين",35,"ن",1,0],["لا يشهدُ المغنمَ إلا لكي","يقسِمَ في الغازين أنفالَهْ",36,"ل",2,0],["لا يُشمِت الحسَّادَ أنَّ مطالبي","عادت إلىَّ بصفقةِ المغبونِ",37,"ن",1,0],["لا يَشتَكونَ إِلَيكَ نائِبَةً سِوى","تَقصيرِهِم عَن شُكرِ هَذي الأَنعُمِ",38,"م",1,0],["لا يشرُفُ الرذلُ بأن يَكتسي","من الغِنى تاجاً وديباجا",39,"ج",2,1],["لا يشتكي إلا فراقكم فقد","أضناه حبكم فجودوا بالوفا",40,"ف",2,0],["لا يشتكي لسوى الدموع مصابه","وعذوله مما به لا يشتفي",41,"ف",2,0],["لا يشقَّنا أَربُ","نَحنُ كلنا عصبُ",42,"ب",1,1],["لا يَشْتكي من تَعَبٍ وجَاه","ولا تَنَدّى عَرَقاً جَنْباه",43,"ا",2,0],["لا يُشفِقُ الغازي على مَغزوِّه","بل يستخفُّ بحلفهِ وعدوِّهِ",44,"و",2,1],["لا يُشْتَكَى في عَصْرِهِ بِإِضَافَةٍ","وَلَهُ بِمَا يَسَعُ المُنَى إِطْلاقُ",45,"ق",1,0],["لا يَشْهَرَنَّ عَلَيَّ سَيْفُكُمُ","سَيْفاً بِهِ فِي الْحَقِّ لَمْ يَصُلِ",46,"ل",1,0],["لا يَشْتَكُونَ لَدَيْهِ الْمَحْلَ فِي سَنَةٍ","يَشْكُو بِها السَّغَبَ الْمَقْرِيُّ وَالقَارِي",47,"ر",2,0],["لا يشغل المشغول ان شغل بدا","والاجتماع به الزمان تكفلا",48,"ل",2,0],["لا يشبعانِ وَلا يُروى غليلهما","والعذبُ يُغري بإِفراطٍ وَإِلحاح",49,"ح",1,0],["لا يشغل الزوج المحبّ لزوجه","إلا الممات فانّه لا يُمهلُ",50,"ل",1,0],["لا يشبه العالم في ذاته","كذاك في وصف وأفعال",51,"ل",1,0],["لا يشمتُ الحسّاد موتك إنّه","كَأسٌ له كلّ الورى متجرّعُ",52,"ع",1,0],["لا يَشمتنَّ بموتِ ذا من بعدهِ","فَالموتُ منهُ بالنواصي يسفعُ",52,"ع",1,0],["لا يَشوب المطل في عدة","لا وَلا في القَول تَرديدُ",53,"د",1,0],["لا يُشهر السَيف في خطب يُحاولهُ","إِلّا عَلى وَقعة تَزهو بِها السَيرُ",54,"ر",1,0],["لا يَشتَفي الا بِسَبي بَناتِهِ","وَحُداتُها التَخويفُ وَالاِيعادُ",55,"د",1,0],["لا يَشين النَوال منه بِمُطلٍ","إِنَّ طوق العَطاء بِالمُطلِ غُلُّ",56,"ل",1,0],["لا يشوب الوصل بالصّدّ ويا","ربَّ إلفٍ لا يشوب الوصل بالصد",57,"د",1,0],["لا يُشفِق البخلاءُ من غضبي ولا","أرضَى بفضل عطيّةِ المتكرّمِ",58,"م",1,0],["لا يشرب الراحَ لأن تُسكِره","لكن لأن يجذُبها حسنَ الخُلُقْ",59,"ق",1,0],["لا يشمتنّ وإن أقام مؤخَّراً","لابدّ أن يقفوك ذاك المَصرعا",60,"ع",2,0],["لا يشتكيك وإن طال الجفاءُ به","إلّا إليك بإخفاءٍ وإظهارِ",61,"ر",1,0],["لا يَشينُ المجدَ المُنيفَ ولا يَنْ","قِصُ قدر الشَّريف في الأشْراف",62,"ف",1,0],["لا يشتهون وذي أنانية سوى","أنا ترى عميا مع البصراء",63,"ا",2,0],["لا يَشتَكونَ المَوتَ غَير تَغَمغُمٍ","حَكَّ الجِمالِ جُنوبَهُنَّ مِنَ الشَذا",64,"ا",1,0],["لا يشغلُ حيّزا في عهدهِ الجسدُ","وتكْتفيْ بالدعا الأمعاءُ والمَعِدُ",65,"د",1,0],["لا يشهَدون صلاةً","الا لمعنى التّقيه",66,"ي",2,0],["لا يُشكَرُ النادي ويعبَقُ طيبُه","إلّا إذا غنّى ثناهُ المُطرِبُ",67,"ب",1,0],["لا يشتكي بلد حلت به ظمأ","والركض يمطر من أعطافها عرقا",68,"ق",2,0],["لا يَشتَكي أَلَمَ السِنينَ وَلا يُرى","قَنِعاً بِمَكرُمَةٍ إِذا لَم يَزدَدِ",69,"د",1,0],["لا يَشتَكِ المَرْءُ غَدرَ البينِ