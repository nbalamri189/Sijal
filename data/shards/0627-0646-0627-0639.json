{"poems":[[53,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[63,"ولوعة بت أخفيها وأظهرها","https://www.aldiwan.net/poem45795.html","البسيط"],[57,"يالهف نفسي على مال أفرقه","https://www.aldiwan.net/poem24720.html","البسيط"],[77,"جزيت ياابن رسول الله أفضل ما","https://www.aldiwan.net/poem36397.html","البسيط"],[77,"لم أعد الحسام من أدواتي","https://www.aldiwan.net/poem36685.html","الخفيف"],[73,"أقدم كما قدم الربيع الباكر","https://www.aldiwan.net/poem11942.html","الكامل"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[88,"قل للحجابيين كيف ترونكم","https://www.aldiwan.net/poem44838.html","الكامل"],[72,"أناعسة الأجفان أسهرت مكمدا","https://www.aldiwan.net/poem18553.html","الطويل"],[72,"يا عذولي خلني أغنم عمري","https://www.aldiwan.net/poem18701.html","الرمل"],[72,"قف بباب العلا وقل يا كتابي","https://www.aldiwan.net/poem19408.html","الخفيف"],[64,"قل لمن يبكي علينا حزنا","https://www.aldiwan.net/poem67542.html","الرمل"],[64,"يا سر سر يدق حتى","https://www.aldiwan.net/poem67589.html","مخلع البسيط"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"بات يدعو الواحدا الصمدا","https://www.aldiwan.net/poem61930.html","المديد"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[91,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"لكم الروح والبدن","https://www.aldiwan.net/poem42443.html","مجزوء الخفيف"],[78,"مولاي ياذا الأيادي","https://www.aldiwan.net/poem14064.html","المجتث"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[89,"انا في خضم ثائر عجاج","https://www.aldiwan.net/poem44777.html","الكامل"],[89,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[89,"انت ما ان تخففين مصابي","https://www.aldiwan.net/poem44901.html","الخفيف"],[43,"أنا عين المسود الجحجاح","https://www.aldiwan.net/poem9521.html","الخفيف"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[62,"مولاي أكرم من ألوذ بظله","https://www.aldiwan.net/poem52461.html","الكامل"],[45,"صبابة راح عنها غير مزجور","https://www.aldiwan.net/poem63640.html","البسيط"],[45,"أخذت جعفر برأس القطار","https://www.aldiwan.net/poem64526.html","الخفيف"],[45,"وقريب المزار نائي النوال","https://www.aldiwan.net/poem65645.html","الخفيف"],[58,"ضربته بالسيف فوق الهامه","https://www.aldiwan.net/poem30871.html","الرجز"],[58,"أنا علي فاسألوني تخبروا","https://www.aldiwan.net/poem31062.html","الرجز"],[58,"أنا علي وابن عبد المطلب","https://www.aldiwan.net/poem31156.html","الرجز"],[58,"أنا علي وابن عبد المطلب مهذب","https://www.aldiwan.net/poem31159.html","الرجز"],[49,"أصبح هذا الناس قالا وقيل","https://www.aldiwan.net/poem63055.html","السريع"],[49,"قال لي أحمد ولم يدر ما بي","https://www.aldiwan.net/poem64248.html","الخفيف"],[66,"خدمتي في الهوى عليكم حرام","https://www.aldiwan.net/poem38794.html","الخفيف"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[44,"يا مغرس الظرف وفرع الحسب","https://www.aldiwan.net/poem30569.html","الطويل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[52,"صد عني تبرما وتملا","https://www.aldiwan.net/poem26736.html","الخفيف"],[75,"زهر الروض بنت دمع الغمام","https://www.aldiwan.net/poem69020.html","الخفيف"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[46,"عجبا للقطا من الكدر والجو","https://www.aldiwan.net/poem23274.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85830","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85342","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85483","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85447","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140823",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147601",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"العلم والتاج","https://www.poetsgate.com/ViewPoem.aspx?id=179548",""],[106,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[90,"رثاء شيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=178927",""],[45,"وقَريبِ المزَارِ نَائِي النَّوَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=31813",""],[45,"أخذت جعفر برأس القطار","https://www.poetsgate.com/ViewPoem.aspx?id=31209",""],[45,"صبابة راح عنها غير مزجور","https://www.poetsgate.com/ViewPoem.aspx?id=31200",""],[101,"يا نَسْمَة ً رنّحتْ أعطافَ وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62435&r=&rc=27",""]],"verses":[["أَنا عَبدُ أَنعُمِكَ الَّتي نَشَطَت","أَمَلي وَأَنهَضَ عِزُّها مُنَني",0,"ي",1,0],["أَنا عَرَّضتُ فُؤادي","أَوَّلُ الحَربِ كَلامُ",1,"م",1,0],["إِنَّ أَعداءَكَ لَمّا","قادَهُم ذاكَ الزِمامُ",1,"م",1,0],["إِن أَعرَضَت وَنأَتْ أَو أَقبَلَتْ وَدَنَتْ","فَهيَ المُنى وَالهَوى النَجديُّ مِن شيَمِي",2,"ي",1,0],["إِنَّ اِعتِذاري إِلى مَن جاءَ يَسأَلُني","ما لَيسَ عِندي لَمِن إِحدى المُصيباتِ",3,"ت",1,0],["إَنْ أَعْجَزَ الشُّكْرُ مِنِّي مِنَّةً ضَعُفَتْ","عَنْ بَعْضِ حَقِّكَ شُكْرُ اللَّهِ مَا عَجَزَا",4,"ز",2,0],["أنَا عَبْدٌ أقامَ مَوْلايَ شَكْلي","لمْ أكُنْ أسْتَحِقُّ شَيئاً بِذاتي",5,"ي",1,0],["إِن أَعنَتَ الجِسمَ المُكَرَّمَ وَعكُها","فَلَرُبَّما وُعِكَ الهِزَبرُ الخادِرُ",6,"ر",1,0],["إِنْ أُعْظِمَتْ تِلْكَ الشَّمَائِلُ وَالنُّهَى","فَلأَي شَيْءٍ غَيْرِهَا الإِعْظَامُ",7,"م",1,0],["إِنَّا عَرفْنَاكَ أَنْتَ الْيَوْمَ قَائِدُهُمْ","وَكُلُّ آيَاتِكَ الكُبْرَى لَهُمْ خَدَمُ",8,"م",1,0],["أن أعتزالكم النساء ترفُّعاً","أمر يناقض حكمة التكوين",9,"ن",1,0],["أناعسةَ الأجفانِ أسهرتِ مكمدا","عسى تكحلي عينيه بالخصر مرودا",10,"د",2,1],["أنا عذْريّ الهوى لكنَّ لي","ثقةً بالعفو تجلو وجه عذري",11,"ي",1,0],["إنَّ أعداءَك والأنعام في","حالةِ فاجمعهما في يوم نحر",11,"ر",1,0],["أنا عبدٌ مكاتبٌ غير أني","لستُ أخشى من مالكِ الرقّ عتقا",12,"ق",2,0],["أَنا عُصفورٌ وَهَذا قَفَصي","كانَ سِجني وَقَميصي كَفَنا",13,"ن",2,0],["إِن اِعتِذاري إِلَيكَ جَهلٌ","وَعُظمُ شَكٍّ وَفَرطُ عَيِّ",14,"ي",1,0],["أَنا عِندي مَحوُ ذاتي","مَن أَجَلَّ المَكرُماتِ",15,"ت",1,0],["أنا عارٍ من كلِّ شيء سوى فَضْ","لكَ لا زلت كِسوةً وغِطاءَ",16,"ا",2,0],["أنا عبدُ الإنصاف قِرْنُ التَّعدِّي","فاسْلكِ القَصْدَ بي وَعدِّ العَداءَ",16,"ا",2,0],["أنا عبدٌ غرّني أملي","وكأنَّ الموتَ قد وردا",17,"د",2,0],["أنا عبدٌ عدوتُ طوري وأصبح","تُ كأني لا أعرفُ الإقلالا",18,"ل",2,0],["أنا عبدُ الحق لا عبدُ الهوى","لعن اللَّهُ الهوى فيما لعن",19,"ن",1,0],["إِنّا عَرَفنا فيكَ ذا كَرَمٍ","ما إِن عَرَفنا فيكَ مُقتَصِدا",20,"د",2,0],["أَناً عَلى قِمَم وَآ","ناً في كُهوفٍ كَالقُبورِ",21,"ر",1,0],["آناً عَلى جَبَلٍ مَكينٍ راسِخٍ","راس وَآناً فَوقَ جُرفٍ هارِ",22,"ر",1,0],["أَنا عَليمٌ حَيثُ لا عالِمٌ","أَنا لَبيبٌ عِندَ غَيرِ اللَبيب",23,"ب",1,0],["أَنا عَبدٌ شَرَيتُمو","هُ وَلَكِن بِلا ثَمَن",24,"ن",1,0],["أَنا عُبَيدٌ مُعَدّ","لِحَسمِ داءِ الأَعادي",25,"د",2,0],["انا على ما اصيب المسلمون به","لآسفون وان لم ينفع الاسف",26,"ف",1,0],["انا عندما ارسلت فيه زورقي","ما كان هذا السبح في منهاجي",27,"ي",1,0],["انا على جرف من الاخطار","ينتظر انهيارا",28,"ر",2,0],["انا عنه محدّث وهو عني","وكلانا في القول غير محاب",29,"ب",1,0],["أَنا عَينُ المُسَوَّدِ الجَحجاحِ","هَيَّجَتني كِلابُكُم بِالنُباحِ",30,"ح",1,1],["إِن أَعشَبَت رَوضَةٌ رَعَيناها","أَو ذُكِرَت حِلَّةٌ غَزَوناها",31,"ا",3,0],["أنا عند مخدومي بأفضلِ حالةٍ","في خيرِ مغدىً عندَهُ ومَرَاحِ",32,"ح",1,0],["إِن أَعجَزَ القَومَ حَملُ الحَقِّ قامَ بِهِ","ثَبتَ المَقامِ جَهيراً غَيرَ مَغمورِ",33,"ر",1,0],["أَنا عَبدُ اللَهِ الصَفّارُ إِن فَر","رَجَ اللَهُ هُمومَ القُلوبِ بِالصَفّارِ",34,"ر",1,0],["أَنا عَبدٌ لِمَن هَويتُ وَلَكِن","ما اِحتِيالي مِن سوءِ رَأيِ الوالي",35,"ل",2,0],["أَنا عَليٌّ صاحِبُ الصَمامَه","وَصاحِبُ الحَوضِ لَدى القِيامَه",36,"م",2,0],["أَنا عَلِيٌّ فَاِسأَلوني تُخبَروا","ثُمَ اِبرُزوا إِلى الوَغى أَو أَدبِروا",37,"ر",3,1],["أَنا عَلِيٌّ وَاِبنُ عَبدِ المُطَّلِب","مَهَذَّبٌ ذو سَطوَةٍ وَذو حَسَب",38,"ب",1,1],["أَنا عَلِيٌّ وَاِبنُ عَبدِ المُطَّلِب","مُهَذَّبٌ ذُو سَطوَةٍ وَذو غَضَب",39,"ب",1,1],["إِنّا عَلى ذاكَ لَفي غَفلَةٍ","وَالمَوتُ يُفني الخَلقَ جيلاً فَجيل",40,"ل",1,0],["أَنا عَبدٌ لَها مُقِرٌّ وَما تَم","لِكُ لي غَيرُها مِنَ الناسِ رِقّا",41,"ق",2,0],["أَنا عَبدٌ لَدَيكُمُ وَنَزيلٌ","وَلِهَذَينِ حُرمَةٌ وَذِمامُ",42,"م",1,0],["أَنا عَبدُ أَنعُمِكَ القَديمُ وِدادُهُ","وَسِوايَ في أَقوالِهِ يَتَمَلَّقُ",43,"ق",1,0],["إِنّا عَهِدناكَ أَخا عِلَّةٍ","بِالأَمسِ نالَتكَ بِبَعضِ الوَصَب",44,"ب",1,0],["إنّا عَرضناهُ لِيصدعَ قومُنا","سِترَ الخفاءِ وغيهَبَ الإشكالِ",45,"ل",1,0],["أَنا عَبدٌ لِسَيِّدٍ لِيَ جافٍ","كُلَّما رُمتُ وَصلَهُ زادَ بُخلا",46,"ل",2,0],["أنا عبدٌ متيّمٌ غير أنّي","واثق بالكريمِ نجلِ الكرام",47,"م",1,0],["أنا عَينُ المُقِرِّ بالفضلِ إنْ أنْ","كَرَ قومٌ صنائعَ المعروف",48,"ف",1,0],["إِنَّ إِعراضَكِ مِن تَبليغِنا","أَسخَطَ القَلبَ وَأَوهى الكَبِدا",49,"د",2,0],["إِنَّ أَعمارَنا كَآيٍ أُبينَت","وَالمَنايا لَهُنَّ مِثلُ الفَواصِل",50,"ل",1,0],["إن أعدائي في العراق كثير","كلهم فيه آخذ بخناقي",51,"ي",1,0],["إن اعتقاد المسلمين","من التعاسة بالقدر",52,"ر",1,1],["أَنا عَذراء لَم تمس عفافي","يَد باغ فصن عفاف العَذارى",53,"ر",2,0],["إن اعتدالك في الأمور لمصلح","ما أَفسد الإفراط وَالتَفريط",54,"ط",1,0],["إن أَعمالكم لعمري ساءَت","يعرباً في ضريحه وَنزارا",55,"ر",2,0],["إنَّ اِعتماد الأكثري","نَ عَلى الحَياة من الغرور",56,"ر",1,0],["أنا عاتبٌ لتعتبك","متعجبٌ لتعجبك",57,"ك",1,1],["إن أعط بعض القوت أع","لم أن ذلك ضعف حقي",58,"ي",1,0],["أنا عزمي من آل صخرٍ ورأسي","لقي الويلَ من بني شَيْبانه",59,"ن",2,0],["إنّا على العهدِ لا بعدٌ يحوِّلنا","عن الودادِن ولا الأيامُ تُنْسينا",60,"ن",2,0],["إنا عهدنا الرشدَ فيه سجيةً","ما كان في يوم عليه دخيلا",61,"ل",2,0],["إنا عهدنا المُلكَ يبسط كفه","للعلم قبل اليوم بالإعطاء",62,"ا",2,0],["أنا عن بني حواءَ أع","لنتُ الفرار من المجال",63,"ل",1,0],["إنا على اسم الله سرنا، نقتفي","مَلكَا موفقةً خطاه رشيدا",64,"د",2,0],["إن أعقَبتْ وائلٌ سحبانَ، كان لَها","من بينهم ألفُ سحبانٍ وسحبانُ",65,"ن",1,0],["أنا عيه خفض ، فالشريعة تعتزي","إلى شيخها فانظر لما أنت ذاكره",66,"ر",2,0],["أَنَا عَبْدٌ لِمَنْ هَوِيتُ ، ولكِنْ","مَا احْتِيالي /ِنْ سُوءِ رأَي الْوَألي",67,"ل",2,0],["أنا عبد الله الصفار إن فر","ج الله هموم القلوب بالصفار",68,"ر",1,0],["إن أعجز القوم حمل الحق قام به","ثبت المقام جهيراً غير معمور",69,"ر",1,0],["إنّا على العهدِ لابُعدٌ يحوِّلنا","عن الودادِ ولا الأيامُ تُنْسينا",70,"ن",2,0]]}