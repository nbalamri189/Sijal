لي كن مع الأنام وداري","https://www.aldiwan.net/poem34545.html","الخفيف"],[556,"سق مطاياك بالحدا يا حادي","https://www.aldiwan.net/poem34596.html","الخفيف"],[556,"إن أعياننا ثوابت في العل","https://www.aldiwan.net/poem34641.html","الخفيف"],[556,"إن الوجود بموجوداته امتزجا","https://www.aldiwan.net/poem34689.html","البسيط"],[556,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[556,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[560,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[560,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"],[560,"عنوان كل مديح راسخ القدم","https://www.aldiwan.net/poem52884.html","البسيط"],[561,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[573,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[573,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[585,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["أَنا عَبدُ أَنعُمِكَ الَّتي نَشَطَت","أَمَلي وَأَنهَضَ عِزُّها مُنَني",0,"ي",1,0],["أَنا عَرَّضتُ فُؤادي","أَوَّلُ الحَربِ كَلامُ",1,"م",1,0],["إِنَّ أَعداءَكَ لَمّا","قادَهُم ذاكَ الزِمامُ",1,"م",1,0],["إِن أَعرَضَت وَنأَتْ أَو أَقبَلَتْ وَدَنَتْ","فَهيَ المُنى وَالهَوى النَجديُّ مِن شيَمِي",2,"ي",1,0],["إِنَّ اِعتِذاري إِلى مَن جاءَ يَسأَلُني","ما لَيسَ عِندي لَمِن إِحدى المُصيباتِ",3,"ت",1,0],["إَنْ أَعْجَزَ الشُّكْرُ مِنِّي مِنَّةً ضَعُفَتْ","عَنْ بَعْضِ حَقِّكَ شُكْرُ اللَّهِ مَا عَجَزَا",4,"ز",2,0],["أنَا عَبْدٌ أقامَ مَوْلايَ شَكْلي","لمْ أكُنْ أسْتَحِقُّ شَيئاً بِذاتي",5,"ي",1,0],["إِن أَعنَتَ الجِسمَ المُكَرَّمَ وَعكُها","فَلَرُبَّما وُعِكَ الهِزَبرُ الخادِرُ",6,"ر",1,0],["إِنْ أُعْظِمَتْ تِلْكَ الشَّمَائِلُ وَالنُّهَى","فَلأَي شَيْءٍ غَيْرِهَا الإِعْظَامُ",7,"م",1,0],["إِنَّا عَرفْنَاكَ أَنْتَ الْيَوْمَ قَائِدُهُمْ","وَكُلُّ آيَاتِكَ الكُبْرَى لَهُمْ خَدَمُ",8,"م",1,0],["أن أعتزالكم النساء ترفُّعاً","أمر يناقض حكمة التكوين",9,"ن",1,0],["أناعسةَ الأجفانِ أسهرتِ مكمدا","عسى تكحلي عينيه بالخصر مرودا",10,"د",2,1],["أنا عذْريّ الهوى لكنَّ لي","ثقةً بالعفو تجلو وجه عذري",11,"ي",1,0],["إنَّ أعداءَك والأنعام في","حالةِ فاجمعهما في يوم نحر",11,"ر",1,0],["أنا عبدٌ مكاتبٌ غير أني","لستُ أخشى من مالكِ الرقّ عتقا",12,"ق",2,0],["أَنا عُصفورٌ وَهَذا قَفَصي","كانَ سِجني وَقَميصي كَفَنا",13,"ن",2,0],["إِن اِعتِذاري إِلَيكَ جَهلٌ","وَعُظمُ شَكٍّ وَفَرطُ عَيِّ",14,"ي",1,0],["أَنا عِندي مَحوُ ذاتي","مَن أَجَلَّ المَكرُماتِ",15,"ت",1,0],["أنا عارٍ من كلِّ شيء سوى فَضْ","لكَ لا زلت كِسوةً وغِطاءَ",16,"ا",2,0],["أنا عبدُ الإنصاف قِرْنُ التَّعدِّي","فاسْلكِ القَصْدَ بي وَعدِّ العَداءَ",16,"ا",2,0],["أنا عبدٌ غرّني أملي","وكأنَّ الموتَ قد وردا",17,"د",2,0],["أنا عبدٌ عدوتُ طوري وأصبح","تُ كأني لا أعرفُ الإقلالا",18,"ل",2,0],["أنا عبدُ الحق لا عبدُ الهوى","لعن اللَّهُ الهوى فيما لعن",19,"ن",1,0],["إِنّا عَرَفنا فيكَ ذا كَرَمٍ","ما إِن عَرَفنا فيكَ مُقتَصِدا",20,"د",2,0],["أَناً عَلى قِمَم وَآ","ناً في كُهوفٍ كَالقُبورِ",21,"ر",1,0],["آناً عَلى جَبَلٍ مَكينٍ راسِخٍ","راس وَآناً فَوقَ جُرفٍ هارِ",22,"ر",1,0],["أَنا عَليمٌ حَيثُ لا عالِمٌ","أَنا لَبيبٌ عِندَ غَيرِ اللَبيب",23,"ب",1,0],["أَنا عَبدٌ شَرَيتُمو","هُ وَلَكِن بِلا ثَمَن",24,"ن",1,0],["أَنا عُبَيدٌ مُعَدّ","لِحَسمِ داءِ الأَعادي",25,"د",2,0],["انا على ما اصيب المسلمون به","لآسفون وان لم ينفع الاسف",26,"ف",1,0],["انا عندما ارسلت فيه زورقي","ما كان هذا السبح في منهاجي",27,"ي",1,0],["انا على جرف من الاخطار","ينتظر انهيارا",28,"ر",2,0],["انا عنه محدّث وهو عني","وكلانا في القول غير محاب",29,"ب",1,0],["أَنا عَينُ المُسَوَّدِ الجَحجاحِ","هَيَّجَتني كِلابُكُم بِالنُباحِ",30,"ح",1,1],["إِن أَعشَبَت رَوضَةٌ رَعَيناها","أَو ذُكِرَت حِلَّةٌ غَزَوناها",31,"ا",3,0],["أنا عند مخدومي بأفضلِ حالةٍ","في خيرِ مغدىً عندَهُ ومَرَاحِ",32,"ح",1,0],["إِن أَعجَزَ القَومَ حَملُ الحَقِّ قامَ بِهِ","ثَبتَ المَقامِ جَهيراً غَيرَ مَغمورِ",33,"ر",1,0],["أَنا عَبدُ اللَهِ الصَفّارُ إِن فَر","رَجَ اللَهُ هُمومَ القُلوبِ بِالصَفّارِ",34,"ر",1,0],["أَنا عَبدٌ لِمَن هَويتُ وَلَكِن","ما اِحتِيالي مِن سوءِ رَأيِ الوالي",35,"ل",2,0],["أَنا عَليٌّ صاحِبُ الصَمامَه","وَصاحِبُ الحَوضِ لَدى القِيامَه",36,"م",2,0],["أَنا عَلِيٌّ فَاِسأَلوني تُخبَروا","ثُمَ اِبرُزوا إِلى الوَغى أَو أَدبِروا",37,"ر",3,1],["أَنا عَلِيٌّ وَاِبنُ عَبدِ المُطَّلِب","مَهَذَّبٌ ذو سَطوَةٍ وَذو حَسَب",38,"ب",1,1],["أَنا عَلِيٌّ وَاِبنُ عَبدِ المُطَّلِب","مُهَذَّبٌ ذُو سَطوَةٍ وَذو غَضَب",39,"ب",1,1],["إِنّا عَلى ذاكَ لَفي غَفلَةٍ","وَالمَوتُ يُفني الخَلقَ جيلاً فَجيل",40,"ل",1,0],["أَنا عَبدٌ لَها مُقِرٌّ وَما تَم","لِكُ لي غَيرُها مِنَ الناسِ رِقّا",41,"ق",2,0],["أَنا عَبدٌ لَدَيكُمُ وَنَزيلٌ","وَلِهَذَينِ حُرمَةٌ وَذِمامُ",42,"م",1,0],["أَنا عَبدُ أَنعُمِكَ القَديمُ وِدادُهُ","وَسِوايَ في أَقوالِهِ يَتَمَلَّقُ",43,"ق",1,0],["إِنّا عَهِدناكَ أَخا عِلَّةٍ","بِالأَمسِ نالَتكَ بِبَعضِ الوَصَب",44,"ب",1,0],["إنّا عَرضناهُ لِيصدعَ قومُنا","سِترَ الخفاءِ وغيهَبَ الإشكالِ",45,"ل",1,0],["أَنا عَبدٌ لِسَيِّدٍ لِيَ جافٍ","كُلَّما رُمتُ وَصلَهُ زادَ بُخلا",46,"ل",2,0],["أنا عبدٌ متيّمٌ غير أنّي","واثق بالكريمِ نجلِ الكرام",47,"م",1,0],["أنا عَينُ المُقِرِّ بالفضلِ إنْ أنْ","كَرَ قومٌ صنائعَ المعروف",48,"ف",1,0],["إِنَّ إِعراضَكِ مِن تَبليغِنا","أَسخَطَ القَلبَ وَأَوهى الكَبِدا",49,"د",2,0],["إِنَّ أَعمارَنا كَآيٍ أُبينَت","وَالمَنايا لَهُنَّ مِثلُ الفَواصِل",50,"ل",1,0],["إن أعدائي في العراق كثير","كلهم فيه آخذ بخناقي",51,"ي",1,0],["إن اعتقاد المسلمين","من التعاسة بالقدر",52,"ر",1,1],["أَنا عَذراء لَم تمس عفافي","يَد باغ فصن عفاف العَذارى",53,"ر",2,0],["إن اعتدالك في الأمور لمصلح","ما أَفسد الإفراط وَالتَفريط",54,"ط",1,0],["إن أَعمالكم لعمري ساءَت","يعرباً في ضريحه وَنزارا",55,"ر",2,0],["إنَّ اِعتماد الأكثري","نَ عَلى الحَياة من الغرور",56,"ر",1,0],["أنا عاتبٌ لتعتبك","متعجبٌ لتعجبك",57,"ك",1,1],["إن أعط بعض القوت أع","لم أن ذلك ضعف حقي",58,"ي",1,0],["أنا عزمي من آل صخرٍ ورأسي","لقي الويلَ من بني شَيْبانه",59,"ن",2,0],["إنّا على العهدِ لا بعدٌ يحوِّلنا","عن الودادِن ولا الأيامُ تُنْسين