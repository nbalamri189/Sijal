{"poems":[[63,"أقول لصحبي حين كررت نظرة","https://www.aldiwan.net/poem45711.html","الطويل"],[63,"هي العيس مبتذرات الخطا","https://www.aldiwan.net/poem46132.html","المتقارب"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[27,"زار الفرزدق أهل الحجاز","https://www.aldiwan.net/poem5718.html","المتقارب"],[27,"أتجعل يا ابن القين أولاد دارم","https://www.aldiwan.net/poem5804.html","الطويل"],[27,"بت أرائي صاحبي تجلدا","https://www.aldiwan.net/poem5936.html","الطويل"],[4,"بلينا وما تبلى النجوم الطوالع","https://www.aldiwan.net/poem21175.html","الطويل"],[37,"أتجعلنا قيس لكلب بضاعة","https://www.aldiwan.net/poem7419.html","الطويل"],[37,"أتجعلنا جسرا لكلب قضاعة","https://www.aldiwan.net/poem7606.html","الطويل"],[47,"وراءك يانمير فلا أمام","https://www.aldiwan.net/poem25152.html","الوافر"],[23,"تطاول بالخمان ليلي فلم تكد","https://www.aldiwan.net/poem21259.html","الطويل"],[51,"وما الحسب الموروث لا در دره","https://www.aldiwan.net/poem8157.html","الطويل"],[51,"دريرة تجلب الطربا","https://www.aldiwan.net/poem8292.html","الهزج"],[51,"لتعط الولاية من فضلها","https://www.aldiwan.net/poem66005.html","المتقارب"],[14,"أتجعل إقدامي إذا الخيل أحجمت","https://www.aldiwan.net/poem38295.html","الطويل"],[85,"أريد سلوكم والقلب يأبى","https://www.aldiwan.net/poem63680.html","الوافر"],[45,"أعجب لظلم زماننا المتواتر","https://www.aldiwan.net/poem63592.html","الكامل"],[49,"أتجمع مالا لا تقدم بعضه","https://www.aldiwan.net/poem62147.html","الطويل"],[49,"يا صاحبي رحلي لا تكثرا","https://www.aldiwan.net/poem64297.html","السريع"],[66,"تنزه عتبي عن خطاك صواب","https://www.aldiwan.net/poem39643.html","الطويل"],[97,"قل تمهل واصطبر","https://www.aldiwan.net/poem24411.html","مجزوء الرمل"],[31,"يا قلب أخبرني وفي النأي راحة","https://www.aldiwan.net/poem42246.html","الطويل"],[48,"غنيت عن الكواعب بالغلام","https://www.aldiwan.net/poem65250.html","الوافر"],[48,"ألا قل يلحي على حب شاطر","https://www.aldiwan.net/poem66545.html","الطويل"],[50,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[46,"تعالى الله ما تلقى المطايا","https://www.aldiwan.net/poem22410.html","الوافر"],[46,"خوى دن شرب فاستحابوا إلى التقى","https://www.aldiwan.net/poem22453.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[104,"يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=37408",""],[51,"لتعطِ الولاية من فضلها","https://www.poetsgate.com/ViewPoem.aspx?id=30301",""],[39,"أتجعلنَا إلى شمجَى بنِ جرمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=4312",""],[115,"عليك دهراً سلام الله يا عمر","https://www.aldiwan.net/poem41099.html","عموديه"],[204,"أتجرؤ في تلبيس ذكرك في ذكري","https://www.aldiwan.net/poem53145.html","الطويل"],[207,"أراني كلما قاربت قومي","https://www.aldiwan.net/poem27975.html","الوافر"],[223,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[235,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[252,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[275,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[297,"يا دار مية باللوى فالأجرع","https://www.aldiwan.net/poem33225.html","الكامل"],[371,"أتجفوني وطيفك ليس يجفو","https://www.aldiwan.net/poem57309.html","الوافر"],[452,"أيا مهديا در القريض المنظما","https://www.aldiwan.net/poem13900.html","الطويل"],[564,"اهجر معنى القلب عندك جائز","https://www.aldiwan.net/poem856.html",""],[580,"أتجحد ما في الريح من أنة الحزن","https://www.aldiwan.net/poem25195.html","عموديه"]],"verses":[["أَتَجزَعُ أَن تَلقَى مِنَ الدَّهرِ نَبوَةً","بِها وَلَها نَفسي وَأَهلي وَمالُها",0,"ل",3,0],["أتَجْزَعُ للبَيْنِ أم تَرْعَوي","إِلى جَلَدٍ أسْأَرَتْهُ النّوى",1,"ا",1,0],["أتَجزعين ابتئاساً بين أظهرنا","وكلّنا عنك للبأساء حمّال",2,"ل",1,0],["أَتَجعَلُ ذا الكيرِ مِن مالِكٍ","وَأَينَ سُهَيلٌ مِنَ الفَرقَدِ",3,"د",1,0],["أَتَجعَلُ يا اِبنَ القَينِ أَولادَ دارِمٍ","كَشَيبانَ شَلَّت مِن يَدَيكَ الأَصابِعُ",4,"ع",1,1],["أَتَجمَعُ قَلباً بِالعِراقِ فَريقُهُ","وَمِنهُ بِأَظلالِ الأَراكِ فَريقُ",5,"ق",1,0],["أَتَجزَعُ مِمّا أَحدَثَ الدَهرُ بِالفَتى","وَأَيُّ كَريمٍ لَم تُصِبهُ القَوارِعُ",6,"ع",1,0],["أتجعلنا قيس لكلبٍ بضاعةً","ولست بِنسيٍ في مَعدٍّ ولا دَخل",7,"ل",1,1],["أتجعلنا جسراً لكلب قضاعة","وليست بنسي مَعَدٍّ ولا دَخلْ",8,"ل",1,1],["أَتَجعَلُ بَينَنا عِشرينَ كَعباً","وَتَهرُبُ سَوأَةً لَكَ ياغُلامُ",9,"م",1,0],["أَتَجمَعُ شَوقاً إِن تَراخَت بِها النَوى","وَصَدّاً إِذا ما أَسقَبَت وَتَجَنُّبا",10,"ب",2,0],["أتجعلُ نَيْلاً ناله ابنُ محلِّمٍ","ثوابَ مديحي فيك هذا هو العجبْ",11,"ب",1,0],["أتجمع بين مُختلِفَيْ","نِ ذا صَعَداً وذا صَببَا",12,"ب",2,0],["أتجعل شغلك غير امرئٍ","جعلتَ مدى عمره شغلَهْ",13,"ل",2,0],["أَتَجعَلُ إِقدامي إِذا الخَيلُ أَحجَمَت","وَكَرّي إِذا لَم يَمنَعِ الدَبرَ مانِعُ",14,"ع",1,1],["أَتَجزيني عَنِ الزُلفى نِفاراً","عَتَبتكَ بِالهَوى وَكَفاكَ عَتبا",15,"ب",2,0],["أَتَجورُ عَن نَظَرٍ لَنا مِن بَعدِ ما","سُمّيتَ مِن نَظَرٍ لَنا بِالناظِرِ",16,"ر",1,0],["أَتَجمَعُ مالاً لا تُقَدِّمُ بَعضَهُ","لِنَفسِكَ ذُخراً إِنَّ ذا لَسُقوطُ",17,"ط",1,1],["أَتَجلِدُ الناسَ وَأَنتَ امرُؤٌ","تُجلَدُ في الدُبرِ وَفي القُبلِ",18,"ل",1,0],["أَتَجعَلُ غَيري في هَواكَ مُماثِلي","وَما كُلُّ أَعلاقِ الخُيولِ سَكابُ",19,"ب",1,0],["أتجنُّ من صُورِ الطبي","عَةِ رائعاتٍ للنظر",20,"ر",1,0],["أَتُجمِعُ يَأساً أَم تَحِنُّ صَبابَةً","عَلى إِثرِ هِندٍ حينَ بانَت وَتَجزَعُ",21,"ع",1,0],["أَتَجعَلُ مَن تَحيضُ بِكُلِّ شَهرٍ","وَيَنبَحُ جِروُها في كُلِّ عامِ",22,"م",1,0],["أتجعلُ ذاتَ الحيضِ والطمثِ رحبةً","تقول طوالَ الدهر لستُ بطاهرِ",23,"ر",1,0],["أَتَجزينَ بِما ألقى","فَقَد ضاقَت بِيَ البَصرَه",24,"ر",2,0],["أَتُجزى الخَيرَ صَيدٌ مِن رِكابٍ","كَما تُجزى مِنَ الأَملاكِ صيدُ",25,"د",1,0],["أَتُجمَعُ في رَبعٍ قِيانٌ كَأَنَّها","شَوادِنُ بِاللَحنِ الخَفيفِ شَوادي",26,"ي",1,0],["أتجدين؟ مافؤا","دي حديد ولا حجر",27,"ر",1,0],["أتجسر أن تستبيح المدى","وتطوي إليها الدجى والرمالا ؟",28,"ل",2,0],["أتجعل شغلك غير امرىء","جعلتَ مدى عمره شغله",29,"ل",2,0],["أتجعلنَا إلى شمجَى بنِ جرمٍ","ونبهانٍ؟ فأفٍّ لذَا زمانَا!",30,"ن",2,1],["اتجحد العين منك النور منبلجا","الا اذا غاض من ناسوتها النظر",31,"ر",1,0],["أتجرؤ في تلبيس ذكرك في ذكري","وتطمع في تدليس قدرك في قدري",32,"ي",1,1],["أَتَجعَلُني سَراةُ بَني سُلَيمٍ","كَكَلبٍ لا يَهِرُّ وَلا يَصيدُ",33,"د",1,0],["أَتَجهَلُ قَدرَ بِشرٍ إِنَّ بِشرا","لَأَرفَعُ مِنكَ في الناسوتِ قَدرا",34,"ر",2,1],["أَتَجزَعُ لِلفِراقِ وَهُم جِوارُ","فَكَيفَ إِذا نَأَت بِهِمُ الدِيارُ",35,"ر",1,1],["أَتَجمَعُ لي فَقراً وَبيناً وَكِبرَةً","لَكَ اللَهُ ما تُثنيكَ خيفَةُ مأثمِ",36,"م",1,0],["أَتَجْحَدُ قَتْلِي رَبَّةُ الشَّنْفِ والخرْصِ","وذَاكَ نَجِيعِي فِي مُخَضَّبِهَا الرّخْصِ",37,"ص",1,1],["أَتجشَّم السُلوان عنه تكلُّفاً","وَالطَبعُ يغلبُ شيمةَ المتطبِّعِ",38,"ع",1,0],["أتَجفوني وطَيفُكَ لَيسَ يَجفو","ولا تَصفو وود الطيفِ يَصفو",39,"و",1,1],["أتجحدُ في دين الوفاء وتشتكي","فيا ليتَ دينَ الودّ كانَ منجَّما",40,"م",2,0],["أتجفوا محبا دق جثمانه الضنى","وذاب حشى والحب في القلب آرز",41,"ز",1,0],["أتجحد ما في الريح من أنة الحزن","وهل هي إلا رجع شجوك في الدجى",42,"ج",2,1]]}