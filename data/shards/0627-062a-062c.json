//www.poetsgate.com/ViewPoem.aspx?id=130158",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6120,"حُبَّي العُذرِي","https://www.poetsgate.com/ViewPoem.aspx?id=214107",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[242,"كم ذا تقرطسني بسمر نبالها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563704",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[5190,"فاض الكيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78342&r=&rc=55",""]],"verses":[["أَتَجزَعُ أَن تَلقَى مِنَ الدَّهرِ نَبوَةً","بِها وَلَها نَفسي وَأَهلي وَمالُها",0,"ل",3,0],["أتَجْزَعُ للبَيْنِ أم تَرْعَوي","إِلى جَلَدٍ أسْأَرَتْهُ النّوى",1,"ا",1,0],["أتَجزعين ابتئاساً بين أظهرنا","وكلّنا عنك للبأساء حمّال",2,"ل",1,0],["أَتَجعَلُ ذا الكيرِ مِن مالِكٍ","وَأَينَ سُهَيلٌ مِنَ الفَرقَدِ",3,"د",1,0],["أَتَجعَلُ يا اِبنَ القَينِ أَولادَ دارِمٍ","كَشَيبانَ شَلَّت مِن يَدَيكَ الأَصابِعُ",4,"ع",1,1],["أَتَجمَعُ قَلباً بِالعِراقِ فَريقُهُ","وَمِنهُ بِأَظلالِ الأَراكِ فَريقُ",5,"ق",1,0],["أَتَجزَعُ مِمّا أَحدَثَ الدَهرُ بِالفَتى","وَأَيُّ كَريمٍ لَم تُصِبهُ القَوارِعُ",6,"ع",1,0],["أتجعلنا قيس لكلبٍ بضاعةً","ولست بِنسيٍ في مَعدٍّ ولا دَخل",7,"ل",1,1],["أتجعلنا جسراً لكلب قضاعة","وليست بنسي مَعَدٍّ ولا دَخلْ",8,"ل",1,1],["أَتَجعَلُ بَينَنا عِشرينَ كَعباً","وَتَهرُبُ سَوأَةً لَكَ ياغُلامُ",9,"م",1,0],["أَتَجمَعُ شَوقاً إِن تَراخَت بِها النَوى","وَصَدّاً إِذا ما أَسقَبَت وَتَجَنُّبا",10,"ب",2,0],["أتجعلُ نَيْلاً ناله ابنُ محلِّمٍ","ثوابَ مديحي فيك هذا هو العجبْ",11,"ب",1,0],["أتجمع بين مُختلِفَيْ","نِ ذا صَعَداً وذا صَببَا",12,"ب",2,0],["أتجعل شغلك غير امرئٍ","جعلتَ مدى عمره شغلَهْ",13,"ل",2,0],["أَتَجعَلُ إِقدامي إِذا الخَيلُ أَحجَمَت","وَكَرّي إِذا لَم يَمنَعِ الدَبرَ مانِعُ",14,"ع",1,1],["أَتَجزيني عَنِ الزُلفى نِفاراً","عَتَبتكَ بِالهَوى وَكَفاكَ عَتبا",15,"ب",2,0],["أَتَجورُ عَن نَظَرٍ لَنا مِن بَعدِ ما","سُمّيتَ مِن نَظَرٍ لَنا بِالناظِرِ",16,"ر",1,0],["أَتَجمَعُ مالاً لا تُقَدِّمُ بَعضَهُ","لِنَفسِكَ ذُخراً إِنَّ ذا لَسُقوطُ",17,"ط",1,1],["أَتَجلِدُ الناسَ وَأَنتَ امرُؤٌ","تُجلَدُ في الدُبرِ وَفي القُبلِ",18,"ل",1,0],["أَتَجعَلُ غَيري في هَواكَ مُماثِلي","وَما كُلُّ أَعلاقِ الخُيولِ سَكابُ",19,"ب",1,0],["أتجنُّ من صُورِ الطبي","عَةِ رائعاتٍ للنظر",20,"ر",1,0],["أَتُجمِعُ يَأساً أَم تَحِنُّ صَبابَةً","عَلى إِثرِ هِندٍ حينَ بانَت وَتَجزَعُ",21,"ع",1,0],["أَتَجعَلُ مَن تَحيضُ بِكُلِّ شَهرٍ","وَيَنبَحُ جِروُها في كُلِّ عامِ",22,"م",1,0],["أتجعلُ ذاتَ الحيضِ والطمثِ رحبةً","تقول طوالَ الدهر لستُ بطاهرِ",23,"ر",1,0],["أَتَجزينَ بِما ألقى","فَقَد ضاقَت بِيَ البَصرَه",24,"ر",2,0],["أَتُجزى الخَيرَ صَيدٌ مِن رِكابٍ","كَما تُجزى مِنَ الأَملاكِ صيدُ",25,"د",1,0],["أَتُجمَعُ في رَبعٍ قِيانٌ كَأَنَّها","شَوادِنُ بِاللَحنِ الخَفيفِ شَوادي",26,"د",2,0],["أتجدين؟ مافؤا","دي حديد ولا حجر",27,"ر",1,0],["أتجسر أن تستبيح المدى","وتطوي إليها الدجى والرمالا ؟",28,"ل",2,0],["أتجعل شغلك غير امرىء","جعلتَ مدى عمره شغله",29,"ل",2,0],["أتجعلنَا إلى شمجَى بنِ جرمٍ","ونبهانٍ؟ فأفٍّ لذَا زمانَا!",30,"ن",2,1],["اتجحد العين منك النور منبلجا","الا اذا غاض من ناسوتها النظر",31,"ر",1,0],["أتجرؤ في تلبيس ذكرك في ذكري","وتطمع في تدليس قدرك في قدري",32,"ر",2,1],["أَتَجعَلُني سَراةُ بَني سُلَيمٍ","كَكَلبٍ لا يَهِرُّ وَلا يَصيدُ",33,"د",1,0],["أَتَجهَلُ قَدرَ بِشرٍ إِنَّ بِشرا","لَأَرفَعُ مِنكَ في الناسوتِ قَدرا",34,"ر",2,1],["أَتَجزَعُ لِلفِراقِ وَهُم جِوارُ","فَكَيفَ إِذا نَأَت بِهِمُ الدِيارُ",35,"ر",1,1],["أَتَجمَعُ لي فَقراً وَبيناً وَكِبرَةً","لَكَ اللَهُ ما تُثنيكَ خيفَةُ مأثمِ",36,"م",1,0],["أَتَجْحَدُ قَتْلِي رَبَّةُ الشَّنْفِ والخرْصِ","وذَاكَ نَجِيعِي فِي مُخَضَّبِهَا الرّخْصِ",37,"ص",1,1],["أَتجشَّم السُلوان عنه تكلُّفاً","وَالطَبعُ يغلبُ شيمةَ المتطبِّعِ",38,"ع",1,0],["أتَجفوني وطَيفُكَ لَيسَ يَجفو","ولا تَصفو وود الطيفِ يَصفو",39,"ف",2,1],["أتجحدُ في دين الوفاء وتشتكي","فيا ليتَ دينَ الودّ كانَ منجَّما",40,"م",2,0],["أتجفوا محبا دق جثمانه الضنى","وذاب حشى والحب في القلب آرز",41,"ز",1,0],["أتجحد ما في الريح من أنة الحزن","وهل هي إلا رجع شجوك في الدجى",42,"ج",2,1],["أتجرّي الكبيرَ والناسُّ طُرّاً","يَقصِدون الصغارَ دونَ الكبارِ",43,"ر",1,0],["أتجمل في العادات قول مناصح","وتبسط فيها بعد فكر مرائي",44,"ا",2,0],["أَتجَنَّبُ التَعقيدَ وال","إِيغال وَاللّفظ المعمّى",45,"م",2,0],["أتجري دمائي في مثار الأسى سدىً","وميدانُكم أولى بهن وأجدر",46,"ر",1,0],["أتجوع البلاد والنيل جارٍ","في رباها والمال ملء الخزانه",47,"ن",2,0],["أتجرحُني من كان مِن قبلُ ودُّهُ","لقلبي مِن جُرحِ التقاطعِ مَرهما",48,"م",2,0],["أتجودُ لي بالقُرب بعدَ بعادِها","وتزيلُ عني باللِّقا جَفواتها",49,"ت",3,0],["أَتَجزَع وَالحَيان لَم يَتَفَرَّقا","فَكَيفَ إِذا داعى التَفَرُّق أَسمَعا",50,"ع",2,0],["أتجمع بالجهالة في المراح","ومسرح بين الحاح المراح",51,"ح",1,1],["أتجحدك الملوك علاً وفضلاً","كفى بالشمس في الفلك اشتهارا",52,"ر",2,0],["اتجاهلت عيناك سحرَ جفونها","ودمَ الشباب بغصنه المياد؟!",53,"د",1,0],["أَتجزَعُ أَن عَرَفتَ بِبَطنِ قَوٍّ","وَصَحراءِ الأُدَيهم رَسمَ دارِ",54,"ر",1,0],["أتجهلُ يا نظام الملك إنّي","أعاودُ من حِماك كما قدمتُ",55,"ت",1,1],["أتجسرون على تكذيب نائبكم","ومن يقول عن القاضي لقد كذبا",56,"ب",2,0],["أتجعل فوقي من يقصّرُ رأيهُ","ومن لي يغني عنك مثل غنائيا",57,"ي",2,0],["أَتجَمَعُ تَهياماً بِلَيلى إِذا نَأَت","وَهَجرانَها ظُلماً كَم ظُلِمَت صُحرُ",58,"ر",1,1],["أتجزع للبين مستثقلاً","وأنت حجًى تستخفُّ الجبالا",59,"ل",2,0],["أتجعلُ أجلافاً عليها عبَاؤها","ككندَةَ تمشي في المطارف والعصبِ",60,"ب",1,0],["أتجود عينٌ والربوع أوانسٌ","وتضن يوماً والربوع قفار",61,"ر",1,0],["أتَجْزَعُ للزمانِ وأنت منه","مكانَ الحَزْم من صدر اللبيب",62,"ب",1,0],["أتجعل كل صافية زلالا","وتحسب كل غادية هتونا",63,"ن",2,0],["أتجزع شوقاً أم ترى الصبرَ أنجعاً","إذا أنت عانقتَ الحبيب المودَّعا",64,"ع",2,1],["أتجهلين بأنَّ الخمرَ معصيةٌ","وكم سمعنا بها في مجلس الطرَبِ",65,"ب",1,0],["أَتَجزَعُ كُلَّما خَفَّ القَطِينُ","وَشَطَّت بِالخَليطِ نَوىً شَطُونُ",66,"ن",1,1],["أتجعل ليثاً ذا عرين تَرى له","نيوباً وأظفاراً وعرساً وأشبلا",67,"ل",2,1],["أتجزع أن قالوا ستظعن أظعان","وكيف تطيق الصبر ويحك إن بانوا",68,"ن",3,1],["اتْجرّ صوتٍ يَحْيِيِ الْميت","يالين جاك الصيف مرتاح",69,"ح",1,0],["أتجحدك الحساد فضلا وسؤدداً","وما كان ضوء الصبح يخفى ليجحدا",70,"د",2,0],["أتجري مع الخيل العتاق تجهّلاً","رُويدَك لا تجري حِرأمّكَ مِرْجَلُ",71,"ل",1,0],["أَتجدّ السَرى وَهنَ نِساء","لَيسَ يَدرينَ ما السَرى وَالبيد",72,"د",1,0],["أَتجزعون وَوَعد المَوت لَيسَ بِهِ","خلف وَهَل يَخلف الرَحمَن ما وَعَدا",73,"د",2,0],["أَتَجزَعُ بَعدَ الحِلمِ وَالشَيبِ أَن تَرى","دُجُنَّةَ لَهوٍ قَد تَجَلّى ضَبابُها",74,"ب",3,0],["اتجاريك في الجمال حسان","ولك دونهن قدحٌ معلى",75,"ل",2,0],["أَتَجمَعُ تَسآلَ الأَخِلّاءَ مالَهُم","وَمالَكَ مِن دونِ الأَخِلّاءِ تَحتَوي",76,"و",2,0],["أتجعل كأس الأكل باسك في الوغى","وتشحذ من لوزينج للعدى سهما",77,"م",2,0],["أَتَجسّني جَهداً وَتَبسمُ ضاحِكاً","مُستَطلِعاً سِرّي بِهِ مُستَظهِرا",78,"ر",2,1],["أتجهل ما كانوا عليه ولم تزل","ولياً لهم حاشاك من صفة النقص",79,"ص",1,0],["أتجعلُ عَمْراً والنِّطاسيَّ واصلاً","كأتباعِ دَيْصَانٍ وهم قُمُشُ المَدِّ",80,"د",1,0],["أتجعل ليلَى النَّاعِظية نِحلة","وكلَّ عريقٍ في التناسُخِ والرّدِّ",80,"د",1,0],["أتجزع من وحشة الأربع","وتبكي على طلل بلقع",81,"ع",1,1],["أتجيءُ يا شبه الكواكب والقنا","وتعود عجلاناً ولا تتوقف",82,"ف",1,0],["أَتجهل أَني غرّة في جَبينها","وَقَد علمت أَني مَتى جرتُ عاديا",83,"ي",2,0],["أَتجمَع حَتّى تفرح النفس وَالَّذي","تغرُّ به نردى وَهيهات ندفع",84,"ع",1,0],["أَتَجمَعُ عَينٌ بَينَ نَومٍ وَمَضجَع","وَلِاِبنِ رَسولِ اللَهِ في التُربِ مَضجَعُ",85,"ع",1,0],["أتجعل الزفت مسكاً","أم تجعل المسك زفتا",86,"ت",2,0],["أَتَجحَد مَن والاكَ وَالرَبعُ شاسِعٌ","لعاً لَك هَل هَذا فعالُ مُكَرّمِ",87,"م",1,0],["أتجمع أموال الألوف ضرائباً","لترتع في نعمائها العشرات",88,"ت",1,0],["أتجعلُ إقدامي إذا الخيلُ أحجمتْ","وكَرِّي إذا لم يمنعِ الخيلَ مانعُ",89,"ع",1,0],["أتجانَى مِن بَعدِ ما ألبسَ الد","دَلق وقد فاضَ كالغُذَاةِ صماني",90,"ن",2,0],["أتجهل أنني رب","فثرت بلاهب الشرر",91,"ر",1,0],["أَتَجزي بِالوِدادِ المَحضِ هَجراً","مَعَّنىً فيكَ لَم تَجحَد غَرامَه",92,"م",2,0],["اتجاهَل ذا إِذ سَأَلتَ عَنِ الَّذي",