{"poems":[[72,"أي شيء يا سيدي يبلغ النا","https://www.aldiwan.net/poem20208.html","الخفيف"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[29,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[29,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[85,"دار البشاير مجلسنا","https://www.aldiwan.net/poem6799.html","عموديه"],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[143,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[181,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[210,"يا فتى بالبديع حل كلامه","https://www.aldiwan.net/poem13391.html","الخفيف"],[229,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[349,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[403,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[432,"هو ملتقى أرج النواسم فانظرا","https://www.aldiwan.net/poem12311.html","الكامل"],[461,"هذا الغدير وحوله من عزه","https://www.aldiwan.net/poem15434.html","الكامل"],[562,"بكل ظبية وحش ظبية الأنس","https://www.aldiwan.net/poem52905.html","البسيط"]],"verses":[["ملحد لا يزال في شرعة الدِّي","ن وإن كانَ ليس بالإنسان",0,"ن",1,0],["ملحدٌ لا يعبد الله لكن","كل غرمول قفاه ذراع",1,"ع",1,0],["مُلِحٌّ كَأَنَّ البَرقَ في حَجَراتِهِ","مَصابيحُ أَو أَقرابُ بُلقٍ تَجَفَّلُ",2,"ل",1,0],["مُلحَ المُتونِ كَأَنَّما أَلبَستَها","بِالماءِ إِذ يَبِسَ النَضيحُ جِلالا",3,"ل",2,0],["مُلِحُّ القَطرِ مُنسَكِبُ العَزالي","إِذا ما قُلتُ أَقلَعَ يَستَحيرُ",4,"ر",1,0],["ملحه في عين اللي ما يصلِّى","ولا يقولش تتهنَّى",5,"ن",2,0],["مُلَحٌ خُصصِّتْ لهم ونِكاتٌ","ملؤهنَّ الإبداعُ والتهذيب",6,"ب",1,0],["مُلحِقاً بِالإِحسانِ مَعناً بِكَلبٍ","لَيَكونَ الحَيّانِ فيهِ سَواءَ",7,"ا",2,0],["مُلِحٌ بِبَرقٍ مُستَطِيرٍ كَأَنَّهُ","صَفِيحٌ بأَيدِى مَأزِقٍ مُتَسَايفِ",8,"ف",1,0],["ملحق بالطباق ابدعت حقا","في المباني تركيبه ونظامه",9,"م",2,0],["مِلحٍ أُجاجٍ كدموع الأرمَدِ","وردتُه تحت الظلام المُلْبِد",10,"د",1,0],["مَلحوظَةُ الذاتِ بِعَينِ ذاتِها","وَباطِنُ المَلحوظِ مِنها قَد جُهِل",11,"ل",1,0],["ملَّح إذ لَمَّحَ في تشبيهه","إلى أمور بذويها تردي",12,"ي",1,0],["مُلَحُ عَمَمْتَ بِها الزَّمانَ وَأَهْلَهُ","وَلَقَدْ خُصِصْتَ مِنَ الثَّنَاءِ بِأَكْثَرا",13,"ر",2,0],["مُلَحٌ يتمُّ بها النشاطُ ومجلسٌ","جَلَّتْ مسرَّتُه دُجى الأحْزانِ",14,"ن",1,0],["ملحيةٌ قَصَّرَتْ عنها الحِسانُ كما","قد قَصَّرَتْ كلُّ مِصرٍ عن طَرابُلُسِ",15,"س",1,0]]}