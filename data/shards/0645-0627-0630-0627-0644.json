{"poems":[[79,"ماذا لقينا بماغوس من اللغط","https://www.aldiwan.net/poem36393.html","البسيط"],[29,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[74,"ماذا لقيت بمن أعشت روائحها","https://www.aldiwan.net/poem18965.html","البسيط"],[74,"صيرني في كل واد أهيم","https://www.aldiwan.net/poem19673.html","السريع"],[91,"من كل زهر قد جمعت قليلا","https://www.aldiwan.net/poem44606.html","الكامل"],[87,"يا قلب أحمد","https://www.aldiwan.net/poem7883.html","مجزوء الكامل"],[87,"قبر الوزير تحية وسلاما","https://www.aldiwan.net/poem62828.html","الكامل"],[87,"اليوم أصعد دون قبرك منبرا","https://www.aldiwan.net/poem62866.html","الكامل"],[87,"جن على حرم السماء أغاروا","https://www.aldiwan.net/poem62964.html","الكامل"],[87,"أقدم فليس على الإقدام ممتنع","https://www.aldiwan.net/poem63762.html","البسيط"],[87,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[45,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[51,"يا صاح قد عظم البلاء وطالا","https://www.aldiwan.net/poem64279.html","الكامل"],[99,"عادت لطائرها الذي غناها","https://www.aldiwan.net/poem24402.html","الكامل"],[107,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[107,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[107,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141014",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12549","الكامل"],[108,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[87,"قبرَ الوزيرِ، تحيَّة ً وسَلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9624&r=&rc=114",""],[201,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[408,"الآن باح بمضمر الأسرار","https://www.aldiwan.net/poem46978.html","الكامل"],[567,"ماذا لقيت من الحبيب وحبه","https://www.aldiwan.net/poem52950.html","الكامل"],[580,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2439","المنسرح"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18229","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56568","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79947","المنسرح"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87858","الكامل"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130220","الكامل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96280","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52070","الكامل"],[2179,"","https://poetry.dctabudhabi.ae/diwan/poem/178153",""],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77328","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77300","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97996","المتدارك"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125931","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28668","السريع"],[4549,"","https://poetry.dctabudhabi.ae/diwan/poem/203558","البسيط"],[4723,"صورة حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=62014",""],[4755,"فِي البَالِ مَا لا يَنْحَكِيْ يَا (فِيْسُ)","https://www.poetsgate.com/ViewPoem.aspx?id=184672",""],[4859,"أضغاث أحلام!","https://www.poetsgate.com/ViewPoem.aspx?id=208817",""],[4859,"كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=210929",""],[5088,"قل لإبن خلاد المفضى إلى أمد","https://www.poetsgate.com/ViewPoem.aspx?id=178163",""],[5152,"لِمَ تَضيق؟","https://www.poetsgate.com/ViewPoem.aspx?id=208827",""],[5183,"منزل الشان","https://www.poetsgate.com/ViewPoem.aspx?id=180213",""],[5185,"القاع","https://www.poetsgate.com/ViewPoem.aspx?id=71577",""],[5295,"ميلاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=210856",""],[5387,"عجوزٌ مراهق","https://www.poetsgate.com/ViewPoem.aspx?id=53104",""],[5464,"سبايا","https://www.poetsgate.com/ViewPoem.aspx?id=36084",""],[5536,"عذرا أبا الطيب!!","https://www.poetsgate.com/ViewPoem.aspx?id=22589",""],[5736,"مستاءة لغيابك","https://www.poetsgate.com/ViewPoem.aspx?id=203915",""],[5736,"السم في العسل","https://www.poetsgate.com/ViewPoem.aspx?id=211832",""],[5763,"زمنُ الصفاقة","https://www.poetsgate.com/ViewPoem.aspx?id=27063",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[6019,"إلى هَجر الحب والنقاﺀ..للأحساﺀ أنشود","https://www.poetsgate.com/ViewPoem.aspx?id=137673",""],[6233,"سيمر العاشق فانتظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78445&r=&rc=8",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""]],"verses":[["مَاذَا لَقينَا بِمَاغُوسٍ مِنَ اللَّغَطِ","لَيْلاً وَمِنْ هَرَج الأَحْرَاسِ وَالشُّرِطِ",0,"ط",1,1],["ماذا لَقيتُ مِنَ الأَظعانِ يَومَ قِنىً","يَتبَعنَ مُغتَرِباً بِالبَينِ ظَعّانا",1,"ن",2,0],["ماذا لقيت بمن أعشت روائحها","عيني وضاق بها صبري ومصطبري",2,"ي",1,1],["ماذا لقينا في حديث الثنا","من مجده المتّضح المستقيم",3,"م",1,0],["ماذا ليوم الروع عنه اعتضته","لما غمدت الصارم المصقولا",4,"ل",2,0],["ماذا لقيتَ من الغرا","م ومن بشدّته ابتلاك",5,"ك",1,0],["ماذا لَقيتَ مِنَ الرِياساتِ وَالعُلا","وَأَخَذتَ مِن نِعَمِ الحَياةِ جِساما",6,"م",2,0],["ماذا لَقيتَ مِنَ الرُقادِ وَطولِهِ","أَنا فيكَ أَلقى لَوعَةً وَتَحَسُّرا",7,"ر",2,0],["ماذا لَقيتَ مِنَ النَجائِبِ كُلِّها","قُل لي أَعِندَكَ لِلنَجائِبِ ثارُ",8,"ر",1,0],["ماذا لَقيتَ مِنَ الدَوِّ السَحيقِ وَمِن","قَفرٍ يَضيقُ عَلى الساري وَيَتَّسِعُ",9,"ع",1,0],["ماذا لَقيتَ مِنَ الحَضا","رَةِ يا أُخَيَّ التُرَّهاتِ",10,"ت",1,0],["ماذا لَقيتُ مِنَ الدُنيا وَأَعجَبُهُ","أَنّي بِما أَنا باكٍ مِنهُ مَحسودُ",11,"د",1,0],["ماذا لَقيتُ مِنَ الهَوى وَسَقامِهِ","فيها تَبارَكَ رَبُّنا وَتَعالى",12,"ل",2,0],["ماذا لقينا من لقاءٍ خاطفٍ","وعشيةٍ كالبرقِ حانَ ضحاهَا",13,"ا",3,0],["ماذا لنا وحياةُ النّيلِ في يدكم","والأَمرُ أَجْمعُ من نَقْضٍ وتقريرِ",14,"ر",1,0],["ماذا لَقيتِ مِنَ القَومِ الأُلى كَفَرَت","مِمالِكُ الشَرقِ ما مَنّوا وَما وَهَبوا",15,"ب",3,0],["ماذا لهم بعد الغُرورِ وما لَقُوا","في الحربِ إن كذبَ الرجاءُ وخابوا",16,"ب",3,0],["ماذا لَقِيتَ أبا جهلٍ وكيف ترى","آياتِ ربّك في القومِ الذين عموا",17,"م",3,0],["ماذا لقيت من الدّنيا وأعجبها","أنّي بما أنا باكٍ منه محسود",18,"د",1,0],["ماذا لقِيتَ من الزمان بصخرةٍ","قاسَيتَ فيها غُرْبةً ووِحادَا",19,"د",2,0],["ماذا لَقِيتَ مِنَ الصِّبَا وَنعِيمِهِ","غَيرَ المكَارِهِ فِيهِ والأَهْوَالِ",20,"ل",1,0],["ماذا لَقيتُ مِنَ الهَوى وَيحَ الهَوى","لَو أَنَّ نَفسي في يَدَيهِ رَمى بِها",21,"ب",3,0],["ماذا لِقينَا لديكم من مؤانسةٍ","دلَّتْ على كرم في النفس منغرسِ؟",22,"س",1,0],["ماذا لقيتَ من الرياساتِ العلا","وأخذتَ من نعمِ الحياة ِ جساما؟",23,"م",2,0],["ماذا لقيت بذلك ال","قبر المخيف من العذاب",24,"ب",1,0],["ماذَا لآلِ أُميَّةٍ عُصَبِ الشّقا","عِندَ النبيّ محمّدٍ مِنْ ثارِ",25,"ر",1,0],["ماذا لَقيتُ من الحبيبِ وحُبِّهِ","إلاَّ تَلاعُبَهُ بمُهجةِ صَبِّهِ",26,"ب",2,1],["ماذا لقيت من الصُّدودِ لأَنَّني","أَلقى خشونَتَه بقلبٍ مُتْرَف",27,"ف",1,0],["ماذا لَها في المَماتِ بَعدَ غَدٍ","إِن حَلَّ أَهلُ الميراثِ في عَدَدي",28,"د",2,0],["ماذا لَقيتَ جُزيتَ صالِحَةً","مِن جَفوَةِ الإِخوانِ لَو تَدري",29,"ر",2,0],["ماذا لهم لله درهمو","الناس قد عفوا وهم جشعوا",30,"ع",3,0],["ماذا لأعدائها تقول إذا","لم تنجها اليوم من مدمِّرها",31,"ر",3,0],["ماذا لَقيتَ مِنَ الحَياةِ وَصَفوِها","إِلّا شَدائِدَ تَلتَقي بِشَدائِدِ",32,"د",1,0],["ماذا لقيتُ غَداةَ يُخْبرني","ناعٍ نَعاكَ لنا ولا يَدْرِي",33,"ر",2,0],["ماذا لقينا من القاطول لا هطلت","فيه السحاب ولا سقته تهتانا",34,"ن",2,1],["مَاذا لَقِيتُ مِنَ الزَّمِانِ يَرُوعُنِي","بِالحَيفِ حتى في المَنَامِ يُخَوّفُ",35,"ف",1,0],["ماذا لقيت اليوم من","متمجن خنث الكلام",36,"م",1,1],["ماذا لَقيتَ فداكَ الناسُ كُلُّهُمُ","مِنَ الشَياطينِ يَحدوهُم أَبو الحَكَمِ",37,"م",1,0],["ماذا لَقيتُ مِنَ العَناءِ وَذُقتُهُ","مِن مُحنَقينَ عَلَيَّ فيكِ غِضابِ",38,"ب",1,0],["ماذا لو كان الإلف أناه","يطوف وذلك يمتعه",39,"ع",2,0],["ما ذا لقيت من الحيا","ة وما بها شيء يسر",40,"ر",1,0],["ماذا لفوا مِنهُ مِن ضَربٍ يَشيبُ لَهُ","سودُ النَواصي وَطَعنُ غَيرِ مُندَمِل",41,"ل",1,0],["ماذا لَقينا مِن دَواوينِهِ","وَخطّه فيها بِأَقلامِهِ",42,"م",2,0],["ماذا لقيتُ من المستعربين ومن","قياس نحوِهُمُ هذا الذي ابتدعوا",43,"ع",3,1],["ماذا لديَّ من الهوى ولديكِ","يا صورةً، أمعنتُ في عينيكِ",44,"ك",1,1],["مَاذَا لَدَيْكَ لِظَامِئٍ صَحْرَاؤُهُ","شَاخَتْ , ومَا مَرَّتْ عَلَيْهَا العِيْسُ ؟",45,"س",1,0],["‏ماذا لو انتهت الحروب","وصافح السلمُ المدى",46,"د",2,1],["ماذا لو اتفق الوصال مع الأذى","وتلبست جسد الهوى الكورونا",47,"ن",2,1],["ماذ السماح بتقريظ وتزكية","وقد بخلت بمذخور ومكنوز",48,"ز",1,0],["ماذا لو انفلقَ الصباحُ لِخاطِري","ورأيتُ مدَّ النورِ كيفَ يُفِيْقُ ؟",49,"ق",1,0],["ماذا لو انسكبَ السحابُ بِمُهْجَتِي","وبأضْلُعِي روحُ الورودِ رحيقُ؟",49,"ق",1,0],["ماذا لذاك ولكن ذا لباقية","يحيى بها الدين حر الوجه والشان",50,"ن",1,0],["ماذا لو اشتقت التبحر ساعة","في ملتي هل يُرفض البحّار؟",51,"ر",1,0],["ماذا لو الأحلامُ صبَّتْ شهدَها","أو بدَّلَ الليلُ المُعتَّقُ مَبْدأَهْ؟",52,"ا",2,0],["ماذا لو البسماتُ هلَّتْ رِيحُها","أو صارتْ الأفراحُ للدنيا رِئَةْ؟",52,"ا",2,0],["ماذا لديك إذا أردت وصالها","وأثرت فيها رغبة متكررة",53,"ر",2,0],["ماذا لديكَ ؟ أغَيرُ قافية ٍ ؟","أمْ أنَّ عندكَ سيفَ ذي يزَن ؟",54,"ن",1,0],["ماذا لَقِيْتُ مِنَ الدُنْيا وأَعْجَبُهُ","أَنِّي بِما أَنا شاكٍ مِنْهُ مَحسُودُ",55,"د",1,0],["ماذا لو أنك قد ضممتَ تلهّفي:","\"أتلملمين تبعثري بِهِدابِكْ؟\"",56,"ك",1,0],["ماذا لو اكتملتْ أنصافُنا قِيَمًا","قلبانِ واتّحدا قلبًا إلى أجلِ",57,"ل",1,0],["ماذا لقيتُ من الزمانِ وأهلهِ","إني قرأتُ العصرَ درساً مفعماً",58,"م",2,0],["ماذا لدي من العتاد سوى","أشلاء حلم غير مكتمل !",59,"ل",1,0],["ماذا لديَّ وأنباﺀُ الهوى افْتُضِحتْ","سوى هواكِ الذي يحلو بهِ الخَبَرُ",60,"ر",1,0],["ماذا لو أنتِ نسيتِ إذن","وخرجتِ إليَّ لتعتذري",61,"ر",2,0],["ماذا لديكم ..قدّموا","أخباركم مَحْضُ اختلاق",62,"ق",1,0]]}