{"poems":[[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[119,"حبي لأهلي وأولادي وعائلتي","https://www.aldiwan.net/poem41719.html","البسيط"],[266,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[333,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[347,"يا لقلبي من ذكريات الأماني","https://www.aldiwan.net/poem55330.html","الخفيف"],[376,"أفرق حتى ما به داء","https://www.aldiwan.net/poem57537.html","السريع"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112450","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71028","المنسرح"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145640","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205627","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95571","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11858","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71064","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[4755,"حِينَمَا يَقتُلُ الشَّقيقُ شَقِيقَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=191665",""],[557,"أذكر في الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=18224",""],[5648,"بالراي متعصب وجمهور واجيال","https://www.poetsgate.com/ViewPoem.aspx?id=155976",""],[5701,"يا سعد قم وانظر تجد ما نستحي","https://www.poetsgate.com/ViewPoem.aspx?id=164583",""],[5823,"مصارحة","https://www.poetsgate.com/ViewPoem.aspx?id=59644",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[5957,"في ذكرى الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=177637",""],[6089,"حشد الامنيات","https://www.poetsgate.com/ViewPoem.aspx?id=213037",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[5309,"أولعت بالعدل لا الأحداث تلهيني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573551",""],[6225,"أبنائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80989&r=&rc=258",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["والاغاني اذا شجتك الاغاني","غير امواج ذلك الزخار",0,"ر",1,0],["والأغنياء ، وهل ترقّ قلوبهم ؟","لا ، إنّها أقسى من الصخرات",1,"ت",1,0],["وإلاّ غفوةٌ مسَّتْ جُفوناً","بأجوازِ السماءِ لها انجِذاب",2,"ب",1,0],["والاغتصاب لأهل البيت شيده","خير الوجود وهذا بعده قدمي",3,"م",2,0],["والا غصبنا البيد ما في نفوسها","وغاية ما فيها رغام وجندل",4,"ل",1,0],["والأغاريد التي فاقت","أغاريد عنان",5,"ن",1,0],["والاغاني العذاب ذاب الأماني","والدموع الغزار ذات المعاني",6,"ن",2,0],["والأغيدُ الأهيفُ أعضاؤه","في أنفس العشاق أهواءُ",7,"ا",2,0],["والاغتيابُ وكذا النّميمة","كما لهما عاقبة ذميمة",8,"ه",1,0],["والإغتراب عنكم","قد ضعضع اصطباري",9,"ر",2,0],["والأغنياء الحلوَى دواؤهمُ","والبُرُّ والكبشُ بالكواميخِ",10,"خ",1,0],["والأغاريدُ فِي الحُقُولِ اسْتَحَالَتْ","مَأْتَمًا تَكْرَهُ العَصَافِيرُ لَحْنَه",11,"ن",2,0],["والأغصن أقلام والخلائق جمعا","كتاب مدى الدهر يكتبون بإجمال",12,"ل",1,0],["والأغنياء على الملاهي عكف","صرعى الملاحظ والهوى الختال",13,"ل",1,0],["والأغانى فتلمس المزهر الصدّا","ح فى روعة وحسن رنينِ",14,"ن",1,0],["والأغرُّ الهادي إذا حارَ وفدٌ","فسناه دلالة الحيران",15,"ن",1,0],["وَالأَغيَدُ الأَلمى يَروقُكَ مَنظَراً","في سَقيِها وَالغادَةُ اللَمياءُ",16,"ا",2,0],["وإِلا غَدَتْ لي دعوةٌ آمريّةٌ","بها وإليها نِسْبتي وشِعاري",17,"ر",2,0],["والأغاني بعد دفني","دُفنت دفنا طويلا",18,"ل",2,0],["والا غوياء جميعا في ولايته","يضلهم ويمنيهم بغيهم",19,"م",1,0],["والأغاني على بساط التهاني","والمثاني رخيمها يترنم",20,"م",1,0],["والأَغَانِي تَلوذُ بالصَّمتِ خَوفًا","مِن نَشِيجٍ بهِنَّ يُخفِي حَرِيقَه",21,"ق",2,0],["والأغنيات الحالمات بسحرها","سكر الزمان بخمرها وغفا القدر",22,"ر",1,0],["والأغنيات الحائرات توقفت..","فوق النسيم وأغمضت عين الوتر",22,"ر",1,0],["والاغلبيه بالمواقف هم رجال","واسمع وشوف ولاعليهم قسيمه",23,"م",2,0],["والأغنياء بمصر سوس مفسد","فيها وهمٌّ ما له من آخر",24,"ر",1,0],["والأغنيات تحوَّلت عن ذوقنا","هيهات أن يأتيك صوت مورقُ",25,"ق",1,0],["والأغاني ، أتذكرينَ غنائي","(مُهجتي لُجةٌ ، وعيناكِ ساحِلْ)",26,"ل",1,0],["والأغنيات البيض أقمارٌ لديكَ","تنيرُ والعرفان عندك ناضرُ",27,"ر",1,0],["والأغنيات تعود من أسفارها","نحوي لتبدأ في دمي الأسفارا",28,"ر",2,0],["وَ الأُغنِياتِ إِذِ امَّحَتْ","بِفِراقِ أَوتَارٍ لِعُودْ",29,"د",1,0],["والأغنياءُ بِهِ لاهونَ مِن بَطَرٍ","لا شَيءَ يَردَعُهُم عَن نَهجِ نَيرون",30,"ن",1,0],["والأغنياتُ تذوب ما فِرحوا","وتسيلُ فوق دفاتر العقلِ",31,"ل",1,0],["والأغاني والمُغَنِّي وِحْدَةٌ","إنْ تَكَسَّرنَ رأى الناسُ انكسارَهْ",32,"ر",2,0]]}