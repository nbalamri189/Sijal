{"poems":[[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[65,"نأى بجانبه والصبح مبتسم","https://www.aldiwan.net/poem46133.html","البسيط"],[65,"النجم يبعد مرمى طرفه الساجي","https://www.aldiwan.net/poem46197.html","البسيط"],[53,"أيها السيد الذي ورث السؤدد","https://www.aldiwan.net/poem10880.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[58,"وأحم من أولاد أعوج عجته","https://www.aldiwan.net/poem58503.html","الكامل"],[33,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[107,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[83,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[42,"جن قلبي بذكر أم الغلام","https://www.aldiwan.net/poem42298.html","الخفيف"],[42,"هاج قلبي بعدما كان سكن","https://www.aldiwan.net/poem42334.html","الرمل"],[50,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43750","الوافر"],[92,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[56,"عاذِلي ! لو شئتَ لمْ تلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14488",""],[112,"ملائكة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=8412",""],[20,"وتفكر رب الخورنقِ إِذ أش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69772&r=&rc=13",""],[240,"يا موسعي جفوة وصدا","https://www.aldiwan.net/poem31825.html","مجزوء البسيط"],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[369,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[369,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[438,"متى يملك الحلم الدنو على البعد","https://www.aldiwan.net/poem12601.html","الطويل"],[445,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[466,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[466,"خليفة الله مالي كلما بسطت","https://www.aldiwan.net/poem15280.html","البسيط"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[770,"","https://poetry.dctabudhabi.ae/diwan/poem/198751","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59299","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17032","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61060","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126158","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64934","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71074","البسيط"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111152","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106979","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100897","البسيط"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144169","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58298","الوافر"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[3221,"","https://poetry.dctabudhabi.ae/diwan/poem/198685","الطويل"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26955","السريع"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86301","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138530",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91306","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91298","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91375","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133233","الرمل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88584","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76487","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99100","الخفيف"],[4767,"غادة الحُسن","https://www.poetsgate.com/ViewPoem.aspx?id=211673",""],[4858,"طابتِ الأيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=138207",""],[3271,"من مرج عبقر","https://www.poetsgate.com/ViewPoem.aspx?id=104125",""],[5237,"ما حال من فارق ذاك الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=113108",""],[5790,"بردت حرارة قلبك المشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=112091",""],[5799,"تبسم فجر الحق وأنجابت الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=124750",""],[5864,"عادتكَ ياوطنَ الكِرامِ لئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190486",""],[6142,"حشدوا كل واحدٍ من قبيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155696",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[520,"إن كان عطفك للإعجاب يختال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577610",""]],"verses":[["فَأَرعى مِن جَماجِمِكُم جَميماً","وَأَمطَرَ مِن دِمائِكُمُ سَحابا",0,"ب",2,0],["فأرْعِ سَمعَكَ شِعْراً كادَ من طَرَبٍ","إِلى مَعاليكَ قبلَ النَّظْمِ يَنتَظِمُ",1,"م",1,0],["فأرْعِ سَمعَكَ شِعراً يستَلِذُّ بهِ","رَجْعُ الغِناءِ بأرْمالٍ وأهزاجِ",2,"ج",1,0],["فارْعَ شيخاً لو استماحك حيَّاً","ما رأيتَ الرضا له بالزهيدِ",3,"د",1,0],["فارعَوَتْ مِنْ مُرَنَّح وصريع","ومُوَلٍّ مُهتَّكِ النحر دامي",4,"م",2,0],["فأَرَعْتُ فيها الوحشَ عن مُهجاتها","وجعلتُهُ بنفوسِهنَّ زَعيما",5,"م",2,0],["فَاِرعَوى عَنها بِصَبرٍ بَعدَما","كانَ عَنها زَمَناً لا يَرعَوي",6,"ي",1,0],["فأرعدَ سعدٌ وجاشتْ به","حَمِيَّةُ مُسْتَوفِزٍ كالنَّمِرْ",7,"ر",1,0],["فَأَرعِ بِهِ عَينَيكَ طَلعَةَ ماجِدٍ","تَخَتَّمَ بِالعَلياءِ وَاِعتَمَّ وَاِرتَدى",8,"د",2,0],["فَارعَوَت بَعدَ نَفرَةٍ نَفَرَتها","بِسُكُونٍ وَهَمزَةٍ وَاِبتِسامِ",9,"م",1,0],["فَاِرعَوى عَن ذاكَ إِذ فَطَّنتُهُ","لِلّذي نَلقى وَما كانَ فَطِن",10,"ن",1,0],["فَاِرعَوى باطِلي وَأَقصَرَ حَبلي","وَتَبَدَّلتُ عِفَّةً وَزَهادَه",11,"د",2,0],["فَاِرعوى جَهلُهُم وَأَدرَكَتِ الحَر","بُ رِجالاً تَجَرَّدوا لِلظهورِ",12,"ر",1,0],["فَأَرعَفَهُ وَأَضعَفَهُ","وَأبرَزَ عَينَهُ وَرَما",13,"م",2,0],["فارعَيِ القلبَ حرمةً مثلما","تَرعَيْن مُلكا – يُجْنى من الأملاك",14,"ك",1,0],["فارْعَ سَرْحَ اللَّهوِ مُغْتَدِياً","غيرَ مستبطٍ ولا سئمِ",15,"م",1,0],["فارعن.؟ خلتني أأصاحب أوراق.. الشجر..","والطريق الشين والارصفه.؟.. والقارعه. .",16,"ع",2,0],["فَاِرعَوى قَلبُهُ وَقالَ فَما غَبْ","طة حَيٍّ إِلى المَماتِ يَصيرُ",17,"ر",1,0],["فَاِرعَ عُهودَ الإِخاءِ وَاِكرِم","أَخاكَ عَن جَفوَةٍ وَقَطعِ",18,"ع",1,0],["فَارِعَةٌ ذِرْوَةَ الأَمانِي","بَذلاً ضَمِين الغِنَى وَظُعْنا",19,"ن",2,0],["فارْعَ فينا قَرابةَ الفَضْلِ إنّا","نحنُ أَبناؤه وأَنت أَبوه",20,"ه",1,0],["فأَرْعنى سَمعك المَفْدِيَّ صاحبُه","وعُدَّ غَيرَ الّذي قد قُلتُه لَغَطا",21,"ط",2,0],["فأَرعِ رعاكَ اللهُ سَمْعَك عِذْرةً","ضعيفةَ وَقْعِ القولِ أسهُمُها مُرط",22,"ط",1,0],["فأرعى رياضَ الفضلِ مطلولة الندى","وأُسْقى رياضَ العِلمِ واضحةَ المدِ",23,"د",1,0],["فأَرْعَيْتَهُ صِدْقَ حُرٍّ شَكُورٍ","تَسَرْبَلَ إِخلاصَ عَبْدٍ مُنِيبِ",24,"ب",1,0],["فارعَ بها حقك من روضةٍ","بأعين الروّادِ لم تُرمقِ",25,"ق",1,0],["فارعوا حقوقَ المجدَ تحظوا بهِ","في ملِكٍ حِليتُه الشعرُ",26,"ر",1,0],["فارْعوا ذمام محبٍّ دون مجدكمُ","مقارعٍ بين قوَّالٍ وصَوَّالِ",27,"ل",1,0],["فارعَ لي هجرتي إليك وهجري","سائرَ الناس في جميع النواحي",28,"ح",2,0],["فارعه ربي وصن أركانه","ليعم الخير فيّاضا رُباه !!",29,"ا",2,0],["فَارْعَوَى يَرْفَضُّ خِزْيًا","وَانْثَنَى يقرَعُ سِنَّهْ",30,"ن",2,0],["فَأَرعى تَحتَ حاشِيَةِ الدَياجي","شَقائِقَ وَجنَةٍ سُقِيَت مُداما",31,"م",2,1],["فارعي رَعاك اللَّه حَقَّ ذِمامه","فَفُؤاده بِك هائم مَشغوف",32,"ف",1,0],["فارعوا عبيدكم بعين عناية","جودوا عليه تحننا وتعطفا",33,"ف",2,0],["فارْعَيْ جَميلي يا بُثَيْ","نْ وأَسْلِفي عِنْدي جَميلَهْ",34,"ه",1,0],["فَارْعَوْا حُقوقي ولا تستضعفوا خَبَري","عُودوا فما أَنا بالداعي ولا الأَشِر",35,"ر",1,0],["فأرعد قلبي فرحة برق ثغره","فقمت له والدمع غيثاً ترقرقا",36,"ق",2,0],["فارعشت رؤوسهم كأس السرى","بنشوة النعاس حتى رقدوا",37,"د",3,0],["فارعوا كرامةَ مصرٍ إِنَّها بلدٌ","فيه السكينةُ شَرعٌ والرِّضَى ذِمَم",38,"م",1,0],["فارعَيْ رعاك الله مُسعفةً به","ضيفاً متى ما يُرْعَ يوماً يشكُرِ",39,"ر",1,0],["فأرعدْ ثمَّ أَبرِقٍ في وَعيدي","وقل ما شِئتَ منْ خيرٍ وَشَرِّ",40,"ر",1,0],["فارعَهُم جَمعاً إِذا ما","بُعثِروا يَومَ النِداءِ",41,"ا",2,0],["فأرعى ثُريّا كلّ قُرْط خفوقه","لقلبي ولكن دَرّهُ لمدامعي",42,"ي",1,0],["فأرعف السيف منهم كلهم معه","ولو بغى بكضرب السوط وارتحلا",43,"ل",2,0],["فأرعاك أعناق الرعايا ديانة","فترتاع في المرعى وغيرك يرتع",44,"ع",1,0],["فارِعَةُ الجِسمِ هَضيمُ الحَشا","كَالمُهرَةِ الضامِرِ لَم تُركَبِ",45,"ب",1,1],["فارعَ الهي ايا من بِالجلال سَما","من عِندَهُ عُهودٌ لا تَضيعُ كَما",46,"م",2,0],["فارعووا لا رعيتم ودعونا","فعنت لم يفد بها التأنيب",47,"ب",1,0],["فارع الوَفا وَاحفظ حُقوقَ متيّمٍ","فلذي الهَوى من ذي الهَوى ما اِستَوجَبا",48,"ب",2,0],["فَارع الجوارَ وَلا تُضِع حَقَّ الوَفا","حاشا لمثلك أَن يقال تلوّنا",49,"ن",2,0],["فَارع الوَفا إِن كانَ لا بدّ الهَوى","أَو لا فردّ القَلب بَعدُ وَلا تَفي",50,"ف",2,0],["فارعهم من فيض فضل","فلقد حلوا حماك",51,"ك",1,0],["فارعنى بالجود فضلا","وأزل هذا وذاك",51,"ك",1,0],["فارع إذا سافرت في الحمد واعلمن","بأن ثناء الركب حظ المسافر",52,"ر",1,0],["فارعد راس المال واشتد غيظه","واصبح في ثوب من العجب وَالكبر",53,"ر",1,0],["فَأَرعَدَ مِن أَطوادِ إِيذا هَدِيدُهُ","وَما بَينَ دُرَّاعِ الأَغارِقِ أَبرَقا",54,"ق",2,0],["فَارعَوى مُنقَلِباً نَوى","وَلِحُرِّ السَّلبِ لَم يَبغِ سَبِيل",55,"ل",1,0],["فارع من عهدك ما قد سلفا","وأعد يا فتنة المفتتن",56,"ن",1,0],["فارعي هنيئا بالرياض وغردي","فوق الغصون بأعذب الألحان",57,"ن",1,0],["فأرعب كل أنسي وجن","ومذ ختم الفسوق بكل لحن",58,"ن",1,0],["فارعَ يا كافي الكفاة ثناءً","نفث السحر في العيوم السواجي",59,"ج",2,0],["فارعَيهِ تَرعَي عاشقاً مُتولِّهاً","ما زال رغمَ نُحولِهِ يرعاك",60,"ك",1,0],["فارعَ ، يا ربِّيَ، غرساً قد نما","بغيوث الحُبِّ والزّادِ الحميدِ",61,"د",1,0],["فأرعشت في الدجى أهدابها خبلاً","كأنما غاب في سودائها عودُ",62,"د",1,0],["فارعوا ذمامي واجهدوا في الدعا","للمذنب المضني عسى ذو الجلال",63,"ل",1,0],["فارع النواظر في رياض جمالهم","فلكم شرقن بفائض الأحداق",64,"ق",1,0],["فارعدت الصمعا وابرقت الظبا","وثار قتام النقع كالليل مرتكم",65,"م",1,0],["فارعَوا بني قَومِي بَنيكُم إنَّما","تَسطُو الذِّئابُ إِذا غَفَا النُّوَّامُ",66,"م",1,0],["فارعووا عنه بعد ما أرهق الصا","حب حزنا ما فوقه من مزيد",67,"د",1,0],["فارعَ النُّفوسَ التي ذَلَّت ويَتَّمَها","فَقدُ الكَريمَينِ حُبِّ الخير والشَممِ",68,"م",1,0],["فارعتم آل رزيكٍ على شرف","لو لم تزيلوهم عنه لما زالوا",69,"ل",3,0]]}