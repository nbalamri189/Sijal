{"poems":[[53,"آب الرديني والحسام معا","https://www.aldiwan.net/poem30137.html","المنسرح"],[53,"صبرا على نوب الزما","https://www.aldiwan.net/poem30646.html","مجزوء الكامل"],[53,"لا تيأسن فربما","https://www.aldiwan.net/poem30659.html","الكامل"],[57,"إن كنت تغدو في الذنوب جليداً","https://www.aldiwan.net/poem24703.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"وقينة أبرد من ثلجه","https://www.aldiwan.net/poem9259.html","السريع"],[51,"رأيتك لا تلذ بطعم شيء","https://www.aldiwan.net/poem9419.html","الوافر"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[85,"أسلم محمد سيدى","https://www.aldiwan.net/poem6818.html","مجزوء الكامل"],[62,"لا تيأسن إذا ما كنت ذا أدب","https://www.aldiwan.net/poem52327.html","البسيط"],[45,"مل فما تعطفه رحمة","https://www.aldiwan.net/poem66828.html","السريع"],[28,"دعاني إلى جرجان والري دونه","https://www.aldiwan.net/poem5067.html","الطويل"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[46,"صنوف هذي الحياة يجمعها","https://www.aldiwan.net/poem23493.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12955","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[51,"حَرِّكْ مُنَاكَ إذا هَمَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=25843",""]],"verses":[["لا تَيأَسوا مِن ثُقوبِ زَندِهِمُ","كَأَنَّني بِالزَمانِ قَد قَرَعَه",0,"ع",2,0],["لا تَيأَسَن مِن أَن تَعو","دَ عَوائِدٌ وَتَهُبَّ ريحُ",1,"ح",1,0],["لا تَيأَسَنَّ فَرُبَّما","عَظُمَ البَلاءُ وَفُرِّجا",2,"ج",2,1],["لا تَيأَسَنَّ مِن لُطفِ رَبِّكَ في الحَشا","في بَطنِ أُمِّكَ مُضغَةً وَوَليدا",3,"د",2,0],["لَأَتَيتُها إِنَّ المُحِب","بَ مُكَلَّفٌ دَنِسٌ ثِيابُه",4,"ب",2,0],["لَأَتَيتُهُ بِالسَيفِ أَم","شي لا أُهَدَّ وَلا أَهابُه",4,"ب",2,0],["لا تَيأَسي وَتَجَلَّد","أَراكَ شَهماً رَكينا",5,"ن",2,0],["لا تَيأَسوا أَن تَستَرِدّوا مَجدَكُم","فَلَرُبَّ مَغلوبٍ هَوى ثُمَّ اِرتَقى",6,"ق",2,0],["لا تيأسَنَّ فإِنّ الله ذو كرم","وحُبُّكَ العاقِبَ الماحي الذُّنُوبَ مَحَا",7,"ح",2,0],["لَأَتَيتُهُ لا بُدَّ طالِبَهُ","فَاِقنَي حَياءَكِ وَاِقبَلي عُذري",8,"ر",2,0],["لا تيأسنْ أن يتوبَ ذو سَرَفٍ","يُضحي ويُمسي كثيرةً حُوَبُهْ",9,"ب",2,0],["لا تيأسي يا نفسُ من عَوْدةٍ","فالكبشُ لا يلهو عن النَّعجَهْ",10,"ج",2,0],["لاتيأسنَّ فإنّ رز","ق الله غادٍ رائحُ",11,"ح",1,0],["لا تيأسن وانتظر","ليل الغد المقارب",12,"ب",1,0],["لا تيأسن فإن ربّ","ك محدث إن شاء أمرا",13,"ر",2,0],["لا تيأسَنَّ إِذا ما كنتَ ذا أَدبٍ","على خمولِكَ أنْ ترقَى إِلى الفَلَكِ",14,"ك",1,1],["لا تَيأَسَن عَطفَ أَخي مَلَّةٍ","أَظهَرَ بَعدَ الوَصلِ هِجرانا",15,"ن",2,0],["لَآتِيَ مِن آلِ المُهَلَّبِ ثائِراً","بِأَعراضِها وَالدائِراتُ تَدورُ",16,"ر",1,0],["لا تئلُ العُصمُ في الهِضابِ وَلا","شَغواءُ تَغذو فَرخَينِ في لُجُفِ",17,"ف",1,1],["لا تَيأَسُ النَفسُ مِن تَفَضُّلِهِ","وَلَو أَقامَت في النارِ أَلفَ سَنَه",18,"ن",2,0],["لأتَيْتُ الإلَهَزَحْفاً، وعَفّرْتُ","جَبينيَ كَيْأسْتَمِيلَ الإلَهَا",19,"ا",1,0],["لا تَيأَسَن مِن وَصلِ ذي مَلَّةٍ","يُظهِرُ بَعدَ الوَصلِ هِجرانا",20,"ن",2,0],["لا تَيْأَسُوا فَلَكَمْ أُبِيدَتْ قَبْلكُمْ","أُمَمٌ بِيَأسٍ قَاتِلٍ وَمَلاَل",21,"ل",1,0],["لا تَيْئَسُوا من بُرْءِ ذي سَقَمٍ، وإن","طالَ العِلاجُ عليه أيَّ مَطالِ",22,"ل",1,0],["لا تيئسوا يا قوم؛ سو","ف تدقُّ للنصرِ البشائر",23,"ر",1,0],["لأتَى بِسَيْلٍ ما يُصِيبُ مَسِيلا","ولِسامِعٍ مِنْ فَضْلِهِ ما قيلا",24,"ل",2,0],["لا تيأسوا أنْ يَلُحْ مِن ليلةٍ","فجرٌ ، ولم تؤذِنْ بضوءِ نهار",25,"ر",1,0],["لأتَيْتُهَا، إنّ المُحِ","بّ مُكَلَّفٌ، دَنِسٌ ثيابُهْ",26,"ب",2,0],["لا تَيْأَسَنَّ فإنَّ رزْ","ق الله غادر رائح",27,"ح",1,0]]}