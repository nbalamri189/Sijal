oetsgate.com/ViewPoem.aspx?id=205418",""],[5398,"عيناك ترنو للبقاء","https://www.poetsgate.com/ViewPoem.aspx?id=37218",""],[5582,"صَبٌّ بِدِرَّةِ ثَدْيِ الحُبِّ مَلْبُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=63587",""],[5590,"لا تيأسن إذا حويت فضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=105285",""],[5720,"ثُمَّ انتهىٰ يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=210834",""],[5809,"تقوى","https://www.poetsgate.com/ViewPoem.aspx?id=205231",""],[5951,"رحلت أميمة للفراق فأصبحت","https://www.poetsgate.com/ViewPoem.aspx?id=52755",""],[5956,"لا تيأسَنّ أيا قلبي من البشر","https://www.poetsgate.com/ViewPoem.aspx?id=193578",""],[5957,"لا تيأس يا ابن العرب..","https://www.poetsgate.com/ViewPoem.aspx?id=11423",""],[5977,"لا تيأسوا","https://www.poetsgate.com/ViewPoem.aspx?id=213285",""],[5977,"لا شيء يبقى","https://www.poetsgate.com/ViewPoem.aspx?id=213296",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[6045,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=138521",""],[6070,"ذئب الابواب","https://www.poetsgate.com/ViewPoem.aspx?id=187880",""],[6093,"لا تَيْأَسَنَّ مِنَ القُلوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=179285",""],[6097,"قل للشّهيدة في النّقاب الأسودِ","https://www.poetsgate.com/ViewPoem.aspx?id=190678",""],[5075,"سأظلُ أملأ بالهنَا أقدَاحِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82755&r=&rc=1",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[6318,"يا قُدسُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66166&r=&rc=16",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""],[6355,"انتظار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66598&r=&rc=58",""]],"verses":[["لا تَيأَسوا مِن ثُقوبِ زَندِهِمُ","كَأَنَّني بِالزَمانِ قَد قَرَعَه",0,"ع",2,0],["لا تَيأَسَن مِن أَن تَعو","دَ عَوائِدٌ وَتَهُبَّ ريحُ",1,"ح",1,0],["لا تَيأَسَنَّ فَرُبَّما","عَظُمَ البَلاءُ وَفُرِّجا",2,"ج",2,1],["لا تَيأَسَنَّ مِن لُطفِ رَبِّكَ في الحَشا","في بَطنِ أُمِّكَ مُضغَةً وَوَليدا",3,"د",2,0],["لَأَتَيتُها إِنَّ المُحِب","بَ مُكَلَّفٌ دَنِسٌ ثِيابُه",4,"ب",2,0],["لَأَتَيتُهُ بِالسَيفِ أَم","شي لا أُهَدَّ وَلا أَهابُه",4,"ب",2,0],["لا تَيأَسي وَتَجَلَّد","أَراكَ شَهماً رَكينا",5,"ن",2,0],["لا تَيأَسوا أَن تَستَرِدّوا مَجدَكُم","فَلَرُبَّ مَغلوبٍ هَوى ثُمَّ اِرتَقى",6,"ق",2,0],["لا تيأسَنَّ فإِنّ الله ذو كرم","وحُبُّكَ العاقِبَ الماحي الذُّنُوبَ مَحَا",7,"ح",2,0],["لَأَتَيتُهُ لا بُدَّ طالِبَهُ","فَاِقنَي حَياءَكِ وَاِقبَلي عُذري",8,"ر",2,0],["لا تيأسنْ أن يتوبَ ذو سَرَفٍ","يُضحي ويُمسي كثيرةً حُوَبُهْ",9,"ب",2,0],["لا تيأسي يا نفسُ من عَوْدةٍ","فالكبشُ لا يلهو عن النَّعجَهْ",10,"ج",2,0],["لاتيأسنَّ فإنّ رز","ق الله غادٍ رائحُ",11,"ح",1,0],["لا تيأسن وانتظر","ليل الغد المقارب",12,"ب",1,0],["لا تيأسن فإن ربّ","ك محدث إن شاء أمرا",13,"ر",2,0],["لا تيأسَنَّ إِذا ما كنتَ ذا أَدبٍ","على خمولِكَ أنْ ترقَى إِلى الفَلَكِ",14,"ك",1,1],["لا تَيأَسَن عَطفَ أَخي مَلَّةٍ","أَظهَرَ بَعدَ الوَصلِ هِجرانا",15,"ن",2,0],["لَآتِيَ مِن آلِ المُهَلَّبِ ثائِراً","بِأَعراضِها وَالدائِراتُ تَدورُ",16,"ر",1,0],["لا تئلُ العُصمُ في الهِضابِ وَلا","شَغواءُ تَغذو فَرخَينِ في لُجُفِ",17,"ف",1,1],["لا تَيأَسُ النَفسُ مِن تَفَضُّلِهِ","وَلَو أَقامَت في النارِ أَلفَ سَنَه",18,"ن",2,0],["لأتَيْتُ الإلَهَزَحْفاً، وعَفّرْتُ","جَبينيَ كَيْأسْتَمِيلَ الإلَهَا",19,"ا",1,0],["لا تَيأَسَن مِن وَصلِ ذي مَلَّةٍ","يُظهِرُ بَعدَ الوَصلِ هِجرانا",20,"ن",2,0],["لا تَيْأَسُوا فَلَكَمْ أُبِيدَتْ قَبْلكُمْ","أُمَمٌ بِيَأسٍ قَاتِلٍ وَمَلاَل",21,"ل",1,0],["لا تَيْئَسُوا من بُرْءِ ذي سَقَمٍ، وإن","طالَ العِلاجُ عليه أيَّ مَطالِ",22,"ل",1,0],["لا تيئسوا يا قوم؛ سو","ف تدقُّ للنصرِ البشائر",23,"ر",1,0],["لأتَى بِسَيْلٍ ما يُصِيبُ مَسِيلا","ولِسامِعٍ مِنْ فَضْلِهِ ما قيلا",24,"ل",2,0],["لا تيأسوا أنْ يَلُحْ مِن ليلةٍ","فجرٌ ، ولم تؤذِنْ بضوءِ نهار",25,"ر",1,0],["لأتَيْتُهَا، إنّ المُحِ","بّ مُكَلَّفٌ، دَنِسٌ ثيابُهْ",26,"ب",2,0],["لا تَيْأَسَنَّ فإنَّ رزْ","ق الله غادر رائح",27,"ح",1,0],["لا تيأسنَّ فما حالٌ بدائمةٍ","لو قلتَ للشرِّ لا تبرح ودم بِرَحا",28,"ح",2,0],["لا تيأسن من الكريم وعد يعد","للصالحات فإنها أهلوه",29,"و",2,0],["لا تيأسن وان أضربك الهوى","وطفقت من تثريبه تثري به",30,"ب",2,0],["لا تيأسن فالرجا كم فرّجا","فالرزق مقسوم ومهما فرجا",31,"ج",2,1],["لا تيأسوا قطّ من فؤاد","أنتم بأعماقه حللتم",32,"م",1,0],["لا تيأسوا في ضُعفِكم وبلائكم","والثأرُ خَلفٌ والرّدى قدّام",33,"م",1,0],["لا تَيأسي فَغداً يَحُلُّ محلَّهُ","بَطَلٌ بحدِّ حُسامهِ يَشفيك",34,"ك",1,0],["لا تَيأَسن روحُ مَن عادى لَدى مِئَةٍ","قاضي القُضاةِ الجَمالُ بنُ الحَرستاني",35,"ي",1,0],["لا تيأسَنَّ فكم ظلام دامِسٍ","عطسَ الصباحُ خِلالُهُ فتنفسا",36,"س",2,1],["لا تيأسَنَّ لعُسرَةٍ فوراءَها","يُسرانِ وَعداً ليسَ فيهِ خِلافُ",37,"ف",1,1],["لا تيأسَنٌ منَ المرضى وأنْ ضعُفوا","ولن يفوتَهُمُ الإنعاشُ إنْ عاشُوا",38,"ش",3,0],["لا تيأسنّ أخا البأساء من فرجٍ","يأتيك من حيث لا يرتاده البالُ",39,"ل",1,0],["لا تيأسنّ فللأيامِ منقلَبٌ","ولا تُرَعْ فلصرفِ الدّهرِ منصرَفُ",40,"ف",1,0],["لا تيأسنْ من أخٍ ولّى بجانبه","وإن بدتْ لك منهُ سوء أخلاق",41,"ق",1,1],["لاتِينىَ الأحيَاءِ هَل من عَودةٍ","للِقائِه تَشفِي غليلَ الصَّادِي",42,"د",2,0],["لا تَيأسُوا أن يَكُونَ الهَدمُ فيهِ بِنا","فَرُبَّما صَحَّتِ الأَجسامُ بِالعِلَلِ",43,"ل",1,0],["لا تيأسن من الرجاء فان يفت","أمل الغدو فصله بالآصال",44,"ل",1,0],["لا تيأسن وإن طالت مطالبةٌ","إذا استعنت بصبر أن ترى فرجا",45,"ج",2,0],["لا تيأسن على ربع تفارقه","واحذر فديتك من خل تماذقه",46,"ق",2,1],["لا تيأس النفس عند الضيق من فرجٍ","كم شدّة بعدها قد جاء تهوينُ",47,"ن",1,0],["لا تيأسن من راحة ورحمة","فإن توالت شدة تولت",48,"ت",1,0],["لا تيأسوا من فضلنا للذنب","لا تقنطوا ان حل كل كرب",49,"ب",1,0],["لا تيأسن عن جوده فاليأس شر","مكانة منعت قبول المسرف",50,"ف",1,0],["لا تيئسن عن جوده ونواله","من أجل ذنبك فاحذرن من ذاكا",51,"ك",2,0],["لا تيأسوا وإن يئستُ فعسى","أنْ تبلغوا بالحيلة الملتَمَسَا",52,"س",2,0],["لا تَيأَسَن مِن فَرج وَلُطف","وَقوة تَظهر بَعدَ ضَعف",53,"ف",1,0],["لأَتَيْتُ بِالتَّقْصِيرِ مُعْتَرِفاً وَلَمْ","أَبْسُطْ سِوَى كَفِّ الفَقِير الْمُحْوجِ",54,"ج",1,0],["لا تيأسنّ ففي الأيام معتبرٌ","لمن به فطنة فيها ومعقول",55,"ل",1,0],["لأتى الوحي يا بريةُ فاختا","ري زعيماً وحسبها وكفاها",56,"ا",3,0],["لا تَيأَسَنَّ من اِنفِراجِ شَديدَة","قَد تَنجَلي الغَمَراتِ وَهيَ شَدائِد",57,"د",1,1],["لا تيت نحبوك مسرعا","ولصرت من غلمان دارك",58,"ك",1,0],["لا تَيَأسَنَّ فَلَيسَ كُلُّ غَمامَةٍ","نَشَأَت مُمَتَّعَةً بِطُولِ دَوامِ",59,"م",1,0],["لا تَيأسن وَإِن تَصعبت المُنى","فالصَعبُ قَد يَرتاضُ بَعدَ نِفار",60,"ر",1,0],["لا تيأسن لما جرى","فالخير فيه لعله",61,"ه",1,1],["لا تَيْأسِ الْقُرْبَى حَنَانَكَ بعدما","فاضت سحائبُها على الأطراف",62,"ف",1,0],["لأتَى كَأمثَالِ الجِبَالِ مَغَلُّهُ","وَلَكَانَ أضعَافاً بِلاَ حُسبَانِ",63,"ن",1,0],["لا تيأسن إذا الأمور تعسرت","فاليسر منتظر خلال العسر",64,"ر",1,0],["لا تيأسن من نيل فضل يبتغى","فالفضل في كل البرايا مشترك",65,"ك",1,1],["لا تيأسي بلدي من المجد الذي","منه الورى أخذوا أتمَّ نصيب",66,"ب",1,0],["لآتي بأشعار التغزل غضةً","تكاد معانيهنّ ينضحن بالماء",67,"ا",2,0],["لا تيأسن من اللجاج فإنما","سبل النجاح شجاعة ولجاج",68,"ج",1,0],["لا تيأسوا فالحادثات بمرصد","ولكم هوى عرش وحُطم تاج",68,"ج",1,0],["لا تيه أو هي قد أدركت","وقعه في نزعه أخذا وردا",69,"د",2,0],["لا تيأسن من صُرُوف الدّهر إنّ لها","تقلّبات مع الأفراح والتّرح",70,"ح",1,0],["لا تيأسي إنّ الخطوبَ كثيرةٌ","والفوز مضمونٌ وإن خذلوكِ",71,"ك",1,0],["لا تَيأسي إنّ عين اللّه ساهرةٌ","وَحُكمهُ نافذٌ فاِستنهضي الهِمما",72,"م",2,0],["لا تيأسنَّ لها فقد زوَّجتها","كفؤا وضمَّنتَ الصَّداقَ مليكا",73,"ك",2,0],["لا تيأَسنَّ من الزَمان فربمّا","نالَ الفَتى آمالُهُ في يأسهِ",74,"س",2,0],["لإتيانه بالمعجزاتِ عجائبٌ","وأخبارُه عما يكونُ وما خلا",75,"ل",2,0],["لا تيأسن من أن تدو","ر لك الأمور وتنشرح",76,"ح",1,0],["لا تيأسنَّ من الغنى","لله ألطاف خفيه",77,"ه",1,0],["لا تيأسوا فالله جل جلاله","لهو الضمين بعودة وإيابِ",78,"ب",1,0],["لا تين عندي ولا شعير","من دون ذا ينفق الحمار",79,"ر",1,0],["لا تيأسن إذا الكروب ترادفت","فلعلها ولعلها ولعلها",80,"ل",3,0],["لا تَيأَسَن إِن كُنتَ ذا حاجَةٍ","تَتعَبُ في نَزرٍ مِنَ الرِزقِ",81,"ق",1,1],["لا تيأسي من روح عائدة الهوى","كم عاد مقصوص إلى الطيران",82,"ن",1,0],["لا تيأسن ما عشت في تشييعه","مستعملاً فيه العزا والعقبا",83,"ب",2,0],["لا تيأَسنْ من رَوح ربِّك وارجُهُ","في كلِّ حالٍ فهو أَكرمُ من رُجِي",84,"ج",2,0],["لا تيأسوا فعسى ينادي عطفهم","إنا عفونا عنكم ورضينا",85,"ن",2,0],["لا تيأسن ففضل الله منبسطٌ","حقا ورحمته وسعت فلم تذر",86,"ر",1,0],["لا تيأسَنْ من رضوْح مَن","يُدني الخَلاصَ من القَفَص",87,"ص",1,0],["لا تيأسن قلبي الخلف من شيمي","وقبل قولي إذا أوعدت انجازي",88,"ي",1,1],["لا تيأسن من اللبيب وإن جفا","واقطع حبالك من حبال الأحمق",89,"ق",1,1],["لا تيأسنْ إن مسك الضرُّ","واسأل تجبك لضرك الغرّ",90,"ر",1,1],["لا تيأسنَّ ..فذي التي في أمرِها ..","قالَ الإلهُ .. اهبطْ وكُلْ مِن خيرِها",91,"ر",3,0],["لا تيأسُنّ فسامي قد أضاء لكم","درب الجهاد وهذا من عطاياهُ",92,"ا",2,0],["لا تيأسنّ , فإنّ الله راحمنا","ولْتُبقِ حبلك موصولا بمقتدِر",93,"ر",1,0],["لا تيأسَنّ , أيا أُخَيَّ , فأنتمُ","برعاية المولى وربٍّ يرقُبُ",94,"ب",1,0],["لاتيأسن ففي الحياةِ مرافئ","للحلم يا من للصعابِ تطيقُ",95,"ق",1,1],["لاْ تَيْأَسَنَّº وَلَوْ جَاْرَ الزَّمَاْنُº وَإِنْ","عَاْدَاْكَ يَاْ فَاْقِدَ الأَحْبَاْبِ عُذَّاْلُ",96,"ل",1,0],["لاْ تَيْأَسِيْ يَاْ بِنْتُ إِنِيْ","فِيْ غَرَاْمِكِ غَيْرُ يَاْئِسْ",97,"س",1,0],["لا تيأسوا فالله ناصر عبده","مهما أُحيطَ بكومةِ الأخطارِ",98,"ر",1,0],["لا تَئِنِّي، ولا تَروحي وَتَغْدي","ليسَ في الحَقْلِ شاخِصٌ يُسْتَباحُ",99,"ح",1,0],["لاتيأسوا إنَّ الأعادي حولنا","يرجون فينا بؤسَنا لا باسَنا",100,"ن",2,0],["لا تيأسوا إنّ الطريق إلى الهُدى","سَهْلٌ لكوثَرِهِ من الوَهابِ",101,"ب",1,0],["لا تَيْأَسَنَّ فَإنَّ رَبَّكَ غَافِرٌ","سِر لِلأمَامِ وَلا تَلَفَّتْ لِلوَرَا",102,"ر",2,0],["لا تيأسا ما أصاب القوم من وهنٍ","بالله معتقدٌ والأمر تدبيرُ",103,"ر",1,0],["لا تيأسنَّ إذا وجدْتَ خَصَاَصةً","ما الخيرُ إلا طاعةُ الرحمانِ",104,"ن",1,0],["لا تيأسنَّ من الأيامِ نائبةً","لكلِّ نازلةٍ فيها مفاتيحُ",105,"ح",1,0],["لا تيأسي إنِّي لعمركِ قادمٌ","لن تستطيعَ فراقَنا العنقاءُ",106,"ا",2,0],["لا تُيْئِسْ النَّفْسَ عِنْدَ الضِّيقِ مِنْ فَرَحٍ","كَمْ شِدَّةٍ بَعْدَها قَدْ جاءَ تَهْوِينُ",107,"ن",1,0],["لا تيأسن إذا حويت ف