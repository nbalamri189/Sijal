{"poems":[[53,"آب الرديني والحسام معا","https://www.aldiwan.net/poem30137.html","المنسرح"],[53,"صبرا على نوب الزما","https://www.aldiwan.net/poem30646.html","مجزوء الكامل"],[53,"لا تيأسن فربما","https://www.aldiwan.net/poem30659.html","الكامل"],[57,"إن كنت تغدو في الذنوب جليداً","https://www.aldiwan.net/poem24703.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"وقينة أبرد من ثلجه","https://www.aldiwan.net/poem9259.html","السريع"],[51,"رأيتك لا تلذ بطعم شيء","https://www.aldiwan.net/poem9419.html","الوافر"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[85,"أسلم محمد سيدى","https://www.aldiwan.net/poem6818.html","مجزوء الكامل"],[62,"لا تيأسن إذا ما كنت ذا أدب","https://www.aldiwan.net/poem52327.html","البسيط"],[45,"مل فما تعطفه رحمة","https://www.aldiwan.net/poem66828.html","السريع"],[28,"دعاني إلى جرجان والري دونه","https://www.aldiwan.net/poem5067.html","الطويل"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[46,"صنوف هذي الحياة يجمعها","https://www.aldiwan.net/poem23493.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12955","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[51,"حَرِّكْ مُنَاكَ إذا هَمَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=25843",""],[158,"من عوض الصبر عما فاته ربحا","https://www.aldiwan.net/poem58909.html","البسيط"],[158,"أما الوشاة به فقد ظلموه","https://www.aldiwan.net/poem58961.html","الكامل"],[158,"سيعيصني في الحب من ولهي به","https://www.aldiwan.net/poem59099.html","الكامل"],[158,"لا تيأسن فالرجا كم فرجا","https://www.aldiwan.net/poem59113.html","الرجز"],[209,"عودوا إلى الوصل ثم عودوا","https://www.aldiwan.net/poem46615.html","مخلع البسيط"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[268,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[280,"يا من تدرع في حمل الحمول ويا","https://www.aldiwan.net/poem32288.html","البسيط"],[402,"لا تيأسن فكم ظلام دامس","https://www.aldiwan.net/poem49404.html","الكامل"],[402,"لا تيأسن لعسرة فوراءها","https://www.aldiwan.net/poem49870.html","الكامل"],[402,"يا من جفا إذ رأى في ظاهري خللا","https://www.aldiwan.net/poem49894.html","البسيط"],[426,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[429,"إذا تذكرت أياما مضت فمضى","https://www.aldiwan.net/poem12499.html","البسيط"],[462,"لا تيأسن من أخ ولى بجانبه","https://www.aldiwan.net/poem3535.html","عموديه"],[536,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"]],"verses":[["لا تَيأَسوا مِن ثُقوبِ زَندِهِمُ","كَأَنَّني بِالزَمانِ قَد قَرَعَه",0,"ع",2,0],["لا تَيأَسَن مِن أَن تَعو","دَ عَوائِدٌ وَتَهُبَّ ريحُ",1,"ح",1,0],["لا تَيأَسَنَّ فَرُبَّما","عَظُمَ البَلاءُ وَفُرِّجا",2,"ج",2,1],["لا تَيأَسَنَّ مِن لُطفِ رَبِّكَ في الحَشا","في بَطنِ أُمِّكَ مُضغَةً وَوَليدا",3,"د",2,0],["لَأَتَيتُها إِنَّ المُحِب","بَ مُكَلَّفٌ دَنِسٌ ثِيابُه",4,"ب",2,0],["لَأَتَيتُهُ بِالسَيفِ أَم","شي لا أُهَدَّ وَلا أَهابُه",4,"ب",2,0],["لا تَيأَسي وَتَجَلَّد","أَراكَ شَهماً رَكينا",5,"ن",2,0],["لا تَيأَسوا أَن تَستَرِدّوا مَجدَكُم","فَلَرُبَّ مَغلوبٍ هَوى ثُمَّ اِرتَقى",6,"ق",2,0],["لا تيأسَنَّ فإِنّ الله ذو كرم","وحُبُّكَ العاقِبَ الماحي الذُّنُوبَ مَحَا",7,"ح",2,0],["لَأَتَيتُهُ لا بُدَّ طالِبَهُ","فَاِقنَي حَياءَكِ وَاِقبَلي عُذري",8,"ر",2,0],["لا تيأسنْ أن يتوبَ ذو سَرَفٍ","يُضحي ويُمسي كثيرةً حُوَبُهْ",9,"ب",2,0],["لا تيأسي يا نفسُ من عَوْدةٍ","فالكبشُ لا يلهو عن النَّعجَهْ",10,"ج",2,0],["لاتيأسنَّ فإنّ رز","ق الله غادٍ رائحُ",11,"ح",1,0],["لا تيأسن وانتظر","ليل الغد المقارب",12,"ب",1,0],["لا تيأسن فإن ربّ","ك محدث إن شاء أمرا",13,"ر",2,0],["لا تيأسَنَّ إِذا ما كنتَ ذا أَدبٍ","على خمولِكَ أنْ ترقَى إِلى الفَلَكِ",14,"ك",1,1],["لا تَيأَسَن عَطفَ أَخي مَلَّةٍ","أَظهَرَ بَعدَ الوَصلِ هِجرانا",15,"ن",2,0],["لَآتِيَ مِن آلِ المُهَلَّبِ ثائِراً","بِأَعراضِها وَالدائِراتُ تَدورُ",16,"ر",1,0],["لا تئلُ العُصمُ في الهِضابِ وَلا","شَغواءُ تَغذو فَرخَينِ في لُجُفِ",17,"ف",1,1],["لا تَيأَسُ النَفسُ مِن تَفَضُّلِهِ","وَلَو أَقامَت في النارِ أَلفَ سَنَه",18,"ن",2,0],["لأتَيْتُ الإلَهَزَحْفاً، وعَفّرْتُ","جَبينيَ كَيْأسْتَمِيلَ الإلَهَا",19,"ا",1,0],["لا تَيأَسَن مِن وَصلِ ذي مَلَّةٍ","يُظهِرُ بَعدَ الوَصلِ هِجرانا",20,"ن",2,0],["لا تَيْأَسُوا فَلَكَمْ أُبِيدَتْ قَبْلكُمْ","أُمَمٌ بِيَأسٍ قَاتِلٍ وَمَلاَل",21,"ل",1,0],["لا تَيْئَسُوا من بُرْءِ ذي سَقَمٍ، وإن","طالَ العِلاجُ عليه أيَّ مَطالِ",22,"ل",1,0],["لا تيئسوا يا قوم؛ سو","ف تدقُّ للنصرِ البشائر",23,"ر",1,0],["لأتَى بِسَيْلٍ ما يُصِيبُ مَسِيلا","ولِسامِعٍ مِنْ فَضْلِهِ ما قيلا",24,"ل",2,0],["لا تيأسوا أنْ يَلُحْ مِن ليلةٍ","فجرٌ ، ولم تؤذِنْ بضوءِ نهار",25,"ر",1,0],["لأتَيْتُهَا، إنّ المُحِ","بّ مُكَلَّفٌ، دَنِسٌ ثيابُهْ",26,"ب",2,0],["لا تَيْأَسَنَّ فإنَّ رزْ","ق الله غادر رائح",27,"ح",1,0],["لا تيأسنَّ فما حالٌ بدائمةٍ","لو قلتَ للشرِّ لا تبرح ودم بِرَحا",28,"ح",2,0],["لا تيأسن من الكريم وعد يعد","للصالحات فإنها أهلوه",29,"و",2,0],["لا تيأسن وان أضربك الهوى","وطفقت من تثريبه تثري به",30,"ب",2,0],["لا تيأسن فالرجا كم فرّجا","فالرزق مقسوم ومهما فرجا",31,"ج",2,1],["لا تيأسوا قطّ من فؤاد","أنتم بأعماقه حللتم",32,"م",1,0],["لا تيأسوا في ضُعفِكم وبلائكم","والثأرُ خَلفٌ والرّدى قدّام",33,"م",1,0],["لا تَيأسي فَغداً يَحُلُّ محلَّهُ","بَطَلٌ بحدِّ حُسامهِ يَشفيك",34,"ك",1,0],["لا تَيأَسن روحُ مَن عادى لَدى مِئَةٍ","قاضي القُضاةِ الجَمالُ بنُ الحَرستاني",35,"ي",1,0],["لا تيأسَنَّ فكم ظلام دامِسٍ","عطسَ الصباحُ خِلالُهُ فتنفسا",36,"س",2,1],["لا تيأسَنَّ لعُسرَةٍ فوراءَها","يُسرانِ وَعداً ليسَ فيهِ خِلافُ",37,"ف",1,1],["لا تيأسَنٌ منَ المرضى وأنْ ضعُفوا","ولن يفوتَهُمُ الإنعاشُ إنْ عاشُوا",38,"ش",3,0],["لا تيأسنّ أخا البأساء من فرجٍ","يأتيك من حيث لا يرتاده البالُ",39,"ل",1,0],["لا تيأسنّ فللأيامِ منقلَبٌ","ولا تُرَعْ فلصرفِ الدّهرِ منصرَفُ",40,"ف",1,0],["لا تيأسنْ من أخٍ ولّى بجانبه","وإن بدتْ لك منهُ سوء أخلاق",41,"ق",1,1],["لاتِينىَ الأحيَاءِ هَل من عَودةٍ","للِقائِه تَشفِي غليلَ الصَّادِي",42,"د",2,0]]}