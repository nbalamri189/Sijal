",""],[50,"لقدْ ودَّعَتْ حُبّى وهام رقيبي","https://www.poetsgate.com/ViewPoem.aspx?id=19933",""],[85,"عادت أغاني العرس رجع نواح","https://www.poetsgate.com/ViewPoem.aspx?id=478",""],[58,"فَأَهْلاً وَسَهْلاً بِضَيْفٍ نَزَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=22768",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[45,"أبا العباس برزت على قوم","https://www.poetsgate.com/ViewPoem.aspx?id=31166",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[2,"لعمركَ، والخطوبُ مغيراتٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=5323",""],[51,"يا مَنْ جلا دهْرُنا دُجاهُ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30095",""],[78,"أمعتَضِداً بِاللَه دَعوَةَ آمِلٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86542&r=&rc=87",""],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""]],"verses":[["فَاِمضِ لا غَرَّني الزَمانُ بِعَهدٍ","في خَليلٍ وَلا بِعَقدِ ضَمانِ",0,"ن",1,0],["فَإِمّا تَفيضُ بِغَمرِ النَوالِ","عَلى المُعتَفينَ وَإِمّا بِدَم",1,"م",1,0],["فَاِملِك بِها رِقّي وَحَرِّر بِها","عُنقي وَرِقُّ الحُرِّ لِلمُنعِمِ",2,"م",1,0],["فَإِمّا تَرَيَنّي اليَو","مَ يَبلوني الَّذي يَبلو",3,"ل",2,0],["فَأَمّا وَلا وَجدٌ يَزولُ بِعَبرَةٍ","فَصَبرُ الفَتى عِندَ البَلاءِ جَميلُ",4,"ل",1,0],["فَأَمسَت لَهُ بَينَ الغِمادِ وَأَربَقٍ","رُهونُ مَنايا ما لَهُنَّ فِكاكُ",5,"ك",1,0],["فَاِمتَرَينا ثُمَّ قُلتُ لَهُم","لَيسَ هَذا مَطلِعُ القَمَرِ",6,"ر",1,0],["فَأَمّا النَظمُ ناظِمُهُ","وَأَمّا النَثرُ ناثِرُه",7,"ر",2,0],["فَإِمّا نَيلُ جانِبِها وَإِمّا","لِقاءُ مُسَنَّدينَ عَلى الجُنوبِ",8,"ب",1,0],["فَإِمّا أَملَأُ الدُنيا عَلاءً","وَإِمّا أَملَأُ الدُنيا مُصابا",9,"ب",2,0],["فاِمتَطَى العيسَ علَى عَجَلٍ","عاذِلٌ مِنّا وَمَعذولُ",10,"ل",1,0],["فَأَمّا الَّذي يَخفَى فَشَوقٌ أُجِنُّهُ","وَأَمّا الَّذي يَبدو فَدَمعِيَ جارِيا",11,"ي",2,0],["فَأَمسُهُم قاصِرٌ عَن يَومِهم شَرَفاً","وَيَومُهُم حاسِدٌ في فَضلِهِم غَدَهُمْ",12,"م",1,0],["فأمْطَيْتَني جَوْنَ الإهابِ مُطَهَّماً","يُلاثُ على السِّيدِ الأزَلِّ حِزامُهُ",13,"م",2,0],["فإما أن تُغالِبَهُمْ عَزيزاً","وإما أنْ تُداريَهُمْ ذَليلا",14,"ل",2,0],["فَأَمّا القائِلونَ هِزَبرُ قَومٍ","فَذاكَ الفَخرُ لا شَرَفُ الجُدودِ",15,"د",1,0],["فَأَمسى بَعيداً في غَرامٍ وَذِلَّةٍ","وَقَيدٍ ثَقيلٍ مِن قُيودِ التَوابِعِ",16,"ع",1,0],["فِإِمّا مُتُّ مِن شَوقي إِلَيكُم","فَقَبلي ماتَ مِن شَوقٍ جَميلُ",17,"ل",1,0],["فَأَمّا الضَميرانِ مِنّا فَفي","عَذابٍ طَويلٍ وَوَجدٍ شَديدِ",18,"د",1,0],["فَإِمّا أَن يَكونَ بِها شِفائي","وَإِمّا أَن أَموتَ فَأَستَريحا",19,"ح",2,0],["فَاِمنُن عَلَيَّ بِذِكرِ الصالِحينَ وَلا","تَجعَل عَلَيَّ إِذاً في الدينِ مِن لَبَسِ",20,"س",1,0],["فَأَمَّنَنِي الدَّهْرُ الّذِي قَدْ أَخَافَنِي","وَجَدَّدَ لِي السَّعْدَ الَّذِي كَانَ أَبْلاَنِي",21,"ي",1,0],["فَآمَالُهُ لِلْفِكْرِ نَصْبٌ وَعَيْشُهُ","كَمَا شَاءَ هُ خَفْضٌ وَطَاعَتُهُ جَزْمُ",22,"م",1,0],["فآمَنَ قلْبُ اللّوزِ منْ عِلّةِ النّوا","وأصْبَحَ فيها التّينُ منْشَرِحَ الصّدْرِ",23,"ر",1,0],["فأما اصْطِباري فهْو أوّلُ راحِلٍ","وأمّا اشْتِياقي فهْوَ أوّلُ قاعِدِ",24,"د",1,0],["فَامْدُدْ لَهَا كَفّاً بُنَيَّةَ سَاعَةٍ","لكِنْ أَبُوهَا دُونَ فَخْر مُنْجِبُ",25,"ب",1,0],["فَإِمّا تَرَيني لا أَريمُكِ قاعِداً","لَدى البابِ لا أَغزو وَلا أَتَغَيَّبُ",26,"ب",1,0],["فَأَمّا إِذا ما أَدلَجَت فَتَرى لَها","رَقيبَينِ جَدياً لا يَغيبُ وَفَرقَدا",27,"د",2,0],["فَإِمّا تَرَيني عَلى آلَةٍ","قَلَيتُ الصَبى وَهَجَرتُ التِجارا",28,"ر",2,0],["فَأَمسَكَ يَنظُرُ حَتّى إِذا","دَنونَ مِنَ الرِيِّ أَو قَد رَوينا",29,"ن",2,0],["فَأَمسَيتَ تُذكَرُ في الغابِرينَ","وَإِن قَلَّ مِثلُكَ فيمَن غَبَر",30,"ر",1,0],["فَأَمسِكا الراحَ إِنّي لا أُخامِرُها","وَبَلِّغا الغيدَ عَنّي سَلوَةَ الغيدِ",31,"د",1,0],["فَاِمنُن بِنَفسٍ لَم يَشُبها الأَسى","لَعَلَّها تَعرِفُ طَعمَ الهَناء",32,"ا",2,0],["فَإِمّا حَياةٌ تَبعَثُ المَيتَ في البِلى","وَتُنبِتُ في تِلكَ الرُموسِ رُفاتي",33,"ي",1,0],["فَأَمرُكَ طاعَةٌ وَرِضاكَ غُنمٌ","وَسَيفُكَ قاطِعٌ وَنَداكَ جَزلُ",34,"ل",1,0],["فَإِمّا مَقاماً يَضرِبُ المَجدُ حَولَهُ","سُرادِقَهُ أَو باكِياً لِحِمامي",35,"م",2,0],["فَامنُن بِها مِثلَ ديني رِقَّةً وَشَذى","ذِكراكَ طيباً وَقَلبي في هَواكَ صَفا",36,"ف",2,0],["فَأَمسى ثَبيرٌ قَد تَصَدّى لِحَملِهِ","سَريرٌ فَلَم يَبهَضهُ مِن هَضبِهِ إِصرُ",37,"ر",1,0],["فَأَمطاكَ مِنكَبَ طَرفِ النُجومِ","وَأَوطَأَ أَخمَصَكَ الفَرقَدا",38,"د",2,0],["فَأَمّا يَومَ خَشيَتِنا عَلَيهِم","فَتُصبِحُ خَيلُنا عُصَباً ثُبينا",39,"ن",2,0],["فَإِمّا تَرَيني في رِحالَةِ جابِرٍ","عَلى حَرَجٍ كَالقَرِّ تَخفُقُ أَكفاني",40,"ن",2,0],["فَإِمّا تَريني لا أُغَمِّضُ ساعَةً","مِنَ اللَيلِ إِلّا أَن أَكُبَّ فَأَنعَسا",41,"س",2,0],["فَإِمّا تَرَيني اليَومَ أُبدي جَلادَةً","فَإِنّي لَعَمري تحتَ ذاكَ كَليمُ",42,"م",1,0],["فَأَمسى يَسُحُّ الماءَ فَوقَ وُعَيرَةٍ","لَهُ بِاللوى وَالواديَينِ حَوائِرُ",43,"ر",1,0],["فأمْسَى الحَوامي قَدْ تَعَفّيْنَ بَعدَهُ","وكانَ الحَصَى يَكْسو دَوابِرَها دما",44,"م",2,0],["فَإِمّا يُمسِ في جَدَثٍ مُقيماً","بِمُعتَرَكٍ مِنَ الأَرواحِ قَفرِ",45,"ر",1,0],["فَإِمَّا سَمِعْتَ حَدِيثاً لُهُ","فَأَنْتَ سَمِيعُ حَدِيثٍ عُجَبْ",46,"ب",1,0],["فَأَمَّا سَجَايَاهُ فَقُلْ فِي كَمَالِهَا","وَلا تَخْشَ فِي الإِطْرَاءِ لَوْمَةَ لائِمِ",47,"م",1,0],["فَإِمَّا تُثِرْ مِنْهُ الْحَفِيظَةُ ثَائِراً","فَفِي مَجِّهِ مَا لا تَمُجُّ الأَرَاقِمُ",48,"م",1,0],["فَإِمَّا أَنْ تَعِيشَ وَأَنْتَ حُرٌّ","فَذَاكَ مِنَ التَّغَالِي فِي المرَامِ",49,"م",1,0],["فَإِمَّا تَكَامَلْتُمْ كَمَا نَبْتَغِي لَكُمْ","فَتِلْكَ المُنَى تَمَّتْ وَذَاكَ التَّقَدُّمُ",50,"م",1,0],["فَأمَّا البَحْثُ يَنْضُو الرَّأْيَ فِيهِ","وَيَنْهَضُ مِنْهُ بِالعِبْءِ الجَسيْمِ",51,"م",1,0],["فأمَّا وَهُمْ مَا قَدْ عَهِدْتُ وَلَمْ تَزَلْ","بِهِمْ حَاجَةُ الأَفْراسِ لِلسَّرْجِ وَاللُّجْمِ",52,"م",1,0],["فَأَمَّمَتكَ وَقَد ذابَت مَفاصِلُها","مِن طولِ ما تَعَبٍ لاقَت وَمِن نَقَبِ",53,"ب",1,0],["فَأَمّا المُمَضّاتُ الَّتي لَستُ بالِغاً","مَبالِغَها مِنّي بِكُنهِ صِفاتِ",54,"ت",1,0],["فَأمسوا بِما بَينَ الهِضابِ عَشيَّةً","بِتَيماءَ صَرعى مِن مُقَضٍّ وَزاهِقِ",55,"ق",1,0],["فأمست وأفواه المدافع دونها","تمُجّ عليها النار كالوابل السكب",56,"ب",1,0],["فأمسَوْا وفي ليل المحاق اجتماعهم","يحفّون من هرير صموئيل بالبدر",57,"ر",1,0],["فإما المنايا نستطب بطبّها","وإما مُنىً فيها يتِمّ لنا السَبق",58,"ق",1,0],["فأمست من العُمران خلواً بلادهم","فهنَ حُزون قفرة وسهول",59,"ل",1,0],["فَأَمثَلُ ما في صِهرِكُم أَنَّ صِهرَكُم","مُجيدٌ لَكُم لَيَّ الكَتيفِ وَشاعِبُ",60,"ب",1,0],["فَأَمّا النَصارى العابِدونَ صَليبَهُم","فَخابوا وَأَمّا المُسلِمونَ فَأَفلَحوا",61,"ح",3,0],["فَآمِر والِدَيكَ تَلُمكَ حُبّى","وَلَو أَسمَعتَ قَبرَ أَبيكَ صاحا",62,"ح",2,0],["فَأَمّا يَومَ آتيها فَإِنّي","كَأَنَّ المُزنَ تُمطِرُني رِهاما",63,"م",2,0],["فَإِمّا تَرَيني اليَومَ عِندَكِ سالِماً","فَلَستُ بِأَحيا مِن كِلابٍ وَجَعفَرِ",64,"ر",1,0],["فَإِمّا تُصيبُ النَفسُ أَكبَرَ هَمِّه","وَإِمّا أُبَشِّركُم بِأَشعَثَ غانِمِ",65,"م",1,0],["فأما أمية من وائل","فمستدبر المجدِ مستقبلُ",66,"ل",1,1],["فإما الأزدُ أزدُ أبي سعيد","فاكره أن أسمِّيها المزونا",67,"ن",2,0],["فأمسوا يبرقون بعارضيهم","لنا في المبرقين ويرعدونا",68,"ن",2,0],["فَأَمَّا الأَسدُ أَسدُ أَبي سَعِيدٍ","فَأكرَهُ أن أُسَمِّيهَا المَزُونَا",68,"ن",2,0],["فَأَمّا وَقَد طالَ الصُدودُ فَإِنَّهُ","يَقَرُّ بِعَينَيَّ الخَيالُ المُزاوِرُ",69,"ر",1,0],["فَإِمّا تُعرِضوا عَنّا اِعتَمَرنا","وَكانَ الفَتحُ وَاِنكَشَفَ الغِطاءُ",70,"ا",2,0],["فَإِمّا تَثقَفَنَّ بَنو لُؤَيٍّ","جَذيمَةَ إِنَّ قَتلَهُمُ شِفاءُ",70,"ا",2,0],["فَأَمسى رَسمُها خَلَقاً وَأَمسَت","يَباباً بَعدَ ساكِنِها الحَبيبِ",71,"ب",1,0],["فَإِمّا هَلَكتُ فَلا تَنكِحي","خَذولَ العَشيرَةِ حَسّادَها",72,"د",3,0],["فَأَمسى سِراجاً مُستَنيراً وَهادِياً","يَلوحُ كَما لاحَ الصَقيلُ المُهَنَّدُ",73,"د",1,0],["فأما واجدٌ فروَى رباحٌ","وإمَّا مقتر فروى عطاء",74,"ا",2,0],["فامْدُد إلى القلم اليمين فإنها","نعمَ اليمينُ ت