مرٍ تَتَّبِع",171,"ع",1,0],["فَأَمّا الدَليلُ لِنَقصِ الحُظوظِ","فَإِرثُهُمُ نِصفُ إِرثِ البَنينا",172,"ن",2,0],["فَأُمسي وَالشَوامِتُ بي هَوازٍ","كَما شَمِتَت بِبَكرٍ في هَوازِن",173,"ن",1,0],["فأمسيتُ منها بماءِ اللمى","أُرَوّي أُواماً وأشْفي سقاما",174,"م",2,0],["فَإِمّا جازَ مِنّي الشِعرُ فيهِم","وَإِمّا جازَ مِنكَ الكيمِياءُ",175,"ا",2,0],["فَأَمكَنتَهُ مِن رُمَّةِ العَفوِ رَأفَةً","وَمَغفِرَةً إِذ أَمكَنَتكَ مَقاتِلُه",176,"ل",2,0],["فَاِمدُد عِناني بِوَأى ضِلعُهُ","تَثبُتُ وَالعُذرَةُ مِنهُ تَنوس",177,"س",1,0],["فَأَمّا عُيونُ العاشِقينَ فَأُسخِنَت","وَأَمّا عُيونُ الشامِتينَ فَقَرَّتِ",178,"ت",1,0],["فَأَمَّا وَقَدْ حَقَّ الْجَزَاءُ فَلَمْ أَكُنْ","لأَنْطِقَ إِلَّا بِالثَّنَاءِ الْمُنَمْنَمِ",179,"م",1,0],["فَأَمّا الَّذي فيهِ عَتِبتِ فَأَنفُهُ","لِأَنفِكِ في صَرمِ الخَلائِقِ أَرغَمُ",180,"م",1,0],["فَأَمسَت أَحاديثَ الفُؤادِ وَهَمَّهُ","وَإِن كانَ مِنها قَد غَدا لَم يُنَوَّلِ",181,"ل",1,0],["فَإِمّا تَرَيني كَساني السِفا","رُ لَونَ السَوادِ وَجِسماً نَحيفا",182,"ف",2,0],["فَإِمّا تُعرِضي عَنّا وَتُعدي","بِقَولِ مُماذِقٍ مَلِقٍ كَذوبِ",183,"ب",1,0],["فَإِمّا كَما تَعدو الضَراغِمُ عَنوَةً","وَإِمّا كَما تَمشي الضَراءُ ذِئابُ",184,"ب",1,0],["فَاِمنُن بِها يَدَ نِعمَةٍ يُزهى بِها","مِن غِرَّةٍ هَذا الزَمانُ الأَدهَمُ",185,"م",1,0],["فَأَمّا لَيلُهُنَّ فَخَيرُ لَيلٍ","وَأَطوَلُ ما يَكونُ مِنَ النَهارِ",186,"ر",1,0],["فَأَمّا الشِدادُ فَتَمضي سِراعاً","وَأَمّا الضِعافُ فَتَمشي اِتِّئادا",187,"د",2,0],["فَأَمسَت بِمُستَنِّ العَوادي تَضيمُها","وَقد لَبِثَت دَهراً تَضيمُ العَوادِيا",188,"ي",2,0],["فَإِمّا العَيشُ في ظِلِّ المَعالي","وَإِمّا المَوتُ في ظلّ القَتامِ",189,"م",1,0],["فإمّا حِمَى الإسلامِ أو حدُّ قاضبٍ","على مَتْنِهِ مِنهم دَمٌ يَتَفَجَّرُ",190,"ر",1,0],["فأمسى الأمرُ فيهم مُستقيماً","ولو عَرَفوا المحجَّةَ لاسْتَقاموا",191,"م",3,0],["فأمسَكَ كلَّ دَمْعٍ مُستَهلٍّ","وَسَكَّنَ كلَّ قلبٍ مُستطارِ",192,"ر",1,0],["فأمسَتْ قُرَيْشٌ ما لها من بَقِيَّةٍ","وأَمْسَى الذي اعتادت من العزِّ داثرا",193,"ر",2,0],["فأما لَبيدٌ فَاسْتعانَ بسحرِه","رُويداً أخا هاروتَ تلك 