om/ViewPoem.aspx?id=208590",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5525,"اللوعة","https://www.poetsgate.com/ViewPoem.aspx?id=7224",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""],[5573,"خالي انتم خابرينه","https://www.poetsgate.com/ViewPoem.aspx?id=201921",""],[5586,"جلل ألم على الكرام فهالا","https://www.poetsgate.com/ViewPoem.aspx?id=173782",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""],[5628,"التحول","https://www.poetsgate.com/ViewPoem.aspx?id=178547",""],[5674,"والشعراء بعدي شاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=189086",""],[5674,"الشعراء بعدي شاهده","https://www.poetsgate.com/ViewPoem.aspx?id=198683",""],[5701,"بين المحاكم قاض","https://www.poetsgate.com/ViewPoem.aspx?id=164694",""],[5721,"لم أعد حتى بنفسي مؤمنا","https://www.poetsgate.com/ViewPoem.aspx?id=214510",""],[5725,"كذب العنادل","https://www.poetsgate.com/ViewPoem.aspx?id=193671",""],[5730,"لا أنت تائبة ولا أنا تائبُ","https://www.poetsgate.com/ViewPoem.aspx?id=210348",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[402,"انفرط العقد ويا حسنه","https://www.poetsgate.com/ViewPoem.aspx?id=35501",""],[5790,"عذلوا عليك فأكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=112043",""],[5790,"بين القلوب وبين الأعين النجل","https://www.poetsgate.com/ViewPoem.aspx?id=112117",""],[5790,"هزوا القدود وأرهفوا سمر القنا","https://www.poetsgate.com/ViewPoem.aspx?id=111945",""],[5790,"عانقته فسكرت من طيب الشذا","https://www.poetsgate.com/ViewPoem.aspx?id=111932",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5848,"لا تخلين زايد","https://www.poetsgate.com/ViewPoem.aspx?id=50593",""],[5873,"اِزدهار الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215410",""],[5885,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[5946,"لا أنت ولا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=212003",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"سيارة وسط الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=184691",""],[5991,"أبداً بكم منكم إليكم اهرب","https://www.poetsgate.com/ViewPoem.aspx?id=116382",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6144,"يا أهل السودان يا عرب","https://www.poetsgate.com/ViewPoem.aspx?id=13799",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6202,"بنت قحطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86713&r=&rc=14",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[6229,"الغصن الذاوي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65173&r=&rc=5",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""]],"verses":[["لا أَنتَ تُعجِبُنا يا نَجدُ بَعدَهُمُ","وَلا لَنا بالحِمى عَيشٌ كَما كانا",0,"ن",2,0],["لا أَنامَ اللَهُ عَيناً رَقَدَت","وَمَليكي ساهِرٌ يَشكو السَقَم",1,"م",1,0],["لا أَنتَ تَقصُرُ لي وَلا أَنا مُقصِرٌ","أَتعَبتَني وَتَعِبتَ هَل مَن يَحكُمُ",2,"م",1,0],["لا أَنتَ تُصغي لِلعَذو","لِ وَلا أُبالي مَن يَلومُ",3,"م",1,0],["لا أَنزُرُ النائِلَ الخَليلَ إِذا","ما اِعتَلَّ نَزرُ الظؤورِ لَم تَرِمِ",4,"م",1,0],["لا أنظم الأحزان في أيَّامها","أو ما ترى كسرى على كاساتها",5,"ت",3,0],["لا أنسَ بشرك والزمان مقطّبٌ","ونوال كفّك والغمام نحيل",6,"ل",1,0],["لا أنَّ لؤمَك جُنَّة لكنه","نَجَسٌ يعاف ورودَه الورَّادُ",7,"د",1,0],["لا إنْ جفوْتُم قضى العليلُ ولا","إن عُدْتُمُ تُنْسِئون في أجلِهْ",8,"ل",2,0],["لا أَنا دَمعَةٌ وَلا أَنا عَينٌ","لَستُ خالاً أَو وَجنَةً حَمراءَ",9,"ا",2,0],["لا أَنتُمُ أَنتُم وَلا أَرباضُكُم","تِلكَ الَّتي فيها الهَناءُ يَقيلُ",10,"ل",1,0],["لا أُنهِئُ الأَمرَ إِلّا رَيثَ أُنضِجُهُ","وَلا أُكَلِّفُ عَجزَ الأَمرِ أَعواني",11,"ن",2,0],["لا أَنظمُ الشِّعْرَ أَرجو","بهِ رضاءَ الأَميرِ",12,"ر",1,0],["لا أَن يَكونَ هَكَذا مَقالي","فَتىً بِنيرانِ الحُروبِ صالِ",13,"ل",1,0],["لا أَنسَيَن زَمَناً لَدَيكَ مُهَذَّباً","وَظِلالَ عَيشٍ كانَ عِندَكَ سَجسَجِ",14,"ج",1,0],["لا أَنتَ تُنجِزُ حاجاتي فَتُنعِشُني","وَلا تُدافِعُني دَفعاً بِتَأيِيدِ",15,"د",1,0],["لا أَنتَ أَعطَيتَ الجَزيلَ وَلا حَنَت","شاجي عَلَيَّ وَلا أَوَت لِيَ رامي",16,"م",2,1],["لا أَنثَني عَنها وَلا","أَرضى بِأَثرٍ بَعدَ عَينِ",17,"ن",1,0],["لا أنت تدرين وما من أحَد","بواصفٍ حسنَك مهما اجتهد",18,"د",1,0],["لا أَنَّهُ خَذَلَتهُ أَسبابُ الغِنى","أَو راحَ مِن سَلَبِ المُلوكِ سَليبا",19,"ب",2,0],["لا أَنَّ خَلفَكِ لِلَّذّاتِ مُطَّلَعاً","لَكِنَّ دونَكِ مَوتَ اللَهوِ وَالطَرَبِ",20,"ب",1,0],["لا أَنتَ أَنتَ وَلا الدِيارُ دِيارُ","خَفَّ الهَوى وَتَوَلَّتِ الأَوطارُ",21,"ر",1,1],["لا أنكرُ التسميرَ في أحداقهمْ","فعذابُ مثلهمُ حلالٌ مطلقُ",22,"ق",1,1],["لا أَنسَ طولَ الحَياةِ ما بَقِيَت","بِطَيبَةٍ رَوضَةٌ لَها شَجَرُ",23,"ر",1,0],["لا أَنسَ مَوقِفَنا وَهناً وَمَوقِفَها","وَتِربُها بِتُرابانا عَلى خَطَرِ",24,"ر",1,0],["لا أَنعَتُ الرَوضَ إِلّا ما رَأَيتُ بِهِ","قَصراً مِنيفاً عَلَيهِ النَخلُ مُشتَمِلُ",25,"ل",1,0],["لا أندبُ الربعُ قفراً غير مأنوس","ولا أحن إلى الحادي ولا العيس",26,"س",1,1],["لا أنس نعشك سائراً","في أَول الجم الغَفير",27,"ر",1,0],["لا أنت نائيةٌ ولا أنا ناءِ","إني لديك مُقَيَّدٌ بوفائي",28,"ي",1,0],["لا أَنِيسٌ يَسْمَعُ الشَّكْوَى وَلا","خَبَرٌ يَأْتِي وَلا طَيْفٌ يَمُرْ",29,"ر",1,0],["لا أَنْتَ تَرْحَمُنِي ولا نَارُ الْهَوَى","تَخْبُو وَلاَ للنَّفْسِ عَنْكَ عَزاءُ",30,"ا",2,0],["لاَ انْفَرَطَ العِقْدُ الَّذِي ضَمَّكُمْ","وَلَيْكُ ذَاكَ العِقْدُ نِعْمَ الفِدَى",31,"د",2,0],["لاَ أَنْكَرَتْ رُوْحُكَ التَّي أَمِنَتْ","مَا فَارَقَتْ مِنْ مَخَاوِفِ الْجَسَد",32,"د",1,0],["لا أنام ولا أذوق كرى،","أنا لست من يحيا لفجر غد",33,"د",1,0],["لا، أنت محييتي ومنقذتي","من عيشي المتنكر النكد",33,"د",1,0],["لا أَنقُشُ اِسمَكَ في الخيتامِ مِن شَغَفٍ","قَلبي أَحقُّ بِهِ مِن فصِّ خَيتامِ",34,"م",1,0],["لا أنثنى الماضي، ولا الآتي دنا","مَن ترى بينهما أُعطي قيادي؟",35,"د",2,0],["لا أنْسَيَنْ زَمَناً لَدَيْكَ مُهُدَّباً،","وَظِلالَ عَيشٍ كان عندكَ سَجسَجِ",36,"ج",1,0],["لا انسَ موقفها وهناً وموقفنا،","وتربها بترابانا على خطر",37,"ر",1,0],["لا أنت للسد إن عد الكرام ولا","للهد في الحرب إن نادى مناديه",38,"ه",1,0],["لا أنسَى لَوعَةَ يَومَ البَينِ ظَعنُهُمُ","تَحدُو الحُدَاةُ بها العَيدِيَّةَ الذُّلَلا",39,"ل",2,0],["لا أَنتَ مُتبِعُ ما صَنَعتَ بِأَهلِهِ","مَنَّ المُنيلِ وَلا هُمُ كُفّارُهُ",40,"ر",2,0],["لا أنت في السَّفَر الذين تقدَّموا","نحو النبي ولا أراك تقوم",41,"م",1,0],["لا أنسى أياماً قصاراً فيه لي","أضحى تذكرها عليَّ طويلاً",42,"ل",2,0],["لا أنزل النشر اليفاع مرجيّا","خيرا وأهبط بعده الوهدا",43,"د",2,0],["لا أنكرُ السحرَ وذا طرفهُ","أصبحَ بينَ الناسِ سحَّارا",44,"ر",2,0],["لا أنت أنت ولا وجدى سوى كلف","من شاعر بنمير الحسن غصّان",45,"ن",1,0],["لا أنشِدُ البُؤسَ وَلا أَرغَبُ","في حَمل حُبٍّ قَومُهُ عُذِّبوا",46,"ب",3,0],["لا أَنسى لَيلَةَ أَنشَدَني","لَحناً وَالحُبُّ يوقِّعُهُ",47,"ع",2,0],["لا أَنا بِالمُبَعَّدِ ال","أَقصى وَلا المُقتَرِبِ",48,"ب",1,0],["لا اِنتَهى عَن قبيح فعلي","وَلا أَصلي وَلا أَصوام",49,"م",1,0],["لا أَنْتِ زُرْتِ وَلا خَيالُكِ في الكَرَى","حَتَّى لَقَد هَجَر العَمِيدَ كَراهُ",50,"ا",2,0],["لا أُنْكِر البُرَحَاءَ في عَقِبِ النَّوَى","قَد حَلَّ بالتَّرْحالِ ما يُتَوَقَّعُ",51,"ع",1,0],["لا أنكرُ الضّد يلقى الضّدّ مذ جمعتْ","جوانحي وجفوني الماء واللَهبا",52,"ب",2,0],["لا أنثني عما به","ربيت من هجر الغرر",53,"ر",1,0],["لا أنكرنَّ الهوى مِن بعدما تُليَت","عليَّ من سوَر الأَحباب آياتُ",54,"ت",1,0],["لا أنسى وقد كتبت ليلاً","ما كدت من الهوى أبسمل",55,"ل",1,1],["لا أنس لما قال لي مستفهماً","والراح قد راضته لي فتسهلا",56,"ل",2,1],["لا أنا ملء راحتي لا ولا","عمري طوع الأغلال والأرسان",57,"ن",1,0],["لا أنا خالد ولا أمنياتي","فوداعاً مسارح الذكريات",58,"ت",1,1],["لا أَنَّ لي ذَنباً لَدَيهِ عَلِمتُه","إِلّا تَظاهُرَ نِعمَةِ الرَحمَنِ",59,"ن",1,0],["لا أنام الليل إلا ساعة","ملؤها الأشباح تبدو محنا",60,"ن",2,0],["لا أَنْسَ لا أَنسَ وَقَد","أَدارَ رَاحَاً عَطِرَه",61,"ر",2,0],["لا أَنتَ لي تُعطي وَلا هُوَ في الكَرَى","لَيْتَ الوُشَاةَ مَضَوْا بِحَظِّي مِنكُما",62,"م",2,0],["لا اِنبَرى لِلوَرى يرى كُلَّ يَوم","بِكَ عيد عَلى مَمَرّ السِنينِ",63,"ن",1,0],["لا اِنبرَى يَلقى هنا وَمنى","ظافِراً فيما يبادرُه",64,"ر",2,0],["لا اِنبرَى يَلقى هنا وَمنى","ظافِراً فيما يُحاولُه",65,"ل",2,0],["لا اِنبرَى يَلقى هنا وَمنى","ظافِراً فيما يراقبُه",66,"ب",2,0],["لا اِنبَرى يَلقى هنا وَمنى","لَم يَزَل بِاللَه مُحتسبا",67,"ب",2,0],["لا أنا أنْساهُ فأسْلو ولا","تَذكُرُه أنتَ فتَرعاه",68,"ا",2,0],["لا إنْ تأَنّى مُضِيعٌ فُرصةً عرضَتْ","له ولا مِنْه تُخشَى زَلّةُ العَجَل",69,"ل",1,0],["لا أَنتَ تُعطيني وَلا أَنا أَسأَلُ","وَالصَبرُ يَعجِزُ وَالضَرورَةُ تَحمِلُ",70,"ل",1,1],["لا اُنْسَ إلاّ في مجالِسَ تلتقي","بفنائها الأشكالُ والنُّظَراءُ",71,"ا",2,1],["لا أَنحل الأَيام نَحلاً بَعدَ ذا","حَسبي بِأَنَّكَ نَفحة مِن جودِها",72,"د",3,0],["لا أَنتَ عِندَ اليُسرِ مِن زُوّارِهِ","يَوماً وَلا في العُسرِ مِن عُوّادِهِ",73,"د",2,0],["لا آنس الله أيام العراق فقد","أودت بقلب فتى ذابت سويداه",74,"ا",2,0],["لا انفكّ رأيك من مجد يؤثّلهُ","ولا يرحت قرير العين محمودا",75,"د",2,0],["لا انتهي والله لو عنفتني","وقرأت لي التوراة والانجيلا",76,"ل",2,0],["لا أن ينال لترهات هن","نعمة من وهم",77,"م",1,0],["لا أن يجانبني نذلا ويهجرني","والموت يرمقني في موقف الجاني",78,"ن",2,0],["لا أَنسَهُ يَوماً وَقَد جاءَنا","مُخَرَّقُ الأَشداقِ وَالمَنخَرِ",79,"ر",1,0],["لا أَنسَ أَيّامي وَلا أَطرابي","أَيّامَ كُنتُ أَجُرُّ ذَيلَ شَبابي",80,"ب",2,1],["لا انْقَضى فيهِمْ شُجوني أَبداً","كيفَ والشَّجْوُ اصْطِلامٌ منهُمُ",81,"م",1,0],["لا أَنساكَ ما اِرسى ثَبير مَكانَه","وَما دامَ جارا لِلحَجونِ المُحَصَّبُ",82,"ب",1,1],["لا أنْسَ لا لا أَنْسَ إذْ وَدَّعْتُه","مِنُهُ التَّذَلّلَ حين حَانَ فِراقُ",83,"ق",1,0],["لا أنني خائف من قولها أحدا","لو أغضبت هذه الدنيا ومن فيها",84,"ي",3,0],["لا أَنْصَفَتْنَا المقاهي في صداقتِها","بالعاشقينَ، ولا وَفَّتْ (حَوَارِي)نا",85,"ن",2,0],["لا أنت ممن عليه العتب يحسن بي","ولا سماعي لما تبديه من شيمي",86,"م",2,0],["لا أنا أيضاً ولا أنتم ولا","كل شيء من مياه وجبال",87,"ل",1,0],["لا أنت تدري ولا يدري سواك وإن","جل المقام فإن السر قد سترا",88,"ر",2,0],["لا أنني قلت فحمدي لها","منها عليها زاد والشكر زاد",89,"د",1,0],["لاَ أَنْتَ مِمَّنْ يَدِي على كَبدٍ","أتلفها بل يَدِي عَلى كَبِدي",90,"د",2,0],["لا أَنسَ أَيّامي بِأُنسِ لِقائِهِم","كَلّا وَلا يا نَيلُ طيبَ هَواكا",91,"ك",2,0],["لا أنت باللَّكِن اللِّسانِ ولست","بالرَّعديدِ في حين الفراِئصُ ترعد",92,"د",1,0],["لا أنت أنتم إن لم تقم لكم","شعواء مرهوبةً مرأى ومستمعا",93,"ع",2,0],["لا أَنثنى للغَير عِندَ صدوده","كَلا وَلا أَصبو لِذات سِوار",94,"ر",1,0],["لا أَنثني عَن مَديحي فيكَ ما طَلعت","شَمس وَما صُلِّيَت خَمسٌ مَدى الحقب",95,"ب",1,0],["لا أنت راحمة ولا","مصر الأبية بالمطيقه",96,"ق",2,0],["لا انشني عن طريق الحب ذا ملل","ما دام باق تثني ذلك الغصن",97,"ن",1,0],["لا إِن أتى مُلَّ منه","ولا ذا غابَ يُنسَى",98,"س",2,0],["لا أَنني وحدي أَقُصُّ بمدحِهِ","كلُّ الأنامِ بمدحِهِ قُصَّاص",99,"ص",1,0],["لا اِنفَكَّ عِزّك في العُلى يُبنى عَلى","شَرَفِ السّعودِ بِأَحسنِ الأسعادِ",100,"د",1,0],["لا أنا المادحُ الكذوبُ ولكنْ","شرح اللَّهُ لي بمدحك صدرا",101,"ر",2,0],["لا أنتَ تَعنيها ولا","دمعٌ يَفيضُ بِرَاحَتيكْ",102,"ك",1,0],["لا أنشد الأشعار مع جاهل","فكيف أبدي جوهري مع دني",103,"ن",2,0],["لا أنْثَنِي عَنْ حُبّ مَنْ لَمْ يَثْنِهِ","عِنْدَ الوَدَاعِ تَذلُّل الأشْواقِ",104,"ق",1,0],["لاَ أنْثَنِي عَنْ حُبّ خوْدٍ خَدُّهَا","نُعْمَانُهُ يَرْوِي عَنِ ابْنِ مَنِيعِ",105,"ع",1,0],["لا أنثني عنه إلى غيره","إلا لقوم حبهم ديني",106,"ن",2,0],["لا أنيسٌ إلا صهيلُ جوادٍ","يشتكي من مذلّة الأَطناب",107,"ب",1,0],["لا انثني حَتّى أَذيبُ فُؤادَهُ","واقدُّ عاتِقُهُ بِسَيفِ لِقاكا",108,"ك",2,0],["لا أنت أزمعت ولا الفكر مات","خلعتَ عمرا واكتسيت الحياة",109,"ه",1,1],["لا آنس الله زمان الشتا","ولا ضباب الجوّ إذ يعبقُ",110,"ق",1,1],["لا آنس الله أيام الفراق لقد","حار البعاد وجاد الدمع مجراهُ",111,"ا",2,0],["لا أنتهي عن حبها أبداً ولم","أطلب من الدنيا سوى مرضاتها",112,"ت",3,0],["لا أنف للعِرق يستثير له","ولا سليم الصُّدود م