5,"بعض أنفاس البحر","https://www.poetsgate.com/ViewPoem.aspx?id=71578",""],[5237,"حسامي ومنهاجي القويم وشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=113120",""],[5256,"أنادي إلهي بيا ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=157390",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[3294,"أبى المجد الذي يأبى سواه","https://www.poetsgate.com/ViewPoem.aspx?id=173251",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5461,"ياضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=6004",""],[5480,"هموم الحر","https://www.poetsgate.com/ViewPoem.aspx?id=9875",""],[5582,"رَمَتْكَ وَدُونَها الرُّقَباءُ عَمْداً","https://www.poetsgate.com/ViewPoem.aspx?id=187153",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5582,"كَئِيبٌ ما النَّسِيمُ سَرَى عَلِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=63608",""],[2110,"حسبي من الوجد ما بي أيها اللاحي","https://www.poetsgate.com/ViewPoem.aspx?id=156268",""],[5690,"أجبرت بك الدنيا فأنت مجيرها","https://www.poetsgate.com/ViewPoem.aspx?id=172135",""],[5781,"ناياتِ كوثرهِ.....","https://www.poetsgate.com/ViewPoem.aspx?id=208987",""],[5932,"صرخة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=37129",""],[5943,"كرباجٌ لهاجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46729",""],[5956,"تغرد لي الملائكة","https://www.poetsgate.com/ViewPoem.aspx?id=181898",""],[5956,"مملكتي زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=182186",""],[5956,"ما أكبرُ الدعوات تكفي للوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=193817",""],[5970,"حسان المنى من دونهن المصاعب","https://www.poetsgate.com/ViewPoem.aspx?id=130580",""],[6004,"أيُّ ربيعٍ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=109515",""],[6093,"ربابٌ ( الوافر)","https://www.poetsgate.com/ViewPoem.aspx?id=176208",""],[6093,"إِنَّ السُّمَاةَ إِلى مَدِيْحِ مُحَمَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=186686",""],[5601,"نهر الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65792&r=&rc=131",""]],"verses":[["حسامٌ ما انتضته الكف إلا","تلبس سمع رائيه النعابا",0,"ب",2,0],["حُسامُكَ النَصرُ فَصَمِّم بِهِ","وَدِرعُكَ الإِقبالُ فَاِستَلئِمِ",1,"م",1,0],["حُسامٌ لا يَضِبُّ عَليهِ غِمدٌ","وَلَيثٌ لا يُطِلُّ عَليهِ زارُ",2,"ر",1,0],["حُسامٌ جَلا عَنهُ الزَمانُ فَصَمَّمَت","مَضارِبُهُ حيناً وَعادَ إِلى الغِمدِ",3,"د",1,0],["حُسامٌ نَكا فيهِ كَهامٌ بِغُرَّةٍ","وَأَولى لَهُ لَو هَزَّهُ غَيرَ مُغمَدِ",4,"د",1,0],["حُسامانِ إِن فَتَّشتَ كُلَّ ضَريبَةٍ","فَأَثرُهُما فيها قَديمٌ وَحادِثُ",5,"ث",1,0],["حِسانُ الوُجوهِ عِظامُ الجُسومِ","كَغِزلانِ بَرِّيَّةٍ يَرتَعينا",6,"ن",2,0],["حُسامُ جَبانٍ كلّما شِيمَ نصْلُهُ","تَراجَعَ بعْدَ العزْمِ والتَزَمَ الغِمْدا",7,"د",2,0],["حُسامُكَ مَهما تَختَرِطهُ لِمِثلِها","فَقَلَّ غَناءُ السَيفِ حينَ يُشامُ",8,"م",1,0],["حِسانُ السَيرِ لا مَتَوَاتِراتٌ","وَلا ميلٌ هَوادِجُها تَموجُ",9,"ج",1,0],["حِسّاً وَمَعْنىً لَمْ تَدَعْ مَا تَقْتَضِي","مِنْهَا العُلَى لِمُقَوِّمِ القُوَّامِ",10,"م",1,0],["حُسّانَةُ الجيدِ تَحلو كُلَّما اِبتَسَمَت","عَن مَنِطقٍ لَم يَكُن غَثّاً وَلا هَذَرا",11,"ر",2,0],["حسامك رقراق الصفيح كأنه","بكفك من ماء السماء يُنَطّفُ",12,"ف",1,0],["حسان علت في الحسن خَلقاً وخِلقةً","وهل خلقة تعلو إذا سفلت خلقا",13,"ق",2,0],["حُسامٍ وَأَرماحٍ بِأَيدي أَعِزَّةٍ","مَتى تَرَهُم يا اِبنَ الخَطيمِ تَبَلَّدِ",14,"د",1,0],["حسَّان بيت قريضه حتَّى إذا","ذكر الولاء فإنه سلمانه",15,"ن",2,0],["حساماً جُرازَ الشفرتَيْنِ كأنما","يقطّ بأوساطِ الكُماةِ معاصما",16,"م",2,0],["حُسامٌ كَلَونِ المِلح صافٍ حَديدُهُ","جُرازٍ كَأَقطاع الغَدير المُنَعَّتِ",17,"ت",1,0],["حُسامُكَ مِن سُقراطَ في الخَطبِ أَخطَبُ","وَعودُكَ مِن عودِ المَنابِرِ أَصلَبُ",18,"ب",1,0],["حُسامٌ لِاِبنِ رائِقٍ المُرَجّى","حُسامِ المُتَّقي أَيّامَ صالا",19,"ل",2,0],["حِسانُ التَثَنّي يَنقُشُ الوَشيُ مِثلَهُ","إِذا مِسنَ في أَجسامِهِنَّ النَواعِمِ",20,"م",1,0],["حُسامُ وَعَزمٌ كَالحُسامِ وَجَحفَلٌ","شِدادٌ قُواهُ مُحصَداتٌ مَرائِرُه",21,"ر",2,0],["حُسامُ أَميرِ المُؤمِنينَ الَّذي بِهِ","يُعالِجُ أَدواءَ الأَعادي فَتُحسَمُ",22,"م",1,0],["حُساما نُصرَةٍ وَيَدا سَماحٍ","وَبَحرا نائِلٍ يَتَدَفَّقانِ",23,"ن",1,0],["حُسامُ العَزمِ ليسَ يَنوبُ خَطْبٌ","فنحمَدَ عندَه إلا الحُساما",24,"م",2,0],["حسامُ كفاحٍ باتَ في السجن مغمَداً","وأصْبَحَ من حَلْيِ الرياسةِ عاريا",25,"ي",2,0],["حُسّانةُ الجيدِ في خَلْقٍ تَقومُ به","فتعجَبُ الشمسُ من تقويمه الحسنِ",26,"ن",1,0],["حسانٌ تديرُ بسحرِ الهَوى","عيُونَ المها في وُجوهِ البُدورِ",27,"ر",1,1],["حُسامُكَ نُورُ ذِهنِكَ فيه صَقْلٌ","وَعَزْمُكَ في المضاءِ له غرارُ",28,"ر",1,0],["حسّانُ مُنبَهِرٌ وكعبٌ عاجزٌ","والشّاعر الجعديُّ عانٍ مُوثَقُ",29,"ق",1,0],["حسّانُ أبلغُ من يقول وليس لي","منه إذا ادّعَتِ المصاقعُ مِقْوَلُ",30,"ل",1,0],["حِسانُ مَواضِعالنُقَبِ الأَعالي","غِراثُ الوُشحِ صامِتَةُ البُرينِ",31,"ن",1,0],["حسام وغاه إذا غدا ومجنَّه","إذا خيف من ريب الزمان طروق",32,"ق",1,0],["حَساها كُلُّ أَروَعَ شَيظَمِيٍّ","كَريمِ الجَدِّ مَحمودٍ مُؤاتِ",33,"ت",1,0],["حُسامٌ إِذا ما هُزَّ أُرعِدَ مَتنُهُ","خُفوقَ ثِيابِ الآلِ فَوقَ الفَدافِدِ",34,"د",1,0],["حَسا طامِرٌ في صَمتِهِ مِن دَمِ الفَتى","فَصَغَّرَ ذاكَ الصَمتُ مُعظَمَ ذَنبِهِ",35,"ب",2,0],["حَسّانُ في المُلكِ لا يَحَسُّ لَها","تُزجي إِلى مَوتِها قَنابِلَها",36,"ل",3,0],["حُسامٍ إِذا ما قُمتُ مُنتَصِراً بِهِ","كَفى العَودَ مِنهُ البَدءُ لَيسَ بِمِعضَدِ",37,"د",1,0],["حسامٌ خفي الجرس حين تسله","صفيحته مما تنقى الصياقل",38,"ل",1,0],["حسامك للأعمار أبرى من الردى","وعفوك للجاني أعز المعاقل",39,"ل",1,0],["حِسابُكُمُ عندَ المَلِيكِ وما لَكمْ","سِوى الودّ مني في هُبوطٍ ومَرْفَع",40,"ع",1,0],["حُسامٌ لا الذُّبابُ له قَرينٌ","ولا دَرجَتْ بصَفحتِهِ النِّمال",41,"ل",1,0],["حِسَانُ العَصْرِ عِقْدٌ مِنْ لآَلٍ","وَرِينِيهُ الفَرِيدَةُ فِي الَّلآلِي",42,"ل",2,0],["حسان لم ينقل سوى صلواته","السمحاء في مدح الرسول الهادي",43,"د",2,0],["حُسامُهُمْ مانَبا في وَجْهِ مَنْ ضَرَبوا‏‏‏","وَمُهْرُهُمْ ما كَبا في إِثْرِ مَنْ هَرَبا‏‏‏",44,"ب",2,0],["حُسَامُ عينكَ من فُتُورِهما","كأنَّه مُغْمَدٌ ومَسْلُولُ",45,"ل",1,0],["حسانُ الدمى تَصبو إِلى حُسنِ وَجهِهِ","وَصَلدُ الصَفا مِن لَمسِ كَفَّيهِ يَرشحُ",46,"ح",1,0],["حسام لا يليق عليه جفنٌ","سريع في ضريبته ذريعُ",47,"ع",1,1],["حُسامٌ بكفِّ اللّهِ كان صِيالُه","فأصبحتِ الأرضُ الطهورُ له غِمدا",48,"د",2,0],["حُسامٌ له مجدُ الُخُلودِ قِرابُ","يحوِّم شعري حوله فيهابُ",49,"ب",1,1],["حسام: لا يريق دما","ولا يأوي إلى غمد",50,"د",1,0],["حسامٌ إذا ما قمت منتصراً به","كفى العوذ فيه البدء ليس بمعضد",51,"د",1,0],["حسّ أشارككم به آلامكم","وأكاد أحمل عنكم الأتراحا",52,"ح",2,0],["حُسَّانَة ُ الْجِيدِ تَحْلُو كُلَّمَا ابْتَسَمَتْ","عنْ منطقٍ لمْ يكنْ عيِّاً ولا هذرا",53,"ر",2,0],["حسامان ان اضرب بنصلهما البلا","يرد ويأتي الوهب بالعد عن يد",54,"د",1,0],["حُسامٌ صُروفُ الدَهرِ مِن بَعضِ ما كَفَت","مَضارِبُهُ وَالأَمنُ مِن بَعضِ ما أَجدا",55,"د",2,0],["حُسامٌ هُمامٌ ظَلَّ بِالحَقِّ ناطِقاً","فَما صَلَّ في الهاماتِ إِلّا وَأَفهَما",56,"م",2,0],["حِسانُ الأَيادي إِن عَداها فَمَن لَها","ظُباتُ الأَعادي فَلَّها وَأَذَلَّها",57,"ه",2,0],["حُسامُ هُدىً تُمضِهِ أَنمُلُهُ السُبطُ","لَقَد ذَهَبَت بِاللاتِ شِدَّةُ ضَبثِهِ",58,"ه",1,0],["حُسامٌ بيُمنى الحَقِّ أَضحى مُجَرَّداً","يَسوٌ الوَرى لِلخَيرِ مَثنى وَمَوحَداً",59,"د",2,0],["حساب بهن الألف يرجع ثلثه","إذا نحن بعناها بأكثر قيمة",60,"ه",1,0],["حسامُكَ برقٌ والقَتام سحائب","وخيلُكَ سُفنٌ والدِما زاخراً بَحْر",61,"ر",1,0],["حَسّام ما مِنْ عِظماتِ الأُمور أَبَيْ","نَ الحَسْمَ وَصَّالُ ما مِنهنّ لم يَصِل",62,"ل",1,0],["حُسامٌ هو الموتُ الزؤَامُ متى يَشِم","لهُ برق رعْد جاءَهُ منهُ ترْعِيدُ",63,"د",1,1],["حسام طويل الساعدين شرنبث","له بطش دلاهث هصور شرابث",64,"ث",1,0],["حِساناً لا أُريدُ بِهِنَّ إِلّا","مَساءَةَ كُلِّ باغٍ خارِجِيِّ",65,"ي",1,0],["حِسانٌ فَإِن كُنتُ أَرسَلتُهُنَّ","عَوناً فَإِنَّ المَعاني عَذارا",66,"ر",2,0],["حُسامٌ لنصرِ الحقِّ أضحى مجرداً","على قدمِ التجريدَ يُمسى ويُصبحُ",67,"ح",1,0],["حسام لدى البأسار كام لدى الندى","حرام على الأعدا همام إذا عدوا",68,"د",3,0],["حُسام الجُيوش عزّ دولة هاشم","حليف السَّماح والنَّدَى المتدفِّقِ",69,"ق",1,0],["حُسامُ أَمِيرِ الْمُؤْمِنِينَ وَمَنْ تَكنْ","حُساماً لَهُ فَلْيَقْتُلِ الْخَوْفَ وَالْفَقْرا",70,"ر",2,0],["حُساماً نَرى ِي صَفْحِهِ الصَّفْحَ وَالنَّدى","وَفِي حَدِّهِ الْجَدَّ الْمُظَفَّرَ والنَّصْرا",70,"ر",2,0],["حُسامُ أَمِيرِ الْمُؤْمِنِينَ ابْنُ سَيْفِهِ","فَيا لَكَ مِنْ فَرْعٍ وَيا لَكَ مِنْ جِذْمِ",71,"م",1,0],["حُسامٌ أَغْمَدَتْهُ بِكَ اللَّيالِي","سَيَنْحَلُّ فِيكَ مَضْرَبُهُ النَّحِيلُ",72,"ل",1,0],["حِسانُ الوُجوهِ وَلَكِنَّهُم","سُعودٌ طَوالِعُ خَلفَ النحوسِ",73,"س",1,0],["حُسامٌ يُرجّى عَفوه وَهوَ مصلتٌ","وَتَخشى الأَعادي بَأسَهُ وَهوَ مغمدُ",74,"د",1,0],["حساماً بحدَّيْهِ مهما انتَضا","هُ يَكْسِرُ جيشَ المُلِمّاتِ كسرا",75,"ر",2,0],["حِساناً للمُدِلِّ بها لعَمْري","على الكُرَماء حَقٌ ذو ثُبوت",76,"ت",1,0],["حِسانٌ منَ البِيض الّلواتي لصَقلِها","وللطّبْعِ أَذْكَى اللهُ نارَ ذكائي",77,"ا",2,0],["حُساماً تراهُ كَمِثلِ الغديرِ","عليه كَنَمنَمَةِ النَّاقِشِ",78,"ش",1,0],["حِسابُ الناسِ مِنكَ بِغَيرِ رِزقٍ","أَبيكَ كانَ بِلا حِسابِ",79,"ب",1,0],["حسابه الرمزُ وتأريخه","مختصر من حسن أحلامهِ",80,"م",2,0],["حسامُ تقي الدين في كل مأزقٍ","يقدُّ إِلى الأرض الكميَّ المدججا",81,"ج",2,0],["حسام الدين دمت قرير عين","وعيناً لا يساميه مسامي",82,"م",2,0],["حُسام لَهُ مِن حيث ما شيم مضربُ","غَمام لَهُ من حيث ماشيم صَيِّبُ",83,"ب",1,0],["حسامٌ صقيل المتن أُغمِدَ في الثرى","ووارى ترابُ الأرض طلعة نيّر",84,"ر",1,0],["حسام الدولة عبد المجيد","مليك الملوك وسيف خذم",85,"م",1,0],["حسامه من دم اللبات مرتشف","ورمحه في ذرى الأحشاء مركوزُ",86,"ز",1,0],["حسامٌ يَفُلُّ الخَطْبَ والخطبُ مُعْضِلٌ","وطَوْدٌ يُقِلُّ العِبْءَ والعِبْءُ كارِثُ",87,"ث",1,0],["حسام أمير المؤمنين وما سمي","بذلك إلا وهو للخطب حاسم",88,"م",1,0],["حُسامَكَ لاستحالَتْ بالفَسادِ","فإنَّ الدهرَ عندَكَ فِي قِيادِ",89,"د",1,0],["حسامُ الإِمامِ المُصْطَفى وسِنانُهُ","ومَفْزَعُهُ فِي المُشْكِلاتِ وحاجِبُهْ",90,"ب",2,0],["حسامٌ للكواكِبِ فِي المعالي","مُبارٍ فِي المكارم للرِّياحِ",91,"ح",1,0],["حُسامٌ لداءِ المكر والغدر حاسمٌ","وظلٌّ عَلَى الدين الحنيف ظليل