sgate.com/ViewPoem.aspx?id=183582",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[45,"ألا يا هبوب الريح بلغ رسالتي","https://www.poetsgate.com/ViewPoem.aspx?id=33033",""],[35,"أمِنْ طَلَلٍ أَقْوَى مِنَ الحَيّ مَاثِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=22137",""],[28,"لعمري لقد كان ابن ثور لنهشل","https://www.poetsgate.com/ViewPoem.aspx?id=22023",""],[28,"ألَمْ يَأتِ بالشّأمِ الخَليفَةَ أنّنَا","https://www.poetsgate.com/ViewPoem.aspx?id=16947",""]],"verses":[["وَعَن سُيوفِ إِباءِ الضَيمِ حينَ سَطوا","مَضى بَغُصَّتِهِ الجَعديُّ مَروانُ",0,"ن",1,0],["وَعِندِيَ يَومٌ لَو يَزيدُ وَمُسلِمٌ","بَدا لَهُما لَاِستَصغَرا يَومَ واقِمِ",1,"م",1,0],["وَعَن قُربٍ سَيَشغَلُني زَماني","بِرَعيِ الناسِ عَن رَعيِ القُرومِ",2,"م",1,0],["وَعِندِيَ عالٍ مِن دَمِ الجَوفِ شُربُهُ","وَماضي الظُبى مِن أَسوَدِ القَلبِ طَعمُهُ",3,"م",2,0],["وَعِندي مِنَ الوُدِّ الَّذي لا يَشوبُهُ","لَحاظُ المُرائي أَو كَلامُ المُنافِقِ",4,"ق",1,0],["وَعِندي مِنَ الأَحبابِ كُلُّ عَظيمَةٍ","تُزَهَّدُ في قُربِ الضَجيعِ المُعانِقِ",4,"ق",1,0],["وَعِندَ رِجالٍ أَنَّ جُلَّ تُراثِهِ","قَضيبٌ مُحَلّىً أَو رِداءٌ مُفَوَّفُ",5,"ف",1,0],["وَعِندي لِلزَمانِ مُسَوَّماتٌ","مِنَ الأَشعارِ تَختَرِقُ الفَيافي",6,"ي",1,0],["وَعِندَ طَبيبِ المُعضِلاتِ شِفاؤُهُم","إِذا عادَ مِن داءِ العَداوَةِ ناكِسُ",7,"س",1,0],["وَعِندي لَتَبديلِ الدِيارِ مُناخَةٌ","تُوَقِّعُ ما تُملي عَلَيَّ المَقادِرُ",8,"ر",1,0],["وَعَنِ الرِماحِ يَشيطُ في أَطرافِها","بِالطَعنِ كُلُّ مَغامِرٍ وَمُغاوِرِ",9,"ر",1,0],["وَعِندي إِباءٌ لا يَلينُ لِغامِزٍ","وَلَو نازَعَتنيهِ الرَقاقُ البَوارِدُ",10,"د",1,0],["وَعِندي قَوافٍ إِن تَلَقَّينَ بِالأَذى","نَزَعنَ بِمُرِّ القَولِ نَزعَ المَواتِحِ",11,"ح",1,0],["وَعِندي لِلعِدى لا بُدَّ يَومٌ","يُذيقُهُمُ المَسَمَّمَ مِن عِقابي",12,"ي",1,0],["وَعِندَ تَعانُقِ الأَقرانِ يَبلى","قِراعُ النَبعِ بِالنَبعِ الصَليبِ",13,"ب",1,0],["وَعِندِيَ مِمّا خَوَّلَ اللَهُ سابِحٌ","وَأَسمَرُ عَسّالٌ وَأَبيَضُ مِقضَبُ",14,"ب",1,0],["وَعِندي إِلى العَلياءِ طُرقٌ كَثيرَةٌ","لَوِ اِنجابَ مِن هَذي الخُطوبِ ضَبابُها",15,"ب",3,0],["وَعِندي لَكَ الغُرُّ الَّتي لا نِظامُها","يَهي أَبَداً أَو لا يَبوخُ شِهابُها",15,"ب",3,0],["وَعِندِيَ لِلأَعداءِ فيكَ أَوابِدٌ","لُعابُ الأَفاعي القاتِلاتِ لُعابُها",15,"ب",3,0],["وَعنديَ مَن كانَ العَفافُ رَقيبَهُ","أُغازِلُهُ طَوراً وَطَوراً أُعانِقُهْ",16,"ق",2,0],["وَعِنْدَكَ مَحْبوكُ السَّراةِ مُطهَّمٌ","وَفي الكَفِّ مَطْرورُ الشَّباةِ صَقيلُ",17,"ل",1,0],["وَعَنْ قَليلٍ أُرَى في مَأْزِقٍ حَرِجٍ","بِهِ تُشامُ السُّرَيْجيّاتُ في القِمَمِ",18,"م",1,0],["وَعَنْ كَثَبٍ يُفْضِي بِسِّري إِليْكُما","غِرارُ حُسامٍ أَوْ شَبَاةُ سِنانِ",19,"ن",1,0],["وَعِنْدي أَغَنُّ أَظُنُّ الصَّباحَ","إِذا لاحَ مِنْ وَجْههِ مُسْتَرَقْ",20,"ق",1,0],["وعندَ بَنيهِ حينَ تُخْشى بَناتُهُ","قُلوبُ نِساءٍ في جُسومِ رِجالِ",21,"ل",1,0],["وعِندي منَ الخَيْلِ ذو مَيْعَةٍ","يَطوفُ بقُبّتِنا مُقْرَبُ",22,"ب",1,0],["وعندكَ قَوْمٌ يُلْقِحونَ ضَغائِناً","فألْحِقْ مُتِمَّ الحامِلاتِ بمُخْدِجِ",23,"ج",1,0],["وعندي للمُقْتَدي أنْعُمٌ","أمِنْتُ بهِنَّ الزّمانَ الخَؤونا",24,"ن",2,0],["وعن كَثَبٍ يتَقَرّى بَنيهِ","بِما يَعْقِدُ العِزُّ فيهِ حُباهْ",25,"ا",2,0],["وعندكَ تُرْعى حُرْمَةُ المَجْدِ فارْتَمى","إليكَ بهِ دامي الأظَلّينِ بازِلُ",26,"ل",1,0],["وعندي ثَناءٌ وهْو أرجى وَسيلةٍ","إليكَ كتَفْصيلِ الجُمانِ المُنَظَّمِ",27,"م",1,0],["وعِنْدي أنّ العُذْرَ أوضَحُ واضِحٍ","إذا كُنتَ في بَحْرِ المَعارِفِ قد عُمْتَا",28,"ت",2,0],["وَعِنْدَهُ مَالٌ وَمِنْ خَلْفِهِ","أيْدٍ تَعَلَّقْنَ بِأَهْدَابِهِ",29,"ب",2,0],["وَعَنْ عَلِيٍّ أَبِي السِّبْطَيْنِ رَابِعِهمْ","سَيْفِ النَّبِيِّ الَّذِي مَا هَزَّهُ فَنَبَا",30,"ب",2,0],["وَعَنْ قَرِيبٍ بِحَوْلِ اللهِ أَخْتِمُهُ","فَرُبَّمَا أَدْرَكَ الْغَايَاتِ مَنْ طَلَبَا",30,"ب",2,0],["وَعندي لَهُ إِن ثار فَوَّارُ صَدرِهِ","فَحاً جَبَلِيٌّ لا يَعودُ لَهُ الحاسي",31,"ي",1,0],["وَعِندَ العَشيِّ طيبُ نَفسٍ وَلَذَّةٌ","وَمالٌ كَثيرٌ غُدوَةً نَشَواتُها",32,"ت",3,0],["وَعَنِ اِعتِناقي ثابِتاً في مَشهَدِ","مُتَنافِسٍ فيهِ الشَجاعَةُ لِلفَتى",33,"ا",1,0],["وَعَن قَريبٍ سَيَقضي","غَضَّ الشَبابِ حَزينا",34,"ن",2,0],["وَعِندي مِن صِحابي الآنَ رَهطٌ","إِذا أَكَلوا فَآسادٌ ضَواري",35,"ي",1,0],["وَعَن أَبي الدُرِّ إِن سَأَلتَ فَسَل","لِاِبنِ سَليمٍ يُنبِئُكَ بِالخَطبِ",36,"ب",1,0],["وَعِندي لِشُكرِكَ نَظمُ العُقودِ","تَناسَقُ فيها اللَآلي التُؤَم",37,"م",1,0],["وَعَنسٍ كَأَلواحِ الإِرانِ نَسَأتُه","عَلى لاحِبٍ كَالبُردِ ذي الحَبَراتِ",38,"ت",1,0],["وعُنثُلَةٌ والخَيثَوَانُ وبُرسُلٌ","وفَرخُ فَرِيق والرِّفَلّةَ والرفَل",39,"ل",1,0],["وعَن عَن وعَن عَن ثمَّ عَن عَن وعَن وَعَن","أُسَائِلُ عَنها كلَّ مَن سَارَ وارتَحَل",39,"ل",1,0],["وعنب لفضّة","يعصر منها ذهب",40,"ب",1,1],["وَعَنَّ لَنا بِالجِزعِ فَوقَ فُراقِدٍ","أَيادي سَبا كَالسَحلِ بيضاً سُفورُها",41,"ر",3,0],["وَعَن نَجلاءَ تَدمَعُ في بَيَاضٍ","إِذا دَمَعَت وَتَنظُرُ في سَوادِ",42,"د",1,0],["وَعَن مُتَكغاوِسٍ في العَقصِ جَثلٍ","أَثيثِ النَّبتِ ذي عُذَرٍ جَعادِ",42,"د",1,0],["وعن كل محزون وعن كل بائس","بها عاد عن باب الأمير بالجدا",43,"د",2,0],["وعن كل ملهوفٍ أغاثت وحرة","من العاثرات الجد مدت لها يدا",43,"د",2,0],["وعن كل خريجٍ بعلم وصنعةٍ","أقامت له في ساحن الفضل معهدا",43,"د",2,0],["وعن حسين المفتدى لا تسل","من لك بالعطر ومن بالعسل",44,"ل",1,0],["وَعَنْ عَظِيمِ الخُلْقِ مُسْتَنِّهِ","وَعَنْ قَوِيمِ الفِكْرِ مُسْتَدِّهِ",45,"د",2,0],["وَعَنْ هُدًى لاَ عَنْ هَوًى فَهْيَ لَمْ","تُوصَمْ بِأَوْصَارٍ وَأدْرَانِ",46,"ن",1,0],["وَعُنُوا بِنَشْرِ العِلْمِ فِي زَمَنٍ غَدَا","حَرْباً عَلَى مَنْ لَيْسَ بِالمُتَعَلِّمِ",47,"م",1,0],["وَعِنَايَةٌ مَحْجُوبَةٌ لَيْسَتْ تُرَى","إِلاَّ بِمَا تُسدِي مِنَ الإِنْعَامِ",48,"م",1,0],["وَعَن سَوفَ تَدعوني عَلى نَأي دارِها","دَواعي الهَوى مِن حُبِّها فَأَجيبُها",49,"ب",3,0],["وعنك يُروّي الناسُ كلَّ غريبة","تخطُّ على صفح الزمان الأماليا",50,"ي",2,0],["وعنه يُروِّي الناسُ كل غريبةٍ","تُخَطُّ على صفح الزمان وتُرْسَمُ",51,"م",1,0],["وعنايةُ الله اشتملتَ رواءها","وعلقت منها عروة لا تُفصلُ",52,"ل",1,0],["وعنك يُروِّي الناسُ كلَّ غريبةٍ","يُروَّى لنا منها الغريبُ المصَنَّفُ",53,"ف",1,0],["وعنايةُ الله اشتملت رداءها","وعلقت منها عروةً لا تُفْصَلُ",54,"ل",1,0],["وعندما قد شجاني من مقالتها","لفظ يقطعّه في البين أعوال",55,"ل",1,0],["وعن اليمين أرى مروج مزارع","وعن الشمال حدائقاً ونخيلا",56,"ل",2,0],["وعُنُوا بتربية البنين عنايةً","زادوا بها شمماً على الأجبال",57,"ل",1,0],["وعنده للندى والحزم أقرية","وفي الحروب إذا ما شالت الأهبُ",58,"ب",1,1],["وَعِندي مِنَ الأَخبارِ مالَو ذَكَرتُهُ","إِذاً قَرَعَ المُغتابُ مِن نَدَمٍ سِنّا",59,"ن",2,0],["وَعُنِيَت بِنَظمِهِ عَواتِقُه","تَأوي إِلى غُدرانِهِ شَوائِقُه",60,"ق",2,0],["وَعَن ذِكرِ أَيّامٍ مَضَت وَمَواقِفٍ","مَكانِيَ مِنها بَيِّنُ الفَضلِ ظاهِرُ",61,"ر",1,0],["وَعِندي الظِلَّ مَمدوداً","عَلى الحاضِرِ وَالبادي",62,"ي",1,0],["وعنقٌ قد استحسنتُ دمعي لأجلها","وفي العُنقِ الحسناء يستحسن العقد",63,"د",1,0],["وعنك استفاد الناسُ مدحاً بمثله","على الشب يشدو أو على الركب إذ يحدو",63,"د",2,0],["وعن جاهه الناران هذي بفارسٍ","تبوخ وهذي في غدٍ حين تحشر",64,"ر",1,0],["وعند ذكرى جُوده يُبَخْبَخُ","فالمعتفي جَدواه لا يُوَبَّخُ",65,"خ",1,0],["وعندكَ إن أردتَ النَّفْعَ نَفْعٌ","وعنْدي ضِعْفُهُ شُكْرٌ عَتيدُ",66,"د",1,0],["وعنديَ أمثالُ لذاك كثيرة","سَيَحْدُو بها في البر والبحر من يحدُو",67,"د",2,0],["وعندي حين تنتضل القوافي","ويَقلُصُ للمحافظةِ الإزار",68,"ر",1,0],["وعندي الطِّوَل المُرْخَى أَعنَّتها","من القصائِد والسيارة الوُجز",69,"ز",1,0],["وعند الله خالق كل شيء","تميُّزُ كلِّ ذي كذبٍ وصدق",70,"ق",1,0],["وعند ابنِ كِسْرى لابنِ قَيصَر مقْعَدٌ","إذا سامَهُ العصران إحدى الهضائمِ",71,"م",1,0],["وَعَنسٍ بَراها رِحلَتي فَكَأَنَّها","مِنَ الحَبسِ في الأَمصارِ وَالخَسفِ مِشجَبُ",72,"ب",1,0],["وَعَنِ الشُطوطِ الحالِماتِ بِعَودَةٍ","لِلغائِبينَ وَرَجعَةٍ لِنَعيمِها",73,"م",3,0],["وَعَنِ الرَوابي الشاخِصاتِ إِلى السَما","العالِقاتِ رُؤوسُها بِغُيومِها",73,"م",3,0],["وَعَنِ الحَياةِ جَميلَها وَقَبيحَها","وَعَنَِ النُفوسِ صَحيحَها وَسَقيمَها",73,"م",3,0],["وَعَنِ الأُلى مَلَكوا فَلَم يَتَوَرَّعوا","عَن سَلبِ أَعزَلِها وَظُلمِ يَتيمِها",73,"م",3,0],["وَعَنِ الثَعابينِ الَّتي في أَرضِها","وَعَنِ الذِئابِ العُصلِ خَلفَ تُخومِها",73,"م",3,0],["وَعَنِ الفَقرِ وَالغِنى","وَعَنِ الحَربِ وَالسَلام",74,"م",1,0],["وَعِندي مِنَ الآدابِ في البُعدِ مُؤنِسٌ","أُفارِقُ أَوطاني وَليسَ يُفارِقُ",75,"ق",1,0],["وَعَن غَرامي كُلَّما","لامَكَ قَلبي عَذَرَك",76,"ك",1,0],["وَعِندَ أَميرِنا حُكمٌ وَعَدلٌ","وَرَأيٌ بَعدَ ذَلِكُمُ أَصيلُ",77,"ل",1,0],["وَعِندَ طَوافي قَد ذَكَرتُكِ مَرَّةً","هِيَ المَوتُ بَل كادَت عَلى المَوتِ تَضعفُ",78,"ف",1,0],["وعندما يئسوا من عود صحتهم","الى منيتهم في جرأة وثبوا",79,"ب",3,0],["وعندما دخلت","منه الباب من ذا استقبلك",80,"ك",1,0],["وعندي وان اسرفت من قبل في البكى","بقايا دموع سوف اقضى بها ديني",81,"ي",1,0],["وعن المناهل قد وردناها سوى","وشل به لا يرتوي الصديان",82,"ن",1,0],["وعن السعادة هل تجرّ ال","ذيل في الجمّ الغفير",83,"ر",1,0],["وعن عظيم ثروته","يا ليتني في حالته",84,"ه",1,1],["وعناق كالجفون اشتبكت","والغصين التف باللدن الطرى",85,"ا",1,0],["وعن الوثوب جماعة بجماعة","يتنازعون ولاية وحطاما",86,"م",2,0],["وعند الله ينشر بعد طى","حياة كلها في الخير فعل",87,"ل",1,0],["وعند الموت تَحسَر كل نفس","لها في العيش أو طار وأهل",87,"ل",1,0],["وعند الهوى موصفه لا صفاته","إذا سالوني ما الهوى قلت مابيا",88,"ي",2,0],["وعن الهل من يبر ويحنو","وعن الأصدقاء من لا يحول",89,"ل",1,0],["وعن الأمر من يغامر فيه","وعن الحق سيفه المسلول",89,"ل",1,0],["وعن الرأى والسياسة والتح","رير مَن رأيه السديد الأصيل",89,"ل",1,0],["وَعِندَ ذَلِكَ مَرَّت","حَسناءُ مَع حَسناءِ",90,"ا",2,0],["وَعِندَ الناسِ مَجهولٌ","وَفي أَلسُنِهِم مَنسي",91,"ي",1,0],["وَعَنِ المَيسِرِ ما اِسطَعتَ اِبتَعِد","فَهوَ سُلُّ المالِ بَل سُلُّ الكَبِد",92,"د",1,0],["وَعِندِيَ لِلرِجالِ وَإِن تَجافوا","مَنازِلُ في الحَفاوَةِ لا تُفاتُ",93,"ت",1,0],["وَعَن تِسعينَ عاماً كُنتِ فيها","مِثلَ المُحسِناتِ الفُضلَياتِ",94,"ت",1,0],["وَعَن صَغيراتِ الأُمورِ حُدَّها","وَاِصرِف إِلى جِدِّ الشُؤونِ جَدَّها",95,"د",3,0],["وَعِندي الهَوى مَوصوفُهُ لا صِفاتُهُ","إِذا سَأَلوني ما الهَوى قُلتُ ما بِيا",96,"ي",2,0],["وَعِندَكَ الزَهرُ وَعِندي الشِعرُ","كِلاهُما فيما يُقالُ نَدرُ",97,"ر",1,0],["وَعِندَ الَّذي قَهَرَ القَيصَرَينِ","مَصيرُ الأُمورِ وَأَحيانُها",98,"ن",3,0],["وَعِندي قَباطِيُّ الهُمامِ وَمالُهُ","وَعِندَهُمُ مِمّا ظَفِرتُ بِهِ الجَحدُ",99,"د",1,0],["وَعِندَها لَذَّ طَعمَ المَوتِ شارِبُهُ","إِنَّ المَنِيَّةَ عِندَ الذُلِّ قِنديدُ",100,"د",1,0],["وَعِندي لَكَ الشُرُدُ السائِراتُ","لا يَختَصِصنَ مِنَ الأَرضِ دارا",101,"ر",2,0],["وَعِندَهُمُ الجِفانُ مُكَلَّلاتٍ","وَشَزرُ الطَعنِ وَالضَربُ التُؤامُ",102,"م",1,0],["وَعِندَ مَنِ اليَومَ الوَفاءُ لِصاحِبٍ","شَبيبٌ وَأَوفى مَن تَرى أَخَوانِ",103,"ن",1,0],["وعناقُ حوراءِ المدامعِ غضَّةٍ","بعناقِ مقدامٍ من الشُجعانِ",104,"ن",1,0],["وَعِندَ أَبي العَبّاسِ لَو كانَ دانِياً","نَواحي الفِناءِ السَهلِ وَالكَنَفُ الرَحبُ",105,"ب",1,0],["وَعِندَ إِشراقُ ذاكَ البِشرِ دَرءُ شَذاً","كَمُنتَضى السَيفِ آجالٌ مَضارِبُهُ",106,"ب",2,0],["وَعِنادٌ مِن حادِثِ الدَهرِ أَن يَح","ضُرَ أَرضي مُخَيِّماً وَأَغيبُ",107,"ب",1,0],["وَعِندَ بَني الفُراتِ عَتيدُ نَصرٍ","إِذا اِستَنجَدتَ نَصرَ بَني الفُراتِ",108,"ت",1,0],["وَعِندي عُصَيِّبَةٌ مُمحِلونَ","مِنَ الراحِ صِرفاً وَمَمزوجَه",109,"ج",2,0],["وَعِندَ الأَميرِ نُصرَةٌ إِن أُهِب بِها","أُضَلِّل أَساطيرَ الخَؤُونِ المُبَهرَجِ",110,"ج",1,0],["وَعَنِّيَ أَقرِئها السَلامَ وَقُل لَها","زَعَمتِ بِأَلّا يَكتُمَ السِرَّ بائِحُ",111,"ح",1,0],["وَعِندَ بَني عَمّي لُهىً لا طَريفُها","مَصونٌ وَلا مُحمىً عَلَيَّ تَليدُها",112,"د",3,0],["وَعِندِيَ أَحشاءٌ تُشاقُ صَبابَةً","إِلَيها وَقَلبٌ مِن هَوى غَيرِها غُفلُ",113,"ل",1,0],["وَعِندَ بِقراطَ د