يفِ المَعاني",138,"ن",2,0],["وَعِندِيَ ظَبيٌ غَريبُ الجَمالِ","غَزيرُ الصَفاءِ عَزيزُ الصِفاتِ",139,"ت",1,0],["وَعُنيتَ بي وَرَفَعتَ قَدري في الوَرى","فَعَواذِلي في القُربِ مِنكَ حَواسِدُ",140,"د",1,0],["وَعِندَكَ لا يورِثُ الأَنبِياءُ","فَكيفَ حَظيتُم بِأَثوابِها",141,"ب",3,0],["وَعَنَت لِمُعتَصِمِ الرِقابُ بِبَأسِهِ","وَدَهى العِبادَ بِلينِهِ المُستَعصِمُ",142,"م",1,0],["وعندك كل ما أظمأ","وردّ القلب لهفانا",143,"ن",2,0],["وعندك كل ما أدمى","وزاد الجرح إثخانا",143,"ن",2,0],["وعندك كل ما أحيا","وشدَّد عزمه الواهي",143,"ي",1,0],["وعناقٍ أُحِسُّه في ضلوعي","دافقاً في الدماء كاليمِّ أزبد",144,"د",1,0],["وَعِنْدِي إِذَا مَا الْحَرْبُ أَلْقَتْ قِنَاعَهَا","عَزِيمَةُ لَيْثٍ مَا تَهِرُّ وَمَا تُعْوَى",145,"و",2,0],["وعنديَ قنديلٌ شبيهٌ بوجهِهِ","إذا ما مضى الشهرانِ يُغْسَلُ والشهرُ",146,"ر",1,0],["وعنْ أكثرِ الحاجاتِ يُكبرُ نفسَهُ","فيا أقدَرَ الغلمانِ ما أنتَ والكبرُ",146,"ر",1,0],["وعنديَ أني حاضرٌ أنا عندَهُ","لرفعتِهِ لا أنه حاضرٌ عندي",147,"ي",1,0],["وعندَ أَعْوادِكِ الخَضْراءِ بَهْجَتُها","كالسِّنْدِيانَةِ مهما اسَّاقَطَتْ ورَقا",148,"ق",2,0],["وعنَّت لي رؤى هيمٍ طواتٍ","تلفهمُ التهائمُ والنجود",149,"د",1,0],["وعند الهندِ ربعُ الكون عداً","وفي شطرين تنقسمُ الهنود",149,"د",1,0],["وَعَنبَرَ الهِندِ وَالكافورَ خالَطَهُ","قَرَنفُلٌ فَوقَ رَقراقٍ لَهُ أُشُرُ",150,"ر",1,0],["وَعِندي فَهَلَ لَكَ مِن رَغبَةٍ","لَكَ البِكرُ في خُلُقِ الثَيِّبِ",151,"ب",1,0],["وَعَنا الزَمانُ لِأَمرِهِ فَكَأَنَّما","أَصغى الزَمانُ بِهِ إِلى أَمّارِ",152,"ر",1,0],["وَعَنبَرَةً شَهباءَ تَحمِلُ نَفحَةً","تَنَفَّسُ في صَدرِ النَدِيِّ فَتُنشَقُ",153,"ق",1,0],["وَعِندي لِمِثلِكَ مِن خاطِبٍ","بَناتُ الحَمامِ وَأُمُّ المُدامِ",154,"م",1,0],["وَعِندي لَكُم حِصنٌ حَصينٌ وَصارِمٌ","حُسامٌ إِذا أَعمَلتُهُ أَحسَنَ الهَبرا",155,"ر",2,0],["وَعْندَ مكَّةَ إذ أَوْدَى وَجارَتِها","ما عند بغدادَ مِن هَمٍّ وَإبْلاسِ",156,"س",1,0],["وعندي عَبْرةٌ لك لن تراها","تَخونُ العِلمَ والأدبَ اللُّبابا",157,"ب",2,0],["وَعَنا لَهُ وَجهي وَخَلقي كُلُهُ","في الخاشِعينَ لِوجهِهِ مَشكورا",158,"ر",2,0],["وَعِندَ بَني سَعدِ بنِ ضَبَّةَ نِعمَةٌ","لَنا لَم يَرُبّوها بِشُكرٍ وَلا حَمدِ",159,"د",1,0],["وَعِندَ كَمالِ الحَظِّ يُخشى زَوالُهُ","كَما لِغَريقِ اللُجَّةِ الرَيُّ وَالقَحطُ",160,"ط",1,0],["وَعِندَنا مَن يَتَغَنّى لَنا","كَأَنَّهُ مِن فَمِهِ يَخرا",161,"ر",2,0],["وَعَناقيدَ مِنَ الصُد","غِ وَوَردٍ مِن خُدودِ",162,"د",1,0],["وعِنْدِي لكمْ آل النبيِّ مَوَدَّةٌ","سَلَبْتُمْ بها قلبي وصارَ له عِنْدُ",163,"د",1,0],["وعِنْدِي كَلامٌ واجِبٌ أَنْ أقُولَهُ","فلا تَسْأَمُوا مَمَّا أَقولُ وتَسْخَرُوا",164,"ر",3,0],["وعَنَتْ لِسَطْوَتِكَ المُلوكُ وَلَمْ تَزَل","بَرّاً رَحِيماً بالضَّعِيفِ وَصُولا",165,"ل",2,0],["وَعَنهُ أَنْبَأَ موسى وَالمسيحُ وقَد","أَصغَت حَوارِيُّهُ الغُرُّ البَهاليلُ",166,"ل",1,0],["وَعَنْ أَبِي حَفْصٍ الفَارُوقِ صاحِبِهِ","مَنْ قَوْلُهُ الْفَصْلُ في أحْكامِهِ عُمَرُ",167,"ر",1,0],["وعِنْدي على نأيِ المَزارِ وبُعْدِهِ","قصائِدُ تَشْرَى كالجُمانِ المُنظَّم",168,"م",1,0],["وعنَتْ لك العُرْبُ الطِّوالُ رِماحُها","واستجفلَتْ ممّا رأتْهُ تخوُّفَا",169,"ف",2,0],["وعندَ ذي التاجِ بِيضُ المكرُماتِ وما","عندي له غيرُ تمجيدٍ وتحميد",170,"د",1,0],["وَعِندَنا ضارِبٌ يَشدو فَيُطرِبُنا","يا دارَ هِندٍ بِذاتِ الجِزعِ حُيِّيتِ",171,"ت",1,0],["وَعَنهُ يَسيلُ الهَمَّ أَوَّلَ أَوَّلاً","وَإِن كانَ مَسجورَ الجَوانِحِ بِالهَمِّ",172,"م",1,0],["وَعَن سُبُلِ الرَشادِ بِطُرقِ غَيٍّ","وَعَن طَلَبِ المُحَلَّلِ بِالحَرامِ",173,"م",1,0],["وَعَنسٍ كَمِرداةِ القِذافِ ابتَذَلتُها","لِبِكرٍ مِنَ الحاجاتِ أَو لِعَوانِ",174,"ن",1,0],["وعن الحشوِ والعمامةِ","والكنِّ والصلاءِ",175,"ا",2,0],["وعن الفرشِ والوطا","في بيوتٍ بلا كراءِ",175,"ا",2,0],["وعن دنَس اليهود لدى اختتان","يمصُّ القيحَ يُسكبُ في القدوس",176,"س",1,0],["وَعِندَ مَغاني دارِها لَو تَكَلَّمَت","لِمُكتَئِبٍ بادي الصَبابَةِ أَخبارُ",177,"ر",1,0],["وَعِندَكَ عَهدٌ مِن وَصاةِ مُحَمَّدٍ","فَرَعتَ بِها الأَملاكَ مِن وَلَدِ النَضرِ",178,"ر",1,0],["وَعِندي مَزيدٌ لِاِمرئٍ عَقَّ أُمَّهُ","وَشَرَّعَ في شَتمي بِغَيرِ نَصيرِ",179,"ر",1,0],["وَعِناقٌ خِلالَ ذا","كِ تُداوي بِهِ الصَدا",180,"د",2,0],["وَعِندَ وَلِيِّ العَهدِ شافٍ مِنَ الجَوى","فَروحا عَلَيهِ ذُكرَةً بِشَكاتي",181,"ي",1,0],["وَعِندي مِن أَبيكَ الوَغدِ عِلمٌ","وَمِن أُمٍّ بِها جَمَحَ الفَتاءُ",182,"ا",2,0],["وَعِندَهُم مُسمِعاتٌ يَأذَنونَ لَها","ما لِلمَسامِعِ عَمّا قُلنَ مُنتَدَحُ",183,"ح",1,0],["وَعَن يَميني وَعَن شِمالي","يَصحَبُني حافِظٌ قَعيدُ",184,"د",1,0],["وَعِندَ ضِياءِ الفَجرِ صُلِّيَتِ الضُحى","وَعِندَ غُروبِ الشَمسِ صُلِّيَتِ العَصرُ",185,"ر",1,0],["وَعَن قَليلٍ يَصيرُ الأَمرُ مُنتَقِلاً","عَنهُم وَتَخفَتُ لِلأَجراسِ أَجراسُ",186,"س",1,0],["وَعُنوا فَقالَ الشافِعيُّ وَمالِكٌ","وَأَبو حَنيفَةَ قَبلُ وَالخَصّافُ",187,"ف",1,0],["وَعِندي لَو أَمِنتُكِ عِلمُ أَمرٍ","مِنَ الجُهّالِ غَيَّبَهُ مُكِمِّ",188,"م",1,0],["وَعِندِيَ سِرٌّ بَذِيُّ الحَديثِ","كُنتُ عَنهُ في العالَمينَ الغَواني",189,"ن",2,0],["وعَنّتْ في سَماءِ بَني عَدِيٍّ","نُجُومٌ ما يُغَبّيها عَنانُ",190,"ن",1,0],["وَعَنسٍ أَمونٍ قَد تَعَلَّلتُ مَتنَها","عَلى صِفَةٍ أَو لَم يَصِف لِيَ واصِفُ",191,"ف",1,0],["وَعَن أَيامِنِها الأَطواءُ مُصعِدَةٌ","قَد شارَفوا فَرَحَ الأَوتادِ أَو وَسَطوا",192,"ط",3,0],["وَعَناجِيجَ جِيادٍ نُجُبٍ","نَجلِ فَيّاضٍ وَمِن آلِ سَبَل",193,"ل",1,0],["وعنديَ منها نَشْوَةٌ قبلَ نشأتي","معي أبداً تبقى وإنْ بَليَ العَظْم",194,"م",1,0],["وَعندما فهموا مغزى مخاطبتي","تراجعوا بينهم في الأمر وانسحبوا",195,"ب",3,0],["وَعند هدوء اللَيث يفتح عينه","وَعند زئير الليث للعين يغمض",196,"ض",1,0],["وَعند من هو غرّ","يَجوز ما لا يَجوز",197,"ز",1,0],["وَعند ذلك يَجري في جواهره","كَالماءَ قَد صادَفتَه جارِياً حُفر",198,"ر",1,0],["وعنَّت لي رؤى هيمٍ طواةٍ","تلفهمُ التهائمُ والنجود",199,"د",1,0],["وعن ذملان العيس إن سامحت به","وإلاّ ففي أكوارهنّ عقاب",200,"ب",1,0],["وعند ذا تحملني","وريقةٍ من فنَنِ",201,"ن",1,0],["وعن الخطيئةِ في مذاهبهمْ","بدأتْ بآدمَ أم بحوَّاءِ",202,"ا",2,0],["وعَنْهُ عَفا رَبِّي وأَحْسَنَ حِفْظَهُ","عَزِيزٌ علينا حَاجَةٌ لا يَنالُها",203,"ه",2,1],["وعند الليالي عادة مستمرة","من الجور في بعد من الأرض أو قرب",204,"ب",1,1],["وعَنْ آلِ حَكّارٍ جَرى سَمَرُ العُلى","بأكمَلِ معنىً لا انتِقاصٌ ولا غَمْطُ",205,"ط",1,0],["وعنبرَ العُبَّادِ في الجوامعِ","وسمرالزهاد في الصوامع",206,"ع",1,0],["وعَنَّتْ له رِيحٌ تُسَاقِطُ قَطْرَهُ","كما نَثَرَتْ حَسْنَاءُ مِن جيدهَا سِمْطَا",207,"ط",2,0],["وَعَن أُقحُوانِ الرَملِ ما هُوَ فاعِلٌ","إِذا هُوَ أَمسى لَيلَةٌ بِثَرىً جَعدِ",208,"د",1,0],["وَعَن جارَتَينا بِالبَتيلِ إِلى الحِمى","عَلى عَهدِنا أَم لَم تَدوما عَلى عَهدِ",208,"د",1,0],["وَعَن عُلُوِيّاتِ الرِياحِ إِذا جَرَت","بِريحِ الخُزامى هَل تَهُبُّ إِلى نَجدِ",208,"د",1,0],["وَعِندَ الحَطيمِ قَد ذَكَرتُكِ ذِكرَةً","أَرى أَنَّ نَفسي سَوفَ يَأتيكَ حوبُها",209,"ب",3,0],["وعِندَ الإِلَهِ ما يَكيدُ عِبادَهُ","وكُلاًّ يُوَفّيهِ الجَّزاءَ بِمِثقالِ",210,"ل",1,1],["وَعَنْ رَوْضَةِ الْمِقْيَاسِ تَجْرِي خِلالَها","جَدَاوِلُ يُسْدِيهَا الْغَمَامُ بِمَا يُسْدِي",211,"ي",1,0],["وَعَنْ جَائِلٍ مِنْ دُونِهِ البَرْقُ سُرْعَةً","وَنُوراً فَلاَ بُعْدٌ يَعُوقُ وَلاَ سِتْرُ",212,"ر",1,0],["وَعَنْ خَافِقٍ مِلءَ الْوَفاءِ خُفُوقُهُ","عَجِبْتُ لهُ أَنْ يَسْتَقِلَّ بِهِ الصَّدرُ",212,"ر",1,0],["وَعَنْ نَافِحٍ طِيبَ الرِّيَاضٍ مُنَوَّرٍ","بِأجْمَلِ مَا تَزهو الرَّيَاحِينُ وَالزهْر",212,"ر",1,0],["وَعَنِ البِرِّ مِنْ خَلِيلٍ فَحَدِّثْ","يَوْمَ لاَ يَعْرِفُ الخَلِيلَ الخَلِيلُ",213,"ل",1,0],["وَعَنِ الرِّفْقِ بِالحَرِيبِ وَعَنْ عَوْ","لِ اليَتِيمِ الغَرِيبِ فِيمَنْ يَعُولُ",213,"ل",1,0],["وَعَنِ الدَّأْبِ فِي مُوَاطِنِهِ حَتَّى","لَيغْدُو فِي المُمْكِنِ المُسْتَحِيلُ",213,"ل",1,0],["وَعَنْ كُلِّ مَحْزُونٍ وَعَنْ كُلِّ بَائِسٍ","بِهَا عَادَ عَنْ بَابِ الأمِيرَة بِالْجَدَا",214,"د",2,0],["وَعَنْ كُلِّ خِرِّيجٍ بِعِلْمٍ وَصَنْعَةٍ","أَقَامَتْ لَهُ فِي سَاحَة الْفَضْلِ مَعْهَدَا",214,"د",2,0],["وَعِنْدَ النَّوَى تُوفَى الأَمَانَاتُ أَهْلَهَا","وَيُنْهَى إِلى أَرْبَابِهِ كُلُّ مُوَدعِ",215,"ع",1,0],["وَعَنَتْها شَتَّى الشُّؤونِ وَلمْ","تحْفَلْ لِمَا كَانَ بِالعِنَايَة أَحْرَى",216,"ر",2,0],["وَعِنْدَ اللهِ أَنِّي لاَ أٌرَجِّي","لَدَى غَيْرِي عَلَيْهَا مِنْ ثَوَابِ",217,"ب",1,0],["وَعِندِيَ صِدقُ الضَربِ في كُلِّ مَعرَكٍ","وَلَيسَ عَلَيَّ إِن نَبَونَ المَضارِبُ",218,"ب",1,0],["وَعِندَ الغَواني حَلَّ حلُّ عُقودُها","وَجازى جَزاءَ الوُدِّ بِالشَنآنِ",219,"ن",1,0],["وَعَنسٍ كَأَلواحِ الإِرانِ نَسَأتُها","عَلى لاحِبٍ كَالبُردِ ذي الحَبَراتِ",220,"ت",1,0],["وعن ملوك إستبوا","أو سبأوا مليون دن",221,"ن",1,0],["وعن وعد ربيعي","وراء عيونها أغفى",222,"ف",2,0],["وَعَنَا لهم عَرَبٌ عَنَتُ","لهُمُ القَيَاصِرُ، والأكاسر",223,"ر",1,0],["وعن قريبٍ بحولِ الله أحْفظُهُ","فرُبّما أدْرك الغاياتِ مَنْ طلبا",224,"ب",2,0],["وعن المنحنى، عن السفح يحكي:","وسوساتٍ، منها الجنون استعاذا",225,"ذ",2,0],["وعَنَتْ لِسَطْوَتِكَ المُلوكُ وَلَمْ تَزَلْ","فصْلِ الخطاب أوامِراً وفصولا",226,"ل",2,0],["وعن ذمِّ محمودٍ لفرط مَنَاعةٍ","وعن حَمد مذمومٍ لفرطِ التحذلُق",227,"ق",1,0],["وعنديَ من لفظٍ جزيلٍ وصنعةٍ","لبابٌ وطبعٌ كالُمدام المعتَّق",227,"ق",1,0],["وعندَنا ساسةٌ سؤنا لَهُم تَبَعاً","ذُلاً ، وساؤوا لنا في الهدي مُتَّبعا",228,"ع",2,0],["وعندنا \" سِلعةٌ \" تُصفي البنينَ لنا","نُغلي – ونُرخصها – في الأزمة السِلعا",228,"ع",2,0],["وعندكُمُ تفويضةٌ تعرفونها","وفي يدكُمْ منها كتابٌ مُسَجَّل",229,"ل",1,0],["وعنكُمُ أخَذَتْ مِصرٌ مساهِمةً","في مُعجِبٍ من طريف القول فَينْان",230,"ن",1,0],["وعناهُمُ أخذُ الكِرامِ عِنانَها","من بعد ما داروا عليه وحاموا",231,"م",3,0],["وعن أي المبادئِ ضيَّعوهُ","دماً لم يألُهِ الناسُ اطِّلابا",232,"ب",2,0],["وعَنْ مصارَعةِ الدُّنيا على نَشَبٍ","الحَالُ تُوجبهُ والنفسُ تأباه",233,"ا",2,0],["وعن مواقفَ تُدمي القلبَ غُصَّتُها","لا المالُ يَدفعُ ذِكراها ولا الجاه",233,"ا",2,0],["وعن أذايا يّهدُّ النفسَ مَحمِلُها","ويَستثَيرُك جانيها ومَرآه",233,"ا",2,0],["وعندي لسانٌ لم يُخِّني بمحفِلٍ","كما سَيْف عمروٍ لم يَخنُه بمشْهَد",234,"د",1,0],["وعندكَ قوةُ التعبير عما","تُحسُّ وميزةُ الشُعراء نُطقُ",235,"ق",1,0],["وَعُنثَلةُ والخَيُْوان وبَرْسَلُ","وَفَْرخُ فريقُ والرَّفلَّةُ والرَّفلْ",236,"ل",1,0],["وعني اقرئها السم وقل لها:","زعمت بألا يكتم السر بائح",237,"ح",1,0],["وعن سرَّكمْ في مُضمَرِ القلبِ والحشا","شَفِيقٌ عَليكُمْ لا تُخَافُ غوائِلُهْ",238,"ل",2,0],["وَعِندَ رَسُولِ الله، إذْ شَدّ قَبضَهُ،","وَمُلِّىءَ مِنْ أسْرَى تَمِيمٍ أداهِمُهْ",239,"م",2,0],["وَعِنْدَ أبي بِشْرِ بن أحْوَزَ مِنْهُمُ","عَلى جِيَفِ القَتْلى نُسُورٌ عَوَاكِفُ",240,"ف",1,0]]}