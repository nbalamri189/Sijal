{"poems":[[72,"غبت عني فما الخبر","https://www.aldiwan.net/poem42903.html","مجزوء الخفيف"],[91,"انت ما ان تخففين مصابي","https://www.aldiwan.net/poem44901.html","الخفيف"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[203,"يا غلام ارقب الفجر حتى","https://www.aldiwan.net/poem45640.html","الخفيف"],[228,"ناقم على السماء","https://www.aldiwan.net/poem41593.html","مجزوء الرمل"],[333,"سكر الليل بكاسات السكون","https://www.aldiwan.net/poem54974.html","الخفيف"],[406,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[422,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[422,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[473,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[563,"لي في الإله عقيدة غراء","https://www.aldiwan.net/poem35090.html","الكامل"],[572,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53859","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54031","الرجز"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18530","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100965","الخفيف"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216656",""],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10411","المنسرح"],[2750,"","https://poetry.dctabudhabi.ae/diwan/poem/143739","الرمل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99542","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115804","المنسرح"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3622,"","https://poetry.dctabudhabi.ae/diwan/poem/204344","المنسرح"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93745","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52168","السريع"],[4987,"نهار الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=49578",""],[5055,"شوف ألماس","https://www.poetsgate.com/ViewPoem.aspx?id=103651",""],[5111,"طَيْفٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212426",""],[5198,"الممكن المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=135392",""],[5324,"قل لمن اطلب وده.","https://www.poetsgate.com/ViewPoem.aspx?id=211232",""],[5431,"هذا بعلي!!....","https://www.poetsgate.com/ViewPoem.aspx?id=201150",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""]],"verses":[["بَينَ شادٍ وَشادِنٍ","نُزهَةُ السَمعِ وَالبَصَر",0,"ر",1,0],["بين شعري وما يجيش بصدري","من شعور وشائج الانساب",1,"ب",1,0],["بين شقرٍ وملتقى نهريها","حيث ألقت بنا الأماني عصاها",2,"ا",3,1],["بَيْنَ شَكٍ وَيَقِينٍ قاتِلٍ","يَنْشُرُ الْخَوْفَ وَيَطْوِي الْحَذَرَا",3,"ر",2,0],["بَيْنَ شِعْرٍ كأزاهيرِ الرُّبا","عَكَفَ الغَيْثُ عليها فَسَقاها",4,"ا",3,0],["بينَ شمسٍ تدورُ في كفِّ بدرٍ","وعيونٍ من الزهورِ نيامِ",5,"م",1,0],["بَينَ شَهوَة الجَسَد","وَالرَحيق",6,"ق",1,0],["بين شوق وحنين","وسهاد ومنام",7,"م",1,0],["بين شرقٍ وبين غربٍ مكثتم","تَتْبَعُون العَنْقَاءَ والحَيْزُبَونَا",8,"ن",2,0],["بينَ شرقٍ ومغربٍ نَنْتَحيه","فشمالاً طوراً وطوراً يمينا",9,"ن",2,0],["بين شادٍ تطرب النفس به","يتغنَّى ومليح يتأوَّد",10,"د",1,0],["بَينَ شَقيقٍ صُدغُهُ حالَكَ","وَأُقحُوانٍ ثَغرُهُ أَشنَبُ",11,"ب",1,0],["بين شوق نما وصبر يسيرٍ","ويح قلبي في حب ظبيٍ غريرٍ",12,"ر",1,0],["بي نشأتان طفقت أسرح فيهما","لي هذه صبح وتلك مساء",13,"ا",2,0],["بَيْنَ شَقِيْقٍ صَقِيْلِ خَدٍّ","وَأُقْحُوَانٍ نَقِيِّ ثَغْرِ",14,"ر",1,0],["بين شخصيهما ضرير إذا ما","قعدت عن شماله تتغَّنى",15,"ن",2,0],["بين شريكين على المعروف","بما لديهما من الظروف",16,"ف",1,0],["بَينَ شَيخٍ خاضِبٍ عُثنونَهُ","وَفَتىً أَبيَضَ وَضّاحٍ رِفَل",17,"ل",1,0],["بين شيب بالحزم تحدو شباباً","صادقي العزم ثاقبي النظرات",18,"ت",1,0],["بِيْ نشا وِدَّكْ وبِهْ قَلْبِيْ انتشا","دونكم مَا بَيْن غربة واغتراب",19,"ب",1,0],["بين شعث غبر أفاضوا عشاء","قد أفاضوا دموعهم بانسكاب",20,"ب",1,0],["بَينَ شُكولِ النِساءِ خِلقَتُها","قَصدٌ فَلا جَبلَةٌ وَلا قَضَفُ",21,"ف",1,0],["بين شطَّيْ رنْد وردِ","فتلالِ الجبلينِ",22,"ن",1,0],["بين شخصي وبين شخصك بعدٌ","غير أن الخيال بالوصل سمح",23,"ح",1,0],["بين شقيقٍ وسوسنٍ عبقٍ","وبين ورد وبين نسرين",24,"ن",1,0],["بين شك ويقين لم تجد","فيه من ميل إلى التفنيد بدا",25,"د",2,0],["بين شموسٍ تظلها سدفٌ","على غصون تقلها كثب",26,"ب",1,0],["بين شيح وجعدة وخزامى","نبتت في رياض تلك الجزيره",27,"ه",1,0],["بين شك تراوحوا وَيقين","وَدَوام العنا لِمَن جَهلوكا",28,"ك",2,0],["بين شذوذِ الحكم في بأسه","وعند حقّ المرء في دهره",29,"ر",2,0],["بين شقر الجدايل والعيون الوساع","اذكر اني فقدت القلب في هالحراوي",30,"ا",3,0],["بين شوف الماس والباسه فرقّ","فرق ما بين المعاني والحروف",31,"ف",1,1],["بيْنَ شَدْوٍ وَحَنِينٍ","صَرْتَ طَيفًا يَتَوَالَى!",32,"ل",2,0],["بين شمس الشروق وبين شمس الاصيل","كلّ شيِّ تراه العين وانت بهواك",33,"ك",1,0],["بين شك ويقين","حائر قلبي عنده",34,"د",2,0],["بين شمعٍ ملغّمٍ بالخطايا","كشظايا على السرير دعيهْ!",35,"ي",2,0],["بين شدقيه يحتفان المقادير","وحكم القضاء دون شبانه",36,"ه",1,0],["بَينَ شَكٍّ وَخَوفٍ مَفرِقِي- لَيلَى -","مُنذَرٌ ضَربَةً تَجتَاحُهُ صَدعا",37,"ع",2,0]]}