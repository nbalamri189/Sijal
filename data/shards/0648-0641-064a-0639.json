""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35131","الطويل"],[4620,"","https://poetry.dctabudhabi.ae/diwan/poem/199993","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139639",""],[4755,"وفِي عَصْرِ ذاكَ اليَومِ هانَت عَظَائِمُ","https://www.poetsgate.com/ViewPoem.aspx?id=184568",""],[4578,"تكمَّل بالتوفيق حجك والمنا","https://www.poetsgate.com/ViewPoem.aspx?id=49533",""],[4875,"باقة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=133358",""],[4927,"مي","https://www.poetsgate.com/ViewPoem.aspx?id=29958",""],[557,"نحن والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=13969",""],[4999,"قدميّ أمي","https://www.poetsgate.com/ViewPoem.aspx?id=184282",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5106,"سَاْجَ الهَوَىْ وًرِشَاً ..","https://www.poetsgate.com/ViewPoem.aspx?id=137169",""],[5120,"رَفِيقَةُ الْقَمَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=179961",""],[5121,"حنين ودموع","https://www.poetsgate.com/ViewPoem.aspx?id=33628",""],[5121,"قبلة الود","https://www.poetsgate.com/ViewPoem.aspx?id=37450",""],[5129,"إلى أمي ... عيونك إرهاص لقافيتي","https://www.poetsgate.com/ViewPoem.aspx?id=120506",""],[5277,"حروفٌ لا تعرفها الأبجدية","https://www.poetsgate.com/ViewPoem.aspx?id=195244",""],[5277,"صباحُ الحليلة","https://www.poetsgate.com/ViewPoem.aspx?id=198649",""],[5277,"وضوءُ عيونها","https://www.poetsgate.com/ViewPoem.aspx?id=201900",""],[5277,"طيفٌ من الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=202117",""],[5277,"شظفُ المنافي","https://www.poetsgate.com/ViewPoem.aspx?id=203512",""],[5277,"\" من البغداديات \"","https://www.poetsgate.com/ViewPoem.aspx?id=210741",""],[5284,"مُرَادُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=190633",""],[5324,"إلى عينيك.","https://www.poetsgate.com/ViewPoem.aspx?id=211406",""],[5376,"ألا قمْ يا أميرَ المؤمنينا","https://www.poetsgate.com/ViewPoem.aspx?id=202791",""],[5387,"الشعرُ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=46996",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5387,"سد الكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=53806",""],[5411,"رِسالَتك الوَحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185460",""],[5431,"جعلتَ القلبَ بكّاءً وليّا ولم يكُ قبْلَ أنْ يهواكَ شيّا","https://www.poetsgate.com/ViewPoem.aspx?id=189483",""],[5431,"أنوحُ وقد نجا بالركبِ نوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=189541",""],[5431,"ولكن طبعي بالغرام ملولُ","https://www.poetsgate.com/ViewPoem.aspx?id=189852",""],[5431,"ولا يبلغ اللذات إلا مناضلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190230",""],[5536,"إلى هوازن من عدنان منتسبي","https://www.poetsgate.com/ViewPoem.aspx?id=37054",""],[5536,"زمن الاقزام!!","https://www.poetsgate.com/ViewPoem.aspx?id=22808",""],[5616,"جمعة حسين","https://www.poetsgate.com/ViewPoem.aspx?id=203500",""],[5616,"حرص","https://www.poetsgate.com/ViewPoem.aspx?id=207652",""],[5644,"وفيكِ من الجمال دلال طفل","https://www.poetsgate.com/ViewPoem.aspx?id=199958",""],[5674,"أبحث عن خطاك","https://www.poetsgate.com/ViewPoem.aspx?id=187322",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5742,"نفح العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=206890",""],[5783,"زوجتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=61545",""],[5818,"بلى يؤذيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=196971",""],[5939,"الرجل الحديدي","https://www.poetsgate.com/ViewPoem.aspx?id=188441",""],[5973,"تعجلت الرحيل إلي الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22123",""],[5975,"بقلبي حبُّكِ السامي يقيم","https://www.poetsgate.com/ViewPoem.aspx?id=58503",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6078,"في غربةِ القمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=202773",""],[6152,"صباحي أنتِ 4","https://www.poetsgate.com/ViewPoem.aspx?id=208534",""],[6202,"بنت قحطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86713&r=&rc=14",""],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[6344,"سؤالٌ خارج حدود النُّبوءة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87961&r=&rc=1",""]],"verses":[["وفيَّ عُرَيْقٌ منْ قُرَيشٍ تعطَّفَتْ","عليّ بهِ أعياصُها والعَنابِسُ",0,"س",1,0],["وَفى عُروَةَ العُذريِّ إِن مِتُّ أُسوَةٌ","وَعَمروِ بنِ عَجلانَ الَّذي قَتَلَت هِندُ",1,"د",1,1],["وفي عَلْياكَ لي كنْزُ اعْتِقادٍ","علَى أمْثالِهِ تُطْوَى الضُّلوعُ",2,"ع",1,0],["وفي عالَمِ الحِسِّ اغْتَدَيْتَ مُبَوّأ","لتَشْفي مَنِ اسْتَشْفى وتَهْدي منِ اسْتَهْدى",3,"د",2,0],["وَفي عالَمِ الإِسلامِ في كُلِّ بُقعَةٍ","لَهُ أَثَرٌ باقٍ وَذِكرٌ مُعَطَّرُ",4,"ر",1,0],["وَفِي عَيْنَيْكِ سِحْرٌ بَابِلِيٌّ","فَلا يُدْرَى أَمَاءٌ أَمْ ضِرَامُ",5,"م",1,0],["وفي عنان السماء قد طلعت","أهِلّة في إزائها صُلُب",6,"ب",1,0],["وَفي عِضادَتِهِ اليُمنى بَنو أَسَدٍ","وَالأَجرَبانِ بَنو عَبسٍ وَذُبيانُ",7,"ن",1,1],["وفي عضدي بدر الجمال موسدٌ","وقد قدِحت للرَّاح في خدهِ زندُ",8,"د",1,0],["وفي عَماها لها شغلٌ وإن طمحتْ","في الجو حتى تُرَى فوقَ المراعيش",9,"ش",1,0],["وفي عرضها بالشبر وقفاً وطولها","بخمسة أشبار بشبر مفرَّقِ",10,"ق",1,0],["وَفى عَلَيها وَهيَ تَش","طُرُ كَالفَراشَةِ فَاِشتَهاها",11,"ا",3,0],["وفي عياض عن كل هذا","ردوا شبابي ردوا شبابي",12,"ب",2,0],["وَفي عَفوِهِ لَو تَعلَمونَ عُقوبَةٌ","تُقَعقِعُ في الأَعراضِ إِن لَم يُعاقِبِ",13,"ب",1,0],["وَفى عَليٌّ بِمَواعيدِهِ","وَلَم يُنَقِّصها بِإِخداجِ",14,"ج",1,0],["وَفي عَينَيكَ تَرجَمَةٌ أَراها","تَدُلُّ عَلى الضَغائِنِ وَالحُقودِ",15,"د",1,0],["وفي عينيك تقتيلُ","وفي البسمات غفرانُ",16,"ن",1,0],["وفَّى عُلومَ الأوّلين حُقوقَها","والآخِرِينَ وَفاءَ مَنْ لم يَجْحَدِ",17,"د",1,0],["وَفي عَينَيكَ ما أَبلَ","غَ في قَتلِيَ يا جاني",18,"ن",2,0],["وفي عينيكَ أسرارٌ حيارى","تُكذِّبُ ما تحاول أن تقولَهْ",19,"ل",2,0],["وَفِي عَوَالِمِ أَفْلاَكٍ تُحِيطُ بِنَا","مَا بَيْنَ مُحْتَجِبٍ مِنْهَا وَمَرْصُودِ",20,"د",1,0],["وَفِي عِنَايَاتِ خَيْرِ أُمٍّ","يَصْدِرُ عَنْ رَأْيِهَا الرَّشِيدِ",21,"د",1,0],["وَفي عَبدِ الغَنيِّ اِبني","عَصيتُ الصَبرَ حينَ نَهى",22,"ن",3,0],["وفي عدله حسب اقتضاه شئونه","تدابير وحدانية لا تمانع",23,"ع",1,0],["وفي عين هذا العدل فضل محقق","الى مستقر الفضل والجود نافع",23,"ع",1,0],["وفي عصبيَّاتٍ غِلاظٍ تسامُحاً","وفي مُلْتوٍ مِنْ نهجها منهجاً لحَبا",24,"ب",2,0],["وفي عطف يثير هوى ملحّا","إذا رفّت عليه ذوءابتاها",25,"ا",3,0],["وفي عين هذا العدل فضل محقق","إلى مستقر الفضل والجود دافع",26,"ع",1,0],["وَفِي عَطْفِهَا المُضْنَى وَفِي رِدْفِهَا العَبْلِ","وُتُخْلُقُ زُوراً فِي المَحَاجِرِ أَدْمُعَا",27,"ع",2,0],["وفي عهد بقلبي ذكره ابدا","يجرى وفي طي روحي والضمير وفي",28,"ف",2,0],["وفي عسكر الليل البهيم أباده","فجوعه جاهاً وأشبعه فقرا",29,"ر",2,0],["وفي عامِ سبعٍ بعدها مائةٌ","خَلَتْ وألف نظامى عندهن سلام",30,"م",1,0],["وفي عامِ ألفٍ معْ ثمان تمامُها","كذَا مائةٌ في عدِّ كلِّ مُؤَمِّلِ",31,"ل",1,0],["وفي عدن قامت عليهم قيامة","وقد ركبوا في قصدها الركب الصعبا",32,"ب",2,0],["وَفِيَّ عَلى عَضِّ اللَيالي بَقِيَّةٌ","وَإِن قُطِعَت مِن راحَتَيّ الأَنامِلُ",33,"ل",1,0],["وَفِيَّ عَلى حَزِّ المدى خُنزُوَانَةٌ","وَلَو أَفنَتِ الأَحداثُ حالِي وَماليا",34,"ي",2,0],["وفي عمّون طَيْرُ الحُبِّ يَشْدو","مواويلا يُردِّدُها التّصابي",35,"ب",2,0],["وفي عَذَباتِ الرملِ دون هِرَقْلَةٍ","مَسارحُ نسعى بينها ومَراتع",36,"ع",1,0],["وفي عشر واربع قد وصلنا","إلى جدة بلاد المسلمينا",37,"ن",2,0],["وفي عشر لقعدة مع ثمان","وصلنا مكّة مستبشرينا",37,"ن",2,0],["وفي عرفات جمعاً قد وقفنا","فكم فيها دموعاً مسبلينا",37,"ن",2,0],["وَفي عَينَيكِ يَستَهوي عَفافٌ","لهُ في النَفسِ جاذِبُهُ الخفيُّ",38,"ي",1,0],["وَفي عُيونِيَ مرآةً أَراكِ بها","وَفي فُؤاديَ مُؤاساةً لآلامي",39,"ي",1,0],["وَفي عَقِداتِ الرَملِ ظَبيٌ كِناسُهُ","صُدورُ العَوالي شُرَّعاً وَالصَوارِمِ",40,"م",1,0],["وَفِي عِلْمِ الْمَنَائِرِ كُلَّ وَقْتٍ","نَهَارِيٍّ تَحِينُ بِهِ الصَّلاَةُ",41,"ه",1,0],["وفي عدلك الشرع الشريف ممثل","وفي حكمك الأمثال تتلى وتضرب",42,"ب",1,0],["وفي علمِ العَرُوض دخلتُ جَهلا","وعُمتُ بخفَّتي في كلِّ بَحرٍ",43,"ر",1,0],["وفي عرفات الجمع عرفان فرقةٍ","ونيل المنا بعد الدنوّ لزلفة",44,"ه",1,0],["وفي عصره يستيقظ العدل في الورى","كما نام في أيّامنا نومة الفهد",45,"