{"poems":[[65,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[36,"وفى عروة العذري إن مت أسوة","https://www.aldiwan.net/poem4879.html","الطويل"],[79,"أمسعود بن يوسف طير قلبي","https://www.aldiwan.net/poem35985.html","الوافر"],[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[88,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[95,"قوامك لا يعادله قوام","https://www.aldiwan.net/poem11346.html","الوافر"],[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[23,"وفي عضادته اليمنى بنو أسد","https://www.aldiwan.net/poem21624.html","البسيط"],[74,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[53,"نبئت أن رجالا لا خلاق لهم","https://www.aldiwan.net/poem64927.html","البسيط"],[53,"إذا أحدقوا بي في المكر حجزتهم","https://www.aldiwan.net/poem65735.html","الطويل"],[93,"الحشد ملء الدار لكن","https://www.aldiwan.net/poem62804.html","عموديه"],[91,"خذوا تراثي بلا حساب","https://www.aldiwan.net/poem44781.html","مخلع البسيط"],[47,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[47,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[47,"أإبراهيم دعوة مستعيد","https://www.aldiwan.net/poem63459.html","الوافر"],[99,"أحقا كنت في قربي","https://www.aldiwan.net/poem24769.html","مجزوء الوافر"],[69,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[50,"ألا قولا لحمدان","https://www.aldiwan.net/poem66129.html","الهزج"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39619","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54705","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[96,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[111,"ألا هل لداعي الله في الأرض سامع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545618",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[119,"طرز الغرام على اهليه غير خفي","https://www.aldiwan.net/poem40896.html","عموديه"],[119,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[132,"بنى مصعب أنتم أولو العلم والهدى","https://www.aldiwan.net/poem50505.html","الطويل"],[132,"نهيم بهم وجدا ونحن بقربهم","https://www.aldiwan.net/poem50551.html","الطويل"],[164,"شممت نسيما من وصالك لوهبا","https://www.aldiwan.net/poem58997.html","الطويل"],[173,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[182,"إلى عمان","https://www.aldiwan.net/poem50694.html","الوافر"],[189,"لعل اعترافي باقترافي شافع","https://www.aldiwan.net/poem14578.html","الطويل"],[210,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[227,"أتيت فأورق الأدب السني","https://www.aldiwan.net/poem41440.html","الوافر"],[227,"إمحي السواد عن الأهداب في المقل","https://www.aldiwan.net/poem41914.html","البسيط"],[239,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[241,"ألا اسمع قد أجابتك الهداة","https://www.aldiwan.net/poem18096.html","الوافر"],[243,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[254,"قطعت شبيبتي وأضعت عمري","https://www.aldiwan.net/poem14971.html","الوافر"],[263,"عرائس حسن بالجمال تجلت","https://www.aldiwan.net/poem35563.html","الطويل"],[263,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[263,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[274,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[275,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[286,"إذا جزتما بالعيس دورة آبل","https://www.aldiwan.net/poem32646.html","الطويل"],[308,"الشك والوهم رأس الشر والحذر","https://www.aldiwan.net/poem16792.html","البسيط"],[308,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[308,"تبلغ بالقليل من القليل","https://www.aldiwan.net/poem16844.html","الوافر"],[308,"خليلي إن الشوق قد كاد أن يبلى","https://www.aldiwan.net/poem16904.html","الطويل"],[332,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[353,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[353,"شرعة وجدي ما لها نسخ","https://www.aldiwan.net/poem15566.html","السريع"],[353,"أراني عنك محدود","https://www.aldiwan.net/poem15634.html","الهزج"],[368,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[368,"أيا أهدى من الشهب السواري","https://www.aldiwan.net/poem60892.html","السريع"],[375,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[395,"كلام الناس ما له راس فاترك","https://www.aldiwan.net/poem54556.html","عموديه"],[404,"إيقاعات على نيل مصر","https://www.aldiwan.net/poem6726.html","عموديه"],[407,"أبثك أني ما وجدت مشقة","https://www.aldiwan.net/poem33357.html","الطويل"],[407,"علام يلام القلب إن ظل حيرانا","https://www.aldiwan.net/poem33375.html","الطويل"],[407,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[420,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[420,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[443,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[445,"قفوا أيها الركبان نودعكم منا","https://www.aldiwan.net/poem14339.html","الطويل"],[461,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[461,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[467,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[467,"تأملت تصنيف هذا السعيد","https://www.aldiwan.net/poem3565.html","عموديه"],[480,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[503,"أصاحب بيتي إن في مسدل الخفا","https://www.aldiwan.net/poem38001.html","الطويل"],[508,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[518,"أيا مالكاً تسمو به رتب العلى","https://www.aldiwan.net/poem12021.html","الطويل"],[543,"خطبت إلى كعب فردوك صاغرا","https://www.aldiwan.net/poem56808.html","الطويل"],[556,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[561,"صريح كلامي في الوجود وإيمائي","https://www.aldiwan.net/poem35088.html","الطويل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/18044","البسيط"]],"verses":[["وفيَّ عُرَيْقٌ منْ قُرَيشٍ تعطَّفَتْ","عليّ بهِ أعياصُها والعَنابِسُ",0,"س",1,0],["وَفى عُروَةَ العُذريِّ إِن مِتُّ أُسوَةٌ","وَعَمروِ بنِ عَجلانَ الَّذي قَتَلَت هِندُ",1,"د",1,1],["وفي عَلْياكَ لي كنْزُ اعْتِقادٍ","علَى أمْثالِهِ تُطْوَى الضُّلوعُ",2,"ع",1,0],["وفي عالَمِ الحِسِّ اغْتَدَيْتَ مُبَوّأ","لتَشْفي مَنِ اسْتَشْفى وتَهْدي منِ اسْتَهْدى",3,"د",2,0],["وَفي عالَمِ الإِسلامِ في كُلِّ بُقعَةٍ","لَهُ أَثَرٌ باقٍ وَذِكرٌ مُعَطَّرُ",4,"ر",1,0],["وَفِي عَيْنَيْكِ سِحْرٌ بَابِلِيٌّ","فَلا يُدْرَى أَمَاءٌ أَمْ ضِرَامُ",5,"م",1,0],["وفي عنان السماء قد طلعت","أهِلّة في إزائها صُلُب",6,"ب",1,0],["وَفي عِضادَتِهِ اليُمنى بَنو أَسَدٍ","وَالأَجرَبانِ بَنو عَبسٍ وَذُبيانُ",7,"ن",1,1],["وفي عضدي بدر الجمال موسدٌ","وقد قدِحت للرَّاح في خدهِ زندُ",8,"د",1,0],["وفي عَماها لها شغلٌ وإن طمحتْ","في الجو حتى تُرَى فوقَ المراعيش",9,"ش",1,0],["وفي عرضها بالشبر وقفاً وطولها","بخمسة أشبار بشبر مفرَّقِ",10,"ق",1,0],["وَفى عَلَيها وَهيَ تَش","طُرُ كَالفَراشَةِ فَاِشتَهاها",11,"ا",3,0],["وفي عياض عن كل هذا","ردوا شبابي ردوا شبابي",12,"ب",2,0],["وَفي عَفوِهِ لَو تَعلَمونَ عُقوبَةٌ","تُقَعقِعُ في الأَعراضِ إِن لَم يُعاقِبِ",13,"ب",1,0],["وَفى عَليٌّ بِمَواعيدِهِ","وَلَم يُنَقِّصها بِإِخداجِ",14,"ج",1,0],["وَفي عَينَيكَ تَرجَمَةٌ أَراها","تَدُلُّ عَلى الضَغائِنِ وَالحُقودِ",15,"د",1,0],["وفي عينيك تقتيلُ","وفي البسمات غفرانُ",16,"ن",1,0],["وفَّى عُلومَ الأوّلين حُقوقَها","والآخِرِينَ وَفاءَ مَنْ لم يَجْحَدِ",17,"د",1,0],["وَفي عَينَيكَ ما أَبلَ","غَ في قَتلِيَ يا جاني",18,"ن",2,0],["وفي عينيكَ أسرارٌ حيارى","تُكذِّبُ ما تحاول أن تقولَهْ",19,"ل",2,0],["وَفِي عَوَالِمِ أَفْلاَكٍ تُحِيطُ بِنَا","مَا بَيْنَ مُحْتَجِبٍ مِنْهَا وَمَرْصُودِ",20,"د",1,0],["وَفِي عِنَايَاتِ خَيْرِ أُمٍّ","يَصْدِرُ عَنْ رَأْيِهَا الرَّشِيدِ",21,"د",1,0],["وَفي عَبدِ الغَنيِّ اِبني","عَصيتُ الصَبرَ حينَ نَهى",22,"ن",3,0],["وفي عدله حسب اقتضاه شئونه","تدابير وحدانية لا تمانع",23,"ع",1,0],["وفي عين هذا العدل فضل محقق","الى مستقر الفضل والجود نافع",23,"ع",1,0],["وفي عصبيَّاتٍ غِلاظٍ تسامُحاً","وفي مُلْتوٍ مِنْ نهجها منهجاً لحَبا",24,"ب",2,0],["وفي عطف يثير هوى ملحّا","إذا رفّت عليه ذوءابتاها",25,"ا",3,0],["وفي عين هذا العدل فضل محقق","إلى مستقر الفضل والجود دافع",26,"ع",1,0],["وَفِي عَطْفِهَا المُضْنَى وَفِي رِدْفِهَا العَبْلِ","وُتُخْلُقُ زُوراً فِي المَحَاجِرِ أَدْمُعَا",27,"ع",2,0],["وفي عهد بقلبي ذكره ابدا","يجرى وفي طي روحي والضمير وفي",28,"ف",2,0],["وفي عسكر الليل البهيم أباده","فجوعه جاهاً وأشبعه فقرا",29,"ر",2,0],["وفي عامِ سبعٍ بعدها مائةٌ","خَلَتْ وألف نظامى عندهن سلام",30,"م",1,0],["وفي عامِ ألفٍ معْ ثمان تمامُها","كذَا مائةٌ في عدِّ كلِّ مُؤَمِّلِ",31,"ل",1,0],["وفي عدن قامت عليهم قيامة","وقد ركبوا في قصدها الركب الصعبا",32,"ب",2,0],["وَفِيَّ عَلى عَضِّ اللَيالي بَقِيَّةٌ","وَإِن قُطِعَت مِن راحَتَيّ الأَنامِلُ",33,"ل",1,0],["وَفِيَّ عَلى حَزِّ المدى خُنزُوَانَةٌ","وَلَو أَفنَتِ الأَحداثُ حالِي وَماليا",34,"ي",2,0],["وفي عمّون طَيْرُ الحُبِّ يَشْدو","مواويلا يُردِّدُها التّصابي",35,"ب",2,0],["وفي عَذَباتِ الرملِ دون هِرَقْلَةٍ","مَسارحُ نسعى بينها ومَراتع",36,"ع",1,0],["وفي عشر واربع قد وصلنا","إلى جدة بلاد المسلمينا",37,"ن",2,0],["وفي عشر لقعدة مع ثمان","وصلنا مكّة مستبشرينا",37,"ن",2,0],["وفي عرفات جمعاً قد وقفنا","فكم فيها دموعاً مسبلينا",37,"ن",2,0],["وَفي عَينَيكِ يَستَهوي عَفافٌ","لهُ في النَفسِ جاذِبُهُ الخفيُّ",38,"ي",1,0],["وَفي عُيونِيَ مرآةً أَراكِ بها","وَفي فُؤاديَ مُؤاساةً لآلامي",39,"ي",1,0],["وَفي عَقِداتِ الرَملِ ظَبيٌ كِناسُهُ","صُدورُ العَوالي شُرَّعاً وَالصَوارِمِ",40,"م",1,0],["وَفِي عِلْمِ الْمَنَائِرِ كُلَّ وَقْتٍ","نَهَارِيٍّ تَحِينُ بِهِ الصَّلاَةُ",41,"ه",1,0],["وفي عدلك الشرع الشريف ممثل","وفي حكمك الأمثال تتلى وتضرب",42,"ب",1,0],["وفي علمِ العَرُوض دخلتُ جَهلا","وعُمتُ بخفَّتي في كلِّ بَحرٍ",43,"ر",1,0],["وفي عرفات الجمع عرفان فرقةٍ","ونيل المنا بعد الدنوّ لزلفة",44,"ه",1,0],["وفي عصره يستيقظ العدل في الورى","كما نام في أيّامنا نومة الفهد",45,"د",1,0],["وفي عين الحقيقة لو ترآى","رأيت مجاز نيّته مغاير",46,"ر",1,0],["وفي عَينَيك أنوارٌ تُريني","عفافاً يَكتُم السرَّ الدَّفينا",47,"ن",2,0],["وَفي عواجة نار بت أَرقبها","كانها نار موسى لَيلَة الجبل",48,"ل",1,0],["وَفي عَينِ حورٍ حورُ عينٍ فَواتِكُ ال","لِحاظِ فِصاحُ اللَّفظِ خرسُ الخَلاخِلِ",49,"ل",1,0],["وفي عواقبه الخيرات والإحسان","فارم العواقب وادخل روضة الفكر",50,"ر",1,0],["وفي عرفات كل ذنبٍ مكفَّرٍ","ومغتفرٍ منا برحمة غافر",51,"ر",1,0],["وفي عصيانه عار ونار","وفيها البعد مع خزي وبيل",52,"ل",1,0],["وفي عرفات والمشاعر كلها","وخيف مني والهدى والرمى للأفلا",53,"ل",2,0],["وفي عالم الفكر أمثالها","تطوّق أفكاري الراجفه",54,"ه",1,0],["وَفي عَرَفاتِ الوَصلِ عَرَّفَني الهَوى","مَقامَ اِزدِلافي في الغَرامِ بِزُلفَتي",55,"ي",1,0],["وَفي عِظامِ الناسِ لي نَشأَةٌ","سَيّارَةٌ مَسكَنُها المُخُّ",56,"خ",1,0],["وَفي عَرشِكَ لي فَرشٌ","وَفَوقَ الفَرضِ تَوسيدُ",57,"د",1,0],["وفي عَذَبِ الأفنانِ من كُلِّ أيكةٍ","كَرائنُ للألحانِ يَغدونَ صُوَّغا",58,"غ",2,0],["وفي عزٍّ يَعِزُّ على المُعادِي","وفي طُولٍ يَطولُ على المُباري",59,"ر",2,0],["وفي عَ