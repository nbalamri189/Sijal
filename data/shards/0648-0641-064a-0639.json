{"poems":[[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[34,"وفى عروة العذري إن مت أسوة","https://www.aldiwan.net/poem4879.html","الطويل"],[77,"أمسعود بن يوسف طير قلبي","https://www.aldiwan.net/poem35985.html","الوافر"],[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[93,"قوامك لا يعادله قوام","https://www.aldiwan.net/poem11346.html","الوافر"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[23,"وفي عضادته اليمنى بنو أسد","https://www.aldiwan.net/poem21624.html","البسيط"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[51,"نبئت أن رجالا لا خلاق لهم","https://www.aldiwan.net/poem64927.html","البسيط"],[51,"إذا أحدقوا بي في المكر حجزتهم","https://www.aldiwan.net/poem65735.html","الطويل"],[91,"الحشد ملء الدار لكن","https://www.aldiwan.net/poem62804.html","عموديه"],[89,"خذوا تراثي بلا حساب","https://www.aldiwan.net/poem44781.html","مخلع البسيط"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[45,"أإبراهيم دعوة مستعيد","https://www.aldiwan.net/poem63459.html","الوافر"],[97,"أحقا كنت في قربي","https://www.aldiwan.net/poem24769.html","مجزوء الوافر"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[48,"ألا قولا لحمدان","https://www.aldiwan.net/poem66129.html","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39619","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54705","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[94,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[116,"طرز الغرام على اهليه غير خفي","https://www.aldiwan.net/poem40896.html","عموديه"],[116,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[129,"بنى مصعب أنتم أولو العلم والهدى","https://www.aldiwan.net/poem50505.html","الطويل"],[129,"نهيم بهم وجدا ونحن بقربهم","https://www.aldiwan.net/poem50551.html","الطويل"],[161,"شممت نسيما من وصالك لوهبا","https://www.aldiwan.net/poem58997.html","الطويل"],[170,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[170,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[179,"إلى عمان","https://www.aldiwan.net/poem50694.html","الوافر"],[186,"لعل اعترافي باقترافي شافع","https://www.aldiwan.net/poem14578.html","الطويل"],[207,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[224,"أتيت فأورق الأدب السني","https://www.aldiwan.net/poem41440.html","الوافر"],[224,"إمحي السواد عن الأهداب في المقل","https://www.aldiwan.net/poem41914.html","البسيط"],[236,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[238,"ألا اسمع قد أجابتك الهداة","https://www.aldiwan.net/poem18096.html","الوافر"],[240,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[251,"قطعت شبيبتي وأضعت عمري","https://www.aldiwan.net/poem14971.html","الوافر"],[260,"عرائس حسن بالجمال تجلت","https://www.aldiwan.net/poem35563.html","الطويل"],[260,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[260,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[271,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[272,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[283,"إذا جزتما بالعيس دورة آبل","https://www.aldiwan.net/poem32646.html","الطويل"],[305,"الشك والوهم رأس الشر والحذر","https://www.aldiwan.net/poem16792.html","البسيط"],[305,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[305,"تبلغ بالقليل من القليل","https://www.aldiwan.net/poem16844.html","الوافر"],[305,"خليلي إن الشوق قد كاد أن يبلى","https://www.aldiwan.net/poem16904.html","الطويل"],[329,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[350,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[350,"شرعة وجدي ما لها نسخ","https://www.aldiwan.net/poem15566.html","السريع"],[350,"أراني عنك محدود","https://www.aldiwan.net/poem15634.html","الهزج"],[365,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[365,"أيا أهدى من الشهب السواري","https://www.aldiwan.net/poem60892.html","السريع"],[372,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[392,"كلام الناس ما له راس فاترك","https://www.aldiwan.net/poem54556.html","عموديه"],[401,"إيقاعات على نيل مصر","https://www.aldiwan.net/poem6726.html","عموديه"],[404,"أبثك أني ما وجدت مشقة","https://www.aldiwan.net/poem33357.html","الطويل"],[404,"علام يلام القلب إن ظل حيرانا","https://www.aldiwan.net/poem33375.html","الطويل"],[404,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[417,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[417,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[440,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[442,"قفوا أيها الركبان نودعكم منا","https://www.aldiwan.net/poem14339.html","الطويل"],[459,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[459,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[465,"تأملت تصنيف هذا السعيد","https://www.aldiwan.net/poem3565.html","عموديه"],[478,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[501,"أصاحب بيتي إن في مسدل الخفا","https://www.aldiwan.net/poem38001.html","الطويل"],[506,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[516,"أيا مالكاً تسمو به رتب العلى","https://www.aldiwan.net/poem12021.html","الطويل"],[541,"خطبت إلى كعب فردوك صاغرا","https://www.aldiwan.net/poem56808.html","الطويل"],[554,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[559,"صريح كلامي في الوجود وإيمائي","https://www.aldiwan.net/poem35088.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وفيَّ عُرَيْقٌ منْ قُرَيشٍ تعطَّفَتْ","عليّ بهِ أعياصُها والعَنابِسُ",0,"س",1,0],["وَفى عُروَةَ العُذريِّ إِن مِتُّ أُسوَةٌ","وَعَمروِ بنِ عَجلانَ الَّذي قَتَلَت هِندُ",1,"د",1,1],["وفي عَلْياكَ لي كنْزُ اعْتِقادٍ","علَى أمْثالِهِ تُطْوَى الضُّلوعُ",2,"ع",1,0],["وفي عالَمِ الحِسِّ اغْتَدَيْتَ مُبَوّأ","لتَشْفي مَنِ اسْتَشْفى وتَهْدي منِ اسْتَهْدى",3,"د",2,0],["وَفي عالَمِ الإِسلامِ في كُلِّ بُقعَةٍ","لَهُ أَثَرٌ باقٍ وَذِكرٌ مُعَطَّرُ",4,"ر",1,0],["وَفِي عَيْنَيْكِ سِحْرٌ بَابِلِيٌّ","فَلا يُدْرَى أَمَاءٌ أَمْ ضِرَامُ",5,"م",1,0],["وفي عنان السماء قد طلعت","أهِلّة في إزائها صُلُب",6,"ب",1,0],["وَفي عِضادَتِهِ اليُمنى بَنو أَسَدٍ","وَالأَجرَبانِ بَنو عَبسٍ وَذُبيانُ",7,"ن",1,1],["وفي عضدي بدر الجمال موسدٌ","وقد قدِحت للرَّاح في خدهِ زندُ",8,"د",1,0],["وفي عَماها لها شغلٌ وإن طمحتْ","في الجو حتى تُرَى فوقَ المراعيش",9,"ش",1,0],["وفي عرضها بالشبر وقفاً وطولها","بخمسة أشبار بشبر مفرَّقِ",10,"ق",1,0],["وَفى عَلَيها وَهيَ تَش","طُرُ كَالفَراشَةِ فَاِشتَهاها",11,"ا",3,0],["وفي عياض عن كل هذا","ردوا شبابي ردوا شبابي",12,"ب",2,0],["وَفي عَفوِهِ لَو تَعلَمونَ عُقوبَةٌ","تُقَعقِعُ في الأَعراضِ إِن لَم يُعاقِبِ",13,"ب",1,0],["وَفى عَليٌّ بِمَواعيدِهِ","وَلَم يُنَقِّصها بِإِخداجِ",14,"ج",1,0],["وَفي عَينَيكَ تَرجَمَةٌ أَراها","تَدُلُّ عَلى الضَغائِنِ وَالحُقودِ",15,"د",1,0],["وفي عينيك تقتيلُ","وفي البسمات غفرانُ",16,"ن",1,0],["وفَّى عُلومَ الأوّلين حُقوقَها","والآخِرِينَ وَفاءَ مَنْ لم يَجْحَدِ",17,"د",1,0],["وَفي عَينَيكَ ما أَبلَ","غَ في قَتلِيَ يا جاني",18,"ن",2,0],["وفي عينيكَ أسرارٌ حيارى","تُكذِّبُ ما تحاول أن تقولَهْ",19,"ل",2,0],["وَفِي عَوَالِمِ أَفْلاَكٍ تُحِيطُ بِنَا","مَا بَيْنَ مُحْتَجِبٍ مِنْهَا وَمَرْصُودِ",20,"د",1,0],["وَفِي عِنَايَاتِ خَيْرِ أُمٍّ","يَصْدِرُ عَنْ رَأْيِهَا الرَّشِيدِ",21,"د",1,0],["وَفي عَبدِ الغَنيِّ اِبني","عَصيتُ الصَبرَ حينَ نَهى",22,"ن",3,0],["وفي عصبيَّاتٍ غِلاظٍ تسامُحاً","وفي مُلْتوٍ مِنْ نهجها منهجاً لحَبا",23,"ب",2,0],["وفي عطف يثير هوى ملحّا","إذا رفّت عليه ذوءابتاها",24,"ا",3,0],["وَفِي عَطْفِهَا المُضْنَى وَفِي رِدْفِهَا العَبْلِ","وُتُخْلُقُ زُوراً فِي المَحَاجِرِ أَدْمُعَا",25,"ع",2,0],["وفي عهد بقلبي ذكره ابدا","يجرى وفي طي روحي والضمير وفي",26,"ف",2,0],["وفي عسكر الليل البهيم أباده","فجوعه جاهاً وأشبعه فقرا",27,"ر",2,0],["وفي عامِ سبعٍ بعدها مائةٌ","خَلَتْ وألف نظامى عندهن سلام",28,"م",1,0],["وفي عامِ ألفٍ معْ ثمان تمامُها","كذَا مائةٌ في عدِّ كلِّ مُؤَمِّلِ",29,"ل",1,0],["وفي عدن قامت عليهم قيامة","وقد ركبوا في قصدها الركب الصعبا",30,"ب",2,0],["وَفِيَّ عَلى عَضِّ اللَيالي بَقِيَّةٌ","وَإِن قُطِعَت مِن راحَتَيّ الأَنامِلُ",31,"ل",1,0],["وَفِيَّ عَلى حَزِّ المدى خُنزُوَانَةٌ","وَلَو أَفنَتِ الأَحداثُ حالِي وَماليا",32,"ي",2,0],["وفي عمّون طَيْرُ الحُبِّ يَشْدو","مواويلا يُردِّدُها التّصابي",33,"ب",2,0],["وفي عَذَباتِ الرملِ دون هِرَقْلَةٍ","مَسارحُ نسعى بينها ومَراتع",34,"ع",1,0],["وفي عشر واربع قد وصلنا","إلى جدة بلاد المسلمينا",35,"ن",2,0],["وفي عشر لقعدة مع ثمان","وصلنا مكّة مستبشرينا",35,"ن",2,0],["وفي عرفات جمعاً قد وقفنا","فكم فيها دموعاً مسبلينا",35,"ن",2,0],["وَفي عَينَيكِ يَستَهوي عَفافٌ","لهُ في النَفسِ جاذِبُهُ الخفيُّ",36,"ي",1,0],["وَفي عُيونِيَ مرآةً أَراكِ بها","وَفي فُؤاديَ مُؤاساةً لآلامي",37,"ي",1,0],["وَفي عَقِداتِ الرَملِ ظَبيٌ كِناسُهُ","صُدورُ العَوالي شُرَّعاً وَالصَوارِمِ",38,"م",1,0],["وَفِي عِلْمِ الْمَنَائِرِ كُلَّ وَقْتٍ","نَهَارِيٍّ تَحِينُ بِهِ الصَّلاَةُ",39,"ه",1,0],["وفي عدلك الشرع الشريف ممثل","وفي حكمك الأمثال تتلى وتضرب",40,"ب",1,0],["وفي علمِ العَرُوض دخلتُ جَهلا","وعُمتُ بخفَّتي في كلِّ بَحرٍ",41,"ر",1,0],["وفي عرفات الجمع عرفان فرقةٍ","ونيل المنا بعد الدنوّ لزلفة",42,"ه",1,0],["وفي عصره يستيقظ العدل في الورى","كما نام في أيّامنا نومة الفهد",43,"د",1,0],["وفي عين الحقيقة لو ترآى","رأيت مجاز نيّته مغاير",44,"ر",1,0],["وفي عَينَيك أنوارٌ تُريني","عفافاً يَكتُم السرَّ الدَّفينا",45,"ن",2,0],["وَفي عواجة نار بت أَرقبها","كانها نار موسى لَيلَة الجبل",46,"ل",1,0],["وَفي عَينِ حورٍ حورُ عينٍ فَواتِكُ ال","لِحاظِ فِصاحُ اللَّفظِ خرسُ الخَلاخِلِ",47,"ل",1,0],["وفي عواقبه الخيرات والإحسان","فارم العواقب وادخل روضة الفكر",48,"ر",1,0],["وفي عرفات كل ذنبٍ مكفَّرٍ","ومغتفرٍ منا برحمة غافر",49,"ر",1,0],["وفي عصيانه عار ونار","وفيها البعد مع خزي وبيل",50,"ل",1,0],["وفي عرفات والمشاعر كلها","وخيف مني والهدى والرمى للأفلا",51,"ل",2,0],["وفي عالم الفكر أمثالها","تطوّق أفكاري الراجفه",52,"ه",1,0],["وَفي عَرَفاتِ الوَصلِ عَرَّفَني الهَوى","مَقامَ اِزدِلافي في الغَرامِ بِزُلفَتي",53,"ي",1,0],["وَفي عِظامِ الناسِ لي نَشأَةٌ","سَيّارَةٌ مَسكَنُها المُخُّ",54,"خ",1,0],["وَفي عَرشِكَ لي فَرشٌ","وَفَوقَ الفَرضِ تَوسيدُ",55,"د",1,0],["وفي عَذَبِ الأفنانِ من كُلِّ أيكةٍ","كَرائنُ للألحانِ يَغدونَ صُوَّغا",56,"غ",2,0],["وفي عزٍّ يَعِزُّ على المُعادِي","وفي طُولٍ يَطولُ على المُباري",57,"ر",2,0],["وفي عَزَماتي زنادُ النوى","ولكنَّها بعدُ لم تُقبَسِ",58,"س",1,0],["وفي عدم السلوك له عذاب","ونار لا يقاس لها بمقياس",59,"س",1,0],["وفي عين جالوتَ أعجوبةٌ","من النَّصر تُرْوَى ولا تُغْفَلُ",60,"ل",1,0],["وفي عرفات هل أراني واقفاً","كذي صخرات فاز من كل مأواه",61,"ا",2,0],["وفي عرفات نالوا الشرف الذي","به أضحت الدنيا تزاحم كيوانا",62,"ن",2,0],["وفي علم المعاني كم حللنا","عن الأبكار معقود اللثام",63,"م",1,0],["وفي علم الأصول سبحت بحراً","وجاوزت الفصول إلى النظام",63,"م",1,0],["وفي عل