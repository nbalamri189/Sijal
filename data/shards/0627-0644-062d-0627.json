""],[5956,"تراث يصغي لغناء ابنه ويقول:","https://www.poetsgate.com/ViewPoem.aspx?id=205423",""],[5956,"إن المهيمن وحده هو قادر","https://www.poetsgate.com/ViewPoem.aspx?id=208056",""],[5961,"والله اليوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=199808",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6056,"بالخير متبرّع","https://www.poetsgate.com/ViewPoem.aspx?id=156715",""],[6069,"يا شاعراً أودعت أنامله","https://www.poetsgate.com/ViewPoem.aspx?id=105720",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[5724,"ثوروا على الباغي الذليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55147&r=&rc=14",""],[6242,"شمس الأوطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87570&r=&rc=17",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""]],"verses":[["الحامِلُ العِبءِ الَّذي","أَعيا المَصاعِبَ وَالقُروما",0,"م",2,0],["الحاكمون و»واشنطن« حكومتهم","واللامعون.. وما شعّوا ولا غربوا",1,"ب",3,0],["الحابِسينَ أَوانَ الخِصبِ كَلبَهُم","وَالمَوقِدي النارِ بَينَ السَجفِ وَالنَضَدِ",2,"د",1,0],["الحامِلُ الثِقَلَ المُهِمُّ","مِنَ المُلِمّاتِ الفَوادِح",3,"ح",1,0],["ألحاظها بالسحر آمرةٌ","وحياؤها ناهٍ من السحر",4,"ر",1,0],["الحَازِمُ العَازِمُ المَرْهُوبُ جَانِبُهُ","وَالمَانِحُ الصَّافِحُ المَحْبُوثُ فِي آنِ",5,"ن",1,0],["أَلحَازِمُ العَازِمُ المَرْهُوبُ جَانِبُهُ","وَالمَانِحُ الصَّافِحُ المَحْبُوبُ فِي آنِ",6,"ن",1,0],["الحارِبِ الجابِرِ الحَريبَ إِذا","جاءَ نَكيباً وَإِن يَعُد يَعُدِ",7,"د",1,0],["الحَازِمُ الرَأي والمَيمُونُ طَائِرُهُ","والمُستَضَاءُ بِهِ والصَّادِقُ القِيلُ",8,"ل",1,0],["الحافظينَ ممالكاً وشرائِعاً","والشارعين مهابةً ومواهِبا",9,"ب",2,0],["الحارس الملك باليراعة لا","يحتاج نضو سيوف حرَّاس",10,"س",1,0],["ألحاظك النبل في أهلِ الغرام كما","مالُ ابن يعقوب في أهلِ الرجا درقه",11,"ق",2,0],["الحارسي الدينَ لا يلهو نهارُهُمُ","عنه ولا ليلُهم بالنائم الرّقِبِ",12,"ب",1,0],["الحافظي المُلكَ والحامينَ حَوْزَتَه","من الأعادي ذوي الأضغان والكَلَبِ",12,"ب",1,0],["الحالبي لَقَحَاتِ الفيء حافلةً","بِالرفق واليمن منهم ثَرَّةَ الحَلَبِ",12,"ب",1,0],["الحازمُ الصارِمُ الشباةِ على","ما فيه من جفوة ومن أَرثِ",13,"ث",1,0],["ألحاظه فَضْل وألفاظه","فصل وإن هُزَّ فسيفٌ هُذاذْ",14,"ذ",1,0],["ألحاظُهُ لا تراعيني ونائلُهُ","لا في التفاريق تأتيني ولا الجُملِ",15,"ل",1,0],["ألحاظُ برقٍ إذا لاحتْ مُهَجَّرةً","واستوقدتْ من أوار الشمس حران",16,"ن",1,0],["الحالُ مُرهقةٌ والنفسُ مُشفِقَةٌ","من دائها المتمادي أو تُداويه",17,"ي",2,0],["الحاسِراتُ عَنِ السَوا","عِد وَالتَرائِب وَالنبُحورِ",18,"ر",1,0],["الحالِبينَ البُدنَ مِن أَوداجِها","وَالموقِدينَ لَها القَنا المُتَقَصِّدا",19,"د",2,0],["الحاجِبُ الأَعلى العضدْ","قرةُ عين المعتمدْ",20,"د",1,0],["ألحان كل جماعة وغناؤهم","لغة ونجوى بينهم وحِوار",21,"ر",1,0],["ألحان بلبه غدت","ممزوجة في صوت جابر",22,"ر",1,0],["الحاكيات عليه أندلس الهوى","عربا لنا طورا وحينا روما",23,"م",2,0],["الحامِلو الفُصحى وَنورِ بَيانِها","يَبنونَ فيهِ حَضارَةَ الإِسلامِ",24,"م",1,0],["الحامِلاتُ لِواءَ الحُسنِ مُختَلِفاً","أَشكالُهُ وَهوَ فَردٌ غَيرُ مُنقَسِمِ",25,"م",1,0],["الحالُ باقِيَةٌ كَما صَوَّرتَها","مِن عَهدِ آدَمَ ما بِها تَغييرُ",26,"ر",1,0],["الحازِمَ اليَقِظَ الأَغَرَّ العالِمَ ال","فَطِنَ الأَلَدَّ الأَريَحِيَّ الأَروَعا",27,"ع",2,0],["الحامِلُ الثِقلَ قَد أَعياهُ حامِلُهُ","وَالموقِدُ النارَ لِلمُستَنبِحِ الساري",28,"ر",2,0],["ألحاظُه تُخْبِرُ عن عُرامِه","يَشُبُّ ما حُرِّكَ من زِمامِه",29,"م",2,0],["الحاكِمُ الحَكَمُ الَّذي شَهِدَت لَهُ","أَعداؤُهُ بِالعَدلِ وَالإِنصافِ",30,"ف",1,0],["الحامِلينَ مِنَ الخَطِّيِّ أَطوَلَهُ","وَالناقِلينَ مِنَ الأَسيافِ ما قَصُرا",31,"ر",2,0],["أَلحاظُهُ في الخَلقِ مُسرِعَةٌ","فيما يُريدُ كَسُرعَةِ النَبلِ",32,"ل",1,0],["الحائكُ الأمردُ أجفانُهُ","تنصرُ وجدي وهْيَ مكسورَهْ",33,"ه",1,1],["الحَامِلِينَ مِنَ الأَمَانَةِ ثِقْلَهَا","لا مُصْعِرِينَ ولا أَصَاغِرَ مِيلا",34,"ل",2,0],["أَلحَّ الأُسْرُبُ المسمومُ يَفْري","جَماجِمَهم فخرُّوا هامدينا",35,"ن",2,0],["الحافِظينَ عَلى الخِلافَةِ عِزَّها","الناصِرينَ خَليفَةَ الرَحمَنِ",36,"ن",1,0],["الحافِظينَ المُلكَ بِالبَأسِ الَّذي","هَدَّ المُلوكُ وَزَلزَلَ الأَقيالا",37,"ل",2,0],["الحائِماتِ مَعَ النُسورِ جَوارِحاً","العادِياتِ عَلى الأُسودِ ضَوارِيا",38,"ي",2,0],["ألحَّ النِّساءُ على حَلْيهِنّ","وأقبلنَ في ضَجّةٍ يا لها",39,"ل",3,0],["أَلحاظُ عيني تَلْتهي","في رَوضِ وردٍ يَزْدَهي",40,"ه",2,1],["ألحاظُه في الحبِّ قد هَتكتْ","مكتومَهُ والحبُّ لا يُكتَمْ",41,"م",1,0],["الحاضِنِ الإسلامَ يجعلُ صَدرَهُ","كَهفاً يقيهِ أذَى العَدُوِّ المُفسِدِ",42,"د",1,0],["الحازمون رأوا في السعي مسعدة","فَلَم يكونوا من الأعمال في ضجر",43,"ر",1,0],["ألحان أغنيةٍ أمسى يُرتّلها","كمرسلٍ من نشيد الخلدِ سيّال",44,"ل",1,0],["ألحارسُ السهران","قد فتّح البُرجا",45,"ج",2,0],["ألحانيين على قلبي ولوعته","يبدّدان من الأحزان ما احتشدا",46,"د",2,0],["ألحامل الغار أمجادا منضّرة","والمدرك الثأر لا زورا ولا فندا",46,"د",2,0],["ألحانيات على تلك القبور معي","ونبّه الفجر طيرا غافيا فشدا",46,"د",2,0],["أَلحَاكِمَاتُ المُحْكَمَاتُ فَمَا","يَبْرَحْنَ أَقْوَى وَسَائِلِ القَدَرِ",47,"ر",1,0],["الحَازِمُ المَرْمُوقُ مَنْزِلَهْ","فِي الْقَوْمِ يَسْبِقُهُمْ وَيَقْفُوكَا",48,"ك",2,0],["ألحَامِلِينَ خِفَافاً","عِبْءَ الوَفَاءِ الثَّقِيلِ",49,"ل",1,0],["أَلْحَازِمُ الْعَفُّ الَّذِي يَدُه","وَلِسَانُهُ وَجَنَانُهُ طُهُرُ",50,"ر",1,0],["أَلْحَاظُهَا بِالسِّحرِ آمِرَةٌ","وَحَيَاؤُهَا نَاهٍ عَنِ السِّحْرِ",51,"ر",1,0],["الحَازِمُ الصَّارِمُ غَيْرُ بَاخِلٍ","بِحَسَنَاتِ قَلْبِهِ الشَّفِيقِ",52,"ق",1,0],["أَلحَارِثِ الدَّرِبِ العَكُوفِ عَلَى الثَّرَى","أَلكَادِحِ التَّعِبِ الصَّبُورِ القَانِعِ",53,"ع",1,0],["الحاملين الشمس فوق وجوههم","والحاملين الشهب في الأغماد",54,"د",1,0],["الحاملين على العدا","مثلَ السيول أو الأعاصر",55,"ر",1,0],["الحاملِينَ مِنَ الفوادحِ ثِقْلَها","ليسوا بأنكاسٍ ولا أغمار",56,"ر",1,0],["الحاسِرونَ كنب