{"poems":[[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[545,"يا أثل لا غيرا أعطى ولا قودا","https://www.aldiwan.net/poem56658.html","البسيط"],[567,"عنوان كل مديح راسخ القدم","https://www.aldiwan.net/poem52884.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53954","الخفيف"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129521","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109996","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85213","البسيط"],[5368,"وجع الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=183851",""]],"verses":[["يا أَثلَ كابَةَ لا حُرِمتِ ثَرى النَدى","هَل رامَ بَعدي ساجِرٌ فَالأَجرَعُ",0,"ع",1,0],["يا أَثلُ لا غِيَراً أُعطى وَلا قوداً","عَلامَ أَو فيمَ إِسرافاً هَرَقتُ دَمي",1,"م",2,1],["يا أثبتَ النَّاسِ في قولٍ وفي عَمَلٍ","على التَمادِي وأوفَى الناسِ بالذِمَمِ",2,"م",1,0],["يَا أثِيراً لَدَى الأنَامِ مَكِينَا","زادَكَ اللَّهُ فِي العُلَى تَمْكِينَا",3,"ن",2,1],["يا أثيلات مسرح أقبل الأد","بار فيه وأدبر الأقبال",4,"ل",1,0],["يا آثمينَ ثِقُوا بمريمَ انها","غوثُ البريَّةِ فاقصِدوها واكتَفُوا",5,"ف",3,0],["يا أثراً لاح من فوق وجنته","لأنت أحسن من خال نجاشيّ",6,"ي",1,0],["يا أَثْقَلَ الأَحْزانِ من وَجَعٍ","والدَّمعُ في عَيْنِي يُجَسِّدُهُ",7,"د",2,0]]}