"","https://poetry.dctabudhabi.ae/diwan/poem/73157","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28623","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58154","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58042","الطويل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119531","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72855","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136414",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136385",""],[4578,"لعارضي الشيب من هول النوى وخطا","https://www.poetsgate.com/ViewPoem.aspx?id=49461",""],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4935,"ألا يا نفس ما هذا التواني","https://www.poetsgate.com/ViewPoem.aspx?id=129284",""],[5431,"له...له...","https://www.poetsgate.com/ViewPoem.aspx?id=191170",""],[5431,"طبيب الفقراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=215177",""],[5582,"إِلَى التِّيهِ مالَتْ لَها أَنْ تَمِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=187262",""],[5694,"اخويي","https://www.poetsgate.com/ViewPoem.aspx?id=129913",""],[5701,"وعود الناس أجمع كاذبات","https://www.poetsgate.com/ViewPoem.aspx?id=164623",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[6093,"أحفورة","https://www.poetsgate.com/ViewPoem.aspx?id=197812",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""]],"verses":[["لَهُ سِبتَةٌ بَينَ لَهبَي صَفاً","يَقولونَ نامَ وَلَمّا يَنَم",0,"م",1,0],["لَهُ سابِقاتُ القَبلِ في كُلِّ أَوَّلٍ","مَضى وَبَقاءُ البُعدِ في كُلِّ آخِرِ",1,"ر",1,0],["لَهُ سَمحاءُ تَغدو كُلَّ يَومٍ","بِنائِلِهِ وَسارِيَةٌ تَطوفُ",2,"ف",1,0],["له سَلَف عزّوا فبزّوا نباهةً","ولم تعتَوِرهم فترة وخُمول",3,"ل",1,0],["لَهُ سُترتا بَسطٍ فَكَفٌّ بِهَذِهِ","يُكَفُّ وبِالأخرَى العَوَالِي تُخَضَّبُ",4,"ب",1,0],["له سيف لحظ أراق الدّماءَ","فحمرة خدَّيهِ من نضجه",5,"ه",1,0],["له سلاحٌ يَشيمُهُ أبداً","عمداً فيَمضي ولا يُرى نَدَبُهْ",6,"ب",2,0],["له سِيمِياءٌ بين عَيْنَيْ مُبَارَكٍ","إذا ما اجتلاها رَوْعُ ذي الروع أفْرَخَا",7,"خ",2,0],["له سَوْرَةٌ مكْتَنَّةٌ في سَكِينَةٍ","كما اكْتَنَّ في الغمْدِ الجُرازُ المهنَّدُ",8,"د",1,0],["له سَحيفٌ لدى مَزَاحِفه","يُجيبُ منه كَشيشَ كشّاش",9,"ش",1,0],["له سائسٌ أيِّرٌ","يجولُ على مَتنه",10,"ن",2,0],["له سَواقٍ طفحَتْ والتوَتْ","تلوّيَ الحيَّةِ مشجوجَهْ",11,"ج",2,0],["لَهُ سَلَفٌ مِن آلِ فَيروزَ بَرَّزوا","عَلى العُجمِ وَاِنقادَت لَهُم حَفلَةُ العُربِ",12,"ب",1,0],["لَهُ سُخطُكُم وَالأَمرُ مِن دونِهِ الرِضا","وَرَغبَتُكُم في فَقدِ هَذي الرَغائِبِ",13,"ب",1,0],["لَهُ سَطَواتٌ كُلَّ يَومٍ وَلَيلَةٍ","عَلى مُهَجِ الأَعداءِ لا تَستَقيلُها",14,"ل",3,0],["لَهُ سَلَفٌ مِن آلِ شوخى إِذا انتَموا","فَلا لِلذُرى يَوماً وَلا لِلكَواهِلِ",15,"ل",1,0],["لَهُ سِيرَةٌ في مُلكِهِ عُمَرِيَّةٌ","وكَفٌّ مِنَ الإِعدامِ جابِرَةُ الكَسرِ",16,"ر",1,0],["لَهُ سُورَةٌ لَوْ صَادَمَتْ رُكْنَ يَذْبُلٍ","وَرَضْوَى لَهَدَّتْ يَذْبُلاً وَمَحَتْ رَضْوَى",17,"و",2,0],["لَهُ سَلَفٌ في الأَعجَمَينِ كَأَنَّهُم","إِذا استُؤذِنوا يَومَ السَلامِ بُدورُ",18,"ر",1,0],["لَهُ سَجَدَ الشامِخُ المُشمَخِرُّ","علَى ما بِعرينِهِ مِن شَمَم",19,"م",1,0],["له سماء وفيها","عرش هناك مصون",20,"ن",1,0],["له سيرةٌ يتَحَدَّى الورودَ","شذاها، وما الناسُ إلا سيرَ",21,"ر",1,0],["له سيرة كعبير الزهورِ","لوَ أن الزهورَ رُزقنَ الخلودا",22,"د",2,0],["له سلاح إذا ما شقَّها انفتحت","فيها كنوزُ يواقيتٍ ومَرجان",23,"ن",1,0],["لَهُ سُخطُكُمْ، وَالأمرُ في دونهِ الرّضَا،","وَرَغْبَتُكُمْ في فَقْدِ هَذي الرّغائِبِ",24,"ب",1,0],["له سيرة الابرار لا متكبرا ً","ولا واهنا في العدل او متعللا",25,"ل",2,0],["لَهُ سودد حَلَّ السَماكين رفعَةً","وَذَلِكَ أَرث فيهِ عَن عَهد آدَمِ",26,"م",1,0],["لَهُ سورَةٌ أَعيا المُلوكَ اِدِّعاؤُها","وَسَورَةُ عِزٍّ دونَها سَورَةُ الأُسدِ",27,"د",1,0],["له سيفُ نصرٍ كلَّما هزَّ نصلَه","تَتَبَّع نابُ الموتِ أمرَ ذُبابه",28,"ب",2,0],["له سيفُ صبر مُغَمدٌ في قَناعةٍ","إذا ثار جيشٌ من مَطامعِه سَلا",29,"ل",2,0],["لَهُ سلّ مِن أفكارهِ خير صارمٍ","وَقبلَ ظُهورِ الفتكِ ولّى له الظهرا",30,"ر",2,0],["له سمر اقلام على الطرس ان جرت","جرى الجود منها منهلا وتسبّلا",31,"ل",2,0],["لَهُ سَماحٌ لا أَهلُ بادِيَةٍ","يُخطيهِمُ صَوبُهُ وَلا بَلَدُ",32,"د",1,0],["لَهُ سِجلانِ مِن جودٍ وَبأسٍ","وَفي أَخلاقِهِ شُهدٌّ وَصابُ",33,"ب",1,0],["لَهُ سَلَفٌ تَنِدُّ الوَحشُ عَنهُ","عَريضُ الجانِبَينِ لَهُ زُهاءُ",34,"ا",2,0],["له سير طابت وطاب رواتها","كما طاب نشراً من شذا المسك صاحقه",35,"ق",2,0],["له سيرة مرضية وَسَريرة","تضيء بنور السنة المتوقد",36,"د",1,0],["لَهُ سِيرٌ حَفْصِيَّةٌ ما اشْتمالُها","سِوى سِيراء المَدْحِ تُونَق بالحَمْدِ",37,"د",1,0],["له سائِلاً عِلْمٍ وجود يُجيب ذا","على عَجَل منه وذا عن تَثَبُّتِ",38,"ت",1,0],["له سعفٌ جَعدٌ وَليفٌ كأنَّهُ","حواشي بُرودٍ حاكَهُنَّ الصَوانِعُ",39,"ع",1,0],["لَه سهمُ رأيٍ ليسَ يملك ردّه","وصارمُ علمٍ لا يفلّ له شفرُ",40,"ر",1,0],["له سِهامٌ إذا ريشَتْ بأنمُلِه","أَصمَتْ عِداهُ فلا لاقَتْهُمُ مُرُطا",41,"ط",2,0],["له ساحةٌ لم يَنتَثِرْ حَبُّ مُزْنةٍ","كما تَتوالَى كُلَّ يومٍ وُفودها",42,"د",3,0],["له سطوات يُذبنَ الصَّفا","ويرهبها الأسدُ الباسل",43,"ل",1,0],["له سفنٌ ردَّت على الريح حُكمَها","فصارَت بما شاءَت وشاءَ لها تَجري",44,"ر",2,0],["لَهُ سَيف طَرف سحر أَلحاظِهِ لَهُ","فَرند تَكل المُرهَفات وَلا يَنبو",45,"ب",2,0],["له سيوفٌ حِدادٌ أَكْلُها أبداً","وشربُها مُهَجٌ مَفْريةٌ ودَمُ",46,"م",1,0],["له سعلات قبّح الله صوتها","بقيء وانخام يضاهي المرائرا",47,"ر",2,0],["له سُيوفٌ إذا ما النّصرُ أضحكَها","تَبكي الرِّقابُ وتَنعى نفسَها الظُّلَلُ",48,"ل",1,0],["له سطوة لا يأمن الدهر بأسها","وبطش إذا ما الحلم ضاق أليم",49,"م",1,0],["لَهُ سَطَواتٌ غِبُّها العَفوُ بَينَها","فَوائِدُ يُحصى قَبلَ إِحصائِها الرَملُ",50,"ل",1,0],["له سيجية حلم في خواطرنا","تنكيتها ان قرأنا والقلم",51,"م",1,0],["له سُبَحٌ من عنبرٍ فوق خدِّه","وتصحيفُها في عارضَيْ وجهه سُبَجْ",52,"ج",1,0],["له سبق في غايات مجد وسؤدد","وعلم وإنصاف وعفة صابر",53,"ر",1,0],["لَهُ سَلَفٌ أَوقَدُوا نارَهُم","فمِنها استَضا كُلُّ مَن أَوقَدا",54,"د",2,0],["لَهُ سيرة الفاروق وَالعادل الَّذي","بِمَنظومه أَثنى عَلَيهِ جَرير",55,"ر",1,0],["لَهُ سندٌ عالٍ بِمَدحك نيّرٌ","وبابك أَمسى مِنهُ أسنى وَأَسنَدا",56,"د",2,0],["لَهُ سِهامٌ مِن لِحاظٍ صُيَّبٍ","كَأَنَّما يَرمينَ عَن قَوسِ القَدَرْ",57,"ر",1,0],["لَهُ سُليمان الزّمان قَد بنى","وحبّذا البنايَةُ الفاخِرةُ",58,"ه",1,0],["لَهُ سُليمان الزّمانِ اِبتَنى","واللَّهُ في بُنيانِهِ كانَ المُعين",59,"ن",1,0],["لَهُ سُلَيمانُ بانٍ","أَدامَ ربّيَ نَصرَه",60,"ر",2,0],["له ُسُمرَةٌ كوجوهِ مَن عاشوا على","شطآنهِ حيثُ استقرَّ رِحَالُهُ",61,"ل",2,0],["له سؤدد لو كان للشهب لم تفق","شموس نهار أو نجوم غياهب",62,"ب",1,0],["له سطَوات تقِنصُ الأُسد مثلها","تعود لها الشمُّ العرانين رُغَّما",63,"م",2,0],["له سلف كنجوم السَّما","ووالده خلف المقتدي",64,"د",2,0],["لهُ سطوات تصيد الأسودَ","وأقدام عزم تُلين الصعابْ",65,"ب",1,0],["له ساقا ظليم خا","ضب فوجئ بالرّعب",66,"ب",1,0],["لَهُ سَابِقٌ فِي المَكْرُمَاتِ وَلاَحِقٌ","وَبَاطِنُ مَجْدٍ فِي المَعَالِي وَظَاهِرُ",67,"ر",1,0],["له سُلْطَانُهُ وَعَلَيَّ إثْمِي","مَعاذَ الله منْ سَفَه وَطَيْش",68,"ش",1,0],["له ساحلٌ قد جاوزَ الحدَّ طولُه","تُقصرُ عنه في السمو الشواهقُ",69,"ق",1,1],["له سر يضيء له نعوت الكرام","وحسن زهد في الحلال",70,"ل",1,0],["له سجاياً من أبيه حسُنت","وبسط كفٍّ في الندى ما انقبضا",71,"ض",2,0],["له سُنَّةٌ في الجدِّ والهزلِ مثلما","تُدارُ كؤوسٌ أو تُدَقُّ حراب",72,"ب",1,0],["له سيف غداة الحرب دام","وطرف خشية الجبار دامع",73,"ع",1,0],["لَهُ سُؤدَدُ البَطحاءِ غَيرَ مُدَافعٍ","وَحَومَةُ ما بَينَ الصَّفا وَالمُحَصَّب",74,"ب",1,0],["لَهُ سَبِيبٌ مُسبَلٌ خَلفَهُ","كَأَنَّهُ فَرعُ الفَتاةِ الرَداح",75,"ح",1,0],["لَهُ سَيفُ عَزمٍ إِن نَضاحده مَضى","يَفل حُسام الخَطب وَهُوَ رَسوب",76,"ب",1,0],["لَهُ سِيرَةٌ حَسناً فَحَدِّث وَلاَ تَخَف","وَلاَ سِيَّما لَيلُ الصَّفا حِينَ يَعرُجُ",77,"ج",1,0],["لهُ سَلِّم إذا ما رمْتَ تسلمْ","ولا تُصغِ إلى قيلٍ وقالِ",78,"ل",1,0],["له سورة في البشر تقرأ في العلى","وتثبت في صُحفِ العطاء وتكتبُ",79,"ب",1,1],["لَهُ سَطَواتٌ لَو تَنَحَّينَ مَرَّةً","عَلى يَذبُلٍ هَدَّت شِعافَ الشَناخِبِ",80,"ب",1,0],["لهُ سَرائِرُ لِلإِسلامُ أَضمَرَها","وَاللَهُ أَظهَرَها جَهراً بِتَوجيبِ",81,"ب",1,0],["لَهُ سَلَفٌ يَعلو المَنابِرَ ذِكرُهُم","وَيَنحَطُّ عَنهُ قَدرُ كُلِّ مُعَظَّمِ",82,"م",1,0],["له سبق العلياء في كل مشهد","وإن بعد السارين فيهن مضمارا",83,"ر",2,0],["له سانح السلطان في كلِّ وجهة","ومن دونه أنى توجه بارح",84,"ح",1,0],["له سيرة بين الملوك حميدة","بحكم العلا وهو العزيز المقرَّب",85,"ب",1,0],["له سيرة محمود وسريرة","وفي مثلها فليقتد الماجد الحر",86,"ر",1,0],["له سيف عزم بالردا بدد العدا","وكف عطاء بالسحاب غدا يزرى",87,"ر",2,0],["لَهُ سَجلانِ سَجلٌ مِن صَريحٍ","وَسَجلُ تَريكَةٍ بِعَتيقِ خَمرِ",88,"ر",1,0],["له سحنة تقذى العيون بقبحها","تلوح عليها ذلة وشحوب",89,"ب",1,0],["لَهُ سورَةٌ قَيسِيَّةٌ عَرَبِيَّةٌ","بِها ذادَ عَن دينِ الهُدى كُلّ جاهِلِ",90,"ل",1,0],["لَهُ سِربالُ جوّابٍ","غُبارُ الدّهرِ غشّاهُ",91,"ا",2,0],["له سوددٌ بالأصل والفضل والندى","وحلم وعلمٌ حبَّذاك الشمائل",92,"ل",1,0],["له سابحٌ لا تَلْحَقُ الريحُ عفَوهُ","ومِن قَصَبِ الخَطيِّ أسمرُ عَسّالُ",93,"ل",1,0],["لَه سَيف رَأي لِلمَشاكِل حاسِم","يَرى دونَهُ في الفِعلِ لاشكَّ مُرهَف",94,"ف",1,0],["له سطوة مرهوبة الكر في الوغى","تزلزل أقدام الرواسي وترجف",95,"ف",1,0],["لَهُ سَعيٌ بِها يَمشي فَتَهوي","ذَوائبُه فَتسحرنا بريّا",96,"ي",2,0],["لَهُ سَجايا كَنَشرِ الرَوضِ ذي الزَهَرِ","وَقَد تَوَشَّحَ بِالأَنهارِ وَالغُدُرِ",97,"ر",1,0],["له سَطَواتُ تملأُ الأرضَ هَيبةً","نكادُ لها صُمُّ الجبالِ تَذوب",98,"ب",1,0],["لَهُ سِمَةُ الشّيوخِ صَفاءَ شَيبٍ","وَفي خَطَراتِهِ نَزَقُ الشّبابِ",99,"ب",1,0],["له ساعد للسعد معه مساعدذ","وحال مع الاحوال ما صدّه ولم",100,"م",1,0],["لَهُ سِيَرٌ مِنَ العَدلِ اِستَفاضَت","عَلى قاصٍ وَدانٍ في المَزارِ",101,"ر",1,0],["له سطوة حجاج في الأرض كلها","تدينُ له أهل العراق وتسلم",102,"م",1,0],["لهُ سهامٌ من الآراء صائِبةٌ","يَرِيشهُنَّ ويبري في رضى الباري",103,"ر",2,0],["لهُ سهامُ أعيُنِ","غادرنَ قلبي هَدفا",104,"ف",2,0],["له سيفٌ لحظِ مُرهفٌ أنا ضامنٌ","لِمضربهِ أن لا يُقلَّ لهُ عَضبُ",105,"ب",1,0],["لَهُ سَيفٌ إِذا لاقى","مَناطَ قَلايد بتكا",106,"ك",2,0],["له سيفُ رأْي ما يُطِيقُ لقاءَهُ","ثمانون ألفاً من شجاعٍ مقدَّم",107,"م",1,0],["له سيرةٌ مرضيةٌ لا يعدُّها","لسانٌ وإن ينطق فما حصل العَشْرُ",108,"ر",1,0