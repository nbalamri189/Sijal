{"poems":[[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[54,"لقد رحل ابن موسى بالمعالي","https://www.aldiwan.net/poem27429.html","الوافر"],[88,"هو الليل يغريه الأسى فيطول","https://www.aldiwan.net/poem44837.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[72,"تأوب كالبدر في جنحه","https://www.aldiwan.net/poem18484.html","المتقارب"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"بدا الشيب في رأسي فجلى عمايتي","https://www.aldiwan.net/poem9435.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"إذا ابن خيار بدا","https://www.aldiwan.net/poem66505.html","مجزوء المتقارب"],[62,"وجنة بالطيب موصوفة","https://www.aldiwan.net/poem52464.html","الطويل"],[45,"رأى البرق مجتازا فبات بلا لب","https://www.aldiwan.net/poem10651.html","الطويل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[48,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[46,"إذا مدحوا آدميا مدح","https://www.aldiwan.net/poem23438.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"المحراث","https://www.poetsgate.com/ViewPoem.aspx?id=179461",""],[45,"هَبيهِ لمُنْهَلّ الدّموعِ السّوَاكِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31699",""],[109,"فدا لك روحي من رشا متبرم","https://www.aldiwan.net/poem16245.html","الطويل"],[143,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[185,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[185,"إذا شرفت نفس الفتى عافت الذلا","https://www.aldiwan.net/poem14631.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[210,"قدوم أتى باليسر والسعد مقبلا","https://www.aldiwan.net/poem13308.html","الطويل"],[235,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[235,"أيطمع أن يساجلك السحاب","https://www.aldiwan.net/poem32176.html","الوافر"],[249,"تعنى القلب من سلمى عناء","https://www.aldiwan.net/poem2133.html","الوافر"],[261,"لهذا بجود الغيث ما لاح بارقه","https://www.aldiwan.net/poem38147.html","الطويل"],[271,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[275,"تخيرت مختار الخليفة للعهد","https://www.aldiwan.net/poem25584.html","الطويل"],[279,"لا تلوموا عليه قلب محب","https://www.aldiwan.net/poem2643.html","الخفيف"],[295,"أذلك أم ضرس من النخل مترع","https://www.aldiwan.net/poem1133.html",""],[305,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[364,"دم للعلا في ظلال العز مغتبطا","https://www.aldiwan.net/poem60854.html","البسيط"],[364,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[369,"رعى الله عيشاً نعمنا به","https://www.aldiwan.net/poem4289.html","المتقارب"],[371,"فشرقت أبغي مطلع الشمس بالغنى","https://www.aldiwan.net/poem57457.html","الطويل"],[380,"جوانحه جمر ومدمعه سكب","https://www.aldiwan.net/poem48813.html","الطويل"],[402,"عيد ثغور الأماني فيه تبتسم","https://www.aldiwan.net/poem46932.html","البسيط"],[463,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[514,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[515,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[553,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[575,"بحقك حدث عن هواي ولا حرج","https://www.aldiwan.net/poem2976.html","الطويل"],[587,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["لَهُ سِبتَةٌ بَينَ لَهبَي صَفاً","يَقولونَ نامَ وَلَمّا يَنَم",0,"م",1,0],["لَهُ سابِقاتُ القَبلِ في كُلِّ أَوَّلٍ","مَضى وَبَقاءُ البُعدِ في كُلِّ آخِرِ",1,"ر",1,0],["لَهُ سَمحاءُ تَغدو كُلَّ يَومٍ","بِنائِلِهِ وَسارِيَةٌ تَطوفُ",2,"ف",1,0],["له سَلَف عزّوا فبزّوا نباهةً","ولم تعتَوِرهم فترة وخُمول",3,"ل",1,0],["لَهُ سُترتا بَسطٍ فَكَفٌّ بِهَذِهِ","يُكَفُّ وبِالأخرَى العَوَالِي تُخَضَّبُ",4,"ب",1,0],["له سيف لحظ أراق الدّماءَ","فحمرة خدَّيهِ من نضجه",5,"ه",1,0],["له سلاحٌ يَشيمُهُ أبداً","عمداً فيَمضي ولا يُرى نَدَبُهْ",6,"ب",2,0],["له سِيمِياءٌ بين عَيْنَيْ مُبَارَكٍ","إذا ما اجتلاها رَوْعُ ذي الروع أفْرَخَا",7,"خ",2,0],["له سَوْرَةٌ مكْتَنَّةٌ في سَكِينَةٍ","كما اكْتَنَّ في الغمْدِ الجُرازُ المهنَّدُ",8,"د",1,0],["له سَحيفٌ لدى مَزَاحِفه","يُجيبُ منه كَشيشَ كشّاش",9,"ش",1,0],["له سائسٌ أيِّرٌ","يجولُ على مَتنه",10,"ن",2,0],["له سَواقٍ طفحَتْ والتوَتْ","تلوّيَ الحيَّةِ مشجوجَهْ",11,"ج",2,0],["لَهُ سَلَفٌ مِن آلِ فَيروزَ بَرَّزوا","عَلى العُجمِ وَاِنقادَت لَهُم حَفلَةُ العُربِ",12,"ب",1,0],["لَهُ سُخطُكُم وَالأَمرُ مِن دونِهِ الرِضا","وَرَغبَتُكُم في فَقدِ هَذي الرَغائِبِ",13,"ب",1,0],["لَهُ سَطَواتٌ كُلَّ يَومٍ وَلَيلَةٍ","عَلى مُهَجِ الأَعداءِ لا تَستَقيلُها",14,"ل",3,0],["لَهُ سَلَفٌ مِن آلِ شوخى إِذا انتَموا","فَلا لِلذُرى يَوماً وَلا لِلكَواهِلِ",15,"ل",1,0],["لَهُ سِيرَةٌ في مُلكِهِ عُمَرِيَّةٌ","وكَفٌّ مِنَ الإِعدامِ جابِرَةُ الكَسرِ",16,"ر",1,0],["لَهُ سُورَةٌ لَوْ صَادَمَتْ رُكْنَ يَذْبُلٍ","وَرَضْوَى لَهَدَّتْ يَذْبُلاً وَمَحَتْ رَضْوَى",17,"و",2,0],["لَهُ سَلَفٌ في الأَعجَمَينِ كَأَنَّهُم","إِذا استُؤذِنوا يَومَ السَلامِ بُدورُ",18,"ر",1,0],["لَهُ سَجَدَ الشامِخُ المُشمَخِرُّ","علَى ما بِعرينِهِ مِن شَمَم",19,"م",1,0],["له سماء وفيها","عرش هناك مصون",20,"ن",1,0],["له سيرةٌ يتَحَدَّى الورودَ","شذاها، وما الناسُ إلا سيرَ",21,"ر",1,0],["له سيرة كعبير الزهورِ","لوَ أن الزهورَ رُزقنَ الخلودا",22,"د",2,0],["له سلاح إذا ما شقَّها انفتحت","فيها كنوزُ يواقيتٍ ومَرجان",23,"ن",1,0],["لَهُ سُخطُكُمْ، وَالأمرُ في دونهِ الرّضَا،","وَرَغْبَتُكُمْ في فَقْدِ هَذي الرّغائِبِ",24,"ب",1,0],["لَهُ سودد حَلَّ السَماكين رفعَةً","وَذَلِكَ أَرث فيهِ عَن عَهد آدَمِ",25,"م",1,0],["لَهُ سورَةٌ أَعيا المُلوكَ اِدِّعاؤُها","وَسَورَةُ عِزٍّ دونَها سَورَةُ الأُسدِ",26,"د",1,0],["له سيفُ نصرٍ كلَّما هزَّ نصلَه","تَتَبَّع نابُ الموتِ أمرَ ذُبابه",27,"ب",2,0],["له سيفُ صبر مُغَمدٌ في قَناعةٍ","إذا ثار جيشٌ من مَطامعِه سَلا",28,"ل",2,0],["لَهُ سلّ مِن أفكارهِ خير صارمٍ","وَقبلَ ظُهورِ الفتكِ ولّى له الظهرا",29,"ر",2,0],["له سمر اقلام على الطرس ان جرت","جرى الجود منها منهلا وتسبّلا",30,"ل",2,0],["لَهُ سَماحٌ لا أَهلُ بادِيَةٍ","يُخطيهِمُ صَوبُهُ وَلا بَلَدُ",31,"د",1,0],["لَهُ سِجلانِ مِن جودٍ وَبأسٍ","وَفي أَخلاقِهِ شُهدٌّ وَصابُ",32,"ب",1,0],["لَهُ سَلَفٌ تَنِدُّ الوَحشُ عَنهُ","عَريضُ الجانِبَينِ لَهُ زُهاءُ",33,"ا",2,0],["له سير طابت وطاب رواتها","كما طاب نشراً من شذا المسك صاحقه",34,"ق",2,0],["له سيرة مرضية وَسَريرة","تضيء بنور السنة المتوقد",35,"د",1,0],["لَهُ سِيرٌ حَفْصِيَّةٌ ما اشْتمالُها","سِوى سِيراء المَدْحِ تُونَق بالحَمْدِ",36,"د",1,0],["له سائِلاً عِلْمٍ وجود يُجيب ذا","على عَجَل منه وذا عن تَثَبُّتِ",37,"ت",1,0],["له سعفٌ جَعدٌ وَليفٌ كأنَّهُ","حواشي بُرودٍ حاكَهُنَّ الصَوانِعُ",38,"ع",1,0],["لَه سهمُ رأيٍ ليسَ يملك ردّه","وصارمُ علمٍ لا يفلّ له شفرُ",39,"ر",1,0],["له سِهامٌ إذا ريشَتْ بأنمُلِه","أَصمَتْ عِداهُ فلا لاقَتْهُمُ مُرُطا",40,"ط",2,0],["له ساحةٌ لم يَنتَثِرْ حَبُّ مُزْنةٍ","كما تَتوالَى كُلَّ يومٍ وُفودها",41,"د",3,0],["له سطوات يُذبنَ الصَّفا","ويرهبها الأسدُ الباسل",42,"ل",1,0],["له سفنٌ ردَّت على الريح حُكمَها","فصارَت بما شاءَت وشاءَ لها تَجري",43,"ر",2,0],["لَهُ سَيف طَرف سحر أَلحاظِهِ لَهُ","فَرند تَكل المُرهَفات وَلا يَنبو",44,"ب",2,0],["له سيوفٌ حِدادٌ أَكْلُها أبداً","وشربُها مُهَجٌ مَفْريةٌ ودَمُ",45,"م",1,0],["له سعلات قبّح الله صوتها","بقيء وانخام يضاهي المرائرا",46,"ر",2,0],["له سُيوفٌ إذا ما النّصرُ أضحكَها","تَبكي الرِّقابُ وتَنعى نفسَها الظُّلَلُ",47,"ل",1,0],["له سطوة لا يأمن الدهر بأسها","وبطش إذا ما الحلم ضاق أليم",48,"م",1,0],["لَهُ سَطَواتٌ غِبُّها العَفوُ بَينَها","فَوائِدُ يُحصى قَبلَ إِحصائِها الرَملُ",49,"ل",1,0],["له سيجية حلم في خواطرنا","تنكيتها ان قرأنا والقلم",50,"م",1,0],["له سُبَحٌ من عنبرٍ فوق خدِّه","وتصحيفُها في عارضَيْ وجهه سُبَجْ",51,"ج",1,0],["له سبق في غايات مجد وسؤدد","وعلم وإنصاف وعفة صابر",52,"ر",1,0]]}