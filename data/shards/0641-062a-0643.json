093,"مبتدا وخبر(مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=178393",""],[6102,"فَ.......","https://www.poetsgate.com/ViewPoem.aspx?id=184545",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6147,"إبحار في متاهات أنفاسها","https://www.poetsgate.com/ViewPoem.aspx?id=151482",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[520,"ليست صفات علاك مما يمترى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577514",""],[6225,"استمالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81726&r=&rc=437",""],[6225,"النصف الأقوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81093&r=&rc=287",""],[6344,"رجع من شفة الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87978&r=&rc=18",""]],"verses":[["فَتَكونَ أَوَّلَ زَلَّةٍ سَبَقَت","مِنّي وَآخِرَها إِلى الأَبَدِ",0,"د",1,0],["فَتَكَنَّفوا الشورى عَلى اِستِقلالِكُم","في الرَأيِ لا توحيهِ نَزعَةُ واحي",1,"ح",2,0],["فَتَكَلَّمَت تِلكَ الطُلولُ وَأَفصَحَت","لَمّا وَقَفتَ مُسائِلاً عَن شانِهِ",2,"ن",2,0],["فَتَكَشَّفَتْ فِيهَا خَفِيَّاتُ المُنَى","وَتَسَاجَلَتْ فِيهَا قُوَى الأَفْهَامِ",3,"م",1,0],["فَتَكادُ مِن عِرفانِ ما قَد عُوِّدَت","مِن ذاكَ أَن يُفصِحنَ بِالتَرحابِ",4,"ب",1,0],["فتكونَ ثَمَّ نصيرَهُ وظهيرَهُ","وخصيم عَائِب شِعْرِهِ ومُجِيبَهُ",5,"ب",2,0],["فتكونَ الذي تَنصَّل بالمُنْ","صُلِ من ضربةٍ بصَفْح القِرابِ",6,"ب",1,0],["فتكت به الأيام وهي عليمة","أن سوف تتلف منه ما لا تخلف",7,"ف",1,0],["فتكونون للوجوه أنوفاً","وتكونون للرؤوس فروقا",8,"ق",2,0],["فتكتسيهنّ ماجداً عِطر ال","طِينةِ لا يشتكينَ من درنِك",9,"ك",1,0],["فتكيده كيدَ المعاتِب مُحرِزاً","أجرَ المُقيلِ وأنتَ غيرُ غبين",10,"ن",1,0],["فَتَكَت مُقلَتاهُ بِالقَلب مِنّي","وَبَكَت مُقلَتايَ شَوقا إِلَيهِ",11,"ه",1,1],["فتكثروا مما ذكر","ت فإنه خير الذخائر",12,"ر",1,0],["فَتَكادُ مِن أَسَفٍ عَلى آسي الحِمى","مِن كُلِّ ناحِيَةٍ تَثورُ شُجونا",13,"ن",2,0],["فَتَكاثَر وَتَأَلَّف فَيلَقاً","تَعصِمُ السِلمَ وَتَعلو لِلكِفاح",14,"ح",1,0],["فتكليسهم غير تكليسنا","وتطهيرهم غير تطهيرنا",15,"ن",2,0],["فتكَ الرشيدُ بهم فخلَّد ذكرَهُمْ","ومحوتَهُ محواً فَهُمْ لك ألوَمُ",16,"م",1,0],["فَتَكونَ أَوَّلَ سُنَّةٍ مَأثورَةٍ","أَن يَقبَلَ المَمدوحُ رِفدَ المادِحِ",17,"ح",1,0],["فَتَكونُ أَوَّلَ مانِعٍ مِن نَفسِهِ","ما أَمَّلَ العافي وَمِن جيرانِهِ",18,"ن",2,0],["فتكْتَ بها مثَّقفَةَ النَّواحي","على فِكْرٍ أسَدَّ من الثِّقافِ",19,"ف",1,0],["فتكَتْ بالمحبِّ من غيرِ ثأرٍ","فلها في فؤادِهِ آثارُ",20,"ر",1,0],["فَتكُ اللَواحِظِ وَالقُدودِ الهيفِ","أَغرى السُهادَ بِطَرفِيَ المَطروفِ",21,"ف",1,1],["فَتَكَت يَداهُ بِالنُضارِ فَأَتلَفَت","ما ضَمَّهُ مِن تالِدٍ وَطَريفِ",21,"ف",1,0],["فَتَكنا بِسَيفِ الماءِ فيها فَحاوَلَت","قِصاصاً فَباتَت وَهِيَ في العَقلِ تَفتُكُ",22,"ك",1,0],["فَتَكَت بِهِم أَيدي المَنونِ وَلَم تَزَل","خَيلُ المَنونِ عَلى الأَنامِ تُغيرُ",23,"ر",1,0],["فتكسرت قدحُ المنى ورجعتُ مِن","سقمِ الهوى وهزالِه أترنَّحُ",24,"ح",1,0],["فَتَكادُ ريقَةُ طَلِّها أَن تُحتَسى","رَشفاً وَمَبسِمُ بَرقِها أَن يُلثَما",25,"م",2,0],["فَتكَةٌ في الرومِ قاصِمَةٌ","ظَهرَ عِزِّ الرومِ وَالصَنَمِ",26,"م",1,0],["فَتَك السّلاحُ بها حَوَاسِرَ ما لها","غيرُ النُّفوس الوالهاتِ سلاحُ",27,"ح",1,0],["فَتَكافَأَ الحِزبانِ في حالَيهِما","وَمَضَت حُقوقُ العالَمينَ ضَياعا",28,"ع",2,0],["فَتَكاتُ طَرْفِكِ أم سيوفُ أبيكِ","وكؤوسُ خمرٍ أم مَراشفُ فيكِ",29,"ك",1,1],["فتَكْنَا بمُحْمَرِّ الخُدودِ وإنّهَا","بما اصفرَّ من ألوانِنا لَفَواتِك",30,"ك",1,0],["فتكادُ تُبلِغُني إليه تَشَوُّقاً","وتكادُ تَحمِلُني إليه تَطَرُّبا",31,"ب",2,0],["فَتَّكتَني طيزَنابا","ذَ وَقَد كُنتُ تَقِيّا",32,"ي",2,1],["فَتَكَت بِشارِبِها السُلافَةُ عَنوَةً","حَتّى ثَنَت حَيَّ النُفوسِ كَمَيتِها",33,"ت",3,0],["فتْكاً بنا يزْدادُ منهُ مُصَوراً","قَتْلي مُساوِرَ في بني يَزْداذا",34,"ذ",2,0],["فَتَكاد تلمس ما يصو","وره لعينك باليَد",35,"د",1,0],["فَتَكُونُ حَائِطَهَا المَنِيعَ عَلَى الْعِدَى","وَتَكُونُ قُوَّتَهَا الَّتِي لاَ تُغْلَبُ",36,"ب",1,0],["فَتَكْمُلَ أَفْرَاحُ الْبَنِينَ بِعَهْدِهَا","وَتَبْقَى بِهَا الأَفْرَاح مَوْصولَةَ الْعَهْد",37,"د",1,0],["فَتَكَ الذِئَابُ بِهِ","وَبَعْضُ النَّاسِ شَرٌّ من ذِئَابْ",38,"ب",1,0],["فَتكَةَ الخِلافَةِ في","فَضلِها وَجَعفَرِها",39,"ر",3,0],["فَتَكادُ تَأْكُلُهُ النفُو","سُ هَوىً وتشْرَبُهُ الضمائِرْ",40,"ر",1,0],["فتَكاتُ المكروبِ ألقتْ سلاحاً","للسريعِ السديدِ منَ فَتكاتِه",41,"ت",2,0],["فتكت بالسالمي المرتضى","غارة شعواء ما عنها حول",42,"ل",1,0],["فتكة أورثت الأرض البكا","والسموات وما فيها استقل",42,"ل",1,0],["فتكة لم يحم منها جيشه","لا ولا دافعها وقع الأسل",42,"ل",1,0],["فتكتسيهنّ ماجداً عِطر الط","طِينة ِ لا يشتكينَ من درنِك",43,"ك",1,0],["فَتك البُعد عَنكِ بي فَتكات","تَرَكت صارم اِصطِباري أَثيثا",44,"ث",2,0],["فتك الغرام به واقلق لبه","ريم كريم النبعتين نجاره",45,"ر",2,0],["فتكت محبتها بمهجة صبها","فلمتنها مما يكن شروح",46,"ح",1,0],["فتكت بي لواحظ الغزلان","وغزتي نواعس الأجفان",47,"ن",1,1],["فتكرمي عطفاً علي","ه بشرب كاس من مذاقك",48,"ك",1,0],["فتكت عيون الغيد بالألباب","وسطت بشوكتها على الأحباب",49,"ب",1,1],["فتكوا في الفؤاد فتكة عضب","جر في ساحة الضمير نصالا",50,"ل",2,0],["فتكت في القلوب فتك مواض","وأسالت على الخدود دموعا",51,"ع",2,0],["فتكاملت لي كل أنواعِ المنى","وطفقت أرفلُ في ثيابِ صفاءِ",52,"ا",2,0],["فتكت بأولياء الله بغياً","وعدواناً ولج بك الجماحُ",53,"ح",1,0],["فتكت بأحمد فانهّد ركنٌ","من الإِيمان وانقرض السَّماحُ",53,"ح",1,0],["فتكت به كما فتكت بخالد","وكان سلاحي تحتويه الجماجم",54,"م",1,0],["فَتَكَنَّفت أَهلُ القَطيفِ بِخَيلِها","وَرِماحِها وَقسِيِّها وَرُماتِها",55,"ت",3,0],["فتكارير التصاري","ف قبيح ومليح",56,"ح",1,0],["فتكافأ العذران واعتدلا","بين العمى وزمانة العرج",57,"ج",1,0],["فَتكرّم بِما يزيلُ أُوامي","وَيزيدُ التكميلَ وَالتكريما",58,"م",2,0],["فَتَكَشَّفنَ مُقبِلاتٍ فَقُلنا","أَسُكونٌ بِهِنَّ ذا أَم نِفارُ",59,"ر",1,0],["فتَكَتَّمتُ يومَ ذاك ولم يحمِل","فؤادٌ كعبءِ حُبّي الثقيل",60,"ل",1,0],["فتك الردى بأبي شجاعٍ فتكةً","زلَّت لها رضوى وخرَّ شمام",61,"م",1,0],["فتكتْ في الناسِ أعينها","وعيونُ الناسِ تنهبُها",62,"ب",3,1],["فتكت مقلتاك فتكاً بقلبي","وتعدّى على فؤادي هواكا",63,"ك",2,0],["فَتَكوا بِأَطرافِ البِلادِ وَنَحنُ في","ثِقَةٍ بِهِ مِن كَيدِهِم وَأَمانِ",64,