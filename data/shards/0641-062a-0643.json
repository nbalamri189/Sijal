wan.net/poem60852.html","الكامل"],[371,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[371,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[377,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[380,"يا من تناءت داره","https://www.aldiwan.net/poem48797.html","مجزوء الكامل"],[400,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[409,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.aldiwan.net/poem32447.html","الطويل"],[416,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[416,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[416,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[429,"عج بالديار وحي ذاك المعهدا","https://www.aldiwan.net/poem41428.html","الكامل"],[432,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[432,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[432,"والله يكفي أن أردد","https://www.aldiwan.net/poem12713.html","مجزوء الكامل"],[434,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[437,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[441,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[453,"قالوا تصبر قد يتوب الغادر","https://www.aldiwan.net/poem61766.html","الكامل"],[464,"إذا هز بانات العذيب جنوبها","https://www.aldiwan.net/poem3620.html","عموديه"],[479,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[479,"لمتى الوقوف بجانب الأسطول","https://www.aldiwan.net/poem37199.html","الكامل"],[482,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[482,"عرج أخي بحمى ليل لتخبرني","https://www.aldiwan.net/poem24421.html","عموديه"],[482,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[482,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[514,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[515,"الدمع يهمل والفؤاد عليل","https://www.aldiwan.net/poem12226.html","الكامل"],[540,"انا من علمت إذا دعيت لغارة","https://www.aldiwan.net/poem56634.html","الكامل"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[562,"يا راحلين إلى الديار الباقيه","https://www.aldiwan.net/poem52885.html","البسيط"]],"verses":[["فَتَكونَ أَوَّلَ زَلَّةٍ سَبَقَت","مِنّي وَآخِرَها إِلى الأَبَدِ",0,"د",1,0],["فَتَكَنَّفوا الشورى عَلى اِستِقلالِكُم","في الرَأيِ لا توحيهِ نَزعَةُ واحي",1,"ح",2,0],["فَتَكَلَّمَت تِلكَ الطُلولُ وَأَفصَحَت","لَمّا وَقَفتَ مُسائِلاً عَن شانِهِ",2,"ن",2,0],["فَتَكَشَّفَتْ فِيهَا خَفِيَّاتُ المُنَى","وَتَسَاجَلَتْ فِيهَا قُوَى الأَفْهَامِ",3,"م",1,0],["فَتَكادُ مِن عِرفانِ ما قَد عُوِّدَت","مِن ذاكَ أَن يُفصِحنَ بِالتَرحابِ",4,"ب",1,0],["فتكونَ ثَمَّ نصيرَهُ وظهيرَهُ","وخصيم عَائِب شِعْرِهِ ومُجِيبَهُ",5,"ب",2,0],["فتكونَ الذي تَنصَّل بالمُنْ","صُلِ من ضربةٍ بصَفْح القِرابِ",6,"ب",1,0],["فتكت به الأيام وهي عليمة","أن سوف تتلف منه ما لا تخلف",7,"ف",1,0],["فتكونون للوجوه أنوفاً","وتكونون للرؤوس فروقا",8,"ق",2,0],["فتكتسيهنّ ماجداً عِطر ال","طِينةِ لا يشتكينَ من درنِك",9,"ك",1,0],["فتكيده كيدَ المعاتِب مُحرِزاً","أجرَ المُقيلِ وأنتَ غيرُ غبين",10,"ن",1,0],["فَتَكَت مُقلَتاهُ بِالقَلب مِنّي","وَبَكَت مُقلَتايَ شَوقا إِلَيهِ",11,"ه",1,1],["فتكثروا مما ذكر","ت فإنه خير الذخائر",12,"ر",1,0],["فَتَكادُ مِن أَسَفٍ عَلى آسي الحِمى","مِن كُلِّ ناحِيَةٍ تَثورُ شُجونا",13,"ن",2,0],["فَتَكاثَر وَتَأَلَّف فَيلَقاً","تَعصِمُ السِلمَ وَتَعلو لِلكِفاح",14,"ح",1,0],["فتكليسهم غير تكليسنا","وتطهيرهم غير تطهيرنا",15,"ن",2,0],["فتكَ الرشيدُ بهم فخلَّد ذكرَهُمْ","ومحوتَهُ محواً فَهُمْ لك ألوَمُ",16,"م",1,0],["فَتَكونَ أَوَّلَ سُنَّةٍ مَأثورَةٍ","أَن يَقبَلَ المَمدوحُ رِفدَ المادِحِ",17,"ح",1,0],["فَتَكونُ أَوَّلَ مانِعٍ مِن نَفسِهِ","ما أَمَّلَ العافي وَمِن جيرانِهِ",18,"ن",2,0],["فتكْتَ بها مثَّقفَةَ النَّواحي","على فِكْرٍ أسَدَّ من الثِّقافِ",19,"ف",1,0],["فتكَتْ بالمحبِّ من غيرِ ثأرٍ","فلها في فؤادِهِ آثارُ",20,"ر",1,0],["فَتكُ اللَواحِظِ وَالقُدودِ الهيفِ","أَغرى السُهادَ بِطَرفِيَ المَطروفِ",21,"ف",1,1],["فَتَكَت يَداهُ بِالنُضارِ فَأَتلَفَت","ما ضَمَّهُ مِن تالِدٍ وَطَريفِ",21,"ف",1,0],["فَتَكنا بِسَيفِ الماءِ فيها فَحاوَلَت","قِصاصاً فَباتَت وَهِيَ في العَقلِ تَفتُكُ",22,"ك",1,0],["فَتَكَت بِهِم أَيدي المَنونِ وَلَم تَزَل","خَيلُ المَنونِ عَلى الأَنامِ تُغيرُ",23,"ر",1,0],["فتكسرت قدحُ المنى ورجعتُ مِن","سقمِ الهوى وهزالِه أترنَّحُ",24,"ح",1,0],["فَتَكادُ ريقَةُ طَلِّها أَن تُحتَسى","رَشفاً وَمَبسِمُ بَرقِها أَن يُلثَما",25,"م",2,0],["فَتكَةٌ في الرومِ قاصِمَةٌ","ظَهرَ عِزِّ الرومِ وَالصَنَمِ",26,"م",1,0],["فَتَك السّلاحُ بها حَوَاسِرَ ما لها","غيرُ النُّفوس الوالهاتِ سلاحُ",27,"ح",1,0],["فَتَكافَأَ الحِزبانِ في حالَيهِما","وَمَضَت حُقوقُ العالَمينَ ضَياعا",28,"ع",2,0],["فَتَكاتُ طَرْفِكِ أم سيوفُ أبيكِ","وكؤوسُ خمرٍ أم مَراشفُ فيكِ",29,"ك",1,1],["فتَكْنَا بمُحْمَرِّ الخُدودِ وإنّهَا","بما اصفرَّ من ألوانِنا لَفَواتِك",30,"ك",1,0],["فتكادُ تُبلِغُني إليه تَشَوُّقاً","وتكادُ تَحمِلُني إليه تَطَرُّبا",31,"ب",2,0],["فَتَّكتَني طيزَنابا","ذَ وَقَد كُنتُ تَقِيّا",32,"ي",2,1],["فَتَكَت بِشارِبِها السُلافَةُ عَنوَةً","حَتّى ثَنَت حَيَّ النُفوسِ كَمَيتِها",33,"ت",3,0],["فتْكاً بنا يزْدادُ منهُ مُصَوراً","قَتْلي مُساوِرَ في بني يَزْداذا",34,"ذ",2,0],["فَتَكاد تلمس ما يصو","وره لعينك باليَد",35,"د",1,0],["فَتَكُونُ حَائِطَهَا المَنِيعَ عَلَى الْعِدَى","وَتَكُونُ قُوَّتَهَا الَّتِي لاَ تُغْلَبُ",36,"ب",1,0],["فَتَكْمُلَ أَفْرَاحُ الْبَنِينَ بِعَهْدِهَا","وَتَبْقَى بِهَا الأَفْرَاح مَوْصولَةَ الْعَهْد",37,"د",1,0],["فَتَكَ الذِئَابُ بِهِ","وَبَعْضُ النَّاسِ شَرٌّ من ذِئَابْ",38,"ب",1,0],["فَتكَةَ الخِلافَةِ في","فَضلِها وَجَعفَرِها",39,"ر",3,0],["فَتَكادُ تَأْكُلُهُ النفُو","سُ هَوىً وتشْرَبُهُ الضمائِرْ",40,"ر",1,0],["فتَكاتُ المكروبِ ألقتْ سلاحاً","للسريعِ السديدِ منَ فَتكاتِه",41,"ت",2,0],["فتكتسيهنّ ماجداً عِطر الط","طِينة ِ لا يشتكينَ من درنِك",42,"ك",1,0],["فَتك البُعد عَنكِ بي فَتكات","تَرَكت صارم اِصطِباري أَثيثا",43,"ث",2,0],["فتك الغرام به واقلق لبه","ريم كريم النبعتين نجاره",44,"ر",2,0],["فتكت محبتها بمهجة صبها","فلمتنها مما يكن شروح",45,"ح",1,0],["فتكت بي لواحظ الغزلان","وغزتي نواعس الأجفان",46,"ن",1,1],["فتكرمي عطفاً علي","ه بشرب كاس من مذاقك",47,"ك",1,0],["فتكت عيون الغيد بالألباب","وسطت بشوكتها على الأحباب",48,"ب",1,1],["فتكوا في الفؤاد فتكة عضب","جر في ساحة الضمير نصالا",49,"ل",2,0],["فتكت في القلوب فتك مواض","وأسالت على الخدود دموعا",50,"ع",2,0],["فتكاملت لي كل أنواعِ المنى","وطفقت أرفلُ في ثيابِ صفاءِ",51,"ا",2,0],["فتكت بأولياء الله بغياً","وعدواناً ولج بك الجماحُ",52,"ح",1,0],["فتكت بأحمد فانهّد ركنٌ","من الإِيمان وانقرض السَّماحُ",52,"ح",1,0],["فتكت به كما فتكت بخالد","وكان سلاحي تحتويه الجماجم",53,"م",1,0],["فَتَكَنَّفت أَهلُ القَطيفِ بِخَيلِها","وَرِماحِها وَقسِيِّها وَرُماتِها",54,"ت",3,0],["فتكارير التصاري","ف قبيح ومليح",55,"ح",1,0],["فتكافأ العذران واعتدلا","بين العمى وزمانة العرج",56,"ج",1,0],["فَتكرّم بِما يزيلُ أُوامي","وَيزيدُ التكميلَ وَالتكريما",57,"م",2,0],["فَتَكَشَّفنَ مُقبِلاتٍ فَقُلنا","أَسُكونٌ بِهِنَّ ذا أَم نِفارُ",58,"ر",1,0],["فتَكَتَّمتُ يومَ ذاك ولم يحمِل","فؤادٌ كعبءِ حُبّي الثقيل",59,"ل",1,0],["فتك الردى بأبي شجاعٍ فتكةً","زلَّت لها رضوى وخرَّ شمام",60,"م",1,0],["فتكتْ في الناسِ أعينها","وعيونُ الناسِ تنهبُها",61,"ب",3,1],["فتكت مقلتاك فتكاً بقلبي","وتعدّى على فؤادي هواكا",62,"ك",2,0],["فَتَكوا بِأَطرافِ البِلادِ وَنَحنُ في","ثِقَةٍ بِهِ مِن كَيدِهِم وَأَمانِ",63,"ن",1,0],["فَتَكُرَّ عاطِفَةً بِوَص","لٍ وَاِجتِماعٍ مِن لُبَينِ",64,"ن",1,0],["فَتَكَت مِنهُم نَوائِبُها","بِرِجالٍ طَالَما فَتَكوا",65,"ك",3,0],["فتكاد نتتثرالنجوم أسى","في جوهن كذائب البرد",66,"د",1,0],["فتكاد تَدهش إن رَأيتَ بَنانَهُ","وتكاد تَسكرُ إن سَمعت كَلامَهُ",67,"م",2,0],["فتكونُ سيلاً للفساد مطهّراً","والحزمُ في التصميمِ والتعجيل",68,"ل",1,0],["فَتَكاثَفَتْ أُمَماً تَلوحُ فَعِنْدَها","يَخْفَى صُعُودٌ وسْطَها وحُدورُ",69,"ر",1,0],["فتكت بأَلباب الرجال ولم تَصُل","بسوى فواتن للقلوب فواتِكِ",70,"ك",1,0],["فَتَكت بِه حبطاً فأصبحَ عبرةً","تَبكيهِ مَنها الباغمات السجّعُ",71,"ع",1,0],["فَتَكَت بِهِ الوَجناتُ وَالأَحداقُ","فَدَعِ العَذولَ وَلَو أَطالَ تَحَكُّما",72,"م",2,0],["فَتَكت فَوارسه بِأعداها كَما","فَتَكَت براتعة الفَلا أُسد الشرى",73,"ر",2,0],["فَتكاتُ نابلةِ العيونِ عجيبةٌ","فاشْهَدْ وقائعَها بقلبٍ دارع",74,"ع",1,0],["فتكاتُه بعُداتِهِ أبداً","فتكاتُهُ بالنَّائِلِ الجَزلِ",75,"ل",1,0],["فتَكادُ أَن تَهمي سَحائبُ جودِه","مِن قَبل أَن تُبدي لهنَّ بُروقا",76,"ق",2,0],["فَتَكونُ في ظُلَمِ العَمى مُتَسكِّعاً","وَتسيرُ نور الهُدى أَنضائي",77,"ي",1,0],["فَتَكاد تَغرقهُ الدُمو","ع وَلَيسَ تَخبو نارهُ",78,"ر",2,0],["فتكونَ أنتَ، دليلَ غافِلِهم","نَحْوَ العطاءِ، فماله عُذْرُ",79,"ر",1,0],["فتكْتِ ببَتّاك الحُسامِ إذا هَوَى","على مُفْردٍ ثَنّاهُ في المعرَكِ القَطُّ",80,"ط",1,0],["فتكتَ بها فتك الكميّ بسيفه","كما يفتك الإِيمانُ في مِلَّة الكفر",81,"ر",1,0],["فتكاثرت نعم عليَّ بفضله","من فضله وأقلّها يكفيني",82,"ن",2,0],["فتكتْ أعْيُنُها الغيد به","ورَمَتْه أسهُم الألحاظ عَمْدا",83,"د",2,0],["فتكت بسحب الجود كفاه كما","بالحزم والآراء قد قهر العدى",84,"د",2,0],["فتكَتْ بي جُفونُها في هواها","مع عزّي كفتكةِ البرّاضِ",85,"ض",1,0],["فتكبرُ العلماءُ فيك جلالةً","شبّهتُه بتواضعِ الزُهّادِ",86,"د",1,0],["فتكونُ قد أوجدتَهُمْ","سبباً الى قالٍ وقيلِ",87,"ل",1,0],["فَتَكوا بأمَّةِ أَحْمَدِ أتُراهُمُ","أَمِنُوا عِقابَ اللهِ في رَمَضانِ",88,"ن",1,0],["فتكات أغلب في الكريهة باسل","قطعت فؤاد الخصم وهو يلندد",89,"د",1,0],["فتكتفت منه بأرعن شاهق","من دون قمته السها والمررم",90,"م",1,0],["فتكاثر الغلمان حول سريره","مترنمين كما يشاء الساحر",91,"ر",1,0],["فتكتِ بأجفاني صحاحٍ سقيمةٍ","يميت ويحيي عاشقيها مصيبها",92,"ب",3,0],["فتكت بنا الحرب الضروس ولم نزل","منها نقاسي في البلا ونعاني",93,"ن",2,0],["فتكالب البلقان يجمع قوة","كي يسترد مكاسب الإنجيل",94,"ل",1,0],["فتكاتها تبلي الأسود فلم تدع","للعاشقين جواهر في كرمد",95,"د",1,0],["فتكت كبدي من بعد حيهم","ومزقت فزعي من بين ذي حور",96,"ر",1,0],["فتكت جيوب الضر من","حر الهوى دون السنان",97,"ن",1,0],["فتكت جيوب الصبر فانفلقت قوا","ه المرسلات على القليب الفان",98,"ن",1,0],["فتَكَتْ عوامِلُهُ وهُنّ ثَعالبٌ","بجوارحِ الآسادِ منْ فُرسانهِ",99,"ن",2,0],["فتكشفت من فارس الإسلام عن","ملك تعود أن يعان وينصرا",100,"ر",2,0],["فتكت به أيدي المنايا بغتة","فالحزن لي حتى الممات طويل",101,"ل",1,0],["فَتَكادُ مِن عِرفان ماقَد عُوِّدَت","مِن ذاكَ أَن يَفضَحنَ بالتَرحابِ",102,"ب",1,0],["فَتكتُم به غَدْراً فألّا وكفُّهُ","تُقَلِّبُ مَسنونَ الغِرارَيْنِ ماضيا",103,"ي",2,0],["فَتَكَتْ بهِ ولعلَّها اعتذَرَتْ لنا","إذ لم تَكُنْ وَقَعَتْ برأسِ الزاويَهْ",104,"ي",2,0]]}