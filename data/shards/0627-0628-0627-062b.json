{"poems":[[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[79,"أبا ثابت كن في الشدائد ثابتا","https://www.aldiwan.net/poem36696.html","الطويل"],[44,"يديرونني عن سالم وأديرهم","https://www.aldiwan.net/poem50222.html","الطويل"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[412,"أبا ثعلب حياك ربك كلما","https://www.aldiwan.net/poem50104.html","الطويل"],[466,"ولما تلاقينا وللشوق سورة","https://www.aldiwan.net/poem15931.html","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"]],"verses":[["أبا ثابِتٍ لازالَ سَعْدُكَ ثابِتاً","وجودُكَ يَرْوي وِرْدُهُ غُلّةَ الصّدِي",0,"د",2,0],["أبا ثابِتٍ كُنْ في الشّدائِدِ ثابِتاً","أُعيذُكَ أنْ يُلْفَى عدوُّكَ شامِتا",1,"ت",2,1],["أَبا ثابِتٍ ساهَمتَ في الحَزمِ أَهلَهُ","فَرأيُكَ مَحمودٌ وَعَهدُكَ دائِمُ",2,"م",1,0],["أَبا ثابِتٍ أَو تَنتَمونَ فَإِنَّما","يَهيمُ لِعَينَيهِ مِنَ الشَرِّ هائِمُ",3,"م",1,0],["أَبا ثابِتٍ لا تَعلَقَنكَ رِماحُنا","أَبا ثابِتٍ أُقعُد وَعِرضُكَ سالِمُ",3,"م",1,0],["أَبا ثابِتٍ إِنّا إِذا تَسبِقُنَّنا","سَيُرعَدُ سَرحٌ أَو يُنَبَّهُ نائِمُ",3,"م",1,0],["أَبا ثَعلَبٍ حَيّاك رَبّك كُلَّما","تَغَنّى بِأَفنانِ الأَراكِ حَمامُ",4,"م",1,1],["أبا ثعْلبٍ ضربٌ من الحمد باهرٌ","له فيكَ خُلْدٌ اِنْ تَشا وبَقاءُ",5,"ا",2,0],["أَبِأَثوابِكَ الَّتي سَوفَ تَبلى","أَم بِجاهٍ وَرِثتَهُ عَن آلِك",6,"ك",1,0],["أَباثَورٍ سَجاحِ فإنَّ دَعْوى","تُخالِفُ ما أبيْتَ عَصِيمَ عَارِ",7,"ر",1,0]]}