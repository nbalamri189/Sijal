مِنَ العَدوِّ إِلى قَولٍ وَلا عَمَلِ",3,"ل",1,0],["حَتّى رَأى الجَعدِيُّ ذُلَّ قِيادِهِ","لِيَدِ المَنونِ تُمَدُّ بِالأَمراسِ",4,"س",1,0],["حَتّى رَماني بِهَواديها وَمَرّ","مُبتَسِماً كَأَنَّما قَضى وَطَر",5,"ر",1,0],["حَتّى رَأَيتُ الخَيلَ بَعدَ سَوادِه","حُمرَ الجُلودِ خُضِبنَ مِن جَرحاها",6,"ا",3,0],["حَتَّى رَمَتْنَا بِدَاهِي الظُّفْرِ طَاغِيَةٍ","فَتَى دَهَاءٍ وَبَأْسٍ جَاءَ يُفْنِينا",7,"ن",2,0],["حتى رجال الصين تحترم النسا","أفنحن ننقص عن رجال الصين",8,"ن",1,0],["حَتّى رَأَوكَ أَمامَ الجَيشِ تَقدُمُهُ","وَقَد طَلَعتَ عَلَيهِم دونَ ما أَمِلوا",9,"ل",3,0],["حَتّى رَأَيتُكَ بَينَ الناسِ مُجتَنِباً","تُثني عَلَيَّ بِوَجهٍ غَيرِ مُتَّإِبِ",10,"ب",1,0],["حتَّى رأى العلم شفع الشافعيّ بهِ","وقالَ مِنْ ذا وذا أدركتُ مطلبي",11,"ب",2,0],["حتَّى رأيت الوفد طافوا به","وبشروه بغلامٍ عليم",12,"م",1,0],["حتى رمتنا صروفُ الدهر قاصدةً","بفُرقةٍ حين خانتْنا المقاديرُ",13,"ر",1,0],["حَتّى رَأَوهُ صَباحاً في مُلَملَمَةٍ","شَهباءَ يَبرَقُ في حافاتِها البَصَرُ",14,"ر",1,0],["حَتّى رَأَوهُ بِجَنبِ مَسكِنَ مُعلِماً","وَالخَيلُ جاذِيَةٌ عَلى الأَقتارِ",15,"ر",1,0],["حَتّى رَأَيتُ النُجومَ آفِلَةً","وَكادَ قَلبُ الظَلامِ يَنفَطِرُ",16,"ر",1,0],["حَتّى رَجَعنا سالِمين وَلَم نَعُد","لَو لَم يَمُدَّ اللَهُ في الأَعمارِ",17,"ر",1,0],["حَتّى رَأَيتُ الشَمسَ تُلقي نورَها","في الأَرضِ فَوقَ سُهولِها بِحِبالِها",18,"ل",3,0],["حَتّى ربت وَكَثُرت جُموعُهُ","وَوَفر المالُ لَدَيهِ وَنَما",19,"ا",1,0],["حَتّى رَأَينا مِصرَ تَخطو إِصبَعاً","في العِلمِ إِن مَشَتِ المَمالِكُ ميلا",20,"ل",2,0],["حَتّى رَماهُ بِالمَنِيَّةِ فَاِنجَلَت","مَن يَبتَلي بِقَضائِهِ وَيُعافي",21,"ف",2,0],["حَتّى رَمى بِرِحالِنا وَرَجائِنا","في ساحِ مَأمولٍ عَزيزِ الجارِ",22,"ر",1,0],["حَتّى رَجَعتُ وَأَقلامي قَوائِلُ لي","المَجدُ لِلسَيفِ لَيسَ المَجدُ لِلقَلَمِ",23,"م",1,0],["حَتّى رَمَينَ إِلى الجِمارِ ضُحَيَّةً","وَالرَكبُ بَينَ مُحَلِّقٍ وَمُقَصِّرِ",24,"ر",1,0],["حَتّى رَماني بِسَهمِ ال","مَنونِ عَن قَوسَينِ",25,"ن",1,0],["حَتّى رَآهُ عِبادُ اللَهِ في دَقَلٍ","مُنَكَّساً وَهوَ مَقرونٌ بِخِنزيرِ",26,"ر",1,0],["حَتّى رَأَوا 