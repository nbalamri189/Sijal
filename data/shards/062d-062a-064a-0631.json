wan.net/poem55900.html","الرجز"],[456,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[456,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[462,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[462,"قد كانت الفصحاء تذكر حاتماً","https://www.aldiwan.net/poem3391.html","عموديه"],[475,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[475,"دعني أكابد أشجاني وأوصابي","https://www.aldiwan.net/poem15233.html","البسيط"],[513,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[513,"بان العزا وفؤادي ماله جلد","https://www.aldiwan.net/poem12086.html","البسيط"],[536,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[549,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[549,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[549,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[549,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[556,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[556,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[559,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[565,"جاءت فأكبرها طرفي فقمت لها","https://www.aldiwan.net/poem69463.html","البسيط"]],"verses":[["حَتّى رَجَعتَ بِفِتيَةٍ قَصَفوا القَنا","وَرَمَوا بِكُلِّ حَنِيَّةٍ مِرنانِ",0,"ن",1,0],["حَتّى رُميتُ رُبَّ نَبلٍ عَن كَلِم","إِنَّ هُمومَ القلَبِ أَعوانُ الهِمَم",1,"م",1,0],["حَتّى رَمى الإِصباحَ في لَيلَةٍ","لَفَّت إِزارَ الرَجُلِ المُحرِمِ",2,"م",1,0],["حَتّى رَجَعنَ وَلَم يَترُكنَ فاغِرَةً","مِنَ العَدوِّ إِلى قَولٍ وَلا عَمَلِ",3,"ل",1,0],["حَتّى رَأى الجَعدِيُّ ذُلَّ قِيادِهِ","لِيَدِ المَنونِ تُمَدُّ بِالأَمراسِ",4,"س",1,0],["حَتّى رَماني بِهَواديها وَمَرّ","مُبتَسِماً كَأَنَّما قَضى وَطَر",5,"ر",1,0],["حَتّى رَأَيتُ الخَيلَ بَعدَ سَوادِه","حُمرَ الجُلودِ خُضِبنَ مِن جَرحاها",6,"ا",3,0],["حَتَّى رَمَتْنَا بِدَاهِي الظُّفْرِ طَاغِيَةٍ","فَتَى دَهَاءٍ وَبَأْسٍ جَاءَ يُفْنِينا",7,"ن",2,0],["حتى رجال الصين تحترم النسا","أفنحن ننقص عن رجال الصين",8,"ن",1,0],["حَتّى رَأَوكَ أَمامَ الجَيشِ تَقدُمُهُ","وَقَد طَلَعتَ عَلَيهِم دونَ ما أَمِلوا",9,"ل",3,0],["حَتّى رَأَيتُكَ بَينَ الناسِ مُجتَنِباً","تُثني عَلَيَّ بِوَجهٍ غَيرِ مُتَّإِبِ",10,"ب",1,0],["حتَّى رأى العلم شفع الشافعيّ بهِ","وقالَ مِنْ ذا وذا أدركتُ مطلبي",11,"ب",2,0],["حتَّى رأيت الوفد طافوا به","وبشروه بغلامٍ عليم",12,"م",1,0],["حتى رمتنا صروفُ الدهر قاصدةً","بفُرقةٍ حين خانتْنا المقاديرُ",13,"ر",1,0],["حَتّى رَأَوهُ صَباحاً في مُلَملَمَةٍ","شَهباءَ يَبرَقُ في حافاتِها البَصَرُ",14,"ر",1,0],["حَتّى رَأَوهُ بِجَنبِ مَسكِنَ مُعلِماً","وَالخَيلُ جاذِيَةٌ عَلى الأَقتارِ",15,"ر",1,0],["حَتّى رَأَيتُ النُجومَ آفِلَةً","وَكادَ قَلبُ الظَلامِ يَنفَطِرُ",16,"ر",1,0],["حَتّى رَجَعنا سالِمين وَلَم نَعُد","لَو لَم يَمُدَّ اللَهُ في الأَعمارِ",17,"ر",1,0],["حَتّى رَأَيتُ الشَمسَ تُلقي نورَها","في الأَرضِ فَوقَ سُهولِها بِحِبالِها",18,"ل",3,0],["حَتّى ربت وَكَثُرت جُموعُهُ","وَوَفر المالُ لَدَيهِ وَنَما",19,"ا",1,0],["حَتّى رَأَينا مِصرَ تَخطو إِصبَعاً","في العِلمِ إِن مَشَتِ المَمالِكُ ميلا",20,"ل",2,0],["حَتّى رَماهُ بِالمَنِيَّةِ فَاِنجَلَت","مَن يَبتَلي بِقَضائِهِ وَيُعافي",21,"ي",1,0],["حَتّى رَمى بِرِحالِنا وَرَجائِنا","في ساحِ مَأمولٍ عَزيزِ الجارِ",22,"ر",1,0],["حَتّى رَجَعتُ وَأَقلامي قَوائِلُ لي","المَجدُ لِلسَيفِ لَيسَ المَجدُ لِلقَلَمِ",23,"م",1,0],["حَتّى رَمَينَ إِلى الجِمارِ ضُحَيَّةً","وَالرَكبُ بَينَ مُحَلِّقٍ وَمُقَصِّرِ",24,"ر",1,0],["حَتّى رَماني بِسَهمِ ال","مَنونِ عَن قَوسَينِ",25,"ن",1,0],["حَتّى رَآهُ عِبادُ اللَهِ في دَقَلٍ","مُنَكَّساً وَهوَ مَقرونٌ بِخِنزيرِ",26,"ر",1,0],["حَتّى رَأَوا لِأَبي العاصي مُسَوَّمَةً","تَعدو كَراديسَ بِالشُمِّ المَغاويرِ",26,"ر",1,0],["حَتّى رَأَيتُ تُرابَ دِجلَةَ خارِجاً","تَخِدُ الرِكابُ عَلَيهِ بِالأَوقارِ",27,"ر",1,0],["حتَّى رَأَيتُ نُجومَ اللَّيلِ غائِرَةً","كأنَّهُنَّ عيونٌ حَشْوُها رَمَضُ",28,"ض",1,0],["حَتّى رَأَيتُ مِياهَ اللَيلِ غائِرَةً","في غَربِها وَغَديرَ الصُبحِ قَد طَفَحا",29,"ح",2,0],["حَتّى رَأَيتُ نُقوشَ سَعدي قَد بَدَت","وَيَدَيَّ قَد حَلَّت تَشَشدَرَ بَندِهِ",30,"د",2,0],["حَتّى رَميتَ حُصونَها بِكَتائِبٍ","شُهبٍ وَقُدتَ لَها الجِيادَ القودا",31,"د",2,0],["حتى رجعتَ مخادِعاًَ","ومضيتَ جدَّ مضلَّلِ",32,"ل",1,0],["حتى رجعت كأنما رجع الصبا","لي بالأزاهر والربيع الحالي",33,"ي",1,0],["حتى رأيت الخير في طلعة","تحمل لي الخير وبشراه",34,"ا",2,0],["حَتَّى رَبَأْتُ مِنَ الْمَعَالِي هَضْبَةً","شَمَّاءَ تُزْلِقُ أَخْمَصَ الْمُتَسَنِّمِ",35,"م",1,0],["حَتّى رَأَيتُ حُمولَهُم وَكَأَنَّها","نَخلٌ تُكَفكِفُها شَمالٌ زَعزَعُ",36,"ع",1,0],["حَتّى رَأَيتُ اللَيلَ في ال","آفاقِ مُسوَدَّ الذَوائِب",37,"ب",1,0],["حتى رأيْتُ قصائِدي منحولَةً","والقولَ في أمِّ الكِتابِ مَقُولا",38,"ل",2,0],["حتى رأى جُهَّالُهم مِن عزْمهِ","غِبَّ الذي شهِدتْ به العُلماء",39,"ا",2,0],["حَتّى رَأَينا السَوادَ مُنحَسِراً","وَدارَتِ الشَمسُ في المَقاصيرِ",40,"ر",1,0],["حَتّى رَماهُ السُكرُ في طَرفِهِ","فَباحَ مِن سُكرٍ بِما يُخفي",41,"ف",2,0],["حَتّى رَفَعنا قِدرَنا بِنِضائِها","فَاللَحمُ بَينَ مُؤَزَّرٍ وَمُوَشَّقِ",42,"ق",1,0],["حَتّى رَآها سامِياً فَرعُها","مِن بَعدِ ما كانَت بِإِرماقِ",43,"ق",1,0],["حتى رأيتُ الرؤسَ مائلةً","كأنّ من سُكرٍ بها أوَدُ",44,"د",1,0],["حَتّى رَدَدنا المُلكَ في","أَهلِ النَبِيِّ العَرَبي",45,"ب",2,0],["حتّى رأى حَفْصٌ سبيلَ رُشدِهِ","بعد بُلوغِ غايةٍ من جُهدِهِ",46,"ه",1,0],["حتّى رَشَحَتْ من عَرَقٍ وجْنَتُهُ","لا زالَ نَصِيبِي مِنْهُ ماءُ الوردِ",47,"د",1,0],["حتى رأَيتُ مصائباً","وَشهدت قاصمة الظهور",48,"ر",1,0],["حتى رأته كوى السماء ففتّحت","وتلألأت بسنى السلام ثقوبها",49,"ب",3,0],["حتى رأتني على بُعْدٍ مطوَّقةٌ","مجروحةُ الصوتِ ولهى اللحن سجواءُ",50,"ا",2,0],["حتى رمى مصر به المصير","وهيئت قبرا له بوصير",51,"ر",1,0],["حتَّى رَمَتْنَا صُرُوفُ الدَّهْرِ عن كَثَبٍ","فَفَرَّقَتْنَا وَهل مِن صَرْفِه واقِ",52,"ق",1,0],["حَتّى رَأَيتُ الخَيلَ بَعدَ سَوادِها","حُمرَ الجُلودِ خُضِبنَ مِن جَرحاها",53,"ا",3,0],["حتىَّ رآها الأقوالُ مِن طَرَف ال","منِقَلِ مُخضرَّةٌ كَتائِبهُا",54,"ب",3,0],["حَتَّى رَحَلْتَ عَنِ الْحَيَا","ةِ فَكَانَ حُسْنُ الذِّكْرِ زَادَكْ",55,"ك",1,0],["حَتَّى رأيتُ لَدَى النَّبيِّ سَراتَهُمْ","قِسْمَيْنِ يَقتُلُ مَنْ نَشاء وَيطْرُدُ",56,"د",1,0],["حتى رأيت بقبر عروة بانة","محنية والهفتا للبان",57,"ن",1,0],["حَتَّى رَجَعْتَ وَلِلأَقْلامِ هَلْهَلَةٌ‏‏‏","في كَفِّ أَبْلَغِ مَنْ غَنَّى وَمَنْ طَرِبا",58,"ب",2,0],["حَتّى رَأَيتُ العَقيقَ مُنتَثِراً","مِن عِقدِهِ وَالرِداءَ مُنصَبِغا",59,"غ",2,0],["حَتَّى رَمَتْهَا اللَّيَالي في فَرَائدها","وَخَرَّ سُلْطَانُهَا يَنْهَارُ مِنْ صَبَبِ",60,"ب",1,0],["حتى رأَى علماءَكم في شطِّه","فإِذا به يجري أمام بحار",61,"ر",1,0],["حتى رأيتكَ بينَ الناسِ مجتنباً","تُثْني عَليّ بِوَجْهٍ غَيرِ مُتّئِبِ",62,"ب",1,0],["حتى رأيت الشمس تلقي نورها","في الأرض فوق سهولها وجبالها",63,"ل",3,0],["حتى رأتْ شيبي يلو","حُ بعارضِي مثلي الثغَامِ",64,"م",1,0],["حتى رُميت بحلوه وبمرّه","وعرفت ما يحلو وما لا يعذبُ",65,"ب",1,0],["حتى رميت بحلوه وبمره","من كان لا يدري الهوى فيجرب",66,"ب",1,0],["حَتّى رَآكَ فَمالَ الإِختِيالُ بِهِ","إِلى الجِماحِ إِلى أَن كَفَّهُ الأَدَبُ",67,"ب",1,0],["حتى رأَيتُ غداً وقربَ مكانهِ","لا شئَ منه لفرط شوقي أبعدُ",68,"د",1,0],["حتى رأوك فكان هذا باسطاً","يدعو ذا شكراً لربك يسجدُ",68,"د",1,0],["حتى رأينا اليومَ سعداً خارقاً","يعطي الذي لا يمكن الإِمكانا",69,"ن",2,0],["حَتّى رَماهُ الرِجسُ شُلّت يَدُهُ","عَن بارِعِ الرَميَةِ صُلبِ المَنزَعِ",70,"ع",1,0],["حَتّى رَجَعُوا وَوِطابُهُمُ","صَفِرٌ يَقفُونَ هَلا بِلَمِ",71,"م",1,0],["حَتَّى رأَيْتُ المُشْفِقِينَ تَقَطَّعَتْ","لَما لهمْ ورَأَيْتُ يَوْمَكَ مُقْطِعا",72,"ع",2,0],["حتى رأيتُ وَضيء وجْهِكِ ساطِعًا","لكأنّهُ بدرٌ تخلَّقَ مِنْ قَمَرْ",73,"ر",1,0],["حتى رأيت البينَ جَدَّ وأَعْرَبَتْ","نَغمُ الحُداةِ بهم عن الإدلاج",74,"ج",1,0],["حتى رأى من جنود الشيب بادرة","وَلَّى وخَلَّفني في إثْرِها وعَدا",75,"د",2,0],["حتى رأيتهم شتيتا جمعهم","والدهر فيه مراهب ووبال",76,"