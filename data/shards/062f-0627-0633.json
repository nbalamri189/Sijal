4927,"خمائل الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=29720",""],[4929,"مئذنة الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=199511",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5376,"كرامةٌ تلامسُ السماء","https://www.poetsgate.com/ViewPoem.aspx?id=188265",""],[5376,"يا دارُ عودُ الوردِ لمْ يمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=188342",""],[5376,"يا داحسَ الغبراءُ هيْتَ مُظفَّرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205986",""],[5458,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=113365",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[5621,"صلاة الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=24567",""],[2110,"دع هوى سلمى واقصر عن سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=156270",""],[5906,"يا عازف النّاي","https://www.poetsgate.com/ViewPoem.aspx?id=188074",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[463,"من دلَّ ربّاتِ العيونِ النُّجلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60197&r=&rc=253",""],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""]],"verses":[["داسَ الحِمامُ عَرينَ آسادِ الشَرى","يا لَيتَ شِعري أَينَ كانَ أَبوكِ",0,"ك",1,0],["داسَ الحِمامُ عَرينَ خا","لِكَ وَهوَ مَرهوبٌ مَهيب",1,"ب",1,0],["داسَ الأَثيمُ حِماهُما","تَحتَ الدُجى وَدَهاهُما",2,"م",2,0],["داسَ الكُماةَ بِخَيلِهِ حَتّى غَدا","وَمناطُ تاجِ المُلكِ مِنهُ مَدوسُ",3,"س",1,0],["داست حوافرُها ثلجاً كما وطئت","رَملاً وخاضت عباباً في مغازينا",4,"ن",2,0],["داسَ الأَفاحيصَ وَالأُدحِيَّ مُبتَسِماً","لَم يَشكُ أَيناً وَلَم يَسهَم مُحَيّاهُ",5,"ا",2,0],["داسَت أَداحِيَّ النَعامِ سُرىً وَكَم","نَبَثَت مَناسِمُهُنَّ من أُفحوصِ",6,"ص",1,0],["داست به الجوَّ وحسّادَه","مَداوسَ الذِّلَة فوق الرَّغامْ",7,"م",1,0],["داسوا الحروب من قنا أقلامهم","بالطاعنات في الرعيلِ الأوّلِ",8,"ل",1,0],["داسوا الزمانَ فذلَّلوا أحداثَه","بأخامصٍ فوق الأضالع وُقَّعِ",9,"ع",1,0],["داسوا ثرى المجد القديم ومشَوا","خَطْراً على خدّ الزمان الغابرِ",10,"ر",1,0],["داسُوا بأعقابِهمُ هامَ العلا","واقتَعدوا ظهورَها واعتقَبوا",11,"ب",3,0],["داسوا الممالك فاغتدت أقدامهم","مسطورة الآثار في جنباتها",12,"ت",3,0],["داسوا بأقدامهم شُمَّخاً","تُرامُ بالأيدي ولا تُلْحَقُ",13,"ق",1,0],["داسَ البلادَ بإذن اللهِ يكسِرها","وتَكسِرُ السيفَ نَزْعاً من نَواصيها",14,"ي",3,0],["داسَ الحَبيبُ شُعاعَ الشّمسِ حينَ مَشى","وَغَيرهُ كانَ يَمشي فَوقَ دَيجورِ",15,"ر",1,1],["داسَت بِأَقدامِها كاساتِهِ حَنقاً","كَالبَدر داسَ جَبين الأَنجُمِ الزُهرِ",16,"ر",1,0],["داسوا النجومَ بفخرِه","وبحلمِه وزنوا الجبالا",17,"ل",2,0],["داست على الصبح فابيضت قوائمها","وآخت الليل فاسودت بقاياها",18,"ا",3,0],["داسوا بأرجلهم رأس الرجا فغدت","تخطوا وتسحق في الأسبان والصين",19,"ن",1,0],["داسوا خِزانةَ الهدى والرحمَه","وسفَطَ العِلمِ وكنزَ الحِكمَه",20,"ه",1,0],["داسوا كتابَ اللَه بالحوافِزِ","وبضعة الهادي النبي الطاهرِ",20,"ر",1,0],["داس البساط بنعله لما دنا","من قاب قوس حيث طاب لقاء",21,"ا",2,0],["داس النبي بساط العرش منتعلا","ما طور سينا ومن موسى وحزقيل",22,"ل",1,0],["داس وعجّا تحت نيرهما","ومن السنابل حبهما اندفقا",23,"ق",2,0],["داسوا الضِعافَ بِأَرجُلٍ أَفهكذا","رَبُّ الأَنامِ عَلَيهُمُ أَوصانا",24,"ن",2,0],["داسَتْ عَليها الحَربُ.. داستْ على","وَجْهي.. وداستْ شَهقتي الواقفةْ",25,"ف",2,0],["دَاْسُوْا عَلَى الدُّسْتُوْرِ فِيْ دِيْوَاْنِهِمْ","وَاسْتَهْتَرُوْا بِوَثَاْئِقِ الْمِيْثَاْقِ",26,"ق",1,0],["داست سنابِكُها للرومِ مملكةً","ومرّغَتْ أنفَ كسرى (آنُ شَرْوانَا)",27,"ن",2,0],["داست ْ على هامِنا أقدام ُ مَن ْ  سَلَفَا ً ","كانوا عبيدا ًَ لنا يطويهم الهرب ُ",28,"ب",1,0],["داسوا على السجَّانِ تحْملُهمْ","للعزِّ أوطانٌ فما ضاعوا",29,"ع",3,0],["داسوا كرامتَنا ومهجَتنا","لمْ تبقَ نفسٌ بعد لمْ تدسِ",30,"س",1,0],["داسَ الكرامةَ في الخنا رعديدُها","وعلى الكرامِ زمانُنا ما أعْسرَهْ",31,"ر",2,0],["داسوا الكرامة بالرسول استهزؤا","غصبوا الرجال فلاقوا قوماً نوما",32,"م",2,0],["داسوا التَّرابَ ودنَّسوا طُهرَ الثَّرى","في اللَّيلِ يُسْمَعُ للتُّرابِ أنينُ",33,"ن",1,0],["داسَتْ كراماتِ الرجالِ ودنّسَتْ","حرَمَ الرشيدِ ومَوْطِنَ الآسادِ",34,"د",1,0],["داس هامات المعالي سؤددا","وسما شأوا على السبع الشداد",35,"د",1,0],["داست عليه صنوف الدهر واندفعت","بين الشرايين تدمي شقتي اليسرى",36,"ر",2,0],["داسوه خيل الضد في معمع الوَغى","تَبكي عَلَيهِ البيض تذرف عُيونها",37,"ن",3,0],["داسوا العِدى حوران عاثوا وَشنعوا","وَجرت فضايح في الجبل وهوال",38,"ل",1,0],["دَاسُوا عَلَى القُرْآنِ في عِزِّ الضُّحَى","فَتَظَاهَرَ الأَطْفالُ وَا قُرْآنِيَا",39,"ي",2,0],["داسوا لحروب من قنا أقلامهم","بالطاعناتِ في الرعيلِ الأوّلِ",40,"ل",1,0],["داستِ القلبَ همومٌ جمّة","وأعاصيرٌ وجوع ونِقم ْ",41,"م",1,0]]}