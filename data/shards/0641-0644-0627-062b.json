{"poems":[[91,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[91,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[45,"أقول لعنس كالعلاة أمون","https://www.aldiwan.net/poem66666.html","الطويل"],[66,"فتك اللواحظ والقدود الهيف","https://www.aldiwan.net/poem38482.html","الكامل"],[141,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[141,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[233,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[278,"أما الزمان فلم يزل ينحي","https://www.aldiwan.net/poem60554.html","أحذ الكامل"],[560,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"]],"verses":[["فَلا ثَغرُها دُر وَلا أُقحُوانَةٌ","وَلا دَمعُها طَل وَلا ريقُها شُهدُ",0,"د",1,0],["فَلا ثُلوجٌ عَلى الرَوابي","وَلا غَمامٌ عَلى البُدورِ",1,"ر",1,0],["فَلا ثَأرَ حَتّى تَطلُعَ الخَيلُ مُرتَقى","خُوَيتُ بِأُسدٍ في السَنَوَّرِ جونِ",2,"ن",1,0],["فَلأَثنِيَنَّ إِلى العِراقِ أَعِنَّتي","وَأُطيلُ في تِلكَ الدِيارِ وُقوفي",3,"ف",2,0],["فَلَأُثنِيَنَّ مَدى حَياتي موقِناً","أَنّي مَتى أَجحَد جَميلاً أَظلِمِ",4,"م",1,0],["فَلَأُثنِيَنَّ عَلى سَحابٍ غَيثُهُ","أَغنى الفَقيرَ وَأَنصَفَ المَظلوما",5,"م",2,0],["فَلَأُثنِيَنَّ عَلى صَنائِعِهِ كَما","أَثنى الرَبيعُ عَلى السَحابِ الماطِرِ",6,"ر",1,0],["فَلأَثْنِيَنَّ عَلَى يَدٍ فَتَحَتْ","بابَ الرَّجاءِ إِلى أَبِي الْفَتْحِ",7,"ح",1,0],["فلا ثَلَّتْ لهُ الأقدارُ عَرْشاً","ولا نَسَخَتْ لهُ الأيَّامُ ظِلاّ",8,"ل",2,0]]}