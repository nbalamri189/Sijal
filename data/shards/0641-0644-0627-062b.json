{"poems":[[93,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[93,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[47,"أقول لعنس كالعلاة أمون","https://www.aldiwan.net/poem66666.html","الطويل"],[68,"فتك اللواحظ والقدود الهيف","https://www.aldiwan.net/poem38482.html","الكامل"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[147,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[240,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[285,"أما الزمان فلم يزل ينحي","https://www.aldiwan.net/poem60554.html","أحذ الكامل"],[567,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122579","الوافر"],[2573,"","https://poetry.dctabudhabi.ae/diwan/poem/84977","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137152",""],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129877","الكامل"],[2766,"","https://poetry.dctabudhabi.ae/diwan/poem/124308","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100403","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2536","الكامل"],[5688,"ظاهرة الغش في المدارس","https://www.poetsgate.com/ViewPoem.aspx?id=200922",""],[6117,"مانعةُ الرَّخَاء","https://www.poetsgate.com/ViewPoem.aspx?id=182789",""]],"verses":[["فَلا ثَغرُها دُر وَلا أُقحُوانَةٌ","وَلا دَمعُها طَل وَلا ريقُها شُهدُ",0,"د",1,0],["فَلا ثُلوجٌ عَلى الرَوابي","وَلا غَمامٌ عَلى البُدورِ",1,"ر",1,0],["فَلا ثَأرَ حَتّى تَطلُعَ الخَيلُ مُرتَقى","خُوَيتُ بِأُسدٍ في السَنَوَّرِ جونِ",2,"ن",1,0],["فَلأَثنِيَنَّ إِلى العِراقِ أَعِنَّتي","وَأُطيلُ في تِلكَ الدِيارِ وُقوفي",3,"ف",2,0],["فَلَأُثنِيَنَّ مَدى حَياتي موقِناً","أَنّي مَتى أَجحَد جَميلاً أَظلِمِ",4,"م",1,0],["فَلَأُثنِيَنَّ عَلى سَحابٍ غَيثُهُ","أَغنى الفَقيرَ وَأَنصَفَ المَظلوما",5,"م",2,0],["فَلَأُثنِيَنَّ عَلى صَنائِعِهِ كَما","أَثنى الرَبيعُ عَلى السَحابِ الماطِرِ",6,"ر",1,0],["فَلأَثْنِيَنَّ عَلَى يَدٍ فَتَحَتْ","بابَ الرَّجاءِ إِلى أَبِي الْفَتْحِ",7,"ح",1,0],["فلا ثَلَّتْ لهُ الأقدارُ عَرْشاً","ولا نَسَخَتْ لهُ الأيَّامُ ظِلاّ",8,"ل",2,0],["فلا ثَغرٌ يَخافُ عليهِ إلا","رَماهُ بِه فكان لَهُ سَدادا",9,"د",2,0],["فلا ثروة الدنيا نريد اكتسابها","ألا إنها عن وفرها قد تحلت",10,"ت",1,0],["فلأثنين على صنائعه التي","سيزين التاريخ فيها من كتب",11,"ب",1,0],["فلأثنين عليك ما أثنى بأع","لى الغصن حنّان الهديلِ مغرّدُ",12,"د",1,0],["فلا ثناء يرى وان علا رتبا","جل العلي يرى كقوله لعلي",13,"ل",2,0],["فلأثنينَّ على الزمان ولم اكن","من قبل ذا اثني على الازمان",14,"ن",1,0],["فلا ثواب عليه للمطيع ولا","عقاب يلزمه للعاصي بالجرم",15,"م",1,0],["فَلَأَثأَرَنَّ بِمالِكٍ وَبِمالِكٍ","وَأَخي المَروراةِ الَّذي لَم يوسَدِ",16,"د",1,0],["فلا ثقةٌ لديه بأيّ حلّ","ولا سهلٌ لديه ولا يسير",17,"ر",1,0],["فلا ثوبُ الوجاهةِ شفَّ روحاً","ولا ردَّ العُبوسَ جدا الكساءِ",18,"ا",2,0]]}