html","الكامل"],[477,"حالي غدا عاطلا من وصلك الحالي","https://www.aldiwan.net/poem15264.html","البسيط"],[482,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[482,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[482,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[482,"فلولا قيود البين كنت عبيد با","https://www.aldiwan.net/poem24422.html","عموديه"],[482,"بجزع الحمى ظبي حمى ذلك الحمى","https://www.aldiwan.net/poem24477.html","عموديه"],[482,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[506,"بلغت المنى وحللت الحرم","https://www.aldiwan.net/poem2400.html","المتقارب"],[514,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[515,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[529,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[529,"على العلم العلوي مني تحية","https://www.aldiwan.net/poem37276.html","الطويل"],[529,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[529,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[538,"يغادر مراكشا فرج","https://www.aldiwan.net/poem48252.html","عموديه"],[538,"وحقك يا منيتي ما أحب","https://www.aldiwan.net/poem48284.html","عموديه"],[538,"حججنا لعمري ابتغاء الثواب","https://www.aldiwan.net/poem48287.html","عموديه"],[551,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[551,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[551,"فطيب رياها المقام وضوأت","https://www.aldiwan.net/poem47234.html","الطويل"],[551,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[551,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[551,"عثرت ولولا انتياش الإله","https://www.aldiwan.net/poem48024.html","المتقارب"],[558,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[558,"إن النصارى واليهود كلاهما","https://www.aldiwan.net/poem34613.html","الكامل"],[562,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"],[573,"وخبرني الناعون ما صنع الردى","https://www.aldiwan.net/poem3657.html","الطويل"],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[579,"سألت الذي لاينفذ الرزق عنده","https://www.aldiwan.net/poem56779.html","الطويل"],[586,"حي غزالا سل من أجفانه","https://www.aldiwan.net/poem17822.html","الرجز"],[587,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[587,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["في أَربَقٍ وَسُيوفُ المَوتِ ماضِيَةٌ","يُطِعنَ أَمرَكَ في الأَعناقِ وَالقُلَلِ",0,"ل",1,0],["فَيا راعي الذَودِ الظِماءَ تَرَكتَها","وَأَحفَظُ راعٍ مُذ نَأَيتَ مُضيعُ",1,"ع",1,0],["فَيا راكِبَ العَجزِ مُرخي العِنانِ","لِلذُلِّ يَخبِطُ وَالعِزُّ ضاحِ",2,"ح",1,0],["فَيا رَبِّ إِنَّ المالكيَّةَ حاجَتي","وَأَنتَ عَلى أَن تَجمَعَ الشَّملَ قادرُ",3,"ر",1,0],["فَيا رَبُّ لا تُشمِت بِنا حاسِداً لَنا","يُراقِبُنا مِن أَهلِ فَوزٍ وَلا أَهلي",4,"ي",1,0],["فَيا رَبُّ أَلِّف بَينَ قَلبي وَقَلبِها","لِكَيلا تَعَدّى بي أَمامي وَلا خَلفي",5,"ي",1,0],["فَيَاربِّ عَامِلْنَا بِمَا أَنْتَ أَهْلُهُ","مِنَ الْعَفْوِ وَاجْبُرْ صَدْعَنَا أَنْتَ مَوْلاَنَا",6,"ن",2,0],["فَيا رحلةَ الصّيْفِ التي بجوانِحي","لَها لهَبٌ لا ينْقَضي وسَعيرُ",7,"ر",1,0],["فَيا رُبَّ ناعِيَةٍ مِنهُمُ","تَشُدُّ اللِفاقَ عَلَيها إِزارا",8,"ر",2,0],["في أَراكٍ مَردٍ يَكادُ إِذا ما","ذَرَّتِ الشَمسُ ساعَةً يُهراقُ",9,"ق",1,0],["فَيا راكِباً إِما عَرَضتَ فَبَلِّغَن","بَني مِلقَطٍ عَني إِذا قيلَ مَن عَنى",10,"ا",1,0],["فَيا رُبَّ مَكروبٍ كَرَرتُ وَراءَهُ","وَعانٍ فَكَكتُ الغُلَّ عَنهُ فَفَدّاني",11,"ن",2,0],["فَيا رُبَّ مَكروبٍ كَرَرتُ وَراءَهُ","وَطاعَنتُ عَنهُ الخَيلَ حَتّى تَنَفَّسا",12,"س",2,0],["فَيا رَبُّ حَبِّبني إِلَيها وَأَعطِني ال","مَوَدَّةَ مِنها أَنتَ تُعطي وَتَمنَعُ",13,"ع",1,0],["فِي أَرْضِ كَنْعَانَ إلاَّ عَسْكَرَهُ","أَحَسَّ مَا بَأْسُ شَعْبٍ مِذْعَانِ",14,"ن",1,0],["فيا ربّة الخدر أسمعي ما أقوله","لعلّ مقالي فيه شيء من النفع",15,"ع",1,0],["فيا ربّ نَفِّس من كروب عظيمة","ويا ربّ خفّف من عذاب مشدَّد",16,"د",1,0],["فَيا رَبَّ البَرِيَّةِ أَعطِ شُكراً","وَعافِيَةً وَأَبقِ لَنا هِشاما",17,"م",2,0],["فَيا راكِبَ القَوصاءِ ما أَنتَ صانِعٌ","بِهَزّانَ إِذ أَلحَمتُهُم شَرَّ مُلحَمِ",18,"م",1,0],["فَيا راكِبي عُليا جَديلَةَ إِنَّم","تُسامانِ ضَيماً مُستَبيناً فَتَنظُرا",19,"ر",2,0],["في إِرَتَي فَيلَقضينِ بَينَهُما","من غَيرِ نَارش القَوَابِسِ الشُّهُبُ",20,"ب",1,0],["فيا رَبِّ هَل إِلاّ بِكَ النَّصرُ نَبتَغِي","عَلَيهِم وهَل إلاّ عَلَيكَ المُعَوَّلُ",21,"ل",1,0],["فيا رَبِّ عَجِّل ما نُؤَمِلُ فِيهُم","لِيَدفَأَ مَقرُورٌ وَيَشبَعَ مُرمِلُ",21,"ل",1,0],["في ارثي فيلقين بينهما","من غيرنا والقوابس الشهب",22,"ب",1,0],["فيا رشأ الأتراكِ لا سربَ عامرٍ","فؤاديَ من سكنَى السلوِّ خراب",23,"ب",1,0],["فيا رب خلد ملك من لحظُ طرفه","يرى كل يومٍ منه وجه بشير",24,"ر",1,0],["فيا ربنا أكرِمْ أباه بثُكلهِ","ووالله ما يَسْوَى ثوابَ مصيبتِهْ",25,"ت",2,0],["فَيا رِياحَ الخَريفِ العاتِياتِ كَفى","عَصفاً فَقَد كَثُرَت في الأَرضِ قَتلاكِ",26,"ك",1,0],["فَيارَسولي تَضَرَّع في السُؤالِ لَهُ","عَساكَ تَعطِفُهُ نَحوي وَتَثنيهِ",27,"ي",2,0],["فَيا رَبُّ سَلِّم قَدَّهُ مِن جُفونِهِ","فَيا طالَما أَعدى الصَحيحَ سَقيمُ",28,"م",1,0],["فَيا رَسولي إِلى مَن لا أَبوحُ بِهِ","إِنَّ المُهِمّاتِ فيها يُعرَفُ الرَجُلُ",29,"ل",1,0],["فَيا رَبَّ لا يَصدُق حَديثٌ سَمِعتُهُ","لَقَد راعَ قَلبي ماجَرى في مَسامِعي",30,"ع",2,0],["فَيا راحِلاً لَم أَدرِ كَيفَ رَحيلُهُ","لِما راعَني مِن خَطبِهِ المُتَسَرِّعِ",31,"ع",1,0],["فَيا رُبَّ مَن يُدني وَيَحسِبُ أَنَّهُ","يَوَدُّكَ وَالنائي أَوَدُّ وَأَنصَحُ",32,"ح",1,0],["فَيا رُبَّ أَيّامٍ شَهِدتَ عَصيبَةٍ","وَقائِعُها مَشهورَةٌ وَالمَلاحِمُ",33,"م",1,0],["في أَريَحِيِّ ماجِدٍ مُستَعظَمٌ","رُزءُ المَمالِكِ فيهِ وَالأَمصارِ",34,"ر",1,0],["فَيا رَعى اللَهُ وَفداً بَينَ أَعيُنِنا","وَيَرحَمُ اللَهُ ذاكَ الوَفدُ ما رَحِما",35,"م",2,0],["فَيا رُبَّ وَجهٍ كَصافي النَميرِ","تَشابَهَ حامِلُهُ وَالنَمِر",36,"ر",1,0],["فيا رُفقة تُزجِي الرِكابَ طلائحاً","سقَتْهَا الغوادِي رُفقةً ورِكابَا",37,"ب",2,0],["فَيا رَبِّ إِن تَغفِر لَنا لَيلَةَ النَقا","فَكُلُّ ذُنوبي أَنتَ يا رَبِّ غافِرُه",38,"ر",2,0],["فَيا رَبِّ هَب لي مِنكَ حِلماً فَإِنَّني","أَرى الحِلمَ لَم يَندَم عَلَيهِ حَليمُ",39,"م",1,0],["فَيا رَبِّ إِنَّ الناسَ لا يُنصِفونَني","وَكَيفَ وَلَو أَنصَفتُهُم ظَلَموني",40,"ن",2,0],["فَيا رَبُّ قَد وافاكَ ذا أَمَلٍ فَجُد","عَليهِ بِرُضوانٍ فَإِنَّكَ مالِكُ",41,"ك",1,0],["فيا رِقَّةً سُكِبَت في النفوس","كما تُسكبُ الخمرةُ القاهره",42,"ر",2,0],["فيا رَبّ عَفْوَكَ عن مُذنبٍ","يخافُ لقاءَكَ بَعْد الحِمامِ",43,"م",1,0],["فيا ريحُ إنّ الرّوح فيكِ فعلّلي","به ساهراً وقفاً على ذِكْرِ نائمِ",44,"م",1,0],["فيا ربِّ إنّ البينَ أضحت صُرُوفُهُ","عليّ وما لي من معينٍ فكنْ معي",45,"ي",1,0],["فيا ربِّ إنِّي في الخضوع لقائلٌ","ذنوبي عُيوبي يوْم ألقاك فاسترها",46,"ر",3,0],["فَيَا رَحْمَةَ اللَّهِ اسْتَهِلِّي عَلَيْهِمَا","بِسَجْلَيْنِ لِلرِّضْوَانِ يَنْهَمِلانِ",47,"ن",1,0],["فَيَا رَبَّةَ الْبَيْتِ الْمَنِيعِ جِوَارُهُ","أَمَا مِنْ مُسَامٍ عِنْدَكُمْ فَأُسِيمُ",48,"م",1,0],["فَيَا رَبَّةَ الْقَبْرِ الْكَرِيمِ بِمَا حَوَى","وَقَتْكِ الرَّدَى نَفْسِي وَأَيْنَ وَقَلَّمَا",49,"م",2,0],["فَيَا رَبَّةَ الْخَالِ الَّتِي هَدَرَتْ دَمِي","وَأَلْقَتْ إِلَى أَيْدِي الْفِرَاقِ شَكَائِمِي",50,"م",2,0],["فَيَا رَبُّ هَبْ لِي مِنْ لَدُنْكَ تَصَبُّرَاً","عَلَى مَا أُقَاسِيهِ وَخُذْهُمْ بِزَلْزَالِ",51,"ل",1,0],["فَيا رُبَّ وَضّاحِ المَحاسِنِ أَشقَرٍ","رَمَيتُ بِهِ الهَيجا وَقَد فَغَرَت فَما",52,"م",2,0],["فَيا رُبَّ حَيَّةِ وادٍ رَقى","هُناكَ وَرُقعَةِ وَشيٍ رَقَم",53,"م",1,0],["فَيا راكِباً يُزجي المَطِيَّ عَلى الوَجى","وَيَخبِطُ أَنفاسَ الرِياحِ النَواسِمِ",54,"م",1,0],["فَيا رَبِّ إِن صَيَّرتَ لَيلى ضَجيعَتي","أُطيلُ صِيامي دائِماً وَصَلاتِيا",55,"ي",2,0],["فَيا رَبِّ قَرِّب لي أَسالَ أَحِبَّتي","وَنِلني المُنى يا عالِماً وَخَبيرُ",56,"ر",1,0],["فَيا رَبَّ سَوِّ الحُبَّ بَيني وَبَينَها","يَكونُ كِفافا لا عَلَيَّ وَلا لِيا",57,"ي",2,0],["فَيا رَبِّ إِن زادَت بَقيَّةُ ذَنبِها","عَلى أَجرِها فَاِنقُص لَها مِن كِتابِيا",57,"ي",2,0],["فَيا راكِبَ الوَجناءِ أُبتَ مُسَلِّماً","وَلا زِلتَ مِن رَيبِ الحَوادِثِ في سَترِ",58,"ر",1,0],["فَيا رَبِّ هَب نَفسي لِنَفسي وَداوِني","بِلَيلى لِتُجلى كُربَةٌ وَزَفيرُ",59,"ر",1,0],["فَيا رَبِّ بِالبَيتِ العَتيقِ وَما ثَوى","بِيَثرِبَ مِن قَبرٍ لَهُ الروحُ خادِمُ",60,"م",1,0],["فيا ربِّ هل للشّعرِ بعدي خليفةٌ","يقوم به إن غيَّبتني الصَّفائحُ",61,"ح",1,0],["فَيَا رَبِيعاً لِقَلبِي إن سَمَحتَ بِهِ","فَلَيسَ بِدعاً رَبِيعٌ جَاءَ عن مَطَرِ",62,"ر",1,0],["فَيارَبِّ إِن حانَت وَفاتي فَلا تَكُن","عَلى شَرجَعٍ يُعلى بِدُكنِ المَطارِفِ",63,"ف",1,0],["في إِرثِ عادِيَةٍ عَزٍّ وَمَكرُمَةٌ","فيها مِنَ اللَهِ صُنعٌ غَيرُ ذي خَلَلِ",64,"ل",1,0],["فَيا رُبَّ لَيلٍ لا يُرَجّى صَباحُهُ","تَحَمَّلتُ فيهِ ما كَرِهتُ كَما تَهوى",65,"ا",1,0],["في أريَحِيّاتٍ كرَيْعانِ الصِّبَا","حَركاتُها وعلى النُّهى إسْكانها",66,"ن",3,0],["فَيا رُبَّ خَمّارٍ طَرَقتُ بِسُحرَةٍ","فَنَبَّهتُهُ وَالطَيرُ في كَنَفِ الوَكرِ",67,"ر",1,0],["فَيا رَبَّ قَد أَحسَنتَ عَوداً وَبِدأَةً","إِلَيَّ فَلَم يَنهَض بِإِحسانِكَ الشُكرُ",68,"ر",1,0],["فَيا رَبُّ إِلَيكَ المُش","تَكى تيهُ الطَواويسِ",69,"س",1,0],["فَيا راحَةَ النَفسِ عِندَ المَما","تِ إِن كانَ هَذا الحِسابُ اِنفَصَل",70,"ل",1,0],["فَيا رُبَّ طاهي صِلالٍ يَبيتُ","مُتَّخِذاً طَعمَهُ يَطهُوانِ",71,"ن",1,0],["فيا رَكْبَ المَنُونِ أمَا رَسُولٌ","يُبَلّغُ رُوحَها أرَجَ السّلامِ",72,"م",1,0],["فيا رَبّ لا يَمْرُرْ بدارٍ يحُلّها","من المُزْنِ إلا خالِياتُ جَهامهِ",73,"م",2,0],["فَيا راكِباً إِمّا عَرَضتَ فَبَلِّغَن","بَني كاهِلٍ شاهَ الوُجوهُ لِكاهِلِ",74,"ل",1,1],["فَيا رَب في بغداد قد كثر الأذى","وَيا رب في بغداد قد ضجر الخلق",75,"ق",1,0],["فيا رديّ العقل إن الفتى","لم يدفع المقدور حتى ردي",76,"د",2,0],["فيا رَكْباً غَدَتْ بِهِمُ رِكابٌ","تُنَصّ على غَوارِبِها الرّحال",77,"ل",1,0],["فَيا رَبِّ سَوّي الحُبَّ بَيني وَبَينَها","يَكونُ كَفافاً لا عَلَيَّ وَلا لِيا",78,"ي",2,0],["فَيا رَبِّ إِذ صَيَّرتَ لَيلى هِيَ المُنى","فَزِنّي بِعَينَيها كَما زِنتَها لِيا",78,"ي",2,0],["فَيا رَبِّ إِن أَهلَك وَلَم ت