كَبّ وفي النُّجُدِ",135,"د",1,0],["والرملة ُ الدمثُ في ضوءٍ من القَمَرِ","والمدرجُ السَمحُ بين السُوح والحُجَرِ",136,"ر",1,0],["والراهنِ السابِريَّ الخزَّفي قدحٍ","والملهِمِ الفنَّ من لهوٍ أفانين",137,"ن",1,0],["والراهناتُ بجسمي يَنْتَبِشن به","نبشَ الهوامِ ضريحاً كلَّ مدفون",137,"ن",1,0],["وَالريحُ تَعبَثُ بِالغُصونِ وَقَد جَرى","ذَهَبُ الأَصيلِ عَلى لُجَينِ الماءِ",138,"ا",2,0],["وَالرَوضُ وَجهٌ أَزهَرٌ وَالظُلُّ فَرعٌ","أَسوَدٌ وَالماءُ ثَغرٌ أَشنَبُ",139,"ب",1,0],["وَالريحُ تَنخُلُ مِن رَذاذٍ لُؤلُؤاً","رَطباً وَتَفتِقُ مِن غَمامٍ عَنبَرا",140,"ر",2,0],["وَالريحُ تَنفُضُ بُكرَةً لِمَمَ الرُبى","وَالطَلُّ يَنضَحُ أَوجُهَ الأَشجارِ",141,"ر",1,0],["وَالريحُ تَلطِمُ فيهِ أَردافَ الرُبى","لَعِباً وَتَلثِمُ أَوجُهَ الأَزهارِ",142,"ر",1,0],["وَالريحُ تَلوي عِطفَ كُلِّ أَراكَةٍ","لَيَّ السَرى وَهناً لِعِطفِ الناعِسِ",143,"س",1,0],["والرَّادعُ الأحداثَ تَلتهِمُ القُوى","وتُغادِرُ البَطَلَ الشُّجاعَ جَبانا",144,"ن",2,0],["والرّاصداتُ لها تَبِيتُ عُيونُها","يَقظَى إذا أخذ البِحارَ رُقادُ",145,"د",1,0],["وَالرِفقُ مِن خَيرِ الأَزمَّةِ لِلفَتى","فيما يَروضُ مِنَ الأُمورِ وَيُركَبُ",146,"ب",1,0],["وَالرَأيُ أَسطَعُ ما يَكونُ إِذا اِنجَلَت","شُبُهاتُهُ وَأَضاءَهُ البُرهانُ",147,"ن",1,0],["والرّهطُ من غَطفان يَنظُر واجماً","حِيناً ويهدرُ عاتِباً أو لاحِيا",148,"ي",2,0],["وَالربا رَبكم لَهُ صَنَم الحر","ص مِثالٌ أَنتُم عَلَيهِ جثوم",149,"م",1,0],["وَالريحُ تَجذِبُ أَطرافَ الرِداءِ كَما","أَفضى الشَقيقُ إِلى تَنبيهِ وَسنانِ",150,"ن",1,0],["وَالرَعدُ يَحدو ظَعنَهُ","فَإِذا تَأَخَّرَ عَنَّفا",151,"ف",2,0],["وَالرَوضُ مَغسولٌ بِلَيلٍ مُمطِرِ","كَأَنَّهُ دَراهِمٌ في مَنشَرِ",152,"ر",1,0],["وَالريحُ قَد باحَت بِأَسرارِ النَدى","وَتَنَفَّسَ الرَيحانُ بِالجَنّاتِ",153,"ت",1,0],["والرائد الرادة العصارة إذا","زالت عرى الهام عن معاقلها",154,"ل",3,0],["والرّيحُ تَبعَثُ أنفاساً مُعَطَّرَةً","مثلَ العبيرِ بماءِ الوَرد يختلطِ",155,"ط",1,0],["وَالرُقاشيُّ مِن تَكَرُّمِهِ تَج","زَءُ أَمعائُهُ بِإِنشادِ شِعرِ",156,"ر",1,0],["وَالرَبِلاتُ المِيثُ وَالظُهورُ","وَالكُوَّمُ الباقي بِها تَفقيرُ",157,"ر",1,0],["وَالريحُ مُرسَلَةٌ وَالماءُ مُنصَلِتٌ","وَأَنتَ مُرتَفِقٌ وَالسَيرُ مُنجَرِدُ",158,"د",1,0],["وَالراكِضاتِ ذُيولَ الرَيطِ فانَقَها","بَردُ الهَواجِرِ كَالغِزلانِ بِالجَرَدِ",159,"د",1,0],["وَالرَملُ يُشبِهُ في أَعدادِهِ خَطَئي","فَما أَهُمُّ لَهُ يَوماً بِإِحصاءِ",160,"ا",2,0],["وَالرِزقُ يَأتي وَلَم تُبسَط إِلَيهِ يَدي","سِيّانِ في ذاكَ إِدنائي وَإِقصائي",160,"ي",1,0],["وَالروحُ أَرضِيَّةٌ في رَأيِ طائِفَةٍ","وَعِندَ قَومٍ تَرقّى في السَماواتِ",161,"ت",1,0],["وَالروحُ شَيءٌ لَطيفٌ لَيسَ يُدرِكُهُ","عَقلٌ وَيَسكُنُ مِن جِسمِ الفَتى حَرَجا",162,"ج",2,0],["وَالرَوحُ في حُبِّ دُنياها مُعَذَّبَةٌ","حَتّى يُقالُ لَها بِيني عَنِ الجَسَدِ",163,"د",1,0],["وَالرُزءُ يُبدي لِلكَريمِ فَضيلَةً","كَالمِسكِ تَرفَعُ نَشرَهُ الأَفهارُ",164,"ر",1,0],["وَالرَجلُ إِن حَلَّ خِدرَ غانِيَةٍ","كَالرِجلِ في المَشيِ حَلَّها خَدَرُ",165,"ر",1,0],["وَالرَبُّ لَم يَزدَد وَلا هُوَ ناقِصٌ","ما قَلَّ مُلكُ إِلهِنا فَيُكَثَّرا",166,"ر",2,0],["وَالرَملَةُ البَيضاءُ غودِرَ أَهلُها","بَعدَ الرَفاغَةِ يَأكُلونَ قِفارَها",167,"ر",3,0],["وَالراحُ تَجعَلُ مُرَّ العَيشِ عِندَهُمُ","حُلواً وَقَد ذَكَّرَتهُم أَوَّلَ المَقِرِ",168,"ر",1,0],["وَالرَأيُ أَن تَدَعوا الصَوارِمَ كُلَّها","بِقُرى المَشارِفِ وَالرِماحَ بِسَمهَرِ",169,"ر",1,0],["وَالرَزايا زَوائِري بِاِختِياري","وَسِواهُنَّ بَعدَ ذاكَ الرَوازي",170,"ي",1,0],["وَالروحُ طائِرٌ مَحبَسٍ في سِجنِهِ","حَتّى يَمُنَّ رَداهُ بِالإِطلاقِ",171,"ق",1,0],["وَالرَأيُ أَن تَبعَثَ الأَنضاءُ واحِدَةً","إِلى دِمَشقَ فَبِئسَ الدارُ بيسانُ",172,"ن",1,0],["وَالرُفقُ بِالنَفسِ لَدى بَينِها","عَن جَسَدٍ ظَلَّت بِهِ تَسكُنُ",173,"ن",1,0],["وَالرِزقُ يُقسَمُ ما فَتكي بِمُنتَقِصي","حَظّاً وَلا النُسكُ في المَكروهِ أَهواني",174,"ن",2,0],["والرّاحُ إنْ قيل ابنةُ العِنَبِ اكتفت","بأبٍ عن الأسماء والأوْصافِ",175,"ف",1,0],["وَالرأي يحسم غربه","ما لَيسَ تحسمه السيوف",176,"ف",1,0],["والرأي إن كان عن حب بصاحبه","فَلَيسَ ينفع في تمحيصه الجدل",177,"ل",1,0],["والرزق مقسوم فياسر ولا","تطلبه بالرمح والسيف",178,"ف",1,0],["والرّومُ ساكِنةُ الأطرافِ جاعِلةٌ","سِهامَها لوَقودِ الحَربِ كِبْريتا",179,"ت",2,0],["والرزق لا يحرمه عبد سعى","مضيقا عليه أو موسَّعا",180,"ع",2,0],["والرزق بين الناس بحرٌ جار","شراعه يرفع للتجّار",180,"ر",1,0],["والرافع الدّولات ركناً ركنا","بالحق بنيان الخليل الرّكنا",181,"ن",2,0],["والرأي مثل العهد في الجليل","يرعاه من يرعاه في القليل",182,"ل",1,0],["وَالرَأيُ لَم يُنضَ المُهَنَّدُ دونَهُ","كَالسَيفِ لَم تَضرِب بِهِ الآراءُ",183,"ا",2,0],["وَالرُسلُ دونَ العَرشِ لَم يُؤذَن لَهُم","حاشا لِغَيرِكَ مَوعِدٌ وَلِقاءُ",183,"ا",2,0],["والرزق سر لم يُنَل مكنونه","ضنت به كاف السماح ونونه",184,"ه",1,0],["والرابعُ الساكِنُ إذْ يَزُولُ","فذلكَ المَطويُّ لا يَحولُ",185,"ل",1,0],["والرِّيحُ تَعْصِفُ بالورود","فعِشْتُ سُخْرِيَةَ الخُطوب",186,"ب",1,0],["وَالرَّبَربُ الَمكفُوفُ أَردانُهُ","يَمشي رُوَيداً كَتَوَقِّي الرَّهيص",187,"ص",1,0],["وَالرَّوْضُ يَرْفُلُ فِي مُعَصْفَرَةٍ","بِالزَّهْرِ لِلأَبْصَارِ تَخْتَطِفُ",188,"ف",1,0],["وَالرِّيحُ تَمْحُو سُطُوراً ثُمَّ تُثْبِتُهَا","فِي النَّهْرِ لا صِحَّةٌ فِيها وَلا غَلَطُ",189,"ط",1,0],["وَالرَّاعِدَاتِ كَأَنَّهَا","صَعَقَاتُ مُوسَى فِي القِدَمْ",190,"م",1,0],["وَالرِّيحُ تَحْضُنُ آخِرَ","النَّغَمَاتِ حَضْنَ المُرْضِعِ",191,"ع",1,0],["وَالرُّوسُ مِنْ جَانِبٍ ثَانٍ تُلِمُّ بِهِ","إِلمَامَ غَيْرِ محِبٍّ قُرْبهُ لَدَدُ",192,"د",1,0],["وَالرَّوْضُ مِنْ نَسْجِ النَّوَى","وَالنورُ لِلْبرْدِ الغَوَالِي",193,"ل",2,0],["والرياحين في الجنائن من هم","غارسوها لكم سوى الفقراء",194,"ا",2,0],["والرغبات يستعر","أو الرمل الذي تلمع",195,"ع",1,0],["والرُّكْنُ لو اِنّك لامِسُهُ","لاِبيَضّ بكفّكَ أَسْوَدُهُ",196,"د",2,0],["والراح للهمّ أَنقاها فخذ طرفاً","مِنها وَدع أمّة فِي شربها قدحوا",197,"ح",3,0],["وَالرَوحُ مُستَوفِزٌ بِجِسمي","لَهُ عَلى الإِنتِقالِ عَزمُ",198,"م",1,0],["وَآلُ رَسولِ اللَهِ تَدمى نُحورُهُم","وَآلُ زِيادٍ رَبَّةُ الحَجَلاتِ",199,"ت",1,0],["وَآلُ رَسولِ اللَهِ تُسبى حَريمُهُم","وَآلُ زِيادٍ آمِنوا السَرَباتِ",199,"ت",1,0],["وَآلُ رَسولِ اللَهِ نُحفٌ جُسومُهُم","وَآلُ زِيادٍ غُلَّظُ القَصَراتِ",199,"ت",1,0],["والرواياتُ أعجزتْ كلّ شيطا","نٍ وأعيت في وصفِها شيطاني",200,"ي",1,0],["والرّوَايَاتُ أدْهَشَتْ كلَّ لُبٍ","ثُمَّ أَرْبَتْ فَأَدْهَشَتْ شَيْطَانَه",201,"ن",2,0],["والرِّياحُ الرِّياحُ تَعْصِفُ بِالْمِسِكينِ","عَصْفَ الأيّامِ بالآجالِ",202,"ل",1,0],["والرَّوضُ يَصْدَحُ بالبَشائِرِ أيْكُهُ","فالعُودُ عُودٌ والأَزاهِرُ مِزْهَرُ",203,"ر",1,0],["والرضابُ الْحلُو لو جدتِ به","فيه للأنفس رِيٌّ وشفاء",204,"ا",2,0],["وَالروْضُ إِنْ صَدَحَتْ بَلاَ","بِلُهُ صَدَحْنَ بِغَيْرِ كَدِّ",205,"د",1,0],["والرملُ يزخَرُ في هَوْلٍ وفي سَعَةٍ","كالبحرِ يزخَرُ بالأمواج مشحونا",206,"ن",2,0],["والروح يوم الزحف قد","تغني عن العدد العديد",207,"د",1,0],["والرمل يكتنف بالمياه، كأنما","هي فضَّةٌ محفوفة بنُضار",208,"ر",1,0],["والرِّيمُ يَظهر حسنهُ","في القاع لا في خِدره",209,"ر",2,0],["والرفد ما بين مرفض ومنكسب","والوفد ما بين منفض ومنزحم",210,"م",1,0],["والريح تحسبها كصائد لجة","يرمي على صفح الغدير شياكا",211,"ك",2,0],["والروم فارم بكلِّ رجم ثاقبٍ","يُذكي بأربعِها شُواظ لهيب",212,"ب",1,0],["والروض يجلو عذاره وقد لبست","عقائل الورق ديباجا من الورق",213,"ق",1,0],["والريحُ خلِّيها اذا صفِرَت","في البيت تُوسِعُ من به فَرقَا",214,"ق",2,0],["والروض شعَارٌ له من وَردِه","نَفَسٌ ومن سجعِ الطيور قريضه",215,"ض",2,0],["والرزايا تعِنُّ بين تليد","مُعجزٍ حلُّه وبينَ طَريف",216,"ف",1,0],["والرابضونَ كآسادِ الشرى فاذا","هِيجوا رأيتَ المنايا كيف تندفع",217,"ع",1,0],["والرافدان تماوجا حتى لقد","أشفقت أن يثبأ على الأسداد",218,"د",1,0],["والريحُ وراءَك عائرة","ٌ في الأيْنِ تُكَبّ وفي النُّجُد",219,"د",1,0],["والرجاء الذي يصير به الفد","فد روضا ، وشوكه نسرينا",220,"ن",2,0],["والروضُ في قِطَعِ الزَّبَرْجَدِ والْ","ياقوتُ تحت لآلىء ٍ تُؤم",221,"م",1,0],["والرِّمم البالية الهوامدا","ثِقلاً على الظهر ثقيلاً كاسدا",222,"د",2,0],["وآلُ رسولِ اللهِ تسبى حريمهمْ","وآل زيادٍ أمنو السرباتِ",223,"ت",1,0],["والرملُ حالٍ بالضحى مذهبٌ","يُصدِّىء ُ الظلُّ سَبيكاتِه",224,"ت",2,0],["والروضُ أخرسُ غير وسوية ٍ","خَفَقَ الغصونِ، وجرْية الغُدْر",225,"ر",1,0]]}