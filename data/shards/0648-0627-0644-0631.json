,[46,"أما الحقيقة فهي أني ذاهب","https://www.aldiwan.net/poem23058.html","الكامل"],[46,"يخبرونك عن رب العلى كذبا","https://www.aldiwan.net/poem23452.html","البسيط"],[46,"لباسي البرس فلا أخضر","https://www.aldiwan.net/poem23460.html","السريع"],[46,"الدهر لونان أعيا ثالث لهما","https://www.aldiwan.net/poem23519.html","البسيط"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147608","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20991","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55182","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141953","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43907","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9506","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[77,"بشرى تقوم لها الدنيا على قدم","https://www.poetsgate.com/ViewPoem.aspx?id=34158",""],[77,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=179088",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[80,"صادَتْكَ مهاة ٌ لم تُصَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=3157",""],[91,"ماء وطين","https://www.poetsgate.com/ViewPoem.aspx?id=53341",""],[51,"ضحكَ الربيعُ إلى بكا الدِّيمِ","https://www.poetsgate.com/ViewPoem.aspx?id=30456",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[54,"تَجَاوَبنَ بالإرنانِ وَالزَّفراتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16977&r=&rc=1",""],[85,"مُنتَزَهُ العبَاسِ للمجتلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9734&r=&rc=224",""],[85,"قلبٌ يذوب ، ومدمعٌ يجري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9553&r=&rc=43",""]],"verses":[["وَالرَكبُ في مَضَلَّةٍ","لا نَضَدٌ وَلا عَلَم",0,"م",1,0],["وَالراكِبينَ المَطايا وَالجِيادَ مَعاً","لا الشَكلُ تَحبِسُها يَوماً وَلا العُقُلُ",1,"ل",1,0],["وَالراجِمَينَ جِمارَها بِمِنىً","غَدواً وَما حَلَقوا وَما قَصّوا",2,"ص",3,0],["وَالرائِحاتِ إِلى جَمعٍ مُحَزَّمَةً","مَرَّ اليَمامِ دَعا أَورادَها الصَدَرُ",3,"ر",1,0],["وَالرَوضُ مِن حالٍ عَليهِ وَعاطِلٍ","وَالمُزنُ مِن غادٍ عَلَيهِ وَسارِ",4,"ر",1,0],["وَالريحُ تَلعَبُ بِالذَوا","بِلِ وَهيَ تَطعَنُ في الصُدورِ",5,"ر",1,0],["وَالرِّيحُ إِن نَسَمَتْ عُلويَّةً نَضَحَتْ","بِالدَّمعِ حَنَّةَ عُلويٍّ إِلى الوَطَنِ",6,"ن",1,0],["وَالرَّكبُ يَسرونَ وَالظَّلماءُ عاكِفَةٌ","كَأَنَّهُم في ضَميرِ اللَّيلِ أَسرارُ",7,"ر",1,0],["وَالرَّكْبُ مِنْ دَهَشِ النَّوَى في حَيْرَةٍ","لا راقِدُونَ وَلا هُمُ أَيْقاظُ",8,"ظ",1,0],["والريحُ والِهَةٌ حَيْرى تَلوذُ بهِ","حيثُ النّسيمُ يَروعُ التُّرْبَ وادِعُهُ",9,"ع",2,0],["والرَّكْبُ بالقاعِ يَسْري في عُيونِهمُ","كَرىً يَدِبُّ على آثارِهِ السّأَمُ",10,"م",1,0],["والرّوضُ مَطْلولٌ يَميدُ زَهْرُهُ","تحتَ حَصى المَرْجانِ منْ قَطْرِ الندىً",11,"ا",1,0],["والرّوضُ في أفوافِهِ مُتَبرِّجٌ","والزَّهْرُ في حُلَلِ السِّحائِبِ رافِلُ",12,"ل",1,0],["والرّايةُ السّوداءُ يخفُقُ ظِلُّها","والرُّعْبُ يَطلُعُ والتّجَلُّدُ آفِلُ",12,"ل",1,0],["والرُّعْبُ يَسْتَلِبُ الشُّجاعَ فؤادَهُ","ويَغُصُّ منْ كَلِماتِهِ المِنْطيقُ",13,"ق",1,0],["والرِّيحُ أيقَظَتِ الرِّياضَ وَلِلْحَيا","فيها إذا رَقَدَ العَرارُ شَهيقُ",13,"ق",1,0],["والرَّوضُ ألبَسَهُ الرَّبيعُ وشَائِعاً","عُنِيَ السِّماكُ بِوَشْيِها والمِرْزَمُ",14,"م",1,0],["وَالرَجلُ حافِيَةٌ وَلا لي مَركَبٌ","وَالكَفُّ صِفرٌ وَالطَريقُ مَخوفُ",15,"ف",1,0],["والرّوضُ يجْلو عِذارِيَهْ وقدْ لبِسَتْ","عَقائِلُ الوُرْقِ دِيباجاً منَ الوَرَقِ",16,"ق",1,0],["وَالرِّضَى بِاللهِ وَالشُّكْرُ لَهُ","يَبْسُطُ الآمَالَ مَهْمَا انْقَبَضَتْ",17,"ت",1,0],["والرِّفْدُ مَا بَيْنَ مُرْفَضٍّ وَمُنْسَكِبٍ","وَالْوَفْدُ مَا بَيْنَ مُنْفَضٍّ وَمُنْزَحِمِ",18,"م",1,0],["وَالرُّسْلُ تَتْرَى وَلاَ تَخْفَى نَتَائِجُها","عِنْدَ التَّأَمُّلِ مِنْ قَوْلٍ وَلاَ عَمَلِ",19,"ل",1,0],["وَالرُّعْبُ بَيْنَ يَدَيْكَ يُرْدِفٌ جَحْفَلاً","مِنْهُ عَلَى بُعْدِ الْمَسَافَةِ جَحْفَلُ",20,"ل",1,0],["وَالرُّوحُ رُوحُ اللهِ يَنْفُذُ حُكْمُهُ","لَكَ وَالْمَلاَئِكَةُ الْكِرَامُ تَنَزُّلُ",20,"ل",1,0],["وَالرَّومُ لاِسْتْرِجَاعِ حَقِّكَ شَمَّرَت","هَذَا هُوَ النَّصْرُ المُعِمُّ الْمُخْوِلُ",20,"ل",1,0],["وَالرِّيحُ تَحْسِبُهَا كَصَائِدِ لُجَّةٍ","يَرْمِي عَلَى صَفْحِ الْغَدِيرِ شِبَاكَا",21,"ك",2,0],["وَالُّرومَ فَارمِ بِكُلِّ نَجْمٍ ثَاقِبٍ","يُذْكِي بِأَرْبُعِهَا شُوَاظَ لَهِيبِ",22,"ب",1,0],["وَالريحُ تَخفِضُهُ طوراً وَتَرفَعُهُ","طوراً فمُنخَفِضاً يَدعو وَمُرتَفِعا",23,"ع",2,0],["وَالرِجلُ كَالرَوضَةِ المِحلالِ زَيَّنَها","نَبتُ الخَريفِ وَكانَت قَبلُ مِعشابا",24,"ب",2,0],["وَالرِزقُ يَأتي وَإِن لَم يَسعَ صاحِبُهُ","حَتماً وَلكِن شَقاءُ المَرءِ مَكتوبُ",25,"ب",1,0],["وَالرَوضِ قَد رَقَمَت وَشا","ئِعَ بُردِهِ كَفُّ الغَمائِم",26,"م",1,0],["وَالرَوضُ عَن مائِهِ الفِضِيِّ مُبتَسِمٌ","كَما شَقَقتَ عَنِ اللَبّاتِ أَطواقا",27,"ق",2,0],["وَالرافِعين بِناءَهُم","فَتَراهُ أَشمَخَ مُشمَخِرّا",28,"ر",2,0],["والروض قد سامى السماء لحسنه","لما ازدهى بالنهر والأزهار",29,"ر",1,0],["والرسول مؤتمراً","والجماد ينفصل",30,"ل",1,0],["والروض مهديةٌ إليك سلامها","فتسمعي ما يحمل الإنشاد",31,"د",1,0],["وَالرَّمْزُ بَاقٍ وَذَاكَ الصَّوْتُ نَسْمَعُهُ","مَهْمَا تَنَوَّعَتِ الأَصْوَاتُ وَالْكَلِمُ",32,"م",1,0],["وَالرَّأْيُ قَدْ أَثْبَتُّمُوهُ بَالِغاً","فِي النُّجْحِ مَا لا يَبْلُغُ الصَّمْصَامُ",33,"م",1,0],["وَالرَّأْيَ قَدْ أَثْبَتُّمُوهُ بَالِغٌ","فِي النًّجْحِ مَا لا يَبْلُغُ الصَّمْصَامُ",34,"م",1,0],["والرِّدفُ مثلُ نَقَاً تلَ","بَّدَ فهو زُحلوقٌ زَلُوق",35,"ق",1,0],["وَالرَكبُ تَعلو بِهِم صُهبٌ يَمانِيَةٌ","فَيفاً عَلَيهِ لِذَيلِ الريحِ نَمنيمُ",36,"م",1,0],["وَالرِئمَ يُعيي وَالهَدوجَ الأَربَدا","مَثنى وَآجالاً بِها وَمُفَرِدا",37,"د",2,0],["والرياض ترولن عنّ","طيب شمائل عنبريّا",38,"ي",2,0],["والرياض ترولن عنوا","طيب شمائل عنبريا",39,"ي",2,0],["والروض مختالٌ بحلية سندسٍ","من كل مَوشيِّ الرقوم منمنَمِ",40,"م",1,0],["والروضُ ينفحُ من ثنائك طِيبَهُ","والوُرْقُ فيه بالممادح تهدلُ",41,"ل",1,0],["والريحُ تحمل عن ثنائك طيبها","في ملتقاها من ضباً وشَمَالِ",42,"ل",1,0],["والريح من برد الشتا صرصر","والجوّ يبدو عابساً مطرقا",43,"ق",2,0],["والرأي عند طريده والعلم عن","د غريبه والحكم عند دخيله",44,"ل",2,0],["والروم قد نزلت لهم عن مُلكها","والفُرس عمّا شيد من إيوانها",45,"ن",3,0],["والريح تجري وهي ريدانة","حيناً وحيناً عاصف زعزع",46,"ع",1,0],["وَالريحُ طَيِّبَةٌ إِذا اِستَقبَلتِها","وَالعِرضُ لا دَنِسٌ وَلا خَوّارُ",47,"ر",1,0],["وَالرِدفِ إِذ مَلَكَ المُلوكَ وَمَن لَهُ","عِظَمُ الدَسائِعِ كُلَّ يَومِ فِضالِ",48,"ل",1,0],["والرؤم الرفود ذا السرِّ منهن","علوقاً يسقينها وزجورا",49,"ر",2,0],["والرَّوَايَا التي بِهَا يَحمِلُ النَّا","سُ وُسُوقَ المُطَبَّعَاتِ العِظَامِ",50,"م",1,0],["والرَاكِبُ الطَالِبُ المُسَخَّرةُ ال","رِّيحُ له ناصِرَينِ والرُعُبُ",51,"ب",1,0],["والرأيُ نافذةٌ قضايا رسمهِ","من قبل ما نوت الإرادةَ راؤه",52,"ا",3,0],["والرَّاح هاديةُ السرور إلى الحشَا","مثل الكواكب في أكفِّ سقاتها",53,"ت",3,0],["والرَّاح في يدِ ساقيها مشعشعة","كأنَّ وجنة ساقِيها بها نضحت",54,"ت",1,0],["والرافع البخل في الدنيا وساكنها","بجود كفيه رفع الماء للنجس",55,"س",1,0],["وَالرَبُّ بَينَهُم في كُلِّ مُنقَلَبٍ","مُحِلُّ حالاتِهِم في كُلِّ ساعاتِ",56,"ت",1,0],["والرزقُ آتٍ بلا مطالبةٍ","سِيَّان مدفوعُهُ ومُجتذَبُهْ",57,"ب",2,0],["والرُّوحُ في الأموات منهم تُنْفخُ","مُذْ ساسهم منه أشمٌّ أبلخُ",58,"خ",1,0],["والربحُ أجمع في لقاء فتىً","بلقائه يُستخْلَفُ العُمْرُ",59,"ر",1,0],["والرفدُ يُمنَحَه الفتى حظاً له","واليأسُ يُكْساهُ أعزَّ لِباس",60,"س",1,0],["والرق في الإعتاق حكم للعلا","حكمت به والأسر في الإطلاق",61,"ق",1,0],["والرضابُ العذبُ من في","ك على فيَّ حرامُ",62,"م",1,0],["والروضُ في قِطَعِ الزَّبَرجَدِ والْ","ياقوتُ تحت لآلِئٍ تُؤمِ",63,"م",1,0],["وَالرِجلُ لاحِقَةٌ مِنها بِأَوَّلِها","وَفي يَدَيها إِذا اِستَعرَضتَها دَفَقُ",64,"ق",1,0],["وَالرَكبُ بَينَ مُصَفِّقٍ","وَمُهَلِّلٍ جَذلِ قَريرِ",65,"ر",1,0],["وَالريحُ تَخفُقُ حَولَهُم","وَكَأَنَّما هُم في قُصورِ",65,"ر",1,0],["وَالريحُ تَلتَقِطُ الشَذى وَتُذيعُهُ","مِن شيحِها طَوراً وَمِن قَيصومِها",66,"م",3,0],["وَالرَجاءَ الَّذي يَصيرُ بِهِ لفُد","فُدُ رَوضاً وَشَوكُهُ نِسرينا",67,"ن",2,0],["وَالرَوضُ إِنَّ الرَوضَ شاعِرٍ","سَمحٍ طَروبٍ رائِقٍ جَزلِ",68,"ل",1,0],["والرُّبى تَحلمُ في ظِلِّ","الغُصونِ المائِسَهْ",69,"ه",1,0],["والرَّبيعُ الجميلُ يرقُصُ فَوْقَ","الوردِ والعُشْبِ منْشِداً تيَّاها",70,"ه",2,0],["والرَّبيعُ الفنَّانُ شاعِرُها المفتونُ","يُغْري بحبِّها وهواها",70,"ه",2,0],["والرُّوحُ شُعلَةُ نُورٍ مِنْ","فوقِ كلِّ نِظامْ",71,"م",1,0],["والرياحينُ تَحْسَبُ الحسَكَ الشِّرِّيرَ","والدُّودَ من صُنوفِ الورودِ",72,"د",1,0],["والرَّبيعُ الجميلُ في هاته الدُّنيا","خريفٌ يُذْوي رفيفَ الوُرودِ",73,"د",1,0],["والروض ريان سقا","ه المستهل الوابل",74,"ل",1,0],["والروح ليس سوى الحياة تشاركت","زمراً خلايا الجسم فيها اجمع",75,"ع",1,0],["والريح ترسل من شذا","ها زلفة وفدا فوفدا",76,"د",2,0],["وَالريحُ في أَبوابِهِ وَالجَوا","ري مائِلاتٌ دونَ ساحاتِهِ",77,"ت",2,0],["وَالرَملُ حالٍ بِالضُحى مَذهَبٌ","يُصَدِّئُ الظِلُّ سَبيكاتِهِ",77,"ت",2,0],["وَالرَأيُ لِلتاريخِ فيكَ فَفي غَدٍ","يَزِنُ الرِجالَ وَيَنطِقُ الأَحكاما",78,"م",2,0],["وَالرَأيُ إِن أَخلَصتَ فيهِ سَريرَةً","مِثلُ العَقيدَةِ فَوقَ كُلِّ مِراءِ",79,"ا",2,0],["وَالرَوضُ أَخرَسُ غَيرَ وَسوَسَةٍ","خَفَقَ الغُصونِ وَجِريَةِ الغَدرِ",80,"ر",1,0],["وَالرَوضُ في حَجمِ الدُنا","وَالبَحرِ في حَجمِ الغَدير",81,"ر",1,0],["وَالرَعايا في نِعمَةٍ وَلِبَطلَي","موسَ في الأَرضِ دَولَةٌ عَلياءُ",82,"ا",2,0],["والرفق ثم الرفق بالنيرانِ","فإنها من أكبر الأعوانِ",83,"ن",1,0],["والروح إن خرجت فلا عوض","عنها فإنَّ الجسم قد رهقا",84,"ق",2,0],["والروح وهي عقارنا إن صادفت","مزجاً من الأجساد أنجب مرخُها",85,"خ",3,0],["والرطب يخلط بالصلابة مدة","فيصير صلباً يشبه الأحجارا",86,"ر",2,0],["والروح في التركيب غاضت فاغتدت","أجساده روحاً يروم مطارا",86,"ر",2,0],["والروح أباقة لخفتها","تطير في جوها وتستعلي",87,"ل",2,0],["والركبُ مِيلٌ على الأكوارِ من طَرِبٍ","صاحٍ وآخرَ من خمر الهوى ثَمِلِ",88,"ل",1,0],["والرأيُ يمضي حيثُ لا أسَلٌ","يمضي لِطيَّتهِ ولا بَطَلُ",89,"ل",1,0],["والركضُ يفتحُ فوقَ وجنتِهِ","ورْداً ويملأُ وردَهُ عَرَقَا",90,"ق",2,0],["والرميُ في الأحداقِ دَأْبُ رُمَاتِهمْ","والرامياتُ سِهامُها الأحداقُ",91,"ق",1,0],["والريحُ تطرُدُ عن مسيلِ عِذارِه","صُدغيهِ بين مسلسلٍ ومُشَوَّشِ",92,"ش",1,0],["وَالريقُ مِنها إِن تَجَرَّعتُهُ","خِلتُ نَسيمَ المِسكَةِ الأَزفَرِ",93,"ر",1,0],["وَالرومُ تَعلَمُ أَنَّ سَيفَكَ لَم يَزَل","حَتفاً لِصَيدِ مُلوكِها وَهَلاكا",94,"ك",2,0],["وَالرَأيُ كُلُّ الرَأيِ في قَتلِهِ","بِالسَيفِ وَاستِصفاءِ أَموالِهِ",95,"ل",2,0],["وَالراحُ غَضبى عَلَينا ما تُلِمُّ بِنا","فَاِشعَب لَنا شُعبَةً مِن ذَلِكَ النيلِ",96,"ل",1,0],["وَالرِزقُ لي دونَ مَن قَد باتَ وَهوَ لَهُ","لَو أَنَّ أَزكاهُ مَقسومٌ لِأَذكانا",97,"ن",2,0],["وَالرِزقُ لِليَقِظِ المُشَيَّعِ رَأيُهُ","بِالعَزمِ لالِلعاجِزِ المَأفونِ",98,"ن",1,0],["وَالرافِعينَ بِناءَ مَجدٍ لَم يَكُن","لِيَطولَهُ يَومَ التَفاخُرِ بانِ",99,"ن",1,0],["وَالرَقَّةُ البَيضاءُ كَالخَودِ الَّتي","تَختالُ بَينَ نَواعِمٍ أَقرانِ",100,"ن",1,0],["وَالراقِصاتِ بِكُلِّ مُبتَهَلٍ","مِن فَجِّ كُلِّ عَمايِقٍ غُبرِ",101,"ر",1,0],["والروض يشكر للنسيم","الغض ما فعل الغمام",102,"م",1,0],["والروم لم يبق السباء بأرضهم","ولدا ولم تبق الأسنة والدا",103,"د",2,0],["والرَّوْضُ قد راضَه الغَمامُ فقد","فَتَّحَ نُوَّارَه النَّدى الخَضِلُ",104,"ل",1,0],["والرَّعدُ يَسلُقُها بأل","سِنةٍ كألسنةِ العواذِل",105,"ل",1,0],["والرُّومُ تَبذُلُ ما رامَت أسِنَّتُه","وهَل لها بالمنايا أقبلتْ قِبَلُ",106,"ل",1,0],["والرمحُ أسرفَ جائراً في جائرٍ","طَعناً ونكَّبَ عادلاً عن عادِلِ",107,"ل",1,0],["والرِّياضَ التي ألحَّ عليها","كاذبُ الوَبْلِ صادِقُ الإحْراقِ",108,"ق",1,0],["والرّاحُ قد حملَتْ لها ريحُ الصَّبا","نَفَحاتِ مِسْكٍ بالعَبيرِ مُدافِ",109,"ف",1,0],["والرَّوْضُ قد نشرَ الحَيا أنماطَه","فكأنَّهُنَ غَرائبُ الأنماطِ",110,"ط",1,0],["والرَّاحُ قد أعَوزَتَنْا في صَبيحَتِنا","بَيْعاً ولو وَزنَ دينارٍ بدينارِ",111,"ر",1,0],["والرُّبا من شاطئِ النَّهرِ إذا","سَرَبَ الماءُ عليه وسَرَح",112,"ح",1,0],["والريح وسنى خلال الروض وانية","فما يراع لها مستيقظ الترب",113,"ب",1,0],["والرومُ تعلمُ أنَّ تاجَ زعيمِها","مُلقىً بحدِّ السّ