َرَى عَلِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=63608",""],[243,"ذبول أزهار الدفلى","https://www.poetsgate.com/ViewPoem.aspx?id=50480",""],[5660,"وَ الوَجدُ يَربَحُ وَ النَّوى تَقتاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=35775",""],[5664,"الجموح","https://www.poetsgate.com/ViewPoem.aspx?id=176695",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[5804,"لو أنتِ عندي","https://www.poetsgate.com/ViewPoem.aspx?id=180315",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5828,"وكأس من الشَّمْس مخلوقة","https://www.poetsgate.com/ViewPoem.aspx?id=190972",""],[5842,"رد ( الى بشار الاسد بعد خطابه الثاني ) / حسان الزا","https://www.poetsgate.com/ViewPoem.aspx?id=76594",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""],[5956,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=194844",""],[5975,"رد ( الى بشار الاسد بعد خطابه الثاني )","https://www.poetsgate.com/ViewPoem.aspx?id=76595",""],[6068,"عاجلتها بالشوق حتى كرهتها -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175881",""],[6068,"تعاتبني فيقهرني العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=179274",""],[520,"عنان اليالي في يديك مسلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577658",""],[563,"بلاء الأنبياء هو البلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56271&r=&rc=1",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""]],"verses":[["وَلَكِن تَبعُدُ الفَحشاءُ عَنّي","كَبُعدِ الأَرضِ عَن جَوِّ السَماءِ",0,"ا",2,0],["وَلَكِن تَجَنَّيتَ لَمّا مَلِلتَ","فَأَنشَأَتَ تَذكُرُ ما تَذكُرُ",1,"ر",1,0],["وَلَكِن تَعلَّم إِنها عَهدُ بَينِنا","فَبِن غَيرِ مَذمومٍ وَلَكِن مودَّعا",2,"ع",2,0],["وَلَكُنتَ يَومَ اللابِرِنتَ بِعَينِهِ","في عِزَّةٍ وَجَلالَةٍ وَسَماحِ",3,"ح",1,0],["وَلكِن تَحتَ ذَاكَ الشَيبِ حَزمٌ","إِذا ما ظَنَّ أَمرَضَ أَو أَصَابَا",4,"ب",2,0],["ولكن تلافى اللهُ أمرَ عباده","بوارثِهِ واللهُ بالنّاسِ أَزأَفُ",5,"ف",1,0],["ولكنَّ تطويقي لهىً ناصرية","تحث على أني أنوح وأسجع",6,"ع",1,0],["ولكن تنخَّلْتُ فيك الظنونَ","تَنَخُّليَ المدحَ فيك اللُّبابا",7,"ب",2,0],["ولكن تَصدَّتْ وانحرفتُ لحرفتي","ففاءت ولم تظلِم إلى خيرِ واهبِ",8,"ب",1,0],["وَلَكِن تُضرَبَ الأَمثالُ رُشداً","وَمِنهاجاً لِمَن شاءَ اِتِّباعا",9,"ع",2,0],["وَلَكِن تَحتَمي الآمالُ فيهِ","وَتَدَّرِعُ الحُقوقُ بِهِ اِدِّراعا",9,"ع",2,0],["وَلَكِن تَفوقُ الناسَ رَأياً وَحِكمَةً","كَما فُقتَهُم حالاً وَنَفساً وَمَحتِدا",10,"د",2,0],["وَلَكِن تَأخُذُ الآذانُ مِنهُ","عَلى قَدرِ القَرائِحِ وَالعُلومِ",11,"م",1,0],["ولكنْ تكاليفُ السيادةِ جَعْجَعَتْ","برحلي ودهرٌ بالحوادثِ رَابَا",12,"ب",2,0],["وَلَكِن تَنَحّى جَنبَةً بَعدَما دَنا","فَكانَ كَقَيدِ الرِمحِ بَل هُوَ أَنفَسُ",13,"س",1,0],["وَلَكِن تَرى لي غايَةُ المَجدِ سابِقاً","إِذا الخَيلُ قادَتها الجِيادُ مَعَ الفَحلِ",14,"ل",1,0],["وَلَكِن تَدَعّى مَن سِواهُم إِذا رَمى","إِلى الغَرَضِ الأَقصى البَعيدِ مُناضِلُه",15,"ل",2,0],["وَلَكِن تَسيلُ عَلَيها القُلوبُ","هَوىً وَتَذوبُ عَلَيها الحَدَق",16,"ق",1,0],["وَلَكِن تَرقُلُ الساعاتُ تَحتي","بَرِئنَ مِنَ التَمَكُّثِ وَالتَأَنّي",17,"ن",2,0],["وَلكِنْ تَعَالَتْ عَنْ إِجَابَةِ سُؤلِهِ","وَرَدَّتْ عَلَيْهِ المَالَ رَدَّ تَرَفُّعِ",18,"ع",1,0],["وَلَكِن تَلَقَّت بِاليَدَينِ ضَمانَتي","وَحَلَّ بِشَرجٍ مِنَ القَبائِلِ عُوَّدي",19,"د",2,0],["ولكنت تسفك ناظريك ليرتووا","وتذيب قلبك في يديك ليشبعوا",20,"ع",3,0],["ولكن تفشّى السُّعارُ، فكان","ضحيَّةَ هذا السُّعار الرخاء",21,"ا",2,0],["ولكنْ تلقّتْ باليدينِ ضمانَتي","وحلّ بشرجِم القبائلِ عودّي",22,"د",2,0],["ولكنْ تحت أغطيةٍ وماذا","ترى عينٌ لو انكشفَ الغِطاء",23,"ا",2,0],["ولكنتَ كالشعراءِ من أبنائه","ممَّنْ تُجوهلَ قدرُهُمْ فأُضيعا",24,"ع",2,0],["وَلَكن تَعللنا بِمَوعد مَن بَدا","وَدون مَحياهُ المُنير نَهار",25,"ر",1,0],["ولكن تجلَّى من قديم ظهوره","فطشتُ ولا أدري سبيلاً إلى ذيا",26,"ي",2,0],["ولكن تلاقي الحاسدين بمنطقٍ","ذليقٍ بوصف بشره لا يملهُ",27,"ل",2,0],["ولكن توليت الكفاية فيهما","فكلا توفي حقه وتزيده",28,"د",2,0],["ولكنت ألقى الله منه بقربة","معدودة من أعظم القربان",29,"ن",1,0],["وَلَكن تَجَنَّيتِ الذُّنُوبَ وَمَن يُرِد","يَجُذُّ القُوَى تُقدَر عَلَيهِ ذُنُوبُ",30,"ب",1,0],["وَلكِن تَعامى عَن هداهُ لِأَنَّهُ","أُصيبَ من الدُنيا بمسٍّ من الخَبلِ",31,"ل",1,0],["ولكنْ تُعرِب الأقلام عنّا","إذا افترقت بشَخْصَيْنا البِقاع",32,"ع",1,0],["وَلَكِن تَعرَّضَهُم ضَلَّةً","كِذابُ المُنى وَخِداعُ الأَمَل",33,"ل",1,0],["ولكن تجلِّي اللهِ جلّ جلاله","سرى حيث عمّ القبض في العُرب والترك",34,"ك",1,0],["ولكنَّ تذكاراً مذيباً لِمهجتي","يمرُّ فأبقى منه ولهانَ مولعا",35,"ع",2,0],["وَلكن تَصاريف الزَمان عجيبة","وانت اذا اِستَعتَبت اجدر بالعتبى",36,"ب",2,0],["وَلَكُنْتَ أَوَّلَ نازِعٍ مِنْ خُطَّتِي","يَدَهُ وَلَوْ كُنْتَ الْمُحِبَّ الْمُشْفِقا",37,"ق",2,0],["ولكنْ ترى نفسي العلاءَ وإن يكنْ","خضارِم من دون العلا وسهوب",38,"ب",1,0],["وَلَكِن تفادى أن يذيل اِحتشامها","تلطّف من يَحبو بهيأة من يحبى",39,"ب",2,0],["ولكِنْ تَوّلاني وَفي الحُسْنِ وَالِهٌ","يَقُوم بسُكْرِي إنْ غَدا السُّكْرُ يُتعِدُ",40,"د",1,0],["وَلِكِنَّ تَوحيدي هَواكَ بِغَيرَتي","مَصونٌ عَن الإِلقاءِ في سَمعِ مُشرِكِ",41,"ك",1,0],["ولكنْ تمَخّضُ تلك الهَناتُ","ليَنْتِجْنَ يَوماً على المارِقينا",42,"ن",2,0],["ولكنْ تَجلّى وجْهُ عَلياكَ طالعاً","فلم تَبْقَ منه اليومَ حسناءُ في خِدر",43,"ر",1,0],["ولكنْ تَجلّت مثل شمسٍ مُنيرةٍ","فَلحْت خلال الضّوء مثْلَ هبَاء",44,"ا",2,0],["ولَكِن تغرَّبَ شِعري عَليَّ","وَتاهَ فأحبَبتُ أَن يَخجَلا",45,"ل",2,0],["ولكنّ تيحان بن عاقرة استها","له ذَنَبٌ من أمره وتوابِعُ",46,"ع",1,0],["ولكن تمنينا الرجاء بباطل","ولكم قدر ما ترجى المنايا ولم تمل",47,"ل",1,0],["ولكنْ تولَّى الحاكمانِ قضاءَنا","فكان أبُو مُوسى لنا ولهمُ عمرُو",48,"ر",2,0],["ولكن تغيّر في حبهِ","وللغيرُ في الحب لا يحتمل",49,"ل",1,0],["ولكن تلك أفئدة صغار","كبار في الرموز وفي الرويّ",50,"ي",1,0],["ولكن تؤدّي الشهدَ إصبعُ ذائقٍ","وتعلَقُ ريحَ المسك راحةُ دائفِ",51,"ف",1,0],["ولكن تطالَلْ بعينِ النصيح","لعلَّك مُستشرِفاً تنظرُ",52,"ر",1,0],["ولكن تجاوَزْ لي بصَرفك ماجداً","إليه إذا جارتْ صروفُك أَستعدي",53,"د",2,0],["ولكنتُ يوم تزايلت عن حاجرٍ","تلك الحمولُ لبينهنَّ حمولا",54,"ل",2,0],["ولكنتُ آخذ جفنهُ لكنَّهُ","شرعٌ تجورُ على الخصومِ قضاته",55,"ت",2,0],["ولكن تلافاها أبو الفتح ناظماً","فرائد شمل لم تكن قط تنظم",56,"م",1,0],["ولكِنَّ تَرْحَالي لِزَوْرَةِ ماجِدٍ","أَشادَ مِنَ العَلْيا رَفيعَ عِمادِ",57,"د",1,0],["ولكن تأسَّينا بِشبلٍ تَرَكتَهُ","فمَثَّلَ منكَ الحَزمَ والعزمَ والنَّصرا",58,"ر",2,0],["ولكن تمَّهل يا فؤادي فإنَّ لِي","أكارِم وَعدٍ منه يعرفُها نَجدُ",59,"د",1,0],["وَلَكِن تَستَقِلُّ بِهِ قِواهُ","عَلى ماضٍ بِقائِمِهِ نَبيلِ",60,"ل",1,0],["ولَكُنتُ الغنِيَّ عنْ","نَدَمٍ أو تَعَقُّبِ",61,"ب",1,0],["ولكن تبتلى في الدين منهم","بما هم فيه إذ بالسوء جاؤا",62,"ا",2,0],["ولكن تقَاسمْنا فجارَ فكُلَّما","أتى دانَقٌ مِنِّي أتى منهُ مِثقالُ",63,"ل",1,0],["ولكنْ تَحْمِلُ الكثْبانُ باناً","وَلَمْ أَرَ بانةً حَملتْ كَثيبا",64,"ب",2,0],["وَلَكُنتُ أدخُلُ حيثُ أدخلُ سارقاً","ولكنتُ أخرُجُ حَيثُ أخرُجُ سارِقا",65,"ق",2,0],["ولكنتُ أنْشَقُ من شذاهُ إذا سرى","عَرْفاً يداوي بالخشَى الآلاما",66,"م",2,0],["ولكنْ تمنّي النفس للصبِّ جُنّةٌ","تَقِي نفسَه مَهْوَى الرّدى وتُحامِي",67,"م",2,0],["وَلَكِنَّ تَلخيصَ المَديحِ بَلاغَةٌ","وَكَم قَد كَفى التّلخيصُ عَن فَرطِ إِسهابِ",68,"ب",1,0],["ولكنت قد أغنيتكم عن شرح تذ","كرة الحكيم بصيرنا الأنطاكي",69,"ك",2,0],["وَلكِن تَعالَ وَقِف فَوقَ رَأسي","وَقَبِّل مَعينَ الّلمى وَالحَوَرْ",70,"ر",1,0],["وَلَكِن تَدبّرت الأُمور فَلَم أَجِد","سِوى الحِلم وَالاغضاء خَيراً وَأَفضَلا",71,"ل",2,0],["ولكن تفويضي أموري ذريعة","إليك وتحقيق لقدر عبودتي",72,"ي",1,0],["وَلَكِن تَحِيَّةُ مُستَطرِبٍ","بِحُبِّكَ حبِّ الغويّ المُداما",73,"م",2,0],["ولكنت أنبت النوا","ئب حيث نابت من أنابا",74,"ب",2,0],["ولكنتُ أوَّلَ لاحقٍ بك حسرةً","لولا التّسلِّى بالمليكِ النّاصِرِ",75,"ر",1,0],["وَلكِن تَدَبَّرنا الأُمورَ فَلَم نَجِد","إِلى شَتمِ أَعراضِ العَشيرَةِ سُلّما",76,"م",2,0],["ولكن تبيد السقم منهن كاعبٌ","تعيد برياها الحياة لميت",77,"ت",1,0],["ولكنْ تهحاملَ لما ضعفتُ","فهلاَّ وَفَى وَلَهُ مُحْتَمَلْ",78,"ل",1,0],["ولكن تَحَنَّى بها قَبْلَهُ","ولو مَزَجُوها بِخَلْسِ القُبَل",78,"ل",1,0],["ولَكُنْتُ من ولدي غريب كالذي","يحمي ويدفع صَوْلَةَ المكَّار",79,"ر",1,0],["ولكن تغلب عزم الزمان","على عزمه والقضاء انتصر",80,"ر",1,0],["ولكن تسمى باسمه فاحترمته","على كلِّ إقبال بادبارِ مُقبل",81,"ل",1,0],["ولكن تركت القوم تبكي عيونهم","عليك بدمعٍ كالسيول انهماله",82,"ل",2,0],["ولكنت أذكى جمر قلبى فى الدجى","بطريقه كى يهتدى ببريقه",83,"ق",2,0],["ولكن تأنف الهمم العوالي","على رغم الصبا سفساف أمر",84,"ر",1,0],["ولكنت أرجو برء داء صبابتي","لكن قلبي عندكم ما حيلتي",85,"ت",2,0],["وَلَكِن تَرَكنَ بِحَبِّ القُلوبِ","كَلوماً وَخَدَّدنَ أَرضَ الخُدودِ",86,"د",1,0],["وَلَكن تَعالَوا عَطِّرُوا مَجلِسَ الهَنا","بِعَودِ أَبِ الأَحساءِ أَعنِي أَبا الحَمدِ",87,"د",1,0],["وَلَكنَّ تَحتَ الإبطِ ليِّنَ جلدةٍ","فَمِنها المَنايا دونَهُ تَتَصَعَّدُ",88,"د",1,0],["ولكن ترى فيهم على الأرض أنجما","كما قد ترى في الجو بالليل أنجما",89,"م",2,0],["ولكن تراني لاعدمتك داعياً","إلى اللّه فاسمع ما أقول لترشدا",90,"د",2,0],["ولكنّ تأنيب الضمير يسوقني","لإثبات فضل منك لي واجب الأجر",91,"ر",1,0],["ولكن تعالى جرفه غير منهل","كمنبع رزقي ضاق أو عين ذي بخل",92,"ل",1,0],["ولكن تولى أمره غير أهله","فنام وما البلقان عنه بنائم",93,"م",1,0],["ولكن تراها في السماء كانها","دنانير صانتها اكف الغياهب",94,"ب",1,0],["ولكنْ تمَشَّتْ في ذَراهُ عُيونُنا","تجُرُّ على الأطْلالِ ذَيْلَ المَدَامِعِ",95,"ع",1,0],["ولكنتُ لا أَصلُ الوصو","لَ ولا يلائمني مُلائِمْ",96,"م",1,0],["ولكنتُ أُعذَرُ في الحَنينِ اليكمُ","لو كانَ لي في العَالَمينَ صَدِيْقُ",97,"ق",1,0],["ولكنّ تاجَ الملةِ اليومَ حلَّها","على الدّهْرِ حتى ليس فيه عُقودُ",98,"د",1,0],["ولكن تبدّتْ غادةٌ من تِطاونٍ","وقالت هنا فامكثْ لدينا أبا بكر",99,"ر",1,0],["ولكن تجاور سطحاهما ال","بسيطان فائتلفا بالجوار",100,"ر",1,0],["ولكن تخاذلنا فصرنا أذلة","يساء إلينا ثم نؤمر بالشكرِ",101,"ر",1,0],["وَلَكن تفضّل وَقل ما جَزا","فُؤادي إِذا كانَ طَرفي اختلس",102,"س",1,0],["وَلَكن تَغشَّى الكُنهَ في الأَمرِ أَوجهٌ","فَلم يَدرِ ما وَجه الصَواب حَكيم",103,"م",1,0],["وَلَكن تِلكَ عاداتُ اللَيالي","وَشيمة دَهرنا الباغي العجول",104,"ل",1,0],["ولكن تعالوا نحتكم ثم نبتهل","فنجعل عذاب الله يجتاح أشقانا",105,"ن",2,0],["ولكنت تبكي رحمة لشج","حنت عليه حوادث الد