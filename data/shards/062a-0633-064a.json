h3er&doWhat=shqas&qid=85032&r=&rc=107",""],[6367,"أشواق حجازية الإيقاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80598&r=&rc=1",""]],"verses":[["تَسيلُ إِلَيهِمُ أَيدي المَطايا","بِكُلِّ أَشَمِّ مَعروقِ العِظامِ",0,"م",1,0],["تَسيرُ أَمامَ العاصِفاتِ كَأَنَّها","طَلائِعُ أَعناقِ الصَبا وَالجَنائِبِ",1,"ب",1,0],["تَسيرُ بها الرّكْبانُ شرقاً ومَغْرباً","ويَسْري لها العافونَ مَثْنى ومَوْحَدا",2,"د",2,0],["تَسيرُ بشُكْرٍ غائِرِ الذِّكْرِ مُنْجِدٍ","يُناجي لِسانَيْ مُعْرِقٍ وشَآمي",3,"م",2,0],["تَسيرُ إِلى شَمسِ الهُدى في حَفاوَةٍ","مِنَ العِزِّ تَحدوها الزَواهِرُ أَينَما",4,"م",2,0],["تسير بها شرائع عادلات","إلى أوح السعادة مرتقينا",5,"ن",2,0],["تَسيلُ عَلَيهِمُ شُعَبُ المَخازي","وَقَد كانوا لِسَوأَتِها قَرارا",6,"ر",2,0],["تَسيرُ عَلى مِثلِ المُلاءِ مُنَشَّراً","وَآثارُها طَرزٌ لِأَطرافِها حُمرُ",7,"ر",1,0],["تسيرُ بها الأقوال في كلِّ بلدةٍ","وتعرضها الأعمال في حضرة القدس",8,"س",1,0],["تسيل في الطرس أرواحُ العداة به","حتى كأن يراع الطرس مرعوف",9,"ف",1,0],["تسير في أيّ وادٍ","فقلت والغيث يمّه",10,"م",2,0],["تسيلُ مستعبرَةً","بأَيِّ ذنبٍ قتِلَتْ",11,"ت",1,0],["تسير بسيْر اسم المقُولَة باسمه","فَتَسْنَحُ في الآفاق طوراً وتبرحُ",12,"ح",1,0],["تسيرُ بك الدنيا إذا ما تَنازَعتْ","نَواطقُة ألحانَهُ وخوارسُه",13,"س",2,0],["تسيء بي حين لا أجزيك سيئة","والعود يجزيك تدخيناً بإحراق",14,"ق",1,0],["تسير بذكرٍ منك ما زال قاطعاً","بك الغَوْل طلّاعاً ثنايا المخارمِ",15,"م",1,0],["تَسيرُ بِنا عَلى عَجَلِ","وَإِن شاءَت عَلى مَهلِ",16,"ل",1,1],["تَسيرُ إِلى أَرضٍ بِها كُنتَ مُضغةً","وَفيها اِكتَسَت باللَحمِ منك عِظامُ",17,"م",1,0],["تسيل بها نورا خلال كتابه","وتجرى حواشيه لجينا وعسجدا",18,"د",2,0],["تَسيرُ مِنَ الفَضاءِ إِلى المَضيقِ","فَآناً أَنتَ في بَحرٍ طَليقِ",19,"ق",1,0],["تَسيرُ مَسيرَ الضُحى في البِلادِ","إِذا العِلمُ مَزَّقَ فيها السَدَف",20,"ف",1,0],["تُسيءُ مِنَ المَرءِ تَأديبَهُ","وَلَكِن تُحَسِّنُ أَخلاقَهُ",21,"ق",2,0],["تَسيرُ سَيرَ النَعَمِ الأَرسالِ","مُعتَمَّةً بِيَبِسِ الأَجذالِ",22,"ل",1,0],["تَسيرُ العِماراتُ أَيسارَها","وَيَعتَرِضُ القَصرُ أَيمانَها",23,"ن",3,0],["تَسيرُ القَوافي بِأَنبائِها","مَسيرَ المَطِيِّ بِرُكبانِهِ",24,"ن",2,0],["تَسيلُ مَآقيكَ الصَديدَ تَلومُني","وَأَنتَ اِمرُؤٌ قَحمُ العَذارَينِ أَصلَعُ",25,"ع",1,0],["تُسيلُ قَمَ الزِّقِّ الرَّوِيِّ كأنَّه","جِراحَةُ زِنْجيٍّ يَسيلُ نَجيعُها",26,"ع",3,0],["تَسيلُ خلالَ الرَّوْضِ من فَيْضِ دمعِه","قَواضبُ تُزري بالسيوفِ القَواضبِ",27,"ب",1,0],["تَسيرُ الجِبالُ عَلى سُرعَةٍ","كَمَرِّ السَحابِ تَرى حالَها",28,"ل",3,0],["تَسيرُ بِها نَحوَ الحِجازِ وَقَصدُها","مَلاعِبُ شِعبَي بابِلٍ وَقُصورُها",29,"ر",3,0],["تُسَيّرُ فلْكهُ شرْقاً وغَرْباً","وتُدْفَعُ من صَبَاهُ إلى جنوبه",30,"ب",2,0],["تَسيرُ مَسيرَ الشَمسِ مُطَّرَفاتُها","وَما السَيرُ مِنها لا العَنيقُ وَلا الوَخدُ",31,"د",1,0],["تَسيلُ أكفُّهم كَرَماً وبرّاً","إذاجمدتْ أكفُّ الباخلينا",32,"ن",2,0],["تَسيرُ مَواكِبُها فَخمَةً","تَهِلُّ البِقاعُ لَها وَالسُبُلْ",33,"ل",1,0],["تَسيرُ بِطاءً وَالمَكارِهُ رُكَّضٌ","بِأَرجائِها وَالمُزعِجاتُ دوائِبُ",34,"ب",1,0],["تَسيلُ فَتَندَفِقُ الرائِعاتُ","وَتَجري فَتَستَبِقُ الجُوَّبُ",35,"ب",1,0],["تُسيءُ إِلَيكَ فَلا تَستَطيرُ","وَتَجني عَلَيكَ فَلا تَغضَبُ",35,"ب",1,0],["تَسيرُ فَتَحكي البَدرَ سَيراً وَغُرَّةً","خَلا أَنَّها مَعصومَةٌ لَيسَ تُمحَقُ",36,"ق",1,0],["تَسِيخُ العُرُوقُ بِها وَالفُرُو","عُ في الجَوِّ رانِيَةٌ تَطمَحُ",37,"ح",1,0],["تَسيلُ عَلى حَدِّ الظُباتِ نُفوسُنا","وَلَيسَت عَلى غَيرِ الظُباتِ تَسيلُ",38,"ل",1,0],["تُسيءُ قَوافيها وَجُودُكَ مْحِسنٌ","وتُنْشِدُ إرْنَاناً ومجْدُكَ ضاحك",39,"ك",1,0],["تسيرُ القوافي المذهَباتُ أحوكُها","فتمضي وإن كانتْ على مجدكم وقفا",40,"ف",2,0],["تسيرُ الجبالُ الجامداتُ بسَيرِهِ","وتسجُدُ من أدْنَى الحفيفِ وتركَعُ",41,"ع",1,0],["تسير على أقدارها في عجاجَةٍ","ويقدُمُهَا منْه العزيزُ الممنَّع",41,"ع",1,0],["تَسيرُ نُجومُهُ عَجَلاً وَرَيثاً","مُشَرِّقَةً وَتاراتٍ تَغورُ",42,"ر",1,0],["تَسيرُ بِنا الأَيّامُ وَهِيَ حَثيثَةٌ","وَنَحنُ قِيامٌ فَوقَها وَقُعودُ",43,"د",1,0],["تَسيرُ بِنا هَذي اللَيالي كَأَنَّها","سَفائِنُ بَحرٍ ما لَهُنَّ مَراسي",44,"س",2,0],["تَسيرُ إِلى البَيتِ الحَرامِ تَنَسُّكاً","وَيَشكوكَ جارٌ بائِسٌ وَخَدينُ",45,"ن",1,0],["تسيلُ معَ الدموعِ جفونُ عيني","كما سالَ الفؤادُ معَ الزَّفيرِ",46,"ر",1,0],["تُسيءُ بنا يَقْظى فأمّا إذا سَرَتْ","رُقاداً فإحسانٌ إلينا وإجْمال",47,"ل",1,0],["تَسِيرُ بِهَا الرُّكْبَانُ فِي كُلِّ مَنْزِلٍ","وَتَلْتَفُّ مِنْ شَوْقٍ إِلَيْهَا الْمَجَامِعُ",48,"ع",1,0],["تَسِيرُ بِنَا الأَيَّامُ وَالْمَوْتُ مَوْعِدٌ","وَتَدْفَعُنَا الأَرْحَامُ وَالأَرْضُ تَبْلَعُ",49,"ع",1,0],["تَسِيرُ وَأَعْلامُهَا مُومِئَاتٌ","إِلَى أَيِّهَا البَطَلُ المُعْلَمُ",50,"م",1,0],["تسيرُ من ظَفَرٍ حُلْوٍ إلى ظفرٍ","مُبَارَكَ الفتحِ والرّاياتِ ميمُونَا",51,"ن",2,0],["تسيرُ وشأنَها حتى اذا ما","تصدَّتْ قوَّةٌ فبها التواء",52,"ا",2,0],["تسير وألحاظ البروق شواخص","إليها وأمواج البحار توابع",53,"ع",1,0],["تسير بك العواطفُ للمنايا","وعاطفةٌ تسوءُ الظُفرَ حُمْقُّ",54,"ق",1,0],["تسيرُ في القصْد ولا زمامُ","يُلْزمك القصْدَ ولاخطامُ",55,"م",1,0],["تسير من العماية في مخوفٍ","ترامى في جوانبه المنون",56,"ن",1,0],["تُسيءُ بِيَ الأَيام حَتّى كَأَنَّها","تَرانيَ مِن بَعد التَجارُب جابِرا",57,"ر",2,0],["تسيل على الخوان موجات لجه","ومالي فيه حسوة المتبرض",58,"ض",1,0],["تسيل دموعي من جفون قريحة","وتلهب نيران التلهف في سري",59,"ر",2,0],["تسير كأنَّ الليل داجٍ وإن ثوت","ببيت لها كالشمس بازغةَ السما",60,"م",2,0],["تسيرُ مسيرَ الشمس شرقا ومغرباً","وتظهرُ جدواكم ولو كَرِهَ الضدُّ",61,"د",1,0],["تسير العطايا والمنايا أمامه","لمن رام جدواه ورام نزاله",62,"ل",2,0],["تسيل جدواه صباحا ومسا","وغيرها يقطر بعد العصر",63,"ر",1,0],["تسيء به ظنا وتحسن تارة","على حسبما يقضي الهوى في القضية",64,"ه",1,0],["تسيلُ أباريقُها بالمدامِ","كما جرحَ البازُ جيدَ الحبُارى",65,"ر",2,0],["تَسيرُ بِسَدٍّ مِن حَديدٍ لَوَ اِنَّهُ","هُوَ السَدُّ لَم يَخرِقهُ لِلوَعدِ خارِقُ",66,"ق",1,0],["تَسيرُ إِلى الأَهوازِ مِن أَرضِ بابِلٍ","وَلَيسَ سِوى أَسيافِهِ خُفَراها",67,"ا",3,0],["تَسيلُ كَفُّكَ بالعَطَايَا","كالسَّيِل مِن جُودِكَ العَمِيمِ",68,"م",1,0],["تسير بنا تلك الزواريق في الضحى","خلال ديار مونقات الذرى ضمر",69,"ر",1,0],["تَسيرُ وَفي فُؤادي نارُ وَجدٍ","دُموعي عِندَها أَبَداً سُجومُ",70,"م",1,0],["تسيرُ مطاياها وعند مسيرها","لها ب