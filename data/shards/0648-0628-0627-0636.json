{"poems":[[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[203,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[276,"فؤادي بربع الظاعنين أسير","https://www.aldiwan.net/poem52084.html","الطويل"],[547,"وباض الحب في قلبي","https://www.aldiwan.net/poem34027.html","الهزج"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45372","الطويل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104681","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[5121,"خميلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33597",""],[5190,"بيضة السندباد","https://www.poetsgate.com/ViewPoem.aspx?id=9666",""],[5408,"أقسمت إني لا أخونك","https://www.poetsgate.com/ViewPoem.aspx?id=190872",""]],"verses":[["وَباضِعَةٍ حُمرِ القِسِيَّ بَعَثتُها","وَمَن يَغزُ يَغنَم مَرَّةً وَيُشَمَّتِ",0,"ت",1,0],["وبأضلعي قلبٌ أعللهُ","بالوعدِ أحياناً وبالصبرِ",1,"ر",1,0],["وَباض حمام الايك في اثره كَما","بنت عَنكَبوت حين كانَ يَسير",2,"ر",1,0],["وباضَ الحبُّ في قلبي","فوا ويلي إذا فَرَّخ",3,"خ",1,1],["وباض حمام الايك في اثركما","لاقدامه العليا تلين صخور",4,"ر",1,0],["وَباضَت عَلى رَأسي السُنون وَفَرَّخَت","وَما لي حَلّ في الأُمورِ وَلا عَقدُ",5,"د",1,0],["وباضافة فلاختصار","وقصد تعظيم أو احتقار",6,"ر",1,0],["وباض حمام الأيك في إثره كما","حماه إلهٌ من عداهُ قدير",7,"ر",1,0],["وَباضطِرَارٍ خُصَّ جَمعُ يَا وَأل","إلاَّ مَعَ اللهِ ومَحطِىَّ الجُمَل",8,"ل",1,0],["وبأضْلعي سكنتْ تُضَوّعُ طيبَها","نبضاتُ حبِّكَ منْ زهور ِمعزّتي",9,"ت",2,0],["وباضت بيضةً في حجم طودٍ","عظيمٍ راسخٍ صعبِ القياد",10,"د",1,0],["وبأضلعي قد تحْتمي","ممَّا يُراودُها فتونُكْ",11,"ك",1,0]]}