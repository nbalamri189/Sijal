{"poems":[[55,"لاموا ولو وجدوا وجدي لقد عذروا","https://www.aldiwan.net/poem30432.html","البسيط"],[10,"يا عين جودي بالدموع الغزار","https://www.aldiwan.net/poem21090.html","السريع"],[85,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[53,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[72,"مالكي أنت لا عدم","https://www.aldiwan.net/poem42780.html","مجزوء الخفيف"],[40,"إني امرؤ لم أزل وذاك من الله","https://www.aldiwan.net/poem7834.html","المنسرح"],[80,"كنت حلف الندى ورب السماح","https://www.aldiwan.net/poem14205.html","الخفيف"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[45,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[68,"فلتة كان منك عن غير قصد","https://www.aldiwan.net/poem40442.html","الخفيف"],[76,"لقد أصخت إلى نجواك من قمر","https://www.aldiwan.net/poem12951.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42531","الخفيف"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[53,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[159,"تظلم الورد من خديه إذ ظلما","https://www.aldiwan.net/poem55561.html","البسيط"],[309,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[353,"لا أجحد المنن التي تلدتم","https://www.aldiwan.net/poem20405.html","الكامل"],[409,"جئت بالمعجزات من تبيانك","https://www.aldiwan.net/poem33383.html","الخفيف"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[463,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[510,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[520,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[580,"لا أجازى حبيب قلبي بجرمه","https://www.aldiwan.net/poem2856.html","الخفيف"],[591,"لا أجازي حبيب قلبي بظلمه","https://www.aldiwan.net/poem18019.html","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77599","المجتث"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77439","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21661","المنسرح"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93568","الرجز"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105671","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202842","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204773","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132722","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62840","السريع"],[4691,"سوط وسواسي","https://www.poetsgate.com/ViewPoem.aspx?id=164278",""],[4988,"صباحي","https://www.poetsgate.com/ViewPoem.aspx?id=175151",""],[460,"أَعرْصَة ُ الدَّارِ أم تَوهّمُها","https://www.poetsgate.com/ViewPoem.aspx?id=22239",""],[5092,"لا أجملَ من عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=161809",""]],"verses":[["لا أَجمَعُ الحُبَّ لِلبيضِ الحِسانِ إِلى","ما بَيَّضَ الدَهرُ وَالأَيّامُ مِن شَعَري",0,"ر",2,0],["لا أَجزَعُ الدَهرَ عَلى هالِكٍ","بَعدَكَ ما حَنَّت هَوادي العِشار",1,"ر",1,0],["لا أجدَبَ الله الطلولَ فطالما","أشجى الفصيحَ بها بكاءُ الأعجمِ",2,"م",1,0],["لا أجازيك من غروركَ إيا","يَ غروراً وُقِّيت سُوء الجزاءِ",3,"ا",2,0],["لاَ أجْتَدِيهِ ولا أريهِ زَهَادَةً","فِيمَا لَدَيْهِ ولا أكُفُّ ولا أُلحْ",4,"ح",1,0],["لا أجتديه ولا أمتاح نائله","ولا أزول ولي في الأرض مصطرف",5,"ف",1,0],["لا أجتني من فِراقِه أسفاً","أو يَجْتنِي من جفائه نَدما",6,"م",2,0],["لا أُجازي وَلَو مَنَح","تُكَ روحي تَطَوُّلَك",7,"ك",1,0],["لا أَجتَوي خُلَّةَ الصَديقِ وَلا","أُتبِعُ نَفسي شَيئاً إِذا ذَهَبا",8,"ب",2,0],["لا أُجِيبُ الصَريخَ إِن حَضَرَ النا","س وَلا المُعتَفين يَومَ السَماحِ",9,"ح",1,0],["لا أَجِدُ المُسعِفَ","إِلّا مَلَكاً مُقَرَّبا",10,"ب",2,0],["لا أَجحَدُ الفَضلَ رُبَّما فَعَلَت","ما لَم يَكُن فاعِلاً وَلا واعِد",11,"د",1,0],["لا أُجازيكَ بِالإِهانَةِ وَالسَب","بِ وَلَكِن جَزاكَ يا نَحسُ عِندي",12,"د",2,0],["لا أَجتَلي مُلَحاً حَتّى أَعي مُلَحاً","عَدلاً مِنَ الحُكمِ بَينَ السَمعِ وَالبَصَرِ",13,"ر",1,0],["لا أُجازِيكَ بِالَّذِي خُضْتَ فِيهِ","مِنْ حَدِيثٍ وَلا أَمُضُّكَ عَتْبَا",14,"ب",2,1],["لا اجتني خطة الا مخالسة","ودون اتمامها الاهوال تشتعل",15,"ل",1,0],["لاأجازيك من غروركَ إيا","أرضٌ علَلتها بدماء",16,"ا",2,0],["لا أَجَّلَ اللَهُ آجالَ الدُّمُوعِ إِذا","مَا لَمْ يَكنَّ لأَبْنَاءِ الهَوى خَدَمَا",17,"م",2,0],["لا أَجهَلُ الحِكمَةَ الَّتي بَرَزَت","في ضِمنِ إِيجادِهِم وَلا أَذَرُ",18,"ر",1,0],["لا أَجْحَدُ المِنَنَ التي تَلَّدْتُمُ","جِيدِي ولا أَنسى ولا أَتَناسَى",19,"س",2,1],["لا أجاريك إنما أتجارى","أيراعى مقاوم لسنانك",20,"ك",1,0],["لا أجلب الرزقَ إذا لم يكن","يدرُّ من أكرم مسترزَقِ",21,"ق",1,0],["لا اجتاز عيدٌ إلا عليك وإن","أَجَزْتَ أن تُمطَلَ المواعيدُ",22,"د",1,0],["لا أجلدُ النفسَ حيرةً إذْ","لا ذنبَ عن فعلهِ أتوبُ",23,"ب",1,0],["لا أجحد الحق عندي للركاب يد","تمنت اللجم منها رتبة الخطم",24,"م",1,0],["لا أَجمَعُ الحِلمَ وَالصَهباءَ قَد سَكَنَت","نَفسي إِلى الماءِ عَن ماءِ العَناقيدِ",25,"د",1,0],["لا أَجازى حبيبَ قلبي بجرمِهْ","أَنا أَحْنى عليه من قَلْبِ أُمّهْ",26,"م",2,1],["لا أُجازِي حَبيبَ قَلْبي بِظُلْمِهْ","أَنَا أَحْنَى عَلَيْهِ مِنْ قَلْبِ أُمِّهْ",27,"ه",1,1],["لا أجلب الذئب عِندي","يَأكلك اليَوم حالا",28,"ل",2,0],["لا أَجتَلي أَحَداً إِلّا تَمثَّل لِي","في وَجهِهِ مِن أَحِبَّتي تَماثيلُ",29,"ل",1,0],["لا أَجعَلُ الجايِرَ المَلولَ وَذا الشْ","شيمَةِ لا يَستَقيمُ مَنسِمُها",30,"م",3,0],["لا أَجحَدُ النُعمى الَّتي سَبَغَت","أَنا بَعضُ مَن غَرَّقتَ يا بَحرُ",31,"ر",1,0],["لا أَجندي المزن إِذا ما سلمت","أَيديهم الوكَّفّ بِالسَماح",32,"ح",1,0],["لا أجازيك وكم من واهب","لاتجازيه سنيات العطايا",33,"ا",3,0],["لا أجيز البليد يصغي لشعري","فهو سرٌّ يباح للأذكياء",34,"ا",2,0],["لا أجيز الاختلاط صف بصفٍ","موقعاً لي بحيرة في الكلام",35,"م",1,0],["لا اجحد القلم الأعلى فضيلته","فانه ذو اليد البيضاء في الأمم",36,"م",1,0],["لا أَجحدُ المجدَ يَداً طَوَّقَتْ","عُنقي وغَلَّتْهُ إلى سَاعِدِي",37,"د",2,0],["لا أجعلُ الغرامَ لي قابرا","ويمتعُ الحبيبَ إحساسي",38,"س",2,0],["لا إجتمع صبحي مع اشراق صبحك","أدركت وش يعني ! تنفس صبآحي",39,"ح",2,1],["لا أجْعَلُ الجايِرَ الملولَ وذا ال","شِيمة ِ لا يَستقيمُ مَنْسِمُها",40,"م",3,0],["لا أجملَ مِنْ عينيكِ ولا أبهى","لا أحلى مِنْ شفتيكِ ولا أشهى",41,"ا",1,1]]}