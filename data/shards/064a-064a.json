{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[86,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[72,"يئست من الصداقة منك لما","https://www.aldiwan.net/poem19431.html","الوافر"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[45,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[28,"يئسن من اللحاق بهن منكم","https://www.aldiwan.net/poem4953.html","الوافر"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43860","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43658","الطويل"],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[85,"عَرَضوا الأَمانَ على الخواطرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9549&r=&rc=39",""],[127,"شربت كأسي أمام نفسي","https://www.aldiwan.net/poem67449.html","مخلع البسيط"],[184,"ألفى إلي صحيح الفكر والورع","https://www.aldiwan.net/poem43647.html","البسيط"],[193,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[233,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[283,"قفا نبك أطلالا تقلص ظلها","https://www.aldiwan.net/poem39368.html","الطويل"],[296,"خليلي إني قد حننت لقربها","https://www.aldiwan.net/poem36259.html","عموديه"],[407,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[447,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[456,"يا ليلة ما رأتها أعين الغير","https://www.aldiwan.net/poem56196.html","البسيط"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[462,"ما بالها لم تجرني في بالها","https://www.aldiwan.net/poem3414.html","عموديه"],[498,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[498,"بالله يا أيها الساري العشية لم","https://www.aldiwan.net/poem37966.html","البسيط"],[547,"يئست من الحذية أم عمرو","https://www.aldiwan.net/poem444.html",""]],"verses":[["يَئِلُ الَّذي أَمَّنتَ رَوعَتَهُ","وَالعُصمُ في الأَطوادِ لا تَئِلُ",0,"ل",1,0],["يَئِنُّ لها الأبطالُ مِنْ حَذَرِ الرَّدى","أنينَ هَوامي العِيسِ أضْجَرَها العِشْرُ",1,"ر",1,0],["يَئِنُّ كَالمَفؤودِ أَو كَالَّذي","أَصابَهُ سَهمٌ وَلَم يُنزَعِ",2,"ع",1,0],["يَئِنُ إِلى مَسِّ البَلاطِ كَأَنَّما","يَراهُ الحَشايا مِن ذَواتِ الزَخارِفِ",3,"ف",1,0],["يَئِستُ مِنَ الإِنصافِ بَيني وَبَينَهُ","وَمَن لِيَ بِالإِنصافِ وَالخَصمُ يَحكُمُ",4,"م",1,0],["يئس الناسُ إذ تجلى فجلَّ","يت دُجاها بالبأسِ والآراء",5,"ا",2,0],["يئستُ من الصداقة منكَ لما","تمادَى منك إعراضٌ وثيق",6,"ق",1,1],["يئست من قومي حتى لقد","اوشك ان يقتلني يأسي",7,"ي",1,0],["يَئِسَت مِنَ الإِنصافِ حَتّى وَهَّمَت","بِاليَأسِ أَنَّ اللَهَ تارِكُها سُدى",8,"د",2,0],["يَئِسَ الحاسِدونَ مِنكَ وَكانوا","أَسَفاً يَنظُرونَ نَحوَكَ حولا",9,"ل",2,0],["يَئِلونَ مِن حَرِّ الحَديدِ وَخَلفَهُم","شُعَلُ الظُبا وَشَواجِرُ الخِرصانِ",10,"ن",1,0],["يَئِسنَ مِنَ اللَحاقِ بِهِنَّ مِنكُم","وَقَد قَطَعوا بِهِنَّ لِوىً حِدابا",11,"ب",2,1],["يَئِسوا من العُقْبَى فتلك نُفوسُهم","تُزجَى جَنازتُها بغيرِ رجاءِ",12,"ا",2,0],["يَئِستُ مِن اِكتِسابِ الخَيرِ لَمّا","رَأَيتُ الخَيرَ وُفُّرَ لِلشِرارِ",13,"ر",1,0],["يُيَسِّرُ أَرْزَاقاً وَيَرْعَى مَرَافقاً","زَكَتْ مَصْدَراً للعَاملينَ وَمَوْرِدَا",14,"د",2,0],["يَئسْتُ منَ الْحَيَاةِ وَكَانَ يَأْسي","يُريحُ النَّفْسَ لَوْ سَكَتَ الضَّميرُ",15,"ر",1,1],["يَئِستُ إِن لَم تَجُد بِعَفوٍ","يَنجو بِهِ عَبدُكَ العَصِيُّ",16,"ي",1,0],["يَئِستُ مِنَ السُلوانِ حَتّى نَكرتُهُ","فَلَو أَنَّني غيلانُ ما سُلِيَت مَيُّ",17,"ي",1,0],["يئستُ من الوَرَى، وَوَثِقْتُ فيمن","يُعِيدُ الرُّوحَ في العظم الرَّمِيم",18,"م",1,0],["ييا ثغرها ، أمستُ كال","غوَّاص، أَحْلُم بالجواهر",19,"ر",1,0],["يَئِنُّ قلبي على حبيبي","ولا حَبيبٌ إِلّا الخَيال",20,"ل",1,0],["يئست من أن أرى مولى وبصّرني","يأسي من الكبر أن أمشي مع التبع",21,"ع",1,0],["يَيأَسُ الظُلمُ أَن يَكونَ بِأَرضٍ","هُمُ بِها أَو يَجيءُ مِن حَيثُ جاءوا",22,"ا",1,0],["يَئِسَ العائِدِ مِن إِبرائِها","وَسلا العاذِلِ عَنِ سُلوانِها",23,"ن",3,0],["يئن أنيناً يجرح القلب والكلى","يفتت أكباداً ولما يطق صبرا",24,"ر",2,0],["يئستُ فما لي في حياتيَ مطمعٌ","فيا موت عجِّلْ ويك آن أَواني",25,"ي",1,0],["يَئِسَ الناسُ أَن يَنالوا قَديماً","في المَعالي لِسَعيِكُم إِدراكا",26,"ك",2,0],["يئس الصغار من الكبار ولم يعد","من ناصر لهم سوى الأحجار",27,"ر",1,0],["يئست من صبحها حتى التفتُّ إلى","وجهِ العِشاء أعزِّيه عن السَّحَرِ",28,"ر",1,0],["ييأسُ فحلُ الشّولِ من ضربها","لعزّةِ النْفسِ ولم تُكْتَبِ",29,"ب",1,0],["يئستُ واليأس أخو الفوز فلا","أطمع في جمل ولا إجمالها",30,"ل",3,0],["يَئِنُّونَ ليلاً من صَميمِ قُلوبهِمْ","وللشَّوقِ في طيِّ القُلُوبِ نِصَالُ",31,"ل",1,0],["يَئِنُّ أنَّةَ ملْسوعٍ ولا عَجَبٌ","أَراقِمُ الهجْرِ والَهْفاهُ تلْسَعُهُ",32,"ع",2,0],["يَئِستُ مِنَ الحَذِيَّةِ أُمَّ عَمرٍو","غَداةَ إِذ اِنتَحَوني بِالجَنابِ",33,"ب",1,1]]}