://www.poetsgate.com/ViewPoem.aspx?id=188460",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5183,"مُلْغِزَه رق38م","https://www.poetsgate.com/ViewPoem.aspx?id=186407",""],[5219,"أشجان عربي","https://www.poetsgate.com/ViewPoem.aspx?id=194935",""],[5271,"شذى","https://www.poetsgate.com/ViewPoem.aspx?id=123675",""],[5277,"ربيعُ المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=211662",""],[5285,"حكايا الأمس والموال","https://www.poetsgate.com/ViewPoem.aspx?id=203200",""],[5358,"لا تجرحي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183416",""],[5431,"سلامي إلى صنعا تعزّ وربعها","https://www.poetsgate.com/ViewPoem.aspx?id=188446",""],[5444,"غزّة تتكلّم","https://www.poetsgate.com/ViewPoem.aspx?id=205080",""],[5480,"الجيره","https://www.poetsgate.com/ViewPoem.aspx?id=30870",""],[5554,"امازيغية","https://www.poetsgate.com/ViewPoem.aspx?id=180581",""],[5598,"فوانيس السماء","https://www.poetsgate.com/ViewPoem.aspx?id=213905",""],[5701,"نظرت للشرق والأحداث تنهشه","https://www.poetsgate.com/ViewPoem.aspx?id=164609",""],[5736,"مخاض الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=208220",""],[5818,"تعوّذت ِ الأمّ مِن دائها","https://www.poetsgate.com/ViewPoem.aspx?id=193227",""],[2430,"تأملت اختبر المدعين","https://www.poetsgate.com/ViewPoem.aspx?id=90261",""],[5853,"(( دمشقُ ))","https://www.poetsgate.com/ViewPoem.aspx?id=175658",""],[5853,"علام..؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=175681",""],[5956,"إليك تفتحتْ ورداتُ حبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=182073",""],[5956,"الشهمُ المُرَبّى..","https://www.poetsgate.com/ViewPoem.aspx?id=194013",""],[5970,"أحمل من ويلاتها ما أحمل","https://www.poetsgate.com/ViewPoem.aspx?id=130653",""],[5973,"مساء عينيك فضة ٌ وعطور","https://www.poetsgate.com/ViewPoem.aspx?id=13276",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""],[6152,"مستوطن بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203297",""],[6152,"غيبتك حرام","https://www.poetsgate.com/ViewPoem.aspx?id=203587",""],[5309,"يئست من الأصحاب والحب زائل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573842",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[2588,"شاخصة (تحذير)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65600&r=&rc=32",""],[6310,"جمر الشتات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72001&r=&rc=5",""]],"verses":[["يَئِلُ الَّذي أَمَّنتَ رَوعَتَهُ","وَالعُصمُ في الأَطوادِ لا تَئِلُ",0,"ل",1,0],["يَئِنُّ لها الأبطالُ مِنْ حَذَرِ الرَّدى","أنينَ هَوامي العِيسِ أضْجَرَها العِشْرُ",1,"ر",1,0],["يَئِنُّ كَالمَفؤودِ أَو كَالَّذي","أَصابَهُ سَهمٌ وَلَم يُنزَعِ",2,"ع",1,0],["يَئِنُ إِلى مَسِّ البَلاطِ كَأَنَّما","يَراهُ الحَشايا مِن ذَواتِ الزَخارِفِ",3,"ف",1,0],["يَئِستُ مِنَ الإِنصافِ بَيني وَبَينَهُ","وَمَن لِيَ بِالإِنصافِ وَالخَصمُ يَحكُمُ",4,"م",1,0],["يئس الناسُ إذ تجلى فجلَّ","يت دُجاها بالبأسِ والآراء",5,"ا",2,0],["يئستُ من الصداقة منكَ لما","تمادَى منك إعراضٌ وثيق",6,"ق",1,1],["يئست من قومي حتى لقد","اوشك ان يقتلني يأسي",7,"س",2,0],["يَئِسَت مِنَ الإِنصافِ حَتّى وَهَّمَت","بِاليَأسِ أَنَّ اللَهَ تارِكُها سُدى",8,"د",2,0],["يَئِسَ الحاسِدونَ مِنكَ وَكانوا","أَسَفاً يَنظُرونَ نَحوَكَ حولا",9,"ل",2,0],["يَئِلونَ مِن حَرِّ الحَديدِ وَخَلفَهُم","شُعَلُ الظُبا وَشَواجِرُ الخِرصانِ",10,"ن",1,0],["يَئِسنَ مِنَ اللَحاقِ بِهِنَّ مِنكُم","وَقَد قَطَعوا بِهِنَّ لِوىً حِدابا",11,"ب",2,1],["يَئِسوا من العُقْبَى فتلك نُفوسُهم","تُزجَى جَنازتُها بغيرِ رجاءِ",12,"ا",2,0],["يَئِستُ مِن اِكتِسابِ الخَيرِ لَمّا","رَأَيتُ الخَيرَ وُفُّرَ لِلشِرارِ",13,"ر",1,0],["يُيَسِّرُ أَرْزَاقاً وَيَرْعَى مَرَافقاً","زَكَتْ مَصْدَراً للعَاملينَ وَمَوْرِدَا",14,"د",2,0],["يَئسْتُ منَ الْحَيَاةِ وَكَانَ يَأْسي","يُريحُ النَّفْسَ لَوْ سَكَتَ الضَّميرُ",15,"ر",1,1],["يَئِستُ إِن لَم تَجُد بِعَفوٍ","يَنجو بِهِ عَبدُكَ العَصِيُّ",16,"ي",1,0],["يَئِستُ مِنَ السُلوانِ حَتّى نَكرتُهُ","فَلَو أَنَّني غيلانُ ما سُلِيَت مَيُّ",17,"ي",1,0],["يئستُ من الوَرَى، وَوَثِقْتُ فيمن","يُعِيدُ الرُّوحَ في العظم الرَّمِيم",18,"م",1,0],["يئوى النّعاس لعين من يفرح لئيواىء النّعاس","وأنا مجلوي كل نعسة عين مع أنّي سدر",19,"ر",1,1],["يئست من هاذا الزمان وحصيله","لانّي .. تعبت أثور وأستبشر . الاآلات",20,"ت",1,0],["يئست من هاذا الزمان وحصيله","لانّي .. تعبت أأأأثور وأستبشر .. الااأأت",21,"ت",1,0],["ييا ثغرها ، أمستُ كال","غوَّاص، أَحْلُم بالجواهر",22,"ر",1,0],["يَئِنُّ قلبي على حبيبي","ولا حَبيبٌ إِلّا الخَيال",23,"ل",1,0],["يئست من أن أرى مولى وبصّرني","يأسي من الكبر أن أمشي مع التبع",24,"ع",1,0],["يَيأَسُ الظُلمُ أَن يَكونَ بِأَرضٍ","هُمُ بِها أَو يَجيءُ مِن حَيثُ جاءوا",25,"ا",1,0],["يَئِسَ العائِدِ مِن إِبرائِها","وَسلا العاذِلِ عَنِ سُلوانِها",26,"ن",3,0],["يئن أنيناً يجرح القلب والكلى","يفتت أكباداً ولما يطق صبرا",27,"ر",2,0],["يئستُ فما لي في حياتيَ مطمعٌ","فيا موت عجِّلْ ويك آن أَواني",28,"ن",2,0],["يَئِسَ الناسُ أَن يَنالوا قَديماً","في المَعالي لِسَعيِكُم إِدراكا",29,"ك",2,0],["يئس الصغار من الكبار ولم يعد","من ناصر لهم سوى الأحجار",30,"ر",1,0],["يئست من صبحها حتى التفتُّ إلى","وجهِ العِشاء أعزِّيه عن السَّحَرِ",31,"ر",1,0],["ييأسُ فحلُ الشّولِ من ضربها","لعزّةِ النْفسِ ولم تُكْتَبِ",32,"ب",1,0],["يئستُ واليأس أخو الفوز فلا","أطمع في جمل ولا إجمالها",33,"ل",3,0],["يَئِنُّونَ ليلاً من صَميمِ قُلوبهِمْ","وللشَّوقِ في طيِّ القُلُوبِ نِصَالُ",34,"ل",1,0],["يَئِنُّ أنَّةَ ملْسوعٍ ولا عَجَبٌ","أَراقِمُ الهجْرِ والَهْفاهُ تلْسَعُهُ",35,"ع",2,0],["يَئِستُ مِنَ الحَذِيَّةِ أُمَّ عَمرٍو","غَداةَ إِذ اِنتَحَوني بِالجَنابِ",36,"ب",1,1],["يَئِستُ مِنكَ وَمِن رُوحي فَواعَجَبا","كَيفَ الحَياةُ وَلا رُوحٌ وَلا بَدَنُ",37,"ن",1,0],["يئُوبُ الغائبُونَ وكُلُّ مَيتٍ","يُشَيَّعُ ما لِغَيبَتِه إيابُ",38,"ب",1,0],["يئنُّ أنيناً يُلينُ امْصخورَ","وَيُبكي عَلَيهِ امْأَنينُ امْحماما",39,"م",2,0],["يَئِنُّ فِي أَضْلاعِهَا","شَوْقُ اتِّحادِ المَشْرِقِ",40,"ق",1,0],["يَئِستُ مِنَ الأَقوامِ في كُلِّ بَلدَةٍ","وَإِن أَنَ لَم آيِس فَمَن ذا أُؤَمِّلُ",41,"ل",1,1],["يئست من لاحياة فقيل صبرا","عليه إنه شهرٌ ويمضي",42,"ي",1,0],["يئنّونَ مِمّا أثخَنَ البينُ فيهمُ","أنينَ أسيرِ الثائرينَ المُعذَّب",43,"ب",1,0],["ييا نفس ماذا جوابي حين أسأل عم","ما قد جنيتِ ولا أسطيع إنكارا",44,"ر",2,0],["يَئِستُ مِنَ الدُنيا وَقُلتُ لِصاحِبي","لَئِن عَجِلَت لَلمَوتُ أَوحى وَأَعجَلُ",45,"ل",1,0],["يَئِسوا ثُمَّ غادَروهُ لِطَيرٍ","عُكَّفٍ حَولَهُ عُكوفَ الوُفودِ",46,"د",1,0],["يئن أنين ذي شغف","بظبي زانه الحور",47,"ر",1,0],["يَئِسَ القِصارُ فَلَسنَ مِن نِسوانِها","وَمماشِهِنَّ لَها مِنَ الحُسّادِ",48,"د",1,0],["ييمن إِمامٍ أَنتُمُ في ظِلالِهِ","يُدافِعُ عَنكثم رَأيُهُ وَذَوابِلُه",49,"ل",2,0],["يَئِسَتْ يُعيِدُ الدُّهْرُ سَالِفَ مَجْدِهَا","بِمَسيلِ أَوْدِيَةٍ إلى الغُدْرانِ",50,"ن",1,0],["ييت الزبير وشِفْت الاشْرَافْ","يَا الرَّبْع مِتْغَثْبِر حِشايَه",51,"ا",3,1],["ييتال فِيْ ثوبٍ مْشَيَّر","يَا مِنْ يذَرّيني بِالِجْنان",52,"ن",1,0],["يئن إذا أومضت رنة","ويزرأ منها زئير الأسود",53,"د",1,0],["يئسوا من فضل رب","جل شاناً وهو قادر",54,"ر",1,0],["يئدُّ مظاهر الادراع منه","مضمَّرة الحشا قبّاً بطونا",55,"ن",2,0],["ى يَدعو لك السَعدُ بالتَوفيقَ يَقرنهُ","حسن الثنالكَ في الاسحارِ والأَصلِ",56,"ل",1,0],["ييرمي بلحظيه القلوب وسهمه","فعجبت كيف تشابه السهمان",57,"ن",1,0],["يئنُ اذا الحدائدُ أَوجعتْهُ","ولا يَشفي من الوجعِ الأنينُ",58,"ن",1,0],["يئستُ من العِراقِ وساكنيها","فلولا اللهُ وابنُ المرزبانِ",59,"ن",1,0],["يئن من سقم فتبكي رحمةً","له نساؤه وشجواً تندب",60,"ب",1,0],["يئن لبعد الدار من فرط لوعةٍ","وأوصافك الغرّا بشوقٍ تجاوبه",61,"ب",2,0],["يئدون البنات من غير ذنب","وهو اثم من أكبر الآثام",62,"م",1,0],["يئن لاثقال وَقَد شابَ راسه","وَفي عنفوان العيش ذا الراس شائب",63,"ب",1,0],["يئن وهو يناجي النفس مضطرباً","ويلا علام أرى الأرغوسة أنهزموا",64,"م",3,0],["يئن وما بنت الأراكة مثله","وأنى لها جفن كما الغيث هاميا",65,"ي",2,0],["ييممن الغدير فمن مهاة","مضمرة ومن رشأ غرير",66,"ر",1,0],["يَئِستُ أَنْ تُفْتدى أَفئِدةٌ","أُسِرَت بين فتور وفتون",67,"ن",1,0],["يئنى على عز العزيز ومجده","ويقول اني بالحبور أحور",68,"ر",1,0],["يئست من الدنيا فما صرت أطلبُ","وأصبحت ُ ممن كنت أرجوه ُ أهربُ",69,"ب",1,1],["يئِسَت ْ نفسي بعد طول ِ الأمل ْ","وأصاب َ الفؤاد َ سهم ُ الملل ْ",70,"ل",1,1],["يئستُ على أنّي الصبور بطبعهِ","وقد ضرّني الدهرُ الكئيب بنفعهِ",71,"ع",2,1],["يَئِنُّ مِن الحُرُوفِ الخُضْرِ لَيْلًا","كَمَا يَتَكَبَّدُ الوَحْيَ النَّبيّ",72,"ب",2,0],["يئستْ وليس هناك من أملٍ","في أن ترى إطلالةَ الفجر",73,"ر",1,0],["يئن من الطوى خاوٍ خميصٌ","ويرنو للسما صادٍ هيوف",74,"ف",1,0],["يئنُّ على جوى النيرانِ لحنٌ","فيلظى عزفُ آمالي سرابا",75,"ب",2,0],["يَئِسَ الَّذِينَ الْيَوْمَ كيدا يكَفَرُوا","من دِينِنا، جَمَعوا لنا يَغْزونا",76,"ن",2,1],["ي- ياللي طلب باسم الهوى عذب شله","ب- بنيتها لك عجز صدر المثايل",77,"ل",1,0],["ي- يوم أصله يحسب علي المذله","م- ما يدري ان الوصل قالت وقايل",77,"ل",1,0],["ي- يا من سكن باقصى الحشى واستحله","ك- كلي لك انت وما بقى للعذايل",77,"ل",1,0],["ي- يا من خياله وسط عيني محله","م- من حيث ما لد النظر بيك شايل",77,"ل",1,0],["ي- يا وقت لو بعدت خلي مذله","ل- لي بيننا عدل وان الوقت مايل",77,"ل",1,0],["يئن لا الورق لو أنت على وكن","بنعي ثكلي يهد الطود مسمعه",78,"ع",2,0],["يئنُّ فؤادي بنبضٍ حزينٍ","فتجري دموعي بملءِ العيونْ",79,"ن",1,0],["يئس العذول فكف من غلوائه","حتى شككت أعاذ لي أم عاذري",80,"ر",2,0],["يئست من الدار التي كنت أرتجي","وما كنت أرجو غير ما كنت خاشيا",81,"ي",2,0],["يئز مرجل حرفيها ليُكسِبَها","من التلاحم معنى فيه منسجم",82,"م",1,0],["يئن الرضيع ويبكي دما","وشيخ البلاد أضاع النظر",83,"ر",1,0],["يَئنُ النَخْلُ منْ وَجَعي وَحُزني","ويحرقني إذا سَجَعَ الحَمَامُ",84,"م",1,0],["يئنُّ فؤادي كيفَ أمسحُ دمعَهُ","وليس سوى ربِّ القلوبِ مجيرُ",85,"ر",1,0],["ي يا من تمتعَ بالجمالِ وسحرِه","إن الجمالَ تبخُّرٌ وزوالُ",86,"ل",1,1],["يَئِسْتُ منكِ فلمْ أفرَحْ بخاطِرةٍ","سِرّاً لتَحْكيهِ أو قولاً تقوليهِ",87,"ي",2,0],["يئِسْتُ مِنْ مائِكِ المَسْكوبِ تشْرَبُهُ","حتى الكلابُ ولم تشرَبْ شواطيهِ",87,"ي",2,0],["يئِسْتُ مِنْ ظلِّكِ المَمْدودِ نامَ بهِ","كلُّ الرُّعاةِ وممنوعٌ لراعيهِ",87,"ي",2,0],["يئِسْتُ مِنْ طَلْحِكِ المنضودِ تأكُلُهُ","كلُّ الرُّعاةِ ولم يَأْكُلْهُ ساقيهِ",87,"ي",2,0],["يئِسْتُ مِنْ دِجْلةَ الزّرْقاءِ ما ترَكَتْ","عُمْراً على شارعِ السّعْدونِ نقضيهِ",87,"ي",2,0],["يئن لنزف الطيبين ودمعهم","وأوجاع أطفال تُقاد إلى الردى",88,"د",2,0],["يُيَتمُ أطفالي، تُرمَّلُ نسوتي","ويَملأُ قَبري نسوةٌ ومُيتَم",89,"م",1,0],["يَ يعاديني عقب غيره","وآنا أشوفه حسبة اسنادي",90,"د",2,0],["يئنُ الرَعدُ من اشجانِها المَاً","له دانَتْ جُموعُ الغيمِ والمطرُ",91,"ر",1,0],["يئن الحبيب لفرط النّوى","وروحي تئن لفقدالصواب",92,"ب",1,0],["يئست منه ولكن فيك لي أمل","يا رب أنت الذي يا رب تنجيه",93,"ي",2,0],["يئن كمن يفارق توأمًا. هلْ","يعيشُ الحبرُ ان ذابت سطورُ",94,"ر",1,0],["يئنّ العراق وما مِن صدىً","وتغرق مصر بضوضائها",95,"ا",3,0],["يئن إذا أومضت رنة","ويزرأ منها بثوب جديد",96,"د",1,0],["يئنّ الحرُ إن أضحى بوجد","فؤادٌ هاله في العزم رقُّ",97,"ق",1,0],["يئنٌ الشوق في قلب المعنى","به الآهات لا تخفي كلاما",98,"م",2,0],["يئنُّ الورد من حقل لحقل","لكي ترنو إليه مقلتاكِ",99,"ك",1,0],["يئن الورد مثلي في اشتياق","إليك وطول بُعدك في ارتباكِ",99,"ك",1,0],["يُيَسّر أمري بلا أي عسْرٍ","ويغمر قلبي إخاءً وحدْبا",100,"ب",2,0],["يئست فما أجدي علي النفس يأسها","فيأسي من يأسي بنفسي أمثل",101,"ل",1,0],["يَئِست ُ جداً أنا.. فما العَمَلُ؟","قولي وعينيك ِ أنت ِ.. ما العملُ؟",102,"ل",1,1],["ي / يبيني أويبي مني يبين البين بيّناه","وتبين البيّنه ويبان مابينه ومابيني",103,"ن",2,0],["ييجوا العيال اللي يهرهر واللي يبربر","ودا اللي اقرع واللي اعور واللي له خزام",104,"م",1,0],["يئن من السقم الذي مس جذعه","وكن هدّ قلب العاشقين سقام!",105,"م",1,0],["يئن من السقم الذي مّس جذعه","وكم هدّ قلب العاشقين سقام",106,"م",1,0],["يَئِستُ مِنَ الأَصحابِ وَالحُبُّ زائِلُ","وَأَسبابُ يَأسي أَنَّني لا أُخاتِلُ",107,"ل",1,1],["يئسوا من رضى اليمانين عنهم","فاستماحوا الرضى وراء الحدود",108,"د",1,0],["يئستُ من الدنيا ورجعةِ عِزِّها","كما يئس الأعرابُ من رجعةِ القُدس",109,"س",1,0],["يئنُّ الحَنِيْنُ بِمَرِّ السِّنين","ويزداد شوقي إليك احْتِداما",110,"م",2,0]]}