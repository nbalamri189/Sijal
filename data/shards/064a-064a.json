{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[86,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[72,"يئست من الصداقة منك لما","https://www.aldiwan.net/poem19431.html","الوافر"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[45,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[28,"يئسن من اللحاق بهن منكم","https://www.aldiwan.net/poem4953.html","الوافر"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43860","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43658","الطويل"],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[85,"عَرَضوا الأَمانَ على الخواطرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9549&r=&rc=39",""]],"verses":[["يَئِلُ الَّذي أَمَّنتَ رَوعَتَهُ","وَالعُصمُ في الأَطوادِ لا تَئِلُ",0,"ل",1,0],["يَئِنُّ لها الأبطالُ مِنْ حَذَرِ الرَّدى","أنينَ هَوامي العِيسِ أضْجَرَها العِشْرُ",1,"ر",1,0],["يَئِنُّ كَالمَفؤودِ أَو كَالَّذي","أَصابَهُ سَهمٌ وَلَم يُنزَعِ",2,"ع",1,0],["يَئِنُ إِلى مَسِّ البَلاطِ كَأَنَّما","يَراهُ الحَشايا مِن ذَواتِ الزَخارِفِ",3,"ف",1,0],["يَئِستُ مِنَ الإِنصافِ بَيني وَبَينَهُ","وَمَن لِيَ بِالإِنصافِ وَالخَصمُ يَحكُمُ",4,"م",1,0],["يئس الناسُ إذ تجلى فجلَّ","يت دُجاها بالبأسِ والآراء",5,"ا",2,0],["يئستُ من الصداقة منكَ لما","تمادَى منك إعراضٌ وثيق",6,"ق",1,1],["يئست من قومي حتى لقد","اوشك ان يقتلني يأسي",7,"ي",1,0],["يَئِسَت مِنَ الإِنصافِ حَتّى وَهَّمَت","بِاليَأسِ أَنَّ اللَهَ تارِكُها سُدى",8,"د",2,0],["يَئِسَ الحاسِدونَ مِنكَ وَكانوا","أَسَفاً يَنظُرونَ نَحوَكَ حولا",9,"ل",2,0],["يَئِلونَ مِن حَرِّ الحَديدِ وَخَلفَهُم","شُعَلُ الظُبا وَشَواجِرُ الخِرصانِ",10,"ن",1,0],["يَئِسنَ مِنَ اللَحاقِ بِهِنَّ مِنكُم","وَقَد قَطَعوا بِهِنَّ لِوىً حِدابا",11,"ب",2,1],["يَئِسوا من العُقْبَى فتلك نُفوسُهم","تُزجَى جَنازتُها بغيرِ رجاءِ",12,"ا",2,0],["يَئِستُ مِن اِكتِسابِ الخَيرِ لَمّا","رَأَيتُ الخَيرَ وُفُّرَ لِلشِرارِ",13,"ر",1,0],["يُيَسِّرُ أَرْزَاقاً وَيَرْعَى مَرَافقاً","زَكَتْ مَصْدَراً للعَاملينَ وَمَوْرِدَا",14,"د",2,0],["يَئسْتُ منَ الْحَيَاةِ وَكَانَ يَأْسي","يُريحُ النَّفْسَ لَوْ سَكَتَ الضَّميرُ",15,"ر",1,1],["يَئِستُ إِن لَم تَجُد بِعَفوٍ","يَنجو بِهِ عَبدُكَ العَصِيُّ",16,"ي",1,0],["يَئِستُ مِنَ السُلوانِ حَتّى نَكرتُهُ","فَلَو أَنَّني غيلانُ ما سُلِيَت مَيُّ",17,"ي",1,0],["يئستُ من الوَرَى، وَوَثِقْتُ فيمن","يُعِيدُ الرُّوحَ في العظم الرَّمِيم",18,"م",1,0],["ييا ثغرها ، أمستُ كال","غوَّاص، أَحْلُم بالجواهر",19,"ر",1,0]]}