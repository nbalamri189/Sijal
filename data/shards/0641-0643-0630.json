{"poems":[[55,"إذا ما شئت أن تصنع","https://www.aldiwan.net/poem26264.html","الهزج"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[88,"خطاب يهودا قد دعانا إلى الفكر","https://www.aldiwan.net/poem44821.html","الطويل"],[23,"هل سر أولاد اللقيطة أننا","https://www.aldiwan.net/poem21401.html","الكامل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[89,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[28,"وجدنا خزاعيا رسنة مازن","https://www.aldiwan.net/poem5190.html","الطويل"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[48,"كن لمن لام عصيا","https://www.aldiwan.net/poem66624.html","مجزوء الرمل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"تق الله واحذر أن يغرك ناسك","https://www.aldiwan.net/poem23209.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[116,"لله في طي هذا الكون آيات","https://www.aldiwan.net/poem41202.html","عموديه"],[130,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[183,"لفتى بني العبسي أكرم مضجع","https://www.aldiwan.net/poem61070.html","الكامل"],[186,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[230,"ليس من ساد عن وراثته جد","https://www.aldiwan.net/poem51189.html","الخفيف"],[271,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[271,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[282,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[288,"لقد نظرت عنز إلى الجزع نظرة","https://www.aldiwan.net/poem1906.html","الطويل"],[365,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[378,"عيني تلت ما سطرته يميني","https://www.aldiwan.net/poem59232.html","الكامل"],[404,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[404,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[410,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[417,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[465,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[574,"وخبرني الناعون ما صنع الردى","https://www.aldiwan.net/poem3657.html","الطويل"]],"verses":[["فَكَذِّبها بِما قاسَت","وَكَذِّبهُ بِما قاسى",0,"س",2,0],["فَكَذَّبوها بِما قالَت فَصَبَّحَهُم","ذو آلِ حَسّانَ يُزجي المَوتَ وَالشِرَعا",1,"ع",2,0],["فكذّب وأنت الحرّ مَن ساء ظنّه","فقد قيل إن الوعد دّين على الحرّ",2,"ر",1,0],["فَكَذاكَ إِنَّ جِيادَنا مَلبونَةٌ","وَالحَربُ مُشعَلَةٌ بِريحِ غَوادِ",3,"د",1,0],["فكذاك الصديقُ يصلح للسا","عة دون الإصباح والإمساءِ",4,"ا",2,0],["فكذاك نار الهُون تَرْأم أهلها","حتى كأنَّهُمُ لها أولادُ",5,"د",1,0],["فَكَذاكَ نَكهَتُها إِذا نَبَّهتَها","وَالجِلدُ غَيرُ مُدَرَّنٍ مِتفالِ",6,"ل",1,0],["فكذبني للجهل فيما صدقته","واي صريح ماله من مكذب",7,"ب",1,0],["فَكَذَّبَها مِن قَومِها كُلُّ خائِنٍ","وَقَد جاءَهُم بِالحَقِّ عَنهُم نَذيرُها",8,"ر",3,0],["فكذبنا وأبى الله","لنا والشيم الحسنى",9,"ن",2,0],["فَكَذَّبتَ نَفسَكَ في الحالَتَينِ","وَلَم تَعلَمِ الشَهدَ مِن صابِها",10,"ب",3,0],["فكذا كلُّ فتىً","أصبحَ شاهاً هُرمزيّا",11,"ي",2,0],["فَكَذاكَ ذَلِكَ إِذ رَفَعتُ قُيودَهُ","أُصُلاً وَمَيثَرَتي عَلى أَصلابِهِ",12,"ب",2,0],["فَكَذِّب زَعيماً قالَ إِنّي دَيِّنٌ","فَما دينُهُ إِلّا ضَعيفُ اِنتِحالِهِ",13,"ل",2,0],["فكَذَاكَ الرِّقُّ يُدْنِي مِنْ عُلىً","وَيُعِيدُ الأُمَّةَ الْحُرَّةَ عُرى",14,"ر",2,0],["فكذب الله والابرار قائلهم","ودنست دينهم تلك الروايات",15,"ت",1,0],["فكذاك في شرَكِ الرَجاء","قلبي يلذُّ له الغِناء",16,"ا",2,0],["فَكَذَّبَ ظَنَّ مَن عاداكَ صِدقٌ","تَساوى فيهِ وَعدُكَ وَالوَعيدُ",17,"د",1,0],["فكذبه إذ قال فازوا بقربه","باعمالهم لامته منه توهب",18,"ب",1,0],["فكذبه يا هذا تكن خير مؤمن","وإلا فصدقه تكن شر كافر",19,"ر",1,0],["فَكَذا المَلائكُ قَبلَ تاريخي لَقَد","جاءَت فَزارَت بَيتَ اِبرهيمِ",20,"م",1,0],["فكذا عَهِدتُ الدهرَ منذ عرفتُه","والمالَ والإِخوان والْخُلاّنا",21,"ن",2,0],["فكذا تُبْتَنى المكارمُ والمج","دُ ويُسْتبعَد العدوُّ المُلاحي",22,"ح",2,0],["فكذا أمانيُّ الشّعوب تَلاطَمَت","وقُلوبُها انفتحت لنورِ رَجاء",23,"ا",2,0],["فكذا أؤملُ أن تصيري دولةً","كبرى بنظمِ فريدكِ المتنثِّر",24,"ر",1,0],["فكذبهمُ يا ليت أنك مثلهمُ","تواترَ أخبار وصدق مآلك",25,"ك",1,0],["فَكَذَّبَها سُكّانُ جَوٍّ فَصُبِّحوا","بِتِسعينَ أَلفاً كَالأُسودِ الضَراعِمِ",26,"م",1,0],["فكُذِّبَ في دَعْوَى الهوَى وهْو صادقٌ","وصُدِّقَ للواشِينَ فيه كِذاب",27,"ب",1,0],["فكذاك ضلّوا عن يسوع بمكرهم","وغدَوا جُثِيّاً بَعدَه بدُجُون",28,"ن",1,0],["فكذا طباعك غير منكرة","في عكس ما نرجوه والطرد",29,"د",1,0],["فكذبته من هوله ثم ردني","رسائل أعلام أتت وثقات",30,"ت",1,0],["فكذَاك عادَ وفُودُ با","بِكَ مُثْقَلينَ نَثاً ومَالاَ",31,"ل",2,0],["فكذَاك فضلُك مثلُ عَدْ","لِك في الدُّنَا سارَا وجَالا",31,"ل",2,0],["فكذاك البياض وهو نقيٌّ","مُبْتلى في نقائه بالسَّواد",32,"د",1,0],["فكذاك ما نشرت فضيلةُ ماجد","إلا بطيّ مفاوز وسمالق",33,"ق",1,0],["فكذلك الإبهامُ فهوَ مقدَّمٌ","عند الحِساب يُعدُّ بعد الخِنصرِ",34,"ر",1,0],["فكذبوه مثل ما قد كذبوا","آباءه من قبله وانقلبوا",35,"ب",3,0],["فكذبوا مقاله وقالوا","جميع ما تقوله ضلال",35,"ل",1,0],["فَكَذَّبتُ ما قالوا وَإِن كانَ صادِقاً","فَيا خَيرَ مُنعىً وَشَرَّ نُعاتِ",36,"ت",1,0]]}