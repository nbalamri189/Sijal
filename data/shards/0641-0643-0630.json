{"poems":[[57,"إذا ما شئت أن تصنع","https://www.aldiwan.net/poem26264.html","الهزج"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[90,"خطاب يهودا قد دعانا إلى الفكر","https://www.aldiwan.net/poem44821.html","الطويل"],[23,"هل سر أولاد اللقيطة أننا","https://www.aldiwan.net/poem21401.html","الكامل"],[53,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[53,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[31,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[91,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[30,"وجدنا خزاعيا رسنة مازن","https://www.aldiwan.net/poem5190.html","الطويل"],[63,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[68,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[50,"كن لمن لام عصيا","https://www.aldiwan.net/poem66624.html","مجزوء الرمل"],[52,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[48,"تق الله واحذر أن يغرك ناسك","https://www.aldiwan.net/poem23209.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[119,"لله في طي هذا الكون آيات","https://www.aldiwan.net/poem41202.html","عموديه"],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[186,"لفتى بني العبسي أكرم مضجع","https://www.aldiwan.net/poem61070.html","الكامل"],[189,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[234,"ليس من ساد عن وراثته جد","https://www.aldiwan.net/poem51189.html","الخفيف"],[275,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[286,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[292,"لقد نظرت عنز إلى الجزع نظرة","https://www.aldiwan.net/poem1906.html","الطويل"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[382,"عيني تلت ما سطرته يميني","https://www.aldiwan.net/poem59232.html","الكامل"],[409,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[409,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[415,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[422,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[469,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[519,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"وخبرني الناعون ما صنع الردى","https://www.aldiwan.net/poem3657.html","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96363","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56024","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144148","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109024","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46486","الكامل"],[2142,"","https://poetry.dctabudhabi.ae/diwan/poem/35068","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27555","الكامل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124053","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110005","الرجز"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202370",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114259","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111412","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58169","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67506","الكامل"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143619","الكامل"],[4755,"لِلحُزنِ في وطني \"السّعيدِ\" مَنازلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=196917",""],[4858,"لهيب الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=29686",""],[4858,"شوق والد إلى أولاده","https://www.poetsgate.com/ViewPoem.aspx?id=30458",""],[5145,"أعينا فؤادي على ما يعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108214",""],[5212,"إنجيلُ الحُسين","https://www.poetsgate.com/ViewPoem.aspx?id=212069",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[709,"خفرت بسيف الغنج ذمّة َ مِغفَري","https://www.poetsgate.com/ViewPoem.aspx?id=2880",""],[5690,"خلَعَ الزمان الآن ثوب حداحدهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172149",""],[5829,"لو تعلمين","https://www.poetsgate.com/ViewPoem.aspx?id=160313",""],[6051,"بَانَتْ لِطِيَّتِها الغَداةَ جَنُوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=85169",""],[6068,"إن الرجال مواقفُ -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175909",""],[186,"لفتى بني العبسي أكرم مضجع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55997&r=&rc=260",""]],"verses":[["فَكَذِّبها بِما قاسَت","وَكَذِّبهُ بِما قاسى",0,"س",2,0],["فَكَذَّبوها بِما قالَت فَصَبَّحَهُم","ذو آلِ حَسّانَ يُزجي المَوتَ وَالشِرَعا",1,"ع",2,0],["فكذّب وأنت الحرّ مَن ساء ظنّه","فقد قيل إن الوعد دّين على الحرّ",2,"ر",1,0],["فَكَذاكَ إِنَّ جِيادَنا مَلبونَةٌ","وَالحَربُ مُشعَلَةٌ بِريحِ غَوادِ",3,"د",1,0],["فكذاك الصديقُ يصلح للسا","عة دون الإصباح والإمساءِ",4,"ا",2,0],["فكذاك نار الهُون تَرْأم أهلها","حتى كأنَّهُمُ لها أولادُ",5,"د",1,0],["فَكَذاكَ نَكهَتُها إِذا نَبَّهتَها","وَالجِلدُ غَيرُ مُدَرَّنٍ مِتفالِ",6,"ل",1,0],["فكذبني للجهل فيما صدقته","واي صريح ماله من مكذب",7,"ب",1,0],["فَكَذَّبَها مِن قَومِها كُلُّ خائِنٍ","وَقَد جاءَهُم بِالحَقِّ عَنهُم نَذيرُها",8,"ر",3,0],["فكذبنا وأبى الله","لنا والشيم الحسنى",9,"ن",2,0],["فَكَذَّبتَ نَفسَكَ في الحالَتَينِ","وَلَم تَعلَمِ الشَهدَ مِن صابِها",10,"ب",3,0],["فكذا كلُّ فتىً","أصبحَ شاهاً هُرمزيّا",11,"ي",2,0],["فَكَذاكَ ذَلِكَ إِذ رَفَعتُ قُيودَهُ","أُصُلاً وَمَيثَرَتي عَلى أَصلابِهِ",12,"ب",2,0],["فَكَذِّب زَعيماً قالَ إِنّي دَيِّنٌ","فَما دينُهُ إِلّا ضَعيفُ اِنتِحالِهِ",13,"ل",2,0],["فكَذَاكَ الرِّقُّ يُدْنِي مِنْ عُلىً","وَيُعِيدُ الأُمَّةَ الْحُرَّةَ عُرى",14,"ر",2,0],["فكذب الله والابرار قائلهم","ودنست دينهم تلك الروايات",15,"ت",1,0],["فكذاك في شرَكِ الرَجاء","قلبي يلذُّ له الغِناء",16,"ا",2,0],["فَكَذَّبَ ظَنَّ مَن عاداكَ صِدقٌ","تَساوى فيهِ وَعدُكَ وَالوَعيدُ",17,"د",1,0],["فكذبه إذ قال فازوا بقربه","باعمالهم لامته منه توهب",18,"ب",1,0],["فكذبه يا هذا تكن خير مؤمن","وإلا فصدقه تكن شر كافر",19,"ر",1,0],["فَكَذا المَلائكُ قَبلَ تاريخي لَقَد","جاءَت فَزارَت بَيتَ اِبرهيمِ",20,"م",1,0],["فكذا عَهِدتُ الدهرَ منذ عرفتُه","والمالَ والإِخوان والْخُلاّنا",21,"ن",2,0],["فكذا تُبْتَنى المكارمُ والمج","دُ ويُسْتبعَد العدوُّ المُلاحي",22,"ح",2,0],["فكذا أمانيُّ الشّعوب تَلاطَمَت","وقُلوبُها انفتحت لنورِ رَجاء",23,"ا",2,0],["فكذا أؤملُ أن تصيري دولةً","كبرى بنظمِ فريدكِ المتنثِّر",24,"ر",1,0],["فكذبهمُ يا ليت أنك مثلهمُ","تواترَ أخبار وصدق مآلك",25,"ك",1,0],["فَكَذَّبَها سُكّانُ جَوٍّ فَصُبِّحوا","بِتِسعينَ أَلفاً كَالأُسودِ الضَراعِمِ",26,"م",1,0],["فكُذِّبَ في دَعْوَى الهوَى وهْو صادقٌ","وصُدِّقَ للواشِينَ فيه كِذاب",27,"ب",1,0],["فكذاك ضلّوا عن يسوع بمكرهم","وغدَوا جُثِيّاً بَعدَه بدُجُون",28,"ن",1,0],["فكذا طباعك غير منكرة","في عكس ما نرجوه والطرد",29,"د",1,0],["فكذبته من هوله ثم ردني","رسائل أعلام أتت وثقات",30,"ت",1,0],["فكذَاك عادَ وفُودُ با","بِكَ مُثْقَلينَ نَثاً ومَالاَ",31,"ل",2,0],["فكذَاك فضلُك مثلُ عَدْ","لِك في الدُّنَا سارَا وجَالا",31,"ل",2,0],["فكذاك البياض وهو نقيٌّ","مُبْتلى في نقائه بالسَّواد",32,"د",1,0],["فكذاك ما نشرت فضيلةُ ماجد","إلا بطيّ مفاوز وسمالق",33,"ق",1,0],["فكذلك الإبهامُ فهوَ مقدَّمٌ","عند الحِساب يُعدُّ بعد الخِنصرِ",34,"ر",1,0],["فكذبوه مثل ما قد كذبوا","آباءه من قبله وانقلبوا",35,"ب",3,0],["فكذبوا مقاله وقالوا","جميع ما تقوله ضلال",35,"ل",1,0],["فَكَذَّبتُ ما قالوا وَإِن كانَ صادِقاً","فَيا خَيرَ مُنعىً وَشَرَّ نُعاتِ",36,"ت",1,0],["فكذَّبوا مَن دَعا للخير واجتنبوا","ما قالَ وامتلأت آذانُهم صَمَما",37,"م",2,0],["فكذاك القناة يكسر يوم الروع","منها صدر وتبقى كعوب",38,"ب",1,0],["فكذا الذي أرسلتها كم يقتضي","لتمام غايتها ضروب تزانُ",39,"ن",1,0],["فكذا سليمان النبيّ غدا على","كرسيّه جسدا له مرّيد",40,"د",1,0],["فكذبٌ بلا إثمٍ وبأس بلا قوى","وسكرٌ بلا خمرٍ وشغلٌ بلا كسب",41,"ب",1,0],["فكذا الله لما أنت","له مالكٌ خالق نفعاً وضر",42,"ر",1,0],["فكذاك الله إذ قدره","لم يكن أحدثه دون اليسر",42,"ر",1,0],["فَكَذا الزَمان بِأَهلِهِ مُتَقَلب","لا البُؤس فيهِ وَلا النَعيم يَدوم",43,"م",1,0],["فَكَذاكَ مُثريهِمُ وَمُقتِرُهُم","أَكرِم بِمُقتِرِهِم وَبِالمُثري",44,"ر",2,0],["فكذا تعين قصدُه فيما جرى","وهو المراد وذاك عين المبتغى",45,"غ",2,0],["فكذاك الهوى إذا الوصل واتى","كان قطفاً من يانعات كروم",46,"م",1,0],["فَكَذَاكَ أيضاً لَم يَزَل مُتَكَلِّماً","بَل فَاعِلاً مَا شَاءَ ذَا إحسَانِ",47,"ن",1,0],["فَكَذَاكَ أيضاً وَحدَهُ فَاعبُدهُ لاَ","تَعبُد سِوَاهُ يَا أخَا العِرفَانِ",47,"ن",1,0],["فكذاك عاقبةُ المغرْ","رِرِ نفسَه مهما طلَب",48,"ب",1,0],["فكذَّبت تعمُّداً","بِيعةَ رُوما الصادِقه",49,"ق",2,0],["فكذا فعل الموازين","التي ليست تحيف",50,"ف",1,0],["فكَذا التمازُجُ مَع هواهُ بمُهجَتي","كتمازجِ البَيتَينِ في ذا الدفتَر",51,"ر",1,0],["فكذبوا بكلام الله في غدهم","إن الكذوب يلاحي وهو مخجول",52,"ل",1,0],["فكذلك الأرباب فتنتهم","صدعت وزفس من العلى رعدا",53,"د",2,0],["فكذَا ثَوى النِّدَّانِ مَولَى إِيفيا","وثِراقَةٍ قَتلاً بِذاكَ النَّادي",54,"د",2,0],["فَكَذا أَنما مَمنُونُ حَضَّ شَقِيقَهُ","ولِخًيمِ نَسطورَ الحَكِيمِ تَقَدَّما",55,"ا",1,0],["فَكَذا بِرَوَّاعِ السِّلاحِ تَقَدَّما","وإِذا بِطَيرٍ سارَ عَن يُمنَاهُما",55,"ا",1,0],["فَكَذَا بِفَصلِ القَولِ خَاطَبَهُم وَعا","دَ الجيشُ للشُّورَى بأَعلى ضَجَّةِ",56,"ه",1,0],["فَكَذَا انتَهَى وَاحتَلَّ مَجلِسَهُ","وَبِهِم رَقى نَسطُورُ مُنتصِبا",57,"ب",2,1],["فكذلكَ الدنيا فسَكْرَةُ جاهلٍ","والموتُ فهْوَ موقظُ السكرانِ",58,"ن",1,0],["فكذاك يفعل بالجما","ل لنحرها في كلّ جمعهْ",59,"ه",1,0],["فكذاك شمسُ الدَّجْنِ، في اَبراجها","تعلو، وبُرْجُ هبوطِها المِيزانُ",60,"ن",1,0],["فَكَذَبتُ إِذ صَدَّقتُ أَنّي كاذبٌ","إِنَّ المُصَدِّقَ لِلكَذُوبِ كَذوبُ",61,"ب",1,0],["فكذا خُلِقتُ، وفي المشاعرِرقّةٌ","يلوي بها الإعصارُ وهو مَهيبُ",62,"ب",1,0],["فكذا نشأتم عارفْيَن لربكمْ","وكَذا التّقيّ يخافُ يومَ حسابِ",63,"ب",1,0],["فكذراني عهد سعدى وقد","أتى دونها الحبت والرقتان",64,"ن",1,0],["فَكَذاكَ أَنتَ مِنَ الحُسينِ لَمُرسَلٌ","ثِقة ٌ وكُفؤٌ لِلورى ورسولِ",65,"ل",1,0],["فكذا حجاب القلب كان هو الهوى","والنفس من أحراه بالإضلال",66,"ل",1,0],["فَكَذَلِكَ الإِبْهَامُ فَهْوَ مُقَدَّمٌ","عندَ الحسابِ يعدُّ بعدَ الخصبرِ",67,"ر",1,0],["فكذا جهاد الظلم ألجا أن ترى","في قطرنا لتكون روح بلادهِ",68,"د",2,0],["فكذا فؤادي مذ دخلتِ مهجتي","بات الشقي مكبلاً ومطوقا",69,"ق",2,0],["فَكَذَاكَ حَقّاً مَنْ يُعمَّرْ يُبْلِهِ","كَرُّ الزَّمَانِ عَلَيْهِ والتَّقْلِيبُ",70,"ب",1,0],["فكذا رأيت أكابرا","إن الرجال مواقفُ",71,"ف",1,0],["فكذا الملائك قبل تاريخي لقد","جاءت فزارت بيت إبراهيم",72,"م",1,0]]}