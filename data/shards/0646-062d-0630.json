{"poems":[[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204369","الكامل"],[4767,"فداك الكون","https://www.poetsgate.com/ViewPoem.aspx?id=178772",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""]],"verses":[["نَحذَرُ المَنونَ وَلا","بُدَّ مِن مُقَدَّرِها",0,"ر",3,0],["نح ذكرى الهوى وعهد الغرام","وتمسك بالجد لا الأوهام",1,"م",1,1],["نحذر منك النائبات فتحذر","وتذكر للخطب الجسيم فيصغر",2,"ر",1,1],["نُحذِّر من عواقبِها","ونفعلها ونفتعل",3,"ل",1,0],["نَحْذو خُطى الغَرْبِ أمْريكا وكتْلَتِها","وكتْلَةِ الشَّرْقِ أهْلِ الصّينِ والرّوسِ !",4,"س",1,0],["نُحَذِّر بعضاً: بأنَّ ابتلاعَ ال","بذورِ بقشرٍ يضرُّ الحُلوقْ",5,"ق",1,0]]}