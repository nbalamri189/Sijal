{"poems":[[56,"ولما وردنا ماء بيشة لم يكن","https://www.aldiwan.net/poem27648.html","الطويل"],[49,"هي الدار من سلمى وهاتي المرابع","https://www.aldiwan.net/poem25232.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[74,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[74,"يخيل لي برق من الثغر لامع","https://www.aldiwan.net/poem19168.html","الطويل"],[53,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[53,"بني وهب الله جار لكم","https://www.aldiwan.net/poem66482.html","المتقارب"],[47,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[82,"رددت الملام على العاذلين","https://www.aldiwan.net/poem31275.html","المتقارب"],[82,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[89,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[83,"طليق دموعي في الغرام مسلسل","https://www.aldiwan.net/poem61331.html","الطويل"],[48,"إذا قلت فوائدنا جفينا","https://www.aldiwan.net/poem22901.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[108,"بيوت الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179528",""],[47,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[113,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[113,"على ذات القرنفل قد حططنا","https://www.aldiwan.net/poem16311.html","الوافر"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[190,"ولما صح لي تدقيق فكر","https://www.aldiwan.net/poem43243.html","الوافر"],[240,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[302,"تجن واعتب تجد مني بذاك رضا","https://www.aldiwan.net/poem33182.html","البسيط"],[331,"ولما وليت ذكرت النب","https://www.aldiwan.net/poem44244.html","المتقارب"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[354,"لقد قبض اليأس بسط الرجا","https://www.aldiwan.net/poem15555.html","المتقارب"],[369,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[412,"يغالبني فرط الغرام على الصبر","https://www.aldiwan.net/poem50164.html","الطويل"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[415,"ولما وقفنا للوداع عشية","https://www.aldiwan.net/poem32417.html","الطويل"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[463,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[463,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[469,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[469,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[469,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[482,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[505,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[518,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[543,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[556,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[556,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[556,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110424","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82241","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72325","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121056","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64816","الطويل"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146944","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80012","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49024","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11998","الطويل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36192","الطويل"],[1700,"","https://poetry.dctabudhabi.ae/diwan/poem/105576","المتقارب"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118406","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110333","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102150","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27913","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2372,"","https://poetry.dctabudhabi.ae/diwan/poem/146241","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83207","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58258","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109795","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74185","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132601","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87448","الوافر"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100182","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99366","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89415","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88955","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62907","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91153","الطويل"],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143539","الطويل"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138047","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116083","الطويل"],[185,"أميم منك الدار غيرها البلى","https://www.poetsgate.com/ViewPoem.aspx?id=186042",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[5197,"يثرب","https://www.poetsgate.com/ViewPoem.aspx?id=131029",""],[5206,"نور العلم","https://www.poetsgate.com/ViewPoem.aspx?id=187397",""],[5715,"وَلَمَّا وَقَفْنَا لِلْوَدَاعِ وَأَيْقَنَتْ . .","https://www.poetsgate.com/ViewPoem.aspx?id=181374",""],[469,"ثنت الشّمول من الشمائلْ","https://www.poetsgate.com/ViewPoem.aspx?id=76509",""],[5948,"لِتَهنِ أميرَ المؤمنين كرامةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=100578",""],[5724,"أحجاج بيت الله ألف تحية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55154&r=&rc=21",""]],"verses":[["وَلَمّا وَرَدنا ماءَ بيشَةَ لَم يَكُن","تَكَدَّرَ إِلّا مِن دِماءِ التَرائِبِ",0,"ب",1,1],["وَلَمّا وَقَفنا لِلوَداعِ غَدِيَّةً","أَشارَت إِلَينا أَعيُنٌ وَأَصابِعُ",1,"ع",1,0],["وَلَمّا وَرَدنا الدَربَ وَالرومُ فَوقَهُ","وَقَدَّرَ قُسطَنطينُ أَن لَيسَ صادِرُ",2,"ر",1,0],["ولما وقفتُ على الديارِ منادياً","قلبي المتيمَ من ورا حجراتها",3,"ت",3,0],["ولما وجدنا للثراء زيادةً","علمنا بأن الشام للخير جامع",4,"ع",1,0],["ولما وطئتُ بساط دارِ خليفةٍ","حتى المماتِ ولا اخترقتُ سِماطا",5,"ط",2,0],["ولم أُوفِهم حقَّ تمثيلهم","ضلالاً لنفسي ونسيانها",6,"ن",3,0],["وَلَم أوتِ عِلماً بِالَّذي اللَهُ صانِعٌ","وَلَكِنَّها الدُنيا قَريبٌ بَعيدُها",7,"د",3,0],["ولما وَشَتْ بِحِمامِ الدّجَى","حمائمُ يَنْدُبْنَهُ بالرّنين",8,"ن",1,0],["ولمّا وجدتُ الوفرَ أعوزَ راحتي","سجدتُ لربّي ثمّ أصبحْتُ صائما",9,"م",2,0],["وَلَمَّا وَقَفْنَا لِلْوَدَاعِ وَأَسْبَلَتْ","مَدَامِعُنَا فَوْقَ التَّرَائِبِ كَالْمُزْنِ",10,"ن",1,0],["وَلَمَّا وَفَى بِالعَهدِ نَزَّهتُ نَاظِرِي","بِرَوضَةِ خَدَّيهِ وَسِترِيَ مُسبَلُ",11,"ل",1,0],["وَلَم أوثِر لِمِصباحِ خُموداً","وَلَكِن خانَ مَوقِدَهُ السَليطُ",12,"ط",1,0],["وَلما وصلت الثغر كان لحسنه","بِوَجهي وقد أَحببته يبسم الثغر",13,"ر",1,0],["ولما وصلنا الأعظمية ضحوة","دفناه في قبر أتم له الحفر",14,"ر",1,0],["ولم أُوقع على السكان حَجزًا","ولو عَجَزَ الجميع عن الأداء",15,"ا",2,0],["ولم أوتي علماً بالذي الله صانع","ولكنها الدنيا قريب بعيدها",16,"د",3,0],["وَلَما وَصَلنا لِلدِيار عَشيَةً","وَطابَ لَنا بَعد البعاد جِوار",17,"ر",1,0],["وَلَما وَلَت الدُنيا فَرَرنا","فرار الحيقُظان مِن البزاة",18,"ه",1,0],["وَلَمّا وَقَفنا وَالرَسائِلُ بَينَنا","دُموعٌ نَهاها الوَجدُ أَن تَتَوَقَّفا",19,"ف",2,0],["وَلَمَّا وقفنا ساحة الحيِّ لم نُطِقْ","كلاماً تناجَيْنا بكسر الحواجبِ",20,"ب",1,0],["ولمّا ودّني الاباء منهم","وأهل الفضل من قاص ودان",21,"ن",1,0],["وَلَمّا وَقَفنا بِالدِيارِ بَدَت لَنا","أَوابِدُ مِن حيرانِ وَحشٍ وَآجالِ",22,"ل",1,0],["ولم أؤاخذكَ في ذَنبٍ ولا عتبٍ","فالذَنبُ والعتبُ موضوعٌ وَمَحمولُ",23,"ل",1,0],["وَلِما وَلِيتَ ذَكَرتُ النَبِ","يَّ بِتَحليلِهِ وَبِتَحريمِهِ",24,"ه",1,1],["وَلَمّا وَرَجنا ماءَ مَدينَ حَبِّها","وَجَدنا عَلَيهِ لِلهُدى خَيرَ أُمَّةِ",25,"ه",1,0],["وَلَمّا وَصَلتُ إِلى دارِها","أَمِنتُ الهَلالَ وَنِلتُ النَجا",26,"ج",2,0],["ولمَّا وقَفْنا غداةَ الوداعِ","وقِيدتْ لتظْعَن بالحيّ قُود",27,"د",1,0],["وَلَمّا ونت بُزل المَطايا حَثَثتُها","بِقَولي لَها سيري إِلى مَعدَنِ الفَخرِ",28,"ر",1,0],["ولمَّا وقَفْنا بالدّيارِ تَشاكَلَتْ","جُسومٌ بَراهُنَّ البِلَى وطُلُولُ",29,"ل",1,0],["ولمّا وقفَنا للوَداعِ عَشيّةً","وَطَرفي وقَلبي أدمعٌ وخُفُوقُ",30,"ق",1,1],["ولمّا وقفنا بالديار تشابهتْ","جسومٌ براهنَّ البِلى وطلولُ",31,"ل",1,0],["ولما وُزِنتَ بأحسابهم","وأحلامهم زِنةَ العادلِ",32,"ل",1,0],["ولما وَعدتَ بالطروق تشوَّف ال","سريرُ إلى رؤياك واشتاقَك القصرُ",33,"ر",1,0],["ولما وقفت وقوف ص","ب ناحل يبكي لناحلْ",34,"ل",1,0],["ولما وقفتُ على القدود اله","يف اسجعُ كالحمامهْ",35,"م",2,0],["ولما وقفتُ وللجفون حبائلٌ","من شعرها المسودّ في أشراك",36,"ك",1,0],["ولمّا وقفنا للوَداعِ اِشارةً","بطرفٍ مِنَ السَّجفِ الخفيَّ كحيلِ",37,"ل",1,0],["ولم أود شكرك المفترضا","ناظم آمالي وكانت رفضا",38,"ض",2,0],["ولمَّا وسمْتوني غَريباً بحزْبِكم","أَتيتُ بمعنى حبِّكم بالغَرائِبِ",39,"ب",1,0],["ولما وقفنا للوداع وبيننا","أحاديث يعيي الحاسبين عديدها",40,"د",3,1],["ولمَّا وصلتَ الربعَ ربعَ سعادةٍ","وعُدتَ إلى مَغنىً له عادَ سؤدَدُ",41,"د",1,0],["ولمّا وردتُ العِدَّ في عزّك الّذي","به الشَّرفُ الأقصى بلَلْتُ أُوامي",42,"م",2,0],["ولمّا وقفنا بالدّيار الّتي خلتْ","بكينا على سكانهنّ طويلا",43,"ل",2,0],["ولمّا وقفنا ظلّةً بطلولكمْ","رجعنا ولم نظفرْ بمُنْيةِ واقفِ",44,"ف",1,0],["وَلَمّا وَقَفنا لِلوَداعِ اِنتَضَتْ لَنا","يَدُ البَينِ بَدراً مزّقت دونَهُ السُّحْبا",45,"ب",2,0],["ولم أُوفِ حقَّ الحب إن لم أَمُت أَسىً","عليهِ فعيشي صرت أحسبهُ غدرا",46,"ر",2,0],["ولما ودَّعوا والعيسُ","قدْ شُدَّتْ بأبكار",47,"ر",1,0],["وَلَمّا وليتَ المُلكَ ضارَبتَ دونَهُ","وَأَسنَدتَهُ لا تَأتَلي خَيرَ مُسنَدِ",48,"د",1,0],["ولما وطوا أرض الشأم تحالفت","فآضت جميعها عربها والأعاجم",49,"م",1,0],["ولما وقفنا للموداع وترجمت","لعيني عما في الضمائر عيناها",50,"ا",3,0],["ولما وقَفْنا في ديارِكِ وقْفَةً","خَرِسْتُ لَها أَنْطَقْتِ أَطلالَكِ الخُرْسَا",51,"س",2,0],["ولما وقفنا للوداع ودوننا","عيون ترامى بالظنون ضميرها",52,"ه",2,1],["ولمَّا وفقنا للفراق وقُرِّبت","حمولةُ بينٍ لا يكلُّ لها ظهرُ",53,"ر",1,0],["ولمَّا وقفنا للوَداعِ رأيتَنا","وفي كلِّ عينٍ دافعٌ يَستثيرُها",54,"ر",3,1],["وَلَمّا وَقَفنا لِلوَداعِ عَشِيَّةً","وَنارَالجَوى لَم تَبدُ إِلّا تَضَرُّما",55,"م",2,0],["وَلمّا وَرَدنا ماءَ مَدينَ يَستقي","عَلى ظَمأ بِتنا إِلى موقف النَجوى",56,"و",2,1],["ولما وشأني إليه الرقيب","وأحرمني منه ما قد بذل",57,"ل",1,0],["ولما وجدنا من رزان عفة","الا وفاطمة أعف وأرزن",58,"ن",1,0],["ولما وردت السلسبيل من الصفا","والطيباتُ ذواهبٌ وأوات",59,"ت",1,0],["ولمّا وصلتُ السطحَ أوريتُ أجلسا","كبارُ الأقطابِ وافرادُ اعلمتُ",60,"ت",1,0],["ولما وسعنا الحقّ جل جلالُه","نعمنا به علما به وعِيانا",61,"ن",2,0],["وَلَمّا وَقَفنا في الدِّيارِ وَعِندَنا","مَدامِعُ نُسديها لَكُم وَتُثيرُها",62,"ر",3,0],["ولما وجاها فانثنى لمعانها","كضوء شهاب ثاق يطلب القذفا",63,"ف",2,0],["وَلَمّا وَطِئتَ المُنيَةَ اِعتَزَّ أَهلُها","وَهَلَّلَتِ الأَفلاكُ وَاِبتَسَمَ الدَهرُ",64,"ر",1,0],["ولمّا وَقَفنا بالقطاحيّة التي","تنفّس مِسكاً بالرّياضِ صَعيدُها",65,"د",3,0],["ولما وعاها آدم هزه الهوى","وانشد هذي ارث نسلي من بعدي",66,"د",2,0],["وَلما وَرت نار الغَرام وَحَركَت","قُلوباً مِن الشَوق القَديم تَفور",67,"ر",1,0],["ولما وقفنا للوداع بذي النقى","نعرَّ بالشكوى لهم ونشير",68,"ر",1,0],["وَلما واصلت بعد التَجني","رأَت قمر السماءِ فذكرتني",69,"ي",1,0],["ولما وعوا ما قيل فوق منابر","نسوا شنعة المسموع فوق صوامع",70,"ع",1,0],["وَلَمّا وَجَدتَ العِزَّ وَالفَوزَ بِالعُلا","مَعَ البِرِّ بِالإِنسانِ صافي المَشارِبِ",71,"ب",1,0],["ولما وعى شبلاه من جانب الحمى","نعي أبي الأشبال متنزل السفر",72,"ر",1,0],["ولما وقفت أمام الإمام","تأخر خلصانه والشيع",73,"ع",1,1],["ولم أوف بالتقسيط مع ما ذكرته","لظلم غراماتٍ بها نفري مكوي",74,"ي",1,0],["ولما وفى مصر البشير وأشرقت","لصدر تولاها له انشرح الصدرُ",75,"ر",1,1],["ولما وردتُ الغَمرَ من نَفَحَاتِهم","رَويتُ وبلتني هناكَ بِلالُ",76,"ل",1,0],["ولما وصلت الحيّ أجفلت دهشة","أقلّب كفي يائساً ذاهل الفكر",77,"ر",1,0],["وَلما وَقَفنا للتودّع ضحوة","وَهَمت قلوصي بِالنَوى والترحل",78,"ل",1,0],["ولما وقفنا بالصراة عشية","حيارى لتوديع ورد سلام",79,"م",1,1],["وَلَمّا وَرَدْنا ماءَ يَثْرِبَ بَعْدَما","أَسَلْنا عَلى السِّبْطِ الشَّهِيدِ الْمَدامِعا",80,"ع",2,1],["ولمَّا وصلنا ماء كاسر لم يكن","لنا معدل عن روضها المتبسم",81,"م",1,0],["ولمَّا وصلنا أرض شيزر صدَّنا","مسيل من العاصي شديد التهجم",81,"م",1,0],["ولمّا وقفنا للوَداعِ وتَرجَمَت","لعينَىَّ عمَّا في الضّمائر عيناها",82,"ا",3,0],["ولما وجدت الصبر أبقى مودةً","وطارت بأضغان إلى قلوب",83,"ب",1,0],["ولما وراء الصّمتِ ثورةُ مُفْعمٍ","بالنّارِ فُضّلَ عندهُ الكتمانُ",84,"ن",1,0],["ولمَّا وفدتُ إلى دارهِ","هُرعتُ أقبِّلُ ترب النبي",85,"ب",2,0],["ولَمَّا وَصَلتُ الأصْلَ صُلتُ مُبَادِرًا","لأنظُرَ فيهَا الوَزْنَ للكُتبِ أتلَأُ",86,"ا",1,0],["وَلَمَّا وَقَفْنَا لِلْوَدَاعِ وَأَيْقَنَتْ","عَشِيَّةَ يَوْمِ الْبَيْنِ أَنِّيَ رَاحِلُ",87,"ل",1,1],["ولما وقفت وقوف صب","ب ناحل يبكي لناحلْ",88,"ل",1,0],["ولما وعت آذانهم ما أتَى به","أنابتْ ورقَّت عند ذاك قلوبُ",89,"ب",1,0],["ولما وقفتم للنداء جميعكم","علمتم بأن الأمر لله يرجع",90,"ع",1,0]]}