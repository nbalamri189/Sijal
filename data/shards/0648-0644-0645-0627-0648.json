{"poems":[[54,"ولما وردنا ماء بيشة لم يكن","https://www.aldiwan.net/poem27648.html","الطويل"],[47,"هي الدار من سلمى وهاتي المرابع","https://www.aldiwan.net/poem25232.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[72,"يخيل لي برق من الثغر لامع","https://www.aldiwan.net/poem19168.html","الطويل"],[51,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[51,"بني وهب الله جار لكم","https://www.aldiwan.net/poem66482.html","المتقارب"],[45,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[80,"رددت الملام على العاذلين","https://www.aldiwan.net/poem31275.html","المتقارب"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[87,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[81,"طليق دموعي في الغرام مسلسل","https://www.aldiwan.net/poem61331.html","الطويل"],[46,"إذا قلت فوائدنا جفينا","https://www.aldiwan.net/poem22901.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[106,"بيوت الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179528",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[107,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[107,"على ذات القرنفل قد حططنا","https://www.aldiwan.net/poem16311.html","الوافر"],[141,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[153,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[184,"ولما صح لي تدقيق فكر","https://www.aldiwan.net/poem43243.html","الوافر"],[233,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[295,"تجن واعتب تجد مني بذاك رضا","https://www.aldiwan.net/poem33182.html","البسيط"],[324,"ولما وليت ذكرت النب","https://www.aldiwan.net/poem44244.html","المتقارب"],[347,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[347,"لقد قبض اليأس بسط الرجا","https://www.aldiwan.net/poem15555.html","المتقارب"],[362,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[403,"يغالبني فرط الغرام على الصبر","https://www.aldiwan.net/poem50164.html","الطويل"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[406,"ولما وقفنا للوداع عشية","https://www.aldiwan.net/poem32417.html","الطويل"],[456,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[456,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[456,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[462,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[462,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[462,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[475,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[493,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[498,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[511,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[536,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[549,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[549,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[549,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"]],"verses":[["وَلَمّا وَرَدنا ماءَ بيشَةَ لَم يَكُن","تَكَدَّرَ إِلّا مِن دِماءِ التَرائِبِ",0,"ب",1,1],["وَلَمّا وَقَفنا لِلوَداعِ غَدِيَّةً","أَشارَت إِلَينا أَعيُنٌ وَأَصابِعُ",1,"ع",1,0],["وَلَمّا وَرَدنا الدَربَ وَالرومُ فَوقَهُ","وَقَدَّرَ قُسطَنطينُ أَن لَيسَ صادِرُ",2,"ر",1,0],["ولما وقفتُ على الديارِ منادياً","قلبي المتيمَ من ورا حجراتها",3,"ت",3,0],["ولما وجدنا للثراء زيادةً","علمنا بأن الشام للخير جامع",4,"ع",1,0],["ولما وطئتُ بساط دارِ خليفةٍ","حتى المماتِ ولا اخترقتُ سِماطا",5,"ط",2,0],["ولم أُوفِهم حقَّ تمثيلهم","ضلالاً لنفسي ونسيانها",6,"ن",3,0],["وَلَم أوتِ عِلماً بِالَّذي اللَهُ صانِعٌ","وَلَكِنَّها الدُنيا قَريبٌ بَعيدُها",7,"د",3,0],["ولما وَشَتْ بِحِمامِ الدّجَى","حمائمُ يَنْدُبْنَهُ بالرّنين",8,"ن",1,0],["ولمّا وجدتُ الوفرَ أعوزَ راحتي","سجدتُ لربّي ثمّ أصبحْتُ صائما",9,"م",2,0],["وَلَمَّا وَقَفْنَا لِلْوَدَاعِ وَأَسْبَلَتْ","مَدَامِعُنَا فَوْقَ التَّرَائِبِ كَالْمُزْنِ",10,"ن",1,0],["وَلَمَّا وَفَى بِالعَهدِ نَزَّهتُ نَاظِرِي","بِرَوضَةِ خَدَّيهِ وَسِترِيَ مُسبَلُ",11,"ل",1,0],["وَلَم أوثِر لِمِصباحِ خُموداً","وَلَكِن خانَ مَوقِدَهُ السَليطُ",12,"ط",1,0],["وَلما وصلت الثغر كان لحسنه","بِوَجهي وقد أَحببته يبسم الثغر",13,"ر",1,0],["ولما وصلنا الأعظمية ضحوة","دفناه في قبر أتم له الحفر",14,"ر",1,0],["ولم أُوقع على السكان حَجزًا","ولو عَجَزَ الجميع عن الأداء",15,"ا",2,0],["ولم أوتي علماً بالذي الله صانع","ولكنها الدنيا قريب بعيدها",16,"د",3,0],["وَلَما وَصَلنا لِلدِيار عَشيَةً","وَطابَ لَنا بَعد البعاد جِوار",17,"ر",1,0],["وَلَما وَلَت الدُنيا فَرَرنا","فرار الحيقُظان مِن البزاة",18,"ه",1,0],["وَلَمّا وَقَفنا وَالرَسائِلُ بَينَنا","دُموعٌ نَهاها الوَجدُ أَن تَتَوَقَّفا",19,"ف",2,0],["وَلَمَّا وقفنا ساحة الحيِّ لم نُطِقْ","كلاماً تناجَيْنا بكسر الحواجبِ",20,"ب",1,0],["ولمّا ودّني الاباء منهم","وأهل الفضل من قاص ودان",21,"ن",1,0],["وَلَمّا وَقَفنا بِالدِيارِ بَدَت لَنا","أَوابِدُ مِن حيرانِ وَحشٍ وَآجالِ",22,"ل",1,0],["ولم أؤاخذكَ في ذَنبٍ ولا عتبٍ","فالذَنبُ والعتبُ موضوعٌ وَمَحمولُ",23,"ل",1,0],["وَلِما وَلِيتَ ذَكَرتُ النَبِ","يَّ بِتَحليلِهِ وَبِتَحريمِهِ",24,"ه",1,1],["وَلَمّا وَرَجنا ماءَ مَدينَ حَبِّها","وَجَدنا عَلَيهِ لِلهُدى خَيرَ أُمَّةِ",25,"ه",1,0],["وَلَمّا وَصَلتُ إِلى دارِها","أَمِنتُ الهَلالَ وَنِلتُ النَجا",26,"ج",2,0],["ولمَّا وقَفْنا غداةَ الوداعِ","وقِيدتْ لتظْعَن بالحيّ قُود",27,"د",1,0],["وَلَمّا ونت بُزل المَطايا حَثَثتُها","بِقَولي لَها سيري إِلى مَعدَنِ الفَخرِ",28,"ر",1,0],["ولمَّا وقَفْنا بالدّيارِ تَشاكَلَتْ","جُسومٌ بَراهُنَّ البِلَى وطُلُولُ",29,"ل",1,0],["ولمّا وقفَنا للوَداعِ عَشيّةً","وَطَرفي وقَلبي أدمعٌ وخُفُوقُ",30,"ق",1,1],["ولمّا وقفنا بالديار تشابهتْ","جسومٌ براهنَّ البِلى وطلولُ",31,"ل",1,0],["ولما وُزِنتَ بأحسابهم","وأحلامهم زِنةَ العادلِ",32,"ل",1,0],["ولما وَعدتَ بالطروق تشوَّف ال","سريرُ إلى رؤياك واشتاقَك القصرُ",33,"ر",1,0],["ولما وقفت وقوف ص","ب ناحل يبكي لناحلْ",34,"ل",1,0],["ولما وقفتُ على القدود اله","يف اسجعُ كالحمامهْ",35,"م",2,0],["ولما وقفتُ وللجفون حبائلٌ","من شعرها المسودّ في أشراك",36,"ك",1,0],["ولمّا وقفنا للوَداعِ اِشارةً","بطرفٍ مِنَ السَّجفِ الخفيَّ كحيلِ",37,"ل",1,0],["ولم أود شكرك المفترضا","ناظم آمالي وكانت رفضا",38,"ض",2,0],["ولمَّا وسمْتوني غَريباً بحزْبِكم","أَتيتُ بمعنى حبِّكم بالغَرائِبِ",39,"ب",1,0],["ولما وقفنا للوداع وبيننا","أحاديث يعيي الحاسبين عديدها",40,"د",3,1],["ولمَّا وصلتَ الربعَ ربعَ سعادةٍ","وعُدتَ إلى مَغنىً له عادَ سؤدَدُ",41,"د",1,0],["ولمّا وردتُ العِدَّ في عزّك الّذي","به الشَّرفُ الأقصى بلَلْتُ أُوامي",42,"ي",1,0],["ولمّا وقفنا بالدّيار الّتي خلتْ","بكينا على سكانهنّ طويلا",43,"ل",2,0],["ولمّا وقفنا ظلّةً بطلولكمْ","رجعنا ولم نظفرْ بمُنْيةِ واقفِ",44,"ف",1,0],["وَلَمّا وَقَفنا لِلوَداعِ اِنتَضَتْ لَنا","يَدُ البَينِ بَدراً مزّقت دونَهُ السُّحْبا",45,"ب",2,0]]}