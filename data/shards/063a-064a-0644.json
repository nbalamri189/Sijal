{"poems":[[32,"غيلان مية مشغوف بها هو مذ","https://www.aldiwan.net/poem29515.html","البسيط"],[91,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146094","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[2988,"","https://poetry.dctabudhabi.ae/diwan/poem/29434","الكامل"],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22589","الخفيف"],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["غيلانُ مَيَّةَ مَشغوفٌ بِها هُوَ مُذ","بَدَت لَهُ فَحِجاهُ بانَ أَو كَرُبا",0,"ب",2,1],["غيلوا بكل قساوة","فبكتهمُ حتى الأجانب",1,"ب",1,0],["غَيْلانُ الشِّعْر قُدَامَتُه","جَرْمِيُّ النَّحْو مُبَرّدُهُ",2,"د",2,0],["غيلانُ دانَت لَهُ القَوافي","وَلَم يَصُغ شِعرَهُ مصاغي",3,"غ",2,0],["غِيلٌ تَهَابُ الأُسْدُ بَطْشَ لُيوثِه","وتَخُونُها الأَنيَابُ والأظْفَارُ",4,"ر",1,0],["غي ليلةٍ لو لم تجدْ بتبسّمٍ","لم ينتطق خصرُ السماء بكوكب",5,"ب",1,0],["غيٌّ لو أن الرشدَ لي مُنصفٌ","لم يَنْهَ عن أَمثالِهِ مِثْلي",6,"ل",2,0],["غَيٌّ لَعَمرُكِ لا أَزالُ أَعودُهُ","ما دامَ مالٌ عِندَنا مَوجودُ",7,"د",1,0],["غيلَ فيها فَوارِسَ وَرِجالي","بَعدَ عِزٍّ وَذَلَّ فيها نَصيري",8,"ر",2,0],["غِيلَ الألوفُ؟! فداكِ يا حريَّة","لنوالِها زاكي الدِّماء يَسيلُ!",9,"ل",1,0]]}