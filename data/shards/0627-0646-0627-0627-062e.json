{"poems":[[80,"يا هلالا إذا بدا لي تجلت","https://www.aldiwan.net/poem13983.html","الخفيف"],[60,"أنا أخو المصطفى لا شك في نسبي","https://www.aldiwan.net/poem31109.html","البسيط"],[107,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202638",""],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[96,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[124,"خده أحسن أم ثغره","https://www.aldiwan.net/poem49374.html","المديد"],[201,"أسفر الصبح قم نحيي الصباحا","https://www.aldiwan.net/poem39883.html","الخفيف"],[231,"الغيرة","https://www.aldiwan.net/poem24242.html","عموديه"],[242,"نور الهوى في ظلام البين هادينا","https://www.aldiwan.net/poem19090.html","البسيط"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119095","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77409","الخفيف"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105676","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127379","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201113","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200081","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199961","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204732","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204591","الخفيف"],[3345,"","https://poetry.dctabudhabi.ae/diwan/poem/97844","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92120","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142974","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66152","الخفيف"],[4691,"خفيف كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=164277",""],[4728,"رسالة من غريب (هلالي قصير)","https://www.poetsgate.com/ViewPoem.aspx?id=176996",""],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[5136,"أرج النسيم معنبر النفحات","https://www.poetsgate.com/ViewPoem.aspx?id=121528",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"نورس الصوبين","https://www.poetsgate.com/ViewPoem.aspx?id=186441",""],[5411,"وجَعُ الشِّعْر","https://www.poetsgate.com/ViewPoem.aspx?id=185383",""],[5431,"لوحة الحرب غرنيكا-وعذاب السوريين","https://www.poetsgate.com/ViewPoem.aspx?id=192961",""],[5476,"وَاسْتَقَالَ الْمَلَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=194683",""],[5764,"قتلتني","https://www.poetsgate.com/ViewPoem.aspx?id=137059",""],[5937,"مآذِنٌ ناسِفة","https://www.poetsgate.com/ViewPoem.aspx?id=211826",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[5956,"أجبني","https://www.poetsgate.com/ViewPoem.aspx?id=182296",""],[5956,"إشعاع الإنسانية في الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=204680",""],[6199,"أنا آخر العشّاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79701&r=&rc=22",""]],"verses":[["أَنا أَخشى عَلَيكَ يا ساكِنَ القَل","بِ المُمَلّى بِالصَدِّ مِن نَغَراتي",0,"ت",2,0],["أَنا أَخو المُصطفى لا شَكَّ في نَسَبي","مَعهُ رَبيتُ وَسِبطاهُ هُما وَلَدي",1,"د",2,1],["إنّا أخذنا للحياةِ عَتادَها","ومَضَتْ بنا هِمَمٌ تجيشُ عِظامُ",2,"م",1,0],["أنا أخبي الدمع فقلبي","واكتم في القلب أسايا",3,"ا",3,0],["أَنا أَخشى سَوءَ العِقابِ وَأَرجو","كَ فَهَب لي سَلامَتي يا سَلامُ",4,"م",1,0],["أنا أخشَى جدالَه كلّما صا","لَ عنيفَ الجدال في صَوْلاته",5,"ت",2,0],["أنا أخشى عليهمُ الشَّوْكَ في الور","دة، والذّرَّ إذ يَهُبُّ الهواءُ",6,"ا",2,0],["أنا أخشى من الضعيف عليكم","بعد حين تمرّدا وانتقاما",7,"م",2,0],["أنا أخشى من الضعيف عليكم","ثورة تبعث الخطوب الجساما",7,"م",2,0],["أنا أخشى أن أراعيه","ما لهذا الورد جثمان",8,"ن",1,0],["أنا أخشى عليك من أهلك","السوء فهلا جعلتني مرتاحا",9,"ح",2,0],["أنا أخشى ولا أصرّح ماذا ؟","أنا أخشى ، فما أزال محبّا !",10,"ب",2,0],["إِنَّا أَخَذْنَا عُهُوداً مِنْ أَحِبَّتِنَا","أَنْ لاَ نَزَالُ لِأَهْلِ اللَّوْمِ قَالِينَا",11,"ن",2,0],["أنا أخشى انهيار مجدي وأرجو","أن يقينا أحداثَه المقدور",12,"ر",1,0],["إنا أخذنا علمه إذ نقلا","عن الرجال رجلا فرجلا",13,"ل",2,0],["أَنا أَخشى عليك أَن بعلم الصا","حبُ قَتْلي فيستبيحُك قَتْلا",14,"ل",2,0],["أنا أخفى من أن يحس بجسمي","أحد حيث كنت لولا الأنينُ",15,"ن",1,1],["أَنا أَخلى الأَنامِ بالاً وَأَرضى الن","ناسِ حالاً إِذا غَفَرتَ ذُنوبي",16,"ب",2,0],["أنا أخشى من غراب المنزل","يلهم الطير ضلالا وغرور",17,"ر",1,0],["أنا أَختارُ لو قَعَدْتُ منَ الجَه","د ولكن أَمشي بِغَيْرِ اختياري",18,"ر",2,0],["أنا أخشى يومها أن","تبلغ الروح التراقي",19,"ي",1,0],["أنا أخشى الدمع أن يه","تك عن حبي الستور",19,"ر",1,0],["أنا أخشى غداً فلاسفة الكو","ن يقولون شاعرٌ معروفُ",20,"ف",1,0],["انا اخشى من نسبتي لعقوقٍ","او لغدرٍ بصحبي الأوفياء",21,"ا",2,0],["أنا أخشى وقد بدأت كلامي","أن يجئ الحمام قبل التمام",22,"م",1,0],["أنا أخفي الكتاب عنهم كأن ال","كتب عيب ويلزم العيب ستر",23,"ر",1,0],["أنا أختال رافلاً بالمعالي","وهو يختال رافلا بالدمقس",24,"س",1,0],["أنا أخفي هواك صوناً وإن ب","ت طعين القنا جريح النبال",25,"ل",1,0],["إنّا أخذنا مواريثَ الحياة من ال","ماضي ويأخذها الآتي مواريثا",26,"ث",2,1],["أنا أخو الفضل وينبوعُ النَّدا","ومعدنُ الصّدق لعَمري والوفَا",27,"ا",1,0],["أنا أخشى إن دام ذا الهجر أن ين","شط من حبه عقال وثاقي",28,"ق",2,0],["انا اخْشَى انْ سِرْتُ وَحْدِي عِجالا","خاطِفاتٍ فيها المَنايا تَصِيدُ",29,"د",1,0],["أنا أخشى افتضاح َ قلبي لديهِ","أيُداري متيّما فيه هاما",30,"ا",1,0],["أنا أخذت بعير كامل من الشعر","يومك تدوّر من بعير سنام",31,"م",1,0],["أَنا أَخشَى عليكَ مِن صَلَواتٍ","تَتَعَرَّى، ومُلحِدٍ مُتَصَوِّف",32,"ف",1,0],["أَنا أَخشَى عليكَ مِن وَطَنِيٍّ","تَبَعِيٍّ، وتُبَّعٍ مُتَزَلِّف",32,"ف",1,0],["أنا أخشى عليكم منكم إذا ما","زرعوا الخلف بينكم والشجاجا",33,"ج",2,0],["أنا أخسر الثقلين في الأفعال وال","أقوال والحركات والسكنات",34,"ت",1,0],["أنا أختارُ يا أماه دوري","ومن قدري وقصدي أن أُجيدَهْ",35,"د",2,0],["أنا آخر العشاق ...ليلى حبيبتي","فديت لليلى اليوم تلك الغوانيا",36,"ي",2,0],["أنا آخِرُ العشّاقِ أبكي حبيبةً","أُفدِّي هواها اليوم َتلكَ الغوانيا",37,"ي",2,0],["أنا آخر المَلكات في مُدُنِ الهوى","والآن صِرْتُ بِصَفْحَةِ الغُيّابِ",38,"ب",1,0],["أنا آخر الأوجاع قربان الوغى","تعتاش من جسدي الهزيل جحافل",39,"ل",1,0],["أَنَا آخِرُ الْمُتْعَبِينَ رُوَيْدًا","قَلَوْتُ الزَّوَايَا وَهَمِّي الْجِوَارُ",40,"ر",1,0],["أنا أختنق º لاني عجزت أبدلك","الذكريات أكبّها مآتكبني",41,"ن",2,0],["أنا آخر الأوراق شعرًا باكياً","كم بات تحمله إليك زواجلُ",42,"ل",1,0],["أنا آخرُ الشعراء أركضُ حافياً","والشوكُ ملءُ طريقيَ الممدودِ",43,"د",1,0],["أنا أخشى خروجَك عن مداري","أيا مَن في نخاعي قد أضأتا",44,"ت",2,0],["أنا أخشَى اليأس يدعوني لأنحو","عن قضاياهم إلى كهفِ اْنطوايا",45,"ا",3,0],["أنا آخر العشّاق في درب الهوى","لو مات عشقي لن تنوح رباب",46,"ب",1,0],["أنا آخر العشاق في درب الهوى","مَنْ غيرُ قلبي ؟ شاعر ، ومصاب؟",46,"ب",1,0]]}