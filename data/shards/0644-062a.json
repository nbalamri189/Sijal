151",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[45,"إذا عَرَضَتْ أحْدَاجُ سلمى، فنادِها","https://www.poetsgate.com/ViewPoem.aspx?id=31564",""],[45,"دَعْ دُمُوعي في ذَلِكَ الإشْتِياقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32834",""],[80,"أذا البدرُ يُطْوَى في ربوعِ البلى لَحْدا","https://www.poetsgate.com/ViewPoem.aspx?id=3158",""],[99,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""],[51,"لم يزلْ قلْبُهُ إليهم مَشوقا","https://www.poetsgate.com/ViewPoem.aspx?id=29924",""],[31,"ألا يا سلمَ قد شطحتْ نواكِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18992&r=&rc=255",""],[4,"قَضِّ اللُّبانَة َ لا أبَا لكَ واذْهَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10908&r=&rc=4",""]],"verses":[["لِتَعرِفَنّي وَلِتَعرِفَنّي","أَيّامَ أَقني بِالقَنا وَأُغني",0,"ي",1,0],["لِتَهنِكَ نَعماءُ سُربِلتَها","تَقَطَّعُ عَنها العُيونُ الرَواني",1,"ي",1,0],["لَتَنظُرَنّي مُشيحاً في أَوائِلِها","يَغيبُ بي النَقعُ أَحياناً وَيُبديني",2,"ي",1,0],["لَتَندَمَنَّ بَعدَها","هَيهاتَ حينَ لا نَدَم",3,"م",1,0],["لِتُسَلِّبِ الدُنيا عَلَيهِ فَإِنَّها","نَزَعَت بِهِ الإِحسانَ وَالإِجمالا",4,"ل",2,0],["لِتَجنيهِ دونَ الناسِ ما كانَ مُثمِراً","وَتَلبَسَ طَلّاً مِنهُ ما كانَ مورِقا",5,"ق",2,0],["لِتَبكِ أَبا الفَتحِ العُيونُ بِدَمعِها","وَأَلسُنَنا مِن بَعدِها بِالمَناطِقِ",6,"ق",1,0],["لِتُبدِ اليَومَ نُسوَةُ آلِ كَعبٍ","بِأَجيادٍ مُدَمّاةِ الخُدوشِ",7,"ش",1,1],["لَتَعجُمُ مِنّي ضُروسُ الخُطو","بِ قَلباً جَليداً وَعوداً صَليبا",8,"ب",2,0],["لِتَرتَوي ثَمّ أَعظُمٌ نَزَلَت","داجي الدَماميمِ موحِشَ الحَدَبِ",9,"ب",1,0],["لِتُبكَ قُبورٌ أَفرَغَ المَوتُ تَحتَها","سِجالَ العَطايا بَعدَهُم وَالرَغائِبِ",10,"ب",1,0],["لَتَرتَميَنَّ بي وَاللَّيلُ داجٍ","إِليها العيسُ مائِلَةً طُلاها",11,"ا",3,0],["لَتَحدَّبَتْ صِيدُ المُلوكِ على القَنا","حَيثُ القُلوبُ تُطيرُها الهَيْجاءُ",12,"ا",2,0],["لَتُشارِفَنَّ بيَ المَوامي أيْنُقٌ","هُنَّ الحَنِيُّ ورَكْبُهُنَّ الأسْهُمُ",13,"م",1,0],["لَتَوَقَّدَ الشَوقُ المُبَرِّحُ مُهجَتي","حَتّى تُضيءُ الأَرضُ بَينَ جَوانِحي",14,"ي",1,0],["لَتَركي لَكُم وَالوُدُّ فيهِ بَقِيَّةٌ","أُؤَمِّلُها وَالحَبلُ لَم يَتَقَضَّبِ",15,"ب",1,0],["لتَرَكْت ديارَهُمُ قَفْراً","للهامِ وسلْمَهُمُ نفَقا",16,"ق",2,0],["لِتَعْلَمَ رَكْبَ اللَّيْلِ أَيْنَ رِكَابُهُ","فَقَدْ دَخَلَتْ لِلْغَرْبِ مُلْتَفَّ آجَامِ",17,"م",1,0],["لتُحْكَمَ قوّةُ ترْكيبِه","بطَبْعٍ صَحيحٍ وعُمْرٍ مَديدْ",18,"د",1,0],["لِتَرْجعَ مِنْ تِلْكَ الْمَعَالِمِ غُدْوَة","وَقَدْ ذَاعَ مِنْ رَدِّ التَّحِيَّةِ طِيبُ",19,"ب",1,0],["لتَظْفَرَ منْ ذاك الزُّلالِ بعَلّةٍ","وتنْعَمَ في تِلْك الظِّلالِ بتَعْريسِ",20,"س",1,0],["لَتَهلَكَ إِن هَلَكَت بَرَّةً","وَتَخلُصَ إِن خَلَصَت غانَمَه",21,"م",2,0],["لِتُحكِمَه الأَيامُ أَو لِتَردَّهُ","عَليَّ وَلَم أَبسِط لِساناً وَلا يَدا",22,"د",2,0],["لِتَعلَمَ ما تَطوي الصُدورُ مِنَ الأَسى","وَتَنظُرَ مَقروحَ الحَشا كَيفَ يَجزَعُ",23,"ع",1,0],["لِتَهنَئ أَميرَ المُؤمِنينَ مُحَمَّداً","خِلافَتُهُ فَالعَرشُ سَعدٌ كَواكِبُه",24,"ب",2,0],["لِتَحيَ الغَواني في ظِلالِ مَليكَةٍ","سَمَت في مَعاليها عَلى المَلِكاتِ",25,"ت",1,0],["لِتَبكِ الأَيامى وَاليَتامى فَقيدَةً","هِيَ المُزنُ أَحيا صَوبُهُ ثُمَّ أَقشَعا",26,"ع",2,0],["لِتَعلَمَ أَني لِلمَوَدَّةِ حافَظٌ","وَما لِليَدِ الحُسنى لَديَّ كُنودُ",27,"د",1,0],["لِتَبكِ البَواكِي المُبكَياتُ أَبا وَهبِ","عَلَى كُلِّ حَالٍ مِن رَخاءٍ وَمِن كَربِ",28,"ب",1,1],["لِتَروى بِهِ سُعدى وَيَروي مَحَلُّها","وَتُغدِقَ أَعدادٌ بِهِ وَمَشارِبُ",29,"ب",1,0],["لَتَيَمَّمَتكَ يَدُلُّها","جَدواكَ وَالسُبُلُ المَوارِد",30,"د",1,0],["لِتُدرِكَ شَأواً عَلى قُربِهِ","وَتَكسَبَ حَمداً وَتَحمي الذِمارا",31,"ر",2,0],["لِتَبكِ عَلَيكَ عِيالُ الشِتاءِ","إِذا الشَولُ لاذَت مِنَ الشَمأَلِ",32,"ل",1,0],["لِتَجرِ المَنِيَّةُ بَعدَ الفَتى","المُغادَرِ بِالمَحوِ أَذلالَها",33,"ل",3,0],["لتدم مصر وليدم صاحب العر","ش المفدى ذخر البلاد الغالي",34,"ي",1,0],["لِتَعِشْ مِصْرُ ولْيَعِشْ شَعْبُ مِصْرٍ","إِنَّهُ خَيْرُ قُدْوةٍ للشُّعُوبِ",35,"ب",1,0],["لِتَكْثُرْ فِي مَنَازِلِكَ الدَّوَاعِي","إِلَى الأَفْرَاحِ فِي آنٍ فَآنِ",36,"ن",1,0],["لِتجِدُّوا لَهَا شَبَابَ فَخَارِ","فَتُبَاهِي بِقَوْمِهَا لأَقْوَامَا",37,"م",2,0],["لِتَبْقَ وَلْيَمُتْ المَوْتُ المُحِيطُ بِهَا","مِنْ حَيْثُ يَدْفَعُهُ أَعْدَاؤُنَا الْغُشُمُ",38,"م",1,0],["لِتَصُنْها عِنَايَةُ اللهِ وَلْتَنْمُ","فَينْمُو الخَيْرُ العَمِيمُ الجَزِيلُ",39,"ل",1,0],["لترى دموع العاشقين برسمها","حمراً كحاشية الرداء المعْلَمِ",40,"م",1,0],["لتسقيَ أجداثاً بها وضرائحا","عياضٌ إلى يوم المعادِ ضجيعُها",41,"ع",3,0],["لترى رياضاَ أَطلعت","زهراً على أجناسِ",42,"س",1,0],["لتخبر البلبل بعض الخبر","لعلّه غمتّه تنجلي",43,"ي",1,0],["لتُرسلّنّ عليكم كل راعدة","تهمى الدماء وتَمريها ظُبيٌ وقَنا",44,"ن",2,0],["لتبتدر الشعوب إلى المعالي","وتبلغ ما تريد وما تُرجي",45,"ج",2,0],["لتَقُونا أسوأ المنقلَب","إذ بناء القوم هاري الجُرُف",46,"ف",1,0],["لَتَنعَشَ اليَومَ ريشي ثُمَّ تُهِضَني","وَتُنزِلَ اليُسرَ مِنّي مَوضِعَ العُسُرِ",47,"ر",1,0],["لِتَبكِ عَلَيهِ الإِنسُ وَالجِنُّ إِذ ثَوى","فَتى مُضَرٍ في كُلِّ غَربٍ وَمَشرِقِ",48,"ق",1,0],["لِتَرعَ مِن نَبتِهِ أُسَيمُ إِذا","أَنبَتَ حُرَّ البُقولِ وَالعُشُبا",49,"ب",2,0],["لِتَذودَهُنَّ وَأَيقَنَت إِن لَم تَذُد","أَن قَد أَحَمَّ مَعَ الحُتوفِ حِمامُها",50,"م",3,0],["لتتركنا قُربى لؤيّ بن غالب","كسامةَ إذْ أودت وأودى عتيبها",51,"ب",3,0],["لَتَسمَعُنَّ وَشيكاً في دِيارِكُمُ","اللَهُ أَكبَرُ يا ثاراتِ عُثمانا",52,"ن",2,0],["لَتَصطَبِحَن وَإِن أَعرَضتَ عَنها","وَلَو أَنّي بِحيبَتِهِ سَقاني",53,"ن",2,0],["لِتَعفُ مِياهُ الحارِثَينِ وَقَد عَفَت","مِياهُهُما مِن كُلِّ حَيٍّ عَرَمرَمِ",54,"م",1,0],["لتهن عين إلى مرآك قد طمحتْ","ومهجةٌ فيك بالأشجان قد صلحت",55,"ت",1,1],["لتهنك حجةٌ غرّاء يحلو","تذكرها على مرّ الدّهور",56,"ر",1,0],["لتقرعنَّ عليَّ السنّ من ندمٍ","إذا تذكّرت يوماً بعض أخلاقي",57,"ي",1,0],["لتمكين رَجواها وتأمين رَوْعها","وتأثيل نعماها وتفريج غمّها",58,"م",3,0],["لتعويقِ سيري أو دحوضِ مَطيَّتي","وإخصابِ مُزوَّرٍ عن المجد ناكبِ",59,"ب",1,0],["لتأتيني جدواك وهي سليمةٌ","من العيب ما فيها اعتلالٌ لعائبِ",59,"ب",1,0],["لتخرق في المسامع ثمّ يتلو","هجائي مُحْرِقاً يكوي القلوبا",60,"ب",2,0],["لتَسْتَمْتِعِ الدنيا بوجهك دهرَها","فقد طالما اشتاقت إليك وحَنَّتِ",61,"ت",1,0],["لتَصُونَ وَجْهِي عَن وُجُوهٍ وُقِّحتْ","بالرَّدِّ تَوْقيحاً على توقيحِ",62,"ح",1,0],["لِتُعِين الإِمامَ عوناً تماماً","مُنْجِداً كيدهَ على كُيَّادِهْ",63,"د",2,0],["لَتُلاقِينَّ شتائمي ناريَّةً","لا يجتويك حريقُها الوقَّادُ",64,"د",1,0],["لِتروْا مني وليّاً","رأيُكم أفضل مَيْره",65,"ر",2,0],["لتَسكننَّ الثرى وشيكاً","أو لَتموتَنّ خلف سور",66,"ر",1,0],["لتِلك أثَّلتَ أو لذي هَوجٍ","أصبحت تُكنَى به أبا العبر",67,"ر",1,0],["لتُرغبَ المقْتر فيه المُفلسا","إذا تَحَنَّى ظهْرُها وقوَّسا",68,"س",2,0],["لتُؤنس الأولى بها مُحسِناً","فإنها تَطلبُ إيناسا",69,"س",2,0],["لتهْنَك يا ابن الأكرمين إمارةٌ","بطالع سعدٍ جانبتْه المنَاحس",70,"س",1,0],["لتعترفنَّ هجاءً يُري","ك مَوْتك عيْشَك في العُيَّش",71,"ش",1,0],["لتقلدت حفر إسنايَةِ الني","ل كميشا تخال سيفا دلوقا",72,"ق",2,0],["لِتَعُذ بسَيبِكُمُ المطامعُ والمنى","فعليكم لعداتها التصديق",73,"ق",1,0],["لتزِدْ في اختيالها ولعمري","إنها في مزِيّة المختالِ",74,"ل",1,0],["لتخلُّف الشعراءِ عندك رأفةٌ","ولسبق سابقهم لديك تقبُّلُ",75,"ل",1,0],["لتعطِ الولاية من فضلها","فتى سلَّفَ المدحَ في العُطْلَهْ",76,"ل",2,1],["لتَفتَرَّ عنه في مواطن جَمَّةٍ","رُزَيْق فما مفترُّها عنه أهتمُ",77,"م",1,0],["لتحملْ رقابٌ مائلاتٌ رؤوسها","حذارِ وإلا فالمليمون ألومُ",77,"م",1,0],["لتَلْقَ بني نوبختَ يوماً بأُمَّة","هواك وقد هانت صِعابُ المجاسمِ",78,"م",1,0],["لتُسلينَني الأيام لا أن لوعتي","ولا حَزَني كالشيء يبْلى على القِدَمْ",79,"م",1,0],["لتَروْن سائلكُمْ أحقَّ بمالِكم","من بعضِكُمْ حتَّى يُقالَ غريم",80,"م",1,0],["لِترُبَّ ما قد كنت توليه أخي","عندي وتعمرَ جانبي عمرانَهُ",81,"ن",2,0],["لَترى غداةَ الغِبِّ مِن حرمانِه","خطأً ومَن حرمانُه حرمانُ",82,"ن",1,0],["لِتَسْتَمتِع الدنيا بوجهك دَهْرها","فقد طال ما اشتاقتْ إليه وحَنَّتِ",83,"ت",1,0],["لَتَصطَبِحَن وَلَو أَعرَضتَ عَنها","وَلَو أَنّي بِعَقوَتِهِ سَقاني",84,"ي",1,0],["لَتَحموا نِساءً بادِياً ثَلَباتُها","قِصاراً هَواديها وَأَوساطُها عُجرُ",85,"ر",1,0],["لِتَبكِ أَبا سَمعانَ أَ