ww.poetsgate.com/ViewPoem.aspx?id=12552",""],[5976,"قلبي زجاجي ..","https://www.poetsgate.com/ViewPoem.aspx?id=30697",""],[6019,"في محراب الرجاء..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53850",""],[6068,"أَمِنَ اللُّبَانَاتِ الَّتِي أَتَحَمَّلُ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175808",""],[6070,"أنين الأعمى","https://www.poetsgate.com/ViewPoem.aspx?id=188675",""],[6093,"أما المعلم كان خطا أحمرا","https://www.poetsgate.com/ViewPoem.aspx?id=201760",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""],[6102,"خامِس الفُصُول !!","https://www.poetsgate.com/ViewPoem.aspx?id=183982",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6113,"اعطوني السبحه","https://www.poetsgate.com/ViewPoem.aspx?id=117935",""],[6144,"سي المجلس البلدي","https://www.poetsgate.com/ViewPoem.aspx?id=21836",""],[6160,"ما لمْ يقلهُ أبو الطَّيب ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87102&r=&rc=19",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[6299,"وَنَائِحَة ٍأَوْحَيْتُ في الصُّبْحِ سَمْعَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19683&r=&rc=8",""],[6334,"في الرمل حمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82250&r=&rc=0",""],[5190,"في المقهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78322&r=&rc=35",""],[6344,"مُرافعةُ مِصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87962&r=&rc=2",""],[6347,"النسر الكسيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79677&r=&rc=10",""],[5567,"موتي أهدهده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81823&r=&rc=73",""]],"verses":[["أَمْشِي على ظَلْعِي إِلى شَأْوِهِ","تَعَجْرُفاً فِعْلَ الأَعارِيبِ",0,"ب",1,0],["أَمشي وَأَحمِلُ بائِسَينِ فَطارِقٌ","بابَ الحَياةِ وَمُؤذِنٌ بِزَوالِ",1,"ل",1,0],["أَمُشَيِّدَ الدُّسْتُورِ حَسْبُ المَجْدِ مَا","أَدْرَكْتَ مِنْ جَاهٍ وَرِفْعَةٍ شَانِ",2,"ن",1,0],["أم شعره والعصور ما برحت","تسعى بل استجادة قبله",3,"ل",2,0],["أمشي إلى النوم وهو منهزم","مَشيِي دبيب ومشيه خَبَب",4,"ب",1,0],["أمشي إلى القوت الزهيد وربَّما","أعلو فلا قدمِي ولا حالِي مشى",5,"ش",2,0],["أمشي على قدمي والحال واقفة","فيها فهلاَّ يكون المشي في حالي",6,"ل",2,0],["أمشَاهدي يومَ الرَّفيهة تُحتمَى","ومشَاهدي يومَ الكريهة تُخْطَبُ",7,"ب",1,0],["أُمُّ شيخٍ تُناكُ بين يديه","حين لا حاجبٌ هناكَ يمُطُّ",8,"ط",1,0],["أم شواها إذا أغصَّ بُراها","أم حَشاها أم فرعَها الفينانا",9,"ن",2,0],["أُمَشّي عَلى الأَرضِ الَّتي لَن تَضُرَّني","لِأَنكِيَ قَوماً أَو أُصادِفَ حُمَّتي",10,"ت",2,0],["أُمَشّي عَلى أَينِ الغَزاةِ وَبُعدَها","يُقَرَّبُني مِنها رَواحي وَغُدوَتي",10,"ت",2,0],["أُمَشّي بِأَطرافِ الحَماطِ وَتارَةً","تُنَفَّصُ رِجلي بُسبُطاً فَعَصَنصَرا",11,"ر",2,0],["أَمشي بروحٍ حالمٍ متَوَهِّجٍ","في ظُلمةِ الآلامِ والأَدواءِ",12,"ا",2,0],["أمشي وراء خيال لا يفارقني","كأنه نكدي في العيش أو كمدي",13,"د",2,0],["أَم شَفَّهُ ما شَفَّني فَاِنثَنى","مُبَلبَلَ البالِ شَريدَ المَنام",14,"م",1,0],["أَمُشَبِّهَ الطَرفِ الكَحيلِ بِنَرجِسٍ","بَعدَ القِياسِ وَذاكَ مِن أَضدادِهِ",15,"د",2,1],["أم شباباً كأنّما كان روضاً","ناضراً فاغتدى عليهِ الذبولُ",16,"ل",1,0],["أَمشي دَبيباً كَالكَسيرِ وَأَتّقي","وثباً عليّ من الحِمام العادي",17,"د",2,0],["أَمشي عَلى خَوفٍ وَطولِ تَلَفُّتٍ","فَإِذا جَلَستُ خَشيتُ شَرَّ المَجلِسِ",18,"س",1,1],["أَمشي كَما حَرَّكت رِيحٌ يَمانِيَةٌ","غُصناً مِنَ البانِ رَطباً طَلَّهُ الرِهَمُ",19,"م",1,0],["أَمشي إِلى جَنبِها أُزاحِمُها","عَمداً وَما بِالطَريقِ مِن ضيقِ",20,"ق",1,0],["أُمُّ شِبلٍ فَوقَها لِبَدٌ","ظُفرُها مِن قَتلِنا وَرِسُ",21,"س",1,0],["أَمشي على وضح اليَقين بليلَتي","حسبي اليَقين وحسبي الأوضاح",22,"ح",1,0],["أَمشي وَما مشيي هناك لغاية","في وسط نور تارة وَظَلام",23,"م",1,0],["أمشي عليه فوق كبش أملح","قرنان اليته تقوم ونرتمي",24,"م",2,0],["أمشي بمصباحي وحي","داً في الرياحِ مُتعبا",25,"ب",2,0],["أمشي به وَزَيتُهُ","كاد به أن يَنضبا",25,"ب",2,0],["أم شدا الأنبياءُ بالضِّفة الخَضْ"