{"poems":[[63,"أقسم بالجرد السراحيب","https://www.aldiwan.net/poem45908.html","السريع"],[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[72,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"في جلنار وأختها دبسية","https://www.aldiwan.net/poem8493.html","الكامل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[12,"ونائحة أوحيت في الصبح سمعها","https://www.aldiwan.net/poem1211.html",""],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[85,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[85,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[66,"أمشبه الطرف الكحيل بنرجس","https://www.aldiwan.net/poem38802.html","الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[105,"أمشي على خوف وطول تلفت","https://www.aldiwan.net/poem43122.html","الكامل"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[46,"المشيدات التي رفعت","https://www.aldiwan.net/poem22788.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85643","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85371","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85824","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39582","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54640","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[100,"في المساء","https://www.poetsgate.com/ViewPoem.aspx?id=50420",""],[108,"ماني نبي","https://www.poetsgate.com/ViewPoem.aspx?id=36760",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[51,"حَبَّبَتْ دُرَّة ُ القِيانَ إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=30802",""],[109,"جفن الحسام بدا أم مربض الأسد","https://www.aldiwan.net/poem16553.html","البسيط"],[115,"اوقف العيس هذه بغداد","https://www.aldiwan.net/poem41171.html","عموديه"],[129,"صور تلوح لخاطر المعمود","https://www.aldiwan.net/poem67437.html","الكامل"],[129,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[166,"تلك الجنان قطوفهن دوان","https://www.aldiwan.net/poem46838.html","الكامل"],[178,"جرحك في كفك","https://www.aldiwan.net/poem50701.html","الوافر"],[186,"بكى صبي فرأت أمه","https://www.aldiwan.net/poem43634.html","السريع"],[197,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[229,"كل حي إلى الفناء يصير","https://www.aldiwan.net/poem51107.html","الخفيف"],[256,"أمشي بقلبي لا برجلي إنما","https://www.aldiwan.net/poem48403.html","الكامل"],[256,"والله أهل الحمد والشكر","https://www.aldiwan.net/poem48558.html","السريع"],[281,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[297,"أمشرفا قدري بسعد قدومه","https://www.aldiwan.net/poem33292.html","الكامل"],[328,"رأيتها تمشي وفي كفها","https://www.aldiwan.net/poem54920.html","السريع"],[361,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[365,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[396,"قد كنتُ أهدي ولا أهدى فعلمني","https://www.aldiwan.net/poem583.html",""],[409,"قصر خطوي وحنا صعدتي","https://www.aldiwan.net/poem31665.html","عموديه"],[409,"وضح الصباح لناظر المتأمل","https://www.aldiwan.net/poem31960.html","الكامل"],[409,"قلبي وصبري إلفان مذ خلقا","https://www.aldiwan.net/poem32173.html","المنسرح"],[409,"لو أحسنوا في ملكنا أو أعتقوا","https://www.aldiwan.net/poem32423.html","الكامل"],[437,"أمّا الخليط فبان غير مودع","https://www.aldiwan.net/poem2555.html","الكامل"],[452,"تنبهت في الروابي نسمة الفلق","https://www.aldiwan.net/poem13863.html","البسيط"],[453,"الصيف أين هو الحبيب فما أرى","https://www.aldiwan.net/poem61223.html","الكامل"],[453,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[458,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[458,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[464,"عصفت به ريح الخطوب زعازعاً","https://www.aldiwan.net/poem3113.html","عموديه"],[464,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[538,"يا رب غربة بتها","https://www.aldiwan.net/poem48315.html","عموديه"],[544,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[544,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"]],"verses":[["أَمْشِي على ظَلْعِي إِلى شَأْوِهِ","تَعَجْرُفاً فِعْلَ الأَعارِيبِ",0,"ب",1,0],["أَمشي وَأَحمِلُ بائِسَينِ فَطارِقٌ","بابَ الحَياةِ وَمُؤذِنٌ بِزَوالِ",1,"ل",1,0],["أَمُشَيِّدَ الدُّسْتُورِ حَسْبُ المَجْدِ مَا","أَدْرَكْتَ مِنْ جَاهٍ وَرِفْعَةٍ شَانِ",2,"ن",1,0],["أم شعره والعصور ما برحت","تسعى بل استجادة قبله",3,"ل",2,0],["أمشي إلى النوم وهو منهزم","مَشيِي دبيب ومشيه خَبَب",4,"ب",1,0],["أمشي إلى القوت الزهيد وربَّما","أعلو فلا قدمِي ولا حالِي مشى",5,"ش",2,0],["أمشي على قدمي والحال واقفة","فيها فهلاَّ يكون المشي في حالي",6,"ي",1,0],["أمشَاهدي يومَ الرَّفيهة تُحتمَى","ومشَاهدي يومَ الكريهة تُخْطَبُ",7,"ب",1,0],["أُمُّ شيخٍ تُناكُ بين يديه","حين لا حاجبٌ هناكَ يمُطُّ",8,"ط",1,0],["أم شواها إذا أغصَّ بُراها","أم حَشاها أم فرعَها الفينانا",9,"ن",2,0],["أُمَشّي عَلى الأَرضِ الَّتي لَن تَضُرَّني","لِأَنكِيَ قَوماً أَو أُصادِفَ حُمَّتي",10,"ت",2,0],["أُمَشّي عَلى أَينِ الغَزاةِ وَبُعدَها","يُقَرَّبُني مِنها رَواحي وَغُدوَتي",10,"ت",2,0],["أُمَشّي بِأَطرافِ الحَماطِ وَتارَةً","تُنَفَّصُ رِجلي بُسبُطاً فَعَصَنصَرا",11,"ر",2,0],["أَمشي بروحٍ حالمٍ متَوَهِّجٍ","في ظُلمةِ الآلامِ والأَدواءِ",12,"ا",2,0],["أمشي وراء خيال لا يفارقني","كأنه نكدي في العيش أو كمدي",13,"ي",1,0],["أَم شَفَّهُ ما شَفَّني فَاِنثَنى","مُبَلبَلَ البالِ شَريدَ المَنام",14,"م",1,0],["أَمُشَبِّهَ الطَرفِ الكَحيلِ بِنَرجِسٍ","بَعدَ القِياسِ وَذاكَ مِن أَضدادِهِ",15,"د",2,1],["أم شباباً كأنّما كان روضاً","ناضراً فاغتدى عليهِ الذبولُ",16,"ل",1,0],["أَمشي دَبيباً كَالكَسيرِ وَأَتّقي","وثباً عليّ من الحِمام العادي",17,"د",2,0],["أَمشي عَلى خَوفٍ وَطولِ تَلَفُّتٍ","فَإِذا جَلَستُ خَشيتُ شَرَّ المَجلِسِ",18,"س",1,1],["أَمشي كَما حَرَّكت رِيحٌ يَمانِيَةٌ","غُصناً مِنَ البانِ رَطباً طَلَّهُ الرِهَمُ",19,"م",1,0],["أَمشي إِلى جَنبِها أُزاحِمُها","عَمداً وَما بِالطَريقِ مِن ضيقِ",20,"ق",1,0],["أُمُّ شِبلٍ فَوقَها لِبَدٌ","ظُفرُها مِن قَتلِنا وَرِسُ",21,"س",1,0],["أَمشي على وضح اليَقين بليلَتي","حسبي اليَقين وحسبي الأوضاح",22,"ح",1,0],["أَمشي وَما مشيي هناك لغاية","في وسط نور تارة وَظَلام",23,"م",1,0],["أمشي عليه فوق كبش أملح","قرنان اليته تقوم ونرتمي",24,"ي",1,0],["أمشي بمصباحي وحي","داً في الرياحِ مُتعبا",25,"ب",2,0],["أمشي به وَزَيتُهُ","كاد به أن يَنضبا",25,"ب",2,0],["أم شدا الأنبياءُ بالضِّفة الخَضْ","راءِ أم قامَ للملائكِ عيدُ",26,"د",1,0],["أمشي بها فوق الرِّمالِ كأنني","أمشي بطيفٍ في الظَّلامِ مُقنَّعِ",27,"ع",1,0],["أَمشي يُرَنِّحُني الأَسى","وَالبُؤسُ تَرنيحَ الشَراب",28,"ب",1,0],["أَمُشَيِّعٌ أَنَا كُلَّ يَوْمٍ ذَاهِباً","وَمُشَيِّعٌ في الإِثْرِ قَلْباً ذَائِبا",29,"ب",2,1],["أمشي على ورق الخريطة خائفا","فعلى الخريطة كلنا أغراب",30,"ب",1,0],["أمشفقٌ حولي ولا إشفاق","إلا المنى والكوخ والإخفاقُ",31,"ق",1,1],["أمشي ولو أموت وأنا أمشي .. ولاكن ماحبي","ولا أعشق الصوره . ولا الكربون ولا أعشق غيا",32,"ي",2,0],["أمشى اليك وانت تملونى","وبين بابك .. بين جنبيا",33,"ي",2,0],["أم شواها إذا أغضَّ بُراها","أم حَشاها أم فرعَها الفينانا",34,"ن",2,0],["أَم شَمس ذاتِكَ عَن غَير الغَباء غَدَت","مَحجوبة وَهِيَ الإِشراق لِلأَبَد",35,"د",1,0],["امش مهلا للكاظمية واقرع","باب باب الاحباب حينا تراد",36,"د",1,0],["أم شيخُنا الجُنديُّ حَنَّ ورَنَّما","مُتَغَزِّلاً بِمَعاطِفٍ وقُدودِ",37,"د",1,0],["أم شاقَك الذِّكرُ القديم","ذكرُ الحِمى قبلَ السَديم",38,"م",1,0],["أم شعرُ أظرفِ مَن مَشى فوق الثّرى ال","حسنِ بنِ عبد اللهِ ذي الإحسانِ",39,"ن",1,0],["أمْشي عَلى حَدِّ العُروبَةِ واجِمًا","أنّى نَظَرْتُ فَنَكْسَةٌ وَبَلاءُ",40,"ا",2,0],["أمشي وفي كفي عصا أنقي","بها وأهوي ساعة ساعه",41,"ع",2,0],["أم شحوب الشّمس أم ما","تركت بعد الغروب",42,"ب",1,0],["أم شباب كما بدا نَبْتُه الغضْ","ضُ وعُمْر لَدْنُ الحواشي نضير",43,"ر",1,0],["أمشي بقلبي لا برجلي إنما","تمشي بحسب هوى القلوب الأرجلُ",44,"ل",1,1],["امش إليها مشية الليث أو","فاحمل عليها حملة البر",45,"ر",1,0],["أمشرفي بصفاته وحلاه","خلَعاً علي تُفيضهن علاه",46,"ا",2,1],["أَمُشرِّفاً قَدري بِسَعدِ قدومهِ","تَفديكَ نَفسي من شَريفٍ ماجدِ",47,"د",1,1],["أمشى ومصباحي على راحتي","تطفىء منه الريح أو تشتعل",48,"ل",1,0],["أَم شَمال شحرى","بِنَفح وادي القَنانِم",49,"م",1,0],["أُمَشّي حولها وأَطوفُ فيها","وتُعجبني المَحاجِرُ والفُروعُ",50,"ع",1,0],["أَمشِي وأقبعُ جُنّاباً ليَهدِيني","إن الجنيبةَ مما يَجشمُ الغَدرا",51,"ر",2,0],["أمشي بضعف وانحناء على","عصاي مشي الصائد الخائل",52,"ل",1,0],["أمشي كما يمشي الوَجِي في الوَحْلِ","مَشْيَ الأسيرِ مُثقَلاً بالكَبْلِ",53,"ل",1,0],["أمشِي الهُوَينى والخطبُ فِي طلبِي","يُوضِعُ طوراً وتارة عَنَقَا",54,"ق",2,0],["أمُشَيِّعِي باللّحظِ خَوفَ رَقِيبِه","والدّمعُ من أجفانِه يترقرَقُ",55,"ق",1,0],["أمشيّد الدين الحنيف بعزمة","أضحت مضاء كالبروق اللمع",56,"ع",1,0],["أمشاط درّ من الأبريز في جمَمٍ","جُعْدٍ فما بين مجموع ومفترق",57,"ق",1,0],["أمشرّد عنّا وتلك ربوعه","فعلام بشّرنا الربوع علاما",58,"م",2,0],["أمشى كأنَّ جواهراً مبثوثةً","هذا الثرى فيردّني إقدامى",59,"م",2,0],["أمشي وقد رصعنني بأعين","تكحلهنّ أُشُراً ورونقا",60,"ق",2,0],["أم شقَّ ليلَ الغورِ عن أقمارِهِ","بعدي يدٌ تمطو وطرف يطمحُ",61,"ح",1,0],["أمشيت الأعداء وهي جحافل","عن شمل دين جمعت أشتاته",62,"ت",2,0],["امشنعٌ أني جنحتُ إلى الكرى","لا كنتَ من واشٍ تزيد وافترى",63,"ر",2,1],["أمشِي على حذَرٍ به مُتَرِّبصاً","فكانِنَّي أمشِي على استحياءِ",64,"ا",2,0],["أم شكَّها سهم الزمان فأينعت","جرحاً به المستضعفون تخضَّبوا",65,"ب",3,0],["أمشي مع الركب لا يمشي سوى جسدي","لكنما الروح مالت خارج الركب",66,"ب",1,0]]}