{"poems":[[63,"أقسم بالجرد السراحيب","https://www.aldiwan.net/poem45908.html","السريع"],[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[72,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"في جلنار وأختها دبسية","https://www.aldiwan.net/poem8493.html","الكامل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[12,"ونائحة أوحيت في الصبح سمعها","https://www.aldiwan.net/poem1211.html",""],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[85,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[85,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[66,"أمشبه الطرف الكحيل بنرجس","https://www.aldiwan.net/poem38802.html","الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[105,"أمشي على خوف وطول تلفت","https://www.aldiwan.net/poem43122.html","الكامل"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[46,"المشيدات التي رفعت","https://www.aldiwan.net/poem22788.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85643","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85371","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85824","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39582","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54640","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[100,"في المساء","https://www.poetsgate.com/ViewPoem.aspx?id=50420",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[51,"حَبَّبَتْ دُرَّة ُ القِيانَ إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=30802",""]],"verses":[["أَمْشِي على ظَلْعِي إِلى شَأْوِهِ","تَعَجْرُفاً فِعْلَ الأَعارِيبِ",0,"ب",1,0],["أَمشي وَأَحمِلُ بائِسَينِ فَطارِقٌ","بابَ الحَياةِ وَمُؤذِنٌ بِزَوالِ",1,"ل",1,0],["أَمُشَيِّدَ الدُّسْتُورِ حَسْبُ المَجْدِ مَا","أَدْرَكْتَ مِنْ جَاهٍ وَرِفْعَةٍ شَانِ",2,"ن",1,0],["أم شعره والعصور ما برحت","تسعى بل استجادة قبله",3,"ل",2,0],["أمشي إلى النوم وهو منهزم","مَشيِي دبيب ومشيه خَبَب",4,"ب",1,0],["أمشي إلى القوت الزهيد وربَّما","أعلو فلا قدمِي ولا حالِي مشى",5,"ش",2,0],["أمشي على قدمي والحال واقفة","فيها فهلاَّ يكون المشي في حالي",6,"ي",1,0],["أمشَاهدي يومَ الرَّفيهة تُحتمَى","ومشَاهدي يومَ الكريهة تُخْطَبُ",7,"ب",1,0],["أُمُّ شيخٍ تُناكُ بين يديه","حين لا حاجبٌ هناكَ يمُطُّ",8,"ط",1,0],["أم شواها إذا أغصَّ بُراها","أم حَشاها أم فرعَها الفينانا",9,"ن",2,0],["أُمَشّي عَلى الأَرضِ الَّتي لَن تَضُرَّني","لِأَنكِيَ قَوماً أَو أُصادِفَ حُمَّتي",10,"ت",2,0],["أُمَشّي عَلى أَينِ الغَزاةِ وَبُعدَها","يُقَرَّبُني مِنها رَواحي وَغُدوَتي",10,"ت",2,0],["أُمَشّي بِأَطرافِ الحَماطِ وَتارَةً","تُنَفَّصُ رِجلي بُسبُطاً فَعَصَنصَرا",11,"ر",2,0],["أَمشي بروحٍ حالمٍ متَوَهِّجٍ","في ظُلمةِ الآلامِ والأَدواءِ",12,"ا",2,0],["أمشي وراء خيال لا يفارقني","كأنه نكدي في العيش أو كمدي",13,"ي",1,0],["أَم شَفَّهُ ما شَفَّني فَاِنثَنى","مُبَلبَلَ البالِ شَريدَ المَنام",14,"م",1,0],["أَمُشَبِّهَ الطَرفِ الكَحيلِ بِنَرجِسٍ","بَعدَ القِياسِ وَذاكَ مِن أَضدادِهِ",15,"د",2,1],["أم شباباً كأنّما كان روضاً","ناضراً فاغتدى عليهِ الذبولُ",16,"ل",1,0],["أَمشي دَبيباً كَالكَسيرِ وَأَتّقي","وثباً عليّ من الحِمام العادي",17,"د",2,0],["أَمشي عَلى خَوفٍ وَطولِ تَلَفُّتٍ","فَإِذا جَلَستُ خَشيتُ شَرَّ المَجلِسِ",18,"س",1,1],["أَمشي كَما حَرَّكت رِيحٌ يَمانِيَةٌ","غُصناً مِنَ البانِ رَطباً طَلَّهُ الرِهَمُ",19,"م",1,0],["أَمشي إِلى جَنبِها أُزاحِمُها","عَمداً وَما بِالطَريقِ مِن ضيقِ",20,"ق",1,0],["أُمُّ شِبلٍ فَوقَها لِبَدٌ","ظُفرُها مِن قَتلِنا وَرِسُ",21,"س",1,0],["أَمشي على وضح اليَقين بليلَتي","حسبي اليَقين وحسبي الأوضاح",22,"ح",1,0],["أَمشي وَما مشيي هناك لغاية","في وسط نور تارة وَظَلام",23,"م",1,0],["أمشي عليه فوق كبش أملح","قرنان اليته تقوم ونرتمي",24,"ي",1,0],["أمشي بمصباحي وحي","داً في الرياحِ مُتعبا",25,"ب",2,0],["أمشي به وَزَيتُهُ","كاد به أن يَنضبا",25,"ب",2,0],["أم شدا الأنبياءُ بالضِّفة الخَضْ","راءِ أم قامَ للملائكِ عيدُ",26,"د",1,0],["أمشي بها فوق الرِّمالِ كأنني","أمشي بطيفٍ في الظَّلامِ مُقنَّعِ",27,"ع",1,0],["أَمشي يُرَنِّحُني الأَسى","وَالبُؤسُ تَرنيحَ الشَراب",28,"ب",1,0],["أَمُشَيِّعٌ أَنَا كُلَّ يَوْمٍ ذَاهِباً","وَمُشَيِّعٌ في الإِثْرِ قَلْباً ذَائِبا",29,"ب",2,1],["أمشي على ورق الخريطة خائفا","فعلى الخريطة كلنا أغراب",30,"ب",1,0],["أمشفقٌ حولي ولا إشفاق","إلا المنى والكوخ والإخفاقُ",31,"ق",1,1],["أمشى اليك وانت تملونى","وبين بابك .. بين جنبيا",32,"ي",2,0],["أم شواها إذا أغضَّ بُراها","أم حَشاها أم فرعَها الفينانا",33,"ن",2,0]]}