{"poems":[[74,"تبدت وقد أخفاني السقم وانبرت","https://www.aldiwan.net/poem20472.html","الطويل"],[87,"بنى عبد السلام على أبيكم","https://www.aldiwan.net/poem7142.html","الوافر"],[82,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[48,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[136,"إن كان ربي أخفى الشيخ عن زمر","https://www.aldiwan.net/poem54644.html","البسيط"],[147,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[186,"قف بي نحي رباها أيها الحادي","https://www.aldiwan.net/poem61045.html","البسيط"],[230,"شمس المعالي كعقود الجمان","https://www.aldiwan.net/poem55208.html","السريع"],[230,"إذا هب مبتل النسيم على الورد","https://www.aldiwan.net/poem55245.html","الطويل"],[354,"مرابع سعدى للعيون مراتع","https://www.aldiwan.net/poem15780.html","الطويل"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[408,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[409,"صفي الدين قد وافى النظام","https://www.aldiwan.net/poem33417.html","الوافر"],[449,"عفوت حتى لا أريد العتاب","https://www.aldiwan.net/poem56002.html","عموديه"],[469,"وهيفاء تقتل عشاقها","https://www.aldiwan.net/poem3318.html","عموديه"],[469,"عج بالمطي في أظعانها","https://www.aldiwan.net/poem3628.html","عموديه"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101461","الوافر"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66985","المتقارب"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123387","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64774","السريع"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122885","الوافر"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73959","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95566","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123748","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100361","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204919","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132562","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145539","الخفيف"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4007,"","https://poetry.dctabudhabi.ae/diwan/poem/130303","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94584","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66132","الطويل"],[5163,"إذا الشمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=33951",""],[5389,"اشتياق الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=215191",""],[5691,"نجوم وبشر","https://www.poetsgate.com/ViewPoem.aspx?id=206118",""],[6093,"اللقْطَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205374",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[6237,"القلب الكبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77899&r=&rc=41",""]],"verses":[["يحجبها دمعي وحجبني الضنا","فلست أرى ليلى وليس تراني",0,"ي",1,0],["يحج لقبره بؤس عفاة","ورب القبر بالفردوس حِل",1,"ل",1,0],["يحجب جسمُ الكاسِ من سعيرِها","نفحاً عن الكاسِ ولولاه نفح",2,"ح",1,0],["يَحُجُّ مَقامَ إِبراهيمَ وَفدٌ","وَكَم أَمثالِ مَوقِفِهِ وَطَسنَه",3,"ن",2,0],["يُحَجُّ للبر وللخلال","وتارة لله ذي الجلال",4,"ل",1,0],["يحجون سبهم للشيخ ضائره","كلا وسبهمُ للشيخ لم يَضَرِ",5,"ر",1,0],["يُحَجَّبُ إِعظاماً وَما دونَ عَدلِهِ","وَفائِضِ جَدواهُ حِجابٌ وَلا سِترُ",6,"ر",1,0],["يحجّب البعدُ سيماها فان قربت","صدّت دلالا فزادت غلّة الصادي",7,"د",2,0],["يَحُجُّ ذو الرَاي بهِ خَصمَهُ","مِن قَبلِ أَن تَعمَلَ فيه السِنان",8,"ن",1,0],["يحجِّبها عَنّي الرَقيبُ وَدونَها","حجابان من هجرٍ شَديدٍ وَمن بُعدِ",9,"د",1,0],["يُحَجِّبُنا عَنها الغَداةَ سُفورُها","وَتَجلو مَعانيها عَلَينا البَراقِعُ",10,"ع",1,0],["يَحُجُّ إِلَيها مَن يُجيبُ نِدا النَدى","وَلَكِنَّهُ حَجٌّ يَدومُ بِلا نَفرِ",11,"ر",1,0],["يحجَونَ أنصارَ الإِلهِ بأنّنا","قرابتُهُ مِنّا بهِ اتّصَلَ لحبلُ",12,"ل",1,0],["يحج المستطيع من القوافي","إليه فللنظام به ازدحام",13,"م",1,0],["يحجبن بالايدي وجوها غدت","تحكي شموسا خشية ان تصاب",14,"ب",1,0],["يحجّب عنَّا نساءَ الخيام","ويبدو بكل حسامِ ذكر",15,"ر",1,0],["يحجبنَ فالأقمار في هالاتها","ويمسنَ فالأغصان في كثبانها",16,"ن",3,0],["يحج إليه أهل الذو","ق لا أعمى وأطروش",17,"ش",1,0],["يَحُجُّ ذَرَاهُ الدَّهْرَ عافٍ وخائفٌ","جُمُوعاً كما وَافَى الحجيْجُ المشاعِرَا",18,"ر",2,0],["يَحْجِلُ في آثارهمْ بَعْدَهُمُ","بادي السِّمات أَبْقَعٌ وأسْوَدُ",19,"د",1,0],["يُحجَمُ عَنْ إِحْجامِهِ مُقدِمَاً","كأَنَّهُ يَحذَرُ أَنْ يَحْذَرَا",20,"ر",2,0],["يحج على الجمال ولو تجلَّى","لمكةَ جاءها في بعض ساعه",21,"ه",1,0],["يحجون من بطحاء كعبة مكة","تحط بها الأوزار عنهم وتطرح",22,"ح",1,0],["يحجُّ إليه القاصدون ليقبسوا","عوارفه المثلى فيصدقهم قصدُ",23,"د",1,0],["يُحجِمُ الدهرُ عنهُ عن كلماتٍ","وَقْعها في حَشاه وقْعُ الكلوم",24,"م",1,0],["يحجم عن فرط أعاجيبها","وعن مدى غاياتها السحرُ",25,"ر",1,0],["يَحجُلن في عَطَن قَد كنتُ أَعهده","قَبل الحلول به للعين مَلآنِ",26,"ن",1,0],["يحُجُّ إلى بغدادَ يبغى زيارةً","له القطبُ يسعى خادماً ويسيحُ",27,"ح",1,0],["يحجب قرن الشمس مشمخرها","حتى ترى الهجير كالاصائل",28,"ل",1,0],["يحج له عشاق شعري مواكبا","يقبّله هذه وذاك يسلّم",29,"م",1,0],["يحجب غيم النعش شمس فضيلة","غدت بعد اشراق إلى الغرب تجنح",30,"ح",1,0],["يحجب النور شخصه حين يبدو","فهو للناظرين باد جلي",31,"ي",1,0],["يحج وفاده منه إلى حرم","رحب الفناء حلال الصيد في الحرم",32,"م",1,0],["يُحجدِمُ حيناً ثُمَّ يَهجُمُ","بِبَأسِهِ المُعتادِ ثُمَّ يُهزَمُ",33,"م",1,0],["يَحجِزُ مُشتَدّاً عَلى الأَعادي","بَينَ الأَخائِيَينَ وَالطُروادِ",33,"د",1,0],["يحجّ كعبته طلابُ جوهره","فينفرون وكل أدرك الأربا",34,"ب",2,0],["يحجو بأحجيةٍ محاجات الحجى","وبحل ألغاز العلوم خبيرُ",35,"ر",1,0],["يُحجُّ على بعد المزار ولم يكن","على زائرٍ فرضٌ كزوّارِ مكَّةِ",36,"ه",1,0],["يَحُجُّ إليهِ المُسْلِمُونَ وقَلْبُهُمْ","تَعَلَّقَ في أَرْكانهِ فَتَحَرَّما",37,"م",2,0],["يحجُّ إليهنَّ الملاكُ تبركاً","كأنَّ بهنَّ الوحيُ ها قد تنزَّلا",38,"ل",2,0],["يحجي بسمك ، يدّعي لشخصك وريث","وهو والشيطان من نفس الجنس",39,"س",1,0],["يحْجُبُ الأنْجُمَ في أفْلاكِها","فُلُكاً تمْخُرُ بحْراً مائِرا",40,"ر",2,0],["يحجم الفيل من أبدى تعصبَهُ","وقد يضخم منحاز الهوى القِطَّةْ",41,"ط",2,0],["يَحجُبونَ الضِّياءَ عَن كُلِّ راءٍ","أَيُّ مِسكٍ صانَ الخِباءُ عَبيرَه",42,"ر",2,0],["يحجب الناقصُ سفلى نفسه","بتعاليه على الناس غرورا",43,"ر",2,0]]}