{"poems":[[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[91,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[42,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[146,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[234,"ما محا الذنب عن ذوي الاقتراف","https://www.aldiwan.net/poem50947.html","الخفيف"],[302,"أي ذنب في هواكم أذنبه","https://www.aldiwan.net/poem33327.html","الرمل"],[458,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[567,"شاب شعري نظير ما شاب شعري","https://www.aldiwan.net/poem52740.html","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90577","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100409","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202408","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62973","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108032","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108333",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108194","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108123","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45071","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[5324,"أنا لا أسميه شيا","https://www.poetsgate.com/ViewPoem.aspx?id=207173",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""]],"verses":[["ليس نوع الإنسان إلا كحيوا","ن وليس الأفراد إلا خلايا",0,"ي",2,0],["ليس ناس في الأرض طابوا فماتوا","مثل ناس في الأرض ماتوا فطابوا",1,"ب",3,0],["لَيسَ ناهِيَّ عَن طِلابِ الغَواني","وَخطُ شَيبٍ بَدا وَدِرسُ خِضابِ",2,"ب",1,0],["ليس ندري ما يفعلانِ ولا نعلمُ","عمَّا زُرّتْ عليه الجيوب",3,"ب",1,0],["ليس نضيجُ اللحم للمُناشل","شتَّان لحماً منضجٍ وناشل",4,"ل",1,0],["ليس ندرِى متى نُقاد لعَقرٍ","فبما تَعرِفُ الحُشاشاتُ أَمْنا",5,"ن",2,0],["ليس نصرِي لك الغداةَ بِنَاءٍ","عنك منّي ولا حِفاظِي بعافِ",6,"ف",1,0],["لَيسَ نُكراً بكُمُ إِعجابُهُ","من رأَى شَيئاً عَجيباً أَعجبَه",7,"ب",2,0],["ليسَ نومُ الشعبُ إلاَّ سِنةً","وكذاك العدلُ أو صدقُ اليقين",8,"ن",1,0],["ليسَ نَنسَى لفرَنسا","فَضلَها صُبحا وَمَمسَى",9,"س",2,0],["ليسَ نفسٌ لا تعرِفُ البُخلَ إلاّ","نفسُ عبد العزيزِ كَنزي وذُخري",10,"ر",2,0],["ليس نظم القريض بالحبرِ عيباً","بل كمالاً مكبّلاً للمعالي",11,"ل",2,0],["لي سنة هي فيك واحدة","واراك فيَّ قضيت في سنن",12,"ن",1,0],["ليس نيل العلى بصعب اذا ثا","رت اليه حمية قعساء",13,"ا",2,0],["ليس ننجو من مقبل الحرب إلا","إن غدونا ملائكاً بالضمير",14,"ر",1,0],["ليس نظمُ الدرِ الذي لم يثقب","كنظامِ الممرن المثقوبِ",15,"ب",1,0],["ليس نجني منها سوى جسرةٍ فو","ق الذي بالفؤَاد بات يحيق",16,"ق",1,0],["ليس نبكي الشباب حسب ولكن","قد بكينا حجى الجنان وطهرا",17,"ر",2,0],["ليس نرضى من الشآم سوى من","سال من عُرف راحتيه الغمام",18,"م",1,0],["ليسَ نبغي من الكريم جزاءً","تستحق الثناءَ منا الكرام",18,"م",1,0],["ليس ننسى صاحباً من شكله","عوَّل الصاحب في الجلى عليه",19,"ي",2,0],["لَيسَ نُكراً فَأَنتَ رَوضُ نِظامٍ","مِن فُروعٍ لَهُ الأَزاهِرُ تُجنى",20,"ن",2,0],["ليسَ نيلُ العلياء في كبر سنٍّ","بل بجدٍّ عالٍ ورأي سديد",21,"د",1,0],["ليس نكرا إذا أسرت ولكن","كان نكرا بأن أعاني عتقا",22,"ق",2,0],["لَيسَ نَهداً... أنا لا أدعوهُ أيّا","نَهدُكِ حاشاهُ أن أُسميهِ شَيّا",23,"ي",2,0],["لي سنّةٌ غرّاءُ تكنفني","إن ضيعت أتباعها مِللُ",24,"ل",1,0]]}