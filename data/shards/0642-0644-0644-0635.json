{"poems":[[88,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[240,"قل لصديقي أبي علي","https://www.aldiwan.net/poem31802.html","مجزوء البسيط"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[264,"","https://poetry.dctabudhabi.ae/diwan/poem/83744","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11993","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83572","الخفيف"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147182","الخفيف"]],"verses":[["قُل لِصَبِّ النيلِ إِن لاقَيتَهُ","في جِوارِ الدائِمِ الفَردِ الصَمَد",0,"د",1,0],["قُل لِصادي الأَمالِ لا تَرِدِ العَي","شَ فَإِنَّ الحَياةَ لَمعُ سَرابِ",1,"ب",1,0],["قُل لِصيدِ المُلوكِ أَنقَضتُ ظَهري","في رِضاكُم مِمّا أَقولُ ذُنوبا",2,"ب",2,0],["قُل لِصَديقي أَبي عَلِيٍّ","ما هَكَذا يَفعَلُ الصَديقُ",3,"ق",1,1],["قل لصرف الردى بأي زمان","قدت صعباً إباؤه مشهور",4,"ر",1,0],["قل لصبّ ذاقَ وجداً وصبا","فصبا مذ صبّ في الدمع الدمي",5,"ي",1,0],["قُلّ لِصَلاحِ الدينِ رَبِّ النَدى","بَلِّغ عُبَيداً كُلَّ ما أَمَّلَه",6,"ه",1,1],["قُل لِصَفو الحَياةِ أَن يَتَجَدَّد","وَهزار الرِياضِ أَن يَتَغَرَّد",7,"د",1,1],["قل لصرف الردى بأي زمان قدت صعباً إباؤه مشهور","وبأي الرقى توصلت",8,"ت",1,0]]}