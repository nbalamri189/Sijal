e.com/ViewPoem.aspx?id=201599",""],[5612,"بالبابِ باتَ العائدونْ","https://www.poetsgate.com/ViewPoem.aspx?id=179613",""],[5763,"انتحار الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=27076",""],[5989,"يا راحلاً قد شاقهُ الغرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=181565",""],[4442,"أكبروه أن يمشي في الصف قدما","https://www.poetsgate.com/ViewPoem.aspx?id=170996",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[6124,"حركني","https://www.poetsgate.com/ViewPoem.aspx?id=159965",""],[6189,"أعراس الحداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83599&r=&rc=66",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[572,"ما بالُ طفشيلِكَ قد أخِّرتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9304&r=&rc=161",""]],"verses":[["وَأَخضَرَ مَستورِ التُرابِ بِرَوضَةٍ","رَعَينا وَقَد لَبّى الرُغاءَ صَهيلُ",0,"ل",1,0],["وأخضر مثل سنا العيش النضر","يطوي الفلا وكيف لا وهو الخضر",1,"ر",1,0],["وأخضر كالطاووس يُحسَبُ رأسُهُ","بخضراء من حُرِّ الحرير مقنَّعا",2,"ع",2,0],["وَأَخضَرَ آجِنٍ في ظِلِّ لَيلٍ","سَقَيتُ بِجَمِّهِ رَسَلاً حِرارا",3,"ر",2,0],["واخضراراً أَبديًّا","لَيْسَ تَمحوهُ اللَّيالْ",4,"ل",1,0],["وَاِخضَرَّ مَوشِيُّ البُرودِ وَقَد بَدا","مِنهُنَّ ديباجُ الخُدودِ المُذهَبُ",5,"ب",1,0],["واخضوضرت من شوقها، أحرفٌ","وأوشكت فواصلٌ أن تطير",6,"ر",1,0],["وأخضرَ من وَشْي الحَدائقِ مُعْلَمٍ","تَجُرُّ عليه السُّحْبُ وَشْيَ المَطارفِ",7,"ف",1,0],["وَاِخضَرَّ واديها وَحَدَّقَ زَهرُهُ","وَالنيلُ فيهِ كَكَوثَرٍ بِجِنانِ",8,"ن",1,0],["وأخضر لولا آيةٌ ما ركبتُهُ","وللّه تصريفُ القضاءِ كما شاءَ",9,"ا",2,1],["واخضبْ يمناك بِقانِية","فلها فَرَجٌ ينفي الحزنا",10,"ن",2,0],["وأخْضَرٍ حَصَلَتْ نفسي به وَنَجَتْ","وما تفارقُ منه روعةٌ رُوعي",11,"ي",1,1],["وَأَخضَلتُها فيهِ كَما لَو أَتَيتُهُ","طَريدَ اللَيالي أَخضَلَتني نَوافِلُه",12,"ل",2,0],["وَأَخضَرَ عَجّاجٍ تُدَرِّجُهُ الصَبا","فَتُتهِمُ فيهِ العَينُ طَوراً وَتُنجِدُ",13,"د",1,0],["وأخضعَ النهرَ لسلطانه","وهو إلهٌ ساد في الأقدمينْ",14,"ن",1,0],["واخضر قدّامه عش تدلله","على رفيف الدوالي روضة أنف",15,"ف",1,0],["وأخضر بين الأيك والبحر حائرا","وأبيض بالوهج السماوي مشربا",16,"ب",2,0],["وَاِخضَع وَذل وَلا تَقُل","حَسَبٌ هُناكَ وَلا نَسَب",17,"ب",1,0],["واخضرت الأرض واستحيا الموات فهل","يخضر لي بربيع الوصل موتان",18,"ن",1,0],["واخضرارٌ وزرقةٌ وابيضاض","واصفرارٌ فلا يُقَذَّى سَنَاهَا",19,"ا",3,0],["واخَضَلَت الشَّهادةُ بَعدَ يُبسٍ","وأُحيِىَ قَفوُ آثَارِ الرَّسُولِ",20,"ل",1,0],["واخضلّ من إقدامهِ وجه الثرى","وغدا الصعيد به صيعداً طيبا",21,"ب",2,0],["واخضع لهم واخدمهم بتودد","وتلق أمرهم على الاخباب",22,"ب",1,0],["وأخضع ذلةً فتزيد تيهاً","وفي هجري أراها في اشتداد",23,"د",1,0],["واخضر عيشي من جدواه وانتزعت","عن باب داري دواعي الهم والوجل",24,"ل",1,0],["واخضرَّ مُغبرُّ الثرى فنسيمُهُ","يُثني على سُقيا أجشَّ هَتونِ",25,"ن",1,0],["وأُخَضْخِضَنَّ حشا الظلامِ إلى الدُّمى","وَأُصَافِحنَّ سوالفَ الأجياد",26,"د",1,0],["واخضبي بالقلوبِ لحظكِ إنا","لا نحبُّ الحسامَ غير خضيبِ",27,"ب",1,0],["واخضر مربعها ومرتعها الذي","لي ريم رامة اذكرت آرامه",28,"م",2,0],["وَاِخضَرَّ يابِسُ عُودِها","بِنَداكَ وَاِخضَلَّت رُباها",29,"ا",3,0],["واخضرَّ في صُدغيه آس عذاره","واحمرَّ من وجناته التَّفاحُ",30,"ح",1,0],["واخضع بالذلّ لتنتصرا","كرّر في الليل إذا اعتكرا",31,"ر",2,0],["واخضع بالذلّ بباب العز","ز ولذ بالصدق ولا تَعُجِ",32,"ج",1,0],["واخضع وتب لله باستغفارِ","وادخل لباب الذلّ بانكسارِ",33,"ر",1,0],["وأخضع المرائين منها مفاوزا","كأني وأحبابي بهن نزول",34,"ل",1,0],["واخضر جدع كان قبل هشيما","صلوا عليه وَسَلموا تَسليما",35,"م",2,0],["واخضر فَردوس الخَمائِل اذ غَدا","وَسرى عليه حيا العَريض الممطر",36,"ر",1,0],["واخْضَرَّ شارِبُه فبان لغُلَّتي","منه اخضِرارُ الرَّوْض حَوْلَ المَوْرِد",37,"د",1,0],["واخضع لساقيهم وقطب مدارهم","وإمام سالك سبلهم والواصل",38,"ل",1,0],["واخضعوا مرة لحكم الليالي","فالليالي من الزمان حبالى",39,"ل",2,0],["وَاخضر رَوض الأَماني فَهِيَ حالية","كَأَنَّما جَرَّ فيها ذَيلَهُ الخضرُ",40,"ر",1,0],["واخضلّ ربع الحمى بالخصب مبتسما","إذ فاض ما بين منهلٍّ ومنسكبِ",41,"ب",1,0],["وأخضرَ مرهوبِ الغرارِ إذا بكى","فحاملُهُ طلْق الأسرّة جَذْلانُ",42,"ن",1,0],["وأخضر مثل ما ينوي لعاشقه","من الوصالِ غدا في الحر ملتهما",43,"م",2,0],["وأَخضَلَ الدمعُ من أَجفانِ مُقْلَتِهِ","مجالَهُ فِي نجيعٍ منهُمُ خَضِلِ",44,"ل",1,0],["واخضر منها جديب الفكر فاتزرت","بها النهى وارتوى من فيضها الأدبا",45,"ب",2,0],["واخضل يخطر مختالا ونفحته","ما ضوّع السهل منها عطر الجبلا",46,"ل",2,0],["وأخضرُ لا يروق العينَ يُطْوَى","على بيضاءَ سوداءِ الإهابِ",47,"ب",1,0],["وَاِخضِب بِهِ شَعرَكَ يا شَيخَنا","مِنَ العِذارَينِ إِلى الفَكِّ",48,"ك",1,0],["وأخضع مذ صار الخضوع رداءه","لبارئه بالهمة العجم والعربا",49,"ب",2,0],["وأخضع فرسان التدلي ببانا","وصيَّر أقطاب الوجود عيالنا",50,"ن",2,0],["واخضَرَّ ما قد جَفَّ من نَبْتِ الرُّبَى","فجرَت مياهُ الخِصبِ في عِيدانِهِ",51,"ن",2,0],["واخضر روض الحق من إنصافهم","وازهرّ غصن العدل فيه وأورقا",52,"ق",2,0],["وَاخضرّ غبَّ الريِّ مِنها حَزنُها","وَالسَهل جادَ ببرّه المَعهود",53,"د",1,0],["واخضرت الصحراء للجند الذي","أنست به وهو الرهيب الهائل",54,"ل",1,0],["وَاخْضَرَّ آسُ عذَارِ وَرْدَةِ خَدّهِ","فَحَمَاهُ سَالفُهُ بِعَقْرَبِ عَنْبَرِ",55,"ر",1,0],["واخضرّت الأرض لما داسها قدم ال","مولى الذي فيه شحرور الهنا صدحا",56,"ح",2,0],["واخضع كل مفضالٍ عزيزٍ","لديه وكل حبرٍ فيلسوفِ",57,"ف",1,0],["واخضل كُل كثيب ذاق مشربها","وألبست كل غيضٍ ثوب نعماها",58,"ا",3,0],["واخضرّ كل كثيبٍ والنراجس من","أعجابها شخصت لله عيناها",59,"ا",3,0],["واخضلّ روض ربيع الأمن حين هما","عليه منك سحاب الجود واندفقا",60,"ق",2,0],["واخضع وكن متبتلا متعبدا","تحظى برشف مشارب الاكواب",61,"ب",1,0],["وَاِخضَع لَدى اَعتاب حَضرة جَدِهِ","قطب الرِجال تَفز بِكُل مُراد",62,"د",1,0],["وأخضرُها من طيب عيشي الذي مضى","لديك وأرجو بالرضا تستردُّه",63,"د",2,0],["واخضرت الأَرجاء وَالحزون","وَقرت القلوب وَالعيون",64,"ن",1,0],["واخضع لها كخطوعنا لبراعة ال","ملَكيِّ أو لبيانه السحّار",65,"ر",1,0],["واخضع لأرباب الملاحة والبها","إن الخضوع مطيةٌ للعالم",66,"م",1,0],["واخضعوا الله في أحكامه","إنّما العاقل من خاف الإلها",67,"ا",1,0],["وأخضرَ فُستُقِيّ اللونِ غضّ","يروقُ بِحُسنِ منظره العيونا",68,"ن",2,1],["وأَخضعُ حُبّاً للحِسان وإِنَّني","ليأْخذني حتَّى على القَدَر الكِبْرُ",69,"ر",1,0],["واخضع له واضرع إليه وناده","متنصلا مما جنيت بذلة",70,"ه",1,0],["وَأَخضَرَ اللَونِ يَحكي","لِباسَ أَهلِ الجِنانِ",71,"ن",1,0],["واخضرُ الساحة بل أبيضُ الراحة","يغنى عندَه المُعْتَفُون",72,"ن",1,0],["وَاخضب أَنمل الفَتيات فيها","بِصَبغة أَدمُع تَأبى النصولا",73,"ل",2,0],["واخضَرَّ الدوحِ من عارِضِهِ","لمّا استدار جَدوَلاً مَنسوباً",74,"ب",2,0],["واخضع لأحكام الصبابة مذعنا","إن كنت ممن للهوى يتجلد",75,"د",1,0],["واخضل غصن التهاني في جوانبها","واخضر عود الأماني حيثما زرعا",76,"ع",2,0],["واْخضَرَّ في وَجْنَتَيْه خَطُّهما","بحافَةِ الماءِ ينبتُ العُشُب",77,"ب",1,0],["واخضع فثمة قبة","خضعت لادناها السما",78,"م",2,0],["واخضرت الغبراء لما احمرّ من","بعد البياض إلى الغصون اللثم",79,"م",1,0],["وأخضع فقرى كبره وثراءه","وايّ غنى للمرء غير غنى النفس",80,"س",1,0],["واخضعتم فيه كل الشعوب","فرساً وروما وهنداً وصينا",81,"ن",2,0],["واخضرت الدنيا وزان جمالها","ثوب من البشر الجزيل قشيب",82,"ب",1,0],["وَأَخضَعنا رِقابَكُمُ فَذَلَّت","فَلَيسَت ما حَييتُم تَستَقِلُّ",83,"ل",1,0],["واخضرَّتِ الأرضُ مثلَ الروضِ ضاحكةً","وَقَدْ كستْها ثيابَ الزَّهر ألوانُ",84,"ن",1,0],["واخضرَّ وادي الفضل وانفجر الندى","ها فاسْتَقوا أهلَ الظما من مائه",85,"ا",3,0],["واخضرَّ وجهُ الأرضِ وابتسم الحَيا","وتَرنَّح الزمنُ الطَّروف جِماحا",86,"ح",2,0],["وَاِخضَلَت الأَقطار وَاِبتَسَم الحَيا","عَن ثَغر بَرق وَالسَحائب تُمطر",87,"ر",1,0],["واخضَع لهُ ابداً وكُن","بحبائِلِ الإِفراز ماسِك",88,"ك",1,0],["واخضع لما تقتضي الاقدار كيف جرت","فلست دافعها إن رام راميها",89,"ي",3,0],["واخضع لما أمضى الإله فإنها","حِكَمٌ بها قد جفَّ في اللَوح القَلم",90,"م",1,0],["وَاخْضَرَّ فَوْقَ الْوَرْدِ آسُ عِذارِهِ","فَعَجِبْتُ لِلْجَنَّاتِ فِي النِّيرانِ",91,"ن",1,0],["واخضع ذلا للجمال لارتقي","مقاما بعز الذل سامي الدعائم",92,"م",1,0],["واخضع إلى الحق طعهُ حق طاعتهِ","وهو القدير الذي جلَّت فضائلهُ",93,"ل",2,0],["واخضعوا قانتين دون علاه","فله بعد ربنا التسبيح",94,"ح",1,0],["واخضر عودٌ يابس واستوى","في السهل بالخضرة بستانه",95,"ن",2,0],["وَاخْضَرَّتِ الأَغْصَاْنُ بَعْدَ جَفَاْفِهَاْ","زَمَناً، وَسَاْدَتْ ثَوْرَةٌ خَضْرَاْءُ",96,"ا",2,0],["وأخضع لله الذي هو خالقي","ولن أعطي المخلوق من نفسي الذلا",97,"ل",2,0],["واخْضَلَّتِ الأكنافُ بَعْدَ عِجافِها","وَنُقيمُ رغْم ذُبولِها الإكْليلا",98,"ل",2,0],["وَاخْضَرَّ فِى قَلْبِي خَرِيفٌ خِلْتُهُ","مُسْتَوْطِنَاً ، أَوْرَاقُهُ مَا مَلَّتْ",99,"ت",1,0],["وَاخْضَوْضَرَ الْعُشْبُ عَلَى يَاقَةٍ","قَمِيصُهَا اخْضَلَّ بِذِي الْأَهْيَفِ",100,"ف",1,0],["واخضوضرتْ آفاقُ حلمي إذْ دنا","من حضنكم وانصاع دون تكلفِ",101,"ف",1,0],["واخضرار الحقول ايّاك يتلو","بصلاة بين القلوب ستبقى",102,"ق",2,0],["واخضوضرت حِلل القصيد وأينعت","حتى سرى في نسغها الإعزازُ",103,"ز",1,0],["واخضع لمنطقه العجيب فإنه","بوش الحكيم الملهم الفهّام",104,"م",1,0],["واخضوْضرتْ بيداءُ مكة وانجلتْ","ظلماتها لمّا أهلَّ ضِياكا",105,"ك",2,0],["واخْضَعْ لهُ فهُوَ الكريمُ عَطِيّةً","وهُوَ العظيمُ مهابةً وجلالا",106,"ل",2,0],["وأخضرَّ حزني على أهدابِ محبرتي","أخفيهِ لكن يذُرُّ الحبُّ ومضَ سنى",107,"ن",2,0],["واخضَّر فيه الشعر منذ وعى","ماذا يكون الهم والقلق",108,"ق",1,0],["واخضعو قانتين دون علاه","فله بعد ربنا التسبيح",109,"ح",1,0],["واخضوضرتْ دونكَ الصحراءُ معشبةً","وابْيَضَّ وجهُ الدجى مِنْ نورِكُمْ وصفا",110,"ف",2,0],["وَ اخْضِرَارًا بِحَقْلِ عَينَيكِ يَسْبِي","مُهْجَتِي , يَسْتَبِيحُها أَلْوَانا ؟",111,"ن",2,0],["وأخضِّبُ لحيةَ مولايَ","كي ترتاحَ الحكمةُ في نجوايَ.",112,"ي",1,0],["واخضرَّت الصحراء ، وانثال مِنْ","كُثبانها الصفراءُ وجهُ الجواد",113,"د",1,0],["واخضرارُ الزيتونِ يسْوَدّ لما","يعزفُ الموتُ نغمةً للحُداءِ",114,"ا",2,0],["وأخضرٌ يضحَكُ في أصفرٍ","كأَنَّما وَاجَهَ مَهْجورا",115,"ر",2,0]]}