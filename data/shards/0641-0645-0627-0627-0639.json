{"poems":[[37,"وقفت عليه ناقتي فتناعت","https://www.aldiwan.net/poem38814.html","الطويل"],[37,"رأيت غرابا ساقطا فوق بانة","https://www.aldiwan.net/poem39145.html","الطويل"],[29,"ألا حي الديار وإن تعفت","https://www.aldiwan.net/poem5954.html","الوافر"],[74,"تشرف يا رسول الله نظمي","https://www.aldiwan.net/poem18877.html","الوافر"],[93,"تسير بنا على عجل","https://www.aldiwan.net/poem62631.html","عموديه"],[45,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[30,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[21,"فما أعتبت في النائبات معتب","https://www.aldiwan.net/poem36149.html","الطويل"],[52,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[52,"فتاتي نديمي غنيا بحياتي","https://www.aldiwan.net/poem64737.html","الطويل"],[119,"الى الغوث الحسيني الدسوقي","https://www.aldiwan.net/poem40870.html","عموديه"],[136,"طربت لحضرة الشيخ الخديم","https://www.aldiwan.net/poem54741.html","الوافر"],[137,"لقد كنت تحكي في التجهم مالكاً","https://www.aldiwan.net/poem4212.html","الطويل"],[154,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[185,"ودعت نجدا بعد هجر هجرته","https://www.aldiwan.net/poem59085.html","الطويل"],[189,"عسى الجانب الغربي يهدي نسيمه","https://www.aldiwan.net/poem14714.html","الطويل"],[202,"دعا بإقامة الشوق الرحيل","https://www.aldiwan.net/poem51908.html","الوافر"],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[275,"إذا الريح حيتني بنفحة طيب","https://www.aldiwan.net/poem35610.html","الطويل"],[369,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[371,"وبي غمرة للشوق من بعد غمرة","https://www.aldiwan.net/poem17877.html","الطويل"],[396,"الحمد لله ذا سؤالي وذا أملى","https://www.aldiwan.net/poem54545.html","عموديه"],[416,"أسلم بن عمر وقد تعاطيت خطة","https://www.aldiwan.net/poem67487.html","الطويل"],[438,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[438,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[447,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[447,"أعزيكمو في ميت لم يزل عندي","https://www.aldiwan.net/poem14445.html","الطويل"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[520,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[543,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[578,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97017","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96994","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96974","البسيط"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147208","المجتث"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39018","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48753","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62618","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59115","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133837","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46529","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49970","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44852","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79821","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89535","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53140","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53032","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27590","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28534","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88689","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204805","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204769","الطويل"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103170","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26116","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103887","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91258","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91728","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206138","المتقارب"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85247","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45946","الوافر"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119513","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76742","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35140","الطويل"],[4839,"فَمَا أعزّك أَن كنت","https://www.poetsgate.com/ViewPoem.aspx?id=189683",""],[4955,"يا نفس ماذا جرى قد زدت من ألمي","https://www.poetsgate.com/ViewPoem.aspx?id=188490",""],[5274,"أشواق دمشقية","https://www.poetsgate.com/ViewPoem.aspx?id=203450",""],[5334,"أَمَسْعُودُ أَنْتَ اللَّئِيمُ الأَثيمُ","https://www.poetsgate.com/ViewPoem.aspx?id=96980",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5784,"وبعض الهوى .....","https://www.poetsgate.com/ViewPoem.aspx?id=191324",""],[5956,"الشعب والأرض","https://www.poetsgate.com/ViewPoem.aspx?id=192332",""],[5956,"يا خادم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""]],"verses":[["فَما أَعرِفُ الآياتِ إِلّا تَوَهُّما","وَما أَعرِفُ الأَطلالَ إِلّا تَمارِيا",0,"ي",2,0],["فَما أَعيفَ النَهدِيَّ لا دَرَّ دَرُّهُ","وَأَزجُرَهُ لِلطَيرِ لا عَزَّ ناصِرُه",1,"ر",2,0],["فَما أَعطَت سَدوسٌ مِن كَثيرٍ","وَلا حامَت سَدوسٌ عَن قَليلِ",2,"ل",1,0],["فما أعلى وأبرك منه كعبي","وما أعلى نباتي عن زُهَير",3,"ر",1,0],["فَما أَعرِفُ مَركوباً","سِوى الأَفراسِ وَالإِبلِ",4,"ل",1,0],["فَما اِعتَمَدَ اللَهُ تَقويضَها","وَلَكِن أَشارَ بِما تَفعَلُ",5,"ل",1,0],["فَما أُعطِيَ الماعونُ حَتّى تَحاسَرَت","عَلَيهِم جُموعٌ مِن حَنيفَةَ لُجَّبُ",6,"ب",1,0],["فَما أَعتَبَت في النائِباتِ مُعَّتَبٌ","وَلَكِنَها طاشَت وظَلَّت حُلُومُها",7,"ه",2,1],["فَما أَعتَبتُهُ إِلّا","بِأُخرى أَورَثَت فَترَه",8,"ر",2,0],["فَما أَعتَبَتني العَينُ مِن فَيضِ عَبرَةٍ","وَلا يَرعَوي قَلبي إِلى دَعَواتِ",9,"ت",1,0],["فما اعلاه من اصل كريم","وما ازكاه من فرع وريق",10,"ق",1,0],["فَمَا إعجَازُ حِكمَتِنَا تَنَاهَى","فَلَم تَكُ تَنتَهِى حِكَمُ الحَكِيمِ",11,"م",1,0],["فما أعظم البُشرى بعودك خامِلاً","وغيرُكَ قد أضحى النبيهَ المقدَّما",12,"م",2,0],["فما أعدَدتَ من نفرٍ","فهم لوقودها حَصَبُ",13,"ب",1,0],["فَما أَعلَمَ الواشِينَ بِالسِّرِّ بَينَنَا","وَنَحنُ كِلانَا لِلمَوَدَّةِ كاتِمُ",14,"م",1,0],["فما اعتضْتُ من تلك الرُّبا غيرَ حسرةٍ","عليها ودمعُ العينِ يستهلُّ فيَذْرِف",15,"ف",1,0],["فما أَعطيتُ مقوديَ الأعادي","وإني بالحروبِ لها كفيل",16,"ل",1,0],["فَما اِعتَصَمَت مِنكَ الوُعولُ بِقُلَّةٍ","وَلا اِمتَنَعَت مِنكَ الأُسودُ بِغيلِ",17,"ل",1,0],["فما أعذَبَ الكأس التي قد شربتُها","فكان بها سكري الذي منه صَحوتي",18,"ي",1,0],["فما أعذبَ الشَّكوى وما أعظم الهوى","إذا انفَجَرا من أعيُنٍ وقلوب",19,"ب",1,0],["فما اعتقادُ الأنامِ فيه سوى","أَنّ اللّيالي بمثْلِه عُقُم",20,"م",1,0],["فَما اِعتَضتُ أَهلاً بَعدَ أَهلِكِ جيرَةً","وَلا خِلتُ دارَ المُلكِ بَعدَكِ دارا",21,"ر",2,0],["فما اعتذاري وقد جاء النذير فلم","الواليه وأخلدت مع الكسل",22,"ل",1,0],["فَما أَعوَلَت أُمٌّ عَلى اِبنٍ وَلا بَكى","عَلى يوسُفٍ يَعقوبُ مِثلَ بُكائِكا",23,"ك",2,0],["فما اعتذارُك عن عذراءَ جامحةٍ","لانتْ كما لامسَتْها راحةُ الماءِ",24,"ا",2,0],["فما اعتدّتْ بجُملتها صفوفٌ","ولا احتدّتْ لضمّتِها صَفونُ",25,"ن",1,0],["فما اعتذارك من هذا وأَنت به","وقارف الذنب عن توب توافقه",26,"ق",2,0],["فما اعتصم الأَروى بأرعن شاهق","عن المَوت أَو في غيلها لبوة الأَسد",27,"د",1,0],["فما اعتقبتُ نِدَّه","ولا ابتغيت بدلا",28,"ل",2,0],["فما اعتلقت إلا وسيفك سابح","ولا اغتلقت إلا وسيفك فاتح",29,"ح",1,0],["فما أعظَمَ البُشرَى إذا ما رحِمتَنِي","وإن أنتَ لم ترحَم فما أسوَأَ العُبَى",30,"ب",2,0],["فَما اِعثَرَ الآمالَ في أَجلِ الفَتى","وَأَقرَبَ أَيّامَ السُرورِ مِنَ الحَزَن",31,"ن",1,0],["فما أعددت غيرك في البرايا","لكشف الضر والهول الشديد",32,"د",1,0],["فما اعترض الشك قدماً به","ولا اليوم مقترن في نظير",33,"ر",1,0],["فما أعابك قتلٌ كنت ترقبه","به لك اللَه جم الفضل قد جمعا",34,"ع",2,0],["فما اعتذارك في أن","تفني زمانك صحوا",35,"و",2,0],["فَما اعِتذارُكَ لِلَّاحي وقَدْ هَتكَتْ","عنكَ الحِجابَ أُمورٌ ليسَ تَنحجبُ",36,"ب",1,0],["فما اعتز رمسيس في مثله","جلالاً ولا قاربته إرم",37,"م",1,0],["فما أعظم الخطب عبد ذليل","يقاد إلى غائب قد بهر",38,"ر",1,0],["فَمَا اعْتَلَّ إلاَّ أنَّهُ المَاءُ رِقَّةً","أو الزَّهْرُ طِيباً أمْطَرَتْهُ سَمَاؤُهُ",39,"ا",3,0],["فما أعجب عن بعد","وأدهش فكر مرتقب",40,"ب",1,0],["فَما أَعَزَّ من قنع","وَما أَذَل من طَمَع",41,"ع",1,0],["فَما اعتَدَوا وَلا انتَخَوا وَلا بَزَوا","وَلا مِنَ الحُسنَى بِسوآهُم جَزَوا",42,"ز",3,0],["فما اعتياديَ من شكوى الزَّمان وقد","قَضى لديهم بإدراك المنى وطَري",43,"ر",2,0],["فَما أَعملتُ طَرفِي في مكانٍ","لِفَرطِ تَخَيُّلِي إِلا أَراهُ",44,"ا",2,0],["فما اعتذارُكِ يا فهرٌ ولم تثبي","بالبيض تُثلم أو بالسمر تنحطم",45,"م",1,0],["فَما أَعظَمَ النُغمى عَلَينا بِمُلكِهِ","وَلكِنَّ بَعضَ الناسِ عَن رُشدِهِ عَمي",46,"م",2,0],["فما أعملت بأساً منك إلا","حمدنا سورة البطل الشجاع",47,"ع",1,0],["فما اعتذارك من عذراء جامحة","تلين عطفاً إذا ما افتضها الماء",48,"ا",2,0],["فما أعذبَ الطعم الذي قد طعمته","من العلمِ بالله المريدِ وما أمرْ",49,"ر",1,0],["فَما أَعرَبَت عَنكَ الجُفونُ بِنَظرَةٍ","إِذا بَثَّتِ الأَحقادَ بِالنَّظَرِ الشَّزرِ",50,"ر",1,0],["فَما اعتبروها كنية بل كناية","عن الشهم اذ يسخو من الماء بالبذل",51,"ل",1,0],["فما أعطاه من دنيا شهود","وما أعطيت من دنيا الغريب",52,"ب",1,0],["فما أعقل الحيوان لا مدح أو ذمّا","فما سُرّ إن يمدح ولا استاء إن ذمّا",53,"م",2,0],["فما أعياك من طلب ورزق","كما يعييك من سرق الدواب",54,"ب",1,0],["فَما اِعتَرَفَت مِن سابِقٍ يَومَ حَلبَةٍ","كُلَيبٌ وَلا وافوا مَع الناسِ مَشهَدا",55,"د",2,0],["فما أعد ولو طالت سني سوى","تلك السويعة بالتحقيق من عمري",56,"ر",2,0],["فَما اعْتَمَدَ الصّبْر من بعْدِها","سوى ليُطيعَ بهِ ربَّهُ",57,"ب",2,0],["فما اعْتِذاري لمَوْلىً لم يُحِطْ خجلاً","سَمْعي بلَفْظٍ لهُ في القلب موقِعُهُ",58,"ع",2,0],["فَما اعتضت عنهُ في الدِيار مؤانِساً","وَمَن أَلِفَ الوَجنات يَأنف مِن وَرد",59,"د",1,0],["فَما أَعداني بِالأسقام إِلّا","سقامُ الناعس الساجي الكَليل",60,"ل",1,0],["فما أعشق الحسن إلا عليك","وكالوحش بعدك ريم الفلا",61,"ل",2,0],["فما اعتصموا الأبلجة مزبدٍ","من البحر يعلو موجه غير جازر",62,"ر",1,0],["فَما إِعرابُ مالِكَ يا نَبِيُّهُ","بِقَولِكَ أَنتَ أَعلَمُنا وَمالِكِ",63,"ك",1,0],["فما أعرف الأيام الا ذميمةً","ولا الدهر الا وهو بالثأر طالب",64,"ب",1,0],["فما أعطت نجادي شِسعَ نعل","ولا أدت بسابحتي عقالا",65,"ل",2,0],["فَما أَعقَبَ السَبكُ النُضارَ مَهانَةً","وَلا حَطَّ مَيلُ النَجمِ مِن شَرَفِ النَجمِ",66,"م",1,0],["فَمَا أعزّك أَن كن","ت قانعاً بِالْقَلِيلِ",67,"ل",1,1],["فما اعتبرتِ ولكن زدتِ معصيةً","وأظلمَ الفكرُ في تيهٍ منَ الفتنِ",68,"ن",1,0],["فما أعادَ صدى الأشْعَارِ مِئْذَنَةً","ولا امْتَطَى صَهْوَةَ الأمجادِ فُرسَانُ",69,"ن",1,0],["فما أعْطَشَ الضَّيْفَ لَمَّا غَدَا","منَ البَيْدَعات وما أَجْوَعَهْ",70,"ع",2,0],["فما أعظم الإيمان درعا وملجأ","يقي القلب زلات اليالي الحنادس",71,"س",1,0],["فما اعتادت رئاتُ الرئم خنقا","سحابيّا ولا الكربونَ نشقا",72,"ق",2,0],["فما أعجبَ المعشوقَ من سوء ظنِّهِ","إذا ما رأى عشقًا طغى وتجبَّرا",73,"ر",2,0],["فما أعمق الجذر يبقى خفيّاً","ويبقى عصيّا على كفّ خصمِهْ",74,"م",2,0],["فَمَا اعتراك كجُلِّ الناس منقصةٌ","ولا تسلَّلَ وسواسٌ لك انتقلا",75,"ل",2,0],["فَمَا أعَانَ الدَّمعُ صَاحِبَهُ","وَلَا تَسَاوَى الحُوتُ بالبَلَمِ",76,"م",1,0]]}