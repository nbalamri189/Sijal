{"poems":[[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[92,"ضحكنا على الماضي البعيد وفي غد","https://www.aldiwan.net/poem38963.html","الطويل"],[62,"في قديم الدهر قد كان لنا","https://www.aldiwan.net/poem52162.html","الرمل"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[28,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[69,"لي شهوتان أحب جمعهما","https://www.aldiwan.net/poem28890.html","أحذ الكامل"],[69,"قال لي معشوق قلبي","https://www.aldiwan.net/poem29107.html","مجزوء الرمل"],[81,"صرح بما عندي ولو ملأ الفضا","https://www.aldiwan.net/poem61466.html","الطويل"],[46,"ليشغلك ما أصبحت مرتقبا له","https://www.aldiwan.net/poem22055.html","الطويل"],[46,"إذا بلغ الإنسان خمسين حجة","https://www.aldiwan.net/poem23372.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[11,"صَحا القلبُ من سلمى ، وعن أُمّ عامرِ","https://www.poetsgate.com/ViewPoem.aspx?id=16850",""],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""]],"verses":[["لِيَشقى بِهِ عُرقوبُ كَوماءَ جَبلَةٍ","عَقيلَةِ أُدمٍ كَالهِضابِ بَهازِرِ",0,"ر",1,0],["ليَ شغلٌ يا صاح بالنظرِ المنص","ور عنهم بالمدمع السفّاح",1,"ح",1,0],["ليشكرنّك مني الدّهرَ أربعةٌ","نفسٌ وروحٌ ولحمٌ نابتٌ ودم",2,"م",1,0],["لِيَشكُرْ بَنُو الإسلام نعمةَ صاعدٍ","بل النَّاسُ طُرّاً قَوْلَةً لا تُفَنَّدُ",3,"د",1,0],["ليُشنِّفنَّهُمُ بمدحك صائغٌ","لا تكبر الآذان عن تشنيفه",4,"ف",2,0],["ليشكرا لك أنْ فخمْتَ شأنهما","عن غير مَيْلٍ إلى الإلحادِ حاشاكا",5,"ك",2,0],["ليشمّرِ الغادي إليك ذُيولَه","كيما يروحَ مُرفَّلاً ترفيلا",6,"ل",2,0],["لي شاغلٌ في حبهنْ","نَ عن التي تدعى بشاغلْ",7,"ل",1,0],["ليشهدَ مَنْ خَلْفَ الضَّبابِ فصولَها","ويَضْحَكُ منها مَنْ يمثِّلُ مَا ياتي",8,"ي",1,0],["ليشع النور منها ويرى","أهلها قدرته عند الثبات",9,"ت",1,0],["لَيَشوقُني سِحرُ العُيونِ المُجتَلى","وَيَروقُني وَردُ الخُدودِ الأَحمَرُ",10,"ر",1,0],["لِيَشغَلَ عَنّي بَعلَها بِزَمانَةٍ","تُدَلِّهُهُ عَنّي وَعَنها فَنُسعَفُ",11,"ف",1,0],["ليشهد أن الشعر شيء مشى بنا","مع الطبع جل الطبع أن يتكلفا",12,"ف",2,0],["لي شهوتانِ أحبُّ جمعَهُمَا","لو كانتِ الشهواتُ مضمونَهْ",13,"ه",1,1],["ليَ شعرٌ قدْ حكاني","بتجافٍ مستطيلُ",14,"ل",1,0],["لي شادِنٌ صادَ الأُسودَ بِمُقلَةٍ","أَلقى الكَمِيُّ لَها الذَوابِلَ مُعرِضا",15,"ض",2,0],["لِيَشغَلكَ ما أَصبَحتَ مُرتَقِباً لَهُ","عَنِ العَيبِ يُبدي وَالخَليلِ يُؤَنَّبُ",16,"ب",1,1],["لِيَشغَلَ بِذِكرِ اللَهِ عَن كُلِّ شاغِلٍ","فَذَلِكَ عِندَ اللُبِّ خَيرُ كَلامِ",17,"م",1,0],["لِيَشْكُرِ اللهُ عَنَّا المُحْسِنِينَ فَهُمْ","صَلاحُ مُجْتَمَعٍ قَدْ نَاهَزَ التَّلَفَا",18,"ف",2,0],["لِيَشْفِ مِبْضَعُكُمْ وَالرِّفْقُ يُعْمِلُهُ","صَدْعَ الرَّصَاصِ وَجُرْحَ الصَّارِمِ القَاسِي",19,"س",2,0],["ليشقى به عرقوب كوماءؤَ جبلة","ٍ عَقيلَة ِ أُدْمٍ، كالهِضابِ، بَهازِرِ",20,"ر",1,0],["ليشُُدَّ حاضرَك المضمَّخَ بالدِما","بالموَجعِ الأسيانِ من ماضيك",21,"ك",1,0],["لِيَشْمَخْ بفقدِكَ أنفُ البلاد","وأنفي وأنفُهم مُرغم",22,"م",1,0]]}