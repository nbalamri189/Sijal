{"poems":[[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[92,"ضحكنا على الماضي البعيد وفي غد","https://www.aldiwan.net/poem38963.html","الطويل"],[62,"في قديم الدهر قد كان لنا","https://www.aldiwan.net/poem52162.html","الرمل"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[28,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[69,"لي شهوتان أحب جمعهما","https://www.aldiwan.net/poem28890.html","أحذ الكامل"],[69,"قال لي معشوق قلبي","https://www.aldiwan.net/poem29107.html","مجزوء الرمل"],[81,"صرح بما عندي ولو ملأ الفضا","https://www.aldiwan.net/poem61466.html","الطويل"],[46,"ليشغلك ما أصبحت مرتقبا له","https://www.aldiwan.net/poem22055.html","الطويل"],[46,"إذا بلغ الإنسان خمسين حجة","https://www.aldiwan.net/poem23372.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[11,"صَحا القلبُ من سلمى ، وعن أُمّ عامرِ","https://www.poetsgate.com/ViewPoem.aspx?id=16850",""],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[94,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[109,"غب لثم الشفاه موضع نعلي","https://www.aldiwan.net/poem16549.html","الخفيف"],[109,"قصرت همة الكرام وطالت","https://www.aldiwan.net/poem16655.html","الخفيف"],[160,"لي شوق إلى الملاح شديد","https://www.aldiwan.net/poem58759.html","الخفيف"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[353,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[366,"من مخبري يا عفاة المزن أين همى","https://www.aldiwan.net/poem17266.html","البسيط"],[366,"أي يوم علا على الأيام","https://www.aldiwan.net/poem17333.html","الخفيف"],[380,"لي شوق إليك لا يتناها","https://www.aldiwan.net/poem48763.html","الخفيف"],[444,"أمنتذر قتلي إن العين آنست","https://www.aldiwan.net/poem812.html",""],[452,"وابق واسلم لوجنة الدهر خالا","https://www.aldiwan.net/poem13963.html","الخفيف"],[458,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[464,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[468,"غدت إلى ديره ومأواها","https://www.aldiwan.net/poem59533.html","المنسرح"],[500,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[586,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"]],"verses":[["لِيَشقى بِهِ عُرقوبُ كَوماءَ جَبلَةٍ","عَقيلَةِ أُدمٍ كَالهِضابِ بَهازِرِ",0,"ر",1,0],["ليَ شغلٌ يا صاح بالنظرِ المنص","ور عنهم بالمدمع السفّاح",1,"ح",1,0],["ليشكرنّك مني الدّهرَ أربعةٌ","نفسٌ وروحٌ ولحمٌ نابتٌ ودم",2,"م",1,0],["لِيَشكُرْ بَنُو الإسلام نعمةَ صاعدٍ","بل النَّاسُ طُرّاً قَوْلَةً لا تُفَنَّدُ",3,"د",1,0],["ليُشنِّفنَّهُمُ بمدحك صائغٌ","لا تكبر الآذان عن تشنيفه",4,"ف",2,0],["ليشكرا لك أنْ فخمْتَ شأنهما","عن غير مَيْلٍ إلى الإلحادِ حاشاكا",5,"ك",2,0],["ليشمّرِ الغادي إليك ذُيولَه","كيما يروحَ مُرفَّلاً ترفيلا",6,"ل",2,0],["لي شاغلٌ في حبهنْ","نَ عن التي تدعى بشاغلْ",7,"ل",1,0],["ليشهدَ مَنْ خَلْفَ الضَّبابِ فصولَها","ويَضْحَكُ منها مَنْ يمثِّلُ مَا ياتي",8,"ي",1,0],["ليشع النور منها ويرى","أهلها قدرته عند الثبات",9,"ت",1,0],["لَيَشوقُني سِحرُ العُيونِ المُجتَلى","وَيَروقُني وَردُ الخُدودِ الأَحمَرُ",10,"ر",1,0],["لِيَشغَلَ عَنّي بَعلَها بِزَمانَةٍ","تُدَلِّهُهُ عَنّي وَعَنها فَنُسعَفُ",11,"ف",1,0],["ليشهد أن الشعر شيء مشى بنا","مع الطبع جل الطبع أن يتكلفا",12,"ف",2,0],["لي شهوتانِ أحبُّ جمعَهُمَا","لو كانتِ الشهواتُ مضمونَهْ",13,"ه",1,1],["ليَ شعرٌ قدْ حكاني","بتجافٍ مستطيلُ",14,"ل",1,0],["لي شادِنٌ صادَ الأُسودَ بِمُقلَةٍ","أَلقى الكَمِيُّ لَها الذَوابِلَ مُعرِضا",15,"ض",2,0],["لِيَشغَلكَ ما أَصبَحتَ مُرتَقِباً لَهُ","عَنِ العَيبِ يُبدي وَالخَليلِ يُؤَنَّبُ",16,"ب",1,1],["لِيَشغَلَ بِذِكرِ اللَهِ عَن كُلِّ شاغِلٍ","فَذَلِكَ عِندَ اللُبِّ خَيرُ كَلامِ",17,"م",1,0],["لِيَشْكُرِ اللهُ عَنَّا المُحْسِنِينَ فَهُمْ","صَلاحُ مُجْتَمَعٍ قَدْ نَاهَزَ التَّلَفَا",18,"ف",2,0],["لِيَشْفِ مِبْضَعُكُمْ وَالرِّفْقُ يُعْمِلُهُ","صَدْعَ الرَّصَاصِ وَجُرْحَ الصَّارِمِ القَاسِي",19,"س",2,0],["ليشقى به عرقوب كوماءؤَ جبلة","ٍ عَقيلَة ِ أُدْمٍ، كالهِضابِ، بَهازِرِ",20,"ر",1,0],["ليشُُدَّ حاضرَك المضمَّخَ بالدِما","بالموَجعِ الأسيانِ من ماضيك",21,"ك",1,0],["لِيَشْمَخْ بفقدِكَ أنفُ البلاد","وأنفي وأنفُهم مُرغم",22,"م",1,0],["ليش شعري وللسياسة دين","يرسل النار حجّة والحساما",23,"م",2,0],["لي شَوق إِلَيك لَو رُحت أَبدي","هِ تَشكى الأَوام مني أَوامي",24,"م",2,0],["لِيَ شعر مَحَلَهُ في الثُريا","ضائع في زَمان أَهل الخُمول",25,"ل",1,0],["لي شوق إلى الملاح شديد","وغرام في كل يوم يزيد",26,"د",1,1],["لِيُشرِقوا النَصرَ مِن صُبحِ المُنى فَلَقا","وَكُلَّما شوهِدوا في جَمعِهِم فَرَقا",27,"ق",2,0],["لِيَشملني بِها فَوزٌ فَإِنّي","رَقيق لَيسَ يَرغَب في عِتاقِ",28,"ق",1,0],["لَيَشكُرَنَّكَ وَفدُ الجِنِّ إِذ أَمَرَت","مولِياتُ ثَناء ما لَها أَلَمُ",29,"م",1,0],["لي شَكوى مِنهُ وَأَنتَ عَلَيهِ","حاكِمٌ حُكمُهُ عَلى الحُكّامِ",30,"م",1,0],["لِيَ شَوق إِلَيكَ لا يَتناها","وَشُجون قَد جاوَزَت مُنتَهاها",31,"ا",3,1],["لِيشربَ منهُ جحوشٌ ويشمّهُ","بِعيني قطاميّ أغرّ شآمي",32,"م",2,0],["ليَ شوقٌ إِليك رقَّ إِلى أنْ","صارَ يُدعي صبابةً واعتلالا",33,"ل",2,0],["ليشرقنّ بحلو اليوم مُرّ غدٍ","إذا حصدت لهم في الحشر ما زرعوا",34,"ع",3,0],["ليشغفني لدن القوام رشيقة","يحجبه لدن القناة قويمها",35,"م",3,0],["لي شَرَفٌ ما يَكادُ يَترُكُني","عَبداً لِمَن لَيسَ يَعبُدُ اللَهَ",36,"ه",1,0],["لي شُؤُنٌ مكَتَّماتٌ خَوافي","عندَ حِبِّي طولَ الزَّمانِ وعِندي",37,"د",2,0],["لِيَ شُغْلٌ بِالحُبّ حَتَّى عَنِ الحُب","بِ فَماذَا عَسَى يَقولُ العَذُولُ",38,"ل",1,0],["لِي شُهودٌ مِنَ الوَفاءِ عُدولٌ","أَنَّنِي عن هَواكَ ما لِي عُدُولُ",38,"ل",1,0]]}