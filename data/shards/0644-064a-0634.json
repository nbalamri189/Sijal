//www.poetsgate.com/ViewPoem.aspx?id=177648",""],[5461,"يغار سمعي","https://www.poetsgate.com/ViewPoem.aspx?id=27706",""],[5463,"جيتي فجأة تتركيني","https://www.poetsgate.com/ViewPoem.aspx?id=35642",""],[5480,"ابكي وليفي ناحل العود","https://www.poetsgate.com/ViewPoem.aspx?id=5143",""],[5573,"ياسابح الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=200177",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""],[5606,"ياحسافه","https://www.poetsgate.com/ViewPoem.aspx?id=194367",""],[5606,"القلوب تطير لكن من دون أجنحه","https://www.poetsgate.com/ViewPoem.aspx?id=194769",""],[5616,"مهر شموس","https://www.poetsgate.com/ViewPoem.aspx?id=207462",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5720,"رفيق الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=208669",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5776,"فَصْلٌ..... لمْ يَقُلْهُ ال...بُكَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199340",""],[5809,"شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=205093",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5873,"أحلى الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=215305",""],[5956,"إذا لم يزُرْني","https://www.poetsgate.com/ViewPoem.aspx?id=182018",""],[5956,"أبي والغيد","https://www.poetsgate.com/ViewPoem.aspx?id=184883",""],[6052,"سلام الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=34888",""],[6056,"نايض البرق","https://www.poetsgate.com/ViewPoem.aspx?id=130383",""],[6100,"قلب المولع","https://www.poetsgate.com/ViewPoem.aspx?id=52594",""],[6102,"لحم ودم","https://www.poetsgate.com/ViewPoem.aspx?id=184863",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6160,"مَزَامِيرُ لِلْعِشْقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87086&r=&rc=3",""],[6160,"مَرايا لِعُروَة ابنِ الوَرد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87098&r=&rc=15",""]],"verses":[["لِيَشقى بِهِ عُرقوبُ كَوماءَ جَبلَةٍ","عَقيلَةِ أُدمٍ كَالهِضابِ بَهازِرِ",0,"ر",1,0],["ليَ شغلٌ يا صاح بالنظرِ المنص","ور عنهم بالمدمع السفّاح",1,"ح",1,0],["ليشكرنّك مني الدّهرَ أربعةٌ","نفسٌ وروحٌ ولحمٌ نابتٌ ودم",2,"م",1,0],["لِيَشكُرْ بَنُو الإسلام نعمةَ صاعدٍ","بل النَّاسُ طُرّاً قَوْلَةً لا تُفَنَّدُ",3,"د",1,0],["ليُشنِّفنَّهُمُ بمدحك صائغٌ","لا تكبر الآذان عن تشنيفه",4,"ف",2,0],["ليشكرا لك أنْ فخمْتَ شأنهما","عن غير مَيْلٍ إلى الإلحادِ حاشاكا",5,"ك",2,0],["ليشمّرِ الغادي إليك ذُيولَه","كيما يروحَ مُرفَّلاً ترفيلا",6,"ل",2,0],["لي شاغلٌ في حبهنْ","نَ عن التي تدعى بشاغلْ",7,"ل",1,0],["ليشهدَ مَنْ خَلْفَ الضَّبابِ فصولَها","ويَضْحَكُ منها مَنْ يمثِّلُ مَا ياتي",8,"ت",2,0],["ليشع النور منها ويرى","أهلها قدرته عند الثبات",9,"ت",1,0],["لَيَشوقُني سِحرُ العُيونِ المُجتَلى","وَيَروقُني وَردُ الخُدودِ الأَحمَرُ",10,"ر",1,0],["لِيَشغَلَ عَنّي بَعلَها بِزَمانَةٍ","تُدَلِّهُهُ عَنّي وَعَنها فَنُسعَفُ",11,"ف",1,0],["ليشهد أن الشعر شيء مشى بنا","مع الطبع جل الطبع أن يتكلفا",12,"ف",2,0],["لي شهوتانِ أحبُّ جمعَهُمَا","لو كانتِ الشهواتُ مضمونَهْ",13,"ه",1,1],["ليَ شعرٌ قدْ حكاني","بتجافٍ مستطيلُ",14,"ل",1,0],["لي شادِنٌ صادَ الأُسودَ بِمُقلَةٍ","أَلقى الكَمِيُّ لَها الذَوابِلَ مُعرِضا",15,"ض",2,0],["لِيَشغَلكَ ما أَصبَحتَ مُرتَقِباً لَهُ","عَنِ العَيبِ يُبدي وَالخَليلِ يُؤَنَّبُ",16,"ب",1,1],["لِيَشغَلَ بِذِكرِ اللَهِ عَن كُلِّ شاغِلٍ","فَذَلِكَ عِندَ اللُبِّ خَيرُ كَلامِ",17,"م",1,0],["لِيَشْكُرِ اللهُ عَنَّا المُحْسِنِينَ فَهُمْ","صَلاحُ مُجْتَمَعٍ قَدْ نَاهَزَ التَّلَفَا",18,"ف",2,0],["لِيَشْفِ مِبْضَعُكُمْ وَالرِّفْقُ يُعْمِلُهُ","صَدْعَ الرَّصَاصِ وَجُرْحَ الصَّارِمِ القَاسِي",19,"س",2,0],["ليشقى به عرقوب كوماءؤَ جبلة","ٍ عَقيلَة ِ أُدْمٍ، كالهِضابِ، بَهازِرِ",20,"ر",1,0],["ليشُُدَّ حاضرَك المضمَّخَ بالدِما","بالموَجعِ الأسيانِ من ماضيك",21,"ك",1,0],["لِيَشْمَخْ بفقدِكَ أنفُ البلاد","وأنفي وأنفُهم مُرغم",22,"م",1,0],["ليش شعري وللسياسة دين","يرسل النار حجّة والحساما",23,"م",2,0],["لي شَوق إِلَيك لَو رُحت أَبدي","هِ تَشكى الأَوام مني أَوامي",24,"م",2,0],["لِيَ شعر مَحَلَهُ في الثُريا","ضائع في زَمان أَهل الخُمول",25,"ل",1,0],["لي شوق إلى الملاح شديد","وغرام في كل يوم يزيد",26,"د",1,1],["لِيُشرِقوا النَصرَ مِن صُبحِ المُنى فَلَقا","وَكُلَّما شوهِدوا في جَمعِهِم فَرَقا",27,"ق",2,0],["لِيَشملني بِها فَوزٌ فَإِنّي","رَقيق لَيسَ يَرغَب في عِتاقِ",28,"ق",1,0],["لَيَشكُرَنَّكَ وَفدُ الجِنِّ إِذ أَمَرَت","مولِياتُ ثَناء ما لَها أَلَمُ",29,"م",1,0],["لي شَكوى مِنهُ وَأَنتَ عَلَيهِ","حاكِمٌ حُكمُهُ عَلى الحُكّامِ",30,"م",1,0],["لِيَ شَوق إِلَيكَ لا يَتناها","وَشُجون قَد جاوَزَت مُنتَهاها",31,"ا",3,1],["لِيشربَ منهُ جحوشٌ ويشمّهُ","بِعيني قطاميّ أغرّ شآمي",32,"م",2,0],["ليَ شوقٌ إِليك رقَّ إِلى أنْ","صارَ يُدعي صبابةً واعتلالا",33,"ل",2,0],["ليشرقنّ بحلو اليوم مُرّ غدٍ","إذا حصدت لهم في الحشر ما زرعوا",34,"ع",3,0],["ليشغفني لدن القوام رشيقة","يحجبه لدن القناة قويمها",35,"م",3,0],["لي شَرَفٌ ما يَكادُ يَترُكُني","عَبداً لِمَن لَيسَ يَعبُدُ اللَهَ",36,"ه",1,0],["لي شُؤُنٌ مكَتَّماتٌ خَوافي","عندَ حِبِّي طولَ الزَّمانِ وعِندي",37,"د",2,0],["لِيَ شُغْلٌ بِالحُبّ حَتَّى عَنِ الحُب","بِ فَماذَا عَسَى يَقولُ العَذُولُ",38,"ل",1,0],["لِي شُهودٌ مِنَ الوَفاءِ عُدولٌ","أَنَّنِي عن هَواكَ ما لِي عُدُولُ",38,"ل",1,0],["لي شِعرُ حَسّانَ في أبناءِ فاطِمَةٍ","وَليسَ في الرَّوعِ قَلبي قَلبُ حَسانَا",39,"ن",2,0],["لِيُشهدَهم ربُّ السماءِ جِهادَهُ","ويُعلِمَهم إقدامُه غيرَ مُحْجِمِ",40,"م",1,0],["ليش ما اِترك الشَيخَ واِعشق","عُذيّر اِخضَر وَطاري",41,"ي",1,0],["ليشتفي كبدي ضرباً بذي شطب","في الظالمين وطعناً بالقنا الذبل",42,"ل",1,0],["لِيَشكُركَ مَجدٌ لا تَزالُ تَحوطُهُ","وَتَحميهِ بِالنَصلَينِ عَزمٍ وَقاضِبِ",43,"ب",1,0],["لي شوق اليك لا يتناهى","وشجون قد جاوزت منتهاها",44,"ه",2,1],["لي شيمة تأبى علي شكايتي","غير الزمان ولو قطعن وتيني",45,"ن",2,0],["لي شهرٌ إن لم يكن شهرانِ","مُنذُ فارقتُ لذَّةَ الفِنجانِ",46,"ن",1,1],["لي شوق إلى المقال عظيم","عند ذكراه هان كل عظيم",47,"م",1,0],["ليش يا بُقَيري أنا","اسمعك تقول امبوه",48,"ب",3,1],["ليشكُر بنو العباس نعمى تجدّدت","فقد وعدَ اللَه المزيد على الشكر",49,"ر",1,1],["لي شكالي امبحي من عناه السبب","هوب سهل المسالك صعب دونه متام",50,"م",1,0],["ليشويه فيطفيه بدلو","كحوتِ دلالةِ العبد النجيّ",51,"ي",1,0],["ليشهد في جميع الأمر منه","وفيه فينطفي غيظاً حسودي",52,"د",2,0],["لي شاغل عن سكرتي ما قضت","حوايجي يا ليتها القاضيه",53,"ي",2,0],["لي شاهدان على صدقي مرادفها","وفضل معرفتي في العد للكلم",54,"م",1,0],["لِيَشنا حَياتي مَن أَرادَ فَإِنَّني","شَجاحَلقِهِ حَتّى يُوارِيهِ رامِسُه",55,"س",2,0],["ليشهدوا لنا به في موقف","يفي به الكريم في الوعود",56,"د",1,0],["ليَ شغلٌ عن ذكرِ لبني وهندٍ","وَنوار أو الرَّباب وَدَعْدِ",57,"د",1,1],["ليَ شعر يشقُّ صم الصخور","من قلوب أصبن بالتحجير",58,"ر",1,1],["لي شوق إليك أسهر جفنى","فسواءٌ مساؤُهُ والصباح",59,"ح",1,0],["لي شادنٌ هو أَدْنى","إليَّ مُذْ كَانَ مِنِّي",60,"ن",2,1],["ليش يقوى الفؤاد منك على","الصد ولا مقلتا طليح المآقي",61,"ق",2,0],["ليش الغنى يا اخا العرفان عن عرض","نعم غنى النفس بالموصوف بالقدم",62,"م",1,0],["ليشفع لي ذا عند ذاك شفاعةً","ترقى إلى خير العرى والوسائل",63,"ل",1,0],["ليشفع لي عند الخليفة سيدي","محمد التيار مأوى النوازل",63,"ل",1,0],["ليشفع لي مولى الشفاعة عندما","أبى الرسل من هول هنالك هائل",63,"ل",1,0],["لي شعر كالماء قلت أصاب ال","شيخ لكن لفظه براده",64,"د",2,0],["ليشوقني منها إِذا هي أَسفَرَت","خدّ بعقربِ صدغِها مَرصودُ",65,"د",1,0],["لي شِغَبْ قلبي ولا راحه","لين بَيّح بالهجر دلّي",66,"ل",2,0],["لِيَشرَبِها مَعي وَيَبيتَ عِندي","فَيَثبُتَ بَينَنا وُدُّ الخَليلِ",67,"ل",1,0],["ليشهدَ فيهِ حاسدٌ وَهوَ كارهٌ","الا إِنَّما الصِدِّيقُ هذه خواتمُه",68,"م",2,0],["لي شهود عز من يدركه","عاش منه القلب في ظل ظليل",69,"ل",1,0],["لي شَيخُنا رِوايَة وَنَقلا","عَنِ الشُيوخِ السابِقينَ فَضلا",70,"ل",2,0],["لي شاغِل بِالسَقمِ عَن اِرسالِ ما","تَبغى وَاِرسلها اِذا لَم أَشغل",71,"ل",1,0],["ليشفي ما بي من شجون لأنه","طبيب ولي منه العوائد عواد",72,"د",1,0],["لي شيمةٌ بالولا جاءَت موَّحدةً","وفاءُ وعدي وحفظ العهد من ديني",73,"ن",2,0],["لي شيمةٌ ين الأنام توحَّدت","مالي على حفظ الوداد نظيرُ",74,"ر",1,0],["لي شادِنٌ لاَ قَيَّضَ اللهُ الذي","أَبلَى بِهِ مِن أَسرهِ لِيَ مأخَذا",75,"ذ",2,0],["لي شوقٌ بادٍ وآخرُ خافٍ","خِيفةَ العذل في زوَايا جَناتي",76,"ي",1,0],["ليشهد الكون والتاريخ، منهجُنا","رسالةٌ للهدى صيغت معانيها",77,"ي",3,0],["ليشلن الجلبابي","شروا بيض الحمام",78,"م",1,0],["ليش تزعل وانت ما تعرف ظروفي","ليش ما تسمع كلامي للنهاية",79,"ا",3,1],["ليش ما جادت حروفك في ميادين الحميا","واقصرت فيك المعاني عن حمى الدين ونبيه",80,"ي",2,0],["ليشفى في مراعيها عليلٌ","ويركضُ راقصا فوقَ التلاعِ",81,"ع",1,0],["ليشكَّ قلبًا في سوادِ سوادِه","ويصيبَ ثأرًا من حنيفِ حنيفِ",82,"ف",1,0],["ليش قلبك غيّر اشفوفه","وانت ذوقك في الهوى راقي",83,"ق",2,0],["ليش التناقض ياالغلا مادام","حبل الصراحه بيننا ممدود",84,"د",1,0],["ليش بعدك ليش خوفك","دام قلبي في ايديك",85,"ك",1,0],["لي شرى م الشعب هم وما هذابه باللسان","يعمل بصمت وتفاني لين حل اوثاقها",86,"ق",3,0],["لي شاغل بمعانيه وفكري في","تخييل أغزال ذات الخال مشغول",87,"ل",1,0],["ليش هالطعنه تصحي في حشا قلبي ذهوله","ليش كذبك فيني أثر..والخيانه ألمتني",88,"ن",2,0],["لِيُشَرِّدُوا شَعْباً عَرِيْقاً آمِناً","وَيُشَتِّتُوْ هُ بِأًبْعَدِ الأوْطانِ",89,"ن",1,0],["لي شَهْقَةُ اللَّيْلِ في أرواحِ من عَشقوا","لي زَفْرَةُ الفَجْرِ في أنْفَاسِ أبكَاري",90,"ر",2,0],["ليُشغِلَ بعضَنا بالبعضِ عنه","فينفردَ الحمى من غيرِ حامِ",91,"م",1,0],["ليش نزلتي عيونك ارفعيها وطالعيني","والا يعني انحرجتي يوم جاوبتي سؤالي",92,"ل",2,1],["ليش قلتيلي احبك ليش كنتي تخدعيني","ليش قلتيلي حبيبي ليش قلتيلي ياغالي",92,"ل",2,0],["ليش انا بالذات يعني ليش قولي جاوبيني","بعد غدرك خبريني وقولي بس شلي بقالي",92,"ل",2,0],["ليش ماتصدق آننا نوفي العقائد بالعمل","بلغ خليفتكم وقل له إن من جانا نجيه",93,"ي",2,0],["ليشهدِ الدهرُ أنّا","مِنَ الوغى لا نفِرُّ",94,"ر",1,0],["لي شهقةُ الأمواتِ أعبُرها ولي","من سحنةِ الليلِ العليلِ الطلَّهْ",95,"ل",2,0],["ليش بين اوفي واجراحي تزيد","ليش بين أتعب من اخلاصي لهم",96,"م",1,1],["ليش مايرجع فؤادي من حديد","وليش انا مقدر اسوي مثلهم",96,"م",1,0],["ليش لا ضاقت يخلوني وحيد","بس لا ضاقوا اكون في قربهم",96,"م",1,0],["ليش بين اكتب همومي في قصيد","وما اعاتبهم اذا واجهتهم",96,"م",1,0],["ليش اوقات لقيانا صارت دائماً تقصر","وليش النوم ياخلي يجيك الحين من بدري",97,"ر",2,0],[