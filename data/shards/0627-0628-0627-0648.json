{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[55,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[65,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[95,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[29,"بان الخليط فما له من مطلب","https://www.aldiwan.net/poem5661.html","الكامل"],[29,"إن المهاجر حين يبسط كفه","https://www.aldiwan.net/poem5716.html","الكامل"],[29,"أمسى فؤادك ذا شجون مقصدا","https://www.aldiwan.net/poem5734.html","الكامل"],[87,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[47,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[47,"وشاعر نسبته","https://www.aldiwan.net/poem65599.html","مجزوء الرجز"],[47,"إن السماحة والتكرم والندى","https://www.aldiwan.net/poem65679.html","الكامل"],[47,"اللوم منك وإن نصحت غرام","https://www.aldiwan.net/poem66646.html","الكامل"],[63,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[21,"قومي إياد لو أنهم أمم","https://www.aldiwan.net/poem36154.html","المنسرح"],[21,"علم ابن جدعان بن عمرو","https://www.aldiwan.net/poem36215.html","مجزوء الكامل"],[52,"يا قلب ما لي أراك لا تقر","https://www.aldiwan.net/poem63821.html","المنسرح"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[87,"قم في فم الدنيا وحيي الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=471",""],[47,"أقامَ كُلُّ مُلِثِّ الوَدْقِ رَجّاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31148",""],[29,"بَانَ الخَليطُ فَمَا لَهُ مِنْ مَطْلَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16342&r=&rc=6",""],[113,"ما للحبيب المعرض المتلاهي","https://www.aldiwan.net/poem16237.html","الكامل"],[119,"لله في طي هذا الكون آيات","https://www.aldiwan.net/poem41202.html","عموديه"],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[173,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[173,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[199,"عما يا ابنتي قيس صباحا ومظلما","https://www.aldiwan.net/poem54406.html","الطويل"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[256,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[275,"أي الحمائم في الحمى لم تسجع","https://www.aldiwan.net/poem34987.html","الكامل"],[376,"يا عدل في لقب العداله","https://www.aldiwan.net/poem57204.html","مجزوء الكامل"],[438,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[438,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[445,"أصخ نحوي لدعوة مستقل","https://www.aldiwan.net/poem34755.html","الوافر"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[519,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[519,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[558,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[580,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138194",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138255",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126700","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126873","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126735","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66839","الكامل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145602","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109013","الكامل"],[1706,"","https://poetry.dctabudhabi.ae/diwan/poem/198798","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53121","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53054","البسيط"],[2247,"","https://poetry.dctabudhabi.ae/diwan/poem/97841","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93691","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93700","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93917","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203471","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74251","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132551","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132681","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67990","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48293","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109929","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132005","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91209","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91181","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95370","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111445","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117299","الوافر"],[4767,"أصل الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=214135",""],[4929,"ازرع ولو لم تحصد (حكمة)","https://www.poetsgate.com/ViewPoem.aspx?id=208717",""],[4929,"الحياة مع الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=208722",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5582,"دَعِينِي وَيْكِ عاذِلَتِي دَعِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=187306",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5864,"عادتكَ ياوطنَ الكِرامِ لئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190486",""],[5956,"أولادي والحمد لله وعقبال أولاد الجميع وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=192025",""],[6106,"سيدنا الإمام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=6315",""],[5724,"مآتم الظلم تتلوهن أعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55142&r=&rc=9",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""]],"verses":[["آباؤُكَ الغُرُّ الَّذينَ إِذا اِنتَمَوا","ذَهَبوا بِكُلِّ تَطاوُلٍ وَتَطَوُّلِ",0,"ل",1,0],["آباؤُكَ الغُرُّ الَّذين تَفَجَّرَت","بِهِمِ يَنابيعٌ مِنَ النَعماءِ",1,"ا",2,0],["آباؤُها الغُرُّ مِن ذُرا مُضَرٍ","في شَرَفٍ زانَهُ مُحمَّدُها",2,"د",3,0],["آبَاؤُنَا كَانُواوَإِنَّا","أَشْرَفُ الأُمَمِ انْتِسَابَا",3,"ب",2,0],["آباؤك الأنصار تلك شعارهم","فلِحَيِّهمْ آوى النَّبِيُّ المرسلُ",4,"ل",1,0],["آباؤُكَ المُتَخَيَّرونَ أُلو النُهى","رَفَعوا بِناءَكَ في اليَفاعِ المَرقَبِ",5,"ب",1,0],["آباؤُكَ المُتَخَيَّرونَ أُلو اللُهى","وَرِيَت زِنادُهُمُ بِكَفَّي ماجِدِ",6,"د",1,0],["آباؤُكَ المُتَخَيَّرونَ أُلو النُهى","يا اِبنَ الخَضارِمِ يُترِعونَ المِرفَدا",7,"د",2,0],["آباؤُكُم قَرَأوا عَلَيهِ وَرَتَّلوا","بِالأَمسِ تاريخَ الرِجالِ مُزَوَّرا",8,"ر",2,0],["آباؤُكَ الصيدُ تَحميهِم وَتَجمَعُهُم","مَنازِلُ العِزِّ مِن غَيلٍ وَأَخياسِ",9,"س",1,0],["آباؤُهُ مِن كَسبِهِ","وَخُفُّهُ مِن عَمَلِهِ",10,"ل",2,0],["آباؤُهُ صيدُ المُلوكِ مَتى اِنتَمى","فَإِلى المُلوكِ ذَوي المَكارِمِ يَنتَمي",11,"م",2,0],["آباؤُهُ ساسوا الخِلافَةَ بِالحِجى","إِذ لَم يَسُسها مِثلَهُم أَقوامُ",12,"م",1,0],["آباؤُكَ الأشرافُ إلا أنهم","أشرافُ موشَ وشاطحٍ وخِلاطِ",13,"ط",1,0],["آَباؤُنا دَمَّنوا تُهامةَ في الدَهرِ","وَسالت بِجَيشِهِم إِضَمُ",14,"م",1,0],["آباؤُك الشُمُّ المَراجيحُ","المَسامِحُ الأَخاير",15,"ر",1,0],["آباؤُكَ الصيدُ مِن قُرَيشٍ إِذا","زَعزَعَ رَيطَ المَنِيَّةِ الذُعُرُ",16,"ر",1,0],["آباؤُكَ الصيدُ الحُماةُ الغِيرُ","فَاِقدَح بِمَن شِئتَ بِهِ ثَبيرُ",17,"ر",1,0],["إباؤُك والإدعان شرٌّ كلاهما","على أن بعض الشر أهون من بعض",18,"ض",1,0],["آبَاؤُكُمْ أَثْبَتَوا لِلْخَلْقِ أَنَّهُمْ","أَبْلَوا بَلاءَ الأَعِزَّاءِ الصَّنَادِيدِ",19,"د",1,0],["آباؤُنَا قَادَةُ الدهُورِ","قَدْ أَنْطَقُوا صَامِتَ الصخُورِ",20,"ر",1,0],["آباؤُكُم قَرَؤوا عَلَيهِ وَرَتَّلوا","بِالأَمسِ تأريخَ الرِجالِ مُزَوَّرا",21,"ر",2,0],["آباؤكَ الصيد تحميهِمْ، وَتجمَعُهُمْ","مَنَازِلُ العِزّ هِنْ غيُلٍّ وَأخْيَاسِ",22,"س",1,0],["آبَاؤكَ المُتَخَيَّرُونَ أُولُو النُّهَى ،","رَفَعُوا بناءَكَ في اليَفاعِ المَرْقَبِ",23,"ب",1,0],["آباؤُهُ أَحيت رُبوع عَدالة","وَمَحَت رُسوم كَبائر وَمَلاهي",24,"ي",1,0],["آباؤهم من طغام القوم اهل خنا","والامهات خسيسات دنيات",25,"ت",1,0],["آباؤُهُ الغُرُّ طالوا الناسَ كُلَّهُمُ","وَأَصبَحَ المَجدُ مِنهُم مُحصَدَ الطِوَلِ",26,"ل",1,0],["إِباؤُكَ لِلمَجدِ أَن يُبتَذَل","أَصارَ لَكَ الناسَ طُرّاً خَوَل",27,"ل",1,1],["آباؤُكَ الغُرُّ الكِرامُ إِذا اِنتَمَوا","آباؤُهُ وَجُدُودُهُ إِذ تُنسَبُ",28,"ب",1,0],["آباؤُهُ مِن عَبدِ قَيسٍ خَيرُها","حَسَباً وَأَكرَمُهم وَأوسعُها ندى",29,"د",2,0],["آباؤُنا خَيرُ آباءٍ إِذا ذُكِرُوا","كانُوا المَشاوِذَ وَالناسُ التَساخِينا",30,"ن",2,0],["آباؤُهُ مِن قُرَيشٍ خَيرُها حَسَباً","وَعِزُّ حاضِرِها فِيهم وَباديها",31,"ي",3,0],["آباؤهُ نصروهُ في كتائبهم","وَهوَ النصيرُ بكتبٍ حبّبته بهِ",32,"ب",2,0],["إِباؤُهُمُ أَن يَكُروا الفَضلَ إِنَّنا","صَبَحنا الرِماحَ مِن أَبي جابِرٍ دَما",33,"م",2,0],["آباؤُهُم لا يرحمونَهُمُ ولَم","يجدوا بصَدرِ الأمّهاتِ حنانا",34,"ن",2,0],["آباؤهم صوب الملاجيء أبعدوا","سعياً لنيل الخبز والأرزاق",35,"ق",1,0],["آباؤه صعدوا إلى أعلى الذرَى","فليصعدنَّ إلى المحلِّ الأرفع",36,"ع",1,0],["آباؤك الماضونَ وال","باقونَ كُثرٌ لا مَحالَه",37,"ل",2,0],["آباؤهُمْ شَتَّى فضائِلُهُمْ","وهو المُلَقَّب جامِعَ الشملِ",38,"ل",1,0],["آباؤه أملاكُ ساسان الألى","والعُرْبُ عند نوالِه أبناؤه",39,"ا",3,0],["أباً وبَنِينَ عن عِرْضٍ منيعٍ","لقد أجْلَيْنَ عن أمَلٍ قَتيلِ",40,"ل",1,0],["آباؤكم هم حماة الدين من قدم","به استعزوا ونالوا منه تفضيلا",41,"ل",2,0],["آباؤهُ الغُرُّ الكِرامُ وجدّهُ","خيرُ الأنام أبو شُبيرَ وشَيْبرِ",42,"ر",1,0],["آباؤهُ حُجَجُ الإله وحَجّهُ","فرضٌ على ذي حاجةٍ يتحوّجُ",43,"ج",1,0],["آباؤُهُ أَنجادٌ","أَبناؤُهُ أَمجادُ",44,"د",1,0],["آباؤه الغُرُّ لما كان مُنتَقِلاً","فيهم رأَوْا عزَّةَ الدُّنيا بِعَّزتِه",45,"ت",2,0],["آباؤها نصعت صحائف ذكرهم","وتسنموا في العزّ كل علاء",46,"ا",2,0],["آباؤك الغر الميامين اعتلوا","بعزائم كصوارم لم تغمد",47,"د",1,0],["آباؤهُ الغرّ أعلام الهدى ولهم","مِن فضلهم قد سَمَت فوق السما رتبُ",48,"ب",1,0],["آباؤهُ الغرّ الميامين الألى","بهم تشرّف زمزم وحطيمُ",49,"م",1,0],["آباؤهُ عُرِفوا بحُسنِ فعالهم","مِن سيّد سامي الذرى ومسودِ",50,"د",1,0],["آباؤه أهلُ الريا","سةِ والخِلافةِ والوصيّهْ",51,"ي",2,0],["آباؤنا والأمهات له الفدا","ما أكرم المرجو منه وأغبطا",52,"ط",2,0],["آباؤهم خير الورى آباؤهم","وجدودهم خير الأنام جدودا",53,"د",2,0],["آباؤُه حمت الشريعةَ في ضُباً","لم يعد حاسمُ رأيه أوصافَها",54,"ف",3,0],["اباً وخالاً وعماَّ","أمولايَ رفقا فالدموع سوافحُ",55,"ح",1,0],["آباؤُهم من قبلهم فتكوا","بالمرتضى وبآله الأُمَنا",56,"ن",2,0],["أباؤك الكابرون الله ألبسهم","مجدا وأعظمهم في الخلق إعظاما",57,"م",2,0],["آباؤك الغرُّ الأولى أخبارهم","معربة عنهم بصدق المُخْبِر",58,"ر",1,0],["آباؤك النُّجُبُ الغرّ الذين بهم","في يوم كل فخار صفوة العربِ",59,"ب",1,0],["أَبا وهبٍ جَزاكَ اللّه خَيراً","نَحرناها وَأَطعمنا الثريدا",60,"د",2,0],["آباؤك الصيد الغطارف معشر","كانوا إِذا عدَّ المُلوك كِرامها",61,"م",3,0],["آباؤه العرب الجحا جحة الأولى","وَسمت لِأَول مَورد آبالها",62,"ل",3,0],["آباؤك العرب الجحاجحة الأُلَى","بِسيوفهم