{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[93,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[94,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[91,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[87,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[47,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[99,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[71,"قد سمعنا من شيخ جبرين جزءا","https://www.aldiwan.net/poem29039.html","الخفيف"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[107,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62226","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[101,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[154,"يا نسيم الريح يهفو سحرا","https://www.aldiwan.net/poem68474.html","الرمل"],[246,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[254,"إن الفؤاد بآل كبشة مدنف","https://www.aldiwan.net/poem2103.html","الكامل"],[276,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[280,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[287,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[376,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[415,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[438,"أبليت بعدك في الأنام ظنوني","https://www.aldiwan.net/poem12427.html","الكامل"],[443,"ما إن سمعت ولا رأيت ولن أرى","https://www.aldiwan.net/poem2522.html","الكامل"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[463,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[466,"لرواة شعري من مدائحه","https://www.aldiwan.net/poem16122.html","أحذ الكامل"],[466,"تحوي القلوب له مكاسر لطفه","https://www.aldiwan.net/poem16147.html","الكامل"],[469,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[469,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[556,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[563,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[563,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138950",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66735","السريع"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96981","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86943","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67013","الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123699","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100137","المتدارك"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62468","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203793",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1230,"","https://poetry.dctabudhabi.ae/diwan/poem/123608","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56601","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79842","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48983","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127944","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137464",""],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146322","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100484","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100497","الكامل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147352","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87404","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88923","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89328","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52993","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216526","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85172","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89987","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131221",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95324","الكامل"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130558","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102962","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105534","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4690,"آثارُ الزُّهور","https://www.poetsgate.com/ViewPoem.aspx?id=120286",""],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[585,"هل في العراق من الرفاق مواس","https://www.poetsgate.com/ViewPoem.aspx?id=161918",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5145,"مقل الظباء إذا رمين قواصد","https://www.poetsgate.com/ViewPoem.aspx?id=108154",""],[5431,"كلنا العراق ...","https://www.poetsgate.com/ViewPoem.aspx?id=207691",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5943,"جيلُ كَسْرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=11260",""],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""],[5956,"الرئيس الأبيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=214093",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[6280,"طَرَقَتْكَ زَائِرَة ً فَحَيِّ خَيَالَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27902&r=&rc=57",""],[6320,"عَوْدَةُ الجَوَاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84341&r=&rc=38",""]],"verses":[["هَوجاءُ ما اِلتَفَتَت يَوماً عَلى أَلَمٍ","مِنَ السِياطِ وَلا حَنَّت إِلى قَرَمِ",0,"م",1,0],["هَوجَاءُ كالفَحلِ هَوجَلٌ سُرُحٌ","تَنشَقُّ عَنها الهواجِرُ الذُّؤُبُ",1,"ب",1,0],["هوجاء كالفحل هوجل سرح","ينشق عنها الهواجر الذؤب",2,"ب",1,0],["هو جَوْهرٌ والناسُ أعراضٌ وهم","يتبدّلون وليس فه تبدُّلُ",3,"ل",1,0],["هُوَ جَنَّةُ الخُلدِ الَّتي مَنّى بِها","رُسُلُ الهُدى قِدَماً بَني الإِنسانِ",4,"ن",1,0],["هوَ جدولُ الحُبِّ الَّذي","قَدْ كانَ في قلبي الخَضِلْ",5,"ل",1,0],["هُوَ جدولٌ قَدْ فجَّرت","ينبوعَهُ في مهجَتي",5,"ي",1,0],["هو جالس يبدي لسلمى عزمَه","وأمامه سلمى الحزينة تضرع",6,"ع",1,0],["هوجُ الرِياحِ خَواشِعٌ في بابِهِ","وَالطَيرُ فيهِ نَواكِسُ المِنقارِ",7,"ر",1,0],["هوجٌ إِذا اِتَّصَلَت بِأَسبابِ السُرى","قَطَعَ التَنائِفَ سَيرُها المَرفوعُ",8,"ع",1,0],["هوجاءُ آونةً خرساءُ آونةً","وليس تخدعُ ظنّي وَهيَ خرساء",9,"ا",2,0],["هو جزءٌ نرجو به فوزَ كلٍّ","نتلقّاهُ صافياً منْ صافِ",10,"ف",1,0],["هو جَمرةُ الحربِ العَوانِ يخوضُها","للنّصرِ كلُّ مُقَذَّفٍ يَتَقَحَّمُ",11,"م",1,0],["هُوَ جُنَّةٌ لك من سُيو","فِ الضّاربينَ طُلَى الكُماةِ",12,"ه",1,0],["هَوْجَاءُ تَجْتابُ أَوْسَاطَ الجَهَادِ بِإِرْ","قَالٍ قَذَافٍ إِذَا دِيكُ القُرَى هَتَفَا",13,"ف",2,0],["هو جُبُّ أعِيشُ فيه حزيناً","كاسِفَ النَّفسِ دائمَ الْبَلْبَالِ",14,"ل",1,0],["هو جاءُ تذرو الدَّوْحِ عند هبُوبها","وتُخَلَّف البُرجَ الأشمَّ كئيبا",15,"ب",2,0],["هو جدول الأحزان في أعماقنا","تنمو كروم حوله .. وغلال",16,"ل",1,0],["هو جمع لفراق أبداً","زُمَراً يدني لينئي زمرا",17,"ر",2,0],["هو جسر تمشى القلوبُ عليه","لتلاقي بينَ القلوبِ قَرارا",18,"ر",2,0],["هَوجاءُ ناجِيَةٌ كَأَنَّ جَديلَها","في جيدِ خاضِبَةٍ إِذا ما أَوجَفوا",19,"ف",3,0],["هُوَ جاوز السبع السَموات العلى","وَالعرش فيما صح من اسناد",20,"د",1,0],["هَوْجَاءُ تَسْتَشْرِي فَيُلْقِحُ مَدُّها","هَيْجَاءَ تُنْتِجُ حَبْرَةً وأَمانا",21,"ن",2,0],["هَوجاءُ مِرقالُ النَجاءِ شِمِلَّةٌ","تَطِسُ الأَكامَ بِوَخدِها في البَسبَسِ",22,"س",1,0],["هو جفنٌ شاقه النوم","فطالت رعشاته",23,"ه",1,0],["هُوجٌ إذا غنَّى الحُداةُ خلفَها","تكادُ من أنساعِها أن تَنْسَلِب",24,"ب",1,0],["هو جَدّى المَوسومُ بالغَدْرِ في الحُبْ","بِ متى ما اتَّهمْتُه بالوفاء",25,"ا",2,0],["هوجاءُ يَحسَبُها استعي","رَت من أبي الجيشِ الأميرِ",26,"ر",1,0],["هُوَ جمرةٌ أفنى الزّمانُ لهيبَها","فتضاءَلت وطباعُها الإحراقُ",27,"ق",1,0],["هَوجاءَ تَدَّرِعُ الرُبا وَتَشُقُّها","شَقَّ الشَموسِ إِذا تُراعُ جِلالَها",28,"ل",3,0],["هَوْجَاءُ تُقْسِمُ والرياحُ تقودُها","بالنُّونِ أَنَّا من طعامِ النّونِ",29,"ن",1,0],["هو جاهل واهي العزيمة أحمق","صعب العريكة ضيّق الأخلاق",30,"ق",1,0],["هوجاء لا من ورَهٍ","صفراء لا من عِلَّهْ",31,"ل",2,0],["هو جوهرٌ ما كلُّ غائصةٍ له","بالفكر تَعلمُ ما مكانُ الدُّرَّةِ",32,"ه",1,0],["هوْجاءَ تَثْني الغُدْرَ ناضِبَةً","يَبَساً ولا عَلٌّ ولا نَهَلُ",33,"ل",1,0],["هوْجاءُ عاصفةُ الهُبوب مُحارباً","وإذا احْتبى يومَ السَّلامِ فيذْبُل",34,"ل",1,0],["هو جَّنةٌ عذريُّ وج","دي والسقامُ بها مخلّد",35,"د",1,0],["هو جنةً ومتى يفوز بجنَّةٍ","من قبَّح الإحسانَ من أعماله",36,"ل",2,0],["هُوَ جِدُّ جرّه مَعْ","قَدَرِ اللَّهِ المزاحُ",37,"ح",1,0],["هو جَرحٌ للدين ما فيه أمر","ظاهر للعيان غير الأسامي",38,"م",2,0],["هو جمع وإن تفرق قومي","فأنا لا أقول بالتفريق",39,"ق",1,0],["هو جامع للحسن إلا أنه","قصر عليه تحية وسلام",40,"م",1,0],["هو جارُه في مسجدٍ طاهرٍ","ولم يكن من عَرصة الدارِ",41,"ر",1,0],["هو جعفر بن محمد","والصادق القول المشير",42,"ر",1,0],["هُوَ جَعفر ماضي العَزيمة صادق","أَنواره في الحكم لا تَتَلاشى",43,"ش",2,0],["هو جَنَّةُ الدّنْيَا تَبَوَّأَ نُزْلَها","مَلِكٌ تَمَلَّكَهُ التُّقَى والدِّيْنُ",44,"ن",1,0],["هو جوهر في الفضل فرد والسوى","أن قوبات فيه غدت أعراضا",45,"ض",2,0],["هو جعفرها هو مفخرها","هو أكبرها قدراً خطرا",46,"ر",2,0],["هو جحفل فرد ولا","يَثني لقاه الجحفلُ",47,"ل",1,0],["هوجُ الأعاصير الغضا","ب تضجّ عارمةَ الحقود",48,"د",1,0],["هَوْجاءَ تَمْسِي لَقَحا أَوْ عاقِرا","كَأَنَّها وَالأَيْنُ يُنْدِي الذافِرا",49,"ر",2,0],["هوجاء جاهلة إذا نطقت","ليست كعاباً بضة الخدر",50,"ر",1,0],["هو جحفل أو محفل","فيه المنازل والمناظر",51,"ر",1,0],["هو جمعٌ أُريد بالذكر منهُ","واحدٌ وهو أنتَ عند البيان",52,"ن",1,0],["هو جعفر الفضلِ الذي أهلُ النهى","يَرِدون منه ويصدرونَ رُواءا",53,"ا",3,0],["هو جثمانُ والدٍ جرَّه الحز","نُ إلى ذا اللقا بعدَ السُّهاد",54,"د",1,0],["هو جنة للمؤمنين ورحمة","قد عم كل موحد رضوانه",55,"ن",2,0],["هو جاحد للرب يدعو غيره","شركا وتعطيلا له قدمان",56,"ن",1,0],["هُو جاهُكَ الأصلي وَأولَ المَوسِمِ","يَعتَدِلاَ في الشرقِ بالتَّحَكمِ",57,"م",1,0],["هو جبار ولكن أهله","أودعوه السجن من غير قيود",58,"د",1,0],["هو جَنَّةٌ للناظرين إِذا مشى","أَمّا إِذا ما جاش فهو سعير",59,"ر",1,0],["هو جنةٌ ولدانها وشرابها","ندماؤه والقهوة السوداء",60,"ا",2,0],["هو جعفر لا بل هو البحر الذي","كم فاض بحر من نداه وجعفر",61,"ر",1,0],["هُوَ جُرْحُ أَسْئِلَةٍ وَفَيْضُ نَدَاوَةٍ","وَتِلاوَةٍ مِنْ سوْرَةِ الأَنْهَارِ",62,"ر",1,0],["هُوَ جنَّةٌ وَمَلاكُها حبي الَّذي","هوَ للمحاسن وَالجمال إِلهُ",63,"ا",3,0],["هُوَ جنَّةٌ حُفَّت بهم","لَم يَنجُ منهم غيرُ كاتم",64,"م",1,0],["هو جنة الفردوس فيها ما اشتهت","نفس الشريف مشرّف الآمال",65,"ل",1,0],["هو جوهر فردٌ بِجيد علائه","عقد بترتيب النظام وسيم",66,"م",1,0],["هو جسمُ مصر وفردُ جوهر رُوحِها","فاعجبْ لفردٍ وهو جمعُ حواسها",67,"س",3,0