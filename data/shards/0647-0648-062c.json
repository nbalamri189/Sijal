{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[91,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[45,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[97,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[69,"قد سمعنا من شيخ جبرين جزءا","https://www.aldiwan.net/poem29039.html","الخفيف"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[99,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[151,"يا نسيم الريح يهفو سحرا","https://www.aldiwan.net/poem68474.html","الرمل"],[242,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[250,"إن الفؤاد بآل كبشة مدنف","https://www.aldiwan.net/poem2103.html","الكامل"],[272,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[276,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[283,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[329,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[365,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[365,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[372,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[410,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[411,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[433,"أبليت بعدك في الأنام ظنوني","https://www.aldiwan.net/poem12427.html","الكامل"],[438,"ما إن سمعت ولا رأيت ولن أرى","https://www.aldiwan.net/poem2522.html","الكامل"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[462,"لرواة شعري من مدائحه","https://www.aldiwan.net/poem16122.html","أحذ الكامل"],[462,"تحوي القلوب له مكاسر لطفه","https://www.aldiwan.net/poem16147.html","الكامل"],[465,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[465,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[552,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[559,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[559,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"]],"verses":[["هَوجاءُ ما اِلتَفَتَت يَوماً عَلى أَلَمٍ","مِنَ السِياطِ وَلا حَنَّت إِلى قَرَمِ",0,"م",1,0],["هَوجَاءُ كالفَحلِ هَوجَلٌ سُرُحٌ","تَنشَقُّ عَنها الهواجِرُ الذُّؤُبُ",1,"ب",1,0],["هوجاء كالفحل هوجل سرح","ينشق عنها الهواجر الذؤب",2,"ب",1,0],["هو جَوْهرٌ والناسُ أعراضٌ وهم","يتبدّلون وليس فه تبدُّلُ",3,"ل",1,0],["هُوَ جَنَّةُ الخُلدِ الَّتي مَنّى بِها","رُسُلُ الهُدى قِدَماً بَني الإِنسانِ",4,"ن",1,0],["هوَ جدولُ الحُبِّ الَّذي","قَدْ كانَ في قلبي الخَضِلْ",5,"ل",1,0],["هُوَ جدولٌ قَدْ فجَّرت","ينبوعَهُ في مهجَتي",5,"ي",1,0],["هو جالس يبدي لسلمى عزمَه","وأمامه سلمى الحزينة تضرع",6,"ع",1,0],["هوجُ الرِياحِ خَواشِعٌ في بابِهِ","وَالطَيرُ فيهِ نَواكِسُ المِنقارِ",7,"ر",1,0],["هوجٌ إِذا اِتَّصَلَت بِأَسبابِ السُرى","قَطَعَ التَنائِفَ سَيرُها المَرفوعُ",8,"ع",1,0],["هوجاءُ آونةً خرساءُ آونةً","وليس تخدعُ ظنّي وَهيَ خرساء",9,"ا",2,0],["هو جزءٌ نرجو به فوزَ كلٍّ","نتلقّاهُ صافياً منْ صافِ",10,"ف",1,0],["هو جَمرةُ الحربِ العَوانِ يخوضُها","للنّصرِ كلُّ مُقَذَّفٍ يَتَقَحَّمُ",11,"م",1,0],["هُوَ جُنَّةٌ لك من سُيو","فِ الضّاربينَ طُلَى الكُماةِ",12,"ه",1,0],["هو جُبُّ أعِيشُ فيه حزيناً","كاسِفَ النَّفسِ دائمَ الْبَلْبَالِ",13,"ل",1,0],["هو جاءُ تذرو الدَّوْحِ عند هبُوبها","وتُخَلَّف البُرجَ الأشمَّ كئيبا",14,"ب",2,0],["هو جدول الأحزان في أعماقنا","تنمو كروم حوله .. وغلال",15,"ل",1,0],["هو جمع لفراق أبداً","زُمَراً يدني لينئي زمرا",16,"ر",2,0],["هو جسر تمشى القلوبُ عليه","لتلاقي بينَ القلوبِ قَرارا",17,"ر",2,0],["هَوجاءُ ناجِيَةٌ كَأَنَّ جَديلَها","في جيدِ خاضِبَةٍ إِذا ما أَوجَفوا",18,"ف",3,0],["هُوَ جاوز السبع السَموات العلى","وَالعرش فيما صح من اسناد",19,"د",1,0],["هَوْجَاءُ تَسْتَشْرِي فَيُلْقِحُ مَدُّها","هَيْجَاءَ تُنْتِجُ حَبْرَةً وأَمانا",20,"ن",2,0],["هَوجاءُ مِرقالُ النَجاءِ شِمِلَّةٌ","تَطِسُ الأَكامَ بِوَخدِها في البَسبَسِ",21,"س",1,0],["هو جفنٌ شاقه النوم","فطالت رعشاته",22,"ه",1,0],["هُوجٌ إذا غنَّى الحُداةُ خلفَها","تكادُ من أنساعِها أن تَنْسَلِب",23,"ب",1,0],["هو جَدّى المَوسومُ بالغَدْرِ في الحُبْ","بِ متى ما اتَّهمْتُه بالوفاء",24,"ا",2,0],["هوجاءُ يَحسَبُها استعي","رَت من أبي الجيشِ الأميرِ",25,"ر",1,0],["هُوَ جمرةٌ أفنى الزّمانُ لهيبَها","فتضاءَلت وطباعُها الإحراقُ",26,"ق",1,0],["هَوجاءَ تَدَّرِعُ الرُبا وَتَشُقُّها","شَقَّ الشَموسِ إِذا تُراعُ جِلالَها",27,"ل",3,0],["هَوْجَاءُ تُقْسِمُ والرياحُ تقودُها","بالنُّونِ أَنَّا من طعامِ النّونِ",28,"ن",1,0],["هو جاهل واهي العزيمة أحمق","صعب العريكة ضيّق الأخلاق",29,"ق",1,0],["هوجاء لا من ورَهٍ","صفراء لا من عِلَّهْ",30,"ل",2,0],["هو جوهرٌ ما كلُّ غائصةٍ له","بالفكر تَعلمُ ما مكانُ الدُّرَّةِ",31,"ه",1,0],["هوْجاءَ تَثْني الغُدْرَ ناضِبَةً","يَبَساً ولا عَلٌّ ولا نَهَلُ",32,"ل",1,0],["هوْجاءُ عاصفةُ الهُبوب مُحارباً","وإذا احْتبى يومَ السَّلامِ فيذْبُل",33,"ل",1,0],["هو جَّنةٌ عذريُّ وج","دي والسقامُ بها مخلّد",34,"د",1,0],["هو جنةً ومتى يفوز بجنَّةٍ","من قبَّح الإحسانَ من أعماله",35,"ل",2,0],["هُوَ جِدُّ جرّه مَعْ","قَدَرِ اللَّهِ المزاحُ",36,"ح",1,0],["هو جَرحٌ للدين ما فيه أمر","ظاهر للعيان غير الأسامي",37,"م",2,0],["هو جمع وإن تفرق قومي","فأنا لا أقول بالتفريق",38,"ق",1,0]]}