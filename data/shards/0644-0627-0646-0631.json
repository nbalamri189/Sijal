{"poems":[[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[66,"للعلم أهل وللإيمان ترتيب","https://www.aldiwan.net/poem67665.html","البسيط"],[80,"من عزا المجد إلينا قد صدق","https://www.aldiwan.net/poem14196.html","الرمل"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85569","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[66,"جواب في حقيقة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=3095",""],[189,"بيت كصدري ورزقي","https://www.aldiwan.net/poem14604.html","المجتث"],[208,"أعاذل حسب المرء بالشيب عاذلا","https://www.aldiwan.net/poem53155.html","الطويل"],[208,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[412,"ولى ولم يقض من أحبابه وطرا","https://www.aldiwan.net/poem50171.html","البسيط"],[457,"للفيجة الغناء عين لم تزل","https://www.aldiwan.net/poem13741.html","الكامل"],[487,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[563,"من به قد تكاثرت أمراضي","https://www.aldiwan.net/poem34413.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66803","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48810","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138088",""],[1194,"","https://poetry.dctabudhabi.ae/diwan/poem/206179","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56579","الخفيف"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145154","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93138","الرمل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67397","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69365","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88685","الطويل"],[2486,"","https://poetry.dctabudhabi.ae/diwan/poem/122167","المنسرح"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87789","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100894","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205783","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205433","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204976","السريع"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147356","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108029","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108358",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136007","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135102","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66118","البسيط"],[4888,"زمان مكفهر","https://www.poetsgate.com/ViewPoem.aspx?id=207771",""],[3591,"قد هام حافظ في القطرين وانتسبا","https://www.poetsgate.com/ViewPoem.aspx?id=149505",""],[5376,"جاد بسْمُ العرْبِ يسري في فمي","https://www.poetsgate.com/ViewPoem.aspx?id=188477",""],[5431,"بوابة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=190084",""],[5436,"مهابة التأريخ(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34913",""],[5596,"لا نرتضي الشمس والبدر الذي كمُلا","https://www.poetsgate.com/ViewPoem.aspx?id=205600",""],[5674,"لست مغرورة","https://www.poetsgate.com/ViewPoem.aspx?id=190971",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5790,"لا نرى أحسن منكم منظرا","https://www.poetsgate.com/ViewPoem.aspx?id=112051",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[5956,"سبقوا هتلر في نشر الإرهاب","https://www.poetsgate.com/ViewPoem.aspx?id=194646",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6259,"وليَّ ولم يقض من أحبابه وطرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59376&r=&rc=24",""]],"verses":[["لا نَرتَضي العَيشَ يَجري","في ذِلَّةٍ وَهَوانِ",0,"ن",1,0],["لِأَنَّ روحي قَديماً فيه قَد عَطِشَت","وَالجِسمُ ما مَسَّهُ مِن قَبلُ تَركيبُ",1,"ب",1,0],["لا نُرَع لِلدَمع في آماقِنا","مَزَجته بِدَمٍ أَيدي الحُرَقْ",2,"ق",1,0],["لانَرهَبُ الأَيامَ بَل مِن بَأسِنا","يُخشى الرَدى وَحَوادِثُ الأَزمانِ",3,"ن",1,0],["لا نَرهَبُ القَتلَ إِنَّ القَتلَ مَكرُمَةٌ","وَلا نَضِنُّ عَلى راحٍ بِأَصفادِ",4,"د",1,0],["لا نَرى إلا أَنجماً زاهرات","لو نظرنا إلى سماء الماضي",5,"ض",2,0],["لا نَرى فيك غيرَ عهدٍ مَجيدٍ","قَرَنتْهُ العُلاَ بعهدٍ مَجيدِ",6,"د",1,0],["لأن روحي قديماً فيه قدْ عطشتْ","والجسم [ما] ماسَهُ من قبل تركيب",7,"ب",1,0],["لأنّ روحيَ لم تَلْ","قَ فُسْحةً للتَّرَقِّي",8,"ق",2,0],["لأنَّ رياحَ الشوق هبّت شمائلاً","فغادَرنَ أغصانَ الحياة ذَوابِلا",9,"ل",2,0],["لأن ركائب عهد الوفا","على طلل العهد مستعطَفَه",10,"ف",2,0],["لأَنَّ راحَتَهُ بَحرٌ فَلَيسَ لَها","رَدٌّ ومن ذا يَرُدُّ البَحر إِن زَجَرا",11,"ر",2,0],["لا نرعوي فيها لقول مفند","ولنا على دفع الملامة شاهد",12,"د",1,0],["لأن رسول الله أعظم نائب","عن الله وهو الباب والله أصعد",13,"د",1,0],["لا نرى غيرها وما الغير إلا","عينها بالجسوم والأعراض",14,"ض",1,0],["لأن رسول الله أوصى بحقِّهِ","وأشركه في كلّ فيءِ ومَغنَمِ",15,"م",1,0],["لا نرى في السلام والحربِ إلا","ما يراه المسخَّرُ المحروم",16,"م",1,0],["لا نرى في الردى غريبا ولا نس","مع شيئا عن مقبلات الأمور",17,"ر",1,0],["لا نرى خائفاً فيلزمنا الخو","ف ولا صادقاً كما قد نقول",18,"ل",1,0],["لا نرى في الشتاء إلا صقيعاً","لا نرى في الربيع إلا ترابا",19,"ب",2,0],["لا نرتضي إمامنا في الصف","ما لم يكن أمامنا في الصف",20,"ف",1,1],["لا نرى إِلا القبول","بيزيدٍ واليمين",21,"ن",1,0],["لاَ نَرَى غَيْرِ أذْرُعِ وَأكْفٍّ","ورُؤُسِ بِهَامِهَا أفْلاَقِ",22,"ق",1,0],["لا نَرتَضي غَيرَهُ مَولىً نُعَزُّ بِهِ","وَلا يُغَيِّرُنا عَن حُبِّهِ الأَبَدُ",23,"د",1,0],["لان راج منك السوق يوم ربيعة","فسوقك من سوق الشيوخ كساد",24,"د",1,0],["لا نرفَعُ العبدَ فوقَ سُنَّتِهِ","ما دام مِنَّا ببطنِها شرَفُ",25,"ف",1,0],["لا نَرتَضي عَيش الهَوان","فَإِنَّ أَنفُسنا تعافه",26,"ف",2,0],["لأَنَّ راسَ مَرطَبانَ مُنحرف","دونَ السِّيامِ كلُّه يا مُعترِف",27,"ف",1,0],["لا نَرى ريشاً أو مخلبا","أو جناحاً أو ذنابَى أو قدامى",28,"م",2,0],["لا نراه إلا تراوح ظل","وسرى نسمة ولمح شهاب",29,"ب",1,0],["لا نرى العيش غير كأس وزهر","حَسُنا منظرا وطابا شماما",30,"م",2,0],["لا نرى فيه من أنيس سوى","الصبر وحسن الأنيس بالآرام",31,"م",1,0],["لأن روحي روح كل الورى","كأنني جدهمو آدم",32,"م",1,0],["لاَ نَرْدَ فِي أَسَفِي حَتَّى أُدَحْرِجُهُ","يَبِيسَةٌ عَجَلاتُ الحَرْثِ بِالكَدَرِ",33,"ر",1,0],["لا نرتجي طيب عيش بعدكم فلقد","مضت به معكم أيامنا الأول",34,"ل",1,0],["لا نرهبن لوم العواذل عندما","نزهو ببطرسنا الرسول ونعجب",35,"ب",1,0],["لأنَّ ربّنا له الخزائنُ","والرزق منها وينال الكائنُ",36,"ن",1,0],["لا نرتضي إلا محاكمة القنا","حيث الأمور منوطة بجدال",37,"ل",1,0],["لا نرى إلاّ رجالاً صدقوا","عهدهم لله جنداً مخلصين",38,"ن",1,0],["لا نرتجي وصلها بالوصل ان وعدت","فغيمها خلب بالدث والمطل",39,"ل",1,0],["لا نَرْتَضَي العَيْشَ إلاَّ في الذُّرا أَبَداً","وَلَوْ صَلِينا بنارِ الجَوْرِ والنِّقَمِ",40,"م",1,0],["لا نرى في موطنٍ مثلَ الذي","عندنا من سفكِ أحلامٍ وشرْ",41,"ر",1,0],["لا نرتحل أيها الثاوي بأربعها","عنها فتشعل من شوقٍ لها لهبا",42,"ب",2,0],["لا نريد القبر يبقى عندنا","لا مكانا للعدِّو الأغشمِ",43,"م",1,0],["لأن رياض الشعر فاحت عبيرها","وعمّ الشذا منها جميع الجوانب",44,"ب",1,0],["لا نرتدي أثوابنا بمعرة","فمهابة التاريخ منا تخجل",45,"ل",1,0],["لا نرتضي الشمس والبدر الذي كمُلا","عن قربكم بدلاً مهما علت وعلا",46,"ل",2,1],["لا نرجسيةٓ عندي .. لستُ مغرورةْ","بنتُ الفراتِ .. لهُ قد بِتُّ مٓنذورةْ",47,"ر",2,1],["لانرتضي بدلا في الدين أونسب","ما ازدانت القبة الخضراء بالشهب",48,"ب",1,0],["لا نرى أحسن منكم منظرا","لا ولا أجمل من دون الورى",49,"ر",2,1],["لانرتجي خيراً يسوقه غربكمْ","أو أنْ يكون لشرقنا فيكم ظهيرْ !",50,"ر",1,0],["لا نرتضي أبداً بأي خطيئة","مهما يك المخطي ونحن شهودُ",51,"د",1,0],["لا نرى إلا حصاراً ودماراً","وانتشار الذعر فينا والنّوبْ",52,"ب",1,0],["لا نرى إلا كياداً وافتراءاً","وأحابيلَ وتحريفَ كُتُبْ",52,"ب",1,0],["لا نرى منه ولا من","نسله إلا المذلةْ",53,"ل",2,0],["لأن ربوعها بارت","تساوى الجمع والطرحُ",54,"ح",1,0],["لأنَّ راحتهُ بحرٌ فليس لها","ردٌّ ومن ذا يردُّ البحر إن زخرا",55,"ر",2,0]]}