{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[91,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[38,"قبيلة من قيس كبة ساقها","https://www.aldiwan.net/poem7723.html","الطويل"],[85,"كزبك بطير الجمال اعترت أيكاته","https://www.aldiwan.net/poem7902.html","البسيط"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[80,"هبوا فقد رحل الدجى ظلمه","https://www.aldiwan.net/poem31305.html","المنسرح"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[46,"قد كان قبلك ذادة ومقاول","https://www.aldiwan.net/poem22413.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[91,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=53397",""],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[116,"حبيب ما لطلعته مثال","https://www.aldiwan.net/poem41181.html","عموديه"],[126,"انظر إلى الهلال إذ لاح","https://www.aldiwan.net/poem4086.html","مجزوء الرجز"],[186,"أيا سيدا نال أعلى الرتب","https://www.aldiwan.net/poem14086.html","المتقارب"],[186,"لله أيامي بقليوب","https://www.aldiwan.net/poem14094.html","السريع"],[186,"أروض جاءني لك أم كتاب","https://www.aldiwan.net/poem14123.html","الوافر"],[196,"أتعرف بالصحراء شرقي شابك","https://www.aldiwan.net/poem54400.html","الطويل"],[200,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[238,"ألا إن السيادات","https://www.aldiwan.net/poem18093.html","الهزج"],[238,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[271,"تعالي فأحييني بفنجان قهوة","https://www.aldiwan.net/poem35265.html","الطويل"],[271,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[430,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[433,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[433,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[459,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[480,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[562,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"]],"verses":[["كَزَئيرِ اللَيثِ يَنفي صَوتُهُ","عَن خَفاً فيهِ ثُؤاجاً وَيُعارا",0,"ر",2,0],["كَزمِ اليَدَينِ عَنِ العَطِيَّةِ مُمسِكٍ","لَيسَت تَبِضُّ صَفاتُهُ بِبِلالِ",1,"ل",1,0],["كَزُهورِ الرَبيعِ عَرفاً زَكِيّاً","وَنُجومِ الرَبيعِ نوراً سَنِيّا",2,"ي",2,0],["كَزائِدَةٍ ما بِالأَصابِعِ حاجَةٌ","إِلَيها وَلا يَخفى عَلى الناسِ عارُها",3,"ر",3,0],["كزبك بطير الجمال اعترت أيكاته","فِدا بناته إذا ما مسن باناته",4,"ه",1,1],["كَزَفرَةٍ في سَماءِ اللَيلِ حائِرَةٍ","مِمّا نُرَدِّدُ فيهِ حينَ يُضوينا",5,"ن",2,0],["كزَاحفٍ أقبلتْ كتائبُهُ","هازِمةً في اتباع مُنْهزِمه",6,"م",2,0],["\"كزرقاء اليمامة\" حين جلىّ","مصائرَ قومها بصرٌ حديد",7,"د",1,0],["كَزَفرة الأَشواق","غِبَّ الفِراق",8,"ق",1,0],["كَزِيادٍ الأُمَويِّ أَو كَزِيادٍ المَ","رِّيِّ إِذ وَلّى فَأَينَ زِيادُ",9,"د",1,0],["كزورقٍ يعبر بحر الوجود","له شراعان ولحظٌ شَرُود",10,"د",1,0],["كزنبَقةٍ في زُهَى حُلَّةٍ","ربيعيةِ الوشْي محمرَّةِ",11,"ه",1,0],["كزهرة الحقل في غيناء سرحتها","لم يملأ النور من أجفانها حدقا",12,"ق",2,0],["كَزُجَاجَةِ التَّصْوِيرِ شَفَّتْ فَاجْتَلَتْ","مِنْ وَصْفِهِ ما كانَ غَيْرَ قَرِيبِ",13,"ب",1,0],["كَزَاهِرِ الْوَرْدِ وَجْهاً","وَنَاضرِ الرَّنْدِ قَدَّا",14,"د",2,0],["كزهور الربيع عرفا زكيّا","ونجوم الربيه نورا سنيا",15,"ي",2,0],["كزغب القطا لو أنّه راح صاديا","سكبت له عيني وقلبي ليشربا",16,"ب",2,0],["كزنجي اتي روضا صباحا","تعجب شاخصا ببديع زهر",17,"ر",1,0],["كزَورقٍ مِن فضّةٍ","وسطَ لُجَينٍ أَخضَرِ",18,"ر",1,0],["كزُرْقِ الأَسَّنِة بين الدروعِ","تَميل بهنّ العوالى السُّلُب",19,"ب",1,0],["كزَعْفرانِ لاحَ في لاذةٍ","حمراءَ في راحةِ مخضوب",20,"ب",1,0],["كزَهْرِ الروضِ باكرَه نسيمٌ","يُفتِّح منه ما سَقَتِ السَّحاب",21,"ب",1,0],["كَزوجِ الجُموعِ ناشَطَتهُ فَزادَهُ الشْ","شِقاقُ عَلَيها بُعدَةً وَتَغَضُّبا",22,"ب",2,0],["كزمانِ الصبا وونومي إذا نم","تُ وطيفِ الحبيبِ ليلةَ زارا",23,"ر",2,0],["كَزَيْنِ الدهْرِ شَيْخِ العَصْ","رِ عَيْنِ الْمَصْرِ مِرْآةِ",24,"ه",1,0],["كَزِيَادَةِ الإِيغَالِ فِي نَفْعِ الْوَرَى","بِزِيَادَةِ الإِفْضَالِ وَالإِحْسَانِ",25,"ن",1,0],["كزنجيَّةٍ بعد العبوسِ تبسَّمَت","وغَنَّت وقد حنَّت بوحشيِّ لهجة",26,"ه",1,0],["كزهراءَ لاحت من ثَنايا غمامةٍ","فقرَّت بها في الليلِ عينُ المنجِّم",27,"م",1,0],["كزبور داودٍ تردد ذكره","بين الورى يحلو به الترنيم",28,"م",1,0],["كزهرِ الروضِ قد جُرَّتْ عليه","ذُيول غلائلِ الريحِ البَليلِ",29,"ل",1,0],["كزورقٍ من ذهبٍ","أكرمْ به من زورقِ",30,"ق",1,0],["كزعيم الدين لم تعرِفْ سواه","سبُلُ الخير ولم يعرف سواها",31,"ا",3,0],["كزنبور بلا شهد","وخمر لم تجد جاما",32,"م",2,0],["كَزٍّ وَلا مُزَلَّمٍ كَوَألَلِ","وَصّالِ إِخوانِ النَدى مُوَصَّلِ",33,"ل",1,0]]}