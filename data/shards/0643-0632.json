{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[91,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[38,"قبيلة من قيس كبة ساقها","https://www.aldiwan.net/poem7723.html","الطويل"],[85,"كزبك بطير الجمال اعترت أيكاته","https://www.aldiwan.net/poem7902.html","البسيط"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[80,"هبوا فقد رحل الدجى ظلمه","https://www.aldiwan.net/poem31305.html","المنسرح"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[46,"قد كان قبلك ذادة ومقاول","https://www.aldiwan.net/poem22413.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[91,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=53397",""]],"verses":[["كَزَئيرِ اللَيثِ يَنفي صَوتُهُ","عَن خَفاً فيهِ ثُؤاجاً وَيُعارا",0,"ر",2,0],["كَزمِ اليَدَينِ عَنِ العَطِيَّةِ مُمسِكٍ","لَيسَت تَبِضُّ صَفاتُهُ بِبِلالِ",1,"ل",1,0],["كَزُهورِ الرَبيعِ عَرفاً زَكِيّاً","وَنُجومِ الرَبيعِ نوراً سَنِيّا",2,"ي",2,0],["كَزائِدَةٍ ما بِالأَصابِعِ حاجَةٌ","إِلَيها وَلا يَخفى عَلى الناسِ عارُها",3,"ر",3,0],["كزبك بطير الجمال اعترت أيكاته","فِدا بناته إذا ما مسن باناته",4,"ه",1,1],["كَزَفرَةٍ في سَماءِ اللَيلِ حائِرَةٍ","مِمّا نُرَدِّدُ فيهِ حينَ يُضوينا",5,"ن",2,0],["كزَاحفٍ أقبلتْ كتائبُهُ","هازِمةً في اتباع مُنْهزِمه",6,"م",2,0],["\"كزرقاء اليمامة\" حين جلىّ","مصائرَ قومها بصرٌ حديد",7,"د",1,0],["كَزَفرة الأَشواق","غِبَّ الفِراق",8,"ق",1,0],["كَزِيادٍ الأُمَويِّ أَو كَزِيادٍ المَ","رِّيِّ إِذ وَلّى فَأَينَ زِيادُ",9,"د",1,0],["كزورقٍ يعبر بحر الوجود","له شراعان ولحظٌ شَرُود",10,"د",1,0],["كزنبَقةٍ في زُهَى حُلَّةٍ","ربيعيةِ الوشْي محمرَّةِ",11,"ه",1,0],["كزهرة الحقل في غيناء سرحتها","لم يملأ النور من أجفانها حدقا",12,"ق",2,0],["كَزُجَاجَةِ التَّصْوِيرِ شَفَّتْ فَاجْتَلَتْ","مِنْ وَصْفِهِ ما كانَ غَيْرَ قَرِيبِ",13,"ب",1,0],["كَزَاهِرِ الْوَرْدِ وَجْهاً","وَنَاضرِ الرَّنْدِ قَدَّا",14,"د",2,0],["كزهور الربيع عرفا زكيّا","ونجوم الربيه نورا سنيا",15,"ي",2,0]]}