{"poems":[[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[31,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[93,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[40,"قبيلة من قيس كبة ساقها","https://www.aldiwan.net/poem7723.html","الطويل"],[87,"كزبك بطير الجمال اعترت أيكاته","https://www.aldiwan.net/poem7902.html","البسيط"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[82,"هبوا فقد رحل الدجى ظلمه","https://www.aldiwan.net/poem31305.html","المنسرح"],[92,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[104,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[48,"قد كان قبلك ذادة ومقاول","https://www.aldiwan.net/poem22413.html","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[93,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=53397",""],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[119,"حبيب ما لطلعته مثال","https://www.aldiwan.net/poem41181.html","عموديه"],[129,"انظر إلى الهلال إذ لاح","https://www.aldiwan.net/poem4086.html","مجزوء الرجز"],[189,"أيا سيدا نال أعلى الرتب","https://www.aldiwan.net/poem14086.html","المتقارب"],[189,"لله أيامي بقليوب","https://www.aldiwan.net/poem14094.html","السريع"],[189,"أروض جاءني لك أم كتاب","https://www.aldiwan.net/poem14123.html","الوافر"],[199,"أتعرف بالصحراء شرقي شابك","https://www.aldiwan.net/poem54400.html","الطويل"],[203,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[242,"ألا إن السيادات","https://www.aldiwan.net/poem18093.html","الهزج"],[242,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[275,"تعالي فأحييني بفنجان قهوة","https://www.aldiwan.net/poem35265.html","الطويل"],[275,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[435,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[438,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[438,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[463,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[484,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59352","الطويل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117103","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141286","الوافر"],[1733,"","https://poetry.dctabudhabi.ae/diwan/poem/216315","السريع"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53085","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27679","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46745","البسيط"],[2719,"","https://poetry.dctabudhabi.ae/diwan/poem/144539","الطويل"],[2738,"","https://poetry.dctabudhabi.ae/diwan/poem/142669","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83235","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74218","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133955","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65132","الرمل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46917","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138711",""],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36736","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131066",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77021","السريع"],[4057,"","https://poetry.dctabudhabi.ae/diwan/poem/32970","الطويل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22084","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72828","الطويل"],[4717,"وصيتي لبلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199833",""],[4717,"وصيتي لبلادي","https://www.poetsgate.com/ViewPoem.aspx?id=206833",""],[5074,"خَرِيْفُ العُمر","https://www.poetsgate.com/ViewPoem.aspx?id=155797",""],[5273,"السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=180369",""],[5277,"زبيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=187662",""],[5353,"التعويذة","https://www.poetsgate.com/ViewPoem.aspx?id=214644",""],[5376,"أناختْ على هجرِ المطايا نجائبي........يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=188567",""],[5401,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=78116",""],[5431,"وكأني بروحه الموسيقا","https://www.poetsgate.com/ViewPoem.aspx?id=197665",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[5490,"عقد الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176377",""],[5510,"نواس الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215371",""],[5512,"ملائكة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=204346",""],[5956,"إشعاع العرب","https://www.poetsgate.com/ViewPoem.aspx?id=185592",""],[5977,"إشراقة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=212732",""],[6093,"الهاربة إلى المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202107",""],[6093,"على قدر اهتمامك سوف تزهر","https://www.poetsgate.com/ViewPoem.aspx?id=213345",""],[2220,"وجودي وجودُ العارفينَ لأنهمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11582&r=&rc=456",""]],"verses":[["كَزَئيرِ اللَيثِ يَنفي صَوتُهُ","عَن خَفاً فيهِ ثُؤاجاً وَيُعارا",0,"ر",2,0],["كَزمِ اليَدَينِ عَنِ العَطِيَّةِ مُمسِكٍ","لَيسَت تَبِضُّ صَفاتُهُ بِبِلالِ",1,"ل",1,0],["كَزُهورِ الرَبيعِ عَرفاً زَكِيّاً","وَنُجومِ الرَبيعِ نوراً سَنِيّا",2,"ي",2,0],["كَزائِدَةٍ ما بِالأَصابِعِ حاجَةٌ","إِلَيها وَلا يَخفى عَلى الناسِ عارُها",3,"ر",3,0],["كزبك بطير الجمال اعترت أيكاته","فِدا بناته إذا ما مسن باناته",4,"ه",1,1],["كَزَفرَةٍ في سَماءِ اللَيلِ حائِرَةٍ","مِمّا نُرَدِّدُ فيهِ حينَ يُضوينا",5,"ن",2,0],["كزَاحفٍ أقبلتْ كتائبُهُ","هازِمةً في اتباع مُنْهزِمه",6,"م",2,0],["\"كزرقاء اليمامة\" حين جلىّ","مصائرَ قومها بصرٌ حديد",7,"د",1,0],["كَزَفرة الأَشواق","غِبَّ الفِراق",8,"ق",1,0],["كَزِيادٍ الأُمَويِّ أَو كَزِيادٍ المَ","رِّيِّ إِذ وَلّى فَأَينَ زِيادُ",9,"د",1,0],["كزورقٍ يعبر بحر الوجود","له شراعان ولحظٌ شَرُود",10,"د",1,0],["كزنبَقةٍ في زُهَى حُلَّةٍ","ربيعيةِ الوشْي محمرَّةِ",11,"ه",1,0],["كزهرة الحقل في غيناء سرحتها","لم يملأ النور من أجفانها حدقا",12,"ق",2,0],["كَزُجَاجَةِ التَّصْوِيرِ شَفَّتْ فَاجْتَلَتْ","مِنْ وَصْفِهِ ما كانَ غَيْرَ قَرِيبِ",13,"ب",1,0],["كَزَاهِرِ الْوَرْدِ وَجْهاً","وَنَاضرِ الرَّنْدِ قَدَّا",14,"د",2,0],["كزهور الربيع عرفا زكيّا","ونجوم الربيه نورا سنيا",15,"ي",2,0],["كزغب القطا لو أنّه راح صاديا","سكبت له عيني وقلبي ليشربا",16,"ب",2,0],["كزنجي اتي روضا صباحا","تعجب شاخصا ببديع زهر",17,"ر",1,0],["كزَورقٍ مِن فضّةٍ","وسطَ لُجَينٍ أَخضَرِ",18,"ر",1,0],["كزُرْقِ الأَسَّنِة بين الدروعِ","تَميل بهنّ العوالى السُّلُب",19,"ب",1,0],["كزَعْفرانِ لاحَ في لاذةٍ","حمراءَ في راحةِ مخضوب",20,"ب",1,0],["كزَهْرِ الروضِ باكرَه نسيمٌ","يُفتِّح منه ما سَقَتِ السَّحاب",21,"ب",1,0],["كَزوجِ الجُموعِ ناشَطَتهُ فَزادَهُ الشْ","شِقاقُ عَلَيها بُعدَةً وَتَغَضُّبا",22,"ب",2,0],["كزمانِ الصبا وونومي إذا نم","تُ وطيفِ الحبيبِ ليلةَ زارا",23,"ر",2,0],["كَزَيْنِ الدهْرِ شَيْخِ العَصْ","رِ عَيْنِ الْمَصْرِ مِرْآةِ",24,"ه",1,0],["كَزِيَادَةِ الإِيغَالِ فِي نَفْعِ الْوَرَى","بِزِيَادَةِ الإِفْضَالِ وَالإِحْسَانِ",25,"ن",1,0],["كزنجيَّةٍ بعد العبوسِ تبسَّمَت","وغَنَّت وقد حنَّت بوحشيِّ لهجة",26,"ه",1,0],["كزهراءَ لاحت من ثَنايا غمامةٍ","فقرَّت بها في الليلِ عينُ المنجِّم",27,"م",1,0],["كزبور داودٍ تردد ذكره","بين الورى يحلو به الترنيم",28,"م",1,0],["كزهرِ الروضِ قد جُرَّتْ عليه","ذُيول غلائلِ الريحِ البَليلِ",29,"ل",1,0],["كزورقٍ من ذهبٍ","أكرمْ به من زورقِ",30,"ق",1,0],["كزعيم الدين لم تعرِفْ سواه","سبُلُ الخير ولم يعرف سواها",31,"ا",3,0],["كزنبور بلا شهد","وخمر لم تجد جاما",32,"م",2,0],["كَزٍّ وَلا مُزَلَّمٍ كَوَألَلِ","وَصّالِ إِخوانِ النَدى مُوَصَّلِ",33,"ل",1,0],["كزار قد أقيم له احتفال","حوى من نسوة القوم المئات",34,"ت",1,0],["كَزَنْجِيَّةٍ وَشَّتْ بِجَزْعٍ وَشَمَّرَتْ","عن الساقِ ذَيْلا وَاكتستْ حُلَّةَ الشَّعْرِ",35,"ر",1,0],["كزبور داود وفرقان وان","جيل وفي صحف الخليل وموسى",36,"س",2,0],["كزهرة مشرفة","على غدير صيف",37,"ف",1,0],["كزيتٍ معدنيٍّ ليس يطفى","بماءِ وهوَ يطفأ بالتراب",38,"ب",1,0],["كزغاليل القطا طهراً وكال","بلبل الشّادي سؤالاً وجوابا",39,"ب",2,0],["كزهرةِ الدنيا وقد أقبلت","تَرُود في رَوْنَقها النضْرِ",40,"ر",1,0],["كزهرتينِ على غصنِ زَهَا بهما","وكم زَهتْ بتُؤامِ الزهرِ أغصانُ",41,"ن",1,0],["كزمان الربيع بل هي أبهى","منظراً للبقاء والتخليد",42,"د",1,0],["كزيتونة قامت على ساقِ موجودي","فما هي في غربٍ ولا رأتِ الشرقا",43,"ق",2,0],["كَزُّ النَدى مَجدُه دَينٌ يؤخِّرُهُ","وَلؤمُه حاضِرٌ لابُدَّ مَنقودُ",44,"د",1,0],["كزعمك أن الدرع لِبْسُكَ في الوغى","وذاك لجبنٍ فيك غيرِ مُزايلِ",45,"ل",1,0],["كزليخا وقد بدت كفها تط","لب أذيال يوسفٍ بالباب",46,"ب",1,0],["كَزَهرٍ أَضَرَّت بِهِ راحَةٌ","فَإِمّا إِلى الصَدرِ أَو أَطرُقِ",47,"ق",1,0],["كَزَهر رِياض في حِياض تَرَقرَقَت","كَنَفحة عَصر مِن نَوافح مجمر",48,"ر",1,0],["كزارني بدري على جنح الظلام","والأنس قد غرّد ناظم السلام",49,"م",1,0],["كزمان قد تجمّل","بمليك راحم",50,"م",1,0],["كَزَعْزَعِ الرّيحِ صَك الدَّوْحَ عَاصِفُها","فَلَمْ يَدَعْ مِنْ جَنىً فِيهِ وَلا غُصُنِ",51,"ن",1,0],["كَزُرهُ خَالِداً وَقًبِّلهُ اليَدَا","وَاعرِفهُ حَقَّهُ وَخُذ نَبلا مُدَى",52,"د",2,0],["كزينب في الطفوف وبعد أسرٍ","بكوفان وفي أرض الشئام",53,"م",1,0],["كَزَهرِ الرُبا قَد فَتَّحَتهُ يَدُ الصَبا","وَجَرَّت عَلَيهِ ذَيلَها في تَبَسُّمِ",54,"م",1,0],["كزهرةٍ شكلها يروق ولو","شممتها ما أراك تحمدها",55,"د",3,0],["كَزَهرَةِ خَشخَاشٍ بيانِعِ رَوضَةٍ","يُثَقِّلُها طَلُّ الرَّبِيعِ فَتَنثَنِي",56,"ي",1,0],["كَزارِعَينِ بِحَقلٍ بَعدُ ما قُسِما","تَنازَعا كُلَّ شِبرٍ في حُدودِهُما",57,"م",2,0],["كَزَورَة القادِمِ لا سِيَّما","مِن ذي اِخاء أَو وَلاءِ وَجب",58,"ب",1,0],["كَزَيدٍ وَمِرداسٍ وَعَمرٍو وَكَهمَسٍ","وَكَاِبنِ عَقيلٍ في الكَتيبَةِ عامِرِ",59,"ر",1,1],["كَزَمانِنا وَزَمانِهِ فيما مَضى","إِذ نَحنُ في ظِلِّ الشَبابِ المُخضِلِ",60,"ل",1,0],["كزهرِ ربيعٍ في البديعِ مدبّج","بألوانَ شتى بالبيانِ منقّح",61,"ح",1,0],["كزهد العُمْيِ في ضوْءِ الصباحِ","كزهد الأمِّ في طفلِ السفاحِ",62,"ح",1,1],["كزهد مُهَيَّئٍ للموتِ شنقًا","يُمنَّى غيرَ إطلاقِ السراحِ",62,"ح",1,0],["كزهدِ الكافرينَ بكلِّ نصٍ","يحرِّم كلَّ جُرمٍ مُستباحِ",62,"ح",1,0],["كزهدِ الحاكمِين إذا اسْتبدُّوا","بشأنٍ كاقتراعٍ واقتراحِ",62,"ح",1,0],["كزهدِ الحاكمِ العربيِّ دومًا","بشأنٍ كاقتراعٍ واقتراحِ",63,"ح",1,0],["كَزَوْرَقٍ تَاهَ والأَمْوَاجُ تَدْفَعُهُ","عَبْرَ المَجَاهِيْلِ حَيْثُ المُنْتَهَى الخَطِرُ",64,"ر",1,0],["كَزَوَارِقٍ في بَحْرِ عُمْرٍ صَارِخٍ","فيها المَجَاديفُ الضّعافُ حَيَارى",65,"ر",2,0],["كزبيدةٍ تختال أجنحةً","بجمالها الياقوتُ والتبرُ",66,"ر",1,0],["كزُغب ِ العصافيرِ لمّا بدا","عليها من الرّيش ِ ما نَضَّرا",67,"ر",2,0],["كزنزانة ٍفي الأسرِ يقبعُ حولها","قرودٌ خنازيرٌ بطبعِ الثعالبِ",68,"ب",1,0],["كزها العرقوب واقفت به وروّووح","مقصده ديرة أهيلك يابنيه",69,"ي",2,0],["كزهورٍ على الهضاب حلاها","حالماتٍ وتتقن التزويقا",70,"ق",2,0],["كزَرادشْتَ قد أعود ظلوما","أقتلُ الربّ في لهاث التجنّي!",71,"ن",2,0],["كزهرة الشمس أضحى القلبُ متجهاً","يرنو إلى نوره الأبهى بإجلالِ",72,"ل",1,0],["كزليخة_ الأضلاعُ_كيف تركتها","للريح_ طُعمًا_تستبيح وتعصف",73,"ف",1,0],["كزهرٍ في ربيعِ العمرِ كونوا","كوردٍ لا تجفِّفُهُ الفصولُ",74,"ل",1,0],["كزوابعٍ حملتْ غباراً ساحراً","ألوانُهُ الصفراءُ تَضْرَى كاللَّهبْ",75,"ب",1,0],["كزهر الروض حين يجود مسكاً","فينعشني ويطربني شذاه",76,"ا",2,0],[