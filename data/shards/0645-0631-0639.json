{"poems":[[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[87,"عصفورتان في الحجاز","https://www.aldiwan.net/poem7997.html","مجزوء الرجز"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[54,"مر عيش علي قد كان لذا","https://www.aldiwan.net/poem27057.html","الخفيف"],[50,"وأنمر الجلدة صيرته","https://www.aldiwan.net/poem64451.html","السريع"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21027","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[20,"مر على الكثيب الى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502510",""],[119,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[130,"خبّريني واسمعي مني اليقين","https://www.aldiwan.net/poem797.html",""],[136,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[170,"يا شمس والشمس لها حاجب","https://www.aldiwan.net/poem46831.html","السريع"],[197,"يا دهر ما أقساك يا دهر","https://www.aldiwan.net/poem13039.html","أحذ الكامل"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[242,"مر عبيدك كل أمرك ممتثل","https://www.aldiwan.net/poem19061.html","عموديه"],[303,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[308,"مر على حبي نسيم الصبا","https://www.aldiwan.net/poem57896.html","السريع"],[309,"يا نديمي فؤادي مرتهن","https://www.aldiwan.net/poem16783.html","الطويل"],[408,"قاتلي في هواه من غير ذنب","https://www.aldiwan.net/poem46712.html","الخفيف"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[543,"مر عام وأنتض يا صاح صاح","https://www.aldiwan.net/poem48247.html","عموديه"],[556,"مر علينا فكنفنا به","https://www.aldiwan.net/poem47779.html","السريع"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53765","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126751","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53938","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77572","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77638","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145859","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35386","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133785","الرجز"],[1136,"","https://poetry.dctabudhabi.ae/diwan/poem/131386","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50026","المتدارك"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101024","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93789","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100254","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201460","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200816","الخفيف"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137983",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68131","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112319","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131997","الكامل"],[4465,"","https://poetry.dctabudhabi.ae/diwan/poem/146405","السريع"],[4755,"قد وَهَبناكَ فَوقَ ما تَستَطِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184812",""],[4832,"جود المسعى فكل قد وعى","https://www.poetsgate.com/ViewPoem.aspx?id=166705",""],[4859,"مرّ عام","https://www.poetsgate.com/ViewPoem.aspx?id=192354",""],[4984,"نَشِيدُ النَّصْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197045",""],[4984,"مر عهد","https://www.poetsgate.com/ViewPoem.aspx?id=215823",""],[5107,"نداء من المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=32889",""],[5190,"انشطار","https://www.poetsgate.com/ViewPoem.aspx?id=160934",""],[5219,"حرف ذو شجون","https://www.poetsgate.com/ViewPoem.aspx?id=194086",""],[5463,"ودّي أحضن[ سلوى ] للمرّة الأخيره","https://www.poetsgate.com/ViewPoem.aspx?id=34690",""],[5464,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=772",""],[5542,"حوار في ساحة المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=10068",""],[5561,"اليوم الأخير من عام ..","https://www.poetsgate.com/ViewPoem.aspx?id=193063",""],[5628,"لحن الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=178524",""],[5644,"كم حلمنا","https://www.poetsgate.com/ViewPoem.aspx?id=198642",""],[5691,"بوم وغربان","https://www.poetsgate.com/ViewPoem.aspx?id=205929",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""]],"verses":[["مَرَّ عَلى ذَلِكَ التُرابِ مِن ال","مُزنِ خَفوقُ الأَعلامِ وَالعَذَبِ",0,"ب",1,0],["مَرَّ عَلَيهِ غَدِقُ السَحابِ","بِواكِفٍ مُتَّصِلِ الرَبابِ",1,"ب",1,0],["مَرَّ عَلى أَيكِهِما","ريحٌ سَرى مِنَ اليَمَن",2,"ن",1,0],["مر عامان والغزاة مقيمون","وتاريخ أمتي... أشلاء",3,"ا",2,0],["مر عامان.. والمسيح أسيرٌ","في يديهم.. ومريم العذراء",3,"ا",2,0],["مر عامان.. والمآذن تبكي","والنواقيس كلها خرساء",3,"ا",2,0],["مُرعِياتٍ لِأَخلَجِ الشِدقِ سِلعا","مٍ مُمَرٍّ مَفتولَةٍ عَضُدُه",4,"د",2,0],["مَرَّ عَيشٌ عَلَيَّ قَد كانَ لَذّا","وَدَهَتني الأَيّامُ فيها وَحَذّا",5,"ذ",2,1],["مَرَّ عَلى الكَرخِ وَقَد أَوسَعَت","يَدُ الهِجاءِ الوَجهَ أَلياقا",6,"ق",2,0],["مَرَّ عَلَينا زَمَنٌ مُصعَبٌ","بَعدَ زَمانٍ لَيسَ بِالمُصعَبِ",7,"ب",1,0],["مُرعَدٌ أَحشاؤُهُ في هَيكَلٍ","حَسَنٌ لِمَّته وافي الشَّعَر",8,"ر",1,0],["مَرَّ عَلَى حرّ الكَثيبِ إلَى","لِينَةَ فاغتالَ الطِرائقَ يُسُر",9,"ر",1,1],["مَرْعَى جِيَادِي ومَأْوَى جِيرَتِي وَحِمَى","قَوْمِي وَمَنْبِتُ آدَابِي وَأَعْرَاقِي",10,"ق",2,0],["مَرَّ عيدي فَما سَفَحتُ دَماً إِل","لا مِنَ العَينِ وَالمَعيشَةِ ضَنكُ",11,"ك",1,0],["مَرَّ عَلَى الكَثيبِ إلَى","لِينَةَ فاغتالَ الطِرائقَ يُسُر",12,"ر",1,1],["مر عيشي لما صددت وبالحس","ن طراز الجميل قد حلاكا",13,"ك",2,0],["مر عامان وما أقساهما","لم ترَ عيناني ذيّاك الجبين",14,"ن",1,0],["مُرعِفُ المِزبَرِ أحرَى بِأن","يَنظُرَ في مِزبَرِهِ الرَّاعِفِ",15,"ف",1,0],["مَرعىً نضيرٌ لم نُصبْ بعدَهُ","نظيرَهُ مذ أَزعجتْنا النّوى",16,"و",2,0],["مَرعاهُ جَدبٌ وَالحُظوظُ لَهُ","حَربٌ وَجانِبُ عَيشِهِ وَعرُ",17,"ر",1,0],["مَرَّ عَلى قَلبي المُعَنّى","مَرَّ عَصوف عَلى أَخيه",18,"ه",1,0],["مرَّ عام وَالحُبّ يَزدادُ يَوماً","بَعدَ يَومٍ وَالمالُ يَزداد هَدرا",19,"ر",2,0],["مُرْ عُبَيْدَكَ كُلُّ أَمْرِكَ مُمْتَثَلْ","فَهْوَ مَا هُوَ لاَ يُلِمُّ بِهِ مَلَلْ",20,"ل",1,1],["مرعى أنيق لأسرابِ الظباءِ فلا","تجعله دمنةَ نعّار وَنطّاح",21,"ح",1,0],["مر على حبي نسيم الصبا","فقال لي في بعض أقواله",22,"ه",1,1],["مر عمري ولا نلت المراد","من تلاقيك أيا نور الوجود",23,"د",1,0],["مَرَ عُمْري على الصّدود فهل يغلَطُ","دهري بيومِ وصْلٍ وقربِ",24,"ب",1,0],["مرَّ على هِزَّة ألبادِهِ","يكبُرُ أن يؤمرَ أو يُزجَرا",25,"ر",2,0],["مَرَّ عامٌ وأنتض يا صاحِ صَاحِ","ومعَ الرَّاحِ لم تَعُد في كِفاحٍ",26,"ح",1,1],["مَرّ علينا فكَنفْنا بهِ","مِن بين مَن مرّ ولا يدري",27,"ر",2,1],["مَرَعتَ ولا زالت تصوبك ديمة","يجود بها جَون الغوارب أقمرُ",28,"ر",1,0],["مرّ عامٌ على حكومة باكس","تانَ قامَت بالعزِّ تحمي الذِمارا",29,"ر",2,0],["مَرْعَى تَفَضُّلِهِ السَّعْدانُ غِبَّ حَياً","خِصْباً ومورده مذ كان مَدَّاءُ",30,"د",3,0],["مَرَّ عَلى السَبع فَقامَ نَطَحه","في صَدرِهِ بِقرنِهِ فَجَرَحَه",31,"ه",1,0],["مَرَّ عَلَيها بُلبلٌ فَوَقَعا","في يَدِها وَمُذ نَوى أَن يطلعا",32,"ع",2,0],["مُرٌّ عِتابي إذا عَاتبتُ يا وَطناً","أحلى عَزَاءَاتِ عمري فيهِ أوزَاري",33,"ر",2,0],["مُرعَشُ الكَفَّينِ سُقماً","فَلِذا تُخطي نِبالُه",34,"ل",2,0],["مرّ علينا وعلي","هم في التصابي عصر",35,"ر",1,0],["مرعى أنيقٌ وكاسات مشعشعة","من الرحيق وطاساتٌ وولدان",36,"ن",1,0],["مَرعى وفواكهَ قدرها","رزقاً لعبادٍ والنَّعم",37,"م",1,0],["مر عهد الهوان لا عاد عهد","كان ويلاً على البلاد وخبلا",38,"ل",2,0],["مر عهد الهوان كم جر فيه","أهل مصرٍ الضيم قيداً وغلا",38,"ل",2,0],["مر عصري وعصير الراح لم","يحل فارحم فاقد العصرين",39,"ن",1,0],["مر عليه زمان هجر","لم يك يدري له حسابا",40,"ب",2,0],["مرَّ على الغور سريعَ الخطى","وراح يرتاد رياضاً بنجد",41,"د",1,0],["مرّ عمري ولم أزل أتحرّى","وأطوف الأمصار والأحياء",42,"ا",2,1],["مرّ عمري لم أستفد منه شيئا","فلماذا حرصي على باقيه",43,"ه",1,1],["مرعاك دوب الوقت مرعى خصيب","ما طيبه من مرعى وما أحلاه",44,"ا",2,0],["مَرْعَى الغرامِ وَخيمُ","والصبرُ عنه جَسيم",45,"م",1,1],["مرّ عُصفورٌ بِفَخٍّ مَرّةً","قال لم يا صاحبي أنتَ وَحِيد",46,"د",1,1],["مر على لابني شَمَارمَ فال","ما هينَ يُزجي البأساءَ والنِّعَمَا",47,"م",2,0],["مرعى الأماني وملعب الأحلام والن","جوى اللذيذة إن ذكرت عهودها",48,"د",3,0],["مرّ على قبرك أعوانكا","فكلّهم هالهمُ شانُكا",49,"ك",2,1],["مَرَّ عامَانِ بَعدَمَا مَرَّ عامٌ","حَظُّنا مِنكَ لَم يَزَل \"أنْ أَطِيعُوا\"",50,"ع",3,0],["مر عيش آه ما أرغده","المنى كل المنى لو رجعا",51,"ع",2,0],["مرَّ عامٌ من الفراقِ ولمّا","يطفئ الحزنَ يافقيدي البكاءُ",52,"ا",2,1],["مرّ عامٌ ومانسيتكَ يوما","ياحبيباً يطولُ فيه العزاءُ !",52,"ا",2,0],["مر عهدٌ في صراعٍ","طال والأعْوامُ تَتْرَى",53,"ر",2,0],["مر عهد وحافلات الليالي","سجلت جِدَّ سعينا المتوالي",54,"ل",2,1],["مرّ عامٌ وحلَّ عام جديد","وأناعنك ، يا فتاتي ، بعيد",55,"د",1,1],["مَرَّ عُمرٌ مُنذُ أَنْ فَارَقَنِي","وعَلَى وَجهٍ كَوَجهِي نَزَلا",56,"ل",2,0],["مر عمري مسارعا بمصابي ؟","ما عساه عند الوداع يكون ؟",57,"ن",1,0],["مُرّْ عليّه وصافح فؤادي وقلّه","كم ّ خطا يومه استهان بهالكبيره",58,"ر",2,0],["مرَّ «عيدانِ وعشرونَ» وما","عادَني جارٌ.. ولا الهَمُّ ارْتحَلْ",59,"ل",1,0],["مَرَّ عامٌ على طوافِ وَدَاعي","حَدَثتْ فيه حادثاتٌ جِسَامُ",60,"م",1,0],["مَرَّ عامٌ، لديَّ أَلفُ دليلٍ","فلماذا تَسْتَغلِقُ الأَفهامُ؟",60,"م",1,0],["مرَّ عام شهوره ناطقاتٌ","ما بها لَكنةٌ ولا إِعجامُ",60,"م",1,0],["مرَّ عامٌ، هذي الحقيقةُ، لكنْ","أنتم الغافلون عمَّا يُرامُ",60,"م",1,0],["مرَّ عامٌ، نعم، ولكنَّ مثلي","في مَرامي سؤالهِ ، لا يُلام",60,"م",1,0],["مَرَّ عامٌ كغيرِه دون جدوى","وسُنونٌ مَرَّت ومَرَّت سُنون..",61,"ن",1,0],["مرَّ عامٌ وأتى عامٌ وما","مِنْ كتاباتٍ تسرُّ النظرا",62,"ر",2,0],["مٓرّ عامٌ ثمّ أزمانٌ مضت","قتلت فينا فؤادًا حالما",63,"م",2,0],["مَرَّ عامْ وهْوَ إذْ يحْمِلُهُ","حائِراً أنّى لهُ أنْ يُكْرِمَهْ",64,"م",2,0],["مرعبينٍ العدو يوم الحروب","وللصديق وجارهم عز وغنات",65,"ت",1,0],["مرَّ عامٌ، أهكذا مرَّ عامُ","هكذا طوَّفتْ بنا الأيّامُ؟!",66,"م",1,1],["مرَّ عامٌ، كأنَّما مرَّ شهرٌ","عجباً، هل تلاشت الأعوامُ؟!",66,"م",1,0]]}