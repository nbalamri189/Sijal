,[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111158","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106971","الرمل"],[2759,"","https://poetry.dctabudhabi.ae/diwan/poem/145658","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127379","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132709","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66529","الخفيف"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139843",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114503","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114129","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73327","الخفيف"],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""]],"verses":[["يتثنَّى كقامة الغصن اللد","ن ويعطو كالظبية الأدماء",0,"ا",2,0],["يتثنى الأراكُ زهراً فينبي","إنَّ في ثغرها مداماً وشهدا",1,"د",2,0],["يتثنى وحليه يتغنى","هل سمعت الحمام في الأغصان",2,"ن",1,0],["يتثنى فينفُضُ الطلَّ عنه","في تثنِّيه مثلَ حبِّ الجمان",3,"ن",1,0],["يتثنّى للعاطفيه ويُعيي","كاسِريه كهيئة الخيزران",3,"ن",1,0],["يَتَثَنّى عَلى قَضي","بٍ وَيَفتَرُّ عَن بَرَد",4,"د",1,0],["يَتَثَنّى سِنانُها غَيرَ وانٍ","وَقَناها بِالعِزِّ لا تَتَثَنّى",5,"ن",2,0],["يَتَثَنّى كَأَنَّهُ غُصنُ بانٍ","مَيَّلَتهُ الرِياحُ بِالأَسحارِ",6,"ر",1,0],["يَتَثَنّى إِذا مَشى فَهوَ لَدنٌ","في اِعتِدالٍ بِجودَةِ التَقويمِ",7,"م",1,0],["يِتَثَنّى خوطُ بانٍ","وَيَفوتُ الخوطَ خطوا",8,"و",2,0],["يتثنى للعاطفيه ويُعي","كاسِريه كهيئة الخيزران",9,"ن",1,0],["يَتَثني عَلَى التِّلاَلِ عَشِيًّا","فَنَنَ ألبَانِ غِبَّ غَيثٍ هَمُوعِ",10,"ع",1,0],["يَتَثَنّى كَالخَيزرانَةِ بِالرا","حِ فَيُحيي بِمُقلَتِهِ الجَماعَه",11,"ع",2,0],["يتثنّى بقامةٍ فتنتنا","فارجعي يا غصون عن حركاتك",12,"ك",1,0],["يَتَثَنَّ في خُضرِ البُرودِ كَأَنَّهُ","غُصنٌ ثَنَتهُ الريحُ في أَوراقِهِ",13,"ق",2,0],["يتثَّنى طوعَ النسيم وغصنُ البا","ن طوعُ النسيم إذ يتثنَّى",14,"ن",2,0],["يتثنَّى كرمحه اللحظُ في","عشّاقه والقوام قوام",15,"م",1,0],["يَتَثَنّى كَأَنَهُ غُصنُ بانٍ","هَزَّ عِطفَيهِ في ثَرىً مَمطورِ",16,"ر",1,0],["يتثنون في رياض علوم","مزهرات بحضرة القدوس",17,"س",1,0],["يَتَثَنّى بِحُسنِ جيدِ غَزالٍ","وَصَليبٍ مُفَضَّضٍ آبَنوسي",18,"س",2,0],["يتثنَّى على الحمارة إعجا","باً وتيهاً بأنكر الأصواتِ",19,"ت",1,0],["يَتَثَنّى بِقامَةٍ مِثلَ رُمحٍ","يَطعَنُ الأُسدَ ميلُها بِاللينِ",20,"ن",1,0],["يتثنَّى كرمحه اللحظُ في عش","شاقه النصلُ والقوام قوام",21,"م",1,0],["يتثنّى سكرانَ من خمرة التّي","هِ كما مال في النّسيم الخوطُ",22,"ط",1,0],["يتثنى ومن رآه تثنى","وَحَميم الأليم لا يَستَريح",23,"ح",1,0],["يتَثنى مقبلاً لا معرضا","يَتَغَنّى مطرباً لا محزنا",24,"ن",2,0],["يتثنى فينثني أسل الخط حي","اء من قدِّه الخُوطِيِّ",25,"ي",1,0],["يتثنى بمائس وسموه","وهو الرمح في الطعان قواما",26,"م",2,0],["يتثنى قدها غصناً رطيب","وهي تشدو بغناء العندليب",27,"ب",1,0],["يتَثَنَّينَ مائساتٍ فيثني","ن قدودَ الغصونِ تحتَ البدورِ",28,"ر",1,0],["يتثنى إن مشى تح","سبه غضا رطيبا",29,"ب",2,0],["يتثنى كانه غصن بان","غازلته مع الصباح قبول",30,"ل",1,0],["يتثنّى الخَطّيُّ منها فيجْلو","ظُلَمَ الرّوْعِ منهُ جِذوةُ قابِسْ",31,"س",1,0],["يتثنى تيهاً بخوطي قد","ما حكت غصنه القناة شروعا",32,"ع",2,0],["يتثنى بغصن قَدٍّ وطيب","يثمر الجلنار والتفاحا",33,"ح",2,0],["يتثنى بمعطف وقوام","مثلما حرك النسيم الغصونا",34,"ن",2,0],["يتثنَّى كقضيبٍ","صيغَ أعلى صَوغَه",35,"ه",1,0],["يَتَثَنَّى كَقَضِيبٍ","يَستَمِيلُ المُهجَه",36,"ه",1,0],["يتثنى الدهر فيه جذلا","فهو منهز بقدٍّ أهيف",37,"ف",1,0],["يتثنَّى تِيهاً بقَدٍّ وَوَجهٍ","يَترُكُ الليَّلَ بالضيِّاءِ نَهارا",38,"ر",2,0],["يتثنى كأنني كنت أدري","بالذي لاعه وأشغل باله",39,"ل",2,0]]}