{"poems":[[68,"لا تنطقن عن الهوى","https://www.aldiwan.net/poem39683.html","مجزوء الكامل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[242,"باب نداك الجزيل غير مسدود","https://www.aldiwan.net/poem18171.html","البسيط"],[242,"عبد السلام ومن عبد السلام إذا","https://www.aldiwan.net/poem19086.html","البسيط"],[242,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[354,"سعي الفتى لسوى كف","https://www.aldiwan.net/poem15849.html","مجزوء الكامل"],[396,"عيدروس اشرح بالك واترك الهم والغم","https://www.aldiwan.net/poem54501.html","عموديه"],[470,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112434","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48934","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87946","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87926","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87866","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141282","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100978","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93869","الخفيف"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82806","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88889","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69244","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95060","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94512","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94993","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95058","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94818","الكامل"],[4690,"نُصوصٌ ولُصوص","https://www.poetsgate.com/ViewPoem.aspx?id=175474",""],[4978,"تشطير قصيدة لو كان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177254",""],[5050,"يا عين صبرا لما دمع","https://www.poetsgate.com/ViewPoem.aspx?id=38217",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5309,"قالوا اترجو من الهك نصرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573557",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6259,"لوكان حرُّ الوجد يُعقب بعده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59419&r=&rc=67",""]],"verses":[["إِذ ذاكَ يَخطو في الهَوا","ءِ وَإِن تَخَطّى في الهَوى",0,"و",2,0],["إذ ذلك الوادي قَناً وأسِنّةٌ","وإذِ الدّيارُ مَشاهدٌ ومحافل",1,"ل",1,0],["اذ ذاك يًُصبحُ بعد طُول مَتاهةٍ","بيد الشُعوب مقادةٌ وزِمام",2,"م",1,0],["إِذْ ذَاكَ يَأْوِي إِلَى رُكْنٍ شَدِيدٍ لَهُ","مِنْ سُؤْدَدٍ بَاهِرٍ كَالْبِيضِ فِي السُّودِ",3,"د",1,0],["إِذْ ذَاكَ صِنْوُ أَبِيهِ الْبَرِّ مَوْضِعُهُ","مَنْ قَلْبُهُ مَوْضِعٌ لَمْ يُصْمِهِ رَامِ",4,"م",1,0],["إِذْ ذَاكَ يُوهِمُ أَنَّهُ مُتَخَشِّعٌ","لِنَوَائِبِ الأَزَمَاتِ وَالأَزْمَانِ",5,"ن",1,0],["إِذ ذا يُعانُ وَذا يُرادُ","بِهِ الرَدى مِن نَجلِهِ",6,"ل",2,0],["إذذا والله المغنم لمن كان يفهم","الشفافي التوحش والتخالط بهم سم",7,"م",1,0],["إذ ذاكَ يا سَيِّدي يَغفو بِأعيُنِنا","مُحَمَّدُ بنُ سُلَيمان ٍ سُلَيمانا!",8,"ن",2,0],["إذ ذكر الرسول منبي عنه","فقال يتلوه شهيد منه",9,"ه",1,0],["إذ ذكروا طلحة والزبيرا","بالنكث فاحتج وأثنى خيرا",9,"ر",2,0],["إذ ذاك اثقل متنها بلواعجي","ويبلل الأوراق هاطل مدمعى",10,"ع",2,0],["إذ ذاك يصدقُ أن نسمّى أُمةً","تُعطى مقاليدٌ لها وزِمام",11,"م",1,0],["اذ ذاك إِقبالها الادبارُ يوهمهُ","سيّان في وهمهم حَقٌّ وبطلان",12,"ن",1,0],["اذ ذاك تعصى العقل اميال الفتى","فقدَ البصيرة والشعور من ابتلى",13,"ل",2,0],["إذ ذَاكَ تَعصى العَقلَ أًميَالُ الحَشَا","يَأبَى التَّحَصُّنَ كَهلُكُم وَفَتَاكُمُ",14,"م",1,0],["إذ ذاك نهتف للأعلام خافقةً","ويسلم الرّبع لا غربٌ ولا عجم",15,"م",1,0],["إذ ذكر الناس إخوانهم","فإنك أنت الوفي الودود",16,"د",1,0],["إذ ذاك ينقشِعُ الظلامُ وينجلي","نورُ اليقين بيقظةِ الوُجدانِ",17,"ن",1,0],["إذ ذانِك الأمرَانِ قَد ذُكِرا وَبَي","نَهُمَا مَجِيءُ الرَّبِّ ذِي الغُفرَانِ",18,"ن",1,0],["إذ ذَاكَ مَصلَحَةُ المخَاطِبِ عِندَهُم","وَطريقَةُ البُرهَانِ أمرٌ ثَانِ",18,"ن",1,0],["إذ ذَاك مُوهِمُ نَوعِ نَقصٍ جَلَّ رَبُّ","العَرشِ عَن عَيبٍ وَعَن نُقصَانِ",18,"ن",1,0],["إذ ذووا الجهل في الأنام ذنابى","وأولوا العلم تاج هام الرؤس",19,"س",1,0],["إِذ ذاكَ يَدعو فَمَولاه يَقولُ لَهُ","سَل تُعطَ ما تَبتَغي إِذ كنت أَوّابا",20,"ب",2,0],["إِذ ذاكَ أَرجو عَظيمَ العَفوِ يَشمَلُني","فَلا أَرى في كتابي بعدُ إِذ نابا",20,"ب",2,0],["إذ ذا سنا أنس هنك كأنه","لك كل قرب برق أجر رجاءِ",21,"ا",2,0],["اذ ذنبُها أَضحى سعيداً أَنَّهُ استَدعَى","الينا اللَه وَهوَ مجسَّمُ",22,"م",1,0],["اذ ذاكَ اذعن كل للحقيقة اذ","هيَ الَّتي اِنبلجت كالصبح اذ بلجا",23,"ج",2,0],["إذ ذاك زفس هز للإرهاب","مجنه الباهر ذا الهداب",24,"ب",1,0],["إذ ذوي غصن شبابي فالتوى","ونسيمي ركدت أنفاسه",25,"ه",1,0],["إِذ ذَكَروا فَضلَ امرىءٍ كانَ قَبلُهُ","فَفَضلُ عُبَيدِ اللَهِ أَثرى وَأَطيَبُ",26,"ب",1,0],["إذ ذاك جبرائيل قال فقيدكم","أضحى بجنّات المهيمن مصطفى",27,"ف",2,0],["إذ ذاك قد سلَّمتُ عن كظمٍ إلى","أَمرٍ لهُ كل الأنام ذَليله",28,"ل",2,0],["إذ ذاك جبرائيل بشر قائلاً","ناصيف أضحى في السماء أليفي",29,"ف",2,0],["إذ ذاك جبريل نادى غادِروا شجَناً","فروزةٌ قد زَهت بالخلد أنوارا",30,"ر",2,0],["إذ ذاك جود اللَه حالاً حفَّني","ونجوت من عَرَضٍ وفزتُ بصحتي",31,"ي",1,0],["إذْ ذاكَ لا لوْمٌ عليْنا",":فِعْلُهُ قَدْ ضَيّعَهْ",32,"ع",2,0],["( إذ ذاك يشرق في حياتي فجرها )","يُردى الفراق ويبعث ُ الأحبابا",33,"ب",2,0],["إذ ذاك فيه لو رأي","ت صلاحه طبع طبع",34,"ع",1,0],["إذ ذل بالآمال غيري فإنني","لغير رسول الله لا أتذلل",35,"ل",1,0],["إِذ ذاكَ تَنتَصِرُ العَدالَةُ في الوَرى","وَيَعيشُ مَن عَشِقَ السَّجايا الفاضِلَه",36,"ل",2,0],["إذْ ذئابُ الليل تجتاسُ دمي","والضُّحى يضحكُ في الصَّبَّارِ ضِغْنا",37,"ن",2,0],["إذ ذبتَ من كمد فقد جرّ الهوى","هذا السقام عليَّ من جرَّاكا",38,"ك",2,0]]}