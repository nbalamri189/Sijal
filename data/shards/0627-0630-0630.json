{"poems":[[66,"لا تنطقن عن الهوى","https://www.aldiwan.net/poem39683.html","مجزوء الكامل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[237,"باب نداك الجزيل غير مسدود","https://www.aldiwan.net/poem18171.html","البسيط"],[237,"عبد السلام ومن عبد السلام إذا","https://www.aldiwan.net/poem19086.html","البسيط"],[237,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[349,"سعي الفتى لسوى كف","https://www.aldiwan.net/poem15849.html","مجزوء الكامل"],[391,"عيدروس اشرح بالك واترك الهم والغم","https://www.aldiwan.net/poem54501.html","عموديه"],[465,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِذ ذاكَ يَخطو في الهَوا","ءِ وَإِن تَخَطّى في الهَوى",0,"و",2,0],["إذ ذلك الوادي قَناً وأسِنّةٌ","وإذِ الدّيارُ مَشاهدٌ ومحافل",1,"ل",1,0],["اذ ذاك يًُصبحُ بعد طُول مَتاهةٍ","بيد الشُعوب مقادةٌ وزِمام",2,"م",1,0],["إِذْ ذَاكَ يَأْوِي إِلَى رُكْنٍ شَدِيدٍ لَهُ","مِنْ سُؤْدَدٍ بَاهِرٍ كَالْبِيضِ فِي السُّودِ",3,"د",1,0],["إِذْ ذَاكَ صِنْوُ أَبِيهِ الْبَرِّ مَوْضِعُهُ","مَنْ قَلْبُهُ مَوْضِعٌ لَمْ يُصْمِهِ رَامِ",4,"م",1,0],["إِذْ ذَاكَ يُوهِمُ أَنَّهُ مُتَخَشِّعٌ","لِنَوَائِبِ الأَزَمَاتِ وَالأَزْمَانِ",5,"ن",1,0],["إِذ ذا يُعانُ وَذا يُرادُ","بِهِ الرَدى مِن نَجلِهِ",6,"ل",2,0],["إذذا والله المغنم لمن كان يفهم","الشفافي التوحش والتخالط بهم سم",7,"م",1,0],["إذ ذاكَ يا سَيِّدي يَغفو بِأعيُنِنا","مُحَمَّدُ بنُ سُلَيمان ٍ سُلَيمانا!",8,"ن",2,0],["إذ ذكر الرسول منبي عنه","فقال يتلوه شهيد منه",9,"ه",1,0],["إذ ذكروا طلحة والزبيرا","بالنكث فاحتج وأثنى خيرا",9,"ر",2,0]]}