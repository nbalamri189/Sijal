{"poems":[[55,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[57,"طال حزني لما حبست الرسولا","https://www.aldiwan.net/poem26142.html","الخفيف"],[88,"دك ما بين ضحوة وعشي","https://www.aldiwan.net/poem10480.html","الخفيف"],[53,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[83,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[52,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202533","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[136,"يالدهر قمنا به في أمان","https://www.aldiwan.net/poem54711.html","الخفيف"],[147,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[164,"ما خيب الله فيه للورى أملا","https://www.aldiwan.net/poem58899.html","البسيط"],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[236,"قد كف هوام لساني ويدي","https://www.aldiwan.net/poem44545.html","الدوبيت"],[259,"دع ملامي","https://www.aldiwan.net/poem24953.html","مجزوء الرمل"],[259,"لا تعاتبني","https://www.aldiwan.net/poem24961.html","مجزوء الرمل"],[309,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[333,"أطرق الشاكي ونام الموجع","https://www.aldiwan.net/poem55030.html","الرمل"],[376,"كل من يستكفني يغريني","https://www.aldiwan.net/poem57066.html","الخفيف"],[398,"عين جودي على الشهيد القتيل","https://www.aldiwan.net/poem53467.html","الكامل"],[412,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[422,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[422,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[438,"وأسمر يفتك بي طرفه","https://www.aldiwan.net/poem12616.html","السريع"],[443,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[510,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[510,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[580,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83266","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53832","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122738","الرمل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101498","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39109","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48675","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99970","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145852","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/90427","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114036","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53227","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130774","الخفيف"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142915","الرمل"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/82779","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65117","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65490","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97898","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68033","الرجز"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133018","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62837","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62858","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91080","المديد"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36797","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107539","الخفيف"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132189","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97102","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73088","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73182","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83507","الخفيف"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139689",""],[4767,"خير الزاد","https://www.poetsgate.com/ViewPoem.aspx?id=89611",""],[4767,"نبئت","https://www.poetsgate.com/ViewPoem.aspx?id=93823",""],[4767,"العلامات المبينة","https://www.poetsgate.com/ViewPoem.aspx?id=94788",""],[4767,"حديث مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=124899",""],[4767,"الذكر الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179785",""],[4767,"عذبيني","https://www.poetsgate.com/ViewPoem.aspx?id=214075",""],[5224,"يا نديمي قم فإن الديك صاح","https://www.poetsgate.com/ViewPoem.aspx?id=121313",""],[5550,"كفاني","https://www.poetsgate.com/ViewPoem.aspx?id=214552",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5691,"فتنَةُ كربُلاء...!","https://www.poetsgate.com/ViewPoem.aspx?id=206635",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""]],"verses":[["قَد كُفيتَ السَعيَ الطَويلَ وَتَأبى","أَن يَرى المَجدُ مِنكَ حِلساً وَقُفّا",0,"ف",2,0],["قَد كَفَفنا عَنكِ التَعَرُّضَ كَيلا","يُكثِرَ الناسُ فيكِ قالاً وَقيلا",1,"ل",2,0],["قَد كَفاكَ السُهادُ في العَيشِ فَاِهنَأ","يا أَليفَ الضَنى بِنَومٍ هَنِيِّ",2,"ي",1,0],["قد كفاه ما يَمْتري منك فيه","خوفُكَ اللَه من ندىً ودموع",3,"ع",1,0],["قد كَفيتَ الرِّعاءَ والشاءَ طورَيْ","عَدواتِ الأسودِ والذُّؤبان",4,"ن",1,0],["قَد كَفاني ما حَلَّ بي","مِن خُمولٍ وَفرِطِ بَين",5,"ن",1,0],["قَد كَفَيتَ المَهدِيَّ هَمّاً وَشاغَب","تَ عَدُوّاً فَالمِحرَبُ الشَغّابُ",6,"ب",1,0],["قد كفى ما جرَى دماً من جُفُونٍ","بك قرحَي فهل جرى ما كفاكا",7,"ك",2,0],["قد كفروني لأني في مجالسهم","على الحقيقة إِمّا قلت أتّكل",8,"ل",1,0],["قد كفلوا الإسلام في صباه","فأيهم نادى دعا أباه",9,"ه",1,0],["قَدْ كَفَاني بُعْدِي عَنِ النَّاسِ أَنِّي","في أَمانٍ مِنْ غِيبَةِ الْمُغْتَابِ",10,"ب",1,0],["قد كفاني ذل الهوى لا تَزدني","وأرحْني من الهوَى وشَقَائه",11,"ا",3,0],["قد كفَاني ما بِي هوىً لا تزيدو","ني جَفاءً فإنني صِرْتُ مُلْقَى",12,"ق",2,0],["قَد كَفَاني مِنهَا إستِمَاعٌ قَلِيلٌ","عَن سَمَاعِى مِن ضَارِبَاتِ العِيدَانِ",13,"ن",1,0],["قَد كَفى اللَهُ وَهوَ نِعمَ الكافي","وَشَفى المَجدَ وَهوَ أَلطَفُ شافِ",14,"ف",1,1],["قَد كَفاها أَبو الفَوارِسِ أَن يَق","دَحَ فيها تَنَقُّلُ الأَحوالِ",15,"ل",1,0],["قد كفّر اللهُ عنه كل سيئةٍ","وقد كفاه من الأسواء ما سألا",16,"ل",2,0],["قَد كَفاكَ النُجحُ يَوماً","تَتَرُكُ الصاحِيَ مِنهُ نَزيفا",17,"ف",2,0],["قَد كَفى جيشهُ بِصاع طعامٍ","فَتعجَّب أَما لهم أمعاءُ",18,"ا",2,0],["قد كف هوام لساني ويدي","كم أخضع للعدا وأنتم عددي",19,"ي",1,1],["قد كفاني منك بَيْنٌ","كان همّاً بل عذابا",20,"ب",2,0],["قد كفاني ما أعاني","أشتكي أو لن أسيرا",21,"ر",2,0],["قَد كَفاني عِلمُ رَبّي","مِن سُؤالي وَاِختِياري",22,"ي",1,1],["قَد كَفاني عِلمُ رَبّي","مِن سُؤالي وَاِختِيارِ",22,"ي",3,0],["قَد كَفاني عِلمُ رَبّي","مِن سُؤالي وَاِختِباري",22,"ي",1,0],["قد كفاني وكفى قلبي الهوى","هدنا من راحتيه معول",23,"ل",1,0],["قد كَفاني محمَّدُ بنُ عَليٍّ","ما سِوَى شُكرِه فَمن يَكفِيني",24,"ن",2,0],["قَد كَفاني في الشَرقِ وَالغَربِ فَخراً","أَن يَقولوا مِن قيلَ اِسماعيل",25,"ل",1,0],["قَد كَفانا الخيال وَلَو زُر","تِ لأَصبَحتِ مِثلَ طَيفِكِ ذِكرى",26,"ر",2,0],["قد كفاني الله في ألطافه","بأبي عيسى نوالاً ومنيلا",27,"ل",2,0],["قد كفاني ربِّي استماحة قومٍ","أشربوا في الصُّدور غِلاًّ وبخلا",28,"ل",2,0],["قد كفلَتْ أكفالُه أنّه","بخَصْره ينعقِدُ الخُنصُرُ",29,"ر",1,0],["قد كفلت الأيتام بالجودش حتى","أتمنّى أنّي منَ الأيتام",30,"م",1,0],["قد كفاني شكوى حسودي فعلٌ","هو أنضى فؤاده بي هزلا",31,"ل",2,0],["قدْ كفاكَ اللهُ سموماً تُميتُ","كلَّ محْمودةٍ ويَبقىْ الذّميمُ",32,"م",1,0],["قد كفيت ردىً لو تبصرته","فرّ من وجهك الدّمُ محترقا",33,"ق",2,0],["قد كَفَّ أَعدائي وقد ردَّهم","بغيظِهم لما أَتَوْنِي غُزاه",34,"ا",2,0],["قَد كَفَتني مِنكَ الشَهادَةَ في إِث","باتِ مَن قالَ بِالخِلافِ وَأَنكَر",35,"ر",1,0],["قَد كَفانا مِن وَصفِهِ أَنَّهُ ال","مَهدِيُّ مُذ قَد تَجَلَّتِ الأَسماءُ",36,"ا",2,0],["قد كفَّلتها شحوم من قلّيتها","ومن سنام جزور عَبْطَة سَنِمَهْ",37,"م",2,0],["قَدَ كَفاني اللهُ ما أكرَهُهُ","حَسبيَ اللهُ وَمُوسَى بنُ عَلي",38,"ل",2,0],["قد كفاكم تروّعُونَ حبيبي","أفصخراً تحوون أم هوَ قلبُ",39,"ب",1,0],["قدُّكَ في مَلْبَسِكَ الوَرْدي","أم آسَةٌ تَخْتالُ في وَرْدِ",40,"د",1,1],["قد كفَّروا آثامهم بدمائهم","لو يقنعون بذلك القربان",41,"ن",1,0],["قَدْ كَفانِي الإِمَامُ مَا قَدْ عَنَانِي","وانْتَضَانِي مِنْ خَلَّةِ الانْفَاضِ",42,"ض",1,0],["قد كفنتك عيونُنا بدموعِها","فبغيرِ دمعِ العينِ لن تتكفّنا",43,"ن",2,0],["قَد كَفاني كلُّ ما قد حلَّ بي","فاعفُ عنّي يا أَبرَّ القادِرين",44,"ن",1,0],["قد كف عنا الله ذو الجلال","من أجله عذاب الاستئصال",45,"ل",1,0],["قد كُفيتم من غارة البخل لمَّا","أن نهضتم مشمّرين غيارى",46,"ر",2,0],["قد كفاني عن الأوادم طرا","اسم طير معلم لابن آدم",47,"م",1,0],["قَد كَفَّها عَن كَثِيرٍ مِن تَوَقُّدِها","خِرقٌ يُرى الماءُ مِن كَفَّيهِ يَنعَصِرُ",48,"ر",1,0],["قد كَفَاهُ ورهطَهُ وكَفَاني","أَنَّنيِ في ذُرىَ رفيعِ الجنَاَبِ",49,"ب",1,0],["قد كفى الله كيد فرعونه أمس","ى فماذا يخاف من هامانه",50,"ن",2,0],["قد كفانا العذاب دهراً والا","وهنَ العظم واستحال الشبَح",51,"ح",1,0],["قد كفاني ما تحملت من الآلم الفراق","لوعة في أضلعي قد بلغت حتى التراقي",52,"ي",1,0],["قَد كَفانا مِن مَساء يَدّعي","أَنّ نُورَ الصُّبحِ مِن آياتِهِ",53,"ه",1,0],["قد كفتك السّعود كلّ كريه","وكفتكم حرب العدوّ العنيد",54,"د",1,0],["قد كفاني عن الأوادم طُرّا","بنكات تُزري بزهر الكمائم",55,"م",1,0],["قَد كَفاها الدَهرُ مَنطِقَها","أَو بُكائِي أَو تَبَسُّمُها",56,"م",3,0],["قد كفانا البخيلُ ندعو عليه","فهو في حالة من النفس تجزى",57,"ز",2,0],["قَدْ كفلَ اللهُ العبادَ رِزْقَهم","فالحرصُ لا يُجْدِي الفتى إِلاَّ العَنا",58,"ا",1,0],["قد كفاني من المدام شَميمُ","صالَحَتني النُّهى وثابَ العزيمُ",59,"م",1,1],["قد كفاكَ التدبيرُ يا عضدَ الدو","لةِ سلَّ الظُّبى وهزّ العَوالي",60,"ل",2,0],["قد كفاكم جُلَّ تدبيركُمُ","حَدَثُ السنِّ لبيبُ مُقْتَبَلْ",61,"ل",1,0],["قَد كَفاني ما مَضى وَاِنقَضى","بِالَّذي كانَ الضَلال البَعيدْ",62,"د",1,0],["قَد كَفى ما حَلّها مِن حادِثٍ","هُدَّ وَاللَهِ لَهُ رُكناً شَمام",63,"م",1,0],["قد كفَت لحظةٌ لتبدل صفوي","باعتكارٍ وحلوَ عيشي بعلقم",64,"م",1,0],["قد كفن الشيب منك الوجنتين متى","تتوب من معصيات اللهو واللعب",65,"ب",1,0],["قد كفته مؤنة فكفاها","وجزاها بالجنس خير جزاء",66,"ا",2,0],["قد كفروا فيها فويل الكافرينا","والكل منهم في غد يعرف سيماه",67,"ه",1,0],["قَد كُفيِتم إذا وصَلتمُ دِمَشقاً","فَأنيخوُا بِها وَحطُّوا الرِّحالا",68,"ل",2,0],["قَد كَفلَت منهُ لهُ كَسرتُهُ","بِكُلِّ ما يطلُبُ من نُصرتهِ",69,"ت",2,0],["قَد كَفاكِ الدَلالُ هجراً لصبٍّ","هيمانٍ مُتَيَّم الإِدلالِ",70,"ل",1,0],["قَد كَفاني اللَهُ ما في نَفَسَهِ","وَمَتى ما يَكفِ شَيئاً لا يُضِع",71,"ع",1,0],["قد كفلت الندى بمهد أيادٍ","عاد منها طفل السماح رضيعا",72,"ع",2,0],["قد كفانا أيها الإخوان ما","منه يأتينا بلاء وخطوب",73,"ب",1,0],["قد كف عن إنشاده وبدا","في قبضة الأحزان مشتغلا",74,"ل",2,0],["قد كفا المؤمن هماً واضطهاداً","بالذي أحدثه م