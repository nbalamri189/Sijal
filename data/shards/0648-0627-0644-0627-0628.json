{"poems":[[55,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[65,"لاح بريق يلمع","https://www.aldiwan.net/poem45736.html","مجزوء الرجز"],[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[79,"يمينا بيانع ورد الخدود","https://www.aldiwan.net/poem36617.html","المتقارب"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[87,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[45,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[47,"صككت على سليمان بن وهب","https://www.aldiwan.net/poem63522.html","الوافر"],[47,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[30,"أتنسى بنو سعد جدود التي بها","https://www.aldiwan.net/poem5491.html","الطويل"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85520","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20995","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54958","الخفيف"],[102,"تقرير إلى عام 71 حيث كنا","https://www.poetsgate.com/ViewPoem.aspx?id=50375",""],[30,"أتنسى بنو سعد جدود التي بها","https://www.poetsgate.com/ViewPoem.aspx?id=22083",""],[101,"إلى عجوز","https://www.poetsgate.com/ViewPoem.aspx?id=17722",""],[102,"تقرير الى عام 71 حيث كنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67685&r=&rc=172",""],[20,"من رآنا فليحدث نفسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70019&r=&rc=41",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[285,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[327,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[333,"قولو لمن نظم الرواية","https://www.aldiwan.net/poem55011.html","مجزوء الكامل"],[382,"إن البتولة مريما قد كللت","https://www.aldiwan.net/poem59179.html","الكامل"],[412,"أرى الشعب فانظر دونه هل هو الشعب","https://www.aldiwan.net/poem50205.html","الطويل"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[463,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[463,"ليتك لما تكن مسعدا","https://www.aldiwan.net/poem56237.html","السريع"],[484,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[505,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[556,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[572,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199573","المسحوب"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108860","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108814","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131323","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137104",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216556",""],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138757",""],[3556,"","https://poetry.dctabudhabi.ae/diwan/poem/138020","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45759","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125946","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91217","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36714","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90921","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90995","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54503","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45080","الطويل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58007","الكامل"],[4755,"عادَ أَيلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=183571",""],[4767,"السعادة والسرور","https://www.poetsgate.com/ViewPoem.aspx?id=180907",""],[4869,"الحياه الملوكيّه","https://www.poetsgate.com/ViewPoem.aspx?id=137909",""],[5122,"((((( عيون الاخبار )))))","https://www.poetsgate.com/ViewPoem.aspx?id=37320",""],[2365,"سلم على قبر الحسين وقل له","https://www.poetsgate.com/ViewPoem.aspx?id=200650",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5457,"ما معنى الوطن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213236",""],[5638,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=198121",""],[5762,"نشيد يا شباب الجيل","https://www.poetsgate.com/ViewPoem.aspx?id=13135",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[5883,"عجب عجاب","https://www.poetsgate.com/ViewPoem.aspx?id=24072",""],[6089,"خذْ ما تشاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=213643",""],[6093,"لاتَنْظرنَّ لِقِمَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=205910",""],[6108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=192585",""],[463,"ليتك لما لم تكن مسعدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60020&r=&rc=76",""]],"verses":[["وَالإِبنُ لِلأَبِ إِن تَعَرَّضَ حادِثٌ","أَولى الأَنامِ بِأَن يَكونَ وِقاءَ",0,"ا",2,0],["والإِبِلُ الهُوجُ إِلى","أُلاَّفِهِنَّ تَنْزَعُ",1,"ع",1,0],["والأبيضُ المأثورُ يَخْطِمُ بالرّدى","مَنْ لا يُنَهْنِهُهُ القَطيعُ الأسمَرُ",2,"ر",1,0],["وإلا بمُنْهَلِّ صَوْبِ الحَيا","وخَفْقِ البُنودِ وقَصْفِ الرّعودْ",3,"د",1,0],["وآل أبى دُلَفٍ معشرٌ","يرون المكارم ديناً شرع",4,"ع",1,0],["وَالأَبِيِّ العَفيفِ في حالَتَيهِ","وَالجَوادِ الكَريمِ في إيثارِهِ",5,"ر",2,0],["وَالأَبلَقُ الفَردُ اِنتَهَت أَوصافُهُ","في السُؤدُدِ العالي لَهُ وَنُعوتُهُ",6,"ت",2,0],["وَالأَبرَدَينِ وَالهَجيرِ الماحِقِ","لِلفارِسِ الراكِضِ مِنهُ الواثِقِ",7,"ق",1,0],["وَآلُ أَبي الوَزيرِ رَغَوتَ فيهِم","رُغاءَ البُكرِ في وادي ثَمودِ",8,"د",1,0],["وَآلُ أَبي طالِبٍ بَعدَما","أُذيعَ بِسِربِهِمِ فَاِبذَعَر",9,"ر",1,0],["وَآلِ أَبي سودٍ وَعَوفِ اِبنِ مالِكٍ","إِذا جاءَ يَومٌ بَأسُهُ غَيرُ مُنجَلِ",10,"ل",1,0],["والأباريقُ كالظِّباءِ العَواطي","أوجَسَتْ نَبْأةً الجِياد العِتاق",11,"ق",1,0],["والأبله الغر للإذعان أَسرعها","موكل بِفَيافي الظن يذرعها",12,"ه",2,0],["والأَباريقُ عَلَيها فُدُمٌ","وعِتَاقُ الَخيلِ تَردي في الجِلال",13,"ل",1,0],["وَالأَبَاطِيلُ مِنْ قَدِيمٍ نِصَالٌ","وَدُرُوعٌ لِخَصْمِكَ الصِّنْدِيدِ",14,"د",1,0],["وَالأَبَ البَرَّ لِلبَناتِ وَلِلأَبْناءِ","فِي مِصْرَ وَالوَلِيَّ الْقَدِيرَا",15,"ر",2,0],["والأباة الذين بالأمس ثاروا","أيقضوا حولنا الذئاب وناموا",16,"م",3,0],["وَآلِ أبي سُودٍ وَعَوْفِ بن مالِكٍ،","إذا جَاءَ يَوْمٌ بَأسُهُ غَيرُ مُنجَلِ",17,"ل",1,0],["والإبطُ أيةُ حفرةٍ ملعونةٍ","الدودُ يملأُ قَعرَها والأوبئهْ",18,"ا",2,0],["والأباة الذين بالأمس ثاروا","أيقظوا حولنّا الذئاب وناموا",19,"م",3,0],["وَالأَباريقُ عَلَيها قُدُمٌ","وَجِيادُ الخَيلِ تَجري في الجِلال",20,"ل",1,0],["وَآلُ أبي بكرٍ خيارٌ وخيرهم","حَبيبةُ خيرِ الخلقِ عائشة الحمرا",21,"ر",2,0],["وإلا بأقمارٍ من الحيِّ لُحْنَ في","مشارقَ من أحداجِها ومغاربِ",22,"ب",1,0],["وَالأَبيَضُ البَضُّ المُعَظَّمُ جَدُّهُ","شَيخُ الأَباطِحِ سَيِّدُ الحمسانِ",23,"ن",1,0],["وَأَلاَّ بِحَيْثُ السَّمْهَرِيَّةُ شُرَّعٌ","تُعَلُّ مِنَ الأَكْبَادِ رَياً وَتُنْهَلُ",24,"ل",1,0],["وَآلُ أَبي العاصِ أَهلُ مَأثُرَةٍ","غُرٌّ عِتاقٌ بِالخَيرِ قَد نَفَحوا",25,"ح",3,0],["والأبرياء وأنت ظالمهم","وعمال العنابر",26,"ر",1,0],["والإبن يفرح بهجةً في أمه","لما رآها رُقِّيَت عن كل دو",27,"و",1,0],["وَآل أَبي الذَوّادِ حسبك أَنَّهُم","إِذا استَنفَروا حَرب أَو انتَجَعوا سُحُبُ",28,"ب",1,0],["والأَبْلقَ الفرْدَ والأَبْراجَ من أَجَأٍ","والسَّيلَحِينَ وسدّاً كَانَ مَا كَانَا",29,"ن",2,0],["وإلا بقرب عميد الكفا","ةِ عذرُك في كلّ ذنْبٍ عَظُمْ",30,"م",1,0],["والأبيضَ الماضي وأختَ الدرع مح","مولَين وابنَ الأسمر العسالا",31,"ل",2,0],["والأبيضا الرأي إذا ما شكا","خابطُ ليلٍ رَأيَهُ الأسوَدا",32,"د",2,0],["والابن واجبة مبرته بها","وعلى الكواهل تحمل الأثقال",33,"ل",1,0],["والأبرص السيف لا سواد به","كأنه شعلة من الشعل",34,"ل",1,0],["والأبيض السيف راع منظره","كأنه من سناك في حلل",34,"ل",1,0],["والأَبْتَرُ الشَّاني يَرومُ نقصَهُ","والنَّقصُ قِدْماً حِليَةُ المُشينِ",35,"ن",1,0],["وإلّا بدوراً بالرّحيل كواسفاً","وإلّا شموساً بالحدوجِ دوالكا",36,"ك",2,0],["وَإِلاَّ بَكَى عُرْفٌ كَثِيْرٌ كَثِيْرٌ مَنَعْتُهُ","فَعِنْدِي عَلَيْهِ الهَزُّ والحَثُّ والحَضُّ",37,"ض",1,0],["وَإلاّ بَنانُ الرّاجِحي فَإنَّهُ","أَعمُّ مِن الغَيثِ الرُّكامِ وَأكرَمُ",38,"م",1,0],["وإلاّ بكراتٍ مْقيّضات في سنّي","والبِطن ما توقل بليّا زواره",39,"ر",2,0],["والابتسام من علامات الرضا","والثغر سال منه معسول الرضا",40,"ض",2,0],["والأب أصل لابنه","أدنى وأقوى سببا",41,"ب",2,0],["والابتجا فيه بوجهِ القلم","فَضَع على تحريفه وعَلِّم",42,"م",1,0],["والٍ أبان الريا بالسيف عن قمم","بانت وأبطل دين الشح بالكرم",43,"م",1,0],["والأبلج البر الذي أعياده","أبديةٌ ليست بذات زوال",44,"ل",1,0],["والإبل والخيلُ وما لم تصن","أعراقها مفسدةٌ عمري",45,"ر",2,0],["والإبلُ ما محت بأذنابها","رجسٌ كرجس القيء في القدرِ",45,"ر",1,0],["والإبل والباقر عشراهما","له سبيلٌ واضحٌ مهيعُ",46,"ع",1,0],["والأبيضُ الصَّافي البَياضِ قد حكى","ثناء زيني ذَا العَطاءِ المُمْطِرِ",47,"ر",1,0],["والابرشية فيه طاولت زحلاً","قدراً وقد هزأت فخراً بكيوان",48,"ن",1,0],["والّا بْهِيامي يِغْشِم اغشام","وحداني ما لِهْ غيرك ربيع",49,"ع",1,0],["والابتِهَاجُ أتَاكَ يَنفحُ نَشرُهُ","فَانشُق شَذَاهُ وَشُمَّ فَائِحَ عِطرِه",50,"ر",2,0],["والابتدا بالمعنيين جائز","فإن تجد حفظا فأنت الفائز",51,"ز",1,0],["وَإِلّا بَدَت كَالبَدر غُرة قائم","لَهُ هَبَطَت زَهر الكَواكب سُجّدا",52,"د",2,0],["والآبُ فَخَّمَها والإِبنُ كَرَّمَها","والرُوحُ عَظَّمَها في أَمجَدِ الرُتَبِ",53,"ب",1,0],["والابتسام تراه","فتحسب الورد شعرا",54,"ر",2,0],["وَإِلا بَشير عَن فُؤاد مبشري","بجل تَهانينا بِأَكرَم مَولود",55,"د",1,0],["والأبرج الثابتة المكان","نيرة تعلو على كيوان",56,"ن",1,0],["وَالأَب لَما أَثأَتِ الأَيّام مِن دَنفٍ","لا زِلتَ تَرفعُ لِلمَعروفِ بُنيانا",57,"ن",2,0],["والإِبط المنتِن والمطوعه","وهي صناع اليد قل لا صنعه",58,"ه",1,0],["والا بقلبٍ وهو أضعفُ حالَةٍ","كذا رتَّبَ الهادي على كل رَامِقِ",59,"ق",1,0],["والأبيض الماضي بدا أحمرا","يجري على الصيد له مدمع",60,"ع",1,0],["والابن سر أبيه محسوب كما","لا يحسب الدينار إلا عسجدا",61,"د",2,0],["والابن يدعى سر والده ولا","عجب إذا فاق النجيب أباه",62,"ا",2,0],["والأَبيضُ الرَّعافُ يُشبهُ مَدْنَفاً","أَلفَ الضّنى وأَصابَهُ جُرْحٌ صَهي",63,"ه",2,0],["وَإِلّا بِحَقِّ الفاءِ وَالطاءِ بَعدَها","وَحَقِّكَ مَعها أَن تَمُنّ بِعَطفَةِ",64,"ه",1,0],["والأبرقين منزل أنيق","فيه يبين الصاحب الشقيق",65,"ق",1,0],["والابنُ في السبعِ الأوائلِ","قد قيلَ قولاً لا يُرَدّْ",66,"د",1,0],["(والأُبَاةُ الذينَ بالأَمسِ ثارُوا)","بَينَ شَكٍّ بِمَوتِهِ واعتِقَادِ",67,"د",1,0],["والابتهاج ل (قاسمٍ)","بعد التمنع أذعنا",68,"ن",2,0],["وألا بحيآكِ! تنآثرتي","لين إجتمعتي غنآويّه",69,"ي",2,0],["والا بعد في وقت ابن برد بشار","يوم الادب نهرا تطارد اضفافه",70,"ف",2,0],["والأبتر السّهميّ رابعهم","عمرو وكلّ الشرّ فى عمرو",71,"ر",2,0],["والا بشفافية الإحساس إبعدني","أحسن من العيش في داخل متاهاتك",72,"ك",1,0],["والأبُّ غابَ هناكَ في قيدِ الأسى","والطفلُ يرقبُ عودةً حتى طَعَنْ!",73,"ن",1,0],["وَالأُبَاةُ الأَحْرَارُ قَدْ أَشْهَرُوهُ","فِي وُجُوهِ الطُّغَاةِ مِثْلَ السِّنَانِ",74,"ن",1,0],["والأَبْ المَسْكِينْ يَخْزَرْ بَالعِينِينْ، عنْدُو قلبْ حْنِينْ، عِينُو هَمَّالَه","عصْرَ الازدهارْ، فِيه الْبَسْنَا العَار ضيَّعْنَا فيه الدَّارْ، وَاصْبَحْنَا عَاله",75,"ل",2,0],["والابيض الصدق والصدقان","وأنت ابيض الوجه والسيره",76,"ر",2,0],["والابن قد أبهر العقول عقوقه","يا يوم قسطلنا لقد ذهب الرجال",77,"ل",1,0],["والأبجدية في شفاهي أطلقت","ألحانها فاعزف على ناياتي",78,"ت",2,0],["والابتكارُ جَلَالُهُ","في مَعنَى أوَّلِ قَطْفَةِ",79,"ه",1,0],["والأبجدية في أحطّ سجونها","وعلى الحروف عساكر وزناد",80,"د",1,0],["والأبيض الرأي إذا ما شكا","خابطُ ليلٍ رأيهُ الأسودا",81,"د",2,0]]}