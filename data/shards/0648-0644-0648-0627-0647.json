{"poems":[[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[53,"قل للحكيم أبي الحسين ومن جَلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=27421",""],[353,"ولقيت عنتر إذ منيت بفاصد","https://www.aldiwan.net/poem20646.html","الكامل"],[422,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[495,"ونحنُ الموردون شبا العوالي","https://www.aldiwan.net/poem647.html",""],[580,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52120","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28518","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111270","المتقارب"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85199","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[422,"وميضُ البرق هيَّج منك وجدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22245&r=&rc=1",""]],"verses":[["ولو اهْتَبلْتَ الصمتَ إذ زاولتَه","لَحسبْتَ وُدِّيكَ الصَّرِيحَ مُضَيَّحا",0,"ح",2,0],["ولو اهْتَبلْتَ إذ زاولتَه","لَحسبْتَ وُدِّيكَ الصَّرِيحَ مُضَيَّحا",1,"ح",2,0],["وَلَوْ اهتَدَى لِلعِرْقِ لَمْ يَقنَعْ بهِ","إذْ كانَ لا يُرضِيهِ غَيرُ المَقْتَلِ",2,"ل",1,0],["ولو أهديته أخرى لعيني","لأنعمني بل أسدى وأهدى",3,"د",2,0],["وَلَّوا هارِبينَ بِكُلِّ فَجٍّ","كَأَنَّ خُصاهُم قِطَعُ الوِذابِ",4,"ب",1,0],["ولو اهتدَوْا بَعْدَ الضَّلا","لَةِ لاستقالُوا واسْتَقَامُوا",5,"م",3,0],["ولواهب المال الكثي","ر وناهب المال الكثير",6,"ر",1,0],["ولو اهتديت لقلت في","تشبيهها ما يحمد",7,"د",1,0],["وَلَوِ اِهتَدوا لَرَأَوهُما نالا بِهِ","شَرَفاً عَلَى الشَّرَفِ التَّليدِ وَمَفخَرا",8,"ر",2,0],["ولو أهمل الأمة المصطفى","لكان قد اختار إضلالها",9,"ل",3,0],["ولو أهدى إلى الأقمار نورا","لكان لها منن النقصان حصنا",10,"ن",2,0],["ولواه يخفق فوقه كقلوبهم","إذ فارقت من بأسه أبدانها",11,"ن",3,0],["ولو أهديته أخرى لعيني","لأنعمني بما أسدى وأهدى",12,"د",2,0]]}