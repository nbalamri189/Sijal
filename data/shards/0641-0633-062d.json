"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[5906,"إرادة الحُفاة","https://www.poetsgate.com/ViewPoem.aspx?id=193759",""],[5956,"إلهي كيف يأتينا سلام؟","https://www.poetsgate.com/ViewPoem.aspx?id=193459",""],[5956,"امنعوا صنع السلاح","https://www.poetsgate.com/ViewPoem.aspx?id=194893",""],[5957,"ولماذا الساعة لا تعمل؟","https://www.poetsgate.com/ViewPoem.aspx?id=181672",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6125,"يا أوَّل الغيثِ","https://www.poetsgate.com/ViewPoem.aspx?id=210902",""],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""]],"verses":[["فَسُحّي دُموعاً هامِلاتٍ كَأَنَّها","لَها آمِرٌ بِالفَيضِ مِن تَحتِ حاجِبِ",0,"ب",1,0],["فَسَحَّت بِسِمطَي لُؤلُؤٍ خِلطَ إِثمِدِ","عَلى الخَدِّ إِلّا ما تَكُفُّ الأَصابِعُ",1,"ع",1,0],["فَسَحَّت دُموعي في الرِداءِ كَأَنَّه","كُلى مِن شُعَيبٍ ذاتُ سَحٍّ وَتَهتانِ",2,"ن",1,0],["فسحابُ نداكَ هَمَتْ مِنَحاً","وسماءُ ظباك هَمَتْ مَحنَا",3,"ن",2,0],["فَسحابُ الجودِ وكّافُ الحيا","ومَراد العيش مُخْضَرّ النّواح",4,"ح",1,0],["فسح لسلمى بالمراض نجاؤه","بصوب كغرب الناضح المتهزّم",5,"م",1,0],["فَسُحْقاً لِدَارٍ لا يَدُومُ نَعِيمُها","وَتَبَّاً لِخِلٍّ لا يَدُومُ عَلَى الْعَهْدِ",6,"د",1,0],["فَسَحَّت دُموعي في الرِداءِ كَأَنَّها","كُلى مِن شُعَيبٍ ذاتُ سَحٍّ وَتَهتانِ",7,"ن",1,0],["فَسَحُوا صَدْرَهُم لحِكْمِة يُونَا","نَ وآدابِ فارسٍ والهُنُودِ",8,"د",1,0],["فسحقًا لعصر النور سحقًا لأهله","فكلُّ بني حواء دأبهم السلب",9,"ب",1,0],["فسح الدهرُ له حتّى رأى","سِيرابن وأبٍ بعد أب",10,"ب",1,0],["فسحة الأيام ضيق بعد ضيق","وندى البحر حريق في حريق",11,"ق",1,0],["فَسُحقاً لَهُم ما كانَ أَردى عُقولَهُم","أَيَخلُقُ هَذا الخَلقَ رَبّي وَيُهمِلُ",12,"ل",1,0],["فُسحةُ العمرِ وَإِن طالَت قَصيره","فَعَلامَ يُغفلُ المرءُ مَصيره",13,"ر",2,1],["فسَحبانُها في العسر باقلُ عصرِه","وباقِلُها في اليسر بادٍ رُواؤه",14,"ا",3,0],["فَسحت الدَمعَ حَتّى كَفَ مِن عَذلي","مَن كانَ يَعذِلُني مِن خيفة الغَرَق",15,"ق",1,0],["فَسَحابُكَ الرَّهَجُ المثارُ من الوغى","وبروقُكَ الهنديَّةُ المتجالِدَهْ",16,"د",2,0],["فسحت في الصدر حتى لات مُنْفَسَح","وما عليَّ إِذا لم أُلفِ مُنْفَسّحا",17,"ح",2,1],["فَسُحِتَ الناصعُ واغ","تالَ الهزالُ السِّمَنَا",18,"ن",2,0],["فسَحتُمُ في مَضيقِ صدري وأف","صَحتم لساني من طول ما انعجما",19,"م",2,0],["فسِحرُ عَينيهِ عن هاروتَ يسنُدُه","وخطُّ خدّيهِ عن كافورَ يَسطُرُهُ",20,"ر",2,0],["فسحقتَ الجيوشَ تلوَ جيوشٍ","وغدت تحتك الرَّواسي تمور",21,"ر",1,0],["فسحقا اذا أجنى الرجاء وانثني","سليم نزال ظلت فيه عسيبا",22,"ب",2,0],["فسحقا لدهرٍ لم أزل من صروفه","بنائبةٍ في كل يومٍ مروعا",23,"ع",2,0],["فسحابة وطفاء منك تعلّمت","للأرض سقَى تهائم ونجود",24,"د",1,0],["فسحرُ القُدودِ مغاويرُها","وبيضُ المعاطِفِ غيلانُها",25,"ن",3,0],["فسحت إِليه بسيحانه","وذبت عليه بنيرانه",26,"ن",2,1],["فَسَحْتَ لها والنوى غَرْبَةٌ","تضيقُ الرِّحالُ بها والرِّحَل",27,"ل",1,0],["فسحر صوتك بنت ألحان تسكره","وسحر لحظك سيف فيه مغمود",28,"د",1,0],["فسحت دموع العين تبكي لبلدة","بها حرم أمن وفيها المشاعر",29,"ر",1,0],["فَسحِبتُهُ زَهواً كَأَنّي تُبَّعٌ","في حِميرٍ ذو المُلكِ وَالتُبّاعِ",30,"ع",1,0],["فسَحابُ ذاك بنانُه وسحابُ ذا","تسديدُ كلِّ حنيّةٍ مِرْنان",31,"ن",1,0],["فسح الدمع في قلبي","وقلبي دائم الوفد",32,"د",1,0],["فسحيق الأرز في كل يوم","منه للوجه رونق وبهاء",33,"ا",2,0],["فَسُحِّقَ مِضمَدُها وَالجِيَاد","أَغارَت وَقد أَفلَتَت لِلبِلاد",34,"د",1,0],["فسحت ميادين الرهان","وعندها القصبات ترهن",35,"ن",1,0],["فَسُحقاً لِدَهرٍ إِن أَعارَكَ ساعَةً","أَغارَ بِكَفٍّ ذاتِ قَوسٍ وَأَسهُم",36,"م",1,0],["فسحيي شؤوني والمحاجر عندما","ويا حرَّ قلبي دُم كضربة لازبِ",37,"ب",1,0],["فسحَّت عن شوى شُمٍّ ضخامٍ","وكان مذاقها صرفٌ شهادُ",38,"د",1,0],["فسحة من نقاوة الصدق خيرٌ","من قصورحوت شروراً وسجنا",39,"ن",2,0],["فسحقاً للتمني والأماني","وسحقاً للغواني والغناء",40,"ا",2,0],["فسحقاً لكم من أصلع الرأسِ فيكمُ","إلى أصغر القامات يا أفشلَ الورى",41,"ر",2,0],["فسحقا للتكبر ألف سحق","هواء غاص في مجرى الدماء",42,"ا",2,0],["فَسُحقًا لِقَلبٍ يَدقُّ الضلوعَ","................ وَيَهتِفُ يَا أنت- أَنّكَ نِصْفي",43,"ف",2,0],["فسحقاً لها من فرقةٍ ما أضلها","لقد خاب مسعاها وطال عناها",44,"ا",3,0],["فسحقا للذين بغوا عليه","مدى الأيام إن حضروا وغابوا",45,"ب",3,0],["فسحقا لسلطانٍ ظلومٍ إذْ اعتدى","على عترة المختار والذنب يتبع",46,"ع",1,0],["فسحقا لمن مالوا عن الحق للهوى","وسحقا لعُبّادٍ من الجُبت رُكّعوا",46,"ع",3,0],["فسُحقًا للمُتاجِرِ بالبلايا","وبُعدًا للمُجَلبَبِ بالذنوبِ ..",47,"ب",1,0],["فَسحّي دُمُوعاً يَابْنَةَ الْغِلِ في الْهَوَى","فَلَيْسَ يُشَفَّى الْغِلُ إلا بِدَمْعِكِ",48,"ك",1,0],["فسحقا أيها الدنيا لدهر","تساوى الليث فيه والبعير",49,"ر",1,0],["فسُحْقاً لأمْريكا ومَنْ لفَّ لفَّها","وشَدَّ على أيْدي الطَّواغيتِ تنْميرا !",50,"ر",2,0],["فسحر العين يبحرني","سفينا دون ربان",51,"ن",1,0],["فسحبتِها من طوق رافعةٍ لها","ابطاء أمٍ..واندفاع صبية",52,"ي",2,0],["فَسُحقَاً أيُّهَا الأجوَف","فَلَستَ بِصُحبَتِي أجدَر",53,"ر",1,0],["فَسُحقاً لِقومٍ تَعاظَمَ سُخفاً","كَما واستَباحَ فَضاها الدَّجَرْ",54,"ر",1,0],["فسحقاً للخبيثِ ومن رعاه","وسوف أظل غضباناً عليهِ..",55,"ي",2,0],["فَسُحْقاً يا دعاةَ العُنفِ سُحقاً","وسِلْماً للألى لم يصنعوهُ",56,"ع",3,0],["فسحابة روحكَ ماطرة","بالودّ الزاهر ِ لا يبخل",57,"ل",1,0],["فَسَحَابُ مَنْ أرجُو نَدَاهُ وبرقُ مَنْ","أرنُو مَخَايلَ وَمْضِهِ وأَشِيمُ",58,"م",1,0],["فسِحرُكِ الحِلّ ما أحلَلْتِ في كَبِدي","غَيرَ ضِرَامٍ من الأشْواقِ في ذَاتي",59,"ت",2,0],["فسحقاً لي أسبُّ الشرَّ فرداً","ولو ملكت يدي.. فأنا شرورُ",60,"ر",1,0]]}