{"poems":[[91,"وجد الشيخ راحة في القبور","https://www.aldiwan.net/poem44888.html","الخفيف"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[396,"الشيء صعب على من ليس يألفه","https://www.aldiwan.net/poem54600.html","عموديه"],[563,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[563,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[563,"حرك الذت آلة الأسماء","https://www.aldiwan.net/poem34973.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48646","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48546","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82325","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118775","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114219","الخفيف"],[4875,"بدون أطناب","https://www.poetsgate.com/ViewPoem.aspx?id=134440",""],[4623,"إن لي ذنبا عظيما ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146855",""]],"verses":[["وهو خير له وان غضب ال","بعض من الناس من لقاء الحور",0,"ر",1,0],["وَهوَ خطيبُ الأنبيا والوافدين","الجَدُّ والجِدُّ أبٌ للمؤمنين",1,"ن",1,0],["وهو خفيف على شخص تربى به","بل قد يعيش به كالماء للحوت",2,"ت",1,0],["وهو خمرٌ معنى القديم تصفَّى","قبلُ يا كرْمُ كنتَ في شجراتك",3,"ك",1,0],["وهو خالٌ أسودٌ وهو أنا","في سنا طلعتها يشجي الأسود",4,"د",1,0],["وهو خلق لقوله كان أمر ال","لَهِ يعني مقدرات القضاء",5,"ا",2,0],["وهو خيال شاعر ممازح","غاد بمنشور السلام رائح",6,"ح",1,0],["وهو خالٍ من التجارب والقو","وة والعلم والهدى واليقين",7,"ن",1,0],["وَهوَ خارِجٌ عَنِ المَدينَه","لما عَرَفت قَبل ذا تَبيينَه",8,"ه",1,0],["وهو خير الرسل قاطبة","ومزيل الظلم والظلم",9,"م",1,0],["وَهوَ خِدنُ الصِّبيانِ وَهوَ اِبنُ سَبعي","نَ فَماذا يَهوى مِنَ الصِّبيانِ",10,"ن",1,0],["وهو خلعٌ إن يكن طلقها","بفداءٍ أو بشرطِ قطعا",11,"ع",2,0],["وهو خلوُّ لفظه من ناصب","وجازم كالله يهدي عائبي",12,"ي",1,0],["وَهوَ خَزلٌ فِي كَامِلٍ قَد جَرَى يَا","لَيتَهُ لَم يَكمُل فَلَم يَكُ يَجرِي",13,"ي",1,0],["وهو خابر سباع الخلا تشهر الأنياب","ليا صار راع الذود يدّه على خدّه",14,"د",2,0],["وهو خابر الأقراب في حسبة الأجناب","ليا صارت جسور المواصيل منهدّه",14,"د",2,0],["وهو خابر الحطّاب وليا اجتهد حطّاب","ولكن حلاة الزاد في تالي الكدّه",14,"د",2,0],["وهو خير الخلق حقا","قد حبا الفضل العميما",15,"م",2,0]]}