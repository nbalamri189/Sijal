{"poems":[[53,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[63,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[3,"إذا لم أروي صارمي من دم العِدى","https://www.aldiwan.net/poem159.html","الطويل"],[55,"أصبحت أطوع خلق الله كلهم","https://www.aldiwan.net/poem26075.html","البسيط"],[55,"لأعظم حادث حبس الرسول","https://www.aldiwan.net/poem26187.html","الوافر"],[77,"ملكت رسول الله رقي فمن يبرح","https://www.aldiwan.net/poem36636.html","الطويل"],[47,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[72,"نزحت لبين النازحين مدامعي","https://www.aldiwan.net/poem18385.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[70,"يا من تجنن عامدا","https://www.aldiwan.net/poem42436.html","مجزوء الكامل"],[70,"رويدك قد أفنيت يا بين أدمعي","https://www.aldiwan.net/poem42833.html","الطويل"],[85,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[49,"ماذا يريك الزمان من عبره","https://www.aldiwan.net/poem62113.html","المنسرح"],[69,"تعشقت أحوى لي إليه وسائل","https://www.aldiwan.net/poem28802.html","الطويل"],[105,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[50,"وكذبت طرفي عنك والطرف صادق","https://www.aldiwan.net/poem62332.html","الطويل"],[50,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[46,"إذا انفرد الفتى أمنت عليه","https://www.aldiwan.net/poem22903.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[77,"ملكت رسول الله رقي فمن يبرح","https://www.poetsgate.com/ViewPoem.aspx?id=33555",""],[50,"أعَاذِلَ إِن لوْمَكِ في تبَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=17112",""],[124,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[124,"خليلي ما انفك الفؤاد المعذب","https://www.aldiwan.net/poem23754.html","الطويل"],[124,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[143,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[143,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[270,"سلوت بقطع الأمل","https://www.aldiwan.net/poem35043.html","مجزوء المتقارب"],[270,"رأيت الناس في السير الحثيث","https://www.aldiwan.net/poem35177.html","الوافر"],[270,"حياة الناس تقتير وحرص","https://www.aldiwan.net/poem35180.html","الوافر"],[270,"محا لك حسنا مدمع وتسهد","https://www.aldiwan.net/poem35617.html","الطويل"],[270,"قضى الدهر أن أهواك غير ممتع","https://www.aldiwan.net/poem35621.html","الطويل"],[270,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[270,"تصباك ما في النجم من لمعات","https://www.aldiwan.net/poem35636.html","الطويل"],[282,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[320,"أكذب طريفي فيك والطرف صادق","https://www.aldiwan.net/poem61752.html","الطويل"],[353,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[366,"جهادك حكم الله ليس بمصدود","https://www.aldiwan.net/poem17172.html","الطويل"],[402,"ألمت فهاجت لوعة بفؤادي","https://www.aldiwan.net/poem46494.html","الطويل"],[402,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[402,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[406,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[416,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[458,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[464,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[477,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"]],"verses":[["فَلا كُشِفَ الضِياءُ عَلى اللَيالي","وَلا عُدِمَ الغِياثُ وَلا القَوامُ",0,"م",1,0],["فَلا كانَ يَومٌ لا يَدومُ وَفاؤُهُ","فَإِنَّ وَفاءً في الزَمانِ بَديعُ",1,"ع",1,0],["فلا كانَ دَهْرٌ نِلْتُمُ فيهِ ثَرْوَةً","وتبّاً لِدُنيا أنتُمُ رؤَساؤُها",2,"ا",3,0],["فَلا كُحِلَت أَجفانُ عَينَيَّ بِالكَرى","وَلا جاءَني مِن طَيفِ عَبلَةَ مُخبِرُ",3,"ر",1,0],["فَلا كِتابٌ فَدَتكِ النَفسُ يُضحِكُنا","فَقَد أَتانا كِتابٌ مِنكِ أَبكانا",4,"ن",2,0],["فَلا كُتبٌ تُؤَدّي عَنكَ عُذراً","وَلا أَحَدٌ يُؤَدّي ما تَقولُ",5,"ل",1,0],["فلا كانَ لي جَفْنٌ لبُعْدِكَ لمْ يَصُبْ","ولا كانَ لي قَلْبٌ بقُرْبِكَ لمْ يَفْرَحْ",6,"ح",1,0],["فَلا كانَ كَلبُ الرومِ أَرأَفَ مِنكُمُ","وَأَرغَبَ في كَسبِ الثَناءِ المُخَلَّدِ",7,"د",1,0],["فلا كلم الأعداء جانب جاههُ","ودامَ مطاعاً نافذَ الكلمات",8,"ت",1,0],["فلأكن عُوذةً لمجلسك المُو","نِقِ أرْدُد عينَ الردى عمياءَ",9,"ا",2,0],["فلا كُلَفُ التسويد تُحذيه حُظْوةً","ولا مُوَنُ التزويرِ عنه سَواقطُ",10,"ط",1,0],["فلأكن بعضَ منْ غرستَه بين","فضلِ شُكريكَ يا أخا الإفضالِ",11,"ل",1,0],["فَلْأَكُنْ بعضَ مَنْ غرست تَبَيَّن","فضلَ شكريك غير ما إذلالِ",12,"ل",1,0],["فَلَأَكوِيَنَّ جَبينَهُ","وَسماً وَأَقطَعُ أُذنَهُ",13,"ن",2,0],["فَلا كانَ مَن قَد عَرَّفَ البَينَ مَوضِعي","لَقَد كُنتُ مِنهُ في جَنابٍ مُمَنَّعِ",14,"ع",1,0],["فَلا كانَ بانيها وَلا كانَ رَكبُها","وَلا كانَ بَحرٌ ضَمَّها وَحَواها",15,"ا",3,0],["فَلا كُسِيَت تِلكَ السُيوفُ لِزينَةٍ","بَياضَ اللُجَينِ وَاحمِرارَ الحَمائِلِ",16,"ل",1,0],["فَلا كَبيرٌ يَبقى لِكَبرَتِهِ","وَلا صَغيرٌ يَبقى عَلى صِغَرِه",17,"ر",2,0],["فلا كانَ واشٍ كدَّرَ الصفْوَ بيننا","وبغَّضَ تحبيبي إليهِ إليهِ",18,"ي",2,0],["فَلا كَبِدٌ لِطولِ الشَوقِ وَلهى","وَلا قَلبٌ بِنارِ الوَجدِ صالِ",19,"ل",1,0],["فَلا كِبرَتي تَبكي وَلا لَكِ رَحمَةٌ","وَلا عَنكِ إِقصارٌ وَلا فيكِ مَطمَعُ",20,"ع",1,0],["فَلا كانَ الوُشاةُ وَلا الغَيارى","لَعَلَّ العَيشَ يَصفو لِلحِبابِ",21,"ب",1,0],["فَلا كَذِبٌ يُقالُ وَلا نَميمٌ","وَلا غَلَطٌ يُخافُ وَلا غِلاطُ",22,"ط",1,0],["فلا كان سَيْري عنكمُ رأيَ مُلْحِدٍ","يقولُ بيأسٍ مِنْ مَعادٍ ومَرْجِع",23,"ع",1,0],["فلا كان لي جفن لبعدكم لم يصب","ولا كان لي قلب بقربك لم يفرح",24,"ح",1,0],["فلاَ كان الْوُشاة ُ ولا الْغَيَارى","لَعَلَّ الْعيشَ يَصْفُوا للحِبَاب",25,"ب",1,0],["فلا كلأ ولا ملأ","ولا ماء ولا عشب",26,"ب",1,0],["فلا كان من قلب إذا قلت قد سلا","تنازعنه الأشواق حتى يكذب",27,"ب",1,0],["فلا كؤوس ولا ساق ولا وتر","يشنف اليوم وا ويلاه آذاني",28,"ي",1,0],["فَلَأَكسُوَنَّ عُلاكَ مِن حَبَراتِهِ","حُلَلَ المُلوكِ وَحِليَةَ الآدابِ",29,"ب",1,0],["فَلاكَهُمُ السَيفُ الَّذي الحَقُّ ضارِبٌ","بِهِ مَن طَغى بَغياً وَلا خَوِرَ العَضدُ",30,"د",1,0],["فلا كان ذاكَ الهوى","ولا كان هذا المَلل",31,"ل",1,0],["فلا كانت ولا كانوا جميعاً","وهذا النسلُ من لوطٍ وشيث",32,"ث",1,0],["فلا كان الوجودُ لمثلِ هذا","وللأعراضِ والآدابِ رخص",33,"ص",1,0],["فلا كان نأيٌ قصَّرَ العمر طوله","وفيهِ المُنى والحبُّ والعزمُ تنفد",34,"د",1,0],["فلا كان يومٌ قيلَ في صُبحهِ قَضى","عميدٌ فأنسُ الدّارِ وحشةُ بَلقَع",35,"ع",1,0],["فلا كان هذا الكونُ خلقاً وصدفةً","لأنَّ قيامَ الكونِ بالمعدَنِ الأصفَر",36,"ر",1,0],["فلا كانَ هذا آخرَ العَهدِ بَيننا","ولي عبراتٌ سِلنَ من نظرات",37,"ت",1,0],["فَلا كانَ نورُكُما ساعَةً","عَنِ الناسِ في الدَهرِ بِالآفِلِ",38,"ل",1,0],["فلا كل من يصبو يمد مهورها","وماهى إلا في تناول ميسان",39,"ن",1,0],["فَلا كَبِدي تُبلى وَلا لَكَ رَحمَةً","وَلا عاذِلي يَوماً عَنِ اللَومِ يَرجِعُ",40,"ع",1,0],["فَلا كَالثغر مِنها شمت ميماً","وَلا كَالطرّة الحَسناء سينا",41,"ن",2,0],["فَلا كانَ دَهرٌ بِالعُلا غَيرَ شاهِدٍ","لَكُم وَزَمانٌ مِنكُمُ غَيرَ مَشهودِ",42,"د",1,0],["فلا كانتِ الأمداحُ مِن شافعٍ ولا","جَرى قلمٌ في كتبها بمدادِ",43,"د",1,0],["فلا كُنتُ إن مَلَّكتُ يوماً يدَ الهوى","زِمَامي وأعْطَيتُ الصَّبابةَ مِقْودي",44,"د",2,0],["فلاَ كَانَ مِنْ دَهْرٍ بهِ قَد تَسوَّدت","على الأسْدِ في آجامهنّ ثعالبُهْ",45,"ب",2,0],["فلأكسونَّهُم المَدائِحَ مِثلَ ما","قَد البَسوني مِن نَوالٍ مُقِثبِ",46,"ب",1,0],["فلا كنامق والٍ للعراق ولا","كمثل عبد العزيز اليوم سلطانا",47,"ن",2,0],["فلا كانَ يا شمسَ الزمانِ وبَدْرَهُ","لسعدِك من بعدِ الطلوعِ مَغيبُ",48,"ب",1,0],["فلأكسونهما ولستُ بمائنٍ","حللاً تفوق الدرّ في تنضيده",49,"د",2,0],["فلا كان قلبي كيف يصبرُ بعدما","تناءتْ وسارَ الواخداتُ بها عَشْرا",50,"ر",2,0]]}