an/poem/76486","المتقارب"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45952","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45990","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102744","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136640",""],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127931","الوافر"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116048","الكامل"],[4728,"على الدوح يا طيرٍ تغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=176967",""],[4755,"نَبِيُّ المَجَانِين","https://www.poetsgate.com/ViewPoem.aspx?id=184571",""],[4930,"إلى العلم","https://www.poetsgate.com/ViewPoem.aspx?id=212929",""],[4935,"لئام الناس أيديها","https://www.poetsgate.com/ViewPoem.aspx?id=129368",""],[5046,"إلى مغرور","https://www.poetsgate.com/ViewPoem.aspx?id=198459",""],[5064,"سلامٌ عليّ","https://www.poetsgate.com/ViewPoem.aspx?id=199129",""],[5077,"إلى أعداء النّجاح مع التّحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=37250",""],[3591,"أحنُّ على شطِ المزار إلى مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=149379",""],[5277,"تباريحٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=202456",""],[5300,"ذكرت فراقا والتفرّق يصدع","https://www.poetsgate.com/ViewPoem.aspx?id=200452",""],[5382,"أعيش كأنّى","https://www.poetsgate.com/ViewPoem.aspx?id=211405",""],[5431,"هو الحب شطرنجٌ حصان وبيدق","https://www.poetsgate.com/ViewPoem.aspx?id=197760",""],[5563,"أحلى الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=213091",""],[5595,"نعلّمُ جيلنا الكتبا","https://www.poetsgate.com/ViewPoem.aspx?id=158559",""],[5829,"ونرجوا في أماسينا سرورا","https://www.poetsgate.com/ViewPoem.aspx?id=165997",""],[5952,"أقيموا على أخلاقنا اليوم مأتما","https://www.poetsgate.com/ViewPoem.aspx?id=197109",""],[5975,"تركت لنا الدنيا ..","https://www.poetsgate.com/ViewPoem.aspx?id=53292",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""]],"verses":[["فَلا كُشِفَ الضِياءُ عَلى اللَيالي","وَلا عُدِمَ الغِياثُ وَلا القَوامُ",0,"م",1,0],["فَلا كانَ يَومٌ لا يَدومُ وَفاؤُهُ","فَإِنَّ وَفاءً في الزَمانِ بَديعُ",1,"ع",1,0],["فلا كانَ دَهْرٌ نِلْتُمُ فيهِ ثَرْوَةً","وتبّاً لِدُنيا أنتُمُ رؤَساؤُها",2,"ا",3,0],["فَلا كُحِلَت أَجفانُ عَينَيَّ بِالكَرى","وَلا جاءَني مِن طَيفِ عَبلَةَ مُخبِرُ",3,"ر",1,0],["فَلا كِتابٌ فَدَتكِ النَفسُ يُضحِكُنا","فَقَد أَتانا كِتابٌ مِنكِ أَبكانا",4,"ن",2,0],["فَلا كُتبٌ تُؤَدّي عَنكَ عُذراً","وَلا أَحَدٌ يُؤَدّي ما تَقولُ",5,"ل",1,0],["فلا كانَ لي جَفْنٌ لبُعْدِكَ لمْ يَصُبْ","ولا كانَ لي قَلْبٌ بقُرْبِكَ لمْ يَفْرَحْ",6,"ح",1,0],["فَلا كانَ كَلبُ الرومِ أَرأَفَ مِنكُمُ","وَأَرغَبَ في كَسبِ الثَناءِ المُخَلَّدِ",7,"د",1,0],["فلا كلم الأعداء جانب جاههُ","ودامَ مطاعاً نافذَ الكلمات",8,"ت",1,0],["فلأكن عُوذةً لمجلسك المُو","نِقِ أرْدُد عينَ الردى عمياءَ",9,"ا",2,0],["فلا كُلَفُ التسويد تُحذيه حُظْوةً","ولا مُوَنُ التزويرِ عنه سَواقطُ",10,"ط",1,0],["فلأكن بعضَ منْ غرستَه بين","فضلِ شُكريكَ يا أخا الإفضالِ",11,"ل",1,0],["فَلْأَكُنْ بعضَ مَنْ غرست تَبَيَّن","فضلَ شكريك غير ما إذلالِ",12,"ل",1,0],["فَلَأَكوِيَنَّ جَبينَهُ","وَسماً وَأَقطَعُ أُذنَهُ",13,"ن",2,0],["فَلا كانَ مَن قَد عَرَّفَ البَينَ مَوضِعي","لَقَد كُنتُ مِنهُ في جَنابٍ مُمَنَّعِ",14,"ع",1,0],["فَلا كانَ بانيها وَلا كانَ رَكبُها","وَلا كانَ بَحرٌ ضَمَّها وَحَواها",15,"ا",3,0],["فَلا كُسِيَت تِلكَ السُيوفُ لِزينَةٍ","بَياضَ اللُجَينِ وَاحمِرارَ الحَمائِلِ",16,"ل",1,0],["فَلا كَبيرٌ يَبقى لِكَبرَتِهِ","وَلا صَغيرٌ يَبقى عَلى صِغَرِه",17,"ر",2,0],["فلا كانَ واشٍ كدَّرَ الصفْوَ بيننا","وبغَّضَ تحبيبي إليهِ إليهِ",18,"ي",2,0],["فَلا كَبِدٌ لِطولِ الشَوقِ وَلهى","وَلا قَلبٌ بِنارِ الوَجدِ صالِ",19,"ل",1,0],["فَلا كِبرَتي تَبكي وَلا لَكِ رَحمَةٌ","وَلا عَنكِ إِقصارٌ وَلا فيكِ مَطمَعُ",20,"ع",1,0],["فَلا كانَ الوُشاةُ وَلا الغَيارى","لَعَلَّ العَيشَ يَصفو لِلحِبابِ",21,"ب",1,0],["فَلا كَذِبٌ يُقالُ وَلا نَميمٌ","وَلا غَلَطٌ يُخافُ وَلا غِلاطُ",22,"ط",1,0],["فلا كان سَيْري عنكمُ رأيَ مُلْحِدٍ","يقولُ بيأسٍ مِنْ مَعادٍ ومَرْجِع",23,"ع",1,0],["فلا كمال لمخلوق وليس به","وانما فاض منه الفيض للفطر",24,"ر",1,0],["فلا كان لي جفن لبعدكم لم يصب","ولا كان لي قلب بقربك لم يفرح",25,"ح",1,0],["فلاَ كان الْوُشاة ُ ولا الْغَيَارى","لَعَلَّ الْعيشَ يَصْفُوا للحِبَاب",26,"ب",1,0],["فلا كلأ ولا ملأ","ولا ماء ولا عشب",27,"ب",1,0],["فلا كان من قلب إذا قلت قد سلا","تنازعنه الأشواق حتى يكذب",28,"ب",1,0],["فلا كؤوس ولا ساق ولا وتر","يشنف اليوم وا ويلاه آذاني",29,"ن",2,0],["فَلَأَكسُوَنَّ عُلاكَ مِن حَبَراتِهِ","حُلَلَ المُلوكِ وَحِليَةَ الآدابِ",30,"ب",1,0],["فَلاكَهُمُ السَيفُ الَّذي الحَقُّ ضارِبٌ","بِهِ مَن طَغى بَغياً وَلا خَوِرَ العَضدُ",31,"د",1,0],["فلا كان ذاكَ الهوى","ولا كان هذا المَلل",32,"ل",1,0],["فلا كانت ولا كانوا جميعاً","وهذا النسلُ من لوطٍ وشيث",33,"ث",1,0],["فلا كان الوجودُ لمثلِ هذا","وللأعراضِ والآدابِ رخص",34,"ص",1,0],["فلا كان نأيٌ قصَّرَ العمر طوله","وفيهِ المُنى والحبُّ والعزمُ تنفد",35,"د",1,0],["فلا كان يومٌ قيلَ في صُبحهِ قَضى","عميدٌ فأنسُ الدّارِ وحشةُ بَلقَع",36,"ع",1,0],["فلا كان هذا الكونُ خلقاً وصدفةً","لأنَّ قيامَ الكونِ بالمعدَنِ الأصفَر",37,"ر",1,0],["فلا كانَ هذا آخرَ العَهدِ بَيننا","ولي عبراتٌ سِلنَ من نظرات",38,"ت",1,0],["فَلا كانَ نورُكُما ساعَةً","عَنِ الناسِ في الدَهرِ بِالآفِلِ",39,"ل",1,0],["فلا كل من يصبو يمد مهورها","وماهى إلا في تناول ميسان",40,"ن",1,0],["فَلا كَبِدي تُبلى وَلا لَكَ رَحمَةً","وَلا عاذِلي يَوماً عَنِ اللَومِ يَرجِعُ",41,"ع",1,0],["فَلا كَالثغر مِنها شمت ميماً","وَلا كَالطرّة الحَسناء سينا",42,"ن",2,0],["فَلا كانَ دَهرٌ بِالعُلا غَيرَ شاهِدٍ","لَكُم وَزَمانٌ مِنكُمُ غَيرَ مَشهودِ",43,"د",1,0],["فلا كانتِ الأمداحُ مِن شافعٍ ولا","جَرى قلمٌ في كتبها بمدادِ",44,"د",1,0],["فلا كُنتُ إن مَلَّكتُ يوماً يدَ الهوى","زِمَامي وأعْطَيتُ الصَّبابةَ مِقْودي",45,"د",2,0],["فلاَ كَانَ مِنْ دَهْرٍ بهِ قَد تَسوَّدت","على الأسْدِ في آجامهنّ ثعالبُهْ",46,"ب",2,0],["فلأكسونَّهُم المَدائِحَ مِثلَ ما","قَد البَسوني مِن نَوالٍ مُقِثبِ",47,"ب",1,0],["فلا كنامق والٍ للعراق ولا","كمثل عبد العزيز اليوم سلطانا",48,"ن",2,0],["فلا كانَ يا شمسَ الزمانِ وبَدْرَهُ","لسعدِك من بعدِ الطلوعِ مَغيبُ",49,"ب",1,0],["فلأكسونهما ولستُ بمائنٍ","حللاً تفوق الدرّ في تنضيده",50,"د",2,0],["فلا كان قلبي كيف يصبرُ بعدما","تناءتْ وسارَ الواخداتُ بها عَشْرا",51,"ر",2,0],["فلا كان لهذا الذن","بِ عند القومِ غُفرانُ",52,"ن",1,0],["فَلا كانَ حَبسُ الطَمث أَودى بِجسمها","إِلى ذات جَنب فيهِ عزَّ دواها",53,"ا",3,0],["فَلا كانَ يَوم فيهِ أَحرقت مُهجَتي","بِحُبِّ فَتاةٍ أَو بِحُبِّ غُلام",54,"م",1,0],["فَلا كانَ يَومٌ سار عَنها ركابُه","وَواراه عَنها جَندل وَتُراب",55,"ب",1,0],["فلا كانَ يَوم فيهِ ضاقَت لِنَعيِها","بِكُل مَكان وَاسِعاتُ صُدور",56,"ر",1,0],["فَلا كانَ يَوم فاز فيهِ بِخدمة","وَقُوبِلَ مَع أَمثاله بِالرَغائب",57,"ب",1,0],["فَلا كانَ لَقَد رَمانا","بِسَهم صدودِه مِن بَعد وَصل",58,"ل",1,0],["فَلا كُنت قُلت الشعر إِن لَم أَكن بِهِ","أَمزِّق ذاكَ العَرضَ كُلَّ ممزَّق",59,"ق",1,0],["فلا كانت نفوسٌ ب","عصا الذلّة مَخْبوطه",60,"ط",2,0],["فَلا كَهفَ يَحميهِم وَلا حصنَ حافظٌ","وَلا خِدنَ يؤويهم ولا خِلَّ صاحِبُ",61,"ب",1,0],["فلا كسفت شمس جثمانه","وإحسانه من سما السؤدد",62,"د",1,0],["فَلا كَبِدي تَبلى وَلا لَكِ رَحمَةٌ","وَلا عَنكِ إِقصارٌ وَلا فيكِ مَطمَعُ",63,"ع",1,0],["فَلا كوفَةٌ أُمّي وَلا بَصرَةٌ أَبي","وَلا أَنا يثنيني عَنِ الرِّحلَةِ الكَسَل",64,"ل",1,1],["فلا كتب أسامرها","أذا ما شاقني السمر",65,"ر",1,0],["فلا كانت الدنيا ولا كان آدم","ولا كان عيش ظلمة الموت عقباه",66,"ا",2,0],["فلا كفَّ إلا فيه منك مواهب","ولا قلبَ إِلا وهو إيّاك ذاكرُ",67,"ر",1,0],["فلا كان للاحداثِ نحو مذهبُ","ولا فات عن أقصى مَرامِك مَطلب",68,"ب",1,0],["فَلا كَعُيون يَوم ذلِكَ أَعيُن","وَلا كَقُلوب يَوم ذاكَ قُلوب",69,"ب",1,0],["فلا كان التلبس والرياءُ","يظلّلها الكمال اذا تثنت",70,"ت",1,0],["فلاكتم السر المصون بمهجتي","حتى اموت فينطوي ذاك الخبر",71,"ر",1,0],["فَلاَ كَمَدِي يَفْنَى وَلاَ لَكَ رِقَّةٌ","وَلاَ عَنْكِ إقْصَارٌ وَلاَ فِيكِ مَطْمَعُ",72,"ع",1,0],["فلا كبير سطا عليّ ولا","يد لها منة على عنقي",73,"ق",2,0],["فلا كان يومٌ أرقلت بعليّه","ركابُ المنايا للمقابر تذهب",74,"ب",1,0],["فَلأَ كتُبنَّ بخطِّ كَفَّى طائعاً","ولأعْتِبَنَّ لئن سَلِمتِ العاتباَ",75,"ب",2,0],["فلا كانت الدنيا إذا لم يعاينوا","هم القصد في أولى المشوق وأخراه",76,"ه",1,0],["فَلأكسوَنَّكَ مِن بَدائع مَنطِقي","حُلَلاً مُطَرَزَةً بتبر ثَناء",77,"ا",2,0],["فلا كنّي أشيّد بالمحبّه","إذا كانت روابطها قويّه",78,"ي",2,0],["فلا كنّ الشجاع اللّي امجرب","تصرّعه المباسم والدّعيّه",78,"ي",2,0],["فلاكنّي بحوري في المعاني","غميجه والمواهب ألمعيّه",78,"ي",2,0],["فلاك فسرها الأئمة أنه","نظر الى الرب العظيم الشان",79,"ن",1,0],["فَلا كانَ وَعدُهُم ما أَغَث","ثَ فيهِ المِطالُ وَما أَبرَدا",80,"د",2,0],["فَلا كَتقيهم أَبَداً كَمالاً","وَلا كَمحمد أَبَداً سَخاءا",81,"ا",3,0],["فلا كان لي مال ولا زلت معدماً","فأحسن من بخل على الناس إقلالي",82,"ل",2,0],["فلا كبدي تهدأ ولا لك رحمةٌ","ولا عنك إقصاء ولا فيك مطمعُ",83,"ع",1,0],["فلا كان يومٌ لستَ في صدره ضُحىً","ولا كان ليلٌ لستَ في عَجْزه فجرا",84,"ر",2,0],["فلا كيف أمسيتَ فوقَ التُّرابِ","ولا كيف أصبحتَ تحت الصَّخَر",85,"ر",1,0],["فلا كنت يا سلمى غذ لم تصدني","زواجره عن كل إِثم وزلة",86,"ه",1,0],["فلا كان يوم قام ناعيةٌ إنه","لا شأم يوم في الزمان وأنكد",87,"د",1,0],["فلا كقريضي ما رقشّا","ولا كخيالي ما نقشّا",88,"ش",2,0],["فَلا كِفلَ إِلّا مِثلُ كِفلٍ رَأيتُهُ","لِخَولَةَ لَو كانَت مِراراً تَخَلَّفُ",89,"ف",1,0],["فلا كان يوم كان آخر عهدكم","وقد أسرع الحادي سحيراً وسرتم",90,"م",1,0],["فَلا كانَ الجوى أَو كان بَيني","وَبَينَ عَقائِر الناعين سدُّ",91,"د",1,0],["فلا كنتُ من دهرٍ مؤمَّلُ أهلِهِ","يقولُ لمهدي الحمدِ كيفَ يَبيعُ",92,"ع",1,0],["فلا كانت الأموال إن لم تكن","سوى قيود بأعناق الرجال وأغلال",93,"ل",1,0],["فلا كانَ سِنٌّ مالهُ الظُفرُ قارعٌ","عليهِ ولا خَدٌّ وما الكفُّ لاظمُه",94,"م",2,0],["فلا كان في غير الرسول ورهطه","اولي الأمر لي مدح ولا قدر الأمر",95,"ر",1,0],["فَلا كانَت أَمانيها الخَوالي","لَقَد أَبدى النَعيم بِها شقاها",96,"ا",3,0],["فَلا كانَ قَلبٌ لَيسَ يَرتاحُ لِلهَوى","وَلا كانَ طَيفٌ بِالكَرى بَعدك اكتحل",97,"ل",1,0],["فلا كاذب إن قلت هذا مُلعَّبٌ","ولا كاذب إن قلتَ ذاكَ المُلَعِّبُ",98,"ب",1,0],["فلا كنتُ إن لم أكن وافياً","ولا عشت إن ضاع فيّ الرجاء",99,"ا",2,0],["فلا كان تشتيت شمل الحمى","ولا السفن كانت ولا الأبح