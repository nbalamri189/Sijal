n.net/poem3014.html","السريع"],[575,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"]],"verses":[["فَالمَرءُ يَسرَحُ في الآفاقِ مُضطَرِباً","وَنَفسُهُ أَبَداً تَهفو إِلى الوَطَنِ",0,"ن",1,0],["فَالمَنطِقُ الطاهِرُ ما بَينَنا","مُتَرجِمٌ وَالنَظَرُ الفاسِقُ",1,"ق",1,0],["فَالمَجْدُ في صَهَواتِ الخَيْلِ مَطلَبُهُ","وَالعِزُّ في ظُبَةِ الصَّمْصامَةِ الخَذِمِ",2,"م",1,0],["فالمجْدُ يأنَفُ أن يُقَرِّظَ باقِلٌ","أربابَهُ ولَدَيهِمُ سَحْبانُ",3,"ن",1,0],["فالمُقْرَباتُ خَواشِعٌ أبصارُها","مِيلُ الرُّؤوسِ صَليلُهُنَّ بُكاءُ",4,"ا",2,0],["فَالمَوتُ لا يُنجيكَ مِن آفاتِهِ","حِصنٌ وَلَو شَيَّدتَهُ بِالجَندَلِ",5,"ل",1,0],["فَالْمُلْكُ أَنْتَ عِمَادُهُ وَعَتَادُهُ","وَالدِّينُ أَنْتَ مَلاَذُهُ وَمَقِيلُهُ",6,"ل",2,0],["فَأَلَمَّ مِن أَهلِ البُوَيبِ خَيالُها","بِمُعَرَّسٍ مِن أَهلِ ذي ذَروانِ",7,"ن",1,0],["فالمسيء غيرهما","ما إليه متصل",8,"ل",1,0],["فَالمُبْتَلَى فِي حُلُمِ مُوهِنٍ","مُوهٍ يَكِلُّ العَزْمَ عَنْ صَدِّهِ",9,"د",2,0],["فالمفاخر عن تروا","والمكارم عن تنقل",10,"ل",1,0],["فالمجد يدرك مرماه البعيد فتىً","رحب الذراعَين طلق الكف مفضال",11,"ل",1,0],["فالمجد يَنبُت حيث العلم منتشِر","من حيث تعترك الأبطال والبُهم",12,"م",1,0],["فالمجد ليس يناله","إلا المخاطر في طِلابه",13,"ب",2,0],["فالمعالي أودعت في الكتب","كاللآلي أودعت في الصَدَف",14,"ف",1,0],["فالمجد مَأثور بكل صراحة","عن قَيْسها أبداً وعن قحطانها",15,"ن",3,0],["فالمواعيد التي قد وعدوا","كلها منهم خداع واحتيال",16,"ل",1,0],["فَالماءُ يَجلو مُتونَهُنَّ كَما","يَجلو التَلاميذُ لُؤلُؤاً قَشِبا",17,"ب",2,0],["فَالمَرجِ مَرجِ الصُفَّرَينِ فَجاسِمٍ","فَدِيارِ سَلمى دُرَّساً لَم تُحلَلِ",18,"ل",1,0],["فالمنسر الأشفى بحال جيما","والعين تجلى بالنضارِ ميما",19,"م",2,0],["فَالميمُ يُفتَحُ أَعلاهُ وَأَسفَلُهُ","وَالعَينُ يُفتَحُ أَقصاهُ وَأَدناهُ",20,"ه",1,0],["فالملْك في روضَةٍ منكمْ وفي عُرُسٍ","والدين في جُمْعَةٍ منكم وفي عِيدِ",21,"د",1,0],["فالموت يستبقي الذي","تُبلي الحياة من الأمور",22,"ر",1,0],["فالموتُ والموتُ لا شيءٌ يغالبُهُ","ما زال يتبع ما يجري به القلمُ",23,"م",1,0],["فالمُجتبى مُجتبىً في كلِّ ناحيةٍ","كانتْ مناهبَ والديوان ديوان",24,"ن",1,0],["فَالمُسلِمونَ بِخَيرٍ ما بَقيتَ لَهُم","وَلَيسَ بَعدَكَ خَيرٌ حينَ تُفتَقَدُ",25,"د",1,0],["فالمرءُ قد ينسى المُسيءَ","المفترَى ، والمُحسنا",26,"ن",2,0],["فالمَوتُ وَالعَيشُ بيُمناك قَد","صرّفت أَسيافاً وَأَقلاما",27,"م",2,0],["فآلمني حتى شكوت عناقه","وحتى كأن الوصل شر من الهجر",28,"ر",1,0],["فالممت فيها بالرسوم دوارسا","وساءلت منهن الطلول بواليا",29,"ي",2,0],["فَالمَوتُ أَعذَرُ لي وَالصَبرُ أَجمَلُ بي","وَالبَرُّ أَوسَعُ وَالدُنيا لِمَن غَلَبا",30,"ب",2,0],["فَالمَوتُ تُعرَفُ بِالصِفاتِ طِباعُهُ","لَم تَلقَ خَلقاً ذاقَ مَوتاً آيِبا",31,"ب",2,0],["فالمدحُ مختارٌ ومنتخَبٌ","والشكرُ معتامٌ ومنتخَلُ",32,"ل",1,0],["فالمِسكُ في هامةِ الجبَّارِ موطِئُهُ","لِطيبهِ وهو منسوبٌ إِلى الفَارِ",33,"ر",1,0],["فالمجدُ في حِضنيكَ معتقلٌ","والمالُ من كفَّيكَ منتهَبُ",34,"ب",1,0],["فالماءُ خمرٌ تُجْتَلَى","والماءُ مسكٌ مُنْتَهَبْ",35,"ب",1,0],["فَالمُلكُ فيهِ وَفي بَنيهِ","ما بَقِيَ اللَيلُ وَالنَهارُ",36,"ر",1,0],["فَالمَنَّ فيكَ وَفي مَجيئِكَ سالِماً","لِلَّهِ ثُمَّ القائِمِ المُتَوَكِّلِ",37,"ل",1,0],["فَالمَجدُ يَعلَمُ أَنَّكُم لَم تُقصِروا","إِلّا عَلى سَبقٍ إِلَيهِ مُبينِ",38,"ن",1,0],["فَالمَوتُ أَروَحُ مِن حَياةٍ هاكَذا","إِن أَنتِ مِنكِ بِنائِلٍ لَم تُنعِمي",39,"ي",1,0],["فالمجدُ عَندَهما ضَحوكٌ مُسفِرٌ","والنسلُ بينَهما مُعِمٌّ مُخوِلُ",40,"ل",1,0],["فالمُلْكُ مُبتَسِمٌ والأَمرُ مُنتَظِمٌ","والدَّهرُ من دولةِ الأَوغادِ يَعتَذِرُ",41,"ر",1,0],["فالمَجدُ منه عُلىً مقرونةٌ بِعُلىً","والجُودُ منه يدٌ موصولةٌ بيدِ",42,"د",1,0],["فالمسكُ مهجورٌ إذا صُفِّقَتْ","في الكاس والكافورُ مَسبوبُ",43,"ب",1,0],["فَالمَرءُ يَبسُطُها وَالدَهرُ يَقبُضُها","وَالنَفسُ تَنشُرُها وَالمَوتُ يَطويها",44,"ي",3,0],["فَالمَرءُ لا يَصحَبُهُ","في القَبرِ إِلّا عَمَلُه",45,"ل",2,0],["فَالمَرءُ مَطلوبٌ بِمُهجَةِ نَفسِهِ","طَلَباً يُصَرِّفُ حالَهُ أَحوالا",46,"ل",2,0],["فَالمالُ مِن حِلِّهِ قِوامٌ","لِلعِرضِ وَالوَجهِ وَاللِسانِ",47,"ن",1,0],["فَالمَرءُ يُهدي عَلى مِقدارِ قُدرَتِهِ","وَالنَملُ يُعذَرُ في القَدرِ الَّذي حَمَلا",48,"ل",2,0],["فَالمَزاميرُ في دُجاهُ زُمورٌ","وَالمَثاني مَثالِثٌ وَمَثاني",49,"ن",2,0],["فَالمُستَفادُ مِنَ الأَيّامِ مُرتَجَعٌ","وَالمُستَعارُ مِنَ الأَعمارِ مَردودُ",50,"د",1,0],["فَأَلَمَّ بي طَوعاً وَباتَ لِساعِدي","مُتَوَسِّدا وَفِراشُهُ الأَعضاءُ",51,"ا",2,0],["فَالمالُ مُكتَسَبٌ عَلى طولِ المَدى","وَالذِكرُ يُنجِدُ في البِلادِ وَيُتهِمُ",52,"م",1,0],["فَالمَرءُ يُرزَقُ ما يَشا","ءُ مِنَ الزَمانِ وَيُرزَأُ",53,"ا",1,0],["فالمحسنون تَزَيّدوا أعمالهمْ","وَرَجَوْا بذلك جَنّةً وحريرا",54,"ر",2,0],["فالملك بينهما حديثٌ حُسْنُهُ","قَطَعَتْ لياليَها به السُّمّارُ",55,"ر",1,0],["فَالماءُ لَيسَ عَجيباً أَنَّ أَعذَبَهُ","يَفنى وَيَمتَدُّ عُمرُ الآجِنِ الأَسِنِ",56,"ن",1,0],["فَالمَجدُ طَوعُكَ ما تَعدوكَ هِمَّتُهُ","أَكُنتَ مُهتَضِماً أَو كُنتَ مُهتَضَما",57,"م",2,0],["فَالمَجدُ لا يَرضى بِأَن تَرضى بِأَن","يَرضى اِمرُؤٌ يَرجوكَ إِلّا بِالرِضا",58,"ض",2,0],["فَالمَشيُ هَمسٌ وَالنِداءُ إِشارَةٌ","خَوفَ اِنتِقامِكَ وَالحَديثُ سِرارُ",59,"ر",1,0],["فَالمالُ أَنّي مِلتَ لَيسَ بِسالِمٍ","مِن بَطشِ جودِكَ مُصلِحاً أَو مُفسِدا",60,"د",2,0],["فَالمَحَلُّ الَّذي حَلَلتِ بِهِ وَال","حُسنُ أَبدى عَلَيكَ ما كُنتُ أَكمي",61,"ي",1,0],["فَالمَجدُ مَمطورُ جَنابِ المُنى","وَالمُلكُ خَفّاقُ جَناحِ النَجاح",62,"ح",1,0],["فَأَلمِم عَلى لَيلى فَإِنَّ تَحيَّةً","لَها قَبلَ نِصِّ الناعِجاتِ قَليلُ",63,"ل",1,0],["فَالمِسكُ يَروي الطيبَ عَن مِسكِ الصَبا","عَن أَكؤُسِ الجِريالِ عَن أَنفاسِهِ",64,"س",2,0],["فَالمُلكُ مِنكَ خَصيبُ أَشجارِ المُنى","يَقظانُ عَينِ السَعدِ مَشدودُ العُرى",65,"ر",2,0],["فالمدحُ مثلُ القدحِ تض","مَنُهُ لهم خُضْرٌ وحمر",66,"ر",1,0],["فالمستقيم أخو الكَرَامَةِ عندَهُ","لا كلُّ مَنْ رَكِبَ الأُسودَ بأسْوَدِ",67,"د",1,0],["فَالمَسجِدُ الجامِعُ المُروأَةِ وَال","دينِ عَفا فَالصِحانُ فَالرَحَبُ",68,"ب",1,0],["فَالمُستَعانُ اللَهُ في طَلَبي","مَن لَستُ أُدرِكُهُ عَنِ الطَلَبِ",69,"ب",1,0],["فَالمَوتُ أَن يُزرى عَلى عاشِقٍ","يُقالُ قَد كانَ وَلَكِن سَلا",70,"ل",2,0],["فالمجرمونُ وقايةٌ","للمسلمينَ من الجحيم",71,"م",1,0],["فالمشركون وقايةٌ","للمسلمينَ من العذابِ",72,"ب",1,0],["فَالمَرءُ يَقعُدُ بِالمَك