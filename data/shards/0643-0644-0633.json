{"poems":[[95,"هذا أديب العرب","https://www.aldiwan.net/poem9794.html","عموديه"],[74,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[93,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[63,"أنخت في حانة أترجة","https://www.aldiwan.net/poem51730.html","السريع"],[46,"الحسن جزء من وجهك الحسن","https://www.aldiwan.net/poem30092.html","المنسرح"],[69,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[50,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[69,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[93,"سقوط بورت ارثور","https://www.poetsgate.com/ViewPoem.aspx?id=53022",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[119,"رفعتني بال بيت الرفاعي","https://www.aldiwan.net/poem41116.html","عموديه"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[178,"يوم أتى بديمة هطالة","https://www.aldiwan.net/poem46066.html","الرجز"],[215,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[228,"كل سعد يبنى على شقوة الغير","https://www.aldiwan.net/poem41915.html","الخفيف"],[234,"كل سيوف الموت عضب حسام","https://www.aldiwan.net/poem50782.html","السريع"],[261,"أوجع دماغا القرع بالسلقِ","https://www.aldiwan.net/poem48457.html","السريع"],[264,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[287,"كل سقام زال عن سنقر","https://www.aldiwan.net/poem32779.html","السريع"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[438,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[438,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[449,"اشرح الصدر للمحاسن طرا","https://www.aldiwan.net/poem55920.html","عموديه"],[458,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[463,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[469,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[469,"شب نار الأحشاء ماء البكاء","https://www.aldiwan.net/poem3437.html","عموديه"],[484,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[572,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[580,"نثر الدهر عقد ثغر حبيبي","https://www.aldiwan.net/poem2944.html","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103082","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88610","الخفيف"],[755,"","https://poetry.dctabudhabi.ae/diwan/poem/121046","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53943","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70862","المديد"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56611","الخفيف"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137865",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108641","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49564","البسيط"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20380","الخفيف"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202565","المتقارب"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121931","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27203","المديد"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27163","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216607",""],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216588",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106906","البسيط"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131479",""],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121148","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204737","الخفيف"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126242","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67999","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62875","الخفيف"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102939","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136828",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57965","الطويل"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114610","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4702,"ماكل شعبٍ يثور يغير القادة","https://www.poetsgate.com/ViewPoem.aspx?id=155215",""],[4578,"راع القلوب مصابٌ جاء بالعجب","https://www.poetsgate.com/ViewPoem.aspx?id=49352",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5055,"صوت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=101656",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5264,"التفويض","https://www.poetsgate.com/ViewPoem.aspx?id=181542",""],[5277,"حديثُ الدموعِ..","https://www.poetsgate.com/ViewPoem.aspx?id=202790",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5419,"هي وقطتها","https://www.poetsgate.com/ViewPoem.aspx?id=52033",""],[5495,"تغطيت","https://www.poetsgate.com/ViewPoem.aspx?id=175431",""],[5528,"ضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201145",""],[5691,"احتراق","https://www.poetsgate.com/ViewPoem.aspx?id=206858",""],[5956,"جواب رفاه لخالد","https://www.poetsgate.com/ViewPoem.aspx?id=182389",""],[5956,"ابتسم للكون يمنحْك ابتساما","https://www.poetsgate.com/ViewPoem.aspx?id=194582",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[2220,"بأثيلاتِ النَّقا سربُ قطا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19287&r=&rc=829",""],[6300,"نزيف الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82846&r=&rc=17",""],[6318,"درّة الأقصى مُحمَّد الدرّة وأبوه جمال الدرّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66165&r=&rc=15",""]],"verses":[["كُلُّ سِمَاتِ الرِّضَى","مِنْ عِنْدِهِمْ تُسْتَحَبْ",0,"ب",1,0],["كلّ سجع يهيم وهو مداد","فوقَ غصنِ اليراع بالتغريد",1,"د",1,0],["كُلُّ سَيفٍ في غَيرِ قَبضَةِ نوجي","فَهوَ عِندَ السُيوفِ غَيرُ سَعيدِ",2,"د",1,0],["كل سيف قاتل","حين تبدى مقتلك",3,"ك",1,0],["كلُّ سميعٍ في الهوى مُبصِرٌ","أعمى عن الرُّشدِ أصمَّ الصِّماخْ",4,"خ",1,0],["كُلُّ سَقامٍ تَراهُ في أَحَدٍ","فَذاكَ فَرعٌ وَالأَصلُ في بَدَني",5,"ن",2,0],["كلُّ سَمْراءَ وما أنْصَفْتُها","فَضَحَتْ سُمْرَ القَنا لَوناً وَلِينا",6,"ن",2,0],["كُلُّ سِنانٍ عيجَ مِن صَدرِهِ","تَخالُ عِطفَي رَأسِهِ نونا",7,"ن",2,0],["كلُّ سَمْراءٍ وما أَنْصَفْتُها","أعْدَتِ القَلْبَ فُتُوراً وَضَنى",8,"ن",2,0],["كلّ سيف في غير قيضة نوجي","فهو عند السيوف غير سعيد",9,"د",1,0],["كَلِسَانٍ مِنْ رأْسِ الأَفْعَىْ","نَصْلاً يَاقُوْتِيَّاً تِبْرِيْ",10,"ر",2,0],["كل ساداتها صدور عظام","علويون خلص اطهار",11,"ر",1,0],["كُلُّ سَفرٍ بها يُسامِرُ سَفراً","وبِها يُتحِفُ الحَكِيمُ الحَكِيمَا",12,"م",2,0],["كلُّ سحابٍ أمطرتْ أرضَهم","حاملةٌ للماء من أدمعى",13,"ع",2,0],["كُلُّ سُرُورٍ فِيهِ مِنْ تَمامِهِ","وَكَلُّ حُسْنٍ فإِلَيْهِ يَنْتَسِبْ",14,"ب",1,0],["كل سطر فيه صدرٌ من كعاب","أمره في فتنة الصب مجاب",15,"ب",1,0],["كلُّ سَعدٍ يُبنى عَلى شَقوَةِ الغَي","رِ فَهذي شَريعَةُ الأَيّامِ",16,"م",1,1],["كلُّ سيوفِ الموت عضبٌ حسامْ","إذا غَدَا كلُّ حُسامٍ كَهامْ",17,"م",1,1],["كل سيدي واشرب ونك إنما ال","حياة بين الشرب والفسق",18,"ق",1,0],["كلّ سعدٍ لغيره لاح فينا","لم يكن ذاك غير سعد الذابح",19,"ح",1,0],["كُلّ سَقامٍ زالَ عَن سُنقرِ","إِلا الَّذي في طَرفِهِ الأَحوَرِ",20,"ر",1,1],["كُلُّ ساعٍ سَعى لِيُدرِكَ شَيئاً","سَوفَ يَأتي بِسَعيِهِ ذا الجَلالِ",21,"ل",1,0],["كلُّ سارٍ سَرى لمعْراج سُؤْلٍ","يَبتغيه على بُراقِ رجاء",22,"ا",2,0],["كلُّ سامِي الذُّرى تُسَامِقُه الشم","سُ فيعتدُّ نحوَها مِرْقاتا",23,"ت",2,0],["كلُّ سيفٍ يكلُّ غيرَ سيوفٍ","جُرِّدَتْ لي من ألحاظِ مواضي",24,"ض",2,0],["كل سر للحسن في الكون حب","فيه تستعذب النفوس الفناء",25,"ا",2,0],["كل سر هو مهر","للذي عندك سر",26,"ر",1,0],["كلُّ سَنامٍ حالقٍ حتّه ال","سيرُ وجنبٍ بالحوايا جليمْ",27,"م",1,0],["كلُّ سهمٍ غير ما أرسلتمُ","كلمهُ في القلب أمسى هينا",28,"ن",2,0],["كل ساجي الجفون معتدل الق","امة ألمى ضعيفُ عقدِ القباءِ",29,"ا",2,0],["كل سطر حاوي الرقائق شامل","كل قول مما يقول ثمين",30,"ن",1,0],["كلسان الصل أو كالنجم في","ليل نقع طالع في أملد",31,"د",1,0],["كلُّ سَاجِي الجُفُونِ في رِيْقهِ ال","بُرْءُ وَفي لَفْظِهِ سَقَامُ الصَّحِيْحِ",32,"ح",1,0],["كلُّ سِنٍّ كالأُقحُوانة كانَتْ","فَغَدَتْ بالدّماء كالجلَّنارَهْ",33,"ر",2,0],["كل سراج وجزء وهو مقتبس","كوالدٍ أمس وهو اليوم مولود",34,"د",1,0],["كل ساس بوقفة المجد منكم","هو في وقفة الردى غير سلس",35,"س",1,0],["كلّ ساعٍ داعٍ له بدوام ال","ملك ما زال سعيه مشكورا",36,"ر",2,0],["كلُّ سطر لدى الحقيقةِ منهُ","ما يُدانيهِ عقدُ درٍّ نَظِيمِ",37,"م",1,0],["كل سرٍّ فهْو مُسْتَتِر","والهوى أعيا مُواريه",38,"ي",2,0],["كلُّ سَطرٍ مِنها فَريدُ جُمانٍ","كلُّ شَطرِ يلُوحُ مِنها قَصِيدُ",39,"د",1,0],["كل ساع وراءك اليوم يبكي","نعشك اليوم وحده بسام",40,"م",1,0],["كل سيفقد راحلا لكنما","ذكر الامين ومجده لا يفقد",41,"د",1,0],["كلّ سبطِ البنان في الشتوة الغب","راء يأبى عنها الحيا أن ينوبا",42,"ب",2,0],["كلٌّ سباه مهفهفٌ أو غادةٌ","أما أنا فغريرةٌ وغرير",43,"ر",1,0],["كلٌّ سَيُودِي وإنْ طالت سَلاَمَتُهُ","يا حاملَ الحربِ لا تغترّ بالظَّفَر",44,"ر",1,0],["كُلَّ سَجحاءَ كَالقَناةِ قَرون","وَطُوالِ القَرا هَزيمُ الذَكاءِ",45,"ا",2,0],["كل سمح الكف لو تسأله","كلما يملك جودا وهبا",46,"ب",2,0],["كل سهم به الزمان رمانى","لى درع عنه من الاحتساب",47,"ب",1,0],["كلُّ سرٍّ خافضٌ رافعٌ","لوجودي رغبةً ينتمي",48,"م",2,0],["كُلُّ سَوءٍ في هَواهُم حَسُنا","وَعَذابي بِرِضاهُم عَذُبا",49,"ب",2,0],["كُلٌّ سَيُفنِيهِ الفنَاءَ المَحضَ لا","يَبقَى لَهُ أثَرٌ كَظِلٍّ فَانِ",50,"ن",1,0],["كِلّ سْببي مِنْ ياهِلٍ حِرّ","اللّي خْدُوْدِهْ تشْعِل انْوَارْ",51,"ر",1,0],["كِلّ سْبِبي مِنْ ظَبْيَة الفَيّ","لِيْ صَوّبَتْ قَلْبِيْ بنَشّاب",52,"ب",1,0],["كلٌّ سعيدٌ بما قد نال صاحبه","هذا بذاك ولا غرم لمن شفعا",53,"ع",2,0],["كل ساعه وهي في صفه كالمستهام","غير سكرى ولا هي مفيقه",54,"ق",2,0],["كُلِّ سحتٍ ورشوة وغلولٍ","عند كلّ الورى من المنكراتِ",55,"ت",1,0],["كل ساع لغاية دنيوية","هو ساع الى الأمور الدنية",56,"ي",2,0],["كل سر في العارفين من الل","ه فأنتم مخطوبة وخطيبه",57,"ب",2,0],["كلُّ ساعٍ فللطبِيعةِ يَقْفو","مِحْوراً فِي تطور المُنشَئات",58,"ت",1,0],["كلُّ سَاعٍ له على الجَهدِ فيها","طَلَبٌ صَابِرٌ الى مَطْلُوبِ",59,"ب",1,0],["كل سمراء في التماثيل تهتز","ز دلالاً كالصعدة اليزنيه",60,"ي",2,0],["كُلُّ سِمطٍ مِنَ الفَخارِ نَفِيسٍ","أنتَ وُسطاهُ التُّومَةُ الغَرَّاءُ",61,"ا",2,0],["كُلُّ سَامٍ مِنَ المَقاماتِ يَسمُو","لَهُ فِيهِ مَكانَةٌ قَعسَاءُ",61,"ا",2,0],["كل سر لهم بقلبي مصون","غير إن الهوى لدي مباح",62,"ح",1,0],["كل سجاياه يرتضيها","أخوتقى بالهدى يقرّ",63,"ر",1,0],["كل ساعه ونا ساهن تجينا البشاره","من قداكم وجاعل عاد فيكم جساره",64,"ر",2,0],["كل سقى قبره في حين بهاطلٍ","هتونٍ وشيكٍ من تدفقه السحب",65,"ب",1,0],["كل سبيل منايا الدهر مسلكه","ولو تسامت معاليه على الشهب",66,"ب",1,0],["كل سيمضي ويبقى ذكره حسنا","ان كان ممن بتقوى اللَه ذا داب",66,"ب",1,0],["كل سعىُ الرجا إليه ولكن","ترك السعىَ بعده كلُ ساعي",67,"ع",2,0],["كلٍّ سببها مرض والطبّ مافاده","ودْواه في شوفته فالدار وحضوره",68,"ر",2,0],["كلٌ سبيل منيا الدهر مسله","ولو تسامت معاليه على الشهب",69,"ب",1,0],["كلٌ سيمضي وسيبقى ذكره حسناً","إن كان بتقوى الله ذا دأب",69,"ب",1,0],["كل سواسية في ظل مجتمع","محمد فيه فردا صاحب العظم",70,"م",1,0],["كل سحبٍ في فضانا صار شال","والجبل من فرْحنا اليوم أبتهلّ",71,"ل",1,0],["كُلُّ سَدْفٍ فِي الْمَآقِي","شَفَّ نُورًا صُرْتُ حَوْرَا",72,"ر",2,0],["