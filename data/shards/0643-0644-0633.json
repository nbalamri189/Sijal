{"poems":[[93,"هذا أديب العرب","https://www.aldiwan.net/poem9794.html","عموديه"],[72,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[61,"أنخت في حانة أترجة","https://www.aldiwan.net/poem51730.html","السريع"],[44,"الحسن جزء من وجهك الحسن","https://www.aldiwan.net/poem30092.html","المنسرح"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[48,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[91,"سقوط بورت ارثور","https://www.poetsgate.com/ViewPoem.aspx?id=53022",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[115,"رفعتني بال بيت الرفاعي","https://www.aldiwan.net/poem41116.html","عموديه"],[132,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[142,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[174,"يوم أتى بديمة هطالة","https://www.aldiwan.net/poem46066.html","الرجز"],[211,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[223,"كل سعد يبنى على شقوة الغير","https://www.aldiwan.net/poem41915.html","الخفيف"],[229,"كل سيوف الموت عضب حسام","https://www.aldiwan.net/poem50782.html","السريع"],[256,"أوجع دماغا القرع بالسلقِ","https://www.aldiwan.net/poem48457.html","السريع"],[259,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[282,"كل سقام زال عن سنقر","https://www.aldiwan.net/poem32779.html","السريع"],[322,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[432,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[432,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[443,"اشرح الصدر للمحاسن طرا","https://www.aldiwan.net/poem55920.html","عموديه"],[453,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[458,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[464,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[464,"شب نار الأحشاء ماء البكاء","https://www.aldiwan.net/poem3437.html","عموديه"],[479,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[515,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[567,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[575,"نثر الدهر عقد ثغر حبيبي","https://www.aldiwan.net/poem2944.html","الخفيف"]],"verses":[["كُلُّ سِمَاتِ الرِّضَى","مِنْ عِنْدِهِمْ تُسْتَحَبْ",0,"ب",1,0],["كلّ سجع يهيم وهو مداد","فوقَ غصنِ اليراع بالتغريد",1,"د",1,0],["كُلُّ سَيفٍ في غَيرِ قَبضَةِ نوجي","فَهوَ عِندَ السُيوفِ غَيرُ سَعيدِ",2,"د",1,0],["كل سيف قاتل","حين تبدى مقتلك",3,"ك",1,0],["كلُّ سميعٍ في الهوى مُبصِرٌ","أعمى عن الرُّشدِ أصمَّ الصِّماخْ",4,"خ",1,0],["كُلُّ سَقامٍ تَراهُ في أَحَدٍ","فَذاكَ فَرعٌ وَالأَصلُ في بَدَني",5,"ن",2,0],["كلُّ سَمْراءَ وما أنْصَفْتُها","فَضَحَتْ سُمْرَ القَنا لَوناً وَلِينا",6,"ن",2,0],["كُلُّ سِنانٍ عيجَ مِن صَدرِهِ","تَخالُ عِطفَي رَأسِهِ نونا",7,"ن",2,0],["كلُّ سَمْراءٍ وما أَنْصَفْتُها","أعْدَتِ القَلْبَ فُتُوراً وَضَنى",8,"ن",2,0],["كلّ سيف في غير قيضة نوجي","فهو عند السيوف غير سعيد",9,"د",1,0],["كَلِسَانٍ مِنْ رأْسِ الأَفْعَىْ","نَصْلاً يَاقُوْتِيَّاً تِبْرِيْ",10,"ر",2,0],["كل ساداتها صدور عظام","علويون خلص اطهار",11,"ر",1,0],["كُلُّ سَفرٍ بها يُسامِرُ سَفراً","وبِها يُتحِفُ الحَكِيمُ الحَكِيمَا",12,"م",2,0],["كلُّ سحابٍ أمطرتْ أرضَهم","حاملةٌ للماء من أدمعى",13,"ع",2,0],["كُلُّ سُرُورٍ فِيهِ مِنْ تَمامِهِ","وَكَلُّ حُسْنٍ فإِلَيْهِ يَنْتَسِبْ",14,"ب",1,0],["كل سطر فيه صدرٌ من كعاب","أمره في فتنة الصب مجاب",15,"ب",1,0],["كلُّ سَعدٍ يُبنى عَلى شَقوَةِ الغَي","رِ فَهذي شَريعَةُ الأَيّامِ",16,"م",1,1],["كلُّ سيوفِ الموت عضبٌ حسامْ","إذا غَدَا كلُّ حُسامٍ كَهامْ",17,"م",1,1],["كل سيدي واشرب ونك إنما ال","حياة بين الشرب والفسق",18,"ق",1,0],["كلّ سعدٍ لغيره لاح فينا","لم يكن ذاك غير سعد الذابح",19,"ح",1,0],["كُلّ سَقامٍ زالَ عَن سُنقرِ","إِلا الَّذي في طَرفِهِ الأَحوَرِ",20,"ر",1,1],["كُلُّ ساعٍ سَعى لِيُدرِكَ شَيئاً","سَوفَ يَأتي بِسَعيِهِ ذا الجَلالِ",21,"ل",1,0],["كلُّ سارٍ سَرى لمعْراج سُؤْلٍ","يَبتغيه على بُراقِ رجاء",22,"ا",2,0],["كلُّ سامِي الذُّرى تُسَامِقُه الشم","سُ فيعتدُّ نحوَها مِرْقاتا",23,"ت",2,0],["كلُّ سيفٍ يكلُّ غيرَ سيوفٍ","جُرِّدَتْ لي من ألحاظِ مواضي",24,"ض",2,0],["كل سر للحسن في الكون حب","فيه تستعذب النفوس الفناء",25,"ا",2,0],["كل سر هو مهر","للذي عندك سر",26,"ر",1,0],["كلُّ سَنامٍ حالقٍ حتّه ال","سيرُ وجنبٍ بالحوايا جليمْ",27,"م",1,0],["كلُّ سهمٍ غير ما أرسلتمُ","كلمهُ في القلب أمسى هينا",28,"ن",2,0],["كل ساجي الجفون معتدل الق","امة ألمى ضعيفُ عقدِ القباءِ",29,"ا",2,0],["كل سطر حاوي الرقائق شامل","كل قول مما يقول ثمين",30,"ن",1,0],["كلسان الصل أو كالنجم في","ليل نقع طالع في أملد",31,"د",1,0],["كلُّ سَاجِي الجُفُونِ في رِيْقهِ ال","بُرْءُ وَفي لَفْظِهِ سَقَامُ الصَّحِيْحِ",32,"ح",1,0],["كلُّ سِنٍّ كالأُقحُوانة كانَتْ","فَغَدَتْ بالدّماء كالجلَّنارَهْ",33,"ر",2,0]]}