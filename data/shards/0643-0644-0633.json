{"poems":[[93,"هذا أديب العرب","https://www.aldiwan.net/poem9794.html","عموديه"],[72,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[61,"أنخت في حانة أترجة","https://www.aldiwan.net/poem51730.html","السريع"],[44,"الحسن جزء من وجهك الحسن","https://www.aldiwan.net/poem30092.html","المنسرح"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[48,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[91,"سقوط بورت ارثور","https://www.poetsgate.com/ViewPoem.aspx?id=53022",""],[113,"رفعتني بال بيت الرفاعي","https://www.aldiwan.net/poem41116.html","عموديه"],[130,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[140,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[172,"يوم أتى بديمة هطالة","https://www.aldiwan.net/poem46066.html","الرجز"],[209,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[221,"كل سعد يبنى على شقوة الغير","https://www.aldiwan.net/poem41915.html","الخفيف"],[227,"كل سيوف الموت عضب حسام","https://www.aldiwan.net/poem50782.html","السريع"],[254,"أوجع دماغا القرع بالسلقِ","https://www.aldiwan.net/poem48457.html","السريع"],[257,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[280,"كل سقام زال عن سنقر","https://www.aldiwan.net/poem32779.html","السريع"],[320,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[429,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[429,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[441,"اشرح الصدر للمحاسن طرا","https://www.aldiwan.net/poem55920.html","عموديه"],[451,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[456,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[462,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[462,"شب نار الأحشاء ماء البكاء","https://www.aldiwan.net/poem3437.html","عموديه"],[477,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[565,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[573,"نثر الدهر عقد ثغر حبيبي","https://www.aldiwan.net/poem2944.html","الخفيف"]],"verses":[["كُلُّ سِمَاتِ الرِّضَى","مِنْ عِنْدِهِمْ تُسْتَحَبْ",0,"ب",1,0],["كلّ سجع يهيم وهو مداد","فوقَ غصنِ اليراع بالتغريد",1,"د",1,0],["كُلُّ سَيفٍ في غَيرِ قَبضَةِ نوجي","فَهوَ عِندَ السُيوفِ غَيرُ سَعيدِ",2,"د",1,0],["كل سيف قاتل","حين تبدى مقتلك",3,"ك",1,0],["كلُّ سميعٍ في الهوى مُبصِرٌ","أعمى عن الرُّشدِ أصمَّ الصِّماخْ",4,"خ",1,0],["كُلُّ سَقامٍ تَراهُ في أَحَدٍ","فَذاكَ فَرعٌ وَالأَصلُ في بَدَني",5,"ن",2,0],["كلُّ سَمْراءَ وما أنْصَفْتُها","فَضَحَتْ سُمْرَ القَنا لَوناً وَلِينا",6,"ن",2,0],["كُلُّ سِنانٍ عيجَ مِن صَدرِهِ","تَخالُ عِطفَي رَأسِهِ نونا",7,"ن",2,0],["كلُّ سَمْراءٍ وما أَنْصَفْتُها","أعْدَتِ القَلْبَ فُتُوراً وَضَنى",8,"ن",2,0],["كلّ سيف في غير قيضة نوجي","فهو عند السيوف غير سعيد",9,"د",1,0],["كل ساداتها صدور عظام","علويون خلص اطهار",10,"ر",1,0],["كُلُّ سَفرٍ بها يُسامِرُ سَفراً","وبِها يُتحِفُ الحَكِيمُ الحَكِيمَا",11,"م",2,0],["كلُّ سحابٍ أمطرتْ أرضَهم","حاملةٌ للماء من أدمعى",12,"ع",2,0],["كُلُّ سُرُورٍ فِيهِ مِنْ تَمامِهِ","وَكَلُّ حُسْنٍ فإِلَيْهِ يَنْتَسِبْ",13,"ب",1,0],["كل سطر فيه صدرٌ من كعاب","أمره في فتنة الصب مجاب",14,"ب",1,0],["كلُّ سَعدٍ يُبنى عَلى شَقوَةِ الغَي","رِ فَهذي شَريعَةُ الأَيّامِ",15,"م",1,1],["كلُّ سيوفِ الموت عضبٌ حسامْ","إذا غَدَا كلُّ حُسامٍ كَهامْ",16,"م",1,1],["كل سيدي واشرب ونك إنما ال","حياة بين الشرب والفسق",17,"ق",1,0],["كلّ سعدٍ لغيره لاح فينا","لم يكن ذاك غير سعد الذابح",18,"ح",1,0],["كُلّ سَقامٍ زالَ عَن سُنقرِ","إِلا الَّذي في طَرفِهِ الأَحوَرِ",19,"ر",1,1],["كُلُّ ساعٍ سَعى لِيُدرِكَ شَيئاً","سَوفَ يَأتي بِسَعيِهِ ذا الجَلالِ",20,"ل",1,0],["كلُّ سارٍ سَرى لمعْراج سُؤْلٍ","يَبتغيه على بُراقِ رجاء",21,"ا",2,0],["كلُّ سامِي الذُّرى تُسَامِقُه الشم","سُ فيعتدُّ نحوَها مِرْقاتا",22,"ت",2,0],["كلُّ سيفٍ يكلُّ غيرَ سيوفٍ","جُرِّدَتْ لي من ألحاظِ مواضي",23,"ض",2,0],["كل سر للحسن في الكون حب","فيه تستعذب النفوس الفناء",24,"ا",2,0],["كل سر هو مهر","للذي عندك سر",25,"ر",1,0],["كلُّ سَنامٍ حالقٍ حتّه ال","سيرُ وجنبٍ بالحوايا جليمْ",26,"م",1,0],["كلُّ سهمٍ غير ما أرسلتمُ","كلمهُ في القلب أمسى هينا",27,"ن",2,0],["كل ساجي الجفون معتدل الق","امة ألمى ضعيفُ عقدِ القباءِ",28,"ا",2,0],["كل سطر حاوي الرقائق شامل","كل قول مما يقول ثمين",29,"ن",1,0],["كلسان الصل أو كالنجم في","ليل نقع طالع في أملد",30,"د",1,0],["كلُّ سَاجِي الجُفُونِ في رِيْقهِ ال","بُرْءُ وَفي لَفْظِهِ سَقَامُ الصَّحِيْحِ",31,"ح",1,0],["كلُّ سِنٍّ كالأُقحُوانة كانَتْ","فَغَدَتْ بالدّماء كالجلَّنارَهْ",32,"ر",2,0]]}