{"poems":[[90,"دار السلام تفاخرت برجال","https://www.aldiwan.net/poem44980.html","الكامل"],[74,"لله تصنيف له رونق","https://www.aldiwan.net/poem18644.html","السريع"],[74,"لله ترخيم بجامع جلق","https://www.aldiwan.net/poem20006.html","الكامل"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[91,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85438","الكامل"],[108,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[147,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[286,"لله أبعث رغبتي متيقناً","https://www.aldiwan.net/poem1401.html",""],[302,"يا أيها المولى الذي","https://www.aldiwan.net/poem33166.html","مجزوء الكامل"],[396,"وصل سرمد وسلم كلما غرد","https://www.aldiwan.net/poem54521.html","عموديه"],[398,"بدت عذارى مدت سرادقها","https://www.aldiwan.net/poem53489.html","المنسرح"],[447,"لله تبت بما في الدين ألزمني","https://www.aldiwan.net/poem14391.html","البسيط"],[447,"أستغفر الله العظيم","https://www.aldiwan.net/poem14398.html","مجزوء الكامل"],[457,"لله تحقيق الهمام المولى","https://www.aldiwan.net/poem13885.html","الكامل"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100132","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62481","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62490","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100998","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100990","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87829","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52092","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114715","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137425",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93872","المتدارك"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74234","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82846","الكامل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26998","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91209","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58116","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72467","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72466","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136378",""],[4767,"روائع الأيات","https://www.poetsgate.com/ViewPoem.aspx?id=178557",""],[4767,"أنس المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=194930",""],[4578,"قد رعت يا ريب المنون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=49406",""],[4984,"لله تلك السوق","https://www.poetsgate.com/ViewPoem.aspx?id=215829",""],[5038,"موطن الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=190108",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5842,"أبكي مصاب الجامعة \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=130029",""],[5853,"نور الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=175723",""],[5864,"تفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=190339",""]],"verses":[["للّه تَلك الدار من متبوَّأ","بذّ النجوم بقدره المتعالي",0,"ل",2,0],["لله تصنيفٌ له رونقٌ","كرونق الحبات في عقدها",1,"ه",2,1],["لله ترخيم بجامع جلّقٍ","متجانس الترصيع والتعظيم",2,"م",1,1],["لله تلكَ يداً لقد جُعِلَتْ","وفقاً لما فيه من الشِّيمِ",3,"م",1,0],["للّه تلك النفس كيف تمزقت","برصاصة وثابة لا ترحم",4,"م",1,0],["لِلَّه تلك النفس وَالخلق الَّذي","يَرضى وَذاكَ الخاطر المتوقد",5,"د",1,0],["لله تاج يَزدَهي بجبينه","قد ضمَّ شمل الشرق بعد شتاته!",6,"ت",2,0],["لِلَّهِ تاجُ الأَصفِياءِ فَإِنَّهُ","أَضحى بِدُرِّ المَأثُراتِ مُرَصَّعا",7,"ع",2,0],["للّه ترتفعُ المطالبُ كلُّها","أنجحْ بمطلبِ طالب للّه",8,"ل",2,0],["لِلَّه تحفتُك الَّتي","من لَيسَ يقبلُها ظَلم",9,"م",1,0],["لله تحمد على إحسان لا ينعد","بخط أو قال جل الواحد المتعال",10,"ل",1,0],["لِلَّهِ تِلكَ الأَلفاظُ حامِلَة","غُرَّ مَعانٍ تُعيي دَقائِقُها",11,"ق",3,0],["للَه تبت بما في الدين ألزمني","أداؤه وعليه اللَه أندبني",12,"ن",2,1],["للَه تب لتفوز بال","قسم المباركة الوفيه",13,"ي",2,0],["للّهِ تحقيق الُهمامِ المولى","إِذ جُلتُه في خاطري فَاُحلولا",14,"ل",2,1],["للّه تلك الخصال الغر ما فتئت","فينا ويتبعها الإعزاز والشمم",15,"م",1,0],["للَه تربتك الزكية كم بها","عكفت ملائك ركع أوسجد",16,"د",1,0],["لله تيمور ما أحلى شمائله","كأنَّ مزن السما صبحاً بهّا رشحا",17,"ح",2,0],["للّه تيمور ما أحلى شمائلَه","كأنها المُزْن من أُفق الهوى هَمَعا",18,"ع",2,0],["للَه تبتذل المظاهرَ مُعرِضاً","وكبيرُها في ناظَريك صغير",19,"ر",1,0],["لله تلك القلوب الموجعات لما","دها الحنيفة تأتيها به الغير",20,"ر",1,0],["للَه تلك العيون الذارفات أسىً","وأنفسٌ من مسيل الدمع تنحدر",20,"ر",1,0],["لِلَّهِ تاجِرَةٌ بِمُنعَرَجِ الحِمى","عَرَضَت بِضاعَتَها عَلى مَن يَشتَري",21,"ر",2,0],["لِلَهِ تِلكَ الراسِياتُ فَإِنَّها","مَأوى الخَيالِ وَمَبعَثُ الأَفراحِ",22,"ح",1,0],["لِلهِ تُرْبٌ لاَحَ مِثْلَ جِنَانِ","يَزهُو بِنُورِ حُلاه كُلُّ جَنَانِ",23,"ن",1,1],["لِلّهِ تلكَ فَكم من أنفُسٍ ربقَت","وأَعيُنٍ غادَرتها نَحوها صُورا",24,"ر",2,0],["لِلّهِ تِلكَ مَناقِباً وَمَآثِراً","فَلَقَد أَقَرَّت أَعينَ الأَعداء",25,"ا",2,0],["للهتك بعدك ستر كل مصونة","ولدى المهانة نخوة الجبار",26,"ر",1,0],["لله تأتي ليل قد أشرقت","لك من جمادى آخر برشاده",27,"د",2,0],["للَه تعالى ما أخفى","ولشكر النعمة ما أظهر",28,"ر",1,0],["لِلَّه تكوينه لِلَّه فِطرته","جاءَت كَما شاءَها المولى وقدرته",29,"ه",1,0],["لِلّه تلكَ الوُجوه البيض ما فعلت","سُيوفهم حينَ صلت بَينَ أَعداء",30,"ا",2,0],["لِلَّهِ تُربَةُ ذا المَقامِ فَإِنَّها","تَحكي فَتيتَ المِسكِ فيه تَأَرُّجا",31,"ج",2,1],["لِلَّهِ تِلكَ اللَيالي وَالسُروربِها","كَأَنَّما أَبصَرَتها العَينُ في الحُلُمِ",32,"م",1,0],["لِلّه تَوفيق المَليك فَإِنَّهُ","جَمع المَكارم بَعد كُل شَتات",33,"ت",1,0],["للهِ تحْتَ قِبابِ العزِّ طائِفَةٌ","أخفاهُم في رداءِ الفقر إجلالا",34,"ل",2,1],["لله تحبير وتنميق","فيه من الاسرار تدقيق",35,"ق",1,1],["لله تفسير عديم المثال","أزرت مبنيه بنثر اللآل",36,"ل",1,1],["لله تشفع بنجدتي وخلاصي","يا معدن جود ويا خلاصة عدنان",37,"ن",1,0],["لله ترفعُ بيتَه حتى بدا","نجماً تألق في سما (سيهات)",38,"ت",1,0],["لله تسعى بِما أعطاك من نعمٍ","أثقلتَ من صالحٍ منها الموازينا",39,"ن",2,0],["لله تربٌ ضمه فلقد غدا","بأريج طيب الند أطيب نادي",40,"د",2,0],["لله تلك السوق ما تحتوي","من مشرق الدنيا ومن غرْبِ",41,"ب",1,1],["للهِ تلْكَ الْهامُ قدْ نُحِرَتْ","وسقى الْإباءُ بها دمَ الْمزَنِ",42,"ن",1,0],["للّه تكبيراً وحمدً وتهليل","اللي هزم لأحزاب والمسترده",43,"د",2,1],["للهِ تُسلِمُ وَجهَََهَا","تُمضي الليالي راكعةْ",44,"ع",2,0],["لله تدعو وحده بعبادةٍ","فالله نعبد لا إلها ً آخر",45,"ر",1,0],["لله تدبيرُ الأُمو","رِ فلا تَخَف أو تخشَ شِدَّه",46,"د",2,0]]}