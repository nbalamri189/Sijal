{"poems":[[95,"سلام على القدس ومن به","https://www.aldiwan.net/poem11150.html","الطويل"],[90,"علام حرمنا منذ حين تلاقيا","https://www.aldiwan.net/poem44994.html","الطويل"],[23,"أهاجك بالبيداء رسم المنازل","https://www.aldiwan.net/poem21249.html","الطويل"],[60,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[147,"دل على المجد من إليه سعى","https://www.aldiwan.net/poem11778.html","المنسرح"],[208,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[240,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[402,"سلام على القدس الشريف ومن به","https://www.aldiwan.net/poem11026.html","عموديه"],[411,"شأنك يا دمع وانحدارك","https://www.aldiwan.net/poem49957.html","مخلع البسيط"],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/203595","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48761","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28550","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121192","السريع"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75975","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11258","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62945","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108173","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91088","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125878","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93310","الوافر"]],"verses":[["وَأَيُّ جَمَالٍ بَيْنَ سُمْرَةِ طَوْدِهِ","وَخُصْرَةِ وَادِيهِ وَحُمْرَةِ شِعْبِهِ",0,"ب",2,0],["وأيُّ جَوىً قد عُدت اصفر فاقعاً","به بعد أن قد كنت أحمر قانيا",1,"ي",2,0],["وَأَيُّ جَديدٍ لَيسَ يُدرِكُهُ البِلى","وَأَيُّ نَعيمٍ لَيسَ يَوماً بِزائِلِ",2,"ل",1,0],["وَأَيُّ جَمعٍ كَثيرٍ لا تُفَرِّقُهُ","إِذا تَدانَت لَهُم غَسّانُ وَالنُدبُ",3,"ب",1,0],["وَأَيُّ جانٍ لَجَّ العِثارُ بِهِ","فَلَم يَقُل صَفحُكَ الجَميلُ لَعا",4,"ع",2,0],["وأيّ جواد لم تكن منه هفوة","وأي حسام في الأحايين لا ينبو",5,"ب",2,0],["وَأَيُّ جيدٍ وَأَيُّ سالِفَةٍ","لَيسَ عَليها وَسمٌ لَهُ وَيَدُ",6,"د",1,0],["واي جمال بين سمرة طوده","وخضرة واديه وحمرة شعبه",7,"ب",2,0],["وأيَّ جُرمٍ جنيتُ حتَّى","أبعَدتَ بعدَ الدُّنُوِّ دارَك",8,"ك",1,0],["وأي جمع يرى في نسلهم حسن","كجده حسن حالاً ومنقلبا",9,"ب",2,0],["وأي جزاء يستحق مجاهد","إذا صنع المعروف فيها ليحكما",10,"م",2,0],["وَأَيُّ جُفون ما أَفاضَت دُموعَها","عَلَيكَ وَقَلبٍ فيكَ لَم يَتَصَدَّعِ",11,"ع",1,0],["واي جبار اذا ما رأى","ابا مراد صال لم يقلق",12,"ق",1,0],["وأي جزء منه بالبيت خلا","سمي موفوراً على ما نقلا",13,"ل",2,0],["واي جزء ينبري خليا","منه فذا يدعونه بريا",13,"ي",2,0],["وَإِيجادِ مَعدومٍ وَإِيجازِ مُسهَب","وَتَعيينِ إِبهامٍ وَتَوضيحِ إِغماضِ",14,"ض",1,0],["وَإيجازي بِمُختَصَرٍ قَريبٍ","حَذَفتُ بِهِ الفُضولَ مِنَ الجَوابِ",15,"ب",1,0],["وأي جفن عليه قد جفا وسناً","وجاد بالدمع إن ضنَّ السحاب هتن",16,"ن",1,0],["وأَىُّ جوادٍ بعد جودِكَ يُصطفى","له المدح أَو يُهدى القريضُ المتقحُ",17,"ح",1,0],["وأيُّ جفون في الديار أحق من","جفوني بأن يغدون منهمرات",18,"ت",1,0],["وَأَيّ جَمع مع الأَدهار ما افترقت","أَربابُه قَبلَنا أَو دام وَهوَ كَما",19,"م",2,0],["وأيُّ جميلٍ أنت لم تُولنا به","وأيَّةُ شَعْب مثلُنا اليومَ طائع",20,"ع",1,0],["وأَيّ جناية تَرْضى المَساعي","بها ويُثاب جانيها بمال",21,"ل",1,0]]}