{"poems":[[53,"علق القلب من أطال عذابي","https://www.aldiwan.net/poem29627.html","الخفيف"],[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[86,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[73,"لَمّا اِتَّصَلتِ اِتِّصالَ الخِلبِ بِالكَبِدِ","https://www.aldiwan.net/poem11883.html","البسيط"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[88,"عبد المجيد قضى فوا أسفا","https://www.aldiwan.net/poem45049.html","أحذ الكامل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"يا ابن بوران لات حين مناص","https://www.aldiwan.net/poem64937.html","الخفيف"],[51,"ساءلت يوما خالدا","https://www.aldiwan.net/poem65011.html","مجزوء الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[91,"ما لهند وكل حسناء هند","https://www.aldiwan.net/poem8807.html","عموديه"],[91,"ما ساء نفسي من الدنيا سوى نفر","https://www.aldiwan.net/poem62705.html","عموديه"],[89,"خطبت تؤبنك الدموع","https://www.aldiwan.net/poem44716.html","مجزوء الكامل"],[85,"بدأ الطيف بالجميل وزارا","https://www.aldiwan.net/poem63660.html","الخفيف"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[61,"وصف ابن يوسف لي بكل فضيلة","https://www.aldiwan.net/poem51460.html","الكامل"],[49,"أهل القبور عليكم مني السلام","https://www.aldiwan.net/poem63103.html","الكامل"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[105,"اسألي يا نجد أهل الميفعه","https://www.aldiwan.net/poem43578.html","الرمل"],[52,"من يشتري حسبي بأمن خمول","https://www.aldiwan.net/poem26706.html","الكامل"],[52,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[52,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[48,"يا نواسي توقر","https://www.aldiwan.net/poem63406.html","مجزوء الرمل"],[46,"ساء بريا من البرايا","https://www.aldiwan.net/poem23609.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85427","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85788","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54582","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43855","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[46,"ساءَ بَريّاً، من البرايا،","https://www.poetsgate.com/ViewPoem.aspx?id=16679",""],[105,"في حمى الحق ومن حول الحرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55068&r=&rc=238",""],[187,"ما للمليحة ما لها","https://www.aldiwan.net/poem43346.html","مجزوء الكامل"],[190,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[198,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[200,"وردة هب في الرياض","https://www.aldiwan.net/poem45635.html","مجزوء الخفيف"],[271,"عوضت منك من الإيناس إيحاشا","https://www.aldiwan.net/poem35052.html","البسيط"],[282,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[299,"هل من يعين على التجلد ساعة","https://www.aldiwan.net/poem36292.html","عموديه"],[321,"لما تجلى الأنس وانتظم الصفا","https://www.aldiwan.net/poem67117.html","الكامل"],[349,"وباخل يشنأ الأضياف حل به","https://www.aldiwan.net/poem20705.html","الخفيف"],[365,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[367,"ما معالشيب حديث في غزل","https://www.aldiwan.net/poem17387.html","الرمل"],[410,"ما يريد الشوق من قلب مغنى","https://www.aldiwan.net/poem32369.html","الرمل"],[417,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[417,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[453,"ما اسم ثلاثي وفعل معا","https://www.aldiwan.net/poem13784.html","السريع"],[454,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[459,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[465,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[480,"فيك يحلو الغزل","https://www.aldiwan.net/poem36917.html","مجزوء الرمل"],[480,"سلمى بعيشك واصلي","https://www.aldiwan.net/poem36971.html","مجزوء الكامل"],[480,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[501,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[515,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[516,"لما رأيت عراص القصر خالية","https://www.aldiwan.net/poem12048.html","البسيط"],[539,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[552,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"]],"verses":[["ساءَني مُذ نَأَيتُ نِسيانُ ذِكري","فَاِذكُروني وَلَو ذُكِرتُ بِسَوِّ",0,"و",1,0],["ساءَلتُها عَن قاسِمٍ فَأَبَت","رَدَّ الجَوابِ فَرُحتُ في خَبَلِ",1,"ل",1,0],["ساءَهُ أَلّا يَرى في قَومِهِ","سيرَةَ الإِسلامِ في عَهدِ النَبي",2,"ب",2,0],["ساءَ الوُشاةُ مَكاني مِنكِ وَاِتَّقَدَت","في صَدرِ كُلِّ عَدُوٍّ جَمرَةُ الحَسَدِ",3,"د",1,0],["سَاءَ هِجْرَانُكَ الرِّفَاقَ وَلَكِنْ","لَيْسَ بَيْنَ القُطْرَيْنِ مِنْ هِجْرَانِ",4,"ن",1,0],["سَاءلْتَ عَنهُ النَّجْمَ مُرْتَقِباً","وَبَحَثْتَ بَيْنَ الحَرْفِ وَالرَّقَمِ",5,"م",1,0],["ساء المكارم كونه دنفا","يشكو إلى عوّاده الوجعا",6,"ع",2,0],["ساءها أنْ رأتْ حبيباً إليها","ضاحكَ الرأسِ عن مفَارقَ شِيبِ",7,"ب",1,0],["سَاءَلْتُهُ وسَأَلْتُهُ فوجدته","كالبحْرِ يَعْظُمُ قدرهُ أنْ يُنْزَحَا",8,"ح",2,0],["ساء تقديرُ مستثيرِ الأفاعي","ومُريغ الأسود في الأعياص",9,"ص",1,0],["ساءَلتُ يوماً خالداً","ذا المجد والبيت الوسيطِ",10,"ط",1,1],["ساءلتَ عن متغابن في دينهِ","إذ لا يُرى في دينه مُتغابنا",11,"ن",2,0],["ساءَلتُ قَلبي إِذ رَأى فَتَحَيَّرا","ماذا شَرِبتَ فَمِدتَ قالَ دِمائي",12,"ي",1,0],["ساءَ حالُ الأَزواجِ في عَصرِنا هَ","ذا وَساءَت أَحوالُ كُلِّ وَليدِ",13,"د",1,0],["ساءَت خَلائِقُهُم أَو لا خَلاقَ لَهُم","إِلّا الشَراهَةُ وَالإيثارُ وَالنَهَمُ",14,"م",1,0],["ساءلت من ملك العرا","ق فقيل لي غازي القريع",15,"ع",1,0],["ساءَلتَني عَنِ النَهارِ جُفوني","رَحِمَ اللَهُ يا جُفوني النَهارا",16,"ر",2,0],["ساءَت ظُنونُ الناسِ حَتّى أَحدَثوا","لِلشَكِّ في النورِ المُبينِ مَجالا",17,"ل",2,0],["ساءَلتُه عَن عِلمِه فكأنَّما","ساءلتُ عن سُكَّانِه رَبعاً خَلا",18,"ل",2,0],["ساءَلتُ أَجداثَ المُلوكِ فَأَخبَرَت","ني أَنَّهُم فيهِنَّ أَعضاءٌ وَهام",19,"م",1,0],["ساءَنا من شرَّها ما نجتوى","وعَنانا من أذاها ما نَذُمّْ",20,"م",1,0],["ساءَهُ اللّومُ فقلبٌ آسفٌ","يَتَّقِي اللَّهَ ونفسٌ مُوجَعَهْ",21,"ع",2,0],["ساءَ الزَمانُ وَأَوجَعَتكَ صُروفُهُ","وَعَسى الزَمانُ يُسِرُّبَعدَ قَليلِ",22,"ل",1,0],["ساءَكَ الدَهرُ بِها","وَقَديماً فَعَلا",23,"ل",2,0],["ساءَت بِكَ الدُنيا وَسَرَّت مَرَّةً","فَأَراكَ مِن حَسَناتِها وَذُنوبِها",24,"ب",3,0],["ساءَكَ الدَهرُ بِشَيءٍ","وَبِما سَرَّكَ أَكثَر",25,"ر",1,0],["ساءَ بَريّاً مِنَ البَرايا","مَن لَبِسَ الدينَ سابِرِيّا",26,"ر",3,1],["ساءَ الفَتى أَن قد أَقام ببقعة","لَيسَ الفَتى يَوماً بها بمكرم",27,"م",1,0],["ساءلتها مستعلماً عَن أَهلها","فوددت لَو تتكلم الأحجار",28,"ر",1,0],["ساءلت شيخا قد تحد","دبَ ما تفتش في التراب",29,"ب",1,1],["ساءه الدهر ومازال يسوء","ما عليه لو أسا ما جرحا",30,"ح",2,0],["ساءَهُ ما بِنا تَبَيَّنَ في الأَي","دي وإشناقُها إلَى الأَعناقِ",31,"ق",1,0],["سَاءَنِي مَا تشْتَكِي يَا ابْنَ أَخِي","رَاجِعِ الحَزْمَ فَمَا يُجْدِي اكْتِئَابِ",32,"ب",1,1],["ساءَ بديلٌ حَملتُ مِنهُ","ما هَدَّ مِنّي أَشَمَّ راسِ",33,"س",1,0],["ساءَني المِقدارُ فيهِ","وَالَّذي يَلقَونَ أَسوا",34,"و",2,0],["ساءَني يا بُنَيَّ حَجزُكَ عَنّي","سرّكَ اللَهُ هَل يَسوءُكَ حَجزي",35,"ز",2,0],["ساءلت حين قضى عليٌّ فجأة","هل حلّ يومُ الحشرِ قبل أوانه",36,"ن",2,0],["ساءني، يا بنّي أنك نجلا","لِي فكانت أبوَّتي لك داءك",37,"ك",1,0],["ساءلت عن دمه، فقالوا: زئبق","في كل عرق من نحاس قد جرى",38,"ر",2,0],["ساءلتُ نفسي: أحقًّا هذه حلبٌ؟","ورُحتُ أَلْثَمُهَا أرضًا وجُدرانا",39,"ن",2,0],["ساءت نهاريَّ يقظاناً فجائعُها","وسئن ليليَ إذ صُوِّرْنَ لي حلما",40,"م",2,0],["ساءَ بَريّاً، من البرايا،-- منْ لبسَ الدينَ سابريّا","إن كَسَرتَني يَد المَنايا، -- فَما الأطبّاءُ جابريّا",41,"ر",3,1],["ساءنا من شرها ما نجتوى","وعنانا من أذاها ما تذم",42,"م",1,0],["ساءلتها إفضالها","مدّت إليك مبالها",43,"ل",3,0],["ساءَت خلائقهُ ضلّت طرائقهُ","قَد تاهَ بالتيهِ في تيهاء سبسبهِ",44,"ب",2,0],["ساءَهم أن أعيش صبّا أناغيهم","بأشعاري الرقاق العذاب",45,"ب",1,0],["ساءلتْ عن مصابها","فتنادى يجيبُها",46,"ب",3,0],["ساءت ظُنوني بأملاكٍ مُطَهّرةٍ","إذ تعشقُ الخودُ نخَّاساً وفرّاشا",47,"ش",2,0],["ساء الردى ثم ساوى في حكومته","أيبتغي العدل في الأحكام من عسفا",48,"ف",2,0],["ساءَلته ما خطبُه فتدفَّقتْ","منه الدموعُ فما استطاع مقالا",49,"ل",2,0],["ساءَلت طالِعَها بِماذا يا تُرى","أَرخَت بِاللَهِ العَظيمُ قِرانَها",50,"ن",3,0],["سَاءَلْتُهُ ماالذي تَشْكُو فَأَنشَدني","ضَيْفٌ أَلَمَّ بِرأْسي غَيرُ مُحتَشِمِ",51,"م",1,0],["ساءَ وَرَدَّ خادَرُ تَعتادُهُ","لَها حِمى وَغَيرُهُ لَم يُعدَدِ",52,"د",1,0],["ساءَهُ ضَربُ يَدٍ تَظلِمُني","وَاِشتَهى يَحمِلُ عَنّي ما حَمَل",53,"ل",1,0],["ساءَنا ما سرَّنا من عيِشِنَا","بعدَ ما رَاق لنا مرأىً ومَجْنَى",54,"ن",2,0],["سَاءَ ظَنّي باصْطِبَارِي بعدَكُم","ولقد كنتُ به أُحسِنُ ظَنّا",54,"ن",2,0],["ساءنا الدهرُ مأخذاً ونزاعا","واتّصالاً وفرقةً واجتماعا",55,"ع",2,0],["ساءني منه لعمري شَرَفٌ","ليَ من تلك الحروف الثُلثان",56,"ن",1,0],["ساءَ طبعاً حتى على ذاته جار","فأعطى كف الزوال دوامه",57,"م",2,0],["ساءَ وسرَّ الناسَ في حكمه","فهو لديهم عادِلٌ جائِرُ",58,"ر",1,0],["ساءلتها لما تأملتها","عن عشقها مثلي المجانينا",59,"ن",2,0],["ساءهم حفظِيَ فيكم وعكوفي","جانبَ الغيب عليكم واشتمالي",60,"ل",2,0],["ساءت ظنونكمُ بجفنٍ ساهرٍ","فسمعتمُ كذب الخيال الطارق",61,"ق",1,0],["ساءلتنا ما جرى","وعلى م الجدل",62,"ل",1,0],["ساءلت قلبي في الهوى","عما يراه فسائلي",63,"ل",2,0],["ساء التصرف في حزن وفي فرح","راهن بما شئت من تلقاه مقتنعا",64,"ع",2,0],["ساءَ ظنِّي بشُؤُني كلِّها","إنَّ سوءَ الظَّنِّ من أَزكى الفِطَنْ",65,"ن",1,0],["ساءَتْ خلائِقُهم فساءَ فلا أرى","شيئاً به إلّا عليّاً يُمدَحُ",66,"ح",1,0],["ساءلت أبله قلبي في السلو وقد","يقال للبله في الدنيا إصابات",67,"ت",1,0],["ساء فالٌ لَهم فقد حَسِبوها","لَهُمُ قَصراً لكنَ ألفوَه قبرا",68,"ر",2,0],["ساءَ عَهدي لِقاطنيك مَتى أَذْ","رَيتُ دمعاً من مُقلتي لا يصوبُ",69,"ب",1,0]]}