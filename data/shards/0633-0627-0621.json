","https://www.poetsgate.com/ViewPoem.aspx?id=72283",""],[5458,"أحلام الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=113376",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5628,"لقاء في هيروشيما(1)","https://www.poetsgate.com/ViewPoem.aspx?id=178534",""],[5628,"الحب لن يموت","https://www.poetsgate.com/ViewPoem.aspx?id=178535",""],[5628,"مغترب يصف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=178540",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5829,"سعير الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=152056",""],[5853,"(((((هل تذكرين)))))","https://www.poetsgate.com/ViewPoem.aspx?id=175684",""],[5953,"أنا واثق حسن الظن","https://www.poetsgate.com/ViewPoem.aspx?id=93868",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[5978,"تجليات من وحي الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=191711",""],[6031,"ولَيلةٍ بِتُّ تَجلُو لي حَنَادِسَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46338",""],[4442,"ساء العراق فأحسن الهند","https://www.poetsgate.com/ViewPoem.aspx?id=171217",""],[6102,"فَ.......","https://www.poetsgate.com/ViewPoem.aspx?id=184545",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""],[6171,"أميرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86321&r=&rc=1",""],[6210,"قالت لي الريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7244&r=&rc=16",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[6341,"طواف الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87287&r=&rc=16",""]],"verses":[["ساءَني مُذ نَأَيتُ نِسيانُ ذِكري","فَاِذكُروني وَلَو ذُكِرتُ بِسَوِّ",0,"و",1,0],["ساءَلتُها عَن قاسِمٍ فَأَبَت","رَدَّ الجَوابِ فَرُحتُ في خَبَلِ",1,"ل",1,0],["ساءَهُ أَلّا يَرى في قَومِهِ","سيرَةَ الإِسلامِ في عَهدِ النَبي",2,"ب",2,0],["ساءَ الوُشاةُ مَكاني مِنكِ وَاِتَّقَدَت","في صَدرِ كُلِّ عَدُوٍّ جَمرَةُ الحَسَدِ",3,"د",1,0],["سَاءَ هِجْرَانُكَ الرِّفَاقَ وَلَكِنْ","لَيْسَ بَيْنَ القُطْرَيْنِ مِنْ هِجْرَانِ",4,"ن",1,0],["سَاءلْتَ عَنهُ النَّجْمَ مُرْتَقِباً","وَبَحَثْتَ بَيْنَ الحَرْفِ وَالرَّقَمِ",5,"م",1,0],["ساء المكارم كونه دنفا","يشكو إلى عوّاده الوجعا",6,"ع",2,0],["ساءها أنْ رأتْ حبيباً إليها","ضاحكَ الرأسِ عن مفَارقَ شِيبِ",7,"ب",1,0],["سَاءَلْتُهُ وسَأَلْتُهُ فوجدته","كالبحْرِ يَعْظُمُ قدرهُ أنْ يُنْزَحَا",8,"ح",2,0],["ساء تقديرُ مستثيرِ الأفاعي","ومُريغ الأسود في الأعياص",9,"ص",1,0],["ساءَلتُ يوماً خالداً","ذا المجد والبيت الوسيطِ",10,"ط",1,1],["ساءلتَ عن متغابن في دينهِ","إذ لا يُرى في دينه مُتغابنا",11,"ن",2,0],["ساءَلتُ قَلبي إِذ رَأى فَتَحَيَّرا","ماذا شَرِبتَ فَمِدتَ قالَ دِمائي",12,"ي",1,0],["ساءَ حالُ الأَزواجِ في عَصرِنا هَ","ذا وَساءَت أَحوالُ كُلِّ وَليدِ",13,"د",1,0],["ساءَت خَلائِقُهُم أَو لا خَلاقَ لَهُم","إِلّا الشَراهَةُ وَالإيثارُ وَالنَهَمُ",14,"م",1,0],["ساءلت من ملك العرا","ق فقيل لي غازي القريع",15,"ع",1,0],["ساءَلتَني عَنِ النَهارِ جُفوني","رَحِمَ اللَهُ يا جُفوني النَهارا",16,"ر",2,0],["ساءَت ظُنونُ الناسِ حَتّى أَحدَثوا","لِلشَكِّ في النورِ المُبينِ مَجالا",17,"ل",2,0],["ساءَلتُه عَن عِلمِه فكأنَّما","ساءلتُ عن سُكَّانِه رَبعاً خَلا",18,"ل",2,0],["ساءَلتُ أَجداثَ المُلوكِ فَأَخبَرَت","ني أَنَّهُم فيهِنَّ أَعضاءٌ وَهام",19,"م",1,0],["ساءَنا من شرَّها ما نجتوى","وعَنانا من أذاها ما نَذُمّْ",20,"م",1,0],["ساءَهُ اللّومُ فقلبٌ آسفٌ","يَتَّقِي اللَّهَ ونفسٌ مُوجَعَهْ",21,"ع",2,0],["ساءَ الزَمانُ وَأَوجَعَتكَ صُروفُهُ","وَعَسى الزَمانُ يُسِرُّبَعدَ قَليلِ",22,"ل",1,0],["ساءَكَ الدَهرُ بِها","وَقَديماً فَعَلا",23,"ل",2,0],["ساءَت بِكَ الدُنيا وَسَرَّت مَرَّةً","فَأَراكَ مِن حَسَناتِها وَذُنوبِها",24,"ب",3,0],["ساءَكَ الدَهرُ بِشَيءٍ","وَبِما سَرَّكَ أَكثَر",25,"ر",1,0],["ساءَ بَريّاً مِنَ البَرايا","مَن لَبِسَ الدينَ سابِرِيّا",26,"ر",3,1],["ساءَ الفَتى أَن قد أَقام ببقعة","لَيسَ الفَتى يَوماً بها بمكرم",27,"م",1,0],["ساءلتها مستعلماً عَن أَهلها","فوددت لَو تتكلم الأحجار",28,"ر",1,0],["ساءلت شيخا قد تحد","دبَ ما تفتش في التراب",29,"ب",1,1],["ساءه الدهر ومازال يسوء","ما عليه لو أسا ما جرحا",30,"ح",2,0],["ساءَهُ ما بِنا تَبَيَّنَ في الأَي","دي وإشناقُها إلَى الأَعناقِ",31,"ق",1,0],["سَاءَنِي مَا تشْتَكِي يَا ابْنَ أَخِي","رَاجِعِ الحَزْمَ فَمَا يُجْدِي اكْتِئَابِ",32,"ب",1,1],["ساءَ بديلٌ حَملتُ مِنهُ","ما هَدَّ مِنّي أَشَمَّ راسِ",33,"س",1,0],["ساءَني المِقدارُ فيهِ","وَالَّذي يَلقَونَ أَسوا",34,"و",2,0],["ساءَني يا بُنَيَّ حَجزُكَ عَنّي","سرّكَ اللَهُ هَل يَسوءُكَ حَجزي",35,"ز",2,0],["ساءلت حين قضى عليٌّ فجأة","هل حلّ يومُ الحشرِ قبل أوانه",36,"ن",2,0],["ساءني، يا بنّي أنك نجلا","لِي فكانت أبوَّتي لك داءك",37,"ك",1,0],["ساءلت عن دمه، فقالوا: زئبق","في كل عرق من نحاس قد جرى",38,"ر",2,0],["ساءلتُ نفسي: أحقًّا هذه حلبٌ؟","ورُحتُ أَلْثَمُهَا أرضًا وجُدرانا",39,"ن",2,0],["ساءت نهاريَّ يقظاناً فجائعُها","وسئن ليليَ إذ صُوِّرْنَ لي حلما",40,"م",2,0],["ساءَ بَريّاً، من البرايا،-- منْ لبسَ الدينَ سابريّا","إن كَسَرتَني يَد المَنايا، -- فَما الأطبّاءُ جابريّا",41,"ر",3,1],["ساءنا من شرها ما نجتوى","وعنانا من أذاها ما تذم",42,"م",1,0],["ساءلتها إفضالها","مدّت إليك مبالها",43,"ل",3,0],["ساءَت خلائقهُ ضلّت طرائقهُ","قَد تاهَ بالتيهِ في تيهاء سبسبهِ",44,"ب",2,0],["ساءَهم أن أعيش صبّا أناغيهم","بأشعاري الرقاق العذاب",45,"ب",1,0],["ساءلتْ عن مصابها","فتنادى يجيبُها",46,"ب",3,0],["ساءت ظُنوني بأملاكٍ مُطَهّرةٍ","إذ تعشقُ الخودُ نخَّاساً وفرّاشا",47,"ش",2,0],["ساء الردى ثم ساوى في حكومته","أيبتغي العدل في الأحكام من عسفا",48,"ف",2,0],["ساءَلته ما خطبُه فتدفَّقتْ","منه الدموعُ فما استطاع مقالا",49,"ل",2,0],["ساءَلت طالِعَها بِماذا يا تُرى","أَرخَت بِاللَهِ العَظيمُ قِرانَها",50,"ن",3,0],["سَاءَلْتُهُ ماالذي تَشْكُو فَأَنشَدني","ضَيْفٌ أَلَمَّ بِرأْسي غَيرُ مُحتَشِمِ",51,"م",1,0],["ساءَ وَرَدَّ خادَرُ تَعتادُهُ","لَها حِمى وَغَيرُهُ لَم يُعدَدِ",52,"د",1,0],["ساءَهُ ضَربُ يَدٍ تَظلِمُني","وَاِشتَهى يَحمِلُ عَنّي ما حَمَل",53,"ل",1,0],["ساءَنا ما سرَّنا من عيِشِنَا","بعدَ ما رَاق لنا مرأىً ومَجْنَى",54,"ن",2,0],["سَاءَ ظَنّي باصْطِبَارِي بعدَكُم","ولقد كنتُ به أُحسِنُ ظَنّا",54,"ن",2,0],["ساءنا الدهرُ مأخذاً ونزاعا","واتّصالاً وفرقةً واجتماعا",55,"ع",2,0],["ساءني منه لعمري شَرَفٌ","ليَ من تلك الحروف الثُلثان",56,"ن",1,0],["ساءَ طبعاً حتى على ذاته جار","فأعطى كف الزوال دوامه",57,"م",2,0],["ساءَ وسرَّ الناسَ في حكمه","فهو لديهم عادِلٌ جائِرُ",58,"ر",1,0],["ساءلتها لما تأملتها","عن عشقها مثلي المجانينا",59,"ن",2,0],["ساءهم حفظِيَ فيكم وعكوفي","جانبَ الغيب عليكم واشتمالي",60,"ل",2,0],["ساءت ظنونكمُ بجفنٍ ساهرٍ","فسمعتمُ كذب الخيال الطارق",61,"ق",1,0],["ساءلتنا ما جرى","وعلى م الجدل",62,"ل",1,0],["ساءلت قلبي في الهوى","عما يراه فسائلي",63,"ل",2,0],["ساء التصرف في حزن وفي فرح","راهن بما شئت من تلقاه مقتنعا",64,"ع",2,0],["ساءَ ظنِّي بشُؤُني كلِّها","إنَّ سوءَ الظَّنِّ من أَزكى الفِطَنْ",65,"ن",1,0],["ساءَتْ خلائِقُهم فساءَ فلا أرى","شيئاً به إلّا عليّاً يُمدَحُ",66,"ح",1,0],["ساءلت أبله قلبي في السلو وقد","يقال للبله في الدنيا إصابات",67,"ت",1,0],["ساء فالٌ لَهم فقد حَسِبوها","لَهُمُ قَصراً لكنَ ألفوَه قبرا",68,"ر",2,0],["ساءَ عَهدي لِقاطنيك مَتى أَذْ","رَيتُ دمعاً من مُقلتي لا يصوبُ",69,"ب",1,0],["ساءته مني عجرفِيّةُ قلّبٍ","باق على مرّ الحوادث حوّل",70,"ل",1,0],["ساءَ الفَقيهَ بِأَنَّني مُتَخَلِّعٌ","وَيَسُرُّني أَنَّ الفَقيهَ قَطيمُ",71,"م",1,0],["ساء الفضائل ما دهاك","فمتى أرى الآسي شفاك",72,"ك",1,0],["ساءني ما جزعت منه وأضنا","نيَ أني رأيتك اليوم مضنى",73,"ن",2,0],["ساء فعلي واسود أبيض قلبي","ما احتيالي وقد عصيت الجليلا",74,"ل",2,0],["ساءل الناس يوم أودى أراح الغيث","جاد الجديب منه هتونُ",75,"ن",1,0],["ساءَ اهل الحسن قدراً وسما","وعَلَى حاليَ بالاشفاقِ فاق",76,"ق",1,0],["ساءت عواطف بغية بشريَّةٍ","فاضلَّت الطبعَ السليمَ تغفُّلا",77,"ل",2,0],["ساءَ خُلقِي مِن بعدِه ولقد","كنتُ لمَّا كنت ذا سجايا حِسانِ",78,"ن",1,0],["ساءَني ما أَصَبت فيها وَلَكن","سَرَني مِنهُ خَيبة العَشار",79,"ر",1,0],["ساء الاسى بربيع الفضل في رجب","وسامنا بخطوب الدهر والعبر",80,"ر",1,0],["ساءه ان لا يري في قومه","رفعة الشورى ومجد العرب",81,"ب",1,0],["ساءَ فيها خَلْقي وخُلقي إلى أنْ","لو رآني العدوًّ يوماً رثى لي",82,"ل",2,0],["ساءَ حظ البلاد أجمعها","ليس فيها لشاعر وطنُ",83,"ن",1,1],["سَاءَلْتَ أَحْفَادَ القُبُورِ مُيَمِّمَاً","شَطْرَ الْغُروبٍ بِنَبْرَةٍ تَتَقَددُّ",84,"د",1,0],["ساء والله وهمكم أيّ سوء","واتخذتم مواطيء الرجل هامه",85,"م",2,0],["ساءك الدهر وهو شيء عجيب","كيف لم يرهب الخميس العرمرم",86,"م",1,0],["ساءهم يا مصر إدراك العُلا","فَرَموك بالرزايا والنكَد",87,"د",1,0],["ساءَت ظنونكُم بي وَالظنونُ متى","ساءَت فحتى السَلامُ المحضُ مِصداقُ",88,"ق",1,0],["ساءَ الحُسَينَ قتلُهُ وهَدّه","إذ كان خيرَ صاحب أعَدّه",89,"ه",1,0],["ساءَني أَن يَرى العَدُوُّ الحَبيبا","فَوقَ جِذعٍ مِنَ الجُذوعِ صَليبا",90,"ب",2,1],["ساءوا وساء صَنيعُهم باءوا","بسوءِ المُنْقَلَب",91,"ب",1,0],["ساءلتها خجلاً أما لك حاجة","عندي فقالت ساخر وحروب",92,"ب",1,0],["ساءهم في الخلد أن لا يُحسدوا","ومن الحساد من تطلبه",93,"ه",1,0],["ساء بني فيلوس أن قد نزحا","عنهم وجهد العي فيهم برحا",94,"ح",2,0],["ساءَ صندِيدَ لِيقيا أَن رآه","يَخرُقُ الجَيشَ صائِلاً بِقُواهُ",95,"ه",1,0],["ساءَني أَنكَ لا تَرعَى ذِمامَك","لِحَبيبِ اليَومِ وَالعَهدِ الأَخير",96,"ر",1,0],["ساءَلوني في وَفاءٍ خالِصٍ","كَيفَ لَم أَحفَظ وَلَم أَرعَ الذِمَمْ",97,"م",1,0],["ساءَتنيَ قُبلَةٌ عَدَت مَوضعها","من فيه فَثنَّيتُ لِكَي أُتبِعَها",98,"ه",2,1],["ساءت صنائعهم لدي وأودعوا","قلبي لعمرك حرقةً ولهيبا",99,"ب",2,0],["ساءوا وقد بقيتْ لهم في مسكد","والمعقلين قليلةٌ أنفارُ",100,"ر",1,0],["ساءَ ما ظَنّوا وَقَد أَبلَيتُهُم","عِندَ غاياتِ المَدى كَيفَ أَقَع",101,"ع",1,0],["ساءَ الأَقارِبَ يَومَ ذاكَ فَأَصبَحوا","بِهَجينَ قَد سَرّوا بِهِ الحُسّادُ",102,"د",1,0],["ساءلت يوما من شكا من شر ما","يلقى من الدنيا الغرور وما لقى",103,"ق",2,1],["ساءلتها عمن يجاب دعاؤه","لعلاء سودده فقالت احمد",104,"د",1,0],["ساءهم بُعدُ سبطهم عن حماهم","فاووا منه غيثَ فضلٍ مريعا",105,"ع",2,0],["ساءلتُ شبّاكَ حلوتي فأبى","وصارَ في بخلِهِ يماثلها",106,"ل",3,0],["سَاء