{"poems":[[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[71,"خبروني عن اسم جمع وإن شئت","https://www.aldiwan.net/poem3840.html","الخفيف"],[93,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[93,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[72,"سائلي اليوم كيف حالي في القس","https://www.aldiwan.net/poem18410.html","الخفيف"],[91,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[92,"كل قلب حمل الخسف وما","https://www.aldiwan.net/poem38921.html","الرمل"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[61,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[81,"كل قاص يدنو إلي كأني","https://www.aldiwan.net/poem61349.html","الطويل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[8,"إن قومي عز نصرهم","https://www.aldiwan.net/poem21833.html","المديد"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[18,"","https://poetry.dctabudhabi.ae/diwan/poem/17990","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[91,"سقوط بورت ارثور","https://www.poetsgate.com/ViewPoem.aspx?id=53022",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[18,"كلُّ قتيلٍ في كليبٍ حُلامْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26466&r=&rc=32",""],[115,"كل قصد بفضل أشرف هاد","https://www.aldiwan.net/poem41989.html","الخفيف"],[126,"خبّريني واسمعي مني اليقين","https://www.aldiwan.net/poem797.html",""],[186,"كل قبل أن يأكلك الدود","https://www.aldiwan.net/poem43950.html","السريع"],[189,"حي عني المليحة الحسناء","https://www.aldiwan.net/poem35144.html","الخفيف"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[211,"كل قول من وصيف","https://www.aldiwan.net/poem46286.html","مجزوء الرمل"],[223,"أحبها وأحبته","https://www.aldiwan.net/poem39717.html","الخفيف"],[235,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[270,"ها ردفها يأخذ من صدرها","https://www.aldiwan.net/poem35390.html","السريع"],[328,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[348,"منعتني من الوداع أمور","https://www.aldiwan.net/poem20237.html","الخفيف"],[348,"كل قلب علي كالصخر ما لا","https://www.aldiwan.net/poem20272.html","الخفيف"],[361,"سيدي بالذي أمدك بالحسن","https://www.aldiwan.net/poem68074.html","الخفيف"],[364,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[364,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[403,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[405,"كل قليلا تعش طولا وتسلم","https://www.aldiwan.net/poem49649.html","الخفيف"],[446,"كل قتيل في كليب حلان","https://www.aldiwan.net/poem23921.html","الرجز"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[464,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[465,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[482,"لما يرى حبها فؤادي","https://www.aldiwan.net/poem24552.html","عموديه"],[509,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[551,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[551,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[558,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[558,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[558,"بسط الله لي بساط الوجود","https://www.aldiwan.net/poem34593.html","الخفيف"],[562,"شاب شعري نظير ما شاب شعري","https://www.aldiwan.net/poem52740.html","الخفيف"],[575,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"]],"verses":[["كَلَقاحٍ تَأبى عَلى العَصبِ دَرّاً","وَعَلى المَسحِ تَستَهِلُّ غِزارا",0,"ر",2,0],["كُلُّ قَلبٍ بِقَلبِهِ مُستَهامٌ","وَهوَ إِن خَبَّروا بِهِ الصَبَّ حَتفُ",1,"ف",1,0],["كُلُّ قُوَى التَّشْتِيتِ فِي لِينِهِ","وَكُّلُّ بَطْشِ البَيْنِ فِي شَدِّهِ",2,"د",2,0],["كُلٌّ قِضَتْهُ مِصْرُ حَقَّ وَدَاعِهِ","بِمُخَلَّدَاتِ الذِّكْرِ فِي الأَذْهَانِ",3,"ن",1,0],["كُلُّ قَاصٍ دَنَا بِمَا أَبْدَعَ العِ","لْمُ إِلَى أَنْ تَلامَسَ القُطْبَانِ",4,"ن",1,0],["كُلُّ قُطْرٍ لِلْعُرْبِ فِيهِ مَقَامٌ","أَوْ مَقَالٌ لَهُ بِهِ تَأْبِينُ",5,"ن",1,0],["كلُّ قاضٍ يرى أسيرَ شهودٍ","وأنا شاهدٌ أسير القضاة",6,"ه",1,0],["كُلُّ قَلبٍ لَهُ السَماءُ الَّذي يَهوى","وَإِن شِئتَ كُلُّ قَلبٍ سَماءُ",7,"ا",2,0],["كُلُّ قِرمٍ عَلَيهِ دِرعٌ مِنَ الصَبرِ","وَدِرعٌ مَسرودَةٌ مِن حَديدِ",8,"د",1,0],["كُلُّ قلبٍ حَمَلَ الخَسْفَ ومَا","مَلَّ مِنْ ذُلِّ الحَيَاةِ الأَرْذَلِ",9,"ل",1,1],["كُلُّ قَبرٍ مِن جانِبِ القَفرِ يَبدو","عَلَمَ الحَقِّ أَو مَنارَ المَعادِ",10,"د",1,0],["كلُّ قولي لكَ ما هذا ندىً","حين قولي لأُناسٍ ما أشحّ",11,"ح",1,0],["كلّ قطر منه يلقى مشرباً","من جداه ولقد كان سرب",12,"ب",1,0],["كُلُّ قَاصٍ يَدنُو إلَيَّ كأنَي","نُصِلَت أسهُمي بِسَعدِ الأمِيرِ",13,"ر",1,1],["كُلُّ قَلبٍ لَهُ هَواه ولَكن","لَيسَ يَدري مَتى يَجيء زَمانُه",14,"ه",1,0],["كلُّ قومٍ كانَ سَعيُهُمُ","دُونَ ما يَسعَى بَنُو سَلَمَه",15,"م",2,0],["كُل قطْرٍ فِيهِ فَتىً عَرَبِيٌّ","فِيهِ عَيْنٌ شَكْرَى وَقَلْب صَادِي",16,"د",2,0],["كلُّ قصْرٍ مُتَدَاعٍ شَيَّدَتْ","بَعْدَهُ هَازِئَةُ الأَنْوَارِ قَصْرَا",17,"ر",2,0],["كُلُّ قَوْمٍ خَالِقُو نَيْرُونِهِمُ","قَيْصَرٌ قِيلَ لَهُ أَمْ قِيلَ كِسْرَى",17,"ر",2,0],["كُلُّ قَوْلٍ زَكَّاهُ فِعْلٌ شَرِيفٌ","وَتَجَافَاهُ كُلُّ فِعْلٍ مَهِينِ",18,"ن",1,0],["كُلُّ قَتيلٍ كُلَيبٍ حُلّام","حَتّى يَنالَ القَتلُ آلَ هَمّام",19,"م",1,1],["كلُّ قِرْنٍ لدى النضال يرى في","كَ لمعنى الوفاءِ للحق قِرنَا",20,"ن",2,0],["كلّ قرم درع من الصبر","ودرع مسرودة من حديد",21,"د",1,0],["كُلُّ قُبحٍ فِيِه …. قُبحُّ فِيكُمُ","فَأَعِيدُوهُ كَمَا كَانَ جَمِيلاَ",22,"ل",2,0],["كلُّ قتيلٍ في كليبٍ حُلامْ","حَتَّى يَنَالَ القَتْلُ آلَ هَمَّامْ",23,"م",1,1],["كل قصد بفضل أشرف هاد","جاء بالخير من طريق القبول",24,"ل",1,1],["كل قلب ناقص إلاّ به","وكمال القلب حب وقرين",25,"ن",1,0],["كل قبل أن يأكلك الدود","وأنت في الحفرة ملحود",26,"د",1,1],["كلُّ قَصرٍ وكلُّ برج سماءٍ","هو مِن دونها سناً وسناءَ",27,"ا",2,0],["كلُّ قومٍ يأتيهمُ كلّ يومٍ","منهُ شرعٌ أو غارةٌ شعواءُ",28,"ا",2,0],["كلُّ قِرنٍ منهم بغير قرينٍ","وَلَنِعمَ الثلاثةُ القرناءُ",28,"ا",2,0],["كلُّ قتلاهم بنارٍ وقتلا","نا لَديه في جنّةٍ أحياءُ",28,"ا",2,0],["كل قول من وصيف","باهر اللطف ظريف",29,"ف",1,1],["كُلَّ قَلبٍ لا يَشرَبُ الدَمُ في الحُ","بِّ وَلا يَرتَوي مِن الأَعماقِ",30,"ق",1,0],["كُلُّ قَتيلٍ بِلَحظِها وَبِتَو","قيعِ أَبي الفَضلِ ما لَهُ قَوَدُ",31,"د",1,0],["كلُّ قرينٍ بالقرينِ اقتَدَى","والخَبرُ الشائعُ من خبرها",32,"ر",3,0],["كل قلب حلت نبيلة فيه","حل فيه الهدى وحل الرجاء",33,"ا",2,0],["كُلُّ قَاسٍ عَليَّ كالدَّهْرِ مَا لا","نَ وَهَيْهاتَ أَنْ تَلِينَ الصُّخُورُ",34,"ر",1,0],["كُلُّ قَلْبٍ عَلَيَّ كالصَّخْرِ ما لا","نَ وَهَيْهاتَ أَنْ تَلِينَ الصُّخُورُ",35,"ر",1,1],["كُل قَلب سكنته لم تَدع في","هِ لِشَىء غَير الغَرام مَجالا",36,"ل",2,0],["كُلٌّ قَسيمُ أَبيهِ في تَشْيِيدِه","وتَرى الأمورَ إذا نظَرْتَ شُكولا",37,"ل",2,0],["كلُّ قومٍ أفاضَ قومٌ عليهم","خِلعاً ذاتَ بهجةٍ وبَهاء",38,"ا",2,0],["كل قول أقواله اليوم هذا","فهو كذب والعذر شأن الكرام",39,"م",1,0],["كُلْ قَليلاً تعِشْ طَولاً وتسْلَمْ","مِن عَوادِي الأسقامِ والأدْواءِ",40,"ا",2,1],["كُلُّ قَتيلٍ في كُلَيبٍ حُلّان","حَتّى يَنالَ القَتلُ آلَ شَيبان",41,"ن",1,1],["كلّ قناةٍ رُكزت على نَقاً","ينقص بدرُ التمّ من هلالها",42,"ل",3,0],["كل قدٍ ومثله لكن الذابلُ","قصدٌ والناضر الممشوق",43,"ق",1,0],["كُلُّ قَولٍ بِلا رضاكَ نِفاقُ","ليسَ قولاً ما لم تَقُلْ يا عراقُ",44,"ق",1,1],["كلُّ قَول ٍبِلا رِضاكَ نِفاقُ","وَحدَكَ الصَّوتُ والصَّدى يا عراقُ",44,"ق",1,0],["كل قتيل أراد وصلا","إن أسارى الغرام موتى",45,"ت",2,0],["كُلُّ قَومٍ نُبيحُهُم وَحِمانا","قَد مَنَعناهُ أَن يُباحَ سَبيلا",46,"ل",2,0],["كلُّ قَرْمٍ كاللّيث إنْ هجهجوه","عن صريعٍ له أزمَّ وأغضى",47,"ض",2,0],["كلُّ قَرْمٍ قد طاب أصلاً وفرعاً","وقديماً وحادثاً ونِجارا",48,"ر",2,0],["كل قول على العقول يشقُّ","ليس جمعاً وإنما هو فرقُ",49,"ق",1,1],["كل قلب لها يشاق إليها","وهو عبد قد حررته لديها",50,"ه",2,0],["كل قيد فإنه عرض لا","هو باق بل كالبروق الرعود",51,"د",1,0],["كلُّ قلبٍ لم ينصرفْ عن وَلاهُ","باتَ وَهْوَ الأمينُ مِن كلِّ كسرِ",52,"ر",1,0],["كل قولٍ يقوله نظم درٍّ","والذي قيل بعدَه نَظمُ وَدْع",53,"ع",1,0]]}