لْ.. حَكَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86225&r=&rc=23",""]],"verses":[["كَلَقاحٍ تَأبى عَلى العَصبِ دَرّاً","وَعَلى المَسحِ تَستَهِلُّ غِزارا",0,"ر",2,0],["كُلُّ قَلبٍ بِقَلبِهِ مُستَهامٌ","وَهوَ إِن خَبَّروا بِهِ الصَبَّ حَتفُ",1,"ف",1,0],["كُلُّ قُوَى التَّشْتِيتِ فِي لِينِهِ","وَكُّلُّ بَطْشِ البَيْنِ فِي شَدِّهِ",2,"د",2,0],["كُلٌّ قِضَتْهُ مِصْرُ حَقَّ وَدَاعِهِ","بِمُخَلَّدَاتِ الذِّكْرِ فِي الأَذْهَانِ",3,"ن",1,0],["كُلُّ قَاصٍ دَنَا بِمَا أَبْدَعَ العِ","لْمُ إِلَى أَنْ تَلامَسَ القُطْبَانِ",4,"ن",1,0],["كُلُّ قُطْرٍ لِلْعُرْبِ فِيهِ مَقَامٌ","أَوْ مَقَالٌ لَهُ بِهِ تَأْبِينُ",5,"ن",1,0],["كلُّ قاضٍ يرى أسيرَ شهودٍ","وأنا شاهدٌ أسير القضاة",6,"ه",1,0],["كُلُّ قَلبٍ لَهُ السَماءُ الَّذي يَهوى","وَإِن شِئتَ كُلُّ قَلبٍ سَماءُ",7,"ا",2,0],["كُلُّ قِرمٍ عَلَيهِ دِرعٌ مِنَ الصَبرِ","وَدِرعٌ مَسرودَةٌ مِن حَديدِ",8,"د",1,0],["كُلُّ قلبٍ حَمَلَ الخَسْفَ ومَا","مَلَّ مِنْ ذُلِّ الحَيَاةِ الأَرْذَلِ",9,"ل",1,1],["كُلُّ قَبرٍ مِن جانِبِ القَفرِ يَبدو","عَلَمَ الحَقِّ أَو مَنارَ المَعادِ",10,"د",1,0],["كلُّ قولي لكَ ما هذا ندىً","حين قولي لأُناسٍ ما أشحّ",11,"ح",1,0],["كُلُّ قَتيلٍ في كُلَيبٍ حُلّان","حَتّى يَنالَ القَتلُ آلَ شَيبان",12,"ن",1,1],["كلّ قطر منه يلقى مشرباً","من جداه ولقد كان سرب",13,"ب",1,0],["كُلُّ قَاصٍ يَدنُو إلَيَّ كأنَي","نُصِلَت أسهُمي بِسَعدِ الأمِيرِ",14,"ر",1,1],["كُلُّ قَلبٍ لَهُ هَواه ولَكن","لَيسَ يَدري مَتى يَجيء زَمانُه",15,"ه",1,0],["كلُّ قومٍ كانَ سَعيُهُمُ","دُونَ ما يَسعَى بَنُو سَلَمَه",16,"م",2,0],["كُل قطْرٍ فِيهِ فَتىً عَرَبِيٌّ","فِيهِ عَيْنٌ شَكْرَى وَقَلْب صَادِي",17,"د",2,0],["كلُّ قصْرٍ مُتَدَاعٍ شَيَّدَتْ","بَعْدَهُ هَازِئَةُ الأَنْوَارِ قَصْرَا",18,"ر",2,0],["كُلُّ قَوْمٍ خَالِقُو نَيْرُونِهِمُ","قَيْصَرٌ قِيلَ لَهُ أَمْ قِيلَ كِسْرَى",18,"ر",2,0],["كُلُّ قَوْلٍ زَكَّاهُ فِعْلٌ شَرِيفٌ","وَتَجَافَاهُ كُلُّ فِعْلٍ مَهِينِ",19,"ن",1,0],["كُلُّ قَتيلٍ كُلَيبٍ حُلّام","حَتّى يَنالَ القَتلُ آلَ هَمّام",20,"م",1,1],["كلُّ قِرْنٍ لدى النضال يرى في","كَ لمعنى الوفاءِ للحق قِرنَا",21,"ن",2,0],["كلّ قرم درع من الصبر","ودرع مسرودة من حديد",22,"د",1,0],["كُلُّ قُبحٍ فِيِه …. قُبحُّ فِيكُمُ","فَأَعِيدُوهُ كَمَا كَانَ جَمِيلاَ",23,"ل",2,0],["كلُّ قتيلٍ في كليبٍ حُلامْ","حَتَّى يَنَالَ القَتْلُ آلَ هَمَّامْ",24,"م",1,1],["كل قصد بفضل أشرف هاد","جاء بالخير من طريق القبول",25,"ل",1,1],["كل قلب ناقص إلاّ به","وكمال القلب حب وقرين",26,"ن",1,0],["كل قبل أن يأكلك الدود","وأنت في الحفرة ملحود",27,"د",1,1],["كلُّ قَصرٍ وكلُّ برج سماءٍ","هو مِن دونها سناً وسناءَ",28,"ا",2,0],["كلُّ قومٍ يأتيهمُ كلّ يومٍ","منهُ شرعٌ أو غارةٌ شعواءُ",29,"ا",2,0],["كلُّ قِرنٍ منهم بغير قرينٍ","وَلَنِعمَ الثلاثةُ القرناءُ",29,"ا",2,0],["كلُّ قتلاهم بنارٍ وقتلا","نا لَديه في جنّةٍ أحياءُ",29,"ا",2,0],["كل قول من وصيف","باهر اللطف ظريف",30,"ف",1,1],["كُلَّ قَلبٍ لا يَشرَبُ الدَمُ في الحُ","بِّ وَلا يَرتَوي مِن الأَعماقِ",31,"ق",1,0],["كُلُّ قَتيلٍ بِلَحظِها وَبِتَو","قيعِ أَبي الفَضلِ ما لَهُ قَوَدُ",32,"د",1,0],["كلُّ قرينٍ بالقرينِ اقتَدَى","والخَبرُ الشائعُ من خبرها",33,"ر",3,0],["كل قلب حلت نبيلة فيه","حل فيه الهدى وحل الرجاء",34,"ا",2,0],["كُلُّ قَاسٍ عَليَّ كالدَّهْرِ مَا لا","نَ وَهَيْهاتَ أَنْ تَلِينَ الصُّخُورُ",35,"ر",1,0],["كُلُّ قَلْبٍ عَلَيَّ كالصَّخْرِ ما لا","نَ وَهَيْهاتَ أَنْ تَلِينَ الصُّخُورُ",36,"ر",1,1],["كُل قَلب سكنته لم تَدع في","هِ لِشَىء غَير الغَرام مَجالا",37,"ل",2,0],["كُلٌّ قَسيمُ أَبيهِ في تَشْيِيدِه","وتَرى الأمورَ إذا نظَرْتَ شُكولا",38,"ل",2,0],["كلُّ قومٍ أفاضَ قومٌ عليهم","خِلعاً ذاتَ بهجةٍ وبَهاء",39,"ا",2,0],["كل قول أقواله اليوم هذا","فهو كذب والعذر شأن الكرام",40,"م",1,0],["كُلْ قَليلاً تعِشْ طَولاً وتسْلَمْ","مِن عَوادِي الأسقامِ والأدْواءِ",41,"ا",2,1],["كلّ قناةٍ رُكزت على نَقاً","ينقص بدرُ التمّ من هلالها",42,"ل",3,0],["كل قدٍ ومثله لكن الذابلُ","قصدٌ والناضر الممشوق",43,"ق",1,0],["كُلُّ قَولٍ بِلا رضاكَ نِفاقُ","ليسَ قولاً ما لم تَقُلْ يا عراقُ",44,"ق",1,1],["كلُّ قَول ٍبِلا رِضاكَ نِفاقُ","وَحدَكَ الصَّوتُ والصَّدى يا عراقُ",44,"ق",1,0],["كل قتيل أراد وصلا","إن أسارى الغرام موتى",45,"ت",2,0],["كُلُّ قَومٍ نُبيحُهُم وَحِمانا","قَد مَنَعناهُ أَن يُباحَ سَبيلا",46,"ل",2,0],["كلُّ قَرْمٍ كاللّيث إنْ هجهجوه","عن صريعٍ له أزمَّ وأغضى",47,"ض",2,0],["كلُّ قَرْمٍ قد طاب أصلاً وفرعاً","وقديماً وحادثاً ونِجارا",48,"ر",2,0],["كل قول على العقول يشقُّ","ليس جمعاً وإنما هو فرقُ",49,"ق",1,1],["كل قلب لها يشاق إليها","وهو عبد قد حررته لديها",50,"ه",2,0],["كل قيد فإنه عرض لا","هو باق بل كالبروق الرعود",51,"د",1,0],["كلُّ قلبٍ لم ينصرفْ عن وَلاهُ","باتَ وَهْوَ الأمينُ مِن كلِّ كسرِ",52,"ر",1,0],["كل قولٍ يقوله نظم درٍّ","والذي قيل بعدَه نَظمُ وَدْع",53,"ع",1,0],["كُلُّ قَومٍ وَجيههم لَم يُعِنْهم","فَوَجيهٌ أَن لا يَكونَ وَجيها",54,"ه",2,0],["كل قدٍّ يكاد يعقده اللي","ن وتثنيه خطرة الأوهام",55,"م",1,0],["كلُّ قلب لقد سلا","كل دمع همى وجف",56,"ف",1,0],["كُلُّ قَلبٍ لَكَ فيهِ مصحَفٌ","فيهِ مِن ذِكرِكَ قُرآنُ خُلودِ",57,"د",1,0],["كل قصرٍ لم ينعدم من قصور","غير قصرٍ تبوأتْه ذُراها",58,"ا",3,0],["كل قول فيه ثناء ومدح","بسوى آل جعفرٍ لا يصح",59,"ح",1,1],["كُلُّ قُفّ إذا حمينَ عليه","قُرِحٌ خاشِعُ القذَالِ شَجيجُ",60,"ج",1,0],["كل قول لك","أسطورة ورد وعبير",61,"ر",1,0],["كل قول يعز قائله فيك","ويسمو به إلى العلياء",62,"ا",2,0],["كُلُّ قَومٍ صيغَةٌ مِن فِضَّةٍ","وَبَنو عَبدِ مُنافٍ مِن ذَهَب",63,"ب",1,0],["كل قول يكون في القلب داع","للتداني فهو البشير النذير",64,"ر",1,0],["كُلُّ قِرنٍ يُعِدُّ سَيفاً كَليلاً","لِلِقاءٍ يَخونُهُ في اللِقاءِ",65,"ا",2,0],["كل قول انا خليفة سالف","منهم ولكن لا يقيم شهودا",66,"د",2,0],["كلُّ قلب يدري الحياة سجينٌ","طائرٌ ينشد السُّهى أَوكارا",67,"ر",2,0],["كُلُّ قُطْبِ يَطُوفُ بالبَيْتِ سَبْعاً","وَأَنَا الْبَيْتُ طَائِفٌ بِخِيَامِي",68,"م",2,0],["كل قبيحٍ كنت أحرزته","حسّنه حسن سجاياهم",69,"م",1,0],["كلّ قلب يضمه صدر سرٍّ","وجهته يد الهوى تلقاها",70,"ا",3,0],["كل قوم حدت إليها عظيماً","وعلى حبها سعت بفناها",70,"ا",3,0],["كلُّ قلبٍ لفقدكَ اليومَ يبكى","آسفاً نادِباً صُرُوفَ الزَّمانِ",71,"ن",1,0],["كل قصر بعد الدمشق يذم","فيا طاب الجنى وفاح المشم",72,"م",1,1],["كلٌّ قَدِ استبَقَت عَلَيكَ دُموعُه","وَالوَجدُ يأمُرُه ولا يَنهاهُ",73,"ا",2,0],["كُلُّ قِرنٍ لَكَ يَخشى","وَقعَةً مِنكَ وَغارَه",74,"ر",2,0],["كلُّ قلبٍ يبغي الوصول إليه","معلم بالفراقِ منه تعالى",75,"ل",2,0],["كلُّ قلبٍ قد داخلته حظوظ","من كيانِ العلى فذا القلبُ ينجو",76,"و",1,0],["كلُّ قلب يراك يا من تعالى","فحقيق عليه أن يتجنَّى",77,"ن",2,0],["كل قوم لهم نذير ولكن","خلق السيف للئام نذيرا",78,"ر",2,0],["كل قريش قد حباني بنعمة","وأحسن إلا ثابت بن سباع",79,"ع",1,1],["كلّ قبيلٍ نفرٌ قِلّةٌ","وأنت ما أعرض ما أطولا",80,"ل",2,0],["كُلُّ قَلبٍ في حُبِّهِ قَد تَوالى","كَيفَ لا واسمُهُ سَمِيُّ الوَصِيِّ",81,"ي",1,0],["كلُّ قلبٍ لحُسنِهِ","في هواه قد انسَلَك",82,"ك",1,0],["كل قبيح كنت أسلفته","محصه حبي إياهم",83,"م",1,0],["كل قصدي من نظم شعري إرضاء","شعوري وإن دعا لاضطهادي",84,"د",2,0],["كل قلب يطيق صبراً عليهِ","فَهو أقوى من شامخات الجبالِ",85,"ل",1,0],["كل قلب أنت ساكنهُ","حُقَّ أن يلقي عصا سفرِه",86,"ر",2,0],["كل قوت وشرابٍ","ما سوى هذا محالُ",87,"ل",1,0],["كل قول أثنى عليه بحمد","حققته الأعمال فهي شهوده",88,"د",2,0],["كل قطر تراه يخلق لفظا","قد تعدى المناهج العربيه",89,"ي",2,0],["كل قلب بالمال يقوى ويضعف","صبغ اللَه أوجه البيض والصف",90,"ف",1,0],["كلٌّ قضى نحبه وما قضيت","منها المنى وانقضى بلا طائلْ",91,"ل",1,0],["كُلُّ قلبٍ منّا بها في اشْتِغالٍ","كُلُّ جسمٍ منها رَهينُ اشتِعالِ",92,"ل",1,0],["كل قلب لها محبٌّ سوى الشم","س من الغيظ ناصبتها عداها",93,"ا",3,0],["كلّ قَصْر مشيّدٍ ذي أَوَاسٍ","تتغَنَّى عَلى ذُرَاهُ الحَمَامُ",94,"م",1,0],["كل قالٍ لكم فأبعده الل","ه وعن حوضكم هنالك ذاده",95,"د",2,0],["كل قد للفتك فيه مجال","تتلوى به القنا والصفاح",96,"ح",1,0],["كلّ قصر بعد الدمشق يذّم","فيه طاب الجنى ولذّ المشم",97,"م",1,1],["كلُّ قِنطارِ لَوعةٍ وزفيرِ","في زفيري ولَوعَتي قِيراطُ",98,"ط",1,0],["كلُّ قول بغير عُلياه لا يخلو","مِن الخًلقِ أو من الإطراء",99,"ا",2,0],["كل قبيلٍ لم يفُتْهُ حزمُ","لم يكنْ يَغْلبُ ذاكَ خَصْمُ",100,"م",1,0],["كُلٌّ قَد أَسلَمَهُ وَلَم يُبقِ الرَجا","لِلعَبدِ إِلّا فيكَ لا أَعوانِهِ",101,"ن",2,0],["كل قصرٍ قصرٌ عليه المزايا","وعليه ثوب الثناء قصير",102,"ر",1,0],["كل قولٍ تقوله فالمحافل يصير","كلمة الحق منك السيف قص الرقاب",103,"ب",1,0],["كل قول له فضيلة وكل فعل له زكيا","لو تمسكنا بنهجه ما رضخنا للبقية",104