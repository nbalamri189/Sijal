{"poems":[[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[74,"أناعسة الأجفان أسهرت مكمدا","https://www.aldiwan.net/poem18553.html","الطويل"],[53,"بني صامت قد أصبحت دار خالد","https://www.aldiwan.net/poem64049.html","الطويل"],[93,"أقامت لدى مرآتها تتأمل","https://www.aldiwan.net/poem9057.html","عموديه"],[48,"أدنياي اذهبي وسواي أمي","https://www.aldiwan.net/poem23401.html","الوافر"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[164,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[208,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[285,"ألا يا محرقي بالنار مهلا","https://www.aldiwan.net/poem60747.html","الوافر"],[308,"وقائلة فيم اجتهادك للغنى","https://www.aldiwan.net/poem58245.html","الطويل"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[369,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[369,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[422,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[473,"قد نال خيرون خيرا ليس يكفره","https://www.aldiwan.net/poem60022.html","البسيط"],[498,"حصلت من الهوى بك في محل","https://www.aldiwan.net/poem67349.html","الوافر"],[556,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[563,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122771","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122711","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122793","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37894","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16713","المتقارب"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109033","الوافر"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110697","الوافر"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26220","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204976","السريع"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99313","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89301","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62785","المتقارب"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131290",""],[4113,"","https://poetry.dctabudhabi.ae/diwan/poem/145508","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120317","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139556",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"حجمي صغير","https://www.poetsgate.com/ViewPoem.aspx?id=181864",""]],"verses":[["فَلَو وَجَدَ الحَمامُ كَما وَجَدنا","بِسُلمانينَ لَاِكتَأَبَ الحَمامُ",0,"م",1,0],["فلو وكفانا الله وُليَ غيركم","لما راح في شيء يجيد ولا غدا",1,"د",2,0],["فلو وافقتْهم ليلة القدر لم تزل","تَقاعس عن ميقاتهم آخرَ الدهر",2,"ر",1,0],["فَلَو وَجَدَتيَوماً عَلى الدَهرِ غادَةً","لَأَوشَكَ مِن غَلَوائِهِ يَتَحَوَّلُ",3,"ل",1,0],["فَلَو وُفِّقتِ لَم تَسقي جَنيناً","وَلَم تَضَعي الوَليدَ وَلَم تُهَمّي",4,"م",2,0],["فَلَو وَصَلَت أَبواعُهُم ما تَطاوَلَت","إِلَيهِ مُناهُم كانَ فِترُكَ أَطوَلا",5,"ل",2,0],["فلو وكلت حاجاتها الأسد في الشرى","إلى غيرها ما غمضت همم الأسد",6,"د",1,0],["فلو وُلد المولود بالصين فارهاً","أتتني به الأخبار ركضاً على البُردِ",7,"د",1,0],["فَلوْ واصَلْتَنِي يَوْماً لأَوْدى","بِجِسْمِي مَسُّ جِسْمِكَ بِالْعِناقِ",8,"ق",1,0],["فلو وجدت كفي لبرأت ساحتي","وكنت أريك الجود كيف يكون",9,"ن",1,0],["فَلَو وَلاّه ذاكَ الملكَ وَلّى","أَمِينا لا يخونُ ولا يَضِيعُ",10,"ع",1,0],["فلو وقَفوا في ظلِّ رُمْحٍ ونَوَّخوا","لضَمّهُمُ والعِيسَ فيه مَقيل",11,"ل",1,0],["فلو وجَد الهلالُ له طريقاً","إلى عُلْياكَ كان لها طِراقا",12,"ق",2,0],["فلو وزنت ملوك الأرض قاطبة","لزادهم في الندى والبأس رحجانا",13,"ن",2,0],["فلو وجدت زُهرُ النجوم ترقّياً","إليهِ لغضَّ السائلين ازدحامها",14,"م",3,0],["فَلَو وُليتُ عَلى الكُتّابِ مُحتَسِباً","لَكانَ أَوَّلَ قُبطِيٍّ أُدَرِّرُهُ",15,"ر",2,0],["فَلَو واصَلت ما نَقَصَ اِشتِياقي","كَما لَو بِنتَ ما زادَ اِشتِياقي",16,"ي",1,0],["فلو وَقَتْكَ من الأقدار واقيةٌ","حماك كلُّ طَلوعِ النَّجد مِغْوارِ",17,"ر",1,0],["فلو وفق الرحمن ذلك للهدى","رأى نقصه في نفسه فيجاهد",18,"د",1,0],["فَلَو وازَنَتكَ الخَلقُ حِلماً وَضِعفُها","رَجَحتَ بِهِم يا جَعفَرَ بنَ أَبي الفَهمِ",19,"م",1,0],["فَلَو وَهَبَ الدُّنيا وَما بَينَ كَونِها","لِعافٍ رَأى أنَّ الكَثيرَ قَليلُ",20,"ل",1,0],["فَلَو وُزِنَت مِنَ الكُرَماءِ أَلفٌ","بِظِفرٍ مِنهُ ما رَجَحُوهُ وَزنا",21,"ن",2,0],["فَلَو ودَّ مَتنَ العزِّ يَركَبُه غَدَت","تودُّ المعالي أنهنّ نجائبُ",22,"ب",1,0],["فَلو وشّحت بالحجل والحجل صامتٌ","لعاينتهُ في خصرها وهو حائلُ",23,"ل",1,0],["فَلَو وَلَغَ الكَلبُ في لُؤمِهِ","لَما زالَ يَقذُفُ أَمعاءُهُ",24,"ا",3,0],["فلو وصلت شرائعهم إلينا","على ما نحن فيه من المجون",25,"ن",1,1],["فلو وافاه يوم الجدب عاف","أباح له حمى روض الرعايه",26,"ا",3,0],["فَلَو وَصَلَت عُمري اللَيالي لِوَقتِهِ","لَقالَت لَهُ الأَشعارُ ما قالَت النَملُ",27,"ل",1,0],["فلو وعاني لاقتفى شرعتي","فكان لا ظلم ولا ظالم",28,"م",1,0],["فلو وصبغ الراح يخضب راحتي","واغدو بعضو من دمي قد تخضبا",29,"ب",2,0],["فلو وزنت بما فيها","لما ازدادت من الثقل",30,"ل",1,0],["فلو وجدَ الغيثُ من ناصرٍ","لنازَعكَ الغيثُ أمراً خَطِيرا",31,"ر",2,0],["فلو وزّعتُ من المي وهمي","لغيّبتُ البسيطة في قتام",32,"م",1,0],["فلو وفى لك أصحابٌ بما وعدوا","لمس عرشك في عليائه الكتبا",33,"ب",2,0],["فلو وطئ الصخر الأصم تفجرت","ينابيع ماء منه فاعتم بالعشب",34,"ب",1,0],["فلو وافتهم من بعد دهر","لقالوا بئس فاجئة الرزايا",35,"ي",2,0],["فلو وفت الدنيا ذماما لأهلها","لما أعقبت بالغدر منها العواقب",36,"ب",1,0],["فَلَو وُشِّحَتْ بِالحِجْلِ وَالحِجْلُ صامِتٌ","لَعايَنْتَهُ فِي خَصْرِها وَهوَ جائِلُ",37,"ل",1,0],["فلو وزنته الكائنات تضاءلت","وضعضع منها الركن من سر منعتي",38,"ت",2,0],["فلو وَفْق الفحولةِ كلُّ حجمٍ","لغار الطُّود مني والسفينةْ",39,"ن",2,0]]}