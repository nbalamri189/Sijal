{"poems":[[55,"الليل ينصل بين الحوض والعطن","https://www.aldiwan.net/poem29662.html","البسيط"],[55,"أشكو إليك مدامعا تكف","https://www.aldiwan.net/poem29967.html","الكامل"],[55,"شرف الخلافة يا بني العباس","https://www.aldiwan.net/poem30200.html","الكامل"],[57,"قد كنت أعلم يا ظلوم","https://www.aldiwan.net/poem26110.html","مجزوء الكامل"],[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[32,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[90,"لا تبك أربعهم ولا الأطلالا","https://www.aldiwan.net/poem44425.html","الكامل"],[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[23,"هل سر أولاد اللقيطة أننا","https://www.aldiwan.net/poem21401.html","الكامل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[93,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[93,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[87,"بعدت ديار واحتوتك ديار","https://www.aldiwan.net/poem7354.html","الكامل"],[87,"ما زلت أسكب دمع عيني باكيا","https://www.aldiwan.net/poem7791.html","الكامل"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[63,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[63,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[18,"يا حار لا تجهل على أشياخنا","https://www.aldiwan.net/poem23928.html","الكامل"],[18,"أثبت مرة والسيوف شواهر","https://www.aldiwan.net/poem23929.html","الكامل"],[18,"لما نعى الناعي كليباً أظلمت","https://www.aldiwan.net/poem23944.html","الكامل"],[46,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[92,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[50,"الحمد لله هذا أعجب العجب","https://www.aldiwan.net/poem62431.html","البسيط"],[50,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202541","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[22,"طافت أُمامة ُ بالرُكبان آوِنَة ً","https://www.poetsgate.com/ViewPoem.aspx?id=19728",""],[92,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[53,"بدرٌ وشمس وَلَدَا كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=27044",""],[90,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""],[18,"لما نعى الناعي كليباً أظلمتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26450&r=&rc=16",""],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[148,"بك ذا الجلال أدعو فارحمني وقل","https://www.aldiwan.net/poem4457.html","الكامل"],[164,"أيامنا بك كلها أعياد","https://www.aldiwan.net/poem58841.html","الكامل"],[175,"هاتيك يا صاح ربا لعلع","https://www.aldiwan.net/poem4267.html","الرجز"],[233,"يا من حوى الفضل وحاز الفخرا","https://www.aldiwan.net/poem51069.html","الرجز"],[265,"ما بالتعلل بالأوطان أوطار","https://www.aldiwan.net/poem38320.html","البسيط"],[275,"أتحب مسئلة بغير جواب","https://www.aldiwan.net/poem52114.html","الكامل"],[286,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[286,"هات اسقني الراح في الياقوت كالذهب","https://www.aldiwan.net/poem32872.html","البسيط"],[309,"زار الوزير مقام غوث صرفا","https://www.aldiwan.net/poem56472.html","الكامل"],[352,"يارب لا تشمت بنا حمزه","https://www.aldiwan.net/poem20391.html","السريع"],[357,"ليهن ورق الحمى في الأيك تغريد","https://www.aldiwan.net/poem40400.html","البسيط"],[368,"أأراكة الوادي سقتك غيوث","https://www.aldiwan.net/poem60972.html","الكامل"],[375,"طالت لجاجة آيس متقاضي","https://www.aldiwan.net/poem57349.html","الكامل"],[375,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[375,"هذا وكم مترشح","https://www.aldiwan.net/poem57444.html","مجزوء الكامل"],[384,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[407,"وافى إلى سوح الأمير","https://www.aldiwan.net/poem33909.html","مجزوء الكامل"],[407,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[426,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[436,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[441,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[443,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[456,"لا الرمز يغني ولا التصريح يرضيني","https://www.aldiwan.net/poem61353.html","البسيط"],[461,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[461,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[461,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[468,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[468,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[480,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[517,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[518,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[561,"قوموا بنا كلنا نخرق حجاب الطبع","https://www.aldiwan.net/poem34381.html","المواليا"],[561,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[564,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[589,"ما شئت من عبء الغرام وحمله","https://www.aldiwan.net/poem17688.html","الكامل"],[512,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10478","البسيط"]],"verses":[["حَتّى نَظَرتُ وَلَي عَينٌ مُؤَرَّقَةٌ","تُقَسَّمُ الدَمعَ بَينَ الرَبعِ وَالظُعُنِ",0,"ن",1,0],["حَتّى نَضا الإِظلامُ صَبغَتَهُ","وَطَواهُ جَونُ اللَيلِ مُنكَشِفُ",1,"ف",1,0],["حَتّى نَبا بِهِمُ الزَمانُ فَأُزعِجوا","عَن تِلكُمُ الأَغيالِ وَالأَخياسِ",2,"س",1,0],["حَتّى نَقَضتِ عُهودَنا","وَالعَهدُ يَنقُضُهُ الظَلومُ",3,"م",1,0],["حَتّى نَعى الناعي أَبا حَسَنٍ","فَوَدَدتُ لَو كُنتُ الَّذي يُنعى",4,"ع",2,0],["حَتّى نِساءُ تَميمٍ وَهيَ نائِيَةٌ","بِقُلَّةِ الحَزنِ فَالصَمّانِ فَالعَقَدِ",5,"د",1,0],["حتى نخيل الجانَببين جمعها","قامت له بحفارة اجلالا",6,"ل",2,0],["حتى نزلت من الشوير بجنّة","فيها الحياة كثيرة الألوان",7,"ن",1,0],["حَتّى نُبيلَ الخَيلَ في عَرَصاتِكُم","وَنَؤوبَ بِالمَلِكاتِ وَالأَولادِ",8,"د",1,0],["حتَّى نزلنا بمكانٍ مونق","إخوان صدقٍ أحدق بالملّق",9,"ق",1,0],["حتى نراهُ جالساً بينهم","أجلَّ من رَضوى ومن كَبْكَبا",10,"ب",2,0],["حَتّى نَسَينا كَيفَ لَونُ الضُحى","وَلَم نَعُد نَذكُرُ سَجعَ الحِمام",11,"م",1,0],["حَتّى نَظَرتُ إِلَيها في جَلالَتِها","فَصارَ كُلُّ يَقيني أَنَّهُ فيها",12,"ي",3,0],["حتى نزلت بباكرين إلى القرى","متهللين كأنهم أقمار",13,"ر",1,0],["حتى نظرت إلى الوجود بمقلة","ذهبت غشاوتها وطرف رائد",14,"د",1,0],["حَتّى نَزَلتُم بُقعَةً فيها الهَوى","مِن قَبلُ ثاوٍ وَالسَماحُ نَزيلُ",15,"ل",1,0],["حتى نراه وحَدُّ السَّيفِ في يدِهِ","مُثَلَّمٌ وسِنانُ الرُّمحِ مَأْطُورُ",16,"ر",1,0],["حتى نصبتَ على رَغم الصليبِ بها","منابرَ الدينِ مسموعاً بها الخُطَبُ",17,"ب",1,0],["حَتّى نَبيدَ قَبيلَةً وَقَبيلَةً","قَهراً وَنَفلِقَ بِالسُيوفِ الهامِ",18,"م",1,0],["حَتّى نَرى غُرَراً تُجَرُّ وَجُمَّةً","وَعِظامَ رُؤسٍ هُشِّمَت بِعِظامِ",19,"م",1,0],["حَتّى نَرى أَوصالَهُم وَنجَماجِماً","مِنهُم عَلَيها الخامِعاتُ وُقوقا",20,"ق",2,0],["حَتّى نَقَضتَ الرومَ مِنكَ بِوَقعَةٍ","شَنعاءَ لَيسَ لِنَقضِها إِبرامُ",21,"م",1,0],["حتى نزلنا بساحٍ منكِ مُحتضِنٍ","رأد الضُحى والنَّدى والرملَ والطّينا",22,"ن",2,0],["حَتّى نَجَوتُ وَلَمّا يَنزِعوا سَلَبي","بِوالِهٍ مِن قَبيضِ الشَدِّ غَيداقِ",23,"ق",1,0],["حَتّى نَفاهُ مِن تُخومِ فارِسِ","وَبانَ عَنها بِضَميرٍ آيِسِ",24,"س",1,0],["حَتّى نَراكَ وَقَد دَرَّعتَهُ قُمُصاً","مِنَ الصَديدِ مَكانَ الليفِ وَالكَرَبِ",25,"ب",1,0],["حَتّى نَفاني عَنهُ تَخَلُّقُ وا","شٍ كِذبَةً لَفَّها بِتَذويقِ",26,"ق",1,0],["حَتّى نَزَونا وَعَينُ الشَمسِ فاتِرَةٌ","في كَوكَبٍ كَشُعاعِ الشَمسِ وَقّادِ",27,"د",1,0],["حتى نشجت بشعري","والشعر منه نشيج",28,"ج",1,0],["حتى نعى عليّا النّعاة","فانقلبت ملوكاً الرعاةُ",29,"ه",1,0],["حَتَّى نعُدَّ أَدَاءَهُ مِنْ دِينِنَا","وَجُحُودَهُ ضَرباً مِنَ الإِلْحَادِ",30,"د",1,0],["حتى نجوم الأفق","نامت فوق طيّات الغمام",31,"م",1,0],["حتى نُجازيَ أقواماً بسعيهمُ","من آل لأيٍ وكانوا سادة ً نجبا",32,"ب",2,0],["حتى نزلتُ على غنّاءَ وارفةٍ","بكل مرتجف الأطيافِ مسحور",33,"ر",1,0],["حتى نراهُ جاساً بينهم","أجلَّ من رَضوى ومن كَبْكَبا",34,"ب",2,0],["حتى نهضنا إلى العلياء تقدمنا","عصابة برزَت في المجد تبريزا",35,"ز",2,0],["حَتَّى نَرَى أَوْصَالَهُمْ وَجَمَاجِماً","مِنْهُمْ عَلَيْهَا الخَامِعَاتُ وُقُوعَا",36,"ع",2,0],["حَتّى نَحاكَ عَلى كُرهٍ يَسيرُ بِهِ","أَقَبُّ لَم يَدرِ ما الإِعياءُ وَالسَأَمُ",37,"م",1,0],["حتى نكون على الهداية والرضا","ونحوز حوزا وافرا في الجنة",38,"ه",1,0],["حتى نزلت بهم فساء صاحهُمُ","قتل الأبون وأنتُمُ الأولادُ",39,"د",1,0],["حتى نطيل اليوم وقفاً على ال","ساكن أو عطفاً على الموضع",40,"ع",1,0],["حتى نَفَى العُدْم وجَلَّى الفقرا","لو صافح الصخَر ألان الصخرا",41,"ر",2,0],["حتى نزلت بعكار فكان بها","قوم هم الأهل في ارض هي الدار",42,"ر",1,0],["حَتّى نضاه اللَه سَيفا مصلتا","بالحق يدحض حج المرتاب",43,"ب",1,0],["حَتّى نَرى مِثلَكَ أَبناءَكَ ال","أَفاضِلَ الغُرَّ المَيامينا",44,"ن",2,0],["حَتّى نَرى شارِبَ الصَّهباءِ مِن طَرَبٍ","كَأَنَّهُ صاحِبُ الشَّهباءِ في حَلَبِ",45,"ب",1,0],["حتّى نَرى تحقيقَ قولِ مؤرّخٍ","سرٌّ بهِ الحطّابُ سرَّ المُصطفى",46,"ف",2,0],["حتَّى نَرَى هَامِدَةَ الأرضِ قَدْ","أَضحَتْ بِما أَنْزَلْتَ مُهَتزَّهْ",47,"ز",2,0],["حَتّى نَنال بِهِ خلع العَنا بِهنا","إِلى قَديم التَهاني فيهِ تَجديدُ",48,"د",1,0],["حتى نّزلْتُ بسِرِّ مجدٍ باهرٍ","لم يَجْلُ عن مِثْلٍ له تَبْحيث",49,"ث",1,0],["حتى نأى وتبعتهم في عُصبةٍ","أجسامُهم بهواهُ كالأعراضِ",50,"ض",1,0],["حتَّى نحلت خَيالَها من عنده","عِلمُ الكتابِ وخِلتُها بَلقيسا",51,"س",2,0],["حتى نشأتَ لها ونف","سُك من هواها بعد سَكرى",52,"ر",2,0],["حَتّى نَضى وَجه الصَباح لِثامَهُ","وَأَظَلَّ أَثواب الدُجى تَخريق",53,"ق",1,0],["حتى نجاي نظمكم","للدر بالدر النثير",54,"ر",1,0],["حتى نشرت فنونه","وجلوت منه ما تصدى",55,"د",2,0],["حتى نبدو كتلا متشابهة, متكررة, متآلفةً","من إنسان فرد متكثِّر",56,"ر",1,0],["حتى نقولَ وكُنَّا قبلَ معرفةٍ","سُبْحانَ عَدْلِكَ أَضحى يَنْقُلُ الشِّيَما",57,"م",2,0],["حتى نأت فغدالي من قطيتها","وبعدها سببا فقل قد اختلفا",58,"ف",2,0],["حتى نَزَفْنَ سُمومَهُنَّ فلَمْ يُرَع","من نافِثاتِ السُّمِّ ليلُ الحاطِبِ",59,"ب",1,0],["حتى نطهر أرضا طالما عبقت","بها المآثر أضعاف الرياحين",60,"ن",1,0],["حتى نجمتَ فأجمعوا وتبيّنوا","أن الأخير مقصِّرٌ بالأولِ",61,"ل",1,0],["حتى نجمتَ فكنتَ بيّنةً","نَصَرتْ دعاوى القولِ بالفعلِ",62,"ل",1,0],["حتى نهضتُ نابها نابيةً","عنّي مقاعدُ الخمول المُرِملِ",63,"ل",1,0],["حتى نجومُ السَّما.. لكنْ مُفارَقَة ٌ","أنْ يُذكَرَ الكَوكَبُ الدُّرّيٌّ والحَشَفُ!",64,"ف",1,0],["حَتَّى نَعودَ ولا وَهْمٌ يؤرِّ قُنا","وَلا سَرابٌ عَلى البَلوَى يُمَنِّينا !",65,"ن",2,0],["حتى نأتْ فنأتْ تلكَ البشاشةُ عن","تلكَ المواطنِ لمّا أقفرَ النادي",66,"د",2,0],["حتّى نزَلْنا على الدّارِ الّتي شرُفَتْ","بمَنْ بها ولثَمْنا دُرَّ حَصباها",67,"ا",3,0],["حتى نهضت فلم تنهض قوائمهم","والرعب يخفق في الأحشاء والركب",68,"ب",1,0],["حتى نشاهد جمال الله يلمع لمعْ","ولا وجود لنا وهو الوجود الجمعْ",69,"ع",1,0],["حتى نظرت بعين العين فانكشفت","موتَى الشماميس منها في النواميس",70,"س",1,0],["حَتّى نَهاها حينَ لارَوِيُّ","طَعنٌ إِذا اِستَيسَرنَهُ يَسرِيُّ",71,"ي",1,0],["حتى نهى قل لي فهل تراه","قد كان في الحال التي نهاه",72,"ه",1,0],["حَتَّى نَفَى ظُلْمَ الضَّلالِ بِشَمْسِهِ","عَنّي وَحَرَّ الحَادثاتِ بِظلِّهِ",73,"ل",2,0],["حتى نُبيدَكُمُ بال