//www.poetsgate.com/ViewPoem.aspx?id=190280",""],[5725,"ياايها السالي","https://www.poetsgate.com/ViewPoem.aspx?id=191670",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5845,"الحبُّ مسألة ٌبغيرِ جوابِ","https://www.poetsgate.com/ViewPoem.aspx?id=16702",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[6046,"حدود... بلا حدود!","https://www.poetsgate.com/ViewPoem.aspx?id=37247",""],[161,"إحْصَاءُ عَامِ قَدْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""],[1362,"سقتك وهناً يا دارها الديم","https://www.poetsgate.com/ViewPoem.aspx?id=127724",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[520,"أفخر فحسبك ما اوتيت من حسب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577444",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6339,"نون النسوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87889&r=&rc=1",""]],"verses":[["حَتّى نَظَرتُ وَلَي عَينٌ مُؤَرَّقَةٌ","تُقَسَّمُ الدَمعَ بَينَ الرَبعِ وَالظُعُنِ",0,"ن",1,0],["حَتّى نَضا الإِظلامُ صَبغَتَهُ","وَطَواهُ جَونُ اللَيلِ مُنكَشِفُ",1,"ف",1,0],["حَتّى نَبا بِهِمُ الزَمانُ فَأُزعِجوا","عَن تِلكُمُ الأَغيالِ وَالأَخياسِ",2,"س",1,0],["حَتّى نَقَضتِ عُهودَنا","وَالعَهدُ يَنقُضُهُ الظَلومُ",3,"م",1,0],["حَتّى نَعى الناعي أَبا حَسَنٍ","فَوَدَدتُ لَو كُنتُ الَّذي يُنعى",4,"ع",2,0],["حَتّى نِساءُ تَميمٍ وَهيَ نائِيَةٌ","بِقُلَّةِ الحَزنِ فَالصَمّانِ فَالعَقَدِ",5,"د",1,0],["حتى نخيل الجانَببين جمعها","قامت له بحفارة اجلالا",6,"ل",2,0],["حتى نزلت من الشوير بجنّة","فيها الحياة كثيرة الألوان",7,"ن",1,0],["حَتّى نُبيلَ الخَيلَ في عَرَصاتِكُم","وَنَؤوبَ بِالمَلِكاتِ وَالأَولادِ",8,"د",1,0],["حتَّى نزلنا بمكانٍ مونق","إخوان صدقٍ أحدق بالملّق",9,"ق",1,0],["حتى نراهُ جالساً بينهم","أجلَّ من رَضوى ومن كَبْكَبا",10,"ب",2,0],["حَتّى نَسَينا كَيفَ لَونُ الضُحى","وَلَم نَعُد نَذكُرُ سَجعَ الحِمام",11,"م",1,0],["حَتّى نَظَرتُ إِلَيها في جَلالَتِها","فَصارَ كُلُّ يَقيني أَنَّهُ فيها",12,"ي",3,0],["حتى نزلت بباكرين إلى القرى","متهللين كأنهم أقمار",13,"ر",1,0],["حتى نظرت إلى الوجود بمقلة","ذهبت غشاوتها وطرف رائد",14,"د",1,0],["حَتّى نَزَلتُم بُقعَةً فيها الهَوى","مِن قَبلُ ثاوٍ وَالسَماحُ نَزيلُ",15,"ل",1,0],["حتى نراه وحَدُّ السَّيفِ في يدِهِ","مُثَلَّمٌ وسِنانُ الرُّمحِ مَأْطُورُ",16,"ر",1,0],["حتى نصبتَ على رَغم الصليبِ بها","منابرَ الدينِ مسموعاً بها الخُطَبُ",17,"ب",1,0],["حَتّى نَبيدَ قَبيلَةً وَقَبيلَةً","قَهراً وَنَفلِقَ بِالسُيوفِ الهامِ",18,"م",1,0],["حَتّى نَرى غُرَراً تُجَرُّ وَجُمَّةً","وَعِظامَ رُؤسٍ هُشِّمَت بِعِظامِ",19,"م",1,0],["حَتّى نَرى أَوصالَهُم وَنجَماجِماً","مِنهُم عَلَيها الخامِعاتُ وُقوقا",20,"ق",2,0],["حَتّى نَقَضتَ الرومَ مِنكَ بِوَقعَةٍ","شَنعاءَ لَيسَ لِنَقضِها إِبرامُ",21,"م",1,0],["حتى نزلنا بساحٍ منكِ مُحتضِنٍ","رأد الضُحى والنَّدى والرملَ والطّينا",22,"ن",2,0],["حَتّى نَجَوتُ وَلَمّا يَنزِعوا سَلَبي","بِوالِهٍ مِن قَبيضِ الشَدِّ غَيداقِ",23,"ق",1,0],["حَتّى نَفاهُ مِن تُخومِ فارِسِ","وَبانَ عَنها بِضَميرٍ آيِسِ",24,"س",1,0],["حَتّى نَراكَ وَقَد دَرَّعتَهُ قُمُصاً","مِنَ الصَديدِ مَكانَ الليفِ وَالكَرَبِ",25,"ب",1,0],["حَتّى نَفاني عَنهُ تَخَلُّقُ وا","شٍ كِذبَةً لَفَّها بِتَذويقِ",26,"ق",1,0],["حَتّى نَزَونا وَعَينُ الشَمسِ فاتِرَةٌ","في كَوكَبٍ كَشُعاعِ الشَمسِ وَقّادِ",27,"د",1,0],["حتى نشجت بشعري","والشعر منه نشيج",28,"ج",1,0],["حتى نعى عليّا النّعاة","فانقلبت ملوكاً الرعاةُ",29,"ه",1,0],["حَتَّى نعُدَّ أَدَاءَهُ مِنْ دِينِنَا","وَجُحُودَهُ ضَرباً مِنَ الإِلْحَادِ",30,"د",1,0],["حتى نجوم الأفق","نامت فوق طيّات الغمام",31,"م",1,0],["حتى نُجازيَ أقواماً بسعيهمُ","من آل لأيٍ وكانوا سادة ً نجبا",32,"ب",2,0],["حتى نزلتُ على غنّاءَ وارفةٍ","بكل مرتجف الأطيافِ مسحور",33,"ر",1,0],["حتى نراهُ جاساً بينهم","أجلَّ من رَضوى ومن كَبْكَبا",34,"ب",2,0],["حتى نهضنا إلى العلياء تقدمنا","عصابة برزَت في المجد تبريزا",35,"ز",2,0],["حَتَّى نَرَى أَوْصَالَهُمْ وَجَمَاجِماً","مِنْهُمْ عَلَيْهَا الخَامِعَاتُ وُقُوعَا",36,"ع",2,0],["حَتّى نَحاكَ عَلى كُرهٍ يَسيرُ بِهِ","أَقَبُّ لَم