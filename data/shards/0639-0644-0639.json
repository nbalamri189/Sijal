{"poems":[[47,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[47,"لا يَرِمْ رَبْعَكَ السّحابُ يَجُودُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31418",""],[501,"","https://poetry.dctabudhabi.ae/diwan/poem/142584","الرمل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216547",""],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5906,"غبار أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=188911",""]],"verses":[["عَلَّ عُذراً يَدنو بِهِ مِن مَداهُ","في نَداهُ أَو عَلَّ ثِقلاً يَؤودُه",0,"د",2,0],["عَلّ عُذْراً يَدْنُو بهِ عَنْ مَداهُ","في نَداهُ، أوْ عَلّ ثِقْلاً يَؤودُهْ",1,"د",2,0],["علَّ عينيكِ إذا آنستا","أثراً منه، عرا الليلَ خَدَر",2,"ر",1,0],["علعول فِيْ راسك وعيَّال","تفعل جميلٍ وآخره شين",3,"ن",1,1],["عَلَّ عيسى رَأى بِرومَةَ ناراً","مِن بَعيدٍ تَشُبُّ ذاتَ اِشتِعالِ",4,"ل",1,0],["عَلَّ عَيْنًا تَرَى مُنَاهَا وَتَلْقَى","فِي خُدُورِ الحِسَانِ مَا لَا يَزُولُ",5,"ل",1,0],["عَلَّ عَيْنِي أَنْ تَرى طَيفَ حَبيبي","وَ طُلولاً كانَ في العِشقِ مَزارا",6,"ر",2,0]]}