om/ViewPoem.aspx?id=203538",""],[5444,"أحلى الأمكنة","https://www.poetsgate.com/ViewPoem.aspx?id=205447",""],[709,"شرّفِ الوجهَ في رابِ زرودِ","https://www.poetsgate.com/ViewPoem.aspx?id=2910",""],[5533,"عَوْدَةُ مُهاجِر","https://www.poetsgate.com/ViewPoem.aspx?id=176272",""],[5830,"وَ حََقّاً إِنَّنِي خَجِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=200773",""],[5952,"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""],[161,"إحْصَاءُ عَامِ قَدْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""],[4442,"قبلت خديه وهو نائم","https://www.poetsgate.com/ViewPoem.aspx?id=171022",""],[6100,"الصمان","https://www.poetsgate.com/ViewPoem.aspx?id=52551",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[463,"هبَّتْ ومنها الخلابُ والخدعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60118&r=&rc=174",""]],"verses":[["عن عمر الفاروق يروونه","تراث تمجيد وتعظيم",0,"م",1,0],["عَن عِصامِيٍّ نَبيلٍ مُعرِقِ","في بُناةِ المَجدِ أَبناءِ الفَخار",1,"ر",1,0],["عَن عَزمِ قَلبٍ لَم أَصِلهُ بِغَيرِهِ","عَضبِ المَضارِبِ صائِبٍ لِلمَفصِلِ",2,"ل",1,0],["عَن عُقَدٍ أَوفَت لِذي ميقاتِ","إِلى أَباريقَ مُفَدَّماتِ",3,"ت",1,0],["عَنْ عُنْصُرَيْهَا تَلَقَّتْ","أَنْقَى وَأَرْقَى مِزَاجِ",4,"ج",1,0],["عن عُيونٍ حَلَّها سِحرُ الحَوَر","وخُدودٍ مَسَّها لُطفُ الخَفَر",5,"ر",1,0],["عن عَذاري بَذَلت أعراضَها","في سَبيلِ العَيش بِئسَ المُتَّجَر",5,"ر",1,0],["عن عبيد هام فيكم شغفاً","ليسَ يصغي قول أهل الاعتزال",6,"ل",1,0],["عَنَّ عُلوياً فَلَم يُه","دِ لَنا إِلّا العَناءا",7,"ا",3,0],["عَنْ عُمَرٍ طَالَ عُمْرُهُ قَمَراً","يُضِيءُ أَفْرَاحَنَا فَنَقْصِدُهَا",8,"د",3,0],["عن عيوبي إنْ تَخَفََّتْ","أو تَبَدَّتْ، سائليني",9,"ن",2,0],["عَنْ عبدِ الواحِدِ أحْرَزهُ","فَذُّ التوحيد وَأَوْحَدُهُ",10,"د",2,0],["عَن عَبْد الوَاحِد أحْرَزَها","يَحيى لِلنّجْل ابْنٌ وأبُ",11,"ب",1,0],["عَن عِشقِ وَردٍ بِخَدَّيهِ وَنَرجِسِ عَي","نَيهِ مَدى الدَّهرِ لا حالَت بِيَ الحالُ",12,"ل",1,0],["عن عفو سلطان الورى حامي الحمى","عبد الحميد المرتضى سامي العمل",13,"ل",1,0],["عن عائِدٍ وزائِرِ","فعلَ الكَريم الصابرِ",14,"ر",1,0],["عَن عَينِها ثُمَّ يُلقيها إِلى السُفَلِ","طاروا إِلَيها فَلَمّا أَن عَلَوا هَبَطوا",15,"ط",3,0],["عَنعِنْ رِجالَ الهَوى وَمُسنَدَهُ","عَن رَجُلٍ مِنهُمُ إِلى رَجُلِ",16,"ل",1,0],["عن عادةٍ سلفت ولل","إنسانِ ما يتعودُ",17,"د",1,0],["عن عنبرٍ عبرَ الرو","ضَ بالأريجِ الأنيقِ",18,"ق",1,0],["عنَّ على قدرةٍ وجادَ وجو","وُ الجدي جعدُ الأرواح منقشعُ",19,"ع",1,0],["عن عليٍّ طوراً ورثنا المعالي","وهشمنا بالمجد أنف الجمود",20,"د",1,0],["عن عليٍّ أتى بشأْنٍ عليٍّ","مثلما النُّقطَةُ انطوتْ في الباءِ",21,"ا",2,0],["عن عليٍّ يورَّثُ العِلمَ والحك","مَ وفصْلَ الخِطاب عن داوُدِ",22,"د",1,0],["عَن عِلم ما فَعل الخَليطُ فَما درت","إِنّي توجه بِالخَليطِ الموسم",23,"م",1,0],["عن عونه فسألوا العطاء","فقال لم لم تدفعوا الأعداء",24,"ا",2,0],["عن عدله في الناس لم يعدل وكم","نصر الذي بين البرية قد ظُلم",25,"م",1,0],["عَن عامِها تَنبي الثَلاثون الوَرى","وَالسَبع ثُم الأَلف وَالمِئَتان",26,"ن",1,0],["عن عهدهِ يلويهِ لحظ غزالِ","بطلٌ تحاذرهُ الاسودُ اذا سطا",27,"ط",2,0],["عَن عيش صافي وَقتنا","في المَهرَجان الأَخضر",28,"ر",1,0],["عنْ عطايا هيَ الغيومُ وإنْ","مَيّزَها البشر عن سماءِ الغيوم",29,"م",1,0],["عنعنت لي احمرارها عن لماه","عن دم الدمع عن دم العنقود",30,"د",1,0],["عن عطاءِ بنِ يسارٍ","عن سعيد بن عُباده",31,"د",2,0],["عن عنبر الخال عن ياقوت مبسمه","عن جوهر الثغر يروى الحسن متصلا",32,"ل",2,0],["عَن عَبدِهِ مُوسَى الكَلِيمِ وَحَربِهِ","فِرعَونَ ذِي التكذِيبِ والطُّغيَانش",33,"ن",2,0],["عنعنة فليصح مسندها","عنك كضما صح لي مسلسلها",34,"ل",3,0],["عن عامر وبني جذيمة إذ هوى","للحين حد جذيمة العشار",35,"ر",1,0],["عنعنعتهُ الحُذَّاقُ عن هيماني","عن دموعي عن قلبي الولهانِ",36,"ن",1,0],["عِنْ عِنادٍ وَفِتْنَةٍ وَفَسادِ","لَسْتُ أنْسَى الرَّضيع حِينَ تَلَظَّىَ",37,"ظ",2,0],["عَن عُنفِهِ فَهو مَضنى القَلب موجِعُهُ","وَهَل لَهُ وَيلهُ شَيءٌ يُؤَمِّلُه",38,"ه",1,0],["عَن عُيوب الناسِ حجّب مقلَة","عَن عُيوبٍ فيكَ تَرتد المقل",39,"ل",1,0],["عن عُلَما عصرك لا تسألن","فإن أحوالهم ظاهرهْ",40,"ر",2,1],["عَن عَبرَةٍ مهرَاقَةٍ","تَهمي وَجسم مُمتَهَن",41,"ن",1,0],["عَن عَلِيِّ الرِّضَى التَّقِيِّ بنِ مُوسَى ال","كَاظِمِ العَابِدِ الخَؤُوفِ البَتُولِ",42,"ل",1,1],["عن عُتَاةٍ تَخَوَّنوا بالأذى دا","ري عُتُوّاً وأَزْعَجُوا جيراني",43,"ن",2,0],["عَن عَزمِهِ سَل حُصونُ الكَردِ كَيفَ غَدَت","أَخصاصُ سَعفٍ وَقَد جَلَت فَلَم تَعُد",44,"د",1,0],["عن عيان حادث الى ترّهات","فأطالت في الجهل متنا وشرحا",45,"ح",2,0],["عَن عيانٍ لِشَريكٍ قَد هَوى","وَمُطيعٍ بَعدَ أَن كانَ عَصي",46,"ي",1,0],["عن علاهم سل السماءَ ويوحا","ها ستوحى الثنا لهم أصنافا",47,"ف",2,0],["عن علة في الحق جرد فعله","ويزيد حرف اللين وهو مشدد",48,"د",1,0],["عن عينه مُدَّتِ الأستار والحجبُ","من لم يكن عندهُ في العالمين أبُ",49,"ب",1,1],["عن عنكبوت أحلامنا ننسج: سكوت","طلع ذهب.. يا فضة الحكي فرقا",50,"ق",2,0],["عن عمر قد أبان عدلا","من ضرب زيداً جار عمرا",51,"ر",2,0],["عن عالم التشفير ومقارع الكوس","اخترت لي عالم ولا احد(ن) يدلّه",52,"ل",2,0],["عن عينٍ جاءتْ ترمقُنا","برموشٍ زيَّنَها الكَذِبُ",53,"ب",1,0],["عن عارضٍ عن قريةٍ عن قلعةٍ","عن ذاتِ خيلٍ إذْ تروحُ الأحصنة",54,"ن",2,0],["عنْ عليٍّ يورّثُ العلمَ ولاح","كْمَ وَفَصْلَ الْخِطَابِ عَنْ دَاوُدِ",55,"د",1,0],["عَنْ عابِقِ الأَشْيَاءِ يَبْحُث جَاهِداً","ومَذَاقِ أَزْهَارٍ بسَهْلٍ مُوْرِقِ",56,"ق",1,0],["عَنْ عَدْلِهِمْ وَ الدُّنَى تَحْيا عَلَى أَلَمِ","فَارُوقُهَا يَعْتَلِي وَالجُوعَ يَحْتَمِلُ",57,"ل",1,0],["عن عشاءٍ حين ناموا - خشيةً -","نحن قلنا إنهم صلّوا القياما",58,"م",2,0],["06- عَنْ عِبْرَةٍ نَحْيَا بِهَا أوْ سُمْعَةٍ","نَرْقَى بِهَا منْ زُبْدَةَ الأفْهَامِ",59,"م",1,0],["عن عمه أتقن المعالي","ومن أبيه انتقى المكارم",60,"م",1,0],["عن عزته كم حدثتنا الأساطير ..","وعن شيمته ياهي دموعه تعاني ..",61,"ن",2,0],["عن عينه كشف الله الغطا فرأى","من قدرة الله ما يخشاه رائيها",62,"ي",3,0],["عن عنكبوتٍ تخَيطُ الشَّبْكَ مِن مِزقٍ","قد أُبدِلتْ بنيوب الشرِّ أسنانُها",63,"ن",3,0],["عن عُمرٍ فرّقَ بينكما","بيدَينِ لقاؤهما حجَرُ",64,"ر",1,0],["عنَّ على قدرة ِ وجادَ وجوُّ ال","جدي جعدُ الأرواحِ منقشعُ",65,"ع",1,0]]}