em.aspx?id=212086",""],[5219,"جفف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=194802",""],[5266,"اليَوْمَ تَجْتَمِعُ الحُرُوفُ وَتَرْتَقِي","https://www.poetsgate.com/ViewPoem.aspx?id=210464",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[5273,"عشق أزلي","https://www.poetsgate.com/ViewPoem.aspx?id=179463",""],[5277,"مُرِّي ندىً","https://www.poetsgate.com/ViewPoem.aspx?id=191015",""],[5674,"الشيخ الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=201520",""],[5674,"يارب اني قد رجوتك شافه","https://www.poetsgate.com/ViewPoem.aspx?id=201521",""],[5720,"المتْرفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205536",""],[5943,"سيري وعينُ الله ترعى بالهدى","https://www.poetsgate.com/ViewPoem.aspx?id=35181",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[5977,"ستزهر الروح","https://www.poetsgate.com/ViewPoem.aspx?id=212750",""],[5977,"يا أحلى حكايانا","https://www.poetsgate.com/ViewPoem.aspx?id=213075",""],[6019,"يا بسمة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=53786",""],[6075,"لَا تُخْفِ دَمْعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=201606",""],[6152,"مسك الختام","https://www.poetsgate.com/ViewPoem.aspx?id=201687",""],[6186,"عادت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82885&r=&rc=5",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["يابسةُ العودِ وقد ذُلِّلتْ","قطوفُها للنيك تذليلا",0,"ل",2,0],["يَابِسَ الجَنبَينِ من غَيرِ بُؤس","وَنَدِيُّ الكَفَّينِ شَهمٌ مُدِلُّ",1,"ل",1,0],["يابسة العطف غير مائسة","ينعطف الجذع قبل تنعطف",2,"ف",1,0],["يابساتُ العيدانِ تُثْمِرُ بالغي","دِ إذا أوْرَقَتْ بِبِيضِ الشفارِ",3,"ر",1,0],["يا بساطَ الهوى ويا وترَ الشعر","سلاماً ويا شقيق الندامى",4,"م",2,0],["يَا بَسْمةً لَمَّا تَزْلْ","زَهْرَاءَ في ثَغْرِ الْخُلُودِ",5,"د",1,0],["يا بَسْمَةً في فَمِ الزمانِ","ومَوْطِنَ الْعِزِّ والأمانِ",6,"ن",1,0],["يَابِسٌ، بل شَامِس؛ لم تستطع","رغبة أو رهبة أن تخضعه",7,"ع",2,0],["يا بساط الهوى ويا وتر الشع","ر ويا شقيق الندامى",8,"م",2,0],["يَا بَسْمَةً تَفَتَّحَتْ","على وجُوهٍ أَبْشَرَتْ",9,"ت",1,0],["يا بسمة الأمل الطروب","وفرّة القلب الحزين",10,"ن",1,0],["يا بَسْمَةَ الفَتْحَ عُودِي زَيِّني زَمَنًا","مُشَوَّهًا وأَنِيري السَّهْلَ والأَكَما",11,"م",2,0],["يَا بسمةَ النَّصرِ المُنِيرةِ أشرقي","وَبِكُلِّ أجيالِ الفِداءِ تَكَلَّلي",12,"ل",2,0],["يا بسيط النوال يا كامل الفض","ل ويا وافر الندى والعطاء",13,"ا",2,0],["يا بسمة الثغر يا حياتي","أهكذا عهدنا تناهى",14,"ا",3,0],["يابِسُ الخُبزِ أُكلُهم بمساءِ","خِلتُ ذاكُ المساءَ عِندي صَباحا",15,"ح",2,0],["يا بُسرُ إِنّي فاِعلَمي","بِاللَهِ مُجتَهِداً يَميني",16,"ن",2,0],["يا بساطَ الزَّمانِ ارمني عندَها","إنَّني عائشٌ ميِّتٌ بَعدَها",17,"د",3,1],["يابسمةً رقصَتْ على شفَةِ اليتي","مِ وأبحرَتْ أملاً ببحرِ نداكا",18,"ك",2,0],["يا بسمةَ الصبرِ الجميل ونبْعة الخيرِ السخيّه","من ضلع آدم قد خلقتِ فكنتِ أماً للبريّه",19,"ي",2,0],["يابسمةٍ قالت / ترى الظلم ممنوع","مااااسهّر الدمعه سوا ليلة الظلم",20,"م",1,0],["يا بَسْمةَ العُمْر ِ إنَّ الدَّهْرَ أَبْكَاكِ","الهَمُّ شَيَّنَه ُبادٍ بأشواكِ",21,"ك",1,1],["يابسمةً حَقَنتْ فينا مَبَاهِجَها","لاشيئ َيُفْني لنا الأحْزانَ إلاَّكِ",21,"ك",1,0],["يابس الكف من عناءٍ وبرحٍ","شقّق الكدُّ بالضنى أنملاتهْ",22,"ت",2,0],["يَا بَسْمَةَ الأزْوَرْدِ سَاحَتْ فِيْ دَمِيْ","أنتِ الدَّواءُ لكُلِّ دَاءٍ بَلْسَمُ",23,"م",1,0],["يَا بْسْمَةً..تَنَاهَتْ فِيْ فَمِيْ نَغَمًا","يَا نَسْمَةً ..هَا ..هُنَا بِالْعِطْرِ تَنْفَجِرُ",24,"ر",1,0],["يا بَسْمَةَ الأُمِّ الحَنونِ لِطِفْلِها","ما بالُ صَبْريَ، إذ قَوى، يَخشاكا",25,"ك",2,0],["يا بسمةَ الوِدِّ الأرقِّ","وغُنّةَ الرشأ الأغنْ",26,"ن",1,0],["يا بسمة الدنيا ومسك عبيرها","يا سحر طيف في الخيال تربعا",27,"ع",2,0],["يَابَسْمَةَ الْأَخْلَاقِ رَائِدَةَ الْعُلاَ","فِي وَهْدَةِ الْأَخْلَاقِ غُصْتِ لِتَنْتَقِي",28,"ق",2,0],["يا بسمةً مِنْ ثَغْرِ طِفْلٍ هَائمٍ","بَسماتُهُ لاتَعرِفُ التَّأجيلا",29,"ل",2,0],["يا بسمةً بشفاهِ الصّبحِ مُشرقةً","تُبَدِّدُ العَتْمَ من ظُلمٍ ومِنْ ظُلَمِ",30,"م",1,0],["يا بسمةً حيرى تدغدغُ خاطري","دفئاً يُريقُ رضابَه رغم الخجلْ",31,"ل",1,0],["يا بسمة المشكاة نور سراجها","وملاك طِبٍّ للورى وحكايا",32,"ا",3,0],["يا بسمة الأعماق .. يا وجعي أنا","إن مرّ طيفك بلَّ روحي المقفره",33,"ر",2,0],["يا بسمةَ الأحلامِ في ليلِ الجوىٰ","وبهاءَ وصفٍ طابَ لي أنْ أوْصفَهْ",34,"ف",2,0],["يابسمةَ الأيام ياطيبَ الشذى","ياأمَّ شعبٍ بالبطولةِ أرعدا",35,"د",2,0],["يابسمةَأملٍ سيِّدتي","أسألُكِ الصِّدقَ بما وردَا",36,"د",2,0],["يا بسمةَ ذاتَ إعجاب بموهبتي","لا أطفأ الله ما في الروح تُشْعِلُهُ",37,"ل",2,0],["يا بسمةً في شفاه الطفل تمنعها","وقع الرزايا وموج الغدر والظُلَمِ",38,"م",1,0],["يا بسمة الحب يا روحاً تؤانسني","يا بلسم الشعر يا أحلى حكايانا",39,"ن",2,1],["يَا بَسمَةَ عُمرِيَ وَالأَمَلا","بِجَمَالِكِ قَلبِيَ قَدْ شُغِلا",40,"ل",2,1],["يَا بَسْمَةَ الذِّكْرَى أَمَا","حَمَلَتْ رِيَاحُكِ سَوْسَنا",41,"ن",2,0],["يا بسمة العُمر الجميل ونوره","كل الحروف إلى سواكِ كلام",42,"م",1,0],["يا بسمة الحب يا عنوان بسماتي","يا بلسم الجرح يا سكنى ارتحالاتي",43,"ت",2,0],["يابساتٍ عذوقك ما تعلّق ثمر","راكعاتٍ غصونك فوق جذعٍ هزيل",44,"ل",1,0]]}