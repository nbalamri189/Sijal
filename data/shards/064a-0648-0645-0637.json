{"poems":[[55,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[90,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[49,"أبلغ بني حمدان في بلدانها","https://www.aldiwan.net/poem25125.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138350",""],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137339",""],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88595","الخفيف"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134228","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4701,"لارا","https://www.poetsgate.com/ViewPoem.aspx?id=176662",""],[4987,"طاب السهر","https://www.poetsgate.com/ViewPoem.aspx?id=49558",""],[5220,"مزحة شباب","https://www.poetsgate.com/ViewPoem.aspx?id=25569",""],[5848,"من متى والقلب يصبر","https://www.poetsgate.com/ViewPoem.aspx?id=53099",""],[5848,"كيف اصوم","https://www.poetsgate.com/ViewPoem.aspx?id=53207",""],[5848,"بدون","https://www.poetsgate.com/ViewPoem.aspx?id=53182",""],[6038,"يا موزع الرنات","https://www.poetsgate.com/ViewPoem.aspx?id=25687",""]],"verses":[["يَومَ طاحَت أَيدي السَوابِقِ في النَق","عِ وَفاضَ الوَنى وَغاضَ الصَهيلُ",0,"ل",1,0],["يوم طوغو دها بأسطوله الرو","س قتالاً وكان يوماً عبوسا",1,"س",2,0],["يَومَ طَرَدتُ الخَيلَ عَن فُرسانِها","وَسُقتُ مِن قَيسٍ وَمِن جيرانِها",2,"ن",3,0],["يوم طيور اليمن صادحة به","لتشارك الاقوام وهي ترتل",3,"ل",1,0],["يومَ طارت يمينُ غورو ترنَّح","تم سروراً وهل يليق السرور",4,"ر",1,0],["يوم طارَت أَعناقها بحسام","عَن شباه طير الردى لن يَطيرا",5,"ر",2,0],["يوم طارت بكل قلب سروراً","مهج في قوادم الأفراح",6,"ح",1,0],["يوم طاف ابن أحمد والعوادي","حجبت وجهة السما بثراها",7,"ا",3,0],["يوم طار البغاث إذ دهمتها","شزب الخيل حاملات صقورا",8,"ر",2,0],["يوم طاش الحليم وارتبك","المقدام حتى ظننته مسحورا",8,"ر",2,0],["يوم طروادةلمْ تَهبط ْعلى","قمة الأوليمبِفاشتقنا النهارا",9,"ر",2,0],["يوم طاب السهر عيت تطيب النفوس","جت من الله وانا كم كنت محتاجها",10,"ج",3,1],["يوم طعن السيوف ويوم قدح الزنود","يقف دونك صديقك للخطر مايهاب",11,"ب",1,0],["يوم طاح الدمع شفتك تطيح من العيون","ان قدرت ترجّع الدمع ترجع يا فطين",12,"ن",1,0],["يوم طاحت دمعتي ما كنت ظامي","كنت افكّر .. كيف مرّه كل يوم !!",13,"م",1,0],["يوم طال الطريق وقلت وش فيه طال","أثرني وسط دوار الحياه مْغلوب",14,"ب",1,0],["يوم طيفك اقبل وانت هليت","هلا والله بالغالية هلا بالحبيبه",15,"ب",2,0]]}