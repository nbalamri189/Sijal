/poem68406.html","الكامل"],[560,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"],[560,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[565,"تزداد فيك مصيبتي","https://www.aldiwan.net/poem69633.html","مجزوء الكامل"],[565,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[573,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[573,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[584,"حتى متى أنا صابر يا هاجر","https://www.aldiwan.net/poem17991.html","الكامل"]],"verses":[["وَلَقَد عَهِدتُ رُباهُ جامِعَةً","بَينَ الظِباءِ الغيدِ وَالأُسُدِ",0,"د",1,0],["وَلَقَد عَرَكتُ الدَهرَ حَتّى إِنَّهُ","لَو لَم يَذُق مِنّي المَرارَةَ ما حَلا",1,"ل",2,0],["وَلَقَد عَجِبتُ لِبُخلِهِ","عَنّي بِشَيءٍ لا يَضيرُه",2,"ر",2,0],["ولقَد عَهِدْتُ القَلْبَ وهْوَ موَحِّدُ","فعَلامَ يُقْضَى في العَذابِ خُلودُهُ",3,"د",2,0],["وَلَقَد عَلِمتَ لَتَكرَهَن","نَ الحَربَ مِنِ اِصرٍ وَغارَه",4,"ر",2,0],["وَلَقَد عَلِمتُم حينَ يُن","سَبُ كُلُّ حَيٍّ ذي غَضارَة",4,"ر",2,0],["وَلَقَد عَلِمتِ وَأَنتِ غَيرُ حَليمَةٍ","أَلّا يُقَرِّبَني هَوىً لِهوانِ",5,"ن",1,0],["وَلَقَد عَجِبتُ لِبُخلِهِ","وَلِكَفِّهِ المُستَحجِرِ",6,"ر",1,0],["وَلَقَد عَلِمتَ بِأَنَّ سِرَّكَ عِندَنا","بَينَ الجَوانِحِ موثَقُ الأَشراجِ",7,"ج",1,0],["وَلَقَد عَرَكنَ بِئالِ كَعبٍ عَركَةً","بِلِوى جُرادَ فَلَم يَدَعنَ عَميدا",8,"د",2,0],["وَلَقَد عَجِبتُ مِنَ الوُشاةِ كَأَنَّهُم","بِالبُغضِ نَحوَكَ وَالعَداوَةِ عورُ",9,"ر",1,0],["وَلَقَد عَلَونَ مِنَ السَماوَةِ مَعلَماً","خُلُجاً مَوارِدُهُ بَعيدَ المَركَضِ",10,"ض",1,0],["وَلَقَد عَجِبتُ مِنَ الدِيارِ وَأَهلِها","وَالدَهرِ كَيفَ يُبَدِّلُ الأَبدالا",11,"ل",2,0],["وَلَقَد عَلِمتِ لَوَ إِنَّ عِلمَكِ نافِعٌ","وَسَمِعتِ ما يَتَحَدَّثُ الأَقوامُ",12,"م",1,0],["وَلَقَد عَلِمتُ وَما عَلِم","تَ وَإِن أَقَمتُ عَلى صُدودِه",13,"ه",1,1],["ولقد عَمِرْتُ أظنُّ أنك لو بدا","منّي مَعيبٌ لم تكن لِتَعيبَهُ",14,"ب",2,0],["ولقدْ عهدْت عِراصَها مأنُوسةً","أيامَ تعهدُني كسيفِ الصْيَقلِ",15,"ل",1,0],["وَلَقَد عَلِمتُ بِأَنَّها إِذ عُلِّقَت","سِمَةُ الذَليلِ بِكُلِّ أَنفٍ مُغضَبِ",16,"ب",1,0],["وَلَقَد عَلِمتِ إِذا العِشارُ تَرَوَّحَت","هَدَجَ الرِئالِ تَكُبُّهُنَّ شَمالا",17,"ل",2,0],["وَلَقَد عَطَفنَ عَلى فَزارَةَ عَطفَةً","كَرَّ المَنيحِ وَجُلنَ ثُمَّ مَجالا",17,"ل",2,0],["وَلَقَد عَلِمتَ وَأَنتَ أَعلَمُنا بِهِ","أَنَّ اِبنَ يوسُفَ حازِمٌ مَنصورُ",18,"ر",1,0],["وَلَقَد عَلِمتَ بَلاءَهُ في مَعشَرٍ","تَغلي شَناةُ صُدورِهِم وَتَفورُ",18,"ر",1,0],["وَلَقَد عَلِقتُ مِنَ الحِسانِ مَليحَةً","تَحكي الهِلالَ بِحاجِبٍ وَجَبينِ",19,"ن",1,1],["وَلَقَد عَرَضتُ عَلَيكُمُ","روحي وَكُنتُ لَها أَصونُ",20,"ن",1,0],["وَلَقَد عَلِمتُ بِما جَرى","لَكَ كُلَّهُ حَتّى كَأَنّي",21,"ن",2,0],["وَلَقَد عَلِمتَ بِأَنَّني","لي في الهَوى خُلُقٌ شَديدُ",22,"د",1,0],["ولقد علتها وهي تبرح افقها","وطفاء حانية حنو المرضع",23,"ع",1,0],["ولقد عاشرت الرجال طويلا","واذا الاصدقاء منهم اعاد",24,"د",1,0],["ولقد عاب للجهالة شعري","نفر هجسهم يخالف هجسي",25,"ي",1,0],["ولقد علمت بأنّني بدر السما","لَكن دهيت لشقوتي بالمشتري",26,"ي",1,0],["وَلَقَد عَدّوا لَكُم بَينَ الجُدود","مِثلَ آبيسَ وَمَعبودِ اليَهود",27,"د",1,0],["وَلَقَد عَهِدتُكَ لا تُضَيِّعُ راجِياً","وَاليَومَ ضاعَ الكُلُّ فيكَ رَجاءَ",28,"ا",2,0],["وَلَقَد عَلَت بِبَناتِهِ","لُجَجُ العُلومِ الزاخِراتِ",29,"ت",1,0],["وَلَقَد عَلِمنا أَنَّنا سَنُطيعُهُ","لَمّا عَلِمنا أَنَّنا لا نَخلِدُ",30,"د",1,0],["وَلَقَد عَلَوتَ فَما تُبالي بَعدَما","عَرَفوا أَيَحمَدُ أَم يَذُمُّ القائِلُ",31,"ل",1,0],["وَلَقَد عَذَلتُ أَبا أُمَيَّةَ لَو وَعَت","أُذُناهُ ذاكَ العَزلَ وَالتَأنيبا",32,"ب",2,0],["وَلَقَد عَلِمتُ وَلِلمُحِبِّ جَهالَةٌ","أَنَّ الصِبا بَعدَ المَشيبِ تَصابِ",33,"ب",1,0],["وَلَقَد عَزَزتِ فَهانَ طَوعاً لِلهَوى","وَجَنَبتِهِ فَرَأَيتِ ذُلَّ قِيادِهِ",34,"د",2,0],["وَلَقَد عَرَفتِ جَوى الهَوى في مِنَّتي","وَرَأَيتِ طاعَةَ قَلبِيَ المُنقادِ",35,"د",1,0],["وَلَقَد عَلِمتُ بِأَنَّ هَمَّكَ يَعتَلي","في صاعِدٍ حَتّى تُنَفِّذَ صاعِدا",36,"د",2,0],["وَلَقَد عَلا فَوقَ الفَراقِدِ بَيتُهُ","وَعَلى الحَضيضِ قَواعِدُ الآساسِ",37,"س",1,0],["وَلَقَد عَرَكتُ بَني كُلَيبٍ عَركَةً","وَتَرَكتُهُم فَقعاً بِكُلِّ قَرارِ",38,"ر",1,0],["وَلَقَد عَطَفتُ عَلَيكَ حَرباً مُرَّةً","إِنَّ الحُروبَ عَواطِفٌ أَمرارُ",39,"ر",1,0],["وَلَقَد عَلِمتُ لَئِن فَزارَةُ أُمِّرَت","أَن سَوفَ تَطمَعُ في الإِمارَةِ أَشجَعُ",40,"ع",1,0],["وَلَقَد عَلِمتُ لِيَذرِفَن ذا بَطنِهِ","يَربوعُكُم لِمُوَقِّصِ الأَقرانِ",41,"ن",1,0],["وَلَقَد عَلِمتَ عَلى اِنصِلاتِكَ ما","أَزرى وَلَو أَكثَرتَ بي عُدمي",42,"م",2,0],["وَلَقَد عَجِبتُ لِهالِكٍ وَنجاتُهُ","مَوجودَةٌ وَلَقَد عَجِبتُ لِمَن نَجا",43,"ا",1,0],["وَلَقَد عَقَلتَ وَما أَراكَ بِعاقِلٍ","وَلَقَد طَلَبتَ وَما أَراكَ تُصيبُ",44,"ب",1,0],["وَلَقَد عَجِبتُ لِغَفلَتي وَلِغِرَّتي","وَالمَوتُ يَدعوني غَداً فَأُجيبُ",44,"ب",1,0],["وَلَقَد عَجِبتُ لِطولِ أَمنِ مَنِيَّتي","وَلَها إِلَيَّ تَوَثُّبٌ وَدَبيبُ",44,"ب",1,0],["وَلَقَد عَجِبتُ مِنَ المُثَمِّرِ مالَهُ","نَسِيَ المُثَمِّرُ زينَةَ الإِقلالِ",45,"ل",1,0],["وَلَقَد عَتَوا زَمَناً كَأَن","نَهُمُ السِباعُ العاوِيَه",46,"ي",2,0],["وَلَقَد عَجِبتُ وَقَد هَوَيتَ بِلُجَّةٍ","فَجَرى عَلى رُسلٍ بِغَيرِ حَياءِ",47,"ا",2,0],["وَلَقَد عَهِدتُ إِلى عَرائِسِ فِكرَتي","أَن لا تُزَفَّ لِمُنعِمٍ مِن بَعدِهِ",48,"د",2,0],["وَلَقَد عَهِدتُ بِكَ الظِباءَ سَوانِحاً","بِظِلالِ شِعبِكَ وَالحِسانَ الغيدا",49,"د",2,0],["ولقد عكفتَ على مواصلَةِ النّدى","فكأنّهُ حُبٌّ بلا سلوانِ",50,"ن",1,0],["وَلَقَد عَلِمنا مُذ تَرَعرَعَ أَنَّهُ","لِأَمينِ رَبِّ العالَمينَ أَمينُ",51,"ن",1,0],["وَلَقَد عَلِمتُ لَدُن لَجَجتُم أَنَّهُ","ما بَعدَ ذاكَ العُرسِ إِلّا المَأتَمُ",52,"م",1,0],["وَلَقَد عَلِمتُ بِأَنَّ ذَلِكَ مِعصَمٌ","ما كُنتَ تَترُكُهُ بِغَيرِ سِوارِ",53,"ر",1,0],["ولقدْ عهدتك مَلْعَباً","للغيدِ والرشأِ الأَغنْ",54,"ن",1,0],["وَلَقَد عَصَيتُ ذَوي قَرابَتِنا","طُرّاً وَأَهلَ الوُدِّ وَالصَهرِ",55,"ر",1,0],["وَلَقَد عَلِمتُ لَئِن عَدَدتُ ذُنوبَهُ","أَن سَوفَ يَزعُمُ أَنَّهُ لَم يُذنِبِ",56,"ب",1,0],["وَلَقَد عَلِمتُ بِكَونِ ثَغرِكَ بارِقاً","أَن سَوفَ يُزجى لِلعِذارِ سَحابا",57,"ب",2,0],["وَلَقَد عَجِبتُ مِنَ الغُواةِ وَقَولِهُم","جَدَّ البَلاءُ فَما لَنا لا نَلعَبُ",58,"ب",1,1],["وَلَقَد عَلِمتُ وَإِن تَكاءَدَني الأَسى","أنَّ الكَريمَ عَلى الحَوادِثِ يَأتَسي",59,"س",2,0],["وَلَقَد عَناني صَوتُهُم","مِن بَينِ مُستَسقٍ وَصائِح",60,"ح",1,0],["وَلَقَد عَرَتني مِنكَ جَدوى أَنبَتَت","خُضراً إِلى لَفَفٍ مِنَ الأَشجارِ",61,"ر",1,0],["وَلَقَد عَلِمتُ لَتَعدُوَنَّ","عَلَيَّ شيمٌ كَالحَسائِل",62,"ل",1,1],["وَلَقَد عَلِمتُ بِأَنَّ شُربَ ثَلاثَةٍ","دِرياقُ هَمٍّ مُسرِعٍ بِنَجاةِ",63,"ه",1,0],["ولقد عَييتُ وما عَييتُ بمُشْكِلٍ","أسِنانُ عَزْمِك أم لِسانُك أطوَل",64,"ل",1,0],["وَلَقَد عَلِمتُ سَبيلَ عِلَّتِكُم","فيما يَحِنُّ لِغَيرِكُم ظُفري",65,"ي",1,0],["وَلَقَد عَجِبتُ مِنَ الضَعيفَةِ إِذ بَدَت","تَثني أُسامَةَ فَاِنثَنى وَاِنقادا",66,"د",2,0],["وَلَقَد عَجِبتُ مِنَ الجَرِيِّ يَقولُ لي","لَمّا بَدا في حَليِهِ وَخِضابِهِ",67,"ب",2,0],["وَلَقَد عَلِمتُ فَما التَمَضُّرُ نافِعي","أَنّي سَأَتبَعُ نَيسَباً لِاِبنَي سَبا",68,"ب",2,0],["وَلَقَد عُلِّمَ المُنَجِّمُ ما يو","جَبُ لِلدينِ أَن يَكونَ صَريحا",69,"ح",2,0],["وَلَقَد عَلِمتُ فَما أَسِفتُ لِفائِتٍ","أَنَّ البَقِيَّةَ مِن مَدايَ أَقَلُّهُ",70,"ل",2,0],["ولقد عاضد الذكور إناثٌ","ولقد عاضد الإناثَ الذكور",71,"ر",1,0],["وَلَقَد عددت القبر بعد نزوله","أحضانه من أَكرم الأكناف",72,"ف",1,0],["وَلَقَد عَلِقتُ بِذَيلِ مَن فَخَرَت بِهِ","عَبسٌ وَسَيفُ أَبيهِ أَفنى حِميَرا",73,"ر",2,0],["ولَقَد عُدِّيتُ دَوسَرَةً","كَعُلاِة العَينِ مِذكارا",74,"ر",2,1],["وَلَقَدْ عَلَوْتُ سَراةَ أَدْهَمَ لَوْ جَرَى","فَي شَأْوِهِ بَرْقٌ تَعَثَّر أَوْ كَبَا",75,"ا",1,0],["وَلَقَدْ عَتبتُ على مَعَاشِرَ فِيكُمُ","يَوْمَ الوَقِيعَةِ أسْلَمُوا عُثْمَانَا",76,"ن",2,0],["وَلَقَد عَجِبتُ وَلا عَجيبٌ أَنَّهُ","كُلُّ الوَرى لِلفاضِلينَ أَعادي",77,"ي",1,0],["وَلَقَدْ عَلِمْتُ لَتَعْدُوَنّ","عَلَيَّ شِيمٌ كَالْحَسَاكِلْ",78,"ل",1,1],["ولقد عَهِدْتُكَ بالبلاد وأهلِها","جَمَّ الشُجونِ ، مُوزَّعَ الأفكار",79,"ر",1,0],["ولقد عهِدْتُكَ والشمائلُ غضةٌ","غنيَ النديم بهن عن نُدمَائه",80,"ا",3,0],["وَلَقَدْ عَذَلْتُ أبَا أُمَيّةَ، لوْ وعَتْ","أُذُنَاهُ ذاكَ العَذْلَ، والتّأنِيبَا",81,"ب",2,0],["ولقد عاب القوم في سربهم أن","ني إذا ما طاروا معاً طرت وحدي",82,"ي",1,0],["ولقد علمت بان ذاك لغاية","تسمو بها إذ أكثرت إطراقها",83,"ق",3,0],["وَلَقَد عَهِدتُكَ صادِقاً","في القَولِ لا تَتَزَيَّدُ",84,"د",1,0],["وَلَقَد عَلِمنا أَنَّ بَينَكُمُ الَّذي","لا تَرحَلُ العَلياءُ عَن حُجُراتِهِ",85,"ت",2,0],["وَلَقَد عَرَفتُ الناسَ مِن أَطوارِهِم","سُبحانَ مَن خَلَقَ الوَرى أَطوارا",86,"ر",2,0],["وَلَقَد عَلِمتَ بِأَنَّ هَذي أَنعُمٌ","لا يَستَحِقُّ جَزيلَها إِلّاكا",87,"ك",2,0],["وَلَقَد عَلِمتُ بِأَنَّ قِدحَكَ فائِزٌ","لا شَكَّ مُذ أَرسَلتَها إِرسالا",88,"ل",2,0],["وَلَقَد عاقَ عَن لِقائِكَ خَطبٌ","لَيتَهُ لا يَعوقُ عَن أَن أَقولا",89,"ل",2,0],["وَلَقَد عَمَمتَ المُذنِبينَ صَنائِعاً","حَتّى لَظَنّوا أَنَّهُم لَن يُحرَموا",90,"م",3,0],["ولقد علمت بأنني مستهدف","حتى أبدّل حالتي وعصابتي",91,"ي",1,0],["ولقد علمت وقد علمنا أَنه","لسواك مكة لا تكون بلادا",92,"د",2,0],["ولقد علمت بأن رزقا قد قضي","للمرء ما هو عنه بالمنفك",93,"ك",1,0],["ولقد عجبتم إذ غنيتُ بمالهِ","من كونِ مفقودٍ سواه يهيضُ",94,"ض",1,0],["ولقد عذرتهم لعلمي أنهم","لولا القضا المحتوم ما فعلوه",95,"و",2,0],["ولقد عزمتُ على السلوِّ مصمِّما","فإذا الجوانحُ كلها من حِزْبِه",96,"ب",2,0],["وَلَقد عَلاهم فاتِحاً ومتمّما","اللَّهُ قَد صلّى عليهِ وسلّما",97,"م",2,0],["ولقد عهدتُك كوكباً أَبراجه","جُرْدُ المذاكي والسماءُ قتام",98,"م",1,0],["ولقد عَيينا إذ توالى سُكرُنا","أَلحاظُه مالتْ بنا أم كاسه",99,"س",2,0],["ولقد علمت ولا محالة انها","ضرَمٌ على أكبادهم لا يبردُ",100,"د",1,0],["ولقد علمت وما لداء في الهوى","الا الشفاه من الحسان شفاء",101,"ا",2,0],["ولقد عبثت بنهدها حذرا","فوجدته لحنانها ضرعا",102,"ع",2,0],["ولقد علمتمْ أَنني رُضْتُ العُلا","يَفَعاً وحاولتُ المكارمَ مُرْضعاً",103,"ع",2,0],["وَلَقَد عَلاهُ حُلَّتانِ تَرَوّيا","بِالزَّعفَرانِ الغَضِّ صَفرَوانِ",104,"ن",1,0],["وَلَقَد عَلا قَدَم النَّبِيِّ بِنَعلِهِ","رَجُلٌ أَضَرَّ بِرخصَةٍ خمصانِ",104,"ن",1,0],["وَلَقَد عَرا الجَدبُ المَدينَةَ مُجحِفاً","بِجِمالِها وَبِمَعزِها وَالضانِ",104,"ن",1,0],["وَلَقَد عَهِدتُكِ في الشَبيبَةِ مَألَفاً","نَغشاهُ قَبلَ تَفَرُّقِ الأُلّافِ",105,"ف",1,0],["وَلَقَد عِشتُ بُرهَةً بَينَ أَبنا","ءِ زَماني كَالمَسجِدِ المَهجورِ",106,"ر",1,0],["وَلَقَد عَلَوتُ سَراةَ أَشهَبَ تُجتَوى","وَتُعافُ عِندَ الغانِياتِ شِياتُهُ",107,"ت",2,0],["ولقد عجبتُ لِهِمَّتي كيف اهتَدَت","لسبيلها اللُّوَّامُ والعُذَّالُ",108,"ل",1,0],["ولقد عهدتك تشتهي","قربي وتستدعي حضوري",109,"ر",2,1],["ولقد عز من تواضع اللَه","وإن كان في السماك وساده",110,"د",2,0],["ولَقَد عشتُ زَمَاناً","في فيافيَّ وَجِيها",111,"ي",3,0],["ولَقَدْ عَلِمْتَ وَلَمْ تَكُنْ بِمُعَلَّمٍ","أَنَّ الأَسى وَالْوَجْدَ لَيْسَ بِمُنْجِعِ",112,"ع",1,0],["ولقد عجبتُ لمنْ يحاولُ هَدْمَه","وَعَلَى الجماجمِ وُطِّدَتْ أركانه",113,"ن",2,0],["ولقد عملت حساب صبري بعدكم","ونظمته في هذه الأوراق",114,"ق",1,1],["وَلَقَد عَهِدنَاهُ يَحلُّ بِبُرجِهَا","فَمِنَ العَجَائِبِ كَيفَ حَلَّت فِيهِ",115,"ه",1,0],["ولقد عدت يا فؤاد فلا تأ","س على ما فقدته من طلاب",116,"ب",1,0],["ولقد عَلِمْتُ بأنّنِي","ألقَى لِذاكِ أَحَقَّ وال",117,"ل",1,0],["ولَقد عَجِبتُ اليومَ في","ما في يَدَيكَ مِن المكارِم",118,"م",1,0],["ولَقَد عَذَرتُكَ حينَ تَظلِمُني","مِن حَيثُ ذُقتُ حَلاوةَ الظُّلمِ",119,"م",1,0],["ولَقَد عرضتُ عَلى الرَّجا","ءِ سِواكَ مَرجُوّاً فَخافَه",120,"ف",2,0],["ولقد علمتَ مودّتي","والشكُّ يُذْهِبُهُ اليقينُ",121,"ن",1,0],["ولقد عاد كما قال لنا","وهو الصادق حقاً كَلِماً",122,"م",2,0],["ولقد عجبت لما ذكرت وهكذا","حال الزمان وأهله وخلائقه",123,"ق",2,0],["ولقد عجبت لطول عتبك لي","أجهلت أنك ساكن القلب",124,"ب",1,0],["وَلَقَد علمت بِأَنَّ مَوتي عِندَهُ","هَزَلاً يَفوق العَيش عند سِواهُ",125,"ا",2,0],["وَلَقَد عَهَدتُ بِهِنَّ مأوى خائِف","وَأَمان مَحروبٍ وَجَنَّة جاني",126,"ن",2,0],["وَلَقَد عَهِدتَ بِها فَهَل عوَ عائِد","مَغدىً لِمُنتَجَع الصِبا وَمَراحا",127,"ح",2,0],["ولقد علمت ولا إخالُك جاهلاً","إنَّ العذولَ بهنَّ كانَ جهولا",128,"ل",2,0],["ولقد عميت عن الهُدى فيمن له","نظرٌ بغايات الأُمور حديد",129,"د",1,0],["ولقد عجبت لها ويعجبني","أمران ما اتفقا على أمر",130,"ر",1,0],["ولقد عراني منكم يوم النوى","أشواق قلب بعضها النيران",131,"ن",1,0],["ولقد عَقَدْتِ نَفَحْتُ آمالي كما","عُقِدَ الحليبُ بِجَوْهَرِ الأَنفحتِ",132,"ت",1,0],["ولقد عدِمْتَ سِوى لطيفِ هوًى","ما زال يُخْرِجُنِي من العَدَمِ",133,"م",1,0],["ولقد عذلْتَ فما عدلْتَ عن الهوى","ورأيتَ غيّي فيه عينَ رشادي",134,"د",2,0],["ولقد عدِمْتُ العيشَ لما هالَني","بدرٌ حُدوجُ العيسِ من هالاتِه",135,"ت",2,0],["ولقد عطلت صدور العوالي","مثلما عطّلت ظهور الجياد",136,"د",1,0],["ولقد عرفت الدهر إذ من شأنه","رفع الوضيع وخفض كل مرفّع",137,"ع",1,0],["ولقد عَضضتَ عَلَى الخطوبِ بناجِذٍ","للدَّهرِ منه سكينةٌ وَوَقارُ",138,"ر",1,0],["ولقد عقدت بك الرجاء لمعضل","من امر آخرتى قريب آتي",139,"ي",1,0],["ولقد عكستَ عليّ ذاك لأنني","كنتُ الحبيبَ إليك قبلَ تراني",140,"ي",1,0],["ولقد عزمتُ تصبُّراً أسلاكما","معه فأثقل حملُ صبري كاهلي",141,"ي",1,0],["ولقد علمتَ وفي الشروع غضاضةٌ","أني إذا وردَ الحريصُ أعافُ",142,"ف",1,0],["ولقد علمتَ وكلُّ مولى نِعمةٍ","أني إذا ثقل الحريصُ مخفِّفُ",143,"ف",1,0],["ولقد علمتِ وعهدُ رامةَ عهدُنا","فَتيْين أنِّي لم أشبْ من كَبرةِ",144,"ه",1,0],["ولقد علمتُ بأنَّ نفسي صارمٌ","والحادثات وإن كرهتُ صياقلُ",145,"ل",1,0],["ولقد عجبتُ من الطبي","بِ وأنْ يُخبِّرَ بالصوَّابِ",146,"ب",1,0],["ولقد عجبتُ من المَنيَّةِ اِذ غَدا","منها مُطيعٌ ما أردْتَ ومُجْرِمُ",147,"م",1,0],["ولقد عزمت على قضاء فروضها","لما زللت فلم أقم بأدائها",148,"ا",3,0],["ولقد عهدتك في المعالي","عاصياً من كان فنَّد",149,"د",1,0],["وَلَقَد عَرَفتُ فَما أَوَيتُ لِمُدنِفٍ","ما النَفسُ عَنكِ وَإِن نَأَيتُ بِسالِيَه",150,"ي",2,0],["ولقد عرفت خليلة ستحية","فيها الأمان لساكن ومراح",151,"ح",1,0],["ولقد عهدت حماك وهو معرَّس","لي دخْله وعلى سوايَ خراجه",152,"ج",2,0],["وَلَقَد عَلِمتُ عَلى تَجَنُّبِيَ الرَدى","أَنَّ الحُصونَ الخَيلُ لا مَدَرُ القُرى",153,"ا",1,0],["ولقد عرفنا بين اصحاب الوحا","للمرتضى أسد الكتائب آلا",154,"ل",2,0],["وَلَقَد عَلَمتَ وَأَنتَ فينا شاهِدٌ","وَسُيوفُنا تَفري فُروعَ الهامِ",155,"م",1,0],["ولقد عدمناه فنبت نيابة","عز الغني بها وأثرى المعسر",156,"ر",1,0],["وَلَقَد عَهِدت بِها سَعاد وَإِنَّها","بِاللَهِ جاهِدَة اليَمين تقسم",157,"م",1,0],["وَلَقَد عَلمت وَلَستَ تَجهَله","اِن العَطاءَ يَشينُهُ المَطل",158,"ل",1,1],["وَلَقَد عَجِبتُ لِأَهلِ هذا الطائِفِ","وَصُدودِهِم عَن ذا النَبِيِّ الواصِفِ",159,"ف",1,1],["ولقد عَاذَ بالمُهيمنِ قَبلِي","عَالِمُ الشرقِ عَبدُ مَن ذَاقَ بَاسَه",160,"س",2,0],["ولقد عَفَتْ من قبل أنْ","أوْفَتْ فقلْ لي مَن عَفاها",161,"ا",3,0],["ولقد عدّدَت عَلَي","ىَ ذُنوباً لم أجْنِها",162,"ن",3,0],["ولقد عجبتُ لمعشرٍ صانوا الغِنى","وأَذَالَ منهم ما سواه مُذيلُهُ",163,"ل",2,0],["ولقد علمتُ على الهوى","أنّ الهوى سُقمٌ وذُلٌّ",164,"ل",1,0],["ولقد عجبتُ على المسافةِ بيننا","كَيف اِهتدى من غير هادٍ موضعي",165,"ع",2,0],["ولقد عجبتُ لخابطٍ ورقَ الغِنى","من كلّ ذي جَشَعٍ وخدٍّ أضرَعِ",165,"ع",1,0],["ولقد علمتُ وقد نُزعت شبيبتي","أنْ لا نصيبٌ في الظّباءِ الغِيدِ",166,"د",1,0],["ولقد علمتُ بأنّها لا تنتضِي","إلّا شَبا ماضِي الغِرارِ مهنَّدِ",167,"د",1,0],["ولقد علمتُ زمانَ تبغِي كارهاً","قربي ببعدك أنّنِي لا أربحُ",168,"ح",1,0],["ولقد عَمَرتُ مراسلاً من قبلهِ","فأعاد لي رُسُلي بغير جوابِ",169,"ب",1,0],["وَلَقَد عَتبت على الّتي صَرَمَتْ وقد","وَصل المشيبُ وما أفاد عتابي",169,"ي",1,0],["وَلَقَد عَلِمتُ بِأَنَّهُ ما مِن فَتىً","إِلّا سَيُبدَلُ بَعدَ حالٍ حالا",170,"ل",2,0],["ولقد عَجِبتُ لمادحٍ لم يَهْجُني","كَرَمُ الطبيعةِ كانَ آيةَ عُذرِهِ",171,"ر",2,0],["ولقد عَرَكتُ الدَّهرَ أطلُبُ حِكمةً","فأفادَني والدَّهرُ خيرُ مؤدِّبِ",172,"ب",1,0],["وَلَقَدْ عَلَتْ دُنْيَايَ بَعْدَ","كَ وَحْشَةٌ مِنْ بَعْدِ أُنْسِ",173,"س",1,0],["ولقَدْ عجِبْتُ من اللّيا","لي كيف هاضَتْ من جَنَاحي",174,"ي",1,0],["ولقد عَلمْتُ قُصورَ ما قد قُلْتُه","فأَرَدْتُ أَودِعُه حَشَا كِتْمَاني",175,"ي",1,0],["ولقد علا بأَبي عليّ جِدُّ من","جعل الرَّجاءَ إِليه أَنفسَ مُقْتنى",176,"ن",2,0],["ولقد عَطِشتُ إِلى ندى","كفيكَ يا بحراً خِضَمّاً",177,"م",2,0],["ولَقَدْ عَامَ في بحارِ دُمُوعٍ","ظَنَّ مِنْها أَنْ لا وصولَ إِلى الْبَرْ",178,"ر",1,0],["ولقد عَجَزْتُ لفرط فَقْ","رِي عن طَعامِي أَو شَرَابِي",179,"ي",1,0],["ولقد عَلَتْ رُتَبُ الأَجَلِّ على الوَرى","بِسُمُوِّ منصِبِهَا وطيبِ نِصَابِها",180,"ب",3,0],["وَلَقدْ عَلاني لاِحْمِرَارِ خُدُودهِ","فَرْطُ اصْفِرارٍ حَارَ مِنْهُ النّاظِرُ",181,"ر",1,0],["وَلَقَدْ عَهِدْتُ النارَ شِيمَتُها الهُدى","وَبنارِ خَدِّكَ كُلُّ قَلْبٍ حَائِرُ",181,"ر",1,0]]}