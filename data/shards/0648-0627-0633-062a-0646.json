,[5974,"عَرَّابة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206697",""],[6003,"عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=189045",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[1583,"الموعد الضائع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73063&r=&rc=20",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[6213,"شق النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76280&r=&rc=37",""],[6236,"إذاً .. فَلْنَقتُل الحُبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81604&r=&rc=2",""],[6260,"وعد بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68317&r=&rc=10",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["وَأَستَنزِلَنَّ المَجدَ مِن قُذُفاتِهِ","وَلَو كانَ أَعلى يَذبُلٍ وَشَمامِ",0,"م",1,0],["وَاِستَنزَلَ الأَذواءَ عَن نَجَواتِهِم","فَغَدَوا ذَوي ضَرَعٍ وَطَولِ خُمولِ",1,"ل",1,0],["وَاِستَنزَلوا أَرزاقَهُم لِسُيوفِهِم","فَغَنوا بِغَيرِ مَذَلَّةٍ وَصَغارِ",2,"ر",1,0],["واسْتَنْفَضَ القَلْبَ طَرْفٌ في لَواحِظِهِ","تيهُ المُلوكِ وأنْفٌ كلُّهُ شَمَمُ",3,"م",1,0],["وَاِستَنهَضوني فَلَمّا قُمتُ مُنتَصِباً","بِثِقلِ ما حَمَّلوا مِن وُدِّهِم قَعَدوا",4,"د",3,0],["وَاسْتَنْجَزَ النَّصْرَ الْعَزِيزَ وَلَمْ يَزَلْ","يَلْوِي بِدَيْنِ الدِّينِ فِيكَ مَطُولُهُ",5,"ل",2,0],["واسْتَنْطَقَتْ عُوداً بمِدْحَةِ يُوسُفٍ","مَوْلَى الوَرى شَمَلَ الوُوجودَ سَماحا",6,"ح",2,0],["وَاسْتَنْزَلَ الْوَحْيَ فَخَطَّتْ لَهُ","أَيَةَ نُورٍ فَتَوَلَّى الكَلامْ",7,"م",1,0],["واستنفروا لعدوّ الله كل فتىً","ممن نأى في أقاصي أرضكم ودنا",8,"ن",2,0],["واستنهضوا من بني الإسلام قاطبةً","من يسكُن البدو والأريافُ والمُدُنا",8,"ن",2,0],["واستنكفوا في الوغى أن تلبسوا أبداً","عار الهزيمة حتى تلبَسوا الكفنا",8,"ن",2,0],["واستَنْقَعت فيها المياه فطَحْلَبت","بالمُكث ترغو تحتها الحَمَآت",9,"ت",1,0],["وَاِستَنزَلوا حَسّانَ وَاِبنَي مُنذِرٍ","أَيّامَ طِخفَةَ وَالسُروجُ تَقَعقَعُ",10,"ع",1,0],["وَاِستَنكَرَ الفَتَياتُ شَيبَ المَفرِقِ","مِن بَعدِ طولِ صَبابَةٍ وَتَشَوُّقِ",11,"ق",1,0],["واستنقب الشر من مقادحه","وكان في ظهر آلة حدب",12,"ب",1,0],["واستناب الخطوب حتى أنابت","ربَّما لا تُنيبُ للمستنيبِ",13,"ب",1,0],["واستنهضَ البدنَ الكلي","ل فزاده نَهَكاً وكدّا",14,"د",2,0],["واستنجد الفكر محتالاً فأنجدَهُ","بصبغة نُشرتْ ليلاً على الشَعر",15,"ر",1,0],["واسْتَنْطِقِ العُودَ الفصي","حَ عن المثالِثِ والمَثَاني",16,"ن",2,0],["وَاِستَنجَدَت روحي الخَيالَ فَخانَني","وَكَبا جَوادُ فَصاحَتي وَتَعَثَّرا",17,"ر",2,0],["وَآسَت نَفسَها وَطَوَت حَشاها","عَلى الماءِ القَراحِ مَعَ المَليلِ",18,"ل",1,0],["وَأَستَنشِقُ الريحَ الجَنوبي وَأَنثَني","وَلي أَنَّةٌ مِنها كَما أَنَّ وَلهانُ",19,"ن",1,0],["وَأَستَنشِقُ الأَرواحَ مِن كُلِّ وُجهَةٍ","فَأَعلَمُ في أَيِّ الجِهاتِ خِيامُهُ",20,"م",2,0],["واستنزل المقدور صر","عته وأرهقه المحتم",21,"م",1,0],["وَاِستَنارَ رَفرَفُهُ","وَالسُجوفُ وَالحُجُبُ",22,"ب",1,0],["واستنزلَتْني عن يَفَاعِ أبيَّتِي","ثم انثنتْ ورجاؤُها مكذُوبُ",23,"ب",1,0],["وَاِستَنكَرَت ظَعَني عَنها فَقُلتُ لَها","إِلى الخَليفَةِ أَمضى العيسَ مُمضيها",24,"ي",3,0],["واستنبطَ الشُّربَ الذي غَنِيَت به","شِيرازُ عن صَوبِ الغَمامِ الهاطِل",25,"ل",1,0],["وَاِستَنفَرَت لَما رَأَتكَ وَطَالَما","كانَت تَحِنُّ إِلى لُقاكَ وَتَرهَبُ",26,"ب",1,0],["وَاِستَنشَأوا مِنهُ قُتاراً نَشرُهُ","مِن عَنبَرٍ ذَفِرٍ وَمِسكٍ داري",27,"ر",2,0],["وَاِستَنكَحَ النَومُ الَّذينَ نَخافُهُم","وَرَمى الكَرى بَوّابَهُم فَتَخَبَّلا",28,"ل",2,0],["واستنفرت من قريشٍ كلَّ ذي نَزَقٍ","إذا يُشارُ إليهِ بالبنانِ هَفَا",29,"ف",2,0],["وَاِستَنهَضوني فَلَمّا قُمتُ مُنتَصِباً","بِثقِلِ ما حَمَّلوني وُدَّهُم قَعَدوا",30,"د",3,0],["واِستنكرت ما قد أَصا","بَ من الأسى لَيلى وسعدى",31,"د",2,0],["واستنكروا علوّه بالدّور","عن دارة الثلاثة البدور",32,"ر",1,0],["وَاسْتَنَّ أَحْمَدْ ذَلِكَ السَّنَنَ الَّذِي","عَانَى مَصَاعِبَهُ بِغَيْرِ كَلاَلِ",33,"ل",1,0],["وَاسْتَنْفَدَتْ لِبَقَائِهِ","حِيَلَ الْحَرِيصِ عَلَى الْبَقَاءْ",34,"ا",2,0],["وَاسْتَنْفَدُوا زَفَرَاتِي","وَأَدْمُعِي وَمِدَادِي",35,"د",2,0],["واستنبح أبناءها واسترسل","إنما الأمة للجيش وقد",36,"د",1,0],["واستنطقت عود الغناء فلم نجد","إذ ذاك في خلع العذار جناحا",37,"ح",2,0],["واستنطقت عودا بمدحة يوسف","مولى لنا شمل الوجود سماحا",37,"ح",2,0],["واستنطق الباب ومدّ المنى","وهو احتراق وانتظار سئول",38,"ل",1,0],["واستنزلتها قبضتا وهمه","فضمّها ، قبل احتمال النزول",38,"ل",1,0],["وأستنشد الصمت وحدي هنا","وأخيلتي تعبّر السرمدا",39,"د",2,0],["وأستنبت الرمل بالأمنيات º","زهورا ، وأستنطق الجلمدا",39,"د",2,0],["واستنزلَتْكَ لغُربةٍ ولأنتَ مِن","عَلياك في لَجِبٍ من الأنصار",40,"ر",1,0],["واستنطِقِ \" الرَّمَلاتِ \" في جَنَباتها","ولطالما استوحى النبوغُ رمولا",41,"ل",2,0],["واستنجحِ العزمَ ولاتُماطل","عساكَ أن تحظى بنفلِ النَّافل",42,"ل",1,0],["واستنابَ الخطوب حتى أنابت","وبما لا تُنيبُ للمُستنيب",43,"ب",1,0],["واستنكروا شر الاستنكار هرولتي","إلى الخرابيش مع صحبي وندماني",44,"ن",2,0],["واستنارتْ مِنْ نُورهِ كلُّ طُرْقٍ","مثلها كالشُّموسِ أو كالبُرُوقِ",45,"ق",1,0],["وَاِستَنفَقَ الرَكضُ الجِيادَ فَخَيلُهُم","مَهرِيَّةٌ وَسُروجُهُم أَقتابُ",46,"ب",1,0],["وَاِستَنطَقَ الأَسيافَ عِلماً أَنَّها","تُغنيهِ أَن يَستَنطِقَ الأَقلاما",47,"م",2,0],["وَاِستَنطِقِ الآثارَ عَمْ","ما كانَ في تِلكَ البَسابِسْ",48,"س",1,0],["واسْتنبطِ السَّعدَ من مدح السعيد تجِدْ","بحرا يُمِدُّك لا يفنَى مدى الأبد",49,"د",1,0],["واستنهضتك إلى الوصا","ل وخالفت عذّالها",50,"ل",3,0],["وَاِستَنفَروا بِنَوىً حَذّاءَ تَقذِفُهُم","إِلى أَقاصي هَواهُم ساعَةَ اِنطَلَقوا",51,"ق",3,0],["واستنشقوا لثنائِهِ عَرْفَاً به","ينحطُّ عن نفسِ الصباح لثام",52,"م",1,0],["واستنطِق الأجفانَ فه","يَ بلحظِها تتكلّم",53,"م",1,0],["وَاِستنشدَ الأَشعارَ مُستَمعاً لَها","مُستَحسِناً مِن غَيرِ ما نُكرانِ",54,"ن",1,0],["وَاِستَنَّ مِنكَ بِما سَنَن","تَ مِنَ المَكارِمِ وَاِقتَفاها",55,"ا",3,0],["واستنطق الزير إنني رجلٌ","يعجبني ما يقوله الزير",56,"ر",1,0],["واستنشق الأرواح منهُ تلقَها","من جنّة الفردوس فيه فائحه",57,"ح",2,0],["واستَنبَطَالعبدُ معبوداً لذلّتِهِ","وضعفهِ وغدا بالدِّين مُرتبطا",58,"ط",2,0],["واِستنجد ابن ابي بكر تجده فَتى","يَقضي فَيَمضي وامر اللَه مَفعول",59,"ل",1,0],["واِستَنجد والهم السرية واقمعوا","زمنا تَكون الحرب فيه سجالا",60,"ل",2,0],["واِستنظري فرص الايام عائدة","واِستعملي الصبر وارعى ترك شكواك",61,"ك",1,0],["وَأَسْتَنُّ في شَأْوِ المدائِحِ سابِقاً","وَهَيهات لا تُحصِي المَدائِحُ ما سَنَّا",62,"ن",2,0],["وَاِستَنقَذَ البَيتَ المُقَدَّسَ عنوَةً","مِن كُلِّ ذي نَجِسٍ بِكُلِّ مُطَهَّرِ",63,"ر",1,0],["واِستَنبِ عن شُروطها","توقَّ مِن مَسخوطها",64,"ه",2,0],["واستَنبِ عن أَحوالهم","وعفَّ عن أَموالهم",64,"م",1,0],["واستنطقتْ قانونها فأجابها","في حلِّ قتلِ المستهامِ المغرم",65,"م",1,0],["واستنهضوا العزم وانقادوا لمقصدكم","وقدموا لبن العلياء للباني",66,"ن",2,0],["وَاِستنر في سَما العُلى شَمس فَضلٍ","لا ترى أَعيُن الحَسود زَواله",67,"ل",2,0],["وَاستَنجِزِي فِيهَا الوُعُودَ بِفَتحِهَا","فَلَعَلَّهَا ادُّخِرَت لِهَذا العَامِ",68,"م",1,0],["واستَنْطَقَ الطّيرَ الرّبيعُ فأصبحَتْ","في شُكْرِه عُجْمُ الطيورِ فِصاحا",69,"ح",2,0],["واستنَّ أن حجبَ العيونَ بِصَدِّه","فاليومَ حُجابُ الملوكِ صُدودُها",70,"د",3,0],["واستُنزفت مني القوى","واستُقطرت مني دموعي",71,"ع",2,0],["وَاِستَنطَق الوَتر الرَخيم فَأَنَّهُ","شادٍ بان يُصغى إِلَيهِ حَقيق",72,"ق",1,0],["واستنج ثم أنونيتك الوضو للصلاه","وعمم الوجه وابعد مانجد من أذاه",73,"ا",2,0],["واستنج أول لها","ثم الوضو بعد آت",74,"ت",1,0],["واسْتَنزلوكَ وأضرموا نيرانَهْم","كيْ يُحرقوا الجسْمَ المصونَ الأَطْهَرا",75,"ر",2,0],["واستنزلت مطراً من كل معصرة","لا تعجبن فقد تجري الرياح بما",76,"م",2,0],["واستنزِلِ الرِّزقَ بمضربيهِ","إنْ قعَدَ الدَّهرُ فقُمْ إلَيهِ",77,"ي",2,0],["واستنزلوا جودكَ المعهود فاسقهِم","ريّا بربهُم رضى لم يثنهِ سخطُ",78,"ط",1,0],["واستنهضت فوارها","يهدي لها درر النحورِ",79,"ر",1,0],["واستنفر المحبوب منه حينما","وافى وفاء الأنس للأدجاس",80,"س",1,0],["واستنزِلاَ بلطيفٍ من حديثِكُمَا","قلباً طواهُ على الأَحقادِ أَحْقَابا",81,"ب",2,0],["واستنشِقُوا الريحَ البليلَ عَلَّها","تُخْمِدُ من نارِ الجَوَى بلابلا",82,"ل",2,0],["واستَنْشِق الروض تجِدْ من نَشْرِهِ","وبِشْرِهِ الممدوحِ مَعْنًى حاصِلا",82,"ل",2,0],["واستنطق العودَ أو فاسمعْ غرائبَهُ","من ساجعٍ لحنُه يسترقصُ العودا",83,"د",2,0],["واستنشرتْ دُرَرُ الشؤو","نِ فنظّمتْ برباهُ عِقْدا",84,"د",2,0],["وأَسْتَنْشِقُ النَّكْباءَ وَهْيَ بَوارِحٌ","وأَسْتَوْطِئُ الرَّمْضاءَ وَهْيَ تَفُورُ",85,"ر",1,0],["واستنبطوا للطبع آ","لات تدور على محاور",86,"ر",1,0],["واستنَّ ماءُ الوُطف يشفع سحَّه","خصرٌ تُرَضُّ له حصى المَعْزاءِ",87,"ا",2,0],["واستنابَ الرأيَ عنْ حَمْلتهِ","فكفاهُ الرأيُ أنْ ينْضو الحُساما",88,"م",2,0],["واستنجد الكتمان والمع بائح","بأن النوى حال يذم كتومها",89,"م",3,0],["واستنقع الماء الزُّلال من الجوى","ويأبى ولوعي أن يبلَّ أوامُ",90,"م",1,0],["واستنشقا نفحاتِ البانِ أن نسمتْ","بنافحٍ مِنْ عبيرِ العِقْدِ ضَوّاعِ",91,"ع",1,0],["وأستنشقُ الأرواحَ شوقاً اليهمُ","وأسألُ آثارَ المعاهدِ عنهمُ",92,"م",1,0],["واستنجد الدول المسيحية التي","كرهت حياة المسلم المبذول",93,"ل",1,0],["واستنهضت ما استنهضت","ما للهلال الأحمر",94,"ر",1,0],["واستنهضوا لمجاني غرسهم همما","تعد منتهم من أقدس المهن",95,"ن",1,0],["واستنطقوا باعث الإحساس رائدهم","من كل ذي أدب أو شاعر لسن",95,"ن",1,0],["واستنجز الوعدَ فأوْمى اللّهُ","من قامَ لما قعدوا إلا هو",96,"و",1,0],["واستنْشِقي عِطرَ النُّبوَّةِ منه عن","صدقٍ وقَلباً عنهُ لا تتحوَّلي",97,"ل",2,0],["واستنطقتني في علاه صنائع","صانت لسان المدح أن يتقولا",98,"ل",2,0],["واِستُنزِلوا عن كلّ شاهقةِ البِنا","من حيث لا ترقى أخامصُ راقِ",99,"ق",1,0],["واستنطقوا الدفَّ ينطقْ بالإشارة عن","معنىً بدا وهو في الأكوان مستتر",100,"ر",1,0],["واستنزلهْ عل ينزل بالرداح البكرْ","عليك يوماً فتنجو من قيود الفكرْ",101,"ر",1,0],["واستَنكَفَ الشَّوقُ من مَثواهُ في بَدَنٍ","كأَنُّهُ طَلَلٌ في الأَربُعِ الدُّرُسِ",102,"س",1,0],["واستند راحته فديدنها الغنى","إذ تبسط البذل بوعد منجز",103,"ز",1,0],["واستنشق الريح إن نسمت","فبالأنف من نشركم سافحه",104,"ح",2,0],["واِستَنارَت بالكهرباءِ ولكن","ذَهبيّا قد صارَ لون اللُجَينِ",105,"ن",1,0],["وَاِستَنشَقَت ريح القُدوم فَأَبصرت","وَبروحها سَمحت لِخَير بَشير",106,"ر",1,0],["واستنجدوا بالكلب أو","بالقط أو بالأرنب",107,"ب",1,0],["واستنكروا ما لو أُنيلوا بعضه","طاروا بما نالوه كل مطار",108,"ر",1,0],["وَاِستَنكَرَت ساقي ال