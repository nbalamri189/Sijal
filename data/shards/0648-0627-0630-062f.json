{"poems":[[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[41,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""],[154,"ألا فاذكروا المختار تحظوا بخيره","https://www.aldiwan.net/poem68598.html","الطويل"],[302,"وافى إليك بكأس الراح يرتاح","https://www.aldiwan.net/poem33302.html","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80185","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118395","البسيط"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93810","المنسرح"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94300","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93780","الطويل"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131004","الرجز"],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""]],"verses":[["وَإِذ دَهرُنا فيهِ اِغتِرارٌ وَطَيرُنا","سَواكِنُ في أَوكارِهِنَّ وُقوعُ",0,"ع",1,0],["وإِذْ دَهْرُنا فِيهِ اغْتِرَارٌ، وطَيْرُنا","سَوَاكِنُ في أوْكَاِهِنّ وُقُوعُ",1,"ع",1,0],["وَإِذ دجيءَ بِالتَخيير فاِختارَ رَبَّهُ","دَنا لَيلَةَ الإِسراءِ مِمَّن أَحَبَّهُ",2,"ه",1,0],["وإِذ دواعي الهوى للَّهوِ داعيةٌ","وَالقَلبُ في راحَةٍ وَالعَيشُ رَحراحُ",3,"ح",1,0],["وَإِذ دَخَلتُ إِلى الحِمى أَروي الظَما بَين","الأَحِبَّةِ مطفياً نيراني",4,"ن",2,0],["واذ دجت دون انوار الهدى فلم","كانوا له سرجا تجلو دجى الظلم",5,"م",1,0],["وَإِذ دَعا السُّحبَ حالَ الصَّحو فاِنسَجَمَت","وَمِن يَدَيهِ ادعُها إِن شِئتَ تَنسَجِمِ",6,"م",1,0],["وإذ دعاه إليه محتفلاً","بجعل تمليكه القديم جديد",7,"د",1,0],["وإذ دعته الحور أن أقبل وكن","مسارعا وجد في السراع",8,"ع",1,0],["وإذ دخل الغار الحمامة عششت","لتحميه ممن قد عنوا وتكبروا",9,"ر",3,0],["وإذ دنت منها عيون الشمس","فأنعشت رفاتها من رمس",10,"س",1,0],["وإذ درجوا كالرمل أعجز","عدة إلى تل عكا كالدبى المتراكم",11,"م",1,0]]}