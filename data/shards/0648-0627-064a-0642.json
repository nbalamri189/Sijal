هنيك بل نفسي أهني بما سنى","https://www.poetsgate.com/ViewPoem.aspx?id=181788",""],[4916,"ياسنين","https://www.poetsgate.com/ViewPoem.aspx?id=135641",""],[4929,"عروبة الزمن الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=215675",""],[4978,"تشطير مليك القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177220",""],[4984,"حيَّ على الصبح *","https://www.poetsgate.com/ViewPoem.aspx?id=175747",""],[4984,"بشرى","https://www.poetsgate.com/ViewPoem.aspx?id=175838",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""],[5037,"لما رأيت أنه هو عامر","https://www.poetsgate.com/ViewPoem.aspx?id=52800",""],[585,"سمعت صريف الباب وهو يسبح","https://www.poetsgate.com/ViewPoem.aspx?id=161931",""],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[5145,"أعينا فؤادي على ما يعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108214",""],[5147,"دعاه الهوى ما العصر عصر بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=166712",""],[5151,"عراقٌ وبعضُ المدحِ ذمٌ لغيرهِ","https://www.poetsgate.com/ViewPoem.aspx?id=185032",""],[5246,"يودعنا ولكن لا يريد","https://www.poetsgate.com/ViewPoem.aspx?id=187055",""],[5246,"أمن نسيم عليل صرت في أرق","https://www.poetsgate.com/ViewPoem.aspx?id=187056",""],[5328,"أغنية الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=212232",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5410,"طريق مستديرة","https://www.poetsgate.com/ViewPoem.aspx?id=140753",""],[5411,"وَحُبُّكَ موسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=186139",""],[5411,"ضفاف الروح..","https://www.poetsgate.com/ViewPoem.aspx?id=191907",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5436,"زفرات(على لسان العراق)للشاعر إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=129741",""],[5528,"اعتذار إلى ليلى العربية ..!","https://www.poetsgate.com/ViewPoem.aspx?id=201010",""],[5561,"الحوار السادس","https://www.poetsgate.com/ViewPoem.aspx?id=205186",""],[5629,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=184616",""],[5852,"وبالبيداء لما أن تلاقت","https://www.poetsgate.com/ViewPoem.aspx?id=52881",""],[5910,"تواضعتُ للرحمنِ فيما ينوبُني","https://www.poetsgate.com/ViewPoem.aspx?id=206522",""],[6032,"ترنيمة عشق إلهية","https://www.poetsgate.com/ViewPoem.aspx?id=181501",""],[161,"ضاع ترتيب الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=180916",""],[6127,"تدور مدار العشق","https://www.poetsgate.com/ViewPoem.aspx?id=188376",""],[242,"قرعت بذلي باب العزيز","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563724",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["وَأَيقَظتُ لِلبَرقِ اليَمانيِّ صاحِباً","بِذاتِ النَقا يَخفىمِراراً وَيَلمَعُ",0,"ع",1,0],["وأيقَنَ أني لا ألوذُ بباخِلٍ","يُضَيِّعُ عِرْضاً في صِيانَةِ مالِ",1,"ل",1,0],["وأيُّ قَريضٍ طبّقَ الأرْضَ لمْ يَرُضْ","قَوافيَهُ في مَدحِنا شُعَراؤُها",2,"ا",3,0],["وَأَيُّ قَطاةٍ لَم تُساعِد أَخا هَوىً","فَعاشَت بِضَيرٍ وَالجَناحُ كَسيرُ",3,"ر",1,0],["وَأَيقَنتُ أَنّي إِن تَكَلَّمتُ ضَرَّني","كَلامي فَآثَرتُ السُكوتَ عَلى الخُسرِ",4,"ر",1,0],["وَأَيْقَنَ مُرْتَابٌ وَأَصْحَبَ نَافِرٌ","وَأَذْعَنَ مُعْتَاَصٌ وَأَقْصَرَ مُشْتَطُّ",5,"ط",1,0],["وأيْقَنَ أنْ لمْ يَدَعْ غايَةً","لراجٍ ولا موْضِعا للمَزيدْ",6,"د",1,0],["وَأَيْقَنْتُ أنَّ اللهَ يَمْنَحُ جَاهِداً","وَيَرْزُقُ أَقْوَاماً بِغَيْرِ حِسَابِ",7,"ب",1,0],["وَأَيقَنتَ أَنَّ الدينَ لِلَّهِ وَحدَهُ","وَأَنَّ قُبورَ الزاهِدينَ قُصورُ",8,"ر",1,0],["وَأَيقَنَ إِن لاقَينَهُ أَنَّ يَومَهُ","بِذي الرِمثِ إِن ماوَتَتهُ يَومَ أَنفُسِ",9,"س",1,0],["وَأَيقَنتُ أَنِّي إِن لَقيتُكَ سالِماً","تَكُن نُجعَةً فيها حَياً مُتَظاهِرُ",10,"ر",1,0],["وَأَيقَنتُ التَفَرُّقَ يَومَ قالوا","تُقُسِّمَ مالُ أَربَدَ بِالسِهامِ",11,"م",1,0],["وَأَيقَنتُ لِمّا قَوَّضَ الحَيُّ خَيمَهُم","بِرَوعاتِ بَينٍ تَترُكُ الرَأسَ أَشيَبا",12,"ب",2,0],["وأيْقِنْ بأنَّ العلم إن كان صورةً","فإني له رُوحٌ وأنت له جِسمُ",13,"م",1,0],["وأَيْقَظَتْ في قُلوبِ النَّاسِ عاصِفَةً","غامَ الوُجودُ لها وارْبَدَّتِ السُّبُلُ",14,"ل",1,0],["وَأَيُّ قَبيلٍ يَستَحِفُّكَ قَدرُهُ","مَعَدُّ بنُ عَدنانَ فِداكَ وَيَعرُبُ",15,"ب",1,0],["وَأَيقَنَ الناسُ أَنَّ زارِعَها","بِالمَكرِ في قَلبِهِ سَيَحصِدُها",16,"د",3,0],["وأيقن أنَّ أرضك بعد شتّ","إذا صارت لدى التدبير ماءَ",17,"ا",2,0],["وأيقِنِا أنَّ قلبي ضَلَّ بينَكُما","فساعِداني ولو قولاً بنشدانِ",18,"ن",1,0],["وأيُّ قَناةٍ لم تُرنَّحْ كُعُوبُها","وأيُّ حُسامٍ لم يُصِبْهُ فُلولُ",19,"ل",1,0],["وأيقظَ منِّي ساهراً غيرَ راقدٍ","وحرَّضَ منّي هاجماً غير حائصِ",20,"ص",1,0],["وأيقظَ أبناءُ الضَّلالةِ فتنةً","تهالَكَ فيها مُخطِئٌ ومُصيبُ",21,"ب",1,0],["وَأَيقَنوا أَنَّ تَنويرَ الحَريقِ هُوَ ال","دُنيا يُمَلِّكُها وَالنارُ سُلطانُ",22,"ن",1,0],["وَأَيقَنَ أَنَّ الخَيلَ إِذ تَلتَبِس بِهِ","يَقِظ عانِياً أَو جيفَةً بَينَ أَنسُرِ",23,"ر",1,0],["وَأَيقَنتُ أَنّي لا مَحالَةُ مَيِّتٌ","فَمُتَّبِعٌ آثارَ مَن قَد خَلا قَبلي",24,"ل",2,0],["وَأَيقَنَ أَنّا لا نَرُدُّ صُدورَها","وَلَمّا تُواجِهّا جِبالُ الجَراجِمِ",25,"م",1,0],["وأيقنَ أنه ظِفرُ اللَّيالي","تبيَّنَ في شَبا ظفْرٍ ونابِ",26,"ب",1,0],["وَأَيُّ قَبيحٍ اِقبَحُ مِن لَبيبٍ","يُرى مُتَطَرِّباً في مِثلِ سِنّي",27,"ن",2,0],["وَأَيقَنَ أَنّي لا أَعودُ لَوَصلِهِ","وَلَو قَطَّعَت بيضُ الصَوارِمِ أَوصالي",28,"ل",2,0],["وأيْقَنَ بالسوءِ من صيده","فَدلَّ على سَبجٍ بالعَقيق",29,"ق",1,0],["وَأَيقَنتُ أَنّي فالِجٌ غَمرَ زاخِرِ","تَثوبُ إِلَيهِ بِالسَماحَةِ اَبحُرُ",30,"ر",1,0],["وَأَيقَظَ بَردُ الصُبحِ جَفنَ عَرارِهِ","تَرَقرَقَ دَمعُ الطَلِّ فيهِ فَسالا",31,"ل",2,0],["وَأَيُّ قَطاةٍ لَم تُعِركَ جَناحَها","فَعاشَت بِضُرٍّ وَالجَناحُ كَسيرُ",32,"ر",1,0],["وأيقنَ أنّ دِينَ اللَّهِ حَقٌّ","فما يُجدِي الضّلالُ وما يُفيدُ",33,"د",1,0],["وأيَّ قَوافي الشعرِ فيكَ أحُوكُهَا","وما تركَ التّنزيلُ من مُتَرَدَّم",34,"م",1,0],["وأيْقَظَ بالصّهيلِ الرّكبَ حتى","ظَنَنْتُ صَهِيلَهُ قِيلاً وقالا",35,"ل",2,0],["وأيقن إذ ماتا بجوع وخيبة","وقال له الشيطان انك عائل",36,"ل",1,0],["وأيّ قصد يرجي المرء في بلد","به تساوى سداد الرأي والخطل",37,"ل",1,0],["وَأَيْقَظْتَ أَلْبَابَ الرِّجَالِ فَسَارَعُوا","إِلَى الْجِدِّ حَتَّى لَيْسَ فِي النَّاسِ خَامِلُ",38,"ل",1,0],["وأيقظي «سعدًا» من المنامِ","قومي؛ فتلك ساعةُ القيامِ",39,"م",1,0],["وأيقظ العزم ان نامت لواحظه","في الجد لله لا وهنا ولا هلعا",40,"ع",2,0],["وَأَيُّ قَبيلٍ يَستَحِقُّكَ قَدرُهُ","مَعَدُّ بنُ عَدنانٍ فِداكَ وَيَعرُبُ",41,"ب",1,0],["وأيقنتَ أنّ الحالَ حالٌ تعسَّرَت","على كلِّ طَبٍّ بالطبائع ماهر",42,"ر",1,0],["وايقنَ إن لا قينه أن يومه","بذِي الرَّمثِ إنْ ماوَتْنهُ يوْمُ أنفُسِ",43,"س",1,0],["وأيقن أنضاء السفينة بالردى","يطالعهم في جيئة وذهوب",44,"ب",1,0],["وَأيْقَنَ أنّ الخَيْلَ إنْ تَلْتَبِسْ بِهِ","يَقِظْ عانِياً أوْ جِيفَةً بَينَ أنْسُرِ",45,"ر",1,0],["وأي قطاة لم تعرني جناحها","فعاشَتْ بضَيرٍ والجَناحُ كَسِيرُ",46,"ر",1,0],["وَأَيقَظ سَعيَهُ لِلفَصل كسباً","وَباقي الناس عَن كسب نِيام",47,"م",1,0],["وأيقن أن سيذكرنا زمان","سننسيه الأسافل بالأعالي",48,"ل",2,0],["وأيقنت مِلَّةُ الإسلامِ أنَّ لها","بِكَ الظُّهورِ على الأعداءِ والغلبا",49,"ب",2,0],["وأيقن أن الكلَّ بالله لاحق","فمن شوقه إعداده وعديده",50,"د",2,0],["وأيقن أن أمر اللّ","ه عقد ليس ينتثر",51,"ر",1,0],["وأيقن أنَّه الجبّا","ر هذا الخلق كلُّهم",52,"م",1,0],["وَأَيْقَظَنا رَيْبُ الزَّمانِ لِزَعْمِهِ","بِأَنَّا سَرَقْنا في المَنَامِ وِصَالا",53,"ل",2,0],["وأَيقنوا بأنهم إِن حاربوا","بجدهم فحسبهم ان يمزحا",54,"ح",2,0],["وأَيقنوا أن بيضاً أمسِ قد زجرت","وعادت اليوم لا تُبقي ولا تذرُ",55,"ر",1,0],["وأيقن مما قد تخيل أنكم","تعودون فيها حين يبرزها النقدُ",56,"د",1,0],["وأيقن بالفتح المبين وأنه","بيحيى ابن إسماعيل قد أمن الخذلا",57,"ل",2,0],["وأيقن الملك ان الشمل ملتئم","لما ملكت وأن الصدع قد شعبا",58,"ب",2,0],["وأيقن مرتاب وأخلص مسلم","وآمن مغرور وأفصح ذو النجوى",59,"و",2,0],["وأَيْقَنْتُ أَنِّي مُهْجَةٌ مُسْتَعارَةٌ","تُرَدُّ إلى مِلْكِ الْمُعِيرِ بِغُصّاتِ",60,"ت",1,0],["وإيقاعُ الضفادعِ فيه عالٍ","وللدولاب زَمْرٌ وَاصْطِخاب",61,"ب",1,0],["وَأَيْقَنَ أَنّ لَوْمَ الصَّبِّ لُؤْمٌ","وعذب العيشِ في ذاك العذاب",62,"ب",1,0],["وَإيقاظِيَ القَومَ أَن يَرقدوا","إِذا هَجَعَ الناسُ لَم أَهجَعِ",63,"ع",1,0],["وَأَيقَنتُ أَنّي لِما جِئتُهُ","مِنَ الأَمرِ لابِسُ ثَوبَي خَزى",64,"ا",1,0],["وايقنوا بنزول الراس انهم","غرقى وطالعهم في الحوت قد نزلا",65,"ل",2,0],["وَأَيُّ قَلبٍ لِزَئي","رِ بَأسِهِ لَم يَخفِقِ",66,"ق",1,0],["وَأَيْقَظَتْ نَائِمَ النّوَُّارِ نَشْوَتُهُ","بِالطَّلِّ إِذْ بَشَّرَتْ بِالصُّبْحِ أَطْيَارُ",67,"ر",1,0],["وَأَيْقَنْتُ أَنِّيَ إِذْ جِئْتُهُ","ذَلِيلاً لَجَأْتُ لِحِرْزٍ حَرِيزْ",68,"ز",1,0],["وأيقظني الدِّيكُ الفخورُ بفيقهِ","فقمتُ نشيطاً بعد أطيب هَجعة",69,"ه",1,0],["وإيقاظِ أفكارٍ وتطييبِ أنفُسٍ","وتجديدِ آمالٍ وتشديدِ همَّة",69,"ه",1,0],["وأيقَنَ أن النصرَ في جنب خصمِهِ","ولكن رأى حظَّ الشَّهيدينَ أفخرا",70,"ر",2,0],["وَأَيُّ قَلبٍ ثَوى ما بَينَ ضَربِ ظُبىً","وَطَعنِ سُمرِ قَناً يَوماً وَما هَلَكا",71,"ك",2,0],["وأيقنت أن الغنى عنده","لأن أياديه مثل الرباب",72,"ب",1,0],["وأي قرار لعينٍ غدت","ومحجرها بالبكا استجرا",73,"ر",2,0],["وَأيقَن كلٌّ أنّه بدءُ دورةٍ","يُراجعُ فيها أفقَ تونس نجمهُ",74,"م",2,0],["وَأيقِن بأنّ البحر يطمو عبابهُ","فحدِّث عنِ البحرِ الغطمطم ذي العبِّ",75,"ب",1,0],["وَأَيقِن أَنَّ ما أُفضِي إِلَيهِ","مِنَ الأَسرارِ مُنكَشِفُ الغِطاءِ",76,"ا",2,0],["وَأَيقَظَتهمْ أَيَادِيهِمْ فَسَارَ لَهُمْ","مَدْحٌ تَحلَّتْ بهِ الأَيَّامُ والسِّيَرُ",77,"ر",1,0],["وَأَيقَنتُ أَنَّ اللُطفَ مِنها دَنا بِها","خَيالاً لِعَيني بِالكَرى بَعدَ هَجعَتي",78,"ي",1,0],["وأيَقنوا أنَّ ما ضَمَّت أكفهُّمُ","عَليهِ أصلحُ لِلدُّنيا ولِلدِّينِ",79,"ن",1,0],["وَأَيقَنتُ إِن شاءَ الإِلَهُ بِأَنَّهُ","سَيُبلِغُني أَجلادُها وَقَصيدُها",80,"د",3,0],["وأيقن أن للعلم","يا مسكين ثمرات",81,"ت",1,0],["وأيقظ من زهر الرياض عُيونَها","ورَقَّص من أغصانها تِلْكُمُ القُضْبا",82,"ب",2,0],["وأيقَنْتُ أنَّ أُمورَ العِبادِ","مُسَطَّرَةٌ في كِتابٍ مُبيتِ",83,"ت",1,0],["وأيقَظَ وَجْدِيَ برقٌ يلوح","وقد نام عن أعينٍ لَم تَنَمْ",84,"م",1,0],["وأَيقَنَ أَن اللهَ صادقُ وَعْدِهِ","وأَنَّ أَمانيَّ الضلالِ كواذِبُهْ",85,"ب",2,0],["وأَيقنَ باغِي حتفِه أَنَّ أُمَّه","وَقَدْ أَمَّهُ الليثُ الهصورُ هَبُولُ",86,"ل",1,0],["وأيقنتْ دولةُ آلِ باسلٍ","أنّك يومَ بطشِها جبَّارُها",87,"ر",3,0],["وأيقنَ صدرِيَ أنّي أراك","لأهلك وجهاً وللناس صَدْرا",88,"ر",2,0],["وأيقنَ أن موسى شقَّ بحراً","بأن شُقَّت بكفّيك البحورُ",89,"ر",1,0],["وأيقنتُ أن زماني يص","ير عبدِيَ مذ صرتَ لي سيِّدا",90,"د",2,0],["وأيقنتُ أن الصبَّر أكرمُ نجدةً","على الشرِّ من شخت الغرار ضروب",91,"ب",1,0],["وأيْقن أنَّ الدهر لم يُخْلِ منهم","خطيب نَديٍّ أو كميَّ مَلاحمِ",92,"م",1,0],["وأيْقَنَ أنَّ البَأوَ كُفْرٌ لأنهُ","مُباراةُ جَبَّارِ السَّماءِ المُعظَّمِ",93,"م",1,0],["وأيْقَنْتُ أنَّ اللّهَ ذا العرشِ لمْ يُضِعْ","دُعائي وأنَّ الكَسْرَ يُعْقَبُ بالجَبْرِ",94,"ر",1,0],["وأىُّ قلبٍ يُرتجَى بُرْؤه","مُصَدَّعٍ بالوجدِ أعشارِ",95,"ر",1,0],["وأيُّ قلبٍ والحدوجُ قد سَرَتْ","عنِ الحِمى مُزمِعةً لم يَجزَعِ",96,"ع",1,0],["وأيقظ قلوبا فهي غاية منية","مراقب رس الملك في كل حاليا",97,"ي",2,0],["وأَيقَظَتْهُ يدُ التَّوفيقِ من سِنَةٍ","ومزَّقَتْ عنه ما أَقصاهُ من حُجُبِ",98,"ب",1,0],["وأيقنتُ بأنّ الحق","قَ منتصرٌ وإنْ عانى",99,"ن",2,0],["وأيقن أنني لم آت ذنباً","ودونك ما هويت من الفعال",100,"ل",1,0],["وأيقنَ أنّ بذْلَ المالِ يُبقي","له بُقْيا فخلّدَه بِفانِ",101,"ن",1,0],["وأيقظ لي أجفان حظي ولم أزل","أنبهها مذ كنت وهي رقود",102,"د",1,0],["وأيقنت الشجاعة ورداً","أحق فتي يلقب بالشجاع",103,"ع",1,0],["وإيقانٌ إذا شكَّ","أُولو الشكّ وإِذْعانُ",104,"ن",1,0],["وَأيُّ قَلبٍ حملت حزنكم","جوانحٌ منه وما فُطِّرا",105,"ر",2,0],["وأيْقنتُ أنّي ثاوياً في دياركمْ","مقيمٌ على آلِ القفارِ الصّحاصِحِ",106,"ح",1,0],["وأيقظ الخاطر من غفلة","وامسح من الأغيار كحل الرقاد",107,"د",1,0],["وأيقنت أن ذنوبي به","تساقَطُ عني سقوط الهَبَاءِ",108,"ا",2,0],["وأَيقنت أَني ميت وابن ميت","فلِلْمَوتِ تَردَادٌ إِلينا وتكْرَارُ",109,"ر",1,0],["وأيقَنوا أنهم في فِعلِهم غَلِطوا","وانهم نَصبوا من سُؤدُدٍ عَلَما",110,"م",2,0],["وَإيقاظِ طوبجيٍّ لخدمة مدفع","وَتَحريض خيَّالٍ عَلى أَسر ملحد",111,"د",1,0],["وَأَيقن أَني عاجز عَن لِقائه","وَأَنيَ ضاقَت بي عَليّ مَذاهبي",112,"ب",2,0],["وَأَيقظَني مَدحُ الكَريم فَلَم أَنَم","أُراقِبُ مِن طَيف البَخيلة موعدا",113,"د",2,0],["وأيقظ جفوناً طالما اعتادت الكرى","فأجفان أهل الصدق لا تعرف الغمضا",114,"ض",2,0],["وأي قضاء بينكم ترتضونه","وقد جئتكم بالبينات وألقيت",115,"ت",1,0],["وَأَيقن إِذا ما جِئتَ في كلِّ درَّةٍ","بِأَنَّكَ كَالمُهدي الجَواهِرَ لِلبَحرِ",116,"ر",1,0],["وأيقن أن متاع الحيا","ة نقش فلا بد من طمسه",117,"س",2,0],["وأيقن بالأجر أيقان من","يراه ويطمع في لمسه",117,"س",2,0],["وأَيْقِظي في بِلادِي النَّائِمينَ عَلَى","شَوْكِ القَتَادِ وَجَمرٍ بَاتَ مُضْطرِمَا",118,"م",2,0],["وأيقن أنَّ أمر الله جار","به أجرى لأهل الأرض أجرا",119,"ر",2,0],["وَأَيقِن أَنَّ مَن مارى أَخاهُ","تَعَرَّضَ مِن أَخيهِ لِلحاءِ",120,"ا",2,0],["وَأَيقَنتُ أَنَّ الرَّكبَ حادُوا سَفاهَةً","عنِ الدَّارِ حيَّتها بمُصلِحِها السُّحبُ",121,"ب",1,0],["وَأَيقنَ وقتَ الطعنِ أَن ليس نافعٌ","هنالك إلّا الحزمُ والعزمُ والصبرُ",122,"ر",1,0],["وأَيْقَنتُ أني بعد خمسين حجة","من العمر قَرَّبتُ المنية مَقْصدا",123,"د",2,0],["وأيقنت أنا أهل حق وإنما","دعوت لأمر كان أبطل باطل",124,"ل",1,0],["وأَيْقَظَني قَصْدُ الكريم فلم أَنمْ","أَراقِبُ مِنْ طَيْفِ البَخِيلةِ مُوعْدا",125,"د",2,0],["وأَيْقَنَ أَنَّ شُكْرَ المَرْءِ يَبْقَى","ويَفْنَى النَّاسُ جِيلاً بَعْدَ جِيلِ",126,"ل",1,0],["وَأَيقَن كُلٌّ أَنَّهُ بِبُلوغه","لِذاك الحِمى نالَ المُنى وَالأَمانيا",127,"ي",2,0],["وأيقن أن فضلك في اتساع","وان جدا نوالك غير خاف",128,"ف",1,0],["وَأيقظوهم بحوامي الخَيل","وَأنذروهم وَاحذَروا مِن مَيل",129,"ل",1,0],["وأيقنت أن ما قد","جنته لم يك ذنبا",130,"ب",2,0],["وَأَيقَظَ أَجفاناً وَكانَ لَها الكَرى","وَنامَت عُيونٌ لَم تَكُن قَبلَ تَهجَعُ",131,"ع",1,0],["وأيقظ العز إن نامت لواحظه","في الجد للّه لا وهناً ولا هلعا",132,"ع",2,0],["وَأَيقَنَ القَلبُ أنَّ الوَصلَ مُنقَطِعٌ","مزجت دَمعاً جَرى مِن مُقلَةٍ بِدَمِ",133,"م",1,0],["وأيقنَ كلٌّ منهم قام حشرُهُ","كأَنَّك تنعى كلّ حيّ وتهتِف",134,"ف",1,0],["وأَيقظيني من كَرى يقظتي","وحرّكي الساكن في مفَصِلي",135,"ل",2,0],["وأيقن أصحابه بالفرا","ق وأضحى ثوي ضريح الرجم",136,"م",1,0],["وَأَيقَظتَ عَمداً عُيونَ البَيانِ","مِن كُلِّ فَتّانَةٍ ساحِرَه",137,"ر",2,0],["وَأَيقَظتَ مِن قَدري وَما كانَ نائِماً","وَأَبعَدتَ مِن ذِكري وَما كانَ دانِيا",138,"ي",2,0],["وأيقنت لما راض دمعي جماحها","بأن دموع العين فاتحة السحر",139,"ر",1,0],["وَأَيقَنَ قومٌ أنها هيَ ترتمي","بهم بين مجنوب إليك وجانب",140,"ب",1,0],["وأيُّ قبيلٍ لم يُصدَّعْ جَمِيعُهُمْ","بِبَكْرٍ من الأرْزَاءِ أو بِعَوان",141,"ن",1,0],["وَأَيقَنَتا أَن قَد سَمِعتُ فَقالَتا","مَنِ الطارِقُ المُصغي إِلَينا وَما نَدري",142,"ر",2,0],["وَأَيقَظَ كُلُّ مُشتاقٍ مُيولَه","وَراحَت طَلعَةُ البَدرِ",143,"ر",1,0],["وَأيقنُوا عِندمَا أبدَى بِرايَتِهِ","إنَّ التَّخَلُّصَ مِن أظفارِهِ عَجَبُ",144,"ب",1,0],["وأيْقَنُوا أنَّ شَيْباناً وإخْوَتَهُمْ","قَيْساً وذُهْلاً وتَيْمَ اللاّتِ قدْ رَصَدُوا",145,"د",3,0],["وَأَيُّ قَبِيحٍ في سُلالَةِ صالِحٍ","فَيَحذَرَ بَرقاً مِن وَعِيدِكَ أَو رَعدا",146,"د",2,0],["وأَيْقَظْتُ من نَوْمِ الجهالة أَنْفُساً","إِن اسْتَيْقَظَتْ لي أَنفسُ الجُهَلاءِ",147,"ا",2,0],["وأيقظهُ من نو","مٍ لكيما به يسرى",148,"ر",2,0],["وَأَيقَنَت أَنَّها تَعودُ كَما","كانَ براها بِالأَمسِ خالِقُها",149,"ق",3,0],["وأيقظت القريحة من كراها","فلبتني ولي لم تعصِ امرا",150,"ر",2,0],["وأيقنتُ أنّ الحُجبَ زالت وأنني","دعانيَ داعيكم فلِم لا أبادِرُ",151,"ر",1,0],["وَأَيقِظوا هِمَماً قَد طالَ ما نَعَسَت","وَأَصبَحَت عَن مَقامِ العِزِّ في صَدَدِ",152,"د",1,0],["وأيقنت أن الموت حق وأنه","لنفسك إن لم تمض في الركض حابس",153,"س",1,0],["وأيقنت أن الموت أقرب موعد","وأن التي ناداك فيها الدهارس",153,"س",1,0],["وأيقنت أن لا حجب عن نور حسنها","سوى أن طرفي عن محاسنها أعمى",154,"م",2,0],["وايقنت أني في حياةٍ قبيحةٍ","وحين رأيت الحال غيرَ مُريحةٍ",155,"ه",1,0],["وأيقن كل ذي أملٍ وسؤل","بما هو من هناء العيش طالب",156,"ب",1,0],["وأيقنت أن الدهر ليس براجع","لتقديم عصر أو وقوف على حد",157,"د",1,0],["وايقنت أنى عمّهُنّ دعونني","حسان القوافي لا حواصن كالدمى",158,"م",2,0],["وأيُّ قياسٍ في نجومٍ تقدَّمَت","وَوَسمُهُمُ التقديمُ خَيرُ الأشايِر",159,"ر",1,0],["وَأَيقَنَ أَصحابِي بِأَنَّ مُقامَنا","عَلى مِثلِ هَذا مَحضُ عَجزٍ مُوَهَّمِ",160,"م",1,0],["وأَيْقَنوا أَنّ صُبْحَ الحقّ لاحَ لَهُمْ","والخَلْقُ دونَهُمُ تغشاهُمُ ظُلَمُ",161,"م",1,0],["وأيقنت الأرذال إِيقان صحة","بأن الوفيَّ منهم دون واحد",162,"د",1,0],["وأيقظت شعبا كساه الخمو","ل بشبه الجزيرة ثوب السقم",163,"م",1,0],["وأيقن بأن جماعة الط","طليان نجمهم غرب",164,"ب",1,0],["وأي قناة في طلى الأرض غيبت","وأي حسام في حشا القبر أغمدا",165,"د",2,0],["وَأَيقنوا أَنَّهُ لَو كانَ داخله","خَير البَرية لَم تنسج وَلَم تحم",166,"م",1,0],["وأيقاظا تراهم في كفاح","وتلقى غيرهم أبدا نياما",167,"م",2,0],["وأيقنوا أنّ في الملام لهم","نقيض ما حاولوهُ وانتظرُوا",168,"ر",3,0],["واي قواف تشتري عند كاذب","قد استشفع المعطين بالايم والطفل",169,"ل",1,0],["وأيْقَنَ أنَّ الأمْرَ مُؤْتَمَنٌ بهِ","فَحادَ إِلى الإيقانِ عَمَّا تَوَهَّما",170,"م",2,0],["وأيُّ قُلوبٍ هوَتْ إذ هوَتْ","فخفّتْ حَنيناً وطارتْ خُفوقا",171,"ق",2,0],["وَأَيقنتُ أن لا رجعةٌ لشبيبةٍ","وأن لا تلاقٍ بين حبٍّ ومنزل",172,"ل",1,0],["وأيقظت المعارف من سبات","بها أودى إلى ضيق الخناق",173,"ق",1,0],["وأيقن أن الشمس عند غروبها","جلت شفقا في خدها فتوردا",174,"د",2,0],["وأيقنت إني قد فتنتك عند ما","سمعتك من فرط الجوى متنهنا",174,"ن",2,0],["وأي قتيل لم يقل عند موته","لما خضت لو لم يوجداني لظى الحرب",175,"ب",1,0],["وَأَيقنتُ أنّ الدين أصبحَ مدبراً","فَماذا تصلّي بَعدهُ وتصومي",176,"م",2,0],["وأيقنت أني لم أمت قبل ساعتي","وأني إذا لم أحمِ لم يحمِ حاجمُ",177,"م",1,0],["وَأيقَنتُ أنيِّ أبتَرٌ مِن وِصَالِهِ","لَم تَسمَحِ الأيَّامُ مِنهُ بِمَأرَبِ",178,"ب",1,0],["وأيقظهم بصوت الحق جهارا","وكانوا قبل بعثته نياما",179,"م",2,0],["وأيقظ القلبَ من نؤمٍ ومن سنة","واملأه بالعلم والأنوار والحِكَمِ",180,"م",1,0],["وأيقنتُ ألا ندىً عنده","ولا وصلَ حين أُريد الوصالا",181,"ل",2,0],["وَأَيقنت أَنَّ العيش سر مطلسم","وَتَفسيره ان الحَياة أَماني",182,"ي",1,0],["وَأَيقَنَ مِن بَينِ السُّدَيْرِ وَجاسِمٍ","بِأَنَّ الجِرارَ السُّود بِالجرّد تجردُ",183,"د",1,0],["وإيقابٌ ببرقعها","رمت تبكي مولولة",184,"ه",1,0],["وَأَيقَنوا أَنَّ أَعداهُم وَقَد وَهَنوا","تُبيدُهُم في خَلاياهُم مَخافِقُهُم",185,"م",1,0],["وَأَيقَنتَ أَن الشَرَّ يُبديه طبعهُ","إِلى يَوم يرزا أَو يَدعدع في الرَمس",186,"س",1,0],["وأيقنتُ انا ما خُلِقنا لأُلفةٍ","فان عشقت نفسي سواكَ فما ذنبي",187,"ب",2,0],["وايقنت أن القول ما قلتَ فانتفع","بقولي ولا تجعل كلامي من الجُرم",188,"م",1,0],["وأَيقظ الديكُ كلّ غاف","برفع أَصواته العجال",189,"ل",1,0],["وأيقَنَ أنَّه يومٌ طويل","على قيسٍ يُذِيقُهمُ السِّماما",190,"م",2,0],["وأي قوام اثار هواهُ","وأية عينٍ رمتهُ النبالا",191,"ل",2,0],["وأيقظى العين من نوماتها وذرى","تكاثرا عن طلاب المجد ألهاك",192,"ك",1,0],["وأيقن أن المغرد ذاق طعم المحبه","فإن لو لا الشراب اللي صفا منه شربه",193,"ب",2,0],["وايقظنى في آخر الليل عندما","تولت جيوش الليل وهي فوازع",194,"ع",1,0],["وايقظت فيه راقد السبق بالسرى","وأطلقت في مضماره كل سابق",195,"ق",1,0],["وأيقظ لها عزماً يضيق ببعضه","على الرحب كثبان الفلا والصحاصح",196,"ح",1,0],["وأيقظ كل غامضة الليالي","فبارح أعين الدهر الرقادُ",197,"د",1,0],["وأيقنتُ أن الحظَّ قد فرَّ من يدي","وجاءَ مشيبي منذراً بغيابي",198,"ب",2,0],["وأيقنوا هناك بالمفازه","وكل سار أخذ احترازه",199,"ه",1,0],["وأيقنت أن لا بد ما دامت الدنا","لكل زمان من إمام مترجم",200,"م",1,0],["وأيقن أن سينال المراد","بذاك فهان عليه الدم",201,"م",1,0],["وأيقن أن ليس في جمعهم","بدين النبي سوى المستريب",202,"ب",1,0],["وَأَيقن بِأَنّ اللَه جلَّ جلالهُ","بِكُلّ شُؤونِ الخَلقِ أَلطافُه تجري",203,"ر",2,0],["وأيقنتُ أنَّ اليأسَ للعِرضِ صائنٌ","وأن سوفَ أغضَي للقَذَى حينَ أرغبُ",204,"ب",1,0],["وَأَيُّ قَومٍ أَدرَكوا غِبطَةً","دامَت لَهُم مِن آلِ حامٍ وَسام",205,"م",1,0],["وأيقظ من صلٍّ خلقت وها أنا","يسامرني من ظَلَّ أنوم من فهد",206,"د",1,0],["وأيقظه برقٌ تألق بالحمى","فهبَّ كما هب النسيم بقضبه",207,"ب",2,0],["وايقنت ان من رام الطويلة","فلايحيا الا من عاش سالي",208,"ل",2,0],["وأيُّ قيثارةٍ تصبو لها أُذُني","وحرْفُ همسِكَ يُطفي قلبَ مُحتَرقِ",209,"ق",1,0],["وأيقنّت من طبعه المذكور","ان التواضع له مشبر",210,"ر",1,0],["وأيقنت إذ واتاك أن قد تيقظت","لإرضاء أهل الأرض مقلته الوسى",211,"س",2,0],["وايقنت بان الكون مثلي يعاني","وان الشقا ماله مواعيد وحدود",212,"د",1,0],["وأيقنَ الغاصبُ المحتلُّ أنَّ غدًا","ليومِهِ باتَ حلما غيرَ مرتقَبِ",213,"ب",1,0],["وأيْقظ َنومتي نجم ٌبعيدٌ","(يسامرني على بعدٍ ضياهُ)",214,"ا",2,0],["وأيقنت رغم الصدود بأني","رضعت الهوى في الدهور صبيا",215,"ي",2,0],["وأيقنت أن الحظ رهن إرادتي","فقد أعلت الأقدار لي فوقه اليدا",216,"د",2,0],["وأيقظت قلبي غلى غرة","وأطلقت بالسحر أحداقها",217,"ق",3,0],["وأيقنوا مع ضياء الصبح أنهم","إن لم يزولوا سراعا زالت الخيم",218,"م",1,0],["وأيقنت أنها تتلو مراكزها","وكيف يثبت بيت ماله طنب",219,"ب",1,0],["وأيقنت أني إن أجلله ضربة","متى ماأصبه بالفرافر يعطب",220,"ب",1,0],["وأيقظت الأشجار رنةُ صوتها","فأوشك أن يخضر منها المصوح",221,"ح",1,0],["وأيقظ َ أهلَه ُ لِقيام ِ ليل ٍ","زكي ٍّ .. مُفْعم ِ الإيمان ِ عاطر ْ",222,"ر",1,0],["وأيقنت أن النوى غربة","وإنا لحكم الهوى طائعان",223,"ن",1,0],["وأيقن أن السوق سر وهيكل ال","طبيعة لا يسطيع أن يحمل السرا",224,"ر",2,0],["وأيقنت أن النَّسْرَ لو هِيض جنُحُه","سيَعلو وإن أبقى له الدّهْرُ جانِحا",225,"ح",2,0],["وأيقن أن رب العرش آلى","بأن الرزق يأخذه العبيد",226,"د",1,0],["وأيقظت فيّ ذكرى من قطعت لهم","ميثاق حب ولي بالمثل ميثاق",227,"ق",1,0],["وأي قرط جميل كان يسمعنا","وأي همس لهذا القرط أسررت",228,"ت",1,0],["وأيقن أن قد جاء إفكاً ولهجما","لعمري لذي الأبصار قد كان مظلما",229,"م",2,0],["وأيقنت بالقتل لما بقي","ت بغير معينٍ ولا ناصر",230,"ر",1,0],["وأيقنت الحقيقة أنّ دربي","بلا هدف وخاتمتي حسيرةْ",231,"ر",2,0],["وأيْقَظْتَ أشْذاء الصَّنَوْبر عَنْوةً","وَدَوْمًا بِعُذْر الشَّوْقِ أنْتَ تُبَرّرُ",232,"ر",1,0],["وأيَقَظَ رَوْعَةَ الأحْلام","مَدَّ لِجُرْفِها جزْرَهْ",233,"ر",2,0],["وإيقاع أشجان تعرّت غواية","تواعد أوهام الطقوس مطوّفةْ",234,"ف",2,0],["وأيقنتُ أنَّ الأمرَ لله عائدٌ","فكم من مليكٍ لزّهُ الضيم فأغتربْ",235,"ب",1,0],["وَأيْقَنتْ أنَّ حِبَّ الأَمْسِ هَاجِرُهَا","وَصَارِمٌ حَبْلَهَا يَوْمًا وَمُخْتَلِفُ",236,"ف",1,0],["وأيقنَ أنَّ في شكٍّ يقينًا","وأوشكَ أنْ ينازلهُ العِقابُ",237,"ب",1,0],["وآيقنت بآن الليل للدمع عنوان","وأن الغلابه مالهم بيت دونه",238,"ن",2,0],["وأيقنت القبائل من جنابٍ","وعامر أن سيمنعها نصير",239,"ر",1,0],["وأيقنتُ أنَّ الله إن شاء شيئةً","مضتْ وتأتَّتْ مِن قريبٍ ونائلِ",240,"ل",1,0],["وأيقنت ُ أنكَ في الكون ِ كلٌّ","فذاب بذاتكَ روحي وحسّي",241,"س",2,0],["وَأَيْقَنْتُ أنِّي لَسْتُ أَبْعَدَ تُهْمَةٍ","عَلَى فَرْضِ مَا نَحْيَا، وَحَالُ التَّضَارُبِ",242,"ب",1,0],["وأيقظتَ في لوح الوجود سوادها","تُيَمّمُ مشغوفاً ليورقَ موعدُ",243,"د",1,0],["وَأَيقَنتُ أَنّي إِذا جِئتُهُ","ذَليلاً لَجَأتُ لِحِرزٍ حَريز",244,"ز",1,0],["وأيقنوا بجلال الله، فانطلقوا","لا يبتغون إلى غير الهدى سببا",245,"ب",2,0],["وأيقنتُ أنا راحلون وأنني","وإن طال بي عمري سأصبحُ فانيا",246,"ي",2,0]]}