ين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[459,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[462,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[462,"يكل الركب عن ابلاغ شوقي","https://www.aldiwan.net/poem15438.html","الوافر"],[462,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[462,"ثبت الحبى لا يستفز أناته","https://www.aldiwan.net/poem16361.html","الكامل"],[465,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[465,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[466,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[469,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[480,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[480,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[494,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[496,"نظري لهذا العيش كيف مزاجه","https://www.aldiwan.net/poem9805.html","الكامل"],[506,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[530,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[530,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[539,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[539,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[552,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[559,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[559,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[559,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[559,"يا عقل كم منك قلة الأدب","https://www.aldiwan.net/poem34932.html","المنسرح"],[563,"في ساحة الحي من تيماء غزلان","https://www.aldiwan.net/poem52848.html","البسيط"],[563,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[568,"يا حبذا يومنا ونحن على","https://www.aldiwan.net/poem69548.html","المنسرح"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[576,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[587,"هل جابر جائر بالوصل لم يجد","https://www.aldiwan.net/poem17500.html","البسيط"],[587,"مثل الغزال نظرة ولفتة","https://www.aldiwan.net/poem17824.html","الرجز"]],"verses":[["في جِبالٍ مِنَ الغَمامِ كَأَنَّ ال","لَيلَ يَرمي رِعانَها بِرِعانِ",0,"ن",1,0],["في جَحفَلٍ كَشَحاءِ البَحرِ مَدَّ بِهِ","مُزَمجِرٌ يَضرِبُ العِرنينَ بِالجَفَلِ",1,"ل",1,0],["في جَبينِ الزَمانِ مِنكَ وَمِنّي","غُرَّةٌ كَوكَبيَّةُ الاِئتِلاقِ",2,"ق",1,0],["في جَحَفَلٍ قَعقَعَت حَوافِرُه","قَعاقِعَ الرَعدِ حادِياً قُزَعَه",3,"ع",2,0],["في جَحفَلٍ لَم تَزَل تَهدي أَوائِلَهُ","مَطالِعٌ مِن نِجادِ الأَرضِ تَنتَظِرُ",4,"ر",1,0],["في جَحْفَل لجبٍ تلاطَمَ موْجُهُ","وطَما بأثْباجِ الظُّبا زَخّارُهُ",5,"ر",2,0],["في جَنَّةِ الفِردَوسِ باتَ عَزيزُهُم","ضَيفاً بِساحَةِ أَكرَمِ الكُرَماءِ",6,"ا",2,0],["في جِوارِكُم الذَليلُ","وَحَدّي في رَجائِكُمُ الكَليلُ",7,"ل",1,1],["في جَوفِ لَحدٍ مُقيمٌ قَد تَضَمَّنَهُ","في رَمسِهِ مُقمَطِرّاتٌ وَأَحجارُ",8,"ر",1,0],["فِي جَنْبِ ذَاكَ الفَضْلِ أَقْلِلْ بِمَا","تُعَدِّدُ الأَقلامُ وَالأَلسِنَهْ",9,"ن",2,0],["فِي جُمَلٍ مُوجَزَةٍ جَزْلَةٍ","وَاضِحَةٍ نُرْسِلُهَا عَاجِلَهْ",10,"ل",2,0],["فَيجْتَمِعُ الجَوْهَرُ المُسْتَدَق","بِآخَرَ بَيْنَهُمَا آصِرَهْ",11,"ر",2,0],["فِي جِنَانٍ لَعَلَّهَا الصُّورَةُ الصُّغْ","رَى تَرَاءَتْ لِخَالِدَاتِ الجِنَانِ",12,"ن",1,0],["فِي جِدِّهِ وَمُزَاحِهِ مُتَصَرِّفٌ","بِبَرَاعَةٍ خَلاَّبَةٍ وَلِسَانِ",13,"ن",1,0],["فِي جِنَانِ الرِّضَى عَزَي","زٌ بِرَغْمِ المُنَى ظَعَنْ",14,"ن",1,0],["فِي جِيلِهِ كَانَ زَيْنَ مَنْ عَمِلوا","بِمَا أَفَادُوا وَزَيْنَ مَنْ عَلِمُوا",15,"م",3,0],["فِي جَمِيعِ الأُمُورِ جَدُّكَ مَوْفُورٌ","عَلَى قَدْرِهَا وَجِدُّكَ عَالِي",16,"ل",2,0],["في جمال عنه سلوا","والبدور لحسن تخضع",17,"ع",1,0],["في جانب منه تلقى الدرّ منتظماً","والدرّ منتثراً في الجانب الثاني",18,"ن",2,0],["فَيَجمَعُنا وَالغُرَّ أَبناءَ سارَةٍ","أَبٌ لا نُبالي بَعدَهُ مَن تَعَذَّرا",19,"ر",2,0],["في جِلهِمَ اللُؤمُ مَعلوماً مَعادِنهُ","وَفي حَويزَةَ خُبثُ الريحِ وَالأَدَرُ",20,"ر",1,0],["في جَنَّةِ الفِردَوسِ وَاِكتُبها لَنا","يا ذا الجَلالِ وَذا العُلا وَالسُؤدُدِ",21,"د",1,0],["في جامع الشام أركانٌ مصدرةٌ","تملي الثنا واردَ المعنى وصادِرِه",22,"ر",2,0],["في جمال الحبيب متُّ شجوناً","وبروحِي أفدِي تراب الجمال",23,"ل",1,0],["في جُلَّنار وأختها دُبْسيَّةٍ","يا ابن الوزير لعاتبٍ مُتعتَّبُ",24,"ب",1,1],["في جثةِ الفيلِ مَكْنياً بكنيتِهِ","ولا محالةَ أن الفيلَ مركوبُ",25,"ب",1,0],["في جَنَّةٍ هِيَ أَرواحُ الإِلَهِ فَما","يُفَزِّعُ الطَيرَ في أَغصانِها فَزَعُ",26,"ع",1,0],["في جُنحِ لَيلٍ مِثلِ حَظّي حالِكٍ","كَالبَحرِ ساجٍ مُقفِرٍ كَالفَدفَدِ",27,"د",1,0],["في جُنحِ لَيلٍ حالِكٍ فاحِمٍ","كَأَنَّ حَظِيَ قُدَّ مِن جِلدِهِ",28,"د",2,0],["في جَفنِهِ أَرَقٌ في نَفسِهِ فَرَقٌ","في جِسمِهِ سَقَمٌ في عَقلِهِ دَخَلُ",29,"ل",1,0],["في جوفِ اللَّيْلِ يُناجيهِ","وأَمامَ الفَجْرِ يُمَجِّدُهُ",30,"د",2,0],["في جسمهِ روحُ الحَيَاة النَّامي","وَشَجتْهُ موسيقى الوُجُودِ وعانقتْ",31,"ت",1,0],["في جبالِ الهمومِ أنْبتُّ أغصاني","فَرَفّتْ بَيْنَ الصُّخورِ بِجُهْدِ",32,"د",1,1],["في جوها الارواح من","افراحهن طائره",33,"ر",2,0],["في جنة كجنان الخلد مزهرة","كأن اشجارها حور وولدان",34,"ن",1,0],["في جنة غناء تحت نخيلها","قد نور الليمون والرمان",35,"ن",1,0],["في جسدي والرجاء يكبو","تنازع الموت والحياة",36,"ه",1,0],["في جوار الليل في ذمته","نذكر الصبح بأن لا يقربا",37,"ب",2,0],["في جُمعة مَشهودَةٍ هِيَ المُنى","هَشّ إِلَيها عَرَفاتُ وَمِنَى",38,"ن",2,0],["في جاهِ حُسنِكَ ذِلَّتي وَضَراعَتي","فَاِعطِف فَذاكَ بِجاهِ حُسنِكَ أَليَقُ",39,"ق",1,0],["في جَناحِ المَلَكِ الروحُ جَرى","وَبِريحٍ حَفَّها اللُطفُ رُخاء",40,"ا",2,0],["في جِسمِ أَروَعَ صافي العَقلِ تُضحِكُهُ","خَلائِقُ الناسِ إِضحاكَ الأَعاجيبِ",41,"ب",1,0],["في جَحفَلٍ سَتَرَ العُيونَ غُبارُهُ","فَكَأَنَّما يُبصِرنَ بِالآذانِ",42,"ن",1,0],["في جوفه مفتاحه ولبعضه","إصلاحه ولبعضه إهلاكُه",43,"ك",2,0],["في جوفها تقبر موتاهمُ","حيناً ومن باطنها تحشرُ",44,"ر",1,0],["في جِبالٍ ماجَ الحَديدُ عَلَيهِن","نَ ضُحىً مِثلَ ما تَموجُ البِحارُ",45,"ر",1,0],["في جِنانٍ حاكَ الخَريفُ لَها الوَش","يَ فَصارَت في الحُسنِ مِثلَ الجِنانِ",46,"ن",1,0],["في جَحفَلٍ لَجِبٍ كَأَنَّ زُهاءَهُ","شَرقِيُّ رُكنِ عَمايَتَينِ الأَرفَعُ",47,"ع",1,0],["في جَحفَلٍ لَجِبٍ كَأَنَّ شَعاعَهُ","جَبَلُ الطَراةِ مُضَعضَعُ الأَميالِ",48,"ل",1,0],["في جَحْفَلٍ غَصَّتِ الفِجاجُ بهِ","وأنَّ من وَطْئِهِ الثَّرى أَلَما",49,"م",2,0],["في جمرةِ الحَسَبِ التي لا تُصطَلى","وذُؤابَةِ الشَّرَفِ التي لا تُرتَقى",50,"ق",2,0],["في جَوْشَنٍ مُفَضَّضِ الأَثناءِ","قُدَّ لها من جَونَةِ الضَّحاءِ",51,"ا",2,0],["في جَنَّتي مُحَوَّلٍ","وَباسِقٍ وَالجَوسَقِ",52,"ق",1,0],["في جَنَّةِ الفِردوسِ كانَ مُقامُناً","وَبِمِثلِها في الحَشرِ يَنجَحُ فالي",53,"ل",2,0],["في جَنَّةٍ مِن رِياضِ الحَزنِ غالِيَةٍ","يُضاحِكُ الزَهرُ مِن نُوّارِها السُحُبا",54,"ب",2,0],["في جِنانٍ مِنَ الحَدائِقِ لا نَس","مَعُ فيها لَغواً وَلا تَأثيما",55,"م",2,0],["في جَنَّةٍ مِن طِباعٍ أَربَعٍ جُمِعَت","أَرضٍ وَماءٍ وَأَهواءٍ وَنيرانِ",56,"ن",1,0],["فيجيبُ الدمعُ والماضي الجريح","لِمَ عُدنا لَيت أنّا لَم نعُد",57,"د",1,0],["في جدث يزداد ضيقاً وضيق","في كفن ضمَّ الشباب الشهيد",58,"د",1,0],["في جَفافِ العُدْمِ حتى غرَفَتْ","من يديه في الغنى منه يدان",59,"ن",1,0],["في جنّةٍ غَنّاءَ فِرْدَوْسِيّةً","محفوفةٍ بالرَّوحِ والرّيحانِ",60,"ن",1,0],["في جحفلٍ ملأ الهواءَ خوافقاً","والسّمْعَ رِكْزاً والفَضاءَ رعالا",61,"ل",2,0],["في جَحفَلٍ كَالبحرِ ماج بضمَّرٍ","فتَكَتْ على صَهوَاتِها الأذْمارُ",62,"ر",1,0],["في جَحْفَلٍ يَغْشَى الوقائعَ زاحفاً","بسماءِ أجنحة وأرضِ حوافِرِ",63,"ر",1,0],["في جَحفَلٍ يَعلُو عَلَيهِ قَتَامُهُ","كَبُخارِ أخْضَرَ بالعَواصِفِ مُزْبِدِ",64,"د",1,0],["في جَوفِ قَبرٍ مُفردٍ مِن زائرٍ","قبرُ الغريب يُخَصّ بالإِفرادِ",65,"د",1,0],["في جهادٍ قَرَنَ اللَّه به","عنده الزّلفى إلى حُسْن المآب",66,"ب",1,0],["فِي جِيدِهَا مِنْ ضَفْرِهَا حَبَائِلُ","مِنَ الْقَوَادِيسِ لَهَا جَلاجِلُ",67,"ل",1,0],["في(جنَّة الخلد) طافت بي على الكبر","رؤيا شبابٍ وأحلام ٍ من الصِغَرِ",68,"ر",1,0],["فَيَجمَعُ بَينَ الماءِ أَبيَضَ سَلسَلاً","يَسُحُّ وَبَينَ الجَمرِ أَحمَرَ حامِيا",69,"ي",2,0],["في جامِحٍ مِن خُطوبِ الدَهرِ ذي حَرَدٍ","صَعبِ المَقادَةِ لا يُلقي بِأَرسانِ",70,"ن",1,0],["في جَوفِ مُصطَخِبٍ كَأَنَّ عُبابَهُ","صُوَرٌ لِعادي المَوتِ أَو أَشباحُ",71,"ح",1,0],["فَيُجِلُّ شاعِرَهُ وَيُكرمُ قَومَهُ","وَيُعَلِّمُ الشُعَراءَ كَيفَ تُجيدُ",72,"د",1,0],["في جلدهِ من رجزِ ربّكَ آيةٌ","عَجَبٌ تُفسَّرُ للبيبِ وتُشْرَحُ",73,"ح",1,0],["في جارفٍ كعجيج البحر ظاغيةَ","أمواجُهُ تحمل الأسواقَ امدادا",74,"د",2,0],["في جَوفِ أَكلَفَ قَد طالَ الوُقوفَ بِهِ","لا يَشتَكي الساقَ مِن أَينٍ وَلا تَعَبِ",75,"ب",1,0],["في جَحْفَلٍ هَتَمَ الثنايا وَقْعُه","كالبحر فهو غُطامِطٌ زَخّار",76,"ر",1,0],["في جِنانٍ خُضرٍ وَقَصرٍ مَشيدٍ","قَيصَرِيٍّ حَفَّت بِهِ الأَعنابُ",77,"ب",1,0],["في جُملة الرّاياتِ والعساكرِ","وفي رِجال الصَّبرِ والبَصائرِ",78,"ر",1,0],["في جنة غناء با","كرها سحاب ممطر",79,"ر",1,0],["في جوفها النيران تذكو وهي لا","تنفك حول الشمس عن دوران",80,"ن",1,0],["في جهاد الحياة قد كتب الفو","ز على الأرض للقوي النشيط",81,"ط",1,0],["في جنة غناء أَزهر دوحها","وانبثَّ يعبق نشرها الفياح",82,"ح",1,0],["في جبين النجمِ اللجينيِّ يُلقي","فِضَّةَ الضوءِ في مياهك ذوبا",83,"ب",2,0],["فيُجشَّم المنفى البعيدَ بصخرةٍ","في مائجٍ مُتَلَثّمٍ بخطارِهِ",84,"ر",2,0],["في جِبالِ التيرولِ إِن أَقبَلَ الصَي","فُ نَعيمٌ وَإِن مَضى زَمهَريرُ",85,"ر",1,0],["فِي جَنَّةٍ خَضْرَاءَ وَرْدُ خُدُودِهَا","زَاهٍ وَغَيْثُ مُدَامِهَا غَيْدَاقُ",86,"ق",1,0],["فِي جَاه أَوْرَاقهِ وَبَيْنَ حلَى","أَزْهَارِه مِن مُبَشِّرٍ وَندي",87,"د",2,0],["فِي جِنَانِ الْخُلْدِ عُقْبَى حُرَّةٍ","لَمْ تَمِنْ يَوْمَاً إِذَا الأَزْهَارُ مَانَتْ",88,"ت",1,0],["فِي جَنَّةِ اللهِ وَفِي نَعِيمِهِ","مُغْتَرِبَانِ عِنْدَهُ مَا اغْتَرَبا",89,"ب",2,0],["في جِدِّ