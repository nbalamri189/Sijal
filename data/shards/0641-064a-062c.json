n.net/poem44223.html","الكامل"],[102,"من كان ينكر نوحا أو سفينته","https://www.aldiwan.net/poem32961.html","البسيط"],[52,"يا من يفندني في اللهو والترب","https://www.aldiwan.net/poem27251.html","البسيط"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85429","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85759","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85636","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54759","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54655","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54852","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55121","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54930","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10172","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[45,"أقْصِرَا! ليس شأنيَ الإقْصَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=31344",""],[80,"أعليتَ بين النجم والدّبرانِ","https://www.poetsgate.com/ViewPoem.aspx?id=3771",""],[51,"في جُلَّنارَ وأختها دُبْسيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=27022",""],[92,"في جِبال لهمومِ، أننبتَّ أغصاني،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14569&r=&rc=14",""]],"verses":[["في جِبالٍ مِنَ الغَمامِ كَأَنَّ ال","لَيلَ يَرمي رِعانَها بِرِعانِ",0,"ن",1,0],["في جَحفَلٍ كَشَحاءِ البَحرِ مَدَّ بِهِ","مُزَمجِرٌ يَضرِبُ العِرنينَ بِالجَفَلِ",1,"ل",1,0],["في جَبينِ الزَمانِ مِنكَ وَمِنّي","غُرَّةٌ كَوكَبيَّةُ الاِئتِلاقِ",2,"ق",1,0],["في جَحَفَلٍ قَعقَعَت حَوافِرُه","قَعاقِعَ الرَعدِ حادِياً قُزَعَه",3,"ع",2,0],["في جَحفَلٍ لَم تَزَل تَهدي أَوائِلَهُ","مَطالِعٌ مِن نِجادِ الأَرضِ تَنتَظِرُ",4,"ر",1,0],["في جَحْفَل لجبٍ تلاطَمَ موْجُهُ","وطَما بأثْباجِ الظُّبا زَخّارُهُ",5,"ر",2,0],["في جَنَّةِ الفِردَوسِ باتَ عَزيزُهُم","ضَيفاً بِساحَةِ أَكرَمِ الكُرَماءِ",6,"ا",2,0],["في جِوارِكُم الذَليلُ","وَحَدّي في رَجائِكُمُ الكَليلُ",7,"ل",1,1],["في جَوفِ لَحدٍ مُقيمٌ قَد تَضَمَّنَهُ","في رَمسِهِ مُقمَطِرّاتٌ وَأَحجارُ",8,"ر",1,0],["فِي جَنْبِ ذَاكَ الفَضْلِ أَقْلِلْ بِمَا","تُعَدِّدُ الأَقلامُ وَالأَلسِنَهْ",9,"ن",2,0],["فِي جُمَلٍ مُوجَزَةٍ جَزْلَةٍ","وَاضِحَةٍ نُرْسِلُهَا عَاجِلَهْ",10,"ل",2,0],["فَيجْتَمِعُ الجَوْهَرُ المُسْتَدَق","بِآخَرَ بَيْنَهُمَا آصِرَهْ",11,"ر",2,0],["فِي جِنَانٍ لَعَلَّهَا الصُّورَةُ الصُّغْ","رَى تَرَاءَتْ لِخَالِدَاتِ الجِنَانِ",12,"ن",1,0],["فِي جِدِّهِ وَمُزَاحِهِ مُتَصَرِّفٌ","بِبَرَاعَةٍ خَلاَّبَةٍ وَلِسَانِ",13,"ن",1,0],["فِي جِنَانِ الرِّضَى عَزَي","زٌ بِرَغْمِ المُنَى ظَعَنْ",14,"ن",1,0],["فِي جِيلِهِ كَانَ زَيْنَ مَنْ عَمِلوا","بِمَا أَفَادُوا وَزَيْنَ مَنْ عَلِمُوا",15,"م",3,0],["فِي جَمِيعِ الأُمُورِ جَدُّكَ مَوْفُورٌ","عَلَى قَدْرِهَا وَجِدُّكَ عَالِي",16,"ي",1,0],["في جمال عنه سلوا","والبدور لحسن تخضع",17,"ع",1,0],["في جانب منه تلقى الدرّ منتظماً","والدرّ منتثراً في الجانب الثاني",18,"ن",2,0],["فَيَجمَعُنا وَالغُرَّ أَبناءَ سارَةٍ","أَبٌ لا نُبالي بَعدَهُ مَن تَعَذَّرا",19,"ر",2,0],["في جِلهِمَ اللُؤمُ مَعلوماً مَعادِنهُ","وَفي حَويزَةَ خُبثُ الريحِ وَالأَدَرُ",20,"ر",1,0],["في جَنَّةِ الفِردَوسِ وَاِكتُبها لَنا","يا ذا الجَلالِ وَذا العُلا وَالسُؤدُدِ",21,"د",1,0],["في جامع الشام أركانٌ مصدرةٌ","تملي الثنا واردَ المعنى وصادِرِه",22,"ر",2,0],["في جمال الحبيب متُّ شجوناً","وبروحِي أفدِي تراب الجمال",23,"ل",1,0],["في جُلَّنار وأختها دُبْسيَّةٍ","يا ابن الوزير لعاتبٍ مُتعتَّبُ",24,"ب",1,1],["في جثةِ الفيلِ مَكْنياً بكنيتِهِ","ولا محالةَ أن الفيلَ مركوبُ",25,"ب",1,0],["في جَنَّةٍ هِيَ أَرواحُ الإِلَهِ فَما","يُفَزِّعُ الطَيرَ في أَغصانِها فَزَعُ",26,"ع",1,0],["في جُنحِ لَيلٍ مِثلِ حَظّي حالِكٍ","كَالبَحرِ ساجٍ مُقفِرٍ كَالفَدفَدِ",27,"د",1,0],["في جُنحِ لَيلٍ حالِكٍ فاحِمٍ","كَأَنَّ حَظِيَ قُدَّ مِن جِلدِهِ",28,"د",2,0],["في جَفنِهِ أَرَقٌ في نَفسِهِ فَرَقٌ","في جِسمِهِ سَقَمٌ في عَقلِهِ دَخَلُ",29,"ل",1,0],["في جوفِ اللَّيْلِ يُناجيهِ","وأَمامَ الفَجْرِ يُمَجِّدُهُ",30,"د",2,0],["في جسمهِ روحُ الحَيَاة النَّامي","وَشَجتْهُ موسيقى الوُجُودِ وعانقتْ",31,"ت",1,0],["في جبالِ الهمومِ أنْبتُّ أغصاني","فَرَفّتْ بَيْنَ الصُّخورِ بِجُهْدِ",32,"د",1,1],["في جوها الارواح من","افراحهن طائره",33,"ر",2,0],["في جنة كجنان الخلد مزهرة","كأن اشجارها حور وولدان",34,"ن",1,0],["في جنة غناء تحت نخيلها","قد نور الليمون والرمان",35,"ن",1,0],["في جسدي والرجاء يكبو","تنازع الموت والحياة",36,"ه",1,0],["في جوار الليل في ذمته","نذكر الصبح بأن لا يقربا",37,"ب",2,0],["في جُمعة مَشهودَةٍ هِيَ المُنى","هَشّ إِلَيها عَرَفاتُ وَمِنَى",38,"ن",2,0],["في جاهِ حُسنِكَ ذِلَّتي وَضَراعَتي","فَاِعطِف فَذاكَ بِجاهِ حُسنِكَ أَليَقُ",39,"ق",1,0],["في جَناحِ المَلَكِ الروحُ جَرى","وَبِريحٍ حَفَّها اللُطفُ رُخاء",40,"ا",2,0],["في جِسمِ أَروَعَ صافي العَقلِ تُضحِكُهُ","خَلائِقُ الناسِ إِضحاكَ الأَعاجيبِ",41,"ب",1,0],["في جَحفَلٍ سَتَرَ العُيونَ غُبارُهُ","فَكَأَنَّما يُبصِرنَ بِالآذانِ",42,"ن",1,0],["في جوفه مفتاحه ولبعضه","إصلاحه ولبعضه إهلاكُه",43,"ك",2,0],["في جوفها تقبر موتاهمُ","حيناً ومن باطنها تحشرُ",44,"ر",1,0],["في جِبالٍ ماجَ الحَديدُ عَلَيهِن","نَ ضُحىً مِثلَ ما تَموجُ البِحارُ",45,"ر",1,0],["في جِنانٍ حاكَ الخَريفُ لَها الوَش","يَ فَصارَت في الحُسنِ مِثلَ الجِنانِ",46,"ن",1,0],["في جَحفَلٍ لَجِبٍ كَأَنَّ زُهاءَهُ","شَرقِيُّ رُكنِ عَمايَتَينِ الأَرفَعُ",47,"ع",1,0],["في جَحفَلٍ لَجِبٍ كَأَنَّ شَعاعَهُ","جَبَلُ الطَراةِ مُضَعضَعُ الأَميالِ",48,"ل",1,0],["في جَحْفَلٍ غَصَّتِ الفِجاجُ بهِ","وأنَّ من وَطْئِهِ الثَّرى أَلَما",49,"م",2,0],["في جمرةِ الحَسَبِ التي لا تُصطَلى","وذُؤابَةِ الشَّرَفِ التي لا تُرتَقى",50,"ق",2,0],["في جَوْشَنٍ مُفَضَّضِ الأَثناءِ","قُدَّ لها من جَونَةِ الضَّحاءِ",51,"ا",2,0],["في جَنَّتي مُحَوَّلٍ","وَباسِقٍ وَالجَوسَقِ",52,"ق",1,0],["في جَنَّةِ الفِردوسِ كانَ مُقامُناً","وَبِمِثلِها في الحَشرِ يَنجَحُ فالي",53,"ي",1,0],["في جَنَّةٍ مِن رِياضِ الحَزنِ غالِيَةٍ","يُضاحِكُ الزَهرُ مِن نُوّارِها السُحُبا",54,"ب",2,0],["في جِنانٍ مِنَ الحَدائِقِ لا نَس","مَعُ فيها لَغواً وَلا تَأثيما",55,"م",2,0],["في جَنَّةٍ مِن طِباعٍ أَربَعٍ جُمِعَت","أَرضٍ وَماءٍ وَأَهواءٍ وَنيرانِ",56,"ن",1,0],["فيجيبُ الدمعُ والماضي الجريح","لِمَ عُدنا لَيت أنّا لَم نعُد",57,"د",1,0],["في جدث يزداد ضيقاً وضيق","في كفن ضمَّ الشباب الشهيد",58,"د",1,0],["في جَفافِ العُدْمِ حتى غرَفَتْ","من يديه في الغنى منه يدان",59,"ن",1,0],["في جنّةٍ غَنّاءَ فِرْدَوْسِيّةً","محفوفةٍ بالرَّوحِ والرّيحانِ",60,"ن",1,0],["في جحفلٍ ملأ الهواءَ خوافقاً","والسّمْعَ رِكْزاً والفَضاءَ رعالا",61,"ل",2,0],["في جَحفَلٍ كَالبحرِ ماج بضمَّرٍ","فتَكَتْ على صَهوَاتِها الأذْمارُ",62,"ر",1,0],["في جَحْفَلٍ يَغْشَى الوقائعَ زاحفاً","بسماءِ أجنحة وأرضِ حوافِرِ",63,"ر",1,0],["في جَحفَلٍ يَعلُو عَلَيهِ قَتَامُهُ","كَبُخارِ أخْضَرَ بالعَواصِفِ مُزْبِدِ",64,"د",1,0],["في جَوفِ قَبرٍ مُفردٍ مِن زائرٍ","قبرُ الغريب يُخَصّ بالإِفرادِ",65,"د",1,0],["في جهادٍ قَرَنَ اللَّه به","عنده الزّلفى إلى حُسْن المآب",66,"ب",1,0],["فِي جِيدِهَا مِنْ ضَفْرِهَا حَبَائِلُ","مِنَ الْقَوَادِيسِ لَهَا جَلاجِلُ",67,"ل",1,0],["في(جنَّة الخلد) طافت بي على الكبر","رؤيا شبابٍ وأحلام ٍ من الصِغَرِ",68,"ر",1,0],["فَيَجمَعُ بَينَ الماءِ أَبيَضَ سَلسَلاً","يَسُحُّ وَبَينَ الجَمرِ أَحمَرَ حامِيا",69,"ي",2,0],["في جامِحٍ مِن خُطوبِ الدَهرِ ذي حَرَدٍ","صَعبِ المَقادَةِ لا يُلقي بِأَرسانِ",70,"ن",1,0],["في جَوفِ مُصطَخِبٍ كَأَنَّ عُبابَهُ","صُوَرٌ لِعادي المَوتِ أَو أَشباحُ",71,"ح",1,0],["فَيُجِلُّ شاعِرَهُ وَيُكرمُ قَومَهُ","وَيُعَلِّمُ الشُعَراءَ كَيفَ تُجيدُ",72,"د",1,0],["في جلدهِ من رجزِ ربّكَ آيةٌ","عَجَبٌ تُفسَّرُ للبيبِ وتُشْرَحُ",73,"ح",1,0],["في جارفٍ كعجيج البحر ظاغيةَ","أمواجُهُ تحمل الأسواقَ امدادا",74,"د",2,0],["في جَوفِ أَكلَفَ قَد طالَ الوُقوفَ بِهِ","لا يَشتَكي الساقَ مِن أَينٍ وَلا تَعَبِ",75,"ب",1,0],["في جَحْفَلٍ هَتَمَ الثنايا وَقْعُه","كالبحر فهو غُطامِطٌ زَخّار",76,"ر",1,0],["في جِنانٍ خُضرٍ وَقَصرٍ مَشيدٍ","قَيصَرِيٍّ حَفَّت بِهِ الأَعنابُ",77,"ب",1,0],["في جُملة الرّاياتِ والعساكرِ","وفي رِجال الصَّبرِ والبَصائرِ",78,"ر",1,0],["في جنة غناء با","كرها سحاب ممطر",79,"ر",1,0],["في جوفها النيران تذكو وهي لا","تنفك حول الشمس عن دوران",80,"ن",1,0],["في جهاد الحياة قد كتب الفو","ز على الأرض للقوي النشيط",81,"ط",1,0],["في جنة غناء أَزهر دوحها","وانبثَّ يعبق نشرها الفياح",82,"ح",1,0],["في جبين النجمِ اللجينيِّ يُلقي","فِضَّةَ الضوءِ في مياهك ذوبا",83,"ب",2,0],["فيُجشَّم المنفى البعيدَ بصخرةٍ","في مائجٍ مُتَلَثّمٍ بخطارِهِ",84,"ر",2,0],["في جِبالِ التيرولِ إِن أَقبَلَ الصَي","فُ نَعيمٌ وَإِن مَضى زَمهَريرُ",85,"ر",1,0],["فِي جَنَّةٍ خَضْرَاءَ وَرْدُ خُدُودِهَا","زَاهٍ وَغَيْثُ مُدَامِهَا غَيْدَاقُ",86,"ق",1,0],["فِي جَاه أَوْرَاقهِ وَبَيْنَ حلَى","أَزْهَارِه مِن مُبَشِّرٍ وَندي",87,"د",2,0],["فِي جِنَانِ الْخُلْدِ عُقْبَى حُرَّةٍ","لَمْ تَمِنْ يَوْمَاً إِذَا الأَزْهَارُ مَانَتْ",88,"ت",1,0],["فِي جَنَّةِ اللهِ وَفِي نَعِيمِهِ","مُغْتَرِبَانِ عِنْدَهُ مَا اغْتَرَبا",89,"ب",2,0],["في جِدِّهِ وَدِعَابَهَ","جِدُّ الْحَوَادِثِ وَالدِّعَابُ",90,"ب",1,0],["في جوَادٍ جَارَى أَبَاهُ وضما جَا","رَاهُ إِلاَّهُ بِالنَّدَى وَالسَّخَاءِ",91,"ا",2,0],["فِي جَلالِ العَطَاءِ مِنْهُ لِعَالِي","رَأْيِه فِي المُقَدَّمِينَ ظُهُورُ",92,"ر",1,0],["فِي جَلابِيبِ سُرُورٍ وَعَلَى","كُلِّ وَجْهٍ نَجْمُ سَعْدٍ سَفَرَا",93,"ر",2,0],["فِي جَانِبِ الرِّئْبَالِ قَدْ أَلْقَتْ يَداً","أَدْمَاءَ نَاعِمَةٍ عَلَى الرِّئْبَالِ",94,"ل",1,0],["فِي جِنَانٍ مُعَلَّقَاتٍ زَوَاهٍ","بِصُنُوفِ النُّجُومِ وَالأَنْوَارِ",95,"ر",1,0],["فِي جَنَّةٍ عَجَبٍ تَنَاغَى","الزَّهْرُ فِيهَا وَالأَزَاهِرْ",96,"ر",1,0],["فِي جَوِّهَا لِلرُّوحِ رَوْ","حٌ زَاغَ مَنْ سَمَّاهُ زُهْدَا",97,"د",2,0],["في جلاميد الصفا بالمعول","وإذا ما خندق الأعدا بداً",98,"د",2,0],["في جنبِ إيوانِ كسرى من مواهبهِ","إيوانُ شعرٍ به كسرى زها تيها",99,"ي",3,0],["في جَنَّةِ الخُلدِ عِندَ رَبّي","حَيثُ تَناهى بي التَرَقّي",100,"ي",1,0],["في جَرابٍ في جَوفِ تابوتِ موسى","وَالمَفاتيحُ عِندَ ميكائيلِ",101,"ل",1,0],["في جَبهة التاريخ منها أسْطُرٌ","كَتَبَ الإِباءُ حروفَها بسلاحِها",102,"ح",3,0],["في جِبَالٍ مَاجَ الحَدِيدُ عَلَيْ","هنَّ ضُحًى، مِثْل َمَا تَمُوجُ البحارُ",103,"ر",1,0],["في جنَّة ٍ غَنَّاءَ فِرْدَوْسِية","ٍ مخفوقة ٍ بالرَّوْح والرّيحان",104,"ن",1,0],["في جُلَّنارَ وأختها دُبْسيَّة ٍ","يا بن الوزير لعاتبٍ مُتعتَّبُ",105,"ب",1,1],["في جِبال لهمومِ، أننبتَّ أغصاني،","فَرَقّتْ بينَ الصُّخُورِ بِجُهْدِ",106,"د",1,1]]}