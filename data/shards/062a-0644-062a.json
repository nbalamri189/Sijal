bi.ae/diwan/poem/216795",""],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95375","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125868","الكامل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111118","الرمل"],[4815,"مياسة العود","https://www.poetsgate.com/ViewPoem.aspx?id=210424",""],[4931,"عجاج الظّروف","https://www.poetsgate.com/ViewPoem.aspx?id=31775",""],[5121,"مَرْضِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=71482",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5461,"إنتحار موجه","https://www.poetsgate.com/ViewPoem.aspx?id=5982",""],[5528,"عذرا رسول الله ! - صلى الله عليه وسلم -","https://www.poetsgate.com/ViewPoem.aspx?id=201136",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5628,"صورة مؤلمة","https://www.poetsgate.com/ViewPoem.aspx?id=178520",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5815,"تَكَهّفْ","https://www.poetsgate.com/ViewPoem.aspx?id=192613",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6056,"الصافنات المساريج","https://www.poetsgate.com/ViewPoem.aspx?id=130506",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6171,"غرفتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86323&r=&rc=6",""]],"verses":[["تلتفّ قامته بواردِ شعره","فأرى الشقا في جنَّةٍ ألفاف",0,"ف",1,0],["تلْتجُّ فيها نفخةٌ","للصور تَنخب ذا الجلدْ",1,"د",1,0],["تَلتَقي نَقائِضُهُ","غايَةً وَتَتَّحِدُ",2,"د",1,0],["تَلتَوي الخَيلُ عَلى راكِبِها","كَيفَ بِالعاصِفِ في يَومِ الجِماح",3,"ح",1,0],["تلتقي في مزاجِها","بالأعاصير والُحممْ",4,"م",1,0],["تَلَتهُ فَلَم تُبطِئ بِهِ مِن وَرائِهِ","مُعَقرَبَةٌ رَوحاءُ رَيِّثَةُ الفَترِ",5,"ر",1,0],["تَلتَهِبُ البيضُ عَلى أَبوابِها","وَغَمرَةٌ لِلمَوتِ تُتَّقى بِها",6,"ب",3,0],["تلتَفُّ خُرْصانُ العَوالي فوقَهُ","فكأنّما الآفاقُ منْهُ خَمائِل",7,"ل",1,0],["تَلتَهِبُ الكَفُّ مِن تَلَهُّبِها","وَتَحسُرُ العَينُ أَن تَقَصّاها",8,"ا",3,0],["تَلتَقي في الصَعيدِ أُمٌّ وَبِنتٌ","وَتَساوى القَرناءُ وَالجَمّاءُ",9,"م",3,0],["تَلَتِ النَصارى في الصَوامِعِ كُتبَها","وَيَهودُ تَقرَأُ بِالقِوى أَسفارَها",10,"ر",3,0],["تَلتَقِي فِيهَا صُرُوحٌ عَبَسَتْ","قَاتِمَاتٍ وَرُبىً تَبْسِمُ خُضْرا",11,"ر",2,0],["تلتحم الشكه في رعاله","فالجيش في بحر حديد قد طغى",12,"ا",1,0],["تَلَتْهُ فَلَمْ تُبْطِىء ْ بِهِ مِنْ وَرائهِ","معقربة ٌٌ روحاءُ ريِّثة الفتر",13,"ر",1,0],["تلتوي هذه كما التَبسَ الخَيْطُ","وتلتَفُّ تلكَ كالشُبّاك",14,"ك",1,0],["تلْتجُّ فيها نفحة ٌ للصور","ر تَنخب ذا الجلدْ",15,"د",1,0],["تلتف أشجاره وقد قصرت","من حوله كالجنود في الأسر",16,"ر",1,0],["تلتاح في الأفق المرقوب طالعُه","وما لها من سماء الفضل تأفيل",17,"ل",1,0],["تلتقى حوله الشفاه فما أشب","ه حال الأشواك بالزهرات",18,"ت",1,0],["تلتقى فيه الزغاري","د بجياش التهاني",19,"ن",2,0],["تَلَتهُ بِالتَرتيل مِن","أَحكامه وَالأَحرُفِ",20,"ف",1,0],["تلت وحي الإله فأولجته","مقرّاً ظاهراً ضمن التُلُوِّ",21,"و",1,0],["تلتزمون كَرَما ما تدّعِي","فيه العدا ويستحلُّ الظالمُ",22,"م",1,0],["تلتثم الحادثاتُ من خجلٍ","عنك إذا راع وجهُها السافرْ",23,"ر",1,0],["تلته سباع الطير والوحش فاغتدى","بطِرفٍ ومغوار وسِيدٍ وقشعم",24,"م",1,0],["تلْتقي منهُ شُجاعاً فَرِقاً","يرهَبُ العارَ ولا يخشى الخِطارا",25,"ر",2,0],["تَلتَفُّ حَولكَ هُيَّماً..وأ ُفيقُ كي","أجِدَ الغصونَ تَمُدُّهُنَّ الأضلُعُ!",26,"ع",1,0],["تلتف حوله من أجلافهم زمر","ما من فتى منهمو إلا وقد هرعا",27,"ع",2,0],["تلتوي خَصراً فأومي إلى","نغمةِ النّايِ ألا انتَحِبي",28,"ب",2,0],["تلتفُّ عند العناقِ قامتُه","من لِينِها كالْتفَافِ لَبْلاَبِ",29,"ب",1,0],["تلتفُّ قامتُها بالوشى إِن خطَرت","في حَلْيها فأَرى الجنَّاتِ أَلْفَافا",30,"ف",2,0],["تلتفُّ حولَ خصورها","أيدٍ كمحميّ الحديد",31,"د",1,0],["تلتفُّ حول سناهُ الا","أبصارُ تعشو وتُبهَر",32,"ر",1,0],["تلت رسالته حرَّى الجوانح لا","ترى إليه لتبدي شجوها سببا",33,"ب",2,0],["تَلٌّ تَحمّل نِملةً","أَم نِملَةٌ حَملَت كَثيبا",34,"ب",2,0],["تَلَتْ علينا ثناياها سُطورَ هوىً","لم نَنْسَها مُذْ وَعَيْناها وَعَيْناها",35,"ا",3,0],["تلتاح فيها كل رائقة الحلى","في ظل أعلامي وخفق بنودي",36,"د",2,0],["تلتهم المرو على شهوةٍ","أحبّ شيء عندها الجمرُ",37,"ر",1,0],["تلتفُّ حول فنائِه فيحاءُ قد","عبقت بسرِّ الوَردِ والرَّيحانِ",38,"ن",1,0],["تَلتَفُّ أَطرافُها وَالرِيحُ تَفتحُها","كَما تَفَتَّحَ مِن أَكمامِهِ الزَهَرُ",39,"ر",1,0],["تلتقيهم طلق المحيا ويغشى","كل عافٍ ندى يديك ربابا",40,"ب",2,0],["تلتقيه العيون من كل صوب","فتراه بنبلها مستهينا",41,"ن",2,0],["تَلَتكَ في خُلقِكَ السامي خَلائِقُهُ","تِلوَ المُصَلّي المُجَلّي في المَيادينِ",42,"ن",1,0],["تلتفّ له في الكشته أصحاب","تمشي لهم خد م أو حواضي",43,"ض",2,0],["تلتطمُ الأمواج فيه كماً","تأتي به الأنفاس في الذكر",44,"ر",1,0],["تلت هواتف مجلاه لوالده","آيات يمن لدى ميلاده علنا",45,"ن",2,0],["تلتذ بالنظر الذي فازت به","دون الجوارح هذه العينان",46,"ن",1,0],["تَلَتِ القُرآنَ غَضّا مُعرَبا","لَيسَ تَصحيفٌ وَلا لَحنٌ عَرا",47,"ر",2,0],["تلته وقد مرت تشم حروفه","فراحت به من فرط لذتها نشوى",48,"ا",1,0],["تِلْتِجي عَنْ قَلْب لِمَعْنَّى","اصْدِمَات الحب واتْراحَه",49,"ح",2,0],["تلتقيني بالسلام عداً","في ثياب من أصادقها",50,"ق",3,0],["تلت يَدا المَوتِ المُريعِ فَكَم لَنا","اقواس حَتفٍ كُل يَوم يوتَرُ",51,"ر",1,0],["تلتقي الأشباح فيها","والنفوس الشاردات",52,"ت",1,0],["تلتهُ منا سبعة الأطواف","والأمر في ذالك غير خافي",53,"ي",1,0],["تلتقي عندك الاماني ويغشي ال","نصر في ظل قصرك الامالا",54,"ل",2,0],["تَلْتَفُّ مِنْ حُلَل الرضا","في نُوْرِ باهرةِ السطوع",55,"ع",1,0],["تلتقي جيش العدى ضاحكة","والمواضي من دم طال بكاها",56,"ا",3,0],["تلتاعُ في قدِّكِ المياسِ أغنيتي","ويعزفُ العمرُ لحنَ الشوقِ والحقبُ",57,"ب",1,0],["تلتقي معْ ناطِحات الونّ والغمّ اللي باتي","وسط صدري من فقدتك يالغزاله ..يالهنوف",58,"ف",1,0],["تَلْتَفُّ بِالأَنْدَاءِ مِلْءَ رَبِيِعِهَا","وَتَلُفُّنَا فِي رِقَّةٍ عِطْرِيَّةْ",59,"ي",2,0],["تلت منهم الفرسان في الحرب مذ تلت","من الموت لما خط خطيها سطرا",60,"ر",2,0],["تلت كل وحيٍ أتى للرسول","وبالذكر مبدئة خاتمه",61,"م",2,0],["تلتذ بالماء الأجاج نفوسهم","وتعاف فيك البارد السلسالا",62,"ل",2,0],["تلتوي في ثوب أبيض ثم تطير...","في حضن شط تحبه تنتحر...",63,"ر",1,0],["تَلْتَاعُ سُنَّتُكَ الوَضِيئَةُ حَسْرَةً","بَيْنَ ابْتِدَاعٍ قَدْ تَجَلَّلَ مُسْعَدَا",64,"د",2,0],["تلتقي الأرضُ بالسماءِ لقاءً","لم تَر الأرضُ مثلَه من لقاءِ",65,"ا",2,0],["تلتم ّفي قلبهِ الحسّاس أخيلة ٌ","لعالمين أذيقا لوعة النَكَد ِ",66,"د",1,0],["تلْتَفُّ حَواليْهِ زُلْفى","وبِهِ لمَصالِحِها تهْفو",67,"ف",2,0],["تَلْتَاثُ مَعَاييرُ الرَّؤْيا","تَهْجرُها-أَرْضِيْ- أَمْطَاري",68,"ر",2,0],["تلتَقينَ الضِّياءَ في كُلِّ دربٍ","تحصُدينَ الآمالَ مثلَ الغِلَالِ",69,"ل",1,0],["تلت خفوقي ،، مثل تل الدراريج","لرشاء الدلو، والصوح جاله نثرها",70,"ر",3,0],["تَلتَفُّ بِصَدرِي زَوبَعَةً","وَ تَرُجُّ مُنايَ إِذا تَثِبُ",71,"ب",1,0],["تلتقي فيها ملايين الورى","وتبث العالم الأعلى اللهيبا",72,"ب",2,0]]}