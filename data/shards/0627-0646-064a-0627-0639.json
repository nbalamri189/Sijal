7",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[5956,"سرقوا دارة ابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=210650",""],[5956,"يا رب فك الغمة عن طحال ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=214668",""],[5956,"ودِّعْ بلاداً ذكْرهنّ عواطرُ","https://www.poetsgate.com/ViewPoem.aspx?id=215547",""],[5974,"لله هذا القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207119",""],[6068,"لم أدر ما قد حلّ في شاني -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175885",""],[4442,"أهوت به علته فانتدب","https://www.poetsgate.com/ViewPoem.aspx?id=171003",""],[6075,"أنت الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=214171",""],[6127,"أعيذك يا سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188188",""],[6152,"عزاء ومواساة","https://www.poetsgate.com/ViewPoem.aspx?id=204657",""],[6179,"أو قارِحٌ في الغُرَابِيَات ذُو نَسَبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7631&r=&rc=14",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""]],"verses":[["إِنّي أُعيذُكُمُ أَن تَطلُبوا بِدَمي","يا أَهلَ يَثرِبَ أَهلَ النُسكِ وَالرَشَدِ",0,"د",1,0],["إِني اِعتَذَرتُ إِلَيهِ مِن ذَنبٍ لَهُ","عِندي لِيُظهِرَ لي الرِضا فَأَبى",1,"ب",2,0],["إِنّي أُعَزّيكَ لا أَنّي عَلى طَمَعٍ","مِنَ الخُلودِ وَلَكِن سُنَّةُ الدينِ",2,"ن",1,1],["إِنّي أَعُدُّ ضُلوعَهُ","مِن تَحتِها وَاللَيلُ عاكِر",3,"ر",1,0],["إِنِّي أُعَانِي بِحِسِّ قَلْبِي","خَطْبَكُمُ الرْائِعَ الجُسَامَا",4,"م",2,0],["أَنّي أُعيذُكَ أَن تَنو","ءَ بِقَتلِهِ وَبِحمَلِ إِثمِهِ",5,"م",2,0],["إِنّي أَعوذُ بِحُسنِ عَف","وِ اللَهِ مِن سوءِ اِختِياري",6,"ر",2,0],["إنِّي أعيذُكَ أن تُوهِّم حاسداً","أن قد طرحتَ ثَنَاءَ حُرٍّ مَطْرَحَا",7,"ح",2,0],["إني أعوذ بيُمن جدَّك أن أُرى","بعد الدنوِّ رهينةَ الإِبعادِ",8,"د",1,0],["إني أعاف الخبيث يعلمه ال","لَه إذا ما الخبيث لم يُعَف",9,"ف",1,0],["إني أعوذ بما تأكد عقده","بيني وبينك أن تُضيع شقيقي",10,"ق",2,0],["إني أعيذك أن يقولوا كاتبٌ","ألِف الحسابَ فشأنه التحصيلُ",11,"ل",1,0],["إنّي أُعيذُكَ يا مُؤّمَّل دَهْرِه","من أنْ يراك المجدُ دافعَ مَغْرَمِ",12,"م",1,0],["إني أُعِيذُك أنْ يرا","كَ المجدُ تكْرُمُ ثم تَلْؤُمْ",13,"م",1,0],["إني أعوذ بعدلك ابنَ محمدٍ","منه وأنت على الظَّلوم مُعين",14,"ن",1,0],["إني أعيذك أن يراك مليكنا","ترضَى خيانتَهم وأنت أمين",14,"ن",1,0],["إِنّي أُعيذُكِ أَن تُرى جَبّارَةً","كَالبابَوِيَّةِ في يَدَي رُدريكِ",15,"ك",1,0],["إِنّي أُعيذُكَ أَن تَزهو عَلى دَنِفٍ","حَيرانَ قَد صارَ بَينَ البابِ وَالدارِ",16,"ر",1,0],["إِنّي أَعُدُّكُمُ رَهطي وَأَجعَلُكُم","أَحَقَّ بِالصَونِ مِن عِرضي وَمِن ديني",17,"ن",2,0],["إِنّي أُعيذُكَ أَن يَغُر","رَكَ زَهرُها وَبَريقُها",18,"ق",3,0],["إِنّي أُعيذُكَ أَن يَمي","لَ بِكَ الهَوى فيمَن يَميلُ",19,"ل",1,0],["إِنّي أَعوذُ مِنَ الَّتي شَعَفَت","مِنّي الفُؤادَ بِآيَةِ الكُرسي",20,"ي",1,1],["إِنّي اِعتَصَمتُ بِطولِ طَودِكَ إِنَّهُ","طَودٌ يَقومُ مَقامَ طَودِ حَديدِ",21,"د",1,0],["إِنّي أَعوذُ بِمَنصِبي وَمُروءَتي","مِن أَن أَكونَ الشاعِرَ الضَلِّيلا",22,"ل",2,0],["إِني أَعوذُ بِمَن حَجَّ الحَجيجُ لَهُ","وَالرافِعُونَ لِدينِ اللَهِ أَركانا",23,"ن",2,0],["إِنّي اِعتَمَدتُكَ يا يَزي","دُ وَنِعمَ مُعتَمَدُ الوَسائِل",24,"ل",1,0],["إِنّي أَعُدُّكَ مَعقِلاً ما مِثلُهُ","كَهفٌ وَلا جَبَلٌ مِنَ الأَجبالِ",25,"ل",1,0],["إِني أُعِيذ وَفَاءً تَجْهَرُونَ بِهِ","كَمَا أُعِيذُ أُلِي الرَّأْي الأَمَاجِيدَا",26,"د",2,0],["إنِّي أعيذُك باسم ربَّ الْ","عَرش من عين الحسود",27,"د",1,0],["إني أعيذُ عُرا المود","ةَ بيننا أن تُفصما",28,"م",2,0],["إني أعيذ الشرق من متَمسِّح","بالأجنبِّي، لقومه هدَّام!",29,"م",1,0],["إني أعيذُ صفوفَكم","من كلِّ خُلْفٍ أو تلاح",30,"ح",1,0],["إني أعيذك من ظلمي وأنت فتىً","يحميه أن يفعل الأسواء وجدان",31,"ن",1,0],["إني أعيذك من بذيء شماتة","بهرائها يتبجح المأفون",32,"ن",1,0],["إِنِّي أُعِيذُكَ بالَّذي خَلَقَ الهَوى","والعاشِقينَ تَمَلُّكَ الأَحْرارِ",33,"ر",1,0],["إني أعيذ علاك يا برقوق","ممن يقول الخالق المخلوق",34,"ق",1,1],["إني أَعاف الذلَّ فيما أبتِغى","فلِهمَّتِى عن جانبيهِ نُشوز",35,"ز",1,0],["إني اعتللت فلم أجد لي عائدا","من بين معرفة ولا لوّاذ",36,"ذ",1,1],["إني أعوذ بكأسها","من كل شيطان رجيم",37,"م",1,0],["إني أعود بحسنها وبقلبها","وبروحها من كل واشٍ مفسدِ",38,"د",1,0],["إني أُعاتب إخواني وهم ثقتي","طوراً وقد تُصقَل الأسياف أحيانا",39,"ن",2,0],["إِنّي أُعيذُكَ مِن مَلامٍ لَم يَكُن","لَكَ شيمَةٌ مُنذُ الزَمانِ الأَوَّلِ",40,"ل",1,0],["إِنّي أُعيذُكَ أَن تَحُلَّ لِشاعِرٍ","يَوماً لِساناً أَو تَسُدَّ لَهُ فَما",41,"م",2,0],["إني أُعيذكَ من صدٍّ ومن صَلَفٍ","حاشاكَ أن لا تراعي الودَّ حاشاكا",42,"ك",2,0],["إني أعيذك أن تلقى الدنا عوضاً","عن الدنو وترضى البخس للغالي",43,"ل",2,1],["إنّي أَعُوذُ بِداودٍ وتُربَتِهِ","مِن أن أَحُجَّ بِكُرهٍ يا ابنَ دَاودِ",44,"د",1,0],["إنّي أَعُوذُ بِرَوحٍ أن يُقَدّمَنِي","إلى البِرازِ فَتَخزَى بي بَنُو أَسَدِ",45,"د",1,1],["اني أَعد كما لدفع مكاره","الدنيا والاخرى حيث كنت وَكنتما",46,"م",2,0],["إِنِّي أَعُوذُ بِعَطْفٍ مِنْكَ أَعْرِفُهُ","ما زالَ يَقْتُلُ أَعْدائِي وَيُحْيِينِي",47,"ن",2,0],["إِنّي أَعوذُ بِما عاذَ النَبِيُّ بِهِ","وَبِالخَليفَةِ أَن لا تُبَلُ العُذُرُ",48,"ر",1,0],["إنّي اعتَزَلتُ فَلاَ تَلُوموا إِنَّهُ","أضحَى يُقَابِلُني بِوَجهٍ أشعَرِي",49,"ي",1,0],["إِنّي أَعوذُ بِخَيرِ الناسِ كُلِّهِمِ","وَأَنتَ ذاكَ بِما نَأتي وَنَجتَنِبُ",50,"ب",1,0],["إِنّي أُعِدُّ لِأَقوامٍ أُفاخِرُهُم","إِذا تُنوزِعَ عِندَ المَشهَدِ القيلُ",51,"ل",1,0],["إِنِّي اِعتَصَمتُ بِمَن وَقاني شَرَّها","فَإِنِ اِبتَغاها ما لَها مِن واقِ",52,"ق",1,0],["إنّي أُعبّر بالنّقا عَن غيرِهِ","وأقول شامٌ والمرادُ عراق",53,"ق",1,0],["إني أعدك عُدّة","وأراك فخراً للرجال",54,"ل",1,0],["إني أعدُّ أحبتي","من فضة وأراك تبرا",55,"ر",2,0],["إنِّي أُعَزِّيكَ بخالٍ قد خلا","وما خلا منه اللِّسان المادح",56,"ح",1,0],["أنَّى أعدُّ وإن رقمت محاسناً","كنهاية الأَعداد والأَرقام",57,"م",1,0],["إِني أعزيكما فيه ولي مقل","أخشى عليها لوقع الأدمع العورا",58,"ر",2,0],["إني أعزيكم وكندة كلها","وأنا الشريك لكم أسى وجزوعا",59,"ع",2,0],["إني أعزي العلا والمجد فيك ولا","نفسي أعزي وعبء الحلم والنفل",60,"ل",1,0],["إني أعزيك يا عبد السلام وفي","قلبي أسى جدد التأسيف والحزنا",61,"ن",2,0],["إني أعيذ من الجفا","والغدر يا مولاي ودك",62,"ك",1,0],["إِنِّي اُعِيْذُكِ أَنْ يُكَدِّرَ آخِرٌ","بِمَقَالَةِ الوَاشِيْنَ صَفْوَ الأَوَّلِ",63,"ل",1,0],["إني أعارضه في قوله وأرى","إن الكتاب يفوق البيض واليلبا",64,"ب",2,0],["إني أعود إليه خاشعا وجلا","فإنه في فؤادي أوقع الرهبا",64,"ب",2,0],["إنّي أعيذك أن تنال بك التي","تطغى العلوج بها على عدنانِ",65,"ن",1,0],["أني أعيذك فيما قد أعيذ به","قدماً سميك من سقم ومن نكد",66,"د",1,0],["إني أُعيذكِ خِيفةَ العَينِ الَّتي","تَخْشَيْنَ بالمَسْطُور في ياسِينِ",67,"ن",1,0],["إني أعوذ بيسره من عسرتي","وجواره من أن أضام وأخسفا",68,"ف",2,0],["إني أعلل نفسي بانتظار غدٍ","مستبقياً لغدٍ بعض الحشاشات",69,"ت",1,0],["إِنِّي أُعيذُكَ أن تُح","رِّضه فتتركني حَرَض",70,"ض",1,0],["إني أعوذ بخالق الأشياء مِنْ","شرِّ الأبالسةِ الخباث المأكلِ",71,"ل",1,0],["إنِّي أعَوّذُهُ بطَهَ والضحى","والشمس والإسرا وفاطرَ والزُّمر",72,"ر",1,0],["إني أعيذك أن تقسو علىّ وما","في الحب ذنب ولا في الشعر في باس",73,"س",1,0],["إني اعتصمت بحبل آل محمد","في الدين والدنيا بشاهنشاه",74,"ه",1,0],["إني أعاتبهم على ما قد جنوا","لو كان يعطفهم عليّ عتابي",75,"ب",2,0],["إني اعتمدتُ أمامَ الناس إذ ذهبت","إبلي وخيلي وخفت الجوعَ والحربا",76,"ب",2,0],["إنِّي أُعزِّيكَ عن عزيزٍ","كانَ لريبِ الزمانِ عُذْرا",77,"ر",2,0],["إني أُعيذك بالرَّحمن من حالي","لما دنا عنك بالمقدور ترحالي",78,"ل",2,1],["إني أُعيذُكِ بالرحمنِ ميمونا","من شرِّ ما ليس يا ميمونَ مأمونا",79,"ن",2,1],["اني اعيذك من سماع كلامهِ","او الاقتناع بما يقول ويتهمُ",80,"م",1,0],["إني أعزيكَ لا أني على ثِقَةٍ","منَ البَقاءِ ولكنِ سُنَّةُ الدِّينِ",81,"ن",1,1],["أَنّي أَعوذُ بِقَبرِ كَرَزٍ أَن أَرى","تَبَعاً لِعَبدٍ مِن تَميمٍ مُحقَبِ",82,"ب",1,0],["إِني أَعاف غِنى يَجرّ مَذَلَةً","وَأَحب فَقراً جالبَ العَلياء",83,"ا",2,0],["إني اعتمدت عليه في تصرفنا","ما كان من خلقي فيه ومن عملي",84,"ل",2,0],["إني أعوذُ بقبْرٍ لسْتَ مُخْفِرَه","ولا أعوذُ بقبْرٍ بعد مَرْوانا",85,"ن",2,1],["إني أعيذك ( زايد) مستنهضاً","قومي لها من كبوة الخذلان",86,"ن",1,0],["إِنى أعزّيكم وأعلم إِننى","أحتاج فيه الى معزٍ ثان",87,"ن",1,0],["إني اعتقلت بحصن المصطفى وكفى","بالمصطفى وزرا لمن به اعتقلا",88,"ل",2,0],["إِني أَعوذُ بما حَوَيْتَ م