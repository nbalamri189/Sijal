4567",""],[6089,"في شفتي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213031",""],[242,"قسما بمن بالصد قد اضناني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563813",""],[5957,"رفقا بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82586&r=&rc=128",""]],"verses":[["مِن كُلِّ قافِيَةٍ إِذا أَطلَقتُها","عَطَفَت عِنانَ الراكِبِ المُستَعجِلِ",0,"ل",1,0],["مِن كُلِّ قافِيَةٍ تَخُبُّ إِلَيكُمُ","بِشَواظِها خَبَبَ الجَوادِ المُفلِتِ",1,"ت",1,0],["مِن كُلِّ قافٍ كَأَنَّ اللَهَ صَوَّرَها","مِن مارِجِ النارِ تَصويرَ الشَياطينِ",2,"ن",1,0],["مِن كُلِّ قافِيَةٍ تَحتَلُّ ثاوِيَةً","في صَدرِ رِوايَةٍ أَو كَفِّ وَرّاقِ",3,"ق",1,1],["من كلِّ قافيةٍ لفاغرِها فمٌ","عذبٌ إذا ما ذقته قلت ازدد",4,"د",1,0],["من كلِّ قافيةٍ تقومُ لكلِّ ذي","ديوان نظمٍ قبلنا بمجلد",5,"د",1,0],["من كل قاتلةٍ قتْلى وآسرةٍ","أسْرى وليس لها في الأرضِ إثخان",6,"ن",1,0],["مِن كُلِّ قاضِيَّةٍ بِالمَوتِ شَفرَتُهُ","ما بَينَ مُنتَقَمٍ مِنهُ وَمُنتَقِمِ",7,"م",1,0],["مِن كُلِّ قَرمٍ يَرى الإِقدامَ مَأدُبَةً","إِذا خَدا مُعلِماً بِالسَيفِ أَو وَسَجا",8,"ج",2,0],["مِن كُلِّ قافِيَةٍ فيها إِذا اِجتُنِيَت","مِن كُلِّ ما يَجتَنيهِ المُدنَفُ الوَصِبُ",9,"ب",1,0],["مِنْ كُلِّ قَافِيَةٍ فِي الأَرْضِ سَائِرَةٍ","لَهَا بِعِرْضِكَ إِنْجَادٌ وَإِتْهَامُ",10,"م",1,0],["مِن كُلِّ قانِيَةٍ تَسيلُ كَأَنَّها","شُهُبٌ تَصَوَّبُ مِن فُروجِ سَماءِ",11,"ا",2,0],["مِن كُلِّ قاصِرَةِ الخُطى مُختالَةٍ","مَشيَ الفَتاةِ تَجُرُّ فَضلَ إِزارِ",12,"ر",1,0],["مِن كلِّ قَوّامٍ على أثقالِه","سامٍ له ظهرٌ أشمُّ وكَلْكَلُ",13,"ل",1,0],["مِن كُلِّ قَولٍ لَهُ فَصلٍ يُصيبُ بِهِ","وَكُلِّ فِعلٍ لَهُ بِالعَدلِ ميزانُ",14,"ن",1,0],["منْ كلَّ قُطْرٍ بالعُرو","بَة ذي ازدهارٍ وازدهاءِ",15,"ا",2,0],["من كل قرم شامخ أنفه","إن سامه العلج هواناً أبى",16,"ب",2,0],["من كل قَرْمٍ جُيوشيِّ النِّجارِ غدا","في كعبةِ الفخرِ مثل الرُّكْنِ والحَجَر",17,"ر",1,0],["من كل قافيةٍ ذلتْ صعوبتُها","لخاطرِي وهْي بالألبابِ مِشْماس",18,"س",1,0],["من كل قباءِ الحَشَا والخَصْر","تكاد من تلويحها والضُمْر",19,"ر",1,0],["مِن كُلِّ قيلٍ يُقيلُ زَلَّةَ عا","ثِرٍ وَقَرمٍ إِلى النَدى قَرِمِ",20,"م",1,0],["مِنْ كُلِّ قَرْمٍ بَاسِلٍ يَوْمَ الْوَغَى","بَادِي السُّرُورِ إِذَا الْتَقَى الْجَمْعَانِ",21,"ن",1,0],["من كلِّ قافيةٍ تَنقَضُّ صاعقةٌ","على الذين استحلّوا حُرمةَ العرب",22,"ب",1,0],["مِن كُلِّ قَنعاسٍ نَماهُ شَدقَمٌ","وشِمِلَّةٍ تَحتَ السَرابِ رقوصِ",23,"ص",1,0],["من كُلِّ قافيَةٍ مهذَّبَةٍ","خلَصَت خلوصَ سبيكة التَبرِ",24,"ر",1,0],["مِن كُلِّ قِرنٍ عَن الفَحشاء مُبتعدٍ","وَكُلِّ قرمٍ إِلى الهيجاءِ مقتربِ",25,"ب",1,0],["مِن كُلِّ قافِيَةٍ تَظَل","لُ كَأَنَّها لِلعِرضِ لامَه",26,"م",2,0],["من كل قول يحرم أو فضول الكلام","إن اللسان هو المهلك لهذا الأنام",27,"م",1,0],["من كلِّ قافية بثاقب فكره","يفتضُّها عَذْرَا بغير صداق",28,"ق",1,0],["من كلِّ قافيةٍ ترو","قُ مطالِعاً وتَروعُ طالِب",29,"ب",1,0],["من كلّ قافيةٍ تحطّ قباعَها","فيرُدُّ وجهَ قَفاً وقائلَهُ قَفا",30,"ف",2,0],["من كُلِّ قَرْمٍ غَدا بالمجدِ مُشْتَمِلاً","ومُسْتَقِلّاً بتاجِ المُلْكِ مُعْتَصِبا",31,"ب",2,0],["من كل قافية بالحب مفعمة","عصماء ما شابها زيف ولا كذب",32,"ب",1,0],["من كلّ قلبٍ قسا والرقّ يخصمه","حتى يرقَّ ونعماكم تنازعُهُ",33,"ع",2,0],["مِن كلِّ قافيةٍ إذا غضغضتَها","عُبَّ الكلامُ كما تُعَبُّ الأبحرُ",34,"ر",1,0],["مِن كلَّ قافيةٍ إذا أنشدتٌها","فَغَمتْ بنشرٍ كالعبيرِ مَدوفِ",35,"ف",1,0],["مِن كلِّ قافيةٍ أمستْ منزَّهةً","عن أن تصاحبَ لا عيّا ولا لَكَنا",36,"ن",2,0],["مِن كلَّ قافيةٍ بعيدٍ أن يُرى","يومَ الرَّهانِ لشأوهنَّ غبارُ",37,"ر",1,0],["مِن كلَّ قافيةٍ ترى في طيَّها","ما شئتَ مِن حِكَمٍ ومِن أمثالِ",38,"ل",1,0],["من كل قلب لو تشا لك منزل","وسكنت هذا القبر هلا تعدل",39,"ل",1,1],["من كلِّ قَرْمٍ هاشميٍّ قَلْبُهُ","عن كلِّ خَلقٍ في البَرايا عَزَفَا",40,"ف",2,0],["من كلِّ قَرْمٍ هِزَبْرٍ خاشعٍ ولِهٍ","لهُ مع اللَّيلِ ألحانٌ وتَغريد",41,"د",1,0],["من كلِّ قَرْمٍ يشفي إذا شهد ال","حومةَ بالبِيض والقنا القَرَما",42,"م",2,0],["من كلِّ قَرْمٍ لا يريد ضجيعَه","إِلّا سِناناً أو حساماً مُنتضى",43,"ض",2,0],["من كلِّ قافيةٍ مُرَقِّصَةٍ","يشدو بها الغِرّيدُ إنْ يشدُو",44,"د",2,0],["من كلِّ قافيةٍ شَرُودٍ بيتُها","ضُربَتْ لهُ الأوتادُ بينَ ترائبِ",45,"ب",1,0],["من كل قافيةٍ كزَهْر حديقةٍ","في كلِّ مَعْنىً كالنسيمِ لطيفِ",46,"ف",1,0],["مِن كُلّ قامِحَة يُغَيِّبُ بَطنُها","ظماً إلى العَطَنِ الرِّحيبِ وَجُوعا",47,"ع",2,0],["من كل قافيةٍ كأبكار الدُمَى","ترنو إليَّ بناظرٍ مكحولِ",48,"ل",1,0],["من كلّ قافَيةٍ بَدَت","كالزهر في الروضِ المُطير",49,"ر",1,0],["من كلِّ قافيةٍ نراها سُكَّراً","فإذا سمعناها نراها تُسكِرُ",50,"ر",1,0],["من كل قوم طاعن أو ضارب","بالسمهري وبالحس أم الأقطع",51,"ع",1,0],["مِنْ كُلّ قَوْسِ إنْ تُسَمِّهِ نِسْبَةً","لِبَنِي هِلاَلٍ قَالَ يَالَهِلاَلِ",52,"ل",1,0],["مِن كُل قاعِدَة عَلى دمث","رابى المَجس كَلابد الرمل",53,"ل",1,0],["من كل قافيةٍ طاحَ الشُّرودُ بها","تجيءُ وَفقَ مُرادي وهي مِذْعانُ",54,"ن",1,0],["من كل قصر يراه الطرف أرفع من","رضوى وأبدع في التصوير من وثن",55,"ن",1,0],["مِن كُلِّ قَلبٍ تَسمَعُ اليَومَ الدُّعا","عاشَ المَليكُ فُؤادُ يَحمي المَربَعا",56,"ع",2,1],["من كل قافية تثير كوامنا","في النفس عند الشيب والشبان",57,"ن",1,0],["مِن كُلِّ قَراوَءَ مَعقودٍ فَقارَتُها","عَلى مُنيفٍ كُرُكنِ الطَودِ وَالضَفَرِ",58,"ر",1,0],["مِن كلّ قاصية وَدانيَة","جاؤوا كَموجِ البحر يَلتَطِمُ",59,"م",1,0],["من كل قطرٍ رادَها الوُرَّادُ","فانشدهوا وقالوا اين هم أَكفاؤُها",60,"ا",3,0],["مِن كُلِّ قافِيَةٍ إِذا أَورَدتها","صَدَرَت بِلُبِّ الأَروَعِ القنعاسِ",61,"س",1,0],["من كل قاع جؤذر","تلقاه أو ظبي غرير",62,"ر",1,0],["مِن كُلِّ قَرمٍ وَمِن كُلِّ شَهمٍ","أَغَرَّ زاهي الجَبين زاهِر",63,"ر",1,0],["مِن كُلِّ قافِيَةٍ إِذا ما أُنشِدَت","تَرَكت جَريراً في العَديدِ الآخِرِ",64,"ر",1,0],["مِن كُلِّ قَيلٍ في السَّفائِنِ نَعجَةٌ","سَوداءُ تُرضِعُ خَيرَ جَدي أَسوَدا",65,"ا",1,0],["من كل قافيةٍ لعوبٍ بالنُهى","جاز الفُراتَ حديثُها والنيلا",66,"ل",2,0],["من كل قافيةٍ بالحسن حاليةٍ","يظلُّ سامعُها كالشاربِ الثَملِ",67,"ل",1,0],["من كل قواداء ترمى عن مناسمها","صم الحصى من وجيف الوخد والرمل",68,"ل",1,0],["من كل قُطْرٍ جاءهم","مددٌ ولا حُسْبانا",69,"ن",2,0],["من كل قرم كأن الشمس غرته","لو لم يحل بها خسف ولم تغب",70,"ب",1,0],["من كل قارعةٍ يطلُ مواكبًا","خضراء صوب النصر تصعد مسرعة",71,"ع",2,0],["من كل قرم مطمئن جأشه","ما راعه هول من الأهوال",72,"ل",1,0],["من كل قارب صيد","من كل عتبه دار",73,"ر",1,0],["مِن كلِّ قافيةٍ للعقلِ ساحرةٍ","نفثتُ في عُقَدٍ مِن سِحرها عُقَدا",74,"د",2,0],["مِن كُلّ قافية ٍ تضجّ ببابهِ","عند \\\" العليِّ \\\" تنفّستْ أهواها",75,"ا",3,1],["من كل قافية تلوّح نخلةٌ","بالحب يجذب قلب مريم تمرها",76,"ر",3,0],["مِن كُلِّ قَرمٍ باسِلٍ يَومَ الوَغى","بادي الشُرورِ إِذا التَقى الجَمعانِ",77,"ن",1,0],["من كل قافية ودانية","ليزول عن أهدابها التعبُ",78,"ب",1,0]]}