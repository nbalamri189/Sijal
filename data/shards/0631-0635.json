{"poems":[[93,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[91,"هيهات بعدك ما يفيد تصبر","https://www.aldiwan.net/poem8822.html","عموديه"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[33,"قمر نم عليه نوره","https://www.aldiwan.net/poem25868.html","الرمل"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[113,"ما للقلوب من العيون امان","https://www.aldiwan.net/poem40440.html","عموديه"],[180,"رعى الله مغنى بالعذيب ومعهدا","https://www.aldiwan.net/poem67081.html","الطويل"],[183,"ووردة يقصر عنها الوصف","https://www.aldiwan.net/poem14753.html","الرجز"],[259,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[303,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[303,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[362,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[397,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[403,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[441,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[441,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[441,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[447,"هو الدين","https://www.aldiwan.net/poem977.html",""],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[498,"قلوب الأولياء لها سيوف","https://www.aldiwan.net/poem37953.html","الوافر"],[513,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"]],"verses":[["رَصَانَةٌ وَذَكَاءٌ وَانْبِسَاطْ يَدٍ","أَكْرِمْ بِهَا يَدَ سَمْحٍ غَيْرِ مَنَّانِ",0,"ن",1,0],["رصّعُ متناه بالدراري","فراق في الحسن والرواء",1,"ا",2,0],["رَصَدَ الرَدى أَرواحَنا حَتّى لَقَد","كِدنا نُعَزّي المَرءَ قَبلُ يُصَوِّرُ",2,"ر",1,0],["رَصَدَ السَبيلَ فَما تَمُرُّ بِهِ","قَدَم وَلا النَسَماتُ إِذ تَسري",3,"ر",2,0],["رصفته ملائك","باليواقيت والدرر",4,"ر",1,0],["رصاص لا يغيض ولا يغيب","بعيد في مقاصده قريب",5,"ب",1,0],["رَصَدَ الخَلوَةَ حَتّى أَمكَنَت","وَرَعى الساهِرَ حَتّى هَجَعا",6,"ع",2,0],["رَصِّعوا التاجَ بِالوَفاءِ وَحَلُّوا","بِحِلى الصِدقِ عِزَّهُ وَالجَلالا",7,"ل",2,0],["رصدوا النجوم، ورحت أرصد شيخها","شيخَ النجوم الزُّهْر، علَّك مرشدي!",8,"د",2,0],["رصاص البَغي يفجُرُكم ليجري","دمٌ يَزْكو به الوطنُ ازدِراعا",9,"ع",2,0],["رصعته بنبال طرفك فانبرى","مضنى وفي احشائه نيران",10,"ن",1,0],["رَصانة خُلقٍ كَالجِبالِ تَوَقَرَتْ","فَلو خالَطَتْ بَحراً لَما جاشَ مُزبِدا",11,"د",2,0],["رُصَّتْ بها قَطائفٌ لا تجفو","محكمَةٌ من فوق صفٍّ صفُّ",12,"ف",1,0],["رصدوا الأنجم الطوالع والأفلاك","واللَه غالب مرصاده",13,"د",2,0],["رُصّعت لَكن بياقوتِ الزَهَر","وَحَصى درٍّ بِها مُكتَنِفين",14,"ن",1,0],["رصد إذا غضب السلاح تذمروا","حتى يعود إلى السلاح رضاءُ",15,"ا",2,0],["رَصّعْتَ تاجَ عُلاكَ منه بدرَّةٍ","أعْيَتْ على هِمَم المُلوكِ الصِّيد",16,"د",1,0],["رصاصتُكَ التي أطلقْتَ نحوي","تُصيبُكَ مثلما قلبي تُصيبُ",17,"ب",1,0],["رصدت العُلى في مُلتَقى طُرق النَدى","فَلا غرو إِن صارَت إِلَيكَ مَصائِرُهُ",18,"ر",2,0],["رصعت مثلما ترصع تاج","بقرى قد حكت عقود جمان",19,"ن",1,0],["رصاصا في أنابيب","من الفولاذ أو أقسى",20,"ا",1,0],["رصفوا الحجارة في البحا","ر وفوقها شادوا معابر",21,"ر",1,0],["رصدت لحفاظ الكتاب جوائز","تجاوزن في المقدار ما رصد الألى",22,"ل",2,0],["رصفَتْ قلائدَها بما سفكتْ","من فيضِ دمعٍ أو دمٍ هَدْرِ",23,"ر",1,0],["رَصينٌ ذو مُحاضَرَةٍ مَكينٌ","وسَمْكُ الدَّهْرِ يُمطِرُ بالحُتوفِ",24,"ف",1,0],["رصدوك في ضيق المجال بحيث لا","الخطي متسع ولا الخطار",25,"ر",1,0]]}