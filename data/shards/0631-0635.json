{"poems":[[93,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[91,"هيهات بعدك ما يفيد تصبر","https://www.aldiwan.net/poem8822.html","عموديه"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[33,"قمر نم عليه نوره","https://www.aldiwan.net/poem25868.html","الرمل"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[100,"خير ما في القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=50388",""],[100,"سحر الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=50091",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[116,"ما للقلوب من العيون امان","https://www.aldiwan.net/poem40440.html","عموديه"],[183,"رعى الله مغنى بالعذيب ومعهدا","https://www.aldiwan.net/poem67081.html","الطويل"],[186,"ووردة يقصر عنها الوصف","https://www.aldiwan.net/poem14753.html","الرجز"],[262,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[306,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[306,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[365,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[401,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[407,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[444,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[444,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[444,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[450,"هو الدين","https://www.aldiwan.net/poem977.html",""],[459,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[501,"قلوب الأولياء لها سيوف","https://www.aldiwan.net/poem37953.html","الوافر"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"]],"verses":[["رَصَانَةٌ وَذَكَاءٌ وَانْبِسَاطْ يَدٍ","أَكْرِمْ بِهَا يَدَ سَمْحٍ غَيْرِ مَنَّانِ",0,"ن",1,0],["رصّعُ متناه بالدراري","فراق في الحسن والرواء",1,"ا",2,0],["رَصَدَ الرَدى أَرواحَنا حَتّى لَقَد","كِدنا نُعَزّي المَرءَ قَبلُ يُصَوِّرُ",2,"ر",1,0],["رَصَدَ السَبيلَ فَما تَمُرُّ بِهِ","قَدَم وَلا النَسَماتُ إِذ تَسري",3,"ر",2,0],["رصفته ملائك","باليواقيت والدرر",4,"ر",1,0],["رصاص لا يغيض ولا يغيب","بعيد في مقاصده قريب",5,"ب",1,0],["رَصَدَ الخَلوَةَ حَتّى أَمكَنَت","وَرَعى الساهِرَ حَتّى هَجَعا",6,"ع",2,0],["رَصِّعوا التاجَ بِالوَفاءِ وَحَلُّوا","بِحِلى الصِدقِ عِزَّهُ وَالجَلالا",7,"ل",2,0],["رصدوا النجوم، ورحت أرصد شيخها","شيخَ النجوم الزُّهْر، علَّك مرشدي!",8,"د",2,0],["رَصَاصَةٌ تُعْنَى بإسكاتِهِ","ما أسكتتْ ما فيه حَتَّى الحُروب",9,"ب",1,0],["رصّع الدنيا أغاريد وشعرا","وتفجر يا ربيع الحبّ سكرا",10,"ر",2,1],["رصاص البَغي يفجُرُكم ليجري","دمٌ يَزْكو به الوطنُ ازدِراعا",11,"ع",2,0],["رصعته بنبال طرفك فانبرى","مضنى وفي احشائه نيران",12,"ن",1,0],["رَصانة خُلقٍ كَالجِبالِ تَوَقَرَتْ","فَلو خالَطَتْ بَحراً لَما جاشَ مُزبِدا",13,"د",2,0],["رُصَّتْ بها قَطائفٌ لا تجفو","محكمَةٌ من فوق صفٍّ صفُّ",14,"ف",1,0],["رصدوا الأنجم الطوالع والأفلاك","واللَه غالب مرصاده",15,"د",2,0],["رُصّعت لَكن بياقوتِ الزَهَر","وَحَصى درٍّ بِها مُكتَنِفين",16,"ن",1,0],["رصد إذا غضب السلاح تذمروا","حتى يعود إلى السلاح رضاءُ",17,"ا",2,0],["رَصّعْتَ تاجَ عُلاكَ منه بدرَّةٍ","أعْيَتْ على هِمَم المُلوكِ الصِّيد",18,"د",1,0],["رصاصتُكَ التي أطلقْتَ نحوي","تُصيبُكَ مثلما قلبي تُصيبُ",19,"ب",1,0],["رصدت العُلى في مُلتَقى طُرق النَدى","فَلا غرو إِن صارَت إِلَيكَ مَصائِرُهُ",20,"ر",2,0],["رصعت مثلما ترصع تاج","بقرى قد حكت عقود جمان",21,"ن",1,0],["رصاصا في أنابيب","من الفولاذ أو أقسى",22,"ا",1,0],["رصفوا الحجارة في البحا","ر وفوقها شادوا معابر",23,"ر",1,0],["رصدت لحفاظ الكتاب جوائز","تجاوزن في المقدار ما رصد الألى",24,"ل",2,0],["رصفَتْ قلائدَها بما سفكتْ","من فيضِ دمعٍ أو دمٍ هَدْرِ",25,"ر",1,0],["رَصينٌ ذو مُحاضَرَةٍ مَكينٌ","وسَمْكُ الدَّهْرِ يُمطِرُ بالحُتوفِ",26,"ف",1,0],["رصدوك في ضيق المجال بحيث لا","الخطي متسع ولا الخطار",27,"ر",1,0]]}