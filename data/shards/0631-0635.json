,"https://www.poetsgate.com/ViewPoem.aspx?id=211531",""],[5848,"رصاصة الرحمه","https://www.poetsgate.com/ViewPoem.aspx?id=53103",""],[5957,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180143",""],[5957,"للتسامح ِ ضفافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183596",""],[6093,"هذي القصائد بعض ما في الأفئدة","https://www.poetsgate.com/ViewPoem.aspx?id=207201",""],[6152,"حبكِ الأغلى","https://www.poetsgate.com/ViewPoem.aspx?id=205390",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""],[6237,"رصيد الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77886&r=&rc=28",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""],[454,"هو الدين ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82679&r=&rc=43",""]],"verses":[["رَصَانَةٌ وَذَكَاءٌ وَانْبِسَاطْ يَدٍ","أَكْرِمْ بِهَا يَدَ سَمْحٍ غَيْرِ مَنَّانِ",0,"ن",1,0],["رصّعُ متناه بالدراري","فراق في الحسن والرواء",1,"ا",2,0],["رَصَدَ الرَدى أَرواحَنا حَتّى لَقَد","كِدنا نُعَزّي المَرءَ قَبلُ يُصَوِّرُ",2,"ر",1,0],["رَصَدَ السَبيلَ فَما تَمُرُّ بِهِ","قَدَم وَلا النَسَماتُ إِذ تَسري",3,"ر",2,0],["رصفته ملائك","باليواقيت والدرر",4,"ر",1,0],["رصاص لا يغيض ولا يغيب","بعيد في مقاصده قريب",5,"ب",1,0],["رَصَدَ الخَلوَةَ حَتّى أَمكَنَت","وَرَعى الساهِرَ حَتّى هَجَعا",6,"ع",2,0],["رَصِّعوا التاجَ بِالوَفاءِ وَحَلُّوا","بِحِلى الصِدقِ عِزَّهُ وَالجَلالا",7,"ل",2,0],["رصدوا النجوم، ورحت أرصد شيخها","شيخَ النجوم الزُّهْر، علَّك مرشدي!",8,"د",2,0],["رَصَاصَةٌ تُعْنَى بإسكاتِهِ","ما أسكتتْ ما فيه حَتَّى الحُروب",9,"ب",1,0],["رصّع الدنيا أغاريد وشعرا","وتفجر يا ربيع الحبّ سكرا",10,"ر",2,1],["رصاص البَغي يفجُرُكم ليجري","دمٌ يَزْكو به الوطنُ ازدِراعا",11,"ع",2,0],["رصعته بنبال طرفك فانبرى","مضنى وفي احشائه نيران",12,"ن",1,0],["رَصانة خُلقٍ كَالجِبالِ تَوَقَرَتْ","فَلو خالَطَتْ بَحراً لَما جاشَ مُزبِدا",13,"د",2,0],["رُصَّتْ بها قَطائفٌ لا تجفو","محكمَةٌ من فوق صفٍّ صفُّ",14,"ف",1,0],["رصدوا الأنجم الطوالع والأفلاك","واللَه غالب مرصاده",15,"د",2,0],["رُصّعت لَكن بياقوتِ الزَهَر","وَحَصى درٍّ بِها مُكتَنِفين",16,"ن",1,0],["رصد إذا غضب السلاح تذمروا","حتى يعود إلى السلاح رضاءُ",17,"ا",2,0],["رَصّعْتَ تاجَ عُلاكَ منه بدرَّةٍ","أعْيَتْ على هِمَم المُلوكِ الصِّيد",18,"د",1,0],["رصاصتُكَ التي أطلقْتَ نحوي","تُصيبُكَ مثلما قلبي تُصيبُ",19,"ب",1,0],["رصدت العُلى في مُلتَقى طُرق النَدى","فَلا غرو إِن صارَت إِلَيكَ مَصائِرُهُ",20,"ر",2,0],["رصعت مثلما ترصع تاج","بقرى قد حكت عقود جمان",21,"ن",1,0],["رصاصا في أنابيب","من الفولاذ أو أقسى",22,"ا",1,0],["رصفوا الحجارة في البحا","ر وفوقها شادوا معابر",23,"ر",1,0],["رصدت لحفاظ الكتاب جوائز","تجاوزن في المقدار ما رصد الألى",24,"ل",2,0],["رصفَتْ قلائدَها بما سفكتْ","من فيضِ دمعٍ أو دمٍ هَدْرِ",25,"ر",1,0],["رَصينٌ ذو مُحاضَرَةٍ مَكينٌ","وسَمْكُ الدَّهْرِ يُمطِرُ بالحُتوفِ",26,"ف",1,0],["رصدوك في ضيق المجال بحيث لا","الخطي متسع ولا الخطار",27,"ر",1,0],["رَصَدَ الظَّلامِ بِحُبِّهِ وَسَرَى","حَتَّى إذا نَصَلَ الدُّجَى قَلاّ",28,"ل",2,0],["رَصَدَت هَديَه مراجيحُ حَمزيُّ","ونَ بيضُ اللِّوَى مِنَ اللاَّمِ سُفعا",29,"ع",2,0],["رَصدَت غَفلَةَ الرَّقيبِ فَلَمّا","أسعَفت أوهَمت بأمرٍ لأمرِ",30,"ر",1,0],["رصفاً بإِحجامٍ يريح ذوي الضنى","لا يختشي فيهِ الضريرُ عثرا",31,"ر",2,0],["رصع الشمس لنا بالشهب","واسكب الفضة فوق الذهب",32,"ب",1,0],["رُصِفَت نُقوشُ بُناهُ رَصفَ قَلائِدٍ","قَد نَضَّدَتها في النُحورِ الحورُ",33,"ر",1,0],["رَصْعاً كَسَاها شِيَةً نَمِيما","تَئِنُّ حِينَ تَجْذِبُ المَخْطُوما",34,"م",2,0],["رصعته بمساعيكم وجئت به","أرجو القبول فيا بشرى إذا قبلا",35,"ل",2,0],["رَصعته تَرصيعا","حَتّى أَتى بديعا",36,"ع",2,0],["رَصَدَ الغَفلَةَ حَتّى أَمكَنَت","وَرَعى السامِرَ حَتّى هَجَعا",37,"ع",2,0],["رصدَ البدرَ بأَبراج الفلكْ","هاتفاً يا قمراً قلبيَ لكْ",38,"ك",1,0],["رَصَّعَ الشَيبُ لِمَّتي يا خَليلي","بِنجومٍ طُلوعِهِنَّ أُفولي",39,"ي",1,1],["رَصَدتُهُم بالثنايا الخُضرِ أرقُبُهُم","كيما يقيلوا مقيلي بعدَ تفجيعي",40,"ع",2,0],["رصدتها من جانب المنش أسد","خلقت للوغى فروعاً وأصلا",41,"ل",2,0],["رصافتي رصفتها","مدامعي بالعقيق",42,"ق",1,1],["رصَّعَتها يَدُ العطاءِ بِدُرٍّ","فوقَ وَشيٍ من نادرِ العقيانش",43,"ن",2,0],["رَصَدُوا الكواكبَ وهي بين بروجها","تجري بِقُدرَةِ مُبدعِ الأكوانِ",44,"ن",1,0],["رصعتها حبب كالأنجم","حبذا آناء أنس أقبلت",45,"ت",1,0],["رصدوا الصباح لينفقوا كنز الهدى","أو ما دروا كنز الهدى مرصودا",46,"د",2,0],["رصين حصاة الحلم مُسْتَحْصِد القوى","بعيد مرامي الفكر ماضي العزائم",47,"م",1,0],["رصدت كنزك لي ثغرها","بأقاع أرسلتهن جعودا",48,"د",2,0],["رصدتها عقارب وأفاع","تلك قدامها وهذي وراها",49,"ا",3,0],["رُصِّعَت مِنهُ شَهاداتكم","وَتَحلَّت بِمَساعي الامتحان",50,"ن",1,0],["رصد المكارم والهدى لما وعى","ومحى الدلامس والوساوس والعمى",51,"م",2,0],["رصدوا المناجمَ والنجومَ فهذه","تنشقُّ طيِّعةً وهذي أطوَعُ",52,"ع",1,0],["رصدوا الأنجمَ المغيراتِ فى الأفقِ","وفجُّوا بالسعدِ فى كيوان",53,"ن",1,0],["رصينُ المعالي ثابتُ المجد والثنا","بديعُ المعاني رائقُ الحمدِ والشكرِ",54,"ر",1,0],["رَصَّعَهُ بِجَوهَرٍ","فَصارَ زَينَ الكُتُبِ",55,"ب",1,0],["رصد الجمال قوامه في أرقم","بنقى الروادف نافث بسمامه",56,"م",2,0],["رَصَدَ النهَى عشاقها فَحُسينها","رصدَ المعالي هل عليهِ جُناح",57,"ح",1,0],["رصافه جازت الاحصا وواحدها","مدحي ومدح الورى في بعض معناه",58,"ا",2,0],["رصيت عني فدنت مني","تجلة عماً عيشي كدر",59,"ر",1,0],["رصين ليس يملكه غرورٌ","ولم يخطر له وهم ببالِ",60,"ل",1,0],["رصد المكارم دون كل مشاغب","لم يستطع مذ سار شق غبار",61,"ر",1,0],["رَصَفنَ رِصافاً تَهتَدي لِلَبانِهِ","كَما يَهتَدي لِلكَيدِ نَبلُ المُناضِلِ",62,"ل",1,0],["رصينٌ صوت نجواها","وديعٌ حولها الدهر",63,"ر",1,0],["رصّ الأساس على الحقائق إنما","للعرش أغمية غدا ودعام",64,"م",1,0],["رَصَّعتُ من فضل العمامة","تاجَه فجلوتُه",65,"ت",2,0],["رصينا نقيّ المستشف مسلسلا","كما سال فوق الفضة الماء صافيا",66,"ي",2,0],["رَصينُ الجَأْشِ لَمَّا جا","شَ بَحْرُ خَمِسِيهِ الأَرْعَنْ",67,"ن",1,0],["رصانة حلم سفّهت كلّ أحنف","وديمة جود بخّلت كلّ حاتم",68,"م",1,1],["رَصعتموهُ بِياقوت الصِفات الَّذي","اذخرتموهُ لَدَيكُم طارِفاً تلدا",69,"د",2,0],["رَصدَ القَضاءُ لِنورَها وَجَلالِها","فَأَحالَهُ مُتَبَذِّلاً تَحتَ القَدَمْ",70,"م",1,0],["رِصادَ سحوقِ النَخلِ يُرصَدُ حِجَّةً","وَدونَ ثَراها ليفُها المُتَلَيِّفُ",71,"ف",1,0],["رصّعَ أفواقها وأثرصَها","أنبلُ عدوانَ كلها صنعا",72,"ع",2,0],["رصداً لليل يخشى أن يغيب","ما لنا للحشر في الوصل نصيب",73,"ب",1,0],["رصَّعته شهب السماء ببدر","نضدته عليه أبهج نضد",74,"د",1,0],["رصدته من جعده ومحياه","جنود الأظلام والأصباح",75,"ح",1,0],["رصعت بالجمع تصريع الجناس وبا","لتفريق طابق ما أرصدت تعبير",76,"ر",1,0],["رصفاته الحسنى تسامى وصفها","ولقد تفاخر في نداهُ الجودُ",77,"د",1,0],["رصدتني العدى وهمَّت بِقَتلي","فَوَقاني المولى وَفرَّجَ كَربي",78,"ب",2,0],["رصدت عقاربُ صدغِهم أفوافهم","فكأنها مرصودةٌ بطلاسم",79,"م",1,0],["رصَّعتَ اكليل الكمال بلؤلؤٍ","تِخذَت غواني النظم منه عقودها",80,"د",3,0],["رصداً أمسى على كنز اللمى","وبه الخال غدا عبد الرصد",81,"د",1,0],["رصاصُ أَعاديهم عرائسِ جنَّةٍ","سماويَّةٍ والحربُ شَهدٌ وسُكَّرُ",82,"ر",1,0],["رَصَدْتُ النَّجْمَ نَجْماً بَعْدَ نَجْمٍ","إِلَىْ أَنْ نِمْتُº وَانْبَلَجَ الصَّبَاْحُ",83,"ح",1,0],["رصد الجنود له الطريق وتابعوا","آثاره برجوعه ومهازله",84,"ل",2,0],["رصدٌ في الحديد لو ان هارو","ت رقاهُ لضلّ في قسماته",85,"ت",2,0],["رصدته بالعقل في السير لما","أودعت فيه سرها المجهولا",86,"ل",2,0],["رصدته بمرشد وكفى بالعق","ل للنفس مرشداً ودليلا",86,"ل",2,0],["رصدوا لها كل العوائق والقنا","كي تنزوي لكن ربك أَفْحَمَا",87,"م",2,0],["رصفاء قلوبهم كرصيف","بالسمنتو مصفح، للمرور",88,"ر",1,0],["رصف الجماجم للوصول إلى","أهواءه وميوله جسرا",89,"ر",2,0],["رَصاصُ المَوتِ يُهدينا صِرَاطًا","نَسيرُ عَلَى الصِّرَاطِ المُستَقيمِ",90,"م",1,0],["رصافتك العمر عطر الهوى","وكرخك بغداد شهد العسل",91,"ل",1,0],["رَصَّعْتُ فَوْقَ الثَّلْجِ إسْمكَ أوْحَدَا","فتَلألأتْ حَبَّاتهُ مِثْل النَّدَى",92,"د",2,1],["رصِّي الصُّفوفَ فللحديثِ بقيةٌ","سيكونُ كلُّ العالمينَ شُهودَهْ",93,"د",2,0],["رصف القضا أحجاره فاقامه","سجناً وسخر أهله ببنائه",94,"ا",3,0],["رَصَدْتُ تَرَقُّبي لرُجوعِ رُوحي","لَعَلَّ الله يَجْعَلُ مُسْتَقَرّا",95,"ر",2,0],["رصينا فلم أترك لخيلي عنانه","سوى صهوة التخييل شذت عن الأنا",96,"ن",2,0],["رصاص العدا فوقه وابل","ويصرخ: فلتقبلي يا منية",97,"ي",2,0],["رَصُّ الْحُرُوفِ وَ نَظْمُ الشِّعْرِ حِيلَتُنَا","وَ الْقَلْبُ مُنْقَبِضٌ وَ النَّارُ تَلْتَهِبُ..",98,"ب",1,0],["رصاصة َالغدر ِهاك ِ القلبَ واخترقي","منابتَ الرّوح ِعَلّ الجُرحَ يَستترُ",99,"ر",1,0],["رَصاصة َالغدر ِها شُلتْ حوافِرُكِ","جُبنا ً وعَارا ً وفعلٌ أصْلهُ سَقر ُ",99,"ر",1,0],["رصّع الأَرزُ والصنوبرُ منها","كلَّ عقد في جيدها باللآلي",100,"ل",2,0],["رصَّعَ الشيبُ لَّتي يا خليلي","بنجومٍ طلوعهنَّ أفولي",101,"ي",1,1],["رٓصّعتُ حرفي واكتشفتُ مكانتي","لا ردَّ يأتي .. كانَ صَمْتُكَ قاتلاً",102,"ل",2,0],["رصعتها درراً أتت كقلادة","ترصيع نقاش خبير ماهرِ",103,"ر",1,0],["رصّع الفضة في لؤلؤةٍ","جمّلت خالا على الوجن عقيقا",104,"ق",2,0],["رَصَعَتْ فُجاءاتُ الرَّحيلِ هَوى الصِّبا","هَمِلاً عَلى الخَدَّينِ سيقَ ذَليلا",105,"ل",2,0],["رصوا صفوفكم ان داهمت محن..","ولنعتلي سببا دهرا وثقناه",106,"ا",2,0],["رصدنا ما بحوذتنا","وما يأتي لمستقبل",107,"ل",1,0],["رصاصة الرحمه اطلقها وخلك شجاع","إضغط زناد الجفا والهجر لو تستطيع",108,"ع",1,1],["رصفوا جمال الكون ِ في وصف الحِمى","لكن حسنك خارق الأعجابِ",109,"ب",1,0],["رصفت العذر أشجارا ً بروحي","فأورقت التسامحَ من عفافي",110,"ف",2,0],["رص الكلام بدون أي بلاغة","قد شاء إطلاق الخيال فقيده",111,"د",2,0],["رصيدكِ عندي الأعلى","وأنتِ بقلبي الأعلى",112,"ل",2,1],["رصالوا عَلى حوران يدووا مغرب","بِالسَيف وَالبارود وَالعسال",113,"ل",1,0],["رصاصاتُ الحروفِ طبولُ غدرٍ","تكبّرُ كلما بلغتْ مدايا",114,"ا",3,0],["رصدتهُ بوصلةُ الرؤى فتزاحمت","أسسُ الرؤى كيما تراقَ بأسهِ",115,"س",2,0],["رصيدك في بنك الحياة غرورُ","إذا لم يغطيه تقى وضميرُ",116,"ر",1,1],["رصيد الحياة الخير والبر والتقى","وكل رصيد غيرهن قشورُ",116,"ر",1,0],["رصاص ولكن في صدور أحبة","وعزم، ولكن في موالاة عدوانِ",117,"ن",1,0],["رصدت لحفاظ الكتاب جوائزاً","تجاوزن في المقدار ما رصد الألى",118,"ل",2,0]]}