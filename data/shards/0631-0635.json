{"poems":[[93,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[91,"هيهات بعدك ما يفيد تصبر","https://www.aldiwan.net/poem8822.html","عموديه"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[33,"قمر نم عليه نوره","https://www.aldiwan.net/poem25868.html","الرمل"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""]],"verses":[["رَصَانَةٌ وَذَكَاءٌ وَانْبِسَاطْ يَدٍ","أَكْرِمْ بِهَا يَدَ سَمْحٍ غَيْرِ مَنَّانِ",0,"ن",1,0],["رصّعُ متناه بالدراري","فراق في الحسن والرواء",1,"ا",2,0],["رَصَدَ الرَدى أَرواحَنا حَتّى لَقَد","كِدنا نُعَزّي المَرءَ قَبلُ يُصَوِّرُ",2,"ر",1,0],["رَصَدَ السَبيلَ فَما تَمُرُّ بِهِ","قَدَم وَلا النَسَماتُ إِذ تَسري",3,"ر",2,0],["رصفته ملائك","باليواقيت والدرر",4,"ر",1,0],["رصاص لا يغيض ولا يغيب","بعيد في مقاصده قريب",5,"ب",1,0],["رَصَدَ الخَلوَةَ حَتّى أَمكَنَت","وَرَعى الساهِرَ حَتّى هَجَعا",6,"ع",2,0],["رَصِّعوا التاجَ بِالوَفاءِ وَحَلُّوا","بِحِلى الصِدقِ عِزَّهُ وَالجَلالا",7,"ل",2,0],["رصدوا النجوم، ورحت أرصد شيخها","شيخَ النجوم الزُّهْر، علَّك مرشدي!",8,"د",2,0],["رصاص البَغي يفجُرُكم ليجري","دمٌ يَزْكو به الوطنُ ازدِراعا",9,"ع",2,0]]}