ctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54893","الوافر"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[45,"معَ الدّهرِ ظُلمٌ ليسَ يُقلِعُ رَاتِبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31697",""],[45,"بعَيْنِكِ لَوْعَةُ القَلْبِ الرّهِينِ","https://www.poetsgate.com/ViewPoem.aspx?id=32076",""],[45,"هُبِلَ الوَاشِي بهَا، أنّى أفَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=33095",""],[45,"مَلامُكَ، إنّهُ عَهْدٌ قَرِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31531",""],[16,"هل ما علمتَ وما استُودِعتَ مكتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=4903",""],[46,"سرَيْنا، وطالبنا هاجعٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=16598",""],[46,"يَودُّ الفتى أنّ الحياةَ بسيطةٌº","https://www.poetsgate.com/ViewPoem.aspx?id=18318",""]],"verses":[["وَقَد يَنكُلُ المُستَغيرُ الشُجا","عُ حيناً وَتُخطي اليَدُ الدامِيَه",0,"ي",2,0],["وَقَد يَنتَصِرُ الواحِدُ","لا مالٌ وَلا أَهلُ",1,"ل",1,0],["وَقَد يُلقِحُ النَعماءَ قَومٌ أَعِزَّةٌ","وَيَخسَرُ قَومٌ عاجِزونَ سِقابَها",2,"ب",3,0],["وقد يصْدأُ السّيفُ المُلازِمُ غِمْدَهُ","ومَنْ لا يَرِمْ أوْطانَهُ فهْوَ يخْمَلُ",3,"ل",1,0],["وقدْ يتأتّى صَلاحُ النّفوسِ","وتَطْهيرُها بفَسادِ الجَسَدْ",4,"د",1,0],["وَقَد يَئِسَ الأَعداءُ أَن يَستَفِزَّني","قِيامُ الأُسودِ وَثبُها وَزَئيرُها",5,"ر",3,0],["وَقَد يَطعُنُ الفَرجَ يَومَ اللِقا","ءِ بِالرُمحِ يَحبِسُ أولى السُنَن",6,"ن",1,0],["وَقَد يَنبَري لِيَ الجَهلُ يَوماً وَأَنبَري","لِسربٍ كَحُرّاتِ الهِجانِ تُوافِقُهُ",7,"ق",2,0],["وَقَديماً بَنى الأَساطيلَ قَومي","فَفَرَقنَ البِحارَ يَحمِلنَ بَندي",8,"ي",1,0],["وَقَد يَقبَلُ الدَهرُ مَولى الأَنا","مِ جُهدَ العُبَيدِ إِذا ما أَقَلّ",9,"ل",1,0],["وَقَدِيماً أَبَى الأَصِيلُ مِنَ الحُسْ","نِ شَرِيكاً فَنَاهَزَ التَّأْلِيهَا",10,"ي",3,0],["وَقَدْ يُبَادِيءُ بِالحُسْنَى مُنَاوِئَهُ","وَلَمْ يَكُنْ مِنْ مُسِيءٍ قَط مُنْتَقِمَا",11,"م",2,0],["وَقَدْ يَكُونُ كَبِيرُ القَوْمِ مُحْتَشِمَا","وَلا يَكُونُ صَغِيرُ القَوْمِ مُحْتَشِمَا",11,"م",2,0],["وَقَدْ يَكوُنُونَ فِي بُؤْسٍ وَفِي عَطَشٍ","فَمَا يَقِي الْغُرَمَاءَ الرِّيُّ وَالبَشَمُ",12,"م",1,0],["وَقَد يُمسي الجَميعُ أولو المَحاوي","بِها المُتَجاوِرُ الحِلَلَ المُقيمُ",13,"م",1,0],["وقد يهبِط الأمصار وهو مُحجَب","ويظهر أحياناً كما أومض البرق",14,"ق",1,0],["وقد يفتري المال الفضائل للورى","وليس لهم مما افتراه نصيب",15,"ب",1,0],["وَقَد يَعلَمُ الحَيُّ مِن مالِكٍ","مُناخَ الدُهَيمِ وَأَيسارَها",16,"ر",3,0],["وقد يخذل المولى دعائي ويجتدي","أذاتي وإن يعدِل به الضيم أغضبِ",17,"ب",1,1],["وَقَد يُقطَعُ العُضوُ النَفيسُ لِغَيرِهِ","وَتُدفَعُ بِالأَمرِ الكَبيرِ الكَبائِرُ",18,"ر",1,0],["وَقَد يَكبُرُ الخَطبُ اليَسيرُ وَتَجتَني","أَكابِرُ قَومٍ ماجَناهُ الأَصاغِرُ",18,"ر",1,0],["وقد يتجافى الغيثُ عن متطلّب","وغيثك قيد الكفّ أو هوَ أقرب",19,"ب",1,0],["وقد يحسب المرءُ ما فاته","فيأتيه أضعافُ ما يحسب",20,"ب",1,0],["وقد يجيء بمعنىً بعد ذا حسنٍ","لكن على كتِفَيهِ منه كارات",21,"ت",1,0],["وقديماً رغْبتَ عن كل مَصْحو","بٍ من المُتْرفينَ والأمراءِ",22,"ا",2,0],["وقد يُخْفِي ضياءَ الشمسِ دَجْنٌ","تزول ولم يَحُنْ منها غروبُ",23,"ب",1,0],["وقد يَرْجعُ الوجناءَ سيري وعينُها","مُهَوَّكةٌ مثلُ الصُّبابة في الوَقْبِ",24,"ب",1,0],["وقد يَتظنَّى الناسُ أنّ أَساهُمُ","وصبرَهُمُ فيهم طِباعٌ مركَّبُ",25,"ب",1,0],["وقد يجيءُ بِخَلْطٍ فالنُّحاس لَه","وللأوائلِ صافيه من الذهبِ",26,"ب",1,0],["وقد يعزّيني شباباً مضى","ومدَّةً للعيشِ أسلفْتُهَا",27,"ت",3,0],["وَقَدْ يَفضِّلُهَا قَوْمٌ لِعَاجِلِها","لكنَّهُ عاجِلٌ يَمْضي مع الريحِ",28,"ح",1,0],["وقديماً وطَّدتها قبل تجري","مك عَشْراً فما اشتكتْ توطيدَكْ",29,"ك",1,0],["وقد يُعزِّي الفؤاد أنك في","جنّة عدن غداً وفي نَهَرِ",30,"ر",1,0],["وقديماً وفّق اللَّ","هُ خِياراً لخيار",31,"ر",1,0],["وقديماً عجز الأس","وار عن ذات السوارِ",31,"ر",1,0],["وقد يُسرق العذر من مفحَمٍ","ولا يسرق العذر من شاعر",32,"ر",1,0],["وقد يُغَرُّ بليغٌ من بلاغتهِ","وقد يظنُّ سوى المختار مختارا",33,"ر",2,0],["وقد يتوافى العتبُ منهنَّ والهوى","فيُعطينني حُكمي وهنّ سواخط",34,"ط",1,0],["وقديماً مددتَ ظلَك في القي","ظِ عليه دون الحُرور السُّفوع",35,"ع",1,0],["وقد يميل على من كان مال له","ويعقب البؤس من غذّاه سرهافا",36,"ف",2,0],["وقد يتيسر الميئوسُ منه","كما يتعذرُ الأمرُ المُحيل",37,"ل",1,0],["وقد يعدُ المرءُ البخيلُ كراهةً","ألاءً رجاءً أن يُعانَ على البذْلِ",38,"ل",1,0],["وقد يؤتَى هَجورٌ من سُلُوٍّ","كما يؤتى زَؤُورٌ من ملالِ",39,"ل",1,0],["وقد يحامي عن المواشي","وما تحامي ولا تصولُ",40,"ل",1,0],["وقديماً ذُكرتَ فاشتمل المَجْ","رُ على الرعبِ منك كل اشتمالِ",41,"ل",1,0],["وقد يأْلفْنَنِي ومعي سهامي","فما هذا النِّفار ولا سِهامُ",42,"م",1,0],["وقديماً ما أظلموا كالليالي","وأضأتُمْ للناسِ كالأيامِ",43,"م",1,0],["وقديماً ما جَرَّبَ الناسُ قَبْلي","ثِقلَ الهامِ في الخِفاف الحُلوم",44,"م",1,0],["وقد يُسوَّفُ بالإسقاء ذو ظمأ","ولن يسوَّفَ بالإسقاء غصّان",45,"ن",1,0],["وَقَد يَكونُ الصِبا مِنّي بِمَنزِلَةٍ","يَوماً وَتَقتادُني الهيفُ الرَعاديدُ",46,"د",1,0],["وَقَد يُكَلِّفُني قَلبي فَأَزجُرُهُ","رَبعاً غَداةَ غَدَوا أَهواؤُهُم فِرَقُ",47,"ق",1,0],["وَقَد يُغادي أَبو غَيلانَ رُفقَتَهُ","بِقَهوَةٍ لَيسَ في ناجودِها كَدَرُ",48,"ر",1,0],["وَقَد يَعقِلُ القُلُّ الفَتى دونَ هَمَّهِ","وَقَد كانَ لَولا القُلُّ طَلّاعَ أَنجُدِ",49,"د",1,0],["وَقَد يَسَرتُ إِذا ما الجوعُ كُلِّفَهُ","مُعَقَّبٌ مِن قِداحِ النَبعِ مَقرومُ",50,"م",1,0],["وَقَد يَكونُ نُضارٌ في خَزائِنِهِ","دَماً سَفَكناهُ أَو جَهداً بَذَلناهُ",51,"ا",2,0],["وَقَديمِ مَجدٍ صُنتَهُ","بِحَديثِ مَجٍ تَستَبيحُه",52,"ح",2,0],["وَقَديماً كَلِف المُلك بِنا","وَرأى مِنّا شُموساً فَعَشِقْ",53,"ق",1,0],["وقد يعود لي الصبا","وعهده في الذاكره",54,"ر",2,0],["وقد يجرده من شل ساعده","وقد يليح به من ليس يقتدر",55,"ر",1,0],["وقد يستطيع الشعب اصلاح شأنه","اذا لم يكن من كفه خرج الامر",56,"ر",1,0],["وقد يطلقها او قد تطلقه","اذا قضى بالطلاق الكره والملل",57,"ل",1,0],["وقد يعالج هما لا يزايله","حتى يموت وجرحا ليس يندمل",57,"ل",1,0],["وقد يطلقها في حانة ثملا","وليس تدري لماذا طلق الثمل",57,"ل",1,0],["وقد يثور من الارهاق منفجراً","كما يثور من التضييق بركان",58,"ن",1,0],["وقد يزيدك بالكذاب معرفة","وأنت تضحى وتمسى تسمع الكذبا",59,"ب",2,0],["وقد يريك أخا الوجهين منكشفا","وأنت تلقاه في الإِخوان منتقبا",59,"ب",2,0],["وقديما في الليالي لم تدم","بهجة العرس ولم يبق الدوِى",60,"ا",1,0],["وقد يفسد الجو من نتنها","وعندهم حفظها كالعبادة",61,"د",2,0],["وقد يُرعى الغمام الأرض أذنا","وأين الأرض من سمع الغمام",62,"م",1,0],["وقد يمحو بك الإسلام عارا","إذا الإسلام في يوم أُهينا",63,"ن",2,0],["وَقَد يَزيدُ في الثَنا عَلَيهِ","إِذا رَأى شَيئاً حَلا لَدَيهِ",64,"ه",1,0],["وَقَديماً بَنى الغُلُوُّ نُفوساً","وَقَديماً بَنى الغُلُوُّ عُقولا",65,"ل",2,0],["وَقَد يَقتُلُ المَرءَ هَمُّ الحَياةِ","وَشُغلُ الفُؤادِ وَكَدُّ الفِكَر",66,"ر",1,0],["وَقَد يَموتُ كَثيرٌ لا تُحِسُّهُمُ","كَأَنَّهُم مِن هَوانِ الخَطبِ ما وُجِدوا",67,"د",3,0],["وَقَديماً بِاِسمِهِ قَد ظَلَما","كُلُّ ذي مِئذَنَةٍ أَو جَرَسِ",68,"س",1,0],["وَقَديماً عِندَ مَروانٍ تِرات","لِزَكِيّاتٍ مِنَ الأَنفُسِ نور",68,"ر",1,0],["وَقَديمِ عَهدٍ لا ضَئي","لٍ في الوِدادِ وَلا ذَميمِ",69,"م",1,0],["وَقَد يَئِسوا مِن لَذيذِ الحَياةِ","فَعَينٌ تَغورُ وَقَلبٌ يَجِب",70,"ب",1,0],["وَقَد يَترَكُ النَفسَ الَّتي لا تَهابُهُ","وَيَختَرِمُ النَفسَ الَّتي تَتَهَيَّبُ",71,"ب",1,0],["وَقَد يُلَقِّبُهُ المَجنونَ حاسِدُهُ","إِذا اِختَلَطنَ وَبَعضُ العَقلِ عُقّالُ",72,"ل",1,0],["وَقَد يَتَزَيّا بِالهَوى غَيرُ أَهلِهِ","وَيَستَصحِبُ الإِنسانُ مَن لا يُلائِمُه",73,"م",2,0],["وَقَد يَتَقارَبُ الوَصفانِ جِدّاً","وَمَوصوفاهُما مُتَباعِدانِ",74,"ن",1,0],["وقد يُسلبُ الرأيَ الفتَى وهو حازمٌ","وينبُو غِرارُ السيف وهو حُسامُ",75,"م",1,0],["وقد يتعَرَّى الغُصْنُ حيناً ويكتسي","نَضارتَهُ ما لم ينلْ منه خاضِدُ",76,"د",1,0],["وَقَد يُحرَمُ المَوتورُ إِمّا تَعَزَّزَت","عِداهُ وَإِمّا فاتَ في الأَرضِ هارِبُه",77,"ب",2,0],["وَقَد يُريني الحَبيبُ مُبتَسِماً","يَروى غَليلُ الهَيمانِ عَن شَنَبِه",78,"ب",2,0],["وَقَد يَرِدُ المَناهِلَ مَن يُحَلّا","عَلى ظَمَإٍ وَيَغنَمُ مَن يَخيبُ",79,"ب",1,0],["وَقَد يُتَّقى فَتكُ الحَليمِ إِذا رَأى","ضَرورَةَ مَدلولٍ عَلى الفَتكِ مُحرَجِ",80,"ج",1,0],["وَقَديماً سَما بِرَأيِ أَبي العَبّ","اسِ عَزمٌ ماضٍ وَرَأيٌ سَديدُ",81,"د",1,0],["وَقَدٍّ يَكادُ القَلبُ يَنقَدُّ دونَهُ","إِذا اِهتَزَّ في قُربٍ مِنَ العَينِ أَو يُعدِ",82,"د",1,0],["وَقَد يُطالِبنَ ما قَدَّمنَ مِن سَلَفٍ","فيهِ فَيَنقُصنَهُ الفَضلَ الَّذي اِزدادا",83,"د",2,0],["وَقَد يَزيرُ الكَرى مَن لا زِيارَتُهُ","قَصدٌ وَيُدني الهَوى مِن بَعدِ ما بَعَدا",84,"د",2,0],["وَقَد يُتَوَقَّعُ مَوتُ الحِما","رِ إِلّا بِبَعضِ مَنايا الحُمُر",85,"ر",1,0],["وَقَديماً عَهِدَتني ذا هَناتٍ","آبِياتٍ عَلى الدَنِيّاتِ شُمسِ",86,"س",1,0],["وَقَد يُبلِغُ المُشتاقَ مَوقِعَ شَوقِهِ","سُرى الأَرحَبِيّاتِ البَعيدِ كَلالُها",87,"ل",3,0],["وَقَديمُ ما بَيني وَبَينَكَ إِنَّهُ","عَقدٌ أُمِرَّ عَلى الزَمانِ فَأُحكِما",88,"م",2,0],["وَقَد يُهتَدى بِالنَجمِ يُشكِلُ سَمتُهُ","وَيُروى بِماءِ الجَفرِ وَهوَ ذِمامُ",89,"م",1,0],["وَقَد يَإِسَ العَواذِلُ مِن فُؤادٍ","لَجوجٍ في غَوايَتِهِ حَرونِ",90,"ن",1,0],["وَقَد يَهيجُ عَلى الشَوقِ الَّذي بَعَثَت","أَقرانُهُ لائِحاتُ البَرقِ وَالذَكَرُ",91,"ر",1,0],["وَقَد يَركَبُ المَوتَ الفَتى مِن مُضيمَةٍ","إِذا لَم يَكُن إِلّا إِلى المَوتِ مَزحَلُ",92,"ل",1,0],["وَقَد يَنبَحُ الكَلبُ النُجومَ وَدونَها","فَراسِخُ تُنضي العَينَ لِلمَتَأَمِّلِ",93,"ل",1,0],["وقد يُنسَى الربيعُ إذا تَولَّتْ","لَيَاليَهُ وقد يُسْلى الشّبابُ",94,"ب",1,0],["وَقَد يَهلِكُ الإِنسانُ مِن بابِ أَمنِهِ","وَيَنجو لَعَمرُ اللَهِ مِن حَيثُ يَحذَرُ",95,"ر",1,0],["وَقَد يَسلو المَصائِبَ مَن تَعَزّى","وَقَد يَزدادُ في الحُزنِ الجَزوعُ",96,"ع",1,0],["وَقَد يَجري قَليلُ المالِ مَجرى","كَثيرِ المالِ في سَدِّ الخِلالِ",97,"ل",1,0],["وَقَد يَصبُرُ المَغلوبُ رَغماً عَلى الأَذى","كَما يَئِسَ الظَمآنُ مِن لَذَّةِ الشُربِ",98,"ب",1,0],["وقديمِ سرٍّ في هواكِ كتمتُه","أبداً وآخرَ ظاهرٍ مهتوكِ",99,"ك",1,0],["وقد يعقلُ الأبطالَ خوْفُ صيالها","ويُحكمُ تثقيفَ الأسودِ ضواريا",100,"ي",2,0],["وقديمُ الوِرْدِ جديدُ الحَمْدِ","هناك أفوهُ به وهنا",101,"ن",2,0],["وقدٍّ يميتُ حياة الغصون","فتذوي نَضَارةُ أوراقها",102,"ق",3,0],["وَقَد يَستُرُ الإِنسانُ بِاللَفظِ فِعلَهُ","فَيُظهِرُ مِنهُ الطَرفُ ما كانَ يَستُرُ",103,"ر",1,0],["وَقَديماً ما اِستُنبِطَت طاعَةُ الخا","لِقِ إِلّا مِن طاعَةِ المَخلوقِ",104,"ق",1,0],["وَقَد يَكهَمُ السَيفُ المُسَمّى مَنِيَّةً","وَقَد يَرجِعُ المَرءُ المُظَفَّرُ خائِبا",105,"ب",2,0],["وقدْ يجمعُ اللّهُ الشتيتينِ مِنَّةً","وفضلاً وربُّ الناسِ بالناسِ ألطفُ",106,"ف",1,0],["وقد يشِمْنا بِمُودٍ من مراتعنا","يُغثي النفوس ومُوبٍ من مَراعينا",107,"ن",2,0],["وَقَديماً كانَ عَهدي","وَفَتوني بِالنِساءِ",108,"ا",2,0],["وَقَد يَجمَعُ اللَهُ الشَتيتَينِ بَعدَما","يَظُنّانِ كُلَّ الظَنِّ أَن لاتَلاقِيا",109,"ق",3,0],["وَقَد يَجمَعِ اللَهُ الشَتيتَينِ بَعدَ ما","يَظُنّانِ كُلَّ الظَنِّ أَلّا تَلاقِيا",110,"ي",2,0],["وَقَد يَشعَبُ الأُلّافُ مِن بَعدِ عِزَّةٍ","وَيَصدَعُ ما بَينَ الخَليطَينِ صادِعُ",111,"ع",1,0],["وقد يكونُ لها من ربّها رَصَدٌ","إذا رماهُ بِعَيْنَيْ غَاضبٍ جَفلا",112,"ل",2,0],["وَقَد يَهجُرُ الطَيرُ أَوكارَهُ","إِذا وَجَدَ الأَمنَ وَالسُنبُلا",113,"ل",2,0],["وَقَد يَقتُلُ الجَهلَ السُؤالُ وَيَشتَفي","إِذا عايَنَ الأَمرَ المُهِمَّ المُعاينُ",114,"ن",1,1],["وَقَد يَستَحيلُ الرَحلُ وَالرَحلُ فائِتٌ","إِذا طالَ بِالرَحلِ اِختِلافُ النَواضِحِ",115,"ح",1,0],["وَقَد يُدرِكُ الأَمرَ غَيرُ الأَريبِ","وَقَد يُصرَعُ الحُوَّلُ القُلَّبُ",116,"ب",1,0],["وَقَد يَعقِبُ المَكروهَ يَوماً مَحَبَّةٌ","وَكُلُّ شَديدٍ مَرَّةً سَيَهونُ",117,"ن",1,0],["وَقَد يُباكِرُني الساقي فَأَشرَبُها","راحاً تُريحُ مِنَ الأَحزانِ وَالكُرَبِ",118,"ب",1,0],["وقد يُعْجِزُ الدَّاءُ الدَّواءَ مِن امرِئٍ","وَيَشْفِيهِ مِنْ داءٍ به الكيُّ والفَصْدُ",119,"د",1,0],["وقد يدرك الشيئين مشتبهين من","جهات ومنها قائم البغي نائم",120,"م",1,0],["وقد ينمّ علينا المنزليُّ ضحى","من القباب التي فيهنّ والكللِ",121,"ل",1,0],["وقد يَستفِيقُ الشوْقُ بعد لَجاجِهِ","وتَعْدَى على البُهم العِتاقِ الرواسم",122,"م",1,0],["وَقَد يُغَنّيكَ مِن سُكرٍ وَمِن طَرَبٍ","وَالكَأسُ تَختالُ مِن ساقٍ إِلى حاسي",123,"س",2,0],["وَقَد يَضُمُّ عَلَيَّ اللَيلُ نُقبَتَهُ","وَلا مُسامِرَ إِلّا السوءُ وَالباسُ",124,"س",1,0],["وَقَد يَغدو إِلى الحانوتِ زِقّي","فَيَأخُذُ عَفوَهُ قَبلَ الزُقاقِ",125,"ق",1,0],["وَقَد يَرزُقُ اللَهُ اللَئيمَ وَرُبَّما","غَدا الماجِدُ المَحمودُ مِن مالِهِ فَردا",126,"د",2,0],["وَقَد يَذكُرُ المُشتاقُ بَعضَ زَمانِهِ","فَيَبكي وَلا يَبكي لِمَوتِ حَبيبِ",127,"ب",1,0],["وَقَد يُخلِفُ الإِنسانُ ظَنَّ عَشيرِهِ","وَإِن راقَ مِنهُ مَنظَرٌ وَرُواءُ",128,"ا",2,0],["وَقَد يَفسُدُ الفِكرُ في حالَةٍ","فَيوهِمُكَ الدُرَّ قَطرُ السُرى",129,"ر",2,0],["وَقَد يُفري أسُوَدَ الغيلِ حِرصٌ","فَتَحويها الحَظائِرُ وَالزِرابُ",130,"ب",1,0],["وَقَد يورَثُ المالَ البَعيدَ مُضَلَّلٌ","مِنَ الناسِ يَأبى وَضعَهُ في القَرائِبِ",131,"ب",1,0],["وَقَد يُصبِحنَ عَن بِرٍّ وَنُسكٍ","بِأَطيَبِ عَنبَرٍ مُتَنَسِّماتِ",132,"ت",1,0],["وَقَد يَفقِدنَ أَزواجاً كِراماً","فَيا لِلنِسوَةِ المُتَأَيِّماتِ",132,"ت",1,0],["وَقَد يُضحي صُحاتُكِ أَهلَ سَجنٍ","وَتَلقَينَ الكُؤوسَ مُحَطَّماتِ",132,"ت",1,0],["وَقَد يُرزَقُ المَجدودُ أَقواتَ أُمَّةٍ","وَيُحرَمُ قوتاً واحِدٌ وَهوَ أَحوَجُ",133,"ج",1,0],["وَقَد يُغلِقُ الإِنسانُ مِن دونِ شَخصِهِ","وِلاجاً وَهَمُّ القَلبِ في النَفسِ والِجُ",134,"ج",1,0],["وَقَد يَخونُ رَجاءٌ بَعدَ خِدمَتِهِ","كَالغَربِ خانَت قُواهُ بَعدَما مُتِحا",135,"ح",2,0],["وَقَد يَنتَحي الزَندَ الغَويُّ بِجَهلِهِ","فَيَفضُل في القَدَحِ العَفارَةَ وَالمَرخا",136,"خ",2,0],["وَقَد يَخمُلُ الإِنسانُ في عُنفُوانِهِ","وَينَبَهُ مِن بَعدِ النُهى فَيَسودُ",137,"د",1,0],["وَقَد يَخطِئُ الرَأيَ اِمرُؤٌِ وَهُوَ حازِمٌ","كَما اِختَلَّ في وَزنِ القَريضِ عَبيدُ",138,"د",1,0],["وَقَد يُخلَفُ الظَنَّ المُعيدُ إِصابَةً","كَما أَعوَنَ الدَجّالُ في آلِ صائِدِ",139,"د",1,0],["وَقَد يَهجُرُ الحَتفُ القِيامَ إِلى الوَغى","وَيَطرُقُ أَبياتَ النِساءِ القَواعِدِ",140,"د",1,0],["وَقَد يَعِظُ الإِنسانَ عَيٌّ مِنَ الدُجى","وَيَنذُرُهُ داعٍ مِنَ الصُبحِ أَخرَسُ",141,"س",1,0],["وَقَد يَغنى اِبنُ آدَمَ وَهُوَ حُرٌّ","بِلا فَرَسٍ يُعَدُّ وَلا فَراسِ",142,"س",1,0],["وَقَد يَعيشُ الفَتى حَتّى يُقالُ لَهُ","ما ماتَ عِندَ لِقاءِ المَوتِ بَل عاشا",143,"ش",2,0],["وَقَد يُغني المُسِفَّ إِلى الدَنايا","تَعَيُّشُهُ مِنَ الخوصِ المُسَفِّ",144,"ف",1,0],["وَقَد يَحتالُ في رَدِّ الرَزايا","بِعودِ مُغَرِّدٍ وَبِعودِ صِنفِ",145,"ف",1,0],["وَقَد يَغشى الفَتى لُجَجَ المَنايا","حِذاراً مِن أَحاديثِ الرِفاقِ",146,"ق",1,0],["وَقَد يَطِلُّ دِماءً غَيرَ هَيِّنَةٍ","دَمٌ مِنَ الذارِعِ الزِنجِيِّ مَطلولُ",147,"ل",1,0],["وَقَد يَأمُرُ اللَهُ الكَهامَ إِذا نَبا","فَيَفري وَقَد يَنهى الحُسامَ فَيَكهُمُ",148,"م",1,0],["وَقد يُشبِهُّ الإِنسانُ جاءَ لِرُشدِهِ","بَعيداً وَيَعدو شِبهُهُ الخالَ وَالعَمّا",149,"م",2,0],["وَقَد يُبرِمُ الحَينَ القَضاءُ بِناشِئٍ","يُراوِحُ خَيطاً شَدُّهُ بِكِ مُبرَما",150,"م",2,0],["وَقَد يَبغي السَلامَةَ مُستَجيرٌ","فَيَترُكُ مِن مَخافَتِهِ السَلاما",151,"م",2,0],["وَقَد يُلفى الغَريبُ عَلى نَواةٍ","أَعَزَّ عَلَيكَ مِن خالٍ وَعَمِّ",152,"م",1,0],["وَقَد يُدرِكُ المَجدَ الفَتى وَهوَ مُقتِرٌ","كَثيرُ الرَزايا مُخلِقٌ سَمِلاهُ",153,"ل",3,0],["وَقَد يَرومُ ضَعيفٌ نيلَ آخِرَةٍ","فَلا يَشُكُّ لَبيبٌ أَن سَيُعطاها",154,"ا",3,0],["وَقَد يَجفو الكَرى مِنها جُفوناً","إِذا ما حَلَّ في ساقٍ كَراها",155,"ا",3,0],["وَقَد يَحمي الأَرانِبَ مِن أُسودٍ","ضَراغِمَةٍ جِراءٌ ثَعلَبِيُّ",156,"ب",2,0],["وقد يُلْفَى زَبَرْجَدُهُ عَقيقاً","إذا شهِدَ الأميرُ به القِتالا",157,"ل",2,0],["وقد يَنْمي كبيرٌ مِن صَغِيرٍ","ويَنْبُتُ من نَوَى القَسْبِ اللِّيانُ",158,"ن",1,0],["وقدْ يُجْتَدى فضْلُ الغَمامِ وإنّما","من البحرِ فيما يزعمُ الناسُ يَجتدي",159,"د",2,0],["وَقَد يَتَمادى ساعة ثم يَنتَهي","كأَنَّ الَّذي يرخيه قَلب مفجع",160,"ع",1,0],["وقد يبخل الإنسان في وفره على","أَخيه الَّذي أكدى ولا يبخل القطر",161,"ر",1,0],["وقد يصيب جليلاً حادث جللٌ","فَلا يغل يديه الحادث الجلل",162,"ل",1,0],["وَقَد يدفع الشعب عن حوضه","دفاع الكميِّ وَيستقتل",163,"ل",1,0],["وَقَد يتفشَّى الشعر كالنور سائحاً","فيركب متن الصبح إن لم يجد متنا",164,"ن",2,0],["وقد يَكون لعمري","مَع السرور بكاء",165,"ا",2,0],["وقد يغرد في الوادي على وجل","مرفرفاً فوق أوراق الرياحين",166,"ن",1,0],["وقد يُقْوي الفَصِيحُ فلا تُقابِلْ","ضَعِيفَ البِرّ إلاّ بالقَبُول",167,"ل",1,0],["وَقَد يُبتَلى قَومٌ وَلا كَبَلِيَّتي","وَلا مِثلَ جَدّي في الشَقاءِ بِكُم جَدُّ",168,"د",1,0],["وقد يَزِلُّ العالِمُ النِّحريرُ","والحَبرُ قد يَخُونهُ التَّحبيرُ",169,"ر",1,0],["وَقَدِيرٌ عَلَى الْعَطَاءِ وَلاَ يُعْ","طِيجَدِيرٌ بِالْفَقْرِ ذَاكَ اعْتِقَادِي",170,"د",2,0],["وَقَدِيماً كَانَ الأَحَبُّ إِلى المَرْ","ضَى دَوَاءً يَحْلُو بِهِ مَا يُمِرُّ",171,"ر",1,0],["وَقَدِيماً تَجَوَّدَ ابْنُ سَنَاءِ ال","مُلكِ مَا صَاغَ فِيهِ مِنْ أَبْيَاتِ",172,"ت",1,0],["وَقَدٌّ يُخْجِلُ الْغُصْنَ اعَتِدَالاً","وأزهَاراً وَلُطْفاً فِي الخُطُورِ",173,"ر",1,0],["وَقَد يُحسِنُ الناسُ الكَلامَ وَإِنَّما","كَلامي هُوَ الدُرُّ المُنَقّى المُنَقَّحُ",174,"ح",1,0],["وقديما بكى العباقر لبنانٌ","وروّى الآداب والأخلاقا",175,"ق",2,0],["وقديمُ الوُدِّ ستذكرُهُ","وتجدِّدُهُ وتؤَكِّدُهُ",176,"د",2,0],["وقديمُ ماضٍ في العَلا","ء يزينُه في النُّبْل حاضرْ",177,"ر",1,0],["وقد يُخفي الهلالَ مِحاق ليْلٍ","ليظهرَ بعده بدراً تمامَا",178,"م",2,0],["وقد يُدرِكُ الغاياتِ رأيٌ مُدرَّع","إذا ناءَ بالأمرِ الكَمِيُّ المدرَّع",179,"ع",1,0],["وقد يطرق البؤسُ النعيمَ اعتراضة","كما مَرّ مجتازاً غريبٌ مسافر",180,"ر",1,0],["وقد يُهوِّنُ عند المرء زلتَه","إحساسُه أنه ما بينَ إخوان",181,"ن",1,0],["وقد يكونُ قريباً أنْ ترى \" حلبٌ \"","خيلَ العراقِ قُبيلَ النجعِ تنتجع",182,"ع",1,0],["وقد يُضحِكُ الثكلى تناقضُ شارع","قوانينُه مأخوذةٌ بالتناحر",183,"ر",1,0],["وقد يملأُ الحرَّ المفكرَ حرقةً","تفكُّرُه يوماً بعُقبى المصاير",183,"ر",1,0],["وقد يُهلكُ الناسَ فردٌ يعيشُ","حيناً فكيف إذا ما استمر!",184,"ر",1,0],["وقد يجيئُ بما لم يَجْرِ في خَلَدٍ","وقد يقولُ الذي لم تهوَ إلاّه",185,"ا",2,0],["وَقَد يُحْرَمُ المَوْتُورُ إمّا تَعزّرَتْ","عداه وأما فاتَ في الأرْضِ هارِبُهْ",186,"ب",2,0],["وَقَدْ يَئِسَ العَواذِلُ مِنْ فُؤَادٍ","لَجُوجٍ في غِوَايَتِهِ، حَرُونِ",187,"ن",1,0],["وَقَدِيماً لَمْ أزَلْ في حُبّهَا","شارِدَ السّمعِ عنِ القوْلِ الأرَكّ",188,"ك",1,0],["وَقَدْ يَرِدُ المَنَاهِلَ مَنْ يُحَلّ","عَلى ظَمَإٍ، وَيَغنَمُ مَن يَخيبُ",189,"ب",1,0],["وقد يَسَرت إذا الجوعُ كُلّفه","معقب من قِداح النَّبعِ مقرومُ",190,"م",1,0],["وقد يفسُدُ الفكرُ في حالةٍ،","فيوهِمُكَ الدُّرَّ قَطرُ السُّرا",191,"ر",2,0],["وقد يخطىء الرأيَ امرؤٌ، وهو حازم","ٌ، كما اختلّ، في وزن القريض، عبيد",192,"د",1,0]]}