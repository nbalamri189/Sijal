"https://www.poetsgate.com/ViewPoem.aspx?id=191108",""],[5055,"وأنا حي","https://www.poetsgate.com/ViewPoem.aspx?id=72818",""],[5121,"هُوَ الْحُبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=209010",""],[5225,"من الفارس الملثم الى شيماء","https://www.poetsgate.com/ViewPoem.aspx?id=36755",""],[5277,"بغداد بين الأمس واليوم","https://www.poetsgate.com/ViewPoem.aspx?id=185168",""],[5277,"مخلب القِط","https://www.poetsgate.com/ViewPoem.aspx?id=197299",""],[5277,"بلا عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=204814",""],[5376,"لولا بحرف الضاد تسمو أمةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194865",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5586,"جلل ألم على الكرام فهالا","https://www.poetsgate.com/ViewPoem.aspx?id=173782",""],[5638,"رثاء وأمل في اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=198247",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5725,"مقل العيون","https://www.poetsgate.com/ViewPoem.aspx?id=209126",""],[5845,"ألسيعُ صلِّ مالهُ منْ راقِ","https://www.poetsgate.com/ViewPoem.aspx?id=16699",""],[5956,"إذا شاخ الدمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183934",""],[5956,"لولا براك الله من خير المَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193373",""],[5956,"خالد مظلوم يناجي شقيقه المرحوم محمد","https://www.poetsgate.com/ViewPoem.aspx?id=193450",""],[5956,"أخشَى أموتُ ولا أراك بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=193713",""],[5956,"يا مؤسس العقل العروبي النَّيِّر الخيِّر","https://www.poetsgate.com/ViewPoem.aspx?id=194754",""],[6102,"هو الهوى!","https://www.poetsgate.com/ViewPoem.aspx?id=182770",""],[6127,"رحلة الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=192766",""],[520,"لولا ثباتك والألباب خافقة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577439",""],[520,"إن كان عطفك للإعجاب يختال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577610",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""]],"verses":[["لَولا بَنوها وَقولُ الناسِ ما عُطِفَت","عَلى العِتابِ وَشرُّ الوُدِّ ما عُطِفا",0,"ف",2,0],["لَولا بَنو جَهوَرٍ ما أَشرَقَت هِمَمي","كَمِثلِ بيضِ اللَيالي دونَها الدُرَعُ",1,"ع",1,0],["لَوْلا بَشَاشَةُ إِيمَانٍ تُثَبِّتُهُمْ","تَخَيَّرُوا دُونَ تِلْكَ العِيشَةِ العَدَمَا",2,"م",2,0],["لولا بنو العطَّارِ لم يتنشق","عرف ندى يربو على نده",3,"د",2,0],["لَولا بَلاؤُكُمُ في غَيرِ واحِدَةٍ","إِذاً لَقُمتُ مَقامَ الخائِفِ الزَرِمِ",4,"م",1,0],["لَولا بَقِيَّةُ صَبرٍ في جَوانِبِها","طارَت لَهُ نَفسُها مِن وَقعِهِ شَذَرا",5,"ر",2,0],["لولا بَنانُكَ في طَلاسِمِ تُربِهِ","ما زادَ في شَرَفٍ عَلى أَترابِهِ",6,"ب",2,0],["لَولا بَقايا الصالِحينَ عَفا","ما كانَ أَثبَتَهُ لَنا وَرَسَم",7,"م",1,0],["لَولا بَنو جُشَمِ بنِ بَكرٍ فيكُمُ","رُفِعَت خِيامُكُمُ بِغَيرِ قِبابِ",8,"ب",1,0],["لولا بناتي متُّ مِنْ شوقٍ إلى","موتٍ أُراحُ بهِ من الأشرارِ",9,"ر",1,0],["لولا بلاغتُه وروعةُ نظمهِ","جَهِلَ الرجالُ اللّؤلؤَ المنظوما",10,"م",2,0],["لولا بَسالَتُهم وشِدَّةُ بأسِهِم","لم يبقَ منّا رائحٌ أو غادِ",11,"د",1,0],["لَولاَ بَذلتَ ثَِيَابِي وَالعِمَامَةَ لاَ","ألقَى لِنَفسِيَ غَيرُ الشِّعرِ وَالشَّعَرِ",12,"ر",1,0],["لَولا بَديعٌ مِن فَعالِكَ مُغرِبٌ","ما حاكَ مادِحُكَ البَديعَ المُغرِبا",13,"ب",2,0],["لَولا بَلائي لَما تَجَشَّمتُ أَه","والاً يُرى المَوتُ في أَدانيها",14,"ي",3,0],["لَولا بَنو عَوفِ اِبنِ بُهشَةَ أَصبَحَت","بِالنَعفِ أُمُّ بَني أَبيكَ عَقيما",15,"م",2,0],["لَولا بَدائِعُ دَلَّت أَنَّ خالِقَنا","أَدرى وَأَحكَمُ قُلنا خَلقُنا لَمَمُ",16,"م",1,0],["لَولا بَنو مالِكٍ وَالإِلُّ مَرقَبَةٌ","وَمالِكٌ فيهِمُ الآلاءُ وَالشَرَفُ",17,"ف",1,0],["لَولا بقية آمال تعللني","لطال في اليأس تأويبي وإدلاجي",18,"ج",2,0],["لولا بُكائي عَلى اِبنٍ خطبُهُ جَلَلٌ","جَعَلتُ أَضحَكَ بِالمِهذارِ وَاللاغي",19,"ي",1,0],["لولا بروق المشرفيات به","لم يهتد الجيش الأمام والقفا",20,"ا",1,0],["لولا بنو نصر لأندلس","لما عمر الهدى فيها قرارة دار",21,"ر",1,0],["لولا بشائرُكنَّ تاتي عنكمُ","أَفراحها يلهين لم يتخلدوا",22,"د",3,0],["لَو لابَسَ الصَخرَ الأَصَمَّ بَعضُ ما","يَلقاهُ قَلبي فَضَّ أَصلادَ الصَفا",23,"ا",1,0],["لولا بقيَّةُ إيمانٍ ترُفُّ منى","قلبي على ضوئها في ليل أحزاني",24,"ن",2,0],["لولا بقاياه وحقك في فمي","ما قلت شعرا بعدها وترسلا",25,"ل",2,0],["لَولا بدور في الخد وَركوا نس","ماهامَ ذو شجر بذات نطاق",26,"ق",1,0],["لُوْلاَ بَوادِرُها الْغزِارُ لأَوْشَكَتْ","وَهَوَاكَ نارُ هَواكَ أَنْ تُرْدِينِي",27,"ن",2,0],["لولا بريقُ الثنايا ما اهتديت إلى","مواردٍ نقعتْ بالرشف هيمانا",28,"ن",2,0],["لولا بقايا ظلمة في الر","وح من ماء وطين",29,"ن",1,0],["لَولا بَشائرك اللاتي بِها اِبتَهَجَت","لظلَّ يا بَدر دَهراً لَيلها حَلكا",30,"ك",2,0],["لولا بحارُ الدموعِ زاخرةً","ما اتّخذوها لغيرِها سُفُنا",31,"ن",2,0],["لولا بنو بيت الحريش تقسمت","سبي القبائل مازن والعنبر",32,"ر",1,0],["لو لا بقية لذة","من طيب عيش مرّ رغد",33,"د",1,0],["لولا بنو أيّوبَ لولاهُمُ","ما وجدَ المظلومُ أنصارَهْ",34,"ر",2,0],["لولا بسالتهُ لما ظمئت","أسلُ الفرنجِ إلى دمٍ بسل",35,"ل",1,0],["لولا بنو أيّوبَ ما جليتْ على","كفوءِ ولا حظيتْ بمنحةِ ماهر",36,"ر",1,0],["لولا بلائك في البلوى أبا حسن","مازال عنا غمام الغم والكرب",37,"ب",1,0],["لولا بيوت من الأموال جدت بها","على عساكرهم لم يستقم حال",38,"ل",1,0],["لولا بياضُ الضّحى ما نِيلَ مُفتَقَدٌ","ولم يَبِنْ مطلبٌ يبقى ومَقصودُ",39,"د",1,0],["لَولا بِرازُكَ لِلوَليدِ وَخيلِهِ","عَمرَ البِلادَ خَليفَتانِ اِثنانِ",40,"ن",1,0],["لولا بشارة في أهل الهوى خُلِقَتْ","لما اعترى راجحاً مِنْ عقله العدم",41,"م",1,0],["لولا بنو يعربٍ لاعتادتِ الجوْ","ر وقد ذاقتْ أشدَّ النَّكال",42,"ل",1,0],["لَولا بِدارُ الغاسِلينَ بِمائِهِم","قامَت بِغَسلِكَ لِلعُيونِ دُموعُ",43,"ع",1,1],["لولا بقية آمال تعللني","فيهم فيرتاح قلبي وهو غلان",44,"ن",1,0],["لولابقية حسرة من شوقهم","لم تلق غادية لجسمي موضعا",45,"ع",2,0],["لَوْلا بِعادي عَنْكَ ما كانَ لي","عَلى صُروفِ الدَّهْرِ مِنْ عَتْبِ",46,"ب",1,0],["لو لا بقايا معشر سلفوا","لتنبهت من نومها الفتنُ",47,"ن",1,0],["لولا بلاد عرفتها وطناً","لم أطلب المجد مثل من طلبوا",48,"ب",3,0],["لَولا بَنو آدم بَينَ العالم","ما بانَ لِلعُقول فَضل العالم",49,"م",1,0],["لولا بناتي وسيّئاتي","لطرت شوقاً إلى الممات",50,"ت",1,1],["لولا بقية ما أبقيت من عقبٍ","لم يلف يوماً لهذا الكون من أثر",51,"ر",1,0],["لو لا بنو نبهان سَادةُ عصرهم","قلنا لقد قبض الإله السؤددا",52,"د",2,0],["لَولا بَقاءُ مُحَمَّدٍ لَتَصَدَّعَت","أَكبادُنا أَسَفاً عَلى مَنصورِ",53,"ر",1,0],["لولا بقيّة آمال معلّقةٍ","على بني وطني الغرّ الميامين",54,"ن",1,0],["لَولا بَقِيَّةُ آمالٍ بِجانِبِهِ","لَقيلَ ماتَ أَسىً وَاللَهُ يَرحَمُهُ",55,"م",2,0],["لولا بقايا طلول الغابرين لما","أيقنت أنى على الأيام انتظر",56,"ر",1,0],["لَولا بَنُو الزَهراءِ ما عُرِفَ التُقى","فِينا وَلا تَبِعَ الهُدى الأَقوامُ",57,"م",1,0],["لولا بقية اعوان لدولتها","لم يبق للضاد ركن غير منهار",58,"ر",1,0],["لولا بقية آمال ببعضهم","مثل الأمير لعافت روحه الجسدا",59,"د",2,0],["لَولا بَنوك الأَلى شاعَت مِناقبهم","لَقلت مات التُقى وَالجُود وَالورع",60,"ع",1,0],["لَو لا بقيَّة آمالٍ تعلّلُني","لأَخمد اليأس مِن سَكناكِ أَنفاسي",61,"س",2,0],["لولا بوارع شعركم لم تنقشع","عن جوه الضراء والغماء",62,"ا",2,0],["لولا بقية أطلال لمال عَرَفت","عيوننا أين كانت دورُنا الأُوَل",63,"ل",1,0],["لولا بن مقلة أبدت حسن منظرها","لخال مقلته من غيظه رمدت",64,"ت",1,0],["لولا بنوه الخازنوا علومه","لقرض العلم غداة قرضا",65,"ض",2,0],["لولا بشارتك الذي ابقيته","خلفاً لما سلب الزمان وضيعا",66,"ع",2,0],["لولا بقايا كلام","ما حان لي أن أقوله",67,"ه",1,0],["لولا بقيّة عزمٍ","ورثته من شبابي",68,"ي",1,0],["لو لأبي حَفصٍ أقولُ مقالتي","وأبثُّ ما أبثثتكم لارتاعا",69,"ع",2,0],["لَولا بُرودة حلمه وَوَقاره","لأذيب مِن لُقياه كُل جَماد",70,"د",1,0],["لولا بقايا ذكرياتٍ رسَت","في القلبِ لم يقوَ عليها العذاب",71,"ب",1,0],["لولا بنو السادات في أرجائها","لم تزدهي الدنيا بوجه جمال",72,"ل",1,0],["لولا بنوك الغر أكرم فتيةٍ","لقضيت نحبي قبل حين حمامي",73,"م",2,0],["لَولا بَنو عثمان ما","نبست لشرقيّ نَوابس",74,"س",1,0],["لَولا بَنيّاتي الثَلاثةُ في الدَنا","لَسَكَنتُ أَعلى شامخِ الأَطوادِ",75,"د",1,0],["لو لأبي حَفصٍ أقولُ مقالتي","وأقصُّ شأنَ حديثكم لارتاعا",76,"ع",2,0],["لولا بَوَاقٍ قد بَقينَ","بقَدْرِ مزْوَدةِ الْقَنُوع",77,"ع",1,0],["لولا بروقٌ بالعقيقِ تلوحُ","تَغدو على عَذباتِه وَتروحُ",78,"ح",1,1],["لَولَا بِقلبِي ريَاحُ الوَجدِ قَد عَصَفَت","مَا كَانَ يَومًا لِيَجرِي بِالهَوَى قَلَمِي",79,"ي",1,0],["لولا بصير الشوف كانت مراجيح","يلعب بها الجهّال وتصارع أجيال",80,"ل",1,0],["لَوْلا بُلُوغ الْمُنَى مِنْ بَعْدِ عَاصِفَةٍ","لَمَا رَكِبْنَا الْهَوَى وَالْجَوُّ مَعْتُوهُ",81,"و",2,0],["لولا بأنّي خايفٍ سيف لحظك","إن كان ما جرّدت لاجلك حسامي",82,"م",2,0],["لولا بقايا العشقِ ما عُرِفَ الهوى","كيف الذي قد صامَ صدقاً يفطرُ",83,"ر",1,0],["لولا بعيدُ النوى داراً وما نبتتْ","أشجانهُ سنبلاً من دمعةِ القحْطِ",84,"ط",1,0],["لولا بقايا الأمسِ في وجدانِها","لتفلّتتْ من قبضةِ الوجدانِ",85,"ن",1,0],["لولا بحرف الضاد تسمو أمةٌ","ضاعت وزاد هوانها بهوانِ",86,"ن",1,1],["لولا بقيةُ آمالٍ تشاطرني ال","أحزان ليلاً وطرفُ النجمِ سهران",87,"ن",1,0],["لولا بنوك قضيت فيك وإنما","شاهدت نورك فيهم يتلالا",88,"ل",2,0],["لَوْلا بَقِيَّةُ مُؤْمِنِينَ أُحِبُّهُمْ","لَوَدِدْتُ أَنَّ أَشِعَّتِي أَضْرَامُ",89,"م",1,0],["لولا بقايا من الثوار صامدة","في ظل وهران تسقي خصمها العطبا",90,"ب",2,0],["لولا بقين على الحياد فأننا","من نارهنّ فكم قدحنَ زنادا",91,"د",2,0],["لولاَ بدورٌ في الخدورِ كوانسٌ","ما هامَ ذو شجنٍ بذاتِ نطاقِ",92,"ق",1,0],["لولا بروقُ الحظ أطعن خافقي","أنهي الشَّجَى لكنْ يخاف المسلمُ",93,"م",1,0],["لولا براك الله من خير المَلا","كأبيك لم أصبح كهذا هائما",94,"م",2,0],["لولا براءتُك اللذيذةُ لم يكن","شعري وأفكاري سوى كالثرثرةْ",95,"ر",2,0],["لولا بلادُكمُ الكريمةُ لم أزل","عن أي شغْل عاطلاً، أو سارقا",96,"ق",2,0],["لولا بلادُك بعد رب المقدرةْ","هي كلُّ أوطاني غدت متضوّرةْ",97,"ر",2,1],["لَولَا بِأَنَّ لَهُ فِي كُلِّ هاوِيَةٍ","ذَنبًا, لَما بِال: هَوَى- الهاوُونَ- سَمُّوهُ",98,"و",2,0],["لَولَا بِأَنَّ لَهُم عُقبَى الهَوانِ بِهِ","ما هانَ أَهلُ النُّهَى لَمَّا أَحَبُّوهُ",98,"و",2,0],["لولا بقية آل الله لاضطربت","كل الخلائق ما انمازتْ لهم سُبُلُ",99,"ل",1,0],["لولا بلاؤك في البلوى أبا حسن","ما زال عنا غمى كالغم والكرب",100,"ب",1,0],["لولا بيوت من الأمول جدت بها","على عساكرها لم يستقم حال",101,"ل",1,0],["لَولَا بَقِيّةُ فَضْلُ صَبْرٍ صَادِقٍ","لَتَرَكْتُ للّيَأسِ العَظِيمِ قِيَادِي !!",102,"د",2,0]]}