{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[55,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[40,"عفت بعدنا أجراع بكر فتولب","https://www.aldiwan.net/poem7688.html","الطويل"],[87,"أنلني يدا خلقت للقبل","https://www.aldiwan.net/poem7351.html","المتقارب"],[45,"فراق ومن فارقت غير مذمم","https://www.aldiwan.net/poem10570.html","الطويل"],[30,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[30,"وأغيد من من النعاس بعظمه","https://www.aldiwan.net/poem5445.html","الطويل"],[82,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9336","المتقارب"],[30,"ألم يك جهلا بعد سبعين حجة","https://www.poetsgate.com/ViewPoem.aspx?id=21316",""],[264,"إذا من من تهوى عليك بنظرة","https://www.aldiwan.net/poem35510.html","الطويل"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[422,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[438,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[449,"لله رب العرش والأكوان","https://www.aldiwan.net/poem56035.html","عموديه"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[519,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101534","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62551","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96719","المتقارب"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132235","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93896","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132733","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121427","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86319","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216788","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77179","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86366","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204285","الطويل"],[4755,"تَهَوَّدَ الجُولانُ","https://www.poetsgate.com/ViewPoem.aspx?id=203993",""],[4929,"تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=199293",""],[5206,"مَرثاة الصديق الغِشْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=187432",""],[5225,"نصيحه منه تحتاج إلنصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=27612",""],[5688,"إذا ما القلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208900",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5930,"شوك الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=92220",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[5956,"يُنَغّصُ عيشي","https://www.poetsgate.com/ViewPoem.aspx?id=183740",""]],"verses":[["إِذا مَنزِلٌ آنَ تَعريسُهُ","طَواهُ عَلى الأَينِ ظُعّانُهُ",0,"ن",2,0],["إِذا مَنزِلٌ رابَ سُكّانَهُ","مِنَ الأَرضِ حُرِّمَ إيطانُهُ",0,"ن",2,0],["إِذا مَنَحتَ العَوالي كَفَّ مُستَلِبٍ","أَقطَعتَ بَذلَ العَطايا كَفَّ مَسلوبِ",1,"ب",1,0],["إذا مَنَّ لم يَمْنُنْ بِمَنٍّ يَمُنُّه","وقال لنفسي أيُّها الناسُ أمْهَدُ",2,"د",1,0],["إِذا مَنَعوا لَم يُرجَ شَيءٌ وَراءَهُم","وَإِن رَكِبَت حَربٌ بِهِم كُلَّ مَركَبِ",3,"ب",1,0],["إذا منعت فضلها سابق","وإن منحت فضلها لم يزل",4,"ل",1,0],["إِذا مَنَعَت مِنكَ السِياسَةُ نَفسَها","فَقِف وَقفَةً قُدّامَهُ تَتَعَلَّمِ",5,"م",1,0],["إِذا مَنَعوا لَم يُرجَ شَيءٌ وَراءَهُم","وَإِن لَقِحَت حَربٌ يَجيؤوا فَيَركَبوا",6,"ب",3,0],["إِذا مَنكِبٌ مِن بَطنِ فَلجٍ حَبا لَها","طَوَت غَولَهُ عَنها وَأَسرَعَتِ النَقلا",7,"ل",2,0],["إِذا مَنعَ الأَملاكُ نائِلَهُمْ سخا","وإنْ أخْطَؤوا وجهَ الصّوابِ أصابا",8,"ب",2,0],["إِذَا مُنَيتْ عَلياءُ مصْرَ بفَرْقَد","تَغَيَّبَ عَنْهَا أَطْلَعَ اللهُ فَرْقَدَا",9,"د",2,0],["إِذا مَنَعوا مُقلَتي أَن تَرا","كَ فَقَلبي يَراكَ وَلا يَطرِفُ",10,"ف",1,0],["إذا مَنَعُوا لمْ يُرْج شيءٌ وَرَاءهُمْ،","وَإنْ لَقِحتْ حرْبٌ يجيئوا فَيرْكبوا",11,"ب",3,0],["إذا منّ من تهوى عليك بنظرةٍ","من العين تلقى عندها جنّةَ المأوى",12,"ا",3,1],["إذ أمِنّا ساحةَ الواشي بنا","حيثُ لَمْ نَشْرَبْ سوى ريقك خمرا",13,"ر",2,0],["إذا منع اللئيم ندى يديهِ","أبى إلاَّ انصباباً وانسكابا",14,"ب",2,0],["إذا منعتْكَ أشجارُ المَعالي","حَباها الغضَّ فاقنعْ بالهَشيمِ",15,"م",1,0],["إذا منذ خلق الله دنيانا إلى","ذا اليوم لم تتواجه الاختان",16,"ن",1,0],["إذا مَنَّ أعطَى حلمَه متبيِّناً","وإن همَّ أعطَى أمرَه متعجِّلا",17,"ل",2,0],["إذا مِن مواضيهِم نجا قلبُ زائِرٍ","فمن بيضِهِمْ تُرْديهِ سُودٌ بواتِرُ",18,"ر",1,0],["اذا منحتهُ الشمسُ نورَ شعاعها","أراكَ يواقيتاً يظللّها تبرُ",19,"ر",1,0],["إذا منح الفضلَ أهلُ الرجا","به افتضح العارض المسبلُ",20,"ل",1,0],["إِذا منع الوجدُ أفواهَنا","كلاماً جَعلنا الدموعَ كلاما",21,"م",2,0],["إذا منعت وصل الحبيب وشاتنا","وطول الجفا مع أنه من صفاته",22,"ه",1,1],["إذا من اللفظ ذو موانق وزنا","ومن اللفظ بالصواع مكيل",23,"ل",1,0],["إذا منّ لي طيفُ الخيال بزورة","نهاهُ سُهادُ الليل زجرا عن القرب",24,"ب",1,0],["إذا منع الواشي على كلامها","فما منع الاحشاء ان تتكلما",25,"م",2,0],["إذاً منحتكما منّي مهذبة","حذواً على حذوِ ما واليتُ من حسنِ",26,"ن",1,0],["اِذا منة قَطعت الرأس حَذفاً","نَراهُ نامَ في اهنى مَنام",27,"م",1,0],["إذا منّت الدنيا عليه أجابها","بلعنة موتور وعولة مترب",28,"ب",1,0],["إِذا مِنهُ عَجز عَن مُجاراة خاله","فَمال إِلى الأَديان عَمداً تَهورا",29,"ر",2,0],["إذا منعوني الوصل منهم فانني","رضيت بضيف الطيف يوما مسلما",30,"م",2,0],["إذا منه أنست غريب حسن","أتاك بغيره حسناً غريبا",31,"ب",2,0],["إذا منصلٌ بالغتمُ في صقاله","فما هو إلا المشرفي المجرب",32,"ب",1,0],["إِذا مَنَحتَ الخَوفَ أَسبَابَهُ","فَلا تَقُل يا رَبِّ أَين الأَمَانْ",33,"ن",1,0],["اذاً من هُوَ الجانيْ الحَقِيْقِيْ ومن تُرَى؟","إذا لم يكنْ مِنْ بينِ مَنْ قد تَّقدَّمَا",34,"م",2,0],["إذَا مَنَحَتْ شَيًّا أَتَتْهُ تَسَلُّقًا","فَتَسْلُِبَهُ قَهْرًا فجَدوَاهُ مَخلُوجُ",35,"ج",1,0],["إذا من هبّ نسناس الصّبيحهْ","لفا من صوب ريّان الشّبابي",36,"ب",2,0],["إذا منها حظيتُ ببعضِ وصلٍ","فما لي بعدَ لُقياها مَرامُ",37,"م",1,0],["إذا مُنعتْ صلاةٌ في المساجدْ","وغابَ عن الجماعةِ كل ساجدْ",38,"د",1,1],["إِذَا منَّ ربّي بفضلٍ جميلٍ","رأَيتَ لِشوكِ الحسودِ رؤوسَا",39,"س",2,0],["إذا منع الباب المعالج قفله","فمن ألف جلد ما يصح أديم",40,"م",1,0],["إذا منحَ الغربُ لي المدنيَّ","ة سمُّوا عراها بسُمِّ الشرورْ",41,"ر",1,0]]}