{"poems":[[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[38,"عفت بعدنا أجراع بكر فتولب","https://www.aldiwan.net/poem7688.html","الطويل"],[85,"أنلني يدا خلقت للقبل","https://www.aldiwan.net/poem7351.html","المتقارب"],[43,"فراق ومن فارقت غير مذمم","https://www.aldiwan.net/poem10570.html","الطويل"],[28,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[28,"وأغيد من من النعاس بعظمه","https://www.aldiwan.net/poem5445.html","الطويل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9336","المتقارب"],[28,"ألم يك جهلا بعد سبعين حجة","https://www.poetsgate.com/ViewPoem.aspx?id=21316",""],[260,"إذا من من تهوى عليك بنظرة","https://www.aldiwan.net/poem35510.html","الطويل"],[417,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[417,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[433,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[444,"لله رب العرش والأكوان","https://www.aldiwan.net/poem56035.html","عموديه"],[459,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[515,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"]],"verses":[["إِذا مَنزِلٌ آنَ تَعريسُهُ","طَواهُ عَلى الأَينِ ظُعّانُهُ",0,"ن",2,0],["إِذا مَنزِلٌ رابَ سُكّانَهُ","مِنَ الأَرضِ حُرِّمَ إيطانُهُ",0,"ن",2,0],["إِذا مَنَحتَ العَوالي كَفَّ مُستَلِبٍ","أَقطَعتَ بَذلَ العَطايا كَفَّ مَسلوبِ",1,"ب",1,0],["إذا مَنَّ لم يَمْنُنْ بِمَنٍّ يَمُنُّه","وقال لنفسي أيُّها الناسُ أمْهَدُ",2,"د",1,0],["إِذا مَنَعوا لَم يُرجَ شَيءٌ وَراءَهُم","وَإِن رَكِبَت حَربٌ بِهِم كُلَّ مَركَبِ",3,"ب",1,0],["إذا منعت فضلها سابق","وإن منحت فضلها لم يزل",4,"ل",1,0],["إِذا مَنَعَت مِنكَ السِياسَةُ نَفسَها","فَقِف وَقفَةً قُدّامَهُ تَتَعَلَّمِ",5,"م",1,0],["إِذا مَنَعوا لَم يُرجَ شَيءٌ وَراءَهُم","وَإِن لَقِحَت حَربٌ يَجيؤوا فَيَركَبوا",6,"ب",3,0],["إِذا مَنكِبٌ مِن بَطنِ فَلجٍ حَبا لَها","طَوَت غَولَهُ عَنها وَأَسرَعَتِ النَقلا",7,"ل",2,0],["إِذا مَنعَ الأَملاكُ نائِلَهُمْ سخا","وإنْ أخْطَؤوا وجهَ الصّوابِ أصابا",8,"ب",2,0],["إِذَا مُنَيتْ عَلياءُ مصْرَ بفَرْقَد","تَغَيَّبَ عَنْهَا أَطْلَعَ اللهُ فَرْقَدَا",9,"د",2,0],["إِذا مَنَعوا مُقلَتي أَن تَرا","كَ فَقَلبي يَراكَ وَلا يَطرِفُ",10,"ف",1,0],["إذا مَنَعُوا لمْ يُرْج شيءٌ وَرَاءهُمْ،","وَإنْ لَقِحتْ حرْبٌ يجيئوا فَيرْكبوا",11,"ب",3,0],["إذا منّ من تهوى عليك بنظرةٍ","من العين تلقى عندها جنّةَ المأوى",12,"ا",3,1],["إذ أمِنّا ساحةَ الواشي بنا","حيثُ لَمْ نَشْرَبْ سوى ريقك خمرا",13,"ر",2,0],["إذا منع اللئيم ندى يديهِ","أبى إلاَّ انصباباً وانسكابا",14,"ب",2,0],["إذا منعتْكَ أشجارُ المَعالي","حَباها الغضَّ فاقنعْ بالهَشيمِ",15,"م",1,0],["إذا منذ خلق الله دنيانا إلى","ذا اليوم لم تتواجه الاختان",16,"ن",1,0],["إذا مَنَّ أعطَى حلمَه متبيِّناً","وإن همَّ أعطَى أمرَه متعجِّلا",17,"ل",2,0],["إذا مِن مواضيهِم نجا قلبُ زائِرٍ","فمن بيضِهِمْ تُرْديهِ سُودٌ بواتِرُ",18,"ر",1,0]]}