{"poems":[[55,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[65,"تراءت لنا والبدر وهنا على قدر","https://www.aldiwan.net/poem46189.html","الطويل"],[53,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[52,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[92,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[202,"رمى أدمعي نص الركائب والوخد","https://www.aldiwan.net/poem51956.html","الطويل"],[202,"ولست باحيا من رجال رأَيتهم","https://www.aldiwan.net/poem52005.html","الطويل"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[309,"أبو بكر سر في طريق الله رب العباد","https://www.aldiwan.net/poem16905.html","عموديه"],[415,"لا زلت يا ملك الإسلام في نعم","https://www.aldiwan.net/poem31697.html","عموديه"],[463,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[463,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[521,"لعمري على فوت لاية نظرة","https://www.aldiwan.net/poem48604.html","الطويل"],[521,"ايقظان ام هب الفؤاد لطائف","https://www.aldiwan.net/poem48606.html","الطويل"],[558,"قطعت قتول قرينة الحبل","https://www.aldiwan.net/poem68394.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48558","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203765","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69318","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109420","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105024","الطويل"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27108","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60823","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137241",""],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84849","المتقارب"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3108,"","https://poetry.dctabudhabi.ae/diwan/poem/146676","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89057","المتقارب"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85265","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119621","الوافر"],[4068,"","https://poetry.dctabudhabi.ae/diwan/poem/206111","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90880","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133100","البسيط"],[5277,"مطرٌ.. ولاتَ سحاب","https://www.poetsgate.com/ViewPoem.aspx?id=201052",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5538,"أشم النسيم بوقت الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=142639",""],[4455,"أرى أُمةً شهرت سيفها","https://www.poetsgate.com/ViewPoem.aspx?id=82300",""],[5897,"عروس الحسن ..غادة","https://www.poetsgate.com/ViewPoem.aspx?id=156854",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""]],"verses":[["بِنَجاءِ صامِتَةِ البُغامِ كَأَنَّها","وَالآلُ يَركُضُ في الفَلاةِ فَنيقُ",0,"ق",1,0],["بنَجلاءَ تَشكو سُقْمَها وهْوَ صِحّةٌ","إذا نَظَرَتْ لا تَسْتَقِلُّ منِ الفَتْرِ",1,"ر",1,0],["بنَجم رَأْيك تُجْلَى كُلُّ داجيةٍ","يُبَلَّدُ النجْمُ فيها كُلَّ تَبْلِيدِ",2,"د",1,0],["بِنَجدَتِنا أَلقَت بِنَجدٍ بَعاعَها","سَحابُ المَنايا وَهيَ مُظلِمَةً كُدرُ",3,"ر",1,0],["بِنَجاءِ مُنسَرِحِ اليَدَينِ تَخالُهُ","عِندَ الكَلالِ يُزادُ في إِلهابِهِ",4,"ب",2,0],["بنجمينِ كانت تباهي السما","وما في السما من نجومٍ كُثُر",5,"ر",1,0],["بنجدٍ أناخوا العيسَ بعد تهامةٍ","ويا بُعْدَ ما بيني وبينك يا نجد",6,"د",1,0],["بنجران اوصال النجاشي اصبحت","تَلوذُ به طيرٌ عكوف ووقّع",7,"ع",1,0],["بنجله الكمال عمدتي الّذي","أنشقني من رشده العرفَ الشذي",8,"ي",1,0],["بنجمتِهِ الزهراءِ في اليأسِ نهتَدي","وقد زيّنت ما بالدِّماء تحمّرا",9,"ر",2,0],["بنجو من الشر في الدنيا ويوم التناد","من كل زاده من التقوى حوى خير زاد",10,"د",1,0],["بنجوة من صروف الدهر يقصر عن","منالها المفسدان الخطب والغبر",11,"ر",1,0],["بنَجوةٍ عن القذى يحوطها","حساً أصابَ مسِرقا على الفَنَنْ",12,"ن",1,0],["بنجدٍ ونجدٌ دارُ جودٍ وذمّةٍ","مطالٌ بلا عُسرٍ ومطلٌ بلا عُذْرِ",13,"ر",1,0],["بِنَجد تَروم الغَورَ بِالطَرفِ هَل تَرى","بِهِ الغور ما لاءَمت من مُتَلائِم",14,"م",1,0],["بِنَجد وَما كانَت بِعَهدي رَجيلَة","وَلا ذات فِكر في سَرى اللَيلِ فاطِمَه",15,"م",2,0],["بِنَجاءِ ناجِيَةٍ يَسورُ بِها","هادي النَجيبِ وَهامَةُ الفَحلِ",16,"ل",1,0],["بنجدهم أم في تهامة إن بي","إليهم لشوقاً أفعم القلب كاويا",17,"ي",2,0],["بنُجلٍ كأَعناق المها العِين اتلعت","لطافِ المتونِ لَذَّةِ المتأَملِ",18,"ل",1,0],["بنجح لا إله إلا اللّه","ونجح أسمائك عجل المدد",19,"د",1,0],["بنجل الامام الكريم الذي","بنى معلم المجد حتى استقل",20,"ل",1,0],["بِنَجائِبٍ جَدَلَ الوَجيفُ مُتونَها","في البيدِ مِن نَسلِ الجَديلِ وَشَدقَمِ",21,"م",1,0],["بنجله الحسن المسعود طالعه","هنأته وهناءُ الأكرمين غنى",22,"ن",2,0],["بنجدٍ ونجد دار جود وذمة","مطال بلا عسر وبخل بلا عذر",23,"ر",1,0],["بِنَجرانَ يَقري الهَمَّ كُلَّ غَريبَةٍ","بَعيدَةِ شَأوُ الكَلمِ باقِيَةِ الأَثَرِ",24,"ر",1,0],["بنجائبٍ قد صَار غَايةُ قصدها","وقصيدِها في ابن الرهيب محمد",25,"د",1,0],["بنجاتها سرت وبرء قرينها","فيه لها الاقبال والاسعاد",26,"د",1,0],["بِنَجل سَعيد بِكم","يَهني جَميع المَلا",27,"ل",2,0],["بنجلِه عبدُ شمسٍ فَاقَ هاشِمَهُ","لَو لم يَكُن نجلُهُ المُختارُ مِن مُضَرَا",28,"ر",2,0],["بنجد وغور والعذيب وبارق","هواي تجزى والفؤاد تقسما",29,"م",2,0],["بنجل نجيبٍ ونسل زكا","سليل المعالي وبيت القصيد",30,"د",1,0],["بنجد حتى المال الجزيل تبرعاً","فعاشت به أيتامه وأرامله",31,"ل",2,0],["بنَجرٍ زاهرٍ زاهى","أنار بنوره الحلك",32,"ك",1,0],["بنجدية وحرورية","وأزرق يدعو إلى أزرقي",33,"ي",1,0],["بنجله المصطفى حق الهناء له","مذ حاز جوهرة من أنفس الدرر",34,"ر",1,0],["بنجدة لو سطت بي الأسد لم أظم","إني أريد طروق الحي من إضم",35,"م",1,0],["بِنَجلِهِم بل نَجمِهِم بَل بَدرِهِم","بَل شَمسِهم ذاتِ السَّنَاءِ والسَّنَا",36,"ا",1,0],["بنجله والملاذ القطب عمدتنا","مقدم القوم جدي فخر الأمجاد",37,"د",1,0],["بنجمٍ عبقريِّ الضوءِ..ليلي","ينازعني على ضوءِ الشموعِ",38,"ع",1,0],["بنجدٍ أقام الدين بعد انطماسه","ومن قبلهم والشر قد عم باطله",39,"ل",2,0],["بنجيع مفرقه تضمخ فوقه","برد يفوقه حيا وعفاف",40,"ف",1,0],["بنجد فؤادي دواماً مقيم","ودمعي كثير وجسمي نحيل",41,"ل",1,0],["بنَجديَّةٍ وحَرُريَّةٍ","وأزرق يدعو إلى أزرقي",42,"ي",1,0],["بنجم السعد لما نحو","أفلاك الرضا قادَهْ",43,"د",2,0],["بنجمه ببدره بشمسه","بأصله المقبوض من قبل الفطر",44,"ر",1,0],["بِنْ جُورِيونَ ووِايزْمانُ قَدْ بَنَيَاْ","إشكولُ مائيرُ بيجنْ أَعْلَوُا الجُدُراْ",45,"ر",2,0]]}