{"poems":[[57,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[95,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[85,"واليت ما أوليت يا بحر الندى","https://www.aldiwan.net/poem54311.html","الكامل"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[230,"إن ما بت تشتكي منه داء","https://www.aldiwan.net/poem55207.html","الخفيف"],[264,"ولا تطمعن من الصديق مودة","https://www.aldiwan.net/poem35518.html","الكامل"],[382,"أمسى الغبي من الصلاح عقيما","https://www.aldiwan.net/poem59248.html","الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[466,"لا ثل عرشكم بني أسد","https://www.aldiwan.net/poem15170.html","أحذ الكامل"],[484,"رقص الدهر بقومي","https://www.aldiwan.net/poem37172.html","مجزوء الرمل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112473","المديد"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/205188","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133819","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133781","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133790","الكامل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130250","الكامل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21665","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48943","الكامل"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104127","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27490","الكامل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32621","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87376","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87372","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91677","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91426","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132161","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81719","الكامل"],[4119,"إني لأغنى الناس عن عصبية","https://www.poetsgate.com/ViewPoem.aspx?id=16088",""],[3271,"شعر","https://www.poetsgate.com/ViewPoem.aspx?id=104124",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5296,"أماه لا تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=152482",""],[5296,"زعموا","https://www.poetsgate.com/ViewPoem.aspx?id=155330",""],[5660,"قَلَمي مِدادُكَ يَنتَهي","https://www.poetsgate.com/ViewPoem.aspx?id=23787",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[1706,"في بطحاء مكة","https://www.poetsgate.com/ViewPoem.aspx?id=102862",""]],"verses":[["فَإِذا يُنادى بِاِسمِها","ظَلَّت مَدامِعُه تَرَقرَق",0,"ق",1,0],["فَإذَا يَافِعٌ يَبُزُّ شُيُوخاً","فِي التَّجَارِيبِ أفْنَوُا الأيَّامَا",1,"م",2,0],["فإذا يهز لها اللسان حُسامَه","فصفاتُ فخرك قد قضت بنفاذِهِ",2,"ذ",2,0],["فَإِذا يَجوعُ بِظِلِّ عَرشِكَ لَيلَةً","فَهُوَ الَّذي بِيَدَيهِ يُحَطِّمُهُ",3,"ه",1,0],["فَإِذا يُذكَر البَيانُ فَأَذعِن","لا تَقُل نحن في البَيان سَواء",4,"ا",2,0],["فإذا يكون له الوفا لا سيّما","عند المضيق بيان كلّ صديق",5,"ق",1,0],["فإذا يُصِبْهُ الخير كان لئيما","وإذا يُصبْه الشرُّ كان أليما",6,"م",2,0],["فإذا يدي لم تَعتلِقْ","بسوى المنىَ أظفارُها",7,"ر",3,0],["فإذا يُضيعُ المالَ جودُكمُ","فالحفظُ حيث الجارِ والذممُ",8,"م",1,0],["فإذا يبدو صواب","يتولاكم نشوز",9,"ز",1,0],["فإذا يدعى لمكرمة","أو لغشيان الوغى وثبا",10,"ب",2,0],["فإِذا يذكروا مع اسمي مضيفاً","قيل: مرعى وليس كالسعدان",11,"ن",1,0],["فإذا يطلبان قوتا عصى","القوت ولو دانياً وشتّ وبانا",12,"ن",2,0],["فإذا يجئ وأنت","تمنعني الهناء فمن يغني",13,"ن",2,0],["فإذا يكر غنا الهزا","رِ أحسه بغنا الهزار",14,"ر",1,0],["فإذا يَقُوم خطيبُ قومٍ منهُمُ","يُثْنىِ بمكرُمَةٍ أقول لَهُ اعدُدِ",15,"د",1,0],["فَإِذا يَمُرُّ لَها حَبِيُّ زاخِرٌ","بِالدارِ جادَ بِوَبلِهِ فَأَسالَها",16,"ل",3,0],["فإذا يَكرُّ فلا يشقُّ غُبارُه","وإذا يَفِرُّ فعدُوه لا يُلحَق",17,"ق",1,0],["فإذا يسرك يوم مغبطةٍ","فلقد يجيء بما كرهت غد",18,"د",1,0],["فإذا يسطره اللبيبُ بكشفِه","أو فكره ليلذ بالأسماع",19,"ع",1,0],["فإذا يكون أميرنا ووزيرنا","وأنا فجئ بالرابع الشيطان",20,"ن",1,0],["فاذا يُمرَّ فَتىً هناك يَعج بها","يَتلو عليك تحيَّةَ الإِخوانِ",21,"ن",1,0],["فاذا يهبُّ نسيمُ روضٍ عاطراً","فَهناك طيب ثنائِهِ لا نشرُهُ",22,"ر",2,0],["فَإِذا يئستُ غَدَوتُ طعمةَ ذرّةٍ","وَإِذا رَجَوتُ علوتُ قِمةَ شامخ",23,"خ",1,0],["فإِذا يواصل كنتُ لا","أَهوى بِهِ إِلا الهَنا",24,"ن",2,0],["فإذا يفح زهر الضريح بطيبهِ","فلأن أصل الزهر مسّ فؤادها",25,"د",3,0],["فإذا يفارقُ دار منشأه امرؤٌ","فله إلى دارِ المَعَادِ تنقل",26,"ل",1,0],["فإذا يقاس بخيل قيس خيله","عدت معد وأعربت عن يعرب",27,"ب",1,0],["فإذا يرقّ حسبته قمريّةً","قد هاج أحلام الضحى تصداحُها",28,"ح",3,0],["فإذا يجنّ لمصر تحسبه الصبا","في فجرها فوق الخمائل تخطرُ",29,"ر",1,0],["فإذا يَجِدُّ الجَدُ كُنْ أهلاً لهُ","والزِمْ عَدُوَّكَ في مقابرهِ اعتكافْ",30,"ف",1,0],["فإذا يَجُدُّ الجَدُّ تلقى بعضهمْ","حرقوا البريدَ ، قضوا على الإثباتِ",31,"ت",1,0],["فَإِذا يَجودُ بِهِ عَلى","قَلبِ الأَحِبَةِ لَرتَوى",32,"و",2,0],["فإذا يعطف الصحب الجوافي","على المنكوب والباكي الحزين",33,"ن",1,0],["فَإذا يَقَظتُ فَبِالفُؤادِ مُقيمَةٌ","وإذا هَجَعتُ فإنَّني أَلقاكِ",34,"ك",1,0],["فإذا يثربُ الحفيَّة دارٌ","وإذا النصر عندها والولاء",35,"ا",2,0]]}