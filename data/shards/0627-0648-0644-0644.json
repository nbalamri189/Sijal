{"poems":[[79,"يمضي الزمان وكل فان ذاهب","https://www.aldiwan.net/poem35916.html","الكامل"],[85,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[85,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[87,"صداح يا ملك الكنار","https://www.aldiwan.net/poem63754.html","مجزوء الكامل"],[107,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19641","الكامل"],[203,"هدم الأنام وجئت انت تشيد","https://www.aldiwan.net/poem45155.html","الكامل"],[384,"قد علمت خود بساقيها الغفر","https://www.aldiwan.net/poem4547.html","الرجز"],[463,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[466,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[572,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[592,"تأجج الوجد في الأحشا واضطربا","https://www.aldiwan.net/poem11556.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138245",""],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137869",""],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98588","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204849","السريع"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133952","الرجز"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110847","المجتث"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68025","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102733","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72857","الكامل"],[4929,"عروبة الزمن الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=215675",""],[5273,"أضغاث معنى","https://www.poetsgate.com/ViewPoem.aspx?id=192312",""],[5770,"سأزف للموتى بشارة","https://www.poetsgate.com/ViewPoem.aspx?id=178250",""],[5897,"غداً القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=160569",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6127,"وطن الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=189444",""]],"verses":[["أو للرّشيدِ وللأمِينِ وصِنْوِهِ","لوْلا شَباةُ يَراعَةِ الوَرّاقِ",0,"ق",1,0],["أو للرياض إل احتفل","وللبلابل فيه تصيح",1,"ح",1,0],["أو للرياح تهبُّ وهي بليلةٌ","فتهيجُ من وجدي ونم بَلْبالي",2,"ل",2,0],["أَو لِلغَبِيِّ وَإِن تَعَل","لَلَ بِالزَمانِ المُقبِلِ",3,"ل",1,0],["أَوَّلٌ لَيْسَ لَهُ مِن آخِرِ","يَرْمُقُ الدُّنيا بِعَيْنَيْ ساخِرِ",4,"ر",1,0],["أو للغبي وإن تع","لل بالزمان المقبل",5,"ل",1,0],["أو للمطامع في الضعاف تنالها","فتذلهم وتقول عيشوا وارغدوا",6,"د",3,0],["أول لأروحن أصلاً لا أئتزر","حتى إذا ما اشتد لوبان النجر",7,"ر",1,0],["أو للتسرع في قناتي مغمَزٌ","من بعد ما أطَرَ القناةَ ثِقافُ",8,"ف",1,0],["أُول للركب يجتاحون شاحطةً","يهْماءَ تعسفُ بالظِّلمان والعُفُر",9,"ر",1,0],["أو للنُجومِ يُباعُ حُسنُ بَيانِه","أعطَتْ دَراريها بُدورَ بِناتِهِ",10,"ت",2,0],["أوْ للنّصَارى قدسو","ها ثُمّ سَمَّوْهَا مَسيحَهْ",11,"ح",2,0],["او للثنائي عن الأحباب منصرم","والحزن للقلب بالأوصاب قد دهما",12,"م",2,0],["أو للفوائد قد شعرت بحاجة","الفيت ينبوعا يفيض فوائدا",13,"د",2,0],["أو للذين نواظري اكتحلت برؤ","يتهم فكانت للنواظر أثمدا",14,"د",2,0],["او للنفس شموس فأنى","والهوى يثني اليه النفوسا",15,"س",2,0],["او للمسامع بعد اليوم من طرب","يوما وقد غاب من قد يسمع السمرا",16,"ر",2,0],["أو للصبوح إذا تغنّى بلبلٌ","بصبوحه بتراجع الأنفاس",17,"س",1,0],["أو للتسلى أو لتنبيه الفطن","لخسة الدنيا فيا بئس الوطن",18,"ن",1,0],["أول لفظ مرّ في مسمعي","أريد أن يبقى الى الآخر",19,"ر",1,0],["أو للمكان نحو روض مقتضب","كذاك للمفعول تأتي والسبب",20,"ب",1,0],["أو للنساء جمال","إلا وفيها عمائم",21,"م",1,0],["أو للشفا يَدُعُّني","موكَّلٌ بالحَطَم",22,"م",1,0],["أو للغيد أرى نهجاً سوا","والصبا قد عريت أفراسه",23,"ه",1,0],["أو للهو تريدنى وجدتنى","لوحاها مبادرا بوحائى",24,"ا",2,0],["أو للتي إن لاح بارق ثغرها","في الليل أغناها عن المصباح",25,"ح",1,0],["أو للدراري شامَها أو شاءَها","طلعت عليه بطالع أو راغبِ",26,"ب",1,0],["أو للعروبةِ في مَن باعَ مقدسَها","برءٌ لجرحٍ ولا ردٌّ لمُغتصَبِ",27,"ب",1,0],["أوِّلْ ليَ الرّؤيا فسجني ملّني","علّي سأسقي الخَمْرَ رَبّي أنهُرا.",28,"ر",2,0],["أو للذين تدافعوا من كل زاويةٍ وحارة","لما رأوا هذا اللهيب الضخم تشعله شرارة",29,"ر",2,0],["أوَ للإله وقفت يا صنو الثرى","متصدياً تنأى بك الأقوالُ",30,"ل",1,0],["أَوَ لِلبيضِ عن سَنَاهُنَّ أوْما","كان نَاشٍ عن صَدِّهنَّ صُدودُ",31,"د",1,0],["أو للممات يسير الركب ممتطياً","ظهر المنايا بلا خوف ولا كفن",32,"ن",1,0]]}