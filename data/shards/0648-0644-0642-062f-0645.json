{"poems":[[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"ولقد مررت على ديارهم","https://www.aldiwan.net/poem30714.html","الكامل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[72,"لم يبق شيبي لذة لحياتي","https://www.aldiwan.net/poem18400.html","الكامل"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[51,"اشرب على ذكر الأحبة إنهم","https://www.aldiwan.net/poem65774.html","الوافر"],[51,"ولقد منعت من المرافق كلها","https://www.aldiwan.net/poem66068.html","الطويل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[38,"طال العشاء ونحن بالهضب","https://www.aldiwan.net/poem7686.html","الكامل"],[89,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[89,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[89,"جاء غضبان بادي الازباد","https://www.aldiwan.net/poem44916.html","الخفيف"],[85,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[43,"ألئال إبراهيم بعد محمد","https://www.aldiwan.net/poem9575.html","الكامل"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[28,"من يأت عواما ويشرب عنده","https://www.aldiwan.net/poem5300.html","الكامل"],[61,"ولقد مررت على المحدث مرة","https://www.aldiwan.net/poem51568.html","الكامل"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[49,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[49,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[97,"هل تأمرين فأفتدي وأقيك","https://www.aldiwan.net/poem24413.html","الكامل"],[31,"هل أنت إن بكر الأحبة غادي","https://www.aldiwan.net/poem42584.html","الكامل"],[52,"يا غزال الوادي بنفسي أنتا","https://www.aldiwan.net/poem27216.html","الخفيف"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[75,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[50,"كثر الحمير وقد أرى في صحبتي","https://www.aldiwan.net/poem64800.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39542","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[18,"لو كان ناه لابن حية زاجراً","https://www.poetsgate.com/ViewPoem.aspx?id=34727",""],[28,"مَنْ يأتِ عَوّاماً وَيَشْرَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=2507",""],[53,"اترى السحاب اذا سرت عشراؤه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9808&r=&rc=5",""],[138,"ولقد مررت بنسوة أعشينني","https://www.aldiwan.net/poem68037.html","الكامل"],[143,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[151,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[170,"ما شئتما يا صاحبي فقولا","https://www.aldiwan.net/poem1656.html",""],[183,"ناحت بنو الخوري الكرام تأسفا","https://www.aldiwan.net/poem61064.html","الكامل"],[183,"هذا النطاسي الذي من بعده","https://www.aldiwan.net/poem61072.html","الكامل"],[183,"ناحت بني العبسي مصرع راحل","https://www.aldiwan.net/poem61081.html","الكامل"],[183,"فقدت بنو تقلا عزيزا قد مضى","https://www.aldiwan.net/poem61112.html","الكامل"],[183,"من آل فياض عزيز ماجد","https://www.aldiwan.net/poem61152.html","البسيط"],[183,"في اللحد من آل الشهاب أميرة","https://www.aldiwan.net/poem61162.html","الكامل"],[183,"رمس لهيفا من بني الشدياق قد","https://www.aldiwan.net/poem61166.html","الكامل"],[183,"من آل صافي الأكرمين فقيدة","https://www.aldiwan.net/poem61196.html","الكامل"],[183,"لبني مهنا بعد مصرع فارس","https://www.aldiwan.net/poem66944.html","الكامل"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[198,"يا جارة الوادي طربت وعادني","https://www.aldiwan.net/poem39810.html","الكامل"],[199,"ذرني ونجدا لا حملت نجادي","https://www.aldiwan.net/poem51954.html","الكامل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[236,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[236,"ولقد مدحتك يا ابن نصر مدحة","https://www.aldiwan.net/poem31771.html","الكامل"],[236,"ولقد مدحتكم على جهل بكم","https://www.aldiwan.net/poem31887.html","الكامل"],[262,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[271,"دمعي على حبيك في الشعر","https://www.aldiwan.net/poem35391.html","أحذ الكامل"],[281,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[291,"نزح الرقيب وغارد اللاحي","https://www.aldiwan.net/poem11674.html","الكامل"],[365,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[367,"ولقد مررت بدار من أحببته","https://www.aldiwan.net/poem17028.html","الكامل"],[367,"لم يبق بعدكم دموع","https://www.aldiwan.net/poem17225.html","مجزوء الكامل"],[372,"بينته يهوى الطيور ويو","https://www.aldiwan.net/poem57209.html","أحذ الكامل"],[378,"وقبيلة جهلاؤها عقلاؤها","https://www.aldiwan.net/poem66981.html","الكامل"],[404,"نظم أرق من الرحيق السلسل","https://www.aldiwan.net/poem33480.html","الكامل"],[407,"قسما بوصلك إن بعد مرامه","https://www.aldiwan.net/poem50114.html","الكامل"],[417,"كم قد ألين لمن قسا بصدوده","https://www.aldiwan.net/poem53923.html","الكامل"],[417,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[417,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[440,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[459,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[462,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[465,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[465,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[465,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[496,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[512,"لو كنت في ريمان لست ببارح","https://www.aldiwan.net/poem20953.html","الكامل"],[552,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[563,"كلفت حمل تحيتي ريح الصبا","https://www.aldiwan.net/poem52966.html","الكامل"],[576,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[576,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"]],"verses":[["وَلَقَد مَرَرتُ عَلى الدِيارِ فَعَزَّني","جَلَدي وَكانَ أَعَزَّ مِنهُ تَجَلُّدي",0,"د",2,0],["وَلَقَد مَرَرتُ عَلى دِيارِهِمُ","وَطُلولُها بِيَدِ البِلى نَهبُ",1,"ب",1,1],["وَلَقَد مَلَأتَ عَلى عَدوُّكَ جِلدَهُ","حَتّى طَمى جِزعٌ وَضاقَ مَذاهِبُ",2,"ب",1,0],["وَلَقَد مَرَرتُ بِبَرزَخٍ فَسَأَلتُهُ","أَينَ الأُلى ضَمَّتهُمُ أَرجاؤُهُ",3,"ا",3,0],["ولقد محا قاضي القضاةِ وتاجهم","عني مصاب الحسن والحسنات",4,"ت",1,0],["ولقد مانوا وقالوا باطلاً","غير أن السهم قد ناغى الهدف",5,"ف",1,0],["ولقد ملأتَ يديهِمُ بِكَ غِبطةً","ولقد ملأتَ بهم كذاك يديكا",6,"ك",2,0],["ولقد مُنعتُ من المرافق كُلِّها","حتى مُنعتُ مرافقَ الأحلامِ",7,"م",1,1],["وَلَقَد مَنَنتَ عَلى رَبيعَةَ كُلِّها","وَكَفَيتَ كُلَّ مُواكِلٍ خَذّالِ",8,"ل",1,0],["وَلَقَد مَطَوتُ إِلَيكَ مِن بَلَدٍ","نائي المَزارَ بِأَينُقٍ حُدبِ",9,"ب",1,0],["ولقد مضى عصى البكى","بين الدخول فحومل",10,"ل",1,0],["ولقد مررت على الريا","ض فلم اجد فيهن وردا",11,"د",2,0],["ولقد مضى لي عندها","عيش وكان العيش رغدا",11,"د",2,0],["ولقد مدته على ما اتاه","كثرة للثلوج في الاطواد",12,"د",1,0],["ولقد مررتُ على الرياض برَبْوَةٍ","غَنَّاءَ كنتُ حِيالَها أَلقاكِ",13,"ك",1,0],["وَلَقَد مَنَحتُ أَبا الحُسَينِ مَوَدَّةً","جودي بِها لِعَدُوِّهِ تَبذيرُ",14,"ر",1,0],["وَلَقَد مَنَعتَ الدارَ إِعلانَ الهَوى","وَطَويتَ عَنها سِرَّكَ المَكتوما",15,"م",2,0],["وَلَقَد مَرَرتُ بِبابِهِم فَرَأَيتُهُم","صَرعى وَفيهِم قائِماً يَتَتَعتَعُ",16,"ع",1,0],["ولقد مَرَرْتُ على المحدِّثِ مَرَّةً","وإذا بحَضرَتِه ظِباءٌ رُتَّعُ",17,"ع",1,1],["وَلَقَد مَرَرتُ عَلى القُبورِ فَما","مَيَّزتُ بَينَ العَبدِ وَالمَولى",18,"ا",1,0],["وَلَقَد مَضى القَرنُ الَّذينَ عَهَدتَهُم","لِسَبيلِهِم وَلَتَلحَقَنَّ بِمَن مَضى",19,"ا",1,0],["وَلَقَد مَضى أَبَواكَ عَمّا خَلَّفا","وَلَتَمضِيَنَّ كَما مَضى أَبَواكا",20,"ك",2,0],["ولقد مرضتِ فرحتُ أشقَى ذاكرٍ","يبكي لأجلكِ كلما ذكروكِ",21,"ك",1,0],["وَلَقَد مَنَحتُ الوُدَّ مِنّي لَم يَكُن","مِنكُم إِلَيَّ بِما فَعَلتُ أَيادي",22,"د",2,0],["وَلَقَد مَتَّعتَكَ مِنها بِوَصلٍ","زَمَناً ماضِياً وَكانَت وَكُنتا",23,"ت",2,0],["ولقد مَرَرْتُ على الدّيارِ بمَنْعِجٍ","وبها الذي بي غيرَ أنّي السّائل",24,"ل",1,0],["ولَقِدْماً أخذْتُ من شُكْرِ نُعما","كَ بحظّي فكان أخذي كتَركي",25,"ك",2,0],["وَلَقَد مَشَيتُ عَنِ الحِمارِ تَكَرُّماً","وَالمَشيُ أَكرَمُ مِن رُكوبِ الصاحِبِ",26,"ب",1,0],["وَلَقَد مللت من الحياة ووحدة","أشقى بها في بيتي المهجور",27,"ر",1,0],["ولقد مضى عهدُ التنقل وانتهى","زمني إليكَ بصبوتي وفتوني",28,"ن",2,0],["وَلَقَد مَرَّغتُ في مَصرَعِهِ","وَجَناتي وَاِستَطبتُ المُنتَشَق",29,"ق",1,0],["ولقد مشيت القهقرَى","ومشى الزمانُ إلى الأمام",30,"م",1,0],["ولقد مضى دهرٌ ونحن مكاننا","لا نبتغي في العلم حظاً أكبرا",31,"ر",2,0],["ولقد مضى عنها ابن حية مدبراً","تحت العجاجة والحتوف دوان",32,"ن",1,0],["وَلَقَدْ مَررْتُ بِبابِهِمْ، فَرَأيْتُهُمْ","صَرْعَى... قَائِماً يَتَتَعْتَعُ",33,"ع",1,0],["وَلَقَدْ مَرَرْتُ بِبَرْزَخٍ، فسألتُهُ:","اين الأولى ضمتهم ارجاؤه",34,"ا",3,0],["وَلَقَد مَرَرت بِنِسوَةٍ أَعشَينَني","حورِ المَدامِعِ مِن بَني المِنجابِ",35,"ب",1,1],["ولقد محا الشَّيبُ الشبابَ وما محا","عهدَ الهوى معه ولا أَنسانى",36,"ن",2,0],["ولقد مررت على المنازل بعدهم","فذكرت عهد صبابتي ومجوني",37,"ن",2,0],["وَلَقد مَضَت حُقبٌ بِها وسُراتُها","نَهبٌ فَأَنقَذَ شِلوَها المَأكُولا",38,"ل",2,0],["وَلَقَد مَضى يَبغي جِوارَ إِلهِهِ","عجلاً فَكانَ لَديهِ أَكرَمَ وافدِ",39,"د",1,0],["وَلَقَد مَضى فَثَوى باكرمِ جَنَّةٍ","طابَت فَضَّمَت مِنهُ خَير نَزيلِ",40,"ل",1,0],["وَلَقَد مَضى نَحوَ النَعيمِ مزوَّداً","بِتُقى الإِلهِ وَبِالصَلاحِ مُؤزَّرا",41,"ر",2,0],["وَلَقَد مَضى نَحوَ البَقاءِ فَضَمَّهُ","بِجِوارِ خالقِهِ رِضىً وَنَعيمُ",42,"م",1,0],["وَلَقَد مَضى نَحوَ البَقاءِ مُخَلِّفاً","آثار حَمدٍ بِالمَراحمِ تُذكَرُ",43,"ر",1,0],["وَلَقد مَضَت في إِثرِ شِبلَيها عَلى","عَجلٍ فَحَلَّت في الأَعالي مَنزِلا",44,"ل",2,0],["وَلَقَد مَضَت نَحوَ الإِلَه وَعِندَنا","ما زالَ يقرن بِالثَنا تَذكارَها",45,"ر",3,0],["وَلَقد مَضَت عَنّا لِدارِ سِعادةٍ","سَعِدت بطيبِ نَعيمِها الآمالُ",46,"ل",1,0],["وَلَقَد مَضى نَحوَ النَعيم فَنالَ ما","غَرَسَتهُ أَيدي بَره فيما مَضى",47,"ض",2,0],["وَلَقد منّت بِأوفى برّها","إِذ دَعَتني أدخلُ البيتَ الأمين",48,"ن",1,0],["وَلَقد مرّتِ المَوانعُ لكن","ربَّ مُرٍّ يكون فيه الشفاءُ",49,"ا",2,0],["ولقد مررت على الرياض بربوة","كم راقصت فيها رؤاي رؤاك",50,"ك",1,0],["ولقد مررتُ على الكثيبِ فأرْزَمَتْ","إبلي ورجَّعتِ الصهيلَ جيادي",51,"د",2,0],["وَلَقد مَضى وَعَلى شَعيرٍ دِرعهُ","مَروهونَةٌ لِتَعَذُّرِ الأَثمانِ",52,"ن",1,0],["وَلَقَد مَرَرتُ بِرَبعِها","بَعدَ النَوى وَفِنائِها",53,"ا",3,0],["وَلَقَد مَدَحتُكَ يا اِبنَ نَصرٍ مِدحَةً","ما كُنتَ تَرجو مِثلَها وَتُؤَمِّلُ",54,"ل",1,1],["وَلَقَد مَدَحتُكُمُ عَلى جَهلٍ بِكُم","وَظَنَنتُ فيكُم لِلصَنيعَةِ مَوضِعاً",55,"ع",2,1],["ولقد ملئت تحارباً وتجارباً","لم تلقني إلا إناءً مفعما",56,"م",2,0],["ولقد مشيتِ كما مَشى حَجَلٌ","طاردتُه في غابةِ النهر",57,"ر",1,0],["وَلَقَدْ مَطَلْتُكَ بِالْمَحامِدِ بُرْهَةً","وَلَرُبَّما مَطَلَ الْغَرِيمَ الْمُقْتَضا",58,"ض",2,0],["ولقد محا ذكراك من خلدي","لما غدرت زماننا الماحي",59,"ح",2,0],["ولقد مَنحْتَ النّهرَ منها ساعةً","وذخَرْتَ أُخْرَى يَبْتليها النِّيل",60,"ل",1,0],["وَلَقَد مَرَرتُ بِدارِ مَن أَحبَبتُهُ","لَيسَ الَّتي لِلحُبِّ بَينَ ضُلوعي",61,"ي",1,1],["وَلَقَد مَرَرتُ عَلى الرُبو","عِ وَقَد تَجَلَّلَها الخُشوعُ",62,"ع",1,0],["ولقَد مَرَرتُ بدارِهِ عَبَثاً","فَسَمِعتُ مثلَ كوائِرِ النَّحلِ",63,"ل",1,0],["ولقد مررتُ بِسورها وبِسورها","قلقٌ فعزَّ عليَّ كيفَ لِقاؤُها",64,"ا",3,0],["ولقد مضى زمن الشباب ولم يكن","إلا بزاوية الخمول تسربلي",65,"ل",2,0],["وَلَقَد مَلأتُ يَديَّ من عَفِّ الصِبا","وَعَفَفتُ عَن حُرُماتِِ وَآثامِهِ",66,"م",2,0],["ولقد مدحتُ الماجدينَ فلا أرى","إلاَّ مديحاً مقنعاً ومفيدا",67,"د",2,0],["ولَقَدْ مَلَّتْ يدي من أَخْذِها","منك ما تولي وما كنتَ ملولا",68,"ل",2,0],["ولقد ملأْتَ الكون في نور الهدى","كالشَّمس قد ملأَ الفضا أنوارها",69,"ر",3,0],["ولقد مَلأتَ عليهِ أجوَازَ المَلا","برَوَابِضِ الآسادِ فِي الآجامِ",70,"م",1,0],["ولقد مدحتُ فكنتُ أصدقَ قائلٍ","وفعلتَ أنتَ فكنتَ أكرمَ فاعلِ",71,"ل",1,0],["ولقد مَلَّ مُقامي أسْرتي","جارَ بغدادَ ومثْلي لا يُملْ",72,"ل",1,0],["ولقد منحتك من بناتِ خواطري","غيداً أقلُّ ثوابها أن تمهرا",73,"ر",2,0],["ولقد منعت من السلو وسهله","فمشيتُ في نهج الغرام الأخشنِ",74,"ن",1,0],["ولقد مددتُ إلى السلو يد الأسى","فوجدتُ باعَ الصبرِ عنهُ ضيقاً",75,"ق",2,0],["ولقد منحت من الجزيل وفزت من","حسن الثناء بأنفَس الأعراض",76,"ض",1,0],["وَلقدْ مررْتُ على اللّئيمِ يسبُّني","فمضيْتُ ثُمَّت قُلْتُ لا يعْنينِي",77,"ن",2,0],["ولقد مررتُ على العقيق فشفّني","أنْ لم تغنّ على الغصون حَمامُهُ",78,"م",2,0],["ولقد محا آدابَه وعلومَه","منّا الرّدى بالرّغْمِ مَحْوَ المُهْرَقِ",79,"ق",1,0],["ولَقد مَضّنِي هجومي على الدّا","ر بلا آذنٍ على الدّارِ مضّا",80,"ض",2,0],["ولَقد مرَرتُ على الدِّيارِ فهاجَني","نَظَرٌ أطَلْتُ لهُ الوُقوفَ تَعَجُّبا",81,"ب",2,0],["ولقد مِتُّ مِنْه فاعْجَب لأَمْرِي","إِنَّني مَيِّتٌ وعِشْقي مُعَمَّر",82,"ر",1,0],["ولقد مَدَحْتُ عُلاكَ مِنْ حُبِّي لها","وهْي الَّتي ليست يُلام مُحِبُّها",83,"ب",3,0]]}