{"poems":[[53,"يا مددي حين خانني مددي","https://www.aldiwan.net/poem61907.html","المنسرح"],[94,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142062","البسيط"],[94,"يا ليلُ! ما تصنعُ النفسُ التي سكنتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14580&r=&rc=25",""],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[463,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101776","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137069",""],[3347,"","https://poetry.dctabudhabi.ae/diwan/poem/142288","الرمل"],[4755,"رسالة من تحت النار","https://www.poetsgate.com/ViewPoem.aspx?id=196865",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""],[5830,"وَ حََقّاً إِنَّنِي خَجِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=200773",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""]],"verses":[["قد كَبَتَ الحاسدَ انتصارُك لي","بدْءاً فلا تُشْمتنَّ ذا حسدي",0,"د",2,0],["قَدْ كبَّلَ القَدَرُ الضَّاري فرائِسَهْ","فما استطاعوا له دفعاً ولا حزَروا",1,"ر",3,0],["قد كبروك لأمر صغروك به","قد فخموا الإسم لكن حفروا الذاتا",2,"ت",2,0],["قد كَبَّلَ القدرُ الضّاري فرائسَه","فما استطاعُو له دفْعاً، ولا حَزَروا",3,"ر",3,0],["قد كبا بيننا لوداد فلا قا","م وغص الهوى بماء الهجاء",4,"ا",2,0],["قد كبَّرتْ لك العلا وشكرتْ","نشرَك ذاك الكرَمَ المُرمَّسا",5,"س",2,0],["قد كَبِرْ بِرْ بِبِرْ بِبِرْ","تُ وعقلي إِلى وَرَا",6,"ر",2,0],["قد كبروه وصيروه دولة","شمخت وطاولت الشوامخ طولا",7,"ل",2,0],["قد كبونا، رب مهر جامح","رده في العدو مكر الثعلب",8,"ب",1,0],["قُد كبيرَ البَطنِ مِن فَمِهِ","واضرِبِ الحوثيَّ بالسَّلَفِي",9,"ف",2,0],["قدْ كبّروا الرحمنَ , ما صدقوا","لمْ يهدموا العزّى ولا هُبلا(2)",10,"ل",2,0],["قَدْ كَبَّلُونِي بِقَيْدٍ فِي مَهَامِهِهِمْ","فَطَارَ قَلْبِي إِلَى الجَنَّاتِ يَبْتَهِلُ",11,"ل",1,0],["قَدْ كَبَّلَتْ أَلْسُناً فَانْتَابَهَا رَجْفٌ","كَرَجْفَةِ المَوْتِ لِلآهَاتِ تَرْدِيْدُ",12,"د",1,0]]}