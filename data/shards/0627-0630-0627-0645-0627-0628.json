00","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86240","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86302","الطويل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117162","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108378",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108274","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108335",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91293","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135423","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103534","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35529","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107291","الطويل"],[4069,"","https://poetry.dctabudhabi.ae/diwan/poem/22630","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22099","الطويل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123956","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54474","الطويل"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135093","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105512","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73436","الوافر"],[4458,"","https://poetry.dctabudhabi.ae/diwan/poem/147718","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58128","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33321","المتقارب"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139862",""],[4608,"","https://poetry.dctabudhabi.ae/diwan/poem/89644","الطويل"],[4679,"أما لأبي البرية أن يعادا","https://www.poetsgate.com/ViewPoem.aspx?id=142720",""],[4755,"دَلَالًا أَشَاحَت وَجهَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=183675",""],[3891,"نرى الدُّنْيَا وزهرتها فنصبو","https://www.poetsgate.com/ViewPoem.aspx?id=187512",""],[5615,"وينشرحون إن نعق الغراب .... !","https://www.poetsgate.com/ViewPoem.aspx?id=196626",""],[5632,"برآة طفل","https://www.poetsgate.com/ViewPoem.aspx?id=178124",""],[5701,"أخو سبعين هام بها شبابا","https://www.poetsgate.com/ViewPoem.aspx?id=164665",""],[402,"وداعا أيها الخدن الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=35114",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[6084,"سميت سعدى لتفدى بقومي","https://www.poetsgate.com/ViewPoem.aspx?id=170833",""],[2220,"حمدتُ إلهي والمقامُ عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11732&r=&rc=602",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""],[572,"عَذِيريَ منْ صرفِ هذا الزّمنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9489&r=&rc=346",""]],"verses":[["إِذا ما بَنَوا بَيتَ أُكرومَةٍ","أَطالوا السُموكَ وَمَدّوا الدِعاما",0,"م",2,0],["إِذا ما بَدَأنَ الأَمرَ أَفسَدنَ عَقبَهُ","وَعَفّى عَلى إِحسانِهِنَّ ذُنوبُ",1,"ب",1,0],["إِذا ما بَكَى في مَأْزِقِ الحَرْبِ صارِمِي","دَماً أَوْ سِنانِي ضاحَكَ الذِئْبَ نَسْرُهُ",2,"ر",2,0],["إذا ما بَكَى منْهُم لَذيغٌ لِدرّةٍ","وجادَتْ بدُرِّ الدّمْعِ مُقْلَتُهُ النّجْلا",3,"ل",2,0],["إِذَا مَا بَنَى يَوْماً بنَاءَ صَنِيعَةٍ","تَعَاهَده مِنْهُ التَّفَقُّدُ وَالرَّمُّ",4,"م",1,0],["إِذا ما بَدا بَدوَةً لِلعُيونِ","تَذَكَّرَ ذو الضَغنِ مِنهُ المَحيصا",5,"ص",2,0],["إِذا ما بَكى مِن خَلفِها اِنصَرَفَت لَهُ","بِشِقٍّ وَتَحتي شِقُّها لَم يُحَوَّلِ",6,"ل",1,0],["إِذا ما بَدا شَجواً حَمامٌ مُغَرِّداً","عَلى أَثلَةٍ خَضراءَ دانٍ غُصونُها",7,"ن",3,0],["إذا ما بَلَغنا الجُهدَ مِنها تَوَعَّبَت","وَضيعُ زِمامٍ كَالُبابِ المُسيَّبِ",8,"ب",1,0],["إذا ما بدا دلت جلالة شخصه","على أنه في قوم العلم الفرد",9,"د",1,0],["إِذا ما بَدَت حُزوى وَأَعرَضَ حارِكٌ","مِنَ الرَملِ تَمشي حولَهُ العِينُ أَعفَرُ",10,"ر",1,0],["إذا ما بدا للقوم لاحت بوجهه","دلائل من نور الهدى وعلائم",11,"م",1,0],["إِذا ما بِتَّ بِالرَبَعِيَّ لَيلاً","فَأَرَّقَ مُقلَتَيكَ عَنِ الرُقادِ",12,"د",1,1],["إِذا ما بَعَثنا رائِداً يَبتَغي النَدى","أَتانا بِحَمدِ اللَهِ أَحمَدَ رائِدِ",13,"د",1,0],["إِذا ما بِتُّ أَشرَبُ فَوقَ رَيٍّ","لِسُكرٍ في الشَرابِ فَلا رَويتُ",14,"ت",1,0],["إِذا ما بِتُّ أَختِلُ عِرسَ جاري","لِيُخفِيَني الظَلامُ فَلا خَفيتُ",14,"ت",1,0],["إِذا ما بَخيلُ الناسِ هَرَّت كِلابُهُ","وَشَقَّ عَلى الضَيفِ الضَعيفِ عَقورُها",15,"ر",3,0],["إذا ما بدت تحت الخوافق صدقت","بايَمَن فأل الزاجرين افتئالَها",16,"ه",2,1],["إِذا مابَرَدَ الحُبُّ","فَما تُسخِنُهُ النارُ",17,"ر",1,0],["إذا ما بدا أو ماس أو صان أو رنا","فما البدر والخطّيّ واللّيث والطّلا",18,"ل",2,0],["إذا ما بدا كالصبح فَرْقُ جبينه","دعوت على عين العواذل بالفجر",19,"ر",1,0],["إذا ما بنو الحاجات كان مجازُهم","على ملك كانت عليك المحابس",20,"س",1,0],["إذا ما بدا للناظرين يَشُبُّهُ","سنا رأيهِ في الحادثِ المُتَفاقمِ",21,"م",1,0],["إِذا ما بَدا بِالغَيبِ مِنها عِصابَةٌ","أَوَينَ لَهُ مَشيَ النِساءِ اللَواغِبِ",22,"ب",1,0],["إِذا ما بَرَزنا لِلفَضاءِ تَقَحَّمَت","بِأَقدامِنا مِنّا المِتانُ الصَرادِحُ",23,"ح",1,0],["إذا ما بلغ المجلس","أمثالك في النطس",24,"س",1,0],["إذا ما بدا لي أن أفاضل بينهم","أبى لي قلب عادل ورحيم",25,"م",1,0],["إِذا ما بَدا في مَجلِسٍ ظُنَّ حافِلاً","مِنَ الصَخَبِ العالي وَلَيسَ بِحافِلِ",26,"ل",1,0],["إِذا ما بَدا خَلّى المَعالي دَخيلُها","وَأَنسى صَغيرَ المَكرُماتِ كَبيرُها",27,"ر",3,0],["إِذا ما بَعَثنا الشِعرَ فيهِ تَزايَدَت","لَهُ مَكرُماتٌ مُربِياتٌ عَلى الشِعرِ",28,"ر",1,0],["إِذا ما بَلَوناهُ حَمِدنا وَإِنَّما","يَبينُ غَناءُ السَيفِ عِندَ استِلالِهِ",29,"ل",2,0],["إِذا ما بَريدُ النَضرِ جاءَ بِنَصرِهِ","وَسُلطانِهِ أَلقى قُيودَ اِبنِ غالِبِ",30,"ب",1,1],["إِذا ما بَكى العَجعاجُ هَيَّجَ عَبرَةً","لِعَينَي حَزينٍ شَجوُهُ غَيرُ راجِعِ",31,"ع",1,0],["إِذا ما بَدا الحَجّاجُ لِلناسِ أَطرَقوا","وَأَسكَتَ مِنهُم كُلُّ مَن كانَ يَنطِقُ",32,"ق",1,1],["إِذا ما بَنو الجَعراءِ لَفّوا رُؤوسَهُم","بَدا لُؤمُهُم بَينَ اللِحى وَالعَمائِمِ",33,"م",1,0],["إذا ما بدا أغرى به كل ناظر","كأن قلوب الناس في حبه قلب",34,"ب",1,0],["إذا ما بَلَوْتُ الصَّائِبينَ وجدتُهُم","فَريقَيْنِ صبّاً بالسَّماحِ ومُرغِما",35,"م",2,0],["إذا ما بَدا أبدى الغَرامُ سرائري","وأظهرَ للعُذَّالِ ما بينَ أضلُعي",36,"ع",2,0],["إِذا ما بَدَت مِن صاحِبٍ لَكَ زَلَّةٌ","فَكُن أَنتَ مُحتالاً لِزَلَّتِهِ عُذرا",37,"ر",2,0],["إِذا ما بَدَت وَالبَدرُ لَيلَةَ تِمِّهِ","رَأَيتَ لَها فَضلاً مُبيناً عَلى البَدرِ",38,"ر",1,0],["إذا ما بدا طعْنُ الكماةِ وضربهم","كنَقْطٍ وشكلٍ منه أعجمت أحرفا",39,"ف",2,0],["إذا ما بدا غمده قلت رَفّعَتْ","بخاراً لطيفاً فوق جَدْوَلِهِ الشمسُ",40,"س",1,0],["إِذا ما بَنى بَيتاً مِنَ الشِّعرِ مِقوَلي","ثنى نابياً عن هَدْمِهِ معولَ الدَّهرِ",41,"ر",1,0],["إذا ما بديعُ المدحِ ضاقَ مجاله","على مادحٍ ألفاهُ في وصفه رَحْبا",42,"ب",2,0],["إِذَا مَا بَنَانَا الدَّهْرُ ظَلَّتْ صُرُوفُهُ","تُهَدِّمُنَا وَالدَّهْرُ أَغْدَرُ بَانِي",43,"ن",2,0],["إِذا ما بَنو عُثمانَ هَزّوا سُيوفَهُم","فَقُل لِبَني التاميزِ هُزّوا المُقَطَّما",44,"م",2,0],["إِذا ما بَدا أَبصَرتَ غُرَّةَ وَجهِهِ","كَعُنقودِ كَرمٍ بَينَ غُصنَينِ نَوَّرا",45,"ر",2,0],["إِذا ما بِكاةُ الدَرِّ جادَت بِمَبعَثٍ","كَما سُلَّ خَيطٌ مِن سَدى الثَوبِ فَاِنسابا",46,"ب",2,0],["إذا ما بِناءٌ شادَهُ اللّهُ وَحْدَهُ","تَهَدّمَتِ الدّنْيا ولمْ يَتَهَدّم",47,"م",1,0],["إِذا ما بَدَت أَزرارُ جَيبِ قَميصِهِ","تَطَلَّعَ مِنها صورَةُ القَمَرِ البَدرِ",48,"ر",1,0],["إِذا ما بِتُّ مِن حُبِّ","كِ أَصبَحتُ عَلى خُمرَه",49,"ر",2,0],["إِذا ما باعَدَت قَرُبَت بِرَأيٍ","وَإِن قَرُبَت فَشيمَتُها البِعادُ",50,"د",1,0],["إِذا ما بيعَةٌ زيرَت لِغَيٍّ","فَأَعطِ لِهَجرِها أَيمانَ بَيعَه",51,"ع",2,1],["إِذا ما بَدا ظَلَّت لَهُ الأُسدُ عُكَّفاً","فَهُنَّ حِذارَ المَوتِ مِنهُ رُبوضُ",52,"ض",1,0],["إِذا ما باصَ لاحَ بِصَفحَتَيهِ","وَبَيَّضَ في المَكَرِّ وَفي المَحاصِ",53,"ص",1,0],["إِذَا ما بَدَتْ مِنْ خِدْرِهَا قَالَ صَاحِبي","أَطِعْني وَخُذْ مِنْ وَصلِهَا بِنَصيبِ",54,"ب",1,0],["إذا ما به غنى المغنون هاجني","فثار بما غنوا سروري والحزن",55,"ن",1,0],["إِذَا مَا بَدَتْ مِنْ خِبَاءِ العَفَافِ","كَمَا تَتَجَلَّى صَبَاحاً ذُكَاءْ",56,"ا",2,0],["إِذَا ما بَانَ 