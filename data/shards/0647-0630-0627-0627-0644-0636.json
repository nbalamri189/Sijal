{"poems":[[102,"كانوا رجالا","https://www.poetsgate.com/ViewPoem.aspx?id=50425",""],[92,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[543,"كيف المآل إذا تكون الحال","https://www.aldiwan.net/poem47997.html","عموديه"],[567,"هذا الضريح لجرجس الصباغ قد","https://www.aldiwan.net/poem52578.html","الكامل"],[567,"هذا الضريح لبطرس العازار من","https://www.aldiwan.net/poem52616.html","الكامل"],[567,"هذا الضريح لبطرس الشهم الذي","https://www.aldiwan.net/poem52681.html","الكامل"],[567,"هذا الضريح لفاضل سعدت له","https://www.aldiwan.net/poem52697.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38204","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59584","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52100","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87597","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91006","الكامل"],[4755,"وسَأَلْتُهَا: ولِمَن كِتَابَتُهُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184804",""],[4755,"ما بَين صِلصَالِي وفُولاذِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=197776",""],[5558,"هذا الضَّميرُ الذي أَعيا مَعيشَتَنا","https://www.poetsgate.com/ViewPoem.aspx?id=212360",""],[5784,"#يا ريح","https://www.poetsgate.com/ViewPoem.aspx?id=210510",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[6152,"عيونكِ ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=203709",""],[186,"هذا الضريح لزين زين ثوى به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55996&r=&rc=259",""]],"verses":[["هذا الضحى من وهج أبصارهم","ومن رؤاهم هذه الأنجم",0,"م",1,0],["هذا الضريحُ ضريحُ أمةِ يَعرُبٍ","فيه خِيار خِصالِها مُتجَمِّع",1,"ع",1,0],["هذا الضياءَ الذي يَهدي لمكمنّه","لِصّاً ويُرشدُ أفعى تَنفُثُ العَطَبا",2,"ب",2,0],["هذا الضعيفُ أمامَكم مُستَرحِماً","يرجو النَّوال فهل لديكَ نَوالُ",3,"ل",1,0],["هذا الضَّريحُ لجُرجُسِ الصَبَّاغِ قد","أبقى رميمَ الجسمِ فيهِ قاطِنا",4,"ن",2,1],["هذا الضريحُ لبُطرسِ العازارِ من","بيتٍ كبيرٍ في البِلادِ تَقدَّما",5,"م",2,1],["هذا الضَّريحُ لبُطرسَ الشَّهم الذي","أبكى بني الجاويشَ دمعاً قد صَفا",6,"ف",2,1],["هذا الضَّريحُ لفاضلٍ سعِدَتْ لهُ","باللهِ نفسٌ في النَّعيم تُخلَّدُ",7,"د",1,1],["هَذا الضّريحُ لِمُصطَفى العَلياءِ مَنْ","كانَ الوَجيهَ وَقَد حَوى الوَجهَ الأغرْ",8,"ر",1,1],["هذا الضمير إليكم والفؤاد لكم","أن تقبلوه فذاك جهد مجهود",9,"د",1,0],["هذا الضريح الذي فيه الحبيب ثوى","أكرم به من حبيب طاب مثواه",10,"ا",2,0],["هذا الضريح الذي قد ضم أعظمه","أعظم به من ضريح ضم أعضاه",10,"ا",2,0],["هذا الضريح الذي هام الوجود به","أليس فيه الذي زكاه مولاه",10,"ا",2,0],["هَذا الضَّرِيحُ لِبنتِ يُوسُفَ فَافَةَ","ذَات الحَيَا وَالهِمَّةِ المُتَعَالِيَهْ",11,"ي",2,0],["هَذا الضَريح شَهمٌ في التراب ثوى","وَالنَفسُ جاوَرَتِ الأَملاك والرُسُلا",12,"ل",2,1],["هذا الضريح به الدمشقي المنتمي","للكنج يوسف خير باشا أكمل",13,"ل",1,1],["هذا الضَّيَاعُ المُستَطِيرُ أنا","طُرُقَاتُهُ, وأنا صَبَابَتُهُ",14,"ت",2,0],["هذا الضَّنِينُ الطَّبعِ قد يَلتَجِي","بِالمَوتِ مِن إِقلاقِ شَحَّاذِهِ",15,"ذ",2,0],["هذا الضَّميرُ الذي أَعيا مَعيشَتَنا","أَعدِمْهُ حَتّى تَرى مَسعاكَ يُحتَرَمُ !!!",16,"م",1,0],["هذا الضجيجُ الفجُّ كيف سيصمتُ؟!","يفتي بما يفتي كما يتشمَّتُ",17,"ت",1,1],["هذا الضّبابُ يلفّه بجناحه","وحنان فيحاء الشّآمِ دثارُ",18,"ر",1,0],["هذا الضياء إلى عيونكِ ينتمي","والمُر في شفتيكِ عاد زُلالا",19,"ل",2,0],["هذا الضريح لزين زين ثوى به","كالغصن قد كسرته عاصفة القضا",20,"ض",2,1]]}