/www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5693,"أنا العاصي أنا العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=37317",""],[5704,"أَمَل...","https://www.poetsgate.com/ViewPoem.aspx?id=191297",""],[5753,"كتابي مثقلٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=198538",""],[402,"علا مفرقي بعد الشباب مشيب","https://www.poetsgate.com/ViewPoem.aspx?id=35055",""],[5956,"بوصلة العقل العربي الخربَة","https://www.poetsgate.com/ViewPoem.aspx?id=192073",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[6167,"جمهورية الخلفاء الراشدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85473&r=&rc=2",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[463,"سقى دارها بالرَّقمتينوحيَّاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60276&r=&rc=332",""]],"verses":[["وهل في بردة الأرض احتجابٌ","لمن كان الزمان له إهابا",0,"ب",2,0],["وهل فطرة الإنسان إلا بدمعةٍ","يدين بها باكٍ على الظلم مجرما",1,"م",2,0],["وَهَل في ذاكَ إِلّا أَن يَقولوا","تَسَبُّبُ مُكثِرٍ غَلَبَ المُقِلّا",2,"ل",2,0],["وهلْ في بَني مثْواكَ إلا مُبرِّزٌ","بحَلْبَةِ شُورَى أو بحَلْقَةِ تدْريسِ",3,"س",1,0],["وَهَل في مِصرَ مَفخَرَةٌ","سِوى الأَلقابِ وَالرُتَبِ",4,"ب",1,0],["وَهَل في دارِ نَدوَتِكُم أُناسٌ","بِهَذا المَوتِ أَو هَذا الجُمودِ",5,"د",1,0],["وَهَل فاتَ شَيءٌ مِنَ المَكرُماتِ","جَرى السَيفُ يَطلُبُهُ وَالقَلَم",6,"م",1,0],["وَهَلْ فِي الرَّسْمِ أَوْ فِي النَّقْشِ تُجْدِي","إعادَاتُ النُّقُوشِ أَوِ الرُّسُومِ",7,"م",1,0],["وهل في مُصلاّه من راكع","يُجيب المؤذّنَ إن كبّرا",8,"ر",2,0],["وهل فيك الحياة لها وجود","فيمكن للرَّدى بك أن يكونا؟",9,"ن",2,0],["وهل في الورى سحرٌ وما غير لحظها","ولفظ علاء الدّين للسحر نافث",10,"ث",1,0],["وهل فتىً يشكى إليه الذي","تمَّ له أدراج تتلى وبخ",11,"خ",1,0],["وَهَل في سَماءِ النيلِ غَيرُ دَياجِرٍ","وَهَل في مِياهِ النيلِ غَيرُ مَجامِرِ",12,"ر",1,0],["وَهَل في ضِفافِ النيلِ بَينَ نَخيلِهِ","مُغَرِّدَةٌ أَو آنِسٌ غَيرُ نافِرِ",12,"ر",1,0],["وَهَل في القَومِ يوسُفُ يَتَّقيها","وَيُحسِنُ حِسبَةً وَيَرى صَوابا",13,"ب",2,0],["وهل فيكمُ راقٍ فيشفي برُقْيَةٍ","لديغَ هوىَ يرجُو لديهِ ثَوابَا",14,"ب",2,0],["وَهَل في تَمادي الدَمعِ رَجعٌ لِذاهِبٍ","إِذا فاتَ أَو تَجدِيدُ عَهدٍ لِداثِرِ",15,"ر",1,0],["وَهَل في الناسِ مِن أَحَدٍ يُساوي","يَدَيكَ إِذا تُنوزِعَ لِلفَخارِ",16,"ر",1,0],["وَهَل في مَعَدٍّ مِن كِفاءٍ نَعُدُّهُ","لَنا غَيرَ بَيتَي عَبدِ شَمسٍ وَهاشِمِ",17,"م",1,0],["وَهَلْ فِي الصِّبَا وَاللَّهْوِ عَارٌ عَلَى الْفَتَى","إِذَا الْعِرْضُ لَمْ يَدْنَسْ بِإِثْمٍ وَلا بَعْوِ",18,"و",1,0],["وهل في طاقةِ القُوّادِ شيءٌ","إذا دهموا الجُيوشَ مُطوِّقينا",19,"ن",2,0],["وَهَل فاتَ الحتوفَ أَخو هُذَيلٍ","كَأَنَّ مُلاءَتَيهِ عَلى هِجفِّ",20,"ف",1,0],["وَهَل فَرقَدُ الخَضراءِ في الجَوِّ موقِنٌ","بِأَنَّ أَخاهُ بَعدَ حينٍ مُفارِقُه",21,"ق",2,0],["وَهَل فيكُم مِن باخِلٍ يُظهِرُ النَدى","رِياءً بِهِ أَو جاهِلٍ يَتَحَلَّمُ",22,"م",1,0],["وهل فَتياتٌ بالغُوَيْرِ يُرينَنَي","مَرابعَ نُعْمٍ نِعْمَ تلكَ المَرابع",23,"ع",1,0],["وهل في فلسطين ما ترهبين","سوى أنه اجتمع الموسم",24,"م",1,0],["وهل فضاءُ البحر أو غَوْره","مهما تناءَى وارتمتْ لجتاه",25,"ه",1,0],["وَهَل فاضَتِ العَينُ الشَروقُ بِمائِها","مِن اجلِكِ حَتّى اِخضَلَّ مِن دَمعِها بَردي",26,"د",2,0],["وَهَلْ فِي التَّحَلِّي بِالْكُنَى مِنْ فَصِيلَةٍ","إِذَا لَمْ تُزَيَّنْ بِالْفَعَالِ الطَّبائِعُ",27,"ع",1,0],["وَهَلْ فِي الشُّهْرَةِ الْيَقْظَى خُلودٌ","يُرَامُ لِخَالِدٍ عَنْهَا هجُوعَا",28,"ع",2,0],["وَهَلْ في الضُّحَى طَيْفٌ يَسُرُّ بِزَوْرَةٍ","إِذَا سَاءَنَا مِنَّنْ نُحِبُّ مَغِيبُ",29,"ب",1,0],["وَهَلْ في الضُّحَى إلاَّ جُرُوحٌ وَغَارَةٌ","لَحُوحٌ وَإِلاَّ سَالِبٌ وَسَلِيبُ",29,"ب",1,0],["وَهَلْ في الضُّحَى كَأْسٌ صَفُوحٌ عَنِ العِدَى","إِذَا رَابَتِ الكَاسَاتُ لَيْسَ تَرِيبُ",29,"ب",1,0],["وَهَلْ في الضُّحَى رَاحٌ حَمُولٌ عَلَى النَّدَى","تُصَبُّ فَرَاحَاتُ الكِرَامِ تَصُوبُ",29,"ب",1,0],["وَهَل فِلَسْطِينُ تَنْسَى مَا بَذَلْتِ لَهَا","فَيمَا تُعَانِيهِ مِنْ حَرْبٍ وَمِنْ حَرَبِ",30,"ب",1,0],["وَهَلْ فِي الْعَالِمِ العَرَبِيِّ مَنْ لَمْ","يُصِبْ مِنْ ذَلِكَ الفَضْلِ الْجَزِيلِ",31,"ل",1,0],["وَهَلْ فِي الأَسى غَيْرُ صَدْعِ الحَشى","وَتَدميَةِ الجَفْنِ مُسْتَعْبِرَا",32,"ر",2,0],["وَهَل في نَظمِ شِعري مِن طَريفٍ","لَمَغدىً في مَكانِكَ أَو مَراحِ",33,"ح",1,0],["وهل في ساحةِ الجنّاتِ نهرٌ","يزول بمائهِ حِقْد وغِلّ",34,"ل",1,0],["وهل في جوه غيم، وصحو","وحرٌّ لافح، أو زمهرير؟",35,"ر",1,0],["وهل في أهله شرهٌ، وشرٌّ","كأهل الأرض أم كرم، وخِير؟",35,"ر",1,0],["وهل في شرعة الأنصاف ألا","تُلِمَّ، وبيننا أمَدٌ قصير؟",35,"ر",1,0],["وهل في وقوفي ما يخفِّفُ لَوْعَتي","عليهم؟ وهل دمعي يُهَوِّنُ ما بيا؟",36,"ي",2,0],["وهل فاز بالعلياء الا مصمم","تهون لديه المزعجات الجسائم",37,"م",1,0],["وهل في الشدائد أحقادهُ","تُعينُ عليه وأضعانه",38,"ن",2,0],["وهل فقدنا للعارفين بقية","علينا وهل رأي الركون سديد",39,"د",1,0],["وَهَلْ فِي ضِيَاءِ الشُّهْبِ فَرْقٌ لِمُسْتَجْلي","عَلَى أَنَّهَا لَمْ تَرْضَ عَنْ مُسْتَقَرِّهَا",40,"ه",2,0],["وهلْ فِي التَّحَلِّي بِالْكُنَى مِنْ فَضِيلَة ٍ","إذا لم تزيَّن بِالفعالِ الطبائعُ ؟",41,"ع",1,0],["وهل في صنوف الاولياء وان علوا","اجل من الزهر الكرام الفواطم",42,"م",1,0],["وهَل في الشَّرعَةِ المُثلَى تَصَدَّى","إلى العَذَرَاءِ مُبيَضِّ العِذَارِ",43,"ر",1,0],["وهل في عالم الإنسان أحلى","من العلم المعزز بالجمالِ",44,"ل",1,1],["وَهَل فيكُمُ مَن باشَرَ الذَمَّ مُذ نَشا","وَمَن فارَقَ الإِحسانَ مُذ فارَقَ المَهدا",45,"د",2,0],["وَهَل في أَرضِهِم إِلّا فَريقٌ","يُحَدِّثُ بِالَّذي لاقى فَريقا",46,"ق",2,0],["وَهَل في عُلاهُ لِلمُخالِفِ مَدفَعُ","لِإِسرائِهِ باللَيلِ وَالناسُ هُجَّعُ",47,"ع",1,0],["وهَل فراشاتهُ طافَت بوجنَتِها","وغازلَت وهيَ نشوى وردَها القاني",48,"ن",2,0],["وهل فقد الأهلون أهلك حزنهم","عليك وعاش الحزن يمرح في قلبي",49,"ب",2,1],["وهل في حياة المرء إلا لحيظةٌ","إذا لطفت كانت شراباً من الخد",50,"د",1,0],["وهل فينوس عند مرببيها","سوى راقود في أحلام حابي",51,"ب",2,0],["وَهَل في بُردَتَيكَ سِوى دَعِييٍّ","تَسَوَّدَ في القَبيلَةِ حينَ أَثرى",52,"ر",2,0],["وَهَل في الناسِ لَو أَنصَفتَ خَلقٌ","يَعيشُ كَما أَعيشُ مِنَ الهَواءِ",53,"ا",2,0],["وهلْ في غدٍ إنْ كانَ في اليومِ عِلّةٌ","سَراحٌ لما تلوي النفوسُ الشحائحُ",54,"ح",1,0],["وهَلْ في حَياتي مُتْعَةٌ بعدَ مَوْتِهِ","وَقَد أسْلَمَتْنِي للدَّواهِي الدَّواهِمِ",55,"م",1,0],["وَهَل في مُلوكِ الأَرضِ مِثلُ أَبيهُمُ","يُرى أَبَداً أَو كانَ مِثلٌ لَهُ قَطُّ",56,"ط",1,0],["وهل في الخافقين أمصر كلا","محافظنا سوا عبد الحميد",57,"د",1,0],["وهل فَلكٌ يُبدي خِلافَك بَعدَما","قضَى لك مُجريهِ بعِزٍّ مُواصل",58,"ل",1,0],["وَهل فَكَكتَ الخَتمَ عَن كيسِهِ","وَهل كَحَلتَ الناظِر الأَكحَلا",59,"ل",2,0],["وهلْ في ارتحالي عن بلادٍ تنكّرتْ","لِمثليَ أو للسّاكِنينَ بها فَخرُ",60,"ر",1,0],["وهل في السَّادة الأَنجاب إلاَّ","كريمٌ قد تفرَّع من كريم",61,"م",1,0],["وهل فؤاد معنّىً","يَشْفى بدمعٍ طليقِ",62,"ق",1,0],["وهل فرمن نار القتال أخو حجاً","ليبقى وفي نار الجحيم يخلّد",63,"د",1,0],["وهل في أديم الشمس للعين مثْبَتٌ","وله جَهَدَ القاريُّ يوما فراماها",64,"ا",3,0],["وهل في بدور الأرض بعد ظهورها","وجوهٌ لهم يومَ السؤال وأنملُ",65,"ل",1,0],["وهل في الشِّرب من سُقْيا فإني","أرى في الشِّعبِ أفئدةً تَلوبُ",66,"ب",1,0],["وَهَل في الناسِ مِن أَحَدٍ","يَقيسُ الرَأسَ بِالذَنَبِ",67,"ب",1,0],["وهل في الأهالي لنا من رجال","تعيد المعالي بكف ندي",68,"د",2,0],["وهل في النّائِباتِ السّودِ شيءٌ","أشدُّ عليه من حدَقِ الحِسانِ",69,"ن",1,0],["وهل فتن الألباب إلا فتورها","وهل فتر أهل العزم إلا فتورها",70,"ر",3,0],["وهل في الورَى دارٌ كَدار مُرَابطٍ","بإبرَاهمَ التاطيرَ يُدعَى ولا قَصدُ",71,"د",1,0],["وهل في الورَى فردٌ فريدٌ مُهَذبٌ","به يمدحُ الشِّعر الفريدُ المهذَّبُ",72,"ب",1,0],["وَهَل فيكُمُ إلّا اِمرؤٌ شاع ذكرهُ","لما شاع ما بين الخلائق من ذكري",73,"ر",2,0],["وَهَل فيكمُ إلّا مَلومٌ مُفَنَّدٌ","ببذلِ أَساةٍ أو بمنع ثوابِ",74,"ب",1,0],["وَهَل في حِسابك أنّي كَرَعْتُ","برُزءِ الإمامِ كؤوس الشّجا",75,"ا",1,0],["وَهَل في اِكتِحالِ العَينِ بِالعَينِ ريبَةٌ","إِذا ما اِلتَقى الإِلفانِ لا بَل بِهِ أَجرُ",76,"ر",1,0],["وهل في الصُّبحِ بينَ النَّاسِ خَلْفٌ","فيُثبِت بعضُهم والبعضُ يَنفي",77,"ف",2,0],["وَهَل في شُهودِ الشَمسِ أَدنى مُزيَةٍ","وَقَد جاءَ ضوءُ الشَمسِ لَم يَتَكَتَّمِ",78,"م",1,0],["وَهَل فارَقتَهُ إِلّا تَوالَت","رَسائِلُهُ عَلَيَّ بِلا تَوانِ",79,"ن",1,0],["وهل في ضياء الشمس فقر لمن غدت","توقد آناء النهار مشاعله",80,"ل",2,0],["وَهَل في مصر قَبلك قَد تَحلَّى","مَليكٌ بِالمَعارف يا فَريد",81,"د",1,0],["وهل في عهدك الذهبي يشقى","كما ودّوا ليَ الحرُّ الرشيد",82,"د",1,0],["وهل في المقادير يغني العتاب","وهل في العيان يفيد الجدل",83,"ل",1,0],["وهل في المساجد هذا النفاق","وهل في الكنائس ذاك الدجل",83,"ل",1,0],["وهل في الدروب يكون الجها","دُ بالهرْج والهَزَجِ المبتذل",83,"ل",1,0],["وَهَل فارِسٌ قامَ في الحَربِ يَعدو","يَشقُّ لِهذا الهِزَبْرِ غبارا",84,"ر",2,0],["وهل فتىً تذكر الأضيافُ دعوتَه","بالشكر في أكل مشْوِىٍّ ومُنْطِبخِ",85,"خ",1,0],["وهل فائتٌ في الدهرُ يرجى معاده","وهل طمعٌ بعد الردى في ثباته",86,"ت",2,0],["وهل فيك يا صوتَ السحائب طاقة","لحملي إلى دار جفتْني كرامُها",87,"م",3,0],["وَهَلْ فِي بِلاَدِ اللَّهِ دُونَكَ مَذْهَبٌ","لِبَاغٍ إذَا مَا قِيلَ أيْنَ المَذَاهِبُ",88,"ب",1,0],["وهل فيك ظلّ مبرد لوعة الجوى","وهل فيك طلّ مذهب لوعة الظما",89,"م",2,0],["وهل في منى التحليق أستمطر المنى","وأرمي لتقصير جمار مدامعي",90,"ع",2,0],["وهل فاتح باب السماء بمائه","سواه إذَا ما الماء أصبح ناضبا",91,"ب",2,0],["وهل فيكما من إن تنزل منزلاً","أنيقاً وبستاناً من النور حاليا",92,"ي",2,0],["وهل في ربى وادي العقيق يطيب لي","مقيل ويحيى ميت الصد والبعد",93,"د",1,0],["وهَل فَاخِرٌ يَبأَى عَلَينَا بِمَفتخَرٍ","وهَل نَحنُ إلاَّ مُخجِلُ الأنجُم الزُّهرِ",94,"ر",1,0],["وهل فاجعٌ بالبْين والنأي راجعٌ","وهل مغضبٌ بالصدق والهجر معتبُ",95,"ب",1,0],["وهل في ربا نجد أرى لي منجداً","فقد قلبت قلبي الخطوب الفواظع",96,"ع",1,0],["وهل في قاعة الوعساء أمسى","بها سكن وبيت قرى لهنه",97,"ن",2,0],["وهلَّ في أُفقِ خليلٍ كوكبٌ","لا زال في سنائِه طليعا",98,"ع",2,1],["وهل في عيوني سواه جميلُ","وهل لبثينةَ غيرُ جميلْ",99,"ل",1,0],["وهلَّ في أُفق طليع قمرٌ","يا حبذا في وجهه الشروقُ",100,"ق",1,1],["وهل في الملوك الصيد ذو نظرةٍ له","تسامى بها أعلامه وتطول",101,"ل",1,0],["وهل في بني العلياء مثل محمد","إذا حاز رضوان العزيز نبيل",101,"ل",1,0],["وهل في الأرض من ملكٍ كبيرٍ","عليه من منيته حفير",102,"ر",1,0],["وهَل فَضلَت مِن مَركَبِ العُمرِ فَضلَةٌ","تُبَلِّغُني أَم لابلاغَ لمركَبِ",103,"ب",1,0],["وهل في البكا عار على رسم همنة","لبست بها برد الشبيبة أعصارا",104,"ر",2,0],["وهل في معد كامرء القيس أنهم","لهم من تميم صفوها المتنحب",105,"ب",1,0],["وهل فيه أَغضبناك حتى نفيتنا","إلى الأرض نشقى فوقها ونُساءُ",106,"ا",2,0],["وهلْ في عامرِ يوماً نَكيرٌ","وحَيَّيْ عبدِوُدِّ أو جَنابِ",107,"ب",1,0],["وهل فكرك العالى ينبه للذي","به أنت أدرى من صفات المحامد",108,"د",1,0],["وهل فعلوا غير القعود بأرضهم","خلاف رسول اللّه إذ سار وارتمى",109,"م",2,0],["وهل فيها لإنسانٍ مقامٌ","وأنتَ من الكِرام بها وفيها",110,"ي",3,0],["وهل فِي القُبُورِ حديثُ النُّبُوغِ الَّ","ذِي شاعَ فِي الزَّمَنِ الحاضِرِ",111,"ر",1,0],["وهل فيه شعري مدحة أم تغزل","وهل من حبيب كالحبيب الذي أعني",112,"ن",2,0],["وهل فطر لمن يمسي ويضحي","يؤمل فضل أقواتِ اللئام",113,"م",1,0],["وَهَل في غَير بَيتكم المَثاني","تكرر وَالصَلاة بِهِ تُقام",114,"م",1,0],["وهل في شرعة الإنصاف أني","أضام وأنت حي أو أراع",115,"ع",1,0],["وَهَل في غَد إِن كانَ في اليَومِ عِلَّة","نجازٌ لَما تلوى القُلوبُ الشَّحائِحُ",116,"ح",1,0],["وَهَل فَتىً فِيكُم فَمَأ خِلٌّ لَنَا","وَرَجُلٌ مِنَ الكِرَامِ عِندَنَا",117,"ن",2,0],["وهل في نساء العالمين نظيرها","فمن ذا ترى منهن أنسيةً حورا",118,"ر",2,0],["وَهل فخارٌ لمن في كُل آونةٍ","يخشى عَلى نفسه غسلاً وَتكفينا",119,"ن",2,0],["وهل في البحار على رحبها","جمال يخف إلى ناظر",120,"ر",1,0],["وهل في الهوى معنى سوى أن مقلتي","تراك وأن الحسن فيك طرير",121,"ر",1,0],["وهل في خواتيم اليواقيت طلسم","بسلب نهى العشاق يغري الخواتينا",122,"ن",2,0],["وهل في الجنان يئز الرصا","ص ويعدو وعلى الامن الخاتل",123,"ل",1,0],["وهل في السياسة من لذة","لمن هو في العشر بعد الثمان",124,"ن",1,0],["وهل فقدت بين الأنام قرابةٌ","يمت بها منهم عديمٌ ومترف",125,"ف",1,0],["وهل في الورى قومٌ كقومي إذا انتموا","بأشرفَ بيتٍ في يَمانٍ ومَرفعِ",126,"ع",1,0],["وهل فيكُمُ مثلُ سبطيه أو","كسلسلة الذهبِ المُحتمي",127,"م",2,0],["وَهَل فِيكُمُ مِثلُ إِدرِيسَ فِيهِم","أصَابَ وَمَا كَانَ أشوَى بِهَا",128,"ب",3,0],["وَهَل فِيكُمُ كابنِهِ ابنِ مَشِيشٍ","مُديرِ الكُؤُوسِ لأصحَابِهَا",128,"ب",3,0],["وهل فوق ما قد شاد مقتدرٌ لهم","ومؤتمن باللَه لقياه إيمان",129,"ن",1,0],["وهل في التي طاعوا لها وتعبَّدوا","لأمرك عاصٍ أو لحقك جاحدُ",130,"د",1,0],["وهَل في القَومِ بعدُ فَتًى خِداعاً","تَغُرُّ هُنا فَيَبدُرَ في بدارِ",131,"ر",1,0],["وهل في التواريخ من عبرة","الاَ إنها عبرةُ المعتبر",132,"ر",1,0],["وهل في الهوى وصلُ المُحِبِّ مُحَرَّمٌ","وسفكُ دماءِ العاشِقينَ مُحَلَّلُ",133,"ل",1,0],["وهل في فؤادي فَضلةٌ تَسَعُ الهوى","وما العِشق إِلاّ شُغْل قلبٍ بلا شغل",134,"ل",1,0],["وَهَل فَضلُها إِلّا لِكَثرَةِ ما حَوَت","وَما قَد حَوى التَسهيلُ مِن ذاكِ أَكثَرُ",135,"ر",1,0],["وهل في سبيل اللّه راحم لوعة","تعاودني لا بل غرتني كالجِلد",136,"د",1,0],["وهل في البرايا مثل لبنان مرتعٌ","فيعتاض عنهُ أهلهُ وطناً بهِ",137,"ب",2,1],["وهل في نِسبَةِ المَغلُوبِ شَكٌّ","إِذا التَقَتِ الثَّعالِبُ والنُّمُورُ؟!",138,"ر",1,0],["وهل فيما ألِفتَ اليوم شيء","به أحببت أن تبقى بعيدا",139,"د",2,0],["وهل في المدائن ما يُدَّعى","وما قيل عنها من المدعي",140,"ع",2,1],["وهل فخرهم إلا بجاهك جملة","وليا مجابا أو رسولا مكلما",141,"م",2,0],["وهل في ضميرِ الدهرِ للقربِ عودةٌ","فَنَعْنَى كما كنّا أم الصبرُ أَعْوَدُ",142,"د",1,0],["وهل في قضايا العقل مولاي آفة","لديك تصدى صارمي وتكهم",143,"م",1,0],["وهل في الرسم أو في القش تجدي","إعادات النقوش أو الرسوم",144,"م",1,0],["وهل فُتِنْتِ بمالٍ لا نفادَ لهُ","وهل رضيتِ بما يرضى مدبّرُهُ؟",145,"ر",2,0],["وهل في القلب غير هواه إني","أراه مرة أبدا لعيني",146,"ي",1,0],["وَهَلْ فِي الُعُرْبِ مَنْ تَعِبَتْ بِحَمْلِي؟","إِذَا مَا الكَرُّ يُسْقِيهِمْ وَبَالَ",147,"ل",1,0],["وهلْ في دوحةِ الأطيارِ بسمٌ","وطيرُ الدوحِ لا عزفٌ وصدحُ",148,"ح",1,0],["وهل فارس يلوى وإن طال ساعدا","صروف القضا بالعزم أو يصرع الدهرا",149,"ر",2,0],["وهل في التماع الرؤى نشوة","أم الذئب من في الهوى يُركعك",150,"ك",1,0],["وهل في شظى ضنك الدروب شتيمة؟","أليس لباب العسر (ربٌّ) كما اليسرُ؟",151,"ر",1,0],["وهل فيك إلا السناءُ الذي","أفاضَ الرؤى فسحةَ الآملين",152,"ن",1,0],["وهل في الأرض تمر مثل تمر","بأرض الرافدين٠٠٠ له مذاق؟",153,"ق",1,0],["وهل فيهم من يندبون صحابهم","ويرجون جمع الشمل بعد شتات؟",154,"ت",1,0],["وهل فرقت فيه يد الدهر للصبا","مُنىً بينها قد كنت في خير مجلس؟",155,"س",1,0],["وهل فاحت بساحتنا","عطور الحبّ والآس",156,"س",1,0],["وهلْ في الكونِ مازالتْ حسانٌ","بهذا القَدِّ مَمْشوقَ القوامِ؟",157,"م",1,0],["وهل في الأرضِ ما يزِنُ الخطايا","كمَنْ دالتْ بهم دولٌ خرابا؟!",158,"ب",2,0],["وهل في الضحى طيف يسر بزورة","إذا ساءنا ممن نحب مغيب",159,"ب",1,0],["وهل في الوجود سوى العربيِّ","على العربيِّ يقيم التخوما؟",160,"م",2,1],["وهل في الأرض مخلوق قرير","ولم يشهد بها قيظاً وقَرَّا؟؟",161,"ر",2,0],["وهل في الأرضِ من حلٍّ مفيدٍ","كمثل السلم في كل الأمورِ؟",162,"ر",1,0],["وهل فتن الألباب إلا فتونها","وهل فتر أهل العزم إلا فتورها",163,"ر",3,0],["وهلْ فى سُنَّةِ الإسلامِ يُرْجَى","إِمامٌ دُونَ هادِيها يُقَامُ ؟",164,"م",1,0],["وهل فيك للعاني الشجي تعلة","سوى الشوق والتذكار والدمع والسهد",165,"د",1,0],["وهل في غير دينك من نجاة","إذا ما الشرأحدق بالكنود",166,"د",1,0],["وهل في أديم الشمس للعين مثبتٌ","وهل جهدَ القاري يوما فراماها",167,"ا",3,0]]}