{"poems":[[55,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[79,"أبا مالك أنت نجل الملوك","https://www.aldiwan.net/poem36372.html","المتقارب"],[53,"لم أفسر غريبها لك لكن","https://www.aldiwan.net/poem65766.html","الخفيف"],[94,"عجبا لي أود أن أفهم الكون","https://www.aldiwan.net/poem38932.html","الخفيف"],[46,"ذل السؤال شجى في الحلق معترض","https://www.aldiwan.net/poem29718.html","البسيط"],[46,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[107,"ما للدموع على التظنن تذرف","https://www.aldiwan.net/poem44039.html","الكامل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[79,"أبا مالك أنت نجل الملوك","https://www.poetsgate.com/ViewPoem.aspx?id=34153",""],[102,"مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=50153",""],[98,"أيتها الأشباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66333&r=&rc=12",""],[136,"لم أفن في الشاه إبلا لا ولا بقرا","https://www.aldiwan.net/poem54841.html","البسيط"],[200,"بلغ حُبيباً وخلل في صراتهم","https://www.aldiwan.net/poem528.html",""],[216,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[234,"لم أفارقكما اختيارا وهل تختار","https://www.aldiwan.net/poem50849.html","الخفيف"],[234,"أنت للنفس حياة فإذا","https://www.aldiwan.net/poem50952.html","الرمل"],[234,"أنتم في المنام حلمي وأنتم","https://www.aldiwan.net/poem51136.html","الخفيف"],[236,"يا قسوة القلب مالي حيلة فيك","https://www.aldiwan.net/poem44559.html","البسيط"],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[382,"قدما علوت على الزمان تجملا","https://www.aldiwan.net/poem66904.html","الكامل"],[422,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[422,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[443,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[447,"وداعاً أيها الطهر النبي","https://www.aldiwan.net/poem14344.html","الوافر"],[453,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[484,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103101","البسيط"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96995","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67015","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63925","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96626","البسيط"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128271","الخفيف"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132842","الوافر"],[1464,"","https://poetry.dctabudhabi.ae/diwan/poem/146699","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128712","المديد"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1794,"","https://poetry.dctabudhabi.ae/diwan/poem/145410","الكامل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76839","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2369,"","https://poetry.dctabudhabi.ae/diwan/poem/145354","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93927","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100404","الرمل"],[2908,"","https://poetry.dctabudhabi.ae/diwan/poem/145233","السريع"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99508","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62850","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108382",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92011","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216390","الهزج"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135094","الطويل"],[5183,"وَقَارُ الحَوَادِثُ","https://www.poetsgate.com/ViewPoem.aspx?id=186446",""],[5277,"روحُ العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189672",""],[5409,"خلطاء من كل فج حضور","https://www.poetsgate.com/ViewPoem.aspx?id=155271",""],[5457,"الحب حال","https://www.poetsgate.com/ViewPoem.aspx?id=213106",""],[5533,"قَدْ أَتَيْتُ أَعْتَذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=176647",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5758,"مجنونة","https://www.poetsgate.com/ViewPoem.aspx?id=211576",""],[5956,"لهفي عليك أيا شهيدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193142",""],[5956,"شكراً سُمَيّةُ قد أزلتِ مخاوفي","https://www.poetsgate.com/ViewPoem.aspx?id=202641",""],[422,"إذا نَبَتِ الدّيارُ بِحرِّ قومٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22246&r=&rc=2",""]],"verses":[["لَمّا فَزِعنَ مِنَ التَحَطُّمِ في الطُلى","جَعَلَ القُلوبَ تَمائِمَ الخِرصانِ",0,"ن",1,0],["لَمَا فَتَرتْ أَنْفُسٌ مِنْ أَسىً","وَلاَ بَرِحَتْ أَدْمُعٌ فِي انْهِمَالِ",1,"ل",1,0],["لم أُفسِّرْ غريبها لك لكِنْ","لامرئٍ يجهلُ الغريبَ سواكا",2,"ك",2,1],["لم أُفِدْ من حَقائقِ الكونِ إلاَّ","أَنَّني في الوُجُودِ مُرْتَادُ رَمْسِ",3,"س",1,0],["لَما فَكَكتُ رِقابَ الشِعرِ عَن فِكَري","وَلا رِقابَهُمُ إِلّاوَهُم حُيُضُ",4,"ض",1,0],["لَمّا فَصَلتَ مِنَ الدُروبِ إِلَيهِمِ","بِعَرَمرَمٍ لِلأَرضِ مِنهُ خُوارُ",5,"ر",1,0],["لمَّا فزعتم قال يا قومُ اسْكُنُوا","هِيَ يَثرِبٌ ما دُونَها مُتَخَلَّفُ",6,"ف",1,0],["لِما فيه مِنْ تَقْوَى وَعِلْمٍ وَحِكْمَةٍ","بِحُرِّ مَبَانِيهِ الثَّلاثُ تُشِيرُ",7,"ر",1,0],["لما فترت أنفس من جوى","ولا برحت أدمع في انهمال",8,"ل",1,0],["لم أفت مأتما من العمر إلاّ","وألاقي من بعده ألف مأتم",9,"م",1,0],["لم أفبلت في الظّلام إليّ ؟","ولماذا طرقت بابي ليلا؟",10,"ل",2,1],["لَم أفنِ في الشَّاهِ إِبلاً لاَ ولاَ بَقَرَا","إِذ مَا يُبَاعُ بِه أحرَى بِهِ الفُقَرَا",11,"ر",2,1],["لَمّا فَدوا بِأَخيهِم مِن مُهَوَّلَةٍ","اَخا السُكونِ وَلا جاروا عَنِ السَنَنِ",12,"ن",1,0],["لما فَقْدنا فتى العلمِ هِمَّتُه","وفي الفصاحةِ والآثارِ سَبَّاقُ",13,"ق",1,0],["لَم أفارِقْكُما اختِياراً وهَلْ تَخْتا","ر يُمْنَى اليدينِ فَقْدَ الشِّمالِ",14,"ل",1,1],["لم أُفارِقْك اختيارا إنما","حثّني الحَيْنُ على أَن أَدَعك",15,"ك",1,0],["لم أُفارِقْكُمُ ولكنَّ جسمي","بان عنكمْ وحلَّ فيكمْ فؤادي",16,"د",2,0],["لما فسحت بتوفير الحظوظ له","أضحى مع الدم يجري في مجاريك",17,"ك",1,0],["لَمْ أَفْنَ فِيمَا أرَى ولَكِن","بِما أَرانِي الجَمَالَ أفنَى",18,"ن",2,0],["لمّا فقدت بها الكريم سجيةً","من كان عن حد الكمال برتبة",19,"ه",1,0],["لما فقدنا الصالحين","علمتُ أنَّ الدهر فاسد",20,"د",1,0],["لما فارقتُهم يوماً ومالي","إذا وُفِّقْتُ عنهم من براحِ",21,"ح",1,0],["لما فاتين من حسن رأيك عالمٌ","بفضلي فيسدي ما يشاء ويطلق",22,"ق",1,0],["لما فارقت قبرك طرف عين","فما أنا في حقيقك أسمحي",23,"ي",1,0],["لما فهمت معانيها استناء بها","ذهنى وعدن لذهنى محنة الادب",24,"ب",1,0],["لم أفكر في سلوتي","غض طرفي عما انطوى",25,"ط",3,0],["لما فنى في قبول الحق شاهده","غابت شواهده في شاهد القدم",26,"م",1,0],["لما فات بعض القوم علم وقد مشوا","بغير حجاب مشية الخيلاء",27,"ا",2,0],["لم أفه بالعزاء علماً بأني","فيه أهدي إلى البحار الماءا",28,"ا",3,0],["لمّا فشا أمرُ الرسولِ بمكّةٍ","وتكرّرتْ أخبارُه تَكْرَارَا",29,"ر",2,0],["لَمَّا فَضَلْتُ رَمَوْا بكلِّ عَضِيْهَةٍ","والفَضْلُ مَوضعُ أَسْهُمِ البُهْتَانِ",30,"ن",1,0],["لمّا فتحتَ إلى الدنيا نُواظرنا","نُجْلاً ومن قبلُ ما قد غَمَّضتْ عمشا",31,"ش",2,0],["لمّا فتحتَ عماناً ذلّ شامسها","وَكنتَ فيها بفتحِ العذلِ مُرتاحا",32,"ح",2,0],["لم أفارق تلك المشاهد حتى","عرفتني ماذا يكون المصير",33,"ر",1,0],["لما فارقتُ دارَك لاختيارٍ","وكيف يُفارَقُ النَّوءُ المطيرُ",34,"ر",1,0],["لما فطمت عن اللذاذة كلها","داوى النهى بصراره إصراري",35,"ر",2,0],["لم أفرّط قطّ فيه ولا","شمل فكري غير ملتئم",36,"م",1,0],["لم أفارقه أجنبيًّا ولكنْ","هو روحي وفارقت جثماني",37,"ن",2,0],["لما فضضت ختامه عن روضة","رقت أعالي نبتها المتورس",38,"س",1,0],["لم أُفِق من خُمارِ بينك إذ بِن","تَ وَلا ذاقت الجفونُ حِثاثا",39,"ث",2,1],["لَمَّا فَسَا الشَّيطَانُ فِي آذَانِهِم","ثُقُلَت رُؤوسُهُمُ عَنِ القُرآنِ",40,"ن",1,0],["لما فسى الجهال في آذانه","أعموه دون تدبر القرآن",40,"ن",1,0],["لم أفش ما أودعتنيه إنه","ما صان سر الحق من أفشاه",41,"ا",2,0],["لم أفه باسمه وما كنت تدري","لو تكهنت أوغدوت سطيحا",42,"ح",2,0],["لم افز بالقرب منها غير أني","بؤت بالوزر وفازت بالمهنا",43,"ن",2,0],["لما فشا ذكرك بين الورى","بذاك قد لقبت تلقيبا",44,"ب",2,0],["لما فضضناه فاح منه","نسيم مسكٍ ولاح نور",45,"ر",1,0],["لم افعل الخير لما ان امرت به","وكنت افعل ما انهى بلا ندم",46,"م",1,0],["لم أفارقكَ رغبةً عنكَ في العَيْ","شِ وما كل فُرقةٍ عن ثِقَالِ",47,"ل",1,0],["لم افترق بين الجمال وثوبها","فعرفت حسن الجسم بعد توهم",48,"م",1,0],["لما فقدنا أنسها سرت بها","حورٌ حسانٌ وَالمَقام الطَيّب",49,"ب",1,0],["لما فيها من العيب","سننساه وننساها",50,"ه",2,0],["لما فيه من شوق ملم وحرقة","يرى يوم بعد في المساءة عام",51,"م",1,0],["لما فقدتُ محيَّاها فقدت على","جمال غرتها الأنوار تبتدر",52,"ر",1,0],["لما فقدت شميمَ العطرِ من جسدي","أتيت نحوك علَّ العطرَ ينشقني",53,"ن",2,0],["لم أفارق تلك المشاهر حتى","عرفتني ماذا يكون المصير",54,"ر",1,0],["لما فقدتكِ شقَّ الحزنُ بوصلتي","حتى تكونَ خلفَ الصدرِ أخدودُ",55,"د",1,0],["لَمْ أَفُزْ بعَافيةٍ","مُذْ جَفَانِيَ القَمَرُ",56,"ر",1,0],["لَمَّا فَتَحْتَ عُماناً ذَلَّ شامِسُها","وَكُنْتَ فِيها بِفَتْحِ العَدْلِ فَتَّاحَا",57,"ح",2,0],["لَمْ أَفْهَمِ الأَمْرَ إِلّا بَعْدَ أَسْئِلَةٍ","كَانَتْ تُخَبِّىءُ وَرْدًا أَحْمَرًا قُطِفَا",58,"ف",2,0],["لمّا فُجِعنا فيك ساد الوهن في","أعصابنا من وطأةِ الإجهادِ",59,"د",1,0],["لما فتحتُ جوابها خفَقَ الأسى","خوفاً يجيىء نَعِيُّ خِلِّي العاطفي",60,"ف",2,0],["لما فارقهم يوماً ومالي","إذا وفقتُ عنهم من براح",61,"ح",1,0]]}