{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[77,"أبا مالك أنت نجل الملوك","https://www.aldiwan.net/poem36372.html","المتقارب"],[51,"لم أفسر غريبها لك لكن","https://www.aldiwan.net/poem65766.html","الخفيف"],[92,"عجبا لي أود أن أفهم الكون","https://www.aldiwan.net/poem38932.html","الخفيف"],[44,"ذل السؤال شجى في الحلق معترض","https://www.aldiwan.net/poem29718.html","البسيط"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[105,"ما للدموع على التظنن تذرف","https://www.aldiwan.net/poem44039.html","الكامل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[77,"أبا مالك أنت نجل الملوك","https://www.poetsgate.com/ViewPoem.aspx?id=34153",""],[130,"لم أفن في الشاه إبلا لا ولا بقرا","https://www.aldiwan.net/poem54841.html","البسيط"],[194,"بلغ حُبيباً وخلل في صراتهم","https://www.aldiwan.net/poem528.html",""],[210,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[227,"لم أفارقكما اختيارا وهل تختار","https://www.aldiwan.net/poem50849.html","الخفيف"],[227,"أنت للنفس حياة فإذا","https://www.aldiwan.net/poem50952.html","الرمل"],[227,"أنتم في المنام حلمي وأنتم","https://www.aldiwan.net/poem51136.html","الخفيف"],[229,"يا قسوة القلب مالي حيلة فيك","https://www.aldiwan.net/poem44559.html","البسيط"],[273,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[374,"قدما علوت على الزمان تجملا","https://www.aldiwan.net/poem66904.html","الكامل"],[413,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[413,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[434,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[438,"وداعاً أيها الطهر النبي","https://www.aldiwan.net/poem14344.html","الوافر"],[446,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[477,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"]],"verses":[["لَمّا فَزِعنَ مِنَ التَحَطُّمِ في الطُلى","جَعَلَ القُلوبَ تَمائِمَ الخِرصانِ",0,"ن",1,0],["لَمَا فَتَرتْ أَنْفُسٌ مِنْ أَسىً","وَلاَ بَرِحَتْ أَدْمُعٌ فِي انْهِمَالِ",1,"ل",1,0],["لم أُفسِّرْ غريبها لك لكِنْ","لامرئٍ يجهلُ الغريبَ سواكا",2,"ك",2,1],["لم أُفِدْ من حَقائقِ الكونِ إلاَّ","أَنَّني في الوُجُودِ مُرْتَادُ رَمْسِ",3,"س",1,0],["لَما فَكَكتُ رِقابَ الشِعرِ عَن فِكَري","وَلا رِقابَهُمُ إِلّاوَهُم حُيُضُ",4,"ض",1,0],["لَمّا فَصَلتَ مِنَ الدُروبِ إِلَيهِمِ","بِعَرَمرَمٍ لِلأَرضِ مِنهُ خُوارُ",5,"ر",1,0],["لمَّا فزعتم قال يا قومُ اسْكُنُوا","هِيَ يَثرِبٌ ما دُونَها مُتَخَلَّفُ",6,"ف",1,0],["لِما فيه مِنْ تَقْوَى وَعِلْمٍ وَحِكْمَةٍ","بِحُرِّ مَبَانِيهِ الثَّلاثُ تُشِيرُ",7,"ر",1,0],["لما فترت أنفس من جوى","ولا برحت أدمع في انهمال",8,"ل",1,0],["لَم أفنِ في الشَّاهِ إِبلاً لاَ ولاَ بَقَرَا","إِذ مَا يُبَاعُ بِه أحرَى بِهِ الفُقَرَا",9,"ر",2,1],["لَمّا فَدوا بِأَخيهِم مِن مُهَوَّلَةٍ","اَخا السُكونِ وَلا جاروا عَنِ السَنَنِ",10,"ن",1,0],["لما فَقْدنا فتى العلمِ هِمَّتُه","وفي الفصاحةِ والآثارِ سَبَّاقُ",11,"ق",1,0],["لَم أفارِقْكُما اختِياراً وهَلْ تَخْتا","ر يُمْنَى اليدينِ فَقْدَ الشِّمالِ",12,"ل",1,1],["لم أُفارِقْك اختيارا إنما","حثّني الحَيْنُ على أَن أَدَعك",13,"ك",1,0],["لم أُفارِقْكُمُ ولكنَّ جسمي","بان عنكمْ وحلَّ فيكمْ فؤادي",14,"ي",1,0],["لما فسحت بتوفير الحظوظ له","أضحى مع الدم يجري في مجاريك",15,"ك",1,0],["لَمْ أَفْنَ فِيمَا أرَى ولَكِن","بِما أَرانِي الجَمَالَ أفنَى",16,"ن",2,0],["لمّا فقدت بها الكريم سجيةً","من كان عن حد الكمال برتبة",17,"ه",1,0],["لما فقدنا الصالحين","علمتُ أنَّ الدهر فاسد",18,"د",1,0],["لما فارقتُهم يوماً ومالي","إذا وُفِّقْتُ عنهم من براحِ",19,"ح",1,0],["لما فاتين من حسن رأيك عالمٌ","بفضلي فيسدي ما يشاء ويطلق",20,"ق",1,0],["لما فارقت قبرك طرف عين","فما أنا في حقيقك أسمحي",21,"ي",1,0],["لما فهمت معانيها استناء بها","ذهنى وعدن لذهنى محنة الادب",22,"ب",1,0],["لم أفكر في سلوتي","غض طرفي عما انطوى",23,"ط",3,0]]}