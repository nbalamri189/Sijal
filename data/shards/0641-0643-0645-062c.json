{"poems":[[79,"بعدنا وإن جاورتنا البيوت","https://www.aldiwan.net/poem36679.html","المتقارب"],[90,"يا شهر أيار ما أن أنت أيار","https://www.aldiwan.net/poem44420.html","البسيط"],[90,"أدرنة مهلا فإن الظبى","https://www.aldiwan.net/poem44466.html","المتقارب"],[31,"لعمري لقد أسريت لا ليل عاجز","https://www.aldiwan.net/poem6023.html","الطويل"],[87,"الأصل في كل بناية حجر","https://www.aldiwan.net/poem7911.html","الرجز"],[47,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[47,"بأي أسى تثنى الدموع الهوامل","https://www.aldiwan.net/poem65575.html","الطويل"],[30,"لبشر بن مروان على كل حالة","https://www.aldiwan.net/poem5048.html","الطويل"],[51,"ألم يك في وجدي وبرح تلددي","https://www.aldiwan.net/poem63543.html","البسيط"],[82,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[46,"أهن عوادي يوسف وصواحبه","https://www.aldiwan.net/poem30578.html","الطويل"],[48,"إذا ما مضى نفس فإحسبنه","https://www.aldiwan.net/poem22274.html","المتقارب"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[97,"جبل","https://www.poetsgate.com/ViewPoem.aspx?id=716",""],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[47,"ألم يك في وجدي وبرح تلددي","https://www.poetsgate.com/ViewPoem.aspx?id=31331",""],[119,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[119,"عجبت لمبتاع الضلالة بالهدى","https://www.aldiwan.net/poem41163.html","عموديه"],[136,"تجاوز قدر الذم ذا الفاسق الغوي","https://www.aldiwan.net/poem54649.html","الطويل"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[240,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[275,"هلا يقارن منك الحسن إحسانا","https://www.aldiwan.net/poem35272.html","البسيط"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[285,"ألم تك للملوك الغر تاجا","https://www.aldiwan.net/poem60700.html","الوافر"],[287,"بكت معنا العلياء إذ فقدت معنا","https://www.aldiwan.net/poem32322.html","الطويل"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[396,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[409,"بشرى فقد عطف الغاني على العاني","https://www.aldiwan.net/poem33380.html","البسيط"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[447,"أيا ليلى الشريفة حن قلبي","https://www.aldiwan.net/poem14313.html","الوافر"],[466,"تدل عليه عبقة هاشمية","https://www.aldiwan.net/poem15654.html","الطويل"],[469,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[518,"تمتع من حبيبك بالوداع","https://www.aldiwan.net/poem67725.html","الوافر"],[518,"أتوب إليك من نقض العهود","https://www.aldiwan.net/poem67755.html","الوافر"],[591,"فكم جمع الحسن النفيس من العلى","https://www.aldiwan.net/poem17490.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122673","الطويل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139065",""],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102039","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130208","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48568","البسيط"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138719",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70908","المتقارب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202095","المتقارب"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101995","البسيط"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102070","الطويل"],[1995,"","https://poetry.dctabudhabi.ae/diwan/poem/141717","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89531","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89540","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109460","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109417","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109369","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109792","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200409","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204579","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124293","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132571","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132618","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130040","الكامل"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140230",""],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100187","الطويل"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130612","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45755","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129342","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85272","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85281","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85251","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59452","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133227","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78355","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119657","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119652","المتقارب"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126337","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90834","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135119","الطويل"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116106",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136446",""],[4767,"على ضفة الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=178413",""],[4927,"وداع عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29611",""],[5050,"قضت أحسابنا ألا تدينا","https://www.poetsgate.com/ViewPoem.aspx?id=38191",""],[5064,"أعدلُ ظالم","https://www.poetsgate.com/ViewPoem.aspx?id=199105",""],[5120,"إِيهِ يَا حُلُمًا..","https://www.poetsgate.com/ViewPoem.aspx?id=200686",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5362,"ألا يا رجال الشعر لم لا نهضتم","https://www.poetsgate.com/ViewPoem.aspx?id=170370",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[5536,"حديث ٌ مع السمراء!!","https://www.poetsgate.com/ViewPoem.aspx?id=19875",""],[5582,"قِفا بِمُقامٍ لِلأَحِبَّةِ ماصِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=63481",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[5956,"نُقَّادٌ ومعجَبون","https://www.poetsgate.com/ViewPoem.aspx?id=185609",""],[5956,"فقدان وأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=194843",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""],[6346,"لك المدائح ياشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83384&r=&rc=0",""]],"verses":[["فكمْ جَدّلَتْ ذا الحُسامِ الظُّبى","وذا البَخْتِ كم خَذلَتْهُ البُخوتْ",0,"ت",1,0],["فكم جرى السيل في أيار مندفقاً","به السدود على الشطَين تنهار",1,"ر",1,0],["فكم جرَعونا كؤوس الردى","ونحن على كيدهم صابرون",2,"ن",1,0],["فَكَم جاوَزَت بَحراً وَلَيلاً يَخُضنَهُ","إِلَيكَ أَميرَ المُؤمِنينَ وَمِن سَهبِ",3,"ب",1,0],["فَكَم جَفاهُما بَنو مَروانا","وَاِصطَنَعوا مِن مُضَرَ الأَعوانا",4,"ن",2,0],["فَكَم جَبَلٍ وَعرٍ خَبَطنَ قِنانَهُ","وَمُنخَفَضٍ سَهلٍ مَثَلنَ بِقاعِهِ",5,"ع",2,0],["فَكَم جُرُزٍ مِن أَرضِ جُرزانَ فاتَها","تَتابُعُ سَحٍّ مِن يَدَيهِ وَوابِلُ",6,"ل",1,0],["فَكَم جَبَرَت كَفّاكَ يا بِشرُ مِن فَتىً","ضَريكٍ وَكَم عَيَّلتَ قَوماً عَلى عَمدِ",7,"د",1,0],["فَكَم جَزَعَت مِن وَهدَةٍ بَعدَ وَهدَةِ","وَكَم قَطَعَت مِن فَدفَدٍ بَعدَ فَدفِ",8,"د",2,0],["فَكَم جَهدُوا أَن يَفتَدوا مِن حِمامِهم","بِأَوزانِهم تِبراً فما قُبِلَ التبرُ",9,"ر",1,0],["فَكَم جِذعِ وادٍ جَبَّ ذِروَةَ غارِبٍ","وَبِالأَمسِ كانَت أَتمَكَتهُ مَذانِبُه",10,"ب",2,0],["فَكَم جَمرَةٍ خَمَدَت فَاِنقَضَت","وَكانَ لَها مُنذُ حينٍ وَهَج",11,"ج",1,0],["فكَمْ جاوَزْنَ مِن بَلَدٍ بَعيدٍ","وسائِرُ نُطْقِنا هِيدٌ وهادُ",12,"د",1,0],["فكم جبل يغفو على النجم خده","وأذياله للسائمات ملاعب",13,"ب",1,0],["فكم جعلت نفسي تطالب صبرها","بنصر فيأبى الصبر الا التناوم",14,"م",1,0],["فكم جزعت من وهدة بعد وهدة","وكم قطعت من فدفد بعد فدفد",15,"د",1,0],["فكم جال في الميدان والحرب فاتح","فثار بعج في العريكة عاقد",16,"د",1,0],["فكم جاهل يبدو بامراط عالم","وكم كافر مستصحب اسم عابد",17,"د",1,0],["فكم جاءت الخيرات عند فُقُوده","وكم سارت البلوي إلى حيث ينتوي",18,"و",2,0],["فَكَم جَلَوتَ بِها مِن فِتنَةٍ غَسَقَت","عَنّا وَأَجلَيتَ عَن عِرّيسِهِ أَسَدا",19,"د",2,0],["فَكَم جاهَدوا في نصرةِ الدين كافراً","وَخاضوا إليهِ الحربَ والحرّ والقرّا",20,"ر",2,0],["فَكَم جمعَ العِدا جَمعاً صحيحاً","فَكسّر جَمعهم أسراً وقتلا",21,"ل",2,0],["فَكَم جَميلٍ لَهُم وَصُنعِ يَدٍ","عَلى جِباهِ الأَنامِ مَكتوبِ",22,"ب",1,0],["فكم جَسَسنا من الأوتارِ ألطفَها","لمّا تلاقت على القَلبين كفَّانا",23,"ن",2,0],["فَكَم جَبرَتْ لُهاهُ من كَسيرٍ","وَكَم فكَّتْ ظُبَاهُ مِن أَسيرِ",24,"ر",1,0],["فَكَمْ جاوَزْتُ مِنْ عَذْبٍ زُلالٍ","إِلَيْكَ أَعُدُّهُ ملْحاً أُجاجا",25,"ج",2,0],["فَكَم جَرَحوا قَلباً وَكَم حَرَّقوا حَشاً","بِنَعيِهِمُ معناً وَكَم أَقرَحوا جَفنا",26,"ن",2,0],["فَكَم جلّى جلاها اللَّه عنّا","بِرأفتكَ الظليلُ بها الوجودُ",27,"د",1,0],["فَكَم جَسَدٍ أَنضَجتُ في نارِ هَجرِها","وَتُبَدِّلُن مِنهُ جَديداً لِشَوقَتي",28,"ي",1,0],["فكم جادوكم فادو أعطى","وكم غطى على عيب المعيب",29,"ب",1,0],["فكم جنى بتجنيه الجفا وإلى","ما كنت أكره قد ألجاني الجاني",30,"ن",2,0],["فكم جَلَّيْتَ من نَظَرٍ جَليٍّ","قرأْتَ بِهِ أَساطِيرَ الدَّهاءِ",31,"ا",2,0],["فَكمْ جُزْتُ من سَيْفٍ لِقَتْلِيَ مُنْتَضىً","وجاوزتُ من لَيْثٍ لِضَغْمِيَ مُفْتَرِّ",32,"ر",1,0],["فكمْ جُزْتِ من بحرٍ إِليَّ وَمَهْمَهٍ","يكادُ يُنَسِّي المستهامَ ادِّكارَكِ",33,"ك",1,0],["فكم جاوزت من أرض خلاء","تتيه بحورها الحدوى مخوفه",34,"ف",2,0],["فكم جهْلَةٍ من جاهلٍ بمقالتي","أمُرُّ عليها ضاحكاً لا أُجيبُها",35,"ب",3,0],["فكم جزعٍ لاقيت في جزع دارهِ","وإمّا تبدّى الحزنُ هيّج لي حزنا",36,"ن",2,0],["فكم جرعت من هجرٍ وغدرٍ","ومن حال ارتفاعٍ واتضاع",37,"ع",1,0],["فكم جانٍ تجافى غير جهلٍ","فعاد فلم يذق طعم الهجود",38,"د",1,0],["فَكَمْ جَمَعَ الحُسْنُ النَّفِيسُ مِنَ العُلَى","وَكَمْ فَرَّقَ الجَيْشُ الخَمِيسُ مِنَ العِدَى",39,"د",2,1],["فَكَم جاحِدٍ لِلَّهِ خالِصُ وُدِّهِ","وَرَغبَتِِهِ في وُدِّه وسُواعِه",40,"ع",2,0],["فكم جاءني منها نسيم ممسك","وعرفها للقاربين بها العطر",41,"ر",1,0],["فكم جاهل فيهم رمى العلم جهله","بما شاء من عار به وشنار",42,"ر",1,0],["فكم جاد بالأموال قبل سؤاله","وكم وكفت كفاه زخ العطية",43,"ه",1,0],["فكم جهرنا وأعلنا محبتكم","رغم الذين بقاسي بغضكم جهروا",44,"ر",3,0],["فكمجهر لا تحقرن صغائراً","وكمرقب كن واسع الإدراك",45,"ك",1,0],["فكم جاهلٍ ناعمٍ غافل","لقد بُدِّلَ الحزنَ بعد السرور",46,"ر",1,0],["فكم جرَّعتنيَ من صابها","وكم أنصَبَتْني بتَنْصابها",47,"ب",3,0],["فكم جرت مقلة الدين الحنيف له","وطالما كان إذ قد كان مكتحلا",48,"ل",2,0],["فكم جادكم أعطى وعلى تفضلا","هو السيد العالي على كل ماجد",49,"د",1,0],["فكم جللتها من عهادي ديمة","ففاخر سعدا سوحها وهضابها",50,"ب",3,0],["فَكَم جاهِلٍ ظَنَّ البُغاثَ جَوارِحاً","وَأَنَّ الخَواويرَ العِشارَ فُحولُ",51,"ل",1,0],["فَكَم جَلا مِن خُطوبِ الدَهرِ مُعتَكِراً","بِالمَشرَفِيِّ وَرَأيٍ غَيرِ مَأفونِ",52,"ن",1,0],["فكم جأه وفدٌ من الضيم شاردٌ","وبشره بالخير من وجهه البشر",53,"ر",1,0],["فكم جاحدٍ بين الورى فضل غيره","وليس لفضلٍ منهُ في الكون جاحدُ",54,"د",1,0],["فكم جبرت قلبا