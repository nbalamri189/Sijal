3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32799","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95340","الرجز"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114872","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76474","المتقارب"],[4037,"","https://poetry.dctabudhabi.ae/diwan/poem/147407","الوافر"],[4070,"","https://poetry.dctabudhabi.ae/diwan/poem/80131","الطويل"],[351,"","https://poetry.dctabudhabi.ae/diwan/poem/18855","الطويل"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67788","المتقارب"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45126","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94844","الوافر"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138845",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[4755,"أنا والليلْ والدمعه","https://www.poetsgate.com/ViewPoem.aspx?id=183520",""],[4755,"ضَحِكْنَا وجُرحٌ ما بأَعماقِنا بَكَى","https://www.poetsgate.com/ViewPoem.aspx?id=190326",""],[4767,"فداك الكون","https://www.poetsgate.com/ViewPoem.aspx?id=178772",""],[4831,"أين صحوة العربي","https://www.poetsgate.com/ViewPoem.aspx?id=208042",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5256,"أنادي إلهي بيا ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=157390",""],[5447,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=208363",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""],[5605,"بنا عجب","https://www.poetsgate.com/ViewPoem.aspx?id=159671",""],[5725,"عشرون مرّت","https://www.poetsgate.com/ViewPoem.aspx?id=195080",""],[6069,"وحق الهوى لا خنت ميثاق عهده","https://www.poetsgate.com/ViewPoem.aspx?id=105662",""],[6147,"ترشف ..من دموعي..","https://www.poetsgate.com/ViewPoem.aspx?id=151494",""],[520,"أرى كل جمع بالردى يتفرق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577582",""],[6268,"عَدُّودَةُ الخُروج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82921&r=&rc=7",""]],"verses":[["وَقُلنَ عَهِدنا فَوقَ عاتِقِ ذا الفَتى","رِداءً مِنَ الحَوكِ الرَقيقِ فَما صَنَع",0,"ع",1,0],["وقُلْنا بَنو سُبْلٍ جَوانِحُ للقِرَى","فقالَ زَعيمُ القوْمِ رحْباً وتأنيسا",1,"س",2,0],["وَقْلنا وَقَدْ رَدّ اَلْوُجُوهَ وَلَمْ يُبَلْ","قَليلُ الْحَياَ وَاَللّهِ أصْبَحْتَ مِن عَامِ",2,"م",1,0],["وقُلْنَ بْشِري بلِقاءِ الإمامِ","فجاءَتْ مُيَمِّمةً بالصّعيدْ",3,"د",1,0],["وَقُلنا لِفِتيانٍ كِرامٍ أَلا اِنزِلو","فَعالوا عَلَينا فَضلَ ثَوبٍ مُطَنَّبِ",4,"ب",1,0],["وَقُلنَ وَقَد يَكذِبنَ فَيكَ تَعَيَّفٌ","وَشُؤمٌ إِذا ما لَم تُطَع صاحَ ناعِقُه",5,"ق",2,1],["وَقُلنَ أَلا هَل مِن شِفاءٍ يَنالُهُ","وَقَد مُنِعَ الشِفاءَ مَن هُوَ نائِلُه",6,"ل",2,0],["وَقُلنَ تَرَوَّح لا تَكُن لَكَ ضَيعَةً","وَقَلبَكَ لا تَشغَل وَهُنَّ شَواغِلُه",7,"ل",2,0],["وَقُلنا اِنتِظارٌ وَاِئتِمارٌ وَقُوَّةٌ","وَجُرثومَةٌ عادِيَّةٌ لَن تَهَدَّما",8,"م",2,0],["وقلنا له هل ذاك فاستغن بالقرى","ومن ذي الأداوي عندنا لك مشربُ",9,"ب",1,0],["وَقُلنا أَوقِدِ النارَ","لِطُرّاقٍ وَزُوّارِ",10,"ر",1,0],["وَقُلنا صَدَقتَ رَسولَ المَليكِ","هَلُمَّ إِلَينا وَفينا أَقِم",11,"م",1,0],["وقلنَ كفاكَ بالشيبِ امتهاناً","وبالصَّرمِ المُعَجَّلِ من عِقابِ",12,"ب",1,0],["وقلن ذوقوا جناكم إن جانيكم","ما زال للحنظل الخطبان نقافا",13,"ف",2,0],["وَقُلنَ لِحاديهِنَّ وَيحَكَ غَنِّنا","بِحَدراءَ أَو بِنتِ الكِنانِيِّ فَدفَدا",14,"د",2,0],["وَقُلنا لِساقينا عَلَيكَ فَعُد بِنا","إِلى مِثلِها بِالأَمسِ فَالعَودُ أَحمَدُ",15,"د",1,0],["وَقُلنَ لَهُ حُثَّ الجِمالَ وَغَنِّها","بِصَوتِكَ وَالحادي أَحَثُّ وَأَنجَحُ",16,"ح",1,0],["وَقُلنا لَها قَولاً فَجاءَت بِمِثلِهِ","لِكُلِّ كَلامٍ يا بُثَينَ جَوابُ",17,"ب",1,0],["وَقُلنا لَها أَينَ أَرضُ العِراقِ","فَقالَت وَنَحنُ بِتُربانَ ها",18,"ا",1,0],["وَقُلنا اللَيثُ يَغدو مِن قَريبٍ","فَيَفرِسُ إِن أَحَسَّ حَسيسَ مالِ",19,"ل",1,0],["وَقُلنَ لَها يا هِندُ لا تَبعُدي بِنا","فَإِنّا نَخافُ اللَيلَ أَن يَتَقَفَّرا",20,"ر",2,0],["وَقُلنَ لِلَيلى حَدِّثينا فَلَم تَكَد","تَقولُ بِأَدنى صَوتِها المُتَهانِفِ",21,"ف",1,0],["وقلنا هذه الرحم","ة جاءت فأظلتنا",22,"ن",2,0],["وقلنا يا لحاك الل","ه نزني بعدما شبنا",22,"ن",2,0],["وَقُلنا لَها مَر","حَباً مَرحَبا",23,"ب",2,0],["وَقُلنَ لَها وَالعَينُ حَولَكِ جَمَّةٌ","وَمِثلُكِ بادٍ مُستَشارٌ مَقامُها",24,"م",3,0],["وَقُلنَ لَوَ اِنَّ اللَهَ شاءَ لَقيتَنا","عَلى غَيرِ هَذا مِن مَقامٍ وَمِن شُغلِ",25,"ل",1,0],["وَقُلنَ مَتى بَعدَ العَشيَّةِ نَلتَقي","لِميعادِنا هَيهاتَ هَيهاتَ لِلوَصلِ",25,"ل",1,0],["وَقُلنَ اِمكُثي ما شِئتِ لا مَن أَمامَنا","نَخافُ وَلا نَخشى مِنَ الآخِرِ اللَحَق",26,"ق",1,0],["وَقُلنا كَريمٌ نالَ وَصلَ كَرائِمٍ","فَحَقَّ لَهُ في اليَومِ أَن يَتَمَتَّعا",27,"ع",2,0],["وَقُلنَ إِذا قُضى وَطَراً","وَأَدرَكَ حاجَةً هَجَرَك",28,"ك",1,0],["وَقُلنَ أَهَذا دَأبُكَ الدَهرَ سادِراً","أَما تَستَحي أَو تَرعَوي أَو تُفَكِّرُ",29,"ر",1,0],["وَقُلنَ مَقيلُنا قَرنٌ","نُباكِرُ ماءَهُ صُبُحا",30,"ح",2,0],["وَقُلنَ تَزَوَّج وَاِرعَ ما كانَ بَينَنا","أَجارَكَ مِن رَيبِ الزَمانِ مُجيرُ",31,"ر",1,0],["وَقُلنَ أَنطَلِق لا كانَ آخر عَهدِنا","بِمَلقاكَ في سِترٍ سُترتَ سَتِيرِ",32,"ر",1,0],["وَقُلنَ إِذ حَقَّ الأَثَر","وَجَدَّ رَميٌ فَاِستَمَر",33,"ر",1,0],["وَقُلْنا المَوتُ مالا بُدَّ مِنْهُ","فماذا بَعْدَ ذلِكَ أنْ يَكُونا",34,"ن",2,0],["وَقُلنَ لَحى اللَهُ رَبُّ العبادِ","جَنُوبَ السِخالِ إِلى يَترَبِ",35,"ب",1,0],["وقُلْنا لِلنفُوسِ لعلَّ عُمراً","يَطُولُ بِنا وَأَطْوَلُهُ قَصيرُ",36,"ر",1,0],["وَقُلْنَا لِساقِينَا أَدِرْهَا فَإِنَّمَا","بَقَاءُ الْفَتَى بَعْدَ الشَّبَابِ يَسِيرُ",37,"ر",1,0],["وَقُلْنَا لِساقِينَا أَدِرْها فَإِنَّما","قُصَارَى بَنِي الأَيّامِ أَنْ يَتَشَعَّبُوا",38,"ب",3,0],["وَقُلنا لَنْ يُفْرِّجَ ما لَقِينا","سِوَى ضَرْبِ القوانِسِ والجِهادِ",39,"د",1,0],["وَقُلنا لِفِتيانٍ كِرامٍ أَلا اِنزِلوا","فَعالوا عَلَينا فَضلَ ثَوبٍ مُطَنَّبِ",40,"ب",1,0],["وقلنا: جاء حلاَّلُ القضايا","ومقتحمُ الحواجز والسُّدود",41,"د",1,0],["وقلنا: فيك للطَّاوين زاد","وللشاكين من عُرْىٍ دِثارُ",42,"ر",1,0],["وقلنا: فيك عيشُ ليس فيه","خصَامٌ بين أهلِك أو شِجَار",42,"ر",1,0],["وقلن أبشري بلقاء الإمام","فجاءت ميممة بالصعيد",43,"د",1,0],["وقلنا أتى من وراء الحدود","جراد غريب فأشقى الربوع",44,"ع",1,0],["وَقُلْنَ: «أَهَذا دَأْبُكَ الدَّهْرَ سادِراً","أما تستحي أم ترعوي أم تفكر؟\"",45,"ر",1,0],["وقلنَ لها والعينُ حولك جمة ٌ،","وَمِثْلُكِ بَادٍ، مُسْتَثارٌ مَقَامُها:",46,"م",3,0],["وقلنَ: امكثي ما شئتِ لا من أمامنا","نَخَافُ، وَلاَ نَخْشَى مِنَ الآخِرِ کللَّحَقْ",47,"ق",1,0],["وقلنا ، كما قال المجدّون ، من غفى","عن الفوز لم يظفر ومن جدّ أفلحا",48,"ح",2,0],["وقلن تزوج ثم دع ما كان بيننا","أجَارَكَ مِنْ رَيْبِ الزَّمَانِ مُجيرُ",49,"ر",1,0],["وقلن للصحب واروا بعض أعظمه","في تل إربد أو في سفح شيحان",50,"ن",1,0],["وقلنا قد يُزاحُ السترُ","أوقد نَلحَقُ الظَعنا",51,"ن",2,0],["وقُلنَا خَبَّرَتنَا النَّاسُ عَنكُم","فَقَالَ دَعُوا الكَثِيرَ مِنَ الكَلاِم",52,"م",1,0],["وَقُلنا وَقَد شِمناهُ بَرقَ تَوَقُّدٍ","رَضينا بِخَيرِ العالَمينَ مُحَمَّدٍ",53,"د",1,0],["وَقُلْنا بِها وَلِضَوءِ الصَّباحِ","عَلَى عَنْبَرِ الفَجْرِ مِنْهُ خَلوقُ",54,"ق",1,0],["وقلنا صواب الرأي تسكين أمرهم","وشربك إيام على كدر أولي",55,"ل",2,0],["وقلنا ألا موت يباع فيشترى","ويظفر ملهوف بأكرم ميتة",56,"ه",1,0],["وَقُلنا لِأَبناءِ المُلوكِ تَوَقَّعُوا","لَهُ فَرَجاً يَأتي بِهِ اللَهُ عاجِلا",57,"ل",2,0],["وقلنا يا بني إسحاق ضرطا","تواضعت الإمارة والوزاره",58,"ر",2,0],["وَقُلنا نَرتَجيكَ إِذا اِرتَضاهُ ال","خَليفَةُ لِلعُلى سَكَناً وَخِدنا",59,"ن",2,0],["وَقُلْنَا وَالْكَفِيلُ بِمَا طَلَبْنَا","سَخَاؤُكُمُ الذِي أَغْنَى الْمُعَنَّى",60,"ن",2,0],["وقُلنا نحن عُزلٌ فارحَمُونا","ولا تَتَلَطّخوا بدَمٍ زكيِّ",61,"ي",1,0],["وَقُلنَ أَلا البَردِيُّ أَوَّلُ مَشرَبٍ","نَعَم جَيرِ إِن كانَت رِواءً أَسافِلُه",62,"ل",2,0],["وقُلنا اليوم حان لنا مُناخٌ","به تُلقى مع اليُمْنِ العِصيّ",63,"ي",1,0],["وَقُلنا اللَهُ أَكبَرُ وَهوَ فَجرٌ","إِذا ما لاحَ قَد سُمِعَ الأَذانُ",64,"ن",1,0],["وَقُلنا الأَماني البيضُ يُدرِكُ بَعضُها","أَلَيسَ المَنايا السودُ خاتِمَةَ العَمرِ",65,"ر",1,0],["وَقُلنا بِأَن اللَهَ لا شَيء مِثلُهُ","هُوَ الواحِدُ الفَردُ العليُّ المُمَجَّدُ",66,"د",1,0],["وَقُلنا بِأَنَّ اللَهَ عَدلٌ وَأَنَّهُ","يُكَلِّفُ دونَ الطَوق ما هو أَحمدُ",66,"د",1,0],["وقلنا لك خير النبيين أحمد","توفي عن تسع وذاك المشرع",67,"ع",1,0],["وقلنا لكم أصحابه لاغترابهم","عن الأهل في أسفارهم قد تمتَّعوا",67,"ع",3,0],["وَقُلنا أَينَ نَرحَلُ بَعدَ مَعنٍ","وَقَد ذَهَبَ النَوالُ فَلا نَوالا",68,"ل",2,0],["وقلنا لقد غاضَ الوفاء وأَقْلَعَتْ","بوابل منهلّ القطار الغمائم",69,"م",1,0],["وقلنا له هاتِ الصَّبوح فكلُّنا","يُريدُ شفاءً بالطّلا من خماره",70,"ر",2,0],["وقُلْنَا للمُسائِلِ عن عُلاهُ","تَسَمَّعْ قد وَقَعْتَ على الخَبيرِ",71,"ر",1,0],["وقُلُنْيَةٌ أَنشأْتَ فِيهَا عارِضاً","للحربِ أَبْرَقَ بالحتوفِ وأرعدا",72,"د",2,0],["وقلنا والإله بنا عليم","إليك إليك فارقنا ذنبا",73,"ب",2,0],["وقلنا في الكرام بما رأينا","عِياناً أو نقلناه سماعا",74,"ع",2,0],["وقُلن تلوّنت لك حين ملَّت","وليس على الملالة كلُّ هجرِ",75,"ر",1,0],["وقلنا الحياة حياة إخاء","وقالوا الحياة حياة انقسام",76,"م",1,0],["وقلنا بصيص من النور علما","فحتام والتونسي في ظلام",76,"م",1,0],["وَقُلنا لما كانَ صعبَ المَذا","لِ من سَبَلِ العين لا تَصعُبِ",77,"ب",1,0],["وقُلْنا في غداةِ العي","دِ كُوني عِنْدَنا بُكْرَهْ",78,"ر",2,0],["وقَلْنا حَكى رِيمَ الفَلاَ في نِفَارِه","فما بالُه لم يحكِهِ في التَّلفُّتِ",79,"ت",1,0],["وَقُلنا لَهادينا الفَلاةَ فَإِنَّنا","رَجِعنا إِلى آبائِنا وَشُئونِها",80,"ن",3,0],["وَقُلنا في الَّتي بِقَولٍ","مَعاذَ اللَهِ مِن قيلٍ وَقالِ",81,"ل",1,0],["وقلنا هو المهديُّ والقائمُ الذي","يَعيش به من عِدْلِه كلُّ مُجْدِبِ",82,"ب",1,0],["وقلنا فلم نسمع عتاباً من الذي","نعادي ولم نبلغ رضى من نحالف",83,"ف",1,0],["وقِلنا بها كراماً","وبتْنا بها ندامى",84,"م",2,0],["وَقلْنَا هُوَ الذئْبُ فاشْفِقْ عَلى","بَنِيك َفهُمْ عُصْبَةٌ يَا أبَانَا",85,"ن",2,0],["وَقلنا نفتشُ عنْ مَوطِنٍ","بِلا قسْوةٍ أوْ أسَىً أوْ ضغونْ",86,"ن",1,0],["وقلن لنا أهلٌ قريبٌ فنتَّقي","عيونَ يقاظى مِنهُمُ وكلابا",87,"ب",2,0],["وقُلنا مهِّلوا لثنِيَّتَيهَا","لكي تزدادَ للسَّفرِ اضطلاعا",88,"ع",2,0],["وَقُلنا عَسى الأَسفارُ يُسفِرُ وَجهُها","بِأَمر لَنا نَرضاهُ يَجمُلُ بِالحُرِّ",89,"ر",1,0],["وَقُلنا بِلا عِيٍّ وَسُسنا بِطاقَةٍ","إِذا النارُ نارُ الحَربِ طالَ اِشتِعالُها",90,"ل",3,0],["وقُلنَ إَعجَلا لا عَينَ نخشى وأَبشِرا","بليلةِ سَعدٍ غابَ عنها ظَنُونُها",91,"ن",3,0],["وقلن لخوِّ اليوم لما وجدته","بسروح واد ذي أراك وتنضبِ",92,"ب",1,1],["وقلنا زعيم الطالبيين أحدقت","بجنب علاه شيبها وكهولها",93,"ل",3,0],["وَقُلْنَا لَهُ أهْلاً وَسَهْلاً وَمَرْحَبَاً","نُقَبِّلْ يَدَيْهِ مِنْ هَوَى وَتَوددِ",94,"د",1,0],["وقلنا سر بنا إنا لجمع","أراد لك القتال مقاتلونا",95,"ن",2,0],["وقلنا الهاشمون أحق منكم","ونحن لهم عليكم مايلونا",95,"ن",2,0],["وقلنا له: الإسلام يعلو ولم يكن","ليعلى، فقال: العلم يؤتى ولا ياتي",96,"ي",1,0],["وقلنا لهم أهلاً وسهلاً ومرحباً","نمد يدينا من هوىً وتودُّدِ",97,"د",1,0],["وَقُلنَ لَنا نَحنُ الأَهِلَّةُ إِنَّما","تُضيءُ لِمَن يَسري بِلَيلٍ وَلا تَقري",98,"ر",2,0],["وقُلنا عَسى أن يَنتهوا عن فعالِهم","فيستَوجِبوا منَّا لأن نغفِرَ الذَّنبا",99,"ب",2,0],["وقلنا لهم ذُوقوا وبال أموركم","فمن يَسق مُرَّ الماءِ لا يشرب العَذبا",99,"ب",2,0],["وقل نعَم إذ سَنَحت يُمناً","تُضِف سَمِيحاً إلى سَنيحِ",100,"ح",1,0],["وَقُلنا سَقَتكَ غَوادي الجُفونِ","إِذا لَم تَجُدكَ غَوادِيَ الرِهَم",101,"م",1,0],["وقل نصب الناس الخطوب وبايعوا","لها فاخلع الجور الذي شمل الورى",102,"ر",2,0],["وقلنا طب به نفساً وارخ","رأينا طلعةَ القمر العلي",103,"ي",1,0],["وقلنَ لنا نحن الاهلَّة انما","نزيد عليها بالمهابة والقدرِ",104,"ر",1,1],["وَقُلنا لَعلَّ الماءَ يَربو فَنَقتَني","وَعَلَّ غُلاماً ناشِئاً يَتَرَعرَعُ",105,"ع",1,0],["وَقُلنَ أَتَيتَ اليَومَ ما لست خافِياً","وَبادَهتَ أَمراً كنت قِدماً تُحاوِلُه",106,"ل",2,0],["وقلنا نحن كيف وراحتاه","بحور يلتظي فيها سعير",107,"ر",1,0],["وقلن له هل من طريف وتالد","من المال إلا أنت في الحق باذله",108,"ل",2,0],["وقلنا اقتليه يا مليح فإنه","متى ما رمى كانت مراميه حذما",109,"م",2,0],["وَقُلنا لَهُ لا تَنسَ صِهرَكَ عِندَنا","وَلا تَنسَ مِن أَخلاقِنا ما نُجامِلُه",110,"ل",2,0],["وقلن لربَّاتِ الغرامِ تأنُّفا","تقاصرنَ عنَّا ذا زمان الفواطِمِ",111,"م",1,0],["وقلنا اصطبارا عل ما بفؤادنا","يزول إذا نحن التزمنا التصبرا",112,"ر",2,0],["وقلنا ونحن القوم نمنع سربنا","على ذاك كنا في الخطوب الأوائل",113,"ل",1,0],["وَقُلنا أربيلُ تُحاصر أَبداً","وَلم تَخف مِن كيد أَشرارِ العِدا",114,"د",2,0],["وقلنا بأرض الجامعين وبابل","وقد أفسدت فينا الأعارب والكرد",115,"د",1,0],["وَقُل نَسينا فَخارَ الفاتِحينَ وَما","نَنسى المَجانِينَ حَتّى يغمرَ الغمرُ",116,"ر",1,0],["وَقُلنَ تَمَتَّع لَيلَةَ اليَأسِ هَذِهِ","فَإِنَّكَ مَرجومٌ غَداً أَو مُسَيَّفُ",117,"ف",1,0],["وَقُلنَ أَبوكُم شِقوَةٌ لَحِقَت بِكُم","كَذَبنَ وَلَكِن هُنَّ إِحدى النَظائِرِ",118,"ر",1,0],["وقلن فلتنظروا بدورا","ولتصفوا حسنها العجيب",119,"ب",1,0],["وقلنا كالحسام العضب عزماً","نفاق غراره قطعاً وحدا",120,"د",2,0],["وَقُلْنَا مَتَى عَهْدُ الرِّياسَة بِالنَّوى","فَقالُوا استَقَلَّتْ مُنْذُ سَبْعٍ إِلى الجَنَّا",121,"ن",2,0],["وقلنَ وقد أَنكرننى بعدَ صَبْوَةٍ","صَددْتَ وشيءٌ ما دعاكَ الى الصَّدِّ",122,"د",1,0],["وَقُلنا لَهُم والخَيلُ تَردى بِنا مَعاً","نُحارِبُ مَن حارَبتُمُ ونُحالِفُ",123,"ف",1,0],["وقُلنَ أَلا يا العَبنَ ما لَم يَرُدَّنا","نُعاسُ فإِنَّا قَد أَطَلنا التَنائيا",124,"ي",2,0],["وَقُلن لِمِثلِ الرِئمِ أَنت أَحَقُّنا","بنزع الرِداء إِن أَرَدت تَخالِيا",124,"ي",2,0],["وقُلنَ لطفلةٍ منهنَّ ليستْ","بمِتفالٍ ولا هَمَشى الكلامِ",125,"م",1,0],["وقُلنَ لها سرّاً وقَيْناكِ لا يَرُحْ","صحيحاً وإنْ لم تقتليهِ فألْمِمي",126,"م",2,0],["وَقُلنا أَلا مَن يَحيَ لا يَخزَ بَعدَها","وَمَن يُشتَعَب لا تَتَّبِعهُ المُلاوِمُ",127,"م",1,0],["وَقُلنا لِقَيسٍ أَصعِدوا فَتَصَعَّدوا","وَشَيبانَ عَنّا اِبعِدوا وَاللَهازِمُ",127,"م",1,0],["وقلنا لهم نصر الإله لحزبه","به جاء في القرآن والسنة الوعد",128,"د",1,0],["وَقُلنَ مَضَت بِشِرَّتِكَ اللَيالي","فَقُلتُ نَعَم وَقَد رَثَّ السِلاحُ",129,"ح",1,0],["وقل نَعَم ونُعمة العين وقل","نُفاية المأكول بئس ما أُكل",130,"ل",1,0],["وقُلن على الفِردَوسِ أوَّلُ مُشرَبٍ","أجل جَيرِ ان كانت أُبيحَت دَعاثِرُه",131,"ه",1,1],["وَقلنا انظروا البدع اليَوم وانجوا","بخضرائنا من رجال الخَديعة",132,"ع",2,0],["وقلن لقد لبثت فقلت إنى","إذا خفت العداة كذاك فعلى",133,"ل",2,0],["وقلنا سَلوا الأقوامَ عنَّا وعنكُمُ","عن الدينِ والأحسابِ كيف نُماضِعُ",134,"ع",1,0],["وَقُلنَ أَلا مِن أَينَ أَقبَلَ ذا الفَتى","وَمَنشأُهُ إِمّا تُهامَةُ أَو نَجدُ",135,"د",1,0],["وَقُلْنَا عَلِيٌّ لَنَا وَالِدٌ","وَنَحْنُ لَهُ طَاعَةٌ كَالْوَلَدْ",136,"د",1,0],["وَقُلنَ لَنا نَحنُ الأَهِلَّة ما لَنا","هَوى بَدرُنا بِالرَغمِ مِنّا إِلى القَبرِ",137,"ر",1,0],["وقُل نال المنى في أرخ صبرٍ","لمجد كرامةٍ هذي بشارَه",138,"ه",1,0],["وقلن لشمرٍ ويك يا شمرُ خَلِّهِ","ترى عنك رب العرش في الحشر راضيا",139,"ي",2,0],["وقلنا له خذ بعض ما كنت منعماً","به وقضاء الحق بالحر أليق",140,"ق",1,0],["وقلنا للقَلَق رجعَه","دخولك بيننامن وَين؟!",141,"ن",1,0],["وقُلنا: غَدًا يا جُرحُ لِلثأرِ عَودةٌ","فَلَن يَغلِبَ المَكرُوهُ مَهما تَمَسَّكا",142,"ك",2,0],["وقُلنا لِمن باتُوا جياعًا: تَمَاسَكُوا","ولا تُفطِرُوا إِلَّا إِذا الأَسرُ أَمسَكا",142,"ك",2,0],["وقلنا فيه رؤيتنا","فبان الحق والْمُثُل",143,"ل",1,0],["وقلْنا إذْ تخاذلْنا","لَنَا عَوْدٌ إلى الحَلَبِ",144,"ب",1,0],["وقلن نساء في المدينة راودت","فتاها هوى بما رماها فما أومى",145,"م",2,0],["وقلنا إلهي فلا ملتجا","ولا يغفر الذنب قط سواك",146,"ك",1,0],["وقلنا -إذ تلوتَ العهدَ صبحًا-:","سنمشي عند فرحتنا الهوينى",147,"ن",2,0],["وقلنا وطلنا واعتلينا بعزمنا","وسدنا إلى أن ما وجدنا لنا ضدا",148,"د",2,0],["وَقُلْنا لَها حَبَّذا طَلْعَةٌ مِنْ","جَمالِكِ بالحُسْنِ وَافَتْ كَمالا",149,"ل",2,0],["وقلنا أننا عَرَبٌ","لدين الحق ننتسب ُ",150,"ب",1,0],["وقلنا يا لوعة الايام رفق صبا","مازال فينا فلول الشوق تأتلفُ",151,"ف",1,0],["وقلن لساقيها ودر حبابها","موكلةٌ أيدي المزاج بنضده",152,"د",2,0],["وقلنا..بل ..وما قلنا..بَكِمْنا","عجَنّا الروح خوفا وارتباكا",153,"ك",2,0],["وقلنا له خذ بعض ما كنت منعما","ودر معانٍ من معانيك يسرق",154,"ق",1,0],["و( قلندول ) وردةٌ قَطَفَتهَا","كفُ من أشبع ( الكنانة ) سَطوَا",155,"و",2,0]]}