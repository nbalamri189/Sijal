{"poems":[[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[74,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[226,"أمل قطع حبل الأمل","https://www.aldiwan.net/poem55299.html","الرمل"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59426","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113918","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101016","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204733","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69908","الكامل"],[5186,"تلك الخمائل ما تمايل بأنها","https://www.poetsgate.com/ViewPoem.aspx?id=156464",""],[5386,"يحمدون الموت","https://www.poetsgate.com/ViewPoem.aspx?id=35634",""],[5433,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=36120",""],[5694,"اعشقك نجد","https://www.poetsgate.com/ViewPoem.aspx?id=132105",""]],"verses":[["يَومَ صَومٍ مِن الظَهيرَةِ أَو يَو","مَ حَرورٍ يُلَوِّحُ اليَعفورا",0,"ر",2,0],["يوم صحوٍ فاجْعله لي يوم سكرٍ","وأدر لي كأسيْ رضاب وخمر",1,"ر",1,1],["يومُ صدْقٍ بَنَتْ يَدُ اللّه فيه","مُلْكَهُمْ فوق رأسه الموطودِ",2,"د",1,0],["يوم صاح النعي قلت له تباً فما","هذا منك غير اختلاق",3,"ق",1,0],["يومَ صبَّتْ فوقَ بيروت الحِماما","لم تَذَرْ شيخاً ولم ترحمْ غُلاما",4,"م",2,0],["يَوْمَ صَبْرِي هَدَمْتَ لِلْمَجْدِ رُكْناً","وتَرْكْتَ الْعَلْياءَ أُمّاً ثَكُولاَ",5,"ل",2,0],["يَوْمَ صَبْرِي أَغْمَدْتَ في التُرْبِ سَيفاً","حِينَ جَرَّدْتَ سَيْفَكَ الْمَسْلولاَ",5,"ل",2,0],["يوم صحبي يتهادى كلهم","كالسكارى حول ذاك المنهل",6,"ل",1,0],["يومَ صَبا قلبي إلى طَرْفه","فقلتُ إيّاكَ وإيّاه",7,"ا",2,0],["يؤمّ صحابة أحنوا عليه","يفدوه ويالك من تفادي",8,"د",2,0],["يؤم صفاء يوم بيضهم","فالفتح والنصر إن ركن القنا انحطما",9,"م",2,0],["يومَ صالَت عليهمُ من قُرَيشٍ","والعُرى من كنانَةَ الأملاءُ",10,"ا",2,0],["يوم صبري لا صبر فيك فقدنا","صفوة الأصفياء والأُلّاف",11,"ف",1,0],["يوم صاحت به المقادير رعباً","لبني أحمد ومن يرعاها",12,"ا",3,0],["يؤم صنوف الباحثين زويتي","وقد كنت أهوى أن أرى خامل الذكر",13,"ر",1,0],["يَومٌ صَفا بِنَقائِهِ وَبَهائِهِ","وَنسيمِهِ وَنَعيمهِ المشاكرِ",14,"ر",1,0],["يوم صحافته صحاف مطامع","طبخت بلحم بني الحمى ألوانها",15,"ن",3,0],["يوم صلّى الإنس في توبة حقيقة أو تجنّي","صلّت الدنيا على ثيابي وودّعت العفن!",16,"ن",1,0],["يوم صلّوا يحمدون الموت ميلادي رفعني","ما توفّاني ظلامك ( للسما جود وزمن",16,"ن",1,0],["يوم صارت مابين القلب والهامه","وش ابي بالحياة الياانحنى راسي",17,"س",2,0],["يوم صاب القوم خفه وإرتعادي","نومس العذراء وحبتها وسامه",18,"م",2,0]]}