com/ViewPoem.aspx?id=49548",""],[5136,"أودى بحمد الله عامر","https://www.poetsgate.com/ViewPoem.aspx?id=121599",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5186,"يا ناثر النظم الأرق الأنفس","https://www.poetsgate.com/ViewPoem.aspx?id=156549",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5281,"الفاجِعَة","https://www.poetsgate.com/ViewPoem.aspx?id=199665",""],[5281,"واااوطناه","https://www.poetsgate.com/ViewPoem.aspx?id=199750",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5387,"أمي..","https://www.poetsgate.com/ViewPoem.aspx?id=53896",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5409,"علموا الميسر العروب وقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=155317",""],[5431,"الشعر واللين...","https://www.poetsgate.com/ViewPoem.aspx?id=202299",""],[5431,"كيف تقهر؟","https://www.poetsgate.com/ViewPoem.aspx?id=207618",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5582,"نَفْسُ المُتَيَّمِ لَوْ ظَلَلْتَ تَلُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=187301",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""],[5691,"زمان الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=206311",""],[5717,"ومن شرائط النبي حمله","https://www.poetsgate.com/ViewPoem.aspx?id=170604",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5957,"لَكَ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=12232",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[161,"إحْصَاءُ عَامِ قَدْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""],[285,"قُل للأمير: يا كريم الجنسِ","https://www.poetsgate.com/ViewPoem.aspx?id=86294",""],[6102,"زيشان","https://www.poetsgate.com/ViewPoem.aspx?id=184170",""],[6124,"وريد","https://www.poetsgate.com/ViewPoem.aspx?id=120026",""],[469,"وعصبة كان يرجى سيب واحدهم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574784",""],[520,"إن السعادة قد اظل زمانها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577667",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[6361,"شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66814&r=&rc=44",""]],"verses":[["وَعَصائِبُ اليَمَنِ الَّذينَ تَبَوَّأوا","قُلَلَ الهِضابِ وَشَرَّدوا الأَوعالا",0,"ل",2,0],["وَعُصبَةٍ جاذَبوكَ العِزِّ فَاِنقَبَضَت","أَكُفُّهُم عَن دِراكِ المَجدِ بِالطَلَبِ",1,"ب",1,0],["وعَصْرٌ رَقيقُ الطُّرَّتَيْنِ تدرّجَتْ","على صَفحَتَيْهِ نَضْرَةٌ وقَبولُ",2,"ل",1,0],["وعُصْبَةٍ مُلِئَتْ أسْماعُهُمْ كَلِماً","ظَلِلْتُ أخْلُقُها فيهِمْ وأَفْريها",3,"ي",3,0],["وعُصبَةٍ مُلِئَتْ غَيظاً صُدورُهُمُ","منْ مُخفِرٍ ذِمّةً أو قاطِعٍ رَحِما",4,"م",2,0],["وعُصبةٍ لا تُطيفُ المَكرُماتُ بها","ولا تُليحُ مِنَ الفَحشاءِ والهُونِ",5,"ن",1,0],["وعُصْبةِ شرٍّ منْ يَهودٍ لَقيتُها","يُجانِبُها داعي الهُدَى ويُحاشيها",6,"ي",3,1],["وَعَصْرُ مِصْرَ الَّذِي فَاقَتْ رَوَائِعُهُ","أيَ الأَجَدَّيْنِ مِنْ فَخْمٍ وَمُزْدَانِ",7,"ن",1,0],["وَعَصاكَ إِستُكِ تَتَّقينَ بِها","دَقَّ العُجايَةَ عارِيَ الفِهرِ",8,"ر",1,0],["وعصبة تدعي علماً وقد جهلت","أنشقت آنافها نكباء تجتدع",9,"ع",1,0],["وعصر حلا جملت مرآه برهةً","وخلّفته ينعي أتمّ رجاله",10,"ل",2,0],["وعصبة يحذقون مدحكمُ","من مجدكم جاء حذق حاذقها",11,"ق",3,0],["وَعَصَرتَ نُطفَتَها لِتُدرِكَ دارِماً","هَيهاتَ مِن مَهَلٍ عَلَيكَ بَعيدِ",12,"د",1,0],["وعصماء منها كل بيت كدمعة","على الراحل المبكى من كل واحد",13,"د",1,0],["وَعِصابَةٍ بِالخَيرِ أُلِّفَ شَملُهُم","وَالخَيرُ أَفضَلُ عُصبَةً وَرِفاقا",14,"ق",2,1],["وَعَصرٌ بَنوهُ في السِلاحِ وَحِرصُهُ","عَلى السِلمِ يُجري ذِكرَهُ وَيُديرُ",15,"ر",1,0],["وَعَصائِبٍ يَتَهافَتونَ إِذا اِرتَمى","بِهِمُ الوَغى في غَمرَةِ الهَيجاءِ",16,"ا",2,0],["وَعَصَيتَ رَبَّكَ يا اِبنَ آدَمَ جاهِداً","فَوَجَدتَ رَبَّكَ إِذ عَصَيتَ حَليما",17,"م",2,0],["وَعَصرِ الرِضا إِنّي لَدَيكَ لَفي خُسرِ","بِمَطلي وَقَلبي فيكَ لَم يَرضَ بِالصَبرِ",18,"ر",1,1],["وعصبةِ لهوٍ غادروا الهمّ جانباً","فلم يألفوا إلّا السرورَ جَنَابا",19,"ب",2,0],["وعصابَةٍ لِلْحَينِ قادَ بها","ظُلْمُ النّفوسِ وساقَها الأشَرُ",20,"ر",1,0],["وعَصمٌ إذا استَعصَمن في شاهِقٍ رَقَتْ","إِلَيها بنات الدّهْرِ في المرْتَقَى الصّعبِ",21,"ب",1,0],["وَعُصِمتَ بِاللَيلِ البَهيمِ وَقَد","أَلقى عَلَيكَ ظَلامُهُ حُجبا",22,"ب",2,0],["وعصرُ شبابٍ في سباتٍ قطعْتُهُ","وفي أرضِ حَنْدُوثينِ في ذلكَ الفضا",23,"ض",2,0],["وَعَصَيتُ فيكِ أَقارِبي فَتَقَطَّعَت","بَيني وَبَينَهُمُ عُرى الأَسبابِ",24,"ب",1,0],["وَعصيّ مِن الدُمو","ع طَغى الهَم فَاِنهَمَر",25,"ر",1,0],["وَعَصرَ شَبابٍ كانَ مَيعَةَ حُسنِهِ","وَظِلّاً مِنَ الدُنيا عَلَيهِ مُنَشَّرا",26,"ر",2,0],["وعَصانِي نَظْمُ القَرِيضِ الذي جَر","رَ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",27,"ر",1,0],["وَعِصَابَةٌ ما صَدَّقَتهُ وَأَكثَرَت","بالإِفكِ والبُهْتانِ فيهِ القِيلا",28,"ل",2,0],["وَعَصَبَت في هَمِّها قَدورُ","وَصِبيَةٌ أَكبَرُهُم صَغيرُ",29,"ر",1,0],["وعَصْرُ المَدى من قَبله كان عصرَها","وعهْدُ أبينا بَعدَها ولها اليُتم",30,"م",1,0],["وعصَتْ من عواصِفِ الحَرْبِ أمْراً","قَبِلَتْهُ مِنْ شَمْأَلٍ وجَنوب",31,"ب",1,0],["وعصبة على هدى الأحبار","أهل كتاب يعبدون الباري",32,"ي",1,0],["وَعِصَابَةٍ غَلَبَ الْكَمَالُ عَلَى","أَخْلاقِهِمْ وَغَذَاهُمُ التَّرَفُ",33,"ف",1,0],["وَعُصْبَةٍ كَانَتْ لأَمْوَالِهَا","مَظنَّةَ الْفَقْرِ بِهَا ذَاخِرَهْ",34,"ر",2,0],["وعصابة، ملأ المناخر نَتْنُها","خضعت طوائفكم لها وطقوسها",35,"س",3,0],["وعصا ناصر تَفُلُّ صواري","خ الأعادي، وبِيضَها المرهفات",36,"ت",1,0],["وعصرت الشجون في الروضة ال","غنّا لحونا أندى وفنّا أغنّا",37,"ن",2,0],["وعصاني نظمُ القريضِ الذي ج","رَّ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",38,"ر",1,0],["وعصرٌ تَناهضَ فيه الجمادُ","عجيبٌ به يجمُدُ النَّاهضونا",39,"ن",2,0],["وَعَصراً بِهِ كُنت غَض الشَبا","ب وَحَبلبي مُلقى غَلى غارِبي",40,"ب",2,0],["وعصائبنا زعموا العلوم تخبطا","فالقيل غاية علمهم والقال",41,"ل",1,0],["وعصر اذا لامست اذيال طوره","ترى منه امواه العجائب تقطر",42,"ر",1,0],["وعَصرٌ تَقَلَّدَ رِفعَةً وفَخَامَةً","وَمآثِراً أنفَت عِنِ الأَعصَارِ",43,"ر",1,0],["وَعَصائِباً كانوا أُسودَ خَفِيَّةٍ","فَأَحَلتَهُم مِثلَ النَعامِ مُشَرَّدا",44,"د",2,0],["وَعَصائِباً مَلَأوا الفُراتَ سَفائِناً","لَمّا نَبا بِهِمُ الفَضاءُ الأَوسَعُ",45,"ع",1,0],["وَعَصَمتَني مِمّا أَخافُ فَظَنَّني","مَن رامَني لِلفَرقَدَينِ نَزيلا",46,"ل",2,0],["وَعِصابَةٌ فارَقتُهُم لا عَن قِلىً","مِنّي وَلا لي غَيرُ وَالدِهِم أَبُ",47,"ب",1,0],["وَعِصمَةُ جانِيها وَمَأوى طَريدِها","وَمُطلِقُ أَسراها وَكَهفُ ذُراها",48,"ا",3,0],["وَعَصاني نَظْمُ القَريضِ فَأَمسى","كُلُّ بَحرٍ وَرَدتَهُ مِنهُ ضَحْلا",49,"ل",2,0],["وعصرُك زهرةُ الدنيا وباقي","عصورٍ قد خلتْ حَلَبٌ ومَخْض",50,"ض",1,0],["وعصيت من أضحى يلو","م عليه في تفنيده",51,"د",2,0],["وعصبة الكفر ولت وفي مدبرة","تدعو الفرار وسيف الشرك مفلول",52,"ل",1,0],["وَعَصبتِ بِالشَبقِ المجمَّرِ جَبهَتي","فَرَفَعتُها في عَصريَ المُتَهكّمِ",53,"م",1,0],["وعصيتُ رُشْدي في غَوَايته","وأطعتُه في السر والجهر",54,"ر",1,0],["وعصيانُ دمع العين غَدْرٌ بربّه","إذا بان عنه الصبر واحتكم الوجدُ",55,"د",1,0],["وَعَصاهُ لمّا مَسّها بِيَمينِهِ","فَضُلَت عصاً صارَت إِلى ثُعبانِ",56,"ن",1,0],["وَعِصابَةَ المُلكِ الَّتي اِخ","تارَ الخَليفَةُ وَاِرتَضاها",57,"ا",3,0],["وَعُصبَةٍ صَحِبتُهُم","لِلفُضَلاءِ مُضنِيَه",58,"ي",2,0],["وَعَصرَ خَلاعَةٍ أَحمَدتُ فيهِ ال","شَبابَ وَصِحَّةَ العَهدِ الرَخِيِّ",59,"ي",1,0],["وَعَصفَر مَزجُها في الكأسِ حَتّى","كَأَنَّ الماءَ أَفزَعَها وَراعا",60,"ع",2,0],["وعُصفُوراً لَطيفاً شرَّدتهُ","عَواصِفُ بينها ضلَّ اتّكارا",61,"ر",2,0],["وعصاة فاسقينا","وعتاة كافرينا",62,"ن",2,0],["وَعصمةُ قلبٍ تحتَ حكمة منطقٍ","ووقرٌ لِعرضٍ دونه يهتك الوفرُ",63,"ر",1,0],["وَعصى المروءة والديانة من سعى","بِنَميمة مستوجب التأديبِ",64,"ب",1,0],["وعصى آدم وما قال حوا","ء فسبحان قوله وتعالى",65,"ل",2,0],["وَعُصفوراً ثَناكَ تُري المَنايا","صُقوراً لَم تَفُز مِنهُ بِمَنِّ",66,"ن",1,0],["وَعصبَة العِشق أَقوام كَبيرُهُم","في الحُبّ طفل وَأَقوى عزمه وَهن",67,"ن",1,0],["وعَصائبٍ لاثوا العَصائبَ للسُّرى","مُتَرنِّحِينَ على فُروعِ الأرحُل",68,"ل",1,0],["وعصى الإله وسُرَّ في عصيانه","فاعجب لعاصٍ سُرَّ في ضرّائه",69,"ا",3,0],["وعصى ربَّه جهاراً نَهار","وتمادَى مكابراَ مُستهينا",70,"ن",2,0],["وَعِصابة مال الكرى بِرؤوسِهِم","مَيل الصَبا بِذَوائِبِ الأَغصانِ",71,"ن",1,0],["وعصرهم فصل الربيع نضارة","فهل يرجعن لي ذلك الزمن النضر",72,"ر",1,0],["وعَصَاكَ دمعُكَ عند خَطرةِ ذِكْرِهم","وبِقَدْرِ طَاعَتِك الهَوَى عِصيانُهُ",73,"ن",2,0],["وعصيت عذَّالي عليك","وقلت للوّام بعدا",74,"د",2,0],["وَعَصَى الْمَدِيحُ فَلَيْسَ يُعْطي طَاعَةً","إلا لَهُ فِي سُؤْدَدٍ وثَنَاءِ",75,"ا",2,0],["وعصَرتَها خَمْراً تدو","رُ كؤوسُها شُكْراً وسُكْرا",76,"ر",2,0],["وعصمته الذكر الجميل وإنه","حليّ علاً في كل حيد ومعصم",77,"م",1,0],["وعصبة منتماهم إن هم فخروا","ماء السماء وعرق من بني الدار",78,"ر",1,0],["وعصبة فارقوا أوطانه وإلى","ليلى أجدوا السرى واستعذبوا الأرقا",79,"ق",2,0],["وعصيت فيك العاذلين ولم أزل","متجشماً لجج الطريق العالق",80,"ق",1,0],["وعصفورة للتوت تشدو موقَعاً","على الغصن إِهزاجاً فتأخذ بالعَقْلِ",81,"ل",1,1],["وعصائب هي إن ركبت مواكبٌ","تسَعُ العيون وإن غضِبتَ جحافلُ",82,"ل",1,0],["وعصر الحمى عصري وضلع ظبائه","معي وربيعُ العيشِ فيه ربيعي",83,"ع",2,0],["وعصرُ البِطالةِ مثلُ الربيع","حَياً أبيضٌ وثَرىً أخضرُ",84,"ر",1,0],["وعصائبٌ مضريّةٌ قرشيّةٌ","خُلقوا لحفظِ وشائجٍ وأَواصرِ",85,"ر",1,0],["وعصيتماني في الَمرام وقُلْتما","درستْ تميمٌ فالخفارُ بِمَعْزلِ",86,"ل",1,0],["وعصابةٍ كالآل يطمعُ خدعهُ","وتعود عنهُ بغلَّةٍ لم تنقع",87,"ع",1,0],["وعصابةٍ نادمتهم","وهناً بغير تندّم",88,"م",1,1],["وعُصْبةِ مِن رجالِ الشَّعرِ كم طلبوا","لحاقَ شأوي فأعياهمْ وما لَحِقوا",89,"ق",3,0],["وعصابة حبسوا المحرّق ليلة","حتى علوا جنح الدجى بتهاض",90,"ض",1,0],["وعصَيْتَ الهَوى وأعْرَضْتَ عنه","اِمتثالاً لطاعةِ المَعبودِ",91,"د",1,0],["وعصابة من حاسدي أيامه","طاروا وما قضيت لهم أوطار",92,"ر",1,0],["وعصابة رومية عاشرتها","فتأدبت وتهذبت أذهانها",93,"ن",3,0],["وعصابة مصرية بك أصبحت","فوق البرية راجح ميزانها",93,"ن",3,0],["وعَصَيْتَ فيهِ قَوْلَ كُلِّ 