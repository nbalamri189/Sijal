{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[63,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[63,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[63,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[77,"وعصبة شر من يهود لقيتها","https://www.aldiwan.net/poem35870.html","الطويل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[23,"أشرت لكاع وكان عادتها","https://www.aldiwan.net/poem21476.html","الكامل"],[72,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[72,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[29,"أذكرت عهدك فاعترتك صبابة","https://www.aldiwan.net/poem6097.html","البسيط"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"وعصابة بالخير ألف شملهم","https://www.aldiwan.net/poem8079.html","الكامل"],[85,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[49,"سميت نفسك بالكلام حكيما","https://www.aldiwan.net/poem63106.html","الكامل"],[66,"وعصر الرضا إني لديك لفي خسر","https://www.aldiwan.net/poem38739.html","الطويل"],[80,"بلى جر أذيال الصبا فتصابى","https://www.aldiwan.net/poem31242.html","الطويل"],[80,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[44,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[69,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[31,"ردع الفؤاد تذكر الأطراب","https://www.aldiwan.net/poem42614.html","الكامل"],[102,"كيف عيناك يا عمر","https://www.aldiwan.net/poem33113.html","مجزوء الخفيف"],[52,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42642","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[67,"ذُو يَراعٍ يَرُوعُ كالسَّيْفِ إمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=14534",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""]],"verses":[["وَعَصائِبُ اليَمَنِ الَّذينَ تَبَوَّأوا","قُلَلَ الهِضابِ وَشَرَّدوا الأَوعالا",0,"ل",2,0],["وَعُصبَةٍ جاذَبوكَ العِزِّ فَاِنقَبَضَت","أَكُفُّهُم عَن دِراكِ المَجدِ بِالطَلَبِ",1,"ب",1,0],["وعَصْرٌ رَقيقُ الطُّرَّتَيْنِ تدرّجَتْ","على صَفحَتَيْهِ نَضْرَةٌ وقَبولُ",2,"ل",1,0],["وعُصْبَةٍ مُلِئَتْ أسْماعُهُمْ كَلِماً","ظَلِلْتُ أخْلُقُها فيهِمْ وأَفْريها",3,"ي",3,0],["وعُصبَةٍ مُلِئَتْ غَيظاً صُدورُهُمُ","منْ مُخفِرٍ ذِمّةً أو قاطِعٍ رَحِما",4,"م",2,0],["وعُصبةٍ لا تُطيفُ المَكرُماتُ بها","ولا تُليحُ مِنَ الفَحشاءِ والهُونِ",5,"ن",1,0],["وعُصْبةِ شرٍّ منْ يَهودٍ لَقيتُها","يُجانِبُها داعي الهُدَى ويُحاشيها",6,"ي",3,1],["وَعَصْرُ مِصْرَ الَّذِي فَاقَتْ رَوَائِعُهُ","أيَ الأَجَدَّيْنِ مِنْ فَخْمٍ وَمُزْدَانِ",7,"ن",1,0],["وَعَصاكَ إِستُكِ تَتَّقينَ بِها","دَقَّ العُجايَةَ عارِيَ الفِهرِ",8,"ر",1,0],["وعصبة تدعي علماً وقد جهلت","أنشقت آنافها نكباء تجتدع",9,"ع",1,0],["وعصر حلا جملت مرآه برهةً","وخلّفته ينعي أتمّ رجاله",10,"ل",2,0],["وعصبة يحذقون مدحكمُ","من مجدكم جاء حذق حاذقها",11,"ق",3,0],["وَعَصَرتَ نُطفَتَها لِتُدرِكَ دارِماً","هَيهاتَ مِن مَهَلٍ عَلَيكَ بَعيدِ",12,"د",1,0],["وعصماء منها كل بيت كدمعة","على الراحل المبكى من كل واحد",13,"د",1,0],["وَعِصابَةٍ بِالخَيرِ أُلِّفَ شَملُهُم","وَالخَيرُ أَفضَلُ عُصبَةً وَرِفاقا",14,"ق",2,1],["وَعَصرٌ بَنوهُ في السِلاحِ وَحِرصُهُ","عَلى السِلمِ يُجري ذِكرَهُ وَيُديرُ",15,"ر",1,0],["وَعَصائِبٍ يَتَهافَتونَ إِذا اِرتَمى","بِهِمُ الوَغى في غَمرَةِ الهَيجاءِ",16,"ا",2,0],["وَعَصَيتَ رَبَّكَ يا اِبنَ آدَمَ جاهِداً","فَوَجَدتَ رَبَّكَ إِذ عَصَيتَ حَليما",17,"م",2,0],["وَعَصرِ الرِضا إِنّي لَدَيكَ لَفي خُسرِ","بِمَطلي وَقَلبي فيكَ لَم يَرضَ بِالصَبرِ",18,"ر",1,1],["وعصبةِ لهوٍ غادروا الهمّ جانباً","فلم يألفوا إلّا السرورَ جَنَابا",19,"ب",2,0],["وعصابَةٍ لِلْحَينِ قادَ بها","ظُلْمُ النّفوسِ وساقَها الأشَرُ",20,"ر",1,0],["وعَصمٌ إذا استَعصَمن في شاهِقٍ رَقَتْ","إِلَيها بنات الدّهْرِ في المرْتَقَى الصّعبِ",21,"ب",1,0],["وَعُصِمتَ بِاللَيلِ البَهيمِ وَقَد","أَلقى عَلَيكَ ظَلامُهُ حُجبا",22,"ب",2,0],["وعصرُ شبابٍ في سباتٍ قطعْتُهُ","وفي أرضِ حَنْدُوثينِ في ذلكَ الفضا",23,"ض",2,0],["وَعَصَيتُ فيكِ أَقارِبي فَتَقَطَّعَت","بَيني وَبَينَهُمُ عُرى الأَسبابِ",24,"ب",1,0],["وَعصيّ مِن الدُمو","ع طَغى الهَم فَاِنهَمَر",25,"ر",1,0],["وَعَصرَ شَبابٍ كانَ مَيعَةَ حُسنِهِ","وَظِلّاً مِنَ الدُنيا عَلَيهِ مُنَشَّرا",26,"ر",2,0],["وعَصانِي نَظْمُ القَرِيضِ الذي جَر","رَ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",27,"ر",1,0],["وَعِصَابَةٌ ما صَدَّقَتهُ وَأَكثَرَت","بالإِفكِ والبُهْتانِ فيهِ القِيلا",28,"ل",2,0],["وَعَصَبَت في هَمِّها قَدورُ","وَصِبيَةٌ أَكبَرُهُم صَغيرُ",29,"ر",1,0],["وعَصْرُ المَدى من قَبله كان عصرَها","وعهْدُ أبينا بَعدَها ولها اليُتم",30,"م",1,0],["وعصَتْ من عواصِفِ الحَرْبِ أمْراً","قَبِلَتْهُ مِنْ شَمْأَلٍ وجَنوب",31,"ب",1,0],["وعصبة على هدى الأحبار","أهل كتاب يعبدون الباري",32,"ي",1,0],["وَعِصَابَةٍ غَلَبَ الْكَمَالُ عَلَى","أَخْلاقِهِمْ وَغَذَاهُمُ التَّرَفُ",33,"ف",1,0],["وَعُصْبَةٍ كَانَتْ لأَمْوَالِهَا","مَظنَّةَ الْفَقْرِ بِهَا ذَاخِرَهْ",34,"ر",2,0],["وعصابة، ملأ المناخر نَتْنُها","خضعت طوائفكم لها وطقوسها",35,"س",3,0],["وعصا ناصر تَفُلُّ صواري","خ الأعادي، وبِيضَها المرهفات",36,"ت",1,0],["وعصاني نظمُ القريضِ الذي ج","رَّ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",37,"ر",1,0],["وعصرٌ تَناهضَ فيه الجمادُ","عجيبٌ به يجمُدُ النَّاهضونا",38,"ن",2,0]]}