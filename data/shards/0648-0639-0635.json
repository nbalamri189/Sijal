poem14562.html","الوافر"],[184,"يا غاديا متوسطا","https://www.aldiwan.net/poem43974.html","مجزوء الكامل"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[221,"أسيلة الفحشاء نارك في دمي","https://www.aldiwan.net/poem41597.html","الكامل"],[227,"أوهمتني من رقة العذر","https://www.aldiwan.net/poem51007.html","أحذ الكامل"],[227,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[233,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[233,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[250,"وأخجلها البراز فألبستها","https://www.aldiwan.net/poem1445.html",""],[268,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[302,"خذ يمينا خذ يمينا","https://www.aldiwan.net/poem16907.html","مجزوء الرمل"],[303,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[303,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[326,"أفسحوا للذي تريد المجالا","https://www.aldiwan.net/poem54926.html","الخفيف"],[347,"شربت من الحميا ما سقتني","https://www.aldiwan.net/poem15973.html","الوافر"],[359,"سمحت بالوصل بعد الهجر يا حسن","https://www.aldiwan.net/poem68047.html","البسيط"],[362,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[374,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[397,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[403,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[406,"ديار الهوى حيا معالمك ولإن","https://www.aldiwan.net/poem31699.html","عموديه"],[406,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[413,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[421,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[429,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[434,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[434,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[438,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[438,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[450,"وعصفورة للتوت تشدو موقعا","https://www.aldiwan.net/poem13893.html","الطويل"],[456,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[456,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[456,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[456,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[459,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[462,"وعصابة نادمتهم","https://www.aldiwan.net/poem3520.html","عموديه"],[475,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[493,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[512,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[513,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[527,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[536,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[549,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[549,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[549,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[549,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[557,"يا صاح هل هذه شموس","https://www.aldiwan.net/poem69353.html","مخلع البسيط"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[565,"الليل يا صاحبي منطلق","https://www.aldiwan.net/poem69572.html","أحذ الكامل"]],"verses":[["وَعَصائِبُ اليَمَنِ الَّذينَ تَبَوَّأوا","قُلَلَ الهِضابِ وَشَرَّدوا الأَوعالا",0,"ل",2,0],["وَعُصبَةٍ جاذَبوكَ العِزِّ فَاِنقَبَضَت","أَكُفُّهُم عَن دِراكِ المَجدِ بِالطَلَبِ",1,"ب",1,0],["وعَصْرٌ رَقيقُ الطُّرَّتَيْنِ تدرّجَتْ","على صَفحَتَيْهِ نَضْرَةٌ وقَبولُ",2,"ل",1,0],["وعُصْبَةٍ مُلِئَتْ أسْماعُهُمْ كَلِماً","ظَلِلْتُ أخْلُقُها فيهِمْ وأَفْريها",3,"ي",3,0],["وعُصبَةٍ مُلِئَتْ غَيظاً صُدورُهُمُ","منْ مُخفِرٍ ذِمّةً أو قاطِعٍ رَحِما",4,"م",2,0],["وعُصبةٍ لا تُطيفُ المَكرُماتُ بها","ولا تُليحُ مِنَ الفَحشاءِ والهُونِ",5,"ن",1,0],["وعُصْبةِ شرٍّ منْ يَهودٍ لَقيتُها","يُجانِبُها داعي الهُدَى ويُحاشيها",6,"ي",3,1],["وَعَصْرُ مِصْرَ الَّذِي فَاقَتْ رَوَائِعُهُ","أيَ الأَجَدَّيْنِ مِنْ فَخْمٍ وَمُزْدَانِ",7,"ن",1,0],["وَعَصاكَ إِستُكِ تَتَّقينَ بِها","دَقَّ العُجايَةَ عارِيَ الفِهرِ",8,"ر",1,0],["وعصبة تدعي علماً وقد جهلت","أنشقت آنافها نكباء تجتدع",9,"ع",1,0],["وعصر حلا جملت مرآه برهةً","وخلّفته ينعي أتمّ رجاله",10,"ل",2,0],["وعصبة يحذقون مدحكمُ","من مجدكم جاء حذق حاذقها",11,"ق",3,0],["وَعَصَرتَ نُطفَتَها لِتُدرِكَ دارِماً","هَيهاتَ مِن مَهَلٍ عَلَيكَ بَعيدِ",12,"د",1,0],["وعصماء منها كل بيت كدمعة","على الراحل المبكى من كل واحد",13,"د",1,0],["وَعِصابَةٍ بِالخَيرِ أُلِّفَ شَملُهُم","وَالخَيرُ أَفضَلُ عُصبَةً وَرِفاقا",14,"ق",2,1],["وَعَصرٌ بَنوهُ في السِلاحِ وَحِرصُهُ","عَلى السِلمِ يُجري ذِكرَهُ وَيُديرُ",15,"ر",1,0],["وَعَصائِبٍ يَتَهافَتونَ إِذا اِرتَمى","بِهِمُ الوَغى في غَمرَةِ الهَيجاءِ",16,"ا",2,0],["وَعَصَيتَ رَبَّكَ يا اِبنَ آدَمَ جاهِداً","فَوَجَدتَ رَبَّكَ إِذ عَصَيتَ حَليما",17,"م",2,0],["وَعَصرِ الرِضا إِنّي لَدَيكَ لَفي خُسرِ","بِمَطلي وَقَلبي فيكَ لَم يَرضَ بِالصَبرِ",18,"ر",1,1],["وعصبةِ لهوٍ غادروا الهمّ جانباً","فلم يألفوا إلّا السرورَ جَنَابا",19,"ب",2,0],["وعصابَةٍ لِلْحَينِ قادَ بها","ظُلْمُ النّفوسِ وساقَها الأشَرُ",20,"ر",1,0],["وعَصمٌ إذا استَعصَمن في شاهِقٍ رَقَتْ","إِلَيها بنات الدّهْرِ في المرْتَقَى الصّعبِ",21,"ب",1,0],["وَعُصِمتَ بِاللَيلِ البَهيمِ وَقَد","أَلقى عَلَيكَ ظَلامُهُ حُجبا",22,"ب",2,0],["وعصرُ شبابٍ في سباتٍ قطعْتُهُ","وفي أرضِ حَنْدُوثينِ في ذلكَ الفضا",23,"ض",2,0],["وَعَصَيتُ فيكِ أَقارِبي فَتَقَطَّعَت","بَيني وَبَينَهُمُ عُرى الأَسبابِ",24,"ب",1,0],["وَعصيّ مِن الدُمو","ع طَغى الهَم فَاِنهَمَر",25,"ر",1,0],["وَعَصرَ شَبابٍ كانَ مَيعَةَ حُسنِهِ","وَظِلّاً مِنَ الدُنيا عَلَيهِ مُنَشَّرا",26,"ر",2,0],["وعَصانِي نَظْمُ القَرِيضِ الذي جَر","رَ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",27,"ر",1,0],["وَعِصَابَةٌ ما صَدَّقَتهُ وَأَكثَرَت","بالإِفكِ والبُهْتانِ فيهِ القِيلا",28,"ل",2,0],["وَعَصَبَت في هَمِّها قَدورُ","وَصِبيَةٌ أَكبَرُهُم صَغيرُ",29,"ر",1,0],["وعَصْرُ المَدى من قَبله كان عصرَها","وعهْدُ أبينا بَعدَها ولها اليُتم",30,"م",1,0],["وعصَتْ من عواصِفِ الحَرْبِ أمْراً","قَبِلَتْهُ مِنْ شَمْأَلٍ وجَنوب",31,"ب",1,0],["وعصبة على هدى الأحبار","أهل كتاب يعبدون الباري",32,"ي",1,0],["وَعِصَابَةٍ غَلَبَ الْكَمَالُ عَلَى","أَخْلاقِهِمْ وَغَذَاهُمُ التَّرَفُ",33,"ف",1,0],["وَعُصْبَةٍ كَانَتْ لأَمْوَالِهَا","مَظنَّةَ الْفَقْرِ بِهَا ذَاخِرَهْ",34,"ر",2,0],["وعصابة، ملأ المناخر نَتْنُها","خضعت طوائفكم لها وطقوسها",35,"س",3,0],["وعصا ناصر تَفُلُّ صواري","خ الأعادي، وبِيضَها المرهفات",36,"ت",1,0],["وعصاني نظمُ القريضِ الذي ج","رَّ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",37,"ر",1,0],["وعصرٌ تَناهضَ فيه الجمادُ","عجيبٌ به يجمُدُ النَّاهضونا",38,"ن",2,0],["وَعَصراً بِهِ كُنت غَض الشَبا","ب وَحَبلبي مُلقى غَلى غارِبي",39,"ي",1,0],["وعصائبنا زعموا العلوم تخبطا","فالقيل غاية علمهم والقال",40,"ل",1,0],["وعصر اذا لامست اذيال طوره","ترى منه امواه العجائب تقطر",41,"ر",1,0],["وعَصرٌ تَقَلَّدَ رِفعَةً وفَخَامَةً","وَمآثِراً أنفَت عِنِ الأَعصَارِ",42,"ر",1,0],["وَعَصائِباً كانوا أُسودَ خَفِيَّةٍ","فَأَحَلتَهُم مِثلَ النَعامِ مُشَرَّدا",43,"د",2,0],["وَعَصائِباً مَلَأوا الفُراتَ سَفائِناً","لَمّا نَبا بِهِمُ الفَضاءُ الأَوسَعُ",44,"ع",1,0],["وَعَصَمتَني مِمّا أَخافُ فَظَنَّني","مَن رامَني لِلفَرقَدَينِ نَزيلا",45,"ل",2,0],["وَعِصابَةٌ فارَقتُهُم لا عَن قِلىً","مِنّي وَلا لي غَيرُ وَالدِهِم أَبُ",46,"ب",1,0],["وَعِصمَةُ جانِيها وَمَأوى طَريدِها","وَمُطلِقُ أَسراها وَكَهفُ ذُراها",47,"ا",3,0],["وَعَصاني نَظْمُ القَريضِ فَأَمسى","كُلُّ بَحرٍ وَرَدتَهُ مِنهُ ضَحْلا",48,"ل",2,0],["وعصرُك زهرةُ الدنيا وباقي","عصورٍ قد خلتْ حَلَبٌ ومَخْض",49,"ض",1,0],["وعصيت من أضحى يلو","م عليه في تفنيده",50,"د",2,0],["وعصبة الكفر ولت وفي مدبرة","تدعو الفرار وسيف الشرك مفلول",51,"ل",1,0],["وَعَصبتِ بِالشَبقِ المجمَّرِ جَبهَتي","فَرَفَعتُها في عَصريَ المُتَهكّمِ",52,"م",1,0],["وعصيتُ رُشْدي في غَوَايته","وأطعتُه في السر والجهر",53,"ر",1,0],["وعصيانُ دمع العين غَدْرٌ بربّه","إذا بان عنه الصبر واحتكم الوجدُ",54,"د",1,0],["وَعَصاهُ لمّا مَسّها بِيَمينِهِ","فَضُلَت عصاً صارَت إِلى ثُعبانِ",55,"ن",1,0],["وَعِصابَةَ المُلكِ الَّتي اِخ","تارَ الخَليفَةُ وَاِرتَضاها",56,"ا",3,0],["وَعُصبَةٍ صَحِبتُهُم","لِلفُضَلاءِ مُضنِيَه",57,"ي",2,0],["وَعَصرَ خَلاعَةٍ أَحمَدتُ فيهِ ال","شَبابَ وَصِحَّةَ العَهدِ الرَخِيِّ",58,"ي",1,0],["وَعَصفَر مَزجُها في الكأسِ حَتّى","كَأَنَّ الماءَ أَفزَعَها وَراعا",59,"ع",2,0],["وعُصفُوراً لَطيفاً شرَّدتهُ","عَواصِفُ بينها ضلَّ اتّكارا",60,"ر",2,0],["وعصاة فاسقينا","وعتاة كافرينا",61,"ن",2,0],["وَعصمةُ قلبٍ تحتَ حكمة منطقٍ","ووقرٌ لِعرضٍ دونه يهتك الوفرُ",62,"ر",1,0],["وَعصى المروءة والديانة من سعى","بِنَميمة مستوجب التأديبِ",63,"ب",1,0],["وعصى آدم وما قال حوا","ء فسبحان قوله وتعالى",64,"ل",2,0],["وَعُصفوراً ثَناكَ تُري المَنايا","صُقوراً لَم تَفُز مِنهُ بِمَنِّ",65,"ن",1,0],["وَعصبَة العِشق أَقوام كَبيرُهُم","في الحُبّ طفل وَأَقوى عزمه وَهن",66,"ن",1,0],["وعَصائبٍ لاثوا العَصائبَ للسُّرى","مُتَرنِّحِينَ على فُروعِ الأرحُل",67,"ل",1,0],["وعصى الإله وسُرَّ في عصيانه","فاعجب لعاصٍ سُرَّ في ضرّائه",68,"ا",3,0],["وعصى ربَّه جهاراً نَهار","وتمادَى مكابراَ مُستهينا",69,"ن",2,0],["وَعِصابة مال الكرى بِرؤوسِهِم","مَيل الصَبا بِذَوائِبِ الأَغصانِ",70,"ن",1,0],["وعصرهم فصل الربيع نضارة","فهل يرجعن لي ذلك الزمن النضر",71,"ر",1,0],["وعَصَاكَ دمعُكَ عند خَطرةِ ذِكْرِهم","وبِقَدْرِ طَاعَتِك الهَوَى عِصيانُهُ",72,"ن",2,0],["وعصيت عذَّالي عليك","وقلت للوّام بعدا",73,"د",2,0],["وَعَصَى الْمَدِيحُ فَلَيْسَ يُعْطي طَاعَةً","إلا لَهُ فِي سُؤْدَدٍ وثَنَاءِ",74,"ا",2,0],["وعصَرتَها خَمْراً تدو","رُ كؤوسُها شُكْراً وسُكْرا",75,"ر",2,0],["وعصمته الذكر الجميل وإنه","حليّ علاً في كل حيد ومعصم",76,"م",1,0],["وعصبة منتماهم إن هم فخروا","ماء السماء وعرق من بني الدار",77,"ر",1,0],["وعصبة فارقوا أوطانه وإلى","ليلى أجدوا السرى واستعذبوا الأرقا",78,"ق",2,0],["وعصيت فيك العاذلين ولم أزل","متجشماً لجج الطريق العالق",79,"ق",1,0],["وعصفورة للتوت تشدو موقَعاً","على الغصن إِهزاجاً فتأخذ بالعَقْلِ",80,"ل",1,1],["وعصائب هي إن ركبت مواكبٌ","تسَعُ العيون وإن غضِبتَ جحافلُ",81,"ل",1,0],["وعصر الحمى عصري وضلع ظبائه","معي وربيعُ العيشِ فيه ربيعي",82,"ع",2,0],["وعصرُ البِطالةِ مثلُ الربيع","حَياً أبيضٌ وثَرىً أخضرُ",83,"ر",1,0],["وعصائبٌ مضريّةٌ قرشيّةٌ","خُلقوا لحفظِ وشائجٍ وأَواصرِ",84,"ر",1,0],["وعصيتماني في الَمرام وقُلْتما","درستْ تميمٌ فالخفارُ بِمَعْزلِ",85,"ل",1,0],["وعصابةٍ كالآل يطمعُ خدعهُ","وتعود عنهُ بغلَّةٍ لم تنقع",86,"ع",1,0],["وعصابةٍ نادمتهم","وهناً بغير تندّم",87,"م",1,1],["وعُصْبةِ مِن رجالِ الشَّعرِ كم طلبوا","لحاقَ شأوي فأعياهمْ وما لَحِقوا",88,"ق",3,0],["وعصابة حبسوا المحرّق ليلة","حتى علوا جنح الدجى بتهاض",89,"ض",1,0],["وعصَيْتَ الهَوى وأعْرَضْتَ عنه","اِمتثالاً لطاعةِ المَعبودِ",90,"د",1,0],["وعصابة من حاسدي أيامه","طاروا وما قضيت لهم أوطار",91,"ر",1,0],["وعصابة رومية عاشرتها","فتأدبت وتهذبت أذهانها",92,"ن",3,0],["وعصابة مصرية بك أصبحت","فوق البرية راجح ميزانها",92,"ن",3,0],["وعَصَيْتَ فيهِ قَوْلَ كُلِّ مُفَنِّدٍ","وَسَدَدْتَ سَمْعاً عَنْ سَماعِ خِطابِهِ",93,"ب",2,0],["وعصيرَ الصَّابِ صِرفاً","ذُقته منكِ فَعِفتُك",94,"ك",1,0],["وعصائبٍ أعييتُهمْ بمناقبي","إنْ يصدقوا في عَضْهَتي فتقوّلوا",95,"ل",3,0],["وعصابةٍ مَرَقَتْ فرُضْتَ جِماحَها","حتّى اِلتَوى فكأنّما لم تمرُقِ",96,"ق",1,0],["وعصتْ على كلّ الرّجالِ فقُدتَها","لرضاك بالأرسانِ والأرباقِ",97,"ق",1,0],["وعصائبٌ دبّوا إلى خُططِ العُلا","فرأوا مجازَ اللَّهْدِ آنَ خَليقا",98,"ق",2,0],["وعَصوفٌ يُكِنّنِي وركودٌ","ومَجيءٌ يجيئني وذهوبُ",99,"ب",1,0],["وَعصْرُها كان في زَمَان","لا كَرْم فيه ولا غُروسُ",100,"س",1,0],["وَعُصبَةِ النَبيِّ إِذ خافوا الحَصَر","شَدّوا لَهُ سُلطانَهُ حَتّى اِقتَسَر",101,"ر",1,0],["وَعَصْفَرَتْ رَاحَةَ المُدِيْرِ كَمَا","عَصْفَرَ جَيْبَ الدُّجُنَّةِ الشَّفَقُ",102,"ق",1,0]]}