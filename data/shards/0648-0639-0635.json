.html","الخفيف"],[186,"نهاية ما سما لعلاك أرض","https://www.aldiwan.net/poem14562.html","الوافر"],[187,"يا غاديا متوسطا","https://www.aldiwan.net/poem43974.html","مجزوء الكامل"],[211,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[224,"أسيلة الفحشاء نارك في دمي","https://www.aldiwan.net/poem41597.html","الكامل"],[230,"أوهمتني من رقة العذر","https://www.aldiwan.net/poem51007.html","أحذ الكامل"],[230,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[236,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[236,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[236,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[253,"وأخجلها البراز فألبستها","https://www.aldiwan.net/poem1445.html",""],[271,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[305,"خذ يمينا خذ يمينا","https://www.aldiwan.net/poem16907.html","مجزوء الرمل"],[306,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[306,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[329,"أفسحوا للذي تريد المجالا","https://www.aldiwan.net/poem54926.html","الخفيف"],[350,"شربت من الحميا ما سقتني","https://www.aldiwan.net/poem15973.html","الوافر"],[362,"سمحت بالوصل بعد الهجر يا حسن","https://www.aldiwan.net/poem68047.html","البسيط"],[365,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[378,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[401,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[407,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[410,"ديار الهوى حيا معالمك ولإن","https://www.aldiwan.net/poem31699.html","عموديه"],[410,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[425,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[433,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[438,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[438,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[442,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[442,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[453,"وعصفورة للتوت تشدو موقعا","https://www.aldiwan.net/poem13893.html","الطويل"],[459,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[459,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[459,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[462,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[465,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[465,"وعصابة نادمتهم","https://www.aldiwan.net/poem3520.html","عموديه"],[478,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[496,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[515,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[516,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[516,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[530,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[539,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[552,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[552,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[552,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[552,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[552,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[560,"يا صاح هل هذه شموس","https://www.aldiwan.net/poem69353.html","مخلع البسيط"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[568,"الليل يا صاحبي منطلق","https://www.aldiwan.net/poem69572.html","أحذ الكامل"]],"verses":[["وَعَصائِبُ اليَمَنِ الَّذينَ تَبَوَّأوا","قُلَلَ الهِضابِ وَشَرَّدوا الأَوعالا",0,"ل",2,0],["وَعُصبَةٍ جاذَبوكَ العِزِّ فَاِنقَبَضَت","أَكُفُّهُم عَن دِراكِ المَجدِ بِالطَلَبِ",1,"ب",1,0],["وعَصْرٌ رَقيقُ الطُّرَّتَيْنِ تدرّجَتْ","على صَفحَتَيْهِ نَضْرَةٌ وقَبولُ",2,"ل",1,0],["وعُصْبَةٍ مُلِئَتْ أسْماعُهُمْ كَلِماً","ظَلِلْتُ أخْلُقُها فيهِمْ وأَفْريها",3,"ي",3,0],["وعُصبَةٍ مُلِئَتْ غَيظاً صُدورُهُمُ","منْ مُخفِرٍ ذِمّةً أو قاطِعٍ رَحِما",4,"م",2,0],["وعُصبةٍ لا تُطيفُ المَكرُماتُ بها","ولا تُليحُ مِنَ الفَحشاءِ والهُونِ",5,"ن",1,0],["وعُصْبةِ شرٍّ منْ يَهودٍ لَقيتُها","يُجانِبُها داعي الهُدَى ويُحاشيها",6,"ي",3,1],["وَعَصْرُ مِصْرَ الَّذِي فَاقَتْ رَوَائِعُهُ","أيَ الأَجَدَّيْنِ مِنْ فَخْمٍ وَمُزْدَانِ",7,"ن",1,0],["وَعَصاكَ إِستُكِ تَتَّقينَ بِها","دَقَّ العُجايَةَ عارِيَ الفِهرِ",8,"ر",1,0],["وعصبة تدعي علماً وقد جهلت","أنشقت آنافها نكباء تجتدع",9,"ع",1,0],["وعصر حلا جملت مرآه برهةً","وخلّفته ينعي أتمّ رجاله",10,"ل",2,0],["وعصبة يحذقون مدحكمُ","من مجدكم جاء حذق حاذقها",11,"ق",3,0],["وَعَصَرتَ نُطفَتَها لِتُدرِكَ دارِماً","هَيهاتَ مِن مَهَلٍ عَلَيكَ بَعيدِ",12,"د",1,0],["وعصماء منها كل بيت كدمعة","على الراحل المبكى من كل واحد",13,"د",1,0],["وَعِصابَةٍ بِالخَيرِ أُلِّفَ شَملُهُم","وَالخَيرُ أَفضَلُ عُصبَةً وَرِفاقا",14,"ق",2,1],["وَعَصرٌ بَنوهُ في السِلاحِ وَحِرصُهُ","عَلى السِلمِ يُجري ذِكرَهُ وَيُديرُ",15,"ر",1,0],["وَعَصائِبٍ يَتَهافَتونَ إِذا اِرتَمى","بِهِمُ الوَغى في غَمرَةِ الهَيجاءِ",16,"ا",2,0],["وَعَصَيتَ رَبَّكَ يا اِبنَ آدَمَ جاهِداً","فَوَجَدتَ رَبَّكَ إِذ عَصَيتَ حَليما",17,"م",2,0],["وَعَصرِ الرِضا إِنّي لَدَيكَ لَفي خُسرِ","بِمَطلي وَقَلبي فيكَ لَم يَرضَ بِالصَبرِ",18,"ر",1,1],["وعصبةِ لهوٍ غادروا الهمّ جانباً","فلم يألفوا إلّا السرورَ جَنَابا",19,"ب",2,0],["وعصابَةٍ لِلْحَينِ قادَ بها","ظُلْمُ النّفوسِ وساقَها الأشَرُ",20,"ر",1,0],["وعَصمٌ إذا استَعصَمن في شاهِقٍ رَقَتْ","إِلَيها بنات الدّهْرِ في المرْتَقَى الصّعبِ",21,"ب",1,0],["وَعُصِمتَ بِاللَيلِ البَهيمِ وَقَد","أَلقى عَلَيكَ ظَلامُهُ حُجبا",22,"ب",2,0],["وعصرُ شبابٍ في سباتٍ قطعْتُهُ","وفي أرضِ حَنْدُوثينِ في ذلكَ الفضا",23,"ض",2,0],["وَعَصَيتُ فيكِ أَقارِبي فَتَقَطَّعَت","بَيني وَبَينَهُمُ عُرى الأَسبابِ",24,"ب",1,0],["وَعصيّ مِن الدُمو","ع طَغى الهَم فَاِنهَمَر",25,"ر",1,0],["وَعَصرَ شَبابٍ كانَ مَيعَةَ حُسنِهِ","وَظِلّاً مِنَ الدُنيا عَلَيهِ مُنَشَّرا",26,"ر",2,0],["وعَصانِي نَظْمُ القَرِيضِ الذي جَر","رَ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",27,"ر",1,0],["وَعِصَابَةٌ ما صَدَّقَتهُ وَأَكثَرَت","بالإِفكِ والبُهْتانِ فيهِ القِيلا",28,"ل",2,0],["وَعَصَبَت في هَمِّها قَدورُ","وَصِبيَةٌ أَكبَرُهُم صَغيرُ",29,"ر",1,0],["وعَصْرُ المَدى من قَبله كان عصرَها","وعهْدُ أبينا بَعدَها ولها اليُتم",30,"م",1,0],["وعصَتْ من عواصِفِ الحَرْبِ أمْراً","قَبِلَتْهُ مِنْ شَمْأَلٍ وجَنوب",31,"ب",1,0],["وعصبة على هدى الأحبار","أهل كتاب يعبدون الباري",32,"ي",1,0],["وَعِصَابَةٍ غَلَبَ الْكَمَالُ عَلَى","أَخْلاقِهِمْ وَغَذَاهُمُ التَّرَفُ",33,"ف",1,0],["وَعُصْبَةٍ كَانَتْ لأَمْوَالِهَا","مَظنَّةَ الْفَقْرِ بِهَا ذَاخِرَهْ",34,"ر",2,0],["وعصابة، ملأ المناخر نَتْنُها","خضعت طوائفكم لها وطقوسها",35,"س",3,0],["وعصا ناصر تَفُلُّ صواري","خ الأعادي، وبِيضَها المرهفات",36,"ت",1,0],["وعصرت الشجون في الروضة ال","غنّا لحونا أندى وفنّا أغنّا",37,"ن",2,0],["وعصاني نظمُ القريضِ الذي ج","رَّ ذُيُولاً عَلَى قَرِيضِ جَرِيرِ",38,"ر",1,0],["وعصرٌ تَناهضَ فيه الجمادُ","عجيبٌ به يجمُدُ النَّاهضونا",39,"ن",2,0],["وَعَصراً بِهِ كُنت غَض الشَبا","ب وَحَبلبي مُلقى غَلى غارِبي",40,"ب",2,0],["وعصائبنا زعموا العلوم تخبطا","فالقيل غاية علمهم والقال",41,"ل",1,0],["وعصر اذا لامست اذيال طوره","ترى منه امواه العجائب تقطر",42,"ر",1,0],["وعَصرٌ تَقَلَّدَ رِفعَةً وفَخَامَةً","وَمآثِراً أنفَت عِنِ الأَعصَارِ",43,"ر",1,0],["وَعَصائِباً كانوا أُسودَ خَفِيَّةٍ","فَأَحَلتَهُم مِثلَ النَعامِ مُشَرَّدا",44,"د",2,0],["وَعَصائِباً مَلَأوا الفُراتَ سَفائِناً","لَمّا نَبا بِهِمُ الفَضاءُ الأَوسَعُ",45,"ع",1,0],["وَعَصَمتَني مِمّا أَخافُ فَظَنَّني","مَن رامَني لِلفَرقَدَينِ نَزيلا",46,"ل",2,0],["وَعِصابَةٌ فارَقتُهُم لا عَن قِلىً","مِنّي وَلا لي غَيرُ وَالدِهِم أَبُ",47,"ب",1,0],["وَعِصمَةُ جانِيها وَمَأوى طَريدِها","وَمُطلِقُ أَسراها وَكَهفُ ذُراها",48,"ا",3,0],["وَعَصاني نَظْمُ القَريضِ فَأَمسى","كُلُّ بَحرٍ وَرَدتَهُ مِنهُ ضَحْلا",49,"ل",2,0],["وعصرُك زهرةُ الدنيا وباقي","عصورٍ قد خلتْ حَلَبٌ ومَخْض",50,"ض",1,0],["وعصيت من أضحى يلو","م عليه في تفنيده",51,"د",2,0],["وعصبة الكفر ولت وفي مدبرة","تدعو الفرار وسيف الشرك مفلول",52,"ل",1,0],["وَعَصبتِ بِالشَبقِ المجمَّرِ جَبهَتي","فَرَفَعتُها في عَصريَ المُتَهكّمِ",53,"م",1,0],["وعصيتُ رُشْدي في غَوَايته","وأطعتُه في السر والجهر",54,"ر",1,0],["وعصيانُ دمع العين غَدْرٌ بربّه","إذا بان عنه الصبر واحتكم الوجدُ",55,"د",1,0],["وَعَصاهُ لمّا مَسّها بِيَمينِهِ","فَضُلَت عصاً صارَت إِلى ثُعبانِ",56,"ن",1,0],["وَعِصابَةَ المُلكِ الَّتي اِخ","تارَ الخَليفَةُ وَاِرتَضاها",57,"ا",3,0],["وَعُصبَةٍ صَحِبتُهُم","لِلفُضَلاءِ مُضنِيَه",58,"ي",2,0],["وَعَصرَ خَلاعَةٍ أَحمَدتُ فيهِ ال","شَبابَ وَصِحَّةَ العَهدِ الرَخِيِّ",59,"ي",1,0],["وَعَصفَر مَزجُها في الكأسِ حَتّى","كَأَنَّ الماءَ أَفزَعَها وَراعا",60,"ع",2,0],["وعُصفُوراً لَطيفاً شرَّدتهُ","عَواصِفُ بينها ضلَّ اتّكارا",61,"ر",2,0],["وعصاة فاسقينا","وعتاة كافرينا",62,"ن",2,0],["وَعصمةُ قلبٍ تحتَ حكمة منطقٍ","ووقرٌ لِعرضٍ دونه يهتك الوفرُ",63,"ر",1,0],["وَعصى المروءة والديانة من سعى","بِنَميمة مستوجب التأديبِ",64,"ب",1,0],["وعصى آدم وما قال حوا","ء فسبحان قوله وتعالى",65,"ل",2,0],["وَعُصفوراً ثَناكَ تُري المَنايا","صُقوراً لَم تَفُز مِنهُ بِمَنِّ",66,"ن",1,0],["وَعصبَة العِشق أَقوام كَبيرُهُم","في الحُبّ طفل وَأَقوى عزمه وَهن",67,"ن",1,0],["وعَصائبٍ لاثوا العَصائبَ للسُّرى","مُتَرنِّحِينَ على فُروعِ الأرحُل",68,"ل",1,0],["وعصى الإله وسُرَّ في عصيانه","فاعجب لعاصٍ سُرَّ في ضرّائه",69,"ا",3,0],["وعصى ربَّه جهاراً نَهار","وتمادَى مكابراَ مُستهينا",70,"ن",2,0],["وَعِصابة مال الكرى بِرؤوسِهِم","مَيل الصَبا بِذَوائِبِ الأَغصانِ",71,"ن",1,0],["وعصرهم فصل الربيع نضارة","فهل يرجعن لي ذلك الزمن النضر",72,"ر",1,0],["وعَصَاكَ دمعُكَ عند خَطرةِ ذِكْرِهم","وبِقَدْرِ طَاعَتِك الهَوَى عِصيانُهُ",73,"ن",2,0],["وعصيت عذَّالي عليك","وقلت للوّام بعدا",74,"د",2,0],["وَعَصَى الْمَدِيحُ فَلَيْسَ يُعْطي طَاعَةً","إلا لَهُ فِي سُؤْدَدٍ وثَنَاءِ",75,"ا",2,0],["وعصَرتَها خَمْراً تدو","رُ كؤوسُها شُكْراً وسُكْرا",76,"ر",2,0],["وعصمته الذكر الجميل وإنه","حليّ علاً في كل حيد ومعصم",77,"م",1,0],["وعصبة منتماهم إن هم فخروا","ماء السماء وعرق من بني الدار",78,"ر",1,0],["وعصبة فارقوا أوطانه وإلى","ليلى أجدوا السرى واستعذبوا الأرقا",79,"ق",2,0],["وعصيت فيك العاذلين ولم أزل","متجشماً لجج الطريق العالق",80,"ق",1,0],["وعصفورة للتوت تشدو موقَعاً","على الغصن إِهزاجاً فتأخذ بالعَقْلِ",81,"ل",1,1],["وعصائب هي إن ركبت مواكبٌ","تسَعُ العيون وإن غضِبتَ جحافلُ",82,"ل",1,0],["وعصر الحمى عصري وضلع ظبائه","معي وربيعُ العيشِ فيه ربيعي",83,"ع",2,0],["وعصرُ البِطالةِ مثلُ الربيع","حَياً أبيضٌ وثَرىً أخضرُ",84,"ر",1,0],["وعصائبٌ مضريّةٌ قرشيّةٌ","خُلقوا لحفظِ وشائجٍ وأَواصرِ",85,"ر",1,0],["وعصيتماني في الَمرام وقُلْتما","درستْ تميمٌ فالخفارُ بِمَعْزلِ",86,"ل",1,0],["وعصابةٍ كالآل يطمعُ خدعهُ","وتعود عنهُ بغلَّةٍ لم تنقع",87,"ع",1,0],["وعصابةٍ نادمتهم","وهناً بغير تندّم",88,"م",1,1],["وعُصْبةِ مِن رجالِ الشَّعرِ كم طلبوا","لحاقَ شأوي فأعياهمْ وما لَحِقوا",89,"ق",3,0],["وعصابة حبسوا المحرّق ليلة","حتى علوا جنح الدجى بتهاض",90,"ض",1,0],["وعصَيْتَ الهَوى وأعْرَضْتَ عنه","اِمتثالاً لطاعةِ المَعبودِ",91,"د",1,0],["وعصابة من حاسدي أيامه","طاروا وما قضيت لهم أوطار",92,"ر",1,0],["وعصابة رومية عاشرتها","فتأدبت وتهذبت أذهانها",93,"ن",3,0],["وعصابة مصرية بك أصبحت","فوق البرية راجح ميزانها",93,"ن",3,0],["وعَصَيْتَ فيهِ قَوْلَ كُلِّ مُفَنِّدٍ","وَسَدَدْتَ سَمْعاً عَنْ سَماعِ خِطابِهِ",94,"ب",2,0],["وعصيرَ الصَّابِ صِرفاً","ذُقته منكِ فَعِفتُك",95,"ك",1,0],["وعصائبٍ أعييتُهمْ بمناقبي","إنْ يصدقوا في عَضْهَتي فتقوّلوا",96,"ل",3,0],["وعصابةٍ مَرَقَتْ فرُضْتَ جِماحَها","حتّى اِلتَوى فكأنّما لم تمرُقِ",97,"ق",1,0],["وعصتْ على كلّ الرّجالِ فقُدتَها","لرضاك بالأرسانِ والأرباقِ",98,"ق",1,0],["وعصائبٌ دبّوا إلى خُططِ العُلا","فرأوا مجازَ اللَّهْدِ آنَ خَليقا",99,"ق",2,0],["وعَصوفٌ يُكِنّنِي وركودٌ","ومَجيءٌ يجيئني وذهوبُ",100,"ب",1,0],["وَعصْرُها كان في زَمَان","لا كَرْم فيه ولا غُروسُ",101,"س",1,0],["وَعُصبَةِ النَبيِّ إِذ خافوا الحَصَر","شَدّوا لَهُ سُلطانَهُ حَتّى اِقتَسَر",102,"ر",1,0],["وَعَصْفَرَتْ رَاحَةَ المُدِيْرِ كَمَا","عَصْفَرَ جَيْبَ الدُّجُنَّةِ الشَّفَقُ",103,"ق",1,0]]}