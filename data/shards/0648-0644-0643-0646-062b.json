{"poems":[[30,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/141830","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204791","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62770","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109912","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91519","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114317","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111453","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86383","الطويل"],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""]],"verses":[["وَلَكِن ثَوى فيهِم عَزيزاً مَكانُهُ","عَلى أَنفِ راضٍ مِن مَعَدٍّ وَراغِمِ",0,"م",1,0],["ولكن ثمار النخل وهي غضيضة","تمر وغض الكرم يجنى ويؤكل",1,"ل",1,0],["ولكن ثوى فيه مستأجر","وهيهات يخرج اذ ينذر",2,"ر",1,0],["ولكن ثَنيتَ الجهلَ بالحِلمِ فانثَنى","ومثلكَ من قادَ الجموحَ على رِسلِ",3,"ل",1,0],["ولكنَّ ثُلثَيهِ إذا كان ثانياً","لإِثنيهِ صارَ قولَنا خُذ ولا نَهَب",4,"ب",1,0],["وَلَكن ثَناها عَن مَداها برغمها","حَبيبٌ تَخلّى أَو صَديقٌ تحوّلا",5,"ل",2,0],["وَلكِن ثِقَالٌ فُجُوراً كَأن","بِإنجَائِهَا اللهُ أوحضى لَهَا",6,"ل",3,0],["وَلِكن ثَلاثاً تُرسُ فِيبُوسَ صَدَّهُ","وَرابِعَةً قد كادَ يَسطُو وَيَضرِبُ",7,"ب",1,0],["ولكن ثم القلب خضخضة الهوى","إلى أن طفا فوق الألوكة دره",8,"ر",2,0],["ولكن ثم معركة لنصر","يضوع بختمها للمسك فار",9,"ر",1,0]]}