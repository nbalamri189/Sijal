سبيل بكرنا إن بكرنا","https://www.aldiwan.net/poem1902.html","الطويل"],[300,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[342,"صنو الرسول تحية وسلام","https://www.aldiwan.net/poem55338.html","الكامل"],[361,"لقد شاقني هذا القوام المهفهف","https://www.aldiwan.net/poem68090.html","الطويل"],[364,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[364,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[371,"بعين الله هجرك لا بعيني","https://www.aldiwan.net/poem57100.html","الوافر"],[377,"تمازج في قلبي الصبابة والشجو","https://www.aldiwan.net/poem59183.html","الطويل"],[403,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[410,"طاف الخيال وحيه بسلام","https://www.aldiwan.net/poem67468.html","الكامل"],[437,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[441,"أسير الهوى قل لي فما أنت صانع","https://www.aldiwan.net/poem14332.html","الطويل"],[453,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[458,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[458,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[458,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[464,"وذي خفر عيل صبري به","https://www.aldiwan.net/poem3400.html","عموديه"],[464,"لها من ظباء أسهرتك جفونها","https://www.aldiwan.net/poem3500.html","عموديه"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[514,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[538,"الويل ثم الويل للبياز","https://www.aldiwan.net/poem48010.html","عموديه"],[551,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[551,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[551,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[551,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[553,"تحملت هجر الشادن المتدلل","https://www.aldiwan.net/poem68417.html","الطويل"],[558,"خلاف الوجود الصرف فالعدم الأخ","https://www.aldiwan.net/poem33553.html","الطويل"],[558,"إن الغني إلى المولى من افتقرا","https://www.aldiwan.net/poem34492.html","البسيط"],[558,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[558,"خلوة القبر أشرف الخلوات","https://www.aldiwan.net/poem34708.html","الخفيف"],[567,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[575,"أخذت ضنى عينيك رهنا على قلبي","https://www.aldiwan.net/poem2991.html","الطويل"]],"verses":[["خَلَوتُ بِكَالغُصنِ المُرَنَّحِ فَتَّحَت","أَعاليهِ غِبَّ القَطرِ نَوراً مُكَمَّما",0,"م",2,0],["خَلَّوا عَلَيكَ مَطالَ السَفرِ وَاِنطَلَقوا","وَأَسلَفوكَ سُلُوّاً قَبلَ أَن عَشِقوا",1,"ق",3,1],["خَلَونا فَكانَت عِفَّةٌ لا تَعَفُّفٌ","وَقَد رُفِعَت في الحَيِّ عَنّا المَوانِعُ",2,"ع",1,0],["خَلّوا الطَريقَ لِمَن تَعَو","وَدَ أَن تُجَرَّ بِهِ خَميسا",3,"س",2,0],["خَلَوتُ بِها وَحدي وَثالِثُنا التُّقَى","وَرابِعُنا ماضي الغِرارَين في الجَفنِ",4,"ن",1,0],["خَلَوتُم بِأَنَواعِ السُرورِ هَناكُمُ","وَأَفرَدتُموني لِلصَبابَةِ وَالحَزَن",5,"ن",1,1],["خُلْوَانِ مِنْ مَعْنىً وَفِي قَلْبَيْهِمَا","لَهُمَا أَحَبَّ مُنَى الحَيَاةِ مَعَانِي",6,"ي",1,0],["خَلُّوا سَبِيلَ الطَّيْرِ يَمْرَحُ هَانِئاً","فِي جَوِّهِ وَيَرُودُ كُلَّ مَكَانِ",6,"ن",1,0],["خلوتُ بمن أهواه من غير رِقبةٍ","ولكنْ عفافي لم أكن عنه خاليا",7,"ي",2,0],["خَلّوا ثِيابَهُمُ عَلى عَوراتِهِ","فَهُمُ بِأَفنِيَةِ البُيوتِ هُمودُ",8,"د",1,0],["خَلّوا عَدِيّاً وَهوَ صاحِبُ ثَأرِهِم","كَرَماً وَنالوا الثَأرَ بِاِبنِ أَبانِ",9,"ن",1,0],["خَلّوا الفَخارَ لِعَلّامينَ إِن سُئِلوا","يَومَ السُؤالِ وَعَمّالينَ إِن عَلِموا",10,"م",3,0],["خلوتُ بها فرداً إذا شئتُ علَّني","بكأسٍ لها ريَّا بنانٌ مُنعَّمُ",11,"م",1,0],["خَلَوتُ بِمَن أَهوى بِهِ رُغمَ عاذِلي","وَلَم يَكُ غَيرُ القُربِ لي وَلَها قَصدُ",12,"د",1,0],["خَلَونا وَما بَينَنا ثالِثٌ","فَأَصبَحَ عِندَ النَسيمِ الخَبَر",13,"ر",1,0],["خَلّوا الأَكاليلَ لِلتاريخِ إِنَّ لَهُ","يَداً تُؤَلِّفُها دُرّاً وَمَخشَلَبا",14,"ب",2,0],["خَلوقِيَّةٌ في خَلوقِيِّها","سُوَيداءُ مِن عِنَبِ الثَعلَبِ",15,"ب",1,0],["خَلّوا الخِلافَةَ إِنَّدونَ مَنالِها","قَدَراً بِأَخذِ الظالِمينَ خَليقا",16,"ق",2,0],["خُلوفُ زَمانِ السوءِ لَم يُؤثِروا العُلا","وَلَم يَنزِلوا لِلمَكرُماتِ عَلى حُكمِ",17,"م",1,0],["خَلّوا يَزيدَ فَتى الأَزدَينِ مُنجَدِلاً","بِالعَقرِ مِنهُم وَمِن ساداتِهِم عُصَبُ",18,"ب",1,0],["خُلّوا سَبيل العَيرِ يَأتِ أَهلُهُ","سَوفَ تَرونَ فِعلَكُم وَفِعلَهُ",19,"ه",1,1],["خَلَوتُ بِها وَهدي كَما قالَ شَيخُنا","وَذاكَ لِأَنّي ما وَجَدتُ لَها مِثلي",20,"ي",1,0],["خلوا بين أطراف القنا بكماتِهِ","لِطَعنٍ مِنَ الفرسانِ يخلي القوانسا",21,"س",2,0],["خِلْواً مِن الهمِّ إلاّ همَّ خافقةٍ","بينَ الجوانحِ أعنيها وتَعنيني",22,"ن",2,0],["خَلُّوا سبيلَ الشّاعرِ المُتدفِّعِ","وخُذوا بيانَ العبقريِّ المُبدِعِ",23,"ع",1,1],["خَلّوا السَبيلَ بَني التاميزِ وَاِجتَنِبوا","أُسداً تَفِرُّ المَنايا مِن ضَواريها",24,"ي",3,0],["خلُّوا سبيلَ اللهِ ما لرسولِه","عمَّا أعدَّ من المنازلِ مَعْدِلُ",25,"ل",1,0],["خَلّوا الدِيارَ لِدارِ خَلدٍ واِركَبوا","غَمرَ العَجاجِ إِلى النَعيمِ الأَخضَرِ",26,"ر",1,0],["خَلَّوا عَلى الباقي الأَسى","وَنجا الفَقيدُ مُخَفَّفا",27,"ف",2,0],["خَلَوتُ بِهِ أُنازِعُهُ شَمولاً","وَأَنشِدُهُ مِنَ البَحرِ البَسيطِ",28,"ط",1,0],["خُلُوّاً مِن هَوى البيضِ ال","لَذي بِشِفاهِها حَمَمُ",29,"م",1,0],["خَلَوتُ بِالراحِ أُناجيها","آخُذُ مِنها وَأُعاطيها",30,"ي",3,1],["خَلَوتُ بِها لا يَخلُصُ الماءُ بَينَنا","إِلى الصُبحِ دوني حاجِبٌ وَسُتورُ",31,"ر",1,0],["خَلّوا عَلَيَّ الهُيامَ إِذ رَكِبوا","أَكبِر بِما أَفرَدوا لِمُنفَرِدِ",32,"د",1,0],["خَلَوتُ بِها يَوماً فَلَمّا اِفتَضَضتُها","تَبَيَّنَ ما فيها وَصَرَّحَ عائِبُه",33,"ب",2,0],["خَلِّ وَدُنياكَ أَهلَ عِزَّتِها","فَكَم شَكَت مُهجَةٌ بَلابِلَها",34,"ل",3,0],["خُلُوُّ فؤادي بالمَوَدّةِ إخْلالُ","وإبْلاءُ جِسمي في طِلابِكِ إبْلالُ",35,"ل",1,1],["خَلوجٍ بِرِجلَيها كَأَنَّ فُروجَها","فَيافي سُهوبٍ حَيثُ تَختَبُّ في الآلِ",36,"ل",1,0],["خَلُّوا عِنَاني في الرِّهانِ ومَسِّحوا","مِنِّي بِغُرَّةِ أبلق مَشْهُورِ",37,"ر",1,0],["خَلُّوا جَوَى قَلبي أُكابِدُهُ","حَسْبي مُكابَدَةُ الجَوى حَسْبي",38,"ي",1,0],["خلَوَا في جانب","ساعةً وافترقا",39,"ق",2,0],["خلوتُ به أرعاك أوْفى قسامةً","وأوفرَ من سحرِ الجمالِ نصيبا",40,"ب",2,0],["خلو أحاديثهم واحتوى","آخذ ميراث عَلَى ما حووا",41,"و",3,0],["خَلَوا مِنها فَلا ظَمَأ","شَكَوا فيها وَلا خَمصا",42,"ص",2,0],["خَلُّوا السجُوفَ تُذِعْ مَجْلَى مُحَيَّاها","وتَنْشُرُ المسكَ من أنفاسِ رَيَاها",43,"ا",3,1],["خلوا النار ناحيةً وصولوا","بنور العلم، إنَّ العلم نور",44,"ر",1,0],["خلو الأنام على عقا","ئدهم، وإن عبدوا الدُّمى",45,"م",2,0],["خَلُّوا صلاحَ الدين خَلُّ","وا خالدًا رهْنَ المقابر",46,"ر",1,0],["خلُّوا مقاليد الشُّعوب لأمَّةِ","عزلاءَ تقنعُ بالكفاف نصيبا",47,"ب",2,0],["خَلُّوا ثِيابَهُمُ على عَوْراتِهِمْ","فهُمُ بأفنِيَةِ البُيُوتِ هُمُودُ",48,"د",1,0],["خلّوه يجمد ويتبعثر كلّبوه","مادامني في حكمه وفي طاعته",49,"ت",2,0],["خلّوا الأناة وأسرعوا لمناكم","عار الشباب العبقريّ أناته",50,"ت",2,0],["خلّوا جناحا في العراق لنسره","وتخوّفوه في الشام جناحا",51,"ح",2,0],["خلّوا الشام وداميات كلاهما","لا تهتكوا الأستار عن آلامها",52,"م",3,1],["خلوت بها والناس في جلوة الضحى","أراهم ولا واش علي ولاح",53,"ح",1,0],["خلّوا التنازعَ والتقليدَ وادكروا","وأقْبِلوا لكتابِ اللهِ واحْتَمِلُوا",54,"ل",3,0],["خلوتَ من العيوبِ وكل سوقٍ","تَرى مُلئت جوانبه عُيوبا",55,"ب",2,0],["خلُّوا سواعدَهم تمتدّ ناشطةً","زرعاً وصُنعاً وتطريقاً وتعدينا",56,"ن",2,0],["خلوت به والأفق تصدا شمسه","تباشير وضاح من السعد قادم",57,"م",1,0],["خلّو الرياسة للذي جعلت له","وارضوا وكونوا للإِله عِبادا",58,"د",2,0],["خلّوا عن الهمَم العُليا لباعِثها","تلقون عن سكراتِ الموتِ مُنِتدحا",59,"ح",2,0],["خلّوا عن العلياله وتجانفوا","فالليثُ لا يؤتى إلى غاباتهِ",60,"ت",2,0],["خَلّوا بنيسابورَ مَضمونَهُ","وقحفَه الخالي بكَرمانِ",61,"ن",1,0],["خَلّوا الفَخارَ لِمَعشَرٍ أَولوكُمُ","ذُلَّ الهَوانِ بِغِلظَةٍ وَجَفاءِ",62,"ا",2,0],["خَلّوا الثَناءَ لِمَن لَيسَت مَذاهِبه","تِلثامَ كاسٍ وَلا تجماعَ أَكياسِ",63,"س",1,0],["خلُّوا التَّعَصُبَ عَنكُم وَاِستَووا عُصباً","عَلى الوِئام وَدَفعِ الظُّلمِ تَعتَصِبُ",64,"ب",1,0],["خلوتُ بليلى ذاتَ يومٍ وبيننا","حديثٌ كما انْهَلَّ الفَريدُ من السِّمْطِ",65,"ط",1,1],["خلوت بشرب الراح وحدي لأنني","بلوت الورى من صاحب ونديم",66,"م",1,1],["خلوت بها وحدي مخافة صاحب","لأسرارها في الناس غير كتوم",66,"م",1,0],["خلوتَ بمن تهوى وأفردتني وحدي","فيا منيتي لا كان عندك ما عندي",67,"د",2,1],["خلونا إلى اللذات نستاف زهرها","ونلهو بها خصرا يصم إلى خصر",68,"ر",1,0],["خَلّوا فُؤادي وَالغَرامَ فَإِنَّهُ","قَلبٌ لَهُ بِهَواهُم اِستِغراقُ",69,"ق",1,0],["خَلّوا مَلامي في هِجاءِ اِمرِىءٍ","يَصلُحُ بَعدَ الذَبحِ لِلخَلِّ",70,"ل",1,1],["خَلّوا لَهُ طُرُقَ المَعالي وَاِفرِجوا","لِمُدَرَّبٍ بِسُلوكِها مُرتاضِ",71,"ض",1,0],["خَلُّوا سَبِيلَ الْحَوْضِ","وَفَحِّصُوا عَنْ حَوْضِ",72,"ض",1,1],["خلونا بدار للمدام تكاد أن","تماثلها الأفلاك لولا نعيمها",73,"ه",2,1],["خَلّو سَبيلَ بَكرِنا إِنَّ بَكرَنا","يَخُذُّ سَنامَ الأَكحَلِ المُتَماحِلِ",74,"ل",1,1],["خَلّوا طَريقَ الديدَبونِ فَقَد","وَلّى الصِبا وَتَفاوَتَ النَجرُ",75,"ر",1,0],["خلوا البلاد لنا والا بينكم","يا عابثين وبيننا الايام",76,"م",1,0],["خلوت وَبي ما لا يطاق من الجَوى","وَمني له ذل وَمِنهُ تلطف",77,"ف",1,0],["خِلْوٌ إذا اللّيلُ من تحتِ النّجومِ بَدا","كَسُودِ أغْرِبةٍ في بيضِ أشْراك",78,"ك",1,0],["خَلُّوا الفلا لأبي عَليٍّ فالعُلا","حَقٌّ له من دونِ كُلِّ مُنازع",79,"ع",1,0],["خَلَوتَ وقَد مَلأتَ يديك فَاعطِف","لِمَملُوءِ الحَشَى خِلوِ اليَدينِ",80,"ن",1,0],["خلوت وقلبي بالهوى متشاغلٌ","فحسبُك قلبٌ يقتضي شغلَه الخلوُ",81,"و",1,0],["خلوف الوعود نقوض العهو","د كذوب للسان عديم الوفا",82,"ا",1,0],["خَلّوا الطَريقَ لِمَعشَرٍ عاداتُهُم","حَطمُ المَناكِبِ كُلَّ يَومِ زِحامِ",83,"م",1,0],["خلوت وقد رحلت من العطايا","فدهري ليس لي منه مُعين",84,"ن",1,0],["خلوت بها وحدي وثالثنا التقى","ورابعنا ماضي الغرارين قاطع",85,"ع",1,0],["خلوا التغنِّى بالجدودِ وفضلهم","مهما تلألأ روعةً ومفاخرا",86,"ر",2,0],["خلّوا عن المال أيدياً وَهبُوا","منها مكانَ الأموال والقُبَلِ",87,"ل",1,0],["خلُّوا ابن أيّوبٍ عليَّ وشأنَكم","من ناكثٍ أو غادرٍ أو حائلِ",88,"ل",1,0],["خلوتُ بنومهنَّ فلم أوسِّدْ","يدِي جنباً ولا جنبيَّ نُكْرا",89,"ر",2,0],["خلوتُ به ليلة في الزمان","فطال بكائي لذاك القصرِ",90,"ر",1,0],["خلوت بها والكاسُ ملقى لثامها","وقد لثمتْ وجهَ السماء دجونها",91,"ن",3,0],["خلوت بها رغما على الدهر بعدما","تولهت في سري بوجدي وحرقتي",92,"ي",1,0],["خُلوُّ قلبك من نارِ الهوى عجَبٌ","ومكمَنُ النارِ لا ينفَكُّ في الحَجَرِ",93,"ر",1,0],["خَلُّوا المناصبَ عنكمُ لِرجالِها","أهلِ الكفاءَةِ وَاجبي التَّعزَاز",94,"ز",1,0],["خلوتُ به وباطنه سليمٌ","بلا دَنَسٍ وظاهره كليمُ",95,"م",1,0],["خلّوا السّبيلَ لشمسِ كلِّ دُجُنَّةٍ","كَثُفتْ وموضحِ كلِّ خطبٍ مُشِكلِ",96,"ل",1,0],["خلّوا التعرّضَ للّذي لا يُتَّقَى","فلربّما عجل الّذي لا يعجلُ",97,"ل",1,0],["خلّوا الفخارَ لمعشرٍ ما فيهمُ","إلّا الّذي اِتَّخذ الحسامَ رفيقا",98,"ق",2,0],["خلّوا الّتي سكّانُها معشرٌ","هُمُ بها من غيرهمْ ألْيَقُ",99,"ق",1,0],["خَلَوتُ بِها وَاللَيلُ يَقظانُ قائِمٌ","عَلى قَدَمٍ كَالراهِبِ المُتَبَتِّلِ",100,"ل",1,0],["خلوت به والكون كالليل مظلم","ولكنه ليل عن النور يسلخ",101,"خ",1,0],["خلوا المساكين في علم الإله ولا","تكلفوهم يزيلوا حالة الفُقرا",102,"ر",2,0],["خلوا معاني الذوق لي أو دعوا","دعواكمُ العلم ولا تعتدوا",103,"د",3,0],["خلوة القبر أشرف الخلوات","بلقاء الحبيب في الجلوات",104,"ت",1,1],["خلوة القبر للتجرد عما","يشغل الروح عن إتم الصفات",104,"ت",1,0],["خلوة القبر لذةٌ ونعيمٌ","لسعيد قد ذاق سرَّ الممات",104,"ت",1,0],["خلوة القبر راحةٌ وسرور","ودخول في أشرف الجنات",104,"ت",1,0],["خُلوه يندب شجوه فلعله","يشفى الذي نَكَأْتَه من أندابِهِ",105,"ب",2,0],["خَلوتُ بها ثُمَّ افْترقْنَا ولم يَكُنْ","سِوَى نَهْلةٍ من مبْسم بارِدٍ عَذْب",106,"ب",1,0]]}