لطَّيِّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=185959",""],[5183,"كم لي وسيف اللحظ ماضي الشبا","https://www.poetsgate.com/ViewPoem.aspx?id=180290",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[5376,"على بحرِ أحزانٍ أنوءُ بغربةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215095",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5412,"فو الله لا أنسى مدى الدهر قولها","https://www.poetsgate.com/ViewPoem.aspx?id=181279",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5628,"صور من الريف","https://www.poetsgate.com/ViewPoem.aspx?id=178449",""],[5638,"عندما بكى وبكيته الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=198127",""],[5732,"اخترت بعد الدار عن قرب الانجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177853",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5943,"قصيدة في أعضاء موقع العز أحمد عبد الباقي عاشور رح","https://www.poetsgate.com/ViewPoem.aspx?id=34296",""],[5966,"عروس المصايف","https://www.poetsgate.com/ViewPoem.aspx?id=158862",""],[6093,"وللنبت روح","https://www.poetsgate.com/ViewPoem.aspx?id=193067",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=189724",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""],[6308,"إني أحبكَ أكثر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87729&r=&rc=7",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""],[6355,"معايير النساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66666&r=&rc=126",""]],"verses":[["وَلِلنَفسِ في عَجزِ الفَتى وزِماعِهِ","زِمامٌ إِلى ما يَشتَهي وَعِقالُ",0,"ل",1,0],["وَلِلنائِباتِ اِستَهدَفَتني نِصالُها","عَلى شَرَفٍ يَرمينَنا بِالفَلائِقِ",1,"ق",1,0],["وَلِلنَفسِ قَد طارَت شَعاعاً مِنَ الجَوى","لِفَقدِ الصَفايا وَاِنقِطاعِ العَلائِقِ",1,"ق",1,0],["وَللنَّرْجِسِ المَطْلُولُ تَحْدِيقُ أَعْيُنٍ","وَللآسَةِ الغَنَّاءِ تَحْدِيدُ آذَانِ",2,"ن",1,0],["وَلَلنيلُ أَولى بِذاكَ الدَلالِ","وَمِصرُ أَحَقُّ بِبَشّارِها",3,"ر",3,0],["وَلِلنَفيسِ الصوفيِّ عَنفَقَةٌ","مَحلوقَةٌ لِلمِحالِ وَالكِذبِ",4,"ب",1,0],["وَلِلنَسيمِ اِعتِلالٌ في أَصائِلِهِ","كَأَنَّهُ رَقَّ لي فَاعتَلَّ إِشفاقا",5,"ق",2,0],["وَلِلنُؤيِ مَجنوباً كَأَنَّ هِلالَهُ","وَقَد نَسَفَت أَعضادَهُ الريحُ جَدوَلُ",6,"ل",1,0],["وللنجوم بقايا في جوانبه","كالعقد منفرطاً من جيد رعبوب",7,"ب",1,0],["وللنسيم هبوب في مدارجه","ما ينعش الروح من نشر ومن طيب",7,"ب",1,0],["وللنفس في أفق الشعور مخايل","إذا برقت فالفكر في برقها قطر",8,"ر",1,0],["وللناس عادات كثير تقودهم","فكلّ امرئ منهم لهنّ جنيب",9,"ب",1,0],["وللنفس أحْوال تظلُّ كأنها","تشاهِد فيها كلَّ غيب سيُشهَدُ",10,"د",1,0],["وللناس أفعال يجازى مدادُها","وللدهر أحوال يكايل صُوعها",11,"ع",3,0],["وَلِلنَسَماتِ تَجوبُ البِلادَ","وَتَملَءُها أَرَجاً طَيِّبا",12,"ب",2,0],["وَلِلنَجمِ وَهُوَ النَجمُ مِشِيَةُ ظالِعٍ","وَلِلأَرضِ وَهِيَ الأَرضُ وِقفَةُ حائِرِ",13,"ر",1,0],["وَلِلناسِ في الدُنيا مُلوكٌ كَثيرَةٌ","وَهَيهاتَ ما لِلناسِ مِثلُ مَلوكي",14,"ك",2,0],["وَلِلناسِ عاداتٌ وَقَد أَلِفوا بِها","لَها سُنَنٌ يَرعَونَها وَفُروضُ",15,"ض",1,0],["وَلِلناسِ أَشعارٌ تُقالُ كَثيرَةٌ","وَلَكِنَّ شِعري في الأَميرِ أَميرُها",16,"ر",3,0],["وللناس فيما قد علمت مآرب","قد اختلفت فيهم كما اختلف الخلق",17,"ق",1,1],["وَلِلناسِ في الماضي بَصائِرُ يَهتَدي","عَلَيهِنَّ غاوٍ أَو يَسيرُ رَشيدُ",18,"د",1,0],["وَلِلنَفسِ أَخلاقٌ تَدُلُّ عَلى الفَتى","أَكانَ سَخاءً ما أَتى أَم تَساخِيا",19,"ي",2,0],["وللنجمِ من بعدِ الرجوعِ استقامةٌ","وللحظِّ من بعد الذِّهابِ قفُولُ",20,"ل",1,0],["وللنسيم على الغدران رفرفة","يزورها فتلقاه بأمواج",21,"ج",1,0],["وَلِلناسِ خَوضٌ في الكَلامِ وَأَلسُنٌ","وَأَقرَبُها مِن كُلِّ خَيرٍ صَدوقُها",22,"ق",3,0],["وَلِلنَفسِ دونَ العارِفاتِ صُعوبَةٌ","فَإِن صَعُبَت يَوماً عَلَيكَ فَهَوِّنها",23,"ن",3,0],["وَلِلنَفسِ طَيرٌ يَنتَفِضنَ إِلى الهَوى","بِأَجنِحَةٍ تَهوي إِلَيهِ فَسَكِّنها",23,"ن",3,0],["وَلِلناسِ آجالٌ قِصارٌ سَتَنقَضي","وَلِلناسِ أَرزاقٌ سَيَستَكمِلونَها",24,"ن",3,0],["وَلِلنَرجِسِ الغَضُّ ما بَينَنا","وُجوهٌ بِحَضرَتِنا ناضِرَه",25,"ر",2,0],["وللنقيضين في كأسين قد جمعا","فالراويان هما والظامئان هما",26,"م",2,0],["وَلِلنَفسِ ساعاتٌ تَهَشُّ لِذِكرِها","فَتَحيا وَساعاتٌ لَها تَستَكينُها",27,"ن",3,0],["وَلِلنَقرى قَومٌ فَلو كُنتُ مِنهُمُ","دُعيتُ وَلَكِن دونِيَ البابُ مُغلَقُ",28,"ق",1,0],["وَلِلنَفسُ حاجاتٌ إِلَيكِ إِذا خَلَت","سَيَعيا بِها عِندَ اللِقاءِ فَصيحُها",29,"ح",3,0],["وَللناس في دار البلى كل راحة","وَقَد عاقهم عنها الحَياة وَلَم يدروا",30,"ر",3,0],["وَللنساء لدى أَهليه منزلة","كما يَليق بشعب هب يعتدل",31,"ل",1,0],["وَللنساء معولا","تٍ من عَظيم الهلع",32,"ع",1,0],["وللنصارى مكان","من الرقى تعالى",33,"ل",2,0],["وللناس زعم في الذي يعبدونه","ولكن ذاك الزعم غير مطابق",34,"ق",1,0],["وَللناس في لبنان عزم وَفِطنة","وَمشيٌ لإدراك الرقيِّ سَريع",35,"ع",1,0],["وللنِّيل أمواجٌ يثبنَ صبابةً","بأفراح دورٍ فوقهُ ومغاني",36,"ن",2,0],["وَلِلنُّجْحِ أَسْبَابٌ إِذَا لَمْ يَفُزْ بِها","لَبِيبٌ مِنَ الْفِتْيَانِ لم يُورِ زَنْدُهُ",37,"د",2,0],["وَلِلنَّسِيمِ خِلالَ النَّبتِ غَلْغَلَةٌ","كَمَا تَغَلْغَلَ وَسْطَ اللِّمَّةِ الْمُشُطُ",38,"ط",1,0],["وَلِلنَّدَى وَالمَعَالِي","أَدْعُو بِطولِ بَقَائِكْ",39,"ك",1,0],["وَلِلنَّسِيمِ حَدِيثٌ","عَلى المُرُوجِ يَدُورُ",40,"ر",1,0],["وللندى في الثرى جهش ووسوسة","كأنها همسات في ضمائره",41,"ر",2,0],["وَلِلناسِ حُبٌّ لِطولِ البَقا","ءِ فيها وَلِلمَوتِ فيهِم دَبيبُ",42,"ب",1,0],["وللنَّصْرِ أُنْشُودَةٌ لا تُمَلُّ","ولا يَسْأَمُ السمْعُ تَرْدَادها",43,"د",3,0],["وللنفس تزهَد في عاجل","وترغب في الآجل المدخر",44,"ر",1,0],["وللنفسُ مِنْ أنْ تألفَ الذلَّ خُطَّةَ","أجلُّ . ومن أن تُرخص القول أشرف",45,"ف",1,0],["وَللنّسيمِ اعْتِلالٌ، في أصائِلِهِ،","كأنّنهُ رَقّ لي، فاعْتَلّ إشْفَاقَا",46,"ق",2,0],["وللنسمات تجوب البلاد","وتملأها أرجا طيّبا",47,"ب",2,0],["وللنبي عزة ودولة","ونعمة ورحمة ومكرمه",48,"م",2,0],["وللنجوم بريق لا أفرقه","عن لحظ ميتة حسناء عذراء",49,"ا",2,0],["وَلِلنارِ الَّتي شَبَّت فَخيفَت","خُمودٌ سَوفَ يَتبَعُهُ هُمودُ",50,"د",1,0],["وللنساء قضايا يختصصن بها","دون الرجال كلبس الخز والذهب",51,"ب",1,0],["وللنسيمِ العَليل الرَّطْبِ وَسْوَسةٌ","فيهن كالسِّرِّبين الرِّفْق والصَّخَب",52,"ب",1,0],["وللنفسِ في تلك القناعةِ راحةٌ","وعز ولكنْ ليس في الناس قانع",53,"ع",1,0],["وللنَّواعيرِ نَعْراتٌ عَلَتْ فحَكتْ","على الجداولِ أحداقَ القَواديس",54,"س",1,0],["وللناس في النفس المريضة حاجة","إذا النفس رامت خطّة لا تنالها",55,"ه",2,0],["وَللنبيّينَ أجلُّ خاتمِ","وَخير حاكمٍ وخير حاتمِ",56,"م",1,0],["وللنوى طَعَنَاتٌ في ضمائِرِنا","والبينُ بانَ لنا من نَعْقِهِ التَلَفُ",57,"ف",1,0],["وللنون زيدها كثيراً قد يرد","في نحو عرند لصلب فاعتمد",58,"د",1,0],["وَلِلنَّسيم","وَلِلقَمَر",59,"ر",1,0],["وَلِلنَّفسِ مِنكِ إِباءً وَحلماً","إِذا ما رَأَت مُذنِباً تَحلمُ",60,"م",1,0],["وللناس آمالٌ ضروبٌ وأنفس","تسوق إلى أوطارهم وتقود",61,"د",1,0],["وللناقوسِ والجرسِ المعلَّى","رنينٌ والبخورُ لهُ غُيوم",62,"م",1,0],["وللنّدامى حَديثٌ يُطرَبونَ بهِ","إنّ الأحاديثَ تحلو كالتَّلاحين",63,"ن",1,0],["وللنَّسيم على الأغصانِ هَينَمَةٌ","وهي التحيَّةُ بالأزهارِ والعبق",64,"ق",1,0],["وَللنَوى وَالهَوى العذرى في كبدي","وَقف صَريح وَتَحبيس وَتَسبيل",65,"ل",1,0],["وَلِلندَى مِنهُ صَوبُ غادِيَةٍ","مُثَعَنجِرِ الودق هامِرُ القطرِ",66,"ر",1,0],["وَللنورِ والسحرِ المبينِ سوادُها","كذاك سوادُ العينِ للنورِ والسحرِ",67,"ر",1,0],["وللنزول بدار","طابت لكل صبور",68,"ر",1,0],["وَللنفسِ في بسطِ الحضارة نزوةٌ","بِها الوازعُ الدينيُّ يختلّ رسمهُ",69,"م",2,0],["وَلِلناسِ أَهواءٌ رَشَتّى هُمومُهُم","تَجَمَّعُ أَحياناً وَحيناً تَفَرَّقُ",70,"ق",1,0],["ولِلنًّسيمِ شَذَى مَا كنتُ أَعُهَدُهُ","لَوْ لَمْ يَهبَّ الشَّذَى الحَضْرِيُّ والمِدَحُ",71,"ح",1,0],["وللنّاسِ إهْلالٌ بوَجْهِكَ طالعاً","لتَعْبيدِ آمالٍ عنِ الخ