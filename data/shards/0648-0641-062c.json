{"poems":[[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[10,"أبى طول ليلي لا أهجع","https://www.aldiwan.net/poem21108.html","المتقارب"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[45,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55097","السريع"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[87,"كَمْ غادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِكَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23829&r=&rc=91",""],[23,"وفجعنا فيروزُ لا درَّ درهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12809&r=&rc=13",""],[140,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[141,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[237,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[288,"أطلقوا المدفع المبشر بالعيد","https://www.aldiwan.net/poem11663.html","الخفيف"],[296,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[303,"عوى الضبع الملفلف في الثياب","https://www.aldiwan.net/poem56599.html","البسيط"],[364,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[369,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[397,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[436,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[498,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[549,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[549,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[549,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[562,"أعاد لها من مجدها ما تهدما","https://www.aldiwan.net/poem892.html",""],[565,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"],[565,"كايدني دهري في طرتي","https://www.aldiwan.net/poem69693.html","السريع"],[583,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["وَفُجِعنا بِإِمامٍ مُصلِحٍ","عامِرِ القَلبِ وَأَوّابٍ مُنيبِ",0,"ب",1,0],["وَفَجَّعَني رَيبُ هَذا الزَمانِ","بِهِ وَالمَصائِبُ قَد تُفجِعُ",1,"ع",1,0],["وفَجَعْتَني فيمَنْ أُحِبُّ","ومنْ إليهِ أَبُثُّ سرِّي",2,"ي",1,0],["وَفَجَرتَ يَنبوعَ البَيانِ مُحَمَّداً","فَسَقى الحَديثَ وَناوَلَ التَنزيلا",3,"ل",2,0],["وَفَجيعَةُ الأَيّامِ قَسمٌ سُوِّيَت","فيهِ البَرِيَّةُ سوقَةً وَمُلوكا",4,"ك",2,0],["وَفَجَرْتُ يَنْبُوعَ الْبَيَانِ بِمَنْطِقٍ","عَذْبٍ رَوَيْتُ بِهِ غَلِيلَ الْحُوَّمِ",5,"م",1,0],["وَفَجَّعَني رَيبُ الزَمانِ بِفِتيَةٍ","بِهِم كُنتُ أَكفى حادِثَ الدَهرِ إِن رابا",6,"ب",2,0],["وفجرهُ صائدٌ طارتْ بمهجتِهِ","حوريَّةٌ في فجاج اليمِّ شقراءُ",7,"ا",2,0],["وَفَجَّعَ الأَدَبَ الأَ","رْوَعَ مَا فَجَّعَكْ",8,"ك",1,0],["وفجأة...تفجَّر الشارعُ بالهُتافْ","سعاد! يا سعادْ!",9,"د",1,0],["وفجيعةٌ أن نبتغيك فلا تُرى","لجلاء جوٍّ بالبلاد مَغيم",10,"م",1,0],["وفِجاجٍ مَغْبَرّةٍ كُنَّ أبهى","روعةً من مُفَيَّحاتٍ رِحاب",11,"ب",1,0],["وفَجِّر قُروحاً لا يُطاقُ اختِزانُها","ولا هي مما يتقى بالمباضع",12,"ع",1,0],["وَ فجرتُ ينبوع البيانِ بمنطقٍ","عذبٍ ، رويتُ بهِ غليلَ الحرمِ",13,"م",1,0],["وفجعنا فيروزُ لا درَّ درهُ","بأبْيَضَ يَتْلُو المُحْكَمَاتِ مُنِيبِ",14,"ب",1,1],["وفجِاجُ السعى بين يديه","تشترِى الآمالَ منه رِخاصا",15,"ص",2,0],["وَفَجعَةُ بَينٍ مِثلُ صَرعَةِ مالِكٍ","وَيَقبُحُ بي أَلّا أَكونَ مُتَمِّما",16,"م",2,0],["وفجاءَةً أَصغى حراءُ لرنة","جبريل في أرجائه يتكلم",17,"م",1,0],["وفجيع يؤوده الهمّ والسقم","ويضنى قواه خطب نكير",18,"ر",1,0],["وفجر الشيب يطوي من شبابي","ومن أفيائه ظلاً ظليلا",19,"ل",2,0],["وَفجّع جَمعنا بغراب بينٍ","لَحاه اللّه عنّا من غرابِ",20,"ب",1,0],["وَفَجَّرَتِ البَلاغَةُ مِنهُ بَحراً","أَرَدتُ عُبورَهُ فَخَشيتُ عَبرَه",21,"ر",2,0],["وفجورُ أحداقِ المَصو","ناتِ الذُّيولِ عَن الفُجورِ",22,"ر",1,0],["وفُجِعْتُ حين علمتُ أن جَنَابَه","ما كان إلا البائعَ السِّمْسارا",23,"ر",2,0],["وفَجَّرْتَ فِيهَا من دِماءِ حُماتِها","بُحُوراً لَهَا فِي تاجِ مُلكِهِمُ نَضْحُ",24,"ح",1,0],["وفَجْرِهِمْ إذْ طَلَعَتْ طَلْعَتُهُ","وأنَّهُ والله فجرٌ صادقُ",25,"ق",1,0],["وفجعةٍ جاءتْ على بغتةٍ","تغصّنِي بالبارد السَّلْسَلِ",26,"ل",1,0],["وفجعتَ في ظلماءَ داجيةٍ","بالنيّراتِ معاً وبالفجرِ",27,"ر",1,0],["وفجعِي بما نالتْ يداي موكّلٌ","فما سرّنِي أنّي بلغتُ مرادِي",28,"ي",1,0],["وفجر فيها انهر الشرع دفعة","فلا أحد يشكو بها ابداً ظلما",29,"م",2,0],["وَفُجِعْتُ بِالْقُمْرِيِّ فَجْعَةَ ثَاكِلٍ","فَفَقَدْتُ مِنْهُ أَصْنَعَ السُّمَّارِ",30,"ر",1,0],["وفَجَعُ البيضَ بها قبل أن","تَقْضِي المَهَا منِّي أوطارَها",31,"ر",3,0],["وفَجِّرْ مَنْبَع الأَوْداج حتى","تَخوضَ الخيلُ في العَلَق الصبيب",32,"ب",1,0]]}