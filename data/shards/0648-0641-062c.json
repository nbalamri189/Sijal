x?id=71578",""],[5281,"الفاجِعَة","https://www.poetsgate.com/ViewPoem.aspx?id=199665",""],[5286,"هو الشعر !..","https://www.poetsgate.com/ViewPoem.aspx?id=110863",""],[5431,"بانيو وكأس ...وبرد الخيام!","https://www.poetsgate.com/ViewPoem.aspx?id=201925",""],[5463,"خل من راح يرحل بكره شوقه يجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27213",""],[5463,"طاري الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=33841",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5582,"دَعاهُ هَوَى الأَحْبابِ حَتَّى أَجابَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186669",""],[5582,"يا صاحِبَيَّ قِفَا يا صاحِبَيَّ قِفَا","https://www.poetsgate.com/ViewPoem.aspx?id=63535",""],[5582,"عُجْ بِالمَطِيِّ فَهذا السَّفْحُ وَالعَلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=63577",""],[5605,"بكاء الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161345",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[5848,"طعنتينك","https://www.poetsgate.com/ViewPoem.aspx?id=49222",""],[5893,"جدة مآآآآسي غير","https://www.poetsgate.com/ViewPoem.aspx?id=141386",""],[5906,"أبي غادرت بيتك","https://www.poetsgate.com/ViewPoem.aspx?id=188824",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[5969,"خُلاصةُ المرحلة","https://www.poetsgate.com/ViewPoem.aspx?id=198960",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6032,"زائري في ليلة صيف","https://www.poetsgate.com/ViewPoem.aspx?id=181524",""],[6089,"إني أقمتُ جدارَ نسيانٍ على حبي","https://www.poetsgate.com/ViewPoem.aspx?id=214556",""],[6275,"وإني أحبك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83613&r=&rc=5",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""],[6344,"لهيب من شعلة انطفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87981&r=&rc=21",""],[6345,"ياليته ما كان ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78669&r=&rc=40",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""],[572,"غَدَرَ الزّمانُ وجارَ في أَحكامِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9296&r=&rc=153",""],[572,"كَابَدَني دَهْرِيَ في طُرَّتِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9262&r=&rc=119",""],[5064,"شروحُ الفتوح على أسانيد بلقيس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87507&r=&rc=2",""]],"verses":[["وَفُجِعنا بِإِمامٍ مُصلِحٍ","عامِرِ القَلبِ وَأَوّابٍ مُنيبِ",0,"ب",1,0],["وَفَجَّعَني رَيبُ هَذا الزَمانِ","بِهِ وَالمَصائِبُ قَد تُفجِعُ",1,"ع",1,0],["وفَجَعْتَني فيمَنْ أُحِبُّ","ومنْ إليهِ أَبُثُّ سرِّي",2,"ر",2,0],["وَفَجَرتَ يَنبوعَ البَيانِ مُحَمَّداً","فَسَقى الحَديثَ وَناوَلَ التَنزيلا",3,"ل",2,0],["وَفَجيعَةُ الأَيّامِ قَسمٌ سُوِّيَت","فيهِ البَرِيَّةُ سوقَةً وَمُلوكا",4,"ك",2,0],["وَفَجَرْتُ يَنْبُوعَ الْبَيَانِ بِمَنْطِقٍ","عَذْبٍ رَوَيْتُ بِهِ غَلِيلَ الْحُوَّمِ",5,"م",1,0],["وَفَجَّعَني رَيبُ الزَمانِ بِفِتيَةٍ","بِهِم كُنتُ أَكفى حادِثَ الدَهرِ إِن رابا",6,"ب",2,0],["وفجرهُ صائدٌ طارتْ بمهجتِهِ","حوريَّةٌ في فجاج اليمِّ شقراءُ",7,"ا",2,0],["وَفَجَّعَ الأَدَبَ الأَ","رْوَعَ مَا فَجَّعَكْ",8,"ك",1,0],["وفجأة...تفجَّر الشارعُ بالهُتافْ","سعاد! يا سعادْ!",9,"د",1,0],["وفجأة أومت بنان السنى","أيماءة الحسن ؟إلى الواصف",10,"ف",1,0],["وفجأة من شاطئ اللّيل لاح","وغاب فيه كالوليد الغريق",11,"ق",1,0],["وفجرنا الآتي يمدّ الجناح","لنا ويومي باختلاج البريق",11,"ق",1,0],["وفجيعةٌ أن نبتغيك فلا تُرى","لجلاء جوٍّ بالبلاد مَغيم",12,"م",1,0],["وفِجاجٍ مَغْبَرّةٍ كُنَّ أبهى","روعةً من مُفَيَّحاتٍ رِحاب",13,"ب",1,0],["وفَجِّر قُروحاً لا يُطاقُ اختِزانُها","ولا هي مما يتقى بالمباضع",14,"ع",1,0],["وفجأه كذا بار الخليل بخليله","كلّه لعين .. موطّدين العلاقات",15,"ت",1,0],["وَ فجرتُ ينبوع البيانِ بمنطقٍ","عذبٍ ، رويتُ بهِ غليلَ الحرمِ",16,"م",1,0],["وفجعنا فيروزُ لا درَّ درهُ","بأبْيَضَ يَتْلُو المُحْكَمَاتِ مُنِيبِ",17,"ب",1,1],["وفجِاجُ السعى بين يديه","تشترِى الآمالَ منه رِخاصا",18,"ص",2,0],["وَفَجعَةُ بَينٍ مِثلُ صَرعَةِ مالِكٍ","وَيَقبُحُ بي أَلّا أَكونَ مُتَمِّما",19,"م",2,0],["وفجاءَةً أَصغى حراءُ لرنة","جبريل في أرجائه يتكلم",20,"م",1,0],["وفجيع يؤوده الهمّ والسقم","ويضنى قواه خطب نكير",21,"ر",1,0],["وفجر الشيب يطوي من شبابي","ومن أفيائه ظلاً ظليلا",22,"ل",2,0],["وَفجّع جَمعنا بغراب بينٍ","لَحاه اللّه عنّا من غرابِ",23,"ب",1,0],["وَفَجَّرَتِ البَلاغَةُ مِنهُ بَحراً","أَرَدتُ عُبورَهُ فَخَشيتُ عَبرَه",24,"ر",2,0],["وفجورُ أحداقِ المَصو","ناتِ الذُّيولِ عَن الفُجورِ",25,"ر",1,0],["وفُجِعْتُ حين علمتُ أن جَنَابَه","ما كان إلا البائعَ السِّمْسارا",26,"ر",2,0],["وفَجَّرْتَ فِيهَا من دِماءِ حُماتِها","بُحُوراً لَهَا فِي تاجِ مُلكِهِمُ نَضْحُ",27,"ح",1,0],["وفَجْرِهِمْ إذْ طَلَعَتْ طَلْعَتُهُ","وأنَّهُ والله فجرٌ صادقُ",28,"ق",1,0],["وفجعةٍ جاءتْ على بغتةٍ","تغصّنِي بالبارد السَّلْسَلِ",29,"ل",1,0],["وفجعتَ في ظلماءَ داجيةٍ","بالنيّراتِ معاً وبالفجرِ",30,"ر",1,0],["وفجعِي بما نالتْ يداي موكّلٌ","فما سرّنِي أنّي بلغتُ مرادِي",31,"د",2,0],["وفجر فيها انهر الشرع دفعة","فلا أحد يشكو بها ابداً ظلما",32,"م",2,0],["وَفُجِعْتُ بِالْقُمْرِيِّ فَجْعَةَ ثَاكِلٍ","فَفَقَدْتُ مِنْهُ أَصْنَعَ السُّمَّارِ",33,"ر",1,0],["وفَجَعُ البيضَ بها قبل أن","تَقْضِي المَهَا منِّي أوطارَها",34,"ر",3,0],["وفَجِّرْ مَنْبَع الأَوْداج حتى","تَخوضَ الخيلُ في العَلَق الصبيب",35,"ب",1,0],["وَفجوة من فجاجِ الأرضِ موحشة","قفراء يهلكُ مَن في سخطها اِعتَسفا",36,"ف",2,0],["وَفجوة تسمع الركبان إِن دلجت","للّحنِ فيها عريفاً ليس ينفهمُ",37,"م",1,0],["وفجوة تُهلك الركبان سالكها","يَدعو الإله اِبتهالاً خشية الحينِ",38,"ن",1,0],["وفجعتاه به ويا أسفي على","ذاك الشباب الغضّ كيف تهشما",39,"م",2,0],["وفجَّع بالشِّبل الذي عَزَّ دونهُ","حمىً قد حَمْته غابةُ الأسد الوَرِدْ",40,"د",1,0],["وفجايع الأَيَّامِ طائفةٌ","شرقاً وغرباً شأنُها الخَلسُ",