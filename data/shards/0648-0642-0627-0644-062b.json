{"poems":[[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66641","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77585","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[5605,"شاعر العرب","https://www.poetsgate.com/ViewPoem.aspx?id=159615",""]],"verses":[["وقال ثلاث لا يحل بغيرها","دم المسلم المعصوم في الحل والعقد",0,"د",1,0],["وقال ثمَّ رسولُ اللهِ يا أنسُ","ماذا أصابَ بك التخليطُ مكتَسَبا",1,"ب",2,0],["وَقالَ ثنتين طَلبت مني","نلتهما اليَومَ بِلا تَعنّي",2,"ي",1,0],["وَقالَ ثان كَم لَهُ مَكيده","في مُلكِهِ خافية شَديده",3,"ه",1,0],["وقال ثانيهم ما بال نظمكم ؟","من السياسة والتجريح في النسب",4,"ب",1,0],["وقال ثالثهم أين الجديد وذي","أشعاركم في لسان العرب والكتب ؟",4,"ب",1,0]]}