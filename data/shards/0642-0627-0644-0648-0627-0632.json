{"poems":[[71,"قالوا زهدت عن الحكم","https://www.aldiwan.net/poem28488.html","المجتث"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140302",""],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145876","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72622","البسيط"],[4739,"ياهلا","https://www.poetsgate.com/ViewPoem.aspx?id=28120",""],[5136,"قالوا زعمت الهوى يدوم لمن","https://www.poetsgate.com/ViewPoem.aspx?id=121930",""],[5431,"إني هززتُ فهل عسايَ سأولدُ","https://www.poetsgate.com/ViewPoem.aspx?id=193134",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["قالوا زهدْتَ عنِ الحك","مِ قلتُ منْ حسنِ بختي",0,"ي",1,1],["قالوا زكا الأخذ والإنفاق قلت بلى","في الأخذ حيف وفي الإنفاق تبذير",1,"ر",1,0],["قالوا زلازل هزت الأصنام في","وضح النهار ودون إذن صحابها",2,"ب",3,0],["قالوا زففنا إليك بكرا","تسبى الندامى منها الرموز",3,"ز",1,1],["قالوا زهور الأمل فاحت عبير","قلت بالرقه مداعبها نداك",4,"ك",1,0],["قالوا زعمت الهوى يدوم لمن","عف فلم يقض من هوى وطرا",5,"ر",2,1],["قالوا: زمانٌ ماجنٌ متهكمٌ","موتٌ مباحٌ والدنى تتمردُ",6,"د",1,0],["قالوا: زعيمٌ صادقٌ متفرِّدٌ","ألِفٌ تَحوط أباً وتَرسم باء",7,"ا",2,0]]}