diwan.net/poem32108.html","مجزوء الرجز"],[250,"حسبي حرافا يحرفتي حسبي","https://www.aldiwan.net/poem14933.html","المنسرح"],[256,"قال وأجفان مقلتيه تكف","https://www.aldiwan.net/poem48410.html","المنسرح"],[256,"والله أهل الحمد والشكر","https://www.aldiwan.net/poem48558.html","السريع"],[259,"من بر والده وأمه","https://www.aldiwan.net/poem35828.html","مجزوء الكامل"],[275,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[280,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[280,"نشدتك لا تعدم الراح راحا","https://www.aldiwan.net/poem60715.html","المتقارب"],[280,"إذا عز نفسي عن هواك قصورها","https://www.aldiwan.net/poem60737.html","الطويل"],[296,"قالت عميرة ما لرأسك بعدما","https://www.aldiwan.net/poem525.html",""],[298,"وقف على الفيض أنفاس مصعدة","https://www.aldiwan.net/poem36301.html","عموديه"],[303,"ما اسم ثلاثي ترى","https://www.aldiwan.net/poem57737.html","مجزوء الرجز"],[328,"وقفت عمري على قومي وآمالي","https://www.aldiwan.net/poem54932.html","البسيط"],[342,"يا مال في الأفق البعيد سحاب","https://www.aldiwan.net/poem55387.html","الكامل"],[353,"اعمل بدنياك واحذر من عواقبها","https://www.aldiwan.net/poem40561.html","البسيط"],[364,"ليس التعجب إلا من بني زمن","https://www.aldiwan.net/poem60664.html","البسيط"],[364,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[364,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[366,"هذا على كبرياء في مطامعها","https://www.aldiwan.net/poem17327.html","البسيط"],[377,"عهدي برومية الكبرى وقد أخذت","https://www.aldiwan.net/poem59226.html","البسيط"],[403,"ما المنحنى قصده ورامه","https://www.aldiwan.net/poem33422.html","مخلع البسيط"],[403,"قلب المتيم كل يذوده","https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[403,"قلب بداء ذنوبه مجروح","https://www.aldiwan.net/poem33989.html","الكامل"],[429,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[452,"اعمل لنفسك ما استطعت","https://www.aldiwan.net/poem13666.html","مجزوء الكامل"],[458,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[458,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[461,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[479,"اعمل بني فأنت من","https://www.aldiwan.net/poem36911.html","مجزوء الكامل"],[538,"لله يوم حفه عيدان","https://www.aldiwan.net/poem47605.html","عموديه"],[538,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[567,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[569,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[575,"أعملوا في هجوه الفكرا","https://www.aldiwan.net/poem2814.html","المديد"],[575,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"]],"verses":[["أَعَمرو اِبنَ فَرّاشَةِ الأَشيَمِ","صَرَمتَ الحِبالَ وَلَم تُصرَمِ",0,"م",1,1],["أعْمَلْتُ بعْدَكَ بالمُحَصَّبِ وقْفَتي","أدْعو مِن السُّلْوانِ غيْرَ سَميعِ",1,"ع",1,0],["أَعِمَادَنَا السَّامِي الْعُلَى وَأَبَانَا","وَمَلاَذَنَا مِنْ حَادِثٍ يَغْشَانَا",2,"ن",2,1],["أَعْمَلْتُمُ العَزْمَ الصَّحِيحَ فَلَمْ يَكُنْ","لِيَرُوعَكُمْ فِي غِيلِهِ الضِّرْغَامُ",3,"م",1,0],["أَعَمُّ ضِياءً مِن أُمَيَّةَ أَشرَقَت","بِهِ الذِروَةُ العُليا عَلى كُلِّ يافِعِ",4,"ع",1,0],["أعماله للملقين","بمصر قد فتحت كنوزه",5,"ز",2,0],["أعمل الرأي وقد جادله","فيه بعض القوم واشتدّ الجدال",6,"ل",1,0],["أَعمِلِ العيسَ عَلى عِلّاتِها","إِنَّما يُنجِحُ أَصحابُ العَمَل",7,"ل",1,0],["أعمال برك في حلي امتداحك يا","عليّ سيارةٌ بين الأقاليم",8,"م",1,1],["أعمّ الورى جوداً وأبرع منطقاً","فقل في سحاب الجود تزجيه سحبان",9,"ن",1,0],["أعملُ في الأيامِ ما أشتهي","لأنَّني أصبحتُ بدريَّا",10,"ي",2,0],["أَعمى بَصيرٌ وَإِني أَبلَهٌ فَطِنٌ","وَلي كَلامٌ إِذا ما شِئتُ مَقلوبُ",11,"ب",1,0],["أعمُّكُمُ مدحاً وأختصُّ منكُمُ","فتاكم عبيدَ اللَه والرأسُ رائس",12,"س",1,0],["أعملتُهُ يركضُ في غَيّهِ","والخيلُ تُبقي الجَريَ للخيلِ",13,"ل",1,0],["أعمُّهُمُ مدحاً وأختصُّ منهمُ","أخاهم عبيدَ اللَّه والحق يُلْزَمُ",14,"م",1,0],["أعُمُّكُمُ مدحاً وأختصُّ منكم","فتاكم أبا سهلٍ ولستُ بظالمِ",15,"م",1,0],["أُعمِلُ فيهم ذكراً حُساما","عضْب الغِراريْن يقُدُّ الهاما",16,"م",2,1],["أعملت حلمَكَ في السفيه وجَهلِهِ","رحْبَ الجوانح صادق التوطينِ",17,"ن",1,0],["أَعَميدَ سُرِيّا وَكاشِفَ ضَرِّها","خَلَقَت يَداكَ مِنَ الشُيوخِ شَبابا",18,"ب",2,0],["اعمارنا ليست على سعة المنى","ان الحياة قصيرة الآجال",19,"ل",1,0],["أَعمى هَوى الوَطَنِ العَزيزِ عِصابَةٌ","مُستَهتِرينَ إِلى الجَرائِمِ ساروا",20,"ر",3,0],["اعمل بجدّ وجَلَد","فإنّ من جَدّ وجد",21,"د",1,1],["أعمالنا فيها وأسرارنا","وما سواها فمتاع الغرور",22,"ر",1,0],["أَعَمروُ بنَ شَيبانَ وَشَيبانُكُم أَبي","إِذا نُسِبَت أُمّي وَعَمروُكُمُ عَمري",23,"ي",1,0],["أَعمامُ نُتلَةَ أُمِّكُم وَهيَ الَّتي","شَرُفَت وَإِخوَةُ عامِرِ الضَحيانِ",24,"ن",1,0],["أَعمى لَهُ بَصَرٌ يَعيبُ صَديقَهُ","يَأتي المَثالِبَ في خَفاً وَسُكونِ",25,"ن",1,0],["أَعَمَّ عَلى ذُهلِ بنِ شَيبانَ نِعمَةً","وَأَدفَعَ عَن أَموالِها وَدِمائِها",26,"ا",3,0],["اِعمِد إِذا كُنتَ مُختاراً نَدى رَجُلٍ","إِلى جَميلٍ فَتى الجودِ اِبنِ حُمرانا",27,"ن",2,1],["أعمودُ الصبح في الغيهبِ أم","غُرّةُ الأشقرِ في الغيمِ الأحَمْ",28,"م",1,0],["أَعمَلتُ فيكَ قَصائِدي وَوَسائِلي","فَحَرَمتَني فَلَبِئسَ أَجرُ العامِلِ",29,"ل",1,0],["أَعمَلَ النَتفَ وَاِطَّلى وَقَديماً","كانَ صَعباً أَن تُشعَبَ القارورَه",30,"ر",2,0],["أَعمَلَت طَرفَها إِلَيَّ وَقالَت","حُبَّ بِالسائِرينَ زَوراً إِلَينا",31,"ن",2,0],["أعَمْىَ يَقودُ النَّاسَ في بَلَدٍ","أَعْمَى يُعظِّمُ قَدْرَ مَن جَهِلا",32,"ل",2,0],["اعمل وجاهد يا مُحمّدُ إنّها","دُنيا يموتُ بها الجبانُ الهائبُ",33,"ب",1,0],["أَعمَلتَ رَأيَكَ في الوَساوِسِ حِقبَةً","وَشَغَلتَ نَفسَكَ بِالمُحالِ سَنينا",34,"ن",2,0],["أعملوا القتلَ والنِّهابَ وَرَدُّوا","كلَّ غُنمٍ أصابه القومُ غُرْما",35,"م",2,0],["أعمالُهُ كلُّها للَّهِ خالِصَةٌ","ونُصْحُهُ لم يُخالِطْ صَفْوَهُ كَدَرُ",36,"ر",1,0],["أَعمى يَقودُ بَصيراً لا أَبا لَكُمُ","قَد ضَلَّ مَن كانَتِ العُميانُ تَهديهِ",37,"ه",1,1],["أَعمى البَصيرَةِ لا يَهديهِ ناظِرُهُ","إِذا كُلُّ أَعمى لَدَيهِ مِن عَصاً هادِ",38,"د",1,0],["أَعمارُنا جاءَت كَآيِ كِتابِنا","مِنها طِوالٌ وُفِّيَت وَقِصارُ",39,"ر",1,1],["اِعمَل لِأَخراكَ شَروى مَن يَموتُ غَداً","وَاِدأَب لِدُنياكَ فِعلَ الغابِرِ الباقي",40,"ق",2,1],["أَعمى بَخيلٌ أَو بَصيرٌ فاجِرٌ","نوءُ الضِلالِ بِهِ مُرِبٌّ مُثجَمُ",41,"م",1,0],["أَعَمرَ بنَ هِندٍ ما تَرى رَأيَ صِرمَةٍ","لَها سَبَبٌ تَرعى بِهِ الماءَ وَالشَجَر",42,"ر",1,1],["أَعمى فَلست أَرى يو","ماً ما يَراه البَصير",43,"ر",1,0],["اعمَل لأن تبقى الحَياة لَذيذَة","لك وَليكن من بعدك الطوفان",44,"ن",1,0],["أعمى عن الليل بها والنهار","وددت لو قلبي كهذي القفار",45,"ر",1,0],["أَعَمرُو بنَ قَيسٍ إِنَّ نَسرَكُمُ غَدا","وَآبَ إِلى أَهلِ الأَصارِمِ مِن جُشَم",46,"م",1,1],["أَعُمْتِ إلينا أمْ فِعالَ ابنِ مَرْيمٍ","فعَلْتِ وهلْ يُعْطى النُبوّةَ مِكْسالُ",47,"ل",1,0],["أَعْمَالُهُ شَتَّى يَسُوسُ أُمُورَهَا","لَبِقاً وَلا يَلْفِي شَتِيتَ الْخَاطِرِ",48,"ر",1,0],["أَعَمَايَةٌ لاَ لاَ وَلِكنْ حِكْمَةٌ","ثَبُتَتْ بِمُتَّصِلٍ مِنَ التَّكْرَارِ",49,"ر",1,0],["أَعمالُ شيبٍ وَطِفلٍ","كَأَنَّهُنَّ اِختِصارُ",50,"ر",1,0],["أعمرو بنَ هند ما ترى رأي معشر","أماتوا أبا حسان جاراً مُجاورا",51,"ر",2,1],["اعمل لدار البقاء رضوان خازنها","الجار احمد والرحمن بانيها",52,"ي",3,1],["أعمالُك الغُرُّ الحسانُ خوالدٌ","والمرءُ عن أعماله مسؤول",53,"ل",1,0],["أعملت في عيني أنفاسه ودمعة عينه","مثل مايعمل .بخار الشاي. فالنّظاره",54,"ر",2,0],["أعميد سوريّا وكاشف ضرّها","خلقت يداك من الشيوخ شبابا",55,"ب",2,0],["أعملنُهُ يركضُ في غَيّهِ","والخيلُ تُبقي الجَريَ للخيلِ",56,"ل",1,0],["أعمى عن المزحِ غبيّاً غافلاً","يُلزمُني الجهلَ ولستُ جاهلا",57,"ل",2,0],["أعمى تلفّتت العصور فما رأت","عند الشموس كنوزه اللّماح",58,"ح",1,0],["أعمى ونورُ الهُدَى بادٍ له وكذا","من لم يساعِده توفيقٌ وتسديدُ",59,"د",1,0],["أعمى تُطاعِنه الشُّجون","وجراحهُ صارت عُيون",60,"ن",1,0],["أعمى ونُورُ الهُدى بادٍ لَهُ وكذا","من لم يساعِدُ توفيقٌ وتسديدُ",61,"د",1,0],["أَعَمُّ الوَرى جوداً إِذا بَخِلَ الحَيا","وَأَصدَقُهُم بِشراً إِذا البَرقُ سَوَّفا",62,"ف",2,0],["اعمل بآثار النب","ي فإنها النور المبين",63,"ن",1,1],["أعملت سيفك جاهدا ومجاهداً","في فرقة الأرواح للأجسام",64,"م",1,0],["أعمالك الحسنى لديك فكم به","من فرض صالحها ومن مسنونه",65,"ن",2,0],["أعماهم ليبين حلماً واسعاً","لكَ عن جهالتهم وفضلاً بيّنا",66,"ن",2,0],["أعمى القضي وأصم القوم فارتكبوا","ما ليس تخطو له من غافل قدم",67,"م",1,0],["أَعَمُّ مَضَرَّةً مِن أَبي خِلاطٍ","وَأَعيا مِن أَبي الفَرَجِ بنِ حَفصِ",68,"ص",1,0],["أَعَمىً غالَكُمُ أَم ناصِحٌ","مُضمِرُ البَغضاءِ مُبدٍ لِلوِدادِ",69,"د",1,0],["أعمى غريبا وماله أحد","فأحضروه الحنوط والكفنا",70,"ن",2,0],["أَعمى عيونهمُ عَمى ألبابِهم","ومَضى لِطيبة واِنثنى بِعذابهم",71,"م",1,0],["أعملتُ فيها خاطري سَحَراً","فاشتقّ منه فجاء بالسحرِ",72,"ر",1,0],["أعمى يحنّ إلى مَن ليس ينظره","هذا لعمري من الآيات والعِبَرِ",73,"ر",1,0],["أعمى يُغَنَّى إذا ما الشوق أقلَقَه","عيني أُديرُ فما لي لا أرى القمر",73,"ر",1,0],["اعمل على أني أُرَدُّ عن الذي","أبغي فكيف أردُّ عيناً تبصرُ",74,"ر",1,0],["أَعمَلَ زَندَ رَأيِهِ ال","ثاقِبِ فيهِ فَاِقتَدَح",75,"ح",1,0],["أعمل في اللحمِ للعشاء ولا","أنالُ منه العَشا فما ذَنبي",76,"ي",1,0],["أعمالنا هذه التي كثر ال","إرجاف فيها بنا فليس تقف",77,"ف",1,0],["اعمل بها لي عمراً جامعاً","مستظهراً فيه كما تدري",78,"ي",1,0],["أعماه سلطان الهوى","وعن المواعظ قد أصمّه",79,"م",2,0],["أعمَى البَصيرَة مَنْ تَقدَّمه الهَوى","وحِجَاه بِالرّأي الرّشيد بَصيرُ",80,"ر",1,1],["أَعَمُّهُمُ إِذا كَرُمُوا سماحاً","وَأَثْقَلُهُمْ إِذا حَلُمُوا مَرازا",81,"ز",2,0],["أَعّمَّ نَوالاً مِنَ الْبَحْرِ فاضَ","وَأَطْيَبَ نَشراً مِنَ الْمِسْكِ فاحا",82,"ح",2,0],["أَعَمُّهُمُ غَيْثاً إِذا بَخِلَ الْحيَا","وَأَطْعَنُهُمْ وَالْخَيْلُ تُدْمى نُحُورُها",83,"ر",3,0],["أَعُمَيرَ إِنَّ أَباكِ شَيَّبَ رَأسَهُ","كَرُّ اللَيالي وَاِختَلافُ الأَعصُرِ",84,"ر",1,0],["أعمى عيونَهمُ الدينارُ حيث عَلى","قلوبهمْ وعَلى أسماعهمْ ختما",85,"م",2,0],["اعمد إلى تركيبه","فيه وصحف أحرفه",86,"ف",2,0],["أعمامي الصيد في الإسلام منبتهم","والعيسويون في التاريخ أخوالي",87,"ي",1,0],["أعماركم تقضونها في ذلة","وكزازة وحياتكم اسلاب",88,"ب",1,0],["اِعمل بدُنياك واِحذر مِن عَواقبها","فَلَست تَأَمنُ يَوماً مِن نَوائبها",89,"ه",2,1],["أَعمارُ دَولَتِهِم إِن أُمهِلَت سَنَةٌ","كَأَنَّما هِيَ أَعمارُ التَقاويمِ",90,"م",1,0],["أعميدَ دولةِ هاشمٍ ما عُدَّتي","إلاّ رَجاؤك والخُطوبُ روائعي",91,"ع",2,0],["أعمارُ أعدائه في عَصْرِه قِصَراً","مِقْدارُ لَبْثِ سهامٍ فوقَ أَعجاس",92,"س",1,0],["أَعمالُ دَهرٍ إِذا أَنكَرتُ سُنَّتَها","عَرَفتُ مِنها بِما عوقِبتُ آمالي",93,"ي",1,0],["أعمى وليس له عينٌ لينظرنا","بذلة الموت في أدراج أكفان",94,"ن",1,0],["أعم من في الوجود جوداً","على الندى ماله ندامه",95,"م",2,0],["أعمى الهوى قلبي الْمُعَنَّى","والغرام أتى يقوده",96,"د",2,0],["أعمى بصيرته وسد مسامعاً","منه أليس به النصيح يصيح",97,"ح",1,0],["أعمى وأحمق لا ينفك ذا دغلٍ","وتستوي عنده الأثمارُ والنفض",98,"ض",1,0],["اعمل لنفسك ما استطعت","الدهر من حسن اكتساب",99,"ب",1,1],["أعمى وقد أبصرتُ كم من غائبٍ","ما بعد رحلته إليّ قُفولُ",100,"ل",1,0],["أعمداً تُهيِّجْن أمرأً بان أنسُه","وأسلَمهُ حتى أخوه وصَحْبُهُ",101,"ب",2,0],["أعمى القتامُ به الكُماةَ فخيلُهُ","لولا بريقُ حديده لم تنظر",102,"ر",1,0],["اعمل بني فأنت من","عملي لترضي والديك",103,"ك",1,1],["أعمالُهُ وخِلالُهُ وخِصَالُهُ","مَحفُوفةٌ بِعِنايةِ الرَّحمانِ",104,"ن",1,0],["أعمالُه زانَها من قَولِهِ حِكَمٌ","وقولُه زانَهُ من جودِه عَمَلُ",105,"ل",1,0],["أَعْمَلْتُ بَعْضَ رَجَائِي فِي الكِرَامِ وَفِي","أَبِي عَلِيَّ قَدِ اسْتَغْرَقْتُهُ كُلَّهْ",106,"ل",2,0],["أَعمى إِذا ما جارتي خرجت","حتىّ يواري جارتي الخدرُ",107,"ر",1,0],["أَعْمِلوا في هَجْوه الفِكَرَا","واجْعلُوا أَخبارَه سَمَرا",108,"ر",2,1],["أعمارهم بالخير معمورة","منه كما الأحوال منهم حوال",109,"ل",1,0]]}