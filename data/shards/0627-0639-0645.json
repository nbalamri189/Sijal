دِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5587,"أقات وأقات","https://www.poetsgate.com/ViewPoem.aspx?id=197787",""],[5605,"يا موجعا","https://www.poetsgate.com/ViewPoem.aspx?id=161346",""],[5616,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=203462",""],[5674,"أعمى الزمان قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=186707",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""],[5725,"رثاء الشيخ نوري صالح الاوحيد","https://www.poetsgate.com/ViewPoem.aspx?id=215669",""],[5794,"غابة الاسمنت","https://www.poetsgate.com/ViewPoem.aspx?id=74071",""],[5827,"اعمل على وأدِ الهوى في مهدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207776",""],[5827,"اعمل بجهدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207777",""],[5827,"وتسارعت أعمارنا","https://www.poetsgate.com/ViewPoem.aspx?id=207781",""],[5910,"هتف البيانُ فراع قلبَ الواجلِ","https://www.poetsgate.com/ViewPoem.aspx?id=206320",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5943,"أعمار شتى","https://www.poetsgate.com/ViewPoem.aspx?id=34568",""],[5956,"النقود الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=184581",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[5956,"أرسلتُ من أموالكم لمياتمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193833",""],[5956,"مثل انبثاق الفجر صوت محمد","https://www.poetsgate.com/ViewPoem.aspx?id=194380",""],[5984,"لهف نفسي على الغزال الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=200379",""],[6035,"متى أردتمُ رفعَ الثوب تَمْتَثِلُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177094",""],[6052,"سلام الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=34888",""],[6085,"سر ياقلم","https://www.poetsgate.com/ViewPoem.aspx?id=8675",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[5309,"أعمالهم محدودة قاصره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573905",""]],"verses":[["أعمهم الثناء وبعد طه","أخص الأنزع البطلَ المهابا",0,"ب",2,0],["أَعَمرو اِبنَ فَرّاشَةِ الأَشيَمِ","صَرَمتَ الحِبالَ وَلَم تُصرَمِ",1,"م",1,1],["أعْمَلْتُ بعْدَكَ بالمُحَصَّبِ وقْفَتي","أدْعو مِن السُّلْوانِ غيْرَ سَميعِ",2,"ع",1,0],["أَعِمَادَنَا السَّامِي الْعُلَى وَأَبَانَا","وَمَلاَذَنَا مِنْ حَادِثٍ يَغْشَانَا",3,"ن",2,1],["أَعْمَلْتُمُ العَزْمَ الصَّحِيحَ فَلَمْ يَكُنْ","لِيَرُوعَكُمْ فِي غِيلِهِ الضِّرْغَامُ",4,"م",1,0],["أَعَمُّ ضِياءً مِن أُمَيَّةَ أَشرَقَت","بِهِ الذِروَةُ العُليا عَلى كُلِّ يافِعِ",5,"ع",1,0],["أعماله للملقين","بمصر قد فتحت كنوزه",6,"ز",2,0],["أعمل الرأي وقد جادله","فيه بعض القوم واشتدّ الجدال",7,"ل",1,0],["أَعمِلِ العيسَ عَلى عِلّاتِها","إِنَّما يُنجِحُ أَصحابُ العَمَل",8,"ل",1,0],["أعمال برك في حلي امتداحك يا","عليّ سيارةٌ بين الأقاليم",9,"م",1,1],["أعمّ الورى جوداً وأبرع منطقاً","فقل في سحاب الجود تزجيه سحبان",10,"ن",1,0],["أعملُ في الأيامِ ما أشتهي","لأنَّني أصبحتُ بدريَّا",11,"ي",2,0],["أَعمى بَصيرٌ وَإِني أَبلَهٌ فَطِنٌ","وَلي كَلامٌ إِذا ما شِئتُ مَقلوبُ",12,"ب",1,0],["أعمُّكُمُ مدحاً وأختصُّ منكُمُ","فتاكم عبيدَ اللَه والرأسُ رائس",13,"س",1,0],["أعملتُهُ يركضُ في غَيّهِ","والخيلُ تُبقي الجَريَ للخيلِ",14,"ل",1,0],["أعمُّهُمُ مدحاً وأختصُّ منهمُ","أخاهم عبيدَ اللَّه والحق يُلْزَمُ",15,"م",1,0],["أعُمُّكُمُ مدحاً وأختصُّ منكم","فتاكم أبا سهلٍ ولستُ بظالمِ",16,"م",1,0],["أُعمِلُ فيهم ذكراً حُساما","عضْب الغِراريْن يقُدُّ الهاما",17,"م",2,1],["أعملت حلمَكَ في السفيه وجَهلِهِ","رحْبَ الجوانح صادق التوطينِ",18,"ن",1,0],["أَعَميدَ سُرِيّا وَكاشِفَ ضَرِّها","خَلَقَت يَداكَ مِنَ الشُيوخِ شَبابا",19,"ب",2,0],["اعمارنا ليست على سعة المنى","ان الحياة قصيرة الآجال",20,"ل",1,0],["أَعمى هَوى الوَطَنِ العَزيزِ عِصابَةٌ","مُستَهتِرينَ إِلى الجَرائِمِ ساروا",21,"ر",3,0],["اعمل بجدّ وجَلَد","فإنّ من جَدّ وجد",22,"د",1,1],["أعمالنا فيها وأسرارنا","وما سواها فمتاع الغرور",23,"ر",1,0],["أَعَمروُ بنَ شَيبانَ وَشَيبانُكُم أَبي","إِذا نُسِبَت أُمّي وَعَمروُكُمُ عَمري",24,"ر",2,0],["أَعمامُ نُتلَةَ أُمِّكُم وَهيَ الَّتي","شَرُفَت وَإِخوَةُ عامِرِ الضَحيانِ",25,"ن",1,0],["أَعمى لَهُ بَصَرٌ يَعيبُ صَديقَهُ","يَأتي المَثالِبَ في خَفاً وَسُكونِ",26,"ن",1,0],["أَعَمَّ عَلى ذُهلِ بنِ شَيبانَ نِعمَةً","وَأَدفَعَ عَن أَموالِها وَدِمائِها",27,"ا",3,0],["اِعمِد إِذا كُنتَ مُختاراً نَدى رَجُلٍ","إِلى جَميلٍ فَتى الجودِ اِبنِ حُمرانا",28,"ن",2,1],["أعمودُ الصبح في الغيهبِ أم","غُرّةُ الأشقرِ في الغيمِ الأحَمْ",29,"م",1,0],["أَعمَلتُ فيكَ قَصائِدي وَوَسائِلي","فَحَرَمتَني فَلَبِئسَ أَجرُ العامِلِ",30,"ل",1,0],["أَعمَلَ النَتفَ وَاِطَّلى وَقَديماً","كانَ صَعباً أَن تُشعَبَ القارورَه",31,"ر",2,0],["أَعمَلَت طَرفَها إِلَيَّ وَقالَت","حُبَّ بِالسائِرينَ زَوراً إِلَينا",32,"ن",2,0],["أعَمْىَ يَقودُ النَّاسَ في بَلَدٍ","أَعْمَى يُعظِّمُ قَدْرَ مَن جَهِلا",33,"ل",2,0],["اعمل وجاهد يا مُحمّدُ إنّها","دُنيا يموتُ بها الجبانُ الهائبُ",34,"ب",1,0],["أَعمَلتَ رَأيَكَ في الوَساوِسِ حِقبَةً","وَشَغَلتَ نَفسَكَ بِالمُحالِ سَنينا",35,"ن",2,0],["أعملوا القتلَ والنِّهابَ وَرَدُّوا","كلَّ غُنمٍ أصابه القومُ غُرْما",36,"م",2,0],["أعمالُهُ كلُّها للَّهِ خالِصَةٌ","ونُصْحُهُ لم يُخالِطْ صَفْوَهُ كَدَرُ",37,"ر",1,0],["أَعمى يَقودُ بَصيراً لا أَبا لَكُمُ","قَد ضَلَّ مَن كانَتِ العُميانُ تَهديهِ",38,"ه",1,1],["أَعمى البَصيرَةِ لا يَهديهِ ناظِرُهُ","إِذا كُلُّ أَعمى لَدَيهِ مِن عَصاً هادِ",39,"د",1,0],["أَعمارُنا جاءَت كَآيِ كِتابِنا","مِنها طِوالٌ وُفِّيَت وَقِصارُ",40,"ر",1,1],["اِعمَل لِأَخراكَ شَروى مَن يَموتُ غَداً","وَاِدأَب لِدُنياكَ فِعلَ الغابِرِ الباقي",41,"ق",2,1],["أَعمى بَخيلٌ أَو بَصيرٌ فاجِرٌ","نوءُ الضِلالِ بِهِ مُرِبٌّ مُثجَمُ",42,"م",1,0],["أَعَمرَ بنَ هِندٍ ما تَرى رَأيَ صِرمَةٍ","لَها سَبَبٌ تَرعى بِهِ الماءَ وَالشَجَر",43,"ر",1,1],["أَعمى فَلست أَرى يو","ماً ما يَراه البَصير",44,"ر",1,0],["اعمَل لأن تبقى الحَياة لَذيذَة","لك وَليكن من بعدك الطوفان",45,"ن",1,0],["أعمى عن الليل بها والنهار","وددت لو قلبي كهذي القفار",46,"ر",1,0],["أَعَمرُو بنَ قَيسٍ إِنَّ نَسرَكُمُ غَدا","وَآبَ إِلى أَهلِ الأَصارِمِ مِن جُشَم",47,"م",1,1],["أَعُمْتِ إلينا أمْ فِعالَ ابنِ مَرْيمٍ","فعَلْتِ وهلْ يُعْطى النُبوّةَ مِكْسالُ",48,"ل",1,0],["أَعْمَالُهُ شَتَّى يَسُوسُ أُمُورَهَا","لَبِقاً وَلا يَلْفِي شَتِيتَ الْخَاطِرِ",49,"ر",1,0],["أَعَمَايَةٌ لاَ لاَ وَلِكنْ حِكْمَةٌ","ثَبُتَتْ بِمُتَّصِلٍ مِنَ التَّكْرَارِ",50,"ر",1,0],["أَعمالُ شيبٍ وَطِفلٍ","كَأَنَّهُنَّ اِختِصارُ",51,"ر",1,0],["أعمرو بنَ هند ما ترى رأي معشر","أماتوا أبا حسان جاراً مُجاورا",52,"ر",2,1],["اعمد ممن ضللته صبوة","وبين فوديه ضياء ابن جلا",53,"ا",1,0],["اعمل لدار البقاء رضوان خازنها","الجار احمد والرحمن بانيها",54,"ي",3,1],["أعمالُك الغُرُّ الحسانُ خوالدٌ","والمرءُ عن أعماله مسؤول",55,"ل",1,0],["أعملت في عيني أنفاسه ودمعة عينه","مثل مايعمل .بخار الشاي. فالنّظاره",56,"ر",2,0],["أعميد سوريّا وكاشف ضرّها","خلقت يداك من الشيوخ شبابا",57,"ب",2,0],["أعملنُهُ يركضُ في غَيّهِ","والخيلُ تُبقي الجَريَ للخيلِ",58,"ل",1,0],["أعمى عن المزحِ غبيّاً غافلاً","يُلزمُني الجهلَ ولستُ جاهلا",59,"ل",2,0],["أعمى تلفّتت العصور فما رأت","عند الشموس كنوزه اللّماح",60,"ح",1,0],["أعمى ونورُ الهُدَى بادٍ له وكذا","من لم يساعِده توفيقٌ وتسديدُ",61,"د",1,0],["أعمى تُطاعِنه الشُّجون","وجراحهُ صارت عُيون",62,"ن",1,0],["أعمى ونُورُ الهُدى بادٍ لَهُ وكذا","من لم يساعِدُ توفيقٌ وتسديدُ",63,"د",1,0],["أَعَمُّ الوَرى جوداً إِذا بَخِلَ الحَيا","وَأَصدَقُهُم بِشراً إِذا البَرقُ سَوَّفا",64,"ف",2,0],["اعمل بآثار النب","ي فإنها النور المبين",65,"ن",1,1],["أعملت سيفك جاهدا ومجاهداً","في فرقة الأرواح للأجسام",66,"م",1,0],["أعمالك الحسنى لديك فكم به","من فرض صالحها ومن مسنونه",67,"ن",2,0],["أعماهم ليبين حلماً واسعاً","لكَ عن جهالتهم وفضلاً بيّنا",68,"ن",2,0],["أعمى القضي وأصم القوم فارتكبوا","ما ليس تخطو له من غافل قدم",69,"م",1,0],["أَعَمُّ مَضَرَّةً مِن أَبي خِلاطٍ","وَأَعيا مِن أَبي الفَرَجِ بنِ حَفصِ",70,"ص",1,0],["أَعَمىً غالَكُمُ أَم ناصِحٌ","مُضمِرُ البَغضاءِ مُبدٍ لِلوِدادِ",71,"د",1,0],["أعمى غريبا وماله أحد","فأحضروه الحنوط والكفنا",72,"ن",2,0],["أَعمى عيونهمُ عَمى ألبابِهم","ومَضى لِطيبة واِنثنى بِعذابهم",73,"م",1,0],["أعملتُ فيها خاطري سَحَراً","فاشتقّ منه فجاء بالسحرِ",74,"ر",1,0],["أعمى يحنّ إلى مَن ليس ينظره","هذا لعمري من الآيات والعِبَرِ",75,"ر",1,0],["أعمى يُغَنَّى إذا ما الشوق أقلَقَه","عيني أُديرُ فما لي لا أرى القمر",75,"ر",1,0],["اعمل على أني أُرَدُّ عن الذي","أبغي فكيف أردُّ عيناً تبصرُ",76,"ر",1,0],["أَعمَلَ زَندَ رَأيِهِ ال","ثاقِبِ فيهِ فَاِقتَدَح",77,"ح",1,0],["أعمل في اللحمِ للعشاء ولا","أنالُ منه العَشا فما ذَنبي",78,"ب",2,0],["أعمالنا هذه التي كثر ال","إرجاف فيها بنا فليس تقف",79,"ف",1,0],["اعمل بها لي عمراً جامعاً","مستظهراً فيه كما تدري",80,"ر",2,0],["أعماه سلطان الهوى","وعن المواعظ قد أصمّه",81,"م",2,0],["أعمَى البَصيرَة مَنْ تَقدَّمه الهَوى","وحِجَاه بِالرّأي الرّشيد بَصيرُ",82,"ر",1,1],["أَعَمُّهُمُ إِذا كَرُمُوا سماحاً","وَأَثْقَلُهُمْ إِذا حَلُمُوا مَرازا",83,"ز",2,0],["أَعّمَّ نَوالاً مِنَ الْبَحْرِ فاضَ","وَأَطْيَبَ نَشراً مِنَ الْمِسْكِ فاحا",84,"ح",2,0],["أَعَمُّهُمُ غَيْثاً إِذا بَخِلَ الْحيَا","وَأَطْعَنُهُمْ وَالْخَيْلُ تُدْمى نُحُورُها",85,"ر",3,0],["أَعُمَيرَ إِنَّ أَباكِ شَيَّبَ رَأسَهُ","كَرُّ اللَيالي وَاِختَلافُ الأَعصُرِ",86,"ر",1,0],["أعمى عيونَهمُ الدينارُ حيث عَلى","قلوبهمْ وعَلى أسماعهمْ ختما",87,"م",2,0],["اعمد إلى تركيبه","فيه وصحف أحرفه",88,"ف",2,0],["أعمامي الصيد في الإسلام منبتهم","والعيسويون في التاريخ أخوالي",89,"ل",2,0],["أعماركم تقضونها في ذلة","وكزازة وحياتكم اسلاب",90,"ب",1,0],["اِعمل بدُنياك واِحذر مِن عَواقبها","فَلَست تَأَمنُ يَوماً مِن نَوائبها",91,"ه",2,1],["أَعمارُ دَولَتِهِم إِن أُمهِلَت سَنَةٌ","كَأَنَّما هِيَ أَعمارُ التَقاويمِ",92,"م",1,0],["أعميدَ دولةِ هاشمٍ ما عُدَّتي","إلاّ رَجاؤك والخُطوبُ روائعي",93,"ع",2,0],["أعمارُ أعدائه في عَصْرِه قِصَراً","مِقْدارُ لَبْثِ سهامٍ فوقَ أَعجاس",94,"س",1,0],["أَعمالُ دَهرٍ إِذا أَنكَرتُ سُنَّتَها","عَرَفتُ مِنها بِما عوقِبتُ آمالي",95,"ل",2,0],["أعمى وليس له عينٌ لينظرنا","بذلة الموت في أدراج أكفان",96,"ن",1,0],["أعم من في الوجود جوداً","على الندى ماله ندامه",97,"م",2,0],["أعمى الهوى قلبي الْمُعَنَّى","والغرام أتى يقوده"