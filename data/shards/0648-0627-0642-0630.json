{"poems":[[55,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[97,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[53,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[87,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[230,"أمطري يا سماء في كل يوم","https://www.aldiwan.net/poem55180.html","الخفيف"],[333,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[369,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[545,"واقذف بحبلك حيث نال بأخذه","https://www.aldiwan.net/poem56799.html","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112460","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62605","الهزج"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/90463","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35388","البسيط"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96454","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141322","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88632","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106881","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45559","المنسرح"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89317","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3650,"","https://poetry.dctabudhabi.ae/diwan/poem/34817","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85251","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45127","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62125","الكامل"],[5089,"عرِّجْ على هذا الجمال الأقدسِ","https://www.poetsgate.com/ViewPoem.aspx?id=128710",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5956,"شهر التأشيرة هو شهر النحس","https://www.poetsgate.com/ViewPoem.aspx?id=192787",""],[6102,"مرثية كل يوم","https://www.poetsgate.com/ViewPoem.aspx?id=185050",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""]],"verses":[["وَاِقذِف بِنَفسِكَ في شَعواءَ خابِطَةٍ","كَالسَيلِ يَعصِفُ بِالصَوّانِ وَاللوبِ",0,"ب",1,0],["واقذفيها الله أكبر حتى","ينتشي كل كوكب وضاء",1,"ا",2,0],["وأقذرُ الناس أسناناً وأطفَسُهم","وأشبه الناسِ أخلاقاً بإنسان",2,"ن",1,0],["وَاِقذِفي بِالهَمِّ في وَجهِ الثَرى","وَاِطرَحي مِن حالِقٍ عِبءَ السِنين",3,"ن",1,0],["وَاِقذِفي يا بحارُ كلَّ جيوش ال","أرضِ في مِصرَ لاحتِلال الدِيار",4,"ر",1,0],["واقذفي بالتراب حينا إلى الشم","س وحينا إلى ضمير العباب",5,"ب",1,0],["واقْذِفْ منَ المَنزلِ النّائي بأَرحُلِنا","إلى كريمٍ يُوفّي الظّنَّ ما اشْتَرطا",6,"ط",2,0],["واِقذف بحبلِكَ حيثُ نالَ بأَخذِهِ","مِن عُودِها واِغنَم وَلا تَتَوَسَطِ",7,"ط",1,1],["واقذف بنا لنصطلي لهبها","ما شعرة تزيغ عن طاعتك",8,"ك",1,0],["وأقذفنا لهم بحراً","من البغضاء والشحنا",9,"ن",2,0],["وَاِقذفي النُقطةَ التي بات فيها","غَضبُ القاهرِ المُذِلِّ كمينا",10,"ن",2,0],["وَاِقذِف بِعَبدِكَ في بَحرِ نَداكَ لِكَي","يَدنو إِلى ساحِلٍ مِن شاطِئٍ خَضِلِ",11,"ل",1,0],["وَاقذِف أَبَا الطَّمَحَانِ وَسطَ خُوانِهِم","وابنُ الطَّرَامَةِ شَاعِرٌ لَم يُجهَلِ",12,"ل",1,0],["وأقذف الهمّ وانفث السّمّ واجمع","جيشك الجمّ من جنوده عتاة",13,"ه",1,0],["واقذف بنفسك حيث طابَ لها السرى","او فاِستخف من الجبال ثقالها",14,"ل",3,0],["وأقذف بهذا القرب في لججٍ","للصدر طاميةٍ من الجهل",15,"ل",1,0],["وَأَقذيت عَين شَمس فَحَكَت","مِن خَلل الغَيم طَرف عَمشاءِ",16,"ا",2,1],["واقذف بمقذاف الدعا إن لم تكن","هبت رياح الجد بالأنسام",17,"م",1,0],["وأقذف در أجفاني عليه","كذاك البحر يقذف باللآلي",18,"ل",2,0],["واِقذف بها في لجّةٍ","أَو تنقذ المُستَسلِما",19,"م",2,0],["وَاِقذِفي في لَجَّةِ البَح","رِ بِقَوسي وَسِهامي",20,"م",2,0],["واقذف جنود ابن جرجيس وشيعته","بكل هجو بمنظوم ومنثور",21,"ر",1,0],["وَأَقذى عُيونَ الأسدِ مَعَ أَعيُنِ الَها","وَوارى سُرورَ الأَرضِ في باطِنِ الأَرضِ",22,"ض",1,0],["واقذف نحو المشركين بجحفل","يمحو معالم أرضها ومنارها",23,"ر",3,0],["واقذِرْ طواغي الكون في أنبائه","واسلكْ سبيلَ الحق حقًا تَرْأَس",24,"س",1,0],["واقذفه في أجسام من","جروا إلى الطون الحرب",25,"ب",1,0],["وأقذف حزمةَ كلِّ نهارٍ","إلى البحرِ أهتفُ: ساء المَقَرُّ",26,"ر",1,0],["وَ أَقذِفُ الشِّعرَ مِنْ جَمرِ الجَوَى غَضَبًا","وَ أَعصِفُ الحَرفَ مِنْ دَوَّامَتِي حَنَقا",27,"ق",2,0],["وأَقْذِفُ بالإيمانِ كلَّ خرافةٍ","تشقُّ لها في جبهةِ الفكرِ مَعْبَرَا",28,"ر",2,0]]}