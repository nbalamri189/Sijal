{"poems":[[55,"أتأذنون لصب في زيارتكم","https://www.aldiwan.net/poem26294.html","البسيط"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"ليعاقب وسمي جود وليه","https://www.aldiwan.net/poem66723.html","الطويل"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"يا نبأ سر به مسمعي","https://www.aldiwan.net/poem9060.html","عموديه"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[66,"يا مليكا قد طاب أصلا وفرعا","https://www.aldiwan.net/poem41352.html","الخفيف"],[21,"ليطلب الثأر أمثال ابن ذي يزن","https://www.aldiwan.net/poem36166.html","البسيط"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85490","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85863","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19262","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54527","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55062","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43888","المديد"],[128,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[143,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[169,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[223,"قيثارتي لم ألطخها بأقذار","https://www.aldiwan.net/poem41588.html","البسيط"],[229,"قد أغتدي قبل الصباح المسفر","https://www.aldiwan.net/poem51001.html","الرجز"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[235,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[275,"لا يضع مني لوني عندكم","https://www.aldiwan.net/poem25571.html","الرمل"],[304,"خل عنك الهم يا قلب الحزين","https://www.aldiwan.net/poem16773.html","الرمل"],[328,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[342,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[349,"أيماري من لا رأى طيف سعدى","https://www.aldiwan.net/poem15604.html","الخفيف"],[366,"لا يضيع الله من عمل","https://www.aldiwan.net/poem17251.html","المديد"],[369,"لا يضجرنكم كتبي إذا كثرت","https://www.aldiwan.net/poem4270.html","البسيط"],[410,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[416,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[458,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[538,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[538,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[553,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"]],"verses":[["لا يُضمِرُ السوءَ إِن طالَ الجُلوسُ بِهِ","عَفُّ الضَميرِ وَلَكِن فاسِقُ النَظَرِ",0,"ر",1,0],["لا يَضِع وُدِّيَ الصَريحُ الَّذي أَر","ضاكَ مِنهُ اِستِواءُ سِرّي وَجَهري",1,"ر",2,0],["لا يضق صدر شاعرٍ بأخيه","يكره الفضل أن تضيق الصدور",2,"ر",1,0],["لاّ يَضْربُ الركبُ الطلائحَ نحوَهُ","بل باسمه يُزْجونَ كلَّ طَليحِ",3,"ح",1,0],["لا يضاهيه في المحاسن إلا","ما تسدّيه كفّهُ من فعالِ",4,"ل",1,0],["لا يُضاهيهِ في المحاسن إلا","ما يُسدّيه كفُّه من فعالِ",5,"ل",1,0],["لا يَضِعْ آملٌ لديك ولا يُحْ","رَمْ عطاءً جزيلاً وأنتَ سَميُّهْ",6,"ي",2,0],["لا يَضبُطونَ مَعَ الصُروفِ قَيادَهُم","إِلّا كَما ضَبَطَ المِياهَ المِنخَلُ",7,"ل",1,0],["لا يَضحَكُ السامِعُ مِن هَزلِهِ","كَم عِظَةٍ جاءَ بِها الهازِلُ",8,"ل",1,0],["لا يضرنَّكم قلته","كل مولود وإن جل ضئيل",9,"ل",1,0],["لا يَضِق ذَرعُكَ بِالقَيدِ الَّذي","حَزَّ في سوقِ الأَوالي وَبَراها",10,"ا",3,0],["لا يَضِق ذَرعُكَ عِندَ الأَزَمات","إِن هِيَ اِشتَدَّت وَأَمِّل فَرَجا",11,"ج",2,0],["لا يَضُرُّ القَضيبَ وَهوَ نَضيرٌ","أَن تَزولَ الثَمارُ وَالأَوراقُ",12,"ق",1,0],["لا يَضجَرونَ وَإِن حُرَّت مَغافِرُهُم","وَلا تَرى مِنهُم الطَعنَ مَيّالا",13,"ل",2,0],["لا يَضَعُ اللَأمَةَ عَن جِلدِهِ","وَمِحمَلَ السَيفِ عَنِ المَنكِبِ",14,"ب",1,0],["لا يضجر الحر حين يَسعى","إلا من الذل وَالصغار",15,"ر",1,0],["لا يضر اليقين إن","جحد اللَه جاحد",16,"د",1,1],["لا يَضُرَّنَّكُمو قِلَّتُهُ","كُلُّ مَولودٍ وَإِن جَلَّ ضَئيل",17,"ل",1,0],["لاَ يَضِنُّونَ بِمَجْهُودَاتِهِمْ","وَقَدِيماً لَمْ يَضِنُّوا بِالدِّمَاءْ",18,"ا",2,0],["لاَ يُضَاهِي حِلاَهُ إِلاَّ حِلَى النَّثْ","رِ وَحَدِّثْ عَنْ نَثْرَِعَبْدِ الحَمِيدِ",19,"د",1,0],["لا يُضَاهِي رِوَاؤُهُ فِي جَلِيلٍ","يَنْتَقِيهِ الصَّنَّاعُ أَوْفَى دَقِيقِ",20,"ق",1,0],["لاَ يَضِيقُ صَدْرُ شاعِرٍ بِأَخِيهِ","يَكْرَهُ الْفَضْلُ أَنْ تَضِيقَ الصُّدُورُ",21,"ر",1,0],["لا يَضِقْ مَنْ صدرُهُ حَرجٌ","شَيْخُنَا الشَّعْبِيُّ شارِحُهُ",22,"ح",2,1],["لا يضيقُ المرءُ من كسب يديهِ","لاَ ولا يغنيه دهراً ما لديهِ",23,"ه",1,0],["لا يُضمِرَنَّ سَفيهُكُم بِرِضاكُمُ","غَدراً فَأُمُّ الغادِرينَ ثَكولُ",24,"ل",1,0],["لا يَضبطُ الأَمرَ مَن في عُودِهِ خَوَرٌ","لَيسَ البُغاثُ يُساوي أَجدَلاً قَطِما",25,"م",2,0],["لا يَضمر الحُبُّ إِلّا في مَحاجِرِه","فَعَينه لِلهَوى وَالقَلبُ لِلثارِ",26,"ر",1,0],["لا يضع الناب بغير منخر","فأيّ جأْب عانةٍ لم يَجزُر",27,"ر",1,0],["لا يُضحِ عَن ظِلِّ أَياديكَ مِن","باتَ إِلى ظِلِّكَ ذا فَقرِ",28,"ر",1,0],["لا يُضمِرونَ الوَفاءَ إِن عَهِدوا","عَهداً لا يُنجِزونَ إِن وَعَدوا",29,"د",3,0],["لا يَضَعْ مِنِّي لَوْنِي عِنْدكُم","رُبّ لَيْل فَضَلَ اليَوْمَ وزادا",30,"د",2,1],["لا يَضيقُ صَدري وَإِن ضاقَ الفَضا","وَاِنتَظِر لُطفاً خَفِيّاً يا ظَنين",31,"ن",1,0],["لا يضِركَ السهوم في نظراتي","والأنين المنساب في كلماتي",32,"ت",2,0],["لا يضير الضحايا ان يدرجوا الاك","فان موتى وانهم اشلاء",33,"ا",2,0],["لا يُضاهي الأَعمى البَصيرُ وَلا الظُل","مَةَ نورٌ وَلا الغَوِيَّ الرَشيدُ",34,"د",1,0],["لا يُضيعُ اللَهُ مِن عَمَلِ","وَلَكَ السَرّا فَقُل وَطُلِ",35,"ل",1,1],["لا يضجرنكم كتبي إذا كثرت","فإنَّ شوقيَ أضعافُ الذي فيها",36,"ي",3,1],["لا يَضُرُّ اِمرِأً إِذانا وُدّاً","مِنكَ إِلّا يَنالَهُ مِن سِواكا",37,"ك",2,0],["لا يُضام النزيلُ فيهم بحالٍ","وأبى الله جارَهم أن يُضاما",38,"ا",1,0],["لا يُضحك الأيامَ كذبُ مطامعي","إلا إذا طالبتُها بصديقِ",39,"ق",1,0],["لا يَضيرُ البدرَ كَونُ البدرِ مِن","بينِ أيَّامِه أيامُ المِحَاق",40,"ق",1,0],["لا يَضيرُ الحسناءَ يَخطُبُها فَد","مٌ لها كانت روحُه بَعدُ مَهرا",41,"ر",2,0],["لا يَضحَكُ الدَهرُ إِلّا حينَ تَسأَلُهُ","وَلَيسَ يَعبُسُ إِلّا حينَ لا يُسَلُ",42,"ل",1,0]]}