{"poems":[[57,"أتأذنون لصب في زيارتكم","https://www.aldiwan.net/poem26294.html","البسيط"],[75,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[53,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"ليعاقب وسمي جود وليه","https://www.aldiwan.net/poem66723.html","الطويل"],[93,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[93,"يا نبأ سر به مسمعي","https://www.aldiwan.net/poem9060.html","عموديه"],[87,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[68,"يا مليكا قد طاب أصلا وفرعا","https://www.aldiwan.net/poem41352.html","الخفيف"],[21,"ليطلب الثأر أمثال ابن ذي يزن","https://www.aldiwan.net/poem36166.html","البسيط"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85490","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85863","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19262","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54527","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55062","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43888","المديد"],[132,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[147,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[228,"قيثارتي لم ألطخها بأقذار","https://www.aldiwan.net/poem41588.html","البسيط"],[234,"قد أغتدي قبل الصباح المسفر","https://www.aldiwan.net/poem51001.html","الرجز"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[240,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[280,"لا يضع مني لوني عندكم","https://www.aldiwan.net/poem25571.html","الرمل"],[309,"خل عنك الهم يا قلب الحزين","https://www.aldiwan.net/poem16773.html","الرمل"],[333,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[347,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[354,"أيماري من لا رأى طيف سعدى","https://www.aldiwan.net/poem15604.html","الخفيف"],[371,"لا يضيع الله من عمل","https://www.aldiwan.net/poem17251.html","المديد"],[374,"لا يضجرنكم كتبي إذا كثرت","https://www.aldiwan.net/poem4270.html","البسيط"],[416,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[463,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[543,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[543,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[558,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112473","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48811","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48767","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59663","الخفيف"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90703","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101011","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69396","المنسرح"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93684","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87739","المتدارك"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82959","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100894","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200163","الرمل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130042","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133002","المنسرح"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48456","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114087","الخفيف"],[4252,"","https://poetry.dctabudhabi.ae/diwan/poem/147412","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83556","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28719","الرمل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28926","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[5074,"ضيعتي في اللَّيل","https://www.poetsgate.com/ViewPoem.aspx?id=153951",""],[5431,"لايضيعُ العُرْفُ..أنتم أهله","https://www.poetsgate.com/ViewPoem.aspx?id=185842",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5944,"طلع الشعر علينا","https://www.poetsgate.com/ViewPoem.aspx?id=212850",""],[5956,"أنا زارعُ الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=194461",""],[5970,"خذ من الدنيا الذي أعطت ولا","https://www.poetsgate.com/ViewPoem.aspx?id=130593",""],[6115,"لايضيق الصدر ولا يعتريه الفزه","https://www.poetsgate.com/ViewPoem.aspx?id=180523",""],[6280,"لاَمَ في أُمِّ مَالِكٍ عاذِلاكَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27897&r=&rc=52",""]],"verses":[["لا يُضمِرُ السوءَ إِن طالَ الجُلوسُ بِهِ","عَفُّ الضَميرِ وَلَكِن فاسِقُ النَظَرِ",0,"ر",1,0],["لا يَضِع وُدِّيَ الصَريحُ الَّذي أَر","ضاكَ مِنهُ اِستِواءُ سِرّي وَجَهري",1,"ر",2,0],["لا يضق صدر شاعرٍ بأخيه","يكره الفضل أن تضيق الصدور",2,"ر",1,0],["لاّ يَضْربُ الركبُ الطلائحَ نحوَهُ","بل باسمه يُزْجونَ كلَّ طَليحِ",3,"ح",1,0],["لا يضاهيه في المحاسن إلا","ما تسدّيه كفّهُ من فعالِ",4,"ل",1,0],["لا يُضاهيهِ في المحاسن إلا","ما يُسدّيه كفُّه من فعالِ",5,"ل",1,0],["لا يَضِعْ آملٌ لديك ولا يُحْ","رَمْ عطاءً جزيلاً وأنتَ سَميُّهْ",6,"ي",2,0],["لا يَضبُطونَ مَعَ الصُروفِ قَيادَهُم","إِلّا كَما ضَبَطَ المِياهَ المِنخَلُ",7,"ل",1,0],["لا يَضحَكُ السامِعُ مِن هَزلِهِ","كَم عِظَةٍ جاءَ بِها الهازِلُ",8,"ل",1,0],["لا يضرنَّكم قلته","كل مولود وإن جل ضئيل",9,"ل",1,0],["لا يَضِق ذَرعُكَ بِالقَيدِ الَّذي","حَزَّ في سوقِ الأَوالي وَبَراها",10,"ا",3,0],["لا يَضِق ذَرعُكَ عِندَ الأَزَمات","إِن هِيَ اِشتَدَّت وَأَمِّل فَرَجا",11,"ج",2,0],["لا يَضُرُّ القَضيبَ وَهوَ نَضيرٌ","أَن تَزولَ الثَمارُ وَالأَوراقُ",12,"ق",1,0],["لا يَضجَرونَ وَإِن حُرَّت مَغافِرُهُم","وَلا تَرى مِنهُم الطَعنَ مَيّالا",13,"ل",2,0],["لا يَضَعُ اللَأمَةَ عَن جِلدِهِ","وَمِحمَلَ السَيفِ عَنِ المَنكِبِ",14,"ب",1,0],["لا يضجر الحر حين يَسعى","إلا من الذل وَالصغار",15,"ر",1,0],["لا يضر اليقين إن","جحد اللَه جاحد",16,"د",1,1],["لا يَضُرَّنَّكُمو قِلَّتُهُ","كُلُّ مَولودٍ وَإِن جَلَّ ضَئيل",17,"ل",1,0],["لاَ يَضِنُّونَ بِمَجْهُودَاتِهِمْ","وَقَدِيماً لَمْ يَضِنُّوا بِالدِّمَاءْ",18,"ا",2,0],["لاَ يُضَاهِي حِلاَهُ إِلاَّ حِلَى النَّثْ","رِ وَحَدِّثْ عَنْ نَثْرَِعَبْدِ الحَمِيدِ",19,"د",1,0],["لا يُضَاهِي رِوَاؤُهُ فِي جَلِيلٍ","يَنْتَقِيهِ الصَّنَّاعُ أَوْفَى دَقِيقِ",20,"ق",1,0],["لاَ يَضِيقُ صَدْرُ شاعِرٍ بِأَخِيهِ","يَكْرَهُ الْفَضْلُ أَنْ تَضِيقَ الصُّدُورُ",21,"ر",1,0],["لا يَضِقْ مَنْ صدرُهُ حَرجٌ","شَيْخُنَا الشَّعْبِيُّ شارِحُهُ",22,"ح",2,1],["لا يضيقُ المرءُ من كسب يديهِ","لاَ ولا يغنيه دهراً ما لديهِ",23,"ه",1,0],["لا يُضمِرَنَّ سَفيهُكُم بِرِضاكُمُ","غَدراً فَأُمُّ الغادِرينَ ثَكولُ",24,"ل",1,0],["لا يَضبطُ الأَمرَ مَن في عُودِهِ خَوَرٌ","لَيسَ البُغاثُ يُساوي أَجدَلاً قَطِما",25,"م",2,0],["لا يَضمر الحُبُّ إِلّا في مَحاجِرِه","فَعَينه لِلهَوى وَالقَلبُ لِلثارِ",26,"ر",1,0],["لا يضع الناب بغير منخر","فأيّ جأْب عانةٍ لم يَجزُر",27,"ر",1,0],["لا يُضحِ عَن ظِلِّ أَياديكَ مِن","باتَ إِلى ظِلِّكَ ذا فَقرِ",28,"ر",1,0],["لا يُضمِرونَ الوَفاءَ إِن عَهِدوا","عَهداً لا يُنجِزونَ إِن وَعَدوا",29,"د",3,0],["لا يَضَعْ مِنِّي لَوْنِي عِنْدكُم","رُبّ لَيْل فَضَلَ اليَوْمَ وزادا",30,"د",2,1],["لا يَضيقُ صَدري وَإِن ضاقَ الفَضا","وَاِنتَظِر لُطفاً خَفِيّاً يا ظَنين",31,"ن",1,0],["لا يضِركَ السهوم في نظراتي","والأنين المنساب في كلماتي",32,"ت",2,0],["لا يضير الضحايا ان يدرجوا الاك","فان موتى وانهم اشلاء",33,"ا",2,0],["لا يُضاهي الأَعمى البَصيرُ وَلا الظُل","مَةَ نورٌ وَلا الغَوِيَّ الرَشيدُ",34,"د",1,0],["لا يُضيعُ اللَهُ مِن عَمَلِ","وَلَكَ السَرّا فَقُل وَطُلِ",35,"ل",1,1],["لا يضجرنكم كتبي إذا كثرت","فإنَّ شوقيَ أضعافُ الذي فيها",36,"ي",3,1],["لا يَضُرُّ اِمرِأً إِذانا وُدّاً","مِنكَ إِلّا يَنالَهُ مِن سِواكا",37,"ك",2,0],["لا يُضام النزيلُ فيهم بحالٍ","وأبى الله جارَهم أن يُضاما",38,"ا",1,0],["لا يُضحك الأيامَ كذبُ مطامعي","إلا إذا طالبتُها بصديقِ",39,"ق",1,0],["لا يَضيرُ البدرَ كَونُ البدرِ مِن","بينِ أيَّامِه أيامُ المِحَاق",40,"ق",1,0],["لا يَضيرُ الحسناءَ يَخطُبُها فَد","مٌ لها كانت روحُه بَعدُ مَهرا",41,"ر",2,0],["لا يَضحَكُ الدَهرُ إِلّا حينَ تَسأَلُهُ","وَلَيسَ يَعبُسُ إِلّا حينَ لا يُسَلُ",42,"ل",1,0],["لإيضاح حقي في علوم حقائقي","وإنذار شيطان عن الحق مارق",43,"ق",1,0],["لا يضيع الحق تعهده","قضب فالنصلت القضبا",44,"ب",2,0],["لا يضيعُ الرجالُ حقاً كحق","وكلوه لآجِلِ الأحقاب",45,"ب",1,0],["لا يضمن الإنسان حسن مصيره","حتى يكون الحكم للحكماء",46,"ا",2,0],["لا يضرُّ الرياض ميل غُصون","فالتثني مآله لاعتدال",47,"ل",1,0],["لا يضيرُ المصابَ رزءٌ إذا ما","كانَ ذا مَفزَعٍ إلى هرونِ",48,"ن",1,0],["لا يُضيع الكريمُ عهد إخاء","نفحاتُ الوفاء فيه تَضوع",49,"ع",1,0],["لا يَضَعُ الناسُ ما رَفَعتَ وَلا","يَرفَعُ خَلقٌ مَكانَ ما تَضَعُ",50,"ع",1,0],["لاَ يُضمِرُونَ مَعَ اطِّرَاد دُونَ ذِك","رِ المُضمِرِ المَحذُوفِ دُونَ بَيَانِ",51,"ن",1,0],["لا يَضق مِن ملمة صَدرك الر","رَحب وَمَهد لَها قراك الحَمولا",52,"ل",2,0],["لا يَضمِدُ جُرحَكِ إِلّا مَن","بِك أَو بِمعدٍّ قَد أَعرَق",53,"ق",1,0],["لا يضرَّنك إن قا","لَ من الناسِ جهول",54,"ل",1,0],["لا يضيقُ الجوُّ بالناس وَلاَ","يستبدُّ البعضُ بالبعضِ انتقاما",55,"م",2,0],["لا يضر الفضل اقلال كما","في خسوف البدر لا يهدي زحل",56,"ل",1,0],["لا يضير السجن مثلي إن يكن","موطني يصبح في حزرٍ حزير",57,"ر",1,0],["لا يضربونَ بنارِ الحربِ خصمهمُ","لكن برأيٍ سديدٍ يمطرُ اللهَبا",58,"ب",2,0],["لا يضركَ من","سَبَّ أَو شتم",59,"م",1,0],["لا يضع الفقرُ من عُلا هِمَمي","ولا يُعالي من شيمتي المالُ",60,"ل",1,1],["لا يُضْمِرُ الدّهْرُ معْنَى الفتْحِ عنْكَ وقدْ","توضّحَ الآن طوْعَ النّصْرِ مُبْهَمُهُ",61,"م",2,0],["لاَ يَضُرُّ الجُسُومَ نَأيٌ وَبُعدٌ","حَيثُ كَانَت قُلُوبُنَا فِي اقتِرَابِ",62,"ب",1,0],["لا يضجرون وإن حزت مغافرهم","ولا نرى منهم في الطعن ميالا",63,"ل",2,0],["لا يُضامُ المُحبُّ في بابِ طه","أَنصَف الدَهر في القَضا أَم جارا",64,"ر",2,0],["لا يضق عَفوك ما بي جَلَد","وَاِغفِري ذَنبي وَإِن كانَ كبَر",65,"ر",1,0],["لا يضمرُ الفحشاءَ تحت ردائه","حُلو شمائلُهُ عفيف المئزر",66,"ر",1,0],["لا يضاهيهم الوجود بمجدٍ","لا مضاهٍ له ولا أكفاء",67,"ا",2,0],["لا يضاهي فرهادَ خُسَروُ فيما","شاد فرهاد للرشاد منارا",68,"ر",2,0],["لا يُضَاهِيْ جَمَالَ تِلْكَ المَغَانِيْ","قَصْرُ كِسْرَى وَ لا المَقَامُ المُنِيْفُ",69,"ف",1,0],["لايضيعُ العُرْفُ..أنتم أهله","معدن النفسِ يُضاهي الذهبا",70,"ب",2,1],["لا يَضْمَحِلُّ وقد فاضَتْ منابِعُهُ","نضّاخَةَ الحُسْنِ لا تنضو ولا تَضْحى",71,"ح",2,0],["لا يَضُرَّنْكَ كيدُهُمْ حيثُ كادوا","أتَحُزُّ الرياحُ في الراسياتِ ؟؟",72,"ت",1,0],["لا يضمُّ النومُ جفني دون حكٍّ","دون أن أنجز بالصحو انبعاثا..",73,"ث",2,0],["لا يضيق العيش يوماً إنما","نحن أصغرنا الليالي منزلا",74,"ل",2,0],["لايضيق الصدر ولا يعتريه الفزه","لو تشوف الناس ذا شامت وهذا هازي",75,"ز",2,1],["لا يضر امرأ إذا نال وداً","منك إلأأن يناله من سواكا",76,"ك",2,0]]}