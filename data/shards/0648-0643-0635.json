{"poems":[[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[309,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"]],"verses":[["وكصاحبٍ لي غيبه دِغلٌ","أنا منه في قَرص وفي نخس",0,"س",1,0],["وكصاحب الغرب المينر شعيبه","ولسهر وردي العوارف فاتبع",1,"ع",1,0],["وكصاحب الشعب المهيب أحمد","من بالجلالة صار كالمتدرع",1,"ع",1,0],["وكصاحب الشجر ابن ناصر أحمد","من يالعناية والرعاية قد رعى",1,"ع",2,0],["وكصبٍّ في حشاه لاعج","يزعج النوم إذا ما هجعا",2,"ع",2,0]]}