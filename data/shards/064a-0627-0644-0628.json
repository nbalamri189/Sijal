{"poems":[[36,"بت والهم يا لبينى ضجيعي","https://www.aldiwan.net/poem4911.html","الخفيف"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[18,"هل عرفت الغداة من أطلال","https://www.aldiwan.net/poem23933.html","الخفيف"],[18,"يا لبكر أنشروا لي كليباً","https://www.aldiwan.net/poem23952.html","المديد"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21002","الرمل"],[226,"مولاي قد نامت عيون","https://www.aldiwan.net/poem55273.html","مجزوء الكامل"],[236,"زار وهنا ونحن بالزوراء","https://www.aldiwan.net/poem44600.html","الخفيف"],[302,"أشرقت في غلالة زرقاء","https://www.aldiwan.net/poem33340.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[469,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[484,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[505,"يا رجال الغيب أين الهمم","https://www.aldiwan.net/poem37787.html","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111807","الرمل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126635","السريع"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201951","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114207","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83510","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28687","الرمل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147296","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72502","الخفيف"],[5055,"الشاجن","https://www.poetsgate.com/ViewPoem.aspx?id=108497",""],[5055,"يا البندري","https://www.poetsgate.com/ViewPoem.aspx?id=110088",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5288,"البعيده .. القريبه","https://www.poetsgate.com/ViewPoem.aspx?id=1153",""],[5389,"اشتياق الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=215191",""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5725,"لم يجرْني","https://www.poetsgate.com/ViewPoem.aspx?id=216019",""],[5939,"زار كالسحر ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=195323",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["يا لُبَينى فَدَتكِ نَفسي وَأَهلي","هَل لِدَهرٍ مَضى لَنا مِن رِجوعِ",0,"ع",1,0],["يا لبكة العجين","يا بلة في الطين",1,"ن",1,0],["يا لَبَكرٍ فَأَوعِدوا ما أَرَدتُّم","وَاِستَطَعتُم فَما لِذا مِن زَوالِ",2,"ل",1,0],["يا لِبَكرٍ أَنشِروا لي كُلَيباً","يا لِبَكرٍ أَينَ أَينَ الفِرارُ",3,"ر",1,1],["يا لِبَكرٍ فَاَظعُنوا أَو فَحِلّوا","صَرَّحَ الشَرُّ وَبانَ السَرارُ",3,"ر",1,0],["يا لُبَينَى أَوقِدي النَّارا","إنَّ مَن تَهوَينَ قَد حارا",4,"ر",2,1],["يا لبيت من جهلوا","الحقيقة بالحقيقة يحلمون",5,"ن",1,0],["يا لباب المعنى ونور المعاني","يا شفاء الصدور من كل داء",6,"ا",2,0],["يا لبيضاءَ زانَت الوجنة الحم","راءَ منها بالشامة الخَضراءِ",7,"ا",2,0],["يا لباب الحياة يا فنّ ما أسعد","ني إن أضعت فيك اللبابا",8,"ب",2,0],["يا لَبعيدٍ من مِنىً دَنَا به","يوهمني الصدقَ بُرَيْقٌ كَذَبا",9,"ب",2,0],["يا لبن النَّدى لولا سماحك لم يكن","لا شوبهُ يخشى ولا أكداره",10,"ر",2,0],["يا لباب البحر فينا من كناس","تتجلى منه غزلان النقى",11,"ق",2,0],["يالَ بيتِ المُصْطَفى من هاشِمٍ","عنه أَنتمْ في البَرايا قُوَّمُ",12,"م",1,0],["يا لبيت أمي لم تلدني أبدا","وليت جسمي للوجود ما بدا",13,"د",2,0],["يا لبيني إذا هممت بهجري","خبّريني أرغبةٌ أم دلالا",14,"ل",2,0],["يا لبدرٍ صابهُ نقصُ الخسوف","ولشمسٍ قد أُصيبت بالكسوف",15,"ف",1,0],["يا لبنى الإسلام ما بالكم","نمتم عن الجلى ومن نام طاح",16,"ح",1,0],["يا لبشرى لمصر حققها الله","لقومي وهو السميع المجيب",17,"ب",1,0],["يا لبردٍ الى المهالك يُزجي","لم تَعقْه الثياب من أيّ فج",18,"ج",1,1],["يَا لَبِيبًا آرَاؤُهُ مأثُورَه","وَلآلِي جَوَابِهِ مَنثُورَه",19,"ر",2,1],["يا لبُشرى في رَبيع أقبَلَت","وَرَبيعُ الخَيرِ يُرجى لِلقِيام",20,"م",1,0],["يا لبشرى بُشّرتها في مَنامي","حَيثُ وافى بِها الرَسول البَشيرُ",21,"ر",1,0],["يا لِبان اللَّه فِيَّ اللَّه بي","حَرَجاً مِن قَطعِ حَبلي حَرجا",22,"ج",2,1],["يا لبغض وقد غشانا دهورا","يا لكره وقد سقانا الوبيلا",23,"ل",2,0],["يا لبحر منه فقدانا عبابا","زاخرا بالندى وغيثا عميما",24,"م",2,0],["يا لبندري ما همني ومضات جمرة","ولا همت فالوجنات يا طيب فالي",25,"ل",2,1],["يا لبندري لو شفت مأسور وكرة","ما قلتها ( ذ ) اليوم هيل ودلالي",25,"ل",2,0],["يا لبندري دوبك على كف جمرة","لو دستها مثلي بكيت الخوالي",25,"ل",2,0],["يالبندري ما عاد بالعمر مَرة","أترك غصون الشير واملا السلالي",26,"ل",2,0],["يا لبني أبي سلاماً زاكيا","منا على تلك الخطا ومن خطا",27,"ا",1,0],["يا لبُؤس العراق ما مرّ عهدٌ","لم تقعْ في دياره الأهوالُ !",28,"ل",1,0],["يالبعيدة القريبة ... استبيحي الوريد","الموانيء وعيوني واليالي فداك",29,"ك",1,0],["يالبياضك عنهم يزيح اللثام","مراية وبنورك صورهم تنعكس",30,"س",1,0],["يا لبِكْرِ تَلَذُّ مِنْهَا وَتَقْضِي","مَعَهَا مَا تَشَاءُ وِهْيَ البَتُولُ",31,"ل",1,0],["يا لبحريك منهما موج شوقي","حيث دكّا من المآقيَ سدّا",32,"د",2,0],["يا لَبَرقٍ أصابني","أخبروني بما جرَى",33,"ر",2,0],["يَا لَبَدْرٍ ! وَيَا لَمَعْرَكَةٍ تَمْ","ضي مضيَّ الدُّهُورِ والأزْمَانِ",34,"ن",1,0]]}