83318",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6259,"وليَّ ولم يقض من أحبابه وطرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59376&r=&rc=24",""],[6300,"دين الصبابة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82844&r=&rc=15",""]],"verses":[["تُعَدُّ النوقُ مِن شَرَفٍ فُحولاً","إِذا اِنتَسَبَت إِلى العَودِ الجُلالِ",0,"ل",1,0],["تُعَدِّدُ نَبراتِ الأُسودِ نَباهَةً","وَتَنسى أَنابيحَ الكِلابِ النَوابِحِ",1,"ح",1,0],["تَعُدُّ الأَعادي لي مَرامي قِذافِها","وَتَنبَحُني أَنّى مَرَرتُ كِلابُها",2,"ب",3,0],["تَعَدَّدَتِ الأَلْفَاظُ وَاتَّحَدَ الْمَعْنَى","وأَصْبَحَ فَرْداً مَا مَرَرْتُ بِهِ مَثْنَى",3,"ن",2,1],["تَعُدّونَني كَالعَنبَرِ الوَردِ إِنَّما","تَطيبُ لَكُم أَنفاسُهُ حينَ يُحرَقُ",4,"ق",1,0],["تَعدو بِخيطَفٍ مَأطورَةٍ","ويدٍ لَها نَسَجَت بِضَبعٍ مائِرِ",5,"ر",1,0],["تُعِدُّ فِتْيَانَاً يُبَاهَى بِهِمْ","في الحَقِّ وَالآدَابِ وَالطِّبِّ",6,"ب",1,0],["تعدو البهارج كل زورٍ تحتها","وتمر بالزينات مر الساخر",7,"ر",1,0],["تُعِدُّ سَرابيلَ الحَديدِ مَعَ القَنا","وَشُعثَ النَواصي كَالضِراءِ الطَوارِدِ",8,"د",1,0],["تُعَدُّ لِقَيسٍ مِن قَديمِ فِعالِهِم","بُيوتٌ أَواسيها طِوالٌ وَسورُها",9,"ر",3,0],["تَعُدّونَ عَقرَ النيبِ أَفضَلَ سَعيِكُم","بَني ضَوطَرى هَلّا الكَمِيَّ المُقَنَّعا",10,"ع",2,0],["تَعدو إِذا قَلِقَت عَلى مُتَنَصِّبٍ","كَالسَحلِ في عادِيَّةٍ دَيمومِ",11,"م",1,0],["تَعَدَّ وأسرف في مديح ابن طاهرٍ","فلست على الإِسراف فيه مُوَبَّخَا",12,"خ",2,0],["تُعدي إذا ما بدت صواحبَها","كأنها عُرة من العُرر",13,"ر",1,0],["تُعدُّ منه لحربها قلماً","يُفرِجُ للرمح في مضايقها",14,"ق",3,0],["تَعِدُ المنى عنك الغنى فتفي به","وتقيمُ جودَك بالوفاء كفيلا",15,"ل",2,0],["تَعدو بِهِ خَوصاءُ يَفصِمُ جَريُها","حَلَقَ الرِحالَةِ فَهِيَ رِخوٌ تَمزَعُ",16,"ع",1,0],["تَعدو بِهِم جُردٌ أُمِرَّ مَريرُها","كَالطَيرِ يَومَ الرَوعِ حينَ تَجولُ",17,"ل",1,0],["تُعَدُّ لِأَيّامِ الحِفاظِ كَأَنَها","قَناً لَم يُقَوِّم دَرأَها مُستَحيلُها",18,"ل",3,0],["تَعدو وَتَجذُبُها رَوادِفُها إِلّى","خَلفٍ فَتُجهَدُ خَصرَها المَتبولا",19,"ل",2,0],["تعد الشمس ان تعيد لنا","المجد وتبلي وعودها بالمطال",20,"ل",1,0],["تُعَدُّ في تاريخِها","أَليَقَ ديوانٍ ظَهَر",21,"ر",1,0],["تُعِدُّ لِحادِثِ الأَيّامِ صَبراً","وَآوِنَةً تُعِدُّ لَهُ عِنادا",22,"د",2,0],["تُعَدُّ بِها عَلى الأُمَمِ اللَيالي","وَما تَدري السِنينَ وَلا الحِسابا",23,"ب",2,0],["تَعَدَّ القُرى وَالمُس بِنا الجَيشَ لَمسَةً","نُبارِ إِلى ما تَشتَهي يَدُكَ اليُمنى",24,"ن",2,0],["تعدو عليكَ رجالٌ لو هممتَ بهِمْ","صاروا فرائسَ بين النابِ والظُّفُرِ",25,"ر",1,0],["تَعُدُّ بِهِ بَنو العَبّاسِ ذُخراً","لِيَومِ الرَأيِ أَو يَومِ الجِلادِ",26,"د",1,0],["تَعُدُّ أَفعالَكَ الحَصينَةَ إِن","قَبيلَةٌ عَدَّدَت مَعاقِلَها",27,"ل",3,0],["تُعدي القُلوبَ بِعَينَيها إِذا نَظَرَت","حَتّى تُجِدَّ لَها خَبلاً مِنَ السَقَمِ",28,"م",1,0],["تُعِدُّ المَوالي لَهُ نَصرَها","وَتولي المُعادينَ خِذلانَها",29,"ن",3,0],["تَعُدُّ لَهُ فارِسٌ قُربَةً","وَزُلفى بِكِسرى اِبنِ ساسانِها",30,"ن",3,0],["تُعَدُّ بُيوتٌ في قَبائِلِ أَهلِها","وَبَيتاكُمُ مِن كُلِّ بَيتَينِ أَعظَمُ",31,"م",1,0],["تُعَدُّ عِظامي واحِداً بَعدَ واحِدٍ","بِمَنحى مِنَ العُذّالِ عَظماً عَلى عَظمِ",32,"م",1,0],["تُعَدُّ المُضارِعاتُ","مَفاعيلُ فاعِلاتُ",33,"ت",1,0],["تُعَدَّدُ أَفعالي وَتِلكَ مَناقِبٌ","فَتَذكُرُني بِالمَدحِ في مَعرِضِ الذَمِّ",34,"م",1,0],["تعدو سرَاحينُ الوَغَى حَوْلَهُ","مُجَلِّحاتٍ بأسودِ الأجَم",35,"م",1,0],["تُعد لكل واحدةٍ طبولٌ","وحراسٌ وترتفعُ البنود",36,"د",1,0],["تَعُدّينَ ذَنباً أَنتِ لَيلى جَنَيتِهِ","عَلَيَّ وَلا أُحصي ذُنوبَكُمُ عَدا",37,"د",2,0],["تُعدي عُلاهُ دِيارَهُ فَلَها بِهِ","في مُرتَقى زُحَلٍ جَمالُ المُشتَري",38,"ر",2,0],["تَعدو الذِئابُ عَلى مُمَنَّعِ غيلِهِ","وَالأُسدُ غَضبى وَالسُيوفُ عَوانِ",39,"ن",1,0],["تَعدو الخُطوبُ فَنَشكوها وَما ظَلَمَت","فيما لَقينا وَلا جارَت عَواديها",40,"ي",3,0],["تَعَدّى بِزَيزاتٍ تَعِجُّ مِنَ القوا","وَمَن يَكُ يَبغي طُرقَةَ اللَيلِ يُرمِلِ",41,"ل",1,0],["تُعَدِّدُ نَفسي مِن سُلَيمى عِدادَها","فَلَم تَرقَ عَيني وَاستطيرَ رُقادُها",42,"د",3,1],["تعُدّينَ ذَنباً أَنتِ قَبلي جَنَيتِهِ","عَلَيَّ وَلا أُحصِي ذُنُوبَكُمُ عَدّا",43,"د",2,0],["تَعُدّونَها في مَساعيكُمُ","كَعَدِّ الأَهِلَّةِ مُعتَدَّه",44,"د",2,0],["تَعُدُّ الشَيخَ وَالقَيصو","مَ وَالفُقَهاءَ وَالسُمُرا",45,"ر",2,0],["تَعُدُّ قَليلاً ما لَقيتُ مِنَ الهَوى","وَحَسبي بِما لاقيتُ مِن حُبِّها حَسبي",46,"ب",2,0],["تَعدو الذِئابُ عَلى مَن لا كِلابَ لَهُ","وَتَتَّقي مَربَضَ المُستَنفِرِ الحامي",47,"ي",1,1],["تعدّ المشرفيّة والعوالي","وتقتلنا المنون بلا قتال",48,"ل",1,1],["تعُدّ سَرابَ القَيْظِ والصّيْفِ والضّحى","وجُنْحَ الدّجى لو أنّه كان جاريا",49,"ي",2,0],["تَعْدو بها الشَّقَّاءُ جَنّبَها الصّدى","يوْمَ الهَجيرِ يَقِينُها المَشْكُوك",50,"ك",1,0],["تُعَدّ ذُنوبي عندَ قَوْمٍ كثيرَةً","ولا ذَنْبَ لي إلاّ العُلى والفواضِل",51,"ل",1,0],["تَعَدَّدَ مَا تَهْوَى العُلَى فِي خِصَالِهِ","فَمِنْ حَيْثُ تَبْغِي وَصْفَهُ فَهْوَ فَارِدُ",52,"د",1,0],["تَعُدُّ عَلَى النِّيلِ قَطْرَ المِيَا","هِ وَتَرْمُقُهُ بِعُيُونِ الْحَسَدْ",53,"د",1,0],["تعدو الحضارة وهي داءٌ فاتكٌ","وتسيرُ في خَطْو الكسيح طبيبا",54,"ب",2,0],["تَعْدادُ مجد المرء منقصة إذا","فاقت مزاياه عن التَّعْداد",55,"د",1,0],["تُعدَى القُلوبُ بعَيْنَيْها إذا نَظَرتْ،","حتى تُجِدّ لهَا حَبْلاً مِنَ السّقَمِ",56,"م",1,0],["تعدو وتجذبها روادفها إلى","خلف فتجهد خضرها المتبولا",57,"ل",2,0],["تعدّ ليالي هجره وسجيّة","بكلّ مشوق أن يعدّ ويحسبا",58,"ب",2,0],["تعدو النَّجاءَ بخيطفٍ مأطورة","ٍ ويدٍ لها نَسَجَتْ بِضَبْعٍ مَائرِ",59,"ر",1,0],["تَعَدَّى وأسرف في مديح ابن طاهر","فلستَ على الإسراف فيه مُوَبَّخَا",60,"خ",2,0],["تعدى الحدود امرؤٌ فاجر","وامثاله يكفرون الجميل",61,"ل",1,1],["تعدى حدود الله في سب خير","كريم وجازاه عن الخير بالشر",62,"ر",1,0],["تعدوا حدود الله فاسود رأيهم","ورد لهم من غارة الوهم خائبا",63,"ب",2,0],["تَعَدّى كُلَّ مَن يُرجى نَداهُ","وَمَيَّلَهُ الفُراتُ عَنِ الثَمائِل",64,"ل",1,0],["تَعَدّى رَبُّها سَفَهاً وَحَيناً","وَكُنتَ بِأَخذِها سَلَباً قَمينا",65,"ن",2,0],["تعدو مكارمهُ على آمالنَا","بدوى يصيبُ به مكان الداءِ",66,"ا",2,0],["تعدوا حدوداً لا تدانا وأقدموا","على فعلة ما قد سمعنا لها مثلا",67,"ل",2,0],["تعد أَباً أَباً نَسقاً ملوكا","كما عدّدتَ في الرمحِ الكعوبا",68,"ب",2,0],["تعدُّ ولا تحصى ملوك توارثت","إِذا عُدَّ آباءٌ له وجدودُ",69,"د",1,0],["تعدا عليه مستجيرا بمكة","وما جارها في دين ملك الورى حل",70,"ل",1,0],["تعدى طوره المسكين جهلا","وأبدي وجه مرفوع وقاح",71,"ح",1,0],["تعدوا عليه والحصون بكفه","وحاصرها من ليس يحرى ولا يمرى",72,"ر",2,0],["تَعدُ العَوادِى مُحِباً عَن إِبَانَتِهِ","وَتَبلُغِ الحَربُ قَومَينا فَيَحتَرِبَا",73,"ب",2,0],["تَعِدُ الملاح وأهونُ الأ","شياءِ ان تعدَ الوعودا",74,"د",2,1],["تعددت فيك امداحي فلي عدة","من راحتيك وللاعداء تعديد",75,"د",1,0],["تعد في الموتى اذا سقتها","كأنها تمشي على الجمر",76,"ر",1,0],["تُعَدُّ في الشِعرِ وَهِيَ مُنقَصَةٌ","لَو أُنصِفَت قيلَ إِنَّها حِكَمُ",77,"م",1,0],["تَعُدُّ الغَدرَ دَأباً في الوَضيِّ ال","ميلِ فَكيفَ في الجَهمِ القَبيحِ",78,"ح",1,0],["تَعدُّ الشّربَ عَيباً غيرَ أني","عرفتُ بهِ الأسودَ من القرود",79,"د",1,0],["تعداد موجود الوجود بأسره","يا لِلَّه يا متلذذين بذكره",80,"ه",1,0],["تُعَدُّ عُلاهُ مِنْ مَناقِبِ دَهْرِه","كَعَدِّكَ فَضْلَ اللَّيْلِ بِالقَمَرِ التِّمِّ",81,"م",1,0],["تَعَدّى إِلَيها مِن نُحولي زِمامَها","بِإِدمانِيَ السَيرَ الحَثيثَ نُحولُ",82,"ل",1,0],["تَعدو بِنا شَطرَ جَمعٍ وَهيَ موفِدَةٌ","قَد قارَبَ العَقدُ مِن إيفادِها الحَقَبا",83,"ب",2,0],["تَعَدَّت تَغلِبٌ ظُلماً عَلَينا","بِلا جُرمٍ يُعَدُّ وَلا جُناحِ",84,"ح",1,0],["تَعدّدت فَهيَ لا تُحصى مَناقبهُ","وَهَل تظنّ بِأَنّ النجم مَعدودُ",85,"د",1,0],["تعدَّوا حدود الله لا شك أنَّ من","تعدَّى حدود الله مَعقَبُهُ خُسرا",86,"ر",2,0],["تُعَدُّ إعجازَ دينٍ قد دُعيتَ له","عزّاً فأوسَعْتَ إعزازاً لأَهْليه",87,"ي",2,0],["تَعْدُو إذا حُرِّكَ مِجْدافُها","عَدْوَ رَباعٍ مُفْرَدٍ كالزُّلَمْ",88,"م",1,0],["تعدي السُيوف بِيُمناهُ صَرامته","فَلو أَشارَ بِنابي الشَفرَتين برا",89,"ر",2,0],["تَعدو رِماحك خالِقاتٍ في العِدى","حَدقاً وَفي أَجفانِها أَشفارُ",90,"ر",1,0],["تُعَدُّ كرامُ النَّاس في بلديهما","فعدَّا ولم تعقد وراءهما يد",91,"د",1,0],["تعدّك للخطب الملوك ذخيرة","وإن الرجال الشوس من أنفس الذخر",92,"ر",1,0],["تعدو إذا ما أرسلت","كالسهم من فوق الكثيبِ",93,"ب",1,0],["تعدو كالسهم على الحجلا","ت فتمنعهنّ من الهرب",94,"ب",1,0],["تعدوا كل قانون","وعاصوا كل م