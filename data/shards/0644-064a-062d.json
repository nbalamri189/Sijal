{"poems":[[77,"لي حبيب لست أعصي أمره","https://www.aldiwan.net/poem36407.html","الرمل"],[86,"ما لهذا النجم في السحر","https://www.aldiwan.net/poem10504.html","المديد"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[93,"طوقتموني بأطواق من المنن","https://www.aldiwan.net/poem9166.html","البسيط"],[93,"مولاي جاري في الندى طبعه","https://www.aldiwan.net/poem9829.html","السريع"],[93,"يد لله لا توفى بحمد","https://www.aldiwan.net/poem11091.html","الوافر"],[54,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[64,"يا نسيم الريح قولي للرشا","https://www.aldiwan.net/poem67632.html","البسيط"],[64,"لي حبيب أزور في الخلوات","https://www.aldiwan.net/poem67660.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[70,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[70,"لكم الروح والبدن","https://www.aldiwan.net/poem42443.html","مجزوء الخفيف"],[70,"سمع الناس وقلنا","https://www.aldiwan.net/poem42679.html","مجزوء الرمل"],[70,"كل شيء منك مقبول","https://www.aldiwan.net/poem42760.html","المديد"],[70,"لي حبيب لايسمى","https://www.aldiwan.net/poem42910.html","مجزوء الرمل"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[45,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"حييتما من مربع ومصيف","https://www.aldiwan.net/poem65158.html","الطويل"],[45,"اسلم أبو العباس وابق","https://www.aldiwan.net/poem65220.html","مجزوء الكامل"],[66,"ليحيى فم لو علق المسك فوقه","https://www.aldiwan.net/poem38600.html","الطويل"],[66,"لي حبيب يلذ فيه","https://www.aldiwan.net/poem39919.html","مجزوء الخفيف"],[44,"لي حبيب عصيت فيه النصيحا","https://www.aldiwan.net/poem30271.html","الخفيف"],[44,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"لي حبيب يكدني بمطاله","https://www.aldiwan.net/poem26753.html","الخفيف"],[52,"قف خليلي نسأل لشرة دارا","https://www.aldiwan.net/poem27045.html","الخفيف"],[48,"ما لي في الناس كلهم مثل","https://www.aldiwan.net/poem65004.html","المنسرح"],[50,"لي حيلة في من ينمم","https://www.aldiwan.net/poem62256.html","مجزوء الكامل"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85421","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54743","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54699","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55044","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[50,"لي حيلة ٌ في من ينمُّ","https://www.poetsgate.com/ViewPoem.aspx?id=31002",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[45,"لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا","https://www.poetsgate.com/ViewPoem.aspx?id=31601",""],[85,"رَوّعوه ؛ فتولَّى مغضِبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9536&r=&rc=26",""]],"verses":[["لي حَبيبٌ لسْتُ أعصي أمْرَهْ","لمْ أُطِقْ بعْدَ وِصالٍ هجْرَهْ",0,"ه",1,1],["لي حَبيبٌ هاجِرٌ وَلَهُ","صورَةٌ مِن أَبدَعِ الصُوَرِ",1,"ر",1,0],["لَيَحظى وَلِيٌّ سِرُّهُ وَفقُ جَهرِهِ","فَظاهِرُهُ شُكرٌ وَباطِنُهُ وُدُّ",2,"د",1,0],["ليحفظ اللَه فاروقاً لأمته","وللعروبة ولينصره وليصن",3,"ن",1,0],["ليحيى فاروق ومن مثله","يضاعف الإحسان باللطف",4,"ف",1,0],["لِيَحْيَيَ مُحَقِّقاً أَملَ المعَالِي","بِهِمَّتِهِ عَلي أَمِين يَحْيَا",5,"ي",2,0],["لِيَحوزَ جائِزَةَ اللَعينِ","لَعَنَ المُهَيمِنُ ما بِهِ يَتَضَهَّدُ",6,"د",1,0],["لي حين أنسب أسرةٌ عربيةٌ","كادتْ تعدّ الشهب من أحلافي",7,"ف",2,0],["لي حَبيبٌ حُبُّهُ وَسطَ الحَشا","إِن يَشَأ يَمشي عَلى خَدّي مَشى",8,"ش",2,0],["لي حَبيبٌ أَزورُ في الخَلَواتِ","حاضِرٌ غائِبٌ عَنِ اللَحَظاتِ",9,"ت",1,1],["لي حقوقٌ عليه أصبح يلْوي","ها فَطالِبْهُ لي بوشْك الأداءِ",10,"ا",2,0],["لِيَحْلُلْ ذَرَاه من تَلَدَّدَ حائراً","فما في ذَرَاهُ حائرٌ يَتَلدَّدُ",11,"د",1,0],["لِيَ حيْث انصرَفتُ عنها رفيقٌ","من هواها وحيث حَلَّتْ قَعِيدُ",12,"د",1,0],["لِيُحِسَّ نورَ الشَمسِ في ذَرّاتِهِ","وَيُقابِلُ النَسَماتِ غَيرَ مَقَّنَّعِ",13,"ع",1,0],["لي حَبيبٌ فَإِن أَكُن","لا أُسَمّيهِ فَاِفطُنِ",14,"ن",1,0],["لي حَبيبٌ عَبَدتُهُ","وَيحَ مَن يَعبُدُ الوَثَن",15,"ن",1,0],["لي حَبيبٌ لِيَ مِنهُ","كُلُّ شَيءٍ أَتَمَنّى",16,"ن",2,0],["لي حَبيبٌ لا أَبوحُ بِهِ","أَنا مِنهُ اليَومَ مَقتولُ",17,"ل",1,0],["لي حَبيبٌ لايُسَمّى","وَحَديثٌ لايُفَسَّر",18,"ر",1,1],["لي حبيب كلما قيل له","صدَّق القول وزكّى الريبا",19,"ب",2,0],["لي حَبيبٌ قَد لَجَّ في الهَجرِ جِدّا","وَأَعادَ الصُدودَ مِنهُ وَأَبدى",20,"د",2,1],["لي حُرمَةٌ مُذ أَربَعونَ أَعَدُّها","حِجَجاً وَلَستُ عَنِ القَديمِ بِناسِ",21,"س",1,0],["لي حاجَةٌ شَرُفَت وَلَيسَ بِبالِغٍ","فيها الَّذي أَمَّلتُ غَيرُ شَريفِ",22,"ف",1,0],["لي حاجَةٌ أَرجو لَها","إِحسانَكَ الأَوفى وَفَضلَك",23,"ك",1,0],["لِيَحيى فَمٌ لَو عُلِّقَ المِسكُ فَوقَهُ","لَأَصلَحَهُ وَالضِدُّ يُصلِحُهُ الضِدُّ",24,"د",1,1],["لي حَبيبٌ يَلَذُّ في","هِ عَذابي وَيَعذُبُ",25,"ب",1,1],["لي حَبيبٌ عَصَيتُ فيهِ النَصيحا","لَيسَ سَمحاً وَلا بَخيلاً شَحيحا",26,"ح",2,1],["لي حُرمَةٌ بِكَ أَمسى حَقُّ نازِلِها","وَقفاً عَلَيكَ فَدَتكَ النَفسُ مَحبوسا",27,"س",2,0],["لي حُرمَةٌ بِكَ لَولا ما رَعَيتَ وَما","أَوجَبتَ مِن حِفظِها ما خِلتُها تَجِبُ",28,"ب",1,0],["لي حاجَةٌ لا بُدَّ مِن قَضائِها","فَتَستَريحُ النَفسُ مِن عَنائِها",29,"ه",2,0],["لي حَبيبٌ يَكُدُّني بِمِطالِهِ","غَشَّ ديني بِحُسنِهِ وَجَمالِهِ",30,"ل",2,1],["لي حَبيبٌ مُكَذِّبٌ بِالأَماني","جَعَلَ الدَهرَ مَوعِداً وَاِنتِظارا",31,"ر",2,0],["لِيَحمَدِ اللَهَ مُنكُمُ رَجُلٌ","ساعَدَهُ في حَبيبِهِ الأَمَلُ",32,"ل",1,0],["لي حِيلَةٌ في مَن يَنُم","مُ وَلَيسَ في الكذّابِ حيلَه",33,"ه",1,1],["لي حبيب أراكَ فيه مُعَنّىً","غُرّ غَيري وفيه مَعنىً أراكا",34,"ك",2,0],["لي حين يبدي اللَيل زهر نجومه","نظر إِلى الشعرى العبور سَحيق",35,"ق",1,0],["لي حُرمَةٌ والَت عَلَيَّ سِجالَكُم","وَالماءُ رِزقُ جِمامِهِ لِلأَوَّلِ",36,"ل",1,0],["لِيَحْيَا فَارُوقُ وَالإِقْبَالُ مُتَّصِلٌ","وَشَعْبُ مِصْرَ عَزِيزٌ نَاعِمُ البَالِ",37,"ل",1,0],["لِيَحْيَا فَارُوقنا وَيَبْلَغْ","مِنَ المَعَالِي أَسْمَى الْمُرَادِ",38,"د",1,0],["لِيَحْيَى إِلْيَاسٌ وَلِيَحيَى","آلُهُ فِي سُعُودِ",39,"د",1,0],["لِيَحْيَا فَارُوقُ وَمَنْ مِثْلُهُ","يُضَاعِفُ الإِحْسَانَ بِاللُّطْفِ",40,"ف",1,0],["ليحول دون فتى الهوى وفتاته","إن الهوى ضرب من الطيران",41,"ن",1,0],["لي حيلة ٌ في من ينمُّ","وليسَ في الكذّاب حِيله",42,"ه",1,1],["لي حقُّ تمحيص الأمورِ كواحدٍ","من سائر الشعراء والكُتاب",43,"ب",1,0],["ليُحِلَّني من بَعد مَسغَبةٍ","في ذي زُروع مُعشِبِ خَصِب",44,"ب",1,0],["لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا،","وأعَادَ الصّدودَ مِنْهُ وأبْدَا",45,"د",2,1],["لي حبيبٌ كلَّما قيل له","صَدَّقَ القولَ ، وزكذَى الرِّيبا",46,"ب",2,0]]}