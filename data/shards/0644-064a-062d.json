139640",""],[5431,"موغلٌ في حنينه لم يخُنّا...","https://www.poetsgate.com/ViewPoem.aspx?id=197423",""],[5535,"لي حبيب منه أرى وجه بدرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201507",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5720,"لي حبيبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201586",""],[5725,"وحين التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=206233",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""],[5725,"أملأ القلب مفرحات ونبلا","https://www.poetsgate.com/ViewPoem.aspx?id=213017",""],[5732,"ليحان صدري","https://www.poetsgate.com/ViewPoem.aspx?id=177912",""],[5739,"الشريط ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127064",""],[402,"يد لله لا توفى بحمد","https://www.poetsgate.com/ViewPoem.aspx?id=36815",""],[5792,"لي حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=180336",""],[5829,"كل ود","https://www.poetsgate.com/ViewPoem.aspx?id=211081",""],[5853,"(( لي حبيبٌ))","https://www.poetsgate.com/ViewPoem.aspx?id=175657",""],[5865,"لا الشامُ جذْلى ولا في يومِها الرَّقَّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=179833",""],[5886,"لي حبيب لِأَن عطفا","https://www.poetsgate.com/ViewPoem.aspx?id=188593",""],[5912,"مجاراة لقصيدة لي حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=203791",""],[5943,"كَشَفَتْ غطاها","https://www.poetsgate.com/ViewPoem.aspx?id=34277",""],[5953,"يا محضر الغيد بالصمان بالغار","https://www.poetsgate.com/ViewPoem.aspx?id=93853",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"قممُ الوعي","https://www.poetsgate.com/ViewPoem.aspx?id=185610",""],[5956,"ليتهم عانوا كما نلنا عناءا","https://www.poetsgate.com/ViewPoem.aspx?id=194196",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[5989,"ما كنتُ بدعاً من العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=183969",""],[6001,"بنت العز","https://www.poetsgate.com/ViewPoem.aspx?id=376",""],[6070,"مِنْ فَرحةِ المَاءِ سارَ الغَيمُ وانتَشَرا","https://www.poetsgate.com/ViewPoem.aspx?id=192068",""],[6115,"يادار علمني وقل وين راعيك","https://www.poetsgate.com/ViewPoem.aspx?id=180499",""],[6120,"أَيَحسَبُ أَنَّنِي كَلِفٌ عَلَيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=213525",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["لي حَبيبٌ لسْتُ أعصي أمْرَهْ","لمْ أُطِقْ بعْدَ وِصالٍ هجْرَهْ",0,"ه",1,1],["لي حَبيبٌ هاجِرٌ وَلَهُ","صورَةٌ مِن أَبدَعِ الصُوَرِ",1,"ر",1,0],["لَيَحظى وَلِيٌّ سِرُّهُ وَفقُ جَهرِهِ","فَظاهِرُهُ شُكرٌ وَباطِنُهُ وُدُّ",2,"د",1,0],["ليحفظ اللَه فاروقاً لأمته","وللعروبة ولينصره وليصن",3,"ن",1,0],["ليحيى فاروق ومن مثله","يضاعف الإحسان باللطف",4,"ف",1,0],["لِيَحْيَيَ مُحَقِّقاً أَملَ المعَالِي","بِهِمَّتِهِ عَلي أَمِين يَحْيَا",5,"ي",2,0],["لِيَحوزَ جائِزَةَ اللَعينِ","لَعَنَ المُهَيمِنُ ما بِهِ يَتَضَهَّدُ",6,"د",1,0],["لي حين أنسب أسرةٌ عربيةٌ","كادتْ تعدّ الشهب من أحلافي",7,"ف",2,0],["لي حَبيبٌ حُبُّهُ وَسطَ الحَشا","إِن يَشَأ يَمشي عَلى خَدّي مَشى",8,"ش",2,0],["لي حَبيبٌ أَزورُ في الخَلَواتِ","حاضِرٌ غائِبٌ عَنِ اللَحَظاتِ",9,"ت",1,1],["لي حقوقٌ عليه أصبح يلْوي","ها فَطالِبْهُ لي بوشْك الأداءِ",10,"ا",2,0],["لِيَحْلُلْ ذَرَاه من تَلَدَّدَ حائراً","فما في ذَرَاهُ حائرٌ يَتَلدَّدُ",11,"د",1,0],["لِيَ حيْث انصرَفتُ عنها رفيقٌ","من هواها وحيث حَلَّتْ قَعِيدُ",12,"د",1,0],["لِيُحِسَّ نورَ الشَمسِ في ذَرّاتِهِ","وَيُقابِلُ النَسَماتِ غَيرَ مَقَّنَّعِ",13,"ع",1,0],["لي حَبيبٌ فَإِن أَكُن","لا أُسَمّيهِ فَاِفطُنِ",14,"ن",1,0],["لي حَبيبٌ عَبَدتُهُ","وَيحَ مَن يَعبُدُ الوَثَن",15,"ن",1,0],["لي حَبيبٌ لِيَ مِنهُ","كُلُّ شَيءٍ أَتَمَنّى",16,"ن",2,0],["لي حَبيبٌ لا أَبوحُ بِهِ","أَنا مِنهُ اليَومَ مَقتولُ",17,"ل",1,0],["لي حَبيبٌ لايُسَمّى","وَحَديثٌ لايُفَسَّر",18,"ر",1,1],["لي حبيب كلما قيل له","صدَّق القول وزكّى الريبا",19,"ب",2,0],["لي حَبيبٌ قَد لَجَّ في الهَجرِ جِدّا","وَأَعادَ الصُدودَ مِنهُ وَأَبدى",20,"د",2,1],["لي حُرمَةٌ مُذ أَربَعونَ أَعَدُّها","حِجَجاً وَلَستُ عَنِ القَديمِ بِناسِ",21,"س",1,0],["لي حاجَةٌ شَرُفَت وَلَيسَ بِبالِغٍ","فيها الَّذي أَمَّلتُ غَيرُ شَريفِ",22,"ف",1,0],["لي حاجَةٌ أَرجو لَها","إِحسانَكَ الأَوفى وَفَضلَك",23,"ك",1,0],["لِيَحيى فَمٌ لَو عُلِّقَ المِسكُ فَوقَهُ","لَأَصلَحَهُ وَالضِدُّ يُصلِحُهُ الضِدُّ",24,"د",1,1],["لي حَبيبٌ يَلَذُّ في","هِ عَذابي وَيَعذُبُ",25,"ب",1,1],["لي حَبيبٌ عَصَيتُ فيهِ النَصيحا","لَيسَ سَمحاً وَلا بَخيلاً شَحيحا",26,"ح",2,1],["لي حُرمَةٌ بِكَ أَمسى حَقُّ نازِلِها","وَقفاً عَلَيكَ فَدَتكَ النَفسُ مَحبوسا",27,"س",2,0],["لي حُرمَةٌ بِكَ لَولا ما رَعَيتَ وَما","أَوجَبتَ مِن حِفظِها ما خِلتُها تَجِبُ",28,"ب",1,0],["لي حاجَةٌ لا بُدَّ مِن قَضائِها","فَتَستَريحُ النَفسُ مِن عَنائِها",29,"ه",2,0],["لي حَبيبٌ يَكُدُّني بِمِطالِهِ","غَشَّ ديني بِحُسنِهِ وَجَمالِهِ",30,"ل",2,1],["لي حَبيبٌ مُكَذِّبٌ بِالأَماني","جَعَلَ الدَهرَ مَوعِداً وَاِنتِظارا",31,"ر",2,0],["لِيَحمَدِ اللَهَ مُنكُمُ رَجُلٌ","ساعَدَهُ في حَبيبِهِ الأَمَلُ",32,"ل",1,0],["لي حِيلَةٌ في مَن يَنُم","مُ وَلَيسَ في الكذّابِ حيلَه",33,"ه",1,1],["لي حبيب أراكَ فيه مُعَنّىً","غُرّ غَيري وفيه مَعنىً أراكا",34,"ك",2,0],["لي حين يبدي اللَيل زهر نجومه","نظر إِلى الشعرى العبور سَحيق",35,"ق",1,0],["لي حُرمَةٌ والَت عَلَيَّ سِجالَكُم","وَالماءُ رِزقُ جِمامِهِ لِلأَوَّلِ",36,"ل",1,0],["لِيَحْيَا فَارُوقُ وَالإِقْبَالُ مُتَّصِلٌ","وَشَعْبُ مِصْرَ عَزِيزٌ نَاعِمُ البَالِ",37,"ل",1,0],["لِيَحْيَا فَارُوقنا وَيَبْلَغْ","مِنَ المَعَالِي أَسْمَى الْمُرَادِ",38,"د",1,0],["لِيَحْيَى إِلْيَاسٌ وَلِيَحيَى","آلُهُ فِي سُعُودِ",39,"د",1,0],["لِيَحْيَا فَارُوقُ وَمَنْ مِثْلُهُ","يُضَاعِفُ الإِحْسَانَ بِاللُّطْفِ",40,"ف",1,0],["ليحول دون فتى الهوى وفتاته","إن الهوى ضرب من الطيران",41,"ن",1,0],["ليحتكمن الله أخذا بثأره","ويعجز عند الاحتكام المقاوم",42,"م",1,0],["لي حيلة ٌ في من ينمُّ","وليسَ في الكذّاب حِيله",43,"ه",1,1],["لي حقُّ تمحيص الأمورِ كواحدٍ","من سائر الشعراء والكُتاب",44,"ب",1,0],["ليُحِلَّني من بَعد مَسغَبةٍ","في ذي زُروع مُعشِبِ خَصِب",45,"ب",1,0],["لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا،","وأعَادَ الصّدودَ مِنْهُ وأبْدَا",46,"د",2,1],["لي حبيبٌ كلَّما قيل له","صَدَّقَ القولَ ، وزكذَى الرِّيبا",47,"ب",2,0],["لي حَبيب فِداهُ كُل حَبيب","لَيسَ إِلّا بِهِ الحَياة تَطيب",48,"ب",1,1],["لي حبيب ذو جمال مفرد","وبحكم الهجر للعشاق شذ",49,"ذ",1,1],["لي حبيب اضر بالبعد قلبي","ودلالا اسأني بالجفء",50,"ا",1,1],["لي حَبيبٌ كَمَلت أَوصافُهُ","حُقَّ لي في حُبِّهِ أَن أُعذَرا",51,"ر",2,0],["ليحَيى بن عبد اللهِ عِرسٌ كريمةٌ","تعاتبُه أن صاغهُ اللهُ ساقطا",52,"ط",2,1],["لي حيلةٌ في كلّ رامٍ مُغرِضٍ","لو أنه في غير قوسك ينزِعُ",53,"ع",1,0],["لِيَحوِ الفَخرَ عَصرٌ أَنتَ فيهِ","فَإِنَّكَ لِلزَمانِ يَدٌ تَصولُ",54,"ل",1,0],["لي حَبِيبٌ خَدُّهُ كالْ","وَردِ حُسْناً في بَياضِ",55,"ض",1,1],["لي حبيبٌ أذاب قلبي وصدّا","كان في الحكم ظالما وتعدّى",56,"د",2,1],["لي حبيب قد شفَّني وبراني","هو دانٍ ووصلُه غير دانِ",57,"ن",1,1],["لي حبيب أضحى حبيباً إلى النا","س بحُسنٍ مُقلِّبٍ للقلوب",58,"ب",1,0],["لي حُرمَةُ الضَيفِ وَالجارِ القَديمِ وَمَن","ناداكُم وَكُهولُ الحَيِّ أَطفالُ",59,"ل",1,0],["لي حَبيبٌ مَن رَآهُ","جَنَّ في الحالِ جُنون",60,"ن",1,1],["لي حشى ما بليت شب سعيره","فعسى غيره حشى استعيره",61,"ر",2,1],["ليحيى الهنا تاريخه بالبها ازدهى","له زفّت الزهراء بالحسن في العليا",62,"ي",2,0],["ليُحصَى مَنطِقِي وَكَلامُ غَيرِي","عُشَيرَ خِصَالها شَرَّ الخِصَالِ",63,"ل",1,0],["لي حولان أَرتَجي بث أشوا","قي اليكم فَما وجدت رَسولا",64,"ل",2,0],["لي حَبيبٌ ناظِرٌ عَن لَحظِ خِشفِ","قُبلَةٌ مِنهُ مِنَ الأَسقامِ تَشفي",65,"ف",2,1],["ليُحرزَ الثَوابا","والأَجرَ والصَوابا",66,"ب",2,0],["لِيحفّ مَجدكَ بِالسعادةِ والهنا","في النفسِ والأموال والأبناءِ",67,"ا",2,0],["لي حَديثٌ هُوَ القَديمُ الصَحيحُ","وَمُعَمّاهُ لِلَبيبُ صَريحُ",68,"ح",1,1],["لِيُحمَدَ مَحمودٌ وَيَهلِكَ هالِكٌ","وَفاءً بِعَهدٍ لا نُكَذِّبَهُ غَدرا",69,"ر",2,0],["لي حالةٌ عَجُفَتْ فإنْ تُعْنَوْا بها","فجديرةٌ هيَ أنْ تعودَ فَتسْمنَا",70,"ن",2,0],["ليَحْفَظَ مَالَ اللهِ ممّنْ يُضيعُهُ","وتَجْريَ فيه للحُقوقِ المَقاسِم",71,"م",1,0],["لي حاجَةٌ تُقضى إِذا","ما كانَ