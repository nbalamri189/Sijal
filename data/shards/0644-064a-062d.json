{"poems":[[77,"لي حبيب لست أعصي أمره","https://www.aldiwan.net/poem36407.html","الرمل"],[86,"ما لهذا النجم في السحر","https://www.aldiwan.net/poem10504.html","المديد"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[93,"طوقتموني بأطواق من المنن","https://www.aldiwan.net/poem9166.html","البسيط"],[93,"مولاي جاري في الندى طبعه","https://www.aldiwan.net/poem9829.html","السريع"],[93,"يد لله لا توفى بحمد","https://www.aldiwan.net/poem11091.html","الوافر"],[54,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[64,"يا نسيم الريح قولي للرشا","https://www.aldiwan.net/poem67632.html","البسيط"],[64,"لي حبيب أزور في الخلوات","https://www.aldiwan.net/poem67660.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[70,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[70,"لكم الروح والبدن","https://www.aldiwan.net/poem42443.html","مجزوء الخفيف"],[70,"سمع الناس وقلنا","https://www.aldiwan.net/poem42679.html","مجزوء الرمل"],[70,"كل شيء منك مقبول","https://www.aldiwan.net/poem42760.html","المديد"],[70,"لي حبيب لايسمى","https://www.aldiwan.net/poem42910.html","مجزوء الرمل"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[45,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"حييتما من مربع ومصيف","https://www.aldiwan.net/poem65158.html","الطويل"],[45,"اسلم أبو العباس وابق","https://www.aldiwan.net/poem65220.html","مجزوء الكامل"],[66,"ليحيى فم لو علق المسك فوقه","https://www.aldiwan.net/poem38600.html","الطويل"],[66,"لي حبيب يلذ فيه","https://www.aldiwan.net/poem39919.html","مجزوء الخفيف"],[44,"لي حبيب عصيت فيه النصيحا","https://www.aldiwan.net/poem30271.html","الخفيف"],[44,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"لي حبيب يكدني بمطاله","https://www.aldiwan.net/poem26753.html","الخفيف"],[52,"قف خليلي نسأل لشرة دارا","https://www.aldiwan.net/poem27045.html","الخفيف"],[48,"ما لي في الناس كلهم مثل","https://www.aldiwan.net/poem65004.html","المنسرح"],[50,"لي حيلة في من ينمم","https://www.aldiwan.net/poem62256.html","مجزوء الكامل"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85421","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54743","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54699","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55044","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[50,"لي حيلة ٌ في من ينمُّ","https://www.poetsgate.com/ViewPoem.aspx?id=31002",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[45,"لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا","https://www.poetsgate.com/ViewPoem.aspx?id=31601",""],[85,"رَوّعوه ؛ فتولَّى مغضِبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9536&r=&rc=26",""],[110,"لي حبيب فداه كل حبيب","https://www.aldiwan.net/poem16682.html","الخفيف"],[116,"لي حبيب ذو جمال مفرد","https://www.aldiwan.net/poem41123.html","عموديه"],[116,"لي حبيب اضر بالبعد قلبي","https://www.aldiwan.net/poem41468.html","عموديه"],[116,"أنا من تسمع عنه وترى","https://www.aldiwan.net/poem42905.html","الرمل"],[143,"ليحيى بن عبد الله عرس كريمة","https://www.aldiwan.net/poem58333.html","الطويل"],[143,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[144,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[156,"لي حبيب خده كال","https://www.aldiwan.net/poem55647.html","مجزوء الرمل"],[187,"لي حبيب أذاب قلبي وصدا","https://www.aldiwan.net/poem43934.html","الخفيف"],[205,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[205,"أنا في وحشتي غريب بحبي","https://www.aldiwan.net/poem53355.html","الخفيف"],[233,"من شيمة الدهر إعراض وإقبال","https://www.aldiwan.net/poem14796.html","البسيط"],[233,"لي حبيب من رآه","https://www.aldiwan.net/poem14841.html","مجزوء الرمل"],[243,"لي حشى ما بليت شب سعيره","https://www.aldiwan.net/poem1343.html",""],[260,"لألسنة الأقلام أعذب منطق","https://www.aldiwan.net/poem35749.html","الخفيف"],[263,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[272,"قف بذات الاراك واندب طلولا","https://www.aldiwan.net/poem52065.html","الخفيف"],[283,"لي حبيب ناظر عن لحظ خشف","https://www.aldiwan.net/poem32702.html","الرمل"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[306,"أنهي لناديك العلي ثنائي","https://www.aldiwan.net/poem56615.html","الكامل"],[350,"لي حديث هو القديم الصحيح","https://www.aldiwan.net/poem15557.html","الخفيف"],[359,"سل الناس هل هزت فوارسنا الوغى","https://www.aldiwan.net/poem717.html",""],[365,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[365,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[367,"لم يبق بعدكم دموع","https://www.aldiwan.net/poem17225.html","مجزوء الكامل"],[367,"كم قلت للعاني المنى بلحاقه","https://www.aldiwan.net/poem17256.html","الكامل"],[372,"أيترك سر بعد سري لكاتم","https://www.aldiwan.net/poem57133.html","الطويل"],[372,"لي حبيب دنف القلب","https://www.aldiwan.net/poem57146.html","مجزوء الرمل"],[404,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[406,"هل أنت شار لنفسي من رسيس جوى","https://www.aldiwan.net/poem49939.html","البسيط"],[411,"إذا أم طفل راعها جوع طفلها","https://www.aldiwan.net/poem67481.html","الطويل"],[417,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[430,"لي حيلة فيمن ينم بأنني","https://www.aldiwan.net/poem40070.html","الكامل"],[430,"سلبت فوادي ظبية","https://www.aldiwan.net/poem40511.html","مجزوء الكامل"],[453,"لي حبيب حسن الود","https://www.aldiwan.net/poem13625.html","مجزوء الرمل"],[459,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[480,"بعد أحبابي كساني الأرقا","https://www.aldiwan.net/poem36922.html","الرمل"],[514,"يا أخي كم يكون هذا الجفاء","https://www.aldiwan.net/poem67799.html","الخفيف"],[516,"إجر النسيم إلى السمائم","https://www.aldiwan.net/poem12266.html","مجزوء الكامل"],[539,"عجبا للمحب يجني ذنوبا","https://www.aldiwan.net/poem48285.html","عموديه"],[545,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[550,"أمن القتول منازل ومعرس","https://www.aldiwan.net/poem446.html",""],[559,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[576,"بنفسي من فارقت فيه تماسكي","https://www.aldiwan.net/poem2901.html","الطويل"],[576,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["لي حَبيبٌ لسْتُ أعصي أمْرَهْ","لمْ أُطِقْ بعْدَ وِصالٍ هجْرَهْ",0,"ه",1,1],["لي حَبيبٌ هاجِرٌ وَلَهُ","صورَةٌ مِن أَبدَعِ الصُوَرِ",1,"ر",1,0],["لَيَحظى وَلِيٌّ سِرُّهُ وَفقُ جَهرِهِ","فَظاهِرُهُ شُكرٌ وَباطِنُهُ وُدُّ",2,"د",1,0],["ليحفظ اللَه فاروقاً لأمته","وللعروبة ولينصره وليصن",3,"ن",1,0],["ليحيى فاروق ومن مثله","يضاعف الإحسان باللطف",4,"ف",1,0],["لِيَحْيَيَ مُحَقِّقاً أَملَ المعَالِي","بِهِمَّتِهِ عَلي أَمِين يَحْيَا",5,"ي",2,0],["لِيَحوزَ جائِزَةَ اللَعينِ","لَعَنَ المُهَيمِنُ ما بِهِ يَتَضَهَّدُ",6,"د",1,0],["لي حين أنسب أسرةٌ عربيةٌ","كادتْ تعدّ الشهب من أحلافي",7,"ف",2,0],["لي حَبيبٌ حُبُّهُ وَسطَ الحَشا","إِن يَشَأ يَمشي عَلى خَدّي مَشى",8,"ش",2,0],["لي حَبيبٌ أَزورُ في الخَلَواتِ","حاضِرٌ غائِبٌ عَنِ اللَحَظاتِ",9,"ت",1,1],["لي حقوقٌ عليه أصبح يلْوي","ها فَطالِبْهُ لي بوشْك الأداءِ",10,"ا",2,0],["لِيَحْلُلْ ذَرَاه من تَلَدَّدَ حائراً","فما في ذَرَاهُ حائرٌ يَتَلدَّدُ",11,"د",1,0],["لِيَ حيْث انصرَفتُ عنها رفيقٌ","من هواها وحيث حَلَّتْ قَعِيدُ",12,"د",1,0],["لِيُحِسَّ نورَ الشَمسِ في ذَرّاتِهِ","وَيُقابِلُ النَسَماتِ غَيرَ مَقَّنَّعِ",13,"ع",1,0],["لي حَبيبٌ فَإِن أَكُن","لا أُسَمّيهِ فَاِفطُنِ",14,"ن",1,0],["لي حَبيبٌ عَبَدتُهُ","وَيحَ مَن يَعبُدُ الوَثَن",15,"ن",1,0],["لي حَبيبٌ لِيَ مِنهُ","كُلُّ شَيءٍ أَتَمَنّى",16,"ن",2,0],["لي حَبيبٌ لا أَبوحُ بِهِ","أَنا مِنهُ اليَومَ مَقتولُ",17,"ل",1,0],["لي حَبيبٌ لايُسَمّى","وَحَديثٌ لايُفَسَّر",18,"ر",1,1],["لي حبيب كلما قيل له","صدَّق القول وزكّى الريبا",19,"ب",2,0],["لي حَبيبٌ قَد لَجَّ في الهَجرِ جِدّا","وَأَعادَ الصُدودَ مِنهُ وَأَبدى",20,"د",2,1],["لي حُرمَةٌ مُذ أَربَعونَ أَعَدُّها","حِجَجاً وَلَستُ عَنِ القَديمِ بِناسِ",21,"س",1,0],["لي حاجَةٌ شَرُفَت وَلَيسَ بِبالِغٍ","فيها الَّذي أَمَّلتُ غَيرُ شَريفِ",22,"ف",1,0],["لي حاجَةٌ أَرجو لَها","إِحسانَكَ الأَوفى وَفَضلَك",23,"ك",1,0],["لِيَحيى فَمٌ لَو عُلِّقَ المِسكُ فَوقَهُ","لَأَصلَحَهُ وَالضِدُّ يُصلِحُهُ الضِدُّ",24,"د",1,1],["لي حَبيبٌ يَلَذُّ في","هِ عَذابي وَيَعذُبُ",25,"ب",1,1],["لي حَبيبٌ عَصَيتُ فيهِ النَصيحا","لَيسَ سَمحاً وَلا بَخيلاً شَحيحا",26,"ح",2,1],["لي حُرمَةٌ بِكَ أَمسى حَقُّ نازِلِها","وَقفاً عَلَيكَ فَدَتكَ النَفسُ مَحبوسا",27,"س",2,0],["لي حُرمَةٌ بِكَ لَولا ما رَعَيتَ وَما","أَوجَبتَ مِن حِفظِها ما خِلتُها تَجِبُ",28,"ب",1,0],["لي حاجَةٌ لا بُدَّ مِن قَضائِها","فَتَستَريحُ النَفسُ مِن عَنائِها",29,"ه",2,0],["لي حَبيبٌ يَكُدُّني بِمِطالِهِ","غَشَّ ديني بِحُسنِهِ وَجَمالِهِ",30,"ل",2,1],["لي حَبيبٌ مُكَذِّبٌ بِالأَماني","جَعَلَ الدَهرَ مَوعِداً وَاِنتِظارا",31,"ر",2,0],["لِيَحمَدِ اللَهَ مُنكُمُ رَجُلٌ","ساعَدَهُ في حَبيبِهِ الأَمَلُ",32,"ل",1,0],["لي حِيلَةٌ في مَن يَنُم","مُ وَلَيسَ في الكذّابِ حيلَه",33,"ه",1,1],["لي حبيب أراكَ فيه مُعَنّىً","غُرّ غَيري وفيه مَعنىً أراكا",34,"ك",2,0],["لي حين يبدي اللَيل زهر نجومه","نظر إِلى الشعرى العبور سَحيق",35,"ق",1,0],["لي حُرمَةٌ والَت عَلَيَّ سِجالَكُم","وَالماءُ رِزقُ جِمامِهِ لِلأَوَّلِ",36,"ل",1,0],["لِيَحْيَا فَارُوقُ وَالإِقْبَالُ مُتَّصِلٌ","وَشَعْبُ مِصْرَ عَزِيزٌ نَاعِمُ البَالِ",37,"ل",1,0],["لِيَحْيَا فَارُوقنا وَيَبْلَغْ","مِنَ المَعَالِي أَسْمَى الْمُرَادِ",38,"د",1,0],["لِيَحْيَى إِلْيَاسٌ وَلِيَحيَى","آلُهُ فِي سُعُودِ",39,"د",1,0],["لِيَحْيَا فَارُوقُ وَمَنْ مِثْلُهُ","يُضَاعِفُ الإِحْسَانَ بِاللُّطْفِ",40,"ف",1,0],["ليحول دون فتى الهوى وفتاته","إن الهوى ضرب من الطيران",41,"ن",1,0],["لي حيلة ٌ في من ينمُّ","وليسَ في الكذّاب حِيله",42,"ه",1,1],["لي حقُّ تمحيص الأمورِ كواحدٍ","من سائر الشعراء والكُتاب",43,"ب",1,0],["ليُحِلَّني من بَعد مَسغَبةٍ","في ذي زُروع مُعشِبِ خَصِب",44,"ب",1,0],["لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا،","وأعَادَ الصّدودَ مِنْهُ وأبْدَا",45,"د",2,1],["لي حبيبٌ كلَّما قيل له","صَدَّقَ القولَ ، وزكذَى الرِّيبا",46,"ب",2,0],["لي حَبيب فِداهُ كُل حَبيب","لَيسَ إِلّا بِهِ الحَياة تَطيب",47,"ب",1,1],["لي حبيب ذو جمال مفرد","وبحكم الهجر للعشاق شذ",48,"ذ",1,1],["لي حبيب اضر بالبعد قلبي","ودلالا اسأني بالجفء",49,"ا",1,1],["لي حَبيبٌ كَمَلت أَوصافُهُ","حُقَّ لي في حُبِّهِ أَن أُعذَرا",50,"ر",2,0],["ليحَيى بن عبد اللهِ عِرسٌ كريمةٌ","تعاتبُه أن صاغهُ اللهُ ساقطا",51,"ط",2,1],["لي حيلةٌ في كلّ رامٍ مُغرِضٍ","لو أنه في غير قوسك ينزِعُ",52,"ع",1,0],["لِيَحوِ الفَخرَ عَصرٌ أَنتَ فيهِ","فَإِنَّكَ لِلزَمانِ يَدٌ تَصولُ",53,"ل",1,0],["لي حَبِيبٌ خَدُّهُ كالْ","وَردِ حُسْناً في بَياضِ",54,"ض",1,1],["لي حبيبٌ أذاب قلبي وصدّا","كان في الحكم ظالما وتعدّى",55,"د",2,1],["لي حبيب قد شفَّني وبراني","هو دانٍ ووصلُه غير دانِ",56,"ن",1,1],["لي حبيب أضحى حبيباً إلى النا","س بحُسنٍ مُقلِّبٍ للقلوب",57,"ب",1,0],["لي حُرمَةُ الضَيفِ وَالجارِ القَديمِ وَمَن","ناداكُم وَكُهولُ الحَيِّ أَطفالُ",58,"ل",1,0],["لي حَبيبٌ مَن رَآهُ","جَنَّ في الحالِ جُنون",59,"ن",1,1],["لي حشى ما 