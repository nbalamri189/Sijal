ِّ","https://www.poetsgate.com/ViewPoem.aspx?id=16883",""],[58,"صَرَمَتْ حِبَاْلَكَ بَعْدَ وَصْلِكَ زَيْنَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=22645",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"الجيل الجَديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=179209",""],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[91,"اسألوها","https://www.poetsgate.com/ViewPoem.aspx?id=53384",""],[51,"وَلع الزمانُ بأن يحرِّكَ ساكِناً","https://www.poetsgate.com/ViewPoem.aspx?id=30806",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[87,"ما لِقلبى من لوعة ٍ ليسَ يَهدا ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23869&r=&rc=131",""]],"verses":[["وَكَذا بَياضُ الناظِرينَ وَإِنَّما","بِسَوادِها تَتَأَمَّلُ العَينانِ",0,"ن",1,0],["وَكَذا المُلوكُ تَقَوَّضوا وَاِستَصعَبوا","تَقويضَ ما رَفَعوا مِنَ الآطامِ",1,"م",1,0],["وَكَذاكَ عَمروٌ ذو المَعابِلِ فاتَهُ","بَعدَ اِضطِرابِ النَزعِ رَدُّ سِهامِ",1,"م",1,0],["وَكَذا الصَديقُ إِذا أَرادَ قَطيعَتي","ظَنَّ الظُنونَ وَقالَ أَنتَ مَلولُ",2,"ل",1,0],["وَكَذا الأَيّامُ مَن قارَعَها","تَرَكَت فيهِ عَلاماتِ النِزالِ",3,"ل",1,0],["وَكَذا السابِقُ يَوماً بِعِنانٍ","يُحرِزُ السَبقَ وَيَوماً بِعِقالِ",3,"ل",1,0],["وَكَذاكَ هَمُّ الريحِ في غُصُنٍ","تَثنيهِ أَو ماءٍ تُصَفِّقُهُ",4,"ق",2,0],["وَكَذا مَضى قَبلي القُرونُ يَكُبُّهُم","صَرفُ الزَمانِ تَسَرُّعاً وَنَجاءَ",5,"ا",2,0],["وَكَذا الماءُ لَيْسَ يُجْريهِ إِلَّا","وَهَجُ النارِ مِنْ غُصونٍ رِطابِ",6,"ب",1,0],["وَكَذا سِباعُ البَرِّ لَولا شَرُّه","دارَت بِها في الغابِ غِربانُ الفَلا",7,"ل",2,0],["وَكَذاكَ المَلولُ مِن سائِرِ النا","سِ سَريعُ الإِقبالِ وَالإِنصِرافِ",8,"ف",1,0],["وَكَذا الرَئيسُ هُوَ الرَئيسُ بِخُلقِهِ","لَيسَ الرَئيسُ بِقَومِهِ وَرِجالِهِ",9,"ل",2,0],["وَكَذا الغَنِيُ هُوَ الغَنِيُ بِحالِهِ","لَيسَ الغَنيُّ بِمُلكِهِ وَبِمالِهِ",9,"ل",2,0],["وَكَذُا السُّيُوفُ مُلِثَّةٌ أَنْوَاؤُهَا","وَالشَّمْسُ فِي جَدْيٍ وَفِي سَرَطَانِ",10,"ن",1,0],["وَكَذَلِكَ الْخبّ اللَّئِيمُ إِذَا سَطَا","عَمِلَ الَّتِي مَا بَعْدَها مَا يُعْمَلُ",11,"ل",1,0],["وكَذا الحُسينُ قضى ولم يُنْدَبْ الى","زمَنٍ توالَتْ بعْدَهُ أعْصارُهُ",12,"ر",2,0],["وكذا الفُروعُ تَطولُ وهْيَ شَبيهةٌ","بالأصْلِ في ورَقٍ وفي إثْمارِ",13,"ر",1,0],["وكَذا النوْمُ شاعِرٌ فيكَ أمْسى","منْ دُموعي يَهيمُ في كلِّ وادي",14,"ي",1,0],["وكَذا الخَلْقُ منْ تُرابِ ولَكِنْ","نَفَخَ اللهُ فِيه رُوحَ الحَياةِ",15,"ه",1,0],["وَكَذاكَ مَن عَظُمَت عَليهِ نِعمَةٌ","حُسّادُه سَيفٌ عَليهِ صَرومُ",16,"م",1,0],["وَكَذا طُهاةُ الرَأيِ تَترُكُهُ","لِلدَهرِ يُنضِجُهُ عَلى مَهَلِ",17,"ل",1,0],["وَكَذَلِكَ القَصّابُ يَذكُرُ رَبَّهُ","وَالنَصلُ في عُنُقِ الذَبيحِ دَفينُ",18,"ن",1,0],["وَكَذَلِكَ المِنديلُ أَبلَغُ ضَربَةً","مِن صارِمٍ في حَدِّهِ التَضليلُ",19,"ل",1,0],["وَكَذا الدَهرُ إِذا ما","عَزَّ ناسٌ ذَلَّ ناسُ",20,"س",1,0],["وَكَذَلِكَ السَيلُ الجُحافُ فَإِنَّما","أُولاهُ طَلٌّ ثُمَّ وَبلٌ يَثجُمُ",21,"م",1,0],["وَكَذَا الفَتَاةُ إِذَا ابْتَغَتْ مِرْآتَهَا","فَتَعَذَّرَتْ نَظَرَتْ بِعَيْنَيْ أُمِّهَا",22,"م",3,0],["وكذا العفاة إذا شكوْا","فغناهمُ أَنْ يسألوكْ",23,"ك",1,0],["وكذا أبوه وكان منه حِمامُهُ","قد حُمَّ وهُوَ من الحياة على غَرَرْ",24,"ر",1,0],["وكذاك استقلالنا غِيل معنا","هُ فأضحى للفظه الاعتبار",25,"ر",1,0],["وكذا الحزين إذا تهيّج حزنه","يبكي فيسكن حزنه بعويله",26,"ل",2,0],["وَكَذاكَ حَقّاً مَن يُعَمِّر يُبلِهِ","كَرُّ الزَمانِ عَلَيهِ وَالتَقليبُ",27,"ب",1,0],["وَكَذا الزَمانُ بِما يَسُرُّكَ تارَةً","وَبِما يَسوءُكَ تارَةً يَتَنَقَّلُ",28,"ل",1,0],["وَكَذاكَ وَرَّثَكَ الأَوائِلُ إِنَّهُم","ذَهَبوا وَصِرتَ بِخِزيَةٍ وَعَذابِ",29,"ب",1,0],["وكذاك ألف مثلها","فاهنأ بعقباها الكفيلهْ",30,"ل",2,0],["وكذا فقدُه العزيزُ علينا","كاسمه مبْدلاً من الزاي تاءَ",31,"ا",2,0],["وكذا كلّما نويتَ لمولا","كَ مزيداً أوتيتَهُ والهناءَ",32,"ا",2,0],["وكذاك لستُ أُريد من","ه سوى البقاء مع اللقاءِ",33,"ق",3,0],["وكذا لستَ تعرفُ الشيء إلا","بعد فحصٍ من أمره وابتلاءِ",34,"ا",2,0],["وكذاكَ نفسُك لا تُري","ك عيوبَ نفسِك مَعْ هَواها",35,"ه",2,0],["وكذاكَ مثلك ينحلُ السا","داتِ عَرَّتَهُ وعَابهْ",36,"ب",2,0],["وكذلك البغَّاءُ با","غٍ إن تَفَهَّمْتَ انتسابهْ",36,"ب",2,0],["وكذاك نشرع في غديرٍ واحدٍ","يصف الصفاءُ لوارديهِ طِيبَهُ",37,"ب",2,0],["وكذاك الدنيا الدنيَّةُ قدراً","تتصدَّى لأَلأم الخُطّابِ",38,"ب",1,0],["وكذاك أنتُم معشرٌ","في عُودِ غَيْرَتِكُمْ عِوَجْ",39,"ج",1,0],["وكذا يَرَى مَنْ لا يزالُ إذا جَرَى","مَسَحَتْ به الأيدِي جواداً أقْرَحا",40,"ح",2,0],["وكذا أنتُم لَكُم أَمَرَاتٌ","يَتَكَلَّمْنَ عَنْكُمُ في المُهُودِ",41,"د",1,0],["وكذا رقٌّ الأيادي لازم","جِيدَ من أنكره حتى التنادي",42,"د",2,0],["وكذاك البدر يسري في الدجى","وله من نفسه نورٌ وهادي",42,"د",2,0],["وكذاك عاداتُ الكريم إذا","أسدى يداً حُسبتْ عليه يدا",43,"د",2,0],["وكذا يَظلم المسمّى بإبرا","هيم أهلُ الديوان في كل أمر",44,"ر",1,0],["وكذلك الأكياسُ تُذخَر عُدّةَ","من مُسعدِ الأزمانِ للمتنكِّر",45,"ر",1,0],["وكذا القوم لم يروا لجة البح","ر فهم يُعظِمون ماء الغديرِ",46,"ر",1,0],["وكذا الفلسفةُ الأو","لى فكانت طَنْز طانز",47,"ز",1,0],["وكذا الكريمُ حباؤهُ وإباؤهُ","أمران ما بكليهما من باس",48,"س",1,0],["وكذا عهدتك ليناً ذا ميعةٍ","يَسَر الخلائق مُحصد الأمراس",48,"س",1,0],["وكذاك الفتى بموقف موقو","فٍ على حادث الزمان حبيس",49,"س",1,0],["وكذا الخندريس تُضْحي وتُمْسي","آفةَ العقل غير ذي التأسيس",49,"س",1,0],["وكذا صاعداً أبوه ألا بُع","داً لإبليسَ وابنه لاقيس",49,"س",1,0],["وكذا السادةُ الحقيقُونَ بالسؤ","دُدِ أهلُ النُهوض والإنهاض",50,"ض",1,0],["وكذا عقول ذوي العقول على","أسرار أهل الجهل مطَّلعه",51,"ع",2,0],["وكذاك أجزي كل منفقِ بصقةٍ","في غير موضعها من الإنفاق",52,"ق",1,0],["وكذا المطاعمُ كلُّها جُعِلتْ","مُسَكاً مجدَّدةً على مُسكِ",53,"ك",1,0],["وكذا لا تزالُ عُمْركَ أو تع","جِزُ عن مَسِّهِنَّ من إرْعاشِك",54,"ك",1,0],["وكذا أنتم لكم كلَّ يوم","مستنيلٌ إذا أُنيلَ أنالا",55,"ل",2,0],["وكذاك الكريمُ سئَّالُ حاجا","تِ سواه وليس بالسئّالِ",56,"ل",1,0],["وكذا الكريمُ ابنُ الكرا","مِ يعولُ أيتامَ القبائلْ",57,"ل",1,0],["وكذاك معروفُ الكرام كفايةٌ","أبداً وأكثر مَدْحِهم تعليلُ",58,"ل",1,0],["وكذا يقولُ لمن ينهنه عوْده","هيهات ليس لنعمتي تحويلُ",58,"ل",1,0],["وكذاك الزمانُ يمحلُ بالإل","فَيْنِ محلاً يجني بعادَ زِيالِ",59,"ل",1,0],["وكذاك القضاءُ يأذنُ في القت","لِ وفيه عن القتالِ تعالي",59,"ل",2,0],["وكذا المُؤاجِرُ في الشبيبةِ لايني","أبداً له دُبُرٌ يردُّ مظالما",60,"م",2,0],["وكذا الماءُ طيِّبٌ ما استقوْهُ","آجنٌ آسِنٌ على الإجمام",61,"م",1,0],["وكذا ذَنْبُ كُلِّ دَهرٍ يليه","آلُ وَهْب أعُدُّهُ إحسانا",62,"ن",2,0],["وكذاك النيروزُ رُدَّ عليه","بك شرخُ الشباب ذي الريعان",63,"ن",1,0],["وكذا من ذكَتْ أياديه كانت","للمفيدين منه فائدتان",63,"ن",1,0],["وكذاك شِربُ العيش فيه تلوُّنٌ","بيناهُ عذبٌ إذ تحوّلَ آسِنا",64,"ن",2,0],["وكذاك الذي حَمَى الماء لمَّا","يذهبُ المذهبَ الذي يعنيه",65,"ي",2,0],["وَكَذَّبوا رُسُلَ الأَكفاءِ وَاِنتَقَضَت","بِالقَومِ أَوزارُهُم في الأَمرِ فَاِنتَشَروا",66,"ر",3,0],["وَكَذا يولَدُ الرَجاءُ مِنَ اليَأسِ","إِذا ماتَ في القُلوبِ الرَجاءُ",67,"ا",2,0],["وَكَذاكَ أَشواقُ التُرابِ مَآلَها","وَلَئِن تَقادَمَ عَهدُها لِتُرابِ",68,"ب",1,0],["وَكَذَلِكَ الغَيداءُ أَذهَلَها","مَيلٌ إِلى هَذا الفَتى الغِرِّ",69,"ر",1,0],["وَكَذا الحَياةُ قَديمُها وَحَديثُها","ذِكرى نُسَرُّ بِها وَذِكرى تُؤلِمُ",70,"م",1,0],["وَكَذاكَ الهَوى إِذا حَلَّ في الأَر","واحِ سارَت في مَوكِبٍ مِن رُؤاها",71,"ا",3,0],["وَكَذاكَ قالوا الغُصنُ يُشبِهُ قَدَّهُ","يا قَدَّهُ كُلُّ الغُصونِ لَكَ الفِدا",72,"د",2,0],["وَكَذاكَ أَنتَ فَسَل ضَمي","رَكَ فَهُوَ يَشهَدُ بِالصَحيحِ",73,"ح",1,0],["وكذاك تُتَّخَذُ المظالمُ منطقاً","عذباً لتخفِيّ سَوْءةَ الآرابِ",74,"ب",1,0],["وَكَذَلِكَ إِن ذُكر الخَلي","لُ فَأَنتَ نَحويّ وَشاعِرْ",75,"ر",1,0],["وكذاك تشكر كل ار","ض عضها الجدب السحابا",76,"ب",2,0],["وكذاك الذي يكون خفياً","بشعاع من نور رنتجن يبدو",77,"د",2,0],["وكذاك النفس في احوالها","حسب الجوهر منها والنجار",78,"ر",1,0],["وَكَذاكَ النُفوسُ وَهيَ مِراضٌ","بَعضُ أَعضائِها لِبَعضٍ فِداءُ",79,"ا",2,0],["وكَذاكَ الهِلالُ أَوَّلَ ما يب","دو نَحيلاً في دِقّةِ الخلخالِ",80,"ل",1,0],["وَكَذا الكَريمُ إِذا أَقامَ بِبَلدَةٍ","سالَ النُضارُ بِها وَقامَ الماءُ",81,"ا",2,0],["وَكَذا تَطلُعُ البُدورُ عَلَينا","وَكَذا تَقلَقُ البُحورُ العِظامُ",82,"م",1,0],["وكذاك أخبل بالدخان إذا ارتقى","فحل يتمّ بزرعه الإلقاح",83,"ح",1,0],["وكذا ضمِنْتُ الشكرَ منه تكلُّفَاً","حقٌّ عليه لمن يفِي بضَمانِهِ",84,"ه",1,0],["وَكَذاكَ السَحابُ لَيسَ يَعُمُّ ال","أَرضَ وَبلاً حَتّى يَعُمَّ السَماءَ",85,"ا",2,0],["وَكَذا الكُردُ سَنَّ لِلمَوتِ فيهُم","بِطُوالِ الرِماحِ طولَ الخُلودِ",86,"د",1,0],["وَكَذا السَيفُ لَيسَ يُرضيكَ في الغِم","دِ وَيُرضيكَ ساعَةَ التَجريدِ",86,"د",1,0],["وَكَذا الحُكومَةُ مِن أَئِمَّةِ هاشِمٍ","مِن لُدنُ أَوَّلِهِم إِلى ذا التاسِعِ",87,"ع",1,0],["وَكَذاكَ ما أَدَعُ العِتابَ مُخَفِّفاً","وَلِذاكَ ما أَولَيتَ لَيسَ بِنافِعِ",87,"ع",1,0],["وَكَذا أَشتَهي يَكونُ فَتى الحِم","مَةِ غَيرَ الخُمَيِّمِ المَأفوكِ",88,"ك",1,0],["وَكَذاكَ أَنتَ البَحرُ ثُمَّ تَكونُ في","كَرَمِ العُذوبَةِ مُشبِهاً لِلنيلِ",89,"ل",1,0],["وَكَذاكَ طَرفَةُ حينَ أَوجَسَ ضَربَةً","في الرَأسِ هانَ عَلَيهِ قَطعُ الكاحِلِ",90,"ل",1,0],["وَكَذا المُلحِفُ المُلِحُّ إِذا أَن","شَبَ في نائِلِ اللَجوجِ البَخيلِ",91,"ل",1,0],["وَكَذاكَ مَن كِسرى أَبَرويزٌ لَهُ","عَمٌّ إِلى كِسرى أَنوشِروانِ",92,"ن",1,0],["وكذاكَ من شُبَّتْ بأَرْضِكَ نارُهُ","أضحَى بنارِكَ طرفُه مَطروفا",93,"ف",2,0],["وكذاك أطفأ من أبي","قابوسَ جَمرَةَ كلِّ قابِس",94,"س",1,0],["وكذا الفتى إن لم يُذَكِّرْ سيفَه","وفِعالَه بصلاتِهِ لم يُذكَرِ",95,"ر",1,0],["وَكَذاكَ وَصلُ الغانِياتِ فَإِنَّهُ","آلٌ بِبَلقَعَةٍ وَبَرقٍ خُلَّبُ",96,"ب",1,0],["وَكَذَلِكَ الأَيّامُ في غَدَواتِها","مَرَّت يُذَلُّ لَها الأَعَزُّ الأَنَجَبُ",96,"ب",1,0],["وَكَذاكَ سِرُّ المَرءِ إِن لَم يَطوِهِ","نَشَرَتهُ أَلسِنَةٌ تَزيدُ وَتَكذِبُ",96,"ب",1,0],["وَكَذَّبتُموهُ بِوَحيِ السَماءِ","أَلا لَعنَةُ اللَهِ لِلكاذِبِ",97,"ب",1,0],["وَكَذاكَ لَم يَزَلِ الزَما","نُ بِأَهلِهِ مُتَقَلِّبا",98,"ب",2,0],["وَكَذاكَ الأُمورُ تَعثُرُ بِالنا","سِ فَخَطبٌ يَمشي وَخَطبٌ يَكُرُّ",99,"ر",1,0],["وَكَذا الدُنيا عَلى ما رَأَينا","يَذهَبُ الناسُ وَتَخلو الدِيارُ",100,"ر",1,0],["وَكَذاكَ كُلُّ مُفارِقِ لا يَرتَجي","مَن كانَ يَحفَظُهُ فَسَوفَ يُضيعُهُ",101,"ع",2,0],["وَكَذاكَ الحُبُّ صاحِبُهُ","يَعتَريهِ الهَمُّ وَالوَصَبُ",102,"ب",1,0],["وَكَذاكَ كُلُّ نَفيسِ دُرٍّ لَم يَزَل","مِن دونِهِ لِلخَزنِ بابٌ مُغلَقُ",103,"ق",1,0],["وَكَذاكَ ما نُسِبَت إِلَيكَ رَذيلَةٌ","إِلّا مُدِحتَ بِها وَكانَ لَها الهِجا",104,"ج",2,0],["وَكَذاكَ ما نُسِبَت إِلَيكَ فَضيلَةٌ","إِلّا وَقَد مُدِحَت وَكانَ لَكَ الهِجا",104,"ج",2,0],["وَكَذاكَ ما عَشِقَت خَلائِقُكَ العُلى","إِلّا وَلِلأَموالِ قَلبُكَ قالي",105,"ي",1,0],["وَكَذا سَميعُ العَتبِ في حالِ الرِضى","يُغضي لَهُ وَإِذا تَحَرَّفَ حَرَّفا",106,"ف",2,0],["وَكَذاكَ مِن مَرَضِ الجُفونِ بَلِيَّتي","وَإِذا مَرِضتُ فَإِنَّها تَشفيني",107,"ن",2,0],["وَكَذا في دِمَشقَ لَولاكَ ما أَو","رَدتُ خَيلي بِها عَلى بانِياسِ",108,"س",1,0],["وَكَذا اِقتَفَيتَ مِنَ القَوافي إِثرَها","فَأَطاعَكَ المَقصورُ وَالمَهموزُ",109,"ز",1,0],["وَكَذالِكَ لا أَنفَكُّ أُلقِيَ مِقوَدي","طَوعَ الهَوى وَأَعَفُّ عِندَ تَمَكُّني",110,"ي",1,0],["وَكَذاكَ في خَمسٍ وَعِشرينَ اِنثَنى","نَسطورُ مِنكَ وَقَلبُهُ مَلآنُ",111,"ن",1,0],["وَكَذاكَ خَيرُ المُرسَلينَ مُحَمَّدٌ","وَهُوَ الَّذي في حُكمِهِ لا يَظلِمُ",112,"م",1,0],["وَكَذا فَتى الخَطّابِ قادَ بِلَطمَةٍ","مَلِكاً لِغَسّانٍ أَبوهُ الأَيهَمُ",112,"م",1,0],["وَكَذاكَ ما وَصَلَت فَقُلتُ لَها اِقطَعي","يَوماً وَلا قَطَعَت فَقُلتُ لَها صِلي",113,"ي",1,0],["وكذاكَ أنتِ فكم جمالٍ مختفٍ","في النفسِ موصولٍ بآخرَ ظاهرِ",114,"ر",1,0],["وكذا تمرُّ بمثلكِ الأيامُ","مجهولةً وعذابُهَا مجهولُ",115,"ل",1,0],["وكذا الحياةُ تملُّ إن هي أقفرت","ممن يهوّن عِبئها المحمولا",116,"ل",2,0],["وَكَذاكَ مَن قَصَدَ اللِئامَ بِعاجِلٍ","في المَدحِ سُوِّدَ وَجهُهُ في الآجِلِ",117,"ل",1,0],["وَكَذا اللَئيمُ يَقولُ إِن نَأَتِ النَوى","بِعَدُوِّهِ وَيَحولُ ساعَةَ يُصدَقُ",118,"ق",1,0],["وَكَذا المَنايا ما يَطَأنَ بِمَيسَمٍ","إِلّا عَلى أَعناقِ أَهلِ السُؤدَدِ",119,"د",1,0],["وَكَذاكَ لَم تُفرِط كَآبَةُ عاطِلٍ","حَتّى يُجاوِرَها الزَمانُ بِحالي",120,"ل",2,0],["وَكَذاكَ ما تَنجَرُّ أَذيالُ الوَغى","إِلّا غَداةَ تَشَمُّرِ الأَذيالِ",120,"ل",1,0],["وَكَذا السَحائِبُ قَلَّما تَدعو إِلى","مَعروفِها الرُوّادُ إِن لَم تَبرُقِ",121,"ق",1,0],["وَكَذاكَ أَهلُ النارِ في الدُنيا هُمُ","يَومَ القِيامَةِ جُلُّ أَهلِ النارِ",122,"ر",1,0],["وَكَذاكَ القُلوبُ في كُلِّ بُؤسٍ","وَنَعيمٍ طَلائِعُ الأَجسادِ",123,"د",1,0],["وَكَذاكَ كانوا لا يَحِشّونَ الوَغا","إِلّا إِذا عَرَفوا طَريقَ المَهرَبِ",124,"ب",1,0],["وَكَذاكَ عَتّابُ بنُ سَعدٍ أَصبَحوا","وَهُمُ زِمامُ زَمانِنا المُتَقَلِّبِ",125,"ب",1,0],["وَكَذا اللَّئِيمُ إِذَا أَصَابَ كَرَامَةً","عَادَى الصَّدِيقَ وَمَالَ بِالإِخْوَانِ",126,"ن",1,0],["وَكَذَلِكَ الأَرْوَاحُ يَظْهَرُ فِعْلُهَا","وَيَغِيبُ عَنَّا سِرُّهَا الْفَعَّالُ",127,"ل",1,0],["وكذا الفاضلُ مثلي","عندَ قسمِ الرزقِ فاضلْ",128,"ل",1,0],["وكذا الوردُ منَ الشوكِ وما","ينبتُ النرجسُ إلا منْ بصلْ",129,"ل",1,0],["وَكَذا البَحر خاشع مُستكين","وَهُوَ يُكسى مِن كُل لَون شالا",130,"ل",2,0],["وَكَذاكَ الزَمانُ يَطرُدُ بِالنا","سِ إِلى اليَومِ يَومُهُ وَغَدُه",131,"د",2,0],["وكذا الحبُّ ضُحْكَةٌ وبكاءٌ","وكذا الدهر أُلفةٌ وشَتات",132,"ت",1,0],["وَكَذاكَ نِعمَ السوقُ أَنتَ لِمَن","كَسَدَت عَلَيهِ تِجارَةُ الشِعرِ",133,"ر",1,0],["وَكَذاكَ عَكٌّ لا تَزالُ سُيوفُها","تَنهَلُّ مِن مُهَجِ الكُماةِ ظُباها",134,"ا",3,0],["وكذا فعلي بقمري","أبداً كي لا أُلاما",135,"م",2,0],["وَكَذَّبتُ طَرفي عَنكِ وَالطَرفُ صادِقٌ","وَأَسمَعتُ أُذني فيكِ مَا لَيسَ تَسمَعُ",136,"ع",1,1],["وَكَذاكِ مِن وادي وَفائِهِمُ","أَصبَحتُ مُجتَنِحاً عَلى سَفرِ",137,"ر",1,0],["وَكَذاكَ الجَديدُ يَبلى عَلى الدَه","رِ وَلا بُدَّ لاِمرِئٍ مِن عَشيرِ",138,"ر",1,0],["وَكَذاكَ عَبدُ السوءِ يَشتُمُ رَبَّهُ","سَفَهاً وَلَكِن هَل تُجابُ الأَعبُدُ",139,"د",1,0],["وَكَذاكَ كانَ أَبوكَ يُؤثَرُ بِالهُنى","وَيَظَلُّ في لَقطِ النَوى يَتَرَدَّدُ",139,"د",1,0],["وَكَذاكَ مَن صَحِبَ الحَوادِثَ لَم تَزَل","تَأتي عَلَيهِ سَلامَةٌ وَنُكوبُ",140,"ب",1,0],["وَكَذاكَ الدَهرُ صَعبٌ","بَينَ خَفضٍ وَرُكوبِ",141,"ب",1,0],["وَكَذاكَ دَهرُكَ لِلمُحِب","بِ يَروحُ إِذ لَم يَغدُ شَغبُه",142,"ب",2,0],["وَكَذاكَ المُحِبُّ يَل","قى بِذِكرِ الحَبائِبِ",143,"ب",1,0],["وَكَذاكَ يُدعى طاهِراً مَن كُلُّهُ","نَجسٌ وَيُفقَدُ في الأَنامِ الطاهِرُ",144,"ر",1,0],["وَكَذاكَ أَحكامُ الزَمانِ وَإِنَّما","ثَوبُ الحَياةِ وَما يَضُمُّ مَعارُ",145,"ر",1,0],["وَكَذاكَ عامٌ بَعدَهُ","وَغَفَلتَ عَن عُمرٍ يَمُرُّ",146,"ر",1,0],["وَكَذاكَ النُعمانُ زالَ نَعيمٌ","عَن ذَراهُ وَالعَودُ رَهنٌ بِحَسرِ",147,"ر",1,0],["وَكَذاكَ ما عَنّاهُمُ حَتّى رَأوا","شَجَراً بِها ثَمَرُ النَدامَةِ نائِسُ",148,"س",1,0],["وَكَذا الجَمرُ مِثلُهُ الرَجمُ قَد مِيَ","زَ بِلَفظٍ مُغَيَّرٍ مَعكوسِ",149,"س",1,0],["وَكَذاكَ حُكمُ الدَهرِ في سُكّانِهِ","عَيرٌ لَهُ أُذُنٌ وَهَيقٌ أَصلَمُ",150,"م",1,0],["وكذاكَ الخليلُ قَلّبَ قبلي","طَرْفَهُ حين راقبَ الأفلاكا",151,"ك",2,0],["وكذاك الإنسان يمضي من الدن","يا وتبقى في نفسه حاجات",152,"ت",1,0],["وكذاك أيام الحيا","ة فإنها بيضٌ وسود",153,"د",1,0],["وَكَذاك أَحسب كل نج","مٍ جوهراً للكون فردا",154,"د",2,0],["وكذا تمضي حياتي كلُّهَا","بين يأسٍ ورجاءٍ وظنون",155,"ن",1,0],["وَكَذَّبَ اللَهُ أَقوالاً قُرِفتَ بِها","بِحُجَّةٍ تُسرَجُ الدُنيا بِواضِحِها",156,"ح",3,0],["وكذا تطلع البدور علينا","وكذا تفلق البحور العظام",157,"م",1,0],["وَكَذاكَ الأَوطانُ مَهما تَجَنَّت","لَيسَ لِلحُرِّ عَن حِماها مَسيرُ",158,"ر",1,0],["وَكَذا سِباعُ البَرِّ لَولا شَرُّها","دارَت بِها في الغابِ غِربانُ الفَلا",159,"ل",2,0],["وَكَذا عُروَةٌ وَمَيسَرَةٌ حا","مي حِمانا عِندَ اِصطِدامِ الجِيادِ",160,"د",1,0],["وكَذاكَ الدَّهرُ يَرمي بالفَتَى","في طلابِ العَيشِ حالاً بَعدَ حال",161,"ل",1,0],["وَكَذَلِكَ الأَيَّامُ آخِرُهَا","بَعْدَ الشَّبَابِ الضَّعْفُ وَالْخَرَفُ",162,"ف",1,0],["وَكَذاكَ السُّلْطَانُ إِنْ ظَنَّ بِالأُمْ","مَةِ عَجْزَاً سَطَا عَلَيْهَا وَشَدَّا",163,"د",2,0],["وَكَذَا الْحَقِيقَةُ جِدُّهَا وَمِزَاحُهَا","سِيَّانِ في الإِشْقَاءِ وَالإِفْنَاءِ",164,"ا",2,0],["وَكَذَا التَّضَامُنُ بَيْنَنَا","لا تَحْصُرُ الدُّنْيَا حُدُودَهْ",165,"د",2,0],["وَكذاكَ يَزْكُو كُلمَا طَالَ الْمَدَى","بَيْنَ الأَحِبةِ كُلِّ حُبٍّ طَاهِرِ",166,"ر",1,0],["وَكَذَاكَ مَجْدُ العَبْقَرِيَّةِ والفِدَى","لاَ ينْقَضِي بِتَحَوُّلِ الأَحْوَالِ",167,"ل",1,0],["وَكذاكَ تَجْزِي مِصْرُ فَادِيَهَا","وَكَذَاكَ يُحْسِنُ شَعْبُهَا الشكْرَا",168,"ر",2,0],["وَكَذَاكَ كُنْتَ مَدَى الْحَيَاةِ إِذَا","عَبَسَتْ بِكَ الأَيَّامُ مُفْتَرَّا",168,"ر",2,0],["وَكَذا الدَهرُ صَلاحٌ","لِلفَتى ثُمَّ فَسادُ",169,"د",1,0],["وَكَذا صَرفُ الزَمانِ إِذا","حَلَّ أَمراً لِلفَتى فَتَلا",170,"ل",2,0],["وَكَذاكَ الحَليمُ يثبتُ في الجل","لَى إِذا زَلَّ الجاهِلُ المُتَنَزِّ",171,"ز",1,0],["وَكَذَا فِي هديتي لي شبه","حَيْثُ أَنِّي وَتلك قِطْعَة لحم",172,"م",1,0],["وكذا السيوف ملثمة أنواؤها","والشمس في جدي وفي سرطان",173,"ن",1,0],["وكذبت طرفي عنك والطرف صادق","وأسمعت أذني فيك وهي ما ليس تسمع",174,"ع",1,1],["وكذاك الْمُحِبُّ يَلْقَ","قى بذكرِ الحبائبِ",175,"ب",1,0],["وكذلكَ وصل الغانيات فإنه","آل ببلقعة ٍ وبرق خلب",176,"ب",1,0],["وكذا الطبيعةُ في عناصرها","جِنٌّ حَبيسُ الرُّوحِ مجهَده!",177,"د",2,0],["وكذاك كلُّ \" مخرّبٍ \" لرذيلة","بانٍ ، وكلُّ \" مُعَمِّرٍ \" هدّام",178,"م",1,0],["وكذاك أنتِ وقد تمخَّضَ نقمةً","تتمخضِّينَ على القَنا المَشبوك",179,"ك",1,0],["وكذا الدهرُ على عاداتِه","إن صَفَا حِِينَ نبا والتاث حين",180,"ن",1,0],["وكذاكَ المرعى الخصيبُ يُحلّيه","إلى الناظرينَ مرعىً جديب",181,"ب",1,0],["وكذا السياسةُ في التقاضي عندَه","تسليمُ فاضلهِ الى مفضوله",182,"ل",2,0],["وكذاكَ كنتُ وما أزالُ كما بنى","أهلي أُجازي بالجميلِ جميلا",183,"ل",2,0],["وَكَذَا أَشْتَهِي يَكُونُ فَتَى الهِمَّةِ","غَيْرَ الْخُمَيِّم الْمَأْفُوكِ",184,"ك",1,0],["وكذلك الهوى إذا حلّ في الأرواح","سارت في موكب من رؤاها",185,"ا",3,0],["وكذا شِربُ العيش فيه تلونٌ","بيناهُ عذبٌ إذ تحوّلَ آسِنا",186,"ن",2,0],["وكذا النيروزُ رُدَّ عليه","بك شرخُ الشباب ذي الريعان",187,"ن",1,0],["وَكَذَاكَ السُّلْطَانُ إِنْ ظَنَّ بِالأُمَّ","ة ِ عَجزاً سَطا عليهَا وشدَّا",188,"د",2,0]]}