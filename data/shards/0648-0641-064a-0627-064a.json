لمتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62480","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59189","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60970","الطويل"],[2599,"","https://poetry.dctabudhabi.ae/diwan/poem/142615","الخفيف"],[3438,"","https://poetry.dctabudhabi.ae/diwan/poem/111559","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62855","المتقارب"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141892","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123511","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83162","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72526","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4680,"غدا سيدور الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=189978",""],[4717,"هبي كل عشقٍ في سواك قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=199573",""],[4726,"مآل كل امرءٍ للموت والعطب","https://www.poetsgate.com/ViewPoem.aspx?id=146654",""],[4755,"دَعِينِي _ وصنعاءُ تَحتَ الحِصارْ _","https://www.poetsgate.com/ViewPoem.aspx?id=184228",""],[585,"بربك يا دسيسة خبرينا","https://www.poetsgate.com/ViewPoem.aspx?id=161869",""],[5277,"مناط الحب والسلام","https://www.poetsgate.com/ViewPoem.aspx?id=203323",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5431,"بحبي هل أشفعه؟","https://www.poetsgate.com/ViewPoem.aspx?id=190400",""],[5431,"الكولا وعنترة العبسي!","https://www.poetsgate.com/ViewPoem.aspx?id=215610",""],[5718,"ألائمتى","https://www.poetsgate.com/ViewPoem.aspx?id=213932",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[4629,"فُؤادٌ بِهِ شَمسُ المَحَبَّةِ طالِعُ","https://diwany.org/%D9%81%D9%8F%D8%A4%D8%A7%D8%AF%D9%8C-%D8%A8%D9%90%D9%87%D9%90-%D8%B4%D9%8E%D9%85%D8%B3%D9%8F-%D8%A7%D9%84%D9%85%D9%8E%D8%AD%D9%8E%D8%A8%D9%91%D9%8E%D8%A9%D9%90-%D8%B7%D8%A7%D9%84%D9%90%D8%B9%D9%8F/%D8%A7%D9%84%D9%82%D8%B7%D8%A8-%D8%A7%D9%84%D8%AC%D9%8A%D9%84%D9%8A/","الطويل"]],"verses":[["وفي أيِّ عَصْرِ الجاهِليّةِ لمْ يَسُدْ","لكُمْ سَرَواتِ العُرْبِ مَن أمرُهُ الأمْرُ",0,"ر",1,0],["وَفي أَيِّ يَومٍ فاضِحٍ لَم تُقَرَّنوا","أُسارى كَتَقرينِ البِكارِ المَقاحِمِ",1,"م",1,0],["وَفي أَيِّ يَومٍ لَم تُساقوا غَنيمَةً","وَجارُكُمُ فَقعٌ يُحالِفُ قَرقَرا",2,"ر",2,0],["وَفي أَيِّ يَومٍ لَم تُسَلَّل سُيوفُنا","فَنَعلو بِها هامَ الجَبابِرِ مِن عَلِ",3,"ل",1,0],["وفي أيامِ هاتٍ بهاءِ نُلفى","إذا زرم الندى مُتَحلِّينا",4,"ن",2,0],["وَفي أَيَّامِ هاتِ بِ هاكَ يَلقَى","إِذا رزم الندى مُتَحَلِّبِينَا",5,"ن",2,0],["وفي أيّ دِينِ الوَحيِ والمُصْطَفَى لَهُ","سَقَوْا آلَهُ ممزوجَ صابٍ بعَلقَم",6,"م",1,0],["وَفِي أَيِّ فَنٍّ مِنْ فُنُونِ جَمَالِهَا","تَعَايَى عَلَيْكَ النَّظْمُ أَوْفَاتَكَ النَّثْر",7,"ر",1,0],["وَفِي أَيْمَانِنَا بِيضٌ خِفَافٌ","بِهَا نَشْفِي مِرَاحَ الشّاغِبِينا",8,"ن",2,0],["وفي أيِّ أطواء القُرونِ تنقَّتْ","بمصباحِكَ الدنيا يَشُبُّ ويسطَع",9,"ع",1,0],["وفي أي شعب ، تمدّ الذئاب","حلاقمها ، من وراء الحذر",10,"ر",1,0],["وفي آية القربى وفي هل أتى أتى","لمجدهم شأن سما في الورى ذكرا",11,"ر",2,0],["وَفي أَيِّ يَومٍ شَهِدتَ الوَغى","وَما عُدتَ تَسحَبُ ذَيلَ الظَفَر",12,"ر",1,0],["وفي أي درس لم يعد دارس الهدى","كما كان مأهولا وقد صار بلقعا",13,"ع",2,0],["وَفِي أَيِّ خَطْبٍ لَمْ تَكُنْ قاضِبَ الشَّبا","وَفِي أَيِّ فَضْلٍ لَمْ تَكُنْ ثاقِبَ الزَّنْدِ",14,"د",1,0],["وَفي أَيِّ مَأْمُولٍ يَصِحُّ لآمِلٍ","رَجاءٌ إذا ما اعْتَلَّ فِيكَ رَجائِي",15,"ي",1,0],["وفي أيِّ وقتٍ كانَ ذا وقت ما جَرى","فجارَت عَلى حالي نَوائبُ أزمُني",16,"ن",2,0],["وَفي أَيِّ يَومٍ لَم يَكن شَمسَ يَومِهِ","إِذا قيلَ هذا يومُ تُقضى المَآرِبُ",17,"ب",1,0],["وفي أيّما حكمٍ تظنّون زَلَّةً","فيظهرُ من تأديبكم إن حَرمتُمُ",18,"م",1,0],["وفي أيمَنِ الوادي تَلوحُ قِبابُهُ","إذْ الشَّوْطُ في تلكَ المَعاهدِ شَرْقِيُّ",19,"ي",1,0],["وفي أي ظل منهما كنت نازلاً","رأيت نزول المكرمات على حكمي",20,"م",2,0],["وفي أيديهمُ أَسَلٌ طِوالٌ","لهَاذِمَةٌ إلى الأَرواح هِيمُ",21,"م",1,0],["وفي أيديهمُ كلُّ","طويلِ المُرتقى صُلبِ",22,"ب",1,0],["وفي أي يوم راح يحمل حاجةً","إلى أحدٍ من جاد بالروح فاديا",23,"ي",2,0],["وفي أي شرع سوى شرعهم","تكون الرياسة للجاهل",24,"ل",1,0],["وفي أي عهد سوى عهدهم","تكون الحكومة للغافل",24,"ل",1,0],["وفي أي القُرى الشواف ولّى","أليس له رسوم باقياتُ",25,"ت",1,0],["وَفِي أيّ حَيٍّ قَدْ أقَامُوا فَإنَّنِي","أرَاهُمْ بِقَلْبِي سَاكِنِينَ وَإنْ صَدُّوا",26,"د",3,0],["وفي آية إذ هم عليها جماعةٌ","قعودٌ ولم تجعلهم النارُ كالحمم",27,"م",1,0],["وفي أيّ ذنبٍ تنكرين معارفي","ومَا خِلتُ معروفَ المودة ينكر",28,"ر",1,0],["وفى أى قبو منك خبأت من مضوا","وأبعدت مثواه فراحوا ولم يأتوا",29,"ت",3,0],["وفى أى يومٍ نلتقى بهمو أجب","فقد هدنا شوق ، وعذبنا كبت",29,"ت",1,0],["وفي أي شيءٍ تنقصه","وقد حل في البيت من حمير",30,"ر",1,0],["وفي أيِّ شيءٍ يكون الشفَاءُ","اذا أَنتَ ضَرَّكَ ما لا يَضُرْ",31,"ر",1,0],["وفي أي علم شئت عن أي مشكل","نبا الفهم عنه سله فهو أمامه",32,"م",2,0],["وفي أيسر اللحظات أسرى بجسمه","الى قاب قرب غيره عنه منقط",33,"ط",1,0],["وَفي أَي طِرسٍ خَطَطتَ فَرَصَّع","تَ ماساً عَلى صَفحاتِ الذَهَب",34,"ب",1,0],["وفي أي المغاني أيها الفاني من الباقي","متى ما تلق من تهوى دع الدنيا وأهملها",35,"ه",2,0],["وَفي أَينَما حَقّا تُوَلّوا وجوهَكُم","فَثَمَّةَ وَجهُ اللَهِ هَل مَن يُطالِعُ",36,"ع",1,0],["وفي أي دارٍ من ديارك تحتمي","وها أنت في مهد الرسالات تُقمعُ",37,"ع",1,0],["وفِي أيِّ شَرْعٍ تستحلُّ مدامعي","ألستَ ترى ما في الحشا فتميلا",38,"ل",2,0],["وفي اياب بدار اللد عاجلهُ","موت وفي سوحها قد حل في الرتب",39,"ب",1,0],["وفي أيِّ صَدرٍ سَأُلقي برأسِي","وكُلُّ الصّدورِ انتِظارُ انفِجارْ!",40,"ر",1,0],["وفي أي الكهوف وأي ليلٍ","ضرير النجم أقتم نجثمينا",41,"ن",2,0],["وفي آياتِ ربي كلُّ خيرٍ","بهنَّ الناسُ بالهديِ استقاموا",42,"م",3,0],["وفي ائتلاف المعاني والوزان تلا","رتب الهدى عمر الفاروق ذو الشيم",43,"م",1,0],["وفي ايقاعه شجنٌ","فهل قلبي سيتبعه؟",44,"ع",2,0],["وفي أيّ (---ٍ) بعد رقصك حوله","تغور عميقا في المتاهة تُقبرُ؟!!!",45,"ر",1,0],["وفي أَيِّ ظِلٍّ تَسْتَرِيحُ نُفُوسُنَا؟","عَلَي أَيِّ جَنْبٍ نَسْتَقِرُّ ونَهْجَعُ؟",46,"ع",1,0],["وفي أي شرعٍ إن من شاءَ مِنكُمُ","يغيرُ على مال الخليلِ ويسلُبُ",47,"ب",1,0],["وفي أي وقت بعد طول هجوعها","بجامعة الموتى ترينا انتشارها",48,"ر",3,0],["وَفي أَينَما حَقّا تُوَلّوا وجوهَكُم","فَثَمَّةَ وَجهُ اللَهِ هَل مَن",49,"ن",1,0]]}