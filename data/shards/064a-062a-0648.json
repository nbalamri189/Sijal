لنفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[5285,"سأشكو إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=203540",""],[5370,"البريء","https://www.poetsgate.com/ViewPoem.aspx?id=86526",""],[5413,"فبدأتُ حيثُ توقفواْ","https://www.poetsgate.com/ViewPoem.aspx?id=200584",""],[5452,"ضفاف الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=110945",""],[5512,"ملائكة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=204346",""],[5616,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=203430",""],[5770,"يا جيرةَ الحرمِ المكيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=178684",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""],[5956,"حسبي ذكاؤك سابراً لحقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=193504",""],[5956,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=194844",""],[5969,"رَمتني بدائها وانسلت","https://www.poetsgate.com/ViewPoem.aspx?id=199036",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""],[658,"لَوَّمتَهُ وَعَنَفتَ في تَعنيفِه","https://www.poetsgate.com/ViewPoem.aspx?id=45927",""],[6228,"فيض الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85976&r=&rc=13",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""],[6346,"أغالب قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83393&r=&rc=9",""]],"verses":[["يَتَواكَلونَ المَوتَ جُبناً بَعدَما","كانوا أُسودَ مَغاوِرٍ أَبطالا",0,"ل",2,0],["يَتَواقَعونَ عَلى الرَدى وَصُفوفُهُم","رَغمَ الوُثوبِ كَثابِتِ البُنيانِ",1,"ن",1,0],["يتواضع العلماءُ فيها هيبةً","لأعزّ ممدوح الفعال سديدها",2,"د",3,0],["يتواعدُ الأيامَ منك بجحفلٍ","ينفي الأوابدَ هدَّةً وصهيلا",3,"ل",2,0],["يتوخّى من ذاك أن يشركوه","من حُلى المجدِ في الذي هو حالِ",4,"ل",1,0],["يَتَوَسَّلونَ إِلى الظَلومِ وَطالَما","كانَ الظَلومُ إِلَيهِم يَتَوَسَّلُ",5,"ل",1,0],["يتوسد الميت الثرى ولو انه","منح الخيار ابى ولم يتوسد",6,"د",1,0],["يتوب عليك من منفاك فيها","أناس منك أولى بالمتاب",7,"ب",1,0],["يَتَوَجَّهُ العاني إِلى رَحَماتِها","وَيَرى بِها بَرقَ الرَجاءِ عَليلُ",8,"ل",1,0],["يَتَوَهَّجونَ وَيَطفَأونَ كَأَنَّهُم","سُرُجٌ بِمُعتَرَكِ الرِياحِ الأَربَعِ",9,"ع",1,0],["يَتَوَلّى البِحارَ مَهما اِدلَهَمَّت","مِنكَ في كُلِّ جانِبٍ لَألاءُ",10,"ا",2,0],["يتوقَّف القدَرُ المُتاحُ عنِ الذي","لا يشتهي فإِذا أشار به جرَى",11,"ر",2,0],["يتوقُ إليه المُلكُ وهو لهُ ابْنُمٌ","ويحنو عليه التاجُ وهو لهُ أخُ",12,"خ",1,0],["يَتَوَقَّدنَ وَالكَواكِبُ مُطفا","ةٌ وَيَقطَعنَ وَالسُيوفُ نَوابي",13,"ب",2,0],["يَتَوَلّى النَبِيُّ ما تَتَوَلّا","هُ وَيَرضى مِن سيرَةٍ ما يَسيرُ",14,"ر",1,0],["يَتَوَخّى الإِحسانَ قَولاً وَفِعلاً","وَيُطيعُ الإِلَهُ بَسطاً وَقَبضا",15,"ض",2,0],["يَتَوَلّى دونَ خَفّاقِ الحَشا","صَدمَةَ الراياتِ زوراً تَختَفِق",16,"ق",1,0],["يُتَوِّجُها اصفرارُ الشمسِ تِبراً","فَتُمْسِي وَهيَ مُذْهَبةٌ ذُراها",17,"ا",3,0],["يُتوِّجُ بالكأسِ كَفَّ النَّديمِ","إذا نَظَمَ الماءُ تِيجانَها",18,"ن",3,0],["يَتَوالىَ الصَّوتُ منه والصَّدَى","إنّ هذا الكونَ لم يُخلَقْ سُدَى",19,"د",2,0],["يَتَوَعَّدونَ ذَوي الحُقوقِ كَأَنَّما","أَمِنوا حُماةَ الحَقِّ مِن أَجنادِهِ",20,"د",2,0],["يتوسّطُ الجرحَى تَسيلُ دماؤُهم","فوقَ الحصَى من خَلفِهِ وأمامِهِ",21,"م",2,0],["يَتُوقُ فَيَثنيهِ عَلِيٌّ مُقَوَّمٌ","نَما فَرعُهُ وَاخضَلَّ حَتّى تَخَضَّدا",22,"د",2,0],["يَتوبُ لِسانُهُ عَنْ كلِّ ذَنْبٍ","وَلم يَرَ قلبهُ منه يَتُوبُ",23,"ب",1,0],["يَتَواصونَ بِقَتلي بَينَهُم","مُقبِلي نَحويَ أَطرافَ الأَسل",24,"ل",1,0],["يتوقّاهُ ناظراي كأنِّي","فيه ألقى آلامَ عمري جميعا",25,"ع",2,0],["يتوهجون صبابةً وصِبا","يتمثَّلونَ غريبَ أزياءِ",26,"ا",2,0],["يَتَوَهَّجْنَ بالشبا","بِ ويَندينَ بالخفَرْ",27,"ر",1,0],["يُتَوَسَّمُ الإِخْلاَصُ فِي أَعْمَالِهِ","حَتَّى لَيُوشِكَ أَنْ يَشِفَّ حِجَابَا",28,"ب",2,0],["يَتَوَخّى قَيْدَ الأَوَابِدِ فِي بَا","بٍ َبَابٍ مِنْهُ وَجَمْعِ الشَّتَاتِ",29,"ت",1,0],["يَتَوخَّى قَوْلَهَا فِي حَقِّهِ","إِنَّهُ أَصْبَحَ فِي التَّمْثِيلِ نِحْرَا",30,"ر",2,0],["يتَوَارَثُونَ الْحَمْدَ أَجْدَرَ مَا","كَانتْ مَسَاعِيهِم بِإِحْمادِ",31,"د",1,0],["يَتَوَقَّعْنَ آيَةَ الآيَاتِ","وَالرُّبَى فِي مُسُوحِهِنَّ سَوَاجِدْ",32,"د",1,0],["يتوقد النجم السنى برأسها","فترى بوادر دمعها المترقرق",33,"ق",1,0],["يتولَّى مرضاهُ بالعطف حتى","ليخالون عطفه «بنسلينا»",34,"ن",2,0],["يتوارث الأمجاد عن","أصلين: عن عمٍّ، وخال",35,"ل",1,0],["يتوقّاه ناظري كأنّي","فيه ألقى آلام عمري جميعا",36,"ع",2,0],["يَتَوَلّى النّبيُّ مَا تَتَوَلاّ هُ،","وَيَرْضَى من سَيرِهِ ما تَسيرُ",37,"ر",1,0],["يتوارث المجدَ التليدَ بمعشر","أدنَتْ فروعَهمُ إليه أُصولُ",38,"ل",1,0],["يتوارى عن العيونِ وإن لم","يكُ عن كاتبيهِ بالمتواري",39,"ر",2,0],["يَتَوالونَ نِظاماً","كَأَنابيبِ الرِماحِ",40,"ح",1,0],["يَتَوسَل المتوسلون بجاهه","فيرد عنهم كل خطب أَنكد",41,"د",1,0],["يَتَوَلّونَ خِدمَتي بِنَشاطٍ","فَقِيامي في نَفعِهِم بِنَشاطِ",42,"ط",1,0],["يتوِّج رأسَه إكليلُ شوكٍ","أسنَّتُه أحدُّ من النبال",43,"ل",1,0],["يتوب توبة صدق لا انتكاث لها","يمحي بها سائر الأوزار والزلل",44,"ل",1,0],["يتواضع المتجبِّرونَ، إذ","صاموك حقّاً، يَذْهبُ الكِبْرُ",45,"ر",1,0],["يتوق إلى البيت العتيق وطيبه","ويعجز عن قطع المفاوز والبحر",46,"ر",1,0],["يتوالى مُنْعِماً إحْسانَه","وأَجلُّ الغيث ما جاءَك تالي",47,"ل",2,0],["يتوِّجها الحباب بتاج كسرى","إذا مزجت ويلبسها سوارا",48,"ر",2,0],["يتورّدون الخطبَ وهو مهالكٌ","ويبادرون الحربَ وهي فناءُ",49,"ا",2,0],["يُتَوِّجُها بالنَّقْعِ نَظْمُكَ حولَها","مجالَ عُقُودٍ من خيولٍ وأَبطالِ",50,"ل",1,0],["يتولّى النِّدام عيسى بن دأبٍ","بكؤوسٍ من الحديث مُداره",51,"ر",2,0],["يتوالى الإشعاع منه على الرغم","من اليأس واحتشاد الظلام",52,"م",1,0],["يتوارثون به العلاءَ فسابقٌ","يمضي وقافٍ إثرَهُ متقصِّصا",53,"ص",2,0],["يتواصَوْن بالمعالي فيقتا","فُ الفتى الحيُّ منهم المقبورا",54,"ر",2,0],["يتوبُ إذا هفا غَلَطاً بجودٍ","ولم يتُب اتقاءً للمَعادِ",55,"د",1,0],["يتوارثون مَارماً مُضَريَّةً","إرثَ النّبوةِ في بني يعقوبِ",56,"ب",1,0],["يتوهمُ الحسكاتِ منه ذواعراً","فرط الحذار فإنْ مشى لم يعْجلِ",57,"ل",1,0],["يتوجعان ولا مغي","ث