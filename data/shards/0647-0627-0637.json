{"poems":[[182,"صنوَ الروح","https://www.aldiwan.net/poem50712.html","الرمل"],[466,"عشت قطب الدين هطال الندى","https://www.aldiwan.net/poem16432.html","الرمل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119254","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126226","الخفيف"],[182,"صنو روحي","https://www.poetsgate.com/ViewPoem.aspx?id=72810",""],[5640,"شامية","https://www.poetsgate.com/ViewPoem.aspx?id=206110",""]],"verses":[["هاطِلُ السّعدِ طِلالاً خَصّني","مِنْ شَهيّاتِ النّدى في الدِّيَمِ",0,"م",1,0],["هاطِلَ الكَفَّينِ سَلْماً ووَغىً","حيثُما كُنتَ نَوالاً ودَما",1,"م",2,0],["هاطل هائل هموس هجان","هاتم هاثم هزير هباء",2,"ا",2,0],["هاطِلُ الدَمعِ حَسبُنَا من سُكُوبِ","ليسَ بالخَوفِ والبُكَا مُصطَفَاهُ",3,"ا",2,0],["هاطل السّعدِ طِلالاً حفني","مذ حبيبي صنوَ روحي عادَني",4,"ن",2,0],["ها طالِبي...أَرَضيتَ مَهْري يا تُرى ؟","أمْ أنّ بابَ الردِّ عنْدَكَ مُقْفلُ؟",5,"ل",1,0]]}