ttps://www.poetsgate.com/ViewPoem.aspx?id=30136",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[6124,"وريد","https://www.poetsgate.com/ViewPoem.aspx?id=120026",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6168,"أَاَلْيَوْمَ بانَ الحَيُّ أَمْ وَاعَدُوا غَدَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7542&r=&rc=12",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""]],"verses":[["فَلِبَاسُ بَأْسِكَ رَاعَ أَفْئِدَةَ الْعِدَى","وَوُجُودُ جُودِكَ أَعْدَمَ الإِعْدَامَا",0,"م",2,0],["فَلِبَيتِكُم فَضلٌ عَلى ال","أَحياءِ أُنثى أَو ذَكَر",1,"ر",1,0],["فَلَبِستِ النَجيعَ مِن عَهدِ قابي","لَ وَشاهَدتِ مَصرَعَ الأَبرِياءِ",2,"ا",2,0],["فَلَبِثتِ فيها قَبلَ نوحٍ حِقبَةً","وَتَداوَلَتكِ أَنامِلُ الآناءِ",3,"ا",2,0],["فلبعض الأنام كان عِصاماً","ولبعض الأنام كان خِصاما",4,"م",2,0],["فَلَبِثتُ أَزماناً طِوالاً فيهِمِ","ثُمَّ اِدَّكَرتُ كَأَنَّني لَم أَفعَلِ",5,"ل",1,0],["فَلَبِئسَ هَديُ الصالِحينَ هُديتُمُ","وَلَبِئسَ فِعلُ الجاهِلِ المُتَعَمِّدِ",6,"د",1,0],["فَلَبِئسَ ما قاتَلتَ يَومَ لَقيتَنا","أَيرٌ تَقَلقَلَ في حِرٍ لَم يُصلَحِ",7,"ح",1,0],["فَلَّ بالحجة الخُصومَ وبالكي","د زُحوفَ العِدا ذوي التأليبِ",8,"ب",1,0],["فَلَبِثنَ حيناً يَعتَلِجنَ بِرَوضَةٍ","فَيَجِدُّ حيناً في العِلاجِ وَيَشمَعُ",9,"ع",1,0],["فَلَبَّثَها الراعي قَليلاً كَلا وَلا","بِلَوذانَ أَو ما حَلَّلَت بِالكَراكِرِ",10,"ر",1,0],["فلَبِثْتُ مرضوضَ الفؤادِ","أَجرُّ أجنحتي بذُعْرِ",11,"ر",1,0],["فَلَبَّتهُ الفَيالِقُ وَالأَرادي","وَدارَ هِلالُ رايَتِنا يَمينا",12,"ا",1,0],["فَلَبَّيتَهُ بِكَ في جَحفَلٍ","لَهُ ضامِنٍ وَبِهِ كافِلِ",13,"ل",1,0],["فَلَبِسْتُ أثوابَ الأسَى","وخلَعْتُ أثوابَ السُّرورِ",14,"ر",1,0],["فَلَبَّةٌ بالنَّابِ مَلبوبةٌ","ومَنكِبٌ بالظِّفْرِ منكوب",15,"ب",1,0],["فَلِباغي عَصاهُ حُمرُ المَنايا","وَلِباغي عَطاهُ بيضُ الأَماني",16,"ن",2,0],["فَلَبُوسُ النارِ فيها سكةٌ","حَكَمَتْ للشَّرْبِ منها بالنّعيم",17,"م",1,0],["فَلَبِّ الحَزمَ إِن حاوَلتَ 