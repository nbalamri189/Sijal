tml","البسيط"],[353,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[357,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[370,"وفر سهامك قد أصبت مقاتلي","https://www.aldiwan.net/poem17935.html","الكامل"],[381,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[381,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[420,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[420,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[433,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[441,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[443,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[443,"غرام ولا شكوى وعتب ولا عتبى","https://www.aldiwan.net/poem34828.html","الطويل"],[443,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[443,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[443,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[443,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[453,"أيزيد حاربت الملوك ولم يكن","https://www.aldiwan.net/poem707.html",""],[455,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[461,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[464,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[467,"عج بالمطي في أظعانها","https://www.aldiwan.net/poem3628.html","عموديه"],[482,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[485,"الدهر أعلى بالتنفيس قد سجعت","https://www.aldiwan.net/poem24291.html","البسيط"],[485,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[503,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[554,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[565,"ألا يا هلالا لاح أبهى من البدر","https://www.aldiwan.net/poem52809.html","الطويل"],[578,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["فَلِبَاسُ بَأْسِكَ رَاعَ أَفْئِدَةَ الْعِدَى","وَوُجُودُ جُودِكَ أَعْدَمَ الإِعْدَامَا",0,"م",2,0],["فَلِبَيتِكُم فَضلٌ عَلى ال","أَحياءِ أُنثى أَو ذَكَر",1,"ر",1,0],["فَلَبِستِ النَجيعَ مِن عَهدِ قابي","لَ وَشاهَدتِ مَصرَعَ الأَبرِياءِ",2,"ا",2,0],["فَلَبِثتِ فيها قَبلَ نوحٍ حِقبَةً","وَتَداوَلَتكِ أَنامِلُ الآناءِ",3,"ا",2,0],["فلبعض الأنام كان عِصاماً","ولبعض الأنام كان خِصاما",4,"م",2,0],["فَلَبِثتُ أَزماناً طِوالاً فيهِمِ","ثُمَّ اِدَّكَرتُ كَأَنَّني لَم أَفعَلِ",5,"ل",1,0],["فَلَبِئسَ هَديُ الصالِحينَ هُديتُمُ","وَلَبِئسَ فِعلُ الجاهِلِ المُتَعَمِّدِ",6,"د",1,0],["فَلَبِئسَ ما قاتَلتَ يَومَ لَقيتَنا","أَيرٌ تَقَلقَلَ في حِرٍ لَم يُصلَحِ",7,"ح",1,0],["فَلَّ بالحجة الخُصومَ وبالكي","د زُحوفَ العِدا ذوي التأليبِ",8,"ب",1,0],["فَلَبِثنَ حيناً يَعتَلِجنَ بِرَوضَةٍ","فَيَجِدُّ حيناً في العِلاجِ وَيَشمَعُ",9,"ع",1,0],["فَلَبَّثَها الراعي قَليلاً كَلا وَلا","بِلَوذانَ أَو ما حَلَّلَت بِالكَراكِرِ",10,"ر",1,0],["فلَبِثْتُ مرضوضَ الفؤادِ","أَجرُّ أجنحتي بذُعْرِ",11,"ر",1,0],["فَلَبَّتهُ الفَيالِقُ وَالأَرادي","وَدارَ هِلالُ رايَتِنا يَمينا",12,"ا",1,0],["فَلَبَّيتَهُ بِكَ في جَحفَلٍ","لَهُ ضامِنٍ وَبِهِ كافِلِ",13,"ل",1,0],["فَلَبِسْتُ أثوابَ الأسَى","وخلَعْتُ أثوابَ السُّرورِ",14,"ر",1,0],["فَلَبَّةٌ بالنَّابِ مَلبوبةٌ","ومَنكِبٌ بالظِّفْرِ منكوب",15,"ب",1,0],["فَلِباغي عَصاهُ حُمرُ المَنايا","وَلِباغي عَطاهُ بيضُ الأَماني",16,"ن",2,0],["فَلَبُوسُ النارِ فيها سكةٌ","حَكَمَتْ للشَّرْبِ منها بالنّعيم",17,"م",1,0],["فَلَبِّ الحَزمَ إِن حاوَلتَ يَوماً","بِأَن تَسطيعَ غَيرَ المُستَطاعِ",18,"ع",1,0],["فَلَبِثْنَا هُنَيْهَةً ثُمَّ لَمَّا","خَفَّ مِنْ سُكْرِهِ وَأَقْبَلَ قُمْنَا",19,"ن",2,0],["فَلَبِثنا بِذاكَ عَشراً تِباعاً","فَقَضَينا دُيونَنا وَاِقتَضَينا",20,"ن",2,0],["فَلَبِثتُ أَرقيها بِما لَو عاقِلٌ","يُرقى بِهِ ما اِسطاعَ أَلّا يَنزِلَ",21,"ل",1,0],["فَلَبِستُ ذَلِكَ مِنكِ بَعدَ جَديدِهِ","ظُلماً لَعَمري كَاللِباسِ العَرمَضِ",22,"ض",1,0],["فَلَبَّيكِ مِن داعٍ لَها وَلَوَ أَنَّني","صَدىً بَينَ أَحجارٍ لَظَلَّ يُجيبُها",23,"ب",3,0],["فَلَبِستُ لِلحَربِ العَوانِ ثِيابَها","وَشَبَبتُ نارَ الحَربِ فَهيَ تَوَقَّدُ",24,"د",1,0],["فَلِبَابِ زَيْنِ الدِّينِ أحمدَ فلْيَسِر","مَنْ كانَ بالأَعْذَار غيرَ مُقَيَّدِ",25,"د",1,0],["فَلَبِئسَ ما كَسَبَ اِبنُ عَمروٍ رَهطَهُ","شَمِرٌ وَكانَ بِمَسمَعٍ وَبِمَنظَرِ",26,"ر",1,0],["فَلُبانَاتي لبَانَاتٍ تَرا","ضُعُنَا فيها لِبَانَ الحُبّ سي",27,"ي",1,0],["فَلِباغٍ عَصاهُ حُمرُ المَنايا","وَلِباغي نَداهُ بيضُ الأَماني",28,"ن",2,0],["فَلَبَّدَهُ مَسُّ القِطَارِ ورَخَّهُ","نِعَاجُ رُؤَافٍ قَبْلَ أَنْ يَتَشَدَّدَا",29,"د",2,0],["فَلَبِئْسَ مَا قَدِمَ الْمَشِيبُ بِهِ","وَلَنِعْمَ مَا وَلَّى بِهِ السَّلَفُ",30,"ف",1,0],["فلبّاه من عُليَا مَعدٍ غضافِرٌ","كماةٌ إذا اشْتدَّ الوغَى شُهداءُ",31,"ا",2,0],["فلباس بأسك راع أفئدة العدا","ووجود جودك أعدم الإعداما",32,"م",2,0],["فلبيكِ من شاء وليُشبعْ محاجرَهُ","ولينتحبْ ما يشاءُ الحزنَ باكينا",33,"ن",2,0],["فلبثنا بذاكَ عشراً تباعاً،","فَقَضَيْنا دُيُونَنَا، وَکقْتَضَيْنَا",34,"ن",2,0],["فَلَبَثْتُ أَرْقِيها بِمَا لَوْ عَاقِلٌ","يُرْقَى بِهِ ما کسْطَاعَ أَلاَ يَنْزِلا",35,"ل",2,0],["فلبيّ وغابت بعده شمس قاسم","وعما قليل نجم مَحياي يغربُ",36,"ب",1,0],["فَلَبّى مُطيعاً لِلإِمامِ وَحَسبُهُ","بِذا مَفخَراً في عُربِها وَالأَعاجِمِ",37,"م",1,0],["فَلَبَّيكَ مِن دَاعٍ دَعا وَلَوَ أَنَّنِى","صَدىً بَينَ أَحجارٍ لَظَلَّ يُجِيبُ",38,"ب",1,0],["فلبستْ لغيرِ ملوكِ الكلام","وبنت الملوك لأكفانها",39,"ا",1,0],["فَلَبَّيْتُ النِّدَاءَ وَكَانَ فَرْضاً","جَوَابُ فَتىً بِهَدْيٍ مُسْتَعِينِ",40,"ن",1,0],["فلباك فيه المخلصون جميعهم","يضيق بهم سهل من الأرض مرحب",41,"ب",1,0],["فلبثتُ أشربُ ريقَها ورَحيقَها","ولديَّ منها مِئزَرٌ ووشاح",42,"ح",1,0],["فلبستُ من دمعِ الخلودِ وشعرهِ","عقداً أعزَّ من النُّجوم ثمينا",43,"ن",2,0],["فَلَبَّيتُ بِالشَكوى قَساوَةَ قَلبِها","إِلى أَن عَرَتها أَنَّةٌ وَخُفوتُ",44,"ت",1,0],["فَلِبُعدِهِ عَنّي وَفَدتُ بِشِقوَةٍ","فَدَنا الشِفاءُ بِهِ وَزالَ شَقاءُ",45,"ا",2,0],["فلبا مسرعاً طوعا","بأبيات بلا نثر",46,"ر",1,0],["فلبى رجال دعوة الحق فاهتدوا","ونالوا المنى في عاجلٍ وأواخر",47,"ر",1,0],["فَلَبِثنا هَنيهَةً ثُمَّ قُمنا","وَاِنصَرَفنا وَالمُلكُ لِلَهِ وَحدَه",48,"د",2,0],["فَلَبَّيتُ داعيها وَأَسرَعتُ نَحوَها","وَجِئتُ صَحابي مِن سِناها بِجَذوَةِ",49,"ه",1,0],["فَلَبّيت حَتّى من مِنىً فُزت بِالمُنى","وَطُفت بِبَيت اللّه مُنشَرح الصَدرِ",50,"ر",1,0],["فَلَبِثتُ مِنها في أَوارِ هَواجِر","ما رُدَّ روحي في ظِلالِ أَصائِلي",51,"ل",2,0],["فلباه على طور التجلي","فأخبر ما رآه من فعال",52,"ل",1,0],["فلبيك مريم ثم لبيك فأمري","فإني مطيعٌ لست يوماً بهارب",53,"ب",1,0],["فلبئس القوم الذين أرادوا","بك من سائر الأنام بديلا",54,"ل",2,0],["فلَبيْتَه لمَّا دعاك ولم تجد","عن السَّير في تلك الإجابة عائقا",55,"ق",2,0],["فلبّته المعالي ثم قالت","سواه لم يكن لي من نصيرِ",56,"ر",1,0],["فلبكر مجدهم الأصيل ومدحهم","تتلوا الملائك بحكرة وأصيلا",57,"ل",2,0],["فلَبِسْتَ ثوبَ سَنائِها ووَفائِها","وحَفِظْتَ عَهْدَ سُيُوفِها ورِماحِها",58,"ح",3,0],["فَلَبَّيْتِهِ سَيْباً ولَبَّيْتُهُ مُنىً","ودِنْتُ لَهُ سلْماً ودِنْتِ لَهُ حَرْبا",59,"ب",2,0],["فَلَبَّيْكَ لا مِنْ بَعيدٍ ولكنْ","عَذيرَكَ من مُعْذِراتِ الحَياءِ",60,"ا",2,0],["فلَبَّاهُ من لَمْ يكُنْ قبلُ خَلْقاً","وأُنشِئَ من بَعْدُ خلقاً جديدا",61,"د",2,0],["فَلَبَّتْكَ مِنْ غَوْرِ الجَلاءِ أَهِلَّةٌ","أَهَلَّ بِهَا مَأْوَاكَ حَتَّى أَهَلَّها",62,"ل",3,0],["فلَبَّيْتَها فانْجَابَ عَنْها ظَلامُهُ","ووافَيْتَها فَاسْتَنْكَرَتْها مَظَالِمُهْ",63,"م",2,0],["فلبيت ذات الحرمات لس بنائل","والأكرمين أبوة وجدودا",64,"د",2,0],["فلبستَ شكراً لا يَجفّ رُوَاؤه","وجميل حمدٍ في الأنام صُراح",65,"ح",1,0],["فلبستَها للصون تسحبُها","ومساحبُ الأذيال للبذلِ",66,"ل",1,0],["فلباقي القوم سوقٌ وحوامٍ","وله الأعناق من هو الهوادي",67,"د",2,0],["فلبست من جسدي أسقامهُ","وعدمتُ من كبدي سوى خفقانها",68,"ن",3,0],["فلبت الدعوة الكبرى جماعته","تسعى مدججة من كل ضرغام",69,"م",1,0],["فلبت الصوت إذ عم الفضاء وما","بالحر سامعة إلا وقد طربت",70,"ت",1,0],["فلباني الحادي ببذل مهورها","اختيارا فقلت لا علي بمهجتي",71,"ت",2,0],["فلبأس طولك بالجلال زلازلٌ","ولفيض برك بالجميل عوائد",72,"د",1,0],["فلبئسما منّتْه منِّي خالياً","خطراتُه أو سوّلتْ أحلامُهُ",73,"م",2,0],["فلبَّاه صافي العيشِ لم تدْنُ غُصَّةٌ","إليهِ ولم يُردَدْ إلى أرذَلِ العُمرِ",74,"ر",1,0],["فَلِبَسْنَا مِنْه الجديدُ وما يخ","لَع عَنَّا الخليعَ إِلاَّ جَدِيدُه",75,"د",2,0]]}