,[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52166","الخفيف"],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5277,"لا إله إلا الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=206289",""],[5431,"لايضيعُ العُرْفُ..أنتم أهله","https://www.poetsgate.com/ViewPoem.aspx?id=185842",""],[5720,"الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=203978",""],[402,"يا عيونا تسقي العيون الرحيقا","https://www.poetsgate.com/ViewPoem.aspx?id=36024",""],[5964,"رب ليل كالبحر هولاً","https://www.poetsgate.com/ViewPoem.aspx?id=181302",""],[5001,"أيها الساري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80724&r=&rc=14",""]],"verses":[["رُبَّ لَيْلٍ بالصُّبْحِ مِنْ","وَجْهِ ليلى تَوَشَّحا",0,"ح",2,1],["رُبَّ لَيلٍ قَد سَهِرتُه","رُبَّ دَمعٍ قَد أَفَضتُه",1,"ت",2,1],["رُبَّ لَيلٍ في الدَهرِ قَد ضَمَّ نَحساً","وَسُعوداً وَعُسرَةً وَيَسارا",2,"ر",2,0],["رُبَّ لَيلٍ قَد تَعاهَدنا عَلى","ما تَعاهَدنا وَكُنّا فاعِلين",3,"ن",1,0],["رَبلاً وَأَرطى نَفَت عَنهُ ذَوائِبُهُ","كواكبُ القَيظِ حَتّى ماتَتِ الشُهُبُ",4,"ب",1,0],["ربّ ليل بالوصل كان ضياءً","ونهارٍ بالهجر كان ظلاما",5,"م",2,0],["رُبَّ لَهوٍ شَهِدتُهُ أُمَّ عَمروٍ","بَينَ بيضٍ نَواعِمٍ في الرِياطِ",6,"ط",1,0],["ربّ ليلٍ زارَ فيه قمرٌ","خدّه المحمرّ بالأقمار شامت",7,"ت",1,1],["ربّ ليالٍ لو بلغت المنى","فديتها من ناظري بالسواد",8,"د",1,0],["ربَّ ليلٍ ترى المجرَّة فيه","ذات خطٍّ ينضي العيون دقيق",9,"ق",1,1],["ربَّ ليلٍ قد همت فيه بظبيٍ","قربه لي أشهى من التَّهويم",10,"م",1,0],["ربَّ ليلٍ قد خضته لك بحراً","متعب الحوت واقف السرطان",11,"ن",1,0],["رب ليلٍ كأنه الدهر طولاً","قد تناهَى فليس فيه مزيدُ",12,"د",1,1],["رب ليلٍ تراه كالدهر طولاً","قد تناهى فليس فيه مزيدُ",13,"د",1,1],["رُبَّ لَومٍ لَم يَفِد إِلّا العَنا","كَم سِهامٍ سُدِّدَت لَم تَصِبِ",14,"ب",1,0],["رَبِّ لَمّا خَلَقتَ هَذي الخُطوبا","لِمَ لَم تَخلُقِ الحَشا فولادا",15,"ا",1,0],["رُبَّ لَيلٍ عادَني فيهِ السُهاد","وَنَأى عَن مُقلَتي طيبُ الكَرى",16,"ر",2,0],["رُبَّ لَيلٍ بِتَّ تَرقُبُهُ","رَقبَةَ السَرحانِ لِلغَنَمِ",17,"م",1,0],["رُبَّ لَيلٍ نُجومُهُ ضاحِكاتٌ","مِثلَ أَحلامِ غادَةٍ في صِباها",18,"ا",3,1],["رُبَّ ليل سهرته في هواكم","حاضر الهمّ غائباً عن شهودي",19,"د",2,0],["رُبَّ لَيلٍ أَغارَ فيهِ القَماري","وَأَثارَ الحِسانَ مِن أَقمارِهِ",20,"ر",2,0],["رُبَّ لَيلٍ سَرَيتُ وَالبَرقُ طِرفي","وَبِساطٍ طَوَيتُ وَالريحُ عَنسي",21,"س",2,0],["رُبَّ لَيلٍ لَم نُقَصِّر فيهِ عَن","سَمَرٍ طالَ عَلى الصَمتِ وَطابا",22,"ب",2,0],["رُبَّ لَيلٍ باتَ في","هِ مُواصِل",23,"ل",1,0],["رُبَّ ليلٍ قد صفَا الأفقُ به","وبما قد أبدَعَ الله ازدهر",24,"ر",1,1],["رُب لحن قدسيّ","من جنان الخلد آتِ",25,"ت",1,0],["ربَّ لَحنٍ قَصَّ في خاطِرنا","قصَّةَ الساري الذي غَنَّى سهاده",26,"ه",1,0],["رب لحن قص في خاطرنا","قصة الحادي الذي غنّى سهاده",27,"ه",1,0],["رب لحن رقص النجم له","وغزا السحب وبالنجم فتك",28,"ك",1,0],["رُبَّ لَيلٍ هَصَرتُ فيه بِغُصْنٍ","لابسٍ نضرةَ النّعيم وريقِ",29,"ق",1,1],["ربَّ ليلٍ سهرتُ فيكِ إلى أنْ","لاحَ فجرٌ كنورِهِ أيَّ نور",30,"ر",1,0],["رُبَّ لَيلٍ سَمَرتُ فيهِ قَصيرٍ","وَرَفيقٍ قَد كانَ كُفؤاً كَريما",31,"م",2,0],["رُبَّ لَهوٍ لَهَوتُهُ","بِجِوارٍ رَبائِبِ",32,"ب",1,0],["رُبَّ لَيلٍ بِتُّهُ من أَجلِهِم","يَتَحاماني مَطيفُ الوَسَنِ",33,"ن",1,0],["ربِّ لطفاً فقد أتانا نذيرٌ","بوباءِ من بعد هذا الوبال",34,"ل",1,0],["ربِّ لا تَحرِمّنّي جَنّةَ الخُلدِ","وَكُن رَبِّ بي رَؤوفاً حَفِيّا",35,"ي",2,0],["رُبَّ لَيلٍ قَد نَعِمتُ بِهِ","وَنَهارٍ ما عَلِمتُ بِهِ",36,"ه",1,1],["رُبَّ لَيلٍ قَطَعتُهُ بِاِنتِحابِ","رُبَّ دَمعٍ هَرَقتُهُ في التُرابِ",37,"ب",1,1],["رُبَّ لَفظٍ ساقَ آجا","لَ نِيامٍ وَقِيامِ",38,"م",1,0],["رَبِّ لا صَبرَ لي عَلى الهَجرِ حَسبي","فَأَقِلني حَسبي لَكَ الحَمدُ حَسبي",39,"ب",2,0],["رَبَلَتهُ أَسفارُها وَحَمَتهُ","طولَ أَسفارِهِ مِنَ التَربيلِ",40,"ل",1,0],["رُبّ لَحْدٍ قَدْ صَارَ لَحْداً مراراً","ضَاحِكٍ مِنْ تَزَاحُمِ الأضْدادِ",41,"د",1,0],["رُبّ ليلٍ كأنّه الصّبحُ في الحُسْ","نِ وإن كانَ أسْودَ الطّيلَسانِ",42,"ن",1,0],["رَبِلاتِ جودٍ تَحتَ قَدٍّ بارِعٍ","حُلوِ الشَمائِلِ خيرَةِ الهَلَكاتِ",43,"ت",1,0],["رَبِلاتِ خَيلٍ ما تَزالُ مُغيرَةً","يُقطِرنَ مِن عَلَقٍ عَلى الثُنّاتِ",43,"ت",1,0],["رب ليل للشهب فيه عَلى الأر","ضِ مثال من غارة شعواء",44,"ا",2,0],["ربَّ ليلٍ بجانبيك شهدنا","قصة الدهرِ روعةً وفخامَه",45,"م",2,0],["ربَّ ليل مكوكبٍ خطرتْ في","هِ الدراري وضيئة القسماتِ",46,"ت",1,0],["رُبَّ ليلٍ مرَّ أفنيناهُ ضماً وعناقا","وأدرنا من حديثِ الحبِّ خمراً نتساقى",47,"ق",2,0],["رب لسان جمع الأقواما","وكان كالجنس لهم قواما",48,"م",2,0],["رُبَّ لَيْلٍ مُحَيَّرُ النَّجْمِ غَضٍّ","فِيهِ لا يَهْتَدِي الضَّلُولُ طَرِيقَا",49,"ق",2,0],["رُبَّ لَحْظٍ مِنٍ نَاعِمِ الظَّفْرِ فِيهِ","سَطْوَةٌ لاَ تَكُونُ فِي الآسَادِ",50,"د",1,0],["رَبِّ لَو شِئتَ لاِهتَدوا وَهُم عُي","يٌ وَلاِستَيقَظوا وَهُم نُوّامُ",51,"م",1,0],["ربُ لا أظلمُ المقاديرَ؛ إنِّي","إن بدا الشَّكُّ، لذتُ بالإيمانِ",52,"ن",1,0],["رب لبيك حجة الحق أعلى","وعيون الجلال بالمرصاد",53,"د",1,0],["ربِّ لا صبر لي على الهجر حسبي","قأقِلْنِي حَسْبِي لك الحَمْدُ حسبي",54,"ب",2,0],["ربّ ليل نجومخه ضاحكات","مثل أحلام غادة في صباحها",55,"ا",1,1],["رب ليلٍ تراه كالدهر طويلاً","قد تناهى فليس فيه مزيدُ",56,"د",1,1],["رب ليلي كأنه الدهر طولاً","قد تناهَى فليس فيه مزيدُ",57,"د",1,1],["ربَّ لحنٍ سالَ عن قيثارتي","هزَّ أعطافَ الجهادِ الأشيبِ",58,"ب",1,0],["ربّ ليل نجومه ضاحكات","مثل أحلام غادة في صباحها",59,"ا",1,1],["رُبَّ لَيْلٍ أَمَدَّ مِنْ نَفَسِ العَا","شِقِ طُولاً قَطَعْته بِانْتِحَابِ",60,"ب",1,1],["رُبَّ لَيْلٍ مازِلْتُ أَلْثِمُ فيهِ","قَمَراً لابِساً غِلالَةَ وَرْدِ",61,"د",1,1],["رُبَّ ليلٍ طلعتْ في","هِ بدورٌ من جُيوبِ",62,"ب",1,1],["رُبَّ لَيلٍ أَطالَهُ أَلَمُ الشَو","قِ وَفَقدُ الرُقادِ وَهوَ قَصيرُ",63,"ر",1,1],["ربَّ ليلٍ بتُّهُ ذا أرقٍ","ليس إلا مِنْ قَتادٍ فُرُشي",64,"ش",2,0],["ربَّ ليلٍ أُتحِفْتُ فيه بأنسٍ","من سميرٍ زَفَّ الحديث عروسا",65,"س",2,1],["رب لحن سرى مع النسمات","قد جرت من رنينه عبراتي",66,"ت",2,1],["ربِّ لا تضرب الحَزينَةَ بِالثَك","لِ وَلا تَبلني بِهذا البَلاءِ",67,"ا",2,0],["رُبَّ ليلٍ وصَلْتُه بصَبوحٍ","وصباحٍ وصلته بغَبوقِ",68,"ق",1,1],["ربَّ ليل أنرتُه بثغورِ","وصباح طمسْته بشُعورِ",69,"ر",1,1],["ربَّ ليلٍ مُسْتَطابٍ","بات بالبدر مُتَوَّجْ",70,"ج",1,1],["ربَّ لَيلٍ قصَّرتُهُ بلقاهُ","وَليالي الهَنا تَكونُ قصارا",71,"ر",2,0],["ربَّ ليلٍ بتُّ فيه أَليل","بات طرف النجم فيه يطرف",72,"ف",1,0],["رب لا طفنا بجاه المصطفى","واسقنا الغيث فأنا ضعفا",73,"ف",2,0],["ربّ ليلٍ أفناه يزجى إلى الل","ه ضراعات مسرف في دعائه",74,"ا",3,0],["ربَّ لِسانٍ فمُه مقلةٌ","تختصُّ بالشكوى عن الشُّكرِ",75,"ر",1,0],["رُبَ لَيلٍ قَد زارَني وَسِواري الشَه","ب حَيرى تَهيم في الآفاق",76,"ق",1,0],["رب لا تكشف لحالي","إن حالي خس حاله",77,"ل",2,0],["رب لفظه بها يهوى الأنام","في جهنم كذا سبعين عام",78,"م",1,0],["رب لك الحمد يامحيي العظام الرميم","سبحانك الله يا معطي الجزيل العظيم",79,"م",1,0],["رب لك الحمد في الدنيا ويوم النشور","رب لك الحمد حمد دائما كالدهور",80,"ر",1,0],["رب لك الحمد تعداد الورق والطيور","إني بحمدك وشكرك معترف بالقصور",80,"ر",1,0],["رب لا خيبت آمال الفقير","العبيد المحض من بك مستجير",81,"ر",1,1],["رُبَّ لَيلٍ أغمدَ الأنوار إلاّ","نورَ ثَغرٍ ونَدامٍ ومُدامِ",82,"م",1,1],["ربَّ ليلٍ أطَعْتُ فيه التَّصابي","باختلاسي مسرَّة الأَيَّام",83,"م",1,0],["رُبَّ ليلٍ أطبقَتْ ظلماؤه","تحسب الشهب عيوناً فيه رمدا",84,"د",2,0],["رب ليل قطعته بمليح","أشْهَدَ البدر من محيَّاه تمَّا",85,"م",2,0],["رُبَّ ليلٍ باتَ فيه المُشتَري","بأحاديثي يناجي زُحَلا",86,"ل",2,0],["رُبّ ليلٍ قطعتُه في ذَراهُ","يشبهُ الحُلْمَ وهْو في الانتِباهِ",87,"ه",1,0],["ربَّ ليلٍ بين المُحصَّب والخَيْ","ف لبسناه للخلاعةِ بُرْدا",88,"د",2,0],["رُبَّ لَهْوٍ رَفَلتُ في أَثوابِهِ","ونديمٍ كَرَعْتُ من أَكْوابِهِ",89,"ب",2,1],["ربَّ ليلٍ أَقمتُ فيه مُقامي","شَعْرُه لَيْلَتي وخدَّاه شَمْعِي",90,"ع",2,0],["رُبَّ ليلٍ لهوتُ فيه ببدرٍ","يَنْثَني أَبْيَضاً ويهتَزُّ أَسْمَرْ",91,"ر",1,0],["رُبَّ ليلٍ واصلْتُها فِيه والشُّه","بُ تَرانِي وَاصَلْتُ بعضَ الشُّهْب",92,"ب",1,0],["رُبَّ لَيلٍ لَم أَذُق فيهِ الكَرى","حَظُّ عَيني فيهِ دَمعٌ وَسَهَرْ",93,"ر",1,1],["رب ليل دبيت فيه لبدر","وهو عندي بساعدي قد توسد",94,"د",1,0],["رب لا أستطيع ردَّ الذي تق","ضي فهبن