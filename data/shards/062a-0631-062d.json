"],[6056,"خشف المها","https://www.poetsgate.com/ViewPoem.aspx?id=130384",""],[6085,"سر ياقلم","https://www.poetsgate.com/ViewPoem.aspx?id=8675",""],[186,"حياة أسر العيش فيها مذمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55798&r=&rc=61",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[5555,"مَلاعِبُنَا الأُولَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87420&r=&rc=15",""],[147,"بكَ اقتضى الدينُ ديناً كانَ قدْ وجبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27445&r=&rc=12",""]],"verses":[["تَرَحَّلتُ عَنكُم لي أَمامِيَ نَظرَةٌ","وَعَشرٌ وَعَشرٌ نَحوَكُم لي وَرائِيا",0,"ي",2,0],["تُرَحِّلُنا الأَيّامُ وَهيَ تُقيمُ","وَيَجرَحُ فينا الخَطبُ وَهوَ سَليمُ",1,"م",1,1],["تَرَحَّلَ عَنْ مَثْوَاكَ طَوْعَ ضَرُورَةٍ","وَخَلَّفَ قَلْباً رَاضِياً بِمُقَامِهِ",2,"م",2,0],["تَرَحَّلْتَ عَنْ رَبْعٍ عَلِمْتَ غُرُورَهُ","وَفَارَقْتَ مَغْنَاهُ وَأَخْلَيْتَ دُورَهُ",3,"ه",1,0],["ترحل للأخرى وأبقى مناقباً","تضيء من الدنيا بهنّ المواسم",4,"م",1,0],["تَرَحَّلَ عَن قَومٍ فَضَلَّت عُقولُهُم","وَحَلَّ عَلى قَومٍ بِنورٍ مُجَدَّدِ",5,"د",1,0],["ترحلت يا يحيى وفضلك خالدٌ","هو البحر إلاَّ أنَّ جعفرَ نهره",6,"ر",2,0],["تَرْحاً لدارٍ إنما","سكانُها رُفَقٌ مُخِبَّهْ",7,"ب",2,0],["ترحَّل من هوِيت وكل شمسِ","ستكْسِفُ أو ستغرب حين تُمسي",8,"س",2,1],["تَرحاً للزمان من مُستأيسٍ","ولمن يرتجيه من مُستئِيس",9,"س",1,0],["تُرَحِّبُ بِالضَيفِ فَوقَ الطَري","قِ فَبابِ العِيادَةِ فَالسُلَّمِ",10,"م",1,0],["ترحَّلَ عن أوطانهِ كلُّ مُكرَهٍ","إذا بانَ عن أوطانِه ساعةً قضَى",11,"ض",2,0],["ترحم الشادي وتبكي للوتر","يا نداء كلما أرسلته",12,"ه",1,0],["تَرَحّلُ من آجامها الأُسْدُ خيفةً","إذا نَزَلوا للرّعْيِ فيها وخَيّموا",13,"م",3,0],["ترحّل إخواني.. فأصبحت بعدهم","غريباً.. يتيم الروح والقلب والفكرِ",14,"ر",1,0],["تَرَحَّلَ لَمّا أَن تَكامَلَ مَجدُهُ","وَلَيسَ كُسوفُ البَدرِ إِلّا إِذا تَمّا",15,"م",2,0],["تَرَحَّل مِنَ الدُنيا بِزادٍ مِنَ التُقى","فَعُمرُكَ أَيّامٌ تُعَدُّ قَلائِلُ",16,"ل",1,1],["تَرَحَّلَ مِن أَرضِ العِراقِ مُرَقِّشٌ","عَلى طَرَبٍ تَهوي سِراعاً رَواحِلُه",17,"ل",2,0],["تَرَحَّلَ مِنْ وَادِي الأَرَاكَةِ بِالْوَجْدِ","فَبَاتَ سَقِيماً لا يُعِيدُ وَلا يُبْدِي",18,"د",2,1],["تَرَحَّلتْ عَنْ زَمَنِي عَائِداً","خِلاَلَ القُرُونِ إِلىَ مَا وَرَاءْ",19,"ا",2,1],["ترحلت فالاسلام مقلة ثاكل","وأوجه أيام السعادة سود",20,"د",1,0],["ترحلت لا تبعد وهل لك أوبة","وواحربا اوب اللحيد لحيد",20,"د",1,0],["ترحلت عنها لا علي ولا ليا","وقد كنت اشكوا الكاشحين من العدى",21,"ا",1,0],["ترحِّبُ بالضَّيف فوقَ الط","قِ، فبابِ العيادة ِ فالسُّلَّم",22,"م",1,0],["ترحلت عنكم والخطوب كثيرة","ولكنّ خطب البين أسهله صعب",23,"ب",1,0],["تَرَحَّلتَ في شَرخِ الشَبابِ مُغادِراً","مِنَ الحُزنِ ما يُودي الشَبابَ وَيَهرمُ",24,"م",1,0],["ترحّلت عن مصر الجديدة كارهاً","ودمعك مسكوبٌ وقلبك شيّق",25,"ق",1,0],["ترحَّم وَلا تَجعَل رَنينَكَ مُحزِناً","وَدقَّ بِأَلحانِ الحبورِ عَلى قَبري",26,"ر",2,0],["ترحلتُ عمن صير الضيم منزلا","لمثلي ومثلي عن حمي الضيم راحل",27,"ل",1,0],["تَرَحَّلَ عَنْها فَهْيَ كاسِفَةٌ لَهُ","وَعادَ إِلَيْها فَهْيَ مُشْرِقَةٌ بِهِ",28,"ب",2,0],["تَرَحَّل عَنها غَيرَ لاوٍ عَلى أَخٍ","وَلا وَلَدٍ بَرٍّ تَرَحَّلَ مُجتازِ",29,"ز",1,0],["ترحلت عنه وعندي له","من الشوقِ ما عنده لي أنا",30,"ن",2,0],["ترحّب بي السكّان حَتّى تَبادَرَت","بَراغيثها أَيضاً تقبّل أقدامي",31,"ي",1,0],["تَرحّلَ طارقُ الحدَثانِ عنّي","غداةَ إليه ألقيتُ الرِّحالا",32,"ل",2,0],["تَرَحَّلَ عَنكُم جِسمُهُ دونَ قَلبِهِ","وَفارَقَكُم في جَمرِهِ دونَ سِرِّهِ",33,"ر",2,0],["تَرَحَّلتُ عَنكُم جاهِلاً سَورَةَ النَوى","مَشوقاً إِلى رَوحِ الحَياةِ وَروحِها",34,"ه",2,1],["ترحَّلتَ عن صُورَ لا مُكرَهاً","فمالَكَ تكثِرُ نَقرَ الزَّمَن",35,"ن",1,0],["تَرَحُّماً فاذكري منك شفيعتَنا","وقصِّري غربةً طالت لنقتصرا",36,"ر",2,0],["ترحَّلَ الصَّبرُ عندَما رحَلَتْ","إلى جوار المهجنِ الصَّمدِ",37,"د",1,0],["تُرِحْني بالإجابَةِ من هُمومٍ","أحاطَتْ من تَباريحِ الجَوى بي",38,"ي",1,0],["ترحَّلْتُ عنكَ لفَرط الشَّقاءِ","وحلَّفتُ رُشدي ورائي ورائي",39,"ي",1,1],["تَرحَّلَ غَرباً وارتحلْتُ مُشَرِّقاً","وخُلفُ ارتحالِ الظّاعِنينَ عَنَاءُ",40,"ا",2,0],["تَرَحَّمْ على عبدك المستهام","فإنِّي عهدتُك برًّا رحيما",41,"م",2,0],["ترَحَّلتَ عنَّا لا ملالاً ولا قِلًى","وهل يعرف السلوانُ بعدك ساليا",42,"ي",2,0],["ترحَّلَ في يومٍ من الشرّ عابسٍ","وعاد وقد أعداه من وجهك البشرُ",43,"ر",1,0],["ترحّلْتَ عنها كالهِلالِ ولم تزَلْ","تنقّلُ حتّى عُدْتَ في أفْقِها بَدْرا",44,"ر",2,0],["ترحل عنها مذ رحلت أنيسها","فبان عليها وحشها واكتئابها",45,"ب",3,0],["ترحلت عن صدري وحجري إلى البلى","فعرس ركب الهم في حجراتي",46,"ت",2,0],["ترحلت إسماعيل عنا فأوحشت","منازلنا مأهولة العرصات",47,"ت",1,0],["ترحب بالأهوال ساحة صدره","إذا طرقتها للهموم وفود",48,"د",1,0],["ترحب عنه بالوفود رحابه","وتغدو لمن يلقاه بالشعر مشعر",49,"ر",1,0],["ترحل ثم خلفني","ونار الشوق تقلقني",50,"ن",2,0],["تُرَحِّبُ يا ابنةَ النيلِ المُفَدَّى","بِكِ الحَمرا وبَاشاها الغَيورُ",51,"ر",1,0],["تَرَحَّلُ عنهُ في الصَّباحِ كتيبةٌ","وتَعشُو إليهِ هَجْمةٌ ورَعيلُ",52,"ل",1,0],["تَرَحَّلنا الجِيادَ وَكُلُّ صَدرٍ","كَأَنَّ فُؤادَهُ تَحتَ الجِيادِ",53,"د",1,0],["تَرَحَّلي أَو أَقيمي أَنْتِ لي سَكَنٌ","وَأَنْتِ غايةُ آمالي ومَطْلوبِي",54,"ب",2,0],["تَرحَّل عَنَّا وَصْلُهُ وَهْوَ عَادِلٌ","وَخَيَّمَ فِينا هَجْرُهُ وَهْوَ قاسِطُ",55,"ط",1,0],["تَرحَّلَ عَنْهُ مُذْ تَرَحَّلْتَ نافِراً","فَلَيْس لَهُ حَتّى القُدوم قُدومُ",56,"م",1,0],["تَرَحَّلَ القومُ عَنها واستَمرَّ بهم","مُشَمِّرٌ مِن حُداةِ البينِ سَيّارُ",57,"ر",1,0],["تَرَحَّلَ عَن دارِ الفَناءِ إِلى الَّتي","بِها عَيشُهُ في الخُلدِ تَجري كَواثِرُه",58,"ر",2,0],["ترحّلتِ يا راحيل عني بسرعةٍ","واشعلتِ نيران الغَضَى داخل الصدرِ",59,"ر",1,0],["ترِّحب صدراً في امورٍ لو أَنَّها","سرَّت بين رحب ضاق وهو موسع",60,"ع",1,0],["ترحل من مصر يبغي الشام","فقطر العراق فصقع بخارى",61,"ر",2,0],["ترحيب ركبٍ طايف","ليلة مزار البيت",62,"ت",1,0],["ترحلن فانحلت عقود المدامع","تكاثر جود الساريات المدامع",63,"ع",1,1],["تَرَحَّلَ مَنْ أَهْوى وَسَارَتْ نِيَاقُهُمْ","وَكَانَ إِلَى وادي العقيق مساقهم",64,"م",1,0],["تَرَحَّلَ عَنْهَا مَنْ هَوِينَاهُ عَجِلاَ","وَلَمَّا سَرَى الْحَادِي وَحَثَّ الرَّوَاحِلاَ",65,"ل",2,0],["تَرحَّلَ إخواني بعقلي إنني","تكلفَ قلبي كُلُّ جارٍ لجاوِرُه",66,"ر",2,1],["ترحل عنه أهله بأهلة","بأحداجها غيد من العين خرد",67,"د",1,0],["تَرحَّلتُ عَنكُم لِي أَمامِي نَظرَةٌ","وعِزٌّ وعزٌّ نحوَكُم لِي عَلى إِثري",68,"ر",2,0],["ترحَّلتُ عنكُم غيرَ مُستَبدِلٍ بِكُم","وَلو أَنَّني خُيِّرتُ في الأَنجُمِ الزُّهرِ",68,"ر",1,0],["ترحّل في الحيّ عن أثله","وَعن برقتيه وعَن بانهِ",69,"ن",2,0],["تَرحّلَ أهلُها عَنها فَسارَت","ظَعائنُهم بِروحكَ حينَ ساروا",70,"ر",3,0],["ترحل والمعروف باق كأنه","سحاب أغاث الناس ثم تقشعا",71,"ع",2,0],["تَرَحَّلْتَ عن مِصْرٍ فأَمْحَلَ رَبْعُها","ولمّا حَلَلْتَ الشّامَ رَوَّضَ ماحلُهْ",72,"ل",2,0],["ترحل إلى ربع الاحبة قاصداً","واياك من طول الاقامة والمكث",73,"ث",1,0],["ترحّل جوجو فلا يرجعُ","وعزّ العزاء فما نصنعُ",74,"ع",1,1],["ترحلت لا رغبة إنما","قصارى البرية هذا الرحيل",75,"ل",1,0],["ترحب به مولى كريما ترحبت","بايامه بالوافدين سراياه",76,"ا",2,0],["ترحَّلت عن بغداد أطيبَ منزِلٍ","وأبهى بلاد الله مرأىً ومنظرا",77,"ر",2,1],["ترحيبةٍ مِنْ خاطري يَتْ عَلَى الكيْف","دارت عَلَى بالي وقلبي فَضى بها",78,"ب",3,0],["ترحيبةٍ من خاطري هوب تكليف","يَا مَرحبا يَا حيّ زينة شبابها",78,"ب",3,0],["ترحيبةٍ للشيخ سلطان تعريف","سلطان بن زايد هدفها وصابها",78,"ب",3,0],["ترحيب للريّس خليفه","وترحيب لمحمد ومنصور",79,"ر",1,1],["ترحيب لِمْعَزّب لْضيفه","ترحيبةٍ ما مثلها يصور",79,"ر",1,0],["ترحل أيها الصبر الجميلُ","فما لك بعد فاتنتي مقيلُ",80,"ل",1,1],["ترحلت الاجياد تبغي عميدها","اخا الحرب دارتهُ السقائف والقبرُ",81,"ر",1,1],["تَرَحمْ إنْ وَقَفْتَ هُنَا وَسَلَّمْ","وَعَايِنْ في التُّرابِ فَتىً مُكَرَّمْ",82,"م",1,1],["ترحب الأرض والسماء بجيش","انتما في سمائه الفرقدان",83,"ن",1,0],["ترحّل من دار بها الأنس لم يزل","لوَحشَة لَحد بالتراب رديم",84,"م",1,0],["تَرَحَّلتُ عَنكُم لا اِغتِباطاً بِغَيرِكُم","وَلا عَن مُقامٍ في حِماكُم مُذَمَّمِ",85,"م",1,0],["ترحل عني تبتغي عينَ موجودي","وقد سترت أمري وقد شرحتْ صدري",86,"ر",2,0],["ترحلت عنا عنوةً وقلوبنا","لبعدك فيها الشيلُ للغم والحط",87,"ط",1,0],["ترحل صبري والولوع مقيم","وصح اشتياقي والسلو سقيم",88,"م",1,1]