{"poems":[[53,"أقول لركب رائحين لعلكم","https://www.aldiwan.net/poem29626.html","الطويل"],[53,"ترحلنا الأيام وهي تقيم","https://www.aldiwan.net/poem29784.html","الطويل"],[77,"خليلي إذ ما جئتما دار طارق","https://www.aldiwan.net/poem36082.html","الطويل"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[88,"على قاسم شيخ الطريقة قد بكت","https://www.aldiwan.net/poem45029.html","الطويل"],[23,"لقد خاب قوم غاب عنهم نبيهم","https://www.aldiwan.net/poem21554.html","الطويل"],[72,"هنيئا لأفق الفضل إنك بدره","https://www.aldiwan.net/poem18711.html","الطويل"],[51,"يا لهف نفسي للأحبه","https://www.aldiwan.net/poem8185.html","مجزوء الكامل"],[51,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[85,"براغيث محجوب لم أنسها","https://www.aldiwan.net/poem7915.html","المتقارب"],[61,"ومارقة مرق السهام تضمها","https://www.aldiwan.net/poem51583.html","الطويل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[80,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[104,"لك الحمد","https://www.aldiwan.net/poem61098.html","عموديه"],[81,"لقد أعقبت بالبؤس منك وبالنعمى","https://www.aldiwan.net/poem61490.html","الطويل"],[52,"ترحل من الدنيا بزاد من التقى","https://www.aldiwan.net/poem26710.html","الطويل"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[88,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[85,"بَرَاغِيثُ مَحجوب لم أَنسَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9743&r=&rc=233",""],[151,"لكم من فؤادي خلص الود والحب","https://www.aldiwan.net/poem68479.html","الطويل"],[183,"حياة أسر العيش فيها مذمم","https://www.aldiwan.net/poem67033.html","الطويل"],[212,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[224,"أيا جرسا في هوة الدمع ناحبا","https://www.aldiwan.net/poem41638.html","الطويل"],[262,"رؤوس العوالي للمعالي معاقل","https://www.aldiwan.net/poem38212.html","الطويل"],[281,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[283,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[304,"ولي صاحب لو شريت الودا","https://www.aldiwan.net/poem58197.html","المتقارب"],[354,"ولما أتينا للمغيرية التي","https://www.aldiwan.net/poem39783.html","الكامل"],[365,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[367,"سقى الله تلك الدار عودة أهلها","https://www.aldiwan.net/poem17876.html","الطويل"],[367,"ترحلت عنكم جاهلا سورة النوى","https://www.aldiwan.net/poem17908.html","الطويل"],[372,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[378,"رأيت مريم ملجانا بضيقتِنا","https://www.aldiwan.net/poem59153.html","البسيط"],[403,"قبر حوى قطعة من الكبد","https://www.aldiwan.net/poem46435.html","المنسرح"],[406,"كتبت فلم يجبني عن كتابي","https://www.aldiwan.net/poem50058.html","الوافر"],[406,"ترحلت عنك لفرط الشقاء","https://www.aldiwan.net/poem50118.html","المتقارب"],[410,"لئن غربت شمسي المنيرة في النوى","https://www.aldiwan.net/poem32340.html","الطويل"],[417,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[417,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[459,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[515,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[516,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[516,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[516,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[516,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[516,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[516,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[539,"أتى بقدوم فاطمة البشير","https://www.aldiwan.net/poem48146.html","عموديه"],[563,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"],[563,"نفارقكم ونضرب في البلاد","https://www.aldiwan.net/poem52988.html","الوافر"],[587,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[587,"غدا نافرا يدني الهوى وهو شاحط","https://www.aldiwan.net/poem17580.html","الطويل"],[587,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"]],"verses":[["تَرَحَّلتُ عَنكُم لي أَمامِيَ نَظرَةٌ","وَعَشرٌ وَعَشرٌ نَحوَكُم لي وَرائِيا",0,"ي",2,0],["تُرَحِّلُنا الأَيّامُ وَهيَ تُقيمُ","وَيَجرَحُ فينا الخَطبُ وَهوَ سَليمُ",1,"م",1,1],["تَرَحَّلَ عَنْ مَثْوَاكَ طَوْعَ ضَرُورَةٍ","وَخَلَّفَ قَلْباً رَاضِياً بِمُقَامِهِ",2,"م",2,0],["تَرَحَّلْتَ عَنْ رَبْعٍ عَلِمْتَ غُرُورَهُ","وَفَارَقْتَ مَغْنَاهُ وَأَخْلَيْتَ دُورَهُ",3,"ه",1,0],["ترحل للأخرى وأبقى مناقباً","تضيء من الدنيا بهنّ المواسم",4,"م",1,0],["تَرَحَّلَ عَن قَومٍ فَضَلَّت عُقولُهُم","وَحَلَّ عَلى قَومٍ بِنورٍ مُجَدَّدِ",5,"د",1,0],["ترحلت يا يحيى وفضلك خالدٌ","هو البحر إلاَّ أنَّ جعفرَ نهره",6,"ر",2,0],["تَرْحاً لدارٍ إنما","سكانُها رُفَقٌ مُخِبَّهْ",7,"ب",2,0],["ترحَّل من هوِيت وكل شمسِ","ستكْسِفُ أو ستغرب حين تُمسي",8,"س",2,1],["تَرحاً للزمان من مُستأيسٍ","ولمن يرتجيه من مُستئِيس",9,"س",1,0],["تُرَحِّبُ بِالضَيفِ فَوقَ الطَري","قِ فَبابِ العِيادَةِ فَالسُلَّمِ",10,"م",1,0],["ترحَّلَ عن أوطانهِ كلُّ مُكرَهٍ","إذا بانَ عن أوطانِه ساعةً قضَى",11,"ض",2,0],["ترحم الشادي وتبكي للوتر","يا نداء كلما أرسلته",12,"ه",1,0],["تَرَحّلُ من آجامها الأُسْدُ خيفةً","إذا نَزَلوا للرّعْيِ فيها وخَيّموا",13,"م",3,0],["ترحّل إخواني.. فأصبحت بعدهم","غريباً.. يتيم الروح والقلب والفكرِ",14,"ر",1,0],["تَرَحَّلَ لَمّا أَن تَكامَلَ مَجدُهُ","وَلَيسَ كُسوفُ البَدرِ إِلّا إِذا تَمّا",15,"م",2,0],["تَرَحَّل مِنَ الدُنيا بِزادٍ مِنَ التُقى","فَعُمرُكَ أَيّامٌ تُعَدُّ قَلائِلُ",16,"ل",1,1],["تَرَحَّلَ مِن أَرضِ العِراقِ مُرَقِّشٌ","عَلى طَرَبٍ تَهوي سِراعاً رَواحِلُه",17,"ل",2,0],["تَرَحَّلَ مِنْ وَادِي الأَرَاكَةِ بِالْوَجْدِ","فَبَاتَ سَقِيماً لا يُعِيدُ وَلا يُبْدِي",18,"د",2,1],["تَرَحَّلتْ عَنْ زَمَنِي عَائِداً","خِلاَلَ القُرُونِ إِلىَ مَا وَرَاءْ",19,"ا",2,1],["ترحلت عنها لا علي ولا ليا","وقد كنت اشكوا الكاشحين من العدى",20,"ا",1,0],["ترحِّبُ بالضَّيف فوقَ الط","قِ، فبابِ العيادة ِ فالسُّلَّم",21,"م",1,0],["ترحلت عنكم والخطوب كثيرة","ولكنّ خطب البين أسهله صعب",22,"ب",1,0],["تَرَحَّلتَ في شَرخِ الشَبابِ مُغادِراً","مِنَ الحُزنِ ما يُودي الشَبابَ وَيَهرمُ",23,"م",1,0],["ترحّلت عن مصر الجديدة كارهاً","ودمعك مسكوبٌ وقلبك شيّق",24,"ق",1,0],["ترحَّم وَلا تَجعَل رَنينَكَ مُحزِناً","وَدقَّ بِأَلحانِ الحبورِ عَلى قَبري",25,"ر",2,0],["ترحلتُ عمن صير الضيم منزلا","لمثلي ومثلي عن حمي الضيم راحل",26,"ل",1,0],["تَرَحَّلَ عَنْها فَهْيَ كاسِفَةٌ لَهُ","وَعادَ إِلَيْها فَهْيَ مُشْرِقَةٌ بِهِ",27,"ب",2,0],["تَرَحَّل عَنها غَيرَ لاوٍ عَلى أَخٍ","وَلا وَلَدٍ بَرٍّ تَرَحَّلَ مُجتازِ",28,"ز",1,0],["ترحلت عنه وعندي له","من الشوقِ ما عنده لي أنا",29,"ن",2,0],["ترحّب بي السكّان حَتّى تَبادَرَت","بَراغيثها أَيضاً تقبّل أقدامي",30,"ي",1,0],["تَرحّلَ طارقُ الحدَثانِ عنّي","غداةَ إليه ألقيتُ الرِّحالا",31,"ل",2,0],["تَرَحَّلَ عَنكُم جِسمُهُ دونَ قَلبِهِ","وَفارَقَكُم في جَمرِهِ دونَ سِرِّهِ",32,"ر",2,0],["تَرَحَّلتُ عَنكُم جاهِلاً سَورَةَ النَوى","مَشوقاً إِلى رَوحِ الحَياةِ وَروحِها",33,"ه",2,1],["ترحَّلتَ عن صُورَ لا مُكرَهاً","فمالَكَ تكثِرُ نَقرَ الزَّمَن",34,"ن",1,0],["تَرَحُّماً فاذكري منك شفيعتَنا","وقصِّري غربةً طالت لنقتصرا",35,"ر",2,0],["ترحَّلَ الصَّبرُ عندَما رحَلَتْ","إلى جوار المهجنِ الصَّمدِ",36,"د",1,0],["تُرِحْني بالإجابَةِ من هُمومٍ","أحاطَتْ من تَباريحِ الجَوى بي",37,"ي",1,0],["ترحَّلْتُ عنكَ لفَرط الشَّقاءِ","وحلَّفتُ رُشدي ورائي ورائي",38,"ي",1,1],["تَرحَّلَ غَرباً وارتحلْتُ مُشَرِّقاً","وخُلفُ ارتحالِ الظّاعِنينَ عَنَاءُ",39,"ا",2,0],["تَرَحَّمْ على عبدك المستهام","فإنِّي عهدتُك برًّا رحيما",40,"م",2,0],["ترَحَّلتَ عنَّا لا ملالاً ولا قِلًى","وهل يعرف السلوانُ بعدك ساليا",41,"ي",2,0],["ترحَّلَ في يومٍ من الشرّ عابسٍ","وعاد وقد أعداه من وجهك البشرُ",42,"ر",1,0],["ترحّلْتَ عنها كالهِلالِ ولم تزَلْ","تنقّلُ حتّى عُدْتَ في أفْقِها بَدْرا",43,"ر",2,0],["ترحل عنها مذ رحلت أنيسها","فبان عليها وحشها واكتئابها",44,"ب",3,0],["ترحلت عن صدري وحجري إلى البلى","فعرس ركب الهم في حجراتي",45,"ت",2,0],["ترحلت إسماعيل عنا فأوحشت","منازلنا مأهولة العرصات",46,"ت",1,0],["ترحب بالأهوال ساحة صدره","إذا طرقتها للهموم وفود",47,"د",1,0],["ترحب عنه بالوفود رحابه","وتغدو لمن يلقاه بالشعر مشعر",48,"ر",1,0],["ترحل ثم خلفني","ونار الشوق تقلقني",49,"ن",2,0],["تُرَحِّبُ يا ابنةَ النيلِ المُفَدَّى","بِكِ الحَمرا وبَاشاها الغَيورُ",50,"ر",1,0],["تَرَحَّلُ عنهُ في الصَّباحِ كتيبةٌ","وتَعشُو إليهِ هَجْمةٌ ورَعيلُ",51,"ل",1,0],["تَرَحَّلنا الجِيادَ وَكُلُّ صَدرٍ","كَأَنَّ فُؤادَهُ تَحتَ الجِيادِ",52,"د",1,0],["تَرَحَّلي أَو أَقيمي أَنْتِ لي سَكَنٌ","وَأَنْتِ غايةُ آمالي ومَطْلوبِي",53,"ب",2,0],["تَرحَّل عَنَّا وَصْلُهُ وَهْوَ عَادِلٌ","وَخَيَّمَ فِينا هَجْرُهُ وَهْوَ قاسِطُ",54,"ط",1,0],["تَرحَّلَ عَنْهُ مُذْ تَرَحَّلْتَ نافِراً","فَلَيْس لَهُ حَتّى القُدوم قُدومُ",55,"م",1,0]]}