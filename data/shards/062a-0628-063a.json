وف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5957,"صباح الحبّ يا شادي","https://www.poetsgate.com/ViewPoem.aspx?id=176992",""],[5962,"العقل","https://www.poetsgate.com/ViewPoem.aspx?id=205968",""],[5967,"يا قلب إنك من أسماء مغرور","https://www.poetsgate.com/ViewPoem.aspx?id=181618",""],[5993,"غدر قلبي وحلل حرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186642",""],[6023,"من يبغ بالفضل معاشاً يمت","https://www.poetsgate.com/ViewPoem.aspx?id=123920",""],[6127,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=188289",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[5464,"يا أخت هارون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66201&r=&rc=20",""],[6229,"ملاكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65181&r=&rc=8",""],[6259,"إن كنت تصدق في ادعاء وداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59365&r=&rc=13",""]],"verses":[["تَبغي الثَوابَ فَمُهجَتي","هَذي القَريحَةُ مَن رَماها",0,"ا",3,0],["تَبغي كأنْضاءِ السّيوفِ فِتْيَةً","مُوَسَّدينَ أذْرُعَ الرّواحِلِ",1,"ل",1,0],["تَبغي النَجاةَ وَلَم تَسلُك طَريقَتَها","إِنَّ السَفينَةَ لا تَجري عَلى اليَبَسِ",2,"س",1,0],["تَبْغي النّدَى حيْثُ لُجُّ الجودِ موْرِدُهُ","عذْبٌ وتُنْتِجُ الأمْلاكَ والدُّوَلا",3,"ل",2,0],["تَبغي سِوى اِسمي وَتُوَرّي بِهِ","فاتَكَ ما تَطلُبُهُ مِنّي",4,"ن",2,0],["تَبْغِي النَّجَاحِ سَبِيلُهُ مَشْرُوعَةٌ","وَتُجَانِبُ الأَوْزَارَ وَالآثَامَا",5,"م",2,0],["تَبْغِي صِيَانَتَهُ وَتَرْفَعُهُ","شَأْناً إِلَى العُلْيَا مِنَ القِمَمِ",6,"م",1,0],["تَبْغِي الحَقِيقَةَ سَاعِياً كَلِفاً","مِنْ كُلِّ مُطَّلِبٍ بِلا سَأَمِ",7,"م",1,0],["تَبَغَّ اِبنَ عَمِّ الصِدقِ حَيثُ لَقيتَهُ","فَإِنَّ اِبنَ عَمِّ السَوءِ إِن سَرَّ يُخلَفُ",8,"ف",1,0],["تُبَغّي أَذاها وَإِعسارَه","وَحَولَكَ غَوثٌ وَأَنعامُها",9,"م",3,0],["تبغي بها تقويمَ أيْ","رِك وهو كالسكران مائلْ",10,"ل",1,0],["تَبَغَّينَ بُلكوثاً ثَلاثاً يَعُدنَهُ","وَيَومَينِ ما يَعجُمنَ غيرَ الشَكائِمِ",11,"م",1,0],["تَبَغَّينَهُ في أَهلِهِ فَوَجَدنَهُ","عَظيمَ السَوادِ عِندَ مَدِّ القَوائِمِ",11,"م",1,0],["تَبغي اللَذاذاتِ النُفوسُ وَتَشتَهي","وَاللَهُ ما تَبغيهِ وَالإِنجيلُ",12,"ل",1,0],["تَبغي الوُقوفَ عَلى حَقيقَةِ أَمرِهِ","تَبغي حَليلاً لا تَراهُ جَليلا",13,"ل",2,0],["تَبَغَّ عِداءً حَيثُ حَلَّت دِيارُها","وَأَبناءُ عَوفٍ في القُرونِ الأَوائِلِ",14,"ل",1,1],["تَبَغّانِيَ الأَعداءُ إِمّا إِلى دَمٍ","وَإِمّا عُراضِ الساعِدَينِ مُصَدَّرا",15,"ر",2,0],["تَبغي لِمِصرَ الشَرقُ أَو","أَكثَرَهُ مُستَعمَرَه",16,"ر",2,0],["تبغي سُلُوِّي وهو أعوزُ مطلبٍ","وطِلابُ ما لا يُستطاعُ جنونُ",17,"ن",1,0],["تَبَغَّت جِواراً في مَعَدٍّ فَلَم تَجِد","لِحُرمَتِها كَالحَيِّ بَكرِ اِبنِ وائِلِ",18,"ل",1,1],["تَبغي مِنَ الدُنيا الكَثيرَ وَإِنَّما","يَكفيكَ مِنها مِثلُ زادِ الراكِبِ",19,"ب",1,0],["تَبغي الخَلاصَ بِغَيرِ مَأخَذِهِ","لِتَنالَ رَوحَ اليُسرِ بِالعُسرِ",20,"ر",1,0],["تَبغي النَجاةَ مِنَ الأَجداثِ مُحتَرِساً","وَإِنَّما أَنتَ وَالعِلّاتُ في قَرَنِ",21,"ن",1,0],["تَبغي ذُراكَ إِذا أَسِنَّةُ قَعضَبٍ","أَردَينَ عِرّيفَ الوَغى المِرّيسا",22,"س",2,0],["تَبْغِي الحياةَ عَزيزَةً لِبلادِها","وتَرُدُّ حُكْمَ الطَّامعِ المُغْتالِ",23,"ل",1,0],["تبغي الحياةَ عزيزةً ويَغيظُها","أن يُستباحَ من اللّيوثِ عَرينُ",24,"ن",1,0],["تبغي الفِداءَ وتلك سُنّةُ من يرى","أنّ الفداءَ هو الذمامُ الأوجب",25,"ب",1,0],["تَبغي القَصاصَ بِمَن فَقَدتَ مِنَ الرَدى","جُرحُ الرَدى عِندَ النُفوسِ جَبارُ",26,"ر",1,0],["تَبَغْددَ منْهُ الزّابُ حتى رأيْتُهُ","يهبّ نسيمُ الروض فيهِ فيُستَجفى",27,"ف",2,0],["تَبَغَّ جِوارَنا إِن خِفتَ أَزّاً","نُجيرُ الخائِفينَ وَلا نُجارُ",28,"ر",1,0],["تَبَغَّضُ ساعُنا أَبَداً إِلَينا","وَهُنَّ إِلى النُفوسِ مُحَبَّباتُ",29,"ت",1,0],["تَبغي مِنَ الآمالِ ذِلَّةَ مُسعِفٍ","تِلكَ المَصاعِبُ أَتعَّبَت مَن راضَها",30,"ض",3,0],["تَبغي الثَراءَ فَتُعطاهُ وَتُحرَمُهُ","وَكُلُّ قَلبٍ عَلى حُبِّ الغِنى جُبِلا",31,"ل",2,0],["تَبغي رحيلاً عن القو","م وهو لا يستطاع",32,"ع",1,0],["تَبغي المدافع هدم أَية قرية","فَلَها عَلى شط الفرات رغاء",33,"ا",2,0],["تَبغي لتلبس جدة في عصرنا","كل الشعوب وتنزع الأسمالا",34,"ل",2,0],["تَبْغي بمَكّةَ حاجَةً","قَدَرَ العَزيزُ مَآلَها",35,"ل",3,0],["تَبْغُونَ أَنْ تَحْيَوْا وَتَحْيَا مِصْرُكُمْ","حَقَّ الحَيَاةِ وَمَا بِهَا مِنْ عَارِ",36,"ر",1,0],["تُبَغّي أَذاها وَإِعسارَها","وَحَولَكَ غَوثٌ وَأَنعامُها",37,"م",3,0],["تبغي الندى وحيث لج الجود مورده","عذب وتنتجع الأملاك والدولا",38,"ل",2,0],["تبغي النجاة ولم تملك طريقتها","إن السفينة لا تجري على اليبس",39,"س",1,0],["تَبَغّتْ جِوَاراً في مَعَدٍّ فَلم تَجِدْ","لحُرْمَتِها كالحَيّ بَكْرِ بنِ وَائِلِ",40,"ل",1,1],["تبغي المزيد من الصبّابة والهوى","وتلحّ لا تحنو ولا تترفّق",41,"ق",1,0],["تبغي التجارة بالخيا","نة انت بئس المحترف",42,"ف",1,0],["تبغي البقاء بذي الدنيا تعظ وافق","هل للبقاء الذي تبغي علامات",43,"ت",1,0],["تبغي المفاخر انذال ويدفعهم","عن المفاخر اخلاق ذميمات",43,"ت",1,0],["تبغي حياة لا تحس صروفها","وتذم طول تصوبٍ وتصعد",44,"د",1,1],["تبغي القرى جودا وان تقرى فيا","بشراي بالاسعاف والاسعاد",45,"د",1,0],["تبغي القرى فعسى تقرى اذا تليت","يوماً وتصغى لها الاسماع والمقل",46,"ل",1,0],["تبغي على الفتح السداد لها ومن","يبغي سداد الحال ليس بلام",47,"م",1,0],["تبغددت حتى قيل إني مبغددٌ","له في ثرى الفردوس والخلد ميعاد",48,"د",1,0],["تبغون الاستقلال ؟ تلك طريقهُ !","ولقد أخذتم بالطريق فيمموا",49,"م",3,0],["تبغي ديار أحبةٍ","كانت عليهم راضيه",50,"ي",2,0],["تَبغي الرعيَّةُ من أبيها خيرَها","فَيصُدُّها عن خيرها آباؤُها",51,"ا",3,0],["تَبغي صِيانة ما حويت بِبَذلِهِ","في خُفيَةٍ وَبَقاؤُهُ بِنَفادِهِ",52,"د",2,0],["تبغي مع الركب إدراك المفاز غداً","وأنت أقعد دون الركب من بذج",53,"ج",1,0],["تبغي من الإِخوان أخلص دعوةٍ","في ظهر غيب عن فؤاد ضارع",54,"ع",1,0],["تبغيِ ديونا من بني عوفٍ لها","عُقِدتْ بغير الَمطل واللَّيّانِ",55,"ن",1,0],["تَبغي القِرَى في مُسدِفٍ","أكلفَ مدلهمِّ",56,"م",1,0],["تبغِي الندَى وأين من مُرادِه","طيُّ الفلا وأين من مُرادِها",57,"د",3,0],["تبغَّضْ إذا كنتَ الفقيرَ وإن تكن","غنيّاً فطامِنْ للغنَي وتحبَّب",58,"ب",1,0],["تبغي إذا ما الآلُ عبَّ عُبابَهُ","يا ويحَها ممّا يُرقرِقُ مَشرَعا",59,"ع",2,0],["تبغي دنوَّ الدارِ بعدَ بِعادِها","هيهاتَ قد أعيتْ على الطُّلاّبِ",60,"ب",1,0],["تَبغي قَوَّالاً نَطوقاً أَنِقاً","وله زِيقٌ وَسيعٌ أَخضَرُ",61,"ر",1,0],["تبغض ما استعطت وعش سليماً","فأنت أحب مخلوقٍ إليا",62,"ي",2,0],["تَبَغّياً ما لَيسَ لي حَلالا","عَلَّ الإِلَهُ الباعِثَ الأَثقالا",63,"ل",2,0],["تبغي ابتراداً منشطا جسما لذا","في اليمّ للحسناء طاب تطهر",64,"ر",1,0],["تبغى الرضا مهرا وقد طوقتها","درا غلا في جيدها هو بارق",65,"ق",1,0],["تبغي من الكُفوِ لها الصيانه","فهي لدى طالبِها أمانه",66,"ه",1,0],["تبغي مسالمة الزمان سفاهة","وتروم منه الود وهو ملول",67,"ل",1,0],["تَبغي بِذا رَفعِ إِيهامٍ لِمُبصرها","وَمُبصِرُ الحبِّ أيٌّ كَوكبُ الأفقِ",68,"ق",1,0],["تَبغي نَذيراً وَأَتاكَ ألف","مَضبوطَةً ما صح فيها خلفُ",69,"ف",1,0],["تَبغي فُضول الدُنيا مكاثرةً","حَتّى أُبيحَت كَرهاً ذَخائرها",70,"ر",3,0],["تبغٌ من الشهباء يزكو شمّهُ","حيّاهُ من مستجبٍ مسترغبِ",71,"ب",1,0],["تبغم من ورائه لداته","وهو يرابيها بعين راصد",72,"د",1,0],["تبغي على ودّي دلايل وبرهان؟","قلبِك دليلك والحكم مِنْه كافي",73,"ف",2,0],["تبغي الثناءَ وما نبتك حداثة","عن سعي كفل للأمور مدّبرِ",74,"ر",1,0],["تبغي على ماجدٍ ما رامه أحدٌ","إلاَّ وعادَ بطرفٍ عنه ينحسر",75,"ر",1,0],["تَبغي رِضاكَ فَإِن فيهِ لَها العُلا","وَالحليَ وَالمِسكَ الذَكي وَالعَنبَرا",76,"ر",2,0],["تَبغي لِيَفعل شاعر ما قالَهُ","وَاللَهُ قالَ يَقول ما لا يَفعل",77,"ل",1,0],["تَبغى النَجاة لَها مِن الدُنيا وَهَل","يَنجو قَنيصٌ مِن مخالب ضاري",78,"ر",2,0],["تبغي نجاة من شدائدها ولا","تلقى إلى سبل النجاة دليلا",79,"ل",2,0],["تبغين الحقاب ويطن برم","وقنع من عجاجتهن صار",80,"ر",1,1],["تبغي المعين وأنت في زمنٍ به","ذو الدين وفق النص في الغرباء",81,"ا",2,0],["تَبَغَّيتَ الذُنوبَ عَلَيَّ جَهلاً","جُنوناً ما جُنِنتَ اِبنَ اللَكاعِ",82,"ع",1,0],["تبغي قِرى الضَّيف في إثارتها","وذاك دأب الكرام في العربِ",83,"ب",1,0],["تبغي السباق على هجين ظالع","يكبو إذا ما سار في الميدان",84,"ن",1,0],["تبغي مصافحة السماء إذا علت","فيردها شوقاً اليه غدير",85,"ر",1,0],["تبغوا بحبّ المصطفى بديلا","وأهملوا فسادَ كل غرِّ",86,"ر",1,0],["تبغينَ تعليم البنات ونشره","ويلجّ دهرك في العِناد ويظلمُ",87,"م",1,0],["تبغي مناها في مناها عند