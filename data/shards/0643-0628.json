بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[366,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[377,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[377,"أهل الفنى يتمسكون حقيقة","https://www.aldiwan.net/poem66918.html","الكامل"],[380,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[393,"عناني من الهم ما قد عناني","https://www.aldiwan.net/poem53405.html","المتقارب"],[400,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[416,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[416,"كم قد ألين لمن قسا بصدوده","https://www.aldiwan.net/poem53923.html","الكامل"],[416,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[416,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[429,"يا صاحبي من الملام دعاني","https://www.aldiwan.net/poem40502.html","الكامل"],[429,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[432,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[437,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[453,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[458,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[458,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[458,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[458,"قل لها أيها الخيال الطروق","https://www.aldiwan.net/poem56105.html","الخفيف"],[461,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[464,"بجدك أعطاف القنا تتعطف","https://www.aldiwan.net/poem3114.html","عموديه"],[464,"خليلي عوجاً بالمحلة إنها","https://www.aldiwan.net/poem3140.html","عموديه"],[464,"عق دمعي من بعد أهل العقيق","https://www.aldiwan.net/poem3605.html","عموديه"],[464,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[482,"كبرت همّة عيني","https://www.aldiwan.net/poem24458.html","عموديه"],[495,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[495,"قسما لقد عجم الزمان","https://www.aldiwan.net/poem9819.html","مجزوء الكامل"],[500,"ما رفرف السعد إلا في محاضرنا","https://www.aldiwan.net/poem37998.html","البسيط"],[500,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[501,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[538,"مقامك يا أبا حفص عظيم","https://www.aldiwan.net/poem47955.html","عموديه"],[538,"ولي لعهد كبدر منير","https://www.aldiwan.net/poem48156.html","عموديه"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[553,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"],[558,"طلعت شمس الوجود","https://www.aldiwan.net/poem34655.html","مجزوء الرمل"],[561,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[567,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[567,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[583,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""]],"verses":[["كَبّوا عَلى أَذقانِها أَصنامَها","لا وَدَّها أَبقوا وَلا سُواعَها",0,"ع",3,0],["كَبَتُّ الحَسودَ النَدبَ حَتّى كَبَبتُهُ","فَمَن عاذِري يَوماً مِنَ الحاسِدِ الوَغدِ",1,"د",1,0],["كَبا زَنَدي بِحَيثُ رَجَوتُ مِنهُ","مُساعَدَةَ الضِياءِ فَخابَ قِدحي",2,"ي",1,0],["كَبا الدَهرُ بَيني وَبَينَ المُنى","وَطالَ بِزَندِ الرَجاءِ اِقتِداحي",3,"ح",2,0],["كَبُدورٍ عَلى غُصونٍ ظِماءٍ","في حُقوقٍ تُقِلُّهُنَّ رِواءِ",4,"ا",2,0],["كَبِدٌ تَذوبُ وَمَدْمَعٌ هَطِلُ","فَمتى يُوَرِّعُ صَبْوَتي عَذَلُ",5,"ل",1,1],["كَبَردِيَّةِ الغيلِ وَسطَ الغَريفِ","إِذا خالَطَ الماءُ مِنها السُرورا",6,"ر",2,0],["كَبَّلوهُم قَتَلوهُم مَثَّلوا","بِذَواتِ الخِدرِ طاحوا بِاليَتامى",7,"م",2,0],["كَبِكرِ المُقاناةِ البَياضِ بِصُفرَةٍ","غَذاها نَميرُ الماءِ غَيرُ المُحَلَّلِ",8,"ل",1,0],["كبير المنى جم الفضائل جامع","إلى الأدب السلسال طبعاً هو الشهد",9,"د",1,0],["كَبَا بِهِ الْجَدُّ وَشِيكاً كَمَا","كَبا جَوَادُ الْفَارِسِ المُعْلَمِ",10,"م",1,0],["كُبرت لنفسك في الحياة لُبانة","ضاقت سموات بها وأروض",11,"ض",1,0],["كُبَيشَةُ حَلَّت بَعدَ عَهدِكَ عاقِلاً","وَكانَت لَهُ خَبلاً عَلى النَأيِ خابِلا",12,"ل",2,1],["كبيت العنكبوت وجدت بيتا","يَمُدَ على قضاعة أجمعينا",13,"ن",2,1],["كَبِساطِ وَشيٍ جَرَّدَت","أَيدي القُيونِ عَلَيهِ نَصلا",14,"ل",2,0],["كَبِرتُ كَذاكَ المَرءُ ما عاشَ يَكبُرُ","وَقَد يَهرَمُ الباقي الكَبيرُ المُعَمَّرُ",15,"ر",1,1],["كبير فخار الذكر في الخلقِ كلما","تلا قارئٌ أو قيلَ الله أكبرُ",16,"ر",1,0],["كبيرة فاضت على جبهةٍ","قلت نعم مع أنَّها سهلهْ",17,"ه",1,0],["كَبِنْتِكَ حين تَأتَّتْ له","فأضحتْ رئيسةَ أصحابِهِ",18,"ب",2,0],["كبدي مُذْ دُهِيتُ فِي","كَ بِكَفَّيْ مُفَتِّتِ",19,"ت",1,0],["كبرت وفي خمس وخمسين مكبر","وشبت فألحاظ المهَا منك نُفَّرُ",20,"ر",1,1],["كبرتَ فغيرُك الغِرُّ الغُلامُ","وغير قناعك الجَعْدُ السُّخامُ",21,"م",1,1],["كَبداءَ دَفقاءَ مِحيالٍ مُجَمَّرَةٍ","مِثلِ الفَنيقِ عَلاةٍ رَسلَةِ الخَبَبِ",22,"ب",1,0],["كَبَقِيَّةِ الهِندِيِّ أَمسى جَفنُهُ","خَلَقاً وَلَم يَكُ في العِظامِ نَكولا",23,"ل",2,0],["كَبِّليني بهاتِهِ الخِصَلِ المرخَاةِ","في فتنَةِ الدَّلالِ المَلُولِ",24,"ل",1,0],["كبِّلي يا سَلاسلَ الحبِّ أفكا","ري وأحلامَ قلبيَ الضَّلِّيلِ",24,"ل",1,0],["كبِّليني بكلِّ مَا فيكِ من عِطْرٍ","وسحرٍ مُقَدَّسٍ مَجْهولِ",24,"ل",1,0],["كبِّليني فإنَّما يُصْبِحُ الفنَّان","حرًّا في مِثْلِ هذي الكُبولِ",24,"ل",1,0],["كبيرٌ على النَّفسِ هذا العفاءُ","وصَعْبٌ على القلبِ هذا الهمودْ",25,"د",1,0],["كَبِرتَ جَميلُ وَأَودى الشَبابُ","فَقُلتُ بُثَينَ أَلا فَاِقصُري",26,"ي",1,0],["كبر شفني فلم يبق عندي","غير قلب يئن تحت الحنايا",27,"ي",2,0],["كبرت هذه الطبيعة حتى","وسعت لا نهاية الابعاد",28,"د",1,0],["كبر الألى من طيب اعراق لهم","كانوا اذا لؤم السفيه كراما",29,"م",2,0],["كبر ثم نكايات","واعداء صعاب",30,"ب",1,0],["كبت الشبيبة في اللجام وطالما","ظن الأعنة لا ترد لجامها",31,"م",3,0],["كبير في المواقف لا جهول","بآداب الخطاب ولا مخل",32,"ل",1,0],["كبناتِ فرعونٍ شهدن مواكبا","تحت المراوح في نهارٍ ضاح",33,"ح",1,0],["كَبَصَرِ الأَعشى أَصا","بَ في الظَلامِ وَنَبا",34,"ب",2,0],["كَبُرَ الشِبلُ وَشَبَّت نابُهُ","وَتَغَطّى مَنكِباهُ بِاللُبَد",35,"د",1,0],["كَبِدٌ عَلى دَمِها اِتَّكَأتَ وَلَحمِها","فَحَمَلتَ هَمَّ المُسلِمينَ سِنيا",36,"ن",3,0],["كِبرُ الغَضَنفَرِ يَومَ ذَلِكَ زادَهُ","مِن نَخوَةٍ وَحَمِيَّةٍ وَإِباءِ",37,"ا",2,0],["كَبِساطِ الريحِ في القُدرَةِ أَو","هُدهُدِ السيرَةِ في صِدقِ البَلاء",38,"ا",2,0],["كَبيرُ السابِقينَ مِنَ الكِرامِ","بِرُغمي أَن أَنالَكَ بِالمَلامِ",39,"م",1,1],["كَبُرَت ذاتُكَ العَلِيَّةُ أَن تُح","صي ثَناها الأَلقابُ وَالأَسماءُ",40,"ا",2,0],["كَبَنانِ عَبدِ الواحِدِ الغَدَقِ الَّذي","أَروى وَآمَنَ مَن يَشاءُ وَأَفزَعا",41,"ع",2,0],["كَبَّرتُ حَولَ دِيارِهِم لَمّا بَدَت","مِنها الشُموسُ وَلَيسَ فيها المَشرِقُ",42,"ق",1,0],["كَبُرَ العِيانُ عَلَيَّ حَتّى إِنَّهُ","صارَ اليَقينُ مِنَ العِيانِ تَوَهُّما",43,"م",2,0],["كبريتة من أرضنا خرجت","صبغ اللجين بشمسها ذهبا",44,"ب",2,0],["كَبيرٌ لَدى الرُزءِ الكَبيرِ وَإِنَّما","عَلى قَدرِ جِرمِ الفيلِ تُبنى قَوائِمُه",45,"م",2,0],["كَبِطّيخَةِ الزَرّاعِ يُعجِبُ لَونُها","صَحيحاً وَيَبدو داؤُها حينَ تُفلَقُ",46,"ق",1,0],["كَبابٌ مِنَ الأَخطارِ كانَ مُراحُهُ","عَلَيها فَأَودى الظُلفَ مِنهُ وَجامِلُه",47,"ل",2,0],["كبكر أسفرت عبثا","وولّت وهيَ تنتقبُ",48,"ب",1,0],["كَبِركَةِ جَمْرٍ على صَاجِها","بقايا تَفَتُّحِ لَينُوفَرِ",49,"ر",1,0],["كَبا الأعداءِ إذا راموكَ جَهْلاً","فقلْنا للجِباهِ وللثُّغور",50,"ر",1,0],["كَبوَةُ الهمِّ بين كاسٍ وكُوبِ","واغتباطِ المُحِبِّ والمَحبوبِ",51,"ب",1,1],["كبعضِ الصيَّدِ يُرزَقُ منه مُخطٍ","ويُحرَمُ خيرَه الرامي المصيبُ",52,"ب",1,0],["كَبداءُ مُقبِلَةً وَركاءُ مُدبِرَةً","قَوداءُ فيها إِذا اِستَعرَضتَها خَضَعُ",53,"ع",1,0],["كَبيرَةُ مَغرَمٍ أَن يَحمِلوها","تُهِمُّ الناسَ أَو أَمرٌ عَظيمُ",54,"م",1,0],["كَب