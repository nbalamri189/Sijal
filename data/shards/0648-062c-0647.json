https://www.aldiwan.net/poem34573.html","الكامل"],[559,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[559,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[559,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[559,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[559,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[559,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[559,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[559,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[559,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[568,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"],[576,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[576,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[587,"عودي إلى حسن التأتي","https://www.aldiwan.net/poem17458.html","مجزوء الكامل"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["وَجَهِلنا الرُسومَ ثُمَّ عَرَفنا","فَذَكَرنا الأَوطارَ بِالأَوطانِ",0,"ن",1,0],["وَجهٌ كَأَنَّ البَدرَ شا","طَرَهُ الضِياءَ أَو النُجوما",1,"م",2,0],["وَجهٌ كَظَهرِ المِجَنِّ مُشتَرَقُ ال","حُسنِ وَأَنفٌ كَغارِبِ الجَمَلِ",2,"ل",1,0],["وَجهي رَقيقٌ يَستَشِفُّ الحَيا","مِنهُ وَقَلبي دونَهُ قاسِ",3,"س",1,0],["وَجهي مَجالٌ لِلطَعانِ فَما","خَوفي لِقاءَ الحَرِّ وَالبَردِ",4,"د",1,0],["وَجهٌ كَلَمحِ البَرقِ غاضَ وَميضُهُ","قَلبٌ كَصَدرِ العَضبِ فُلَّ مَضاؤُهُ",5,"ا",3,0],["وجْهٌ يَجولُ البِشْرُ في صَفَحاتِهِ","ويَدٌ تَنوبُ عنِ الحَيا إنْ برّضا",6,"ض",2,0],["وَجَهٌ يَكِلُّ الطَرفُ عَنهُ إِذا بَدا","هُوَ بِالعَفافِ وَبِالتُقى مَوسومُ",7,"م",1,0],["وَجّهْتُها لتَنوبَ فيهِ","وفي هَنائِكَ بالمَطَرْ",8,"ر",1,0],["وجْهُكَ في النّائِباتِ بدْرُ دُجىً","لَنا وفي المحْلِ كفُّكَ المطَرُ",9,"ر",1,0],["وَجهٌ وَلا وَجهُ الخُطو","بِ وَقامَةٌ لَم تُشبَرِ",10,"ر",1,0],["وَجهٌ كَريهٌ وَأَخلاقٌ مُذَمَّمَةٌ","فَما عَلِمناهُ مَحبوباً إِلى أَحَدِ",11,"د",1,0],["وَجْهُكَ الطَّلْقُ وَهْوَ نُورٌ تَجَلَّى","فِي عُذَارٍ حَلاَهُ بِدءُ المَشِيبِ",12,"ب",1,0],["وَجْهُ الثَّمَانِينَ وَشِعْرُ الصِّبَا","أَلشَّيْبُ حِلْيَ الأَنْفُسِ الكَامِلَهْ",13,"ل",2,0],["وَجَهْرِي جَهْدَ مَا تَسَعُ المَعَانِي","بِمَدْحِ شَقِيقِهِ السَّنِمِ المقَامِ",14,"م",1,0],["وجهادك وابتدارك","القلوب به مستنيرا",15,"ر",2,0],["وجهٌ كما حَسَرَ الصباحُ نِقابَهُ","لضيائه تعشو البدور الكُمَّلُ",16,"ل",1,0],["وجهٌ كما حَسَر الصباحُ نِقابَهُ","ويدُ تمدُّ أناملاً ببحارِ",17,"ر",1,0],["وجهان فيها باطن متستِّر","للأجنبيّ وظاهر متكشِّف",18,"ف",1,0],["وجهِلتم النهج السَوِيَّ إلى العلا","فترادفت منكم بها العَثَرات",19,"ت",1,0],["وَجَهَدتَ جَهدَكَ يا فَرَزدَقُ كُلَّهُ","فَنَزَعتَ لا ظَفِراً وَلا مَحمودا",20,"د",2,0],["وَجَهَّزتُ في الآفاقِ كُلَّ قَصيدَةٍ","شَرودٍ وَرودٍ كُلَّ رَكبٍ تُنازِعُ",21,"ع",1,0],["وَجهُكَ وَالبَدرُ إِذا أُبرِزا","لِأَعيُنِ العالَمِ بَدرانِ",22,"ن",1,0],["وجهَّز جيش العسر من طالبي الندى","فلابن عليٍّ في الورى وصفُ عثمان",23,"ن",1,0],["وَجهُكَ المَأمولُ حُجَّتُنا","يَومَ يَأتي الناسُ بِالحجَجِ",24,"ج",1,0],["وجهٌ إذا ما بدت للناس سُنَّتُهُ","كانت محاسنُهُ حَوْلاً لهم سُبَحَا",25,"ح",2,0],["وجهك يا جعفر في قبحه","أولى من العورة بالسترِ",26,"ر",1,0],["وجه عليه مسحة لم تزل","تَلْحظها عين بإنكار",27,"ر",1,0],["وجهي يرق عن اقتضائكَ حاجتي","وإذا سكتُّ نسيتَ أو تتناسَى",28,"س",2,1],["وجهها الأغثر المجدَّر يحكي","جعسَ أمسٍ أصابَ أعلاه طشُّ",29,"ش",1,0],["وجهٌ إلى كم تصيد رِقَّتُهُ","قلبي وقلبٌ كم أشتكي غِلظه",30,"ظ",2,0],["وجهت نحوي معروفاً تعاظمني","إلا لقدرك إن الحق مكشوف",31,"ف",1,0],["وجهك ذاك الجميل سحَّبني","عليك حتى سألتك التحفا",32,"ف",2,0],["وجهك يا عمرو فيه طولُ","وفي وجوه الكلاب طولُ",33,"ل",1,0],["وجهٌ طويلٌ يسيل فوه","أحسنُ منه حِرٌ يبولُ",33,"ل",1,0],["وجهُك الساطعُ نُوراً","وعطاياك الجِسامُ",34,"م",1,0],["وجهٌ زكا قُبحُه برأسٍ","قَمْقَمَ من قحفه المُقَمقمْ",35,"م",1,0],["وجهلِ عَيْرين إن سألتهما","عن بابِ علم وحُمق تيسين",36,"ن",1,0],["وجهٌ كما للصالحين وما عنى","للصالحين فشاهَ كلَّ مَشاه",37,"ه",1,0],["وَجَّهتُ عَنسي إِلى حُلوٍ شَمائِلُهُ","كَأَنَّ سُنَّتَهُ في المَسجِدِ القَمَرُ",38,"ر",1,0],["وَجَهِلوا وَلَم تَجَهل نُفوسُهُمُ الأَسى","أَشقى الأَنامِ العارِفُ المَجهولُ",39,"ل",1,0],["وَجهُهُ غَيرُ وَجهِهِ","أَم عَلى وَجهِهِ لِثام",40,"م",1,0],["وَجهي سَنِيٌّ مُشرِقٌ إِنَّما","مَرعى عُيونِ الخَلقِ وَجهِيَ السَني",41,"ي",1,0],["وَجهُهُ يَجمَعُ المَسَر","رَةَ لِلقَلبِ وَالحَزَن",42,"ن",1,0],["وَجهُهُ البُستانُ فاِقطِف","آسَهُ أَو فَاِجنِ وَردَه",43,"د",2,0],["وَجِّهْ طُيورَ الشَعر نَحوي فَقَد","بَثّ فُؤادي شَرَكَ الفَهمِ",44,"م",1,0],["وجه كما تهوى الطبيعة سافر","ما ان عليه سوى السنى من برقع",45,"ع",1,0],["وجه صبيح ذو روا","ء مثل زنبقة نضيره",46,"ر",2,0],["وجه القضية غيرته حوادث","أعطت بأيد غير ذات أيادي",47,"د",2,0],["وَجهُ الكِنانَةِ لَيسَ يُغضِبُ رَبَّكُم","أَن تَجعَلوهُ كَوَجهِهِ مَعبودا",48,"د",2,0],["وجهٌ كيومِ الصحوِ مبتسمٌ","ويدٌ كلَيلِ الدّجْنِ تنهملُ",49,"ل",1,0],["وجهٌ يصوبُ البِشْرُ من صفحاته","يشقَى برؤيتِه النهارُ الماتِعُ",50,"ع",1,0],["وَجَّهَ الحَقَّ بَينَ أَخذٍ وَإِعطا","ءٍ وَقَصدٍ في الجَمعِ وَالتَبديدِ",51,"د",1,0],["وَجِّه رِكابَكَ مُصعِداً يَصعَد بِنا","جَدٌّ يَحِلُّ بِما نَرومُ وَنَظفَرِ",52,"ر",1,0],["وَجَهلٌ بَيِّنٌ في ذي مَشيبٍ","غَدا يَغتَرُّهُ الرَشَأُ الغَريرُ",53,"ر",1,0],["وَجهُكَ قَد حَرَّمَ هِجرانَهُ","وَلِلأَماني فيهِ مُستَمتَعُ",54,"ع",1,0],["وَجهٌ لِعَينُ القِسمَينِ يَقطَعُهُ","أَنفٌ طَويلٌ مُحَدَّدُ الطَرَفِ",55,"ف",1,0],["وَجَهولٍ رَمى لَدَيهِ مَكاني","قُلتُ أَقصِر ما كُلُّ رامٍ بِمُصمِ",56,"م",1,0],["وَجَهلٍ بِحِلمٍ قَد دَفَعنا جُنونَهُ","وَما كانَ لَولا حِلمُنا يَتَزَحلَفُ",57,"ف",1,0],["وجه دمشقي رأيت خلاله","أجفان بلقيس وجيد سعاد",58,"د",1,0],["وَجَهَدتُ أَنّي لا أَسيرُ مُيَمَّماً","حَتّى أُمَثَّلَ بِالمَقَرِّ العالي",59,"ل",2,0],["وَجهٌ تَحُفُّ بِهِ فَرائِدُ عَسجَدٍ","كَالعِقدِ في بَندِ الكَلاءِ مَنَظَّمِ",60,"م",1,1],["وَجهٌ مِنَ البَدرِ أَحلى","وَمِنهُ بِالمَدحِ أَحرى",61,"ر",2,1],["وجهَّزَ للأعداءِ كلَّ عَرَمرَمٍ","يغادرُ بالأرماح أرواحهم نهبا",62,"ب",2,0],["وَجَّهَ العيسَ وَهيَ عيسٌ إِلى اللَ","هِ فَآلَت مِثلَ القِسِيِّ حَطيم",63,"م",1,0],["وجهُهُ كالرغيفِ يعلوهُ ملحٌ","فاعذروني في حفظِ خبزٍ وملحِ",64,"ح",1,0],["وجهُها البدرُ منْ سحائبِ وشيٍ","قدْ تجلَّى على الورى وأضاءَ",65,"ا",2,0],["وَجهُكِ الوَجهُ لَو بِهِ تَسأَلُ المُز","نَ مِنَ الحُسنِ وَالجَمالِ اِستَهَلّا",66,"ل",2,0],["وَجهٌ بِهِ مِن بِدَعِ الحُسنِ ما","يُقيمُ لِلعُشّاقِ أَعذارا",67,"ر",2,0],["وَجَهِدْتِ تَبنينَ العُروبةَ كُلَّما","أَبْصَرتِ حَائِطَها بِغيرِ عِمادِ",68,"د",1,0],["وَجهٌ يُضيءُ وَيُمنى سَيبُها غَدِقٌ","كَالبَدرِ وافَقَ فَيضَ النيلِ مَطلِعُهُ",69,"ع",2,0],["وَجهُهُ الرَوضُ وَالحَيا","مِنهُ مَعسولُ ريقَتَين",70,"ن",1,0],["وَجه القَضية مِن جِهادك مُشرقُ","وَعَلى جِهادك مِن وقارك رَونَقُ",71,"ق",1,1],["وَجهٌ تَحَيَّرَ مِنهُ الماءُ في بَشَرٍ","صافٍ لَهُ حِينَ أَبدَتهُ لَنا نُورُ",72,"ر",1,0],["وَجَهِلتُ ما جَهِلَ الفَتى زَمَنَ الصِبا","فَالآنَ قَد وَعَظَ المَشيبُ وَفَوَّها",73,"ه",2,0],["وَجَّهَ الصُنعَ لي وَجَلّى لِيَ الكَر","بَ إِلَهٌ رَبٌّ لَطيفٌ رَحيمُ",74,"م",1,0],["وَجَّهَت نَفسِيَ الرَجاءَ إِلَيهِ","فَأَقامَت عَلى اِنتِظارِ نَوالِه",75,"ل",2,0],["وَجِهادي عَواذِلاً فيكِ لا يَب","رَحنَ بِاللَومِ غُدوَةً وَاِبتِكارا",76,"ر",2,0],["وجَهَّزَ جَيشاً سار في وقت عُسْرَةٍ","تَعَذَّرَ مِنْ قوتٍ به الصَّاعُ والمُدُّ",77,"د",1,0],["وجهُهُ مُسْفِرٌ لِعَاقِبِهِ ما نح","تَاجُ في الجُودِ عِنْدَهُ لِسفارَهْ",78,"ر",2,0],["وَجَهَّزْنا وُلاةَ الْحَرْبِ لَيْلاً","عَلَى أنْ يَكْبِسُوهُمْ مُصْبِحِينا",79,"ن",2,0],["وجْهٌ بجَوْهَرِ ماء العرْشِ مُتّصِلٌ","عِرْقٌ بمحض صريحِ المجد مرتبط",80,"ط",1,0],["وَجهي إِذا أَقبَلتُ يَشفَعُ لي","وَعَذابُ قَلبِكَ حُسنُ ما خَلفي",81,"ف",2,0],["وَجهُ حَمدانَ فَاِحذَرو","هُ كِتابُ الزَنادِقَه",82,"ق",2,1],["وَجهُهُ البَدرُ وَالمُدامَةُ بَدرٌ","يا لِبَدرَينِ رُكِّبا في نِظامِ",83,"م",1,0],["وَجهُ جِنانٍ سَراةُ بُستانِ","مُجتَمِعٌ فيهِ كُلُّ أَلوانِ",84,"ن",1,1],["وَجهُ بَنانٍ كَأَنَّهُ قَمَرٌ","يَلوحُ في لَيلَةِ الثَلاثينِ",85,"ن",1,1],["وَجهُها الوَجهُ لا تُطاعانِ فيهِ","فَاِنزِلا البُعدَ أَو أَريدا مُرادي",86,"د",2,0],["وَجهُ شَمسٍ بَدا بَعَينَي غَزالٍ","في عَسيبٍ مُقَوَّمٍ مَيّادِ",86,"د",1,0],["وَجَّهتَ عَن بِنتِ السَبيلِ سَبيلَهُ","بِمَحالَةٍ وَرَدَعتَهُ بِجَوابِهِ",87,"ب",2,0],["وَجَهِلتُ أَمري غَيرَ أَنّي سالِكٌ","طُرقاً وَخَتها عادُها وَثَمودُها",88,"د",3,0],["وَجَهَرتُ مِن قُلُبِ الوِدادِ ذَمامَها","فَذَمَمتُ في سِرّي وَعِندَ جِهاري",89,"ر",2,0],["وَجَهلٌ مُرادُ كَما في المَقيظِ","عَهداً مِنَ الوَردِ وَالأُقحُوانِ",90,"ن",1,0],["وجهُ ربيعٍ أتاكَ باكرُهُ","يرفُلُ في حَلْيهِ وفي حُلَلهْ",91,"ل",2,0],["وَجهٌ عليهِ مِنَ الحياءِ سَكينَةٌ","وَمَحَبَّةٌ تجري مَعَ الأنفاسِ",92,"س",1,0],["وجه تألق ثم زالَ كأَنَّه","برق بحاشية السماء لموع",93,"ع",1,0],["وجه طليق وعين","يقظى وقلب ولوع",94,"ع",1,0],["وَجِّهوهُ إِلى الفَلاحِ يُفِدكُم","فَوقَ ما يَستَفيدُهُ مِن دُروسِ",95,"س",1,0],["وجهه فهبّ والغزاةَ","كما أطار الصُيِّدُ البزاةَ",96,"ه",1,0],["وجه الكنانة ليس يغضب ربكم","أن تجعلوه بينكم معبودا",97,"د",2,0],["وَجهٌ أَرَقُّ مِنَ النَسيمِ يُغَيُرُني","مَرُّ النَسيمِ بِوَجهِهِ وَهُبوبُهُ",98,"ب",2,0],["وجه الشام الذي رفّت بشاشته","من النّعيم لغير الله ما سجدا",99,"د",2,0],["وَجِهَادَهُ مَنْ يَستَغِلُّ جُهُودَهمْ","حِساً وَمَعْنى أَجْحَفَ استِغْلالِ",100,"ل",1,0],["وَجْهُهُ دَائِمُ الطَّلاَقةِ بِالبِشْرِ","وَنَهْرُ سَخَائِهِ فِي انْطِلاَقِ",101,"ق",1,0],["وَجهُهُ وَمَنطِقُه","جَنَّتانِ أَينَعَتا",102,"ت",2,1],["وِجْهَةُ الشرقِ غيرُها وجهةُ الغ","ربِ فأَنَّى وكيف يلتقيان",103,"ن",1,0],["وجُهُودُ جَبَّارِينَ تَصْغُرُ","دُونَهَا شُمُّ الْجُهُودِ",104,"د",1,0],["وجُهْدٌ من الفولاذِ ما كلَّ زَنْدُه","وصادقُ عزمٍ ليس فيه كِذاب",105,"ب",1,0],["وجُهودٍ تمثَّ