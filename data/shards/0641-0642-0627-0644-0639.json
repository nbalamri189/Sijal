{"poems":[[53,"نصحت أبا بكر فرد نصيحتي","https://www.aldiwan.net/poem9397.html","الطويل"],[71,"أمير محبوه جند له","https://www.aldiwan.net/poem28327.html","المتقارب"],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[83,"أقلد وجدي فليبرهن مفندي","https://www.aldiwan.net/poem61539.html","الطويل"],[69,"قل لعلي الذي صداقته","https://www.aldiwan.net/poem18135.html","المنسرح"],[69,"كم قلت للأكرم الحشاء أنصحه","https://www.aldiwan.net/poem18152.html","البسيط"],[50,"غدوت وما يشجي فؤادي خوادش","https://www.aldiwan.net/poem63271.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[53,"نصحتُ أبا بكر فردَّ نصيحتي","https://www.poetsgate.com/ViewPoem.aspx?id=27406",""],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[275,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[302,"وافتك والزهر في روض الدجى زهر","https://www.aldiwan.net/poem33266.html","البسيط"],[302,"بنفسي هيفاء المعاطف ناهد","https://www.aldiwan.net/poem33285.html","الطويل"],[505,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[564,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66745","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66846","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66746","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86682","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77610","الرجز"],[908,"","https://poetry.dctabudhabi.ae/diwan/poem/199309","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71030","المجتث"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133871","السريع"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104467","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201122","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200071",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205079","المتقارب"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121744","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3434,"","https://poetry.dctabudhabi.ae/diwan/poem/203219","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102390","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86337","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85165","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85234","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75702","الوافر"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104489","الطويل"],[5183,"الخيزران والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180267",""],[6068,"أأنت ضرير؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=192714",""]],"verses":[["فقال عذيري منك شَيْخاً مضلَّلاً","أنَبْخَلُ يا هذا وأختي تَسمَّحُ",0,"ح",1,0],["فقالَ عسى قلتُ أن ترعوي","وقالوا تعذّرَ قلتُ السلوُّ",1,"و",1,0],["فَقالَ عَلَيكَ اليَومَ أَسماءَ إِنَّها","أَطَبُّ بِهَذا وَالمُباطِنُ عالِمُ",2,"م",1,0],["فَقالَ عَلى التَأنيسِ طِبُّكَ حاضِرٌ","فَقُلتُ نَعَم لَو أَنَّهُ بَعضُ عُوَّدي",3,"د",2,0],["فقالَ عُدْ لِي إذَا احْتَمَيتُ وكُلْ","في كُلِّ يَوْمِ دَجَاجَةً دَهِنَهْ",4,"ن",2,0],["فقالَ عَبْدِي عِفْرِيتٌ فَقُلْتُ لَهُ","إنِّي أَخافُ عَلَيْهِ مِنْ سُلَيْمانِ",5,"ن",1,0],["فَقالَ عَروسٌ كانَ كِسرى رَبيبَها","مُعَتَّقَةٌ مِن دونِها البابُ وَالسَترُ",6,"ر",1,0],["فَقالَ عَسى أن تمهلونيَ لَيلَتي","إلى صبحها فالليل داج مروع",7,"ع",1,0],["فقال عّذيري منك شَيْخاً مكلَّفا","أنَبْخَلُ يا هذا وأختي تَسمَّحُ",8,"ح",1,0],["فَقَالَ عَلَيكُم بِقَفوِ الضَّلاَلِ","وحِرمَانِ عَافٍ إذَا مَا أعتفي",9,"ف",2,0],["فقال على الآتي سلامُ محمدٍ","لكَ الخيرُ يا ابنَ الأُمةِ اليعربية",10,"ه",1,0],["فقالَ على الهُدى والحقّ مَوتي","فأرضَى الله واسترضى الخِيارا",11,"ر",2,0],["فَقال عشقُك هَذا كلُّه عبَثٌ","فَقُلتُ عذلُكَ هَذا كلُّه هَذَرُ",12,"ر",1,0],["فَقالَ على اسم اللَه أولجهُ إنَّني","سأَجهدُ في صَبري له وأُجاهِدُ",13,"د",1,0],["فقالَ على المُضْنى يُصَالُ تهَجُّماً","بشرعِ الهَوَى مَعنًى فقلتُ يُصَالُ",14,"ل",1,0],["فَقَالَ عَسَى تلك العَبَاءةُ هَاتها","فقد اثبتت نفسيِ لها الصدقَ والعدلا",15,"ل",2,0],["فقال عليّ ممّ تَبكي فقال مِن","ضغائنَ قومٍ شَرُّهم أتوقّعُ",16,"ع",1,0],["فقال عليٌّ قال أنت محمد","بل الروحُ أملاه عليكَ مُباديا",17,"ي",2,0],["فقالَ عليٌّ فاعلموا من نبيّكمْ","كهارونَ من موسى فكفُّوا وأَقلِعوا",18,"ع",3,0],["فَقال عَلى رَغم العِدا متمثلاً","بِهِ في هَناءٍ للمشير صريح",19,"ح",1,0],["فَقالَ عَنّي أَيُّها الأَمواجُ","لِغَيريَ البراحُ وَالرواجُ",20,"ج",1,0],["فقال عليه بالإمامة سلموا","فقد أمر الرحمن أن تفعلوا كلا",21,"ل",2,0],["فقال عنديَ للسا","ئلينَ زَجْرٌ ونَهْرُ",22,"ر",1,0],["فَقالَ عِندي حيلة عَجيبه","تَنجو بِها مِن هَذِهِ المُصيبه",23,"ه",1,0],["فقال عندي لك أحدوثة","مليحة تكتب في الصحف",24,"ف",1,0],["فقال عذراً إن عيني لم تكد","تبصر إذ كانت أصيبت بالرمد",25,"د",1,0],["فقال علامَ اجتناب الرفاق","وصحبي صبحك لو تعدل",26,"ل",1,0],["فقال عندي غروس دوحٍ","تسرع في الخصب والنماء",27,"ا",2,0],["فقال علام الأسى والذهول","كأنك لست ابن هذي الدنا",28,"ا",1,0],["فقال على الأقْدامِ تسعى وتبْتغِي","مَقامِي وقد أمْسَيْتُ أسْعَآ على رَاسِ",29,"س",1,0],["فقالَ عبدُ اللَهِ ذا مُرادي","وبُغيتي من خالِقِ العبادِ",30,"د",1,0],["فقال عذول وهو أجهل قائل","رويدك لا تفنى، ومن لي بأن أفنى",31,"ن",2,0],["فقال عهْديَ بالآدابِ قد تلِفَتْ","قُلْتُ ابْنُ حاتِمٍ الأرْضَى تَلافاها",32,"ا",3,0],["فقالَ عصيتَني ولرُبَّ ناهٍ","عصيتُ ومَهْمهٍ حرَجِ القَتامِ",33,"م",1,0],["فَقالَ عَلَيكَ الحبُّ عارٌ وَسُبَّةٌ","اِذا ما رجوتَ الوَصلَ قبل وَفاتِكا",34,"ك",2,0],["فقال عقلي جوهر","فقلت كلا بل ذهب",35,"ب",1,0],["فقال علايكم بأتباعي وسنتي","فعضوا عليها بالنواجذ وارغبوا",36,"ب",3,0],["فقالَ عَلَيكِ بِفلاسَ تَكبَح","مَظالِمَهُ فَهيَ أَولى وَأصلَح",37,"ح",1,0],["فَقالَ عَلامَ اقتَصَصت الخَبَر","وَنَحنُ كَأَوراقِ هَذِي الشَّجَر",38,"ر",1,0],["فَقالَ عَواذلي وَدموع عيني","وَقَلبي في اِنسفساح وانصداع",39,"ع",1,0],["فقال على الدنيا العفا بتلهف","لمن بعدك اخترت الرحيل على البقا",40,"ق",2,0],["فقال علام يا مولاي قتلي","ولم أركب مطا غير الولاء",41,"ا",2,0],["فقال على حصر يقاوم حصره","لكلّ عيي في هواك هدير",42,"ر",1,0]]}