{"poems":[[186,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[354,"كانوا على الشرك يولون الجزيل ويح","https://www.aldiwan.net/poem15800.html","البسيط"],[438,"أبليت بعدك في الأنام ظنوني","https://www.aldiwan.net/poem12427.html","الكامل"],[556,"هجرتك خوف أقوال الوشاة","https://www.aldiwan.net/poem48022.html","الوافر"],[714,"","https://poetry.dctabudhabi.ae/diwan/poem/198329","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64709","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91094","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135656","الوافر"],[5409,"تركت وراءك البلد الأمينا","https://www.poetsgate.com/ViewPoem.aspx?id=155482",""],[5444,"بلد الألف ربوة","https://www.poetsgate.com/ViewPoem.aspx?id=205450",""],[186,"زمان الحمى هل من معاد فنطمعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55779&r=&rc=42",""]],"verses":[["وَلَو أَغفَلَ التاريخُ ذكرَ فِعالِهم","دَعا ناطقُ الآثارِ مِنها فَأسَمَعا",0,"ع",2,0],["وَلّوا غَداةَ تُوَلّوا عَن مَكارِمِهِم","وَمَزَّقوا عَدلَهُ بِالجَورِ تَمزيقا",1,"ق",2,0],["ولوِ اغْتَدَى بالصِّين رَبْعُكَ شاقَنِي","شوقي وفَرْطُ صبابَتي للصِّبن",2,"ن",1,0],["وَلَو أَغنى عنِ العشّاقِ شَيءٌ","وَدافَع عنهُمُ أغنتْ حُماتي",3,"ي",1,0],["ولو اغتنيت عن النهوض كفيتهم","فبذكر بأسك كلهم مذعور",4,"ر",1,0],["وَلو اغْتَدى مَنْ بالعِراقِ مُطاوعاً","لأَبي الوَليدِ لَمَا طَغَى حَجَّاجُهُ",5,"ج",2,0],["ولو أَغنَت عَن المَرء المَساعي","لَما مَنعت نُفوس مشتهاها",6,"ا",3,0],["ولو أغرست شوكاً ثم تسقي","دهوراً ما جنيت سواه دهرا",7,"ر",2,0],["ولو أغضيت بعض الطرف عما","عنته مطامع المستعمرينا",8,"ن",2,0],["ولو أغْوَته ما انصرَفَتْ قُواه","إلى حيثُ المها تختالُ وَجدا",9,"د",2,0],["ولو أغفل التأرخ ذكر فعالهم","دعا ناطق الآثار منها فأسمعا",10,"ع",2,0]]}