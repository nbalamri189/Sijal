ww.aldiwan.net/poem47146.html","الطويل"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[552,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[554,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[554,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[559,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[563,"يا آل ثابت بعد فقد كريمكم","https://www.aldiwan.net/poem52663.html","الكامل"],[563,"كنا نؤمل أن نهنئ نعمة","https://www.aldiwan.net/poem52689.html","الكامل"],[563,"من كان كاتب نون هذا الحاجب","https://www.aldiwan.net/poem52841.html","الكامل"],[563,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[576,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[576,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[576,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[581,"هيهات يفنى البغض بغض مثله","https://www.aldiwan.net/poem25194.html","عموديه"]],"verses":[["وَلَقَد تَكونُ مَحَلَّةً وَقَرارَةً","لِأَغَرِّ مِن وَلَدِ المُلوكِ هِجانِ",0,"ن",1,0],["وَلَقَد تَحِلُّ بِها مُرَبَّبَةٌ","ظَمَأى الوِشاحِ وَلِلبُرى غَصَّ",1,"ص",1,0],["وَلَقد تَبَدَّت إِذ تَبَ","دَّت بِاِستِتارٍ وَاِحتِشامِ",2,"م",1,0],["وَلَقَدْ تَشَاجَرَتِ الرِّمَاحُ فَكُنْتَ فِي","مَيْدَانِ نَصْرِكَ فَارِسَ الْفُرْسَانِ",3,"ن",1,0],["ولقدْ تَمازَجَ حُبُّهُ بجَوارِحي","كَتَمازُجِ الأجْسامِ في الأرْواحِ",4,"ح",1,0],["وَلَقَد تَمَنَّت أَن تَكونَ فَوارِسٌ","مِن آلِ أَيّوبَ الكِرامِ لَكَ الفِدا",5,"د",2,0],["وَلَقَد تَدارَكَ رَأيَنا في خالِدٍ","ماساءَ خَيلاً آخِرَ الدَهرِ",6,"ر",1,0],["ولقد ترى وجه اعتذارٍ للأولى","حبسوا الدموع فأنت أكرم عاذر",7,"ر",1,0],["ولَقَدْ تَكُونُ بِحُسْنِ رَأْيِكَ مُبْرِئاً","مَنْ رُوحُهُ لا جِسْمُهُ المَكْلُومُ",8,"م",1,0],["ولقد تراءى بأسُهُ وسماحُه","فأتى الجلالُ من الجمال بتوْءَمِ",9,"م",1,0],["ولقد تحلَق في الهواء وأن هوت","شرعوا الرءوس فناطحتها الهام",10,"م",1,0],["وَلَقَد تَواضَعَ مَن بِحَضرَةِ مالِكٍ","ما بَينَ مِصرَ إِلى قُصورِ عُمانا",11,"ن",2,0],["وَلَقَد تَرَكتُ بَني الزُبَيرِ بِمَأزِقٍ","لا طاعَةً تَبِعوا وَلا سُلطانا",11,"ن",2,0],["وَلَقَد تَسَقَّطَني الوُشاةُ فَصادَفوا","حَصِراً بِسِرِّكِ يا أُمَيمَ ضَنينا",12,"ن",2,0],["وَلَقَد تَرَكتُ أَباكَ يا اِبنَ مُسَحَّبٍ","حَطِمَ القَوائِمِ دامِيَ السيساءِ",13,"ا",2,0],["وَلَقَد تَرَكتُكَ يا فَرَزدَقُ خاسِئاً","لَمّا كَبَوتَ لَدى الرِهانِ لَهيدا",14,"د",2,0],["وَلَقَد تَبَيَّنَ في وُجوهِ مُجاشِعٍ","لُؤمٌ يَثورُ ضَبابُهُ لا يَنجَلي",15,"ل",2,0],["وَلَقَد تَرَكتُ مُجاشِعاً وَكَأَنَّهُم","فَقعٌ بِمَدرَجَةِ الخَميسِ الجَحفَلِ",15,"ل",1,0],["وَلَقَد تَكونُ إِذا تَحُلُّ بِغِبطَةٍ","أَيّامَ أَهلُكَ بِالدِيارِ حُلولُ",16,"ل",1,0],["وَلَقَد تُساعِفُنا الدِيارُ وَعَيشُنا","لَو دامَ ذاكَ بِما نُحِبُّ ظَليلُ",16,"ل",1,0],["وَلَقَد تَوَكَّلَ بِالسُهادِ لِحُبِّكُم","عَينٌ تَبيتُ قَليلَةَ التَهويمِ",17,"م",1,0],["وَلَقَد تَحمَدُ لَمّا فارَقَت","جارَتي وَالحَمدُ مِن خَيرِ خَوَل",18,"ل",1,0],["وَلَقَد تُجالِسُني فَيَمنَعُني","ضيقُ الذِراعِ وَعِلَّةُ الخَفرِ",19,"ر",1,0],["وَلَقَد تُقَلِّدُنا العَشيرَةُ أَمرَها","وَنَسودُ يَومَ النائِباتِ وَنَعتَلي",20,"ل",2,0],["ولقد تزيّد شعرُ من اسْتعفته","بنداكَ حسناً في الزمانِ مجددا",21,"د",2,0],["ولقد تمرّ الحادِثات على الفتى","وتزول حتى ما تمر بفكرِه",22,"ر",2,0],["ولقد تشكو فما أفهمها","ولقد أشكو فما تفهمني",23,"ن",2,0],["ولقد تطيبُ مع المشيب معيشةٌ","ويكون من بعد الخُفُوفِ تلبُّثُ",24,"ث",1,0],["ولقد ترانا نَنْتَحِيهِ ودونَه","للعيس أغبرُ واسعٌ قِرْواحُه",25,"ح",2,0],["ولقد تُنفَع النفو","سُ بما كان ضرَّها",26,"ر",3,0],["ولقد تحل بها الحسا","ن القاصرات الأنَّسُ",27,"س",1,0],["ولقد تربَّع لا تربَّع بعدها","وغدا يتيهُ بعُودهِ متقاعسا",28,"س",2,1],["ولقد تناجت بالرجوع مناهما","لو مُلِّكا بعد المضيِّ رجوعا",29,"ع",2,0],["ولقد تكونُ أهلَّةً","للناس في الظُّلَمِ الحوالكْ",30,"ك",1,0],["ولقد تمنّتْ كلُّ صاعقةٍ","لو أنها صُبَّتْ على كبدك",31,"ك",1,0],["ولقد تُصيبُ بديلَ كل مُبرِّزٍ","من مادحيك وليسَ مِنك بديلُ",32,"ل",1,0],["ولقد تفاوتَ والمُفاخرُهُ","كتفاوُتِ الوِجدان والعدمِ",33,"م",1,0],["ولقد تُسلّي القلبَ ذُكرتُه","أنِّي بأن ألقاك مرتَهَنُ",34,"ن",1,0],["ولقد ترى الشعراء في عثراتهم","فتليهُمُ بإقالةٍ تُرْضيني",35,"ن",2,0],["وَلَقَد تَكونُ بِها الرَبابُ لَذيذَةً","بِفَمِ الضَجيعِ ثَقيلَةَ الأَوصالِ",36,"ل",1,0],["وَلَقَد تَرُدُّ الخَيلَ عَن أَهوائِها","وَتَلُفُّ حَدَّ رِجالِها بِرِجالِ",36,"ل",1,0],["وَلَقَد تَناوَلتَ القُعورَ بِضَربَةٍ","وَبَني أَبي بَكرٍ ذَوي الأَصهارِ",37,"ر",1,0],["وَلَقَد تُباكِرُني عَلى لَذّاتِها","صَهباءُ عارِيَةُ القَذى خُرطومُ",38,"م",1,0],["وَلَقَد تَشُقُّ بِيَ الفَلاةَ إِذا طَفَت","أَعلامُها وَتَغَوَّلَت عُلكومُ",38,"م",1,0],["وَلَقَد تَأَوَّبُ أُمُّ جَهمٍ أَركُباً","طَبَخَت هَواجِرُ لَحمَهُم وَسُمومُ",38,"م",1,0],["وَلَقَد تَفانوا في اِنتِهاكِ حُقوقِهِ","وَهوَ المُحِبُّ رِضاهُمُ المُتَفاني",39,"ن",2,0],["وَلَقَد تَظَلَّلتُم بِأَشجارٍ فَهَل","رَفَّت غُصونٌ فَوقَكُم كَغُصوني",40,"ن",2,0],["وَلَقَد تَفَضَّلَ طَيفُكُم","لَيلاً وَأَنعَمَ بِالتَلاقي",41,"ق",2,0],["وَلَقَد تَرى الحَبَشِيَّ وَهوَ يَصُكُّها","أَشِراً إِذا ما نالَ يَوماً مَأكَلا",42,"ل",2,0],["ولقد تيقظت العيون من الكرى","يلفظن احلام الكسالى الهجع",43,"ع",1,0],["ولقد تمر على الكريم حوادث","حتى يود لو انه لم يولد",44,"د",1,0],["ولقد تحلب دمع عيني بعده","ما خير دمع ليس بالمتحلب",45,"ب",1,0],["ولقد توارى من ذكا","ء لهوله الوجه الاغر",46,"ر",1,0],["ولقد تبدل كل شيء","في حتى انملى",47,"ل",2,0],["ولقد تأخرت الانا","ث فما تقدمت الذكر",48,"ر",1,0],["ولقد تحملت المصائب كلها","من اجل اوطاني التي هي تظلم",49,"م",1,0],["ولقد تسقطين من حرف عيني","كالندى فوق كالئٍ معشاب",50,"ب",1,0],["ولقد تفرد كالعروس بقامة","هيفاء بين المورقات البان",51,"ن",1,0],["ولقد تنظر الفتاة اباها","والاسى ملء تلكم النظرات",52,"ت",1,0],["ولقد تَقطعُ كل أسباب الهوى","إلا حبالك فهي لم تتقطع",53,"ع",1,0],["ولقد تخذت من الضحى","صفر الغلائل والحلى",54,"ل",2,0],["ولقد تصونكم الدرو","ع ولا تخونكم المغافر",55,"ر",1,0],["وَلَقَد تَميلُ عَلى الجَما","دِ وَتَصرَعُ الفَلَكَ المُدار",56,"ر",1,0],["وَلَقَد تَعَوَّدَ أَن تَمُرَّ بِأَرضِهِ","مَرَّ الغَمامِ بِظِلِّهِ وَبِمائِهِ",57,"ا",3,0],["وَلَقَد تَمُرُّ عَلى الغَديرِ تَخالُهُ","وَالنَبتُ مِرآةً زَهَت بِإِطارِ",58,"ر",1,0],["وَلَقَد تُنهِكُهُ نَهكَ الضَنى","ضَرَّةٌ مَنظَرُها سُقمٌ وَضُر",59,"ر",1,0],["ولَقَدْ تأَمّلْتُ القُبورَ وأَهْلَها","فَتَشَتّتَتْ فِكري بها تَشْتِيتا",60,"ت",2,0],["ولقد تَرى والريحُ راسفةٌ إِذا","قِيستْ إليها والوميض حَرُونُ",61,"ن",1,0],["ولقد تمضمضُ بي الخطوبُ فلم تجدْ","لي في مَساغِ لَهاتِها مُسْتَسْهَلا",62,"ل",2,0],["ولقد تَشَاكينَا على عَجَلٍ","بالسَّفْحِ والعَبراتُ تَنْسَفِحُ",63,"ح",1,1],["وَلَقَد تُرى بِأَبي سَعيدٍ مَرَّةً","مُلقى الرِحالِ وَمَوسِمَ الشُعَراءِ",64,"ا",2,0],["وَلَقَد تَضَمَّنَ لي النَجا","حَ غَريبُ جودِ الكَفِّ فَردُه",65,"د",2,0],["وَلَقَد تَكونُ بِها الأَوانِسُ مِن مَهاً","صورِ القُلوبِ إِلى الصِبا وَجَآذِرِ",66,"ر",1,0],["وَلَقَد تَأَمَّلتُ الفِراقَ فَلَم أَجِد","يَومَ الفِراقِ عَلى اِمرِئٍ بِطَويلِ",67,"ل",1,0],["وَلَقَد تَعَسَّفتُ الأُمورَ وَصاحِبي","حَزمٌ يَلُفُّ حُزونَها بِسُهولِها",68,"ل",3,0],["وَلَقَد تَرَكتُ بَني كُلَيبٍ كُلَّهُم","صُمَّ الرُؤوسِ مُفَقَّئي الأَبصارِ",69,"ر",1,0],["وَلَقَد تَرَكتُ بِواحِفَينِ بَقِيَّةً","يَرجونَ سيبَ نَداكَ غَيرَ المُمحِلِ",70,"ل",1,0],["ولقَد تأملتُ الشَّطارةَ قَبلَه","فَوَجَدْتُها حقَّاً يُسمَّى باطِلا",71,"ل",2,0],["ولقد تُسلِّفُني الجَوى وتُرينَه","بِسَوالفِ الرَّشإِ الأَحَمِّ العاطي",72,"ط",2,0],["وَلَقَد تَفاوَتَ مِن شَبابِكَ وَاِنقَضى","ما لَستَ تُبصِرُهُ إِلَيكَ بِآيِبِ",73,"ب",1,0],["وَلَقَد تَرى أَنَّ الحَوادِثَ جَمَّةٌ","وَتَرى المَنِيَّةَ حَيثُ كُنتَ حِيالَكا",74,"ك",2,0],["وَلَقَد تَنَسَّمتُ الرِياحَ لِحاجَتي","فَإِذا لَها مِن راحَتَيكَ نَسيمُ",75,"م",1,1],["وَلَقَد تَرَكتُ وِصالَها عَن قُدرَةٍ","وَزَجَرتُ داعي النَفسِ عَن شُبُهاتِها",76,"ت",3,0],["وَلَقَد تَعَرَّضَ لِلمَحَبَّةِ مَعشَرٌ","عَدِموا مِنَ اللَذّاتِ ما أَنا واجِدُ",77,"د",1,0],["ولقد تحسب الوداعة ضعفاً","ولها دولة ونهي وأمرُ",78,"ر",1,0],["ولقد تظفرُ بالخا","ئبِ حظَّا وغرامَا",79,"م",2,0],["ولقد تزخر بالنّورِ وكم","من ضياءٍ وهو من غيرِك حالك",80,"ك",1,0],["ولقد ترى عيني الجموع فما ترى","دنيا تموج ولا تحس عبادا",81,"د",2,0],["وَلَقَد تَراءَتني بِأَمنَعِ جُنَّةٍ","لَمّا بَرَزتُ لَها وَأَنتَ عَتادي",82,"د",2,0],["وَلَقَدْ تَبَيَّنْتُ الأُمُورَ بِغَيْرِهَا","وَأَتَى عَلَيَّ النَّقْضُ وَالإِبْرَامُ",83,"م",1,0],["وَلَقَد تَرى أَن لا يُذَلِّلُها","أَنَّ الفُؤادَ بِذِكرِها كَلِفُ",84,"ف",1,0],["وَلَقَد تَرَكنَ حَزازَةً في قَلبِهِ","مِنها بِحَقٍّ أَو حَديثِ المُهرِبِ",85,"ب",1,0],["وَلَقَد تَبَيَّنتُ الأُمورَ مُجَرِّباً","فَإِذا الحَياةُ دُعابَةٌ وَمِزاحُ",86,"ح",1,0],["ولقد تكونُ وفي حلاوتها أسىً","مُرٌّ مَذاقتُه ووجْدٌ جاحِمُ",87,"م",1,0],["وَلَقَد تَمَرَّسَ بي مَلِيّاً بَحرُهُ","حَتّى تَبَيَّنَ دُرُّهُ في مَنطِقي",88,"ق",2,0],["وَلَقَد تَهادَتكَ البِلادُ فَأَنتَ رَي","حانٌ هُناكَ وَأَنتَ نُوّارٌ هُنا",89,"ن",2,0],["وَلَقَد تُقَضّيها الصَري","مَةُ عَنكَ وَالقَلِقُ العُذافِر",90,"ر",1,0],["وَلَقَد تُكَلِّفُ حاجَتي عيدِيَّةٌ","جِنّاتُ قَفرٍ يَنتَهِبنَ المَهمَها",91,"ه",2,0],["ولقد تَحَدَّى بالبيانِ لقَومِهِ","وإليهمُ يُعزَى البيانُ ويُنسَبُ",92,"ب",1,0],["ولقد تكونُ لكَ الأسِنّةُ مَضْجَعاً","حتى كأنّكَ من حِمامِك غافل",93,"ل",1,0],["ولقد تكون ومن بدائعِها","حِكَمٌ ومن أيّامِها سِيَر",94,"ر",1,0],["وَلَقَد تَحُلُّ بِعَقوَةِ ال","أَلبابِ مِن بَقَرِ القُصورِ",95,"ر",1,0],["وَلَقَد تَجوبُ بِنا الفَلاةُ إِذا","صامَ النَهارُ وَقالَتِ العُفرُ",96,"ر",1,0],["وَلَقَد تَقنِصُكَ الحو","رُ بِها العينُ الغَزالا",97,"ل",2,0],["وَلَقَد تَعَرَّضَ لي خَيالُكُمُ","في القِرطِ وَالخِلخالِ وَالقُلبِ",98,"ب",1,0],["وَلَقَد تامَت فُؤادي","بِصُدودٍ وَاِجتِنابِ",99,"ب",1,0],["ولَقَد تَشابَهَ في الظَواهِرِ مَولِدٌ","حِلُّ النُكاحِ وَمَولِدٌ بِعِهارِ",100,"ر",1,0],["وَلَقَد تَعلَمُ بَكرٌ أَنَّنا","آفَةُ الجُزرِ مَساميحٌ يُسُر",101,"ر",1,0],["وَلَقَد تَعلَمُ بَكرٌ أَنَّنا","واضِحو الأَوجُهِ في الأَزمَةِ غُر",101,"ر",1,0],["وَلَقَد تَعلَمُ ب