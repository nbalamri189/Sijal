{"poems":[[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[87,"لقد صفعوه صفعة جل شأنها","https://www.aldiwan.net/poem7549.html","الطويل"],[68,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[92,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[132,"بوركت بنية وقد بارك الله","https://www.aldiwan.net/poem50480.html","الخفيف"],[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[234,"أفنيت دهرك تتقي","https://www.aldiwan.net/poem51233.html","مجزوء الكامل"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[353,"سطرها المملوك وهو أضرمد","https://www.aldiwan.net/poem20076.html","الرجز"],[353,"حلم الوزير أحمد أفرط أو","https://www.aldiwan.net/poem20442.html","الرجز"],[371,"لو لم يكن لي في علاك مدائح","https://www.aldiwan.net/poem17243.html","الكامل"],[438,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[438,"حيث التفت فكثبان وقضبان","https://www.aldiwan.net/poem12748.html","البسيط"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[505,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[519,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[566,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[580,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48863","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48675","الكامل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124187","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53159","الرجز"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139811",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93738","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2889,"","https://poetry.dctabudhabi.ae/diwan/poem/122962","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91299","البسيط"],[3703,"","https://poetry.dctabudhabi.ae/diwan/poem/73683","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95776","البسيط"],[308,"","https://poetry.dctabudhabi.ae/diwan/poem/145002","البسيط"],[463,"أجدك بعد أن ضمَّ الكثيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17990",""],[4929,"سكبت حبي له لحنا","https://www.poetsgate.com/ViewPoem.aspx?id=199297",""],[5183,"عواطف الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180212",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[6031,"بَاءَتْ حَنيفَةُ بالخُسْرانِ إذْ عَكَفَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46333",""]],"verses":[["ولو أتى الكافورُ قلنا يد","بيضاء كالكافور لا تُكفَر",0,"ر",1,0],["ولو أتبعوا صفعا بصفع لأحسنوا","وزان اللآلى في النحور ازدواجها",1,"ه",2,0],["وَلَو أَتى الأَصمَعِيُّ يُنشِدُهُ","شِعراً لَأَصبَحَ مِن خَوفٍ لَحَنَه",2,"ن",2,0],["ولو اتفقنا كيف يهتِفُ هاتِفٌ","فينا ، وكَيفَ تُحرَرُ الأعلام!",3,"م",1,0],["ولو أتاني بِبُرهانٍ يجادلُني","لقلتُ : أهلاً على العينين ِ مولائي",4,"ا",2,0],["ولو أتى خيرتُ أستغفر الرحمن","بين الجناتِ أو مَثواها",5,"ا",3,0],["وَلَوِ اِتَّبَعتَ مُوَلِّياً فيما مَضى","لَتَبُعتَهُم سَيراً يُبيدُ البيدا",6,"د",2,0],["ولو اتّقيتَ معاصِي الر","حمن فيما أنتَ راكب",7,"ب",1,0],["ولو أتى بكلّ أذكار الورى","بل سيره بنفسه إلى ورا",8,"ر",2,0],["وَلَوْ أتَى فِيهِمْ حُنينٌ لم يَرُحْ","إلا بِخُفَّيْهِ وَذا مُطّرِدُ",9,"د",1,0],["وَلَوْ أَتاهُ في النَّدِي مُحارباً","مَا قَدَرَ الغَيْثُ على لِحَاقهِ",10,"ق",2,0],["وَلَو اِتَّخَذتُ لَهُ شَريكاً في العُلا","لَرَأَيتُ شَركي غَيرَهُ إِشراكا",11,"ك",2,0],["ولو أتى فيه لحطّ اسمُهُ","من البُخاريّ ومن مُسلِمِ",12,"م",1,0],["ولو أتاهُ عُبيدٌ في العبيد لما","أودى به أن ثَنى نُعْماهُ نُعمانُ",13,"ن",1,0],["ولو أتتِ السماءُ بمثلك ابناً","لما كانت طوالعها تغيبُ",14,"ب",1,0],["ولو اتَّجَهْتُ لِناقصٍ في حالِهِ","مُتَقَطِّعِ الأسْبابِ مَبْعودٍ لَتَمْ",15,"م",1,0],["ولو أتَتْهُ النجومُ الشُّهْبُ يومَ ندىً","لم يرضَ بالشّمسِ ديناراً فيُعطيهِ",16,"ي",2,0],["وَلَو أَتى حُكامُهُ فَوقَ الأَمَم","عَنكَ حُيَيٌ ما بَخِلنا بِالنَعَم",17,"م",1,0],["ولوْ أَتَى أَسدُ الأَبْراجِ مُنْتَصراً","خَارتْ قوائمهُ عنها ولم يَثِبِ",18,"ب",1,0],["ولو أتى بالنعيم الدهر ملء يدي","لم يأت إلا لإملالي وإعلالي",19,"ل",2,0],["ولو اتبعنا في الشؤون محمداً","لخلا لنا الشرقان والغربان",20,"ن",1,0],["ولو أتاني لصلت فيه","أمراً ونهياً ولا أبالي",21,"ل",2,0],["ولو أتى البحر إليه سائلاً","لكان في لهيبها يحترق",22,"ق",1,0],["ولو أتته كلُّ آيةٍ لَمَا","صدَّقَها ولا انثَنى ولا ارعَوى",23,"ا",1,0],["ولو أتيح فداء المصطفى لفدي","بالنفس والمال من موت ومن سقم",24,"م",1,0],["وَلو أَتَت وَأَبوها الأفق يصدقها","مع الثَوابت ستاً مِن سَواريه",25,"ي",2,0],["ولو أتى بعد الخفيف زائداً","سمي بالأسباغ قولا واحدا",26,"د",2,0],["ولو أتى منخبنا ما يقطع","من ضربه فهو اذن مخلع",26,"ع",1,0],["ولو أتني أنصفته في محبتي","لجلدته جلدي وصندقته عظمي",27,"م",2,0],["وَلو أتى السد أَضحى وهو يزمعُهُ","كم سارَ ليلاً وعين النجم غافيةٌ",28,"ه",1,0],["وَلو أَتَتني كما أَبغي مسالمةً","أَحكامُ دَهري لَما فارقتُ خلاني",29,"ن",2,0],["وَلَو أَتَيتُ الوُدَّ مِن بابِهِ","أَثقَلتُ بِالعَتبِ ظُهورَ الرِّكاب",30,"ب",1,0],["ولو أتوك على رأر بلا قدم","لما قضوا لك إلا بعض ما يجب",31,"ب",1,0],["ولو أَتَتني جيوشٌ منك في كَدَرٍ","إني جَسورٌ ولي في الروع تزآرُ",32,"ر",1,0],["وَلو أَتى زائِراً ما كان يَمنَعني","لِقرب ما بين حال الوَرد والصَدر",33,"ر",1,0],["ولو أتى مزني الوقت أغرقه","ولم يعد قطرةً في سحبه الذرف",34,"ف",1,0],["ولو أتتِ السماءُ بمثلك ابناً","ما كانت طوالعها تغيبُ",35,"ب",1,0],["ولو أتي فارغَ المنشورِ قلتُ له","(أحسنتَ يانعمَ ما في حرفِك انْكَتَبَا)",36,"ب",2,0],["ولو أتيناك بالإحسان تحمله","مواقر البر لم نحسب موفينا",37,"ن",2,0],["ولو أتى في خيله ورجله","والله عندي لم يجد غير القنا",38,"ا",1,0],["ولَو أُتِيحَتْ لأهْلِ النَّارِ لاشْتَغَلُوا","بأكلِهَا ما رَأَوا للنَّارِ من أَلَمِ",39,"م",1,0]]}