{"poems":[[88,"سمعنا حديثاً كقطر الندى","https://www.aldiwan.net/poem10921.html","المتقارب"],[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[45,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[47,"سقيت الغوادي من طلول وأربع","https://www.aldiwan.net/poem64652.html","الطويل"],[47,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[63,"إلام يروم الحاسدون نضالي","https://www.aldiwan.net/poem51479.html","الطويل"],[107,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[50,"سيحبسني أظن عن المسير","https://www.aldiwan.net/poem63352.html","البسيط"],[48,"الدهر لونان أعيا ثالث لهما","https://www.aldiwan.net/poem23519.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140849",""],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[92,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[47,"سُقيتِ الغَوادِي من طُلُولٍ وأرْبُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=31223",""],[146,"عساها تنجلى وخلاك ذم","https://www.aldiwan.net/poem58401.html","الوافر"],[164,"تألق نور العدل وانطفأ الظلم","https://www.aldiwan.net/poem58882.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[295,"إن صحا القلب أو غفا","https://www.aldiwan.net/poem11700.html","مجزوء الخفيف"],[310,"ربيع من جبينك قد أطلا","https://www.aldiwan.net/poem56437.html","الطويل"],[416,"سيحشر يعقوب بن داود خائبا","https://www.aldiwan.net/poem67507.html","الطويل"],[422,"سيحظى شهاب الدين فيما يرومه","https://www.aldiwan.net/poem53842.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138230",""],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198613","الوافر"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198597","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48734","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96638","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201714","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42424","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27743","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28061","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65976","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201694","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202600","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145061","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145030","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62811","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109996","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147312","الكامل"],[4680,"خذينا","https://www.poetsgate.com/ViewPoem.aspx?id=185892",""],[4701,"رام الله","https://www.poetsgate.com/ViewPoem.aspx?id=176659",""],[4765,"فرعون الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=215674",""],[4929,"نهاية الجزء الثناني من مسلسل متاهة شعب يبحث عن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=199491",""],[5121,"أَنْفَاسْ","https://www.poetsgate.com/ViewPoem.aspx?id=33584",""],[5121,"خميلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33597",""],[5121,"البلبل الصداح","https://www.poetsgate.com/ViewPoem.aspx?id=33672",""],[5136,"يا خير من جال على سابح","https://www.poetsgate.com/ViewPoem.aspx?id=121597",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5413,"فما بالُه يزدادُ!","https://www.poetsgate.com/ViewPoem.aspx?id=201571",""],[5431,"أنا بخير ...","https://www.poetsgate.com/ViewPoem.aspx?id=202464",""],[5563,"سيحكي الفوات","https://www.poetsgate.com/ViewPoem.aspx?id=212675",""],[5582,"أَلا هَلْ شَجاكَ الأَوْرَقُ المُتَغَرِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63491",""],[5628,"بين بغداد والقاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=179813",""],[5853,"كلاسيكية على جدار التجريد","https://www.poetsgate.com/ViewPoem.aspx?id=175721",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[5956,"هذي الزهور","https://www.poetsgate.com/ViewPoem.aspx?id=183942",""],[5956,"سعادة الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=192151",""],[5956,"يا بنيّ","https://www.poetsgate.com/ViewPoem.aspx?id=193447",""],[5956,"عمّقتَ بي يا صاحبي الإيمانا","https://www.poetsgate.com/ViewPoem.aspx?id=194750",""],[5969,"طقوس العز","https://www.poetsgate.com/ViewPoem.aspx?id=198911",""],[6021,"ذوات البر","https://www.poetsgate.com/ViewPoem.aspx?id=201662",""],[6167,"بلا ندم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85556&r=&rc=39",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""]],"verses":[["سَيُحصي عَلَيكَ سِجِلُّ الزَمانِ","ثَناءً يُخَلِّدُ ما خُلِّدا",0,"د",2,0],["سَيَحوطُ مَن خَلَّفتَهُ مُستَبصِرٌ","في حِفظِ ما اِستَحفَظتَهُ لا يالو",1,"ل",2,0],["سيحميك أن تلقى لساني صارماً","تذكُّرُ قلبي أنَّ سيفك صارمُ",2,"م",1,0],["سَيُحيِ بِكَ السُمّارُ ما لاحَ كَوكَبٌ","وَيَحدو بِكَ السُفّارُ ما ذَرَّ شارِقُ",3,"ق",1,0],["سَيَحمِلُ هَمّي عَن قَريبِن وَهِمَّتي","قَرا كُلِّ ذَيّالٍ جُلالٍ جَلَنفَعِ",4,"ع",1,0],["سَيَحمِلُ أَثقالي تَبَرُّعُ مُنعِمٍ","بِأَنعُمِهِ آدَت رِكابي ثِقالُها",5,"ل",3,0],["سيَحْمِلُهُ جَرْيٌ على ظَهْرِ جامحٍ","يَؤولُ بما في الظَّهْرِ شرَّ مآلِ",6,"ل",1,0],["سَيُحيي رجاءَ المشرِقينَ وَتَشتَفي","عَلى يَدِهِ مِنّا النُفوسُ الحَوائِمُ",7,"م",1,0],["سَيَحبِسُني أَظُنُّ عَنِ المَسيرِ","فُتوني بِاِبنِ مُسعِدَةِ الصَغيرِ",8,"ر",1,1],["سيحانُ لِلرومِ عَذبٌ لَيسَ مَورِدُهُ","مِلحاً كَزَمزَمَ أَو عَينٍ لِسُلوانِ",9,"ن",1,0],["سيحيي بك السمار ما لاح كوكبٌ","ويحدو بك السفار ما ذر شارقٌ",10,"ق",1,0],["سيحملنا الأثيرُ إلى الدَّرارِي","كما حَمَلَتْ أوَالينا المِهَار",11,"ر",1,0],["سيُحاسَبون ، فان عَرتْهم سَكْتَةٌ","من خيفةٍ فستنطِقُ الآثام",12,"م",1,0],["سيحمل همي عند منزل وحدتي","وتصبح آمالي طوتها ضمائره",13,"ر",2,0],["سَيَحْملُ هَمّي عن قَريبٍ، وهمّتي","قَرَا كُلِّ ذَيّالٍ جُلالٍ جَلَنْفَعِ",14,"ع",1,0],["سيحرُسنى التجمُّل من أناس","هُمُ عنّى بداء البُخْل صُمُّ",15,"م",1,0],["سيحيى بيحيى كل يومٍ وليلةٍ","معالمَ عدلٍ قد محا رسمَها الظلمُ",16,"م",1,0],["سيحكي لهم فرعون في دار خلده","بإسلامه المقبول عند التجاور",17,"ر",1,0],["سَيَحْمَدُ ما أبْلَى نَداهُ وبَأسُهُ","صُفوفُ البَرايا يَوْمَ تُبلَى السَّرائِرُ",18,"ر",1,0],["سيحول الصبا غدا","وترى الحسن اكلفا",19,"ف",2,0],["سَيحمدُ غبّه مَن لَيسَ يَدري","وَيعلم أنّه ما كانَ بطلا",20,"ل",2,0],["سَيُحشَرُ يَعقوبُ بِنُ داودُ خائِباً","يَلوحُ كِتابٌ بَينَ عَينَيهِ كافِرُ",21,"ر",1,1],["سَيحظى شهابُ الدِّين فيما يرومه","ويبلُغُ في الأيام ما هو أهلُهُ",22,"ل",2,1],["سيحل فيكم ذا الجزا وأخالكم","عقلاء لا تردون هذا الموردا",23,"د",2,0],["سَيَحفَظُ فَضْلَكَ التَّاريخُ حِفْظا","عَلَى مَرِّ الزَّمَانِ خُلُودُ",24,"د",1,0],["سيحفظ فضلك التاريخ فخرا","ويكتب عنك بالذَّهب السطورا",25,"ر",2,0],["سيحمل الخبرَ البرق البشير وفي","سرائر القوم ما يغني عن الخبر",26,"ر",1,0],["سَيحظى بِشعري كلُّ حرٍّ مهذَّب","وَيُحرمُهُ في الناس لحزٌ ملدّدُ",27,"د",1,0],["سيحمد يوم الروع غير كماته","ويندب أبْطَالًا له موكب فرد",28,"د",1,0],["سيحييكَ الرضابُ فقلتُ جهراً","وقلبي منكراً ما لا يُعاينْ",29,"ن",1,0],["سيحانه من غنيّ لا افتقارَ له","لعالمِ الكونِ والأسماء تطلبه",30,"ب",2,0],["سَيَحمِلُها الطوالُ مِن آلِ قُرطٍ","إِذا ما عَرَّدَ السُودُ القِصارُ",31,"ر",1,0],["سيحمد فعله رجل جواد","بمهجته إِذا ندم البخيل",32,"ل",1,0],["سيحضر عيديَ الدهريّ يوماً","لتكريمي إذا نُشر المعرّي",33,"ر",2,0],["سيحيى قارئي جيلاً فجيلاً","ويهلك ناقدي يأساً وهمّا",34,"م",2,0],["سيحمد شعبك العقبى قريبا","ويحرز نصره بيد القدير",35,"ر",1,0],["سيحمد ديواني ل \"أحمد طالب \"","يدا منه طولى قدمته لينشرا",36,"ر",2,1],["سيحفظُ ما ضيعتُم متيقظٌ","يضيءُ إذا اسودّ الزمانُ ويُسفِرُ",37,"ر",1,0],["سَيُحاكِمُ اللَهُ الأَنامَ وانهُ","يَجزيهمِ عدلاً بما قد أَسلَفوا",38,"ف",3,0],["سيحملون على إليون من غدهم","والصيد عن ردعهم ضاقت بها الحيل",39,"ل",1,0],["سيحل يوم ينتهي غلواؤها","ويكون بعث بعدها وحسابُ",40,"ب",1,0],["سيحملنا الحنين إلى سناها","ونبقى في مداها حالمينا",41,"ن",2,0],["سيُحبُّنا بعد السلامِ عدوُّنا","برصاصتين.. ووردتين.. فقلْ لَهْ:",42,"ل",2,0],["سيُحْرِقُونَكَ إمَّا فُرْصَةٌ سَنَحَتْ","فالسَّبْعُ في جُوعِهِ قدْ يأكُلُ السَّبْعَا",43,"ع",2,0],["سيحيا مداسًا تحت أقدامِ عصبةٍ","ظلاميةٍ كأسَ المذلَّةِ يجرعُ",44,"ع",1,0],["سَيَحْمِيِكَ الشُّعُورُ فَلا تَخُنْهُ","بِيَأْسٍ يَحْتَمِي خَلْفَ الْبَلاءِ",45,"ا",2,0],["سيحينُ مَوْتُ حدائقي بفراقنا","ولِمَنْ تعيشُ فصائلي برعيّتي",46,"ت",2,0],["سيّحَ الألوانَ فنًّا في القوافي","جاءَ شعرًا في إطار ٍ كالقصور ِ",47,"ر",1,0],["سيحون جدواك فدى حاتم","ليس لديه غير تقطار",48,"ر",1,0],["سيحْكي خيرُجُندِالأرضِ فَخرًا","عن الأمجادِ عن طابا وسينا",49,"ن",2,0],["سيحكي الشِّعْرُملْحَمةً توالتْ","عنِ الإنسانِ أحقابًا مِئينا",49,"ن",2,0],["سيحميه فيأخذهم سريعاً","فترميهم أبابيبل السماءِ",50,"ا",2,0],["سيحكمُ من يأتي إذا متُّ أنني","مُحِبٌّ على عرش الغرام قَدِاستوى",51,"و",2,0],["سيحتسي الصمتَ محموما ومنغمسا","فلتبدأ الآن أو فلترفع القلما!!",52,"م",2,0],["سيحكي الفواتُ لها تمتماتي","‎و يستنفرُ الذكرياتِ الصوادي",53,"د",2,0],["سَيَحْظَى بِمَدْحِي كُلُّ حُرٍّ مُهَذَّبٍ","وَيُحْرَمُهُ فِي النَّاسِ لَحْزٌ يلَنْدَدُ",54,"د",1,0],["سيحملني الفلُّ والياسمين ُ","إليك َ بأنفاسه ِ العاطره ْ",55,"ر",2,0],["سيحاور الآهات ِ والأنّاتِ بي","ويغوص أعماقي ليكتشف العنا",56,"ن",2,0],["سيحتاج أنثاهُ وذنباً مقدساً","ليصبحَ حُرًّا لا مَشوباً ولا نقي",57,"ق",2,0],["سيحاسب الله الجميعَ على دمي","وجفافِهِ ويُقِرُّ حكماً ما قسا",58,"س",2,0],["سيحققون مُناك قالوا كلهم","هذا الكلام وقولهم هنَّاني..",59,"ن",2,0],["سيحل مشكلتي اهتمامك بي فلا","تغلق رتاجك كي أموت مهانا؟؟",60,"ن",2,0],["سيحل مشكلتي اهتمامك بي فلا","تُغلقْ مودتك التي ترعانا",61,"ن",2,0],["سَيَحفُرُ في جِدارِ السِجنِ شِعراً","من القَهرِ الذي يَروي بلاهُ",62,"ا",2,0],["سيحلّ في هذا البناء منعّمًا","بعد الشّقاء ويستريح البال",63,"ل",1,0],["سَيحملُ عَاتِقى صُبحاً عَصاتى","وهل أَضعُ الرحالَ وقد نأيتُ",64,"ت",1,0],["سيحتفي فيكَ قلبُ الموتِ ملتحفاً","آفاقَ جرحكَ في شكلِ النياشينِ",65,"ن",1,0],["سيحملك الرفاق على كتوف","وبعد الدفن تفترق الحشود",66,"د",1,0]]}