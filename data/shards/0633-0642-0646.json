{"poems":[[84,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[85,"اسقني بنت الدوالي","https://www.aldiwan.net/poem54197.html","مجزوء الرمل"],[53,"سقني الأسكركع الصنبر","https://www.aldiwan.net/poem66700.html","الهزج"],[45,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[77,"سقني الخمر بعيني قاتلي","https://www.aldiwan.net/poem69070.html","الرمل"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[108,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[204,"سقنا رفيدة حتى احتل أولها","https://www.aldiwan.net/poem2061.html","البسيط"],[234,"سقنها من عصير الحسن","https://www.aldiwan.net/poem50866.html","مجزوء الرمل"],[287,"اسقني الخندريس تسبى عروسا","https://www.aldiwan.net/poem32731.html","الخفيف"],[371,"سقني يا بدر شمسا","https://www.aldiwan.net/poem17305.html","مجزوء الرمل"],[376,"سقيا لوقت مضى ورعيا","https://www.aldiwan.net/poem56967.html","الطويل"],[473,"سقنيها مدامة","https://www.aldiwan.net/poem60253.html","مجزوء الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39052","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111908","البسيط"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103764","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129818","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9620","البسيط"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126082","الكامل"],[5126,"مُوجز حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87813&r=&rc=28",""]],"verses":[["سقّني غَيرَ مُليمٍ إِنّني","حَنفيُّ الرَأي وَالمعتقدِ",0,"د",1,0],["سقّني سر الفلاني","ولا تنس ذك فلانا",1,"ن",2,0],["سَقِّني الأسكركعَ الصِّنْ","بِرَ في جَعْضَلفونِهْ",2,"ن",2,1],["سقِّني ريقها وسقِّ نديمي","من سلاف ممزوجة برضاب",3,"ب",1,0],["سَقّني الخمرَ بعَيْنيَ قاتلي","لا يُلاقي منك مثلي عَطَشا",4,"ش",2,1],["سُقناَ الخِلافَةَ تَحدوها أَسِنَّتُنا","وَالقاسِطون عَلى جَهدٍ وَإِسهادِ",5,"د",1,0],["سُقْنَا الأدلَّةَ كالصباح لهم؛ فما","أَغنَتْ عن الحق الصُّراحِ فَتيلا",6,"ل",2,0],["سُقْنا رُفَيْدَةَ حتى احتلّ أولُها","تَيْماءَ يُذْعرُ من سُلاّفِها حَدَدُ",7,"د",1,1],["سَقِّنِها من عَصير الْ","حُسْنِ بالطَّرْف الكَحيل",8,"ل",1,1],["سَقِّني إسفَنطاً تُسارِقُ بِالسِرِّ","لِسانَ الرَئيسِ جالينُوسا",9,"س",2,0],["سَقِّني يا بَدرُ شَمساً","كَلَّلوها بِالثُرَيّا",10,"ي",2,1],["سُقنا اللَّيالي كَما أرَدنا","فلَو تراهُنَّ قلتَ سَبيا",11,"ي",2,0],["سَقِّنيها مَدامَةً","تُذهَبُ الهَمَّ وَالكَمَد",12,"د",1,1],["سَقِّنِيها بالكَبيرِ","في هَوى رِيْمٍ صَغيرِ",13,"ر",1,1],["سقنا اليك الثناءَ درّاً","كلُّ كثيرٍ بهِ يقلُّ",14,"ل",1,0],["سقِّني والافقُ بُردٌ","بنجوم الليل معلم",15,"م",1,1],["سقِّنيها من يدي مشبهِها","بالذي يحويه طرفٌ وشنَب",16,"ب",1,0],["سقنا إليك الشعر لا لبضاعة","تدعوك فادعو السائق الملحاحا",17,"ح",2,0],["سُقنا رَبيعَةَ نَحوَ الشامِ كارِهَةً","سَوقَ البِكارِ عَلى رَغمٍ وَتَأنيبِ",18,"ب",1,0],["سق ندمانى عقارا","واسقنى من فيك ريقا",19,"ق",2,0],["سقنا إلى الأرض سيلاً من مدامعِنا","وإنْ ظُلمنا.. فللأرماح نشتجِرُ",20,"ر",1,0]]}