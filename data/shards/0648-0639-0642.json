{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[77,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[77,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[86,"دعاني رفاقي والقوافي مريضة","https://www.aldiwan.net/poem10483.html","الطويل"],[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[4,"إن أبان كان حلوا بسرا","https://www.aldiwan.net/poem21170.html","الرجز"],[72,"لام العذار أطالت فيك تسهيدي","https://www.aldiwan.net/poem18544.html","البسيط"],[51,"لحيته في وجهه بظر","https://www.aldiwan.net/poem63001.html","السريع"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[51,"راع المها شيبي وفيه أمانها","https://www.aldiwan.net/poem66071.html","الكامل"],[29,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[70,"أيها النفس الشريفه","https://www.aldiwan.net/poem42809.html","مجزوء الرمل"],[92,"ما قدس المثل الأعلى وجمله","https://www.aldiwan.net/poem38909.html","البسيط"],[85,"لي ساعة من معدن","https://www.aldiwan.net/poem7751.html","مجزوء الرجز"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[56,"لما نظرت إلي عن حدق المها","https://www.aldiwan.net/poem58469.html","الكامل"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[61,"وعقفاء مثل هلال السما","https://www.aldiwan.net/poem51597.html","المتقارب"],[80,"أذابل النرجس في مقلتيك","https://www.aldiwan.net/poem31351.html","السريع"],[69,"تجادلنا أماء الزهر أذكى","https://www.aldiwan.net/poem28924.html","الوافر"],[105,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[21,"عين بكى بالمسبلات أبا","https://www.aldiwan.net/poem36195.html","الخفيف"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"ذهب الشباب وكدر العمر","https://www.aldiwan.net/poem27013.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[48,"وعقار كأنما نتعاطى","https://www.aldiwan.net/poem62484.html","الخفيف"],[50,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[46,"سألت منجمها عن الطفل الذي","https://www.aldiwan.net/poem22701.html","الكامل"],[46,"تزوج بعد واحدة ثلاثا","https://www.aldiwan.net/poem22963.html","الوافر"],[46,"مومس كالإناء دنسه الشر","https://www.aldiwan.net/poem22974.html","الخفيف"],[46,"أسررت إذا مر السنيح تفاؤلا","https://www.aldiwan.net/poem23255.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54819","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[77,"قفا فاسألا في ساحة الأجدع الفرد","https://www.poetsgate.com/ViewPoem.aspx?id=33812",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"طَيفٌ ألَمّ، فحَيّا عندَ مَشهَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32938",""],[28,"دعا دعوة الحبلى زباب وقد رأى","https://www.poetsgate.com/ViewPoem.aspx?id=2460",""]],"verses":[["وَعُقابُ المَلاعِ تُلحِمُ فَرخَي","ها بِإِزليقَةٍ زَلولِ القِنانِ",0,"ن",1,0],["وَعِقدٍ مِنَ الأَخدانِ أَوهى نِظامَهُ","كُرورُ الرَزايا وَاِعتِقابُ الطَوارِقِ",1,"ق",1,0],["وَعَقابيلَ غَرامٍ","يُذكِرُ القَلبَ حُقوقَه",2,"ق",2,0],["وَعِقالَ كُلِّ مُشَيَّعٍ مُتَغَطرِفٍ","وَمَجالَ كُلِّ مُوَضَّعٍ مَضعوفِ",3,"ف",1,0],["وعُقْدَةِ مُلْكٍ كانَ ربُّكَ كالِئاً","لَها وأصيلُ السّعْدِ يُغْني عنِ النّقْدِ",4,"د",1,0],["وَعَقْلَكَ الْمَوْهُوبَ حَكِّمْهُ فِي","الأَحْوَالِ وَاشْكُرْ فَضْلَ وَهَّابِهِ",5,"ب",2,0],["وَعَقلاً وَلوعاً بِالكُنوزِ فَإِنَّهُ","عَلى الدُرِّ غَوّاصٌ بِبَحرِ عُمانِ",6,"ن",1,0],["وَعُقولاً لَولا الخُمولُ تَوَلّا","ها لَفاضَت غَرابَةً وَاِبتِداعا",7,"ع",2,0],["وعقيلة للكفر لما رُعْتَها","أخرست من ناقوسها المهذارِ",8,"ر",1,0],["وَعَقَّتِ الخَيلُ عَجاجاً كَدرا","أَقامَ مِن بَعدِ الثَلاثِ عَشرا",9,"ر",2,0],["وعقد بندٍ على خصر رجعت به","ذا ناظر بنجومِ الليلِ معقود",10,"د",1,0],["وعقدُهُ الدهرَ فيا ويلهُ","أوجهُهُ المقبوح والدهر",11,"ر",1,0],["وعقدْتَ من عُقد المكا","يدِ للعِدا ما لا يُحلُّ",12,"ل",1,0],["وعققْنَني لمّا ادَّعيْنَ عُمومَتي","ومن النساءِ معقَّةُ الأعمامِ",13,"م",1,0],["وَعُقَّرٍ خالِداتٍ حَولَ قُبَّتِها","وَطامِسٍ حَبَشِيِّ اللَونِ ذي طَبَبِ",14,"ب",1,0],["وَعُقولُ الناسِ في رَغ","بَتِهِم فيها سَخيفَه",15,"ف",2,0],["وعقلٍ من الأَضواءِ في رأسِ نابغٍ","وعقلٍ من الظَّلماءِ يحملهُ فَدْمُ",16,"م",1,0],["وعقرباها والزما","ن في اختلاف بين",17,"ن",1,0],["وَعَقلٌ بَعيدُ مَرامي الطِما","حِ كَبيرُ اللُبانَةِ وَالمَأرَبِ",18,"ب",1,0],["وعَقَدْتِ بينَ قَضِيبِ بانٍ أهْيَفٍ","وكَثِيبِ رَمْلٍ عُقْدَةَ الزُّنّارِ",19,"ر",1,0],["وَعِقابُ لُبنانٍ وَكَيفَ بِقَطعِها","وَهُوَ الشِتاءُ وَصَيفُهُنَّ شِتاءُ",20,"ا",2,0],["وَعقفاءَ مثلِ هِلالِ السَّما","ولكنَّها لَبِسَتْ سُنْدُسا",21,"س",2,1],["وَعَقربا صدغيكِ من عَنبَرٍ","سَمُّهُما ويلاهُ مِن عَقرَبيك",22,"ك",1,0],["وعقبى ذلك الجدلِ اصطلحْنا","وقدْ حصلَ الوفاقُ على الخلافِ",23,"ف",1,0],["وعُقولٌ عَمرتْ أوهامُها","مَوْطِنَ الحقِّ ومُحتَلَّ اليقين",24,"ن",1,0],["وَعَقيلَ بنِ أَسودٍ","البَأسِ ليومِ الهياجِ وَالدُفَعَه",25,"ع",2,0],["وَعَقرَبٌ مَمدودَةٌ قَتّالَه","وَجُعَلٌ وَفارَةٌ بَوّالَه",26,"ه",1,0],["وَعِقابُهُ عَدلٌ وَعَزمَتُهُ","كَالمَشرِفِيِّ وَوَعدُهُ نَذرُ",27,"ر",1,0],["وَعَقَدْتَ رأْيَكَ فيهِمُ فَلَقِتَهُمْ","فَرْداً بِجَيْشٍ لا يُطاقَ لُهامِ",28,"م",1,0],["وَعُقارٍ كَأَنَّما نَتَعاطى","في كُؤوسِ اللُجَينِ مِنها سِراجا",29,"ج",2,1],["وَعَقارِبُ الحُبِّ الَّذي","يُخفي مِنَ الوَسواسِ قَلبُه",30,"ب",2,0],["وَعِقابُ والِدِكَ الرَؤوفِ تَحَدُّبٌ","وَيُشَقُّ أَنفُ الطِرفِ خَشيَّةَ بُهرِهِ",31,"ر",2,0],["وَعَقلُكَ يا أَخا السَبعينَ واهٍ","كَأَنَّكَ في مَلاعِبِكَ إِبنُ سَبعِ",32,"ع",1,0],["وَعُقولٌ لَيسَت تَرُدُّ فَتيلاً","لِقَضاءٍ في عالَمِ اللَهِ بالِغ",33,"غ",1,0],["وَعَقائِلُ الأَلبابِ غَيرُ أَوامِرٍ","بِأَذاةِ أَيتامٍ وَهَتكِ عَقائِلِ",34,"ل",1,0],["وعقائلٌ خلفَ الخدور هواتفٌ","كالطير أذن بالصباح هبوبها",35,"ب",3,0],["وعقدتُ من شعري ومن ريحانها","إكليلَ غارٍ أو نظيمَ جُمانِ",36,"ن",1,0],["وَعَقِيلاتٍ بِمَا يُحْسِنَّهُ","زِينَةُ الدُّنْيَا وَعُمْرَانُ الدِّيَارِ",37,"ر",1,0],["وعَقيدةٍ لو صُوِّرَتْ بمُماثلٍ","كانت تكونُ رَصانَةَ الأطْواد",38,"د",1,0],["وَعَقِيْدَةٌ لَوْ هُزَّتِ الأَجْبَالُ مِنْ","ذُعْرٍ لَمَا اهْتَزتْ مَعَ الأَجْبَال",39,"ل",1,0],["وعقدة ملك كان ربك كالئا","لها وأصل السعد يغني عن الجد",40,"د",1,0],["وعُقابُ \" لبنانٍ \" تَضُمُّ جَناحَها","تحمي الفِراخَ وتحرُسُ الزُّغلولا",41,"ل",2,0],["وعقد نِهَيتُ فؤادي، لوْ يُطاوِعُني،","عَن ذي دَلالٍ، غرِيبِ الحسنِ مفرَدِهِ",42,"د",2,0],["وعقد كانَ عَوْفٌ ذا ذُحُولٍ كَثِيرَةٍ","وَذا طَلَباتٍ تَتْرُكُ الأنْفَ أجْدَعا",43,"ع",2,0]]}