 بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[441,"صراع السيف والقلم","https://www.aldiwan.net/poem55927.html","عموديه"],[441,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[451,"أبطال غزة بعد قبية هللوا","https://www.aldiwan.net/poem61237.html","البسيط"],[451,"ما شكاتي من الأنام عداء","https://www.aldiwan.net/poem61578.html","الخفيف"],[456,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[462,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[462,"قم نديمي فاسفك دم الزق","https://www.aldiwan.net/poem3306.html","عموديه"],[462,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[477,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[480,"ما الزهر ما ما الرحمن ما الحلل","https://www.aldiwan.net/poem24462.html","عموديه"],[493,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[493,"قسما لقد عجم الزمان","https://www.aldiwan.net/poem9819.html","مجزوء الكامل"],[504,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[513,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[513,"قليل لك المدح الذي بك فخره","https://www.aldiwan.net/poem12151.html","الطويل"],[536,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"قال لي عاذلي تناء عن الحب","https://www.aldiwan.net/poem47148.html","الخفيف"],[549,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[549,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[556,"لو أن من يطلب مولاه","https://www.aldiwan.net/poem33668.html","السريع"],[556,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[556,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[556,"جميع الكون مظهره","https://www.aldiwan.net/poem34460.html","مجزوء الوافر"],[556,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[565,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أصبحت للدنيا الدنية","https://www.aldiwan.net/poem2753.html","مجزوء الكامل"],[573,"قد همت بالبدوي في الحلل","https://www.aldiwan.net/poem2886.html","أحذ الكامل"],[573,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[585,"أضرب السحر الذي أنت ناظمه","https://www.aldiwan.net/poem11506.html","عموديه"]],"verses":[["وَعُقابُ المَلاعِ تُلحِمُ فَرخَي","ها بِإِزليقَةٍ زَلولِ القِنانِ",0,"ن",1,0],["وَعِقدٍ مِنَ الأَخدانِ أَوهى نِظامَهُ","كُرورُ الرَزايا وَاِعتِقابُ الطَوارِقِ",1,"ق",1,0],["وَعَقابيلَ غَرامٍ","يُذكِرُ القَلبَ حُقوقَه",2,"ق",2,0],["وَعِقالَ كُلِّ مُشَيَّعٍ مُتَغَطرِفٍ","وَمَجالَ كُلِّ مُوَضَّعٍ مَضعوفِ",3,"ف",1,0],["وعُقْدَةِ مُلْكٍ كانَ ربُّكَ كالِئاً","لَها وأصيلُ السّعْدِ يُغْني عنِ النّقْدِ",4,"د",1,0],["وَعَقْلَكَ الْمَوْهُوبَ حَكِّمْهُ فِي","الأَحْوَالِ وَاشْكُرْ فَضْلَ وَهَّابِهِ",5,"ب",2,0],["وَعَقلاً وَلوعاً بِالكُنوزِ فَإِنَّهُ","عَلى الدُرِّ غَوّاصٌ بِبَحرِ عُمانِ",6,"ن",1,0],["وَعُقولاً لَولا الخُمولُ تَوَلّا","ها لَفاضَت غَرابَةً وَاِبتِداعا",7,"ع",2,0],["وعقيلة للكفر لما رُعْتَها","أخرست من ناقوسها المهذارِ",8,"ر",1,0],["وَعَقَّتِ الخَيلُ عَجاجاً كَدرا","أَقامَ مِن بَعدِ الثَلاثِ عَشرا",9,"ر",2,0],["وعقد بندٍ على خصر رجعت به","ذا ناظر بنجومِ الليلِ معقود",10,"د",1,0],["وعقدُهُ الدهرَ فيا ويلهُ","أوجهُهُ المقبوح والدهر",11,"ر",1,0],["وعقدْتَ من عُقد المكا","يدِ للعِدا ما لا يُحلُّ",12,"ل",1,0],["وعققْنَني لمّا ادَّعيْنَ عُمومَتي","ومن النساءِ معقَّةُ الأعمامِ",13,"م",1,0],["وَعُقَّرٍ خالِداتٍ حَولَ قُبَّتِها","وَطامِسٍ حَبَشِيِّ اللَونِ ذي طَبَبِ",14,"ب",1,0],["وَعُقولُ الناسِ في رَغ","بَتِهِم فيها سَخيفَه",15,"ف",2,0],["وعقلٍ من الأَضواءِ في رأسِ نابغٍ","وعقلٍ من الظَّلماءِ يحملهُ فَدْمُ",16,"م",1,0],["وعقرباها والزما","ن في اختلاف بين",17,"ن",1,0],["وَعَقلٌ بَعيدُ مَرامي الطِما","حِ كَبيرُ اللُبانَةِ وَالمَأرَبِ",18,"ب",1,0],["وعَقَدْتِ بينَ قَضِيبِ بانٍ أهْيَفٍ","وكَثِيبِ رَمْلٍ عُقْدَةَ الزُّنّارِ",19,"ر",1,0],["وَعِقابُ لُبنانٍ وَكَيفَ بِقَطعِها","وَهُوَ الشِتاءُ وَصَيفُهُنَّ شِتاءُ",20,"ا",2,0],["وَعقفاءَ مثلِ هِلالِ السَّما","ولكنَّها لَبِسَتْ سُنْدُسا",21,"س",2,1],["وَعَقربا صدغيكِ من عَنبَرٍ","سَمُّهُما ويلاهُ مِن عَقرَبيك",22,"ك",1,0],["وعقبى ذلك الجدلِ اصطلحْنا","وقدْ حصلَ الوفاقُ على الخلافِ",23,"ف",1,0],["وعُقولٌ عَمرتْ أوهامُها","مَوْطِنَ الحقِّ ومُحتَلَّ اليقين",24,"ن",1,0],["وَعَقيلَ بنِ أَسودٍ","البَأسِ ليومِ الهياجِ وَالدُفَعَه",25,"ع",2,0],["وَعَقرَبٌ مَمدودَةٌ قَتّالَه","وَجُعَلٌ وَفارَةٌ بَوّالَه",26,"ه",1,0],["وَعِقابُهُ عَدلٌ وَعَزمَتُهُ","كَالمَشرِفِيِّ وَوَعدُهُ نَذرُ",27,"ر",1,0],["وَعَقَدْتَ رأْيَكَ فيهِمُ فَلَقِتَهُمْ","فَرْداً بِجَيْشٍ لا يُطاقَ لُهامِ",28,"م",1,0],["وَعُقارٍ كَأَنَّما نَتَعاطى","في كُؤوسِ اللُجَينِ مِنها سِراجا",29,"ج",2,1],["وَعَقارِبُ الحُبِّ الَّذي","يُخفي مِنَ الوَسواسِ قَلبُه",30,"ب",2,0],["وَعِقابُ والِدِكَ الرَؤوفِ تَحَدُّبٌ","وَيُشَقُّ أَنفُ الطِرفِ خَشيَّةَ بُهرِهِ",31,"ر",2,0],["وَعَقلُكَ يا أَخا السَبعينَ واهٍ","كَأَنَّكَ في مَلاعِبِكَ إِبنُ سَبعِ",32,"ع",1,0],["وَعُقولٌ لَيسَت تَرُدُّ فَتيلاً","لِقَضاءٍ في عالَمِ اللَهِ بالِغ",33,"غ",1,0],["وَعَقائِلُ الأَلبابِ غَيرُ أَوامِرٍ","بِأَذاةِ أَيتامٍ وَهَتكِ عَقائِلِ",34,"ل",1,0],["وعقائلٌ خلفَ الخدور هواتفٌ","كالطير أذن بالصباح هبوبها",35,"ب",3,0],["وعقدتُ من شعري ومن ريحانها","إكليلَ غارٍ أو نظيمَ جُمانِ",36,"ن",1,0],["وَعَقِيلاتٍ بِمَا يُحْسِنَّهُ","زِينَةُ الدُّنْيَا وَعُمْرَانُ الدِّيَارِ",37,"ر",1,0],["وعَقيدةٍ لو صُوِّرَتْ بمُماثلٍ","كانت تكونُ رَصانَةَ الأطْواد",38,"د",1,0],["وَعَقِيْدَةٌ لَوْ هُزَّتِ الأَجْبَالُ مِنْ","ذُعْرٍ لَمَا اهْتَزتْ مَعَ الأَجْبَال",39,"ل",1,0],["وعقدة ملك كان ربك كالئا","لها وأصل السعد يغني عن الجد",40,"د",1,0],["وعُقابُ \" لبنانٍ \" تَضُمُّ جَناحَها","تحمي الفِراخَ وتحرُسُ الزُّغلولا",41,"ل",2,0],["وعقد نِهَيتُ فؤادي، لوْ يُطاوِعُني،","عَن ذي دَلالٍ، غرِيبِ الحسنِ مفرَدِهِ",42,"د",2,0],["وعقد كانَ عَوْفٌ ذا ذُحُولٍ كَثِيرَةٍ","وَذا طَلَباتٍ تَتْرُكُ الأنْفَ أجْدَعا",43,"ع",2,0],["وعقدت حب قلوب كلها","معقودة العقول في ازرارها",44,"ر",3,0],["وعقل قد يدير رحى البرايا","ولفظ كالقضاء له مضاء",45,"ا",2,0],["وعقل وإسلامٌ وعفو عن الورى","ومعرفة حب الإله ومرحما",46,"م",2,0],["وعقَلنا الناجياتِ خلاءً","وربَطنا المُقْرَباتِ ارتهاصا",47,"ص",2,0],["وعَقَّار كُومِ الصَّفايا إذا","تعذَّرَ عند الضُّروع الحليبُ",48,"ب",1,0],["وَعُقوقُ أَرمانوسَ حينَ أَبَيتَ نُص","رَتَهُ أَباحَكَ وُدَّ ميخائيلا",49,"ل",2,0],["وَعَقْرَبُ الصُّدْغِ قَدْ بَانَتْ زُبانَتُهُ","وَنَاعِسُ الطَّرْفِ يَقْظانٌ عَلى رَصَدي",50,"د",2,0],["وعقولكم مما استطال كمالُها","تزنُ الرجال لكم بلا ميزانَ",51,"ن",1,0],["وَعُقارٍ عَتَّقَتها","بَعدَ أَسلافٍ خُلوفُ",52,"ف",1,0],["وَعُقارٌ ذَوْبُ شَمْسٍ","جَمَعَتْ حُسْناً وَطِيبَا",53,"ب",2,0],["وَعَقْرَبَهُ فِي الْغَرْبِ تَهْوِي كَأنَّهَا","تُشَكِّلُ فِي حَقِّ التَّشَابُهِ عَقْرَبَا",54,"ب",2,0],["وعِقْد الفضلِ منظومُ اللآلى","لديها لا يُفَكُّ ولا يُفضُّ",55,"ض",1,0],["وعقدتَ بين قضيب بانٍ ناعمٍ","وكثيب رملٍ عقدة الزُّنّارِ",56,"ر",1,0],["وعُقَار ثغرِك إنَّ بي","طَلَباً يطول إلى عُقَارِهْ",57,"ر",2,0],["وَعَقيدَةُ الإِنسانِ راسِخَةٌ بِهِ","حَتّى يُحجّبَه الرَدى بِحِجابِهِ",58,"ب",2,0],["وَعُقدَتي في هَواهُم","بِحالِها ما تُحَكُّ",59,"ك",1,0],["وَعَقَلْتُهُ بِعُلاكُمُ","فِلِذَا الرَّوِيُّ بِهِ مُقَيَّدْ",60,"د",1,0],["وَعِقْدُ الْمُنَى غَيْرُ مُنْتَثِرٍ","وَسَعْدُكَ دَانَ بِمَا قَدْ دَنَوْا",61,"و",2,0],["وعُقَّالٍ يُلازِمُها شَديدٍ","ومِن هَدمِ المَعَالِفِ والرِّكالِ",62,"ل",1,0],["وعقدَ يدٍ بيدٍ رَخصةٍ","يفوزُ بتَقبيلها مَن صَبر",63,"ر",1,0],["وَعَقْدُها جَلّ عَنِ العَقائِدِ","كانَت لَها السَعود بالمَراصِدِ",64,"د",1,0],["وعقلك ميزان ورأيك حاكم","فانصف لحكم ثم عدل لميزان",65,"ن",1,0],["وعقبي مغرب في كل ليل","إلى التسعين تتبعها بعشر",66,"ر",1,0],["وَعَقدٌ وَثيقٌ لا يُحَلُّ وَذِمَّةٌ","لَها شاهِدٌ بِها وَكِتابُ",67,"ب",1,0],["وَعَقدُ زِنّاري وَأَترابُها","يَأباهُ مَن حَلَّ بِهِ الصُلبُ",68,"ب",1,0],["وَعُقودِ عَهدِ العاشِقينَ وَمَن غَدا","بِعُرى الوُلا في عِشقِهِ مُتَمَسِّكا",69,"ك",2,0],["وَعَقرَبَ الصَدغِ عِندَ لَفتَتِهِ","لَيلاً تَبَدّى ما بَينَ صُبحَينِ",70,"ن",1,0],["وَعَقارب سود تسلّ صَوارماً","بيضاً لَها حمر المَنايا مُكتَسى",71,"س",2,0],["وَعقيب ذَلك أَن يَكون غِذاؤُهُ","مِمّا سلحنَ تَمعلكاً وَتَمعلسا",71,"س",2,0],["وَعَقرب فَوقَ ذاكَ الصدغ ما لَدَغَت","شَيخاً بِها ساحَ مِن عشق وَلا وَلَدا",72,"د",2,0],["وَعقد كَمال زان مِنكَ شَمائِلاً","تَملّكته مِن مالك الحلِّ وَالعقدِ",73,"د",1,0],["وَعقد دُرّ فَريد","أَنماهُ بَيت مُحَرّم",74,"م",1,0],["وَعَقرَب الصَدغ يَحمي نرجس المقل","تُضىء في الحلة الحَمراء طَلعَتُه",75,"ه",1,0],["وعَقلتُ ناجيتي بفضْلِ زِمامِها","لمّا رأيتُ خيامَهمْ بالمنحنى",76,"ن",2,0],["وعَقْدُكَ مجلسَ النَّظَرِ افْتِخاراً","ومالكَ يومَ مكرُمةٍ مُدان",77,"ن",1,0],["وَعَقرَبٍ في وَردِ خَدٍّ وَفي","مُستَأنِسِ اللَثمِ بِها نَدَّهْ",78,"ه",1,1],["وَعَقرَبٍ في الخَدِّ مِن مِسكَةٍ","أَمسَكَ أَن يَأكُلَها الجَمرُ",79,"ر",1,1],["وَعَقرَبٌ قلتم فَلا لامِسٌ","وَقُلتُمُ نَدٌّ فَلِمْ لا اِحتَرَقْ",80,"ق",1,0],["وَعَقرَبٍ في الخَدِّ قَد رابَني","في ذَهَبِ الخَدَّينِ مَمشاها",81,"ه",2,1],["وعقلٌ لا يرى العقلاءَ جهلٌ","وفكرٌ غير وقّادٍ بليدُ",82,"د",1,0],["وَعقبان حَرب فَوق جَرد لَو أَنَّهُم","أَغاروا عَلى نسر السَماء لَما نَجا",83,"ج",2,0],["وعقده استغراق كل القلب","بذكر مولانا الكريم ربي",84,"ي",1,0],["وعُقُولٌ وَعْيُها مُسْتَلَبٌ","وقلوبٌ رُوحُها مُسْتَلَبَهْ",85,"ب",2,0],["وَعَقلٍ كَعذبِ الماءِ مِن نظم عَقله","بِعَقلِ سواه فَهوَ عَذبٌ زُلالِهِ",86,"ل",2,0],["وعقارب صدغ قد درجت","لدغت لفؤادي يا أسما",87,"م",2,0],["وَعُقُودُ تاجِ المَجْدِ دُرُّ خِلاَلِهِ","لو كانَ رُوحُ الحَمْدِ عادَ مُصَوِّرا",88,"ر",2,0],["وعُقابٍ كُلَّما حَوَّمَهَا","عارِضٌ رَوَّعَ سَيْرَ ا