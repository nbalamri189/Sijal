,"https://www.aldiwan.net/poem47205.html","الطويل"],[552,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[559,"لو أن من يطلب مولاه","https://www.aldiwan.net/poem33668.html","السريع"],[559,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[559,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[559,"جميع الكون مظهره","https://www.aldiwan.net/poem34460.html","مجزوء الوافر"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"أصبحت للدنيا الدنية","https://www.aldiwan.net/poem2753.html","مجزوء الكامل"],[576,"قد همت بالبدوي في الحلل","https://www.aldiwan.net/poem2886.html","أحذ الكامل"],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[588,"أضرب السحر الذي أنت ناظمه","https://www.aldiwan.net/poem11506.html","عموديه"]],"verses":[["وَعُقابُ المَلاعِ تُلحِمُ فَرخَي","ها بِإِزليقَةٍ زَلولِ القِنانِ",0,"ن",1,0],["وَعِقدٍ مِنَ الأَخدانِ أَوهى نِظامَهُ","كُرورُ الرَزايا وَاِعتِقابُ الطَوارِقِ",1,"ق",1,0],["وَعَقابيلَ غَرامٍ","يُذكِرُ القَلبَ حُقوقَه",2,"ق",2,0],["وَعِقالَ كُلِّ مُشَيَّعٍ مُتَغَطرِفٍ","وَمَجالَ كُلِّ مُوَضَّعٍ مَضعوفِ",3,"ف",1,0],["وعُقْدَةِ مُلْكٍ كانَ ربُّكَ كالِئاً","لَها وأصيلُ السّعْدِ يُغْني عنِ النّقْدِ",4,"د",1,0],["وَعَقْلَكَ الْمَوْهُوبَ حَكِّمْهُ فِي","الأَحْوَالِ وَاشْكُرْ فَضْلَ وَهَّابِهِ",5,"ب",2,0],["وَعَقلاً وَلوعاً بِالكُنوزِ فَإِنَّهُ","عَلى الدُرِّ غَوّاصٌ بِبَحرِ عُمانِ",6,"ن",1,0],["وَعُقولاً لَولا الخُمولُ تَوَلّا","ها لَفاضَت غَرابَةً وَاِبتِداعا",7,"ع",2,0],["وعقيلة للكفر لما رُعْتَها","أخرست من ناقوسها المهذارِ",8,"ر",1,0],["وَعَقَّتِ الخَيلُ عَجاجاً كَدرا","أَقامَ مِن بَعدِ الثَلاثِ عَشرا",9,"ر",2,0],["وعقد بندٍ على خصر رجعت به","ذا ناظر بنجومِ الليلِ معقود",10,"د",1,0],["وعقدُهُ الدهرَ فيا ويلهُ","أوجهُهُ المقبوح والدهر",11,"ر",1,0],["وعقدْتَ من عُقد المكا","يدِ للعِدا ما لا يُحلُّ",12,"ل",1,0],["وعققْنَني لمّا ادَّعيْنَ عُمومَتي","ومن النساءِ معقَّةُ الأعمامِ",13,"م",1,0],["وَعُقَّرٍ خالِداتٍ حَولَ قُبَّتِها","وَطامِسٍ حَبَشِيِّ اللَونِ ذي طَبَبِ",14,"ب",1,0],["وَعُقولُ الناسِ في رَغ","بَتِهِم فيها سَخيفَه",15,"ف",2,0],["وعقلٍ من الأَضواءِ في رأسِ نابغٍ","وعقلٍ من الظَّلماءِ يحملهُ فَدْمُ",16,"م",1,0],["وعقرباها والزما","ن في اختلاف بين",17,"ن",1,0],["وَعَقلٌ بَعيدُ مَرامي الطِما","حِ كَبيرُ اللُبانَةِ وَالمَأرَبِ",18,"ب",1,0],["وعَقَدْتِ بينَ قَضِيبِ بانٍ أهْيَفٍ","وكَثِيبِ رَمْلٍ عُقْدَةَ الزُّنّارِ",19,"ر",1,0],["وَعِقابُ لُبنانٍ وَكَيفَ بِقَطعِها","وَهُوَ الشِتاءُ وَصَيفُهُنَّ شِتاءُ",20,"ا",2,0],["وَعقفاءَ مثلِ هِلالِ السَّما","ولكنَّها لَبِسَتْ سُنْدُسا",21,"س",2,1],["وَعَقربا صدغيكِ من عَنبَرٍ","سَمُّهُما ويلاهُ مِن عَقرَبيك",22,"ك",1,0],["وعقبى ذلك الجدلِ اصطلحْنا","وقدْ حصلَ الوفاقُ على الخلافِ",23,"ف",1,0],["وعُقولٌ عَمرتْ أوهامُها","مَوْطِنَ الحقِّ ومُحتَلَّ اليقين",24,"ن",1,0],["وَعَقيلَ بنِ أَسودٍ","البَأسِ ليومِ الهياجِ وَالدُفَعَه",25,"ع",2,0],["وَعَقرَبٌ مَمدودَةٌ قَتّالَه","وَجُعَلٌ وَفارَةٌ بَوّالَه",26,"ه",1,0],["وَعِقابُهُ عَدلٌ وَعَزمَتُهُ","كَالمَشرِفِيِّ وَوَعدُهُ نَذرُ",27,"ر",1,0],["وَعَقَدْتَ رأْيَكَ فيهِمُ فَلَقِتَهُمْ","فَرْداً بِجَيْشٍ لا يُطاقَ لُهامِ",28,"م",1,0],["وَعُقارٍ كَأَنَّما نَتَعاطى","في كُؤوسِ اللُجَينِ مِنها سِراجا",29,"ج",2,1],["وَعَقارِبُ الحُبِّ الَّذي","يُخفي مِنَ الوَسواسِ قَلبُه",30,"ب",2,0],["وَعِقابُ والِدِكَ الرَؤوفِ تَحَدُّبٌ","وَيُشَقُّ أَنفُ الطِرفِ خَشيَّةَ بُهرِهِ",31,"ر",2,0],["وَعَقلُكَ يا أَخا السَبعينَ واهٍ","كَأَنَّكَ في مَلاعِبِكَ إِبنُ سَبعِ",32,"ع",1,0],["وَعُقولٌ لَيسَت تَرُدُّ فَتيلاً","لِقَضاءٍ في عالَمِ اللَهِ بالِغ",33,"غ",1,0],["وَعَقائِلُ الأَلبابِ غَيرُ أَوامِرٍ","بِأَذاةِ أَيتامٍ وَهَتكِ عَقائِلِ",34,"ل",1,0],["وعقائلٌ خلفَ الخدور هواتفٌ","كالطير أذن بالصباح هبوبها",35,"ب",3,0],["وعقدتُ من شعري ومن ريحانها","إكليلَ غارٍ أو نظيمَ جُمانِ",36,"ن",1,0],["وَعَقِيلاتٍ بِمَا يُحْسِنَّهُ","زِينَةُ الدُّنْيَا وَعُمْرَانُ الدِّيَارِ",37,"ر",1,0],["وعَقيدةٍ لو صُوِّرَتْ بمُماثلٍ","كانت تكونُ رَصانَةَ الأطْواد",38,"د",1,0],["وَعَقِيْدَةٌ لَوْ هُزَّتِ الأَجْبَالُ مِنْ","ذُعْرٍ لَمَا اهْتَزتْ مَعَ الأَجْبَال",39,"ل",1,0],["وعقدة ملك كان ربك كالئا","لها وأصل السعد يغني عن الجد",40,"د",1,0],["وعُقابُ \" لبنانٍ \" تَضُمُّ جَناحَها","تحمي الفِراخَ وتحرُسُ الزُّغلولا",41,"ل",2,0],["وعقد نِهَيتُ فؤادي، لوْ يُطاوِعُني،","عَن ذي دَلالٍ، غرِيبِ الحسنِ مفرَدِهِ",42,"د",2,0],["وعقيدة وطنيّة عربيّة","فيها نصول على العدى ونطول",43,"ل",1,0],["وعقد كانَ عَوْفٌ ذا ذُحُولٍ كَثِيرَةٍ","وَذا طَلَباتٍ تَتْرُكُ الأنْفَ أجْدَعا",44,"ع",2,0],["وعقدت حب قلوب كلها","معقودة العقول في ازرارها",45,"ر",3,0],["وعقل قد يدير رحى البرايا","ولفظ كالقضاء له مضاء",46,"ا",2,0],["وعقل وإسلامٌ وعفو عن الورى","ومعرفة حب الإله ومرحما",47,"م",2,0],["وعقَلنا الناجياتِ خلاءً","وربَطنا المُقْرَباتِ ارتهاصا",48,"ص",2,0],["وعَقَّار كُومِ الصَّفايا إذا","تعذَّرَ عند الضُّروع الحليبُ",49,"ب",1,0],["وَعُقوقُ أَرمانوسَ حينَ أَبَيتَ نُص","رَتَهُ أَباحَكَ وُدَّ ميخائيلا",50,"ل",2,0],["وَعَقْرَبُ الصُّدْغِ قَدْ بَانَتْ زُبانَتُهُ","وَنَاعِسُ الطَّرْفِ يَقْظانٌ عَلى رَصَدي",51,"د",2,0],["وعقولكم مما استطال كمالُها","تزنُ الرجال لكم بلا ميزانَ",52,"ن",1,0],["وَعُقارٍ عَتَّقَتها","بَعدَ أَسلافٍ خُلوفُ",53,"ف",1,0],["وَعُقارٌ ذَوْبُ شَمْسٍ","جَمَعَتْ حُسْناً وَطِيبَا",54,"ب",2,0],["وَعَقْرَبَهُ فِي الْغَرْبِ تَهْوِي كَأنَّهَا","تُشَكِّلُ فِي حَقِّ التَّشَابُهِ عَقْرَبَا",55,"ب",2,0],["وعِقْد الفضلِ منظومُ اللآلى","لديها لا يُفَكُّ ولا يُفضُّ",56,"ض",1,0],["وعقدتَ بين قضيب بانٍ ناعمٍ","وكثيب رملٍ عقدة الزُّنّارِ",57,"ر",1,0],["وعُقَار ثغرِك إنَّ بي","طَلَباً يطول إلى عُقَارِهْ",58,"ر",2,0],["وَعَقيدَةُ الإِنسانِ راسِخَةٌ بِهِ","حَتّى يُحجّبَه الرَدى بِحِجابِهِ",59,"ب",2,0],["وَعُقدَتي في هَواهُم","بِحالِها ما تُحَكُّ",60,"ك",1,0],["وَعَقَلْتُهُ بِعُلاكُمُ","فِلِذَا الرَّوِيُّ بِهِ مُقَيَّدْ",61,"د",1,0],["وَعِقْدُ الْمُنَى غَيْرُ مُنْتَثِرٍ","وَسَعْدُكَ دَانَ بِمَا قَدْ دَنَوْا",62,"و",2,0],["وعُقَّالٍ يُلازِمُها شَديدٍ","ومِن هَدمِ المَعَالِفِ والرِّكالِ",63,"ل",1,0],["وعقدَ يدٍ بيدٍ رَخصةٍ","يفوزُ بتَقبيلها مَن صَبر",64,"ر",1,0],["وَعَقْدُها جَلّ عَنِ العَقائِدِ","كانَت لَها السَعود بالمَراصِدِ",65,"د",1,0],["وعقلك ميزان ورأيك حاكم","فانصف لحكم ثم عدل لميزان",66,"ن",1,0],["وعقبي مغرب في كل ليل","إلى التسعين تتبعها بعشر",67,"ر",1,0],["وَعَقدٌ وَثيقٌ لا يُحَلُّ وَذِمَّةٌ","لَها شاهِدٌ بِها وَكِتابُ",68,"ب",1,0],["وَعَقدُ زِنّاري وَأَترابُها","يَأباهُ مَن حَلَّ بِهِ الصُلبُ",69,"ب",1,0],["وَعُقودِ عَهدِ العاشِقينَ وَمَن غَدا","بِعُرى الوُلا في عِشقِهِ مُتَمَسِّكا",70,"ك",2,0],["وَعَقرَبَ الصَدغِ عِندَ لَفتَتِهِ","لَيلاً تَبَدّى ما بَينَ صُبحَينِ",71,"ن",1,0],["وَعَقارب سود تسلّ صَوارماً","بيضاً لَها حمر المَنايا مُكتَسى",72,"س",2,0],["وَعقيب ذَلك أَن يَكون غِذاؤُهُ","مِمّا سلحنَ تَمعلكاً وَتَمعلسا",72,"س",2,0],["وَعَقرب فَوقَ ذاكَ الصدغ ما لَدَغَت","شَيخاً بِها ساحَ مِن عشق وَلا وَلَدا",73,"د",2,0],["وَعقد كَمال زان مِنكَ شَمائِلاً","تَملّكته مِن مالك الحلِّ وَالعقدِ",74,"د",1,0],["وَعقد دُرّ فَريد","أَنماهُ بَيت مُحَرّم",75,"م",1,0],["وَعَقرَب الصَدغ يَحمي نرجس المقل","تُضىء في الحلة الحَمراء طَلعَتُه",76,"ه",1,0],["وعَقلتُ ناجيتي بفضْلِ زِمامِها","لمّا رأيتُ خيامَهمْ بالمنحنى",77,"ن",2,0],["وعَقْدُكَ مجلسَ النَّظَرِ افْتِخاراً","ومالكَ يومَ مكرُمةٍ مُدان",78,"ن",1,0],["وَعَقرَبٍ في وَردِ خَدٍّ وَفي","مُستَأنِسِ اللَثمِ بِها نَدَّهْ",79,"ه",1,1],["وَعَقرَبٍ في الخَدِّ مِن مِسكَةٍ","أَمسَكَ أَن يَأكُلَها الجَمرُ",80,"ر",1,1],["وَعَقرَبٌ قلتم فَلا لامِسٌ","وَقُلتُمُ نَدٌّ فَلِمْ لا اِحتَرَقْ",81,"ق",1,0],["وَعَقرَبٍ في الخَدِّ قَد رابَني","في ذَهَبِ الخَدَّينِ مَمشاها",82,"ه",2,1],["وعقلٌ لا يرى العقلاءَ جهلٌ","وفكرٌ غير وقّادٍ بليدُ",83,"د",1,0],["وَعقبان حَرب فَوق جَرد لَو أَنَّهُم","أَغاروا عَلى نسر السَماء لَما نَجا",84,"ج",2,0],["وعقده استغراق كل القلب","بذكر مولانا الكريم ربي",85,"ي",1,0],["وعُقُولٌ وَعْيُها مُسْتَلَبٌ","وقلوبٌ رُوحُها مُسْتَلَبَهْ",86,"ب",2,0],["وَعَقلٍ كَعذبِ الماءِ مِن نظم عَقله","بِعَقلِ سواه فَهوَ عَذبٌ زُلالِهِ",87,"ل",2,0],["وعقارب صدغ قد درجت","لدغت لفؤادي يا أسما",88,"م",2,0],["و