x?id=111711",""],[5533,"لم يَكُنْ قَلْبِي مَعِي","https://www.poetsgate.com/ViewPoem.aspx?id=179939",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5582,"هَلْ ما عَهِدْتُ مِنَ البَشاشَةِ عائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186883",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"ليلات الشقاء","https://www.poetsgate.com/ViewPoem.aspx?id=184798",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5977,"مطر وشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212726",""],[6019,"يا أقسى من ليلٍ أسودْ","https://www.poetsgate.com/ViewPoem.aspx?id=202307",""],[6102,"فُرات !!","https://www.poetsgate.com/ViewPoem.aspx?id=184551",""],[6124,"فجر التفعيلة","https://www.poetsgate.com/ViewPoem.aspx?id=174828",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""]],"verses":[["وَخَرَجتُ أَسحَبُها وَلي","فَوقَ العُلى وَالنَجمُ دونُ",0,"ن",1,0],["وَخَرَجتُ عَن أَعجازِهِ مِن بَعدِ ما","جَذَبَ النُعاسُ عَمائِمَ الرُكبانِ",1,"ن",1,0],["وَخَرقٍ تَدافَعَهُ المُقرَبا","تُ خَوفاً وَتَنفُرُ مِنهُ الرُسُم",2,"م",1,0],["وَخَرَّ لِلمَوتِ لا كَفٌّ تُقَلِّبُهُ","إِلّا بِوَطءٍ مِنَ الجُردِ المَحاضيرِ",3,"ر",1,0],["وَخَرقٍ كَالسَماءِ خَرَجتُ مِنهُ","بِجَريِ أَقَبَّ يَركَعُ في السُهوبِ",4,"ب",1,0],["وخِرْقٍ إِلى فَرْعَيْ خُزَيْمَةَ يَنْتَمي","ويَعلمُ أنّ الجُودَ للعِرْضِ حارِسُ",5,"س",1,0],["وَخَرقٍ مَخوفٍ قَد قَطَعتُ بِجَسرَةٍ","إِذا خَبَّ آلٌ فَوقَهُ يَتَرَقرَقُ",6,"ق",1,0],["وَخَرقٍ مَخوفٍ قَد قَطَعتُ بِجَسرَةٍ","إِذا الجِبسُ أَعيا أَن يَرومَ المَسالِكا",7,"ك",2,0],["وَخَرقٍ يَعِجُّ العَودُ أَنَّ يَستَبينَهُ","إِذا أَورَدَ المَجهولَةَ القَومُ أَصدَرا",8,"ر",2,0],["وَخَرقٍ يَخافُ الرُكبُ أَن يُدلِجوا بِهِ","يَعَضّونَ مِن أَهوالِهِ بِالأَنامِلِ",9,"ل",1,0],["وَخَرَجتَ مِن حُجبِ الغُيوبِ مُحَجَّلاً","في كُلِّ لَحظٍ مِنكَ أَلفُ صَباحِ",10,"ح",1,0],["وَخَرَجتُ أَمشي القَهقَري مُتَسَتِّراً","بِقرونِ حاجِبِهِ الزَكي اِبنِ القيني",11,"ن",2,0],["وَخَرَجتَ مِنهُ مِثلَما","خَرَجَ الحُسامُ مِنَ الجِلاءِ",12,"ا",2,0],["وَخَرقٍ بَعيدٍ قَد قَطَعتُ نِياطَهُ","عَلى ذاتِ لَوثٍ سَهوَةِ المَشيِ مِذعانِ",13,"ن",1,0],["وَخَرقٍ كَجَوفِ العيرِ قَفرٍ مَضَلَّةٍ","قَطَعتُ بِسامٍ ساهِمِ الوَجهِ حُسّانِ",13,"ن",1,0],["وَخَرقٍ كَأَنضاءِ القَميصِ دَوِيَّةٍ","مَخوفٍ رَداهُ ما يُقيمُ بِهِ رَكبُ",14,"ب",1,1],["وَخَرَّت عَلى الأَرضِ السَماءُ فَطَبَّقَت","وَماتَ جَميعاً كُلُّ حافٍ وَناعِلِ",15,"ل",1,0],["وَخَرقٍ كَساهُ اللَيلُ كِسراً قَطَعتُهُ","بِيعَمَلَةٍ بَينَ الدُجى وَالمَهارِقِ",16,"ق",1,0],["وَخَرقٍ إِذا الآلُ اِستَحارَت نِهاؤُهُ","بِهِ لَم يَكَد في جَوزِهِ السَيرُ يَنجَعُ",17,"ع",1,0],["وخرساءَ لم ينطق بحرفٍ لسانها","سوى صوت عرق نابض بحشاها",18,"ا",3,1],["وخرّ من وجد على الناصيه","وقلبه يركض ركض الظليم",19,"م",1,0],["وَخَرَّ في بَحرِ الرِماحِ الأَشطان","عَلى الجَبينِ ساجِدَ العِمران",20,"ن",1,0],["وَخَرقٍ مِنَ المَوماةِ أَزوَرَ لا تُرى","مِنَ البُعدِ إِلّا بَعدَ خَمسٍ مَناهِلُه",21,"ل",2,0],["وَخَرقٍ قَد قَطَعتُ بِيَعمَلاتٍ","مُمَلّاتِ المَناسِمِ وَاللُحومِ",22,"م",1,0],["وَخِرقٍ كَنَصلِ السَيفِ قَد رامَ مَصدِفي","تَعَسَّفتُهُ بِالرُمحِ وَالقَومُ شُهَّدي",23,"د",2,1],["وَخرقٍ تعزف الجنان فيه","لأفئدة الكماة لها وجيبُ",24,"ب",1,1],["وَخَريدَةٍ كَرُمَت عَلى آبائِها","وَعَلى بَوادِرِ خَيلِنا لَم تُكرَمِ",25,"م",1,1],["وَخَرّاجٌ مِنَ الغَمَراتِ خِرقٌ","أَبو شِبلَينِ مَحمِيُّ الذِمارِ",26,"ر",1,0],["وَخَرقاءُ وَرقاءُ بَطيءٌ كَلالُها","تَكَلَّفُ بي ما لا تُطيقُ الأَباعِرُ",27,"ر",1,0],["وَخَرائِدٌ مِثلُ الدُمى يَسقينَنا","كَأَسَينِ مِن لَحظٍ وَمِن صَهباءِ",28,"ا",2,0],["وخريقٍ تَلُفُّهُ في كِناس","عُدْمُليٍّ بجانبيه حوامي",29,"م",2,0],["وَخَرَجتُ لا أَلوي عَلى أَحَدٍ","وَرَضيتُ بَعدَ الزُهدِ بِالكُفرِ",30,"ر",1,0],["وَخَرقٍ كَضَهرِ التِرسِ قَفرٍ قَطَعتُهُ","بِعامِلَتَينِ ظَهرُهُ لَيسَ يُعمَلُ",31,"ل",1,0],["وخريرُ الماءِ لهُ نَغَمٌ","نَسَماتُ الغابِ تُرَدِّدُهُ",32,"د",2,0],["وخَريرُ النَّهْرِ سَكْرا","نٌ وزَهْرُ الرَّوضِ صاحِ",33,"ح",1,0],["وخرقت جلباب السحا","ب فمن هوى بك من سحابك",34,"ك",1,0],["وخريذ كو شهاب لاح منبثقا","كدمعة من عيون الليل تنحدر",35,"ر",1,0],["وخرّى على أقدامه وتذللي","له أن من يبدي الهوى متذلل",36,"ل",1,0],["وخرّجوه عليما","وأنشئوه مبينا",37,"ن",2,0],["وَخَرَجتُ مِن بَينَ الجُسورِ لَعَلَّني","أَستَقبِلُ العَرفَ الحَبيبَ إِذا سَرى",38,"ر",2,0],["وَخَرقٍ مَكانُ العيسِ مِنهُ مَكانُنا","مِنَ العيسِ فيهِ واسِطُ الكورِ وَالظَهرُ",39,"ر",1,0],["وَخَرَّقتَ غُفّورَها كافِراً","بِمَن غَزَلَ الثَوبَ أَو مَن نَسَج",40,"ج",1,0],["وَخِرقٌ مَتى اِمتَدَّت يَداهُ بِنائِلٍ","فَما النَيلُ مِنها بِالزَهيدِ وَلا نَزرِ",41,"ر",1,0],["وَخَرَجنا مِن بابِ ذِكراكَ فَالذِك","رى تَشَكّى شَماتَةَ النِسيانِ",42,"ن",1,0],["وَخَرَّت شَياطينُ البِلادِ كَأَنَّها","مَخافَةَ أُخرى في الأَزِمَّةِ خُضَّعُ",43,"ع",1,0],["وَخَرقٍ كَفَرجِ الغَولِ يَخرَسُ رَكبُهُ","مَخافَةَ أَعداءٍ وَهَولِ جِنانِ",44,"ن",1,0],["وخَرَّتْ في قُرى جَيجانَ تَردي","بجائجةٍ عليها أو تَرودُ",45,"د",1,0],["وخَرْقٍ طال فيه السَّيرُ حتى","حَسِبناه يسيرُ مع الرِّكابِ",46,"ب",1,0],["وخرقٌ تخرَّقَ في المكرُماتِ","فغطَّت ْيداه حِجَابَ العَطاءِ",47,"ا",2,0],["وَخَرقٍ تَهلِكُ الأَرواحُ فيهِ","بَعيدِ الغَورِ مُشتَبِهِ المِتانِ",48,"ن",1,0],["وَخَرَّجَها صَوارِخُ كُلِّ يَومٍ","فَقَد جَعَلَت عَرائِكُها تَلينُ",49,"ن",1,0],["وَخَريدَةً هِيَ في الجَمالِ فَريدَةٌ","فَهِيَ الغَريبَةُ وَهيَ في الأَوطانِ",50,"ن",1,0],["وَخَرَرتُ بَينَ يَدَيهِ أَعلَمُ أَنَّهُ","ذُخري لِيَومِيَ شِدَّةٍ وَرَخاءِ",51,"ا",2,0],["وَخَرقٍ سَحيقٍ يَملَأُ الصَدرَ وَحشَةً","بِرَجعِ صَهيلِ الطِرفِ فيهِ وَيوقِدُ",52,"د",1,0],["وَخَرقٍ بِهِ البومُ تَرثي الصَدى","كَما رَثَتِ الفاجِع النائِحَه",53,"ح",2,0],["وَخُرَّدٍ كَالمَها بِدائِرَةٍ","تَرعاهُ إِلا الدِماثَ وَالنَفَلا",54,"ل",2,0],["وَخَرقٍ يُجِرُّ القَومَ أَن يَنطِقوا بِهِ","وَتَمشي بِهِ الوَجناءُ وَهِيَ لَهيدُ",55,"د",1,0],["وخِرقٌ له في لِبْدَةِ الليْثِ مَرتعٌ","وفي لهواتِ الأرقمِ الصَّلِ مَرسَخُ",56,"خ",1,0],["وَخَرَجتُ أَخبِطُ سادِراً","لَم أَغنَ عَن حُبِّ الغَواني",57,"ن",2,0],["وَخِرقٍ يَجِلُّ الكَأسَ عَن مَنطِقِ الخَنا","وَيُنزِلُها مِنهُ بِكُلِّ مَكانِ",58,"ن",1,0],["وخرّقوا الفقحة من بعلها","فإنّهُ قد عقر الناقه",59,"ق",2,0],["وَخَريدَةٍ سودٍ ذَوائِبُها","قَد ضُمِّخَت بِالمسكِ وَالوَرسِ",60,"س",1,1],["وَخُروجٌ مِنَ الأَضاميمِ في المَن","سَجِ مِنهُ وَفي القَطاةِ اِنتِصابُ",61,"ب",1,0],["وَخَرَّقَ ثَوبَ العَيشِ طولُ لِباسِهِ","وَهَبَّت حَريقٌ طُيِّرَت بِحَريقِ",62,"ق",1,0],["وَخَرقُ مَفازَةٍ كُسِيَت سَراباً","يُعَرّي الذِئبَ مِن وَبَرٍ مُكِنِّ",63,"ن",1,0],["وَخَرقٍ قَد ذَعَرتُ الجونَ فيهِ","عَلى أَدماءَ كَالعيرِ الشَنونِ",64,"ن",1,0],["وَخِرقٍ مِنَ الفِتيانِ أَكرَمَ مَصدِقاً","مِنَ السَيفِ قَد آخَيتُ لَيسَ بِمَذروبِ",65,"ب",1,0],["وَخَرقٍ تَصيحُ الهامُ فيهِ مَعَ الصَدى","مَخوفٍ إِذا ما جَنَّهُ اللَيلُ مَرهوبِ",65,"ب",1,0],["وَخَرقِ مَرُوراةٍ يَحارُ بِها القَطا","تُرَدِّدُ فِيهِ هَمَّهُ أَينَ يَذهَبُ",66,"ب",1,0],["وخَرَّبوا الحُصونَ والمَدائِنا","وأَقفروا من أهلها المَساكِنا",67,"ن",2,0],["وَخَرَّت بفعل السم فيها صَريعة","فَيا لَك من سمٍّ هنالك يصرع",68,"ع",1,0],["وَخرت عَلى وجه التراب يرجها","غياب وَقالَت وَهي كالشَمس في الأفل",69,"ل",1,0],["وَخَرَجْتُ أَخْتَرِقُ الصُّفُوفَ مِنَ الْعِدَا","مُتَلَثِّمَاً وَالسَّيْفُ يَلْمَعُ فِي يَدِي",70,"د",2,0],["وخُرسٌ بالنهارِ لطولِ صمتٍ","علَيهِم من سكينَتِهم خشوعُ",71,"ع",1,0],["وخريطة الوطن الكبير فضيحة","فحواجزٌ ومخافرٌ وكلاب",72,"ب",1,0],["وخروجٌ من الأضاميم في المنس","مِنْهُ وَفي الْقَطَاة انْتصَاب",73,"ب",1,0],["وَخَرْقٍ بَعِيدٍ قد قَطَعْتُ نِيَاطَهُ","على ذاتِ لَوْتٍ سَهوَة ِ المشْيِ مِذعانِ",74,"ن",1,0],["وخَرقٍ كظهر الترسِ ، قَفْرٍ قطعتهُ","بِعَامِلتين ، ظهر