ِ كَرهاً مُجبَرٌ","وَدَواؤُنا يُلقي إلينا الداءَ",104,"ا",2,0],["وخرير من جدول معشب الضفّ","ة يجري إلى حفاف الوادي",105,"ي",1,0],["وخرب ما شادوه من كل معقل","فلست ترى حصناً لهم غير خارب",106,"ب",1,0],["وخرج بعد ذاك له أناس","من النظار فاطِّرِحِ التغابي",107,"ب",2,0],["وخر له ساجدً مَن غدا","يشب له قبل نار العطب",108,"ب",1,0],["وخَرَّ لّضما أولَيْتُ شُكري ساجِداً","ومِثلُ الّذي أوليتُ يعبدُهُ الشُّكْرُ",109,"ر",1,1],["وخرشفيٍّ لا يوارى عيبه","قطعة لؤم صيغ من طين الخنا",110,"ا",1,0],["وخرّبوا كلَّ ما يغنى وقد عمروا","ما كان يبقى فيا حسن الذي عملوا",111,"ل",3,0],["وخَرَجْتُ أَطوِي عن بَلَرْمَ صحيفةً","ما نُشِّرَتْ إِلا لكَيْ تطوِيني",112,"ن",2,0],["وخرّ صريعا والرماح تنوشهُ","لدى الروم إذ خانته حقا جحافله",113,"ل",2,0],["وخَرَّ لَهَا الصليبُ بكلِّ أَرضٍ","صريعاً للجبينِ ولِلْيَدَيْنِ",114,"ن",1,0],["وخروا على أجياهكم فوق قبره","كما خر موسى صاعاٌ وانشقوا اللبنا",115,"ن",2,0],["وخر من عرشه المنهوك في وجل","كأنما هو من خوص وعيدان",116,"ن",1,0],["وخَرْقٍ ميِّت الأشخاص عافٍ","وسيعٍ ليس يُرقَع منه خَرقُ",117,"ق",1,0],["وخرقاءَ مُعرِقةٍ في الضلا","ل شاقك في القَصد إرشادُها",118,"د",3,1],["وخرَّقَ ما تحته ظهرَها","كما تَخرقُ الشمسُ ثوبَ السحابِ",119,"ب",1,0],["وخُرَّداً أرسلتُها شُرَّداً","من حابلٍ منكم ومن حائبِ",120,"ب",1,0],["وخُراسان فَصَوْناً ضافياً","أنها أرضُ علي بن الحسن",121,"ن",1,0],["وخريدةٍ زُفَّتْ فأمهرها ولو","سمعاً فليس تحِلُّ حتى تُمهرا",122,"ر",2,0],["وخريدةٍ بيضاءَ ليلةُ شعرها","من هجرها وجبينها من وصلها",123,"ل",3,1],["وَخَرَّبَت صُروفُهُ ما عَمَّرا","فَالحَمدُ لِلَهِ عَلى ما قَدَّرا",124,"ر",2,0],["وَخَريفٍ مِنَ الوَفاءِ نَضيرٍ","وَرَبيعٍ مِنَ الحِفاظِ أَنيقِ",125,"ق",1,0],["وَخَرقٍ تَحسِرُ الرُكبانُ فيهِ","بَعيدِ الغَولِ أَغبَرَ ذي نِياطِ",126,"ط",1,0],["وخريدةٍ أبكي ويبسِمُ ثغرُها","فتغارُ مِلْخَجلِ البروقُ اللمَّعُ",127,"ع",1,0],["وخَرْقٍ جزعنا بالمطيَّ سرابَهُ","وما فوقَها للبينِ غيرُ جَزُوعِ",128,"ع",1,0],["وخَرقٍ به البزلُ المراسيلُ جُنَّحٌ","نواحلُ كالأرسانِ تنفخُ في الخُطمِ",129,"م",1,0],["وخَرْقٍ أزرناهُ النجائبَ ضلَّعاً","تجوبُ بنا مَرْتاً مِن الب