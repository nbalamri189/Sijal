{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55060","الخفيف"],[124,"أغرقت في بحر الأسى الأجذالا","https://www.aldiwan.net/poem49298.html","الكامل"],[310,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120100","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101036","المجتث"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117162","الطويل"],[4816,"باقي الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=8451",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[5605,"هذي المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=159788",""],[5829,"أم اعيش فأطرب","https://www.poetsgate.com/ViewPoem.aspx?id=184482",""]],"verses":[["يُرْخِصُ النَّفْسَ وَالنَّفَائِسَ بَذْلاً","فِي سَبِيلِ القِيَامِ بِالمِيثَاقِ",0,"ق",1,0],["يرخى الظلام سدوله فتعينه","وترى العيون سواده القتالا",1,"ل",2,0],["يُرخي سدول العذرِ دونَ ذنوبهِ","وَيَصونه عن مخجل التأنيبِ",2,"ب",1,0],["يُرخِصنَ في النَومِ الوِصال وَطالَما","أَغلَينَ صَفقته عَلى اليَقظانِ",3,"ن",1,0],["يرخص الرفد بنادي","ها كما يغلو المديحُ",4,"ح",1,0],["يرخى الوقار عليه","من الكمال سدولا",5,"ل",2,0],["يرَخِّمُ بيضَ العامِ تحت دجاجهِ","ليُخرجَ بيضاً من فراريخ قابِلِ",6,"ل",1,0],["يرخص كلامه باعذب اللطف واللين","ويغلا حلاله ثابت حافظ العهد",7,"د",1,0],["يرخصون المال والمال امتثالي","وللدراسه والوظيفة كل تحيّه",8,"ي",2,0],["يُرْخِىْ علينا عمى الألوان مَسْحَتَهُ","حتَّى تساوى لدينا الغصنُ بالفنن",9,"ن",1,0],["يرخي على اﻻمال سترا قاتما","ويبدد اﻻحﻻم تأتي تهرب",10,"ب",1,0]]}