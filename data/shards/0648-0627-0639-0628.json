{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[94,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[60,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147462","البسيط"],[131,"وأعبد أن أسبهم بقومي","https://www.aldiwan.net/poem24203.html","الطويل"],[132,"إما فررت من العدى","https://www.aldiwan.net/poem50633.html","الطويل"],[136,"ليعلم من تأمله بأنا","https://www.aldiwan.net/poem54766.html","الطويل"],[201,"حي الصباح إذا تبسم","https://www.aldiwan.net/poem39901.html","مجزوء الكامل"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[234,"لا والمضرج ثوبه","https://www.aldiwan.net/poem51271.html","مجزوء الكامل"],[242,"عليه صلاة حليم","https://www.aldiwan.net/poem19790.html","المتقارب"],[275,"للقلب إن طال البعاد تقرب","https://www.aldiwan.net/poem35241.html","الكامل"],[275,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[333,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[347,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[396,"أسأل الرحمن لا تسأل سواه","https://www.aldiwan.net/poem54436.html","عموديه"],[396,"باسمك اللهم أبدى ما خطر","https://www.aldiwan.net/poem54574.html","عموديه"],[405,"أشبه أباك يا حسن","https://www.aldiwan.net/poem4521.html","مجزوء الرجز"],[484,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[505,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[510,"الحظّ","https://www.aldiwan.net/poem42462.html","الطويل"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[563,"هذا وهذا ثم هذا بعده","https://www.aldiwan.net/poem34608.html","الكامل"],[563,"يا عقل كم منك قلة الأدب","https://www.aldiwan.net/poem34932.html","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64039","الهزج"],[902,"","https://poetry.dctabudhabi.ae/diwan/poem/146304","البسيط"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44806","المتقارب"],[1145,"","https://poetry.dctabudhabi.ae/diwan/poem/145218","الخفيف"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145166","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101058","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45459","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53034","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27706","الكامل"],[2272,"","https://poetry.dctabudhabi.ae/diwan/poem/131431","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126998","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206131","الكامل"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126510","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77064","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136899",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136594",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57951","الكامل"],[4677,"عشق","https://www.poetsgate.com/ViewPoem.aspx?id=204135",""],[4702,"مشوار عز","https://www.poetsgate.com/ViewPoem.aspx?id=155169",""],[4755,"حَنين","https://www.poetsgate.com/ViewPoem.aspx?id=184513",""],[5033,"حسّان","https://www.poetsgate.com/ViewPoem.aspx?id=183980",""],[5072,"قلب ٌ غزاها","https://www.poetsgate.com/ViewPoem.aspx?id=51897",""],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5376,"والفجرِ وليالٍ عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205810",""],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5431,"قد جاء في (ظلل الغمام) وجنده","https://www.poetsgate.com/ViewPoem.aspx?id=197376",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5737,"في شهداء عزلة ( الأَجْعُود )","https://www.poetsgate.com/ViewPoem.aspx?id=177995",""],[5846,"نداءُ شاعرة..","https://www.poetsgate.com/ViewPoem.aspx?id=123432",""],[5952,"وحْدي","https://www.poetsgate.com/ViewPoem.aspx?id=196822",""],[5956,"هل ذاك حلم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183899",""],[6068,"ورئم في ربا الإسلام صالا -04-","https://www.poetsgate.com/ViewPoem.aspx?id=175877",""],[6243,"منعرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84441&r=&rc=15",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[6291,"لم أزل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87671&r=&rc=4",""]],"verses":[["وأعْبَثُ بالنَّسيبِ ولَسْتُ أغْشى ال","حَرامَ فيَقْطُرُ السِّحْرَ الحَلالا",0,"ل",2,0],["واعبدِ الأَمسَ وادَّكِرْ صُوَرَ الماضي","فدُنْيا العجوزِ ذِكرى شبابِهْ",1,"ه",1,0],["وَاِعبُد إِلَهَكَ ذا المَعارِجِ مُخلِصاً","وَاِنصِت إِلى الأَمثالِ فيما تُضرَبُ",2,"ب",1,0],["وَاِعبَأ لِنَبلِكَ بارِياً وَمُرَكِّباً","أَرِباً يُقَوِّمُ أَسهُمَ الأُسوارِ",3,"ر",1,0],["وأعبد الله لا أرجو مثابته","لكن تعبد إكرام وإجلال",4,"ل",1,0],["وأعبدُ أن أسبهُمُ بقومي","وأتركَ دارمَا وبني رياحِ",5,"ح",1,1],["واعبدْ إلهَك بكرةً","وعشيةً طولَ المدَى",6,"د",2,0],["وأَعبُدُ مَن لَهُ سَبَبُ إِلَيهِ","ولَو عَبداً تَوَغَّلَ في الخَمُولِ",7,"ل",1,0],["واعبد بمملكة الجمال","جلالة الملك المعظم",8,"م",1,0],["واعبر عباب الدردني","ل وحييِّ حيَّ الأكرمين",9,"ن",1,0],["وأعْبَثْ بما في العِقْدِ منْ","ني لا بما تحت الرّداء",10,"ا",2,0],["وَأَعْبِقْ بِذَاتِ النُّشُورْ","صَلاَةً لِمُبْدِي مُعِيدْ",11,"د",1,0],["واعبُس إذا أبصرت ثغراً باسماً","إنَّ الملاحةَ كالسَّعادَةِ تكذب",12,"ب",1,0],["وأعبدُ منها بينَ دلٍّ وعفةٍ","جمالَ شبابٍ في جلالِ مشيب",13,"ب",1,0],["وأعْبَدُ أن يَمْتَازَ دُونِيَ عَبْدَةٌ","بِعَلْيَاءَ في تأْبِينِ قَيْسِ بْنِ عَاصِمِ",14,"م",1,0],["واعبدوا مثلنا الحجارة فالنف","ع لديها وخير ما تأملونه",15,"ن",2,0],["واعبثي كالحياة","واثيري الشجون",16,"ن",1,0],["واعبد الله كأنك له تراه","فهو معك في حياتك والوفاه",17,"ه",1,0],["واعبد الله ولازم أمره","وتجنب كل ما عنه زجر",18,"ر",1,0],["وَاِعبُد إِلهاً ذا مَنن","وَلا توالِ ذا الأحَن",19,"ن",1,0],["واعبر سباسبها وجب فلواتها","فزمام مهرك في يمين دليله",20,"ل",2,0],["واعْبُدِ الله ما قَدِرْتَ بِصدقٍ","إنَّ هذا طريقُ أهلِ الصَّلاحِ",21,"ح",1,0],["وأعبرُ أسواق الحظوظِ وأحذرُ","من البوحِ بالّذي أريدُ فينقِمُ",22,"م",1,0],["وأعبرُ من فوق السّطورِ فأُرطمُ","بأرضٍ بها الخوفُ يروس ويحكمُ",22,"م",1,0],["واعبد الله بكشف واصطبر","وعلى الكشف توقَّى جزعك",23,"ك",1,0],["واعبر به في الهاء منحرفا إلى","سرِّ الأسامي واعتبره حدودا",24,"د",2,0],["واعبد به مؤمناً بملته","ومخلصاً دينه عن الريب",25,"ب",1,0],["وأعباءُ الضلالاتِ","عن الأفهامِ مَقْذُوفَه",26,"ف",2,0],["واعبر بدير حنينا وانتهز فرص ال","لذات ما بين قسيس ومطران",27,"ن",1,0],["وَاِعبُرُ بَرزَخَ هذي الحَياةْ","وَكُلُّ عَناءٍ لَهُ مُستَقَرْ",28,"ر",1,0],["وأعبد الله حسبةً واجتهاداً","فهو نعم المولى ونعم النصير",29,"ر",1,0],["وأعبر دونهم بالدها","حدودًا من الْجَاهِ لم تعبر",30,"ر",1,0],["وأعبر في أبياتها متأمّلا","فتأخذ عيني عبرة بعد عبرة",31,"ه",1,0],["واعبد إلاهك مخلصاً","وأحبه دون الأنام",32,"م",1,0],["واعبُدُوا اللضه مخلصينَ تَنَالُوا","أجرَ إيمانِكُم وَتَرضَى السماء",33,"ا",2,0],["وَأَعبطَ لِلكَوماءِ يَرغَو حُرارُها","وَأَندى أَكُفّاً بَينَ مُعطٍ وَمانِحِ",34,"ح",1,0],["وأعبق النشر ما باتت نوافجه","يسري شذاه على غيم وأنداء",35,"ا",2,0],["واعبد إله الشرع لا تعبد إله","العقل وانقادوا إليه وسلِّموا",36,"م",3,0],["واعبد إلهك حيث كنت على الرضا","تحظى بما قد ناله أهل المنن",37,"ن",1,0],["واعبُر على الجنوبِ من سيلان","كفاكَ ربِّي البُعدَ والطُّوفان",38,"ن",1,0],["وَاعبُرَ مِن ظَفَارِ في سُهَيلِ","تَرى سُقُطرَه وَهِيَ دَليلي",39,"ي",1,0],["وَآعبُر لَهَا بالحَزمِ وَالصَلاةِ","على النبيِّ وَآتَّخِذ وِصَاتي",39,"ي",1,0],["واعبق من نفح العبير خلائقاً","وارسى حلوما من أبان ومن قدس",40,"س",1,0],["واعبد إلهًا يصطفيك بعونه","ويذيق خصمك ذلة ونكالا",41,"ل",2,0],["واعبر على المقياس من","ماض الى ما ينتظر",42,"ر",1,0],["وَاِعبُدهُ وفق مُرادِهِ","وَاِلزَم لَهُ حُسنَ الأَدَبْ",43,"ب",1,0],["واعبث في البيت مستبسلا","فأي اناء اصبت انكسر",44,"ر",1,0],["وأعباء سقمي إي وشَوقي ثقيلةٌ","وأبحُر همي ليس ينجو غريقها",45,"ق",3,0],["واعبد إلهك موقنا","رباً له النعماءُ",46,"ا",2,0],["وأعبر خوفًا بروحي توارى","لحب سباني وأقطع عهدا",47,"د",2,0],["واعبد إلهي كل ما اصْبحت وامْسيت","حتى أفوز بمغفرة رب الارباب",48,"ب",1,0],["وأعبُرُ شارِعًا قَلِقًا بِقَلبي","عَلَى عَينَيكَ أصبَحَ لا يُطِلُّ",49,"ل",1,0],["واعبدْ إلهك واستجرْ بحماه يا","حسّانُ إنّ الله كانَ بصيرا",50,"ر",2,0],["واعْبر ْ عواقب َ ما يجيء ُ مُهَمّشا ً","قَدَرَيْكُما .. إن َّ الأمور َ ختامُها",51,"م",3,0],["وَاعبُدهُ صِدقًا وَلَا تُشْرِك بِهِ أحَدًا","فَهْوَ الغَنِيُّ عَنِ المَوشُوحِ بالدَّخَلِ",52,"ل",1,0],["واعبدْ إلهً واحداً صمداً","مما أتى بالقلبِ والعقْلِ",53,"ل",1,0],["واعبد الله في المعامل دوْما","وخذ العلمَ من رجال ثقات",54,"ت",1,0],["واعبر إليه ولاتخف غليانه","إنّ الضلوع على الضلوع ستسكرُ",55,"ر",1,0],["واعبر الجسر فوق وادٍ خصيبٍ","من جنان خضر وماءٍ رواها",56,"ا",3,0],["واعبر إلى ( الحَمْدِي ) على أشْجَارهِ","واسألهُ وامْسَحْ دمَّهُ بخدودي",57,"د",2,0],["واعبرْ بيَ الشَّاهقاتِ المُلهِماتِ رؤىً","جُوريَّةَ اللحنِ يغري لحنُها الطرَبا",58,"ب",2,0],["وأعبرُ الدهر َ محمولاً على جَلَدٍ","فالصبرُ أول ما يلقون من شِيمي",59,"م",2,0],["وأعُبُّ من أضوائه لا أرتوي","حتى تعانقَني الغداةَ قُبورُ",60,"ر",1,0],["وأعبر رؤيتي وفقا لحبي","أرى الأطلال أحسبها ظلالا",61,"ل",2,0],["وأعْبُر ردّتِي منْ دون قيْد ٍ","لأنْسجَ ما تفرَّدَ أو تعالى",62,"ل",2,0],["وأعب رواء وقراحا","أتشهى صفو الكاسات",63,"ت",1,0],["وأعبث مثل طفل ظل","يرجو رشفة الساقي",64,"ق",2,0]]}