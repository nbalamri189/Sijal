{"poems":[[60,"ألا احذروا في حربكم أبا الحسن","https://www.aldiwan.net/poem30817.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[141,"أراني قد تصابيت وقد","https://www.aldiwan.net/poem68031.html","الهزج"],[369,"بحياة أير أبي الرجا","https://www.aldiwan.net/poem60969.html","مجزوء الكامل"],[382,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[556,"لما اعتنقنا ليلة الرمل","https://www.aldiwan.net/poem47256.html","أحذ الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126842","الوافر"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96300","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96615","الوافر"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18212","الوافر"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122084","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21688","الوافر"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89686","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106901","الطويل"],[3575,"","https://poetry.dctabudhabi.ae/diwan/poem/95811","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114054","الوافر"],[4180,"","https://poetry.dctabudhabi.ae/diwan/poem/144608","الكامل"],[4282,"","https://poetry.dctabudhabi.ae/diwan/poem/144820","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58017","الطويل"],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[460,"علقتكِ ناشئاً حتّى","https://www.poetsgate.com/ViewPoem.aspx?id=22214",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5939,"أحلى مُنجزاتِك","https://www.poetsgate.com/ViewPoem.aspx?id=185498",""],[6068,"سؤال وجواب (التأخر)-08-","https://www.poetsgate.com/ViewPoem.aspx?id=177482",""]],"verses":[["أَلا اِحذَروا في حَربِكُم أَبا الحَسَن","فَلا تَروموهُ فَذا مِنَ الغبَن",0,"ن",1,1],["ألا احْكُمْنَ بيني وبينَ التي","تثورُ بعاشِقها المستهامْ",1,"م",1,0],["أَلا أَحبِب بِزَورٍ زا","رَ مِن سَلمى بِبَيروتِ",2,"ت",1,0],["إلا احتشَمْتَ ولا تكو","نُ إلى هجائك مُحوِجا",3,"ج",2,0],["ألا إحذر ملاقاةَ الرزايا","فإن ورودَها إحدى البلايا",4,"ا",3,1],["إلا احتبَى مُهدياً سلامي","لبانةٍ فيه أو غزالِ",5,"ل",1,0],["ألّا اِحتَملتَ فراقَ نصلك ذا","في هذهِ الظّلماء مِن أجلي",6,"ل",2,0],["ألا اِحتَفلوا بهذا اليوم حقّاً","ترونَ العزّ فيه على الدوامِ",7,"م",1,0],["ألا أحُفَّ على الدُخانِ ولا أرى","سُبُلَ السماحة يا حَبابَ وُعُورا",8,"ر",2,0],["أَلا اِحببها وَباشرها هبوبا","سَرت وَالنجم قد عزمَ المغيبا",9,"ب",2,1],["أَلا أَحمي وَأَذكُرُ إِرثَ قَومٍ","هُمُ حَلّوا المُرَكَّنَةَ اليَبابا",10,"ب",2,1],["أَلاَ احْتَسِبُوا مَا قَدْ أَعَرْتُمْ لِفِتْيَةٍ","تَكَرُّمُكُمْ بِالصَّفْحِ عَنْ فِعْلِهِمْ قَاضِي",11,"ي",1,1],["أَلا أُحبِب بِأِرضٍ كُن","تِ تَحتَلّينَها أَرضا",12,"ض",2,0],["أَلا أحد يَأوى لِأَهل محلة","مُقيمينَ في الدُنيا وَقَد فارَقوا الدُنيا",13,"ا",1,0],["ألا أحسني بل لا تسيئي وإنما","أنلتِ وإن قَّلت لك الحسنات",14,"ت",1,0],["إلّا أحاديثَ لَفَّقوها","يُصغي لها الجاهلُ البَليد",15,"د",1,0],["ألا أحسِن قَضَا دَينٍ وَحُكمٍ","خِيارُ النَّاسِ أحسنُهُم قَضَاءَ",16,"ض",3,0],["ألا احتموا عنه بعضب باتر","أو صانعوه بالذي قد جمعوا؟",17,"ع",3,0],["ألا أحدٌ يدعو لأهل محلةٍ","مقيمين في الدنيا وقد فقدوا الدنيا",18,"ي",2,1],["ألا احتج إلى مَنْ شئت تغدو أسيره","وإن كان حَجَّاماً عنيفاً مُخَاتِرا",19,"ر",2,0],["ألا احذروا مناطق الأمطار","وما بها من جملة الأخطار",20,"ر",1,1],["ألا أحبب بأرضٍ","تِ تَحْتَلِّينَها أَرضا",21,"ض",2,0],["أَلا احْبُبْها وَباشِرْها هَبُوبا","سَرَتْ وَالنَّجْمُ قَدْ طَلَبَ المَغِيبا",22,"ب",2,1],["ألا أَحويكِ في قلبي سنينا","كَسِرٍّ غامرٍ بالسِّحرِ فاتِكْ؟",23,"ك",1,0],["إلا اﻷحبة إنهم","بالله في حب لمس",24,"س",1,0]]}