90.html","الوافر"],[262,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[269,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[282,"تذاكرن ذكرى أو تهيج اللواعجا","https://www.aldiwan.net/poem1361.html",""],[293,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[299,"ومعهد بأس زرت والليل دامس","https://www.aldiwan.net/poem36255.html","عموديه"],[329,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[339,"إذا أعطى القليل فتى شريف","https://www.aldiwan.net/poem68682.html","الوافر"],[339,"إذا اعتصم الوالي بإغلاق بابه","https://www.aldiwan.net/poem68808.html","الطويل"],[339,"إذا أعطاك قتر حين يعطي","https://www.aldiwan.net/poem68832.html","الوافر"],[358,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[365,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[365,"أيا أهدى من الشهب السواري","https://www.aldiwan.net/poem60892.html","السريع"],[372,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[403,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[404,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[404,"فؤادي إلى لقياكم الدهر مشتاق","https://www.aldiwan.net/poem33630.html","الطويل"],[406,"إذا اعتز بالمال الرجال فإننا","https://www.aldiwan.net/poem50009.html","الطويل"],[430,"إلى الروم أصبو كلما أومض الخال","https://www.aldiwan.net/poem40048.html","الطويل"],[433,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[442,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[453,"ودوح يريك الطل في جيد غصنه","https://www.aldiwan.net/poem13910.html","الطويل"],[454,"إلى إيطاليا خفوا وطيروا","https://www.aldiwan.net/poem61576.html","الوافر"],[459,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[459,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[459,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[459,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[459,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[462,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[462,"أصوب غمام أم نوال معذل","https://www.aldiwan.net/poem15452.html","الطويل"],[462,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[462,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[462,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[465,"كأن المغاني حين أعجمها الشحط","https://www.aldiwan.net/poem3607.html","عموديه"],[469,"إذا اعتمد المرء لقيا الهوى","https://www.aldiwan.net/poem59537.html","المتقارب"],[469,"إذا أعوز العز طلابه","https://www.aldiwan.net/poem59678.html","المتقارب"],[499,"مشت كالغصن يثنيه النسيم","https://www.aldiwan.net/poem3706.html","الوافر"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[517,"اذا اعتاص المديح عليك فامدح","https://www.aldiwan.net/poem48618.html","الوافر"],[530,"إذا أعوز المرء الصعود إلى التي","https://www.aldiwan.net/poem37461.html","الطويل"],[554,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[563,"اذا أعيت مكأفأة الجميل","https://www.aldiwan.net/poem52747.html","الوافر"],[563,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[563,"رأى قصب السباق بنو الزمان","https://www.aldiwan.net/poem52896.html","الوافر"],[563,"عفت دار كقلبك بعد سلمى","https://www.aldiwan.net/poem52972.html","الطويل"]],"verses":[["إِذا اِعتَرَضَ المَأمولُ مِن دونِهِ الرَدى","شَقَقتُ إِلَيهِ الدارِعينَ بِمُهجَتي",0,"ت",2,0],["إِذا أَعشَبَ الشُقُّ اليَماني فَأَبشِروا","بِيَومٍ عُقامٍ يَنضَحُ الشَرَّ أَجرَبِ",1,"ب",1,0],["إِذا اِعتَقَلوا قَناً خُضِبَتْ نُحورٌ","أَوِ اِختَرَطوا سُيوفاً قُدَّ هامُ",2,"م",1,0],["إِذا اعوَجَّ مِنها ذابِلٌ في تَريبَةٍ","أَقاموا بِهِم مِن قِرنِهم ما تأَوَّدا",3,"د",2,0],["إذا اعْتَزَوْا عَدّوا أباً سَمَيْدَعاً","منْ عَبْدِ شَمْسٍ أُمَويَّ المُنْتَمى",4,"ا",1,0],["إذا اعْتَقَلَ القَيْسيُّ رُمْحاً تكسّرَتْ","أعالِيهِ في صَدْرِ الكَميِّ المُدجَّجِ",5,"ج",1,0],["إذا اعْتَنَقَ الأبْطالُ خلْتَ عُيونَهُمْ","تَبُثُّ شَرارَ النّارِ تحت المَغافِرِ",6,"ر",1,0],["إذا اعتَقَلوا سُمْرَ الرِّماحِ لِغارَةٍ","وجُرْدُ الجيادِ الضابِعاتِ بِهمْ نُكْبُ",7,"ب",1,0],["إِذَا اعْتَبَرَتْ نَفْسِي سِوَاكَ بِفِكْرَتِي","فَيَا خُسْرَ أَوْقَاتِي وَضيْعَةَ آنائي",8,"ي",1,0],["إِذا اِعتَفَرَت أَقدامُهُم عِندَ مَعرَكٍ","ثَبَتنَ بِهِ يَوماً فَإِن كانَ مَزلَقا",9,"ق",2,0],["إِذا اِعلَولى الصِياحُ فَلا تَلُمنا","فَإِنَّ الناسَ في جُهدٍ جَهيدِ",10,"د",1,0],["إِذا اِعتَرَفَ الجاني عَفا عَفوَ قادِرٍ","عَلا قَدرُهُ عَن أَن يَلِجَّ بِهِ حِقدُ",11,"د",1,0],["إِذَا أَعْضَلَ الأمْرُ الشَّدَيدُ بَدَا لَهُ","وَلَمْ يَجْهَدِ الحَل السَّدِيدُ المُلائِمُ",12,"م",1,0],["إِذا اِعتَفاها صَحصَحانٌ مَهيَعُ","مُبَنَّقُ بِآلِهِ مُقَنَّعُ",13,"ع",1,1],["إِذا اِعتَرَضَت أَرضٌ هَواءٌ تَنَشَّطَت","بِأَبواعِها البُعدَ اليَمانِيَةُ البُزلُ",14,"ل",1,0],["إِذا اِعتَسَّ فيه الذِئبُ لَم يَلتَقِط بِهِ","مِنَ الكَسبِ إِلّا مِثلَ مُلقى المَشاجِرِ",15,"ر",1,0],["إِذا أَعرَضَت بِالرَملِ أَدمآءُ عَوهَجٌ","لَنا قُلتُ هَذي عَينُ مَيٍّ وَجيدُها",16,"د",3,0],["إذا اعتزم الأمور مضى وأمضى","وإن سلّ المهنّد قال ماز",17,"ز",1,0],["إِذا أَعرَضوا أَلفَينِ مِنها تَعَرَّضَت","لِأُمِّ حَكيمٍ حاجَةٌ في فُؤادِيا",18,"ي",2,1],["إِذا اِعتَرَكَ الأَورادُ يا تَيمُ لَم تَجِد","عِناجاً وَلا حَبلاً بِدَلوِكَ مُكرَبا",19,"ب",2,0],["إِذا اِعتَرَكَ الكَلّاءُ وَالماءُ لَم تُقَد","بِأَمراسِها حَتّى تَثوبَ القَنابِلُ",20,"ل",1,0],["إذا اعصوصبت في أنيق فكأنما","بزجرة أخرى من سواهن تضربُ",21,"ب",1,1],["إذَا اعصَوصَبَت في أينُقٍ فكأنَّما","بِزَجرَةِ أخرى في سِواهُنَّ تُضرَبُ",22,"ب",1,0],["إذا اعتبرت معاني من كلفت به","عجبت من حسن ما دقت وما وضحت",23,"ت",1,0],["إذا اعترى النومُ العيونَ النُعَّسا","أجْسمها جَوْفَ الدُجى أن تَهمِسا",24,"س",2,0],["إذا أُعجلتْ لم يسترث طيرانُها","وإن أُمهِلتْ زَفَّتْ زفيف النعائمِ",25,"م",1,0],["إذا أُعطيتْ غُلْبُ الأسودِ سلاحَها","وقل قُوىً إنْ رام ضيْمَك رائم",26,"م",1,0],["إِذا أَعرَضَت بَيضاءُ قالَ لَها اِسفِري","وَكانَت حَصاناً لا يُنالُ سُفورُها",27,"ه",2,0],["إِذا أَعرَضَ الكانِسُ المُظهِرُ","إِذا قالَ في فَنَنٍ واحِدٍ",28,"د",1,0],["إِذا اِعتَبَرتُ مِنَ الأَخلاقِ أَنفسَها","كُنتَ المُنافِسُ فيهِ الساميَ القَدرِ",29,"ر",1,0],["إِذا اِعتَرَضوا لِلبُخلِ أَعرَضتُ عَنهُم","وَإِن مَنَّ أَقوامٌ كَتَمتُ الَّذي أُسدي",30,"د",2,0],["إِذا اِعتَلَّ سَيفُ الدَولَةِ اِعتَلَّتِ الأَرضُ","وَمَن فَوقَها وَالبَأسُ وَالكَرَمُ المَحضُ",31,"ض",1,1],["إِذا اِعوَجَّ القَنا في حامِليهِ","وَجازَ إِلى ضُلوعِهِمِ الضُلوعا",32,"ع",2,0],["إِذا اِعتادَ الفَتى خَوضَ المَنايا","فَأَهوَنُ ما يَمُرُّ بِهِ الوُحولُ",33,"ل",1,0],["إِذا اِعتَلَت دَرَجاتُ الشَمسِ مُصعِدَةً","في الحوتِ أَغنَت غِنىً عَن خَزِّ يَعقوبِ",34,"ب",1,1],["إِذا اِعتَلَلتَ ذَمَمنا العَيشَ وَهوَ نَدٍ","طَلقُ الجَوانِبِ صافٍ ظِلُّهُ رَغَدُ",35,"د",1,0],["إِذا أَعجَبَتكَ اليَومَ مِنهُ خَليقَةٌ","مُهَذَّبَةٌ أَعطاكَ أَمثالَها غَدا",36,"د",2,0],["إِذا اِعتَرَضَ الخابورُ دونَ جِيادِنا","رِعالاً فَخَدُّ اِبنِ اللَئيمَةِ أَضرَعُ",37,"ع",1,0],["إِذا اِعتَرَكَت في راحَتَي كُلِّ مُجمِدٍ","مُسَوَّمَةً لا رِزقَ إِلّا خِصالُها",38,"ل",3,1],["إذا اعتَصَمْتُ به في يَومِ مَلحمَةٍ","حسبتُني بِسَليلِ الأَزْدِ مُعْتَصِما",39,"م",2,0],["إِذا اعتَصَمَ المَخلوقُ مِن فِتَنِ الهَوى","بِخالِقِهِ نَجّاهُ مِنهُنَّ خالِقُه",40,"ق",2,0],["إِذا اعتَرى الحَينُ أَهلَ مُلكٍ","خَلَت لَهُ مِنهُمُ الحُصونُ",41,"ن",1,0],["إِذا أَعلَمَتهُ كَفُّهُ خِلتَ أَنَّهُ","يَسُنُّ سِناناً أَو يَسُلُّ مَواضِيا",42,"ي",2,0],["إذا أعرضتْ في الدّل ذلّ أخو الهوى","وصاغَ لها لفظَ الخضوع المُلطّفا",43,"ف",2,0],["إذا أَعملَ الآراءَ عَنَّ لهُ الهدى","سَدادٌ هوَ الفَتحُ الَّذي ما لَهُ سَدُّ",44,"د",1,0],["إِذا اِعتَرَت خَشيَةٌ شَكا فَبَكى","أَو اِنتَحَت راحَةٌ دَنا فَجَنى",45,"ن",2,0],["إِذا اِعتَصَموا فَنَحنُ لَهُم حُصونٌ","وَإِن زَحَفوا فَنَحنُ لَهُم جُنودُ",46,"د",1,0],["إِذا اِعوَجَّت قَناةُ المَجدِ يَوماً","أَقاموها لِتَبلُغَ مُنتَهاها",47,"ا",3,0],["إِذا اِعوَجَّت قَناةُ الأَمرِ يَوماً","أَقاموها لِتَبلُغَ مُنتَهاها",48,"ا",3,0],["إِذا اِعتَذَرَ الجاني إِليَّ عَذَرتُهُ","وَلا سِيَّما إِن لَم يَكُن قَد تَعَمَّدا",49,"د",2,1],["إِذا اِعتَلَتِ الأَفعالُ جاءَت عَليلَةً","كَحالاتِها أَسماؤُها وَالمَصادِرُ",50,"ر",1,0],["إِذا أَعمَلَ الفِكرَ الفَتى جَعَلَ الغِنى","مِنَ المالِ فَقراً وَالسُرورُ بِهِ حُزنا",51,"ن",2,1],["إذا أعرَضَتْ نارُ الحُباحِبِ في الدّجَى","سعَى قابِساً من نارِها بضِرامهِ",52,"م",2,0],["إذا اعترضَ الجبَّارُ ضوءَكِ شامخاً","تلقَّيتهِ كبْراً ببَسْمَةِ ساخرِ",53,"ر",1,0],["إِذَا اعْتَوَرَتْهَا ذُكْرَةُ النَّفْسِ أَبْصَرَتْ","لَهَا صُورَةٌ تَخْتَالُ فِي صَفْحَةِ الْفِكْرِ",54,"ر",1,0],["إذا أعطيت وعد الحرّ","كان الوعد مأمونا",55,"ن",2,0],["إذا اِعتَبَرَ المُستَبصِرونَ كَفاهُمُ","حَديثُ الصّبا وَالشَيبِ وَالحَدَثانِ",56,"ن",1,0],["إِذَا اِعتَللنا تعلَّلنا بذِكرِكمُ","لو أحسنَت بُرءَ عِلّاتٍ تَعِلّاتُ",57,"ت",1,0],["إذا أعطت فقد أعطت قليلاً","ولا يبقَى القليلُ ولا الأقلّ",58,"ل",1,0],["إذا اعتَلَلْتَ ذَمَمْنا العيشَ وَهوَ نَدٍ،","طَلْقُ الجَوانِبِ، ضَافٍ، ظِلُّهُ رَغَدُ",59,"د",1,0],["إذا اعتدى في لومك اللُّوَّامُ","وحاولوا الذامَ فأعيا الذامُ",60,"م",1,0],["إذا أعوج صدر الرمح طعنا فانما","يثقفه بين الطلا والجماجم",61,"م",1,0],["إذا أعطى يلوذ مهابة","من الأخد إعظاماً لا عطاء ما استزرا",62,"ر",2,0],["إِذا أَعداؤُهُ ذكرَتهُ باتَت","كَأَنَّ عَلى مَضاجِعِها القَتادا",63,"د",2,0],["إذا اعتنق الوقار المرء أضحى","أسيرا أو على خلق الأسير",64,"ر",1,1],["إذا اعتلَ فيها نسيمُ الصباح","ناحتْ بألسنِ أطيارها",65,"ر",3,0],["إذا اعتكرت دياجى الظلم حيناً","نظرتُ ظلامها ثم ابتسمتُ",66,"ت",1,1],["إذا اعتز باللَه القدير مجاهدٌ","أذل ألوف الظالمين من الجند",67,"د",1,0],["إذا اعتقلَ السُّمْرَ الطوالَ لغارَةٍ","غَدَتْ بهمُ الأعْدَاءُ فَهْيَ بَهَائِمُ",68,"م",1,0],["إذا اعتراه مُعْتَفٍ أو مُجْتَدِي","يا عِصْمة الخائِف والمسترشِدِ",69,"د",1,0],["إذا اعتلى العنبر غَنَّتْ له","رائحة الكافور والنَّدّ",70,"د",1,0],["إذا أعينُ النوارِ أيقَضَها الحَيا","تضاحكَتِ الأكْواسُ فعلَ عشِيقِ",71,"ق",1,0],["إِذا أَعيا عَلى الكُرَماءِ مَدحي","فَكَيفَ يَسومُهُ مِنّي البَخيلُ",72,"ل",1,0],["إذا اعتدلت عيدان اسحل والقنا","وقيست شياة الأعوجية بالبغل",73,"ل",1,0],["إِذا اِعتَقَلَت كَفّاكَ فيهِم بِذِمَّةٍ","فَخصمُكَ فَلَّ ناكِص عَنكَ ناكِسُ",74,"س",1,0],["إذا اعتنقوا تلك المعالم خلتَهم","أساورَ في إيمانها ودَمَالجا",75,"ج",2,0],["إِذا اِعتَلَّتِ الأَفواهُ وَاِستَمكَنَ الكَرى","وَقَد حانَ مِن نَجمِ الثُرَيّا خُفوقُها",76,"ق",3,0],["إذا أعمل الإِنسان بالعيش رأْيَه","رأَى غيرَ مأَفونٍ حقائقَه وَهما",77,"م",2,0],["إذا أعطت بعينيها","فبالعينين تستلب",78,"ب",1,0],["إِذا أَعطى القَليلَ فَتىً شَريف","فَإِنَّ قَليلَ ما يُعطيهِ زَينُ",79,"ن",1,1],["إِذا اِعتَصَمَ الوالي بِإِغلاقِ بابِهِ","وَرَدَّ ذَوي الحاجاتِ دونَ حجابِهِ",80,"ب",2,1],["إِذا أَعطاكَ قَتَّرَ حينَ يُعطي","وَإِن لَم يُعطِ قالَ أَبى القَضاءُ",81,"ا",2,1],["إذَا اعتَكَرَ الظلامُ عَلَيهِ أَورَى","زِنَادَ البَرقِ في غَسَقِ الظّلامِ",82,"م",1,0],["إذا أَعَلَّنيَ الأشواقُ عَلّلَني","منه خيالٌ يُسرّي الهَمَّ ساريه",83,"ي",2,0],["إذا اعتكَرتْ على الأُمَمِ اللّيالي","أوِ افتخَرتْ ذَوو الهِمَمِ الكِبار",84,"ر",1,0],["إِذا اعتَقَلتَ قَناةً كانَ لَهذَمُها","عمَّن رَكبتَ إِليهِ غيرَ مُعتقلِ",85,"ل",1,0],["إذا أَعْمَلَتْ سُودَ الّلحاظِ حَسْبتَها","لدى الفتك أيقاظاً وهنّ رقودُ",86,"د",1,0],["إذا اعتل دين المرء داوته توبة","فما غيرها للدين أشفى المراهم",87,"م",1,0],["إذا اعتقل قلب الصب بالبعد والنَّوَى","فإن وريقاتِ الأحبة دِرْياق",88,"ق",1,0],["إذا اعتَّز بالمال الرِّجالُ فإنَّنا","نرى عِزَّنا في أنْ نجودَ وأنْ نَسخو",89,"و",1,1],["إذا اعتركت أراوهم عرضت لهم","كتائب رأي من نهاه لها خالُ",90,"ل",1,0],["إذا اعتقَلوها للأناملِ سدّدَتْ","الى الخَطْبِ حتفاً لا يخِلُّ بمقْتَلِ",91,"ل",1,0],["إِذا اعتضت خلا من خليل رؤيته","فلم يبق لي إلا به وخلات",92,"ت",1,0],["إِذا اعتنقَتْ شجراؤهُ جَمعتْ بها","نواويرها الأفواه شوقاً إِلى اللَثْمِ",93,"م",1,0],["إذا اعترف الأباعد والأعادي","بقيمتنا فقد هوت النسور",94,"ر",1,0],["إذا اعتبر المجرِّبُ في سِنِيه","تقلُّبَها تيقَّنَ مُنتهاها",95,"ا",3,0],["إذا اعتزى باللسان منتسبٌ","سفرنَ ثم انتسبن لي فسما",96,"م",2,0],["إذا اعتقل القناةَ ندىً وبأساً","تلاقى الماءُ فيها والنجيعُ",97,"ع",1,0],["إذا اعترضتْه من سلوٍّ معوضةً","مَحاسنُ في أخرى رآها مَقابحا",98,"ح",2,0],["إذا اعترضَتْهُ هِزة الجود ساكناً","نزت بالندَى في كفّه نَزَواتُها",99,"ت",3,0],["إذا أعيتْ على الشعراء قِيدتْ","إليَّ وظهرُ ريِّضها رَكوبُ",100,"ب",1,0],["إذا اعتس سرَّاب الهوامِ لقوته","تودع خمْصاناً وأَصبحَ طاويا",101,"ي",2,0],["إِذا أعرضت عن جمَّةِ الماء قادَها","فأوردها ماءً من الهامِ قانيا",102,"ي",2,0],["إِذا أعرضت عن جمَّةٍ ذات عرمضٍ","سَقاها من الأعْداء رِيّاً كِلامُها",103,"م",3,0],["إذا أعرضت عن جمَّةٍ ذات عِرْمض","تيمَّمْنَ ورْداً من دم الهام مُفْعما",104,"م",2,0],["إذا أعرضت عن جمَّة الماء بالضحى","كرعْنَ بجيَّاشِ الينابيع أشْكَلِ",105,"ل",1,0],["إذا أعجَزَ البيض الصوارم مطلبٌ","حَوَتْهُ لهُ آراؤهُ والمَزابِرُ",106,"ر",1,0],["إذا أعملت فهي السهام وإنها","قسيٌّ إذا ما حلّ انساعها الحطّ",107,"ط",1,0],["إِذا اِعتَمَدَ المَرءُ لُقيا الهَوى","وَبادَرَ بِالسَعيِ مِنهُ إِلَيهِ",108,"ه",1,1],["إِذا أَعوَزَ العِزُّ طُلّابَهُ","وَلَم يَبلُغوا مِنهُ آمالَهُم",109,"م",1,1],["إذا أعرضتِ تَسودُّ الأماني","وإن أقبلتِ تبيَضُّ الهمومُ",110,"م",1,0],["إذا أعدَّ قِسيُّ الجودِ يومَ ندىً","رمى بسهمِ العطايا مهجةَ البُخُلِ",111,"ل",1,0],["إذا اعتلقتها خمسة في ملمة","تحلل مكروه وحل عقال",112,"ل",1,0],["إذا اعتقلوا سمر الوشيج حسبتهم","أراقم ينهشن العدى بأراقم",113,"م",1,0],["اِذا اِعتاصَ المَديح عَليكَ فَاِمدَح","اِميرَ المُؤمِنينَ تَجِد مَقالا",114,"ل",2,1],["إذا أَعْوزَ الْمَرْءَ الصُّعودُ إلى الّتي","إلَيْها تَنَاهَى كُلُّ أَرْوعَ أَصْيَدِ",115,"د",1,1],["إِذا اِعتَنَقَت فيهِ الجَنوبُ تَكَفَّأَت","جَواريهِ أَو قامَت مَعَ الريحِ لا تَجري",116,"ر",2,0],["اذا أعيت مكأفأةُ الجميلِ","فلا تَغفُلْ عن الشُّكر الجزيلِ",117,"ل",1,1],["إذا أعطى الفتَى مَولاهُ عَوْناً","تُقصِّرُ عن مَضَرَّتهِ العبيدُ",118,"د",1,0],["إذا أُعطي النُموَّ فعن قليلٍ","نَراهُ دَوحةً تُعطِي المَجاني",119,"ن",2,0],["إذا أعطت لواحظُها أَماناً","فتأخيرٌ إلى أَجَلٍ مُسَمَّى",120,"م",2,0]]}