16,"","https://poetry.dctabudhabi.ae/diwan/poem/132665","الطويل"],[3311,"","https://poetry.dctabudhabi.ae/diwan/poem/203132","الوافر"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82835","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112377","الهزج"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62871","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62786","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48308","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48297","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45760","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66369","الوافر"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77733","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216634","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132125","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117858","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95322","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103036","الطويل"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138045","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40134","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70162","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77060","الوافر"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44664","المجتث"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86376","الوافر"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21523","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45083","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18994","الطويل"],[4273,"","https://poetry.dctabudhabi.ae/diwan/poem/45446","الوافر"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143025","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143021","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136506",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28734","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133089","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33470","المتقارب"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96070","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120509","المتقارب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52155","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204316","الطويل"],[5140,"إذا اعتذر الصديق إليك يوماً","https://www.poetsgate.com/ViewPoem.aspx?id=181083",""],[5145,"ألا بكر السحاب ضحى الخميس","https://www.poetsgate.com/ViewPoem.aspx?id=108074",""],[5145,"خليليّ إن لم تسعدا فدعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108058",""],[5299,"محاكمة","https://www.poetsgate.com/ViewPoem.aspx?id=210543",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5484,"تباريح الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=206307",""],[5655,"تضايقتِ الأُمورُ فَدَتكَ نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=107218",""],[5937,"غيمتان","https://www.poetsgate.com/ViewPoem.aspx?id=211886",""],[6024,"الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=186346",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[520,"فما استنشقت ريح الصباح خياشم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577633",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""],[463,"بدينكَ بعدما انفرقَ الجميعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60138&r=&rc=194",""],[6268,"زفرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82925&r=&rc=11",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""],[4222,"جفون البيض أم بيض الجفون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52908&r=&rc=200",""]],"verses":[["إِذا اِعتَرَضَ المَأمولُ مِن دونِهِ الرَدى","شَقَقتُ إِلَيهِ الدارِعينَ بِمُهجَتي",0,"ت",2,0],["إِذا أَعشَبَ الشُقُّ اليَماني فَأَبشِروا","بِيَومٍ عُقامٍ يَنضَحُ الشَرَّ أَجرَبِ",1,"ب",1,0],["إِذا اِعتَقَلوا قَناً خُضِبَتْ نُحورٌ","أَوِ اِختَرَطوا سُيوفاً قُدَّ هامُ",2,"م",1,0],["إِذا اعوَجَّ مِنها ذابِلٌ في تَريبَةٍ","أَقاموا بِهِم مِن قِرنِهم ما تأَوَّدا",3,"د",2,0],["إذا اعْتَزَوْا عَدّوا أباً سَمَيْدَعاً","منْ عَبْدِ شَمْسٍ أُمَويَّ المُنْتَمى",4,"ا",1,0],["إذا اعْتَقَلَ القَيْسيُّ رُمْحاً تكسّرَتْ","أعالِيهِ في صَدْرِ الكَميِّ المُدجَّجِ",5,"ج",1,0],["إذا اعْتَنَقَ الأبْطالُ خلْتَ عُيونَهُمْ","تَبُثُّ شَرارَ النّارِ تحت المَغافِرِ",6,"ر",1,0],["إذا اعتَقَلوا سُمْرَ الرِّماحِ لِغارَةٍ","وجُرْدُ الجيادِ الضابِعاتِ بِهمْ نُكْبُ",7,"ب",1,0],["إِذَا اعْتَبَرَتْ نَفْسِي سِوَاكَ بِفِكْرَتِي","فَيَا خُسْرَ أَوْقَاتِي وَضيْعَةَ آنائي",8,"ي",1,0],["إِذا اِعتَفَرَت أَقدامُهُم عِندَ مَعرَكٍ","ثَبَتنَ بِهِ يَوماً فَإِن كانَ مَزلَقا",9,"ق",2,0],["إِذا اِعلَولى الصِياحُ فَلا تَلُمنا","فَإِنَّ الناسَ في جُهدٍ جَهيدِ",10,"د",1,0],["إِذا اِعتَرَفَ الجاني عَفا عَفوَ قادِرٍ","عَلا قَدرُهُ عَن أَن يَلِجَّ بِهِ حِقدُ",11,"د",1,0],["إِذَا أَعْضَلَ الأمْرُ الشَّدَيدُ بَدَا لَهُ","وَلَمْ يَجْهَدِ الحَل السَّدِيدُ المُلائِمُ",12,"م",1,0],["إِذا اِعتَفاها صَحصَحانٌ مَهيَعُ","مُبَنَّقُ بِآلِهِ مُقَنَّعُ",13,"ع",1,1],["إِذا اِعتَرَضَت أَرضٌ هَواءٌ تَنَشَّطَت","بِأَبواعِها البُعدَ اليَمانِيَةُ البُزلُ",14,"ل",1,0],["إِذا اِعتَسَّ فيه الذِئبُ لَم يَلتَقِط بِهِ","مِنَ الكَسبِ إِلّا مِثلَ مُلقى المَشاجِرِ",15,"ر",1,0],["إِذا أَعرَضَت بِالرَملِ أَدمآءُ عَوهَجٌ","لَنا قُلتُ هَذي عَينُ مَيٍّ وَجيدُها",16,"د",3,0],["إذا اعتزم الأمور مضى وأمضى","وإن سلّ المهنّد قال ماز",17,"ز",1,0],["إِذا أَعرَضوا أَلفَينِ مِنها تَعَرَّضَت","لِأُمِّ حَكيمٍ حاجَةٌ في فُؤادِيا",18,"ي",2,1],["إِذا اِعتَرَكَ الأَورادُ يا تَيمُ لَم تَجِد","عِناجاً وَلا حَبلاً بِدَلوِكَ مُكرَبا",19,"ب",2,0],["إِذا اِعتَرَكَ الكَلّاءُ وَالماءُ لَم تُقَد","بِأَمراسِها حَتّى تَثوبَ القَنابِلُ",20,"ل",1,0],["إذا اعصوصبت في أنيق فكأنما","بزجرة أخرى من سواهن تضربُ",21,"ب",1,1],["إذَا اعصَوصَبَت في أينُقٍ فكأنَّما","بِزَجرَةِ أخرى في سِواهُنَّ تُضرَبُ",22,"ب",1,0],["إذا اعتبرت معاني من كلفت به","عجبت من حسن ما دقت وما وضحت",23,"ت",1,0],["إذا اعترى النومُ العيونَ النُعَّسا","أجْسمها جَوْفَ الدُجى أن تَهمِسا",24,"س",2,0],["إذا أُعجلتْ لم يسترث طيرانُها","وإن أُمهِلتْ زَفَّتْ زفيف النعائمِ",25,"م",1,0],["إذا أُعطيتْ غُلْبُ الأسودِ سلاحَها","وقل قُوىً إنْ رام ضيْمَك رائم",26,"م",1,0],["إِذا أَعرَضَت بَيضاءُ قالَ لَها اِسفِري","وَكانَت حَصاناً لا يُنالُ سُفورُها",27,"ه",2,0],["إِذا أَعرَضَ الكانِسُ المُظهِرُ","إِذا قالَ في فَنَنٍ واحِدٍ",28,"د",1,0],["إِذا اِعتَبَرتُ مِنَ الأَخلاقِ أَنفسَها","كُنتَ المُنافِسُ فيهِ الساميَ القَدرِ",29,"ر",1,0],["إِذا اِعتَرَضوا لِلبُخلِ أَعرَضتُ عَنهُم","وَإِن مَنَّ أَقوامٌ كَتَمتُ الَّذي أُسدي",30,"د",2,0],["إِذا اِعتَلَّ سَيفُ الدَولَةِ اِعتَلَّتِ الأَرضُ","وَمَن فَوقَها وَالبَأسُ وَالكَرَمُ المَحضُ",31,"ض",1,1],["إِذا اِعوَجَّ القَنا في حامِليهِ","وَجازَ إِلى ضُلوعِهِمِ الضُلوعا",32,"ع",2,0],["إِذا اِعتادَ الفَتى خَوضَ المَنايا","فَأَهوَنُ ما يَمُرُّ بِهِ الوُحولُ",33,"ل",1,0],["إِذا اِعتَلَت دَرَجاتُ الشَمسِ مُصعِدَةً","في الحوتِ أَغنَت غِنىً عَن خَزِّ يَعقوبِ",34,"ب",1,1],["إِذا اِعتَلَلتَ ذَمَمنا العَيشَ وَهوَ نَدٍ","طَلقُ الجَوانِبِ صافٍ ظِلُّهُ رَغَدُ",35,"د",1,0],["إِذا أَعجَبَتكَ اليَومَ مِنهُ خَليقَةٌ","مُهَذَّبَةٌ أَعطاكَ أَمثالَها غَدا",36,"د",2,0],["إِذا اِعتَرَضَ الخابورُ دونَ جِيادِنا","رِعالاً فَخَدُّ اِبنِ اللَئيمَةِ أَضرَعُ",37,"ع",1,0],["إِذا اِعتَرَكَت في راحَتَي كُلِّ مُجمِدٍ","مُسَوَّمَةً لا رِزقَ إِلّا خِصالُها",38,"ل",3,1],["إذا اعتَصَمْتُ به في يَومِ مَلحمَةٍ","حسبتُني بِسَليلِ الأَزْدِ مُعْتَصِما",39,"م",2,0],["إِذا اعتَصَمَ المَخلوقُ مِن فِتَنِ الهَوى","بِخالِقِهِ نَجّاهُ مِنهُنَّ خالِقُه",40,"ق",2,0],["إِذا اعتَرى الحَينُ أَهلَ مُلكٍ","خَلَت لَهُ مِنهُمُ الحُصونُ",41,"ن",1,0],["إِذا أَعلَمَتهُ كَفُّهُ خِلتَ أَنَّهُ","يَسُنُّ سِناناً أَو يَسُلُّ مَواضِيا",42,"ي",2,0],["إذا أعرضتْ في الدّل ذلّ أخو الهوى","وصاغَ لها لفظَ الخضوع المُلطّفا",43,"ف",2,0],["إذا أَعملَ الآراءَ عَنَّ لهُ الهدى","سَدادٌ هوَ الفَتحُ الَّذي ما لَهُ سَدُّ",44,"د",1,0],["إِذا اِعتَرَت خَشيَةٌ شَكا فَبَكى","أَو اِنتَحَت راحَةٌ دَنا فَجَنى",45,"ن",2,0],["إِذا اِعتَصَموا فَنَحنُ لَهُم حُصونٌ","وَإِن زَحَفوا فَنَحنُ لَهُم جُنودُ",46,"د",1,0],["إِذا اِعوَجَّت قَناةُ المَجدِ يَوماً","أَقاموها لِتَبلُغَ مُنتَهاها",47,"ا",3,0],["إِذا اِعوَجَّت قَناةُ الأَمرِ يَوماً","أَقاموها لِتَبلُغَ مُنتَهاها",48,"ا",3,0],["إِذا اِعتَذَرَ الجاني إِليَّ عَذَرتُهُ","وَلا سِيَّما إِن لَم يَكُن قَد تَعَمَّدا",49,"د",2,1],["إِذا اِعتَلَتِ الأَفعالُ جاءَت عَليلَةً","كَحالاتِها أَسماؤُها وَالمَصادِرُ",50,"ر",1,0],["إِذا أَعمَلَ الفِكرَ الفَتى جَعَلَ الغِنى","مِنَ المالِ فَقراً وَالسُرورُ بِهِ حُزنا",51,"ن",2,1],["إذا أعرَضَتْ نارُ الحُباحِبِ في الدّجَى","سعَى قابِساً من نارِها بضِرامهِ",52,"م",2,0],["إذا اعترضَ الجبَّارُ ضوءَكِ شامخاً","تلقَّيتهِ كبْراً ببَسْمَةِ ساخرِ",53,"ر",1,0],["إِذَا اعْتَوَرَتْهَا ذُكْرَةُ النَّفْسِ أَبْصَرَتْ","لَهَا صُورَةٌ تَخْتَالُ فِي صَفْحَةِ الْفِكْرِ",54,"ر",1,0],["إذا أعطيت وعد الحرّ","كان الوعد مأمونا",55,"ن",2,0],["إذا اِعتَبَرَ المُستَبصِرونَ كَفاهُمُ","حَديثُ الصّبا وَالشَيبِ وَالحَدَثانِ",56,"ن",1,0],["إِذَا اِعتَللنا تعلَّلنا بذِكرِكمُ","لو أحسنَت بُرءَ عِلّاتٍ تَعِلّاتُ",57,"ت",1,0],["إذا أعطت فقد أعطت قليلاً","ولا يبقَى القليلُ ولا الأقلّ",58,"ل",1,0],["اذا اعتبرت صروف الدهر مرسلة","ايقنت ان القضايا كلها نقل",59,"ل",1,0],["إذا اعتَلَلْتَ ذَمَمْنا العيشَ وَهوَ نَدٍ،","طَلْقُ الجَوانِبِ، ضَافٍ، ظِلُّهُ رَغَدُ",60,"د",1,0],["إذا اعتدى في لومك اللُّوَّامُ","وحاولوا الذامَ فأعيا الذامُ",61,"م",1,0],["إذا أعوج صدر الرمح طعنا فانما","يثقفه بين الطلا والجماجم",62,"م",1,0],["إذا أعطى يلوذ مهابة","من الأخد إعظاماً لا عطاء ما استزرا",63,"ر",2,0],["إِذا أَعداؤُهُ ذكرَتهُ باتَت","كَأَنَّ عَلى مَضاجِعِها القَتادا",64,"د",2,0],["إذا اعتنق الوقار المرء أضحى","أسيرا أو على خلق الأسير",65,"ر",1,1],["إذا اعتلَ فيها نسيمُ الصباح","ناحتْ بألسنِ أطيارها",66,"ر",3,0],["إذا اعتكرت دياجى الظلم حيناً","نظرتُ ظلامها ثم ابتسمتُ",67,"ت",1,1],["إذا اعتز باللَه القدير مجاهدٌ","أذل ألوف الظالمين من الجند",68,"د",1,0],["إذا اعتقلَ السُّمْرَ الطوالَ لغارَةٍ","غَدَتْ بهمُ الأعْدَاءُ فَهْيَ بَهَائِمُ",69,"م",1,0],["إذا اعتراه مُعْتَفٍ أو مُجْتَدِي","يا عِصْمة الخائِف والمسترشِدِ",70,"د",1,0],["إذا اعتلى العنبر غَنَّتْ له","رائحة الكافور والنَّدّ",71,"د",1,0],["إذا أعينُ النوارِ أيقَضَها الحَيا","تضاحكَتِ الأكْواسُ فعلَ عشِيقِ",72,"ق",1,0],["إِذا أَعيا عَلى الكُرَماءِ مَدحي","فَكَيفَ يَسومُهُ مِنّي البَخيلُ",73,"ل",1,0],["إذا اعتدلت عيدان اسحل والقنا","وقيست شياة الأعوجية بالبغل",74,"ل",1,0],["إِذا اِعتَقَلَت كَفّاكَ فيهِم بِذِمَّةٍ","فَخصمُكَ فَلَّ ناكِص عَنكَ ناكِسُ",75,"س",1,0],["إذا اعتنقوا تلك المعالم خلتَهم","أساورَ في إيمانها ودَمَالجا",76,"ج",2,0],["إِذا اِعتَلَّتِ الأَفواهُ وَاِستَمكَنَ الكَرى","وَقَد حانَ مِن نَجمِ الثُرَيّا خُفوقُها",77,"ق",3,0],["إذا أعمل الإِنسان بالعيش رأْيَه","رأَى غيرَ مأَفونٍ حقائقَه وَهما",78,"م",2,0],["إذا أعطت بعينيها","فبالعينين تستلب",79,"ب",1,0],["إِذا أَعطى القَليلَ فَتىً شَريف","فَإِنَّ قَليلَ ما يُعطيهِ زَينُ",80,"ن",1,1],["إِذا اِعتَصَمَ الوالي بِإِغلاقِ بابِهِ","وَرَدَّ ذَوي الحاجاتِ دونَ حجابِهِ",81,"ب",2,1],["إِذا أَعطاكَ قَتَّرَ حينَ يُعطي","وَإِن لَم يُعطِ قالَ أَبى القَضاءُ",82,"ا",2,1],["إذَا اعتَكَرَ الظلامُ عَلَيهِ أَورَى","زِنَادَ البَرقِ في غَسَقِ الظّلامِ",83,"م",1,0],["إذا أَعَلَّنيَ الأشواقُ عَلّلَني","منه خيالٌ يُسرّي الهَمَّ ساريه",84,"ي",2,0],["إذا اعتكَرتْ على الأُمَمِ اللّيالي","أوِ افتخَرتْ ذَوو الهِمَمِ الكِبار",85,"ر",1,0],["إِذا اعتَقَلتَ قَناةً كانَ لَهذَمُها","عمَّن رَكبتَ إِليهِ غيرَ مُعتقلِ",86,"ل",1,0],["إذا أَعْمَلَتْ سُودَ الّلحاظِ حَسْبتَها","لدى الفتك أيقاظاً وهنّ رقودُ",87,"د",1,0],["إذا اعتل دين المرء داوته توبة","فما غيرها للدين أشفى المراهم",88,"م",1,0],["إذا اعتقل قلب الصب بالبعد والنَّوَى","فإن وريقاتِ الأحبة دِرْياق",89,"ق",1,0],["إذا اعتَّز بالمال الرِّجالُ فإنَّنا","نرى عِزَّنا في أنْ نجودَ وأنْ نَسخو",90,"و"