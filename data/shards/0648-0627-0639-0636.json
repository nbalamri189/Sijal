{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[29,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[52,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[266,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[303,"هل من يعين على التجلد ساعة","https://www.aldiwan.net/poem36292.html","عموديه"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[543,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[572,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132801","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79825","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141294","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71054","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2753,"","https://poetry.dctabudhabi.ae/diwan/poem/20054","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100407","الكامل"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121577","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123527","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123492","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123505","الطويل"],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["وَأَعَضُّ الكَفَّ إِن نا","لَ ثَناياكَ البَشامُ",0,"م",1,0],["وَأَعضَدنَ السُيوفَ مُجَرَّداتٍ","لِهامِ الأُزدِ قُبَّحَ ذاكَ هاما",1,"م",2,0],["واعضُدْ بذاك الرأى مَملكةً","تحتاجُ ظُلَّتُها إلى دِعَمِ",2,"م",1,0],["وَاِعضُد أَخاهُ بِهِ لا تَترُكَنَّهُما","كَساعِدٍ مُفرَدٍ لَيسَت لَهُ عَضُدُ",3,"د",1,0],["وأعضَّ قوم بالسكوت ، وأفصَحَتْ","عن غير ما عُرِفَت به أقوام",4,"م",1,0],["واعضل داء الدهر يأس ابن حرة","كريم عداك اللؤم يسأل اعبدا",5,"د",2,0],["وأعضل داء الحب حبك زاهداً","على منعه تعطيك مهجة راغب",6,"ب",1,0],["وأَعضَّ نابُ الجوعِ طاويَ مهجتي","وأَثابني داءً عليه عضالا",7,"ل",2,0],["وَاِعضده بالشهمِ الوزيرِ المصطفى","دِرعِ الصدورِ ودرّة التيجانِ",8,"ن",1,0],["وأعضلَ الخطبُ اشتَفوا بطِبّه","فأفرقتْ والداءُ قد تمكّنا",9,"ن",2,0],["وإعضالُها خيرٌ لها من رجالها","سواك وما كلُّ الرجالِ فحولُ",10,"ل",1,0],["وأعضلَ مِن مرضى القُلوبِ نِفاُُهم","فكانَ الجزاءُ الحَقُّ أن يَسكُنوا القَبرا",11,"ر",2,0],["وَأُعْضُدُهُ بَرَأْيٍ مِنْ سَدَادٍ","وَيَعْضُدُني بِرَأْي مِنْ سَدَادَهْ",12,"د",2,0],["واعضده وافتح له الفتح المبين وكن","عونا له حيث يخشى العبد بؤساه",13,"ا",2,0],["واعضده النصر يا نعم النصير وكن","عونا له إن دجى خطب أو اعتسفا",14,"ف",2,0],["واعضده بالنصر العزيز وكن له","عونا على غدر الزمان القاسي",15,"س",2,0],["واعضده بالنصر والفتح المبين","وكن عونا له في الملمات المهمات",16,"ت",1,0],["واعضده بالنصر والفتح المبين وجد","له بجدوى بها تولى الكرامات",17,"ت",1,0],["واعضده وافتح له الفتح المبين وصن","بسيفه الزرع والأوطان والنعما",18,"م",2,0],["وأعضُلُها حتى إذا جاء كُفؤُها","سمحتُ بها مستشرفات كواعبا",19,"ب",2,0],["وأعضاءُ مجدٍ ما توزّعت الضُّبا","بتوزيعها إلاَّ الندى والمعاليا",20,"ي",2,0],["واعضد صغار النّاس لا تطلب به","بدلاً تنل أجر الدّنى وثناها",21,"ا",3,0],["واعْضُدْهُ بالتوفيق في","ما رامَ من غَرَضٍ وأَمَّهْ",22,"م",2,0],["وَأَعِضني مِن تُراثي نُزُلاً","مِن هَواها صالِحاً لَم يُنزَلِ",23,"ل",1,0],["وَأُعضي إِذا ضَنَّ الجَوادُ بِمالِهِ","مِنَ البِكَراتِ المُنقِياتِ المَتالِيا",24,"ي",2,0],["واعضُّ فيك اناملا","صفرا تشير اليك غبنا",25,"ن",2,0],["واعضل كهمّام بنات فكرة","ضنا بها عن غير فحل معرق",26,"ق",1,0],["واعضض عليه وعش في رفعة وغنى","وانعم بعيش هني نلته بهن",27,"ن",1,0],["وأعضاء تسابق للخطايا","وفي هون الهوى ترضى هويا",28,"ي",2,0],["وأعضاء سوء للاثام مريدة","لداعى الخطا تبدى مديد خطاها",29,"ا",3,0],["وأعضاء سوء حملت فوق طوقها","حمولا وأثقالا لعظمى فوادخ",30,"خ",1,0],["وأعضاء سوء للأثام جرية","عن الخير في ضعف وللشر في بطش",31,"ش",1,0],["وأعضُدُه برأيٍ من سَدَادِي","ويعضُدُني برأيٍ من سَدَادِهْ",32,"د",2,0]]}