{"poems":[[95,"يا عبرة الدهر جاوزت المدى فينا","https://www.aldiwan.net/poem11172.html","البسيط"],[87,"محمد ما أخلفتنا ما وعدتنا","https://www.aldiwan.net/poem7775.html","الطويل"],[87,"كان على بعض الدروب جمل","https://www.aldiwan.net/poem8008.html","الرجز"],[47,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[46,"طوتني المنايا يوم ألهو بلذة","https://www.aldiwan.net/poem29695.html","الطويل"],[107,"هو النصر يا تيماء يتبعه النصر","https://www.aldiwan.net/poem44050.html","الطويل"],[22,"جزاك الله شرا من عجوز","https://www.aldiwan.net/poem21663.html","الوافر"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[102,"حوار جارين","https://www.poetsgate.com/ViewPoem.aspx?id=50201",""],[147,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[310,"يرى بالكس للناس اعتناء","https://www.aldiwan.net/poem56613.html","الوافر"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[445,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[466,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[505,"ألا يا ابن عم المصطفى لحظة لمن","https://www.aldiwan.net/poem37668.html","الطويل"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86609","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70734","المنسرح"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178090","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46673",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1873,"","https://poetry.dctabudhabi.ae/diwan/poem/73006","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104971","المتقارب"],[2426,"","https://poetry.dctabudhabi.ae/diwan/poem/138832",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133977","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62761","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34684","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54435","المتقارب"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138728",""],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[5431,"شعر معتّق...","https://www.poetsgate.com/ViewPoem.aspx?id=211179",""],[6093,"فكل ساع له في سعيه وطر","https://www.poetsgate.com/ViewPoem.aspx?id=207056",""]],"verses":[["فَأَنْتَ خَيْرُ مَرَبٍّ لِلأُولَى جَهِلُوا","كَجَهْلِنَا أَنَّ تَرْكَ الحَزْمِ يُشْقِينَا",0,"ن",2,0],["فأنت خضم العلم حال سكونه","وأنت خضم العلم حين تثور",1,"ر",1,0],["فَأَنتَ خَيرٌ مِن أَخيكَ حالا","لِأَنَّني أَتعَبُ مِنكَ بالا",2,"ل",2,0],["فَإِن تُخرِجِ الأَيامُ مَذخورَ حُسنِها","فَقَد آنَ أَن يُبدي النَضارَةَ عودُها",3,"د",3,0],["فَإِن تَختَلوا دوني بِأُنسٍ وَلَذَّةٍ","فَإِنّي بِطولِ البَثِّ وَالشَوقِ مُفرَدُ",4,"د",1,0],["فإن تَخفضي منكِ الجَناحَ لِتَنْعَمِي","بأفياءِ عيشٍ ساكنٍ فَلَكِ العُذْرُ",5,"ر",1,0],["فَإِن تُخلَي وَأَمرَكِ لا تَصولي","بِمُشتَدٍّ قُواهُ وَلا مَتينِ",6,"ن",1,0],["فإنْ تَخْلُقْ لهُ الأعداءُ عَيباً","فَقَوْلُ العَائِبِينَ هو المَعيبُ",7,"ب",1,0],["فانتخى جاره وقال : وما الأجداد ؟","سل عنهم البلى والدمارا",8,"ر",2,0],["فَإِن تَخِبِ الصَوارِمُ وَالعَوالي","فَلَم يَخِبِ الكِتابُ وَلا الرَسولُ",9,"ل",1,0],["فإن تخلد مآثرنا وتسلم","على التاريخ من شبه المعاب",10,"ب",1,0],["فَإِن تخصَب بِمرتعهِ جسومٌ","فَقَد هُزل التعرّف والذّكاء",11,"ا",2,0],["فإن تخرجوا والقلب حيث كنوزكم","تَروا ما يرى الملّاحُ في ملتقى البحر",12,"ر",1,0],["فإِنْ تَخَطَّتْهُ منكَ اليومَ بائِقَةٌ","ففي غدٍ بَعْدُ حالٌ بعدَها حالُ",13,"ل",1,0],["فإن تخْتلوا أعراضنا فوخيمةٌ","وإن كان مرآها من المجد أخضرا",14,"ر",2,0],["فأنت خيارٌ من خيار أماجدٍ","شآبيب زهرٍ أحسنوا بالمواهب",15,"ب",1,0],["فَإِنْ تَخفَ عنّا في الترابِ فإنّما","خفيتَ وَقَد أَطلعت غُرَّ المناقبِ",16,"ب",1,0],["فَأَنتَ خَير أَمير طابَ عنصره","وَحازَ ما رام مِن علم وَمِن أَدَب",17,"ب",1,0],["فأَنت خيرُ الملوك لوْ رغِموا","وإنْ هْمُ عنفُوا وإنْ غدروا",18,"ر",3,0],["فأنت خير من حَكم العباد","وأنت خير من حزم الأمورا",19,"ر",2,0],["فإن تخلّقَ منهم بالنُّهى رجلٌ","عادت به نفسُه لؤماً إلى الخلُقِ",20,"ق",1,0],["فأنت خير من أجاب الداعي","وأنت أولى من أثاب الساعي",21,"ي",1,0],["فَاِنتَخَبَ اللَهُ لَهُم إِماما","يُؤَيِّدُ اللَهُ بِهِ الإِسلاما",22,"م",2,0],["فَأَنتَ خَديمُ الشَّمسِ وَالبَدرِ عنوَةً","وَتَخدِمُهُ في أَمرِهِ الشَّمسُ وَالبَدرُ",23,"ر",1,0],["فأنت خير مهجتي","وأنت خير جسدي",24,"د",2,0],["فإن تَخلُ كوفان مننادب","عليك يقيم لك المأتما",25,"م",2,0],["فإن تخلُ من عينيّ يا دمع منهم","فلست بخالٍ منهم في خياليا",26,"ي",2,0],["فَإن تُخَلِّف راسَ بَندَر مُوسَى","عَلَى نَهَارٍ كَانَ أَو تَغليسَا",27,"س",2,0],["فَإن تُخَلِّفه تَرَى مَهَايمَا","مُعتَزِلَه بالنارَجِيلِ دايمَا",28,"م",2,0],["فَانتَخ بِهِ البرَّ بِلاَ نَدَامَه","هَنِيتَ فيهِ الأمنَ وَالسَّلاَمَه",29,"ه",1,0],["فَإن تُخَلِّفهُ يَدُورُ البَرُّ","عَن مَغرِبِ السُّهَيلِ هَذا خَبَرُ",29,"ر",1,0],["فأنت خير وكيل في المقاصد عن","اسمى اصيل له في المجد تجنيد",30,"د",1,0],["فَإِن تَخلِط حَياءً مِن صُبَيرٍ","بِهِم تَسُقِ السَفالَ إِلى الخُمولِ",31,"ل",1,0],["فَإِن تَخلَق لِيَربوعٍ وَيَبقى","فَإِنَّ اللُؤمَ فَوقَهُمُ جَديدُ",32,"د",1,0],["فأنتَ خلقتهم خلقاً جَديداً","وصيّرتَ السّماحَ بِهم كَفِيلا",33,"ل",2,0],["فإن تخفها الأوراق تبد كأنها","حسان منيع حرزها خفرات",34,"ت",1,0],["فأنت خليفةُ الرحمن حقاً","جمعت سماحةً وجمعت دينا",35,"ن",2,0],["فإنْ تُخْفِ ألحاظُكَ القاتلاتُ","دمي فبخديّكَ ما يختفي",36,"ف",2,0],["فإن تخف في الوصف من إسراف","فلذ بمدح السادة الأشراف",37,"ف",1,1],["فأنت خيرة خلق الله كلهم","لن يبلغ الوصف هام السيد العلَم",38,"م",1,0],["فإنْ تخلع الأوزان عنه تخففا","تعش بيدقا دون الإمارة يُمحقُ",39,"ق",1,0],["فأنتَ خادمُ بيتِ اللهِ في شَمَمٍ","وأنتَ للدينِ بعدَ الله ندَّخِرُ",40,"ر",1,0]]}