{"poems":[[73,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[92,"يا عذارى الجمال، والحبِّ، والأحلامِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14564&r=&rc=10",""],[222,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[282,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[437,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"]],"verses":[["أَم ظَرفِكَ الحُلوِ الجَنى","أَم عِرضِكَ الصافي الأَديم",0,"م",1,0],["أَم ظَنَنتَ الشَعبَ حَنَّ إِلى","إِمرَةِ الخِصيانِ وَالخَدَمِ",1,"م",1,0],["أم ظننت الشّعب حنّ إلى","إمرأة الخصيان والخدم ؟",2,"م",1,0],["أم ظلامٌ، كأنهُ قِطَعُ الليل،","وهولٌ يُشيبُ قلبَ الوليدِ",3,"د",1,0],["أم ظن أسطولكم بأن","كم أوّلو بأس متين",4,"ن",1,0],["أَمُظَفَّرَ الدينِ اِستَمِعها مِدحَةً","كَالعِقدِ بِالدُرِّ الثَمينِ يُفَصَّلُ",5,"ل",1,0],["أم ظلت تسأل سالفا بسويقة","رفقاً وليس يجيب عما نسأل",6,"ل",1,0]]}