{"poems":[[75,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[93,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[93,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[94,"يا عذارى الجمال، والحبِّ، والأحلامِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14564&r=&rc=10",""],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[287,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[443,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126716","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126830","المتقارب"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122358","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75744","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59246","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59112","الكامل"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121535","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53029","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53103","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53200","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66541","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44709","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94361","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58070","البسيط"],[4862,"ولم تزل العبرات مخنوقه","https://www.poetsgate.com/ViewPoem.aspx?id=55632",""],[5431,"ليلى والذئاب....","https://www.poetsgate.com/ViewPoem.aspx?id=207188",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""]],"verses":[["أَم ظَرفِكَ الحُلوِ الجَنى","أَم عِرضِكَ الصافي الأَديم",0,"م",1,0],["أَم ظَنَنتَ الشَعبَ حَنَّ إِلى","إِمرَةِ الخِصيانِ وَالخَدَمِ",1,"م",1,0],["أم ظننت الشّعب حنّ إلى","إمرأة الخصيان والخدم ؟",2,"م",1,0],["أم ظلامٌ، كأنهُ قِطَعُ الليل،","وهولٌ يُشيبُ قلبَ الوليدِ",3,"د",1,0],["أم ظن أسطولكم بأن","كم أوّلو بأس متين",4,"ن",1,0],["أَمُظَفَّرَ الدينِ اِستَمِعها مِدحَةً","كَالعِقدِ بِالدُرِّ الثَمينِ يُفَصَّلُ",5,"ل",1,0],["أم ظلت تسأل سالفا بسويقة","رفقاً وليس يجيب عما نسأل",6,"ل",1,0],["أمظهر يا مَن له راحة","لكلِّ الأنام غَدَت مَورِدا",7,"د",2,0],["أمظهر يا مَن له راحة","بها أخجلَ الغيثَ جوداً وبذلا",8,"ل",2,1],["ام ظباء بحاجر وزرود","تصرع الاسدام تصيد الرجالا",9,"ل",2,0],["أَم ظبيّة جعلت فؤادك مرتَعاً","فَعلت به أَفعال من لا يشفق",10,"ق",1,0],["أمْ ظَبْيَةُ الوادِي المُقَدَّسِ تَرْتَعِي","ريْحَانَةَ الرَّوْضِ الأرِيضِ المُونِقِ",11,"ق",1,0],["أمْ ظِل صُدْغٍ مَدَّ حَاشِيَةً عَلَى","شَاطِي غَدِيرِ الخَد أمْ رَيْحَانُ",12,"ن",1,0],["أم ظلمة غطت الأبصار منك فما","صيغت معانيك إلا من معانيها",13,"ي",3,0],["أَمُظَفِّر الدين الذي أبوابه","مَغْنَى الغنى ومعرَّسَ الأنضاء",14,"ا",2,0],["أمظفر الدين انتزع ما طاب من","رتب العلا فسواك عنها يقصر",15,"ر",1,0],["أمظفر الدين الذي أوصافه","ما زال ينشرها الثناء فَيُفْعِم",16,"م",1,0],["أَمُظَفَّرَ الدِّينِ اسْتَمِعْ قَوْلي وَقُلْ","لِعِثارِ عَبْدٍ أَنْتَ مالِكُهُ لَعا",17,"ع",2,0],["أمظلتي شكرا فَقَد آنستِني","وَمِن الوُجوهِ المنحسات وَقَيتِني",18,"ي",1,1],["أَم ظُبيٌّ من ظَبا الإنس سما","فأراش السهم من غير قِسي",19,"ي",1,0],["أم ظبيةُ الإنسِ في أترابها برزت","من كل مَتَّانةِ العينين مَيَّاسِ",20,"س",1,0],["أم ظنكم أني رحلت ولم أعد","تباً لكم يازمرة الخبثاءِ",21,"ا",2,0],["أمظلةُ العجم اللئام وقايةٌ","لك زاعما أنّ الأخوة مرجعُ ؟!!!",22,"ع",1,0],["أَمُظَفَّرٌ لا زِلْتَ أَنْتَ مُظَفَّراً","فِيما تُحاوِلُ كَوْنَهُ وَتُرِيدُهُ",23,"د",2,0]]}