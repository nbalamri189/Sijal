{"poems":[[55,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[95,"أبقى ويرفض حولي عقد خلاني","https://www.aldiwan.net/poem11271.html","البسيط"],[87,"يا راحلا عنا وذكرك خالد","https://www.aldiwan.net/poem7267.html","الكامل"],[71,"رب مغن قال لي","https://www.aldiwan.net/poem28295.html","مجزوء الرجز"],[215,"هذا خطاب بوحي الحب تكتبه","https://www.aldiwan.net/poem46595.html","البسيط"],[239,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[274,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[503,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[527,"هذا الحبيب وصفوة الجبار","https://www.aldiwan.net/poem13289.html","الكامل"],[565,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[565,"لاحت فقلنا كوكب الصبح بان","https://www.aldiwan.net/poem52897.html","السريع"]],"verses":[["هَذا خُمارُ فَتىً أَدا","رَ مِنَ البَلاءِ لَكُم كُؤوسا",0,"س",2,0],["هَذَا خَلِيلُكَ لَوْ تَدْرِي بِمَوْقِفِهِ","وَالرُّوحُ مُهْتَزَّةٌ فِي شِبْهِ جُثْمَانِ",1,"ن",1,0],["هذا ختامك بين قوم أحسنوا","لك صنعهم أحسِن بذاك ختاما",2,"م",2,0],["هذا خفيفٌ داخلٌ","وذا ثقيلٌ خارجُ",3,"ج",1,0],["هذا خطابٌ بوحي الحب تكتبه","روح لها السحر في طغيانه تبعُ",4,"ع",1,1],["هَذا خِتانٌ جَرى بِالسَعدِ طائِرُهُ","وَشابَهَ الوِردَ في إِحمادِهِ الصَدَرُ",5,"ر",1,0],["هذا خَريفُكِ والأزهارُ ذابلةٌ","فأمِّلي بعدَه أيّارَ أو آبا",6,"ب",2,0],["هذا خَفِيٌّ ظاهرٌ في طَوْرِهِ","قُلْ نِعْمَ ذاكَ الظَّاهِرُ المَخْفِيُّ",7,"ي",1,0],["هذا خَفاءٌ آنَ يُنْشَرُ شأنُهُ","عَجَباً ظُهورٌ في الخَفا مَطْوِيُّ",7,"ي",1,0],["هَذا خِتام الأَنبياء هَذا أَج","ل الأَصفياء هَذا مُجير الجار",8,"ر",1,0],["هذا خليفتُهُ الذي أحيا الوَرَى","أحياكِ حتى اخضَرَّ منكِ العُودُ",9,"د",1,0],["هذا خليلُ اللهِ والناسِ في الدْ","دِينِ وفي الدُّنيا فنِعْمَ القِرانْ",10,"ن",1,0]]}