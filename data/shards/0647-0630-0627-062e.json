{"poems":[[55,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[95,"أبقى ويرفض حولي عقد خلاني","https://www.aldiwan.net/poem11271.html","البسيط"],[87,"يا راحلا عنا وذكرك خالد","https://www.aldiwan.net/poem7267.html","الكامل"],[71,"رب مغن قال لي","https://www.aldiwan.net/poem28295.html","مجزوء الرجز"],[215,"هذا خطاب بوحي الحب تكتبه","https://www.aldiwan.net/poem46595.html","البسيط"],[240,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[505,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[529,"هذا الحبيب وصفوة الجبار","https://www.aldiwan.net/poem13289.html","الكامل"],[567,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[567,"لاحت فقلنا كوكب الصبح بان","https://www.aldiwan.net/poem52897.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138377",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64236","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77736","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202167","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110339","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28022","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109808","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87660","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87539","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145037","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74069","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77117","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33774","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120505","الكامل"],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[4980,"قَتِيلُ الشَّوقِ","https://www.poetsgate.com/ViewPoem.aspx?id=190955",""],[5032,"خيال رجائي","https://www.poetsgate.com/ViewPoem.aspx?id=189500",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5106,"جَاْدَتْ غِيُوثُكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137168",""],[5239,"أهدى إلى ملك الملوك دعائي","https://www.poetsgate.com/ViewPoem.aspx?id=190940",""],[5273,"خطاب من الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=175271",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5813,"هذا خيالي","https://www.poetsgate.com/ViewPoem.aspx?id=176823",""],[5956,"خالد مظلوم يناجي شقيقه المرحوم محمد","https://www.poetsgate.com/ViewPoem.aspx?id=193450",""],[6070,"يا أيُّها الضَّوءُ المُسافرُ في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=197531",""],[6152,"أغلال الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=202348",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6238,"فجر الخليل...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86776&r=&rc=5",""],[6357,"قالت وداعا ً....","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77957&r=&rc=19",""]],"verses":[["هَذا خُمارُ فَتىً أَدا","رَ مِنَ البَلاءِ لَكُم كُؤوسا",0,"س",2,0],["هَذَا خَلِيلُكَ لَوْ تَدْرِي بِمَوْقِفِهِ","وَالرُّوحُ مُهْتَزَّةٌ فِي شِبْهِ جُثْمَانِ",1,"ن",1,0],["هذا ختامك بين قوم أحسنوا","لك صنعهم أحسِن بذاك ختاما",2,"م",2,0],["هذا خفيفٌ داخلٌ","وذا ثقيلٌ خارجُ",3,"ج",1,0],["هذا خطابٌ بوحي الحب تكتبه","روح لها السحر في طغيانه تبعُ",4,"ع",1,1],["هَذا خِتانٌ جَرى بِالسَعدِ طائِرُهُ","وَشابَهَ الوِردَ في إِحمادِهِ الصَدَرُ",5,"ر",1,0],["هذا خَريفُكِ والأزهارُ ذابلةٌ","فأمِّلي بعدَه أيّارَ أو آبا",6,"ب",2,0],["هذا خَفِيٌّ ظاهرٌ في طَوْرِهِ","قُلْ نِعْمَ ذاكَ الظَّاهِرُ المَخْفِيُّ",7,"ي",1,0],["هذا خَفاءٌ آنَ يُنْشَرُ شأنُهُ","عَجَباً ظُهورٌ في الخَفا مَطْوِيُّ",7,"ي",1,0],["هَذا خِتام الأَنبياء هَذا أَج","ل الأَصفياء هَذا مُجير الجار",8,"ر",1,0],["هذا خليفتُهُ الذي أحيا الوَرَى","أحياكِ حتى اخضَرَّ منكِ العُودُ",9,"د",1,0],["هذا خليلُ اللهِ والناسِ في الدْ","دِينِ وفي الدُّنيا فنِعْمَ القِرانْ",10,"ن",1,0],["هذا خطيب مصقع لم يحكه","متأخر في الناس او متقدم",11,"م",1,0],["هذا خُزَاماها وذا قيصومُها","هذي شقائقها وذا حوذانها",12,"ن",3,0],["هَذا خطاب أَنتَ كعبة أَهله","وَالرزدكاش وَسيفهم وَالضارب",13,"ب",1,0],["هذا خميسٌ أَنتَ تحمي دُونَه","بَأْساً وهذا يَقْتفيه خَميسُ",14,"س",1,0],["هذا خيالُ أبي طبعتُ على","غراره في مناهج الأدب",15,"ب",1,1],["هذا خصصتُ به وحدي وأعن به","نوع الأناسيِّ حال البدء والإنشا",16,"ش",2,0],["هذا خليل اللَه خط بقلبه","ما خصه موسى على الواحه",17,"ح",2,0],["هَذا خَليل اللَه والناس الَّذي","ناداهُ رَبُّ العرش من أَعلى الذرى",18,"ر",2,0],["هَذا خَليلُكَ يا حَبيبَ خَليلهِ","وَلنا من الإِسمَين اعظمُ شاهد",19,"د",1,1],["هذا خريرك يستف","ز بلحنه أهل القبور",20,"ر",1,0],["هَذا خَليفتك الَّذي اِستَخلَصته","وَأَقمته حيث الجَلال أَقاما",21,"م",2,0],["هذا خِتامُ الصالحينَ وَلَيتَما","كلُّ النُفوسِ بذي النِهايةِ تُختَمُ",22,"م",1,0],["هذا خُطوطُكَ شاهِداتٌ بِالَّذي","حَرَّرتَهُ ما قُلتُ إِفكاً مُفتَرى",23,"ر",2,0],["هذا خليلُكَ فِضواً لا حراكَ بهِ","لم يبقَ من جسمهِ إلا توهمُّهُ",24,"م",2,0],["هذا خليفته وناصر دينه","ومجير امته بما هو آمر",25,"ر",1,0],["هذا خطيب الكائنات من الملا","علم الهدى كشاف كل ملمة",26,"ه",1,0],["هَذَا خَلِيلِي بَعدَ أن غَابَ الهَوَى","قَامَ الرَّدَى بَينَ الصَّفَايَا يَفرِقُ",27,"ق",1,0],["هَذا خَيَالُ رجَائي أنَّها تَقِفُ","يَبْدو فأسْمَعُ صارُوخاً فيَنْصرِفُ",28,"ف",1,1],["هذا خيالُ الخالدينَ فغنّني","وأعِدْ بشعركَ للشباب حياتي",29,"ت",2,0],["هِذَاْ خَلِيْلِيْ رَاْهِبَاً فِيْ هَوْدَجٍ","مِنْ نَاْقَةٍ مَيْسَاْءَ تَبْكِيْ نَاْفِقَا",30,"ق",2,0],["هذا خدابندا محمد الذي","ساد الملوك بدولة غراء",31,"ا",2,0],["هذا خِطابي عَلَّ صَمْتَكَ يَنجَلي","يامَنْ بحَقِّ مَصيرِهِ قَدْ أجرَمَا",32,"م",2,0],["هَذَا خَليفَتُكُمْ بَعْدِي فَإنَّ لَهُ","مِيثَاقَ وَعْدٍ بِعَهْدِ اللهِ مُتَّصِلِ",33,"ل",1,0],["هذا خريفُ العُمْرِ يدنو شاحباً","وملامحُ الأحبابِ طيفٌ وٓدّٓعكْ",34,"ك",1,0],["هذا خيالي كل ما الليل يسري","ولو نامت عيون المخاليق مانمت",35,"ت",1,0],["هذا خيالك يلتقيني باسماً","فوق الضريح ويرتجيني المعذرةْ",36,"ر",2,0],["هذا خطابٌ من فؤادٍ نابضٍ","بالحبِّ للإنسانِ والأشجارِ",37,"ر",1,0],["هذا خيالكم يداعب ليلنا","والنومُ إن زار الخيالُ محال",38,"ل",1,0],["هذا خطابُكَ في الصيفِ العتيقِِ، لكَمْ","صافتْ سنابلُ ليلٍ مِلْؤُها تَتَرُ!‏",39,"ر",1,0],["هذا خليلُ اللّهِ في صَمتِ الّلظى","كانَ البدايةَ، ثمَّ كنتَ الخاتِمةْ",40,"م",2,0],["هذا خطابي جاء اليوم يكتبني","إني استقلت ُ سأمضي حيث أحتضرُ",41,"ر",1,0]]}