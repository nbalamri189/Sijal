te.com/ViewPoem.aspx?id=197164",""],[4869,"العيد فرحه واحساس","https://www.poetsgate.com/ViewPoem.aspx?id=151637",""],[4869,"سلام ياللي على بالي","https://www.poetsgate.com/ViewPoem.aspx?id=151659",""],[4929,"مآلاتُ اللاءات","https://www.poetsgate.com/ViewPoem.aspx?id=208656",""],[5351,"عذاب اليوم..","https://www.poetsgate.com/ViewPoem.aspx?id=203746",""],[5376,"وكأنني ما عشت يوما مالكا","https://www.poetsgate.com/ViewPoem.aspx?id=189520",""],[5376,"يا قِبلةَ الشوقِ هاج القلبَ وجدانُ","https://www.poetsgate.com/ViewPoem.aspx?id=191873",""],[5376,"بشراك ما قد أتتنا الأعينُ النجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=194080",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5537,"فيها حاجه حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=214540",""],[5605,"سيدي الأفمي f.m.i","https://www.poetsgate.com/ViewPoem.aspx?id=159737",""],[5612,"بالبابِ باتَ العائدونْ","https://www.poetsgate.com/ViewPoem.aspx?id=179613",""],[5612,"يا عالِمَ الأسْرار","https://www.poetsgate.com/ViewPoem.aspx?id=182859",""],[5612,"يا رَبّْ","https://www.poetsgate.com/ViewPoem.aspx?id=183178",""],[5732,"الله من قلب","https://www.poetsgate.com/ViewPoem.aspx?id=177901",""],[5790,"يا أيها الشامخ في قربه","https://www.poetsgate.com/ViewPoem.aspx?id=111961",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[5956,"لم أشبع من حب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=183289",""],[5956,"عَبِّرْ","https://www.poetsgate.com/ViewPoem.aspx?id=184477",""],[242,"مات الحفيظ فمن يحفظ من عاشا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563799",""],[402,"مولاي أيدك الرحمن في نعم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54040&r=&rc=892",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["بِالْبَاطِلِ الْبَحتِ الصرَاحِ تَعَزَّزُوا","فَالآنَ لِلْحَقِّ الْمُبِينِ تَذَلَّلُوا",0,"ل",3,0],["بِالبازِلِ الكَوماءِ يَت","بَعُها الَّذي قَد شَقَّ نابُه",1,"ب",2,0],["بِالبَرِّ صافِنَةٌ داسَت سَنابِكُها","مَناجِمَ التِبرِ لَمّا عافَتِ المَدَرا",2,"ر",2,0],["بِالبَابِ ضَارِعَةٌ للهِ مُخْلِصَةٌ","تَدْعُو وَمَا خَابَ مَنْ تَدْعُو مِنْ أَمَمِ",3,"م",1,0],["بالبُتِّمِ الأشِب الذي لم يرجُه","أحسدٌ ولم يك مُخَّةً للمنتقي",4,"ي",1,1],["بِالبيضِ حينَ تُسَلُّ مِن أَغمادِها","يَوماً وَإِنهالِ الرِماحِ وَعَلِّها",5,"ل",3,0],["بِالبيضِ تَرعَشُ في الأَيمانِ عارِيَةً","تَعوَجُّ في الضَربِ أَحياناً وَتَعتَدِلُ",6,"ل",1,0],["بالبيتِ يُنْشِدُ رُبعَه أو نصفَه","والخبزِ يُرزَأُ عنده والماءِ",7,"ا",2,0],["بالبرِّ تسترهُ ويشهرُ نفسه","أبدا وتكتمُه وفيه تميمُ",8,"م",1,0],["بالبغي قد قتلوا للشعر منك ابا","فاصبح الشعر من يتم بغير اب",9,"ب",1,0],["بالباب مفقود اللسان بعثته","يلهو كرفقته لديك ويمرح",10,"ح",1,0],["بِالبَرِّ صُمتَ وَأَنتَ أَفضَلُ صائِمٍ","وَبِسُنَّةِ اللَهِ الرَضِيَّةِ تُفطِرُ",11,"ر",1,0],["بِالباعِثِ الوارِثِ الأَمواتِ قَد ضَمِنَت","إِيّاهُمُ الأَرضَ بِالدَهرِ الدَهاريرِ",12,"ر",1,0],["بالِبيضِ تُنْكِرُها الأغمادُ مُغمَدَةً","والجُرْدِ تَعرِفُها الغِيطانُ والأَكَمُ",13,"م",1,0],["بِالبَطشِ تَمَّ المُلكُ لِاِبنِ مَراجِلٍ","وَتَأَخَّرَ اِبنُ زُبَيدَةَ المُتَقَدِّمُ",14,"م",1,0],["بِالبيضِ قَد أَنِفَت إِنَّ الحُسامَ إِذا","هَجيرَةٌ حَرَّضَتهُ ساعَةً أَنِفا",15,"ف",2,0],["بالبراكين ثائرات جرت من","حممٍ فيها أبحرٌ ونهور",16,"ر",1,0],["بالبلبل المتغني في ملاعبه","والسنبل المتثني في غدائره",17,"ر",2,0],["بالبَينِ وبالهجرانِ فيا","لِفُؤَادِي كيف تَجَلُّدهُ",18,"د",2,0],["بالبحر قيلولة والشوق أختنق","للنوم حيلولة والحب مختنقُ",19,"ق",1,1],["بالبشر والتوفيق هلَّ أمينُ","فلتفرح الدنيا به والدينُ",20,"ن",1,1],["بِالبيضِ بِيضِ الهِندِ يَحمي بِيضَهُ","يَومَ الوَغى وَذَوابِلِ المُرّانِ",21,"ن",1,0],["بِالبرءِ سقمٌ وبالموتِ الحياة بهِ","وَالعكسُ بالعكس تنكيرٌ وتكميلُ",22,"ل",1,0],["بِالبَزِّ وَالفَرَسِ الحَسناءِ مَوهِبَةً","وَبِاللِقاحِ الصَفايا تَحلِبُ الدِررا",23,"ر",2,0],["بالبر قد اوعدتني","يا سيدي بالرد",24,"د",1,0],["بالبيض والسمر الرشاق محجب","من لي به والموت دون خبائه",25,"ا",3,0],["بالبيت حِلْفاً فالصفا فالمسجد","ما شيَّد الدولةَ من مشيِّد",26,"د",1,0],["بِالْبَوْحِ بِالنَّوْحِ تَرْوِيحاً عَلَى شَجَنٍ","قَدْ أَفْحَشَتْ نَارُهُ فِي الْقَلْبِ إِفْحَاشَا",27,"ش",2,0],["بالبدويّ والرفاعي والدسو","قيّ بمن من العيوب قُدّسوا",28,"س",3,0],["بِالبَدرِ شَبَّهتُهُ وَلَكِن","بِذاكَ نَقصٍ وَذا مُكمِلُ",29,"ل",1,0],["بِالبَدرِ أَشبَهث وَهيَ عَنهُ جَديرُه","لَكِن صَحَوتُ وَما لِنَومي زَورَةٌ",30,"ه",1,0],["بِالبَدرِ شَبهُهُ مَن قَلَّ مَخبَرُهُ","كَما إِلى الوَردِ قَد تَعَزّى نَضارَتُهُ",31,"ت",2,0],["بالبعد يا رُوحَ روحي","حويت بالثغر ظلما",32,"م",2,0],["بالبديع الغريب فيهم وما جا","ءك من فضله فليس ببدعِ",33,"ع",1,0],["بالبان لي دَيْنٌ على ماطلةٍ","يميس غصنُ البان في أَبرادِها",34,"د",3,0],["بالباخلين عرفت قدر سماحه","وبيان قدر الغيث بالأمحال",35,"ل",1,0],["بالبيضِ قد كلّلوا أقمارَهُم وعلى","شُموسِهم بالدّياجي تُضرَبُ الكُلَلُ",36,"ل",1,0],["بالبحرِ كَنِّ وبالغَمامِ عن اِسمِه","والبدرِ والضِّرغامِ لا بفلانِ",37,"ن",1,0],["بالبيت والركن المحلق ركنه","والوافدين إلى نداك بوفده",38,"د",2,0],["بالباس بادر كل باغ مراجم","عنيد له عن شرعة الحق معدل",39,"ل",1,0],["بِالبابِ يَطلُبُ كُلَّ طالِبِ حاجَةٍ","فَإِذا خَلا فَالمَرءُ غَيرُ مُسَدَّدِ",40,"د",1,0],["بالباقيات تزودوا من قبل ما","وافوا النعيم وحبذا التزويد",41,"د",1,0],["بآل بويه أعلى الله رايته","وشد من عقده ما كان منفصما",42,"م",2,0],["بالبين قد ضاق ذرعي","فلست أسطيع بينا",43,"ن",2,0],["بِالبشر في مصر لاحَت غرّة العامِ","تَزهو بِنُور مَليك للحمى حامي",44,"م",2,1],["بِالبشر وَالحَظ تَبدو غرّة العامِ","وَطالع السَعد في إِقباله السامي",45,"م",2,1],["بالبَرِّ من أبنائها بالطهر من","أغصانها بالحر من أشبالها",46,"ل",3,0],["بالبنين الأبطال بالفتية الأق","يال تحمي سلطانك المحدودا",47,"د",2,0],["بِالبديعِ اِمتَدَحَته الفُصَحا","مِن ذَوي الأَلسنِ أَهل اللسنِ",48,"ن",1,0],["بِالبَغيِ عَلى الحَربِ اِجتَهدوا","وَعَليهِ الآنَ لَقَد مَردوا",49,"د",3,0],["بِالبَبَّغاءِ ظفر العُصفور","فَباتَ لا يَهربُ أَو يطير",50,"ر",1,0],["بالبطنِ من علجانٍ حلَّ به","دانٍ فويقَ الأرضِ إذ ودقَتْ",51,"ت",1,0],["بِالبدرِ بالشمس المنيرة بالهتو","نِ الغيث بالمطعان بالمطعامِ",52,"م",1,0],["بالبشر يوم الأفق محلولك","والصبر في الجلىّ وطول الأناة",53,"ه",1,0],["بالبكر ارّخ مُجّدتْ","ومضيّةٌ بالسيدَهْ",54,"ه",1,0],["بالباب قمت وأنت اعظم مطلب","تشتاقه الأرواح والأجسام",55,"م",1,0],["بآل بَيتِك وَالذِكر الحَكيم لَنا","كُلُّ اِعتِصامٍ إِذا ما اِغتالَتِ الغُولُ",56,"ل",1,0],["بالباء ألصق عد بعض واستعن","لقسم عوض معا وابدل كمن",57,"ن",1,0],["بالبيت ذلك بعد أن","أظهرت أنك لا تبالي",58,"ل",2,0],["بالبيضِ والسمر اللّدان يخوض في","مُغبَّر نقعٍ أو نجيعٍ أحمَرا",59,"ر",2,0],["بالبيت شعري يا ابن الفضل مالكنا","هل عندكم لعظيم الذنب غفران",60,"ن",1,0],["بالبعد تلحاني ولم تر حسنه","فإذا نظرت فبعد ذلك عنف",61,"ف",1,0],["بالبر وإحساني","سبحانكَ اللَهُ",62,"ه",1,0],["بالبر والغفران","محمد الحنان",63,"ن",1,0],["بالبيت أقسم والركاب تحجبه","قصداً لادكن قالص الاستار",64,"ر",1,0],["بالبيض من صفاحه والسمر من","رماحه والزرق من خرصانه",65,"ه",1,0],["بالبينِ أوصلت كلَّ بين","فقام شكرُ البينِ بيني",66,"ن",2,0],["بِالبَديعِ الجَزلِ مِن تَشبيهِهِ","وَالمَنيعِ السَهلِ مِن تَخييلِهِ",67,"ل",2,0],["بالبر والحسناتِ تأمر أهلها","والنَهيِ عن عَمَلِ السيوفِ قواضبا",68,"ب",2,0],["بِالبيض وَالصفر تَهمي سُحب انمله","عَلى البَرية لا قطرا وَلا وَدَقا",69,"ق",2,0],["بالبرق يظفر إن أراد لحاقه","والبرق ليس إذا أراد بظافر",70,"ر",1,0],["بالبَلدِ وَالترتيبِ والتَّسدِيدِ","فَإنّ ذَا مِن رَأيكَ السَّديدِ",71,"د",1,0],["بالبرِّ وَالجِبَالِ والشُّجرَانِ","والبَلدِ والمَجرَى أو النِّيشَانِ",71,"ن",1,0],["بالبشر يلقاك في أسنى مؤانسة","تنسى بها الأهل والجيران والوطنا",72,"ن",2,0],["بالبدر ماذا تعوضونهمو","ان يصفوا الحسن كلما ظهرا",73,"ر",2,0],["بِالبُكاءِ عُيُونُهُنَّ سَحَّ غَوادِ","لهف نَفْسي عَلَى الْحُسَيْنِ غَريبا",74,"ب",2,0],["بالبطركيَّة دارِ العلم والادبِ","يَليق ان تَتَباهى امَّة العربِ",75,"ب",1,1],["بالبابِ قِف مستأذناً واليُمنى","قدِم وقُل مِنَ الدُعا ما سَنا",76,"ن",2,0],["بالبَطلِ الغَضَنفَرِ الأبيّ","بالناصِحِ المُحتسبَ الوفيّ",77,"ي",1,0],["بالبرِّ تُستعبَدُ الأحرارُ طائِعَةً","ويحصُلُ الصَّقرُ في أشراكِ صَيَّاد",78,"د",1,0],["بالبرقع المجمرِّ من","وشي الحرير أرى انتساجه",79,"ج",2,0],