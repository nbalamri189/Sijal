{"poems":[[63,"وكاشح خامرت ألحاظه سنة","https://www.aldiwan.net/poem45924.html","البسيط"],[63,"بشراك قد ظفر الراعي بما ارتادا","https://www.aldiwan.net/poem46210.html","البسيط"],[29,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[50,"وكاشح معرض عني هممت به","https://www.aldiwan.net/poem62360.html","البسيط"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[113,"لجأت بباب النبي العظيم ال","https://www.aldiwan.net/poem42015.html","المتقارب"],[118,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[259,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[362,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[456,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[459,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[584,"عذابي من ثناياك العذاب","https://www.aldiwan.net/poem17442.html","الوافر"]],"verses":[["وَكاشِحٍ خَامَرَتْ أَلْحاظَهُ سِنَةٌ","تَرَكْتُهُ وَهْوَ مِنْ جَفْنَيْهِ تَنْتَفِضُ",0,"ض",1,1],["وكاشِحٍ رامَ منْهُمْ فُرصَةً ضَرَبَتْ","مِنْ دونِها شَفَراتُ البيضِ أسْدادا",1,"د",2,0],["وَكاشِحٍ مُعرِضٍ عَنّي غَفَرتُ لَهُ","وَقَد أُبَيِّنُ مِنهُ الضِغنَ وَالمَيَلا",2,"ل",2,0],["وَكاشِحٍ مُعرِضٍ عَني هَمَمتُ بِهِ","ثُمَّ اِرعَوَيتُ وَقُلتُ الناسُ بِالناسِ",3,"س",1,1],["وَكاشِحِ الصَدرِ تَسري لي عَقارِبُهُ","رَشَّحتُهُ لِعِقابٍ بَعدَ إِجهادِ",4,"د",1,0],["وكاشف كرب الضعيف الذليل","وناصر جاه الحسيب النسيب",5,"ب",1,0],["وكاشفه والعين ينهل ماؤها","بما كان يخفى من هوى ليس خافيا",6,"ي",2,0],["وكاشف اغماض العلوم بفطنة","بها فضل الكشاف فضلا عن الشفا",7,"ف",2,0],["وكاشحٌ صَدرُه مَلآنُ من غُلَلٍ","فلو سقَوْهُ بحارَ الأرضِ ما رَويا",8,"ي",2,0],["وكاشفني وكان مجاملاً لي","عَبوسُ الوجه من زمني وَقاحُ",9,"ح",1,0],["وكاشف ذيل النقع عن بكر وائلٍ","وقد بَشمَ الشِّلو المعفَّرَ آكلُهْ",10,"ل",2,0],["وَكَاشِفَ كُلِّ مَظْلِمَةٍ وَظُلْمٍ","بِآراءٍ خُلِقْنَ مِنَ الصَّوابِ",11,"ب",1,0]]}