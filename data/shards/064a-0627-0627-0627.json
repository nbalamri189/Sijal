{"poems":[[4755,"لَمَّا طَغَى المَاء..","https://www.poetsgate.com/ViewPoem.aspx?id=183533",""],[4755,"إِنِّي أَحِنُّ إِلى اتِّصَالِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=183828",""],[4755,"نَحنُ أَهدَافُ رَمْيِنَا.. والرُّمَاةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184090",""],[4755,"عِطْرُ خَدَّيكِ شَاغِلِي إنْ أَضَاءَ ال","https://www.poetsgate.com/ViewPoem.aspx?id=184669",""],[4755,"سَجَنُوا الغِلالَ","https://www.poetsgate.com/ViewPoem.aspx?id=200428",""],[4755,"تَحَوُّلاتُ الأَحزِمَة","https://www.poetsgate.com/ViewPoem.aspx?id=213576",""],[4797,"دكتور العيون","https://www.poetsgate.com/ViewPoem.aspx?id=29433",""],[4869,"الحياه الملوكيّه","https://www.poetsgate.com/ViewPoem.aspx?id=137909",""],[4869,"ثرثرة خوفي","https://www.poetsgate.com/ViewPoem.aspx?id=151544",""],[4869,"مرثيه في الامير سلطان بن عبدالعزيز","https://www.poetsgate.com/ViewPoem.aspx?id=151548",""],[4869,"بسمة الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=151576",""],[4869,"المفارق قسمتي","https://www.poetsgate.com/ViewPoem.aspx?id=151619",""],[4869,"يديك ويديني","https://www.poetsgate.com/ViewPoem.aspx?id=151676",""],[4962,"أحتاج قلباً","https://www.poetsgate.com/ViewPoem.aspx?id=198542",""],[5057,"جريمتي حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=197246",""],[5431,"ماأقبح الكبْر ...","https://www.poetsgate.com/ViewPoem.aspx?id=209048",""],[5751,"معد الجبوري","https://www.poetsgate.com/ViewPoem.aspx?id=215007",""],[5848,"لا تخلين زايد","https://www.poetsgate.com/ViewPoem.aspx?id=50593",""]],"verses":[["ياااااا مَن عَلى غَيرِ نارٍ تَطبُخُونَ دَمِي","لَم يَبقَ في القَلبِ إِلَّا الوَاحِدُ الصَّمَدُ",0,"د",1,0],["ياااا مَن هُنالِكَ.. حَيثُ لا","يَبدُو لِنَاظِرِهِ هُنالِكْ",1,"ك",1,0],["ياااا لَصَنعاءَ بَعدَمَا آلَمُوها","واستَوَى العَيشُ عِندَها والمَمَاتُ",2,"ت",1,0],["يااا مَتَاهَ القُلُوبِ هَل مِن سَبيلٍ","لِلغَريبَينِ يُرتَجَى يا مَتَاهَ ال..",3,"ل",1,0],["يااااا أَيُّها القَدَرُ الكَسُولُ متى","سَتُحِسُّ أَنكَ أَنتَ مَن أَبطا؟",4,"ط",2,0],["يااااا مَوطِنِي.. وبَدَأْتُ أَكفُرُ بال","وَطَنِ الذي جُوعِي بهِ لاذا",5,"ذ",2,0],["ياااكثر ما يضرب خويي (الطابلون)","من كثر ما اكلّته مطباات وكليت",6,"ت",1,0],["يآآآكم سكتي .. وسولفتي","بذيك العيون المهآويّه",7,"ي",2,0],["يآآآويش ابجنيه من مآتكنز حروفي","مآغير لأعدآء قلبي بس أسلمهآ",8,"م",3,0],["يآآآرب عندي لما تقوله قنآعه","وهذا قدر مكتوب من قبل مجنآه",9,"ا",2,0],["ياااارب تكسي سيّدي بالمنآعه","في قبره اللي .. ليييييتني كنت ويآه",9,"ا",2,0],["يآآآ وقت لاتشعل على ذنبي شموع","طفّ الكلام .. وافتح الباب للسلم",10,"م",1,0],["يآآآمحمد والله انّه ضآآع فيهآ من قرآهآ","لكن اللي مثلي ومثلك تذرّآ في كفنهآ",11,"ن",3,0],["ياااامن يقرّب من يدينك يديني","والا يقرّب من يديني يدينك",12,"ك",1,0],["يااااااااا من أنادي؟! والحياة كأهلها","والحال فيها لا يغادر أسْرَهُ",13,"ر",2,0],["يااااااااا موطِناً أجريتهُ بدمي","فقضى بأنّ جريمتي حرْفيْ !!!",14,"ف",2,0],["ياااا (..) كم تناسى صلصال نشأته","لجوف أرضٍ كلّ الذي خُلقا",15,"ق",2,0],["ياااااربُّ عفوكَ صار الظلمُ مملكةً","ووحدنا الآن فيها نلتوي خُصَلا",16,"ل",2,0],["ياااااااه .... يا ضحكتك ياهي ترد الشباب","تعدل الوقت بعض احيان ..... وتميّله",17,"ل",2,0]]}