{"poems":[[55,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[55,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[65,"رأت أم عمرو ما أعاني فعرضت","https://www.aldiwan.net/poem46079.html","الطويل"],[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[79,"فيا من يؤمل هذا الجنابا","https://www.aldiwan.net/poem36616.html","المتقارب"],[74,"بكى الشعر أيام المنى والمنائح","https://www.aldiwan.net/poem18477.html","الطويل"],[74,"لام العذار أطالت فيك تسهيدي","https://www.aldiwan.net/poem18544.html","البسيط"],[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[53,"أبكيتني فبكيت من غير ذنب جنيت","https://www.aldiwan.net/poem8683.html","المجتث"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[53,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[63,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[82,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[83,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[50,"ألا يا شهر كم تبقى","https://www.aldiwan.net/poem64464.html","الهزج"],[48,"إله قادر وعبيد سوء","https://www.aldiwan.net/poem23143.html","الوافر"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[53,"أبكيتني فبكيْتُ","https://www.poetsgate.com/ViewPoem.aspx?id=27184",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[147,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[164,"خذ الملك يا يحيى إليك بقوة","https://www.aldiwan.net/poem58881.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[234,"بلغت بلاغتك البديع وأكثرا","https://www.aldiwan.net/poem51017.html","الكامل"],[302,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[412,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[415,"نظام الدين لا سقيا لخطب","https://www.aldiwan.net/poem32267.html","الوافر"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122607","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48785","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48834","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52089","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93694","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100788","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100728","الكامل"],[3380,"","https://poetry.dctabudhabi.ae/diwan/poem/147233","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62794","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48308","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86278","الكامل"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77731","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91746","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114135","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58049","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141606","الهزج"],[4764,"قهرت الغير","https://www.poetsgate.com/ViewPoem.aspx?id=29790",""],[4767,"نبع الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=197294",""],[5213,"تأن ناعيه على القوم قد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=170422",""],[5409,"قاتل الله من أمية حزباً","https://www.poetsgate.com/ViewPoem.aspx?id=155490",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["وَلَو أَمِنَ الجَبانُ مِنَ المَنايا","لَأَغمَدَ سَيفَهُ البَطَلُ المُحامي",0,"م",2,0],["وَلَو آمِنتَ الدَهرَ أَحداثَهُ","صافَحتَ كَفَّ الضَيغَمِ العادي",1,"د",2,0],["وَلَوْ أَمْكَنَتْنِي وَثْبَةٌ أُمَوِيَّةٌ","لأَلْجَمْتُهُ سَيْفِي فَهذا أَوانُها",2,"ن",3,0],["ولو أمَلْتَ إليه السّوطَ غادَرَهُ","شِلْواً بمُعتَرَكِ الأبطالِ مُقْتَسَما",3,"م",2,0],["ولو أمْهَلَ الوقْتُ تَنْقيحَها","لجاوَزْتُ غايةَ عبْدِ الحَميدْ",4,"د",1,0],["ولو أمكن الغيث الفدى بوليّه","فدى صالحاً من آل شادٍ بطالح",5,"ح",1,0],["ولو أمرّ على صلد الصفا يدهُ","لأنبت العشبَ منها كلّ جلمود",6,"د",1,0],["ولو أمر","ذاكَ الخصرْ",7,"ر",1,0],["ولو أمرتِ بأنّي","أقضي الحياةَ قضَيتُ",8,"ت",1,0],["ولو أمْكَنَتكُمْ في الفريقينِ فرصةٌ","لقد بُيِّنَتْ أشياءُ تلوَى وتُحْنَجُ",9,"ج",1,0],["ولَوْ أمِنْتُكُمُ أَمْنِي يَدي وفمي","لَمَا نَشَدتُمْ وفائي غيْرَ مَوْجودِ",10,"د",1,0],["ولو أمِنْتُ الذي تَجني أراقمُه","عليَّ هانَ الذي تَجني عقاربُه",11,"ب",2,0],["ولو آمنُ الإغراقَ أضْعَفْتُ سَحّهُ","ولكنّ قلبي الرطبَ رَقّ على قلبي",12,"ب",2,0],["وَلَو أمِنَ الإنسَانُ مِن شَرّ نَفسِهِ","لَمَا هَابَ حَدَّ المُرهَفِ العَضبِ حَامِلُ",13,"ل",1,0],["وَلَو أَمكَنَ أَن يُقتَ","لَ شَهرٌ لَقَتَلناكا",14,"ك",2,0],["وَلَو أَمِنَت شِمالُكَ وَهيَ أُختٌ","يَمينَكَ ظُنَّ خَونٌ وَاِختِزالُ",15,"ل",1,0],["ولو أمحض التقدير عقل لأظهرت","شوارقها بالحكمتين مطالع",16,"ع",1,0],["ولو أمرتِ أن أقضي ال","حياة َ أيضاً قضَيتُ",17,"ت",1,0],["ولو أملا أدركته لم تجد له","بقاء ولم تصحبك منه عهود",18,"د",1,0],["ولوّامة منها حثيثاً يزجُّها","لراضيةٍ مرضيّةٍ وملزِّما",19,"م",2,0],["وَلَو أُمهِلَت تِلكَ الأَباطيلُ ساعَةً","لَأَبقى شَباها مارِنَ الحَقِّ أَجدَعا",20,"ع",2,0],["وَلَو أَمَّ بابَكَ مُستَعصِماً","بِهِ صانَ مِن مُلكِهِ ما بَذَل",21,"ل",1,0],["ولو أمهلوا الوعد الذي وعدوا به","لضاعف أموالا بأقرب مدة",22,"ه",1,0],["وَلَو أمكنَ الكفّارَ مثلٌ أتَوا به","وَمَن يدّعي للشمسِ بينَ الورى أُخرى",23,"ر",2,0],["ولو أمرؤُ القيس اغتدى متعرَّضاً","لك في بديع لانثنى وتقهقرا",24,"ر",2,0],["ولَو أمِدَّ غَمامٌ يَومَ نائله","من فيض كفَّيه ما كفَّت سوافحُهُ",25,"ح",2,0],["وَلَو أُمَّ عاف طفل آل مُسَيَّبٍ","لِقاسِمِهِ در الرَضاع وَليدُها",26,"د",3,0],["ولو أَمَّلتُ أَن أَلقاكَ حتَّى","أَبثُّكَ مضمرَ القلبِ الشَّعاعِ",27,"ع",1,0],["ولوامِعٍ أَشْرَعْتَهُنَّ فأَشْرَقَتْ","إِشراقَ مُلْكِكَ فِي سَنا الأحْسابِ",28,"ب",1,0],["ولوّامٍ يُرينِي الغِش","شَ في مَعْرِضِ إرشادِ",29,"د",1,0],["ولَوِ امتَحنتَ الخيلَ رَكضاً أحرَزَت","بالرَّكضِ مِن عَدنٍ إلى بِغداذ",30,"ذ",1,0],["وَلَو اِمتَد حُكمُه نَحوَ شَهرٍ","لتجلَّى ما رامَهُ بانتِهاه",31,"ا",2,0],["ولو أمهلت صحفهم امتهاناً","لطار بهذه الصحف الفجور",32,"ر",1,0],["ولو أمنوا فيها العداوةَ بينهم","لزالتْ تخومٌ بينهم وحدود",33,"د",1,0],["وَلَو أمكنت مَا بِتُّ إلاَّ مُعَانِقاً","بِسَاحَة فَتْح الله حُمرَ هِجَان",34,"ن",1,0],["وَلَو أَمسَت لَهُ أُدمٌ صَفايا","تُقَرقِرُ في طَوائِفِها الفُحولُ",35,"ل",1,0],["وَلو أَملت أن تَلد الليالي","أَخاك نَهيت دَمعي أَن يَسيلا",36,"ل",2,0],["ولو أمه ذو الجهل اصبح مقتدى","ولو رامه الزنديق امسى موحدا",37,"د",2,0],["ولو أمعن الحساد فيك لما رأوا","سواك بعلياء أحق وأليقا",38,"ق",2,0],["ولو امتلكت النيرات رصفتها","حصباء تغدو فوقها وتؤوب",39,"ب",1,0],["ولو آمنت قبل وقع العذاب","لقد يقبل الله إيمانها",40,"ن",3,0],["ولو أمكنته في اختيالكَ فُرصةٌ","تحدَّرَ صَمْصامٌ عليكَ ذَلوقُ",41,"ق",1,0],["ولوْ أمّل المَوْلَى الخليفَةَ يوسُفاً","لما راعَهُ خَطْبٌ من الدّهْرِ مُعْضِلُ",42,"ل",1,0],["ولوْ أمّ للباب الكريمِ لأصبحَتْ","وُجوهُ الأماني نحْوَهُ تتهلّلُ",42,"ل",1,0],["وَلَو امرءٌو فها يُقيم مُخَلَّداً","لاقامَ تَوفيق العَزيزِ مُحَمَّد",43,"د",1,0],["ولو أملى لهُ الإمهالُ حتَّى","تسيرَ إليه بالجيشِ اللُّهام",44,"م",1,1],["وَلَو أَمكنتنا فرصةٌ من تزاور","لوافاك طَيفٌ هامعُ الجفن بالدم",45,"م",1,0],["وَلَو أمكَنَ السَّيرُ فَوقَ الثَّرَى","عَلَى عَينِنَا كَانَ عَينُ الرَّبَاح",46,"ح",1,0],["ولو أَمروا بالعُرْفِ كنَّا لأمرهم","نُطيعُ ولكنْ آمَروُا بالمناكر",47,"ر",1,0],["ولوّامي من كانوا","إذا غبت أودّائي",48,"ي",1,0],["ولو امسى العنا حظي وضيق الوقت مشروبي","مسير الدنيا تتغير ، واللاقي مين يسمعني",49,"ن",2,0],["ولو أمر الجبارُ بادت جموعهم","ولكنَّ ما أمضاه ربي تأكدا",50,"د",2,0],["ولو أميط الغطا عنهم راوك إذاً","بأشرف العالم العلوي محتجب",51,"ب",1,0],["ولو امتد حكمهم لاستعادت","عصرها الجاهلية العمياء",52,"ا",2,0],["ولوا مع تغشي الورى فلنورها","في كل قلب وحد الألاء",53,"ا",2,0],["ولو امتُحِن الإمامُ خَليّاً","حَلّلَ السُّكر واختلى بالساقي !",54,"ق",2,0]]}