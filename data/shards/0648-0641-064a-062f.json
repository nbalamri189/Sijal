{"poems":[[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[83,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[51,"وقفنا فلولا أننا راضنا الهوى","https://www.aldiwan.net/poem8657.html","الطويل"],[51,"رأيتك لم تحسن ثوابي ولم تجب","https://www.aldiwan.net/poem64016.html","الطويل"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[21,"وفي دينكم من رب مريم آية","https://www.aldiwan.net/poem36159.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54702","الطويل"],[115,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[115,"معاني السر من هذا الوجود","https://www.aldiwan.net/poem41128.html","عموديه"],[124,"أفي كل يوم منزل ورحيل","https://www.aldiwan.net/poem23743.html","الطويل"],[132,"هبت جويرية عذلا تجاريني","https://www.aldiwan.net/poem54714.html","البسيط"],[142,"يسأئلني ما حاجتي في دياره","https://www.aldiwan.net/poem58392.html","الطويل"],[142,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[160,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[160,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[298,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[304,"حويدي المطايا كم تقيم مع الصد","https://www.aldiwan.net/poem16864.html","الطويل"],[353,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[416,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[429,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[458,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[458,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[461,"يفر الخطب قد أمهي شباه","https://www.aldiwan.net/poem16107.html","الوافر"],[506,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[513,"سأكفيك نفسي لا كفاية غادر","https://www.aldiwan.net/poem67781.html","الطويل"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[567,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"]],"verses":[["وَفي دَولَةِ الأَفغانِ كانَت شُهورُهُ","وَأَيّامُهُ بِالسَعدِ وَاليُمنِ تُزهِرُ",0,"ر",1,0],["وفي دعواتٍ للإله رفعتَها","تُسَّدُ منها للإجابة أَسهُمُ",1,"م",1,0],["وفي دقاق الجماد عرك","يتّهم الحسّ بالخطاء",2,"ا",2,0],["وفي دون ما نلقاهُ من ألم الهوى","تُشقُّ جيوبٌ بل تشقُّ قلوبُ",3,"ب",1,0],["وفي دعوتي عَقرٌ أليمٌ مضيضُهُ","أبا جعفرٍ لو كنت تألم من عَقرِ",4,"ر",1,0],["وَفي داري بُخارِيٌّ وَخَيشٌ","أُعِدّا لِلمَصيفِ وَلِلشِتاءِ",5,"ا",2,0],["وفي دمنا يجري به متواصلا","مع النفس الجاري وينساب مرهفا",6,"ف",2,0],["وَفي دينِكُم مِن رَبٍ مَريمَ آيةٌ","مُنَبِّئَةٌ بِالعَبدِ عِيسىاِبنِ مَريمِ",7,"م",1,1],["وفي دَارِ الْوِلايَةِ أَيُّ نَهْبٍ","فَلَيْتَكَ لَوْ نَهَبْتَ النَّاهِبِينا",8,"ن",2,0],["وَفِي دَاخِلٍ رَوْضٌ يُغَازِلُ بِالحِلَى","وَفِي خَارِجٍ رَوْضٌ يُرَاسِلُ بِالنَّدِّ",9,"د",1,0],["وفي دست الرسالة قمت فردا","لكل الانبياء هو الامام",10,"م",1,0],["وفي دركات ابواب التجلي","جنود سائقون الى العقود",11,"د",1,0],["وفي دار قسيس القرية ليلة","تقضى وفي حضن الصريح مقيل",12,"ل",1,0],["وفي دِفَاعٍ عن الغَرَّاءِ رَائِمَهَا","خَسفاً وضَيفاً بِصُولاتِ البراهين ِ",13,"ن",1,0],["وفي دون ما لاقيتُ للمرء زاجرٌ","ولكنَّ عِرْقى في الوفاء قديمُ",14,"م",1,0],["وفي دار بَكْرٍ لها رجفةٌ","أزالت صياصِيَها والحصونا",15,"ن",2,0],["وفي دعا يخرق السبع الطباق به","إلى الإِله فيرضاه ويقبَلُهُ",16,"ل",2,0],["وفي دينكم ان الالوهة صنعنا","وان البرايا جاعلوا ربهم جعلا",17,"ل",2,0],["وَفي درّهِ المنثورِ سلمان قائلٌ","همُ بعدُ لم يأتوا فَخُسراً لهم خسرا",18,"ر",2,0],["وفي داراتهم كان التنادى","إلى الصبوات في الشط الرغاب",19,"ب",1,0],["وفي (دير النَّجاة) غداة كنّا","تَكَبَّلَ بِالهوى السدمُ المشوق",20,"ق",1,0],["وفي دعوة مسموعة مستجابة","عسى اللَه أن يغسل بها دنس العبد",21,"د",1,0],["وَفي دَولة الحُسن الَّذي أَنتَ لَم تَزَل","بِأَعوانها دَوماً تعزُّ وَتنصرُ",22,"ر",1,0],["وفي دار السلام تركت قومي","وما أنا من هواهم بالسَّليم",23,"م",1,0],["وفي دست القضا يقضي بحكمٍ","على الحق الصريح لهُ اطلاعُ",24,"ع",1,0],["وفي دَستهِ يومَ الرضا البدرُ ضاحكاً","إلى وفده والعارضُ المتهلِّلُ",25,"ل",1,0],["وفي دارها بالروضتيْن لناظرٍ","شفائفُ ضوءِ البدرِ تكفُره السحب",26,"ب",1,0],["وفي دسْتِ العُلى بحرٌ خِضَمٌّ","تُقِرُّ له السَّحائِبُ والعُلومُ",27,"م",1,0],["وفي دين الهدى حدثت امور","بها للدِّين حزن واغتِمام",28,"م",1,0],["وفي دون ما بلغته بل رأيته","بلاغ ولكن لا أرى عنك مذهبا",29,"ب",2,0],["وفي دارِ الأُلى كانوا","وبادوا نحن سُكّانُ",30,"ن",1,0],["وفي دارِكَ لا زالَتْ","عن الأسواءِ في سُتْرَهْ",31,"ر",2,0]]}