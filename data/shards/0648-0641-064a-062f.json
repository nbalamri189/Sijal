ويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136381",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4728,"الهلامة والصتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=176970",""],[4755,"فِي كُلِّ شِبرٍ داخِلِي رَكعَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194499",""],[4578,"تذكرت شرقيّ الحمى من أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49354",""],[4888,"عشرون عاما من العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=207743",""],[4935,"اتيت أخا التقى لجناب رب","https://www.poetsgate.com/ViewPoem.aspx?id=129517",""],[4978,"رد مشاكس","https://www.poetsgate.com/ViewPoem.aspx?id=177202",""],[5054,"وجهتُ وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=213639",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5376,"لنا قدسٌ وشامُ","https://www.poetsgate.com/ViewPoem.aspx?id=188266",""],[5431,"وطن الأكفان ...","https://www.poetsgate.com/ViewPoem.aspx?id=198867",""],[5616,"الصقر","https://www.poetsgate.com/ViewPoem.aspx?id=205772",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5751,"مرسوم كوني بنرجسية شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214785",""],[5923,"سَأَم الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=162750",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5977,"لا أحد يشبهني","https://www.poetsgate.com/ViewPoem.aspx?id=213295",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""]],"verses":[["وَفي دَولَةِ الأَفغانِ كانَت شُهورُهُ","وَأَيّامُهُ بِالسَعدِ وَاليُمنِ تُزهِرُ",0,"ر",1,0],["وفي دعواتٍ للإله رفعتَها","تُسَّدُ منها للإجابة أَسهُمُ",1,"م",1,0],["وفي دقاق الجماد عرك","يتّهم الحسّ بالخطاء",2,"ا",2,0],["وفي دون ما نلقاهُ من ألم الهوى","تُشقُّ جيوبٌ بل تشقُّ قلوبُ",3,"ب",1,0],["وفي دعوتي عَقرٌ أليمٌ مضيضُهُ","أبا جعفرٍ لو كنت تألم من عَقرِ",4,"ر",1,0],["وَفي داري بُخارِيٌّ وَخَيشٌ","أُعِدّا لِلمَصيفِ وَلِلشِتاءِ",5,"ا",2,0],["وفي دمنا يجري به متواصلا","مع النفس الجاري وينساب مرهفا",6,"ف",2,0],["وَفي دينِكُم مِن رَبٍ مَريمَ آيةٌ","مُنَبِّئَةٌ بِالعَبدِ عِيسىاِبنِ مَريمِ",7,"م",1,1],["وفي دَارِ الْوِلايَةِ أَيُّ نَهْبٍ","فَلَيْتَكَ لَوْ نَهَبْتَ النَّاهِبِينا",8,"ن",2,0],["وَفِي دَاخِلٍ رَوْضٌ يُغَازِلُ بِالحِلَى","وَفِي خَارِجٍ رَوْضٌ يُرَاسِلُ بِالنَّدِّ",9,"د",1,0],["وفي دولة التعطيل مرعى ونضرة","وفي دولة الدين الديار البلاقع",10,"ع",1,0],["وفي دست الرسالة قمت فردا","لكل الانبياء هو الامام",11,"م",1,0],["وفي دركات ابواب التجلي","جنود سائقون الى العقود",12,"د",1,0],["وفي دار قسيس القرية ليلة","تقضى وفي حضن الصريح مقيل",13,"ل",1,0],["وفي دِفَاعٍ عن الغَرَّاءِ رَائِمَهَا","خَسفاً وضَيفاً بِصُولاتِ البراهين ِ",14,"ن",1,0],["وفي دون ما لاقيتُ للمرء زاجرٌ","ولكنَّ عِرْقى في الوفاء قديمُ",15,"م",1,0],["وفي دار بَكْرٍ لها رجفةٌ","أزالت صياصِيَها والحصونا",16,"ن",2,0],["وفي دعا يخرق السبع الطباق به","إلى الإِله فيرضاه ويقبَلُهُ",17,"ل",2,0],["وفي دينكم ان الالوهة صنعنا","وان البرايا جاعلوا ربهم جعلا",18,"ل",2,0],["وَفي درّهِ المنثورِ سلمان قائلٌ","همُ بعدُ لم يأتوا فَخُسراً لهم خسرا",19,"ر",2,0],["وفي داراتهم كان التنادى","إلى الصبوات في الشط الرغاب",20,"ب",1,0],["وفي (دير النَّجاة) غداة كنّا","تَكَبَّلَ بِالهوى السدمُ المشوق",21,"ق",1,0],["وفي دعوة مسموعة مستجابة","عسى اللَه أن يغسل بها دنس العبد",22,"د",1,0],["وَفي دَولة الحُسن الَّذي أَنتَ لَم تَزَل","بِأَعوانها دَوماً تعزُّ وَتنصرُ",23,"ر",1,0],["وفي دار السلام تركت قومي","وما أنا من هواهم بالسَّليم",24,"م",1,0],["وفي دست القضا يقضي بحكمٍ","على الحق الصريح لهُ اطلاعُ",25,"ع",1,0],["وفي دَستهِ يومَ الرضا البدرُ ضاحكاً","إلى وفده والعارضُ المتهلِّلُ",26,"ل",1,0],["وفي دارها بالروضتيْن لناظرٍ","شفائفُ ضوءِ البدرِ تكفُره السحب",27,"ب",1,0],["وفي دسْتِ العُلى بحرٌ خِضَمٌّ","تُقِرُّ له السَّحائِبُ والعُلومُ",28,"م",1,0],["وفي دين الهدى حدثت امور","بها للدِّين حزن واغتِمام",29,"م",1,0],["وفي دون ما بلغته بل رأيته","بلاغ ولكن لا أرى عنك مذهبا",30,"ب",2,0],["وفي دارِ الأُلى كانوا","وبادوا نحن سُكّانُ",31,"ن",1,0],["وفي دارِكَ لا زالَتْ","عن الأسواءِ في سُتْرَهْ",32,"ر",2,0],["وفي دور الأفلاك أكبر آية","لمن لاح في أفق الرشاد له برق",33,"ق",1,0],["وفي دمشق كرام يهتفون به","فيسكرون وشعري خمرة العرب",34,"ب",1,0],["وَفي دَولة الصَدر المعظم قَد سَما","كَما رامَ فَوقَ النيِّرين بِذا السَبب",35,"ب",1,0],["وَفي دَولة اِسماعيل نالَت مِن العُلا","ثَناءً بِتَوفيق لِخَير المَقاصد",36,"د",1,0],["وَفي دَولة اِسماعيل أَشرَق نُورُه","وَجاءَ بِحَمد اللَه في غاية النَظم",37,"م",1,0],["وَفي دَولة إسماعيل حازَ بِفَضله","وَفطنته في مَصر بَعض المَآرب",38,"ب",1,0],["وفي دمي كل يوم حقُّ ذي أدب","أفي به ومواثيقٌ لمؤتمن",39,"ن",1,0],["وفي دهامٍ وفي صبحانَ فائدة","لا عُسْرةٌ عندها تُخشَى ولا عَدَم",40,"م",1,0],["وفي داخلي سجني كلانا مغامرٌ","وحائطُنا المُبتلُّ بالوقتِ مُذنبُ",41,"ب",1,0],["وَفي دونِ ما أَلقاهُ مِن أَلَمِ الهَوى","تَشُقُّ قُلوبٌ لا تَشُقُّ جُيوب",42,"ب",1,1],["وفي دون ما لاقوه يا رب مقنع","فمحنتهم ليست بضربة لازب",43,"ب",1,0],["وفي درجات القرب أسرار حكمة","تشير لفعل الاسم في الرتبية",44,"ه",1,0],["وَفي درءِ تلك الفتنة اِختَصَّ وَحده","وَلَولاه لارتدت جَميع القَبائل",45,"ل",1,0],["وفي ديار بني نبهان من سَمدِ","حلّوا بكل طويل الباع صَنتيتِ",46,"ت",1,0],["وفي دفاترِه سجَّلتُ عاطفتي","حتى أُلقِّنَ حبَّ الأرزِ أَحفادي",47,"ي",1,0],["وَفي دَيرِ مُرّانَ خَمّارَةٌ","مِنَ الرومِ في يَومِ شَعنينِها",48,"ه",2,1],["وفى دوحها للمستقبل بظلها","مراتع غرلان من الروم والترك",49,"ك",1,0],["وفي دعائكَ بالأشجارِ حيث أتت","تمشي بأمرك في أغصانها الذلل",50,"ل",1,0],["وفي دار العلوم حنين ثكلى","يرجعه نشيد المرثيات",51,"ت",1,0],["وفي دبر أم الزوج عمداً فما به","جناحٌ ولو أبصرته يتفتح",52,"ح",1,0],["وفي دواك رب خاب الامل","وبطل الرجاء والتوكل",53,"ل",1,0],["وفي دول التعاون كنت ركنا","لدعم تعاون العرب المثالي",54,"ل",2,0],["وفي درسك الميمون اعدل شاهد","على سرك المخزون في كل مشهد",55,"د",1,0],["وفي دمشق قال لي مثله","في مرة أخرى على سرِّي",56,"ر",2,0],["وفي دمك المطلول خاضوا كما ترى","فقلت له دعهم يخوضوا ويلعبوا",5