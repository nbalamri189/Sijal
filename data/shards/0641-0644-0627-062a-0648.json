{"poems":[[44,"ما ولدت أمي من القوم عاجزا","https://www.aldiwan.net/poem50408.html","الطويل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[29,"أدار الجميع الصالحين بذي السدر","https://www.aldiwan.net/poem5770.html","الطويل"],[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[53,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[53,"سيشكر رب الناس ما قد فعلته","https://www.aldiwan.net/poem62975.html","الطويل"],[31,"أتغضب قيس أن هجوت ابن مسمع","https://www.aldiwan.net/poem6036.html","الطويل"],[51,"ألست ترى للدهر نقضا وإبراما","https://www.aldiwan.net/poem63108.html","البسيط"],[68,"طغى اليراع لبسطي في العنان له","https://www.aldiwan.net/poem38694.html","الطويل"],[48,"إذا ما مضى نفس فإحسبنه","https://www.aldiwan.net/poem22274.html","المتقارب"],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[92,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[53,"أسالمُ قد سلمتَ من العيوب","https://www.poetsgate.com/ViewPoem.aspx?id=27041",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[111,"عش ما تشاء وراقب فجعة الأجل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545631",""],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[454,"لم تغن عن هفوات النفس آداب","https://www.aldiwan.net/poem980.html",""],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[541,"جبت لما أسرى الإله بعبده","https://www.aldiwan.net/poem23853.html","الطويل"],[556,"ظننتم محل الأمر فيكم وعندكم","https://www.aldiwan.net/poem47807.html","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59740","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62664","الطويل"],[1114,"","https://poetry.dctabudhabi.ae/diwan/poem/124085","الوافر"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146087","المتقارب"],[1974,"","https://poetry.dctabudhabi.ae/diwan/poem/199430","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10507","الطويل"],[2294,"","https://poetry.dctabudhabi.ae/diwan/poem/21144","الطويل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115071","الطويل"],[2612,"","https://poetry.dctabudhabi.ae/diwan/poem/31524","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115584","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91362","السريع"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4767,"قوافي الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=181926",""],[4929,"لون الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=199429",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5191,"الحُمق","https://www.poetsgate.com/ViewPoem.aspx?id=211971",""],[5344,"من دروس المعاميل حصه..","https://www.poetsgate.com/ViewPoem.aspx?id=180708",""]],"verses":[["فَلا توعِدوني بِالفَخَارِ فَإِنَّني","سَأَحمِلُكُم مِنّي عَلى مركِبٍ صَعبِ",0,"ب",1,0],["فَلا توعِدَنّي بِالفَخارِ فَإِنَّني","بَنى اللَهِ بَيتي في الدَخيسِ العَرَمرَمِ",1,"م",1,0],["فَلا توبِسوا بَيني وَبَينَكُمُ الثَرى","فَإِنَّ الَّذي بَيني وَبَينَكُمُ مُثري",2,"ر",2,0],["فَلا تَؤولُ إِذا يَؤولُ وَلا","تَقرُبُ مِنهُ إِذا هُوَ اِقتَرَبا",3,"ب",2,0],["فلا تُوسِعْ له في جيب درعي","فقد تؤتىَ الحصونُ من النقوبِ",4,"ب",1,0],["فلا تُولني البتراءَ منك فإنما","وليُّ اليد البتراء من هو أبتر",5,"ر",1,0],["فَلا توعِدونا بِاللِقاءِ وَأَبرِزوا","إِلَينا سَواداً نَلقَهُ بِسَوادِ",6,"د",1,0],["فَلا توطِنِ الدُنيا مَحَلّاً فَإِنَّما","مُقامُكَ فيها لا أَبا لَكَ أَيّاما",7,"م",2,0],["فَلا تُؤاخِذ بِطُغيانِ اليَراعِ إِذا","جَرى عَلَيَّ فَلِلأَقلامِ طُغيانُ",8,"ن",1,0],["فَلا تودِ أَنفُسَنا حَسبُنا","قَضاءٌ لَهُ بِأَذانا لَهَج",9,"ج",1,0],["فلا توحشونا من معالي اصولكم","وطبع فروع الاصل صدق انجذابها",10,"ب",3,0],["فلا توحدوه إنه يستمدكم","بأنفاسه تياره المتتالع",11,"ع",1,0],["فلا تُوسِعْ له في جيب درعي","فقد تؤتَى الدروعُ من الجيوبِ",12,"ب",1,0],["فلا تُوقع بحرماني اعتذاراً","فإن نداك للمحروم جَدُّ",13,"د",1,0],["فلا تؤسس صبراً غير معتقر","ولا ندافع صبراً غير معتقل",14,"ل",1,0],["فلا تَواَضعَ قَدرٌ أَنتَ رافِعهُ","وَلا تَرْفَّعَ قَدْرٌ أَنتَ واضِعُهُ",15,"ع",2,0],["فلا تؤاخذ محبا ما تعمد في","لفظ يسيء وللزلات أسباب",16,"ب",1,0],["فلا تؤاخذ بفتىً صددته","عن نسكه عقوبةً وما جنى",17,"ن",2,0],["فَلا توعِدوهُ وَاِقبَلوا ما أَتاكُمُ","بِهِ مِن رِسالاتٍ مَتى توحَ تُدرَسِ",18,"س",1,0],["فَلا تولعوا مِن بعدها بطماعةٍ","ففيما مضى عن مثل ذلك زاجرُ",19,"ر",1,0],["فلا تؤاخذنا بأفعالنا","يا من توكلنا على لطفه",20,"ف",2,0],["فلا توبة تكفي بغير تخلصٍ","وإن معدماً ينوي إلى حالةِ اليسرِ",21,"ر",1,0],["فلا تول النصيحة من ذكاه","محك للذكى من الغبي",22,"ي",1,0],["فلا توحش المهرجان الذي","بنظمي يرى السامعين العجب",23,"ب",1,0],["فلا توجت من بعد بعدك راحة","براح ولا حنّت عليها المزامر",24,"ر",1,0],["فَلا توعِدَنّي بِالفِجارِ فَإِنَّهُ","أَحَلَّ بِبَطحاءِ الحُجونِ المَحارِما",25,"م",2,1],["فَلا توعِداني بِالسِلاحِ فَإِنَّما","جَمَعتُ سِلاحي رَهبَةَ الحَدَثانِ",26,"ن",1,0],["فلا تُودِعَنَّ الدهرَ سِرَّكَ أحمقاً","فانَّكَ ان أودَعتَهُ منهُ أحمَقُ",27,"ق",1,0],["فَلا توعِدونا بِالجِيادِ فَإِنَّنا","لَكُم مُضغَةٌ ما لُجلِجَت فَأَمَرَّتِ",28,"ت",1,0],["فلا تولوهُ تعنيفاً ولوماً","فما تدرون أسرارَ الصدور",29,"ر",1,0],["فلا تُوعدونا بالسيوفِ جَهالةً","فيضنَى مُحبٌّ أوْ يموتَ مَشوقُ",30,"ق",1,0],["فلا تؤاخذ هائِماً في الهَوى","إمّا ينل فَضلاً وإلا اختلس",31,"س",1,0],["فلا تؤمل لي اذا من توبة","فترك ذا من شيم المرتد",32,"د",1,0],["فلا توصد الباب عن طارقٍ","وما في الفؤاد له فافصح",33,"ح",1,0],["فلا تُوْهِمَنَّكِ رَغْوَةُ أَمسِي","بأن شبابيَ قيدُ انحدار",34,"ر",1,0],["فَلا تُوقِظِ الْمَسْعُورَ وَحْشاً سُلُوكهُ","وَقُمْ واشْعُرِ الإِنْسَانَ فِيكَ لِتَقْنَعَا",35,"ع",2,0],["فلا توجس من الأقوال خوفا","فإنّ الحمقَ، رغم الهولِ، حمقُ!",36,"ق",1,0],["فلا توصَلَك شرهه بعدما تفننت","او اترك المجلاس للي يرصه..",37,"ص",2,0]]}