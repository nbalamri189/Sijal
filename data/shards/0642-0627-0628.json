 دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[5956,"الحمد للقيوم","https://www.poetsgate.com/ViewPoem.aspx?id=194015",""],[5956,"مناضلٌ هاجم العدوانُ شوكتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194194",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[5956,"ذكرى وفاة زهرة الشمعة","https://www.poetsgate.com/ViewPoem.aspx?id=215786",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6102,"غُربَةُ الزَّمَكان!","https://www.poetsgate.com/ViewPoem.aspx?id=186283",""],[6125,"قَابَ قَوسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=210207",""],[6141,"رفاتي","https://www.poetsgate.com/ViewPoem.aspx?id=213094",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[6317,"هذي الرّبوع بوجهها الخلّاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86084&r=&rc=0",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""],[6341,"مداي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87282&r=&rc=11",""],[6360,"صَهيلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87606&r=&rc=9",""]],"verses":[["قابَلْتُ سيّئَ ما أتَوْا بجَميلِ ما","آتي فإنّي بالمكارِمِ أجْدَرُ",0,"ر",1,0],["قابَلْتُ منْ وجْهِ ابْنِ نَصْرٍ قِبْلَةً","فلَها رُكوعي دائِماً وسُجودي",1,"ي",1,0],["قابَلْتَ شهْرَ الصّومِ منْكَ بما بهِ","ينْهَلُّ منْ فَضْلِ الإلاهِ مَزيدُهُ",2,"د",2,0],["قابلها والحب قد شفه","وقابلت طلعة بدر السما",3,"م",2,0],["قابلت في الكاس وجنته","فسقانيها على الثلث",4,"ث",1,0],["قابلت شعرك بعد الوجه ملتفتاً","فأنعمَ الله إمسائي وإصباحي",5,"ح",2,0],["قابلت رونقَ خدِّه","فصبغت دمعي أحمرا",6,"ر",2,0],["قابيلُ يا جَدَّ الوَرى نَم هانِئً","كُلُّ اِمرِئٍ في ثَوبِهِ قَبيلُ",7,"ل",1,0],["قابلتها مقبِّلا","لليد منها والفم",8,"م",1,0],["قابَلتُهُ بِسُعودِ وَجهِكَ وَالسَنا","فَاِزدادَ مِن يُمنٍ وَمِن إِشراقِ",9,"ق",1,0],["قابِضاً كَفَّهُ اليَمينَ عَلى الدُن","يا وَلَو شاءَ حازَها بِالشِمالِ",10,"ل",1,0],["قَابَلَتْنِي بمثلِ خدِّكَ والثَّغ","رِ وأنوارِ حَلْيِكَ المُستنيرِ",11,"ر",1,0],["قابَلَتنا فَسَجَدنا هَيبَةً","لِمُحَيّاها وَعَفَّرنا الجِباها",12,"ا",3,0],["قابلكَ العامُ الذي تشتهي","فابقَ من بعده ألفَ عام",13,"م",1,0],["قابضُ شيءٍ برضى مالكِهِ","ويضمنُ القيمةَ والمثلَ معا",14,"ع",2,0],["قابَلنَ جَمعَها إِلَيهِ كَما جَمَّ","عَ أَتباعَهُ إِلَيهِ الوَحِيُّ",15,"ي",1,0],["قابلته في فروق لَيلَةً وَلَقَد","رأَيت فيه أديباً كله طرف",16,"ف",1,0],["قابلتِ حكمهمو علي","كِ بكلِّ بشرٍ وارتياح",17,"ح",1,0],["قابلت شهر الصوم منك بما به","ينهل من فضل الآلاء مزيده",18,"د",2,0],["قابيل، يا جدّ الورى ، نم هانئا","كلّ امرىء في ثوبه قابيل",19,"ل",1,0],["قابعٌ في كِسرِ بَيتٍ","قَدْ أَظَلَّتْه الغُرُوسُ",20,"س",1,0],["قابل بسيفك أعدائي وقد لهم","حبل المآرب واطرحهم على الوجل",21,"ل",1,0],["قابلت تلك خمسة بخمسة","فخمستي ضاعت ببحر العظمه",22,"م",2,0],["قابِل بِرَأفَتِكَ اِعتِذارَ مُساوِرِ","إِنَّ المَعاذِرَ لِلذُنوبِ حَصادُ",23,"د",1,0],["قابَلتَها إِذ أُنشِدَت بِرِضاً","وَعَقَقتَها فَوَقَعتَ عَن خبرِ",24,"ر",1,0],["قابَ نارٍ في أقانيم الجوى","قدّني بعدٌ تجنّى وقَسا",25,"س",2,0],["قابَلتُها فَرَدَدَتُ طَرفي بَعدَما","طَفَحَت عَليّ شُؤون دَمعي المُرسَلِ",26,"ل",1,0],["قابلت وجهها بوجهي فلاحتْ","صفرتي فيهِ فاكتسى من سماتي",27,"ي",1,1],["قابلته بالعز والتعظيم ثم","فتحته وقرأته متشرفا",28,"ف",2,0],["قابَلَه وجهُ إمام الهدى","فلاح فيه قمر السَّعْد",29,"د",1,0],["قابِلٍ حُكمي عَلى كَث","رَةِ سومي وَاِشتِطاطي",30,"ط",2,0],["قابَلتُ فَيضَ الدَمعِ لَيلَةَ زُرتُهُ","بِمُوَرَّدٍ مِن خَدِّهِ فَتَوَرَّدا",31,"د",2,0],["قَابِلْ ضَرُورَتَهُ بِمُمْكِنِ طِبِّكُمْ","فَدَوَامُ ذَلِكَ مُطْلِقٌ شَكْوَاهَا",32,"ا",3,0],["قابلت بالساقي السماء فاطلعت","بدراً على كأنها مرآت",33,"ت",1,0],["قابلتنا أيدي الربيع بوجه","حسن فيه للمحاسن شاهد",34,"د",1,1],["قَابلْتُ نُعْماكَ بالسجودِ","للّهِ مِنْ عَطْفَةٍ وجُودِ",35,"د",1,1],["قَابلْتُ مِنها رَوْضَةً أَدبيَّةً","قَبَّلْتُ مِنها كُلَّ حُسْنٍ يُعْشَقُ",36,"ق",1,1],["قابلت طولك يا بَليد بطولها","بَل لَيسَ مَوضوع هُناكَ فَيعكسا",37,"س",2,0],["قابَلته يَوماً فقَبّلته","وَرضت مِنهُ المَركب الصعبا",38,"ب",2,1],["قابلَني حتّى بدَتْ أَدمُعي","في خَدِّه المصقولِ مِثْلَ المِراه",39,"ا",2,0],["قابلتُها يوماً على درب الأسى","تُلقي على باب الأنين رِحالها",40,"ل",3,0],["قابلت دُرَّكَ بالحصى","عذراً فنثرك فوق نظمي",41,"م",2,0],["قابلته بالحصا فاقبله مغتفراً","وقل عفا اللّه عما جاء من ولدي",42,"د",2,0],["قابَلْتُ أحداثَ النحوس بسَعْدِهِ","فأَعادَ هاتيك النحوس سعودا",43,"د",2,0],["قابلتهم بجنود أمطَرَتْ بدمٍ","كما يصوب مصاب المزن بالمطر",44,"ر",1,0],["قابلت أفعالاً له بمثلها","ولا يلين جانبي إذا قسا",45,"ا",1,0],["قابلني ليلة قبّلتهُ","ظبي من الشمس غدا أملحا",46,"ح",2,1],["قابِضَ رِجلٍ وَباسِطَ أُخرى","وَالسَيفُ أُقدِمُهُ أَمامَه",47,"م",2,0],["قابلْ به الفطرَ خيرَ آت","يلقاك ثوباهما وتالي",48,"ل",2,0],["قابلْ به عاماً ترنَّقَ إنه","متضاعِفٌ لك خيرُه في القابلِ",49,"ل",1,0],["قابض كفِّ البسط","لا يرفع رأساً من خجل",50,"ل",1,0],["قابضاً باسطاً معزاً مذلاً","نافذ العزم ثاقب الآراء",51,"ا",2,0],["قابلت محراب الصلاة وللهدى","قبس على قسمات وجهك باد",52,"د",1,0],["قابلته بجبين وجه ساهم","شوقاً إليك ولحظ طرف ساهر",53,"ر",1,0],["قابلتُهُ فإذا غُلامٌ أمرَدٌ","وخَبَرتُهُ فإذا بشيخٍ أكمَلِ",54,"ل",1,0],["قابلتُهُ خاشِعَ الأبصار مُبتسمِاً","فصَدَّ عنّي دَلالاً غيرَ مُبتسِمِ",55,"م",1,0],["قابلتُهُ فنَظَرتُ شخصاً رَيثَما","جالستُهُ فإذا ببحرٍ مُزبِدِ",56,"د",1,0],["قابلْتَ ناقِصَ شُكْرِنَا","بنَدىً على المقْدَارِ زَائِدْ",57,"د",1,0],["قابَلَهم دوني على أَنَّهم","ما فيهمُ من أَنال منّي مُنَاه",58,"ا",2,0],["قَابلْتُ عِزَّ هَواكُمُ بِتَذلُّلٍ","مَعْ أَنَّني في ذَاكَ لَسْتُ بِأَوَّلِ",59,"ل",1,1],["قابَلتُ مرآةَ بِشرٍ مِن خَلائِقِهِ","صفَت فطالعتُ فيها وَجه إِقبالي",60,"ل",2,0],["قابلتُ بِاللَومِ زَجراً حينَ قُلتُ لَهُ","وَسّعتَ فكري أو ضَيَّقتَ أَنفاسي",61,"س",2,0],["قابل شَياطين العدى","لتصيبهم بِالنجم رجما",62,"م",2,0],["قابض سمت وعنايا","ما في الفريق يْخوت",63,"ت",1,0],["قابَلتُهُ بِالحَمدِ وَالتّفخيمِ","تَأدِيَةً لِحَقِّه الفَخيمِ",64,"م",1,0],["قابَلَتْهُ عَلى السّرورِ فَقالَت","مَرحَباً مَرحَباً وأهلاً وسهلا",65,"ل",2,0],["قابِضُ الرَونَقِ فيها ماتِحٌ","يَخطِفُ الأَبصارَ مِنها يُستَشَف",66,"ف",1,0],["قابل ذئباً نائِماً في الغيطِ","بَينَ قناية وَبَينَ خَطِّ",67,"ط",1,0],["قابلَه فَحل مِن الغَزالِ","فَشَكَّهُ بِمفرد النبال",68,"ل",1,0],["قابله أَبوه وَهوَ يعطفُ","في مَشيه قالَ وَكَم لا تَعرف",69,"ف",1,0],["قابلتا بَعضهما بِسُرعه","بَينَهُما ما حالَ إِلّا ترعَه",70,"ه",1,0],["قابلني أَخوكَ مثل الجنّي","وَأَخذ الأَرنَب غَصباً مِنّي",71,"ي",1,0],["قابَلَها البَعلُ وَقالَ روحي","قَد قارَبَت تَخرج مِنك روحي",72,"ي",1,0],["قابَلَهُ في سَيرِهِ سَيلُ الجَبَل","فَخافَ مِنهُ مُذ رَآه وَاِختَبَل",73,"ل",1,0],["قابَلَني أَرنَب مَليحٌ","مِن أَكل لَحم الدَجاج أَطرب",74,"ب",1,0],["قابَلنا بِغايَة التَرحيبِ","مَن بِهِ مِن بَعيدٍ أَو قَريبِ",75,"ب",1,0],["قابَلتُ بِالصَّبرِ جَميعَ ذلِك","مُحتَسِباً رِضى الإِله المالِكِ",75,"ك",1,0],["قابَلني بِغايَة اِرتِياحِ","أَطالَ في المَجلِس باِنشراحِ",75,"ح",1,0],["قابلَ مرآتَهُ فقلتُ له:","مولاي عَوِّذْ ما أنتَ رائيه",76,"ي",2,0],["قابِلي الحُسنى بِعَطفٍ","هكَذا تَقضي المَحَبَّهْ",77,"ب",2,0],["قابلونا بوجوهٍ","وفروعٍ فاندَهَشنا",78,"ن",2,0],["قَابِلِ الصَّبَّ بِبِشْرٍ","فَعَسَى يَصْرِفُ حُزْنَهْ",79,"ن",2,0],["قَابلتَ يَا بَدْر ضِيَا خَدّهِ","وَالبَدْر إنْ وَافَى القِرَانَ انْمَحَقْ",80,"ق",1,0],["قَابل النورُ ظُلمةَ الحَلَكِ","بصبَاحٍ منير",81,"ر",1,1],["قَابَل الصُّبْحُ الدُّجَى فَانْهَزمَا","ومحا بالسَّيْفِ أفْق الغَلَسِ",82,"س",1,1],["قَابَلْتُ وِجْهَةَ قِبْلَةٍ قُبَّلْتُهَا","فَظَفِرْتُ بِالتَّقْبِيل وَالإقْبَالِ",83,"ل",1,0],["قابلتهُ في دستهِ فكأنّهُ","قَمرٌ منيرٌ في النوادي منتدِ",84,"د",1,0],["قابلت نعيك من ربوع الشام","بنواظر عبري وقلب دام",85,"م",1,1]