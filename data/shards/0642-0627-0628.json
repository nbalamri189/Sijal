{"poems":[[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[77,"إن كان يسقي الأرض جود غمامة","https://www.aldiwan.net/poem36593.html","الكامل"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[88,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[72,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"يا قلب أنت ومقلتي","https://www.aldiwan.net/poem18742.html","مجزوء الكامل"],[91,"كم قبل هذا الجل ولى جيل","https://www.aldiwan.net/poem9063.html","عموديه"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[43,"صلة الهجر لي وهجر الوصال","https://www.aldiwan.net/poem10110.html","الخفيف"],[61,"لو تداركتني بوعد غرور","https://www.aldiwan.net/poem51615.html","الخفيف"],[66,"أنف الخمار من فرط خباها","https://www.aldiwan.net/poem39074.html","الرمل"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[69,"رأيت في الفقه سؤالا حسنا","https://www.aldiwan.net/poem28410.html","الرجز"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[86,"يارَئيسَ الشِّعرِ قُل لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13059&r=&rc=14",""],[113,"يا سيدي يا علي المرتضى مدداً","https://www.aldiwan.net/poem41782.html","البسيط"],[113,"لي غربة وذلة وقلة","https://www.aldiwan.net/poem41999.html","الرجز"],[141,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[167,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[176,"لعل وعسى","https://www.aldiwan.net/poem50717.html","الرمل"],[180,"علل حشاي بذكر ذاك المنزل","https://www.aldiwan.net/poem67041.html","الكامل"],[197,"قابلت وجهها بوجهي فلاحت","https://www.aldiwan.net/poem45181.html","الخفيف"],[204,"أهدي لذي المجد الرفيع وذي الصفا","https://www.aldiwan.net/poem921.html",""],[227,"ومجلس قد حاز من حسنه","https://www.aldiwan.net/poem51176.html","السريع"],[233,"يا علي يومنا أو","https://www.aldiwan.net/poem31893.html","مجزوء الرمل"],[233,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[235,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[240,"واهاً عل عيش مضت سنواته","https://www.aldiwan.net/poem1339.html",""],[259,"قابلتنا أيدي الربيع بوجه","https://www.aldiwan.net/poem38331.html","الخفيف"],[273,"قابلت نعماك بالسجود","https://www.aldiwan.net/poem25581.html","مخلع البسيط"],[346,"قابلت منها روضة أدبية","https://www.aldiwan.net/poem20627.html","الكامل"],[351,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[351,"قابلته يوما فقبلته","https://www.aldiwan.net/poem40577.html","السريع"],[362,"ما أنس لا أنس له موقفا","https://www.aldiwan.net/poem60583.html","السريع"],[397,"تشكو الفتاوى","https://www.aldiwan.net/poem6741.html","عموديه"],[400,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[400,"تجد البين فاستأنفت في العدد","https://www.aldiwan.net/poem33979.html","البسيط"],[413,"كم قد ألين لمن قسا بصدوده","https://www.aldiwan.net/poem53923.html","الكامل"],[413,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[434,"قابلني ليلة قبلته","https://www.aldiwan.net/poem2493.html","السريع"],[454,"يا لها نفساً يا لها","https://www.aldiwan.net/poem2173.html","مخلع البسيط"],[456,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[456,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[462,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[513,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[513,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[513,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[560,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[560,"هجرت فبت بمقلة لم ترقد","https://www.aldiwan.net/poem52915.html","الكامل"],[565,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[573,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[584,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["قابَلْتُ سيّئَ ما أتَوْا بجَميلِ ما","آتي فإنّي بالمكارِمِ أجْدَرُ",0,"ر",1,0],["قابَلْتُ منْ وجْهِ ابْنِ نَصْرٍ قِبْلَةً","فلَها رُكوعي دائِماً وسُجودي",1,"ي",1,0],["قابَلْتَ شهْرَ الصّومِ منْكَ بما بهِ","ينْهَلُّ منْ فَضْلِ الإلاهِ مَزيدُهُ",2,"د",2,0],["قابلها والحب قد شفه","وقابلت طلعة بدر السما",3,"م",2,0],["قابلت في الكاس وجنته","فسقانيها على الثلث",4,"ث",1,0],["قابلت شعرك بعد الوجه ملتفتاً","فأنعمَ الله إمسائي وإصباحي",5,"ح",2,0],["قابلت رونقَ خدِّه","فصبغت دمعي أحمرا",6,"ر",2,0],["قابيلُ يا جَدَّ الوَرى نَم هانِئً","كُلُّ اِمرِئٍ في ثَوبِهِ قَبيلُ",7,"ل",1,0],["قابلتها مقبِّلا","لليد منها والفم",8,"م",1,0],["قابَلتُهُ بِسُعودِ وَجهِكَ وَالسَنا","فَاِزدادَ مِن يُمنٍ وَمِن إِشراقِ",9,"ق",1,0],["قابِضاً كَفَّهُ اليَمينَ عَلى الدُن","يا وَلَو شاءَ حازَها بِالشِمالِ",10,"ل",1,0],["قَابَلَتْنِي بمثلِ خدِّكَ والثَّغ","رِ وأنوارِ حَلْيِكَ المُستنيرِ",11,"ر",1,0],["قابَلَتنا فَسَجَدنا هَيبَةً","لِمُحَيّاها وَعَفَّرنا الجِباها",12,"ا",3,0],["قابلكَ العامُ الذي تشتهي","فابقَ من بعده ألفَ عام",13,"م",1,0],["قابضُ شيءٍ برضى مالكِهِ","ويضمنُ القيمةَ والمثلَ معا",14,"ع",2,0],["قابَلنَ جَمعَها إِلَيهِ كَما جَمَّ","عَ أَتباعَهُ إِلَيهِ الوَحِيُّ",15,"ي",1,0],["قابلته في فروق لَيلَةً وَلَقَد","رأَيت فيه أديباً كله طرف",16,"ف",1,0],["قابلتِ حكمهمو علي","كِ بكلِّ بشرٍ وارتياح",17,"ح",1,0],["قابلت شهر الصوم منك بما به","ينهل من فضل الآلاء مزيده",18,"د",2,0],["قابيل، يا جدّ الورى ، نم هانئا","كلّ امرىء في ثوبه قابيل",19,"ل",1,0],["قابعٌ في كِسرِ بَيتٍ","قَدْ أَظَلَّتْه الغُرُوسُ",20,"س",1,0],["قابل بسيفك أعدائي وقد لهم","حبل المآرب واطرحهم على الوجل",21,"ل",1,0],["قابلت تلك خمسة بخمسة","فخمستي ضاعت ببحر العظمه",22,"م",2,0],["قابِل بِرَأفَتِكَ اِعتِذارَ مُساوِرِ","إِنَّ المَعاذِرَ لِلذُنوبِ حَصادُ",23,"د",1,0],["قابَلتَها إِذ أُنشِدَت بِرِضاً","وَعَقَقتَها فَوَقَعتَ عَن خبرِ",24,"ر",1,0],["قابَ نارٍ في أقانيم الجوى","قدّني بعدٌ تجنّى وقَسا",25,"س",2,0],["قابَلتُها فَرَدَدَتُ طَرفي بَعدَما","طَفَحَت عَليّ شُؤون دَمعي المُرسَلِ",26,"ل",1,0],["قابلت وجهها بوجهي فلاحتْ","صفرتي فيهِ فاكتسى من سماتي",27,"ي",1,1],["قابلته بالعز والتعظيم ثم","فتحته وقرأته متشرفا",28,"ف",2,0],["قابَلَه وجهُ إمام الهدى","فلاح فيه قمر السَّعْد",29,"د",1,0],["قابِلٍ حُكمي عَلى كَث","رَةِ سومي وَاِشتِطاطي",30,"ي",1,0],["قابَلتُ فَيضَ الدَمعِ لَيلَةَ زُرتُهُ","بِمُوَرَّدٍ مِن خَدِّهِ فَتَوَرَّدا",31,"د",2,0],["قَابِلْ ضَرُورَتَهُ بِمُمْكِنِ طِبِّكُمْ","فَدَوَامُ ذَلِكَ مُطْلِقٌ شَكْوَاهَا",32,"ا",3,0],["قابلت بالساقي السماء فاطلعت","بدراً على كأنها مرآت",33,"ت",1,0],["قابلتنا أيدي الربيع بوجه","حسن فيه للمحاسن شاهد",34,"د",1,1],["قَابلْتُ نُعْماكَ بالسجودِ","للّهِ مِنْ عَطْفَةٍ وجُودِ",35,"د",1,1],["قَابلْتُ مِنها رَوْضَةً أَدبيَّةً","قَبَّلْتُ مِنها كُلَّ حُسْنٍ يُعْشَقُ",36,"ق",1,1],["قابلت طولك يا بَليد بطولها","بَل لَيسَ مَوضوع هُناكَ فَيعكسا",37,"س",2,0],["قابَلته يَوماً فقَبّلته","وَرضت مِنهُ المَركب الصعبا",38,"ب",2,1],["قابلَني حتّى بدَتْ أَدمُعي","في خَدِّه المصقولِ مِثْلَ المِراه",39,"ا",2,0],["قابلتُها يوماً على درب الأسى","تُلقي على باب الأنين رِحالها",40,"ل",3,0],["قابلت دُرَّكَ بالحصى","عذراً فنثرك فوق نظمي",41,"ي",1,0],["قابلته بالحصا فاقبله مغتفراً","وقل عفا اللّه عما جاء من ولدي",42,"د",2,0],["قابَلْتُ أحداثَ النحوس بسَعْدِهِ","فأَعادَ هاتيك النحوس سعودا",43,"د",2,0],["قابلتهم بجنود أمطَرَتْ بدمٍ","كما يصوب مصاب المزن بالمطر",44,"ر",1,0],["قابلت أفعالاً له بمثلها","ولا يلين جانبي إذا قسا",45,"ا",1,0],["قابلني ليلة قبّلتهُ","ظبي من الشمس غدا أملحا",46,"ح",2,1],["قابِضَ رِجلٍ وَباسِطَ أُخرى","وَالسَيفُ أُقدِمُهُ أَمامَه",47,"م",2,0],["قابلْ به الفطرَ خيرَ آت","يلقاك ثوباهما وتالي",48,"ي",1,0],["قابلْ به عاماً ترنَّقَ إنه","متضاعِفٌ لك خيرُه في القابلِ",49,"ل",1,0],["قابض كفِّ البسط","لا يرفع رأساً من خجل",50,"ل",1,0],["قابضاً باسطاً معزاً مذلاً","نافذ العزم ثاقب الآراء",51,"ا",2,0],["قابلت محراب الصلاة وللهدى","قبس على قسمات وجهك باد",52,"د",1,0],["قابلته بجبين وجه ساهم","شوقاً إليك ولحظ طرف ساهر",53,"ر",1,0],["قابلتُهُ فإذا غُلامٌ أمرَدٌ","وخَبَرتُهُ فإذا بشيخٍ أكمَلِ",54,"ل",1,0],["قابلتُهُ خاشِعَ الأبصار مُبتسمِاً","فصَدَّ عنّي دَلالاً غيرَ مُبتسِمِ",55,"م",1,0],["قابلتُهُ فنَظَرتُ شخصاً رَيثَما","جالستُهُ فإذا ببحرٍ مُزبِدِ",56,"د",1,0],["قابلْتَ ناقِصَ شُكْرِنَا","بنَدىً على المقْدَارِ زَائِدْ",57,"د",1,0],["قابَلَهم دوني على أَنَّهم","ما فيهمُ من أَنال منّي مُنَاه",58,"ا",2,0],["قَابلْتُ عِزَّ هَواكُمُ بِتَذلُّلٍ","مَعْ أَنَّني في ذَاكَ لَسْتُ بِأَوَّلِ",59,"ل",1,1]]}