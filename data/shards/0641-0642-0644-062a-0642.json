{"poems":[[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[68,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[33,"يا صاحبي أقلا اللوم واحتسبا","https://www.aldiwan.net/poem42544.html","البسيط"],[119,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[190,"قالوا نراك بلا أهل ولا ولد","https://www.aldiwan.net/poem43977.html","البسيط"],[275,"أزنبق كفك البيضاء فالعبق","https://www.aldiwan.net/poem35444.html","البسيط"],[302,"لما جنى الطرف ورد وجنته","https://www.aldiwan.net/poem33137.html","المنسرح"],[353,"عاتبته بدر تم","https://www.aldiwan.net/poem19881.html","المجتث"],[358,"رأى المحبوب في جفني كحلا","https://www.aldiwan.net/poem40375.html","الوافر"],[369,"أتيت قاضي الأهواز أطلبه","https://www.aldiwan.net/poem60935.html","المنسرح"],[398,"أتاني البدر باكيا خجلا","https://www.aldiwan.net/poem53536.html","المنسرح"],[411,"قلت له ماذا السواد الذي","https://www.aldiwan.net/poem49770.html","السريع"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[463,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53847","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34458","الوافر"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130192","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38623","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38059","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37721","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77662","الرجز"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59812","المجتث"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202123","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64767","المجتث"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82662","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49623","البسيط"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130678","البسيط"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95131","الرجز"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98602","السريع"],[2581,"","https://poetry.dctabudhabi.ae/diwan/poem/141566","المنسرح"],[3002,"","https://poetry.dctabudhabi.ae/diwan/poem/73568","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132592","السريع"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26969","المجتث"],[3765,"","https://poetry.dctabudhabi.ae/diwan/poem/141087","المتقارب"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99245","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114457","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103017","البسيط"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32448","المنسرح"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78314","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136633",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28672","الوافر"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35428","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[4693,"الشوق عند تمام الود قتال","https://www.poetsgate.com/ViewPoem.aspx?id=53309",""],[4927,"معلقة أمير الشهداء المعاصرين صَدّام يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=36731",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5621,"السحر المطلق","https://www.poetsgate.com/ViewPoem.aspx?id=24568",""],[5953,"الحمد لله قد أعيا ذوي الحيل","https://www.poetsgate.com/ViewPoem.aspx?id=93812",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""]],"verses":[["فَقُلتُ قابِلني وَراءَ النَهرِ","أَنتَ لِشَطرٍ وَأَنا لِشَطرِ",0,"ر",1,0],["فَقُلتُ قَد صادَ وَرَبِّ الكَعبَه","وَنَحنُ في وادٍ بِقُربِ جَنبَه",0,"ه",1,0],["فَقُلتُ قَد كانَ صَرفُ الدَهرِ أَفسَدَهُ","لَكِنَّهُ بِالمَليكِ الصالِحِ اِنصَلَحا",1,"ح",2,0],["فَقُلتُ قَولاً مُصيبا غَيرَ ذي خَطَلٍ","أَتى بِهِ حُبُّها في فِطنَةِ الفِكَرِ",2,"ر",1,0],["فقلت قولا صادقا","يعرفه رجاله",3,"ل",2,0],["فقلت قول امرىء مستبصر فطن","قد راضه الدهر حتى كاس فاجتهدا",4,"د",2,0],["فقلتُ قطَّرتُ دَمعي كي يبرِّدَها","وإن يجفَّ عليها تقطرُ الحدق",5,"ق",1,0],["فَقُلتُ قد جرتَ يا فديتُك بي","عذَّبتَ قَلبي وطرفيَ الجاني",6,"ي",1,0],["فَقُلْتُ قَدْ غَابَ عَنّي","فَأَيْنَ أَيْنَ يُصِيبُهُ",7,"ب",2,0],["فَقُلت قَضى لِهَجرك نَوم عَيني","وَتِلكَ جُفونها لَبست حدادا",8,"د",2,0],["فقلتُ قاضي القضاةِ أبصِرُه","فقال قاضي القُضاةِ في العِدّه",9,"د",2,0],["فَقُلتُ قُبِّل ترابَهُ عجلاً","وَاِسجُد لَهُ قالَ كلُّ ذا غَرَرُ",10,"ر",1,0],["فقلْتُ قَبِّلْني أجِدْ ريحَها","فقالَ خُذْها قُبلةً غالِيَهْ",11,"ل",3,0],["فَقُلتُ قول امرىء أَضحى لِعُسرَتِهِ","بَينَ البَريَّةِ مِن عَدم كمُجتَنبِ",12,"ب",1,0],["فقلت قد أسلفتُه شِكايةً","لو قد وفى لرقَّ منها ورحمْ",13,"م",1,0],["فقلت قم قال رجلي لا تطاوعني","فقلت خذ قال كفي لا تواتيني",14,"ن",2,0],["فَقُلتُ قَناعَةً منّي لأنّي","رَضيتُ من الأَحِبَّةِ بِاليَسيرِ",15,"ر",1,0],["فقلت قد قلت رجال بها","ما حيلتي ما في السويدا رجال",16,"ل",1,0],["فَقُلت قُتِلتم يا ذَوي العِشقِ وَالهَوى","وَمَن لَم يَمُت بِالسّيفِ ماتَ بِغَيرهِ",17,"ه",1,0],["فَقلتُ قائِلٌ هَذا البيتَ ذو عَتَهٍ","وَالسرُّ في الزّندِ لا في السّيفِ وَالقَلمِ",18,"م",1,0],["فقُلْتُ قَدْ سالَ مِثْل الدُّرِّ مُنتَظِماً","نَظْمَ العُقودِ على ذا الجَمْرِ واللَّهَبِ",19,"ب",1,0],["فَقُلت قَدكَ يا حَبيبي دَعني","إِنَّك مَهما قُلتُ لَم تَسمَعني",20,"ي",1,0],["فقلت قد أخرجته عن ملكي","بطيب نفس وانشراح صدري",21,"ي",1,0],["فقلتُ قولَ مُحب","قد خانه عقدُ صبره",22,"ه",1,0],["فقلت قيامي طاعة وتباعة","لأمرِ وَليِّ الله في الخَلق والأمر",23,"ر",1,0],["فَقُلْتُ قَوْلَ مَرِسٍ ذِي مَحْلِ","لَوْ أَنَّنِي أُعْطِيتُ عِلْمَ الحُكْلِ",24,"ل",1,0],["فقُلْتُ قد نَضَبَ الدَّمْ","عُ وابِلاً ورَذاذَا",25,"ذ",2,0],["فقلت قل لي من أين تعرفه","فقال ذرني من هذه العقل",26,"ل",1,0],["فَقُلتُ قَولا غَير قَول زور","أَهوَن زوّار عَلى مَزُور",27,"ر",1,0],["فقلت قلبي مسبّي وأنك لو","كتمت سري لم أكتمك كيف سبي",28,"ب",2,0],["فقلت قد قال لي فؤادي","مثلك من مات باكتئاب",29,"ب",1,0],["فَقلتُ قَلبي قَد ألِف","مليحةً تُدعى ألِف",30,"ف",1,0],["فقلت قولا موجزاً فاصلاً","ما فيه للعاقل تلبيس",31,"س",1,0],["فقلت: قد كان ذاك عن خطأ","لا قود عندنا ولا ثار",32,"ر",1,0],["فقلت قول امرئ لبيب","ما المرء إلا بدرهميه",33,"ي",2,0],["فقلت قد زهدني في هوى","كل مليح طلب المجد",34,"د",1,0],["فَقُلتُ قوموا اِذبَحوهُ","فَقالَ إِنّي يُخامِر",35,"ر",1,0],["فقلت: قنعت بهذا المشيب","وإن زال غيمٌ فهذا مطر",36,"ر",1,0],["فقلتُ قضيبُ النَّقَا يانعٌ","يميسُ على حِقْفِه الأَغْفَرِ",37,"ر",1,0],["فقلتُ قد عِفتُ يا حِمَارُ في سَفَري","كُلَّ البراذنِ فهيَ لا توازيني",38,"ن",2,0],["فقلت قم فحياتي كلها نكد","ما لم تغثني ببنت الكرم والكرم",39,"م",1,0],["فَقُلتُ قَد شاعَ فَاِعتِذاري مِمّا","لَيسَ لي فيهِ عِندَهُمُ عُذُرُ",40,"ر",1,0],["فَقُلتُ قَد أَجَزتَ عَبدَ اللّهِ في","جَميعِ ما أَرويهِ مِن مُصنَف",41,"ف",1,0],["فَقُلت قَومي بِحِفظ اللَهِ سَيِّدَتي","لا أَقبَلُ الشَرطَ لَو كُنتَ مِنَ العَين",42,"ن",1,0],["فقلتُ قد كنتُ بعمري صائماً","وكان إفطاري به محرَّما",43,"م",2,0],["فَقُلتُ قَتَلتَني وَأَذَبتَ جِسمي","وَقَد آذَنتَ روحي بِالذّهابِ",44,"ب",1,0],["فَقُلتُ قَدرُكَ عالٍ قَد عَلِمت وَل","كِنَّ الهَدايا عَلى مِقدارِ مُهديها",45,"ي",3,0],["فقلت قصيدة فيه شرودا","تجوب مناكب الكون الفسيح",46,"ح",1,0],["فقلت قحطان هل مررت به","قال نفثنا ببرده الغقدا",47,"د",2,0],["فقلت قالوا قديما انه ألم","وربما الصدق كل الصدق ما قالوا",48,"ل",3,0],["فَقُلْتُ: قَدْ عَاْدَنَيْ عِيْدٌº فَأَحْزَنَنِيْ","لَمَّاْ تَغَيَّبَ - يَوْمَ الْعِيْدِ - صَدَّاْمُ",49,"م",1,0],["فَقُلتَ قَصَدتُ بَردَ الغَربِ عَمْدًا","وَقُلتُ أرَدتُ بَحرًا مَشرِقِيَّا",50,"ي",2,0],["فقلتُ: قد أخطأْتِ يا وردتي","فما أنا بالماجِنِ الأحْمَقِ",51,"ق",1,0],["فقلت قول امرئٍ محضٍ مقالته","الله ربي تعالي الخالق الأزلي",52,"ل",2,0],["فَقُلْتُ: قَدْ أغْلَيْتَ يا صَاحِبي","فاقْصِدْ وسامِحْ عافِياً قَدْ أتاكْ",53,"ك",1,0]]}