sgate.com/ViewPoem.aspx?id=175573",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5081,"لَا تَسْتَهِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=185840",""],[5150,"وجدتها .. وجدتها","https://www.poetsgate.com/ViewPoem.aspx?id=202800",""],[5431,"دعك منهم","https://www.poetsgate.com/ViewPoem.aspx?id=213637",""],[5491,"أنت علمتني بألا أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=215041",""],[5563,"غنِّ لي عن ذي البنيّة","https://www.poetsgate.com/ViewPoem.aspx?id=213765",""],[5595,"دُمْ في عُلاكَ مُعلّماً كلَّ الورى","https://www.poetsgate.com/ViewPoem.aspx?id=144653",""],[2110,"دع هوى سلمى واقصر عن سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=156270",""],[5638,"رسالةٌ إلى أسير","https://www.poetsgate.com/ViewPoem.aspx?id=198246",""],[5704,"دعْكَ مِنْ هجري","https://www.poetsgate.com/ViewPoem.aspx?id=191698",""],[5704,"بالذي سوَّاكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=191808",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6268,"كَفاكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82930&r=&rc=16",""]],"verses":[["دعكَ من الماضي فلو","عدت إلى الماضي",0,"ا",3,0],["دعك من زحمة العواصف و","اترك للعقاب السماء والتحليقا",1,"ق",2,0],["دَعْ كَاتِبَ الْوَحْيِ الْحَدِي","ثِ أَوِ الْخَطِيبَ المُسْتَعَادْ",2,"د",1,0],["دَعْ كُلَّ نَقْشٍ فِي الْخِلاَلِ","مُوَشَّمٍ وَمُبَقَّعِ",3,"ع",1,0],["دعك من ذا وتلك والرسم والاس","م فما في الميدان الا جوادي",4,"د",2,0],["دَعْكَ والجُدرانَ, مَن ذا تَتَّقي","طالَما كَسَّرتَ مَن يَبغُونَ فَتحَك",5,"ك",1,0],["دَعكَ منه واقلِبِ","الصَفحةَ في سِفرِ الدُهور",6,"ر",1,0],["دَعكَ مني واقلِبِ","الصَفحةَ في سِفرِ الدُهور",6,"ر",1,0],["دعك من هذا فماذا","شأننا في درسنا ذا",7,"ا",1,1],["دَعكَ مِن دَعوى على غيرِ بيان","لَيسَ مِن جدَّ كَمَن قَد لَعِبا",8,"ب",2,0],["دَعكَ مِن نَهي النُهاة","وَمَلام العاذِلات",9,"ت",1,1],["دعْ كَبَدَ الغيظِ على أعدائها","ودع لأوليائها حَزَّ الأُشَرْ",10,"ر",1,0],["دعك يا خال عندنا كي نقضّي","ما ينافي ذاك الاسى والهولا",11,"ل",2,0],["دع كل مهتضم ومنتقص وان","هم أوجزوا فيك المقال واجزلوا",12,"ل",3,0],["دَع كُلَّ ظَمياء الشِّفاهِ كَأنَّما","في ظَلمِها عسلٌ إذا هِيَ تُلثَمُ",13,"م",1,0],["دَع كُلَّ جِنعاظٍ وَصاحِبِ ظِنَّةٍ","فَمَظَنَّةُ الإسعادِ إِلفٌ يُكرَمُ",13,"م",1,0],["دع كلّ ذي شجوٍ يبوحُ بشجوهِ","فلرُبّ حالٍ من لسان أنطَقُ",14,"ق",1,0],["دَع كُل يَوم وَما قَضاه","وَاخفض ليحلو لك الهَوان",15,"ن",1,0],["دَع كلَّ ما قَد زخرفوه وَزينوا","فَالزهد عادته مقالة معدم",16,"م",1,0],["دع كل باهرة المحا","سن زانها غض الصبى",17,"ا",1,0],["دَعْ كَدَرَ العَيْشِ وَخُذْ ما صَفا","تَحْيَ وَيَشْقَ الدَّائِبُ الكَادِحُ",18,"ح",1,0],["دع كل باب دون باب المصطفى","وبه توسل راجيا مستعطفا",19,"ف",2,1],["دعك من أَرض أَريقت فوقها","من أَب البيت دماء طاهرة",20,"ه",1,0],["دعك من شمس أَضاءَت روقها","دعك من هذي النسام العاطرة",20,"ه",1,0],["دَعكَ مِمَّا يُقالَ عَنها, وقُل لِي","أَينَ قَرَّرتَ أَن نَبيعَ العِيالا؟!",21,"ل",2,0],["دعك من يا ليت وابعد عن عسى","واتَّبِعْ من لو جفيتهُ ما قسا",22,"س",2,1],["دعك من صحبة من صحبته","كلها همٌ وضيقٌ ونكد",23,"د",1,0],["دع كلمةً تسخط المولى وقد عظمت","إثما وضرّاً، ولا تلقي لها خلدا",24,"د",2,0],["دعك مني فمالجمرك لسعٌ","في زمان إحساسه جلمودُ",25,"د",1,0],["دعك مني .. ليس لي رأي سوى","أنني كالناس من ضمن البريد",26,"د",1,0],["دعْك َ منّي .. أرجوك َ هيا أعدني","لصباح ٍ به العنا رَشَفات ُ",27,"ت",1,0],["دعْ كُلَّ حَرْفٍ مِنْ كَلَامِكَ صَارِخَاً","بِالْحَقِّ ، وَاضْرِبْ بَاطِلَاً كَىْ يَنْقَشِعْ",28,"ع",1,0],["دعكِ مما يخفيهِ قلبي.. فهذا","وحْيُ عينيكِ انتابهُ حين حنّا",29,"ن",2,0],["دعك منهم فما الدنان دنانٌ","لا وربي ...ولا الرؤى ظمآنةْ",30,"ن",2,0],["دعك منهم فسدرة الفن كانت","لنفوسٍ عظيمة ملآنة",30,"ن",2,0],["دعَكَ عني ولا تسل كيف حالي","لا أبالي بمثل هذا السؤالِ",31,"ل",1,1],["دعْكَ منْ ألحانِ ليلى","لم تعدْ في القلبِ حَيَّةْ",32,"ي",2,0],["دَعْ كلَّ ذا فيضاً يَطوفُ بروضةٍ","روضُ السّيادة خاطبتْ(عمّارا )",33,"ر",2,0],["دعك من ذل الهوى وانهض بنا","نطلب العز على متن الجياد",34,"د",1,0],["دَعْكَ مِمَّنْ بَاعَ دِينًا وَإِبَا","كَيْ يَهِيمَ الْعُمْرَ فِي دُنْيَا اللِّئَامِ",35,"م",1,0],["دعْكَ مِنْ هجري ولا تنْكِرْ صفاكا","إنَّ قلبي بات صبًّا في هواكا",36,"ك",2,1],["دعْكَ من هجري ولا تتركْ حبيبًا","للأعادي.. قد غدا فيهم بُكِيَّا",37,"ي",2,0],["دَعْ كلَّ أحدَاثٍ لخالِقهَا","وَامْشِ إلى الخَيراتِ بِالهِمَمِ",38,"م",1,0],["دَعكَ مِنَّا . فَلَنْ تُغَيِّرَ شَيئًا","فِي عُيُونٍ تَكَحَّلَتْ بِالرِّياءِ",39,"ا",2,0],["دعك من التفكير.. كُن رافضا","ما ثَّمَ فوق الأرض شيءٌ أكيدْ",40,"د",1,0]]}