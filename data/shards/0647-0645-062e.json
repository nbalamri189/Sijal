{"poems":[[55,"هم خلفوا دمعي طليقا وغادروا","https://www.aldiwan.net/poem30184.html","الطويل"],[39,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[30,"رحلت إلى عبد الإله مطيتي","https://www.aldiwan.net/poem5196.html","الطويل"],[2,"صحا القلب عن سلمى وقد كاد لا يسلو","https://www.aldiwan.net/poem25064.html","الطويل"],[51,"رحلت عن الربع المحيل قعودي","https://www.aldiwan.net/poem64158.html","الطويل"],[107,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[107,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[119,"لذ بالرفاعي الحسيني الذي","https://www.aldiwan.net/poem41070.html","عموديه"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[240,"تهن بها أشرف الأرض دارا","https://www.aldiwan.net/poem32007.html","المتقارب"],[287,"تبوح دموعي واللسان صموت","https://www.aldiwan.net/poem32850.html","الطويل"],[305,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[347,"ما بين اخفاق حبي","https://www.aldiwan.net/poem55335.html","المجتث"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[369,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[422,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[463,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[463,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[463,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[469,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[475,"الأكرمون طوال الدهر إن نسبوا","https://www.aldiwan.net/poem4668.html","البسيط"],[520,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[520,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[556,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138262",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138400",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138389",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138377",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64361","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[908,"","https://poetry.dctabudhabi.ae/diwan/poem/199305","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70967","الطويل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82244","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79908","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141327","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127883","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125362","الكامل"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101765","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77307","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104983","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93732","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124603","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76044","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21626","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94309","الرمل"],[3106,"","https://poetry.dctabudhabi.ae/diwan/poem/104505","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130058","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130038","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130064","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126245","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112624","الرجز"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100196","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62914","المنسرح"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17677","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91465","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91743","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91091","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119639","الطويل"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113022","الرجز"],[368,"","https://poetry.dctabudhabi.ae/diwan/poem/11392","الطويل"],[4767,"رب التقى","https://www.poetsgate.com/ViewPoem.aspx?id=89286",""],[4802,"والله مصيبه","https://www.poetsgate.com/ViewPoem.aspx?id=36911",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4840,"لك الله من برق بدا متبسما","https://www.poetsgate.com/ViewPoem.aspx?id=129156",""],[4929,"القدس بوابة العبور إلى المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199179",""],[5055,"الأشخرة","https://www.poetsgate.com/ViewPoem.aspx?id=104391",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5569,"مريم والعراق","https://www.poetsgate.com/ViewPoem.aspx?id=60534",""],[5956,"أنا ضد باطنية كل الأطراف","https://www.poetsgate.com/ViewPoem.aspx?id=192188",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[463,"إن تسأليني بعد قو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60202&r=&rc=258",""]],"verses":[["هُمُ خَلَّفوا دَمعي طَليقاً وَغادَروا","فُؤادي عَلى داءِ الغَرامِ حَبِيسا",0,"س",2,1],["هُمُ خَوَّفُونَا بالعَمَى هُوَّةَ الرَدَى","كما شَبَّ نارُ الحَالِفينَ المُهَوِّلُ",1,"ل",1,0],["هُمُ خَيرُ بَطحاوَي لُؤَيِّ بنِ غالِبٍ","سَما بِهِمُ مِنها البُحورُ الزَواخِرُ",2,"ر",1,0],["هُمُ خَيرُ حَيٍّ مِن مَعَدٍّ عَلِمتُهُم","لَهُم نائِلٌ في قَومِهِم وَلَهُم فَضلُ",3,"ل",1,0],["هُمُ خَيرُ أَولادٍ لَهُم خَيرُ والِدٍ","لَهُ خَيرُ آباءٍ مَضَت وَجُدودِ",4,"د",1,0],["هم خيّبوا أملَ البلادِ وعطّلوا","دينَ الجهادِ ولاتَ حينَ جهادِ",5,"د",1,0],["هم خاصموا مصرَ ثم استرسلوا حَنَقاً","إلى الأُلى شرعوا العُدوان فاحتكموا",6,"م",3,0],["هم خلَّفوا رِممَ القتلى مُطرَّحةً","وغادروا الجندَ جُندَ اللّهِ والسَّلبا",7,"ب",2,0],["هم خيرة الرحمن في اهل الحمى","والله يفعل كيفما يختار",8,"ر",1,0],["هم خادعوه فيك أفتوا بغير ما","لديهم وغروا بالمحال وأجلبوا",9,"ب",3,0],["هُم خَلَّفوني بَعدَهُم ذا حيرَةٍ","أَبكي الرُسومَ وَأَندُبُ الأَطلالا",10,"ل",2,0],["هُمُ خيرَةُ اللَهِ مِن خَلقِهِ","وَأَكرَمُهُم يَومَ فَخرٍ فِخارا",11,"ر",2,0],["هُم خَلَّفوني لا مَحالَةَ مَيِّتاً","وَمِن دونِ وَجدي مَن يُحِبُّ يَموتُ",12,"ت",1,0],["هُمُ خَلَطوني بِالنُفوسِ وَأَشفَقوا","عَلَيَّ وَرَدّوا البَختَرِيَّ المُؤمَّرا",13,"ر",2,0],["هم خلفوني حزيناً","ما بين قومي وامسي",14,"س",2,0],["هُمُ خُلِقُوا عُلاً وخُلِقْتَ مَجْداً","فبَينكُما مُناسَبةُ الجَلال",15,"ل",1,0],["هُمُ خَلَطوا الإسلامَ بالكُفْر خَلْطةً","فَصيّرتَ حّدَّ السيفِ بينهم الحَدّا",16,"د",2,0],["هُمُ خَطَبوا بِكرَ العُلا وَعَوانَها","بِجُردٍ عَوانِ البِكرِ",17,"ر",1,0],["هم خيرُ من لا يَبرح الخيرُ فيهم","وما كلُّ من ألفَيْتَه من خياره",18,"ر",2,0],["هم خَّلفوني كالرذي","يَة لا أدينُ كما أُدانُ",19,"ن",1,0],["هم خيرُ ما حملتْ فقامت حرّةٌ","حصناءُ عن كرمٍ وذيلٍ طاهرِ",20,"ر",1,0],["هُمُ خطبوها راغبين وسوَّدوا","عليها نفيساتٍ من البذلِ والوفرِ",21,"ر",1,0],["همُ خطباء الحفل والخطبُ مفحمٌ","وهم أمراءُ الجمع في الحادثِ الأمر",22,"ر",1,0],["هُم خَيرُ سُكّانِ هَذي الأَرضِ نَعلَمُهُم","لَو كانَ يُخبِرُ عَن سُكّانِهِ البَلَدُ",23,"د",1,0],["هم خلصوني بالنفوس التي لها","محل من الجوزاء أعلى وأفضل",24,"ل",1,0],["هم خلصوني منعمين بأنفس","لها الدهر عبد والزمان خديم",25,"م",1,0],["همْ خوّلوا النِّعَمَ الجسامَ وأمطروا","في المُمْلقين غنائمَ المعروفِ",26,"ف",1,0],["هم خير قوم عن حقوق بلادهم","وحقوق إخوان لهم ذُواد",27,"د",1,0],["هم خبر مَن حكموا وسادوا واعتلوا","هم فخر مصر السادة الاعلام",28,"م",1,0],["هم خير اشبال سمت آدابهم","وخلالُهم وكذاك عرفانا سموا",29,"م",3,0],["هم خير ابطال إذا ما استصرخوا","لبّوا الندا وإلى الامام تقدموا",29,"م",3,0],["هم خير من رتب المعالي احرزوا","بين الملا وسنامهن تسنموا",30,"م",3,0],["هم خير ماش مشى على قدم","وخير من يمتطي المطياتِ",31,"ت",1,0],["همُ خلعوا عنانَ قلىً جموحٍ","وهم ألقوا زمامَ نوىً ضَروس",32,"س",1,0],["هم خلفاء الله في أرضه","وهم ولاة البعث والمحشر",33,"ر",1,0],["همُ خُشُبٌ للنار لا تُحسِنَنْ بهم","ظنونا فظن السوء بالخُشُبِ الحزم",34,"م",1,0],["هُمُ خَيرُ مَن بَين الحجونِ إِلى الصَّفا","إِلى حَيثُ أَفضَت بِالبِطاحِ الحَزاوِرُ",35,"ر",1,0],["هُمُ خَيْرُ أَمْلاَكِ الزَّمَانِ وَخيْرُهُمْ","مُحَمَّدٌ الْمَحْمُودُ فِي السِّرِّ وَالْجَهْرِ",36,"ر",1,0],["هم خيرُ من رشَّحه لسؤددٍ","مجدٌ وأزكى من نماهُ مَحتِد",37,"د",1,0],["همُ خير إخوان تطيب العلى بهم","وقد شرفوا أصلاً كما كرموا خلقا",38,"ق",2,0],["هم خيرة اللَه مذ كانوا وصفوته","وجيرة اللَه فازوا منه بالذمم",39,"م",1,0],["همُ خبَّروا عنهُ فأَثنوا بصالحٍ","وعندي بما اثنت بهِ خيرُ شاهدِ",40,"د",1,0],["هم خيرُ من سلوا سُيوفاً في الوَغَى","وبهم يفوزُ الدِّينُ والإسلامُ",41,"م",1,0],["همُ خَبَثُ الحديد وأَنْتَ مما","يُصَفَّى جوهرُ السيفِ اليماني",42,"ن",2,1],["هُم خَصَّصُوهُ بِالمَسِيحِ وَأمِّهِ","وَأولاَءِ مَا صَانُوهُ عَن حَيَوَانِ",43,"ن",1,0],["هُم خَالَفُوا نَصًّا لِنَصٍّ مِثلِهِ","لَم يَفهَموا التَّوفِيقَ بِالإحسَانِ",43,"ن",1,0],["هُمُ خَيرُ المَعاشِرِ مِن قُرَيشٍ","وَأَوراها إِذا قُدِحَت زُنودا",44,"د",2,0],["هُم خَيَّروا بَينَ عَيشٍ لا بَهاءَ لَهُ","وَبَينَ قَتلٍ وَأَنتَ القَتلُ تَختارُ",45,"ر",1,0],["هم خير نسل إذا أنت افتخرت بهم","وأنت خير أب إن هم بك افتخروا",46,"ر",3,0],["هُمُ خَلَّفوا القَوم الكِرام وَراءَهُم","وَراحوا بِأَبكار المَعالي وَعونها",47,"ن",3,0],["هُم خامسٌ وسادسٌ في المغرب","يَعرِفُهُنَّ كاملٌ مجرَّب",48,"ب",1,0],["هم خير أهل زوايا الارض قاطبةً","من دونوا في العلى والمجد ديوانا",49,"ن",2,0],["هُم خَيرُ خَلقِ اللَهِ بَعد نبيِّهم","فَلَيسَ لَهُم في السَبقِ وَالفَضلِ مِن مِثلِ",50,"ل",1,0],["هُم خَيرُ قَومِهِمُ إِن حَدَّثوا صَدَقوا","أَو حاوَلوا النَفعَ في أَشياعِهِم نَفَعوا",51,"ع",3,0],["هم خيار من خيار صفوة","فتراهم نخبة من نخبه",52,"ب",2,0],["هم خير خلق اللَه بعد نبيه","وهم بالخصوص في النصوص أولوا الأمر",53,"ر",1,0],["هم خيرُ مَن ملكوا البلاد فأحسنوا","وأجلُّ مَن ساسوا بحزمهم البشَر",54,"ر",1,0],["هُم خيرُ مَن درَسوا الفنون فأدهشوا","هذا الزمانَ بِحُسنها المتروكِ",55,"ك",1,0],["همُ خير مَن ساسوا البلاد بحكمةٍ","ودان لهم في الأمرِ ما قد تَعَذّرا",56,"ر",2,0],["هم خير خلق الله في كل محفل","وفى كل أرض لللآله وبلدة",57,"ه",1,0],["هُم خيرُ أصحاب وخيرُ عُدَه","أهلُ الحفاظِ والوفا والنجده",58,"ه",1,0],["هم خيرة الباري ومهبط وحيه","حقاً وعيبة علمه المخزون",59,"ن",1,0],["هم خَبطوا دوحةَ الزمانِ كما","عن فَنَنِ الغُصْنِ يُخبَط الوَرَقُ",60,"ق",1,0],["هُمُ خَلَفوا في الأَرضِ عاداً بِقَوَةٍ","عَلى ما بِهِ تَأَتي الأَمورُ العَظائِمُ",61,"م",1,0],["هم خيرتي حَيث شاؤا لي عَلَيً قضوا","وَحَبّذا لو هُمُ بالمنع لي منحوا",62,"ح",3,0],["هم خلّفوا حسرةً بالقلب ما خمدت","مذ بان ظاعنُهم أَوجدّ مسراهمْ",63,"م",1,0],["هُم خلَّفوني مُدنفاً ذا لَوعة","وَعلى الحَقيقة قُلت غير مجسم",64,"م",1,0],["هم خرجوا بغياً فقيل مؤرخاً","وسيف عليٍّ للخوارج بازل",65,"ل",1,0],["هم خيموا بين الضلوع والحشا","مني محل الروح والسواد",66,"د",1,0],["هُمُ خَلَطونا بِالنُفوسِ وَأَلجَأوا","إِلى حَجَراتٍ أَدفَأَت وَأَظَلَّتِ",67,"ت",1,0],["هم خير من صلى لخالقه","هم خير من ناجى ومن خشعا",68,"ع",2,0],["هم خدرونا في مواعيد الاوهام","ياويلهم يا ويلهم لا انتخينا",69,"ن",2,0],["هم خلفاء الله في أهل أرضه","بهديهم أمت البسيطة قوما",70,"م",2,0],["هم خصموا الإله وعاندوه","وما لخصيم ربك من مزيد",71,"د",1,0],["هم خيموا بالرقمتين ووجدهم","على البعد ما بين الترائب خيما",72,"م",