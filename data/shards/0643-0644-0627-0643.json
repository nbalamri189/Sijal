{"poems":[[32,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[107,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[203,"تالله لو جددوا للبدر تسمية","https://www.aldiwan.net/poem45154.html","البسيط"],[203,"على السماء وفوق الشمس أشعاري","https://www.aldiwan.net/poem45351.html","البسيط"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[447,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[520,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138417",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77515","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46569","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109254","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49581","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69366","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89147","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132154","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[129,"","https://poetry.dctabudhabi.ae/diwan/poem/203067","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52191","البسيط"],[585,"أهلاً بيوم هو الأحقاب والسير","https://www.poetsgate.com/ViewPoem.aspx?id=161900",""],[3591,"يا درّةً أبقيت لي قبلما","https://www.poetsgate.com/ViewPoem.aspx?id=149445",""],[5200,"أعقب أعزّك ربّ العباد","https://www.poetsgate.com/ViewPoem.aspx?id=200809",""],[5206,"السلامة في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=187360",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5460,"كتبت اليك في ظهر لعلمى","https://www.poetsgate.com/ViewPoem.aspx?id=200734",""],[5956,"لله درك من ذواقة وناقدة","https://www.poetsgate.com/ViewPoem.aspx?id=215549",""],[520,"لا وعيون لحظها ساحر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577520",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["كِلا كَفأَتَيها تُنفِضانِ وَلَم يَجِد","لَها ثيلَ سَقبٍ في النِتاجَينِ لامِسُ",0,"س",1,0],["كِلاكُما وسيوفُ اللهِ شاهدةٌ","غَوْثُ اللّهيفِ وَروْحُ البائِسِ العاني",1,"ن",2,0],["كِلا كفّيْكَ في سَلْمٍ وحَرْبٍ","يكُونُ الخوْفُ مِنها والأمانُ",2,"ن",1,0],["كلاكما الحسن فتاناً بصورته","وزدت أنك أنت الحب والغزل",3,"ل",1,0],["كلاكما حسنٌ والحسنُ بينكما","كالروضِ يأرجُ من أشتاتِ أزهارِ",4,"ر",1,0],["كُلّاً كسوْتَ دَرَانِكاً ونمارِقاً","وزرابِياً وأرائِكاً وخُدُورا",5,"ر",2,0],["كلاك اللَه يا نزوى وطوبى","لدارٍ مثلك الباري كلاها",6,"ا",3,0],["كلاكما سار إلى فيئها","كذا أبوه قبله سائر",7,"ر",1,0],["كلاكما عاشق في زوجه شرفا","كلاكما صار بالآداب مقترنا",8,"ن",2,0],["كِلاكُما عَلى وَخيم المرتع","وَالمدَّعى عَلَيه مِثل المُدّعي",9,"ي",1,0],["كِلاكما بنيه","لَيسَ لَهُ شَبيه",10,"ه",1,0],["كلاكما صادق","ولعنة الله على الكاذبين",11,"ن",1,1],["كلاكُمَا قامَ على مَجْدِهِ","بشاهدٍ منْ مَجْدِهِ عَدْلِ",12,"ل",1,0],["كَلاكَ اللَهُ مِن نُوَبِ اللَيالي","فَإِنَّكَ تَكَلأُ الأَدَبَ المُضاعا",13,"ع",2,0],["كَلاكَ اللَهُ ما أَحلا","كَ في عَيني وَفي صَدري",14,"ر",2,0],["كلاكما خلفٌ عن فقد صاحبه","إن صار مبتدأ لذلك الخبر",15,"ر",1,0],["كلاكما زينة الشبان والغيد","والعيش يبسم عن زين المواليد",16,"د",1,1],["كلاكما لطاعتي مستلم","والوقت صاف والوفاء ملزم",17,"م",1,0],["كلاكما البحر في جود وفي كرم","أو الغاماة تقي كل ظمآن",18,"ن",1,0],["كِلاكما في مَجالي فخرِهِ شِرَعٌ","النيلُ قام به والعرشُ حلاَّه",19,"ا",2,0],["كلاكما صارمٌ يزهى بصاحبه","لله سلكما من غمده القدر",20,"ر",1,0],["كلاكما درّ أنا سلكه","ما أشرف الدّرّ وأبهى النظام",21,"م",1,0],["كلاك الإله وأبقاك في","يسار سنى وعيش هنى",22,"ا",1,0],["كَلَاكِلُهَا كَانَتْ بِهَا فِي مَهَالِكٍ","كَدَتْ كُلَّ مَن قَدْ كَانَ في الكُفْرِ يَهْكَعُ",23,"ع",1,0],["كلاكما ذو فؤاد بالهوى كلف","وأنتما شركا في ود من فيها",24,"ي",3,0],["كلاك الله من شين وحين","وحاطك من ملمات الدّهور",25,"ر",1,0],["كلاكما قد سَقاني وحيُه عسَلاً","ليصبحَ الشعرُ مِن خير المواليدِ",26,"د",1,0],["كلاكما سار إلى سيرة","فيها أبوه قبله سائر",27,"ر",1,0],["كِلاَكُما أَمَلٌ فِي نَفْس صَاحِبِهِ","مُحَقَّقٌ، قَدْ حَبَاهُ الدَّهْرُ إنْعَامَا",28,"م",2,0]]}