{"poems":[[53,"ثورتها تنتعل الظلاما","https://www.aldiwan.net/poem29812.html","الرجز"],[53,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[53,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[63,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[88,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[27,"لا تحسبي سباسب العراق","https://www.aldiwan.net/poem5929.html","الرجز"],[11,"قدوري بصحراء منصوبة","https://www.aldiwan.net/poem262.html",""],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[72,"نزحت لبين النازحين مدامعي","https://www.aldiwan.net/poem18385.html","الطويل"],[72,"أيا ملك الشجاعة والمعالي","https://www.aldiwan.net/poem19213.html","الوافر"],[72,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[64,"أشار لحظي بعين علم","https://www.aldiwan.net/poem67612.html","مخلع البسيط"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"قد وصلت قارورتي وحاجتي ما وصلت","https://www.aldiwan.net/poem8689.html","مجزوء الرجز"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[51,"ماذا يريد الناس من خالد","https://www.aldiwan.net/poem64633.html","السريع"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"قدوم سعادة وقفول يمن","https://www.aldiwan.net/poem66407.html","الوافر"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[91,"سلام على السيد المجتبى","https://www.aldiwan.net/poem8758.html","عموديه"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[70,"على الطائر الميمون يا خير قادم","https://www.aldiwan.net/poem42693.html","الطويل"],[78,"قد وجدنا الحبيب يصفى وداده","https://www.aldiwan.net/poem14284.html","الخفيف"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[89,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"قد ود نوح أن يباسط قومه","https://www.aldiwan.net/poem8023.html","الكامل"],[85,"سألتك بالوداد أبا حسين","https://www.aldiwan.net/poem8058.html","الوافر"],[85,"يا رب ما حكمك ماذا ترى","https://www.aldiwan.net/poem8095.html","السريع"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[56,"كأنها حين صفقت ذهب","https://www.aldiwan.net/poem58583.html","المنسرح"],[43,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[45,"أيها الطالب الطويل عناؤه","https://www.aldiwan.net/poem10201.html","الخفيف"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[45,"من أنت إن حصلت يابن استها","https://www.aldiwan.net/poem65129.html","السريع"],[45,"يا مغاني الأحباب صرت رسوما","https://www.aldiwan.net/poem65684.html","الخفيف"],[45,"أدمع قد غرين بالهملان","https://www.aldiwan.net/poem66672.html","الخفيف"],[61,"جنح الملحي للسلم","https://www.aldiwan.net/poem51482.html","مجزوء الرمل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[61,"قد وفت المزن بميعادها","https://www.aldiwan.net/poem51702.html","السريع"],[49,"نادت بوشك رحيلك الأيام","https://www.aldiwan.net/poem63112.html","الكامل"],[66,"خذ أحاديثها من العارفيها","https://www.aldiwan.net/poem38639.html","الخفيف"],[66,"ليت شعري بمن تشاغلت عنا","https://www.aldiwan.net/poem39684.html","الخفيف"],[97,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem24380.html","السريع"],[80,"لله شمس كان أولها السها","https://www.aldiwan.net/poem31264.html","الكامل"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[44,"صد وما احتسب الصدا","https://www.aldiwan.net/poem30268.html","السريع"],[69,"نعوذ بالرحمن من مثلها","https://www.aldiwan.net/poem29214.html","السريع"],[105,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[22,"قد وزوزاني مشتدا رقابهما","https://www.aldiwan.net/poem21672.html","البسيط"],[52,"قد وجدنا لغفلة من رقيب","https://www.aldiwan.net/poem27286.html","الخفيف"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"أكثري أو فأقلي","https://www.aldiwan.net/poem65047.html","مجزوء الرمل"],[50,"الق حربا فحيه","https://www.aldiwan.net/poem63973.html","مجزوء الخفيف"],[50,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[46,"قد وعظتني بك الليالي","https://www.aldiwan.net/poem22402.html","مجزوء البسيط"],[46,"كأن منجم الأقوام أعمى","https://www.aldiwan.net/poem22837.html","الوافر"],[46,"ما أوصل السيف قطاعا لحامله","https://www.aldiwan.net/poem23218.html","البسيط"],[46,"ما أكرم الله عز من ملك","https://www.aldiwan.net/poem23418.html","المنسرح"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[68,"عيني لخيال زائر مشبهه","https://www.aldiwan.net/poem1533.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85409","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39600","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202552","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142032","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141919","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[90,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[45,"ذاكَ وَادي الأرَاكِ فاحبِسْ قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=32098",""],[51,"قُدومُ سعادة ٍ وقُفولُ يُمْنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30578",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[60,"لا تعذليه فإن العذل يولعه","https://www.poetsgate.com/ViewPoem.aspx?id=15018",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""]],"verses":[["قَد وُلِدَ المَجدُ لَهُ تَماما","إِذا رَأَينا المَلِكَ الهُماما",0,"م",2,0],["قَدّوا مِنَ البيضِ خَلقاً وَالحَيا خُلُقاً","عيصاً أَلَفَّ بِعيصِ المَجدِ فَاِشتَبَكا",1,"ك",2,0],["قَد وَهَبنا رَجاءَنا لِزَمانٍ","لَم يَدَعنا حَتّى وَهَبنا العِرضا",2,"ض",2,0],["قُدودُها أم رِماحُ الحَيِّ تُحدِقُ بي","وأعيُنٌ أم سِهامُ القَوْمِ تُصْميني",3,"ي",1,0],["قُدُومُكَ أَسْنَى فِي فُؤَادِيَ مَوْقِعاً","مِنَ الْوَصْلِ فِي قَلْبِ الْعَمِيدِ الْمُتَّيمِ",4,"م",1,0],["قَد وَقَفنا سِتَّةً نَبكي عَلى","عالِمِ المَشرِقِ في يَومٍ عَصيبِ",5,"ب",1,0],["قَد وَعَدتُ العُلا بِكُلِّ أَبِيٍّ","مِن رِجالي فَأَنجِزوا اليَومَ وَعدي",6,"ي",1,0],["قد وتَّدُوا القَيد في مُخَلخَلها","ومدّدوه كأنه طُنُب",7,"ب",1,0],["قد وحّدوا الله عن علم فوحّدهم","روحاً فخِيلُوا لأم كلّهم وأب",8,"ب",1,0],["قد وضعت تاجاً على رأسها","يلمع في الظاهر لمعَ الشهاب",9,"ب",1,0],["قد وهمنا في البدء منها وأما","منتهاها فستره مسدول",10,"ل",1,0],["قَد وَثِقَت إِن ماتَ بِالنَفاقِ","فَهوَ عَلَيها هَيِّنُ الفِراقِ",11,"ق",1,0],["قُدوري بِصَحراءَ مَنصوبَةٌ","وَما يَنبَحُ الكَلبُ أَضيافِيَه",12,"ه",1,1],["قدورهم تغلِي أمام فنائهم","إذا ما الثريا غاب عصراً رقيبها",13,"ب",3,0],["قدومَ الحيا يروِي ظمَا كلّ منبتٍ","ضعيفٍ فيا بشرى لضعفِ نبات",14,"ت",1,0],["قدومك هذه الأيام فيه","جناس مذكر كتب البديع",15,"ع",1,0],["قدوم كما حيى قدوم غمام","وعوْد إلى الأوطانِ عوْد حسام",16,"م",1,1],["قَد وَسَمَ الحُبُّ مِنهُ قَلبي","بِمَيسمِ الشَوقِ أَيَّ وَسمِ",17,"م",1,0],["قَد وَزَّع اللَهُ بَينَ الخَلقِ رزقَهُمُو","لَم يَخلُق اللَهُ مِن خَلقٍ يُضَيِّعُهُ",18,"ع",2,0],["قد وطَّأ المجدُ للعافي خلائِقَهُ","فللتَسَحُّبِ فيها لينُ مُنْسحَبِ",19,"ب",1,0],["قد وَصَلَتْ قارُورتي","وحاجتي ما وَصَلَتْ",20,"ت",1,1],["قد وعدتني النفس جدوى له","إن شئت بعد اللَّه وظَّفْتُها",21,"ت",3,0],["قد وصفْنا التي هويتَ بحقٍ","بارزٍ للعيون كل بروز",22,"ز",1,0],["قد وَلعُوا بالشيخ يؤذونهُ","عجَّله اللَهُ إلى رَمْسِهِ",23,"س",2,0],["قد وسطتم وفقتمُ وتقدم","تم فأنذرت حاسداً أن يموقا",24,"ق",2,0],["قُدومُ سعادةٍ وقُفولُ يُمْنٍ","هي السَّرَّاءُ تَنْسَخُ كُلَّ حُزْنِ",25,"ن",1,1],["قد وصفْنا فمن غدا يتمارى","فليزُرْنا نُقِمْ له البرهانا",26,"ن",2,0],["قُدومُكَ بَدَّدَ عَنّا الأَسى","كَما يَكشِفُ القَمَرُ الغَيهَبا",27,"ب",2,0],["قَد وَجَدتُ اليَأس وَالحَيرَةَ لَكِن لَم أَجِدني","فَهَلِ الجَهلُ نَعيمٌ أَم جَحيمٌ لَستُ أَدري",28,"ي",1,0],["قَد وَهَبَتني روحَها كُلُّها","وَلَم تَخَف أَنّي أُضَحّيها",29,"ي",3,0],["قُدوماً بِهِ الدُنيا أَضاءَت وَأَشرَقَت","بِبِشرٍ وُجوهٍ أَو بِضَوءِ مَباسِمِ",30,"م",1,0],["قَد وَجَدنا الحَبيبَ يَصفى وِداده","وَحَمِدنا ضَميره وَاِعتِقا",31,"ق",2,1],["قد وددنا لو كنت للعلم تفدى","بالوف تحيا من الجاهلينا",32,"ن",2,0],["قد وقع الضوء على وجهه","فما ازال الضوء من لبس",33,"س",1,0],["قد وجدت الجمود للهلك ادنى","ووجدت الحياة في الحركات",34,"ت",1,0],["قُدوَةُ أَهل الدِين إِلّا أَنَّهُ","في أَدب الدُنيا المِثالُ لِمُحتَدى",35,"ا",1,0],["قَد وَدَّ نوحٌ أَن يُباسِطَ قَومَهُ","فَدَعا إِلَيهِ مَعاشِرَ الحَيوانِ",36,"ن",1,1],["قُدومُكَ في رُقِيِّكَ في نَصيبي","سُعودٌ في سُعودٍ في سُعودِ",37,"د",1,0],["قَد وَرَّثَ العالَمَ حَيّاً فَما","غادَرَ مِن فَجٍّ وَلا مِن سَبيل",38,"ل",1,0],["قَد وَكَّلَ اللَهُ الكَريمَ وَعَينَهُ","بِكِ فَاِحسِبيهِ عَلى كَريمِ رِحابِه",39,"ب",2,0],["قَد وَدَّ جَمالَكَ أَو قَبَساً","حَوراءُ الخُلدِ وَأَمرَدُهُ",40,"د",2,0],["قَد وُئِدَت في الصِبا","وَاِنبَعَثَت في الهَرَم",41,"م",1,0],["قَد وَقَفوا لِلمَها","فَاِنسَرَبَت مِن أَمَم",41,"م",1,0],["قَد وَحَّدَ الخالِقَ في هَيكَلٍ","مِن قَبلِ سُقراطَ وَمِن قَبلِ عاد",42,"د",1,0],["قَدْ وَلَدَتْ أُمُّها الخوات لها","فَواقِعَ مِنْ صُفْرٍ ومِنْ حُمْرِ",43,"ر",1,0],["قَد وافَقوا الوَحشَ في سُكنى مَراتِعِها","وَخالَفوها بِتَقويضٍ وَتَطنيبِ",44,"ب",1,0],["قَد وَجَدناهُ مُفضِلاً فَحَطَطنا","حَيثُ لايَكذِبُ المُرَجّي رَجاؤُه",45,"ا",3,0],["قَد وَلَدنَ الأَعداءَ قِدماً وَوَرَّث","نَ التِلادَ الأَقاصِيَ البُعَداءَ",46,"ا",2,0],["قَد وَقَفنا عَلى الدِيارِ وَفي الرك","بِ حَريبٌ مِنَ الغَرامِ وَمُثرِ",47,"ر",1,0],["قَد وَفَّرَت حَظَّكَ مِن إِخوَةٍ","أُمُّكَ إِذ زَوَّجتَها مُتعَه",48,"ع",2,0],["قَد وَجَدنَ السُلُوَّ بَرداً سَلاماً","إِذ وَجَدنا الهَوى عَذاباً أَليما",49,"م",2,0],["قَد وَرِثتَ العَلياءَ عَن أَردَشيرٍ","وَقَباذٍ وَعَن أَنوشَروانِ",50,"ن",1,0],["قد وَهَى سِتْرٌ رَقيقٌ","وقضى وِدٌّ عَليلُ",51,"ل",1,0],["قَد وَجَدْنا لأحمدَ بنِ سُليما","نَ يداً ثَرَّةً ووجهاً طَليقا",52,"ق",2,0],["قد وَفَتِ المُزْنُ بميعادِها","وخَصَّتِ الرَّوْضَ بإسعادِها",53,"د",3,1],["قَد وَدَّعَتكَ مِنَ الصِبا نَزَواتُهُ","فَاِحذَر فَما لَكَ بَعدَهُنَّ مُقامُ",54,"م",1,0],["قَد وَجَدنا بِها نَعيماً مُقيماً","فَغَدَت جَنَّةً لِمَن يَصطَفيها",55,"ي",3,0],["قَد وَجَدنا فيكَ الجَم