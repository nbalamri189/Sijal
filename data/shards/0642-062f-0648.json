","البسيط"],[514,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[515,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[515,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[515,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[515,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[529,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[529,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[538,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[551,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[558,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[567,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"],[569,"إن أدع مسكينا فاني ابن معشر","https://www.aldiwan.net/poem52028.html","الطويل"],[575,"ما أخشن الدهر على لينه","https://www.aldiwan.net/poem2772.html","السريع"],[575,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[575,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"]],"verses":[["قَد وُلِدَ المَجدُ لَهُ تَماما","إِذا رَأَينا المَلِكَ الهُماما",0,"م",2,0],["قَدّوا مِنَ البيضِ خَلقاً وَالحَيا خُلُقاً","عيصاً أَلَفَّ بِعيصِ المَجدِ فَاِشتَبَكا",1,"ك",2,0],["قَد وَهَبنا رَجاءَنا لِزَمانٍ","لَم يَدَعنا حَتّى وَهَبنا العِرضا",2,"ض",2,0],["قُدودُها أم رِماحُ الحَيِّ تُحدِقُ بي","وأعيُنٌ أم سِهامُ القَوْمِ تُصْميني",3,"ي",1,0],["قُدُومُكَ أَسْنَى فِي فُؤَادِيَ مَوْقِعاً","مِنَ الْوَصْلِ فِي قَلْبِ الْعَمِيدِ الْمُتَّيمِ",4,"م",1,0],["قَد وَقَفنا سِتَّةً نَبكي عَلى","عالِمِ المَشرِقِ في يَومٍ عَصيبِ",5,"ب",1,0],["قَد وَعَدتُ العُلا بِكُلِّ أَبِيٍّ","مِن رِجالي فَأَنجِزوا اليَومَ وَعدي",6,"ي",1,0],["قد وتَّدُوا القَيد في مُخَلخَلها","ومدّدوه كأنه طُنُب",7,"ب",1,0],["قد وحّدوا الله عن علم فوحّدهم","روحاً فخِيلُوا لأم كلّهم وأب",8,"ب",1,0],["قد وضعت تاجاً على رأسها","يلمع في الظاهر لمعَ الشهاب",9,"ب",1,0],["قد وهمنا في البدء منها وأما","منتهاها فستره مسدول",10,"ل",1,0],["قَد وَثِقَت إِن ماتَ بِالنَفاقِ","فَهوَ عَلَيها هَيِّنُ الفِراقِ",11,"ق",1,0],["قُدوري بِصَحراءَ مَنصوبَةٌ","وَما يَنبَحُ الكَلبُ أَضيافِيَه",12,"ه",1,1],["قدورهم تغلِي أمام فنائهم","إذا ما الثريا غاب عصراً رقيبها",13,"ب",3,0],["قدومَ الحيا يروِي ظمَا كلّ منبتٍ","ضعيفٍ فيا بشرى لضعفِ نبات",14,"ت",1,0],["قدومك هذه الأيام فيه","جناس مذكر كتب البديع",15,"ع",1,0],["قدوم كما حيى قدوم غمام","وعوْد إلى الأوطانِ عوْد حسام",16,"م",1,1],["قَد وَسَمَ الحُبُّ مِنهُ قَلبي","بِمَيسمِ الشَوقِ أَيَّ وَسمِ",17,"م",1,0],["قَد وَزَّع اللَهُ بَينَ الخَلقِ رزقَهُمُو","لَم يَخلُق اللَهُ مِن خَلقٍ يُضَيِّعُهُ",18,"ع",2,0],["قد وطَّأ المجدُ للعافي خلائِقَهُ","فللتَسَحُّبِ فيها لينُ مُنْسحَبِ",19,"ب",1,0],["قد وَصَلَتْ قارُورتي","وحاجتي ما وَصَلَتْ",20,"ت",1,1],["قد وعدتني النفس جدوى له","إن شئت بعد اللَّه وظَّفْتُها",21,"ت",3,0],["قد وصفْنا التي هويتَ بحقٍ","بارزٍ للعيون كل بروز",22,"ز",1,0],["قد وَلعُوا بالشيخ يؤذونهُ","عجَّله اللَهُ إلى رَمْسِهِ",23,"س",2,0],["قد وسطتم وفقتمُ وتقدم","تم فأنذرت حاسداً أن يموقا",24,"ق",2,0],["قُدومُ سعادةٍ وقُفولُ يُمْنٍ","هي السَّرَّاءُ تَنْسَخُ كُلَّ حُزْنِ",25,"ن",1,1],["قد وصفْنا فمن غدا يتمارى","فليزُرْنا نُقِمْ له البرهانا",26,"ن",2,0],["قُدومُكَ بَدَّدَ عَنّا الأَسى","كَما يَكشِفُ القَمَرُ الغَيهَبا",27,"ب",2,0],["قَد وَجَدتُ اليَأس وَالحَيرَةَ لَكِن لَم أَجِدني","فَهَلِ الجَهلُ نَعيمٌ أَم جَحيمٌ لَستُ أَدري",28,"ي",1,0],["قَد وَهَبَتني روحَها كُلُّها","وَلَم تَخَف أَنّي أُضَحّيها",29,"ي",3,0],["قُدوماً بِهِ الدُنيا أَضاءَت وَأَشرَقَت","بِبِشرٍ وُجوهٍ أَو بِضَوءِ مَباسِمِ",30,"م",1,0],["قَد وَجَدنا الحَبيبَ يَصفى وِداده","وَحَمِدنا ضَميره وَاِعتِقا",31,"ق",2,1],["قد وددنا لو كنت للعلم تفدى","بالوف تحيا من الجاهلينا",32,"ن",2,0],["قد وقع الضوء على وجهه","فما ازال الضوء من لبس",33,"س",1,0],["قد وجدت الجمود للهلك ادنى","ووجدت الحياة في الحركات",34,"ت",1,0],["قُدوَةُ أَهل الدِين إِلّا أَنَّهُ","في أَدب الدُنيا المِثالُ لِمُحتَدى",35,"ا",1,0],["قَد وَدَّ نوحٌ أَن يُباسِطَ قَومَهُ","فَدَعا إِلَيهِ مَعاشِرَ الحَيوانِ",36,"ن",1,1],["قُدومُكَ في رُقِيِّكَ في نَصيبي","سُعودٌ في سُعودٍ في سُعودِ",37,"د",1,0],["قَد وَرَّثَ العالَمَ حَيّاً فَما","غادَرَ مِن فَجٍّ وَلا مِن سَبيل",38,"ل",1,0],["قَد وَكَّلَ اللَهُ الكَريمَ وَعَينَهُ","بِكِ فَاِحسِبيهِ عَلى كَريمِ رِحابِه",39,"ب",2,0],["قَد وَدَّ جَمالَكَ أَو قَبَساً","حَوراءُ الخُلدِ وَأَمرَدُهُ",40,"د",2,0],["قَد وُئِدَت في الصِبا","وَاِنبَعَثَت في الهَرَم",41,"م",1,0],["قَد وَقَفوا لِلمَها","فَاِنسَرَبَت مِن أَمَم",41,"م",1,0],["قَد وَحَّدَ الخالِقَ في هَيكَلٍ","مِن قَبلِ سُقراطَ وَمِن قَبلِ عاد",42,"د",1,0],["قَدْ وَلَدَتْ أُمُّها الخوات لها","فَواقِعَ مِنْ صُفْرٍ ومِنْ حُمْرِ",43,"ر",1,0],["قَد وافَقوا الوَحشَ في سُكنى مَراتِعِها","وَخالَفوها بِتَقويضٍ وَتَطنيبِ",44,"ب",1,0],["قَد وَجَدناهُ مُفضِلاً فَحَطَطنا","حَيثُ لايَكذِبُ المُرَجّي رَجاؤُه",45,"ا",3,0],["قَد وَلَدنَ الأَعداءَ قِدماً وَوَرَّث","نَ التِلادَ الأَقاصِيَ البُعَداءَ",46,"ا",2,0],["قَد وَقَفنا عَلى الدِيارِ وَفي الرك","بِ حَريبٌ مِنَ الغَرامِ وَمُثرِ",47,"ر",1,0],["قَد وَفَّرَت حَظَّكَ مِن إِخوَةٍ","أُمُّكَ إِذ زَوَّجتَها مُتعَه",48,"ع",2,0],["قَد وَجَدنَ السُلُوَّ بَرداً سَلاماً","إِذ وَجَدنا الهَوى عَذاباً أَليما",49,"م",2,0],["قَد وَرِثتَ العَلياءَ عَن أَردَشيرٍ","وَقَباذٍ وَعَن أَنوشَروانِ",50,"ن",1,0],["قد وَهَى سِتْرٌ رَقيقٌ","وقضى وِدٌّ عَليلُ",51,"ل",1,0],["قَد وَجَدْنا لأحمدَ بنِ سُليما","نَ يداً ثَرَّةً ووجهاً طَليقا",52,"ق",2,0],["قد وَفَتِ المُزْنُ بميعادِها","وخَصَّتِ الرَّوْضَ بإسعادِها",53,"د",3,1],["قَد وَدَّعَتكَ مِنَ الصِبا نَزَواتُهُ","فَاِحذَر فَما لَكَ بَعدَهُنَّ مُقامُ",54,"م",1,0],["قَد وَجَدنا بِها نَعيماً مُقيماً","فَغَدَت جَنَّةً لِمَن يَصطَفيها",55,"ي",3,0],["قَد وَجَدنا فيكَ الجَمالَ وَلَكِن","فيكَ حُسنٌ وَلَم نَجِد فيكَ حُسنى",56,"ن",2,0],["قد وَجَدَ الضليلُ نورَ الهُدى","يا حلمه يا نجمه يا سناه",57,"ا",2,0],["قدّوا الدروعَ بقضبهم فكأنّما","صَبّوا بها خُلُجاً على غدرانِ