{"poems":[[55,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[72,"رب ثقيل لبغض طلعته","https://www.aldiwan.net/poem42768.html","المنسرح"],[91,"أنا لولا الرحمن والعفو منه","https://www.aldiwan.net/poem45102.html","الخفيف"],[87,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[50,"رب ليل قطعته بانتحاب","https://www.aldiwan.net/poem10793.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85605","السريع"],[133,"كفنوه وادفنوه أسكنوه","https://www.aldiwan.net/poem67458.html","الرمل"],[215,"قد قضينا في العيد يوما سعيدا","https://www.aldiwan.net/poem46224.html","الخفيف"],[396,"أحمد السقاف إن شئت الوصال","https://www.aldiwan.net/poem54535.html","عموديه"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137337",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119974","المنسرح"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216925","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143788","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53110","المديد"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205052","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89352","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"]],"verses":[["رُبَّ ثَنايا بَرَدَت","لِذي جَوىً ما بَرَدا",0,"د",2,0],["رُبَّ ثَقيلٍ لِبُغضِ طَلَعتِه","أَخشاهُ حَتّى كَأَنَّهُ أَجَلي",1,"ي",1,1],["رب ثبت رجلي رب وسلمني","عليه يا رب كل العباد",2,"د",1,0],["رُبَّ ثُكلٍ أَساكَ مِن قُرحَةِ الثُك","لِ وَرُزءٍ نَسّاكَ رُزءاً جَليلا",3,"ل",2,0],["رُبَّ ثاوٍ في الظُبى مُمتَنِعٍ","سَلَّهُ المِقدارُ مِن جَفنِ الحَذَر",4,"ر",1,0],["رُبَّ ثَوبٍ نَزَعتُهُ بِعَصيرِ ال","دَمعِ بَدَّلتُ غَيرَهُ مِن ثِيابِ",5,"ب",1,0],["رب ثَقيل جاءَني زائراً","فكانَ حتى قامَ كابوسا",6,"س",2,0],["رُب ثارٍ رُبَّ عارٍ رُبَّ نارٍ","حركت قلبَ الجَبَان",7,"ن",1,0],["رب ثغر في العيد جاد بثغر","هو أشهى ما يمنح العنقود",8,"د",1,0],["رب ثبتنا على دين النبي","خير خلقك أحمد مولى بلال",9,"ل",1,0],["رُبَّ ثغرٍ رصَّعتهُ بابتسامِ","كان مجرى للكهرباء عجيبا",10,"ب",2,0],["رَبَّ ثرةٍ ووجهٍ","ندٍ لسؤاله طليقِ",11,"ق",1,0],["رُبَّ ثَورٍ رأيْتُ في حُجْرِ نملٍ","وقطاةٍ تُحمّلُ الأثقالا",12,"ل",2,0],["ربّ ثبت على ولاها فؤادي","يوم يهوي من لم يجيىء بولاها",13,"ا",3,0],["رب ثوبٍ من المذل","ة فيه كسيته",14,"ت",2,0],["ربّ ثَغْرٍ قد أباح له","ربه بالطعن في ثُغَرِه",15,"ر",2,0],["رب ثقيل الظل بين الورى","لو يرتقي الأطواد تستثقلهْ",16,"ل",2,1],["رب ثغر إذا بدا ذاب قلبي","مدمعاً في هواه كان كتوما",17,"م",2,1],["رب ثغر عن كَوثر الخُلد ينبي","تتشهى رضابَه الصَهباء",18,"ا",2,0]]}