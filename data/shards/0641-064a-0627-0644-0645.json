فِي المُنُوفِيَّةِ الضَّحُوكِ وُجُوهٌ","أَصْبَحُوا بِالنَّدَى وُجُوهَ الزَّمَانِ",2,"ن",1,0],["فِي المَجْدِ أَثَلَ مُنْجِبُوهُ قَبْلَهُ","ولَهُ الغَداةُ كَما لَهُمْ تَأْثِيلُ",3,"ل",1,0],["في المُلك تفعل من فظائع جَورها","ما لم تقُل وتقول ما لم تفعل",4,"ل",1,0],["في المدحِ ذمٌّ لكل مُمتدحٍ","حاردَ عند احتلابه حَلبُهْ",5,"ب",2,0],["في المَنزِلِ المَهجورِ أَذكُرُكُم","فَأَخالَني في جَنَّةِ الخُلدِ",6,"د",1,1],["في المسرح المشهود اسمع رنة","فاخال ان الريح هبت تعصف",7,"ف",1,0],["في المال فيه وحده خلاصكم","لا بدّ منه اليوم أو لا فغدا",8,"ا",1,0],["في المهرجان العبقريّ تسايرت","أعلامها وتلاقت الأنوار",9,"ر",1,0],["في المسلمين وجيه","وفي بنى القبط غالى",10,"ل",2,0],["في المَهدِ يُستَسقى الحَيا بِرَجائِهِ","وَبِقَصدِهِ تُستَدفَعُ البَأساءُ",11,"ا",2,0],["في المَوتِ ما أَعيا وَفي أَسبابِهِ","كُلُّ اِمرِئٍ رَهنٌ بِطَيِّ كِتابِهِ",12,"ب",2,1],["في المعدنيات لنا حكمة","مخبوءة في الصدور",13,"ر",1,1],["في الماء سر عظيم لا يحسّ به","إلا الحكيم العليم الماهر الفطنُ",14,"ن",1,1],["في المعدنيات والنبات ولم","يغادروا معدناً ولا عشبا",15,"ب",2,0],["في المَحَلِّ الجَليلِ مِن سَلَفَي عَب","دِ مَنافٍ وَالسُؤدَدِ المَرفودِ",16,"د",1,0],["في المَحَلِّ الجَليلِ مِن رُتبَةِ المُل","كِ إِستَقَلَّت وَالمَذهَبِ المُستَقيمِ",17,"م",1,0],["في المَوتِ شُغلٌ لِكُلِّ حَيٍّ","وَأَيُّ شُغلٍ لِمَن تَفَكَّر",18,"ر",1,0],["في المَنصِبِ العالي وَبَي","تِ المَجدِ في حَسَبٍ وَدينِ",19,"ن",1,0],["في المُلكِ لَم يَخرُجوا عَنهُ وَلا اِنتَقَلوا","مِنهُ فَكَيفَ اِعتِقادي أَنَّهُم هَلَكوا",20,"ك",3,0],["في المَنايا وَهُنَّ رزءُ البَرايا","تَتَساوى الرعاع وَالسروات",21,"ت",1,0],["في المثل الأعلى وحبِّ الخلودْ","حمّلتهُ العبءَ الذي لم يَهُنْ",22,"ن",1,0],["في المغرب الأقصى فتىً من نورِها","قدَحَتْ به كفُّ السماءِ زِنادا",23,"د",2,0],["فِي الْمَسيحِ الْمَلِيكِ رَبِّ الْبَرَايَا","مَنْبَعُ الْحُبِّ مَصْدرُ الأَنْوَارِ",24,"ر",1,0],["في المَجْمَعِ اللُّغويِّ وَفَّى جَاهداً","قِسْطيْهِ مِنْ أَدَبٍ وَعِلمٍ وَافرِ",25,"ر",1,0],["فِي المُعْضِلاَتِ يَرَى بِثَاقِبِ رَأْيِهِ","مَا غَيَّبَتْهُ مِنْ وُجُوهِ حَقَائِقِ",26,"ق",1,0],["فِي المُخْلِصِينَ سَلاَمٌ","عَلَى بَنِي القَلْقِيلِ",27,"ل",1,1],["فِي الْمُسْلِمِينَ وَفِي النَّصارَى مَالَهُ","إِلاَّ وَليٌّ صَادِقٌ وَوَدُودُ",28,"د",1,0],["في الماء والجو آلات مسخرَّة","تصوِّر الموت ألوانًا وأشكالا",29,"ل",2,0],["في الماء؛ فَهْي كالسِّراج الخابي","وصاح صوت الدهرِ كالغراب",30,"ب",1,0],["في الماءِ كالبلَّور، يَر","قُصُ موجُه في بحره",31,"ر",2,0],["في المال زينٌ وفي الأولاد مكرمةٌ","والسقم ينسيك ذكر المال والولد",32,"د",1,0],["في المَحَلّ الجَليلِ مِنْ رُبْتَةِ المُلْ","كِ استَقَلّتْ، وَالمَذهبِ المُستَقيمِ",33,"م",1,0],["* في المجموع والحلّة: \"وَصاغوا مِثالَ الثُرَيّا عَلَيهِ","كَواكِبَ تَقضي لَنا بِالنَّجاحِ\"",34,"ح",1,0],["في المنصبِ العالي، وبيتِ","تِ المَجْدِ، في حَسَبٍ وَدِينِ",35,"ن",1,0],["في المُزَنّى الَّذي حَشَشتُ بِهِ","مالَ ضَريكٍ تِلادُهُ نَكِدُ",36,"د",1,0],["في المُمحِلاتِ غَمامٌ لا يُقالُ وَنى","وَفي الحُروبِ حُسامٌ لا يُقالُ نَبا",37,"ب",2,0],["في المسكِ والفُسْتقِ والْجُلاَّب","كأنها أَلسِنة الأحباب",38,"ب",1,0],["في الماء غرقى وبيتي مقفر شعث","فقر العراص فلا ماء ولا مطر",39,"ر",1,0],["في المدح منها عليك درع","من الثنا سائغ وفاضل",40,"ل",1,0],["فَيا لَمياءُ مَن لِقَتيلِ شَوقٍ","مُطاحٍ في الهَوى دَمُهُ جَبارُ",41,"ر",1,0],["في المهد لقنت الشهادة وهي لي","زاد وتكفيني بها يكفيني",42,"ن",2,0],["في المقادير تحكم الأقدارُ","ولذي اللبّ في الأمور اعتبارُ",43,"ر",1,1],["في المقلتينِ بدت مزخرفةً","أحلامُها كزخارفِ الجنّ",44,"ن",1,0],["في ألمِ الحبّ لذةٌ خلبت","قلبي وتحتَ السيوفِ أحلاها",45,"ا",3,0],["في المُونِقَيْنِ رُوائِهِ وثَنَائِهِ","ما تَشْتَهيهِ نَوَاظِرٌ وَمَسَامِعُ",46,"ع",1,0],["فيا لمصائبٍ عم سنة أحمدٍ","وأحرم منها كل راوٍ وناقل",47,"ل",1,0],["فَيا لمكانةٍ ما إِن حَباها","لِغيركَ قبلُ أيّا كانَ أَصلا",48,"ل",2,0],["في المغيريّة الرَدئية قَوم","لَيسَ في بعدهم عَن الحَقّ مِريه",49,"ه",1,1],["في المَطلِ مَعنىً لَستَ تَعرِفُهُ","لا زالَ مَمطولاً غَريمُهُمُ",50,"م",1,0],["في المَطلِ تَعذيبٌ يَطيبُ لَهُ","يا طيبَ ما فيهِ نَعيمُهُمُ",50,"م",1,0],["فيا لمعمّر قد شيدت مناقبُهم","ذي المكرمات فلا وانٍ ولا ضرَعُ",51,"ع",1,0],["في المال والأولاد والأدواء","أطلب منك منهج الهداء",52,"ا",2,0],["في المجد ما من راية","إلا تلقاها عرابه",53,"ب",2,0],["في المسجد المصطفى الميمون للشعرا","منصة أشعرتنا باعتلا الأدب",54,"ب",1,0],["في المَكرُوماتِ قَفا أباً يُرضيه أَنَّه","في اكتسابِ المكرماتِ قفاهُ",55,"ه",1,0],["في المكرُمَات قَفا أباً يُرضيه أن","نَه في اكتِسَاب المَكرُمات قَفَاه",56,"ا",2,0],["في المَعرّات يهبّو","نَ شمالاً وجنوبا",57,"ب",2,0],["في الملك والملكوت عز وجل عن","معنى الشريك وما هي الأوثان",58,"ن",1,0],["في المَكرُماتِ لهُ يدٌ","وإلى الصَّوابِ لهُ قَدَمْ",59,"م",1,0],["في المال والفروج والرقاب","من غير سنة ولا كتاب",60,"ب",1,0],["في الماء إذ يقول فيما تقرا","خلق منه نسبا وصهرا",60,"ر",2,0],["في المهر إلا نلته عقوبة","وحد فيه عدة محسوبة",60,"ه",1,0],["في المحكم المنزل من كتابه","وكان من أول من بدا به",60,"ه",1,0],["في المَجد غرتنا مبينة","للناظرين كأَنَّها البَدرُ",61,"ر",1,0],["فيألم للغوات أشد مما","يفوت على الحريص من الفضال",62,"ل",1,0],["في المشرقَين نشرتِ نورَ هُداكِ","والغربُ عباقٌ بطيبِ شذاكِ",63,"ك",1,1],["في المَبادي وَالخِتامِ","وَهوَ في جَدواك راتعْ",64,"ع",1,0],["فيا لمواقف لا تشتهى","تكاد تكون بلا منتهى",65,"ه",2,1],["في المهد أنت الآن مطلع على","جاري مسائلها وسائر حالها",66,"ل",3,0],["في المعرض الفخم عنها خير ما نقلوا","لسامعين وما أبدَوا لرائينا",67,"ن",2,0],["في المغرب الأقصى السلام تعده","ولجيرةٍ خلف التخوم وآل",68,"ل",1,0],["في الممكن الميسور عونكمُ على","ما طال مرحلة وعز طلابا",69,"ب",2,0],["في المال زين وفخر إن ظفرت به","والبؤس والنحس والادبار في الأدب",70,"ب",1,0],["في الملحدين عداتنا لنجاز","حيث الحقيقة لم تدِن بمجاز",71,"ز",1,1],["فيا لمهذب ما أخطأته","يد الأيام والقدر انتقادا",72,"د",2,0],["في المَجدِ والشَرَفِ العالي ذوي أَمَلٍ","وفي الحياةِ وفي الأموال زهّادِ",73,"د",1,0],["في المعاني واللفظ تمّت بياناً","يا بديعَ الإِطناب والإِيجازِ",74,"ز",1,0],["في الموقفِ الضنكِ الّذي من هولهِ","فيهِ الفرائضُ تقشعرّ وترعدُ",75,"د",1,0],["في الملمات كنت قلعة صدق","في علاها يرف ذاك اللواء",76,"ا",2,0],["فِي الماءِ يَفْرُقْنَ العُبابَ الغَلْفَقا","ضَوابعاً تَرْمِي بِهِنَّ الرَزْدَقا"