{"poems":[[72,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[47,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[47,"أجدك إن لمات الخيال","https://www.aldiwan.net/poem65568.html","الطويل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[33,"وناهدة الثديين قلت لها اتكي","https://www.aldiwan.net/poem42562.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21046","الطويل"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[385,"جوانحه جمر ومدمعه سكب","https://www.aldiwan.net/poem48813.html","الطويل"],[443,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34428","الطويل"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132420","الطويل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44960","الطويل"],[2479,"","https://poetry.dctabudhabi.ae/diwan/poem/145980","الطويل"],[2553,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123505","الطويل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124621","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33611","المجتث"],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6102,"صراع","https://www.poetsgate.com/ViewPoem.aspx?id=184432",""]],"verses":[["فَما اِزدادَ ذاكَ القَلبُ إِلّا تَمادِياً","وَما اِزدادَ ذاكَ الدَمعُ إِلّا تَدَفُّقا",0,"ق",2,0],["فَما اِزدادَ إِلّا جُرأَةً وَصَرامَةً","وَأَيقَنتُ أَنَّ الأَمرَ مِنهُ هُوَ الجِدُّ",1,"د",1,0],["فَما أَزرى بِها طولُ التَنائي","وَلا أَنساكَها قِدَمُ اللَيالي",2,"ل",2,0],["فما ازدهتكَ ولا غرَّتْكَ زينتُها","وعشتَ عيشَ حثيثَ السيرِ مقتصرِ",3,"ر",1,0],["فَما اِزدَدتُ مِنها غَيرَ مَصِّ لِثاتِها","وَتَقبيلِ فيها وَالحَديثِ المُرَدَّدِ",4,"د",1,0],["فَمَا ازدادَ شُرباً مِنهُ إلاَّ أَثابَهُ","بهِ عَطَشاً يَرويهِ في كُلِّ مَصدَرِ",5,"ر",1,0],["فما ازددتُ إلّا بالتمادي تجاهلاً","كأنيَ في شرقٍ أميلُ إلى الغرب",6,"ب",1,0],["فَما إِزدَدت إِلّا علة وَصبابَةً","وَلَم تَنقض البَلوى وَما نَفَع الطب",7,"ب",1,0],["فما أزاك دائما أحبّكم","حتى أرى موسّدا في كحدي",8,"د",2,0],["فَما أَزهرَت مِن فَضلهم رَوضَةُ المنى","وَقَد هُدَّ مِن أَفضالِهِم حائِطُ الرَجا",9,"ج",2,0],["فما أزمة تشتد إلا تفرجت","ولله لطف عرفه يتضوع",10,"ع",1,0],["فَما اِزدَحَمتَ غَيرَ عَلى وَردِ مَنهَل","دَنا وَردَها تَرعى النَجيلِ مِنَ الحِمض",11,"ض",1,1],["فما أزداد الا جرأة وصرمة","وأيقنت إن الأمر منه هو الجد",12,"د",1,0],["فَما أَزالُ عَلى شَحطٍ يُؤَرِّقُني","طَيفٌ تَعَمَّدَ رَحلي حَيثُما وُضِعا",13,"ع",2,0],["فما ازددت في العصيان الا تجريا","وعن طاعة الرحمن أنفر كالوحش",14,"ش",1,0],["فما ازداد سنا زاد علما ونائلا","فشب حليما كل اخلاقه سهل",15,"ل",1,0],["فما أزيدكَ يا مُن","تَهى المُنى فأَزِدني",16,"ن",2,0],["فَما ازدَدتُ إِلَّا حَسرَةً فَوقَ حَسرَةٍ","وَما نِلتُ إِلَّا ما تَهَيَّبَهُ العُمرُ",17,"ر",1,0],["فَمَا ازْدَدْتُ مِنْ حَرٍّ بِبُرْكَانِ فَيحِهَا","سِوَى مَا أَثَارَتْ مِنْ حَرِيقٍ لِأُضْرَما",18,"م",2,0]]}