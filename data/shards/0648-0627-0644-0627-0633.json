/diwan/poem/118778","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91193","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91543","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92372","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199021","الرجز"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33125","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95340","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102959","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35506","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69977","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45136","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94893","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117231","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133141","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104540","الخفيف"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103161","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52159","البسيط"],[4698,"أنفاسُ أبها ..","https://www.poetsgate.com/ViewPoem.aspx?id=28639",""],[4782,"رفات قلب","https://www.poetsgate.com/ViewPoem.aspx?id=200883",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4888,"في ظل وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207742",""],[5074,"أين أصبح الشّعر","https://www.poetsgate.com/ViewPoem.aspx?id=153926",""],[5156,"واحر بي من فراق قوم","https://www.poetsgate.com/ViewPoem.aspx?id=99209",""],[5183,"خميلة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=185682",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5502,"إن كنت تبحث عن تراث عمان","https://www.poetsgate.com/ViewPoem.aspx?id=124955",""],[5538,"شم النسيم موافق الأفراح","https://www.poetsgate.com/ViewPoem.aspx?id=142625",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5830,"فِي المَجْدِ ْمُسْتَبَقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201192",""],[5907,"تعب ضيقه!","https://www.poetsgate.com/ViewPoem.aspx?id=176258",""],[5939,"حبيبتي تغارُ من نفسها!","https://www.poetsgate.com/ViewPoem.aspx?id=178581",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[5970,"عش غريباً فالعيش محض غريب","https://www.poetsgate.com/ViewPoem.aspx?id=130596",""],[161,"شهادة ميلاد آدم","https://www.poetsgate.com/ViewPoem.aspx?id=175568",""],[6093,"قليل_ كثير","https://www.poetsgate.com/ViewPoem.aspx?id=206057",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""]],"verses":[["وَالأَسوَدُ المَلموسُ قَد","جابوا عَليهِ الرُكُنا",0,"ن",2,0],["وَالأُسدُ تَرتَكِزُ القَنا","فيها وَتَرتَبِطُ الخُيولا",1,"ل",2,0],["وَالأُسدُ لَولا فِراقُ الأَرضِ مااِفتَرَسَت","وَالسَهمُ لَولا فِراقُ القَوسِ لَم يُصِبِ",2,"ب",1,0],["والآس حفَّ غداره من حوله","عن كلِّ من يهوى العِذارَ قد اعتذرْ",3,"ر",1,0],["والأُسَاةِ الشُّفَاةِ للداءِ ذِي الرِّيبَ","ةِ والمُدرِكيِنَ بالأَوغَامِ",4,"م",1,0],["والإسرائيليّ يقول الراجح","أنا عليكم حيث أني الرابح",5,"ح",1,0],["وَالأَسى قَبلَ فُرقَةِ الروحِ عَجزٌ","وَالأَسى لا يَكونُ بَعدَ الفِراقِ",6,"ق",1,0],["والأساطيلُ في الزواخر يرمي","بلدَ الروم غَزْوُها بالدَّمارِ",7,"ر",1,0],["وَالأَسى في الضُلوع أَشبَه شَيء","بِكَ لَما قَذفت بِالنيران",8,"ن",1,0],["والأُسْدُ كلُّ الأُسْدِ فيه فَوارِسٌ","والأرضُ كلُّ الأرضِ فيه قَساطل",9,"ل",1,0],["والأُسْدُ فاغِرَةٌ تُمَطّي نِيبَها","والدّهْرُ يَنْدُبُ شِلْوَهُ المأكولا",10,"ل",2,0],["وَالإِسمُ لَفظٌ أَتاكَ القائِلونَ بِهِ","نَأى وَلَم يَدنُ لِلمَعنى وَلم يَطُرِ",11,"ر",1,0],["وَآلُ إِسرالَ غادَوا في مَدارِسِهِم","تِلاوَةً وَمُحالٌ كُلُّ ما دَرَسوا",12,"س",3,0],["والأسى الخالدَ من ماضٍ عفا","والهوى الثائرَ في قلبٍ تداعى",13,"ع",2,0],["والأسد الخادر في البوادي","والنمل فيما اتخذت من واد",14,"د",1,0],["وَالأَسَى مِلْءُ مِسْمَعِي كُلَّمَا تُو","حِي وَفِي أَضْلُعِي اقْتِدَاحٌ زِنَادِ",15,"د",1,0],["وَالأَسَى بَعْد رَائحٍ لَمْ يَكُنْ في","غَيْر ذَا الْخَطْب كَالأَسَى بَعْدَ غَادي",15,"د",2,0],["وَالآسُ إِن كُلُّ نَورٍ","ذَوى وَفيهِ اِخضِرارُ",16,"ر",1,0],["والاستقامة في كسر مزلزلة","يا جابر الكسر أدركتها على الزلل",17,"ل",1,0],["والاستقامة في كسر مزلزلة","يا جابر الكسر أدركها على الزلل",18,"ل",1,0],["والاسد ترجف في الغابات ان ندب ال","ملهوف باسمك في قفر ولا عجب",19,"ب",1,0],["والاسد كم امت شريف رحابه","ونقابها بوصيده الحصباء",20,"ا",2,0],["والأسد في غاباتها من بأسهم","في رحبهم يتوسدون وصيدا",21,"د",2,0],["وَالإستغاثةُ مَعناها تشفّعنا","بِهِ إلى اللَّه فيما نرتجيه بهِ",22,"ب",2,0],["والأسَلُ السُّمرُ وبيضُ الظُّبا","دونَ العِدا والضُمَّرُ الشُزَّبُ",23,"ب",1,0],["والا سلوا قلبي فاني بعثته","رسولا باخبار الغرام اليكم",24,"م",1,0],["والأسد رابضة ترا","قبكم بعين المزدرين",25,"ن",1,0],["وَالآسُ مينَةَ عِذارٍ","بِخَدِّ ظَبيٍ غَديرِ",26,"ر",1,0],["وَالأَسْوَدُ التِّينِيُّ يُشْبِهُهُ","وَلَيْسَ فِيمَا أَدَّعِي كَذِبُ",27,"ب",1,0],["والأسرة الموفون","ما منهم يمينا من يمين",28,"ن",1,0],["وَالآسُ يَلْتَثِمُ البَنَفْسَجَ عارِضاً","واليَاسَمِينُ يُغازِلُ السَّوسَانا",29,"ن",2,0],["والأسْد قَدْ تَنْزاحُ عن غاباتِها","لِتُعزّ أطْرافاً لَها وجَوَانِبا",30,"ب",2,0],["وَالأُسدُ تَهرُبُ مِن قَرصِ الذُّبابِ وَما","أَغرى خِساسَ الوَرى بِالسادَةِ النُّبُلِ",31,"ل",1,0],["وَالأَسَدُ العُلوِيُّ لَو بارَزَهُ","هَوى عَلى الجَبهَةِ مَخلوعَ الحَنَك",32,"ك",1,0],["والأسدُ قد فقدت لأجلك بأسَها","فغدت براثنُهنَّ كالأَظلافِ",33,"ف",1,0],["وَالآس أَشبه بِالعذار فَحسبنا","مِن ورده بِظلاله اِسترواحُ",34,"ح",1,0],["وَالا سَلوا عَنّا النَسيمَ فَانَّهُ","يَمُرُّ فَيُبدي ما سَتَرنا وَيَكشِفُ",35,"ف",1,0],["والأُسْدُ إن كان يومَ الصَّيْدِ يُبْصِرُها","يُقَدْنَ قُدّامَه قَوْداً بآذان",36,"ن",1,0],["والأَسى مِن هَواهُ مِث","لُ الأَسى مِن مِثالِهِ",37,"ل",2,0],["وأَلا سَعى سَعيَهُ","فأنصَفَنا وانتَصَف",38,"ف",1,0],["والاستقامة على النهج القويم","صراطك الحق خال عن عوج",39,"ج",1,0],["والأسد تلقى مثلها مني إذا","لاقيتها بقوى يد وجنان",40,"ن",1,0],["والأُسْدُ بارِقُةُ الأَلحاظِ فِي أَجَمٍ","من القنا بِحَبِيكِ البَيْضِ مُشْتَعِلِ",41,"ل",1,0],["والأُسْدُ تزْأَرُ والراياتُ خافِقَةٌ","كَأَنَّها مُثْبَتاتٌ فِي قُلُوبِهِمُ",42,"م",1,0],["والأُسْدَ فيها نجدةً وأنفساً","إن ركِبتْ أو دُعيتْ لتنزِلا",43,"ل",2,0],["والأُسدُ لم تظفَر بحاجِ أكفّها","حتى تجوبَ وتهجرَ الأغيالا",44,"ل",2,0],["والأسود الملثوم أحوالَه","من كلّ أَوبٍ فِرقٌ تلتقي",45,"ق",2,0],["والأسى ما بذلتُ فيه كنوزَ الد","مع أو ما ضيَّعتُ قُرط الملامِ",46,"م",1,0],["وَالآسُ في الخُضرَةِ فَيروزَجٌ","وَالوَردُ في الحُمرَةِ مَرجانُ",47,"ن",1,0],["وَالآسُ إِن هُوَ جاءَنا بِزَبَرجَدٍ","وافى إِلَينا الياسَمينُ بِمَرمَرِ",48,"ر",1,0],["وَالأَسرُ إِحدى المَيتَتَينِ وَطالَما","خَلَدوا بِهِ فَأَعدَتهُم أَحياءَ",49,"ا",2,0],["والأسرُ فيه نُولدْ","والبيتُ خيرُ مسجِدْ",50,"د",1,0],["والأسْدُ في تودُّدْ","للحُمْرِ كي تُمهِّدْ",50,"د",1,0],["والأُسْدُ تزأرُ في سُروجِ جِيادِه","والعِينُ تبغَمُ في حِجالِ نِسائِهِ",51,"ا",3,0],["والأسدُ لَولا خَوفُ بَطشَتِها","وَنَفاذُها سُوِّين بالبهمِ",52,"م",1,0],["وَإلّا سَقيطُ الدرّ زعزع سِلكَهُ","غُصونٌ تثنّيها الرّياحُ النّوافحُ",53,"ح",1,0],["والإسم في الرسم من الغيب بدا","مُسَلَّطاً عليك مثل الطلسمِ",54,"م",1,0],["وإلا سوف تندم يا نديمي","لفوت الحظ في زمن الثقاف",55,"ف",1,0],["وَإِلّا سَقاها جودُها في ضَريحِها","فَقَد كانَ مِثلَ الغَيثِ في اللَزَباتِ",56,"ت",1,0],["والأسد في حرب الصبابة كم هوت","قتلى وكان الفوز للغزلان",57,"ن",1,0],["والإستماتة في الوغى كضراغم","أبداً تحن لحومة الهيجاء",58,"ا",2,0],["وَالأُسد تومي بِالسُجود لِسَيفه","في كُل معترك كَليل غاسق",59,"ق",1,0],["وَالاسم وَاللقب المَنصور لَفظهما","يُومي إِلى أَن مَن عاداكَ مَقهور",60,"ر",1,0],["والأسرُ إن كان يُسْلي ذا الهوى فأنا","أسري يهيّجُ أشجاني وأشواقي",61,"ق",2,0],["والأسرُ إن كان لا يُبقي هَوىً معه","إنّ الهوى معه عندي أنا باقِ",61,"ق",1,0],["وَالاسم أَن تَعودَهُ في وكره","وَلَم تَكُن تَعرف كُنهَ أَمره",62,"ه",1,0],["والأُسدُ تمشِى معَ الآرامِ خاضِعَةً","يا صاحبَ الخوفِ إنّ الخوفَ قد بادا",63,"د",2,0],["والآسُ صُدْغ للحبيب مُعطَّفاً","والخدُّ ورد مُشرقاً كشهاب",64,"ب",1,0],["والأسد رابضةٌ بها من حولنا","ولها علينا صولةٌ وزئير",65,"ر",1,0],["وَالآسُ غَداَ مُحَدّدَ الآذَانِ","كالمُسْتَرِقِ",66,"ق",1,0],["وَالآسُ في كَفّي أُحَيِّيهُمُ","مِثلَ شَوابيرَ بَني هاشِمِ",67,"م",1,0],["والأساطير متى قا","مت وغنت في العقول",68,"ل",1,0],["وَالاسم وَعَيشك مستعمل","لِحال القِتال وَحال الدعه",69,"ع",2,0],["وَالأُسْدَ إِنْ قَاسَرْنَنَا القَساوِرا","لاقَيْنَ قِرْضابَ الشَبَا قُناصِرا",70,"ر",2,0],["والاستعارة بئس عار بل وقد","قل الذي منه يرام معونَهْ",71,"ن",2,0],["والأُسدُ أولى بالعرين فكم","غدا يختال في خِيسِ الخِلافة سِيدُ",72,"د",1,0],["والاسم أصل عندهم للفعل","ووزن الاسم أصل وزن الفعل",73,"ل",1,0],["والاستحالة والامكان حكمها","وفق المشيئة أن شئت مقتصر",74,"ر",1,0],["والأسمرُ اللدنُ ذا عَشْرٍ وواحدةٍ","بين السبيلين لا عَبْلٌ ولا قَضِفُ",75,"ف",1,0],["والا سقاه واطعم الميسور","والحسن أولى به الإكسان",76,"ن",1,0],["والأسمر سعدون ابن صنهاجة الذي","له الفخر الهنتاتي عوني على الظفر",77,"ر",1,0],["والأسد المغوار يوم الوغى","تفرق من صولته الأشوس",78,"س",1,0],["والاسى ويلاه من نيرانه","قوم الاضلاع مني وبرى",79,"ا",1,0],["وَالأُسوَةُ المُصطَفى نَفسي الفِداءُ لهُ","بِمَوتهِ يَتَأَسّى البَدرُ وَالحَضَرُ",80,"ر",1,0],["والأسد في غاب القنا عابسةٌ","من فوق عقبان دوامي الأَنْسُر",81,"ر",1,0],["والأسد حول كِناسهن جآذر","تحت الصوارم والوشيج الأملد",82,"د",1,0],["والأسد في أُجُم القنا تغشى الوغى","من فوق عقبان تصيد الصيدا",83,"د",2,0],["والأُسد من فوق الأجادل غابها","أسلاتها وعلى المتون إضاء",84,"ا",2,0],["والأسد في الروع صرعى","بطعنه وبضربه",85,"ب",2,0],["وَالأَسوَدَينِ من اِستَسقى فَماتَ وَمَن","دَعا الرَسولُ عَلَيهِ بِالعَمى فَعَمي",86,"م",2,0],["والأسى والذلَّ والحرمان صبحا وعشيا","وسياط الظُلم تغزو دونها ظهراغبيا",87,"ي",2,0],["والاسمُ يُعربُ عما","لديه رثيٌّ وشبعُ",88,"ع",1,0],["والأسد تفغر حوله أفواهها","أبداً فتقذف دائب المرجانِ",89,"ن",1,0],["والآس عارضه والورد وجنته","والخمر ريقته بالرشف تسكرنا",90,"ن",2,0],["وَالآس في رَوضاتِهِ","مُستعبر وَكَذا خِلافه",91,"ف",2,0],["والإِستواءاتُ فَجَرّبوها","لكنَّما النُسَّاخُ غَيَّرَوها",92,"ه",2,1],["والآسُ خالطه الشقيقُ فكنّه بِيضاً","فكنّه بِيضاً وحُمرا",93,"ر",2,0],["والأسد ما بلغت معشار همته","والبحر عن ما حوى في العلم لم يزد",94,"د",1,0],["والاس نمامه يهوى الشقيق أما","تراه من عشق فيه يحاوره",95,"ر",2,0],["والا سألوي عن ودادك راغباً","وكم صاحب عن صاحبٍ جائر الوى",96,"و",2,0],["والأسلميُّ حاكمُ الشّريعه","ثمَّ ابنُ عيسى واسمه لهيعه",97,"ه",1,0],["وإلا سنى أنوار ختم بدرس من","تناهت له العلياءُ في الفضل والعلم",98,"م",1,0],["والاسد حول كناسها","ربضت وباتت تزأر",99,"ر",1,0],["والاسم الاعظم ان تبغ الدعاء به","اللّه فاسأل به مع حرف ميمهم",100,"م",1,0],["والأسدي وكلهم اماجد","ثم الطويل قبره مشاهد",101,"د",1,0],["والأسدي علي مفتي الشهبا","وكان شهما في المعالي ندبا",101,"ب",2,0],["وَالاِسمُ مِنهُ مُعرَبٌ وَمَبنِى","لِشَبَهٍ مِنَ الحُرُوفِ مُدنِى",102,"ن",2,0],["وَالاسمُ قَد خُصِّصَ بِالجَرِ كَما","قَد خُصِّصَ الفِعلُ بِأن يَنجَزِما",102,"م",2,0],["وَالأُسرَةُ الخَضراءِ وَالعيصِ الأَشِب","وَمِن هُذَيلٍ والِدي عالي النَسَب",103,"ب",1,0],["وَالأَسمَرُ الخطار يُبهجُ نَفسَهُ","وَيَسُرُّها لا الأَسمَرُ المُتأَوِّدُ",104,"د",1,0],["والأُسدُ إلا أنهم لم يُسأَموا","والزَندُ إلا أنهم لم يصلدوا",105,"د",3,0],["والإسم إن يعرب بحركات","فذاك قسمان كما سيأتي",106,"ي",1,0],["والإسم إن تعربه بالحروف","أيضاً على قسمين في المعروف",106,"ف",1,0],["وَالأَسى وَالعَناء سارا فَبادا","وَالصَفا وَالوَفاء أَبدى عُكوفه",107,"ف",2,0],["وَالأُسدُ لَولا بَطشُها وَزَئيرُها","لَرَأَيتَ أَلفاً في يَدي سرحان",108,"ن",1,0],["والأسد تزأر في المجال","والكلب في الميدان نادرْ",109,"ر",1,0],["والاسم ما دل على الموجود","فمازه من سائر المعدود",110,"د",1,0],["وَالاِسبِتارُ إِلى الدَوِيَّةِ التَأَموا","كَأَنَّهُم سَدُّ يَأجوجٍ إِذا اِستَجَروا",111,"ر",3,0],["والاسودِ عدةٌ كأركانِ كعبةٍ","ونجلِ يزيدٍ أسعدٌ هو يلثمُ",112,"م",1,0],["والأُسر في البول وعود أُسر","والحُصر في الغائط فاخبر خبرى",113,"ر",2,0],["والآس مخضر العذار كأنه","في خضرة الزهري قرط زبرجد",114,"د",1,0],["وَالأَسَد الوَرد وَالمكرّ وَالمَو","ت غرثان وَالكماة جُثي",115,"ث",2,0],["والإِسكَندَرُ إِغرانيقُ يَتبَعُهُ","وَسيمويسُ اِنجَلى يَهوي تَدَفُّعُهُ",116,"ه",1,0],["وَالاسدُ في غاياتها تَعنو لهُ","وَعنانها تَلقيهِ بَينَ بَنانِهِ",117,"ن",2,0],["وَالأَسد تَكمُن في الآجام رابِضَة","فَإِن تَثَب لَم يَفُتها حاضِر الأَجَل",118,"ل",1,0],["والآس قد داركالسياج على الورد","أم الخدّ حب يحفه خفرا",119,"ر",2,0],["وَالأَسَدِ الهَصّار","عِندَ الخُطوبِ السود",120,"د",1,0],["والأسعديُّ تلا بأرخٍ قُل جلا","قد جاءَ ماءُ الخير للبترونِ",121,"ن",1,0],["والآسُ والريحانُ قد صُفَّ وَقد","ألقى عليهِ كلُّ طاهٍ ماطَهَا",122,"ا",1,0],["وَالأَسى يَبعَث الأَسى مُستَفيضاً","كَدُموعي تَفيضُ فيضَ الغمامِ",123,"م",1,0],["والأسى والورد والخيرى ينعشنى","والأقحوان مع النسرين تسبيني",124,"ن",2,0],["والأسقع المشهور في الأنام","شيخ الملا وقدوة الأعلام",125,"م",1,0],["والاساطيل ضاق عنها المحيط ال","واسع العرض فامتلت خلجانه",126,"ن",2,0],["والأس آسٍ كاسمه","بنوره قد حسنا",127,"ن",2,0],["والآسُ في خدّه قد قام يُنشِدنا","تأمَّلوا واشكُروا البارِي الذي خَلقا",128,"ق",2,0],["والإستواءَ الذي جئنا بنكهتهِ","على الصدورِ دواويناً من الذِّكَرِ",129,"ر",1,0],["والأسى في نبضهِ عاث فسادًا","والرزايا اقتنصتْ عودًا طريا",130,"ي",2,0],["والا سمعنا صهيل ٍ للكرامه","بلمح البرق جينا فازعينا",131,"ن",2,0],["والأَسْرُ ذا مُرٌّ عدا أَسْرِ الهوى","كم كانَ أمرُ المُشتَهى مفعولا",132,"ل",2,0],["وَ الأَسْوَدُ الزِّنْجِيُّ عَنْتَرَةُ الفَلا","كَانَتْ قَصَائِدُهُ كَمَوْجٍ هَادِرِ",133,"ر",1,0],["والأسد والمزن والرواسي","والخفض والأمن والسكون",134,"ن",1,0],["والآس من تحت النسيم كأنه","مرح المليح بقده المياس",135,"س",1,0],["والاستواء فمعقول حقيقته","لا يمتري فيه إلاَّ بعض من خلقا",136,"ق",2,0],["والإستقامة مع بيان الشرع مع","سفر المصنف صاح والتبيان",137,"ن",1,0],["والآس قد فرش البسيطة مؤذناً","بجلوسنا لنهاية الإصباح",138,"ح",1,0],["والأسى مَنْهَلُ النفوسِ اللواتي","لم يَرُضها الزمانُ في نَكباتِهْ",139,"ت",2,0],["وَ الأَسْرُ يَعْزِفُنَا وَ الذُّلُّ يَنْزِفُنَا","وَ العَارُ رَاوَدَنَا غَطَّى لَنَا القِمَمَا",140,"م",2,0],["والا سوالف عشق مع حبة الخال","وذيك البروق اللي تزين نحرها",141,"ر",3,0],["والاستسلامُ في عشقي مصيرُكِ شئْتِ أو جَبْرا","أُريدُكِ بينَِ أحضاني وطَوَّقَ ساعدي الخَصْرا",142,"ر",2,0],["والاسم يظهر بالباب المقيم له","والباب ليس له يظهر به الأسنا",143,"ن",2,0],["والاسم اسم لمعناه وأوله","والاسم أسماؤه ما شئت من عدد",144,"د",1,0],["والاسم يظهر بالباب المقيم له","والباب ليس له يظهر به الأحد",144,"د",1,0],["وإلّا سوف أجفو الشعرَ كيلا","أُبَدِّدَ وقتَ عالَمِيَ المُهِمَّا",145,"م",2,0],["والأسى للسرور محض حليف","والعنا للهناء محض نسيب",146,"ب",1,0],["05- والاسمُ آدَمُ ابْنُ الجَدِّ مِنْ وَلَدٍ","بَاركْهُ رَبِّي وَقَلِّدْهُ الهُدَى صَدَقَةْ",147,"ق",2,0],["والأسى مثل جيشِ فتكٍ بروحٍ","بابتسامٍ تفرقُ الروحُ جَمْعَهْ",148,"ع",2,0],["وَ الأسودُ الدُؤَليُّ جُنَّ بِقبرِهِ","وَ علَا غَشيمٌ وَجهَنَا وَ المِنبَرَا",149,"ر",2,0]]}