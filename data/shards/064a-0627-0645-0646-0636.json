{"poems":[[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[95,"يا من تحيي مصر عالي شأنه","https://www.aldiwan.net/poem11294.html","الكامل"],[119,"البرق حاجر ام لبرق الشام","https://www.aldiwan.net/poem40593.html","عموديه"],[408,"يا واهب الجرد السلاهب","https://www.aldiwan.net/poem46913.html","مجزوء الكامل"],[532,"هذا أبو بكر صقلت حسامه","https://www.aldiwan.net/poem46008.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37859","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108538","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77209","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76126","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108295","الكامل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123839","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[5106,"مِنْ فَرْحَةِ الضَّوْءِ قَدْ ضَوَّأتُ أَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=137205",""]],"verses":[["يا مَن ضَرَبتَ بِسَهمٍ","في كُلِّ عِلمٍ وَفَنِّ",0,"ن",1,0],["يَا مَنْ ضَرَبْتُمْ بِالمُرُوءةِ وَالنَّدَى","مَثَلاً كَمَا يَهْوَى الكِرَامُ كَريَما",1,"م",2,0],["يا من ضحكت وقد بكيت لصده","ولهوت عن وجدي وعن آلامي",2,"م",2,0],["يا مَنْ ضياءُ كمالِهِ","ملأَ المشارقَ والمغاربْ",3,"ب",1,0],["يا منضباً قوساً بكفي أُحكِمَت","ومسدداً رمحاً بكفي قوِّما",4,"م",2,0],["يا مَن ضَعيفُ لِحاظِه بِسهامِها","قَهراً على الأُسْدِ الضّواري قد قَوي",5,"و",2,0],["يا من ضربتُ على قلبي مضاربها","واخترتُ حبل وريدي للخبا طنبا",6,"ب",2,0],["يا مَن ضَرَبتِ حِجابَ كِبرِك بَينَنا","إِنَّ التَعَزُّزَ في الغَرامِ تَذَلُّلُ",7,"ل",1,0],["يا مُنضِيَ الطَرفِ في مَيدان لذته","وَناضي الطَرفِ بَينَ الراحِ وَالرُود",8,"د",1,1],["يا من ضممت قوامه بيميني","وفديت ضم قوامه بعيوني",9,"ن",2,1],["يا منضي البكرات في طلب الغنى","ما أن تراقب أينها وكلالها",10,"ل",3,0],["يا من ضننت على العيون بلحظه","من شك فيك من الرماح لدانها",11,"ن",3,0],["يَاْ مَنْ ضَحِكْتَ سُدَىً فَاْرَقْتَ أَكْرَمَنَاْ","لَنْ تَلْتَقِيْ أَبَدَاً إِنْسَاْنَ أَخْلاْقِيْ",12,"ق",2,0]]}