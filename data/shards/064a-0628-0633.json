{"poems":[[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[93,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[91,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[45,"اليوم عهدكم فأين الموعد","https://www.aldiwan.net/poem9534.html","الكامل"],[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[146,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[216,"سر قاصدا سرعا يا حادي النجب","https://www.aldiwan.net/poem37918.html","البسيط"],[235,"يا مولعا بالبهار زرنا","https://www.aldiwan.net/poem4053.html","مخلع البسيط"],[240,"مولاي مجد الدين يا","https://www.aldiwan.net/poem31794.html","مجزوء الرجز"],[240,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[266,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[287,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[287,"إني إذا لاح البريق يماني","https://www.aldiwan.net/poem32383.html","الكامل"],[287,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[289,"ما كنت أحسب أن الخبز فاكهة","https://www.aldiwan.net/poem44328.html","البسيط"],[327,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[376,"سقيا لوقت مضى ورعيا","https://www.aldiwan.net/poem56967.html","الطويل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[415,"مهفهف يخجل بدر الدجى","https://www.aldiwan.net/poem32613.html","السريع"],[438,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[469,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[1136,"","https://poetry.dctabudhabi.ae/diwan/poem/131386","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49944","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95501","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79863","السريع"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141295","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48246","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27835","البسيط"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110624","السريع"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99084","السريع"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100439","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130749","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100254","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100336","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132583","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132776","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132618","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48356","السريع"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36737","السريع"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66620","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59515","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59455","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144065","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136937",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4585,"","https://poetry.dctabudhabi.ae/diwan/poem/110717","البسيط"],[4699,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=155963",""],[4935,"لي حلا ورد الهناء الكوثري","https://www.poetsgate.com/ViewPoem.aspx?id=129442",""],[4987,"قالو حبيبك","https://www.poetsgate.com/ViewPoem.aspx?id=49556",""],[5064,"أين المشرق ؟","https://www.poetsgate.com/ViewPoem.aspx?id=199104",""],[5082,"حارسةُ النّهر","https://www.poetsgate.com/ViewPoem.aspx?id=214735",""],[5174,"لغةٌ وعشق","https://www.poetsgate.com/ViewPoem.aspx?id=211700",""],[5320,"غفران","https://www.poetsgate.com/ViewPoem.aspx?id=41644",""],[5353,"لعنة قابيل","https://www.poetsgate.com/ViewPoem.aspx?id=212463",""],[5565,"وساحِرِ المقلتين تحسَبُه","https://www.poetsgate.com/ViewPoem.aspx?id=110220",""],[5629,"ضامي غرام","https://www.poetsgate.com/ViewPoem.aspx?id=184599",""],[5644,"وأظل أبحث عن قمر","https://www.poetsgate.com/ViewPoem.aspx?id=213601",""],[5786,"إن رمتَ منّي السلوَّ بالفند","https://www.poetsgate.com/ViewPoem.aspx?id=50657",""],[5943,"تشطير لقصيدة فات الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=138274",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[6052,"ميراث الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=35378",""],[1362,"سقتك وهناً يا دارها الديم","https://www.poetsgate.com/ViewPoem.aspx?id=127724",""]],"verses":[["يَبسِمنَ عَن بَردِ الغَمامِ وَبَردُهُ","رَيّانُ يُغبَقُ بِالمُدامِ وَيُصبَحُ",0,"ح",1,0],["يَبِسَ الضِحكُ عَلى أَفواهِهِم","فَهوَ كَالسُخر وَإِن لَم يَسخَروا",1,"ر",3,0],["يبسم الفيلسوف مما إليه","أخلد الجاهلون من أوهام",2,"م",1,0],["يَبِسَ النَجيعُ عَلَيهِ وَهوَ مُجَرَّدٌ","مِن غِمدِهِ وَكَأَنَّما هُوَ مُغمَدُ",3,"د",1,0],["يَبِسَتْ جُذوعُهُمُ وهُم ثَمَرٌ","للضُّبْعِ أينعَ ذلك الثّمَرُ",4,"ر",1,0],["يَبْسُطُ الذِّكْرى وَإِنْ كَا","نَ بِهَا الْعَهْدُ عَهِيدا",5,"د",2,0],["يبسِم بِشرا مازجتْه هيبةٌ","تطلُّعَ النَّصلِ من الغِمد الخَلَقْ",6,"ق",1,0],["يَبسِمنَ عَن بَرَدٍ أَحَمَّ رُضَابُهُ","كالشَّهدِ لارَصِفٍ ولا مُتَتثَاعِلِ",7,"ل",1,0],["يبسمن عن أقحوانٍ في العقيق يرى","بحولة الظلم من عَصَّارة العنبِ",8,"ب",1,0],["يبْسِمُ ثَغْرُ الريَاضِ منْه","عنْ دُرَرٍ حَشْوُهَا نُضَارُ",9,"ر",1,0],["يَبسُطُ لِلباغي النَدى","بِساطُكَ المُقَبَّلُ",10,"ل",1,0],["يَبسِمُ في يَومِ الهِيا","جِ وَالحِمامُ قَد كَلَح",11,"ح",1,0],["يبست بها افواههم وطباعهم","واليبس طبعا في فم المقرور",12,"ر",1,0],["يَبسُطُ الكَفَّ الَّتي تَهمي سَخاءً","إِن كَبا زَندُ يَدِ الغَيمِ السَخِيِّ",13,"ي",1,0],["يَبسِمنَ عَن نَورِ الأَقاحِ وَقَد حَكَت","وَجناتُهُنَّ شَقائِقَ النُعمانِ",14,"ن",1,0],["يَبسِمُ عَن لُؤلُؤٍ وَعَن بَرَدٍ","وَعَن أَقاحٍ وَعَن سَنا نُورِ",15,"ر",1,0],["يَبِسُ اليَدَينِ فَما يَستَطيعُ بَسطَهُما","كَأَنَّ كَفَّيهِ شَدا بِالمَساميرِ",16,"ر",1,0],["يَبسِمنَ عَن بَرَدٍ كَأَنَّ غُروبَهُ","مِسكٌ يُخالِطُ عَرفَهُ الفُقّاحُ",17,"ح",1,0],["يَبْسطُ للسّائلِ كَفَّ حاتِمٍ","ويَمنَحُ الجاهِلَ سَمْعَ الأحْنَف",18,"ف",1,0],["يَبسِمُ لِلقاصِدينَ حتَّى","كأنَّ جُوداً أتاهُ وَحيا",19,"ي",2,0],["يبسم الله مفتا","ح قولي في البرايات",20,"ت",1,1],["يَبسِمُ عَن ذي أَشَرٍ مِثلَما","يَلتَقِط الظَبيُ بِفيه الأَقاح",21,"ح",1,0],["يَبسِمُ عن دُرٍّ تَعالَى الّذِي","نَظَّمَه في البارِدِ العَذبِ",22,"ب",1,0],["يبسِمُ منه الطرفُ عن سؤدد","ضاحكَ فيه النورَ أنوارُ",23,"ر",1,0],["يبس البنان يذم منك خلائقاً","ردت وجوه السائلين بمائها",24,"ا",3,0],["يبسط من عطف العلى ما انقبضا","يصفي من الغر علينا ما انتضى",25,"ض",2,0],["يبسمن عن درَرٍ راقت لمبصرها","كالسيف شيم ونصلُ السيف عريان",26,"ن",1,0],["يَبْسِمْنَ عن شِنباتٍ من عَوارِضها","كأنَّها الأَقحوانُ الغَضذُ والْبَرَدُ",27,"د",1,0],["يبسمُ الشعب أن بَسَمت وإلا","فهو رَهن العناء غير بسيمِ",28,"م",1,0],["يبسط أختَ السحب لكن يداً","تهزءُ بالجودِ بهطَّالها",29,"ل",3,0],["يبسم الثّغر والفؤاد كئيب","ويضيء النّهار والجوّ أقتم",30,"م",1,0],["يبسُطُ الرزق للذي ساءَ جوداً","وهو أدرى بالخيرِ للإِنسانِ",31,"ن",1,0],["يبسمُ الثغرَ كلَّما مزَّقَ البز","زةَ دهري وانتاشني بابتزازِ",32,"ز",1,0],["يبسم البرقُ حين يلمعُ منهن","نَ إذا نصّت الحديثَ الثغورُ",33,"ر",1,0],["يبس الترابِ إلى برد المياهِ إلى","تسخينِ نارٍ إلى ترطيبِ أهواء",34,"ا",2,0],["يبسم عن أشنب عذب اللمى","واحر قلباه إلى ورده",35,"د",2,0],["يبسم إن ناولني ثغره","عن ذي غروب واضح أشنب",36,"ب",1,0],["يبسم عن طلع منضد ومن","لا لبن ومن أقاح وبرد",37,"د",1,0],["يبست عواطفه فاصبح من","بغضِ الحياة كأنها القُضُب",38,"ب",1,0],["يبسم عن ذي برد أشنب","عقيرب الصدغ عليه رصد",39,"د",1,0],["يبسمن عن لؤلؤ ما ضمَّه صدف","ولؤلؤ الثغر لا يحتاج اصدافا",40,"ف",2,0],["يبسم عن اشنب شتيت","رضابه شهدة وصرخد",41,"د",1,0],["يبسم عن ذي اشر بارد","قد مازج الشهد حمياه",42,"ا",2,0],["يبسم عن واضح شتيت","رضابه شهدة وخمر",43,"ر",1,0],["يبسم الضُحى","أَينما بَسَم",44,"م",1,0],["يبْسِمُ عن ثغْرٍ شَنيبٍ كَما","تَبسِمُ في الرّوْضِ ثُغورُ الأقاحْ",45,"ح",1,0],["يَبسِمنَ عَن مِثلِ اللآلِي كَما","يَسفُرن عَن مِثلِ سَنا الكَوكَبِ",46,"ب",1,0],["يَبْسُطُ الجُودَ عِنْدَما يَبْسُطُ السَّا","ئِلُ فِي نَيْلِ جُوْدِهِ آمالَهُ",47,"ل",2,0],["يبِسمنَ عن كالأقحوان منورّاً","سقيا الرَّذاذِ على نَقا سَفوانِ",48,"ن",1,0],["يبْسمنَ عنُ حوّ المراكزُ وضَّحِ","تيهاً كمَا ابتسمَ الغمامُ الرّائحُ",49,"ح",1,0],["يَبسُطُ الوَقتَ كَالخِضَمِّ لِيَطوي","هِ وَيَعدو عَلَيهِ كَالسَعلاةِ",50,"ه",1,0],["يَبسِمُ عن مفلّجٍ","مرتّلٍ مؤشّرِ",51,"ر",1,0],["يبست رياضك لا البنفسج نافثٌ","طيباً ولا ريحانها ريّان",52,"ن",1,0],["يَبْسُطُ للناسِ المُحَيا ويَرَى","سُؤْدَدَهُ في نَشْرِ أَزْهارِ النَّدَى",53,"ا",1,0],["يَبسُطُ المَشيَ إِذا هَيَّجتَهُ","مِثلَ ما يَبسُطُ في الخَطوِ الذَرَع",54,"ع",1,0],["يبسمن عن واضحات ملؤها خصر","أشهى وأعذب من ماء العناقيد",55,"د",1,0],["يبس الفؤاد وأجدبت آماله","والبعدُ طيفٌ ظالمٌ يختال",56,"ل",1,0],["يبسم السعد إلى أقباله","وبه يسمو علا كالمشتري",57,"ر",2,0],["يبسن عروقي لكن اللي يعزيه","ان اكثر العالم تردد لحونه",58,"ن",2,0],["يبسَتْ عُرُوقُ هوَاكِ حتَّى زَارَنِي","شَوْقٌ فَكُلِّي فِي الهوَى مُتَدَفِّقُ",59,"ق",1,0],["يبستْ مواويلُ الضّفافِ تحسّرًا","فلمن تفرُّ إلى النّجاة جُروحُ",60,"ح",1,0],["يَبِستْ شِفاهُ حَنِينهِ فَانْبرَى","ومَضَى يُقَبّلُ فِي خَيالهِ ما رأَى",61,"ر",3,1],["يبسط البارى الأيادى فى المسا","وكذا فى الصبح يدعوا المغتفر",62,"ر",1,0],["يبسَ الرّضابُ على فمي ظمأ ًبها","وهمو سقاةٌ للغريبِ وبلسمُ",63,"م",1,0],["يَبسِمُ عن لؤلؤٍ وعن برَدٍ","ما بين زهر العقيق قد فُتِتا",64,"ت",2,0],["‎يبست عروقي على درب الهيام ...","‎لاقويت أكمل ولا قاوي الرجوع ،",65,"ع",1,0],["يبسٌ عجافٌ كل أرضٍ زارها","لا عشق ينبت لا حنين ولا ثمر",66,"ر",1,0],["يبسمُ عن لؤلؤٍ وعن حببٍ","وعن أقاحٍ زها وعن بردِ",67,"د",1,0],["يَبُسَتْ أزاهيرُ الهوى وتساقطتْ)","ما عاد يثمرُ ما قطعتِ ويورقُ",68,"ق",1,0],["يَبُسَ الشباب ُ بجلدهِ وتخددت","فيه السنون وما يزال ُ الأمردُ",69,"د",1,0],["يبست أفنانين الرجا","ونما بها وسواسها",70,"س",3,0],["يبسم للأرض وهي عابسة","جذوة نار خلالها فحم",71,"م",1,0]]}