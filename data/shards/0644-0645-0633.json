ctabudhabi.ae/diwan/poem/94425","الوافر"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81253","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81252","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4755,"الشاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=183567",""],[5002,"ياطير","https://www.poetsgate.com/ViewPoem.aspx?id=205176",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[5411,"هذا نَصيبك منْ شِعْري","https://www.poetsgate.com/ViewPoem.aspx?id=185429",""],[5431,"رأيت الله","https://www.poetsgate.com/ViewPoem.aspx?id=183076",""],[5431,"فأَجْرِ العشق في نهديَ نهرا","https://www.poetsgate.com/ViewPoem.aspx?id=185820",""],[5431,"ياطيبَ أفئدةٍ بالحب تغتسلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187259",""],[5431,"فلا تشتكوا حزنا ولا تأبهوا خسفا","https://www.poetsgate.com/ViewPoem.aspx?id=197060",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5431,"قبلة الأمس...","https://www.poetsgate.com/ViewPoem.aspx?id=210259",""],[5431,"القبة العليا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210728",""],[5545,"غُصين البان","https://www.poetsgate.com/ViewPoem.aspx?id=184834",""],[5561,"الحوار الخامس","https://www.poetsgate.com/ViewPoem.aspx?id=200442",""],[5563,"بيروت تثعب","https://www.poetsgate.com/ViewPoem.aspx?id=215318",""],[5574,"وهْم","https://www.poetsgate.com/ViewPoem.aspx?id=206022",""],[5701,"يا صاحب السيف الذي","https://www.poetsgate.com/ViewPoem.aspx?id=164598",""],[5843,"دوله مستقله","https://www.poetsgate.com/ViewPoem.aspx?id=51294",""],[5845,"قفا برياضِ الشعبِ شعبِ القرنفلِ","https://www.poetsgate.com/ViewPoem.aspx?id=198491",""],[5956,"أسيرُ النعومة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182288",""],[5956,"النسائم","https://www.poetsgate.com/ViewPoem.aspx?id=183186",""],[5956,"المجدُ يركع","https://www.poetsgate.com/ViewPoem.aspx?id=192924",""],[5997,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=214294",""],[6127,"القلب قد وافاك","https://www.poetsgate.com/ViewPoem.aspx?id=191277",""]],"verses":[["لِمَسقِطِ حامِلِ الشَعَراتِ عَنّي","بِحَدِّ السَيفِ في اليَومِ العَماسِ",0,"س",1,0],["لَمَستُ بِكَفّي كَفَّهُ أَبتَغي الغِنى","وَلَم أَدرِ أَنَّ الجودَ مِن كَفِّهِ يُعدي",1,"د",2,1],["لَمَسَتْني أكفُهن فأبقتْ","أثراً لا يروق عَينَي لميس",2,"س",1,0],["لَمَسَت أَصابِعُهُ السَماءَ فَوَجهُها","ضاح وَمَرَّ عَلى التُرابِ فَنَوَّرا",3,"ر",2,0],["لَمَسَت إِصبَعُ السَكينَةِ أَشوا","قي فَهَبَّت مَذعورَةٌ مِن كَراها",4,"ا",3,0],["لَمَسَ الحُبُّ قَلبَهُ فَهوَ نارٌ","تَتَلَظّى وَيَستَلِذُّ لَظاها",5,"ا",3,0],["لَمَسَتهُ يَدُ السَماءِ فَكانَ ال","بَرقَ وَالرَعدَ خَفقَةً وَصَليلا",6,"ل",2,0],["لَمَسَت نَواصيها الحُصونُ تَرومُهُ","وَتَلَمَّستُهُ فَلَم تَجِدهُ الفَيلَقُ",7,"ق",1,0],["لَمَسَتها لِلمَقاديرِ يَدٌ","تَلمَسُ الماءَ فَيَرمي بِالشَرَر",8,"ر",1,0],["لَمَسَتكِ راحَتُهُ وَمَسَّكِ روحُهُ","فَأَتى البَديعُ عَلى مِثالِ المُبدِعِ",9,"ع",1,0],["لَمَسوا الحَقيقَةَ في الفُنو","نِ وَأَدرَكوها في العُلومِ",10,"م",1,0],["لمستِهِ فتمشّى السحر بي فكما","تهتز أوتاره تهتز أوتاري",11,"ي",1,0],["لَمَسَّت ثِيابي إِن قَدِرتُ ثِيابَها","وَلَم يَنهَني عَن مَسِّهِنَّ حَرامُها",12,"م",3,0],["لمسَ العُروشَ فما يزال يَهزُّها","ذُعرٌ يطوفُ بها وهَمٌّ مُقلِقُ",13,"ق",1,0],["لَمَستُ بِكَفّي كَفَّهُ أَبتَغي الغِنا","وَلَم أَدرِ أَنَ الجودَ مِن كَفِّهِ يُعدي",14,"ي",1,1],["لمست إذ دخلتها الوجه مني","نفحةٌ فاح عطرها والعبير",15,"ر",1,0],["لمسْتِ ضَعْفَ الناسِ في عالَمٍ","قويُّهُ لا يرحَمُ المضعفينْ",16,"ن",1,0],["لمستِ حديدَ القَيْدِ فانحلَّ نظمهُ","وأطلقتِ أسرَى من براثِن آسِرِ",17,"ر",1,0],["لِمَسْرَحِ سِرْبٍ ما تَقَرَّى نِعَاجُهُ","بَرِيراً ولا تَقْرُو جَآذِرُهُ خَمْطَا",18,"ط",2,0],["لَمَسَ السِّحْرُ كُلَّ بَاكٍ فَغَنَّى","وَشَفَى البِشْرُ كُلَّ شَاكٍ فَغَرَّدْ",19,"د",1,0],["لمستُ جَناحَه رفقاً فوافَى","وأغريتُ الوِدادَ به فودّا",20,"د",2,0],["لمستْ حنو الحبِّ فيكِ تمائِمي","ورأيتُ فيكِ الدهرَ وهو غلام",21,"م",1,0],["لَمَسْتُ فلم أَلْمِسْ سوى أَرْيَحِيَّةٍ","من النورِ لُفَّتْ في رِدَاءٍ مُخَلَّقِ",22,"ق",1,0],["لمُسوح عيسى فوقَ أرضِكَ خطرَةٌ","وعصا الكليم، وبردةِ المختار",23,"ر",1,0],["لمستم شاطئَ المجهول لَمْسًا","وجَدَّ بكم إلى الأرض الفِرَار",24,"ر",1,0],["لمس الربيع قلوبهم وحقولهم","فاخضوضرت بالبشر والثمرات",25,"ت",1,0],["لَمسوا منه في التصافُحِ كفاً","لم يَرَوا مثلَ وقعِها في الكفوف",26,"ف",1,0],["لَمستُ الوحيَ في لْحنِ المثاني","وشِمتُ الحُزنَ في وقْعِ المساحي",27,"ح",2,0],["لمست إصبع السكينه أشوا","في فهبّت مذعورة من كراها",28,"ا",3,0],["لمسْتَ أمانينا ، فصارتْ جداولاً","وأمطرتنا حبّا ، ولا زلتَ تمطرُ",29,"ر",1,0],["لم سمعنكَ قلنَ : شعرٌ أمردٌ","يا ليت قائله الطَّيرُ الأمردُ",30,"د",1,0],["لِمُسَوّدين أَكارِمٍ","طابوا وَطابَ المَولِدُ",31,"د",1,0],["لِمَ سَيرُهُنَّ إِذا اِستَفَدن تَعَسُّفٌ","وَنُفوسُهُنَّ إِذا أَسَرنَ فِظاظُ",32,"ظ",1,0],["لمسارح وملاعب ومراتع","ومرابع فيها البدور الكمّل",33,"ل",1,0],["لمُسْفِرِ صُبْحٍ دونَهُ الموتُ سافرٌ","وحاجبِ شمسٍ دونها الثكلُ حاجب",34,"ب",1,0],["لمستقِلّ لعُلاك الشعرا","يا من إذا ما جاد فاق القَطْرا",35,"ر",2,0],["لمست دِرعه فقالت لعهدي","بك يا ابن الزبيرِ غيرَ جزوع",36,"ع",1,0],["لِمُستَسلِمٍ بَينَ الرِماحِ أَجَبتَهُ","فَأَنقَذتَهُ وَالبيضُ فيهِ شَوارِعُ",37,"ع",1,0],["لمستُ بنَفسي أسطَعَ النجماتِ","وقُلتُ أنيري هذه الظُّلُماتِ",38,"ت",1,1],["لمسراه ابواب السَموات فتحت","وَقيل له اهلا وَسهلا بك ادخل",39,"ل",1,0],["لمست بكفيّ البنان المخضبا","وعانقت غصن البان جيدا ومعصما",40,"م",2,0],["لمُسْتَشْرفٍ زَرّتْ فوارزَ جَيْبِه","على جسمِ مَيْثاء الثرى ناعمُ القضب",41,"ب",1,0],["لمست من حشراتي كل مرحمة","وما أنست بها من صاحبي الضاري",42,"ر",2,0],["لِمَ سُدَّ بابُ الملك وهو مواكبٌ","وخلَتْ مجالسُه وهنَّ محَافلُ",43,"ل",1,0],["لمساميحَ حوَوْا سقفَ العلا","حِصصاً واقتسموه خُطَطا",44,"ط",2,0],["لَمَستَهُم بِيَدٍ لِلعَفوِ مُتَّصِلٍ","بِها الرَدى بَينَ تَليينٍ وَتَشديدِ",45,"د",1,0],["لِمُستَوزِرٍ مِن رَهطِ عُثمانَ بالِغٍ","لَعَمرُكَ مِن مَولاهُ أَسنى المَقاصِدِ",46,"د",1,0],["لمسُ الثريَّا للذي يَنْبَري","لِلَمْسِها أقربُ من لَمْسِه",47,"س",2,0],["لمستهلكٍ قد كان من شِدَّةِ الهوى","يموتُ ومن طولِ العِداتِ الكواذبِ",48,"ب",1,0],["لم سلمت ثم ودعت حتى","بات منك التسليمُ كالتوديع",49,"ع",1,0],["لمست الذي أهوى بعطفي ومنكبي","ولم ترمني عين الغيور بلحظها",50,"ه",2,0],["لم ستبن لو لم تقم بحدودها","منها حلال للورى وحرام",51,"م",1,0],["لمستك في الأنداء في حالم الزهر","وفي رهبة الوادي وتنهيدة النهر",52,"ر",1,1],["لمستك في طهر البنفسج وادعا","تدغدغهُ الأحلام في هدأة الفجر",52,"ر",1,0],["لمستك في قلبي المريض أشعّة","تطارد أشباح المكاره والغدر",52,"ر",1,0],["لمستأنسات بالحديث كأنها","تهلل غر برقهن وميض",53,"ض",1,0],["لِمْ سليمان قد تأرث داو","د ولِمْ ذو الجلال قد أوحاها",54,"ا",3,0],["لمسراه أبواب السمواوات فتحت","ومولى تجلى والحديث يطول",55,"ل",1,0],["لمسجده سرنا وشدت رحالنا","وبين يديه شوقنا قد كشفناه",56,"ن",3,0],["لمَسيرِ العمرِ أعد نظرَك","تقلو أملاً بغرورهم",57,"م",1,0],["لَمَسَت كَفُّهُ العِنانَ فَكادَ العُشبُ","يُلفى مِن لَمسِهِ في عِنانِه",58,"ن",2,0],["لمسرة للأضياف تنظر","مثل رضوى من رماد",59,"د",1,0],["لِمُستَأنِسٍ بِالهَمِّ في دارِ غُربَةٍ","غَريبِ الهَوى باكٍ لِكُلِّ غَريبِ",60,"ب",1,0],["لمستمطر بالرمل في بيت حرة","هجان بحبل ذي ألاء وعرفج",61,"ج",1,1],["لِمُستَقَلِّ يا أخي البُطين","إعمَل عَليهِ وَأنَا الضمين",62,"ن",1,0],["لمستها كفاي بالسكر لكن","ساعة الصحو خيبت كل لمس",63,"س",1,0],["لَمس الكَأسَ لِكي يَشرَبَها","فَاعترتهُ هَزَّةٌ مِما لَمَس",64,"س",1,0],["لمستنصر بالله يردع ظالما","وينصر مظلوما ويحيى جنائزا",65,"ز",2,0],["لمُساجليك من المعالي لفظُها","ولك المعانين والمعاني أَفْضلُ",66,"ل",1,0],["لمست أنامله بأعلى ضرعها","فغدا الحليب يسيل مثل القربة",67,"ه",1,0],["لمس الدهر من فؤادي حديداً","يتلظى فلم يطق بعد لمسي",68,"س",2,0],["لمست حدود الأربعين وكلها","لعيني كغضبات البراكين مظلم",69,"م",1,0],["لمسيرك بالعدم الأخضرْ","جاءت بشرى العيد الأكبرْ",70,"ر",1,1],["لمستقبل ذخر وماضيه مرتضى","فيدعو له أمسٌ ويدعو له غد",71,"د",1,0],["لمسنا شفاهًا ففاضت سنًى","وجرنا على جائر فاعتدلْ",72,"ل",1,0],["لمس النسيم وكان أخشن قاسيا","لطف الحبيب فعاد وهو بليل",73,"ل",1,0],["لمسرور بأَن تَفنى","عَلى أَنَّكَ مِن عُمري",74,"ر",2,0],["لمست بِكَفي وَملت عَلى","يَميني إِلى السبل السابلة",75,"ه",1,0],["لمسنا من مخائلك المعالي","وشمنا بين بارقك الصوابا",76,"ب",2,0],["لمس الهوى وتر الصبا فإذا","نغم غريب غير منتظر",77,"ر",1,0],["لمسا الحراجة في غرامهما","وتبينا ما فيه من غرر",77,"ر",1,0],["لمسراه سرسار ملء السماء والسهول","وأوعار لها سمع الصم",78,"م",1,0],["لمسعاه سار السرح طوعاً لامره","وهلل صلد مسه وله سلم",78,"م",1,0],["لمستقر لها شمس السعود جرت","لتدرك القمر الاسى لدى السحر",79,"ر",1,1],["لمستر بَرت مدرسةٌ تسامت","على كل المدارس بالفنونِ",80,"ن",1,1],["لَمَست قُدس ما تَوقَع نَفسي","وَاِستَفاقَ الهَوى إِلَيهِ وَأَخلَد",81,"د",1,0],["لَمس المَزهر الحَزين بِكفي","ه وَغنى بِشَجوه وَالتِياعه",82,"ع",2,0],["لمست تلمساناً بِخُشْنِ براثنٍ","من كل نابي الظُّفر غيرِ مقلم",83,"م",1,0],["لَمَسَت بنغمَتِها الفؤادَ فَما","وَثَبَ الحَنِينُ بهِ ولا انصَرَفا",84,"ف",2,0],["لمسَتْ قروُحِي آهَهُ","قد صادَني وتَمكَنَّا",85,"ن",2,0],["٢- لمسرى الحبيب هوى خافقي","وما في فؤادي قليل احتمال",86,"ل",1,0],["لِمُسلِمِ فَلْيَبْكِ أُولُوا الدّينِ وَالتُّقىٰ","دَمًا وَلْيَزِدْ بالنّوْحِ نَدْبُ النّوَادِبِ",87,"ب",1,0],["لَمَسْتُ عِشْقًا بِهِ الوِجْدان يَبْعثنا","وَغازَلَ الْحَرْفُ بِالأَشْعارِ وِجْدانا",88,"ن",2,0],["لمستُ القلب أبحثُ عن الهي","فكم أوجِعتُ من لؤمِ الظلامِ",89,"م",1,1],["لمستَ الروح فانهمرت سمائي","ويابستي غدت باللمسِ خضرا",90,"ر",2,0],["لمسٌ كلمس نبي بتُ منتشيا","حرا ومنطلقا للحب أمتثلُ",91,"ل",1,0],["لمستُ به عشقا تصوّف وجده","وفي معبد النشوى ذبيحا وما وفّا",92,"ف",2,0],["لمست طيوف تقرّحٍ","رسم العذاب شوارعه",93,"ع",2,0],["لمسات مع الذهول تراءت","كصلاة بحضرةٍ سرمدية",94,"ي",2,0],["لمستك نورا مذْ صحوتُ أفتشُ","وجئتك وعيا كيفَ فيك أغششُ؟",95,"ش",1,1],["لمستكَ في رحاب النفس روحًا","مطهرةً بها ما خابَ ظني",96,"ن",2,0],["لمسَتْ كفّاهُ حسًّا مُتعباً","وفؤاداً خالياً يغفو ببالِهْ",97,"ل",2,0],["لمسرى المصطفى أَرْتَجُّ شوقًا","‎على شَفَتَيَّ تنْتحبُ الرغائبْ",98,"ب",1,0],["٣- لمسْتُ يدًا تراقِبُها سحابٌ","فلمّا أمطرتْ صفُرتْ يدايا",99,"ا",3,0],["لمسا كلمس الكهربا","ء وإن حكى جمر الغضا",100,"ض",2,0],["لمساء يابو طلال أمسى وأمسى الملك ل الله","والبنادم ماله الا الصبر والنيه مطيه",101,"ي",2,1],["لمسراهُ أبوابُ السماءِ تفتحتْ","وقيلَ لهُ أهلاً وسهلاً بكَ ادخل",102,"ل",1,0],["لَمْسُ النعومة ينشر الرَّيعانا","‏ ‏ في العالَمينَ وينشر الإحسانا",103,"ن",2,1],["لمَساتُها وعبيرها في مهجتي","تسْري إليَّ برائعاتِ فصولِها",104,"ه",2,0],["لَمَساتُ كفّك مثلُ لمسةِ كعبةٍ","أو بيتِ أقصَى أو دخلتُ المسجدا",105,"د",2,0],["لمساتُها تسري بروحي رعشة","وثمارها في عرشها تتبرجُ",106,"ج",1,0],["لمسْتَ رفاتاً قد بدتْ ظلَّ وقدةٍ","فأيقظْتَ جمراً غيّبَتْهُ المواقدُ",107,"د",1,0]]}