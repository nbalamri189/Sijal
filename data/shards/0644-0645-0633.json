{"poems":[[53,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[54,"لمست بكفي كفه أبتغي الغنى","https://www.aldiwan.net/poem27354.html","الطويل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[91,"الحسن حولك في الوهاد وفي الذرى","https://www.aldiwan.net/poem8867.html","عموديه"],[91,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[91,"اسألوها أو فاسألوا مضناها","https://www.aldiwan.net/poem62803.html","عموديه"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[97,"ليس البيانو الذي راحت تحركه","https://www.aldiwan.net/poem24601.html","البسيط"],[33,"فلو زرت بيت الله ثم رأيتها","https://www.aldiwan.net/poem25814.html","الطويل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[50,"لمست بكفي كفه أبتغي الغنا","https://www.aldiwan.net/poem63845.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30467","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[106,"مهبِط الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=179626",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[85,"الرُّشْدُ أَجملُ سِيرة يا أَحمدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9540&r=&rc=30",""],[132,"أنت النبي محمد","https://www.aldiwan.net/poem20996.html","مجزوء الكامل"],[162,"مقل الجآذر نبلها الألحاظ","https://www.aldiwan.net/poem67839.html","البسيط"],[195,"صديان يغلي في حشاه المرجل","https://www.aldiwan.net/poem39876.html","الكامل"],[196,"بأي نعي صبحتنا الركائب","https://www.aldiwan.net/poem51977.html","الطويل"],[227,"يا من حوى الفضل وحاز الفخرا","https://www.aldiwan.net/poem51069.html","الرجز"],[239,"إن أسماء في الورى خير أنثى","https://www.aldiwan.net/poem45753.html","الخفيف"],[247,"هل أنت على أطلال مية رابع","https://www.aldiwan.net/poem2110.html","الطويل"],[268,"لمست بنفسي أسطع النجمات","https://www.aldiwan.net/poem35600.html","الطويل"],[269,"قفا برياض الشعب شعب القرنفل","https://www.aldiwan.net/poem52096.html","الطويل"],[426,"إلا ربما جاد الزمان وأنعما","https://www.aldiwan.net/poem41047.html","الطويل"],[450,"وبط من الوادي حللنا مقيلة","https://www.aldiwan.net/poem13630.html","الطويل"],[451,"حمدت ربي على ذمي فأكثره","https://www.aldiwan.net/poem61236.html","البسيط"],[456,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[456,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[551,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"]],"verses":[["لِمَسقِطِ حامِلِ الشَعَراتِ عَنّي","بِحَدِّ السَيفِ في اليَومِ العَماسِ",0,"س",1,0],["لَمَستُ بِكَفّي كَفَّهُ أَبتَغي الغِنى","وَلَم أَدرِ أَنَّ الجودَ مِن كَفِّهِ يُعدي",1,"د",2,1],["لَمَسَتْني أكفُهن فأبقتْ","أثراً لا يروق عَينَي لميس",2,"س",1,0],["لَمَسَت أَصابِعُهُ السَماءَ فَوَجهُها","ضاح وَمَرَّ عَلى التُرابِ فَنَوَّرا",3,"ر",2,0],["لَمَسَت إِصبَعُ السَكينَةِ أَشوا","قي فَهَبَّت مَذعورَةٌ مِن كَراها",4,"ا",3,0],["لَمَسَ الحُبُّ قَلبَهُ فَهوَ نارٌ","تَتَلَظّى وَيَستَلِذُّ لَظاها",5,"ا",3,0],["لَمَسَتهُ يَدُ السَماءِ فَكانَ ال","بَرقَ وَالرَعدَ خَفقَةً وَصَليلا",6,"ل",2,0],["لَمَسَت نَواصيها الحُصونُ تَرومُهُ","وَتَلَمَّستُهُ فَلَم تَجِدهُ الفَيلَقُ",7,"ق",1,0],["لَمَسَتها لِلمَقاديرِ يَدٌ","تَلمَسُ الماءَ فَيَرمي بِالشَرَر",8,"ر",1,0],["لَمَسَتكِ راحَتُهُ وَمَسَّكِ روحُهُ","فَأَتى البَديعُ عَلى مِثالِ المُبدِعِ",9,"ع",1,0],["لَمَسوا الحَقيقَةَ في الفُنو","نِ وَأَدرَكوها في العُلومِ",10,"م",1,0],["لمستِهِ فتمشّى السحر بي فكما","تهتز أوتاره تهتز أوتاري",11,"ي",1,0],["لَمَسَّت ثِيابي إِن قَدِرتُ ثِيابَها","وَلَم يَنهَني عَن مَسِّهِنَّ حَرامُها",12,"م",3,0],["لمسَ العُروشَ فما يزال يَهزُّها","ذُعرٌ يطوفُ بها وهَمٌّ مُقلِقُ",13,"ق",1,0],["لَمَستُ بِكَفّي كَفَّهُ أَبتَغي الغِنا","وَلَم أَدرِ أَنَ الجودَ مِن كَفِّهِ يُعدي",14,"ي",1,1],["لمست إذ دخلتها الوجه مني","نفحةٌ فاح عطرها والعبير",15,"ر",1,0],["لمسْتِ ضَعْفَ الناسِ في عالَمٍ","قويُّهُ لا يرحَمُ المضعفينْ",16,"ن",1,0],["لمستِ حديدَ القَيْدِ فانحلَّ نظمهُ","وأطلقتِ أسرَى من براثِن آسِرِ",17,"ر",1,0],["لِمَسْرَحِ سِرْبٍ ما تَقَرَّى نِعَاجُهُ","بَرِيراً ولا تَقْرُو جَآذِرُهُ خَمْطَا",18,"ط",2,0],["لَمَسَ السِّحْرُ كُلَّ بَاكٍ فَغَنَّى","وَشَفَى البِشْرُ كُلَّ شَاكٍ فَغَرَّدْ",19,"د",1,0],["لمستُ جَناحَه رفقاً فوافَى","وأغريتُ الوِدادَ به فودّا",20,"د",2,0],["لمستْ حنو الحبِّ فيكِ تمائِمي","ورأيتُ فيكِ الدهرَ وهو غلام",21,"م",1,0],["لَمَسْتُ فلم أَلْمِسْ سوى أَرْيَحِيَّةٍ","من النورِ لُفَّتْ في رِدَاءٍ مُخَلَّقِ",22,"ق",1,0],["لمُسوح عيسى فوقَ أرضِكَ خطرَةٌ","وعصا الكليم، وبردةِ المختار",23,"ر",1,0],["لمستم شاطئَ المجهول لَمْسًا","وجَدَّ بكم إلى الأرض الفِرَار",24,"ر",1,0],["لَمسوا منه في التصافُحِ كفاً","لم يَرَوا مثلَ وقعِها في الكفوف",25,"ف",1,0],["لَمستُ الوحيَ في لْحنِ المثاني","وشِمتُ الحُزنَ في وقْعِ المساحي",26,"ح",2,0],["لمسْتَ أمانينا ، فصارتْ جداولاً","وأمطرتنا حبّا ، ولا زلتَ تمطرُ",27,"ر",1,0],["لم سمعنكَ قلنَ : شعرٌ أمردٌ","يا ليت قائله الطَّيرُ الأمردُ",28,"د",1,0],["لِمُسَوّدين أَكارِمٍ","طابوا وَطابَ المَولِدُ",29,"د",1,0],["لِمَ سَيرُهُنَّ إِذا اِستَفَدن تَعَسُّفٌ","وَنُفوسُهُنَّ إِذا أَسَرنَ فِظاظُ",30,"ظ",1,0],["لمسارح وملاعب ومراتع","ومرابع فيها البدور الكمّل",31,"ل",1,0],["لمُسْفِرِ صُبْحٍ دونَهُ الموتُ سافرٌ","وحاجبِ شمسٍ دونها الثكلُ حاجب",32,"ب",1,0],["لمستقِلّ لعُلاك الشعرا","يا من إذا ما جاد فاق القَطْرا",33,"ر",2,0],["لمست دِرعه فقالت لعهدي","بك يا ابن الزبيرِ غيرَ جزوع",34,"ع",1,0],["لِمُستَسلِمٍ بَينَ الرِماحِ أَجَبتَهُ","فَأَنقَذتَهُ وَالبيضُ فيهِ شَوارِعُ",35,"ع",1,0],["لمستُ بنَفسي أسطَعَ النجماتِ","وقُلتُ أنيري هذه الظُّلُماتِ",36,"ت",1,1],["لمسراه ابواب السَموات فتحت","وَقيل له اهلا وَسهلا بك ادخل",37,"ل",1,0],["لمست بكفيّ البنان المخضبا","وعانقت غصن البان جيدا ومعصما",38,"م",2,0],["لمُسْتَشْرفٍ زَرّتْ فوارزَ جَيْبِه","على جسمِ مَيْثاء الثرى ناعمُ القضب",39,"ب",1,0],["لمست من حشراتي كل مرحمة","وما أنست بها من صاحبي الضاري",40,"ي",1,0],["لِمَ سُدَّ بابُ الملك وهو مواكبٌ","وخلَتْ مجالسُه وهنَّ محَافلُ",41,"ل",1,0],["لمساميحَ حوَوْا سقفَ العلا","حِصصاً واقتسموه خُطَطا",42,"ط",2,0],["لَمَستَهُم بِيَدٍ لِلعَفوِ مُتَّصِلٍ","بِها الرَدى بَينَ تَليينٍ وَتَشديدِ",43,"د",1,0]]}