{"poems":[[29,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[29,"زار الفرزدق أهل الحجاز","https://www.aldiwan.net/poem5718.html","المتقارب"],[29,"ألم يك لا أبا لك شتم تيم","https://www.aldiwan.net/poem6008.html","الوافر"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[563,"كن لمن يدعي الصلاح محبا","https://www.aldiwan.net/poem34451.html","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62599","الوافر"],[2675,"","https://poetry.dctabudhabi.ae/diwan/poem/200263","الكامل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26121","الطويل"],[4955,"يأتيكَ شيطانٌ يوسوسُ قائلاً","https://www.poetsgate.com/ViewPoem.aspx?id=187864",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5781,"تَفرَّدَ....","https://www.poetsgate.com/ViewPoem.aspx?id=208949",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""]],"verses":[["وَأَخزاكُمُ عَوفٌ كَما قَد خَزيتُمُ","وَأَدرَكَ عَمّارٌ تِراتِ البَراجِمِ",0,"م",1,0],["وَأَخزَيتَ قَومَكَ عِندَ الحَطيمِ","وَبَينَ البَقيعَينِ وَالغَرقَدِ",1,"د",1,0],["وَأَخزى التَيمَ أَنَّ نِجارَ تَيمٍ","بَعيدٌ مِن نِجارِ بَني تَميمِ",2,"م",1,0],["وَأَخٍ زَأَرتُ لَهُ وَلَولا أَنَّني","آنَستُ ما أَنكَرَتهُ لَم أَزأَرِ",3,"ر",1,0],["واخز شيطانك اللعين عدو ال","لَه فيه وفيك بالوسواس",4,"س",1,0],["وأخزُن دُرَّه إلا لأمرٍ","يقلدني الجلالة والشهامهْ",5,"م",2,0],["وأخزن لسانك واحترس من نطقه","واحذر بوادر غيّه ثم احذر",6,"ر",1,0],["وَاِخزِن لِسانَكَ وَاِحتَرِس مِن لَفظِهِ","وَاِحذَر بوادِرَ غَيِّهِ ثُمَّ اِحذَرِ",7,"ر",1,0],["وَأَخزى بَني اليَربوعِ أَنَّ نِساءَهُم","مُقَرّاتُ أَوشالٍ لِئامٌ مَعينُها",8,"ن",3,0],["وَاخْزِ الأعادي من بظلمٍ أزهقوا","روحَ الحياةِ لدى بني الإنسان",9,"ن",1,0],["وأخزى ذوي الكفران والشرك والردى","فمت كمداً واخسأ فلن ترتقي مرقى",10,"ق",2,0],["وأخزى ذوي الكفران والشرك والردى","فمت كمداً واخسأ فلن ترقى مرقى",10,"ق",2,0],["وأخْزُنُ دمْعاتِ القَصيدِ بِمُقلَتي","وأُجْزِلُ عِشقًا لو تَشدَّدَ أوْ صفَحْ",11,"ح",1,0],["وأخَزِّنُ الإلهامَ منه بخافقي","فتزيد طاقاتي على التعبير..",12,"ر",1,0]]}