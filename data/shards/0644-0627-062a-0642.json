l","السريع"],[559,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[559,"حضرة الغيب سترها الأشياء","https://www.aldiwan.net/poem35077.html","الخفيف"],[568,"قل للمليحة في الخمار الأكحل","https://www.aldiwan.net/poem69544.html","الكامل"],[576,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[576,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[576,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[587,"من كحل المقلة السوداء بالدعج","https://www.aldiwan.net/poem17465.html","البسيط"]],"verses":[["لا تَقُل تِلكَ قُبورٌ إِنَّما","هِيَ أَصدافٌ عَلى غَيرِ لَآلِ",0,"ل",1,0],["لا تَقنَعَن عِندَ المَطا","لِبِ بِالقَليلِ مِنَ الكَثيرِ",1,"ر",1,0],["لا تَقرِ ياضَيفَ الهُمومِ قِرىً","إِلّا قِرى العَيرانَةِ الأُجُدِ",2,"د",1,0],["لا تَقْرَبِ البَكريّ إنّ وراءَهُ","مِنْ أُسْرَتَيْهِ جَحاجِحاً وقُروما",3,"م",2,0],["لا تَقتَضي الدَينَ إِلّا بِالقَنا الذُبُلِ","وَلا تُحَكِّم سِوى الأَسيافِ في القُلَلِ",4,"ل",1,1],["لا تَقتُليني بِالجَفاءِ تَمادِياً","وَاِعنَي بِأَمري إِنَّني مَجهودُ",5,"د",1,0],["لا تَقْرَبَنّ بما يُنْعى عليْكَ غَدا","وتسْتَخِفَّ بحمْلٍ لسْت تَقْدِرُهُ",6,"ه",1,1],["لا تَقعُدَنَّ وَقَد أَكَّلتَها حَطَباً","تَعوذُ مِن شَرِّها يَوماً وَتَبتَهِلُ",7,"ل",1,0],["لا تَقولوا خَلا العَرينُ فَفيهِ","أَلفُ لَيثٍ إِذا العَرينُ أَهابا",8,"ب",2,0],["لا تَقتُلوا الدَهرَ حِقداً","فَالمُلكُ لِلدَيّانِ",9,"ن",1,0],["لا تُقيدوا مِن أُمَّةٍ بِقَتيلٍ","صادَتِ الشَمسُ نَفسَهُ حينَ صادا",10,"د",2,0],["لا تَقنَطوا إِن قَرَأتُم ما يُزَوِّقُهُ","ذاكَ العَميدُ وَيَرميكُم بِهِ غَضَبا",11,"ب",2,0],["لا تَقرَبِ التاميزَ وَاِحذَر وِردَهُ","مَهما بَدا لَكَ أَنَّهُ مَعسولُ",12,"ل",1,0],["لا تَقطَعي صِلَةَ الخَيالِ تَجِنُّباً","إِذ فيهِ مِن عَوَزِ الوِصالِ سِدادُ",13,"د",1,0],["لا تَقْنَطُوا كَرِهَ الله الأُولَى قَنِطُوا","اليَوْمَ يَعْتَزِمُ الأَبْرَارُ فَاعْتَمُوا",14,"م",3,0],["لا تَقضَينَ حاجَةً أَتعَبتَ صاحِبَها","بِالمَطلِ مِنكَ فَتُرزا غَيرَ مَحمودِ",15,"د",1,0],["لا تقل شاعر العرب","أنه شاعر البشر",16,"ر",1,0],["لا تقرنوا بتشتت آراءكم","فالبدر يمحق عند كل قران",17,"ن",1,0],["لا تقرّوا على الهوان وأنتم","عرب من بني الأُباة الصِيد",18,"د",1,0],["لا تقعدن تلوم نفسك دائباً","فيها وأنت بحبِّها مشغوفُ",19,"ف",1,0],["لاتُقعَدا بي بَعدَها","وَسَلا الأَميرَ أَباكُما",20,"م",2,0],["لا تَقطَعي وَصلي وَتَلتَمِسي","غَيري وَلَمّا تَعلَمي خُبري",21,"ر",2,0],["لا تَقبَلَنَّ دَنِيَّةً أَعطَيتُها","أَبَداً وَلَمّا تَألَمِ الأَنصارُ",22,"ر",1,0],["لا تقل لي أكثرت في الحالِ وصفاً","فالذي بي من شدَّة الحال أكثر",23,"ر",1,0],["لا تقيسوا ابن سناناً في الندَى","ما ابن أيوب قياس منخرم",24,"م",1,1],["لا تقطع الطرق عن سارٍ إلى بلدٍ","إلا منازه أنهار وغدرانِ",25,"ن",1,0],["لا تقل لي في اللّغز بالفتح ريب","فهو لغزٌ إذا نظرت جليّ",26,"ي",1,0],["لا تقدّر بحسنِ وجهِك صَيْدي","بعد نَفْري كما تَصيد الظِّباءَ",27,"ا",2,0],["لا تُقابِلْ تَيَمُّني بك بالرد","دِ ولا الظنَّ فيك بالإكذابِ",28,"ب",1,0],["لا تقولوا على ابن بَورانَ بُهتا","ناً فقِدْماً جَبَهْتُموه ببهتِهْ",29,"ت",2,0],["لا تقف وقفةَ فَسْلٍ","للّذاذَاتِ مُحاجِز",30,"ز",1,0],["لا تَقْصِدنَّ لحاجةٍ","إلا امرأً فَرِحاً بنفسِهْ",31,"س",2,1],["لا تقسمِ الضّيزَى كقسمةِ معشرٍ","نصبوا موازينَ الفواضل مِيلا",32,"ل",2,0],["لا تَقْبلنَّ المدحَ ثم تَعُقُّهُ","وتنامُ والشعراءُ غير نيام",33,"م",1,0],["لا تَقُل لي هَكَذا اللَهُ قَضى","أَنتَ لا تَعرِفُ أَسرارَ القَضاء",34,"ا",2,0],["لا تَقُل ما رَأوهُ ذاكَ سِرٌّ","خَبَأَتهُ الحَياةُ في ظُلُماتِه",35,"ت",2,0],["لا تَقنَطَنَّ مِنَ النَجاحِ لِعَثرَةٍ","ما لا يَنالُ اليَومَ يُدرَكَ في غَدِ",36,"د",1,0],["لا تَقُل أَيُّ مَوسِمٍ","ذا فَذا يَومُ مَولِدي",37,"د",2,0],["لا تَقعِدَنَّ عَنِ الجِهادِ إِلى غَدٍ","فَلَقَد يَجيءُ غَد وَأَنتَ غُبارُ",38,"ر",1,0],["لا تَقلَقي يَومَ النَوى أَو فَاِقلَقي","يا نَفسُ كُلُّ تَجَمُّعٍ لِتَفَرُّقِ",39,"ق",1,1],["لا تَقبَضوا الأَيدي فَهَذا يَومُكُم","شَرُّ الوَرى جَعدُ البَنانِ بَخيلُ",40,"ل",1,0],["لا تَقولوا دَقائِقٌ وَثَوانٍ","ذاهِباتٌ فَالعُمرُ هَذي الثَواني",41,"ن",2,0],["لا تَقُل لي جِئتَها عارِيَةً","فَقرُها عِندي جَميلٌ كَغِناها",42,"ا",3,0],["لا تَقولوا مَن أُمِّهِ مَن أَبوهُ","فَأَبوهُ وَأُمُّهُ سورِيّا",43,"ي",2,0],["لا تَقُل إِنّي وَإِنّي","لَيسَ هَذا القَولُ يُغني",44,"ن",2,0],["لا تقشعر فانت لا","تنهار يا وطني المفدى",45,"د",2,0],["لا تقبلوا في الدين ما يروونه","الا اذا ما صح في الانظار",46,"ر",1,0],["لا تَقُل كانَ أَبي إِيّا","كَ أَن تَحذُوَ حَذوَه",47,"و",2,0],["لا تَقُل بِهِ إِدَدٌ","إِنَّ حُسنَهُ اَلإِدَدُ",48,"د",1,0],["لا تَقولوا شاعِرُ الوادي غَوى","مَن يُغالِط نَفسَهُ لا يُعتَبَر",49,"ر",1,0],["لا تَقولَنَّ عِظامِيٌّ أَنا","في زَمانٍ كانَ لِلناسِ عِصاما",50,"م",2,0],["لا تَقُل عَواقِبُها","فَالعَواقِبُ الأَدَبُ",51,"ب",1,0],["لا تَقولوا حَطَّنا الدَهرُ فَما","هُوَ إِلّا مِن خَيالِ الشُعَراء",52,"ا",2,0],["لا تَقِفْ للزَّمانِ في مَنْزِلِ الضَّيْ","مِ ولا تَسْتَكِنْ لِرِقّةِ حالِ",53,"ل",1,0],["لا تقدمن على إزالة لفظة","فيهن عن معنى به يتخصّصُ",54,"ص",1,0],["لا تَقيسَنَّ حاتِمَ الجودِ في الجو","دِ إِلَيهِ فَحاتِمٌ فيهِ عَبدُه",55,"د",2,0],["لا تَقرَبَن سُخطُهُ فَإِنَّ لَهُ","مُستَنقَعاً يَجتَويهِ مَن يَرِدُه",56,"د",2,0],["لا تَقِف بي عَلى الدِيارِ فَإِنّي","لَستُ مِن أَربُعٍ وَرَسمٍ مُحيلِ",57,"ل",1,0],["لا تَقرَبُ الفَحشاءُ جانِبَهُ وَلَ","يَأتي مِنَ الأَخلاقِ غَيرَ جَميلِها",58,"ل",3,0],["لا تُقَلِّل إِذا هَمَمتَ بِجَدوى","إِنَّ شَرَّ الأَعدادِ عِندي القَليلُ",59,"ل",1,0],["لا تَقُدْ جَحفَلاً فأنتَ من النَّج","دَةِ والبأسِ جَحْفَلٌ جَرَّارُ",60,"ر",1,0],["لا تَقطَعَنْ عادتي التي سَلَفَت","ولا تَرُدَّنَّ سَرحتي بَرَحا",61,"ح",2,0],["لا تَقُل ذا مَكسَبٍ يَز","ري فَقَصدُ الناسِ أَزرى",62,"ر",2,0],["لا تَقولَنَّ لِشَيءٍ قَد مَضى","لَيتَهُ لَم يَكُ بِالأَمسِ ذَهَب",63,"ب",1,0],["لا تَقرِنَنَّ الحُسنَ مِنكَ بِضِدِّهِ","إِنَّ الإِساءَةَ لِلجَمالِ تُنافي",64,"ف",2,0],["لا تَقُم لي مَعَ التَقاعُدِ عَنّي","فَقِيامِ النُفوسِ بِالوُدِّ أَولى",65,"ل",2,0],["لا تَقُل إِنَّها لَيالٍ شِرافٌ","لَستُ أَلقى سُعودَها بِنُحوسِ",66,"س",1,0],["لا تَقبَلِ العُذرَ فَإِنَّ رَبَّهُ","قَد أَضمَرَ التَصحيفَ في كِتابِهِ",67,"ب",2,0],["لا تقولوا قَضَى ولا تندبوه","هذه رجعةُ الغريبِ النائي",68,"ا",2,0],["لا تقل عندَ رحيلك","أس