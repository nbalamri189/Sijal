ttps://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[77,"بحيث القباب البيض والأسل السمر","https://www.poetsgate.com/ViewPoem.aspx?id=34138",""],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[54,"أأسبلتَ دمعَ العينِ بالعبراتِ","https://www.poetsgate.com/ViewPoem.aspx?id=12977",""],[45,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""],[45,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[45,"مَغَاني سُلَيْمَى بالعَقيقِ، وَدُورُها","https://www.poetsgate.com/ViewPoem.aspx?id=31289",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[47,"وزائرٍ حببهُ إغبابهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14664",""],[35,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[51,"فِطرٌ توسّط يومُه الأسبوعا","https://www.poetsgate.com/ViewPoem.aspx?id=29512",""],[39,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["وَتَبادَروا عَطَّ الجُيوبِ وَعاجَلوا","عَضَّ الأَنامِلِ يَمنَةً وَشِمالا",0,"ل",2,0],["وَتَبَلَّغَت آراؤُهُ فَكَأَنَّها","طَلَعَت وَفي سَجفِ الغُيوبِ فُتوقُ",1,"ق",1,0],["وَتَبَلَّجَ البَيتُ الحَرامُ طَلاقَةً","مُذ قيلَ إِنَّ جَمالَهُ مَردودُ",2,"د",1,0],["وَتَبْكي بِعَيْنٍ لا تَجُودُ بِعَبْرَةٍ","وَأَبْكِي بِعَيْنٍ جَمَّةٍ عَبَراتُها",3,"ت",3,0],["وَتَبْسِمُ في رَأْدِ الضُّحى وَتَؤودُها","أَبابِيلُ مِنْ طَيْرٍ عَلَيْها تُغَرِّدُ",4,"د",1,0],["وتَبْغي لديْكَ الانتصارَ من امرئٍ","إذا عُدَّ مَجْدٌ كانَ في أخرَياتِهِ",5,"ت",2,0],["وتبرَّضي النُّغَبَ الثِّمادَ وجاوِري","سَرَواتِ حَيٍّ بالبِطاحِ خُلوفِ",6,"ف",1,0],["وتُبعَثُ أرْسالاً عِجالاً إليهمُ","كما تابَعَ الطّعْنَ الكَمِيُّ المخالِسُ",7,"س",1,0],["وَتُبصِرُ عَيني الرَبوَتَينِ وَحاجِر","وَسُكّانَ ذاكَ الجِزعِ بَينَ المَراتِعِ",8,"ع",1,0],["وَتَبْلُغُ أَعْنَانَ السَّمَاءِ بِهِمَّةٍ","بِغَيْرِ جَمِيلِ الذِّكْرِ لَيْسَ لَهَا هَمُّ",9,"م",1,0],["وَتَبَدَّيْتُ لِلنَّوَاظِرِ مِحْرَا","باً كَأَنَّ الإِنَاءَ فِيَّ إِمَامُ",10,"م",1,0],["وتَبْسِمُ ما بيْنَ الوَشيجِ ثُغورُهُمْ","وما بيْنَ قُضْبِ الدّوْحِ يبْتَسِمُ الزّهْرُ",11,"ر",1,0],["وتَبْصِرُ سُحْباً منْ دُروعٍ سَوابغٍ","يَطيرُ بِها عزْمٌ ويَقْدُمُها نصْرُ",12,"ر",1,0],["وتبِعْتَ آثارَ النّبيّ مُيَمِّماً","ما أمَّهُ صِدّيقُهُ وشَهيدُهُ",13,"د",2,0],["وَتَبَرَّأَ الشَّيْطَانُ لَمَّا أَنْ رَأَى","حِزْبَ الْهُدَى مِنْ حِزْبِهِ الْمَغْلُوبِ",14,"ب",1,0],["وَتَبَلْبَلَتْ بِاللَّيْلِ أَلْسُنُ نَارِهِ","تَصِلُ الصُّرَاخَ فَمَا لَقِينَ مُجيبَا",15,"ب",2,0],["وتبوأوا دار الخلافة ملجأً","فَلَهُمْ بِعَقْوَةِ بَابِها اسْتِجْدَاءُ",16,"ا",2,0],["وَتَبسِمُ عَن مَهاً شَبِمٍ غَرِيٍّ","إِذا يُعطى المُقَبِّلَ يَستَزيدُ",17,"د",1,0],["وَتَبرُدُ بَردَ رِداءِ العَرو","سِ رَقرَقتَ بِالصَيفِ فيهِ العَبيرا",18,"ر",2,0],["وَتُبعَثُ في أَرضِكَ الأَنبِياءُ","وَيَأتي لَكَ الغَربُ مُستَرشِدا",19,"د",2,0],["وَتَبَدّى في صِبغَةٍ مِن أَديمِ ال","لَيلِ مَصقولَةٍ بِحُسنِ الطِلاءِ",20,"ا",2,0],["وَتَبَّ مَن قالَ إِنَّ حَدبَتَهُ","في ظَهرِهِ مِن عَبيدِهِ حَبَلُ",21,"ل",1,0],["وَتَبرُزُ خَلفَ حِجابِ العَفافِ","وَتَسفِرُ تَحتَ نِقابِ الخَجَل",22,"ل",1,0],["وَتَبسِمُ عَن أَغَرَّ لَهُ غُروبٌ","فُراتِ الرَيقِ لَيسَ بِهِ فُلولُ",23,"ل",1,0],["وتبصر النور الخفي الذي","مزق عند الغيم ذاك العقاب",24,"ب",1,0],["وَتُبْدِعِينَه وَتَنْقُلِينَهْ","لِمُرْتَقَى جِيلٍ تُجَدِّدِينَهْ",25,"ن",2,0],["وَتَبْرُزَ القُمَمُ الشَّمَّاءُ ذَاهِبَةً","فِي الأَوْجِ تَحْسَبُهَا أَجْزَاءَ أَعْنَانِ",26,"ن",1,0],["وَتَبَيَّنُوا خَطَرَ اللِّدَادِ فَلَيَّنُوا","مِنْ جَفْوَةِ الجَبَرُوتِ وَالسُّلْطَانِ",27,"ن",1,0],["وَتَبَسُّطُ المُعْطِي بِهَا من نَفْسِهِ","غَيْرُ التَّبَسُّطِ من عَطَاءِ بَنَانِ",27,"ن",1,0],["وَتُبِينُ عَنْ وُدٍّ لَهُ","أَضْعَافُهُ طَيَّ الجَنَانِ",28,"ن",1,0],["وَتَبكي لِآثارٍ لِآلِ مُحَمَّدٍ","فَقَد ضاقَ مِنكَ الصَدرُ بِالحَسَراتِ",29,"ت",1,0],["وَتَبسِمُ عَن نورِ الأَقاحِيِّ أَقفَرَت","بِوَعساءِ مَعروفٍ تُغامُ وَتُطلَقُ",30,"ق",1,0],["وَتَبسِمُ عَن عَذبٍ كَأَنَّ غُروبَهُ","أَقاحٍ تَرَدّاها مِنَ الرَملِ أَجرَعُ",31,"ع",1,0],["وَتَبسِمُ لَمحَ البَرقِ عَن مُتَوَضِّحٍ","كَنَورِ الأَقاحِي شافَ أَلوانَها القَطرُ",32,"ر",1,0],["وتبكيه سحب أخجلتها بنانُهُ","وترسل دمع الغيث حزناً مآقيها",33,"ي",3,0],["وتبكيه حتى الشهب في أفق العلا","وتلبَسُ جلباب الظلام جواريها",33,"ي",3,0],["وتبلغُ الغاية القصوى بشائرها","فقد أظلتْ بما ترضى مباديها",34,"ي",3,0],["وتبكي عليك السحبُ ملءَ جفونها","بدمع يُروِّي غُلّة المجدِب الصَّدِي",35,"د",2,0],["وتَبتدِر المُلِمَ إذا عراها","فتَعْرَوْري الجواد بغير سرج",36,"ج",1,0],["وتبنى للعلوم به مبان","تُفيض العلم مؤتلقَ الشعاع",37,"ع",1,0],["وَتَبني المَجدَ يا عُمَرَ بنَ لَيلى","وَتَكفي المُمحِلَ السَنَةَ الجَمادا",38,"د",2,0],["وَتَبدَأُ مِنكُمُ نِعَمٌ عَلَينا","وَإِن عُدنا فَمُنعِمُكُم مُعيدُ",39,"د",1,0],["وَتَبيتُ تَشرَبُ عِندَ كُلِّ مُقَصَّصٍ","خَضِلِ الأَنامِلِ واكِفِ المِعصارِ",40,"ر",1,0],["وَتَبكي عَلى ما فاتَ قَبلَكَ دارِماً","وَإِن تَبكِ لا تَترُك بِعَينِكَ مَدمَعا",41,"ع",2,0],["وَتَبذَخُ مِن سَعدٍ قُرومٌ بِمَفزَعٍ","بِهِم عِندَ أَبوابِ المُلوكِ نُدافِعُ",42,"ع",1,0],["وَتَبِعَ اِنسِجامُهُ اِنسِكابُهُ","وَرَدَفَ اِصطِقافُهُ اِضطِرابُهُ",43,"ب",2,0],["وَتَبَّ اِبنا رَبيعَةَ إِذ أَطاعا","أَبا جَهلٍ لِأُمِّهِما الهُبولُ",44,"ل",1,0],["وتبسم أرجاء الثغورِ مسرةً","بأبلج لا تعبان إلاَّ حسوده",45,"د",2,0],["وتبدو إذا هبَّ النسيم كمبرد","فلا غرْوَ أن تجلي عن المهج الصدا",46,"د",2,0],["وتبسم مع ذا وذا","يزع الخطوب الكاشره",47,"ر",2,0],["وتبر خدّك ديناراً له لمعٌ","لو أنه لعيان الطرف مصروف",48,"ف",1,0],["وتبسَّمت عن لؤلؤٍ متمنع","حتَّى بكيت عليه بالعقيان",49,"ن",1,0],["وتُبْ من الذنبِ الذي جئتَهُ","فقد يُقالُ المذنبُ التائبُ",50,"ب",1,0],["وتبسِمُ عن عِقدين من حَبِّ مزنةٍ","به ماثَ صفوَ الراح بالمسك مائثُ",51,"ث",1,0],["وتَبسّلون إذا السبا","عُ تنمَّرتْ ولها زئيرُ",52,"ر",1,0],["وتبيت بين مُقابل ومدابرٍ","مثل الطريق لمقبلٍ ولمدبر",53,"ر",1,0],["وتبيتُ من قرع القوارع آمناً","ويبيت من يهوى رداك مروعا",54,"ع",2,0],["وتُبقّي جدَّة اللذ","ذاتِ في عينِ الملولِ",55,"ل",1,0],["وتبذل كفَّاهُ عقائلَ ماله","ليسكتَ سُؤَّالٌ وينطقَ عذّالُ",56,"ل",1,0],["وتبني العلا حتى يخالك معشرٌ","وما أَبعدوا تبني إلى المجد سُلَّما",57,"م",2,0],["وتبدَّتْ مثل الهَدِيِّ تهادَى","رادعَ الجيْب عاطرَ الأبدان",58,"ن",1,0],["وتبوحُ البحارُ بالدُّرِّ بَوْحاً","وبما أضمرتْ من المَرْجان",58,"ن",1,0],["وَتُبلى الأُولى يَستَلئِمونَ عَلى الأولى","تَراهُنَّ يَومَ الرَوعِ كَالحِدَإِ القُبلِ",59,"ل",1,0],["وَتَبسِمُ عَن أَلمى شَتيتٍ نَباتُهُ","لَذيذٍ إِذا جادَت بِهِ واضِحِ الثَغرِ",60,"ر",1,0],["وَتَبَسَّمَت فَرَأَيتُ رِئماً ضاحِكاً","عَن لُؤلُؤٍ لَكِنَّهُ لا يوهَبُ",61,"ب",1,0],["وَتَبَدَّلَت تِلكَ العَرا","صُ مِنَ النَضارَةِ بِالدُثورِ",62,"ر",1,0],["وَتَبَدَّدَ العُشّاقُ مِثلَ","تَبَدُّدِ الوَرَقِ النَثيرِ",62,"ر",1,0],["وَتُبصِرُ في صُدورِهِم أَناةً","إِذا الأَحلامُ طاعَ بِها الخِصامُ",63,"م",1,0],["وَتَبكِ النَصارى فَخرَها وَعَميدَها","فَما بَعدَهُ مِن حُجَّةٍ لِمُفاخِرِ",64,"ر",1,0],["وَتَبَدّى الصَباحُ كَال","بِشرِ في وَجهِ مُحسِنِ",65,"ن",1,0],["وتَبُثُّ فينا مِنْ مراحِ","الكونِ مَا يُغوي الوَقُورْ",66,"ر",1,0],["وتبقَى البُذورُ التي حُمِّلَتْ","ذخيرَةَ عُمْرٍ جميلٍ غَبَرْ",67,"ر",1,0],["وتَبُثِّينَ رقَّةَ الشوقِ والأَحلامِ","والشَّدوِ والهوى في نشيدي",68,"د",2,0],["وتبدو كما خُلِقَتْ غَضَّةً","يَفيضُ على وَجْهِها الإِبْتِسامْ",69,"م",1,0],["وَتَبلى بي ضَلالَتُهُم","لِيَزدادَ الهُدى جِدَّهْ",70,"د",2,0],["وتباعدت عني ولم تنظر إلى","أسفي هناك ودمعي الذراف",71,"ف",1,0],["وتبيد ملك الذاهبين بعزه","الصائرين بسوقه لكساد",72,"د",1,0],["وتبرع بالفضل من","متأدّب يرعى السبب",73,"ب",1,0],["وتبعث من ملحها حفنة","لعين الحسود إذا ما نظر",74,"ر",1,0],["وتبتغون السلو منى","يا مالك الروح كيف تُسلى",75,"ل",2,0],["وتبسط في ثراك يد الرجاء","وتُلقى فيه آمال البنينا",76,"ن",2,0],["وتبرح الفرع نحو الفرع جاذبه","بالغصن فالفرع نحو الفرع منجذب",77,"ب",1,0],["وَتُبصِرُها حَولَ بيبا الرَئيس","وَفي شارِبَيهِ وَحَولَ الفَمِ",78,"م",1,0],["وَتَبلُغُ مَوضِعَ أَوطارِها","وَتُفشي سَريرَتَها الخافِيَه",79,"ي",2,0],["وَتَبَسُّمٍ يَعلو أَسِرَّتِها كَما","يَعلو فَمَ الثَكلى وَثَغرَ الأَيِّمِ",80,"م",1,0],["وَتَبَيَّنوا مَعنى الوُجودِ فَلَم يَرَوا","دونَ الخُلودِ سَعادَةً تَتَحَقَّقُ",81,"ق",1,0],["وَتَبديلَهُ ظُلُماتِ الضَلالِ","بِصُبحِ الهِدايَةِ لَمّا سَفَر",82,"ر",1,0],["وَتَبدو عَلَيهِ الفُلكُ شَتّى كَأَنَّها","بُؤوزٌ تُراعيها عَلى البُعدِ أَعقُبُ",83,"ب",1,0],["وتبييضُه مثل تحميره","ولا تغفلنَّ بإغفاله",84,"ل",2,0],["وتبلّدوا فيها وما عرفوا","كيف الطريق والطريق جدد",85,"د",1,0],["وتبرَّجَتْ للمجدِ همَّتُهُ","فانصاعَ منها الجبنُ والبُخُلُ",86,"ل",1,0],["وتبادرتْها البُزْلُ وانعكستْ","فيها على أصحابِها الحِيَلُ",86,"ل",1,0],["وتبوخُ نارٌ في الأضالع أوقدتْ","ويجفُّ شجوٌ في الفؤاد توغَّلا",87,"ل",2,0],["وَتَبَسُّماتِكَ لِلعَطاءِ كَأَنَّها","زَهرُ الرَبيعِ خِلالَ رَوضٍ مَعشِبِ",88,"ب",1,0],["وَتَبدَهُني إِذا ما الكَأسُ دارَت","بِنَزقاتٍ تَجيءُ عَلى البَريدِ",89,"د",1,0],["وَتَبتَعِثُ الأَشجانُ نِيَّةُ غادَةٍ","أَناةٍ كَخَوطِ الخَيزُرانَةِ رودِ",90,"د",1,0],["وَتَبَدَّلتُ مِنهُمُ البَدَلَ الأَع","وَرَ بَينِ قُذرَةٍ وَأَفيكِ",91,"ك",1,0],["وَتَبَسَّمَت عِندَ الوَداعِ فَأَشرَقَت","إِشراقَةً عَن عارِضٍ مَصقولِ",92,"ل",1,0],["وَتَبَسَّمَت عَن لُؤلُؤٍ في رَصفِهِ","بَرَدٌ يَرُدُّ حُشاخَةَ المَتبولِ",93,"ل",1,0],["وَتَبكِ عَلَيهِ الشَمسُ وَالقَمَرُ الَّذي","بِهِ يَدَعُ السارينَ ميلَ العَمائِمِ",94,"م",1,0],["وتَبتسمُ القِبابُ البِيضُ منها","على خَضراءَ مُحمرٍّ جَناها",95,"ا",3,0],["وَتبوَّأتَ بالشآم مَحَلاًّ","كلَّ يومٍ يزدادُ منك جَمالا",96,"ل",2,0],["وتبسَّمتْ فجلَتْ له عن واضحٍ","متألِّقٍ يَجلو الظَّلامَ الرَّاكِدا",97,"د",2,0],["وتُبْعَثُ للبرِّ وحشيّةٌ","تسوقُ إلى الوحشِ يوماً عَصيبا",98,"ب",2,0],["وَتَبكي عَلى بَعلٍ لَها راحَ غادياً","وَلَيسَ إِلى يَومِ الحِسابِ بِقافِلِ",99,"ل",1,0],["وَتَبسِمُ عَن ثَغرٍ نَقِيٍّ كَأَنَّهُ","مِنَ اللُؤلُؤِ المَكنونِ في صَدَفِ البَحرِ",100,"ر",1,0],["وَتَبَدّى وَجهُهُ وَتَجَلّى","صَيَّرَ اللَيلَ البَهيمَ صَباحا",101,"ح",2,0],["وَتَبَرَّعوا حَتّى تَصولَ","فَحينَ صُلتَ تَبَرَّأوا",102,"ا",1,0],["وَتَبِعتَ سُنَّةَ أَحمدٍ وأريتنا","مِنْ فِعْلِهِ في الفعلِ منك مثالا",103,"ل",2,0],["وتبلغُ بنتُ الكرم من فرح الفتى","بلذّتها ما ليس يبلغُه البِتْعُ",104,"ع",1,0],["وتبسمُ في جُنح الدجى وهو عابسٌ","فيضحكُ منها عن بروقٍ لها لَمعُ",104,"ع",1,0],["وتبدي دخاناً صاعداً من منَافِسٍ","مُصَنْدَلَةٍ أنْفاسُهُ ومُعنبَرَه",105,"ر",2,0],["وَتبسمُ عَن أَقحُوانٍ تُريكَ","على نَوْرِهِ الشمسُ إشراقَ نورِ",106,"ر",1,0],["وَتَبَدَّلتُ بِالبَشاشَةِ حُزناً","بَعدَ لَهوٍ في مَربَعٍ وَمصَيفِ",107,"ف",1,0],["وَتَباريحُ اِشتِياقٍ","وَهُمومٌ طارِقاتُ",108,"ت",1,0],["وَتَباعُدي حَذَرَ الوُشا","ةِ وَأَنتَ مِن قَلبي قَريبُ",109,"ب",1,0],["وَتَبسُطُ كَفّاً في الحُقوقِ كَأَنَّما","أَنامِلُها في البَأسِ وَالجودِ أَذرُعُ",110,"ع",1,0],["وَتَبَدَّلتَ مَنزِلاً ظاهِرَ الجَد","بِ يُسَمّى مُقَطِّعَ الأَسبابِ",111,"ب",1,0],["وَتُبرَدُ بَينَنا أَبَداً قَوافٍ","وَشيكُ الفَوتِ مِنها لِلَّحاقِ",112,"ق",1,0],["وَتَباشَروا كَتَباشُرِ الحَرَمَينِ في","قُحَمِ السِنينِ بِأَرخَصِ الأَسعارِ",113,"ر",1,0],["وتبدَّلت تلكَ المحاسنُ وانثنتْ","تلك القدورُ وخُرِّبَ المعمورُ",114,"ر",1,0],["وَتَبيتُ عُوّادي وَقَد يَئِسوا","مِنّي وَأَصبِحُ مِثلَ ما أُمسي",115,"ي",1,0],["وَتَبادَرَت عَينايَ بَعدَهُمُ","فَاِنهَلَّتا جَزَعاً عَلى الصَدرِ",116,"ر",1,0],["وَتَبَيَّنا أَنَّ الثَواءَ لُبانَةٌ","مِنّي وَحَبسُهُما عَلَيَّ كَبيرُ",117,"ر",1,0],["وَتَبسِمُ عَن غَرٍّ شَتيتٍ نَباتُهُ","لَهُ أُشُرٌ كَالأُقحُوانِ المُنَوِّرِ",118,"ر",1,0],["وَتَبَوَّأَت مِن بَطنِ مَكَّةَ مَسكِناً","غَرِدَ الحَمامِ مُشَرَّفَ الأَبوابِ",119,"ب",1,0],["وَتَبأى العُلى مِنهُ بِأَبيَضَ ماجِدٍ","يُجَرِّدُ دونَ المَجدِ أَبيَضَ ماضِيا",120,"ي",2,0],["وَتَبلي وِصالَ الواصِلينَ فَتَعلَمي","خَلائِقَ مَن يُصفي الهَوى وَيَشوبُ",121,"ب",1,0],["وتبصرة الحكيم إذا تناهى","وأسلمه التلمس والطلاب",122,"ب",1,0],["وتَبيَّنُوا أنّ الهوانَ لِقانعٍ","مِن دَهرهِ بِنفاقهِ وريائهِ",123,"ا",3,0],["وتبعثُها الوغَى فيسيلُ منها","عُبابُ الموتِ يطوي المعتدينا",124,"ن",2,0],["وتَبذُلُ فيه أَنْفُسَها فَتَبْقَى","لَكَ البُشْرَى نعمتَ وكنتَ تشقى",125,"ق",2,0],["وَتُبصِرُ أَرماحَهُ في الوَغى","أَطوَلا وَأَسعُدَهُ أَتوَلا",126,"ل",2,0],["وَتَبكي عَلى أَصحابِ لَيلَةِ جِعثِنٍ","بُكاءَ اِمرِئٍ لِلمُخزِياتِ رَؤومِ",127,"م",1,0],["وَتَبذُلُ لي سَلمى إِذا نِمتُ حاجَتي","وَتُلفى خِلالَ النُبهِ وَهيَ مَنوعُ",128,"ع",1,0],["وَتَبَسَّمَت لِيَ عَن أَغَرَّ مُؤَشَّرٍ","ظَلمِ تَحَيَّرَ بارِدٍ أَنيابُهُ",129,"ب",2,0],["وَتَبَرَّزَ النُجُبُ الجِيا","دُ وَقامَتِ الكُذُبُ المَحامِر",130,"ر",1,0],["وَتَبسِمُ عَن عَذبٍ زُلالٍ كَأَنَّهُ","نِطافَةُ مُزنٍ صُفِّقَت بِشَمولِ",131,"ل",1,0],["وَتَبَرَّأَ الضُعَفاءُ مِن إِخوانِهِم","وَأَلَحَّ مِن حَرِّ الصَميمِ الكَلكَلُ",132,"ل",1,0],["وَتَبَارَأْنَا من النَّصْبِ وَالرَّفْ","ضِ وَأَوْجَبْنَا لكلٍّ جَنابا",133,"ب",2,0],["وتَبَدَّلَتْ أَبَوا الغُلامِ بِقَتْلِهِ","بأبرَّ مِنهُ لِوَالِدَيْهِ وأَرْشَدِ",134,"د",1,0],["وتَبَدَّلَتْ مِنِّي الصَّبابَةُ سَلْوَةً","صِينَتْ بها عَبَراتِي المُتَبَذَّلَهْ",135,"ل",2,0],["وتُبَاشِرُ الفلكَ الأثيرَ كأنّمَا","تَبغي بهِنَّ إلى السماء رَحيلا",136,"ل",2,0],["وتَبَسَّموا فزَها وأخصَبَ ماحِلٌ","وافترَّ في رَوضاتِه النُّوّار",137,"ر",1,0],["وَتَبسِمُ عَن أَغَرَّ كَأَنَّ فيهِ","مُجاجَ سُلافَةٍ مِن بَيتِ راسِ",138,"س",1,0],["وَتَبَدَّلتُمُ سِوانا خَليلاً","وَسِواكُم عَلى الفُؤادِ حَرامُ",139,"م",1,0],["وَتَبَطَّنتُهُ وَحارِسُنا اللَي","لُ عَلَينا مِنهُ لِحافُ ظَلامِ",140,"م",1,0],["وَتُبعَدُ أَن لَم أَنِك أُمَّهُ","وَأَمّا المُثَنّى فَلا يُبعَدُ",141,"د",1,0],["وَتُبَّعٌ وَسَرابيلُ الحَديدِ لَهُ","أَزمانَ يُنسَجُ في أَزمانِهِ الزَرَدُ",142,"د",1,0],["وَتَبسُطُ فينا قُدرَةُ اللَهِ حادِثاً","فَتودي الثَعالي وَاللُيوثُ الكَهامِسُ",143,"س",1,0],["وتَبْيَضّ البلادُ إذا أراحوا","بما نَضَحَتْه أخْلافُ السَّوامِ",144,"م",1,0],["وَتَبسِمُ عَن أَلمى كَأَنَّ مُنَوِّراً","تَخَلَّلَ حُرَّ الرَملِ دِعصٌ لَهُ نَدي",145,"د",2,0],["وَتَبسِمُ عَن عَذبِ اللِثاتِ كَأَنَّهُ","أَقاحي الرُبى أَضحى وَظاهِرُهُ نَدِ",146,"د",1,0],["وَتَبَدَّلوا اليَعبوبَ بَعدَ إِلَهِهِم","صَنَماً فَقَرّوا يا جَديلَ وَأَعذِبوا",147,"ب",3,0],["وَتَبتَزُّ يَعفُورَ الصَرِيمِ كِناسَهُ","فَتُخرِجُهُ مِنهُ وَإِن كانَ مُظهِرا",148,"ر",2,0],["وَتبصر عصفوراً تزين ريشه","يغرد في عالي الغصون وَيصفر",149,"ر",1,0],["وَتَبقى عليه هَكَذا متسيطراً","تمص دم الأموال منه وتهضم",150,"م",1,0],["وتبصر اللَه جهرا","فإنه يتجلى",151,"ل",2,0],["وَتَبينوا أَحد الرؤوس فأَيقَنوا","أن ذاك رأس معدد الديران",152,"ن",1,0],["وتَبِعْنا على خُطى الفجر موسِي","قى من العُشب والندى والظلالِ",153,"ل",1,0],["وتُبدي ليَ الأنجمُ الوامقاتُ","رفيفَ الأماني على ثغرها",154,"ه",2,0],["وتبذَّلتُ في غرامي فلم أحْ","بِسْ على لذةٍ شياطينَ رِجْسي",155,"ي",1,0],["وتَبْغي على القاعِ السّويّ تَثَبّتاً","فيمْنَعُها منْ أن تَثَبّتَ لينها",156,"ن",3,0],["وتَبْتَسِمُ الأشْراطُ فَجْراً كأنها","ثلاثُ حَماماتٍ سَدِكْنَ بمَوْقِع",157,"ع",1,0],["وَتُبصِرُ عَيني الرَبوَتَينِ وَحاجِراً","وَسُكّانَ ذاكَ الجِزعِ بَينَ المَراتِعِ",158,"ع",1,0],["وتَبَيَّنَ لَدُن بَلَغتَ مِنَ السِّ","نِّ كثيراً بالنَّاصحِ العَمَّالِ",159,"ل",1,0],["وَتَبْسِمُ عَنْ جُمَانٍ فِي عَقِيقٍ","يُقَالُ لَهُ بِحُكْمِ الذَّوْقِ ثَغْرُ",160,"ر",1,0],["وَتُبْنَى لأوْطَانِهِمْ أُمَّةٌ","أَبَرُّ بِهَا وَلَهَا أَرْحَمُ",161,"م",1,0],["وَتَبُثَّهُ شُكْرَ الرَّيَاضِ لِدِيمَةٍ","هَطَّالَةٍ أَرْوَتْ لَهُنْ غَلِيلاَ",162,"ل",2,0],["وَتَبْقَى بَعْدَ مُبْدِعِهَا مَعَانٍ","جَنَتْ لِذَّاتِها مِنْهَا العُقُولُ",163,"ل",1,0],["وَتبْذلُ حَبَّات الْقُلُوبِ كرامَةً","لدَيكَ وَيُزْرِي أَنْ يَضَنَّ بِهِ التِّبرُ",164,"ر",1,0],["وَتَبْتَدِرِينَ الخَيْرَ حَتَّى كَأَنَّمَا","تَفِينَ بِمَقْضِيَّ الأَدَاءِ معُجَّلِ",165,"ل",1,0],["وَتَبْدُرُ مِنْهُ غَضْبَةٌ جَبَلِيَّة","لَهَا جُؤْجُؤٌ يَوْمَ الحِفَاظِ وَسَاعِدُ",166,"د",1,0],["وَتَبَدَّى الإِحْجَامُ فِي صُورَةٍ زَلاَّ","ءَ جَرَّتْ إِقْدَامَ أَهْلِ الفَسَادِ",167,"د",1,0],["وَتَبَيَّنُوا فَضْلَ التَّعَا","وُنِ مِنْ مَرَافِقِهِ الرِّغَابِ",168,"ب",1,0],["وَتَبَيَّنُوا أَنَّ الخُنُوعَ مَهَانَةٌ","لاَ يُسْتَطَالُ بِهَا مَدَى الآجَالِ",169,"ل",1,0],["وَتَبَدَّلْ مِنْ بُؤْسِ أَيَّا","مِكَ الخُلْدَ فِي فَرَحْ",170,"ح",1,0],["وَتَبكي في نَواحيهِ الغَوادي","بِأَدمُعِها وَتَبسِمُ عَن أَقاحِ",171,"ح",1,0],["وتبسمت فعلمت أن","رجعت لناتلك الموده",172,"د",2,0],["وتبرق النجوم في الضفيرهْ","غني لنا... أيتها الأميره!",173,"ه",1,0],["وَتَبادَرُوا صَوْبَ النَجا","ةِ لَعَلَّهُمْ يَجِدُونَ ثَقْبَا",174,"ب",2,0],["وتَبْعَثُ حَسَّان من رَمْسِهِ","وتُحيِي عُكاظَ وسُمَّارها",175,"ر",3,0],["وتَبسمٌ للمعضِلاتِ كأنّه","إشراقُ وجهِ الروضةِ المئنافِ",176,"ف",1,0],["وتبريحُ أشواقٍ إذا ما تَنفّسَتْ","يكادُ لها فحمُ الدجَى يتلهَّبُ",177,"ب",1,0],["وتبرأ الشيطانُ لمَّا أن علا","حزبُ الهدى من حزبِهِ المغلوب",178,"ب",1,0],["وتبعت آثار النبي ميمما","مما أمه صديقه وشهيده",179,"د",2,0],["وتبصر سحبا من دروع سوابع","يطير بها عزم ويقدمها نصر",180,"ر",1,0],["وتبوَّءوا دارَ الخلافة ِ ملجأً","فلهم بعَقوة ِ بابها استِجداءُ",181,"ا",2,0],["وتبنّت الأحلام ، هجمته ،","وبدّلت المواقف",182,"ف",1,0],["وتبارَى الوفودُ من كل فَجٍّ","كلُّ فرد مُشفَّعٌ برديف",183,"ف",1,0],["وتبدو الرجولةُ في شِعره","منزَّهةً من صعىً أو صَعر",184,"ر",1,0],["وتَبْكي على آثارِ آلِ مُحمَّدٍ فقد","ضاقَ منكَ الصدرُ بالحسراتِ",185,"ت",1,0],["وَتَبَسّمَتْ عَن لُؤلُؤٍ، في رَصْفِهِ","بَرَدٌ، يَرُدُّ حُشَاشَةَ المَتْبُولِ",186,"ل",1,0],["وَتَبَدَّلْتُ مِنْهُمُ الْبَدَلَ الأَعْوَرَ","مِنْ بَيْنِ قُذْرَةٍ وأَفِيكِ",187,"ك",1,0],["وَتَبيَضُّ وَجْهاً للسّؤالِ، وَأحْسَنُ ال","غُيومِ، إذا استَوْفاهُ لحظٌ، صَبيرُهَا",188,"ر",3,0],["وتبسم عن ألمى كأن منوراً","تخلل حر الرمل دعصٌ له ند",189,"د",1,0],["وَتَبِعَ انْسِجَامَهُ انْسِكَابُهُ","وَرَدَفَ اصْطِفَاقَهُ اضْطِرَابُهُ",190,"ب",2,0],["وتبسِمُ عَنْ أغرَّ لهُ غُروبٌ","فراتِ الرّيقِ ليسَ لهُ فلولُ",191,"ل",1,0],["وتبيتُ من وقع القوارعِ آمناً","ويبيتُ من يهوى رداك مَروعا",192,"ع",2,0],["وتبذُلُ لي سلمَى إذا نمتُ حاجَتي","تُلْفَى خِلالَ النُّبْهِ وَهْيَ مَنُوعُ",193,"ع",1,0],["وَتَبْكِي كَمَا تَفْتَرُّ فِي لَحْظَةٍ مَعَا","وَتَرْضَى مَعَ الرَّاضِي وَتَأْسَى لِذِي الغِلِّ",194,"ل",1,0]]}