{"poems":[[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[87,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[63,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[82,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[82,"كل يوم مودع أو مودع","https://www.aldiwan.net/poem31388.html","الخفيف"],[33,"سحرتني الزرقاء من مارون","https://www.aldiwan.net/poem41282.html","الخفيف"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[50,"لم أبك في مجلس منصور","https://www.aldiwan.net/poem63353.html","السريع"],[52,"حن قلبي إلى غزال ربيب","https://www.aldiwan.net/poem64826.html","الخفيف"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62217","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9960","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[52,"حنَّ قلبي إلى غزالٍ ربيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=17916",""],[92,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[47,"قالتِ: الشَّيْبُ بَدا، قلتُ: أجَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=32070",""],[164,"مقعد صدق لمليك مقتدر","https://www.aldiwan.net/poem58936.html","الرجز"],[196,"نسب الجماز مقصور","https://www.aldiwan.net/poem27576.html","مجزوء الرمل"],[289,"رحل المطي إليك طلاب الندى","https://www.aldiwan.net/poem44335.html","الكامل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[333,"بعد حين ستواريني كما","https://www.aldiwan.net/poem55021.html","مجزوء الرمل"],[347,"انا خيال ارى حالي بلا حال","https://www.aldiwan.net/poem55381.html","البسيط"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[384,"إن لها في العام ذي الفتوق","https://www.aldiwan.net/poem4571.html","الرجز"],[435,"جاءت الأفراح بالبشرى على","https://www.aldiwan.net/poem41021.html","الرمل"],[463,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[482,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[484,"إيطاليا قيل قالت","https://www.aldiwan.net/poem37202.html","المجتث"],[484,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[556,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[563,"في امتزاج الوجود بالعدم","https://www.aldiwan.net/poem33871.html","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104591","الخفيف"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119250","الكامل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96594","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133787","الرمل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25357","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95544","الخفيف"],[288,"","https://poetry.dctabudhabi.ae/diwan/poem/200300","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66236","الرجز"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103245","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110256","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120753","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100924","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201738","الرجز"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101597","الخفيف"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216702","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131067",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136860",""],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105119","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104533","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139294","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72803","الخفيف"],[4767,"الرحلة الطويلة","https://www.poetsgate.com/ViewPoem.aspx?id=87925",""],[4767,"عقد عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=214681",""],[4578,"مرسلٌ فوق نجيل الخصر شد","https://www.poetsgate.com/ViewPoem.aspx?id=49408",""],[4875,"شي ثاني","https://www.poetsgate.com/ViewPoem.aspx?id=133356",""],[5028,"الفصول الأربعه","https://www.poetsgate.com/ViewPoem.aspx?id=27714",""],[5064,"استبصار","https://www.poetsgate.com/ViewPoem.aspx?id=199090",""],[5102,"أطوار حرب العزة","https://www.poetsgate.com/ViewPoem.aspx?id=12862",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5386,"انتهيك","https://www.poetsgate.com/ViewPoem.aspx?id=34999",""],[5561,"آثار الظل","https://www.poetsgate.com/ViewPoem.aspx?id=198219",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5694,"ياشين قهر الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=129914",""],[5804,"بشرّوها","https://www.poetsgate.com/ViewPoem.aspx?id=180097",""],[5829,"صرخة المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=152733",""],[1920,"منديل وقطعة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=201574",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6124,"عِِشرُونَ عَاماً","https://www.poetsgate.com/ViewPoem.aspx?id=103198",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""]],"verses":[["تَنتَصِبُ اِنتِصابَهُ لِنَبأَةٍ","ذُعراً وَيَنصاعُ لَها اِنصِياعَها",0,"ع",3,0],["تَنْتَهِبُ الأرْضَ بكُلِّ حافِرٍ","كالقَعْبِ وهْوَ كالصَّفا على الصّفا",1,"ا",1,0],["تَنتابُهُ طُلسُ السِباعِ مُغادَر","في قَفرَةٍ مُتَمَزِّقِ الأَوصالِ",2,"ل",1,0],["تنتابُها طيرُ الرجاء فتجتني","ثمرَ المنى من دوحة الآلاءِ",3,"ا",2,0],["تنتحي مقتلَ الخصيم وَقوراً","لا خفيفاً عند الخُفوف نَزوقا",4,"ق",2,0],["تَنتابُ آلَ أَبي سُفيانَ واثِقَةً","بِفَضلِ أَبلَجَ مُنجازٍ لِما يَعِدُ",5,"د",1,0],["تَنتابُ بِالرُكبانِ مَنزِلَةَ الهُدى","وَتَؤُمُّ دارَ الحَقِّ وَالإِنصافِ",6,"ف",1,0],["تَنْتابُهُ نُوَبُ الخُطوبِ فتَنْثَني","عنه وهل تَثني الخطوبُ مَتالِعا",7,"ع",2,0],["تنتخي السادات عزّاً فإذا","قَرُبَتْ من عنده صارتْ خدمْ",8,"م",1,0],["تنتحي بالأراك ثغر أقاحٍ","للندى فيه ريقةٌ تَتَمَيَّع",9,"ع",1,0],["تَنتَحيني فَلا تَرى وَتَرى النا","سَ بِصَعبٍ مُمَنَّعٍ مَأمونِ",10,"ن",1,0],["تُنَتَّجُ أَمواتاً وَتُلقَحُ بَعدَما","تَموتُ بِلا بُضعٍ مِنَ الفَحلِ مُلقِحِ",11,"ح",1,0],["تَنتَسِبُ الأَلسُنُ مِن وَصفِهِ","إِلى مَدى عَجزٍ وَتَقصيرِ",12,"ر",1,0],["تَنتَحي النَفسُ في هَواها فَيَرضى","مِن حَديثِ الجُلوسِ بِالمَحبوبِ",13,"ب",1,0],["تَنتابُها سُعدى وَأَترابُها","في ظِلِّ عَيشٍ حافِلٍ مُعجِبِ",14,"ب",1,0],["تَنْتَابُهُ غَرِضِينَ عِنْدَ صَوَافِنٍ","وضَوَامِرٍ يَصْرِفْنَ بِالأَكْوِارِ",15,"ر",1,0],["تَنتابُهُ طُلسُ السِباعِ مُغادَراً","في قَفرَةٍ مُتَمَزِّقِ الأَوصالِ",16,"ل",1,0],["تَنْتَابُهُ الصَّدَمَاتُ لاَ يَشْكو لَهَا","إِلاَّ شَكَاةَ المِحْرَبِ الْكَرَّارِ",17,"ر",1,0],["تَنتَهي مَأثُرَةُ الدَهرِ إِلى","جَبَلٍِ وُسِّطَ في طَيءِ الجَبَل",18,"ل",1,0],["تنتحي النفسَ في هواها فيرضى","من حديث لاجلوس بالمحبوب",19,"ب",1,0],["تنتاشُه كفُ المنية صارماً","عَضْباً يفُلُ العضبَ حدُّ مضائه",20,"ا",3,0],["تَنْتَهي مأثَرَةُ الدّهْرِ إلى","جَبَلٍ، وُسِّطَ في طَيّ الجَبَلْ",21,"ل",1,0],["تنتشرُ الروحُ إِذا جرَّ الصَّبا","فيها عشياً فضل ذيله العطر",22,"ر",1,0],["تَنتَهي الأَحسابُ بِالنا","سِ وَلا تَعدو قِفاهُ",23,"ا",2,0],["تَنتابُ أَكبَرَ وائِلٍ في بَيتِها","حَسَباً وَقُبَّةً وَمَجدُها مَبنِيَّة",24,"ي",2,0],["تَنتَوي مِن يَزيدَ فَضلَ يَدَيهِ","أَريَحِيّاً فَرعاً سَمينَ الفَعالِ",25,"ل",1,0],["تنتهي أحلام دن","يايَ ويبكيني الوجود",26,"د",1,0],["تنتابني حادثات الدهر عابثة","بالقلب والفكر والحوباء والبال",27,"ل",1,0],["تَنتَهب الأرض له أربَعٌ","للنّار من أطرافِهنّ انقداح",28,"ح",1,0],["تنتاش كل دوحةٍ سحوق","ضاربةٍ في الماء بالعروق",29,"ق",1,0],["تنتهي يا فريد الزمن","بغلام هو أبهى المنن",30,"ن",1,0],["تنتظمُ الحزمَ سياساتُه","نظمَ كعُوب الرمح إلا الوُصومْ",31,"م",1,0],["تنتجيهِ بحديثٍ حَس","أحسنتْ عن ظبيةِ الوعساءِ نقلَه",32,"ل",2,0],["تنتابه صعقات","بزفرة وشهيق",33,"ق",1,0],["تنتابها لفحات السقم آونة","مذ دب فيها دبيب الربح في الشعن",34,"ن",1,0],["تَنْتَقيهِ قُلوبُ قومٍ كِرامٍ","وتَراهُ رَدًّا لكُلِّ رَدِيِّ",35,"ي",1,0],["تنتابك الأيّامُ غيرَ مُذمّمٍ","يَلقى اِمتنانَك واردٌ عن صادرِ",36,"ر",1,0],["تنتفي تارة وتثبت ما","بقيت كالخيال في الحلم",37,"م",1,0],["تَنتحيني يدُ الحبيبةِ فيهِ","بكؤوسٍ مِن المُدامِ رُواءِ",38,"ا",2,0],["تنتابهم حزق الوفود لانهم","وردوا الزلال بروضة غناء",39,"ن",3,0],["تنتاشُ صفراءَ مطروقاً بقيَّتُها","قد كاد يأزى عن الدعموصِ آزيها",40,"ي",3,0],["تنتهي كالطيب لا نوح ولا","مأتم حفل ولا رجع بكاء",41,"ا",2,0],["تنتهي في أي أرض تنتهي","وعلى أي أمانيها الثواء",41,"ا",2,0],["تنتهي لا يعرف الناس ولا","يسأل الناس متى حم القضاء",41,"ا",2,0],["تَنْتَظِم الأَجْوازَ وَالكَعابِرا","أَوْ سِجْنَ دَوَّارٍ فَأَمْسَى دَاثِرا",42,"ر",2,0],["تَنْتَسِفُ النابِتَ بَعْدَ القَمِّ","أَحْرَقَتِ المالَ احتِراقَ الحَمِّ",43,"م",1,0],["تنتقى صفوة الورى لتريهم","أن لهم عند ربهم ما شاؤُوا",44,"ا",1,0],["تَنْتَمِي حَوْلَكَ الأَرَاقِمُ في النَّقْ","عِ كأُسْدٍ طَرِيرةٍ الأَنْيَابِ",45,"ب",1,0],["تنتابها من كل فج أمة","تلوي لها منيبة رقابها",46,"ب",3,0],["تنتاشُ صفراء مطروقاً بَقِيَّتها","قَد كانَ يأذي عن الدَعموصِ آذبها",47,"ه",2,0],["تنتابني وانا مصلي","ةٌ إليه كما ترى",48,"ر",2,0],["تنتمي فخراً لأزكى عترة","خصها الوحي بأسنى أمرة",49,"ه",1,0],["تُنتَزَعُ الأثوابُ طراً به","وأول الأثوابِ ثوبُ الوقار",50,"ر",1,0],["تَنتَخ بِهَا للسِّيفِيَه الطَّويلَه","نَتخَتُها مَأمُونَةٌ جَمِيلَه",51,"ه",1,0],["تَنتَخ بِهِ السيفَ هُناكَ حُكمَا","وَتلزم تلبَرَّ هُنَاكَ لَزما",51,"م",2,0],["تنتاشُ أروقة الحديثِ تلاهياً","عما تكابده من اليَرقانِ",52,"ن",1,0],["تنتشر الأمراض من طياتها","إذ كل مكروب بها قد اختفى",53,"ا",1,0],["تنتحي عالم الخلود لتحيا","حرّة بين روضه وغديره",54,"ر",2,0],["تَنتَحِلُ المَجدَ لَم يَعلَم أَبوكَ بِهِ","هَيهاتَ جارَ بِكَ الإِيرادُ وَالصَدَرُ",55,"ر",1,0],["تَنتابنا بنيوبها","دهياء فاغرة الفمِ",56,"م",1,0],["تنتج ساعاتها الهُموم وَلا","آن تُرى فيهِ غير عَشواءِ",57,"ا",2,0],["تنتقي الثوب ثم تزهد فيه","ثم تُغرى بثوبها المردود",58,"د",1,0],["تنتحي قلبي الهموم دراكا","وإليّ الخطوب تزجي الخطوبا",59,"ب",2,0],["تنتَاشُ غُصنَ الضَّال في مَوليَّةٍ","ميثاء حُفَّ بعرفجٍ وبعوَسج",60,"ج",1,0],["تنتمي بي إلى تبيين ما كنت كاتم","حين مرماي ما له في المحبين رايم",61,"م",1,0],["تنتضي من جفونه مرهفات","أحور زانه إحورار وسحر",62,"ر",1,0],["تنتبذ الارجاس عن أعتابها","فلا يمسهن غير طاهر",63,"ر",1,0],["تنتقل الأخلاق لا شك مع","تنقل الحالات والسن",64,"ن",1,0],["تنتحي المادحون باب معاليك فت","غدو بنائلٍ منك جمِّ",65,"م",1,0],["تنتظر الغيمة فوق رأسها","لترتمي بغيثها همولة",66,"ل",2,0],["تنتشي مِن كأسِ أنغا","مٍ لها وقْعٌ فريد",67,"د",1,0],["تنتج السهد لنا أشكاله","وقضايا صبه فيه تردِ",68,"د",1,0],["تنتخيها واتهندم..يا أفندم بس عشاني","اكتبيها واوزنيها..وان حصلّك لحنيها",69,"ي",3,0],["تنتابني ذكراك ما بين الوعي واللا وعي","ما كنّك الاّ بحر حلمي والمشاعر الأشرع