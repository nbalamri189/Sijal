رة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208099",""],[4978,"تشعير قطعة لأخناتون","https://www.poetsgate.com/ViewPoem.aspx?id=183244",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[333,"غانية","https://www.poetsgate.com/ViewPoem.aspx?id=101952",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5526,"ياليت","https://www.poetsgate.com/ViewPoem.aspx?id=202657",""],[5582,"شَرَعَ الحُبُّ لَهُ ما شَرَعا","https://www.poetsgate.com/ViewPoem.aspx?id=63529",""],[5594,"وشادن أذهلنى فقده","https://www.poetsgate.com/ViewPoem.aspx?id=201057",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5938,"عيد يمنٍ مؤكد بأمان","https://www.poetsgate.com/ViewPoem.aspx?id=181422",""],[5956,"كل شيء فيكِ يغري","https://www.poetsgate.com/ViewPoem.aspx?id=182627",""],[5956,"مناجاة الأخ الميت","https://www.poetsgate.com/ViewPoem.aspx?id=192372",""],[5956,"عطفك السابغ يجري في حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=194596",""],[5973,"الماس يصبح أغلي حين نفقده","https://www.poetsgate.com/ViewPoem.aspx?id=29237",""],[6093,"يا لشهد ليتني من رشفه","https://www.poetsgate.com/ViewPoem.aspx?id=203797",""],[6115,"نافق وجامل وكل الناس يطرونك","https://www.poetsgate.com/ViewPoem.aspx?id=180522",""],[6124,"طَلْعُ نيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109746",""],[463,"عمى صباحا بعدنا واسلمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60311&r=&rc=367",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""]],"verses":[["نافِراً مِنها فَليسَ يَرى","بِالأَماني آنِساً أَبَدا",0,"د",2,0],["نافِحاتٍ بِنَسيمٍ","سافِياتٍ بِذَنوبِ",1,"ب",1,0],["نافَسْتِ يا عَيْنَيّ درَّ دُموعِهِمْ","فعرَضْتِ دُرّاً للدّموعِ نَفِيسا",2,"س",2,0],["نافِسِ المُحسِنَ في إِحسانِهِ","فَسَيَكفيكَ سَناءً عَمَلُه",3,"ل",2,0],["نافذَ الحكم والقضاء على الإنسا","ن في خزنه وفي الأفراح",4,"ح",1,0],["نافثٌ سحر البلاغة في","عُقَدٍ جلّت عن النفث",5,"ث",1,0],["نافِقاً عند أناس","تَعِسوا والدهرُ أتعس",6,"س",1,0],["نافستَ في المُنفِساتِ مَنْ وسعتْ","إحدى مناديح صدرهِ بلدكْ",7,"ك",1,0],["نافِراتٍ كَأَنَّها ظَبَياتٌ","رَأَتِ القانِصينَ في البَيداءِ",8,"ا",2,0],["نافخاً نايَهُ حواليْهِ تهتزُّ","ورودُ الرَّبيعِ مِنْ كلِّ قنْسِ",9,"س",1,0],["نافَستُ فيهِ صورَةً في سِترِهِ","لَو كُنتُها لَخَفيتُ حَتّى يَظهَرا",10,"ر",2,0],["نافِراتٍ مِنَ المَشيبِ وَقَد كُن","نَ سُكوناً إِلى الشَبابِ المُقيمِ",11,"م",1,0],["نافِرُ الجَأشِ لا تَقِرُّ حَشاهُ","أَو يُؤَدّي ظُلامَةَ المَظلومِ",11,"م",1,0],["نافِس إِذا نافَستَ في حِكمَةٍ","آخِ إِذا آخَيتَ أَهلُ التُقى",12,"ا",1,0],["نافِس إِذا نافَستَ في حِكمَةٍ","وَلاتَدَع خَيراً وَلا تَتَّرِك",13,"ك",1,0],["نافاهُ في تَدويرِهِ وَصَفارِهِ","وَجُحوظِ مُقلَتِهِ وَفَرطِ سُهادِهِ",14,"د",2,0],["نافَسَ أَهلَ العُلى فَاِحتازَ عَقلَهُمُ","مِنهُم فَأَصبَحَ مُعطى الحَقِّ مَنفوسا",15,"س",2,0],["نافَت عَلى العَذَقِ الرَطيبِ بِريقِها","وَعَلى الهِلالِ المُستَبينِ الأَبلَجِ",16,"ج",1,0],["نافَسَتها العِراقُ وَالأَرضُ كَالنا","سِ فَبَعضٌ مِنها بِبَعضٍ يَغارُ",17,"ر",1,0],["نافَسَ الدّهُر عليه يَعْرُباً","فرأى موضعَ حِقْدٍ فَحَقَدْ",18,"د",1,0],["نافذٌ في الصميم من باطلِ القو","م كما ينفذُ السِّنانُ المذرّبْ",19,"ب",1,0],["نَافَسْتَ أَهْلَ الغَرْبِ فِي مِضْمَارِهِمْ","وَأَرَيْتَ مَا يَسْطِيعُ أَهْلُ المَشْرِقِ",20,"ق",1,0],["نَافَسْنَ فِتْيَان الحِمَى فَوَرَدْنَ مَا","يَرِدُونَ وَالعِرْفَانُ أَسْمَحُ مَوْرِدِ",21,"د",1,0],["نافَسَهُ إِذ شَآهُ حَتّى","عدا هَجينٌ عَلى هِجانِ",22,"ن",1,0],["نافَسْتَ بقصرِهمُ إِرَماً","فكأَنَّ أُمَيَّةَ لم تشِدِ",23,"د",1,0],["نافَسَ اللَيث وَقَد ميزَ كَما","ميزَ في دُهمِ المَذاكي ذو البَلَق",24,"ق",1,0],["نافذُ الطعنة، إن شاكَ به","أضْلُعَ الجبَّارِ، تقْصِفْ أضلعه",25,"ع",2,0],["نافر عني وقلبي سكنه","صفوة الود اذا قال غدر",26,"ر",1,0],["نافقت بيننا الحياة فهذا","حلّ كوخا وذاك طالت ربوعه",27,"ع",2,0],["نافقتُ إذ كان النفاق ضريبةً","متحرِّقاً من صَنعتى مترمِّضا",28,"ض",2,0],["نَافِرَاتٌ مِنَ المَشيبِ وَقَدْ كُنّ","سُكُوناً إلى الشّبَابِ المُقيمِ",29,"م",1,0],["نافذٌ في الحَشا لقد أحكمَ المَرمى","عَدُوِّي وخانَني الأقرانُ",30,"ن",1,0],["نافستَهُ فاستشاط من غضبٍ","وانتثلت من جعبةِ الحيلِ",31,"ل",1,0],["نافَيتَهُم بِمَساعٍ مَن أُعينَ بِها","فَكُلُّ مَرمىً بَعيدٍ رامَهُ كَثَبُ",32,"ب",1,0],["نافق في عراصها كل فحشٍ","هو منّي ومن نفاق نفوق",33,"ق",1,0],["نافِعٌ نَفعُهُ إِذا نيلَ مِنهُ","نائِلٌ فَهوَ رِفعَةٌ وَعلاءُ",34,"ا",2,0],["نافذُ الأمر إذ بحكمِ صلاح ال","دينِ أضحى قيامُهُ وقعودُه",35,"د",2,0],["نافذا الأمر لو اشار إلى الارضين","ضاقت بمن عليها البطاح",36,"ح",1,0],["نافَت مآثرُه العُلى","شَرَفاً على الفَلَكِ الأَثيري",37,"ر",2,0],["نافستَ طَيفي والمَهامهُ دُونَنا","في أنْ يزورَ العامريّةَ أيُّنا",38,"ن",2,0],["نافٍ غِرارَيْهِ من جَفْنَيهِ ذو حَدَبٍ","يُواصِلُ الضَرْبَ دون الدِّينِ والسّهَرا",39,"ر",2,0],["نافِعُ دَهرٍ ضائِرُ أَعدادُهُ","لِما عَرا يُطيلُ غَيظَ الحُسَّدِ",40,"د",1,0],["نافيةٍ للبعل والأولاد","بخلق زبعبق مفساد",41,"د",1,0],["نافسنا الدهر على جمعنا","وهو حسود قُلّبٌ حُوَّلُ",42,"ل",1,0],["نَافَقتُ دَهرِي فَوجهي ضَاحكٌ جَذِلٌ","طَلْقٌ وقَلبِي كَئِيبٌ مُكْمَدٌ باكي",43,"ي",1,1],["نافثات وهي الجداول للفضل","بقلب العدى سموم الأراقم",44,"م",1,0],["نافقت في عمل النفاق ولم تزل","في زي إخلاص وطبع منافق",45,"ق",1,0],["نافس الشمس في علاها","لم تهوي إلى البقاع",46,"ع",1,0],["نافقةً في موسِمٍ مُكسَدٍ","ناطقةً في زمنٍ مفحَمِ",47,"م",1,0],["نافرةِ الجانبين مبهمة ال","وجهِ على جامع ومنتظمِ",48,"م",1,0],["نافرةً من ذي اليمينين إذا","قوّدها حتى تُطيعَ الأبترا",49,"ر",2,0],["نافثتهنّ السحرَ يوم سويقةٍ","فإذا مَكايدهنّ فوق مَكايدي",50,"د",2,0],["نافَى بك الشيبُ بِطالاتِ الصِّبا","الليلُ هزلٌ والنهارُ جِدُّ",51,"د",1,0],["نافرٌ بالوقار عن موطِن الفُحْ","شِ كما تنفرُ النَّعامُ الرُّبْدُ",52,"د",1,0],["نافراتٌ مثل الجآذر تهوى","آنساتٌ مثلَ العرائس تجلَّى",53,"ل",2,0],["نافذٌ في كذابهِ لا المساعي","قاطعٌ في ذمامهِ لا الحسام",54,"م",1,0],["نافذٌ سهمُ رأيه الفذّ لا","