ان","https://www.aldiwan.net/poem3424.html","عموديه"],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[513,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[560,"قف بين ريحان العقيق وضاله","https://www.aldiwan.net/poem52961.html","الكامل"],[565,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[565,"ساجل بفصك من أردت وباهه","https://www.aldiwan.net/poem69735.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["مُتَأَوِّهاً تَحتَ الخُطوبِ","تَأَوُّهَ الجَمَلِ العَقيرِ",0,"ر",1,0],["مُتَأَنِّقاً وَذُرى الرِمالِ كَأَنَّها","دونَ النَواظِرِ عارِضٌ مُتَراكِبُ",1,"ب",1,0],["مَتاعٌ أَسلَفَتناهُ اللَيالي","وَأَعجَلَنا فَأَسرَعنا الأَداءَ",2,"ا",2,0],["مُتَأَوِّدٌ أَعْطَافُهُ فِي نَشْوَةٍ","مِمَّا يُعَلّ مِنَ الدِّمَاءِ وَيُنْهَلُ",3,"ل",1,0],["متأهّبينَ الى الحِسابِ ذَواهِلاً","مُتهيِّبينَ الموْقِفَ الموْعودا",4,"د",2,0],["مُتألِّقا مِنْ مَطْلَعِ الْحَقِّ الَّذِي","هُوَ نُورَ أَبْصَارٍ وَسِرُّ قُلوبِ",5,"ب",1,0],["مُتَآلِفِينَ وَذَاكَ شَرْ","طٌ لِلْحَيَاةِ المُسْتَقِلَّهْ",6,"ل",2,0],["مُتَأَلِّبِينَ عِصَابَةً خَيْرِيَّةً","فَخْرُ الْعَمِيدِ بِهَا كَفَخْرِ المُنْتَمِي",7,"م",2,0],["مَتاريكُ أَذنابِ الحُقوقِ إِذا اِلتَوَت","أَخَذنا الفُروعَ وَاِجتَثَثنا أُصولَها",8,"ل",3,0],["مُتَّ الفقيرَ إلى يديك بمنةٍ","إذ كان صنع الجودِ من لذَّاتها",9,"ت",3,0],["متأمّلٌ لا يجتوَى","منه القَبيل ولا الدبيرُ",10,"ر",1,0],["متاحٌ لراميها الرمايا كأنما","دعاها له داعي المنايا فأسمعا",11,"ع",2,0],["متُّ إلا حُشاشةً وادّكارا","مثل أحلامِ حالمِ النُّوَّام",12,"م",1,0],["متأَلِّفاً لهمُ تألُّفَ حُوَّلٍ","لو شاء سَيَّر بالقفارِ سفائنا",13,"ن",2,0],["مُتَأَلِّقاتٍ كَاِبتِساماتِ الرِضى","تُنسيكَ رُؤيَتُها الزَمانَ الأَعسَرا",14,"ر",2,0],["مُتَأَلِّبٌ كَاللَيلِ جَنَّ سَوادُهُ","مُستَوفِزٌ كَالقَدَرِ في الغَلَيانِ",15,"ن",1,0],["مُتَأَلِّماً فيكُم وَفي أَبنائِكُم","وَهُمُ وَأَنتُمُ نائِمو الأَحزانِ",16,"ن",1,0],["مُتَأَلِّبٌ يَبغي الحَياةَ كَأَنَّهُ","جَيشٌ عَلى أَعدائِهِ يَتَأَلَّبُ",17,"ب",1,0],["متأَجِّجَ الإِحْساسِ أحفلُ","بالعَظيمِ وبالحقيرْ",18,"ر",1,0],["متألِق خلل الغصون كأنه","في بلُجِةِ الأفنانِ ضوء صباح",19,"ح",1,0],["متآنسين يلاقيان الح","ب من كل الجهات",20,"ت",1,0],["مَتاعٌ مِنَ الدَهرِ اِستَبَدَّ بِجِدَّتي","وَأَعظَمُ جُرمِ الدَهرِ أَن يُمتَعَ الدَهرُ",21,"ر",1,0],["مَتاعٌ مِنَ الدُنيا حَظِيٌّ وَمَن يَفُت","حَظِيّاً مِنَ الدُنيا فَيَحزُنهُ يُعذَرِ",22,"ر",1,0],["مُتَأَلِّقٌ مُتَدَفِّقٌ مُتَرَفِّقٌ","لِلمُجتَلي وَالمُجتَدي وَالمُجتَني",23,"ي",1,0],["متألقاً في خاطري","متألقاً في المحفل",24,"ل",1,0],["متأصّلٌ في الملك ذو فخر له","حسَبٌ زكا في الأكرمين صراحُ",25,"ح",1,0],["مَتاعاً أَقومُ بِهِ لِلوَدا","عِ إِنّي أَرى الدارَ مِنها قَذوفا",26,"ف",2,0],["مُتَأَلِّقٌ صَدعَ الدُجى وَسَقى الثَرى","فَاِبيَضَّ ذا نوراً وَذا أَنوارا",27,"ر",2,0],["مُتَأَلِّقٌ أَعداهُ لابِسُ حِليَةٍ","فَسَما جَلالاً وَاِستَزادَ جَمالا",28,"ل",2,0],["مُتأهِّبٌ والنّازلاتُ كتائبٌ","مُتَبلِّجٌ والحادثات غياهبُ",29,"ب",1,0],["مُتَألِّقٌ مَنْ لم يَسِرْ في نُورِهِ","أَوْدَى الظَّلامُ بِهِ وطَاحَ الغَيْهَبُ",30,"ب",1,0],["مُتَأَلِقات بِالفَضاء","عَلى غياهبه تَعوم",31,"م",1,0],["مُتَأنّقَينِ وفي المَكارِمِ أرْتَعَا","مُتَألَقَينِ بسُؤدَدٍ وعَفافِ",32,"ف",1,0],["متاهاتٌ تضلُّ بها الليالي","ولا يدري بها فَلَكٌ نظامهْ",33,"م",2,0],["مُتَأَلِّقٌ بَيْنَ النُّجومِ","كأنَّهُ حُلْمٌ طَرُوبْ",34,"ب",1,0],["مُتَأَنِّقٌ فِي القَوْلِ لا مُتَصنِّعٌ","فِيهِ ولا يُلْقِيهِ عَفْوَ الخَاطِرِ",35,"ر",1,0],["مَتَانَةٌ فِي رُوَاءٍ","وَحُسْنُ ذَوْقٍ وَخِفَّهْ",36,"ف",2,0],["مُتَأَلِّبِينَ لِيَشْهَدُوا مَوْتَ الَّذِي","أَحْيَا البِلاَدَ عَدَالَةُ وَنَوَالاَ",37,"ل",2,0],["مت إذا شئت أن تكون أديبا","أو فبدّل بغَيرِ لبنان دارا",38,"ر",2,0],["متألّمٌ ممّا أنا متألّمُ","حار السؤالُ وأطرقَ المستفهِمُ",39,"م",1,1],["متأملين إلى الحساب ذواهلا","متهيبين الموقف الموعودا",40,"د",2,0],["مَتَاعٌ مِنَ الدّهْرِ استَجَدّ بجِدّتي،","وأعظَمُ جُرْمِ الدّهْرِ أن يَمتَعَ الدّهرُ",41,"ر",1,0],["متألب كاللّيل جنّ سواده","مستوفز كالقدر في الغيان",42,"ن",1,0],["متاعاً، اقومُ به للوداع، إني","عِ إنِّي أَرَى الدَّارَ مِنْها قَذوفا",43,"ف",2,0],["متأوّلين على الجفون تجنيِّا","فالدمع يُمطرُهم بذى ألوانِ",44,"ن",1,0],["مُتَأَلِّقُ البِشرِ المُبَشِّرِ بِالغِنى","وَالدَوحُ قَبلَ ثِمارِهِ نُوّارُهُ",45,"ر",2,0],["مَتالٍ لَو يُعايِنُها جَريرٌ","دَرى أَنَّ اِبنَ مَروانٍ ضَنينُ",46,"ن",1,0],["متأسّفا أن لو أصيب له غنى","لبذلته متكسّبا حمدا",47,"د",2,0],["متاعبي في حياتي","وكربتي هي أنتم",48,"م",1,0],["مُتَأَرِّجاتٍ بِالثَناءِ كَأَنَّما","حُمِّلنَ نَشرَ خَمائِلٍ وَرِياضِ",49,"ض",1,0],["مُتاحٌ مِن الأقْدارِ مَزَّقَ شَمْلها","بِكَسْحٍ مُغير أو إغارَة كاسِح",50,"ح",1,0],["مُتَأَوِّدٌ كَالرُمحِ فِعلُ قَوامِهِ","مُتَثَنِّياً أَضعاف فِعلِ سِنانِهِ",51,"ن",2,0],["مُتَأَوِّدٌ كَالخَيزُرانَةِ قَدُّهُ","حِقفُ النَقا مِن تَحتِهِ يَتَرَجرَجُ",52,"ج",1,0],["مت إن شئت غيظاً فليس إلى","قطعي سبيل قد تجلى لي",53,"ي",1,0],["مُتَأَلّقُ الصفحَينِ يُبدي دلّهُ","ليناً وَبَأسُ غِرارهِ مَحذورُ",54,"ر",1,0],["مُتَأَخِّرٌ عَنهُ وَلا مُتَقَدِّمُ","لا تَسأَلني نَفساً عَهِدَت عَزيزَةً",55,"ه",1,0],["مُتأمِّلاً مُتعجِّباً لرِحالكمْ","مَرفوعةً معَ رَحليَ المَوضوع",56,"ع",1,0],["مَتاعٌ قَليلٌ يُتعِبُ الحُرَّ كَسبُهُ","لَقَد هَوَّنَت حُرَّ المَتاعِ المَتاعِبُ",57,"ب",1,0],["متِ اختياراً تعُد بالموت ملتزماً","طوبى لملتزمٍ فالموت يُمهله",58,"ل",2,0],["متأنساً متجسداً","والنور نورٌ من ضيائك",59,"ك",1,0],["متألِّقاً بسعوده متألّفاً","بجنوده كالبدر في الليل الخفي",60,"ي",1,0],["متأمِّلاً ببصيرةٍ روحيةٍ","أحزانَ أمِّك إذ رأتك بذا السى",61,"س",2,0],["متأيداً متسلطاً ومظفّراً","بعدوه فهو الهزبر الأشدخ",62,"خ",1,0],["متاعه كالرُمَّه","يبلى بأذنى سبب",63,"ب",1,0],["متأسفاً بل لاهفاً بل ذارفاً","عني دموعَ الحزن مثلَ نِهاء",64,"ا",2,0],["متأملاً لدقيقه وجليله","ثم ارتضاه وزاده تبجيلا",65,"ل",2,0],["مُتَأَوِّد كَالغُصن بين رياضه","مُتلفِّت كالظَبي عند كِناسه",66,"س",2,0],["متأَلِّفُ الأَضْدادِ إِلّا أَنَّهُ","فِيهِ طباعُ زمانِهِ أَقسامُ",67,"م",1,0],["مَتاعٌ من الدنيا أرانِي فِراقُهُ","بعَيْنِ النُّهى والحِلْمِ أَنِّيَ حالِمُ",68,"م",1,0],["متآمرينَ على المواه","بِ عُوقبت مِثلَ الذنوب",69,"ب",1,0],["متأخراً بالفضل أُبخَسُ حَقَّه","وأُرَى مكانَ العاجز المتقدّمِ",70,"م",1,0],["متأيد حلماً فإن عرضت له","فرص السماح فما أغذ وأوجفا",71,"ف",2,0],["متأوّداً والغصنُ أحسنُ","ما يكون إذا تأوَّد",72,"د",1,0],["متأوّدٌ نشوانُ لدنٌ عطفهُ","أسفي على المتأوّّد النَّشوانِ",73,"ن",1,0],["متأوّد الأعطاف من سكر الصّبا","متلوّن الأخلاق من تيه الصَّلفْ",74,"ف",1,0],["متأود منع الحيا أعطافه","أن لا تميل على النقا وتميدا",75,"د",2,0],["مُتأطّراً أَشَراً كزعزعةِ الصّبا","أفنانَ فرعِ الأيكةِ الميّادِ",76,"د",1,0],["مُتَأخِّرٌ في عصرِهِ مُتَقدِّمٌ","في فضلهِ مُتَفرِّدٌ في حالِهِ",77,"ل",2,0],["مَتَاعُ حَسْنٍ لَمُسْتَشِفٍّ","واللَّحْظُ مَا بَعْدَهُ مَتَاعُ",78,"ع",1,0],["متألقٌ فيه الفِرْنَدُ كأنّه","وَجْهَيْ غداةِ قِرىً وَضَيْفٍ قاصدِ",79,"د",1,0],["متابع يكثر أو يقل","عليه والباطل يضمحل",80,"ل",1,0]]}