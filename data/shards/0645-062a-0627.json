0",""],[463,"ذكرتُ وما وفايَ بحيثُ أنسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60101&r=&rc=157",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[6333,"جرح وقصيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7035&r=&rc=6",""],[6346,"جَمْرُ الوَدَاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84888&r=&rc=13",""],[572,"سَاجِلْ بفصلِكَ من أَردْتَ وباهِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9225&r=&rc=82",""]],"verses":[["مُتَأَوِّهاً تَحتَ الخُطوبِ","تَأَوُّهَ الجَمَلِ العَقيرِ",0,"ر",1,0],["مُتَأَنِّقاً وَذُرى الرِمالِ كَأَنَّها","دونَ النَواظِرِ عارِضٌ مُتَراكِبُ",1,"ب",1,0],["مَتاعٌ أَسلَفَتناهُ اللَيالي","وَأَعجَلَنا فَأَسرَعنا الأَداءَ",2,"ا",2,0],["مُتَأَوِّدٌ أَعْطَافُهُ فِي نَشْوَةٍ","مِمَّا يُعَلّ مِنَ الدِّمَاءِ وَيُنْهَلُ",3,"ل",1,0],["متأهّبينَ الى الحِسابِ ذَواهِلاً","مُتهيِّبينَ الموْقِفَ الموْعودا",4,"د",2,0],["مُتألِّقا مِنْ مَطْلَعِ الْحَقِّ الَّذِي","هُوَ نُورَ أَبْصَارٍ وَسِرُّ قُلوبِ",5,"ب",1,0],["مُتَآلِفِينَ وَذَاكَ شَرْ","طٌ لِلْحَيَاةِ المُسْتَقِلَّهْ",6,"ل",2,0],["مُتَأَلِّبِينَ عِصَابَةً خَيْرِيَّةً","فَخْرُ الْعَمِيدِ بِهَا كَفَخْرِ المُنْتَمِي",7,"م",2,0],["مَتاريكُ أَذنابِ الحُقوقِ إِذا اِلتَوَت","أَخَذنا الفُروعَ وَاِجتَثَثنا أُصولَها",8,"ل",3,0],["مُتَّ الفقيرَ إلى يديك بمنةٍ","إذ كان صنع الجودِ من لذَّاتها",9,"ت",3,0],["متأمّلٌ لا يجتوَى","منه القَبيل ولا الدبيرُ",10,"ر",1,0],["متاحٌ لراميها الرمايا كأنما","دعاها له داعي المنايا فأسمعا",11,"ع",2,0],["متُّ إلا حُشاشةً وادّكارا","مثل أحلامِ حالمِ النُّوَّام",12,"م",1,0],["متأَلِّفاً لهمُ تألُّفَ حُوَّلٍ","لو شاء سَيَّر بالقفارِ سفائنا",13,"ن",2,0],["مُتَأَلِّقاتٍ كَاِبتِساماتِ الرِضى","تُنسيكَ رُؤيَتُها الزَمانَ الأَعسَرا",14,"ر",2,0],["مُتَأَلِّبٌ كَاللَيلِ جَنَّ سَوادُهُ","مُستَوفِزٌ كَالقَدَرِ في الغَلَيانِ",15,"ن",1,0],["مُتَأَلِّماً فيكُم وَفي أَبنائِكُم","وَهُمُ وَأَنتُمُ نائِمو الأَحزانِ",16,"ن",1,0],["مُتَأَلِّبٌ يَبغي الحَياةَ كَأَنَّهُ","جَيشٌ عَلى أَعدائِهِ يَتَأَلَّبُ",17,"ب",1,0],["متأَجِّجَ الإِحْساسِ أحفلُ","بالعَظيمِ وبالحقيرْ",18,"ر",1,0],["متألِق خلل الغصون كأنه","في بلُجِةِ الأفنانِ ضوء صباح",19,"ح",1,0],["متآنسين يلاقيان الح","ب من كل الجهات",20,"ت",1,0],["مَتاعٌ مِنَ الدَهرِ اِستَبَدَّ بِجِدَّتي","وَأَعظَمُ جُرمِ الدَهرِ أَن يُمتَعَ الدَهرُ",21,"ر",1,0],["مَتاعٌ مِنَ الدُنيا حَظِيٌّ وَمَن يَفُت","حَظِيّاً مِنَ الدُنيا فَيَحزُنهُ يُعذَرِ",22,"ر",1,0],["مُتَأَلِّقٌ مُتَدَفِّقٌ مُتَرَفِّقٌ","لِلمُجتَلي وَالمُجتَدي وَالمُجتَني",23,"ن",2,0],["متألقاً في خاطري","متألقاً في المحفل",24,"ل",1,0],["متأصّلٌ في الملك ذو فخر له","حسَبٌ زكا في الأكرمين صراحُ",25,"ح",1,0],["مَتاعاً أَقومُ بِهِ لِلوَدا","عِ إِنّي أَرى الدارَ مِنها قَذوفا",26,"ف",2,0],["مُتَأَلِّقٌ صَدعَ الدُجى وَسَقى الثَرى","فَاِبيَضَّ ذا نوراً وَذا أَنوارا",27,"ر",2,0],["مُتَأَلِّقٌ أَعداهُ لابِسُ حِليَةٍ","فَسَما جَلالاً وَاِستَزادَ جَمالا",28,"ل",2,0],["مُتأهِّبٌ والنّازلاتُ كتائبٌ","مُتَبلِّجٌ والحادثات غياهبُ",29,"ب",1,0],["مُتَألِّقٌ مَنْ لم يَسِرْ في نُورِهِ","أَوْدَى الظَّلامُ بِهِ وطَاحَ الغَيْهَبُ",30,"ب",1,0],["مُتَأَلِقات بِالفَضاء","عَلى غياهبه تَعوم",31,"م",1,0],["مُتَأنّقَينِ وفي المَكارِمِ أرْتَعَا","مُتَألَقَينِ بسُؤدَدٍ وعَفافِ",32,"ف",1,0],["متاهاتٌ تضلُّ بها الليالي","ولا يدري بها فَلَكٌ نظامهْ",33,"م",2,0],["مُتَأَلِّقٌ بَيْنَ النُّجومِ","كأنَّهُ حُلْمٌ طَرُوبْ",34,"ب",1,0],["مُتَأَنِّقٌ فِي القَوْلِ لا مُتَصنِّعٌ","فِيهِ ولا يُلْقِيهِ عَفْوَ الخَاطِرِ",35,"ر",1,0],["مَتَانَةٌ فِي رُوَاءٍ","وَحُسْنُ ذَوْقٍ وَخِفَّهْ",36,"ف",2,0],["مُتَأَلِّبِينَ لِيَشْهَدُوا مَوْتَ الَّذِي","أَحْيَا البِلاَدَ عَدَالَةُ وَنَوَالاَ",37,"ل",2,0],["مت إذا شئت أن تكون أديبا","أو فبدّل بغَيرِ لبنان دارا",38,"ر",2,0],["متألّمٌ ممّا أنا متألّمُ","حار السؤالُ وأطرقَ المستفهِمُ",39,"م",1,1],["متاعي رجع الطرف منها وكل ما","يسرك من عيش الزمان قصير",40,"ر",1,0],["متأملين إلى الحساب ذواهلا","متهيبين الموقف الموعودا",41,"د",2,0],["مَتَاعٌ مِنَ الدّهْرِ استَجَدّ بجِدّتي،","وأعظَمُ جُرْمِ الدّهْرِ أن يَمتَعَ الدّهرُ",42,"ر",1,0],["متألب كاللّيل جنّ سواده","مستوفز كالقدر في الغيان",43,"ن",1,0],["متاعاً، اقومُ به للوداع، إني","عِ إنِّي أَرَى الدَّارَ مِنْها قَذوفا",44,"ف",2,0],["متأوّلين على الجفون تجنيِّا","فالدمع يُمطرُهم بذى ألوانِ",45,"ن",1,0],["مُتَأَلِّقُ البِشرِ المُبَشِّرِ بِالغِنى","وَالدَوحُ قَبلَ ثِمارِهِ نُوّارُهُ",46,"ر",2,0],["مَتالٍ لَو يُعايِنُها جَريرٌ","دَرى أَنَّ اِبنَ مَروانٍ ضَنينُ",47,"ن",1,0],["متأسّفا أن لو أصيب له غنى","لبذلته متكسّبا حمدا",48,"د",2,0],["متاعبي في حياتي","وكربتي هي أنتم",49,"م",1,0],["مُتَأَرِّجاتٍ بِالثَناءِ كَأَنَّما","حُمِّلنَ نَشرَ خَمائِلٍ وَرِياضِ",50,"ض",1,0],["مُتاحٌ مِن الأقْدارِ مَزَّقَ شَمْلها","بِكَسْحٍ مُغير أو إغارَة كاسِح",51,"ح",1,0],["مُتَأَوِّدٌ كَالرُمحِ فِعلُ قَوامِهِ","مُتَثَنِّياً أَضعاف فِعلِ سِنانِهِ",52,"ن",2,0],["مُتَأَوِّدٌ كَالخَيزُرانَةِ قَدُّهُ","حِقفُ النَقا مِن تَحتِهِ يَتَرَجرَجُ",53,"ج",1,0],["مت إن شئت غيظاً فليس إلى","قطعي سبيل قد تجلى لي",54,"ل",2,0],["مُتَأَلّقُ الصفحَينِ يُبدي دلّهُ","ليناً وَبَأسُ غِرارهِ مَحذورُ",55,"ر",1,0],["مُتَأَخِّرٌ عَنهُ وَلا مُتَقَدِّمُ","لا تَسأَلني نَفساً عَهِدَت عَزيزَةً",56,"ه",1,0],["مُتأمِّلاً مُتعجِّباً لرِحالكمْ","مَرفوعةً معَ رَحليَ المَوضوع",57,"ع",1,0],["مَتاعٌ قَليلٌ يُتعِبُ الحُرَّ كَسبُهُ","لَقَد هَوَّنَت حُرَّ المَتاعِ المَتاعِبُ",58,"ب",1,0],["متِ اختياراً تعُد بالموت ملتزماً","طوبى لملتزمٍ فالموت يُمهله",59,"ل",2,0],["متأنساً متجسداً","والنور نورٌ من ضيائك",60,"ك",1,0],["متألِّقاً بسعوده متألّفاً","بجنوده كالبدر في الليل الخفي",61,"ف",2,0],["متأمِّلاً ببصيرةٍ روحيةٍ","أحزانَ أمِّك إذ رأتك بذا السى",62,"س",2,0],["متأيداً متسلطاً ومظفّراً","بعدوه فهو الهزبر الأشدخ",63,"خ",1,0],["متاعه كالرُمَّه","يبلى بأذنى سبب",64,"ب",1,0],["متأسفاً بل لاهفاً بل ذارفاً","عني دموعَ الحزن مثلَ نِهاء",65,"ا",2,0],["متأملاً لدقيقه وجليله","ثم ارتضاه وزاده تبجيلا",66,"ل",2,0],["مُتَأَوِّد كَالغُصن بين رياضه","مُتلفِّت كالظَبي عند كِناسه",67,"س",2,0],["متأَلِّفُ الأَضْدادِ إِلّا أَنَّهُ","فِيهِ طباعُ زمانِهِ أَقسامُ",68,"م",1,0],["مَتاعٌ من الدنيا أرانِي فِراقُهُ","بعَيْنِ النُّهى والحِلْمِ أَنِّيَ حالِمُ",69,"م",1,0],["متآمرينَ على المواه","بِ عُوقبت مِثلَ الذنوب"