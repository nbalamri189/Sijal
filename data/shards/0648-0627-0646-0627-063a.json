{"poems":[[79,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[24,"يقول حياي من عوف ومن جشم","https://www.aldiwan.net/poem21881.html","البسيط"],[24,"أترجو اعتذاري يابن أروى ورجعتي","https://www.aldiwan.net/poem21903.html","الطويل"],[53,"فدتك النفس وهي أقل بذل","https://www.aldiwan.net/poem65875.html","الوافر"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[63,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[99,"لا البرء زار ولا خيالك عادا","https://www.aldiwan.net/poem24991.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[99,"آمال كاذبة","https://www.poetsgate.com/ViewPoem.aspx?id=151584",""],[147,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[154,"صرحت بالحب إذ لم يجد تلميح","https://www.aldiwan.net/poem68455.html","البسيط"],[154,"يا نائم الطرف عن سهدي وعن أرقي","https://www.aldiwan.net/poem68546.html","البسيط"],[215,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[234,"لا تقتل الأحزان إلا بما","https://www.aldiwan.net/poem50755.html","السريع"],[280,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[382,"لو تفرز الخير من شر ومن شعث","https://www.aldiwan.net/poem59114.html","البسيط"],[422,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64659","الوافر"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105210","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128707","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141267","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27954","الرمل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216584",""],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/140124",""],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138634",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59507","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2525","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76502","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4927,"نار الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=29650",""],[5032,"أرجوحة الحُلم","https://www.poetsgate.com/ViewPoem.aspx?id=188909",""],[5690,"أجبرت بك الدنيا فأنت مجيرها","https://www.poetsgate.com/ViewPoem.aspx?id=172135",""],[5837,"عرفة وجه","https://www.poetsgate.com/ViewPoem.aspx?id=181852",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[5956,"الشرع حلّل لي زواجك يا مَدامْ","https://www.poetsgate.com/ViewPoem.aspx?id=182631",""],[6047,"وإن اغتراب المرء من غير فاقة","https://www.poetsgate.com/ViewPoem.aspx?id=182573",""],[6093,"إذا جاوزت أرضا كنت فيها","https://www.poetsgate.com/ViewPoem.aspx?id=205605",""],[6093,"الكُلُّ يخطيءُ تارةً ويُصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205649",""],[6102,"الأَماسِيُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182862",""],[3874,"تقول إبنة العمري مالك بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=6445",""],[6247,"جمال القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80287&r=&rc=26",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِنْ أَغْفَلَتْ مِنْ فَرْضِ بِرِّكَ وَاجباً","عَلَى أَنَّهَا قَدْ أَوْطَأَتْكَ ذرَى الشُّهْبِ",0,"ب",1,0],["وَإِن أَغارَ وَلَم يَحلَ بِطائِلَةٍ","في ظُلمَةٍ اِبنِ جَميرٍ ساوَرَ الفُطُما",1,"م",2,0],["وَإِنَّ اِغتِرابي في البِلادِ وَجَفوَتي","وَشَتمِيَ في ذاتِ الإِلَهِ قَليلُ",2,"ل",1,0],["وإن أغفلتُ حثَّكِ نمتِ عنّي","ولستُ لذاكَ يا أملي بأهل",3,"ل",1,0],["وَإِنَّ اِغتِرابَ المَرءِ في غَيرِ بُغيَةٍ","يُطالِبُها مِن حَيفِ دَهرٍ يُطالِبُه",4,"ب",2,0],["وَإنْ أَغْشَ حَانَةَ أُترُجَّةٍ","أَمُت ثالثَ الدَّنَّ والباطيه",5,"ي",2,0],["وأنا غريب في الزحام كأنني","آمال أجفان حرمن رقادا",6,"د",2,0],["وأن أغير سير الشعب بالقلمِ","حتى إذا نالَت الأيام من هممي",7,"ي",1,0],["وَإِنّا غَيرُ أُثّامٍ لِنَحوي","مَنيعَ الدارِ وَالمالِ المُراحِ",8,"ح",1,0],["وَإِنّا غَيرُ بُخّالٍ لِنَحمي","جِمامَ الماءِ وَالمَرعى المُباحِ",8,"ح",1,0],["وَإِنْ أَغَارَ تَنادَى كُلُّ ذِي هَلَعٍ","إِلَى الْفِرَارِ وَأَوْدَى كُلُّ مِغوَار",9,"ر",1,0],["وأنا غريب في الرخام كأنني","آمال اجفان حرمن رقادا",10,"د",2,0],["وَإِن أَغنى نَداكَ فَقَد تَغَنّى","بِما حَبَّرتُ فيكَ الخافِقانِ",11,"ن",1,0],["وإن أغرب شيء أنت سامعه","جسم ينعم في تعذيبه الروح",12,"ح",1,0],["وإنَّ أغربَ شَيءٍ أنتَ سامِعُهُ","دَمعٌ يُكفكِفُهُ أجفانُ مُحتَرِقِ",13,"ق",1,0],["وأناغى روحك الثاوى هناك","فكأني حين أرآه أراك",14,"ك",1,0],["وإن أَغِبْ عنكْم فإني كمن","يراكُمُ في القربِ رأىَ العِيان",15,"ن",1,0],["وإنَّ اغْتِرابَ المَرْءِ صُغْرٌ نَبا بِه","فَعَاسِر عَليها خُطّةً أو فَسامِح",16,"ح",1,0],["وإن أغظت أخاً يوماً فسِرْ عجلاً","للصلح قبل أفول الشمس ذا يجب",17,"ب",1,0],["وإنْ أغْلَقَتْ بابها المكرمات","فإنَّك تَفْتَحُ أقفالها",18,"ل",3,0],["وإن أَغِبْ عنكُمُ فالشعر يَذْكُرُني","وحسبُكم بالقوافي ربّ إذكارِ",19,"ر",1,0],["وإنّا غرس جدِّك في بقاع","بها لك أنْعُمٌ عددُ النبات",20,"ت",1,0],["وأناغي حمامها بحنين","ألبس الجسم رقة واصفرارا",21,"ر",2,0],["وإِنْ أَغْفَيْتُ كانَ عَلَيْكَ وَقْفي","أَو اسْتَيْقَظْتُ كانَ بِكَ ابْتِدائي",22,"ي",1,0],["وان أغب أو ذكرت فضيلتي","أنكرها وفي هجاي أطنبا",23,"ب",2,0],["وإن أغرقت في بحر الخطايا","بكم أرجو نجاتي في المعاد",24,"د",1,0],["وإن أغمضت عيناي في الغرب فادفنوا","رفاتي في لبنان في تربه الرّطب",25,"ب",1,0],["وإنا غلبنا غالب فانتصر لنا","أيا غالب الغلاب يا خير من نصر",26,"ر",1,0],["وأنا غير فقيد","ناظرا حال حياتي",27,"ت",2,0],["وانَا غرير ومحسن الظن","واتْحَسّبَه مَجْراي مضبوط",28,"ط",1,0],["وإن أغضى المعالج عن سقيم","فقد أخطأ به نهج السداد",29,"د",1,0],["وإن أغار على باغ ليأخذ مع","أمواله ماله فالبغي قد حصلا",30,"ل",2,0],["وان أغرته بما قد ناله","منها فهل يأمن أن ينتزعا",31,"ع",2,0],["وأنا غضنفرة الملوك وصقرها","وقريعها وخِضمُّها وغَمامُها",32,"م",3,0],["وإن أغفلوا سفيانهم عن معلمٍ","فما قبلهُ أو بعد لاحَ يعلمُ",33,"م",1,0],["وَإِن أَغزُ حَيِّي خَثعَمٍ فَدِمائُهُم","شِفاءٌ وَخَيرُ الثَأرِ لِلمُتَأَوِّبِ",34,"ب",1,0],["وان اغضَبوها افاضوا علي","ها التَبجج بالنية الخالِصة",35,"ص",2,0],["وإِن أغنى الناسِ عِندي عاقِل","أبدى اقتناعاً بالقليلِ واكتَفى",36,"ا",1,0],["وَأَنَاْ غَرِيْقٌ فِيْ خِضَمِّ غَرَاْمِهِ","لَكِنَّ حَوْلِيْ جَوْهَرَ الْمِرْسَاْلِ",37,"ل",1,0],["وأنَّ أُغْنِيَةَ التّسْعِين تَخْرُجُ مِنْ","فَمِ الصَّباحِ وفي احْشائها وَجَعُ",38,"ع",1,0],["وأن أغلقوا من بأسها باب بلدة","تبشر بالفتح القريب ثغورها",39,"ر",3,0],["وانا غرست الطيب بالطيّب مثل غرس الودي","ودونه هماج المورد مْن سنين يدّي تدحضه",40,"ض",2,0],["وإن اغتباط الصب عنك وإن لي","فؤادي بما ألقى إليك تهيم",41,"م",1,0],["وأنا غريب لي حقوق دونه","والشرع حلّل لي زواجك يا مَدامْ",42,"م",1,0],["وإن اغتراب المرء من غير فاقة","ولاحاجة يسمو لها لعجيب",43,"ب",1,1],["وإنْ أغضبتُ مَنْ أغضبتُ منهمْ","كريماً رحتُ أغضبُ أو حقيرَا",44,"ر",2,0],["وأنا غَريبٌ حِينَ أطْلبُ صاحباً","فالناسُ حَوليْ والمُرادُ غريبُ",45,"ب",1,0],["وَأَناغِيمُ حالِماتٌ وَسنَى","عَزَفَتها مَواجِعٌ وَ طُلُولُ",46,"ل",1,0],["وإنْ أغْزُ حَيّيْ خَثْعَمٍ فَدِماؤهمْ","شِفاءٌ وخَيرُ الثّأرِ للمُتَأوِّبِ",47,"ب",1,0],["وأنا غريبٌ في الدروب، وإخوتي","كلٌّ سرى في دربه، كلٌ غريبْ",48,"ب",1,0],["وأنا غبارُ \"القدسِ\" يَسْكنُ مهجتي","والمسجدُ الأقصى أنا أو \"يثربُ\"",49,"ب",1,0]]}