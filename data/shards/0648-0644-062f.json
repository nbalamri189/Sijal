ل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[458,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[458,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[458,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[458,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[461,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[461,"ملك الشكر نوال","https://www.aldiwan.net/poem16095.html","مجزوء الرمل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[479,"لا تفكر في طارف وتليد","https://www.aldiwan.net/poem36868.html","الخفيف"],[479,"ولد الى الخضراء مث","https://www.aldiwan.net/poem36983.html","الكامل"],[479,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[479,"الله أكبر أيها ال","https://www.aldiwan.net/poem37198.html","مجزوء الكامل"],[482,"أبدت شموس أم بدت أقمار","https://www.aldiwan.net/poem24371.html","عموديه"],[491,"أيا أحمد ابن مليك الزمان","https://www.aldiwan.net/poem26668.html","المتقارب"],[495,"ولدت من خير حرة ولدت","https://www.aldiwan.net/poem9872.html","المنسرح"],[500,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[500,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[514,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[514,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[524,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[529,"ولد المرء لا يبالي إذا ما","https://www.aldiwan.net/poem37511.html","الخفيف"],[538,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[553,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"ليس الوجود كما يقال اثنان","https://www.aldiwan.net/poem33757.html","الكامل"],[558,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[558,"نحن أهل العلوم بالإلهام","https://www.aldiwan.net/poem33878.html","الخفيف"],[558,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[558,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[567,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[567,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[567,"غيم مدامعه تفيض","https://www.aldiwan.net/poem69623.html","مجزوء الكامل"],[567,"إن مظلومة التي","https://www.aldiwan.net/poem69667.html","مجزوء الرمل"],[585,"خان المحالف والمعاهد","https://www.aldiwan.net/poem1569.html",""],[586,"يوم تكاثف غيمه فكأنه","https://www.aldiwan.net/poem17990.html","الكامل"]],"verses":[["وَلَدَيكَ إِن طَمَحَ العَدوُّ صَوارِمٌ","تُدمى عَرانينَ العِدا وَتُذَلِّلُ",0,"ل",1,0],["وَلَدَيَّ مَرْقومُ القَميصِ قَدِ احْتَمتْ","مِنْهُ بِأَكْثِبَةِ الحِمى فَأَبَاحَها",1,"ح",3,0],["ولدتك آفاق المعالي والعل","شعلا كما تلد السماء الأنجما",2,"م",2,0],["وَلَّدْتَ أَشْكَالَ الْجَمَالِ بِوَجْنَةٍ","أَلَفْتَ فِيهَا حُمْرَةً بِبَيَاضِ",3,"ض",1,0],["وَلَدِي فِي ذَرَاكَ وَكْرِيَ فِي دَوْ","حِكَ لَحْدِي وَتُرْبَتِي فِي تُرْبِكْ",4,"ك",1,0],["وَلَدنٌ مِنَ الخَطِيِّ فيهِ أَسِنَّةٌ","ذَخائِرُ مِمّا سَنَّ أَبزى وَشَرعَبُ",5,"ب",1,0],["وَلَدي قَد طالَ سُهدي وَنَحيبي","جِئتُ أَدعوكَ فَهَل أَنتَ مُجيبي",6,"ب",2,1],["وَلَدتُ وَلَمّا لَم أَجِد لِعَرائِسي","رِجالاً وَأَكفاءً وَأَدتُ بَناتي",7,"ي",1,0],["وَلَدافَعَت عَنكَ المنونَ فَوارِسٌ","بيضُ الوُجوهِ كَريمَةُ الأَجدادِ",8,"د",1,0],["وَلَدَيكِ أَمثالَ النُجومِ قَلائِدٌ","أَلِفَت سَماءَكِ لَبَّةً وَتَريبا",9,"ب",2,0],["ولِدَا البَنِينَ الصَّالِحِنَ","لَتَستَدِيمَا خَيْرَ آلِ",10,"ل",1,0],["وَلَدُ الفقر والرِّباط ولكنْ","نفسُهُ للسلوك ذات افتقار",11,"ر",1,1],["ولدت لزنية ونشأت نغلاً","ربيباً في حجور ذوات عهر",12,"ر",1,0],["ولديّ إن وصل الحبيب تمسّك","بالعزّ يمنع فايَ من تقبيله",13,"ل",2,0],["وَلَدَ الأُخَيطِلَ نِسوَةٌ مِن تَغلِبٍ","هُنَّ الخَبائِثُ بِالخَبيثِ غُذينا",14,"ن",2,0],["وَلَدَ الحَواصِنُ في قُرَيشٍ مِنهُمُ","يا رُبَّ مَكرُمَةٍ وَلَدنَ وَخيرِ",15,"ر",1,0],["وَلَدَت قُفَيرَةُ أُمُّ صَعصَعَةَ اِبنَها","فَوقَ المُزَنَّمِ بَينَ وَطبَي جازِرِ",16,"ر",1,0],["وَلَدَ الفَرَزدَقَ وَالصَعاصِعَ كُلَّهُم","عِلَجٌ كَأَنَّ وُجوهَهُنَّ مَقالي",17,"ي",1,0],["وَلَدَت بَنو حُرثانَ فَرخَ مُحَرِّقٍ","بِلِوى الوَضيعَةِ مُرتَجَ الأَبوابِ",18,"ب",1,1],["وَلَدى النُعمانِ مِنّي مَوطِنٌ","بَينَ فاثورِ أُفاقٍ فَالدَحَل",19,"ل",1,0],["وَلَدنا بَني العَنقاءِ وَاِبني مُحَرَّقٍ","فَأَكرِم بِنا خالاً وَأَكرِم بِذا اِبنَما",20,"م",2,0],["ولدولةِ الملكِ المؤيدِ إنَّها","جمعت فنونَ المدحِ بعدَ شتاتها",21,"ت",3,0],["وَلَدَت أُمّي أَباها","إِنَّ ذا من عَجَباتي",22,"ت",2,0],["ولديهم وذَائلُ الفِضَضِ البي","ضُ تباهي سبائكَ الأَذهابِ",23,"ب",1,0],["ولديك الدهاءُ في محتواه","بل لديك الصَّفيحُ في أغمادِهْ",24,"د",2,0],["ولَّدَتْهُ فِطْنَةٌ إنسيَّةٌ","تدَّعيها الجنُّ غرّاءٌ وَلُودُ",25,"د",1,0],["وَلَّدَ الغيْثَ بعد قَحْطٍ ندى كف","فيْكَ لا يَعْدَمِ الحيا توليدَكْ",26,"ك",1,0],["ولدى قحبةٍ كَسَتْك قُروناً","لك من حَملها قفا ملموز",27,"ز",1,0],["ولدي منكَ متى أثرتَ كوامني","ما لا يقصِّصُه سواي مقصِّصُ",28,"ص",1,0],["ولدٌ أقرَّ لعين والده","طالت لوالده به المتعه",29,"ع",2,0],["ولَدفعُ الفحل أشهى إليه","من دفاع الله إذ لا دفاع",30,"ع",1,0],["ولديها تبتُّلٌ فإذا ما","غاب في الخاقِ باقِ زال التبَتُّلْ",31,"ل",1,0],["ولدتْهُما من غيرِ شي","خِك ذي الفضائل والفواضلْ",32,"ل",1,0],["ولديه لهُنَّ إنْ فَرَّ أو كَرْ","رَ عتاد المفَرِّ والمقدام",33,"م",1,0],["ولدينا سَكنجبينٌ وحيدٌ","أنت عندي بالأجرِ فيه قمين",34,"ن",1,0],["ولديك للمكروب أوسعُ همّةٍ","عَطْفاً وأنورُ غُرَّةٍ وجبين",35,"ن",1,0],["وَلِدتُم بَعدَ إِخوَتِكُم مِنِ اِستٍ","فَهَلّا جِئتُمُ مِن حَيثُ جاؤوا",36,"ا",3,0],["وَلَدٌ يَتهادى في العَشرِ","وَفَتىً في بُردِ العِشرينا",37,"ن",2,0],["وَلِديمَةٍ تَذري عَلَيهِ دُموعَها","كَما تَقيهِ غَوائِلَ المَحلِ",38,"ل",1,0],["وَلَدَينا ذَلِكَ الضَي","فُ الَّذي عِندَكَ عِلمُه",39,"م",2,0],["ولدت لها استقلالها فهو باسم","إليك ابتسام الطفل في وجه والد",40,"د",1,0],["ولدتها الارض الكريمة بكراً","وسقتها السماء در العهاد",41,"د",1,0],["ولدىَّ مصر لها كما لكما هوىً","والحب كل صبابة بمذاق",42,"ق",1,0],["وَلَدَ الثَورَةَ سَعدٌ حُرَّةً","بِحَياتَي ماجِدٍ حُرٍّ نَماها",43,"ا",3,0],["وُلِدَ الهُدى فَالكائِناتُ ضِياءُ","وَفَمُ الزَمانِ تَبَسُّمٌ وَثَناءُ",44,"ا",2,1],["وُلِدوا عَلى راحِ العُلا وَتَرَعرَعوا","في نِعمَةِ الأَملاكِ وَالأُمَراءِ",45,"ا",2,0],["وُلِدَت فَكُنتَ المَهدَ ثُمَّ تَرَعرَعَت","فَأَظَلَّها مِنكَ الحَفِيُّ المُشفِقُ",46,"ق",1,0],["وَلِدتِ لَهُ المَآمينَ الدَواهي","وَلَم تَلِدي لَهُ قَطُّ الأَمينا",47,"ن",2,0],["وُلِدَت قَضِيَّتُها عَلى مِحرابِهِ","وَحَبَت بِهِ طِفلاً وَشَبَّت مُعصِرا",48,"ر",2,0],["وَلَدَ البَدائِعَ وَالرَوائِعَ كُلَّها","وَعَدَتهُ أَن يَلِدَ البَيانَ عُوادي",49,"د",2,0],["وُلِدَ الرِفقُ يَومَ مَولِدِ عيسى","وَالمُروءاتُ وَالهُدى وَالحَياءُ",50,"ا",2,0],["وَلَدَيهِ مِلعِقيانِ وَالأَدَبِ المُفا","دِ وَمِلحَياةِ وَمِلمَماتِ مَناهِلُ",51,"ل",1,0],["وُلِدنَ تَحتَ أَثقَلِ الأَحمالِ","قَد مَنَعَتهُنَّ مِنَ التَفالي",52,"ل",2,0],["وَلَدى بَني يَزدادَ حَيثُ لَقيتُهُم","كَرَمٌ كَغادِيَةِ السَحابِ الصَيِّبِ",53,"ب",1,0],["وَلَدَيهِ تَحتَ السَكينَةِ وَالإِخ","باتِ سَطوٌ عَلى العِدى وَاِقتِدارُ",54,"ر",1,0],["وَلَدَتهُ الشُموسُ مِن وَلَدِ العَبّا","سِ عَمِّ النَبِيِّ وَالأَقمارُ",54,"ر",1,0],["وَلَدَيكَ صافِيَةٌ كَأَنَّ نَسيمَها","مِن طيبِ عَرفِكَ أَو جَميلِ نَثاكا",55,"ك",2,0],["وَلَدَينا بِضاعَةٌ مُزجاةٌ","قَلَّ خُطّابُها فَبارَت لَدَينا",56,"ن",2,0],["وَلَدَتكَ أُمُّكَ في كِناسَةَ دارِهِم","حَتّى اِستُثِرتَ مِنَ التُرابِ اللابِدِ",57,"د",1,0],["وَلَدَت لِأَزهَرَ كُلَّ أَصيَدَ يَبتَني","بِالسَيفِ يَومَ تَعانُقٍ وَكِرارِ",58,"ر",1,0],["ولَدٌ عَلَتْ بَركاتُ مَولِدِه","سَعْداً وطهَّرَه مُطَهِّرُه",59,"ر",2,0],["وَلَدَيَّ سِرُّكَ لا يُذا","عُ وَلا يُزالُ وَلا يُذامُ",60,"م",1,0],["وَلَدَينا شادٍ وَنَقلٌ وَمَشمو","مُ وَطَيرٌ يُشوى وَخُبزٌ سَميذُ",61,"ذ",1,0],["وَلَدَينا راحٌ وَنُقلٌ وَمَشمو","مٌ وَمُردٌ تُحيي النُفوسَ وَحورُ",62,"ر",1,0],["وَلَدَينا السُرورُ دانَ وَعَنّا","الضِدُّ قَد غابَ وَالزَمانُ مُواتِ",63,"ت",1,0],["وَلَدَت لُؤلُؤَ الحَبابِ وَكانَت","قَبلَ وَقعِ المِزاجِ بِكراً عَقيما",64,"م",2,0],["وَلَّدَ الشَرقُ شَكلَها وَهوَ لَحيا","نُ فَصارَت في الغَربِ كَالإِنكيسِ",65,"س",1,0],["وَلَدَيكَ هذا كُلَّه عن رائِحٍ","من نَصْرِ ربّكَ في الحروبِ وغادِ",66,"د",1,0],["وُلِدَتْ بالشّيبِ في عنقودها","وهيَ اليومَ عجوزٌ لم تشب",67,"ب",1,0],["وَلَدَت بِهِ أُمُّ السِيادَةِ أَوحَداً","مُتَضَمِّناً مَعنى العَديدِ الأَكثَرِ",68,"ر",1,0],["وُلِدَ الإيمانُ في مَولدهِ","والجهادُ الحقُّ والعَزمُ المتينْ",69,"ن",1,0],["وَلَدَتْهُ مأسدةُ النُّبوَّةِ قَسْوَراً","لم يتّخِذْ غيرَ المصاحفِ خِيسا",70,"س",2,0],["وُلِدُوا حياةً للبلادِ فبوركتْ","تلك البطونُ وبورك الميلادُ",71,"د",1,0],["وَلدتكَ الكواكِبُ الزُّهرُ فَجراً","هاشميَّ السَّنا وَصُبحاً منيرا",72,"ر",2,0],["وُلِدتُ في حُبِّكِ يا مُنيَتي","بِطالِعٍ لَيسَ بِمِعطاءِ",73,"ا",2,0],["وَلَدَينا المُهَذَّبُ اِبنُ رَبابٍ","عِصمَةُ المُعتَفينَ بَحرُ البُحورِ",74,"ر",1,0],["وُلِدتِ مِن أُسرَةٍ مُبارَكَةٍ","لا عَيبَ فيهِم مِنَ الشَياطينِ",75,"ن",1,0],["وَلَدى العَتيرَةِ قَد نَظَمتُ قَلائِداً","مِنها عَلَيهِ غَضاضَةٌ وَقَتيرُ",76,"ر",1,0],["وَلَدَينا حُلوُ الثَنا صَيدَحِيٌّ","بِهَوانا تَزيدُهُ الكَأسُ جودا",77,"د",2,0],["وَلَدَتهُمُ في غَيرِ طُهرٍ عارِكاً","فَلِذاكَ تُفقَدُ فيهِمُ الأَطهارُ",78,"ر",1,0],["وَلَدَيَّ سِرٌّ لَيسَ يُمكِنُ ذِكرُهُ","يَخفى عَلى البَصراءِ