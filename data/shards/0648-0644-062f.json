85,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[45,"إما ألم فبعد فرط تجنب","https://www.aldiwan.net/poem11055.html","الكامل"],[45,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[45,"قربت من الفعل الكريم يداكا","https://www.aldiwan.net/poem65219.html","الكامل"],[45,"أيهذا الأمير قد مسنا الضر","https://www.aldiwan.net/poem66846.html","الخفيف"],[28,"أيوب إني لا إخالك تمتري","https://www.aldiwan.net/poem5009.html","الكامل"],[28,"وطئت جياد يزيد كل مدينة","https://www.aldiwan.net/poem5178.html","الكامل"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[66,"مولاي مثلي لا يضا","https://www.aldiwan.net/poem38660.html","مجزوء الكامل"],[66,"بك من حادث الزمان نعوذ","https://www.aldiwan.net/poem39050.html","الخفيف"],[66,"هذه ليلة السرور التي كل","https://www.aldiwan.net/poem39060.html","الخفيف"],[66,"أرسلت في الكؤوس بالمعجزات","https://www.aldiwan.net/poem39185.html","الخفيف"],[66,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[66,"أوضحت نار خده للمجوس","https://www.aldiwan.net/poem39917.html","الخفيف"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[105,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[105,"أمل يزف مع السنين عروسا","https://www.aldiwan.net/poem42084.html","الكامل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[48,"أعتل بالماء فأدعو به","https://www.aldiwan.net/poem10407.html","السريع"],[48,"اسقني إن سقيتني بالكبير من","https://www.aldiwan.net/poem63312.html","الخفيف"],[48,"وجه بنان كأنه قمر","https://www.aldiwan.net/poem66152.html","المنسرح"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[50,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[46,"يا ليل قد نام الشجي ولم ينم","https://www.aldiwan.net/poem22581.html","الكامل"],[46,"لئن سقتك الليالي مرة ضربا","https://www.aldiwan.net/poem22736.html","البسيط"],[8,"ولقد أغدو بشرب أنف","https://www.aldiwan.net/poem21800.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16670","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202688","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55015","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141918","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43683","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43681","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54298","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[100,"الربيع والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50128",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[45,"قَرُبَتْ، من الفِعلِ الكَرِيمِ، يَداكا","https://www.poetsgate.com/ViewPoem.aspx?id=32147",""],[51,"نفَّرتْ هِيفَك الليالي وغيدَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=28487",""],[105,"رددوا الذكرى لقوم غافلين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55095&r=&rc=265",""]],"verses":[["وَلَدَيكَ إِن طَمَحَ العَدوُّ صَوارِمٌ","تُدمى عَرانينَ العِدا وَتُذَلِّلُ",0,"ل",1,0],["وَلَدَيَّ مَرْقومُ القَميصِ قَدِ احْتَمتْ","مِنْهُ بِأَكْثِبَةِ الحِمى فَأَبَاحَها",1,"ح",3,0],["ولدتك آفاق المعالي والعل","شعلا كما تلد السماء الأنجما",2,"م",2,0],["وَلَّدْتَ أَشْكَالَ الْجَمَالِ بِوَجْنَةٍ","أَلَفْتَ فِيهَا حُمْرَةً بِبَيَاضِ",3,"ض",1,0],["وَلَدِي فِي ذَرَاكَ وَكْرِيَ فِي دَوْ","حِكَ لَحْدِي وَتُرْبَتِي فِي تُرْبِكْ",4,"ك",1,0],["وَلَدنٌ مِنَ الخَطِيِّ فيهِ أَسِنَّةٌ","ذَخائِرُ مِمّا سَنَّ أَبزى وَشَرعَبُ",5,"ب",1,0],["وَلَدي قَد طالَ سُهدي وَنَحيبي","جِئتُ أَدعوكَ فَهَل أَنتَ مُجيبي",6,"ب",2,1],["وَلَدتُ وَلَمّا لَم أَجِد لِعَرائِسي","رِجالاً وَأَكفاءً وَأَدتُ بَناتي",7,"ي",1,0],["وَلَدافَعَت عَنكَ المنونَ فَوارِسٌ","بيضُ الوُجوهِ كَريمَةُ الأَجدادِ",8,"د",1,0],["وَلَدَيكِ أَمثالَ النُجومِ قَلائِدٌ","أَلِفَت سَماءَكِ لَبَّةً وَتَريبا",9,"ب",2,0],["ولِدَا البَنِينَ الصَّالِحِنَ","لَتَستَدِيمَا خَيْرَ آلِ",10,"ل",1,0],["وَلَدُ الفقر والرِّباط ولكنْ","نفسُهُ للسلوك ذات افتقار",11,"ر",1,1],["ولدت لزنية ونشأت نغلاً","ربيباً في حجور ذوات عهر",12,"ر",1,0],["ولديّ إن وصل الحبيب تمسّك","بالعزّ يمنع فايَ من تقبيله",13,"ل",2,0],["وَلَدَ الأُخَيطِلَ نِسوَةٌ مِن تَغلِبٍ","هُنَّ الخَبائِثُ بِالخَبيثِ غُذينا",14,"ن",2,0],["وَلَدَ الحَواصِنُ في قُرَيشٍ مِنهُمُ","يا رُبَّ مَكرُمَةٍ وَلَدنَ وَخيرِ",15,"ر",1,0],["وَلَدَت قُفَيرَةُ أُمُّ صَعصَعَةَ اِبنَها","فَوقَ المُزَنَّمِ بَينَ وَطبَي جازِرِ",16,"ر",1,0],["وَلَدَ الفَرَزدَقَ وَالصَعاصِعَ كُلَّهُم","عِلَجٌ كَأَنَّ وُجوهَهُنَّ مَقالي",17,"ي",1,0],["وَلَدَت بَنو حُرثانَ فَرخَ مُحَرِّقٍ","بِلِوى الوَضيعَةِ مُرتَجَ الأَبوابِ",18,"ب",1,1],["وَلَدى النُعمانِ مِنّي مَوطِنٌ","بَينَ فاثورِ أُفاقٍ فَالدَحَل",19,"ل",1,0],["وَلَدنا بَني العَنقاءِ وَاِبني مُحَرَّقٍ","فَأَكرِم بِنا خالاً وَأَكرِم بِذا اِبنَما",20,"م",2,0],["ولدولةِ الملكِ المؤيدِ إنَّها","جمعت فنونَ المدحِ بعدَ شتاتها",21,"ت",3,0],["وَلَدَت أُمّي أَباها","إِنَّ ذا من عَجَباتي",22,"ت",2,0],["ولديهم وذَائلُ الفِضَضِ البي","ضُ تباهي سبائكَ الأَذهابِ",23,"ب",1,0],["ولديك الدهاءُ في محتواه","بل لديك الصَّفيحُ في أغمادِهْ",24,"د",2,0],["ولَّدَتْهُ فِطْنَةٌ إنسيَّةٌ","تدَّعيها الجنُّ غرّاءٌ وَلُودُ",25,"د",1,0],["وَلَّدَ الغيْثَ بعد قَحْطٍ ندى كف","فيْكَ لا يَعْدَمِ الحيا توليدَكْ",26,"ك",1,0],["ولدى قحبةٍ كَسَتْك قُروناً","لك من حَملها قفا ملموز",27,"ز",1,0],["ولدي منكَ متى أثرتَ كوامني","ما لا يقصِّصُه سواي مقصِّصُ",28,"ص",1,0],["ولدٌ أقرَّ لعين والده","طالت لوالده به المتعه",29,"ع",2,0],["ولَدفعُ الفحل أشهى إليه","من دفاع الله إذ لا دفاع",30,"ع",1,0],["ولديها تبتُّلٌ فإذا ما","غاب في الخاقِ باقِ زال التبَتُّلْ",31,"ل",1,0],["ولدتْهُما من غيرِ شي","خِك ذي الفضائل والفواضلْ",32,"ل",1,0],["ولديه لهُنَّ إنْ فَرَّ أو كَرْ","رَ عتاد المفَرِّ والمقدام",33,"م",1,0],["ولدينا سَكنجبينٌ وحيدٌ","أنت عندي بالأجرِ فيه قمين",34,"ن",1,0],["ولديك للمكروب أوسعُ همّةٍ","عَطْفاً وأنورُ غُرَّةٍ وجبين",35,"ن",1,0],["وَلِدتُم بَعدَ إِخوَتِكُم مِنِ اِستٍ","فَهَلّا جِئتُمُ مِن حَيثُ جاؤوا",36,"ا",3,0],["وَلَدٌ يَتهادى في العَشرِ","وَفَتىً في بُردِ العِشرينا",37,"ن",2,0],["وَلِديمَةٍ تَذري عَلَيهِ دُموعَها","كَما تَقيهِ غَوائِلَ المَحلِ",38,"ل",1,0],["وَلَدَينا ذَلِكَ الضَي","فُ الَّذي عِندَكَ عِلمُه",39,"م",2,0],["ولدت لها استقلالها فهو باسم","إليك ابتسام الطفل في وجه والد",40,"د",1,0],["ولدتها الارض الكريمة بكراً","وسقتها السماء در العهاد",41,"د",1,0],["ولدىَّ مصر لها كما لكما هوىً","والحب كل صبابة بمذاق",42,"ق",1,0],["وَلَدَ الثَورَةَ سَعدٌ حُرَّةً","بِحَياتَي ماجِدٍ حُرٍّ نَماها",43,"ا",3,0],["وُلِدَ الهُدى فَالكائِناتُ ضِياءُ","وَفَمُ الزَمانِ تَبَسُّمٌ وَثَناءُ",44,"ا",2,1],["وُلِدوا عَلى راحِ العُلا وَتَرَعرَعوا","في نِعمَةِ الأَملاكِ وَالأُمَراءِ",45,"ا",2,0],["وُلِدَت فَكُنتَ المَهدَ ثُمَّ تَرَعرَعَت","فَأَظَلَّها مِنكَ الحَفِيُّ المُشفِقُ",46,"ق",1,0],["وَلِدتِ لَهُ المَآمينَ الدَواهي","وَلَم تَلِدي لَهُ قَطُّ الأَمينا",47,"ن",2,0],["وُلِدَت قَضِيَّتُها عَلى مِحرابِهِ","وَحَبَت بِهِ طِفلاً وَشَبَّت مُعصِرا",48,"ر",2,0],["وَلَدَ البَدائِعَ وَالرَوائِعَ كُلَّها","وَعَدَتهُ أَن يَلِدَ البَيانَ عُوادي",49,"د",2,0],["وُلِدَ الرِفقُ يَومَ مَولِدِ عيسى","وَالمُروءاتُ وَالهُدى وَالحَياءُ",50,"ا",2,0],["وَلَدَيهِ مِلعِقيانِ وَالأَدَبِ المُفا","دِ وَمِلحَياةِ وَمِلمَماتِ مَناهِلُ",51,"ل",1,0],["وُلِدنَ تَحتَ أَثقَلِ الأَحمالِ","قَد مَنَعَتهُنَّ مِنَ التَفالي",52,"ل",2,0],["وَلَدى بَني يَزدادَ حَيثُ لَقيتُهُم","كَرَمٌ كَغادِيَةِ السَحابِ الصَيِّبِ",53,"ب",1,0],["وَلَدَيهِ تَحتَ السَكينَةِ وَالإِخ","باتِ سَطوٌ عَلى العِدى وَاِقتِدارُ",54,"ر",1,0],["وَلَدَتهُ الشُموسُ مِن وَلَدِ العَبّا","سِ عَمِّ النَبِيِّ وَالأَقمارُ",54,"ر",1,0],["وَلَدَيكَ صافِيَةٌ كَأَنَّ نَسيمَها","مِن طيبِ عَرفِكَ أَو جَميلِ نَثاكا",55,"ك",2,0],["وَلَدَينا بِضاعَةٌ مُزجاةٌ","قَلَّ خُطّابُها فَبارَت لَدَينا",56,"ن",2,0],["وَلَدَتكَ أُمُّكَ في كِناسَةَ دارِهِم","حَتّى اِستُثِرتَ مِنَ التُرابِ اللابِدِ",57,"د",1,0],["وَلَدَت لِأَزهَرَ كُلَّ أَصيَدَ يَبتَني","بِالسَيفِ يَومَ تَعانُقٍ وَكِرارِ",58,"ر",1,0],["ولَدٌ عَلَتْ بَركاتُ مَولِدِه","سَعْداً وطهَّرَه مُطَهِّرُه",59,"ر",2,0],["وَلَدَيَّ سِرُّكَ لا يُذا","عُ وَلا يُزالُ وَلا يُذامُ",60,"م",1,0],["وَلَدَينا شادٍ وَنَقلٌ وَمَشمو","مُ وَطَيرٌ يُشوى وَخُبزٌ سَميذُ",61,"ذ",1,0],["وَلَدَينا راحٌ وَنُقلٌ وَمَشمو","مٌ وَمُردٌ تُحيي النُفوسَ وَحورُ",62,"ر",1,0],["وَلَدَينا السُرورُ دانَ وَعَنّا","الضِدُّ قَد غابَ وَالزَمانُ مُواتِ",63,"ت",1,0],["وَلَدَت لُؤلُؤَ الحَبابِ وَكانَت","قَبلَ وَقعِ المِزاجِ بِكراً عَقيما",64,"م",2,0],["وَلَّدَ الشَرقُ شَكلَها وَهوَ لَحيا","نُ فَصارَت في الغَربِ كَالإِنكيسِ",65,"س",1,0],["وَلَدَيكَ هذا كُلَّه عن رائِحٍ","من نَصْرِ ربّكَ في الحروبِ وغادِ",66,"د",1,0],["وُلِدَتْ بالشّيبِ في عنقودها","وهيَ اليومَ عجوزٌ لم تشب",67,"ب",1,0],["وَلَدَت بِهِ أُمُّ السِيادَةِ أَوحَداً","مُتَضَمِّناً مَعنى العَديدِ الأَكثَرِ",68,"ر",1,0],["وُلِدَ الإيمانُ في مَولدهِ","والجهادُ الحقُّ والعَزمُ المتينْ",69,"ن",1,0],["وَلَدَتْهُ مأسدةُ النُّبوَّةِ قَسْوَراً","لم يتّخِذْ غيرَ المصاحفِ خِيسا",70,"س",2,0],["وُلِدُوا حياةً للبلادِ فبوركتْ","تلك البطونُ وبورك الميلادُ",71,"د",1,0],["وَلدتكَ الكواكِبُ الزُّهرُ فَجراً","هاشميَّ السَّنا وَصُبحاً منيرا",72,"ر",2,0],["وُلِدتُ في حُبِّكِ يا مُنيَتي","بِطالِعٍ لَيسَ بِمِعطاءِ",73,"ا",2,0],["وَلَدَينا المُهَذَّبُ اِبنُ رَبابٍ","عِصمَةُ المُعتَفينَ بَحرُ البُحورِ",74,"ر",1,0],["وُلِدتِ مِن أُسرَةٍ مُبارَكَةٍ","لا عَيبَ فيهِم مِنَ الشَياطينِ",75,"ن",1,0],["وَلَدى العَتيرَةِ قَد نَظَمتُ قَلائِداً","مِنها عَلَيهِ غَضاضَةٌ وَقَتيرُ",76,"ر",1,0],["وَلَدَينا حُلوُ الثَنا صَيدَحِيٌّ","بِهَوانا تَزيدُهُ الكَأسُ جودا",77,"د",2,0],["وَلَدَتهُمُ في غَيرِ طُهرٍ عارِكاً","فَلِذاكَ تُفقَدُ فيهِمُ الأَطهارُ",78,"ر",1,0],["وَلَدَيَّ سِرٌّ لَيسَ يُمكِنُ ذِكرُهُ","يَخفى عَلى البَصراءِ وَهوَ نَهارُ",78,"ر",1,0],["وَلِدتِ يا أُمَّ طِفلاً شَبَّ في عَنَتٍ","فَلَيتَ كَشحَكِ عَن ذاكَ الجَنينِ بُقِر",79,"ر",1,0],["وَلَديَنا قَينَةٌ مُسمِعَةٌ","ضَخمَةُ الأَردافِ مِن غَيِر نَفش",80,"ش",1,0],["ولديهِ ملاعب لظباءِ","حاليات كثيرة اللفتات",81,"ت",1,0],["وَلَدَيهِم مِنَ الفُنونِ لُبابٌ","وَلَدَينا مِنَ الفُنونِ قُشورُ",82,"ر",1,0],["ولِدَاتٌ لها تُوَهِّمُ غِرًّا","أنّ حُمْرَ العِيابِ خُضْرُ الغُروب",83,"ب",1,0],["ولَدَيّ نارٌ ليْتَ قَلْبي مِثْلُها","فيَكُونَ فاقِدَ وَقْدَةٍ وسَخائِم",84,"م",1,0],["ولد الهدى فالكائنات ضياء","وفم الزمان تبسم وسناء",85,"ا",2,1],["وَلدِي بَكَيْتُكَ بِالدُّمُوعِ سَخِينَةً","هَيْهَاتَ يُغْنِي مِنْكَ طَرْفٌ دَامِعُ",86,"ع",1,1],["وَلَدِي بِسُهْدِ العَيْنِ قَدْ رَبَّيْتُهُ","فَأَقَرَّ عَيْنَ الْمَجْدِ مُذْ هُوَ يَافِعُ",86,"ع",1,0],["وُلد الفتى العذري عروة بعدما","دارت بوالده رحى الحدثان",87,"ن",1,0],["ولد الهوى والخمر ليلة مولدي","وسيحملان معي على ألواحي",88,"ي",1,0],["وَلَدَت وُجوهُهُمُ العِجاجَةَ طَلعَةً","وَظُبى السُيوفِ ثَواكِلُ الأَغمادِ",89,"د",1,0],["وَلِدات سَبَقتهُم لَحِقوني","صارَ مَن كانَ غالِباً مَغلوبا",90,"ب",2,0],["وَلدي كَيفَ نَستَوي أَنا في حر","رِ الرَزيا وَأَنتَ في ظِلِّ طوبى",90,"ب",2,0],["وَلَدي هَل إِلى اللِقاءِ سَبيلٌ","أَنتَ فِطرُ المُنى وَهُنَّ صِيامُ",91,"م",1,0],["ولَدي لا تَنسَني يَومَ أَظما","وَاِسقِني كَأسَ المَعينِ الشَهِيِّ",92,"ي",1,0],["وَلَدي أَودى فَلا شَغَفٌ","لي بِالدُنيا وَلا شُغُلا",93,"ل",2,0],["وَلَدي عَبدَ الغَنِيِّ أَما","بَلَغَت فيكَ العُلا أَمَلا",93,"ل",2,0],["وَلَدي فارَقتُ لا بَل كَبدي","فَالَّذي اِستَجمَعَ مِن شَملي اِفتَرَق",94,"ق",1,0],["وَلَدي نالَ الرِّضا وَرَأى","خَلَدي ما نالَهُ فَرَجا",95,"ج",2,0],["وَلَدي يَومَ مَوتِهِ","أَصبَحَ الدَهرُ ذا عَبَث",96,"ث",1,1],["وُلِدُوا وشَمْسُ الأُفْقِ في رَيعَانِها","والدَّهْرُ يَرْفُل في ثِيابِ صِبَائه",97,"ا",3,0],["وُلدتِ وَلِلْعِلْمِ أَسْرَارُهُ","وَقَدْ كُنْتِ مِنْ سِرِّهِ الْمُعْضَلِ",98,"ل",1,0],["وُلِدَ المجدُ فيه والشرَفُ السا","مِي ونُور الحِجا ونُبْلُ الخِلالِ",99,"ل",1,0],["وُلِدَ السعدُ على أبوابِه","ونَما في ظلِّه لمَّا نمَا",100,"م",2,0],["ولدتْ؛ فأنجبت الكرامَ، وأتأمَتْ","وجَرَى بنوها في المعارف أبْحُرا",101,"ر",2,0],["وُلِدَ المصطَفى! سَلامٌ عليْهِ","مَا حَبَا، أو مَشَى، أو اشتَدَّ عُودَا!",102,"د",2,0],["وُلدَ الصادقُ الأمينُ؛ فيا شَمْ","سُ أطِلِّي، وباركي المولودا",102,"د",2,0],["ولدتك آفاق المعالي والعلا","شعلا كما تلد السماء الأنجما",103,"م",2,0],["وُلد الالمعيُ فالنجمُ واجمْ","باهتٌ من سُطوع هذا المُزاحمْ",104,"م",1,1],["ولدي مُذْ عَرَفتُه يملأ البيتَ","بتفكيرِهِ ارتهاباً وحُزناً",105,"ن",2,0],["ولدي طامحٌ تُعنَيه آمالٌ كِثارٌ","إن الطَّموحَ مُعَنَّى",105,"ن",2,0],["ولدي اختَشي عليه من الموتِ","انتحاراً وختشِي انْ يُجَنّا",105,"ن",2,0],["ولدي لم يكنْ ليحملَ – لولا","ان يُلِحُّوا به – على الناسِ ضِغْنا",105,"ن",2,0],["ولَدَرَّ ضَرْعٌ رُحتَ تحلِبُه","إنْ كان أعوَزَ غيرَكَ الدَرُّ",106,"ر",1,0],["ولدى الأمرِ لا محالةَ مغلوبٌ","ضعيفٌ يقاومُ التّيارا",107,"ر",2,0],["ولديكِ تاريخٌ على صَفَحاتِه","أرَجٌ يضُوعُ من الدم المسفوك",108,"ك",1,0],["وَلَدَيْكَ صَافِيةٌ، كأنّ نَسيمَها","مِن طيبِ عَرْفكَ، أوْ جَميلِ ثَناكَا",109,"ك",2,0],["وَلَّدَ الغيْث بعد قَحْطِ ندى ك","فَيْكَ لا يَعْدَمِ الحيا توليدَكْ",110,"ك",1,0],["ولد الإيمان في مولده","والجهاد الحق والعزم المتير",111,"ر",1,0]]}