{"poems":[[57,"كتاب حبيب جاءني بعد جفوة","https://www.aldiwan.net/poem26141.html","الطويل"],[29,"أتعرف أم أنكرت أطلال دمنة","https://www.aldiwan.net/poem5729.html","الطويل"],[63,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[68,"إذا مت فانعيني بخفق مثالث","https://www.aldiwan.net/poem39202.html","الطويل"],[35,"إذا نظرت نحوي تكلم طرفها","https://www.aldiwan.net/poem25981.html","الطويل"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[50,"ولاح لحاني كي يجيء ببدعة","https://www.aldiwan.net/poem64419.html","الطويل"],[48,"إذا مت لم أحفل بما الله صانع","https://www.aldiwan.net/poem22229.html","الطويل"],[48,"تكذب قوم يستعيرون سؤددا","https://www.aldiwan.net/poem22881.html","الطويل"],[48,"خلو فؤادي بالمودة إخلال","https://www.aldiwan.net/poem23632.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62219","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62206","الطويل"],[141,"إذا مت يا أم الحنيكل فانكحي","https://www.aldiwan.net/poem67921.html","الطويل"],[190,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[333,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[443,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[542,"إذا مت فادفني إلى أصل كرمة","https://www.aldiwan.net/poem69400.html","الطويل"],[574,"إِذا مت فانعيني لأَضياف شقة","https://www.aldiwan.net/poem51994.html","الطويل"],[586,"دعوت بني قيس إلي فشمرت","https://www.aldiwan.net/poem2252.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48840","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48610","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64096","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96354","الطويل"],[1203,"","https://poetry.dctabudhabi.ae/diwan/poem/28285","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11155","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103221","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103218","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28474","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[3479,"","https://poetry.dctabudhabi.ae/diwan/poem/101959","الطويل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116843","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132118","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21513","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66120","المتقارب"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89586","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132203","الطويل"],[4896,"ظلمات وشعاع","https://www.poetsgate.com/ViewPoem.aspx?id=180884",""],[5262,"إذا مت فادفني مجاور كرمة","https://www.poetsgate.com/ViewPoem.aspx?id=165128",""],[5277,"للقدس..حنين ومدامع","https://www.poetsgate.com/ViewPoem.aspx?id=190394",""],[5334,"إذا متُّ فانْعيني لمولًى تظاهرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=96985",""],[5616,"قاصمة الظهر","https://www.poetsgate.com/ViewPoem.aspx?id=203429",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5956,"إذا متّ مغشيّاً عليّ من الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=181919",""],[5956,"أُلامُ لأني أحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=182085",""]],"verses":[["إِذا مُتُّ فَاِبكوني قَتيلاً بِطَرفِهِ","قَتيلَ عَدُوٍّ حاضِرٍ لا يُزايِلُه",0,"ل",2,0],["إِذا مُتُّ فَاِنعَيني لِأَضيافِ لَيلَةٍ","تَنَزَّلَ مِن صُلبِ السَماءِ جَليدُها",1,"د",3,0],["إذا متَعَتْ أخلاقُه الغُرُّ خَيَّلَتْ","لعَيْنَيْكَ أنَّ الشَّمسَ راجٍ مُتوعُها",2,"ع",3,0],["إِذا مُتُّ فَاِنعَيني بِخَفقٍ مَثالِثٍ","وَصَرخَةِ نايٍ وَاِصطِفاقِ مَزاهِرِ",3,"ر",1,1],["إِذا مُتُّ خَوفَ اليَأسِ أَحيانِيَ الرَجا","فَكَم مَرَّةٍ قَد مُتُّ ثُمَّ حَيِيتُ",4,"ت",1,0],["إِذا مِتُّ فَانعَيني لِقَومِكِ وَاِبجِحي","بِذِكري وَمِثلي نُهيَةُ المُتَبَجِّحِ",5,"ح",1,0],["إِذا مِتُّ فَادفِنّي إِلى جَنبِ كَرمَةٍ","تُرَوّي عِظامي بَعدَ مَوتي عُروقُها",6,"ق",3,0],["إِذا مُتُّ لَم أَحفِل بِما اللَهُ صانِعٌ","إِلى الأَرضِ مِن جَدبٍ وَسَقيِ غُيوثِ",7,"ث",1,1],["إِذا مُتُّ لَم أَحفِل بِما قالَ عائِبي","وَهَل ضَرَّ تُرباً رَميُهُ بِالمَشاقِصِ",8,"ص",1,0],["إذا مُتُّ لم أحْفِلْ أبالشأم حُفْرَةٌ","حَوَتْنيَ أم ريمٌ برَيْمانَ مُنْهالُ",9,"ل",1,0],["إِذَا مِتُّ عَنْ ذِكْرِ القَوَافِي فَلَنْ تَرَى","لَهَا تَالِياً مِثْلَي أَطَبَّ وأَشْعَرَا",10,"ر",2,0],["إذَا مِتُّ فَانْعَيْنِي بِمَا أَنَا أَهْلُهُ","وذُمِّي الحَيَاة كُلُّ عَيْشٍ مُتَرَّحُ",11,"ح",1,0],["إِذا مُتُّ يا أُمَّ الحُنَيكِلِ فَاِنكِحي","وَلا تَأمُلي بَعدَ الفِراقِ تَلاقِيا",12,"ي",2,1],["إذا متّ من يقضي ديونك قل لنا","أظُنّ وظني الحق عزمك تجحد",13,"د",1,0],["إذا متّ فامضى إلى غرفتي","ولا تنضحي قفرها بالبكاء",14,"ا",2,0],["إذا متعت أجفان ملك رقادها","عن الملك أضحى حشو أجفانه السهد",15,"د",1,0],["إذا مُت فادفِنّي إِلى أصلِ كَرمَةٍ","تروّي عظامي في التراب عروقُها",16,"ق",3,1],["إِذا مت فانعيني لأَضياف شقة","رمى بهم داج بهيم الغياطل",17,"ل",1,1],["إِذا مت قُلوبُ القَومِ طارَت مَخافَةً","مِنَ المَوتِ أَرسَوا بِالنُفوسِ المَواجِدِ",18,"د",1,0],["إذا متُ محروماً فأيُّ موحِّدٍ","أحق بما حاز الغنيُّ المكاثرُ",19,"ر",1,0],["إذا مت بالداء الذي أنا مشتكٍ","فلا عرف الأدواء بعدي الأطباء",20,"ا",2,0],["إذا متلوِّنُ المنثو","رِ أُلِّفَ فوق أَطباقِه",21,"ق",2,1],["إذا مُتُّ فانعيني بما كُنتُ اهله","لتغلبَ إنَّ الحَقَّ لا بُدَّ غالي",22,"ي",1,0],["إِذا متُّ فَاِعتادي القُبورَ وَسَلِّمي","عَلى الرَمسِ أُسقيتِ السَحابَ الغَوادِيا",23,"ي",2,0],["إِذا مُتُّ يا قَومي فَلا تَدفِنونَّني","فَأَ بغَضُ جيرانٍ إِلَيَّ قُبورُ",24,"ر",1,0],["إذا مُتُّ كانَ الناسُ نصفَينِ شامِتٌ","وآخرُ مُثنٍ بالذي كنتُ أَصنَعُ",25,"ع",1,0],["إذا مِتُّ يوماً فاحضِري أمَّ خالدٍ","تراثَكِ من طِرفٍ وَسَيفٍ وأَقدُرِ",26,"ر",1,0],["إِذا مِتُّ فادفِني بِوَعساءَ سَهلَةٍ","بِها السِّربُ يَعطو وَالجآذِرُ تَلعَبُ",27,"ب",1,1],["إذا مُتُّ عاَفَ النَّجمُ بضعدِي قِيَاسَهُ","وَلي تَشهَدُ الرائيتانِ النوادِر",28,"ر",1,0],["إذا مت مت بين الرماح وقضبها","فأكرم ميت من تحف به القضب",29,"ب",1,0],["إذا متَّ مات الجودُ وانقطعَ الندى","من الناس إلا من قليل مُصَرَّدِ",30,"د",1,1],["إذا مت عن قومي وعن وطني فدىً","فإني أعدّ الموت نعمة رازقِ",31,"ق",1,0],["إِذا مَتَّ ذو القُربى إِلَيكَ بِرَحمِهِ","وَغَشَّكَ وَاِستَغنى فَلَيسَ بِذي رُحمِ",32,"م",1,0],["إِذا مِتْ فَلْتَحْيَ بَعْدِي بِلادي","وتَنْهَضْ إلى مَجْدِها الأَرْفَعِ",33,"ع",1,0],["إِذا مُتُّ فَاِنعيني أَدنيا مَدى البَقا","وَإِن شِئتِ يا دُنيا فَموتي إِذَن بَعدي",34,"د",2,0],["إذا مت فادفني حذاء حليلتي","يخالط عظمي في التراب عظامها",35,"م",3,1],["إذا مت لا تحزني إنني","تراب يعود إلى بعضه",36,"ض",2,1],["إذا مت فادفني مجاور كرمة","تروي عظامي في الممات عروقها",37,"ه",2,1],["اذا متُّ ظمآناً فحتفُ حنينِها","ولم أرتو.....فالموت لا شك أسرعُ",38,"ع",1,0],["إذا متُّ فانْعيني لمولًى تظاهرتْ","عليهِ من الأعداءِ أيدٍ وألسُنُ",39,"ن",1,1],["إذا متّ فأقرأ ما تشاء على قبري","وقل كان يحيا في حصار وفي قهر",40,"ر",1,1],["إذا متع النهار أوت إليه","ظلال النخل ناعسة الجفون",41,"ن",1,0],["إذا متّ مغشيّاً عليّ من الهوى","فذلك أمر الله أن أستنفدَ القوى",42,"و",2,1],["إذا متُّ حيا فلا تعجبنَّ","وإن عشت ميْتاً، فهذا الغرامْ",43,"م",1,0]]}