8.html","الرمل"],[477,"ما ضر أهل الحمى لو أنهم رجعوا","https://www.aldiwan.net/poem15287.html","البسيط"],[496,"قرأت مجدك في قلبي وفي الكتب","https://www.aldiwan.net/poem55808.html","عموديه"],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[514,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[514,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[551,"من رأى لي في الدجى ذا خطل","https://www.aldiwan.net/poem47224.html","الرمل"],[551,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[551,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[553,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[562,"أعرفت رسم الدار أم لم تعرف","https://www.aldiwan.net/poem52886.html","الكامل"],[562,"خلت الديار كأنها لم تؤهل","https://www.aldiwan.net/poem52933.html","الكامل"],[562,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[567,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[575,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"]],"verses":[["خِلتَ أَيديهِنَّ في مَعزائِها","أَنمُلَ الوِلدانِ يَفلينَ اللِماما",0,"م",2,0],["خِلتُهُم وَالخَطبُ يَعتامُهُمُ","شَجَرَ الوادي اليَمانيَّ يُعَط",1,"ط",1,0],["خَلَت بِهِمُ الأَجداثُ عَنّا وَأُطبِقَت","عَلى المَجدِ مِنهُم كُلُّ بَيداءَ قُردُدِ",2,"د",1,0],["خَلَتِ الدِيارُ فَزُرتُها وَكَأَنَّني","ذو حَيَّةٍ مِن سَمِّها لَم يَعرَقِ",3,"ق",1,0],["خِلتُهُ يا قَومُ يُؤنِسُني","إِن جَفاني مُؤنِسُ السَحَرِ",4,"ر",1,0],["خِلتُ اللِواءَ غَمامَةً في ظِلِّها","قَمَرٌ بِغُرَّتِهِ السَنا الوَقّادُ",5,"د",1,0],["خِلْتُمْ طَرَابُلُسَ الغُنْمَ المُبَاحَ لَكُمْ","وَشَرُّ مَا قَتَلَ الخُدَّاعَ مَا غَنِمُوا",6,"م",3,0],["خَلَت غَيرَ آجالَ الصَريمِ وَقَد تَرى","بِها وُضَّحَ اللَبّاتِ حورَ المَدامِعِ",7,"ع",1,0],["خلت العراقين خدّي ثاكل وهما","سطران للدمع في الخدين قد سطرا",8,"ر",2,0],["خلَتِ الإساءةُ من إرادته","ويريد إحساناً ويعتمدُهْ",9,"د",2,0],["خِلتني نُهزةً لباغي قنيصٍ","وأنا الليثُ قانصُ القُنّاص",10,"ص",1,0],["خَلَت غَيرَ أُحدانٍ تَلوحُ كَأَنَّها","نُجومٌ بَدَت وَاِنجابَ عَنها غُيومُها",11,"م",3,0],["خِلتُ أَنِّي في القَفرِ أَصبَحتُ وَحدي","فَإِذا الناسُ كُلُّهُم في ثِيابي",12,"ي",1,0],["خُلتُ اللَيالي في تَتابُعِها","تُزري بِها عِندي فَلَم تَزرِ",13,"ر",1,0],["خَلَت أَرائِكُ كانَت أَمسِ آهِلَةً","غَنّاءَ فَاليَومُ لا شادٍ وَلا شادِ",14,"د",1,0],["خِلتُ قَلبي بِالأَسى مُنفَرِدا","وَأَنا وَحدي صَريعُ المِحَن",15,"ن",1,0],["خِلتِ الدُهورُ وَلا يَزالُ كَأَنَّما","بِأَمسِ شادَتهُ يَدُ الرَحمَنِ",16,"ن",1,0],["خِلتُ أَنّي إِذا بَعِدتُ سَأَنسا","ها وَيَطوي الزَمانُ سِفرَ هَواها",17,"ا",3,0],["خَلَت مِن جَميعِ ساكِنينَ وَبُدِّلَت","ظِباءَ السَليلِ بَعدَ خَيلٍ وَجامِلِ",18,"ل",1,0],["خلت الكنانة من زكي بعدما","كان الزكي بها يروح ويغتدي",19,"د",2,0],["خلَت من كل ما فيها كأني","أقمت الفأر فيها صيدليا",20,"ي",2,0],["خلت الأرض من الهَدى ومن","مرشد للنشء بالهدى كفيل",21,"ل",1,0],["خلت العشية في السجون أسِرّة","يا ليتها للظالمين وِطاء",22,"ا",2,0],["خَلَتِ الدُهورُ وَما اِلتَقَت أَجفانُهُ","وَأَتَت عَلَيهِ كَلَيلَةٍ وَنَهارِ",23,"ر",1,0],["خَلَت دُوَلُ الزَمانِ وَزُلنَ رُكناً","وَرُكنُ الأَرضِ باقٍ ما تَداعى",24,"ع",2,0],["خَلَت حِلمِيَّةٌ مِمَّن بَناها","فَكَيفَ البَيتُ حَولَكَ وَالبَناتُ",25,"ت",1,0],["خَلَتِ الأَعوادُ مِن أَسمائِها","وَتَغَطَّت بِالمَصاليبِ الجُذوع",26,"ع",1,0],["خِلتُ بِأَنوارِهِ","قَرنَ ذُكاءٍ نَجَم",27,"م",1,0],["خَلَتِ القُرونُ كَلَيلَةٍ وَتَصَرَّمَت","دُوَلُ الفُتوحِ كَأَنَّها أَحلامُ",28,"م",1,0],["خَلَتِ القُرونُ وَأَنتِ حَربُ مَمالِكٍ","لَم يَغفِ ضِدُّكِ أَي يَنَم شانيكِ",29,"ك",1,0],["خَلَت مِن بَني الجَيشِ الحُصونُ وَأَقفَرَت","مَساكِنُ أَهليها وَعَمَّ التَخَرُّبُ",30,"ب",1,0],["خَلَتْ تأْكُلُ الأَيّامَ حالاً بحالَةٍ","وتُتْبِعُ جِيلاً في الزَّمان بِجِيلِ",31,"ل",1,0],["خَلَتِ البِلادُ مِنَ الغَزالَةِ لَيلَها","فَأَعاضَهاكَ اللَهُ كَي لا تَحزَنا",32,"ن",2,0],["خَلَت بَلَدٌ مِن ساكِنيها وَأَوحَشَت","مَرابِعُ مِن سِنجارَ يَهمي بِها الوَبلُ",33,"ل",1,0],["خَلَت وَرَأَتني مُغرَماً فَتَجَنَّبَت","وَشَتّانَ فو حُبٍّ خَلِيٌّ وَمُغرَمُ",34,"م",1,0],["خِلتُ جَهلاً أَنَّ الشَبابَ عَلى طو","لِ اللَيالي ذَخيرَةٌ لَيسَ تَفنى",35,"ن",2,0],["خِلتُهُ لَمّا تَبَدّى","قَمَراً غُصنِ بانِ",36,"ن",1,1],["خَلَّتْهُ وَاعْتَاضَتْ فَتىً نَفِيسا","وَفَارَقَتْ مِن نَتْنِهِ نَاوُوسا",37,"س",2,0],["خَلَتْ منه ميادينُ التَّصابي","وعُرِّيَ منه أفراسُ الشَّبابِ",38,"ب",1,0],["خِلتُ الفَضائِلَ بَينَ الناسِ تَرفَعُني","بِالإِبتِداءِ فَكانَت أَحرُفَ القَسَمِ",39,"م",1,0],["خِلتُها وَاللَيلِ مُعتَكِرٌ","وَنُجومُ الأَفقِ لَم تَغِبِ",40,"ب",1,0],["خِلتَ السَماءَ تَمَنطَقَت","بِمَناقِبِ المَلِكِ السَعيدِ",41,"د",1,0],["خَلَت وران عليها الصمت وانقلبت","كأنما لَفَّها ثوبٌ من العدم",42,"م",1,0],["خَلَتْ منه يوْمَ الرّوْع كلّ كتيبةٍ","وكم عَمِرَتْ من بأسِهِ بالتقدّمِ",43,"م",1,0],["خَلَتْ منك أَيّام الشَّبيبَةِ فَاعْمُرْهَا","وماتَتْ لياليها من العُمْرِ فانْشُرْهَا",44,"ر",3,1],["خَلَتِ القُبورُ بِظَبيَةٍ عَهدي بِها","فيما يُقالُ لَذيذَةٌ خَلَواتُها",45,"ت",3,0],["خِلتَ عُقاباً بَيضاءَ في حُجُراتِ ال","مُلكِ طارَت مِنهُ وَفي سُدَدِه",46,"د",2,0],["خِلْتَهَا مَاءً نَمِيراً","فَاشْرَبَنْ عَلاً وَنَهْلا",47,"ل",2,0],["خَلَتْ ديارُ الحبيبِ منهمْ","يا ليتني متُّ قبلَ هذا",48,"ذ",2,0],["خِلْتُ السماءَ بها تهوي لتلثَمَهُ","والنجمَ يسمحُ من أعطافه لِينا",49,"ن",2,0],["خِلتَ أَنّا نُغَيِّرُ الوَصلَ مِنّا","عَنكَ أَم خِلتَ حَبلَنا مَقطوعا",50,"ع",2,0],["خُلَّتي لَو بِكُم كَما","بي إِذاً لَم نُراقِبِ",51,"ب",1,0],["خَلَت عَن ثَرى نَجدٍ فَما طابَ بَعدَها","وَلَو راجَعَت نَجداً لَطابَ إِذَن نَجدُ",52,"د",1,1],["خَلَتِ المنازلُ منكَ والأوطانُ","وقَضَى عَليكَ قَضاءَهُ الحِدثانُ",53,"ن",1,1],["خَلَتِ القُرونُ وَنورُهُم مُتَبَلِّجٌ","وَمَضى الزَمانُ وَفِكرُهُم فَيّاحُ",54,"ح",1,0],["خَلَّت مَحارِمَها لِلأَزدِ ضاحِيَةً","وَلَم تُعَرِّج عَلى مالٍ وَلا وَلَدِ",55,"د",1,0],["خُلّتي لَو قَدَرتُ مِنكِ عَلى ما","قُلتِ لي في الخَلاءِ حِينَ التَقَينا",56,"ن",2,0],["خَلَّت سَبِيلي كَما خَلَّيتُ ذا عُذُرٍ","إِذا رَأَتهُ إِناثُ الخَيلِ تَنتَحِمُ",57,"م",1,0],["خَلَت بَعدَ مَغنى أَهلِها وَتَأَبَّدَت","كَأَن لَم يَكُن لِلحاضِرينَ بِها عَهدُ",58,"د",1,0],["خَلَّت غَليلَ الشَوقِ بَينَ جَوانِحي","قِطَعاً فَعَدَّت كَيفَ كانَ وَدَلَّها",59,"ه",2,0],["خِلتُها في البَيتِ جُنداً","صَفَّقوا حَولي قِياما",60,"م",2,0],["خَلَت وَعَفَت إِلّا إِثافٍ كَأَنَّها","عَوائِدُ ذي سُقمٍ بَطيءٌ قُعودُها",61,"د",3,0],["خَلَت مِن حاجَتي الدُنيا","فَلَيسَ لِوَصلِها سَبَبُ",62,"ب",1,0],["خَلَّتا سوءٍ تَشينانِ الفَتى","حَيثُ ما كانَ الخَنا وَالعَربَدَه",63,"د",2,0],["خِلتَهُ في جَنَباتِ ال","كَأسِ واواتٍ صِغارا",64,"ر",2,0],["خَلَّت قُرَيشٌ لَهُ البَطحاءَ وَاِنصَرَفَت","لَهُ عَنِ السَهلِ حَتّى حازَها الجَبَلُ",65,"ل",1,0],["خَلَت بِغَزالِها وَدَنا عَلَيها","أَراكُ الجِزعِ أَسفَلَ مِن سَنامِ",66,"م",1,0],["خَلَّت سَبيلَ أَتِيٍّ كانَ يَحبِسُهُ","وَرَفَّعَتهُ إِلى السَجفَينِ فَالنَضَدِ",67,"د",1,0],["خِلتُ النُجومَ تُنادي أَنجُموا فِرَقاً","أَوِ السُهى قالَ أَهلُ الأَرضِ ساهونا",68,"ن",2,0],["خلت الدهور وَمَرَّت الأعصارُ","وَاللَيل لَيل وَالنَهار نهارُ",69,"ر",1,1],["خلت حماة بصنع الموت من حسنٍ","أَيَعلَم الموت ماذا في حماة جنى",70,"ن",2,0],["خِلتُها بين محبٍّ وحبيبِ","قُبلةً عند وَداع وسَفرْ",71,"ر",1,0],["خِلْتَها شاهَدَتْ وقائعَ في السّا","لِفِ غَشّتْ سُيوفَها بالعُيوب",72,"ب",1,0],["خلت الممالك دونه والأعصر","وصحا الملوك من الغرور وأقصروا",73,"ر",3,0],["خِلْتُهُ والرُّمْحُ في راحَتِهِ","قَمَراً يَحْمِلُ منه فَرْقَدَا",74,"د",2,0],["خِلْتَهُ جَبَّارَ قَوْمٍ مَرَدُوا","وأَنا في لُطُف الوَعْظِ نَبي",75,"ي",1,0],["خَلَّتِ الأَرْضَ كُلَّهَا لَكِ إِرْثاً","فَامْلِكِي مِلْكَ سَيِّدٍ لِمَسُودِ",76,"د",1,0],["خِلْتُ فِيهَا لِيَ الشفَاءَ فمَا","عُدْتُ إِلاَّ وَالدَّاءُ بِي أَفْشى",77,"ش",2,0],["خلت المرابط من سوابقها","وتثاءبت بحبالها الأُنن",78,"ن",1,0],["خَلَت شُهورٌ وَلَم أَسَل عَن","إِهلالِ شَهرٍ وَلا اِنسِلاخِ",79,"خ",1,0],["خِلتُكَ تَبقى وَحُكم رَبّي","ما لي يَدٌ فيهِ بِاِنفِساخِ",79,"خ",1,0],["خِلْتَ شَمْساً تدورُ في كَفِّ بدرٍ","بين هذا وتيك أهيفُ غصن",80,"ن",1,0],["خلت العهودُ، ف