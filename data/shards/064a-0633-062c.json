{"poems":[[54,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[92,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[255,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[580,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56706","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112828","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140058",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216562",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216550",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131050",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"]],"verses":[["يَسجُدُ الذُلُّ لَهُم","إِن بَدا أَو أَقبَلا",0,"ل",2,0],["يُسجّلُ معركةَ الكائناتِ","مثلِ المُسجّل في مَكتب",1,"ب",1,0],["يَسجُدُ الجُرفُ كلما ركع المَو","جُ فَدأبي هنالك التَّسليمُ",2,"م",1,0],["يَسْجُدُ وجْهي لِسَنَا وجُهِه","فالوجْهُ مِنْه قِبلةُ المسْجِدِ",3,"د",1,0],["يسجدُ لله ليحظى بها","نسك كذوب في هوى صادق",4,"ق",1,0],["يس جاء بأن نهج نبينا النهج","القويم فإن سلكت فتمنح",5,"ح",1,0],["يسجد في حندس الظلام لمن","صور انسانه من العلق",6,"ق",1,0],["يسَجْي الْجَمَالْ الْبَاهِرْ وْيَاه","حَبْتِين خَالْ وْوَردْ فِلَّه",7,"ل",2,0],["يَسْجِنْ بساتينٍ فِيْ الاغتال","كالزِّعْفِران ويوزٍ وزيت",8,"ت",1,0],["يسجدن للرحمن والفتيان قد","سجدوا لأوجههن أي سجود",9,"د",1,0],["يَسجدُ فيهِ البَدرُ لِلّهِ كَما","خَرَّ الكَلِيمُ ساجِداً عِندَ طُوى",10,"ا",1,0]]}