{"poems":[[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[53,"أنت فضل وفضلة الشيء لغو","https://www.aldiwan.net/poem64008.html","الخفيف"],[53,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[34,"صدت بثينة عني أن سعى ساع","https://www.aldiwan.net/poem27806.html","البسيط"],[64,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[82,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[50,"رب غزال كأنه قمر","https://www.aldiwan.net/poem62561.html","المنسرح"],[52,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[92,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[119,"يا مغيثي وعدتي ورجائي","https://www.aldiwan.net/poem41475.html","عموديه"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[302,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[310,"انظر إلى السحر يجري من لواحظه","https://www.aldiwan.net/poem56582.html","البسيط"],[376,"نبئت أنكم تغشون أحلاما","https://www.aldiwan.net/poem57124.html","الوافر"],[396,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[396,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[409,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[415,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[447,"ثم اعتمدنا رمي أول جمرة","https://www.aldiwan.net/poem14327.html","الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[500,"ما كان ليلي ليلا","https://www.aldiwan.net/poem9881.html","المجتث"],[543,"سجنت نفسي بيدي","https://www.aldiwan.net/poem47500.html","عموديه"],[543,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[556,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[563,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[563,"إن للكفر ظلمة في الوجود","https://www.aldiwan.net/poem34652.html","الخفيف"],[572,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38369","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70748","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55935","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90602","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50000","البسيط"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107311","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79854","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104781","البسيط"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45509","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60887","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2486,"","https://poetry.dctabudhabi.ae/diwan/poem/122168","المنسرح"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65968","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58533","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58419","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204652",""],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139966","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3492,"","https://poetry.dctabudhabi.ae/diwan/poem/111587","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91529","المجتث"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36792","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111490","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102732","الكامل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67673","الخفيف"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136426",""],[4767,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=179435",""],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""],[5285,"أنشودة حب","https://www.poetsgate.com/ViewPoem.aspx?id=204395",""],[4372,"ما أَعجَبَ الحُبَّ في مَذاهِبِه","https://www.poetsgate.com/ViewPoem.aspx?id=86430",""],[5881,"وصبرت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183808",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""]],"verses":[["ثُمَّ اِعتَبِر بِثَناءِ رَه","طِكَ إِذ ثَوى جَدثاً جَنينا",0,"ن",2,0],["ثم أُعرِجْتَ فاحتواك انتقاصٌ","في است سوءٍ وجسم سوء ضرير",1,"ر",1,0],["ثم أعدَّتْ كَسْبَها المحبَّسا","فادَّخرتْ مِنه الرغيبَ المنْفِسا",2,"س",2,0],["ثم اعتدَى فإذا هُوْ ضَيْغَمُ غابةٍ","وزهاه من فَرْطِ الجهالة زاهي",3,"ه",2,0],["ثُمَّ اِعلَمي أَنَّ ما اِستَودَعتِني ثِقَةً","يُمسي وَيُصبِحُ عِندَ الحافِظِ الواعي",4,"ع",2,0],["ثم اعقد الدهن بماء البحرِ","فإنه صابون هذا الأمرِ",5,"ر",1,0],["ثُمَّ اعتَبَرتُ هدايةً زَمني","فإذا تَصَرّفُهُ عليَّ ولي",6,"ل",2,0],["ثم اعتلى ظَهْرَ البعيرِ وقال سِرْ","لا كانَ ذا الوادي المُروِّعُ واديا",7,"ي",2,0],["ثُمَّ اِعتَنَقنا وَظَلتُ أَلثُمُهُ","وَثَغرُهُ مِثلُ ساقِطِ البَرَدِ",8,"د",1,0],["ثُمَّ اِعتَذَرتَ مِنَ الصُدو","دِ فَما سَخِطتُ وَما اِرتَضَيتُه",9,"ت",2,0],["ثُمَّ اعْلمِي أَنَّكِ إِنْ تُجْمِعِي","طَالِبَةً أَقْصى المُنى تَظْفَرِي",10,"ر",2,0],["ثم اعطفِ الذكْرَى إلى جهةٍ","أُخرى تُرعْ بعوالِمٍ أُخَر",11,"ر",1,0],["ثم اعطيته كتابا عززا","معجزا مبرزا شؤن السماء",12,"ا",2,0],["ثم اعتلقت جريرا فيه ذا هوج","من الأباعر في متيه تحصيد",13,"د",1,0],["ثُمَّ أَعطى قِيادَهُ","وَزنُها فيكَ فَاِتَّزَن",14,"ن",1,0],["ثمَّ اِعتنَقنا وهي مُغضِيَةٌ","عنّي وَبات وِسادها زَندي",15,"د",2,0],["ثمّ اِعذرنّ خليعاً في محبّته","وَاِعجب لقلبِ اِمرئٍ من حبّه ناجِ",16,"ج",1,0],["ثم اعتَمَدتُ عَلى عِلمي ببُخلِكُمُ","وكنتُ بالأمرِ دُونَ النَّاسِ عَلاما",17,"م",2,0],["ثم اعلموا أن صلاح القلب","أن لا يحب الشخص غير الرب",18,"ب",1,0],["ثم اعتقد إن رب العرش محصى الرمال","موجود بل موجد الأشيا ولا له زوال",19,"ل",1,0],["ثم أعطاه بها رايته","بعد أن بشر بالفتح عشيا",20,"ي",2,0],["ثم أعطاك ما تريد كما شا","ء فأنت العزيز في سلطانك",21,"ك",1,0],["ثمّ اعتَرَتْنِيَ أشواقٌ تُجَهِّلُنِي","كيفَ اطمأنَّتْ بِقَلْبي بعدَك الحالُ",22,"ل",1,0],["ثم اعتمدنا رمي أول جمرةٍ","قبل النزول وقبل صنع الأبديه",23,"ي",2,1],["ثم اعتمدنا زائرين محمداً","في طيبة ولنا بذاك التهنيه",23,"ي",2,0],["ثم اعتمدنا زائرين محمداً","في طيبةٍ طابت واسعد فالها",24,"ل",3,0],["ثم اعتنقنا عناقاً","يصيّر الشفع وترا",25,"ر",2,0],["ثُم أعُود ثَانيا","أجلُس فوقَ مَقعَدِي",26,"ي",1,0],["ثُمَّ اعتصمتَ بِحَبلِ رَبِّكَ مُوقِناً","أنَّ الجَزَاءَ يَكونُ بِالرِّضوانِ",27,"ن",1,0],["ثمّ أعطاك في الأعزّ وفي الأش","رفِ ذاك الرّجاءَ والتّأميلا",28,"ل",2,0],["ثم اعتنى عثمانْ","في هذه السنَّهْ",29,"ه",1,0],["ثم أعمالهم بدت كسراب","حسبوه المياه في الأخدود",30,"د",1,0],["ثم اعْتَذَرْتُ فَشَكَرْ","ثم نَشَجْتُ فَزَفَرْ",31,"ر",1,0],["ثم أعود بعد في أصحابي","فأثبت الحق على الصواب",32,"ب",1,0],["ثمَّ اِعتَنِقْ فيها عَرائسَ زهرها","وَتَجاهرنَّ على عيونِ النرجسِ",33,"س",1,0],["ثم اعْتنقْنا وبنتُ الكرمِ ثالثُنا","لأن شُربَ الحمَّيا يُذهب التّرَحا",34,"ح",2,0],["ثم اعتمد تقليبهُ بالفرد","من شعرة توذي وخيطٍ يردي",35,"ي",1,0],["ثم اعطه من الدخان المعلمِ","كفاية من بعد سحق محكمِ",36,"م",1,0],["ثم اعتزمتُ ولم أحفِل بِبَنهم","وابتِ النفسُ عن فضلِ وحَمّاد",37,"د",1,0],["ثم اعترضت لها باللّهو عند هوىً","مني فقلت لها بيني بتطليقِ",38,"ق",1,0],["ثم اعتَنَقنا راشفاً من ثغرِهِ","كأساً أَلَذَّ من المدامةِ مُترَعا",39,"ع",2,0],["ثم أعيى وحطَّه النقص عجزاً","أن يساوي بقدره لك قدر",40,"ر",1,0],["ثم أعطى يد الذي صارم الدي","ن ولولا أعطائها لبراها",41,"ا",3,0],["ثُمَّ اعتَقِد يا اُخِّي أَنَّ قَلبَكَ هُو","إنسانُ نَصّ أَتَى فِى عَينِ سُورَتِنا",42,"ن",2,0],["ثُمَّ اِعتَمَدتُ إِلى اِبنِ لَيلى تَختَوي","مِن دونِهِ مُتَباعدَ البُلدانِ",43,"ن",1,0],["ثم أعتلَلْتِ وقُلْتِ أدّبَني أبي","يا ليتَ لم يخلق لغانية أبُ",44,"ب",1,0],["ثم أعادوهُ إليها ثالثا","وجرَّعوا القاهر هذا الكارثا",45,"ث",2,0],["ثم اعلَمَن إن أردتَ ضَيمَ بَنِي","زَيدٍ فإنِّي ومَن له الحَلِفُ",46,"ف",1,0],["ثم أعددن لي مكاناً علياً","ينجلي فيه صدرهُ المكروب",47,"ب",1,0],["ثم اعترف لأبي بكر فضيلته","ذاك الفتى الماجد ابن الماجد الأنف",48,"ف",1,0],["ثم اعلمن أن برهان البقا","بعين ذا الدليل قد تعلقا",49,"ق",2,0],["ثم اعلمن أن صدق الرسل","برهانه وافى بهي الحلل",49,"ل",1,0],["ثمَّ أُعيدَ أَحمد للحُكمِ","ثمَّ ابنُ وهب فاستمعَ لنظمي",50,"ي",1,0],["ثمَّ أعيدَِ ابنُ أبي كَدينه","لمّا ارتضوا سيرتَهُ ودينَه",50,"ه",1,0],["ثمُ أعيدَِ يوسف السنجاري","ثمَّ تلاه التاجُ ذو الفخار",50,"ر",1,0],["ثمَّ أُعيدَ ابن رُزَينَ فحكم","من بعد صدر الدين عدلاً في الأمم",50,"م",1,0],["ثمَّ اعتنقنا واصطلحنا وقد","فَرْزَنَ منه بيذَق النّهدِ",51,"د",1,0],["ثم أعيد ما اشتهت","نفسي من ألعابها",52,"ب",3,0],["ثم أعود نحوها","امرح في جلبابها",52,"ب",3,0],["ثُمَّ أَعْطَيْتُموني فيهِ ذِماما","فَاقْتَرَفْتُمْ خَطيئَةً وَآثاما",53,"م",2,0],["ثم اعترضنا البحرُ وهو كأنه","مَلكُ تقدّم بالجيوش لمرصدِ",54,"د",1,0],["ثم اعتذر مقصراً لن تدركَهْ","كيف تفي مدح وزيرِ الملكهْ",55,"ه",1,0],["ثم اعتنقنا فترانا معا","في ظلمة العتب ونور العتاب",56,"ب",1,0],["ثم اعتنقنا طَويلاً","يا ليتَه قَد أَطاله",57,"ل",2,0],["ثُمَّ أَعطى كاتِبَ الأَف","لاك سَهماً مِن ذَكاكا",58,"ك",2,0],["ثم اعتلى وصاح ألقوا لي في","إليون ذا السلاح يسمو شرفي",59,"ي",1,0],["ثُمَّ اعتَلَى وَالخَيلَ ساط فَطُيِرَت","لِلقَومِ يَحمِلُها الطرِيقُ المَهيَعُ",60,"ع",1,0],["ثم اعتراها من سلوى شبهة","من وقد وجد بالحشا يتأجج",61,"ج",1,0],["ثم أعطى عطيّةً تُشبِهُ","الحرمان لم يُعطها بِوَجْه طليق",62,"ق",1,0],["ثم أعطاه مقاماً عالياً","مع كل الأهل في دار السعاده",63,"د",2,0],["ثم أعطتني دروساً","من علوم نافعات",64,"ت",1,0],["ثمّ اعمد الحجر المبا","رك فيه واستلم استلاما",65,"م",2,0],["ثم اعتلى البطلُ العظيمُ منصةً","كي يسحقَ الشرَ المقيمَ ودابرَهْ",66,"ر",2,0],["ثُمَّ أَعادَت عَلَيهِ ثانِيَةً","فَثَبَّتَ الحُسنَ كَفُّ ساكِبِه",67,"ب",2,0],["ثم اعتذرت لها فكنت كأنني","أرجعت قلبي بعد طول غياب",68,"ب",1,1],["ثم اعتلَتْ عرشَ الفخارِ وأطرقتْ","لترى ربيعَ عطائها الفينانِ",69,"ن",1,0]]}