{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[93,"راعنا خطبهم وكان جسيماً","https://www.aldiwan.net/poem11370.html","الخفيف"],[37,"أو روايا التؤام في المهمه القفر","https://www.aldiwan.net/poem7062.html","الخفيف"],[72,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[87,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21051","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[212,"يا قطار الزيتون أنت قطار","https://www.aldiwan.net/poem46239.html","الخفيف"],[212,"بعد عامين من صدود وحيف","https://www.aldiwan.net/poem46291.html","الخفيف"],[257,"من شروط الصبوح في المهرجان","https://www.aldiwan.net/poem48463.html","الخفيف"],[298,"صاح إن جزت بذي الأثل فحي","https://www.aldiwan.net/poem33082.html","الرمل"],[298,"ذكر الخيف والحمى وحجونه","https://www.aldiwan.net/poem33144.html","الخفيف"],[299,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[372,"طال شغل القصائد","https://www.aldiwan.net/poem57495.html","مجزوء الخفيف"],[381,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[395,"القصر والكوخ","https://www.aldiwan.net/poem24308.html","عموديه"],[406,"كل صعود إلى هبوط","https://www.aldiwan.net/poem49991.html","مخلع البسيط"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[459,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[465,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[576,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"]],"verses":[["كُلُّ صِلٍّ يَبيتُ في","مَربَإِ النَجمِ رابِيا",0,"ي",2,0],["كُلُّ صَدرٍ بِالعَوالي","يُسمِعُ الطَعنُ شَهيقَه",1,"ق",2,0],["كُلْ صُدُوراً وَانْهَشْ كُلىً وَتَفَكَّهْ","بِعُيُونٍ وَاشْرَبْ نُهىً وَحُلُومَا",2,"م",2,0],["كل صاد كأن بالجلد منه","حصفاً أو تخاله مجدورا",3,"ر",2,0],["كلّ صبحٍ يروم بالبردِ ذبحي","فلهذا يقول الله أكبر",4,"ر",1,0],["كل صبر كان في الناس طُرّاً","كلفة والصبر فيه طباع",5,"ع",1,0],["كُلُّ صافي الفِرِندِ بِالماءِ رَيّا","نِ وَلَكِنَّهُ إِلى الدَمِ صادي",6,"د",2,0],["كُلُّ صَعْبٍ سِوَى الْمَذَلَّةِ سَهْلُ","وَحَيَاةُ الْكَرِيمِ فِي الضَّيْمِ قَتْلُ",7,"ل",1,1],["كُلُّ صَعلٍ كأَنَّما شَقَّ فيهِ","سَعَفَ الشَّريِ شَفرتَا مِقراضِ",8,"ض",1,1],["كُلُّ صَرْحٍ عَلاَ فَقصَّرَ عَنْهُ","مَا عَليْهِ مَعَرَّةٌ فِي الْقُصُورِ",9,"ر",1,0],["كلُّ صَدْرٍ به أَنينٌ وَوَجْدٌ","مُرْسِلٌ خَلْفَه أنِيناً ووَجْدا",10,"د",2,0],["كلُّ صَحْبي يشكون شكوايَ لكنْ","ربّما يضحكونِ خُسْراً وغَبنْا",11,"ن",2,0],["كل صبح أصغى إليك بقلبي","لأرى ما استجد من أحلامي",12,"م",2,0],["كل صحوٍ من الهوى سوف يمسى","في رحيق الأشواق بعد زمان",13,"ن",1,0],["كل صوتٍ من اقتراحات إسحا","ق التي زينت كتاب الأغاني",14,"ن",2,0],["كُلُّ صَبٍّ في الهَوى ما لَم يكن","سَمِحاً بالروح لم يَسمَح بشَي",15,"ي",1,0],["كُلُّ صبٍّ إذا تذكَّرَ يوماً","هَيَّج الذكرُ وجدَه وشجونَه",16,"ن",2,0],["كلُّ صعبٍ فهو بالرقص يهونْ","وعسيرُ الأَمر فيه كاليسيرِ",17,"ر",1,0],["كلُّ صنفٍ من الندى","إن مضى غيرُ عائدِ",18,"د",1,0],["كُل صَنف مِن الجُلود كَخَلط","أَن تَعدى فحسمهُ بِالدَواءِ",19,"ا",2,0],["كلّ صيف يسقي البساتين تحت الش","مس والقصر هاجع وسنان",20,"ن",1,0],["كُلُّ صُعودٍ إلى هُبوطِ","كُلُّ نفَاقٍ إلى كَسادِ",21,"د",1,1],["كل صبّ يرى كتاب حبيب","بعد بعد كأنّه شام لامه",22,"م",2,0],["كلّ صباحٍ شمسُ إقبالك في","فُتوقهِ مفتنةٌ شمسَ الأبدْ",23,"د",1,0],["كلُّ صباحٍ واجهتْك شمسُهُ","عيدٌ وكلُّ ليلةٍ ليلُ مِنَي",24,"ي",1,0],["كلُّ صفراءَ للبلى قلبها","نارٌ تلظّى وجسمها من دمع",25,"ع",1,0],["كُلُّ صُقْع دعه وسَافِر لِنادي","ه فَمَثوى النَّدى بذاك الصُّقْع",26,"ع",1,0]]}