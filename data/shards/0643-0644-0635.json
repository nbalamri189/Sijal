{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[95,"راعنا خطبهم وكان جسيماً","https://www.aldiwan.net/poem11370.html","الخفيف"],[39,"أو روايا التؤام في المهمه القفر","https://www.aldiwan.net/poem7062.html","الخفيف"],[74,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[53,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[68,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[89,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21051","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[215,"يا قطار الزيتون أنت قطار","https://www.aldiwan.net/poem46239.html","الخفيف"],[215,"بعد عامين من صدود وحيف","https://www.aldiwan.net/poem46291.html","الخفيف"],[261,"من شروط الصبوح في المهرجان","https://www.aldiwan.net/poem48463.html","الخفيف"],[302,"صاح إن جزت بذي الأثل فحي","https://www.aldiwan.net/poem33082.html","الرمل"],[302,"ذكر الخيف والحمى وحجونه","https://www.aldiwan.net/poem33144.html","الخفيف"],[303,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[376,"طال شغل القصائد","https://www.aldiwan.net/poem57495.html","مجزوء الخفيف"],[385,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[399,"القصر والكوخ","https://www.aldiwan.net/poem24308.html","عموديه"],[411,"كل صعود إلى هبوط","https://www.aldiwan.net/poem49991.html","مخلع البسيط"],[435,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[463,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[580,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64286","المنسرح"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129536","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31627","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109116","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95563","الخفيف"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105870","الرجز"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71051","الخفيف"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143009","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77287","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121183","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137117",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141193","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100253","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58413","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58518","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65347","الخفيف"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121648","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74044","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62919","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129414","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66438","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92030","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205894","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114568","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70061","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105527","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101312","الخفيف"],[4755,"ضَيَّعَ الفَجرُ وَجْهَهُ واتّجَاهَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=183863",""],[4759,"المساء الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=204144",""],[4929,"الموت القادم من الصين","https://www.poetsgate.com/ViewPoem.aspx?id=211016",""],[4935,"صبح الله بخير حضرتك","https://www.poetsgate.com/ViewPoem.aspx?id=129532",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5464,"سيدة النساء","https://www.poetsgate.com/ViewPoem.aspx?id=53584",""],[5573,"بشت الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=200323",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5956,"زارعُ الأشجار","https://www.poetsgate.com/ViewPoem.aspx?id=183141",""],[5956,"تضحيات وشهادات","https://www.poetsgate.com/ViewPoem.aspx?id=192314",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6251,"الهديل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76469&r=&rc=9",""]],"verses":[["كُلُّ صِلٍّ يَبيتُ في","مَربَإِ النَجمِ رابِيا",0,"ي",2,0],["كُلُّ صَدرٍ بِالعَوالي","يُسمِعُ الطَعنُ شَهيقَه",1,"ق",2,0],["كُلْ صُدُوراً وَانْهَشْ كُلىً وَتَفَكَّهْ","بِعُيُونٍ وَاشْرَبْ نُهىً وَحُلُومَا",2,"م",2,0],["كل صاد كأن بالجلد منه","حصفاً أو تخاله مجدورا",3,"ر",2,0],["كلّ صبحٍ يروم بالبردِ ذبحي","فلهذا يقول الله أكبر",4,"ر",1,0],["كل صبر كان في الناس طُرّاً","كلفة والصبر فيه طباع",5,"ع",1,0],["كُلُّ صافي الفِرِندِ بِالماءِ رَيّا","نِ وَلَكِنَّهُ إِلى الدَمِ صادي",6,"د",2,0],["كُلُّ صَعْبٍ سِوَى الْمَذَلَّةِ سَهْلُ","وَحَيَاةُ الْكَرِيمِ فِي الضَّيْمِ قَتْلُ",7,"ل",1,1],["كُلُّ صَعلٍ كأَنَّما شَقَّ فيهِ","سَعَفَ الشَّريِ شَفرتَا مِقراضِ",8,"ض",1,1],["كُلُّ صَرْحٍ عَلاَ فَقصَّرَ عَنْهُ","مَا عَليْهِ مَعَرَّةٌ فِي الْقُصُورِ",9,"ر",1,0],["كلُّ صَدْرٍ به أَنينٌ وَوَجْدٌ","مُرْسِلٌ خَلْفَه أنِيناً ووَجْدا",10,"د",2,0],["كلُّ صَحْبي يشكون شكوايَ لكنْ","ربّما يضحكونِ خُسْراً وغَبنْا",11,"ن",2,0],["كل صبح أصغى إليك بقلبي","لأرى ما استجد من أحلامي",12,"م",2,0],["كل صحوٍ من الهوى سوف يمسى","في رحيق الأشواق بعد زمان",13,"ن",1,0],["كل صوتٍ من اقتراحات إسحا","ق التي زينت كتاب الأغاني",14,"ن",2,0],["كُلُّ صَبٍّ في الهَوى ما لَم يكن","سَمِحاً بالروح لم يَسمَح بشَي",15,"ي",1,0],["كُلُّ صبٍّ إذا تذكَّرَ يوماً","هَيَّج الذكرُ وجدَه وشجونَه",16,"ن",2,0],["كلُّ صعبٍ فهو بالرقص يهونْ","وعسيرُ الأَمر فيه كاليسيرِ",17,"ر",1,0],["كلُّ صنفٍ من الندى","إن مضى غيرُ عائدِ",18,"د",1,0],["كُل صَنف مِن الجُلود كَخَلط","أَن تَعدى فحسمهُ بِالدَواءِ",19,"ا",2,0],["كلّ صيف يسقي البساتين تحت الش","مس والقصر هاجع وسنان",20,"ن",1,0],["كُلُّ صُعودٍ إلى هُبوطِ","كُلُّ نفَاقٍ إلى كَسادِ",21,"د",1,1],["كل صبّ يرى كتاب حبيب","بعد بعد كأنّه شام لامه",22,"م",2,0],["كلّ صباحٍ شمسُ إقبالك في","فُتوقهِ مفتنةٌ شمسَ الأبدْ",23,"د",1,0],["كلُّ صباحٍ واجهتْك شمسُهُ","عيدٌ وكلُّ ليلةٍ ليلُ مِنَي",24,"ي",1,0],["كلُّ صفراءَ للبلى قلبها","نارٌ تلظّى وجسمها من دمع",25,"ع",1,0],["كُلُّ صُقْع دعه وسَافِر لِنادي","ه فَمَثوى النَّدى بذاك الصُّقْع",26,"ع",1,0],["كلُّ صِفاتِ الجَمالِ مُجْمَلَةً","بينَ تَفَاريقها وجُمْلَتِها",27,"ه",2,1],["كل صعب يهون ان أنعم اللَه","على عبده بحسن الختام",28,"م",1,0],["كل صديق لك أو قريب","يود أن تموت عن قريب",29,"ب",1,0],["كُلِّ صَلْبِ العِظامِ والل","لَحْمِ رَطْبِ المَفاصِلِ",30,"ل",1,0],["كل صقع في الأرض ينفعني","طاب لي في ربوعه السكن",31,"ن",1,1],["كل صقع أحَسَّ بالرزء فيه","فكأنى بكل صقع درينُ",32,"ن",1,0],["كلُّ صبغٍ يعزى إلى","لونه قيل فُستقي",33,"ق",2,0],["كلّ صافِي اليقين مُوفٍ بما عا","هَدَ الله مُخْلِصِ الإِيمان",34,"ن",1,0],["كل صديق حيث تلمحه","أين الصديق أحبه حتما؟",35,"م",2,0],["كُلُّ صَبٍّ يُعَلِّلُ النَفسَ بِالقُب","لَةِ يَومَ النَوى وَيَومَ التَلاقي",36,"ق",2,0],["كل صبح مبارك عبد مولى","وجهه الشمس والصباح الجبين",37,"ن",1,0],["كُل صرح يَضم بيضة خدر","مثلما ضمَّ عرشُها بلقيسا",38,"س",2,0],["كل صرح مهما استطال بناء","سوف يشكو تصدعا وانهداما",39,"م",2,0],["كل صبح مع مساء لا تزال","مع دواعي النفس في قيل وقال",40,"ل",1,0],["كل صنع مصور في الوجود","هو صنع المصوِّرِ الموجود",41,"د",1,1],["كُلُّ صَفْعِ يكونُ عقباهُ نفعٌ","فالقفا لو سَلَحْتُه ما أُبالي",42,"ل",2,0],["كلُّ صَعْبٍ على رِضاكُمْ يهونُ","وَجُنوني بِمَنْ هَوَيتْ فُنونُ",43,"ن",1,1],["كلُّ صبّ من طرفه حين يصبو","ذا طريحٌ بها وهذا طعينُ",44,"ن",1,0],["كل صيتٍ أحرزته فضل صيتي","في ذمامي بيقظة ومبيتي",45,"ي",1,0],["كلُّ صَدٍ إن لم يكنْ عن مَلالٍ","فهْو وَصْلٌ به الرَّقِيبُ تَعَنَّى",46,"ن",2,0],["كلّ صبحٍ نَرى وكلّ مَساء","عظةً تَبعث الهُدى واِعتِبارا",47,"ر",2,0],["كل صقيلٍ كشعاعٍ الايا","أو كوميضِ البارقِ الذائِبِ",48,"ب",1,0],["كُل صَفي لعز الدين مُستَبق","أَحسَن بِتَوجيه مَدحي في تَقيهم",49,"م",1,0],["كل صب تركته فهو مضنى","وهو باق وصبره غير باق",50,"ق",1,0],["كل صبٍّ فإنّ في أُذنيه","عن سماع الملام في الحبّ وقرا",51,"ر",2,0],["كل صَفو مع الحياة يُكدَّرْ","والنعيم المَوهوب قدْرٌ يُقدَّرْ",52,"ر",1,1],["كل صوت يطيف بالسمع منه","ثابت في اسطوانة تتكررْ",53,"ر",1,0],["كُلُّ صَعبٍ في هَواك","لَذَّ لي إلا نواك",54,"ك",1,0],["كل صادٍ مِنهُ يَروي غلَّهُ","وَبِنادي الفضل يبدي فضلهُ",55,"ه",1,0],["كل صفات الكمال فيه","ومنه تسرى لمن تسر",56,"ر",1,0],["كل صرحٍ بها إذا نظرته ال","عين خالته لجةً من نضار",57,"ر",1,0],["كل صنوف الخلق محتاج له","وهو الغني المنشئ الأزمان",58,"ن",1,0],["كل صقع أنار لي من سناكا","ظاهرى باطنى معاً مأواكا",59,"ك",2,0],["كُلُّ صَوتٍ سَمِعتُهُ يَومَ طالَت:","ذَلَّ شَعبٌ لِجاهِلٍ باعَ جاهَهْ",60,"ا",3,0],["كل صوت لشاعر يتغنى","كل لحن يذوب فيه الكلام",61,"م",1,0],["كلِصٍّ لا يُحَسُ بهِ وُلُوجاً","ويُعْرَفُ بعدَ تحقِيقِ المَرَامِ",62,"م",1,0],["كل صبح دمت ممنوح الرضا","بنوال ظل يولي نعمتك",63,"ك",1,0],["كلُّ صَبٍّ صارَ يُبدي شَوقَهُ","مِن وصالي كنتُ أُرضي نَزوَتي",64,"ت",2,0],["كلَّ صبحٍ تفيضُ دمعةُ عينٍ","تُلهبُ القلبَ أن يَمدَّ جِواره",65,"ر",2,0],["كلَّ صباح ٍ ولنا مَولِدٌ","وكلَّ ليل ٍ ولنا مهْرجانْ",66,"ن",1,0],["كل صانع ترى قدرته واضحه بينه فالصنيع","هذي الارض منهو لها يرسل المزن بعد الجفاف",67,"ف",1,0],["كل ٌ صغيرٌ إذا ما مسهُ خطرٌ","كُلٌ صغيرٌ إذا ما مسّهُ الكِبَرُ",68,"ر",1,0],["كلَّ صبح أغسل العينين فيها","ومع القهوة صبحاً أجتنيها",69,"ي",3,0],["كل صنديد فدائيٍّ شهيدٍ","في جنان الخلد يشدو طرِبا",70,"ب",2,0],["كُلُ ّصُبْحٍ فِي نَحِيبٍ مِنْ عَزَاءٍ","أًُمّةٌ نَاخََتْ ، وَتَرْجُو الأَوَلينَا",71,"ن",2,0],["كُلُّ صَرْحٍ فِي عُيوْنِِ الدّهْرِ يَزْهُو","حِيْنَ أَضْحَى فِيْ زَمَانٍ فَاتِحِينَا",71,"ن",2,0],["كُلُّ صَمتِ عَلَى المَجازِرِ كُفرٌ","وَ الخِياناتُ أُمَّهاتُ الكَبائِرْ",72,"ر",1,0],["كُلُّ صِدْقِي هُوَ الهَوَى وإذَا قُلْتُ","بِغَيْرِ الهَوَى فَذَلِكَ كِذْبِي",73,"ب",2,0]]}