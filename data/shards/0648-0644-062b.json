{"poems":[[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"قبلته عند النوى فتمررت","https://www.aldiwan.net/poem20533.html","الكامل"],[70,"يا غائبا أهدى محاسنه","https://www.aldiwan.net/poem42819.html","مجزوء الكامل"],[70,"ياقاتلي أوما كفى","https://www.aldiwan.net/poem42862.html","مجزوء الكامل"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[74,"ورداء ليل بات فيه معانقي","https://www.aldiwan.net/poem12817.html","الكامل"],[74,"يانشر عرف الروضة الغناء","https://www.aldiwan.net/poem12828.html","الكامل"],[74,"ومقنع بخلا بنضرة حسنه","https://www.aldiwan.net/poem13241.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42577","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142164","الخفيف"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[96,"عاشق الزّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66349&r=&rc=25",""],[107,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[115,"جزائري","https://www.aldiwan.net/poem24036.html","الكامل"],[164,"ضربوا بمنعرج اللواء سرادقا","https://www.aldiwan.net/poem47021.html","الكامل"],[195,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[196,"يا رب يوم واضح نضرته","https://www.aldiwan.net/poem51970.html","الكامل"],[219,"أرخصت يوم فراقك الدمعا","https://www.aldiwan.net/poem55275.html","أحذ الكامل"],[227,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[227,"يا كانيا عن دمعه","https://www.aldiwan.net/poem50932.html","مجزوء الكامل"],[235,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[351,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[362,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[400,"قرت العين ببشرى","https://www.aldiwan.net/poem33920.html","مجزوء الرمل"],[400,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[403,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[403,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[406,"واها لليل خلتني من طيبه","https://www.aldiwan.net/poem32590.html","الكامل"],[413,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[426,"ورد الكتاب مصرحا ومسطرا","https://www.aldiwan.net/poem41038.html","الكامل"],[429,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[513,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[573,"ومخيم بين الحشا وشغافه","https://www.aldiwan.net/poem2911.html","الكامل"],[573,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[573,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"]],"verses":[["وَلِثَغْرِهَا عِنْدَ ابْتِسَامِ أَقَاحِهِ","بَرْقٌ تَألَّقَ فِي سَنَا وَجَنَاتِهَا",0,"ت",3,0],["ولثم حصىً لتربتِهِ ذكيّ","كأنَّ شذاه في نفسي كباء",1,"ا",2,0],["ولثّمه المداد لثامَ ليلٍ","فأسفر عن سنا صبحٍ منير",2,"ر",1,0],["ولثمته عند القدوم فحبذا","رطب الشفاه السكريّ بلا نوى",3,"و",2,0],["وَلَثَمتُ إِكراماً لَهُ","وَجهَ الرَسولِ وَكَفَّهُ",4,"ف",2,0],["وَلَثَمتُهُ في خَدِّهِ","فَعَدَدتُ أَلفاً أَو يُناهِز",5,"ز",1,0],["وَلَثمِ مُضَعَّفِ الأَجفانِ ساجٍ","بِمُطلَقِ حُسنِهِ لِلقَلبِ ساجِن",6,"ن",1,0],["وَلَثَمتُ في ظَلماءِ لَيلَةِ وَفرَةٍ","شَفَقاً هُناكَ لِوَجنَةٍ حَمراءِ",7,"ا",2,0],["وَلَثَمتُ ظَهرَ يَدٍ تَنَدّى حُرَّةً","فَكَأَنَّني قَبَّلتُ وَجهَ سَماءِ",8,"ا",2,0],["وَلَثَمتُ حُمرَةَ وَجنَةٍ تَندى حَياً","فَكَرَعتُ في بَردٍ بِها وَسَلامِ",9,"م",1,0],["وَلَثْمٍ تَوَالَى إِثْرَ لَثْمٍ بِثَغْرِهَا","كَما شَافَهَ الْبازِي عَلَى ظَمَأٍ وِرْدَا",10,"د",2,0],["ولثمنا حذاء شارون حتى","صاح مهلاَ قطعتموني الحذاءُ",11,"ا",2,0],["ولثمت تربَتَهُ كما","لثموا، وإن لم أعتد",12,"د",1,0],["ولِثغرها عندَ ابتسامِ أقاحِهِ","بدرٌ تألق في سنا وجَناتها",13,"ت",3,0],["ولثم النّور في سنابله","مصفقا للنّسيم جذلانا",14,"ن",2,0],["وَلَثمت الثَغور فيها أَقاحاً","وَهَصرت القُدود غُصناً فَغُصنا",15,"ن",2,0],["ولَثَوْرَةُ الأَوراسِ أَكْمَلُ عبرةٍ","فَبِأَيِّ شَرْعٍ أَنْحَنِي لِلجائِرِ؟",16,"ر",1,0],["ولثمتُ مَبسمَهُ اللذيذَ وراقَني","رَشْفُ الرُّضابِ فذقتُ رِيقاً رائِقا",17,"ق",2,0],["ولَثمتُهُ وبثَثتهُ","شَكوايَ همساً من حذارِ",18,"ر",1,0],["ولثمتُ من خَدَّيْ أغرّ مهفهفٍ","شفَقين حُفَّ سَناهما بصباح",19,"ح",1,0],["ولثمت منها الثغر مكترثاً","فوجدته لمسرتي نبعا",20,"ع",2,0],["ولُثْنَ أَردِيَةَ الْوَشِي الرِّقاقَ علَى","قَناً تَمِيلُ بِكُثْبانٍ وتَعْتَدِلُ",21,"ل",1,0],["ولثمت لؤلؤَ ثَغْره","مترشّفاً خمراً وريقا",22,"ق",2,0],["وَلَثْمِ خَدٍّ لِوَرْدٍ","وَرَشْفِ خِلْفٍ لِقِطْفِ",23,"ف",1,0],["ولثغرِ الكَأس مِن فَمهِ","بِحباب الدُرِّ تَنضيدُ",24,"د",1,0],["ولثَمتُ الجميعَ قَطْعاً لِشَكّي","وكذا يَفعَلُ الّذي يتَحَرّى",25,"ر",2,0],["ولثمنا منه كفاً","قد غدت للجود بحرا",26,"ر",2,0],["ولثمت أقدام النسيم ومن","إجلاله لم ألْثُمِ الأيدي",27,"ي",1,0],["وَلِثَغرِها من ضَوءِ بَرقٍ لامِعٍ","لَو أَتبعته لَنا بِصَوب غَمامِ",28,"م",1,0],["ولثمن نَوّار الأَقاحي غدوة","بِأَلَذ في الأَفواهِ مِنه وَأَعذَبِ",29,"ب",1,0],["ولثمتُ ثَغراً لو تألَّق في دُجىً","أغنى المَحولَ عن الغَمامِ الماطرِ",30,"ر",1,0],["ولثمنا يدي عظيم قريب","من عظيم تعدَّه للعظائم",31,"م",1,0],["ولثمت محياه فاشرق ثغره","ورشفت كاسا من لماه معطرا",32,"ر",2,0],["ولثغرِ الإسكندريّةِ منه","في العُلى لا لغيره آثارُ",33,"ر",1,0],["ولثمت راحته التي قسمت بها","معلومة الآجال والأرزاق",34,"ق",1,0],["ولثمْتُ سالِفتيْهِ لثْماً لم يكُنْ","لولا وَسَاطةُ سُكرِهِ بِسُلافِهِ",35,"ف",2,0],["ولثمتُ تَحْتَ العَيْنِ من شَغَفِي","بالعين أَو صَيَّرْتُ فيه أَثَر",36,"ر",1,0],["ولَثَمْتُ فوق لِوَى","الثَّنيّة بالِّلوَى بَسَّامَها",37,"م",3,0]]}