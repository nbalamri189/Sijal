{"poems":[[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"قبلته عند النوى فتمررت","https://www.aldiwan.net/poem20533.html","الكامل"],[70,"يا غائبا أهدى محاسنه","https://www.aldiwan.net/poem42819.html","مجزوء الكامل"],[70,"ياقاتلي أوما كفى","https://www.aldiwan.net/poem42862.html","مجزوء الكامل"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[74,"ورداء ليل بات فيه معانقي","https://www.aldiwan.net/poem12817.html","الكامل"],[74,"يانشر عرف الروضة الغناء","https://www.aldiwan.net/poem12828.html","الكامل"],[74,"ومقنع بخلا بنضرة حسنه","https://www.aldiwan.net/poem13241.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42577","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142164","الخفيف"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[77,"نبِّهْ نديمك للصَّبوح وهاتِها","https://www.poetsgate.com/ViewPoem.aspx?id=33816",""],[96,"عاشق الزّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66349&r=&rc=25",""]],"verses":[["وَلِثَغْرِهَا عِنْدَ ابْتِسَامِ أَقَاحِهِ","بَرْقٌ تَألَّقَ فِي سَنَا وَجَنَاتِهَا",0,"ت",3,0],["ولثم حصىً لتربتِهِ ذكيّ","كأنَّ شذاه في نفسي كباء",1,"ا",2,0],["ولثّمه المداد لثامَ ليلٍ","فأسفر عن سنا صبحٍ منير",2,"ر",1,0],["ولثمته عند القدوم فحبذا","رطب الشفاه السكريّ بلا نوى",3,"و",2,0],["وَلَثَمتُ إِكراماً لَهُ","وَجهَ الرَسولِ وَكَفَّهُ",4,"ف",2,0],["وَلَثَمتُهُ في خَدِّهِ","فَعَدَدتُ أَلفاً أَو يُناهِز",5,"ز",1,0],["وَلَثمِ مُضَعَّفِ الأَجفانِ ساجٍ","بِمُطلَقِ حُسنِهِ لِلقَلبِ ساجِن",6,"ن",1,0],["وَلَثَمتُ في ظَلماءِ لَيلَةِ وَفرَةٍ","شَفَقاً هُناكَ لِوَجنَةٍ حَمراءِ",7,"ا",2,0],["وَلَثَمتُ ظَهرَ يَدٍ تَنَدّى حُرَّةً","فَكَأَنَّني قَبَّلتُ وَجهَ سَماءِ",8,"ا",2,0],["وَلَثَمتُ حُمرَةَ وَجنَةٍ تَندى حَياً","فَكَرَعتُ في بَردٍ بِها وَسَلامِ",9,"م",1,0],["وَلَثْمٍ تَوَالَى إِثْرَ لَثْمٍ بِثَغْرِهَا","كَما شَافَهَ الْبازِي عَلَى ظَمَأٍ وِرْدَا",10,"د",2,0],["ولثمنا حذاء شارون حتى","صاح مهلاَ قطعتموني الحذاءُ",11,"ا",2,0],["ولثمت تربَتَهُ كما","لثموا، وإن لم أعتد",12,"د",1,0],["ولِثغرها عندَ ابتسامِ أقاحِهِ","بدرٌ تألق في سنا وجَناتها",13,"ت",3,0],["ولثم النّور في سنابله","مصفقا للنّسيم جذلانا",14,"ن",2,0]]}