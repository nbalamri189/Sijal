spx?id=185682",""],[5199,"قبيلة (بنى رشيد) عبس","https://www.poetsgate.com/ViewPoem.aspx?id=146780",""],[5277,"حمامةٌ هجرتْ هديلَها","https://www.poetsgate.com/ViewPoem.aspx?id=187687",""],[5387,"غردي","https://www.poetsgate.com/ViewPoem.aspx?id=53731",""],[5582,"قَلْبٌ عَلَى جَمْرِ الغَرامِ يُقَلَّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186671",""],[5672,"شهد الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=206435",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[5829,"بوح الظمآن","https://www.poetsgate.com/ViewPoem.aspx?id=179846",""],[5861,"وألوذ بي","https://www.poetsgate.com/ViewPoem.aspx?id=193774",""],[6031,"وَرَدَ الكتابُ من الجَنَابِ السَّامِي","https://www.poetsgate.com/ViewPoem.aspx?id=46376",""],[6102,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=182838",""],[6102,"فَ.......","https://www.poetsgate.com/ViewPoem.aspx?id=184545",""],[6102,"قالت لها ..","https://www.poetsgate.com/ViewPoem.aspx?id=184632",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["وَلِثَغْرِهَا عِنْدَ ابْتِسَامِ أَقَاحِهِ","بَرْقٌ تَألَّقَ فِي سَنَا وَجَنَاتِهَا",0,"ت",3,0],["ولثم حصىً لتربتِهِ ذكيّ","كأنَّ شذاه في نفسي كباء",1,"ا",2,0],["ولثّمه المداد لثامَ ليلٍ","فأسفر عن سنا صبحٍ منير",2,"ر",1,0],["ولثمته عند القدوم فحبذا","رطب الشفاه السكريّ بلا نوى",3,"و",2,0],["وَلَثَمتُ إِكراماً لَهُ","وَجهَ الرَسولِ وَكَفَّهُ",4,"ف",2,0],["وَلَثَمتُهُ في خَدِّهِ","فَعَدَدتُ أَلفاً أَو يُناهِز",5,"ز",1,0],["وَلَثمِ مُضَعَّفِ الأَجفانِ ساجٍ","بِمُطلَقِ حُسنِهِ لِلقَلبِ ساجِن",6,"ن",1,0],["وَلَثَمتُ في ظَلماءِ لَيلَةِ وَفرَةٍ","شَفَقاً هُناكَ لِوَجنَةٍ حَمراءِ",7,"ا",2,0],["وَلَثَمتُ ظَهرَ يَدٍ تَنَدّى حُرَّةً","فَكَأَنَّني قَبَّلتُ وَجهَ سَماءِ",8,"ا",2,0],["وَلَثَمتُ حُمرَةَ وَجنَةٍ تَندى حَياً","فَكَرَعتُ في بَردٍ بِها وَسَلامِ",9,"م",1,0],["وَلَثْمٍ تَوَالَى إِثْرَ لَثْمٍ بِثَغْرِهَا","كَما شَافَهَ الْبازِي عَلَى ظَمَأٍ وِرْدَا",10,"د",2,0],["ولثمنا حذاء شارون حتى","صاح مهلاَ قطعتموني الحذاءُ",11,"ا",2,0],["ولثمت تربَتَهُ كما","لثموا، وإن لم أعتد",12,"د",1,0],["ولِثغرها عندَ ابتسامِ أقاحِهِ","بدرٌ تألق في سنا وجَناتها",13,"ت",3,0],["ولثمت الجراح فهي ثغور","يشتهى عطورها التقبيل",14,"ل",1,0],["ولثم النّور في سنابله","مصفقا للنّسيم جذلانا",15,"ن",2,0],["وَلَثمت الثَغور فيها أَقاحاً","وَهَصرت القُدود غُصناً فَغُصنا",16,"ن",2,0],["ولَثَوْرَةُ الأَوراسِ أَكْمَلُ عبرةٍ","فَبِأَيِّ شَرْعٍ أَنْحَنِي لِلجائِرِ؟",17,"ر",1,0],["ولثمتُ مَبسمَهُ اللذيذَ وراقَني","رَشْفُ الرُّضابِ فذقتُ رِيقاً رائِقا",18,"ق",2,0],["ولَثمتُهُ وبثَثتهُ","شَكوايَ همساً من حذارِ",19,"ر",1,0],["ولثمتُ من خَدَّيْ أغرّ مهفهفٍ","شفَقين حُفَّ سَناهما بصباح",20,"ح",1,0],["ولثمت منها الثغر مكترثاً","فوجدته لمسرتي نبعا",21,"ع",2,0],["ولُثْنَ أَردِيَةَ الْوَشِي الرِّقاقَ علَى","قَناً تَمِيلُ بِكُثْبانٍ وتَعْتَدِلُ",22,"ل",1,0],["ولثمت لؤلؤَ ثَغْره","مترشّفاً خمراً وريقا",23,"ق",2,0],["وَلَثْمِ خَدٍّ لِوَرْدٍ","وَرَشْفِ خِلْفٍ لِقِطْفِ",24,"ف",1,0],["ولثغرِ الكَأس مِن فَمهِ","بِحباب الدُرِّ تَنضيدُ",25,"د",1,0],["ولثَمتُ الجميعَ قَطْعاً لِشَكّي","وكذا يَفعَلُ الّذي يتَحَرّى",26,"ر",2,0],["ولثمنا منه كفاً","قد غدت للجود بحرا",27,"ر",2,0],["ولثمت أقدام النسيم ومن","إجلاله لم ألْثُمِ الأيدي",28,"د",2,0],["وَلِثَغرِها من ضَوءِ بَرقٍ لامِعٍ","لَو أَتبعته لَنا بِصَوب غَمامِ",29,"م",1,0],["ولثمن نَوّار الأَقاحي غدوة","بِأَلَذ في الأَفواهِ مِنه وَأَعذَبِ",30,"ب",1,0],["ولثمتُ ثَغراً لو تألَّق في دُجىً","أغنى المَحولَ عن الغَمامِ الماطرِ",31,"ر",1,0],["ولثمنا يدي عظيم قريب","من عظيم تعدَّه للعظائم",32,"م",1,0],["ولثمت محياه فاشرق ثغره","ورشفت كاسا من لماه معطرا",33,"ر",2,0],["ولثغرِ الإسكندريّةِ منه","في العُلى لا لغيره آثارُ",34,"ر",1,0],["ولثمت راحته التي قسمت بها","معلومة الآجال والأرزاق",35,"ق",1,0],["ولثمْتُ سالِفتيْهِ لثْماً لم يكُنْ","لولا وَسَاطةُ سُكرِهِ بِسُلافِهِ",36,"ف",2,0],["ولثمتُ تَحْتَ العَيْنِ من شَغَفِي","بالعين أَو صَيَّرْتُ فيه أَثَر",37,"ر",1,0],["ولَثَمْتُ فوق لِوَى","الثَّنيّة بالِّلوَى بَسَّامَها",38,"م",3,0],["ولثمت أعلى أسعد الحجر الذي","يهوى إليه كل خلق يسم",39,"م",1,0],["ولَثمتُ وردَة خَدِّهِ فتَعَصفَرت","باللَّثمِ مِن خَجَلٍ ومِن تَوريد",40,"د",1,0],["ولثمته فحسبت ريقة ثغره","ضَرَبا ومزنا وهي نار توقد",41,"د",1,0],["ولثمت خمر ريقه","فيها الشفاء لكل لاثم",42,"م",1,0],["ولثم بالإبريز واشتمل الضيا","رداء وبالديجور قد قلد النحرا",43,"ر",2,0],["وَلثمتُ منها مبسماً رفاتهُ","أَحلى منَ العسل اللذيذ وأعذبُ",44,"ب",1,0],["ولثمت فاك وقد منحت ثغوره","صفو الوداد، وصفو ودي صالح",45,"ح",1,0],["ولَثَّمَ الشَّيبُ عِذاري وما","أَنصلَ صبْغُ الدَّمعِ أَرْداني",46,"ن",2,0],["ولثْمَ البدور وشرب الخمور","بماء الثُّغور ونقل القُبَلْ",47,"ل",1,0],["ولثتما فتنفَّست عجباً","وعناقنا بالضيق مشتَدُّ",48,"د",1,0],["ولثامها كاللازورد وتحته","شفقٌ كوردِ اللاذقية نامي",49,"م",2,0],["ولثمت الخدود والحجر الاسعد خالا","تفدى السويد اسواده",50,"د",2,0],["ولثمت أشنب كلما","شبّت جمارك يبرد",51,"د",1,0],["ولثمتها فطبعت في ال","حمراءِ سطراً اصفرا",52,"ر",2,0],["ولثمتُ خدّاً يهتدي بجمالهِ","مَنْ ضَلَّ ثمَّ به يضلُّ المهتدي",53,"د",2,0],["ولثمته ووضعته فوق الفؤا","د المكتوى بلهيبه وعذابه",54,"ب",2,0],["ولثَمَّ سر الله حيث تَبَجَّسَت","سحب الندى وتقدست أسماؤه",55,"ا",3,0],["ولثمك وجنتي قمر منير","يجول بخده ماء الشباب",56,"ب",1,0],["ولثمت موطئ رجله فتأرجت","بألذَّ من طيب الملوك وأعبق",57,"ق",1,0],["ولثمت زهر الثغر الذي","يخجل الزهر إذا ما ابتسما",58,"م",2,0],["ولثمت أكرمَ راحةٍ زَنيّةٍ","منها المواهب كالسحائب وُكّفُ",59,"ف",1,0],["ولثمتُ تُربَ بِساط أسمى مالِكٍ","في لَثمِهِ عزي ونَيلِ تَشرُّفي",60,"ي",1,0],["وَلَثَمْتُ مَبْسمَها وَوَرْدَ خُدودها","فَنَعَمْتُ بالورَادِ والثّلاج",61,"ج",1,0],["وَلَثَمت أخمصها عَلى رَغم العِدى","بِفَم بلثم خدودها لا يَكتفي",62,"ف",2,0],["ولثم دروس العلم والجهل عسعس","ونادى بتعطيل العلوم على النشر",63,"ر",1,0],["ولثم وجنِه بدى فيها اللهب وَالما","تَحكي اللجين الَّذي زانه طلأ أَلماس",64,"س",1,0],["وَلِثَلاَثةٍ وَتِسعةٍ وَمَا","بَينَهما إن رُكِّبَا ما قَدِّمَا",65,"م",2,0],["ولثمت منها الثغر أما ريقه","فطلا وأما درّه فنضيد",66,"د",1,0],["ولثالث الخلفاء سيدنا انتمى","وبه لاهل الشام خير افاده",67,"د",2,0],["وَلَثم خُدودٍ كَالشقائِقِ غَضّة","وَضمّ قُدودٍ كَالغُصونِ رِطابِ",68,"ب",1,0],["ولثغته وَهي صاغية","أَحب اليها من المزهر",69,"ر",1,0],["ولثمت خمرا من مراشفها","فغدت بصرف اللب تمتزج",70,"ج",1,0],["ولثنتين بعد عشر نحا الشا","م أبو طالب بكنز الغناء",71,"ا",2,0],["ولثمَ أَحورَ أَحْوَى","وضمَّ رُودٍ رَداح",72,"ح",1,0],["وَلَثمتُ ثَغراً وَاحياي وَخَجلَتي","إِن قُلتُ مِثلُ اللُّؤلُؤِ الَمنضودِ",73,"د",1,0],["ولثمت فاها فاعتقدتُ بانني","من كفّه سوغت لثم الخِنصِر",74,"ر",1,0],["ولَثَمْتُ في لَهَفٍ شِفَاهِكِ كُلَّمَا","لَمَعتْ شفاهك تطلب التَقْبِيلا",75,"ل",2,0],["ولَثَمْتَ الفُؤادَ ثَغْراً لِثغرٍ","ولكَمْ حَجَّبَ الثُّغورَ لِثامُ",76,"م",1,0],["ولثمت في الخدِّ منها شامةٌ","تحمي لأجفان لها بيمانية",77,"ي",2,0],["ولثمنه للي يريد","بدنى ثمن لو يبتغيه",78,"ي",2,0],["ولثمته ثملا على مهد الرضا","بين الشفاه وكوثر الأضراس",79,"س",1,0],["ولثناء عشر عزوه حشامً كرامى","رشايده باليوم من عبس بالامس",80,"س",1,0],["ولثمتها مثل السنابلِ للندى","وتركتُ بيدرَها إلى الأقدارِ",81,"ر",1,0],["ولثغة بثغرها يغار منها البلبلُ","فالراء في كلامها بغينها تستبدل",82,"ل",1,1],["وَلَثَمْتُ مِنْها مَبْسِماً وَشِفاتُهُ","أَحْلَى مِنَ العَسَلِ اللَّذِيذِ وَأَعْذَبُ",83,"ب",1,0],["ولثمتُ العذبَ من خدٍّ بهِ","جلناَّرُ الحسنِ فوقَ الوجنتينْ",84,"ن",1,0],["ولثمتُ محرابا كأنّ حروفه","من فيض صدرك قائماً يتفجّعُ",85,"ع",1,0],["ولثغركَ البسامِ حين أضلني","فطفقت أرنو للوصال وأحلمُ",86,"م",1,0],["ولثمتُ جرحي لا أرى","من قد يداوي غيرَ كفّي",87,"ف",2,0],["ولثمتُهُ فَكأنَّ فَارَةَ تاجِرٍ","فَقمتْ بعبقتِهَا مَنَاطَ لِثَامِي",88,"م",2,0],["وَ لَثَمتُها ؛ حَتَّى كَأَنَّ زَنابِقًا","نَبَتَتْ بِلَثغِ القافِياتِ \" زَنابِكا \"",89,"ك",2,0],["وَلَثَمتُها, فَقَطَفتُ قُبلَتَها","فَتَوَرَّدَتْ, فَتَفَجَّرَ الزَّهرُ",90,"ر",1,0],["وَ لَثَمتُها - بِالبابِ - حَتَّى حَمحَمَتْ","وَ ضَمَمتُها حَتَّى سَبَيتُ الأَبهَرا !",91,"ر",2,0],["ولثائرٍ يرنو إلى الحريّةِ","الحمراءِ عبرَ الليلةِ الحمراءِ",92,"ا",2,0],["ولثمنا جبينها بعد شوقٍ","وكحلنا عيونها بيلسانا",93,"ن",2,0]]}