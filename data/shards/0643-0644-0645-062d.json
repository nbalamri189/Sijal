{"poems":[[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[74,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[50,"كل محب سواي مستور","https://www.aldiwan.net/poem63346.html","المنسرح"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43845","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[92,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[463,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[463,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[580,"على غير ضلات الأماني تعولي","https://www.aldiwan.net/poem2877.html","السريع"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130557","الرمل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105510","الخفيف"],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[463,"طرفُ نجديّة ُ وطرفُ عراقيُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60153&r=&rc=209",""]],"verses":[["كُلُّ مَحبوكِ القَرا تَحسَبُهُ","طائِراً أَوفى عَلى النيقِ وَطارا",0,"ر",2,0],["كل محبوكة الصدور تهادَي","بين أدراعها أكفُّ الكفاح",1,"ح",1,0],["كَلَمحَةٍ مِن خاطِرٍ","ما جاءَ حَتّى ذَهَبا",2,"ب",2,0],["كُلُّ مَحمولٍ عَلى النَعشِ أَخٌ","لَكَ صافٍ وُدُّهُ بَعدَ الكَدَر",3,"ر",1,0],["كُلُّ مُحِبٍّ سِوايَ مَستورُ","وَالناسُ إِلّا عَن قِصَّتي عورُ",4,"ر",1,1],["كلَمْحِ الشُّنوفِ العَسْجَدِيّاتِ أو كما","أشارَتْ بأخْفَى سُورِهِنّ العَرائس",5,"س",1,0],["كَلَمحَةِ الطَرفِ مُتَّ يا اِبني","فَآه مِن مَوتِكَ الوَشيكِ",6,"ك",1,0],["كُلُّ مَحبوبٍ يُمَلُّ سِوى","ما يَلي الإِنسانُ أَو يَلِدُ",7,"د",1,0],["كل ُّ محبوكةٍ فلا تُبصرُ المعنى","مُعّمىً ولا ترى اللفظ لَبْسا",8,"س",2,0],["كلُّ محلول عُرَى المر","زمِ محلوبِ السِّماكِ",9,"ك",1,0],["كلّ محبوبةٍ إلى الحُقْبِ مستن","نَةِ لُبسِ الخَلخال عند الساقِ",10,"ق",1,0],["كلُّ مُحَيَّا الجبينِ طَلْقٍ","لم يَعتسِفْ بِشرَه القُطوبُ",11,"ب",1,0],["كل محالٍ في الهوَى جَائِزٌ","وكلُّ عقلٍ في الهوى مُحْتَبَلْ",12,"ل",1,1],["كل محبوك القرى اما جرى","خلته برقا على الجو استطارا",13,"ر",2,0],["كل محجربة ألوفةٌ خدر","ليس ترضى لها سوى الغيب خدرا",14,"ر",2,0],["كلمح البرق ضاع العمر لا ندري","متى نكبو بصمتٍ دونما حسِ",15,"س",1,0],["كلَّ محبوبة ٍ إلى الحقبِ مست","نّة ِ لبسُ الخلخالِ عندَ الساقِ",16,"ق",1,0]]}