{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[73,"وما مسبطر ماؤه متدفق","https://www.aldiwan.net/poem3891.html","الطويل"],[37,"أشاقك برق آخر الليل واصب","https://www.aldiwan.net/poem39619.html","الطويل"],[95,"بنات الدهر عوجي لا تهابي","https://www.aldiwan.net/poem9824.html","عموديه"],[74,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[45,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[63,"أسلم للأيام أم لا أسلم","https://www.aldiwan.net/poem51450.html","الطويل"],[68,"يا هلالا من سلطة العي حيي","https://www.aldiwan.net/poem38473.html","الخفيف"],[82,"وأبيض ماض لا يقي من غراره","https://www.aldiwan.net/poem31413.html","الطويل"],[33,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[54,"ومشمولة قد طال بالقفص حبسها","https://www.aldiwan.net/poem27087.html","الطويل"],[54,"قد جمع الحسن والملاحة","https://www.aldiwan.net/poem27194.html","المنسرح"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62237","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[203,"مدادك في ثغر الزمان رضاب","https://www.aldiwan.net/poem45382.html","الطويل"],[203,"مل بي عن الورد واسقني القدحا","https://www.aldiwan.net/poem45643.html","المنسرح"],[297,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[369,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[371,"أفيكم لهذا الحسن بالله منكر","https://www.aldiwan.net/poem17004.html","الطويل"],[382,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[412,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[438,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[519,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[519,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107231","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53765","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48615","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64027","المنسرح"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115106","الطويل"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115107","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59320","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144076","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46631",""],[1468,"","https://poetry.dctabudhabi.ae/diwan/poem/144601","الوافر"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48273","الخفيف"],[2128,"","https://poetry.dctabudhabi.ae/diwan/poem/143659","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27624","الطويل"],[2534,"","https://poetry.dctabudhabi.ae/diwan/poem/145704","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100297","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100274","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205026","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74239","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131218",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119634","الخفيف"],[4224,"","https://poetry.dctabudhabi.ae/diwan/poem/146101","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139523",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["يَمُجُّ شُعاعُها تِبراً","قَوادِمُها نَواثِرُه",0,"ر",2,0],["يَمُجُّ بِما مِنهُ الخَليقَةُ كُلُّها","وَلا روحَ فيهِ إِنَّ هذا هوَ العَجَب",1,"ب",1,0],["يَمُجُّ النَدى لا يَذكُرُ السَيرَ أهلُهُ","وَلا يَرجِعُ المَاشِيُ بِهِ وَهوَ جَادِبُ",2,"ب",1,0],["يَمُجُّ أَشِعَّةً تُدْعَى بِنِقْسٍ","كَنُورِ الشِّمْسِ يَدْعَى بِاللُّعَابِ",3,"ب",1,0],["يمجّ شهاداً تارةً لوليِّه","ووقتاً لشانيه يمجّ سماما",4,"م",2,0],["يَمُجُّ ظَلاماً في نَهارٍ لِسانُهُ","وَيُفهِمُ عَمَّن قالَ ما لَيسَ يَسمَعُ",5,"ع",1,0],["يَمُجٌّ لكم شهدَ الكَلامِ لِسانُه","وما مَجَّ يَوماً قبلَه الشَّهْدَ أَرقَمُ",6,"م",1,0],["يَمُّ جودٍ جادَت عَلى الناسِ كَفّا","هُ فَأَغنَت عَنِ الحَيا الوَسمِيِّ",7,"ي",1,0],["يمُجّ سريعاً في فم الجرح حَدُّهُ","منَ السمِّ ما سَقَته من ملكها الفُرسُ",8,"س",1,0],["يَمُجُّ ذَكِيَّ المِسكِ مِنها مُفَلَّجٌ","رَقيقُ الحَواشي ذو غُروبٍ مُؤَشَّرُ",9,"ر",1,0],["يَمُجُّ سُلافَ الخَمرِ في عَسجَديَّةٍ","تَوَهُّجُ في يُمناهُ كَالكَوكَبِ الفَردِ",10,"د",1,0],["يَمُجُّ إِبريقُهُ المِزاجَ كَما اِم","تَدَّ شِهابٌ في إِثرِ عِفريتِ",11,"ت",1,0],["يَمُجُّ بَرَاعِيمَ مِنْ عَضْرَسٍ","تَرَاوَحَهُ القَطْرُ حَتَّى مَعِنْ",12,"ن",1,0],["يَمُجُّهَا أَكْلَفُ الإِسْكَابِ وَافَقَهُ","أَيْدِي الهَبَانِيقِ بِالمَثْنَاةِ مَعْكُومُ",13,"م",1,0],["يَمُجُّونَ مِنْ أَفْوَاهِهِمْ رَشْحَ مُضْغَةٍ","كَنَضْحِ دَمٍ يَنْهَلُّ مِنْ أَنْفِ مُرْعَفِ",14,"ف",1,0],["يَمُجُّ سُلافاً في إناءٍ كَأَنَّهُ","إِذَا ما اسْتَقَلَّتْهُ الأَنَامِلُ كَوْكَبُ",15,"ب",1,0],["يمجُّ كمثلِ الشهدِ مجتهُ نحلةٌ","وإن لم يكن فيما يمجُّ شرابُ",16,"ب",1,0],["يمجُّ راحاً كأنَّ شعلتها","تحت الدياجي شعاعُ شمسِ ضحى",17,"ح",2,0],["يَمُجُّ رُضاباً مُثِّلَ الحُلوُ مِثلَهُ","عَلى طارِماتٍ كَفؤُها وَسَليقُها",18,"ق",3,0],["يَمُجُّ على خَدّ البياضِ رُضابَه","فيَجْلو صباحاً بالظّلامِ مُثَمَّغا",19,"غ",2,0],["يُمَجمِجُ أَلفاظاً بِخَمرَةِ ريقِهِ","سُكارى الخُطا في ذَيلِها تَتَعَثَّرُ",20,"ر",1,0],["يمجُّ مَنوناً حكمُها وذمامُها","ويسكبُ ناراً عرشُها وسريرها",21,"ر",3,0],["يَمجُجنَ ريقاً إِن أَردت جَعلته","شُهداً وَإِن أَحبَبت كانَ ذُباحا",22,"ح",2,0],["يمجُّ منها فمّ الإبراق رائقة","تخالها إنها صيغت من اللهب",23,"ب",1,0],["يَمُجُّ لها شُهْدَ المدائِحِ مَنْطِقِي","وتَنْفُثُ في أَعدائِها السُّمَّ مُنْقَعا",24,"ع",2,0],["يمُّ جُودٍ تُثني عليه الغَوادي","وكفاهُ فخراً ثناءُ الحَسودِ",25,"د",1,0],["يمجُّ على صباحِ السّطْرِ ليلاً","تكَوكَبَ في المعالي واِسْتَنارا",26,"ر",2,0],["يمجّ رُضابَ النّحلِ طوراً لسانُه","وينفثُ طوراً نابُه سُمَّ أرْقَما",27,"م",2,0],["يمُجُّ سِماماً من فروجِ نُيوبِهِ","متى ما رقاها القومُ صَمَّتْ عن الرُّقى",28,"ق",2,0],["يُمجّ سِماعاً في اللّديغِ كأنّه","لُغامُ نياقٍ أو نضيح حِبابِ",29,"ب",1,0],["يَمُجُّ ذَكِىَّ المِسكِ منهُ مُفلَّجٌ","كنورِ الأَقاحِي أَو دَرارٍ نَضِيدةِ",30,"ه",1,0],["يمجّ ثراها فيه عفراء جَعْدة","كأنّ نداها ماء ورد وعنبرُ",31,"ر",1,0],["يَمُجْنَ في البيت كمو","ج ذي عباب مترع",32,"ع",1,0],["يمجُّ سلسالةً يُسَلسِلُها","مدغدغٌ للعقول لدّاغ",33,"غ",1,0],["يمجُّ الندى من بعد ما حمي الحصَى","دِماثٌ به مَوليَّةٌ ومَحَانِ",34,"ن",1,0],["يَمُجُّ النَّدى مِن بَعدِما وَقَد الحَصَى","شِعَابٌ لَهُ مَولِيَّةٌ ومَحَانِ",35,"ن",1,0],["يَمُجُّ إبْرِيقُهُ سُلاَفاً","كَكَوْكبٍ نُورُهُ تَوَقَّدْ",36,"د",1,0],["يمجّ رُضاباً بالمنايا وبالمُنى","ففي جبهة الأيامِ من خطّه خطُّ",37,"ط",1,0],["يمُجّ رضابا بالمناي والمنى","ففي جبهة الأيام من خطّه خطُّ",38,"ط",1,0],["يَمجُّ على مَهارقه لعاباً","إذا ما ارتاح من فرحِ اللِّعاب",39,"ب",1,0],["يمجُّ أوّل حرف سمع سامعهِ","ويعتريه كلالُ العجز والملَلِ",40,"ل",1,0],["يَمُّ جودٍ لكلِّ عافٍ فقيرٍ","ووليٌّ وعارضٌ وَسْمِيُّ",41,"ي",1,0],["يمج بروقاً بين ليلين من حشا","إلى فم أفعى ما ترى بينه سنا",42,"ن",2,0],["يمجده عبد الهوى في صلاته","على غيرِ علم والمجيدُ هو الله",43,"ل",2,0],["يمجُّ كلَّ شيءٍ","يمرُّ في لَهاتِهْ",44,"ت",2,0],["يمجُّ عن رضابه ال","ماذي ريقا خصرا",45,"ر",2,0],["يمجُّ بالريق عذباً من مباسمه","كأنه في حشا الإبريق ناجود",46,"د",1,0],["يمج السم من فيه كلاما","يولّده له الطبع الذميم",47,"م",1,0],["يَمج تبراً عَلى وَجه الصحيفة بَل","دراً يَفوق عَلى الدري وَالدرر",48,"ر",1,0],["يمج شواظ النار فوها وقلبها","بإمداده عند الصدام كفيل",49,"ل",1,0],["يَمجّ مَنوناً سَيفُهُ وسِنانُهُ","ويَلهَبُ ناراً غِمدُهُ والأنابِيبُ",50,"ب",1,0],["يمج لعابه عسلا وخمراً","تفانت في طلابهما الرجال",51,"ل",1,0],["يم جود تثني عليه الغوادي","والربى والوهاد والآكام",52,"م",1,0],["يمج المنايا والمنايا تمجه","يقاربها مستبسلاً وتجانبه",53,"ب",2,0],["يمُّ جودٍ كم فاض منه عبابٌ","غمر الأرض بالأيادى انصيابا",54,"ب",2,0],["يَمُجُّ زُلالَ الماء في كلَّ واحةٍ","ويُزهرُ بالأغصان ِ ما يَتَرَعرع",55,"ع",1,0],["يمجد في كل يوم بغياً","ويلعنُ في كل يوم شهيدْ",56,"د",1,0],["يَمُجُّ ضَرْبينِ من صَابٍ ومن عَسَلٍ","ومعنينِ من النّضْنَاض والنّحْلَهْ",57,"ل",2,0]]}