],[105,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[81,"رع بجيش اللذات سرب الشجون","https://www.aldiwan.net/poem61479.html","الخفيف"],[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[102,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[102,"كفكف دموعك ليس ينفعك","https://www.aldiwan.net/poem33114.html","مجزوء الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"أهلا بفطر قد أنال هلاله","https://www.aldiwan.net/poem26972.html","الكامل"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"يا صاح دع مدنفا قد لج في عنقه","https://www.aldiwan.net/poem69008.html","البسيط"],[48,"لا تذهلن عن ابنة الكرم","https://www.aldiwan.net/poem65117.html","الكامل"],[48,"أصلي الصلاة الخمس في حال وقتها","https://www.aldiwan.net/poem66272.html","الطويل"],[46,"كأنني راكب اللج الذي عصفت","https://www.aldiwan.net/poem22261.html","البسيط"],[46,"أراك حسبت النجم ليس بواعظ","https://www.aldiwan.net/poem23287.html","الطويل"],[46,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"على مثلها من فجعة خانني الصبر","https://www.aldiwan.net/poem39311.html","البسيط"],[68,"ما بين ضال المنحنى وظلاله","https://www.aldiwan.net/poem1518.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55140","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54976","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54213","الخفيف"],[77,"هات الحديث عن الركب الذي بانا","https://www.poetsgate.com/ViewPoem.aspx?id=34164",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[11,"أرَسْماً جديداً، من نَوَارَ، تعَرّفُ","https://www.poetsgate.com/ViewPoem.aspx?id=16863",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[97,"القمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63570&r=&rc=113",""],[85,"أَهلَ القُدودِ التي صالت عَوَاليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9579&r=&rc=69",""]],"verses":[["وَإِنَّ ظُهورَهُم لَو كانَ نِصفٌ","مِنَ الأَنعامِ أَولى بِالوَلايا",0,"ا",3,0],["وَأَنظَرَها حَتّى تَعودَ حُلومُها","وَأَمهَلَها حَتّى تَثوبَ عُقولُها",1,"ل",3,0],["وَأَنظُرُ سُبَّةً وَعَظيمَ عارٍ","رِضايَ مِنَ المُنازِعِ بِالكَفافِ",2,"ف",1,0],["وَاِنظُرَنها تَجُر زَعازِعُها النِك","بُ وَبَطني مِنَ النَوالِ خَميصُ",3,"ص",1,0],["وَأَنظُرُ ماضِياً في عَقبِ ماضٍ","لَقَد أَيقَنتُ أَنَّ الأَمرَ جِدُّ",4,"د",1,0],["وأنْظِمُ حينَ أفخَرُ رائِعاتٍ","تَكونُ لكُلِّ ذي حَسَبٍ مِثالا",5,"ل",2,0],["وإنّ ظُنوني في الإمامِ وفَضْلِهِ","مُحقّقَةٌ واللهِ لا مُتَمارِيَهْ",6,"ر",3,0],["وإنْ ظهَرَتْ نِعْمَةٌ للإلاهِ","عليَّ فأُلْبِسْتُ منْها حُلا",7,"ل",2,0],["وَانْظُرْ إِلَى الرَّوْضِ إِذْ هَبَّتْ مُحَدِّدَةً","طَلاَئِعُ الرِّيحِ كَيْفَ اهْتَزَّ وَازْدَانَا",8,"ن",2,0],["وانْظُرْ إليْهِ تلُحْ إليكَ بوجْهِهِ","سِمَةَ الشّجاعَةِ منْ أبيهِ وجدِّهِ",9,"د",2,0],["وَاُنظُروا اليابانَ في الشَرقِ وَقَد","رَكَّزَت أَعلامَها فَوقَ القِمَم",10,"م",1,0],["وَاُنظُر إِلى الغَربِيِّ كَيفَ سَمَت بِهِ","بَينَ الشُعوبِ طَبيعَةَ الكَدّاحِ",11,"ح",1,0],["وَاُنظُر إِلى أُمَّةٍ لَولاكَ ما طَلَبَت","حَقّاً وَلا شَعَرَت حُبّاً لِأَوطانِ",12,"ن",1,0],["وَأَنظُرُ في بُستانِها النَجمَ مُشرِقاً","فَهَل أَنتَ يا بُستانُ أُفقٌ مُكَوكَبُ",13,"ب",1,0],["وَانْظُرْ إِلَى مِصْرَ الوَفِيَّةِ رَاضِياً","عَمَّا تَرَاهُ مِنْ جَدِيدِ خِلالِهَا",14,"ل",3,0],["وَانْظُرْ بِأَيْسَرِهِ إِلَى الطَّوْدِ الَّذِي","فِيهِ مِنَ الإِبْدَاعِ فَنٌّ ثَانِي",15,"ن",2,0],["وَإِن ظُلِمَت لَم تَنتَصِر مِن ظَلامَةٍ","وَلَم تُبدِ ناباً لِلقِتالِ وَلا ظُفرا",16,"ر",2,0],["وانظر إلى الدوح والأنهار تكنُفُها","مثل الندامى سواقيها سواقيها",17,"ي",3,0],["وانظمْ غناء الطير فيه مدائحاً","وانثر من الزهر الدراهم والدررْ",18,"ر",1,0],["وانظر إلى حسن الطبيعة أنه","حسنٌ يفيدك في الحياة كمالا",19,"ل",2,0],["وإن ظهر الأرض يستثقل مَن","قام يدبّ فوقها على العصا",20,"ا",1,0],["وانظر إليه بعين منك شافية","ما نابه اليوم من جهل وإعواز",21,"ز",1,0],["وانظر لعُقبى وزراء مضَوْا","كيف عليهم دارت الدائرة",22,"ر",2,0],["وانظر محاسن أرضه وسمائه","وانشَق أريج شَماله وقَبوله",23,"ل",2,0],["وَإِن ظَلَموهُ قُمتُ بِالسَيفِ دونَهُ","لَأَنصُرَهُ إِنَّ الضَعيفَ يُؤَنَّفُ",24,"ف",1,0],["وانظر إلى أسرار ك","فِّ أجم مقلوم الأظافرْ",25,"ر",1,1],["وَإِن ظَمِئَت نَفسي إِلى طيبِ ريقِها","لَقَد رَوِيَت بِالدَمعِ مِنّي المَدامِعُ",26,"ع",1,0],["وانظر لساعاتِ النَّها","رِ بجنح ليلٍ سائره",27,"ر",2,0],["وانْظر لحالِ غريب الدَّار مفتقر","طال الزمان وما سدَّت مفاقره",28,"ر",2,0],["وانْظر إلى الخال فوق الثغر دون لمىً","تجد بلالاً يراعي الصبح في السحر",29,"ر",1,0],["وأنظم الشعر في سماحكم","فحبَّذا كوكبي ونبراسي",30,"ي",1,0],["وانْظر لألحاظ من أهوى وقل لي عن","علم تلك ظباً أم تلك ألحاظ",31,"ظ",1,0],["وانظرْ بنعماك إلى حالِ ذي","ضرورة يعجز عن دفعها",32,"ع",3,0],["وانظر بعين العقل لا عينِ الهوى","فالحق للعين الجليَّة عاري",33,"ر",2,0],["وإن ظمئتْ قالتْ لها النفسُ شمري","فعند ابن عبد الله عِدٌّ قَلَيْذَمُ",34,"م",1,0],["وانظر أبعدَ الجهلِ أم","بعدَ النُّهى يقعُ التنَدُّمْ",35,"م",1,0],["وَاِنظُر جُمَيعُ إِذا قَناتُكَ هُزهِزَت","هَل في قَناتِكَ قادِحٌ وَوُصومُ",36,"م",1,0],["وَاِنظُرِ النورَ كَيفَ يَدخُلُ لا يَط","لُبُ أُذناً فَما لَهُ لَيسَ يُطرَد",37,"د",1,0],["وَاِنظُر إِلى الأَشجارِ تَخلَعُ أَخضَراً","عَنها وَتَلبِسُ أَحمَراً أَو أَصفَرا",38,"ر",2,0],["وَاِنظُر إِلى الغَبراءِ تُنبِتُ سُندُساً","وَتَأَمَّلِ الغُدرانَ تَجري كَوثَرا",39,"ر",2,0],["وَاِنظُري ثُمَّ فَكِّري كَيفَ أَمسى","لَيسَ يَدري عَدُوُّهُ وَخَدينَه",40,"ن",2,0],["وَاِنظُر إِلى النارِ إِنَّ الفَتكَ عادَتُها","لَكِنَّ عادَتُها الشَنعاءَ تُرديها",41,"ي",3,0],["وَاِنظُر لِنَفسِكَ فيما","قَد كانَ مِنكَ وَدَعنا",42,"ن",2,0],["وانظري الوادي يُغَشِّيهِ","الضَّبابُ المُسْتَنيرْ",43,"ر",1,0],["وانظريني باعين باكيات","ترسل الدمع مثل در نضيد",44,"د",1,0],["وأنظار صدق في الفنون دقيقة","وآراء علم هن أسنى من الشهب",45,"ب",1,0],["وانظر إلى الماضى فإن المهتدى","من يجعل الماضي هدى وزماما",46,"م",2,0],["وانظر بعين في الأمور جلية","لا تُثبت الأشياء عين تدمع",47,"ع",1,0],["وَاِنظُر إِلى البُؤَساءِ نَظرَةَ راحِمٍ","قَد كانَ يُسعَدُ جَمعَهُم وَيُجيرُ",48,"ر",1,0],["وَأَنظُرُ في تُرابِكِ ثُمَّ أُغضي","كَما يُغضي الأَبِيُّ عَلى القَذاةِ",49,"ه",1,0],["وَاِنظُر أَباكَ وَثُكلَهُ","وَرُزوحَهُ تَحتَ المُصابِ",50,"ب",1,0],["وَاِنظُر بِعَينٍ نُزِّهَت","عَن زُخرُفِ الدُنيا الكِذابِ",50,"ب",1,0],["وَاِنظُرِ الناسَ تَجِد مَن سَلِما","مِن سِهامِ الدَهرِ شَجَّتهُ القِسي",51,"ي",1,0],["وَاِنظُرنَ ما فَعَلَت أَحداقُكُنَّ بِها","ما كانَ مِن عَبَثِ الأَحداقِ يَكفيها",52,"ي",3,0],["وَأَنظُرُ جَيشَهُم مِن نِصفِ قَرنٍ","عَلى أَبصارِنا ضَرَبَ الخِياما",53,"م",2,0],["وَأَنظُرُ جَنَّةً جَمَعَت ذِئاباً","فَيَصرُفُني الإِباءُ عَنِ الزِحامِ",54,"م",1,0],["وإن ظفرت بعقد الإنفصال له","فذاك والله عندي غاية الظفرِ",55,"ر",1,0],["وانظُرْ إليه ساخطاً أو راضياً","فإنِ استطعتَ القولَ فيه فحَرِّشِ",56,"ش",1,0],["وانظُرْ إلى الليلِ كيفَ تَصدَعُهُ","رايةُ صُبحٍ مُبيضَّةُ العَذَبِ",57,"ب",1,0],["وَانظُر لِنَفسِكَ ما استَطَع","تَ فَإِنَّها نارٌ وَجَنَّه",58,"ن",2,0],["وَاِنظُر إِلى القِدّاحِ يَب","دو مِن خِلالِ الوَرَقِ",59,"ق",1,0],["وَاِنظُر لِنَرجِسِهِ الشَهِيِّ كَأَنَّهُ","طَرفٌ تَنَبَّهَ بَعدَ طولِ هُجودِهِ",60,"د",2,0],["وَاِنظُر إِلى المَنظومِ مِن مَنثورِهِ","مُتَنَوِّعاً بِفُصولِهِ وَعُقودِهِ",60,"د",2,0],["وَأَنظِمُ مَدحَ غَيرِكَ وَالقَوافي","تَعَضُّ عَلَيَّ أَطرافَ البَنانِ",61,"ن",1,0],["وَأَنظِمُ أَبكارَ المَعاني وَعَونَها","فَإِن لَم أَسرِ سارَت إِلَيكَ المَدائِحُ",62,"ح",1,0],["وَاِنظُر لِقَولِ اِبنِ الحُسَينِ وَقَد رَأى","حالاً يَشُقُّ عَلى الأَبيِّ وَيَعظُمُ",63,"م",1,0],["وانظر إلى سيارة كالأجل","تخطف خطفاً لا تُبالي الزحام",64,"م",1,0],["وانظر إلى هذا القويّ الجسد","الباتِر العزم الشديد الكفاح",64,"ح",1,0],["وانظر إلى السِّكِّين في ساحةٍ","قد زمجرت فيها دماء الذَّبيح",65,"ح",1,0],["وانظر إلى النارنج في الطبق الذي","أبدى تدانيَ وجنةٍ من وجنةِ",66,"ه",1,0],["وَاُنظُر إِلى جِسمي فَفي","ما حَلَّ بي العَجَبُ العَجيبُ",67,"ب",1,0],["وانظمِ الشعرَ ولازمْ مذهبي","فاطراحُ الرفدِ في الدنيا أقلْ",68,"ل",1,0],["وانظرْ إلى تجانسٍ","بينَ النسا والشُّعَرا",69,"ر",2,0],["وانظروا الدُّورَ التي هاموا بها","أهيَ أجداثٌ تضمُّ النّاشئينْ",70,"ن",1,0],["وانْظرِي ما صَنَعَ الكُفرُ بهم","من أذىً يُعجبه أن يصنَعَهْ",71,"ع",2,0],["وَانْظُرْ إلى القمرِ الزَّاهِي وبَهجتِهِ","وَاعْجَبْ له بعد هذا كيفَ يَنكسِفُ",72,"ف",1,0],["وانظروا حوله الجنودَ أُلوفاً","بعد أن لم تكنْ تُدانِي المئينا",73,"ن",2,0],["وَاِنظِماها في لَيلَةِ الأُنسِ عِقداً","مُلكُ كِسرى لَدَيهِ غَيرُ ثَمينِ",74,"ن",1,0],["وَاِنظُر إِلَينا وَسرِّح في الحمى بَصَراً","عَن الهُدى لَم يَكُن يَوماً بِمَحجوبِ",75,"ب",1,0],["وَاِنظُر عمِيت فَإِنَّهُ","مِن صَرخة الحَق التهب",76,"ب",1,0],["وانظرْ هُنالِكَ هل ترى","آثار يوسف في المكانِ",77,"ن",1,0],["وانظرْ بعينيْك الذئا","ب تعُبُّ في أحواضها",78,"ه",2,0],["وَاِنظُر إِلى التَوفيقِ بِاِختِيارِهِم","وَالعِلمِ بِالناسِ وَبِاِختِيارِهِم",79,"م",1,0],["وَاِنظُر إِلَيهِ كَزَورَقٍ مِن فِضَّةٍ","قَد أَثقَلَتهُ حُمولَةٌ مِن عَنبَرِ",80,"ر",1,0],["وَاِنظُر إِلى دُنيا رَبيعٍ أَقبَلَت","مِثلَ النِساءِ تَبَرَّجَت لِزُناةِ",81,"ه",1,0],["وَانْظُرْ سماء غَدَتْ مَمْلُوءَةً حَرَساً","كَأَنّها البيْتُ لَمَّا جاءَهُ الفيلُ",82,"ل",1,0],["وانظُر فَلَيس كَمِثلِ اللَّهِ مِن أَحَدٍ","وَلا كَقَولٍ أَتى مِن عِندِهِ قيلُ",82,"ل",1,0],["وانظر إلى لحيةِ الطمشيشِ بارِزَةً","حَمراءَ ضافيَةً دَلَّت على حُمُقِه",83,"ق",2,0],["وَاِنظُر إِذا هِيَ قابَلَتكَ تَهَيُّؤً","نَظَرَ اليَتيمِ إِلى يَدِ الأُمِّ",84,"م",1,0],["وأنظرُ إن حانت من الكأسِ دعوةٌ","إلى بيعةِ الساقي أجيبُ مسارعا",85,"ع",2,0],["وَاِنظُر إِلى نَفسِكَ اللَومى بِمَنظَرِها","وَلَو غَدَوتَ أَخا مُلكٍ وَتَتويجِ",86,"ج",1,0],["وَإِنَّ ظَليمَ القَفرِ يُرضيهِ زِفُّهُ","وَيَفهَمُ عَن أَخدانِهِ وَهوَ أَصلَمُ",87,"م",1,0],["وَأَنظُرُ سَهمَها قَد أَرسَلَتهُ","إِلَيَّ بِنَكبَةٍ أَو فَوَّقَتهُ",88,"ت",2,0],["وانظرْ إلى الرفيعِ من بُنيانِهِ","يُريكَ بِدْعاً من عَظيم شَانِهِ",89,"ه",1,0],["وَأَنْظُرُ حَوْلي لا أرَى غَيرَ قَبرِهِ","كأنَّ جميعَ الأَرضِ عِنْدِي لَهُ قَبرُ",90,"ر",1,0],["وانظُرْهُ عنّي إنّ طرْفي عاقني","إرسالُ دمعي فيه عن إرْساله",91,"ل",2,0],["وانظر البر إن مشهده بع","دَ غروبٍ لها شجيٌّ مهيب",92,"ب",1,0],["وانظرِ الشمسَ في الغياهب صفرا","ءَ تهادى في رائعِ الأفوافِ",93,"ف",1,0],["وانظري للحقول والغاباتِ","حرّةً طلقةً كهذا البحرِ",94,"ر",1,0],["وَانْظُرْ فَثَمَّ غَمَامَةٌ أُنُفٌ","تُولِي الْجَمِيلَ وَرَوْضَةٌ أُنُفُ",95,"ف",1,0],["وَانْظُرْ جُنُودَكَ فِي الفَلاَةِ تحَمَّلُوا","شَرَّ العِقَابِ لأُمَّةٍ أَشْرَارِ",96,"ر",1,0],["وَأَنْظُرُ أُخْتِي فِي الشَّقَاءِ كَأَنَّنِي","أَرَانِي بِمِرْآةٍ أَمُوتُ وَأَذْبُلُ",97,"ل",1,0],["وَأَنْظُرُ مَنْ حَوْلِي مُشَاةً وَرُكَّباً","عَلَى مُزْجَيَاتٍ مِنْ دُخَانٍ وَأَفْرَاسِ",98,"س",1,0],["وَانْظُرْ بِعَيْنَيْكَ خَطَّ الْقَضَاءُ بِهِ","في اللَّوْحِ وَاقْرَأْ لَنَا مَا فِيهِ قَدْ كُتِبَا",99,"ب",2,0],["وانظُرِي في الضَّمير إِن شِئْتِ مرآ","ةً ففيه تبدُو النفوسُ وتُجْلَى",100,"ل",2,0],["وانظر إلى الروض إذ هبت محدرة","طلائع الريح كيف اهتز وازدانا",101,"ن",2,0],["وأنظر من صاحبات (السّمو)","ولكنها بنت أشقى الرعايا",102,"ا",3,0],["وإن ظلموه قمت بالسيف دونه","لأنصره، إن الضيف الضعيف يؤنَّفُ",103,"ف",1,0],["وانظُر إلى الكوخِ قد بِيعتْ دعائمُهُ","وحَوَّلُوها لأقراطٍ وأسوار",104,"ر",1,0],["وأن ظروفاً ضايَقَتْكَ عوابساً","أتتك تُرَجِّي العفْوَ وَهْيَ بواسم",105,"م",1,0],["وانظرْ إلى اسِّكين في ساحةٍ","قد زمجرتْ فيها دماء الذَّبيحْ",106,"ح",1,0],["وانظرن ما فعلتْ أحداقكن بها","ما كان من عبثِ الأحدقِ بكيفها",107,"ه",2,0]]}