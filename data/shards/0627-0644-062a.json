gate.com/ViewPoem.aspx?id=177449",""],[5739,"هيه يالمسترجله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=131708",""],[5739,"حالب النمله ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155467",""],[5749,"كفى حوادث","https://www.poetsgate.com/ViewPoem.aspx?id=140336",""],[5756,"اثنا عشر شهر","https://www.poetsgate.com/ViewPoem.aspx?id=5433",""],[5776,"للشّفرةِ الصّمّاء معنىً مبهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=205845",""],[402,"رب البيان وسيدا لقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36326",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[5848,"البياض","https://www.poetsgate.com/ViewPoem.aspx?id=53094",""],[5848,"ارتباك وضياع","https://www.poetsgate.com/ViewPoem.aspx?id=53096",""],[5848,"الهيل والنعناع والقرفه","https://www.poetsgate.com/ViewPoem.aspx?id=53166",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[5956,"حوار بين رجل ومحبوبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182109",""],[5956,"شكْلُها","https://www.poetsgate.com/ViewPoem.aspx?id=182613",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"هذي الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183285",""],[5956,"عساك اْخترتَني؟","https://www.poetsgate.com/ViewPoem.aspx?id=192131",""],[5966,"الطائف","https://www.poetsgate.com/ViewPoem.aspx?id=158861",""],[6056,"الأحلام الوردية","https://www.poetsgate.com/ViewPoem.aspx?id=130357",""],[6056,"الوجيه المكفهرّه","https://www.poetsgate.com/ViewPoem.aspx?id=156694",""],[6093,"أصورَ الجَرْحَ في القرطاسْ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=183886",""],[6126,"النَّخْلة","https://www.poetsgate.com/ViewPoem.aspx?id=190002",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6197,"فوهات الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64537&r=&rc=19",""],[6201,"لا منطقيون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87482&r=&rc=6",""],[6275,"البريق الضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83614&r=&rc=6",""]],"verses":[["اِلْتَمِسْ مَخْرَجاً يُوَافِقُ قَوْلِي","قُلْتُ أَحْسَنْتَ يَا جَلاَل التِّينِ",0,"ن",1,0],["التارِكُ الكَسبَ الخَبي","ثَ إِذا تَهَيَّأَ لِلقِتالِ",1,"ل",1,0],["أَلْتَوْأَمَانِ اللَّذَانِ كَانَا","كِلاَهُمَا زِينَةَ الشَّبَابِ",2,"ب",1,1],["أَلتَّارِكِينَ لِغَيْرِهِمْ","نَزَقَ الطُّفُولَةِ وَالدِّعَابَا",3,"ب",2,0],["أَلتُّرْبُ لِلأَجْسَامِ مُصْطَنَعٌ","وَنَوَاسِمُ الأَرْوَاحِ لِلنَّسَمِ",4,"م",1,0],["أَلتَّاجُ تَاجُ مُمَلَّكِينَ عِظَامِ","صَوْغُ النَّدَى وَالحَزْمِ وَالإِقْدَامِ",5,"م",1,1],["التواضع مع الجلال","والكمال حاز مع الجمال",6,"ل",1,0],["إلّ تطلب ان تدارك","بجرى شمس الظهيرا",7,"ر",2,0],["التارِكِ القِرنَ لَدى قِرنِهِ","يَعثُرُ في ذي الخُرُصِ الذابِلِ",8,"ل",1,0],["ألتقيه ويحسبُ الهجرَ قلبي","فكأنِّي ما نلتُ طيبَ اللقاء",9,"ا",2,0],["آلَت إِلى النِصفِ مِن كَلفاءَ أَترَعَها","عِلجٌ وَلَثَّمَها بِالجَفنِ وَالغارِ",10,"ر",1,0],["أَلَ تَرَ مُنذُ اِستُلينَت قَناتُهُ","تَمَشَّت إِلَيهِ الحادِثاتُ تُساوِرُه",11,"ر",2,0],["اِلتَحى الأَمرَدُ الَّذي","كانَ في التيهِ مُسرِفا",12,"ف",2,1],["الترقي إذا افتكرت مليا","في خلاف الشعوب لافي الوئام",13,"م",1,0],["التَقَتِ الأَحزابُ بِالأَحزابِ","وَاِقتَتَل الجَمعان حَولَ الزاب",14,"ب",1,0],["التُركُ تَقرَأُ بِاِسمِ جَدِّكَ في الوَغى","وَالعُربُ تَذكُرُ في الكِتابِ أَباكا",15,"ك",2,0],["التاجُ فُصِّلَ في سَمائِكَ بِالضُحى","مِنكَ الحِلى وَمِنَ الضُحى الأَنوارُ",16,"ر",1,0],["اِلتامَتِ الأَحزابُ بَعدَ تَصَدُّعٍ","وَتَصافَتِ الأَقلامُ بَعدَ تَلاحي",17,"ح",2,0],["آلَت لَئِن لَم تَرِد أَزميرَ لا نَزَلَت","ماءً سِواها وَلا حَلَّت عَلى عُشُبِ",18,"ب",1,0],["التارِكينَ مِنَ الأَشياءِ أَهوَنَها","وَالراكِبينَ مِنَ الأَشياءِ ما صَعُبا",19,"ب",2,0],["اِلتَقَت في رَبيعَةَ اِبنِ نِزارٍ","بَينَ أَعيانِها سَراةُ جُدودِه",20,"د",2,0],["التَقِيُّ النَقِيُّ وَالفاضِلُ المُف","ضِلُ فينا وَالمُرتَضى المُختارُ",21,"ر",1,0],["التَرامي بَعدَ الوَجيفِ إِذا إِستُؤ","نِفَ خَرقٌ وَالوَخدُ قَبلَ الرَسيمِ",22,"م",1,0],["التارِكُ القِرنِ تَحتَ النَقعِ مُنجَدِلاً","إِذا تَلاحَقَ وِردُ المَوتِ فَاِعتَكَرا",23,"ر",2,0],["التَقِيُّ البَرُّ مَن يَنبُذُها","وَالمُحامي دونَها الخِبُّ الخَدِع",24,"ع",1,0],["التقت أرواحنا في ساحةٍ","كغريبين استراحا من سَفر",25,"ر",1,0],["التقينا كما التقى بعد تطواف على القفر في السرى انضاء","قطعوا شَوطهم على الدم والشوك وراحوا على اللهيب وجاءوا",26,"ا",1,0],["آلَت أُمورُ الشِركِ شَرَّ مَآلِ","وَأَقَرَّ بَعدَ تَخَمُّطٍ وَصِيالِ",27,"ل",1,1],["التركُ ملحُ الأرضِ في عصرِنا","والفلَكُ الدائرُ في سعدِهمْ",28,"م",1,1],["التاجر الخيّاطُ قاضٍ عندنا","ولديهِ يَثبتُ ردةً وفسوقُ",29,"ق",1,1],["التركُ والعربُ الأُباةُ أنوفُهم","سيفان في لُجَجِ الوَغى غَرِقانِ",30,"ن",1,0],["التُركُ جُندُ اللَهِ لَولا بَأسُهُم","لَم يَبقَ في الدُنيا مُقيمُ أَذانِ",31,"ن",1,0],["التاجُ لا يَحميهِ غَيرُ مُجَرِّبٍ","يَزِنُ الأُمورَ وَيُقدِرُ الأَحوالا",32,"ل",2,0],["التُّقَى والبرُّ في تاجَيْهِمَا","هل رأى التاجَيْنِ أعلى المالكين",33,"ن",1,0],["آلَت لَواحِظُهُ أَلّا يَعيشَ لَها","قَلبٌ وَلَو أَنَّهُ في قَسوَةِ الحَجَرِ",34,"ر",1,0],["أَلتَمسُ البابَ لا أَفوز بِهِ","أَطوف بِالدار لَست أُبصرها",35,"ر",3,0],["إِلتَفَّت الآمالُ مِنّا بِها","وَقَد مَضى آمَلُها ما اِلتَفَت",36,"ت",1,0],["التُربُ جَدّي وَساعاتي رَكائِبُ لي","وَالعَيشُ سَيري وَمَوتي راحَةُ الجَسَدِ",37,"د",1,0],["التَّقيُّ النَّقِيُّ كَهْلاً وطِفْلاً","فارِسُ الجَيْشِ راهِبُ المِحْرَابِ",38,"ب",1,0],["أَلتِّبْرُ كِسْرَى وَحْدَهَ فِي فَارِسٍ","وَيَعُدُّ أُمَّةَ فَارِسٍ أَرْذَالاَ",39,"ل",2,0],["أَلتَّاجُ فَوْقَ التَّاجِ مِنْ أَغْصَانِهَا","حَتَّى تُرَصِّعَهُ الْعُلَى بِكَوَاكِبِ",40,"ب",1,0],["آلُ تَقْلا لَقَدْ مَحَضْتُهُمُ الوُدَّ","وَإِنَّ الوَفَاءَ فِي الوُدِّ دِينِي",41,"ن",2,0],["أَلتَّاجُ بَعْدَ أَبِيكَ قَدْ آثَرْتَهُ","بِالطَّوْعِ مِنْكَ لِمَنْ لَهُ الإِيثَارُ",42,"ر",1,0],["ألتقيه بمهجة تذرف الحب","ووجه يحلو له الابتسام",43,"م",1,0],["التا