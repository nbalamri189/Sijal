{"poems":[[77,"قال لي عندما أتى بجدال","https://www.aldiwan.net/poem36057.html","الخفيف"],[9,"قالت سمية إذ رأت","https://www.aldiwan.net/poem21977.html","مجزوء الكامل"],[93,"ألتوأمان اللذان كانا","https://www.aldiwan.net/poem9781.html","عموديه"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[83,"لو تروا حب ما اجمل","https://www.aldiwan.net/poem54199.html","الخفيف"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[23,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem21428.html","السريع"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[29,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[91,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[70,"التحى الأمرد الذي","https://www.aldiwan.net/poem42804.html","مجزوء الخفيف"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[85,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[85,"قصر الأعزة ما أعز حماكا","https://www.aldiwan.net/poem7925.html","الكامل"],[85,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[43,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[28,"إني رأيت أبا الأشبال قد ذهبت","https://www.aldiwan.net/poem5211.html","البسيط"],[49,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[97,"يا حبيب الروح يا روح الأماني","https://www.aldiwan.net/poem24800.html","الرمل"],[97,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[69,"الترك ملح الأرض في عصرنا","https://www.aldiwan.net/poem28737.html","السريع"],[69,"التاجر الخياط قاض عندنا","https://www.aldiwan.net/poem29146.html","الكامل"],[105,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[81,"من منصفي من سقيم الطرف ذي حور","https://www.aldiwan.net/poem61520.html","البسيط"],[102,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[46,"من صفة الدنيا التي أجمع النا","https://www.aldiwan.net/poem22219.html","السريع"],[46,"نعم الوساد يميني ما بقيت لها","https://www.aldiwan.net/poem22457.html","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30436","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141932","الخفيف"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[9,"قَالَتْ سُمَيّة ُ، إذْ رَأتْ","https://www.poetsgate.com/ViewPoem.aspx?id=25459",""],[45,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[28,"آل تميم ألا لله أمكم","https://www.poetsgate.com/ViewPoem.aspx?id=21516",""],[105,"فزع الدجى لأنينه المتردد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54897&r=&rc=67",""]],"verses":[["اِلْتَمِسْ مَخْرَجاً يُوَافِقُ قَوْلِي","قُلْتُ أَحْسَنْتَ يَا جَلاَل التِّينِ",0,"ن",1,0],["التارِكُ الكَسبَ الخَبي","ثَ إِذا تَهَيَّأَ لِلقِتالِ",1,"ل",1,0],["أَلْتَوْأَمَانِ اللَّذَانِ كَانَا","كِلاَهُمَا زِينَةَ الشَّبَابِ",2,"ب",1,1],["أَلتَّارِكِينَ لِغَيْرِهِمْ","نَزَقَ الطُّفُولَةِ وَالدِّعَابَا",3,"ب",2,0],["أَلتُّرْبُ لِلأَجْسَامِ مُصْطَنَعٌ","وَنَوَاسِمُ الأَرْوَاحِ لِلنَّسَمِ",4,"م",1,0],["أَلتَّاجُ تَاجُ مُمَلَّكِينَ عِظَامِ","صَوْغُ النَّدَى وَالحَزْمِ وَالإِقْدَامِ",5,"م",1,1],["التواضع مع الجلال","والكمال حاز مع الجمال",6,"ل",1,0],["إلّ تطلب ان تدارك","بجرى شمس الظهيرا",7,"ر",2,0],["التارِكِ القِرنَ لَدى قِرنِهِ","يَعثُرُ في ذي الخُرُصِ الذابِلِ",8,"ل",1,0],["ألتقيه ويحسبُ الهجرَ قلبي","فكأنِّي ما نلتُ طيبَ اللقاء",9,"ا",2,0],["آلَت إِلى النِصفِ مِن كَلفاءَ أَترَعَها","عِلجٌ وَلَثَّمَها بِالجَفنِ وَالغارِ",10,"ر",1,0],["أَلَ تَرَ مُنذُ اِستُلينَت قَناتُهُ","تَمَشَّت إِلَيهِ الحادِثاتُ تُساوِرُه",11,"ر",2,0],["اِلتَحى الأَمرَدُ الَّذي","كانَ في التيهِ مُسرِفا",12,"ف",2,1],["الترقي إذا افتكرت مليا","في خلاف الشعوب لافي الوئام",13,"م",1,0],["التَقَتِ الأَحزابُ بِالأَحزابِ","وَاِقتَتَل الجَمعان حَولَ الزاب",14,"ب",1,0],["التُركُ تَقرَأُ بِاِسمِ جَدِّكَ في الوَغى","وَالعُربُ تَذكُرُ في الكِتابِ أَباكا",15,"ك",2,0],["التاجُ فُصِّلَ في سَمائِكَ بِالضُحى","مِنكَ الحِلى وَمِنَ الضُحى الأَنوارُ",16,"ر",1,0],["اِلتامَتِ الأَحزابُ بَعدَ تَصَدُّعٍ","وَتَصافَتِ الأَقلامُ بَعدَ تَلاحي",17,"ح",2,0],["آلَت لَئِن لَم تَرِد أَزميرَ لا نَزَلَت","ماءً سِواها وَلا حَلَّت عَلى عُشُبِ",18,"ب",1,0],["التارِكينَ مِنَ الأَشياءِ أَهوَنَها","وَالراكِبينَ مِنَ الأَشياءِ ما صَعُبا",19,"ب",2,0],["اِلتَقَت في رَبيعَةَ اِبنِ نِزارٍ","بَينَ أَعيانِها سَراةُ جُدودِه",20,"د",2,0],["التَقِيُّ النَقِيُّ وَالفاضِلُ المُف","ضِلُ فينا وَالمُرتَضى المُختارُ",21,"ر",1,0],["التَرامي بَعدَ الوَجيفِ إِذا إِستُؤ","نِفَ خَرقٌ وَالوَخدُ قَبلَ الرَسيمِ",22,"م",1,0],["التارِكُ القِرنِ تَحتَ النَقعِ مُنجَدِلاً","إِذا تَلاحَقَ وِردُ المَوتِ فَاِعتَكَرا",23,"ر",2,0],["التَقِيُّ البَرُّ مَن يَنبُذُها","وَالمُحامي دونَها الخِبُّ الخَدِع",24,"ع",1,0],["التقت أرواحنا في ساحةٍ","كغريبين استراحا من سَفر",25,"ر",1,0],["التقينا كما التقى بعد تطواف على القفر في السرى انضاء","قطعوا شَوطهم على الدم والشوك وراحوا على اللهيب وجاءوا",26,"ا",1,0],["آلَت أُمورُ الشِركِ شَرَّ مَآلِ","وَأَقَرَّ بَعدَ تَخَمُّطٍ وَصِيالِ",27,"ل",1,1],["التركُ ملحُ الأرضِ في عصرِنا","والفلَكُ الدائرُ في سعدِهمْ",28,"م",1,1],["التاجر الخيّاطُ قاضٍ عندنا","ولديهِ يَثبتُ ردةً وفسوقُ",29,"ق",1,1],["التركُ والعربُ الأُباةُ أنوفُهم","سيفان في لُجَجِ الوَغى غَرِقانِ",30,"ن",1,0],["التُركُ جُندُ اللَهِ لَولا بَأسُهُم","لَم يَبقَ في الدُنيا مُقيمُ أَذانِ",31,"ن",1,0],["التاجُ لا يَحميهِ غَيرُ مُجَرِّبٍ","يَزِنُ الأُمورَ وَيُقدِرُ الأَحوالا",32,"ل",2,0],["التُّقَى والبرُّ في تاجَيْهِمَا","هل رأى التاجَيْنِ أعلى المالكين",33,"ن",1,0],["آلَت لَواحِظُهُ أَلّا يَعيشَ لَها","قَلبٌ وَلَو أَنَّهُ في قَسوَةِ الحَجَرِ",34,"ر",1,0],["أَلتَمسُ البابَ لا أَفوز بِهِ","أَطوف بِالدار لَست أُبصرها",35,"ر",3,0],["إِلتَفَّت الآمالُ مِنّا بِها","وَقَد مَضى آمَلُها ما اِلتَفَت",36,"ت",1,0],["التُربُ جَدّي وَساعاتي رَكائِبُ لي","وَالعَيشُ سَيري وَمَوتي راحَةُ الجَسَدِ",37,"د",1,0],["التَّقيُّ النَّقِيُّ كَهْلاً وطِفْلاً","فارِسُ الجَيْشِ راهِبُ المِحْرَابِ",38,"ب",1,0],["أَلتِّبْرُ كِسْرَى وَحْدَهَ فِي فَارِسٍ","وَيَعُدُّ أُمَّةَ فَارِسٍ أَرْذَالاَ",39,"ل",2,0],["أَلتَّاجُ فَوْقَ التَّاجِ مِنْ أَغْصَانِهَا","حَتَّى تُرَصِّعَهُ الْعُلَى بِكَوَاكِبِ",40,"ب",1,0],["آلُ تَقْلا لَقَدْ مَحَضْتُهُمُ الوُدَّ","وَإِنَّ الوَفَاءَ فِي الوُدِّ دِينِي",41,"ن",2,0],["أَلتَّاجُ بَعْدَ أَبِيكَ قَدْ آثَرْتَهُ","بِالطَّوْعِ مِنْكَ لِمَنْ لَهُ الإِيثَارُ",42,"ر",1,0],["ألتقيه بمهجة تذرف الحب","ووجه يحلو له الابتسام",43,"م",1,0],["التاركون الأرضَ من","دمكم مُوردَّة الخدود",44,"د",1,0],["آلتْ سَدَانَتُه إليكم، فاسمحوا","ليّ بالوقوف ولوْ على أعْتَابه",45,"ب",2,0],["التَبَسَت أيامي عليَّ فلا","أفْرق ما بين السبت، والأحد",46,"د",1,0],["التابعين مقالهم","قبل التكلم بالفعال",47,"ل",1,0],["\" التَيْمِسيّونَ ! \" الَّذين تناهبوا","هذي البلاد حبائباً وأقاربا",48,"ب",2,0],["التّركُ الكسبَ الخبي","ثَ، إذَا تَهَيّأ للقِتَالِ",49,"ل",1,0],["إلتَقَتْ في رَبيعَةَ بنِ نِزَارٍ،","بَينَ أعيَانِها، سَرَاةُ جُدودِهْ",50,"د",2,0],["آلَ تَمِيمٍ ألاَ لله أُمُّكُمُ!","لَقَدْ رُمِيتُمْ بإحدى المُصْمَئِلاّتِ",51,"ت",1,1],["التاركات الأرض بين رواسخٍ","نزق الجوانب أو شوامخ ميد",52,"د",1,0]]}