{"poems":[[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[47,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[82,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[107,"أعن خطب الخلافة تسألينا","https://www.aldiwan.net/poem42132.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[7,"قالت بنو عامر خالوا بني أسد","https://www.aldiwan.net/poem1972.html","البسيط"],[48,"تولي يا خبيثة لا هلمي","https://www.aldiwan.net/poem23623.html","الوافر"],[48,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[1,"إني من القوم الذين إذا","https://www.aldiwan.net/poem34001.html","الكامل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67327","الكامل"],[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[244,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[353,"ولرب جمع من عداك لقيته","https://www.aldiwan.net/poem20700.html","الكامل"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[443,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100590","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59231","الرمل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128067","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108471","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77291","الكامل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105330","الطويل"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138836",""],[3425,"","https://poetry.dctabudhabi.ae/diwan/poem/147216","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62798","الكامل"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202276",""],[3926,"","https://poetry.dctabudhabi.ae/diwan/poem/145513","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4293,"","https://poetry.dctabudhabi.ae/diwan/poem/18203","المنسرح"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81682","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[4816,"ربى العين","https://www.poetsgate.com/ViewPoem.aspx?id=8474",""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""]],"verses":[["وَلَّوا وَأَيديهِم عَلى هاماتِهِم","فَكَأَنَّما تِلكَ الأَكُفُّ مَعاجِرُ",0,"ر",1,0],["ولّوا وحَبُّ قُلوبهم","بالطَّعْن من دبرُ يحلُّ",1,"ل",1,0],["وَلَو أُواجِهُهُ مِنّي بِقارِعَةٍ","ما كانَ كَالذِئبِ مَغبوطاً بِما أَكَلا",2,"ل",2,0],["وَلِواؤُهُ المَعقودُ يُقسِمُ في غَدٍ","أَن سَوفَ يَصنَعُ فيهِ ما لَم يُصنَعِ",3,"ع",1,0],["وَلِواؤُكَ تَقْدُمُ هَيْبَتُهُ","بعديدٍ يُلبِكُ في العَدَدِ",4,"د",1,0],["وَلَّوا وَأَغشَيتَهُم شُمّاً غَطارِفَةً","لِغَمرَةِ المَوتِ كَشّافينَ لا كُشُفا",5,"ف",2,0],["ولو أوتيتِ بِرّاً أو وَفاءً","إذنْ لَظَعَنتِ إثرَ الظّاعنينا",6,"ن",2,0],["ولو أُوتِيتَ سؤلكَ لم تَنَلْها","مطامعَ تصرعُ المُتطاولينا",7,"ن",2,0],["وَلَّوا وَكَبشُهُمُ يَكبو لِجَبهَتِهِ","عِندَ الكُماةِ صَريعاً جَوفُهُ دامِ",8,"م",1,0],["وَلَو أوتيتُ في الأَيّامِ لُبّاً","تَقارَضَتِ الوِدادَ وَلَم تُقالي",9,"ل",2,0],["ولو أوْدَعُوكَ الجوّ خِفْنا مَصيفَهُ","ومَشتاهُ وازدادَ الضّنينُ منَ الضّنِّ",10,"ن",1,0],["وَلّوا وَأَعطَونا الَّذي سُئِلوا","مِن بَعدِ مَوتٍ ساقِطٍ أُزُرُه",11,"ر",2,0],["وَلَّوا وَهُنَّ يَجُلنَ في آثارِهِم","شَلَلاً وَبالَطناهُمُ فَتَكَبكَبوا",12,"ب",3,0],["ولَّوا وَدَلُّوا في الضّريحِ أَخَاهُمُ","مَاذَا أَجَنَّ ضَرِيحُهُ المَسْقُوفُ",13,"ف",1,0],["وَلَّوا وَلَو أَوغَلتَ تَطلُبُ إِثرَهُم","لَم يَحمِ مَلكُ الرومِ مِنكَ طَريدا",14,"د",2,0],["وَلَّوا وَقَد أَلقَوا أَعِنَّةَ خَيلِهِم","وَأَتَوا وَقَد سُلِبَت قِلاصُهُمُ البُرى",15,"ر",2,0],["وَلَّوا وَأَكثَرُ قَولِ مَن فاتَ الوَغى","ما في الحَياةِ لِعامِرِيٍّ مَطمَعُ",16,"ع",1,0],["ولواؤك المنصور فوق قناته","وله المهيمن ناصر وكفيل",17,"ل",1,0],["وَلّوا وَعُقبانُ المَنونِ مُسِفَّةٌ","وَالخَيلُ تَعثُرُ بِالقَنا المُتَكَسِّرِ",18,"ر",1,0],["وَلُّوا وقد وَلَّيْتَ سَيفَكَ أَمرَهُمْ","فَحَسمْتَ داءَهُمُ بِوالٍ صَارِمِ",19,"م",1,0],["ولَّوا وأشجعُهم قد صار أفرقَهم","لما رُمُوا بسهام الذل والفشل",20,"ل",1,0],["ولّوا وجاءهم أخيرا بعد ما","قد فاز بالتقديم والإقدام",21,"م",1,0],["ولو آوى لقنته ابن نوح","نجا من ذلك الغرق الشديد",22,"د",1,0],["وَلِواوٍ مِن بَعدِ ميمٍ تَولَّى","حفظ ثَغر تَفاخَروا في بِناه",23,"ا",2,0],["وَلواوٍ مِن بَعد نُونٍ أَتى مص","رَ بِعزٍّ وَحَولَهُ حُكَماه",23,"ا",2,0],["ولواؤك المنصور في طياته","تاريخ مصر وآلك الأبطال",24,"ل",1,0],["ولواؤك الخفاق منشور على","زهر البلاد حواضرٍ وبواد",25,"د",1,0],["وَلِوَاوِ الصُّدْغِ سِرٌّ وَاضِحٌ","ثَلَّثَ الشَّكْلَ عَلَى سَطْحِ النُّقَطْ",26,"ط",1,0],["ولواو ولوا غيرهم","كم دال في الدنيا دول",27,"ل",1,0],["ولواؤها المعقود بات منكساً","في البحر من أسفٍ على ابطالها",28,"ل",3,0],["وَلِوَاؤهُم بِيَدِ الرَّسُولِ مُحَمَّدٍ","وَالكُلُّ تَحتَ لِوَاءِ ذِي الفُرقَانِ",29,"ن",1,0],["وَلِواؤُها بِيَدِ الثُرَيّا خافِقٌ","وَسَريرُها فَوقَ السُها مَحمولُ",30,"ل",1,0],["ولو اوجست من حرس الحي خيفة","تلوذ بليل بث ظلمائه الشعر",31,"ر",1,0],["ولَّوا ولم يحذروا عاراً وقد نظروا","شزراً مناياهمُ في رأس يعسوب",32,"ب",1,0],["ولواؤه لبس الحداد فهل ترى","كان الشعار لفقده يستشعر",33,"ر",1,0],["ولّوا وكمْ هَزَمَتْهُمُ من طعنةٍ","تنفي السبارَ وضربةٍ ما تُرقعُ",34,"ع",1,0],["ولوا ولم يحووا سوى","خزي وتهلكهم هنالك",35,"ك",1,0],["ولو أوجب الخيرات خلدا لأهلها","لكان له الخلد المحبب موجبا",36,"ب",2,0],["وَلَّوا وَمُشتَدّاً عَلَيهِم حَمَلا","بِالرُمحِ يُردي بَطَلاً فَبطلا",37,"ل",2,0],["ولُّوا وقلبُ شجاعهمْ في صدرهِ","كالسَّيف يُرعِدُ في يمينِ جبانِ",38,"ن",1,0],["وَلَّوا وَأَرماحُنا حَقائُبَهُم","نُكرِهُها فيهِمُ وَتَنأَطِرُ",39,"ر",1,0],["ولو أوفتِ الأيامُ وانقضتِ النوى","لما سَمَحَتْ عينُ الرَّقيبِ بإغفاءِ",40,"ا",2,0],["ولوا وصاروا وها أنا لبد","فهل رأيتم من فوقهم أحدا",41,"د",2,0],["ولو اوصفه ماجزيت حق ولا دين","تخجل حروف الضاد ما تمتثله",42,"ل",2,0],["ولواؤنا الخفاق فوق رؤوسنا","بالنصر يعلو فى شموخ مبتسم",43,"م",1,0]]}