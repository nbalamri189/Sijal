ف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[585,"سل عن الكون من يحير جواباً","https://www.poetsgate.com/ViewPoem.aspx?id=161882",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5431,"قم وعلّم جلودهم بالسياطِ!!","https://www.poetsgate.com/ViewPoem.aspx?id=201609",""],[5956,"الأسلوبُ الحديديُّ","https://www.poetsgate.com/ViewPoem.aspx?id=185589",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[5956,"دائماً صهيون تنجو من العقاب","https://www.poetsgate.com/ViewPoem.aspx?id=192311",""],[5956,"معركة بدر الفلسطينية","https://www.poetsgate.com/ViewPoem.aspx?id=192325",""],[5956,"أبطال فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192326",""],[5956,"الظلم والطيبون","https://www.poetsgate.com/ViewPoem.aspx?id=192334",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""]],"verses":[["قُوَّةَ الرَحمَنِ زيدينا قُوىً","وَأَفيضي في بَني الشَرقِ الوِئاما",0,"م",2,0],["قُوَّةُ اللَهِ إِن تَوَلَّت ضَعيفاً","تَعِبَت في مِراسِهِ الأَقوِياءُ",1,"ا",2,0],["قُوّةٌ أرسلها من أمرِه","تَفتحُ الدُّنيا وتَحتلُّ البلادا",2,"د",2,0],["قوة في الكون اِستقرت وأخرى","ما اِستقَرَّت كالجِسم وَالكَهرباء",3,"ا",2,0],["قوَّةُ العِلمِ أَنَّهُ مُلهِمُ الحُسْ","نَى وَحَلاَّلُ أَعْقَدِ المُعْضِلاَتِ",4,"ت",1,0],["قوّة الروح والعقيدة جيشٌ","من لهيب وقائد من صواب",5,"ب",1,0],["قوَّةُ الشعب من قوى خالقِ الشَّعْ","بِ إذا ما تحدَّتِ السلطانا",6,"ن",2,0],["قوة الإيمانِ تُغْني ربَّها","عن غِرار السيف أو سنِّ القناة",7,"ا",2,0],["قوّة من هوى وسحر رمتها","ربّة الشعر في يدي (كوبيد)",8,"د",1,0],["قُوَّةُ الفَمِ مَن يُعَارِضُ فَمًّا","تَفَلَ الشَّيخُ فِيهِ سَعدُ أبِيهِ",9,"ي",2,0],["قوة ما بدت على الطرس إلا","رفعتْ خاملاً وأزرت بعال",10,"ل",1,0],["قوة الله التي ما فوقها","قوة تملك ارسان الأمور",11,"ر",1,0],["قوة الله التي من تحتها","سائر الأكوان ترسو وتمور",11,"ر",1,0],["قوة الله التي في يدها","محور الأكوان والدهر يدور",11,"ر",1,0],["قوة الله التي قد اوحشت","غاب \" جلواح \" من الليث الهصور",11,"ر",1,0],["قوَّةٌ في ذاتهم لو حاولوا","أَنْ يزيلوا جبلاً فيها لزالا",12,"ل",2,0],["قوة للحياة نور ونار ألهما","الكون فهو حر جليل",13,"ل",1,0],["قُوَّةُ الشَّكوَى الَّتي تألمه","قُوةُ العُجمِ وضَعفُ العَربِ",14,"ب",1,0],["قوة العلم بعدها جاء ميعا","دك في الآمرين والناهينا",15,"ن",2,0],["قُوَّةُ السِّحرِ في عيونِ العذارى","زادتِ الحُسنَ والدلالَ اقتدارا",16,"ر",2,1],["قوةٌ زانها حناناً وعلما","خلقُ الفيصلِ الجريء ا لجنانِ",17,"ن",1,0],["قوةٌ أكسبت مليك الضواري","أسدَ الغابِ هيبةَ السلطانِ",17,"ن",1,0],["قُوَّةُ اللَهِ أذهَلَت كلَّ لُبٍّ","فتفانت في وصفِها العُلَماء",18,"ا",2,0],["قوة الحق أضعفت صولة البا","طل ممن بداه بالبدوان",19,"ن",1,0],["قوة جسم المرء حين الصبا","تغنيه عن عقل له يحرس",20,"س",1,1],["قوة النفس في إهاب رقيق","لم تصدق لو لم تكن من سماء",21,"ا",2,0],["قوة اظهرت غرائب فعل","اعجز القول وصفها المستبين",22,"ن",1,0],["قوَّة وبَاسْ ومالْ يِبْهَضْ","وجيوش جَوّ وبَحرٍ وطود",23,"د",1,0],["قوةُ مصرَ القاهره","على سِواها ظاهره",24,"ه",1,0],["قوة الإيمان لا ترهب ما","حشد الطغيان من جيش عتيد",25,"د",1,0],["قوة الإيمان لا تعد لها","قوة النار ولا بأس الحديد",25,"د",1,0],["قوة الكهرباء أودع فيها","اللَه سراً من أعظم الأسرار",26,"ر",1,0],["قوةٌ تستبيحُ ضُعفاً وفردٌ","مسترِقٌّ شعباً بالاستبدادِ",27,"د",1,0],["قوّةٌ من جوانب العرش هبّت","ذاب من بأسها الحديد المشهّر",28,"ر",1,0],["قوة ثم طاقةٌ فانطلاق","مر فانقض جيئةً وذهابا",29,"ب",2,0],["قوة قاهرةٌ جا","ءتك ما الحيلة فيها",30,"ا",1,0],["قوة الحدس أن تفك رموزا","لك تبدو بعيدة الارتباط",31,"ط",1,0],["قوّة الأسلوب عندي بِنْتُ فنٍّ","وابتكار وهو للأجيال زِيُّ",32,"ي",1,0],["قوة الصهيون ليست قوةً من","ها ولكنْ من نُطافِ الغُرَبا",33,"ب",2,0],["قوة الصهيون ليست قوةً من","ها ولكنْ من مدادِ الغُرَبا",34,"ب",2,0],["قوة الإيمان تمحو رُعُباً","أمتي منه تقاسي حِقَبَا",35,"ب",2,0],["قوةٌ شعبيةٌ ما حدثت","غير في عهد الرسول المجتبى",36,"ب",2,0],["قوة اللص تحيل الحرّ عبداً","وتنيل الحرّ شكّاً في مِشاهُ",37,"ا",2,0],["قوة المرء له حجته","وهي إن يظلم تقف في الناس عذره",38,"ر",2,0]]}