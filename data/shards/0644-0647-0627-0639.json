diwan/poem/105373","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141643","الرجز"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204203",""],[4927,"رندة","https://www.poetsgate.com/ViewPoem.aspx?id=29627",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[5183,"الخيزران والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180267",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5277,"مهاةُ بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=193969",""],[5376,"دخلْتُك آمناً ولك ائتلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188462",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[3469,"نأتك أمامة ُ إلا سُؤالاً","https://www.poetsgate.com/ViewPoem.aspx?id=17626",""],[5667,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=214915",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[5956,"فؤادي غير مقتنع","https://www.poetsgate.com/ViewPoem.aspx?id=182482",""],[5956,"نايُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206677",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[572,"غَادِيَة ٌ والشّمسُ في طِرَادِهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9256&r=&rc=113",""],[5064,"شروحُ الفتوح على أسانيد بلقيس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87507&r=&rc=2",""]],"verses":[["لَها عِدَّةٌ بِالوَصلِ يوعِدُ غِبَّها","مَصاليتُ يُنسى في وَعيدُهُمُ الوَعدُ",0,"د",1,0],["لَها عَجُزٌ كَصَفاةِ المَسي","لِ أَبرَزَ عَنها جُحافٌ مُضِر",1,"ر",1,0],["لَها عُذُرٌ كَقُرومِ النِس","رُكِّبنَ في يَومِ ريحٍ وَصَر",1,"ر",1,0],["لَها عَينانِ مِن أَقِطٍ وَتَمرٍ","وَسائِرُ خَلقِها بَعدُ الثَريدُ",2,"د",1,0],["لَها عَينُ كَحلاءِ المَدامِعِ مُطفِلٍ","تُراعي نَعاماً يَرتَعي بِالخَمائِلِ",3,"ل",1,0],["لَها عَقلُ نِسوانٍ وَشَرُّ شَريعَةٍ","نَزورٌ نَداها حينَ يُبغى بُحورُها",4,"ر",3,0],["لها عولةٌ أولى بها ما تُصيبُه","وأجدرُ بالإعوال من كان موجَعا",5,"ع",2,0],["لها على عزة الأقدار إن مطلت","حلم الليوث إذا ما أستأخر السلب",6,"ب",1,0],["لَها عَلَمٌ فَوقَ الهِلالِ وَسُدَّةٌ","تُنَصُّ عَلى هامِ النُجومِ وَتُنصَبُ",7,"ب",1,0],["لَها عِندُهُ أَن يَرجِعَ اليَومَ روحُها","إِلَيها وَتَنجو مِن حِذارِ المَهالِكِ",8,"ك",1,0],["لها عَنَمٌ في غُصُونِ البنان","يَعُلّ نَدى أُقحُوانٍ بشاما",9,"م",2,0],["لها عَبَقٌ من رَحْمَةِ اللَّهِ لم يَزَلْ","مَكانُكُما منه إلى اليومِ عاطرا",10,"ر",2,0],["لها عامرٌ عِنْدَ البلاءِ وياسرٌ","لها مَرْحَبٌ والحارثُ البطلُ الفَحْلُ",11,"ل",1,0],["لها على الكُرهِ في أرجائِها لغةٌ","كما تردَّدَ في الأسماعِ ترتيل",12,"ل",1,0],["لَهُ اِعتِدالٌ وَاِنتِصابُ قَدٍّ","مَحودَبِ الظَهرِ كَريمُ الجَدِّ",13,"د",1,0],["لَها عَشرُ دَجاجاتٍ","وَديكٌ حَسَنُ الصَوتِ",14,"ت",1,0],["لها عدد الرمل المبر على الحصى","ولكنها عند اللقاء جبال",15,"ل",1,0],["لَهَا عَبَثَاتٌ عِنْدَ كُلِّ تَحِيَّةٍ","تَسُوقُ إِلَيْهَا عَنْ فَرائِسِها الأُسْدَا",16,"د",2,0],["لهَا عَلَى الوَاجِبِ صَبْر وَإِنْ","شَقَّتْ وَمَرَّتْ شِرْعَةُ الصَّبْرِ",17,"ر",1,0],["لَها عُذُرٌ كَقُرومِ النِسا","رُكِّبنَ في يَومِ ريحٍ وَصَر",18,"ر",1,0],["لها على القلب ميثاق يبوء به","ان باء بالحب في الأوطان إيمان",19,"ن",1,0],["لها على سُؤاله ازدحامُ","ذاتُ سماء مالَها إنْجامُ",20,"م",1,0],["لها عضدٌ لو أبصر المرء عابداً","لصار لها عبداً وصار مخدّما",21,"م",2,0],["لَها عاذِلوهُ في اللُهى عَن مَلامِهِ","فَعَذلُهُمُ جَزرٌ وَأَنعُمُهُ مَدُّ",22,"د",1,0],["لها على الإرقالِ والتمرُّد","عَزُّ الموالي واحتمالُ الأعْبُد",23,"د",1,0],["لَها عَجُزٌ كَالبابِ شُدَّ رِتاجُهُ","وَمُستَتلِعٌ بِالكورِ ضَخمُ المُكَدَّمِ",24,"م",1,0],["لها عبق من نشرها يكتفي به","عن العنبر الورد الذي ضاع ناشقه",25,"ق",2,0],["لَهَا عَجَمٌ فِي العُربِ وُلِّدَ مُنجِياً","وَحَسْبُكَ مِنْها بِالسَّوامِي السَّوامِقِ",26,"ق",1,0],["لها عَرْفٌ وعَرْف الشُّهْب ألا","يَكونُ لَها سوى صَدْع الدياجي",27,"ج",2,0],["لها عَلَقٌ بالنفسِ والقلب لوطةٌ","ودرك لحاجاتِ النفوسِ كماهيا",28,"ي",2,0],["لها عَلَى العينِ أَنْ تذري المدامعَ أَو","يَخْضَلَّ فيها يبيسُ العشبِ واليبس",29,"س",1,0],["لها عطفٌ كغصن البان أضحى","ترنحه الصبا فوق الروابي",30,"ب",2,0],["لَها عَمَلٌ لَم تَجنِ فيهِ خَطيئَةً","تَقاضى بِهِ أَديانَها ثُمَّ لا تَقضي",31,"ض",2,0],["لَها عِندَ تَحريك الجُفون سُكونُ","أَلا يا نَدامى قَد أَضَرَّ بِيَ الجَوى",32,"ج",3,0],["لها عجائب لا تحصى مواقعُها","جليلة القدر والمقدار في الأمم",33,"م",1,0],["لَها عَلى الغيد فَضل مِثلَ ما فَضُلَت","كَفّا الرَئيس أَبي عَمروٍ عَلى المَطَرِ",34,"ر",1,0],["لها عُقبانُ أعلامٍ سَوامٍ","يكونُ من النُحورِ لها وُكونُ",35,"ن",1,0],["لها عهود على الدنيا موثقة","فطالما حبت الدنيا بإحسان",36,"ن",1,0],["لها علاها فإن وجدتم","طولاً إلى نيلها فطولوا",37,"ل",3,0],["لها عَمَدٌ على صدر الليالي","وفوق أوائل الدنيا طُنوبُ",38,"ب",1,0],["لَها عُضوان مِن عَصَبٍ وَلَحمٍ","وَسائِرُ جِسمِها مِن خَيزُرانِ",39,"ن",1,0],["لها عيونٌ من عيونٍ قد جرت","رشت على قيعانها سجالها",40,"ل",3,0],["لها عروة في راحتي كل مسلم","وحبل بأيدي المؤمنين متين",41,"ن",1,0],["لَها عُيوبٌ عَليها","يُحِبّها مَن يُحبُّ",42,"ب",1,0],["لَها عَجُزٌ بِالرَملِ فَالحُزنُ فَاللِّوى","وَقَد جاوَزَت حَيَّيَيْ جديسٍ رِعالُها",43,"ل",3,0],["لها على الموثق الدينيِّ متَّكلٌ","يوم الكفاح ومن إيمانها عدد",44,"د",1,0],["لها عزُّ السلاطينٍ","ولي ذلُّ المساكين",45,"ن",1,0],["لها على الرأس إكليل يحيط به","أو جمة قص أعلاها شَوابيرا",46,"ر",2,0],["لَهُ أَعنَزٌ حُوٌّ ثَمانٍ كَأَنَّما","يَراهُنَّ غُرَّ الخَيلِ أَو هُنَّ أَنجَبُ",47,"ب",1,0],["لها عند عون الذين ذي الطول","مربع جميم وأمواه تسيل جمامُ",48,"م",1,0],["له أعاريض ثلاث واسدسن","ضروبه والجزء في كل حسن",49,"ن",1,0],["له أعاريض ثلاث ضمنت","لستّة فابدأ كضرب خبنت",49,"ت",1,0],["له أعاريض ثلاث وردت","وتسعة من الضروب قد بدت",49,"ت",1,0],["له أعاريض بخلف أربع","وخمسة من الضروب تتبع",49,"ع",1,0],["له أعاريض ثلاث أقبلت","ومثلها من الضروب أعملت",49,"ت",1,0],["لها عندنا بين الوشاة مودة","وذكر على ما أحدث 