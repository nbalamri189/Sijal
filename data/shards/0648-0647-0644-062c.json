{"poems":[[85,"أزور بقلبي معهد الأنس والهوى","https://www.aldiwan.net/poem54265.html","الطويل"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[64,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[47,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[76,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85482","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[132,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[147,"أسكان نعمان الأراك تيقنوا","https://www.aldiwan.net/poem11829.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[197,"أبا جعفر هل فضضت الصدف","https://www.aldiwan.net/poem13077.html","المتقارب"],[215,"رجعت إلى مهد الصبابة والهوى","https://www.aldiwan.net/poem46314.html","الطويل"],[266,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[309,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[358,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[358,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[408,"لحيدرة الفضل دون الورى","https://www.aldiwan.net/poem46980.html","المتقارب"],[447,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[447,"أيا أهل القبور فما جواب","https://www.aldiwan.net/poem14369.html","الوافر"],[458,"بني معروف جاحدكم جحود","https://www.aldiwan.net/poem61351.html","الوافر"],[469,"سلوا بالحمى أين الظباء السوانح","https://www.aldiwan.net/poem3587.html","عموديه"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138327",""],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39024","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129528","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199033","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46471","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109419","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109462","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77293","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60971","الطويل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28306","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48329","الطويل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129405","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85054","السريع"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78346","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94474","الطويل"],[4720,"أحبك يا تاج كل النساء","https://www.poetsgate.com/ViewPoem.aspx?id=69122",""],[4755,"أَسَرَّت إِلى أُختِها","https://www.poetsgate.com/ViewPoem.aspx?id=190547",""],[585,"يا جيرة البان مهلاً واسألوا البانا","https://www.poetsgate.com/ViewPoem.aspx?id=161926",""],[5189,"ويغفر للجناةِ التائبينا","https://www.poetsgate.com/ViewPoem.aspx?id=216020",""],[5190,"الطين والماء","https://www.poetsgate.com/ViewPoem.aspx?id=82169",""],[5725,"قابيل الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=186343",""],[6052,"سلام الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=34888",""],[6102,"يَارَا","https://www.poetsgate.com/ViewPoem.aspx?id=185333",""]],"verses":[["وهل جيرتي الأولى كما قد عهدتُهم","يُوالون بالإحسان من جاء سائلا",0,"ل",2,0],["وهل جعلوا منه الدماغ برأيه","ليقبل ديناً أو ليجتنب الكفرا",1,"ر",2,0],["وهل جذوةُ النارِ التي يُوقِدُونَها","لها حيث شَبُّوها دليلٌ على كبْدي",2,"د",2,0],["وَهَل جُرحٌ يُرَبُّ بِغَيرِ آسٍ","وَهَل غَرسٌ يَطولُ بِغَيرِ ماءِ",3,"ا",2,0],["وَهَلَ جَمَعَ العِدى إِلّا هَشيمٌ","وَهَل بيضُ السُيوفِ سِوى لَهيبِ",4,"ب",1,0],["وهل جائزٌ فيهِ عَمِيدٌ سَمَيْذَعٌ","وسائلُهُ ضَخْمُ الدّسيعِ عَمِيد",5,"د",1,0],["وَهَل جَعَلَ الشائِماتِ الوَميضَ","تَوانِيَ غَيرُ اِتِّصالِ التَواني",6,"ن",2,0],["وَهَل جَميل عليها ال","فراش حين يطير",7,"ر",1,0],["وهل جبهت بحدّ السيف دعوى","كعرض القوم فاجرة وقاحا",8,"ح",2,0],["وهل جيرةٌ بالمنحنى شتَّ شملُهم","أم الشملُ مجموعٌ بساحةِ حاجرِ",9,"ر",1,0],["وَهَل جَرَّدَت أَسيافَ بَرقٍ دِيارُكُم","فَكانَت لَها إِلّا جُفونِيَ أَجفانُ",10,"ن",1,0],["وَهل جائِزٌ أَن يجعلَ اللَّه دينه","يَعودُ عليهِ بالحقارةِ والإزرا",11,"ر",2,0],["وَهَل جُبتَ لَيلاً بِلا حِشمَةٍ","لِطُولِ السُرى سُدَفاً في سُدَف",12,"ف",1,0],["وهل جاد وهاب النفائس منعما","بمثلك في شرقٍ هنالك أو غرب",13,"ب",1,0],["وهل جرد الأعداء في حومة الوغى","على باسل امضى من الحب مرهفا",14,"ف",2,0],["وهل جرى قدر بالوصل في قدم","فالأمر والشان سبق الحكم والقدر",15,"ر",1,0],["وَهَل جررت بِهِ ذَيل الصَفاء عَلى","بِساط سُندسه المَنسوج أَخضرهُ",16,"ر",2,0],["وهل جاهِلٌ إلّا عدوٌّ لِنفسه","فَكَيفَ يُرى مِنهُ الصَديق المُحَبَّبُ",17,"ب",1,0],["وهَل جُنُبٌ مِنكمُ غيرُه","أُحِلَّ لَهُ اللّبثُ في المسْجدِ",18,"د",1,0],["وهل جسم يطيق وداع روح","وهل روح تدوم على المواز",19,"ز",1,0],["وهل جيرانكم أهل القبور","يزوروا أم أسارى للنشور",20,"ر",1,0],["وهل جبل الدروز سوى منار","سليل الشمس في وحي وعطف",21,"ف",1,0],["وهل جاده سنٌّ من البرق ضاحك","يغازله جفنٌ من المزن سافح",22,"ح",1,0],["وهل جاءها غ بنية قصرها","ولا نص في تقيدها حين يبتدي",23,"د",2,0],["وهل جهلن عروسا في البهاء بدت","تفوقهن فكانت للحجى هدفا",24,"ف",2,0],["وهل جَرَّ أرْدانا على أجْرعِ الحِمى","فأهْدَى تَحايا رَنْدِه وخُزاماهُ",25,"ا",2,0],["وهل جرت تلك السواقي فسعت","فيه جواري دوحه الغض الجني",26,"ي",1,0],["وَهَلْ جَالَ فِيهَا أدْكَنُ الرَّعْدِ جَودَهُ","كَمَا جَرَّ فضلَ الذيلِ أدهمُ صَاهِلُ",27,"ل",1,0],["وهل جائز ذبح الرضيع بشرعة","فهاتيكم الأديان طراً فسائلوا",28,"ل",3,0],["وَهَل جملٌ بَدا إِلّا حملنا","عَلَيهِ حَملَةً هَتَكَت حِجابه",29,"ب",2,0],["وهل جائزٌ ان تمنح الغير رحمةً","ومن هو مشتاق لها ليس يرحم",30,"م",1,0],["وهل جرى لأحدٌ من الملا","في سالف العصر كهذا الابتلا",31,"ل",2,0],["وَهَل جَوُّ مِصرٍ غَيرُ صَفوٍ مخَيِّم","وَإِن كانَ قَلبي مِنهُ في هَجرِكُم أَصفى",32,"ف",2,0],["وهل جف دمعي منْ حَقائب أذرقى","وهل بِتُّ خُلواً من هواك كمن خلاَ",33,"ل",2,0],["وَهَل جَمَلٌ مُجتابُ ما حالَ دونَها","مِنَ الأَرضِ أَو ريحٌ تَروحُ وَتُبكِرُ",34,"ر",1,0],["وهلْ جُبِرَتْ ياقوتَةٌ تتصدّعُ","ذكَرْتُ رُبوعاً بالحِمى ومعاهِدا",35,"د",2,0],["وهل جاد أرجاء المزرّب صيّب","فبث زرابي النبات مجودها",36,"د",3,0],["وهل جنة الدنيا سوى الأربع التي","حوتك وهل إلا ربيعك عيدها",36,"د",3,0],["وهل جاء في اخبار آل محمد","لنا خبر عن ظاهري وعن كتفي",37,"ف",2,0],["وَهَل جَوهر إلا تجرّد للثرى","مِن الدَمع يحكى عارضاً وَسط أَيكة",38,"ه",1,0],["وَهَل جامدٌ دَمعٌ إِذ القَلب ذائبٌ","عَلى أَثر من عين صحب وَصحبة",38,"ه",1,0],["وهل جناح في سبيل الهوى","لو راش بالتقريب من الجناح",39,"ح",1,0],["وَهَل جادَ الزَمان بِجَمع مال","وَحَيا بِالرِضا دَهر غدور",40,"ر",1,0],["وهل جزعت الاعلى الجزع والنقا","فأعيا رعاها طول طول رغاها",41,"ا",3,0],["وهل جاز أن تثوى الجآذر باقعاً","وتترك أخداراً وخرّ الاسرَّةِ",42,"ه",1,0],["وهل جاز تقليني بنيران ذا القلا","فحكما أما ذا الجور قد جاوز الحدا",43,"د",2,0],["وهلْ جاءَ يَسْقِى فؤادى الحزينَ","من الفرح ؟ أم جاء يذكى البكاءْ ؟",44,"ا",2,0],["وهل جِئتُ بالحُبِّ جُرمًا؟! وهَل","تَأَلَّمتُ إِلَّا لِمَحظُورِهِ؟!",45,"ر",2,0],["وهل جنت رقعة الشطرنج فائدةً","لأن بيدقها قد صار فرزانا",46,"ن",2,0],["وهل جنبت نفسك ما سَتلقى","من الآثامِ إن عمَّرتَ حينا",47,"ن",2,0],["وهَل جِئتَ مِن جَنَّاتِ عَدنٍ إِلَى الثَّرَى","جَمِيلاً وفِي عَينَيكَ سِحرٌ قَدِ اْختَبَأْ",48,"ا",1,0],["وهل جهري سيسمع غيض نوحٍ","اذا ما اغلق الهجران بابا",49,"ب",2,0],["وهل جرَت دمعة ٌ تكوي العيون َ دما","وهل كوَت مثلنا نار تسيل دما",50,"م",2,0],["وَ هَلْ جَرَّبا - مِثلِي - مِن الخَمرِ سَكرَةً ؟","فَشَبَّا , وَ عَنْ طوقِ الصِّبا , هَلْ تَحَرَّرا ؟",51,"ر",2,0]]}