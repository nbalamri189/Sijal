{"poems":[[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[87,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[47,"ما كسبنا من أحمد بن علي","https://www.aldiwan.net/poem65593.html","الخفيف"],[287,"ما حرك الشوق ذكرا منك بالبال","https://www.aldiwan.net/poem32642.html","البسيط"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[463,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133764","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93569","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107525","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35420","البسيط"],[5155,"الطائفية ..في العهد المباد","https://www.poetsgate.com/ViewPoem.aspx?id=176170",""]],"verses":[["ما كَسوبُ العلا بمفترش الخفْ","ض وليس الصَيودُ بالربّاض",0,"ض",1,0],["ما كسليمانَ وَلا عَبدِ المَلِك","وَلا الوَليدِ عاهِلٌ وَلا مَلِك",1,"ك",1,0],["ما كَسَبنا مِن أَحمَدِ بنِ عَلِيٍّ","وَمِنَ النيلِ غَيرَ حُمّى النيلِ",2,"ل",1,1],["ما كَسَّرَت مِنهُ جَفناً غَيرَ مُنكَسِرٍ","وَلا أَمالَت قَضيباً غَيرَ مَيّالِ",3,"ل",1,0],["ما كُسيتْ بعدك المعالي","فخرا ولا حُلِّيتْ بزينِ",4,"ن",1,0],["ماكستُ كفَّ مديرِها","وعلى هوايَ مَدارُها",5,"ر",3,0],["ما كُسِّرت رُجُمُ الجِما","رِ وسُوِّقت بُدُنُ الأضاحي",6,"ح",2,0],["ما كسوت الوجود لطفك إلا","خجل الشوك بالرؤوس الحداد",7,"د",1,0],["ما كسدت تِجارة الشعر بِهم","وَإِنَّما الشاعر فيهم رابح",8,"ح",1,0],["ما كساهُ الربيعُ بالزهر حتى","قصفَ الموتُ منهُ عوداً طريا",9,"ي",2,0],["ما كَسَرَ الكَأسَ مِنهُم شارِبٌ أَبَداً","بَينَ النَدامى وَلا بِالطَيشِ قَد باؤوا",10,"ا",1,0],["ما كسب طائفة يسود لثامها","وسوادها في شدة وشقاء",11,"ا",2,0]]}