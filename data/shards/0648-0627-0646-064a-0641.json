{"poems":[[55,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[57,"ألا يا ليت شعري ما أقول","https://www.aldiwan.net/poem26181.html","الوافر"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[93,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[93,"إذا أطل البدر من خدره","https://www.aldiwan.net/poem62827.html","عموديه"],[72,"أجارتنا حق الجوار عظيم","https://www.aldiwan.net/poem42700.html","الكامل"],[91,"الما بشعر قام كالطلل البالي","https://www.aldiwan.net/poem44841.html","الطويل"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[48,"كريم أناب وما أنبا","https://www.aldiwan.net/poem22154.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[92,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[118,"واني فتى من آل هاشم لم اجل","https://www.aldiwan.net/poem41125.html","عموديه"],[118,"سلوا حمرة الخدين عن مهجة الصب","https://www.aldiwan.net/poem41230.html","عموديه"],[127,"رويداً إنه العيد","https://www.aldiwan.net/poem23773.html","الرمل"],[145,"ودادك في قلبي ألذ من المنى","https://www.aldiwan.net/poem58361.html","الطويل"],[153,"الخوف والأنس شيء ليس يتفق","https://www.aldiwan.net/poem68515.html","الخفيف"],[163,"بكيت لأخفى بالدموع السوافح","https://www.aldiwan.net/poem58950.html","الطويل"],[163,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[172,"أتدري الليالي أي خصم تشاغبه","https://www.aldiwan.net/poem1602.html",""],[226,"أبى الحظ إلا أن يصارعني دهري","https://www.aldiwan.net/poem41876.html","الطويل"],[264,"تحية داع مخلص في دعائه","https://www.aldiwan.net/poem38280.html","الطويل"],[273,"أيا زهرة من حبيبة قلبي","https://www.aldiwan.net/poem35665.html","المتقارب"],[306,"نزلت بالرحبة التي وخمت","https://www.aldiwan.net/poem57765.html","المنسرح"],[369,"لكل حبيب يا حبيب رقيب","https://www.aldiwan.net/poem16925.html","الطويل"],[369,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[369,"أنوما وألحاظ الخطوب سواهر","https://www.aldiwan.net/poem17319.html","الطويل"],[374,"سقيم نهاه سقم جفنيه أن يسلو","https://www.aldiwan.net/poem57172.html","الطويل"],[406,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[406,"قد نظرنا الأبحاث في غاية السؤل","https://www.aldiwan.net/poem33947.html","الخفيف"],[406,"لولا الرجا ما انتهضت إرادة","https://www.aldiwan.net/poem34171.html","الرجز"],[412,"عماد الدين أنت لكل داع","https://www.aldiwan.net/poem31705.html","عموديه"],[419,"جميل الصنيع بأهل الأدب","https://www.aldiwan.net/poem53855.html","المتقارب"],[419,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[440,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[442,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[460,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[460,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[470,"وإني في الجياد لمن تراه","https://www.aldiwan.net/poem60526.html","الوافر"],[481,"دخلت مداخلا لا بد منها","https://www.aldiwan.net/poem37588.html","الوافر"],[484,"بجزع الحمى ظبي حمى ذلك الحمى","https://www.aldiwan.net/poem24477.html","عموديه"],[502,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[516,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[518,"وكان يقودني كلف بسعدى","https://www.aldiwan.net/poem48588.html","الوافر"],[518,"حلفت بمن حجت قريش لبيته","https://www.aldiwan.net/poem48704.html","الطويل"],[553,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[555,"وإني وإسماعيل يوم وداعه","https://www.aldiwan.net/poem68272.html","الطويل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/18690","الوافر"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10407","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21379","الوافر"]],"verses":[["وَإِنّي في زَماني مِن رِجالٍ","مِزاجُ وِدادِهِم ماءُ التَقالي",0,"ل",2,0],["وَأَنّي في بِلادِكُمُ مُقيمٌ","وَلَيسَ إِلى لِقائِكُمُ سَبيلُ",1,"ل",1,0],["وَإِنْ يُفَرِّجْهُمَا فِي مَوْقِفٍ غَضَبٌ","رَاعَتْكَ فُوَّهَةُ البُرْكَانِ وَالْحِمَمُ",2,"م",1,0],["وَإِنِّيَ في كَبتِ العُداة وَكَيدِهِم","كَمَن يَسلُكُ الدَربَ القَصيرَ المُعَبَّدا",3,"د",2,0],["وَإِن يَفُح عِطرُ زُهورِ الرُبى","فَإِنَّما يَعبَقُ كَي تَنشُقيه",4,"ه",1,0],["وَإِنِّيَ فيما يَزعَمونَ لَشاعِرٌ","فَفي كُلِّ وادٍ مِن هَواكِ أَهيمُ",5,"م",1,0],["واني في غيلي كرئبال غيضة","ومن ذا ترى في غيله غير رئبال",6,"ل",1,0],["وَإِنّي في الحُروبِ إِذا تَلَظَّت","أُجيبُ المُستَغيثَ إِذا دَعاني",7,"ن",2,0],["وَإِن يَفرِ خَطباً فَأَهلٌ لَهُ","وَإِلّا فَكَم مِن حُسامٍ نَبا",8,"ب",2,0],["وأني في مكاني ثابت لا","تزلزلني الصواعق والرعود",9,"د",1,0],["وَأَنْ يَفْنَى بِفَخْرٍ مِنْكَ فِيهِ","فَيَأْبَى فَجْرُهُ الثَّانِي طُلُوعَا",10,"ع",2,0],["وإنيَّ في إرضائيَ الشِعرَ حائرٌ","وإني لمأخوذٌ بهذا التضارب",11,"ب",1,0],["واني فتى من آل هاشم لم اجل","عن الود ما دام الخليل ودودا",12,"د",2,1],["واني في الماء القراح اراكم","سألتكمو بالله لا تغفروا ذنبي",13,"ب",2,0],["وإني في الهوى العذري","طراد ومطرود",14,"د",1,0],["وإنىَ في عَجزى عن الشكر سائلٌ","مساعدتى مَن كلَّم الناسَ في المهدِ",15,"د",1,0],["وإن يَفِ لك من عهد الصِّبا زمن","فاضنن به فقليلاً يمكث الرَّمق",16,"ق",1,0],["وإِني في وجدي بقدَّك والرنا","أعرَضُ نفسي للقنا والصفائحِ",17,"ح",1,0],["وإني فيكم سائل كل راجع","إلى فئة من عقله لتحوبوا",18,"ب",3,0],["وَإِن يَفتَخِر بِالفَضلِ فَضلُ بنُ عَبدَلٍ","فَيا بِأَبي أَعراقُهُ وَمَناسِبُهْ",19,"ب",2,0],["وَإِنّي فَتى حرٌّ أَسيرُ عَلى هُدى","ضَميري وَلا أَهوى سِوى الرَجُلِ الحرِّ",20,"ر",1,0],["واني في ارساله مثل مرسل","إلى بابل سحراً وعطراً إلى شحر",21,"ر",1,0],["وإن يَفنَ مثلكِ قلبي فَهل","يَرى الزهرَ فوق عظامي وتربي",22,"ب",2,0],["وإن يفته طاعون بقعتها","فلم يفته من العدا طعنه",23,"ن",2,0],["وَإِنّيَ في أَهلي وَداري لِما أَرى","عَلَيكَ مِنَ السُقمِ الغَريبِ غَريبُ",24,"ب",1,0],["وَإِنِّيَ فارِسُ صَفِّ النِدامِ","فَكُن أَنتَ فارِسَ صَفِّ القِتالِ",25,"ل",1,0],["وَإِنِّيَ في حُبّي لِمَجدِكَ مُغرِقٌ","عَلى أَنَّني مِن بَحرِهِ مُتَبَرِّضُ",26,"ض",1,0],["وإِن يَفتَخِر قومٌ عَليهِ فإنَّما","لَهُم قَولُهُم في فَخرِهم ولَه فِعلُ",27,"ل",1,0],["وإني في روض العلوم مخيم","مقيم على حصد الفوائد ولزرع",28,"ع",1,0],["وأنى في التخصيص بعض حديث","حَسَنٍ قيل وهو غير مفيد",29,"د",1,0],["وأن يفوز في غد بعفوه","يسلكه في سلك أرباب التقى",30,"ا",1,0],["وإني في دمشق ومن حوته","لبعدك ذو اغتراب وانفراد",31,"د",1,0],["وإنِّي فقيرٌ إلى قهوةٍ","ومن لي مثل ذوب الذهب",32,"ب",1,0],["وإنِّي في الغرام وفي التصابي","كمثل محمَّدٍ حزت الكمالا",33,"ل",2,0],["وأن يفوز بكم غيري لجدته","كم من جديد له الأسرار خلقان",34,"ن",1,0],["وأَنِّيَ فِي أَفياءِ ظِلِّكَ أَشْتَكِي","شَكِيَّةَ مُوسى إِذْ تولَّى إِلَى الظِّلِّ",35,"ل",1,0],["وإني في رؤوس عدا","ك ولاَّجٌ على القُحَمِ",36,"م",1,0],["وإن يُفْنِ يومُ البين جُمَّةَ أدمعي","فعند جُفوني للديار نصيبُها",37,"ب",3,0],["وَإِنّي في الجِيادِ لمَن تَراهُ","لطَلقُ الوَجهِ غُرَّتَهُ نَداهُ",38,"ا",2,1],["وإني فارس الهيجاء شعرا","وهذي كلمة بالعقل زنها",39,"ن",3,0],["وإني فقير إذ ألوذ بجعفر","فمن يقصد الأطواد ليس له حشما",40,"م",2,0],["وإنِّيَ فرعٌ والرِّفاعِيٌّ أَصلُهُ","وبالفَرْعِ معنًى يُسْتَدَلُّ على الأَصْلِ",41,"ل",1,0],["وأنّي في هوى الشام","قُتلتُ ولستُ ندمانا",42,"ن",2,0],["وإنّي فتىً أميلُ بلحْظِ طَرْفي","لمَنْ أهوى ويُغْضي عنهُ بالي",43,"ل",2,0],["وَاِن يَفن الشَباب فَكُل شَيء","مِن الدُنيا فَلا يَغرُرك فَإِنّي",44,"ن",2,0],["وَإِنّي فَلا تَستَبطني بِمَوَدَّتي","وَنُصحي وَاِشفاقي إِلَيكَ لَعامِد",45,"د",1,0],["وأنّي فيه دون النّاس جمعاً","أُعادي مَن أُعادي او أوالي",46,"ل",2,0],["وَإِنِّيَ في مالي وَأَهلي كَأَنَّني","لِنَأيِكَ لا مالٌ لَدَيَّ وَلا أَهلُ",47,"ل",1,0],["وَإِنّي في بَني بَكرٍ بنَ سَعدٍ","إِذا تَمَّت زَوافِرُهُم أُطاعُ",48,"ع",1,0],["وَإِنِّيَ في الحَربِ الضَروسِ مُوَكَّلٌ","بِإِقدامِ نَفسٍ ما أُريدُ بَقاءَها",49,"ا",3,0],["وأَنّي في العَظائِمِ ذو غَناءٍ","وأُدعى لِلفعالِ فأَستَجيبُ",50,"ب",1,0]]}