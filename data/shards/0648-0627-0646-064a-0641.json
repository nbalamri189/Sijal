ل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130124","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112612","الرجز"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79757","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91111","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91728","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117856","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85123","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21379","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77044","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54494","المتقارب"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123851","الطويل"],[4600,"","https://poetry.dctabudhabi.ae/diwan/poem/203584","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4717,"أمة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=199576",""],[4755,"دَلَالًا أَشَاحَت وَجهَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=183675",""],[4785,"الفتنة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=129733",""],[4799,"أحتاج .... لك","https://www.poetsgate.com/ViewPoem.aspx?id=12269",""],[1901,"خلعتُ رداءَ الشبابِ الجديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=160411",""],[4935,"فؤادي كلما ذكر الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=129278",""],[5174,"لغتنا والمساكين","https://www.poetsgate.com/ViewPoem.aspx?id=208528",""],[5277,"حكايةُ وجع","https://www.poetsgate.com/ViewPoem.aspx?id=186594",""],[5277,"وقفةٌ مع الدارسات","https://www.poetsgate.com/ViewPoem.aspx?id=193599",""],[5277,"مريمُ (ع).. حنينٌ بطعمِ القدسِ..","https://www.poetsgate.com/ViewPoem.aspx?id=206969",""],[5431,"به بيت القصيد وهم ضيوفي","https://www.poetsgate.com/ViewPoem.aspx?id=195143",""],[5431,"وقد يُجمع الضدان في الحب رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=197686",""],[5431,"الله حقٌ لااحتمالُ ....","https://www.poetsgate.com/ViewPoem.aspx?id=205458",""],[5545,"أغارُ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=184793",""],[5546,"فإن تسأليني كيف أنت فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=181005",""],[5653,"لَعَلَّكَ بالوادي المُقَدَّسِ شاطىء ُ","https://www.poetsgate.com/ViewPoem.aspx?id=26369",""],[5672,"صمت النوى","https://www.poetsgate.com/ViewPoem.aspx?id=206499",""],[5725,"قابيل الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=186343",""],[5970,"يقولون لي ساير زمانك ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=130655",""],[161,"لكل سؤال جواب وحل","https://www.poetsgate.com/ViewPoem.aspx?id=169334",""],[6193,"ألا لا يعيب المجد والفضل إقلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55438&r=&rc=14",""],[463,"لمن دارٌ على إضم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60305&r=&rc=361",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["وَإِنّي في زَماني مِن رِجالٍ","مِزاجُ وِدادِهِم ماءُ التَقالي",0,"ل",2,0],["وَأَنّي في بِلادِكُمُ مُقيمٌ","وَلَيسَ إِلى لِقائِكُمُ سَبيلُ",1,"ل",1,0],["وَإِنْ يُفَرِّجْهُمَا فِي مَوْقِفٍ غَضَبٌ","رَاعَتْكَ فُوَّهَةُ البُرْكَانِ وَالْحِمَمُ",2,"م",1,0],["وَإِنِّيَ في كَبتِ العُداة وَكَيدِهِم","كَمَن يَسلُكُ الدَربَ القَصيرَ المُعَبَّدا",3,"د",2,0],["وَإِن يَفُح عِطرُ زُهورِ الرُبى","فَإِنَّما يَعبَقُ كَي تَنشُقيه",4,"ه",1,0],["وَإِنِّيَ فيما يَزعَمونَ لَشاعِرٌ","فَفي كُلِّ وادٍ مِن هَواكِ أَهيمُ",5,"م",1,0],["واني في غيلي كرئبال غيضة","ومن ذا ترى في غيله غير رئبال",6,"ل",1,0],["وَإِنّي في الحُروبِ إِذا تَلَظَّت","أُجيبُ المُستَغيثَ إِذا دَعاني",7,"ن",2,0],["وَإِن يَفرِ خَطباً فَأَهلٌ لَهُ","وَإِلّا فَكَم مِن حُسامٍ نَبا",8,"ب",2,0],["وأني في مكاني ثابت لا","تزلزلني الصواعق والرعود",9,"د",1,0],["وَأَنْ يَفْنَى بِفَخْرٍ مِنْكَ فِيهِ","فَيَأْبَى فَجْرُهُ الثَّانِي طُلُوعَا",10,"ع",2,0],["وإنيَّ في إرضائيَ الشِعرَ حائرٌ","وإني لمأخوذٌ بهذا التضارب",11,"ب",1,0],["واني فتى من آل هاشم لم اجل","عن الود ما دام الخليل ودودا",12,"د",2,1],["واني في الماء القراح اراكم","سألتكمو بالله لا تغفروا ذنبي",13,"ب",2,0],["وإني في الهوى العذري","طراد ومطرود",14,"د",1,0],["وإنىَ في عَجزى عن الشكر سائلٌ","مساعدتى مَن كلَّم الناسَ في المهدِ",15,"د",1,0],["وإن يَفِ لك من عهد الصِّبا زمن","فاضنن به فقليلاً يمكث الرَّمق",16,"ق",1,0],["وإِني في وجدي بقدَّك والرنا","أعرَضُ نفسي للقنا والصفائحِ",17,"ح",1,0],["وإني فيكم سائل كل راجع","إلى فئة من عقله لتحوبوا",18,"ب",3,0],["وَإِن يَفتَخِر بِالفَضلِ فَضلُ بنُ عَبدَلٍ","فَيا بِأَبي أَعراقُهُ وَمَناسِبُهْ",19,"ب",2,0],["وَإِنّي فَتى حرٌّ أَسيرُ عَلى هُدى","ضَميري وَلا أَهوى سِوى الرَجُلِ الحرِّ",20,"ر",1,0],["واني في ارساله مثل مرسل","إلى بابل سحراً وعطراً إلى شحر",21,"ر",1,0],["وإن يَفنَ مثلكِ قلبي فَهل","يَرى الزهرَ فوق عظامي وتربي",22,"ب",2,0],["وإن يفته طاعون بقعتها","فلم يفته من العدا طعنه",23,"ن",2,0],["وَإِنّيَ في أَهلي وَداري لِما أَرى","عَلَيكَ مِنَ السُقمِ الغَريبِ غَريبُ",24,"ب",1,0],["وَإِنِّيَ فارِسُ صَفِّ النِدامِ","فَكُن أَنتَ فارِسَ صَفِّ القِتالِ",25,"ل",1,0],["وَإِنِّيَ في حُبّي لِمَجدِكَ مُغرِقٌ","عَلى أَنَّني مِن بَحرِهِ مُتَبَرِّضُ",26,"ض",1,0],["وإِن يَفتَخِر قومٌ عَليهِ فإنَّما","لَهُم قَولُهُم في فَخرِهم ولَه فِعلُ",27,"ل",1,0],["وإني في روض العلوم مخيم","مقيم على حصد الفوائد ولزرع",28,"ع",1,0],["وأنى في التخصيص بعض حديث","حَسَنٍ قيل وهو غير مفيد",29,"د",1,0],["وأن يفوز في غد بعفوه","يسلكه في سلك أرباب التقى",30,"ا",1,0],["وإني في دمشق ومن حوته","لبعدك ذو اغتراب وانفراد",31,"د",1,0],["وإنِّي فقيرٌ إلى قهوةٍ","ومن لي مثل ذوب الذهب",32,"ب",1,0],["وإنِّي في الغرام وفي التصابي","كمثل محمَّدٍ حزت الكمالا",33,"ل",2,0],["وأن يفوز بكم غيري لجدته","كم من جديد له الأسرار خلقان",34,"ن",1,0],["وأَنِّيَ فِي أَفياءِ ظِلِّكَ أَشْتَكِي","شَكِيَّةَ مُوسى إِذْ تولَّى إِلَى الظِّلِّ",35,"ل",1,0],["وإني في رؤوس عدا","ك ولاَّجٌ على القُحَمِ",36,"م",1,0],["وإن يُفْنِ يومُ البين جُمَّةَ أدمعي","فعند جُفوني للديار نصيبُها",37,"ب",3,0],["وَإِنّي في الجِيادِ لمَن تَراهُ","لطَلقُ الوَجهِ غُرَّتَهُ نَداهُ",38,"ا",2,1],["وإني فارس الهيجاء شعرا","وهذي كلمة بالعقل زنها",39,"ن",3,0],["وإني فقير إذ ألوذ بجعفر","فمن يقصد الأطواد ليس له حشما",40,"م",2,0],["وإنِّيَ فرعٌ والرِّفاعِيٌّ أَصلُهُ","وبالفَرْعِ معنًى يُسْتَدَلُّ على الأَصْلِ",41,"ل",1,0],["وأنّي في هوى الشام","قُتلتُ ولستُ ندمانا",42,"ن",2,0],["وإنّي فتىً أميلُ بلحْظِ طَرْفي","لمَنْ أهوى ويُغْضي عنهُ بالي",43,"ل",2,0],["وَاِن يَفن الشَباب فَكُل شَيء","مِن الدُنيا فَلا يَغرُرك فَإِنّي",44,"ن",2,0],["وَإِنّي فَلا تَستَبطني بِمَوَدَّتي","وَنُصحي وَاِشفاقي إِلَيكَ لَعامِد",45,"د",1,0],["وأنّي فيه دون النّاس جمعاً","أُعادي مَن أُعادي او أوالي",46,"ل",2,0],["وَإِنِّيَ في مالي وَأَهلي كَأَنَّني","لِنَأيِكَ لا مالٌ لَدَيَّ وَلا أَهلُ",47,"ل",1,0],["وإنِّيَ في رَيّاكَ واجِدُ رِيْحِهِمْ","فَرَوْحُ الهوى بين الجوانحِ ناشئُُ",48,"ا",1,0],["وإنيَ في دار أحيط بما بها","وأرقب أخرى لا يحيط بها عقلي",49,"ل",2,0],["وإنيَ في وجدي عليك لمسرفٌ","وإن عده الخالون منه جنونا",50,"ن",2,0],["وإنيَ في الدنيا وفيهم لزاهدٌ","فما أشتهي قرباً ولا أشتكي بعدا",51,"د",2,0],["وَإنّيَ فَتح اللَّه جِئت مهنّئاً","تَفاءل بِحُسن الفَتح من منزلِ الحَمدِ",52,"د",1,0],["وَإِنّيَ فَتحُ اللَّه لِلنصرِ طالِبٌ","وَمَن كانَ مَنسوباً إِلَيهِ بِلا نُكرِ",53,"ر",1,0],["واني في عطف العلا مترفل","اجرر اذيال المنى متصدر",54,"ر",1,0],["وإني في ظلمه من ظلام","تَكَنَفَّنِي ليس يحدوه فجر",55,"ر",1,0],["وإني في محفل من عداة","عتاه فكم منهم فيّ غِمر",55,"ر",1,0],["وَإِني في عُذري وَإِن كانَ واضِحاً","لأَحسَبه وَاللَه في حقكم غَدرا",56,"ر",2,0],["وَإِن يُفلِت فَإِنّي سَوفَ ألقى","بَنيه بِالمَدينَةِ أَو صِرارِ",57,"ر",1,0],["وأني في بيت صغير مهدم","كأني في قصر كبير مشيد",58,"د",1,0],["واني في عناء الضر من فقد","احبابي فاني تعدلوني",59,"ن",2,0],["وإنيَ في استعطاف رأي محمد","علي ومدي نحو معروفه يدي",60,"د",2,1],["وإنيَ في حبها صادق","وإن بكائيَ من لوعتي",61,"ي",1,0],["وإنّى فى الحقيقة لستُ أدرى","مَن المنصورُ فى يوم الجلادِ",62,"د",1,0],["وَإِنّي في دُعائِك عَن خطوب","أَلمّت أَرتَجيك لَهُنَّ آسي",63,"ي",1,1],["وإنِّي فيها أرتجي يوم محشري","بقربيَ منكم سادتي أتشرَّف",64,"ف",1,0],["وَأَنّي في الظَّلامِ رَأَيت ضوءاً","كَأَنّ اللَيل بدّلَ بِالنَهارِ",65,"ر",1,0],["وان يفتك من الأطلال مخبرها","فلا يفتك مرآها ورباها",66,"ا",3,0],["وان يفت شركا نصبته قنص","فدعه توت الغنى عن ذلك القنص",67,"ص",1,0],["وإنى فارس الشعراء حقا","وأفخرهم بنظمي واقتداري",68,"ر",2,0],["وإني فزت بالقدح المعلى","وبلغت المنى من بعد ياس",69,"س",1,0],["وإن يفاجئكَ أضيافٌ أتاكَ لهم","مقلوُّ بسرٍ به البرنيُّ ينعلكُ",70,"ك",1,0],["وأني فَصَلتُ الأَمرَ بعد اشتباهه","بدُومةَ إذ أعيا على الحَكَم الفَصْل",71,"ل",1,0],["وَإِنّي في بَني بَكرٍ بنَ سَعدٍ","إِذا تَمَّت زَوافِرُهُم أُطاعُ",72,"ع",1,0],["وإني في خلق جديد بصورتي","ولستُ بخلقٍ للحديثِ جديد",73,"د",1,0],["وأني في الكون العظيم إضافةٌ","إليه وإن مُدَّت أمامي مآدبه",74,"ب",2,0],["وإني في ظلّ السُّهّيْلي قاطنٌ","على الروضِ والغيث المُلثّ بلا رعد",75,"د",1,0],["واني في الوفا علق نفيسٌ","فمثلي لا يباع وليس يشرى",76,"ر",2,0],["وَإِنِّيَ في الحَربِ الضَروسِ مُوَكَّلٌ","بِإِقدامِ نَفسٍ ما أُريدُ بَقاءَها",77,"ا",3,0],["وَإن يَفُتها التحلّي وهيَ في صغرٍ","بالعلمِ ذاقَت عذابَ الجهل في الكبرِ",78,"ر",1,0],["وإن يَفتكَ أن تكونَ باكي","فلا يَفُتكَ الأجرُ بالتباكي",79,"ي",1,0],["وإنّي فاعْلمنَّ لذو انْصرافٍ","إذا ما صاحبي رامَ الفِراقا",80,"ق",2,0],["وَاِن يَفوق سِهاماً من لَواحِظِهِ","لا بدعَ قَلب الشَحي عَمداً اِذا فَطَرا",81,"ا",1,0],["وَاِن يُفوّق سِهاماً من لَواحِظِهِ","لعاشقيهِ نَراهُم قَلَّ اِن عاشوا",82,"ش",3,0],["وَإن يُفَرَّغ سَابِقٌ إلاَّ لِمَا","بَعدُ يكُن كمَا لَوِ الاَّ عَدِمَا",83,"م",2,0],["وَإن يُفِد تَوكِيدُ مَنكُورٍ قُبِل","وَعَن نُحَاةٍ البَصرَةِ المَنعُ شَمِل",83,"ل",1,0],["وَإِني في كفي أعنة هَيكلي","متى رمت ردّ الكرّ وَالفرّ أَعنج",84,"ج",1,0],["وَإِني في الهَوى شَهمٌ حمولٌ","وَإِن حَثَّ النَوى بِنَوى الحَمول",85,"ل",1,0],["وان يفقدا أو يفقد المجد وحده","فجهد جهيد أو قيان وجريال",86,"ل",1,0],["وإني فيهم محسن الظن دائماً","وأبغض شخصاً راح فيهم يشنع",87,"ع",1,0],["وأَنّي في العَظائِمِ ذو غَناءٍ","وأُدعى لِلفعالِ فأَستَجيبُ",88,"ب",1,0],["وإن يفت سمعنا منه فها سندٌ","كأنه مسمعٌ للفظه بفمِ",89,"م",1,0],["وإني فقيرٌ يا غني بك اغنني","عن الناس والأموال والحرث والدُّرّ",90,"ر",1,0],["وإني في الحداثة رِستُ عَمرَاً","وأحكمت الرياسةَ في اكتهال",91,"ل",1,0],["وَإِنّي في دينِ الغَرامِ موحَدٌ","وَإيمانُ قَلبي لا يَميلُ إِلى الشِركِ",92,"ك",1,0],["وإنِّي فقيرٌ إلى وصلكم","ومن نالَ ذلكَ نالَ الغِنَى",93,"ن",2,0],["واني في حفظ الاخاء متيم","فهل انت ولهان كوجدي واجد",94,"د",1,0],["وإني فتى صبر على الأين والوجى","إذا اعتصروا للَّوْح ماء فظاظها",95,"ظ",3,1],["وان يفد الخلود عليك تلوا","لا وفاد الملوك مهنئينا",96,"ن",2,0],["وإنْ يُفقْ (ففسادُ الدِّينِ) رتبتُه","أَوْ ببَّغاءٌ يُدين القهرَ باللُّسُنِ",97,"ن",1,0],["وأَنْ يَفْقَهَ المَجرُوحُ بالصَّدِّ ما بِهِ","ومَن صَدَّتِ المَجرُوحَ لَيسَت بِفَاقِهَة",98,"ه",2,0],["وإني في ذهول الشعر يوماً","أحوم به على غصن وريق",99,"ق",1,0],["وإنّي فلا أيأس دامني بظل رحمن","دامي على الله وجهتي وإعتمادي",100,"د",2,0],["وإنيّ فقدتُ الشبابَ العزيزَ","ألا رحمَ اللهُ ذاك الفقيدْ",101,"د",1,0],["وإني في الحقيقة قيس ليلى","وحبي أمره أمر غريب",102,"ب",1,0],["وإنّي في هواك ذبحت قلبي","يسيل جوى نداءً أو يراعا",103,"ع",2,0],["وإني فارسٌ في الحبِّ أعدو","على من بالجفاءِ نوىً تمرَّدْ",104,"د",1,0],["وإنّي في هواها مثلُ طيرٍ","تُطَيِّرُهُ الرّياحُ وما تطولُ",105,"ل",1,0],["وإنّي في سَما بغدادَ لكنْ","براني شوقُ آسادِ العرينِ",106,"ن",1,0],["وأني فيك موغلةٌ بعشق","يُريق دماه في وجد مخيف",107,"ف",1,0],["وإني فرشت القلب وردا منمقا","ليهفو على قومي وحبا أسامحُ",108,"ح",1,0],["وإنّي في التبحر خضتُ علما","به رسخ اليقينُ كما الجبالُ",109,"ل",1,0],["وإني في غرامكَ لست أدري","أضعت ُ العُمرَ أم قابلتُ عُمرا ؟!!",110,"ر",2,0],["وإني فيها كامرئ القيس مرة","وصاحبه لما بكى ورأى الدربا",111,"ب",2,0],["وإنِّيَ في رَيّاكَ واجِدُ رِيحِهِمْ","فَرَوْحُ الهوى بين الجوانحِ ناشىء ُ",112,"ا",1,0],["واني في مفارقتي","لمن اهواهم همتُ",113,"ت",1,0],["واني في هواك ارقت نهرا","من الاشواق ارتقب السرابا",114,"ب",2,0],["وأني فتى الأيام ما شئت كان لي","وإن رد غيري عنه وهو ذليل",115,"ل",1,0],["17-وَإنِّي فُطِرْتُ عَلَى حُجَّةٍ","لِحَقِّ الإنَابَةِ طُهْر المِلَلْ",116,"ل",1,0],["وان يفقدوا أو يفقد المجد وحده","فجهد جهيد أو قيان وجريال",117,"ل",1,0],["وإني في رءوس عدا","ك ولاَّجٌ على القحمِ",118,"م",1,0],["وإنِّي في الصِّبا لأُخالُ شيخاً","منَ التَّجوال ِما بينَ الدروب",119,"ب",1,0]]}