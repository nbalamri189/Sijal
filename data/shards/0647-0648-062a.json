],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45916","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129508","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129440","الطويل"],[3633,"","https://poetry.dctabudhabi.ae/diwan/poem/97675","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110033","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118757","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92008","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131246",""],[3843,"","https://poetry.dctabudhabi.ae/diwan/poem/131372","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114564","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127240","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94534","الكامل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58138","الطويل"],[881,"تقول سُلَيْمى ما لِجِسْمك شاحباً","https://www.poetsgate.com/ViewPoem.aspx?id=175385",""],[4755,"ضَحِكْنَا وجُرحٌ ما بأَعماقِنا بَكَى","https://www.poetsgate.com/ViewPoem.aspx?id=190326",""],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[585,"ما للديار خلت لكل شريد","https://www.poetsgate.com/ViewPoem.aspx?id=161917",""],[5413,"أيها البدر المنير!","https://www.poetsgate.com/ViewPoem.aspx?id=200619",""],[5484,"هذي الطلول فقف بنا يا ساري","https://www.poetsgate.com/ViewPoem.aspx?id=206304",""],[5605,"مرثية حلب","https://www.poetsgate.com/ViewPoem.aspx?id=177655",""],[5717,"هوت الجباه على جمالك سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=170582",""],[5759,"إسم وسجية","https://www.poetsgate.com/ViewPoem.aspx?id=214444",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5937,"بريئة","https://www.poetsgate.com/ViewPoem.aspx?id=211895",""],[5956,"هو تلخيص لتاريخ العُلا","https://www.poetsgate.com/ViewPoem.aspx?id=193982",""],[6070,"ليلة مع يتيم الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=188468",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[463,"حماها بأطراف الرماحِ حماتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59996&r=&rc=52",""]],"verses":[["هَوَت أُمُّ الخُطوبِ إِلى التَساقي","وَقَد أَفنَيتُها نَهلاً وَعَلّا",0,"ل",2,0],["هَوَتْ مِنْ سَمَاءٍ بَعْدَمَا كُنَّ زِينَةً","فلَهْفِي عَلَيْهَا مِنْ ثَلاَثَةِ شُهْبَانِ",1,"ن",1,0],["هوت إلى لثمه الأفواه مسرعة","كأنما كل ميم فيه مبتسم",2,"م",1,0],["هوت معاليه حيث العمر مقتبلٌ","والسعد جار وأكناف العلى حرم",3,"م",1,0],["هو تيسٌ ولا تزالُ ترى التي","سَ شقيّاً عن المُدى بَحَّاثا",4,"ث",2,0],["هوت بنا ساعة ادلجنا","الجدود العاثره",5,"ر",2,0],["هوت الحضارة فوقها عربية ً","وتفردت (آشورُ) بالآثار",6,"ر",1,0],["هَوَتْ بشعوبِ الأرضِ مِنهم سياسةٌ","لها شاعرٌ يُشجِي الممالكَ بارعُ",7,"ع",1,0],["هَوَت شُرُفاتُها العُليا وَشاهَت","وُجوهُ القَومِ من سودٍ وَزُرقِ",8,"ق",1,0],["هَوتْ رِجلُهُ من زَلَّةٍ قَذفتْ بهِ","إلى الأرضِ في ظَلماءَ تُخفي الدرارِيا",9,"ي",2,0],["هَوتْ من عيونِ الهاجِعينَ سَناتُها","ولاحتْ عُيونُ الحربِ حُمراً روانيا",10,"ي",2,0],["هَوَت أُمٌّ لَنا غَدَرَت وَخانَت","وَلَم تَشفِ السَليلَ وَلا رَقَتهُ",11,"ت",2,0],["هوت بها وَهي بكر","يد بغير جناح",12,"ح",1,0],["هوت أمهم ماذا بهم يوم صُلّبوا","عَلى غير ذنب كي يُقال ذحول",13,"ل",1,0],["هَوَتْ أَنْجُمُ العَلْيَاءِ إِلا أَقلّهَا","وغِبْنَ بما يَحْظَى به كُلُّ عاقِلِ",14,"ل",1,0],["هَوَت بِأَبي العَباسِ شَمس من التقى","وأَمسَى شَهابُ الحَقِّ في الغَربِ غارِبا",15,"ب",2,0],["هَوَتِ الْعِقبَانُ عَنْ أَنْصَابِهَا","وَغذا مِنْهَا اللَّظى رُخّاً وَنَسْرَا",16,"ر",2,0],["هُوَ تَاجُ مِصْرَ وَمُلْكَ فِرْعَونَ الَّذِي","بِالْيُمْنِ تَجْرِي تَحْتَهُ الأَنْهَارُ",17,"ر",1,0],["هوتْ بغدادُ تُجهَشُ لا النّواسي","يسامرها .. ولا ضحكُ الزقاق",18,"ق",1,0],["هو تَختُ الوجودِ غنَّى به الطيْ","رُ فهزَّ الغصونَ في دَوْحاتهْ",19,"ت",2,0],["هَوَتْ أُمُّ الركائب كيف سارت","وهل تدري الركائبُ من تُقِلّ",20,"ل",1,0],["هو تاجر بالدين، يس","مَحُ حين يربح درهما",21,"م",2,0],["هوتُ العروشُ الواهناتُ، كما هُوى","ورقُ الخريف أمامَ عصف رياحِ",22,"ح",1,0],["هوت إصبعي زهرة حلوة","فلوّثت من عطرها إصبعي",23,"ع",2,0],["هَوَت نبعةُ الأخلاق جراءَ ما اعتَدَتْ","على الشعب أطماعُ السَّراةِ الأكابر",24,"ر",1,0],["هوت فهوى حسن وظلم تمازجا","بها وانطوى مرأى مروع ورائع",25,"ع",1,0],["هوت بشعوب الأرض منهم سياسة","شاعر يشجي الممالك بارع",26,"ع",1,0],["هوت بِهُمُ الأطماعُ في هُوَّةِ الرَّدى","وغرتهُمُ جَهلاً بُروقٌ خَوالِبُ",27,"ب",1,0],["هَوَت الشَّهدُ مَمزُوجاًُ بِسُمٍِّ وعَلقَمٍ","أؤمِّلُ عُتبَاهُ وأحذَرُ عَتبَهُ",28,"ب",2,0],["هوت الصقور فلا أرى","في الأفق يسبح غير بوم",29,"م",1,0],["هُوَ تاجِرٌ أَدنى وَأَبخَسُ سِلعَةٍ","وِجدانُهُ يُعطيهِ لا يَتَلَعثَمُ",30,"م",1,0],["هُوَ تارَةً لِلحُسنِ في أَترابِهِ","عَلَمٌ وَطَوراً في الكَتيبَةِ مُعلَمُ",31,"م",1,0],["هوت العروش أمامهم وعنا لهم","ذو الصولجان وأبّهات التاج",32,"ج",1,0],["هُوَ تحت ساق العرش يسجد شافِعا","في الخلق ان حشروا الى الميعاد",33,"د",1,0],["هَوَتْ في الثَّرى وَهْي الثرَيا مكانةً","فَلَهفي لمَا ساء الهَوىتَجِدْنِيَ من مِيقاتِها يَا لِيَوْمِها",34,"ه",2,0],["هَوَت أَنجُمُ الجَدوى وَشُلَّت يَدُ النَدى","وَغاضَت بُحورُ الجودِ بَعدَ البَرامِكِ",35,"ك",1,1],["هَوَت أَنجُمٌ كانَت لِأَبناءِ بَرمَكٍ","بِها يَعرِفُ الهادي قَويمَ المَسالِكِ",35,"ك",1,0],["هو ترياق من الدهر الَّذي","كانَ في اللأواء صِلاًّ صَيْلما",36,"م",2,0],["هَوَتْ بِهِمُ مَوَاطِئُ كُلِّ غَدْرٍ","إِلَى أَخْزى موارِدِ كُلِّ حَيْنِ",37,"ن",1,0],["هَوَتْ أُمُّهُمْ مَاذَا هَوَتْ بِرِحالِهمْ","إِلَى نازِحِ الآفاقِ سُفْنٌ وأَظْعَانُ",38,"ن",1,0],["هوت برءوس الناسِ سُفْلاً وحلَّقتْ","بأذنابها مجنوبةً طائراتُها",39,"ت",3,0],["هوت بالصاحِب القرِطَاتُ منّي","فَرُحْتُ بعاطلاتٍ مُصْلَماتِ",40,"ت",1,0],["هوتْ هَضْبةُ المجدِ التليدِ وعُطِّلتْ","رسومُ الندَى وانقضَّ نجمُ الكواكبِ",41,"ب",1,0],["هوت روحه ما كنا نهوى فقد بدا","التآخي وكنا حيث كان على القرب",42,"ب",1,0],["هوَتْ بنا فيهِ عيسٌ كالجبالِ سمَتْ","نحو السّماءِ ولو شِئْنا مَسسناها",43,"ا",3,0],["هوت فيك الشوامخ من حصوني","ذوت فيك البواذخ من غصوني",44,"ن",2,0],["هَوَتِ الْعَقيقَ وما هَوَتْ فَكَأَنَّها","وَقَفَتْ وَما وَقَفَتْ بِغَيْرِ الأَجْرَعِ",45,"ع",1,1],["هَوَت عليه بلا لبّ تعانقه","فودّعت جسمهُ باللثم والقبلِ",46,"ل",1,0],["هوت في ثرى الغبرا ولكن سَما لها","على ذروة العلياء عز مرفع",47,"ع",1,0],["هوت فوق أَجسادٍ رأَت في هوِّيها","حشاشاتها من قبلها وهي وقَّع",47,"ع",1,0],["هَوَت أُمُّهُ ما يَبعَثُ الصُبحُ غادِياً","وَماذا يَوَدُّ اللَيلُ حينَ يَؤوبُ",48,"ب",1,0],["هَوَت أُمُّهُ ماذا تَضَمَّنَ قَبرُهُ","مِنَ المَجدِ وَالمَعروفِ حينَ يَنوبُ",48,"ب",1,0],["هوت المشاعر والمدا","رك عن مهارج كبريائك",49,"ك",1,1],["هوتْ نجومهم والأفق مَطلعُهم","فاصدر في ظمأ والخدُّ في نهَل",50,"ل",1,0],["هوته بكر العلى حتى تبعلها","والناس عن طلب العلياء في شغل",51,"ل",1,0],["هَوَتِ الجُدودُ عَنِ السُعودِ لِفَقدِهِ","وَتَمَسَّكَت بِالنَحسِ وَالدَبَرانِ",52,"ن",1,0],["هوت وزوت منهم عشية قتلوا","أصول زكت أعراقها وغصون",53,"ن",1,0],["هوت فرق كليسا عند أول صدمة","ولما يكن في قرق كليسا مصادم",54,"م",1,0],["هَوَت أُمُّهُ ماذا تَضَمَّنَ قَبرُهُ","مِنَ الجودِ وَالمَعروفِ حينَ يَنوبُ",55,"ب",1,0],["هو تُحفةُ الدنيا لنا قد أحسَنت","فيه بريحان الهوى إتحافَها",56,"ف",3,0],["هوت هاويات الحب حور غرائب","يطفن بِبَيت الحب وَاللَيل حاجِب",57,"ب",1,1],["هَوَت بِدارا وَفَلَّت غَربَ قاتِله","وَكانَ عَضباً عَلى الأَملاكِ ذا أثرِ",58,"ر",1,0],["هو تاج لهام أهل المعالى","ليس للفضل بعده من تاج",59,"ج",1,0],["هوت النسور وأنها من ضنغهم","كالصاديات وما بهن أوام",60,"م",1,0],["هوتِ الثغورُ على الثغورِ مودَّةً","فتسلسلتْ لحَشَاشَتي صَهْبَاهُ",61,"ا",2,0],["هَوَت لَهُ حُرَّدٌ تُحفيهِ دامِيَةٌ","مَيلُ الذَوائِبِ مَيلَ الأَخشُفِ الشُدُنِ",62,"ن",1,0],["هو ترجمان الذهن وه","وبريد أفكار الأمم",63,"م",1,0],["هُوَ تُرسُهُم وَاللهِ مِن عُدوَانِكُم","وَالتُّرسُ يَومَ البَعثِ مِن نِيرَانِ",64,"ن",1,0],["هَوَت مِنهُ الغَدائر حَيث شاءَت","وَماء الحُسن في خَديهِ حارا",65,"ر",2,0],["هوت مباني التقى بعد الزكي وهل","ترى تقوم مبانيها بلا عمد",66,"د",1,0],["هو تلو شوقي في القريض وحافظٍ","وهمُ بحلبة سبقه اكفاء",67,"ا",2,0],["هَوت مِثلَما تَهوي العُقابُ كَأَنَّها","تَخافُ فَواتَ المحل فَهيَ تبادرُ",68,"ر",1,0],["هوت أَمجادُنا لما هوينا","أَلا رمح يقيلُ ولا حسامُ",69,"م",1,0],["هو تحت السديم أعجز عن أن","يبلغ النجم فوق متن رياحه",70,"ح",2,0],["هَوَتْ قَدَمي فِي الحُبِّ عَنْ غَيْرِ خِبْرَةٍ","فَأَلْفَيْتَهُ حُلْوَ التَّجَرُّعِ عَذْبَهُ",71,"ب",2,0],["هوت في مهاوي الحين أطماعه به","فصدق في مصر الرجاء المكذبا",72,"ب",2,0],["هَوَتْ في الثَّرى وَهْي الثرَيا مكانةً","فَلَهفي لمَا ساء الهَوى آخر الدَّهْرِ",73,"ر",1,0],["هو تعويذ ملكك البارع الحس","ن وشيطان عبدك المستضام",74,"م",1,0],["هَوت هممي إن لم أزُرْ أرضَ بابلٍ","بيومٍ تزورُ الأسْدَ فيه القَشاعِمُ",75,"م",1,0],["هَوَتْ أُمُّهم يومَ استقلَّ مُودِّعاً","على النّعشِ ماذا أدْرَجوا في اللّفائِفِ",76,"ف",1,0],["هوت بشعاع أنفسها عليكم","كما يهوى الفراش على الشعاع",77,"ع",1,0],["هوت من بعدما أروت ظباها","نجيعاً وهي ظامية الكبود",78,"د",1,0],["هوت وبرغم الدين راحت نحورها","تعد لأسياف الضلال قرابها",79,"ب",3,0],["هَوَت فَوقَ تَل عمرت وَهِيَ تَحتَهُ","فَكَيفَ هَوَت وَالتَلُ مِن فَوقِها هَوى",80,"و",2,0],["هوت نحو مولى شرف الله قدره","فحيا بنا قبل النزول وحياها",81,"ا",3,0],["هوت في هضاب الشام لا في معرس","أناخت ولا ركب تحل رواحله",82,"ل",2,0],["هَوت أمّهم ماذا بِهم يَوم صُرّعوا","بِجيشانَ مِن أسبابِ مجدٍ تصرّما",83,"م",2,0],["هَوَتِ المداركُ عن معارج فَهمِها","وتباعدت عن رُتبةِ الإِدراكِ",84,"ك",1,0],["هوت في مهاوي الذل من فقد قومها","وأبعدها بعدُ الغيور عن النسك",85,"ك",1,0],["هوت شمسُ الجَمال إِلى الغُروبِ","وَمال الغُصنُ في شبه الكثيبِ",86,"ب",1,1],["هوت من الذروة العليا وبث لها","شر الغوائل قومٌ ضيعوا الهما",87,"م",2,0],["هوت من الأرض نحو الجو حاملة","تؤُمُّ افراخها بالوكر جديانا",88,"ن",2,0],["هوت شهبٌ منقضةً لمقاعِدٍ","بها كل شيطانٍ رجيمٍ تدهدها",89,"ه",2,0],["هوَت كَعُقَابٍ يومَ فتحٍ عليهمِمُ","بُنُودٌ بخيفٍ أبدَلَت شمسَهُم سُهَى",89,"ه",2,0],["هُوَ تَكمِيلٌ فِي نِهَايَةِ حُسنٍ","لِبُدُورِ الكَمالِ مَنهُ حَياءُ",90,"ا",2,0],["هوت ثريا الأفق لو انها","تغدو ثريا شمع ذاك المقام",91,"م",1,0],["هو تالدٌ عن تالد صدر العُلا","فرعٌ رقى أسمى المقام حسيبُ",92,"ب",1,0],["هَوَتْ بِشامِخِ ما لِلفُرْسِ مِن شَرَفٍ","فَالجَوُّ مُضْطَرِبُ الاََرْجاءِ مِن دَنَفٍ",93,"ف",1,0],["هَوَتْ رُجُوماً فَوَجْهُ الوَحْيِ مُبْتَسِمٌ","عَنْ أَبْلَجٍ مِنْهُ شَمْلُ الدِّينِ مُنْتَظِمٌ",93,"م",1,0],["هوتْ علم بحرِ العلمِ معْ زهد مريمٍ","ومنطقِ سحبانٍ وحلم ابن عاصم",94,"م",1,0],["هَوَتْ أُمُّه ما يَبْعَثُ الصُّبحُ غادِياً","وماذا يَرُدّ الليلُ حين يؤوب",95,"ب",1,0],["هَوَت خَلفَ عَينِ الشَّمسِ حُرِيَّةُ الخُطى","فَيَا جُرحُ نامَ السَّيفُ, والحِبرُ \"فَسْبَكا\"",96,"ك",2,0],["هو تاجِرٌ.. وأَخُو التِّجارَةِ لا","يَعنِيهِ إِلَّا الكَسبُ والبَخسُ",97,"س",1,0],["هوت الدعائم تحتهم فتحطمت","دكاً تصيح بأنةٍ ورعود",98,"د",1,0],["هو تائهٌ قلقٌ يروح ويغتدي","مذْ هَامَ بين شكاته وشقائه",99,"ا",3,0],["هوت البدور على الطفوف فيا لها","من صدمة في ملة المختار",100,"ر",1,0],["هَوَتْ هُنَا قَلعَة كَانَتْ محصَّنَة","جَارُوا عَلَيهَا وَمَا جَارَتْ عَلَى أَحَدِ",101,"د",1,0],["هوت الجباه على جمالك سجدا","ودعت لنتخذن وجهك معبدا",102,"د",2,1],["هوتْهُ لِتفنى إنها تعشقُ اللظى","وإلا فكيفَ الموتُ سوفَ يُصيبُها",103,"ب",3,0],["هَوَتْ فَضَاعَتْ نُهَىً بِالرُّوحِ مَا فَتِأَتْ","تَبْنِي الْمَكَارِمَ فَالأَكْوَانُ إِصْبَاحُ",104,"ح",1,0],["هوَت جيوشُ الغرام ، في يدها","فكيف أنجو وخافقي فردُ !",105,"د",1,0],["هو تلخيص لتاريخ العُلا","لملوكٍ رؤساءٍ وبشرْ",106,"ر",1,1],["هو تائهٌ في حَيرةٍ منْ أمرهِ","ما باعَ شيئاً غيرَ تلكَ القبعَهْ",107,"ع",2,0],["هوتهم فأباحتهم سرائرها","أم للطبيعة سر غير مكنون",108,"ن",1,0],["هوت للثرى شهبا وكانت بروجها","متون الجياد الصافنات الضوامر",109,"ر",1,0],["هوْت هوّةٌ الذِّكرى بروحي فهزَّني","عواءٌ سحيق من ذئابِ جرودها",110,"د",3,0],["هوت برؤس الناسِ سفلاً وحلقتْ","بأذنابها مجنونة ً طائراتها",111,"ت",3,0]]}