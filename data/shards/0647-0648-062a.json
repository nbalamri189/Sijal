{"poems":[[53,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[72,"بكى لك العاليان القدر والهمم","https://www.aldiwan.net/poem19687.html","البسيط"],[51,"شرب البيهقي والبين ناء","https://www.aldiwan.net/poem9232.html","الخفيف"],[89,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[90,"لا در درك من ربوع ديار","https://www.aldiwan.net/poem60160.html","عموديه"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[105,"أما ينهى دعاة السوء عنا","https://www.aldiwan.net/poem43378.html","الوافر"],[105,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[105,"يقول أبو سفيان أودى محمد","https://www.aldiwan.net/poem44208.html","الطويل"],[46,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30507","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199486","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[100,"أثيم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50095",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[105,"هو الحكم أمضته السيوف القواطع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55004&r=&rc=174",""],[133,"لواؤك منصور وسعدك غالب","https://www.aldiwan.net/poem4251.html","الطويل"],[150,"هلموا فعندي للمحبة والهوى","https://www.aldiwan.net/poem68551.html","الطويل"],[197,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[223,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[235,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[239,"أسرى به في ليلة المعراج","https://www.aldiwan.net/poem23836.html","الكامل"],[271,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[275,"رويد الليالي كم تصر على الغدر","https://www.aldiwan.net/poem25559.html","الطويل"],[326,"هوت أنجم الجدوى وشلت يد الندى","https://www.aldiwan.net/poem44259.html","الطويل"],[416,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[439,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[439,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[458,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[458,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[458,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[482,"أقمت بدار كي أصون حقائق","https://www.aldiwan.net/poem24286.html","الطويل"],[514,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[515,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[529,"هوت العقيق وما هوت فكأنها","https://www.aldiwan.net/poem37342.html","الكامل"]],"verses":[["هَوَت أُمُّ الخُطوبِ إِلى التَساقي","وَقَد أَفنَيتُها نَهلاً وَعَلّا",0,"ل",2,0],["هَوَتْ مِنْ سَمَاءٍ بَعْدَمَا كُنَّ زِينَةً","فلَهْفِي عَلَيْهَا مِنْ ثَلاَثَةِ شُهْبَانِ",1,"ن",1,0],["هوت إلى لثمه الأفواه مسرعة","كأنما كل ميم فيه مبتسم",2,"م",1,0],["هوت معاليه حيث العمر مقتبلٌ","والسعد جار وأكناف العلى حرم",3,"م",1,0],["هو تيسٌ ولا تزالُ ترى التي","سَ شقيّاً عن المُدى بَحَّاثا",4,"ث",2,0],["هوت بنا ساعة ادلجنا","الجدود العاثره",5,"ر",2,0],["هوت الحضارة فوقها عربية ً","وتفردت (آشورُ) بالآثار",6,"ر",1,0],["هَوَتْ بشعوبِ الأرضِ مِنهم سياسةٌ","لها شاعرٌ يُشجِي الممالكَ بارعُ",7,"ع",1,0],["هَوَت شُرُفاتُها العُليا وَشاهَت","وُجوهُ القَومِ من سودٍ وَزُرقِ",8,"ق",1,0],["هَوتْ رِجلُهُ من زَلَّةٍ قَذفتْ بهِ","إلى الأرضِ في ظَلماءَ تُخفي الدرارِيا",9,"ي",2,0],["هَوتْ من عيونِ الهاجِعينَ سَناتُها","ولاحتْ عُيونُ الحربِ حُمراً روانيا",10,"ي",2,0],["هَوَت أُمٌّ لَنا غَدَرَت وَخانَت","وَلَم تَشفِ السَليلَ وَلا رَقَتهُ",11,"ت",2,0],["هوت بها وَهي بكر","يد بغير جناح",12,"ح",1,0],["هوت أمهم ماذا بهم يوم صُلّبوا","عَلى غير ذنب كي يُقال ذحول",13,"ل",1,0],["هَوَتْ أَنْجُمُ العَلْيَاءِ إِلا أَقلّهَا","وغِبْنَ بما يَحْظَى به كُلُّ عاقِلِ",14,"ل",1,0],["هَوَت بِأَبي العَباسِ شَمس من التقى","وأَمسَى شَهابُ الحَقِّ في الغَربِ غارِبا",15,"ب",2,0],["هَوَتِ الْعِقبَانُ عَنْ أَنْصَابِهَا","وَغذا مِنْهَا اللَّظى رُخّاً وَنَسْرَا",16,"ر",2,0],["هُوَ تَاجُ مِصْرَ وَمُلْكَ فِرْعَونَ الَّذِي","بِالْيُمْنِ تَجْرِي تَحْتَهُ الأَنْهَارُ",17,"ر",1,0],["هوتْ بغدادُ تُجهَشُ لا النّواسي","يسامرها .. ولا ضحكُ الزقاق",18,"ق",1,0],["هو تَختُ الوجودِ غنَّى به الطيْ","رُ فهزَّ الغصونَ في دَوْحاتهْ",19,"ت",2,0],["هَوَتْ أُمُّ الركائب كيف سارت","وهل تدري الركائبُ من تُقِلّ",20,"ل",1,0],["هو تاجر بالدين، يس","مَحُ حين يربح درهما",21,"م",2,0],["هوتُ العروشُ الواهناتُ، كما هُوى","ورقُ الخريف أمامَ عصف رياحِ",22,"ح",1,0],["هوت إصبعي زهرة حلوة","فلوّثت من عطرها إصبعي",23,"ع",2,0],["هَوَت نبعةُ الأخلاق جراءَ ما اعتَدَتْ","على الشعب أطماعُ السَّراةِ الأكابر",24,"ر",1,0],["هوت فهوى حسن وظلم تمازجا","بها وانطوى مرأى مروع ورائع",25,"ع",1,0],["هوت بشعوب الأرض منهم سياسة","شاعر يشجي الممالك بارع",26,"ع",1,0],["هوت بِهُمُ الأطماعُ في هُوَّةِ الرَّدى","وغرتهُمُ جَهلاً بُروقٌ خَوالِبُ",27,"ب",1,0],["هَوَت الشَّهدُ مَمزُوجاًُ بِسُمٍِّ وعَلقَمٍ","أؤمِّلُ عُتبَاهُ وأحذَرُ عَتبَهُ",28,"ب",2,0],["هوت الصقور فلا أرى","في الأفق يسبح غير بوم",29,"م",1,0],["هُوَ تاجِرٌ أَدنى وَأَبخَسُ سِلعَةٍ","وِجدانُهُ يُعطيهِ لا يَتَلَعثَمُ",30,"م",1,0],["هُوَ تارَةً لِلحُسنِ في أَترابِهِ","عَلَمٌ وَطَوراً في الكَتيبَةِ مُعلَمُ",31,"م",1,0],["هوت العروش أمامهم وعنا لهم","ذو الصولجان وأبّهات التاج",32,"ج",1,0],["هُوَ تحت ساق العرش يسجد شافِعا","في الخلق ان حشروا الى الميعاد",33,"د",1,0],["هَوَتْ في الثَّرى وَهْي الثرَيا مكانةً","فَلَهفي لمَا ساء الهَوىتَجِدْنِيَ من مِيقاتِها يَا لِيَوْمِها",34,"ه",2,0],["هَوَت أَنجُمُ الجَدوى وَشُلَّت يَدُ النَدى","وَغاضَت بُحورُ الجودِ بَعدَ البَرامِكِ",35,"ك",1,1],["هَوَت أَنجُمٌ كانَت لِأَبناءِ بَرمَكٍ","بِها يَعرِفُ الهادي قَويمَ المَسالِكِ",35,"ك",1,0],["هو ترياق من الدهر الَّذي","كانَ في اللأواء صِلاًّ صَيْلما",36,"م",2,0],["هَوَتْ بِهِمُ مَوَاطِئُ كُلِّ غَدْرٍ","إِلَى أَخْزى موارِدِ كُلِّ حَيْنِ",37,"ن",1,0],["هَوَتْ أُمُّهُمْ مَاذَا هَوَتْ بِرِحالِهمْ","إِلَى نازِحِ الآفاقِ سُفْنٌ وأَظْعَانُ",38,"ن",1,0],["هوت برءوس الناسِ سُفْلاً وحلَّقتْ","بأذنابها مجنوبةً طائراتُها",39,"ت",3,0],["هوت بالصاحِب القرِطَاتُ منّي","فَرُحْتُ بعاطلاتٍ مُصْلَماتِ",40,"ت",1,0],["هوتْ هَضْبةُ المجدِ التليدِ وعُطِّلتْ","رسومُ الندَى وانقضَّ نجمُ الكواكبِ",41,"ب",1,0],["هوت روحه ما كنا نهوى فقد بدا","التآخي وكنا حيث كان على القرب",42,"ب",1,0],["هوَتْ بنا فيهِ عيسٌ كالجبالِ سمَتْ","نحو السّماءِ ولو شِئْنا مَسسناها",43,"ا",3,0],["هوت فيك الشوامخ من حصوني","ذوت فيك البواذخ من غصوني",44,"ي",1,0],["هَوَتِ الْعَقيقَ وما هَوَتْ فَكَأَنَّها","وَقَفَتْ وَما وَقَفَتْ بِغَيْرِ الأَجْرَعِ",45,"ع",1,1]]}