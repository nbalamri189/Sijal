{"poems":[[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[3,"يا عبل أين من المنية مهربي","https://www.aldiwan.net/poem116.html",""],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[87,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9881","الكامل"],[26,"","https://poetry.dctabudhabi.ae/diwan/poem/29400","الكامل"],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[202,"وافت به غفلة الرقيب","https://www.aldiwan.net/poem51980.html","مخلع البسيط"],[208,"وشادن مر فاتن المنظر","https://www.aldiwan.net/poem53082.html","المنسرح"],[228,"الليل في صدري بدا يظلم","https://www.aldiwan.net/poem41631.html","السريع"],[473,"كأنما سرج قناديلها","https://www.aldiwan.net/poem60058.html","السريع"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105441","السريع"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26668","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35663","السريع"],[5389,"عشاق فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=207840",""]],"verses":[["يَعْثُرْنَ في ذَيْلِ الدُّجى إذْ ضَفا","لَها عليْهِنَّ جَلابيبُ",0,"ب",1,0],["يَعثُرنَ في نَقعِ النَجيعِ جَوافِل","وَيَطَأنَ مِن حَميِ الوَغى صَرعاها",1,"ا",3,0],["يَعثُرنَ في حَدِّ الظُباتِ كَأَنَّما","كُسِيَت بُرودَ بَني يَزيدَ الأَذرُعُ",2,"ع",1,0],["يَعثُرُ الأَنامُ بِهِ","إِن سَعَوا وَإِن قَعَدوا",3,"د",3,0],["يَعثُرُ وَسطَ الدارِ مِن حَيائِهِ","وَيَكشِفُ الأَهدابَ مِن وَرائِهِ",4,"ه",1,0],["يعثن من ألم فيه ومن أمل","ما لم يكن منه في يوم على بال",5,"ل",1,0],["يَعثُرنَ في نَقعِ النَجيعِ جَوافِلاً","وَيَطَأنَ مِن حَميِ الوَغى صَرعاها",6,"ا",3,0],["يَعثُرنَ في حَدِّ الظُباتِ كَأَنَّما","كُسِيَت بُرودَ بَني تَزيدَ الأَذرُعُ",7,"ع",1,0],["يعثر الدّهر والشعوب وتشقى","بالمناكير أمّة وزمان",8,"ن",1,0],["يعثرُ في ذيله فيحكي","عَثْرَةَ عينيه بالقلوب",9,"ب",1,0],["يعثر سحبان دونه ويُرى","تقصيرُ عمرٍ ولديه إن قَصَّر",10,"ر",1,0],["يعثُر قَلبي هائِماً في الدُجى","بِأَعظُمِ الصَدرِ فَلا يَسلَمُ",11,"م",1,0],["يَعثُرُ مِنها الطَرفَ في مَشيِهِ","بِجَوهَرٍ رُكِّبَ في جَوهَرِ",12,"ر",1,0],["يعثرن في ذيل الدجى إذا ضفا","لها عليهن جلايب",13,"ب",1,0],["يعثر في ذيله فيحكي","عثرة عينيه في القلوبِ",14,"ب",1,0],["يُعثر الأقلامَ حَتّى تَرى","مَفلولَة الحَدّ مَواضيها",15,"ي",3,0],["يعثر ونين الامير بعبرته","صابر اعلى الغيظ والهم كاظِمه",16,"م",2,0]]}