www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5561,"تركوها","https://www.poetsgate.com/ViewPoem.aspx?id=192910",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5837,"سحابة الفرقا","https://www.poetsgate.com/ViewPoem.aspx?id=181443",""],[5897,"ندى","https://www.poetsgate.com/ViewPoem.aspx?id=176414",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5970,"بعض شر من شرور العالمين","https://www.poetsgate.com/ViewPoem.aspx?id=130583",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[6102,"هذه ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=182769",""],[6102,"جُناح","https://www.poetsgate.com/ViewPoem.aspx?id=183610",""],[5309,"ما علينا بعد توديع المنى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573858",""],[1583,"ثمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73057&r=&rc=14",""],[5957,"يا ملاكاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82581&r=&rc=123",""],[4890,"شرق الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72385&r=&rc=76",""]],"verses":[["كُلَّمَا مَرَّ الزَّمَانُ بِهِ","فَهْوَ فِي إجْلاَلِها مُربِي",0,"ب",2,0],["كُلَّمَا مَرَّتِ السِّنُونُ بِكُمْ","زِدْتُمُونَا عَلَيْهِ بُرْهَانَا",1,"ن",2,0],["كلّما مسّت الأمور بكفٍ","لوّثتها بما بها من نجاسه",2,"س",2,0],["كلما مرَّ من قضية سهدٍ","أو جرى من بكى على الأحداق",3,"ق",1,0],["كلما ماسَ في المهارقِ كالغص","ن رأيت الندى على الأوراق",3,"ق",1,0],["كلما مَرَّ الوعيدُ به","سحَّ دمعُ العين فاطَّردا",4,"د",2,0],["كلما مستني يداك لداع","او تلاقت لحاظنا اتكهرب",5,"ب",1,0],["كلما مر من مصابك عام","وجدت مصر جدّة لمصابك",6,"ك",1,0],["كُلَّما مَرَّ بِبابٍ دَقَّهُ","أَو رَأى داراً عَلى الدَربِ قَصَد",7,"د",1,0],["كُلَّما مَرَّتِ اللَيالي عَلَيهِ","رَقَّ وَالعَهدُ في اللَيالي تُقَسّي",8,"س",2,0],["كُلَّما مَشى","أَخجَلَ القُضُب",9,"ب",1,0],["كُلَّما مالَ جانِبٌ مِن خَميسٍ","عَدَّلَتهُ شَواجِرُ الخِرصانِ",10,"ن",1,0],["كلما مَدَّتِ الحوادثُ باعاً","مدَّ للمكرُماتِ باعاً رَحيبا",11,"ب",2,0],["كُلَّما مالَت بِهِ ال","راحُ مَيلا",12,"ل",2,0],["كلَّما مَرَّ مِنهُ وَقتٌ بِربحٍ","من حياتي وجدتُ في الرِّبحِ خسري",13,"ر",2,0],["كلَّما مَرَّ مِنهُ وَقتٌ بِربحٍ","عِلْمُهُ باختلافِ سرّي وجهري",13,"ر",2,0],["كلَّما مَوّجَها المزنُ أَرَتْ","حَبَبَ الفضّةِ في ماءِ الذهب",14,"ب",1,0],["كُلُّ ما مَنظَرٍ رَأَيتُ مِنَ الحُس","نِ فَفيهِ مِنهُ جَميعُ جَميعِ",15,"ع",1,0],["كُلَّما مَرَّ قاصِراً مِن خُطاهُ","يَتهادى كَما يَمُرُّ الغَمامُ",16,"م",1,0],["كُلَمّا مس ظاهر الأرض أعطى","رونقاً للتراب والأحجار",17,"ر",1,0],["كلما مَسُّتْ يداه زهرةً","عطفَتهُ لقطافٍ شفتاها",18,"ا",3,0],["كُلُّ مَا مَرَّ مِنْ صِبايَ أَرَاهُ","بُعِثَ الْيَوْمَ خَاطِراً فِي بَالِي",19,"ل",2,0],["كلّما مدّ رأسَه يرقُبُ الوح","يَ رأيتَ العينينِ تختلجان",20,"ن",1,0],["كلَّما مرّت النوادبُ صُبحاً","ضربَ القَلبُ بالجَناحِ وحنَّا",21,"ن",2,0],["كلّما مدّ للكمالِ يديهِ","صَدّ عنهُ الكمالُ كِبراً وضَنَّا",21,"ن",2,0],["كلّما مدّ كفَّه لسؤالٍ","أشبعتها اللئامُ نَهْراً وطَرْدا",22,"د",2,0],["كلّما مرّتْ به عاصفةٌ","زَعزَعٌ مرَّت على طَوْدٍ رَكين",23,"ن",1,0],["كلَّما مرَّتْ العهودُ عليها","أثبتَتْ أنها تُجاري العهودا",24,"د",2,0],["كل مامريت.. حيه..؟ بكيت من الضجر..","دمعه ل بيته... ودمعه... لخاطر شارعه..",25,"ع",2,0],["كل ما مدّيت لوصالك يميني","رحت تتجاهل يميني .. مع يساري",26,"ر",2,0],["كلَّما مرّ منه وقتٌ بربحٍ","من حياتي وجدتُ في الريح خسري",27,"ر",2,0],["كلّما مرَّ ذِكرهم في خيالي","هزّني للّقاءِ أيّ اِهتزازِ",28,"ز",1,0],["كلما مالَ بها سُكرُ الصِّبا","مال بي سكرُ هواها والتصابي",29,"ب",2,0],["كلّما مرّ باللطافة يحلو","يهدي صبّاً صافي الزلال لصبّ",30,"ب",1,0],["كلَّما مرَّ عليهِ نفَسٌ","أبصرَت في مُقلتيَّ الوَهَجا",31,"ج",2,0],["كلما مَروا عَلى أَطلاله","سفحوا الدمع بدي السفح اِنسجاما",32,"م",2,0],["كُلَّ ما مَدَّةٍ تَمُدُّ بِأَقلا","مِكَ يَحيا بِخَطِّها إِقليمُ",33,"م",1,0],["كلما مدت النجوم شباكاً","منع الصبح أن تصاد الغزاله",34,"ل",2,0],["كلما مضنى من النفس وسواس","تذرّعت بالرجاء الهنى",35,"ن",2,0],["كلما مال نحوهم","قدحت عينه شرر",36,"ر",1,0],["كُلَّما مَرّ عاذَلي وَرَأى أَض","لع جِسمي تَعَدّ ناح وَعَدّا",37,"د",2,0],["كلّما مال مَن أُحبُّ لادُنا","ئىَ لَجّ الزّمانُ في إقصائي",38,"ا",2,0],["كلّما مَسّها من الشّرقِ ضّوءٌ","خِفْتُ وشْك اختلاطِها بالهَباء",38,"ا",2,0],["كُلَّما مَرَّتِ الرِكابُ بِأَرضٍ","كتبت أَسطُراً مِن الدَمِ حَمرا",39,"ر",2,0],["كلَّما مرَّت برَسْمٍ دارسٍ","هَمَلَتْ أدْمعُ عينيها همولا",40,"ل",2,0],["كلما مَدَّ يَداً نحو العُلى","قرُبتْ منه ونادتْ لا شَلَلْ",41,"ل",1,0],["كلَّما مرَّتْ لها هَينمَةٌ","خلتُها مِن نحوِ أحبابي كلاما",42,"م",2,0],["كلَّما مرَّتْ عليها شَمْأَلٌ","نبهَّتْ منها عَرارا وبَشاما",42,"م",2,0],["كُلَّما مالَ غُصْنُ لُطْفِكَ فينا","كُلُّنا نَحْوَهُ معَ الوَجْدِ مالا",43,"ل",2,0],["كلّما مُدَّتِ اليمينُ لِطلَّة","جاد رمشٌ بخمرة العينِ طَلَّة",44,"ل",2,0],["كُلَّما مسَّ مِني عُضواً يُنادي","إنَّ ذا مثلُ ذاكَ أيضا عَليلُ",45,"ل",1,0],["كُلَّما مَرَّ زَمانٌ","عَذّبوا فيهِ وَطابوا",46,"ب",3,0],["كلما مر بقوم عبثوا","منه بالحال الشريف الأنف",47,"ف",1,0],["كُلّما مَسَّنا بِالمَسَرَّةِ ماسَت","مَعَنا الأَرضُ فَرحةً وَالسّماءُ",48,"ا",2,0],["كُلّما مِنها خَليلي سَطَعا","فَعَنِ الشّمسِ كَفى تِلكَ الدّيار",49,"ر",1,0],["كلّما مرّت حلَت","أيُّ حالٍ يبغضُ",50,"ض",1,0],["كلّما مُرَّ بي على أهل نادٍ","كنتُ حيناً بهم كثيرَ المرورِ",51,"ر",1,0],["كلما مَالَ نحوَ فَاشٍ من الشربِ","دعاه إلى العناقِ جِهارا",52,"ر",2,0],["كلما ملت أراني","قرع الكوكب رأسي",53,"س",2,0],["كلما مر في التباعد يوم","جدّد الوجد في الفؤاد الوفيّ",54,"ي",1,1],["كُلَّمَا مَرَّ ذِكرُهُم قَالَ قَلبِي","ذَكَرَ اللَّهُ مَن ذَكَرتَ بخَيرِ",55,"ر",1,0],["كُلُّ ما من غيره مُستَنكَرٌ","فَهو مِنه وَحده لا يُنكر",56,"ر",1,0],["كلما مرَّت حلت في مرِّها","راحةُ الأفراحِ رشفاً وانتشاءا",57,"ا",3,0],["كلَّما مثّل لي قامتها","زدتُه ضمًّا لصدري والتزاما",58,"م",2,0],["كلَّما مرَّت الصبا عرَّفتنا","أنَّها جَددت عليك المرورا",59,"ر",2,0],["كلّما مرّت على بال امرئٍ","أغمد التّذكار في الصّدر حرابا",60,"ب",2,0],["كلما مرّت السنون عليها","تتجلى بثوبها الأرجواني",61,"ن",2,0],["كلما مر لموء طسمه","باني سوف يحلو باني",62,"ي",1,0],["كُلَّما مَرَّ مَوهِناً هَيَّجَت لِي","لَوعَةً بِالهَديلِ وُرقُ حَمامِه",63,"م",2,0],["كلما مَرَّت الليالي تجلَّت","فهي شمس تجلو ظلام الدجنه",64,"ن",2,0],["كل ما مَنَعته","البرَّ أَيدي باذِليهِ",65,"ي",2,0],["كُلَّما مَسَّت يَميني قَلَماً","أَنطَقَ الوِجدانُ قَلباً وَفَما",66,"م",2,0],["كلما مروا على أطلاله","سألوها أين من حلوا الخياما",67,"م",2,0],["كلما مر من شبابي بعضٌ","خلت بعضي مضى على الرغم مني",68,"ن",2,0],["كُلَّما مَرَّ ذكرهُم في ضَميري","زدت مِن لَوعة الصَبابة حَرا",69,"ر",2,0],["كُلما مَرت عَلى نيرانها","كانَت النيران بَرداً وَسَلاما",70,"م",2,0],["كلما مرت الليالي أماطت","عن أوار بقلبهم واحتراق",71,"ق",1,0],["كلما مر ذكره في ندى","أهوت الصيد عند ذكراه سجد",72,"د",1,0],["كلما مر ذكرُ فضلٍ إليه","هيج الذكر للمصيبة ذكرا",73,"ر",2,0],["كلما مرَّت النسائم حيت","منكِ غصناً بالظرف والحسن اورق",74,"ق",1,0],["كلما مر شذاها بي بكت","مقلة قرحها فرط النحيب",75,"ب",1,0],["كلما مرت به كارثة","زاد أقداما لصف السابقين",76,"ن",1,0],["كلما مر نسيم منهم","مات صبري فلهم طول البقا",77,"ق",2,0],["كلما مرت الليالي عليها","جدد الوهم حسنها وبهاها",78,"ا",3,0],["كلما مر بروثٍ وكذا","ظهر المنقار منه في دراسه",79,"س",2,0],["كلما مسّ مائلات أمور","قوّم اللَه ميلها فاستقاما",80,"م",2,0],["كلما مدّ راحتيه ليجني","غصن أكرومة دنا فتدلى",81,"ل",2,0],["كلّما ما طلّ الزمان بوعد","خلته للزمان أيَّ كفيل",82,"ل",1,0],["كُلَّما مالَ فَقَبّلتُ فاهُ","مَجَّ خَمراً في فَمي مِن أَقاحِ",83,"ح",1,0],["كلما مر بهم أَبدوْاله","من فضول القول ما لا يحمد",84,"د",1,0],["كلما مرّ بالمسامع ألفا","ه ذووه أحلى من الحلواء",85,"ا",2,0],["كلما مد من مثناه ليلا","شق من وجهه الصباح عمودا",86,"د",2,0],["كلما مروا على أطلاله","سفحوا الدمع لدى الصفح انسجاما",87,"م",2,0],["كُلَّما مَصر المسود مِنها","زادَ في مَجدِهِ جَلالاً وَكِبرا",88,"ر",2,0],["كُلَّما مَدَ يَداً رَعاشة","نَحوَ ذاكَ العَرض شاكَتها الإِبَر",89,"ر",1,0],["كُلَّما مَدَّ المَطا وَتَمَطّى","فَحَصى المَعزاءِ مِنهُ يُصِلُّ",90,"ل",1,0],["كلما مج ريقه العذب فيما","قلت سكراً به وما ذقت خمرا",91,"ر",2,0],["كلما ملَّني جَعلتُ هواهُ","لِيَ دونَ الأَنامِ دِيناً ومَلَّة",92,"ل",2,0],["كُلَّما مَسَّت يَداها وَتَراً","حسدَ الآخرُ ما مَسَّت يَداها",93,"ا",3,0],["كُلَّما مَرَّ بِقَلبي","ذِكرُهُ جُنَّ جُنونُه",94,"ن",2,0],["كُلَّما منّاهُ ظَنٌّ","عادَ بِاليَأسِ يَقِينُه",94,"ن",2,0],["كلما مضى نغصٌ","جاء بعده غنصُ",95,"ص",1,0],["كلّما مرّت وقد مرّ النسيمْ","سجدتْ عفواً غصونُ الشجَرِ",96,"ر",1,0],["كُلَّما مَالتْ عيونك في اتجاهٍ","حيثما مالت أنا قلبي يميلُ",97,"ل",1,0],["كلما مرتْ على أندلسٍ","يقرعُ المنصورُ أجراسَ النصارى",98,"ر",2,0],["كل مامرّ الهوى قلتله تكفا تروح","لايشوفونك هلي احذر مْن المهلكين",99,"ن",1,1],["كل مامر الهوى صورتْك مرّت","وبْخيالي وبْكياني اسْتقرّت",100,"ت",1,1],["كل مامرني طيفك على فاله","قلت يامرحبا في ريحة الغالي",101,"ل",2,0],["كل مامر نسناس وجابه","اطلق البال للهوجاس هيله",102,"ل",2,0],["كُلَّما ماجَتْ بِهِ جانِحَةٌ","أَرْشَفَتْهُ مِنْ نَميرِ اللَّمَمِ",103,"م",1,0],["كلما مر طيفك داعب الخفاّق من بين الاضلاع وسرابه","كنت احب اجتماعات البشر واليوم محبوس في سجنك خلاوي",104,"ا",3,0],["كلّما مضّني من النفسِ وسواسٌ تذرَّعت بالرجاءِ الهنيِّ","وإذا ما أثار شيطانها الشكُّ تعلّلت باليقين الشهيّ",105,"ي",1,0],["كل ما مشيت له عنّي يروح","وعيّت الخطوه تجي منازله",106,"ل",2,0],["كُلَّما مرَّ فيلَقٌ","سالَ في نبضِهِ الألَمْ",107,"م",1,0],["كل مامرت النسمه بعالي رباي","احمده لان رجلي ماسرت بالحفاه",108,"ف",3,0],["كلَّما مرَّ بالديارِ تهاوى","كرضيعٍ يَفُرُّ منه الفِطام",109,"م",1,0],["كلَّما مرَّت السنونُ عليها","أيقنَت أنَّ العمرَ همٌّ خطير",110,"ر",1,0],["كل ما مريت رسم أديارهم","عاودتني عبرةٍ عقب الثبات",111,"ت",1,0],["كل ما مشيت بدرب حبّه فداوي","يردّني دون الوصل قوّ سافيه",112,"ي",2,0],["كلما ما عم الدجى أشعلته","فاحتوى النورُ الفؤادَ المسهدا",113,"د",2,0],["كلما مر طيفكِ البحرُ ، طالت","في فؤادي غمائمٌ ومشاتِلْ",114,"ل",1,0],["كُلَّما مس من أحبَّ عذابٌ","مَدَّ عيناً ليفتديه وجِيْدا",115,"د",2,0],["كلَّما مرّتْ أمامي خِلتُها","مثلَ ريحٍ أح