الشك لكن لا تعتبره يقينا","https://www.poetsgate.com/ViewPoem.aspx?id=202664",""],[6164,"فتاتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[6217,"أَرَى الشيخَ إِبليسَ ذَا عِلَّة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23137&r=&rc=14",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["يَقودُهُمُ مِنّي غُلامٌ غَشَمشَمٌ","مُعينٌ عَلى البَأساءِ غَيرُ مُعانِ",0,"ن",1,0],["يَقودُني المَوتُ مِن داري فَأَتبَعُهُ","وَقَد هَزَمتُ بِأَطرافِ القَنا الذُبُلِ",1,"ل",1,0],["يَقودُ الفَتى ما زُمَّ بِالضَيمِ أَنفُهُ","وَقَد قادَ أَبطالاً وَقَد جَرَّ فَيلَقا",2,"ق",2,0],["يَقودونَ الجيادَ مُسَوَّماتٍ","عَلَيهِنَّ السَوابِغُ والمَطِيّا",3,"ي",2,0],["يَقودُ المَوتَ يَهديهِ إِياسٌ","عَلى جَرداءَ تَستَوفي الحِزاما",4,"م",2,0],["يَقُودُه حَبَشيٌّ في عِمامَتِه","ولا تُحرَّكُ مَخزُومٌ عَواليها",5,"ي",3,0],["يَقودُ رَضوى إِلى عَسيب وَلا","يُعجِزُهُ ما اِرتَقى مِنَ الهَضبِ",6,"ب",1,0],["يَقودُهُم مِن بَني أَيّوبَ كُلُّ فَتىً","ماضي العَزائِمِ لا نِكسٌ وَلا نَخِبُ",7,"ب",1,0],["يَقُودُها العِلجُ لِلمَكروهِ مُكرَهَةً","وَالعَينُ باكِيَةٌ وَالقَلبُ حَيرانُ",8,"ن",1,0],["يقودهم الزمان إلى المنايا","وما غير الطعام لهم ِزمام",9,"م",1,0],["يقودها الغُمر للمعاصي","بلا سفير ولا سفيره",10,"ر",2,0],["يقود حَوْلاءَه وينجشُ إن","غنت ليُغرَى بحشوها حاش",11,"ش",1,0],["يقودُك مكرورُ التجاريب نحوهُ","وهل تَجْتوي شهْداً تجاريبُ طاعِمِ",12,"م",1,0],["يَقودونَ مَوجاً مِن أُمَيَّةَ لَم يَرِث","دِيارَ سُلَيمٍ بِالحِجازِ وَلا الهَضبِ",13,"ب",1,0],["يَقودُ سَراياها وَيَحمي لِواءَها","سَديدُ المَرائي في الحُروبِ مُجَرِّبُ",14,"ب",1,0],["يَقودُهُمُ إِلى الهَيجا لَجوجٌ","يُسِنُّ قِتالُهُ وَالكَرُّ ناشي",15,"ش",2,0],["يقود الخميسَ المَجْرَ غصَّ به الفَلا","وأصبحَ هامُ الأكمِ وهو مُشَدَّخُ",16,"خ",1,0],["يَقودونَ بي إِن أَعمَرَتني مَنِيَّةٌ","وَيَنهونَ عَنّي كُلَّ أَهوَجَ شاغِبِ",17,"ب",1,0],["يَقودُ الخَيلَ تَركَبُ مِن وَجاها","نَواصِيَها وَتَغتَصِبُ الرِكابا",18,"ب",2,0],["يَقودُ أَبو الأَشبالِ رَيعانَ خَيلِهِ","بِدارِ المَنايا بادِياتٍ وَعُوَّدا",19,"د",2,0],["يَقودُ أَبو العاصي وَحَربٌ لِحَوضِهِ","فُراتَينِ قَد غَمّا البُحورَ الجَوارِيا",20,"ي",2,0],["يقودُهُمُ إليه ضِياءُ بِشرٍ","كأنَّ ضِياءَه بَرْقٌ تَلالا",21,"ل",2,0],["يَقودُها كلُّ قائدٍ تَعِبٍ","كأنَّه راكِعٌ وما رَكَعا",22,"ع",2,0],["يَقودهمُ لحينهِمُ ظَلومٌ","لأنفسهمْ فوَيلٌ للظلومِ",23,"م",1,0],["يَقودُهُ الشَوقُ خائِفاً وَجِلاً","تَحتَ الدُجى وَالعُيونُ في شَغلِ",24,"ل",1,0],["يقودها والنجيع يفهق ما","بين شواها إلى كلاكلها",25,"ل",3,0],["يَقودُ كَلباً لِلطَرادِ أَطلَسا","لَم يُلفِ عَن فَريسَةٍ تَحَوُّسا",26,"س",2,0],["يَقودُهُمُ النُعمانُ مِنهُ بِمُحصَفٍ","وَكَيدٍ يَغُمُّ الخارِجِيَّ مُناجِدِ",27,"د",1,0],["يقودُ جيشاً إلى الأعداءِ مُرتجساً","عَرَمرَماً يَترُكُ الآكامَ دَكدَاكا",28,"ك",2,0],["يقودُها منهُ ليثُ غابٍ","إذا رأى فرصةً قَضاها",29,"ا",3,0],["يَقُودُهُ البَدرُ يَسري في كواكِبِهِ","عَرَمْرَماً كَسَوادِ اللَّيْلِ رَجْراجا",30,"ج",2,0],["يَقُودُونَ جُرْداً قَدْ طُوِينَ كَأَنَّهَا","خَطَاطِيفُ ظِلٍّ لَمْ يَدَعْنَ لَهُمْ تَبْلاَ",31,"ل",2,0],["يقود إليه طاعة النّاس فضله","ولو لم يقدها نائلٌ وعقاب",32,"ب",1,0],["يقودهم إلى الهيجا لجوجٌ","يسن قتاله والكر ناش",33,"ش",1,0],["يقودهنَّ على الأمواج في مَرحٍ","ملاَّح وادٍ له بالتِّيه إِغراءُ",34,"ا",2,0],["يَقُودُونَ قُبّاً كالسَّراحِينِ لاحَها","سُراهُمْ وسَيْرُ الرّاكِبِ المُتَهَجِّرِ",35,"ر",1,0],["يقود بعد إبل ابن عامر","ما دبّ في غامرها والعامر",36,"ر",1,0],["يقودها ألوية الجهاد","أشهاد بدرٍ أو بنو الأشهاد",36,"د",1,0],["يقود إلى جنون المج","د أبطالاً مجانينا",37,"ن",2,0],["يقودها كأمها","فار وسوط أبرهو",38,"و",1,0],["يَقُودُهُ كُلُّ وَلاَّغٍ أَخِي إِحَنٍ","مُضَمَّخٍ بِدِمَاءِ العُرْبِ مُخْتَضِبِ",39,"ب",1,0],["يقودُهمُ الغازي إلى خير غايةٍ","فأكْرِمْ به مَلكاً وأكْرِمْ بهم جُندا",40,"د",2,0],["يقودها الدُّبُّ، لا كانت قيادتهُ","إلى المخاطر باسم الماءِ والثمر",41,"ر",1,0],["يقود سراياها ، ويحمي لواءها","حوائرَ، ما يدرين ماذا تخرِّب؟",42,"ب",1,0],["يقودهنّ على الأمواج في مرح","ملاخ واد له بالتّيه إغراء",43,"ا",2,0],["يقودهم حامي الحقيقة منهم","سَعيدُ بْنُ قَيْسٍ وَالكَرِيْمُ يُحامِي",44,"م",2,0],["يقودهمُ النعمانُ منهُ بمصحفٍ","، وكيدٍ يغمّ الخارجيَّ ، مناجدِ",45,"د",1,0],["يقودنَ موجاً من أمية َ لم يرثْ","دِيارَ سُلَيْمٍ بالحِجازِ ولا الهَضْبِ",46,"ب",1,0],["يقود لكل أصل كل بذا العلا","أصيل العوالي للمعالي مصافحا",47,"ح",2,0],["يقود الجميع الفرد في القطبنيةِ","وقطب لأفراد الأوادم سامحا",47,"ح",2,0],["يقود سراتنا ملك","بحلم زانه الجد",48,"د",1,0],["يَقُودُكَ لِلطَّعَامِ وأنتَ تُدعَى","بِخُوَّارِ العِنَانِ إلَى الطَّعَامِ",49,"م",1,0],["يَقودُ نَواصِيها أَخُو الجُودِ ماجِدٌ","وَفَضلٌ إِذا هابَ الكَمِيُّ المُنازِلُ",50,"ل",1,0],["يَقودُ لَها جَيشاً مِنَ الرَأي غازياً","يَلِي خُلقاً رَحباً وَقَلباً مشيّعا",51,"ع",2,0],["يَقودُ إِلَينا اِبنَي نِزارٍ مِنَ المَلا","وَأَهلَ العِراقِ سامِياً مُتَعَظِّما",52,"م",2,0],["يقودهم الضرغام والبطل الذي","لسطوته تخشى الضواري الضوارب",53,"ب",1,0],["يقودها أسدٌ تَمَّ الفَخار له","بحدِّه قتَّلَ الأعداءَ تقتيلا",54,"ل",2,0],["يَقودُهم مِن سافِل الخَلقِ زُمرَة","تُحاوِل نَفثَ السَمِّ فيهِم كَالصَلِّ",55,"ل",1,0],["يقود مِن حسنِه جيوشاً","ساكنةً خيلُها الشغافا",56,"ف",2,0],["يقود إلى الحرب من جُنْدِه","أُسودَ رجالٍ كأُسْد الشَّرَى",57,"ا",1,0],["يَقودُهُم في مراضِي اللّهِ مرتمضٌ","للحَق أَو يَمحو الإلحَادَ إِلحادُ",58,"د",1,0],["يَقُودُها مِنْ سِنانٍ عَزْمُ مُتَّقِدٍ","أَمامَها كَسِنانِ الصَّعْدَةِ الْوارِي",59,"ر",2,0],["يَقودُ الرِئالَ حينَ يَشتَدُّ ريشُها","خَريقانِ مِن رُبدٍ جَفولٌ وَنِقنِقُ",60,"ق",1,0],["يقود الحياة بأوهامه","وتقتاده القدرة العابسه",61,"ه",1,0],["يقود هواها نحوها فلكم سرت","إلى ربعها قوم مشاة وركبانا",62,"ن",2,0],["يقود بذهنه شمس المعاني","كأن الذهن للمعنى زمام",63,"م",1,0],["يقود إلينا من نحب وصاله","ويصرف عنا من كرهنا ويمنع",64,"ع",1,0],["يقود حبيباً عنده وهو مبغض","ويعجب منه البحتري ويفزع",64,"ع",1,0],["يقودُهُ الحَقُّ فيَعنو لَهُ","ولا تأخُذْهُ العِزَّةُ بالإثْمِ",65,"م",1,0],["يقود إِلى أَعدائِهِ كُلَّ سابِحٍ","فمن عُرُبٍ دُهْمٍ ومن سُفُنٍ دُهْمِ",66,"م",1,0],["يَقُودُهُم منهم سِراجا كتا