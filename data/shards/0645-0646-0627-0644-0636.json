{"poems":[[55,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[102,"سندباد يمني في التحقيق","https://www.aldiwan.net/poem24836.html","عموديه"],[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[40,"تغير قومي ولا أسخر","https://www.aldiwan.net/poem7712.html","المتقارب"],[30,"وأفلت دجال النفاق وما نجا","https://www.aldiwan.net/poem5107.html","الطويل"],[33,"وآخر عهدي بالرباب مقالها ألست","https://www.aldiwan.net/poem42635.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43893","البسيط"],[164,"أراني الله رأسك يا صلاح","https://www.aldiwan.net/poem58709.html","البسيط"],[422,"سقى الله عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53888.html","الطويل"],[463,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[466,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[509,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[558,"خرجن خروج الأنجم الزهر فالتقى","https://www.aldiwan.net/poem68273.html","الطويل"],[572,"يا رب نهر مدفإ ملآن","https://www.aldiwan.net/poem69449.html","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122003","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44855","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28016","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36795","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117280","البسيط"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75839","الطويل"],[5032,"نوح الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=200672",""],[5652,"عبث !!","https://www.poetsgate.com/ViewPoem.aspx?id=177394",""],[5736,"فصول متباينة","https://www.poetsgate.com/ViewPoem.aspx?id=208489",""],[5309,"من الضيم ما يذكي بقلبك همة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573756",""]],"verses":[["مِنَ الضارِبينَ الهامَ وَالخَيلُ تَدَّعي","وَإِن غابَ أَنصارٌ وَقَلَّ رِجالُ",0,"ل",1,0],["… من الضفة الأولى ، رحلت مهدّما","إلى الضفة الأخرى ، حملت خرائبي",1,"ب",2,0],["من الضيم أو أن يركبُ القومُ قومَهم","رِدافاً مع الأعداء ألباً ألوبُها",2,"ب",3,0],["مِنَ الضالَةِ الرِئمُ وَالأَعفَرُ","كَأَنَّ القُتودَ عَلى قارِحٍ",3,"ح",1,0],["مِنَ الضِفدَعِ الجاري عَلى كُلِّ لُجَّةٍ","خَفيفاً إِذا لاقى الأَواذِيَّ أَبتَرا",4,"ر",2,0],["مِنَ الضَوءِ وَالسُمّارُ فيهِم مُكَذِّبٌ","جَريءٌ عَلَينا أَن يَقولَ فَيَكذِبا",5,"ب",2,0],["مِن الضَّراغِمِ إِلّا أَنَّ غابَهُمُ","بِيضٌ حِداد وحُمْرٌ سَمْهَرِيَّاتُ",6,"ت",1,0],["من الضعفاء تنتقم الأذلا","وعند العجز يبدو الافتضاحُ",7,"ح",1,0],["من الضَّيْم ما أخفَيْتُه تحت أطماري","أمضَّ هواها في فؤادي وما حوى",8,"ح",3,0],["من الضيّقي الأعذارِ والواسعي القِرَى","إذا ما جُمادى قال للّيلة ابرُدي",9,"د",2,0],["من الضَّاربين الهام والباذلي القِرى","بغدْرة جبَّارٍ وفاقةِ دردقِ",10,"ق",1,0],["من الضعف لم يدركه فكر مدققٍ","فواعجباً أين التمكن للعنا",11,"ا",1,0],["مِنَ الضُحَّكِ الغُرِّ اللَواتي إِذا اِلتَقَت","يُحَدِّثُ عَن أَسرارِها السَبَلُ الهَطلُ",12,"ل",1,0],["مِنَ الضَّوَارِي الغُضُفُ الآذَانِ","وَكَاسِرِ البُزَاةِ والعِقْبَانِ",13,"ن",1,0],["مِنَ الضَّارِبِينَ الْهَامَ تَحَتَ عَجَاجِهِ","لَهَا بِذُيُولِ الشّهْبِ أَيُّ تَشَبُّثِ",14,"ث",1,0],["مِن الضّارِيات بالدِّماءِ الدّوارِب","شَجَاعَتُهُ دِرعٌ وَهَيبَتُهُ جَيشُ",15,"ش",1,0],["من الضياءِ الذي فيها حقيقته","وحقه وسوى هذا يعفيه",16,"ف",3,0],["من الضعيف ومسكين ومظتلم","ومن غريب ومجتاز بسبلهم",17,"م",1,0],["مِنَ الضَحِكِ اللاتي يُضاحِكُ وَدقُها","ثُغورَ الأَقاحي في الرِياض بِمُنهَلِّ",18,"ل",1,0],["من الضنا خلعوا عليهم خلَعا","للَه عند انتزاح الدار ما خلعوا",19,"ع",3,0],["من الضاربينَ الكَبشَ يَبرُقُ بَيضُه","إِذا غَصَّ بالريقِ القَليلِ الحَناجِرُ",20,"ر",1,0],["مَن الضَّحايا سِوى \"نُوحٍ\" ومركَبِهِ","ومَن لإنْقاذِهِمْ في ظَهْرهِ جَمَعا",21,"ع",2,0],["من الضيقه مكنّي هاجس الفرقى وخلاني","وحيدٍ مامعي غير الجروح وعيشةٍ غبرى",22,"ر",2,1],["من الضيقه مكني هاجس الفرقا وخلاني","وحيدٍ مامعي غير الجروح وعيشةٍ غبرى !!",22,"ر",2,0],["من الضفائر هذا الشَعْر أسوده","فوق الجبين كنور في الفؤاد سجى",23,"ج",2,0],["مِنَ الضَّيمِ ما يُذكي بِقَلبِكَ هِمَّةً","وَيَملأُ عِندَ اليَأسِ نَفسَكَ قُوَّةً",24,"ه",1,1]]}