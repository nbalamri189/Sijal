.ae/diwan/poem/45205","الوافر"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105471","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80223","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45380","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49615","البسيط"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76802","الطويل"],[2442,"","https://poetry.dctabudhabi.ae/diwan/poem/198632","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17731","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75949","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74276","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139919","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77060","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125872","البسيط"],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[6069,"يا شاعراً أودعت أنامله","https://www.poetsgate.com/ViewPoem.aspx?id=105720",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""]],"verses":[["وفي ابتِسامَةِ سُعْدى عنهُ لي عِوَضٌ","فلَمْ أشِمْ بارِقاً إلا مِن الكِلَلِ",0,"ل",1,0],["وَفي اِبنِ الرَبيعِ الفَضلِ لِلفَضلِ زاجِرٌ","إِنِ اِزدَجَرَ الفَضلُ اِبنُ مَروانَ بِالفَضلِ",1,"ل",1,0],["وَفي اِبنَي نِزارٍ أُسوَةٌ إِن جَزِعتُما","وَإِن تَسأَلاهُم تُخبَرا فيهِمُ الخَبَر",2,"ر",1,0],["وفي ابن محمود المحامد حقها","فغدت إلى علياه وهي طوامح",3,"ح",1,0],["وفي ابن عمار عُزيريةٌ","يخاصم الله بها في القدرْ",4,"ر",1,1],["وفي أبي الفضل على دائه","بلية في مصدر الجَعْر",5,"ر",1,0],["وفي أبي سعد لؤمٌ","وإن قرى وتبسمْ",6,"م",1,1],["وفي أبِينا وفيه أيُّ مُعتبَرٍ","لو اعتبرنا برأيٍ غيرِ مأفون",7,"ن",1,0],["وَفي اِبتِساماتِ أَيّارٍ وَرَوعَتِها","فَإِن تَوَلّى فَفي أَجفانِ تِشرينِ",8,"ن",1,0],["وَفي أَبيكَ مُعَزٍّ عَن أَخيكَ إِذا","فَكَّرتَ فيهِ وَفي الوَفدِ الَّذي تَبِعا",9,"ع",2,0],["وَفي أَبي طَلحَةَ لي شافِعٌ","وَجارِكَ الشاهِ بنِ ميكالِ",10,"ل",1,0],["وَفي أَبي جَعفَرٍ مَرأىً وَمُستَمَعٌ","مِمَّن يُسَلسَلُ في دَيرِ المَجانينِ",11,"ن",1,0],["وَفي أَبرِشتَويمَ وَهَضبَتَيها","طَلَعتَ عَلى الخِلافَةِ بِالسُعودِ",12,"د",1,0],["وفي ابن حِزامٍ وابنِ ورقاءَ شاهدٌ","بِما لَكَ من فضلٍ لمن كانَ ذاكرا",13,"ر",2,0],["وفي ابتسام ثناياه ومنطقه","مَن نظَّم الدر أسلاكاً ومن نثره",14,"ر",2,0],["وفي ابنِ الربيعِ ، الفضلِ للفضلِ زاجرٌ","إن ازدجر الفضلُ بنُ مروانَ بالفضلِ",15,"ل",1,0],["وفيابتسامات ((أيار)) وروعتها","فإن تولّى ، في أجفان(( تشرين))",16,"ن",1,0],["وفي ابن عمار عُزيزية ُ","يخاصم الله بها في القدرْ",17,"ر",1,1],["وفي أبوابه زبد المعاني","بموج للقيامة ليس يجمد",18,"د",1,0],["وَفي أَبي مِسعَرٍ فَخرٌ تُقِرُّ بِهِ","كُلُّ القَبائِلِ مِن حافٍ وَمُنتَعِلِ",19,"ل",1,0],["وفي ابساتين في نصف النهار على","روض وتحت عريش الكرم والقصَب",20,"ب",1,0],["وفي ابنك جودٌ وتوفيقُه","ليتلو أباه على ما رسم",21,"م",1,0],["وفي آب ميلادي تعالت صبابةٌ","لها آب في دنيا الصبابة منزل",22,"ل",1,0],["وَفي أَبرَدَيهِ كُلَّما اِعتَلَتِ الصَبا","شِفاءُ فُؤادٍ بِالغَرامِ عَليلِ",23,"ل",1,0],["وَفي اِبنِ الجَعفَرِيِّ بِجَلفَتَيهِ","عَلى العَلّاتِ وَالمالِ القَليلِ",24,"ل",1,0],["وفي ابن موسى الرضا عمن مضى خلف","تلقاه ما بين أهليه مبجلها",25,"ل",3,0],["وَفي أَبراج سَلطَنَةُ المَعالي","بَدَوتَ تَفيضَ تَهتان السُرورِ",26,"ر",1,0],["وفي أب وفي أخ وفي حم","قولان غير الأشهر المقدم",27,"م",1,0],["وفي ابتداء شطر ضرب البيت قد","أبدى سعيد كلما فيه ورد",28,"د",1,0],["وَفي اِبنِ هِند وَفي اِبنِ المُصطَفى حَسَن","أَتَت بِمُعضِلَةِ الأَلبابِ وَالفِكرِ",29,"ر",1,0],["وفي أبي القاسمِ المأمولِ لي أمَلٌ","وَإنْ تَبَاعَدَ منّي سوفَ ألْحَقُه",30,"ق",2,0],["وفي أبي القاسم الأعْلى ولا فندٌ","سيادةٌ هِيَ تاجٌ وَهْوَ مَفْرِقُه",30,"ق",2,0],["وفي ابنيه قال المصطفى ذان","سيدا شبابكم في دار عز مؤيد",31,"د",1,0],["وفي ابني أبي يداسٍ الراتب التي","تفوت أماني كل سامٍ وراغب",32,"ب",1,0],["وفي ابن برورٍ وابنه ألمعية","سمت بسما فهمٍ من الحلم صائب",32,"ب",1,0],["وفي ابتداء هذه المرات","جميعها بسمل لنص آت",33,"ت",1,0],["وَفي إِبِلٍ سِتينَ حَسبُ ظَعينَةٍ","يَروحُ عَلَيها مَخضُها وَحَقينُها",34,"ه",2,1],["وَفي ابن سَهلٍ وَأَمثالٍ لَهُ عِبَرٌ","يَغنى بِها العَقلُ عَن حِرصٍ وَعَن حَرَسِ",35,"س",1,0],["وَفي أَبوابِها رسم يُنادي","عَلى أَعتابِها يحمى الذمار",36,"ر",1,0],["وفي أبي زكرياء الوزير لها","إذ كان والدُها فخراً لمفتخرِ",37,"ر",1,0],["وفي أَبْركِ الساعاتِ واليومُ رابعٌ","من الشهر وافَيْنا وَقَدْ قَرُب الظهر",38,"ر",1,0],["وَفِى أبٍ وَتَالِيَيه يَندُرُ","وقَصرُهَا مِن نَقصِهِنَّ أشهَرُ",39,"ر",1,0],["وفي أبي عثمان شيخوخيّه","وهكذا التشييخ يا أميه",40,"ه",1,0],["وَفي أَبوابِهِ وَقَفَت فَصاحَت","مُلوكُ الدَهرِ في ذل السُؤال",41,"ل",1,0],["وفي ابتسامِته تفترُّ عن فمِهِ","كوالدٍ بابنِه المحبوبِ مسرور",42,"ر",1,0],["وفي أبرق الحنّان سقيت أبرقاً","غزال غضيض المقلتين كحيل",43,"ل",1,0],["وفي ابتسامة ذي رأى وذي بصر","أبدى معاوي أسرارا يواريها",44,"ي",3,0],["وفي ابن يحي مكارم كسفت","كل شريفٍ بفخرها علوي",45,"و",2,0],["وفي أبيض ماء الردى متموج","به وهو من ماء الطلا دائم النهل",46,"ل",1,0]]}