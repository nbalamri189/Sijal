{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[63,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[57,"إذا المرء لا يرعاك إلا تكلفاً","https://www.aldiwan.net/poem24669.html","الطويل"],[77,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[35,"وقلن وقد يكذبن فيك تعيف","https://www.aldiwan.net/poem39125.html","الطويل"],[54,"ألا إنما الانسان غمد لقلبه","https://www.aldiwan.net/poem27382.html","الطويل"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[27,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[37,"خرجت لهم تمشي البراح ولم تكن","https://www.aldiwan.net/poem6423.html","الطويل"],[47,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[47,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[47,"عطفت على عمر ابن تغلب بعدما","https://www.aldiwan.net/poem25319.html","الطويل"],[72,"أناعسة الأجفان أسهرت مكمدا","https://www.aldiwan.net/poem18553.html","الطويل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"أتتني عنك المؤيسات فلم ألم","https://www.aldiwan.net/poem65059.html","الطويل"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[51,"ومعتذر من نعمة قد أفادها","https://www.aldiwan.net/poem65998.html","الطويل"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[32,"أفق قد أفاق العاشقون وفارقوا","https://www.aldiwan.net/poem27784.html","الطويل"],[89,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[85,"خلقنا للحياة وللممات","https://www.aldiwan.net/poem62917.html","الوافر"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[28,"ألا حبذا البيت الذي أنت هايبه","https://www.aldiwan.net/poem1265.html",""],[28,"فقالت أليس ابن الوليد الذي له","https://www.aldiwan.net/poem5011.html","الطويل"],[58,"صن النفس واحملها على ما يزينها","https://www.aldiwan.net/poem30912.html","الطويل"],[58,"ولا خير في الشكوى إلى غير مشتكي","https://www.aldiwan.net/poem31017.html","الطويل"],[49,"ألم تر هذا الموت يستعرض الخلقا","https://www.aldiwan.net/poem62181.html","الطويل"],[49,"أيا نفس مهما لم يدم فذريه","https://www.aldiwan.net/poem63187.html","الكامل"],[49,"ولا خير فيمن لا يوطن نفسه","https://www.aldiwan.net/poem63222.html","الطويل"],[66,"هنئت بالعيد بل هني بك العيد","https://www.aldiwan.net/poem40982.html","البسيط"],[80,"بأي وفي في زمانك تختص","https://www.aldiwan.net/poem31403.html","الطويل"],[44,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem30617.html","الطويل"],[69,"يمينا لا ذممتك طول عمري","https://www.aldiwan.net/poem28616.html","الوافر"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[74,"ألا قصر كل بقاء ذهاب","https://www.aldiwan.net/poem12864.html","المتقارب"],[105,"هو الجد لا عذر للهازلين","https://www.aldiwan.net/poem42056.html","المتقارب"],[81,"قبولك ريعان الشباب فلا ولى","https://www.aldiwan.net/poem61420.html","الطويل"],[13,"أقسمت لا أنسى وإن طال عيشنا","https://www.aldiwan.net/poem2209.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[48,"ألا فاسقني خمراً وقل لي هي الخمر","https://www.aldiwan.net/poem21954.html","عموديه"],[50,"لعمري لقد أزرى سهيل بصهره","https://www.aldiwan.net/poem63967.html","الطويل"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[46,"أيا سارحا في الجو دنياك معدن","https://www.aldiwan.net/poem22599.html","الطويل"],[46,"أيا ظبيات الإنس لست مناديا","https://www.aldiwan.net/poem22819.html","الطويل"],[46,"قرنت الجياد بأجمالها","https://www.aldiwan.net/poem23267.html","المتقارب"],[1,"إذا شاء يوما قاده بزمامه","https://www.aldiwan.net/poem33993.html","الطويل"],[1,"يا عجبا من عبد عمرو وبغيه","https://www.aldiwan.net/poem34012.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85449","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10683","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55106","الكامل"],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[50,"أجارتنا ما بالْهوان خفاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=15451",""],[90,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[57,"صن النفس واحملها على ما يزينها","https://www.poetsgate.com/ViewPoem.aspx?id=2514",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[47,"عَطَفتُ على عَمرِو بنِ تغلِبَ بَعدَما","https://www.poetsgate.com/ViewPoem.aspx?id=14764",""],[35,"وقلنَ، وقدْ يكذبن، فيك تعيُّفٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22058",""]],"verses":[["وَلا خَيرَ في الدُنيا إِذا كُنتُ حاضِراً","وَكانَ الَّذي يَغرى بِهِ القَلبُ نائِيا",0,"ي",2,0],["وَلا خِضابُ العَهدِ أُعطيتَهُ","إِن نَصَلَ الأَقوامُ بِالناصِلِ",1,"ل",1,0],["وَلا خَطَوتُ إِلى بَأسٍ وَلا كَرَمٍ","إِلّا وَمَوضِعُ رِجلي مِنهُ مَوجودُ",2,"د",1,0],["وَلا خَيلٌ مُعَقَّدَةُ النَواصي","يَموجُ عَلى شَكائِمِها اللُعابُ",3,"ب",1,0],["ولا خَيْرَ في نَفْسٍ تَذِلُّ لحادِثٍ","يُلِمُّ ولا يَعْتادُها خُيَلاؤُها",4,"ا",3,0],["ولا خِفْتُ أن يَستَغويَ البيدُ ناظِري","فإني إذا ما اغْبَرّتِ الأرضُ ذِيبُها",5,"ب",3,0],["ولا خَيْرَ إلا في نِزارٍ وخَيْرُها","إذا حُصِّلَ الأحْسابُ دُودَانُ والنَّضْرُ",6,"ر",1,0],["وَلا خَيرَ في خِلٍّ يَخونُ خَليلَهُ","وَيَلقاهُ مِن بَعدِ المَوَدَّةِ بِالجَفا",7,"ف",2,0],["ولا خلْقَ أجْهَلُ ممّن يظُنّ","بمِقْدارِ مِثْليَ أنْ يجْهَلا",8,"ل",2,0],["وَلا خَيرَ في وُدِّ اِمرِئٍ مُتَكارِهٍ","عَلَيهِ وَلا في صاحِبٍ لا تُوافِقُه",9,"ق",2,0],["وَلا خَيرَ في وَعدٍ إِذا كانَ كاذِباً","وَلا خَيرَ في قَولٍ إِذا لَم يَكُن فِعلُ",10,"ل",1,0],["ولا خمار فيرددن الغبار به","ولا يقيهنّ حرّ الشمس سربال",11,"ل",1,0],["وَلا خَيرَ في مالٍ عَلَيهِ أَلِيَّةٌ","وَلا في يَمينٍ غَيرِ ذاتِ مَخارِمِ",12,"م",1,0],["ولا خالد يستطعم الماء قائماً","بِعِدلك والداعي إلى الموت أقربُ",13,"ب",1,0],["وَلا خافَتنِيَ الأَملاكُ إِن لَم","أُصَبِّحها بِمُلتَفِّ الغُبارِ",14,"ر",1,0],["وَلا خَيرَ في دَفعِ الرَدى بِمَذَلَّةٍ","كَما رَدَّها يَوماً بِسَوءَتِهِ عَمروُ",15,"ر",2,0],["وَلا خَيرَ في هَجرِ العَشيرَةِ لِاِمرِئٍ","يَروحُ عَلى ذَمِّ العَشيرَةِ أَو يَغدو",16,"د",2,0],["ولا خبرٌ في الحلمِ والعلمِ والثنا","تجاه الورَى إلاَّ وذكرك مبتدَا",17,"د",2,0],["ولأختمنّ بموضعِ التقبيل ما","ضمّ الثرى من قلبيَ المستودع",18,"ع",1,0],["ولا خيرَ في الدنيا إذا ما رعيتَها","وقد أيبستْ أجنابُها الخَضِراتُ",19,"ت",1,0],["ولا خلا ضدٌّ لكم ناطِحٌ","من ناطح يُودَى بِمَنْطُوحِ",20,"ح",1,0],["ولا خَلا حَظٌّ لكم مُنْفِسٌ","منْ كَاشحٍ في ثوب مَكْشُوحِ",20,"ح",1,0],["وَلا خَيْرَ في البُنْيانِ غيْرَ مُشَرَّفٍ","ولا خيْرَ في تشْرِيفِهِ أوْ يُوَطَّدُ",21,"د",1,0],["ولاختلال ثغورٍ طال ما حملتْ","أبناءهنّ على الجُرْد المحاضير",22,"ر",1,0],["ولا خُبث ريحٍ من مبالٍ مُلعَّنٍ","ولا شعراً في السِّفل والعلو قد شَمِط",23,"ط",1,0],["ولا خير لي فيما أُحِبُّ وتجتوي","لأنك من قلبي كنفسيَ موقعا",24,"ع",2,0],["ولا خُلِّيُوا من ثروةٍ وسماحةٍ","لِتُقْسَمَ أنفالٌ وتُصْلَح أحوالُ",25,"ل",1,0],["ولا خملَ المعروفُ منه فإنه","تحمَّلَ منه نابهاً غيرَ خاملِ",26,"ل",1,0],["ولا خطر التَّسَحُّبُ لي ببالٍ","كما يتسحَّبُ الحَمِقُ الجهولُ",27,"ل",1,0],["وَلا خَلائِقَ أَهليها وَزَيَّهُمُ","فَطالَما قَرَأتَ أَخلاقُهُم سِيَرا",28,"ر",2,0],["وَلا خَرِقٍ هَيقٍ كَأَنَّ فُؤادَهُ","يَظَلُّ بِهِ المُكَّاءُ يَعلو وَيَسفِلُ",29,"ل",1,0],["وَلا خالِفٍ دارِيَّةٍ مُتَغَزَّلٍ","يَروحُ وَيَغدو داهِناً يَتَكَحَّلُ",29,"ل",1,0],["وَلا خاطَبَتها مُقلَتايَ بِنَظرَةٍ","فَتَعلَمَ نَجوانا العُيونُ النَواظِرُ",30,"ر",1,0],["ولا خير في شعر اريد انتقاصه","ولم يتحفز للدفاع ويغضب",31,"ب",1,0],["وَلا خُلدَ حَتّى تَملَأَ الدَهرَ حِكمَةً","عَلى نُزَلاءِ الدَهرِ بَعدَكَ أَو عِلما",32,"م",2,0],["وَلا خانَتهُ أَيدي حامِليهِ","وَإِن ساروا بِصَبرِيَ وَالأَناةِ",33,"ه",1,0],["وَلا خَيرَ في الدُنيا وَلا في حُقوقِها","إِذا قيلَ طُلّابُ الحُقوقِ بُغاةُ",34,"ه",1,0],["ولا خَلَتِ الأيامُ منكم فإنَّكُمْ","لها غُرَرٌ فيها تلوحُ وتشدخُ",35,"خ",1,0],["وَلا خَيرَ ما لَم يَنفَعِ الغُصنُ أَصلَهُ","وَإِن ماتَ لَم تَحزَن عَلَيهِ أَقارِبُه",36,"ب",2,0],["وَلا خَيرَ في هَمٍّ إِذا لَم يَكُن لَهُ","زَماعٌ وَحَبلٌ لِلصَريمَةِ مُحصَدُ",37,"د",1,0],["وَلا خَيرَ في وِدِّ اِمرِئٍ مُتَلَّونٍ","إِذا الريحُ مالَت مالَ حَيثُ تَميلُ",38,"ل",1,0],["وَلا خَيرَ في الشَكوى إِلى غَيرِ مُشتَكي","وَلا بُدَّ مِن شَكوى إِذا لَم يَكُن صَبرُ",39,"ر",1,1],["وَلا خَيرَ فيمَن لا يُواسي بِفَضلِهِ","وَلا خَيرَ فيمَن لا يُرى وَجهُهُ طَلقا",40,"ق",2,0],["وَلا خَيرَ في مَن ظَلَّ يَبغي لِنَفسِهِ","مِنَ الخَيرِ ما لا يَبتَغي لِأَخيهِ",41,"ي",2,0],["وَلا خَيرَ فيمَن لا يُوَطِّنُ نَفسَهُ","عَلى نائِباتِ الدَهرِ حينَ تَنوبُ",42,"ب",1,1],["وَلا خَلَت كُلَّ عامٍ مِنكَ أَربَعَةٌ","نِسكٌ وَصَومٌ وَإِفطارٌ وَتَعيِيدُ",43,"د",1,0],["ولا خَيْرَ في خُلْقٍ يُذَمّ لجهله","وَيُحْمَدُ منه قبْلَ خِبرَتِهِ الشخصُ",44,"ص",1,0],["وَلا خائِفاً إِلّا جَريرَةَ رُمحِهِ","وَلا طالِباً إِلّا الَّذي تَطلُبُ الأُسدُ",45,"د",1,0],["ولا خلَّدْتُ ذكرَكَ في كتابٍ","ولا نجَّستُ ديواني بهجوِكْ",46,"ك",1,0],["ولا خيرَ في مالِ الفتى بعدَ عرضِهِ","ولا عيشَ في الدنيا إذا قبَّحَ الذكرُ",47,"ر",1,0],["وَلا خِطَّةٌ غَيرَ إِحدى اِثنَتَينِ","إِمّا نَعيمٌ وَإِمّا عَذاب",48,"ب",1,0],["ولا خيرَ في العيش إن لم يَفُزْ","على الجاهلِ الكيِّسُ العاقلُ",49,"ل",1,0],["وَلا خَبَّهُم مَشياً وَلا جِدَّهُم وَنىً","وَلا سَيفَهُم سوطاً وَلا تاجَهُم نَعلا",50,"ل",2,0],["وَلا خَرِبٍ خَيعابَةٍ ذي غَوائِلٍ","هَيامٍ كَجَفرِ الأَبطَحِ المُتَهَيِّلِ",51,"ل",1,0],["ولاختيارِكَ فضْلُ الوَحي إنّك لا","تأتي المآتيَ إلاّ من عَلٍ فَعَل",52,"ل",1,0],["ولا خيرَ في الدّنيا إذا لم يفُزْ بها","مليكٌ مُفَدّىً في اقتِبالٍ من العمر",53,"ر",1,0],["ولا خيرَ في فتكٍ بدونِ مجانة ؛","ولا في مجونٍ ليس يتبعُه كفرُ",54,"ر",1,0],["وَلا خافَ هَذا صالِحٌ عِندَ مَوتِهِ","عَلى عَقبِهِ في نادِياتِ الفَضائِحِ",55,"ح",1,0],["وَلا خَيرَ في وُدِّ اِمرِىءٍ مُتَصَنِّعٍ","بِما لَيسَ فيهِ وَالوِدادُ صَفاءُ",56,"ا",2,0],["وَلا خَيرَ في المَمكورَةِ الخَودِ أَضمَرَت","لَكَ الغِلَّ وَاِمتارَت جَوانِحُها مَكرا",57,"ر",2,0],["وَلا خَيرَ في جَونِ الذَوائِبِ عانِسٍ","إِذا لَم يَبِت فَوقَ الرِحالَةِ وَالعَنسِ",58,"س",1,0],["وَلا خَيرَ في أَن تُمَدَّ الحَياةُ","وَنُقصانُها مِثلُ إِكمالِها",59,"ل",3,0],["وَلا خَيرَ في خَيرٍ تَرى الشَرَّ دونَهُ","وَلا قائِلٍ يَأتيكَ بَعدَ التَلَدُّدِ",60,"د",1,0],["وَلا خَيرَ فيهِ غَيرَ أَنَّ لَهُ غِنىً","وَأَنَّ لَهُ كَشحاً إِذا قامَ أَهضَما",61,"م",2,0],["وَلا خَيرَ فِي جَهلٍ إِذَا لَم يَكُن لَهُ","حَلِيمٌ إِذَا ما أَورَدَ الأَمرَ أَصدَرا",62,"ر",2,0],["وَلا خيرَ فِي حِلمٍ إِذَا لَم تَكُن لَهُ","بَوَادِرُ تَحمي صَفوَهُ أَن يُكَدَّرا",62,"ر",2,0],["وَلا خير في لَيل توارَت نجومه","وَلا في نهار ما به أَوجه غر",63,"ر",1,0],["وَلا خير في غمد خلا من حسامه","وَلا في حسام ظل يصدأ مغمدا",64,"د",2,0],["وَلا خير في شعر مضى اليوم عهده","وفي شاعر إن قالَ قال مقلدا",64,"د",2,0],["وَلا خير في شعرٍ وإن راق لفظه","إذا كان عنه في الهداية يستغنَى",65,"ن",2,0],["ولا خَيرَ في مَن ليس يَبْسُطُ شُكرَهُ","على القُلّ إنّ الخَيْرَ ناقَتُهُ بِسطُ",66,"ط",1,0],["وَلا خَيرَ في الدُنيا إِذا أَنتَ لَم تَزُر","حَبيباً وَلَم يَطرَب إِلَيكَ حَبيبُ",67,"ب",1,0],["ولاَ خُلُقٌ رَاضٍ نَقِيٌّ كَأَنَّهُ","عَلَى كُلِّ حَالٍ طَاهِرُ الماءِ سلسَلاَ",68,"ل",2,0],["وَلاَ خُصُومَةَ إِلاَّ فِي اسْتِبَاقِهِمَا","لِمَا يَعُمُّ بِنَفْعٍ كُلَّ مَوْجُودِ",69,"د",1,0],["وَلأُخْتِكِ الزَّهْرَاء نُورٌ سَاطِعٌ","أَدَباً وَمعْرِفَةٍ وَحُسْنَ سُلُوكِ",70,"ك",1,0],["ولا خيوط لها غير النبات، وما","لها سوى الماء أصباغ، وأدهان",71,"ن",1,0],["ولا خطَّ الأعاجم فيه يومًا","ولا خَطَرت به يومًا نِزَار",72,"ر",1,0],["ولا خيرَ في ودِّ امرئ متصنِّعٍ","بما ليْس فيه، والْوِدادُ صفاء",73,"ا",2,0],["ولا خيرَ في المُلك ما لم يُشَدْ","على أُسُسِ العلمِ بُنيانه",74,"ن",2,0],["ولا خيرَ في بَغيٍ تحاول نيلَها","إذا لم يُنهِكْ بيِّنَ البطش عاتيا",75,"ي",2,0],["ولا خير في ود امرىءٍ متلونٍ","إذا الريح مالت ، مال حيث تميل",76,"ل",1,0],["ولا خير في خيرٍ ترى الشر دونه","ولا نائلٍ يأتيك بعد التلدد",77,"د",1,0],["ولا خيرَ في هجرِ العشيرة ِ لامريءٍ","يَرُوحُ عَلى ذَمّ العَشِيرَة ِ أوْ يَغْدُو",78,"د",2,0],["ولا خيرَ في ودِّ امرئٍ متكارهٍ","عَلَيْكَ ولا في صَاحِبٍ لا توافِقُهْ",79,"ق",2,0]]}