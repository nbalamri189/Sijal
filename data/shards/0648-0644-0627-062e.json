ائم","https://www.aldiwan.net/poem3633.html","عموديه"],[494,"سواي الذي ترمي المطامع نبله","https://www.aldiwan.net/poem67285.html","عموديه"],[494,"إذا المرء لم يبن افتخارا لنفسه","https://www.aldiwan.net/poem67380.html","الطويل"],[506,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[514,"كأن رقيبا منك يرعى خواطري","https://www.aldiwan.net/poem67698.html","البسيط"],[516,"أنادي من الإخوان غير مجيب","https://www.aldiwan.net/poem12038.html","الطويل"],[516,"إن كبرت سني فلي همة","https://www.aldiwan.net/poem12156.html","السريع"],[516,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[516,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[517,"كسيت ولم املك سوادا وتحته","https://www.aldiwan.net/poem48646.html","الطويل"],[530,"ولي سلف فوق المجرة خيموا","https://www.aldiwan.net/poem37515.html","الطويل"],[552,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[552,"أقول لصحبي وقد هوموا","https://www.aldiwan.net/poem47189.html","المتقارب"],[552,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[552,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[552,"وقوفي في ذا الورى الخامل","https://www.aldiwan.net/poem47292.html","الخفيف"],[552,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[552,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[552,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[552,"أضن بنفسي عن هوى البيض كلما","https://www.aldiwan.net/poem48038.html","الطويل"],[552,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[552,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[552,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[552,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[563,"سلام وما يغني السلام على البعد","https://www.aldiwan.net/poem52946.html","الطويل"],[586,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["وَلا خَيرَ في الدُنيا إِذا كُنتُ حاضِراً","وَكانَ الَّذي يَغرى بِهِ القَلبُ نائِيا",0,"ي",2,0],["وَلا خِضابُ العَهدِ أُعطيتَهُ","إِن نَصَلَ الأَقوامُ بِالناصِلِ",1,"ل",1,0],["وَلا خَطَوتُ إِلى بَأسٍ وَلا كَرَمٍ","إِلّا وَمَوضِعُ رِجلي مِنهُ مَوجودُ",2,"د",1,0],["وَلا خَيلٌ مُعَقَّدَةُ النَواصي","يَموجُ عَلى شَكائِمِها اللُعابُ",3,"ب",1,0],["ولا خَيْرَ في نَفْسٍ تَذِلُّ لحادِثٍ","يُلِمُّ ولا يَعْتادُها خُيَلاؤُها",4,"ا",3,0],["ولا خِفْتُ أن يَستَغويَ البيدُ ناظِري","فإني إذا ما اغْبَرّتِ الأرضُ ذِيبُها",5,"ب",3,0],["ولا خَيْرَ إلا في نِزارٍ وخَيْرُها","إذا حُصِّلَ الأحْسابُ دُودَانُ والنَّضْرُ",6,"ر",1,0],["وَلا خَيرَ في خِلٍّ يَخونُ خَليلَهُ","وَيَلقاهُ مِن بَعدِ المَوَدَّةِ بِالجَفا",7,"ف",2,0],["ولا خلْقَ أجْهَلُ ممّن يظُنّ","بمِقْدارِ مِثْليَ أنْ يجْهَلا",8,"ل",2,0],["وَلا خَيرَ في وُدِّ اِمرِئٍ مُتَكارِهٍ","عَلَيهِ وَلا في صاحِبٍ لا تُوافِقُه",9,"ق",2,0],["وَلا خَيرَ في وَعدٍ إِذا كانَ كاذِباً","وَلا خَيرَ في قَولٍ إِذا لَم يَكُن فِعلُ",10,"ل",1,0],["ولا خمار فيرددن الغبار به","ولا يقيهنّ حرّ الشمس سربال",11,"ل",1,0],["وَلا خَيرَ في مالٍ عَلَيهِ أَلِيَّةٌ","وَلا في يَمينٍ غَيرِ ذاتِ مَخارِمِ",12,"م",1,0],["ولا خالد يستطعم الماء قائماً","بِعِدلك والداعي إلى الموت أقربُ",13,"ب",1,0],["وَلا خافَتنِيَ الأَملاكُ إِن لَم","أُصَبِّحها بِمُلتَفِّ الغُبارِ",14,"ر",1,0],["وَلا خَيرَ في دَفعِ الرَدى بِمَذَلَّةٍ","كَما رَدَّها يَوماً بِسَوءَتِهِ عَمروُ",15,"ر",2,0],["وَلا خَيرَ في هَجرِ العَشيرَةِ لِاِمرِئٍ","يَروحُ عَلى ذَمِّ العَشيرَةِ أَو يَغدو",16,"د",2,0],["ولا خبرٌ في الحلمِ والعلمِ والثنا","تجاه الورَى إلاَّ وذكرك مبتدَا",17,"د",2,0],["ولأختمنّ بموضعِ التقبيل ما","ضمّ الثرى من قلبيَ المستودع",18,"ع",1,0],["ولا خيرَ في الدنيا إذا ما رعيتَها","وقد أيبستْ أجنابُها الخَضِراتُ",19,"ت",1,0],["ولا خلا ضدٌّ لكم ناطِحٌ","من ناطح يُودَى بِمَنْطُوحِ",20,"ح",1,0],["ولا خَلا حَظٌّ لكم مُنْفِسٌ","منْ كَاشحٍ في ثوب مَكْشُوحِ",20,"ح",1,0],["وَلا خَيْرَ في البُنْيانِ غيْرَ مُشَرَّفٍ","ولا خيْرَ في تشْرِيفِهِ أوْ يُوَطَّدُ",21,"د",1,0],["ولاختلال ثغورٍ طال ما حملتْ","أبناءهنّ على الجُرْد المحاضير",22,"ر",1,0],["ولا خُبث ريحٍ من مبالٍ مُلعَّنٍ","ولا شعراً في السِّفل والعلو قد شَمِط",23,"ط",1,0],["ولا خير لي فيما أُحِبُّ وتجتوي","لأنك من قلبي كنفسيَ موقعا",24,"ع",2,0],["ولا خُلِّيُوا من ثروةٍ وسماحةٍ","لِتُقْسَمَ أنفالٌ وتُصْلَح أحوالُ",25,"ل",1,0],["ولا خملَ المعروفُ منه فإنه","تحمَّلَ منه نابهاً غيرَ خاملِ",26,"ل",1,0],["ولا خطر التَّسَحُّبُ لي ببالٍ","كما يتسحَّبُ الحَمِقُ الجهولُ",27,"ل",1,0],["وَلا خَلائِقَ أَهليها وَزَيَّهُمُ","فَطالَما قَرَأتَ أَخلاقُهُم سِيَرا",28,"ر",2,0],["وَلا خَرِقٍ هَيقٍ كَأَنَّ فُؤادَهُ","يَظَلُّ بِهِ المُكَّاءُ يَعلو وَيَسفِلُ",29,"ل",1,0],["وَلا خالِفٍ دارِيَّةٍ مُتَغَزَّلٍ","يَروحُ وَيَغدو داهِناً يَتَكَحَّلُ",29,"ل",1,0],["وَلا خاطَبَتها مُقلَتايَ بِنَظرَةٍ","فَتَعلَمَ نَجوانا العُيونُ النَواظِرُ",30,"ر",1,0],["ولا خير في شعر اريد انتقاصه","ولم يتحفز للدفاع ويغضب",31,"ب",1,0],["وَلا خُلدَ حَتّى تَملَأَ الدَهرَ حِكمَةً","عَلى نُزَلاءِ الدَهرِ بَعدَكَ أَو عِلما",32,"م",2,0],["وَلا خانَتهُ أَيدي حامِليهِ","وَإِن ساروا بِصَبرِيَ وَالأَناةِ",33,"ه",1,0],["وَلا خَيرَ في الدُنيا وَلا في حُقوقِها","إِذا قيلَ طُلّابُ الحُقوقِ بُغاةُ",34,"ه",1,0],["ولا خَلَتِ الأيامُ منكم فإنَّكُمْ","لها غُرَرٌ فيها تلوحُ وتشدخُ",35,"خ",1,0],["وَلا خَيرَ ما لَم يَنفَعِ الغُصنُ أَصلَهُ","وَإِن ماتَ لَم تَحزَن عَلَيهِ أَقارِبُه",36,"ب",2,0],["وَلا خَيرَ في هَمٍّ إِذا لَم يَكُن لَهُ","زَماعٌ وَحَبلٌ لِلصَريمَةِ مُحصَدُ",37,"د",1,0],["وَلا خَيرَ في وِدِّ اِمرِئٍ مُتَلَّونٍ","إِذا الريحُ مالَت مالَ حَيثُ تَميلُ",38,"ل",1,0],["وَلا خَيرَ في الشَكوى إِلى غَيرِ مُشتَكي","وَلا بُدَّ مِن شَكوى إِذا لَم يَكُن صَبرُ",39,"ر",1,1],["وَلا خَيرَ فيمَن لا يُواسي بِفَضلِهِ","وَلا خَيرَ فيمَن لا يُرى وَجهُهُ طَلقا",40,"ق",2,0],["وَلا خَيرَ في مَن ظَلَّ يَبغي لِنَفسِهِ","مِنَ الخَيرِ ما لا يَبتَغي لِأَخيهِ",41,"ي",2,0],["وَلا خَيرَ فيمَن لا يُوَطِّنُ نَفسَهُ","عَلى نائِباتِ الدَهرِ حينَ تَنوبُ",42,"ب",1,1],["وَلا خَلَت كُلَّ عامٍ مِنكَ أَربَعَةٌ","نِسكٌ وَصَومٌ وَإِفطارٌ وَتَعيِيدُ",43,"د",1,0],["ولا خَيْرَ في خُلْقٍ يُذَمّ لجهله","وَيُحْمَدُ منه قبْلَ خِبرَتِهِ الشخصُ",44,"ص",1,0],["وَلا خائِفاً إِلّا جَريرَةَ رُمحِهِ","وَلا طالِباً إِلّا الَّذي تَطلُبُ الأُسدُ",45,"د",1,0],["ولا خلَّدْتُ ذكرَكَ في كتابٍ","ولا نجَّستُ ديواني بهجوِكْ",46,"ك",1,0],["ولا خيرَ في مالِ الفتى بعدَ عرضِهِ","ولا عيشَ في الدنيا إذا قبَّحَ الذكرُ",47,"ر",1,0],["وَلا خِطَّةٌ غَيرَ إِحدى اِثنَتَينِ","إِمّا نَعيمٌ وَإِمّا عَذاب",48,"ب",1,0],["ولا خيرَ في العيش إن لم يَفُزْ","على الجاهلِ الكيِّسُ العاقلُ",49,"ل",1,0],["وَلا خَبَّهُم مَشياً وَلا جِدَّهُم وَنىً","وَلا سَيفَهُم سوطاً وَلا تاجَهُم نَعلا",50,"ل",2,0],["وَلا خَرِبٍ خَيعابَةٍ ذي غَوائِلٍ","هَيامٍ كَجَفرِ الأَبطَحِ المُتَهَيِّلِ",51,"ل",1,0],["ولاختيارِكَ فضْلُ الوَحي إنّك لا","تأتي المآتيَ إلاّ من عَلٍ فَعَل",52,"ل",1,0],["ولا خيرَ في الدّنيا إذا لم يفُزْ بها","مليكٌ مُفَدّىً في اقتِبالٍ من العمر",53,"ر",1,0],["ولا خيرَ في فتكٍ بدونِ مجانة ؛","ولا في مجونٍ ليس يتبعُه كفرُ",54,"ر",1,0],["وَلا خافَ هَذا صالِحٌ عِندَ مَوتِهِ","عَلى عَقبِهِ في نادِياتِ الفَضائِحِ",55,"ح",1,0],["وَلا خَيرَ في وُدِّ اِمرِىءٍ مُتَصَنِّعٍ","بِما لَيسَ فيهِ وَالوِدادُ صَفاءُ",56,"ا",2,0],["وَلا خَيرَ في المَمكورَةِ الخَودِ أَضمَرَت","لَكَ الغِلَّ وَاِمتارَت جَوانِحُها مَكرا",57,"ر",2,0],["وَلا خَيرَ في جَونِ الذَوائِبِ عانِسٍ","إِذا لَم يَبِت فَوقَ الرِحالَةِ وَالعَنسِ",58,"س",1,0],["وَلا خَيرَ في أَن تُمَدَّ الحَياةُ","وَنُقصانُها مِثلُ إِكمالِها",59,"ل",3,0],["وَلا خَيرَ في خَيرٍ تَرى الشَرَّ دونَهُ","وَلا قائِلٍ يَأتيكَ بَعدَ التَلَدُّدِ",60,"د",1,0],["وَلا خَيرَ فيهِ غَيرَ أَنَّ لَهُ غِنىً","وَأَنَّ لَهُ كَشحاً إِذا قامَ أَهضَما",61,"م",2,0],["وَلا خَيرَ فِي جَهلٍ إِذَا لَم يَكُن لَهُ","حَلِيمٌ إِذَا ما أَورَدَ الأَمرَ أَصدَرا",62,"ر",2,0],["وَلا خيرَ فِي حِلمٍ إِذَا لَم تَكُن لَهُ","بَوَادِرُ تَحمي صَفوَهُ أَن يُكَدَّرا",62,"ر",2,0],["وَلا خير في لَيل توارَت نجومه","وَلا في نهار ما به أَوجه غر",63,"ر",1,0],["وَلا خير في غمد خلا من حسامه","وَلا في حسام ظل يصدأ مغمدا",64,"د",2,0],["وَلا خير في شعر مضى اليوم عهده","وفي شاعر إن قالَ قال مقلدا",64,"د",2,0],["وَلا خير في شعرٍ وإن راق لفظه","إذا كان عنه في الهداية يستغنَى",65,"ن",2,0],["ولا خَيرَ في مَن ليس يَبْسُطُ شُكرَهُ","على القُلّ إنّ الخَيْرَ ناقَتُهُ بِسطُ",66,"ط",1,0],["وَلا خَيرَ في الدُنيا إِذا أَنتَ لَم تَزُر","حَبيباً وَلَم يَطرَب إِلَيكَ حَبيبُ",67,"ب",1,0],["ولاَ خُلُقٌ رَاضٍ نَقِيٌّ كَأَنَّهُ","عَلَى كُلِّ حَالٍ طَاهِرُ الماءِ سلسَلاَ",68,"ل",2,0],["وَلاَ خُصُومَةَ إِلاَّ فِي اسْتِبَاقِهِمَا","لِمَا يَعُمُّ بِنَفْعٍ كُلَّ مَوْجُودِ",69,"د",1,0],["وَلأُخْتِكِ الزَّهْرَاء نُورٌ سَاطِعٌ","أَدَباً وَمعْرِفَةٍ وَحُسْنَ سُلُوكِ",70,"ك",1,0],["ولا خيوط لها غير النبات، وما","لها سوى الماء أصباغ، وأدهان",71,"ن",1,0],["ولا خطَّ الأعاجم فيه يومًا","ولا خَطَرت به يومًا نِزَار",72,"ر",1,0],["ولا خيرَ في ودِّ امرئ متصنِّعٍ","بما ليْس فيه، والْوِدادُ صفاء",73,"ا",2,0],["وَلاَ خَرِعٍ خَيْعَابَةٍ ذِي غَوائِلٍ","هَيامٍ كَجَفْرِ الأبْطَحِ الْمُتَهَيِّلِ",74,"ل",1,0],["ولا خيرَ في المُلك ما لم يُشَدْ","على أُسُسِ العلمِ بُنيانه",75,"ن",2,0],["ولا خيرَ في بَغيٍ تحاول نيلَها","إذا لم يُنهِكْ بيِّنَ البطش عاتيا",76,"ي",2,0],["ولا خير في ود امرىءٍ متلونٍ","إذا الريح مالت ، مال حيث تميل",77,"ل",1,0],["ولا خير في خيرٍ ترى الشر دونه","ولا نائلٍ يأتيك بعد التلدد",78,"د",1,0],["ولا خيرَ في هجرِ العشيرة ِ لامريءٍ","يَرُوحُ عَلى ذَمّ العَشِيرَة ِ أوْ يَغْدُو",79,"د",2,0],["ولا خيرَ في ودِّ امرئٍ متكارهٍ","عَلَيْكَ ولا في صَاحِبٍ لا توافِقُهْ",80,"ق",2,0],["ولا خير في الدنيا ولا في نعيمها","إذا قطعت معنى العاشق الحبلا",81,"ل",2,0],["ولا خير في عيش إذا كان مجدباً","يواطنه مصفرة والظواهر",82,"ر",1,0],["وَلا خَلَت مِنكَ أَوطانٌ بِكَ اِعتَصَمَت","لَولاكَ ما اِستَوطَنَت روحٌ بِها جَسَدا",83,"د",2,0],["وَلا خُلفَ أَنَّ الدَهرَ عادَ بِوَجهِهِ","إِلَيكَ إِلى أَن صارَ قُدّامُهُ خَلفا",84,"ف",2,0],["وَلا خَيَّبَ اللَهُ الكَريمُ دُعائَهُم","فَحَظٌّ لِدينِ اللَهِ أَن يُتَقَبَّلا",85,"ل",2,0],["وَلا خَلا مِنكَ ما جَلّى الدُجى فَلَقٌ","دَهرٌ بِكَ اِنكَشَفَت عَن أَهلِهِ الغُمَمُ",86,"م",1,0],["ولا خانَني حُسن اصطِباري وإنما","رُميتُ من البَلوى بأكثرَ من صَبري",87,"ي",1,0],["ولا خسر في الدنيا ولا هو خاسرٌ","سوى والهٍ والكفّ من كأسها صفر",88,"ر",1,0],["وَلا خَيرَ إِلّا في اتِباعِ كِتابِهِ","كَتائِبُ كِسرى أَذ عَنَت لِرِكابِهِ",89,"ه",1,0],["وَلا خُلقَ يُرضَى كُنهُهُ بَعدَ خُلقِهِ","رَؤفٌ إِذا أَلوى الزَمانُ بِرِفقِهِ",90,"ه",1,0],["ولا خلفه من للظبا فيه رغبة","ولا من له نفس بهن تسيل",91,"ل",1,0],["وَلا خالَ إِلّا دونَ مَن كانَ جَدُّهُ","سِنانٌ مَحَلُّ الضَيفِ رَحبُ جَنابِهِ",92,"ب",2,0],["وَلا خُضتُ أَمواجَ البِحارِ كَأَنَّها","جِبالٌ تَرامى بِي جَنوبٌ وَبارِحُ",93,"ح",1,0],["وَلا خَيرَ في مُستَحسَنِ النَقشِ مُطبَقٌ","إِذا حُكَّ نَفَّتهُ الأَكُفُّ النَواقِدُ",94,"د",1,0],["وَلا خَيرَ في هِلباجَةٍ كُلَّما أَتى","إلَيهِ الأَذى أَبدى خُضوعاً وَأَسجَدا",95,"د",2,0],["وَلا خَلَت باحَةُ البَحرَينِ مِنكَ وَلا","زالَت عِداتُكَ طُولَ الدَهرِ في قِصَرِ",96,"ر",1,0],["وَلا خَيرَ عِندي في حَياةٍ كَأَنَّها","حَياةُ دَعاميصِ الفَراشَةِ في الضَحلِ",97,"ل",1,0],["وَلا خالَ أَنَّ الدَهرَ يَسعى لِكَيدِهِ","فَيُلقى عَلَيهِ مِنهُ نَحرٌ وَكَلكَلُ",98,"ل",1,0],["وَلا خَيرَ في دارٍ يَعيشُ بِها الفَتى","مَهيناً وَلَو جادَتهُ دُرّاً غَمامُها",99,"م",3,0],["وَلا خانَ بَيتَ المالِ جَهراً ولا خَفا","وَلا زاغَ عَن نَهجِ الإِمامِ وَلا هَفا",100,"ف",2,0],["ولا خَطَرَتْ عَنْسٌ بِأَغْبَرَ نازِحٍ","ولا ما نَحَتْ عينايَ في الهَمَلانِ",101,"ن",1,0],["ولا خَيرَ فى حُبٍّ يكونُ كأَنّهُ","شَغَافٌ أَجنَّتهُ حَشاً وَضُلُوعُ",102,"ع",1,0],["ولا خالعا عني ثياب خواطر","تكدر قلبي عن وصالي لحضرتي",103,"ت",2,0],["وَلا خَيرَ فيما كَذَّبَ المَرءُ نَفسَهُ","وَتَقوالِهِ لِلشَيءِ يا لَيتَ ذا لِيا",104,"ي",2,0],["ولا خلقت كمثل الذل في رجلٍ","تسومهُ امرأَة سوءاً بعُدوان",105,"ن",1,0],["ولا خيرَ فيمن لا يحبُّ بلادَهُ","ولا في حليفِ الحب إن لم يتيم",106,"م",1,0],["ولا خيرَ فيمنْ إن أحبَّ دياره","أقام ليبكي فوقَ ربعٍ مهدم",106,"م",1,0],["وَلا خَيرَ في حُسنِ الجُسومِ وَطولِها","إِذا لَم يَزِن حُسنَ الجُسومِ عُقولُ",107,"ل",1,0],["ولا خلا منك روحي لا ولا بدني","كُلّي بكُلِّك مشغول ومُرتَهَنُ",108,"ن",1,0],["ولا خلت المنازل منك يوما","ولا أفلت نجومك من دياري",109,"ر",2,0],["ولا خطرَ السُلوانُ عنكم بخاطري","ولا مقلتي من بَعْدِكم طَعِمَتْ غَمْصا",110,"ص",2,0],["ولا خير في الراح إن لم تُعَنْ","بسُقْم العيون وتفتِيرها",111,"ر",3,0],["ولا خيرَ في أمرٍ إذا حلّه الفتى","غدا عِرضُه نَهْبا وإحسانُه قُبْحا",112,"ح",2,0],["ولا خيرةٌ في حياة امرئٍ","إذا لم يَخَفْ فَصْلَ يوم القضاءِ",113,"ا",2,0],["وَلا خَطَرَت عَلى رَوضٍ شَمالٌ","وَلا سَفَرَت عَنِ النَورِ الكِمامُ",114,"م",1,0],["وَلا خَلا رَبعُكِ المَأهولُ مِن مَدحي","يَوماً وَلا بابُكِ المَعمورُ مِن خِدمي",115,"م",2,0],["وَلا خَلَوتَ مِن فُؤادٍ صادِقٍ","وَلاؤُهُ وَمِن لِسانٍ شاكِرِ",116,"ر",1,0],["وَلا خَلا جودُكَ المُؤَمَّلُ مِن","وَفدِ ثَناءٍ إِلَيهِ مَجلوبِ",117,"ب",1,0],["وَلاَ خَسِرْتُمْ وَلاَ حَسَرْتُمْ","وَلاَ خَصِرْتُمْ وَلاَ حُصِرْتُمْ",118,"م",1,0],["ولا خير فيمن لا يدوم بقاؤه","وليس على حمد يدوم بدائم",119,"م",1,0],["ولا خير فيمن زرتهم فوجدتهم","أقارب إلا أنهم كالعقارب",120,"ب",1,0],["ولا خيرَ في القومِ الألى أنا بينَهم","كَثَوب غريبٍ أو كمالِ يتيم",121,"م",1,0],["وَلا خُضبَتْ بِأَفْئِدَة غِلاظٍ","تَسِيلُ عَلَى مَضَارِبِها الرَّقَاقِ",122,"ق",1,0],["وَلاَ خَلْفَنَا مِنْهَا مَفَرٌّ لِهَارِبٍ","فَكَيْفَ لِمَنْ رَامَ النَّجَاةَ التَّحَيُّلُ",123,"ل",1,0],["وَلا خَيرَ في رَوضٍ إِذا كانَ مُمحِلاً","وَلا كاغِدٍ بِالخَطِّ غَيرَ مُوَشَّمِ",124,"م",1,0],["وَلا خَيرَ إِلا اِحتِساءُ المُدامِ","وَقَد قيلَ ما الناسُ إِلا السُكارى",125,"ر",2,0],["وَلا خِفتُ الإِباقَ عَلى عَبيدي","وَلا خِفتُ الهَلاكَ عَلى دَوابي",126,"ب",2,0],["ولا خَيْرَ في حُسْنِ الجُسُومِ وَطولِها","إِذا لَمْ يَزِنْ طُولَ الجُسُومِ عُقولُ",127,"ل",1,0],["ولا خانَني صبري ولا خفَّ حادِثٌ","بِعَزمي إِذا ما الخَطبُ أَلقى المراسيا",128,"ي",2,0],["ولا خاب من يسعى بجيد الى المنى","ولو لم ينل الا على طول أزمان",129,"ن",1,0],["ولا خير في أنس تليه مذمة","ولا خير في نوم يجىء باحزان",129,"ن",1,0],["ولا خضعت نفسي لأمر ترومه","فكانت لشيء غير وصالك خضعتي",130,"ي",1,0],["ولا خير في الغازي إذا آب سالما","إلى الحيّ لم يجرح ولم يتحدّد",131,"د",1,1],["وَلا خَذَلتُ بِالقَهرِ بَعدَ اِنتِصارِها","وَلا عَجَزَت في ذاتِها بَعدَ قُدرَةِ",132,"ه",1,0],["وَلا خطَّ ابنُ مُقلةَ قَطُّ صاداً","تُشابه مِن لَواحظها عُيونا",133,"ن",2,0],["وَلا خَير في الكَفِّ مَقطوعَةً","وَلا خَير في الساعد الأَجزمِ",134,"م",1,0],["ولاخْتلافِ الخُطوطِ ما القَلَمُ ال","محْسودُ إلاّ سِيّانِ والزَّلَم",135,"م",1,0],["ولا خفَض الأقدارُ مَن كنتَ رافعاً","ولا نقَض الأيّامُ ما كنْتَ مُبرِما",136,"م",2,0],["ولا خاب إلاّ جَهولانِ منه","عَدُوُّ يُكايِدُه أو حَسود",137,"د",1,0],["ولا خابَتِ الآمالُ فيك بحالةٍ","فما أمَلُ الأقوامِ فيك بخائب",138,"ب",1,0],["ولأُخْبِرنَّ الناسَ حتّى يعلم الدْ","داني القريبُ معَ البعيدِ النائي",139,"ي",1,0],["وَلا خُبِّئَت عَنّا عَلى البُعدِ أَوجُهٌ","شَكا القُبحُ إِذ غَشَّى أَسِرَّتَها القُبحا",140,"ح",2,0],["ولا خلق قريب أو بعيد","ولا قاض ولا سلطان أووال",141,"ل",1,0],["ولا خيبتن يا مولاي ظني","ولا كذبت أطماعي والآمال",141,"ل",1,0],["ولا خلَتْ عن أهْلها طول المدى","ولا تَخطّى نحوها صرفُ القضا",142,"ا",1,0],["ولا خيرَ في الدّنيا لمِثلي ولو صَفَتْ","إذا كان لا يُرجى لنفعٍ ولا ضَرِّ",143,"ر",1,0],["ولا خَطَرَتْ إلاَّ وتذكّرتُ في الوغى","بهام خطير القدر ميلة خطّاري",144,"ي",1,0],["ولا خير في ودّ امرئٍ إنْ تلوَّنت","بيَ الحال من ريْب الزَّمان تلوُّنا",145,"ن",2,0],["ولا خير فيمن لا يؤمَّل نفعه","ولا يتَّقى من بأسه وضراره",146,"ر",2,0],["ولا خير في عيش الفتى وحياته","إذا لم يكنْ للنفع يرجى وللضرّ",147,"ر",1,0],["ولا خاب ظني من زماني وأنتم","رجايَ وحظّي منك شميت فمايله",148,"ل",2,0],["ولا خَلَتْ منك تاجاً للعِنانِ يَدٌ","ولا تَخلَّى ركابٌ حَليُهُ قَدَمُكْ",149,"ك",1,0],["ولا خَطَفَتْ لَكَ الأَرواحَ إِلّا","وَقَدْ أَرْوَيْتَهُنَّ من الدِّماءِ",150,"ا",2,0],["ولا خابَتْ مُناكَ وَقَدْ أَنافا","عَلَى رُتَبِ المعالي سامِيَيْنِ",151,"ن",1,0],["ولا خَزِيَتْ مآثِرُ ذِي كَلاعٍ","ولا أَخْوَتْ كواعِبُ ذِي رُعَيْنِ",151,"ن",1,0],["ولا خذَلَتْكُمْ يَدٌ فِي عِنانٍ","ولا خانكُمْ عاتِقٌ فِي نِجادِ",152,"د",1,0],["ولا خَتَرَتْ منكَ المكارِمُ والعُلا","صفاءَ مُصافِيها وإِلْفَ أَلِيفِها",153,"ف",3,0],["ولا خُلَّةٌ إِلّا الهَجِيرُ إِذَا