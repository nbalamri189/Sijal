قاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[467,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[467,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[496,"سواي الذي ترمي المطامع نبله","https://www.aldiwan.net/poem67285.html","عموديه"],[496,"إذا المرء لم يبن افتخارا لنفسه","https://www.aldiwan.net/poem67380.html","الطويل"],[508,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[516,"كأن رقيبا منك يرعى خواطري","https://www.aldiwan.net/poem67698.html","البسيط"],[518,"أنادي من الإخوان غير مجيب","https://www.aldiwan.net/poem12038.html","الطويل"],[518,"إن كبرت سني فلي همة","https://www.aldiwan.net/poem12156.html","السريع"],[518,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[518,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[519,"كسيت ولم املك سوادا وتحته","https://www.aldiwan.net/poem48646.html","الطويل"],[532,"ولي سلف فوق المجرة خيموا","https://www.aldiwan.net/poem37515.html","الطويل"],[554,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[554,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[554,"أقول لصحبي وقد هوموا","https://www.aldiwan.net/poem47189.html","المتقارب"],[554,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[554,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[554,"وقوفي في ذا الورى الخامل","https://www.aldiwan.net/poem47292.html","الخفيف"],[554,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[554,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[554,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[554,"أضن بنفسي عن هوى البيض كلما","https://www.aldiwan.net/poem48038.html","الطويل"],[554,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[554,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[554,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[554,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[565,"سلام وما يغني السلام على البعد","https://www.aldiwan.net/poem52946.html","الطويل"],[588,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28067","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28059","الطويل"],[1169,"","https://poetry.dctabudhabi.ae/diwan/poem/97696","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/97788","الوافر"]],"verses":[["وَلا خَيرَ في الدُنيا إِذا كُنتُ حاضِراً","وَكانَ الَّذي يَغرى بِهِ القَلبُ نائِيا",0,"ي",2,0],["وَلا خِضابُ العَهدِ أُعطيتَهُ","إِن نَصَلَ الأَقوامُ بِالناصِلِ",1,"ل",1,0],["وَلا خَطَوتُ إِلى بَأسٍ وَلا كَرَمٍ","إِلّا وَمَوضِعُ رِجلي مِنهُ مَوجودُ",2,"د",1,0],["وَلا خَيلٌ مُعَقَّدَةُ النَواصي","يَموجُ عَلى شَكائِمِها اللُعابُ",3,"ب",1,0],["ولا خَيْرَ في نَفْسٍ تَذِلُّ لحادِثٍ","يُلِمُّ ولا يَعْتادُها خُيَلاؤُها",4,"ا",3,0],["ولا خِفْتُ أن يَستَغويَ البيدُ ناظِري","فإني إذا ما اغْبَرّتِ الأرضُ ذِيبُها",5,"ب",3,0],["ولا خَيْرَ إلا في نِزارٍ وخَيْرُها","إذا حُصِّلَ الأحْسابُ دُودَانُ والنَّضْرُ",6,"ر",1,0],["وَلا خَيرَ في خِلٍّ يَخونُ خَليلَهُ","وَيَلقاهُ مِن بَعدِ المَوَدَّةِ بِالجَفا",7,"ف",2,0],["ولا خلْقَ أجْهَلُ ممّن يظُنّ","بمِقْدارِ مِثْليَ أنْ يجْهَلا",8,"ل",2,0],["وَلا خَيرَ في وُدِّ اِمرِئٍ مُتَكارِهٍ","عَلَيهِ وَلا في صاحِبٍ لا تُوافِقُه",9,"ق",2,0],["وَلا خَيرَ في وَعدٍ إِذا كانَ كاذِباً","وَلا خَيرَ في قَولٍ إِذا لَم يَكُن فِعلُ",10,"ل",1,0],["ولا خمار فيرددن الغبار به","ولا يقيهنّ حرّ الشمس سربال",11,"ل",1,0],["وَلا خَيرَ في مالٍ عَلَيهِ أَلِيَّةٌ","وَلا في يَمينٍ غَيرِ ذاتِ مَخارِمِ",12,"م",1,0],["ولا خالد يستطعم الماء قائماً","بِعِدلك والداعي إلى الموت أقربُ",13,"ب",1,0],["وَلا خافَتنِيَ الأَملاكُ إِن لَم","أُصَبِّحها بِمُلتَفِّ الغُبارِ",14,"ر",1,0],["وَلا خَيرَ في دَفعِ الرَدى بِمَذَلَّةٍ","كَما رَدَّها يَوماً بِسَوءَتِهِ عَمروُ",15,"ر",2,0],["وَلا خَيرَ في هَجرِ العَشيرَةِ لِاِمرِئٍ","يَروحُ عَلى ذَمِّ العَشيرَةِ أَو يَغدو",16,"د",2,0],["ولا خبرٌ في الحلمِ والعلمِ والثنا","تجاه الورَى إلاَّ وذكرك مبتدَا",17,"د",2,0],["ولأختمنّ بموضعِ التقبيل ما","ضمّ الثرى من قلبيَ المستودع",18,"ع",1,0],["ولا خيرَ في الدنيا إذا ما رعيتَها","وقد أيبستْ أجنابُها الخَضِراتُ",19,"ت",1,0],["ولا خلا ضدٌّ لكم ناطِحٌ","من ناطح يُودَى بِمَنْطُوحِ",20,"ح",1,0],["ولا خَلا حَظٌّ لكم مُنْفِسٌ","منْ كَاشحٍ في ثوب مَكْشُوحِ",20,"ح",1,0],["وَلا خَيْرَ في البُنْيانِ غيْرَ مُشَرَّفٍ","ولا خيْرَ في تشْرِيفِهِ أوْ يُوَطَّدُ",21,"د",1,0],["ولاختلال ثغورٍ طال ما حملتْ","أبناءهنّ على الجُرْد المحاضير",22,"ر",1,0],["ولا خُبث ريحٍ من مبالٍ مُلعَّنٍ","ولا شعراً في السِّفل والعلو قد شَمِط",23,"ط",1,0],["ولا خير لي فيما أُحِبُّ وتجتوي","لأنك من قلبي كنفسيَ موقعا",24,"ع",2,0],["ولا خُلِّيُوا من ثروةٍ وسماحةٍ","لِتُقْسَمَ أنفالٌ وتُصْلَح أحوالُ",25,"ل",1,0],["ولا خملَ المعروفُ منه فإنه","تحمَّلَ منه نابهاً غيرَ خاملِ",26,"ل",1,0],["ولا خطر التَّسَحُّبُ لي ببالٍ","كما يتسحَّبُ الحَمِقُ الجهولُ",27,"ل",1,0],["وَلا خَلائِقَ أَهليها وَزَيَّهُمُ","فَطالَما قَرَأتَ أَخلاقُهُم سِيَرا",28,"ر",2,0],["وَلا خَرِقٍ هَيقٍ كَأَنَّ فُؤادَهُ","يَظَلُّ بِهِ المُكَّاءُ يَعلو وَيَسفِلُ",29,"ل",1,0],["وَلا خالِفٍ دارِيَّةٍ مُتَغَزَّلٍ","يَروحُ وَيَغدو داهِناً يَتَكَحَّلُ",29,"ل",1,0],["وَلا خاطَبَتها مُقلَتايَ بِنَظرَةٍ","فَتَعلَمَ نَجوانا العُيونُ النَواظِرُ",30,"ر",1,0],["ولا خير في شعر اريد انتقاصه","ولم يتحفز للدفاع ويغضب",31,"ب",1,0],["وَلا خُلدَ حَتّى تَملَأَ الدَهرَ حِكمَةً","عَلى نُزَلاءِ الدَهرِ بَعدَكَ أَو عِلما",32,"م",2,0],["وَلا خانَتهُ أَيدي حامِليهِ","وَإِن ساروا بِصَبرِيَ وَالأَناةِ",33,"ه",1,0],["وَلا خَيرَ في الدُنيا وَلا في حُقوقِها","إِذا قيلَ طُلّابُ الحُقوقِ بُغاةُ",34,"ه",1,0],["ولا خَلَتِ الأيامُ منكم فإنَّكُمْ","لها غُرَرٌ فيها تلوحُ وتشدخُ",35,"خ",1,0],["وَلا خَيرَ ما لَم يَنفَعِ الغُصنُ أَصلَهُ","وَإِن ماتَ لَم تَحزَن عَلَيهِ أَقارِبُه",36,"ب",2,0],["وَلا خَيرَ في هَمٍّ إِذا لَم يَكُن لَهُ","زَماعٌ وَحَبلٌ لِلصَريمَةِ مُحصَدُ",37,"د",1,0],["وَلا خَيرَ في وِدِّ اِمرِئٍ مُتَلَّونٍ","إِذا الريحُ مالَت مالَ حَيثُ تَميلُ",38,"ل",1,0],["وَلا خَيرَ في الشَكوى إِلى غَيرِ مُشتَكي","وَلا بُدَّ مِن شَكوى إِذا لَم يَكُن صَبرُ",39,"ر",1,1],["وَلا خَيرَ فيمَن لا يُواسي بِفَضلِهِ","وَلا خَيرَ فيمَن لا يُرى وَجهُهُ طَلقا",40,"ق",2,0],["وَلا خَيرَ في مَن ظَلَّ يَبغي لِنَفسِهِ","مِنَ الخَيرِ ما لا يَبتَغي لِأَخيهِ",41,"ي",2,0],["وَلا خَيرَ فيمَن لا يُوَطِّنُ نَفسَهُ","عَلى نائِباتِ الدَهرِ حينَ تَنوبُ",42,"ب",1,1],["وَلا خَلَت كُلَّ عامٍ مِنكَ أَربَعَةٌ","نِسكٌ وَصَومٌ وَإِفطارٌ وَتَعيِيدُ",43,"د",1,0],["ولا خَيْرَ في خُلْقٍ يُذَمّ لجهله","وَيُحْمَدُ منه قبْلَ خِبرَتِهِ الشخصُ",44,"ص",1,0],["وَلا خائِفاً إِلّا جَريرَةَ رُمحِهِ","وَلا طالِباً إِلّا الَّذي تَطلُبُ الأُسدُ",45,"د",1,0],["ولا خلَّدْتُ ذكرَكَ في كتابٍ","ولا نجَّستُ ديواني بهجوِكْ",46,"ك",1,0],["ولا خيرَ في مالِ الفتى بعدَ عرضِهِ","ولا عيشَ في الدنيا إذا قبَّحَ الذكرُ",47,"ر",1,0],["وَلا خِطَّةٌ غَيرَ إِحدى اِثنَتَينِ","إِمّا نَعيمٌ وَإِمّا عَذاب",48,"ب",1,0],["ولا خيرَ في العيش إن لم يَفُزْ","على الجاهلِ الكيِّسُ العاقلُ",49,"ل",1,0],["وَلا خَبَّهُم مَشياً وَلا جِدَّهُم وَنىً","وَلا سَيفَهُم سوطاً وَلا تاجَهُم نَعلا",50,"ل",2,0],["وَلا خَرِبٍ خَيعابَةٍ ذي غَوائِلٍ","هَيامٍ كَجَفرِ الأَبطَحِ المُتَهَيِّلِ",51,"ل",1,0],["ولاختيارِكَ فضْلُ الوَحي إنّك لا","تأتي المآتيَ إلاّ من عَلٍ فَعَل",52,"ل",1,0],["ولا خيرَ في الدّنيا إذا لم يفُزْ بها","مليكٌ مُفَدّىً في اقتِبالٍ من العمر",53,"ر",1,0],["ولا خيرَ في فتكٍ بدونِ مجانة ؛","ولا في مجونٍ ليس يتبعُه كفرُ",54,"ر",1,0],["وَلا خافَ هَذا صالِحٌ عِندَ مَوتِهِ","عَلى عَقبِهِ في نادِياتِ الفَضائِحِ",55,"ح",1,0],["وَلا خَيرَ في وُدِّ اِمرِىءٍ مُتَصَنِّعٍ","بِما لَيسَ فيهِ وَالوِدادُ صَفاءُ",56,"ا",2,0],["وَلا خَيرَ في المَمكورَةِ الخَودِ أَضمَرَت","لَكَ الغِلَّ وَاِمتارَت جَوانِحُها مَكرا",57,"ر",2,0],["وَلا خَيرَ في جَونِ الذَوائِبِ عانِسٍ","إِذا لَم يَبِت فَوقَ الرِحالَةِ وَالعَنسِ",58,"س",1,0],["وَلا خَيرَ في أَن تُمَدَّ الحَياةُ","وَنُقصانُها مِثلُ إِكمالِها",59,"ل",3,0],["وَلا خَيرَ في خَيرٍ تَرى الشَرَّ دونَهُ","وَلا قائِلٍ يَأتيكَ بَعدَ التَلَدُّدِ",60,"د",1,0],["وَلا خَيرَ فيهِ غَيرَ أَنَّ لَهُ غِنىً","وَأَنَّ لَهُ كَشحاً إِذا قامَ أَهضَما",61,"م",2,0],["وَلا خَيرَ فِي جَهلٍ إِذَا لَم يَكُن لَهُ","حَلِيمٌ إِذَا ما أَورَدَ الأَمرَ أَصدَرا",62,"ر",2,0],["وَلا خيرَ فِي حِلمٍ إِذَا لَم تَكُن لَهُ","بَوَادِرُ تَحمي صَفوَهُ أَن يُكَدَّرا",62,"ر",2,0],["وَلا خير في لَيل توارَت نجومه","وَلا في نهار ما به أَوجه غر",63,"ر",1,0],["وَلا خير في غمد خلا من حسامه","وَلا في حسام ظل يصدأ مغمدا",64,"د",2,0],["وَلا خير في شعر مضى اليوم عهده","وفي شاعر إن قالَ قال مقلدا",64,"د",2,0],["وَلا خير في شعرٍ وإن راق لفظه","إذا كان عنه في الهداية يستغنَى",65,"ن",2,0],["ولا خَيرَ في مَن ليس يَبْسُطُ شُكرَهُ","على القُلّ إنّ الخَيْرَ ناقَتُهُ بِسطُ",66,"ط",1,0],["وَلا خَيرَ في الدُنيا إِذا أَنتَ لَم تَزُر","حَبيباً وَلَم يَطرَب إِلَيكَ حَبيبُ",67,"ب",1,0],["ولاَ خُلُقٌ رَاضٍ نَقِيٌّ كَأَنَّهُ","عَلَى كُلِّ حَالٍ طَاهِرُ الماءِ سلسَلاَ",68,"ل",2,0],["وَلاَ خُصُومَةَ إِلاَّ فِي اسْتِبَاقِهِمَا","لِمَا يَعُمُّ بِنَفْعٍ كُلَّ مَوْجُودِ",69,"د",1,0],["وَلأُخْتِكِ الزَّهْرَاء نُورٌ سَاطِعٌ","أَدَباً وَمعْرِفَةٍ وَحُسْنَ سُلُوكِ",70,"ك",1,0],["ولا خيوط لها غير النبات، وما","لها سوى الماء أصباغ، وأدهان",71,"ن",1,0],["ولا خطَّ الأعاجم فيه يومًا","ولا خَطَرت به يومًا نِزَار",72,"ر",1,0],["ولا خليت دور الفضائل والتقى","وطارت اعاصير الفنا بصحابها",73,"ب",3,0],["ولا ختلبتهم زهرة العيش في الهوى","ولا زينتهم في المخاري العمائم",74,"م",1,0],["ولا خيرَ في ودِّ امرئ متصنِّعٍ","بما ليْس فيه، والْوِدادُ صفاء",75,"ا",2,0],["وَلاَ خَرِعٍ خَيْعَابَةٍ ذِي غَوائِلٍ","هَيامٍ كَجَفْرِ الأبْطَحِ الْمُتَهَيِّلِ",76,"ل",1,0],["ولا خيرَ في المُلك ما لم يُشَدْ","على أُسُسِ العلمِ بُنيانه",77,"ن",2,0],["ولا خيرَ في بَغيٍ تحاول نيلَها","إذا لم يُنهِكْ بيِّنَ البطش عاتيا",78,"ي",2,0],["ولا خير في ود امرىءٍ متلونٍ","إذا الريح مالت ، مال حيث تميل",79,"ل",1,0],["ولا خير في خيرٍ ترى الشر دونه","ولا نائلٍ يأتيك بعد التلدد",80,"د",1,0],["ولا خيرَ في هجرِ العشيرة ِ لامريءٍ","يَرُوحُ عَلى ذَمّ العَشِيرَة ِ أوْ يَغْدُو",81,"د",2,0],["ولا خيرَ في ودِّ امرئٍ متكارهٍ","عَلَيْكَ ولا في صَاحِبٍ لا توافِقُهْ",82,"ق",2,0],["ولا خير في الدنيا ولا في نعيمها","إذا قطعت معنى العاشق الحبلا",83,"ل",2,0],["ولا خير في عيش إذا كان مجدباً","يواطنه مصفرة والظواهر",84,"ر",1,0],["وَلا خَلَت مِنكَ أَوطانٌ بِكَ اِعتَصَمَت","لَولاكَ ما اِستَوطَنَت روحٌ بِها جَسَدا",85,"د",2,0],["وَلا خُلفَ أَنَّ الدَهرَ عادَ بِوَجهِهِ","إِلَيكَ إِلى أَن صارَ قُدّامُهُ خَلفا",86,"ف",2,0],["وَلا خَيَّبَ اللَهُ الكَريمُ دُعائَهُم","فَحَظٌّ لِدينِ اللَهِ أَن يُتَقَبَّلا",87,"ل",2,0],["وَلا خَلا مِنكَ ما جَلّى الدُجى فَلَقٌ","دَهرٌ بِكَ اِنكَشَفَت عَن أَهلِهِ الغُمَمُ",88,"م",1,0],["ولا خانَني حُسن اصطِباري وإنما","رُميتُ من البَلوى بأكثرَ من صَبري",89,"ي",1,0],["ولا خسر في الدنيا ولا هو خاسرٌ","سوى والهٍ والكفّ من كأسها صفر",90,"ر",1,0],["وَلا خَيرَ إِلّا في اتِباعِ كِتابِهِ","كَتائِبُ كِسرى أَذ عَنَت لِرِكابِهِ",91,"ه",1,0],["وَلا خُلقَ يُرضَى كُنهُهُ بَعدَ خُلقِهِ","رَؤفٌ إِذا أَلوى الزَمانُ بِرِفقِهِ",92,"ه",1,0],["ولا خلفه من للظبا فيه رغبة","ولا من له نفس بهن تسيل",93,"ل",1,0],["وَلا خالَ إِلّا دونَ مَن كانَ جَدُّهُ","سِنانٌ مَحَلُّ الضَيفِ رَحبُ جَنابِهِ",94,"ب",2,0],["وَلا خُضتُ أَمواجَ البِحارِ كَأَنَّها","جِبالٌ تَرامى بِي جَنوبٌ وَبارِحُ",95,"ح",1,0],["وَلا خَيرَ في مُستَحسَنِ النَقشِ مُطبَقٌ","إِذا حُكَّ نَفَّتهُ الأَكُفُّ النَواقِدُ",96,"د",1,0],["وَلا خَيرَ في هِلباجَةٍ كُلَّما أَتى","إلَيهِ الأَذى أَبدى خُضوعاً وَأَسجَدا",97,"د",2,0],["وَلا خَلَت باحَةُ البَحرَينِ مِنكَ وَلا","زالَت عِداتُكَ طُولَ الدَهرِ في قِصَرِ",98,"ر",1,0],["وَلا خَيرَ عِندي في حَياةٍ كَأَنَّها","حَياةُ دَعاميصِ الفَراشَةِ في الضَحلِ",99,"ل",1,0],["وَلا خالَ أَنَّ الدَهرَ يَسعى لِكَيدِهِ","فَيُلقى عَلَيهِ مِنهُ نَحرٌ وَكَلكَلُ",100,"ل",1,0],["وَلا خَيرَ في دارٍ يَعيشُ بِها الفَتى","مَهيناً وَلَو جادَتهُ دُرّاً غَمامُها",101,"م",3,0],["وَلا خانَ بَيتَ المالِ جَهراً ولا خَفا","وَلا زاغَ عَن نَهجِ الإِمامِ وَلا هَفا",102,"ف",2,0],["ولا خَطَرَتْ عَنْسٌ بِأَغْبَرَ نازِحٍ","ولا ما نَحَتْ عينايَ في الهَمَلانِ",103,"ن",1,0],[