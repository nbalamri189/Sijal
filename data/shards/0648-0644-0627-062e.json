َطَنٌ","فإنّ أعطانكمْ للجودِ أَعطانُ",180,"ن",1,0],["ولا خيرَ في بارقٍ لم يكنْ","رسولَ الحَيا وبشيرَ الدِّيَمْ",181,"م",1,0],["وَلا خَيرَ فيمن لا يَطيعك قَلبُه","وَيَجشمُ ردّاً عَنك ما لم تجشّمِ",182,"م",1,0],["ولا خصمتْ أيّامنا لك دولةً","فلم يك في حقٍّ أبَنْتَ خصامُ",183,"م",1,0],["ولا خَدَعَتْهُ ذواتُ الحَلِيِّ","فيُصْبِيَهُ مَلَقُ العاطِلِ",184,"ل",1,0],["ولا خفقتْ في يومِ روعٍ قلوبُهمْ","وَلا اِرتَعدتْ خوفَ الحِمامِ الخصائلُ",185,"ل",1,0],["ولا خيرَ في رِفْدٍ تُمدُّ له يدٌ","وَلا في عطاءٍ يُقتضى عندهُ شكرُ",186,"ر",1,0],["وَلا خيرَ في وادٍ وأنت بغيرهِ","وما العيشُ مطلولاً خلافك بالرّغدِ",187,"د",1,0],["ولا خُدِعتْ عينِي بضوءِ وميضِهِ","ولا مُطِرَتْ أرضي بماء سحائِبِهْ",188,"ب",2,0],["وَلا خَلطتُ بِيَأسٍ عَن غنىً طمعاً","وَلا مَزجتُ عُقارَ الجِدِّ باللّعِبِ",189,"ب",1,0],["ولا خَير بعدكَ في الطيّباتِ","فَما العَيشُ بَعدك بالطيّبِ",190,"ب",1,0],["وَلا خَيرَ في مولىً يُعاطيكَ بِشْرَه","وَفي صَدرهِ غِلٌّ تدبّ عقاربُهْ",191,"ب",2,0],["وَلا خرقت مِنَ الأيّامِ جِلدي","أَظافرُ لا تقلَّمُ أو ينوبُ",192,"ب",1,0],["ولا خيرَ في قُربِ الدِّيارِ مع القِلَى","ولا بأسَ من بُعدِ الدِّيارِ مع الوُدِّ",193,"د",1,0],["ولا خير فيمن غدا طائِعاً","للؤمٍ أَلَمَّ وبُخْلٍ أَلَحْ",194,"ح",1,0]]}