{"poems":[[87,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[458,"حمدت ربي على ذمي فأكثره","https://www.aldiwan.net/poem61236.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77506","البسيط"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115681","الكامل"]],"verses":[["سُقراطُ أَعطى الكَأسَ وَهيَ مَنِيَّةٌ","شَفَتَي مُحِبٍّ يَشتَهي التَقبيلا",0,"ل",2,0],["سقراط مغدوّ عليه مصبح","فيك الزعاف ومنه الاستمراء",1,"ا",2,0],["سقراط لو جاورهم معافى","لم يذق السجن ولا الزّعافا",2,"ف",2,0],["سقراط ما عابه من راح يشتمه","ومن حباه بتلفيق وأوضار",3,"ر",1,0],["سُقراطُ لَما بَنى بَيتاً لِيسكنه","جاءَت لِتَنظُر هَذا البَيت جيرانُ",4,"ن",1,1],["سقراط قبلك والمسيح كلاهما","ضحكا من الموت الخؤون مهولا",5,"ل",2,0],["سقر دهما شرُّها مستطيرٌ","هو لها قد يشيبُ للولدانِ",6,"ن",1,0],["سقراط عقل الصب هام محبه","لما ترجح عنده المعقولُ",7,"ل",1,0]]}