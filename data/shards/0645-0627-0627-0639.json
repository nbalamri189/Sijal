"],[5758,"أحلام مؤجلة","https://www.poetsgate.com/ViewPoem.aspx?id=200524",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[402,"عيد تجدد فيه مجد عدنان","https://www.poetsgate.com/ViewPoem.aspx?id=36469",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"الى والدي","https://www.poetsgate.com/ViewPoem.aspx?id=202592",""],[5853,"ما أعذب الموت","https://www.poetsgate.com/ViewPoem.aspx?id=188356",""],[5854,"أذكيتَ نيرانَ وجدي يا نسيمُ كفى ((بين الحاء والباء))","https://www.poetsgate.com/ViewPoem.aspx?id=197020",""],[5906,"ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=187982",""],[5909,"يا رقّة الرؤيا التي آنستها","https://www.poetsgate.com/ViewPoem.aspx?id=210227",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[5957,"ما أعذب الحب وما أنبله","https://www.poetsgate.com/ViewPoem.aspx?id=180733",""],[6068,"‫أقسمت في جنح الظلام ونوم‬-14-","https://www.poetsgate.com/ViewPoem.aspx?id=175857",""],[6082,"آلة العودِ","https://www.poetsgate.com/ViewPoem.aspx?id=59174",""],[6089,"دفء الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=213041",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6294,"هل لامسّت معطفها ! ! !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69183&r=&rc=24",""],[147,"أَمّا الْفِراقُ فَقَدْ عاصَيْتُهُ فَأَبى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27437&r=&rc=4",""]],"verses":[["ما أَعجَبَ الناسَ الَّذي نَسكُنُهُ","يَجمَعُ ما بَينَ الوِهادِ وَالقُنَن",0,"ن",1,0],["ما أَعجَبَ الدَهرَ وَالأَيّامُ دائِبَةٌ","تَسعى عَلى عَمَدٍ نَحوي وَتَسعى لي",1,"ل",2,0],["ما أَعَزُّ الرِجالَ لَو","قَنِعوا بِالحَقائِقِ",2,"ق",1,0],["ما أَعجَبَ القِسمَةَ العَوجاءَ يَقسِمُها","الدارُ واحِدَةٌ وَالوِردُ مُختَلِفُ",3,"ف",1,0],["ما أَعطَياني وَلا سَأَلتُهُما","إِلّا وَإِنّي لَحاجِزي كَرَمي",4,"م",2,0],["مَا أَعْجَزَ الشِّعْرَ عَنْ إِيفَاءٍ حَقِّهِمَا","لَوْ أَنَّهُ صِيغَ مِنْ دُرٍّ وَعِقْيَانِ",5,"ن",1,0],["مَا أعْجَزَ اللَّسِنَ الفَصِيحَ لَدَى","عِيِّ الفَقِيدِ الخَالِدِ البَكِمِ",6,"م",1,0],["ما أَعجَبَ الحُبَّ يُمسي طَوعَ جارِيَةٍ","في الحَيِّ مَن عَجَزَت عَنهُ مَساعِرُهُ",7,"ر",2,0],["ما أعجبَ الحال لي قلبٌ بمصرَ وفي","دمشقَ جسمِي ودمعُ العينِ في حلب",8,"ب",1,0],["ما أعدلَ الدُّنيا وإن جارت بنا","لم يبقَ مِجزاع ولا مِفراح",9,"ح",1,0],["ما أعجب الحبّ يلقاني بسفك دمي","على النقا وهو محبوبٌ ومودود",10,"د",1,0],["ما أعجب الدهر في حالي تقلّبه","وصلٌ وصدٌّ وتعريفٌ وتنكير",11,"ر",1,0],["ما أعدلَ الحبَّ على جَورهِ","في خُلطة الأحمقِ والكيِّس",12,"س",1,0],["ما أعذر القِرنَ في تذبذبه","يُهوي إليك الشبا وينقدع",13,"ع",1,0],["ما أَعجَبَ الدَهر وَأَطوارَهُ","في عَينِ مَن يُمعِنُ في نَقدِهِ",14,"د",2,0],["ما أَعظَمَ حَسرَتي لِعُمرٍ","قَد ضاعَ وَلَم أَفُز بِطائِل",15,"ل",1,0],["ما أَعلَمُ مايَكونُ مِنّي","وَالأَمرُ كَما عَلِمتَ هائِل",15,"ل",1,0],["ما أُعيرَت مِنهُ بُطونُ القَراطي","سِ وَما حُمِّلَت ظُهورُ البَريدِ",16,"د",1,0],["ما اِعتاضَ باذِلُ وَجهِهِ بِسُؤالِهِ","عِوَضاً وَلَو نالَ المنى بِسؤالِ",17,"ل",1,1],["ما أَعجَبَ الدُنيا وَتَصريفَها","كَم لَوَّنَتني فَتَلَوَّنتُ",18,"ت",1,0],["ما أَعجَبَ المَوتَ ثُمَّ أَعجَبُ مِن","هُ مُؤمِنٌ موقِنٌ بِهِ ضَحِكا",19,"ك",2,0],["ما اِعتاضَ باذِلُ وَجهِهِ بِلِسانِهِ","عِوَضاً وَلَو نالَ الغِنى بِسُؤالِ",20,"ل",1,0],["ما اِعتِمادي عَلى الزَمانِ وَقَد أَو","دى بِمَولىً عَلَيهِ كانَ اِعتِمادي",21,"د",2,0],["ما أَعوَزَتنا فَرامينٌ نَصولُ بِها","إِلا جَعَلنا مَواضينا فَرامينا",22,"ن",2,0],["ما أعظم النجوى الرفيعة كلما","يشدو بها روحان يحترقان",23,"ن",1,0],["ما أعجب الدنيا التي بعث الهوى","وأحالها روضاً أغر جديدا",24,"د",2,0],["ما أعجب الإيمان يغمر خاطري","كالفجر قد غمر السماء وئيدا",24,"د",2,0],["ما أعوزَتْ منهُ الظبا","إلا طرازَ كَمهِ",25,"ه",1,0],["ما أعجبَ القومَ رأيُ اللّاعبينَ بهم","حَقٌّ ورأيُ الجلائيّينَ مُتَّهَمُ",26,"م",1,0],["ما أعظمَ البلوى ويا لكِ نَكبةً","ملَكتْ علينا النقضَ والإبراما",27,"م",2,0],["ما أَعرِفُ اللَذاتِ إِلّا ذاكِراً","هَيهاتَ قَد خَلَّفتُ لَذّاتي بِها",28,"ب",3,0],["ما أَعْدَمَ اللهُ مَوْجُوداً وَأَوْجَدَ","مَعْدُوماً صَلاَة دَوَاماً لَيْسَ تَنْحَصِرُ",29,"ر",1,0],["ما أَعدَلَ المَوتَ مِن آتٍ وَأَستَرَهُ","فَهَيِّجني فَإِني لَستُ مُهتاجِ",30,"ج",1,0],["ما أَعجب الأرض أُمَّاً غير مشفقة","من بعد أَن تلد الأبناء تلتقف",31,"ف",1,0],["ما أُعفيت ديارهم","من الرزايا بل عفت",32,"ت",1,0],["مَا أَعْجَلَ الأَقْدَارُ فِي اسْتِرْدَادِهَا","بَعْدَ السَّمَاحِ نَفْيَهَا المُسْتَوْدَعَا",33,"ع",2,0],["مَا أعْلَقَ الشَّدْوَ الرَّخيمَ","بِكُلِّ قَلَّبٍٍ مُولَعِ",34,"ع",1,0],["مَا اعْتَلَّ رَأْيُهُ وَلَمْ يَلْجَأْ إِلْى","مَايحْدِثُ الشُّبْهَةَ مِنْ تَعْلِيلِ",35,"ل",1,0],["ما أعظم الضوضاء يحدثها","فؤاد المستهام",36,"م",1,0],["ما أعجب ما يأتي به القدر","أنا الأشياء تحتضر",37,"ر",1,0],["ما أَعجَبَ الدَهرَ في تَصَرُّفِهِ","وَالدَهرُ لا تَنقَضي عَجائِبُهُ",38,"ه",1,1],["ما اعْتَلَى الطِبُّ قِمَّةَ النَّجْمِ إلاَّ","بجِنَاحٍ من سَعْيه المَحْمُودِ",39,"د",1,0],["ما أَعْوَلَ الصخرُ، لكنْ قد شدا طَرَبًا","كما شدا الطيرُ فوقَ الأيك والبانِ",40,"ن",1,0],["ما أعجب الإنسان هذا ملؤه","خير وهذا الشرّ فيه مجسّمُ !",41,"م",1,0],["ما أعدلَ الموتَ من آتٍ، وأستَرَهُ،","فهيّجني، فإني غَيرُ مُهتاجِ",42,"ج",1,0],["ما اعتلَّ لي خاطرٌ إلا وقابلني","بطائرٍ من نَدى كفيهِ مَيْمُونِ",43,"ن",1,0],["ما اعتاض من عزِّك إلا كما","يُعتاضُ عن سيفٍ بِمخراقِ",44,"ق",1,0],["ما اِعتَضتُ مِنكَ وَلَو مُلِّكتُ ما مَلَكَت","يَمينُ قارونَ أَو أُسكِنتُ عَرشَ سَبا",45,"ب",2,0],["مَا اعْتَنَقْنا حَتَّى افْتَرَقْنا وَخفتا","نُ الدُّجى عَنْ قَمِيصِهِ مَحْلولُ",46,"ل",1,0],["ما اعتدت أن ترمي الجيوش بفيلق","إلا وهمَّ الجيس منك المهربُ",47,"ب",1,0],["ما أعظم البلوى على مغرى بهم","قطعوه لا سيما وقد وصلوه",48,"و",2,0],["ما اِعتَنَّ لي يَأسٌ يُناجي هِمَّتي","إِلّا تَحَدّاهُ رَجاءٌ فَاِكتَمى",49,"ا",1,0],["ما أعوزَ الصبرَ في الأوصابِ من دَنِفِ","يذيقهُ البَينُ صَبراً ديفَ بال