{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"ما بعد يومك ما يسلو به السالي","https://www.aldiwan.net/poem29885.html","البسيط"],[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[35,"كأن فاها لمن توسنها","https://www.aldiwan.net/poem38827.html","المنسرح"],[93,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[72,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[72,"هل بعد وجهك للرجاء نجاح","https://www.aldiwan.net/poem18487.html","الكامل"],[72,"في الريق سكر وفي الأصداغ تجعيد","https://www.aldiwan.net/poem18560.html","البسيط"],[72,"أطلق دموعك إن القلب معذور","https://www.aldiwan.net/poem18717.html","البسيط"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[91,"مثلي هذا النجم في سهده","https://www.aldiwan.net/poem8804.html","عموديه"],[70,"تأبى وإلى متى التمادي","https://www.aldiwan.net/poem42745.html","مجزوء الدوبيت"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[58,"ما اعتاض باذل وجهه بسؤاله","https://www.aldiwan.net/poem30915.html","الكامل"],[49,"آمنت بالله وأيقنت","https://www.aldiwan.net/poem10851.html","السريع"],[49,"المرء مستأثر بما ملكا","https://www.aldiwan.net/poem62203.html","المنسرح"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[97,"يا صفوة الأحباب والخلانِ","https://www.aldiwan.net/poem24739.html","الكامل"],[97,"أدركت عندك يوميَ الموعودا","https://www.aldiwan.net/poem24761.html","الكامل"],[69,"طرز قباء محنتي","https://www.aldiwan.net/poem29286.html","مجزوء الرجز"],[105,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[105,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[52,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[67,"يا رب صل على المختار من مضر","https://www.aldiwan.net/poem18126.html","البسيط"],[46,"ما عاقد الحبل يبغي بالضحى عضدا","https://www.aldiwan.net/poem22260.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147477",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55020","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10269","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[106,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[100,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[46,"ما عاقدُ الحبل يبغي بالضّحى عَضَداً،","https://www.poetsgate.com/ViewPoem.aspx?id=18255",""],[128,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[142,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[143,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[155,"رسم صبري في ربع شوقي محيل","https://www.aldiwan.net/poem55583.html","الخفيف"],[160,"يا أيها الملك الذي لا يغلب","https://www.aldiwan.net/poem58818.html","الكامل"],[160,"أما الوشاة به فقد ظلموه","https://www.aldiwan.net/poem58961.html","الكامل"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[166,"غدا أحل عن الأوتاد أطنابي","https://www.aldiwan.net/poem47130.html","البسيط"],[169,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[186,"ما اعتاض واهب نفسه عشيقه","https://www.aldiwan.net/poem43528.html","الكامل"],[186,"ذم الزمان سفاهة يتبشع","https://www.aldiwan.net/poem43639.html","الكامل"],[197,"أسفر الصبح قم نحيي الصباحا","https://www.aldiwan.net/poem39883.html","الخفيف"],[210,"يا ظبية البان يا غصن النقا النضر","https://www.aldiwan.net/poem13316.html","البسيط"],[210,"أحيا الربيع الأرض بعد مماتها","https://www.aldiwan.net/poem13322.html","الكامل"],[210,"حنت إلى مرأى علاكم جلق","https://www.aldiwan.net/poem13555.html","الكامل"],[223,"أمن العدل خالق الأرواح","https://www.aldiwan.net/poem39713.html","الخفيف"],[225,"ما أعجب النيل ما أبهى شمائله","https://www.aldiwan.net/poem55149.html","البسيط"],[231,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[235,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[256,"إن بني برمك لو شاهدوا فعلك","https://www.aldiwan.net/poem48540.html","السريع"],[259,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[270,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[270,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[275,"يا قرة العين إن العين تهواك","https://www.aldiwan.net/poem25546.html","البسيط"],[281,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[282,"آرام رامة عن بان الحمى بانوا","https://www.aldiwan.net/poem32376.html","البسيط"],[302,"خطايا الشعراء","https://www.aldiwan.net/poem65691.html","البسيط"],[305,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[342,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[342,"صنو الرسول تحية وسلام","https://www.aldiwan.net/poem55338.html","الكامل"],[353,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[364,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[409,"يا دار أنت التي كان الجميع بها","https://www.aldiwan.net/poem31651.html","عموديه"],[409,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[437,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[453,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[458,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[458,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[458,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[458,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[479,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[500,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[553,"الجود أخشن مسا يابني مطر","https://www.aldiwan.net/poem68349.html","البسيط"],[567,"ما اعتاد عيني غمض","https://www.aldiwan.net/poem69625.html","مجزوء الرجز"],[575,"لا تحسبوه إذا التحى","https://www.aldiwan.net/poem2972.html","مجزوء الكامل"],[575,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[586,"ما ذاب سقاما في الهوى لولاكم","https://www.aldiwan.net/poem17706.html","الدوبيت"]],"verses":[["ما أَعجَبَ الناسَ الَّذي نَسكُنُهُ","يَجمَعُ ما بَينَ الوِهادِ وَالقُنَن",0,"ن",1,0],["ما أَعجَبَ الدَهرَ وَالأَيّامُ دائِبَةٌ","تَسعى عَلى عَمَدٍ نَحوي وَتَسعى لي",1,"ي",1,0],["ما أَعَزُّ الرِجالَ لَو","قَنِعوا بِالحَقائِقِ",2,"ق",1,0],["ما أَعجَبَ القِسمَةَ العَوجاءَ يَقسِمُها","الدارُ واحِدَةٌ وَالوِردُ مُختَلِفُ",3,"ف",1,0],["ما أَعطَياني وَلا سَأَلتُهُما","إِلّا وَإِنّي لَحاجِزي كَرَمي",4,"م",2,0],["مَا أَعْجَزَ الشِّعْرَ عَنْ إِيفَاءٍ حَقِّهِمَا","لَوْ أَنَّهُ صِيغَ مِنْ دُرٍّ وَعِقْيَانِ",5,"ن",1,0],["مَا أعْجَزَ اللَّسِنَ الفَصِيحَ لَدَى","عِيِّ الفَقِيدِ الخَالِدِ البَكِمِ",6,"م",1,0],["ما أَعجَبَ الحُبَّ يُمسي طَوعَ جارِيَةٍ","في الحَيِّ مَن عَجَزَت عَنهُ مَساعِرُهُ",7,"ر",2,0],["ما أعجبَ الحال لي قلبٌ بمصرَ وفي","دمشقَ جسمِي ودمعُ العينِ في حلب",8,"ب",1,0],["ما أعدلَ الدُّنيا وإن جارت بنا","لم يبقَ مِجزاع ولا مِفراح",9,"ح",1,0],["ما أعجب الحبّ يلقاني بسفك دمي","على النقا وهو محبوبٌ ومودود",10,"د",1,0],["ما أعجب الدهر في حالي تقلّبه","وصلٌ وصدٌّ وتعريفٌ وتنكير",11,"ر",1,0],["ما أعدلَ الحبَّ على جَورهِ","في خُلطة الأحمقِ والكيِّس",12,"س",1,0],["ما أعذر القِرنَ في تذبذبه","يُهوي إليك الشبا وينقدع",13,"ع",1,0],["ما أَعجَبَ الدَهر وَأَطوارَهُ","في عَينِ مَن يُمعِنُ في نَقدِهِ",14,"د",2,0],["ما أَعظَمَ حَسرَتي لِعُمرٍ","قَد ضاعَ وَلَم أَفُز بِطائِل",15,"ل",1,0],["ما أَعلَمُ مايَكونُ مِنّي","وَالأَمرُ كَما عَلِمتَ هائِل",15,"ل",1,0],["ما أُعيرَت مِنهُ بُطونُ القَراطي","سِ وَما حُمِّلَت ظُهورُ البَريدِ",16,"د",1,0],["ما اِعتاضَ باذِلُ وَجهِهِ بِسُؤالِهِ","عِوَضاً وَلَو نالَ المنى بِسؤالِ",17,"ل",1,1],["ما أَعجَبَ الدُنيا وَتَصريفَها","كَم لَوَّنَتني فَتَلَوَّنتُ",18,"ت",1,0],["ما أَعجَبَ المَوتَ ثُمَّ أَعجَبُ مِن","هُ مُؤمِنٌ موقِنٌ بِهِ ضَحِكا",19,"ك",2,0],["ما اِعتاضَ باذِلُ وَجهِهِ بِلِسانِهِ","عِوَضاً وَلَو نالَ الغِنى بِسُؤالِ",20,"ل",1,0],["ما اِعتِمادي عَلى الزَمانِ وَقَد أَو","دى بِمَولىً عَلَيهِ كانَ اِعتِمادي",21,"د",2,0],["ما أَعوَزَتنا فَرامينٌ نَصولُ بِها","إِلا جَعَلنا مَواضينا فَرامينا",22,"ن",2,0],["ما أعظم النجوى الرفيعة كلما","يشدو بها روحان يحترقان",23,"ن",1,0],["ما أعجب الدنيا التي بعث الهوى","وأحالها روضاً أغر جديدا",24,"د",2,0],["ما أعجب الإيمان يغمر خاطري","كالفجر قد غمر السماء وئيدا",24,"د",2,0],["ما أعوزَتْ منهُ الظبا","إلا طرازَ كَمهِ",25,"ه",1,0],["ما أعجبَ القومَ رأيُ اللّاعبينَ بهم","حَقٌّ ورأيُ الجلائيّينَ مُتَّهَمُ",26,"م",1,0],["ما أعظمَ البلوى ويا لكِ نَكبةً","ملَكتْ علينا النقضَ والإبراما",27,"م",2,0],["ما أَعرِفُ اللَذاتِ إِلّا ذاكِراً","هَيهاتَ قَد خَلَّفتُ لَذّاتي بِها",28,"ب",3,0],["ما أَعْدَمَ اللهُ مَوْجُوداً وَأَوْجَدَ","مَعْدُوماً صَلاَة دَوَاماً لَيْسَ تَنْحَصِرُ",29,"ر",1,0],["ما أَعدَلَ المَوتَ مِن آتٍ وَأَستَرَهُ","فَهَيِّجني فَإِني لَستُ مُهتاجِ",30,"ج",1,0],["ما أَعجب الأرض أُمَّاً غير مشفقة","من بعد أَن تلد الأبناء تلتقف",31,"ف",1,0],["ما أُعفيت ديارهم","من الرزايا بل عفت",32,"ت",1,0],["مَا أَعْجَلَ الأَقْدَارُ فِي اسْتِرْدَادِهَا","بَعْدَ السَّمَاحِ نَفْيَهَا المُسْتَوْدَعَا",33,"ع",2,0],["مَا أعْلَقَ الشَّدْوَ الرَّخيمَ","بِكُلِّ قَلَّبٍٍ مُولَعِ",34,"ع",1,0],["مَا اعْتَلَّ رَأْيُهُ وَلَمْ يَلْجَأْ إِلْى","مَايحْدِثُ الشُّبْهَةَ مِنْ تَعْلِيلِ",35,"ل",1,0],["ما أعظم الضوضاء يحدثها","فؤاد المستهام",36,"م",1,0],["ما أعجب ما يأتي به القدر","أنا الأشياء تحتضر",37,"ر",1,0],["ما أَعجَبَ الدَهرَ في تَصَرُّفِهِ","وَالدَهرُ لا تَنقَضي عَجائِبُهُ",38,"ه",1,1],["ما اعْتَلَى الطِبُّ قِمَّةَ النَّجْمِ إلاَّ","بجِنَاحٍ من سَعْيه المَحْمُودِ",39,"د",1,0],["ما أَعْوَلَ الصخرُ، لكنْ قد شدا طَرَبًا","كما شدا الطيرُ فوقَ الأيك والبانِ",40,"ن",1,0],["ما أعجب الإنسان هذا ملؤه","خير وهذا الشرّ فيه مجسّمُ !",41,"م",1,0],["ما أعدلَ الموتَ من آتٍ، وأستَرَهُ،","فهيّجني، فإني غَيرُ مُهتاجِ",42,"ج",1,0],["ما اعتلَّ لي خاطرٌ إلا وقابلني","بطائرٍ من نَدى كفيهِ مَيْمُونِ",43,"ن",1,0],["ما اعتاض من عزِّك إلا كما","يُعتاضُ عن سيفٍ بِمخراقِ",44,"ق",1,0],["ما اِعتَضتُ مِنكَ وَلَو مُلِّكتُ ما مَلَكَت","يَمينُ قارونَ أَو أُسكِنتُ عَرشَ سَبا",45,"ب",2,0],["مَا اعْتَنَقْنا حَتَّى افْتَرَقْنا وَخفتا","نُ الدُّجى عَنْ قَمِيصِهِ مَحْلولُ",46,"ل",1,0],["ما اعتدت أن ترمي الجيوش بفيلق","إلا وهمَّ الجيس منك المهربُ",47,"ب",1,0],["ما أعظم البلوى على مغرى بهم","قطعوه لا سيما وقد وصلوه",48,"و",2,0],["ما اِعتَنَّ لي يَأسٌ يُناجي هِمَّتي","إِلّا تَحَدّاهُ رَجاءٌ فَاِكتَمى",49,"ا",1,0],["ما أعوزَ الصبرَ في الأوصابِ من دَنِفِ","يذيقهُ البَينُ صَبراً ديفَ بالصّاب",50,"ب",1,0],["ما اِعتِذاري وَالوَغى تَعرِفُني","وَالعَوالي وَالمَواضي وَالهَوادي",51,"د",2,0],["ما اعتاض واهب نفسه عِشِّيقه","عوضا ولو ملك الهوى أطواقه",52,"ق",2,1],["ما أعجب الدنيا وأطرف أمرها","حيّ يموت ونطفة تستودع",53,"ع",1,0],["ما أعرنا عذل العواذل أذنا","إذ سمعنا عواء