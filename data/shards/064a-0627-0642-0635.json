{"poems":[[85,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[90,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[53,"خذ نصيبا من عيشك المستعار","https://www.aldiwan.net/poem64086.html","الكامل"],[87,"يا قصر رأس التين","https://www.aldiwan.net/poem7145.html","السريع"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[100,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[113,"يا قصر كم صحبتك من نعم","https://www.aldiwan.net/poem16624.html","المنسرح"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[230,"شوق يهيجه نواك","https://www.aldiwan.net/poem55226.html","مجزوء الكامل"],[443,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[463,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[549,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[558,"يا قصر جعفر مالي عنك إقصار","https://www.aldiwan.net/poem68379.html","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80000","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48962","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77345","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120981","الكامل"],[3143,"","https://poetry.dctabudhabi.ae/diwan/poem/144415","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125975","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85038","الطويل"],[3869,"","https://poetry.dctabudhabi.ae/diwan/poem/34861","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73252","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147312","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139480",""],[4748,"أوهام","https://www.poetsgate.com/ViewPoem.aspx?id=4344",""],[4764,"إنكسار الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=24544",""],[4804,"يا قصر ذا النخلات من بارا","https://www.poetsgate.com/ViewPoem.aspx?id=92094",""],[4829,"غارت الخيل الاصايل","https://www.poetsgate.com/ViewPoem.aspx?id=34422",""],[4869,"ما على المجنون ديّه","https://www.poetsgate.com/ViewPoem.aspx?id=151579",""],[4919,"صباح الخير يا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=35207",""],[4929,"إرسالة إلى دماج","https://www.poetsgate.com/ViewPoem.aspx?id=202564",""],[4984,"جسر الهوى خشب","https://www.poetsgate.com/ViewPoem.aspx?id=175564",""],[5106,"مِهْرَجَانُ الشَّمْس .","https://www.poetsgate.com/ViewPoem.aspx?id=153972",""],[5136,"نم دمعي ولي لسان صموت","https://www.poetsgate.com/ViewPoem.aspx?id=121533",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5433,"ياللي تموت ببردها","https://www.poetsgate.com/ViewPoem.aspx?id=36113",""],[5461,"قصيدة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=5295",""],[5612,"حكاية","https://www.poetsgate.com/ViewPoem.aspx?id=191059",""],[5756,"المملكة عندنا غير","https://www.poetsgate.com/ViewPoem.aspx?id=5189",""],[5939,"لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=185500",""],[6302,"رَهْناً لِدَاعيَةِ الحَنينْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86222&r=&rc=20",""]],"verses":[["يا قصر شنّيل وربعك آهلٌ","والروض منك على الجمال قد اقتصرْ",0,"ر",1,0],["يا قصر باب التبر كنت مُقَرَّناً","والنَفيُ يَصدُر منك والاثبات",1,"ت",1,0],["يا قصار الأيام متِّعت لو كن","ت قصاراً موصولة بقصار",2,"ر",1,0],["يا قصر رأس التين قم في غد","رحب بعبد الله زين الشباب",3,"ب",1,1],["يا قُصوراً نَظَرتُها وَهيَ تَقضي","فَسَكَبتُ الدُموعَ وَالحَقُّ يُقضى",4,"ض",2,0],["يا قصورَ المنى على شفق الأَحْ","لامِ كم مُشفقٍ عليكِ وحائم",5,"م",1,0],["يا قَصر كَم صحبتك مِن نعم","مَوصولة المُكرَمات وَالدُوَلِ",6,"ل",1,1],["يا قصيدي لك ثار","عند أبناء العراق",7,"ق",1,0],["يا قصيدي بك نار","شبّها ذاك الفراق",7,"ق",1,0],["يا قَصرَ رأسِ التين با","لَغَ في جَمالِك مَن بَناك",8,"ك",1,0],["يا قصارى منتهى أملي","لك منّي القلب والكبد",9,"د",1,0],["يا قِصَر الليل دمْ لنائمه","فالليلُ لولا السهاد لم يطُلِ",10,"ل",1,0],["يا قَصُرتْ يدُ الزمان شدَّ ما","تطول في ثَلْمي وفي نقضِ المِرَرْ",11,"ر",1,0],["يا قِصَّةَ التُّفَّاحِ.. خيرُ رُواَتِها","في الخالدينَ : رحيقُها والسُّكَّرُ",12,"ر",1,0],["يا قَصرَ جَعفَرَ مالي عَنكَ إِقصارُ","لي فيكَ إِلفٌ وَأَشجانٌ وَأَوطارُ",13,"ر",1,1],["يا قصرتْ يدُ الليالي ما جنت","على أبي المهديّ في امتدادها",14,"د",3,0],["يا قصر أَحمد شاهقاً","في روضةِ العُليا مَداك",15,"ك",1,0],["يا قَصرَ مَن رَحَلَت وَخَلَّفَت الحَشا","وَقفاً عَلى البُرَحاءِ وَالأَشجانِ",16,"ن",1,0],["ياقصر نجد أنت أكرم منزلا","فلقد شفعت الحسن بالإحسانِ",17,"ن",1,0],["يا قصر ما فعل المرا","م الساكنون قديم عصرك",18,"ك",1,1],["يا قصر خبرني وكن صادقا","عن سر ما يخطر في لبه",19,"ب",2,0],["يا قصر لا أعلم ماذا جرى","حتى أطللت اليوم في حجبه",19,"ب",2,0],["يا قصر كن خير رسول لمن","أصبح عز القلب في قربه",19,"ب",2,0],["يا قَصارى صِحاحِ الوَصفِ في الحُبِّ أَنَّهُ","لَقاموسِ حُسنٍ قُرباً لِعَجزِ شارِحُه",20,"ح",2,0],["يا قَصرُ شَأنُكَ بُخلُ صاحِبِكَ الَّذي","ما فيهِ مَع إِمساكِهِ مُستَمتَعُ",21,"ع",1,1],["يا قصرُ أَينَ أَحبتَّي","كانوا لَنا عونا وذخرا",22,"ر",2,0],["يا قصة الدنيا مداك رواية","يروي لنا أحداثها الكُتّاب",23,"ب",1,0],["يا قصياً عن المشابة مجداً","وعلياً به تسامى العلاء",24,"ا",2,0],["يا قصيدة حب فكري ينظمك","يا بدر نور على الليل والعتم",25,"م",1,0],["يا قصيدة شوق ضاعت .. بين أحلام وطيوف","إحتويتي من عَذابي .. الزوايا المعدمه",26,"م",2,0],["يا قصر ذا النخلات من بارا","اني حننت اليك من قارا",27,"ر",2,1],["ياقصايد وكفخي من مدرج(ن) خطّطه شيب","احملي اذكى القنابل لزمت الغارة لزام",28,"م",1,0],["ياقصايد هاك رمحي اللي مضرابه عطيب","اصعقيبه مثل برقن لاتدلى من الغمام",28,"م",1,0],["يآقصيدي وين رايح ملّت افكاري طريقك","اعكس الدرب وتوكل مطفي الكون بأذيّه",29,"ي",2,1],["يآقصيدي باكسر افكاري توكل بل ريقك","خلني بجلس دقايق او دقيقه او شويّه",29,"ي",2,0],["يا قصايص الذهب شعرهن والوجنات","مطرزة بنجوم والعنق سكر",30,"ر",1,0],["يا قصةً بالمأساةِ مُثقلةً","ومأتماً بالأحزان ينفردُ",31,"د",1,0],["يا قصر حلمي الذي شيدت من هوسي","دعها وحكم القضا ، إياك تعذله",32,"ل",2,0],["يَا قُصُورَاً أَرْوَسَتْ عَنْ قِلاعٍ","لَا أَرَىْ فِيْهَا مِنَ الجُنْدِ حَيَّا",33,"ي",2,0],["يا قصياً ثناه عني رقيبي","وتثنى قوامه لا ثنيت",34,"ت",1,0],["يا قصر إن صحاب النزل قد رحلوا","وإنك اليوم متروك ومهجورُ",35,"ر",1,0],["ياقصيدي كان الأشعار سادات وعبيد","والله انك من بحور ،غريبٍ جدها",36,"د",3,0],["يا قصيدة عمري اللي تكتبيني","كل يوم حرف من نغمة هواك",37,"ك",1,1],["يا قِصَّةً كتبَ التَّبْريحُ أحْرُفَها","كيْفَ الذَّبيحَةُ للقَصّابِ تَحْكيها !!",38,"ي",3,0],["يا قصة الكوثر, ويا زمزم البير","ويا موقع أقدام الخليل ومقامه",39,"م",2,0],["يا قصّةَ عمرٍ أضناني","تحكيها أشعاري عزفا",40,"ف",2,0],["يا قصةً لو كان يُغني رجعُها ..","..أشعلتُ هذا الكونَ بحرَ أغاني",41,"ن",2,0]]}