https://www.poetsgate.com/ViewPoem.aspx?id=181528",""],[6068,"في أي فلب أسكن -14-","https://www.poetsgate.com/ViewPoem.aspx?id=175866",""],[6102,"مراهقة ..","https://www.poetsgate.com/ViewPoem.aspx?id=185048",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[186,"لبني الجبيلي الكرام مناحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55889&r=&rc=152",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[5567,"يغشى الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81772&r=&rc=40",""]],"verses":[["فَإِذا نَظَرتَ إِلى أَنامِلِهِ","تَندى حَسِبتَ بِكَفِّهِ نَبعا",0,"ع",2,0],["فَإِذا نَثَرتَ عَلى الصَحيفَةِ خِلتُها","غَرساً أَلَحَّ عَلَيهِ صَوبُ قِطارِ",1,"ر",1,0],["فَإِذا نَهَيتَ فَطاعَةٌ","وَإِذا أَمَرتَ فَلا مَرَدّا",2,"د",2,0],["فإذا نظرت فكم جديد حولها","تزهى به الأغوار والنجاد",3,"د",1,0],["فَإذَا نَظَمْتَ فَأَنْتَ أَوَّلُ شَاعِرٍ","وَإذَا نَثَرْتَ فَأيْنَ مِنْكَ الثَّانِي",4,"ن",2,0],["فَإِذَا نَقَدْتَ فَأَنْتَ أَصْدَقُ طَائِرٍ","بَصَراً بِقَاصٍ فِي الأُمُورِ وَدَانِ",5,"ن",1,0],["فَإِذَا نَأَيْتُمْ لا حُرِمْنَا عَوْدَكُمْ","مِنْ عُيَّبٍ مُتَرَقِّبِينَ كِرَامِ",6,"م",1,0],["فإذا نظمتُ من المناقب دُرَّها","شرفتني منها بنظم داري",7,"ر",2,0],["فإذا نظرت رأيت ثمة أرضه","تجري الرياح بها وهنّ سوافي",8,"ف",2,0],["فإذا نظرتَ وجدتَ أرزاقَ الورى","ودمَ العداةِ يفيضُ من أنبوب",9,"ب",1,0],["فَإِذا نَظَرتَ إِلَيهِما مُتأَمِّلاً","شاهَدتَ حَولَكَ وُحدَةَ الأَكوانِ",10,"ن",1,0],["فَإِذا نالَكَ الزَمانُ بِخَطبٍ","نالَ كُلُّ الأَحبابِ مِنهُ نَصيبا",11,"ب",2,0],["فَإِذا نَوَت سَفَراً إِلَيكَ سَبَقنَها","فَأَضَفتَ قَبلَ مُضافِها حالاتِها",12,"ت",3,0],["فَإِذا نَأى عَنها حَظي بِكَمالِهِ","وَإِذا دَنا مِنها رُمي بِمَحاقِهِ",13,"ه",1,0],["فَإِذا نَظَمتُ فَإِنَّني لَكَ مادِحٌ","وَإِذا نَشَرتُ فَإِنَّني لَكَ حامِدُ",14,"د",1,0],["فَإِذا نَظَرتَ نَدى يَدَيهِ رَأيَهُ","لَم تُلفِ إِلّا صائِباً أَو صائِبا",15,"ب",2,0],["فإذا نَظَرْتَ إلى مَرَاتبِ مُلكه","وبدتْ إليك شواهدُ البرهانِ",16,"ن",1,0],["فَإِذا نِعمَةُ اِمرِىءٍ فَرِكَتهُ","فَاِهتَصِرها إِلَيكَ وَلهى عَروبا",17,"ب",2,0],["فَإِذَا نَطَقْتُ فَبِالثَّنَاءِ عَلَى الَّذِي","أَوْلَتْهُ مِنْ فَضْلٍ عَلَيَّ وَأَنْعُمِ",18,"م",1,0],["فَإِذَا نَسَبْتُ فَتَنْتُ كُلَّ مُقَنَّعٍ","وَإِذَا نَأَمْتُ ذَعَرْتُ كُلَّ مُلَثَّمِ",18,"م",1,0],["فَإِذا نَعجَةٌ تُراعي نِعاجاً","وَمَهاً نِجلَ المَناظِرِ عينا",19,"ن",2,0],["فَإِذا نَشَدَت نَشَدتَ رَسماً عافِياً","وَإِذا رَأَيتَ رَأَيتَ وَسماً خافِيا",20,"ي",2,0],["فإذَا نَظَرْتَ إلى مقاصِدِهِ بهَا","أَبْدَتْ إليكَ حَقيقةَ المُتَجَرِّدِ",21,"د",1,0],["فإذا نَظَرْتَ نَظرْتَ غَيرَ مُشَبَّهٍ","إلاّ التِماحَكَ رايَةً ورَعِيلا",22,"ل",2,0],["فَإِذا نَزَعتُ عَنِ الغَوايَةِ فَليَكُن","لِلَّهِ ذاكَ النَزعُ لا لِلناسِ",23,"س",1,0],["فَإِذا نَحنُ اِلتَقَينا فِتنَةً","لَم تَكُن عَوناً وَكانَت وَتِدا",24,"د",2,0],["فإذا نظمت البيت من","هُ أعيده وأكرر",25,"ر",1,0],["فَإِذَا نَضارَتُها ذَوَتْ وَكَأَنَّهَا","عَيْنٌ أَسَالَ الحُزْنُ مِنْها مَدْمَعَا",26,"ع",2,0],["فَإِذَا نَظَرْتِ فَكَمْ جَديدٍ حَوْلَهَا","تزْهى بِه الأَغْوَارُ وَالأَنجَادُ",27,"د",1,0],["فَإِذَا نَعَاهُ الضَّحَى","مَاذَا دَهَى مِسْمَعَكْ",28,"ك",1,0],["فَإِذَا نِظَامُ الْقوْلِ لمْ يَفِ شُكْرَهُ","فلْيُسْعِدِ الرَّيْحَانُ وَهْو نِثارُ",29,"ر",1,0],["فَإِذَا نَبَا بِيَ مَتْنُ برٍّ","فَالمَطِيَّةُ بَطْنُ لُجِّ",30,"ج",1,0],["فإذا نظرنَ فعَن مريض","وإذا بسمنَ فعن وميض",31,"ض",1,0],["فإذا نِمْتُ فالظلاَّمُ أمامِي","أَوْ تيقَّظْتُ فالسَّوادُ حِيالي",32,"ل",2,0],["فإذا نظرتَ فخذْ لنفسِك حِذْرها","إنّ العيونَ كما علمتَ سهام",33,"م",1,0],["فإذا \" ناصر \" يقود تلالا","من شباب القوى تدك تلالا",34,"ل",2,0],["فَإذَا نَظَرْتَ إلى أَسِرَّةِ وَجْهِهِ","بَرَقَتْ كَبَرْقِ الْعَارِضِ المُتَهَلِّلِ",35,"ل",1,0],["فَإِذا نَوَت سَفَرًا إِلَيكَ سَبَقتها","فَأَضَفتَ قَبلَ مُضافِها حالاتِها",36,"ت",3,0],["فإذا نزت همجٌ الى طمع نزا","اوصَفّقَتْ فيه قرودٌ صفقا",37,"ق",2,0],["فإذا نظرت إليها متأمّلا","شاهدت حولك وحدة الأكوان",38,"ن",1,0],["فإذا نشدت نشدت رسماً عافياً","وإذا رأيت وسماً خافيا",39,"ي",2,0],["فاذا نسجت القول في رق وقد","حصرت ضوابطه اتاك يسامر",40,"ر",1,0],["فإذا نظرت إليها تنظر منظراً","قمراً يلوح بظلمة متظلما",41,"م",2,0],["فإذا نسبت نسبته شرف النسب","وإذا خدمت خدمته لك مخدما",41,"م",2,0],["فإذا نالك منها طرَفٌ","فتيقن عن قليلٍ يَضْمِحلّْ",42,"ل",1,0],["فإذا نظرتَ إلى قفاهُ حسبتهُ","نبتت عليهِ شقائقُ النعمانِ",43,"ن",1,0],["فإذا نظرن فإنهنَّ","على النفوس غوالب",44,"ب",1,0],["فَإِذَا نَحْنُ وَالرَّدَى فِي الغَيَابَا","تِ فَأَدْنَى إِلَيَّ كَأْسَ حِمَامِ",45,"م",1,0],["فإِذا نظرتُ إِلى محاسنهِ","أَخْرَجْتُه عُطْلاً من الذَّنْبِ",46,"ب",1,0],["فإِذا نظرتُ إِلى محاسنِ وَجْههِ","لم يَرْوَ من نظري إِليهِ ظَمائِي",47,"ا",2,0],["فإِذا نزلتَ عليه ساءَ صباحُهُ","ومبيتُه بالمنذرِ العريانِ",48,"ن",1,0],["فإذا نطقنا قال رمحي ناظمٌ","وإِذا نظمنا قال سيفي باترُ",49,"ر",1,0],["فَإِذا نَظمتَ لِرَمسهِ التأريخَ قُلْ","حُزتَ بالرِّضى يا كاهِنَ اللَّهِ العَلِي",50,"ل",2,0],["فإذا نوَّر حادِيهمْ غدا","عَرِّضا بأسمى لذاك الرَّبْربِ",51,"ب",1,0],["فإذا نمت فقطي","وحمامي عند خدّي",52,"د",2,0],["فَإِذا نَحاهُ المُعتَفونَ وَعَرَّسوا","بِذَراهُ أَنقاضاً عَلى أَنقاضِ",53,"ض",1,0],["فَإِذا نَظَرْتَ إِلَيْهِ راعَكَ لَمْعُهُ","وَعَلَلْتَ طَرْفَكَ مِنْ سَرابٍ صادِقِ",54,"ق",1,0],["فإِذا نظرتَ جمالَها","ترتدُّ ذا طرف حسير",55,"ر",1,0],["فَإِذا نادى المُنادي","أَينَ أَيسارُ الجُزورِ",56,"ر",1,0],["فَإِذا نَبا بي مَنزِلٌ لا يُرتَضى","جاوَزتُهُ وَاِختَرتُ عَنهُ مَنزِلا",57,"ل",2,0],["فإذا نأَى أمَسى أسير صَبابةٍ","وإذا دنا أضحَى قَتيل صُدود",58,"د",1,0],["فإذا نَضا عن مَتْنتَيهِ سَوادَهُ","لِيُجِيبَ دَعْوةَ صارخٍ مُستَنْجِد",59,"د",1,0],["فإِذا نَشا فيها وأَنشَأ سُنَّةً","في النَّاسِ كانَ عَلى سَبيلٍ سابِلِ",60,"ل",1,0],["فإذا نظرنا في يسوع وأمه","فنراه فيها طابَعاً إذ يَختم",61,"م",1,0],["فإذا نظرت إليه خلتك منته","عن حملك الأسفار في الأسفار",62,"ر",1,0],["فَإِذا نَهاهُ عاذِلٌ عَن جودِهِ","لَم يُثنِهِ وَكأَنَّهُ أَغراهُ",63,"ا",2,0],["فَإِذا نَطَقتُ فَأَنت أَوَل مَنطِقي","وَإِذا سكت فَأَنتَ في إِضماري",64,"ر",2,0],["فإذا نهاني عن رجاء لقائهم","يأسي هفا قلب إليهم شيق",65,"ق",1,0],["فإذا نهضت حسبت أني حامل","جبلا وأمشي إن مشيت