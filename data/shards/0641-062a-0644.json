/poem3197.html","عموديه"],[465,"حال في الحب عهده","https://www.aldiwan.net/poem3575.html","عموديه"],[480,"لا تفكر في طارف وتليد","https://www.aldiwan.net/poem36868.html","الخفيف"],[487,"قالت ولم تقصد لقول الخنا","https://www.aldiwan.net/poem479.html",""],[501,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[515,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[516,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[530,"الحمد لله على","https://www.aldiwan.net/poem37118.html","مجزوء الرجز"],[530,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[552,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[552,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[559,"نفسي على نفسي الوجود بها نزل","https://www.aldiwan.net/poem34240.html","الكامل"],[563,"غزالة معشر فيها نفار","https://www.aldiwan.net/poem52714.html","الوافر"],[564,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"],[568,"سجاياك من طيب أعراقها","https://www.aldiwan.net/poem69568.html","المتقارب"]],"verses":[["فَتَلهو عَزائِمُنا بِالخُطوبِ","وَتَهزَأُ أَجفانُنا بِالحُلُم",0,"م",1,0],["فَتَلتُم عَلى ضَلعاءَ مَنقوضَةِ القِوى","إِذا ما اِستَمَرَّت بِالرِجالِ المَرائِرُ",1,"ر",1,0],["فَتَلَ الطَوى أَجوافَها بِظُهورِها","وَأَحَلَّ أَكلَ لُحومِها لِلبيدِ",2,"د",1,0],["فَتِلكَ مِثلي إِذ زُرتُ مَنزِلَةً","أَرى مَهاها فأَينَ خُرَّدُها",3,"د",3,0],["فَتِلْكَ قُدودٌ مِنْ قِيانٍ لِهذِهِ","عَلَيها إِذا ما غَرَّدَتْ نَغَماتُها",4,"ت",3,0],["فتلفّعَتْ بحَبيّها قُلَلُ الرُّبا","وتلثّمَتْ منْ بَرْقِها بضِرامِ",5,"م",1,0],["فتلكَ أيديهمُ تُدْمي سَماحَتُها","والسّؤدَدُ الغَمْرُ حيثُ البأسُ والجودُ",6,"د",1,0],["فتُلْحَظُ منْ أنْوارِهِ سورَةُ الضُّحى","وتُحْفَظُ منْ آثارِهِ سورَةُ الحَمْدِ",7,"د",1,0],["فَتِلكَ أُشَبِّهُها إِذ غَدَت","تَشُقُّ البِراقَ بِإِصعادِها",8,"د",3,0],["فَتِلكَ إِذا الحُجوزُ أَبى عَلَيهِ","عِطافَ الهَمِّ وَاِختَلَطَ المَريدُ",9,"د",1,0],["فَتِلكَ الَّتي حَرَّمَتكَ المَتاعَ","وَأَودَت بِقَلبِكَ إِلّا شَقيصا",10,"ص",2,0],["فَتِلكَ لَم تَتَّرِك مِن خَلفِها شَبَهاً","إِلّا الدَوابِرَ وَالأَظلافَ وَالزَمَعا",11,"ع",2,0],["فَتَلقَ أُناساً لا يَخيمُ سِلاحُهُم","إِذا كانَ حَمّاً لِلصَفيحِ الجَماجِمُ",12,"م",1,0],["فَتِلكَ دُنياهُمُ في الجَوِّ قَد نَزَعَت","أَعِنَّةَ الريحِ مِن دُنيا سُلَيمانِ",13,"ن",1,0],["فَتَلَطَّفتَ لِأَن حَلَّيتَني","مولِياً طولي مُحَلّىً مُلبَسِ",14,"س",1,0],["فَتِلكَ الَّتي هَامَ الفُؤَادُ بحُبِّهَ","مُهفهَفَةٌ بَيضَاءُ دُرِّيَّة القُبَل",15,"ل",1,0],["فَتِلكَ الَّتي أَصفيتُهابِمَوَدَّتي","وَليدًا وَلمّا يَستَبِن لي نُهودُها",16,"د",3,0],["فتلتقي مأثرات قومي","يصدق الظاهر الدفينا",17,"ن",2,0],["فَتِلكَ الَّتي يَعتادُني مِن خَبالِها","عَلى النَأيِ داءُ السِحرِ أَو شَبَهُ السِحرِ",18,"ر",1,0],["فتلك نجد سقاها كلُّ منسجمٍ","من الغمام يُحيّيها فيُحْييها",19,"ي",3,0],["فتلك إذا ما تصوّرتها","جليّاً لعمري هي المكتب",20,"ب",1,0],["فتلك حبيبة لا بدّ منها","وإن عذل الرقيب ولام واش",21,"ش",1,0],["فتلك التي طاب لي وصلها","كما ليلة البدر طاب السمر",22,"ر",1,0],["فتلك عليها فؤادي يحوم","وتلك إليها الردى أقتحم",22,"م",1,0],["فتلقى دروساً لو وعتها حياتنا","لبدّل كذب في سعادتها صدقا",23,"ق",2,0],["فتلك رؤياي غيرَ كاذبة","فهل تُغيثون أيها العرب",24,"ب",1,0],["فتلك مصيبة يا أم منها","نكاد نغص بالماء الفرات",25,"ت",1,0],["فتلك التي مازلت أبكي لأجلها","بكاءً إذا ما اشتدّ أدّى إلى الصرع",26,"ع",1,0],["فَتِلكَ الَّتي لَيسَت بِذاتِ دَمامَةٍ","وَلَم يَعرُها مِن مَنصِبِ الحَيِّ قادِحُ",27,"ح",1,0],["فَتِلكَ مَساعٍ لَم تَنَلها مُجاشِعٌ","سُبِقتَ فَلا تَجزَع مِنَ المَوتِ مَجزَعا",28,"ع",2,0],["فَتِلكُم بِتِلكُم غَيرَ فَخرٍ عَلَيكُم","وَبَيتٌ عَلى الأَفلاجِ ثُمَّ مُقيمُ",29,"م",1,0],["فتلك إليك تقدم مذهبات","بها يترنم الوله الطروبُ",30,"ب",1,1],["فتلك غيابة النغمات أمست","ترهيا بالعقاب لمجرمينا",31,"ن",2,1],["فَتِلكَ لا ذَاكَ وهي بالمُحرِمِ الشَّ","حِبِ في مُحرِمِينَ قد شَحَبُوا",32,"ب",3,0],["فَتِلكَ أمورُ النَّاسِ أضحَت كأَنَّها","أُمورُ مُضِيعٍ آثَرَ النَّومَ بُهَّلُ",33,"ل",1,0],["فَتلك وِلاةُ السَوءِ قد طالَ ملكُهم","فحَتَّامَ حَتَّامَ العَنَاءُ المُطَوَّلُ",33,"ل",1,0],["فتلك لا ذاك وهم بالمحرم","الشاحب في محرمين قد شحبوا",34,"ب",3,0],["فَتِلكَ ثِيَابُ إِسماعِيل فِينَا","صَحاحاً ما دنِسنَ وما بَلِينَا",35,"ن",2,0],["فَتِلكُ قَنَاتُنَا لم تُبلَ ضَعفاً وَلاَ","خَورَاً ثقافُ الغَامِزِينَا",35,"ن",2,0],["فَتلكَ غَيَايَةُ النَّقَمَات أمسَت","تَرَهيَأُ بالعقَاب لمُجرمينَا",35,"ن",2,0],["فتلقاه أحمد باسم الثغر","عليما بما انطوى في الخفاء",36,"ا",2,0],["فتُلفَى الدلافينُ الكريمُ طباعُها","هناك رِعالاً عند نَكبِ النواكبِ",37,"ب",1,0],["فتُلفى وأُلفَى بين صافي صنيعةٍ","وصافي ثناءٍ لم يُشَبْ بالمعاتِبِ",37,"ب",1,0],["فتلك الرّيحُ ممّا أجتويهِ","وعَلّامِ المشاهدِ والغيوبِ",38,"ب",1,0],["فَتُلْحَى لعمري في ثوابٍ لويتَه","وأنت امرؤ في الجود يلحاك من لحَا",39,"ح",2,0],["فتلك من آرائه شُبهةٌ","مثلك من أمثالها يَسْلمُ",40,"م",1,0],["فتلك مرائينا التي هي حَسْبُنا","ووجهُ أبي سَهْلٍ قريعِ الأعاجمِ",41,"م",1,0],["فتلوَّمْتَ واقفاً موقِف الأش","قرِ بين التأخير والتقديم",42,"م",1,0],["فتلك الخلافةُ تعتدُّهم","يدَ الدهر أركان بنيانها",43,"ن",3,0],["فتلقَّينهم بأهلاً وسهلاً","رافعات إليهمُ الريحانا",44,"ن",2,0],["فَتِلكَ الِّتي لا يَبرَحُ القَلبَ حُبُّها","وَلا ذِكرُها ما أَرزَمَت أُمُّ حائِلِ",45,"ل",1,0],["فَتِلكَ خُطوبٌ قَد تَمَلَّت شَبابَنا","زَماناً فَتُبلينا الخُطوبُ وَما نُبلي",46,"ل",2,0],["فَتِلكَ الَّتي لَم تُخطِ قَلبي بِسَهمِها","وَما وَتَّرَت قَوساً وَلا رَصَفَت نَبلا",47,"ل",2,0],["فَتِلكُم قُرَيشٌ عِندَ ذاكَ وَأَنتُمُ","مَكانَ الخُصى قُدّامَهُنَّ المَناخِرُ",48,"ر",1,0],["فَتِلكَ بُيوتٌ لا تُنالُ فُروعُها","طِوالٌ أَعاليها شِدادُ الأَسافِلِ",49,"ل",1,0],["فَتَلَفَّتَت في الرَوضِ خيفَةَ سامِعٍ","فَكَأَنَّها الظَبيُ الغَريرُ إِذا رَنا",50,"ا",1,0],["فَتِلكَ مَطايانا وَفَوقَ رِحالِها","نُجومٌ تَخَطّى ظُلمَةً وَصَحارِيا",51,"ي",2,0],["فَتَلَوْتُ الصَّلاةْ","في خشوعِ الظِّلالْ",52,"ل",1,0],["فَتَلَفَّتوا يَتَهامَسونَ لَعَلَّهُ","فَجرُ الحَضارَةِ في البِلادِ أَضاءَ",53,"ا",2,0],["فَتَلَقّى فيهِما ما راعَهُ","مِن خَفِيِّ الهَمسِ أَو جَهرِ النِداء",54,"ا",2,0],["فَتَلَفَّت وَتَنَسَّم حِكمَةً","وَاِلمِس العِبرَةَ مِن بَينِ الفِقَر",55,"ر",1,0],["فَتَلَفَّتَت باريسُ تَح","سَبُ أَنَّها صُنعُ البَنين",56,"ن",1,0],["فَتَلَقّاهُ أَبٌ كَم مِن أَبٍ","دونَهُ في الناسِ بِالوُلدِ اِهتِماما",57,"م",2,0],["فَتَلَقَّتهُمُ عَزائِمُ صِدقٍ","نُصَّ لِلدينِ بَينَهُنَّ خِباءُ",58,"ا",2,0],["فُتلِ الأَيادي رَبِذاتِ الأَرجُلِ","آثارُها أَمثالُها في الجَندَلِ",59,"ل",1,0],["فَتَلَ الحِبالَ مِنَ الغَدائِرِ فَوقَهُ","وَبَنى السَفينَ لَهُ مِنَ الصُلبانِ",60,"ن",1,0],["فَتَلَجلَجَت عَبَراتُها ثُمَّ اِنبَرَت","تَصِفُ الهَوى بِلِسانِ دَمعٍ مُعرِبِ",61,"ب",1,0],["فَتِلكَ جِبالُها عادَت سُهولاً","وَكانَت قَبلَ مَغزاهُ حُزونا",62,"ن",2,0],["فَتِلكَ كَأَنَّ راحِلَتي اِستَعارَت","قَوائِمَها الخَوانِفَ وَالفَقارا",63,"ر",2,0],["فَتِلكَ بُيوتٌ هُنَّ أَحلَلنَكَ العُلى","فَأَصبَحتَ فيها مُشمَخِرَّ المَنازِلِ",64,"ل",1,0],["فَتِلكَ مَساعينا قَديماً وَسَعيُنا","كَريمٌ وَخَيرُ السَعيِ قِدماً أَكارِمُه",65,"م",2,0],["فَتَلقَّ فِطرَك مُطْلِعاً","سعْداً يَسُرُّك غيرَ آفِل",66,"ل",1,0],["فَتَلَّ لِوَجهِهِ فَرَفَعتَ عَنهُ","رَقيقَ الحَدِّ حُودِثَ بِالصِّقالِ",67,"ل",1,0],["فَتَلا مَلِياً جُلَّ سورَةِ يوسُفِ","وَجَلا مُحَيّاً مِثلِ صورَةِ يوسُفِ",68,"ف",1,0],["فَتَلاهُ مِن دُموعي وابِلٌ","لا يَزيدُ القَلبَ إِلّا عَطَشا",69,"ش",2,0],["فَتِلكَ عَرينٌ لِلأُسودِ وَبَينَها","مَسالِكُ فيها لِلظِباءِ مَسارِحُ",70,"ح",1,0],["فَتِلكَ أَفلاكُ سَعدٍ لا يَلوذُ بِها","مِن مارِدٍ لَخَفيِّ السَمعِ مُستَرِقِ",71,"ق",1,0],["فَتلفتت روحي تُرَجّى قطرةً","من كأسِه أو وقفةً في جانِه",72,"ن",2,0],["فتلفتي تجدي عرينك عامراً","وتسمّعي كم قائل لبيك",73,"ك",1,0],["فتلفتت كحبيس أشراك","وحكى اضطراب الموج نهداها",74,"ه",2,0],["فَتَلَقّ الرَّوْحَ من ريحانةٍ","حَيّتِ الشَّربَ بها راحةُ ريم",75,"م",1,0],["فتلاقى في فمي من كأسِهِ","ماءُ كرْمٍ وغمامٌ وشَنَبْ",76,"ب",1,0],["فَتِلكَ شُقوري لا اِرتِيادُكِ بِالأَذى","مَحَلِّيَ إِلّا تَبكُري تَتَأَوَّبي",77,"ب",2,0],["فَتِلْكَ لَعَمْرِي عِيشَةٌ بَدَوِيَّةٌ","مُوَطَّأَةُ الأَكْنَافِ رَاسِخَةُ الرُّكْنِ",78,"ن",1,0],["فَتِلْكَ الَّتِي لا وَصْلُهَا مُتَوَقَّعٌ","لَدَيْن