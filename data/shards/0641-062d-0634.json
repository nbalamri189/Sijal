{"poems":[[23,"ولقد بكيت وعز مهلك جعفر","https://www.aldiwan.net/poem21429.html","الكامل"],[87,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[156,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[354,"مذ أفقرت ممن أحب الأربع","https://www.aldiwan.net/poem15781.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122820","الوافر"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110647","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108051","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[5423,"نوم العذال عَن سهره","https://www.poetsgate.com/ViewPoem.aspx?id=191658",""],[5725,"سما عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=208922",""]],"verses":[["فُحشاً وَأَكثَرِها إِذا ما تُجتَدى","فَضلاً وَأَبذَلِها نَدىً وَأَدَلَّها",0,"ل",3,0],["فَحَشَونَ أَفواهَ السُهولِ سَبائِكاً","وَمَلَأنَ أَقبالَ الرَواسِخِ جَوهَرا",1,"ر",2,0],["فَحَشا بِطَعنَتِهِ حَشى مُتَنَفَّسٍ","تَحتَ الدُجى عَن مارِجٍ مُتَسَعِّرِ",2,"ر",1,0],["فحُشِّدت إليهِ أَعلامُ الكُوَرْ","ومَن لَهُ في النَّاسِ ذِكرٌ وخطَرْ",3,"ر",1,0],["فَحَشْدُ ذِئَابٍ، وَحَشْدُ ذُبَابٍ","وَحَشْدُ جَرَادٍ، وَحَشْدٌ، وَحَشْدُ",4,"د",1,0],["فَحَشا عُيونَهُم فَأَدبَرَ جَمعَهُم","كالوَحشِ نافِرَةً إِلى الميزانِ",5,"ن",1,0],["فَحَشاشَتي مِن بَعدِ طيبِ وَصالِها","بِمُدى مَدى هِجرانِهُم تَتَقَطَّعُ",6,"ع",1,0],["فَحَشوُ نَسيمِها شيحٌ وَرندٌ","وَحُوذانٌ وَرَيحانٌ وَفَغوُ",7,"و",1,0],["فحشاهم أن يسلموا متشَبّثا","من محكمات عهودهم بمثان",8,"ن",1,0],["فَحْشاءَهُ وَالكَذِبَ المَنْدُوسا","وَالشّرَّ ذا النِمِيمَةِ المَقْسُوسا",9,"س",2,0],["فَحشا ابنِ فاطمةٍ بعرصةِ كربلا","بَردت غليلاً وهو كان رُواءها",10,"ا",3,0],["فحشو السمع من در نثير","وملء العين من در نظيم",11,"م",1,0],["فحشانا يحسُّ لذَّة تقبي","لٍ فيدعو للظبي باللذات",12,"ت",1,0],["فُحشُكم عَمَّ كلَّ ارضٍ وقُطرٍ","سِيَّما في شآمِها والعِراقِ",13,"ق",1,0],["فحشى الطرواد بالبث التهب","وأخو الميت أكاماس وثب",14,"ب",1,0],["فحشاه يلتظى لهباً","لَيْسَ يطفى لهف مستعره",15,"ر",2,0],["فحشرجة الصدور جوى تعالت","كمعترك النصال بلا إعتراكِ",16,"ك",1,0]]}