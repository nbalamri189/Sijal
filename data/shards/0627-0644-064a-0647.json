tps://www.aldiwan.net/poem60624.html","الطويل"],[365,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[365,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[365,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[367,"ترى آثارهم إلا أماني","https://www.aldiwan.net/poem17124.html","الوافر"],[392,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[403,"ألية أليه","https://www.aldiwan.net/poem46959.html","منهوك الرجز"],[403,"أضعت العمر في إصلاح حالك","https://www.aldiwan.net/poem47007.html","الوافر"],[404,"يسائلني من باهتدائي يستهدي","https://www.aldiwan.net/poem33949.html","الطويل"],[404,"ما طرق الطرف سوى سهده","https://www.aldiwan.net/poem33971.html","السريع"],[417,"تحلف بالبيت وهي صادقة","https://www.aldiwan.net/poem53820.html","المنسرح"],[417,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[417,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[422,"أدرها لنا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[440,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[442,"أرى بدرا فصار به هلالا","https://www.aldiwan.net/poem14472.html","الوافر"],[444,"جرت في ذلك السهل","https://www.aldiwan.net/poem56029.html","عموديه"],[454,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[459,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[465,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[478,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[501,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[505,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[506,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[516,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[539,"دام بقاؤك لنا","https://www.aldiwan.net/poem47918.html","عموديه"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[559,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"],[563,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"يمينا بطيب شباب الزمان","https://www.aldiwan.net/poem17808.html","المتقارب"]],"verses":[["إِلَيهِ تَمُجُّ النُفوسَ الصُدورُ","وَفيهِ تُهَنّي العُيونَ القُلوبُ",0,"ب",1,0],["إِلى هَوذَةَ الوَهّابِ أَهدَيتُ مِدحَتي","أُرَجّي نَوالاً فاضِلاً مِن عَطائِكا",1,"ك",2,0],["إِلى هَدَفٍ فيهِ اِرتِفاعٌ تَرى لَهُ","مِنَ الحُسنِ ظِلّاً فَوقَ خَلقٍ مُكَمَّلِ",2,"ل",1,0],["إِلَيهِ رَجائي أَن يَرُدَّ جَوابَها","فَنَحنُ إِلى نَظمٍ بَديعٍ لَهُ نَظما",3,"م",2,0],["إِلَيهِ كَأَنّي حَوبَةً وَتَخَشُّعاً","أَخو الخَمرِ يَسمو تارَةً ثُمَّ يُصرَعُ",4,"ع",1,0],["إِلَيْهِ مَرْجِعُهَا فِي كُلِّ مُعْضِلَةٍ","فَلَسْتَ عَنْ أَمْرِهَا المَشْهُودِ فِي الغَيْبِ",5,"ب",1,0],["إِلَى هُنَا رَاهِباً صَالِحاً","وَأَدِيباً شَاعِراً مُلْهَمَا",6,"م",2,1],["إِلَى هَؤلاءِ الخَالِصِينَ طَوِيَّةً","لِمِصْرٍ بِنُصْحٍ خَالِصٍ أَتَقَدَّمُ",7,"م",1,0],["إِلى هاجِعٍ في مُسلَهِمّينَ وَقَّعوا","إِلى جَنبِ أَيدي يَعمَلاتٍ سَواهِمِ",8,"م",1,0],["إِلَيهِ تَيَمُّمي وَإِلَيهِ سَيري","عَلى البَرَكاتِ وَالسَفَرِ الرَشيدِ",9,"د",1,0],["إِلَيهِ دَعَت دَواعيهِ إِذا ما","عِمادُ المُلكِ خَرَّت وَالسَماءُ",10,"ا",2,0],["إليه موارد أهل الخَصَاص","ومن عنده الصَّدَرُ المُبْجِلُ",11,"ل",1,0],["أليةٌ لو أتاها الفجرُ ما نسبت","له البريَّةُ في ذيلِ الدُّجى كذِبا",12,"ب",2,0],["إليه يشار أيُّ رئابِ صدعٍ","إذا ما الصدعُ جلَّ عن الرئابِ",13,"ب",1,0],["إليه بعثتها ترمي بشخصي","ولم أكُ قبل ذاك لها بحِلس",14,"س",1,0],["أليةً يا أبا الحسين بآ","لائك إني لغيرُ ماحقها",15,"ق",3,0],["أليَّةً يا كنيَّ الفيلِ صادقةً","لقد تحمَّلتَ ما لا يحملُ الفيلُ",16,"ل",1,0],["إليها يُغيضُ العقلُ ما شابَ صفوه","من الهَذياناتِ الشنيعةِ والهَزلِ",17,"ل",1,0],["إليهم فما بدءُ الوفادةِ غُمَّةٌ","عليهم ولا عودُ الزيادة إملالُ",18,"ل",1,0],["إِلى هاجِسٍ مِن آلِ ظَمياءَ وَالَّتي","أَتى دونَها بابٌ بِصِرّينَ مُقفَلُ",19,"ل",1,0],["إِلَيهِ أَشارَ الناظِرونَ كَأَنَّهُ","هِلالٌ بَدا مِن قُتمَةٍ وَغُيوبِ",20,"ب",1,0],["إليهم في فؤادي بعضُ شكوى","لسانك فيهِ أفصح من لساني",21,"ي",1,0],["إِلَيهِم رَأَت ذاكُم مَعَدٌّ وَغَيرُها","يُحِلُّ اليَتامى وَالصَعيبُ المُعَصَّبُ",22,"ب",1,0],["إِلَيهِ مُلَبَّدينَ وَهُنَّ خوصٌ","لِيَستَلِموا الأَواسِيَ وَالحِجابا",23,"ب",2,0],["إِلى هادِراتٍ صِعابِ الرُؤو","سِ قَساوِرَ لِلقَسوَرِ الأَصيَدِ",24,"د",1,0],["إِلَيهِم تَناهَت ذِروَةُ المَجدِ وَالحَصى","وَقِبصُ الحَصى إِذ حَصَّلَ القِبصَ خابِرُه",25,"ر",2,0],["إِلَيها لِلمَساجِدِ كُلُّ وَجهٍ","وَإِيّاها يُوَجَّهُ كُلُّ قَبرِ",26,"ر",1,0],["إِلَيهِ وَإِن كانَت زَبالَةُ بَينَنا","وَذو حَدَبٍ فيهِ القَراقيرُ تَمزَعُ",27,"ع",1,0],["إِلَيهِم وَهُم في سورِها بِسُيوفِنا","وَعَسّالَةٍ يَخرِقنَهُم كُلَّ مَخرَقِ",28,"ق",1,0],["إِلَيهِم فَأُمّيهِم فَإِنّي وَجَدتُهُم","حِجازاً لِمَن يَخشى اِصطِفاقَ الزَلازِلِ",29,"ل",1,0],["إِلَيهِم تَناهى مَجدُ كُلِّ قَبيلَةٍ","وَصارَ لَهُم مِنّا الذُرى وَالكَواهِلُ",30,"ل",1,0],["إِلَيهِ وَلَو كانَ المُنَهَّتُ دونَهُ","وَمِن عَرضِ أَجبالٍ عَلَيها قَتامِها",31,"م",3,0],["ألِيَّةٌ بالكَرى المَجفُوِّ تُبعِدُه","عنَّا الرَّكائِبُ إرقالاً وإيجافا",32,"ف",2,0],["إِلى هَرِمٍ تَهجيرُها وَوَسيجُها","تَروحُ مِنَ اللَيلِ التَمامِ وَتَغتَدي",33,"د",2,0],["إِلى هَرِمٍ سارَت ثَلاثاً مِنَ اللِوى","فَنِعمَ مَسيرُ الواثِقِ المُتَعَمِّدِ",33,"د",1,0],["أَلِيَّةٌ بِاليَعمَلا","تِ تَرتَمي بِها النَجا",34,"ا",1,0],["إلى هذي الوجوه تشع لطفاً","يشع بمثلها هذا الصعيد",35,"د",1,0],["إِلَيهِم مَتى يَستَمكِنُ النَومُ مِنهُمُ","وَلى مَجلِسٌ لَولا اللُبانَةُ أَوعَرُ",36,"ر",1,0],["إِلَيها بِالأَمانِيِّ الكِبارِ","وَبِالمَجدِ المُؤَثَّلِ وَالفَخارِ",37,"ر",1,1],["إليها يا ابنَ حارثةٍ إليها","ولا يَحزُنْكَ ما صَنَعَ الطُّغاةُ",38,"ه",1,0],["إليهِ يا ابنَ حارثةٍ إليه","فَثَمَّ البغيُ مُمتَدُّ الرُواقِ",39,"ق",1,0],["إلى هِرقْلَ تأنَّى دُونَ سُدَّتِهِ","صِيدُ الملوكِ وتلقاهُ على مَهَلِ",40,"ل",1,0],["إليهِ يا ابنَ عُمَيْرٍ لستَ وَاجِدَهُ","إلا امْرَأً هَمَلاً في معشرٍ هَمَلِ",40,"ل",1,0],["إليهِ إليهِ إنّ بكنَّ ضعفا","وإنّ بهِ لمرحمةً وعطفا",41,"ف",2,0],["إِلَيها فَلَم أَذكُر حَياتي ذَنبَها","وَأَطلَلت حَقِّي إِن أَصابَت لَنادَما",42,"م",2,0],["إِلى هِلالٍ تَجَلَّت عَنهُ لَيلَتُهُ","باريهِ صَوَّرَهُ في خَلقِ إِنسانٍ",43,"ن",1,0],["إِلَيهِ أَلحاظُنا تُثنى أَعِنَّتُها","فَلَو تَرانا إِلَيهِ كَالمَباهيتِ",44,"ت",1,0],["إِلى هِنْدٍ صَبَا قَلْبي","وَهِنْدٌ مِثْلُها يُصْبِي",45,"ب",2,0],["إليها على رغمِهِ فلأخُضْ","غواربَ تيارهِ الثائرِ",46,"ر",1,0],["آلِيّةٌ ليستْ تَغُرّ سِوى القَنا","والمُرْهَفاتِ بمَكْرِها وخِداعِها",47,"ع",3,0],["إِلَيْهَا الجَاهُ مُنْضَمَّا","يَعُدُّ السَّاعَ فَالسَّاعَا",48,"ع",2,0],["إليهي أي دهياء","يردّي مثلها مثلي",49,"ي",1,0],["إليه ، يا ليلتي وما أكبر الأخطا","ر قالت : لا تحتسبها كبارا !",50,"ر",2,0],["إليها ينتهي روحي","ومنها تبتدي ذاتي",51,"ت",2,0],["إليها على رغمه فلأخص","غوارب تيّاره الثائر",52,"ر",1,0],["اليهود استأسدوا فيك فمن","جرّأ الضعف وأشلى الضعفاء",53,"ا",2,0],["إلَيْهِمْ، فأُمّيِهمْ، فإني وَجَدتهُمْ","حِجازاً لمنْ يَخَشَى اصْطفاف الزّلازِلِ",54,"ل",1,0],["إليه تارة ترمي بطرف","وأخرى نحونا قلقا حشاها",55,"ا",3,0],["إلى هَرِمٍ تَهْجِيرُها وَوَسِيجُها","تروحُ من ليلِ التمامِ وتغتدي",56,"د",2,0],["إليه انتهت آمال كل مؤمل","وفي بابه تفريج كل العظائم",57,"م",1,0],["إليْها، ولي فيها مَعانٍ عَشِقْتُها","كعِشْقِي لِمَنْ كانتْ عُيوني ومَسْمَعي",58,"ع",2,0],["إليهم منهمُ ولهم عليهم","فما لي من سواهم من طِلابِ",59,"ب",1,0],["إليه أمت وفودُ الركبِ سائرةً","والمدحُ فيه غدا ضرباً من المثلِ",60,"ل",1,0],["أليّة تقضي على نفسها","بصحة العقد وطيب النجار",61,"ر",1,0],["إِلَيهِ انتَهَت أَسرارُنا وَغُيوبُنا","هَفَت نَحوَهُ أَرواحُنا وَقُلوبُنا",62,"ن",2,0],["إليه فخذ إِذا حاولت عزاً","فتالدُه لديه والطريفُ",63,"ف",1,0],["أَلِيَّةً بِاليَعمُلاتِ يَرتَمي","بِها النجاءُ بَينَ أَجوازِ الفَلا",64,"ا",1,0],["أَلِيَّةً ما يَخافُ الحنثَ مُقسِمُها","بِالصَفوَةِ المُجتَبى مِن ضِئضِئِ الياسِ",65,"س",1,0],["إِلى هَجَرٍ ساقا المَطايا بِهجرَةٍ","وَغَير اِختيارٍ مِنهُمُ اِهتَجَراها",66,"ا",3,0],["إليه أقبلت الآمال أجمعُها","تصدى فما غيره في الناس مأمولُ",67,"ل",1,0],["اليه حديث الجود يعزى لأنه","رواه عطا في النقل عنه مسلسلا",68,"ل",2,0],["اليه تسند اخبار النوال وقد","صح الذي قد روت تلك الاسانيد",69,"د",1,0],["اليه يسند مرفوعا حديث عطا","يروي لنا بشره عن نافع خبره",70,"ر",2,0],["إليها سرى نور بقلبي منارهُ","فثارت بقلبي حين أصحر نيران",71,"ن",1,0],["إليها كان حجّى واعتمار","وفيها كان ختلى واختلابي",72,"ب",2,0],["أليَّةَ من لاَقى الحِمامَ بمثله","ومارسَ منه الدهرُ أَمْضَى من الدهر",73,"ر",1,0],["إليه الكلام الطيب الصدق صاعدٌ","وأعمال كل الخلق تُحصى وترفع",74,"ع",1,0],["إِلَيهِ إِن جارَتِ اللَيالي","نَأوي وَفي ظِلِّهِ نَقيلُ",75,"ل",1,0],["أَلِيَّةً أَنَّ جُفوني لَم تَنَم","إِلّا اِنتِظاراً لِلخَيالِ الزائِرِ",76,"ر",1,0],["إليها حدَّقت حدقٌ تلظَّت","بتَوهيجِ اللجَينِ أو النضار",77,"ر",1,0],["إليها اجتَزتُ سُوقاً بعد سوقٍ","وقلبي فيهِ من حرِّ الوقيد",78,"د",1,0],["إليهِ تناهى الضّرسُ من كلِّ مَعشرٍ","فكان بتأثيلِ الكتائبِ أخبرا",79,"ر",2,0],["اليه به سبحانه أَتَوَسَل","وَأَرجو الَّذي يُرجى لديه واسأل",80,"ل",1,1],["إلَيْهِ أشارَ ابْنُ الحُسَيْنِ بِقَوْلِهِ","عَليمٌ بأَسْرَارِ الدِّياناتِ واللُّغَا",81,"غ",2,0],["إلَيْهِ انتَمَى فَضْلُ الأئِمَّة وانتَهى","مَساعِيَ لِلدُّنْيا تُقَدَّمُ لِلأخْرى",82,"ر",2,0],["إِلى هَضْبَةٍ شَمّاءَ عَزَّتْ عَلَى الذُّرى","وَفِي جُنَّةٍ حَصْداءَ جَلَّتْ عَنِ السَّرْدِ",83,"د",1,0],["إليه صلاتي قد بعثتُ مشفعا","سلاماً به الإحسان ينساقُ والحسنُ",84,"ن",1,0],["أَليَّةً إِن نَأَت عَنّي نَوائِبُهُ","لأَشدُوَنَّ بِأَهزاجي وَبِالرَّمَلِ",85,"ل",1,0],["إِلَيهِ المَمالِكُ مُشتاقَةٌ","تَمُدُّ يَدَ المُرتَجي الآمِلِ",86,"ل",1,0],["إِلَيهِ تَسعى العُفاةُ سائِرَةً","بِحُسنِ ظَنٍّ في البَرِّ وَالبَحرِ",87,"ر",1,0],["إِلَيهِ تُنَصُّ العيسُ مِن كُلِّ مَوطِنٍ","فَمِن طالِبٍ عِلماً لَدَيهِ وَمُستَجدي",88,"د",2,0],["إِليَّةً بالرَبِّ","ما نثرُ هَذا الحَبِّ",89,"ب",1,0],["أَليَّةً باِنعطافِ القامةِ النَضِرَة","وَنَظرَةٍ لاِختطاف العَقلِ مُنتظِرَه",90,"ر",2,1],["إليه فتاةُ الشعرِ أَلقتْ قيادَها","ولم تتَّخذْ إلاّ روائَعه خِدْرا",91,"ر",2,0],["إليه مآبي وهو سؤلي وملجئي","ولي أمل في عطفه غير خائب",92,"ب",1,0],["إِليهِ تَعالى يَرجعُ الأمر كلّهُ","كَما إنّه بَدا منه كلّ موجودِ",93,"د",1,0],["إِلَيهِ أَتوبُ مِن ذَنبي وَجَهلي","وَإِسرافي وَخَلعي لِلعنانِ",94,"ن",1,0],["إِلَيهِ أَميرُ المُؤمِنينَ بِفَضلِهِ","وَإِنعامُهُ ما اِفتَرَّ يولي بِإِحسانِ",95,"ن",1,0],["إِلَيها أُصَلّي قانِتاً لِمُفيضِها","بِأَسمائِها الحُسنى التَثَبُّتِ",96,"ت",1,0],["إليه انْتَمى كُلُّ المَحاسنِ مُذْ بَدا","فحُقَّ لعَمري بالمحاسنِ أن يُكْنى",97,"ن",2,0],["إليهِ انْتِسابُ الفضْلِ مثْلُ انتسابِه","إلى الفَضْلِ صِدْقٌ فهْو غيرُ ظَنين",98,"ن",1,0],["إليه انتمتْ فينا الفضائلُ كُلُّها","فدَعْوَى سِواهُ للفضائلِ زُور",99,"ر",1,0],["إليه للخَلْقِ المَفَر","تَجْري يَداهُ بالبِدَر",100,"ر",1,0],["إِلَيها عُدتُ ذا دَمعٍ شُجاعٍ","أَعودُ بِهِ عَلى صَبرٍ جَبانِ",101,"ن",1,0],["إليه في كل الأمور ترجع","شاكر وصابر للقضا والأقدار",102,"ر",1,0],["أَليَّةٌ أليَّهْ","بِباريءِ البريَّهْ",103,"ه",1,1],["إليها في شبابِك مِلْت جَهْلاً","فَهَلاّ مِلْتَ عَنها في اكْتهالِكْ",104,"ك",1,0],["إلى هَدْيِ خير المرسلين محمد","عليه صلاة اللّه تَتْرَى بلا عدِّ",105,"د",1,0],["إليه ينهى أمر أهل الهوى","في مبدأ الحب وفي عوده",106,"د",2,0],["أليَّةً ما وراءها قَسَمٌ","لمقسمٍ فيه صادقٍ بَرِّ",107,"ر",1,0],["ألِيَّةَ مغرمٍ يبدي سُلُوًّا","وفي أحشائه الوجد الكمين",108,"ن",1,0],["إليها برأفته لفته","بسد المياه وطغيانها",109,"ن",3,0],["إليها جميع الكائنات مشوقةٌ","تزيد افتقاراً وهي عنهن ما أغنا",110,"ن",2,0],["إليها حَدَتني حادِثاتٌ كأَنَّها","بَوارِحُ يَحدُوهُنَّ بَرحٌ وأبرَاحُ",111,"ح",1,0],["ألية صادق بسرى المطايا","وقد طلحت ومنها الدمع سالا",112,"ل",2,0],["إليها جل اشواقي","وفيها منتهى سؤلي",113,"ل",2,0],["اليه تطلعُ الاقوام شتى","كأن الفخرَ من حظَ المدين",114,"ن",1,0],["إليه صرفت عن ذا الناس نفسي","كما اعتزلت تألُّفَها القناعهْ",115,"ع",2,0],["أليَّة ما فتح العطَّارُ عن","أعبقَ منه نَفَساً وأطيبا",116,"ب",2,0],["إليه فنعم مأوى الركب وافي","بهم وخد المطايا والذميل",117,"ل",1,0],["اليهمْ ففكري صيقلُ الشِّعرِ مثلما","يروقكَ متنُ المَشرَفيِّ بصقلِهِ",118,"ل",2,0],["أَلِيَّةً ما غِبْتَ عن نَواظِري","وبَرَّ في دِينِ الهَوى يَمينِي",119,"ن",2,0],["اليه رجوع الشمس بالطوع لازم","فمن غيره في الشرع والعرف مرجع",120,"ع",1,0],["إليها مردّ كل عقلٍ تبلّهَ","وكلّ فؤادٍ حسّهُ قد تبلّدا",121,"د",2,0],["إلى هنا أنهي حديثي وأنتهي","وما شئت في حقي من الخير فاصنع",122,"ع",1,0],["إليهِ قد أحسَنتُمُ","أبقاكَ رَبِّي مُحسِنا",123,"ن",2,0],["إليها صلاة القوم أين توجهوا","وقبلتهم وجه لها يتلامع",124,"ع",1,0],["إليه تحياتي على البعد لم تزل","تصافح محراباً لديه ومسجدا",125,"د",2,0],["إلى هذا المجاز حباه ربي","بأنواع الفتوح بلا سدود",126,"د",1,0],["إليهِ كلَّما شئنا سبيلٌ","وليسَ إلى مَعارِجهِ سبيلُ",127,"ل",1,0],["إليه حين أحدثوا ما أحدثوا","وإن شمعون على ما حدثوا",128,"ث",3,0],["إليهم في رجل ذي دين","ورع وعفة أمين",128,"ن",1,0],["إليهم فيه ولو سماه","لكفر العاصي إذا عصاه",128,"ه",1,0],["إليه في حكم من الأحكام","ولم يكن في حالة الإمام",128,"م",1,0],["إليه أو يوجب في الإمارة","حقا لأن حالة الوزارة",128,"ه",1,0],["إليه من إقطاعه في الحيف","مع رده أيضا أباه المنفي",128,"ي",1,0],["إليه أيضا وهي عن أخيه","وكان في الحق بلا تشبيه",128,"ه",1,0],["إليه قالوا عهده ثم فرغ","من كل ما أوصى إليه غذ بلغ",128,"غ",1,0],["أَليّة بَرٍّ قَشيبِ العُلى","رَحيبِ الفناءِ خَصيبِ المَجَانِي",129,"ن",2,0]]}