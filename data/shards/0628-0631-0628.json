",""],[5957,"ودادي الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=29971",""],[5969,"رَبيعُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198726",""],[6152,"سيدة القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=203012",""],[6152,"أذوي احتراقا","https://www.poetsgate.com/ViewPoem.aspx?id=203688",""],[6152,"الصبح عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203737",""],[243,"المساء الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68160&r=&rc=152",""],[402,"ما كان ريب قبل ريب الحمام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54039&r=&rc=891",""]],"verses":[["بِرَبِّكَ هَل رَجَعتَ إِلى رَسيسٍ","مِنَ الذِكرى وَهَل رَجَعَ الغَرامُ",0,"م",1,0],["بِرَبِّكَ ماذا صَدَّنا وَلَوى بِنا","عَنِ القَصدِ إِن كانَ السَبيلُ مُمَهَّدا",1,"د",2,0],["بِرَبِّ المَطايا السَابِحاتِ وَما بَنَت","قُرَيشٌ وَأَهدَت غَافِقٌ وَتُجِيبُ",2,"ب",1,0],["بَرَّ بِكِ جَمِيعاً فَمَا","أَجْدَى وَلَكِنْ رُبَّ دَاءٍ عُقَامْ",3,"م",1,0],["بَرَّ بِي رَأْفَةً بِسنَّي فَصَانَتْ","هَبَّةُ الشِّبْلِ هَيْبَةً الرِّئْبَالِ",4,"ل",1,0],["بربيب لبنان بريحانِّيه","بكبير معشره بفخر قبيله",5,"ل",2,0],["بِرَبِّكِ أَيَّتُها الأَنجُمُ","مَتى تَضَعِ الحَربُ أَوزارَها",6,"ه",2,0],["بِرَبِّكَ قُل لَنا وَخَلاكَ ذَمٌّ","أَعيسى كانَ يَذَّخِرُ العَتادا",7,"د",2,0],["بِرَبِّكَ سِر حَيثُ الخَليُ فَإِنَّني","فَتىً لا أَرى غَيرَ المَصائِبِ في دَهري",8,"ر",2,0],["بِرَبِّكَ أَيُّها العامُ الجَديدُ","أَفيكَ مِنَ الأَماني ما نُريدُ",9,"د",1,1],["بِرَبِّ اِبنَةِ العَمرِيِّ ما كانَ جارُها","لِيُسلِمُها ما وافَقَ القائِمُ اليَدا",10,"د",2,0],["بربك لا تمسس بايديك قرحتي","فانك ان ماسستها اتألم",11,"م",1,0],["بربك عدلي او على الموت دلني","فاني الى كأس شربت بها صاد",12,"د",1,0],["بربك أنبئني أإنك صادقي","قد ازدرت أم أنت الخيال الممثل",13,"ل",1,0],["بِرَبعٍ لَو تَرى الأَحبابَ فيهِ","رَأَيتَ لَهُم مُباعَدَةً وَصَرما",14,"م",2,0],["بربكِ أيها الأنوارُ ماذا","صنعتِ بساهرٍ ألِفَ الظلاما",15,"م",2,0],["بربك أيها الأمواجُ ظلَّت","على الشطئانِ ترتطمُ ارتطاما",15,"م",2,0],["بربكَ أينَ أحلامٌ غَوالٍ","وعمرٌ قد قطعناهُ نياما",15,"م",2,0],["بِرٌّ بَدَأتَ بِهِ وَدارٌ بابُها","لِلخَلقَ مَفتوحٌ وَوَجهُكَ مُقفَلُ",16,"ل",1,0],["بِرَبِّكَ هَل أَتاكَ لَها رَسولٌ","فَشاقَكَ أَم لَقيتَ لَها خَدينا",17,"ن",2,0],["بِرَبِّكَ هَل ضَمَمتَ إِلَيكَ لَيلى","قُبَيلَ الصُبحِ أَو قَبَّلتَ فاها",18,"ا",3,1],["بِرَبِّكَ أَخبِرني أَلَم تَأثَمِ الَّتي","أَضَرَّ بِجِسمي مِن زَمانٍ خَيالُها",19,"ل",3,0],["بِربِّكَ خُذهم بالزّواجرِ وارْمِهِمْ","بما سدّد الدّاعي إلى اللهِ إذ رمى",20,"م",2,0],["بِرَبِّكَ ما الَّذي تُبدي وَتُخفي","وَهَل لِلأَمرِ عِندَكَ مِن نِهايَهْ",21,"ا",3,0],["بِرَبِّكَ هَل يَدومُ أَسىً وَوَجدٌ","لِمُلكٍ لَم يَدُم إِلّا قَليلا",22,"ل",2,0],["بِرَبِّكَ ماذا أَصابَ البِلادا","فَما تَنظُرُ العَينُ إِلّا حِدادا",23,"د",2,1],["بِرَبِّكَ هَل يَريدُ ذَووكَ خَيراً","بِشَعبٍ عاثِرِ الآمالِ عانِ",24,"ن",1,0],["بِرَبِّكَ يا مُحَمَّدُ لا تَدَعْنِي","فَرِيْسَةَ كُلِّ جَبَّارٍ رَهيبِ",25,"ب",1,0],["بِرَبِّ الهَدايا الواجِباتِ جُنُوبُها","تَضَمَّنَها لِلّهِ في الحَجِّ مَوقِفُ",26,"ف",1,0],["بِرَبِّ زَمزَمَ وَالحَو","ضِ وَالصَفا وَالمُحَصَّب",27,"ب",1,0],["بِرَبِّكَ خَمراً أَم نَقيعاً سَقَيتَني","فَقالَ مِنَ التَكريهِ ماءً مُزَعفَرا",28,"ر",2,0],["بِرَبَّةِ طَوقٍ ما أَقَلَّ جَناحُها","جَناحاً وَفي خُضرِ الغُصونِ جُنوحُها",29,"ح",3,0],["بِرَبِّكَ يا فتى غَطفَانَ آمِنْ","فإنّ لهُ لآياتٍ جَلِيَّهْ",30,"ي",2,0],["بربك قلبي أنت لا نترك الهوى","سواءٌ سلا يا قلب غيرك أم هاما",31,"م",2,0],["بربك كم وصلت حياة قوم","وكم حاربت من داء وبيل",32,"ل",1,0],["بربِّك من ألَّفَ الأصغرين","وعلَّقَ بالناظر الناظرا",33,"ر",2,0],["بِرَبِّكِ هَلْ وَجَدْتِ كَمَا وَجَدْنَا","خِلافاً بَيْنَ أَحْمَدَ وَالْمَسِيحِ",34,"ح",1,0],["بُرَبِّي بَنِيهِ بِالحَصَافَةِ وَالهُدَى","وَتسْعِدُه أَوفَى وَأَكْفَى العَقَائِلِ",35,"ل",1,0],["بِرَبِّكُمُو مَا رَوْضُكُمْ وَثِمَارُهُ","إِذَا الرَّوْضُ لِمْ يُمْطِرْ وَلَمْ يُتَعَهَّدِ",36,"د",1,0],["بِرَبِّكَ إِنْ تَمْرَرْ بِجَانِبِ مَنْزِلٍ","مُفَدِّيكِ فِيهِ عِجْ بِهِ وَتَلَطَّفِ",37,"ف",1,0],["بَرَبَرَتْ تِلْكَ الضوَارِي دُونَهُمْ","ثُمَّ شَدَّتْ وَهْيَ لا ترْحَمُ شَفرَا",38,"ر",2,0],["بربّ الأرزِ حدثني","أحقّا قولهُم حقا",39,"ق",2,0],["بربِّك، عظْ جبابرةً إذا ما","تراءى الواعظون لهم أشاحُوا",40,"ح",3,0],["بِرَبِّك: هل حانَ ميعادُها؟","قد اسْتَبْطَأَ العُرْبُ ميعَادها",41,"د",3,0],["بربك، كم شربتِ كئوسَ راح","مُشَعْشَعَة، وأخرى من جحيم؟",42,"م",1,0],["بربك: كيف سرت على طريق","عقيمٍ؛ لم يعبِّده السِّفَار؟",43,"ر",1,0],["بربِّكِ، يا أبولُّو، حدِّثينا:","أما في رُقْعة القمر اخضرار؟",43,"ر",1,0],["بِرَبِّك: هل فَقَدتْ أهلَهَا","فزادتْ على الأهل أحْزَانُها؟",44,"ن",3,0],["بَرَّ بالعهد رجالٌ أُنُفٌ","أخذ الشعبُ عليهم مَوْثقا",45,"ق",2,0],["بربِّكَ قُل يا دَليل","إلى أين تُفضي الطريق",46,"ق",1,0],["بربك هل ترى في السكبِ عارا","وكيف وفى التكسب طيب نفسي",47,"ي",1,1],["بربك أروِ الروح فهي صدّية","لنعرف هذا اليومَ ما كان في أمسِ",48,"س",1,0],["بربك يا زَيدانُ هل كنت تَعلمُ","بأن أديم الأرض يصبغهُ الدمُ",49,"م",1,1],["بَرٍّ بَرى طولُ الطَوى جُثمانَهُ","فَهوَ كَقَدحِ النَبعِ مَحنِيُّ القَرا",50,"ا",1,0],["بربّك ذَكّرهم عَسى تنفعُ الذِكرى","فَكَم نِعم أَجدى وكَم مِنَن أَجرى",51,"ر",2,1],["بربّهِ مِن كلِّ سوءٍ عُصما","محمّدُ الشريفُ والشفيعُ",52,"ع",1,0],["بربّك أطلقها لحونا مثيرة","تحرك في القلب الشعور وتذكيه",53,"ي",2,0],["بربكَ ماذا فعلتَ بنا","وما لكَ عندي ذوي الحبِّ ثارْ",54,"ر",1,0],["بربّكِ يا نفسي وربُّكِ شاهدٌ","أتهنئةٌ كانَ الهوى أم تعازيا",55,"ي",2,0],["بربكَ هل بالدجى لوعةٌ","فإن غابَ عنهُ سناكَ اعتكرْ",56,"ر",1,0],["بربك هل أبقيت للناس نتفةً","من الفضل أم آثرت نفسك بالحسن",57,"ن",1,1],["برباه روض المجد ليس مصوحا","لمن اغتدى للمكرمات يرود",58,"د",1,0],["بِرَبيع الأَدنى بِثاني عَشرَة","وَيُوافِقُ العِشرينَ مِن نيسانِ",59,"ن",1,0],["بِرَبِّكَ اِبتِهاجاً في اللِقاءِ تَظُنُّهُ","وِداداً وَفِعلُ الغَدرِ في قَلبِهِ ثاوي",60,"ا",3,0],["بربط مولىً تعالى خصّه بهما","من اسمه باسمه في الذكر مرتبط",61,"ط",1,0],["بَرُّ بِرٍّ وبحرُ درٍّ فهذا","للعطايا وذا لحسن النظام",62,"م",1,0],["برّ بمن والى عدوّ للعدا","في اللَه شيمته يحب وَيبغض",63,"ض",1,0],["برَبِّكَ إِن يمَّمتَ يا صاحبي نَجدا","فَقِف شارِحاً عنّي الصَبابةَ والوَجدا",64,"د",2,1],["بربك لا تنكأ بقرحِ النوى غدا","من الق