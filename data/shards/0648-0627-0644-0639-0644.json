spx?id=187391",""],[5216,"تحية للدكتور محمد البدري","https://www.poetsgate.com/ViewPoem.aspx?id=187620",""],[5280,"سيدنا محمد رسول الله ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=189571",""],[592,"يا عين فابكي على الإخوان لو بدم","https://www.poetsgate.com/ViewPoem.aspx?id=128812",""],[5523,"إليك أشكو لسانا شابه الثقلُ","https://www.poetsgate.com/ViewPoem.aspx?id=202840",""],[5573,"من كل شنة نطفه","https://www.poetsgate.com/ViewPoem.aspx?id=200170",""],[5606,"التباهي بالوقاحه","https://www.poetsgate.com/ViewPoem.aspx?id=196572",""],[5717,"هوت الجباه على جمالك سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=170582",""],[5720,"تعليمُنا","https://www.poetsgate.com/ViewPoem.aspx?id=200439",""],[5780,"المرء بالأعمال","https://www.poetsgate.com/ViewPoem.aspx?id=187625",""],[5804,"اغتنم الخير قبل أن ترحل","https://www.poetsgate.com/ViewPoem.aspx?id=214738",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5943,"العمرُ يقصرُ كلما مرَّت على","https://www.poetsgate.com/ViewPoem.aspx?id=35256",""],[5943,"فألٌ تفجَّرَ","https://www.poetsgate.com/ViewPoem.aspx?id=35872",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6093,"لولا المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=191822",""],[2575,"مرحى فقد وضح الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=1364",""],[6115,"الذياب استنعجت والنعاج استذيبت!","https://www.poetsgate.com/ViewPoem.aspx?id=196470",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6277,"العبودية الكبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64441&r=&rc=0",""]],"verses":[["وَالعُلى ما لَم يَرُبّوا دارَها","طُرُقٌ عوجٌ وَأَطلالٌ خَوالي",0,"ل",2,0],["وَالعُلا إِرْثي وَلَسْتُ أَرَى","حاجِزاً عَنْها سِوى العَدَمِ",1,"م",1,0],["والعِلْمُ عِلْمُ اللهِ جلّ جَلالُهُ","والعَبْدُ إدْراكُ القُصورِ قُصارُهُ",2,"ر",2,0],["وَالعِلمُ في حَسرَةٍ وَالعَقلُ في أَسَفٍ","وَالدينُ في خَجَلٍ مِمّا تَوَلّانا",3,"ن",2,0],["وَالعِلمُ إِن لَم تَكتَنِفهُ شَمائِلٌ","تُعليهِ كانَ مَطِيَّةَ الإِخفاقِ",4,"ق",1,0],["والعِلم أوهن من ان يُستظَلَّ به","إن لم تقم",5,"م",1,0],["والعلم أضَيع من بذر بمُسبخة","إن لم تُجَلِّله من نَوْء الطبى دِيَم",6,"م",1,0],["والعلم أعلى رتبةً عندهم","من أن تلقّاه وأن تعلمه",7,"م",2,0],["والعلم ليس بنافع إلاّ إذا","أجرت به الأعمال خَيْل رهانها",8,"ن",3,0],["والعلم قد أنكر منهاجنا","ولم يُبِنْ أين هو المهيَع",9,"ع",1,0],["وَالعِلمُ عِلمانِ مَطبوعٌ وَمُكتَسَبُ","وَالبَحرُ بِحرانِ مَركوبٌ وَمَرهوبُ",10,"ب",1,0],["والعلاء بنُ صاعدٍ قبلَ هذا","قد حمى دون رائدي الأَحْماءَ",11,"ا",2,0],["والعلمُ مُقْتَسَمٌ فعندَ سواكُمُ","أقْيَاضُهُ ولديكُم أَمحاحُه",12,"ح",2,0],["والعُلا وَفقٌ لأخلاقكُمُ","لا لأخلاقهمُ المؤتَفنه",13,"ن",2,0],["والعلم افضل لو زيدت وسائله","مما هنالك من مال ومن نشب",14,"ب",1,0],["والعلم مغلوب فلا","يعلى بهِ والجهل غالب",15,"ب",1,0],["والعلم ليس بكامل في حسنه","حتى يصيب من البيان محسِّنا",16,"ن",2,0],["وَالعِلمُ في فَضلِهِ أَو في مَفاخِرِهِ","رُكنُ المَمالِكِ صَدرُ الدَولَةِ الحالي",17,"ل",2,0],["وَالعِلمُ أَشبَهُ بِالسَماءِ رِجالُهُ","خُلِطَت جَهاماً في السَحابِ وَمُمطِرا",18,"ر",2,0],["وَالعِلمُ بَدرِيٌّ أُحِل","لَ لِأَهلِهِ ما يَصنَعون",19,"ن",1,0],["وَالعِلمُ في شَرقِ البِلادِ وَغَربِها","ما حَجَّ طالِبُهُ سِوى ناديكِ",20,"ك",1,0],["وَالعِلمُ مِن آياتِهِ الكُبرى إِذا","رَجَعَت إِلى آياتِهِ الأَقوامُ",21,"م",1,0],["وَالعِلمُ بَنّاءُ المآ","ثِرِ وَالمَمالِكِ مِن قَديمِ",22,"م",1,0],["والعلمُ نقشٌ في فؤادِكَ راسخٌ","والمالُ ظِلٌّ عن فِنائِكَ ذاهبُ",23,"ب",1,0],["وَالعُلا سُلَّمٌ مَراقيهِ خَطّا","بُ أَبي عامِرٍ إِلى مَسعودِه",24,"د",2,0],["وَالعُلا ما شادَ آبا","ؤُكَ قِدماً وَجُدودُك",25,"ك",1,0],["وَالعُلا مِن فَعالِهِ في اِجتِماعٍ","وَاللُهى مِن يَدَيهِ في تَبديدِ",26,"د",1,0],["وَالعِلمُ ثالِثُها وَالحِلمُ رابِعَها","وَالجودُ خامِسُها وَالفَصلُ ساديها",27,"ي",3,0],["وَالعِلمُ حَيثُ يَصِحُّ عالِمُهُ","وَالحِلمُ حَيثُ يَعِفُّ حالِمُهُ",28,"م",2,0],["وَالعِلمُ في شُهُبِ الأَرماحِ لامِعَةً","بَينَ الخَميسَينِ لا في السَبعَةِ الشُهُبِ",29,"ب",1,0],["والعلمُ مهما صادفَ التقوى يكنْ","كالريحِ إذْ مرَّتْ على الأزهارِ",30,"ر",1,0],["والعلمُ يحسبُ منْ رزقِ الفتى ولهُ","بكلِّ متَّسعٍ في الفضلِ تضييقُ",31,"ق",1,0],["والعلمُ إن ضلَّ السَّبيلَ ولم يلد","ما يُرشِدُ الجهلاءَ كان عقيما",32,"م",2,0],["وَالعَلَوِيُّ قائِدُ الفُسّاقِ","وَبائِعُ الأَحرارِ في الأَسواقِ",33,"ق",1,0],["وَالعِلمُ يُدرِكُ أَنَّ المَرءَ مُختَلَسٌ","مِنَ الحَياةِ وَلَكِن يَغلِبُ الطَمَعُ",34,"ع",1,0],["وَالعُلوِيُّ البِصرِيُّ كانَ بِهِم","أَعرَفَ مِنهُم وَاللُبُّ يَشهَدُ لَه",35,"ل",2,0],["وَالعِلْمُ ما وَعَتِ الصُّدُو","رُ ولَيْسَ مَا في الكُتبِ يَخْلدْ",36,"د",1,0],["وَالعلم في هَذا الجِها","د هُوَ السلاح لمن يحارب",37,"ب",1,0],["وَالعلمِ إن العلم بر","ء للنفوس من السقام",38,"م",1,0],["والعِلَلُ التي تجوزُ أَجمعُ","وليْسَ في الحَشوِ لهنَّ مَوضعُ",39,"ع",1,0],["والعِللُ المسميّاتُ اللاتِي","تُعرفُ بالفُصولِ والغاياتِ",39,"ت",1,0],["وَالعِلمُ مَرْفُوعُ الذُّرَى","وَالفَنُّ مَعْمُورُ الرِّحَابِ",40,"ب",1,0],["وَالعِلْمُ يُؤْتَى النُّهَى جَنَاهُ","مِنْ كُلِّ حُلْوٍ وَكُلِّ حَالِي",41,"ل",2,0],["وَالعَلاَجُ الأَكْفَى إِذ الجُرْحُ أَشْفى","فِي اعْتِصَامِ المَخْلُوقِ بِالخَلاَّقِ",42,"ق",1,0],["والْعِلْمُ مِصْباحُ الْحَياةِ فَنَقِّبُوا","مِنْ قَبْلِ أَنْ تَثِبُوا عَنِ الْمِصْباحِ",43,"ح",1,0],["والْعِلْمُ مِيزانُ الْحَياةِ فإِنْ هَوَى","هَوَتِ الْحَياةُ لأَسْفلِ الأدْرَاك",44,"ك",1,0],["والعلم مختلف الضحايا؛ كم طوى","من سابح، وقَضى على طيَّار",45,"ر",1,0],["والعلم زادٌ ليس منه قناعةٌ","بل فيه تُحمدُ كثرةُ الأطماع",46,"ع",1,0],["والعلم روحٌ من الرحمن مُقتبسٌ","ونورهُ من ضياء الله مكتسبُ",47,"ب",1,0],["والعلم بالله والاخلاص عارفة","من الكريم وتخصيص واحسان",48,"ن",1,0],["والعلم أشرف ما أوليت من خطر","ما حل في موضع لله فاتضعا",49,"ع",2,0],["والعلم بحر محيط لست محصيه","فكن بأنفعه في الدين مقتنعا",49,"ع",2,0],["والعلم بالله أولى ما عنيت به","وما سواه الى ادراكه نزعا",49,"ع",2,0],["وَالعِلْمُ ثالِثُها وَالحِلْمُ رابِعُها","والجود خامِسُها والفضل سادِيها",50,"ي",3,0],["والعلم ثالثها والحلم رابعها","والجود خامسها والفضل سادسها",51,"ه",2,0],["والعلم إن ملك القلوب فسمّه","وحشيّة وادع الحضارة غيلا",52,"ل",2,0],["والعلم إن ملك القلوب فسمّها","صخرا تنوء بعبئه محمولا",52,"ل",2,0],["والعلم ويل العلم يوم حسابه","إن كان عن نزواتها مسؤولا",52,"ل",2,0],["والعلم علمان منبوذ ومكتسب","والبحر بحران مركوب ومرهوب",53,"ب",1,0],["والعلمُ مُقْتَسَمٌ فعندَ سواكُمُ","أفْيَاضُهُ ولديكُم أَمحاحُه",54,"ح",2,0],["والعلم والعلماءُ في طي الخمو","ل واهل رفراف العلى والجهال",55,"ل",1,0],["والعلم المشهور بال","قول الصحيح الأجمل",56,"ل",1,0],["والعلم والحلم دائمان متفقا","والعدل والبذل فيه الكل يتفق",57,"ق",1,0],["والعلج ما انتصبت له","في كل مومات ثنية",58,"ي",2,0],["والعلم كالجهل إني قد شططت وقد","نسيت أَن في فمي من راتبي ماء",59,"ا",2,0],["والعِلْم أثبتُ للفتيانِ مَنفعةً","قد كان تعليمُهم كالنقش في الحجرِ",60,"ر",1,0],["والعِلمَ والحِلمَ والتَّقوَى المُنِيرَ سَناً","والمَجدَ والجُودَ والآدَابَ والشَّرَفَا",61,"ف",2,0],["والعِلمُ في أولِيَاءِ الشَّرعِ مُشتَرَطٌ","والجَاهِلُ الغُمرُ شَرعاً غَيرُ مُعتَبَرِ",62,"ر",1,0],["وَالعِلمِ وَالحِلمِ وَالنَفسِ الَّتي بَعُدَت","عَنِ الدَنيّاتِ وَالصَدرِ الَّذي رَحُبا",63,"ب",2,0],["وَالعلوُ والفوق أيضاً والنزول أتى","وَالضحكُ مع غضَبٍ ويلٌ لمغضبهِ",64,"ب",2,0],["والعلم نبراس على","أضوائه تجنى الفوائد",65,"د",1,0],["والعلمُ زينةُ اهلهِ بين الورى","سيانَ فيه أخو الغنى والمعدمُ",66,"م",1,0],["وَالعِلمُ في الحُكّامِ عِن","دِ الجاهِلينَ أَجلُّ جرمِ",67,"م",1,0],["وَآلَ عَلى العُشّاقِ مُشرِفُ صَدغِهِ","يالَيتَه يَوماً بِكَفّي يَقبِضُ",68,"ض",1,0],["وَالعَلاءُ الصَريحُ وَالسودَدُ المَح","ضُ وَما كُلُّ سودَدِ الناسِ مَحضُ",69,"ض",1,0],["وَالْعُلاَ أَلْقَتْ عَلَيْهِ مُلىً","نَسَجَتْهَا بِيَمِينِ النَّجاحْ",70,"ح",1,0],["وَالْعِلْمُ مِمَّا قَدْ عَرَا","فِيمَا أَقَامَ جَوىً وَأَقْعَدْ",71,"د",1,0],["وَالْعِلْمَ مَاجَ عُبَابُهُ","يُرْوِي وَيُشْبِعُ مَنْ تَوَرَّدْ",71,"د",1,0],["وَالْعِلْمَ ذَا التَّحْقيقِ وَالْ","نُّصْحَ الْعَمِيمَ لِكُلِّ مُهَتَّدْ",71,"د",1,0],["والعلم والحلم في حكم وفي حكطم","فما ابن قيس وما المولى الجناني",72,"ي",1,0],["والعلم لا تخلق أثوابه","ما لبست لكنها تقشب",73,"ب",1,0],["والعلجُ يُفسدُ أو يُفرِّقُ بينَهم","ويقُولُ لي فضلُ المُعينِ الرافد",74,"د",1,0],["وَالعِلْمَ تَخَيّر مُستَبقاً","لِمَدَى خَيْرٍ يَتَزَيّدُهُ",75,"د",2,0],["والٍ على بلدٍ تغرّب فيه ير","تَقبُ المآبَ فهمّه ما يجمعُ",76,"ع",1,0],["وَالعِلمُ رَوضٌ غُصنُهُ","وَاللَهِ أَنتَ الناضِرُ",77,"ر",1,0],["وَالعُلا تُرقى وَكَيفَ بِها","وَمَراقيها مِنَ الأَسَلِ",78,"ل",1,0],["والعلم يجهله الغبي لأنه","لم يدر قط العلمَ والعلماء",79,"ا",2,0],["والعلم فرض على المسلم طلبه ومن","سلك طريقا إليه فهو فأنزولن",80,"ن",1,0],["والعلم خذه لك علامه","واعمل وعلم يا غلام",81,"م",1,0],["وَالعِلمُ عِندَ المَلكِ العَلّامِ","يا رب فَاِحفَظني من الأَسقامِ",82,"م",1,0],["وَالعِلمُ غضٌّ عِندَهُم بِطَراوَة ال","وَحي الوَحِيِّ كَأَنَّهُ الهامُ",83,"م",1,0],["والعلم أجمع قد غدوتَ مُبرّزاً","في شوط حلبتِه على الأقرانِ",84,"ن",1,0],["والعلم إن تسأله عن أهله","يجبك لا أعرف إلا هم",85,"م",1,0],["والعلم مقصود به غيره","العمل النافع في الارتحال",86,"ل",1,0],["والعلم قد نكس أعلامه","منكسراً من شوم ما قد لقا",87,"ق",2,0],["والعلامات أراها","بالذي نهواه تترى",88,"ر",2,0],["والعلم أفخر ملبس","فالبس هو الثوب الجديد",89,"د",1,0],["والعلِمُ إنْ كِلفَ الإنسانُ خِدمَتَهُ","فسوف يجعَلُ أحرارَ الورى خَدمَهْ",90,"م",2,1],["والعلماء الماضون ما انتخبوا","من غرر الفضل منتخبه",91,"ب",2,0],["وألٍ على العشَّاق سيرتهُ","بالظُّلم تنسخُ آية العدل",92,"ل",1,0],["وَالعلم قِيمتُهُ وَالحلم شِيمتُه","طابَت أَرومتُه وَالنَفسُ وَالخِيمُ",93,"م",1,0],["وَالعِلْمُ قَدْ أَعْلاكَ عن دَنَسِ الصِّبا","وكَذاك شَيْبُكَ في عُلاكَ عَلاكا",94,"ك",2,0],["والعِلمَ مِنهُصَيَّرا","ما لا يكونُ قد يَكون",95,"ن",1,0],["والعلم عنهم كاشف حيث هم","في عدم لا شيء معناه",96,"ا",2,0],["والعلم كالجهل عندي","فيه وزال التعني",97,"ن",2,0],["والعلم بالجهل قد تساوى","عجزهما عنه في قران",98,"ن",1,0],["والعلم قسمان فمستحضر","