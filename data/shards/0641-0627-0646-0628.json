https://www.aldiwan.net/poem45091.html","الطويل"],[43,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[43,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[43,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[62,"تطهر بماء الحياة الذي","https://www.aldiwan.net/poem52198.html","المتقارب"],[62,"إذا هممت بأمر دونه خطر","https://www.aldiwan.net/poem52311.html","البسيط"],[62,"ولما تراءى السرب قلت لصاحبي","https://www.aldiwan.net/poem52350.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"عليك السلام أيها القمر البدر","https://www.aldiwan.net/poem63569.html","الطويل"],[45,"نطالب بشرا بسقيا المدام","https://www.aldiwan.net/poem66796.html","الخفيف"],[28,"وكوم تنعم الأضياف عينا","https://www.aldiwan.net/poem5381.html","الوافر"],[28,"أنبئت أن العبد أمس ابن زهدم","https://www.aldiwan.net/poem5388.html","الطويل"],[28,"وقائلة لي لم تصبني سهامها","https://www.aldiwan.net/poem5422.html","الطويل"],[28,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[61,"دعوت بالشعر على خده","https://www.aldiwan.net/poem51389.html","السريع"],[61,"صبابة منك لجت في تماديها","https://www.aldiwan.net/poem51400.html","البسيط"],[61,"هواء كالهوى حسنا وظرفا","https://www.aldiwan.net/poem51536.html","الوافر"],[58,"النفس تبكي على الدنيا وقد علمت","https://www.aldiwan.net/poem30805.html","البسيط"],[58,"يمثل ذو العقل في نفسه","https://www.aldiwan.net/poem30916.html","المتقارب"],[58,"تلكم قريش تمناني لتقتلني","https://www.aldiwan.net/poem31070.html","البسيط"],[80,"بني الثغر لستم في الوغى من بني أمي","https://www.aldiwan.net/poem31307.html","الطويل"],[80,"وسابح لاعب في بحره مرحا","https://www.aldiwan.net/poem31370.html","البسيط"],[44,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[69,"لئن كانوا النجوم فأنت شمس","https://www.aldiwan.net/poem28878.html","الوافر"],[31,"رأيت بجنب الخيف هندا فراقني","https://www.aldiwan.net/poem41821.html","الطويل"],[74,"لقد أصخت إلى نجواك من قمر","https://www.aldiwan.net/poem12951.html","البسيط"],[102,"أنا بالرحمن من حو","https://www.aldiwan.net/poem32918.html","مجزوء الرمل"],[21,"حنانيك إن الجن كنت رجاءهم","https://www.aldiwan.net/poem36135.html","الطويل"],[21,"عرفت الدار قد أقوت سنينا","https://www.aldiwan.net/poem36141.html","الوافر"],[40,"تطاول أيامي وليلي أطول","https://www.aldiwan.net/poem42283.html","الطويل"],[17,"إذا المرء لم يدنس من اللؤم عرضه","https://www.aldiwan.net/poem1201.html",""],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[48,"إلى الله أشكو حب من جل نيله","https://www.aldiwan.net/poem63319.html","الطويل"],[46,"عبيط ضوائن نحير جزر","https://www.aldiwan.net/poem22680.html","الوافر"],[46,"متى ينفع الأقوام حي يكن له","https://www.aldiwan.net/poem23010.html","الطويل"],[46,"عظيم لعمري أن يلم عظيم","https://www.aldiwan.net/poem23645.html","الطويل"],[68,"قف بالديار وحي الأربع الدرسا","https://www.aldiwan.net/poem1503.html",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16680","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30441","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20984","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42693","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54662","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54329","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54213","الخفيف"],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[58,"النفسُ تبكي على الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=10041",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[45,"عَلَيكَ السَلامٌ، أيّها القَمَرُ البَدْرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31254",""],[28,"وقائلة لي لم تصبني سهامها","https://www.poetsgate.com/ViewPoem.aspx?id=21980",""],[24,"أمن نوارَ عرفتَ المنزلَ الخلقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10874&r=&rc=15",""]],"verses":[["فَإِنَّ بِذاكَ الحَيَّ إِلفاً عَهِدتُهُ","وَبِالرَغمِ مِنّي أَن يَطولَ بِهِ عَهدي",0,"ي",1,0],["فَإِنَّ بِها أَوانِسَ ناضَلَتْنِي","بِأَلحاظٍ تَغيظُ بِها مَهاها",1,"ا",3,0],["فإنّ بني البَيتِ الرّفيعِ عِمادُهُ","إذا افْتَرَشوا فيهِ الهُوَيْنى تَقَوّضا",2,"ض",2,0],["فَإِن بُحتُ نالَتني عُيونٌ كَثيرَةٌ","وَأَضعُفُ عَن كِتمانِهِ حينَ أَكتُمُ",3,"م",1,0],["فانْبَرَتْ تَقْطَعُ المَفاوِزَ حتّى","برَكَتْ في حِمَى أبِي البَرَكاتِ",4,"ت",1,0],["فَأَنبَتَ الفَغوَ وَالريحانَ وابِلُهُ","وَالأَيهُقانَ مَعَ المُكنانِ وَالذُرَقا",5,"ق",2,0],["فَإِن بَدَأتَ بِقَولٍ","مِنهُ فَبِالكَأسِ ثَنِّ",6,"ن",1,0],["فَاِنبَرَت ظَبيَةُ الشَآمِ وَقالَت","بَعضَ هَذا فَقَد رَفَعتِ الشَآما",7,"م",2,0],["فَإِن بانَ مِنّي عَهدُها فَبِلَوعَةٍ","يَشُبُّ لَها بَينَ الضُلوعِ ضِرامُ",8,"م",1,0],["فَأَنبَتَ فِيهِ مِن غَشَنِض وغَشنَضٍ","ورَونَقِ رَندٍ والصَّلَندَدِ والأَسل",9,"ل",1,0],["فَإِنَّ بِكَفِّهِ ما دامَ حَيّاً","مِنَ المَعروفِ أَودِيَةً تَسيلُ",10,"ل",1,0],["فَانْبَرَى لِلْكُتْبِ يُخْرِجُهَا","آيَ تَعْلِيمٍ بِلاَ كُتْبِ",11,"ب",1,0],["فَإِنْ بَقِيتَ فَهْيَ التَّأَخُّرُ لَمْ يَزَلْ","وَإِنْ تُقْلِعُوا عَنْهَا فَذَاكَ التَّقَدُّمُ",12,"م",1,0],["فإن بواطن القوم احتراص","وإن أبدت ظواهرهم عَفافا",13,"ف",2,0],["فإن بان لي سير الكواكب لم اُبَلْ","أكان بجَذب ذلك السير أم دفع",14,"ع",1,0],["فَإِن بَخِلَت هِندٌ عَلَيكَ فَعَلَّها","وَإِن هِيَ جادَت كانَ صَدعاً عَلى وَقرِ",15,"ر",1,0],["فَإِنَّ بَني هِزّانَ لَمّا رَدَيتُهُم","وَبارٌ تَضاغَت تَحتَ كَهفٍ مُهَدَّمِ",16,"م",1,0],["فَإِنَّ بَقِيَّةَ الأَحسابِ مِنّا","وَأَصحابَ الحَمالَةِ وَالطِعانِ",17,"ن",1,0],["فَإِن بَرَكَت خَوَّت عَلى ثَفِناتِها","كَأَنَّ عَلى حَيزومِها حَرفَ أَعبَلا",18,"ل",2,0],["فَأَنبَوا بِعادٍ وَأَشياعِها","ثَمودَ وَبَعضِ بَقايا إِرَم",19,"م",1,0],["فأنِبْ إليهِ تُصبك رحْمَتُه","وارْهَبْ إذا ما اللَّهُ أرهبكا",20,"ك",2,0],["فأنْبأْتُها أنَّني حافظ","لأشياخِها ذمَّةَ المُسلم",21,"م",1,0],["فَإِنَّ بَني لِحيانَ إِمّا ذَكَرتَهُم","ثَناهُم إِذا أَخنى اللِئامُ ظَهيرُ",22,"ر",1,0],["فإن برزت فذاك لها وجود","وإن خفيت فذاك لها فناءُ",23,"ا",2,0],["فإن بكائي عن هوىً متحكمٍ","وإن نواحي عن غرامٍ ملازم",24,"م",1,0],["فَأَنبَتَّ مِنهُم رَبيعَ السِباعِ","فَأَثنَت بِإِحسانِكَ الشامِلِ",25,"ل",1,0],["فَاِنبَرَيا فَذَّينِ تَحتَ القَسطَلِ","قَد ضَمِنَ الآخَرُ قَتلَ الأَوَّلِ",26,"ل",1,0],["فإن بلَغَت نفسي المُنى فبِعَزمِها","وإلا فقد أبلَغتُ في حرصِها عُذرا",27,"ر",2,0],["فإنّ بواطن أعمالنا","خلاف الظواهر لا تنكرُ",28,"ر",1,0],["فإِنْ بلغتُ مُرادي فهو أرفقُ لي","وإنْ لقِيتُ حِمَامي فهو أروحُ لي",29,"ل",2,0],["فإِنَّ بهِ فيما عَهِدْنَاهُ سرحةً","يفيءُ إِليها بالعشيِّ قطيعُ",30,"ع",1,0],["فانّ بذاكَ الجَوِّ فاتنةَ اللُّمَى","أسيلةَ مجرَى الدمعِ واضحةَ الخَدِّ",31,"د",1,0],["فَإِن بِنتُ عَنكُم مُصبِحاً حَضَرَ الهَوى","وَإِن غِبتُ عَنكُم سائِراً شَهِدَ الشِعرُ",32,"ر",1,0],["فَإِن بِعتِناها فَنَكِّب بِنا","عَنِ البَخسِ في بَيعِها وَالغَبَن",33,"ن",1,0],["فَإِنَّ بَني أُمَيَّةَ في قُرَيشٍ","بَنَوا لِبُيوتِهِم عَمَداً طِوالا",34,"ل",2,0],["فَإِنَّ بُغائي إِن أَرَدتَ بُغايَتي","عِراضُ الصَحاري لا اِختِباءٌ بِأَدغالِ",35,"ل",1,0],["فَإِنَّ بِلالَ الجودِ لَستَ بِواجِدٍ","لَهُ عُدَةٌ إِلّا شَديداً دِخالُها",36,"ل",3,0],["فَإِنَّ بَني سَعدٍ هُمُ اللَيلُ فيهِمُ","حُلومٌ رَسَت وَالظالِمو كُلِّ ظالِمِ",37,"م",1,0],["فَإِنَّ بَني سَعدٍ هُمُ الهامَةُ الَّتي","بِها مُضَرٌ دَمّاغَةٌ لِلجَماجِمِ",37,"م",1,0],["فأنبت الله له لحية","تزيدني كربا على كرب",38,"ب",1,0],["فإنَّ بأسَكُمُ أمنٌ لِخائِفها","كما نَوالُكُمُ رَيٌّ لصَادِيها",39,"ي",3,0],["فَإنْ بَادَرْتُهُمْ جَعَلُوكَ بَدْراً","وَإنْ خَالَفْتَهُمْ جَعَلُوكَ خَلْفَا",40,"ف",2,0],["فَإِن بَناها بِخَيرٍ طابَ مَسكَنُها","وَإِن بَناها بَشَرٍّ خابَ بانيها",41,"ي",3,0],["فَإِن بَدَهتَهُ صُروفُ الزَمانِ","بِبَعضِ مَصائِبِهِ أَعوَلا",42,"ل",2,0],["فَإِن بَقيتُ فَرَهنٌ ذِمَّتي لَكُمُ","بِذاتِ وَدقَينِ لا نَعفو لَها أَثَرُ",43,"ر",1,0],["فإنّ بلادَ الناسِ ليستْ بلادَكُمْ","ولا جارُهَا والخِلمُ كالجارِ والخلمِ",44,"م",1,0],["فَإن بَكَيتُ فإنّي قد ذَكَرْتُ به","مَن جُرِّعَتْ مِنهُ كأسُ الموتِ بالشرَقِ",45,"ق",1,0],["فَإِن باشَرَ الإِصحارَ فَالبيضُ وَالقَنا","قِراهُ وَأَحواضُ المَنايا مَناهِلُه",46,"ل",2,0],["فإنْ باهَتْكَ بالحَلْيِ العذارى","فحسبُكَ منه طرفُكَ والعذارُ",47,"ر",1,0],["فَإِن بِنتِ كَدَّرتِ المَعاشَ صَبابَةً","وَإِن تَصقَبي فَالقَلبِ حَيرانُ هائِمُ",48,"م",1,0],["فَإِن بَكَيتُ وَقَد يَبكي الخَليلُ فَعَن","شَجوٍ يُفَجِّرُ عَينَ الماءِ في الحَجَرِ",49,"ر",1,0],["فَاِنبَرَت مِنهُن حَسنا","ء فَأذكَتني شُجونا",50,"ن",2,0],["فَأَنبَتَ يَقطيناً عَليها بِرَحمَةٍ","مِنَ اللَهِ لَولا اللَهِ لَم يَبقَ صاحِيا",51,"ي",2,0],["فَأَنبَتنا خَضارِمَ فاخِراتٍ","يَكونُ نِتاجُها عِنَباً وَتينا",52,"ن",2,0],["فَإِنَّ بِبَابِ الدارِ عَيناً وَإِن تَزُغ","حِذاراً لِتِلكَ العَينِ أَهيا وَأَمثَلُ",53,"ل",1,0],["فَإِنَّ بَني الرَيّانِ قَطبٌ لِقَومِهِم","تَدورُ رَحاهُم حَولَهُم وَتَجولُ",54,"ل",1,0],["فانبِذْ وشيجاً وارمِ ذا شُطَبٍ","لا البيَضُ نافعةٌ ولا السُّمُر",55,"ر",1,0],["فَإِن بَخِلَت عَينٌ بِتَقبيلِ أُختِها","فَما بَخَلَت كَفٌّ بِحَلِّ إِزارِ",56,"ر",1,0],["فَإِن بَخُلَت عَلَيكَ نُجومُ صِدقٍ","فَقَد مَطَرَتكَ أَنواءٌ بِغُزرِ",57,"ر",1,0],["فَإِن بورِكَ الخَيرُ الَّذي أَنتَ صانِعٌ","فَأَهلٌ وَإِلّا فَالخَطوبُ مَواحِقُ",58,"ق",1,0],["فإنْ باتَ منها فيهمُ وَعْكُ عِلّةٍ","ففيها جِراحٌ منهمُ وكُلُومُ",59,"م",1,0],["فإن بَكَى في قِفَارٍ خِلْتَها لُججاً","وإن تَنَفّس عادتْ كُلّهَا يَبَسا",60,"س",2,0],["فإنّ بَني نُوَيْرَةَ أدرَكَتْهُمْ","مَسَبّتُهُمْ بعَبْدِ أبي سُواج",61,"ج",1,0],["فانْبَرَتْ أَلْحاظُهُ تَطْلُبُني","وأَنا قُدَّامَها في الهَرَبِ",62,"ب",1,0],["فَانَبَرى أَحقَبُ يَتلُو أَربَعاً","لاَحِقُ الأَيطَلِ في قاعٍ جَلَد",63,"د",1,0],["فَإِنَّ بِهِ لِلْمَكْرُمَاتِ حُشَاشَةً","طَوَاهَا الرَّدَى فَالْقَلْبُ حَرَّانُ مُوجَعُ",64,"ع",1,0],["فَانْبَرَى مَاهِرٌ يُنَافِحُ عَنْ رَأْ","يٍ وَإِنْ جَلَّ دُونَهُ مَا يُسَامُ",65,"م",1,0],["فَانْبَرَى مُنْتَهِزاً فُرْصَتَهَا","وَالْفَتَى مَنْ لَمْ تَفُتْهُ الفُرُصَاتُ",66,"ت",1,0],["فانبرى يسبق السحابَ ويُضفي","بسمةَ الكونِ فوق ثغرِ الزمان",67,"ن",1,0],["فانْبِذِي عادةَ التَّبرجِ نَبْذاً","فجمالُ النُّفوسِ أسْمَى وأعْلَى",68,"ل",2,0],["فانبرى يحمل الأكاليل فى","الهام وحيا براحه وبنانه",69,"ن",2,0],["فانبرى البارود في حدته","وهو يغلي غليان المرجل",70,"ل",1,0],["فإن بناها بخير طاب مسكنُه","وإن بناها بشر خاب بانيها",71,"ي",3,0],["فانبرت دمعةٌ تُترجم عما","في ضمير الأُمِّ الحنونِ استَكَنّا",72,"ن",2,0],["فإن بيوتَ الشاعرين مناسكٌ","وإن قبورَ النابغين معابد",73,"د",1,0],["فإنْ بِنْتُ مِنكُمْ مُصْبِحاً حضرَ الهَوى،","وَإنْ غِبتُ عَنكُمْ سائراً شهدَ الشِّعرُ",74,"ر",1,0],["فإنّ بِلالَ الجُودِ لَسْتَ بِوَاجِدٍ","لَهُ عُقْدَةً، إلاّ شَديداً دِخالُها",75,"ل",3,0],["فَأَنْبَتَ الفَعْوَ والرَّيْحانَ وَابِلُه","والأيهقانَ مع المكنانِ والذُّرقا",76,"ق",2,0]]}