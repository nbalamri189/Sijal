%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[31,"أَلَمْ تَرْبَعْ عَلَى الطَّلَلِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18998&r=&rc=261",""],[88,"الى كم تصب الدمع عيني وتسكب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19575&r=&rc=78",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""]],"verses":[["وَعَينٍ رَجَتكُم أَن تَكونوا جَلاءَها","فَكُنتُم عَلى عَكسِ الرَجاءِ قَذاها",0,"ا",3,0],["وَعيسٍ خَطَت عَرضَ الفَلا بِرِحالِنا","تُزَعزَعُ في الأَعناقِ رُقشَ التَمائِمِ",1,"م",1,0],["وَعُيونَ طَعنٍ كَالعُيونِ يَمُدُّها","ماءٌ مَذانِبُهُ العُروقُ الذُبَّلُ",2,"ل",1,0],["وَعَيني لِرَقراقِ الدُموعِ وَقيعَةٌ","لَها اليَومَ مِن عاصي الشُؤونِ مُطيعُ",3,"ع",1,0],["وَعَينٌ عَوانٌ بِالدُموعِ وَغَيرُها","مِنَ الدَمعِ يَعرَوري جَوانِبَها بِكرُ",4,"ر",1,1],["وَعَيشُ اللَيالي عِندَ غَيرِكُمُ رَدىً","وَبَردُ الأَماني عِندَ غَيرِكُم وَقدا",5,"د",2,0],["وعَينٌ كما تَرْنو المَهاةُ إِلى طَلاً","إذا غابَ عَنها اغْتالَ خَطْوَتَهُ الذُّعْرُ",6,"ر",1,0],["وعيَّرْتَني تأخيرَ مَدْحِكَ بُرهةً","ومِنْ أينَ يَستوفي مَناقِبَكَ الشِّعْرُ",6,"ر",1,0],["وعَيْشاً نَضا عَنْ مَنْكِبيَّ رِداءَه","فِراقٌ يُعاطي الحادِثاتِ زِمامِيا",7,"ي",2,0],["وَعَينُ الجَواري يُغَنّينَنا","بِها نَتَلَهّى وَما يَلتَهينا",8,"ن",2,0],["وَعَيني لَم تَزَل تَجني","بَلايا كُلُّها تَنمي",9,"م",2,0],["وَعَينُ الرِضا عَن كُلِّ عَيبٍ كَليلَةٌ","وَلَكِنَّ عَينَ السُخطِ تُبدي المَساوِيا",10,"ي",2,1],["وَعَيناكَ إِن أَبدَت إِلَيكَ مَعائِباً","فَدَعها وَقُل يا عَينُ لِلناسِ أَعيُنُ",11,"ن",1,0],["وَعَينِ وَحشِيَّةٍ أَغفَت فَأَرَّقَها","صَوتُ الذِئابِ فَأَوفَت نَحوَهُ دابا",12,"ب",2,0],["وَعيدٌ تَخدِجُ الأَرحامُ مِنهُ","وَيَنقُلُ مِن أَماكِنها الجِبالا",13,"ل",2,0],["وَعَينٌ كَمِرآةِ الصَناعِ تُديرُه","لِمِحجَرِها مِنَ النَصيفِ المُثَقَّبِ",14,"ب",1,0],["وَعَينٌ لَها حَدرَةٌ بَدرَةُ","وَشُقَّت مَآقِيُّها مِن أُخَر",15,"ر",1,0],["وَعى سِرَّكُم في مُضمَرِ القَلبِ وَالحَشا","شَفيقٌ عَلَيكُم لا تُخافُ غَوائِلُه",16,"ل",2,0],["وَعَيْلَةٌ يُعْتَنَى بِنَشْأَتِهَا","لا فَرْقَ بَيْنَ الأَولادِ فِي القِسَمِ",17,"م",1,0],["وَعَيْنَانِ كَالنَّجْمَيْنِ فِي حَلَكِ الدُّجَى","هُمَا نِعْمَةُ الدُّنْيَا وَشِقْوَتُهَا سُمَا",18,"م",2,0],["وَعَينٌ كَعَينِ الرِئمِ فيها مَلاحَةٌ","هِيَ السِحرُ أَو أَدهى اِلتِباساً وَأَعلَقُ",19,"ق",1,0],["وَعَيناءَ مِبهاجٍ كَأَنَّ إِزارَها","عَلى واضِحِ الأَعطافِ مِن رَملِ عاجِفِ",20,"ف",1,0],["وَعيطاً كَأَسرابِ الخُروجِ تَشَوَّفَت","مَعاصيرُها وَالعاتِقاتُ العَوانِسُ",21,"س",1,0],["وَعَينانِ قالَ اللَهُ كونا فَكانَتا","فَعولانِ بِالأَلبابِ ما تَفَعلُ الخَمرُ",22,"ر",1,0],["وَعَينٍ كَأَنَّ البابِليّينِ لبَّسا","بِقَلبِكَ مِنها يَومَ مَعقُلَةٍ سَحرا",23,"ر",2,0],["وَعيناً أَحَمِّ الرَوقَ فَردٍ وَمِشفَرٌ","كَسِبَتِ اليَماني جاهِلٌ حينَ تَمرَحُ",24,"ح",1,0],["وَعَينٌ أَرَشَّتها بِأَكنافِ مُشرِفٍ","مِنَ الزُرقِ في سَفكٍ دِيارُ الحَبائِبِ",25,"ب",1,0],["وعينيك لا أسلوك أو يصبح السها","وشمس الضحا في ضوئه تتحجّب",26,"ب",1,0],["وعينُك في أم النجوم كبيرةٌ","تضيء على أن الضياء لهيب",27,"ب",1,0],["وَعَينِ هَلّا بَكَيتِ أَربَدَ إِذ","أَلوَت رِياحُ الشِتاءِ بِالعَضَدِ",28,"د",1,0],["وعيد الحبارى من بعيد تنفشت","لأزرق معلول الأظافر بالخَضْبِ",29,"ب",1,1],["وَعَيبٌ لأهلِ الدِين بَعدَ ثَبَاتِه","الى مُحدَثَاتٍ ليس عنها التَنَقُّلُ",30,"ل",1,0],["وَعَيشُ العالَمينَ لَدَيكَ سَهلٌ","وَعَيشي وَحدَهُ بِفَناكَ صَعبُ",31,"ب",1,0],["وعينٌ دمعها في الحبِّ طهرٌ","كأن دموع عيني بيرُ حاء",32,"ا",2,0],["وعيشي مأمون الطباق الذي أرى","فلا الشعرُ مبيضٌّ ولا الحال مسودُّ",33,"د",1,0],["وعيشك يا يحيى لو أنك تفتدي","لهنئتِ الدُّنيا بأنكَ خالدُ",34,"د",1,0],["وعيشاً نضا عنه الزمانُ بياضه","وخلَّفه في الرأسِ يزهو ويزهر",35,"ر",1,0],["وعيناً للزمان تجيل رأياً","تبسم عنه أرجاء الثغور",36,"ر",1,0],["وعيون جلى علينا من العل","مِ وكانت في غاية الإغماض",37,"ض",1,0],["وعيشك لولا سقم جسمي والبكى","لما كانَ سرِّي في هواكَ بذائع",38,"ع",1,1],["وعيناً على حالي بعاد وجفوة","عفا الله عمَّا قد جرى من دموعها",39,"ه",2,0],["وعين صبٍّ إلى مرآك قد لمحت","كفى من الدمع والتسهيد ما حملت",40,"ت",1,0],["وعيَّرتني بشيب الرأس ضاحكةً","مِن ضاحكٍ فيه أبكاني وأَضْحَكَ بي",41,"ب",2,0],["وعيَّرتموهم بالسَّواد ولم يزل","من العَرَب الأمحاض أخضرُ أدعجُ",42,"ج",1,0],["وعيونٌ أبينَ عَطْفاً على الغُم","ض اشتياقاً إلى لِثام البدور",43,"ر",1,0],["وعينين حمراوين يطرف عنهما","كأن حجاجيه بفَصَّينِ رُصِّعا",44,"ع",2,0],["وعينُ الماجِد المفضالِ عينٌ","كثيرُ نوالهِ فيها قليل",45,"ل",1,0],["وعَيْش أبيكَ ذي النعم الجواري","على الدنيا وذي المِنن العِظامِ",46,"م",1,0],["وعيونٍ ما مثلها من عيونٍ","آخذاتٍ مختارَ كُلِّ كلام",47,"م",1,0],["وَعَيَّرَها الواشونَ أَنّي أُحِبُّها","وَتِلكَ شَكاةُ ظاهِرٌ عَنكَ عارُها",48,"ر",3,0],["وَعيسٍ بَرَيناها كَأَنَّ عُيونَها","قَواريرُ في أَذهانِهِنَّ نُضوبُ",49,"ب",1,0],["وَعُيونٍ بِالنُهى عابِثَةٍ","جَذَبَ الغُنجُ إِلَيها الخَفَرا",50,"ر",2,0],["وَعُيوناً دَنَقَت فيها الأَماني المُستَحَرَّه","فَهيَ حَيرى ذاهِلاتٌ في الَّذي تَهوى وَتَكرَه",51,"ر",2,0],["وَعُيونِ ماءٍ دافِقاتٍ في الثَرى","تَشفي السَقيمَ كَأَنَّما هِيَ زَمزَمُ",52,"م",1,0],["وَعَيَّرَني قَومي شَبابي وَلِمَّتي","مَتى ما يَشا رَهطُ اِمرِئٍ يَتَعَيَّرُ",53,"ر",1,0],["وَعَيشِكَ إِنَّ لي مُذ غِبتَ عَنّي","لَحالاً ما أَظُنُّكَ تَرتَضيها",54,"ي",3,0],["وَعَينٌ تَتَمَنّى أَن","تَراكُم قَد غَضَضناها",55,"ا",3,0],["وَعُيونُ الناسِ تَستَح","يي وَما أَوقَحَ عَينَك",56,"ك",1,0],["وَعَيشِكِ هَذا وَقتُ لَهوي وَصَبوَتي","وَغُصني كَما قَد تَعلَمينَ نَضيرُ",57,"ر",1,0],["وَعَينِ مُضطَمِرِ الكَشحَينِ أَرَّقَهُ","هَمٌّ غَريبٌ وَناوي حاجَةٌ أَفِدُ",58,"د",1,0],["وَعَينانِ حُرٌّ مَآقيهِما","كَما نَظَرَ العُدوَةَ الجُؤذَرُ",59,"ر",1,0],["وَعَينٍ كَماءِ الوَقبِ أَشرَفَ فَوقَها","حِجاجٌ كَأَرجاءِ الرَكِيَّةِ غائِرُ",60,"ر",1,0],["وَعَيَّرَني الإِبلَ الحَلالَ وَلَم يَكُن","لِيَجعَلَها لِاِبنِ الخَبيثَةِ خالِقُه",61,"ق",2,0],["وَعَيشٍ صالِحٍ قَد عِشتُ فيهِ","لَوَ اِنَّ عِمادَ ظُلَّتِهِ يَقينا",62,"ن",2,0],["وعيون الذين ما اعترفوا من","ه بحسن الصنيع في مصر رُمد",63,"د",1,0],["وعيش كالزواج على غرام","وعيش مثل كارثة الطلاق",64,"ق",1,0],["وعين من رسول الله ترعى","وتحرس حامل الأمر الجُسام",65,"م",1,0],["وَعَيشٌ في أُصولِ المَوتِ سَمٌّ","عُصارَتُهُ وَإِن بَسَطَ الظِلالا",66,"ل",2,0],["وَعيشوا في ظِلالِ السِلمِ كَدّاً","فَلَيسَ السِلمُ عَجزاً وَاِتِّكالا",66,"ل",2,0],["وَعُيونٍ ساجِياتٍ سُجِّيَت","بِرُفاتِ السِحرِ أَو فَلِّ الحَوَر",67,"ر",1,0],["وَعيسى يَلُمُّ رِداءَ الحَياءِ","وَمَريَمُ تَجمَعُ ذَيلَ الخَفَر",68,"ر",1,0],["وعَيّرتْنا وما إِنْ طُلَّ في أُحُدٍ","وطُلَّ في مُؤْتَةٍ والدِّينُ لَمْ يرمِ",69,"م",1,0],["وَعَينُ المُخطِئينَ هُمُ وَلَيسوا","بِأَوَّلِ مَعشَرٍ خَطِئُوا فَتابوا",70,"ب",3,0],["وَعَيني إِلى أُذنَي أَغَرَّ كَأَنَّهُ","مِنَ اللَيلِ باقٍ بَينَ عَينَيهِ كَوكَبُ",71,"ب",1,0],["وَعُيونِ المَها وَلا كَعُيونٍ","فَتَكَت بِالمُتَيَّمِ المَعمودِ",72,"د",1,0],["وعينٌ نصوحُ الماقيينِ إِذا رأتْ","معالمَ حَيٍّ فالدموعُ شَآبِيبُ",73,"ب",1,0],["وعينيَ في ضَحْضَاحِ نومٍ مُصَرَّدٍ","يغازلُ جَفنيها كما يلِغُ الذِّيبُ",73,"ب",1,0],["وَعِيونٍ مَزَجنَ فِيَّ رَكايا","مِن رَكايا الشُؤونُ وَهِيَ الغُروبُ",74,"ب",1,0],["وَعَينٌ مَتى كَلَّفتَها الحِفظَ لَم تَنَم","وَنَفسٌ مَتى ما سُمتَها الجِدَّ جَدَّتِ",75,"ت",1,0],["وَعَيَّرَتني سِجالَ العُدمِ جاهِلَةً","وَالنَبعُ عُريانُ ما في فَرعِهِ ثَمَرُ",76,"ر",1,0],["وَعَينٌ لَيسَ تَألوني اِنسِكاباً","وَقَلبٌ لَيسَ يَألوني خَبالا",77,"ل",2,0],["وَعيدٌ أَتاني مِن زِيادٍ فَلَم أَنَم","وَسَيلُ اللَوى دوني وَهَضبُ التَهائِمِ",78,"م",1,1],["وعين الشمس من خجل","تلاحظنا وتحتجب",79,"ب",1,0],["وعيون الوشاة حين أعادت","ورد خديك للحياء شقيقا",80,"ق",2,0],["وعيشاً ناضرَ الأفنانِ غَضّاً","يَرِفُّ إذا اهتصرناهُ اهتِصارا",81,"ر",2,0],["وَعَينٌ خَلَت مِن نورِ وَجهِ حَبيبِها","عَجِبتُ لَها مِن بَعدِهِ كَيفَ تَرقُدُ",82,"د",1,0],["وَعُيونٍ في لَحظِهِنَّ سُكونٌ","هُوَ في الفَتكِ أَسرَعُ الحَرَكاتِ",83,"ت",1,0],["وَعُيونٍ كَأَنَّما الغُنجُ فيها","رائِدُ الحَتفِ أَو نَذيرُ الهَلاكِ",84,"ك",1,0],["وَعَيناكَ قَد فَوَّقَت أَسهُماً","فَمَن دَلَّهُنَّ عَلى مَقتَلي",85,"ل",2,0],["وعينها النجلاء إن تَلتفت","فموقع الصهباء في الجامِ",86,"م",1,0],["وَعَيِّدْ بالهدى وأعِدْ عليهمْ","عذابَ الحرب بالألمِ الأليمِ",87,"م",1,0],["وَعَينٌ إِذا هَيَّجتَها عادَتِ الكَرى","وَدَمعٌ إِذا اِستَنجَدتَ أَسرابَهُ نَجدُ",88,"د",1,0],["وَعُيُونٍ كُنَّ سُودَاً","صِرْنَ عِنْدَ الْمَوْتِ شُهْلا",89,"ل",2,0],["وعينُ زُرَيْقٍ بي إلى مائِها ظما","ألم ترَ لونَ الماءِ أزرقَ أبيضا",90,"ض",2,0],["وَعَينا جُؤذَرٍ خَرِقٍ وَثَغرٌ","كَمِثلِ الأُقحُوانِ وَجيدُ ريمِ",91,"م",1,0],["وَعَينَي مُغزِلٍ حَورا","ءَ لَم تُكحَل مِنَ الخُذُلِ",92,"ل",1,0],["وَعَينَي مَهاةٍ في الخَميلَةِ مُطفِلٍ","مُكَحَّلَةٍ تَبغي مَراداً لِجُؤذَرِ",93,"ر",1,0],["وَعَينٌ تُصابي وَتَدعو الفَتى","لِما تَركُهُ لِلفَتى أَرشَدُ",94,"د",1,0],["وَعَيشِكِ ما لي حيلَةٌ غَيرَ أَنَّني","بِلَفظِ الحَصا وَالخَطِّ في الأَرضِ مولَعُ",95,"ع",1,0],["وعينَك فَاحْمِلْ يا قتادةُ عائذاً","بمن لا ترى مِن دونه لك شافيا",96,"ي",2,0],["وَعَى عَنِ الطَّيرِ لمّا كَانَ يَألَفُهُ","غَضَّا فَطَارَ حَدِيثاً فِعلَ مُمتَثِلِ",97,"ل",1,0],["وَعُيون يَقظى روانٍ إِلَيكُم","دَمعَها في مصابِكُم لا يُصان",98,"ن",1,0],["وَعَينا مَهاةٍ في كِناسٍ بِرَملَةٍ","بِهاسِنَةٌ مِن نَعسَةٍ حينَ تَطرِفُ",99,"ف",1,0],["وَعيدُنا بِكُلِّ مَن كانَ مَلي","مُستَأدِياً وَالزَرعُ لَم يُسَنبِلِ",100,"ل",1,0],["وعيونٌ لِلْفُرسِ غارَتْ فهل كا","نَ لنِيرانِهِم بها إطفاءُ",101,"ا",2,0],["وعُيُونٌ مَرَّتْ بها وَهْي رُمْدٌ","فأَرَتْهَا مَا لَمْ تَرَ الزَّرْقَاءُ",101,"ا",2,0],["وعينٌ فارقَتْ نظراً فعادت","كما كانتْ ورُدَّ لها السَّليبُ",102,"ب",1,0],["وَعِياظٌ تدْوَى الدَّوَاوينُ منه","لا بمعنىً كأنُّهُ طِنْجِهارَهْ",103,"ر",2,0],["وَعَيشُنا مَوصولٌ","بِغَدوَةٍ رَواحُ",104,"ح",1,0],["وَعَيشٍ ما بِهِ عِندي","وَلا عِندَكَ مِن باسِ",105,"س",1,0],["وَعُيونُ الظِباءِ تَرنو إِلَينا","مُنعِماتٍ بِكُلِّ بِرٍّ وَلُطفِ",106,"ف",1,0],["وَعِيُّ الفِعالِ كَعِيِّ المَقالِ","وَفي الصَمتِ عِيٌّ كَعِيِّ الكَلِم",107,"م",1,1],["وَعَيَّرَني الأَعداءُ وَالعَيبُ فيهِمُ","وَلَيسَ بِعارٍ أَن يُقالَ ضَريرُ",108,"ر",1,1],["وَعَينُ الصَقرِ تَرعاني","وَتِلكَ العَينُ وَقّادَه",109,"د",2,0],["وَعَيشٌ قَد ظَفَرتُ بِهِ كِداداً","أَلَذُّ العَيشِ ما جَلَبَ الكِدادُ",110,"د",1,0],["وَعَينانِ يَجري الرَدى فيهِما","وَوَجهٌ يُصَلّى لَهُ أَسجَحُ",111,"ح",1,0],["وَعَيرِ أُناسٍ قَد كَوَيتُ عِجانَهُ","إِذا ما كَوَيتُ العَيرَ يَوماً فَأَنضِجِ",112,"ج",1,0],["وَعَينٌ تَسحَرُ العَينَ","وَما في سِحرِها حوبُ",113,"ب",1,0],["وَعيدُ أَبي قابوسَ في غَيرِ كُنهِهِ","أَتاني وَدوني راكِسٌ فَالضَواجِعُ",114,"ع",1,0],["وَعَيَّرَتني بَنو ذُبيانَ خَشيَتَهُ","وَهَل عَلَيَّ بِأَن أَخشاكَ مِن عارِ",115,"ر",1,0],["وَعَينُكَ سِقطٌ ما خَبا عِندَ قِرَّةٍ","كَلَمعَةِ بَرقٍ ما لَها الدَهرَ شائِمُ",116,"م",1,0],["وعيشَتي الشّبابُ وليسَ منها","صِبايَ ولا ذَوائِبيَ الهِجانُ",117,"ن",1,0],["وعُيونُ الرِّكابِ تَرْمُقُ عَيْناً","حوْلَهَا مَحْجِرٌ بلا أجْفانِ",118,"ن",1,0],["وَعَينانِ كَالماوَيَّتَينِ اِستَكَنَّتا","بِكَهفَي حِجاجَي صَخرَةٍ قَلتِ مَورِدِ",119,"د",1,0],["وَعَيَّرتَنا تَمرَ العِراقِ وَبُرَّهُ","وَزادُكَ أَيرُ الكَلبِ شَوَّطَهُ الجَمرُ",120,"ر",1,0],["وَعيشي بِالَّذي يُغنِيكِ حَتّى","إِذا ما شِئتِ أَن تَنأَي فَبيني",121,"ن",2,0],["وَعَيْنُ الشَّمْس تَرْنُو في قَتامٍ","رُنُوَّ البِكرِ ما بَينَ السُّتورِ",122,"ر",1,0],["وعيونُ الحسناء مغروقاتٌ","بدموعٍ فيها الأسى منظور",123,"ر",1,0],["وَعيون للحزن مغرورقاتٍ","تَبتَغي مثل دمعها أَن تسيلا",124,"ل",2,0],["وَعيون تَرنو العيون إليها","شاخصات ووجنة تتلهب",125,"ب",1,0],["وعى الحقُّ للمصطفى دعوةً","لنُصرتها والعوادي توالى",126,"ل",2,0],["وعينانِ بالسحر تستأثرانِ","خيالٌ لعمركِ هذا الكلام",127,"م",1,0],["وعِيادةُ المَرْضى يَرَاها ذو النُّهى","فَرْضاً ولم تُفْرَضْ عِيادةُ هائِم",128,"م",1,0],["وَعَيْلَةٍ أَضْحَتُ مِثَالاً لِمَا","يُغْضَى إِلَيْه نَكَدُ الطَّالِعِ",129,"ع",1,0],["وَعَيْنَانِ سَوْدَاوَانِ يَنْهَلُّ مِنْهُمَا","ضِيَاءٌ كَمَسْكُوبِ الرَّحِيقِ المُشَعْشَعِ",130,"ع",1,0],["وَعُيُونِي لا تَهْجُرُ الطِّرْسَ إِلاَّ","وَسَوَادُ السُّطُورِ بَعْضُ سَوَادي",131,"ي",1,0],["وعيون النجوم ترنو إلينا","ولسان الدجى يكاد يفوه",132,"و",2,0],["وَعَيني كُلَّما ذَرَفَت","تَهيجُ لَواعِجاً تَهِجُ",133,"ج",1,0],["وَعَينٌ كَمِرآةِ الصَناعِ تُديرُها","لِمِحجَرِها مِنَ النَصيفِ المُثَقَّبِ",134,"ب",1,0],["وعى ما وعى القرآن من كلّ حكمةٍ","وسيطَت لهُ الآداب باللحم والدم",135,"م",1,0],["وعيشٌ بلا موتٍ وكل ملذةٍ","يفوز بها الملتذُّ غير مَضير",136,"ر",1,0],["وعيالٍ من الطَّوى في هُزالٍ","يلبسون الحداد في يوم عيد",137,"د",1,0],["وعيون، كالمرايا، لمعت","في وجوه، من رمادٍ وانحناء",138,"ا",2,0],["وعينان يجري الردى فيهما","وَوَجْهٌ يُصَلَّى لَهُ أسْجَعُ",139,"ع",1,0],["وَعِياطٌ تُدْوَى الدَّوَاوينُ منه","لا بمعنًى كأنه طِنْجِهَاره",140,"ر",2,0],["وعيشاً إذا استعرضته قلت عنده :","\" كفى بك داء ان تَرىَ الموت شافيا\"",141,"ي",2,0],["وعَينُ الفجرِ تَذري الدمعَ طَلاًّ","وتَمسَحُه بمنديل الصباح",142,"ح",1,0],["وعيشِ \" المَهازيلِ \" في ناعمٍ","من العيشِ مِن مثلهِ يُستحى",143,"ا",1,0],["وعيوني هلاّ نَضبتِ وقد ينضبُ","من فرطِ ما يسيل القليب",144,"ب",1,0],["وعيقَتْ مُذْ بَغَتْ حقاً مضاعا","وساموها الدمار فلمْ يُعاقوا",145,"ق",3,0],["وعينان كالماويتين استكنتا","بلهفي حجاجي صخرةٍ قلت مورد",146,"د",1,0],["وَعَيْنٌ كَحَالِي الغِمْدِ أَمْسَى بِلاَ نَصْلِ","فَلَمَا اسْتَوَى شَكْلاً رَبِيعُ الصَّبَا بِهَا",147,"ه",2,0],["وَعَيْنَيْ مُغْزِلٍ حَوْرا","لم تكحلْ، من الخذل",148,"ل",1,0],["وعينيك لا أسلوكِ أو يصبح السها","وشمس الضحى في ضوئه تتحجب",149,"ب",1,0],["وَعَينٌ كمِرْآة ِ الصَّنَاعِ تُدِيرُها","لمَحْجِرهَا مِنَ النّصيفِ المُنَقَّبِ",150,"ب",1,0]]}