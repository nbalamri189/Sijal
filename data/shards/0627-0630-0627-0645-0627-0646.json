abudhabi.ae/diwan/poem/114364","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101938","الطويل"],[4674,"سباق","https://www.poetsgate.com/ViewPoem.aspx?id=207033",""],[4755,"ضَعِ الأَرضَ يا قلبي على الأَرضِ لَحظةً","https://www.poetsgate.com/ViewPoem.aspx?id=187431",""],[5074,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=175382",""],[5200,"رأيتك يا يحيى بن عيسى مخربا","https://www.poetsgate.com/ViewPoem.aspx?id=200798",""],[5302,"أقمت على نهري","https://www.poetsgate.com/ViewPoem.aspx?id=200064",""],[5340,"ويوم ترى كانونا الأول مقبلا","https://www.poetsgate.com/ViewPoem.aspx?id=186106",""],[5355,"يناديكِ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=191373",""],[5376,"عجباً من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188267",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5587,"عاتبني هواك","https://www.poetsgate.com/ViewPoem.aspx?id=195398",""],[2598,"خَرَجْتُ مِنَ المِصْرِ الحَوَارِيِّ أهْلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=20761",""],[5691,"سيداو (*)...!","https://www.poetsgate.com/ViewPoem.aspx?id=208171",""],[5751,"تعال بنفسجًا","https://www.poetsgate.com/ViewPoem.aspx?id=214806",""],[5809,"ربح","https://www.poetsgate.com/ViewPoem.aspx?id=205337",""],[5829,"فروض العشق","https://www.poetsgate.com/ViewPoem.aspx?id=152452",""],[6003,"نكبة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=188949",""],[6102,"تقولين خذني","https://www.poetsgate.com/ViewPoem.aspx?id=183319",""],[6260,"الغيث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68355&r=&rc=47",""]],"verses":[["إِذا ما نَفَعَ الجَهلُ","فَإِنَّ الضائِرَ العَقلُ",0,"ل",1,0],["إِذا ما نَفَذَتِ السَدَّ مِن كُلِّ حادِثٍ","رَأَيتُ أَمامي ما أَبتَغي سَدّا",1,"د",2,0],["إذا ما نَسَبْناهُنَّ كانَ انتِماؤُها","إليهِ الدُّرِّ يُعْزَى إِلى البَحْرِ",2,"ر",1,0],["إذا ما نهَضْنا عنْ مَقيلِ غَزالةٍ","نَزَلْنا فعرّسْنا بساحَةِ عِرِّيسِ",3,"س",1,0],["إِذا ما نَتَجنا أَربَعاً عامَ كُفأَةٍ","بَغاها خَناسيرٌ فَأَهلَكَ أَربَعا",4,"ع",2,0],["إِذا ما ناحَ في أَسوانَ باكٍ","سَمِعتَ أَنينَ شاكٍ في رَشيدِ",5,"د",1,0],["إِذا ما نَداهُ هَمى وَالحَيا","شَآهُ كَشَأوِ الجَوادِ البَخيلا",6,"ل",2,0],["إِذا ما نِعاجُ الرَملِ ظَلَّت كَأَنَّها","كَواعِبُ مَقصورٌ عَلَيها حِجالُها",7,"ل",3,0],["إِذا ما نَعِسنا نَعسَةً قُلتُ غَنِّنا","بِخَرقاءَ وَاِرفَع مِن صُدورِ الرَواحِلِ",8,"ل",1,0],["إِذا ما نَضَونا جَوزَ رَملٍ عَلَت بِنا","طَريقَةَ قُفٍّ مُبرِحٍ بِالرَواكِعِ",9,"ع",1,0],["إذا ما نهاني الشيبُ عن أكؤس الطلا","تُديرُ عليَّ الخمرَ منها بأكؤسِ",10,"س",1,0],["إذا ما نجوم الغرب ليلا تغورت","بدت أنجم في الشرق أخرى على الأثر",11,"ر",1,0],["إِذا ما نِمتِ هانَ عَلَيكِ لَيلي","وَلَيلُ الطارِقاتِ مِنَ الهُمومِ",12,"م",1,0],["إِذا ما نَأى مِنّي بَراحٌ نَفَضتُهُ","وَإِن يَدنُ مِنّي الغَيبُ أُلجِم فَأَركَبِ",13,"ب",1,0],["إِذَا مَا نَحنُ بِالشَّفَرَاتِ يَوماً","على حيٍّ وإِن كَرُمُوا عَصِينَا",14,"ن",2,0],["إذا ما نَبَا سَيْفٌ فلاَحَظَ رأْيَهُ","فَمَوْقِعُهُ مِمَّنْ تَوَخَّى مُمَهَّدُ",15,"د",1,0],["إذا ما نام عنها سائلوها","تَنَبَّه لا يَقَرُّ له قرار",16,"ر",1,0],["إذا ما نبا عني الوزيرُ وأنتُمُ","عتادي فلِم رجّاكُمُ مَنْ تَحَرَّما",17,"م",2,0],["إِذا ما نَسيتُكَ مَن أَذكُرُ","سِواكَ بِبالي لايَخطُرُ",18,"ر",1,1],["اذا ما نظمت الشعر فانظم مصورا","شعورك واستعمل من اللفظ ارضاه",19,"ه",1,1],["إِذا ما نَظَرتَ إِلى فارِسٍ","تَحَيَّرَ عَن مَذهَبِ الراجِلِ",20,"ل",1,0],["إِذا ما نِبالُ الفَقْرِ تاحتْ له اتَّقَى","بموضُونةٍ حَصْداءَ من كل جانبِ",21,"ب",1,0],["إِذا ما نَهى الناهي فَلَجَّ بِيَ الهَوى","أَصاخَت إِلى الواشي فَلَجَّ بِها الهَجرُ",22,"ر",1,0],["إِذا ما نَهاهُ العاذِلونَ تَتابَعَت","لَهُ أَدمُعٌ لا تَرعَوي لِعَذولِهِ",23,"ل",2,0],["إِذا ما نَحا مِن مَجلِسِ المُلكِ رُتبَةً","تَحَلحَلَ عَنها الأَحوَذِيُّ الحُلاحِلُ",24,"ل",1,0],["إِذا ما نَسَبتَ الحادِثاتِ وَجَدتَها","بَناتِ الزَمانِ أُرصِدَت لِبَنيهِ",25,"ي",2,0],["إِذا ما نَزَلنا قاتَلَت عَن ظُهورِنا","حَراجيجُ أَمثالُ الأَهِلَّةِ شُسَّفُ",26,"ف",1,0],["إذا ما نثر العقد","وأبقى الدرة الوسطى",27,"ا",1,0],["إِذا ما نَزَلنا خَرَّ غَيرَ مُوَسَّدٍ","وِساداً وَما طِبّي لَهُ بِهَوانِ",28,"ن",1,0],["إِذا ما نَأَت كانَت لِقَلبِي عَلاقَةٌ","وَفي الحَيِّ عَنها هِجرَةٌ وَصُدودُ",29,"د",1,0],["إذا ما نَسيجُ التِّبرِ أْضحى يُظلُّها","أفاءَ لها منْهُ غماماً كَنَهْوَرا",30,"ر",2,0],["إذا ما نحرتَ به أو عقرتَ","فعَدِّ الخوانفَ ذاتَ البُرى",31,"ا",1,0],["إِذا ما ناكِثٌ سَرَّ","كَ أَن تُفقِدهُ راسَه",32,"س",2,0],["إِذا ما نِلتُ مِن عَيشي رَخاءً","وَصِرتُ مِنَ النَوائِبِ في أَمانِ",33,"ن",1,0],["إِذا ما نَأَت فَالعَيشُ ناءٍ لِنَأيِها","وَإِن قَرُبَت فَالمَوتُ بِالقُربِ يَقرُبُ",34,"ب",1,0],["إذا ما نعيِّي أَتاك اذرفي","دموعك يا ليل بل كفكفي",35,"ي",1,0],["إذا ما نهارى جاء ساورني الأسى","وإن جنَّ ليلي فالأسى عسكر مجر",36,"ر",1,0],["إِذا ما نَظَمتُ الشِعرَ في غَيرِ ذِكرِها","أَبي وَأَبيها أَن يُطاوِعَني شِعري",37,"ر",2,0],["إذا ما نَعامُ الجوّ زَفّ حَسِبْتَها","مِن الدّوّ خِيطانَ النّعامِ المُفَزَّع",38,"ع",1,0],["إذا ما نَحْنُ أشْرَجْنَا عَلَيها","جيادَ الجُدلِ في الأُرَبِ الشِّدادِ",39,"د",1,0],["إذا ما نحرتَ به أو عقرتَ","ولا عَزَماتي أيادي سَبا",40,"ا",1,0],["إِذا ما نَوى يَشدو بِبَيت لَنا","تَمايل عُشاق شَوق الطَرَب",41,"ب",1,0],["إذا ما ناظره","تكاد الأرض تنفطر",42,"ر",1,0],["إذا ما نوى الجهال عن امره النوى","فاسيافه تُجلى واعداؤه تُجلى",43,"ل",2,0],["إِذا ما نالَ مِنكَ شَريفَ لَحظٍ","فَقد باهى نَفيسَ الدُرِّ وَقعا",44,"ع",2,0],["إذا ما نَهاني العقلُ فيك أعادَني","إليك هَوىً تَغْفو العيونُ ولا يَغْفو",45,"ف",2,0],["إذا ما نهى عنها إليها مفرّه","ضرورهُ طبع تأتلي بحناتها",46,"ت",3,0],["إذا ما نووا قطعنا أطمعوا","ليختدعونا بما قد نووا",47,"و",3,0],["إِذا ما نَظرتُ إلى وجهِه","رَأَيتُ عَلى كُلِّ خَدٍّ قمر",48,"ر",1,0],["إذا ما نحن زُرْناه فإنا","نزورُ نَدىً يَزيدُ على البحار",49,"ر",1,0],["إِذا ما نَظَرتُ إِلى غَيرِهِ","دَعاني هَواهُ إِلى ما جَرى",50,"ر",2,0],["إذا ما نشرت الأمن في الناس أقلقوا","وإن جئت تبغي السلم بالحلم أحربوا",51,"ب",3,0],["إذا ما نَداك الغَمْرُ نابَ عن الحَيا","غَنِينا به عن ساكب الغيث مُغْدِقِ",52,"ق",1,0],["إِذا ما نَدى تاجِ الْمُلُوكِ انْبَرى لَها","فَما عارِضٌ يَنْهَلُّ أَوْ دِيمَةٌ تَهْمِي",53,"م",2,0],["إِذا ما نَظَمْتُ الْحَمْدَ عِقْداً لِمَجْدِهِ","تَمَنَّتْ نُجُومُ اللَّيْلِ لَوْ كُنَّ مِنْ نَظْمِي",53,"م",2,0],["إذا ما نحو قطرك مد خط","حديدي إلى تلك القفار",54,"ر",1,0],["إذا ما نسيمٌ هز خطار قده","فما عنده والله في قتلي وقفه",55,"ه",1,0],["إذا ما نطاقُ العَفْوِ ضاقَ عنِ العدا","وباؤوا بحَرْبٍ لا تُطاقُ زَبون",56,"ن",1,0],["إِذا ما نَظَرتُم وَالعُيونُ سَواجِرُ","فَلا تَعجَبوا أَن تَسحَروا أَعيُنَ الناسِ",57,"س",1,1],["إِذا ما نَسيم الريح مِن نَحوِكُم أَسْرا","أَطارَ شَرار النار مِن كَبدي الحَرّا",58,"ر",2,1],["إذا ما نَعى الناعون أَهلَ مَوَدَّتي","بَكيتُ عَلَيهِم بَل بَكيتُ عَلى نَفسي",59,"ي",1,1],["إذا مانَبا حِسٌّ وكلَّتْ بَصيرةٌ","فطولُ بقاءِ المرء طولُ شقائهِ",60,"ا",3,0],["إذا ما نسيمٌ هبّ من جانِب الحِمَى","أَقولُ وأَشواقي تَزيدُ تَضَرُّما",61,"م",2,0],["إذا ما نَسينا عُهودَ الغُوَير","تذكّرنا عهدَها الأَرسمُ",62,"م",1,0],["اذا ما نضا عيداً تقمَّص مثلهُ","مُطاعاً فأقْصى غائبٍ مثلُ قادمِ",63,"م",1,0],["اذا ما نظرتُ إِلى وجههِ","شكرتُ الزَّمانَ ولم أذْمَم",64,"م",1,1],["إِذا ما نَزَلنا بَلدَةً دُوِّخَت لَنا","فَكُنّا عَلى أَربابِها بِالمُخَيَّرِ",65,"ر",1,0],["إِذا ما نارُهُمْ لمعَتْ عليهم","وأَجَّ طُوًى بلاهِبِها الضَّريمِ",66,"م",1,0],["إذَا ما نَحْنُ قُلْنا قَالَ طَهَ","يَضِيقُ عَلَيْهِمُ رَحْبُ الْمَكانِ",67,"ن",1,0],["إذا ما نادَى باسمِ ابنٍ أبُوهُ","ألستُ تَرى ابنَه حيناً يُجِيبُ",68,"ب",1,0],["إذا ما نُقِدن وُجدن النُّضارَ","وإِمّا كُرعن حُسبن العُقارا",69,"ر",2,0],["إذا ما نَضَتْ أرضُ العراقِ ركابَنا","فَقُلْ لِلمَهارى ثمَّ تعريسُك الحشرُ",70,"ر",1,0],["إِذا ما نَظَرتُ إِلى لَونِهِ","رَأيتُ الدُّجى قَد تردّى الضُّحى",71,"ا",1,0],["إِذا ما نَكَحنا الحَربَ بِالبيضِ وَالقَنا","جَعَلنا المَنايا عِندَ ذاكَ طَلاقَها",72,"ه",2,1],["إِذا ما نَزَلْتَ على ناكِثٍ","فكلُّ بلاء به نازل",73,"ل",1,0],["إذا مَا نَالَ ذو طَلَبٍ نجاحاً","بِأمرٍ لم يَجِد ألَمَ الطِّلابِ",74,"ب",1,1],["إذا ما نَصَبنَ المُقرباتِ تَقَدَّمَت","نَواجٍ أبُوها شَدقَمٌ وَجَديل",75,"ل",1,0],["إِذا ما نَبَتْ بالحُرِّ دارٌ يَوَدُّها","ولم يرتحلْ عنها فليس بذي حَزْمِ",76,"م",1,1],["إِذا ما نَعِمنا بِلُقيا المُنى","وَقَرَّت رَغائِبُنا الحائِرَهْ",77,"ر",2,0],["إذا ما نداه فاض عمت مواهبه","فلم يحكه التيار طمت خواربُهْ",78,"ب",2,0],["إذَا مَا نَأى أوْ زَارَ فَالمَوْتُ وَالْمُنَى","وَمَهْمَا رَنَا أوْ غَضَّ فَالقَبْضُ وَالبَسْطُ",79,"ط",1,0],["إِذا ما نظرت بعين الحِجا","فَلَم ترَ منها القوافي رجاكا",80,"ك",2,0],["إِذا ما نفسهُ نافت","إِلى شَهَواتها أنِفا",81,"ف",2,0],["إِذا ما نشدتُ المدحَ فيك كأنّني","منَ الصدقِ أثني فيكَ سبع مثانِ",82,"ن",1,0],["إِذا ما نشرت المدحَ فيك كأنّني","مِنَ الصدقِ في ذاك المديح أُسبِّحُ",83,"ح",1,0],["إِذا ما نَقَبَ الجُلدَ","ةَ أَخفى مَوضِعُ النَقبِ",84,"ب",1,0],["إذا ما نفى عنّي الكرى طولُ ليلَةٍ","تعَوَّدتُ منها باسم يحيى بنِ خالدِ",85,"د",1,0],["إِذا ما نِساءُ الحَيِّ رُحنَ فَإِنَّها","لَها النَّظرَةُ الأُولى عَلَيهنَّ وَالعَقبُ",86,"ب",1,0],["إِذا ما نالَ مَنْ دُوني مِراراً","أُحاولُ دُونَه فيُحالُ دُوني",87,"ن",2,0],["إذا ما نقل الدَّهقا","نُ غلاَّتِ الرساتيقِ",88,"ق",1,1],["إِذا ما نُسِبَ الناسُ","فَلا قَبلُ وَلا بَعدُ",89,"د",1,0],["إِذا ما نَوى فِعلَ أَكرُومةٍ","تجاوزَ مِن جُودِهِ ما نَوى",90,"ا",1,0],["إذا مانبت نَزْوَى ففي الأرْض مذْهبٌ","وفي العيس إرقْالٌ وفيَّ رحيلُ",91,"ل",1,0],["إذا ما نظرنا في مناكح خالد","عرفنا الذي يهوى وحيث يريد",92,"د",1,0],["إذا ما نسمة الفيحاء هبّت","بروح مبلبل الأحشاء صب",93,"ب",1,0],["إذا ما نشرنا في المجالس ذكرَه","تأرَّج في الدنيا فطبَّقها نشرا",94,"ر",2,0],["إذا ما نجوم الشعر باتت لوامعاً","طلعن على افرادها طلعة الفجر",95,"ر",1,0],["إذا ما نام عن وطنٍ بنوهُ","تملكتِ العدى فيه الحصُونا",96,"ن",2,0],["إذا ما نَوَاهُ في المهمَّاتِ آملٌ","فقدْ نَجَحَتْ أسْبابُهُ ووسائله",97,"ل",2,0],["إِذا ما نبا بلد بي رحلت","وَألقيت حبلي عَلى غارِبي",98,"ب",2,1],["إِذا ما نَحنُ نازَلنا قَبيلاً","رَأَيت المَوت قَد أَمضى حِرابه",99,"ب",2,0],["إذا ما نأى قَبَّلتُ ترباً يمسُّها","ومَن لم يجِد ماءً تيمَّمَ بالتُّربِ",100,"ب",1,0],["إذا ما نعتَّ الحقَّ يوماً فقيِّد","ولا تطلقنَّ النعتَ إن كنتَ تهتدي",101,"د",2,1],["إذا ما نبا منزل بي حملن","قلاقل عيش به قلقلا",102,"ل",2,0],["إِذا ما نَزَلنا لَم نَجِد ظِلَّ ساحَةٍ","سِوى يابِسِ الأَنهارِ أَو سَعَفِ النَخلِ",103,"ل",1,0],["إذا ما نَأَت كالجيشِ يَطلُعنَ بَعدَهَا","كَنَارِ مَصَفٍّ أو سَوَاقِطِ زئبَقِ",104,"ق",1,0],["إذا ما نظمت الشعر ظن جواهرا","وإن صغت نثرا ظن من حسنه درا",105,"ر",2,0],["إِذا ما نُجومُ اللَيلِ صارَت كَأَنَّها","هَجائِنُ يَطلَعنَ الفَلاةَ صَوادِرُ",106,"ر",1,0],["إذا ما نهضتم للحروب فقدموا","جواسيسكم فالجلد من كان حازما",107,"م",2,0],["اذا ما نسي التاريخ فالذنب واضح","وإن ساءت الدنيا فقد رُعتَها كيدا",108,"د",2,0],["إذا ما نسمة البانات هبت","على نجد وصافحت العذارا",109,"ر",2,0],["إذا ما نشرناهُ فكالمسك نشرهُ","ونطويه لا طيَّ السآمة بل ضنَّا",110,"ن",2,0],["إذا ما نظمت الشعر تقت لسامع","يشاركني بالفكر والروح والحس",111,"س",1,1],["إذا ما نظمت الشعر أصغت ليَ الجانُ","وأصغت ليَ الأكوان فالكل آذان",112,"ن",1,1],["إذا ما نظرت سبيتِ القلوب","وإمّا نطقت سلبتِ العقولا",113,"ل",2,0],["إذا ما نما الشيء يوما سما","وإن مات يصبحْ حقيرا وضيعا",114,"ع",2,0],["إِذا ما نبت دار السَلام بِأَهلها","فَلا جَبل يؤوي الكِرام وَلا سَهل",115,"ل",1,0],["إذا ما نهى النفس عن منكر","يعود وفيه إليه أوام",116,"م",1,0],["إذا ما ناك مولاه غلام","فليس على سوى المولى ملام",117,"م",1,0],["إِذا مَا نّسِيمُ الشوقِ هَزّ قَريحَتي","تَسَاقَطَ منها الدرّ في رَوضَةِ الشّعرِ",118,"ر",1,0],["إذا ما نسيمُ الفجرِ باشرَ نشرَهُ","تنبّه منه سائقٌ وجنيبُ",119,"ب",1,0],["إِذا ما نَدى راحاتَه سَحَّ مُمطِراً","فَماذا عَلينا إن تَشح الغَمائِم",120,"م",1,0],["إِذا ما نَظَمت الدُر في حُسن وَصفِهم","رَأوني لِذاك الدُر أَحسَن ناظم",121,"م",1,0],["إذا ما نزلت بوادي الآشى","فقل رب من لدغه سلّمِ",122,"م",1,1],["إِذا ما نسيم الرَوض مرّ ببانه","أَقول رَسول الهاجرين يُسلِّم",123,"م",1,0],["إذا ما نلت خيراً من جهولٍ","فلا تقرب له يَشقى ويُشقي",124,"ي",1,1],["إذا ما نطقنا توالت خطوب","وصالت شعوب، ودالت دُوَلْ",125,"ل",1,0],["إذا ما نظرتُ السحب تسري عشية","وبدر الدجى يخفي هناك ويظهرُ",126,"ر",1,1],["إِذا ما نَحَت قالَ الناسُ غَنّى","وَما عَرَفوا غِنائي مِن نَواحي",127,"ح",2,0],["إذا ما نضت عنها اللثام وأسفرت","تقشع من شمس النهار غمامها",128,"م",3,0],["إِذْا مَا نَظَرْتُ إلَى طَوْلِهِ","تَقاصَرَ عَنْهُ لِسانُ امْتِداحْ",129,"ح",1,0],["إذا ما نهضنا طَالبي مَحق بَلدةٍ","نَسفنا ثَراها من جُيوشٍ بصرصر",130,"ر",1,0],["إذا ما نظرتَ لقولٍ ول","كنِ انظر وحققت ما قد صدم",131,"م",1,0],["إذا ما نحا الدرع الدلاص برمحه","فما هي إلا ان تشك فتنغط",132,"ط",1,0],["إذا ما ندبناه لكل ملمة","ندبنا فتى الفتيان غير ملهد",133,"د",1,0],["إذا ما نظرتُ إلى سابقٍ","جلدتُ الليالي فلم أُبقِ ظَهرا",134,"ر",2,0],["إذا ما نجا منهم من المَوتِ نازحٌ","تَلَقّاهُ بالجُوعِ البَقاءُ المُؤنِّبُ",135,"ب",1,0],["إِذَا ما نَضَتْ عَنْ وَجهِهَا السِّتْرَ لَحظَةً","تَدَلَّى كَشَلَّالٍ يُحَجِّبُهُ ، الشَّعْرُ",136,"ر",1,0],["اذا ما نجا من شؤمك اليوم معشر","فلست بمخليهم من الشؤم في غد",137,"د",1,0],["إذا ما نأى عنها بعيدا أتى لها","سريعا كغاد شارد الذهن رواح",138,"ح",1,0],["إذا ما نلت بعد عشرين وقت","لنيسان بالنطح ارتقبه مع الفجر",139,"ر",1,1],["إذا مَا نَسينَا جِراحَ الليالي","توالتْ جِراحٌ وجدَّتْ عِلَلْ",140,"ل",1,0],["اذا ما نظرْت القومَ بعدَ تأملٍ","ظننْتَ بأنَّ الربعَ فيهم مخانثُ",141,"ث",1,0],["إِذا ما نَشَدْنا مَدِيحاً لَهُ","كأَنَّا أَتَيْنا بِسَبْعٍ طُوَلْ",142,"ل",1,0],["إِذا ما نَشَدْتُ المَدْحَ فِيكَ كَأَنَّنِي","مِنَ الصِّدْقِ فِي ذاكَ المَدِيحِ أُسَبِّحُ",143,"ح",1,0],["إِذا ما نَظَرْتَ بِعَيْنِ الحِجا","فَلَنْ تَرَى مِنْها القَوافِي رِكاكَا",144,"ك",2,0],["إِذَا مَا نَادَتِ الأَوْجَاعُ جُرْحِي","فَكَيْفَ القَلْبُ تُمْتِعُهُ دِمَاكَا",145,"ك",2,0],["إِذَا مَا کنْتَحَى فِي المَاءِ وَالوَحْلِ لَمْ تَرِمْ","قَوَائِمُهُ حَتَّى يُؤَخَّرَ بِالحَمْلِ",146,"ل",1,0],["إذا ما نَضَتْ عنْها العَفافَ (تَحَرُّراً)","كما يَدَّعي الشَّيْطانُ والطُّهْرُ يُنْزَعُ...",147,"ع",1,0],["اذا ما نمتَ يا مَلَكي تَذَكَّرْ","بأني في منامِكَ سوفَ أحضرْ",148,"ر",1,1],["اذا مانلتَ من دنياكَ ربحاً","حذارِ من التلاعبِ بالحروفِ",149,"ف",1,1],["إذا ما نالها ضيمٌ وجورٌ","تجرَّد من مآقينا الحسام",150,"م",1,0],["إذا ما نظرت إلى تعز","يؤرق عينيك أهوالها",151,"ل",3,0],["إِذَا مَا نَظَمْتُ الشِّعْرَ أَنْطَقْتُ أَبْكَمًا","وَ أَبْصَرْتُ مَنْ - يَا \" مَيُّ \" - كَانَ كَفِيفا",152,"ف",2,0],["إذا ما نعمنا بلقيا المنى","وقرت رغاب لنا حائرة",153,"ر",2,0]]}