{"poems":[[53,"جناني شجاع إن مدحت وإنما","https://www.aldiwan.net/poem29646.html","الطويل"],[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[93,"وحبك يا سيدتي أمينه","https://www.aldiwan.net/poem11115.html","الرجز"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[28,"بناها الأقرع الباني المعالي","https://www.aldiwan.net/poem4959.html","الوافر"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[113,"حنت لفيفاء البطاح الروح","https://www.aldiwan.net/poem41186.html","عموديه"],[119,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[130,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[158,"يساري في يمينك لا تزال","https://www.aldiwan.net/poem58723.html","الخفيف"],[201,"عجبت لفخر الأوس والحين دائر","https://www.aldiwan.net/poem68163.html","الطويل"],[204,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[210,"يا سيدي فعلكم لا كان مجهولا","https://www.aldiwan.net/poem37845.html","البسيط"],[303,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[390,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[434,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[434,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[436,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[436,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[450,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[498,"متكين بصرتنا وأحمد أحمد","https://www.aldiwan.net/poem38030.html","الكامل"],[527,"كم ذا له من منن","https://www.aldiwan.net/poem37127.html","مجزوء الرجز"],[536,"يا سيدي عشت لي وبعدي","https://www.aldiwan.net/poem48239.html","عموديه"],[559,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[573,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"]],"verses":[["وَفَخرُ الفَتى بِالقَولِ لا بِنَشيدِهِ","وَيَروي فُلانٌ مَرَّةً وَفُلانُ",0,"ن",1,0],["وَفَخرٍ شامِخِ العِرنَينِ عالٍ","وَمَجدٍ طائِرِ العَزَباتِ سامِ",1,"م",1,0],["وَفَخْرُ بَنِي زَيَّانَ يُحُضِرُ إِنْ خَطَوْا","وَيُسْرِعُ إِنْ أَبْطَوْا وَيَمْضِي إِذَا هَمُّوا",2,"م",3,0],["وَفَخْرُ مِصْرَ أَنَّهَا مَدِينَهْ","بِمَا تَقُولِينَ وَتَفْعَلِينَهْ",3,"ن",2,0],["وفخار بيتٍ في السيادةِ وازنٌ","ما بيت نظم فخاره بزحاف",4,"ف",1,0],["وفخار ما بين عرضٍ عزيزٍ","قد تربت وبين مال مهان",5,"ن",1,0],["وَفَخرُكَ يا جَريرُ وَأَنتَ عَبدٌ","لَغَيرَ أَبيكَ إِحدى المُنكَراتِ",6,"ت",1,0],["وَفَخرُكَ بَينَ يَربوعٍ وَضَبٍّ","عَلى مِثلي مِنَ الحَدَثِ الكِبارِ",7,"ر",1,0],["وَفَخْرِ الغُزَاةِ قُرُومِ السَّرا","يَا وَفِكْرِ الهُدَاةِ نُجُومِ السُّرى",8,"ر",2,0],["وفخار بيت لا يسامى مجده","كل الفخار لمجده ممنوح",9,"ح",1,0],["وفخذٌ وليس الوصف يأتي بوصفه","سوى أنه قد سُلَّ سَلاً مجسّما",10,"م",2,0],["وَفَخرُكَ بِالشَّيخِ الَّذِي قُلتَ ثابِتٌ","فَإِن تَكُ مِثلَ الشَّيخِ فَاستَطِبِ الثَّوَا",11,"و",2,0],["وفخر في الانام به استطالوا","ومرتبةٌ تطولُ ولا تطالُ",12,"ل",1,0],["وَفَخرُ بَني النَجّارِ إِن كانَ مَعشَرٌ","أُصيبوا بِبَدرٍ كُلُّهُم ثَمَّ صابِرُ",13,"ر",1,0],["وفخر غدا في ذروة المجد ثاوياً","وعزِّ على هام السماك تأطدا",14,"د",2,0],["وفخرُكم في السَّما نُورٌ تُضِئُ بهِ","وسيفُ عَلْياكُم لا زالَ مَسْلُولا",15,"ل",2,0],["وفخارنا ما تنتج الهيجاء لا","ما تنتج الآلات والأهواءُ",16,"ا",2,0],["وَفخارُهُ يَتَناوَلُ الز","زُهرَ الثَواقِبَ وَهو قاعِد",17,"د",1,0],["وفخراً على كلّ البلاد لجلّقٍ","ومعلمها إذ راح بالجود معلَما",18,"م",2,0],["وفخري بنفسي أنها ذات رفعةٍ","وعزّ عليه الذلّ ما يتطرّقُ",19,"ق",1,0],["وفخراً لنا منكَ سارَتْ بِهِ","رِكابُ التِّهامِينَ والمُنْجدِينا",20,"ن",2,0],["وفخرُكَ محمولٌ بحمديَ فِي الورى","وذِكرُكَ موصولٌ بذكرِي إِلَى الحَشْرِ",21,"ر",1,0],["وَفَخْرٌ لَوْ استَنْجدْتُ فِي وَصْفِهِ الوَرَى","لأَسْأَرَ من عَدِّ الحَصى مَنْ يَعُدُّهُ",22,"د",2,0],["وفخار نابلس من اقتعد السُّهى","وأسالَ من فيض البراعة كوثرا",23,"ر",2,0],["وفَخارُكُمْ في الأَولِياءِ لعِزِّهِ","ركنٌ على هامِ السَّماكِ مُشَيَّدُ",24,"د",1,0],["وفَخْرَ أَهْلِ بَيْتِهِ","بَلْ فَخْرَ آلِ الْحَسَنِ",25,"ن",1,0],["وفَخرِ غربٍ على سِوَاه","وماجِداً عَن أبٍ وجَدِّ",26,"د",1,0],["وَفَخِذاً لَفّاءَ تَمَّت عِظَما","وَمَأكِماتٍ يَرتَجِجنَ وُرَّما",27,"م",2,0],["وفَخْراً لِقُطرٍ حَلَّ فيه فإِنَّه","يليه على السَّبع الأَقاليم قُطْرُه",28,"ر",2,0]]}