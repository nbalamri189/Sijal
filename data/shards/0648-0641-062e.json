{"poems":[[55,"جناني شجاع إن مدحت وإنما","https://www.aldiwan.net/poem29646.html","الطويل"],[55,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[95,"وحبك يا سيدتي أمينه","https://www.aldiwan.net/poem11115.html","الرجز"],[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[74,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[30,"بناها الأقرع الباني المعالي","https://www.aldiwan.net/poem4959.html","الوافر"],[52,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[119,"حنت لفيفاء البطاح الروح","https://www.aldiwan.net/poem41186.html","عموديه"],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[136,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[164,"يساري في يمينك لا تزال","https://www.aldiwan.net/poem58723.html","الخفيف"],[207,"عجبت لفخر الأوس والحين دائر","https://www.aldiwan.net/poem68163.html","الطويل"],[210,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[216,"يا سيدي فعلكم لا كان مجهولا","https://www.aldiwan.net/poem37845.html","البسيط"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[443,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[443,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[445,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[445,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[457,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[505,"متكين بصرتنا وأحمد أحمد","https://www.aldiwan.net/poem38030.html","الكامل"],[534,"كم ذا له من منن","https://www.aldiwan.net/poem37127.html","مجزوء الرجز"],[543,"يا سيدي عشت لي وبعدي","https://www.aldiwan.net/poem48239.html","عموديه"],[566,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[580,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138201",""],[833,"","https://poetry.dctabudhabi.ae/diwan/poem/198795","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59816","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17115","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49949","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80067","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79999","السريع"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101815","المتقارب"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137083",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137397",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75989","الكامل"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126521","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93815","الطويل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34743","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74217","الخفيف"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130112","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52982","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52975","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52981","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109914","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59504","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105505","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4978,"تشطير قصيدة لو كان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177254",""],[5084,"هلّ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=177785",""],[5183,"الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=186490",""],[5212,"شموخُ العلم","https://www.poetsgate.com/ViewPoem.aspx?id=212107",""],[5237,"بإحسان ذي الطول أهل الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=113118",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6144,"عزرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=21837",""],[5309,"هوى المال كالشرير تذهب ريحه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573806",""]],"verses":[["وَفَخرُ الفَتى بِالقَولِ لا بِنَشيدِهِ","وَيَروي فُلانٌ مَرَّةً وَفُلانُ",0,"ن",1,0],["وَفَخرٍ شامِخِ العِرنَينِ عالٍ","وَمَجدٍ طائِرِ العَزَباتِ سامِ",1,"م",1,0],["وَفَخْرُ بَنِي زَيَّانَ يُحُضِرُ إِنْ خَطَوْا","وَيُسْرِعُ إِنْ أَبْطَوْا وَيَمْضِي إِذَا هَمُّوا",2,"م",3,0],["وَفَخْرُ مِصْرَ أَنَّهَا مَدِينَهْ","بِمَا تَقُولِينَ وَتَفْعَلِينَهْ",3,"ن",2,0],["وفخار بيتٍ في السيادةِ وازنٌ","ما بيت نظم فخاره بزحاف",4,"ف",1,0],["وفخار ما بين عرضٍ عزيزٍ","قد تربت وبين مال مهان",5,"ن",1,0],["وَفَخرُكَ يا جَريرُ وَأَنتَ عَبدٌ","لَغَيرَ أَبيكَ إِحدى المُنكَراتِ",6,"ت",1,0],["وَفَخرُكَ بَينَ يَربوعٍ وَضَبٍّ","عَلى مِثلي مِنَ الحَدَثِ الكِبارِ",7,"ر",1,0],["وَفَخْرِ الغُزَاةِ قُرُومِ السَّرا","يَا وَفِكْرِ الهُدَاةِ نُجُومِ السُّرى",8,"ر",2,0],["وفخار بيت لا يسامى مجده","كل الفخار لمجده ممنوح",9,"ح",1,0],["وفخذٌ وليس الوصف يأتي بوصفه","سوى أنه قد سُلَّ سَلاً مجسّما",10,"م",2,0],["وَفَخرُكَ بِالشَّيخِ الَّذِي قُلتَ ثابِتٌ","فَإِن تَكُ مِثلَ الشَّيخِ فَاستَطِبِ الثَّوَا",11,"و",2,0],["وفخر في الانام به استطالوا","ومرتبةٌ تطولُ ولا تطالُ",12,"ل",1,0],["وَفَخرُ بَني النَجّارِ إِن كانَ مَعشَرٌ","أُصيبوا بِبَدرٍ كُلُّهُم ثَمَّ صابِرُ",13,"ر",1,0],["وفخر غدا في ذروة المجد ثاوياً","وعزِّ على هام السماك تأطدا",14,"د",2,0],["وفخرُكم في السَّما نُورٌ تُضِئُ بهِ","وسيفُ عَلْياكُم لا زالَ مَسْلُولا",15,"ل",2,0],["وفخارنا ما تنتج الهيجاء لا","ما تنتج الآلات والأهواءُ",16,"ا",2,0],["وَفخارُهُ يَتَناوَلُ الز","زُهرَ الثَواقِبَ وَهو قاعِد",17,"د",1,0],["وفخراً على كلّ البلاد لجلّقٍ","ومعلمها إذ راح بالجود معلَما",18,"م",2,0],["وفخري بنفسي أنها ذات رفعةٍ","وعزّ عليه الذلّ ما يتطرّقُ",19,"ق",1,0],["وفخراً لنا منكَ سارَتْ بِهِ","رِكابُ التِّهامِينَ والمُنْجدِينا",20,"ن",2,0],["وفخرُكَ محمولٌ بحمديَ فِي الورى","وذِكرُكَ موصولٌ بذكرِي إِلَى الحَشْرِ",21,"ر",1,0],["وَفَخْرٌ لَوْ استَنْجدْتُ فِي وَصْفِهِ الوَرَى","لأَسْأَرَ من عَدِّ الحَصى مَنْ يَعُدُّهُ",22,"د",2,0],["وفخار نابلس من اقتعد السُّهى","وأسالَ من فيض البراعة كوثرا",23,"ر",2,0],["وفَخارُكُمْ في الأَولِياءِ لعِزِّهِ","ركنٌ على هامِ السَّماكِ مُشَيَّدُ",24,"د",1,0],["وفَخْرَ أَهْلِ بَيْتِهِ","بَلْ فَخْرَ آلِ الْحَسَنِ",25,"ن",1,0],["وفَخرِ غربٍ على سِوَاه","وماجِداً عَن أبٍ وجَدِّ",26,"د",1,0],["وَفَخِذاً لَفّاءَ تَمَّت عِظَما","وَمَأكِماتٍ يَرتَجِجنَ وُرَّما",27,"م",2,0],["وفَخْراً لِقُطرٍ حَلَّ فيه فإِنَّه","يليه على السَّبع الأَقاليم قُطْرُه",28,"ر",2,0],["وفخار وادي النيل كل فخاره","إن تنتمي كابن إليه وتُنسبا",29,"ب",2,0],["وفخر العروبة في العالمين","وأغلى وأثمن ما تخزن",30,"ن",1,0],["وَفَخرُهم في ذَوي الأَنسابِ في نَسَبٍ","وَتاجُهم في ذَوي الأَحسابِ بِالحَسَبِ",31,"ب",1,0],["وفخر بني نصر إذا عُدَّ فخرهم","فأحرزَ في ميدان حمدهم الخصل",32,"ل",1,0],["وَفَخرِيَ إِسلامي وَذُخري أَمانَتي","وَجُندِيَ أَشعاري وَسَيفي لِسانِيا",33,"ي",2,0],["وفخرهما بالأوس والخزرج الألى","حَوَوْا شرف الإسلام في كل مشهدِ",34,"د",1,0],["وفخرك لم تحك شمسُ السما","سناه بباهر إشراقِها",35,"ق",3,0],["وفخر أرباب النهى المصطفى","مَن هو أزكى من نما محتد",36,"د",1,0],["وفخركم بإبراهيم جهلاً","فإنا ذاك عنكم حائزونا",37,"ن",2,0],["وَفَخرُ الفَتى بِالنَفسِ لا الجِسمِ إِنَّني","أَرى الفَضلَ في الأَثمارِ لِلُّبِّ لا القِشر",38,"ر",1,0],["وفخامةِ المُلكِ الرفيع عمادُهُ","في عهد أعدلهم أنو شِروانِ",39,"ن",1,0],["وفخار قد سما أفق السما","وعلا أسنى محل أرفع",40,"ع",1,0],["وفخرا رفيعا ورفداً سريعا","وركنا منيعا وطوداً أشما",41,"م",2,0],["وفخرها أنها في المدح قد صدعت","بقول صدق فلا حيّ يلاحيها",42,"ي",3,0],["وفخارٍ وسُؤدَدٍ من عُلاهُ ال","شَّامِخِ القَدرِ الرَّاسِخِ البُنيانِ",43,"ن",1,0],["وفخار يعزي الى غير فضل","فهو من بهجة المفاخر خال",44,"ل",1,0],["وفخارك السامي ورفعتك التي","شرفت بها الآباء والأجداد",45,"د",1,0],["وَفَخَرتُ لَمّا أَن خَرَرتُ مُقبِّلا","رِجلاً لَها في الخَيرِ أَيّ مَساعِ",46,"ع",1,0],["وفخر النفس مجد واصطبار","تدوس بهِ لظى شوك القتادِ",47,"د",1,0],["وفخر النفس اقناع وصبر","وما فخر يقوم بلا جهادِ",47,"د",1,0],["وفخر به قد قلد الدهر جيده","إذ حل بالأكوان كان لها حليا",48,"ي",2,0],["وفخذان بينهما بَسطةٌ","إذا ما مشت مِشية المنتشي",49,"ش",2,0],["وَفَخار إِذا وَزَنت علاه","بِنُجوم السَماء يَزداد فَخرا",50,"ر",2,0],["وفخرك يا فاروق لم نرَ مثلهُ","فقد جُمِعَت فيه العلا والمحامدُ",51,"د",1,0],["وَفخرهُم بالفَضلِ والجاهِ والنَدى","وَبيضٍ وَسُمرٍ لا ببيضٍ ولا صُفرِ",52,"ر",1,0],["وفخر طيوى قديمُ عهد","أبوابها محكماتُ عُمْدِ",53,"د",1,0],["وفخرهُا يُنادي","ما المجدُ إلا ديْدني",54,"ي",1,0],["وفخارنا في الكون جلَّ عن المثيل","لرحابنا تُطوى المهامه بالطلاح",55,"ح",1,0],["وفخرٌ وذُلٌ مع دَلالٍ وراحةٍ","وزَهوٌ وتنعيمٌ ورَيعُ الشبائبِ",56,"ب",1,0],["وفخر ملوك الأزد بي لا بهم غدا","فخارى وإن كانوا كرام الأكارم",57,"م",1,0],["وفخر شخصٍ قد يُرى بفضلهِ","أولى أخي من فخره بأصلهِ",58,"ه",1,0],["وَفخذانِ آخذانِ فوقَ ما","تما بهِ من النعيم المُغتَذى",59,"ا",1,0],["وفخراً في علاك فقد تحلى","بفيض ندام عاطل كل جيد",60,"د",1,0],["وفخرهم في ذاك كالدهر قدوموس","بشاشتهم للضيف خير من القِرَى",61,"ر",2,0],["(وفخرت بي بين الخلائق جهرة)","نجما سنيّا في سماك مهابا",62,"ب",2,0],["وفخذين للفهمين درّاج مزروع","موز ٍ على شرواه ما يوجدنيّ",63,"ن",2,0],["وفخاراً أروم واسطة العق","د أبا الفيصل السريّ الجليلا",64,"ل",2,0],["وَفَخْرٌ لِلعلومِ اليومَ مولِدُهُ","وَحَقٌّ لِلعلومِ اليومَ تَفْتَخِرُ",65,"ر",1,0],["وفخم في الفتح مقداره","وعظم أخلاقه في القلم",66,"م",1,0],["وفخراً أطيداً بالثنا متألق","يقصر عن إدراكه كل فاضل",67,"ل",1,0],["وفخر المعالي فيهم أنهم قضوا","بحربٍ تخطاهم إلى الكفر عارها",68,"ر",3,0],["وف خرجه زواد وزاد","من بمب بريطاني",69,"ي",1,0],["وَفَخرُ الفَتى في الأَرضِ تَرديدُ ذِكرِهِ","وَإِلاَ فَهَل تُحيي الغَنِيَّ صُروحُه",70,"ح",2,0]]}