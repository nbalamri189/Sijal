{"poems":[[88,"ما لي أرى بحر السياسة","https://www.aldiwan.net/poem10920.html","مجزوء الكامل"],[85,"يا من له الوجه الجميل إذا بدا","https://www.aldiwan.net/poem54263.html","الكامل"],[23,"لقد لقيت قريظة ما سآها","https://www.aldiwan.net/poem21432.html","الوافر"],[53,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[18,"دعاني داعيا مضر جميعاً","https://www.aldiwan.net/poem23916.html","الوافر"],[77,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[50,"يا كاتبا كتب الغداة يسبني","https://www.aldiwan.net/poem10826.html","الكامل"],[50,"قل للعذول بحانة الخمار","https://www.aldiwan.net/poem63293.html","الكامل"],[50,"فدتك نفسي يا أبا جعفر","https://www.aldiwan.net/poem63326.html","السريع"],[50,"أفناني الدهر نهسا","https://www.aldiwan.net/poem64323.html","الخفيف"],[48,"هل يأمن الفتيان الخطب آونة","https://www.aldiwan.net/poem23393.html","البسيط"],[8,"فمن يك سائلا عني فإني","https://www.aldiwan.net/poem21851.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[124,"تبغي حياة لا تحس صروفها","https://www.aldiwan.net/poem49292.html","الكامل"],[164,"شكوى الهدى وتعلق الإسلام","https://www.aldiwan.net/poem59211.html","الكامل"],[240,"ولقد مدحتك يا ابن نصر مدحة","https://www.aldiwan.net/poem31771.html","الكامل"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[343,"قدر الله كائن","https://www.aldiwan.net/poem68635.html","مجزوء الخفيف"],[409,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[415,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.aldiwan.net/poem32447.html","الطويل"],[445,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[463,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[463,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[463,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[469,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[520,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[580,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37736","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37837","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77595","الرجز"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61098","المجتث"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19988","البسيط"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35738","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79912","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1700,"","https://poetry.dctabudhabi.ae/diwan/poem/105577","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100460","المتقارب"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101433","المجتث"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100112","السريع"],[3207,"","https://poetry.dctabudhabi.ae/diwan/poem/144656","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140032","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35884","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91306","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85240","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114321","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111458","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77167","الكامل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138823",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33367","البسيط"],[4856,"قمر مسافر/لضياء عواد","https://www.poetsgate.com/ViewPoem.aspx?id=35880",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5809,"عجب","https://www.poetsgate.com/ViewPoem.aspx?id=205365",""],[5906,"الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=188217",""],[6068,"رَأَيْتُ الْشَّوْق يأكُلُ مِن عِقَاليِ -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175789",""],[6068,"قَدْ جُزْتُ بالسلفيّ عَادِلْ -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175812",""],[6124,"شيطان","https://www.poetsgate.com/ViewPoem.aspx?id=159876",""],[520,"يا اكرم الناس وجها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577477",""]],"verses":[["فَاِردُد لَنا عَهدَ الإِما","مِ وَكُن بِنا الرَجُلَ المُفَدّى",0,"د",2,0],["فأردتُ تجديدَ العهود وإنما","كتبَ المشيبٌ على عذاري لالا",1,"ل",2,0],["فَأَردِف مِثلَها نُصحاً قُرَيشاً","مِنَ الرَحمَنِ إِن قَبِلَت نَذيري",2,"ر",2,0],["فأردتُ اقتصاص حالي فلمْ أُلْ","قِ إلى غيرهِ من القول بالا",3,"ل",2,0],["فَأَردَينا المُلوكَ بِكُلِّ عَضبٍ","وَطارَ هَزيمُهُم حَذَرَ اللَحاقِ",4,"ق",1,0],["فارْدُدْ إليك نجيعَها المُهْراق إنْ","كان النجيعُ يُرَدُّ بعدَ جُمود",5,"د",1,0],["فَأَرَدتَ إِفهامي فَقَد أَفهَمتَني","وَصَدَقتَ فيما قُلتَ غَيرَ مُحابي",6,"ب",2,0],["فَاِردُد أَمانَتَهُ عَلَيهِ وَدَينَهُ","وَاِحتَل لِذاكَ وَلَو بِبَيعِ إِزارِ",7,"ر",1,0],["فَاِردُدهُ تَردُد وَصلَها إِنَّها","قُرَّةُ عَيني يا أَبا جَعفَرِ",8,"ر",1,0],["فَاِردُد عَلَيَّ حَياتي","عَضّاً بِفيكَ وَلَحسا",9,"س",2,0],["فَاِردُد أُمورَكَ فيما أَنتَ فاعِلُهُ","إِلى نَقِيٍّ مِنَ الأَدناسِ عَلّامِ",10,"م",1,0],["فَأَردَفنا حَلِيلَتَهُ وَجِئنا","بِما قَد كانَ جَمَّعَ مِن هِجانِ",11,"ن",1,0],["فأردت إنهاضاً به لجماعة","كسلى لها في جهلها استغراق",12,"ق",1,0],["فأَردَتهُ ورَغبُ النَّفسِ يُردي","ويُبدي لِلفَتَى الَحينَ المُبينا",13,"ن",2,0],["فاردد على مكروهها النفس التي","ماتت وأنفاس لها لم تخمد",14,"د",1,0],["فأردت إنكارا عليه فقال لي","اقرأ نصوصهم وعد لملامي",15,"م",2,0],["فَاِردُد مُطَلَّقَةً إِلَيَّ مَدائِحي","فَطَلاقُ مَن هُوَ غَيرُ كَفؤٍ أَجمَلُ",16,"ل",1,0],["فأردى الممالك الملوك بفتكه","وظل يا رباب المناصب يلعب",17,"ب",1,0],["فأردعُها بالصبرِ والحلمِ والرِضا","وفيها خمارٌ زائلٌ بعدَ سَكرة",18,"ه",1,0],["فَأَرِد ما يَكونُ إِن","لَم يَكُن ما تُريدُهُ",19,"د",2,0],["فأردت أن أجري جوادي بعدكم","في نظم شيء يشبه التذبيلا",20,"ل",2,0],["فأردَاهُ فردُ الحُسن فرداً وإنّه","ليُرهِبُهُ من رَهطِ قَاتِلِه الرّهطُ",21,"ط",1,0],["فارْدُدْ زَفِيرَكَ عَمَّا لا مَرَدَّ لَهُ","وارْجِعْ دُمُوعَكَ عَمَّنْ لَيْسَ يُرْتَجَعُ",22,"ع",1,0],["فأُردِي كُلَيبٌ لحفظ الجوارِ","ورعيِ الذمارِ وصونِ الحريمِ",23,"م",1,0],["فاردد عليه كما يُحبُّ حبيبَهُ","ضخمَ السلامة ناحلَ الأجمال",24,"ل",1,0],["فأردَى ردائي وجاءت إلي","ك دُرَّاعتي تبتغي منكَ ثارا",25,"ر",2,0],["فارددْ على الريح أحاديثَها","ففي صِباها ناقلٌ كاذبُ",26,"ب",1,0],["فأرديةٌ خضرٌ ضواحكُ بالندَّى","إذا قطب السَّاري وأندية فيح",27,"ح",1,0],["فاردد علي مديحي","فلست أكره ردا",28,"د",2,0],["فأَرَدْتُ أًعْقِلَه ففرَّ من الحَشَا","طرباً وأَحبسُه فطار من الفَرحْ",29,"ح",1,0],["فَاِرْدَعْ لِمَنْ ضاهاهُ في نَيْلِ العُلى","بِغَلاظةٍ فَمِثالُهُ لَنْ يوجَدا",30,"د",2,0],["فَأَردتُ تاريخَ العِذارِ فقيلَ لي","هَل يَنبَغي تاريخُه وَتَأرّخا",31,"خ",2,0],["فَأَردَف اِبنَه وَراءَ ظَهره","وَالجَحش راحَ آخِذاً في سَيره",32,"ه",1,0],["فاردد علي فُؤادي","يا أَمطل الناس دينا",33,"ن",2,0],["فأردت أوضح بعضها فوجدتها","مثل الدراري لا تريد فريدا",34,"د",2,0],["فَاِردُد جُفونَكَ حَسرى عَن أَبي دُلَفٍ","وَلا مَلامَةَ أَن تَعشى عَن القَمَرِ",35,"ر",1,0],["فَأَردى عداهُم بِالرُدَيني طاعِناً","وَكُلُّ رَهيفِ الحَدِّ لِلضَّربِ باتِرِ",36,"ر",1,0],["فاردُد أحاديث الصَبا إن كنَّ لم","يَروين عن شمائلٍ منه الشذا",37,"ذ",2,0],["فاردُد عليها من أحاديثها","ما نقلتهُ عن خُزاماها",38,"ا",3,0],["فأرداهم صرعى وفلق هامهم","همام بماضيه تفل القواضب",39,"ب",1,0],["فأردى بعبد الرشيد الذي","تسامى علاه فعز مثيلا",40,"ل",2,0],["فَاردُدْ عَليَّ مَنامي","فَلا سُلِبْتَ مَنَامَكْ",41,"ك",1,0],["فاردد علي الروح يا سيدي","فاليوم دنيا وغداً آخره",42,"ه",1,0],["فاردد عليّ بنجدٍ ضيعة قبضت","فإن مثلك مثلي يقطع الضيعا",43,"ع",2,0],["فأردتُ أن أنجو بنفسي هارباً","ووثبتُ عند الباب وثبةَ جازعِ",44,"ع",1,0],["فأردفه العباسُ ثم أتى به","مهيباً يخافُ الذنب أو يرتجي العُرفا",45,"ف",2,0],["فأُرَدّ والأوهامُ تَعتِب فكرتي","فأرى الفتور عن المديح جُناحا",46,"ح",2,0],["فاردفوا كل مأوى الحب وانعطفوا","نحو الذي مات حباً في خلاصهمِ",47,"م",1,0],["فَأَرداهُ ذَلِكَ حَتّى مَضى","صَريعاً وَأَصبَحَ في مَلحَدِ",48,"د",1,0],["فَاردد فؤادَك ما استطعتَ وَلا تَكُن","تَهوى مَليكاً بِالجَمال تَغلّبا",49,"ب",2,0],["فأرداهم بالبيض والسمر إذ أتوا","يقودهم للحتف من ليس مرشدا",50,"د",2,0],["فَاردُد مَنَامِي لِكَي أرَجِّي","وَصلَكَ بِالجَامِعِ الخَيَالِي",51,"ي",1,0],["فَأَرداهُ طِفقيرُ بِالأُذُنِ","وَجَرَّ القَناةَ وَلَم يَنثَنِ",52,"ن",1,0],["فَأَردى مَنَستِيساً ونَخيَالُساً معاً","بِمَركَبَةٍ قَلَّتهُما وَهوَ سائِرُ",53,"ر",1,0],["فَاردُد بِفَضلِكَ ما أَخَذت وَعد ذا","أَتقى وَأَبقى لِلجَميل وَأَحزَما",54,"م",2,0],["فأرداه سهمُ الرَّدى فانثنى","له بالثنا لهجةٌ واعتبار",55,"ر",1,0],["فاردُد على من ملكتَ منها","فعبدُ غيابكَ الخضوعُ",56,"ع",1,0],["فأَردُ بعدَ تمهلٍ","وأَقولُ قَدْ أمرَ القَدَرْ",57,"ر",1,0],["فأردى الذي قد شق بالسيف رأسه","وفرق عنه الفيلق المتزاحما",58,"م",2,0],["فأردّ عن أمي وقد عميت","ليلاً عصيّ الصبح مضطربا",59,"ب",2,0],["فأردتُ ان أغدو كيوسفَ كاظماً","للغيظ حين أسرَّها في نفسهِ",60,"س",2,0],["فَارْدَعْ ضَميرَكَ إنْ حادَتْ مَكارِمُهُ","حَتّى يُلامِسَ روحَاً مِنْهُ تَنْهَمِلُ",61,"ل",1,0],["فَأَرْدَاه الْجَبِين وكَان قَبْلًا","يُعَجِّزُه سُدًى دَاءُ الْعضَالِ",62,"ل",1,0],["فَأَرَدْتُ أَسْأَلُهُ سُؤَالًا","قَدْ كُنْتُ أُخْفِيهِ بحائلْ",63,"ل",1,0],["فأردُّ الوسوسةَ سرابًا","بين حرائقِ وجداني.",64,"ي",1,0],["فاردد على مديحي","فلست أكره ودا",65,"د",2,0]]}