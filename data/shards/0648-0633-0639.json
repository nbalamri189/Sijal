www.aldiwan.net/poem3490.html","عموديه"],[480,"طلع الصباح فأشرقت","https://www.aldiwan.net/poem36930.html","مجزوء الكامل"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[480,"ذمم تباع وتشترى","https://www.aldiwan.net/poem37604.html","مجزوء الكامل"],[480,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[491,"وسعد لو دعوتهُمُ لثابوا","https://www.aldiwan.net/poem652.html",""],[510,"كل شيءٍ مصيره للزوال","https://www.aldiwan.net/poem744.html","الخفيف"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[516,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[516,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[552,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[559,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[559,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"],[559,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[559,"يا بديع الحسن بالصور","https://www.aldiwan.net/poem34536.html","المديد"],[559,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[559,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[563,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[576,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[576,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[576,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"],[576,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"]],"verses":[["وَسِعتُ أَيّامي وَلَم تَسعَني","أَفضَلُ عَنها وَتَضيقُ عَنّي",0,"ن",2,0],["وَسَعى بِالْكَأْسِ مُتْرَعَةً","كَضِرامِ النَّارِ تَلْتَهِبُ",1,"ب",1,0],["وسَعَتْ لهُ خُطَطُ العدوِّ بغِلْمَةٍ","شوسٍ إذا ابْتَدَروا الوَغى ضاق الفَضا",2,"ض",2,0],["وسَعَيْتُ للعَلْياءِ حتّى أيْقَنَتْ","أنّ الأوائِلَ سَعْيُهُمْ تَضْليلُ",3,"ل",1,0],["وسُعَاةٍ ذَوِي اجْتِدَاءٍ وَإِلْحَا","فٍ شَدِيْدٍ يَأْتُونَ بَعْدَ العِشَاءِ",4,"ا",2,0],["وَسِعَ الْكُلَّ مِنْكَ خُلْقٌ جَمِيلٌ","وَجَنَابٌ لِلْفَضْلِ رَحْبُ الفِنَاءِ",4,"ا",2,0],["وَسَعى لِكِندَةَ غَيرَ سَعيِ مُواكِلٍ","قَيسٌ فَضَرَّ عَدُوَّها وَبَنى لَها",5,"ل",3,0],["وَسَعدٌ وَكَعبٌ وَالعِبادُ وَطَيِّئٌ","وَدودانُ في أَلفافِها وَالأَراقِمُ",6,"م",1,0],["وَسَعيدٌ وَكانَ غُصناً نَدِيّاً","فُتِّحَت فيهِ زهرَةُ الآمالِ",7,"ل",1,0],["وَسَعى كُلُّ اِمرِئٍ مُفضِلٍ","بادِيَ الأَحزانِ مَخفوضَ النَظَر",8,"ر",1,0],["وَسِعتُ كِتابَ اللَهِ لَفظاً وَغايَةً","وَما ضِقتُ عَن آيٍ بِهِ وَعِظاتِ",9,"ت",1,0],["وَسِعَ الفَضلَ كُلَّهُ صَدرُكَ الرَح","بُ فَمَن شاءَ فَليُهَنِّئ وِسامَه",10,"م",2,1],["وَسَعى إِلَيَّ بِصَرمِ عَزَّةَ نِسوَةٌ","جَعَلَ المَليكُ خُدودَهُنَّ نِعالَها",11,"ل",3,0],["وَسِعَ الأَمَانِيَّ الَّتِي تَلْهُو بِهَا","هَلْ مِنْ تَجَارِيبِ الصُّرَوفِ أَمَانُ",12,"ن",1,0],["وسعوا فرادى للنجاح وفاتهم","أن التضامن رائد العمران",13,"ن",1,0],["وسعى يَحُوطك بالصوارم طائعاً","لزعيمه العالي الرشيد ومذعنا",14,"ن",2,0],["وسعَوْا لمنفعة الأجانب سعيةً","شنعاء كادت أن تُعدّ تجنٌّنا",14,"ن",2,0],["وَسَعدٌ إِذا صاحَ العَدُوُّ بِسَرحِهِم","أَبَوا أَن يُهَدَّوا لِلصِياحِ فَأَزحَفوا",15,"ف",3,0],["وَسَعدٌ فَأَضحَوا في الجِنانِ وَأَوحَشَت","مَنازِلُهُم وَالأَرضُ مِنهُم بَلاقِعُ",16,"ع",1,0],["وَسَعدٌ كانَ أَنذَرَهُم نَصيحاً","بِأَنَّ إِلَهَهُم رَبٌّ جَليلُ",17,"ل",1,0],["وسعادة الدَّارين جلَّ أساسها","بمعاقد التقوى فجلَّ بقاؤه",18,"ا",3,0],["وسعت يراعتهُ بأرزاق الورى","فكأنها قُلُبٌ وتلك رِشاء",19,"ا",2,0],["وسعد أفاد الملك أخبية الهنا","وأنحى على أهل المكايد بالذبح",20,"ح",1,0],["وسعتَ الناسَ إنصافاً وبرّاً","وإفضالاً فهم لك كالعيالِ",21,"ل",1,0],["وَسعَ الأنامَ ربيعُ فضلِك كلَّهم","حتى لقد لحقَ الهزيل السامنا",22,"ن",2,0],["وَسَعَوا إِلى سَلبِ القَناةِ فَأَخفَقوا","سَعياً وَشاءَ اللَهُ أَن تُخفَقا",23,"ق",2,0],["وسعى وراءَ مواكبِ الأَيَّامِ","ولَرُبَّ صُبْحٍ غائمٍ متحجِّبٍ",24,"ب",1,0],["وسَعَى فيهِ مُهْرَهُ","عَادِياً ثمَّ أعْنَقا",25,"ق",2,0],["وسَعادةُ الضَّعفاءِ جُرْمُ ما لهُ","عند القويِّ سوى أشدِّ عِقابِ",26,"ب",1,0],["وسَعادةُ النَّفسِ التَّقيَّةِ أنّها","يوماً تكونُ ضحيَّةَ الأربابِ",26,"ب",1,0],["وسعدت العب فوق ارضك ناشئا","وشقيت شيخا لا يطيق قياما",27,"م",2,0],["وسعاد تمشي بين أتراب لها","كالبدر في وسط النجوم اللمَّع",28,"ع",1,0],["وسعدي الذي خان الزمان وطالعي","وفخري إذا ألقى الرجال وإجلالي",29,"ل",2,0],["وَسَعى فَقَصَّرَ عَن مَداهُ في العُلى","أَهلُ الزَمانِ وَأَهلُ كُلِّ زَمانِ",30,"ن",1,0],["وَسُعادٌ غَرّاءُ فَرعاءُ تَسقي","كَ عُقاراً مِنَ الثَنايا البُرادِ",31,"د",1,0],["وَسَعيِي لَوَجهِ اللَهِ في نَصرِ أَحمَدٍ","نَبيِّ الهدى المَحمودِ طِفلاً ويافِعاً",32,"ع",2,0],["وَسِعَ الناسَ بِخُلقٍ حَسَنٍ","لَم يَضِق شَيءٌ عَلى حُسنِ الخُلُق",33,"ق",1,0],["وَسِعَ الخَلقَ قُدرَةً فَجَميعُ ال","خَلقِ فيها مُحَدَّدٌ مَوزونُ",34,"ن",1,0],["وَسَعَيتَ السَعيَ الحَنيفَ وَكَم قَد","جُزتَ في المَكرُماتِ سَعيَ السُعاةِ",35,"ه",1,0],["وَسَعى إِلَيكَ فتى سَلامَ مُسَلِّماً","طَوعاً وَجاءَ مُسَلِّماً سَلمانُ",36,"ن",1,0],["وسعادةٍ شردت وعز منالُهَا","فقنصتُها في نشوةِ الأحلامِ",37,"م",1,0],["وسعادةٌ لو أنّها جُعِلتْ على","هَرِمٍ لعادَ إلى الشّبابِ الأوّلِ",38,"ل",1,0],["وَسعَى بِأَرضِكَ واضِعاً فَمَهُ على","تُرْبٍ بأفواهِ الملوكِ مُقَبَّلِ",38,"ل",1,0],["وَسِعَ البسيطةَ عَدْلُهُ وتضاعفَتْ","عَن طولهِ الآمالُ وهي فساحُ",39,"ح",1,0],["وَسَعَت إِلَيكَ جُنودُها حَتّى إِذا","وافَتكَ خَرَّ لَدَيكَ كُلُّ مُقَلَّدِ",40,"د",1,0],["وسعيٌ بلا رجلٍ وبطشٌ بلا يدٍ","وحقدٌ بلا قلبٍ وأكْلٌ بلا ثغرْ",41,"ر",1,0],["وسعدُ أعاديه عنْ مركزِ ال","سعادةِ تلجي إلى زاويَهْ",42,"ي",2,0],["وَسِعْتَ عَدوَّكَ الموتورَ حِلماً","ومكرمةً على ضيقِ المجالِ",43,"ل",1,0],["وَسِعَ الكُتْبَ جميعاً وَوَعَى","مِن سَناها كلَّ معنىً مونِقِ",44,"ق",1,0],["وَسِعَتْ جِفانَ المُطعمين جفانُه","كرماً فما يأبى ولا هِيَ تبخلُ",45,"ل",1,0],["وَسَعيد مَن نالَ مثل سَعيدٍ","بَعد دار الفَناء دار الخُلودِ",46,"د",1,0],["وَسِعَ الشَيبَ النُهى","فَأَصابَ مَنزِلا",47,"ل",2,0],["وَسِعَ العَالَمِين عِلْمَاً وَحِلْمَاً","فهْوَ بحرٌ لم تُعْيِهِ الأَعبَاءُ",48,"ا",2,0],["وسِعَ العَالَم عِلمَاً وجُودا","فدعا كُلّا وأَرْضَى خِطابا",49,"ب",2,0],["وَسَعَتْ له الأحجارُ فهْيَ لأَمرِه","تأْتي إليه كما يشاءُ وتَذْهَبُ",50,"ب",1,0],["وَسَعْيُكَ مَقْبُولٌ وَسَعْدُكَ مُقْبِلٌ","وَكُلُّ مَرامٍ رُمْتَ فَهْوَ مُيَسَّرُ",51,"ر",1,0],["وَسَعيُ وُشاةِ الناسِ بَيني وَبَينَها","بِما لَيسَ فيهِ لِلوُشاةِ نَصيبُ",52,"ب",1,0],["وسع الغربَ ولما","يسع الشرق رقيُّ",53,"ي",1,1],["وَسعوداً لبستهنَّ خفافاً","وَنحوساً حملتهنَّ ثقالا",54,"ل",2,0],["وَسعى العَشيرة كلهم في حملها","للقبر آخر منزل الإنسان",55,"ن",1,0],["وَسعت سماء للعوا","لم من طرائقها مجاري",56,"ر",2,0],["وسَعَّرَ أنفاسي فأطلقتُ نارَها","على الظالِمِ الجبَّار صَوْتَ وعيدِ",57,"د",1,0],["وَسَعَى إِلَيَّ الْحِلْمُ فِي أَثْوَابِهِ","طَرِبَاً وَآنَ لِجَهْلِيَ الإِقْصَارُ",58,"ر",1,0],["وَسَعْدُكِ فِي الأَمْثَالِ سَارَ وَلَمْ يَكُنْ","لَهُ فِي سُعُودِ المَالِكِينَ مَثِيلُ",59,"ل",1,0],["وَسِعَتْ أُمُّ الْقُرَى ذَاكَ الّذي","عَقَّهَا حَمْداً كَمَا لَوْ كَانَ بَرَّا",60,"ر",2,0],["وَسَعْدق أَبَاهُ السّاعِديُّ وَمُنْذِرٌ","لأنفِكَ إنْ حَاوَلْتَ ذلكَ جَادِعُ",61,"ع",1,0],["وسعدٌ أَخو عمرِو بنُ عوفٍ فإنّهُ","ضَرُوحٌ لِمَا حَاوَلْتَ مِ الأَمْرِ مَانِعُ",61,"ع",1,0],["وسعوا به فإذا الهزار مقفصٌ","والبوم منطلق الجوانحِ يلعبُ",62,"ب",1,0],["وسع الديانات السما","ح وضم أشتات الندوب",63,"ب",1,0],["وَسِعَ اللَهُ رَحمَةً كُلّ شَيءٍ","وَجَبَ العَفوُ مِنهُ وَالإِنعامُ",64,"م",1,0],["وسَعْيث كَبِيرِ النَّفْسِ مُكْبِرٌ","وسَعْيُ صَغيرِ النَّفْسِ مُخضِع",65,"ع",1,0],["وَسَعَى الْهِلالُ إِلى الصَلِيبِ","وَأقْبَلاَ جَنْباً فَجَنْبَا",66,"ب",2,0],["وَسَعَتْ صَوْبَ هَمْسِهَا كُلُّ حَوْرَا","ءَ تُدَانِي رَأْساً وَتَعْطِفُ جِيدَا",67,"د",2,0],["وسعيدٌ في كلِّ حال سعيدٌ","يكرمُ الفنُّ ربَّه حيث كانا",68,"ن",2,0],["وَسَعى فَقَصَّرَ عَن مَداهُ في العُلا","أَهلُ الزَمانِ وَأَهلُ كُلِّ زَمانِ",69,"ن",1,0],["وسعوا إلى سلب القناة فأخفقوا","سعيا، وشاء اللّه أن لا تخفقا",70,"ق",2,0],["وسعى على تشتيت عصبة شملنا","وقضى الإله بفصل جمعة شمله",71,"ل",2,0],["وسعت لغات الريح والبحر خبرةً","وكل شهابٍ لامعٍ الخفقان",72,"ن",1,0],["وسعيُكَ مشكورٌ وقلبك ثابِتٌ","وكسبُكَ في العَلْيَاءِ خير المكاسِبِ",73,"ب",1,0],["وسعد السعودِ التاح ثامن عشره","بِواحدِ غُشتٍ سعد الأخبيةِ اذكروا",74,"ر",3,0],["وَسِعَ المُوالي والمُعادِي حُكمُهُ","في كُلِّ أرضٍ رَحمَةً وَعَذابا",75,"ب",2,0],["وسعادةٌ عجبٌ تهدُّ قوى العدا","هداً وتقصِمُ منهمُ الأصلابا",75,"ب",2,0],["وسعى لك الإسعادُ حيث سعيت في","مرضاة ربكَ وهو أصبح راحما",76,"م",2,0],["وَسَعى سَعيَ أَوَّليهِ فَأَربى","بِاِختِيارِ الفَضائِلِ الأَعقالِ",77,"ل",1,0],["وسعدوا وارفاداً وفيضا وسؤددا","وعلما وتوفيقا به يطرد الصد",78,"د",1,0],["وسعادة تبدو دلائلها","منه على الإبرام والنقض",79,"ض",1,0],["وسعدّكَ جند قد كفى جندك العدى","وعنهم تولى الطعن والضرب والرميا",80,"ي",2,0],["وسعدُك قد أبقى الظبا في غمودها","فما كل عما قام فيه ولا أعيا",80,"ي",2,0],["وسعدك قد ألجا إلى قتله له","لتحرز أنت المال عن ذلك الخلف",81,"ف",1,0],["وسعادةٌ أغنتك عن ضربِ الطلا","وطراد فرسانٍ وطَعنُ كماةِ",82,"ه",1,0],["وسعى ولون كل قبح لم يكن","يا ما جرى من كيده ياما جرا",83,"ر",2,0],["وسعى فلم يك إذ سعى متثبطا","ورما فلم يك حين يرمي مقصرا",83,"ر",2,0],["وسع الأنام وكل قطر ضيق","فمتى نزلت به وجدت مقيلا",84,"ل",2,0],["وسعنا الورى حلما وجودا فمذنب","يقابل بالحسنى ومنتحل يعطى",85,"ط",2,0],["وسعيرُ لا جَدوى سَقاكَ أوارَهُ","وتمنَّعَتْ عَنْ وَصْلِكَ التأساءُ",86,"ا",2,0],["وسعوده لا كالسعو","د ونحسه أدنى فعاله",87,"ل",2,0],["وَسَعدٌ أبو قيسٍ أخو الجودِ لم تزل","تدورُ معَ المختارِ جفنتهُ الغرّا",88,"ر",2,0],["وَسَعيدٌ عُبيدةٌ حمزة المر","غمُ أنفَ الضلال منه اِهتداءُ",89,"ا",2,0],["وسعدك في مسراك ولد نصرة","وشكلك فيه دل انك ظافر",90,"ر",1,0],["وسعدك هل عاشره وهذا","لعمري بيت افراح ونصر",91,"ر",1,0],["وسعود سعيك في الولاية أسفرت","بين الأنام فم