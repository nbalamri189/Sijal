{"poems":[[53,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[93,"علام يقام تمثالي","https://www.aldiwan.net/poem9164.html","مجزوء الوافر"],[54,"آل الرسول مصابيح الهداية","https://www.aldiwan.net/poem27438.html","البسيط"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[45,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[28,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[66,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[66,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[44,"لي حبيب عصيت فيه النصيحا","https://www.aldiwan.net/poem30271.html","الخفيف"],[44,"كذا فليجل الخطب وليفدح الأمر","https://www.aldiwan.net/poem30313.html","الطويل"],[87,"ليس لي غير خالك الحجر الأسود","https://www.aldiwan.net/poem8351.html","الخفيف"],[105,"هنيئا أبا سفيان لا الذخر هين","https://www.aldiwan.net/poem44032.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[102,"قد فهمنا من الهدية معنى","https://www.aldiwan.net/poem33001.html","الخفيف"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"وغرس من الأحباب غيبت في الثرى","https://www.aldiwan.net/poem26940.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[46,"بقائي الطويل وغي البسيط","https://www.aldiwan.net/poem22777.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[77,"أنورُ سناءَ لاحَ في مشْرِق الغرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33315",""],[115,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[115,"نقشت في جبينها والمحيا","https://www.aldiwan.net/poem41658.html","الخفيف"],[115,"روحي وأرواح الوجود","https://www.aldiwan.net/poem42166.html","مجزوء الكامل"],[124,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[132,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[137,"أم سلام لو لقيت من الوجد","https://www.aldiwan.net/poem67967.html","الخفيف"],[143,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[143,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[150,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[150,"صبوت إلى الدنيا وذو اللب لا يصبوا","https://www.aldiwan.net/poem68604.html","الطويل"],[160,"إِذا حسدا مالت عن الصاحب الصحب","https://www.aldiwan.net/poem58822.html","الطويل"],[186,"تذكرت من كسرى بن ساسان عهده","https://www.aldiwan.net/poem43698.html","الطويل"],[235,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[270,"تمرين يا ذات الملاء المزيل","https://www.aldiwan.net/poem35579.html","الطويل"],[280,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[285,"ما ترقى الهند إلا","https://www.aldiwan.net/poem39377.html","مجزوء الرمل"],[320,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem67108.html","الكامل"],[349,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[364,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[365,"فاتنا بدر وأحد","https://www.aldiwan.net/poem44375.html","مجزوء الرمل"],[365,"ديار أقفرت من أم سلمى","https://www.aldiwan.net/poem44528.html","الوافر"],[377,"يا قلب مريم بابن الله منطبعا","https://www.aldiwan.net/poem59335.html","البسيط"],[377,"أرى الشيطان يرمينا بحرب","https://www.aldiwan.net/poem66941.html","الوافر"],[380,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[394,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[405,"أبلغ مقالي كل عاف مجتدي","https://www.aldiwan.net/poem49603.html","الكامل"],[416,"برح الشوق أصيحابي بي","https://www.aldiwan.net/poem53962.html","الرمل"],[416,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[432,"أودعت نسج الملح","https://www.aldiwan.net/poem12783.html","مجزوء الرجز"],[439,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[441,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[449,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[458,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[458,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[461,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[461,"الحمد لله كان المجد مقتسما","https://www.aldiwan.net/poem15415.html","البسيط"],[461,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[464,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[479,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[515,"لك يبق نوع تقتضيه كرامة","https://www.aldiwan.net/poem12088.html","الكامل"],[515,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[538,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[551,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[558,"تأمل فما فات شيء أتى","https://www.aldiwan.net/poem34704.html","المتقارب"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[575,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"]],"verses":[["فَآثارُهُ مُحمَرَّةٌ في عَدُوِّهِ","وَمِنهُ وَراءَ التُربِ أَبيضُ قاضِبُ",0,"ب",1,0],["فَأَثْقَلَ أَكْتَاداً وَعَمَّ حَقَائِباً","وَأَنْهَل ظِمْئاً نَبْعَ مُطَّرِدٍ عَذْبٍ",1,"ب",1,0],["فَأَثمَرَ وَحشَةً بَلَغَت مَداها","وَزَكّاها بِأَربَعَةٍ شُهودِ",2,"د",1,0],["فأثواني بمثوى من","ه لا دان ولا عال",3,"ل",1,0],["فَأَثمَرَت خَيرَ أَهلِ الأَرضِ بَعدَهُما","أَعني الشَهيدَينِ ساداتِ البَرِيّاتِ",4,"ت",1,0],["فأثمر فيها النصلُ نصراً مؤزّراً","وأجنى قطاف الفتح غضَّاً ودانيا",5,"ي",2,0],["فأثبتَّهُ لما استقاد وقد دنت","ظُباتُ السيوف من مَناط القلائدِ",6,"د",1,0],["فَاِثلِج بِبَردِ الدَمعِ صَدراً واغِراً","وَجَوانِحاً مَسجورَةَ الرَمضاءِ",7,"ا",2,0],["فَأَثقِل عَلَينا بِالمَشيبِ مُسَلِّماً","وَأَحبِب إِلَينا بِالشَبابِ مُوَدِّعا",8,"ع",2,0],["فَأَثرى بِهِ مِن بَعدِ بُؤسِ عَديمُها","وَعَزَّ بِهِ مِن بَعدِ خَوفٍ ذَليلُها",9,"ل",3,0],["فَآثَرتُهُ لَمّا رَأَيتُ الَّذي بِهِ","عَلى القَومِ أَخشى لاحِقاتِ المَلاوِمِ",10,"م",1,0],["فَاِثنِ جيداً عَنهُ وَثَنِّ بِما يو","جِبُ إِبعادَهُ بِغَيرِ اِحتِرامِ",11,"م",1,0],["فَأَثَروا فَوقَها رُسوماً","كَأَنَّها الطُرُقُ في الجِبالِ",12,"ل",1,0],["فَأَثِبني مِنَ القَطيعَةِ بِالوَص","لِ وَإِلّا فَاِردُد فُؤادي صَحيحا",13,"ح",2,0],["فَأَثبَتَ في مُستَنقَعِ المَوتِ رِجلَهُ","وَقالَ لَها مِن تَحتِ أَخمُصِكِ الحَشرُ",14,"ر",1,0],["فَأَثِبْنِي عَلَى الْجَمَالِ زَكَاةً","وَزَكَاةُ الْجَمَالِ فِي الْخَدِّ قُبْلَهْ",15,"ه",1,0],["فآثرتَ هَذِي ثمَّ ألقيتَ بالتي","حَمَلْتَ وما في الحقِّ أن يُؤثَرَ الدُّونُ",16,"ن",1,0],["فآثرتَ الهزيمة والرجوعا","وجاء غُويرِثٌ يبغي الرسولا",17,"ل",2,0],["فَأَثارَت ذِكرى وَهاجَت جِراحاً","تَرَكتني مِن الصَبابات مضنى",18,"ن",2,0],["فَآثَرَ الحَياةَ وَالهَوانا","وَما هَدا حَتّى رَأى الأَمانا",19,"ن",2,0],["فَأَثمَرَ هَمّاً لا يَبيدُ وَحَسرَةً","لِقَلبِيَ تَجنيها بِأَيدي الخَواطِرِ",20,"ر",1,0],["فأَثِبْ خاطِراً يَلَذُّ له مَدْ","حُك عِلْماً بأَنه اللَّأْلاءُ",21,"ا",2,0],["فأثْقَبُ منها نارُ زَنْدِكَ للقِرى","وأشهرُ منها ذِكرُ جودك في الورى",22,"ر",2,0],["فَإِثنِ عَلى اللَهِ تُعطَ الثَوابَ","وَإِلّا فَكَم مادِحٍ لَم يُجَز",23,"ز",1,0],["فأثارهم طمعٌ هناك فهاجَموا","مثل الذئاب تعيث في الحملان",24,"ن",1,0],["فآثرت العوالي في المعالي","وآثرت الصلادم في الصلادِ",25,"د",1,0],["فأثقل أكْتاداً وعمَّ حقائباً","وأنْهَلَ ضَيْماً نبعَ مطّرِدٍ عذب",26,"ب",1,0],["فاثرت الزمان علي طيشا","وقد ابقيتني رهن الخمام",27,"م",1,0],["فأثبني منها وصالاً وجدلى","برضاء واجعلني عنك رضيا",28,"ي",2,0],["فاثابهم نيل المرا","د بحل سلسلة القيود",29,"د",1,0],["فأثار مختلف الشجون","بخافق ورع أَناب",30,"ب",1,0],["فَاثنِيَا واكفُفَا المَلاَمَةَ عني","واعذُرَا في الصِّبَا ولُومَا المَلُومَا",31,"م",2,0],["فَأَثيبي بِالوُدِّ صَبّاً عَميداً","مُستَهاماً لَم يَشجُهُ ما شَجاكِ",32,"ك",1,0],["فَاِثنِ المَلامَةَ في فِراقٍ بالِغٍ","بِأَبي عَلِيٍّ أَشرَفَ العَلياءِ",33,"ا",2,0],["فَأَثمَرَ ظَنُّنا صِدقاً وَحَقّاً","وَأَثمَرَ ظَنُّهُم مَيناً وَبُخلا",34,"ل",2,0],["فآثارُهُ أَنوارُها تَتَبلَّجُ","هُوَ الطاهِرُ المُختارُ مِن كُلِّ طاهِرٍ",35,"ر",1,0],["فَأَثنِ عَلَيهِ بالسَخاءِ وَبالحَيا","وَبالصَبر يَومَ البأسِ إِن كُنتَ مُثنيا",36,"ي",2,0],["فأثنى عليه والهوى قد أصمّه","وأعماه عما الخسر عقباه والتبُّ",37,"ب",1,0],["فآثرت يوما حلت الشمس منزلا","به وقفت ثم انثنت تطلب العكس",38,"س",1,0],["فَأَثرَيتُمُ مِن بَعدِ دَهرٍ وَضيقَةٍ","وَأَخصَبتُمُ مِن بَعدِ جَدبٍ وَإِمحالِ",39,"ل",1,0],["فأثَّرَ فيها صوتُه وبكت لهُ","وقالت حبيبي اليومَ في مُهجتي انزل",40,"ل",1,0],["فَأُثْنِي عَلى الْعِيسِ الْعِتاقِ لِقَصْدِهِ","بِما جَلَّ مِنْ فِكْرِي وَما دَقَّ مِنْ فَهْمِي",41,"ي",1,0],["فأثار الروح بل جد","دها من عهد هود",42,"د",1,0],["فَاِثبِت جَواكَ وَلا تُحاوِل كَتمَهُ","وَاِشرَح هَواكَ فَكُلُّنا عُشّاقُ",43,"ق",1,0],["فَأَثبَتُ في مَحوِ العَيانِ عَيانُها","بِنَفيِ حُدودِ الأَينِ في حالِ رؤيَتي",44,"ي",1,0],["فأثِرْها حاكياتٍ في الفَلا","حينَ يَعْصِفُنَ نُعامَى أو نَعاما",45,"م",2,0],["فاثْنِ العِنانَ إلى رحيبِ فِنائه","من دونِ أَفنيةِ الملوكِ الصِّيد",46,"د",1,0],["فاثبتوا للقوم ضرباً","بسيوفٍ حارثيّه",47,"ي",2,0],["فأثكلنا الحَلِيلَةَ من بَنِيها","وخَلَّينا الخَرِيدَةَ للنكاحِ",48,"ح",1,0],["فَأَثَّرَت فيه بالمعنى فضائلُه","فأَلَّفت بين مرئيٍّ ومسموعِ",49,"ع",1,0],["فَأُثْبُتْ يا مجاهدُ مستعدّاً","ترَ المولى يقيك من الذنوب",50,"ب",1,0],["فَأَثَرت في جيدِهِ","بِأَحسن ذاكَ الأَثَر",51,"ر",1,0],["فأثارت كآبتي عجب النا","س وحاروا في سرّها المجهول",52,"ل",1,0],["فاثْنِ الرَّجاءَ إلى عُلاهُ فإنَّهُ","غَوثُ الرَّدي غَيْثُ الصَّدِي بَدرُ النَّدِي",53,"ي",1,0],["فأثرتُمْ بعدها وخَّادَةً","لَطَمتْ وجه الفيافي رتكا",54,"ك",2,0],["فأُثني عليه الخير حيًّا وميّتاً","وأشكره ما دمتُ حيًّا مذكرا",55,"ر",2,0],["فأُثْبِتَتْ خلالَهُ","محاسنٌ ما تنمحى",56,"ح",2,0],["فأَثَابَهُ الفتحَ القريبَ وبَعْدَهُ","تصدِيقُ رُؤْيَاهُ لأَوَّلِ عَامِ",57,"م",1,0],["فأَثبت لنا أَمرك الثاني نسير به","فأَنتَ منزله فينا وناسقه",58,"ق",2,0],["فاثأر لشعب جنى المستعمرون على","أرض له فغدت ملكاً لفجار",59,"ر",1,0],["فأثرناها رفيقَيْ عزمةٍ","شاكلتْ بينهما فاختلطا",60,"ط",2,0],["فأثرتُ منه أبا الشبول فمالت ال","أرماحُ تَدعَسُه على غاباتِها",61,"ت",3,0],["فأثوي صريعاً أو تجلَّى عجاجتي","بنصرٍ عن الأمر الذي أنا آمله",62,"ل",2,0],["فآثر اللّهُ أنْ يُحْوي مُفَرَّقهُ","بالجمع ما بين فخر التُّرك والعرب",63,"ب",1,0],["فأثبتَ الحقَّ والألبابُ طائرةٌ","من شيعة الحقِّ والمأمونُ ذوتهُم",64,"م",1,0],["فأثوابه جددٌ لا تزالُ ت","رفُ على سهلهِ والجدَد",65,"د",1,0],["فأثر هذا الانقلاب على الفتى","وقد ساقه إملاقه للمآزق",66,"ق",1,0],["فأثابني عن حمده الخلع التي","خلعت بحسرتها قلوب الحسد",67,"د",1,0],["فأثارت بعد السكون حراكاً","هزها منه شمأل وشمول",68,"ل",1,0],["فأثارَ في الأعمَاق حُزنا كَامِنا","قد عمَّمَ الأغوَار والأنجَادَا",69,"د",2,0],["فأثْكَلنِي طيبَ الحياةِ وضمّنِي","إلى جانبِ الأحزانِ من كلّ جانِبِ",70,"ب",1,0],["فأثبتني فيه من غير أن","أرى لي وجوداً سواه أتى",71,"ت",2,0],["فأثبت الذي رأى الإمارة","كانت من النبي بالإشارة",72,"ه",1,0],["فأَثكلَني الدَّهرُ الشبابَ وإِنَّما","أُطَاعِنُ من بعدِ الشَّبابِ بلا شَبَا",73,"ب",2,0],["فأَثقلُ بينٍ مرَّ بي خفَّ عنده","وأَصْعَبُ بُعْدٍ ذقْتُه صار هيِّنا",74,"ن",2,0]]}