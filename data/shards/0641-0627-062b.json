spx?id=128806",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5442,"سرى والدحى شوق إليه وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=114746",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[4480,"لَعَمْرِي وما دَهْرِي بِتَأْبِينِ iiهَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18228",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5660,"ما بَينَ ثائِرَةِ الرِّياحِ السَجسَجِ","https://www.poetsgate.com/ViewPoem.aspx?id=27724",""],[5725,"مابال حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177839",""],[6069,"ويدٍ بآل محمدٍ علقت","https://www.poetsgate.com/ViewPoem.aspx?id=105681",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6102,"الحب في الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=182875",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""]],"verses":[["فَآثارُهُ مُحمَرَّةٌ في عَدُوِّهِ","وَمِنهُ وَراءَ التُربِ أَبيضُ قاضِبُ",0,"ب",1,0],["فَأَثْقَلَ أَكْتَاداً وَعَمَّ حَقَائِباً","وَأَنْهَل ظِمْئاً نَبْعَ مُطَّرِدٍ عَذْبٍ",1,"ب",1,0],["فَأَثمَرَ وَحشَةً بَلَغَت مَداها","وَزَكّاها بِأَربَعَةٍ شُهودِ",2,"د",1,0],["فأثواني بمثوى من","ه لا دان ولا عال",3,"ل",1,0],["فَأَثمَرَت خَيرَ أَهلِ الأَرضِ بَعدَهُما","أَعني الشَهيدَينِ ساداتِ البَرِيّاتِ",4,"ت",1,0],["فأثمر فيها النصلُ نصراً مؤزّراً","وأجنى قطاف الفتح غضَّاً ودانيا",5,"ي",2,0],["فأثبتَّهُ لما استقاد وقد دنت","ظُباتُ السيوف من مَناط القلائدِ",6,"د",1,0],["فَاِثلِج بِبَردِ الدَمعِ صَدراً واغِراً","وَجَوانِحاً مَسجورَةَ الرَمضاءِ",7,"ا",2,0],["فَأَثقِل عَلَينا بِالمَشيبِ مُسَلِّماً","وَأَحبِب إِلَينا بِالشَبابِ مُوَدِّعا",8,"ع",2,0],["فَأَثرى بِهِ مِن بَعدِ بُؤسِ عَديمُها","وَعَزَّ بِهِ مِن بَعدِ خَوفٍ ذَليلُها",9,"ل",3,0],["فَآثَرتُهُ لَمّا رَأَيتُ الَّذي بِهِ","عَلى القَومِ أَخشى لاحِقاتِ المَلاوِمِ",10,"م",1,0],["فَاِثنِ جيداً عَنهُ وَثَنِّ بِما يو","جِبُ إِبعادَهُ بِغَيرِ اِحتِرامِ",11,"م",1,0],["فَأَثَروا فَوقَها رُسوماً","كَأَنَّها الطُرُقُ في الجِبالِ",12,"ل",1,0],["فَأَثِبني مِنَ القَطيعَةِ بِالوَص","لِ وَإِلّا فَاِردُد فُؤادي صَحيحا",13,"ح",2,0],["فَأَثبَتَ في مُستَنقَعِ المَوتِ رِجلَهُ","وَقالَ لَها مِن تَحتِ أَخمُصِكِ الحَشرُ",14,"ر",1,0],["فَأَثِبْنِي عَلَى الْجَمَالِ زَكَاةً","وَزَكَاةُ الْجَمَالِ فِي الْخَدِّ قُبْلَهْ",15,"ه",1,0],["فآثرتَ هَذِي ثمَّ ألقيتَ بالتي","حَمَلْتَ وما في الحقِّ أن يُؤثَرَ الدُّونُ",16,"ن",1,0],["فآثرتَ الهزيمة والرجوعا","وجاء غُويرِثٌ يبغي الرسولا",17,"ل",2,0],["فَأَثارَت ذِكرى وَهاجَت جِراحاً","تَرَكتني مِن الصَبابات مضنى",18,"ن",2,0],["فَآثَرَ الحَياةَ وَالهَوانا","وَما هَدا حَتّى رَأى الأَمانا",19,"ن",2,0],["فَأَثمَرَ هَمّاً لا يَبيدُ وَحَسرَةً","لِقَلبِيَ تَجنيها بِأَيدي الخَواطِرِ",20,"ر",1,0],["فأَثِبْ خاطِراً يَلَذُّ له مَدْ","حُك عِلْماً بأَنه اللَّأْلاءُ",21,"ا",2,0],["فأثْقَبُ منها نارُ زَنْدِكَ للقِرى","وأشهرُ منها ذِكرُ جودك في الورى",22,"ر",2,0],["فَإِثنِ عَلى اللَهِ تُعطَ الثَوابَ","وَإِلّا فَكَم مادِحٍ لَم يُجَز",23,"ز",1,0],["فأثارهم طمعٌ هناك فهاجَموا","مثل الذئاب تعيث في الحملان",24,"ن",1,0],["فآثرت العوالي في المعالي","وآثرت الصلادم في الصلادِ",25,"د",1,0],["فاثارته شربة النهر والغي","رة لله في رضا مصطفاها",26,"ا",3,0],["فآثر تم ما آثرت سنة الهدى","وغيرتم بالسيف ما الله ناقم",27,"م",1,0],["فأثقل أكْتاداً وعمَّ حقائباً","وأنْهَلَ ضَيْماً نبعَ مطّرِدٍ عذب",28,"ب",1,0],["فاثرت الزمان علي طيشا","وقد ابقيتني رهن الخمام",29,"م",1,0],["فأثبني منها وصالاً وجدلى","برضاء واجعلني عنك رضيا",30,"ي",2,0],["فاثابهم نيل المرا","د بحل سلسلة القيود",31,"د",1,0],["فأثار مختلف الشجون","بخافق ورع أَناب",32,"ب",1,0],["فَاثنِيَا واكفُفَا المَلاَمَةَ عني","واعذُرَا في الصِّبَا ولُومَا المَلُومَا",33,"م",2,0],["فَأَثيبي بِالوُدِّ صَبّاً عَميداً","مُستَهاماً لَم يَشجُهُ ما شَجاكِ",34,"ك",1,0],["فَاِثنِ المَلامَةَ في فِراقٍ بالِغٍ","بِأَبي عَلِيٍّ أَشرَفَ العَلياءِ",35,"ا",2,0],["فَأَثمَرَ ظَنُّنا صِدقاً وَحَقّاً","وَأَثمَرَ ظَنُّهُم مَيناً وَبُخلا",36,"ل",2,0],["فآثارُهُ أَنوارُها تَتَبلَّجُ","هُوَ الطاهِرُ المُختارُ مِن كُلِّ طاهِرٍ",37,"ر",1,0],["فَأَثنِ عَلَيهِ بالسَخاءِ وَبالحَيا","وَبالصَبر يَومَ البأسِ إِن كُنتَ مُثنيا",38,"ي",2,0],["فأثنى عليه والهوى قد أصمّه","وأعماه عما الخسر عقباه والتبُّ",39,"ب",1,0],["فآثرت يوما حلت الشمس منزلا","به وقفت ثم انثنت تطلب العكس",40,"س",1,0],["فَأَثرَيتُمُ مِن بَعدِ دَهرٍ وَضيقَةٍ","وَأَخصَبتُمُ مِن بَعدِ جَدبٍ وَإِمحالِ",41,"ل",1,0],["فأثَّرَ فيها صوتُه وبكت لهُ","وقالت حبيبي اليومَ في مُهجتي انزل",42,"ل",1,0],["فَأُثْنِي عَلى الْعِيسِ الْعِتاقِ لِقَصْدِهِ","بِما جَلَّ مِنْ فِكْرِي وَما دَقَّ مِنْ فَهْمِي",43,"م",2,0],["فأثار الروح بل جد","دها من عهد هود",44,"د",1,0],["فَاِثبِت جَواكَ وَلا تُحاوِل كَتمَهُ","وَاِشرَح هَواكَ فَكُلُّنا عُشّاقُ",45,"ق",1,0],["فَأَثبَتُ في مَحوِ العَيانِ عَيانُها","بِنَفيِ حُدودِ الأَينِ في حالِ رؤيَتي",46,"ي",1,0],["فأثِرْها حاكياتٍ في الفَلا","حينَ يَعْصِفُنَ نُعامَى أو نَعاما",47,"م",2,0],["فاثْنِ العِنانَ إلى رحيبِ فِنائه","من دونِ أَفنيةِ الملوكِ الصِّيد",48,"د",1,0],["فاثبتوا للقوم ضرباً","بسيوفٍ حارثيّه",49,"ي",2,0],["فأثكلنا الحَلِيلَةَ من بَنِيها","وخَلَّينا الخَرِيدَةَ للنكاحِ",50,"ح",1,0],["فَأَثَّرَت فيه بالمعنى فضائلُه","فأَلَّفت بين مرئيٍّ ومسموعِ",51,"ع",1,0],["فَأُثْبُتْ يا مجاهدُ مستعدّاً","ترَ المولى يقيك من الذنوب",52,"ب",1,0],["فَأَثَرت في جيدِهِ","بِأَحسن ذاكَ الأَثَر",53,"ر",1,0],["فأثارت كآبتي عجب النا","س وحاروا في سرّها المجهول",54,"ل",1,0],["فاثْنِ الرَّجاءَ إلى عُلاهُ فإنَّهُ","غَوثُ الرَّدي غَيْثُ الصَّدِي بَدرُ النَّدِي",55,"د",2,0],["فأثرتُمْ بعدها وخَّادَةً","لَطَمتْ وجه الفيافي رتكا",56,"ك",2,0],["فأُثني عليه الخير حيًّا وميّتاً","وأشكره ما دمتُ حيًّا مذكرا",57,"ر",2,0],["فأُثْبِتَتْ خلالَهُ","محاسنٌ ما تنمحى",58,"ح",2,0],["فأَثَابَهُ الفتحَ القريبَ وبَعْدَهُ","تصدِيقُ رُؤْيَاهُ لأَوَّلِ عَامِ",59,"م",1,0],["فأَثبت لنا أَمرك الثاني نسير به","فأَنتَ منزله فينا وناسقه",60,"ق",2,0],["فاثأر لشعب جنى المستعمرون على","أرض له فغدت ملكاً لفجار",61,"ر