{"poems":[[55,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[79,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[88,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[95,"علام يقام تمثالي","https://www.aldiwan.net/poem9164.html","مجزوء الوافر"],[56,"آل الرسول مصابيح الهداية","https://www.aldiwan.net/poem27438.html","البسيط"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[47,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[47,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[47,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[30,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[68,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[68,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[46,"لي حبيب عصيت فيه النصيحا","https://www.aldiwan.net/poem30271.html","الخفيف"],[46,"كذا فليجل الخطب وليفدح الأمر","https://www.aldiwan.net/poem30313.html","الطويل"],[89,"ليس لي غير خالك الحجر الأسود","https://www.aldiwan.net/poem8351.html","الخفيف"],[107,"هنيئا أبا سفيان لا الذخر هين","https://www.aldiwan.net/poem44032.html","الطويل"],[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[104,"قد فهمنا من الهدية معنى","https://www.aldiwan.net/poem33001.html","الخفيف"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"وغرس من الأحباب غيبت في الثرى","https://www.aldiwan.net/poem26940.html","الطويل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"بقائي الطويل وغي البسيط","https://www.aldiwan.net/poem22777.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[79,"أنورُ سناءَ لاحَ في مشْرِق الغرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33315",""],[119,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[119,"نقشت في جبينها والمحيا","https://www.aldiwan.net/poem41658.html","الخفيف"],[119,"روحي وأرواح الوجود","https://www.aldiwan.net/poem42166.html","مجزوء الكامل"],[128,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[141,"أم سلام لو لقيت من الوجد","https://www.aldiwan.net/poem67967.html","الخفيف"],[147,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[147,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[154,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[154,"صبوت إلى الدنيا وذو اللب لا يصبوا","https://www.aldiwan.net/poem68604.html","الطويل"],[164,"إِذا حسدا مالت عن الصاحب الصحب","https://www.aldiwan.net/poem58822.html","الطويل"],[190,"تذكرت من كسرى بن ساسان عهده","https://www.aldiwan.net/poem43698.html","الطويل"],[239,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[274,"تمرين يا ذات الملاء المزيل","https://www.aldiwan.net/poem35579.html","الطويل"],[284,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[289,"ما ترقى الهند إلا","https://www.aldiwan.net/poem39377.html","مجزوء الرمل"],[324,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem67108.html","الكامل"],[353,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[368,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[368,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[369,"فاتنا بدر وأحد","https://www.aldiwan.net/poem44375.html","مجزوء الرمل"],[369,"ديار أقفرت من أم سلمى","https://www.aldiwan.net/poem44528.html","الوافر"],[381,"يا قلب مريم بابن الله منطبعا","https://www.aldiwan.net/poem59335.html","البسيط"],[381,"أرى الشيطان يرمينا بحرب","https://www.aldiwan.net/poem66941.html","الوافر"],[384,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[398,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[409,"أبلغ مقالي كل عاف مجتدي","https://www.aldiwan.net/poem49603.html","الكامل"],[420,"برح الشوق أصيحابي بي","https://www.aldiwan.net/poem53962.html","الرمل"],[420,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[436,"أودعت نسج الملح","https://www.aldiwan.net/poem12783.html","مجزوء الرجز"],[443,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[445,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[452,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[461,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[461,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[464,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[464,"الحمد لله كان المجد مقتسما","https://www.aldiwan.net/poem15415.html","البسيط"],[464,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[467,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[482,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[518,"لك يبق نوع تقتضيه كرامة","https://www.aldiwan.net/poem12088.html","الكامل"],[518,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[541,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[554,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[561,"تأمل فما فات شيء أتى","https://www.aldiwan.net/poem34704.html","المتقارب"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[578,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[709,"","https://poetry.dctabudhabi.ae/diwan/poem/1899","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31487","الوافر"],[1023,"","https://poetry.dctabudhabi.ae/diwan/poem/28824","الطويل"],[1140,"","https://poetry.dctabudhabi.ae/diwan/poem/29467","الطويل"],[1163,"لَعَمْرِي وما دَهْرِي بِتَأْبِينِ iiهَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18228",""]],"verses":[["فَآثارُهُ مُحمَرَّةٌ في عَدُوِّهِ","وَمِنهُ وَراءَ التُربِ أَبيضُ قاضِبُ",0,"ب",1,0],["فَأَثْقَلَ أَكْتَاداً وَعَمَّ حَقَائِباً","وَأَنْهَل ظِمْئاً نَبْعَ مُطَّرِدٍ عَذْبٍ",1,"ب",1,0],["فَأَثمَرَ وَحشَةً بَلَغَت مَداها","وَزَكّاها بِأَربَعَةٍ شُهودِ",2,"د",1,0],["فأثواني بمثوى من","ه لا دان ولا عال",3,"ل",1,0],["فَأَثمَرَت خَيرَ أَهلِ الأَرضِ بَعدَهُما","أَعني الشَهيدَينِ ساداتِ البَرِيّاتِ",4,"ت",1,0],["فأثمر فيها النصلُ نصراً مؤزّراً","وأجنى قطاف الفتح غضَّاً ودانيا",5,"ي",2,0],["فأثبتَّهُ لما استقاد وقد دنت","ظُباتُ السيوف من مَناط القلائدِ",6,"د",1,0],["فَاِثلِج بِبَردِ الدَمعِ صَدراً واغِراً","وَجَوانِحاً مَسجورَةَ الرَمضاءِ",7,"ا",2,0],["فَأَثقِل عَلَينا بِالمَشيبِ مُسَلِّماً","وَأَحبِب إِلَينا بِالشَبابِ مُوَدِّعا",8,"ع",2,0],["فَأَثرى بِهِ مِن بَعدِ بُؤسِ عَديمُها","وَعَزَّ بِهِ مِن بَعدِ خَوفٍ ذَليلُها",9,"ل",3,0],["فَآثَرتُهُ لَمّا رَأَيتُ الَّذي بِهِ","عَلى القَومِ أَخشى لاحِقاتِ المَلاوِمِ",10,"م",1,0],["فَاِثنِ جيداً عَنهُ وَثَنِّ بِما يو","جِبُ إِبعادَهُ بِغَيرِ اِحتِرامِ",11,"م",1,0],["فَأَثَروا فَوقَها رُسوماً","كَأَنَّها الطُرُقُ في الجِبالِ",12,"ل",1,0],["فَأَثِبني مِنَ القَطيعَةِ بِالوَص","لِ وَإِلّا فَاِردُد فُؤادي صَحيحا",13,"ح",2,0],["فَأَثبَتَ في مُستَنقَعِ المَوتِ رِجلَهُ","وَقالَ لَها مِن تَحتِ أَخمُصِكِ الحَشرُ",14,"ر",1,0],["فَأَثِبْنِي عَلَى الْجَمَالِ زَكَاةً","وَزَكَاةُ الْجَمَالِ فِي الْخَدِّ قُبْلَهْ",15,"ه",1,0],["فآثرتَ هَذِي ثمَّ ألقيتَ بالتي","حَمَلْتَ وما في الحقِّ أن يُؤثَرَ الدُّونُ",16,"ن",1,0],["فآثرتَ الهزيمة والرجوعا","وجاء غُويرِثٌ يبغي الرسولا",17,"ل",2,0],["فَأَثارَت ذِكرى وَهاجَت جِراحاً","تَرَكتني مِن الصَبابات مضنى",18,"ن",2,0],["فَآثَرَ الحَياةَ وَالهَوانا","وَما هَدا حَتّى رَأى الأَمانا",19,"ن",2,0],["فَأَثمَرَ هَمّاً لا يَبيدُ وَحَسرَةً","لِقَلبِيَ تَجنيها بِأَيدي الخَواطِرِ",20,"ر",1,0],["فأَثِبْ خاطِراً يَلَذُّ له مَدْ","حُك عِلْماً بأَنه اللَّأْلاءُ",21,"ا",2,0],["فأثْقَبُ منها نارُ زَنْدِكَ للقِرى","وأشهرُ منها ذِكرُ جودك في الورى",22,"ر",2,0],["فَإِثنِ عَلى اللَهِ تُعطَ الثَوابَ","وَإِلّا فَكَم مادِحٍ لَم يُجَز",23,"ز",1,0],["فأثارهم طمعٌ هناك فهاجَموا","مثل الذئاب تعيث في الحملان",24,"ن",1,0],["فآثرت العوالي في المعالي","وآثرت الصلادم في الصلادِ",25,"د",1,0],["فاثارته شربة النهر والغي","رة لله في رضا مصطفاها",26,"ا",3,0],["فآثر تم ما آثرت سنة الهدى","وغيرتم بالسيف ما الله ناقم",27,"م",1,0],["فأثقل أكْتاداً وعمَّ حقائباً","وأنْهَلَ ضَيْماً نبعَ مطّرِدٍ عذب",28,"ب",1,0],["فاثرت الزمان علي طيشا","وقد ابقيتني رهن الخمام",29,"م",1,0],["فأثبني منها وصالاً وجدلى","برضاء واجعلني عنك رضيا",30,"ي",2,0],["فاثابهم نيل المرا","د بحل سلسلة القيود",31,"د",1,0],["فأثار مختلف الشجون","بخافق ورع أَناب",32,"ب",1,0],["فَاثنِيَا واكفُفَا المَلاَمَةَ عني","واعذُرَا في الصِّبَا ولُومَا المَلُومَا",33,"م",2,0],["فَأَثيبي بِالوُدِّ صَبّاً عَميداً","مُستَهاماً لَم يَشجُهُ ما شَجاكِ",34,"ك",1,0],["فَاِثنِ المَلامَةَ في فِراقٍ بالِغٍ","بِأَبي عَلِيٍّ أَشرَفَ العَلياءِ",35,"ا",2,0],["فَأَثمَرَ ظَنُّنا صِدقاً وَحَقّاً","وَأَثمَرَ ظَنُّهُم مَيناً وَبُخلا",36,"ل",2,0],["فآثارُهُ أَنوارُها تَتَبلَّجُ","هُوَ الطاهِرُ المُختارُ مِن كُلِّ طاهِرٍ",37,"ر",1,0],["فَأَثنِ عَلَيهِ بالسَخاءِ وَبالحَيا","وَبالصَبر يَومَ البأسِ إِن كُنتَ مُثنيا",38,"ي",2,0],["فأثنى عليه والهوى قد أصمّه","وأعماه عما الخسر عقباه والتبُّ",39,"ب",1,0],["فآثرت يوما حلت الشمس منزلا","به وقفت ثم انثنت تطلب العكس",40,"س",1,0],["فَأَثرَيتُمُ مِن بَعدِ دَهرٍ وَضيقَةٍ","وَأَخصَبتُمُ مِن بَعدِ جَدبٍ وَإِمحالِ",41,"ل",1,0],["فأثَّرَ فيها صوتُه وبكت لهُ","وقالت حبيبي اليومَ في مُهجتي انزل",42,"ل",1,0],["فَأُثْنِي عَلى الْعِيسِ الْعِتاقِ لِقَصْدِهِ","بِما جَلَّ مِنْ فِكْرِي وَما دَقَّ مِنْ فَهْمِي",43,"م",2,0],["فأثار الروح بل جد","دها من عهد هود",44,"د",1,0],["فَاِثبِت جَواكَ وَلا تُحاوِل كَتمَهُ","وَاِشرَح هَواكَ فَكُلُّنا عُشّاقُ",45,"ق",1,0],["فَأَثبَتُ في مَحوِ العَيانِ عَيانُها","بِنَفيِ حُدودِ الأَينِ في حالِ رؤيَتي",46,"ي",1,0],["فأثِرْها حاكياتٍ في الفَلا","حينَ يَعْصِفُنَ نُعامَى أو نَعاما",47,"م",2,0],["فاثْنِ العِنانَ إلى رحيبِ فِنائه","من دونِ أَفنيةِ الملوكِ الصِّيد",48,"د",1,0],["فاثبتوا للقوم ضرباً","بسيوفٍ حارثيّه",49,"ي",2,0],["فأثكلنا الحَلِيلَةَ من بَنِيها","وخَلَّينا الخَرِيدَةَ للنكاحِ",50,"ح",1,0],["فَأَثَّرَت فيه بالمعنى فضائلُه","فأَلَّفت بين مرئيٍّ ومسموعِ",51,"ع",1,0],["فَأُثْبُتْ يا مجاهدُ مستعدّاً","ترَ المولى يقيك من الذنوب",52,"ب",1,0],["فَأَثَرت في جيدِهِ","بِأَحسن ذاكَ الأَثَر",53,"ر",1,0],["فأثارت كآبتي عجب النا","س وحاروا في سرّها المجهول",54,"ل",1,0],["فاثْنِ الرَّجاءَ إلى عُلاهُ فإنَّهُ","غَوثُ الرَّدي غَيْثُ الصَّدِي بَدرُ النَّدِي",55,"د",2,0],["فأثرتُمْ بعدها وخَّادَةً","لَطَمتْ وجه الفيافي رتكا",56,"ك",2,0],["فأُثني عليه الخير حيًّا وميّتاً","وأشكره ما دمتُ حيًّا مذكرا",57,"ر",2,0],["فأُثْبِتَتْ خلالَهُ","محاسنٌ ما تنمحى",58,"ح",2,0],["فأَثَابَهُ الفتحَ القريبَ وبَعْدَهُ","تصدِيقُ رُؤْيَاهُ لأَوَّلِ عَامِ",59,"م",1,0],["فأَثبت لنا أَمرك الثاني نسير به","فأَنتَ منزله فينا وناسقه",60,"ق",2,0],["فاثأر لشعب جنى المستعمرون على","أرض له فغدت ملكاً لفجار",61,"ر",1,0],["فأثرناها رفيقَيْ عزمةٍ","شاكلتْ بينهما فاختلطا",62,"ط",2,0],["فأثرتُ منه أبا الشبول فمالت ال","أرماحُ تَدعَسُه على غاباتِها",63,"ت",3,0],["فأثوي صريعاً أو تجلَّى عجاجتي","بنصرٍ عن الأمر الذي أنا آمله",64,"ل",2,0],["فآثر اللّهُ أنْ يُحْوي مُفَرَّقهُ","بالجمع ما بين فخر التُّرك والعرب",65,"ب",1,0],["فأثبتَ الحقَّ والألبابُ طائرةٌ","من شيعة الحقِّ وال