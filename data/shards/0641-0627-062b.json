{"poems":[[53,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[93,"علام يقام تمثالي","https://www.aldiwan.net/poem9164.html","مجزوء الوافر"],[54,"آل الرسول مصابيح الهداية","https://www.aldiwan.net/poem27438.html","البسيط"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[45,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[28,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[66,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[66,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[44,"لي حبيب عصيت فيه النصيحا","https://www.aldiwan.net/poem30271.html","الخفيف"],[44,"كذا فليجل الخطب وليفدح الأمر","https://www.aldiwan.net/poem30313.html","الطويل"],[87,"ليس لي غير خالك الحجر الأسود","https://www.aldiwan.net/poem8351.html","الخفيف"],[105,"هنيئا أبا سفيان لا الذخر هين","https://www.aldiwan.net/poem44032.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[102,"قد فهمنا من الهدية معنى","https://www.aldiwan.net/poem33001.html","الخفيف"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"وغرس من الأحباب غيبت في الثرى","https://www.aldiwan.net/poem26940.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[46,"بقائي الطويل وغي البسيط","https://www.aldiwan.net/poem22777.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[77,"أنورُ سناءَ لاحَ في مشْرِق الغرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33315",""]],"verses":[["فَآثارُهُ مُحمَرَّةٌ في عَدُوِّهِ","وَمِنهُ وَراءَ التُربِ أَبيضُ قاضِبُ",0,"ب",1,0],["فَأَثْقَلَ أَكْتَاداً وَعَمَّ حَقَائِباً","وَأَنْهَل ظِمْئاً نَبْعَ مُطَّرِدٍ عَذْبٍ",1,"ب",1,0],["فَأَثمَرَ وَحشَةً بَلَغَت مَداها","وَزَكّاها بِأَربَعَةٍ شُهودِ",2,"د",1,0],["فأثواني بمثوى من","ه لا دان ولا عال",3,"ل",1,0],["فَأَثمَرَت خَيرَ أَهلِ الأَرضِ بَعدَهُما","أَعني الشَهيدَينِ ساداتِ البَرِيّاتِ",4,"ت",1,0],["فأثمر فيها النصلُ نصراً مؤزّراً","وأجنى قطاف الفتح غضَّاً ودانيا",5,"ي",2,0],["فأثبتَّهُ لما استقاد وقد دنت","ظُباتُ السيوف من مَناط القلائدِ",6,"د",1,0],["فَاِثلِج بِبَردِ الدَمعِ صَدراً واغِراً","وَجَوانِحاً مَسجورَةَ الرَمضاءِ",7,"ا",2,0],["فَأَثقِل عَلَينا بِالمَشيبِ مُسَلِّماً","وَأَحبِب إِلَينا بِالشَبابِ مُوَدِّعا",8,"ع",2,0],["فَأَثرى بِهِ مِن بَعدِ بُؤسِ عَديمُها","وَعَزَّ بِهِ مِن بَعدِ خَوفٍ ذَليلُها",9,"ل",3,0],["فَآثَرتُهُ لَمّا رَأَيتُ الَّذي بِهِ","عَلى القَومِ أَخشى لاحِقاتِ المَلاوِمِ",10,"م",1,0],["فَاِثنِ جيداً عَنهُ وَثَنِّ بِما يو","جِبُ إِبعادَهُ بِغَيرِ اِحتِرامِ",11,"م",1,0],["فَأَثَروا فَوقَها رُسوماً","كَأَنَّها الطُرُقُ في الجِبالِ",12,"ل",1,0],["فَأَثِبني مِنَ القَطيعَةِ بِالوَص","لِ وَإِلّا فَاِردُد فُؤادي صَحيحا",13,"ح",2,0],["فَأَثبَتَ في مُستَنقَعِ المَوتِ رِجلَهُ","وَقالَ لَها مِن تَحتِ أَخمُصِكِ الحَشرُ",14,"ر",1,0],["فَأَثِبْنِي عَلَى الْجَمَالِ زَكَاةً","وَزَكَاةُ الْجَمَالِ فِي الْخَدِّ قُبْلَهْ",15,"ه",1,0],["فآثرتَ هَذِي ثمَّ ألقيتَ بالتي","حَمَلْتَ وما في الحقِّ أن يُؤثَرَ الدُّونُ",16,"ن",1,0],["فآثرتَ الهزيمة والرجوعا","وجاء غُويرِثٌ يبغي الرسولا",17,"ل",2,0],["فَأَثارَت ذِكرى وَهاجَت جِراحاً","تَرَكتني مِن الصَبابات مضنى",18,"ن",2,0],["فَآثَرَ الحَياةَ وَالهَوانا","وَما هَدا حَتّى رَأى الأَمانا",19,"ن",2,0],["فَأَثمَرَ هَمّاً لا يَبيدُ وَحَسرَةً","لِقَلبِيَ تَجنيها بِأَيدي الخَواطِرِ",20,"ر",1,0],["فأَثِبْ خاطِراً يَلَذُّ له مَدْ","حُك عِلْماً بأَنه اللَّأْلاءُ",21,"ا",2,0],["فأثْقَبُ منها نارُ زَنْدِكَ للقِرى","وأشهرُ منها ذِكرُ جودك في الورى",22,"ر",2,0],["فَإِثنِ عَلى اللَهِ تُعطَ الثَوابَ","وَإِلّا فَكَم مادِحٍ لَم يُجَز",23,"ز",1,0],["فأثارهم طمعٌ هناك فهاجَموا","مثل الذئاب تعيث في الحملان",24,"ن",1,0],["فآثرت العوالي في المعالي","وآثرت الصلادم في الصلادِ",25,"د",1,0],["فأثقل أكْتاداً وعمَّ حقائباً","وأنْهَلَ ضَيْماً نبعَ مطّرِدٍ عذب",26,"ب",1,0]]}