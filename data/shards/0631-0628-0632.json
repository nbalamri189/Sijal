{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[108,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[119,"لا تلم يا مهذب الانذالا","https://www.aldiwan.net/poem40617.html","عموديه"],[325,"ماس عجبا بعطفه وترنح","https://www.aldiwan.net/poem67138.html","الخفيف"],[353,"آن لمن ودع الشبابا","https://www.aldiwan.net/poem19850.html","مخلع البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2444","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64304","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2149,"","https://poetry.dctabudhabi.ae/diwan/poem/115179","الرجز"],[2285,"","https://poetry.dctabudhabi.ae/diwan/poem/31446","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94307","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93859","الخفيف"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114009","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83607","الخفيف"]],"verses":[["رُبَّ زِمامٍ لِيَ في ضِمنِهِ","لَم أَتَقَوَّلهُ وَلَم أَدَّعِ",0,"ع",1,0],["رُبَّ زيتٍ يفري البُطون، وماءٍ","عبَّ منه مَن ليس بالظمآن",1,"ن",1,0],["رب زاكي الاعمام ارداه خال","فانتخب للابناء يا خل خالا",2,"ل",2,0],["رَبِّ زِدهُ مَحاسِناً وَعَلاءً","وَأَطِل عُمرَهُ لِنَهنا وَنَفرَح",3,"ح",1,0],["رُبَّ زَمانٍ رَكِبْتُ فيهِ","لَهْوِي وَقَدْ خَفَّ لي رِكابَا",4,"ب",2,0],["رُبَّ زارٍ عَلَيَّ لَم يَرَ مِنّي","عَثرَةً وَهوَ مِمأَسٌ كَذّابُ",5,"ب",1,0],["رُبَّ زَمانٍ دَلِهٍ أرفَقُ بِكْ","لا عادَ إِنْ ضامَكَ دَهْرٌ أوْ مَلَكْ",6,"ك",1,0],["رب زدها حتى كأنك ما","عذّبت فيها من الورى إلاها",7,"ا",3,0],["رب زدني منها ولاء فماكر","نتني والورى لغير ولاها",7,"ا",3,0],["رُبَّ زمانٍ ذُلُّهُ أرفقُ بك","لا عار إن ضامكَ دهرُ أو ملك",8,"ك",1,0],["رُبَّ زادٍ قَد أَكَلنا طَيِّبٍ","بَعدَهُ الشَهدُ بِأَلبانِ الإِبِل",9,"ل",1,0],["رب زوجه حور عين ليقضى","ثم ما فات من زفاف وعرس",10,"س",1,0],["رب زد في مداه طول حياة","وأنله غايات أقصى الأماني",11,"ن",2,0],["رب زمان الوصل عنها ينقضي","ونحن في شغل أردى الشغل",12,"ل",1,0],["رَبِّ زِدهُ أَزكى صَلاتك دَوماً","وَذَويه ما اِخضرّ في الأَرضِ عودُ",13,"د",1,0]]}