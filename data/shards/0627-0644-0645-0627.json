ldiwan.net/poem56281.html","الكامل"],[463,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[466,"رويدك يا من تدعي شرف العلى","https://www.aldiwan.net/poem3407.html","عموديه"],[470,"الماء بين مجوشن ومدرع","https://www.aldiwan.net/poem59892.html","الكامل"],[470,"الماء منبسط والزهر منتشر","https://www.aldiwan.net/poem60138.html","البسيط"],[470,"الرعد منتحب والبرق ملتهب","https://www.aldiwan.net/poem60449.html","البسيط"],[470,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[479,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[481,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[495,"فصرت أمسك عن أوصاف نعمته","https://www.aldiwan.net/poem67335.html","البسيط"],[497,"كذا من شام بارقة العذاب","https://www.aldiwan.net/poem9765.html","الوافر"],[502,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[516,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[531,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[531,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[553,"لا تطلب الرزق في الدنيا بمنقصة","https://www.aldiwan.net/poem47187.html","البسيط"],[553,"والله لا كان لي مال أضن به","https://www.aldiwan.net/poem47270.html","البسيط"],[564,"الفضل من أهل الكرامة يعرف","https://www.aldiwan.net/poem52807.html","الكامل"],[564,"المال يفرق بين الأم والولد","https://www.aldiwan.net/poem52953.html","البسيط"],[577,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[577,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[656,"","https://poetry.dctabudhabi.ae/diwan/poem/97673","الكامل"],[724,"","https://poetry.dctabudhabi.ae/diwan/poem/123618","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/29476","الوافر"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/117841","الوافر"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27096","الطويل"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18714","الوافر"],[1091,"","https://poetry.dctabudhabi.ae/diwan/poem/97719","البسيط"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29464","الوافر"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/20644","الوافر"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/75853","الكامل"]],"verses":[["أَلَم أَسرِ في لَيلِها وَالعَجا","جُ يُلحِمُ بَينَ الرَعيلِ اللُهامِ",0,"م",1,0],["الماءُ عِندَكِ مَبذولٌ لِشارِبِهِ","وَلَيسَ يُرويكِ إِلّا مَدمَعي الباكي",1,"ك",2,0],["المانِعونَ الضَيمَ بِاللُدنِ تَرى","هِبابَها لِلطَعنِ أَو زَعزاعَها",2,"ع",3,0],["الماءُ في ناظِري وَالنارُ في كَبِدي","إِن شِئتِ فَاِغتَرِفي أَو شِئتِ فَاِقتَبِسي",3,"س",2,0],["المانِعونَ مِنَ الأَذى","وَالمُنقِذونَ مِنَ الدُهورِ",4,"ر",1,0],["أَلَم أَكُن أَنهى العِدى","عَن نابِ نَضناضٍ ذَكَر",5,"ر",1,0],["المالُ مالُ المَرءِ ما بَلَغَت بِهِ ال","شَهَواتُ أَو دَفَعَت بِهِ الأَحداثُ",6,"ث",1,0],["ألَمْ آتِهِ والدَّهْرُ في غُلَوائِهِ","قَليلَ غِرارِ النّومِ مُنتَشِرَ الأمرِ",7,"ر",1,0],["المالُ مالُكُمُ وَالعَبدُ عَبدُكُمُ","فَهَل عَذابُكَ عَنّي اليَومَ مَصروفُ",8,"ف",1,0],["أَلِمّا بِماءِ الدُحرُضَينِ فَكَلَّم","دِيارَ الَّتي في حُبِّها بِتُّ أَلهَجُ",9,"ج",1,0],["أَلِمَّا بِأَحْدَاثِ الْعُلَى وَالْمَنَاقِبِ","تُحَيِّ ثَرَاهَا وَاكِفَاتُ السَّحَائِبِ",10,"ب",1,0],["ألِمّا على شَطِّ الفُراتِ المقَدَّسِ","فخَيْرُ مَقيلٍ للهُدَى ومُعرَّسِ",11,"س",1,1],["أَلِمّا عَلى رَبعٍ بِذاتِ المَزاهِرِ","مُقيمٍ كَأَخلاقِ العَباءَةِ داثِرِ",12,"ر",1,1],["أَلَم أَلزَمِ الصَبرَ كَيما أَخِفَّ","أَلَم أُكثِرِ الهَجرَ كَي لا أُمَلّ",13,"ل",1,0],["أَلَم أَرضَ مِنكِ بِغَيرِ الرِضى","وَأُبدي السُرورَ بِما لَم أَنَل",13,"ل",1,0],["أَلَم أَغتَفِر موبِقاتِ الذُنوبِ","عَمداً أَتَيتِ بِها أَم زَلَل",13,"ل",1,0],["أَلَمّا تَعرِفوا مِنّا وَمِنكُم","كَتائِبَ يَطَّعِنَّ وَيَرتَمينا",14,"ن",2,0],["أَلَم أَنضِ المَطِيَّ بِكُلِّ خَرقٍ","أَمَقِّ الطولِ لَمّاعِ السَرابِ",15,"ب",1,0],["أَلِمّا عَلى الرَبعِ القَديمِ بِعَسعَسا","كَأَنّي أُنادي أَو أُكَلِّمُ أَخرَسا",16,"س",2,1],["أَلَمّا عَلى سَلمى نُسَلِّم وَنَسأَلِ","سُؤالَ حَفِيٍّ بِالحَبيبِ مُوَكَّلِ",17,"ل",1,1],["إِلْمَامُكُمْ سَرَّ القُلُوبَ فَأَقْبَلَتْ","تُبْدِي كَمِينَ شُعُورِهَا بِلسَانِي",18,"ن",2,0],["أَلِمّا بِمَحزونٍ سَقيمٍ وَأَسِعِفا","هَواهُ بِمَيٍّ قَبلَ أَن تَتَكَلَّما",19,"م",2,0],["أَلِمّا عَلى الدارِ الَّتي لَو وَجَدتُها","بِها أَهلُها ما كانَ وَحشاً مَقيلُها",20,"ه",2,1],["أَلِمّا بِمَيٍّ قَبلَ أَن تَطرَحَ النَوى","بِنا مَطرَحاً أَو قَبلَ بَينِ يُزيلُها",21,"ل",3,0],["أَلَمّا يَحِنَّ القَلبُ إِلّا تَشوقُهُ","رُسومُ المَغاني وَاِبتِكارُ الحَزائِقِ",22,"ق",1,0],["المانِعونَ فَلا يُسطاعُ ما مَنَعوا","وَالمُنبِتونَ بِجِلدِ الهامَةِ الشَعَرا",23,"ر",2,0],["أَلَم أَكُ ناراً يَصطَليها عَدُوُّكُم","وَحِرزاً لِما أَلجَأتُمُ مِن وَرائِيا",24,"ي",2,0],["أَلِمّا عَلى سَلمى فَلَم أَرَ مِثلَها","خَليلَ مُصافاةٍ يُزارُ وَيُمدَحُ",25,"ح",1,0],["أَلِمّا صاحِبَيَّ نَزُر سُعادا","لِقُربِ مَزارِها وَذَرا البِعادا",26,"د",2,0],["الماطِرينَ بِأَيديهِم نَدىً دِيَماً","بِكُلِّ غَيثٍ مِنَ الوَسمِيِّ مِبكارِ",27,"ر",1,0],["أَلَم أَكُ ناراً يَتَّقي الناسُ شَرَّها","وَسَمّاً لِأَعداءِ العَشيرَةِ مُمقِرا",28,"ر",2,0],["أَلَم أَكُ زادَ المُرمِلينَ وَوالِجاً","إِذا دَفَعَ البابُ الغَريبَ المُعَوَّرا",28,"ر",2,0],["أَلَم أَكُ قَد نَهَيتُ عَلى حَفيرٍ","بَني قُرطٍ وَعِلجَهُمُ شُقارا",29,"ر",2,0],["المانِعينَ إِذا النِساءُ تَبَذَّلَت","وَالجاسِرينَ بِمُضلِعِ المَغرومِ",30,"م",1,0],["الما تعجبي وترى بطيطا","من اللائين في الحِجج الخوالي",31,"ي",1,1],["المانِعينَ العَنقَفيرَ بِطَعنِهِم","وَالثائِرينَ بِمَقتَلِ النُعمانِ",32,"ن",1,0],["أَلَم أَثبُت لَها وَالخَيلُ فَوضى","بِحَيثُ تَخِفُّ أَحلامُ الرِجالِ",33,"ل",1,0],["أَلمالِئِ الشيزى إِذا أَعصَفَت","غَبراءُ في ذي السَنَةِ الماحِلِ",34,"ل",1,0],["الماجد الرَّاقي مراتبَ سؤددٍ","قد رصعت بجواره الجوزاء",35,"ا",2,0],["المانح الرّفد أفناناً مهدلة","فما يردّ جناها كف ملتمس",36,"س",1,0],["المالئ العين بشراً والأكف لهى","والقلب أبّهة والسمع تبيانا",37,"ن",2,0],["المالُ يكسِبُ ربَّه ما لم يَفضْ","في الراغبينَ إليه سوءَ ثناءِ",38,"ا",2,1],["المانح السائل الرغائبَ وال","غائل مِسبارَ كلِّ من سَبره",39,"ر",2,0],["ألم أره لو شاء بلع تِهامةٍ","وأجبالِها طاحتْ هناك بلا أرش",40,"ش",1,0],["ألم أك أدعو بتمكينكم","سراراً مع الساجد الراكع",41,"ع",1,0],["ألم أك أثني بآلائكم","جهاراً مع المعلن الصادع",41,"ع",1,0],["ألم أكن في حروبِك البطل ال","مَبلِيَّ والمستشارَ في هُدنِك",42,"ك",1,0],["ألم أكنْ من سيوفِك القَلعي","ياتِ وإن شئتَ كنتُ من جُننك",42,"ك",1,0],["المالُ غائبُهُ والحمدُ آئبُهُ","والمجدُ صاحبُهُ إنْ قال أو فعلا",43,"ل",2,0],["الماهِنِ الكاهِنٍ المُعادي","في نصرِ إبليسَ كلَّ مسلمْ",44,"م",1,0],["أَلَمْ أك في أُفقٍ مُسْفِرٍ","فماليَ في أُفقٍ قاتمِ",45,"م",1,0],["ألمْ أكُ جذلان في ظلكم","فماليَ في مَقعَد الواجمِ",45,"م",1,0],["المالُ والنفسُ وهْيَ تَفْضُلُهُ","والحُرُماتُ التي تَفِي بهما",46,"م",2,0],["المائِحُ الأُدمَ كَالمَروِ الصِلابِ إِذا","ما حارَدَ الخورُ وَاِجتُثَّ المَجاليحُ",47,"ح",1,0],["المانِعينَ الماءَ حَتّى يَشرَبوا","عِفَواتِهِ وَيُقَسِّموهُ سِجالا",48,"ل",2,0],["المانِعينَ غَداةَ الرَوعِ ما كَرِهوا","إِذا تَلَبَّسَ وُرّادٌ بِصُدّارِ",49,"ر",1,0],["المائِساتُ عَنِ الغُصو","نِ السافِراتُ عَنِ البُدورِ",50,"ر",1,0],["المالِكاتُ عَلى اللَآ","لِءِ في القَلائِد وَالثُغورِ",50,"ر",1,0],["المالُ مَن ذا يَشتَريهِ كُلَّهُ","مِنّي بِلَيلِ صَبابَةٍ وَغَرامِ",51,"م",1,0],["المالُ مَولكَ ما أَمسَكتُهُ طَمَعاً","فَأَنفِقهُ في الخَيرِ تُصبِح أَنتَ مَولاهُ",52,"ا",2,0],["أَلَمّا أَغزَرَت في العُسِّ بُركٌ","وَدَرعَةُ بِنتُها نَسِيا فَعالي",53,"ل",2,0],["المالُ فيهِ مَهابَةٌ وَتَجِلَّةٌ","وَالفَقرُ فيهِ مَذَلَّةٌ وَفُضوحُ",54,"ح",1,0],["أَلَم أُعتِقهُمُ مِن ذُلِّ كُفرٍ","جَرى في ضيمِهِم مِلءَ العِنانِ",55,"ن",1,0],["ألما من الكاس الروية رنقها","ولكم غداة بها يطاف الصافي",56,"ف",2,0],["الما بشعر قام كالطلل البالي","يمثل نفس القوم في الزمن الخالي",57,"ل",2,1],["المال حسبي منه ما","يكفي لحاجي ان يسدا",58,"د",2,0],["المال باعثها الأثيم ولم تزل","تُردى المطامع ناسهن وتصرع",59,"ع",1,0],["المال ظل زائل","والجهل موت الأمم",60,"م",1,0],["أَلَم أَستَوفِ آيَ الظَر","فِ أَشكالاً وَأَلوانا",61,"ن",2,0],["أَلَم أُصبِح بِبابِكُم","لِجَمعِ الطَيرِ سُلطانا",61,"ن",2,0],["أَلَم أَقُل لَكِ توا","لِكُلِّ يَومٍ هُمومُ",62,"م",1,0],["المالُ في الدُنيا مَنازِلُ نُقلَةٍ","مِن أَينَ جِئتَ لَهُ بِدارِ مُقامِ",63,"م",1,0],["المادِحونَ وَأَربابُ الهَوى تَبَعٌ","لِصاحِبِ البُردَةِ الفَيحاءِ ذي القَدَمِ",64,"م",1,0],["الماءُ وَالآفاقُ حَولَكَ فِضَّةٌ","وَالشُهبُ دينارٌ لَدى دينارِ",65,"ر",1,0],["المالُ في أَتباعِها","لا تَستَبينُ أَثَرَه",66,"ر",2,0],["المالُ حَلَّلَ كُلَّ غَيرِ مُحَلَّلِ","حَتّى زَواجَ الشيبِ بِالأَبكارِ",67,"ر",1,0],["أَلَمْ أَقُلْ لكَ إِنَّ البَغْيَ مَهْلَكَةٌ","والبَغْيُ والعُجْبُ إفسادٌ لأقوامِ",68,"م",1,0],["الماء والأرض أصل صنعتنا","قد دبرا بالهواء والنارِ",69,"ر",1,0],["ألمْ ألقَ فيك الأسرَ وهو مبرّحٌ","وألتذُّ طعمَ الموتِ وهو زُؤامُ",70,"م",1,0],["المانِعي اليَأسَ مِن بَخالَتِهِ","وَالموسِعي مِن عِداتِ عُرقوبِ",71,"ب",1,0],["أَلَمّا يَكفِ في طَلَلَي زَرودِ","بُكاؤُكَ دارِسَ الدِمنِ الهُمودِ",72,"د",1,1],["المالُ مالانِ وَرَبّاهُما","مُعطٍ لِما تَسأَلُهُ أَو مَنوع",73,"ع",1,0],["أَلِما فاتَ مِن تَلاقٍ تَلافٍ","أَم لِشاكٍ مِنَ الصَبابَةِ شافِ",74,"ف",1,1],["المائَةُ الدينارُ مَنسِيَّةٌ","في عِدَةٍ أَشبَعتَها خُلفا",75,"ف",2,0],["الماءُ لا يَبعَثُ لي نَشوَةً","فَعاطَني سَورَةَ ذاكَ الرَحيق",76,"ق",1,0],["أَلَم أَختَصِصكَ بِما قَد عَلِم","تَ مِنَ الوُدِّ وَالمِقَةِ المُكمِلَه",77,"ل",2,0],["إِلمامَةً بِالدارِ إِنَّ مُتَيَّماً","يَكفيهِ أَكثَرَ شَوقِهِ إِلمامُهُ",78,"م",2,0],["أَلِمّا عَلى دارٍ بِمُنقَطِعِ اللِوى","خَلاءٍ تُعَفّيها رِياحُ الجَنايِبِ",79,"ب",1,1],["المانِعينَ غَداةَ الرَوعِ نِسوَتَهُم","وَالضارِبينَ كِباشَ العارِضِ اللَجِبِ",80,"ب",1,0],["المازِنِيُّ الَّذي يَشآكَ أَوَّلُهُ","إِذا جَرَيتُم بِآباءٍ وَأَجدادِ",81,"د",1,0],["المالِئُ الجَفنَةَ الشَيزى إِذا سَغَبوا","وَالطاعِنُ الكَبشَ وَالمَنّاعُ لِلجارِ",82,"ر",1,0],["أَلَمّا يَنَل لي أَن تَعودَ قَرابَةً","وَحِلمٌ عَلى قَيسٍ رِحابٌ مَناظِرُه",83,"ر",2,0],["أَلَم أَضمَنِ المَوتَ الَّذي لا يَرُدُّهُ","إِذا جاءَ إِلّا رَبُّ غَربٍ وَمَشرِقِ",84,"ق",1,0],["أَلَم أَكُ أَكفيها وَأَحمي ذِمارَها","وَأَبلُغُ أَقصى ما بِهِ مُتَعَ