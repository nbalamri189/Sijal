{"poems":[[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[83,"للغني بالله قصر","https://www.aldiwan.net/poem54229.html","مجزوء الرمل"],[83,"للغني بالله ملك","https://www.aldiwan.net/poem54341.html","مجزوء الرمل"],[27,"ما بال جهلك بعد الحلم والدين","https://www.aldiwan.net/poem4437.html","البسيط"],[51,"أفي هوى يوسف ألام","https://www.aldiwan.net/poem66363.html","مخلع البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[116,"للغزال الطريف في القلب دار","https://www.aldiwan.net/poem41677.html","الخفيف"],[116,"للغوث عبد القادر الجيلاني","https://www.aldiwan.net/poem41764.html","الكامل"],[205,"يا حسنا اسمه له صفة","https://www.aldiwan.net/poem53230.html","المنسرح"],[283,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[286,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[453,"للغوطة الغناء أشرف ربوة","https://www.aldiwan.net/poem13717.html","الكامل"]],"verses":[["لِلْغَرْبِ فِي هَذِي الدِّيَارِ مَدَارِسٌ","فَازَتْ بِخَطّ مِنْ جَنَاكَ الدَّانِي",0,"ن",2,0],["لِلْغَنِي بالله قصرٌ","للتهاني يصطفيهِ",1,"ف",3,1],["للغنيْ باللهِ مُلْكٌ","بُردُهُ بالعزِّ مُذَهَبْ",2,"ب",1,1],["لِلغانِياتِ وِصالٌ لَستُ قاطِعَهُ","عَلى مَواعِدَ مِن خُلفٍ وَتَلوينِ",3,"ن",1,0],["للغُصْنِ منه إذا تثَنَّى","في مشيه اللِّينُ والقوام",4,"م",1,0],["لِلْغُنَّةِ الجَارِي عَلَيْهَا صَوْتُهُ","تَأْثِيرُ سِحْرٍ فِي النُّفُوسِ حَلاَلِ",5,"ل",1,0],["للغرب عاداتٌ مسّممةٌ، سرت","في الشرق مسرى الداء في الأجسام",6,"م",1,0],["للغزال الطريف في القلب دار","قر فيها وفر بالاصطبار",7,"ر",1,1],["للغوث عبد القادر الجيلاني","طرنا بأجنحة من الأشجان",8,"ن",1,1],["للغصن من قَدِّه شمائلُه","للظبي من جيده سَوالفُهُ",9,"ف",2,0],["لِلغُصنِ هزَّتُهُ وَالشَمسِ طَلعَتُهُ","وَالمِسكِ نَكهَتُهُ وَالريمِ عَيناهُ",10,"ا",2,0],["للغرب أنت وللمشارق مرجع","منك المعاند والمعادي يرهب",11,"ب",1,1],["للغُوطَةِ الغنّاء أشرف رَبوةٍ","أضحى بها عيشُ النزيل رغيدا",12,"د",2,1]]}