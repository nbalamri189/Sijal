{"poems":[[95,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[85,"للغني بالله قصر","https://www.aldiwan.net/poem54229.html","مجزوء الرمل"],[85,"للغني بالله ملك","https://www.aldiwan.net/poem54341.html","مجزوء الرمل"],[29,"ما بال جهلك بعد الحلم والدين","https://www.aldiwan.net/poem4437.html","البسيط"],[53,"أفي هوى يوسف ألام","https://www.aldiwan.net/poem66363.html","مخلع البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[119,"للغزال الطريف في القلب دار","https://www.aldiwan.net/poem41677.html","الخفيف"],[119,"للغوث عبد القادر الجيلاني","https://www.aldiwan.net/poem41764.html","الكامل"],[208,"يا حسنا اسمه له صفة","https://www.aldiwan.net/poem53230.html","المنسرح"],[287,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[290,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[457,"للغوطة الغناء أشرف ربوة","https://www.aldiwan.net/poem13717.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64251","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71023","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59725","البسيط"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44785","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216671",""],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117488","الكامل"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101829","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53137","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198395","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104678","البسيط"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147348","البسيط"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117021","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77163","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54343","الدوبيت"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104514","الكامل"],[4782,"مواسم البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=198506",""],[4862,"كذبت عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=55613",""],[4934,"ماني بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=32780",""],[5064,"فانُوسُ اللَّيَالِي","https://www.poetsgate.com/ViewPoem.aspx?id=199168",""],[5136,"ومهاة ذات صد وملل","https://www.poetsgate.com/ViewPoem.aspx?id=121643",""],[307,"الرحيل الى الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=213747",""],[5386,"بين ضلوعنا","https://www.poetsgate.com/ViewPoem.aspx?id=35004",""],[5413,"الشِّعْرُ يَرْقُصُ","https://www.poetsgate.com/ViewPoem.aspx?id=200601",""],[5605,"رسالة الى عباس","https://www.poetsgate.com/ViewPoem.aspx?id=160586",""],[5691,"أطواق منضدة","https://www.poetsgate.com/ViewPoem.aspx?id=206439",""],[5732,"الله من هم بالأعماق مخفيه","https://www.poetsgate.com/ViewPoem.aspx?id=177821",""],[402,"ألغرس غرسك أيها البستاني","https://www.poetsgate.com/ViewPoem.aspx?id=36486",""],[6231,"عمى ألوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84915&r=&rc=5",""]],"verses":[["لِلْغَرْبِ فِي هَذِي الدِّيَارِ مَدَارِسٌ","فَازَتْ بِخَطّ مِنْ جَنَاكَ الدَّانِي",0,"ن",2,0],["لِلْغَنِي بالله قصرٌ","للتهاني يصطفيهِ",1,"ف",3,1],["للغنيْ باللهِ مُلْكٌ","بُردُهُ بالعزِّ مُذَهَبْ",2,"ب",1,1],["لِلغانِياتِ وِصالٌ لَستُ قاطِعَهُ","عَلى مَواعِدَ مِن خُلفٍ وَتَلوينِ",3,"ن",1,0],["للغُصْنِ منه إذا تثَنَّى","في مشيه اللِّينُ والقوام",4,"م",1,0],["لِلْغُنَّةِ الجَارِي عَلَيْهَا صَوْتُهُ","تَأْثِيرُ سِحْرٍ فِي النُّفُوسِ حَلاَلِ",5,"ل",1,0],["للغرب عاداتٌ مسّممةٌ، سرت","في الشرق مسرى الداء في الأجسام",6,"م",1,0],["للغزال الطريف في القلب دار","قر فيها وفر بالاصطبار",7,"ر",1,1],["للغوث عبد القادر الجيلاني","طرنا بأجنحة من الأشجان",8,"ن",1,1],["للغصن من قَدِّه شمائلُه","للظبي من جيده سَوالفُهُ",9,"ف",2,0],["لِلغُصنِ هزَّتُهُ وَالشَمسِ طَلعَتُهُ","وَالمِسكِ نَكهَتُهُ وَالريمِ عَيناهُ",10,"ا",2,0],["للغرب أنت وللمشارق مرجع","منك المعاند والمعادي يرهب",11,"ب",1,1],["للغُوطَةِ الغنّاء أشرف رَبوةٍ","أضحى بها عيشُ النزيل رغيدا",12,"د",2,1],["للغصن أعطافها وقامتها","وللرشا جيدُها وعيناها",13,"ا",3,0],["للغَىِّ ضد وللوُفَّاد غيثُ ندى","وللعدى بحر حتفٍ صار ملتطما",14,"م",2,0],["للغصن قامته للريم مقتله","للخمر ريقته للبدر مطلعه",15,"ع",2,0],["لِلغَربِ عاداتٌ كَغازاتٍ سَرَت","في الشَرقِ مَسرى الداءِ بِالأَجسامِ",16,"م",1,0],["للغالي اللّي لهْ بِلِفْواد بِنيانْ","يحَرَم على غيره مْجيمٍ ولافِي",17,"ف",2,0],["للغيمِ في شفقِ الأصائلِ منظرٌ","يلهي برونق حسنه من أبصرا",18,"ر",2,1],["للغيث رعد وندى كفه","لم تلق فيه أبداً رعدا",19,"د",2,0],["للغصن ما في عِطفه من هَيَفٍ","والظبي ما في طرفه من شوس",20,"س",1,0],["للغياث بن يوسف الملك الظاه","ر غوث الطرّيد غيث البلاد",21,"د",1,0],["للغرْبِ قومٌ يشترونَ كسادَهُمْ","للشّرْقِ قومٌ في عَمَى الإلْحادِ",22,"د",1,0],["للغانياتِ بِذي المَجازِ رُسومُ","فَبِبَطنِ مَكّةَ عهدُهنَّ قَديمُ",23,"م",1,1],["لِلغَوارِ إِلا وَأَشجاني وَأَشجاها","ما ارتَحتُ إِذا ما الهَوى في أَضلُعي رُسِما",24,"م",2,0],["للغائبين ضياء الشَّمْسِ ساطعة","خَتْمًا لِملحمةِ الأجداثِ بِالسَّحَرِ",25,"ر",1,0],["للغصن في الروض تطراق إليه كما","للنرجس الغض من جفنيه اغضاء",26,"ا",2,0],["للغدر والحرب والعدوان قد جنحوا","وأصبحوا عن سبيل السلم صدادا",27,"د",2,0],["لِلغَيظِ آفات يَضيق بِها الفَتى","فَإِذا اِستَطَعتَ لَهُ دفاعاً فَاِجهد",28,"د",1,1],["للغزو نشاطي وإليه طرَبي","ما لي في العيش غيرَهُ من أَرَب",29,"ب",1,1],["لِلْغَيِّ طَبْعَاً وَلِلاََْسْواءِ سائِمَة","فَافْطُنْ لَها وَهْيَ بِالطَّاعاتِ قائِمَةٌ",30,"ه",1,0],["للغنا تريم","فاعزم لأجل الزياره",31,"ه",1,0],["للغرب يرهف نصله","إذ يبدي للشرق ابتسامه",32,"ه",1,0],["للغائبين .. على سواعدهم","نبتَ الحنينُ وأينع الثمرُ",33,"ر",1,0],["للغدر أهل وأهل الغدر نعرفهم","سيماهمُ عرفت بالشك والرِيَبِ",34,"ب",1,0],["للغرور اشكال جمة والتواضع له غرور","ذاغروري ف التواضع يمشي في درب السداد",35,"د",1,0],["للغائِبينَ ملامِحٌ لا تغرُبُ","وخُطًى إِذا ابتعدَتْ تجيءُ وتقرُبُ",36,"ب",1,1],["للغواني في وصالي أمل","مثل مالي في لقاهن أمل",37,"ل",1,0],["للغيبِ يأخُذنا بحثاً ويُبحرنا","في النفسِ عُمقاً وفِي الأكوانِ يُعلينا",38,"ن",2,0],["للغيض ميلاد وليالْ ........ تعانق وتروي ضماك","هات الغضب ما همّني ........ دام برضاك علومنا",39,"ن",2,0],["لِلْغَانِيَاتِ السَّاحِرَاتِ إِذَا بَدَتْ","-رغْمَ الأنَاقةِ- حَسْرَةٌ وَتَأَلُّمُ",40,"م",1,0],["لِلْغَرْبِ للحب ِ للدُولار ِ هِجْرَتُهَا","مِثْلُ الذُبَابِ عَلَى الأَوْسَاخ ِ يَنْتَقِلُ",41,"ل",1,0],["للغَرْبِ آدابُهُ لسْنا نقارِبُها","بما لديْنا ولو سعْياً لتعْريبِ",42,"ب",1,0],["للغرب قلبي ما سمع صوت داعيه","وللشرق قلبي سمع صوت المنادي",43,"د",2,0],["للغرب في هذي الديار مدارس","فازت بحظ من جناك الداني",44,"ن",2,0],["للغيم ِ أكتبُ للأمطار ِ للشجرِ","ليلا ً يسامرني ، من هفوة ِ الضجر ِ",45,"ر",1,1]]}