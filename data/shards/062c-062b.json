{"poems":[[51,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[89,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[85,"جثا لديها وأذرى الدمع ناظره","https://www.aldiwan.net/poem7755.html","البسيط"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"لواء الله بورك من لواء","https://www.aldiwan.net/poem42133.html","الوافر"],[105,"يا أمة أودت بها الأحلام","https://www.aldiwan.net/poem43369.html","الكامل"],[105,"رب أحببني وأحبب أسرتي","https://www.aldiwan.net/poem43384.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141968","الطويل"],[158,"من عونه ربه في أمره غلبا","https://www.aldiwan.net/poem58896.html","البسيط"],[179,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[219,"ليالي النوى علمتني النحيبا","https://www.aldiwan.net/poem55301.html","المتقارب"],[221,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[221,"جثم الليل بأحضان التلال","https://www.aldiwan.net/poem41896.html","الرمل"],[374,"طوباك يا جسد العذراء إن له","https://www.aldiwan.net/poem59244.html","البسيط"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[498,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[538,"جثمت ضباب ضغينتي من صدره","https://www.aldiwan.net/poem56798.html","الكامل"],[565,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"]],"verses":[["جُثَّةُ الكشْخانِ تُنْبي أنها","جُمِعتْ نُطفتُها من ألفِ أبْ",0,"ب",1,0],["جُثثٌ لُطّفتْ على قدرِ الأر","واح إن الآلات كالعمالِ",1,"ل",1,0],["جثمانه هذا فاين المنطق","وغلافه هذا فاين المخفق",2,"ق",1,1],["جثا لديها وأذرى الدمع ناظره","وعاتَبَتها بأن قالت محاجره",3,"ر",2,1],["جَثَمَت طُيورُ المَوتِ في أَوكارِها","فَتَرَكنَ طَيرَ العَقلِ غَيرَ جُثومِ",4,"م",1,0],["جَثَمَتْ جَوانِبُه على آسَاسِها","وسَمَتْ إلى غَاياتِها الأركانُ",5,"ن",1,0],["جَثتْ هِمَمُ الخلودِ على ذُراهُ","وأقعت حوله ذِمَمُ البَقاءِ",6,"ا",2,0],["جَثموا بِمُستَنِّ الهَوانِ وَما دَرَوا","أَنَّ الحَياةَ تَدافُعٌ وَزِحامُ",7,"م",1,0],["جَثَمَ الضَيمُ بِهِم في حُفرَةٍ","جَثَمَت فيها عَوادي الزَمَنِ",8,"ن",1,0],["جَثمتْ حوله الحُصونُ وظنَّ ال","قومُ ظنَّ الغرورِ أن لن تطيرا",9,"ر",2,0],["جثا الجبَّارُ بين يديْ","كِ طفلاً يشتكي الغَبْنا",10,"ن",2,0],["جثثا تعاف البيد شرب دمائها","ويعفّ كاسرها ويأنف ذيبها",11,"ب",3,0],["جثم الرعبُ عليه فنضا","لججاً سوداً وظلاً مُقبِضا",12,"ض",2,0],["جَثْلَةُ الحَاجِبَيْنِ فَاحِمَةُ","الفَوْدَيْنِ تَرْنُو بِطَرْفِ ظَبْيٍ غَزِيرِ",13,"ر",1,0],["جَثَتْ عَلَى مَهْدِهَا بِمَا لَمْ","تُعْهدْ عَلَيْهِ مِنَ الوَقَارْ",14,"ر",1,0],["جثمانه في القبر لكن روحه","أبداً مرفرفة على الوديان",15,"ن",1,0],["جُثَثٌ مطوّحةٌ ذراها عاصفٌ","وحمالقٌ ميلٌ وأشلاءٌ دمُ",16,"م",1,0],["جثى على ركبتيهِ الظلمُ حين مشى","فينا على قدميه العدلُ وانتصبا",17,"ب",2,0],["جَثلُ العِفَاءِ كأَنَّ تَحتَ نَشَاصِهِ","دُهمَ العِشَارِ فُجِعنَ بالأَطفالِ",18,"ل",1,0],["جثواً لديك ولما يئسنا","أقمنا على كل عضو رقيبا",19,"ب",2,0],["جثا اللَيلُ ملتَفّاً بِبُردِ السَرائِرِ","وَفي صَدرِهِ المَفؤودِ رِعشَةُ جائِرِ",20,"ر",1,1],["جثمَ اللَيلُ بِأَحضانِ التِلال","حالَكَ البَردةِ مَنشورَ الظلال",21,"ل",1,1],["جثمان مريم جثمانُ ابنها شَرَعٌ","كلاهما عَظُما كلاهما عُصِما",22,"م",2,0],["جثث القتلى على ذاك الصعيد","سترت نضرة ذياك النبات",23,"ت",1,0],["جَثَوْنا انكِساراً خاشِعينَ لعِزِّهِ","بذُلٍّ وللحُبِّ العَزيزِ دَلالُ",24,"ل",1,0],["جَثَمَت ضَبابُ ضغينتي مِن صَدرهِ","بَينَ النياطِ وَحبلهِ المتأبِّطِ",25,"ط",1,1],["جَثْلُ الدُّنَابِي كَأَنَّ سُنْدُسَةً","سُنَّتْ عَلَيْهِ مَوْشِيَّةَ العَلَمِ",26,"م",1,0]]}