""],[4908,"دمعة حزن على جراح الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=207338",""],[4929,"حادي العيس (على نمط الشعر الجاهلي)","https://www.poetsgate.com/ViewPoem.aspx?id=201029",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5082,"موَّالُ نايٍّ عراقيّ","https://www.poetsgate.com/ViewPoem.aspx?id=212469",""],[5096,"عقبة بن نافع الفهري رضي الله عنه","https://www.poetsgate.com/ViewPoem.aspx?id=209070",""],[5183,"جلاء الجيش الإنجليزى عن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185638",""],[5324,"الكراسي.","https://www.poetsgate.com/ViewPoem.aspx?id=211282",""],[5431,"رحماك يارب السماء","https://www.poetsgate.com/ViewPoem.aspx?id=185254",""],[5616,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=203430",""],[5793,"المثل العليا.. تنتحر!","https://www.poetsgate.com/ViewPoem.aspx?id=199055",""],[5956,"عقدة النقص لدى إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=192310",""],[6066,"إِلَى مَنْ كَانَ جُرْمُهُمْ أَنْ صَلًّوا صَلاةَ ال","https://www.poetsgate.com/ViewPoem.aspx?id=12668",""],[6237,"يا ربيع الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77871&r=&rc=13",""],[6262,"جُثَّتي تقتفي خُطاي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80124&r=&rc=22",""]],"verses":[["جُثَّةُ الكشْخانِ تُنْبي أنها","جُمِعتْ نُطفتُها من ألفِ أبْ",0,"ب",1,0],["جُثثٌ لُطّفتْ على قدرِ الأر","واح إن الآلات كالعمالِ",1,"ل",1,0],["جثمانه هذا فاين المنطق","وغلافه هذا فاين المخفق",2,"ق",1,1],["جثا لديها وأذرى الدمع ناظره","وعاتَبَتها بأن قالت محاجره",3,"ر",2,1],["جَثَمَت طُيورُ المَوتِ في أَوكارِها","فَتَرَكنَ طَيرَ العَقلِ غَيرَ جُثومِ",4,"م",1,0],["جَثَمَتْ جَوانِبُه على آسَاسِها","وسَمَتْ إلى غَاياتِها الأركانُ",5,"ن",1,0],["جَثتْ هِمَمُ الخلودِ على ذُراهُ","وأقعت حوله ذِمَمُ البَقاءِ",6,"ا",2,0],["جَثموا بِمُستَنِّ الهَوانِ وَما دَرَوا","أَنَّ الحَياةَ تَدافُعٌ وَزِحامُ",7,"م",1,0],["جَثَمَ الضَيمُ بِهِم في حُفرَةٍ","جَثَمَت فيها عَوادي الزَمَنِ",8,"ن",1,0],["جَثمتْ حوله الحُصونُ وظنَّ ال","قومُ ظنَّ الغرورِ أن لن تطيرا",9,"ر",2,0],["جثا الجبَّارُ بين يديْ","كِ طفلاً يشتكي الغَبْنا",10,"ن",2,0],["جثثا تعاف البيد شرب دمائها","ويعفّ كاسرها ويأنف ذيبها",11,"ب",3,0],["جثم الرعبُ عليه فنضا","لججاً سوداً وظلاً مُقبِضا",12,"ض",2,0],["جَثْلَةُ الحَاجِبَيْنِ فَاحِمَةُ","الفَوْدَيْنِ تَرْنُو بِطَرْفِ ظَبْيٍ غَزِيرِ",13,"ر",1,0],["جَثَتْ عَلَى مَهْدِهَا بِمَا لَمْ","تُعْهدْ عَلَيْهِ مِنَ الوَقَارْ",14,"ر",1,0],["جثمانه في القبر لكن روحه","أبداً مرفرفة على الوديان",15,"ن",1,0],["جُثَثٌ مطوّحةٌ ذراها عاصفٌ","وحمالقٌ ميلٌ وأشلاءٌ دمُ",16,"م",1,0],["جثث تهوي ، بلا فائدة","خنجر دام ، له كلّ الإفاده",17,"د",2,0],["جثى على ركبتيهِ الظلمُ حين مشى","فينا على قدميه العدلُ وانتصبا",18,"ب",2,0],["جَثلُ العِفَاءِ كأَنَّ تَحتَ نَشَاصِهِ","دُهمَ العِشَارِ فُجِعنَ بالأَطفالِ",19,"ل",1,0],["جثواً لديك ولما يئسنا","أقمنا على كل عضو رقيبا",20,"ب",2,0],["جثا اللَيلُ ملتَفّاً بِبُردِ السَرائِرِ","وَفي صَدرِهِ المَفؤودِ رِعشَةُ جائِرِ",21,"ر",1,1],["جثمَ اللَيلُ بِأَحضانِ التِلال","حالَكَ البَردةِ مَنشورَ الظلال",22,"ل",1,1],["جثمان مريم جثمانُ ابنها شَرَعٌ","كلاهما عَظُما كلاهما عُصِما",23,"م",2,0],["جثث القتلى على ذاك الصعيد","سترت نضرة ذياك النبات",24,"ت",1,0],["جَثَوْنا انكِساراً خاشِعينَ لعِزِّهِ","بذُلٍّ وللحُبِّ العَزيزِ دَلالُ",25,"ل",1,0],["جَثَمَت ضَبابُ ضغينتي مِن صَدرهِ","بَينَ النياطِ وَحبلهِ المتأبِّطِ",26,"ط",1,1],["جَثْلُ الدُّنَابِي كَأَنَّ سُنْدُسَةً","سُنَّتْ عَلَيْهِ مَوْشِيَّةَ العَلَمِ",27,"م",1,0],["جثىً مثل ملح المازيىَ أَعده","لحميرَ لما تحشه فى الحقائب",28,"ب",1,1],["جثث على جثث علت","مثل الأكام على الأكام",29,"م",1,0],["جثت ودعت للعاشقين وبورك","القران فلما أصبح العشق سلوانا",30,"ن",2,0],["جَثَت دونَهُم بَكرٌ فَلَم نَستَطِعهُمُ","كَأَنَّهُمُ بِالمَشرَفِيَّةِ سامِرُ",31,"ر",1,0],["جثل دحوجي مرجله","عبقٍ بنشر بشامة المشط",32,"ط",1,0],["جثث كأن الدهر هاب مساسها","او كان معها للزمان ذمام",33,"م",1,0],["جُثَثٌ عَلَى الأَزْهَارِ مَنْ أَوحَى لَهَا؟","أَنَّ المَلائِكَ سَاكِبَاتُ المَوْرِدِ!",34,"د",1,0],["جثوا وقد صبروا صبر الكرام على","حرّ الجلاد بأنواع من النوب",35,"ب",1,0],["جثَمتْ على شُرفاتِها","والليلُ فوقَ الصبحِ جَاثِمْ",36,"م",1,0],["جثا الآباء في حلق الزوايا","وهذا النشء فارقه الصواب",37,"ب",1,0],["جثمانك العف الطهو","ر وقلبك الجم الحنان",38,"ن",1,0],["جثة بينهم فعما قليل","أنا أغدو مع الألى سبقوني",39,"ن",2,0],["جثم المعرى اليوم في جثمانه","وتكمن الطائي في أبراده",40,"د",2,0],["جَثَت رُسُلٌ فِي الحَشرِ مِن خِيفَةٍ بِهِ","عَلَى رُكَبٍ وَالنَّارُ غَيظاً تَوَهَّجُ",41,"ج",1,0],["جثنا إلى ساحة بالجود قد ملئت","وساحة المصطفى بالجود فيحاء",42,"ا",2,0],["جثة هكطور بهاتيك الفلا","فإنما الزهرة بالمرصاد",43,"د",1,0],["جثث تربت في الحرام وفي الربا","ولهم بطون منهما وظهور",44,"ر",1,0],["جثلةُ الثوب لا انفصام إلى العر","وة خلخالها يظل خروسا",45,"س",2,0],["جثى جثوةَ الكلب العقور بنعله","على صدرِه وَهوَ المُؤَمَّر والصَّدر",46,"ر",1,0],["جثت على جثث حكت رص البنا","بين الأسود وصولة الزملاء",47,"ا",2,0],["جَثَمَ السُّكُوتُ.. ودُونَ أَيِّ تَعَقُّلٍ","شَبَكَ العِنَادُ بَنَانَهُ ببَنانِي",48,"ن",2,0],["جَثَمَت على أحلامِنَا ورَأَت","أنْ لا يَكُونَ الحَقُّ إثبَاتَا",49,"ت",2,0],["جَثَا اللَّيلُ.. عِندِي سَرَابٌ غَزيرٌ","أَصِيخِي ولا تَنزِلِي يا دِلَاءُ",50,"ا",2,0],["جَثَمُوا عَلى صَدْرِ الضَّعيفِ فَمَا لَهُ","مِنْ نُصْرَةٍ جَادَتْ بِهَا العُظَماءُ",51,"ا",2,0],["جثموا بأرضك غاصبين ومهدوها للمهاجر","ماذا يقال لهم وحقك كانبلاج الصبح سافر",52,"ر",1,0],["جَثمتْ همومُ الدَّهرِ فوق جبينها","وَاِسْتَفْحَلْتْ فِي جسمها الأَوْصابُ",53,"ب",1,0],["جَثَتْ على عَرَصَاتِ الدَّارِ أسقُفُه","وأردفَتْها مَثانِيْهِ بأحجار",54,"ر",1,0],["جثمت على الكثبان تنتظر السنا","وأتى الصباح فهجن منتعشات",55,"ت",1,0],["جثوتُ على رملِ الدّيارِ وقد غدتْ","ملامحُها ترجو قلوباً وأضلعا",56,"ع",2,0],["جُثمانُه شرفٌ .. يَزيدُ جَزائِري","فخْراً، فَتغْدو فِي المَدائنِ عسْجدَا",57,"د",2,0],["جثمت منه على أنحائنا","صخرة المستعمرين الغُربا",58,"ب",2,0],["جثثا قتلى يتامى","وعدو الشعب قاسي",59,"ي",1,0],["جثثٌ ومن أطفالنا","قطعٌ هنا وهنا الدماءْ",60,"ا",2,0],["جثثٌ هنا وهنا ابتلاءْ","صمتٌ وعربدةٌ وداء",60,"ا",2,0],["جثث ترنو إليها جثث","وسوارٌ نازفٌ من معصم!",61,"م",1,0],["جَثَتْ تَسترِقُّ قلوبَ التِّلالِ","وتسفحُ أدمعَها في الترابْ",62,"ب",1,1],["جثث تذكرها بالشرِّ دنيا","وبأخرى وتريها عَطَبا",63,"ب",2,0],["جثث وشلاء تلبي","لنداء مولاها فتؤسي",64,"س",2,0],["جثمت في الدجى يغلفها الصمت","وشعت في قلبه كالشموعِ",65,"ع",1,0],["جُثَّتي تقتفي خطاي وظِلِّي","لا أراه إلى القصيدةِ يُفضي",66,"ض",2,0]]}