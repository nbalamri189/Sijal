tabudhabi.ae/diwan/poem/136935",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90745","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94479","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73285","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133162","البسيط"],[4674,"أنت العلاء","https://www.poetsgate.com/ViewPoem.aspx?id=185283",""],[5054,"أنت أملي","https://www.poetsgate.com/ViewPoem.aspx?id=213641",""],[585,"حتام تطمع أن تبل غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=161928",""],[5136,"بما أكافيك يا ابن الشم يا ملك","https://www.poetsgate.com/ViewPoem.aspx?id=121642",""],[5147,"خطب كما تعلمونه صعب","https://www.poetsgate.com/ViewPoem.aspx?id=166695",""],[5277,"أنتِ..يا أجملَ الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=187783",""],[5277,"أسارير معذّبه","https://www.poetsgate.com/ViewPoem.aspx?id=193391",""],[5323,"مختصر الغادات !","https://www.poetsgate.com/ViewPoem.aspx?id=207242",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5518,"ماذا أحدث","https://www.poetsgate.com/ViewPoem.aspx?id=201645",""],[5561,"بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=211443",""],[5605,"حميمية لقاء..","https://www.poetsgate.com/ViewPoem.aspx?id=159461",""],[5616,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=205245",""],[5720,"لَذَّة الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=209147",""],[5751,"نَهارُ عينَيك","https://www.poetsgate.com/ViewPoem.aspx?id=215014",""],[5790,"آيات سحرٍ من لحاظك تنزل","https://www.poetsgate.com/ViewPoem.aspx?id=112104",""],[5829,"الحبيب الأول","https://www.poetsgate.com/ViewPoem.aspx?id=211051",""],[5847,"في ظلال ميلاد النبي محمد صلى الله عليه وسلم 1431","https://www.poetsgate.com/ViewPoem.aspx?id=52777",""],[5853,"نور الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=175723",""],[5939,"جاريتي","https://www.poetsgate.com/ViewPoem.aspx?id=178578",""],[5956,"حبيبةُ الأزهارِ","https://www.poetsgate.com/ViewPoem.aspx?id=193363",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""],[5567,"وعاودني الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69062&r=&rc=0",""]],"verses":[["أَنتِ النَعيمُ لِقَلبي وَالعَذابُ لَهُ","فَما أَمَرُّكِ في قَلبي وَأَحلاكِ",0,"ك",1,0],["انت النبي العربي الذي","به نباهى وبه نفخر",1,"ر",1,1],["أنت النساء جميعاً.. ما من امرأةٍ","أحببت بعدك.. إلا خلتها كذبا",2,"ب",2,0],["أَنتِ النَهارَ هَوى الفُؤادِ وَلا","يَنفَكُّ حُبُّكِ كُلَّما أُمسي",3,"س",2,0],["أَنْتَ النَّجِيبُ وَمَا تُجَا","رِيكَ السَّوَابِقُ فِي مَجَالِ",4,"ل",1,0],["أَنتَ النَجيبُ وَلكِن","أَبى الرَدى ما أَرَدتُه",5,"ت",2,0],["أنت النبي لا كذب","أنت ابن عبد المطلب",6,"ب",1,1],["أنتَ الندَى وأبو الندى وأخو الندى","حُزْتَ المَدى فأربعْ بأرفْع منزل",7,"ل",1,0],["أَنتَ النَبِيُّ مُحَمَّد","قرمٌ أَغَرُّ مُسَوَّدُ",8,"د",1,1],["أنتَ النهارَ تذكُّرى وتفكُّرى","والليلَ أحلامى وطيفُ منامى",9,"م",2,0],["أنتَ النجابةُ من آبائها ظهرتْ","فلستُ أعجبُ إن قالوا أبو النُّجبِ",10,"ب",1,0],["أَنت النَعيم فما لَقا","بي لَيسَ يَسلَم من أَذاك",11,"ك",1,0],["أنتَ النديم المُصطفى لصبُوحِها","وغبوقِها إذ جئتَني بالمُعجِز",12,"ز",1,0],["أنت النذير لوقتنا ولعصرنا","علم الهداية للمعالي تندب",13,"ب",1,0],["أنتَ النبيُّ لَهم بل للوجودِ وقد","نابوا فيختصُّ ما أوتوا وينصرمُ",14,"م",1,0],["أنت النعيم لذي الدنيا وساكنها","والناس في كلّ وقت منك في عيد",15,"د",1,0],["أنت النعيم لقلب فيك مكتئب","وأنت أمن لخوف سلمه حرب",16,"ب",1,0],["أنتَ النَّعيمُ لَهُ وَمن عَجَب تُعَذ","ذبُهُ وَتُرضُهُ وَأنتَ طبِيبَهُ",17,"ب",2,0],["أنت النعيم وفي النعيم يثيبنا ال","باري ويأمرنا بشرب الراح",18,"ح",1,0],["أَنتَ النَفيسُ أَصوغُ فيكَ نَفائِساً","إِن النَفائِسَ لِلشَريفِ الأَنفَسِ",19,"س",1,0],["أَنتَ النَبِيُّ وَمَن يُحرَم شَفاعَتَهُ","يَومَ الحِسابِ فَقَد أَزرى بِهِ القَدَرُ",20,"ر",1,0],["انت النطاسي الذي كم مدنف","فيه من الموت الزوآم لقد نجا",21,"ج",2,0],["انتَ النَجيبُ مسمى اسمٍ تليقُ بِهِ","لَم يُحصِ وصفَكَ الّا وَهوَ مُختَصِرُ",22,"ر",1,0],["أنت النعيم لناظريَّ وخاطري","عجباً وحقك من نعيم ينحب",23,"ب",1,0],["أنت النواةُ لُمسْتَقِلِّ رجاله","عَبَّدْتَ فيه لهم طريقا لاحبا",24,"ب",2,0],["أنت النواةُ لكل غرس يانع","من مصلح أَو مرشد أَو هادي",25,"د",2,0],["انت النديم ورهن را","حِكَ كل سحر وافتنان",26,"ن",1,0],["أنت النعيم على المحب وجنة","أبداً عدوك في لظاها يضرم",27,"م",1,0],["أنت النزيل بخلبهِ وهو الَّذي","دهراً يحافظ خدنهُ وتريله",28,"ل",2,0],["أنت النبيُّ بها ولحظُكَ طرفُهُ","في فَترةٍ مِنهُ كَدَمعِيَ مُرسَلُ",29,"ل",1,0],["أنت النصير وأنت المستعان فكن","يا سيدي عوننا فيما عرى أو دها",30,"ه",2,0],["أنتَ النديمُ، فهاكَ عُمري خمرةً","هيهاتَ أن يحظى بها النُّدماءُ",31,"ا",2,0],["أنت النبي الذي أهديتنا الحسنات","أنت الرسول الذي قد ضَل من خلاك",32,"ك",1,0],["أنت النعيم وأنت منبت فتيةٍ","كالشوك فيك وإن زكيت أصولا",33,"ل",2,0],["أنت النسيم الذي يحيى الأنام به","فلو تأخرت عنهم لحظة هلكوا",34,"ك",3,0],["أنت النبي وخير منبعث","أحى إليه الخالق الرب",35,"ب",1,0],["أنت النساء جميعهن على الهوى","وإليك وحدك قد رحلت بلهفتي",36,"ت",2,0],["أنتِ النوى..أنتِ معنى النأيِ..والطللُ","وأنتِ أشواقُهُ والقومُ قدْ رحلوا",37,"ل",3,1],["‏أنتِ النهارُ جلياً في توهجهِ","‏وأنتِ أنتِ سكونُ الليلِ والسّحَرُ!",38,"ر",1,0],["أنْت النَّبيُّ ولا إلاّكَ مَنْ هَتَفتْ","لهُ السَّموات لمَّا سارَ لِلْباري",39,"ر",2,0],["أنتَ النَّجاةُ لِمَنْ ضلَّتْ سفينتُه","إذا تشبَّثَ باسمِ اللهِ حاديها",40,"ي",3,0],["أنت النبي الهاشمي المجتبى","صلى عليك الله في آياته",41,"ت",2,0],["أنتَ النهارُ وكم يعمُّ ضياؤهُ","والّليلُ شمسُ ضحًى يجوبُ سماكا",42,"ك",2,0],["أنتِ النُجُومُ أَطَلَّتْ في تَوَهُّجِهَا","تُزِيحُ مَوجًا طَغَى عن ليلي الباكي",43,"ك",2,0],["أنتِ النجومُ على خدَّيكِ لاهيةٌ","وأنتِ ملهمةُ الأشعارِ والسِّيَرِ",44,"ر",1,0],["أنتَ النداءاتُ في سمعي تُوشوشني","بأعذبِ اللحنِ .. لمَّا أنتشي طربا",45,"ب",2,0],["أنتِ النساءُ جميعًا والرجالُ أنا","أنا وأنتِ وغَيمُ العشقُ مَنزلُنا",46,"ن",2,1],["أنت النبي بها وطرفك قد أتى","في فترةٍ منه كدمعي مرسل",47,"ل",1,0],["انت النساء إذا اجتمعن فأشرقي","انت البهاء فاقبلي وتجملي",48,"ل",2,0],["أنت النذير بحكمة هي رحمة","للعالمين تشفهم إصلاحا",49,"ح",2,0],["أنتَ النبيّ العالميّ المصطفى","يا خيرَ خلق الله وُاراه الثرى",50,"ر",2,0],["أنتِ النسيمُ، وجمرُ القلبِ مُتَّقِدٌ","شوقًا إليكِ وعرشَ الحُلمِ وَلاّكِ",51,"ك",1,0],["أنت النجيدة نخوةٌ عمليَّة","في حلِّ جُلِّ قضية الأحرارِ",52,"ر",1,0],["أنتِ النفائسُ والصروح عرائسٌ","والشِّعر يرقص مطْربا مئناسا",53,"س",2,0],["أنت النجيب وقل مثلك ماجدٌ","تزهو به الأيام والأمصارُ",54,"ر",1,0],["أنت النشيد الذي ما خطه قلم","يوما ولا في مدادات الهوى كُتبا",55,"ب",2,0]]}