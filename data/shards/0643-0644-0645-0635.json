{"poems":[[563,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62681","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132620","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138463",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""]],"verses":[["كل مصنوع بمن قد صنعَهْ","ليس يدري حطه أورفعَهْ",0,"ع",2,1],["كلٌّ مصاب بسهام النزح","إنسان عيني مُبتَلٍ بالسَّبحِ",1,"ح",1,0],["كل مصداقه المودة في القر","بى ومن كل ما نفى استثناها",2,"ا",3,0],["كل مصر اقام مأتم شجو","لمصاب العزيز في الناس قدرا",3,"ر",2,0],["كل مصابٌ به لكن عترته","أولى الورى فهم الأدنونَ في الرحمِ",4,"م",1,0],["كُلُّ مُصغٍ لِصَوتِها يَتَسَلَّى","دُونَ وَعيٍ بِلَذَّةِ الإِصغاءِ",5,"ا",2,0]]}