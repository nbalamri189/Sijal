{"poems":[[90,"أرى الأيام ظامئة وليست","https://www.aldiwan.net/poem45005.html","الوافر"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143014","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69980","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4764,"شيخة الظبيان","https://www.poetsgate.com/ViewPoem.aspx?id=24834",""],[4866,"دمعة الرجّال","https://www.poetsgate.com/ViewPoem.aspx?id=139717",""],[4931,"ورود الحب","https://www.poetsgate.com/ViewPoem.aspx?id=31111",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5320,"إلى البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=41634",""]],"verses":[["أبٌ في المجد أرْوَع أحْوَريّ","نَمى للمجد أروع أحوريّا",0,"ر",3,0],["أَبِفَضلٍ مِنَ المَليكِ وَنُعمى","أَم بِذَنبٍ قَدَّمتُهُ فَجُزيتُ",1,"ت",1,0],["أب في الصف أوام رؤوم","وليس سواهما في الناس حام",2,"م",1,0],["أبفيصلٍ تَهْدى الرّعا","ع شماتةً يا للحَرَب",3,"ب",1,0],["أبفيصلٍ تُغرى الخدا","ئع والمكائد بالنَّشبِ",3,"ب",1,0],["أبفيصلٍ يُبدى اللس","ان بَذاءَةً يَا للعَجب",3,"ب",1,0],["ابٌ في قَهرِهِ الشَيطان لَيثٌ","وَغَيثٌ بِالمَكارم وَالسَماحِ",4,"ح",1,0],["أَبفيهِ يَطفي شَمسَ مُلكٍ أَشرَقَت","بِالشَرعِ مِن سِت المئينِ مُؤَيَّد",5,"د",1,0],["أبفدي من سكن هالدار ..ومنهو ..حلوه ..أطباعه","عَسى دربه فرح دايم .. وسعد(ن) ما رآه إنسان",6,"ن",1,0],["أبفتح ضلوعي لك وهاتي نصل قتّال","إذا طعْنتي تغفر ذنوبي وأفعالي",7,"ل",2,0],["أبفرح لجلك ولجلك باعوف الحزن واللوعه","واشق القلب وازرع به ورق من عود غريافك",8,"ك",1,0],["أبفضل؟ والمعالي ما رأت","فيكم إلا حسودا وحقودا",9,"د",2,0],["أبفزع من سعى الله قربى","ومن رضى الصلاة عن المنام",10,"م",1,0]]}