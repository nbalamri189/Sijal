{"poems":[[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[30,"ألم تر أني يوم جو سويقة","https://www.aldiwan.net/poem5654.html","الطويل"],[76,"وأغر يسفر للعوالي والعلى","https://www.aldiwan.net/poem13240.html","الكامل"],[77,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[50,"وخمار حططت إليه ليلا","https://www.aldiwan.net/poem63266.html","الوافر"],[50,"أبت عيناي بعدك أن تناما","https://www.aldiwan.net/poem65228.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62227","الطويل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[92,"عناد...","https://www.poetsgate.com/ViewPoem.aspx?id=179043",""],[119,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[119,"لقد أسمعتها سحر المعاني","https://www.aldiwan.net/poem41481.html","الوافر"],[215,"أتبكي ماهرا وبه تراخت","https://www.aldiwan.net/poem46634.html","الوافر"],[264,"بمدام أنس مقام إبراهيما","https://www.aldiwan.net/poem35807.html","الكامل"],[266,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[469,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[563,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122702","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66791","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64052","المنسرح"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96602","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61151","الكامل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117114","المجتث"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111797","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108945","الوافر"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119233","الكامل"],[2270,"","https://poetry.dctabudhabi.ae/diwan/poem/97799","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87730","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65963","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205844","السريع"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103908","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131266",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114210","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90957","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120498","الطويل"],[4858,"ضعيفاً قد خُلِقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=155356",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5219,"الطاهرة المطهرة","https://www.poetsgate.com/ViewPoem.aspx?id=194998",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[5582,"هَلْ ما عَهِدْتُ مِنَ البَشاشَةِ عائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186883",""],[5690,"نقولا فتى التيان قد أوحش الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=172252",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["فكأنّ جولتنا بصدر ظلامه","سرٌّ يجول بخاطر الكتمان",0,"ن",1,0],["فكان جوابي أنْ حُجبتُ وهكذا","يكونُ جوابَ المبتغي الغوثَ من قبر",1,"ر",1,0],["فَكانَ جَوابي أَن بَكَيتُ صَبابَةً","وَفَدَّيتُ مَن لَو يَستَطيعُ فَدانِيا",2,"ي",2,0],["فَكَأَنَّ جِلدَةَ حَيَّةٍ خُلِعَت بِهِ","يَومَ الكَريهَةِ فَوقَ عَطفي ضَيغَمِ",3,"م",1,0],["فكأنّ جَدّكَ في فوارسِ هاشِمٍ","منهم بحيثُ يرى الحسينَ ذبيحا",4,"ح",2,0],["فَكانَ جَوابُهُ أَن قالَ صُبحٌ","وَلا صُبحٌ سِوى ضَوءُ العُقارِ",5,"ر",1,0],["فَكانَ جَوابُها في حُسنِ مَسٍّ","أَأَجمَعُ وَجهَ هَذا وَالحَراما",6,"م",2,0],["فَكَانَ جَوَابِي أَنْ حَزَزْتَ أَخَاهُمُ","جِهَاراً وأَنْيَابِي مِنَ الحِرْبِ تَصْرِفُ",7,"ف",1,0],["فكأنّ جيراني جراح تحتسي","ريّ الأسى من أدمعي ودمائي",8,"ا",2,0],["فكان جهد حدياهم مساورة ال","بيض القواضب اذ خاموا عن السور",9,"ر",1,0],["فكان جزائي شرَّ ما جُوزي امرؤ","عن العيشِ ملتاثِ المواردِ يعزف",10,"ف",1,0],["فكأن جفني بالدموع موكل","وكأن لبي للاسا صندوق",11,"ق",1,0],["فكان جزاي أن فتكت بقلبي","بسيف الصد عدواناً وظلما",12,"م",2,0],["فكان جزاؤهم طعنا وقتلاً","وتشريداً بأودية الجروح",13,"ح",1,0],["فكأن جلّقَ أصبحت ذات العما","دِ إلى العباد وجنّةً ونعيما",14,"م",2,0],["فكأن جودك منه شق صحيفتي","حتى خلصت وخلتني المتلمسا",15,"س",2,0],["فكأن جذوة نارها من أضلعي","وكأن جمة أدمعي من مائها",16,"ا",3,0],["فكان جماداً والنبات كلاهما","حقائق معنى الغيب عنه وفود",17,"د",1,0],["فكأن جهدك عند حد لم يقف","ألف له لكن خلا من ياء",18,"ا",2,0],["فَكَأنَّ جِلبابَ الظَّلا","مِ وَثَوبَهِ خَلِقٌ شَبارِق",19,"ق",1,0],["فكانَ جوابُنا لهمُ جَهِلْتُم","وخبتمْ والذي خَلَق الأَناما",20,"م",2,0],["فكان جسمي في زيِّ منطلِقٍ","وكان قلبي في زيِّ منعطف",21,"ف",1,0],["فكان جزائي أن أصيرَ دَريئة","لأدْرأ عنهم كلَّ ما يُتحذَّر",22,"ر",1,0],["فكأنّ جودَ فلاح وبل ربابه","لمّا تجلجل وبلُه وحياؤهُ",23,"ا",3,0],["فَكَأن جالينوس أَوصاه بِه","فبقيه سَتَنال كُل سَعاده",24,"د",2,0],["فكان جهلا وبيلا","وكان مالا وبالا",25,"ل",2,0],["فكانَ جمالُ الكونِ في جنبِ قبحهِ","وفاءَ مداجٍ قد تبطنَ بالغدرِ",26,"ر",1,0],["فكان جوابها أهلاً وسهلاً","ألذ ولا أبالغ من لَماها",27,"ا",3,0],["فكأن جرذان المدينة كلها","في عوده يقرضن خبزاً يابسا",28,"س",2,0],["فكان جزاؤنا منهم عقوقاً","وهما ماع منه مخ ساقي",29,"ق",2,0],["فَكانَ جَزاؤُنا جُوعاً وَعُرياً","وَذُلاً كَي نَهون وَلَن نَهونا",30,"ن",2,0],["فكان جزائي أن كل مصيبة","أصبت بها ناب لكم عض في نحضي",31,"ض",2,0],["فكان جوف الطير قبراً له","أعلى سماكاً من ضريح الحجر",32,"ر",1,0],["فكان جواب الربع إذ أنا سائل","وهل تفهم القول الربوع الأخارس",33,"س",1,0],["فكان جزائي أن مضى غير حافظٍ","ذماماً وهل يرعى الذمام غدورُ",34,"ر",1,0],["فكأن جرم الأرض مخسوف الثرى","وكأن بنيان السما مهدود",35,"د",1,0],["فَكَانَ جَدِيراً مشن بَدَاعَتِهِ بِأن","يُسَمَّى بَدِيعاً لاَ يُبَالَى بِمَن فَرَّا",36,"ر",2,0],["فكأن جسمك جسمه لكنه","كان العفير وكنت أنت غسيلا",37,"ل",2,0],["فكان جفني حين اسكب عبرتي","زند تناثر منه سقط ذئب",38,"ب",1,0],["فكان جزآي بعد ان بنت عنهم","عناء وضربا في جميع الجوانب",39,"ب",1,0],["فكان جزاؤهُ جنّاتِ عدْنٍ","وينْعمُ بالرّضا مِن ذي الجلال",40,"ل",1,0],["فكان جرحا ونارا في الحشا اجتمعا","فضيّفا سود شعري شيبة الهرم",41,"م",1,0],["فكان جواب الله من فوق سابعٍ","حصان رزان تلك بعض الشمائل",42,"ل",1,0],["فَكَانَ جَيْشَ النَّبِيِّ فرداً","فِي حَوْمَةِ الْمَوْتِ وَالنِّزَالِ(١٣)",43,"ل",1,0],["فَكَأَنَّ جَيْشَ هَواكِ كانَ مُجِيرَهُ","مِنِّي أَبُو العَرَبِ الهُمامُ الماجِدُ",44,"د",1,0],["فكان جزاه منهُ ناداهُ أرخوا","تعالَ ورث بشّرهُ ملكاً مؤبدا",45,"د",2,0],["فكان جميع الكون في صحف له","بتسنينه توحيد فطرة سنة",46,"ه",1,0]]}