s://www.aldiwan.net/poem23047.html","الطويل"],[46,"أيسمع خالقي مني دعاء","https://www.aldiwan.net/poem23171.html","الوافر"],[46,"لقد صدئت أفهام قوم فهل لها","https://www.aldiwan.net/poem23200.html","الطويل"],[1,"من الشر والتبريح أولاد معشر","https://www.aldiwan.net/poem34000.html","الطويل"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[15,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem45262.html","الطويل"],[15,"نأتك سليمى فالفؤاد قريح","https://www.aldiwan.net/poem45279.html","الطويل"],[8,"جزعت وقد نالتك حد رماحنا","https://www.aldiwan.net/poem21827.html","الطويل"],[76,"أتقتلني ظلما وتجحدني قتلي","https://www.aldiwan.net/poem39013.html","الطويل"],[76,"إذا جالس الفتيان ألفيته فتى","https://www.aldiwan.net/poem39237.html","الطويل"],[68,"نسخت بحبي آية العشق من قبلي","https://www.aldiwan.net/poem1521.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85721","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85370","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85572","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72223","الوافر"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6795","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30504","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54663","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141994","الوافر"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13662","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2902","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[77,"يمينا بيانع ورد الخدود","https://www.poetsgate.com/ViewPoem.aspx?id=33808",""],[88,"بني الأرض هل مِن سامع فأبثَّه","https://www.poetsgate.com/ViewPoem.aspx?id=6484",""],[58,"إذا جَادَتِ الدُّنيا عَلَيْكَ فَجُدْ بها","https://www.poetsgate.com/ViewPoem.aspx?id=22637",""],[45,"فُؤادٌ، بذِكْرِ الظّاعنينَ، مُوَكَّلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32198",""],[45,"إِذا جَمَعَ امْرؤٌ حَزْما وعَقْلاً","https://www.poetsgate.com/ViewPoem.aspx?id=32533",""],[45,"لِمَا وَصَلَتْ أسماءُ مِنْ حَبلِنَا شكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31345",""],[45,"لأوْشَكَ شعَبُ الحَيّ أنْ يَتَفَرّقا","https://www.poetsgate.com/ViewPoem.aspx?id=32847",""],[45,"هَواهَا عَلَى أَنَّ الصُّدُودَ سَبِيلُهَا","https://www.poetsgate.com/ViewPoem.aspx?id=32102",""],[45,"نفقت نفوق الحمار الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=31266",""],[80,"فؤادِي نجيبٌ والجلالُ نجيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3009",""],[91,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=53276",""],[28,"أنا ابن العاصمين بني تميم","https://www.poetsgate.com/ViewPoem.aspx?id=21512",""],[99,"صباح السكر","https://www.poetsgate.com/ViewPoem.aspx?id=577",""],[51,"أرى الشعراء حَظُوا عندكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=30626",""],[51,"إذا جُددتْ نعمة ُ لامرىء","https://www.poetsgate.com/ViewPoem.aspx?id=30751",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[97,"في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=12763",""],[39,"أَلاَ أَيُّها اللَّيْلُ الطَّوِيلُ، أَلاَ اصْبِحِي","https://www.poetsgate.com/ViewPoem.aspx?id=4248",""],[31,"لَقَدْ أَرْسَلَتْ في السِّرِّ لَيْلَى تَلُومُني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18822&r=&rc=85",""],[31,"قد هاجَ قلبكَ بعد السوة ِ الوطن،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19107&r=&rc=369",""],[85,"إلى الله أَشكو مِن عَوادِي النَّوَى سهما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9625&r=&rc=115",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[36,"طربت وما هذا بساعة مطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16615&r=&rc=0",""]],"verses":[["إِذا جُزتُ في أَبياتِ آلِ مُحَلِّمٍ","تَراغَينَ نَحوي مِن وَراءِ المَعاطِنِ",0,"ن",1,0],["إِذا جَذَبتُ لِذِكرِ السَيرِ مِقوَدَها","كَأَنَّما جَذَبَتها سَورَةُ اللَمَمِ",1,"م",1,0],["إِذا جُشِّموا النَزرَ القَليلَ رَأَيتَهُم","يَعُجّونَ مِن لُؤمٍ وَما حُمِّلوا ثِقلا",2,"ل",2,0],["إِذا جَرَّ أَذيالَ العَوالي لِمَعرَكٍ","فَإِنَّ جَلابيبَ التُرابِ ذُيولُ",3,"ل",1,0],["إِذا جَرَتِ الآدابُ جاءَ أَمامَها","قَريعاً وَجاءَ الطالِبونَ إِفالا",4,"ل",2,0],["إِذا جَرى وَالحَسودَ في صُعُدٍ","مِنَ العُلى يَبغِيانِ مُمتَنَعَه",5,"ع",2,0],["إِذا جَنَبوهُ لِلرِهانِ أَتوا بِهِ","جَواداً يُفَدّى شاؤُهُ بِاليَعافِرِ",6,"ر",1,0],["إِذا جالَ في أَشداقِها الظِمءُ قَلَّصَت","لَها الأَرضُ وَاِنقادَت إِلَيها المَوارِدُ",7,"د",1,0],["إِذا جَحَدوا نُعماكَ لَوَّت رِقابَهُم","لِمَنِّكَ أَطواقٌ بِها وَقَلائِدُ",7,"د",1,0],["إِذا جَزِعَت أَيّامُنا كُنتَ مَعقِلاً","وَإِن ظَمِئَت أَمالُنا كُنتَ مَورِدا",8,"د",2,0],["إذا جَرى ذِكرُهُمْ باتَتْ على طَرَبٍ","مُتونُهُنَّ إِلى الأعْناقِ والقُلَلِ",9,"ل",1,0],["إِذا جَحَدَ الجَميلَ بَنو قُرادٍ","وَجازى بِالقَبيحِ بَنو زِيادِ",10,"د",1,1],["إِذا جُرِّدَت ذَلَّ الشُجاعُ وَأَصبَحَت","مَحاجِرُهُ قَرحى بِفَيضِ المَدامِعِ",11,"ع",1,0],["إِذا جَحَدتُ الهَوى يَوماً لِأَدفِنَهُ","في الصَدرِ نَمَّ عَلَيَّ الدَمعُ مُعتَرِفا",12,"ف",2,0],["إِذا جاءَني مِنها الكِتابُ بِعَتبِها","خَلَوتُ بِنَفسي حَيثُ كُنتُ مِنَ الأَرضِ",13,"ض",1,1],["إذَا جِئْتَ قُطْراً أوْ حَلَلْتَ بِمَرْبَعٍ","ثَوَى الأمْنُ والتَّمْهِيدُ بَيْنَ حِلاَلِهِ",14,"ل",2,0],["إذا جبَلَ التّوْحيدِ أصْبَحْتَ فارِعاً","فخيِّمْ قَريرَ العينِ في دارِ عامِرِ",15,"ر",1,0],["إذا جَذَبوها إليْهِمْ حَنَوْا","ظُهوراً ومَدّوا له كُلَّ جِيدْ",16,"د",1,0],["إذا جعْسوسُ جاءَ الى صَلاةٍ","وطالَعنا بطَلْعَتِهِ النّجِيسَهْ",17,"ه",1,1],["إِذا جِئتَهُ تَبغي الهُدى خالَفَ الهُدى","وَإِن جُرتَ عَن بابِ الغِوايةِ دَلَّكا",18,"ك",2,0],["إِذا جُرِّدَت يَوماً حَسِبتَ خَميصَةً","عَلَيها وَجِريالاً يُضيءُ دُلامِصا",19,"ص",2,0],["إِذا جاهَرَتهُ بِالفَضاءِ اِنبَرى لَها","بِإِلهابِ شَدِّ كَالحَريقِ المُضَرَّمِ",20,"م",1,0],["إِذا جَبَلُ الرَيّانِ لاحَت قِبابهُ","لِعَيني وَلاحَت مِن سَنيرٍ هِضابُهُ",21,"ب",2,0],["إِذا جاءَت لَهُم تِسعونَ أَلف","عَوابِسُهُنَّ وَرداً أَو كُمَيتا",22,"ت",2,0],["إِذا جاوَزوا مَعروفَها أَسلَمَتهُمُ","إِلى غَمرَةٍ لا يَنظُرُ العَومَ نونُها",23,"ن",3,0],["إِذَا جَسَّمُوهُ لَمْ يَكُنْ فِي جَلالِهِ","سِوَى شَبَهً لِلشَّخْصِ أَغْبَرَ قَاتِمِ",24,"م",1,0],["إِذَا جَاءنَا طَيَّارُهُ كَشَفَ الْعِدَى","وَإِلاَّ اسْتَنَرْنَا الْيَأْسَ وَالْجَوُّ مُظْلِمُ",25,"م",1,0],["إِذا جِئتَهُ في حاجَةٍ سَدَّ بابَهُ","فَلَم تَلقَهُ إِلّا وَأَنتَ كَمينُ",26,"ن",1,0],["إِذا جَعَلَ الحِرباءُ مِمّا أَصابَهُ","مِنَ الحَرِّ يَلوي رَأسَهُ وَيُرنَحُ",27,"ح",1,0],["إذا جئت من دار الغني بربه","مناخَ العلا والعزّ فَاعقِلْ وعرِّسِ",28,"س",1,0],["إذا جنّني ليل الشكوك سللته","عليه ففّراه بفجر يقينه",29,"ن",2,0],["إذا جاهل منكم مشى نحو سُبَّةٍ","مشى جمعكم من غير قصد يُريدها",30,"د",3,0],["إذا جمعتنا وحدة وطنيّة","فماذا علينا أن تَعَدَّد أديان",31,"ن",1,0],["إذا جلست إليهم في مجالسهم","تلقى القوارض فيها ذات مصطخب",32,"ب",1,0],["إذا جئت بالقلب السليم يجيئني","بقلب له من كَثرة الحقدوارم",33,"م",1,0],["إذا جمّش البحر النسيم تهلّلت","أسارير فيها للضياء وثوب",34,"ب",1,0],["إِذا جاءَ روحُ التَغلِبِيِّ مِنِ اِستِهِ","دَنا قَبضُ أَرواحٍ خَبيثٍ مَآبُها",35,"ب",3,0],["إِذا جَهِلَ اللَئيمُ وَلَم يُقَدِّر","لَبَعضِ الأَمرِ أَوشَكَ أَن يُصابا",36,"ب",2,0],["إِذا جِئتُها يَوماً مِنَ الدَهرِ زائِراً","تَغَيَّرَ مِغيارٌ مِنَ القَومِ أَكلَحُ",37,"ح",1,0],["إِذا جَمَعَ الأَعداءُ أَمرَ مَكيدَةٍ","لِغَدرٍ كَفاكَ اللَهُ كَيدَ المُكايِدِ",38,"د",1,0],["إِذا جَدَّ الرَحيلُ بِنا فَرُحنا","فَنَسأَلُ ذا الجَلالِ بِكَ المَتاعا",39,"ع",2,0],["إِذا جَدوَلٌ مِنها تَصَرَّمَ ماؤُهُ","وَصَلنا إِلَيهِ بِالنَواضِحِ جَدوَلا",40,"ل",2,0],["إِذا جِئتَها أَلفَيتَ في حَجَراتِها","عَناجيجَ قُبّاً وَالسَوامَ المُؤَبَّلا",40,"ل",2,0],["إِذا جَمَعوا جَمعاً سَمَونا إِلَيهِمُ","بِهِندِيَّةٍ تُسقى الذُعافَ المُثَمَّلا",40,"ل",2,0],["إِذا جِئنا عَلى جُردٍ عِتاقٍ","بِسُمرٍ في عَواليها خَواظي",41,"ظ",2,0],["إِذا جَلَسوا أَلفَيتَ رَشحَ جُلودِهِم","مِنَ المِسكِ وَالجادِيِّ جَفناً مُبَدَّدا",42,"د",2,0],["إِذا جائَهُ السُؤآلُ أَنهَبَ مالَهُ","وَقالَ خُذوهُ إِنَّهُ عائِدٌ غَدا",43,"د",2,0],["إذا جئته تعشو إلى ضوء كاسه","تجد خير نار عندها خيرُ موقد",44,"د",1,0],["إذا جرّدت من بردها فهي عبلةٌ","وإن جرَّدت ألحاظها فهيَ عنتر",45,"ر",1,0],["إذا جمع الإنسانُ أطرافَ قصدِه","لنفحةِ مالٍ فهو جمعٌ مكسر",46,"ر",1,0],["إذا جئته للعلمِ والجودِ طالباً","فيا لك بحر باهر الفضل والفصل",47,"ل",1,0],["إذا جاءَ عثمان مستخبراً","عن المتقارب بحراً فقولوا",48,"ل",3,1],["إذا جلب الناس الثناء لبابه","فما جلبوا إلاَّ لباب زبونه",49,"ن",2,0],["إذا جالَ فكرِي في لماه وخده","تنزهت ما بين العذيب ونعمان",50,"ن",1,0],["إذا جاءَ بالوجناء كالبيت حاتم","فمن جود مولانا قلاعٌ وبلدان",51,"ن",1,0],["إذا جالَ فكري في تسرُّع جوده","تقول القوافي إنه من سليمان",52,"ن",1,0],["إذا جلى الحروف فلست أرضى","سنا ابن هلال ثمَّ ولا الهلالا",53,"ل",2,0],["إذا جَنى الدهرُ على أهلِهِ","وزاد في عِدَّتِكُم أَعتَبا",54,"ب",2,0],["إذا جلا عن منزلٍ أهلُهُ","فأنت في أوتاده الرُّسَّبِ",55,"ب",1,0],["إذا جئتُ أشكو ما بقلبي من الأسى","إلى مؤنسي أبدى القلى وتغضَّبا",56,"ب",2,1],["إذا جُمِعَتْ ضِيفانُهُ ونساؤهُ","فبطنٌ على بطنٍ ونحر على نحر",57,"ر",1,0],["إذا جئتكم شاعراً قلتُمُ","مُبِينُ الزَّمانةِ والمُمْتحَن",58,"ن",1,0],["إذا جرى في فَعالٍ لم يقف سأماً","دون القواصي ولم ينكبْ عن السَّنَن",59,"ن",1,0],["إذا جُددتْ نعمةُ لامرئٍ","فتكميلُها جدَّةُ العافيَهْ",60,"ف",3,1],["إِذا جاءَ سِربٌ مِن نِساءٍ يَعُدنَها","تَجَرَّدنَ إِلّا مِن جَلابيبَ أَو خُمرِ",61,"ر",1,0],["إِذا جَدَّفتَ جوزيتَ عَلى التَجديفِ بِالنارِ","وَإِن أَحبَبتَ عُيِّرتَ مِنَ الجارَة وَالجارِ",62,"ر",1,1],["إِذا جَلَبَ الكَلامُ عَلَيَّ عاراً","هَجَرتُ النُطقَ أَحسَبُهُ حَراما",63,"م",2,0],["إِذا جَمَعَ الإِثنانِ جَمعاً رَمَيتُهُم","بِأَركانِها حَتّى تَخَلّى سَبيلُها",64,"ه",2,0],["إِذا جاوَزَ الإِثنَينِ سِرٌّ فَإِنَّهُ","بِنَثٍّ وَإِفشاءِ الحَديثِ قَمينُ",65,"ن",1,0],["اذا جنيت مكرهاً","فهل انا الذي جنى",66,"ن",2,0],["إذا جد الغرام له","جرى في دمعه دمه",67,"م",2,0],["إذا جهلت يوما علينا خصومنا","فإنك من جهل الخصوم مجير",68,"ر",1,0],["إِذا جاءَها هِندي كَبيرُ العُرفِ","فَقامَ في البابِ قِيامَ الضَيفِ",69,"ف",1,0],["إِذا جَنَّني اللَيلُ اِهتَزَزتُ إِلَيكُما","فَجَنحا إِلى سُعدى وَجَنحا إِلى سَلمى",70,"م",2,0],["إِذا جالَ في الأَعيادِ حَلَّ نِظامَها","أَوِ العُرسِ أَبلى في مَعالِمِهِ هَدما",70,"م",2,0],["إِذا جَزِعَ الفِتيانُ في وَقعِ حادِثٍ","فَمَن لِجَليلِ الأَمرِ أَو مُعضِلِ الحالِ",71,"ل",1,0],["إِذا جَدَّ الغَرامُ بِهِ","جَرى في دَمعِهِ دَمُهُ",72,"م",2,0],["إِذا جِئتَ المَنابِرَ كُنتَ قُسّاً","إِذا هُوَ في عُكاظَ عَلا السَناما",73,"م",2,0],["إِذا جَفا الدورَ فَاِنعَ النازِلينَ بِها","أَوِ المَمالِكَ فَاِندُبها كَأَطلالِ",74,"ل",1,0],["إِذا جَاءَتِ الأَعيادُ في كُلِّ مَسمَعٍ","تَجوبُ الثَرى شَرقاً وَغَرباً جَوائِبُه",75,"ب",2,0],["إِذا جَلَبَ الناسُ الوَشيجَ فَإِنَّهُ","بِهِنَّ وَفي لَبّاتِهِنَّ يُحَطَّمُ",76,"م",1,0],["إِذا جاثى القرينَ يفيءُ عنهُ","وقد أغرى به رَتْكَ النَّعامِ",77,"م",1,0],["إِذا جمعَ العشاقَ موقفُهمْ غداً","فواخجلتَا إنْ لم تُعِنِّي مدامعي",78,"ي",1,0],["إِذا جلَدي في الأمرِ خان ولم يقمْ","بنُصْرةِ عزمي نابَ عنه تجلُّدِي",79,"ي",1,0],["إِذا جادَ لم يعترِضْهُ المَلال","وطبَّقَ سَيبُ يديهِ الشِّعابْ",80,"ب",1,0],["إِذا جَدَّ ناعيهِ تَوَهَّمتَ أَنَّهُ","يُكَرِّرُ مِن أَخبارِهِ قَولَ مازِحِ",81,"ح",1,0],["إِذا جُدِحَت سودُ المَنايا فَأَخلَقُ ال","رِجالِ بِأَن يُسقى رَداهُنَّ سودُها",82,"د",3,0],["إِذا جَحَدتُ سِجالَ الغَيثِ رَيَّقَهُ","فَإِنَّ جودَكَ عِندي غَيرُ مَجحودِ",83,"د",1,0],["إِذا جُزتَ صَحراءَ الغُوَيرِ مُغَرِّباً","وَجازَتكَ بَطحاءَ السَواجيرِ يا سَعدُ",84,"د",1,0],["إِذا جِئتُمُ أُكرومَةً تَبهَرُ الوَرى","فَما هِيَ بِدعٌ مِن عُلاكُم وَلا نُكرُ",85,"ر",1,0],["إِذا جيبَت عَلَيهِ الدِرعُ راحَت","وَحَشوُ فُضولِها كَرَمٌ وَخيرُ",86,"ر",1,0],["إِذا جَحَدَ اللَهَ وَالمُرسَلي","نَ فَكَيفَ نُعاتِبُهُ في عُمَر",87,"ر",1,0],["إِذا جالَتِ الأَفكارُ فيكَ تَبَيَّنَت","بِأَنَّكَ لا تَحوي مَكارِمَكَ الفِكرُ",88,"ر",1,0],["إِذا جَمَعَ اِمرُؤٌ حَزماً وَعَقلاً","فَحُقَّ لَهُ بِذَلِكَ أَن يُطاعا",89,"ع",2,1],["إِذا جادَ كانَ الجودُ مِنهُ خَليقَةً","وَلَو ضَنَّ كانَ الضَنُّ مِنهُ تَخَلُّقَ",90,"ق",1,0],["إِذا جَهِلوا مِن أَينَ تُحتَضَرُ العُلا","دَرى كَيفَ يَسمو في ذُراها وَيَرتَقي",91,"ق",2,0],["إِذا جارَتِ الآمالُ عَن قَصدِها اِغتَدى","إِلَيها نَداهُ الجَزلُ وَهوَ دَليلُها",92,"ل",3,0],["إِذا جاءَ أَغضى العاذِلونَ وَكَفَّهُم","قَديمُ مَساعيهِ الَّتي يَتَقَبَّلُ",93,"ل",1,0],["إِذا جازَ حُكمُ اِمرِىءٍ مُلحِدٍ","عَلى مُسلِمٍ هَلَكَ المُسلِمُ",94,"م",1,0],["إِذا جَعَلنا سَنا إِشراقِهِ عَلَماً","إِلى مَصابٍ نَدى كَفَّيهِ أَدّانا",95,"ن",2,0],["إِذا جَرى نَحوَ غايَةٍ عَبَأَت","لَهُ الرَدى مِن زَمانِهِ إِحَنُه",96,"ن",2,0],["إِذا جَلَسوا زانَ النَدِيَّ جُلوسُهُم","وَلَيسوا بِفُحّاشٍ عَلى الناسِ أَكلُبِ",97,"ب",1,0],["إِذا جاشَت ذُراهُ بِجُنحِ لَيلٍ","حَسِبتَ عَلَيهِ حَرّاتٍ وَلابا",98,"ب",2,0],["إِذا جَمَعَت لَهُ لَبَناً أَتَتهُ","بِضَهلِ وَتينِها تَخشى الغِرارا",99,"ر",2,0],["إِذا جُعِلَ الرَغامِ أَبو جَريرٍ","تَرَدَّدَ دونَ حُفرَتِهِ فَحارا",100,"ر",2,0],["إِذا جَعفَرٌ مَرَّت عَلى هَضبَةِ الحِمى","تَقَنَّعُ إِذ صاحَت إِلَيها قُبورُها",101,"ر",3,0],["إِذا جَرَّدوا أَسيافَهُم لِكَتيبَةٍ","لَمَعنَ وَميضَ العارِضِ المُتَدافِعِ",102,"ع",1,0],["إِذا جاءَني يَومَ القِيامَةِ قائِدٌ","عَنيفٌ وَسَوّاقٌ يَسوقُ الفَرَزدَقا",103,"ق",2,0],["إِذا جاشَ بَحرُ العِزِّ مِنّا تَلاطَمَت","أَوازِيُّ مِنّا بِالخُيولِ وَبِالرِجلِ",104,"ل",1,0],["إِذا جَشَأَت نَفسي أَقولُ لَها اِرجِعي","وَرائِكِ وَاِستَحيِي بَياضَ اللَهازِمِ",105,"م",1,0],["إذا جَلا الغَيمُ له","عن حاجبِ الشَّمسِ بَرَقْ",106,"ق",1,0],["إذا جَرَيْنَ على أرضٍ مُمَسَّكَةٍ","أَثرْنَ بالجَرْيِ منها نَقْعَ كافورِ",107,"ر",1,0],["إِذا جَرَّفَت مالي الجَوارِفُ مَرَّةً","تَضَمَّنَ رِسلاً حاجَتي اِبنُ سِنانِ",108,"ن",1,0],["إِذا جَمَحَت نِساؤُكُمُ إِلَيهِ","أَشَظَّ كَأَنَّهُ مَسَدٌ مُغارُ",109,"ر",1,0],["إِذا جِئتُ أَفضَلَهُم لِلسَلا","مِ رَدَّ وَأَحشاؤُهُ تُعِدُ",110,"د",1,0],["إِذا جازَيتَ بِالإِحسانِ قَوماً","زَجَرتَ المُذنِبينَ عَنِ الذُنوبِ",111,"ب",1,1],["إِذا جَفَلَت بي في ضِياعِ دَبَرَّشٍ","فَلَيسَ لَها قَبضٌ سِوى في جَوى فَرسِ",112,"س",1,0],["إِذا جَسَّ لِلعُشّاقِ عُشّاقَ نَغمَةٍ","يُشارِكُها في اليَمِّ رَستٌ وَسَلمَكُ",113,"ك",1,0],["إِذا جُلِيَت في كَأسِها وَتَبَرَّجَت","وَزادَت نُفوسَ الوامِقينَ بِها عُجبا",114,"ب",2,0],["إِذا جالَ في يومِ الرَدى قيلَ مَن لَهُ","وَإِن جادَ في يَومِ النَدى قيلَ مَن بِهِ",115,"ب",2,0],["إِذا جِئتُهُم مُستَصرِخاً حَقَنوا دَمي","وَإِن جِئتُهُم مُستَجدِياً وَفَروا وَفري",116,"ي",1,0],["إِذا جادَ فَالبيدُ السَباسُبُ أَبحُرٌ","وَإِن صالَ فَالشُمُّ الشَواهِقُ بيدُ",117,"د",1,0],["إِذا جولِسَت لِلبَذلِ ذُلَّ نِظارُها","وَإِن سوجِلَت في الفَضلِ عَزَّ نَظيرُها",118,"ر",3,0],["إِذا جَرَينا إِلى سَبقِ العُلى طَلَقاً","إِن لَم نَكُن سُبَّقاً كُنّا مُصَلّينا",119,"ن",2,0],["إِذا جَلَسوا كانوا صُدورَ مَجالِسٍ","وَإِن رَكِبوا كانوا صُدورَ مَواكِبِ",120,"ب",1,0],["إِذا جُرِّدَا لم يفتكا عَن تعمدٍ","وإن أُغمدَا فالفَتكُ أروع في الغمدِ",121,"د",1,0],["إذا جادوا فأنواءُ العطايا","وإن حلموا فأطوادُ الحلومِ",122,"م",1,0],["إذاْ جارَ دهرٌ كان منه ملاذُنا","بِحِقْوَي أبيٍّ قيّمِ الملكِ عادِلِه",123,"ل",2,0],["إِذا جاءَ في جنح الدجى نحو غيله","تَصَدّى له في القوس أسمَرُ مُغْتالُ",124,"ل",1,0],["إذا جالَ في عِلمِ الغيوبِ حَسبْتَهُ","مُسَيلِمَةَ الكذّابَ قامَ منَ القبرِ",125,"ر",1,0],["إِذا جارَ هَمُّ الفَتى وَاعتَدى","رَأَيتَ بِها نَفْسَهُ مُستَجيرَه",126,"ر",2,0],["إِذا جُمِعَتْ هَذِي السَّجايا لأوحدٍ","فما الحقّ إلّا أَن يَراه الوَرى فَردا",127,"د",2,0],["إذا جُلِدَتْ ظلماً ببعض جُلودها","تَبَوّع منها في النّجاء ضروبُ",128,"ب",1,0],["إِذا جارَيتَ في خُلُقٍ دَنيئاً","فَأَنتَ وَمَن تُجاريهِ سَواءُ",129,"ا",2,1],["إِذا جانَبوني جانِباً مِن وِصالِهِم","عَلِقتُ بِأَطرافِ المُنى وَالمَواعِدِ",130,"د",1,0],["إِذا جِئتِ فَاِمنَح طَرفَ عَينَيكَ غَيرَنا","لِكَي يَحسِبوا أَنَّ الهَوى حَيثُ تَنظُرُ",131,"ر",1,0],["إِذا جِئتَها فَاِقرَ السَلامَ وَقُل لَها","ذَرى الجَورَ لَيلى وَاِسلُكي مَنهَجاً قَصدا",132,"د",2,0],["إِذا جَنَّ لَيلي جُنَّ عَقلي بِذِكرِها","وَعِندَ طُلوعِ الشَمسِ إِشراقُ نورُها",133,"ر",3,0],["إِذا جِئتَ بابَ الشِعبِ شِعبَ اِبنِ عامِرٍ","فَأَقرِ غَزالَ الشِعبِ مِنّي سَلامِيا",134,"ي",2,0],["إِذا جاءَ قَعقَعنَ الحُلِيَّ وَلَم أَكُن","إِذا جِئتُ أَرضي صَوتَ تِلكَ الخَلاخِلِ",135,"ل",1,0],["إِذا جِئتَهُ في الناسِ مِنهُ عَلى الرَجا","أَلَمَّ بِقَلبٍ مُستَطارِ الخَوافِقِ",136,"ق",1,0],["إِذا جاءَني مِنها الكِتابُ بِعَينِهِ","خَلَوتُ بِبَيتي حَيثُ كُنتُ مِنَ الأَرضِ",137,"ض",1,1],["إِذا جَلَسوا في مَجلِسٍ نَدَروا دَمي","فَكَيفَ تُراها عِندَ ذاكَ تُجيرُ",138,"ر",1,0],["إِذا جِئتُها وَسطَ النِساءِ مَنَحتُها","صُدوداً كَأَنَّ النَفسَ لَيسَت تُريدُها",139,"د",3,0],["إذا جَدَّ أمرٌ تولَّى به","من الهزل شُغلٌ له شاغلُ",140,"ل",1,0],["إذا جئتَ الجِنانَ فَحيِّ عنِّي","منازلَ فتيةٍ رفعوا القِبابا",141,"ب",2,0],["إذا جَدَّ النِّزالُ ارْتَدَّ يعدو","وأقبلَ بالفوارسِ راكضينا",142,"ن",2,0],["إذا جَعلوا العُقوقَ لها جزاءً","أَبَيْنا أن نَعُقَّ وأن نخونا",142,"ن",2,0],["إذا جَدَّ النِّضالُ أَبَوْا عليهم","ومالوا بالمناكبِ هازلينا",142,"ن",2,0],["إِذا جَحَدَت تَدميرَ أُخرى تَهابُها","أَتاها مِنَ التَدميرِ ما لَيسَ يُجحَدُ",143,"د",1,0],["إِذا جالَ ماءُ النيلِ في جَوفِ شارِبٍ","فَلَيسَ لَهُ إِن خانَ أَبناءَهُ عُذرُ",144,"ر",1,0],["إذا جاءَهُ المكروبُ والهمُّ جاثِمٌ","كفَى ما به حتَّى كأنْ لم يكُنْ كَرْبُ",145,"ب",1,0],["إذا جاءَ النساءُ مُهَاجِراتٍ","يُرِدْنَ اللَّهَ دَيَّانَ الشُّعوبِ",146,"ب",1,0],["إذا جَرَت خَلفَهُ الأروَاحُ تفهم من","تَرجِيعِهَا أنَّهَا أنفَاسُ ذِي كَلَلِ",147,"ل",1,0],["إِذا جِئتَها تَبكي بَكَت وَتَذكَّرَت","مَعَ الحُزنِ صَولاتِ اِمرِئٍ غَيرَ زُمَّحِ",148,"ح",1,0],["إِذا جِئتَها فَاقرى السَلام وَقُل لَها","دَعي الجَورَ لَيلى وَاِنهِجي مِنهجاً قَصدا",149,"د",2,0],["إِذا جادَ لي عِندَ الخَلاصِ بِقُبلَةٍ","وَجَدتُ بِها بَرداً عَلى حَرِّ أَنفاسي",150,"ي",1,0],["إِذا جاءَنا العافي رَأى في وُجوهِنا","طَلاقَةَ أَيدينا وَبَشَّرَهُ البِشرُ",151,"ر",1,0],["إذا جِئْتُهُ وَحْدِي يقُومُ بِنُصْرَتي","قبائلُ مِنْ إقبالِهِ وعَشيرُ",152,"ر",1,0],["إذَا جَيَّشْتَ جَيْشاً في غَزاةٍ","تَرَى كُتَّابَهُمْ مُتباشِرينا",153,"ن",2,0],["إذا جئته من خلفه وأمامه","تثاءب ضرغام وشال فنيق",154,"ق",1,0],["إذا جَمَحَ الأعداءُ رَدّ جِماحَهُمْ","إلى جَذَعٍ يُزجي الحوادثَ أزلم",155,"م",1,0],["إِذا جَرى الماءُ في جَوانِبِها","هَيَّجَ مِنها كَوامِنَ الشَغَبِ",156,"ب",1,0],["إِذا جاءَ ذَنباً لَم يَرُم مِنهُ مَخلَصاً","وَإِن أَنا أَذنَبتُ اعتَذَرتُ إِلَيهِ",157,"ي",2,0],["إِذا جئتَهُ يَوماً أَحالَ عَلى غَدٍ","كَما وَعَدَ الكَمّونُ ما لَيسَ يَصدُقُ",158,"ق",1,0],["إِذا جاراكَ لوطِيٌّ","فَأَنتَ المُسهِبُ الكُبرُ",159,"ر",1,0],["إِذا جَلَسَ المَهديُّ عَمَّت فُضُولُهُ","عَلَينا كَما عَمَّ الضِياءُ مِنَ البَدرِ",160,"ر",1,0],["إِذا جَمَعَ الإِنسانُ رَأياً وَنَجدَةً","وَنَفساً عَزوفاً سادَ وَاِحتَقَبَ المَجدا",161,"د",2,0],["إِذا جِئتَهُ لِلحَمدِ أَشرَقَ وَجهُهُ","إِلَيكَ وَأَعطاكَ الكَرامَةَ بِالحَمدِ",162,"د",1,1],["إِذا جِئتِ حَرّاناً وَزُرتِ أَميرَها","فَرَبُّكِ مَضمونٌ وَواديكِ مُعشِبُ",163,"ب",1,0],["إِذا جاهَدَتهُ الشَدَّ جَدَّ وَإِن وَنَت","تَساقَطَ لا وانٍ وَلا مُتَخاذِلُ",164,"ل",1,0],["إِذا جَولِسَ الأَقوامُ بِالحَقِّ أَصبَحوا","عُداةً فَكُلُّ الأَصفِياءِ عَلى خِبِّ",165,"ب",1,0],["إِذا جَلَّ خَطبٌ ساعَدَ المَرءَ ضِدَّهُ","وَلا خَيرَ في الإِخوانِ إِن لَم تُساعِدِ",166,"د",1,0],["إِذا جَلَستُ عَلى أَقتادِ ناجِيَةٍ","فَما أُبالي أَغارَ القَومُ أَم جَلَسوا",167,"س",3,1],["إِذا جَرَحوا دَنّاً فَلَم يَرجُ عِندَهُم","قِصاصاً أَجادوا قَتلَ عَذراءَ عاتِقِ",168,"ق",1,0],["إِذا جالَسَتهُم فَأَقَلُّ شَيءٍ","تَجُرُّ بِذاكَ أَن تُدعى ثَقيلا",169,"ل",2,0],["إِذا جَهَّزَتني غائِباً غَيرَ آيِبٍ","تَرَكتُ لَها ما حَمَّلَتني مِنَ الثِقلِ",170,"ل",1,0],["إِذا جَلَسوا خَيَّلتَ تَحتَ ثِيابِهِم","خَرانِقَ توفي بِالضَغيبِ لَها نَذرا",171,"ر",2,0],["إِذا جاءَ ما لا بُدَّ مِنهُ فَمَرحَباً","بِهِ حينَ يَأتي لا كِذابٌ وَلا عِلَل",172,"ل",1,0],["إِذا جاوَزَت مِنها بِلاداً تَناوَلَت","مَهامِهَ بيداً بَينَهُنَّ عَريضُ",173,"ض",1,0],["إِذا جاءَ سِربٌ مِن ظِباءٍ يَعُدنَهُ","تَبادَرنَ شَتّى كُلُّهُنَّ تَنوحُ",174,"ح",1,0],["إِذا جاءَ ذُو خُرجَينِ مِنهُم مُقَعنِساً","مِنَ الشَأمِ فاعلَم أَنَّه شرُّ قافِلِ",175,"ل",1,0],["إذا جئتُها صدَّتْ حَياءً بوجهِها","فتهجرني هجراً أَلذّ منَ الوصْلِ",176,"ل",1,0],["إذا جالسَ الفِتيانَ أَلفَيتَهُ فتىً","وجالسَ كهلَ النّاس أَلفيتَهُ كَهْلا",177,"ل",2,1],["إذا جادَ أقوامٌ بمالٍ رأيْتَهُمْ","يَجودونَ بالأرواحِ مِنْهُمْ بِلا بُخل",178,"ل",1,0],["إِذا جمعت شكوكي","فَلا تُساوي يَقينا",179,"ن",2,0],["إِذا جاءَ يدلى بالوَلاء منافق","فَذاكَ بعطف منك غير خَليقِ",180,"ق",1,1],["إذا جئتني لَيلاً فدعنيَ راقداً","وَفي الصبح أَيقظني متى غنت الورق",181,"ق",1,0],["إذا جنّها الليلُ لاحتْ به","كعينٍ من اللهبِ المضطرمْ",182,"م",1,0],["إِذا جِئتُها يَوماً مِنَ الدَهرِ زائِراً","تَعَرَّضَ مَنفوضُ اليَدَينِ صَدودُ",183,"د",1,0],["إذا جاشَ بالماءِ الحَمِيمِ سِجالُها","نَضَخْنَ بِهِ نَضْخَ المَزادِ المسَرَّبِ",184,"ب",1,0],["إذا جَعَلَتْ سوادَ الشأمِ جَنْباً","وغُلِّقَ دونَها بابُ اللِّئامِ",185,"م",1,0],["إِذا جاءَت لَهُم تِسعونَ أَلفاً","عَوابِسُهُنَّ وَرداً أَو كُمَيتا",186,"ت",2,0],["إذا جَلّى ليالي الشهرِ سَيْرٌ","عليكَ أخَذْتَ أسْبَغَها حِدادا",187,"د",2,0],["إذا جَنّ ليْلي جُنّ لُبّي وزائِدٌ","خُفُوقُ فُؤادي كلَّما خَفَقَ الآل",188,"ل",1,0],["إذا جَمَحَتْ خَيْلُ الكَلامِ فإنما","لَدَيْكَ يُعانى من أعِنّتِها الضَّبْطُ",189,"ط",1,0],["إذا جروا لغاية لم يحفلوا","ما المركب الأعلى ولا ما الأسفل",190,"ل",1,0],["إِذا جرتِ الأَفْواهُ يوْماً بذِكْرِهَا","يُخَيَّلُ لِي أَنِّي أُقَبِّلُ فاهَا",191,"ا",3,0],["إِذا جاروا عَدَلنا في هَواهُم","وَإِن عَزّوا لِعِزِّتِهِم نَذِلُّ",192,"ل",1,0],["إِذَا جَاشَ طَبْعِي فَاضَ بِالدُّرِّ مَنْطِقِي","وَلا عَجَبٌ فَالدُّرُّ يَنْشَأُ فِي الْبَحْرِ",193,"ر",1,0],["إِذَا جَاءَهُ خَيرٌ أَذَاعَ الرِّضَى بِهِ","أَوْ جَاءَهُ ضَيْرٌ لَمْ تَخُنْهُ شَكَاةُ",194,"ه",1,0],["إذا جَنَى فِيهمُ الجَاني فَقَدْ عَلِمُوا","حَقّاً بأنَّ الذي قد جَرَّ مَحْمُولُ",195,"ل",1,0],["إذا جَاءَ منّا رَاكبٌ كانَ قولُهُ","أَعِدّوا لِما يُزْجي ابنُ حرْبٍ ويجمعُ",196,"ع",1,0],["إذا جادَ الغمامُ فلَستَ تدري","أدمعٌ في الورود أم ابتسام",197,"م",1,0],["إِذا جَنَّ لَيلٌ طارَدَ النَومَ طَرفُهُ","وَنَصَّ هُدى أَلحاظِهِ بِالمَطامِعِ",198,"ع",1,0],["إِذا جَفَت اِبنَها أُمٌّ فَعيّ","فَلَيتَ عِقابَها أَن تُستَحاضا",199,"ض",2,0],["إِذا جِئتَها لَم تَلقَ إِلّا مُكَبِّراً","تَخَلّى عَنِ الدُنيا وَإِلّا مِهَلِّلا",200,"ل",2,0],["إذا جاوزتْها للرَّبابِ غمامةٌ","سقاها من الحبِّ النَّدِيِّ رَبابُ",201,"ب",1,0],["إذا جَدَّ في تَعريسِهِ وبُكورِه","رَأيتَ بِقاعَ الأرضِ تُثْري وتُعْدِمُ",202,"م",1,0],["إذا جست الغيداء أوسط جيده","سمعت الذي تبدي كمثل الذي تلق",203,"ق",1,0],["إذا جذبوها إليهم حنوا","ظهورا ومدوا لها كل جيد",204,"د",1,0],["إذا جئت بالقلب السليم يجيئني","بقلب له من كَثرة الحقدأورام",205,"م",1,0],["إذا جَادَتِ الدُّنيا عَلَيْكَ فَجُدْ بها","على الناس طراً إنها تتقلب",206,"ب",1,1],["إذا جادَ أغضَى العَاذِلُونَ، وَكَفَّهمْ","قَديمُ مَسَاعيهِ الذي يَتَقَيّلُ",207,"ل",1,0],["إِذا جَمَعَ امْرؤٌ حَزْما وعَقْلاً","فحُقَّ لهُ بذالِك أَن يُطاعا",208,"ع",2,1],["إذا جِئتُمُ أُكْرُومَةً تَبْهَرُ الوَرَى،","فَما هيَ بِدْعٌ من عُلاكمْ، وَلاَ بِكرُ",209,"ر",1,0],["إذا جادَ كانَ الجُودُ منهُ خَليقَةً،","وإنْ ضَنّ كانَ الضّنُّ منْهُ تَخَلُّقَا",210,"ق",2,0],["إِذَا جَرَتِ الآمالُ عن قَصْدِها","اغْتَدَى إِليها نَدَاهُ الجَزْلُ وهو دَلِيلُهَا",211,"ل",3,0],["إذا جحد الله والمرسلي","ن فكيف وأن لا قدر",212,"ر",1,0],["إذا جُلِدَاتْ ظلماً ببعض جلُودها","تبوّع منها في النجّاء ضروب",213,"ب",1,0],["إذا جاب الكلام علّي عارا","هجرت النّطق أحسبه حراما",214,"م",2,0],["إذا جَاشَتْ دُرَاهُ بِجُنْحِ لَيْلٍ","حَسِبْتَ عَلَيْهِ حَرّاتٍ وَلابَا",215,"ب",2,0],["إذا جئتني ذات يوم بثوب","كعشب البحيرات أخضر أخضر",216,"ر",1,0],["إذا جئتكم زَمِناً قلتُمُ","مبين الزمانة ِ والممتحَن",217,"ن",1,0],["إذا جُددتْ نعمة ُ لامرىء","فتكميلُها جدَّة ُ العافيَة ْ",218,"ف",3,1],["إذا جار العتاب عليه أغْضَى","له جفناً وما غضَّاه ضَهْدُ",219,"د",1,0],["إذا جُرِّد لم يفتكا عن تعمدٍ","وإن أغمدا فالفتك أروع في الغمدِ",220,"د",1,0],["إِذَا جِئْتَها تَبْكِي بَكَتْ، وتَذَكَّرَتْ","معَ الحزن، صولاتِ امرىء ٍ غير زمَّحِ",221,"ح",1,0],["إذا جِئْتَها فَکقْرَ السَّلاَمَ وَقُلْ لَهَا:","ذَرِي الْجوَرَ لَيْلَى وَکسْلُكي مَنْهَجاً قَصْدا",222,"د",2,0],["إذا کجْتَمَعْنا هَجَرْنا كُلَّ فَاحِشَة ٍ","عِنْدَ کللِّقاء، وذَاكُمْ مَجْلِسٌ حَسَنُ",223,"ن",1,0],["إذا جَنَّنِي الليلُ کهْتَزَزْتُ إليكما","فجنحا إلى سعدى ، وجنحا إلى سلمى",224,"م",2,0],["إذا جحدتْ شمس النهارِ ضياءها","فَفَضْلُكِ لم يَجْحَدُهُ في الناسِ جاحِدُ",225,"د",1,0],["إذا جاشَ بالماءِ الحَميمِ سِجالُها","نَضَخْنَ به نَضْحَ البمزادِ المسرَّبِ",226,"ب",1,0]]}