"],[4727,"ألا ليت حكام الجزائر نسوةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215839",""],[4755,"دَعَا الشِّعرُ يا قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183641",""],[4755,"تُرَى ما لِهَذا اللَّيلِ طالَت دَقائِقُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=183901",""],[4755,"أَسَرَّت إِلى أُختِها","https://www.poetsgate.com/ViewPoem.aspx?id=190547",""],[4755,"طَلَبناكَ -يا ذا الجُودِ والفضلِ- مَوطِنا","https://www.poetsgate.com/ViewPoem.aspx?id=200019",""],[4759,"دمعة في وداعها","https://www.poetsgate.com/ViewPoem.aspx?id=203636",""],[4778,"سيبقى الورد فواحا","https://www.poetsgate.com/ViewPoem.aspx?id=204696",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[4858,"شباب الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=34448",""],[4865,"ألا أيها الويلات ويلة من بكى","https://www.poetsgate.com/ViewPoem.aspx?id=213877",""],[4953,"شوق إلىٰ بيوت الله!!","https://www.poetsgate.com/ViewPoem.aspx?id=214066",""],[5050,"أعامر أنت عندي خير صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=38196",""],[5206,"ضاق ذرعي","https://www.poetsgate.com/ViewPoem.aspx?id=148341",""],[5224,"أيا نفسي على الهجران نوحي","https://www.poetsgate.com/ViewPoem.aspx?id=121307",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"ألا بلغن يا راكباً حرفداً نضوي","https://www.poetsgate.com/ViewPoem.aspx?id=128825",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5415,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=212226",""],[5431,"ودفء به طهرٌ جليٌ وملمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=190446",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5431,"الرحمى ....","https://www.poetsgate.com/ViewPoem.aspx?id=215240",""],[5442,"مضى شهر الصيام فليت شعري","https://www.poetsgate.com/ViewPoem.aspx?id=114784",""],[709,"أَمَا وَالْهَوَى لَوْلاَ الْجُفُونُ السَّوَاحِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=2923",""],[5550,"سَألْتُ الشَّيخَ","https://www.poetsgate.com/ViewPoem.aspx?id=211542",""],[5550,"أَبُثُّ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213054",""],[5616,"آسام","https://www.poetsgate.com/ViewPoem.aspx?id=204837",""],[5628,"الى قريتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=178470",""],[5691,"سيداو (*)...!","https://www.poetsgate.com/ViewPoem.aspx?id=208171",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[6152,"صباحكِ خير","https://www.poetsgate.com/ViewPoem.aspx?id=203690",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""],[6260,"إليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68340&r=&rc=32",""],[422,"أتذكر أطلالاً تعفَّت وأرسما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22244&r=&rc=0",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""]],"verses":[["لَقَد ضَلَّ عَهدُكُمُ بِاللَوى","وَطالَ بِدَمعِيَ نِشدانُهُ",0,"ن",2,0],["لقَدْ ضَلّ مَنْ يَبْغي من البحْرِ ضَلّة","ولمْ يدْرِ أنّ البَحْرَ أنْمُلُكَ العشْرُ",1,"ر",1,0],["لقدْ ضِقْتُ ذرْعاً بالنّوى بعْدَ بُعْدِكُمْ","على أنّني للنّائِباتِ صَبورُ",2,"ر",1,0],["لقَدْ ضعْضَعَتْ حِلْمي ولمْ أرَ نَسْمَةً","تضَعْضَعَ منْ هبّاتِها جبَلٌ راسي",3,"س",2,0],["لَقَد ضُمِّنَتهُ حُفرَةٌ طابَ نَشرُها","وَطابَ جَنيناً ضُمِّنَتهُ جَنينُها",4,"ن",3,0],["لَقَد ضاعَ أَمرُ الناسِ إِذ ساسَ مُلكَهُم","وَصَيفٌ وَأَشناسٌ وَقَد عَظُمَ الكَربُ",5,"ب",1,0],["لقد ضاقت الأكوان وهْيَ رحيبةٌ","بما حُزتَ من فخر عظيم وسؤددِ",6,"د",1,0],["لقد ضربت كفّ الحياة على الحِجا","ستاراً فعِلم القوم في كنهها نزر",7,"ر",1,0],["لَقَد ضَمَّنوا الأَحسابَ صاحِبَ سَوأَةٍ","يُناجي بِها نَفساً لَئيماً ضَميرُها",8,"ر",3,0],["لَقَد ضَرِيَت قُفَيرَةُ بِالخَلايا","وَحَوكِ الدَرعِ مِن وَبَرِ الفِصالِ",9,"ل",1,0],["لَقَد ضَلَّ مَن تَحوي هَواهُ خَريدَةٌ","وَقَد ذَلَّ مَن تَقضي عَلَيهِ كَعابُ",10,"ب",1,0],["لقد ضللت وجناء باتت وأصبحت","يُهزُّ إليكم رحلها وقطوعها",11,"ع",3,0],["لَقَد ضَعضَعَتني وَهِيَ سِر وَلَم يَكُن","يُضَعضِعُني صرِفُ الزَمانِ إِذا عَدا",12,"د",2,0],["لَقَد ضاعَ فيهِم مالُهُ إِذ شَراهُمُ","وَليسَ عَجيباً أَن يَضيعَ حَرامُ",13,"م",1,0],["لَقَد ضَلَّ مَن يَبغي لِنَصرٍ إِساءَةً","وَخابَت مَساعيهِ وَخانَ التَفَضُّلا",14,"ل",2,0],["لَقَد ضاعَفتَ ياروحي","لِروحي الهَمَّ وَالنَصَبا",15,"ب",2,0],["لقد ضحكت فكان الضحك ملء فمي","من الذي قال ان الكون محدود",16,"د",1,0],["لقد ضاع الفخار على الخفير","وضاعت عنده نعم الأمير",17,"ر",1,0],["لَقَد ضَمِنَ العَلاءُ بَديءَ جودٍ","نِجارُ أَبي العَلاءِ بِهِ كَفيلُ",18,"ل",1,0],["لَقَد ضَمَّتِ الأَكفانُ مِن آلِ دارِمٍ","فَتىً فايِضَ الكَفَّينِ مَحضَ الضَرايِبِ",19,"ب",1,0],["لَقَد ضَمِنَت أَرضٌ بِإِصطَخرَ مَيِّتاً","كَريماً إِذا الأَنواءُ خَفَّ سَحابُها",20,"ب",3,0],["لَقَد ضَرَبَ الحَجّاجُ ضَربَةَ حازِمٍ","كَبا جُندُ إِبليسٍ لَها وَتَضَعضَعوا",21,"ع",3,1],["لَقَد ضَرَبَت لَو أَنَّهُ كانَ مُبقِياً","حَياةً عَلى أَشلاءِ قَلبي سِهامُها",22,"م",3,0],["لَقَد ضاقَ ذَرعي بِالحَياةِ وَقَطَّعَت","حَوامِلُهُ عَضَّ الحَديدِ الأَوازِمِ",23,"م",1,0],["لَقَد ضَمِنَت قُبورُهُمُ وَوارَت","مَضارِبَ كُلِّ مَصقولٍ يَمانِ",24,"ن",1,0],["لَقَد ضَلَّ عُبّادُ النُّجومِ وما اهتَدوا","بِبَعثِ رَسولٍ للأَنامِ ولا ذِكرِ",25,"ر",1,0],["لَقَد ضاقَتِ الدُنيا عَلَيَّ بِأَسرِها","بِهِجرانِهِ حَتّى كَأَنِّيَ في حَبسِ",26,"س",1,0],["لَقَد ضَحِكَ الصَباحُ بِمُجتَلاهُ","وَراءَ اللَيلِ عَن ثَغرٍ شَنيبِ",27,"ب",1,0],["لَقَد ضاقَ حِلمُ النيلِ عَن جَهلِ فِتيَةٍ","جَزوهُ مِنَ الحُسنى عُقوقاً وَمَلأَما",28,"م",2,0],["لَقَد ضاعَ بَعدكُمُ مَجدُهُ","وَكُلُّ المَثالبِ في ضَيعتِه",29,"ت",2,0],["لَقَد ضَرَبنا بِالطَبلِ أَنَّكَ في ال","قَومِ صَحيحٌ وَصيحَ في البوقِ",30,"ق",1,0],["لَقَد ضَلَّ هَذا الخَلقُ ما كانَ فيهُمُ","وَلا كائِنٌ حَتّى القِيامَةِ زاهِدُ",31,"د",1,0],["لَقَد ضَلَّ حِلمُ الناسِ مُذ عَهدِ آدَمَ","فَهَل هُوَ مِن ذاكَ الضَلالِ نَشيدُ",32,"د",1,0],["لَقَد ضَرَّ أَعدائي بِمالي وَمَنصبي","وأَما بِعِرضي أَو بجاهي فَما ضروا",33,"ر",3,0],["لقد ضلَّتِ الأرض في ليلها","فحقَّتْ بها لعْنة الآلهه",34,"ه",2,0],["لَقَد ضِقتُ ذرعاً بِالهَوى ثُمَّ بِالنَوى","وَلا ذَنبَ لي لكِنَّني أَتَجَمَّلُ",35,"ل",1,0],["لقد ضرب الله أمثاله","ومن يضلّل الله لا يهتدي",36,"د",2,0],["لقد ضقت ذرعا بالنوى بعد بعدكم","على أنني في النائبات صبور",37,"ر",1,0],["لقد ضل فيّ الحاسدون لغيهم","واني على رغم الاعادي ابو الهدى",38,"د",2,0],["لقد ضاق ذرعي والمصائب أقبلت","على وضيق سد رحب مجالي",39,"ل",2,0],["لقد ضاقَتِ الدنيا علىَّ بأسْرها","مِن أخلاقه واللوحُ والطولُ والعرضُ",40,"ض",1,0],["لقد ضاقَتْ الدنيا عليَّ بأسْرِها","كأنَّ قُرَابَ الأرض مِن بَعدكم شِبْرُ",41,"ر",1,0],["لَقَد ضاقَ ذو القَرنينِ ذَرعاً بِسَدِّهِ","فَقالَ أَعينوني فَقَد نَفِدَ الجُهدُ",42,"د",1,0],["لَقَد ضَلَّ فِكري وَضاقَ القَريضُ","بِوَصفِ نَدىً فاضَ حَتّى غَمَر",43,"ر",1,0],["لَقَد ضَلَّ اِمرُؤٌ رامَ اِهتِضامي","وَلَستُ مُشايِعاً أَهلَ الضَلالِ",44,"ل",1,0],["لقد ضَمَّتِ الأثراءُ منك مُرَزّأً","عظيمَ رَمَادِ النارِ مُشْتَرَكَ القِدْرِ",45,"ر",1,1],["لقد ضل فكري في مهامه لغزكم","ولم يلف من يوليه من طيّه نشرا",46,"ر",2,0],["لقد ضاع طفل غاب عن عين أمه","وان خلفتها غيرها في اعتنائها",47,"ا",3,0],["لقد ضيعوا أضعاف ماجوروا به","ويكفيهم هذا الذي قد جرى نهبا",48,"ب",2,0],["لقد ضاع عمر ساعة منه تشتري","بملء السما والأرض آيّة ضيعة",49,"ه",1,0],["لقد ضل سعيا من رأى الشرع ناقصا","وسنة خير الرسل ذات تقاصر",50,"ر",1,0],["لَقَد ضَلَّ قَومٌ مِن عُقَيلٍ وَما اِهتَدُوا","بَلى إِنَّهُم فِيما تَمَنَّوهُ عُميانُ",51,"ن",1,0],["لَقَد ضَلَّ مَن يَبغي مِنَ العُميِ هادِياً","وَقَد ذَلَّ مَن يَرجُو مِنَ المَعزِ راعيا",52,"ي",2,0],["لقد ضاق صدري بالحياة على القوى","فإمّا تجي بالعيش أو بالدراهم",53,"م",1,0],["لقد ضلَّ بينَ الهوى والعيونِ","رأيُ الفتى الحازم الأكيسِ",54,"س",1,0],["لقد ضاقت الدنيا عَليَّ بأسرها","بإعراضِه عنّ