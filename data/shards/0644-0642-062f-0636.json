"لقد ضاق عقلي عن تعرفِ خطبها","وأعجزتُ عن فحصٍ يزيح ستارا",81,"ر",2,0],["لقد ضحك الثغر بشراً به","وكان القطوب لديه عتيدا",82,"د",2,0],["لقد ضيّعوا ما اللّهُ باللّوْحِ حافظٌ","وقد كشَفوا ما اللّهُ بالغيبِ ساتِرُ",83,"ر",1,0],["لقد ضربت أنيابكم في صفاتهم","وعاد بلا ناب على الصخر آكله",84,"ل",2,0],["لَقَد ضَلَّ قَلبٌ بات في كلّ ليلةٍ","يُصادِي بُنيّاتِ الهوى ويصانعُ",85,"ع",1,0],["لَقَد ضَلّ مَن يَسترقّ الهَوى","وَعَبدُ الغَرامِ طَويلُ الشَّقا",86,"ا",1,1],["لقد ضلَّ بل قد ذَلَّ من ظنَّ أَنَّهُ","يُقَوِّمُ بالعَتْبِ النجومَ السَّوارِيا",87,"ي",2,0]]}