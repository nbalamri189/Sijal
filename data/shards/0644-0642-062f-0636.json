{"poems":[[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[77,"بحيث القباب البيض والأسل السمر","https://www.aldiwan.net/poem36489.html","الطويل"],[77,"أما وخيال في المنام يزور","https://www.aldiwan.net/poem36492.html","الطويل"],[77,"تعلقته من دوحة الجود والباس","https://www.aldiwan.net/poem35881.html","الطويل"],[35,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[54,"بكى لشتات الدين مكتئب صب","https://www.aldiwan.net/poem27660.html","الطويل"],[83,"ضريح أمير المسلمين محمد","https://www.aldiwan.net/poem54319.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[27,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[27,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[47,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[70,"مماليك مولانا الأمير وخيله","https://www.aldiwan.net/poem42691.html","الطويل"],[70,"أبى الله إلا أن تسود وتفضلا","https://www.aldiwan.net/poem42765.html","الطويل"],[70,"أيا من جاءني منه","https://www.aldiwan.net/poem43008.html","مجزوء الوافر"],[89,"الشعر كالفارس المغوار ذو جرة","https://www.aldiwan.net/poem44787.html","البسيط"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[45,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[28,"ألا أيها السؤال عن جلة القرى","https://www.aldiwan.net/poem1256.html",""],[28,"سقى الله قبراً يا سعيد تضمنت","https://www.aldiwan.net/poem1294.html",""],[28,"لقد ضرب الحجاج ضربة حازم","https://www.aldiwan.net/poem5305.html","الطويل"],[28,"أفاطم لا أنسى نعاس ولا سرى","https://www.aldiwan.net/poem5545.html","الطويل"],[28,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[28,"لقد علمت سكينة أن قلبي","https://www.aldiwan.net/poem5643.html","الوافر"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[44,"بنفسي حبيب سوف يثكلني نفسي","https://www.aldiwan.net/poem30234.html","الطويل"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[105,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[105,"متى ينهض الشرق من كبوته","https://www.aldiwan.net/poem43416.html","المتقارب"],[48,"يا عربيا من صنعة السوق","https://www.aldiwan.net/poem64452.html","المنسرح"],[46,"لعل نجوم الليل تعمل فكرها","https://www.aldiwan.net/poem22317.html","الطويل"],[46,"إلى الله أشكو مهجة لا تطيعني","https://www.aldiwan.net/poem22327.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85474","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39555","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43652","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142329","المتقارب"],[77,"أما وخيال في المنام يزور","https://www.poetsgate.com/ViewPoem.aspx?id=34134",""],[115,"نظمت بمن اهواه شعري زبرجدا","https://www.aldiwan.net/poem41139.html","عموديه"],[115,"بباب به الأملاك حطت رحالها","https://www.aldiwan.net/poem42155.html","الطويل"],[128,"ثقيل على كل الورى من تكبر","https://www.aldiwan.net/poem50587.html","الطويل"],[128,"أكلف نفسي الصبر بعد فراقكم","https://www.aldiwan.net/poem50610.html","الطويل"],[143,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[143,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[143,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[145,"لقد ضمت الأثراء منك مرزأً","https://www.aldiwan.net/poem2023.html","عموديه"],[147,"أيا جهبذا دقت معاني رموزه","https://www.aldiwan.net/poem47647.html","الطويل"],[160,"تولت فما من مطمع في لقائها","https://www.aldiwan.net/poem58712.html","الطويل"],[160,"عدوك مما عنك يسمع يا يحيى","https://www.aldiwan.net/poem58856.html","الطويل"],[160,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[160,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[169,"ألا رحلت نعم وأقفر نعمان","https://www.aldiwan.net/poem1683.html",""],[169,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[186,"حياتي تقضى بالسقام فليس لي","https://www.aldiwan.net/poem43294.html","الطويل"],[199,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[204,"بنفسي حبيب سوف يثكلني نفسي","https://www.aldiwan.net/poem53118.html","الطويل"],[211,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[211,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[225,"أجل أنا من أرضاك خلا موافيا","https://www.aldiwan.net/poem55092.html","الطويل"],[250,"لحى الله أيا ما مضت في بطالة","https://www.aldiwan.net/poem15076.html","الطويل"],[261,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[270,"تنامين في أثوابك العطرات","https://www.aldiwan.net/poem35223.html","الطويل"],[270,"طربت لصوت المجد حين دعاني","https://www.aldiwan.net/poem35595.html","الطويل"],[270,"أتطمع كالضليل بالوطر العالي","https://www.aldiwan.net/poem35625.html","الطويل"],[282,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[297,"سلا دارها أن أنبأ الطلل القفر","https://www.aldiwan.net/poem33254.html","الطويل"],[364,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[364,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[366,"ترى لحنيني أو حنين الحمائم","https://www.aldiwan.net/poem17269.html","الطويل"],[366,"رضيت بما أفنيت فارض بما بقى","https://www.aldiwan.net/poem17893.html","الطويل"],[371,"تعلم من مولاه طول حجابه","https://www.aldiwan.net/poem57523.html","الطويل"],[377,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[403,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[406,"لنفسك لم لا عذر قد نفذ العذر","https://www.aldiwan.net/poem50166.html","الطويل"],[406,"خليلي هل من رقدة أستعيرها","https://www.aldiwan.net/poem50173.html","الطويل"],[416,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[416,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[416,"سؤالك هذا الربع أين جوابه","https://www.aldiwan.net/poem54156.html","الطويل"],[416,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[429,"سلا ظبية الوعساء أين يمينها","https://www.aldiwan.net/poem39912.html","الطويل"],[453,"أيا حرقتي لجلالٍ مضى","https://www.aldiwan.net/poem61595.html","المتقارب"],[453,"كأنك لم تقرن بمجد مؤصل","https://www.aldiwan.net/poem61596.html","الطويل"],[464,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[551,"لعل زمانا بالثوية راجع","https://www.aldiwan.net/poem47727.html","الطويل"],[551,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[575,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"]],"verses":[["لَقَد ضَلَّ عَهدُكُمُ بِاللَوى","وَطالَ بِدَمعِيَ نِشدانُهُ",0,"ن",2,0],["لقَدْ ضَلّ مَنْ يَبْغي من البحْرِ ضَلّة","ولمْ يدْرِ أنّ البَحْرَ أنْمُلُكَ العشْرُ",1,"ر",1,0],["لقدْ ضِقْتُ ذرْعاً بالنّوى بعْدَ بُعْدِكُمْ","على أنّني للنّائِباتِ صَبورُ",2,"ر",1,0],["لقَدْ ضعْضَعَتْ حِلْمي ولمْ أرَ نَسْمَةً","تضَعْضَعَ منْ هبّاتِها جبَلٌ راسي",3,"س",2,0],["لَقَد ضُمِّنَتهُ حُفرَةٌ طابَ نَشرُها","وَطابَ جَنيناً ضُمِّنَتهُ جَنينُها",4,"ن",3,0],["لَقَد ضاعَ أَمرُ الناسِ إِذ ساسَ مُلكَهُم","وَصَيفٌ وَأَشناسٌ وَقَد عَظُمَ الكَربُ",5,"ب",1,0],["لقد ضاقت الأكوان وهْيَ رحيبةٌ","بما حُزتَ من فخر عظيم وسؤددِ",6,"د",1,0],["لقد ضربت كفّ الحياة على الحِجا","ستاراً فعِلم القوم في كنهها نزر",7,"ر",1,0],["لَقَد ضَمَّنوا الأَحسابَ صاحِبَ سَوأَةٍ","يُناجي بِها نَفساً لَئيماً ضَميرُها",8,"ر",3,0],["لَقَد ضَرِيَت قُفَيرَةُ بِالخَلايا","وَحَوكِ الدَرعِ مِن وَبَرِ الفِصالِ",9,"ل",1,0],["لَقَد ضَلَّ مَن تَحوي هَواهُ خَريدَةٌ","وَقَد ذَلَّ مَن تَقضي عَلَيهِ كَعابُ",10,"ب",1,0],["لقد ضللت وجناء باتت وأصبحت","يُهزُّ إليكم رحلها وقطوعها",11,"ع",3,0],["لَقَد ضَعضَعَتني وَهِيَ سِر وَلَم يَكُن","يُضَعضِعُني صرِفُ الزَمانِ إِذا عَدا",12,"د",2,0],["لَقَد ضاعَ فيهِم مالُهُ إِذ شَراهُمُ","وَليسَ عَجيباً أَن يَضيعَ حَرامُ",13,"م",1,0],["لَقَد ضَلَّ مَن يَبغي لِنَصرٍ إِساءَةً","وَخابَت مَساعيهِ وَخانَ التَفَضُّلا",14,"ل",2,0],["لَقَد ضاعَفتَ ياروحي","لِروحي الهَمَّ وَالنَصَبا",15,"ب",2,0],["لقد ضحكت فكان الضحك ملء فمي","من الذي قال ان الكون محدود",16,"د",1,0],["لقد ضاع الفخار على الخفير","وضاعت عنده نعم الأمير",17,"ر",1,0],["لَقَد ضَمِنَ العَلاءُ بَديءَ جودٍ","نِجارُ أَبي العَلاءِ بِهِ كَفيلُ",18,"ل",1,0],["لَقَد ضَمَّتِ الأَكفانُ مِن آلِ دارِمٍ","فَتىً فايِضَ الكَفَّينِ مَحضَ الضَرايِبِ",19,"ب",1,0],["لَقَد ضَمِنَت أَرضٌ بِإِصطَخرَ مَيِّتاً","كَريماً إِذا الأَنواءُ خَفَّ سَحابُها",20,"ب",3,0],["لَقَد ضَرَبَ الحَجّاجُ ضَربَةَ حازِمٍ","كَبا جُندُ إِبليسٍ لَها وَتَضَعضَعوا",21,"ع",3,1],["لَقَد ضَرَبَت لَو أَنَّهُ كانَ مُبقِياً","حَياةً عَلى أَشلاءِ قَلبي سِهامُها",22,"م",3,0],["لَقَد ضاقَ ذَرعي بِالحَياةِ وَقَطَّعَت","حَوامِلُهُ عَضَّ الحَديدِ الأَوازِمِ",23,"م",1,0],["لَقَد ضَمِنَت قُبورُهُمُ وَوارَت","مَضارِبَ كُلِّ مَصقولٍ يَمانِ",24,"ن",1,0],["لَقَد ضَلَّ عُبّادُ النُّجومِ وما اهتَدوا","بِبَعثِ رَسولٍ للأَنامِ ولا ذِكرِ",25,"ر",1,0],["لَقَد ضاقَتِ الدُنيا عَلَيَّ بِأَسرِها","بِهِجرانِهِ حَتّى كَأَنِّيَ في حَبسِ",26,"س",1,0],["لَقَد ضَحِكَ الصَباحُ بِمُجتَلاهُ","وَراءَ اللَيلِ عَن ثَغرٍ شَنيبِ",27,"ب",1,0],["لَقَد ضاقَ حِلمُ النيلِ عَن جَهلِ فِتيَةٍ","جَزوهُ مِنَ الحُسنى عُقوقاً وَمَلأَما",28,"م",2,0],["لَقَد ضاعَ بَعدكُمُ مَجدُهُ","وَكُلُّ المَثالبِ في ضَيعتِه",29,"ت",2,0],["لَقَد ضَرَبنا بِالطَبلِ أَنَّكَ في ال","قَومِ صَحيحٌ وَصيحَ في البوقِ",30,"ق",1,0],["لَقَد ضَلَّ هَذا الخَلقُ ما كانَ فيهُمُ","وَلا كائِنٌ حَتّى القِيامَةِ زاهِدُ",31,"د",1,0],["لَقَد ضَلَّ حِلمُ الناسِ مُذ عَهدِ آدَمَ","فَهَل هُوَ مِن ذاكَ الضَلالِ نَشيدُ",32,"د",1,0],["لَقَد ضَرَّ أَعدائي بِمالي وَمَنصبي","وأَما بِعِرضي أَو بجاهي فَما ضروا",33,"ر",3,0],["لقد ضلَّتِ الأرض في ليلها","فحقَّتْ بها لعْنة الآلهه",34,"ه",2,0],["لَقَد ضِقتُ ذرعاً بِالهَوى ثُمَّ بِالنَوى","وَلا ذَنبَ لي لكِنَّني أَتَجَمَّلُ",35,"ل",1,0],["لقد ضرب الله أمثاله","ومن يضلّل الله لا يهتدي",36,"ي",1,0],["لقد ضقت ذرعا بالنوى بعد بعدكم","على أنني في النائبات صبور",37,"ر",1,0],["لقد ضل فيّ الحاسدون لغيهم","واني على رغم الاعادي ابو الهدى",38,"د",2,0],["لقد ضاق ذرعي والمصائب أقبلت","على وضيق سد رحب مجالي",39,"ل",2,0],["لقد ضاقَتِ الدنيا علىَّ بأسْرها","مِن أخلاقه واللوحُ والطولُ والعرضُ",40,"ض",1,0],["لقد ضاقَتْ الدنيا عليَّ بأسْرِها","كأنَّ قُرَابَ الأرض مِن بَعدكم شِبْرُ",41,"ر",1,0],["لَقَد ضاقَ ذو القَرنينِ ذَرعاً بِسَدِّهِ","فَقالَ أَعينوني فَقَد نَفِدَ الجُهدُ",42,"د",1,0],["لَقَد ضَلَّ فِكري وَضاقَ القَريضُ","بِوَصفِ نَدىً فاضَ حَتّى غَمَر",43,"ر",1,0],["لَقَد ضَلَّ اِمرُؤٌ رامَ اِهتِضامي","وَلَستُ مُشايِعاً أَهلَ الضَلالِ",44,"ل",1,0],["لقد ضَمَّتِ الأثراءُ منك مُرَزّأً","عظيمَ رَمَادِ النارِ مُشْتَرَكَ القِدْرِ",45,"ر",1,1],["لقد ضل فكري في مهامه لغزكم","ولم يلف من يوليه من طيّه نشرا",46,"ر",2,0],["لقد ضاع طفل غاب عن عين أمه","وان خلفتها غيرها في اعتنائها",47,"ا",3,0],["لقد ضيعوا أضعاف ماجوروا به","ويكفيهم هذا الذي قد جرى نهبا",48,"ب",2,0],["لقد ضاع عمر ساعة منه تشتري","بملء السما والأرض آيّة ضيعة",49,"ه",1,0],["لقد ضل سعيا من رأى الشرع ناقصا","وسنة خير الرسل ذات تقاصر",50,"ر",1,0],["لَقَد ضَلَّ قَومٌ مِن عُقَيلٍ وَما اِهتَدُوا","بَلى إِنَّهُم فِيما تَمَنَّوهُ عُميانُ",51,"ن",1,0],["لَقَد ضَلَّ مَن يَبغي مِنَ العُميِ هادِياً","وَقَد ذَلَّ مَن يَرجُو مِنَ المَعزِ راعيا",52,"ي",2,0],["لقد ضاق صدري بالحياة على القوى","فإمّا تجي بالعيش أو بالدراهم",53,"م",1,0],["لقد ضلَّ بينَ الهوى والعيونِ","رأيُ الفتى الحازم الأكيسِ",54,"س",1,0],["لقد ضاقت الدنيا عَليَّ بأسرها","بإعراضِه عنّي كأنيَ في حَبسِ",55,"س",1,0],[