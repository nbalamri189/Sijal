{"poems":[[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[240,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[275,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[358,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[580,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137746",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145815","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66255","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94118","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94047","الوافر"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58362","السريع"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86334","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138555",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108325",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108326",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""]],"verses":[["وَإذ جَحَدوا الأديانَ لم يتقيّدوا","وَقَد زوّجوا مَن شاءَ مِن ملّةٍ أخرى",0,"ر",2,0],["وَإِذ جَميلَةُ توليني الجَميلَ وَعِندَ","الغانِياتِ وَراءَ الحُسنِ إِحسانُ",1,"ن",1,0],["وإذ جَمعَت حبّاتِه خِلتُ كفَّها","مُنوَّرَةً رَيّا عَليها النَّدى قَطَر",2,"ر",1,0],["وَإِذ جَدَّدَ الأَفراح رَوض عذارهِ","فَإِنّا عَلى خَلع العذار سنعذرُ",3,"ر",1,0],["وإِذ جَمَالُكِ قدْ أَغْرَى جَمِيلَكِ بِي","وَبي التعطف قد أَغراكِ عِطْفَاكِ",4,"ك",1,0],["وإذ جاد سبحانه منعما","على العالمين ببذل الدماء",5,"ا",2,0],["وإذ جفّتْ منابعُنا احتراقاً","وإذ كَبَتِ الحوافرُ بالجَوَادِ",6,"د",1,0],["وإذ جاء داعي البشر نادى مؤرخاً","بأحمد كفو المجد دامت لك البشرى",7,"ر",2,0],["وإذ جرت بالأماني فيه أرخها","سفينة البحر بسم اللَه مجراها",8,"ه",2,0],["وإذ جرى فيه شرقي الغدير حكى","وقت الأصيل نوال السيد الغربي",9,"ب",2,0],["وإذ جاء البشير وسر قلبي","وقيل بمن ترى شنفت سمعا",10,"ع",2,1],["وَإِذ جَمَعنا الحسَنين عِندَنا","زال بُؤس وَاِبتَغَينا رُشدنا",11,"ن",2,0],["وإذ جنى منْ كَرْمةٍ فوقه","عندَكَ للخمرة أعنابا",12,"ب",2,0],["وَاذجل قَدراً في الكَمالِ بِطَبعِهِ","وَطابَ لِكُل العالَمينَ اِجتِلاؤُهُ",13,"ه",1,0],["وإذ جرى الفلك بسر بدا","منه جرت دمعاً حشى نوح",14,"ح",1,0],["واذ جادت الافلاك فيها ببارقٍ","احنُّ لبرقٍ من ثناياكِ يلمعُ",15,"ع",1,0],["واذ جانس الاخلاق منك حملته","ولو انه منه بنؤُ بي الحمل",16,"ل",1,0],["وإذ جازها سبعاً طباقاً ليرتمي","إلى الحجب كي يحيا الدنو وكي يسما",17,"م",2,0],["وإذ جاءه بالهجرة الأذن هاجراً","لقوم ثووا أم القرى بوركت أما",17,"م",2,0]]}