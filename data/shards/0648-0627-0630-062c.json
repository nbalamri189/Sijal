{"poems":[[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[236,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[271,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[354,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[576,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"]],"verses":[["وَإذ جَحَدوا الأديانَ لم يتقيّدوا","وَقَد زوّجوا مَن شاءَ مِن ملّةٍ أخرى",0,"ر",2,0],["وَإِذ جَميلَةُ توليني الجَميلَ وَعِندَ","الغانِياتِ وَراءَ الحُسنِ إِحسانُ",1,"ن",1,0],["وإذ جَمعَت حبّاتِه خِلتُ كفَّها","مُنوَّرَةً رَيّا عَليها النَّدى قَطَر",2,"ر",1,0],["وَإِذ جَدَّدَ الأَفراح رَوض عذارهِ","فَإِنّا عَلى خَلع العذار سنعذرُ",3,"ر",1,0],["وإِذ جَمَالُكِ قدْ أَغْرَى جَمِيلَكِ بِي","وَبي التعطف قد أَغراكِ عِطْفَاكِ",4,"ك",1,0]]}