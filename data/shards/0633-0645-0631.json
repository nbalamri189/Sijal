//www.poetsgate.com/ViewPoem.aspx?id=181642",""],[5725,"قضي بعرشك ظهر الجان ياسبأُ","https://www.poetsgate.com/ViewPoem.aspx?id=181731",""],[5725,"سمراء كالخمر","https://www.poetsgate.com/ViewPoem.aspx?id=194537",""],[5725,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=200939",""],[5725,"اشتاقها","https://www.poetsgate.com/ViewPoem.aspx?id=203717",""],[5725,"الصلاة على محمد","https://www.poetsgate.com/ViewPoem.aspx?id=211490",""],[5817,"فاتنة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191046",""],[5887,"عانق الشوق فؤادي إذ ذكرت اليوم أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=35285",""],[5956,"سمراء خلف وقارِها","https://www.poetsgate.com/ViewPoem.aspx?id=182456",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6093,"أذكي الغرامَ بموْعدٍ وتلاقِ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176202",""],[6093,"شفتان وقهوة","https://www.poetsgate.com/ViewPoem.aspx?id=204117",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6097,"سمراء تختصر الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=186314",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[6202,"بنت قحطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86713&r=&rc=14",""],[1583,"هذه الأرض لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73069&r=&rc=26",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""],[5190,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78337&r=&rc=50",""]],"verses":[["سُمرِ التَرائِبِ وَالطُلى","بيضِ العَوارِضِ لا الشُعورِ",0,"ر",1,0],["سَمَرُ الرِّكَابِ إِذَا تَعَاوَرَهَا السُّرَى","مِنْ مُنْجِدٍ فِي الأَرْضِ أَوْ مِنْ مُتْهِمِ",1,"م",1,0],["سُمرُ العُجاياتِ يَترُكنَ الحَصى زِيَماً","لَم يَقِهِنَّ رُؤوسَ الأُكُمِ تَنعيلُ",2,"ل",1,0],["سمراء تطعن بالقوام ورُبَّما","نظرت فصالت بيضها مع سودها",3,"د",3,0],["سمراء إلاَّ أنها حنطيَّة","تروي عطاشاً للقا وجياعا",4,"ع",2,0],["سمراء حنطيَّة يغترّ مبسمها","فكلها بشفاه اللّثم مرشوف",5,"ف",1,0],["سمراء وشتها بنا","نته بياضاً ناصعا",6,"ع",2,0],["سَمَرتُها بَرَشاً كَالغُصنِ يَجذِبُهُ","دِعصُ النَقا في بَياضٍ مِنهُ رَجراجِ",7,"ج",1,0],["سمراء في مقلتيها السحر مستتر","وَالسحر إن كانَ حقاً فهو في المقل",8,"ل",1,0],["سمرٌ لهم بالشموس الغرّ واشجةٌ","تضيءُ أنسابهم شهباً وأقمارا",9,"ر",2,0],["سَمَرنا بهِ وجهلنَا اسمَهُ","وما حظُّه من رفيعِ الفنونْ",10,"ن",1,0],["سمراءُ بالأزهار تتَّشحُ","ألقتْ غُلالتها بإعجابِ",11,"ب",1,0],["سَمْرَاءُ تَهْفُو بِقَدٍّ","كَالرُّمْحِ لِيناً وَسُمْرَهْ",12,"ر",2,0],["سمرةُ اللون في محيَّاه تُزري","باخضرار الرياض في «نيسان»",13,"ن",1,0],["سمراءُ إنّ حقولَ التَبغ مُقْمِرةٌ","ولُؤلُؤُ البحر شفَّافٌ .. ومُبْتَكرُ",14,"ر",1,0],["سمراء والعينان زرقاوان","في قد الغلام",15,"م",1,0],["سمراء يا سؤلي وفرحة خاطري","جمع الزمان فكان يوم لقاك",16,"ك",1,0],["سمرةٌ فوق رقّةٍ تحت طِيبٍ","خَلطُ مسكٍ بماءِ وردٍ وبانِ",17,"ن",1,0],["سمر رشاق مغاني اللهو قد عمرت","بالحسن فهي الحسان العامريات",18,"ت",1,0],["سمرة كالسواد في العين سحرا","من سواد العيون هذا المداد",19,"د",1,0],["سُمرٌ إِناثٌ بِأَلحا","ظِهِنَّ بيضٌ ذُكورُ",20,"ر",1,0],["سَمَرتُ به إِلى سَحرٍ","وَلَيلى كلُّه سَحَرُ",21,"ر",1,0],["سمراءُ يَحفَظُها المَطعون كامنةً","في صَدرِه مثلَ حِفظِ السامِر السَّمَرا",22,"ر",2,0],["سُمْرٌ تصولُ بزُرْقٍ كلما نظرت","من خلفِ سِتْرِ غبارٍ صادتِ الصّيدا",23,"د",2,0],["سُمْرٌ هي السُمْرُ والأحداقُ أنصُلُها","فلا تقُلْ أردتِ الفُرسانُ خُرْصانُ",24,"ن",1,0],["سمرنا بها والطيف حشو ثيابنا","يراقب منا زورة زورها غب",25,"ب",1,0],["سمراء خلَّى البياضُ رغماً","للونها صبغةَ الجمالِ",26,"ل",1,0],["سمرتُ ففاسقني طرفُها","وألفاظُها ثم كنتُ العفيفا",27,"ف",2,0],["سمراءُ غارتْ عليها وهي تُشبهها","في القدّ واللون تحميها القنا السُّمُرُ",28,"ر",1,0],["سمرٌ منصَّلةٌ أسنَّةُ نقسهِ","يجري الردى والرزق من قنواتها",29,"ت",3,0],["سمرٌ أحاديثي بها","لا تنقضي أسمارها",30,"ر",3,0],["سمراءُ تثني السُّمرَ من أعطافها","باسدَّ في طعنِ الكماةِ وأرشقا",31,"ق",2,0],["سُمْرُ القَنا انْعَقَدَتْ على أرْكانهِ","بيضُ السِّنانِ تَ",32,"ت",1,0],["سمر تشق جفون النقع نافذة","كأنها لجفون النقع أميال",33,"ل",1,0],["سمَرٍ مَع الأستاذِ عبدِ القادرِ ال","صَحرَاويِّ الندبِ الأديبِ اللوذَعي",34,"ع",2,0],["سمر الرماح به والبيض قد ألفت","سودا الوقائع حتى دبجت بدم",35,"م",1,0],["سمراءُ إِلاَّ رقةَ الأَسْمَرِ","ودَعْ ذُبُولاً لاحَ في السَّمْهَرِي",36,"ر",2,1],["سمراءَ ذابلةِ المعاطِف واللُّمى","لكنَّ وردةَ خدِّها لم تَذْبُل",37,"ل",1,0],["سُمْرٌ تَرُوقُكَ رَأْيَ العَيْنِ عَارِيةً","وَمِنْ بَديعِ مَعانيهِ لَهَا حُلَلُ",38,"ل",1,0],["سَمريٌّ لو صكَّ حقاً جبالَ الط","ور بالعزم خَرّتِ الشمُّ هَذا",39,"ذ",2,0],["سمراء لولا هيف بأن في","أعطافها لم أعرف البانا",40,"ن",2,0],["سمرنا مع السمر العوالي لياليا","وهم سمروا في ذكر سعدى وفي لبنى",41,"ن",2,0],["سمراء يا حلوة","يا سمراء يا ملءَ غدي",42,"د",2,0],["سُمْرَ القَنا مَلْوِيَّةً سَماهِرا","وَإِنْ هَوَى الهاوِي عَلَى تَراتِرا",43,"ر",2,0],["سَمَرٌ لِعنان الأُنسِ بهِ","في القول الساحر إطلاق",44,"ق",1,0],["سمروا في قباب مجدٍ أعدُّوا","حارسيها الترهيبَ والترغيبا",45,"ب",2,0],["سَمراءُ كالصَعدَةِ السَمراءِ واضِحَةٌ","يَشفي لَمَى شَفَتَيها غُلَّةَ الصادي",46,"د",2,0],["سمراءُ تخطر في الوشاح المذهب","وتميس بين ربائبٍ أو ربربِ",47,"ب",1,1],["سمرة فيها أجدت الوصف لا","السمر أبغي لا ولا البيض الحسان",48,"ن",1,0],["سمَروا وكم قمرٍ يسامرهم بها","سَهِرَ الرقيبُ بطرْفِهِ النَّعَّاسِ",49,"س",1,0],["سُمرٌ مِنَ المَسِّ تَكسوها وَتَسلُبُها","أَيدي النَواعِمِ بيضٌ كَالمَها البُدُنِ",50,"ن",1,0],["سمر إذ الجبار سام دفاعها","وردت أسنتها نجيع وريده",51,"د",2,0],["سمر على غلافها ثعالب","تخلي حجاب القلب من أضغانه",52,"ه",1,0],["سمراء يا حلم الطفوله","يا منية النفس العليله",53,"ل",2,1],["سمراء يا أمل الفؤا","د وحلمه من الطفولة",53,"ل",2,0],["سَمراءُ لَها بِمُهجَتي مُعتَلَقٌ","فَالعَينُ لَها مُديمَةٌ بِالسَّمَرِ",54,"ر",1,0],["سمر الفؤاد ومن وافاه جاء حمى","يحمي ببيض ظبا تسطو وسمر قنا",55,"ن",2,0],["سمرنا وكان الندىّ بهيّا","بطلعتك النضرة الزاهيه",56,"ي",2,0],["سمرت مع النجوم فمر ليلي","ولم تكمل أحاديث السمير",57,"ر",1,0],["سُمْرُ الرِّماحِ وبِيضُ الهندِ تَشْتَوِرُ","في أخذ ثأرِكَ والأقدارُ تعتذرُ",58,"ر",1,1],["سَمرْنا وجنحُ الليل مُرخٍ جِلالَه","وخمرتُنا بُنٌّ وناقوسُنا شِعر",59,"ر",1,0],["سُمْرٌ تُريكَ من الأسنّةِ أنْجُماً","والحرْبُ تُخْفي في العَجاجِ صِعادَها",60,"د",3,0],["سمر كما اسمرّ الجنى","بِيض كما ابيضَّ الصدفْ",61,"ف",1,0],["سمر كلها الليالي لديهم","في أحاديث كلها أدبيه",62,"ي",2,0],["سُمْرٌ ذَوابِلُ لايُبَلُّ غَليلُها","إلاَّ إِذْا سُقَيتْ دَمَ المُهُجاتِ",63,"ت",1,0],["سمر الرماح لها في كفهم شرف","والرمح يشرف قدرا وهو محمول",64,"ل",1,0],["سمر ذوابل غير أنّ ذبولها","يخضر عن ورق من الأقيال",65,"ل",1,0],["سمرَ القُدودِ نهبنَ أعطافَ القَنا","حُمرَ الخُدودِ سلبنَ حُسنَ الحُورِ",66,"ر",1,0],["سمرقند كانت مأمنا وبجعلها","لقتل وغارات غدت غير مأمن",67,"ن",1,1],["سمرقند مأوى طيب عيش لحيه","ومشهد إكرام وبر لميته",68,"ه",1,1],["سمراءُ،تسكُنُها الشّموس ووهْجُها","وبوجْهها كلّ الشّموس نراها",69,"ا",3,0],["سمراء يا سمراء لي رغبة","باقية في النفس لا زائلة",70,"ل",2,0],["سَمرَاءُ يا أُمَّ الحُفاةِ التي","حُرَّاسُها الأَغرابُ سُرَّاقُها",71,"ق",3,0],["سمراءُ قد ملكت سمعي وناظِرَتي","فصرت عن منطق العذال في صَمَمِ",72,"م",1,0],["سَمَرٌ شِتائيٌّ وبردٌ قارسٌ","والشوقُ يعصفُ بالفؤادِ ويَحْرِقُ",73,"ق",1,0],["سمراءُ رفقًا بالمُعذَّبِ إنَّهُ","طرحَ الحياءَ وسرُّهُ كمْ ذاعَا",74,"ع",2,0],["سَمْرَاءُ مِنْ طِيْنِ الخُلُودِ نَفَخْتُهَا","سِحْرَاً عَلَى شَفَتِي يُرِيْقُ سُؤالا",75,"ل",2,0],["سَمْرَا.. يهِيمُ بِهَا فُلْكٌ وَمَلاحُ","البَحْرُ يَشْدُو مَعَ الأمْوَاجِ مَدَّاحُ",76,"ح",1,1],["سَمْرَاءُ ..ذَ الْقَلْبُ ذِي الأحْزَانُِ تُمْطِرُهُ","تَاهَ فِيْ جُرْحِنَا رَاقِ وَجَرَّاحُ",76,"ح",1,0],["سمْرَاءَ يَا مُهْجَةً ... كَالحْلْمِ رَفَّ هُنَا","دِفْئًا وَعِطْرًا مَعَ الأنْسَامِ تُفَّاحُ",76,"ح",1,0],["سمراء أتعبها الرحيل","