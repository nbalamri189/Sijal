{"poems":[[58,"للناس حرص على الدنيا بتدبير","https://www.aldiwan.net/poem31056.html","البسيط"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[102,"كفكف دموعك ليس ينفعك","https://www.aldiwan.net/poem33114.html","مجزوء الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"]],"verses":[["وَلُقمَةٌ بِجَريشِ الملِحِ آكُلُها","أَحَبُّ مِن لُقمَةٍ تُحشى بِزَنبورِ",0,"ر",1,0],["ولُقمةٍ ردَّها ما نسترقُّ به","وما نكافحُ زَقّوماً وغِسلينا",1,"ن",2,0],["ولقمتَ تضْمِدُ جرحهُ","لو كنتَ من أهلِ الفطنْ",2,"ن",1,0],["ولُقْمةٍ سدَّتْ فما جائعاً","رجَّحَتِ المِيزانَ في حَشْره",3,"ر",2,0]]}