{"poems":[[37,"وددت وما تغني الودادة أنني","https://www.aldiwan.net/poem39089.html","الطويل"],[95,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[30,"أقول لصاحبي من التعزي","https://www.aldiwan.net/poem5236.html","الوافر"],[30,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[35,"بلادي لو فهمت بسطت عذري","https://www.aldiwan.net/poem25876.html","الوافر"],[275,"يا ورد جور الذي حيا فأحيانا","https://www.aldiwan.net/poem35664.html","البسيط"],[302,"سقى صوب الحيا أرض الحجاز","https://www.aldiwan.net/poem33244.html","الوافر"],[342,"وكنت إذا ما جئت ليلى تبرقعت","https://www.aldiwan.net/poem45314.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2439","المنسرح"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66645","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18536","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62555","الوافر"],[1503,"","https://poetry.dctabudhabi.ae/diwan/poem/143595","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128716","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102057","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118422","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27956","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86534","الطويل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205460","الوافر"],[4788,"ذكرى تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=132307",""],[5198,"بدو وحضر","https://www.poetsgate.com/ViewPoem.aspx?id=136103",""],[5652,"تفاحة نيوتن","https://www.poetsgate.com/ViewPoem.aspx?id=208680",""]],"verses":[["إِلى أَهلِ أَجنادَينِ مِن أَرضِ مَنبِجٍ","عَلى الهَولِ إِذ ضَفرُ القُوى مُتَلاحِمُ",0,"م",1,0],["إِلَى أَهْلِهَا تَنْعَى النُّهَى وَالعَزائِمُ","فَتىً فَوْقَ مَا تَهْوَى العُلَى وَالْعَظَائِمُ",1,"م",1,1],["إِلى أَهلِ المَضايِقِ مِن كُلَيبٍ","كِلابٍ تَحتَ أَخبِيَةٍ صِغارِ",2,"ر",1,0],["إِلى أَهلِ العِراقِ وَإِنَّما هُم","بَقايا مِثلُ أَشلاءٍ وَهامِ",3,"م",1,0],["إِلى أَهلي الكِرامِ تُشاقُ نَفسي","فَهَل يَوماً إِلى وَطَني أُريعُ",4,"ع",1,0],["إليَّ أهدَتكَ مضموماً بأنملِها","حتى رأيتُ الهوى حُسناً وإحسانا",5,"ن",2,0],["إِلى أَهلِ الحِجازِ يحنُّ قَلبي","فوا شَوقي إلى أَهلِ الحجازِ",6,"ز",1,0],["إِلى أَهلِها إِنَّ العَوارِيَ حَقُّها","أَداءٌ بِإِحسانٍ إِلى مَن يُعيرُها",7,"ر",3,0],["إِلَيَّ أَهوى مِنَ الشَرابِ وَمِل","مالِ وَحُلوِ الحَياةِ وَالوَلَدِ",8,"د",1,0],["إلى أهلِ بيتٍ أذهبَ الرجسَ عنهمُ","وصُفُّوا من الأَدناسِ طُرّاً وطُيِّبوا",9,"ب",3,0],["إلى أهلِ بيتٍ ما لمن كان مؤمِناً","من النّاسِ عنهم في الولايةِ مَذهبُ",9,"ب",1,0],["إِلى أَهلِها غَيرَ مَخلوعَةٍ","وَما مَسَّها عِندَنا مِن نَكالِ",10,"ل",1,0],["إلى أهل الكِسا والبيت يُنْمَى","ومن ذاك الكسا معنى كساه",11,"ا",2,0],["إلى أهل الديانة أجمعينا","رسالة أهل ثغر صابرينا",12,"ن",2,1],["إلى أهل بدر سار كالشمس حوله","نجوم هدى منها البدور أوافل",13,"ل",1,0],["إلى أهل الصفا بالظعن عرِّج","لكي تشفي نفوساً شايقات",14,"ت",1,0],["الى اهليك بين اولى انتجاع","نداهم او اولى رفع شكايا",15,"ا",3,0],["إلى أهله من كلِّ حسٍّ وقوّة","فقرَّب أحباباً وأهلكَ أعداء",16,"ا",2,0],["إلى أهل وادي النيل مني تحيةً","تفاوح منها للثناء عبير",17,"ر",1,0],["إلى أهل الرسول غدت برحلي","عذافرة ترامى بالصحاري",18,"ر",2,0],["إليا هدنت الوقت مافادني فود","وإليا نخيت الحظ ألقاه ضدي",19,"د",2,0],["اليا هرج توافد الخزي والزيف","ومالت غصونه بالخوارم تثنا",20,"ن",2,0],["اليا همست غازي وغنّا غناها","يتجدد الاحساس بالشوق تجديد",21,"د",1,0]]}