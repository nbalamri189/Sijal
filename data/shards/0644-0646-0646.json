ظات على حائط شُباط","https://www.poetsgate.com/ViewPoem.aspx?id=210408",""],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5092,"حبٌ يورقُ في الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=175329",""],[5121,"هَذَا أَبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33665",""],[5150,"تشرين ثورة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=203546",""],[5160,"قد مضينا","https://www.poetsgate.com/ViewPoem.aspx?id=175137",""],[5187,"زورق الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29708",""],[5281,"غزَّة العزِّ","https://www.poetsgate.com/ViewPoem.aspx?id=199703",""],[5327,"الصُّبحُ الغَائب","https://www.poetsgate.com/ViewPoem.aspx?id=140331",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5431,"الحق دوما منتصرْ","https://www.poetsgate.com/ViewPoem.aspx?id=183046",""],[5431,"ياحلب...","https://www.poetsgate.com/ViewPoem.aspx?id=185009",""],[5431,"يامن لحبك بعد الله أنتسبُ","https://www.poetsgate.com/ViewPoem.aspx?id=185167",""],[5431,"هي الأقدار","https://www.poetsgate.com/ViewPoem.aspx?id=194659",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[5512,"الجولان","https://www.poetsgate.com/ViewPoem.aspx?id=204192",""],[5533,"شَمْسُ الحرِّية","https://www.poetsgate.com/ViewPoem.aspx?id=179733",""],[5558,"لنْ نَرى مِثلَ رُقِيِّ الشُّهَداءِ","https://www.poetsgate.com/ViewPoem.aspx?id=211876",""],[5720,"يا إلٰهي","https://www.poetsgate.com/ViewPoem.aspx?id=208688",""],[5725,"عرس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177970",""],[5842,"إلى جيش الغطاريف .. الجيش السوري","https://www.poetsgate.com/ViewPoem.aspx?id=68315",""],[5887,"دعونا اليوم نعلنها صراحة","https://www.poetsgate.com/ViewPoem.aspx?id=28327",""],[5937,"بَين رِمشَين","https://www.poetsgate.com/ViewPoem.aspx?id=211818",""],[5943,"اِصبر وصابر يافؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=37337",""],[5956,"مُقَلُ النِّسوانْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182614",""],[5956,"على العالَمين أن يدخل بفكرة الإنسانية العالمية","https://www.poetsgate.com/ViewPoem.aspx?id=182942",""],[5956,"الكِذْبُ في قلبي وقلبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192187",""],[5956,"فضل الله المتواصل","https://www.poetsgate.com/ViewPoem.aspx?id=193369",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6145,"دَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=7797",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""]],"verses":[["لِنَنزِعَ هَذِهِ الأَكفانَ عَنّا","وَنُبعَثَ في العَوالِمِ مِن جَديدِ",0,"د",1,0],["لِنَنظُرَ كَيفَ سَمَّكَ بانِياهُ","عَلى حِبّانَ ذي الحَسَبِ الكَريمِ",1,"م",1,0],["لِنَنقُلَ مِن نويركَ لَكُم تَحايا","تُحاكي في لَطافَتِها العَقارا",2,"ر",2,0],["لَن نُريكَ الوُدَّ حَتّى","تَبلُغَ النَجمَ يَداكا",3,"ك",2,0],["لن نراها إن لم نمت في هواها","أمةً حرَّة ودنيا جديدة",4,"د",2,0],["لن ننثني ولوَ أن صر","فَ الدهر ناصبنا العداء",5,"ا",2,0],["لن ننطفي ما دام فينا جراح","مسهّدات في انتظار الحريق",6,"ق",1,0],["لن ننطفي رغم احتشاد الرياح","فبيننا والنصر وعد وثيق",6,"ق",1,0],["لن نطيق السكوت فالصمت للمسي","ت وتأبى حياتنا أن نطيقه",7,"ق",2,0],["لننقل من \" نويورك \" لكم تحايا","تحاكي في لطافتها العقارا",8,"ر",2,0],["لنن تكُنّ الحقيقةَ ما ذكرتمُ","فإمساكَ المدامعِ لا يليقُ",9,"ق",1,0],["لِنَنظُرَ دَوحاً وَورَقاً عَلى","ذَوائِبِ أَغصانِها تَرقُصُ",10,"ص",1,0],["لن نمتهن","ابداً ولن",11,"ن",1,0],["لننصر دينا للنبي محمد","نبي الهدى المبعوثمن آل هاشم",12,"م",1,0],["لن نزيدَ الضياء وهجاً إذا نُدركِ","مَسراهُ من يدِ الآزال",13,"ل",1,0],["لن نحفلنَّ ببارح أو سانح","أو ناعب متعرض قد صاحا",14,"ح",2,0],["لن ندخل الحرب إلا بعد عهدكم","أن ترحلوا الدهر عن مصر وسودان",15,"ن",1,0],["لننهضنّ وَماضي العزم عدّتنا","فالمرهَف العضب لَولا العزم ما قَطَعا",16,"ع",2,0],["لَن نَكُن ندرك الحَقائق إِلّا","إِن تركنا الغلوّ وَالإغراقا",17,"ق",2,0],["لَن نكد نَستجلي حَتّى مَضى","ثُم صُرنا في خَيال جَديدْ",18,"د",1,0],["لننظر ما جرى فبكى","حماتي هاج أشجاني",19,"ي",1,0],["لِنَنظُرَ نَجماً يُهتَدى بِضِيائِهِ","وَشَمساً إِذا ما اللَيلُ أَظلَمَ ذَرَّتِ",20,"ت",1,0],["لن نقبل الظلم أو نرضى بمهزلة","من الحثالة أو من قمة الهرم",21,"م",1,0],["لَن نَكسِرَ الكَأسَ مَهْمَا أمطَرَتْ حَطَبًا","بَعدَ الرَّمَادِ, ومَهمَا.. سَوفَ نَنتَصِرُ",22,"ر",1,0],["لن نَمنَحَ العَبدَ شِبرًا فوقَ رُتبَتِهِ","أَو نَخفِضَ الرَّأسَ حتى لِلنَّياشِينِ",23,"ن",1,0],["لن نُعلِنَ اليَأسَ.. إِلَّا وَاثِقِينَ بهِ","لا شَيءَ كَاليَأسِ يَأتِي بِالبَرَاهِينِ",23,"ن",1,0],["لن نرى في دربنا الأمن إذا لم","يسبقِ الركبَ إلى الأمنِ دليل",24,"ل",1,0],["لَنْ نَبرَحَ العَهْدَ يَا لَحناً نُرَدِّدُهُ","لَنْ نُوقِفَ الشَّدوَ إِنْ عَبدٌ لَهَا أَبَقَا",25,"ق",2,0],["لِنَنثُرَ فَوقَ ثراها القُلوبَ","لِتُزهِرَ تلك القُلوبُ خُزامى",26,"م",2,0],["لَنْ نرَى للصَّهِيلِ معنًى أَصِيلاً","لَوْ أَضَعْنَا معنَى الجيَادِ الأَصِيلَهْ",27,"ل",2,0],["لن نلتقي أبدًا وحبُّها قاتلي","عجبًا لحبٍّ في فراغٍ يُورِقُ !!",28,"ق",1,0],["لَنْ نَسْتَبِيِحَ الإِنْفِصَامَ الْمُفْتَرِي","كَيْ نَسْتَرِيِحَ النَّهْجَ عِلْماً سُؤْدُدَا",29,"د",2,0],["لن ننثني عن نصرِنا.. لوخيبوا","آمالَنا.. أو كذَّبوا أحداسَنا",30,"ن",2,0],["لنْ نهادنَ لنْ نساومَ","ندفعُ الباغي الحقودْ",31,"د",1,0],["لنْ نخضعَ تحتَ إرادتِهِ","لن نقبل عدلاً بقرارِ",32,"ر",1,0],["لَن نَستَكِينَ، ولَنْ تَضِيعَ دِماؤنا","وإلى مَتى يَا قومُ سوفَ نُضَامُ؟!",33,"م",1,0],["لَن نبْقَى أُسَارَى أَمْرِيكا","سَنَفُكُّ قُيُودَ المُستَعمِرْ",34,"ر",1,0],["لننظر فيما يأتنا بعد أن يكنى","بحق فإننا لا نطيق نقابله",35,"ل",2,0],["لن ننكسر...لن ننكسرْ","الحق دوما منتصرْ",36,"ر",1,0],["لن نشرب الماء في أنهار فتنتنا","لالن يباعدنا عن فجرنا سببُ",37,"ب",1,0],["لن نغرفَ الماء في أنهار فتنتنا","لالن يباعدنا عن فجرنا سببُ",38,"ب",1,0],["لننهل من خبايا الوصل شهدا","بلاهجرٍ يُنبئ بامتعاضِ",39,"ض",1,0],["لن نَغرفَ الماءَ في أنهارِ فِتنَتِنَا","لا لن يُباعِدَنا عن فجرِنا تلفُ",40,"ف",1,0],["لن نقبلَ العيش َالاّ مجدنا سكنا","في أرضنا نرتدي من طُهرها الكفنا",41,"ن",2,1],["لن نستكينَ أمامكمْ لن ننحني","فالسَّيفُ يعزفُ أجملَ الألحانِ",42,"ن",1,0],["لَنْ نَسْتكينَ لظالِمٍ مَهْما طَغَى","وعُيُونُنا تَسْتَشْرِفُ الشُّهَداءَ",43,"ا",2,0],["لنْ نَرى أَثْمَنَ مِنْ جُودٍ بِرُوحٍ","لنْ نَرى مِثلَ رُقِيِّ الشُّهَداءِ",44,"ا",2,0],["لننعمَ بعدَهُ في دارِ خُلْدٍ","فأنتَ لنا الموفّقُ والمعِينُ",45,"ن",1,0],["لن ننسى ياوطني الذين تعاهدوا","امرا سيحكى للزمان مريجا",46,"ج",2,0],["لننسى كلَّ مأساةٍ","ونعملَ كلَّ معروفِ",47,"ف",1,0],["لن نرضى سلاما","به الأوطان تبقى مستباحة",48,"ح",2,0],["لن نرى سكةَ المحبةِ , مَالَمْ","نَدخُلِ الحُبَّ سُذّجاً تائِهينا",49,"ن",2,0],["لن نقبلَ السِّلمَ المُذلَّ من العدى","إنَّا نُعزُّ برفعةِ الإسلامِ",50,"م",1,0],["لن نُنْهيَ رحلتنا هذي","مهما تمتدُّ الأزمانْ",51,"ن",1,0],["لِنُنهيَ شرَّ معضلةٍ بَنَتْها","ميولُ العالَمينَ إلى العداءِ",52,"ا",2,0],["لن نهجر الإصلاح مهما الأنبيا","لم يُصلحوا والعالَمون جرائمُ",53,"م",1,0],["لن نعدم التطوير ما دام اْمرُؤٌ","فينا كخالدٍ الكريم المؤْثرِ",54,"ر",1,0],["لن نستطيع نرى العروبة مرةً","أخرى فلم تترك سوى الآثارِ",55,"ر",1,0],["لن نستكين إلى هدوء بعدها","حتى نَردَّ وقاحة الجبناء",56,"ا",2,0],["لن نسمعَ الخمرَ تُرغي وَسْطَ حنجرةٍ","فيها يُحَدِّثُ عن أسرارِهِ، العِنَبُ",57,"ب",1,0],["لن نقبل الشجب الذليل","ولكن الردّ السريعْ",58,"ع",1,0],["لن نبصر الحسن يوما فى جوانبها","إلا إذا عاد فى أبنائنا عمرُ ؟",59,"ر",1,0],["لن نبصر الحسن يوما فى جوانبها","ما دام فينا أبو جهل له أمرُ",59,"ر",1,0],["لن نبصر الحسن يوما فى جوانبها","إلا إذا حكمت ق أو الزمرُ",59,"ر",1,0],["لن نبصر الحسن يوما فى جوانبها","إن لم تعيدوا صلاح الدين يا بشرُ",59,"ر",1,0],["لن نبصر الحسن يوما فى جوانبها","إن غاب عن وعينا الأحزاب أو بدرُ",59,"ر",1,0],["لن نبصر الحسن يوما فى جوانبها","إن لم نكن لقضاء الله ننتظرُ",59,"ر",1,0]]}