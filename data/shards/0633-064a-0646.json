5,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5952,"سيرٌ إلى اللا أمام","https://www.poetsgate.com/ViewPoem.aspx?id=212589",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"أغلى امرىءٍ في الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=193977",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[5979,"كأنك حين ضل الناس عنها","https://www.poetsgate.com/ViewPoem.aspx?id=181359",""],[6093,"أخْلو ، ونفسيَ للهمومِ مَطَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=176070",""],[6093,"إذا ما أمْرضَتْ نفسي المعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=176267",""],[6093,"اللعبة","https://www.poetsgate.com/ViewPoem.aspx?id=206566",""],[6124,"عناقُ الحروفِ العاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=109747",""],[6124,"الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=159314",""],[6152,"عزاء ومواساة","https://www.poetsgate.com/ViewPoem.aspx?id=204657",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[6189,"اعترافات شاهد الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83556&r=&rc=23",""],[6225,"سيناءُ مِنّا ولنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81034&r=&rc=271",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""]],"verses":[["سَيَنبَحُ كَلبي جَهدَهُ مِن وَرائِكُم","وَأُغني عِيالي عَنكُمُ أَن أُؤَنَّبا",0,"ب",2,0],["سَيَنْصُرُكَ الله نَصْراً عَزِيزاً","وَيَخذِلُ كُلَّ عَدُوٍّ أَثِيمِ",1,"م",1,0],["سيُنسيك أيامَ الشباب وبردَها","فتىً ما جدٌ أيامُه سَبِراتُ",2,"ت",1,0],["سينفر من أمن العواقب آمنٌ","بَلا مِن مُناه ما جناه خدوعها",3,"ع",3,0],["سَيَندَمُ بَعدي مَن يَرومُ قَطيعَتي","وَيَذكُرُ قَولي وَالزَمانُ طَويلُ",4,"ل",1,0],["سَيُنقِذُهُم وَيُنميهِم جَميعاً","رِضاعُ الخَيرِ إِن دَرَّت لِباني",5,"ن",2,0],["سيناءُ شاطَرَهُ الجَلالَ فَلا يُرى","إِلّا لَهُ سُبُحاتُهُ وَسُموتُهُ",6,"ت",2,0],["سَيَنقَطِعُ التَرَوُّحُ عَن أُناسٍ","مِنَ الدُنيا وَتَنقَطِعُ الغُمومُ",7,"م",1,0],["سَينسفُ أمْرُ اللّهِ شمَّ جبالها","كما تَنْسِف الأرواحُ مُنْهالةَ الكثبِ",8,"ب",1,0],["سينهظ من صميم اليأس جيلٌ","مريدُ البأسِ جبارٌ عنيد",9,"د",1,0],["سيناءُ تيهي بِالغُزاةِ وَفاخِري","وَاروي الحَديثَ لِسائِرِ الرُكبانِ",10,"ن",1,0],["سَيَنسِفُ بَغيُ القَومِ شامِخَ عِزِّنا","إِذا نَسَفَ الوَهمُ الجِبالَ الرَواسِيا",11,"ي",2,0],["سَيَنزَعُ بأسُهُم حِصناً فَحِصناً","وَيَفْتَحُ عَزمُهُم باباً فبابا",12,"ب",2,0],["سَيَنصُرُني الخَلِيفَةُ بَعدَ رَبّي","وَيُخبَرُ حَيثُ يُمسي عَن مَساقي",13,"ق",2,0],["سَيُنسى كُلُّ ما الأَحياءُ فيهِ","وَيَختَلِطُ الشَآمي بِاليَماني",14,"ن",2,0],["سينقم الشعر ممن","له أَهانوا وراعوا",15,"ع",3,0],["سينقض يوماً على خصمه","كَما انقضَّ من حالق أجدل",16,"ل",1,0],["سينهض من بعد الخمول إلى العلى","ويُرجع مجداً دارساً ويتمِّم",17,"م",1,0],["سينقشع الغيم الَّذي قد تلبَّدا","فيبيضّ ليلي بعد أَن كانَ أَسودا",18,"د",2,1],["سينهض من صميم اليأس جيلٌ","مريدُ البأسِ جبارٌ عنيد",19,"د",1,0],["سَيُنْسَى كُلُّ شَيءٍ بَعْدَ حِينٍ","وَلا أَنْسَى جَمِيلَكَ يَا أَمِيرِي",20,"ي",1,0],["سينصف الدهر من قوم بدائرةٍ","وفي الجديدين إنصاف إذا دارا",21,"ر",2,0],["سينصبّ فجر ويشدو ربيع","ويخضوضر الجدب أنّى شدا",22,"د",2,0],["سيُنكِّسُ المتذبذبون رقابَهم","حتى كأنّ رؤوسَهم أقدام",23,"م",1,0],["سينحسر الضباب عن الروابي","ويبدو الورد فيها فيها والخزام",24,"م",1,0],["سينظمُ السعدُ مِصراً في ممالِكِه","حتى تُدَوِّخَ مِنها خَيلُهُ حَلَبا",25,"ب",2,0],["سَيَنْدَمُ أَلْفاً عَلَى فِعْلهِ","إِذا الشَّمْسُ فِي خَدِّهِ كُوِّرَتْ",26,"ت",1,0],["سينشر في الدنيا وترفع بالدعا","إِلى الله للسلطان أيدى البرية",27,"ه",1,0],["سينبيك عني البعد أني والوفا","رضيعا لبانٍ فيك لا تتفرّقُ",28,"ق",1,0],["سين السُّؤالِ قَدِ اصطفتْكَ مُبكِّرًا","فتغوَّلَت في روحِكَ البرداءُ",29,"ا",2,0],["سَينفُق مدحى فيك علما بأنه","إليك انتهى في جوهر الحِكَم النَّقْد",30,"د",1,0],["سَيُنْبِهُكَ الدَهرُ عَن رَقدَةِ ال","مَلاهي وَإِن قُلتَ لا أَنتَبِه",31,"ه",1,0],["سين سموت وقد نمتكَ عصابة","مَلأَتْ صدوراً هيبة وجمالا",32,"ل",2,0],["سينصرف التدلُّل عنك يوماً","وهذا الداء ليس له انصرافُ",33,"ف",1,0],["سينقضي الدهر لا تدرون ما شغفي","إني أؤجِّجُ آلامي بكتماني",34,"ن",2,0],["سَيَنظُرُ الغَد في أَمسي وَيَغفِرُه","لِأَنَّ قَلبي كَنفسي غَير مُحتالِ",35,"ل",1,0],["سَيُنْجِدُنِي جَيْشٌ مِنَ الْعَزْمِ طَالَما","غَلَبْتُ بِهِ الْخَطْبَ الَّذِي هُوَ غَالِبي",36,"ب",2,0],["سين الثنايا حوتها ميم مبسمه","طوبى لمن ذاق منها كأس تسنيم",37,"م",1,1],["سَيَندَمُ بَعضُكُم عَجلاً عليه","وما أَثرى اللِسانُ إِلى الجَرُوحِ",38,"ح",1,0],["سَيَنمو بِعَون اللَه إِصلاح شَأننا","بِأَيّامه فَالغَيث أَوّله قَطرُ",39,"ر",1,0],["سَيُنْصِفُ اللهُ مِنْ عِداك ومَا","أَعْدَل ربِّ العِبادِ مِنْ حكمِ",40,"م",1,0],["سينقذها من بعد ذلك ماجد","تسامى إلى نيل العلى فسماها",41,"ا",3,0],["سيُنشئني ضرْعٌ لفضلك حافلٌ","ويكنفُني منه المكانُ الممهّدُ",42,"د",1,0],["سيُنبيكِ زَجري عن بلاءِ نَسِيتُهُ","إِذَا أَصبَحَتْ تِلْكَ القُصورُ قُصارَكِ",43,"ك",1,0],["سينزِعها ويَرجِعها إليكم","وبعد اللُّبس نزعتها أشقُّ",44,"ق",1,0],["سيُنسَبُ حسنٌ وقبحٌ إلي","ك حاشاك يَقبُحُ ما تَصنَعُ",45,"ع",1,0],["سيُنهِضُ سقطتي منهم غلامٌ","عزائمه الأزمَّةُ والصفاحُ",46,"ح",1,0],["سينجلي الليل ويبرز الضحى","وينطوي السموء الذي قد عتَّما",47,"م",2,0],["سيُنْسَجُ لي بسَمْكِ الكَوْنِ بدرٌ","لآلِ محمَّدٍ يُنْمى ويُعْزى",48,"ز",2,1],["سيَنْشُرُ من أَبي العَلَمَيْنِ طيًّا","ويُبرِزُ من خَفِيِّ الشأنِ عِزَّا",48,"ز",2,0],["سينصفنا الاله بدار حق","إذا لم نلق في الدنيا عدولا",49,"ل",2,0],["سَيَنصُرُكُم مَن تَنصُرونَ كِتابِهِ","وَيُؤتيكُمُ الفَتحُ القَريبُ مِنَ الفَتحِ",50,"ح",1,0],["سَيُنشئها موحّدة جميعاً","بلاد العرب إذ نحن الجنودُ",51,"د",1,0],["سينشيء أضعافها القادمون","ولم ير أمثالها القدما",52,"م",2,0],["سينجز اللّه في الدنيا التي ابتسمت","للمسلمين على أيديك ما وُعدوا",53,"د",3,0],["سينظر آثار ما قدمت","يداه وسطر في طرسه",54,"س",2,0],["سينعت فضلك مني اللسان","إذا نعت الغير توريدَ وَجْنَه",55,"ن",2,0],["سَيَنْصَرُ كلَّ نَصيرٍ لهُ","ويَخْذِلُ رَبِّي العَدُوَّ الَخذولا",56,"ل",2,0],["سَينبئ لحظه عَنه","إِذا ما أشكل الأَمر",57,"ر",1,0],["سينشد ميدان الصبا بعد عزلتي","إذا ناب عني ذو القصور منابا",58,"ب",2,0],["سَيَنطِقُ عَنكَ عِلمُكَ في نَدِيٍّ","وَيُكتَبُ عَنكَ يَوماً إِن كَتَبتا",59,"ت",2,0],["سَيَنطِقُ الشِعرُ بِأَيّامِهِ","عَلى لِسانٍ غَيرِ مَعقودِ",60,"د",1,0],["سينسون أطماعاً عليها تعاقروا","عذاب المنى مشمولةً لم ترنق",61,"ق",1,0],["سينبيك عن دمن الديار طلولها","وأعلام صم في الديار خوالد",62,"د",1,0],["سينماء تملا العين قذى","وروايات فخار وسجون",63,"ن",1,0],["سيُنزله برحمته جناناً","ويُسكنه بها أعلى قصور",64,"ر",1,0],["سينهضُ العَزْمُ بي لِلْعَزْمِ نَهْضَةَ ذي","عَزْمٍ يَعِزُّ إِذا إِخوانُهُ هانوا",65,"ن",3,0],["سَينَدمِ مِمّا قالَ يومَ مَعادِنا","إِذا اِنكَشَفَ المَستورُ في مَوقِفِ الحَشدِ",66,"د",1,0],["سينصرنا هذا الذي قد سردته","إذا كشفَ الرحمن عنك غطاء",67,"ا",2,0],["سَيَنتَصِرُ الصَلاحُ عَلى المَعاصي","وَتَنتَقِمُ الحُروبُ مِنَ السَلامِ",68,"م",1,0],["سينتقم الله منه بما","تهتك في دينه وانتهك",69,"ك",1,0],["سَيَنصُرُني مَن لَيسَ تَنفَعُ عِندَهُ","رُقاكَ وَقَرمٌ مِن أُمَيَّةَ مُصعَبُ",70,"ب",1,0],["سينفد في غد كل الكلام","ولا يبقى سوى الله أكبر",71,"ر",1,0],["سينظم عقل اللكترون قريضهم","وهيهات أن يدنو الى شعري الحي",72,"ي",1,0],["سين السَناء وَشين رُشد شايع","صاد الصَفاء وَضاد كُل ضياء",73,"ا",2,0],["سينجب حظه الوطن المفدى","إذا لم تحسنوا عنه النضالا",74,"ل",2,0],["سينشرُ تعليم البنات فإنّه","يرى في اِرتقاءِ البنت عزّاً وسُؤددا",75,"د",2,0],["سينخفضُ الطمّاح إثما وعزّةً","وينقبضُ التلعابةُ المتبَسّط",76,"ط",1,0],["سَينال الجَميع بعد قَليل","ما رَجاه لخيره الراجونا",77,"ن",2,0],["سيُنقَضُ منك ذا ان لِنتَ طبعاً","واضحى البرُّ منخفضَ الإِكامِ",78,"م",1,0],["سيناء تطويها بجيشك غازيًا","في حيث توجف وحدها النكباء",79,"ا",2,0],["سينبته مرآك غضاً وناضراً","وينعشه ما تصنعين وتبدينا",80,"ن",2,0],["سَيَنالُونَ دُونَكُمْ شَرَفَ الفَتْ","حِ وَيَحْوونَ عِزَّ يَوْمِ النَّصْرِ",81,"ر",1,0],["سينبدك المجد الذي أنت أهله","بشق فؤاد لا بشق برود",82,"د",1,0],["سينهدّ مبنيّ، ويقفر عامر","ويصفر مملوء، ويخمد راقد",83,"د",1,0],["سيندم ألفا على كبره","إذا الشمس في خده كوِّرت",84,"ت",1,0],["سينجيك من نجّى من الجب يوسفا","ويأويك من آوى المسيح بن مريما",85,"م",2,0],["سَيَنشَقُّ عَن نَورِ الوِدادِ بِها فمي","فَقَد أَنبَتَت ما أَنبَتَت لَكَ في قَلبي",86,"ب",2,0],["سينقذهم وينجيهم جيمعاً","رضاع الخير إن درت لباني",87,"ن",2,0],["سينهمر المسك يا صاحبي","فقل للينابيع: إن الظباءْ",88,"ا",2,0],["سينٌ سبحانك بارئه","نفساً من خير لا من شر",89,"ر",1,0],["سينال من رب العباد مراده","ويصيب في يوم الحساب جزاه",90,"ا",2,0],["سينبيهم عن الليث البلائي","إذا ماظُل لِلو سُحبً تُراجم",91,"م",1,0],["سينجابُ ليلٌ في بلاديَ داجي","ويعقبُ ضيقَ العسرِ رحْبُ انفراجِ",92,"ج",1,1],["سينجبُ القلبُ نبضا فيك مختلفا","كأنك الروح في هجري وفي صلتي",93,"ت",2,0],["سينقرضون في يومٍ وتبقى","ملامحُهم على الأبوابِ حِبْرا",94,"ر",2,0],["سينتهي الحسنُ يومًا من ملامحنا","ليأكلَ الدودُ ما يبقى من الجسدِ",95,"د",1,0],["سيناءُ تَبْكي وبَنْغازي تُشاطِرُها","لَمْ يَبْقَ لِلْعُرْبِ إلاّ الرّمْلُ والْعَفَنُ",96,"ن",1,0],["سينهَضُ جِيلٌ على إِثرِ جِيلٍ","يُعِيدُ لنَا الزّمنَ الأسْعدَا",97,"د",2,0],["سينال راحته كما يهوَى بهاتيك الحبك","وله الشقاء مضاعفاً إن كان وهو المنتهِك",98,"ك",1,0],["(سيناءُ) لمَّت غربَ أُمتنا بها","والشَّرقُ جاء مع النِّداءِ مُوحِّدا",99,"د",2,0],["( سيناءُ ) ترقبُ من سيخلعُ عارَها","حتّى تزفّ عروسةً لجهادِنا",100,"ن",2,0],["سينبتُ من بذور اليأس بأس","برغم الجرح أو ظلم الزمانِ",101,"ن",1,0],["سينبت بذره في الطهر حتما ..","ويجنيها قطوفا دانيات",102,"ت",1,0],["سينصرُ من نصروا إنه","له الجكمُ..ذو الجودِ للمقبلِ",103,"ل",1,0],["سِينٌ سَمتْ نحو السَّكِينةِ والسَناءْ","في الفَتْكِ سَيفٌ أو سِلاحٌ لِلقَاءْ",104,"ا",2,0],["سينعونَ اسمي إذا غابَ رسمي","فأُنْسى وأغدو لديهم عُلوما",105,"م",2,1],["سَيَنْجُو وَالجِنَانُ لَهُ مَآبٌ","إِذَا جَعَلَ الصَّلاحَ لَهُ رِكَابَا",106,"ب",2,0],["\"سيناء\"مقبرة المغير ألا ترين رمالها؟","ليست سوى عظم الغزاة على الربا وسهولها",107,"ل",3,0],["سينجاب هذا الليل بعد انسداله","وتعلم حقاً بعد ذا من تذمرا",108,"ر",2,0],["سينظم منكم إن عتوتم بمقلد","أناساً ويس