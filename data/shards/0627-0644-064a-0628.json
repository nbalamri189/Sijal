{"poems":[[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[93,"كنا نود لك التكريم تلبسه","https://www.aldiwan.net/poem11344.html","البسيط"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[72,"بكيت بأجفان المحب المتيم","https://www.aldiwan.net/poem19671.html","الطويل"],[91,"ألا نبي لو طبعنا الشمس يوما","https://www.aldiwan.net/poem8791.html","عموديه"],[28,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[28,"إليك بنفسي حين بعد حشاشةٍ","https://www.aldiwan.net/poem1287.html",""],[28,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[28,"محارم للإسلام كنت انتهكتها","https://www.aldiwan.net/poem5108.html","الطويل"],[28,"دعي العطف والشكوى إلي فإنها","https://www.aldiwan.net/poem5469.html","الطويل"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[31,"طربت ورد من تهوى","https://www.aldiwan.net/poem42505.html","مجزوء الوافر"],[40,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[48,"لقد طال في رسم الديار بكائي","https://www.aldiwan.net/poem10413.html","الطويل"],[48,"دع الربع ما للربع فيك نصيب","https://www.aldiwan.net/poem10774.html","الطويل"],[48,"إذا خطرت فيك الهموم فداوها","https://www.aldiwan.net/poem65098.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85601","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140867",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[48,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[28,"لبئست هدايا القافلين أتيتم","https://www.poetsgate.com/ViewPoem.aspx?id=21087",""],[160,"بقلبي وجد ما عليه مزيد","https://www.aldiwan.net/poem58908.html","الطويل"],[160,"اقرت رؤسا في الطلا هذه الرسل","https://www.aldiwan.net/poem58966.html","الطويل"],[182,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[235,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[235,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[235,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[237,"بحار الندى تعزى إليكم أبا يعزى","https://www.aldiwan.net/poem18834.html","الطويل"],[282,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[282,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[305,"إلى بيتك اللهم بالعزم أقبلنا","https://www.aldiwan.net/poem56383.html","الطويل"],[337,"نظرت وسهب من بوانة بيننا","https://www.aldiwan.net/poem45425.html","الطويل"],[348,"أشاقك برق بات طرفك شائمه","https://www.aldiwan.net/poem20672.html","الطويل"],[356,"ألمت بنا أهلا وسهلا","https://www.aldiwan.net/poem24532.html","الطويل"],[364,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[377,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[377,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[403,"أحبتنا إن تفضلوا بسؤال","https://www.aldiwan.net/poem33601.html","الطويل"],[403,"لي الله ما قلبي هو الحجر الصلد","https://www.aldiwan.net/poem33975.html","الطويل"],[406,"قفوا جددوا عتبا على من له العتب","https://www.aldiwan.net/poem50204.html","الطويل"],[410,"ويوم عسول الآل حام كأنما","https://www.aldiwan.net/poem67532.html","الطويل"],[416,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[416,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[416,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[441,"ليتني كنت شجره","https://www.aldiwan.net/poem14371.html","مجزوء الرجز"],[468,"تبسم عن مثل صافي الجمان","https://www.aldiwan.net/poem59612.html","المتقارب"],[538,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[553,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[563,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[575,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"]],"verses":[["إِلى بَيتِ مَن يَعتَريهِ النَدى","إِذا النَفسُ أَعجَبَها مالُها",0,"ل",3,0],["إِلى بَحرِ جودٍ يُخجلُ البَحرَ كَفُّهُ","فَقُل عَن أَياديهِ فَهُنَّ العَجائِبُ",1,"ب",1,0],["إِلَى بِلادٍ إِذَا بَشَّتْ بِمَقْدَمِهِ","أُنْساً فَفِي غَيْرِهَا قَدْ أُوْحِشَ القَلَمُ",2,"م",1,0],["إلى بيته كيما تزور معاهداً","أبان بها جبريلُ عن كرم العهدِ",3,"د",1,0],["إلى بابك الأعلى قصائد مادحٍ","تتيه على وشي الربيع المنمنم",4,"م",1,0],["إِلى بَحرِ الجَليلِ إِلى دِمَشقٍ","تُطارِدُ دونَكَ التُركي القَبيحا",5,"ح",2,0],["إِلى بَدرِ لَيلٍ مِن أُمَيَّةَ ضَوءُهُ","إِذا ما بَدا يَعشى لَهُ كُلُّ كَوكَبِ",6,"ب",1,0],["إِلى بابِ مَن لَم نَأتِ نَطلُبُ غَيرَهُ","بِشَرقٍ مِنَ الأَرضِ الفَضاءِ وَلا غَربِ",7,"ب",1,0],["إِلى بَيعَةِ اللَهِ الَّذي اِختارَ عَبدَهُ","لَها اِبنَ أَبي العاصي الإِمامَ المُؤَمَّرا",8,"ر",2,0],["إِلى باعِثِ المَوتى لِيُنزِلَ نَصرَهُ","فَأَنزَلَ لِلحَجّاجِ نَصراً مُؤَزَّرا",9,"ر",2,0],["إِلى بَيتِ مَروانَ الَّذي لَم يَزَل لَهُ","دَعائِمُ مُلكٍ ما تُرامُ جِبالُها",10,"ل",3,0],["إِلى بابِهِ تَسعى المُلوكُ فَإِن عَدَت","تَعَدّى إِلَيها القَتلُ وَالنَهبُ وَالأَسرُ",11,"ر",1,0],["إِلَيَّ بِمُقلَتَي ريمٍ","تَرى في طَرفِها حَورا",12,"ر",2,0],["إِلَيَّ بِأَن إِيتِنا وَاحذَرَن","وَقاكَ الرَدى أَهلَنا وَالشِناعا",13,"ع",2,0],["إِلى بَيتِ حانٍ لا تَهُرُّ كِلابُهُ","عَلَيَّ وَلايُنكِرنَ طُولَ ثَوائي",14,"ي",1,0],["إِلى بَيتِ خَمّارٍ وَدونَ مَحَلِّهِ","قُصورٌ مُنيفاتٌ لَنا وَدُروبُ",15,"ب",1,0],["إِلى بَيتِ خَمّارٍ أَفادَ زِحامُهُ","لَهُ ثَروَةً وَالوَجهُ مِنهُ بَهيمُ",16,"م",1,0],["إلى بَرَدَى حتى تظَلّ كأنّها","وقد كَرَعَتْ فيه لَواثِمُ مِبْرَدِ",17,"د",1,0],["إلى بلد للعلم في أَرضه هدى","وَللشعر مثل النجم في جوه وقد",18,"د",1,0],["إلى بلد يَلقى به الحق ذادةً","وَينعم في أكنافه الشاعر الحر",19,"ر",1,0],["إلى بقعة فيها الأديب مكرم","وأرض عليها ينبت الأدب النضر",19,"ر",1,0],["إلى بدر بن عمار الذي لم","يكن في غرة الشهر الهلالا",20,"ل",2,0],["إِلى بَحْرٍ تُطَوِّقُ رَمْلَهُ","الذَّهَبِيَّ أَشْجَارُ",21,"ر",1,0],["إلى بيت خمار كثير زحامه","له ثروةٌ والوجه منه دميم",22,"م",1,0],["إلى بَيْعَةِ الله الّتي اخْتَارَ عَبْدَهُ","لهَا ابنَ أبي العاصِي الإمامَ المُؤمَّرَا",23,"ر",2,0],["إلى بلدٍ لوفي المنِامِ رأيتُهُ","لأَصبحتُ من فرطِ السرورُ أَميدُ",24,"د",1,0],["إلى بابه تنهى الحكومة بينهم","فيقضى على الباغي قضاء هو الفصل",25,"ل",1,0],["إِلى بابكَ العالي سَرَيتُ وَقِبلَتي","نُجومُ المُنى في أُفْقِ فَضلِكَ طُلَّعا",26,"ع",2,0],["إِلى بَأسِهِ تُعزى الصَوارِمُ وَالقَنا","وَعَن جودِهِ يُروى حَديثُ الأَكارِمِ",27,"م",1,0],["إِلى بَحرِ جودٍ بِالمَواهِبِ مُزبِدٍ","وَصَوبِ حَياً بِالمَكرُماتِ هَطولِ",28,"ل",1,0],["إِلى بَلدَةٍ لا تَقومُ الخُطوبُ","بِالحُرِّ فيها وَلا تَقعَدُ",29,"د",1,0],["إِلَى بَحْرِ جُودٍ مَاؤُهُ لَيْسَ آسِناً","وَلاَ طَعْمُهُ مُزّاً وَلاَ رَبُّهُ جِبْزَا",30,"ز",2,0],["إِلى بابِ مودودٍ بنِ المبارَ","كِ قد جعل المُبتَغو الخَيرَ طُرقا",31,"ق",2,0],["إِلى بابِ مَولانا اِزدَهَتنِيَ رَغبَةٌ","وَما كانَ دونَ البابِ عَن قاصِدٍ لَطُّ",32,"ط",1,0],["إلى بيتكَ اللّهمّ بالعزمِ أَقبلنا","حَطَطنا بهِ رحلَ الضيافةِ فَاِقبَلنا",33,"ن",2,1],["إِلى بَقَرٍ فيهِنَّ لِلعَينِ مَنظَرٌ","وَمَلهىً لِمَن يَلهو بِهِنَّ أَنيقُ",34,"ق",1,0],["إلى بِنْتِ كَرْمٍ كاتَمَ الدَّهْرُ أَمَرها","بَنِيهِ رَجَاءً في خَلِيلٍ تُنادِمُه",35,"م",2,0],["إلى بُخلها قد ضمّت الجبنَ والونى","ثلاثَ خصالٍ نكسبُ المدح والذّمّا",36,"م",2,0],["إلى بيتِ جُودٍ ما يزالُ حَجيجه","يُوافُونَ مِلْءَ الطُّرقِ من كُلّ جانب",37,"ب",1,0],["إلى بلدٍ أمّا نسيم صَبائه","فَعَرفٌ وأما ماؤه فهو قَرقَف",38,"ف",1,0],["إلى بتولٍ أُبَشِّرْها وقد وُصفَت","لي مريم البكر فَاِسمع نَصَّ بُشرائي",39,"ا",2,0],["إلى بلدة بل روضة جادها الحيا","بها العذب من ماءٍ وبَرْدِ ظلال",40,"ل",1,0],["إلى بلد لا يرتضي فيه منظر","ولا ماؤها عذب ولا عيشها رغد",41,"د",1,0],["إِلى بَلَدٍ عزت لِعز مُلوكِهِ","مُلوك البَرايا وَالأَعاجِمُ وَالعربُ",42,"ب",1,0],["إِلى بابِ مَعنٍ يَنتَهي كُلُّ راغِبٍ","يُرَجّى النَدى أَو خائِفٍ يَتَرَقَّبُ",43,"ب",1,0],["إلى بيت النُّبوَّة منتماهم","رفيع دعائم الحسب الصميم",44,"م",1,0],["إلى بعد الغميم وعهد سلع","نجاة من هموم أو غموم",45,"م",1,0],["إلى بذل نائله المستفاد","نؤمُّ إليه قبيلاً قبيلا",46,"ل",2,0],["إلى بيتوت الوحش والد","ديدان وهي المقبره",47,"ر",2,0],["إِلى بَيتِ بَحرٍ لَهُ مَجلِسٌ","عَلى الجيدِ مِنهُ عُقودُ الأَواني",48,"ي",1,0],["آلى بأنَّهُ لا يُقلِّدُهُ سوى","كُفءٍ له بِجَدارةٍ كَوِسامِ",49,"م",1,0],["إِلى بَني حاتِمٍ أَدّى رَكائِبَنا","خَوضُ الدُجى وَسُرى المَهرِيَّةِ القُودِ",50,"د",1,0],["إِلى بابِهِ في كُلِّ تَيهاء مَنهَجٍ","يُؤَدّي إِلَيهِ طالِبَ العُرفِ لاحِبُه",51,"ب",2,0],["إِلى بلادٍ أَجابت قبلما دُعيت","للخاطبين ولولا الخوفُ لم تُجب",52,"ب",1,0]]}