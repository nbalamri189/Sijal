[5431,"أيا خير من صافى وياخير من عفّا","https://www.poetsgate.com/ViewPoem.aspx?id=191456",""],[5582,"أَبَدْرٌ لاحَ مِنْ خَلْفِ السِّتارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63512",""],[5652,"وطن ال بدون !!","https://www.poetsgate.com/ViewPoem.aspx?id=176984",""],[5652,"ياكبر ضيقات الليالي والايام","https://www.poetsgate.com/ViewPoem.aspx?id=208686",""],[5725,"الى من أسهبت بدمي","https://www.poetsgate.com/ViewPoem.aspx?id=205972",""],[5732,"الصدر ضاق وحاير الدمع دفاق","https://www.poetsgate.com/ViewPoem.aspx?id=177846",""],[5751,"صفرُ وَدِلاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=214712",""],[5776,"الهُبوبُ الثّاني","https://www.poetsgate.com/ViewPoem.aspx?id=199446",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5850,"نظرتُ وسهبٌ من بوانة َ بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=19710",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[6259,"قفوا جددوا عتباً على من لهُ العتب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59358&r=&rc=6",""],[6328,"وقفة ندم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82140&r=&rc=15",""]],"verses":[["إِلى بَيتِ مَن يَعتَريهِ النَدى","إِذا النَفسُ أَعجَبَها مالُها",0,"ل",3,0],["إِلى بَحرِ جودٍ يُخجلُ البَحرَ كَفُّهُ","فَقُل عَن أَياديهِ فَهُنَّ العَجائِبُ",1,"ب",1,0],["إِلَى بِلادٍ إِذَا بَشَّتْ بِمَقْدَمِهِ","أُنْساً فَفِي غَيْرِهَا قَدْ أُوْحِشَ القَلَمُ",2,"م",1,0],["إلى بيته كيما تزور معاهداً","أبان بها جبريلُ عن كرم العهدِ",3,"د",1,0],["إلى بابك الأعلى قصائد مادحٍ","تتيه على وشي الربيع المنمنم",4,"م",1,0],["إِلى بَحرِ الجَليلِ إِلى دِمَشقٍ","تُطارِدُ دونَكَ التُركي القَبيحا",5,"ح",2,0],["إِلى بَدرِ لَيلٍ مِن أُمَيَّةَ ضَوءُهُ","إِذا ما بَدا يَعشى لَهُ كُلُّ كَوكَبِ",6,"ب",1,0],["إِلى بابِ مَن لَم نَأتِ نَطلُبُ غَيرَهُ","بِشَرقٍ مِنَ الأَرضِ الفَضاءِ وَلا غَربِ",7,"ب",1,0],["إِلى بَيعَةِ اللَهِ الَّذي اِختارَ عَبدَهُ","لَها اِبنَ أَبي العاصي الإِمامَ المُؤَمَّرا",8,"ر",2,0],["إِلى باعِثِ المَوتى لِيُنزِلَ نَصرَهُ","فَأَنزَلَ لِلحَجّاجِ نَصراً مُؤَزَّرا",9,"ر",2,0],["إِلى بَيتِ مَروانَ الَّذي لَم يَزَل لَهُ","دَعائِمُ مُلكٍ ما تُرامُ جِبالُها",10,"ل",3,0],["إِلى بابِهِ تَسعى المُلوكُ فَإِن عَدَت","تَعَدّى إِلَيها القَتلُ وَالنَهبُ وَالأَسرُ",11,"ر",1,0],["إِلَيَّ بِمُقلَتَي ريمٍ","تَرى في طَرفِها حَورا",12,"ر",2,0],["إِلَيَّ بِأَن إِيتِنا وَاحذَرَن","وَقاكَ الرَدى أَهلَنا وَالشِناعا",13,"ع",2,0],["إِلى بَيتِ حانٍ لا تَهُرُّ كِلابُهُ","عَلَيَّ وَلايُنكِرنَ طُولَ ثَوائي",14,"ي",1,0],["إِلى بَيتِ خَمّارٍ وَدونَ مَحَلِّهِ","قُصورٌ مُنيفاتٌ لَنا وَدُروبُ",15,"ب",1,0],["إِلى بَيتِ خَمّارٍ أَفادَ زِحامُهُ","لَهُ ثَروَةً وَالوَجهُ مِنهُ بَهيمُ",16,"م",1,0],["إلى بَرَدَى حتى تظَلّ كأنّها","وقد كَرَعَتْ فيه لَواثِمُ مِبْرَدِ",17,"د",1,0],["إلى بلد للعلم في أَرضه هدى","وَللشعر مثل النجم في جوه وقد",18,"د",1,0],["إلى بلد يَلقى به الحق ذادةً","وَينعم في أكنافه الشاعر الحر",19,"ر",1,0],["إلى بقعة فيها الأديب مكرم","وأرض عليها ينبت الأدب النضر",19,"ر",1,0],["إلى بدر بن عمار الذي لم","يكن في غرة الشهر الهلالا",20,"ل",2,0],["إِلى بَحْرٍ تُطَوِّقُ رَمْلَهُ","الذَّهَبِيَّ أَشْجَارُ",21,"ر",1,0],["إلى بيت خمار كثير زحامه","له ثروةٌ والوجه منه دميم",22,"م",1,0],["إلى بَيْعَةِ الله الّتي اخْتَارَ عَبْدَهُ","لهَا ابنَ أبي العاصِي الإمامَ المُؤمَّرَا",23,"ر",2,0],["إلى بلدٍ لوفي المنِامِ رأيتُهُ","لأَصبحتُ من فرطِ السرورُ أَميدُ",24,"د",1,0],["إلى بابه تنهى الحكومة بينهم","فيقضى على الباغي قضاء هو الفصل",25,"ل",1,0],["إِلى بابكَ العالي سَرَيتُ وَقِبلَتي","نُجومُ المُنى في أُفْقِ فَضلِكَ طُلَّعا",26,"ع",2,0],["إِلى بَأسِهِ تُعزى الصَوارِمُ وَالقَنا","وَعَن جودِهِ يُروى حَديثُ الأَكارِمِ",27,"م",1,0],["إِلى بَحرِ جودٍ بِالمَواهِبِ مُزبِدٍ","وَصَوبِ حَياً بِالمَكرُماتِ هَطولِ",28,"ل",1,0],["إِلى بَلدَةٍ لا تَقومُ الخُطوبُ","بِالحُرِّ فيها وَلا تَقعَدُ",29,"د",1,0],["إِلَى بَحْرِ جُودٍ مَاؤُهُ لَيْسَ آسِناً","وَلاَ طَعْمُهُ مُزّاً وَلاَ رَبُّهُ جِبْزَا",30,"ز",2,0],["إِلى بابِ مودودٍ بنِ المبارَ","كِ قد جعل المُبتَغو الخَيرَ طُرقا",31,"ق",2,0],["إِلى بابِ مَولانا اِزدَهَتنِيَ رَغبَةٌ","وَما كانَ دونَ البابِ عَن قاصِدٍ لَطُّ",32,"ط",1,0],["إلى بيتكَ اللّهمّ بالعزمِ أَقبلنا","حَطَطنا بهِ رحلَ الضيافةِ فَاِقبَلنا",33,"ن",2,1],["إِلى بَقَرٍ فيهِنَّ لِلعَينِ مَنظَرٌ","وَمَلهىً لِمَن يَلهو بِهِنَّ أَنيقُ",34,"ق",1,0],["إلى بِنْتِ كَرْمٍ كاتَمَ الدَّهْرُ أَمَرها","بَنِيهِ رَجَاءً في خَلِيلٍ تُنادِمُه",35,"م",2,0],["إلى بُخلها قد ضمّت الجبنَ والونى","ثلاثَ خصالٍ نكسبُ المدح والذّمّا",36,"م",2,0],["إلى بيتِ جُودٍ ما يزالُ حَجيجه","يُوافُونَ مِلْءَ الطُّرقِ من كُلّ جانب",37,"ب",1,0],["إلى بلدٍ أمّا نسيم صَبائه","فَعَرفٌ وأما ماؤه فهو قَرقَف",38,"ف",1,0],["إلى بتولٍ أُبَشِّرْها وقد وُصفَت","لي مريم البكر فَاِسمع نَصَّ بُشرائي",39,"ا",2,0],["إلى بلدة بل روضة جادها الحيا","بها العذب من ماءٍ وبَرْدِ ظلال",40,"ل",1,0],["إلى بلد لا يرتضي فيه منظر","ولا ماؤها عذب ولا عيشها رغد",41,"د",1,0],["إِلى بَلَدٍ عزت لِعز مُلوكِهِ","مُلوك البَرايا وَالأَعاجِمُ وَالعربُ",42,"ب",1,0],["إِلى بابِ مَعنٍ يَنتَهي كُلُّ راغِبٍ","يُرَجّى النَدى أَو خائِفٍ يَتَرَقَّبُ",43,"ب",1,0],["إلى بيت النُّبوَّة منتماهم","رفيع دعائم الحسب الصميم",44,"م",1,0],["إلى بعد الغميم وعهد سلع","نجاة من هموم أو غموم",45,"م",1,0],["إلى بذل نائله المستفاد","نؤمُّ إليه قبيلاً قبيلا",46,"ل",2,0],["إلى بيتوت الوحش والد","ديدان وهي المقبره",47,"ر",2,0],["إِلى بَيتِ بَحرٍ لَهُ مَجلِسٌ","عَلى الجيدِ مِنهُ عُقودُ الأَواني",48,"ن",2,0],["آلى بأنَّهُ لا يُقلِّدُهُ سوى","كُفءٍ له بِجَدارةٍ كَوِسامِ",49,"م",1,0],["إِلى بَني حاتِمٍ أَدّى رَكائِبَنا","خَوضُ الدُجى وَسُرى المَهرِيَّةِ القُودِ",50,"د",1,0],["إِلى بابِهِ في كُلِّ تَيهاء مَنهَجٍ","يُؤَدّي إِلَيهِ طالِبَ العُرفِ لاحِبُه",51,"ب",2,0],["إِلى بلادٍ أَجابت قبلما دُعيت","للخاطبين ولولا الخوفُ لم تُجب",52,"ب",1,0],["إلى بحرك الفياض الوى اعنتي","ولكنها ليست إلى غيره تلوى",53,"و",2,0],["إلى بحر الندى قصدت فألفت","خضما زاخراً بين البحور",54,"ر",1,0],["إلى بلوطة عمرت سعينا","لابراهيم لم تترك نيه",55,"ي",2,0],["إِلَى بلدَةٍ تَقتَنِي ذا الحِجا","وَضاقَت بذِي الجَهلِ يَوماً مِحالا",56,"ل",2,0],["إلى بيِّعٍ سَمحِ اليدينِ مباركٍ","توسّم فيه الخيرَ والخيرُ يُتْبَعُ",57,"ع",1,0],["إلى بيت العبادة سر صباحا","وتاج الله واسأل منه عفوا",58,"و",2,1],["إلى بانقوساهُ تلك التي","حكتْ راكباً لاح من فَجِّه",59,"ج",2,0],["إِلى بَقائِك ذا الإِبقاءُ أَرشَدَنا","فَذَا البقاءُ عَلَيهِ دَلَّ الاِبقاءُ",60,"ا",2,0],["إِلى بابِ جيرونَ تَرى فيهِ صاعِداً","مِنَ الماءِ يَعلو لَيسَ يَحكيهِ صاعِدُ",61,"د",1,0],["إلى بلَدٍ به شعب أصيلٌ","عروبته بدَتْ من عهد عادِ",62,"د",1,0],["إلى بلدٍ به الخيرات تجري","يُسابق بعضها جَرْيَ الجِيادِ",62,"د",1,0],["إِلى بَلاءٍ حَسَنٍ قَد مَضى","وَأَنتَ في ذَلِكَ كَالزاهِدِ",63,"د",1,0],["إِلَى «بَغْدادَ» آنَ لِكُلِّ حُرٍّ","يَقُولُ غَدًا مَعَ الفَجْرِ انْطِلاقِي",64,"ق",2,0],["إلى بابه تطوى السباسب والفَلا","ويثنى على مسعاه في كل مشهد",65,"د",1,0],["إِلَى بَلَدٍ تُغنِيكَ عَن كُلِّ بَلدَةٍ","سِواها وَما عَنها غَناءٌ لِذِي حِجر",66,"ر",1,0],["إلى بدر يلوذ الضيف منه","ببحر قد تعود نحر بُدنِ",67,"ن",1,0],["إلَى بَارِي الوَرَى وَجَّهْتُ وَجْهي","وَلَمْ يَكُ غيرَ نَحْوِ البّر يُصْرَفْ",68,"ف",1,1],["إِلى بحرِ الندا جمّ العطايا","إِلى شمسِ العلا تاج الفخارِ",69,"ر",1,0],["إلى باب خير الخلق خصصت وجهتي","ومن فضل باب الله أملت راحمي",70,"م",2,0],["إِلى بَهْرامَ شاهَ مذيلِ فَضْلٍ","على الأَيّامِ قُدِّسَ مِنْ مُذيلِ",71,"ل",1,0],["إِلى بَلَغَتْ مِنْهُ الْخيالاتُ ما أَرى","فَأَنْتَ لِماذا بالشُّخوص مُعَرِّضُ",72,"ض",1,0],["إلى باب من أغنى وأقنى وأنعما","إلى باب قهار أهان وأكرما",73,"م",2,0],["إلى باب من أفنى وأحيا وأعدما","إلى باب من يدعوه في الأرض والسما",73,"م",2,0],["إلى باب من درك الأماني بقصده","إلى باب من تعنو الوجوه لمجده",73,"ه",1,0],["إلى باب من في كل يوم بحمده","له أي شأن في الأنام جديد",73,"د",1,0],["إلى باب رب العالمين ومكرم ال","مطيعين خير الراحمين مقسم ال",73,"ل",1,0],["إلى باب وهاب الممالك قالب ال","كراسي قهار لكل عنيد",73,"د",1,0],["إلى باقلاء خِيف أن لا تقله","يَدَايَ لما بي من هواه فَنَصَّفَا",74,"ف",2,0],["إلى بابه سيرُ الوفود وقصْدُها","ونَحْو ذراه ميلُها ومَعاجُها",75,"ج",3,0],["إلى بابل بالسحر تنمى جفونه","وما كان لولاها ببابل من سحر",76,"ر",1,0],["إلى بابك العالي التجأت ومن يلذ","به عند كسر فهو لا شك يجبر",77,"ر",1,0],["إلى ب