{"poems":[[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[66,"عيون لها مرأى الأحبة إثمد","https://www.aldiwan.net/poem40291.html","الطويل"],[97,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[46,"لعل نجوم الليل تعمل فكرها","https://www.aldiwan.net/poem22317.html","الطويل"],[211,"سفحت عقيق الدمع من سفح مقلتي","https://www.aldiwan.net/poem13304.html","الطويل"],[323,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[365,"خذ القلم العالي إليك موقعا","https://www.aldiwan.net/poem60887.html","البسيط"],[404,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[462,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[469,"لنا أخ خير بلا شر","https://www.aldiwan.net/poem60080.html","السريع"],[469,"قم فاصطبح قبل يكبو","https://www.aldiwan.net/poem60326.html","المجتث"]],"verses":[["فَمُفَجَّعٌ خلجَ الفراقُ قرينَه","وممتَّعٌ بقرينه لم يَبْأس",0,"س",1,0],["فَمُفرَدُها مِن نَثرِ سَيفِكَ تَوأَمٌ","وَتَوأَمُها مِن نَظمِ رُمحِكَ مُفرَدُ",1,"د",1,0],["فمفترقان فيه إِلى لقاءٍ","وملتقيان حتّى في التنائي",2,"ا",2,0],["فَمُفتَضِحٌ يُبدي ضَمائِرَ صَدرِهِ","وَمُخفٍ ضَميرَ النَفسِ فَهُوَ مُجاهِدُ",3,"د",1,0],["فمفترق وجدي وصبري عنكم","ومتفق سقمي لديكم ولوعتي",4,"ي",1,0],["فَمَفروقٌ وَحارِثَةُ بنُ عَمروٍ","هُما الفَرعان مَجدُهُما تَليدُ",5,"د",1,0],["فمِفتاحُ آمالي أنامِلُك الّتي","تَحُلُّ بها من مَطْلَبي عُقَدَ الدَّهْر",6,"ر",1,0],["فمفرج الكحلاني","من جملة الجنان",7,"ن",1,0],["فمُفرقٌ للمارقينَ مُبَدِّدٌ","ومُعفِّرٌ للمُشْركينَ مُقتِّلُ",8,"ل",1,0],["فَمَفرِقي في التاجِ مِن رِفدِهِ","وَجيدُهُ في العِقدِ مِن شُكري",9,"ر",2,0],["فَمَفرِقُ اليَومِ فيهِ","مِنَ المَلاحَةِ تاجُ",10,"ج",1,0]]}