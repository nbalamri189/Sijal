{"poems":[[53,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[68,"عيون لها مرأى الأحبة إثمد","https://www.aldiwan.net/poem40291.html","الطويل"],[99,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[48,"لعل نجوم الليل تعمل فكرها","https://www.aldiwan.net/poem22317.html","الطويل"],[214,"سفحت عقيق الدمع من سفح مقلتي","https://www.aldiwan.net/poem13304.html","الطويل"],[327,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[369,"خذ القلم العالي إليك موقعا","https://www.aldiwan.net/poem60887.html","البسيط"],[409,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[466,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[473,"لنا أخ خير بلا شر","https://www.aldiwan.net/poem60080.html","السريع"],[473,"قم فاصطبح قبل يكبو","https://www.aldiwan.net/poem60326.html","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59238","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79850","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27458","الوافر"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130748","الطويل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62802","الكامل"],[6093,"حُوارٌ مَعَ نَاقِدٍ ( الهَزَج )","https://www.poetsgate.com/ViewPoem.aspx?id=187204",""]],"verses":[["فَمُفَجَّعٌ خلجَ الفراقُ قرينَه","وممتَّعٌ بقرينه لم يَبْأس",0,"س",1,0],["فَمُفرَدُها مِن نَثرِ سَيفِكَ تَوأَمٌ","وَتَوأَمُها مِن نَظمِ رُمحِكَ مُفرَدُ",1,"د",1,0],["فمفترقان فيه إِلى لقاءٍ","وملتقيان حتّى في التنائي",2,"ا",2,0],["فَمُفتَضِحٌ يُبدي ضَمائِرَ صَدرِهِ","وَمُخفٍ ضَميرَ النَفسِ فَهُوَ مُجاهِدُ",3,"د",1,0],["فمفترق وجدي وصبري عنكم","ومتفق سقمي لديكم ولوعتي",4,"ي",1,0],["فَمَفروقٌ وَحارِثَةُ بنُ عَمروٍ","هُما الفَرعان مَجدُهُما تَليدُ",5,"د",1,0],["فمِفتاحُ آمالي أنامِلُك الّتي","تَحُلُّ بها من مَطْلَبي عُقَدَ الدَّهْر",6,"ر",1,0],["فمفرج الكحلاني","من جملة الجنان",7,"ن",1,0],["فمُفرقٌ للمارقينَ مُبَدِّدٌ","ومُعفِّرٌ للمُشْركينَ مُقتِّلُ",8,"ل",1,0],["فَمَفرِقي في التاجِ مِن رِفدِهِ","وَجيدُهُ في العِقدِ مِن شُكري",9,"ر",2,0],["فَمَفرِقُ اليَومِ فيهِ","مِنَ المَلاحَةِ تاجُ",10,"ج",1,0],["فَمَفْرَقُهَا السَّعْدِيُّ فِي الفَرْعِ غَائِبًٌ","وَوَاضحُهَا البَدْرِيُّ بِالسَّعْدِ طَالِع",11,"ع",1,0],["فمفرد كثلث نصب من ألف","فتحاً وكسراً في الرسوم قد ألف",12,"ف",1,0],["فمفردٌ كرأسِ صاد بالإلف","عند ابتدائه بسنّ قد ألف",12,"ف",1,0],["فمفرد مضى وفي التركيب","حرفان أو اكثرُ بالترتيب",12,"ب",1,0],["فمفاصلي وجفونه ال","وسنا سواءٌ في الفتورِ",13,"ر",1,0],["فمفردها مثناها","إذا ما جاء ساكنها",14,"ن",3,0],["فمفتاحه تفديه روحي ولو غدا","بكل بقاع الارض جسمي له نثر",15,"ر",1,0],["فمفهم اشتراك الكلى","كاسد وعكسه الجزئى",16,"ا",2,0],["فمفتاح أبواب العلوم بأيديهم","وسر العطاء موهوب بلمح نظرة",17,"ه",1,0],["فمُفارقُ الإوانِ فيها رابحٌ","ما لم يُفارقْ روحَهُ جُثمانُهُ",18,"ن",2,0],["فَمَفْهُوَمكَ لَمْ أَقْصِدْ","وَ مَقْصُوْدِيَ لَمْ تَفْهَمْ",19,"م",1,0]]}