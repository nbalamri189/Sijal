dhabi.ae/diwan/poem/96066","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120501","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4815,"إربد في زمن الكورونا (الأقحوانة)","https://www.poetsgate.com/ViewPoem.aspx?id=211062",""],[4914,"لك في الوجود حقيقة لا تكشف","https://www.poetsgate.com/ViewPoem.aspx?id=170943",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[4962,"على دروب الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=198543",""],[4984,"فيا رمضان الجد","https://www.poetsgate.com/ViewPoem.aspx?id=175575",""],[5131,"وإذا الأكفُّ تفرَّقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=175835",""],[5131,"يا بلادي ما اغتربنا ما نأيْنا","https://www.poetsgate.com/ViewPoem.aspx?id=42208",""],[5135,"الدُّنْيا","https://www.poetsgate.com/ViewPoem.aspx?id=206225",""],[5285,"محض اختيار","https://www.poetsgate.com/ViewPoem.aspx?id=203580",""],[5323,"من النافذة","https://www.poetsgate.com/ViewPoem.aspx?id=207565",""],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5351,"دعوه يعد للعشرة","https://www.poetsgate.com/ViewPoem.aspx?id=203209",""],[5413,"توقف أمام الموت","https://www.poetsgate.com/ViewPoem.aspx?id=201373",""],[5419,"الحب سرا","https://www.poetsgate.com/ViewPoem.aspx?id=32226",""],[5725,"الوليد المنتظر","https://www.poetsgate.com/ViewPoem.aspx?id=207475",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5910,"في الدفاع عن السُّنَّة النبوية الشريفة","https://www.poetsgate.com/ViewPoem.aspx?id=206238",""],[5910,"رأيتُ بنورِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206315",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[186,"وداع وما يغني الوداع من الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55748&r=&rc=11",""]],"verses":[["فَعَمَّا قَليلٍ وَهُوَ في غَفَلاتِهِ","أَناخَت صُروفُ الحادِثاتِ بِبابِهِ",0,"ب",2,0],["فعُمْرُهُ المَكْتوبُ لا يَنْقَضي","وإنْ تَقَضّى عُمْرُ سامٍ ونُوحْ",1,"ح",1,0],["فَعَمَّ الشَّرْقُ مِنْ آيَا","تِهَا الحَسْنَاءِ مَا عَمَّا",2,"م",2,0],["فَعَمروٌ عَمُّنا وَأَنا اِبنُ زَيدٍ","فَأَكرِم بِالأُبوَّةِ وَالعُمومِ",3,"م",1,0],["فَعَمّي اِبنُ الحَيا وَأَبو شُرَيحٍ","وَعَمّي خالِدٌ حَزمٌ وَجودُ",4,"د",1,0],["فَعَمَّرَهُ الإِلَهُ لَنا طَويلاً","وَزادَ اللَهُ نِعمَتَهُ دَواما",5,"م",2,0],["فَعُمرُ لَيلي طَويلٌ","وَعُمرُ نَومي قَصيرُ",6,"ر",1,0],["فعميتَ عن سنَن الطري","قِ وظِلْتَ تركبُ كل لابهْ",7,"ب",2,0],["فَعُمِّيَ عنهُ ناظراه كأنهُ","بعوراءِ عيْنَيْ جَدِّه ظلّ ينظر",8,"ر",1,0],["فعمودُ القُفل يُمنا","كَ ويُسراك الفَراشهْ",9,"ش",2,0],["فَعُمرُ ذا عُمرُ صَبري","وَعُمرُ ذا عُمرُ صَدّكْ",10,"ك",1,0],["فَعِم صَباحاً لَقَد هَيَّجتَ لي شَجَناً","وَاِردُد تَحِيَّتَنا إِنّا مُحَيّوكا",11,"ك",2,0],["فعمَّ الورى بالفضلِ طُرَّاً وخَصَّنِي","فأفضلُ آلاءِ الرجالِ عميمُها",12,"م",3,0],["فَعُمرانُ اِستِهِ جَمٌّ وَلَكِن","لَهُ قُدّامَهُ أَيرٌ خَرابُ",13,"ب",1,0],["فَعَمَّ بِشَرٍّ أَهلَها وَبِلادَها","وَخَصَّ ذَوي أَقدارِها بِالمَعاطِبِ",14,"ب",1,0],["فَعَميتُ حَتّى صِرتُ فيهِ كَأَنَّني","أُعطيتُ مِن رَيبِ المَنونِ أَمانا",15,"ن",2,0],["فعمرتها وَملَكتَ كلّ رئاسةٍ","منها ودمّرْتَ العدا تدميرا",16,"ر",2,0],["فَعمٍ أَسِيلٍ عَرِيضِ أَوظِفَةِ الرِ","جلَينِ خاظِي البَضيعِ مُلتَئِمِ",17,"م",1,0],["فَعَمَدا لِلَّتي عَن أَكلِها نُهِيا","بأَمرِ حَوَّاءَ لَم تَأخُذ لَهُ الدَّغَلا",18,"ل",2,0],["فَعَمَدْتَ تَنْفِي بِاليَقِينِ مِنَ النُّهَى","مَا دَسَّ مِنْ رَيْب لِسَانُ القَالِي",19,"ل",2,0],["فعمّ الحواضرَ طوفانُهُ","وفاضَتْ شآبيبُه بالقرى",20,"ر",2,0],["فعم الخلود بها قصور مقامة","يحبوك سعد عزها وينيله",21,"ل",2,0],["فَعمدت لَما أَن سَمعت مَقالَهُ","لِمطيتي وَمِن العُيون عُيون",22,"ن",1,0],["فَعمَةش الرِّدفِ لَدنَةِ القذَّ مِخلاَ","فِ المَواعِيدِ طَفلَةٍ عَدراءِ",23,"ا",2,0],["فعمرك فرصة إن تنتهزها","وتغنم منه ما وافي ظفرتا",24,"ت",2,0],["فَعَمَّت تِلكُمُ النَعماءُ مِنهُ","نِزاريَّ الأُبُوَّةِ وَاليَماني",25,"ن",2,0],["فَعمَ المَناكِبِ نَهّاضاً إِذا حُشِيَت","مِنهُ البَراذِعُ جَوزاً مارِناً سَلِباَ",26,"ب",2,0],["فعمروٌ ضاربٌ زيداً","وزيدٌ ضاربٌ عمرا",27,"ر",2,0],["فعُمان قد شرّفت به وبسّره","نالت به فضلاً على الأقطار",28,"ر",1,0],["فعمّن أخذت البخل يا جار فتيةٍ","هم الجعفر المنساب في جوف بطحاء",29,"ا",2,0],["فَعَمّا قَريبٍ ستارُ حَياتي","عَلى كُلِّ ما مَرَّ بي يُسدَلُ",30,"ل",1,0],["فعُمِّر عُمْرَ الدهرِ يُرْجَى ويُتَّقَى","ويَستخدِمُ الإسلامُ في عصرِه الكفرا",31,"ر",2,0],["فعمَرْنا بذاك مدَّة دهرٍ","كلُّنا ظاهرُ الرضا مسرور",32,"ر",1,0],["فعُمِّر عُمْر باقيةِ الليالي","تواصِلُه السلامة والخلود",33,"د",1,0],["فعمّى عليه العنكبوت بنسجه","وظل على الباب الحمام يبيض",34,"ض",1,0],["فَعَموا وَأَبصَرَ قَولَهُ حَقّاً أَبو","بَكرٍ بِعَينِ حَقيقَةِ الإِيمانِ",35,"ن",1,0],["فَعَمّاها المُرَّعَثُ وَاِبنُ أَوسٍ","وَجَدّاها المُبَرَّدُ وَالخَليلُ",36,"ل",1,0],["فَعمُ حِياضِ العَطاءِ لا وَشلٌ","يَومَ النَدى وِردُهُ وَلا ثَمَدُ",37,"د",1,0],["فَعُمَرٌ وَهْوَ لِلْعُلاَ قَمَرٌ","خِيرَةُ أُسْرَتِنَا وَسَيِّدُهَا",38,"د",3,0],["فعمي صباحاً وانعمي أبداً","يا دارُ فيكِ مقيمةٌ هندُ",39,"د",1,0],["فعم عفوكم جل الورى وغدا","لابن البروني حظ وافر القسم",40,"م",1,0],["فَعَمَّ الأُنسُ وَاِنشَرَحَت صُدورُ","وَلاحَ مِنَ الثَنا دُرٍّ نَضيدُ",41,"د",1,0],["فَعَمّا قَريبٍ قَد تَراهُ مُقَلِّداً","مَناصِبَ عُليا راقِياً في المَفاخِرِ",42,"ر",1,0],["فعمري كلّه رمضا","ن حرمانٌ بلا حدّ",43,"د",1,0],["فَعمَّنا فيض إِحساناتها وَلَقَد","كُنّا طَرائق مِن هَذا الوَرى قددا",44,"د",2,0],["فَعُمّرْتَ ما امتدَّ عُمْرُ الزّمانِ","وفي نِعَمٍ يَتوالَيْنَ تَتْرى",45,"ر",2,0],["فعمرنا كالخَمره","ومكره كالخِمره",46,"ه",1,0],["فعمري قد تقضى في شرور","وفي زور وفي كسب الذنوب",47,