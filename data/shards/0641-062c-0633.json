{"poems":[[53,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[63,"أنعته معصفر البردين","https://www.aldiwan.net/poem51418.html","الرجز"],[82,"خليفة الملك ترى عنده","https://www.aldiwan.net/poem31294.html","السريع"],[71,"صديق لي بلي بحكيم سوء","https://www.aldiwan.net/poem28032.html","الوافر"],[54,"كأنه لما غدا","https://www.aldiwan.net/poem27170.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[208,"بدأت بعتب كان فرعا بلا أصل","https://www.aldiwan.net/poem53190.html","الطويل"],[211,"عفا مجدل من أهله فمتالع","https://www.aldiwan.net/poem27933.html","الطويل"],[275,"تمرين يا ذات الملاء المزيل","https://www.aldiwan.net/poem35579.html","الطويل"],[275,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[371,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[382,"طوباك يا جسد العذراء إن له","https://www.aldiwan.net/poem59244.html","البسيط"],[411,"إني أرى صاحب السلطان في ظلم","https://www.aldiwan.net/poem49736.html","البسيط"],[447,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[482,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[563,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[569,"تحمل في الهوى ما لا يطاق","https://www.aldiwan.net/poem876.html",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83265","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37997","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107227","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202105","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56270","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125469","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125439","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60948","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201754","الوافر"],[2961,"","https://poetry.dctabudhabi.ae/diwan/poem/111550","السريع"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65218","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112350","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48354","الطويل"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141228","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123509","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136645",""],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123845","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139751",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/201301","المتقارب"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"اعتقيني","https://www.poetsgate.com/ViewPoem.aspx?id=213742",""],[4955,"ألاقي بعد بينك ما ألاقي","https://www.poetsgate.com/ViewPoem.aspx?id=188768",""],[585,"سل عن الكون من يحير جواباً","https://www.poetsgate.com/ViewPoem.aspx?id=161882",""],[5090,"نبضُ المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=184336",""],[5121,"صَهٍ صَهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=33838",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[482,"لكم مِن فؤادي شاهدٌ ليس يكذبُ","https://www.poetsgate.com/ViewPoem.aspx?id=111424",""],[5595,"العظيم له احتراما","https://www.poetsgate.com/ViewPoem.aspx?id=144522",""]],"verses":[["فجسومهم من أجلها تهوي بهم","ونفوسهم تسمو سموّ النارِ",0,"ر",1,0],["فجسمهُ شِبرانِ في شِبْرَيْنِ","يا حُسْنَهُ وهو صَريعُ الحَيْنِ",1,"ن",1,0],["فجسمها من ذهبٍ جامدٍ","يُذيبُهُ روحٌ له مُضْطَرِم",2,"م",1,0],["فجسَّ وقالَ حُمَّى معْ صداعٍ","فقلنا يا حكيمُ بلا صداعِ",3,"ع",1,0],["فَجِسمُهُ مِن فَضَّةٍ","وَدِرعُهُ مِن سَبَجِ",4,"ج",1,0],["فَجِسْمِيَ فِي دَهْرِهِ مَاكِثٌ","وَقَلْبِيَ فِي أَوَّلِ الدَّهْرِ نَاءْ",5,"ا",2,0],["فَجِسْمٌ كَمِشْكَاة يَعِزُّ نَظِيرُهَا","بِإِتْقَانِهَا لَكِنْ خَبَا الدَّهْرَ نُورُهَا",6,"ه",2,0],["فجسمك إن يَختلَّه الوَعكُ ساعةً","فما قدرُك العالي لدينا بمختلِّ",7,"ل",1,0],["فَجُسنا مَعَ المَهدِيِّ مَكَّةَ عَنوَةً","بِأَسيافِنا وَالنَقعُ كابٍ وَساطِعُ",8,"ع",1,0],["فجسمُكِ تحتَ البُردِ يحكي وشيعةً","من العاجِ قد شُدَّت لتنّقِيش مخمل",9,"ل",1,0],["فجسمي كغصنٍ أيبسَ البَردُ زهرَهُ","وقلبي كسيفٍ في المعاركِ منفلِّ",10,"ل",1,0],["فَجِسمٌ تَراهُ بِهِ واقِعاً","وَهامٌ تَراهُ بِهِ طائِراً",11,"ر",2,0],["فجسمها كان خِدرَ اللَه فهو إذاً","يكونُ مع جسمِ مَن منها أتى ونما",12,"م",2,0],["فجِسمُهُ تَعِبٌ والنَّفسُ مُزعِجَةٌ","وعِرْضُهُ عُرْضَةٌ والدِّينُ مُنثَلِمُ",13,"م",1,0],["فجسمك في طبقات الثرى","وحمدك في ألسن الناس باق",14,"ق",1,0],["فجسومٌ تضني نحولاً وسُقماً","وقلوبٌ تبلى ولوعاً وبتَلا",15,"ل",2,0],["فجسمي على الخصر السقيم سقامه","ودمعي على الخد الأسيل يسيل",16,"ل",1,0],["فجسمي ورسمُ الدارِ لما تشابها","عفاءً سألتُ الركبَأيُّهما جسمي",17,"م",2,0],["فجسمك خلقه والروح أمر","له فافهم بفهم منه باهي",18,"ي",1,0],["فجسمي والنحول له ائتلاف","وقلبي والعزاء له افتراق",19,"ق",1,0],["فَجِسرَينِ زَبدينَ وَالأَشعَري","دِيارٌ بِها قَد أَوى وَاِعتَصَم",20,"م",1,0],["فجسمي بها قد قام في الجسدية","رقوم حروف نظمت بمقوله",21,"ه",1,0],["فَجِسمي بِلا قَلبٍ وَعَيني بِلا ضِيا","وَأُذني بِلا سَمعٍ وَصَدري بِلا حَشا",22,"ا",1,0],["فَجُسَّ بالرِّفقِ أَخِي نَبضَها","وَاكشِف عَلى أَعضائِها بالتَّمام",23,"م",1,0],["فجسمكَ في تلك المنازل نازلٌ","وقلبكَ في تلك الرواحل راحلُ",24,"ل",1,0],["فجسمك من دار الطبيعة بَدْؤه","ويُمْسِى إليها بالتحلل سَائِبا",25,"ب",2,0],["فجسمك مما تُنْبت الأرض يغتدى","ونفسك من نور يُجَلِّى الغَياهِبا",25,"ب",2,0],["فجسمي مثل فكري مثل فروي","نحول في نحولٍ في نحولِ",26,"ل",1,0],["فجسمي مما شَفَّهُ كادَ يختفي","نُحولاً ونفسي أوشكَت تَتَشَعَّعُ",27,"ع",1,0],["فجسمي قد غدا من فرط حبي","خيالا لا يفارقه ضياك",28,"ك",1,0],["فجسمي نحيل ورَبْعي مَحيلٌ","وقلبي عليلٌ وليلي طويل",29,"ل",1,0],["فجسمي ينتمي لذوي قمار","وروحي تنتمي لأبي العلاء",30,"ا",2,0],["فجسمه من ذهب جمد","وجلده صيغ من الزئبق",31,"ق",1,0],["فجُسنا القُرى لكن هَوى الركب أمّها","دعَتنا فَلَبينا وَجئنا نؤمّها",32,"ه",2,0],["فجسمي كمعنى دقّ عن ذهن ناقد","وإن كان ذهن الترجمان ونقدهُ",33,"د",2,0],["فجُسْنا خلالَ البحرِ نَنتشِق الصَّبا","فبعد ارتفاعِ الشمس بان لنا البَر",34,"ر",1,0],["فجسمي براهُ النّواح","فهلاّ لروحي رفيق",35,"ق",1,0],["فجِسْميَ ذو سُقْمٍ وجسْمُك ناعِمٌ","وجَفْني ذو سُهْدٍ وجَفْنُك ناعِسُ",36,"س",1,0],["فَجِسمِيَ أَصبَحَ كاَلشَّمعِ يُفنيِهِ","سَكبُ الدُّمُوعِ وَوَقدُ الحُرَق",37,"ق",1,0],["فجسمى طاوى الكشح قد صار عزه","لا خبث ذل بات لاناظر الغمض",38,"ض",1,0],["فجسمٌ للَضنى نهبٌ وقلبٌ","لسُكان الحمى أمسى رهَينا",39,"ن",2,0],["فجسمه ناحل عليل","وطرفه ساهر مسهد",40,"د",1,0],["فجسمي لدى تلك المرابع موثقٌ","وقلبي لدى تلك الظعون رهين",41,"ن",1,0],["فجسم جرى فيه ماء معين","وقلب غدا صخرة لا تلين",42,"ن",1,0],["فَجِسمي وَأَسقامي مُحالٌ وَواجِبٌ","وَدَمعي وَخَدّي أَحمَرٌ وَفَواقِعُ",43,"ع",1,0],["فجسمِي كاد يَفنَى مِن نُحولٍ","كَسَتنِيهِ دُجًى كفُّ الحنين",44,"ن",1,0],["فجسمي اليومَ قد أضحى نحيلاً","وقد بانت عظامي والتَّراقي",45,"ق",2,0],["فجسومٌ تعيش من غير روحٍ","كقفارٍ تعاف حتى السرابا",46,"ب",2,0],["فجسمي في (تَعزٍ) قد أقامَ","وقلبي عندَكم يا أحْبَاب حاضرْ",47,"ر",1,0],["فَجِسْمٌ وَرُوحٌ وَعَقْلٌ قَوِيِمٌ","وَبِالأَصْغَرَيْنِ أَسَاسُ الْمَبَانِي",48,"ن",2,0],["فَجِسْمُكَ المَتْرُوْكُ فِي شَطِّ الرَّدَى","أَيْقَظَ أَشْجَانِي ، بِحَقٍّ يَنْطِقُ",49,"ق",1,0],["فجسمي وقد بانوا الى الحيَّ راجعٌ","وقلبي مع الأحبابِ في الركب يَجنُبُ",50,"ب",1,0],["فجسرُ الراحة الكبرى لديك","يمور ُ جاذباً فيه الأناما",51,"م",2,0]]}