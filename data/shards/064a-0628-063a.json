.poetsgate.com/ViewPoem.aspx?id=133840",""],[2177,"بشرى فقد أقبل من لم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=127090",""],[5055,"من بعد هذا الحول","https://www.poetsgate.com/ViewPoem.aspx?id=86531",""],[585,"يا ساحة المجد أين المعجب الصلف","https://www.poetsgate.com/ViewPoem.aspx?id=161925",""],[5122,"((((( عيون الاخبار )))))","https://www.poetsgate.com/ViewPoem.aspx?id=37320",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5208,"يازوع قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=176850",""],[5327,"جُحُورٌ أخْرَجَتْ بَعدَ المَخَاضِ","https://www.poetsgate.com/ViewPoem.aspx?id=140764",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5410,"صرخات من أعلى المنارة","https://www.poetsgate.com/ViewPoem.aspx?id=142533",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5413,"أيها الحاضر المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=208594",""],[5431,"في يوم مولد سيدي محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=200935",""],[5434,"الله من عين طرقها صواديف","https://www.poetsgate.com/ViewPoem.aspx?id=37610",""],[5455,"اللي تركني","https://www.poetsgate.com/ViewPoem.aspx?id=34697",""],[5526,"الخطا","https://www.poetsgate.com/ViewPoem.aspx?id=204497",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5642,"الدمع والدم","https://www.poetsgate.com/ViewPoem.aspx?id=144554",""],[5648,"يبقا سلام الله لو الجرح ماطاب","https://www.poetsgate.com/ViewPoem.aspx?id=155217",""],[5720,"دربُ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=206070",""],[5848,"يامرحبا باالموت في الفلوجه","https://www.poetsgate.com/ViewPoem.aspx?id=53206",""],[5873,"المدلة بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=215918",""],[5956,"عجوزٌ يصف لي جانباً من حياته مع زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=214990",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""],[5126,"مرفوعة إلى صاحب الجلالة الملك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87829&r=&rc=44",""]],"verses":[["يَبْغِي بِهِ دَرْجاً إِلَى نَيْلِ الَّتِي","كَانَتْ قُوَى إِدْرَاكِهِ تَتَخَيَّلُ",0,"ل",1,0],["يَبغونَ أَن تَحتَوي الدُنيا خَزائِنُهُم","وَيَزرَعوا فَلَواتِ اللَهِ أَقطانا",1,"ن",2,0],["يَبغي مِنَ الأَبوالِ تِبراً خالِصاً","عَقلٌ لَعَمرُ أَبيكَ جِدُّ سَخيفِ",2,"ف",1,0],["يَبْغِي بِكُلِّ مَرَامِي عَبْقَرِيَتِهِ","تَكَافُؤَ الْحَسَبِ المَصْرِيِّ وَالْنَّسَبِ",3,"ب",1,0],["يبغُونَ إِعْجَالَ المَطَالِبِ كُلِّهَا","وَيَعِزُّ مَا يَبْغُونَ مِنْ إِعْجَالِهَا",4,"ل",3,0],["يَبْغِي الأَقَارِبُ لِي هَنَاءً آتِياً","بِالعِلْمِ وَهْوَ لِيَ الشَّقَاءُ الثَّانِي",5,"ن",2,0],["يَبْغِي هُدَى كُلِّ قَوْمٍ","إِلَى الصَّلاحِ المُلائِمْ",6,"م",1,0],["يَبْغِي التَّبَسُّطَ فِي الحَدِيثِ وَمَا بِهِ","أَنْسَابُ أَخْوَالِي وَلا أَعْمَامِي",7,"م",2,0],["يبْغي بذلك قربةً أو صيتَةً","وأَثيرُ همَّتِه رضا الرحمن",8,"ن",1,0],["يبغون ركناً لهم يستعصمون به","والركن من ضربات الدهر مهدود",9,"د",1,0],["يبغون من دغل بهم","لك في حفير ضاق وأدا",10,"د",2,0],["يبغون تصريحي ورب حقيقة","ليست تسيغ أجابها الافهام",11,"م",1,0],["يَبغي وَيَطغى وَالطَبيبُ مُضَلَّلٌ","قَنِطٌ وَساعاتُ الرَحيلِ دَواني",12,"ن",2,0],["يَبغي حِجابَ الشَمسِ يَطلُبُ عِندَها","عِزّاً تَحَمَّلَهُ الجُدودُ وَساروا",13,"ر",3,0],["يَبغي عَلِيّاً إِذ أَتى في جَحفَلٍ","حِنقينَ أَهلِ شَراسَةٍ وَمِراسِ",14,"س",1,0],["يبغونه جسداً فإن بعتِ","بذلوا النضار وأجزلوا المالا",15,"ل",2,0],["يَبغِي لُبانةَ مصرَ في مُستشرِفٍ","صَلْبِ الجوانبِ بابُه لم يُقرَعِ",16,"ع",1,0],["يَبغِي على الشَّعبِ الضّعيفِ بِأرضِه","ويُغالِبُ الدّيانَ فَوقَ سَمائِه",17,"ا",3,0],["يَبغِي السَّبيلَ إلى اسْتقلالهِ ويرى","كيدَ الحُماةِ وتضليلَ العِدى شَرَعا",18,"ع",2,0],["يبغون دينَ المالِ في أربابِه","والدّينُ دينُ الواحدِ القهّارِ",19,"ر",1,0],["يَبغونَ بِالقَتلِ مِقداماً يَصولُ عَلى","دينٍ لَهُم في حِمى الأَصنامِ مَقتولِ",20,"ل",1,0],["يَبْغِي الفريسةَ والمنيَّةُ مخلبٌ","وَيَصُولُ والأجلُ المعجَّلُ نابُ",21,"ب",1,0],["يَبغِي الأعَادِي غُرَاباً بِالحمَامِ وَقَد","يَنقَضُّ صَقراً بِحَيثُ الرُّومُ كَالحَجَلِ",22,"ل",1,0],["يبغي مواصلتي فيمنعهُ","بيضٌ كأسدِ الغابِ من ثغره",23,"ر",2,0],["يَبغي المَعاشِرُ في الزَمانِ وَصَرفِهِ","رُتَباً كَأَنَّ لَهُم عَليهِ رُتوبا",24,"ب",2,0],["يَبغي التَشَبُّثَ بِالأَوقاتِ جائِزُها","هَيهاتَ ما الوَقتُ إِلّا طائِرٌ طارا",25,"ر",2,0],["يَبغي الطَهارَةَ ناسِكٌ وَمَحَلُّهُ","في مَومِسٍ بَرِأَت مِنَ الإِطهارِ",26,"ر",1,0],["يَبغَونَ مبنىً مَبناً لَستُ أُحسِنُهُ","فَإِن صَدَقتُ عَرَتهُم رَوجُهٌ عُبُسُ",27,"س",1,0],["يَبغَونَ بِالخُسرِ الرَباحَ وَبِالأَذى","حُسنَ الثَوابِ فَكُلُّهُم مَوكوسُ",28,"س",1,0],["يَبغي الحُظوظَ أُناسٌ مِن ظُبىً وَقَناً","وَآخَرونَ بَغَوها بِالمَشاريطِ",29,"ط",1,0],["يَبْغي التَّزَيُّدَ فِيما نَالَ مِنْ كَرَمٍ","وَهْوَ النَّجِيُّ لَدَيْه الوَحْيُ والكُّتُبُ",30,"ب",1,0],["يَبغي البَيانَ وَقَد مَضى مَأثورُهُ","وَمِنَ القَضاءِ بَيانُ ما لَم يُكتَمِ",31,"م",1,0],["يبغي القوي افتراساً للضعيف بها","وَهَكَذا الناس ذؤبان وحملان",32,"ن",1,0],["يبغي المعالي في أوفى مجاهدة","فإن تخلف عنها لطف الحيلا",33,"ل",2,0],["يبغي دمنهور بهم فجاءها","في مدد قد ملئوا أرجاءها",34,"ه",2,0],["يَبْغِي رِضايَ وقَدْ أَوْدَى بِرُمَّتِهِ","وَكَيْفَ يَحْيَا صَرِيعٌ بَعْدَ إِيداءِ",35,"ا",2,0],["يَبْغِي الْعَزِيزَ مِنَ الْمُنى لِبِلاده","بِرَجَاءِ مُعْتصِمٍ وَيَأْسِ مُغَامِرِ",36,"ر",1,0],["يَبْغُونَ دُسْتُورَاً يُوَطِّيءُ حُكْمُهُ","سُبُلَ الْجَلاَءِ لأَمْكَثِ الزُّوَّارِ",37,"ر",1,0],["يَبْغِي سَلاَمَتَهَا وَرِفْعة شَأْنِها","فِي كُلِّ مُقْتَحَمٍ وَكُلِّ مَصالِ",38,"ل",1,0],["يبغضه المعجب إذ أنه","أخو اتضاع يبغض المعجَبَا",39,"ب",2,0],["يَبغي، الطّهارةَ، ناسكٌ، ومحلُّهُ","في مُومِسٍ بَرِئَتْ من الإطهار",40,"ر",1,0],["يَبْغِي الفريسةَ وht;”> الجوُّ مُستعِرٌ يَشُبُّ أُوارُهُ","وَيَعُبُّ فيه من اللَهِيبِ عُبابُ",41,"ب",1,0],["يبغى الاجارع من فيحاء كاظمة","والحدو قد رق منه نغمة التالي",42,"ل",2,0],["يبغي التخلص ما استطاع سبيلهُ","فإذا الأمورُ تحكمت يستسلمُ",43,"م",1,0],["يَبغي العِدى إِطفاءَ نارِكَ ضِلَّةً","فَيَزيدُها هَذا الفَعالُ تَسَعُّرا",44,"ر",2,0],["يبغي الوصال ولو تمزق تالفا","ويلذ أن يلقى العذاب ويتلفا",45,"ف",2,0],["(يَبْغونَها عِوَجًا) شاهَتْ وُجوهُهُمُ","الزَّيفُ دَيْدَنهُم وشأوُهمْ أودُ",46,"د",1,0],["يبغونَ رؤيتَهُ تغيبُ فلا تُرى","ليست قَضِيَّةَ كاتبٍ أو مُجْرِمِ",47,"م",1,0],["يَبغونَهُ كَيداً فَأَطفَأَ نارَهُم","فَتَفَرَّقوا بِمَذَلَّةٍ وَهَوانِ",48,"ن",1,0],["يَبغي الكِرام الغرّ أَرباب العُلا","المُحسِنين المُطعِمينَ الزادِ",49,"د",1,0],["يَبغي لَدَيَّ المَدحَ ضَلَّلَ سَعيَهُ","فيما بَغى مِنّي وَقَلَّ رَشادُهُ",50,"د",2,0],["يَبغي السَماءَ رَجاءً أَن سَيبلغها","جَهلاً بِهِ كانَ قَد ماهَلك هامانِ",51,"ن",1,0],["يَبغونَ بالعَذل بُرئي مِن عَلاقتِهِ","وَالقَولُ يُصلِحُ مَن لَم يجرحِ النَظَرُ",52,"ر",1,0],["يبغي قتالهم وليس بممكن","أن يستطيع مع الحمام قتالا",53,"ل",2,0],["يَبْغِي لدَيّ مَع العلاقة سَلْوَةً","أَرَأَيتَ مَحْظوراً يُعَدُّ مُبَاحا",54,"ح",2,0],["يبغي الرضا بوسيلة مقبولة","بُشراه قد ظفرَتْ بذاك يداه",55,"ا",2,0],["يَبغيهِ مِنها شَربَةً لَطَهورِهِ","لِأَبي وَقالَ تَيَمَّمنَ بَصَعيدِ",56,"د",1,0],["يَبغي فَسادي ما اِستَطاعَ","وَآمُرُهُ مِمّا أَرُبُّه",57,"ب",2,0],["يبغي منال الفوز من طرق الغنى","ويرود خصبها الذي لا يمحل",58,"ل",1,0],["يبغي انطلاقاً وهو قيد جبلة","مرذولة من طينة الأرضين",59,"ن",1,0],["يَبْغي الوُثوبَ على الجيادِ خَفيفُهمْ","فيَرى له وَطْأً عليهِ ثَقيلا",60,"ل",2,0],["يَبْغي مَكانَك في العلاءِ وما لَه","عن نَيلِ مَجْدك غَيرُ عَضِّ اليَرْمَع",61,"ع",1,0],["يَبْغي الكريمُ بها العلاءَويجتَبي","أملُ الفقير نوالَهُ المَوهوبا",62,"ب",2,0],["يَبغي عَلَيها القَومُ إِذ أَرمَلوا","وَساءَ ظَنُّ الأَلمَعِيَّ القرور",63,"ر",1,0],["يبغون أن يبلغوا شأوي ومن لهمُ","به وكم بين صمّ الصخر زالذهب",64,"ب",1,0],["يبغي الزعامة صعلوك بفطرته","بئس الزعامة في أيدي الصعاليك",65,"ك",1,0],["يبغي مساعيك متعبٌ يدُهُ","تفتُلُ حبلاً لشاردِ الإبلِ",66,"ل",1,0],["يبغي فينشُرُ مكراً","يطويه من بعد نشرِهْ",67,"ر",2,0],["يبغي عِثارَك وهو في تعبٍ","كالليل طالبُ عثرةِ البدرِ",68,"ر",1,0],["يبغون مُشْكي المُجدبات وماجداً","تُغني رغائبه غناء الهُمَّعِ",69,"ع",1,0],["يبغي مُناخاً كاملاً بالنَّدى","عند منيعِ الجارِ جَمِّ النَّوالْ",70,"ل",1,0],["يبغيه أصبح تاوياً","سَدِكَ المعَاطسِ بالتُّرابِ",71,"ب",1,0],["يبغي النَّدى والأمْنَ لما اخلف ال","رَّعْدانِ من مُتوعدٍ ومُجلْجلِ",72,"ل",1,0],["يبغي سحوح الحَيا من غير مسألةٍ","فطرفهُ الدهرَ لم يلمح ولم يَشمِ",73,"م",1,0],["يبغون إذ هرمتْ أيامُ ملكهمِ","ملكاً لديهِ شبابُ الملك مقتبل",74,"ل",1,0],["يبغونَ محوَ اِسمِه من صُحْفِ مَنصِبِه","واللَّهُ في لوحِه المحفوظِ يَزبُرُهُ",75,"ر",2,0],["يَبْغِي سقاطي وَالّذي","يريده أعيَا الأُمَمْ",76,"م",1,0],["يبغي خِلافي فإنْ لايَنتُه خشنتْ","منه الخلائقُ أو باكيته ضحكا",77,"ك",2,0],["يبغي رضَى اللهِ مُهتمّاً بطاعتَهِ","وفي مَنافعِ خَلقِ اللهِ يَجتهدُ",78,"د",1,0],["يَبغِي الفِرارَ من المَنيِّةِ جاهداً","وإلى المنيَّةِ كلَّ يومٍ قد جَرى",79,"ر",2,0],["يَبغي جَميعَ الوَرى إيفاهُ دينَ ثَنا","فَيَعجَزونَ وَدينُ الشُكرِ مَمطولُ",80,"ل",1,0],["يَبغي الحياةَ إلى شعبِ العراق ومن","فيه ويرعى حقوقَ الشعب والوطنِ",81,"ن",1,0],["يبغى سلوباً كل حرف عامل","جزماً وما فيه لفعل مصدر",82,"ر",1,0],["يُبغض ذا العرش ومن يَصطفي","من رُسْلِهِ بِالنِّير الفاصِلِ",83,"ل",1,0],["يبغي بما يفعل من ربّه","ما نيله من أجره يَعْظُمُ",84,"م",1,0],["يبغي مغالطة العيون بها لكي","يخفي عقاربه مدب صلاله",85,"ل",2,0],["يَبغي الصُدودَ وَكَيفَ ذاكَ وَإِنَّما","يَزدادُ بِالتَذبيجِ عِشقُ الوالِهِ",86,"ل",2,0],["يبغي الحصول ولو على جحشٍ لكي","يقضي مآرب نفسه المحزونَهْ",87,"ن",2,0],["يبغي لي في ذاك دوام الأسر","هذا ضررٌ يحسبه لي نفعا",88,"ع",2,0],["يبغي العُلى وهو شيخٌ","همٌّ بهمَّة طفلِ",89,"ل",1,0],["يبغي إلى أقدامها صلةً","عَبثاً وما لبلوغها سببُ",90,"ب",1,0],["يبغي القِرَى نزيلهم فينثني","ودون ما قد زودوه السغب",91,"ب",1,0],["يَبغُونَ مِنهُم دَعوَةً ويقَبِّلُو","نَ أيَادِياً مِنهُم رَجَا الغُفرَانِ",92,"ن",1,0],["يبغي التمتع مفردا من حبه","متجردا يبغي شفيع قران",92,"ن",1,0],["يبغي له سكنا يلذ بقربه","فتراه شبه الواله الحيران",92,"ن",1,0],["يبغِى القضَاء عَلَى العرُوبَةِ والْ","إسْلامِ والأمجَادِ والنَّسَبِ",93,"ب",1,0],["يَبغَ