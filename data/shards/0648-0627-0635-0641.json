وز فجر الشهادة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204036",""],[5168,"ماسنجر النت","https://www.poetsgate.com/ViewPoem.aspx?id=33624",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5376,"عمَّ السماءَ فضائلٌ وسناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188367",""],[5525,"اللي هجرني","https://www.poetsgate.com/ViewPoem.aspx?id=7254",""],[5691,"جلد النمر","https://www.poetsgate.com/ViewPoem.aspx?id=206665",""],[5691,"أفْوافٌ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207696",""],[5736,"أوجاع أمة المليار","https://www.poetsgate.com/ViewPoem.aspx?id=208497",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6093,"أدب النقد ونقد الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=208760",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""],[6152,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=203272",""],[186,"وداع وما يغني الوداع من الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55748&r=&rc=11",""],[463,"تموق الليالي فيكمُ ثم تعقلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60290&r=&rc=346",""]],"verses":[["وَأَصفاكَ بِمُلكِ الأَر","ضِ مِن شَرقٍ إِلى غَربِ",0,"ب",1,0],["وَأُصفيكَ وُدّي وَبَعضُ الرِجا","لِ يَمزِجُ بِالوُدِّ ماءَ القِلى",1,"ا",1,0],["وأصْفَرَ حَلاّهُ الأصيلُ نَضارةً","ووشّى بنَيْلِ اللّيْلِ أعرافَهُ وشْيا",2,"ي",2,0],["وَأَصفَرَ كَالحِنّاءِ طامٍ جِمامُهُ","إِذا ذاقَهُ مُستَعذِبُ الماءِ يَبصُقُ",3,"ق",1,0],["وَاِصفَحوا عَن هَناتِ مَن كانَ مِنكُم","رُبَّ هافٍ هَفا عَلى غَيرِ عَمدِ",4,"د",1,0],["وَأَصفَحوا عَن عُقولِنا وَدَعوا الخَل","قَ بِسِرِّ التَوراةِ وَالتُلمودِ",5,"د",1,0],["وأصفرَ في لون العشيِّ وذيلُهُ","وَلَوْنُ الذي بعد العشيةَ يُعلَمُ",6,"م",1,0],["واصفر في ثوب الأصيل قد ارتدى","ورُبَّتَما ودّتْ حِلاه الأصائلُ",7,"ل",1,0],["وأصفَاهُ النَّبِيُّ على اختِيَارٍ","بِمَا أعيَى الرُّفُوضَ له المُذِيعَا",8,"ع",2,0],["وأصفر الجلدة كالدينار","يسرُّ كفّ الصائد الممتار",9,"ر",1,0],["واصف حرمتي وواجب حقي","ومكاني لديك أبلغ وصف",10,"ف",1,0],["واصِفاهُ بذاك لم يضعاه","بل أَحلّاه في رؤوس الرِّعان",11,"ن",1,0],["وَأَصفَرَ عَطّافٍ إِذا راحَ رَبُّهُ","جَرى اِبنا عِيانٍ بِالشِواءِ المُضَهَّبِ",12,"ب",1,0],["وَأَصفَرَ مَجدولٍ مِنَ القِدِّ مارِنٍ","يُلاثُ بِعَينَيها فَيُلوى وَيُطلَقُ",13,"ق",1,0],["وَاِصفَرَّ أَبيَضُ كُلِّ شَيءٍ حَولَها","وَاِحمَرَّ بُرقُعُها وَكانَ الأَصفَرا",14,"ر",2,0],["وأَصْفَرَ قِمَّةٍ وحَجَاجِ عَيْنٍ","فتحسبهُ تكَحّلَ مِنْ وُرُوسِ",15,"س",1,0],["وَأَصفَحُ لِلبَلى عَن ضَوءِ وَجهٍ","غَنيتُ يَروعُني مِنهُ الشُحوبُ",16,"ب",1,0],["وَأُصفِيَ مِن بُرغوثَ سَبيٌ كَأَنَّما","عَقابيلُ أَسرابِ الظِباءِ عَقابِلُه",17,"ل",2,0],["وَإِصفِرارٍ مِن لَونِهِ وَإِبيِضاضٍ","كَاِجتِماعِ اللُجَينِ وَالعِقيانِ",18,"ن",1,0],["واصفرَّ من مَغربِها إزارُها","وحانَ من واردةٍ إصدارُها",19,"ر",3,0],["وأصفَحُ والمَنايا الحُمْرُ حَولي","تَبَرَّجُ والصَّواعقُ من جنودي",20,"د",2,0],["وَاِصفَرَّ عودٌ لَها مِن بَعدِ خُضرَتِهِ","وَأَسقَطَ البَينُ عَن أَغصانِهِ الوَرَقا",21,"ق",2,0],["وَأَصفَرَ مِثلِ الزَعفَرانِ شَرِبتُهُ","عَلى صَوتِ صَفراءِ التَرائِبِ رودِ",22,"د",1,0],["وَأَصفَحُ عَن ذَنبِ الصَديقِ وَغَيرِهِ","لِسُكنايَ بَيتَ الحَقِّ بَينَ الصَفائِحِ",23,"ح",1,0],["وَأَصفَرَ مَضبوحٍ نَظَرتُ حِوارَهُ","عَلى النارِ وَاِستَودَعتُهُ كَفَّ مُجمِدِ",24,"د",1,0],["وأَصْفَرَ عَطَّافٍ إِذَا رَاحَ رَبُّهُ","غَدَا ابْنَا عِيَانٍ بِالشِّوَاءِ المُضَهَّبِ",25,"ب",1,1],["وأَصَفَر مَضبُوحٍ نَظَرتُ حَويَرهُ","عَلَى النَّارِ واسَتودعتهُ كَفَّ مُجمِدِ",26,"د",1,1],["وَأَصفح عَن دَهري عَلى أَنَّ صَرفَهُ","رَزاني بِفَقدِ اِبنٍ وَغَدرِ رَزانِ",27,"ن",1,0],["وأصفر حلاه الأصيل نضاره","ووشى بنيل النيل أعرافه وشيا",28,"ي",2,0],["وأصفيت أبناء الشام مودّتي","صغيرا وما نيطت عليّ التمائم",29,"م",1,0],["وأصفرَ عطّافٍ إذا راحَ ربّهُ","جَرَى کبْنَا عِيَانٍ بِالشِّواءِ کلْمُضَهَّبِ",30,"ب",1,0],["وَأُصْفيكَ وُدّي، وَبَعضُ الرّجا","ل يمزج بالود ماء القلا",31,"ا",1,0],["واصفح ولا تجبن وباعد مقرفا","افعاله تهحط عن افواله",32,"ل",2,0],["وَأَصفَحُ عَمَّن لَو أَشاءُ جَزَيتُهُ","فَيَمنَعُني رُشدي وَيُدرُكني حُلُمي",33,"م",2,0],["واصفحْ اللهم واسدْد خَلَّتِي","واكفنى شرّ اللّتيا والَّتِي",34,"ي",1,0],["وَأَصفَرَ مِن قِداحِ النَبعِ صُلبٍ","بِهِ عَلَمانِ مِن عَقَبٍ وَضَرسِ",35,"س",1,0],["وَأَصفاهُمُ ذِهناً وَأَنداهُمُ يَداً","وَأَضفاهُمُ ظِلّاً وَأَوفاهُمُ رِفدا",36,"د",2,0],["وَأَصفاكَهُ عَفواً وَلَم يُطِعِ الهَوى","لِمَيلٍ وَلَم يَعصِ الكِتابَ المُنَزَّلا",37,"ل",2,0],["وَاِصفَع بِنَعلِكَ رَأسَ الدَهرِ واِسطُ عَلى","أَحداثِهِ سَطوَ ضِرغامٍ عَلى حُمُرِ",38,"ر",1,0],["وَأَصفَحُ عَن جُهّالِ قَومي حَمِيَّةً","وَإِن أَسرَجُوا في هَدمِ عِزّي وَأَلجَموا",39,"م",3,0],["وأصفح عن محنتي بالفتون","ورمى فؤادي بسهم الجنون",40,"ن",1,0],["وأصفيت الهوى حبا","له من دلّه حجب",41,"ب",1,0],["واصفح فلست بطارق","من دون بابك أي باب",42,"ب",1,0],["وأصْفَى لي بِه الدهرُ","هوىً ما فيه أضْغانُ",43,"ن",1,0],["وأَصفرَ من ياسَمِيِنِ الرِياض","يلوح على زُرْقة الخُرَّمِ",44,"م",1,1],["وَأَصفَرِ اللَونِ رَحي","بِ الصَدرِ سامي العُنُقِ",45,"ق",1,0],["واصِفاً تِلكَ الوُجوهَ ال","عَرَبيّاتِ الوِضاءا",46,"ا",3,0],["واصفح عن الجاني فإنَّ الذي","ترجوه عفو اللَه عن خلقهِ",47,"ق",2,0],["واصفر غيظاً علي وامتزجت","صفرةُ ذاك اللجين بالذهب",48,"ب",1,0],["واصفر من حسد لمبسمه","الشهي الأقحوان",49,"ن",1,0],["واصفيك يا دهري ودادي على القلى","واسألك الجدوى وأنت بخيل",50,"ل",1,0],["وَأَصْفى حَياةً عِنْدُهمْ وَأَرَقَّها","وَأَبْرَدَ ظِلاًّ فِي ذَراهُمْ وَأَنْداهُ",51,"ا",2,0],["وَإِصفائك الإقدام وَالحَزم والحجى","لِنُصرته جنداً وَأسرتهِ حزبا",52,"ب",2,0],["وَاِصفَرَّ لَوني وَالفُؤادُ قَدِ اِنبَرى","وَاِسوَدَّ حَظّي عِندَهُم لَمّا سَرى",53,"ر",2,0],["وَأَصفَرٍ كذائِب من ذَهَبِ","قَدْ حُلِّيتْ غُرَّتُهُ بِكَوكَبِ",54,"ب",1,0],["وَأَصفَرَ مَشهومِ الفُؤادِ كَأَنَّهُ","غَداةَ النَدى بِالزَعفَرانِ مُطَيَّبُ",55,"ب",1,0],["وأصفَحُ للإخوانِ عن كلَّ زَلّةٍ","وأصْحَرُ إن شئْتُ انْتقاماً لأقراني",56,"ن",2,0],["واصفةً للُعْبةٍ عَجْماء","ولَفْظُها للعَربِ العَرْباء",57,"ا",2,0],["وأصفَرَ ذي وجهين من غير علَّةٍ","يروح كما راحَ اللَّئيم ويغتدي",58,"د",2,0],["وأَصْفَى مياهَ الفِكْرِ مِنِّي فصفَّقَتْ","وأَرْوَى نباتَ الشُّكْرِ منِّي فأَمْرَعا",59,"ع",2,0],["وأصفَى خليلَيك الذي كنتَ تِربَهُ","وأحلى حبيبَيْك الذي هو أوّلُ",60,"ل",1,0],["وأصفحُ عنه عاذراً متأوِّلاً","وإن كثُرتْ زَلاّتُهُ وذنوبُهُ",61,"ب",2,0],["وأصفرُ الزهرِ ومبيضُّهُ","هذاكَ دينارٌ وذا درهمُ",62,"م",1,0],["واصفع قفا الذل ولو أنه","بين قفا القسيس والأسقف",63,"ف",1,0],["واصفَح لِشَاعِرِكَ إِن","فِي ذا الخِطابِ قد جَنى",64,"ن",2,0],["وَأَصْفَرٌ يَضْحَكُ فِي أَخْضَرٍ","كَأَنَّمَا وَاجَهَ مَهْجُورَا",65,"ر",2,0],["وَأَصْفَرِ اللَّونِ كَمَا","أُشْبِعَ بالوَرْسِ النَّمَطْ",66,"ط",1,0],["وأَصفاهم وداً أَخو الطبع منهم","وأَثبتهم في وحدة وفريقِ",67,"ق",1,0],["واصِفُه يُؤْجَرُ في وَصْفِه","لأَنه في قَوْلِه لا يَمِين",68,"ن",1,0],["وَأَصفَيتُهُ مِنّي إِخاءَ لَو أَنَّهُ","أَعارَ اللَيالي صَفوَهُ رُقنَ مَشرَعا",69,"ع",2,0],["وَأَصفَح عَن دَهر أَقامك بَعده","إِماماً بِهِ تَصفو مَوارد ورّاد",70,"د",1,0],["وَاصفح فَقَد حَلف الزَمان بِأَنَّه","يَأتي بِما يُرضيك مِن تحف سَنيه",71,"ي",2,0],["واصف الراح لي ولا يشرب الرا","ح معي في الرَّواحِ أو في البكور",72,"ر",1,0],["وَاِصفَح خَدينَ مَكارِمٍ","فَالصّفحُ مِن شِيَمِ الكِرام",73,"م",1,0],["وَاِصفَح أَخا الصّفحِ الجَميلِ إِذا هَفَت","هَفواً فَمِثلُكَ في البريّةِ صافحُ",74,"ح",1,0],["واصفحْ ترى الحر يغفِرْ ذنْب من يحتارْ","وصاحب العقل مُنْصفْ يعرف العايلْ",75,"ل",1,0],["وأصُفُّ قطنَ الوقتِ بين أضالعي","فيحَارُ بي ودمي فراغٌ أجوفُ",76,"ف",1,0],["وأصفي له ودي وان ظل ظاعناً","تسامره دون الرفاق الأيانق",77,"ق",1,0],["واصفراري وطول ليلي وويلي","وارتضاعي ثدي صدر النقير",78,"ر",1,0],["واصفوا عدل به قد أمنت","أدم القيعان من ذُوبانها",79,"ن",3,0],["وَأصفَيْنَا الوِدَاد لَكُم فَخُلْتُم","ورَفَّعْنَاكُمُ فَوَضَعْتُمُونَا",80,"ن",2,0],["واصفح عن الوالدين واصلح","بفضلك المرتجى فسادي",81,"د",2,0],["وَاِصفراري كونهُ في ال","كونِ مِن كون اِحمِرارِك",82,"ك",1,0],["وَأَصفَرٍ مِثلَ صَريعِ حُبِّهِ","إِذا تَغَشّاهُ غَواشي صَدِّهِ",83,"د",2,0],["وَأَصفَرٍ تَحُمُّرُ أَطرافُهُ","يا حُسنَهُ مِن مُطرِفٍ مُعلَمِ",84,"م",1,1],["وَأَصفَرَ يَهوي مِن ذُؤابَةِ أَخضَرَ","كَما اِنقَضَّ