{"poems":[[55,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[79,"أحب لحبها جملي ورحلي","https://www.aldiwan.net/poem35892.html","الوافر"],[79,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[53,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[93,"أطال الليل أم طال المقام","https://www.aldiwan.net/poem62708.html","عموديه"],[30,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[92,"العزم وأبناؤه","https://www.poetsgate.com/ViewPoem.aspx?id=178926",""],[119,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[173,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[178,"أيا من خان مخبره","https://www.aldiwan.net/poem46038.html","مجزوء الوافر"],[203,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[254,"عفا رسم برامة فالتلاع","https://www.aldiwan.net/poem2111.html","الوافر"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[411,"إذا استقبحت أمرا فاجتنيه","https://www.aldiwan.net/poem49426.html","الوافر"],[422,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[447,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[457,"كم حللت الحبى بشرخ الشباب","https://www.aldiwan.net/poem13629.html","الخفيف"],[457,"سيدي اكحل النواظر مرآك","https://www.aldiwan.net/poem13688.html","الخفيف"],[457,"يا لعهد مضى وعيش رغيد","https://www.aldiwan.net/poem13711.html","الخفيف"],[460,"لقد علمت وما الإسراف من خلقي","https://www.aldiwan.net/poem26637.html","البسيط"],[463,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[463,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[463,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[463,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[534,"ومن أخلص الأعمال لله لم يبل","https://www.aldiwan.net/poem37299.html","الطويل"],[556,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38585","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70749","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62509","السريع"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1898","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101907","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114031","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[2367,"","https://poetry.dctabudhabi.ae/diwan/poem/31367","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79721","المتقارب"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100172","الرمل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52971","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[290,"","https://poetry.dctabudhabi.ae/diwan/poem/129003","الوافر"],[4755,"مُجتَمَعُ العَناكِب","https://www.poetsgate.com/ViewPoem.aspx?id=205179",""],[4791,"داعي الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=28407",""],[5005,"قفا نبكِ..","https://www.poetsgate.com/ViewPoem.aspx?id=189391",""],[5191,"الحُمق","https://www.poetsgate.com/ViewPoem.aspx?id=211971",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[5281,"الفاجِعَة","https://www.poetsgate.com/ViewPoem.aspx?id=199665",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""]],"verses":[["وَمُناخُ كُلِّ مَطِيَّةٍ مَعقولَةٍ","وَمَجالُ كُلِّ مُناقِلٍ مُتَمَطِّرِ",0,"ر",1,0],["ومَنْ أخْشاهُ منْ سبُعِ ولصٍّ","فكيْفَ فريقُها سَلِموا فَريقا",1,"ق",2,0],["ومُناخُ فضْلٍ أقْصَدَتْهُ يَدُ الرّدى","وهِلالُ تِمٍّ خانَهُ أبْدارُهُ",2,"ر",2,0],["وَمَناخُها في كُلِّ مَنزِلَةٍ","كَمَبيتِ جونِيِّ القَطا الكُدرِ",3,"ر",1,0],["ومن أخْشى إذا ما زرتُ منه","صدوداً والمَنية في الصدودِ",4,"د",1,0],["ومن اختاره الأميرُ مدحنا","ه وكان السعيدَ غير النحيس",5,"س",1,0],["وَمِن أَخلاقِهِم لينُ الحُمَيّا","إِذا اِنتَسَبَت إِلى اللينِ المُدامُ",6,"م",1,0],["وَمِنّا خَطيبٌ لا يُعابُ وَحامِلٌ","أَغَرُّ إِذا اِلتَفَّت عَلَيهِ المَجامِعُ",7,"ع",1,0],["وَمَن أُخمِدَت مَع وَضعِهِ نارُ فارِسٍ","وَزُلزِلَ مِنها عَرشُها وَسَريرُها",8,"ر",3,0],["وَمُناخَ العافينَ في زَمَنِ المَح","لِ إِذا أَجحَرَت حَنينُ الشَمالِ",9,"ل",1,0],["ومن أخلفته في المعالي قضية","تكفل في إنتاجها الصارم العضب",10,"ب",1,0],["ومن اخلاقه الغر","صفاء الصدر والصبر",11,"ر",1,0],["وَمَناخَ مُمتاحِ النَوالِ وَعِصمَةً","لِلخائِفينَ وَمَلجَأً لِلجاني",12,"ن",2,0],["وَمَنْ أُخْفِي هَوَايَ لَهُ","وَدَمْعُ الْعَيْنِ يُظْهُرهُ",13,"ر",2,0],["ومن أخذَ العلومَ بغيرِ خُلقٍ","فقدْ وجدَ الجمالَ بغيرِ سابي",14,"ب",2,0],["وَمِن أُخرى مُثابِرَةٍ تُنادي","أَلا خَلَّيتُمونا لِلضَياعِ",15,"ع",1,0],["ومُناخا من لوعةٍ واكتئاب","يستجيبُ الحمامةَ الوَرقاءَ",16,"ا",2,0],["ومناخة في القلب تفزع","صمتها في كل أرض",17,"ض",1,0],["ومَنْ أختارُ بعدَك من هُمامٍ","وما بعدَ الهُدى غيرُ الضَّلال",18,"ل",1,0],["ومن آخيته وأردت ألا","يحولَ عن الإخاءِ فلا تعبهُ",19,"ب",2,0],["ومناخٍ لنا يريق من الأجفان","غير الذي تريق الغوادي",20,"د",2,0],["ومن أخطأته المنايا بكورا","أصابته وقت الضحى والعشي",21,"ي",1,0],["ومناخ في ظل جانب دَوْح","ومقيل بين الغصون الرطاب",22,"ب",1,0],["ومناخٍ على جوانب نَهْرٍ","سُنْدُسيّ الشطين عذب المجاج",23,"ج",1,0],["ومناخ من الرياض أقمنا","فيه ما بين نرْجسٍ وورود",24,"د",1,0],["وَمِن أَخٍ لي طَوى كَشحاً فَقُلتُ لَهُ","إِنَّ اِنطِواءَكَ عَنّي سَوفَ يَطويني",25,"ن",2,0],["ومن إخوان عَلَّاتٍ","جَفوْا بتخالف اللبَنِ",26,"ن",1,0],["ومَن أخو الفخر إذا ما أَشكلتْ","مذاهبُ الفخر وخيفتْ ظُلَمُهْ",27,"م",2,0],["ومَن أخذَ المحاسنَ عن سواكم","كمن أخذَ المناسبَ عن زيادِ",28,"د",1,0],["ومن أخَّرتْه شمسُ يومٍ فلم يمت","يمتْ حولَه أحبابُهُ وحبائبُهْ",29,"ب",2,0],["وَمَنْ أَخْلَصَ الأَعْمالَ للهِ لم يُبَلْ","وإنْ أَرْعَدَ الأَعْدا عَلَيْهِ وأَبْرَقوا",30,"ق",3,1],["ومُناخٌ للجودِ يَحظى ويَرضى","فيه مَن لم يكنْ على الدّهر يرضى",31,"ض",2,0],["وَمَن أَخطى فَكُن عَنهُ عَفوّاً","فَإِنّ العَفوَ مِن شِيَمِ الكِرامِ",32,"م",1,0],["ومن أخطأ الرأىَ السديدَ فلمْ يلمْ","سوى نفسِه والدهر يبُدي العجائبا",33,"ب",2,0],["ومن أخوه الملك المرتجى","تيمور حاز المجد والسؤدَدا",34,"د",2,0],["وَمُناخِ غَيرِ تَئِيَّةٍ عَرَّستُهُ","قَمِنٍ مِنَ الحِدثانِ نابي المَضجَعِ",35,"ع",1,0],["ومن أخلاقه تزهو كروض","أصيب بعارض الغيث الصبيب",36,"ب",1,0],["وَمِن أَخيهِ البَلَدُ الحَرامُ","وَخافَ مِن سَطوَتِهِ الأَنامُ",37,"م",1,0],["ومناخا لهم طويلا عريضا","قد سقاه الحيا وصوب العهاد",38,"د",1,0],["وَمِن اخوَاننا مَن غابَ فآرحم","ومن هُم في مجامعنا حضُور",39,"ر",1,0],["ومن أخلص التقوى إلى الله راغباً","كمن عبد الأوثان والجبتَ والصنم",40,"م",1,0],["وَمُناخِ نازِلَةٍ كَفَيتُ وَفارِسٍ","نَهِلَت قَناتي مِن مَطاهُ وَعَلَّتِ",41,"ت",1,0],["ومن أخذت نفسه دفعة","نصيب لذائذها والوئام",42,"م",1,0],["ومن اختار طريقاً للهدى","فليكن في بردتي ملتحقا",43,"ق",2,0],["ومن اختلال دوحٍ خلته ارتوى","لم تدر منه ما عليه قد انطوى",44,"ط",3,0],["ومناخ للركب غير حرام","لحرام الميمين استحلا",45,"ل",2,0],["ومن اخواننا العز ابي ايضا","نقيض العهد للعزلا ألوفي",46,"ف",2,0],["ومِن أَخٍ إِن خِفتَ أَو مِن أَبٍ","فَأَنتَ في الأَعداءِ مُستَأمَنُ",47,"ن",1,0],["ومن آخر أيام الغلا شفت ريبه","وإلاّ فلا صدّقت هذا ولا ذاك",48,"ك",1,0],["وَمَن آخى الذِّئابَ قَضتْ عَليهِ","وَذاكَ جَزاءُ مَا اجْتَرحَتْ يداهُ",49,"ا",2,0],["ومن أخذَ الفصاحةَ عن بيانٍ","فلا والله لم يُعجزْهُ نطقُ",50,"ق",1,0],["ومناخره متباعدات ووسيعات","وامدوّرات وللنفَس سهّّل ٍ له",51,"ل",2,0],["و(مَنَاخَةٌ) صَارَتْ مَنَاحَةَ ثَاكِلٍ","قَد زُلزِلتْ مِن (كاهلٍ) ل(مَسَارِ)",52,"ر",1,0],["ومناخاً رحباً وظلاً ظليلاً","ونباتاً رطباً وماء رويا",53,"ي",2,0],["وَمِنْ آخِرِ الأحْزانِ شَيءٌ يُظِلُّهُ","وَحينَ أَطالَ الشَّيْءُ ظِلاًّ أَمالَهُ",54,"ل",2,0],["وَ مَنِ اختارَ أَنْ يَتُوبَ ؛ هَنِيئًا","حَفَّهُ البِشرُ مِنْ جَمِيعِ الزَّوايا",55,"ا",3,0]]}