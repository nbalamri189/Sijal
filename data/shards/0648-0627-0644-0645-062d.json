sgate.com/ViewPoem.aspx?id=32225",""],[5431,"بصبر الصالحين شفاء جرحي","https://www.poetsgate.com/ViewPoem.aspx?id=187206",""],[709,"غَرَبَتْ مِنكمُ شُمُوسُ التَّلاَقِي","https://www.poetsgate.com/ViewPoem.aspx?id=2876",""],[5459,"يا فؤاد ذب ألما","https://www.poetsgate.com/ViewPoem.aspx?id=190946",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5582,"عَرِّجْ فَهَذِي ( رُسُومُ ) الأَثْلِ وَالبانِ","https://www.poetsgate.com/ViewPoem.aspx?id=187310",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5628,"وداعاً أيتها البسمة","https://www.poetsgate.com/ViewPoem.aspx?id=178491",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5696,"بين الرياء والحياء","https://www.poetsgate.com/ViewPoem.aspx?id=151407",""],[3216,"المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=28890",""],[5843,"موت طازج","https://www.poetsgate.com/ViewPoem.aspx?id=51285",""],[5937,"كوجه الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=211824",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6102,"اغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=182847",""],[6115,"الحق مايزعل يكون الهلامه","https://www.poetsgate.com/ViewPoem.aspx?id=180472",""],[6124,"المحاريث","https://www.poetsgate.com/ViewPoem.aspx?id=159856",""],[6144,"نسوان","https://www.poetsgate.com/ViewPoem.aspx?id=13697",""],[6199,"حديث الرجل الأول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79698&r=&rc=19",""],[6225,"انغلاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81727&r=&rc=438",""]],"verses":[["وَالمُحِبُّ في كَمَدٍ","وَالعَذولُ في جَذَلِ",0,"ل",1,0],["وَالمُحسِنونَ لَهُم عَلى إِحسانِهِم","يَومَ الإِثابَةِ عَشرَةُ الأَمثالِ",1,"ل",1,0],["وَالمَحاذيرُ سِهامٌ","وَالمَقاديرُ قِياسُ",2,"س",1,0],["وَأَلمَحنَ لَمحاً مِن خُدودٍ أَسيلَةٍ","رِواءٍ خَلا ما أَن تَشِفَّ المَعاطِسُ",3,"س",1,0],["والمحاسن لو رفيعت","والشموس لحسن تخضع",4,"ع",1,0],["والمُحرِزو السَّبقَ في مَوَاطِنَ لا نَج","عَلُ غاياتِ أهلِها القَصَبُ",5,"ب",1,0],["والمُحِلُّو محارمَ اللّه أولى","أن يُرى السيف من طُلاهُمْ خضيبا",6,"ب",2,0],["والمحلّ الذي تبدّلَ عِيناً","بعد عِينٍ من الأنيسِ الخوالي",7,"ل",2,0],["والمَحلُّ الخلاءُ من كُلِّ ضَيْفٍ","ومَضيفٍ مُعَطَّلٌ مسكونُهْ",8,"ن",2,0],["وَأَلمَحُ واحاتٍ مِنَ النَخلِ في النَوى","إِذا جَرَفَ الإِعصارُ مِن واحَتي النَخلا",9,"ل",2,0],["وألمح فيها عراكَ الرجال","إذا لاحَقَ الزورقُ الزورقَا",10,"ق",2,0],["وألمح في نواظرك","صفاء الرحمة الكبرى",11,"ر",2,0],["وَاِلمَح صَحيفَةَ صَفحَتي فَاِقرَأ بِها","سَطرَينِ مِن دَمعٍ بِها مُتَحَدِّرِ",12,"ر",1,0],["وَأَلمَحُ أَعقابَ الأُمورِ فَأَرعَوي","وَيُعمى عَلَيَّ الأَمرُ طَوراً فَأَفحَصُ",13,"ص",1,0],["والمَحْلُ إذْ عَمَّ البِلادَ بَلاؤُهُ","والريحُ يُشْمِلُ بالسَّمُومِ ويجنِبُ",14,"ب",1,0],["وألمح في جانب المُصطلى","وجوهاً زواها الأسى والخشوعْ",15,"ع",1,0],["والْمَحْ بِطَرْفِكَ ما وَحَتْهُ يَدُ الصَّبا","فَوْقَ الْغَدِيرِ تَجِدْ حُروفَ هِجاءِ",16,"ا",2,0],["وَالمُحِبُّ الأَبَرُّ مَنْ قَادَهُ وَحْ","يُ هَوَاهُ وَلَمْ يَقُدْهُ الزِّمَامُ",17,"م",1,0],["وَأَلْمَحُ النَّارَ في الظَّلْمَاءِ قَدْ نُصِبَتْ","لِطَارِقِ اللَّيْلِ وَالْحَيْرَانِ والسَّغبِ",18,"ب",1,0],["وَالمُحْدَثَاتُ تَسُدُّ الشَّمْسَ كَثْرَتُهَا","وَلَمْ تَفُزْ بِخَيَالِ اسْمٍ وَلاَ لَقَبِ",18,"ب",1,0],["والمحبّات والتلاقي رماد","والأغاني برد القبور القدامى",19,"م",2,0],["وألمحُ في هذي الوجوهِ كوالِحاً","من اللؤم أشباحَ الوحوش الكواسر",20,"ر",1,0],["والمحل الذرب....؟ والسبك الرهاوي","منخلق.., للعبقريات العضيمه",21,"م",2,0],["وألمح واحات من النخل في النوى","اذا حرف الإعصار من واحتي النخلا",22,"ل",2,0],["والمحبّون بسمة عند ثغر","يتملّى ومعصم عند جيد",23,"د",1,0],["وألمح في الذكرى جنونا وسورة","من الحبّ في تلك الجفون النواعس",24,"س",1,0],["والمحكمات عراها حين يعلكها","فك شديد القُوى ما خانه دَرَدُ",25,"د",1,0],["والمَحَلَّ الأجَلَّ والعروة الوُث","قَى ومأوى الأرامِل المُستَطابَا",26,"ب",2,0],["والمح بقبلي المدينة منظراً","أضحى لمشتبك النجوم عديلا",27,"ل",2,0],["والمحك مهواه فدعه لمن","يرى القضا للسيف والمحكمه",28,"م",2,0],["والمحقّون خاملون حيارى","ولأهل الفسوق بات مروق",29,"ق",1,0],["وَالمُحامونَ حينَ يَحتَضِرُ الناسُ","وَبِالأَكرَمينَ يُحمى الذِمارُ",30,"ر",1,0],["والمحكمُ العدلَ كما شاءهُ","من باتَ يخشى بطشةَ القاهرِ",31,"ر",1,0],["والمحرز القصبات في سبق العلا","لو نيط شأو المجد بالزرقاء",32,"ا",2,0],["وألمح أحلامي إليك طوائراً","فأفترع المكنون من حجب الغيب",33,"ب",1,0],["وَالْمَحْ مَحَاسِنَ تَسْتَطِيرُ سَنىً","وَشِمْ شَمَائِلَ لَسْتَ تَعْهَدُهَا",34,"د",3,0],["والمحو ثمّ الفنا قل علّتان هما","من يتّصف بهما ذا غيرُ منصرف",35,"ف",1,0],["والمحال المحال أن تصحب الده","ر بعقل وطيب عيش رخي",36,"ي",1,0],["والمحال المحال أن يملك الضرغام","كلب ويهلك التنينا",37,"ن",2,0],["وأَلمحُهُ بومضِ البر","قِ إِمّا عَسْعَسَ الغَلَسُ",38,"س",1,0],["والمحيَّا الذي له تشخص الأب","صارُ حُسنا وبهجةً وضِياءَ",39,"ا",2,0],["والمحبين للَه","جل الولي الحميد",40,"د",1,0],["وَالمُحَيّا وَلا مِثالَ كَفَخٍّ","طُرَّةَ الشِعرِ أَتقَنَت أَحكامَه",41,"م",2,0],["وَالمحيّا رَوضة أنُفٌ","زانَها الرَيحان وَالزهرُ",42,"ر",1,0],["والمحاسن كلها","ثم ينهى عن اقتحام",43,"م",1,0],["والمحن والفقر والحال الضرير","والألم فورا وفي اليوم الأخير",44,"ر",1,0],["والمحرمين نصَلوا","من دَنَسٍ ووصْمِ",45,"م",1,0],["والمُحيّا وجهُهُ إن لُعنتْ","أوجهٌ لم تتلثَّمْ بالخَجلْ",46,"ل",1,0],["والمحاجر استعرت","والقلوب تلتهب",47,"ب",1,0],["والمُحوضِ البَحْتِ الغَموضِ المَعاني","تَحتَ سِرْبالِ طَوْرِهِ النَّوْعِيِّ",48,"ي",1,0],["والمُحَيِّي بأَلطفِ البِشْرِ حَيَّى","والمُغَنِّي بنغمَةِ البِرِّ غَنَّى",49,"ن",2,0],["والمُحلّي قِراهُ في عَنبر اللّيْ","لِ وبالزّعْفَرانِ مُحذي المَناقِ",50,"ق",1,0],["والمُحرجين فضاءَ مَن ناواهُمُ","والمرحبين على الوليّ مضيقا",51,"ق",2,0],["والمحلَّ الّذي به نَظَمَ الل","هُ من الملك كلَّ شملٍ بَديدِ",52,"د",1,0],["والمُحسنُ الصُّنعَ في سِرٍّ وفي عَلَنٍ","للخيرِ مُلتزِماً للشَّرِ ترَّاكا",53,"ك",2,0],["والمحتد المحتدّ خير محتدى","لم ترم ثرثار النفوس الحسد",54,"د",1,0],["والمَحْ صحائفَ ذا الوجودِ بعيْنِ مَنْ","جَمعَ التفرُّقَ تَستَبِنْ مَكتوبَها",55,"ب",3,0],["والمحصنات وقد جعلن من القنا","خدراً وأستاراً من الرايات",56,"ت",1,0],["والمحَمّدُ المرجى مثل ما","يرتجى غيثُ لإِحياءِ الشجرْ",57,"ر",1,0],["والمحيَّا والفرع أصلٌ ومنه","نشأ الصبح مُسْفِراً والظلامُ",58,"م",1,0],["وَآل محرز أرباب العلا وبنو","هناة هم خير أنصارٍ وأعوانِ",59,"ن",1,0],["والمحق حلَّ بكلما أعددتهُ","ومحاه حتى لم يعد منه الأثرْ",60,"ر",1,0],["والمحل أيام الشتاء إذا غدت","كوم الجلاد تضن بالألبان",61,"ن",1,0],["والمحب الذي عهدتم جزوعاً","خيم الصبر عنده وأقاما",62,"م",2,0],["والمحتد العالى تحدَّرَ دمعه","أضناه فقدُ الفيصل المسنونِ",63,"ن",1,0],["والمحامينَ على أحسابهم","جُهدَ ما تحمي المغاويرُ الحِجالا",64,"ل",2,0],["وَالمحرم العلوي وَالقدس الَّذي","حجت إِلَيهِ صوامتي وَنواطقي",65,"ق",2,0],["والمحلَّى من الكمال بتاجٍ","ساد كسرى به وفاخر دارا",66,"ر",2,0],["وآل محسنون خيار قوم","لهم فخر وجاه ذو مكان",67,"ن",1,0],["والمحب الداعي لمجدك في","بيت بمعروفكم رفيع العماد",68,"د",1,0],["والمحبّه ما تجوز بلا قهر","تمشي الضّيجات فيها والسرور",69,"ر",1,0],["والمحصناتُ المؤمنات أعفة","لا ترمهنّ فإنهنّ غوافل",70,"ل",1,0],["وَالمحرز السَبق لَم يُدرَك لَهُ أَمَدٌ","وَعادَ عَنهُ المَجاري يَشَتكي الظَلَعا",71,"ع",2,0],["والمحسن الحر الامين ومن له","في كل مكرمة يد بيضاء",72,"ا",2,0],["والمُحنِثُ المشهورُ والمربَّع","نفيسُ عَن ثمانِيَه عِ وَاسمَع",73,"ع",1,0],["والمُحنِثُ الداني لِنَحوِ القُطبِ","مُؤرَّخُ عِندَ المَلاَ في الكُتبِ",74,"ب",1,0],["والمُحنتُ المذكورُ والسهيلُ","خَمسٌ مَحَكَّم ليس فِيهِ مَيلُ",75,"ل",1,0],["والمحامي عنه ببدر واحد","وحنين إذ فرّت الأصحاب",76,"ب",1,0],["والمحدثون لهم فضائل جمة","ومحاسن معروفة لم تجهل",77,"ل",1,0],["والمحلفان اسمعهما عند العرب","والمخنثان لهما ايضا لقب",78,"ب",1,0],["والمحل يطرده الحيا","والعتب يمحوه الرضى",79,"ا",1,0],["والمَحْلُ قد جَلَّلَ آفاقَها","فأهلُها في شُغُلٍ شَاغِلِ",80,"ل",1,0],["وألمح من بشراك طالع مولد","تلاقيه أبراج السعود حوانيا",81,"ي",2,0],["والمحبون خلفكم في أمانٍ","حين قول الجحيم هل من زياده",82,"د",2,0],["والمحجمين عن السمو إلى العى","سيرون من آمالهم إحجامها",83,"م",3,0],["والمحل أدبر والدنيا لها ابتسمت","إذ سعدها بحبيب الله مكفول",84,"ل",1,0],["والمحامين على احسابهم","تخذوا المجد شعارا ودثارا",85,"ر",2,0],["والمح أعقاب الأمور بفطنة","تلوح لها قبل الورود المصادر",86,"ر",1,0],["والمحبّ حالتُه","حالُ الجانين",87,"ن",1,0],["وألمح في يماني الجهات أو مشايم","وإن حدا حادي أو غنين ورقا الحمائم",88,"م",1,0],["والمحرز القصبات سبقا والمع","د لهول يوم كريهة وسداد",89,"د",1,0],["والمحلُ زالَ كبارقٍ مُتهلّلٍ","لمَّ الشُّعوبَ بوَمْضه لمّاحُهُ",90,"ح",2,0],["وَأَلمَح فَجراً مِن الذِكريات","يُبدد مِن جانبيه الظُلم",91,"م",1,0],["وَالمُحرِمينَ لِصَوتِهِم زَجَلٌ","بِفِناءِ كَعبَتِهِ إِذا هَتَفوا",92,"ف",3,0],["وألمح من سنا الدينار برقاً","غمامته على غيري تجود",93,"د",1,0],["وَالمَحيهِ لَمحَ بَرقٍ خُلَّبٍ","يُطمِعُ الصادي وَإِن لَم يُسبِلِ",94,"ل",1,0],["والمحلى جيد الفصاحة بالفك","ر عقوداً من لؤلؤ وجمان",95,"ن",1,0],["والمحبه مدرسة شي ثبوت وشي فرار","وأنت درسي مع أهل الحب الأول والأخير",96,"ر",1,0],["والمحب اذنيه ماهيب تسمع للعيوب","والعدو لا درهمت به تجي متحدّره",97,"ر",2,0],["والمُحيَّا الطليقُ مني عَبوساً","قد بدا بعدما علاه الشحوب",98,"ب",1,0],["والمحبه ماتبي شرح ودليل","انصت لصوت الغلا ثم اتبعه",99,"ع",2,0],["وألمحه .. فأسأله","أنوح ذاك أم سجعُ",100,"ع",1,0],["وَأَلْمَحُ في فُؤادي شَهْرَزاداً","أَزيلُ بِها مِنَ الدُّنْيا غُروري",101,"ر",2,0],["والمحصنات غوافلا لا يهتدي","شين لمنصبها ولا يتطرق",102,"ق",1,0],["وألمحُ في فؤادكِ ألفَ آهٍ","فكيفَ الهَجرُ كيفَ سترحلينا!",103,"ن",2,0],["والمح فضائله واذكر مناقبه","من ذا يماثله في الغار والحرم",104,"م",1,0],["والمحاذير والمخاوف تغتال","الضحايا المفجوعة المفؤوده",105,"د",2,0],["وألمح طيفَكِ وسْط انفعالي","فيعشق شريانُ قلبي وريدَهْ",106,"د",2,0],["وألمح في المرايا وجه ربي","ودمع الأنبياء بها يسيلُ",107,"ل",1,0],["والمحلّي قراهُ في عنبرِ الي","-لِ وبالزَّعفرانِ محذي المناقِ",108,"ق",1,0],["والمحارمُ انْتُِهكَتْ","والجميعُ في صَمَمِ",109,"م",1,0],["والمحل قام يرفل بالنفل والخزام","وحالي الدر باكر مانقله الصميل",110,"ل",1,0],["وَآلُ مَحْرَزَ أَرْبابُ العُلا وَبَنُو","بَطَّاشَ أَهْلُ النُّهَى وَالأَمْرِ وَالشَّانِ",111,"ن",1,0],["وألمحُ ذاكَ الثغرَ يلمعُ برقُه","متى حُطَّ عن درِّ الثنايا لِثامُهُ",112,"م",2,0],["والمحطّاتُ التي غصّت بنا","حمّلتْ أوجهنا ألف طلاءْ",113,"ا",2,0],["والمَحَاريبُ الَّتِي تَرنُو إلى الْ","بيت رنْوَ المُسْتَغيثِ المُفْزَعِ",114,"ع",1,0],["والمحيّا ريّان طلق وطفل ال","حب في الناظر الضحوك غريق",115,"ق",1,0],["والمح اذارى عينيك نفسى","احدق فيهما صاح فارقى",116,"ق",2,0],["والمحبس اللي برق ف اصبعك مذهول","يخيله ويغبطه فالساق خلخال",117,"ل",1,0],["وألمحُ عينَكِ في كل ضوء","وأسمع صوتك في كل نبْرَةْ",118,"ر",2,0],["والمحبة بقلبي ، كل يوم ٍ تزود","بّينه ، في عيوني ، مهما ، أخفيتها",119,"ت",3,0],["وَ المُحِيطاتُ - بَينَ كَفَّيَّ - أَحلَى","مِنْ رَحِيقِ الزِّهُورِ - بَاتَتْ - وَ أَعذَبْ",120,"ب",1,0],["والمحترم يفرظ عليك احترامه","ولا الردي قدره بوسط الحدايق",121,"ق",1,0],["والمحاريثُ التي باءتْ بذنبي","ردَّها العشقُ إلى داري غناءا",122,"ا",2,0],["والمحتاره بالشنطه والشمسيه","والنضاره رايحه على التمثيل",123,"ل",1,0],["وألمح ثغرك الحاني الجميل","إذا أغمضت عيني.استعيد",124,"د",1,0],["والمُحِبُّون أفاقوا","حين عهدُ الحُبِّ ناما",125,"م",2,0]]}