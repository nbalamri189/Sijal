oetsgate.com/ViewPoem.aspx?id=179448",""],[77,"حكم الجفون على فؤادي ماض","https://www.poetsgate.com/ViewPoem.aspx?id=34171",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[45,"سَرَى الغَمَامُ ، وَغَادَتْنَا غَوَادِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31677",""],[45,"قِصّةُ التّلّ، فاسمَعوها عُجَابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31562",""]],"verses":[["حَكَت لِحاظُكِ ما في الريمِ مِن مُلَحٍ","يَومَ اللِقاءِ فَكانَ الفَضلُ لِلحاكي",0,"ك",2,0],["حَكَمَ الدَهرُ أَنَّ صاحِبَ ذا العَي","شِ قَتيلُ المُنى بِغَيرِ مُرادِ",1,"د",1,0],["حُكمُكَ بِالسَيفِ غَيرُ مُنهَجِمٍ","وَأَنتَ بِالضَربِ غَيرُ مُتَّئِدِ",2,"د",1,0],["حَكَمَ البِلى فيهِ فَلَو يَلقى بِهِ","أَعداؤُهُ لَرَثى لَهُ أَعداؤُهُ",3,"ا",3,0],["حَكَتِ الغَزالَةَ وَالغَزالَ بِبُعْدِها","وَبِصَدِّها وَبِوَجْهها وَبِجيدِها",4,"د",3,0],["حكامنا إن تصدوا للحمى اقتحموا","وإن تصدى له المستعمر انسحبوا",5,"ب",3,0],["حَكِّم سُيوفَكَ في رِقابِ العُذَّلِ","وَإِذا نَزَلتَ بِدارِ ذُلٍّ فَاِرحَلِ",6,"ل",1,1],["حَكَميُّ البيْتِ في مَكْمَنِه","نامَ ذو الحِكمَةِ فنّاً واضْطَجَعْ",7,"ع",1,0],["حُكْمُ الْجُفُونِ عَلَى فُؤَادِي مَاضِي","كَيْفَ التَّخَلُّصُ وَالْخَصيمُ الْقَاضِي",8,"ي",1,1],["حكَمَ اللهُ أنّهُ يابِسُ السّا","قِ كَذا الحُكْمُ ليسَ فيهِ اخْتِيارُ",9,"ر",1,0],["حَكى فَرَسَ الشّطْرَنْجِ طِرْفُكَ لا يُرى","يُنَقَّلُ منْ بَيْضاءَ إلا الى حَمْرا",10,"ر",2,0],["حَكَّمتُموني فَقَضى بَينَكُم","أَبلَجُ مِثلُ القَمَرِ الباهِرِ",11,"ر",1,0],["حَكَمتَ فَما حَكَّمتَ في قَصدِكَ الهَوى","طَريقُكَ في الإِنصافِ وَالعَدلِ مَهيَعُ",12,"ع",1,0],["حِكمَةٌ بالِغَةٌ قَد مَثَّلَت","قُدرَةَ اللَهِ لِقَومٍ عاقِلين",13,"ن",1,0],["حكوا لنا عن حمارٍ","من الحمير الغوالي",14,"ي",1,1],["حُكَمَاءُ إِنْ عَرَضَتْ لأُمَّتِهِمْ","حَاجٌ فَهُمْ لأَدَقِّهَا فُطُنُ",15,"ن",1,0],["حكت شبهاً للنحل والنحلُ حولَه","عصيٌّ إلى مثواه تهوي عواليا",16,"ي",2,0],["حكّم العقل واجتهد","وتعالى عن الفند",17,"د",1,0],["حكت لهجة التمام لفظاً ولم تكن","لتفصح إلا بالزمان لغاها",18,"ا",3,0],["حكمت مُشدِّدة علينا حكمها","أما على الدخلاء فهي تخفِّف",19,"ف",1,0],["حكت سرحة فنواء نُبصر فرعها","ولم ندرِ منها ما الأنابيش والجذر",20,"ر",1,0],["حُكّامُ فَصلٍ وَتَلقى في مَجالِسِنا","أَحلامَ عادٍ إِذا ما أُهذِرَ القيلُ",21,"ل",1,0],["حَكَمتَ بِحُكمِ أُمِّكَ حَيثُ تَلقى","خَليطاً مِن صَقالِبَةٍ وَرومِ",22,"م",1,0],["حكمت بعدلٍ لم تدعْ فيه ظالماً","وصلت بعلمٍ لم تدعْ فيه ملحدا",23,"د",2,0],["حكاه في قطعه حد الحسام وما","حكاه في مقبل الأرزاق متصل",24,"ل",1,0],["حكاك اسماً ومعنًى وانتساباً","وعلامي أوفى من علامي",25,"ي",1,0],["حكى الخلق من قاضي القضاة بخلقِه","فهذا حوى حسناً وهذا حوى حسنى",26,"ن",2,0],["حكى السبع الشداد علاً وحاكت","عليه مدائحي السبع الطّوالا",27,"ل",2,0],["حكت نورها في بَرْدها وسَلامها","وباتت بطيبٍ لا يوازَى ولا يُحْكى",28,"ا",1,0],["حَكم الإمامُ عليه حكماً فيصلاً","مرَّ السِّراط فليس فيهِ عداءُ",29,"ا",2,0],["حَكَم الإمامُ عليه بالحكم الذي","قَسَم السَّواء فليس فيه خَطاءُ",29,"ا",2,0],["حُكمٌ أحدُّ أحصُّ أبلجُ واضحٌ","لا أولياءَ له ولا أعداءُ",29,"ا",2,0],["حكمةٌ ما ورثتُها عن حكيمٍ","فيلسوفٍ من عِتْرة الأنبياءِ",30,"ا",2,0],["حَكم اللَّهُ بالعلا لعَليٍّ","وبحق النجيب وابن النجيبِ",31,"ب",1,0],["حكيمٌ لا مَعاقدُهُ ضِعافٌ","تُذَمُّ ولا معاهدُهُ رِثاثُ",32,"ث",1,0],["حَكِيمُ أقاليمِ البلادِ كَريمُها","مُسِائلُهُ يُهْدَى وعَافِيهِ يُرْفَدُ",33,"د",1,0],["حكْمها في العقول تذكية الأق","وى ورمي الضعيف بالتَهويس",34,"س",1,0],["حكيمه المقتدى بحكمته","طبيبه المرتَجى لأمراضه",35,"ض",2,0],["حكيمٌ عليمٌ يغمرُ الناسَ حِلمُهُ","إذا فَرَطتْ من جهل قوم فوارطُ",36,"ط",1,0],["حكى يومُنا هذا نداكَ وحُسنَه","إذا ما غدا يحمي نثاك مُحافظا",37,"ظ",2,0],["حكَّمتها في من لو انتظمت","تاجاً لقل لمثله خِلعه",38,"ع",2,0],["حُكِّمن فينا فما عدلن وإن","عدلن بين الجفاء والقضَف",39,"ف",1,0],["حُكماءُ هذا الناسِ رُوقَتُهم","أتعيبُ أصلي ويكَ أم فَصْلي",40,"ل",2,0],["حكمةٌ منك ربما جُعل السي","فُ لساناً لها غداة الجدالِ",41,"ل",1,0],["حكَّمتُ فيه قاسماً نعم الحَكمْ","بَخْبِخ لشمس الأوْج لا نارِ الظُّلمْ",42,"م",1,0],["حكَمَ الإلهُ بأنْ تَسُو","دَ وأن تَرَى زلَلاً فَتَحْلُمْ",43,"م",1,0],["حُكماً بأن النفسَ تبغي شكلَها","والشكلُ إلفٌ لا يُحِبُّ سِواها",44,"ا",3,0],["حَكَمَ القَضاءُ فَإِن نَقِمتَ عَلى القَضا","فَاِضرِب بِعُنقِكَ مُديَةَ الجَرّاحِ",45,"ح",1,0],["حَكَمَ القَضاءُ فَإِن نَقَمتَ عَلى القَضا","فَاِضرِب بِعُنقِكَ مُديَةَ الذَبّاحِ",46,"ح",1,0],["حَكَمَ العاتي عَلَيهِ بِالفَناء","وَأَبى المَقدورُ إِلّا أَن يُضام",47,"م",1,0],["حَكَيتَ البَدرَ في عُمرٍ وَلَكِن","ذَكاأُكَ لا تُكَوِّنُهُ قُرونُ",48,"ن",1,0],["حِكايَةٌ أَتَقَلّى حينَ أَسمَعُها","وَيَأكُلُ الحُزنُ قَلبي حينَ أَرويها",49,"ي",3,0],["حَكَمَ اللَهُ بِهَذا","إِنَّ حُكمَ اللَهِ عَدلُ",50,"ل",1,0],["حَكَت فَصلَ الرَبيعِ بِحُسنِ قَدٍّ","تَساوى اللَيلُ فيهِ وَالنَهارُ",51,"ر",1,0],["حَكَّمَهُ في مُهجَتي حُسنُهُ","فَظَلّ لا يَعدِلُ في حُكمِهِ",52,"ه",1,1],["حكيم يرى للقول وقتا وموقعا","ليأتي ما قد قاله بالفوائد",53,"د",1,0],["حكم الذي اراد صوابا","ونسيب لمن اراد النسيبا",54,"ب",2,0],["حكم تهدم التقاليد قد كا","نت تراعى من اهلها للجمود",55,"د",1,0],["حكاها كأن الله صاغها معاً","شبيهين في ثوب من الحسن هلهال",56,"ل",1,0],["حكت الحوادث مثلما","وقعت ولم تترك صغيره",57,"ر",2,0],["حكين بترداد النواح حمائما","لهن بريعان الصباح هديل",58,"ل",1,0],["حكيم الذكر بين الكت","ب مظهره وميسمه",59,"م",2,0],["حكم أذاقك مرّه","عدلا وعلقمه سقاك",60,"ك",1,0],["حكموا فيه وفي خيراته","وغدوا أهلا وأمسى اجنبا",61,"ب",2,0],["حكومة ذلة وسراة جهل","كعهدك إذ تحييك الطوابي",62,"ب",2,0],["حكم الله في أبيك وحكم ال","لّه في الخلق سابق مقضى",63,"ا",1,0],["حِكايَةٌ تَشتَهيها","مَسامِعُ الأَذكِياءِ",64,"ا",2,0],["حِكايَةُ الكَلبِ مَعَ الحَمامَه","تَشهَدُ لِلجِنسَينِ بِالكَرامَه",65,"ه",1,1],["حَكَيتَ الحَياةَ وَحالاتِها","فَهَلّا تَخَطَّيتَ ما تَنقُلُ",66,"ل",1,0],["حَكيمٌ صامِتٌ فَضَحَ اللَيالي","وَمَزَّقَ عَن خَنا الدُنيا القِناعا",67,"ع",2,0],["حَكَمَت فيهِ اللَيالي وَحَكَم","في عَواديها قِياداً بِقِياد",68,"د",1,0],["حَكَمَت في القُرونِ خوفو وَدارا","وَعَفَت وائِلاً وَأَلوَت بِعَبسِ",69,"س",1,0],["حِكمَةٌ حالَ كُلُّ هَذا التَجَلّي","دونَها أَن تَنالَها الأَفهامُ",70,"م",1,0],["حَكَمَت دَولَةُ الجَراكِسِ عَنهُمُ","وَهيَ في الدَهرِ دَولَةٌ عَسراءُ",