{"poems":[[73,"لطيفكم عندي يد لا أضيعها","https://www.aldiwan.net/poem4003.html","الطويل"],[49,"ندبت لحسن الصبر قلب نجيب","https://www.aldiwan.net/poem25369.html","الطويل"],[46,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[107,"إليها بالأماني الكبار","https://www.aldiwan.net/poem43405.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[92,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[154,"الطعن والضرب منسوبان للعرب","https://www.aldiwan.net/poem68456.html","البسيط"],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[398,"وتيهاء لم تطمث بخف وحافر","https://www.aldiwan.net/poem53549.html","الطويل"],[408,"إليك ضياء الدين واصل سيره","https://www.aldiwan.net/poem46529.html","الطويل"],[463,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[463,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[556,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122746","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119945","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49914","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202206","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/157822",""],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105075","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100306","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99493","المتقارب"],[3289,"","https://poetry.dctabudhabi.ae/diwan/poem/31457","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62945","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118763","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206167","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85238","الطويل"],[4912,"فأشعاره مشهورة ومشاعره","https://www.poetsgate.com/ViewPoem.aspx?id=181783",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5145,"ريح الصبا هل لك أن تسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=108224",""],[5183,"إلى رجال الإستقامة","https://www.poetsgate.com/ViewPoem.aspx?id=180170",""],[5186,"إاذا كانت الآمال بالوصل أوهاما","https://www.poetsgate.com/ViewPoem.aspx?id=156475",""],[5397,"تطارحني الحمائم بالنواح","https://www.poetsgate.com/ViewPoem.aspx?id=157915",""],[327,"ألا هاج قلبي العام ظعنٌ بواكر","https://www.poetsgate.com/ViewPoem.aspx?id=3814",""]],"verses":[["تَجَشَّمَ أَهوالَ السُرى لا يَصدُهُ","مَهيبٌ وَلا يَرتاعُ مِن موحِشٍ قفرِ",0,"ر",1,0],["تَجَشَّمتُ خَوفَ العارِ أَعظَمَ خُطَّةٍ","وَأَمَّلتُ نَصراً كانَ غَيرَ قَريبِ",1,"ب",1,0],["تَجَشَّمَ حَملَ الفادِحاتِ وَقَلَّما","أُقيمَت صُدورُ المَجدِ إِلّا تَجَشُّما",2,"م",2,0],["تُجَشِّمُهُ المَناقِبُ يَبتَنيها","مُنيفاتِ الذُرى فَوقَ الدَراري",3,"ر",2,0],["تَجَشَّمْتَ مَا تَنْبُو بِأَيْسَرِهِ القَوَى","وَلَمْ يَكُ مَا تَبْغِيهِ بِالمَطْلَبِ السَّهْل",4,"ل",1,0],["تجشمني والصبر بيني وبينها","أفاعيلها فيمن عدته المآتم",5,"م",1,0],["تجشَّمْتَ المهالكَ في عَسوفٍ","تجشَّمَهُ سواك فما استَقادا",6,"د",2,0],["تجشمت جشمٌ نصر المعد لها","أسنى الجوائز من مال ومن نشب",7,"ب",1,0],["تجشم هول البيد واعتسف الفلا","على اعوجى من أولي السبق اجردا",8,"د",2,0],["تَجَشَّمتُها حَتّى أَجوبَ سَرابَها","وَإِن حَمِيَت بَعدَ المَقِيلِ الهَواجِرُ",9,"ر",1,0],["تجَشَّمتُها وَاللَيلُ وَحفٌ جناحُهُ","كَأَنِّيَ سِر وَالظَلام ضَميرُ",10,"ر",1,0],["تجشَم أثقالَ السُّرى يرتجي الغِنى","ولكنّه عند الضّياء يحمد المسرَى",11,"ر",2,0],["تجشّمَ يركبُ الأسلا","تِ من كعبٍ ومن جُشَمِ",12,"م",1,0],["تَجَشُّمُهُ رحضُ ما دنَّسوا","وإحسانُه جمعُ ما فرَّقوا",13,"ق",3,0],["تَجشّم خير الناس طُرّاً عيادَتي","فَجاءَ بِما حسبي به شرفاً حسبي",14,"ب",2,0],["تجشّمها غباً يَبُلُّ بِوِردِها","بِخامِسَةٍ يا بُعدَ ما يَتَجَشَّمُ",15,"م",1,0],["تجشّموا في البلاد الظلم وانطلقوا","بعد المظالم أحراراً مغالينا",16,"ن",2,0],["تجشا حرقا زرقا","وتحشى خرقا زرقا",17,"ق",2,0],["تُجشّمِني المكروهَ فيما تَلذّهُ","وتُلزمني ذنبَ الهوى ولك الذنبُ",18,"ب",1,0],["تَجشّمَتْها بالضُّمَّر القُودِ تنْبَري","رواسمَ تطْوي كلَّ امْسَ افْيَحَا",19,"ح",2,0],["تجشمت من كرمان كل تنوفة","وجاوزت حد القصر من أرض فارس",20,"س",1,0],["تجشم كل شاسعه","فحل حمى بني جشم",21,"م",1,0],["تجشم وخدانا حيازيم قفرة","يقوم بها سهل ويجثو بها سهب",22,"ب",1,0],["تجشم فينا بطن كل مفازة","وتقطع فينا ظهر أقتم غابرِ",23,"ر",1,0],["تجشأت في وجه بوابه","ليعرف شبعي فلا أمنعُ",24,"ع",1,1],["تجشَّم نَحوي وَفْدُ قُرحانَ شُقَّةً","تَظَلُّ بها الوَجناءُ وهي حَسِيرُ",25,"ر",1,1],["تَجَش هلاك نارها بأَلالَةٍ","ونارُ الوَغى بالمشرفيةِ تَقدَحُ",26,"ح",1,0],["تجشَّمَ هولَ البيد يقطعها وخدا","ولمَّا يجد من خوض دامائها بُدَّا",27,"د",2,1],["تجشَّم فيك القلب ما ليس يعذب","أما آن لي منك النجاء المحبب",28,"ب",1,1],["تجشمت الأخطار شوقاً ولم تهب","وطيس هجير أو وغى ذي توقد",29,"د",1,0],["تجشم غشياني فشرد وحشتي","وبشر ممشاه ببشر أباشر",30,"ر",1,0],["تَجَشَّمَ فِيْ مَحَجَّتِهِ غَيَاْبَاً","لِيَرْفَعَ خَيْرَهُ يَنْطَاْدُ فِيْنَاْ",31,"ن",2,0],["تجشّمي ذلك ثم احملي","بعض تحياتي إلي سيدي",32,"د",2,0],["تجشمت أمراً طالما رمت نشره","فأعيا وكم ألّفته فتنفرا",33,"ر",2,0],["تجشمنا الدنيا عوامل غدرها","فترفع أقواما وتخفض أقواما",34,"م",2,0],["تجشمها الحداة السير ليلا","فتجهش بالعويل وبالصياح",35,"ح",1,0],["تجشّمتُها حتى أَجوبَ سَرابَها","ومن يعْملِ الخيراتِ أو يُخطِ خالياً",36,"ي",2,0]]}