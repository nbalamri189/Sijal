id=136692",""],[5061,"ياذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147154",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5277,"أطيافُ ربيعيةِ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206790",""],[5358,"كم حلوةٍ تلهو","https://www.poetsgate.com/ViewPoem.aspx?id=187054",""],[5370,"عواذل","https://www.poetsgate.com/ViewPoem.aspx?id=81640",""],[5463,"يمر العيد","https://www.poetsgate.com/ViewPoem.aspx?id=25289",""],[5582,"زُرْ مَنْزِلاً قاضَكَ البُرْحا وَأَوْلاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=63548",""],[5582,"قِفْ بِالدِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5582,"قِفا وَاسْأَلا عَنْ دارِ سُعْدَى وَعَنْ سُعْدَى","https://www.poetsgate.com/ViewPoem.aspx?id=63483",""],[5736,"شهداء الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=204465",""],[5775,"أنا يا بدر","https://www.poetsgate.com/ViewPoem.aspx?id=35139",""],[402,"يا حسنها حين تجلت على","https://www.poetsgate.com/ViewPoem.aspx?id=36426",""],[5809,"ابتهال","https://www.poetsgate.com/ViewPoem.aspx?id=205314",""],[5843,"وصندوق البريد","https://www.poetsgate.com/ViewPoem.aspx?id=51286",""],[5848,"الشماعه","https://www.poetsgate.com/ViewPoem.aspx?id=53102",""],[5909,"هلا امتلكت شجاعة لمحبتي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=209197",""],[5910,"دعاكَ السُّهدُ والأرقُ العتيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=206954",""],[5942,"بغداد. يا لغة الدنيا وجنتها","https://www.poetsgate.com/ViewPoem.aspx?id=215593",""],[5952,"لا وجه لي","https://www.poetsgate.com/ViewPoem.aspx?id=205983",""],[5997,"قيم الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=214222",""],[6035,"إنّ المُقَرِّظَ بالأحبابِ مُتَّهَمُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177163",""],[6093,"نجدة الريح","https://www.poetsgate.com/ViewPoem.aspx?id=198957",""],[520,"الحمد لله على حالة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577560",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""]],"verses":[["وَإِنْ أَتَى الصُّبْحُ دَعَوْنَا بِأَنْ","يَخْفَى وَشِيكاً وَيَعُودُ الظَّلامْ",0,"م",1,0],["وأن أتمادَى في جدال خصومه","وأقرعَ منهم بالبيان المُكابرا",1,"ر",2,0],["وإن أتى البيت بيت الله رجّ به","وأوجس الركن من منعاك زلزالا",2,"ل",2,0],["وَإِن آتِهِ أَصرِف إِذا خِفتُ نَبوَةً","وَأَحبِس قَلوصَ الشُحِّ إِن كانَ باخِلا",3,"ل",2,0],["وإن أتوني وقالوا إنَّها نِصَفٌ","فإنَّ أطيبَ نصفيها الذي ذهبا",4,"ب",2,0],["وأن أتلهَّى بالحديث عن الأسى","وألقى جليسي بابتسامٍ إذا ابتسمْ",5,"م",1,0],["وَإِن أَتَعَرَّض لِلوَليدِ فَإِنَّهُ","نَمَتهُ إِلى خَيرِ الفُروعِ مَضارِبُه",6,"ب",2,0],["وَإِن أَتانا أَخو مالٍ يُكاثِرُنا","بَِلتِبرِ تيهاً رَجَوناهُ وَخِفناهُ",7,"ا",2,0],["وَإِن أَتى بِالمِدادِ مُقتَرِناً","فَمَرحَباً بِالخُدودِ وَالحَدَقِ",8,"ق",1,0],["وان اتى الليل فهم اذؤب","والليل يوم الاذؤب الطلس",9,"س",1,0],["وَإِنِ اِتَّخَذتِ الهَجرَ دارَ إِقامَةٍ","وَأَخَذتِ مِن مَحضِ الصُدودِ نَصيبا",10,"ب",2,0],["وَإِن أَتَطَلَّب بِهِ نائِلاً","فَلَستَ مَلِيّاً بِإِطلابِهِ",11,"ب",2,0],["وَإِن أَتَصَدَّق بِهِ حِسبَةً","فَإِنَّ المَساكينَ أَولى بِهِ",11,"ب",2,0],["وَإِن أَتى دونَهُ الحِجابُ فَلَن","تَستُرَ عَنهُم آلاءَهُ حُجُبُه",12,"ب",2,0],["وَإِن أَتاهُ خَليلٌ يَومَ مَسأَلَةٍ","يَقولُ لا غائِبٌ مالي وَلا حَرِمُ",13,"م",1,0],["وَإِن أَتَيتَ بِجودٍ مِن ذَوي نَسَبٍ","فَإِنَّ نِسبَتَنا جودٌ وَعَلياءُ",14,"ا",2,0],["وَإِنِ اتَّقَيتَ اللَهَ في","كُلِّ الأُمورِ فَقَد غَنِمتا",15,"ت",2,0],["وَإِنِ اِتَّقَيتَ فَإِنَّ تَق","وى اللَهِ مِن خَيرِ النَفَل",16,"ل",1,0],["وَأَنّا تَجارَينا ثَلاثينَ حِقبَةً","فَفاتَ سِباقاً وَالحِمامُ قِصابُ",17,"ب",1,0],["وأن أتى السلم حتى ظل سامعه","مِن غلْيِ أَفراحه يَبكي وَيبتسم",18,"م",1,0],["وأنا تذكرُ الضِّيَاءَ عُيُونِي","مثلما يَذْكُرُ الغُصُونَ الحَمامُ",19,"م",1,0],["وإن أتانا أخو مال يكاثرنا","بالتّبر تيها رجوناه وخفناه",20,"ا",2,0],["وإِنَّا تَعلَمُ الاَقوَامُ أنَّا","مَنَاحِيرٌ بَوَائِكَهَا السِّمَانَا",21,"ن",2,0],["وَإِن أَتَتكَ كُؤوسُ الحَمدِ مُترَعَةً","لَم تَأتِهِم نُخَبٌ مِنها وَلا نُغَبُ",22,"ب",1,0],["وإنْ أتَوكَ وقالوا ثَغرُها برَدٌ","فاحزم فكم بَرَدٍ قد أحرقَ البَلَدا",23,"د",2,0],["وإنْ أتْتك عروس الدنِّ مُسِفرةً","فانثرْ على الكأس فيها فَضْلةَ الكيس",24,"س",1,0],["وإن أتى آخر الزمان فقد","تقدمت بينات مسنده",25,"د",2,0],["وإن أتى مفرداً ومختصراً","في فضله طال عن معدده",25,"د",2,0],["وأنْ أتركَ العَنْسَ الحسيرَ بأرضِها","يطيفُ بها عُقبانُها ونُسورُها",26,"ر",3,0],["وان أتيت بمعنى من بدائعه","فإن ذاك حديث عنه مروي",27,"ي",1,0],["وان اترك اللهو الذي ذم دائما","وازهد فيه للنُهى عنه راغبا",28,"ب",2,0],["وإِن أَتاكَ زائِرا","فانهض إِليه شاكِرا",29,"ر",2,0],["وإِن أَتى بنقلِ","سمعتَه من قَبلِ",29,"ل",1,0],["وآنا تكون قبوراً لها","ركائزها الرأس والناصية",30,"ي",2,0],["وَان أَتَيت بِنُظم","أَشحَيت كل مُتَيم",31,"م",1,0],["وَاِن أَتى حُبِّهم ذو كُربَة وَبِهِ","ضيق أَصابَتهُ لَمحات وَنَفحات",32,"ت",1,0],["وأنْ أتلقَّى محنةً ثمّ منحةً","فأضعُفَ عن حَمْلي لكليتهما مَتْنا",33,"ن",2,0],["وإن اتحاداً جوهريّاً تراهما","وليس اتحاداً في اتفاق المحبة",34,"ه",1,0],["وإن أتى أمر من الرحمن","فارض به تفوز بالرضوان",35,"ن",1,0],["وإن أتينا ذنوبا وافره لا تعد","فالعفو والفضل واسع ليس له قد حد",36,"د",1,0],["وإنّ اتِّبَاعي نهج زيدٍ لِنعْمَةٌ","يَقلّ علَيها الشُّكر ما عِشْتُ والحمدُ",37,"د",1,0],["وإنا تائبون إلى الليالي","فهل تجدي إنابتنا وتغني",38,"ن",2,0],["وإن أتيت قال هذا نوبتي","فاضرب بها إن شئت تحظى عندي",39,"د",2,0],["وإن أتاهُم بقولٍ عنك مُختَلَقٍ","واشٍ فذاكَ الذي يُحْبَى ويُحتَرمُ",40,"م",1,0],["وإنْ أتَاني حِمامٌ أستريحُ بهِ","فَيَا لَها مِنّةً للموتِ في عُنُقِي",41,"ق",2,0],["وإنْ أتَتْهُ القوافي الغرّ أتْحَفَها","بشاهدٍ من معاليه ومشهود",42,"د",1,0],["وان أتيت لوصل طالما عدلت","فانظر إلى حادثات الحب ما فعلت",43,"ت",1,0],["وأنات السواقي وهي أشجى","وأبلغ من دموع لليتيم",44,"م",1,0],["وإن اتهمتَ فمي فربَّ فِراسةٍ","في الوجه تشهد لي بذاك وتحلِفُ",45,"ف",1,0],["وإن أتَى رائدُ النيروزِ مجتدياً","أَيْمانَكم فالروابي الخُضْرُ والعُشُبُ",46,"ب",1,0],["وأنّاتِ أذانٍ في مهبّ","أراويحٍ من البُهتانِ خائرْ",47,"ر",1,0],["وأن أَتِيهَ الدَّهْرَ كِبْراً عَلَى","كُلِّ لَئيمٍ أَصْعَرِ الخَدِّ",48,"د",1,0],["وإنَّ اتِّقاءَ الشَّرِّ لِلمَرءِ لازِمٌ","وإنَّ اتِّقاءَ الشَّرِّ بِالشَّرِّ أَلزَمُ",49,"م",1,0],["وأنا تلك كما تلك أنا","وهما الواحد والإثنان لك",50,"ك",1,0],["وإن أتى من شِهابِ الدِّينِ مُقتَبَساً","كِتابُ أنُسٍ وقد غابَتْ فلا رَجَعتْ",51,"ت",1,0],["وَإن أَتيتَ الخلّ فارفِق رَأَفَةً","عَن غثِّها المُغني عَلَى جَنينِها",52,"ن",3,0],["وإن اتَّحَدتَ بِسيرَةٍ نَبَويَّة","مَخصُوصة بالفضل والتَّوحيد",53,"د",1,0],["وإنا تائقون إليك فاعلم","وأنت إلى زيارتنا تتوق",54,"ق",1,0],["وَإِن أَتَوكَ فَقالوا كُن خَليفَتَنا","فَقُل لَهُم إِنَّني عَن ذاكَ مَشغولُ",55,"ل",1,0],["وإن أتيح النصر لليابانِ","فغنمهم وغرمهم سيانِ",56,"ن",1,0],["وَإِن أَتى الذئب هُنا نَزنقُهُ","وَكُلُنا نمسكه نَخنُقُهُ",57,"ه",1,0],["وَإِن أَتوه بِحمارٍ عَلَّمَه","فَصاحَةً وَبِاللسان كَلَّمه",58,"ه",1,0],["وَإِن أَتاه عَن يَسار يَمَّنا","وَالتَفَّ في كِسائِهِ وأَتقَنا",59,"ن",2,0],["وَإِن أَتى عَفواً فَذاك مدني","وَلوجه الأذن بِدون أذنِ",60,"ن",1,0],["وإن أتى في الدجى أغناك عن قمرٍ","تَمٍّ وعن ضوء مِقْباسٍ ونبراس",61,"س",1,0],["وَإِن أَتت مِن أخٍ عوراءُ قمتُ لها","منّي بسالمةِ العينينِ من كلمِ",62,"م",1,0],["وَإِن أتيتَ إِلى دستِ المظفّر لث","ثم واِمسَحن بِالثرى منه محيّاكا",63,"ك",2,0],["وإن أتت تذكرة من خارجْ","خذها على منوال هذا الناهِجْ",64,"ج",1,0],["وَإِنْ أَتَتْ مِنْهُمُ كُتُبٌ مُؤَلَّفَةٌ","ف السَّيْفُ أَصْدَقُ أَنْباءَ مِن الكُتُبِ",65,"ب",1,0],["وإن آتِ ببعضٍ من قوافي","ثمار الِشعر عندك ما جنيت",66,"ت",1,0],["وَإِن أَتى في جَحفل عَظيم","مِن المَوالي وَمِن الصَّميم",67,"م",1,0],["وإن أتى معها ضمير الشان","رفع في جملتها الجزءان",68,"ن",1,0],["وإن أتى بالكسر ما قبل اليا","مع متبع بالفتح فارو النهيا",69,"ي",2,0],["وإن أتاكَ باعوجاجٍ ودَعَت","ضرورةٌ اليه بالذي اقتضت",70,"ت",1,0],["وإن أتت اخيرة فتمنعُ","مشكولةً مبسوطةً وتوضعُ",70,"ع",1,0],["وإن أتى من عُنقِ ذات القلبِ","قافٌ فتلك عن سناها تُنبي",70,"ي",1,0],["وان اتت وسطى كحاء الحرم","فنصبها في نصفها المقدّم",70,"م",1,0],["وان اتت بغير وضع المنتصب","فردها في الثلث عند المحتسب",70,"ب",1,0],["وان اتت اخيرة فتجعلُ","كمفرد بغير رأسٍ يعمل",70,"ل",1,0],["وإن أتى تال لها بالبسط","صادية كمفرد في الخط",70,"ط",1,0],["وإن أتاك نعيي فاندبن أباً","قد كانَ يضطلعُ الأعداءَ والخَطَبا",71,"ب",2,0],["وَإِن أَتاكَ لِمالٍ أَو لِتَنصُرَهُ","أَثنى عَلَيكَ الَّذي تَهوى وَإِن كَذَبا",72,"ب",2,0],["وإن أتى خائفا تشتد روعته","يلقى الأمان من الروعات إذ يأتي",73,"ت",2,0],["وانَّا تبدّلنا كلانا وانني","تسَلَّيت عن غيّ الصّبا وتسلَّتِ",74,"ت",1,0],["وإن أتلعت للسلم أعناقها العدى","عفا ونفى عنها المخافة والفقرا",75,"ر",2,0],["وإن اتحدثْ عن أُبيٍّ بفضْلِهِ","فعنديَ منْ تلك الأحاديث ما عندي",76,"د",2,0],["وأنَا تَرَى محدٍ حبيبي بيسواك","قَلْبٍ رخص غَيْرِكْ وبالحيل شَارِيْك",77,"ك",1,0],["وان اتى سيئا يحسن لدى وما","اتيت من حسن في عينه يسوء",78,"ا",1,0],["وان اتى ليلحقا","بك جهول يغرق",79,"ق",1,0],["وإِن أتتْكَ نسيمُ الشرقِ زائرةً","فانفُضْ لها الزهرَ بالجاديِّ مُنْفَعما",80,"م",2,0],["وانا تذكرنا سميك إذ عدا","عليه الردى ظلماً وناهيك حاله",81,"ل",2,0],["وإن أتهموا داراً وانجدتُ منهم","فمنك جَوىً في القلب ليس يزول",82,"ل",1,0],["وانا تولعت في حبه","ورحت من طول هجرانه",83,"ن",2,0],["وان اتوا بابه والدهر قد عبست","ايامه لن يروه غير مبتسم",84,"م",1,0],["وَإن أتَاكَ الليلُ فيهِ فآدرَحَا","إن كاَنَ رِيحُك قالِعاً فَالِحَا",85,"ح",2,0],["وَإِن أَتى بِهَفوةٍ في المَجلِسِ","فَاستُر عَلَيهِ سَترَ خِلٍّ مُؤنِسِ",86,"س",1,0],["وآنا تراه راجلا حافيا بلا","رداء ولا في رأسه عمة فادر",87,"ر",1,0],["وإنْ أَتى المَحْلُ يوماً صاب صَيِّبُنا","وجاد فيه إِذا ما ضَنَّتِ الدِّيَم",88,"م",1,0],["وإن أتت رقدةٌ بالطّيف منك فلم","أجرأ على الّطيف في تكليفه القبلا",89,"ل",2,0],["وإن أتتك أمور لم تعد لها","فانهض برأيك بين الريث والعجل",90,"ل",1,0],["وان اتاك طعام فيه فاكهة","قدمها ان نضجت من قبل لحمهم",91,"م",1,0],["وإنّا تاركونَ غداً حديثاً","بأرضِ السندِ سعداً والربابا",92,"ب",2,0],["وأناتٌ من الأحزان زادت","تولى القلب منها باشتعال",93,"ل",1,0],["وإن أتى مشربا حميدا","كان وإن راقه ذميما",94,"م",2,0],["وان أتاه ضعيف","يشكو الاذى من جوازه",95,"ه",1,0],["وإن أتى رمضانُ واصطفيتَ له","فاخلع ثيابَ الهوى وقم على قدمِ",96,"م",1,0],["وَأَن أَتروَّى مِن دَمٍ غَير طاهرٍ","إِذا اِرتَفَعت يَوماً وَقاحةُ ناعبِ",97,"ب",1,0],["وآناً تحتَ أخمصه رمالٌ","وآنا تحت أخمصهِ عبابُ",98,"ب",1,0],["وانا توكلت لك واخرج رباعي حب","والله نعصد ونتعشى ذك الليله",99,"ل",2,0],["وآناً تشير إلى كلبها","وما كان من فتكه بالبسين",100,"ن",1,0],["وإن أتيت الحمى وَهناً فحيِّ به","حَيّا أقاموا بجرمانا وجسرينِ",101,"ن",1,0],["وَإِن أَتيتَ مَجلِسَ الإِخوانِ","فَلا تُجالِسهُم بِلا اِستِئذانِ",102,"ن",1,0],["وإنْ أتتْ فِتَنٌ كالليلِ مظلمةً","فكنْ أخا بصرٍ بالرأي واتَّزِرِ",103,"ر",1,0],["وأَنا تَجَاذَبُنِي الشُّجونُ كما","تَتَجاذَبُ العَفويَّةُ الشَّغَفَا",104,"ف",2,0],["وإِنْ أتَوكَ غَدَاةَ الفَجرِ في عَجَلٍ","أنَّ الصِّيَاحَ لَهُمْ فِي فَجْرِهِم عَمَلُ",105,"ل",1,0],["وانا تراني / قوية باس","اللي نساني / تناسيته !",106,"ت",2,0],["وانا تنهاتي وحزني لما ريت","من الوجع والضيم وسط المحيا",107,"ي",2,0],["وأنا تحت نير تلك القساما","ت جواد قد هده الإعياء",108,"ا",2,0],["وإنْ أتَتْكَ بِنُصحٍ فَاتَّهِمْهُ وَلَا","تَرْكَنْ إليهِ وَلو جاءَتكَ بالعِلَلِ",109,"ل",1,0],["٩- وأنّاتها جاوزت مسمعاً","بواحاً صراحاً .. لقيطٌ وجال",110,"ل",1,0],["وأنا تنادمني \"خناسٌ\" في النوى","و\"زبيدةٌ\" لمواجدي تستثكلُ",111,"ل",1,0],["وأنا تعِبْتُ مِن الصِّبا","وبدأتُ مِن لا شيءَ أتعبْ",112,"ب",1,0],["وانا توني في مسلك الحب منجرّه","قالوا عواذل:خلك لغيرك موالف",113,"ف",1,1],["وانا تعبان ما أقوى على القومه","من فرقاه عفت الماي والزادي",114,"د",2,0],["وَإِنْ أَتَيْتَ إِلَى دَسْتِ المُظَفَّرِ فالْ","ثِمْ ( مِنْ ) ثَراهُ وَمِنْهُ امْسَحْ مُحَيَّاكَا",115,"ك",2,0],["وَإِنْ أَتَتْ مِنْ أَخٍ عَوْراءُ قُمْتُ لَها","مِنِّي بِسالِمَةِ العَيْنَيْنِ مِنْ كَلِمِي",116,"م",2,0],["وَإِنْ أَتَيْتَ إِلَى هالاتِ مَجْلِسِهِ","فَقَبِّلْ الأَرْضَ وَاسْجُدْ غَيْرَ مُحْتَسِمِ",116,"م",1,0],["[ وَإِنَّ أَتِيَّ السَّيْلِ قَدْ بَلَغَ الزُّبَى","لَدَيْهِمْ وَإِنَّ الهَزْلَ صارَ لَهُمْ جِدّا ]",117,"د",2,0],["وأنا تطاردني الحتوفُ بقسوةٍ","وتنالُ مني كي أطوف شهيدةْ",118,"د",2,0],["وأنا تحسبني تبت وإلا قنعت وجيت","هبلني مثل ناس لهالحين منهبله",119,"ل",2,0],["وإن أتى الصبح دعونا با","يخفى وشيكا ويعودا لظلام",120,"م",1,0],["وإن أتَتك جيوشُ الهمِّ غازيةً","فبالصلاةِ على المختارِ تنهزمُ",121,"م",1,0],["وانا تكفيني نعم لا جات غصبن من ورى","خشم القريب) وبيض الله وجهي مع اللي بعيد",122,"د",1,0],["وانا تهجيّت الزمان من اسهله لين اصعبه","من اصعبه لين اصعبه  عفواً  تهجيّت الصعب",123,"ب",1,0],["وأنا تعاظم في انتظاري لحظةٌ","آويتها في ذا الخيال وفيكَ",124,"ك",1,0],["وأنَّاتٌ تلقَّفَها فؤادي","فأوجسَ ذلك القلبُ الشقيُّ",125,"ي",1,0],["وإنْ أتتكَ حروفي وهي واهيةٌ","فالمرءُ في زحمةِ الافكار في وهَنِ",126,"ن",1,0],["وأنا تفاعيل القريض سليمةٌ","من كل زحّاف لتضبط قالبه",127,"ب",2,0],["وَإِنْ أَتَاكَ لِسَانُ السُّوءِ يَدْفَعُهُ","عِشْقَ الْوِشَايَةِ فَأَسْتَقْبِلُهُ بِالصَّمَمِ",128,"م",1,0],["وإنْ أتَتْكِ لَهَافَى غَمَّهَا كَمَدٌ","مِنْ مقْلَتيكِ يَفيضُ الوِدُّ والرُّحُمُ",129,"م",1,0],["وَإنْ أَتَتْهَا لِجَنْبٍ أَوْ مَوَاجِهَةً","فَسَوفَ تَرْسُو عَلَى قَاعِ المُحِيْطَاتِ",130,"ت",1,0],["وإن أتته رقعتي لم يجب","عنها ولم يشغل بها فكره",131,"ر",2,0],["وَإِنْ أَتَيْتُ الْنَّهَرَ وَحْدِيْ لَوَىْ","عَنِّيْ وَغَطَّىْ وَجْهَهُ بِالْشَّجَرْ",132,"ر",1,0],["وَإِنْ أَتَيْتَ الدَّارَ ضَاءَتْ كَلَوْ","قَدْ وَاجَهْتْ مَهْدِيَّهَا المُنْتَظَرْ",132,"ر",1,0]]}