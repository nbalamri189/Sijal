{"poems":[[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[68,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[82,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[52,"جفا ودهُ فازور أو مل صاحبهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17924",""],[82,"ما للوشاة ِ عليها أذكتِ الحَدَقا","https://www.poetsgate.com/ViewPoem.aspx?id=3423",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[228,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132474","الطويل"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132415","الطويل"],[1273,"","https://poetry.dctabudhabi.ae/diwan/poem/199223","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109038","الخفيف"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198976","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93981","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139979","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48315","الطويل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34712","الخفيف"],[3781,"","https://poetry.dctabudhabi.ae/diwan/poem/198322","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[1012,"الشعشعة","https://www.poetsgate.com/ViewPoem.aspx?id=186277",""],[1012,"فتوحات الإمام عزان بن قيس","https://www.poetsgate.com/ViewPoem.aspx?id=124503",""],[5213,"خليلي هل يدنو من الحي شاسعه","https://www.poetsgate.com/ViewPoem.aspx?id=170502",""],[5438,"زَبَدُ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=202062",""],[5601,"ضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=23536",""]],"verses":[["كان مثلَ الرحا هناك وكانتْ","عُددُ الحربِ كلها كالثفالِ",0,"ل",1,0],["كأنَّ مُثارَ النقع فوقَ سوادِهِ","سحابٌ على ليلٍ تَطَخْطَخَ فادْلهمْ",1,"م",1,0],["كَأَنَّ مُثارَ عِثيَرِها سَحابٌ","حَدَتهُ مِن سَنابِكِها جَنوبُ",2,"ب",1,0],["كَأَنَّ مَثواكَ لِلبيتِ العتيقِ أَخٌ","وَاليَعمُلاتُ إليهِ تَملأ الطّرُقا",3,"ق",2,0],["كَأَنَّ مُثارَ النَقعِ فَوقَ رُؤُسِهِم","وَأَسيافَنا لَيلٌ تَهاوى كَواكِبُه",4,"ب",2,0],["كأن مثال النقع فوق رؤوسهم","وأسيافنا ليلٌ تهاوى كواكبه",5,"ب",2,0],["كأنّ مثواك لليت العتيق أخٌ","واليعملاتُ إليه تملأ الطّرُقا",6,"ق",2,0],["كانَ مثلَ المسكينِ يجلس للأك","لِ فَلا مُتّكا له لا اِتّكاءُ",7,"ا",2,0],["كانَ مِثلي فَغَيَّبَ القَبرُ مِنهُ","جَسداً بالياً قُبَيلَ أَوانِه",8,"ن",2,0],["كانَ مِثلَ الضَّياحِ في القاعِ طَوْراً","وحكى تارةً ثُغاءَ الرّاعي",9,"ع",2,0],["كأن مثارَ النقعِ إثمدُ عينهِ","وأشفارَ جفنيهِ الشفارُ الصوارمُ",10,"م",1,0],["كأن مثاني ذكرهم في تهجد","مزامير داؤد بها قد تسجعوا",11,"ع",3,0],["كأنّ مُثارَ النقعِ (فيه) وَبِيضهُمْ","بُرُوقٌ تَلاَلاَ فيه، والدم وابلُ",12,"ل",1,0],["كان مثل المقص لا تتلاقى","شفتاه إِلاَّ على التمزيق",13,"ق",1,0],["كان مثل السيف إلا أنه","حمل الدهر عليه فصدي",14,"د",2,0],["كان مثل البابوش في الرجل لكن","جعلته أيدي العلى سربوشا",15,"ش",2,0],["كأن مثالَ النعلِ محرابُ مسجدٍ","فؤاديَ فيه شاخص الطرف دائمه",16,"م",2,0],["كأنّ مُثارَ النّقْعِ ليلٌ وفجْرُهُ","حُسامُك يبْدو خاضِباً متضرِّجا",17,"ج",2,0],["كانَ مِثلَ الوَكيلِ في كُلِّ سوقٍ","إِن تَلَكّا أَو مَلَّ يَوماً وَكيلُ",18,"ل",1,0],["كان مثل السيف إلا أنه","حُسِدَ الدهر عليه فصَدِي",19,"د",2,0],["كأن مثير الصواعق بدد","سحاباً به شامخ الطود يربد",20,"د",1,0],["كأن مثاني ذكرهم في تهجد","مزامير داود بها قد تسمعوا",21,"ع",3,0],["كأن مثاني ذكرهم في تهجد","مزامير داؤود بها قد تسجعوا",22,"ع",3,0],["كأن مثار العيس ساعة أو لجوا","فؤادي وتذكار العذيب ينازعه",23,"ع",2,0],["كَأَنَّ مَثَارَ العِشْقِ تَحْتَ أَنَامِلِي","وَ أَجْفَانُهَا سَيْفٌ وَ أَضْلَاعِيَ الغِمْدُ",24,"د",1,0],["كان مثلي شاعراً يصطاد ظله","ثم أدركنا معاً أن السراب",25,"ب",1,1]]}