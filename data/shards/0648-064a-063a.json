{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[53,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[53,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[53,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[53,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[63,"خليلي هلا ذدتما عن أخيكما","https://www.aldiwan.net/poem45951.html","الطويل"],[63,"حلفت بمرقوع الأظل تشبثت","https://www.aldiwan.net/poem46126.html","الطويل"],[63,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[77,"خذ من حياتك للممات الآتي","https://www.aldiwan.net/poem36676.html","الكامل"],[77,"يا طلعة الشوم التي مهما بدت","https://www.aldiwan.net/poem36765.html","الكامل"],[86,"ما أنت أول كوكب","https://www.aldiwan.net/poem10470.html","مجزوء الكامل"],[73,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[35,"فلولا الله ثم ندى ابن ليلى","https://www.aldiwan.net/poem39178.html","الوافر"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[47,"ويغتابني من لو كفاني غيبه","https://www.aldiwan.net/poem25122.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"يخيل لي برق من الثغر لامع","https://www.aldiwan.net/poem19168.html","الطويل"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[51,"ويغفر للهافين غير مقصر","https://www.aldiwan.net/poem62957.html","الطويل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"تعالي نتعاطاها كلون التبر أو أسطع","https://www.aldiwan.net/poem8982.html","عموديه"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[91,"وسائلة أي المذاهب مذهبي","https://www.aldiwan.net/poem62662.html","عموديه"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[70,"يومنا يوم مطير","https://www.aldiwan.net/poem42877.html","مجزوء الرمل"],[92,"أراك فتحلو لدي الحياة","https://www.aldiwan.net/poem38925.html","المتقارب"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"أنت يا شعر فلذة من فؤادي","https://www.aldiwan.net/poem38953.html","الخفيف"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[89,"حلمت بان الدهر لي يتبسم","https://www.aldiwan.net/poem44859.html","الطويل"],[85,"أبو الحصين جال في السفينه","https://www.aldiwan.net/poem8021.html","الرجز"],[85,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[85,"لمن غرة تنجلي من بعيد","https://www.aldiwan.net/poem63718.html","الطويل"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[45,"أعجب لظلم زماننا المتواتر","https://www.aldiwan.net/poem63592.html","الكامل"],[45,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[45,"رأيت الانبساط إليك يحظى","https://www.aldiwan.net/poem65585.html","الوافر"],[45,"أثيل العقيق إلى بانه","https://www.aldiwan.net/poem66677.html","المتقارب"],[61,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[61,"أيا شاغل الشكر عن غيره","https://www.aldiwan.net/poem51658.html","المتقارب"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[44,"سلام الله عدة رمل خبت","https://www.aldiwan.net/poem30572.html","الوافر"],[31,"ألم تسأل المنزل المقفرا","https://www.aldiwan.net/poem42499.html","المتقارب"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[81,"أمولاي الذي آوي به في","https://www.aldiwan.net/poem61326.html","الوافر"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[48,"غنيت عن الكواعب بالغلام","https://www.aldiwan.net/poem65250.html","الوافر"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"أرقت فهل نجم الدجنة آرق","https://www.aldiwan.net/poem23015.html","الطويل"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140869",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39538","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66077","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55058","الوافر"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[77,"يا طلعَة َ الشُّوم التي مهما بدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=33203",""],[90,"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[45,"أمنْ أجلِ أنْ أقوَى الغُوَيرُ فَوَاسطُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31124",""],[91,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=53230",""],[91,"في فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53028",""]],"verses":[["وَيَغدو ماتِحاً لِلضَ","رِعِ الواني بِسَجلَينِ",0,"ن",1,0],["وَيَغدو رَهَجُ الرَوعِ","لِحاماً بَينَ غارَينا",1,"ن",2,0],["وَيَغدو لِمَن يُروي جَنابَكَ مُروِياً","زُلالا وَلِلأَعداءِ دونَكَ مُصعِقا",2,"ق",2,0],["وَيَغتَدي بَعدَ عِراكِ السُرى","يُعارِضُ الرَكبَ بِوَجهٍ طَليق",3,"ق",1,0],["وَيَغضَبونَ إِذا عاطَيتَهُم هِمَماً","مُرَفَّهاتٍ وَهَمّاً غَيرَ مَكدودِ",4,"د",1,0],["وَيَغشى الوَغى وَاليَومُ قانٍ أَديمُهُ","بَعَضبٍ لَهُ مِن هامَةِ البَطَلِ الغِمدُ",5,"د",1,0],["وَيَغْشَى غِماراً يُتَّقَى دُونَها الرَّدَى","فَإِنْ هُوَ أَوْدَى قيلَ للهِ دَرُّهُ",6,"ر",2,0],["ويُغْرونَهُ بيَ والإباءُ سجيّتي","إذا خوّفوني ضَلّةً سَطَواتِهِ",7,"ت",2,0],["ويُغْشى ذَراهُ حينَ يُسْتَعْتَمُ القِرى","ويَسْمو إليهِ الطّارِقُ المُتَنوِّرُ",8,"ر",1,0],["ويُغْضي منْ تَكَرُّمِهِ حَياءً","ودونَ إبائِهِ سَطَواتُ أُسْدِ",9,"د",1,0],["ويَغُرُّنا لَمْعُ السّرابِ فنَغْتَدي","في غَفْلَةٍ عنْ هادِمِ اللّذّاتِ",10,"ت",1,0],["وَيَغُضُّ مِنْ فَرْطِ الْحَيَاءِ جُفُونَهُ","مِنْ سُوءِ مَا قَدْ جَاءَهُ وَأَتَى بِهِ",11,"ب",2,0],["وَيُغالُ ضَيفُكَ وَاِبنُ أُخ","تِكَ وَهوَ عَن مِصرٍ غَريب",12,"ب",1,0],["وَيُغرى بِتَوكيدِ الإِساءَةِ مُذنِبٌ","فَيَلقاكَ بِالإِحسانِ أَغرى وَأَولَعا",13,"ع",2,0],["وَيَغمُرُنا إِذا نَحنُ اِلتَقَينا","بِطامي الموجِ مُضطَرِبِ الحَبابِ",14,"ب",1,0],["ويغضي عن العوراء إغضاء قادرٍ","ويرجحُ في الحِلم الجبالَ الرواسيا",15,"ي",2,0],["وَيَغتابُني مَن لَو كَفانِيَ غَيبَهُ","لَكُنتُ لَهُ العَينَ البَصيرَةَ وَالأُذنا",16,"ن",2,1],["ويغتدِي فكرهُ المكدودُ في حرَقٍ","وقد أحاطت بما قالَ البرودات",17,"ت",1,0],["ويغني عن الأنواء في الشامِ عدلُهُ","وعدل الفتى للخصبِ نعم المزارع",18,"ع",1,0],["ويغني عن الأمداح مشهور فضلها","وما الصبح محتاجٌ إلى الوصفِ والحلى",19,"ل",2,0],["ويغفر للهافين غيرَ مُقصِّرٍ","ولا جاهلٍ ما قد أتوا حين يغفرُ",20,"ر",1,1],["ويغضب اللَّه والسبع الطِّباق له","وساكنوهنّ والأبرار والسور",21,"ر",1,0],["وَيَغلِبُ نَفسي الحُزنُ عِندَ رَحيلِها","كَما تَحزَنُ الأَزهارُ زايَلَها النَدى",22,"د",2,0],["وَيَغوصُ فيهِ خَيالُها فَيَلفُّهُ","وَيَشِفُّ فَهوَ المُنطَوي المَنثورُ",23,"ر",1,0],["وَيَغدو النورُ جِلبابُكِ في الغابِ وَجِلبابي","فَكَم نُصغي إِلى الناسِ وَنُعصي خالِقَ الناسِ",24,"س",1,0],["وَيَغيبُ عَنّي طَودُها وَقِبابُها","وَقُصورُها خَلفَ الفَضاءِ الأَزرَقِ",25,"ق",1,0],["وَيَغتَسِلُ الذِئبُ الأَثيمُ بِمائِهِ","فَلا إِثمُ ذا يُمحى وَلا طُهرُ ذا يَبلى",26,"ل",2,0],["وَيَغُطُ تِبرُ الأَرضِ فيكَ تُرابَها","وَيَحسُدُ ماءَ الجَفنِ ماءُ الخزَريرِ",27,"ر",1,0],["وَيَغيبُ القَومُ في المَج","لِسِ وَالقَومُ حُضورُ",28,"ر",1,0],["ويغْمُرُ روحِي ضِياءٌ رَفيقٌ","تُكلِّلهُ رائعاتُ الورودْ",29,"د",1,0],["ويغرِّدُ الشُّحرورُ مَا","بَيْنَ الجَماجِمِ والرّفاتْ",30,"ت",1,0],["ويغنِّي الصَّباحُ أُنشودَةَ الحبِّ","على مَسْمَعِ الشَّبابِ السَّعيدِ",31,"د",1,0],["ويغبرُّ فرعٌ كجنْحِ الظَّلامِ","أنيقُ الغدائرِ جَعْدٌ مَديدْ",32,"د",1,0],["ويغسل ادران السياسة كلها","من الارض كل الارض شيء هو الدم",33,"م",1,0],["وَيُغلِظُ الأَيمانَ لِلدُيوكِ","لِما عَسى يَبقى مِنَ الشُكوكِ",34,"ك",1,0],["وَيُغشى اللَيثُ في الغاباتِ ظُهراً","وَكانَت لا تَقَرُّ بِها الحَصاةُ",35,"ه",1,0],["وَيَغشى الدُنا مِن حُلاها سَنىً","أَضاءَ لَنا كُلَّ حالٍ نَضيد",36,"د",1,0],["ويغشاهما ثَوْبٌ رقيبٌ سَداؤُهُ","رقيقُ الحواشي مِنْ نَسيجِ العناكبِ",37,"ب",1,0],["وَيُغنيكَ عَمّا يَنسُبُ الناسُ أَنَّهُ","إِلَيكَ تَناهى المَكرُماتُ وَتُنسَبُ",38,"ب",1,0],["ويُغنيهِ عنها الرأيُ ما ظنَّ صائبٌ","وما همَّ محتومٌ وما حَزَّ مقطعُ",39,"ع",1,0],["وَيَغدو عَلَيكُم وَهوَ كاتِبُ نَفسِهِ","وَنِعمَتُهُ تَغدو عَلى أَلفِ كاتِبِ",40,"ب",1,0],["وَيَغتَدي في صَلاحِ شَأنِهِمِ","لِسانُهُ المُكتَفى بِهِ وَيَدُه",41,"د",2,0],["وَيُغِلُّها قَومٌ وَأُعطي خَرجَها","حُكمٌ لَعَمرِكَ غَيرُ عَدلٍ ظاهِرِ",42,"ر",1,0],["وَيَغدو وَيَعقُبُ اِبنُهُ مُتَرَسِّلٌ","يُزانيهِ في أَولادِهِ وَيُلاوِطُه",43,"ط",2,0],["وَيُغضِبُكَ السُكوتُ إِذا سَكَتنا","وَبَعضُ القَومِ يُغضِبُهُ السُؤالُ",44,"ل",1,0],["وَيَغدو وَنَجدَتُهُ في الوَغى","تُدَرِّبُ نَجداتِ فُرسانِهِ",45,"ن",2,0],["ويَغمِزُ كفِّيَ كَفَّ النَّديمِ","ويُومِضُ طَرفي إلى السَّاقِيه",46,"ي",2,0],["ويغري القميص بها سترة","فيظهرها الشكر من ستره",47,"ر",2,0],["وَيَغتَني بِالمُلدِ مِن سُمرِ القَنا","عَن كُلِّ مَجدولِ القَوامِ أَملَدِ",48,"د",1,0],["وَيَغدو يَستَثيبُ بِلا نَوالٍ","وَنَيلُكَ كُلُّهُ لا لِلثَوابِ",49,"ب",1,0],["وَيَغفُلُ ذا الناسُ عَن لَهوِنا","وَنَسمُرُهُ كُلَّهُ مُقمِرا",50,"ر",2,0],["وَيَغشى النَدِيَّ بِخُلقٍ نَدٍ","تَرى الماءَ يَجري بِهِ مِن عَلَم",51,"م",1,0],["ويغضبُ أن يكونَ لها لسانٌ","يُذيعُ شكَاتَها في المُشْتكينا",52,"ن",2,0],["وَيُغنِينِي عَنِ الأهل انتِصَابِي","لِخِدمته ونائِلِهِ الجَزِيل",53,"ل",1,0],["وَيُغَرِّدُ المُكّاءُ في صَحرائِهِ","طَرَباً لِتَرنيحٍ مِنَ النَشَواتِ",54,"ت",1,0],["وَيَغُضُّ مِنْ مَغْسُولَتَيْنِ بِدَمْعِهِ","مَكْحُولَتَيْنِ مِنَ الظَّلامِ بإثْمِدِ",55,"د",1,0],["ويُغْمِدُ في هامِ الملوكِ حُسامَهُ","ويَرْهَبُ منْ هامِ المُلوكِ غَفيرُ",56,"ر",1,0],["وَيُغنيها عَنِ المُرجا","نِ أَن تَتَقَلَّدَ البَعرا",57,"ر",2,0],["وَيَغشى نارَها وَيَكونُ فيها","كَريمَ الفَتكِ كَرّاراً يُحامي",58,"م",2,0],["وَيَغدو بِأَخلاقِ المُهَلَّبِ مولَعاً","كَما شَمَّرَت عَن ساقِها الحَربُ تَطرَبُ",59,"ب",1,0],["وَيَغتَفِرُ الغِنى وَخَطّاً بِرَأسٍ","إِذا كانَت قِواكَ مُسَلَّماتِ",60,"ت",1,0],["وَيَغبِرُ في الأَيّامِ مَن طالَ عُمرُهُ","فَتَغبَرُّ مِن طولِ البَقاءِ المَفارِقُ",61,"ق",1,0],["وَيُغنيكَ عَن طَرحِ فالٍ تَعو","دُ بِاليُمنِ طَعنُكَ في الفائِلِ",62,"ل",1,0],["وَيَغمُزُ مِنهُ الفائِقَينِ كِلَيهِما","عَلى شَهوَةٍ غَمزَ الطَبِيبِ المُحَنجِرا",63,"ر",2,0],["وَيغضي خلال النظرتين محاذراً","رقيباً لها إن لم يكده يكيدها",64,"د",3,0],["ويغيرني جذب الذمام لقلبها","فمها إليك كطالبٍ تقبيلا",65,"ل",2,0],["ويغشى السماءَ الجهمُ من كلِّ ديمةٍ","تخدِّد وجه الأرضِ من عبراتِها",66,"ت",3,0],["ويَغْبِقُ أهْلَهُ لبَنَ الصّفايا","ويَمْنَحُ قَوْتَ مُهْجَتِهِ الجَوادا",67,"د",2,0],["ويُغَنِّيني فأنسى","في مَسَرَّاتِ غِنَاهْ",68,"ا",2,0],["وَيَغْفِرُ لِلخِدْنِ المُجَافِي جَفَاءَهُ","وَلَوْ أَنَّ ذَاكَ الخِدْنُ لِلفَضْلِ جَاحِد",69,"د",1,0],["وَيُغْرِبُ فِي فَعَائِلِهِ فَتأَتِي","رَوَائِعَ فِي التَّفَرُّدِ وَالسِّيَاقِ",70,"ق",1,0],["ويغنى المكاء في شاطئيها","يستخف النهى فحلت حباها",71,"ا",3,0],["ويَغِيضُ ماءٌ كانَ أيْسَرُ قَطْرةٍ","مِنهُ حَيَاةَ خَلاَئِقٍ وبِلادِ",72,"د",1,0],["ويُغَنُّونَ باسمِها مثلَ ما غَنَّى","زُهَيْرٌ بِسِيرَةِ ابْنِ سِنانِ",73,"ن",1,0],["ويغصُّ من فرط الحياء جفونَه","من سوء ما قد جاءَهُ وأتى بهِ",74,"ب",2,0],["ويغالِطانِ النَومَ عنك","بطَيِفك المَرحِ الطَروب",75,"ب",1,0],["ويَغْدُو ويَعْقُوبُ اْبنُهُ مُتَرَسُّلٌ","يُزَانِيهِ في أولاَدِهِ ويُلاَوِطُهْ",76,"ط",2,0],["ويغتسل الذئب الأثيم بمسائه","فلا إثم ذا يمحي ، ولا طهر ذا يبلى!",77,"ل",2,0],["ويغلب نفسي الحزن رحيلها","كما تحزن الأزهار زايلها الندى",78,"د",2,0]]}