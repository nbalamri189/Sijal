//www.aldiwan.net/poem15580.html","المتقارب"],[464,"تضمن منه حبوة المجد راسيا","https://www.aldiwan.net/poem15636.html","الطويل"],[464,"يفلل بالعزم الصوارم والقنا","https://www.aldiwan.net/poem15659.html","الطويل"],[464,"جلبنا الخيل مشرفة الهوادي","https://www.aldiwan.net/poem16177.html","الوافر"],[466,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[468,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[480,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[485,"أيا ربة الخال التي فتنت به","https://www.aldiwan.net/poem24373.html","عموديه"],[485,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[496,"ويوم أغص أتساع الفضاء","https://www.aldiwan.net/poem67343.html","المتقارب"],[518,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[554,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[554,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[554,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[554,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[561,"أنا البرق والرب المناجي هو الرعد","https://www.aldiwan.net/poem34590.html","الطويل"],[565,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"],[578,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22533","الطويل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17779","الوافر"],[1189,"","https://poetry.dctabudhabi.ae/diwan/poem/89643","المتقارب"]],"verses":[["وَيَغدو ماتِحاً لِلضَ","رِعِ الواني بِسَجلَينِ",0,"ن",1,0],["وَيَغدو رَهَجُ الرَوعِ","لِحاماً بَينَ غارَينا",1,"ن",2,0],["وَيَغدو لِمَن يُروي جَنابَكَ مُروِياً","زُلالا وَلِلأَعداءِ دونَكَ مُصعِقا",2,"ق",2,0],["وَيَغتَدي بَعدَ عِراكِ السُرى","يُعارِضُ الرَكبَ بِوَجهٍ طَليق",3,"ق",1,0],["وَيَغضَبونَ إِذا عاطَيتَهُم هِمَماً","مُرَفَّهاتٍ وَهَمّاً غَيرَ مَكدودِ",4,"د",1,0],["وَيَغشى الوَغى وَاليَومُ قانٍ أَديمُهُ","بَعَضبٍ لَهُ مِن هامَةِ البَطَلِ الغِمدُ",5,"د",1,0],["وَيَغْشَى غِماراً يُتَّقَى دُونَها الرَّدَى","فَإِنْ هُوَ أَوْدَى قيلَ للهِ دَرُّهُ",6,"ر",2,0],["ويُغْرونَهُ بيَ والإباءُ سجيّتي","إذا خوّفوني ضَلّةً سَطَواتِهِ",7,"ت",2,0],["ويُغْشى ذَراهُ حينَ يُسْتَعْتَمُ القِرى","ويَسْمو إليهِ الطّارِقُ المُتَنوِّرُ",8,"ر",1,0],["ويُغْضي منْ تَكَرُّمِهِ حَياءً","ودونَ إبائِهِ سَطَواتُ أُسْدِ",9,"د",1,0],["ويَغُرُّنا لَمْعُ السّرابِ فنَغْتَدي","في غَفْلَةٍ عنْ هادِمِ اللّذّاتِ",10,"ت",1,0],["وَيَغُضُّ مِنْ فَرْطِ الْحَيَاءِ جُفُونَهُ","مِنْ سُوءِ مَا قَدْ جَاءَهُ وَأَتَى بِهِ",11,"ب",2,0],["وَيُغالُ ضَيفُكَ وَاِبنُ أُخ","تِكَ وَهوَ عَن مِصرٍ غَريب",12,"ب",1,0],["وَيُغرى بِتَوكيدِ الإِساءَةِ مُذنِبٌ","فَيَلقاكَ بِالإِحسانِ أَغرى وَأَولَعا",13,"ع",2,0],["وَيَغمُرُنا إِذا نَحنُ اِلتَقَينا","بِطامي الموجِ مُضطَرِبِ الحَبابِ",14,"ب",1,0],["ويغضي عن العوراء إغضاء قادرٍ","ويرجحُ في الحِلم الجبالَ الرواسيا",15,"ي",2,0],["وَيَغتابُني مَن لَو كَفانِيَ غَيبَهُ","لَكُنتُ لَهُ العَينَ البَصيرَةَ وَالأُذنا",16,"ن",2,1],["ويغتدِي فكرهُ المكدودُ في حرَقٍ","وقد أحاطت بما قالَ البرودات",17,"ت",1,0],["ويغني عن الأنواء في الشامِ عدلُهُ","وعدل الفتى للخصبِ نعم المزارع",18,"ع",1,0],["ويغني عن الأمداح مشهور فضلها","وما الصبح محتاجٌ إلى الوصفِ والحلى",19,"ل",2,0],["ويغفر للهافين غيرَ مُقصِّرٍ","ولا جاهلٍ ما قد أتوا حين يغفرُ",20,"ر",1,1],["ويغضب اللَّه والسبع الطِّباق له","وساكنوهنّ والأبرار والسور",21,"ر",1,0],["وَيَغلِبُ نَفسي الحُزنُ عِندَ رَحيلِها","كَما تَحزَنُ الأَزهارُ زايَلَها النَدى",22,"د",2,0],["وَيَغوصُ فيهِ خَيالُها فَيَلفُّهُ","وَيَشِفُّ فَهوَ المُنطَوي المَنثورُ",23,"ر",1,0],["وَيَغدو النورُ جِلبابُكِ في الغابِ وَجِلبابي","فَكَم نُصغي إِلى الناسِ وَنُعصي خالِقَ الناسِ",24,"س",1,0],["وَيَغيبُ عَنّي طَودُها وَقِبابُها","وَقُصورُها خَلفَ الفَضاءِ الأَزرَقِ",25,"ق",1,0],["وَيَغتَسِلُ الذِئبُ الأَثيمُ بِمائِهِ","فَلا إِثمُ ذا يُمحى وَلا طُهرُ ذا يَبلى",26,"ل",2,0],["وَيَغُطُ تِبرُ الأَرضِ فيكَ تُرابَها","وَيَحسُدُ ماءَ الجَفنِ ماءُ الخزَريرِ",27,"ر",1,0],["وَيَغيبُ القَومُ في المَج","لِسِ وَالقَومُ حُضورُ",28,"ر",1,0],["ويغْمُرُ روحِي ضِياءٌ رَفيقٌ","تُكلِّلهُ رائعاتُ الورودْ",29,"د",1,0],["ويغرِّدُ الشُّحرورُ مَا","بَيْنَ الجَماجِمِ والرّفاتْ",30,"ت",1,0],["ويغنِّي الصَّباحُ أُنشودَةَ الحبِّ","على مَسْمَعِ الشَّبابِ السَّعيدِ",31,"د",1,0],["ويغبرُّ فرعٌ كجنْحِ الظَّلامِ","أنيقُ الغدائرِ جَعْدٌ مَديدْ",32,"د",1,0],["ويغسل ادران السياسة كلها","من الارض كل الارض شيء هو الدم",33,"م",1,0],["وَيُغلِظُ الأَيمانَ لِلدُيوكِ","لِما عَسى يَبقى مِنَ الشُكوكِ",34,"ك",1,0],["وَيُغشى اللَيثُ في الغاباتِ ظُهراً","وَكانَت لا تَقَرُّ بِها الحَصاةُ",35,"ه",1,0],["وَيَغشى الدُنا مِن حُلاها سَنىً","أَضاءَ لَنا كُلَّ حالٍ نَضيد",36,"د",1,0],["ويغشاهما ثَوْبٌ رقيبٌ سَداؤُهُ","رقيقُ الحواشي مِنْ نَسيجِ العناكبِ",37,"ب",1,0],["وَيُغنيكَ عَمّا يَنسُبُ الناسُ أَنَّهُ","إِلَيكَ تَناهى المَكرُماتُ وَتُنسَبُ",38,"ب",1,0],["ويُغنيهِ عنها الرأيُ ما ظنَّ صائبٌ","وما همَّ محتومٌ وما حَزَّ مقطعُ",39,"ع",1,0],["وَيَغدو عَلَيكُم وَهوَ كاتِبُ نَفسِهِ","وَنِعمَتُهُ تَغدو عَلى أَلفِ كاتِبِ",40,"ب",1,0],["وَيَغتَدي في صَلاحِ شَأنِهِمِ","لِسانُهُ المُكتَفى بِهِ وَيَدُه",41,"د",2,0],["وَيُغِلُّها قَومٌ وَأُعطي خَرجَها","حُكمٌ لَعَمرِكَ غَيرُ عَدلٍ ظاهِرِ",42,"ر",1,0],["وَيَغدو وَيَعقُبُ اِبنُهُ مُتَرَسِّلٌ","يُزانيهِ في أَولادِهِ وَيُلاوِطُه",43,"ط",2,0],["وَيُغضِبُكَ السُكوتُ إِذا سَكَتنا","وَبَعضُ القَومِ يُغضِبُهُ السُؤالُ",44,"ل",1,0],["وَيَغدو وَنَجدَتُهُ في الوَغى","تُدَرِّبُ نَجداتِ فُرسانِهِ",45,"ن",2,0],["ويَغمِزُ كفِّيَ كَفَّ النَّديمِ","ويُومِضُ طَرفي إلى السَّاقِيه",46,"ي",2,0],["ويغري القميص بها سترة","فيظهرها الشكر من ستره",47,"ر",2,0],["وَيَغتَني بِالمُلدِ مِن سُمرِ القَنا","عَن كُلِّ مَجدولِ القَوامِ أَملَدِ",48,"د",1,0],["وَيَغدو يَستَثيبُ بِلا نَوالٍ","وَنَيلُكَ كُلُّهُ لا لِلثَوابِ",49,"ب",1,0],["وَيَغفُلُ ذا الناسُ عَن لَهوِنا","وَنَسمُرُهُ كُلَّهُ مُقمِرا",50,"ر",2,0],["وَيَغشى النَدِيَّ بِخُلقٍ نَدٍ","تَرى الماءَ يَجري بِهِ مِن عَلَم",51,"م",1,0],["ويغضبُ أن يكونَ لها لسانٌ","يُذيعُ شكَاتَها في المُشْتكينا",52,"ن",2,0],["وَيُغنِينِي عَنِ الأهل انتِصَابِي","لِخِدمته ونائِلِهِ الجَزِيل",53,"ل",1,0],["وَيُغَرِّدُ المُكّاءُ في صَحرائِهِ","طَرَباً لِتَرنيحٍ مِنَ النَشَواتِ",54,"ت",1,0],["وَيَغُضُّ مِنْ مَغْسُولَتَيْنِ بِدَمْعِهِ","مَكْحُولَتَيْنِ مِنَ الظَّلامِ بإثْمِدِ",55,"د",1,0],["ويُغْمِدُ في هامِ الملوكِ حُسامَهُ","ويَرْهَبُ منْ هامِ المُلوكِ غَفيرُ",56,"ر",1,0],["وَيُغنيها عَنِ المُرجا","نِ أَن تَتَقَلَّدَ البَعرا",57,"ر",2,0],["وَيَغشى نارَها وَيَكونُ فيها","كَريمَ الفَتكِ كَرّاراً يُحامي",58,"م",2,0],["وَيَغدو بِأَخلاقِ المُهَلَّبِ مولَعاً","كَما شَمَّرَت عَن ساقِها الحَربُ تَطرَبُ",59,"ب",1,0],["وَيَغتَفِرُ الغِنى وَخَطّاً بِرَأسٍ","إِذا كانَت قِواكَ مُسَلَّماتِ",60,"ت",1,0],["وَيَغبِرُ في الأَيّامِ مَن طالَ عُمرُهُ","فَتَغبَرُّ مِن طولِ البَقاءِ المَفارِقُ",61,"ق",1,0],["وَيُغنيكَ عَن طَرحِ فالٍ تَعو","دُ بِاليُمنِ طَعنُكَ في الفائِلِ",62,"ل",1,0],["وَيَغمُزُ مِنهُ الفائِقَينِ كِلَيهِما","عَلى شَهوَةٍ غَمزَ الطَبِيبِ المُحَنجِرا",63,"ر",2,0],["وَيغضي خلال النظرتين محاذراً","رقيباً لها إن لم يكده يكيدها",64,"د",3,0],["ويغيرني جذب الذمام لقلبها","فمها إليك كطالبٍ تقبيلا",65,"ل",2,0],["ويغشى السماءَ الجهمُ من كلِّ ديمةٍ","تخدِّد وجه الأرضِ من عبراتِها",66,"ت",3,0],["ويَغْبِقُ أهْلَهُ لبَنَ الصّفايا","ويَمْنَحُ قَوْتَ مُهْجَتِهِ الجَوادا",67,"د",2,0],["ويُغَنِّيني فأنسى","في مَسَرَّاتِ غِنَاهْ",68,"ا",2,0],["وَيَغْفِرُ لِلخِدْنِ المُجَافِي جَفَاءَهُ","وَلَوْ أَنَّ ذَاكَ الخِدْنُ لِلفَضْلِ جَاحِد",69,"د",1,0],["وَيُغْرِبُ فِي فَعَائِلِهِ فَتأَتِي","رَوَائِعَ فِي التَّفَرُّدِ وَالسِّيَاقِ",70,"ق",1,0],["ويغنى المكاء في شاطئيها","يستخف النهى فحلت حباها",71,"ا",3,0],["ويَغِيضُ ماءٌ كانَ أيْسَرُ قَطْرةٍ","مِنهُ حَيَاةَ خَلاَئِقٍ وبِلادِ",72,"د",1,0],["ويُغَنُّونَ باسمِها مثلَ ما غَنَّى","زُهَيْرٌ بِسِيرَةِ ابْنِ سِنانِ",73,"ن",1,0],["ويغنم أهل (النهروان) شهادة","وما هي الا طعنة فالمغانم",74,"م",1,0],["ويغصُّ من فرط الحياء جفونَه","من سوء ما قد جاءَهُ وأتى بهِ",75,"ب",2,0],["ويغشى على الظلم أبراجه","فيزري به وبما شيذدا",76,"د",2,0],["ويغطّي بالتاج رأسا خلايباه","وأفكاره ذئاب حوائم",77,"م",1,0],["ويغالِطانِ النَومَ عنك","بطَيِفك المَرحِ الطَروب",78,"ب",1,0],["ويَغْدُو ويَعْقُوبُ اْبنُهُ مُتَرَسُّلٌ","يُزَانِيهِ في أولاَدِهِ ويُلاَوِطُهْ",79,"ط",2,0],["ويغتسل الذئب الأثيم بمسائه","فلا إثم ذا يمحي ، ولا طهر ذا يبلى!",80,"ل",2,0],["ويغلب نفسي الحزن رحيلها","كما تحزن الأزهار زايلها الندى",81,"د",2,0],["ويغوص فيه خيالها فيلفه","ويشفّ فهو المنطوي المنشور",82,"ر",1,0],["ويغفو لها التاريخ . حتّى ترجّه","بداهية صلب القناة أريب",83,"ب",1,0],["ويغضب أحيانا ويرضى وحسبنا","من الصفو أن يرضى علينا ويغضبا",84,"ب",2,0],["ويغيب لكن لا يغيب وحقه","ما زال باصرة القلوب تراه",85,"ا",2,0],["ويغشَاهم عذابٌ من حميم","يُصَبُّ عليهمُ صبّاً كبيرَا",86,"ر",2,0],["وَيُغَنّي الشِعرَ يَنظِمُهُ","سَيِّدُ القَومِ الَّذي فَلَجا",87,"ج",2,0],["ويَغشَون قَرْما من لؤىّ بن غالبٍ","يعدِّد في أنسابه كلَّ قِنعاسِ",88,"س",1,0],["وَيَغرَقُ جودُهُمُ في نَداهُ","كَما غَرِقَت في الأَتِيِّ الغُدُر",89,"ر",1,0],["ويغفل عنه وهو منتبه له","ويطلب هذا الشر أعظم به شرّا",90,"ر",2,0],["ويغفر الله تعالى ذنبه","لو كان كالتراب وقطرَ المطرِ",91,"ر",1,0],["ويغليهم حظ النفوس فبينما","تراهم معي إذ هم علي وهم ألبُ",92,"ب",1,0],["ويغرُّ منك بعد مطاره","فينامُ عنك ولستَ بالوسنانِ",93,"ن",1,0],["ويغلب أقواما عليه تغلبوا","ويقتلهم في الحزن طورا وفي السهل",94,"ل",1,0],["ويغفر لا ذنب المنازع في العلا","ويظلم لا غير العدو المحارب",95,"ب",1,0],["وَيَغرُّكُم بَرقُ المُنى","جَهلاً وَلَيلُ اليَأسِ دامِسْ",96,"س",1,0],["وَيغفِرُ دونَ الشركِ ما شاء منّةً","وَلا يجدُ الكفّارُ مِن فضلهِ غفرا",97,"ر",2,0],["ويغالي في بديع","طاب في طي ونشر",98,"ر",1,0],["ويَغُضْي بعينيه على العُهر والقذى","ويَرْتَكِبُ الزّلاتِ والذِكرُ حائِلُ",99,"ل",1,0],["وَيغْفِرُ مولانا جميعاً ذنوبَنا","وفي غُرفِ الحَنَّاتِ نعلو ونَطْلَعُ",100,"ع",1,0],["ويغطي الأناء وهو خلاء","ثم يأتيك منه بالثعبان",101,"ن",1,0],["وَيَغيمُ الوادي وَيَشهَقُ في الأَب","عادِ رَسمُ الخَمائِلِ المَحلولُ",102,"ل",1,0],["ويَغبطُ ذلك الصُدغَ المُفَدّى","على إرغامِ كفِّ الضارِبينا",103,"ن",2,0],["ويغوص تحت الماء إن هَمَّ الدّجى","بورود خوفٍ للرقيب المبصر",104,"ر",1,0],["وَيُغالي مُخاطِراً في هَوى السو","دَدِ وَالمَجدِ بِالنَفيسِ الخَطيرِ",105,"ر",1,0],["وَيَغضَبُ لي غَضبَةً مُرّةً","يَعودُ بِها المُصلِحَ المُفسِدُ",106,"د",1,0],["وَيغُرُّكَ الضَعفُ الَّذي في جَفنه","وَالسَيفُ يَقطَعُ نَصلُهُ لا غِمدُهُ",107,"د",2,0],["ويغدو كما قد راح مكتسباً سنا","قبولٍ يراه كلُّ غادٍ ورائح",108,"ح",1,0],["ويغلبنا فيها الرجاء واننا","نؤمل ما يعيي به المتأمل",109,"ل",1,0],["ويغريك ان ابصرت طائفة الهوى","على صنم كالجاهلية عكفا",110,"ف",2,0],["ويغرب في كسب المحامد والعلا","وناسب فيه الحسن حسن التناسب",111,"ب",1,0],["وَيَغْبِطُنِي فِي سَكْبِ أدْمُعِي الحَيا","وَتَحْسِدُنِي في نَدْبِ أربُعِيَ الورقُ",112,"ق",1,0],["وَيُغْرِي بِي الْحِمامَ أَخُو سَماحٍ","بِهِ عَنْ مُهْجَتِي دُفِعَ الْحِمامُ",113,"م",1,0],["وَيُغْنِكَ عَنْ حَفْرِ الْخَنادِقِ مِثْلُها","مِنَ الضَّرْبِ إِمَّا قامَ لِلْحَرْبِ سُوقُها",114,"ق",3,0],["وَيُغنيهِ عَمّا في الكِتابَةِ طَرفُهُ","عَلى طِرفِهِ وَالشوسُ في الحَربِ تَرتَمي",115,"م",2,0],["وَيُغنيهِ عَمّا في الكنانَةِ لَحظُهُ","فَما هُوَ يَوماً لِلكَنانَةِ ناثِلُ",116,"ل",1,0],["ويغلب النظم ألفاظاً يفوه بها","فما يكلمني إلا بميزان",117,"ن",1,0],["وَيغبط فيهِ السمع والقلب أَعينا","نَفسنَ على الأفواهِ في كفّه القربا",118,"ب",2,0],["ويغنّي الكون ما","شاء له موهوب فنّ",119,"ن",1,0],["ويغذو الترابُ أباطيلهم","فتسخر منهم ألوهيّتي",120,"ي",1,0],["ويُغمض عينيه عما يكون","إذا اعتصرت جسمه اليابسه",120,"ه",1,0],["ويغنيني على رغم الليالي","لحن حب مر بي في لحظات",121,"ت",1,0],["وَيَغُرُّ غَرَّ الناقِلينَ بِنَشرِهِ","عَنكَ وَعَن سِواكَ يُحَدِّثُ",122,"ث",1,0],["ويُغيبُ الشّمسَ في نَقعهمْ","مَرَحُ الخيلِ وتَجريرُ الرُّدَيْني",123,"ن",2,0],["ويَغْلِبُ جَهْلَ الجاهِلين بحِلْمِهِ","ولا طِبَّ حتّى يُدفَعَ الضِّدُّ بالضِدّ",124,"د",1,0],["ويَغْدو لساناً نائباً عن لسانِه","فيُصدِرُ عنه ما يشاءُ ويُورِد",125,"د",1,0],["ويَغضَبُ الدَّهرُ ممَّا","أقولُه ويَشيطُ",126,"ط",1,0],["وَيَغرّهُ الصَبر المُحا","ول وَهُوَ آل يَلمَع",127,"ع",1,0],["وَيَغيم طَرفي بِالدُموع إِذا بَدا","مَع أَنَّهُ يَجلو مِن المقل القَذا",128,"ذ",2,0],["ويغفر أوزارنا الجم","ياغافر الذنب ياالله",129,"ه",1,0],["ويغفر لنا ولوالدينا وأهلنا","وأولادنا والأقر بين وذي الود",130,"د",1,0],["ويغفر لي ويرحني","ويحرسني من السلب",131,"ب",1,0],["وَيَغيبُ طالِعُها كَدُرٍ قَد وَهى","مِن سِلكِ غانيةٍ مَشَت بِتَدَلُّل",132,"ل",1,0],["ويغنّي للموت أجمل ألحا","ن هواه تحت الدجى والضياء",133,"ا",2,0],["ويغيرني التبان عند عناق","أردافه فهو العدو الأزرق",134,"ق",1,0],["ويُغْلِقٌ بابَ الهَمِّ دونَ مشاعِري","ويفتحُ لي نحو السعادةِ بابا",135,"ب",2,0],["ويُغني عن البيضِ الصَّوارمِ والقنا","بأبْيَضَ من آرائِه غيرِ مُغْمَدِ",136,"د",1,0],["ويغشاه طلاب القراءة والقرى","فيقري على كل المعاني من يقري",137,"ر",2,0],["ويغنيني عن الأَنصار مولًى","نصيري حين يخذلني نصيري",138,"ر",2,0],["ويغتَدِي عند كُلِّ نازِلَةٍ","غَوْثَ صريخٍ وغَيْثَ مَصْدودِ",139,"د",1,0],["ويُغْني عيونَ المُجْتَدين وعيشُهُمْ","بنضْرتِه مملوءة ونُضارِه",140,"ر",2,0],["ويغني عمرو بن بانة والطب","ل عليه سلمان يبدي اقتداره",141,"ر",2,0],["ويغضب الماء حينا في تبجّحها","فيستثار كموج فوق أنواء",142,"ا",2,0],["ويُغرِي بإفقاري وأنت الذي ترى","لمثلِيَ أن يغنىَ وأن يتموَّلا",143,"ل",2,0],["ويَغنَى ثم يُفقِرُ راحتيه","مقالُ المادحين الفقرُ جودُ",144,"د",1,0],["ويغبرُّ الشتاء ومنه يُرجى","نمو الروض أو رِيُّ الصَّوادي",145,"د",2,0],["ويُغضي وقد أعطى الجزيل كأنهُ","لا شِفاقهِ من عتب عافيهِ باخِلُ",146,"ل",1,0],["ويُغني إِذا ما أسعد الوجدُ جوده","فانْ هو لم يُسعده راحَ مواسيا",147,"ي",2,0],["ويغلظُ في المُلْتقى للكَماةِ","وفيه لدى السَّلم لُطفٌ وحِنَّهْ",148,"ه",1,0],["ويغْدو لنا بأسُه والنَّدى","من الجَوْر والفقر حِصْناً وجُنَّه",148,"ه",1,0],["ويغفرُ أعلى الجرم طبْعيُّ حلْمه","اذا زانَ أخلاقَ الرجالِ التَحَلُّم",149,"م",1,0],["ويغدو نسيماً ساجياً في ودادهِ","فان هِجْتَه كان الوشيكَ السَّرعرعا",150,"ع",2,0],["ويغدو شَمْألاً لَطُفتْ نَسيماً","ولكن نَقْعُهُ نَقْعُ النُّعامى",151,"م",2,0],["ويغضضن عن كل المحارم أعيناً","ويمنعن عن عين الأجانب منظرا",152,"ر",2,0],["ويغتدي كل شعري فيك أجنحة","مرفرفات على الأنهار تغتسل!",153,"ل",1,0],["ويغدو وما بينَ الأضالِعِ جذوةٌ","على الشعرِ نظمي قد حشاها الأضالِعا",154,"ع",2,0],["ويغبط طرفي غيب سري لأنه","يراه على بعد كأنه حاضر",155,"ر",1,0],["ويغبطنا من كنا نغبط فخره","فتعكس الأضواء في كي أركان",156,"ن",1,0],["وَيَغصبُ شَمسَ الضُحي نورَها","مِنَ الخَيلِ ما تَبعَثُ الأَرجُلُ",157,"ل",1,0],["ويغرقكم من بحره فيض زاخر","تزيد على فيض البحار جداوله",158,"ل",2,0],["ويغرّني فأظنّ أنّي خالدٌ","ما طالَ أَو ما اِمتدّ من أعوامي",159,"م",2,0],["ويغرّني الإكثارُ من نَشَبٍ وما ال","إكثارُ إلّا أوَّلُ الإقلالِ",160,"ل",1,0],["ويُغضِي فَإِن عنّتْ لعينيهِ رِيبةٌ","نضا الحلم عَنه آنفاً مُتخامِطا",161,"ط",2,0],["وَيغفل عَن وَثَباتِ المنون","يَدعن الشّوى ويُصبن النّحورا",162,"ر",2,0],["ويغلبنا الحلم الذي في طباعنا","فنوسعه حلماً ويرفعه المجد",163,"د",1,0],["ويَغلِبُ كلَّ مقتَدِرٍ قديرٌ","ويعلو كلَّ ذي علمٍ عليمُ",164,"م",1,0],["ويُغْنيكَ لَفْظِي عن حُسَامٍ مُجرَّد","وتُغْنِيك كُتْبي عن خميسٍ عَرَمْرَم",165,"م",1,0],["وَيَغدو بِمِسحاحٍ كَأَنَّ عِظامَها","مَحاجِنُ أَعراها اللِحاءَ المُشَبِّحُ",166,"ح",1,0],["وَيُغلونَ السِباءَ إِذا لَقوهُ","بِرُبعِ الخَيلِ وَالشَولِ الحِقاقِ",167,"ق",1,0],["وَيَغدو به العَبدُ مُستَعليا","عَلى من يجودُ ومن يَفصِلُ",168,"ل",1,0]]}