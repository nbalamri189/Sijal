{"poems":[[55,"أيا مرحبا بالغيث تسري بروقه","https://www.aldiwan.net/poem30484.html","الطويل"],[60,"فلا تكثرن القول في غير وقته","https://www.aldiwan.net/poem30906.html","الطويل"],[83,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[131,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[285,"لك الخير قد أنحى علي زماني","https://www.aldiwan.net/poem60787.html","الطويل"],[287,"لئن كان وافى مصر فرعون وحده","https://www.aldiwan.net/poem32733.html","الطويل"],[520,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49591","الطويل"]],"verses":[["فَعَثراً لِأَعداءٍ رَموكَ وَلا لَعاً","وَنَهضاً عَلى رُغمِ العَدوُّ وَلا عَثرا",0,"ر",2,0],["فَعثرَتُهُ مَن فيهِ تَرمي بِرَأسِهِ","وَعَثرَتهِ بِالرِّجلِ تَبَرا عَل مَهلِ",1,"ل",1,0],["فعِث في الناسِ وَالجِنَّه","وَصُن قَلبي مِنَ المِحنَه",2,"ه",1,0],["فَعَثرَةِ مَولىً قَد نَعَشتُ وَأُسرَةٍ","كِرامٍ وَأَبطالٍ لَدى كُلِّ مَأزِقِ",3,"ق",1,0],["فَعَثْراً لِدَهْرٍ لاَ تَرى فِيهِ قَائلاً","لَعَاً لِفَتىً زَلَّتْ بِهِ الْقَدَمَانِ",4,"ن",1,0],["فَعثنونه لِلّؤمِ وَالخبثِ مَعدِنٌ","فَصَبَّ عَلَيهِ عاجِلاً رَبُّنا موسى",5,"س",2,0],["فعثرت مسعاه وأطفأت ناره","وعوقت مجرى سيله وهو خضرم",6,"م",1,0],["فعثرة الرجل يرجى أن تقال ولا","تقال عثرة من أبدى الذي اكتتما",7,"م",2,0],["فعِثتَ بأبكارِ الخطُوبِ وعُوْنِها","كما هزَّ أعطافَ الغصونِ نسيم",8,"م",1,0]]}