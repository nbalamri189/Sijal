{"poems":[[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[73,"جاء الشتاء وليس عندي فروة","https://www.aldiwan.net/poem3970.html","الكامل"],[90,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[31,"إني أبيت وهم المرء يعمده","https://www.aldiwan.net/poem6093.html","البسيط"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[64,"قالوا صبرت على المكروه من نفر","https://www.aldiwan.net/poem52427.html","البسيط"],[64,"مولاي أكرم من ألوذ بظله","https://www.aldiwan.net/poem52461.html","الكامل"],[30,"إني ابنُ حمال المئين غالب","https://www.aldiwan.net/poem1242.html",""],[60,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[52,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[48,"أهلا بغائلة الردى وإيابها","https://www.aldiwan.net/poem22352.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55132","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[131,"يا من لقلب شديد الهم محزون","https://www.aldiwan.net/poem24221.html","البسيط"],[147,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[286,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[382,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[406,"يا قبة المسجد الأقصى","https://www.aldiwan.net/poem6723.html","عموديه"],[409,"عذرا إلى مولاي عذرا","https://www.aldiwan.net/poem33927.html","مجزوء الكامل"],[417,"إنى أبى الله أن أموت","https://www.aldiwan.net/poem1851.html","عموديه"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[438,"إني أبثك حالي","https://www.aldiwan.net/poem12699.html","المجتث"],[519,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[533,"لله ما هاج لمع البارق الساري","https://www.aldiwan.net/poem2483.html","البسيط"],[563,"أصبحت أنا على مرادك","https://www.aldiwan.net/poem34271.html","مجزوء الدوبيت"],[591,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101537","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72307","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72296","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130634","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125477","الرمل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76632","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104824","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108460","الكامل"],[2122,"","https://poetry.dctabudhabi.ae/diwan/poem/198281","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60830","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21604","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113675","المجتث"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132719","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100822","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130051","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121425","الكامل"],[3306,"","https://poetry.dctabudhabi.ae/diwan/poem/147795",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88929","السريع"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108077","البسيط"],[3843,"","https://poetry.dctabudhabi.ae/diwan/poem/131372","البسيط"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44916","الكامل"],[4691,"أنياب البعد","https://www.poetsgate.com/ViewPoem.aspx?id=61411",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4858,"إليك ربّي","https://www.poetsgate.com/ViewPoem.aspx?id=155079",""],[4908,"عتاب الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=207417",""],[4929,"ملكة البيان","https://www.poetsgate.com/ViewPoem.aspx?id=208522",""],[4929,"خير الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=211958",""],[5010,"أمتنا والفتنة الحمقاء","https://www.poetsgate.com/ViewPoem.aspx?id=190371",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5213,"بلغت بك الروحاء في ذملانها","https://www.poetsgate.com/ViewPoem.aspx?id=170567",""],[5277,"قوارير بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=193638",""],[5277,"خيولٌ اًصائل","https://www.poetsgate.com/ViewPoem.aspx?id=213706",""],[5284,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=191791",""],[5355,"نعيٌ مُبارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=188456",""],[5376,"للقدس عين من الاشواق لم تنم","https://www.poetsgate.com/ViewPoem.aspx?id=188549",""],[5397,"تعجب الدهر من صبري ومن جلدي","https://www.poetsgate.com/ViewPoem.aspx?id=157958",""],[5449,"تبصُّر","https://www.poetsgate.com/ViewPoem.aspx?id=189166",""],[5565,"إني أبثّكَ سيّدي","https://www.poetsgate.com/ViewPoem.aspx?id=110221",""],[5595,"إنّ العراقَ أبيّ ٌ أينما ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=144531",""],[5674,"قلبك معبدي","https://www.poetsgate.com/ViewPoem.aspx?id=197554",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5736,"قنوط","https://www.poetsgate.com/ViewPoem.aspx?id=208402",""],[5770,"طار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178360",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5815,"تَكَهّفْ","https://www.poetsgate.com/ViewPoem.aspx?id=192613",""],[5823,"ليل الشباب سيورق","https://www.poetsgate.com/ViewPoem.aspx?id=61786",""],[5830,"إِنَّ الوَصْلَ يُحْيِيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=200823",""],[5956,"لله أكتب أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=192029",""],[6102,"زيفا الإسرائيلية","https://www.poetsgate.com/ViewPoem.aspx?id=184171",""],[6189,"قصيدة عن حب قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67119&r=&rc=4",""]],"verses":[["أَنّي أَبيتُ وَبَيني","وَبَينَ لُقياكِ سَهبُ",0,"ب",1,0],["إِنّي أَبيتُ عَلى الطَوى خاوي الحَشا","سَغَباً وَأَحناءُ الضُلوعِ تَقَعقَعُ",1,"ع",1,0],["إني ابتُليت بقوم يبعرَون على","أعقابهم وإذا عنّفتهم ثَلَطوا",2,"ط",3,0],["إِنّي اِبنُ حَنظَلَةَ الحِسانِ وُجوهُهُم","وَالأَعظَمينَ مَساعِياً وَجُدودا",3,"د",2,0],["إِنّي أَبيتُ قَليلَ النَومِ أَرَّقَني","قَلبٌ تَصارَعَ فيهِ الهَمُّ وَالهِمَمُ",4,"م",1,0],["إِنّي أَبى لي ذَلِكُم حَسَبي","وَمَقالَةٌ كَمَقالِعِ الصَخرِ",5,"ر",1,0],["إِنّي أَبيتُ وَهَمُّ المَرءِ يَعمِدُهُ","مِن أَوَّلِ اللَيلِ حَتّى يَبرَحَ السَفَرُ",6,"ر",1,1],["إِنّي أَبصَرتُ في الدَيرِ وُروداً في سِياجِ","قَنِعتُ بَعدَ النَدى الطاهِرِ بِالماءِ الأَجاجِ",7,"ج",1,0],["إنِّي أبَتْ ليَ أخلاقٌ مهذَّبةٌ","أنْ أُسْلِمَ الحلْمَ بينَ الحِقْدِ والضَّجَرِ",8,"ر",1,0],["إنِّي أبثُّكَ كُنْهَ حالي مُجمِلاً","ما بينَ تعريضٍ إِلى إفْصَاحِ",9,"ح",1,0],["إِنّي اِبنُ حَمّالِ المِئينَ غالِبِ","قَطَعتُ عَرضَ الدُوِّ غَيرَ راكِبِ",10,"ب",1,1],["إِنّي أَبوءُ بِعَثرَتي وَخَطيئَتي","هَرَباً إِلَيكَ وَلَيسَ دونَكَ مَهرَبُ",11,"ب",1,0],["أَنْيَابُهُمْ فِي ذَوِي الأَرْحَامِ نَاشِبَةٌ","وَلِلأَعَادِي اْبْتِسَامٌ يُظْهِرُ الدَّرَدَا",12,"د",2,0],["إِنّي أُبَشِّرُ نَفسي كُلَّما اِختَلَجَت","عَيني أَقولُ بِنَيلٍ مِنكِ تَختَلِجُ",13,"ج",1,0],["أَنيابُ جامِعَةِ السِمامِ فَمُ الَّتي","أَطغَت فَخِلتُ الراحَ في أَنيابِها",14,"ب",3,0],["إِنِّي أَبَاهِي سُرَاةَ الشَّرْقِ أَجْمَعَهُمْ","بِخَيْرِهِمْ فِي مَقَامَاتِ العُلَى رَجُلاَ",15,"ل",2,1],["إِنِّي أُبَالِي وَطَنِي أَصْدُقُهُ","وَمَا أُبَالِي لِلْوُشَاةِ نَقْدَا",16,"د",2,0],["إِنّي أَبِيُّ أَبِيٌّ ذو مَحافَظَةٍ","وَاِبنُ أَبِيٍّ أَبِيٍّ مِن أَبِيّينِ",17,"ن",1,0],["إِنّي أَبَيتُ وَغَيرُ بِدعٍ أَن أَبى","مَن في ذَراهُ أَن يُرى مَهضوما",18,"م",2,0],["إني ابتهجت به كما","ابتهج المؤمل بالأمل",19,"ل",1,0],["إني أبثُّك دعوةً","كانت لحتفي أقربا",20,"ب",2,0],["إنِّي أبجِّلُ هذا الشَّعبَ ، أحملهُ","في القلبِ حُبًّا وإحساساً وأشواقا",21,"ق",2,0],["إني أباسط من لقي","ت فلا تراني مزوئرا",22,"ر",2,0],["إنى أبى الله أن أموت وفي","صدري همٌ كأنه جبل",23,"ل",1,1],["إنِّي أباهي به الأشراف أجمعها","بذلك النسب العالي الَّذي حسب",24,"ب",1,0],["إني أبثُّكَ حالي","وما عليّ ومالي",25,"ل",2,1],["أنيابُ لَيثِ الغابِ من حُجّابهِ","ولواحظُ الحرباءِ من رُقَبائِهِ",26,"ا",3,0],["إِنِّي أَبا حَسَنٍ قَد ضِعتُ بَينَكُمُ","وَقَلَّ ما ضاعَ حُرٌّ بَينَ أَحرارِ",27,"ر",1,0],["إني أباد لك التجائي","ملقي أملي على جهادك",28,"ك",1,0],["إِنّي أَبُثُّكَ مِنْ شَرْحِ الهَوَى طُرَفاً","فَبَعْضُ أَيْسَره عِنْدِي لَهُ سِيَرُ",29,"ر",1,0],["اني ابيتُ مسهَّداً","واهي الجوانح والقوى",30,"ق",3,1],["اني ابن رزيك الذي بولائهم","اسخنت عين معاند وجهول",31,"ل",1,0],["اني ابن رزيك لو أن الورى صدفوا","عنكم وخصص بالدنيا لما صدفا",32,"ف",2,0],["إني ابن موسى عبدك القنُّ الذي","بك في الأنام أجُرُّ ذيْلَ تَبَختُر",33,"ر",1,0],["اني ابث اليك شكوى عاتب","لكن بالسنة الدموع رماها",34,"ا",3,0],["إني أبثك ما أجن على النوى","حتى كأنك ههنا لي مسعد",35,"د",1,0],["إني ابتكرت من المعادن آلة","سَمَّيتُها بالسلم الموسيقي",36,"ي",1,0],["إني ابن عمار لا أخفي على أحد","إلا على جاهل بالشمس والقمر",37,"ر",1,1],["إنِّى ابتُلِيتُ مِنَ الصِّبا","بِغَرَامِهِ قَلبى صَبا",38,"ب",2,0],["اني أب ذابت حشاشته أسى","وغدا لأنواع الهموم معانيا",39,"ي",2,0],["إني ابن عمك حقاً غير مؤتشب","إذا تساقط تحت الراية الورق",40,"ق",1,1],["إني أبا عُمَرٍ إليك لشيّقٌ","شوقَ العطاشِ إلى الزلال المبردا",41,"د",2,0],["إِنّي أَبى ليَ أَن أُقَصِّرَ والِدٌ","شَهمٌ عَلى الأَمرِ القَوي عَزومُ",42,"م",1,0],["إِنى أبثُّك حالاتى وتمنعنى","تلك السَّجايا الغوانى بثَّ حالاتى",43,"ت",2,0],["أَنّي اِبتُليتُ بِحَيَّةٍ ساوَرتُها","بِيَدٍ لَعَمري لَم تَكُن لي رابِحَه",44,"ح",2,0],["إني أبُثُّك حبًّا","حُبًّا يرى السِّلم حربا",45,"ب",2,1],["اني ابحت دمي عمداً فلا قود","عليهم في الهوى اني ابحت دمي",46,"م",2,0],["اني ابو بكر يراقب معشراً","مرقوا من الاسلام بالكفران",47,"ن",1,0],["إنّي أبشّركم بفوزٍ عاجلٍ","إن صار للفتيات شأنٌ يذكرُ",48,"ر",1,0],["إني إبثك من حديثي","والحديث له شجونُ",49,"ن",1,1],["أن يأبروا نخلاً، لغيرهم","والأمر تحقره، وقد ينمي",50,"م",2,0],["أنى ابتدأت أنى أستطيل","أهجو أخس الأنس أنى أميل",51,"ل",1,1],["إني أبلغ أهل العجم في سفري","من أجل حسنك إن الحسن في العرب",52,"ب",1,0],["إنّي ابنهم وهم أهلى ولست ترى","من البنين ولا الاهلين أكفانا",53,"ن",2,0],["إِني أَبِهتُ لِصَوتِكُم وَاجبتهُ","فَعَساكُمُ تَجدونَ غَيري آبِها",54,"ب",3,0],["أنياب بعدك ِ عنه تنهشه","وفم النوى للقلب يلتهمُ",55,"م",1,0],["إني أبٌ وكذاك أنت لأمةٍ","ترجو شفاعتنا بيوم القارعة",56,"ع",2,0],["إنّي ابتُليتُ بما قد راح يؤلمُني","إنّي ابتليتُ بما أوهى لي البَدَنا",57,"ن",2,0],["إني أبات أسير طيفك ساهراً","في غربةِ الأشجانِ أندبُ حظنا",58,"ن",2,0],["إنيْ أباري بك الدنيا بأكملِها","ولي بنطقِك فخرٌ يملأُ الأرضا",59,"ض",2,0],["أنيابُه بدمائِنا غُرِسَتْ","ولنبضِنا بحدوثِه فحوى",60,"و",2,0],["«إِنِّيْ أَبِيْتُ قَلِيْلَ النَّوْمِ أَرَّقَنِيْ»","رَجْفُ الْقَنَابِلِ وَالأَناتُ تَزْدَحِمُ",61,"م",1,1],["أنيابُ غولٍ بها البعيدُ جُنَّ ولم","يُجَنَّ متعبها بالهزِّ والخدَمِ",62,"م",1,0],["إنى ابوح بحبها ولو أن أب","ناء الغرام تموت من كتمانها",63,"ن",3,0],["إنّي إبتُليتُ بذات الحسنِ ساحرةً","منها وفيها..طغتْ في البوحِ نجواهُ",64,"ا",2,0],["إني أبَيتُ سوى الترحالِ عنْ وطنٍ","ما فيهِ للحبِّ إلا صولةُ الرعبِ",65,"ب",1,0],["إنِّي أَبِيْعُ عَلَى الدُّرُوْبِ مَوَاجِعِي","وَبِهَا اشْتَرَيْتُ مِنَ الزَّمَانِ مَصَائِبَهْ",66,"ب",2,0],["إنِّي أُبَارِكُ نَعْيَكمْ","أُمُّ العُرُوبَةِ والْعَرَبْ",67,"ب",1,0],["إني أبث رسول الله مدمعنا","ساد الظلام ببيت عاشه بسمي",68,"م",2,0],["إني أبيت من الدنيا كما أيست","آمال لقمان يبغي العمر من لبد",69,"د",1,0],["إنِّي أبيعُ قصائدي بمحبَّةٍ","قلْ للأحبَّةِ أينكم من يشتري",70,"ر",2,0],["إني أبثّكَ سيّدي","ما ليس يحملُه بشرْ",71,"ر",1,1],["أنيابُ شرّ ٍ قد غاصَتْ (بفكّتنا)","حتّى تغذ ّت من بئر ٍلهم حطبُ",72,"ب",1,0],["إني أبوح اليكِ صدق مشاعري","فتنفسي بعض الهوى كي تسعدي",73,"د",2,0],["إنّي ابْنُ هذي الأ رض ِ جَذريَ ضاربٌ","في عُمْقها وعلى جبيني الأ نْجُمُ",74,"م",1,0],["إنّي أبوءُ إليكَ تخشعُ مهجتي","من أيِّ ذنبٍ بالمذلةِ حفّني",75,"ن",2,0],["إني ابن ذاك الحيِّ من \"مُضَرٍ\"","وعلى الأباعرِ أشددُ القَتَبا",76,"ب",2,0],["أنيابُ ضَجيجٍ تقضمُهُ","فارتدّ النّابُ... وما أتْخَمْ",77,"م",1,0],["أنْيابُها أفْصَحَتْ عن بُغْضِها وبَدا","خُبْث النوايا بأشكالٍ منَ الفتَنِ",78,"ن",1,0],["أَنْيَابٌ تُوغِلُ في جَسَدي","تَسْقِينِي قَيْحَ الإعْصَارِ",79,"ر",1,0],["إنّي أبارك بالشّبابِ نقاءَهم","إنّي أراهم بالمكارم كرِّموا",80,"م",3,0],["إنِّي ابْتَدَأْتُ وَ حُبِّي لَيْسَ مُنْقَطِعٍ","فَمَا بَقَلْبِي سِوى حُبٍّ يُحَلِّيكِ",81,"ك",1,0],["إني ابنُ آوى أولَّي شارداً أبداً","بين البراري بأكل الدُّود والدّمنِ",82,"ن",1,0],["أَنَّى أُبَادِلْكِ المَشَاعِرَ يَخْلُ بِي","وَجَعُ الضَّمِيرِ ضُحَىً , وَ لَيلِيَ تَسْهِيدُ",83,"د",1,0],["أَنَّى أبيعك للظَّلام ، وِلِلْخَنَا","ضِدان ليلٌ أليلٌ وشروقُ",84,"ق",1,0]]}