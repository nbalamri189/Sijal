ارب"],[46,"سألت عن الأجيال في كل برهة","https://www.aldiwan.net/poem23049.html","الطويل"],[46,"ألا يا جون ماوفقت","https://www.aldiwan.net/poem23109.html","الهزج"],[46,"حديث على العالمين التبك","https://www.aldiwan.net/poem23114.html","المتقارب"],[46,"إذا صقلت دنياك مرآة عقلها","https://www.aldiwan.net/poem23215.html","الطويل"],[46,"توهمت خيرا في الزمان وأهله","https://www.aldiwan.net/poem23288.html","الطويل"],[46,"هل يأمن الفتيان الخطب آونة","https://www.aldiwan.net/poem23393.html","البسيط"],[46,"أرى فتيي دنياك إن حرج الفتى","https://www.aldiwan.net/poem23511.html","الطويل"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[46,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141034",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/15473","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21045","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55185","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54829","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2268","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[77,"تَعالَوْا بنا نُعْطِ الصّبابة حقّها","https://www.poetsgate.com/ViewPoem.aspx?id=33197",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[57,"توكلت في رزقي على الله خالقي","https://www.poetsgate.com/ViewPoem.aspx?id=3312",""],[33,"أيَا وَيْحَ مَنْ أمسَى يُخَلَّسُ عَقْلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=2588",""],[45,"لأَيَّةِ حالٍ أَعْلَنَ الوَجْدَ كاتِمُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32082",""],[45,"كَمْ من وُقُوفٍ على الأطلال وَالدِّمَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=32011",""],[45,"سألْتُكَ بالكُميتيّ الصّغيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31272",""],[80,"أيا خلجَ المدامع لا تغيضي","https://www.poetsgate.com/ViewPoem.aspx?id=3337",""],[28,"إن الذي أعطى الرجال حظوظهم","https://www.poetsgate.com/ViewPoem.aspx?id=20005",""],[51,"مطايبُ عيشٍ زايلتْهُ مخابِثُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=27263",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[32,"على الدار التي لبست بلاها","https://www.poetsgate.com/ViewPoem.aspx?id=126",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[105,"يهين رجال في الحياة نفوسهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54927&r=&rc=97",""],[29,"لعَمْري، لقد أسريتُ، لا لَيْلَ عاجزٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17429&r=&rc=2",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["وَما يَنفَعُنا يَوماً","إِذا نَحنُ تَفادَينا",0,"ن",2,0],["وَما يَغتَرُّ بِالدُنيا لَبيبٌ","يَفِرُّ مِنَ الحَياةِ إِلى الحِمامِ",1,"م",1,0],["وَما يُثقِلُ المَيتَ الصَعيدُ وَإِنَّما","عَلى الحَيِّ عِبءٌ لِلزَمانِ ثَقيلُ",2,"ل",1,0],["وَما يُستَفادُ العِزِّ مِن شَيمَةِ الفَتى","إِذا كانَ في دينِ المَعالي مُقَلِّدا",3,"د",2,0],["وَمائِلَةٍ أَقَمتَ لَها كُعوباً","وَقَد شَغَرَت عَلى القَومِ اِعوِجاجا",4,"ج",2,0],["وَما يَعلَمُ الإِنسانُ في أَيَّ جانِبٍ","مِنَ الأَرضِ يَأوي مِنهُ في التُربِ جانِبُ",5,"ب",1,0],["وَما يُنقِصُ الثَلمُ في المَضرِبَينِ","إِذا اِهتَزَّ في القائِمِ القاضِبُ",6,"ب",1,0],["وَما يُغني مُضِيُّكَ في صُعودٍ","إِذا ما كانَ جَدُّكَ في صُبوبِ",7,"ب",1,0],["وَما يَبلُغُ الأَعداءُ مِنّي بِفَتكَةٍ","وَدوني فِناءٌ لِلأَميرِ وَبابُ",8,"ب",1,0],["وَما يُنجي مِنَ الأَيّامِ فَوتٌ","وَلا كَدٌّ يَطولُ وَلا عَناءُ",9,"ا",2,0],["وَما يُنجي مِنَ الغَمَراتِ إِلّا","ضِرابٌ أَو طِعانٌ أَو رِماءُ",9,"ا",2,0],["وَما يَعلو عَلى قُلَلِ المَعالي","أَحَقُّ مِنَ المُعَرِّقِ في العَلاءِ",10,"ا",2,0],["وَما يُنجي اللَديغَ بِهِ تَداوٍ","وَقَد أَمسى بِداءٍ أَيِّ داءِ",10,"ا",2,0],["وَما يُدريكِ وَالأَيّا","مُ في تَصريفِها عِبَرُ",11,"ر",1,0],["وَما يُرى في وِصالِ اِثنَينِ قَد شُغِفا","ما لَم يَميلا إِلى الفَحشاءِ مِن عارِ",12,"ر",1,0],["وَما يَزالُ نِساءٌ مِن قَرابَتِها","مِن كُلِّ ناحِيَةٍ يَهتِكَنَ أَستاري",12,"ي",1,0],["وَما يَكُ مِن رِزقي فَلَيسَ يَفوتَني","وَلَو كانَ في قاعِ البِحارِ العَوامِقِ",13,"ق",1,0],["وَما يَبقى الصَديقُ بِكلِّ عَصرٍ","وَلا الإِخوانُ إِلّا لِلتَآسي",14,"س",2,0],["وَمَا يَفْتَأ الشَّوْقُ الْمُقِيمُ بِأضْلُعِي","إِذَا حِدْتُ عَنْ طَوْقِ الصَّبَابَةَ أَفْتَانِي",15,"ي",1,0],["وَمَا يَبْقَى سِوَى فِعْلٍ جَمِيلٍ","وَحَالُ الدَّهْرِ لاَ تَبْقَى بِحَالِ",16,"ل",1,0],["وما يُثْمِرُ البُرْهانُ إلا لَجاجةً","إذا لَقيَتْ أنْوارُهُ أعيُناً رُمْدا",17,"د",2,0],["وَما يَستوي قَرنُ النِطاحِ الَّذي بِهِ","تَنوءُ وَقَرنٌ كُلَّما نُؤتَ مائِلُ",18,"ل",1,0],["وَما يَكُ مِنّي قَد أَتاكَ فَإِنَّهُ","عِتابٌ أَبا مَروانَ وَالقَلبُ سادِكُ",19,"ك",1,0],["وَما يَمنَعونَ الماءَ إِلّا ضَنانَةً","بِأَصلابِ عُسرى شَوكُها قَد تَخَدَّدا",20,"د",2,0],["وَما يَبكونَ مِثلَ أَخي وَلَكِن","أُعَزّي النَفسَ عَنهُ بِالتَأَسّي",21,"ي",1,0],["وَمَا يُوَثِّقُ عَهْداً فِي أَوَاصِرِه","كَمَا يُوَثِّقُهُ بِالوُدِّ قَلْبَانِ",22,"ن",1,0],["وَمَا يَكُونُونَ إِذَا هُذِّبُوا","تَهْذِيبَ رِفْقٍ وَإِذَا قوِّمُوا",23,"م",3,0],["وَمَا يَغُضُّ عَنِ المَلْهُوفِ نَاظِرَهُ","وَمَا بِهِ عَنْ نِدَاءِ المُعْتَفِي صَمَمُ",24,"م",1,0],["وَمَا يُسَرُّ بِغَيْرِ الْفَوْزِ يُدْرِكُهُ","وَمَا يَقَرُّ وَحَقُّ الشَّعْبِ مُهْتَضَمُ",24,"م",1,0],["وَمَا يُكَافِحُ إِلاَّ البُؤْسَ حَيْثُ بَدَا","وَمَا يُنَافِحُ إِلاَّ الشَّكْلَ وَاليُتُمَا",25,"م",2,0],["وَما يُغرِبونَ الضِحكَ إِلّا تَبَسُّماً","وَلا يَنبِسونَ القَولَ إِلّا تَناجِيا",26,"ي",2,0],["وَما يَومُ حُزوى إِن بَكَيتُ صَبابَةً","لِعِرفانِ رَبعٍ أَو لِعِرفانِ مَنزِلِ",27,"ل",1,0],["وَما يَومُ خَرقاءَ الّذي نَلتَقي بِهِ","بِنَحسٍ عَلى عَيني وَلا مُتَطاوِلِ",28,"ل",1,0],["وَما يَرجِعُ الوَجدُ الزَمانَ الَّذي مَضى","وَلا لِلفَتى مِن دِمنَةِ الدارِ مَجزَعُ",29,"ع",1,0],["وَما يَسفَحُ العَينَينِ مِن رَسمِ دِمنَةٍ","عَفَتها اللَيالي نَحسُها وَسُعودُها",30,"د",3,0],["وما يستوي والعلم لله وحده","عليم بأعقاب الأمور وجاهلُ",31,"ل",1,0],["وما يُخذ الطليان بالذنب وحدهم","ولكن جميع الغَرب يؤخذ بالذنب",32,"ب",1,0],["وما يُرتَجَى من حياة امرىءٍ","كماءٍ على سَبْخة راكد",33,"د",1,0],["وما ينفع الشعر الذي أنا قائل","إذا لم أكن للقوم في النفع ساعيا",34,"ي",2,0],["وما ينفع القول الذي أنت قائل","إذا لم يكن بالفعل منك يؤيَّد",35,"د",1,0],["وما يجدي افتخارُك بالأوالي","إذا لم تفتخر فخراً جديدا",36,"د",2,0],["وَما يَحمَدُ الرَضيافُ رِفدَ مُجاشِعٍ","إِذا رَوَّحَت حَنانَةُ الريحِ حَرجَفُ",37,"ف",1,0],["وَما يَخفى عَلَيكَ شَرابُ حَدٍّ","وَلا وَرهاءُ غائِبَةُ الحَليلِ",38,"ل",1,0],["وَما يَكُ مِن شَيءٍ فَقَد رُعتَ رَوعَةً","أَبا مالِكٍ تَبيَضُّ مِنها الغَدائِرُ",39,"ر",1,0],["وَما يَدري عُبَيدُ بَني أُقَيشٍ","أَيوضِعُ بِالحَمائِلِ أَم يُميلُ",40,"ل",1,1],["وَما يُغنيكَ مِن هِمَمٍ طِوالٍ","إِذا قُرِنَت بِأَعمارٍ قِصارِ",41,"ر",1,0],["وَما يَجعَلُ العَيَّ وَسطَ النَدِي","يِ كَالمَحرَبِ المِصقَعِ الشاعِرِ",42,"ر",1,0],["وما يَضع المرءَ الشرِيفَ امتداحُهُ","علاءً ولا يُحذيه غيرُ علاءِ",43,"ا",2,0],["وما يُريغون بالنُّعمى مكافأةً","لكن يُقَضُّون ما للمجد من أرَبِ",44,"ب",1,0],["وما ينحو بك العافون إلّا","طريقاً لستَ عنه بذي نُكوبِ",45,"ب",1,0],["وما يطوي العمارَةَ كلُّ غيثٍ","إلى الأرض المعطَّلة اليبابِ",46,"ب",1,0],["وما يكن من حديثٍ صالحٍ لهُمُ","فصادرٌ عن قديمٍ غير مُؤتَشبِ",47,"ب",1,0],["وما يزال طَوالَ الدهرِ مُنتخِباً","من كلِّ أمرين أمراً غير مُنتخبِ",47,"ب",1,0],["وما يجتني الميسورَ من لا يزورُهُ","ولا اللؤلؤَ المنثور من لا يُحادثُهْ",48,"ث",2,0],["وما يُهْدَى إليك من امْتِيَاحٍ","أحبُّ إليكَ من كل امتداحِ",49,"ح",1,0],["وما يفي بالثلاث مرثيةٌ","إلا صلاةَ المليك في السورِ",50,"ر",1,0],["وما يتجارَى الشاعران لغايةٍ","وراء اعتفاءِ الفضلِ من سيدٍ غَمر",51,"ر",1,0],["وما يضيرُ العينَ ألا ترى","شبيهَ بُهْلولٍ وعمَّار",52,"ر",1,0],["وما يصانع عن عود به خَوَرٌ","هيهات ذلك عود غير مغموز",53,"ز",1,0],["وما يعرف الدرع إلا الندى","أو الصبر في كل يوم مَصِع",54,"ع",1,0],["وما يستوي في الطير صقر وهامة","لعمري ولا شحّاجها وسَجوعها",55,"ع",3,0],["وما ينفك لي أبداً خصومٌ","أقابل منهم خرقاً برفق",56,"ق",1,0],["ومائق فوق صدره هنة","جازت بشبر مشَكَّ منطقتِهْ",57,"ت",2,1],["وما يريدُ بُغاةُ النيكِ من رجلٍ","فيما أتى لطريق النيكِ تسهيلُ",58,"ل",1,0],["وما يبقَى على الحدثانِ شيءٌ","سوى شرفٍ من الأفعالِ عالي",59,"ي",1,0],["وما يتناهى القولُ فيكم لغايةٍ","تناهيَ ذاتٍ بل تناهِيَ قائلِ",60,"ل",1,0],["وما يُرجَى من البيض ابتسامٌ","لمن أمسى لمفرقه ابتسامُ",61,"م",1,0],["وما يَنفَكُّ يَلْقَى الكُرْهَ فيهِ","فِئامٌ قد تَقَدَّمَهُ فِئامُ",61,"م",1,0],["وما ينفكُّ يلحمنا ويجري","ندىً لك لا ينهنهه لجامُ",61,"م",1,0],["وما يُخشى على جملي قُلافٌ","ولا يخشى على فرسي صِدامُ",61,"م",1,0],["وَما يَحفَظُ المَكتومَ مِن سِرِّ أَهلِهِ","إِذا عُقَدُ الأَسرارِ ضاعَ كَبيرُها",62,"ر",3,0],["وَما يَفرَحُ الأَضيافُ أَن يَنزِلوا بِها","إِذا كانَ أَعلى الطَلحِ كَالرَمَكِ الشُهبِ",63,"ب",1,0],["وَما يُلاقونَ فَرّاصاً إِلى نَسَبٍ","حَتّى يُلاقِيَ جَديَ الفَرقَدِ القَمَرُ",64,"ر",1,0],["وَما يَبقى عَلى الأَيّامِ إِلّا","بَناتُ الدَهرِ وَالكَلِمُ العَقورُ",65,"ر",1,0],["وَما يُغني عَنِ الذُهلَينِ إِلّا","كَما يُغني عَنِ الغَنَمِ الخَيالُ",66,"ل",1,0],["وَما يَزدَهيني في الأُمورِ أَخَفُّها","وَما أَضلَعَتني يَومَ نابَ ثَقيلُها",67,"ل",3,0],["وَما يَدري بِحَمدِ اللَ","هِ ما شَعبانَ مِن رَجَبِ",68,"ب",1,0],["وما يُثيرُ شُعوري","مِنْ خَافقاتِ خَيَالي",69,"ي",1,0],["وَما يَبتَغي مِنّي عُداةٌ تَعاقَدوا","وَمِن جِلدِ جاموسٍ سَمينٍ مُطَرَّقُ",70,"ق",1,0],["وَما يَنفَكُّ مِنكَ الدَهرُ رَطباً","وَلا يَنفَكُّ غَيثُكَ في اِنسِكابِ",71,"ب",1,0],["وَما يَشُقُّ عَلى الكَل","بِ أَن يَكونَ اِبنَ كَلبَه",72,"ب",2,0],["وَما يَنصُرُ الفَضلُ المُبينُ عَلى العِدا","إِذا لَم يَكُن فَضلَ السَعيدِ المُوَفَّقِ",73,"ق",1,0],["وَما يوجِعُ الحِرمانُ مِن كَفِّ حارِمٍ","كَما يوجِعُ الحِرمانُ مِن كَفِّ رازِقِ",74,"ق",1,0],["وَما يَصُدُّكَ عَن بَحرٍ لَهُم سَعَةٌ","وَما يَرُدُّكَ عَن طَودٍ لَهُم شَمَمُ",75,"م",1,0],["وما يستوي وُدُّ المقلّدِ والذي","له حُجَّةٌ في ودِّهِ ودليلُ",76,"ل",1,0],["وما يهتدِي صرفُ النوائبِ لامرئٍ","وأنت لهُ من دونِ ما نابَهُ سِتْرُ",77,"ر",1,0],["وَما يُدعى لِما تُدعى إِلَيهِ","سِواكَ اِبنَ النَجيبَةِ وَالنَجيبِ",78,"ب",1,0],["وَما يَزالُ الفِراقُ يَبحَثُ عَن","ثَأرٍ لَدى العاشِقينَ مَطلوبِ",79,"ب",1,0],["وَما يَتَخالَجُ القاضي اِرتِيابٌ","بِأَنَّكَ طِرفُ حَلبَتِهِ الجَوادُ",80,"د",1,0],["وَما يَعتَريني الَّذي يَعتَري","كَ بِحَقِّ السَوادِ مِنَ الأَبخِرَه",81,"ر",2,0],["وَما يَحويهِ مِن خُلُقٍ رَضِيٍّ","يُشادُ بِهِ وَمِن أَدَبٍ كَبيرُ",82,"ر",1,0],["وَما يَقرَبُ الطَيفُ المُلِمُّ رَكائِبي","وَلا يَعتَريني الشَوقُ مِن حَيثُ يَعتَري",83,"ر",2,0],["وَما يُريدُ الفَتى بِهِمَّتِهِ","بُلِّغَهُ مِن وَرائِهِ أَجَلُ",84,"ل",1,0],["وَما يَومُهُ يَومٌ وَلَكِن مَنِيَّةٌ","تَوافى حَصيدُ الدَهرِ فيها وَقائِمُه",85,"م",2,0],["وَما يُعذَرُ المَوسومُ بِالشَيبِ أَن يُرى","مُعارَ لِباسٍ لِلتَصابى وَلا وَسمِ",86,"م",1,0],["وَما يَزالُ غَريبٌ مِن كِفايَتِهِ","فَذٌّ يَعودُ عَلى العُمّالِ ميزانا",87,"ن",2,0],["وَما يَريبُكَ مِن إِلفٍ يَصُبُّ إِلى","إِلفٍ وَمِن سَكَنٍ يَصبو إِلى سَكَنِ",88,"ن",1,0],["وَما يَتَنَمّى إِلى المَكرُماتِ","فَيَفزَعُها غَيرُ فُرسانِها",89,"ن",3,0],["وَما يَفوتُكَ شَيءٌ أَنتَ طالِبُهُ","وَما مَنَعَت فَشَيءٌ غَيرُ مَقروبِ",90,"ب",1,0],["وَمايِرَةِ الأَعضادِ قَد أَجهَضَت لَها","نَتيجَ خِداجٍ وَهيَ ناجٍ هَبابُها",91,"ب",3,0],["وَما يَجعَلُ الظِربا إِلى رَهطِ حاجِبٍ","وَرَهطِ عِقالِ ذي النَدى بنِ مُحَمَّدِ",92,"د",1,0],["وَما يَغدو عَزيزُ بَني كُلَيبٍ","لِيَطلُبَ حاجَةً إِلّا بِجارِ",93,"ر",1,0],["وَمائِرَةِ الأَعضادِ صُهبٍ كَأَنَّما","عَلَيها مِنَ الأَينِ الجِسادُ المُدَوَّفُ",94,"ف",1,0],["وَما يَبتَغي الأَقوامُ شَيئاً وَإِن غَلا","مِنَ الخَيرِ إِلّا في يَدَيكَ نَوافِلُه",95,"ل",2,0],["وَما يَبلُغُ البَحرانِ مِن آلِ غالِبٍ","إِذا هُزَّ يَوماً لِلنَوالِ كَريمُها",96,"م",3,0],["وَما يَعلَمُ الطائِيُّ مِمَّن أَبٌ لَهُ","وَلَو سَأَلوا عَن طَيِّئٍ كُلَّ عالِمِ",97,"م",1,0],["وَما يَمنَعُ الطائِيُّ إِلّا رَصاصَةٌ","بِها نَقشُ سُلطانٍ عَلى الناسِ قائِمِ",97,"م",1,0],["وَمائِن كَأَنَّ الدِمنَ فَوقَ جَمامِهِ","عِباءٌ كَسَتهُ مِن فُروجِ المَخارِمِ",98,"م",1,0],["وما يَضرُّهمُا والدُرُّ ذو خَطَرٍ","إن حلَّياهُ ملوكاً ذاتَ أخطارِ",99,"ر",1,0],["وَما يَدري الفَتى ماذا يُلاقي","إِذا ما عاشَ مِن حَدَثِ الزَمانِ",100,"ن",1,0],["وَما يَتَفَكَّرُ أَحياؤُها","فَيَعتَبِرونَ بِأَمواتِها",101,"ت",3,0],["وَما يَكفُرُ العُرفَ إِلّا شَقِيٌّ","وَما يَشكُرُ اللَهَ إِلّا سَعيدُ",102,"د",1,0],["وَما يَبقى عَلى الحَدَثا","نِ لا صِغَرٌ وَلا كِبَرُ",103,"ر",1,0],["وَما يَنفَكُّ نَعشُ جَنا","زَةٍ يَمشي بِهِ نَفَرُ",103,"ر",1,0],["وَما يَلبَثُ الحِبّانَ إِن لَم يِجَوِّزا","كَثيراً مِنَ المَكروهِ أَن يَتَباغَضا",104,"ض",2,0],["وَما يَنبَغي لي أَن أُسَرَّ بِلَيلَةٍ","أَبيتُ بِها مِن ظالِمٍ لي عَلى ضِغنِ",105,"ن",1,0],["وَما يَنفَعُ المَقبورَ عُمرانَ قَبرِهِ","إِذا كانَ فيهِ جِسمُهُ يَتَهَدَّمُ",106,"م",1,0],["وما يبالي ذا الخضم العجيب","بناظر يرقب في ساحله",107,"ه",1,0],["وما يُفتدَى منهُ بِلَحمٍ ولا دمٍ","ولكن بما في العظم بالبَرْيِ للعظمِ",108,"م",1,0],["وما ينجو امرُؤٌ من قَبضَتَيهِ","يُدِلّ بِسَبق مُنْجَرِدٍ قبيضِ",109,"ض",1,0],["وَمَا يَستَطيرُ الحِلمُ في حِلمِهِ ولا","يُجاوِزُ هَزلٌ في سَجِيَّتِهِ الجدَّا",110,"د",2,0],["وما يُورِدُ الشيخَ إلّا الَّذي","تلوحُ شمائِلُهُ في الوليدِ",111,"د",1,0],["وَما يَومُ زُرتَ اللَحدَ يَومُكَ وَحدَهُ","عَلَينا وَلَكِن يَومُ عَمرٍو وَحاتِمِ",112,"م",1,0],["وَما يَلحَظُ العافي جَداكَ مُؤَمِّلاً","سِوى لَحظَةٍ حَتّى يَؤوبَ مُؤَمِّلا",113,"ل",2,0],["وَما يَطَّبيها الغُمضُ إِلّا لِأَنَّهُ","طَريقٌ إِلى طَيفِ الخَيالِ المُعاوِدِ",114,"د",1,0],["وَمَا يَسْتَوِي جَانٍ أَتَى الإِثْمَ طَائِعاً","وَآخَرُ لَمْ يَقْرفْهُ إِلَّا بِرَغْمِهِ",115,"م",2,0],["وما يدري الصدى في النحو شيئاً","سوى بابِ الحكايةِ والخطابِ",116,"ب",1,1],["وما يَكْشرُ الليثُ ضحكاً بلى","يكشِّرُ إذْ سمُّه منقعُ",117,"ع",1,0],["وَمائِسَةٍ تُزهى وَقَد خَلَعَ الحَيا","عَلَيها حُلىً حُمراً وَأَردِيَةً خُضرا",118,"ر",2,1],["وَما يَستَوي مَن لا يُرى غَيرَ لَمَّةٍ","وَمَن هُوَ ثاوٍ عِندَها لا يَريمُها",119,"م",3,0],["وَما يَسلُكُ المَوماةَ مِن كُلِّ نِقضَةٍ","طَليحٍ كَجَفنِ السَيفِ تُحدى بِمَوكِبِ",120,"ب",1,0],["وما يرضَى المسيحُ إذا استباحت","دمَ الضُّعفاءِ أيدي الآثمينا",121,"ن",2,0],["وما ينسى أبو لهبٍ بنيهِ","ولا يأبى ذويه الأقربينا",121,"ن",2,0],["وَما يَعرِفُ الشَعبُ كُنهَ الأُمورِ","بِرَأيٍ غَوِيٍّ وَقَلبٍ عَمِ",122,"م",1,0],["وَما يَنفَكُّ ذو أَدَبٍ يُعاني","جَفاءَ عَشيرَةٍ وَصُدودَ آلِ",123,"ل",1,0],["وما يَستَوِي البحرانِ هذا مذَاقُه","أُجاجٌ وهذا طعمهُ سائِغٌ عذبُ",124,"ب",1,0],["وما يَسْتَوِي الهِبْرِزِيُّ الجَسُور","غَداةَ الوَغى والهَيُوبُ الفَروقْ",125,"ق",1,0],["وما يَجِدُ الأديبُ الفردُ وصفاً","يُحيطُ به ولو أفنى البيانا",126,"ن",2,0],["وما يجديكم الهذَيانُ شيئاً","وهل يُجدِي المُخبَّلَ ما يَقولُ",127,"ل",1,0],["وما يُجديك لاعجهُ فتيلا","أما تنفكُّ تذكر يومَ بدر",128,"ر",1,0],["وما يخفَى الصّوابُ ولا يَغيبُ","رُويداً إنّ موعدكم قريبٌ",128,"ب",1,0],["وَمَا يَستَوِي بَحرُ أجَاجٌ مُقَطِّبٌ","واخَرُ مَعسُولُ المَوارِدِ بَاسِمُ",129,"م",1,0],["وَما يَمنَعُ الغَيثُ مِن أَن يَجودَ","وَلا يَأنَفُ الرَوضُ أَن يُسأَلا",130,"ل",2,0],["وَما يَبقى عَلى الحِدثانِ غُفرٌ","بِشاهِقَةٍ لَهُ إِمٌّ رَؤومُ",131,"م",1,0],["وَما يَنتَقِص مِن شَبابِ الرِجالِ","يَزِد في نُهاها وَأَلبابِها",132,"ب",3,0],["وَما يزالُ الغُلامُ يَتْبَعُهُ","بدرَّةٍ مِثْلَ رَأْسِهِ صُلْبَهْ",133,"ب",2,0],["وما يَزالُ يُعِينُ الطائِعِينَ إذَا","تَطَوَّعُوا بِجَمِيلٍ أَوْ إذا نَذَرُوا",134,"ر",3,0],["وما ينقضي حلي الخواتم منكم","وليس لمقطوع اليدين خواتم",135,"م",1,0],["وما يبتغي العافي لديك وسيلة","إذا ابتغيت عند الملوك الوسائل",136,"ل",1,0],["وَمائِلِ الرَأسِ نَشوانٍ شَدَوتُ لَهُ","وَدِّع لَميسَ وَداعَ الصارِمِ اللاحي",137,"ح",2,1],["وَما يُلِذُّ أَنفَها مِن شَمِّهِ","يُنازِلُ المُكّاءَ عِندَ نَجمِهِ",138,"م",2,0],["وَما يَعرِفُ اللَيلُ الطَويلَ وَغَمُّهُ","مِنَ الناسِ إِلّا مَن تَنَجَّمَ أَو أَنا",139,"ن",2,0],["وما يتلون في شروين دستي","ومن حرداب رامين وويس",140,"س",1,0],["وَما يَلقَى الَّذي لاقَي","تُ مَولودٌ عَلى الفِطرَه",141,"ر",2,0],["وَما يَخفى عَلى النُدَماءِ أَنّي","أُجيدُ بِها الغِناءَ وَإِن كَنَيتُ",142,"ت",1,0],["وَما يَبقى عَلى زَمَنٍ مُغيرٍ","عَدا حَدَثانُهُ عَدوَ الذِئابِ",143,"ب",1,0],["وَما يُرهِبُني جارِ","يَ إِن ناضَلَ أَو جارى",144,"ر",2,0],["وَما يَحميكَ عِزٌّ إِن تَسَبّى","وَلَو أَنَّ الظَلامَ عَلَيكَ سِبُّ",145,"ب",1,0],["وَما يَدري الفَتى وَالظَنُّ جَهلٌ","وَأَقضِيَةُ المَليكِ مُغَيَّباتُ",146,"ت",1,0],["وَما يُدريكِ باكِيَتي عَساني","لِسُكنى الفَوزِ في الأُخرى اِنتُقيتُ",147,"ت",1,0],["وَما يَبينُ الوَفاءُ إِلّا","في زَمَنِ الفَقدِ وَالوَفاةِ",148,"ه",1,0],["وَما يَرتَضي اللُبُّ عِندَ البَيانِ","لا ما أَتوهُ وَلا ما أَتَت",149,"ت",1,0],["وَما يَكُفُّ أَذاةً عَنكَ حِلفُ ضَنىً","وَقَد يَشُجُّكَ عودٌ مَسَّهُ عَوَجُ",150,"ج",1,0],["وَما يَنفَعُ الإِنسانَ أَنَّ غَمائِماً","تَسُحُّ عَلَيهِ تَحتَ إِحدى الضَرائِحِ",151,"ح",1,0],["وَما يُضحِكُ السِنَّ في دَهرِها","كَأَنَّ المَصائِبَ لَم تَفدَحِ",152,"ح",1,0],["وَما يَئِسَت مِن رَجعَةٍ نَفسُ ظاعِنٍ","مَضَت وَلَها عِندَ القَضاءِ وُعودُ",153,"د",1,0],["وَما يَزالونَ في شامٍ وَفي يَمنٍ","يَستَنبِطونَ قِياساً ما لَهُ أَمَدُ",154,"د",1,0],["وَما يَنفَكُّ في السَنَواتِ مِنها","حَليبٌ أَو نَحيرٌ أَو فَصيدُ",155,"د",1,0],["وَما يَسبَحُ الإِنسانُ في لُجِّ غَمرَةٍ","مِنَ العِزِّ إِلّا بَعدَ خَوضِ الشَدائِدِ",156,"د",1,0],["وَما يَبلُغُ الأَحياءُ عَزّاً بِكَثرَةٍ","وَهَل لِحَصى المَعزاءِ قَدرُ الفَرائِدِ",156,"د",1,0],["وَما يَجمَعُ الأَشتاتَ إِلّا مُهَذَّبٌ","مِنَ القَومِ يُحمى بارِداً فَوقَ بارِدِ",157,"د",1,0],["وَما يَمنَعُ الخائِفينَ الحِمامَ","لُبسُ دُروعِهِمُ وَالخُوَذ",158,"ذ",1,0],["وَما يَجمُلُ التَقصيرُ في كُلِّ مَوطِنٍ","وَلا كُلُّ مَفروضِ الصَلاةِ لَهُ قَصرُ",159,"ر",1,0],["وَما يَحمي الفَتى كِبَراً وَزَرداً","بِمَوتٍ لِبسُهُ زَرداً وَكِبرا",160,"ر",2,0],["وَما يَترُكُ الإِنسانُ دُنياهُ راضِياً","بِعِزٍّ وَلَكِن مُستَضاماً عَلى قَسرِ",161,"ر",1,0],["وَما يَحُجّونَ مِن دينٍ وَلا نُسُكٍ","وَإِنَّما ذاكَ إِفراطٌ مِنَ الأَشَرِ",162,"ر",1,0],["وَما يَأتيكَ ما تَهوى بِضَربٍ","وَطَعنٍ في صُدورِ الخَيلِ نَترُ",163,"ر",1,0],["وَما يُدريكَ وَالإِنسانُ غُمُرٌ","وَقَد يُدرى خَليلُكَ وَهُوَ دارِ",164,"ر",1,0],["وَما يَأتيكَ بِالأَغراضِ خِلٌّ","وَلا شَدُّ الرَواحِلِ بِالغُروضِ",165,"ض",1,0],["وَما يَسيلُ وَلَكِن يَنبَري نَقطاً","حَتّى يُغَرِّقَ أَهلَ الأَرضِ بِالنِقَطِ",166,"ط",1,0],["وَما يَنفَكُّ في يَمَنٍ وَشامِ","غُرورُكِ شائِماً بِخِفَّي لَمعِ",167,"ع",1,0],["وَما يَبقى إِذا فَتَّشتَ حَيٌّ","تَخَيُّرُهُ الحَوادِثُ أَو تُنَفّي",168,"ي",1,0],["وَما يَنفَعُ الكاعِبَ المُستَبا","ةَ هامٌ عَلى عَضَبٍ فُلَّقا",169,"ق",2,0],["وَما يَترُكُ الضِرغامَ في أَجَماتِهِ","وَلا ذاتَ رَوقٍ في ظِلالٍ وَريقِ",170,"ق",1,0],["وَما يَبقى عَلى الأَيّا","مِ لا موسى وَلا موسَك",171,"ك",1,0],["وَما يُخلِدُ المَلِكَ الآدَميَّ","لا ما أَذابَ وَلا ما سَبَك",172,"ك",1,0],["وَما يَفرِقُ التُربُ الَّذي هُوَ آكِلٌ","لَنا بَينَ جِسمَي بادِنٍ وَهَزيلِ",173,"ل",1,0],["وَما يَشعُرُ المَدفونُ يَسري حَديثُهُ","فَيُنجِدُ في أَقصى البِلادِ وَيُتهَمُ",174,"م",1,0],["وَما يُعَرّونَ مِن مَكرٍ وَلا حِيَلٍ","أَطرافَ سُمرٍ وَلا أَطرافَ أَقلامِ",175,"م",1,0],["وَما يَنفَعُ الغِربيبُ وَالضَعفُ واقِعٌ","إِذا كانَ لَونُ الرأسِ غَيرَ هِجانِ",176,"ن",1,0],["وَما يَنَفكُّ مُحتَمِلاً ذُباباً","أَبى التَغريدُ في الخَضِرِ المُغَنِّ",177,"ن",1,0],["وَما يَحدُثُ فَإِنّا أَهلُ عَصرٍ","قَليلٌ في المَعاشِرِ مُنجِبوهُ",178,"ب",3,0],["وَما يَخشى الوَعيدَ فَيوعِدوهُ","وَلا يَرعى العِتابَ فَيُعتِبوهُ",178,"ب",3,0],["وَما يُحِسُّ إِذا ما عادَ مُتَّصِلاً","بِالتُربِ تَسفيهِ في الهابي سَوافيهِ",179,"ف",3,0],["وما يرقى لهاه من نداه","ولا المال الكريم من الهوان",180,"ن",1,0],["ومائج ذهبيّ النتور قد غرقت","في ذوبِه الشمس عبر العالم الثاني",181,"ي",1,0],["وَما يُريبُكَ مِن سَهمٍ رُميتَ بِهِ","وَقَد أَصابَكَ مَرّاتٍ فَما نَفَذا",182,"ذ",2,0],["وما يكُنْ فلكَ الحمْدُ الجميلُ به","وإن أُضِيعَتْ فإنّي شاكرٌ داعِ",183,"ع",1,0],["وما يهود بالسّخاف الأغبيا","إذ ظاهروا الشّرك عدوّ الأنبيا",184,"ي",2,0],["ومَا يَبقَى عَلَى الأَيَّامِ باقٍ","سِوىَ ذي العِزَّةِ الرَّبِّ القَديرِ",185,"ر",1,0],["وما يَسْتوِي فِي الحُبِّ أَرْوَعُ فاضِلٌ","وَأَحْمَقُ مَذْمُومٌ خَلاَئِقهُ غِرُّ",186,"ر",1,0],["وما يَسْتوِي وُدٌّ هُوَ الغُنْمُ لِلْوَرَى","كوُدِّ ابْنِ تَوْفِيقٍ وَوُدٌّ هُوَ الْخُسْرُ",186,"ر",1,0],["وَمَا يَمْنَعُ الجَالينَ نَفْعاً مُحَلَّلاً","وَلَكَّنهُ يَأْبَى عَلَى مَنْ تَزيدا",187,"د",2,0],["وَمَا يدَانى وَمَا يُسَامَى","دَانِي معَانِيهِ وَالبَعَيدُ",188,"د",1,0],["وَمَا يُزْهَى مُدَبِّجُهَا بِسَامِي","مَكانَتِهِ فَتحْسُبُهُ وَضِيعَا",189,"ع",2,0],["وَمَا يَفِيدُ النَّاسَ يَسَّرْتِهِ","لِرَفْعِ شَأْنٍ أَوْ لإِصْلاَحِ حَالْ",190,"ل",1,0],["وَمَا يَعْنِي بَرِيئاً مِنْ حَدِيثٍ","يُرَدَّدُ عَنْ عَذُولٍ أَوْ عَذِيرِ",191,"ر",1,0],["وَما يَمْلِك الأَسْمَاعَ إِذْ يَنْطِقُ الهَوَى","كَمَا يَمْلِكُ الأَسْمَاعَ إِذْ يَنْطقُ الْعَقْلُ",192,"ل",1,0],["وَمَا يَنِي بِرُقِيِّ الشَّعْبِ مُشْتَغلاً","وَبِالنَّجَاحِ عَلَى أَلوَانِهِ كَلِفَا",193,"ف",2,0],["وَما يَنهَضُ البازي بِغَيرِ جَناحِهِ","وَلا يَحمِلُ الماشينَ إِلّا الحَوامِلُ",194,"ل",1,0],["وَما يُتيحُ القَضاءُ إِلّا","أَنتَ وَلا يَنفَعُ التَوَقّي",195,"ي",1,0],["وَما يَنفَعُ المَرءَ إيمانُهُ","بِفيهِ إِذا قَلبُهُ أَشرَكا",196,"ك",2,0],["وما يَقْدَحُ التِّذكارَ إن هَبَّ منكُمُ","نسيمٌ يغصُّ المسْكَ دون مَهبِّه",197,"ب",2,0],["وما يقصِّر عن حزن به جدة","حزن تجدده الذكرى إذا قَدُما",198,"م",2,0],["وما يك من رزقٍ فليس يفوتني","ولو كان في قاع البحار العوامق",199,"ق",1,0],["وما يسلك الموماة من كل نقصة","طليح كجفن السيف تهدى لمركب",200,"ب",1,0],["وَما يَوْمُهُ يَوْمٌ، وَلَكِنْ مَنيّةٌ،","تَوَافَى حَديثُ الدّهرِ فيها وَقادِمُهْ",201,"م",2,0],["وَما يُرِيبُكَ مِنْ إلْفٍ يَصُبُّ إلى","إلفٍ، وَمِنْ سَكَنٍ يَصْبُو إلى شَكَنِ",202,"ن",1,0],["وَما يَحْوِيهِ مِنْ خُلُقٍ رَضيٍّ","يُشادُ بهِ، وَمن أدَبٍ كَثيرِ",203,"ر",1,0],["وما ينجو امرؤ من قبضتيه","يُدِلّ يسبق مُنجَرِدٍ قبيض",204,"ض",1,0],["وَمَا يعلْلَمُ الطَّائِيُّ مِمَّنْ أبٌ لَهُ","وَلَوْ سَأَلُوا عَنْ طَيِّءٍ كُلَّ عَلِمِ",205,"م",1,0],["وما يجتبي الميسورَ من لا يزورُهُ","ولا الؤلؤ المنثور من لا يُحادثهْ",206,"ث",2,0],["وما يُربغون بالنُّعمى مكافأة ً","لكن يُقَضُّون ما للمجد من أَرَبِ",207,"ب",1,0],["وما يبكيك من عرصات دار","تقادم عهدها وبدا بلاها",208,"ا",3,0],["وَمَا يَكْشِفْ البَدْرُ الظَّلاَمَ إِذَا بَدَا","كَمَا تَكْشِفُ الأَسْرَارَ لَيْلَى وَمَا الصَّدَى",209,"د",2,0],["وما يجشع الأقوام إلا تزودوا","طعاماً وبيلاً أو شراباً مسمما",210,"م",2,0],["وما يفرحُ الأضيافُ أن ينزلوا بها","إذا كان أعلى الطَّلحِ كالدَّمِكِ الشَّطبِ",211,"ب",1,0],["وما يستوي في الفضلِ حالٍ وعاطلٌ","وَلا قاعِدٌ يومَ الوغَى وَمجاهِدُ",212,"د",1,0]]}