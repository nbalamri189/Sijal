{"poems":[[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[10,"أبكي على البطل الذي","https://www.aldiwan.net/poem21126.html","مجزوء الكامل"],[27,"سمت لي نظرة فرأيت برقا","https://www.aldiwan.net/poem5736.html","الوافر"],[27,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[72,"لي رفقة تعجب إقبالهم","https://www.aldiwan.net/poem18682.html","السريع"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"إنما ألبس العمامة في الصيف","https://www.aldiwan.net/poem66755.html","الخفيف"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"لي راتب لم يرض عبدي به","https://www.aldiwan.net/poem29015.html","السريع"],[102,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[51,"إنما ألبَسُ العمامة َ في الصيف","https://www.poetsgate.com/ViewPoem.aspx?id=30795",""],[116,"لي روح في هواكم تفتدي","https://www.aldiwan.net/poem41960.html","الرمل"],[129,"حاز المحاسن من خلق ومن خلق","https://www.aldiwan.net/poem50513.html","البسيط"],[143,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[161,"لي في الله حسن ظن جميل","https://www.aldiwan.net/poem59139.html","السريع"],[170,"صعود العلا إلا عليك حرام","https://www.aldiwan.net/poem1666.html",""],[182,"يذكركم نظمي لديكم وإنني","https://www.aldiwan.net/poem59259.html","الطويل"],[187,"أنا في خلة وقلة مال","https://www.aldiwan.net/poem43495.html","الخفيف"],[194,"لي رفيق شهم الفؤاد يماني","https://www.aldiwan.net/poem13145.html","الخفيف"],[196,"لمن المنازل أقفرت بغباء","https://www.aldiwan.net/poem54412.html","الكامل"],[230,"ليرغم الدهر أني","https://www.aldiwan.net/poem50825.html","المجتث"],[238,"عيس العلا حملت ندى من عيسى","https://www.aldiwan.net/poem19719.html","الكامل"],[262,"تبرع لله العلي جنابه","https://www.aldiwan.net/poem38361.html","الطويل"],[283,"لي غبوق من الهوى وصبوح","https://www.aldiwan.net/poem32815.html","الخفيف"],[305,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[329,"كبرت للروح الأمين","https://www.aldiwan.net/poem55004.html","مجزوء الكامل"],[329,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[354,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[365,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[365,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[365,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[372,"طال الزمان وما ثناه ولا انثنى","https://www.aldiwan.net/poem57023.html","الكامل"],[407,"عفى طلل بالرامتين ومنهج","https://www.aldiwan.net/poem50196.html","الطويل"],[410,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[433,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[497,"شام يا ذا السيف","https://www.aldiwan.net/poem55807.html","عموديه"],[501,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[501,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[516,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[539,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[559,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[576,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["لِيَرفَعَ مِن قَدري وَيَجزِمَ حاسِدي","وَأُصبِحَ في خَفضٍ فَكَم أَنا ناصِبُ",0,"ب",1,0],["لِيُرَوِّعَ القَومَ الَّذينَ","نَعُدُّهُم فينا عِيالا",1,"ل",2,0],["لِيَربوعٍ فَوارِسُ كُلَّ يَومٍ","يُواري شَمسَهُ رَهَجُ الغُبارِ",2,"ر",1,0],["لِيَربوعٍ عَلى النَخَباتِ فَضلٌ","كَتَفضيلِ اليَمينِ عَلى الشِمالِ",3,"ل",1,0],["لِيَربوعٍ إِذا اِفتَخَروا وَعَدّوا","فَوارِسُ مَصدَقٍ وَلُهىً عِظامُ",4,"م",1,0],["لي رفقةٌ تعجب إقبالهم","حوارنا يصقل أفخاذا",5,"ذ",2,1],["ليرى الإمام تكهُّني وتَطَيُّبي","فلقد تكهَّن عبدُهُ وتطيَّبا",6,"ب",2,0],["ليرى العبد فضل ربٍّ كريم","ويرى الرب منه صبرا وصدقا",7,"ق",2,0],["ليرى المهرجانُ فيك سُلوّاً","فله فيك أعظم السلوان",8,"ن",1,0],["ليَ رأسٌ يُقرُّها لا كرأسٍ","لك ما زال قرنُه ينفيها",9,"ه",2,0],["لِيَرى اَلأَواخِرُ يَومَ ذاكَ وَيَسمَعوا","ما غابَ مِن قُسٍّ وَمِن سَحبانِ",10,"ن",1,0],["لِيَرضَ كُلُّ امرِئٍ مِنّا بِأَوَّلِ مَن","يَأتي فَيَقسِطُ فِينا قِسطَ مُحتَكِمِ",11,"م",1,0],["لي راتبٌ لم يرضَ عبدي به","داءٌ له الحرمانُ عندي دوا",12,"د",3,1],["لي رَقدةٌ طويلةٌ في غدِ","للِه ما أعمقَها في الثرى",13,"ر",2,0],["لِيَرَاهُ بَعْدَ جُهْد مُحْسِناً","إِنْ شدا أَوْ مُتْقِناً إِن خطَّ سَطرَا",14,"ر",2,0],["لِيَرْعَهُ اللهُ القَدِيرُ وَلْيَدُمْ","عَزَّ رُبُوعِ الشَّرْقِ بِالفَرْوقِ",15,"ق",1,0],["لِيرَيَنْ فِتْنَتَهُ الَّتِي","تُغْوِي الْعَفِيفَاتِ الْحَرَائِرْ",16,"ر",1,0],["ليَرىَ الذين تجاهَلوا برَمَاً","أسيانَ : كيفُ يُكابد الحُرَقا",17,"ق",2,0],["ليريُهم القلبينِ قد لَصِقا","صِنويَن ، كيف اذا هُما افتَرَقا",17,"ق",2,0],["ليرى السيّدُ الذي ناب عنه","أنَّ حيوانَه شُجاعٌ أريب",18,"ب",1,0],["ليَ رأسٌ يُقرُّها لا كرأسٍ","مازالقرنُه ينفيها",19,"ه",2,0],["لي روح في هواكم تفتدي","ولها من طيبكم عرف شذى",20,"ذ",2,1],["ليرغبُوا طاعةً في أمر سيدهم","هُو الإمامُ الذي انقادتْ له الأممُ",21,"م",1,0],["لِيرُدَّ مَن جاراك رأسَ طِمِرةٍ","ما كلُّ طِرْفٍ في السّباقِ مطهَّمُ",22,"م",1,0],["لي رزق لا بد منه وعمر","ينقضى والكثير منه قليل",23,"ل",1,0],["لِيَرقَ غَبيٌّ رامَ شَأوَكَ في العُلا","عَلى ظلعِهِ فَالنَجمُ لَيسَ يُرامُ",24,"م",1,0],["ليرحمني من كان منكمُ راحماً","لأني أثيمٌ في الأنام ذميمُ",25,"م",1,0],["لي رزق يقول في الرأي بالوق","ف ورجلٌ تقول بالإعتزال",26,"ل",1,0],["لي رَفيقٌ شَهمُ الفُؤادِ يَماني","غَزِلٌ في قصافَةِ القُضبانِ",27,"ن",1,1],["لِيَرى الرِجالُ الكاشِحونَ صَلابَتي","وَأُعينُ ذاكَ بِعِفَّةٍ وَحياءِ",28,"ا",2,0],["لِيُرْغم الدهر أنِّي","سرقتُ منه نعيما",29,"م",2,1],["لِيَرُدَّهَا لِحِمَى الْجَزَائِرِ بُدَّناً","تُنْهِي الذَّخَائِرَ مِنْ مَفَاخِرِ عِيسَى",30,"س",2,0],["ليرغب في المحيا وفي الذكر والهدى","به الناس والمحيا حياة لراغب",31,"ب",1,0],["لِيَ روحٌ بِغَيرِ جِسمٍ وَجِسمٌ","يُقسِمُ العائِدونَ ما فيهِ روحُ",32,"ح",1,0],["ليركبها والمؤمنون وأهله","وزوجان من كل الوجود لحكمة",33,"ه",1,0],["ليروا مصارع مجدهم","وضياعه في العالمين",34,"ن",1,0],["ليريحوا أذن الظمآ","ن من ذكر السراب",35,"ب",1,0],["ليرق مِثلك مَن يَعتَزّ في شَرف","إِن غابَ مِنكَ بِغاب العزّ قسورهُ",36,"ر",2,0],["لِيُرضِيَني بما يُولي فَعالاً","وأُرضِيَهُ بما أُملي مَقالا",37,"ل",2,0],["ليَرْجِعَ عَدْلٌ يَشْمَلُ الخَلْقَ مِثْلَما","هُمُ اليومَ في جَوْرٍ وحاشاكَ شامل",38,"ل",1,0],["لِيُرونيَ الإِدرارَ في مَجْموعهمْ","وأُريهمُ الأشعارَ في مَجْموعي",39,"ع",2,0],["ليُريكَ نارَ الحَربِ كيفَ يَشُبُّها","ماءُ النُّفوسِ تَرُشُّه أيدي الفَنا",40,"ن",2,0],["لِيَرجِعُ دَهري صاغِراً عَن مَساءَتي","وَيَرجِع مِنَ بعد الهَرير يُحشَرِجُ",41,"ج",1,0],["لي رسومٌ منها مواصلَةُ الكُتْ","بِ وأنتَ البَرُّ الكريمُ الوَصولُ",42,"ل",1,0],["لي روضةٌ من خاطري ومُدامةٌ","وُرْقُ القوافي بينهنّ تغرِّدُ",43,"د",1,0],["لي رغبةٌ فيهِ وزهدٌ في بني الدن","يا ثناني عن طلاب زهيدها",44,"د",3,0],["لي ربيعٌ فيكِ خبَّأتُهُ","مِلءَ دُنيا قلبيَ التّعِبِ",45,"ب",1,0],["ليرغَبَ فيكُمْ قلبُ من هو عبدُكُمْ","بنِمْطِ التَّجلِّي عن صلاةِ الرَّغائِبِ",46,"ب",1,0],["ليَرْجِعَنْ لأَهلِهِ","بقصدِهِ مُنْقَلِبَا",47,"ب",2,0],["ليروقني هيف الغصون إذا انثنت","شغفاً بقد منعم ريان",48,"ن",1,0],["لِيَرضى به تاريخُنا وضَميرُنا","ويَرضى به المولى الإمامُ المُعَظَّمُ",49,"م",1,0],["لي رتبة العلامة الشهم الأَسَدّْ","قد أنشبت بين العدا ناب الأسدْ",50,"د",1,1],["لي راحةٌ فيها ولي حَاجَةٌ","تَملِكُ أَقْصى عَيْشِيَ الأَرْغَدِ",51,"د",1,0],["ليربح فيما ليس يضمن فأحضرن","لهذا ففيه النهى فافهم تسدد",52,"د",1,0]]}