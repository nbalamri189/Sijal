,"https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"من أجل نقوده تقتله","https://www.poetsgate.com/ViewPoem.aspx?id=182526",""],[5956,"قممُ الوعي","https://www.poetsgate.com/ViewPoem.aspx?id=185610",""],[5974,"هَنْدَسَةُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=200330",""],[6038,"يا اللي تغلى","https://www.poetsgate.com/ViewPoem.aspx?id=25694",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""],[6152,"عيادة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=206620",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6304,"مهلا ضفاف الرافدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1612&r=&rc=2",""]],"verses":[["لِيَرفَعَ مِن قَدري وَيَجزِمَ حاسِدي","وَأُصبِحَ في خَفضٍ فَكَم أَنا ناصِبُ",0,"ب",1,0],["لِيُرَوِّعَ القَومَ الَّذينَ","نَعُدُّهُم فينا عِيالا",1,"ل",2,0],["لِيَربوعٍ فَوارِسُ كُلَّ يَومٍ","يُواري شَمسَهُ رَهَجُ الغُبارِ",2,"ر",1,0],["لِيَربوعٍ عَلى النَخَباتِ فَضلٌ","كَتَفضيلِ اليَمينِ عَلى الشِمالِ",3,"ل",1,0],["لِيَربوعٍ إِذا اِفتَخَروا وَعَدّوا","فَوارِسُ مَصدَقٍ وَلُهىً عِظامُ",4,"م",1,0],["لي رفقةٌ تعجب إقبالهم","حوارنا يصقل أفخاذا",5,"ذ",2,1],["ليرى الإمام تكهُّني وتَطَيُّبي","فلقد تكهَّن عبدُهُ وتطيَّبا",6,"ب",2,0],["ليرى العبد فضل ربٍّ كريم","ويرى الرب منه صبرا وصدقا",7,"ق",2,0],["ليرى المهرجانُ فيك سُلوّاً","فله فيك أعظم السلوان",8,"ن",1,0],["ليَ رأسٌ يُقرُّها لا كرأسٍ","لك ما زال قرنُه ينفيها",9,"ه",2,0],["لِيَرى اَلأَواخِرُ يَومَ ذاكَ وَيَسمَعوا","ما غابَ مِن قُسٍّ وَمِن سَحبانِ",10,"ن",1,0],["لِيَرضَ كُلُّ امرِئٍ مِنّا بِأَوَّلِ مَن","يَأتي فَيَقسِطُ فِينا قِسطَ مُحتَكِمِ",11,"م",1,0],["لي راتبٌ لم يرضَ عبدي به","داءٌ له الحرمانُ عندي دوا",12,"د",3,1],["لي رَقدةٌ طويلةٌ في غدِ","للِه ما أعمقَها في الثرى",13,"ر",2,0],["لِيَرْضَى صَدِيقٌ أوْ لِيَبْلُغَ كَاشِحاً","ومَا كُلُّ مَنْ سَلفْتَهُ الوُدَّ نَاصِحُ",14,"ح",1,0],["لِيَرَاهُ بَعْدَ جُهْد مُحْسِناً","إِنْ شدا أَوْ مُتْقِناً إِن خطَّ سَطرَا",15,"ر",2,0],["لِيَرْعَهُ اللهُ القَدِيرُ وَلْيَدُمْ","عَزَّ رُبُوعِ الشَّرْقِ بِالفَرْوقِ",16,"ق",1,0],["لِيرَيَنْ فِتْنَتَهُ الَّتِي","تُغْوِي الْعَفِيفَاتِ الْحَرَائِرْ",17,"ر",1,0],["ليَرىَ الذين تجاهَلوا برَمَاً","أسيانَ : كيفُ يُكابد الحُرَقا",18,"ق",2,0],["ليريُهم القلبينِ قد لَصِقا","صِنويَن ، كيف اذا هُما افتَرَقا",18,"ق",2,0],["ليرى السيّدُ الذي ناب عنه","أنَّ حيوانَه شُجاعٌ أريب",19,"ب",1,0],["ليَ رأسٌ يُقرُّها لا كرأسٍ","مازالقرنُه ينفيها",20,"ه",2,0],["لي روح في هواكم تفتدي","ولها من طيبكم عرف شذى",21,"ذ",2,1],["ليرغبُوا طاعةً في أمر سيدهم","هُو الإمامُ الذي انقادتْ له الأممُ",22,"م",1,0],["لِيرُدَّ مَن جاراك رأسَ طِمِرةٍ","ما كلُّ طِرْفٍ في السّباقِ مطهَّمُ",23,"م",1,0],["لي رزق لا بد منه وعمر","ينقضى والكثير منه قليل",24,"ل",1,0],["لِيَرقَ غَبيٌّ رامَ شَأوَكَ في العُلا","عَلى ظلعِهِ فَالنَجمُ لَيسَ يُرامُ",25,"م",1,0],["ليرحمني من كان منكمُ راحماً","لأني أثيمٌ في الأنام ذميمُ",26,"م",1,0],["لي رزق يقول في الرأي بالوق","ف ورجلٌ تقول بالإعتزال",27,"ل",1,0],["لي رَفيقٌ شَهمُ الفُؤادِ يَماني","غَزِلٌ في قصافَةِ القُضبانِ",28,"ن",1,1],["لِيَرى الرِجالُ الكاشِحونَ صَلابَتي","وَأُعينُ ذاكَ بِعِفَّةٍ وَحياءِ",29,"ا",2,0],["لِيُرْغم الدهر أنِّي","سرقتُ منه نعيما",30,"م",2,1],["لِيَرُدَّهَا لِحِمَى الْجَزَائِرِ بُدَّناً","تُنْهِي الذَّخَائِرَ مِنْ مَفَاخِرِ عِيسَى",31,"س",2,0],["ليرغب في المحيا وفي الذكر والهدى","به الناس والمحيا حياة لراغب",32,"ب",1,0],["لِيَ روحٌ بِغَيرِ جِسمٍ وَجِسمٌ","يُقسِمُ العائِدونَ ما فيهِ روحُ",33,"ح",1,0],["ليركبها والمؤمنون وأهله","وزوجان من كل الوجود لحكمة",34,"ه",1,0],["ليروا مصارع مجدهم","وضياعه في العالمين",35,"ن",1,0],["ليريحوا أذن الظمآ","ن من ذكر السراب",36,"ب",1,0],["ليرق مِثلك مَن يَعتَزّ في شَرف","إِن غابَ مِنكَ بِغاب العزّ قسورهُ",37,"ر",2,0],["لِيُرضِيَني بما يُولي فَعالاً","وأُرضِيَهُ بما أُملي مَقالا",38,"ل",2,0],["ليَرْجِعَ عَدْلٌ يَشْمَلُ الخَلْقَ مِثْلَما","هُمُ اليومَ في جَوْرٍ وحاشاكَ شامل",39,"ل",1,0],["لِيُرونيَ الإِدرارَ في مَجْموعهمْ","وأُريهمُ الأشعارَ في مَجْموعي",40,"ع",2,0],["ليُريكَ نارَ الحَربِ كيفَ يَشُبُّها","ماءُ النُّفوسِ تَرُشُّه أيدي الفَنا",41,"ن",2,0],["لِيَرجِعُ دَهري صاغِراً عَن مَساءَتي","وَيَرجِع مِنَ بعد الهَرير يُحشَرِجُ",42,"ج",1,0],["لي رسومٌ منها مواصلَةُ الكُتْ","بِ وأنتَ البَرُّ الكريمُ الوَصولُ",43,"ل",1,0],["لي روضةٌ من خاطري ومُدامةٌ","وُرْقُ القوافي بينهنّ تغرِّدُ",44,"د",1,0],["لي رغبةٌ فيهِ وزهدٌ في بني الدن","يا ثناني عن طلاب زهيدها",45,"د",3,0],["لي ربيعٌ فيكِ خبَّأتُهُ","مِلءَ دُنيا قلبيَ التّعِبِ",46,"ب",1,0],["ليرغَبَ فيكُمْ قلبُ من هو عبدُكُمْ","بنِمْطِ التَّجلِّي عن صلاةِ الرَّغائِبِ",47,"ب",1,0],["ليَرْجِعَنْ لأَهلِهِ","بقصدِهِ مُنْقَلِبَا",48,"ب",2,0],["ليروقني هيف الغصون إذا انثنت","شغفاً بقد منعم ريان",49,"ن",1,0],["لِيَرضى به تاريخُنا وضَميرُنا","ويَرضى به المولى الإمامُ المُعَظَّمُ",50,"م",1,0],["لي رتبة العلامة الشهم الأَسَدّْ","قد أنشبت بين العدا ناب الأسدْ",51,"د",1,1],["لي راحةٌ فيها ولي حَاجَةٌ","تَملِكُ أَقْصى عَيْشِيَ الأَرْغَدِ",52,"د",1,0],["ليربح فيما ليس يضمن فأحضرن","لهذا ففيه النهى فافهم تسدد",53,"د",1,0],["ليراعكم أهديت إنسان النظر","وشباب طرس شاب من فرط الكبر",54,"ر",1,1],["ليرض دهري او يسخط فلت به","ما دام لي الود ولا بدع والهمم",55,"م",1,0],["ليرى فيه جانبٌ منتهاه","ويرى فيه جانبٌ ميدانه",56,"ن",2,0],["لي روّحن كن الغدير هواهن","لو كان لاهوبٍ هواه مليل",57,"ل",1,0],["لِيَرِقَّ لي منهُ الفُوادُ القاسي","القَلبُ بين تقطُّعٍ وَتَفتُّتِ",58,"ت",1,0],["ليرفع رتبتي ويشيد قدري","جهاراً غير مَجْحود الثناء",59,"ا",2,0],["ليرحم ما أَلقَى ويعلم أننِى","له بالذى يُسدِى إِلىَّ شكورُ",60,"ر",1,0],["ليراعِ امرىءٍ إذا خطَّ سطراً","نَبذَ الحقَّ وارتَضى المَينَ دينا",61,"ن",2,0],["لي روع ما يَرعوى عَن رياض","وَحياض وَربربي وَربابه",62,"ب",2,0],["ليرى من كان يشوب هواك","لمن يقلاك ومن يمحض",63,"ض",1,0],["لى رجاءٌ أن يَشفَعَن لى ولا ير","تدلاجٍ إلى حماه مُلِحُّ",64,"ح",1,0],["ليَرعك الله في يمنٍ وعافيةٍ","وبالرفاء قرانُ الناهضِ النَّدبَ",65,"ب",1,0],["ليرى الإِله ضجيع قلبي حبها","وضجيع جسمي مدحها ورثاءها",66,"ا",3,0],["ليرى الغربُ أن فينا حياةً","ونفوساً ليست بقيد الممات",67,"ت",1,0],["ليراعتي الأَلفا","ظ لكنّ المعاني للمناظر",68,"ر",1,0],["لي رجاء فإنّ رحماك عمّتْ","ومخاف فإن ذنبي ذنبي",69,"ب",2,0],["لِيَرى الحَبيب بأَنَّهم لم ينعموا","عَيشاً وَلا اللَيل الطَويل مناما",70,"م",2,0],["لي رحى بالحب دارَت","فأَدارَت كل قطب",71,"ب",1,0],["ليرى الناس أنه ذو اقتدار","أن يعيد الأشياء بعد فناها",72,"ا",3,0],["ليرمق طرفي بسطة بعد قبضة","ويوقف دمع فيه جار وسائل",73,"ل",1,0],["ليروا حكمةَ التقابل منه","فيهمُ ثم يطلبون الشهودا",74,"د",2,0],["لي راحَةٌ يَفرُقُ مِنها الغنى","لأنَّ ما ينزلها يُستَماح",75,"ح",1,1],["لِيَرَى تَفرِيجَ المُرُرِى","وزَوال الأزمةِ بالفَرَجِ",76,"ج",1,0],["لِيَرى أَخاه بِجَنبه","مَحفوظ وَهُوَ يَنعم",77,"م",1,0],["ليُرسلَها في الجوِّ صاعقةً يُرى","لها كلُّ بُرْج هابطاً مًتَلَهِّبا",78,"ب",2,0],["ليرى ما هو الهوى ولماذا","تخذته العشاق من قبل زيا",79,"ي",2,0],["ليراه الخلق بالعج","ز إلها في علاه",80,"ه",1,0],["ليراني عنده في","حالتي بعدي وقربي",81,"ي",1,0],["لي رفقةٌ كلُّهم عطفٌ بدون حجىً","عقلي يحرّم طول العمر وصلَهمُ",82,"م",1,1],["ليروا مبيتي بالعراء وزوجتي","حيرى لبؤس مصيرها ومصيري",83,"ر",2,0],["لي روح للمجد عشاقه","تعشق مطاليب علويه",84,"ي",2,1],["ليرفع ذلك من قدره","وإن كان قارب فيما طلب",85,"ب",1,0],["لِيَرعاكَ خالِصُ إِخلاصنا","وَعينُ اِلتفاتكَ لي راعيَه",86,"ي",2,0],["لِيربحه مِنّا مَبيع وَبائِع","يَقولونَ لي وَالشَوقُ مِنّي مَشاغلي",87,"ي",1,0],["لي رَجاءٌ موطَّدٌ بالهٍ","عفوُهُ واسعٌ جميعَ الخطايا",88,"ا",3,0],["ليراعِك الصافي المَضا","لا غرو إِن خَضع الحسام",89,"م",1,0],["ليرى بينهم صديقا صدوقا","منجدا في السراء والضراء",90,"ا",2,0],["لِيَرَوا طَيشَ مَلكِهِم وَهوَ يَدرِي","أَنَّهُ قد أَصَادَ شَرَّ إِصادَه",91,"د",2,0],["ليرفع عنهن ذلة رقٍّ","برمحٍ بقلب العداة مضى",92,"ض",2,0],["لِيراعِهِ خضعَ البديع بلا عنا","وَلَهُ المَعاني وَالبيان عَبيدُ",93,"د",1,0],["لي روضةٌ ضحك النور بها","وبكت عليها أعين السحب",94,"ب",1,0],["ليُرى سابِقاً لشأوِ أَبيهِ","بالِغاً في العُلى مَكاناً قَصيّا",95,"ي",2,0],["ليرعى عباد اللَه بالرشد والتقى","ويوقي صراط العدل من صولة العدى",96,"د",2,0],["لِي رَجاء في رَحمة اللَه لَما","وَسَعت في الحَياة ما لا يُطاق",97,