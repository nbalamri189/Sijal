{"poems":[[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[10,"أبكي على البطل الذي","https://www.aldiwan.net/poem21126.html","مجزوء الكامل"],[27,"سمت لي نظرة فرأيت برقا","https://www.aldiwan.net/poem5736.html","الوافر"],[27,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[72,"لي رفقة تعجب إقبالهم","https://www.aldiwan.net/poem18682.html","السريع"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"إنما ألبس العمامة في الصيف","https://www.aldiwan.net/poem66755.html","الخفيف"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"لي راتب لم يرض عبدي به","https://www.aldiwan.net/poem29015.html","السريع"],[102,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[51,"إنما ألبَسُ العمامة َ في الصيف","https://www.poetsgate.com/ViewPoem.aspx?id=30795",""]],"verses":[["لِيَرفَعَ مِن قَدري وَيَجزِمَ حاسِدي","وَأُصبِحَ في خَفضٍ فَكَم أَنا ناصِبُ",0,"ب",1,0],["لِيُرَوِّعَ القَومَ الَّذينَ","نَعُدُّهُم فينا عِيالا",1,"ل",2,0],["لِيَربوعٍ فَوارِسُ كُلَّ يَومٍ","يُواري شَمسَهُ رَهَجُ الغُبارِ",2,"ر",1,0],["لِيَربوعٍ عَلى النَخَباتِ فَضلٌ","كَتَفضيلِ اليَمينِ عَلى الشِمالِ",3,"ل",1,0],["لِيَربوعٍ إِذا اِفتَخَروا وَعَدّوا","فَوارِسُ مَصدَقٍ وَلُهىً عِظامُ",4,"م",1,0],["لي رفقةٌ تعجب إقبالهم","حوارنا يصقل أفخاذا",5,"ذ",2,1],["ليرى الإمام تكهُّني وتَطَيُّبي","فلقد تكهَّن عبدُهُ وتطيَّبا",6,"ب",2,0],["ليرى العبد فضل ربٍّ كريم","ويرى الرب منه صبرا وصدقا",7,"ق",2,0],["ليرى المهرجانُ فيك سُلوّاً","فله فيك أعظم السلوان",8,"ن",1,0],["ليَ رأسٌ يُقرُّها لا كرأسٍ","لك ما زال قرنُه ينفيها",9,"ه",2,0],["لِيَرى اَلأَواخِرُ يَومَ ذاكَ وَيَسمَعوا","ما غابَ مِن قُسٍّ وَمِن سَحبانِ",10,"ن",1,0],["لِيَرضَ كُلُّ امرِئٍ مِنّا بِأَوَّلِ مَن","يَأتي فَيَقسِطُ فِينا قِسطَ مُحتَكِمِ",11,"م",1,0],["لي راتبٌ لم يرضَ عبدي به","داءٌ له الحرمانُ عندي دوا",12,"د",3,1],["لي رَقدةٌ طويلةٌ في غدِ","للِه ما أعمقَها في الثرى",13,"ر",2,0],["لِيَرَاهُ بَعْدَ جُهْد مُحْسِناً","إِنْ شدا أَوْ مُتْقِناً إِن خطَّ سَطرَا",14,"ر",2,0],["لِيَرْعَهُ اللهُ القَدِيرُ وَلْيَدُمْ","عَزَّ رُبُوعِ الشَّرْقِ بِالفَرْوقِ",15,"ق",1,0],["لِيرَيَنْ فِتْنَتَهُ الَّتِي","تُغْوِي الْعَفِيفَاتِ الْحَرَائِرْ",16,"ر",1,0],["ليَرىَ الذين تجاهَلوا برَمَاً","أسيانَ : كيفُ يُكابد الحُرَقا",17,"ق",2,0],["ليريُهم القلبينِ قد لَصِقا","صِنويَن ، كيف اذا هُما افتَرَقا",17,"ق",2,0],["ليرى السيّدُ الذي ناب عنه","أنَّ حيوانَه شُجاعٌ أريب",18,"ب",1,0],["ليَ رأسٌ يُقرُّها لا كرأسٍ","مازالقرنُه ينفيها",19,"ه",2,0]]}