ويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127004","الوافر"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35066","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117852","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40151","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"],[4578,"محاسن رياً نشرها طيب الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=49418",""],[5183,"الرزّء الأليم","https://www.poetsgate.com/ViewPoem.aspx?id=180263",""],[5362,"في ذمة التمدن الكاذب","https://www.poetsgate.com/ViewPoem.aspx?id=170371",""],[5574,"على أرض الخلود - ذكرى ترفرف","https://www.poetsgate.com/ViewPoem.aspx?id=205995",""],[5756,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=5436",""],[6001,"الصوت مايغني عن الشوف","https://www.poetsgate.com/ViewPoem.aspx?id=372",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِمُشَذَّبٍ كَالجِذعِ صا","كَ عَلى تَرائِبِهِ خِضابُه",0,"ب",2,0],["بِمُشعِلَةٍ يَغشى الفِراشَ رَشاشُها","يَبيتُ لَها ضَوءٌ مِنَ النارِ جاحِمُ",1,"م",1,0],["بِمَشيَةٍ بَينَ صَفَّي حِكمَةٍ وَتُقىً","يُحِبُّها اللَهُ لا تيهٌ وَلا خالُ",2,"ل",1,0],["بِمُشرِفَةِ الأَجداثِ خاشِعَةِ الصُوى","تَداعى إِذا أَمسَت صَداها وَبومُها",3,"م",3,0],["بِمُشتَبِهِ الأَرباءِ يَرمي بِرَكبِهِ","يَبيسُ الثَرى نائي المَناهِلِ أَخوَقُ",4,"ق",1,0],["بِمَشارِقِ الجَبَلَينِ أَو بِمُحَجَّرٍ","فَتَضَمَّنَتها فَردَةٌ فَرُخامُها",5,"م",3,0],["بمشيتهم طالتْ قصار سيوفهم","حِفاظاً إذا ما الحرب شب شبوبها",6,"ب",3,0],["بمُشَهَّرٍ في الجُودِ يَظْلِمُ مالَه","بنَوالِه فلو استطاعَ تَظَلَّما",7,"م",2,0],["بمُشتمِلٍ بالعَدلِ سُلَّت سيوفُه","على الدَّهرِ حتى عادَ في الحُكمِ عادِلا",8,"ل",2,0],["بمُشَمِّرٍ في السَّيْر إلا أنَّه","يَسري فيمنَعُه السُّرى أن يَبعُدا",9,"د",2,0],["بِمُشرِقٍ مِثلِ قَرنِ الشَمسِ بازِغَةً","وَمُسبَكِرٍّ عَلى لَبّاتِها سُوَدا",10,"د",2,0],["بِمُشعَلَةٍ تُزَفُّ إِلى الأَعادي","كَأَنَّ رِجالِها آسادُ غيلِ",11,"ل",1,0],["بِمَشرَفيٍّ في الدِماءِ والِغُ","قُدَّ لَهُ قَميصُ وَشيٍ سابِغُ",12,"غ",1,0],["بِمَشمولَةٍ كَالشَمسِ يَغشاكَ نورُها","إِذا ما تَبَدَّت مِن نَواحي المَشارِقِ",13,"ق",1,0],["بِمَشهَدٍ لَيسَ يَثنيهِ بِهِ زَلَلٌ","وَمَنطِقٍ لَيسَ يَعروهُ بِهِ خَطَلُ",14,"ل",1,0],["بِمَشْيٍ كَهَزِّ الرُّمْحِ بَادٍ جَمَالُهُ","إِذَا جَدَفَ المَشْيَ القِصَارُ الدَّحَادِحُ",15,"ح",1,0],["بِمَشْهَدٍ مِنْ عَالَمِ الأَضْوَاءِ","في مُتَرَاءَي البَحرِ وَالسّمَاء",16,"ا",2,0],["بمَشْيٍ كهَزِّ الرُّمْحِ ، بادٍ جَمَالُهُ","إذا جَذَفَ المَشيَ القِصَارُ الدَّحادِحُ",17,"ح",1,0],["بمشارع لشرائع وحقائق","لمعينها سحٌّ وتسكاب السما",18,"م",2,0],["بِمُشعَلَةٍ تَدعو هَوازِنَ فَوقَها","نَسيجٌ مِنَ الماذِيِّ لَأمٌ مُرَفَّلُ",19,"ل",1,0],["بِمَشيجٍ ثالطٍ وَدَمٍ","أُخلِصَت مِنهُ السَراويلُ",20,"ل",1,0],["بمشهد هبّاته مجتمعهْ","أشهد كان الله لا شيء معهْ",21,"ه",1,0],["بِمُشَتّتِ العَزَماتِ مَرهوبَ الشبا","مُتَشاغِلٌ بِالجِدِّ عَنهُ ما لَها",22,"ه",2,0],["بِمُشَمِّرٍ عَن مِعصَمَيهِ مُزَنَّرٍ","يَهتَزُّ بَينَ التيهِ وَالخُيَلاءِ",23,"ا",2,0],["بمُشْبِهةٍ قبل الكَمالِ وبعدَه","وما كلُ تَشبيهٍ سَمِعْتَ بصائب",24,"ب",1,0],["بمشيئَتَيه غدا الورى متدبّراً","ثُمَّتْ نجا بطبيعتيه آدم",25,"م",1,0],["بِمشيحِ البيضِ حَتّى يَترُكوا","لِسُيوفِ الهِندِ فيها طُرقا",26,"ق",2,0],["بمشرق القاعة الغراء قد طلعت","كواكب السعد تيدي للعيون سنا",27,"ن",2,1],["بِمُشَرَّدٍ قَلِقِ الثَّواءِ بِمَنْزِلٍ","لا يَنْثَنِي فِيهِ لَهُ الزُّوَّارُ",28,"ر",1,0],["بمشرِق اللَّباتِ دانت له","شهبُ الدراري قبلَ بِيضِ المحَالْ",29,"ل",1,0],["بمُشركِ نفسي بالذي هو واجِدٌ","ولو ساعدتهُ حالةٌ لكَفاني",30,"ن",2,0],["بمُشارٍ في نَدِيٍّ ووَغَىً","لِضرابِ الهامِ أو للصَّفَدِ",31,"د",1,0],["بمشرفة كالطود دائمة السرى","كأني على الشعرى بها أو على شعري",32,"ر",2,0],["بمشيك بان المستعار واهله","وحقق ان الروح في الجسم مودع",33,"ع",1,0],["بمشيبٍ عَمَّ حتَّى","عمَّمَ الرأَسَ اشْتِعَالا",34,"ل",2,0],["بمشي لك بالوفايا","لين تْقول العذر",35,"ر",1,0],["بمشهد شخصه زمر النوادي","يكون لكل فائدة شهود",36,"د",1,0],["بمشتبهين من ورد وخد","وممتزجين من خمر وريق",37,"ق",1,0],["بمشهد شهدته","في وصف علم لا يحد",38,"د",1,0],["بمشبع لبة العادي جراحاً","ومترع مهجة الصادي سماحا",39,"ح",2,0],["بِمُشرِفِ الحارِك نَهْدِ الكَفَل","أقبَّ محبوكِ السَّراة هَيْكَل",40,"ل",1,0],["بمشهد المليك للأ","ملاك كان مشهدا",41,"د",2,0],["بِمَشعَرِهِم لَقَد صَلَّوالِصُبحٍ","وَوَادِ مُحَسِّرٍ جازُوا حَرِيمُ",42,"م",1,0],["بمشبوب السطا والج","ود منهلِّ الشآبيبِ",43,"ب",1,0],["بمشمرين إذا استماتت بينهم","سنة الكرى اتخذوا الوساد المرفقا",44,"ق",2,0],["بمشي المشيء شاءت فأبدت","كل شيء يصح فيه المشاء",45,"ا",2,0],["بمشهدك الأفكار أدهشها الأسا","كما أقلق الأبصار من بعدك السهد",46,"د",1,0],["بِمشابِهِ الشعرِ الأَثيثِ أَعارَهُ","قَمَرُ الجَبينِ الصَلتِ نور شُعاعِهِ",47,"ع",2,0],["بمشرق الارض طورا ثم مغربها","لايخطر الموت من حرصى على بالى",48,"ل",2,0],["بمشركة إذا شكرت صنيعاً","عن الإدراك صانعه يجلُّ",49,"ل",1,0],["بمشْرَعهِ ارْتاحَتْ عواليكَ شُرَّعاً","تَرُدُّ العدوَّ المعْتَدي وتَذودُهُ",50,"د",2,0],["بمشيّدٍ علْياءَها ومُشدّدٍ","أعْضادَها ومُسدّدٍ آراءَها",51,"ا",3,0],["بمشرعة الطفوف قضوا عطاشى","وليس لهم اليها من شروع",52,"ع",1,0],["بِمُشَطَّبٍ أَو غَيرِ ذي شطبٍ","هامَ العدى بِذبابِهِ يَفري",53,"ر",2,0],["بمشاهدٍ تصفو لكل مجاهد","وموارد عذبت لكل موازر",54,"ر",1,0],["بِمشرَفَةِ المَناكِبِ مَقرباتٌ","لَهُنَّ بِمَتنِ كُلِّ وَغىً حِضارُ",55,"ر",1,0],["بِمَشؤومٍ زِيارَتُهُ طَويلٍ","وَلا نَحسٍ مِنَ الأَيّامِ ضاحي",56,"ح",2,0],["بمشمته إذ صادفَ الحتفُ مالكاً","ومشهده ما قد رأى ثم ضَيّعا",57,"ع",2,0],["بمشقى لها قد عذت من كل فاتنٍ","ولو كان بدراً بالثرَّيا مُعوِّدا",58,"د",2,0],["بمشفرها ثغام من حِمام","ومنخرها بلفحته الحميم",59,"م",1,0],["بمشطك الشعر وتدهينه","غصبت حق الغادة الكاعب",60,"ب",1,0],["١٤- بمشروعٍ أنار سبيلَ شعْبٍ","فأيدي الشمْسِ قد مسكتْ زِمامهْ",61,"م",2,0],["بمشي على درب له الناس يسعون","واصد عن درب الدجي والعتامة",62,"م",2,1],["بمشي بدربي واترك الناس يمشون","كلن على كيفه رقى كل هامه",62,"م",2,0],["بمشي ولوع حد لسيوف","من شان كسب رضاه ورضاك",63,"ك",1,0],["بمشهد الحق على الأطوار","بما لوجه الحق من أنوار",64,"ر",1,0]]}