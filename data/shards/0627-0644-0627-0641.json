em43587.html","الطويل"],[105,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[105,"يحنة إن تؤمن فخير وإن ترد","https://www.aldiwan.net/poem44023.html","الطويل"],[105,"يقول أبو سفيان أودى محمد","https://www.aldiwan.net/poem44208.html","الطويل"],[81,"لقد أعقبت بالبؤس منك وبالنعمى","https://www.aldiwan.net/poem61490.html","الطويل"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[52,"ألا فاسقنيها قد مشى الصبح في الدجى","https://www.aldiwan.net/poem26827.html","الطويل"],[52,"ألا فاسقياني قهوة ذهبية","https://www.aldiwan.net/poem27166.html","الطويل"],[52,"ألا فاسقنيها قد نعى الليل ديكه","https://www.aldiwan.net/poem27245.html","الطويل"],[75,"أقول لذي قامة كالقضيب","https://www.aldiwan.net/poem69009.html","المتقارب"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"ألا فاسقني خمراً وقل لي هي الخمر","https://www.aldiwan.net/poem21954.html","عموديه"],[48,"ألا فاسقني مسكية العرف مزة","https://www.aldiwan.net/poem63281.html","الطويل"],[46,"ألا فانعموا واحذروا في الحياة","https://www.aldiwan.net/poem23437.html","المتقارب"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49420","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85572","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39583","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21045","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54857","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55162","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54706","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54642","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"أجادير","https://www.poetsgate.com/ViewPoem.aspx?id=179602",""],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[106,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[77,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[85,"في الموت ما أعيا وفي أسبابه","https://www.poetsgate.com/ViewPoem.aspx?id=477",""],[51,"علاكَ قناعُ المشيبِ اليقَقْ","https://www.poetsgate.com/ViewPoem.aspx?id=29918",""],[51,"من ظن أن الاستزادة في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=27818",""],[31,"لَقَدْ أَرْسَلَتْ في السِّرِّ لَيْلَى تَلُومُني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18822&r=&rc=85",""],[88,"أطلَّ صباح العيد في الشرق يسمع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19511&r=&rc=14",""]],"verses":[["أَلا فَاِجهَدِ النَفسَ في نَيلِها","وَلا تَرقَبَنَّ عَسى أَو لَعَلّا",0,"ل",2,0],["أَلا فَاِحذَروها أَوَّلُ السَيلِ دَفعَةٌ","وَرُبَّ ضَئيلٍ عادَ وَهوَ ضِناكُ",1,"ك",1,0],["أَلا في سَبيلِ المَجدِ ثاوونَ لَم تَكُن","قُبورُهُم غَيرَ الدَلاصِ المُسَرَّدِ",2,"د",1,0],["أَلا فَاِسعَد بِهِ وَبِكُلِّ يَومٍ","يُفَوِّقُهُ الصَباحُ إِلى المَساءِ",3,"ا",2,0],["أَلا فَليَعِش جاري عَزيزاً وَيَنثَني","عَدُوّي ذَليلاً نادِماً يَتَحَسَّرُ",4,"ر",1,0],["أَلا فَاُنظُري بِاللَهِ يا سَكَني الوَعدا","وَلا تَترُكي أَن تَجعَلي دينَنا نَقدا",5,"د",2,1],["أَلا فَرِّجي عَنّي فُديِتِ وَأَنعِمي","عَلَيَّ تُصِيبي الأَجرَ في ذاكَ وَالحَمدا",5,"د",2,0],["ألا في سَبيلِ اللهِ نصْرُ نَبيِّهِ","فحَيَّ تحيّاتِ العُلا ذلِكَ الحَيا",6,"ي",2,0],["ألا في سَبيلِ اللهِ سيرتُكَ التي","يُنادي بِها الإيمانُ حيَّ هَلا حَيّا",6,"ي",2,0],["أَلاَ فِي سَبِيلِ اللهِ قَلْبٌ مُقَلَّبٌ","عَلَى الْبُعْدِ لاَ يَخْلُو مِنَ الْوَجْدِ بَالُهُ",7,"ل",2,0],["أَلاَ فَافْلِيَا فَوْدَ الْفَلاَ بِنَجَائِبٍ","لَهَا خَبَبٌ لاَ يَنْقَضِي وَذَمِيلُ",8,"ل",1,0],["ألا فابْلِغي عنّي فديْتُكِ واصْدُقي","محَلِّقَ ذاك الكُسِّ أنّي مقصِّرُ",9,"ر",1,0],["أَلاَ فَابْكِيَا رَوْضَ الْجَلاَلِ الَّذِي ذَوَى","عَلَى حِينَ هَزَّتْهُ السَّمَاحَةُ وَاسْتَوَى",10,"ت",3,0],["أَلاَ فَابْكِيَا غَيْثَ الْمَوَاهِبِ وَالْجَدَى","وَلَيْثَ الشَّرى نَجْلَ السُّرَاةِ الأَطَايبِ",10,"ب",1,0],["أَلا فَتىً عَرَبِيٌّ تَستَقِلُّ بِهِ","بَعدَ الفَقيدِ وَيَحمي حَوزَةَ الأَدَبِ",11,"ب",1,0],["أَلا فَاِعلَم أَبَيتَ اللَعنَ أَنّا","عَلى عَمدٍ سَنَأتي ما نُريدُ",12,"د",1,1],["آلاَفُ شُبَّانِ أفَادُوا بِالَّذِي","لَقَّنْتَ آلاَفاً مِنَ الشُّبَّانِ",13,"ن",1,0],["أَلا فَاِشتَرَوا مِنّي مُلوكَ المُخَرِّمِ","أَبِع حَسَناً وَاِبني هِشامٍ بِدِرهَمِ",14,"م",1,1],["أَلا فَاِبكِهِم حَقّاً وَأَجرِ عَلَيهِمُ","عُيوناً لِرَيبِ الدَهرِ مُنسَكِباتِ",15,"ت",1,0],["أَلا فَاِحذَرا الأَعداءَ وَاِتَّقِياهُما","وَرَسّا إِلى مَيٍّ كَلاماً مُتَمَّما",16,"م",2,0],["ألا في سبيل الله نفس نفيسةٌ","يُرخّصُ منها الحبُّ ما كان غاليا",17,"ي",2,0],["ألا فلتحي مصر فنحن نرجو","لكم فيها السعادة والسلامه",18,"ه",1,0],["ألا فلتسعدن بفؤاد مصرٌ","كما بغداد قد سعدت بغازي",18,"ي",1,0],["ألا فارحموا بالصفح عن نهج صحفكم","فقد أوردتنا اليوم شرّ الموارد",19,"د",1,0],["ألا فأصدعي يا ربّة الخدر بالذي","ترَيْن من الآراء في الردّ والردع",20,"ع",1,0],["ألا فانهضا نحو العِدي وكلاهما","لصاحِبه في المأزِق الضَنْكِ معوان",21,"ن",1,0],["ألا فَابْك لي يا أحمد اليوم رحمةً","ودعني وشأني والأسى وفؤاديا",22,"ي",2,0],["ألا فاهدهم يا ربّ للمجد والعلا","فما من مضلٍ في الأنام لمن تهدي",23,"د",2,0],["إِلّا فَلاءَ الخَيلِ مِنها مُرسَلٌ","وَمُرَبَّطاتٌ بِالفِناءِ صِيامُ",24,"م",1,0],["ألا في سبيل الله ساكن مَلْحَدٍ","وأوصافه في الأرضِ تُملي وتكتب",25,"ب",1,0],["إلا في سبيل الله شمس محاسنٍ","وإن لم تكن شمس النهار فأختها",26,"ت",3,0],["ألا فابقَ طول الدَّهر للملك حافظاً","إذا حملت يدَّاك من قلمٍ رمحا",27,"ح",2,0],["ألا في سبيل الله نصل عزائم","وعلم غدا في باطن الأرضِ مغمدا",28,"د",2,0],["ألا في سبيل الله فرع كتابةٍ","ثنتهُ المنايا وهو ريان مائد",29,"د",1,1],["ألا في سبيل الله صوم عن الصَّبى","وقلب على عهد الحسان مفطر",30,"ر",1,0],["ألا في سبيل الله سارٍ للحده","وفي كل أفق ذكر علياهُ قد سرى",31,"ر",2,0],["ألا في سبيل الله نقد عزيزةٍ","تولَّت وأبقت لاعج الحزن يرتع",32,"ع",1,0],["ألا في سبيل الحبّ حال مسهدٍ","لثعلب هذا الفجر عنه مراغ",33,"غ",1,1],["ألا في سبيل الله مصرع ماجد","تزيلت العلياء مثل زواله",34,"ل",2,0],["ألا فتىً يُرضي بِذاك ربَّهْ","يضُمُّ كفَّيهِ على إرزَبَّهْ",35,"ب",2,0],["ألا فاهرُبوا من طالبٍ وابنِ طالبٍ","فمِن طالبٍ مثليْهما طارَ هاربُ",36,"ب",1,0],["ألا فاسقني في الفِطْر كأساً رَويَّةً","لعلَّ لُهاثَ الصوم يُنقَعُ لاهِثُهْ",37,"ث",2,0],["ألا فاسمعا لي إن شكوتُ فطال ما","شدوتُ بمدحي فيكما فوق من يشدو",38,"د",2,0],["إلا فِرَاَش غير ما طاهر","ينتابه الصادر والواردُ",39,"د",1,0],["ألا فليهاجر حبَّه وعزيزه","ويصبرْ على بُعد يؤدي إلى القصْدِ",40,"د",1,0],["ألا فليخفْ غاوٍ ولا يخشى راشدٌ","فَعَدلُكَ مسلولٌ وجوْرُكَ مُغمَدُ",41,"د",1,0],["ألا فعليه لعنةُ الله دِيمةً","ووبْلاً كثيراً شِرْبه لا يُصرّدُ",41,"د",1,0],["ألا فداءٌ يفي ببُغيته","ألا سِدادٌ لتلكمُ الفُقَرِ",42,"ر",1,0],["ألا فامتعِضْ من قَوْلتي لك عندها","رَوِيتُ بريقي حين أظمأني البحر",43,"ر",1,0],["ألا فاسقني خمراً بصفو سلافةٍ","بماء سماء حبذا الخمر بالقطرِ",44,"ر",1,1],["ألا فالْهُ لهوَ المرء مثلِك إنهُ","مُدارسُ علمٍ لا تُملُّ مَدارسه",45,"س",2,0],["ألا فعزاءك عما مضى","فليس يؤوب إلى من جزِع",46,"ع",1,0],["ألا فَامْرِ أخلاف معروفه","فإنك إن تمرها ترتضع",46,"ع",1,0],["ألا فارجُهُ واخشَه إنه","هو البحر فيه الغنى والغرق",47,"ق",1,0],["ألا فارجه واخشه إنه","هو الغيث فيه الحيا والصعق",47,"ق",1,0],["ألا في سبيل الله وُدٌّ ربَبْتُهُ","بماءِ الصفاءِ العذب في الخُلُقِ السهلِ",48,"ل",1,0],["ألا فاستخيري الله لي عِنْدَ رِحْلتي","فذلك أجْدى من مَلامِ اللوائمِ",49,"م",1,0],["ألا فاضِلٌ يأوي لنُقْصانِ ناقصٍ","فَيُلْبِسَهُ من عَفْوه وهو ناقمُ",50,"م",1,0],["ألا فاستمعْ مني بأُذْنٍ سميعةٍ","فذاك سميعٌ لؤْمُهُ مُتصاممُ",50,"م",1,0],["ألا فاسقِني من بناتِ الكُروم","وروِّ بكاساتِها أعْظُمي",51,"ي",1,0],["أَلا فَليَقُل ما شاءَ مَن هُوَ قائِلٌ","وَدونَكَ هَذا مَوضِعُ النَظمِ وَالنَثرِ",52,"ر",1,0],["أَلا فَاقتُلوني إِنَّني غَيرُ رَاجِعٍ","إِلَيكُم وَلا أُعطي عَلَى الذُّلِّ مِقوَدي",53,"د",2,0],["إلاَّ فؤاداً ظلَّ يخفُقُ","في الوُجُودِ إلى لِقاكْ",54,"ك",1,0],["ألا فاسمحوا لي أن أقول موضحا","لما بيننا يا أهل بغداد من لبس",55,"س",1,1],["ألا فاعتقد ما شئت إنا عصابة","ترى عن سماع الكفر في أذننا وقرا",56,"ر",2,0],["أَلا في سَبيلِ اللَهِ وَالحَقِّ طارِفٌ","مِنَ المالِ لَم تَبخَل بِهِ وَتَليدُ",57,"د",1,0],["أَلا في سَبيلِ اللَهِ ذاكَ الدَمُ الغالي","وَلِلمَجدِ ما أَبقى مِنَ المَثَلِ العالي",58,"ل",2,1],["أَلا في سَبيلِ العِلمِ خَمسونَ حِجَّةً","مَضَت بَينَ تَعليمٍ وَبَينَ طِلابِ",59,"ب",1,0],["إِلّا فَنىً يَمشي عَلَيهِ مُجَدِّداً","ديباجَتَيهِ مُعَمِّراً بِخَرابِهِ",60,"ب",2,0],["أَلا فَتىً يورِدُ الهِندِيَّ هامَتَهُ","كَيما تَزولُ شُكوكُ الناسِ وَالتُهَمُ",61,"م",1,0],["أَلا فَتىً كَأَبي العَبّاسِ يُسعِدُهُ","عَلى النَوالِ فَلا تُكدي مَطالِبُهُ",62,"ب",2,0],["أَلا في سَبيلِ اللَهِ سَفكُ دِمائِنا","بِلا جُرمَةٍ مِنّا يَبينُ اِجتِرامُها",63,"م",3,0],["ألا فاعجَبْ لِما صَنَعَ الغَواني","فقد أَفسَدْنَ بالغَدْرِ الصَّنيعا",64,"ع",2,0],["ألا فاسقني الخمر مشمولة","تصب على الليل صبحا منيرا",65,"ر",2,0],["أَلا فَاصبِر عَلى الحَدَثِ الجَليلِ","وَداوِ جَواكَ بِالصَبرِ الجَميلِ",66,"ل",1,1],["أَلا في سَبيلِ اللَهِ ما فاتَ مِن عُمري","تَفاوَتُ أَيّامي بِعُمري وَما أَدري",67,"ي",1,1],["أَلا فَاِخرُج مِنَ الدُنيا مُخِفّاً","وَقَدِّم عَنكَ بَينَ يَدَيكَ ثِقلَك",68,"ك",1,0],["أَلا فَاِخرُج مِنَ الدُنيا جَميعاً","وَزَجِّ مِنَ المَعاشِ بِما زَجا لَك",69,"ك",1,0],["أَلا فَانظُر لِنَفسِكَ أَي","يَ زادٍ أَنتَ حامِلُهُ",70,"ل",2,0],["أَلا في سَبيلِ اللَهِ أَيُّ نَدامَةٍ","نَموتُ كَما ماتَ الأُلى كُلَّما خَلَوا",71,"و",2,0],["أَلا في سَبيلِ اللَهِ جِسمي وَقُوَّتي","أَلا مُسعِدٌ حَتّى أَنوحَ عَلى جِسمي",72,"ي",1,0],["أَلا فَاِنظُر إِلى الأَزها","رِ في أَنوارِها لَمعَه",73,"ع",2,0],["أَلا فَاُنظُر إِلى الفِردَو","سِ كَالفِردَوسِ في النَعتِ",74,"ت",1,0],["الأَفضَلُ المَلِكُ الَّذي لِفَخارِهِ","ذَيلٌ عَلى هامِ السُهى مَجرورُ",75,"ر",1,0],["أَلا في سَبيلِ المَجدِ مُهجَةُ ماجِدٍ","يُشارِكُنا في حُزنِهِ المَجدُ وَالفَخرُ",76,"ر",1,0],["أَلا في سَبيلِ المَجدِ مَصرَعُ ماجِدٍ","ثِمارُ الأَماني مِن أَياديهِ تُقطَفُ",77,"ف",1,0],["الأَفضَلِ المَلِكِ الَّذي أَحيا الوَرى","فَأَشبَهَ الوالَدَ فَضلُ الوَلَدِ",78,"د",1,0],["الأفق مضطرب الحوا","شي والسماء بها حزينه",79,"ن",2,0],["ألا فُجِعَتْ أبناءُ فِهر بأروعٍ","إِذا انتَسَبوا عَدّوا له الحَسبَ العدا",80,"د",2,0],["ألا في ضمانِ اللَّه دار بِنُوطَسٍ","وَدَرّتْ عليها مُعْصِراتُ الهواضِبِ",81,"ب",1,0],["أَلا في سَبيلِ اللَهِ مَن عُطِّلَت لَهُ","فِجاجُ سَبيلِ اللَهِ وَاِنثَغَرَ الثَغرُ",82,"ر",1,0],["أَلا فَاِعلَمي أَنّي أَشَدُّ صَبابَةً","وَأَحسَنُ عِندَ البَينِ مِن غَيرِنا عَهدا",83,"د",2,0],["أَلا فَضَلَت ذَيلَها لَيلَةٌ","تَجُرُّ الرَبابُ بِها هَيدَبا",84,"ب",2,1],["أَلا فَاِسأَلِ الرُكبانَ هَل سُقِيَ الحِمى","نَدىً فَسَقى اللَهُ الحِمى وَسَقانِيا",85,"ي",2,1],["أَلا فَاِسلَما يا أَيُّها الطَلَلانِ","وَدَوماً عَلى الأَيّامِ مُؤتَلِفانِ",86,"ن",1,0],["أَلا فَاِرحَمي صَبّاً كَئيباً مُعَذَّباً","حَريقُ الحَشا مُضنى الفُؤادِ حَزينُ",87,"ن",1,0],["أَلا فَاِذكُري ما قَد بَقي مِن حُشاشَتي","فَقَد حانَ مَوتي وَالمَماتُ أُريدُ",88,"د",1,0],["أَلا في سَبيلِ الحُبِّ ما قَد لَقيتُهُ","غَراماً بِهِ أَحيا وَمِنهُ أَذوبُ",89,"ب",1,0],["أَلا في سَبيلِ اللَهِ قَلبٌ مُعَذَّبٌ","فَذِكرُكِ يا لَيلى الغَداةَ طَروبُ",89,"ب",1,0],["أَلا فاهدموا النفَر الأرذلين","فخيركم الهادمُ الخاذلُ",90,"ل",1,0],["ألا فاذكروا من قومنا كُلّ مِقدامِ","ففي هذه الذكرى حياةٌ لأقوامِ",91,"م",1,1],["ألا في سبيل الله مِنّا مواقفٌ","رأينا بها الأحداثَ كيف تهولُ",92,"ل",1,0],["أَلا فَاِنظُروا دُنيا النُسورِ وَسابِقوا","إِلى المَجدِ فيها كُلَّ نَسرٍ مُرَفرِفِ",93,"ف",1,0],["ألا فانظروها كيف أضْحت صخُورُها","تَطيرُ فُضاضاً من صِلابٍ ومن صُمِّ",94,"م",1,0],["ألا فانظروا سيفَ الإمامِ وبأسَهُ","تَرَوْا عَجَباً من مشهدٍ ليس بالدَّدِ",95,"د",1,0],["ألا فَدَعُوا الجَهالةَ وَاسْتَفِيقُوا","فما يُغْنِي عَنِ الغَيْثِ الجَهامُ",96,"م",1,0],["ألا فاشهدوا يا آل مقنا وأيْقِنُوا","بأنْ سوفَ تَنْهى الجاهِلينَ العواقِبُ",97,"ب",1,0],["ألا فانصروا الدّينَ القويمَ وجاهدوا","جِهاداً يُرينا مصرعَ الشِّركِ داميا",98,"ي",2,0],["أَلا فَأتِيا بَطحاءَ لَبلَةَ فَاِندُبا","بِها مَصرَعاً غالَ الشَجاعَةَ وَالحِلما",99,"م",2,0],["إِلّا فَتىً لِلحَمدِ في مالِهِ","قَسمٌ إِذا ضُنَّ بِأَقسامِها",100,"م",3,0],["أَلا فَاِسقِنيها قَد مَشى الصُبحُ في الدُجى","عُقاراً كَلَونِ النارِ حَمراءَ قَرقَفا",101,"ف",2,1],["أَلا فَاِسقِياني قَهوَةً ذَهَبِيِّةً","فَقَد أَلبَسَ الآفاقَ جُنحُ الدُجى دَعَج",102,"ج",1,1],["أَلا فَاِسقِنيها قَد نَعى اللَيلَ ديكُهُ","وَأَغرى بِأُفقِ اللَيلِ فَهوَ سَليبُ",103,"ب",1,1],["ألا فاغضُضِ الطرفَ يا ذا الفتى","فلِلَّهِ طرفُكَ ما أسحَرَه",104,"ر",2,0],["ألا فامزِجوا كأسَ المُدامِ بذكْرِهِ","فلن تجِدُوا مَزْجاً أرَقَّ ولا أصْفى",105,"ف",2,0],["ألا في سبيلِ اللّهِ تَبْذُلُ كلَّ مَا","تَضِنُّ به الأنواءُ وهْيَ جُمود",106,"د",1,0],["ألا فاسقِني خمراً، وقل لي: هيَ الخمرُ،","ولا تسقني سرّاً إذا أمكن الجهرُ",107,"ر",1,1],["أَلا فَاسقِني مِسكِيَّةَ العَرفِ مُزَّةً","عَلى نَرجِسٍ تُعطيكَ أَنفاسَهُ الخَمرُ",108,"ر",1,1],["أَلا فَاِنعَموا وَاِحذَروا في الحَياةِ","مُلِمّاً يُسَمّى مُزيلَ النَعَم",109,"م",1,1],["ألا فاذكروا الأبطالَ وابتدروا الوغى","وكونوا أوليِ بأسٍ شديدٍ وإقدامِ",110,"م",1,0],["أَلا فليرقع ثوبه كل من له","يد قبلما في الثوب يتسع الخرق",111,"ق",1,0],["ألا فاِنتبه للأمر حتامَ تغفلُ","أما علمتك الحال ما كنت تجهلُ",112,"ل",1,1],["ألا فاكتُبوا صكّ النهوض إلى العلا","فإنّي على موتي به لمُوَقِّع",113,"ع",1,0],["ألا فلنحْلُمِ الآنَ فهذي ليلةُ الحبِّ","على النيلِ وضوءُ القمرِ الوضاح كالطفلِ",114,"ل",1,0],["ألا فلنحلُمِ الآنَ فهذي ليلةُ الحبِّ","ليالي الصيفِ أحلامٌ تراءت للمحبِّينا",114,"ن",2,0],["ألا فلْيَكُنْ لكِ من فنهم","سموُّ اللظى وعتوُّ الجبالْ",115,"ل",1,0],["ألا فلْيكُنْ لكِ من سحرهم","فنونٌ تُعطِّلُ سحرَ الخيالْ",115,"ل",1,0],["ألا فليكنْ لكِ من نارهم","وشاحُ مؤلَّهةٍ بالجمالْ",115,"ل",1,0],["ألا في سبيلِ المَجْدِ ما أنا فاعل","عَفافٌ وإقْدامٌ وحَزْمٌ ونائِل",116,"ل",1,1],["أَلاَ في الأَوَّلِ الماضي اعِتبارُ","لِذي عَقلٍ أَخي فَهمٍ بَصيرِ",117,"ر",1,1],["أَلا فَرَعَى اللهُ الصِّبَا مَا أَبَرَّهُ","وَحَيَّا شَبَاباً مَرَّ وَهْوَ نَضِيرُ",118,"ر",1,0],["آلاَفُ آلافٍ بِغَيْرِ","تَلَكُّؤٍ وَتضعْضُعِ",119,"ع",1,0],["أَلاَ فِي سَبِيلِ اللّهِ حِكْمَتُكَ الَّتي","جَلاَهَا هِلاَلٌ مَالِيءُ الكَوْنِ مُقَمِرُ",120,"ر",1,0],["أَلاَ فِي سَبِيل اللهِ أَوْفَى مُفَارقٍ","وَفِي ذِمَّةِ العَلْيَاءِ أَكْرَمُ رَاحِلِ",121,"ل",1,0],["إِلاَّ فُضُولاً مِنْ مُحَلِّلِ كَسْبِهِ","لَمْ تُحْتَسَبْ فِيْهَا مُعَاجَلَةُ الْغَد",122,"د",1,0],["أَلاَ فَاغْنَمَا صَفْوَ الْحَيَاةِ وَسَعْدَهَا","وَجِيئا بِنَسْلٍ صَالِحٍ مُتَعَدَّدِ",123,"د",1,0],["أَلاَ فِي ذِمَّةِ الرّحْمَنِ مَاضٍ","تَيَتَّمَتِ الفَضَائِلُ حِينَ غَابَا",124,"ب",2,0],["أَلا في جِوارِ اللَهِ مَن أَذكُرُ اِسمَهُ","فَتَصدع قَلبي شِدَّةُ الخَفَقانِ",125,"ن",1,0],["ألا، فارفعوا صوْتَ مصرَ إلى أنْ","يرنَّ صداهُ بأذْن الأصَم",126,"م",1,0],["إلاَ في سبيل العروبةِ بانٍ","يُقوِّمُ بالفنِّ ميَّالَها!",127,"ل",3,0],["ألاَ، فاليومَ كلُّ عسيرِ أمر","يَهونُ، وكلُّ إصلاحٍ يُتاحُ",128,"ح",1,0],["ألا فليسُدْ من شاء، حسبيَ أنني","ضننتُ بماء الوجه حين تكرَّموا",129,"م",3,0],["الأفْق بالنجم -لا بالشمع- مزدهرٌ","والأرض بالبُسُط الخضراءِ تزدان",130,"ن",1,0],["ألا فاشكروا يا أهل أندلس يدا","ليوسف لا يحصي لها الفخر حاصر",131,"ر",1,0],["ألا فالثموا منه الدروع فإنها","وسائل للغفران هذي المغافر",131,"ر",1,0],["ألا فاشكروا تلك الكتائب واجعلوا","محاريب ما تبديه منها الحوافر",131,"ر",1,0],["ألا فابليا فود الفلا بنجائب","لها خبب لا ينقضي وذميل",132,"ل",1,0],["إِلّا فَتًىً يَمشي عَلَيهِ مُجَدِّدًا","ديباجَتَيهِ مُعَمِّرًا بِخَرابِهِ",133,"ب",2,0],["ألا فارجُهُ واخشَهُ إنه","هو البحر وفيه الغنى والغَرَقْ",134,"ق",1,0],["ألا فليها حر حبَّه وعزيزه","ويصبرْ على بُعد يؤدي إلى القصْدِ",135,"د",1,0],["الا فاعلمي أنا أشد صبابة ص،","وأصدقُ عندَ البينِ من غيرنا عهدا",136,"د",2,0],["الا فاكتبوا صك النهوض الى العلى","فإني على موتي به لموقِّع",137,"ع",1,0]]}