ate.com/ViewPoem.aspx?id=185660",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5491,"خيالك","https://www.poetsgate.com/ViewPoem.aspx?id=215330",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5861,"هو الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=188032",""],[5939,"نداء عاجل لمواطني فيسبوك","https://www.poetsgate.com/ViewPoem.aspx?id=178631",""],[5956,"العواطف أساس الصالحات وأساس الفن الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=192122",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[5190,"غيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78340&r=&rc=53",""]],"verses":[["وما إحياء ميتٍ من قبور ٍ","كإحياء النفوس من الضلال",0,"ل",1,0],["وما احتجاجُ الورى بالعقلِ نافعُهم","ما دام منهم فؤادٌ بالهوى فُئِدا",1,"د",2,0],["وَما اِحتَشَمَت مِن يَدَيَّ النُصو","لُ إِلّا مَهَزَّةَ نَصلٍ كَهامِ",2,"م",1,0],["وَما اِحتاجَ بُرداً غَيرَ بُردِ عَفافِهِ","وَلا عَرفَ طيبٍ غَيرَ تِلكَ الخَلائِقِ",3,"ق",1,0],["وَما أَحظى إِذا ما غِبتَ عَنّي","بِحُسنٍ لِلزَمانِ وَلا بِطيبِ",4,"ب",1,0],["وَما أَحدَثَ الدَهرُ مِن نَبوَةٍ","وَقَطَّعَ ما بَينَنا مِن سَبَب",5,"ب",1,0],["وَما أَحبَبتُ أَرضَكُم وَلَكِن","أُقَبِّلُ إِثرَ مَن وَطِئَ التُرابا",6,"ب",2,1],["وما أحلى الوصال لو انّ شيئا","من الدنيا للذّته دوام",7,"م",1,0],["وَمَا أَحْلاَهُ أَبْيَضَ غَيْرَ حُرٍّ","عَفِيفَ الْفَكِّ وَضَّاحَ الُجَبِينِ",8,"ن",1,0],["وَمَا احْتِيَارُكَ عَبْداً مِحْرَباً خَشِناً","مِنَ البَدَاوَةِ فَظَّ اللَّوْنِ وَالأَدَمِ",9,"م",1,0],["وما أحتاج القويّ إلى مُعين","إذا كان الضعيف هو المُقاوي",10,"ي",1,0],["وَما أَحسَنَ التَيمِيُّ في جاهِلِيَّةٍ","مُنادَمَةَ الجَبّارِ فَوقَ النَمارِقِ",11,"ق",1,0],["وَما أَحسنَ في مِثلِ","كَ أَن يَنتَهِكَ السِترُ",12,"ر",1,0],["وما أحدثَ العَصْران شيئاً نكرْتُه","هما الواهبان السالبان هما هُما",13,"م",2,0],["وما احتجزتْ مني لُهاهُ بحاجزٍ","ولا احتجبتْ عني هناك بحاجبِ",14,"ب",1,0],["وما أَحَارُ على أنِّي تُحَيَّرني","أطْبَاقُ ليل كَثيف السُّد مَنْضُودِ",15,"د",1,0],["وما أُحابيكَ في المديح ولا","شِيدتْ معاليكَ بالأقاويلِ",16,"ل",1,0],["وما أحدثَ العصران شيئاً نكرتُهُ","هما الواهبان الساليان هما هما",17,"م",2,0],["وما أحسن النُّعمى إذا هي جاورت","فتىً يحفظ النعمى ويبني المكارما",18,"م",2,0],["وما أحبُّ الواعدي مُخلفاً","كَلّا ولا الممتنَّ مَنّانا",19,"ن",2,0],["وما أحالوا على ضَحْل ولا ثَمِدٍ","ولا تَظَنَّوْا بغيبٍ ظنَّ تَشْبيه",20,"ي",2,0],["وما احتالَ إلا بعدما عيلَ صبرُه","وأَوْلى بداهٍ أن يُخادعَ داهيا",21,"ي",2,0],["وَما أَحَدٌ تَنجو مِنَ المَوتِ نَفسُهُ","وَلَو اِنَّهُ فَوقَ السَماكينِ أُصعِدا",22,"د",2,0],["وَما أُحَيلى الجَواري الماخِراتِ بِهِ","تَقُلُّ مِن أَرضِهِ أَحلى جَوارِبُها",23,"ه",2,0],["وَما أَحسَنَ أَن نَر","جِعَ لِلوَصلِ كَما كُنّا",24,"ن",2,0],["وَما أَحدَثَ النَأيُ المُفَرِّقُ بَينَنا","سُلُوّاً وَلا طولُ اِجتِماعٍ تَقالِيا",25,"ي",2,0],["وَما أَحَدٌ يُخَلَّدُ في البَرايا","بَلِ الدُنيا تَؤولُ إِلى زَوالِ",26,"ل",1,0],["وَما اِحتَمى بِالماءِ وَالدِحالِ","مِنَ الحَرامِ اللَحمِ وَالحَلالِ",27,"ل",1,0],["وَما أَحَدٌ إِذا الأَقوامُ عَدّوا","عُروقَ الأَكرَمينَ إِلى التُرابِ",28,"ب",1,1],["وَما اِحتالَ مُحتالٌ كَحيلَتِهِ الَّتي","بِها نَفسَهُ تَحتَ الضَريحَةِ أَولَجا",29,"ج",2,0],["وَما أَحَدٌ ذو فاقَةٍ كانَ مِثلَنا","إِلَيهِ وَلَكِن لا بَقِيَّةَ لِلدَهرِ",30,"ر",1,0],["وَما أَحَدٌ إِلّا الخَليفَةُ مِثلُهُ","يَموتُ وَلا واراهُ مُنتَضَدُ القَبرُ",31,"ر",1,0],["وَما أَحَدٌ مُعطىً عَطاءً كَنَفسِهِ","إِذا نَشِبَت مَكظومَةٌ بِالخَوائِفِ",32,"ف",1,0],["وَما أَحَدٌ كانَ المَنايا وَراءَهُ","وَلَو عاشَ أَيّاماً طِوالاً بِسالِمِ",33,"م",1,0],["وَما أَحَدٌ يُساميني بِفَخرٍ","إِذا زَخَرَت بُحورُ بَني تَميمِ",34,"م",1,0],["وَما أَحَدٌ مِن فَخرِنا بِالَّذي لَنا","عَلى الناسِ مِمّا يَعرِفونَ بِراغِمِ",35,"م",1,0],["وَما أَحَدٌ مِمَّن هَجاني عَلِمتُهُ","يَكونُ وَفاءً عِرضُهُ لي بِدائِمِ",35,"م",1,0],["وَما أَحَدٌ مِن غَيرِهِم بِطَريقِهِم","مِنَ الناسِ إِلّا مِنهُمُ بِمُقيمِ",36,"م",1,0],["وَما أَحدَثَت أَيدي الزَمانِ إِساءَةً","وَوافَيتُهُم إِلّا اِنتَقَمتُ مِنَ الدَهرِ",37,"ر",1,0],["وَما أَحَدٌ طارَ الفِراقُ بِقَلبِهِ","بِجَلدٍ وَلَكِنَّ الفِراقَ هُوَ الجَلدُ",38,"د",1,0],["وما أَحَدٌ منهم على الصَّرْفِ صابِرٌ","ولا أَحَدٌ منهم على الذُّلِّ أَصْبَرُ",39,"ر",1,0],["وَمَا أَحَدٌ أَحَقَّ بأَخْذِ مَالٍ","مِنَ الأتْرَاكِ وَالمُتَجَنِّدِينا",40,"ن",2,0],["وما أحاطَ بهِ العِلْمُ المُحِيطُ وَما","جَرَى بهِ القَلَمُ المَأمُونُ وَالقَدَرُ",41,"ر",1,0],["وَما أَحسَنَ في مِثلِ","كَ أَن يَنهَتِكَ السَترُ",42,"ر",1,0],["وَما أَحسُدُكَ الحُسنَ","ولَكِن أَحسُدُ المِئزَر",43,"ر",1,0],["وَما أَحوَجَني صاحِ","إِلى حَمّامِ حَمّادَه",44,"د",2,0],["وَما اِحتَجَبتَ عَنِ الأَقوامِ مِن نُسُكٍ","وَإِنَّما أَنتَ لِلنَكراءِ مُحتَجِبُ",45,"ب",1,0],["وَما أَحرَزَت نَفسَ المُدَجَّجِ في الوَغى","مُضَبِّرَةٌ يَستَأسِرُ الوَحشُ ضَبرُها",46,"ر",3,0],["وَما اِحتِيالِيَ في الأَقدارِ إِن جَعَلَت","عَصبَ التِجارِ لِشُعثِ الهامِ سُرّاقِ",47,"ق",1,0],["وَما أَحَدٌ مُعطِيَّ وَاللَهُ حارِمي","وَلا حارِمي شَيئاً إِذا هُوَ أَعطاني",48,"ن",2,0],["وما أحيلى الجواري الماخرات به","تقلّ من أإرضه أحلى جواريها",49,"ي",3,0],["ومَا أَحَدٌ حيٌّ وإنْ عاشَ سالِماً","بأخْلَدَ ممَّنْ غَيَّبتْهُ المقابِرُ",50,"ر",1,0],["وَمَا أَحْسَبُ الأَيَّامَ تَصْفُو لِعَاقِلٍ","وَلَكِنْ صَفَاءُ الْعَيْشِ لِلْجَاهِلِ الْغُمْرِ",51,"ر",1,0],["وَمَا أَحَسنَّ الرُّوحَ إِنْ","نَاسَمَهَا مِنْهُ عَبَقَّ",52,"ق",1,0],["وما احتيالك في الروح التي تعبت؟","وما احتيالك في القلب الذي انفطرا؟",53,"ر",2,0],["وما احتيالك في الأيام توسعني","حرباً .. وتسألني: من يا ترى انتصرا؟!",53,"ر",2,0],["وما أحوجَ القلبَ الذكيَّ لعيشةٍ","يَعِنُّ بها فِكْرٌ ويَسْبَحُ خاطر",54,"ر",1,0],["وما أحلى الغصونَ إذا تهادت","عليها نُكَّسَ الأطراف مِيلا",55,"ل",2,0],["وَمَا أَحْبَبْتُ أَرْضَكُمُ وَلكِنْ","أقَبِّلُ إثْرَ مَنْ وَطِىء التُّرَابَا",56,"ب",2,1],["وَمَا أَحْرزَتْ مِنْ أَهْلِهَا غَيْرَ يُتْمِهَا","وَأَشْقَى اليَتَامَى فَاقِدُ البِرِّ فِي الأَهْلِ",57,"ل",1,0],["وَما أَحَدٌ يَؤمّ ذراك يَوماً","فَيَختار التَرحّلَ عَن ذراكا",58,"ك",2,0],["وما احيلا لفظه","كلامه كماله",59,"ل",2,0],["وما احتقرت فقيراً قط أو سقطت","عند الغنى طباعي مثل مكتسب",60,"ب",1,0],["وما أحد باقٍ وسوف يضمنا","وإياك بطن الأرض وهي جسوم",61,"م",1,0],["وَما أَحسَنَ العافي بِعَينِكَ قادِماً","وَأَقبَحَهُ فيها إِذا هُوَ وَدَّعا",62,"ع",2,0],["وما أحد بصوم سواه يجزى","وأنت تثاب في صوم الأنام",63,"م",1,0],["وما أحسن الإنسان يأمر بالهدى","ويترك فحش القول عند التجاور",64,"ر",1,0],["وَما أَحَدٌ مِن أَلسُنِ الناسِ سالِما","وَلَو أَنَّهُ ذاكَ النَبِيُّ المُطَهَّرُ",65,"ر",1,1],["وَما اِحتيجَ منهُ لاِجتهادٍ فإنّنا","بِأحكامهِ نَقفو أئمّتنا الغرّا",66,"ر",2,0],["وما أحمقَ الشاةَ استغرتْ بظلفها","إذا حسبتْ أنّ الشياهَ ذئابُ",67,"ب",1,0],["وما احتجتُ قطُّ إلى ناصرٍ","ولا رُحتُ يوماً ضعيفَ القُوى",68,"ا",1,0],["وَمَا أَحمَد الأَحوالِ إِلا كَقابِض","عَلَى جَرة بِالكَف من ساعد السعدِ",69,"د",1,0],["وَما أَحْيَا النَّدى إلا إمامٌ","قَؤُولٌ كُلَّ صالِحَة فَعولُ",70,"ل",1,0],["وَما أَحَدٌ في الحُبِّ مِثلي قَناعَةً","رَضيتُ بِوَعدٍ مِنهُ يُكثِرُ مَطلَهُ",71,"ل",2,0],["وَما اِحتِراسي وَفَضلُ اللَهِ مُتَّسَعٌ","إِلّا مِنَ الرَدِّ إِن لَم تَرجِ عِطفَتُهُ",72,"ت",2,0],["وَمَا أَحَدٌ لابْنِ الوَجِيهِ بِلا حِقٍ","إذا امتَدَّ شَوْطٌ في المكارِمِ أوْ نَهْجُ",73,"ج",1,0],["وَما اِحتَجَبَت بِغَيري في عِياني","لِذاكَ شَهِدتُ فيها وَصفَ ذاتي",74,"ت",2,0],["وَما اِحتَجَبَت عَنّي بِغَيري وَلا بَدَت","بِغَيرِ حِجابٍ عِندَما لي تَبَدَّتِ",75,"ت",1,0],["وما أحمَدتُ منه سِوَى مُقامٍ","بِتُدمِيرٍ أقَلَّ مِنَ القَلِيلِ",76,"ل",1,0],["وما أحمدُ بنُ الفَضْلِ بالمُقْتِني سِوَى","مَحامِدَ من أيّامهِ وفَضائل",77,"ل",1,0],["وَما أَحصَتِ الكُتْبُ الكِبارُ صِغارَها","وَلَو حَوَتِ الكُتْبُ الَّذي حَوَتِ الكُتْبُ",78,"ب",1,0],["وَما أَحدٌ لاقَى مِن الحبِّ لَوعَةً","رآني فَلَم أُشغِلهُ عَن ذِكرِ ما لَقي",79,"ق",2,0],["وما أحسبُ الأيامَ أيام هَجرِها","تطاولُني إلا لتقصيرِ مُدَّتي",80,"ت",2,0],["وما أحد ينفي اختيار مكلف","سوى جَهْمٍ الآتي بكل عجيبة",81,"ه",1,0],["وَما أَحَدٌ في كتَبةٍ أَو كَتيبَةٍ","بأَسجَعَ مِنهُ في الكِتابِ وَأَشجَعا",82,"ع",2,0],["ومَا أحسَبُ الأيّامَ تَقنُع بالنّوَى","ولا أنَّ صَرفَ الدّهرِ بالفُرقةِ اُشْتَفَى",83,"ف",2,0],["وما احتيالُ الفَتى إذا عثَر ال","جَدُّ وزَلَّت بسَعيِهِ القَدَمُ",84,"م",1,0],["وَما أَحجَمَ الأَعداءُ عَنكَ بَقِيَّةً","عَلَيكَ وَلكِن لَم يَرَوا فيكَ مَطمَعا",85,"ع",2,0],["وما احتاج النهار إلى دليل","وقد شَهِدَتْ به منه شهود",86,"د",1,0],["وما أحد حال التباعد دونهُ","يأبعد ممن قد تغيّب في القبر",87,"ر",1,0],["وما احتملتم وصوليا يراودكم","غنم الدنيء له الأحرار قربان",88,"ن",1,0],["وما أحَلّوا وما أهَلّوا","بحِجّةٍ بعد عُمرتينِ",89,"ن",1,0],["وما أحرزتْ نفسٌ تُقاها شعارُها","لذخرِ غدٍ من فطرِها وصيامِها",90,"م",3,0],["وما أحسّتْ أنّ رب","عَ الهمِّ قد أمَحَّا",91,"ح",2,0],["وما احمرَّ دمعُ العين لولا صبابةٌ","بحمرِ الحلى بيضِ الطلى والترائ",92,"ا",2,0],["وما أحنفٌ إلاَّ أناتك والحجى","ولا حاتمٌ إلا ندى كفّكَ الغمر",93,"ر",1,0],["وما أحدٌ في الوجدِ مِنْ وِقْفَةِ الهوى","وشكوى تباريحِ الغرامِ مُسَلَّمُ",94,"م",1,0],["وما احتاج للإعجاز إلا الذي تحد","ى بالنبوات غدوة والأصائل",95,"ل",1,0],["وما أحظى من الحسناء إلا","بما يحظى الشجي من الخلايا",96,"ا",3,0],["وما أُحَيْلى كُؤوساً أُترِعَتْ وجلَتْ","من خمرِهِ مشرباً فوْزاً لمن شَرِبَا",97,"ب",2,0],["وما اِحتَفلتُ بشئٍ ظلّ يبذله","لأنّ أكثرَ منه في يديّ ولِي",98,"ل",2,0],["وما احتجَبَتْ لوائِحُهُ فكانت","كضَوءِ الفجرِ دُونَ الشَّمس بادِ",99,"د",1,0],["وما أَحْسَن الوردَ الَّذِي فوق خدِّها","ولو أَنَّني قبَّلتُه كان أَحْسَنا",100,"ن",2,0],["وما أحلى الحياة بلا هموم","تساور صاحب النفس الأبيه",101,"ي",2,0],["وَما أحَقَّ كِرامَ القَومِ لَو حُصِدُوا","عَقراً بِقَبرِك دُونَ الخَيلِ والإبِلِ",102,"ل",1,0],["وَما احتَدَمَ الرَّدى والرَّوعُ إلاَّ","تَصلاَّهُ ليظفَرَ باحتِراقِ",103,"ق",1,0],["وما أحمَدُ الدنيا لكونِ كباشها","غدت طمعاً مقسومة لنعاجها",104,"ج",3,0],["وما احْتَدَى الموتُ نَفْساً من نُفُوسِهِمُ","إلاَّ وَسَيْفُكَ كَعْبُ الجُوْدِ أو هَرِمُ",105,"م",1,0],["وما أحسن العفو من قادر","إذا ما اشتفى حاقد وانتقم",106,"م",1,0],["وما أحثك في حق الجوار له","وكيف أوضح معنى منك واضحه",107,"ح",2,0],["وما أحسنَ أسمائ","يَ إِلا ما تسميني",108,"ن",2,0],["وَما أَحسن الأَغصانِ في الرّوضِ وَالرّبى","وَفي حُسنِها سَرحُ العُيونِ نُسيمُ",109,"م",1,1],["وَما أَحدَثوا مِن بِدعَةٍ وَعَظيمَةٍ","مِنَ القَولِ لَم تَصعَدَ إِلى اللَهِ مَصعَدا",110,"د",2,0],["وَمَا أَحْياهُ منْ سُنَن تَعَفَّتْ","فَدَارَ صَلاَ حُهَا دَوْرَ الدَّمُوك",111,"ك",1,0],["وما أحد في الناس إلا وعيشه","كعيشك لكن يجهلون وتعلم",112,"م",1,0],["وما أحد في الملك يبقى مخلداً","وما أحد مما قضى اللّه يسلم",113,"م",1,0],["وَما أَحَد أَرجو لِكَشف ملمتي","سِواك فَبلغني الَّذي كُنتُ طالِبا",114,"ب",2,0],["وما أَحدٌ لليُوسفَيْنِ بِثَالثٍ","سِواكَ وللبِكْرَينِ والشَّمسِ والبَدْرِ",115,"ر",1,0],["وما احتساها يزيدني عجباً","وإنما تركُها من العجب",116,"ب",1,0],["وما أحدٌ نال العَلاءَ بحقّه","وأدركه دونَ الرِّجالِ بجَهْدِه",117,"د",2,0],["وما أحسَبُ الحُمَّى وإن جلَّ قدرُها","لتَجسُر أن تدَنو إلى مَنبَعِ المجدِ",118,"د",1,0],["وما أحسن الخل الكريم إذا غدا","يدين بدين الحب لم يك يرتدُّ",119,"د",1,0],["وما أحسن الدرّ النظيم هدية","لعرسٍ جليل حيث تزجى الذخائرُ",120,"ر",1,0],["وما أحدٌ إلاَّ ويُقبَرُ ميتاً","وها أنا ذا حيٌّ قُبرت بمنزلي",121,"ل",2,0],["وما أحلى انزعاجَكَ من ديار","تُضيع النابغون بها الحِقابا",122,"ب",2,0],["وما احمرَّ إلا من صِيالِكَ مَعْرَكٌ","ولا اخْضَرَّ إلا من نَداكَ جَنَاب",123,"ب",1,0],["وَما أَحَدٌ حَيٌّ تَأَخَّرَ يَومُهُ","بِأَخلَدَ مِمَّن صارَ قَبلُ إِلى الرَجمِ",124,"م",1,0],["وما أحلى مقالك يا صديقي","على مال أضعت مع الندامه",125,"م",2,0],["وما أحدٌ منا إذا جاز حدَّه","إلى ضدِّه يلتذ فيه فإن امنا",126,"ن",2,0],["وما أحد تعنو له أوجه العُلى","سواه كما قلناه والأحد الله",127,"ل",2,0],["وما احتجبت الا برفع حجابها","ومن عجب ان الظهور تستر",128,"ر",1,0],["وما احتجب الألفان إلا بهيِّن","هما الآن أدنى مهما قبل ذَالِكا",129,"ك",2,1],["وما احمرّ خدّ السيف إلا وأصبحت","رقابهم شوقاً لتقبيله تصبو",130,"ب",2,0],["وما أحبب الترحال لولا محمدٌ","أمَامي ومن يبغى من الحق معدِلا",131,"ل",2,0],["وما أحظك تحريضا على كرمٍ","أنت الجوادُ ومِنْك الجودُ يُنتحل",132,"ل",1,0],["وما احتقرنا نصيباً أخرجته لنا","ولا ابتغينا لها حرمان أهلينا",133,"ن",2,0]