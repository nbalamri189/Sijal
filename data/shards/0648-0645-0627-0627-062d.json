{"poems":[[108,"هوينك بالغيور من الرجال","https://www.shoaraa.com/p13817",""],[108,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"أبا حسن أتحسب أن شوقي","https://www.aldiwan.net/poem30699.html","الوافر"],[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[34,"وما أحببت أرضكم ولكن","https://www.aldiwan.net/poem4872.html","الوافر"],[82,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[93,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[93,"ماذا تصباك من حال تجددها","https://www.aldiwan.net/poem11314.html","البسيط"],[88,"أرى بغداد من بعد أغبرار","https://www.aldiwan.net/poem44976.html","الوافر"],[27,"يا تيم ما القارون في شدة القرى","https://www.aldiwan.net/poem5937.html","الطويل"],[64,"ويا من ريقه خمر","https://www.aldiwan.net/poem67560.html","الهزج"],[51,"سلوت شبابي والرضاع كليهما","https://www.aldiwan.net/poem8119.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[51,"يا حسن الوجه والشمائل","https://www.aldiwan.net/poem65926.html","المنسرح"],[51,"سلوت الرضاع والشباب كليهما","https://www.aldiwan.net/poem66058.html","الطويل"],[51,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[51,"قرأت في وجهك عنوانا","https://www.aldiwan.net/poem66470.html","المنسرح"],[51,"علي دين ثقيل أنت قاضيه","https://www.aldiwan.net/poem66716.html","البسيط"],[51,"أرى ابن حريث لا يبالي عضيهتي","https://www.aldiwan.net/poem66736.html","الطويل"],[91,"فديناك لو ان الردى قبل الفدا","https://www.aldiwan.net/poem8811.html","عموديه"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[70,"من اليوم تعارفنا","https://www.aldiwan.net/poem42673.html","الهزج"],[32,"أتاني عن مروان بالغيب أنه","https://www.aldiwan.net/poem27812.html","الطويل"],[43,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[28,"وما أحد إذا الأقوام عدوا","https://www.aldiwan.net/poem4948.html","الوافر"],[28,"لما رأيت الأرض قد سد ظهرها","https://www.aldiwan.net/poem4968.html","الطويل"],[28,"أعيني إلا تسعداني ألمكما","https://www.aldiwan.net/poem5085.html","الطويل"],[28,"مات الذي يرعى حمى الدين والذي","https://www.aldiwan.net/poem5149.html","الطويل"],[28,"ولست بناس فضل مروان ما دعت","https://www.aldiwan.net/poem5320.html","الطويل"],[28,"بفي الشامتين الصخر إن كان مسني","https://www.aldiwan.net/poem5519.html","الطويل"],[28,"ديار بالأجيفر كان فيها","https://www.aldiwan.net/poem5591.html","الوافر"],[28,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[28,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[66,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[44,"تجرع أسى قد أقفر الجرع الفرد","https://www.aldiwan.net/poem30542.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[67,"يا رب صل على المختار من مضر","https://www.aldiwan.net/poem18126.html","البسيط"],[48,"أيا من طرفه سحر","https://www.aldiwan.net/poem63339.html","الهزج"],[50,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[50,"منعت الغسل في الحمام","https://www.aldiwan.net/poem63912.html","الهزج"],[46,"لا يغبطن أخو نعمى بنعمته","https://www.aldiwan.net/poem22083.html","البسيط"],[46,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[46,"لقد فنيت وهل تبقى إذا عمرت","https://www.aldiwan.net/poem23055.html","البسيط"],[46,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/142152","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72199","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55064","الرجز"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199494","البسيط"],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[34,"وَمَا أَحْبَبْتُ أَرْضَكُمُ وَلكِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=22450",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[112,"عجبت لمن يراك وبعد هذا","https://www.aldiwan.net/poem2371.html","الوافر"],[116,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[116,"شهامة الطبع قادتني إلى الأدب","https://www.aldiwan.net/poem41721.html","البسيط"],[121,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[144,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[161,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[165,"وما أحد من ألسن الناس سالما","https://www.aldiwan.net/poem67903.html","الطويل"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[200,"مدادك في ثغر الزمان رضاب","https://www.aldiwan.net/poem45382.html","الطويل"],[230,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[276,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[276,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[283,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[321,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[349,"يخاطبني قم فاقض حقي مثله","https://www.aldiwan.net/poem19941.html","الطويل"],[350,"صفاء الذات منها إذا تجلت","https://www.aldiwan.net/poem15544.html","الوافر"],[350,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[358,"أبثك أم أصونك يا خليلي","https://www.aldiwan.net/poem4150.html","الوافر"],[365,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[367,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[372,"لئن صدقت في وعدها أن سنلتقي","https://www.aldiwan.net/poem57268.html","الطويل"],[372,"توق إذا ما حرمة العدل جلت","https://www.aldiwan.net/poem57518.html","الطويل"],[404,"نعم قد قضى ربي بما هو كائن","https://www.aldiwan.net/poem34099.html","الطويل"],[407,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[410,"مواصلتي كتبي إليك تزيدني","https://www.aldiwan.net/poem32266.html","الطويل"],[410,"أقصر فلومي في حبهم لمم","https://www.aldiwan.net/poem32542.html","المنسرح"],[411,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[417,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[438,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[454,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[459,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[459,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[465,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[465,"أهذا ثناء من كلامك أم سحر","https://www.aldiwan.net/poem3297.html","عموديه"],[478,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[483,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[496,"كذا من شام بارقة الثنايا","https://www.aldiwan.net/poem10288.html","الوافر"],[501,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[552,"أتاركي أتلافى اليأس بالأمل","https://www.aldiwan.net/poem47294.html","الطويل"],[563,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[576,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"]],"verses":[["وما إحياء ميتٍ من قبور ٍ","كإحياء النفوس من الضلال",0,"ل",1,0],["وما احتجاجُ الورى بالعقلِ نافعُهم","ما دام منهم فؤادٌ بالهوى فُئِدا",1,"د",2,0],["وَما اِحتَشَمَت مِن يَدَيَّ النُصو","لُ إِلّا مَهَزَّةَ نَصلٍ كَهامِ",2,"م",1,0],["وَما اِحتاجَ بُرداً غَيرَ بُردِ عَفافِهِ","وَلا عَرفَ طيبٍ غَيرَ تِلكَ الخَلائِقِ",3,"ق",1,0],["وَما أَحظى إِذا ما غِبتَ عَنّي","بِحُسنٍ لِلزَمانِ وَلا بِطيبِ",4,"ب",1,0],["وَما أَحدَثَ الدَهرُ مِن نَبوَةٍ","وَقَطَّعَ ما بَينَنا مِن سَبَب",5,"ب",1,0],["وَما أَحبَبتُ أَرضَكُم وَلَكِن","أُقَبِّلُ إِثرَ مَن وَطِئَ التُرابا",6,"ب",2,1],["وما أحلى الوصال لو انّ شيئا","من الدنيا للذّته دوام",7,"م",1,0],["وَمَا أَحْلاَهُ أَبْيَضَ غَيْرَ حُرٍّ","عَفِيفَ الْفَكِّ وَضَّاحَ الُجَبِينِ",8,"ن",1,0],["وَمَا احْتِيَارُكَ عَبْداً مِحْرَباً خَشِناً","مِنَ البَدَاوَةِ فَظَّ اللَّوْنِ وَالأَدَمِ",9,"م",1,0],["وما أحتاج القويّ إلى مُعين","إذا كان الضعيف هو المُقاوي",10,"ي",1,0],["وَما أَحسَنَ التَيمِيُّ في جاهِلِيَّةٍ","مُنادَمَةَ الجَبّارِ فَوقَ النَمارِقِ",11,"ق",1,0],["وَما أَحسنَ في مِثلِ","كَ أَن يَنتَهِكَ السِترُ",12,"ر",1,0],["وما أحدثَ العَصْران شيئاً نكرْتُه","هما الواهبان السالبان هما هُما",13,"م",2,0],["وما احتجزتْ مني لُهاهُ بحاجزٍ","ولا احتجبتْ عني هناك بحاجبِ",14,"ب",1,0],["وما أَحَارُ على أنِّي تُحَيَّرني","أطْبَاقُ ليل كَثيف السُّد مَنْضُودِ",15,"د",1,0],["وما أُحابيكَ في المديح ولا","شِيدتْ معاليكَ بالأقاويلِ",16,"ل",1,0],["وما أحدثَ العصران شيئاً نكرتُهُ","هما الواهبان الساليان هما هما",17,"م",2,0],["وما أحسن النُّعمى إذا هي جاورت","فتىً يحفظ النعمى ويبني المكارما",18,"م",2,0],["وما أحبُّ الواعدي مُخلفاً","كَلّا ولا الممتنَّ مَنّانا",19,"ن",2,0],["وما أحالوا على ضَحْل ولا ثَمِدٍ","ولا تَظَنَّوْا بغيبٍ ظنَّ تَشْبيه",20,"ي",2,0],["وما احتالَ إلا بعدما عيلَ صبرُه","وأَوْلى بداهٍ أن يُخادعَ داهيا",21,"ي",2,0],["وَما أَحَدٌ تَنجو مِنَ المَوتِ نَفسُهُ","وَلَو اِنَّهُ فَوقَ السَماكينِ أُصعِدا",22,"د",2,0],["وَما أُحَيلى الجَواري الماخِراتِ بِهِ","تَقُلُّ مِن أَرضِهِ أَحلى جَوارِبُها",23,"ه",2,0],["وَما أَحسَنَ أَن نَر","جِعَ لِلوَصلِ كَما كُنّا",24,"ن",2,0],["وَما أَحدَثَ النَأيُ المُفَرِّقُ بَينَنا","سُلُوّاً وَلا طولُ اِجتِماعٍ تَقالِيا",25,"ي",2,0],["وَما أَحَدٌ يُخَلَّدُ في البَرايا","بَلِ الدُنيا تَؤولُ إِلى زَوالِ",26,"ل",1,0],["وَما اِحتَمى بِالماءِ وَالدِحالِ","مِنَ الحَرامِ اللَحمِ وَالحَلالِ",27,"ل",1,0],["وَما أَحَدٌ إِذا الأَقوامُ عَدّوا","عُروقَ الأَكرَمينَ إِلى التُرابِ",28,"ب",1,1],["وَما اِحتالَ مُحتالٌ كَحيلَتِهِ الَّتي","بِها نَفسَهُ تَحتَ الضَريحَةِ أَولَجا",29,"ج",2,0],["وَما أَحَدٌ ذو فاقَةٍ كانَ مِثلَنا","إِلَيهِ وَلَكِن لا بَقِيَّةَ لِلدَهرِ",30,"ر",1,0],["وَما أَحَدٌ إِلّا الخَليفَةُ مِثلُهُ","يَموتُ وَلا واراهُ مُنتَضَدُ القَبرُ",31,"ر",1,0],["وَما أَحَدٌ مُعطىً عَطاءً كَنَفسِهِ","إِذا نَشِبَت مَكظومَةٌ بِالخَوائِفِ",32,"ف",1,0],["وَما أَحَدٌ كانَ المَنايا وَراءَهُ","وَلَو عاشَ أَيّاماً طِوالاً بِسالِمِ",33,"م",1,0],["وَما أَحَدٌ يُساميني بِفَخرٍ","إِذا زَخَرَت بُحورُ بَني تَميمِ",34,"م",1,0],["وَما أَحَدٌ مِن فَخرِنا بِالَّذي لَنا","عَلى الناسِ مِمّا يَعرِفونَ بِراغِمِ",35,"م",1,0],["وَما أَحَدٌ مِمَّن هَجاني عَلِمتُهُ","يَكونُ وَفاءً عِرضُهُ لي بِدائِمِ",35,"م",1,0],["وَما أَحَدٌ مِن غَيرِهِم بِطَريقِهِم","مِنَ الناسِ إِلّا مِنهُمُ بِمُقيمِ",36,"م",1,0],["وَما أَحدَثَت أَيدي الزَمانِ إِساءَةً","وَوافَيتُهُم إِلّا اِنتَقَمتُ مِنَ الدَهرِ",37,"ر",1,0],["وَما أَحَدٌ طارَ الفِراقُ بِقَلبِهِ","بِجَلدٍ وَلَكِنَّ الفِراقَ هُوَ الجَلدُ",38,"د",1,0],["وما أَحَدٌ منهم على الصَّرْفِ صابِرٌ","ولا أَحَدٌ منهم على الذُّلِّ أَصْبَرُ",39,"ر",1,0],["وَمَا أَحَدٌ أَحَقَّ بأَخْذِ مَالٍ","مِنَ الأتْرَاكِ وَالمُتَجَنِّدِينا",40,"ن",2,0],["وما أحاطَ بهِ العِلْمُ المُحِيطُ وَما","جَرَى بهِ القَلَمُ المَأمُونُ وَالقَدَرُ",41,"ر",1,0],["وَما أَحسَنَ في مِثلِ","كَ أَن يَنهَتِكَ السَترُ",42,"ر",1,0],["وَما أَحسُدُكَ الحُسنَ","ولَكِن أَحسُدُ المِئزَر",43,"ر",1,0],["وَما أَحوَجَني صاحِ","إِلى حَمّامِ حَمّادَه",44,"د",2,0],["وَما اِحتَجَبتَ عَنِ الأَقوامِ مِن نُسُكٍ","وَإِنَّما أَنتَ لِلنَكراءِ مُحتَجِبُ",45,"ب",1,0],["وَما أَحرَزَت نَفسَ المُدَجَّجِ في الوَغى","مُضَبِّرَةٌ يَستَأسِرُ الوَحشُ ضَبرُها",46,"ر",3,0],["وَما اِحتِيالِيَ في الأَقدارِ إِن جَعَلَت","عَصبَ التِجارِ لِشُعثِ الهامِ سُرّاقِ",47,"ق",1,0],["وَما أَحَدٌ مُعطِيَّ وَاللَهُ حارِمي","وَلا حارِمي شَيئاً إِذا هُوَ أَعطاني",48,"ن",2,0],["وما أحيلى الجواري الماخرات به","تقلّ من أإرضه أحلى جواريها",49,"ي",3,0],["ومَا أَحَدٌ حيٌّ وإنْ عاشَ سالِماً","بأخْلَدَ ممَّنْ غَيَّبتْهُ المقابِرُ",50,"ر",1,0],["وَمَا أَحْسَبُ الأَيَّامَ تَصْفُو لِعَاقِلٍ","وَلَكِنْ صَفَاءُ الْعَيْشِ لِلْجَاهِلِ الْغُمْرِ",51,"ر",1,0],["وَمَا أَحَسنَّ الرُّوحَ إِنْ","نَاسَمَهَا مِنْهُ عَبَقَّ",52,"ق",1,0],["وما احتيالك في الروح التي تعبت؟","وما احتيالك في القلب الذي انفطرا؟",53,"ر",2,0],["وما احتيالك في الأيام توسعني","حرباً .. وتسألني: من يا ترى انتصرا؟!",53,"ر",2,0],["وما أحوجَ القلبَ الذكيَّ لعيشةٍ","يَعِنُّ بها فِكْرٌ ويَسْبَحُ خاطر",54,"ر",1,0],["وما أحلى الغصونَ إذا تهادت","عليها نُكَّسَ الأطراف مِيلا",55,"ل",2,0],["وَمَا أَحْبَبْتُ أَرْضَكُمُ وَلكِنْ","أقَبِّلُ إثْرَ مَنْ وَطِىء التُّرَابَا",56,"ب",2,1],["وَمَا أَحْرزَتْ مِنْ أَهْلِهَا غَيْرَ يُتْمِهَا","وَأَشْقَى اليَتَامَى فَاقِدُ البِرِّ فِي الأَهْلِ",57,"ل",1,0],["وَما أَحَدٌ يَؤمّ ذراك يَوماً","فَيَختار التَرحّلَ عَن ذراكا",58,"ك",2,0],["وما احيلا لفظه","كلامه كماله",59,"ل",2,0],["وما احتقرت فقيراً قط أو سقطت","عند الغنى طباعي مثل مكتسب",60,"ب",1,0],["وما أحد باقٍ وسوف يضمنا","وإياك بطن الأرض وهي جسوم",61,"م",1,0],["وَما أَحسَنَ العافي بِعَينِكَ قادِماً","وَأَقبَحَهُ فيها إِذا هُوَ وَدَّعا",62,"ع",2,0],["وما أحد بصوم سواه يجزى","وأنت تثاب في صوم الأنام",63,"م",1,0],["وما أحسن الإنسان يأمر بالهدى","ويترك فحش القول عند التجاور",64,"ر",1,0],["وَما أَحَدٌ مِن أَلسُنِ الناسِ سالِما","وَلَو أَنَّهُ ذاكَ النَبِيُّ المُطَهَّرُ",65,"ر",1,1],["وَما اِحتيجَ منهُ لاِجتهادٍ فإنّنا","بِأحكامهِ نَقفو أئمّتنا الغرّا",66,"ر",2,0],["وما أحمقَ الشاةَ استغرتْ بظلفها","إذا حسبتْ أنّ الشياهَ ذئابُ",67,"ب",1,0],["وما احتجتُ قطُّ إلى ناصرٍ","ولا رُحتُ يوماً ضعيفَ القُوى",68,"ا",1,0],["وَمَا أَحمَد الأَحوالِ إِلا كَقابِض","عَلَى جَرة بِالكَف من ساعد السعدِ",69,"د",1,0],["وَما أَحْيَا النَّدى إلا إمامٌ","قَؤُولٌ كُلَّ صالِحَة فَعولُ",70,"ل",1,0],["وَما أَحَدٌ في الحُبِّ مِثلي قَناعَةً","رَضيتُ بِوَعدٍ مِنهُ يُكثِرُ مَطلَهُ",71,"ل",2,0],["وَما اِحتِراسي وَفَضلُ اللَهِ مُتَّسَعٌ","إِلّا مِنَ الرَدِّ إِن لَم تَرجِ عِطفَتُهُ",72,"ت",2,0],["وَمَا أَحَدٌ لابْنِ الوَجِيهِ بِلا حِقٍ","إذا امتَدَّ شَوْطٌ في المكارِمِ أوْ نَهْجُ",73,"ج",1,0],["وَما اِحتَجَبَت بِغَيري في عِياني","لِذاكَ شَهِدتُ فيها وَصفَ ذاتي",74,"ت",2,0],["وَما اِحتَجَبَت عَنّي بِغَيري وَلا بَدَت","بِغَيرِ حِجابٍ عِندَما لي تَبَدَّتِ",75,"ت",1,0],["وما أحمَدتُ منه سِوَى مُقامٍ","بِتُدمِيرٍ أقَلَّ مِنَ القَلِيلِ",76,"ل",1,0],["وما أحمدُ بنُ الفَضْلِ بالمُقْتِني سِوَى","مَحامِدَ من أيّامهِ وفَضائل",77,"ل",1,0],["وَما أَحصَتِ الكُتْبُ الكِبارُ صِغارَها","وَلَو حَوَتِ الكُتْبُ الَّذي حَوَتِ الكُتْبُ",78,"ب",1,0],["وَما أَحدٌ لاقَى مِن الحبِّ لَوعَةً","رآني فَلَم أُشغِلهُ عَن ذِكرِ ما لَقي",79,"ق",2,0],["وما أحسبُ الأيامَ أيام هَجرِها","تطاولُني إلا لتقصيرِ مُدَّتي",80,"ت",2,0],["وما أحد ينفي اختيار مكلف","سوى جَهْمٍ الآتي بكل عجيبة",81,"ه",1,0],["وَما أَحَدٌ في كتَبةٍ أَو كَتيبَةٍ","بأَسجَعَ مِنهُ في الكِتابِ وَأَشجَعا",82,"ع",2,0],["ومَا أحسَبُ الأيّامَ تَقنُع بالنّوَى","ولا أنَّ صَرفَ الدّهرِ بالفُرقةِ اُشْتَفَى",83,"ف",2,0],["وما احتيالُ الفَتى إذا عثَر ال","جَدُّ وزَلَّت بسَعيِهِ القَدَمُ",84,"م",1,0],["وَما أَحجَمَ الأَعداءُ عَنكَ بَقِيَّةً","عَلَيكَ وَلكِن لَم يَرَوا فيكَ مَطمَعا",85,"ع",2,0],["وما احتاج النهار إلى دليل","وقد شَهِدَتْ به منه شهود",86,"د",1,0],["وما أحد حال التباعد دونهُ","يأبعد ممن قد تغيّب في القبر",87,"ر",1,0],["وما احتملتم وصوليا يراودكم","غنم الدنيء له الأحرار قربان",88,"ن",1,0],["وما أحَلّوا وما أهَلّوا","بحِجّةٍ بعد عُمرتينِ",89,"ن",1,0],["وما أحرزتْ نفسٌ تُقاها شعارُها","لذخرِ غدٍ من فطرِها وصيامِها",90,"م",3,0],["وما أحسّتْ أنّ رب","عَ الهمِّ قد أمَحَّا",91,"ح",2,0],["وما احمرَّ دمعُ العين لولا صبابةٌ","بحمرِ الحلى بيضِ الطلى والترائ",92,"ا",2,0],["وما أحنفٌ إلاَّ أناتك والحجى","ولا حاتمٌ إلا ندى كفّكَ الغمر",93,"ر",1,0],["وما أحدٌ في الوجدِ مِنْ وِقْفَةِ الهوى","وشكوى تباريحِ الغرامِ مُسَلَّمُ",94,"م",1,0],["وما احتاج للإعجاز إلا الذي تحد","ى بالنبوات غدوة والأصائل",95,"ل",1,0],["وما أحظى من الحسناء إلا","بما يحظى الشجي من الخلايا",96,"ا",3,0],["وما أُحَيْلى كُؤوساً أُترِعَتْ وجلَتْ","من خمرِهِ مشرباً فوْزاً لمن شَرِبَا",97,"ب",2,0],["وما اِحتَفلتُ بشئٍ ظلّ يبذله","لأنّ أكثرَ منه في يديّ ولِي",98,"ل",2,0],["وما احتجَبَتْ لوائِحُهُ فكانت","كضَوءِ الفجرِ دُونَ الشَّمس بادِ",99,"د",1,0],["وما أَحْسَن الوردَ الَّذِي فوق خدِّها","ولو أَنَّني قبَّلتُه كان أَحْسَنا",100,"ن",2,0]]}