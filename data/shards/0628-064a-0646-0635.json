{"poems":[[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[63,"يا أبا إسحاق زاد الله","https://www.aldiwan.net/poem51668.html","مجزوء الرمل"],[68,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[246,"زاحفت أيامي وزاحفنني","https://www.aldiwan.net/poem45756.html","السريع"],[469,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17086","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56636","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101048","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66262","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2613,"","https://poetry.dctabudhabi.ae/diwan/poem/144624","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112583","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92415","الخفيف"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124153","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33745","المنسرح"],[4896,"هذه الموجة من هذا الخضم","https://www.poetsgate.com/ViewPoem.aspx?id=180862",""],[5111,"هَمْسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212518",""],[5225,"اغسلي بالبرد","https://www.poetsgate.com/ViewPoem.aspx?id=16758",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5409,"فقد الناس فيك ثبتاً إماماً","https://www.poetsgate.com/ViewPoem.aspx?id=155481",""],[5411,"أنْتَ وحْدُكَ","https://www.poetsgate.com/ViewPoem.aspx?id=191863",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""]],"verses":[["بَينَ صَبٍّ مُدَلَّهٍ وَطَروبٍ","وَخَليعٍ في اللَهوِ مُرخى العِنانِ",0,"ن",1,0],["بينَ صُفْرٍ من دناني","رِكَ أو صُفرِ خُمورِكْ",1,"ك",1,0],["بَينَ صَحبٍ مِثلِ الكَواكِبِ لا تَن","ظُرُ ما بَينَهُم عُتُلّاً زَنيما",2,"م",2,0],["بَيْنَ صَحْوِ الْمُنَى وحُلْمِ الخَيالِ","سَبَح الشعرُ في سماءِ الجمالِ",3,"ل",1,1],["بينَ صفَّيْ \" صَنَوْبرٍ \" كشُعورِ الغيد","لُمَّتْ على قُدودٍ رِطاب",4,"ب",1,0],["بينَ صلاةٍ ودعا وحمدِ","يا هَل تُرى هذا يسوءُ أَحمدا",5,"د",2,0],["بين صغارٍ سُهَّدٍ في الدجى","يُذرون دمع الثاكِل المُرمِل",6,"ل",1,0],["بين صابٍ سابٍ إذا هزج ال","ألحان أو ناشدٍ يجيد النشيدا",7,"د",2,0],["بَيْن صادٍ وبَيْن ضادٍ وسينٍ","ثُمَّ زايٍ مُبينةٍ التَّبْريز",8,"ز",1,0],["بَينَ صُفرٍ فَواقِعٍ تَتَباهى","في شَماريخُها وَحُمرٍ قَواني",9,"ن",2,0],["بين صدق النهى وكذب الأماني","وقف الرأي والهوى ينظران",10,"ن",1,1],["بين صحب نأوا ووجدٍ مقيم","برح البين بالفؤاد الكليم",11,"م",1,1],["بين صحب إلى البطالة فيها","قد دعت فيهم البدار البدارا",12,"ر",2,0],["بين صَحبٍ رأتْ ورود الرّدى أعْ","ذب وردٍ من دونه في لهاها",13,"ا",3,0],["بين صحبٍ مصدقين كرامٍ","جاهدوا مخلصين للرحمنِ",14,"ن",1,0],["بين صحبٍ شمِّ العرانين غُذُّوا","بلَباَن البيانِ والآدابِ",15,"ب",1,0],["بين صَدٍّ لا ينقصني ومَلالِ","يَئِسَ العائدون من إبْلالي",16,"ي",1,1],["بين صيف وشتاء","لم يصب إلا الشقاء",17,"ا",2,0],["بين صدق النهى وكذب الأَماني","سَهرَت أَعينٌ ونامَت عُيونُ",18,"ن",1,1],["بين صرعى محاجر وعيون","بات بحيهم إذا ما تغنا",19,"ن",2,0],["بينَ صفوُ الزمانِ عن كدَره","في ضَحكاتِ الربيعِ عن زَهرِه",20,"ر",2,1],["بين صيحات تعالت مثلما","يقذف البركان أشلاء الحمم",21,"م",1,0],["بَيْنَ صُبْحٍ وَمَسَاءٍ","كُلّ لَيْلٍ طَيْف زَائِرْ",22,"ر",1,0],["بين صدٍّ وردّ ناعس الطرف سَدّد","نظرةٍ منه عجله من تصيبه قتيل",23,"ل",1,0],["بين صحب أو وحده أي فرق","بين هذين إن تساءل حائر",24,"ر",1,0],["بين صبر على فراق حبيب","سكن الروح واستحل الفؤادا",25,"د",2,0],["بين صفين من تآليف شتى","قد تكدسن كالنضار ركاما",26,"م",2,0],["بَيْنَ صَحْوٍ وَبَيْنَ غَفْوٍ دَهاني","كَمْ تَراءَى خَيالُكَ الْمَعْكُوسُ",27,"س",1,0],["بين صدر مفصل ثم عجز","مجمل شيّهُ بنار خفية",28,"ي",2,0],["بين صدة عزيز وكبرياء مهزوم","عين شحت على وعينٍ استسمحت",29,"ت",1,0],["بَينَ صَمتِي وَحَيرَتِي وَاندِهاشِي","كُنتُ أَهذِي كَأَنَّنِي سَكرانُ :",30,"ن",1,0]]}