{"poems":[[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43836","البسيط"]],"verses":[["ثَهلانُ إِن عُدَّ الحُلومُ أَوِ النُهى","بَحرٌ إِذا عُدَّ النَدى وَالمَبحَثُ",0,"ث",1,0],["ثَهلانُ لَو كانَ لي لِأَمسَت","عَلَيكَ أَحشاؤُهُ نضاجا",1,"ج",2,1]]}