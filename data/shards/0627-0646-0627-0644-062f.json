{"poems":[[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[73,"قد أحسن الله في الذي صنعه","https://www.aldiwan.net/poem11972.html","المنسرح"],[88,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[88,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[51,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[51,"ما أنصف الآس بالياسمين مشبهه","https://www.aldiwan.net/poem61972.html","البسيط"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[89,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[89,"وددت لو أني كنت في مصر محشورا","https://www.aldiwan.net/poem44924.html","الطويل"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[45,"تلك الديار ودارسات طلولها","https://www.aldiwan.net/poem65581.html","الكامل"],[61,"يا ابن الذي سيفه في السلم مسلول","https://www.aldiwan.net/poem51339.html","البسيط"],[69,"لي صاحب وهو نحوي له ذهب","https://www.aldiwan.net/poem28675.html","البسيط"],[69,"إن الدهر خان امرأ","https://www.aldiwan.net/poem29215.html","مجزوء المتقارب"],[81,"إن الدقيق ولعقه","https://www.aldiwan.net/poem61348.html","مجزوء الرمل"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142004","البسيط"],[107,"إن الدراهم والدنانير التي","https://www.aldiwan.net/poem16637.html","الكامل"],[202,"فلا تعن لتحذيف تكلفه","https://www.aldiwan.net/poem52992.html","البسيط"],[210,"ما بال قلبك لا ينفك من سقم","https://www.aldiwan.net/poem37833.html","البسيط"],[248,"حتام تخدع عزمي الآمال","https://www.aldiwan.net/poem15007.html","الكامل"],[284,"من كان يملك درهمين تعلمت","https://www.aldiwan.net/poem34067.html","الكامل"],[346,"إن الدراهم مسها","https://www.aldiwan.net/poem20721.html","مجزوء الكامل"],[351,"حبائل البر في استعطاف ذي الهيف","https://www.aldiwan.net/poem40031.html","البسيط"],[364,"هذا على كبرياء في مطامعها","https://www.aldiwan.net/poem17327.html","البسيط"],[374,"أيلام بشر بالهوى وهو الفتى","https://www.aldiwan.net/poem66983.html","الكامل"],[406,"كتم الجوى القلب القريح","https://www.aldiwan.net/poem32502.html","مجزوء الكامل"],[462,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[549,"لا تسأل المرء ما تجني عشيرته","https://www.aldiwan.net/poem47764.html","البسيط"]],"verses":[["إِنَّ الدُموعَ عَلَيكَ غَيرُ بَخيلَةٍ","وَالقَلبَ بِالسُلوانِ غَيرُ جَوادِ",0,"د",1,0],["إِنّا لَدى مَلِكٍ بِشَب","وَةَ ما تَغِبَّ لَهُ النَوافِل",1,"ل",1,0],["أَنَّ الدَواءَ اِلتَذَّت عَواقِبَهُ","مِنِّيَ نَفسٌ تَشَبَّعَت جُرَعَه",2,"ع",2,0],["أن الدخان لثانٍ في البلاء إذا","ما عُدّتِ الخمر أولى في البليّات",3,"ت",1,0],["إن الدفين مضمّخاً بحنوطه","دون الدفين محنّطاً بشعوره",4,"ر",2,0],["إن الدمشقيَّ عبدُ حاجتِهِ","وعبدُ من يرتجِي لحاجتِهِ",5,"ت",2,1],["إن الدليل على هذا تناثُرُ ذا","وأنَّ ذاك على الأَيام موجودُ",6,"د",1,0],["إنَّ الدُّهُورَ البَواكي","غَنِيَّةٌ عَنْ دُمُوعِكْ",7,"ك",1,0],["ان الدم المسفوك يثأره الفتى","لدم سفيك قبله لا يرجع",8,"ع",1,0],["ان الدم لم تسخنه يوماً حماسة","فان نخاع النشء يجمد مقرورا",9,"ر",2,0],["إِنَّ الدِيارَ تُريقُ ماءَ شُؤونِها","كَالأُمَّهاتِ وَتَندُبُ الأَبناءَ",10,"ا",2,0],["إِنَّ الدُموعَ هِيَ الصَبابَةُ فَاِطَّرِح","بَعضَ الصَبابَةِ تَستَرِح بِهُمولِها",11,"ل",3,0],["إن الدماء فروض حين يسفكها","قوم وكل دم حاولت مطلول",12,"ل",1,0],["إنَّ الدنانيرَ جمعٌ لا نظيرَ لهُ","فكيفَ أصرف جمعاً لا نظيرَ لهُ",13,"ه",1,0],["إنِ الدهرُ خانَ امرأً","بهونٍ أذاه يهنْ",14,"ن",1,1],["إنَّ الدَّقِيقَ وَلَعقَهُ","لَمِنَ السَّكِينَهِ وَألوَقَار",15,"ر",1,1],["إِنَّ الدَعِيَّ يُعادينا لِنُلحِقَهُ","بِالمُدَّعينَ وَيَلقانا بِإِلحادِ",16,"د",1,0],["إِنَّ الدِّيَارَ وَهَكَذَا مُنَّاعُهَا","لَغَنِيمَةٌ لِلْمُسْتَبِيحِ الْعَادِي",17,"د",2,0],["إن الدساتيرَ لا تعطي أعِنّتها","إلا الأعاصير من جنّ ومن بشَر",18,"ر",1,1],["إِن الدَراهم وَالدَنانير الَّتي","يَزري بِأَبناء الكِرام ذَهابِها",19,"ه",2,1],["إن الدنانير لا تُجلَى وإن عتقت","ولا تُزاد على النقش الذي فيها",20,"ه",2,0],["إن الدُّمُوعَ التي أجريتها ذَهَبَاً","حَقّاً لأنْقَدَها أيامَ عسرهم",21,"م",1,0],["إنَّ الدُّنوَّ نتيجةُ البُعدِ بعادةٍ","ما إن يفيلُ لديَّ منها الفالُ",22,"ل",1,0],["إِنَّ الدَّراهِمَ فِي المَواطِنِ كُلّها","تَكْسُو الرِّجَالَ مَهابَةً وجَلالا",23,"ل",2,0],["إنَّ الدَّراهِمَ مَسُّها","أَلَمٌ يَشُقُّ على الكِرامِ",24,"م",1,1],["إِنّ الدَراهم مِغناطيس كُلّ رَشا","يرشى بِها كُلّ ذي عطف وَذي صَلفِ",25,"ف",1,0],["إِنَّ الدِيارَ الَّتي تُبكى بِمُتَّقِدٍ","غَيرُ الدِيارِ الَّتي تَبكي بِهَطّالِ",26,"ل",1,0],["إن الدُّنا في غشِّها شبهُ السَّقى","تصطادُ عقلاً أهوجاً بسَقاءِ",27,"ا",2,0],["إِنَّ الدُّموعَ لها لِسا","نٌ بالأَسَى لَسِنٌ فَصيحُ",28,"ح",1,0],["إن الديار كالجسوم أصبحت","موحشة الأرجاء من سكانها",29,"ن",3,0],["إنّ الدّيارَ التي كنّا نُسرُّ بها","ما عُجْتُ فيها وقد أقْوَتْ بديّارِ",30,"ر",1,0]]}