{"poems":[[55,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[75,"قد أحسن الله في الذي صنعه","https://www.aldiwan.net/poem11972.html","المنسرح"],[90,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[90,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[53,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[53,"ما أنصف الآس بالياسمين مشبهه","https://www.aldiwan.net/poem61972.html","البسيط"],[94,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[91,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[91,"وددت لو أني كنت في مصر محشورا","https://www.aldiwan.net/poem44924.html","الطويل"],[87,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[47,"تلك الديار ودارسات طلولها","https://www.aldiwan.net/poem65581.html","الكامل"],[63,"يا ابن الذي سيفه في السلم مسلول","https://www.aldiwan.net/poem51339.html","البسيط"],[71,"لي صاحب وهو نحوي له ذهب","https://www.aldiwan.net/poem28675.html","البسيط"],[71,"إن الدهر خان امرأ","https://www.aldiwan.net/poem29215.html","مجزوء المتقارب"],[83,"إن الدقيق ولعقه","https://www.aldiwan.net/poem61348.html","مجزوء الرمل"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142004","البسيط"],[113,"إن الدراهم والدنانير التي","https://www.aldiwan.net/poem16637.html","الكامل"],[208,"فلا تعن لتحذيف تكلفه","https://www.aldiwan.net/poem52992.html","البسيط"],[216,"ما بال قلبك لا ينفك من سقم","https://www.aldiwan.net/poem37833.html","البسيط"],[255,"حتام تخدع عزمي الآمال","https://www.aldiwan.net/poem15007.html","الكامل"],[291,"من كان يملك درهمين تعلمت","https://www.aldiwan.net/poem34067.html","الكامل"],[353,"إن الدراهم مسها","https://www.aldiwan.net/poem20721.html","مجزوء الكامل"],[358,"حبائل البر في استعطاف ذي الهيف","https://www.aldiwan.net/poem40031.html","البسيط"],[371,"هذا على كبرياء في مطامعها","https://www.aldiwan.net/poem17327.html","البسيط"],[382,"أيلام بشر بالهوى وهو الفتى","https://www.aldiwan.net/poem66983.html","الكامل"],[415,"كتم الجوى القلب القريح","https://www.aldiwan.net/poem32502.html","مجزوء الكامل"],[469,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[556,"لا تسأل المرء ما تجني عشيرته","https://www.aldiwan.net/poem47764.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138411",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66747","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34511","المجتث"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70738","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145970","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59594","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62548","الكامل"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132413","الكامل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96576","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35361","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27906","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27436","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27227","الكامل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140203",""],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87787","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76160","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122487","البسيط"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120159","الكامل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137976",""],[3091,"","https://poetry.dctabudhabi.ae/diwan/poem/141754","الكامل"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136884","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87401","البسيط"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125987","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108024","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110115","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205884",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85204","البسيط"],[3885,"","https://poetry.dctabudhabi.ae/diwan/poem/200372","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103062","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44725","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199048","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78305","السريع"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133091","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133079","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66113","البسيط"],[1012,"إن الدراهم في الموطن ربما","https://www.poetsgate.com/ViewPoem.aspx?id=186332",""],[4858,"أحبّاءَنا","https://www.poetsgate.com/ViewPoem.aspx?id=143226",""],[4955,"تنسى الهموم إذا خشعت بذكر من","https://www.poetsgate.com/ViewPoem.aspx?id=198938",""],[4980,"بؤسًا لدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=191728",""],[5028,"الفصول الأربعه","https://www.poetsgate.com/ViewPoem.aspx?id=27714",""],[5105,"لما رأوا جيشَكَ المنصورَ منتظماً","https://www.poetsgate.com/ViewPoem.aspx?id=135335",""],[5189,"يا سعد من فهم الدنا","https://www.poetsgate.com/ViewPoem.aspx?id=191460",""],[5189,"قلْ للعبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=195165",""],[5189,"إنّ الدنا قد أمطرت فِتنا","https://www.poetsgate.com/ViewPoem.aspx?id=210214",""],[5277,"ذاكرةُ الرماد...","https://www.poetsgate.com/ViewPoem.aspx?id=198358",""],[5277,"ومضة","https://www.poetsgate.com/ViewPoem.aspx?id=214812",""],[5358,"زينب","https://www.poetsgate.com/ViewPoem.aspx?id=211959",""],[5431,"عزيمةُ ثائرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183015",""],[5431,"لاأشتهي عمرا بدونك مضجرا","https://www.poetsgate.com/ViewPoem.aspx?id=192200",""],[5493,"هذي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=197567",""],[5536,"كفي عن الركض!!","https://www.poetsgate.com/ViewPoem.aspx?id=22809",""],[5542,"صرخة مرصعة بالإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=10073",""],[5595,"شيخ الطريقة شيخٌ لا نظيرَ له","https://www.poetsgate.com/ViewPoem.aspx?id=144758",""],[5725,"قل لي الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=207623",""],[5809,"اصطبار","https://www.poetsgate.com/ViewPoem.aspx?id=205635",""],[5956,"بسرعة الإشعاع","https://www.poetsgate.com/ViewPoem.aspx?id=182429",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[5992,"إنّ الدنانير ضَرْبُ مصرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=41844",""],[6002,"هلا عجبت وكيف ينقضي العجب","https://www.poetsgate.com/ViewPoem.aspx?id=210295",""],[6003,"صرخة عربية","https://www.poetsgate.com/ViewPoem.aspx?id=188989",""],[6078,"أنفاسٌ وغراس","https://www.poetsgate.com/ViewPoem.aspx?id=204640",""],[6131,"مَا بينَ نُقطَتينْ","https://www.poetsgate.com/ViewPoem.aspx?id=189221",""],[2220,"الأمرُ أسماءٌ لهُ ونعوتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11221&r=&rc=95",""]],"verses":[["إِنَّ الدُموعَ عَلَيكَ غَيرُ بَخيلَةٍ","وَالقَلبَ بِالسُلوانِ غَيرُ جَوادِ",0,"د",1,0],["إِنّا لَدى مَلِكٍ بِشَب","وَةَ ما تَغِبَّ لَهُ النَوافِل",1,"ل",1,0],["أَنَّ الدَواءَ اِلتَذَّت عَواقِبَهُ","مِنِّيَ نَفسٌ تَشَبَّعَت جُرَعَه",2,"ع",2,0],["أن الدخان لثانٍ في البلاء إذا","ما عُدّتِ الخمر أولى في البليّات",3,"ت",1,0],["إن الدفين مضمّخاً بحنوطه","دون الدفين محنّطاً بشعوره",4,"ر",2,0],["إن الدمشقيَّ عبدُ حاجتِهِ","وعبدُ من يرتجِي لحاجتِهِ",5,"ت",2,1],["إن الدليل على هذا تناثُرُ ذا","وأنَّ ذاك على الأَيام موجودُ",6,"د",1,0],["إنَّ الدُّهُورَ البَواكي","غَنِيَّةٌ عَنْ دُمُوعِكْ",7,"ك",1,0],["ان الدم المسفوك يثأره الفتى","لدم سفيك قبله لا يرجع",8,"ع",1,0],["ان الدم لم تسخنه يوماً حماسة","فان نخاع النشء يجمد مقرورا",9,"ر",2,0],["إِنَّ الدِيارَ تُريقُ ماءَ شُؤونِها","كَالأُمَّهاتِ وَتَندُبُ الأَبناءَ",10,"ا",2,0],["إِنَّ الدُموعَ هِيَ الصَبابَةُ فَاِطَّرِح","بَعضَ الصَبابَةِ تَستَرِح بِهُمولِها",11,"ل",3,0],["إن الدماء فروض حين يسفكها","قوم وكل دم حاولت مطلول",12,"ل",1,0],["إنَّ الدنانيرَ جمعٌ لا نظيرَ لهُ","فكيفَ أصرف جمعاً لا نظيرَ لهُ",13,"ه",1,0],["إنِ الدهرُ خانَ امرأً","بهونٍ أذاه يهنْ",14,"ن",1,1],["إنَّ الدَّقِيقَ وَلَعقَهُ","لَمِنَ السَّكِينَهِ وَألوَقَار",15,"ر",1,1],["إِنَّ الدَعِيَّ يُعادينا لِنُلحِقَهُ","بِالمُدَّعينَ وَيَلقانا بِإِلحادِ",16,"د",1,0],["إِنَّ الدِّيَارَ وَهَكَذَا مُنَّاعُهَا","لَغَنِيمَةٌ لِلْمُسْتَبِيحِ الْعَادِي",17,"د",2,0],["إن الدساتيرَ لا تعطي أعِنّتها","إلا الأعاصير من جنّ ومن بشَر",18,"ر",1,1],["إِن الدَراهم وَالدَنانير الَّتي","يَزري بِأَبناء الكِرام ذَهابِها",19,"ه",2,1],["إن الدنانير لا تُجلَى وإن عتقت","ولا تُزاد على النقش الذي فيها",20,"ه",2,0],["إن الدُّمُوعَ التي أجريتها ذَهَبَاً","حَقّاً لأنْقَدَها أيامَ عسرهم",21,"م",1,0],["إنَّ الدُّنوَّ نتيجةُ البُعدِ بعادةٍ","ما إن يفيلُ لديَّ منها الفالُ",22,"ل",1,0],["إِنَّ الدَّراهِمَ فِي المَواطِنِ كُلّها","تَكْسُو الرِّجَالَ مَهابَةً وجَلالا",23,"ل",2,0],["إنَّ الدَّراهِمَ مَسُّها","أَلَمٌ يَشُقُّ على الكِرامِ",24,"م",1,1],["إِنّ الدَراهم مِغناطيس كُلّ رَشا","يرشى بِها كُلّ ذي عطف وَذي صَلفِ",25,"ف",1,0],["إِنَّ الدِيارَ الَّتي تُبكى بِمُتَّقِدٍ","غَيرُ الدِيارِ الَّتي تَبكي بِهَطّالِ",26,"ل",1,0],["إن الدُّنا في غشِّها شبهُ السَّقى","تصطادُ عقلاً أهوجاً بسَقاءِ",27,"ا",2,0],["إِنَّ الدُّموعَ لها لِسا","نٌ بالأَسَى لَسِنٌ فَصيحُ",28,"ح",1,0],["إن الديار كالجسوم أصبحت","موحشة الأرجاء من سكانها",29,"ن",3,0],["إنّ الدّيارَ التي كنّا نُسرُّ بها","ما عُجْتُ فيها وقد أقْوَتْ بديّارِ",30,"ر",1,0],["ان الدوام لوجه ربك ذي البها","وسواه في هذي البسيطة فان",31,"ن",1,0],["إنّ الديار خلتْ وليس بِجوِّها","إلا الضوابِحُ والحمامُ الوُقَّعُ",32,"ع",1,0],["إِنّا لدار البِلى ما","لَنا مُجيرٌ نَصيرُ",33,"ر",1,0],["إن الدُّنا بينَ أهليها لقد حكمتْ","أَنْ ليس بُدٌّ لهم من نِعْمَ أوبيسا",34,"س",2,0],["إن َّالديَانَةَ تدري مَنْ يُدينُ بهَا","مثلَ المسَاجدِ تدري مَنْ مُصَلّيهَا",35,"ي",3,0],["إن الدموع أدلتي وشواهدي","عند ادّكار معالمي ومعاهدي",36,"ي",1,1],["إنَّ الدريز لَبَلدة مشهورة","بالفضل تقصر عن محاسنها حلبْ",37,"ب",1,0],["إن الدراهم في المواطن ربما","تكسو المذلة والصغار رجالا",38,"ل",2,1],["إنَّ الديارَ التى حِيلَت بذى سَلَمٍ","هاجَت عليك رجيعَ الشَوقِ مُختَبَلا",39,"ل",2,0],["إِنَّ الدِيارَ إِذا اِرتَحَلتَ دَوارِسٌ","وَإِذا نَزَلتَ بِهِنَّ فَهيَ عَوامِرُ",40,"ر",1,0],["إن الدم المسفوح في قولهم","ما سال من خدشٍ ومن عقرِ",41,"ر",1,0],["إنَّ الدليلَ على مقامِ عبيبده","لنجيه طول المدى والحوتُ",42,"ت",1,0],["إن الدليلَ مقابلُ مدلولِه","حكم التقابلِ بنفسه الإنشاء",43,"ا",2,0],["إنَّ الديار بلاقع ما لم يكن","صفواً للحبيبين نزيلها ونضاره",44,"ر",2,0],["إن الدواعي للكلا","م تجيء وهي شقائق",45,"ق",1,0],["إِنَّ الدُموع أَبا داود ما بَرِحَت","وَقفاً عَليكَ كَصَوب المُزن لَم تَقف",46,"ف",1,0],["إِن الدَراهمَ وَالنساءَ كِلاهُما","لا تَأمَنَنَّ عَليهما إِنسانا",47,"ن",2,1],["إنَّ الدَّوامَ وإنَّ العزمَ ما اجتمَعا","يُبَلِّغانِ وُجُوباً غايَةَ الأمَلِ",48,"ل",1,0],["إن الدواجن والطيو","ر تموت إن لم تأكل",49,"ل",1,0],["إن الدراهم بها تحصل جميع القصود","من لامعه فلس ما يرقى طوال الحيود",50,"د",1,0],["إن الدروس بمصرنا في عصرنا","طبعت على لغط وفرط عياط",51,"ط",1,1],["إن الدروز وأهل الريف لاعدموا","عداهم اللوم كم قاسوا من الكرب",52,"ب",1,1],["ان الدُمى بدِمانا حُلّيت وجرت","جَريَ العِدى بالمُدى تُشقي محبيها",53,"ي",3,0],["أن الدماء التي التل الكبير سقت","محت مظالم فأوى عهدها الزمنا",54,"ن",2,0],["إن الدليل على ارتقاءِ عواطف ال","إنسان إحسانٌ إلى الإنسان",55,"ن",1,0],["ان الدواءَ ليَستحيلُ إلى الدَوَى","ان لم يُصادِف عِلَّةً تعنيهِ",56,"ي",2,0],["إِنَّ الدِراسةَ حُسنُها وجميلُها","درسُ الحَزُومِ بموتِهِ وبدَرسِهِ",57,"س",2,0],["إن الدكاكين التي عرضتْ","