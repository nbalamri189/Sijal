{"poems":[[56,"عداوة العاقل خير إذا","https://www.aldiwan.net/poem27518.html","السريع"],[563,"والله والله ما هذا وجود الرب","https://www.aldiwan.net/poem34929.html","المواليا"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137574",""],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138060","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27386","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104969","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106844","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87794","الرمل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87320","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115621","السريع"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112330","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85281","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135563","الرجز"],[4289,"","https://poetry.dctabudhabi.ae/diwan/poem/199284","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35415","الطويل"],[5232,"ناسِكُ الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=213020",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[5431,"وجودك خُلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=189747",""],[5842,"تَقَبَّحَ قومٌ بالجهالة أُولِعوا .. !","https://www.poetsgate.com/ViewPoem.aspx?id=176656",""]],"verses":[["لِأَنَّ ذا العَقلِ إِذا لَم يُزَع","عَن حِلمِهِ اِستَحيا فَلَم يَخرُقِ",0,"ق",1,0],["لأن ذا حادث يأوي إليه الصبْ","والله حق قديم فالقٌ للحبْ",1,"ب",1,0],["لأن ذكاء كذاك تدور","على نفسها حول ما قد خفى",2,"ف",2,0],["لاََِنَّ ذَيْنِ يُوْجِبانِ التَّلَفا","فَكانَ أَوْلى ها هُنا أنْ يُصْرَفا",3,"ف",2,0],["لاَِنَّ ذاكَ خُمْسُهُ لَمْ يُخْرَجِ","فَخُمْسُهُ مُحَلَّلٌ لِلْحَرَجِ",3,"ج",1,0],["لاَنّ ذا مَنْشَؤُهُ الْعَوارِضُ","وَهذِهِ الذَّاتِيَّ لا تُعارِضُ",4,"ض",1,0],["لأن ذلك إن قالوه عن غرضٍ","من النفوسِ إذا ما لم يكن زاجرُ",5,"ر",1,0],["لا نذوق الماء إلا وتذوب","أنفس منّا بنار الزفرات",6,"ت",1,0],["لأَن ذكر الذي قد فات يؤلمني","ولن تريني يوماً غير مدَّكر",7,"ر",1,0],["لا نَذود العَين أَن تَبكي دَماً","وَدَم الحرّ جَرى فَوقَ الصَعيد",8,"د",1,0],["لأنَّ ذا آخرُ برِّ الزِّنجِ","وبابُ بَرِّ الغربِ والإفرَنجِ",9,"ج",1,0],["لأنّ ذا يوصلُ مع قوّةٍ","وذاك مع لينٍ به يقطعُ",10,"ع",1,0],["لا نذكرُ الماضي ولا","نَهتَمّ لِلمُستَقبَلِ",11,"ل",1,0],["لأن ذلك الطلاق بدعي","وبائن في الشرع غير رجعي",12,"ي",1,0],["لأنَّ ذاك بين قومٍ فرّقا","ورام ذا تفريق شخصٍ حقّقا",13,"ق",2,0],["لأنّ ذا جامدٌ في الثغر منتظمٌ","وذاك منتشرٌ في الخَدِّ سيّالُ",14,"ل",1,0],["لِأَن ذِكرَهُ كَم أَثمَرَت نَخلاتُهُ","مِنَ الخَيرِ حتّى صارَ لِلحُجبِ يَمحَقُ",15,"ق",1,0],["لأنذرَ للحلا روحي","وأنذرَ للهوى حالي .",16,"ل",2,0],["لأن ذوي الإسلام والدين والهدى","على الملة البيضا طريقة ذي الرشد",17,"د",1,0],["لأن ذكاء الشرقِ مرآة جهلهم","تُشدُّ إلى جُحْرِ الهوان ..تُغيّبُ",18,"ب",1,0],["لأنّ ذنوب الفاتنين عظيمة","لهمْ كلّ أبواب الجحيم ستشرعُ !",19,"ع",1,0]]}