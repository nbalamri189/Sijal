{"poems":[[55,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[96,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[119,"دعنا من الاضغاث والاحلام","https://www.aldiwan.net/poem40482.html","عموديه"],[267,"أبلغا ربطة أني","https://www.aldiwan.net/poem68183.html","مجزوء الرمل"],[325,"يا خبرا قد رن فينا وطن","https://www.aldiwan.net/poem61658.html","الطويل"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[566,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77856","الخفيف"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32720","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135599","الرجز"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62199","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72623","الخفيف"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67484","الرمل"],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5264,"جمرك البيوع","https://www.poetsgate.com/ViewPoem.aspx?id=180076",""],[5264,"سلام","https://www.poetsgate.com/ViewPoem.aspx?id=181728",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""]],"verses":[["قاعِداً مَطرَحَ السَقاءِ اِنتَحَتهُ","بِصُروفِ الأَقدارِ جَرّاً وَمَخضا",0,"ض",2,0],["قاعِداً حَولَهُ النَدامى فَما يَن","فَكُّ يُؤتى بِموكَرٍ مَجدوفِ",1,"ف",1,0],["قاعِداً في الثَرى يُطَيِّرُ ساقاً","يَتَمَشّى فيها شَبابٌ وَرِيُّ",2,"ي",1,0],["قاعِداً يَكرُبُ نَفسي بَثُّها","وحَراماً كانَ سِجني واحتِصاري",3,"ر",2,0],["قاع البحار أضاءته عرائسنا","وندّت العدم القاسي عذارانا",4,"ن",2,0],["قاع زهت ببني النبي فاشرقت","رغما لعين الحاسد المتعامي",5,"م",2,0],["قاعِداً أوقِدُ ناراً","لِضَبَابٍ أشتَوِيها",6,"ي",3,0],["قاعِدَةً قَرَّرَها قَومَنا","تَتِمَّةً لِمُردَفاتِ المِحَنِ",7,"ن",1,0],["قاعداً والجَدُّ قد رحَّلَ بي","والمعالي يتقاضَيْن ركوبي",8,"ب",2,0],["قاعَ وَإِن يُترَك فَشَولٌ دُوَّخُ","وَلَو رَآني الشُعَراءُ دَيَّخوا",9,"خ",3,0],["قاعدات عَلى أسرة عز","بالتَهادي يسرن إِن قان سَيري",10,"ر",2,0],["قاعِداً يَضرِبُ بِالزُ","بِّ عَلى حِرِّ دُرَيرَه",11,"ه",1,0],["قاعدةٌ تذكر وهي ظاهره","نظمتها أرجو صلاح الآخرهْ",12,"ر",2,1],["قاعد والزمان بين يديه","قائم والصروف والأيام",13,"م",1,1],["قاعد أوسط الحان شاهدت شخصا","شاحب اللون أسود مكفهرا",14,"ر",2,1],["قاعداً يضرب بالطب","ل على حرّ دريره",15,"ه",1,0],["قاعة هام الجمال بها","تائها يهوي بلا قدم",16,"م",1,0],["قاعد على قلبنا وف عنينا دموع","جاهل بجد لكن ذو كلام مسموع",17,"ع",1,0],["قاعد ما بينا كالقمر","واحنا الكواكب منثورين",18,"ن",1,0],["قاعد ل وقل بالعدل في تنزيه من","سواك عن وصف هوى مذمم",19,"م",1,0],["قاعات شبوا النار فيها عَلى القَنا","وَلعنوا سَنا يَد أَهلها وَالبنونها",20,"ن",3,0]]}