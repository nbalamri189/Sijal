{"poems":[[53,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[113,"دعنا من الاضغاث والاحلام","https://www.aldiwan.net/poem40482.html","عموديه"],[260,"أبلغا ربطة أني","https://www.aldiwan.net/poem68183.html","مجزوء الرمل"],[318,"يا خبرا قد رن فينا وطن","https://www.aldiwan.net/poem61658.html","الطويل"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[559,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"]],"verses":[["قاعِداً مَطرَحَ السَقاءِ اِنتَحَتهُ","بِصُروفِ الأَقدارِ جَرّاً وَمَخضا",0,"ض",2,0],["قاعِداً حَولَهُ النَدامى فَما يَن","فَكُّ يُؤتى بِموكَرٍ مَجدوفِ",1,"ف",1,0],["قاعِداً في الثَرى يُطَيِّرُ ساقاً","يَتَمَشّى فيها شَبابٌ وَرِيُّ",2,"ي",1,0],["قاعِداً يَكرُبُ نَفسي بَثُّها","وحَراماً كانَ سِجني واحتِصاري",3,"ي",1,0],["قاع زهت ببني النبي فاشرقت","رغما لعين الحاسد المتعامي",4,"م",2,0],["قاعِداً أوقِدُ ناراً","لِضَبَابٍ أشتَوِيها",5,"ي",3,0],["قاعِدَةً قَرَّرَها قَومَنا","تَتِمَّةً لِمُردَفاتِ المِحَنِ",6,"ن",1,0],["قاعداً والجَدُّ قد رحَّلَ بي","والمعالي يتقاضَيْن ركوبي",7,"ب",2,0],["قاعَ وَإِن يُترَك فَشَولٌ دُوَّخُ","وَلَو رَآني الشُعَراءُ دَيَّخوا",8,"خ",3,0]]}