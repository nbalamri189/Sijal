{"poems":[[95,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[46,"قدك اتئب أربيت في الغلواء","https://www.aldiwan.net/poem30592.html","الكامل"],[107,"تلك العروبة جرحها يجري دما","https://www.aldiwan.net/poem42060.html","الكامل"],[107,"يا أمة أودت بها الأحلام","https://www.aldiwan.net/poem43369.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55109","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141990","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[98,"أَفْرَاحُ الْوَادِي","https://www.poetsgate.com/ViewPoem.aspx?id=187843",""],[119,"ما العقد الكربة الدهماء حل","https://www.aldiwan.net/poem42167.html","الرمل"],[242,"إيه فالعز قدك من تدليس","https://www.aldiwan.net/poem19702.html","الخفيف"],[303,"كم ذا أجمجم داء كاد يقتلني","https://www.aldiwan.net/poem36306.html","عموديه"],[371,"افترى في عذله كذبا","https://www.aldiwan.net/poem16928.html","المديد"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[454,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[482,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[484,"فيك يحلو الغزل","https://www.aldiwan.net/poem36917.html","مجزوء الرمل"],[487,"عرج على باب الغريب ونادى","https://www.aldiwan.net/poem24366.html","عموديه"],[558,"يا واشيا حسنت فينا إساءته","https://www.aldiwan.net/poem68281.html","البسيط"],[567,"عندنا في مدينة الشمس برج","https://www.aldiwan.net/poem52726.html","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39224","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64832","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136372","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110280","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110272","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137935",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53160","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129801","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94298","الخفيف"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122487","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205920","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132158","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36734","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114257","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131903","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107507","الكامل"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73633","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72454","السريع"],[5061,"انت عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=154887",""],[585,"لبيك غيرَ مروع بجحود","https://www.poetsgate.com/ViewPoem.aspx?id=161908",""],[5111,"تَقَاسِيمُ الصَّمْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=212043",""],[5111,"يا بَحْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212153",""],[5111,"فَلسَفَاتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212317",""],[5111,"مَرَاسِي","https://www.poetsgate.com/ViewPoem.aspx?id=212320",""],[5111,"يَا بَحْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212422",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5277,"القدسُ قصيدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=194982",""],[5431,"ثورة السودان (3)","https://www.poetsgate.com/ViewPoem.aspx?id=202088",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5851,"رسالة إلى ابن زريق البغدادي","https://www.poetsgate.com/ViewPoem.aspx?id=175230",""],[6336,"المجاهدون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73557&r=&rc=18",""]],"verses":[["إِيهِ فَانِي وَكُلُّ مَنْ عَاشَ فَانٍ","أَيْنَ بَاتَتْ تِلكَ الْخِلالُ الْكَرَائِمْ",0,"م",1,0],["إيهٍ فُروقُ الحُسنِ نَجوى هائِمٍ","يَسمو إِلَيكَ بِجَدِّهِ وَبِخالِهِ",1,"ل",2,0],["إيهِ فَدَتكَ مَغارِسي وَمَنابِتي","إِطرَح غَناءَكَ في بُحورِ عَنائي",2,"ا",2,0],["إيهٍ فلسطينُ اصْبِري أو فاجْزَعي","وكَفَى بصبركِ في الحوادثِ مغنما",3,"م",2,0],["إيهٍ فَقَد طَمَتِ الخُطوبُ وَهالَنا","مِنها رُكامٌ يَعتَليهِ رُكامُ",4,"م",1,0],["إيهٍ فَقَد أَشقى النُفوسَ جِماحُها","وَأَضَلَّها التَمويهُ وَالإيهامُ",4,"م",1,0],["إيه فلاسفةَ الزمانِ فأنتمو","ببشائر الغيبِ المحجَّبِ أعلمُ",5,"م",1,0],["آيَةٌ فِي تَسَلْسُلِ الذِّكْرَيَاتِ","أَنْ تَعُودَ الحَيَاةُ بَعْدَ الحَيَاةِ",6,"ه",1,1],["إِيهِ فَتَى الفُتْيَانِ أَنَّ الَّذِي","أَوْلاَكَ هَذَا الجاهَ قَد أَنْصَفَكْ",7,"ك",1,0],["إيه فتى الأخلاق قد","نسجَ الصباح لها وحاك",8,"ك",1,0],["إيه فتى لبنان كم من وقعة","لك فيه بين مغيبه والمشرق",9,"ق",1,0],["إيهٍ فذاك الإنسان","إنسان كل إنسان",10,"ن",1,0],["إيهٍ فلاسفةَ الزمانِ فأنتُمُ","ببشائرِ الغيبِ المحجَّبِ أعلَمُ",11,"م",1,0],["آية في كنز مكنوناتها","در عرفان وبرهان وفضل",12,"ل",1,0],["إِيهِ فَالْعِزُّ قَدْكَ مِنْ تَدْلِيسِ","لَيْسَ بَيْنَ الْمَقِيلِ وَالتَّعْرِيسِ",13,"س",1,1],["إِيهٍ فتى العُربِ من (قيسٍ) وَمن (يمنٍ)","أَما نمى لَكَ عَمّا نَحْنُ فيه نَبا",14,"ب",2,0],["آيَةٌ في الحُسنِ تَشهَدُ لي","كانَ مِن آياتِهِ عَجَبا",15,"ب",2,0],["إيهٍ فما علم الرياضة أفتنا","ما الزهدُ ماذا العفُّ في من قد بَتَل",16,"ل",1,0],["إيه فلسطين كم في النفس من كمد","وآلم الجرح ما أدمته أيدينا",17,"ن",2,0],["اِيهٍ فلي مِن لظى الأشواقِ نارُ جوِّى","تزدادُ وقداً إذا سَحَّبْ غواديهِ",18,"ي",2,0],["إيه في فيها الشفا","فاشربوه وكلوا",19,"ل",3,0],["إيه فديتك يا شيمة خبري","كيف الأحبة والحمى والوادي",20,"د",2,0],["إيهٍ فَإِنَّ النَوى وافَت مُصيبَتُهُ","مُوَلَّعَ القَلبِ بَينَ الشَوقِ وَالقَلَقِ",21,"ق",1,0],["آيةٌ في صحيفةِ الدَّهرِ مِنها","كلُّ حرفٍ يقولُ جلَّ القديرُ",22,"ر",1,0],["إيهٍ فحدثني حَديثَ هَواهُمُ","ما أبْعَدَ السُّلوان عن قَلْبِ الأسي",23,"س",2,0],["إيهٍ فَتَى عُمَرٍ وأَنْتَ أَجلُّ مَنْ","شَرَعَ المكارمَ للأَنامِ ونَصَّصَا",24,"ص",2,0],["آية في شهودها رب ذوق","عرف القلب فيه عجزا وذلا",25,"ل",2,0],["آيةٌ في الضاد لو أنشدتها","اعجمياً لانبرى مستعربا",26,"ب",2,0],["آيةٌ في الحسانِ قد خصها ال","باري بكل الجمال لما براها",27,"ا",3,0],["ايهِ فردون إننا منُصتونا","حدثينا عما جرى حدثينا",28,"ن",2,1],["إيه ففي حلب وليٌّ مخلص","يرجو ويأمل أن تقول ويفعل",29,"ل",1,0],["إيه فإنك ممن لم يبع أبداً","في مكسب الحمد موجوداً بمفقود",30,"د",1,0],["إيه فذكرهمُ أقلّ وإنّما","أومي إليك فتفهمُ الإيماء",31,"ا",2,0],["آية في صحيفة الدهر خطت","وغدا الآن رسمها مطموسا",32,"س",2,0],["إِيهٍ فرنسَا فللتَّمدِينِ ما صَنَعَت","أَيدِ بَنِيكِ وَمَا سدَّت مِنَ الخَلَلِ",33,"ل",1,0],["آية في الشجا فما العود إلاَّ","رنّة من حنينك الموصول",34,"ل",1,0],["إيهٍ فَما تَحتَ السَّماءِ جَديدُ","مِثلُ الخَوالي قابِلٌ وَعَتيدُ",35,"د",1,1],["آية في الحق لا ينسخها","أبد الدهر عدو أو صديق",36,"ق",1,0],["إيه فلسطين الكريمة","من جفاكِ فقد كفر",37,"ر",1,0],["إِيه فاِسمَع يا مَن لَهُ سَعدُ جَدٍّ","سَعدُهُ نِيط بِالسعُودِ الرَفيعَه",38,"ع",2,0],["آيَةٌ فِيهِ لِمَن يَعشَقُ أن","سَلَخَ اللهُ مِنَ اللَّيلِ النَّهَار",39,"ر",1,0],["إيه فصبغة كلّ علم أصبحت","أمة لأعلم من رأيت ومن ترى",40,"ر",2,0],["إيهِ فَأَنتُم قادَةُ الهَيجاءِ","وَسادَةُ الإيقاعِ وَالإِبلاءِ",41,"ا",2,0],["آية في الحسن حتى جمعت","بين غصن وكثيب وقمر",42,"ر",1,0],["إِيهِ فتاةَ الشرقِ هذي فرصةٌ","كان الزمانُ بها عليكِ بخيلا",43,"ل",2,0],["إيهٍ فَإِن صَغُرَت سِنُوهُ فَإِنَّهُ","مِن نُقطَةٍ فَيضُ الأَتِيِّ المُزبِدِ",44,"د",1,0],["إِيه فروض الفضل قد روضا","وكان قد صوَّح فيما مضى",45,"ض",2,1],["ايه في قَلبيّ ...زعل","ايه ضايق .....ومغبون",46,"ن",1,0],["إيه فلسطين المؤرق جفنها","لك ما أردت هوى وصدق عهود",47,"د",1,0],["آيَةٌ فِيْ فَمِ الزَّمَانِ تُغَنِّي","وَالْهَوَى سَائِحٌ يُنَاجِي الْغَمَامَا",48,"م",2,0],["آية ٌفي الشَّوقِ ذابتْ","في مواوييل قوافيكْ",49,"ك",1,0],["آيَةٌ فِيْ الأفْقِ ضَاءَتْ","لِنَشِيْدِ الْفَجْرِ تَتْلُو",50,"ل",2,0],["آيَةٌ فِيْ الأفْقِ تَاهَتْ","كَمْ تَنَاءَتْ فِيْ أقَاصِيكْ",51,"ك",1,0],["آية ٌ فِي الشَّوْقِ ذَابتْ","في مَوَاوِيلِ قَوَافِيكْ..'",52,"ك",1,0],["إيه فاروق لو تأسيت بالفا","روق لم تعد سؤدد السمحاء",53,"ا",2,0],["إيهٍ فلسطينُ الَّتي باتتْ على","سقمِ احتلالٍ...مَنْ لديكِ يعينُ؟",54,"ن",1,0],["إيهٍ فجودي حلوتي","في نخر أعمدة شِحاح",55,"ح",1,0],["إيه ( فنجا ) ونهضة اليوم تاج","من أيادي (قابوس ) عالي المرام",56,"م",1,0],["إيه فيا ليته ماكان مرتحلا","ويأخذ القلب لا ينأى ويفجعه",57,"ع",2,0],["إيهِ فلسطين اتينا والدمُ","نذر علينا أنْ تراه اللمم",58,"م",1,0]]}