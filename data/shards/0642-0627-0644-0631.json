{"poems":[[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[69,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[50,"قال ريم مرعث","https://www.aldiwan.net/poem62372.html","مجزوء الخفيف"],[160,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[186,"قال رؤيا المنام عندك حق","https://www.aldiwan.net/poem43173.html","الخفيف"],[223,"أحبها وأحبته","https://www.aldiwan.net/poem39717.html","الخفيف"]],"verses":[["قال رأسُ الرؤوس لما رآه","وصف البدرُ نفسَه لا خَفَاءَ",0,"ا",2,0],["قالَ رآكَ الدهرُ أهلاً لما","وَلِيتَهُ فاختارَ أَنْ تخملا",1,"ل",2,0],["قالَ ريمٌ مُرَعَّثٌ","ساحِرُ الطَرفِ وَالنَظَر",2,"ر",1,1],["قال رسول الله عن رب السما","كما قرأتموه في كتابه",3,"ب",2,0],["قال رؤيا المنام عندك حق","قلت هيهات كل ذاك نجار",4,"ر",1,1],["قالَ رُدَّ الَّذي سَرَقتَ فَما لَم","يُرتَجَع لا خَلاصَ لِلسرّاقِ",5,"ق",1,0]]}