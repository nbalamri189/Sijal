{"poems":[[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[52,"قال ريم مرعث","https://www.aldiwan.net/poem62372.html","مجزوء الخفيف"],[164,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[190,"قال رؤيا المنام عندك حق","https://www.aldiwan.net/poem43173.html","الخفيف"],[228,"أحبها وأحبته","https://www.aldiwan.net/poem39717.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75770","الخفيف"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100566","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101604","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89255","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114440","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111406","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107502","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86352","الرمل"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141116","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58107","السريع"],[5463,"يوم الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=25290",""],[5480,"بت ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=4104",""],[5513,"سقى الخُزامَى باللَّوى والأقاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=120763",""],[6228,"درس الحرّيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85965&r=&rc=2",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["قال رأسُ الرؤوس لما رآه","وصف البدرُ نفسَه لا خَفَاءَ",0,"ا",2,0],["قالَ رآكَ الدهرُ أهلاً لما","وَلِيتَهُ فاختارَ أَنْ تخملا",1,"ل",2,0],["قالَ ريمٌ مُرَعَّثٌ","ساحِرُ الطَرفِ وَالنَظَر",2,"ر",1,1],["قال رسول الله عن رب السما","كما قرأتموه في كتابه",3,"ب",2,0],["قال رؤيا المنام عندك حق","قلت هيهات كل ذاك نجار",4,"ر",1,1],["قالَ رُدَّ الَّذي سَرَقتَ فَما لَم","يُرتَجَع لا خَلاصَ لِلسرّاقِ",5,"ق",1,0],["قالَ رَبّي أُمّتي ثمّ الأَمل","مِنكَ تَشفيعيَ فيها يا مُجيب",6,"ب",1,0],["قال ريقي يُطابق اسمي مَعنى","وَكَذا كانَ للجوى درياقا",7,"ق",2,0],["قال رأي اللَه بعين رأسه","عن وجهه لما أماط الحجبا",8,"ب",2,0],["قال ربِّي ذرني لميقاتِ يومٍ","في ضحاهُ سيحشرُ الثقلانِ",9,"ن",1,0],["قال رَبِّ انظرني حتى تُوَافى","من دَياجي أجداثِها الأشلاء",10,"ا",2,0],["قال رسولُ الله إذ جاءه","كعبٌ على ناقته يسرى",11,"ر",2,0],["قال روح حذار يا أترابي","واطردوهُ عن السماء",12,"ا",2,1],["قال رضوان أرخوا صار زاه","في نعيمي محمد توفيق",13,"ق",1,0],["قالَ رُمتَ الغضَّ مِنِّي قُلتُ كَم","أرتجي الغَضَّ وثَغرَ الأقحوان",14,"ن",1,0],["قالَ رَبُّ الأَربابِ والناسِ طُراًّ","لا تُرَجِّي استِطلاعَ كُلِّ صُرُوفي",15,"ف",2,0],["قال ربُّ الوجودِ للشمس يوماً","وهي تفترُّ في الوجودِ زُهاءَ",16,"ا",2,1],["قال رائيها وقد فر الغلس","أعلى الأبريق برق لمعا",17,"ع",2,0],["قال رائيها بأكناف المراح","كمصابيح انجلت في خندس",18,"س",1,0],["قال رسول الله في شأنه","لا يدخل الجنة قتّات",19,"ت",1,0],["قال رسولُ اللهِ فاسمَعْ لهُ","رواية عن صادقٍ في المقالْ",20,"ل",1,1],["((( قال ربي في كتابه مثنى وثلاث ورباع )))","وإنتي في دنياي وحده مالها بكوني مثيل",21,"ل",1,0],["قال روّح ! قلت ما حيلي","انته ناري وانته الجنه",22,"ن",2,0],["قالرَّاحُ والراحةُ ذلُّ الفتى","والعزُّ في شربِ ضريب اللِّقاحْ",23,"ح",1,0],["قال رسبْتِ! فهيّا انصرفي","لن تنجح بنتٌ رجعيّة!",24,"ي",2,0],["قال ربي أعوذ من كل جهل","هبني فيضا يذوب فيه كياني",25,"ن",2,0]]}