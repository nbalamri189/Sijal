","https://www.poetsgate.com/ViewPoem.aspx?id=187262",""],[5582,"أَلا هَلْ شَجاكَ الأَوْرَقُ المُتَغَرِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63491",""],[5582,"أَوَجْهُ أُمَيْمٍ ذاكَ شَفَّ بِهِ السِّتْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=63513",""],[5690,"نقولا فتى التيان قد أوحش الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=172252",""],[5735,"فلما دفعت لأبوابهم","https://www.poetsgate.com/ViewPoem.aspx?id=181490",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5955,"وما زلت تعطيني وما لي حاسد","https://www.poetsgate.com/ViewPoem.aspx?id=186649",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["فَلَمّا دَنا مِنّي قَطَعتُ وَتينَهُ","بِحَدِّ حُسامٍ صارِمٍ يَتَبَلَّجُ",0,"ج",1,0],["فَلَمّا دَنا لِلماءِ سافَ حِياضَهُ","وَخافَ الجَبانُ حَتفَهُ وَهُوَ قائِمُ",1,"م",1,0],["فَلَمّا دَخَلناهُ أَضَفنا ظُهورَن","إِلى كُلِّ حارِيٍّ جَديدٍ مُشَطَّبِ",2,"ب",1,0],["فَلَمّا دَنَوتُ تَسَدَّيتُه","فَثَوباً نَسيتُ وَثَوباً أَجُر",3,"ر",1,0],["فَلَما دنا لِلاّبَتَينِ تَقودُهُ","جَوافِلُ دُهمٌ بِالرَّبابِ عَواجِرُ",4,"ر",1,0],["فَلَمّا دَنَت إِهراقَةُ الماءِ أَنصَتَت","لأَعزِلَةٍ عَنها وَفي النَفسِ أَن أُثني",5,"ن",2,0],["فَلَمّا دَخَلنا جَوفَ مَرأَةَ غُلِّقَت","دَساكِرُ لَم تُرفَع لِخَيرٍ ظِلالُها",6,"ل",3,0],["فَلَمّا دَعَونا لِلخَليفَةِ رَبَّنا","وَكانَ الحَيا تُزجى إِلَيهِ الضَعائِفُ",7,"ف",1,0],["فلما دنت للكاذتين واحرجتْ","به حلبساً عند اللقاء حُلابسا",8,"س",2,1],["فَلَمّا دَنَت أَعضادُهُ وَدَنا لَهُ","مِنَ الأَرضِ دانٍ جَوزُهُ فَتَحَمحَما",9,"م",2,0],["فَلَمّا دارَتِ الكَأسُ","دَعا بِالنَطعِ وَالسَيفِ",10,"ف",1,0],["فَلَمّا دَعا داعي هَواكُم أَجابَهُ","فَلَستُ أَراهُ عَن وِصالِكَ يَبرَحُ",11,"ح",1,0],["فلما دهى طولُ التعمُّم لمَّتي","فأزرى بها بعد الجثالة والفَرَعْ",12,"ع",1,0],["فَلَمّا دَنا مِنها الإِيابُ وَأَدرَكَت","عَجارِفُ حُدبٌ مُخُّهُنَّ مَزيجُ",13,"ج",1,0],["فَلَمّا دَعا داعي الصَباحِ تَفاضَلَت","بِرُكبانِها صُهبُ العَثانينِ قُرَّحُ",14,"ح",1,0],["فَلَم أَدرِ يُمناهُ إِذا ما مَدَحتُهُ","أَبِالمالِ أَم بِالمَشرَفِيَّةِ أَنفَحُ",14,"ح",1,0],["فَلَمّا دَجى داجي العَوانِ وَأَطبَقَت","تَبَلَّجَ وَالنَصرَ الهِلالُ المُحَجَّبُ",15,"ب",1,0],["فَلَمّا دَنا أَخفى عَلَيهِ مَكانَهُ","شُعاعُ الحَديدِ البارِقِ المُتَأَلِّقِ",16,"ق",1,0],["فَلَم أَدرِ ما بُردايَ حَتّى إِذا اِنجَلى","سَوادُ الدُجى عَن واضِحِ اللَونِ أَشقَرا",17,"ر",2,0],["فَلَمّا دَنا قُلتُ اِدنُ دونَكَ إِنَّني","وَإِيّاكَ في زادي لَمُشتَرِكانِ",18,"ن",1,0],["فلما دَجَى اللَّيلُ فرَّجْتُه","برُوحٍ تُحيِّفُ جُثمانَها",19,"ن",3,0],["فَلَم أَدرِ مَن أَيَّ الثَلاثَةِ سَكرَتي","أَمِن لَحظِهِ أَم لَفظِهِ أَم رَحيقِهِ",20,"ق",2,0],["فَلَمّا دَنا الإِصباحُ قالَت فَضَحتَني","فَقُم غَيرَ مَطرودٍ وَإِن شِئتَ فَاِزدَدِ",21,"د",1,0],["فَلَمّا دَنونا لِجَرسِ النِباحِ","إِذا الضَوءُ وَالحَيُّ لَم يَرقُدوا",22,"د",3,0],["فَلَم أَدرِ مِن صَمتٍ لَهُ وَسَكينَةٍ","أَكبَرَةُ سِنٍّ وَقَّرَت مِنهُ أَم كِبرُ",23,"ر",1,0],["فَلَم أَدرِ وَالحُسنُ صِنوٌ لَهُ","أَأَبدَأُ بِالمَدحِ أَم بِالغَزَل",24,"ل",1,0],["فَلَم أَدرِ أُمُّ الرَألِ مِن بِنتِ أَعوَجٍ","وَلا ظَبيَةِ الوَعساءِ مِن أُمِّ سالِمِ",25,"م",1,0],["فَلَمّا دَنا مِنهُ تَذَكَّرَ شَجوَهُ","وَذَكَّرَهُ مَن قَد نَأَى فَتَشَوَّقا",26,"ق",2,0],["فلما دَنا من يَثربٍ قال قائلٌ","أطيعُوا رسولَ اللهِ وامْتثِلُوا الأمْرَا",27,"ر",2,0],["فَلَمّا دَنَت جَلجَلَت في السَما","ءِ رَعداً أَجَشَّ كَجَرِّ الرَحى",28,"ا",1,0],["فلمْ أدرِ إذ سلَّمتُ كيفَ أُشيِّعُ","ولم أدْرِ إذ شَيّعْتُ كيفَ أُودِّع",29,"ع",1,0],["فَلَمّا دَنا مِنها بَكَت مِن دُنُوِّهِ","وَقُلنَ لَها قومي اِركَبي الصُبحُ أَبلَجُ",30,"ج",1,0],["فَلَمّا دَنا وَجهُ الوَداعِ تَفَجَّعَت","عَلى لَيلَةٍ طابَت وَسِرٍّ مُوَلَّجِ",31,"ج",1,0],["فَلَمّا دَعاني الهاشِمِيُّ أَجَبتُهُ","وَلا خَيرَ في المَملوكِ غَيرَ مُجيبِ",32,"ب",1,0],["فَلَمّا دَعا مُرَّانَ أَقَبلَ نَحرهُ","سِناناً مِنَ الخطِّيِّ أَسمَرَ مِسعَرا",33,"ر",2,0],["فَلَمّا دَنَونا لِجَرسِ النُبوحِ","وَلا نُبصِرُ الحَيَّ إِلاَّ التِماسا",34,"س",2,0],["فَلَمّا دَنا للخرجِ خرجِ عُنَيزَةٍ","وَذِي بَقَرٍ أَلقى بِهِنَّ المَراسيا",35,"ي",2,0],["فَلَمَّا دَنَا لِلْبَابِ أَشْبَهَ أُمَّهُ","وقَالَتْ لَهُمْ نَفْسُ المَذَلَّةِ أَزْحِفُوا",36,"ف",3,0],["فلمّا دنى أخفى عليه مكانه","شعاع الحديد البارق المتألّق",37,"ق",1,0],["فَلَمْ أَدْرِ أَنَّ اللَّهَ صَوَّرَ قَبْلَكُمْ","تَمَاثِيلَ لَمْ يُخْلَقْ لَهُنَّ مَسَامِعُ",38,"ع",1,0],["فَلَمَّا دَهَاكِ البَيْنُ جَلَّ مُصَابُهُمْ","فَلاَ عَيْنَ إِلاَّ بِالحِدَادِ كَحِيلُ",39,"ل",1,0],["فَلَمَّا دَعَاهُ اللهُ بَعْدَ جهَادهِ","إِلَى الرَّاحَةِ الكًبْرَى وَقَدْ بَاتَ مُجْهَدَا",40,"د",2,0],["فَلَمّا دَخَلناهُ أَضَفنا ظُهورَنا","إِلى كُلِّ حارِيٍّ جَديدٍ مُشَطَّبِ",41,"ب",1,0],["فَلَمّا دَنَوتُ تَسَدَّيتُها","فَثَوباً نَسيتُ وَثَوباً أَجُر",42,"ر",1,0],["فَلَمَّا دَنَا مِنْهَا بَكَتْ مِنْ دُنُوِّهِ","وقلنا لها: قومي اركبي الصبح أبلج",43,"ج",1,0],["فلما دنونا وانجلى ضوء بارق","من الحق ، جلّى الظن ُ ، والظن فاسد",44,"د",1,0],["فلم أدر هل أمّ السماء قطيعه","من الغيم أو أمّ الخباء المطنّبا",45,"ب",2,0],["فَلَمّا دَخَلْنَاهُ أصَغْنَا ظُهُورَنَا","إلى كلّ حاري جديد مشطب",46,"ب",1,0],["فلمَّا دنا مِني قَطَعْتُ وَتِينَهُ","بحدِّ حسامٍ صارمٍ يتفلجُ",47,"ج",1,0],["فلم ادر من سهل الغرام وحزنه","اوقتي ليلي ام هو الظهر مزهر",48,"ر",1,0],["فلما دنوا منكم ولم تحفلوا بهم","أغارت عليهم كل داهية دهيا",49,"ي",2,0],["فلما دنوتم نحوه ازداد خوفه","وعاود سُما ذلك السقم ناقعا",50,"ع",2,0],["فلم أدرِ من حيرتي فيهما","هلالَ الدجى مِن هلال البشرْ",51,"ر",1,0],["فلمّا دنتْ من خِشْفِها انعطفتْ له","فألفَتْه ملهوفَ الجَوانحِ طاوِيا",52,"ي",2,0],["فلمّا درت أن أحداثَها","عَظُمن على غير مستعظِم",53,"م",1,0],["فلما دَهَاها بأسُ كُتشِنَرٍ عَنَت","إِليه وأضحت مثلَ نهبٍ مُقَسّم",54,"م",1,0],["فلما دخلتُ الخَدرَ أطَتْ نسوعُهُ","وأطرافُ عِيدانِ شديدٍ أسُورُها",55,"ر",3,0],["فَلَمّا دَنا من قاب قَوسين رفعة","وألبسه الرحمن تاج المفاخر",56,"ر",1,0],["فَلمْ أَدْرِ أَيُّهُما الْمُسْكِرِي","وَأَيُّ الشَّرابَيْنِ مِنْهُ الرَّحِيقُ",57,"ق",1,0],["فَلَم أَدرِ إذ ساروا لبَينٍ بكايَ من","مَراحمِ لاحٍ أَو مراحِ مِلاحِ",58,"ح",1,0],["فلمّا دنا أَلفى سراباً بقيْعةٍ","فكاد من الإِخفاقِ وَاليأْسِ يصعق",59,"ق",1,0],["فلم أدعْ رقْيةً أو عوذةً رويتْ","إلاّ وَعوّذتها سرّاً وإعلانا",60,"ن",2,0],["فَلم أدرِ شهبَ القطبِ أَم شهبَ شاهقٍ","سِماطانِ حفّاهُ كسمطٍ تلا سِمطا",61,"ط",2,0],["فَلَمّا دَنا مِنها بَتاتٌ وَأَصبَحَت","بَعيداً وَلَم تَحلُل سَمائي وَلا أَرضي",62,"ض",2,0],["فَلَمّا دَنَت لِلماءِ هيماً تَعَجَّلَت","رَباعِيَةٌ لِلهادِياتِ قَدومُ",63,"م",1,0],["فَلَمّا دَنَت لِلبَطنِ عاجَت جِرانَها","إِلى حارِكٍ يَنمي بِهِ غَيرُ أَدبَرا",64,"ر",2,0],["فَلمّا دَعاهُ اللَه دَعوَة راحِمٍ","لِدار بِها يَلتَذّ سَمع وَناظرُ",65,"ر",1,0],["فَلَم أدرِ مِمَّا كنت أُسقَى هَل الهَوَى","شَرِبتُ أمِ الصَّهبَاءَ صِرفاً أمِ السِّحرَا",66,"ر",2,0],["فَلما دَعَتني صُروفُ الزَّما","نِ إلَيهِ دَعَتني إِلى صَرفِها",67,"ف",3,1],["فلمَّا دجى ليلٌ وأقتَم نوره","تداركَه رأي الإمام فأَسفَرا",68,"ر",2,0],["فلما دخلتُ تمادى المِطالُ","وطال ويا ليتَ ذا آخرُه",69,"ر",2,0],["فلم أدر هذا من سروري ببُغيتي ال","سعيدةِ أو راضٍ بسيري ومقصدي",70,"د",2,0],["فلم أدر ما أوصافه غير أنني","غدوت لدى أوصافه حائر الفكر",71,"ر",1,0],["فلّما دفَنّا جِسمَهُ في تُرابِهِ","جعلْتُ صَميمَ القَلبِ منِّي لهُ قَبْرا",72,"ر",2,1],["فَلَم أَدرِ أَي الدُرِّ أَنفَسُ قيمَةً","أَأَدمُعُها أَم ثَغرُها أَم كَلامُها",73,"م",3,0],["فلم أدرِ والأيامُ ذاتُ تغيُّر","أيذهبُ عمري هكذا بين معشر",74,"ر",1,0],["فلما دنت آجالهم نكبت بهم","صروف الليالي من وفاءٍ إِلى غدْر",75,"ر",1,0],["فلما دعا داعي النوى واستخفَّنا","تجاوبُ غربانِ الفراق النواعق",76,"ق",1,0],["فَلَمّا دَنَت مِن فَهمِهِ ضاعَ وَخدُها","وَما حَصَلَت مِنهُ عَلى مَنزِلٍ رَحبِ",77,"ب",1,0],["فلم أدع الأنين لضعف سقم","ولكني ضعفت عن الأنين",78,"ن",1,0],["فلما دعا قلبي هواك أجابه","فلست أراه عن ودادك يبرح",79,"ح",1,0],["فلمّا دَنا منّا الوداعُ وضمّنا","قميصُ عِناقٍ بزّنا ملبسَ الصّبْرِ",80,"ر",1,0],["فلمّا دَرَوا عنِّي الحدودَ تركتُها","وأضمرتُ فيها الخيرَ والخيرُ يُطلَبُ",81,"ب",1,0],["فَلَمّا دَقَّ أَنفُ المُز","نِ أَبدى خَيرَ إِرواحِ",82,"ح",1,0],["فَلَمّا دَعاني يا اِبنَ رَوحانَ لَم أَخِم","وَقَوَّمتُ عَسّالي وَصَدرَ حِصاني",83,"ن",2,0],["فلمّا دنا ألفْاكُمُ في كتائبٍ","تطاوَلْن أقطار السّباسب 