{"poems":[[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[45,"أطاعن خيلا من فوارسها الدهر","https://www.aldiwan.net/poem9607.html","الطويل"],[76,"وألزمته حكم الهوى فالتقى به","https://www.aldiwan.net/poem13247.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54868","الكامل"],[189,"يا باسط العدل في بدو وفي حضر","https://www.aldiwan.net/poem14537.html","البسيط"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[226,"بينما الجو بديع رائق","https://www.aldiwan.net/poem55264.html","الرمل"],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[309,"بشر فؤادك بالنصيب الوافي","https://www.aldiwan.net/poem16794.html","الكامل"],[443,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[484,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[505,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[505,"مطلسم القوم لا تهمل مكانته","https://www.aldiwan.net/poem37775.html","البسيط"],[563,"قد جاء ربنا لنا","https://www.aldiwan.net/poem33876.html","مجزوء الرجز"],[572,"وزائر زار وقد تعطرا","https://www.aldiwan.net/poem69669.html","الرجز"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39224","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48683","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48666","الكامل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204059","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46625",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79987","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109665","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137515",""],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127393","الخفيف"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104307","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3725,"","https://poetry.dctabudhabi.ae/diwan/poem/216332","السريع"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44903","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123523","السلسلة"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81923","البسيط"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35048","الكامل"],[4533,"","https://poetry.dctabudhabi.ae/diwan/poem/134279","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204170","الكامل"],[4717,"لا تحزني...","https://www.poetsgate.com/ViewPoem.aspx?id=199634",""],[4767,"قمم","https://www.poetsgate.com/ViewPoem.aspx?id=178391",""],[5074,"القرية الوادعة","https://www.poetsgate.com/ViewPoem.aspx?id=157488",""],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""],[592,"أكتب ككتبي كما قد كنت أكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=128829",""],[5512,"ذات العيون الشهل","https://www.poetsgate.com/ViewPoem.aspx?id=205887",""],[4623,"ذكر فان النفع في التذكار ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146607",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[572,"وزائرٍ زَارَ وقد تَعَطَّرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9308&r=&rc=165",""]],"verses":[["واسْتَكدَّتْ حَسِيرَ شكري فشكري","يستغيثُ استغاثةَ المجْهُودِ",0,"د",1,0],["واستك الاست التي منذ شقت","أبداً فيها فهود شباع",1,"ع",1,0],["وَأَستَكبِرُ الأَخبارَ قَبلَ لِقائِهِ","فَلَمّا اِلتَقَينا صَغَّرَ الخَبَرَ الخُبرُ",2,"ر",1,0],["وَأَستَكتِمُ الشِعرَ اِسمَهُ خَوفَ كاشِحٍ","فَبَيني وَبَينَ الشِعرِ فيهِ ذِمامُ",3,"م",1,0],["وَاسْتُكْمِلَتْ فِيهَا الطَّرَائِفُ كُلُّهَا","فكَأَنهَا الدُّنْيَا حَوَتْهَا دَارُ",4,"ر",1,0],["واستكبرتْ سادةُ الأَملاكِ هَيْبتَه","واسْتعظَم الدهرُ معناه على صِغر",5,"ر",1,0],["وَاِستكنَّ البدرُ المنيرُ بثورٍ","لَم يضرهُ مِن العدا عوّاءُ",6,"ا",2,0],["واستكيني واتركي الأمر لمن","أبدع الكون تعالى ذو الجلال",7,"ل",1,0],["واستكبروا ما قال في الانصاب","والأصنام من ذم ومن تهجين",8,"ن",1,0],["واستكف ربك كل هم إنه","سبحنه البر اللطيف الكافي",9,"ف",2,0],["وأستكفّ الجوى فيهم ولي نفس","يريك بردا لديه غلّة النار",10,"ر",1,0],["واستكثفوا البقلَ من نعمان فاقتحموا","لسّاً وخضماً فمهلوسٌ ومهصورُ",11,"ر",1,0],["واستكنوا فما عليها ازدحام","قوم بعضهم وبعض نيام",12,"م",1,0],["واستكف فيه الرجال فإنَّه","شيخٌ عليه الأولياءٌ عيال",13,"ل",1,0],["واسْتكْتِموا سِرَّكم أَلبابَكُمْ أَدَباً","فسِرُّ أهلِ الغرامِ الحَقِّ مَكْتومُ",14,"م",1,0],["واستكشفوا بربكم","عنه وذوقوا ذا الطعام",15,"م",1,0],["واستكْثَرَتْ منه اللّهاةُ سُكَّرَا","يَنْفُثُ في الآنُفِ مِسْكاً أذْفَرَا",16,"ر",2,0],["واستكملتْ كلُّ النفوس كمالَها","شَفعَ العطايا بالعَطاء الأنْفَسِ",17,"س",1,0],["واستكملوا ذاك الحديث وإنه","ليقينُ مرتابٍ وراحة لاغب",18,"ب",1,0],["واستكثروا الزاد الشهيَّ فإنكم","وسلاحَكم والزادَ مأخوذونا",19,"ن",2,0],["واستكملوا المدد الكبير بفتيةٍ","سيقوا إلى الهيجاء هيّابينا",19,"ن",2,0],["واستكتبا عنه عطارد كل ما","ينهى ويأمر رأيه ونهاه",20,"ا",2,0],["واستكثروا لكَ ما بلغتَ وإنني","مستنزِرٌ لكَ مَن أطاع ومَن عصى",21,"ص",2,0],["واستكشفت عنها بوج","ه محمدٍ غماءها",22,"ا",3,0],["واستكَّ مسمعُ خافقيها مُذ بها","هَتف النعيُّ مطبَّقاً أرجاءها",23,"ا",3,0],["واستكانت وبردت","نار قلبي بما جرعْ",24,"ع",1,0],["واستكت الاذان من صجج الظبى","وتدحرت مقطوعة الاعضاء",25,"ا",2,0],["واستكنزته ولم تجد بزكاته","فغدت مطوقةً بما بخلت به",26,"ه",1,0],["واستكن الجوى بقلبي فأمست","أعين الصب لا تذوق المناما",27,"م",2,0],["واستكنتم من بعد عز مقيم","وخضعتم لسلطة الأعداء",28,"ا",2,0],["واستكثروا العيلة واستسهلوا","أصعب ما يعيي به الراق",29,"ق",1,0],["وأَستكين لها طوراً وارهبها","فلا تزيد مقالاتى على الصممِ",30,"م",1,0],["واسْتكبروا وجدي فناديتُهم","قوموا انظروا، حُسْنُه أَكبر",31,"ر",1,0],["وَاستَكبَرَت فَرَمَت مِن حالقٍ نَبأ","أَعمى تَصَرِّفهُ قيثارةُ الأَبَدِ",32,"د",1,0],["واستكف به الدا اذا أذاه تعدّى","واعدده مردا وملجأ لك والعين",33,"ن",1,0],["واستكبروا إذ دعا الداعي كأنهم","لا يسمعون لسان الصدق إن نطقا",34,"ق",2,0],["وَاِستَكثروا الحَمقى لِيرجح وَزنهم","وَعيارهم عَدداً بغير عيارِ",35,"ر",1,0],["واستكانت وتمادت","في عماها عاثرة",36,"ر",2,0],["واستكملت صفة البدور بطلعة","وبحلّة صبغت بلون سمائها",37,"ا",3,0],["واستكثرتْ محنُ الحياةِ سعادَتي","فأبى الغرامُ بقاءَنا يوماً معا",38,"ع",2,0],["واستكملتْ توزيع ما","قد قررته من القسم",39,"م",1,0],["وَ أَسْتَكِيْنُ إلى حُلْمٍ يُهَامِسُنِيْ","كَمَا يُهَامِسُ ثَغْرَ النَّسْمَةِ الشَّجَرُ",40,"ر",1,0],["واستكس ربك خلعة ال","مغفران سابغة تماما",41,"م",2,0],["واستكف عن كيف بالتعريف متكاً","واكفف ككفي عن التطفيف والكذب",42,"ب",1,0],["واستكانَ القلبُ للحبِّ الَّذي","في شراييني ملاكاً توِّجا",43,"ج",2,0],["واستكثرن من الصلاة على النبي","إن الصلاة عليه سر سار",44,"ر",1,0],["واستكْشَفَ النظمَ المُطرّزَ دُرُّهُ","وبماءِ عِطرٍ داعَبَ الجُلاسا",45,"س",2,0],["واسْتَكلبتْ ضدّنا آلافُ ألسنةٍ","تسُومُنا كلَّ تجريحٍ، وتَشْويهِ",46,"ي",2,0],["واستكّثَرَتْ منهُ المهاة ُ سكّراً","ينفثُ في الآنافِ مِسْكاً أذفرا",47,"ر",2,0]]}