m/ViewPoem.aspx?id=26381",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""],[6167,"كهف العلماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85554&r=&rc=37",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6218,"كلاّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65905&r=&rc=58",""],[6229,"ليلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65190&r=&rc=16",""],[5190,"حكايتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78304&r=&rc=17",""],[6355,"التحدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66588&r=&rc=48",""],[6355,"حصاد الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66593&r=&rc=53",""],[572,"حَبَّذَا الزَّائرُ في وقتِ السّحَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9260&r=&rc=117",""]],"verses":[["قلْتُ يا قوْمُ حَصاةٌ قُذِفَتْ","شَرَدَ النّوْمُ بِها مَنْ شَرَدَهْ",0,"د",2,0],["قُلْتُ يا ناقُ كلُّ مالٍ وَجاهٍ","وعَقارٍ فهُنّ مُترَكاتي",1,"ت",2,1],["قَلْتُ يَا صَاحِبِي أَتَقْحَمُ بِيداً","تَتَلَظَّى وَالحَرْبُ فِيهَا زَبُونُ",2,"ن",1,0],["قلتُ يا حسناءُ مَن أنتِ ومِن","أيّ دوحٍ أفرع الغصن وطالا ؟",3,"ل",2,0],["قلت يوماً وخلتهُ","مطلَقَ الكفّ ثَرَّها",4,"ر",3,0],["قُلتُ يا قَومُ اِجمَعوا أَحلامَكُم","كُلُّ نَفسٍ في وَريدَيها رَداها",5,"ا",3,0],["قلتُ يا ربِّ لمن جمَّلتَه","ولمن هذي الثرياتُ الغرر",6,"ر",1,0],["قلتُ يا هندُ طببيني بوصلٍ","تنعشيني فالصبُّ بالوصلِ حيْ",7,"ي",1,1],["قلتُ يا هندُ طيِّبيني بوصلٍ","تنعشيني فليسَ كالوصلِ شَيْ",8,"ي",1,1],["قُلتُ يَوماً لَها وَحَرَّكَتِ العو","دَ بِمِضرابِها فَغَنَّت وَغَنّى",9,"ن",2,0],["قُلتُ يا سَيِّدَتي عَذَّبتِني","قالَتِ اللَهُمَّ عَذِّبني إِذَن",10,"ن",1,0],["قُلتُ يا بَكرُ شَفَّني","لاعِجُ الحُبِّ وَالأَلَم",11,"م",1,0],["قُلتُ يا صاحِ إِذا ما لَم تُعِن","فَدَعِ اللومَ هَوى لَيلى فَمَن",12,"ن",1,0],["قُلتُ يا حَفصُ اِعفُ عَنهُ","إِنَّهُ سَوفَ يُجيدُ",13,"د",1,0],["قُلتُ يَوماً لِلرَقاشِي","يِ وَقَد سَبَّ المَوالي",14,"ل",2,1],["قُلتُ يَأَبى الهَوى عَلَيَّ وَنَفسي","لا تُطيعُ العَدُوَّ في الأَحبابِ",15,"ب",1,0],["قلت يا قَوم اِستَغفروا اللَه تنجوا","إنه كانَ راحماً غفارا",16,"ر",2,0],["قُلتُ يا فتنة الصِّبا حَفِلَتْ دُنْ","ياكِ بالحبِّ والمُنى والأغاني",17,"ي",1,0],["قلتُ يا كرمةَ ابن هاني سلاماً","ليس للمرءِ في الحياة سلامَه",18,"م",2,0],["قلت يا طيفُ أثرتَ النفس شَكا","كيف أقبلتَ وقُلْ لي من دعاكَا",19,"ك",2,0],["قُلْتُ: يا رَبّ، أيُّذَنْبٍ جَنَتْهُ","أيُّ ذَنْبٍ لَقَدْظَلَمْتَ صِبَاهَا",20,"ا",3,0],["قلتُ: يا قومُ، ويحكم؛ إن فينا","من حُماةِ الشَّرى عِدادَ الرِّمال",21,"ل",1,0],["قلت يا قوم حصاة قذفت","شرد النوم فيها من شرده",22,"د",2,0],["قلت يوماً أُحب شِعر (المعرّي)","بلّغوا بي، أن المعرّي عشيقي",23,"ق",2,0],["قلت يوماً: كان \"امرؤ القيس\"، صاحت","عمّتي: كيف تمدحين طليقي؟",23,"ق",2,0],["قلتي.. أنتي..؟ أبسخريه...... فوق التراب......","وقلتلس,,. وانا... أتبسم...... جملتين.....",24,"ن",1,0],["قلتُ يوماً لها وحركتِ العة","دَ بِمِضْرَابِها، فَغَنَّتْ، وَغَنَّى",25,"ن",2,0],["قُلْتُ: يا عَمْرُو شَفَّني","لاَعِجُ الحُبِّ وَالأَلَمْ",26,"م",1,0],["قلت يا بدري حنانا","نوّر الحي وشرف",27,"ف",1,0],["قلت: يا غمرةُ قلبي كَلِفٌ","فاغْمِريني واصْنَعي في القَلبِ عِشْرَةْ",28,"ر",2,0],["قلتُ يا قلبُ أنتَ سلطتَ عيني","تَرْتِعي في رياضِ ذاتِ الحِجَالِ",29,"ل",1,0],["قُلتُ يا طَيرُ ادنُ مِنّي","قالَ ها ثُمَّ تَدَلّى",30,"ل",2,0],["قُلتُ يا هَذِهِ عَدلتِ عَنِ النُص","حِ أَما لِلرَشادِ فيكِ نَصيبُ",31,"ب",1,0],["قُلتَ يا لَيلَ ما عَلَينا إِذا النا","سُ تَجَنَّبوا فَالحُبُّ قَد أَعطانا",32,"ن",2,0],["قُلتُ يا لَيلَ كَم خَبِرتُ قُلوباً","فَبِنَفسي مِن ذلِكَ الخُبرِ حَسبُ",33,"ب",1,0],["قُلتُ يا لَيلَ قُلتِ بَعدَ الأَفاعي","جاءَ شِعرٌ مُرَطَّبُ الحُبِّ عَذبُ",33,"ب",1,0],["قُلتُ يا لَيلَ قُلتِ شِعرُكَ فيها","حَيَّرَتني فيهِ مَآسٍ تُغِبُّ",33,"ب",1,0],["قُلتُ يا لَيلَ إِنَّ حُكمَتِ ظالِم","فَاِرحَميها فَالحُبُّ كَاللَهِ راحِم",33,"م",1,0],["قُلتُ يا عرّافَتي هل أَنتِ مَن","قَرَأَت في الغَيبِ أَسرارَ الحَياةِ",34,"ه",1,0],["قُلتُ يا صالحُ ارمِ دَل","وَكَ في جُملَةِ الدِلا",35,"ل",2,1],["قلتُ يا ليتَني شَبِيهك قالت","إنّما يَقتُل المحبَّ 