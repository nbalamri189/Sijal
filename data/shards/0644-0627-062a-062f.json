m38355.html","الخفيف"],[268,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[279,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[296,"وقف على الفيض أنفاس مصعدة","https://www.aldiwan.net/poem36301.html","عموديه"],[301,"لا تدعي من بعدها ودي فقد","https://www.aldiwan.net/poem57686.html","الكامل"],[301,"يقول محبوبي لغصن النقا","https://www.aldiwan.net/poem57899.html","السريع"],[301,"لا تدعي أنك أرسلت لي","https://www.aldiwan.net/poem58184.html","السريع"],[302,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[326,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[326,"يا بخيلا وكل نظرة عين","https://www.aldiwan.net/poem55026.html","الخفيف"],[326,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[346,"صاح قم إن نسيم الصبح هب","https://www.aldiwan.net/poem19848.html","الرمل"],[346,"بي رمد جاء كلمح بالبصر","https://www.aldiwan.net/poem20234.html","الرجز"],[346,"هم فارقوك وهذه الأوطان","https://www.aldiwan.net/poem20733.html","الكامل"],[362,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[369,"إن تخطاني زماني","https://www.aldiwan.net/poem57086.html","مجزوء الرمل"],[374,"لا تدينوا لن تدانوا","https://www.aldiwan.net/poem59365.html","مجزوء الرمل"],[377,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[429,"قامت حروب الهوى على ساق","https://www.aldiwan.net/poem12314.html","المنسرح"],[429,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[438,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[451,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[462,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[466,"يا شريف الأغراس والأغراق","https://www.aldiwan.net/poem59811.html","الخفيف"],[493,"قسماً لا زعزع الشيب","https://www.aldiwan.net/poem10237.html","مجزوء الرمل"],[498,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[498,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[549,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[551,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[554,"أعيت على الأوهام تلك العلى","https://www.aldiwan.net/poem2487.html","السريع"],[556,"ردني الله إليه من سواه","https://www.aldiwan.net/poem33641.html","الرمل"],[556,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[556,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[556,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"],[556,"ظهر الوجود بسائر الأشياء","https://www.aldiwan.net/poem35085.html","الكامل"],[565,"باكر الصبحة هذا","https://www.aldiwan.net/poem69516.html","الرمل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لا تُدنِيَنَّ مُوارِبينَ دَعَوتَهُم","يَومَ الطِعانِ فَسَوَّفوكَ إِلى الغَدِ",0,"د",1,0],["لا تَدَعني بَينَ المَطامِعِ وَاليَأ","سِ وَوِردي ما بَينَ مُرٍّ وَعَذبِ",1,"ب",1,0],["لاَ تُدْنِ مِنْ بَابِكَ شَخْصاً يَرَى","بأَنَّهُ فِي النَّاسِ أَوْلَى بِهِ",2,"ب",2,0],["لا تدعْ مَغْرِسَ الكريم من الغَرْ","سِ خَلاءً من الكريم قَواءَ",3,"ا",2,0],["لا تَدَعْني سُدىً فَتَرْقِيَ منِّي","حيّةً لا تُطاوع الرَّقّاءَ",3,"ا",2,0],["لا تدعني فأنت آثرُ بالحم","دِ قديماً وفضلك المأثورُ",4,"ر",1,0],["لا تدعُوَنْ بالبقاء ويك له","فموتُهُ من أخاير الخير",5,"ر",1,0],["لا تدخلن الجفاء في لطفٍ","فربما ألطف امرؤ فجفا",6,"ف",2,0],["لا تدع معشراً سماناً يكظّو","ن سماناً وآخرين عجافا",7,"ف",2,0],["لا تَدَعْ منْ وعدْتَه حين تلقا","هُ قذاةً تُجيلُها آماقُكْ",8,"ك",1,0],["لا تدعْ محضراً تُحقِّقُ فيه","حُسْنَ ظَنِّي فالقولُ جَمٌّ فنونه",9,"ن",2,0],["لا تُدرِكُ الأَكبادُ سِرَّ وُجودِها","حَتّى يَجولُ الحُبُّ في الأَكبادِ",10,"د",1,0],["لا تَدَّعيهِ فَلَيسَ يُملَكُ إِنَّهُ","كَالرَوضِ جَهدُكَ أَن تَشِمَّ عَبيرَهُ",11,"ه",1,0],["لا تدسّوا الهوى لهن غرورا","فالعذارى قلوبهن هواء",12,"ا",2,0],["لا تدخل الحانات مستهترا","فالصفع في الحانات ساق يطوف",13,"ف",1,1],["لا تَدعُوَنَّ أَبا الوَليدِ لِنائِلِ","خُلُقَ الحِمارِ وَخِلقَةَ الجاموسِ",14,"س",1,0],["لاتَدَعُ الأَحشاءَ إِلّا لَها","تَحَرُّقٌ ذاتُ الحَشا المُرهَفِ",15,"ف",1,0],["لا تَدَلَّل عَلَيَّ بِالبُخلِ إِنّي","لَيسَ يَصبينِيَ الحَبيبُ البَخيلُ",16,"ل",1,0],["لاتَدفَعُ المَوتَ عَمَّن","حَلَّ الحُصونَ الحُصونُ",17,"ن",1,0],["لا تَدَع نَهبَ سُرورٍ عاجِلاً","كُلَّما أَمكَنَ في الدُنيا سُرورُ",18,"ر",1,0],["لا تُدمِني نظراً إليَّ فو الذي","جَعَلَ الهوى قَدَراً على كفيكِ",19,"ك",1,0],["لا تَدَعني لليالي فغداً","تجرَح الفرقة ما تأسو يَدُك",20,"ك",1,0],["لا تُدهِشَنّي بِالحِجابِ فَإِنَّني","فَطِنُ البَديهَةِ عالِمٌ بَمَوارِبي",21,"ب",2,0],["لا تُدهِنوا في حُكمِهِ فَالبَحرُ قَد","تُردي غَوارِبُهُ وَلَيسَ بِطامِ",22,"م",1,0],["لا تَدعُوَن نوحَ بنَ عَمرٍو دَعوَةً","لِلخَطبِ إِلّا أَن يَكونَ جَليلا",23,"ل",2,0],["لا تُدركُ العَينُ مِنها حينَ تَلمَحُها","إِلا مِثالاً كَلَمعِ البَرقِ في الظُّلَمِ",24,"م",1,0],["لا تدنُ منَ الملوكِ يوماً","فالبعدُ منَ الملوكِ قربُ",25,"ب",1,0],["لا تدنُ مني ودعني","أكتبْ وأنتَ تقابلْ",26,"ل",1,0],["لا تَدَعْنَا مَغْنمَاً لِلظّافرِ","واسْتَجبْها دعوةً من شاعِرِ",27,"ر",1,0],["لا تدعها يا ابنَ حربٍ جَذوةً","تتلظَّى من قريشٍ في الكَبِدْ",28,"د",1,0],["لا تدّعوا أنكم منها بِمُعتصَمٍ","واقٍ ولا تطمعوا أن تُتركوا هَمَلا",29,"ل",2,0],["لا تَدَعني بَعدَ الجَفا","أَتَمَنّى خُفَّي حُنَين",30,"ن",1,0],["لا تدَّعي دعْوى أتَتْكِ تكذُّباً","كتكذُّبي وتخرُّصاً كتخرّصي",31,"ص",2,0],["لا تَدَع زِنيَةً وَدَع زُبَّ يَحيى","وَاِسأَلِ أُختَيكَ عَن لَذيذِ الزِناءِ",32,"ا",2,0],["لا تَدَرَّع مِنَ القَضاءِ فَما سَي","فُ المَنايا عَنِ الدُروعِ بِنابِ",33,"ب",1,0],["لا تَدنُوَنَّ مِنَ الشُرورِ وَأَهلِها","فَتَكونَ مِن أَهلِ العُلى مُتَباعِدا",34,"د",2,0],["لا تَدنُوَنَّ مِنَ النِسا","ءِ فَإِنَّ غِبَّ الأَريِ مُرُّ",35,"ر",1,0],["لا تَدَّعوا عِتقاً عَلى مَولاكُمُ","فَالرَأيُ أَوجَبَ أَنَّكُم لَم تُعتَقوا",36,"ق",3,0],["لا تدن من حياضها","فإنما الماء نضب",37,"ب",1,0],["لا تُدر راياً به أضيَعُ مَن","في لظاه مستعينٌ بالحِجا",38,"ج",2,0],["لا تدَعني أقطَع الأيامَ وحدي وأُعاني","فحرَامٌ يا حبيبي",39,"ي",1,0],["لا تَدَّعِي جَوْباً لها","ذاتُ الخَوافِي والقَوادِمْ",40,"م",1,0],["لا تَدْهَشِ الدُّنيا فصَوْلَةُ عَزْمِهِ","أَقْوَى على كَبْح الصِّعابِ وأقدَرُ",41,"ر",1,0],["لا تَدَعْني يا شعرُ في ليلة الذِّرَى","وَأَطْلِقْ إِلى الخَيالِ سَارحي",42,"ح",2,0],["لا تَدَعْ في لَهَاةِ فَنِّكَ صَوْتاً","إِنْ رَنَا مُصْغِياً يُريِدُ الْمَزِيدا",43,"د",2,0],["لا تدفنوه بباطن الصحراء، بل","في الروض بين الماء والأشجار",44,"ر",1,0],["لا تدعي فارس تختصه","فالولد البَرْز لمن أنجبا",45,"ب",2,0],["لا تدفعنّ تلك النفوس إلى الرّدى","إنّ النفوس وإن صغرن غوالي",46,"ل",2,0],["لا تَدُقّي بابي .. وظلِّي بعمري","مُسْتَحيلاً ، ما عانَقَتْهُ الظُنُونُ",47,"ن",1,0],["لا تُدركنهُ وَإِن راقَت جَواهرهُ","فَالعقد لِلخود لا لِلفارس البَطَل",48,"ل",1,0],["لا تدعي ما ليس في","ك فما لما تبديه معنى",49,"ن",2,0],["لا تدرك النفس منها حين تطلبها","ألا التفجع أو لدغا بأحشاء",50,"ا",2,0],["لا تدرها فإنني غير صاح","رب راحٍ شربت من غير راح",51,"ح",1,1],["لا تدع للعدو فيك مجالا","لكلامٍ ولا مساغاً لمكرِ",52,"ر",1,0],["لا تُدَغْدِغْ صَدْرَ المُدامِ بِأَيْدِي الْ","مَزْجِ مَا دُغْدِغَتْ صُدُورُ المَثَاني",53,"ي",1,0],["لا تَدَعْ عاجِلَ السُّرورِ وَبادِرْ","فَعَساهُ يَعُودُ أَوْ لا يَعُودُ",54,"د",1,0],["لا تدنَ منه إذا تناول صارماً","واهرب إِليه إذا تناول مُصحفا",55,"ف",2,0],["لا تدعونَّ إِليكً الشرَّ محتفلاً","فالشرُّ أسرع مدعو أجاب دُعُا",56,"ع",2,0],["لا تدن من تلك الظبا إن الردى","معها يجور عل النفوس ويعتدى",57,"د",2,0],["لا تدنه والله يبعده ولا","ترفعه وانزله بدار هوان",58,"ن",1,0],["لا تَدخُلَنَّكَ ضَجرَةٌ مِن سائِلٍ","فَلَخَيرُ دَهرِكَ أَن تُرى مَسؤولا",59,"ل",2,1],["لا تَدعُ شَمسَ الدِينِ يا ذا الحِجا","مُخاطِباً إِلّا غياثَ الأَنام",60,"م",1,0],["لا تَدَّخِرَّ لغدٍ فإنَّ نواله","أبداً بكلِّ نَفيسةٍ يَهْتان",61,"ن",1,0],["لا تَدَعني سيّدي مُهتضما","ليسَ عِندي مِن سهامٍ أو قسي",62,"ي",1,0],["لا تدع يا جميل قلبي يتيما","بتساقى الأحزان كالأيتام",63,"م",1,0],["لا تدعني أهواك قلبا لقلب","أنا في الوجد بالجمال غريق",64,"ق",1,0],["لا تدلوا بحسنكم قد سلونا","وأمنّا من هجركم والتجنّى",65,"ن",2,0],["لا تَدَعني يا رَبُّ أَحمل أَوجا","عي أَمامَ الباقينَ من أَبنائي",66,"ا",2,0],["لا تدخُلِ الحانَ والصُفّاعُ ثائِرَةٌ","حتّى تُقامَ حوالَيكَ المَتاريسُ",67,"س",1,0],["لا تُدرِكُ الأَفهامُ غا","يَةَ حَمدِها وَثَنائِها",68,"ا",3,0],["لا تَدَعني في يَدِ الأَي","يامِ مَحصوصَ الجَناحِ",69,"ح",1,0],["لا تدعني لصبوحٍ","إن الغبوق حبيبي",70,"ي",1,1],["لا تدبّر لك أمراً","نحن أولى بك منكا",71,"ك",2,0],["لا تَدَعني آتيهِ في غورِ حَظّي","أَقصِدُ الغَيرَ في الحِمى الكَونِيِّ",72,"ي",1,0],["لا تدرك الراجون غاية مجده","الا إذا اقتنص الغداف الأعصما",73,"م",2,0],["لا تدعني فرداً إلهي وحيداً","وأغثني يا من به يستغاث",74,"ث",1,1],["لا تدّعي حرَيةً وعدالةً","فعلى مَظالِمهِ بنى بابيك",75,"ك",1,0],["لا تدعي شمس الضحى","شرفي لدى برج الحمل",76,"ل",1,0],["لا تُدخَرُ المودَّه","إِلّا ليوم الشِدَّه",77,"ه",1,0],["لا تدَّخرْ جَلَداً أو مدمعاً لغدٍ","ما بعد ذا اليوم ما يُخشى وَإِنْ عظما",78,"م",2,0],["لا تدعي من بعدها ودي فقد","فضحتك عندي محنة الأيام",79,"م",1,1],["لا تدعي أنك إذ تنثني","مثلي فهذا غلطٌ ظاهرُ",80,"ر",1,0],["لا تدعي أنك أرسلت لي","خيالك الطارق في ليلته",81,"ه",1,1],["لا تدعني رسول اللَه مطرحاً","بين الحوادث والآفات والغير",82,"ر",1,0],["لا تدع للهوى عليك سبيلا","فالهوى سيّد الغويِّ الغرور",83,"ر",1,0],["لا تدَعني أنظر إليك سراباً","شائع النور في سماوات فنّى",84,"ن",2,0],["لا تدَعنى إن شئت نسيان همي","واسقنيها خلديّة النشوات",85,"ت",1,0],["لا تدَعْ لَذَّةَ يَومٍ لِغَدٍ","قَبْلَ عَوْدِ الدَّهْرِ فِيَما قَدْ وَهَبْ",86,"ب",1,0],["لا تَدْخُلِ الحَمَّامَ إلا في سَحَرْ","وَمِن غَرِيبٍ ما أَتَاكُمْ بِخَبَرْ",87,"ر",1,0],["لا تُدخَرُوا الأَجفانُ بَعدَ فرِاقِهمْ","فَلأَي مَعنًى تُذخَرُ الأَجفانُ",88,"ن",1,0],["لا تَدَّعوا شوقاً إليّ ولم يدعْ","منّي الغرامُ سوى مِثالٍ باد",89,"د",1,0],["لا تَدَع سِرَّكَ رهناً","بينَ طَرفي ولِسانِي",90,"ي",1,0],["لا تدينوا لن تدانوا","بالرذائلْ والمناقصْ",91,"ص",1,1],["لا تَدِن من زلَّ حتى","لو رأيت أخاك ناقصْ",91,"ص",1,0],["لا تدع شاهك تحت الكشفِ","في النزع فالنزع رسولُ الحَتفِ",92,"ف",1,0],["لا تَدَّعي رِقِّيَ الخُطًوبُ فَقَدْ","أّخّذْتُ مِنْهُ كِتابَ إعْتَاقِ",93,"ق",1,0],["لا تَدَعْ ليلَكَ البهيمَ وقد فُزْ","تَ بها غُرَّةٌ يَمُرُّ بَهيمها",94,"م",3,0],["لا تدفع الأَبواب نازلة القضا","أَبداً فما دون القضاء الباب",95,"ب",1,0],["لا تدعهم في ضلا","ل الجهل لم يبلغه حصر",96,"ر",1,0],["لا تدعني مذبذبَ العزم ما","بين مقامٍ أخافهُ ومسير",97,"ر",1,0],["لا تَدَعَني فَإِنَّني عازِمٌ أَن","أُشمِتَ الإِصطِباحِ بِالإِغتِباقِ",98,"ق",1,0],["لا تدع من لذة العي","ش عياناً لسماع",99,"ع",1,0],["لا تَدَعْنا رَهْنَ القَطيعَةِ إنَّا","قد قَطَعْنا من غيرِكَ الآمالا",100,"ل",2,0],["لا تُدَبِّرْ لكَ أمراً","إنَّما التَّدبيرُ شاغلْ",101,"ل",1,0],["لا تُدرِكُ الساداتُ سُؤدده ولو","طاروا بأجنحةِ النّسورِ وحلّقوا",102,"ق",3,0],["لا تُدنِنِي من عاقدٍ أنفَهُ","ملآنَ من تِيهٍ ومن نَخْوَةِ",103,"ه",1,0],["لا تَدعُ بي الشَوقَ إِني غَيرُ مَعمودِ","نَهى النُهى عَن هَوى الهَيفِ الرَعاديدِ",104,"د",1,1],["لا تُدرَكُ الغاياتُ إِلا مُنىً","لا يُجتَلى البارِقُ إِلا التِماح",105,"ح",1,0],["لا تدعني بالسوى مشتغلاً","عنك لي عز من الغير وجاه",106,"ا",2,0],["لا تدع يا برق مني أثراً","أثر العين يزيد الوجعا",107,"ع",2,0],["لا تدع يا شوق مني أثراً","للتي سرت بها سير الجدود",108,"د",1,0],["لا تدعي مالم يكن لك تفتضح","يوم اللقا في حضرة الأحباب",109,"ب",1,0],["لا تدرك الأبصار منه سوى السوى","وهي الحوادث جملة الأفياء",110,"ا",2,0],["لاَ تَدَعْ وُسْطَى مِنَ الْحَا","لِ لِأَحْوَالِ جِسَامِ",111,"م",1,0],["لا تدفعونهم وإن جحدتم","عن فضلهم طرا وإن كابرتم",112,"م",1,0]]}