{"poems":[[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[77,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"يا غيورا أن يهتك المستور","https://www.aldiwan.net/poem62847.html","الخفيف"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[51,"أبا علي طلبت عيبك ما اسطعت","https://www.aldiwan.net/poem65452.html","المنسرح"],[51,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[51,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[91,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[89,"خدعوها بقولهم حسناء","https://www.aldiwan.net/poem44939.html","الخفيف"],[85,"لا تدخل الحانات مستهترا","https://www.aldiwan.net/poem7569.html","السريع"],[45,"قل للأرند إذا أتى الروحين لا","https://www.aldiwan.net/poem64596.html","الكامل"],[45,"لم تبلغ الحق ولم تنصف","https://www.aldiwan.net/poem65144.html","السريع"],[45,"يا ابن عمر والخير فيك قليل","https://www.aldiwan.net/poem65555.html","الخفيف"],[49,"سكر الشباب جنون","https://www.aldiwan.net/poem63129.html","المجتث"],[66,"ثب إلى اللذات فالعمر قصير","https://www.aldiwan.net/poem39046.html","الرمل"],[97,"ذهب الشباب فجئت بعد ذهابِه","https://www.aldiwan.net/poem24381.html","الكامل"],[97,"حان حرماني وناداني النذير","https://www.aldiwan.net/poem24787.html","الرمل"],[44,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"أوصيك فإن قبلت مني","https://www.aldiwan.net/poem28099.html","مجزوء الدوبيت"],[69,"لسان حال عذار","https://www.aldiwan.net/poem28639.html","المجتث"],[105,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[50,"يفخر الباهلي أن جعل الله","https://www.aldiwan.net/poem64887.html","الخفيف"],[46,"خف دنيا كما تخاف شريفا","https://www.aldiwan.net/poem22360.html","الخفيف"],[46,"يا صاع لست أريد صاع مكيلة","https://www.aldiwan.net/poem22438.html","الكامل"],[46,"أشدد يديك بما أقو","https://www.aldiwan.net/poem22590.html","مجزوء الكامل"],[46,"الغيب مجهول يحار دليله","https://www.aldiwan.net/poem23025.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39610","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[99,"إمرأة مِنْ دُخَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68837&r=&rc=389",""]],"verses":[["لا تُدنِيَنَّ مُوارِبينَ دَعَوتَهُم","يَومَ الطِعانِ فَسَوَّفوكَ إِلى الغَدِ",0,"د",1,0],["لا تَدَعني بَينَ المَطامِعِ وَاليَأ","سِ وَوِردي ما بَينَ مُرٍّ وَعَذبِ",1,"ب",1,0],["لاَ تُدْنِ مِنْ بَابِكَ شَخْصاً يَرَى","بأَنَّهُ فِي النَّاسِ أَوْلَى بِهِ",2,"ب",2,0],["لا تدعْ مَغْرِسَ الكريم من الغَرْ","سِ خَلاءً من الكريم قَواءَ",3,"ا",2,0],["لا تَدَعْني سُدىً فَتَرْقِيَ منِّي","حيّةً لا تُطاوع الرَّقّاءَ",3,"ا",2,0],["لا تدعني فأنت آثرُ بالحم","دِ قديماً وفضلك المأثورُ",4,"ر",1,0],["لا تدعُوَنْ بالبقاء ويك له","فموتُهُ من أخاير الخير",5,"ر",1,0],["لا تدخلن الجفاء في لطفٍ","فربما ألطف امرؤ فجفا",6,"ف",2,0],["لا تدع معشراً سماناً يكظّو","ن سماناً وآخرين عجافا",7,"ف",2,0],["لا تَدَعْ منْ وعدْتَه حين تلقا","هُ قذاةً تُجيلُها آماقُكْ",8,"ك",1,0],["لا تدعْ محضراً تُحقِّقُ فيه","حُسْنَ ظَنِّي فالقولُ جَمٌّ فنونه",9,"ن",2,0],["لا تُدرِكُ الأَكبادُ سِرَّ وُجودِها","حَتّى يَجولُ الحُبُّ في الأَكبادِ",10,"د",1,0],["لا تَدَّعيهِ فَلَيسَ يُملَكُ إِنَّهُ","كَالرَوضِ جَهدُكَ أَن تَشِمَّ عَبيرَهُ",11,"ه",1,0],["لا تدسّوا الهوى لهن غرورا","فالعذارى قلوبهن هواء",12,"ا",2,0],["لا تدخل الحانات مستهترا","فالصفع في الحانات ساق يطوف",13,"ف",1,1],["لا تَدعُوَنَّ أَبا الوَليدِ لِنائِلِ","خُلُقَ الحِمارِ وَخِلقَةَ الجاموسِ",14,"س",1,0],["لاتَدَعُ الأَحشاءَ إِلّا لَها","تَحَرُّقٌ ذاتُ الحَشا المُرهَفِ",15,"ف",1,0],["لا تَدَلَّل عَلَيَّ بِالبُخلِ إِنّي","لَيسَ يَصبينِيَ الحَبيبُ البَخيلُ",16,"ل",1,0],["لاتَدفَعُ المَوتَ عَمَّن","حَلَّ الحُصونَ الحُصونُ",17,"ن",1,0],["لا تَدَع نَهبَ سُرورٍ عاجِلاً","كُلَّما أَمكَنَ في الدُنيا سُرورُ",18,"ر",1,0],["لا تُدمِني نظراً إليَّ فو الذي","جَعَلَ الهوى قَدَراً على كفيكِ",19,"ك",1,0],["لا تَدَعني لليالي فغداً","تجرَح الفرقة ما تأسو يَدُك",20,"ك",1,0],["لا تُدهِشَنّي بِالحِجابِ فَإِنَّني","فَطِنُ البَديهَةِ عالِمٌ بَمَوارِبي",21,"ب",2,0],["لا تُدهِنوا في حُكمِهِ فَالبَحرُ قَد","تُردي غَوارِبُهُ وَلَيسَ بِطامِ",22,"م",1,0],["لا تَدعُوَن نوحَ بنَ عَمرٍو دَعوَةً","لِلخَطبِ إِلّا أَن يَكونَ جَليلا",23,"ل",2,0],["لا تُدركُ العَينُ مِنها حينَ تَلمَحُها","إِلا مِثالاً كَلَمعِ البَرقِ في الظُّلَمِ",24,"م",1,0],["لا تدنُ منَ الملوكِ يوماً","فالبعدُ منَ الملوكِ قربُ",25,"ب",1,0],["لا تدنُ مني ودعني","أكتبْ وأنتَ تقابلْ",26,"ل",1,0],["لا تَدَعْنَا مَغْنمَاً لِلظّافرِ","واسْتَجبْها دعوةً من شاعِرِ",27,"ر",1,0],["لا تدعها يا ابنَ حربٍ جَذوةً","تتلظَّى من قريشٍ في الكَبِدْ",28,"د",1,0],["لا تدّعوا أنكم منها بِمُعتصَمٍ","واقٍ ولا تطمعوا أن تُتركوا هَمَلا",29,"ل",2,0],["لا تَدَعني بَعدَ الجَفا","أَتَمَنّى خُفَّي حُنَين",30,"ن",1,0],["لا تدَّعي دعْوى أتَتْكِ تكذُّباً","كتكذُّبي وتخرُّصاً كتخرّصي",31,"ص",2,0],["لا تَدَع زِنيَةً وَدَع زُبَّ يَحيى","وَاِسأَلِ أُختَيكَ عَن لَذيذِ الزِناءِ",32,"ا",2,0],["لا تَدَرَّع مِنَ القَضاءِ فَما سَي","فُ المَنايا عَنِ الدُروعِ بِنابِ",33,"ب",1,0],["لا تَدنُوَنَّ مِنَ الشُرورِ وَأَهلِها","فَتَكونَ مِن أَهلِ العُلى مُتَباعِدا",34,"د",2,0],["لا تَدنُوَنَّ مِنَ النِسا","ءِ فَإِنَّ غِبَّ الأَريِ مُرُّ",35,"ر",1,0],["لا تَدَّعوا عِتقاً عَلى مَولاكُمُ","فَالرَأيُ أَوجَبَ أَنَّكُم لَم تُعتَقوا",36,"ق",3,0],["لا تدن من حياضها","فإنما الماء نضب",37,"ب",1,0],["لا تُدر راياً به أضيَعُ مَن","في لظاه مستعينٌ بالحِجا",38,"ج",2,0],["لا تدَعني أقطَع الأيامَ وحدي وأُعاني","فحرَامٌ يا حبيبي",39,"ي",1,0],["لا تَدَّعِي جَوْباً لها","ذاتُ الخَوافِي والقَوادِمْ",40,"م",1,0],["لا تَدْهَشِ الدُّنيا فصَوْلَةُ عَزْمِهِ","أَقْوَى على كَبْح الصِّعابِ وأقدَرُ",41,"ر",1,0],["لا تَدَعْني يا شعرُ في ليلة الذِّرَى","وَأَطْلِقْ إِلى الخَيالِ سَارحي",42,"ح",2,0],["لا تَدَعْ في لَهَاةِ فَنِّكَ صَوْتاً","إِنْ رَنَا مُصْغِياً يُريِدُ الْمَزِيدا",43,"د",2,0],["لا تدفنوه بباطن الصحراء، بل","في الروض بين الماء والأشجار",44,"ر",1,0],["لا تدعي فارس تختصه","فالولد البَرْز لمن أنجبا",45,"ب",2,0],["لا تدفعنّ تلك النفوس إلى الرّدى","إنّ النفوس وإن صغرن غوالي",46,"ل",2,0],["لا تَدُقّي بابي .. وظلِّي بعمري","مُسْتَحيلاً ، ما عانَقَتْهُ الظُنُونُ",47,"ن",1,0]]}