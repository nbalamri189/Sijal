{"poems":[[30,"إليك من الصمان والرمل أقبلت","https://www.aldiwan.net/poem1293.html",""],[30,"إليك أبان بن الوليد تجاوزت","https://www.aldiwan.net/poem5175.html","الطويل"],[30,"إليك سبقت ابني فزارة بعدما","https://www.aldiwan.net/poem5602.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54947","الوافر"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/871","الكامل"],[49,"لنْ للزمانِ ، وإنْ صعبْ","https://www.poetsgate.com/ViewPoem.aspx?id=14648",""],[30,"إليك من الصمان والرمل أقبلت","https://www.poetsgate.com/ViewPoem.aspx?id=21376",""],[266,"وقائلة لم لا هجوت الذي هجا","https://www.aldiwan.net/poem38134.html","الطويل"],[287,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[447,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136160","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112919","الطويل"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129801","الكامل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116854","الوافر"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32447","المتقارب"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139134","الرمل"],[4731,"بشتكيلك","https://www.poetsgate.com/ViewPoem.aspx?id=981",""],[1901,"ترى على العهدِ أهلُ الودِّ أم خانوا","https://www.poetsgate.com/ViewPoem.aspx?id=160421",""],[5212,"القمر العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=212583",""],[5299,"رسالة من الحدود","https://www.poetsgate.com/ViewPoem.aspx?id=210541",""],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""],[5703,"أتراكَ تأتيني","https://www.poetsgate.com/ViewPoem.aspx?id=206822",""],[5721,"كَانَ الشَّوْقُ مُضْطَهَدا","https://www.poetsgate.com/ViewPoem.aspx?id=190584",""]],"verses":[["لِنَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","إِلى خَيرِ أَهلِ الأَرضِ تُحدى رَكائِبُه",0,"ب",2,0],["لِنَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","سَيَلقى فُراتاً وَهوَ مَلآنُ أَكدَرُ",1,"ر",1,0],["لَنَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","سَيَأخُذُ إِن أَعطَيتَهُ حَبلَ عاصِمِ",2,"م",1,0],["لِنَلْقَى عَامَنَا سَمْحاً","طَلِيقَ الْبِشْرِ مُفْتَرَّا",3,"ر",2,0],["لِن لِزَمانِ وَإِن صَعُب","وَإِذا تَباعَدَ فَاِقتَرِب",4,"ب",1,1],["لنْ للزمانِ ، وإنْ صعبْ","وَإذَا تَبَاعَدَ فَاقْتَرِبْ",5,"ب",1,1],["لِنَلْقَاكَ، وَااللاّقِيكَ يَعْلمُ أنّهُ","إلى خَيرِ أهل الأرْض تُحدى ركائبُهْ",6,"ب",2,0],["لنلت منالاً منه ما نال بعضه","إذا ما طغا اليم المغم بفلكه",7,"ك",2,0],["لَنِلتَ الَّذي فاتَ الأَمانِيَّ شَأوُهُ","مِنَ الملكِ في دُنياكَ وَاِستَغرَقَ الفِكرا",8,"ر",2,0],["لنلثم تربة المختار حبّاً","ونمسك عروة الحبل الوثيق",9,"ق",1,0],["لنلبس تونس الخضراء تاجا","وينزع شعبنا ثوب الصغار",10,"ر",1,0],["لنلت ماذا تشتهي","وكنت فيمن قد ورد",11,"د",1,0],["لنلحق أقواما باحسانكم هدوا","إلى سنن التقوى إلى المورد الاحلا",12,"ل",2,0],["لنلتُ رضوانَ ربي إن تَغمّدني","من الأحبةِ غفرانٌ ورضوانُ",13,"ن",1,0],["لن لم يكن عطفُ فمنّوا بالنوى","إنّ الكريم إذا أهينَ تناءى",14,"ا",2,0],["لَنَلتَمِسن بأنفسِنا نساءً","تَبَينُ في المناكح أو تئيمُ",15,"م",1,0],["لِنَلقى فَواضِلَ مَن كَفِّهِ","فَصادَفتُ مِنهُ نَوالاً غَزيرا",16,"ر",2,0],["لن لمن تخشى أذاه","والقه في باب داره",17,"ه",1,1],["لن لفيتك لاتسلني عن علومي","خل عيني هي تفضي بالكلامي",18,"م",2,0],["لنلتُ رضوانَ ربي إن تَغمّرني","من الأحبةِ غفرانٌ ورضوانُ",19,"ن",1,0],["لن گلي عايفلك شمس","بأرض الطفوف وجيتك",20,"ك",1,0],["لنلاقي على الحدود شقيقا","خلسة ًوالحصارُ يَجلد فينا",21,"ن",2,0],["لِنلعَبَ في روابيها ونلهُو","ونقطفَ من مرابِعها الرَّطيبَه",22,"ب",2,0],["لنلمَّ شمْلَ الحُبِ كي نحْيا به","بينَ الجنانِ ونزرعُ الأزهارا",23,"ر",2,0],["لنلتقي صُدْفَةً فِي ظِلِّ سَوْسَنةٍ","إِنْ يَأَذَنِ اللهُ أِوْ لا نَلْتَقِي أَبَدا",24,"د",2,1]]}