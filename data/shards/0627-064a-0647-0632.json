{"poems":[[87,"في ذي الجفون صوارم الأقدار","https://www.aldiwan.net/poem7894.html","الكامل"],[87,"في ذي الجفون صوارم الأقدار","https://www.aldiwan.net/poem63664.html","الكامل"],[83,"وردا فمضمون نجاح المصدر","https://www.aldiwan.net/poem61521.html","الكامل"],[77,"يا روض علم ويا سحاب ندى","https://www.aldiwan.net/poem69090.html","الكامل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[92,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17415","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74062","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111441","الكامل"],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[2598,"تَمِيمُ بْنُ مُرَّ كَفْكِفُوا عَنْ تَعَمُّدِي","https://www.poetsgate.com/ViewPoem.aspx?id=20762",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["إيه زماني في الهوى وزمانها","تالله قد كنت النمير الجاري",0,"ر",2,0],["إيهٍ زَماني في الهَوى وَزَمانَها","ما كُنتُما إِلّا النَميرَ الجاري",1,"ر",2,0],["أَيَهُزُّ مِنكُم فارِسٌ في كَفِّهِ","سَيفاً وَدينُ مُحَمَّدٍ لَم يُنصَرِ",2,"ر",1,0],["أيَّ هِزَبْرٍ كانَ الهِزَبْرُ لقد","غادرَ منكَ الضَّرغامَة الأسدا",3,"د",2,0],["أيهزل هذا الدهر أم جد جده","وهل سروات المجد فيه مغانم",4,"م",1,0],["ايهٍ زعيم الشرق نجوى وامق","لَهجٍ بذكركَ هزَّهٌ الانشاد",5,"د",1,0],["أَيَهزَأُ بي العَبدُ الهُجَيمِيُّ ضِلَّةً","وَمِثلي رَمى ذا التُدرَءِ المُتَضَلِّلِ",6,"ل",1,0],["إيهِ زَغلولُ إِن دهرك أَمسى","غَيرُ زغلول لا يمرُّ بِباله",7,"ل",2,0],["إِيهٍ زَعِيمَي رَهطِ دُرَّاعِ الحَديِ","دِ فإنَّ مِثلَكُما يَكُرُّ ويُقدِمُ",8,"م",1,0],["إيه زرني يا موت قبل رضائي","أن يقول الضمير إني لئيم",9,"م",1,0],["أَيَهْزَأُ بِي العَبْدُ الهُجَيْمِيُّ ضِلَّة","ً وَمِثْلِي رَمَى ذَا التُّدْرَإِ المُتَضَلِّلِ",10,"ل",1,0],["أيهزأون أخانتهم بصائرهم","وأي عار بهذا العار قد جلبوا",11,"ب",3,0]]}