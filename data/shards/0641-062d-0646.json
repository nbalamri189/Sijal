{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[65,"أعائدة تلك الليالي بذي الغضى","https://www.aldiwan.net/poem45709.html","الطويل"],[65,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[65,"خاض الدجى ورواق الليل مسدولب","https://www.aldiwan.net/poem46219.html","البسيط"],[37,"حيتك عزة بعد الهجر وانصرفت","https://www.aldiwan.net/poem39108.html","البسيط"],[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[85,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[119,"ولطيفة نشرت فؤادي في غضا","https://www.aldiwan.net/poem41528.html","الكامل"],[228,"لقد مر بي أمس بالصدفة","https://www.aldiwan.net/poem41637.html","المتقارب"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[246,"منع النفس أن تنال مناها","https://www.aldiwan.net/poem45758.html","الطويل"],[259,"حبيب العمر","https://www.aldiwan.net/poem36222.html","مجزوء الرمل"],[290,"تدفق ماء معدني من الصخر","https://www.aldiwan.net/poem39345.html","الطويل"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[438,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[438,"بأبي سقيم الجفن صحح","https://www.aldiwan.net/poem12496.html","مجزوء الكامل"],[463,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[505,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[543,"صورة أفرغ الجمال عليها","https://www.aldiwan.net/poem47593.html","عموديه"],[647,"","https://poetry.dctabudhabi.ae/diwan/poem/198758","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87009","الكامل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18536","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77524","الرجز"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19934","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203746",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109128","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[1828,"","https://poetry.dctabudhabi.ae/diwan/poem/89636","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124734","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124726","الوافر"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[333,"","https://poetry.dctabudhabi.ae/diwan/poem/110879","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53121","الرجز"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33876","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109771","الكامل"],[2281,"","https://poetry.dctabudhabi.ae/diwan/poem/138880",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106860","الكامل"],[2819,"","https://poetry.dctabudhabi.ae/diwan/poem/203257","السريع"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120159","الكامل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105089","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112312","الرمل"],[3474,"","https://poetry.dctabudhabi.ae/diwan/poem/144877","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138599",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206131","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128884","المجتث"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94541","الوافر"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103270","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136580",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136548",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136645",""],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139275","الوافر"],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[5082,"سَفَرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214680",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5111,"تَرَاتيْلُ الْبَتُولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212511",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[5725,"إمام العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=215791",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6213,"عهدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76274&r=&rc=31",""]],"verses":[["فَحَنَّ لِإِلمامِهِم أَثلُهُ","وَمالَ إِلى قُربِهِم بانُهُ",0,"ن",2,0],["فَحِنَّ رُوَيداً أَيُّها القَلبُ واصَطَبِر","فَلا يَدفَعُ الأَقدارَ سُخطٌ وَلا رِضى",1,"ض",2,0],["فحَنَّ والوَجْدُ يستشري عَلَيهِ كَما","حَنّ الأعاريبُ منْ نَجْدٍ إِلى الوَطَنِ",2,"ن",1,0],["فحَنَّ صاحبُ رَحْلي إذ تأمَّلَهُ","حتى حَنَنْتُ ونِضْوي عنهُ مَشغولُ",3,"ل",1,0],["فَحَنَّ مِن وَلَهٍ إِذ قُلتُ ذاكَ لَهُ","وَظَلَّ مُعتَذِراً قَد شَفَّهُ الخَجَلُ",4,"ل",1,0],["فَحَنَّت بِها النُكبُ السَوافي فَأَكثَرَت","حَنينَ اللِقاحِ القارِباتِ العِواشِرِ",5,"ر",1,0],["فحنت إلى أوطانها وتسابقت","تعاود مسراها بها وتواصلُ",6,"ل",1,0],["فحِنّ إلى المَكارِمِ والمَعالي","ولا تُثْقِلْ مَطاكَ بعِبْءِ حَنّه",7,"ن",2,0],["فحنا قلبيَ الجريحُ عليها","كحُنُوّ الندى على الأعشاب",8,"ب",1,0],["فحنينه وأنينه وجنونه","لخيامها وكلامها ومدامها",9,"ه",2,0],["فَحَنَّ عَلَيَّ وَقَرَّبَ مِنّي","عُيونَ التَساؤُلِ عَن حالَتي",10,"ي",1,0],["فَحَنتهُما رَحِمٌ عَلَيهِ فَأَرسَلا","بِالقطفِ مَع عَدّاسٍ النَّصراني",11,"ن",2,0],["فَحَنا النَجاشِيُّ المُنيبُ عَلَيهِم","كَحُنُوِّ والِدَةٍ عَلى وِلدانِ",11,"ن",1,0],["فَحَنا عاطِفاً مُقيلاً وَكانَت","عَثرَةُ الحُبِّ عِندَهُ لا تُقالُ",12,"ل",1,0],["فَحنانيك أيُّها الموتُ كم تَه","تِكُ من حُرمَةِ العِبَادِ حِمَاها",13,"ا",3,0],["فحناني بعد شوقي","ذاك في قربي وبعدي.",14,"د",2,0],["فحنت إلى الأوطان نفس غريبة","نأت فرأت أنساً بإخوانها الغر",15,"ر",1,0],["فحَنَّ الأرحبِيُّ وهَمَّ شَوقاً","بكَفّي أَن يَحِنَّ الأصبَحيّ",16,"ي",1,0],["فحَنتْ قَدَّها لِلَقْطٍ منَ الأُفْ","قِ إليها كوَاكبُ الجوزاء",17,"ا",2,0],["فُحْنَ طيباً من بعدهنّ الديارُ","فوحَ مسكٍ أفاحَه العطارُ",18,"ر",1,1],["فحَنا وحنّ وربما","نظرَ السّليمُ الى السليمِ",19,"م",1,0],["فحنَّت أو فقطَّعها صَدَاها","صباحَ الذلِّ إن شرِبت مَرِيَّا",20,"ي",2,0],["فحنت لحتف كان فيه حياتها","ولميشنها أن حرموا غمض الجفان",21,"ن",1,0],["فحَنا عليَّ تكرُّماً وتَرَحُّماً","فحَيِيتُ يا سُبحانَهُ بارِي النَّسَمْ",22,"م",1,0],["فحنَا فَوقَها بِرَأسٍ خُضوعاً","وشِمالٌ لَم تُغنِهِ عن يَمِينِ",23,"ن",1,0],["فحنّطوه بعطرٍ من مدامعهم","وكفّنوه بعِشق نسجُه الهُدُبُ",24,"ب",1,0],["فَحنينُه مِنهُ لِتُونس زائدٌ","وَفُؤادُه عَنهُ إِلَيها راحل",25,"ل",1,0],["فَحِنّي حَنينَكِ وَاِستَيقِني","بَأَنّا اِطَّرَحناكِ ذاتَ الشِمالِ",26,"ل",1,0],["فَحَنَّ ذو المال عَلى النِعالِ","أَعطاهُ فَوراً مائتي ريال",27,"ل",1,0],["فحنت حنيناً يطرب الصب ذا الهوى","وقد نهلت منه بيأس وعلت",28,"ت",1,0],["فحنت تغمره ظل","لاً وتحنو مبسما",29,"م",2,0],["فحنت إليه بقلب أبرّ","وحن إليها بقلب أشم",30,"م",1,0],["فحنّ مشتْاقاً وأَنّْ","وكادَ من وَجدِ يَجِنّْ",31,"ن",1,0],["فحنّي رُوَيداً واِستَرُجّي وَبلِّغي","فَهَيهاتَ منك اليَوم تلكَ المَقارِفُ",32,"ف",1,0],["فحنثٌ واحدٌ وعليك فيما","قصدت لأربع أو اثنتين",33,"ن",1,0],["فحنث النذر يلزمه فيعطى","مؤونة سيره رجلٌ ضريرُ",34,"ر",1,0],["فحنانيكِ أيها الحرباء!","قَرَع الدَّهر نابنا وقرعنا",35,"ا",1,0],["فحنا ورق وضم رسما دارسا","يسرى جنون الحب في أصلابه",36,"ب",2,0],["فحن لذاك القدس لما بدا له","تقدس وصفا ساجدا خاضعا عبدا",37,"د",2,0],["فُحْنَ لنا رَوْضاً وَلُحْنَ أنجماً","وَرُحْن قد بُحْنَ بكلِّ مضمر",38,"ر",1,0],["فَحَنى قَوسَكَ الزَمانُ وَأَفنَت","كَ خُطوبٌ تَفنى عَلَيها القُرونُ",39,"ن",1,0],["فحنت ومني القول اخجلها","لكن رأت شيبي فأذهلها",40,"ه",2,0],["فحنوا ابتهاجا واستهيموا مسرة","وليس لكم في دون ذلك من عذر",41,"ر",1,0],["فحنت لها سلمى وقد ذرفت","دمعاً كعقدِ الدر يَنبَتُّ",42,"ت",1,0],["فحنت الأرواح من شدوه","إلى أنيس يا له من أنيس",43,"س",1,0],["فحنا على مثواه فى","قفص النحاس المقفل",44,"ل",1,0],["فحنّ الفؤاد لسكانها","حنين الطيور لأوكارها",45,"ر",3,0],["فَحَنِينٌ وَأنِينٌ وَزَفير","ذاك دأبي منذ وَدّعت البِلاد",46,"د",1,0],["فحنت لتقبيله شمعةٌ","ولم تحتشم ذلك في المحفل",47,"ل",1,0],["فحنت جوى تلك المنازل واغتدت","تقول ألم تعلمن بالطف ما جرى",48,"ر",2,0],["فَحَنت لَما قُلنا وَأَلقَت رِحالها","وَذلل مِنها الصَعب وَهُوَ عَسير",49,"ر",1,0],["فحنيت رأسًا في وصيدك ما انحنى","من قبلُ إلا للإله تعالى",50,"ل",2,0],["فحنكتني خطوب","وهذبتني شدائد",51,"د",1,0],["فَحَنَّ نِساءُ الحَيِّ مِن بَعدِ هَجعَةٍ","لِصَوتٍ دَعا أَثكالَهُنَّ فَأَسمَعا",52,"ع",2,0],["فحن لهم فؤاد الكون حتى","بكت لبكائه الصم الصلاد",53,"د",1,0],["فحنا عليهم بخير العزاء","مفاجيع أخشى عليهم ضرر",54,"ر",1,0],["فحنَّ اليك القلبُ والسُمر تنثَني","عليَّ وفي أحشائي البيضُ ترتع",55,"ع",1,0],["فحنَّ فؤادي عندَ ذكراكَ مثلما","تحنُّ الى ماء الغَدير الاباعر",56,"ر",1,0],["فحني واسعدي صباً مشوقاً","بعيدَ الدار ذا شَجنٍ حَزينا",57,"ن",2,0],["فحناء وحكاك مجيدٌ","وقل حجر يمر على الأديم",58,"م",1,0],["فحنَّا من حكمنا نجد حنّا","ومن هجر(ن)الى احواز فارس",59,"س",1,0],["فحنّا خير امّه بالبريه","ومنّا خير كل المرسلينا",60,"ن",2,0],["فحنيني اليومَ مشتعلٌ","يا حبيبًا مالَهُ خبرُ",61,"ر",1,0],["فحناه ثقل النبي حتى","كاد ينآد تحته مثنيا",62,"ي",2,0],["فَحَنِينُ مَاتَرَكَتْ رَبِيعًا زَاهِيًا","فَالعُمْرُ يَذْوِي ، وَالمَآقِيْ تَدْمَعُ",63,"ع",1,0],["فحنت ولو كانت جمادا لأسلمت","لك القيد واسترخت لمن رامها عمدا",64,"د",2,0],["فحنّاء الظباء جحود دينٍ","فلا تلقى اذا مطلتْ أثاما",65,"م",2,0],["فحنّت ومالت للرشيد منارة","وعاجت على المنصور تاجًا يزهّيها",66,"ي",3,0],["فحنَّ حمامُ الوصلِ من بعدِ فصلهِ","فصِرنا على جمعٍ تاللَهِ ولا حولا",67,"ل",2,0],["فحنوتِ ، ما أحلى حنانك في دمي","وخضعتِ فاتنتي بقلب يقرع",68,"ع",1,0]]}