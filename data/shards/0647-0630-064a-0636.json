{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34400","الكامل"],[1631,"","https://poetry.dctabudhabi.ae/diwan/poem/142174","البسيط"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[4852,"حانت حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=215172",""],[5155,"أين الفتى السياب!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[5574,"مَنْ يُخبِرُ الحوتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=205715",""],[6008,"احترتُ بالحاير","https://www.poetsgate.com/ViewPoem.aspx?id=59158",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""],[6089,"سامر سميرة","https://www.poetsgate.com/ViewPoem.aspx?id=214200",""]],"verses":[["هَذِي ضُرُوبٌ مِنْ فَضَائِلِهِ الَّتِي","رَفَعَتْهُ فَوْقَ مَنَازِلِ الأُمَرَاءِ",0,"ا",2,0],["هذي ضَراعَةُ مُذنِبٍ مُتَمَسِّكٍ","بِوَلائِكُم مِن يَومِ كانَ وَليدا",1,"د",2,0],["هذي ضحاياك في الايام ابدة","وللضحايا على الايام تأييد",2,"د",1,0],["هذي ضوابطُ إن تقُلَّ فإنَّها","كثُرَت فوائدُها لمن يتفهَّمُ",3,"م",1,0],["هذي ضلوعي، والحنايا، ترتخي","كي تحتوي ذا الكونَ .. لو يكفيني",4,"ن",2,0],["هذي ضفاف ابي (مغيرة)","لفها ليل اكتئاب",5,"ب",1,0],["٣- هذي ضِفافي وحولَ الشطِّ أوْردَتِي","لم ينفلِقْ قطُّ بحري، عاشَ ملتئِما",6,"م",2,0],["هذي ضروف ايامنا والمقادير","هم ٍ وغم ٍ فوق راسي تلايم",7,"م",1,0],["هذي ضراعتنا إليك ومنك يا","مولى الموالي الفضل والآلاء",8,"ا",2,0],["هذي ضلوعي ترتدي إحساسك","وفؤادي الظامي يعاقر كاسك",9,"ك",1,1]]}