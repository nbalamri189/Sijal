{"poems":[[55,"ثورتها تنتعل الظلاما","https://www.aldiwan.net/poem29812.html","الرجز"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[95,"انزل المنزل الحسن","https://www.aldiwan.net/poem11260.html","مجزوء الخفيف"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[95,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[53,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[47,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[107,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199492","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[79,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[107,"صلوا إخوانكم واقضوا الذماما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55081&r=&rc=251",""],[121,"العطرُ أنت (1)","https://www.aldiwan.net/poem24028.html","البسيط"],[124,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[139,"ثقي يا عز بالله القدير","https://www.aldiwan.net/poem49105.html","الوافر"],[155,"أي غد مع يد دد ذي حروف","https://www.aldiwan.net/poem1404.html",""],[230,"أي غصن في الروض هز نسيم","https://www.aldiwan.net/poem55211.html","الخفيف"],[257,"هذا هو السعي لا ما يدعي الواني","https://www.aldiwan.net/poem1430.html",""],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[333,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[376,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[408,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[445,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[463,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[469,"نضت يد الشرق سيوف الصباح","https://www.aldiwan.net/poem3576.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48899","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48507","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48800","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48865","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203795","البسيط"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26669","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49544","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53241","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53174","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106900","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93520","الطويل"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132209","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137433",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205055","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121621","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86297","الرجز"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89987","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97076","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83176","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72846","الكامل"],[4955,"ماكنتُ يوماً حاسداً أو حاقداً","https://www.poetsgate.com/ViewPoem.aspx?id=188080",""],[5064,"أغراب .. أغراب ..","https://www.poetsgate.com/ViewPoem.aspx?id=199044",""],[5213,"سأركبها مسومة عرابا","https://www.poetsgate.com/ViewPoem.aspx?id=170413",""],[5285,"هو وطني","https://www.poetsgate.com/ViewPoem.aspx?id=203189",""],[5320,"إلى البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=41634",""],[5376,"تئن على فراق الأهل درعا","https://www.poetsgate.com/ViewPoem.aspx?id=189706",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5464,"يا هند","https://www.poetsgate.com/ViewPoem.aspx?id=6842",""],[5616,"إيضاح شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204839",""],[4623,"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[402,"انزل المنزل الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=36479",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[6148,"شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=201600",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""],[6341,"طواف الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87287&r=&rc=16",""]],"verses":[["أَيَّ غِياثَ الخَلقِ وَالقِواما","إِنَّ بِأَرجانَ لَنا غَماما",0,"م",2,0],["أيُّ غيْثٍ منْ رحمَةِ اللهِ هامٍ","وسِراجٍ بهَدْيِهِ وضّاحِ",1,"ح",1,0],["أَيُّ غُنْمٍ لِمَاكِثٍ","وَهْوَ فِي السِّنِّ قَدْ طَعَنْ",2,"ن",1,0],["أَيُغْبَطُ مَنْ جَادَتْ يَدَاهُ بِعِرْضِهِ","لِمَا أَنَّهُ أَثْرَى بِذَاكَ فَأَكْرِمَا",3,"م",2,0],["أَيُّ غَرْسٍ غَرَسْتَهُ لَمْ يُبَارَكْ","لَكَ فِيهِ المُهَيْمَنُ المُتَعَالِي",4,"ل",2,0],["أيغتدي ذا عمى وذا صمم","من فَتَحَتْ كلُّ فَيْشَة سُدَدَهْ",5,"د",2,0],["أَيَغارُ الشَوكُ في الحَقلِ مِنَ الزَهرِ الجَني","أَم تُرى يَحسَبَهُ أَحقَرَ مِنهُ لَستُ أَدري",6,"ي",1,0],["أَيَغضَبُ أَن يُعاتَبَ بِالقَوافي","وَفيها المَجدُ وَالحَسَبُ الحَسيبُ",7,"ب",1,0],["أَيَغضَبُ أن يُحِبَّ أخٌ أخاه","وهل يأبى لِشملهما التئاما",8,"م",2,0],["أيغريكِ بالحبِّ سُودُ اللِّحى","غِلاظُ الشِّفاهِ العراضُ الطِّوالْ",9,"ل",1,0],["أَيَغْلِبُ الْحَقَّ لَوْ أَمْسَتْ فَيَالِقُهُ","عَنْ حَيِّزَيْهَا يَضِيْقُ الأَيْنُ وَالأَمَدُ",10,"د",1,0],["أَيُّ غُبْنٍ أَنْ يَقْصِبَ الغِصْنُ","مِخْصَلاً طَرِيفَ الأَزْهَارِ وَالأَوْرَاقِ",11,"ق",1,0],["أيغفر لي دلالك ما ألاقي","من الطعناتِ في القلب الوجيع؟",12,"ع",1,0],["أَيُغني غَداً عَبد الغنيّ بِوَقفَةٍ","لِمُلتَفِتٍ يَلقاهُ أَو مُتَشَوِّفُ",13,"ف",1,0],["أَيَغْلِبُ مَنْ عَادَاكَ وَاللهُ غَالِبُهْ","وَيُفْلِتُ مَنْ نَاوَاكَ وَالسَّيْفُ طَالِبُهُ",14,"ب",2,1],["أيغمدني كالسيف دهري عن العلى","وما حُمدت قبل الفعال الصوارم",15,"م",1,0],["أيغضب أن يحب أخ أخاه","وهل يأبى لشملها التئاما",16,"م",2,0],["أَيَغْفِرُ اللهُ ذَنْبًا أن أَبُوءَ به","حتّى ولو قَلَّ أو لم يُسْعِفِ العَمَلُ؟!",17,"ل",1,0],["أيغضبه السكوت وقد سكتنا","ولو قلنا لما أرضاه نقدي",18,"د",2,0],["أيغلبني على حقي مغيرٌ","ويرهقني ولم افقد نصيري",19,"ر",2,0],["أي غد مع يد دد ذي حروف","طاوعت في الرويّ وهي عيون",20,"ن",1,1],["أَيُّ غُصنٍ في الرَوضِ هزَّ نَسيمٌ","نُثِرَت منهُ هذه الأَزهارُ",21,"ر",1,1],["أَيُغتَرى فِريةً في ذِكرِ ماريَة","وآلِ جَفنةَ إِلّا عَقل حَيرانِ",22,"ن",1,0],["أَيُغالِهِ نُصرَةَ الدينِ أَوصَلَنا","إِلى الطَريقِ العُلا وَالخَيرِ وِجهَتُهُ",23,"ت",2,0],["أيّ غيبٍ ضمّته تلك التهاويلُ","وايّ اليومَين أطيب وردا",24,"د",2,0],["أيُّ غَبنٍ لَولا القِيامَةُ والمَر","جوُّ فيها مِن قُدرة الخَلاقِ",25,"ق",1,0],["أَيُغنيك دَمعُ أنتَ في الرَّبع ساكبُهْ","وقد رَحلَتْ غِزْلاَنهُ ورباربُهْ",26,"ب",2,1],["أَيَغْرُبُ عندَكَ نَجْمُ اغْتِرابِي","ومطلَعُهُ لَكَ فِي الأَرضِ بادِ",27,"د",1,0],["أيّ غمزٍ في الملك مذ لم تثقّف","ه ومذ لم تَرِشْ يداك نِبالَهْ",28,"ل",2,0],["أيُّ غلٍّ في قلبه ليَ لو يسق","يه لا بل يجيدهِ بات غلاَّ",29,"ل",2,0],["أيُّ غرامٍ جرَّهُ نظرة","وإيّما جدٍّ جناهُ المزاح",30,"ح",1,0],["أَيغولُ نمُهجَتي الكُماةُ وَما لَهُم","فَخرٌ سِوايَ إِذا اِغتَدوا في مَجمَعِ",31,"ع",1,0],["أيغني عن الزاد السلاح وغيره","وهل يستقيم الظهر إن فرغ البطن",32,"ن",1,0],["أيُغلَبُ من كان الهلال لواءه","يحيط به جند الفضاء المسخر",33,"ر",1,0],["أيُغلَبُ من أجناده تملأ الفضا","يسدد مرماها القضاء المقدر",33,"ر",1,0],["أيغفل شعري اليوم من كان كنزه","ويمنعني رأيي ويحرمني فني",34,"ن",2,0],["أيغضبني النكران وهو أقل ما","جنته اللياليْ إن عددَتُ اللياليا",35,"ي",2,0],["ايغالِبُون الغالبين ومن لهُ","حول على حرب القوي الطائلِ",36,"ل",1,0],["أيغمر العطر إن تحجب براعمه","أو ينصل الكوكب الوضاء إن بانا؟",37,"ن",2,0],["أيغرُّني أن يستطيل بيَ المدى","وأبي بحيثُ تواصتِ الغبراء",38,"ا",2,0],["أيُغْضِبُ حُسَّادي قيامي إلى العُلا","وقد قعَدوا لما ظفرتُ وخابوا",39,"ب",3,0],["أي غصن على كثيب وبدر","لاح من تحت فرعه الغسقيِّ",40,"ي",1,0],["أيُّ غصن له الذوائب أوراق","وبدر له من الصدغ هاله",41,"ل",2,0],["أيَّ غمار الحب لم يقتحم","لوائي العالي ولم يخفق",42,"ق",1,0],["أَيَغدو حسين حَيث لم تصلت الظبا","وَلا صهلت بَينَ الصُفوف سَلاهبه",43,"ب",2,0],["أيغدو ونير الأجنبي وسامه","يساق لحرث العار وهو قليل",44,"ل",1,0],["أيغلبني العذول على حبيبي","الأموات يباع فيشتريه",45,"ي",2,0],["أيغرق ديوان له البر مسلك","فكيف اذن لو كنت اسلكته البحرا",46,"ر",2,0],["أيُغْلَبُ من له الأَمْلاكُ جُنْدٌ","ورَبُّ العَرْشِ قد أمْسَى مُعِينَا",47,"ن",2,1],["أي غاوِياً يَرجوا مِن الدَهر البَقا","اِذ غضَّ في دُنياهُ عَن يَوم اللُقا",48,"ق",2,1],["أي غيثٍ همى ليحكي نداه","فهوَ غيث همى بوجهٍ وقاحِ",49,"ح",1,0],["أَيُغَادِرُ الإِغرِيقُ مُنهزَمينَ فَو","قَ البَحرِ للأَوطانِ شَرَّ هَزِيمةِ",50,"ه",1,0],["أيغض جفن بعد وقعة كربلا","أني وفي الأحشاء جذوة نار",51,"ر",1,0],["أَيَغِيضُ طَبعُكَ في التُرابِ وَطالَما","رَوّى الجَديبَ فَعادَ خِصباً مُمرِعا",52,"ع",2,0],["أيغيبُ عن أحشاي من","ذكري له يشفي السقيم",53,"م",1,0],["أيَغرُّني فيها نعيمٌ زائلٌ","أأكونُ في سجنِ الهوانِ أسيرا",54,"ر",2,0],["أَي غُربَةً تسَألُ الأكَوانَ عُنوَانَا","صُبحًا يُقَطَّعُ فِي الآفَاقِ حَيرَانَا",55,"ن",2,1],["أيغضبني الزمان ولا أراكم","بني عمي عليه إذا غضابا",56,"ب",2,0],["أيغدو الجدبُ في روضٍ","ونهرُ الحبِّ مَجراه ؟!",57,"ا",2,0],["أيغشى أقدس الأقداس ليل","كواكبه توارى فى الظلام",58,"م",1,0],["أيغفل من بنى السموات سبعا","تماديه إذا ما جاء قمعا",59,"ع",2,0],["أَيُغْوِي سَعْفُهُ المَحْرُوْقُ طَيْراً","نَخِيْلٌ ؟ وَالعَصَافِيْرَ القُبُوْرُ؟",60,"ر",1,0],["أَيَغارُ من عِقدٍ تَوَهَّمَهُ","شَفَةً فَجُنَّ فمي فلا رُشْدُ؟",61,"د",1,0],["أيُغني المالُ والمساحاتُ ثكلَى","وسيفُ الحقِّ في حَرَجٍ وضِيقِ؟",62,"ق",1,0],["أيغطي الغربال شمسا تبدت","دون ستر ونورها يغشاه",63,"ا",2,0],["أي غنم بماكث","وهو في السن قد طعن",64,"ن",1,0],["أيُّ غُبْنٍ تَرَاهُ لي غَيْرَ نَدْبي","طِيْبَ عَيْشٍ قَبلَ الثَّلاثينَ زَالا",65,"ل",2,0],["أيغفرُ ذنبي والذنوبُ كثيرة","ولم أسْدِ معروفا ولم ألزم الصّدْقا",66,"ق",2,0],["أيغيبُ نورٌ كان يقهرُ عتمةً","وتموتُ عينٌ كي تُزلزلَ مُبصِرا !؟",67,"ر",2,0],["أيغار من سلفٍ له ..وكأنه ال","إنسانُ في ظلماته ..يا للأسى!",68,"س",2,0]]}