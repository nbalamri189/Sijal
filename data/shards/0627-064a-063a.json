{"poems":[[53,"ثورتها تنتعل الظلاما","https://www.aldiwan.net/poem29812.html","الرجز"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[93,"انزل المنزل الحسن","https://www.aldiwan.net/poem11260.html","مجزوء الخفيف"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[93,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199492","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[105,"صلوا إخوانكم واقضوا الذماما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55081&r=&rc=251",""],[117,"العطرُ أنت (1)","https://www.aldiwan.net/poem24028.html","البسيط"],[120,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[135,"ثقي يا عز بالله القدير","https://www.aldiwan.net/poem49105.html","الوافر"],[151,"أي غد مع يد دد ذي حروف","https://www.aldiwan.net/poem1404.html",""],[225,"أي غصن في الروض هز نسيم","https://www.aldiwan.net/poem55211.html","الخفيف"],[252,"هذا هو السعي لا ما يدعي الواني","https://www.aldiwan.net/poem1430.html",""],[320,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[328,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[371,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[402,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[439,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[458,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[464,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[464,"نضت يد الشرق سيوف الصباح","https://www.aldiwan.net/poem3576.html","عموديه"]],"verses":[["أَيَّ غِياثَ الخَلقِ وَالقِواما","إِنَّ بِأَرجانَ لَنا غَماما",0,"م",2,0],["أيُّ غيْثٍ منْ رحمَةِ اللهِ هامٍ","وسِراجٍ بهَدْيِهِ وضّاحِ",1,"ح",1,0],["أَيُّ غُنْمٍ لِمَاكِثٍ","وَهْوَ فِي السِّنِّ قَدْ طَعَنْ",2,"ن",1,0],["أَيُغْبَطُ مَنْ جَادَتْ يَدَاهُ بِعِرْضِهِ","لِمَا أَنَّهُ أَثْرَى بِذَاكَ فَأَكْرِمَا",3,"م",2,0],["أَيُّ غَرْسٍ غَرَسْتَهُ لَمْ يُبَارَكْ","لَكَ فِيهِ المُهَيْمَنُ المُتَعَالِي",4,"ي",1,0],["أيغتدي ذا عمى وذا صمم","من فَتَحَتْ كلُّ فَيْشَة سُدَدَهْ",5,"د",2,0],["أَيَغارُ الشَوكُ في الحَقلِ مِنَ الزَهرِ الجَني","أَم تُرى يَحسَبَهُ أَحقَرَ مِنهُ لَستُ أَدري",6,"ي",1,0],["أَيَغضَبُ أَن يُعاتَبَ بِالقَوافي","وَفيها المَجدُ وَالحَسَبُ الحَسيبُ",7,"ب",1,0],["أَيَغضَبُ أن يُحِبَّ أخٌ أخاه","وهل يأبى لِشملهما التئاما",8,"م",2,0],["أيغريكِ بالحبِّ سُودُ اللِّحى","غِلاظُ الشِّفاهِ العراضُ الطِّوالْ",9,"ل",1,0],["أَيَغْلِبُ الْحَقَّ لَوْ أَمْسَتْ فَيَالِقُهُ","عَنْ حَيِّزَيْهَا يَضِيْقُ الأَيْنُ وَالأَمَدُ",10,"د",1,0],["أَيُّ غُبْنٍ أَنْ يَقْصِبَ الغِصْنُ","مِخْصَلاً طَرِيفَ الأَزْهَارِ وَالأَوْرَاقِ",11,"ق",1,0],["أيغفر لي دلالك ما ألاقي","من الطعناتِ في القلب الوجيع؟",12,"ع",1,0],["أَيُغني غَداً عَبد الغنيّ بِوَقفَةٍ","لِمُلتَفِتٍ يَلقاهُ أَو مُتَشَوِّفُ",13,"ف",1,0],["أَيَغْلِبُ مَنْ عَادَاكَ وَاللهُ غَالِبُهْ","وَيُفْلِتُ مَنْ نَاوَاكَ وَالسَّيْفُ طَالِبُهُ",14,"ب",2,1],["أيغضب أن يحب أخ أخاه","وهل يأبى لشملها التئاما",15,"م",2,0],["أَيَغْفِرُ اللهُ ذَنْبًا أن أَبُوءَ به","حتّى ولو قَلَّ أو لم يُسْعِفِ العَمَلُ؟!",16,"ل",1,0],["أيغضبه السكوت وقد سكتنا","ولو قلنا لما أرضاه نقدي",17,"ي",1,0],["أيغلبني على حقي مغيرٌ","ويرهقني ولم افقد نصيري",18,"ر",2,0],["أي غد مع يد دد ذي حروف","طاوعت في الرويّ وهي عيون",19,"ن",1,1],["أَيُّ غُصنٍ في الرَوضِ هزَّ نَسيمٌ","نُثِرَت منهُ هذه الأَزهارُ",20,"ر",1,1],["أَيُغتَرى فِريةً في ذِكرِ ماريَة","وآلِ جَفنةَ إِلّا عَقل حَيرانِ",21,"ن",1,0],["أَيُغالِهِ نُصرَةَ الدينِ أَوصَلَنا","إِلى الطَريقِ العُلا وَالخَيرِ وِجهَتُهُ",22,"ت",2,0],["أيّ غيبٍ ضمّته تلك التهاويلُ","وايّ اليومَين أطيب وردا",23,"د",2,0],["أيُّ غَبنٍ لَولا القِيامَةُ والمَر","جوُّ فيها مِن قُدرة الخَلاقِ",24,"ق",1,0],["أَيُغنيك دَمعُ أنتَ في الرَّبع ساكبُهْ","وقد رَحلَتْ غِزْلاَنهُ ورباربُهْ",25,"ب",2,1],["أَيَغْرُبُ عندَكَ نَجْمُ اغْتِرابِي","ومطلَعُهُ لَكَ فِي الأَرضِ بادِ",26,"د",1,0],["أيّ غمزٍ في الملك مذ لم تثقّف","ه ومذ لم تَرِشْ يداك نِبالَهْ",27,"ل",2,0],["أيُّ غلٍّ في قلبه ليَ لو يسق","يه لا بل يجيدهِ بات غلاَّ",28,"ل",2,0],["أيُّ غرامٍ جرَّهُ نظرة","وإيّما جدٍّ جناهُ المزاح",29,"ح",1,0]]}