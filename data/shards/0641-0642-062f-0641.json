{"poems":[[55,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[37,"أشاقك برق آخر الليل واصب","https://www.aldiwan.net/poem39619.html","الطويل"],[10,"يا أم عمرو ألا تبكين معولة","https://www.aldiwan.net/poem21109.html","البسيط"],[23,"تمنى جبير أن يسود كما رجا","https://www.aldiwan.net/poem21519.html","الطويل"],[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[94,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[94,"لقد نام أهل العلم نوما مغنطسا","https://www.aldiwan.net/poem38911.html","الكامل"],[47,"فؤاد بذكر الظاعنين موكل","https://www.aldiwan.net/poem65589.html","الطويل"],[30,"صل يا جنيد الخير لله صولة","https://www.aldiwan.net/poem5582.html","الطويل"],[46,"صريع هوى تغاديه الهموم","https://www.aldiwan.net/poem29685.html","الوافر"],[46,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[284,"ذرا السعي في نيل العلا والفضائل","https://www.aldiwan.net/poem2630.html","الطويل"],[287,"أتى نعي ملك أظلم الشمس والقمر","https://www.aldiwan.net/poem32742.html","الطويل"],[408,"دعوت إلى السلوان غير سميع","https://www.aldiwan.net/poem46744.html","الطويل"],[422,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[445,"بدا لك نجم السعد واطلع النجح","https://www.aldiwan.net/poem34791.html","الطويل"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[510,"المُقنَّع","https://www.aldiwan.net/poem27796.html","الطويل"],[545,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[558,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[572,"أبعد مصاب الأم آلف مضجعا","https://www.aldiwan.net/poem69542.html","الطويل"],[591,"متى بالقرب يخبرني الرسول","https://www.aldiwan.net/poem17645.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83334","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39012","الطويل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96452","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28381","الوافر"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74011","البسيط"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116686","الوافر"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117110","الهزج"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127980","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93737","الهزج"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130074","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138537",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91738","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91726","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91667","الهزج"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85233","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123504","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123517","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81940","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83648","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117302","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133059","الوافر"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140139",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[4733,"النظرة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=210308",""],[4755,"سَقَطْنَا لِأَنَّ الأَرضَ أَعلَى مِن الفَضَا","https://www.poetsgate.com/ViewPoem.aspx?id=183779",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5431,"وكم للحب آهاتٌ جياعُ","https://www.poetsgate.com/ViewPoem.aspx?id=188127",""],[5725,"القلب السليم","https://www.poetsgate.com/ViewPoem.aspx?id=215999",""],[6102,"أَحَقُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182816",""],[6120,"مَتَى لِلبَعْضِ نَعْتَرِفُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=215668",""]],"verses":[["فَقَد فَجَعَ الماضي لَبيداً بِأَربَدٍ","وَعُزِيَ قَبلي مالِكٌ مِن مُتَمِّمِ",0,"م",1,0],["فَقَد فُتنَ مُلتَجًّا كَأَنَّ نَئيجَهُ","سُعالُ جَوٍ أَعيَت عَلَيه الطَبائِبُ",1,"ب",1,0],["فَقَد فُجِعتِ بِمَيمونٍ نَقيبَتُهُ","جَمِّ المَخارِجِ ضَرّارٍ وَنَفّاعِ",2,"ع",1,0],["فَقَد فاتَ بِالمَجدِ التَليدِ أَباكُمُ","أَبو المِسوَرِ الحامي وَمَجدُكَ أَسفَلُ",3,"ل",1,0],["فقد فرَّغتك الشاغلاتُ وحبَّذا","فَراغُك من أحكام ما أنت سائسه",4,"س",2,0],["فقد فَجَّرتْ فيَّ هذي الكُلُومَ","كما فجَّرتْ فيكِ تلكَ الكُلومْ",5,"م",1,0],["فقدْ فَتَّ في زَنْدِ الدِّيانَةِ معشرٌ","أثاروا على الإسلامِ مَنْ قَدْ يُهاجِمُ",6,"م",1,0],["فَقَد فَقَدَت أُنسَ الخِلافَةِ وَاِنتَحى","عَلى أَهلِها خَطبٌ مِنَ الدَهرِ مُعضِلُ",7,"ل",1,0],["فَقَد فَضَّلَ اللَهُ الجُنَيدَ وَفُضِّلَت","يَداهُ عَلى الأَيدي الطِوالِ اِهتِضامُها",8,"م",3,0],["فَقَد فارَقتُ بِالغَربِيِّ داراً","بِأَرضِ الشامِ حَفَّ بِها النَعيمُ",9,"م",1,0],["فَقَد فاتَ جَدُّكَ جَدَّ المُلوكِ","وَعُمرُ أَبيكَ حَديثُ الضِياءِ",10,"ا",2,0],["فقد فاتكم نور الهدى بوفاته","ونور التقى منه ونجح الوسائل",11,"ل",1,0],["فَقَد فارَقَ الناسُ الأَحِبَّةَ قَبلَنا","وَأَعيا دَواءُ المَوتِ في البَدوِ وَالحَضَر",12,"ر",1,0],["فقد فرَّعنّي الصبر في مركزِ الهوى","وفُضّتْ بغارات الغرامِ جُموعي",13,"ع",2,0],["فقد فَقَدَ المكارم ناشدوها","فلا جود يؤمل من جواد",14,"د",1,0],["فَقُدْ فِي سبيلِ اللهِ جَيْشاً كَأَنَّهُ","من الليلِ قِطْعٌ طَبَّقَ الأَرضَ أَوْ جُنْحُ",15,"ح",1,0],["فقد فرَّ منّي لجَاجَ الزما","نِ قارحُ عشرٍ أبيّاً حَرونا",16,"ن",2,0],["فقد فسدَ الكونُ وأنت العلامةُ","وإلّا فما سرّ بقائك حيّا",17,"ي",2,0],["فَقَد فَتَحتُ لَك الأَبوابَ مغلقَةً","فاِدخُل عَلى كُلِّ ذي تاجينِ مِفضالِ",18,"ل",1,0],["فقد فررتمْ أبداً من سَطْوَتي","فرَّ القطا الكُدْرِ من الأجادلِ",19,"ل",1,0],["فَقَد فَصَدَ العِرقَ إِمامُ الهُدى","في ساعَةٍ جانَبَها النَحسُ",20,"س",1,0],["فقد فاز بالقصد الذي هو راكب","إليه على خيل وهن الطبائع",21,"ع",1,0],["فَقَدْ فُدِيَتْ مِنْ غَمِّهَا بِي بِحَسْرَتِي","عَلَيْهَا وَفِيْمَا بِيْنَ ذَلِكَ مَا يُسْلِي",22,"ل",2,0],["فَقَدْ فَقَدَ الكرى جَفْنٌ قَريحٌ","وَقَدْ ألِفَ الضَّنَا جِسْمٌ نَحيلُ",23,"ل",1,0],["فَقَد فَرَغتُ مِن كُلِّ باكٍ دُموعِهِ","كَما نَزَفَت مِن كُلِّ راثٍ مَحابِرُه",24,"ر",2,0],["فَقَد فكَّرُوا في الإسمِ حَتَّى تَوَهَمُّوا","لِعَدلِكَ فيهِم أنَّ أُمَّكَ مَرَيَمُ",25,"م",1,0],["فقد فَتح الرَّحمنُ أبوابَ عَفْوهِ","لِمَنْ راجَعَ الذِّكرى وأقبلَ خاشِيا",26,"ي",2,0],["فَقَد فُجِعَت أَزدُ العِرَاقِ وَشَامِهَا","وَأزدُ عُمَانٍ بِالطَّوالِ الغَرَانِقِ",27,"ق",1,0],["فَقَد فازَ الأُلى نَصروا حُسَيناً","وَخابَ الآخَرونَ أُولو النِّفاقَ",28,"ق",1,0],["فقد فداكَ بإنسانٍ ولا عجبٌ","أن يفتدى بجميع الناسِ إنسان",29,"ن",1,0],["فَقَد فَضَحَا أَبَا مُوسَى وَشَانَا","بَنِيهِ بالتَّهَوُّدِ والضَّلاَلِ",30,"ل",1,0],["فقد فاتك تعديل","كما أخطأت في الجرح",31,"ح",1,0],["فقد فاز مظلوم وقد خاب ظالم","بفضل حكمدار له الله ينصر",32,"ر",1,0],["فَقَد فضَّلت رُؤياه","عَلى الدُنيا وَما فيها",33,"ي",3,0],["فَقد فَقَدَ الدرّ النفيس فخارهُ","وصار حشيش الأرض أغلى وأفخرا",34,"ر",2,0],["فقد فقدوا والمصاب بمثلها","وان جل صبراً لا يطيق تصبرا",35,"ر",2,0],["فقد فضَّل الرحمن آل محمد","وأودع ذاك الفضل في الطفل والكهل",36,"ل",1,0],["فَقَدْ فَقدَ الصَبرَ الجَميلَ وَحزمَه","فؤادي وَما أَغنى لَديهم تبتلي",37,"ل",2,0],["فَقد فرّق الصَبر الجَميل افتراقه","وَقَد فَصل الأَوصال عَني انفصاله",38,"ل",2,0],["فَقَد فارقتُ أَوطاني","وَأَوطاري وَلذّاتي",39,"ت",2,0],["فَقَد فاقَهُم حِلماً وَمَجداً وَسودُداً","فَمِن مِثلِهِ في شَرقِها وَالمَغارِبِ",40,"ب",1,0],["فقد فقد الصب المتيم صبره","ولائمه جهلا به قد تحرّشا",41,"ش",2,0],["فقد فقدت الكرى مذ كاد يحرقنى","لهيب وجدى لولا مدمعى الباكى",42,"ك",2,0],["فقد فتَّنا بكم مذ كنا نعهدكم","لأنَّ مظهركم قد فات كل ولي",43,"ل",2,0],["فَقَد فَتح الفتّاحُ فَضلاً وَمنّةً","كَما هو شَأن الحبّ إذ يَقتَضي الفَضلا",44,"ل",2,0],["فقد فرقت أيدي التباعد جمعه","وقد قص بلواه وأهمل دمعه",45,"ه",1,0],["فقد فاز الرجال بها ونالوا","من الخيرات يا صاح الخصالا",46,"ل",2,0],["فقد فارقتني حين فارقت ساحة","رمتني عيون العين منها بتبريح",47,"ح",1,0],["فقد فرِحت ملائكةُ السما في","لقاكَ بُعيدَ آمالِ الوِصالِ",48,"ل",1,0],["فقد فوَّضتُ للعينين أمري","إذِ النَّظراتُ فيها لا تحيدُ",49,"د",1,0],["فَقَد فازَ بالدَّعوَى عَلِيُّ بْنُ صالِحٍ","وقَد غَازَلَ الحُوثِيَّ مَن عَنهُ أَعرَضَا",50,"ض",2,0],["فَقَدْ فَلَجَ النَّجُوْمَ بِرَاْحَتَيْهِ","وَسِرْنَاْ تَحْتَهَاْ وَسَخَاً وَطِيْنَاْ",51,"ن",2,0],["فقد فاض المداد اليك شوقا","بعشق لايزول ولا يباع",52,"ع",1,0],["فقد فاز الذي يأتيك طلقا","بقلبٍ يملأ الدنيا سليمِ",53,"م",1,0],["فَقَدْ فَتَّشتُ حَتَّى خِلتُ أَنِّي","وَحِيدٌ ما لَهُ فِي الكَونِ شِقُّ",54,"ق",1,0],["فَقَدْ فَضَحَتْهُ غِيْرَتُنَا","أَمَامَ النَّاسِ إِذْ نَقِفُ!",55,"ف",1,0]]}