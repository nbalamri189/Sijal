{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124774","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83219","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""]],"verses":[["ومناظرٌ يَعْيا القريضُ بوصفِها","ويضِلُّ في ألوانها الرّسام",0,"م",1,0],["ومن أظهر الإسلام والكفر باطن","فذلك زنديق متى تاب فاردد",1,"د",1,0],["وَمَناظِرُ الدُنيا تَهُزُّ عَواطِفي","وَتَزيدُ نارَ صَبابَتي إِضراما",2,"م",2,0],["ومناظر القمراء أشبه بالذي","أحييت من ذكر مضين ضعاف",3,"ف",1,0],["وَمَن أَظلَمَت عَيناهُ لَم يُرجَ عَدلُهُ","وَلَستُ بِمَن لا عَدلَ فيهِ بِمُعتَدِّ",4,"د",1,0]]}