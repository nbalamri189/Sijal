.aspx?id=203044",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[6209,"فطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82548&r=&rc=17",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""],[6256,"مداعبة صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65926&r=&rc=14",""],[6300,"شجويّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82853&r=&rc=24",""],[6357,"وماذا بعد .. ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77659&r=&rc=16",""]],"verses":[["إِنّي أُحاذِرُ أَن أَموتَ بِغُصَّةٍ","أَخلِق بِذَلِكَ يا اِبنَ أَحنَفَ أَخلِقِ",0,"ق",1,0],["إِنّي أُحاذِرُ صَدَّهُ وَفِراقَهُ","إِنَّ الفِراقَ عَلى المُحبِّ شَديدُ",1,"د",1,0],["إِنّي أُحَيّي عَدوّي عِندَ رُؤيَتِهِ","لِأَدفَعَ الشَرَّ عَنّي بِالتَحِيّاتِ",2,"ت",1,0],["إِنّي اِحتَسَبتُ شَباباً بِتُّ أُنفِقُهُ","وَعَزمَةً شابَتِ الدُنيا وَلَم تَشِبِ",3,"ب",1,0],["إِنّي أُحَيِّيكَ عَنهُم في جَزيرَتِهِم","وَفي العِراقِ وَفي مِصرٍ وَلُبنانِ",4,"ن",1,0],["أَنّي أُحِبُّكِ حُبّاً لَو تَضَمَّنَهُ","سَلمى سُمِيُّكِ دُكَّ الشاهِقُ الراسي",5,"س",2,0],["أني أُحاول أن أكون معينكم","لولا موانع يعترِضنِ حوالي",6,"ل",2,0],["إني أحيا بعدما","تبلى بقبري أعظمى",7,"م",2,0],["إني أحبك في على","والحسين ومن سَيَطرا",8,"ر",2,0],["إني أحذِّرُ مَنْ يقولُ قصيدةً","غرّاءَ خِدْنَيْ غارةٍ ونِهابِ",9,"ب",1,0],["إني أحبُّ مقامي في حماكَ وَمَنْ","يكنْ ببابِكَ يا ذا الفضلِ لم يَخِبِ",10,"ب",1,0],["إنّي أحِبُّ أبي وأعرف حقَّه","ولأنتَ بي وبه أبرُّ وأرأف",11,"ف",1,0],["إِنّي أُحَذِّرُكُم مِن خُبزِ صاحِبِنا","فَقَد تَرَونَ بِحَلقي اليَومَ ما صَنَعا",12,"ع",2,0],["إِنِّي أُحِسُّ فِي الصُّدُورِ حَرَجاً","يُقِيمُهَا وَفِي الزَّفِيرِ صَهْدا",13,"د",2,0],["إنّي أحب عليّاً حبّ مقتصِدٍ","ولا أرى دونَهُ في الفضل عثمانا",14,"ن",2,0],["إني أحُسُّ -وحسِّي ليس يكذِبُني-","مستقبلاً ملؤُهُ عزٌّ وسلطان",15,"ن",1,0],["إنِّي احتفظتُ لكلِّ يوم حفيظةٍ","ببقية من عزمك القدَّاح",16,"ح",1,0],["إني أحس بدهش غم كاربه","حتى الملائك حتى برزخ الرسل",17,"ل",1,0],["إني أحبك حباً لا نفاذ له ما دام","في مهجتي شيء من الرمق",18,"ق",1,0],["إني أحيي عدوي عند رؤيته","أدفع الشر عني بالتحيات",19,"ت",1,0],["إني احبك واحبك لين أشيب","يعني لين أموت وأنا احبك للنخاع",20,"ع",1,0],["إني أُحبكِ عندما تبكينَ","وأحبُّ وجهكِ غائماً وحزينا",21,"ن",2,1],["إني أحبك .. من خلال كآبتي","وجهاً كوجك ااااه ليس يطال",22,"ل",1,0],["إني أحبك حبا طاغياً فزعاً","عفّاً ومالي بهذا الحب من قبل",23,"ل",1,0],["إنى أحاذر من رحليهمُ","ما حاذَرَتْ أُمٌّ من الثُّكلِ",24,"ل",1,0],["إنّي أُحبكَ عن علم بما انفردتْ","به حلاك وما فيها قد اجتمعا",25,"ع",2,0],["إني أحبك حب الكف قوتها","وحب أذني وعيني السمع والبصرا",26,"ر",2,0],["إني أحبك حبا لو فطنت له","لطرت تسأل عن حالي وأحوالي",27,"ي",1,0],["إنّي أُحِبُّكَ حُبَّ المستفِيدِ به","إصابة الُّرشدِ لا حُبّاً أُداجِيه",28,"ي",2,0],["إني أحبُّك حبَّ مجتهد","بلغ النهاية وهو لا يدري",29,"ر",2,0],["إني أحنُّ إلى أليفٍ صَوتُهُ","ما زالَ بينَ أضالِعي وَنّانا",30,"ن",2,0],["إني أُحبُّ من الأزهارِ أجمَلها","لأجلِ وجهٍ يُريني الحسنَ أطوارا",31,"ر",2,0],["إني أُحِبّ بني أُمّي ولو ظلموا","فلذَّةُ الصَّفح تأتي من ذنوبهم",32,"م",1,0],["إني أحيّي روضةً أُنُفاً","فيها جنَيتُ لِصدرِكِ الوردا",33,"د",2,0],["إني أحنُّ إلى أليفٍ صوتُه","ما زالَ بين أضالِعي رنّانا",34,"ن",2,0],["أَنى أحن إِلى العذيب وأهله","والى مياه بالعذيب عذاب",35,"ب",1,0],["أني أحول وأنثني عن بابهم","وبه تحط السادة الأعلام",36,"م",1,0],["إِنّي أُحِبُّك حُبّاً لا لِفاحِشَةٍ","وَالحُبُّ لَيسَ بِهِ في اللَهِ مِن باسِ",37,"س",1,1],["إني أحب الصالحين الأخيار","عسى يقع لي وسط دورهم دار",38,"ر",1,0],["إني أحب المرء ذا فطنة","وأكره الفدم عريض الوساد",39,"د",1,0],["إنّي أحِنُّ إلى مراشف ألعسٍ","تغني مذاقتها عن الجريال",40,"ل",1,0],["إِنّي أُحَرِّض أَهلَ البُخلِ كُلِّهُم","لَو كانَ يَنفَعُ أَهلَ البُخلِ تَحريضي",41,"ض",2,1],["إني أحقّ إذا سرت ربح الصبا","من نحوكم بتارّج وتضوّع",42,"ع",1,0],["إني أحبّ الغزال كيف توخ","يت لقاء رماك أو ختلك",43,"ك",1,0],["إنِّي أ ُحاذِرُ أنْ أ ُحَدِّقَ فيهِما","حتى وأنتَ لِجُرأتي تَتَشَفَّعُ!",44,"ع",1,0],["إنِّي أحاولُ رَكْبَهُمْ يومَ السُّرى","ليَكونَ في تلكَ القُفولِ مَساري",45,"ر",2,0],["إِنَّي أُحِبُّكَ لا لأَنَّك مُسْعِفي","بالصَّالحات ولاَ ِلأَنَّك مُسْعِدي",46,"د",2,0],["إنِّي أُحِبُّ بِلاداً أَنت ساكنُها","وساكنِيها وليسُوا مِنْ ذَوِي نَسَبي",47,"ب",2,0],["انى أحث على الوئام فانما","بنجاحنا كان الوئام مبشرا",48,"ر",2,0],["إِنّي أَحِنُّ إِلى اِجتِماعِ الشَملِ في الأُخ","رى كَأَنّا في الحَياةِ الأولى",49,"ل",2,0],["إنّي أحبُّ حَيدراً مناصحاً","لمن قَفا مواثباً لِمن نَكَلْ",50,"ل",1,0],["إني أحق بأن أعيش موفقاً","للطيبات وأن أموت شهيدا",51,"د",2,0],["إني أحن إلى فرو","ق وليس يشفع لي حنيني",52,"ن",2,0],["إني أحق بظلها ال","ممدود والماء المعين",52,"ن",1,0],["إني أحلّك من قلبي بمنزلة","لا الوهم يبلغ أدناها ولا الفكر",53,"ر",1,0],["إني أحبك وهو يش","هد حب سمع لي وناظر",54,"ر",1,0],["إني أحدث في الهوى بعجائبٍ","وغرائبٍ حتى كأني الأصمعي",55,"ع",2,0],["إني أحبك حباً لا اتصال له","بعلة أنت في قلبي وفي فكري",56,"ر",2,0],["إنِّي أحاجي منك فرداً في الحجى","تزهو به الدنيا ونيسابور",57,"ر",1,1],["إني أحبك للدنيا وبهجتها","ولا أريدك يومَ الدين للدين",58,"ن",1,0],["إِنّي أُحِبُّكِ فَاِعلَمي","إِن لَم تَكوني تَعلمينا",59,"ن",2,1],["أنَّى أحيد عن المديح وشيمتي","مثل الصراط قويمة الأرجاء",60,"ا",2,0],["إني أحبك حباً ليس يبلغه","فهمي ولا ينتهي وصفي إلى صفته",61,"ه",1,1],["إني أحق الخلق إن فاخرتَ مَن","في سُندس الجنّات كان مجلببا",62,"ب",2,1],["إِنّى أحاذِرُ من عدوٍّ بشرُهُ","مَلَقٌ يلوحُ بوجههِ ورياءُ",63,"ا",2,0],["إِنِّي أحاذرُ سوء مكرِ حَواسدٍ","لم تحظَ من قَيْدِ الأَسَى بفَكَاكِ",64,"ك",1,0],["إنّي أحبُّكَ ليسَ ذاكَ خديعة","هذا وإنِّي يا حبيبُ حقيقة",65,"ه",1,0],["إني أحامي عن وجود حقيقتي","بحقيقةٍ عنها اللسان يناضلُ",66,"ل",1,0],["إني أحبك حتى لا قلوب ولا","أرواح خافقةٌ بالحب في البشر",67,"ر",1,0],["اني احبك يا دمشق محبة","كمحبة العذري والمجنون",68,"ن",1,0],["إني أحب على حد السيوف بأن","أمضي على أثر الماضين من سلفي",69,"ف",2,0],["إني أحبك والرحمن يعلمه","حب احتساب إلى ذي الطول قربانا",70,"ن",2,0],["إنِّي أُحِبُّكَ سَيَّدِي حُبَّا تَشَجَّرَ في الرَّوَابِي","حُبَّا يُجَاوِزُ طُهْرُهُ طُهْرَ المَحَبَّةِ وَالثَّوَابِ",71,"ب",1,0],["إني أحب جلوسه وأريده","للنوم لا للجري في الميدان",72,"ن",1,0],["اني احاجيك هل للصب مقدرة","على الفراق وفيه الشوق يلتهب",73,"ب",1,0],["اني أحاجيك هل كالسيف موعظة","تهدي العباد اذا ضلوا الى الرشد",74,"د",1,0],["إنّي أحاجيك فاعلَمَنَّ فما","لؤلؤةٌ منكَ قَد ثقَبناها",75,"ا",3,1],["إنّي أحاجيكَ يا أبا حسنٍ","ما صورَةٌ صوِّرَت فلم تكُنِ",76,"ن",1,0],["إني أحبك من قلبي ومن كبدِي","الله يحرس ذاك القد للأبدِ",77,"د",1,1],["إِني أَحب بِأَني اليَوم أَمدحكم","وَالمَدح خَير لَكُم لَو تَعلمون وَلي",78,"ل",2,0],["اني احوزُ بذِكرِ فضلكِ نَشوةً","فكأَنَّ مدحكِ يا بتولةُ قَرقَفُ",79,"ف",1,0],["إِني أَحوّل حالَتي فَأحيلها","بَين المَلا في عجمة وَبَيانِ",80,"ن",1,1],["إِني أُحوّل أَحوالي لتجهلها","مِن حَيث تعلمها ما بين إِخواني",81,"ن",2,1],["اني أحذركم بوادِرَ ضَيغمٍ","دَرِبٍ بحطمِ موائل الأعناقِ",82,"ق",1,0],["إني أحث ركاب الشوق أطلبهم","وخطوة الشوق في ليل السرى ميل",83,"ل",1,0],["إِنّي أَحِنُّ إِلى اللِقاءِ وَهاجَ بي","شَوقٌ يَرق لَهُ الفُؤادُ القاسي",84,"س",2,0],["إِني أُحِبُّ المُحسنين وَمَن لَهُم","ذكرٌ جَميلٌ ذاعَ في الآفاقِ",85,"ق",1,0],["أنّي أحجُّ بطاح اللهو آونة","إذا رأيت محلّي عندها حرما",86,"م",2,0],["إني أحييك من قلب له زجل","في حبكم وارتباط وقعه ثاني",87,"ن",2,0],["أني أحوز سجاياه وأجمعها","ولو بذلت على تحصيلها عمري",88,"ر",2,0],["أني أحن إلى سكانه شغفاً","حنين ذي وله في الحب عانيه",89,"ي",2,0],["إني أحن إلى الآداب فيه إلى","زهر الكمال بواديه وزاهيه",89,"ي",2,0],["إني أحن إلى منازل أسرتي","شوق المطي إلى الحداء المطرب",90,"ب",1,0],["اني أحبك حبا","يصان عن إنكشاف",91,"ف",1,0],["إني أحيط بوصف حب لم يكن","يرقى لأدنى سره المكتوم",92,"م",1,1],["إني أحطت بمن يحنو على شفقي","لكن عشقي للحانين إذ بَعدوا",93,"د",3,0],["إني احبك والمودة موثق","واليك تاريخ المحبة ينسب",94,"ب",1,0],["إني احبك والمحبة موثق","عندي وصون العهد من أخلاقي",95,"ق",2,0],["إني أحبكِ ما حييت ولن أرى","أبدأ لِحُبِكِ في الحياةِ بَدِيلا",96,"ل",2,0],["إني أحبكِ فوق ما عرف الهوى","وأبيع عمري كي أنال رضاكِ",97,"ك",1,0],["إنِّي أحبُّكِ فاحتفي بغنائي","وتلمّسي طيفي بكلِّ فضاء ِ",98,"ا",2,1],["إنِّي أُحِسُّ الْآنَ عِ