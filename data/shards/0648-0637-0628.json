188226",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[5956,"أول بانيَيْن للكعبة إبراهيم وابنه إسماعيل","https://www.poetsgate.com/ViewPoem.aspx?id=192497",""],[5956,"أعزك يا تراث","https://www.poetsgate.com/ViewPoem.aspx?id=193439",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6115,"سج هاجوس الشعر للشاعر المسكيني","https://www.poetsgate.com/ViewPoem.aspx?id=180475",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[454,"ربيع العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82642&r=&rc=6",""],[454,"إلى هيئة الأمم المتحدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82667&r=&rc=31",""]],"verses":[["وَطَبَّقَتِ العِراقَ لَنا قِبابٌ","نُظَلِّلُها بِأَطرافِ الرِماحِ",0,"ح",1,0],["وطبَّقَ الآفاقَ ذِكْري فلَمْ","يُخْمِلْهُ إجْلاءٌ وتَغْريبُ",1,"ب",1,0],["وطبَّقَ الأرضَ خَوفٌ لا يُزَحْزِحُهُ","ذو ضَجْعَةٍ لاثَ بُردَيْهِ على فَشَلِ",2,"ل",1,0],["وَطَبيبِ قَومٍ قَد أَحَلَّ لِطِبِّهِ","ما لا تُحِلُّ شَريعَةُ الخَلّاقِ",3,"ق",1,0],["وَطَبَّقَ مِن نَحوِ النَجيلِ كَأَنَّهُ","بِأَليَلَ لَمّا خَلَّفَ النَخلَ ذامِرُ",4,"ر",1,0],["وَطَبِيعَةٌ لِجَمَالِهَا","فِي كُلِّ نَاحِيةٍ فُتُونُ",5,"ن",1,0],["وطبَّق معمورَ البسيطة ذكرُهُ","وسارتْ بهِ الركبان في كل فَدْفَدِ",6,"د",1,0],["وطبّق ِصيته الآفاق حتى","تعرفه القبائل والشعوب",7,"ب",1,0],["وطباعٌ أرقُّ من ظُبَةِ السي","ف وأمضى من رِيقة الرقشاءِ",8,"ا",2,0],["وَطَبَّقنَ عُرضَ القُفِّ لَمّا عَلَونَهُ","كَما طَبَّقَت بِالعَظمِ مُديَةَ جازِرِ",9,"ر",1,0],["وَطَبيبٌ يَتَوَلّى عاجِزاً","نافِضاً مِن طِبَّهُ خُفَّي حُنَين",10,"ن",1,0],["وَطَبَعتَهُ بِيَدِ المُعَلِّمِ تارَةً","صَدِئَ الحَديدُ وَتارَةً مَصقولا",11,"ل",2,0],["وَطِب نَفساً بِما تَلِد اللَيالي","عَسى تَأتيكَ بِالوَلَدِ النَجيبِ",12,"ب",1,0],["وَطِباعُ الإِنسانِ مُختَلِفاتٌ","رُبَّ وَعرِ الأَخلاقِ سَهلُ المُحَيّا",13,"ي",2,0],["وطَبعكَ تِبرٌ سحّرَ الفضلُ محْضَهُ","وحاشا له أن يَستَحيلَ مَعَ الدَّهرِ",14,"ر",1,0],["وَطِبنا مَعاً شِعراً وَثَغراً كَأَنَّما","لَهُ مَنطقي ثَغرٌ وَلي ثَغرُهُ شِعرُ",15,"ر",1,0],["وَطبيبٍ رَأى صَحيفَةَ وَجهي","شاحِباً لَوناً وَعودي نَحيفا",16,"ف",2,1],["وَطَبيب أَغَرّ يُعطي دَواء","لِسقام الأَوطان وَالأَبدان",17,"ن",1,0],["وطبَّقَ الأرضَ من مِصرٍ إلى حلَبٍ","خيلاً ورَجْلاً ولفَّ السهْلَ بالجبل",18,"ل",1,0],["وَطَبعُكَ الشَرُّ فَإِن أَمكَنَت","تَوبَةُ لَيلٍ مِن سَوادٍ فَتُب",19,"ب",1,0],["وطَبَّقَ لَوْذَانَ القَبَائِلِ بَعْدَمَا","سَقَى الجِزْعَ مِنْ لوْذَانَ صَفْواً وأَكْدَرَا",20,"ر",2,0],["وَطَبَّقَ كُلَّ ناحِيَةٍ غُبارٌ","وَأُشعِلَ بِالمُهَنَّدَةِ الرِقاقِ",21,"ق",1,0],["وَطَبْعٌ وَديعٌ سوَى أَنَّهُ","عَلَى كُلِّ مُغْرٍ بسُوءٍ مُريد",22,"د",1,0],["وَطَبِيبَةٍ تَأْسُو وَلا تَقْسُو فَمِنْ","يَدِهَا يَمُرُّ النَّصْلُ مَرَّ المِرْوَد",23,"د",1,0],["وطباع أرقُّ من حال راجي","ك وخُلْق مُسْتَحْسنٌ غيرُ شَثن",24,"ن",1,0],["وطبعتَ أنفُسهم به","طبعًا على الذَّوق السليم",25,"م",1,0],["وطبَّق الكونَ طيْفٌ من مهابتهِ","وأوْغَلَتْ في نواحيه عساكره",26,"ر",2,0],["وطبعُ السياسيِّ جمُّ الغُموض","فلا بالصريح ولا الداهن",27,"ن",1,0],["وطبّقنَ عرضَ القفِّ لمّا علونهُ","كَمَا طَبَّقَتْ في الْعَظْمِ مُدْيَة ُ جَازِرِ",28,"ر",1,0],["وطب نفسا فحاشا ان","يراك الضيم والضير",29,"ر",1,0],["وطبنا بكم والكل انتم ولم يكن","سواكم له في السر اخذ ولا رد",30,"د",1,0],["وطبت بذكره قلباً وروحي","يروحها ثناه على الدوام",31,"م",1,0],["وطبت بها قلباً ونورت قالباً","وذبت صفا مذ حزت من عطرها شما",32,"م",2,0],["وطِب إذا أنت أحسنت الغراس فبي","يطيب في الخافقين الحب والثمرُ",33,"ر",1,0],["وَطَبَّقَتِ الآفاقَ أَخبارُكَ الَّتي","إِذا نُشِرَت في بَلدَةٍ كَسَدَ العِطرُ",34,"ر",1,0],["وَطَبِيبُ هَجْرِكَ لا يَجُو","دُ بِهَجْرِ هَجْرِكَ لِلْعَلِيلِ",35,"ل",1,0],["وطباع يحيى الجود لو لاطفته","ليشح خاف الشح خوف الشرك",36,"ك",1,0],["وطبق ظهر البحر جيشا إِليهم","تطير بإقلاع الجواري المواخر",37,"ر",1,0],["وطباع أرقّ من بسمة الفجر","وصوتٌ يزري بشدو الحمام",38,"م",1,0],["وطباعٍ أرقَّ من بسمَةِ الفجرِ","وروح أنقى من السلسبيلِ",39,"ل",1,0],["وطبعاً وأخلاقاً إذا بانَ كشفُها","تبيَّن من تحت التكشُّف سترُها",40,"ر",3,0],["وَطَبيبُ أَسقامي إِذا ما أَصبَحَت","تَبكي عَلَيَّ مِنَ الضَنى عُوّادي",41,"د",2,0],["وَطِبْ نَفْساً كَمَا قَدْ طِبْتَ أَصْلاً","وَفَرْعاً فَالذِي تَرْجُو اسْتَجَابَا",42,"ب",2,0],["وطب إذا ما التجلّي طاب مورده","واسبح ببحر اللقا الآليّ واغترف",43,"ف",1,0],["وَطَبَّقَ سَهلَ الأَرضِ وَالحزنِ عَدلُهُ","بِمِصرَ فَقالوا لَم يَكُن قَبلُ عادِلُ",44,"ل",1,0],["وطب آس العذار جرحي","فصح أن الطبيب آسى",45,"س",2,0],["وطبع الفتى يبدو على قدر عقله","محاسن أثمار على قدر بستان",46,"ن",1,0],["وَطَبخْتُ الكُسكاكَ مِن ذا وهذا","فَأَنَا ثَابتٌ وَيَزِيدُ",47,"د",1,0],["وَطَبع مِن نَسيم الرَوض أَذكى","شَميماً وَهوَ أَنضر عَبقريّا",48,"ي",2,0],["وَطب نَفساً بِما قسمت إِذا ما","حَبتك لَدى اِقتِسام السقم سَهما",49,"م",2,0],["وَطَبع كَماء المُزن يحيي كَثيرُهُ","رُسوماً كَما يروي الظما بِقَليلهِ",50,"ل",2,0],["وَطب نَفساً بِكُلّ رَشيق قَدٍّ","وَلا تَعبأ بِكُلِّ رَفيع قَدرِ",51,"ر",1,0],["وَطِب نَفسا بِصُحبَة من تَسامى","اِلى العَلياء مُنقَطِع النَظير",52,"ر",1,0],["وطَبْعُ شُواظِ النّارِ أَنْ يَطْلُبَ العُلا","إذا هزَّه في ظُلْمَةِ اللّيْلِ جاحم",53,"م",1,0],["وطَبَّق مَفْصِلاً منه فأضحَى","يَرى قَتْلاً وليسَ يَرى قِتالا",54,"ل",2,0],["وطبيعةٌ بالموت لازمةُ البلى","زلَّت وحاق بها عن الحق الزلل",55,"ل",1,0],["وطبيعةٌ طبعت على كدرٍ فما","لصلاحها إلّا زمانٌ مُتعِس",56,"س",1,0],["وطباعٍ بها الطباعُ زواهٍ","وخلالٍ بها الخلالُ عِجاب",57,"ب",1,0],["وطبعُه منذُ نَشا بذلُ اللُهى","بذلَ جوادٍ أريحيٍّ مفضّلِ",58,"ل",1,0],["وطبعُه بذلُ اللُهى","بذلَ الجوادِ المحسِنِ",59,"ن",1,0],["وطبقوا العدل إن العدل أنشاه","لولا العدالة لم تنهض ولم تقم",60,"م",1,0],["وطبع الغصن لا يهتز إل","بخاطرة النسيم لكي يميلا",61,"ل",2,0],["وطبّق الغبراءَ تط","بيقِيَ فيك المَفصِلا",62,"ل",2,0],["وطبت يداً فلو لُثمتْ شفاهٌ","تقبِّلُ راحتيك لُثِمنَ لُعْسا",63,"س",2,0],["وطبْت ثناءً في المجامع ذائعاً","كما طبت أصلاً في النِّجار وعنصرا",64,"ر",2,0],["وَطَبعَكَ قَد فاتَ طَبعي فَإِن","تَأَخَّرتُ عَنكَ فَكُن عاذِري",65,"ر",2,0],["وطب مع الفقراء العاملين أولي ال","خضوع فالفقر مفتاح المثوبات",66,"ت",1,0],["وطَبَّقَ الأُفقَ فُرْساناً مُعَرْبِدَةً","سُلْطانُها وأرَجَّ الكَوْنَ واليها",67,"ي",3,0],["وطَبْلُ إرْشادِهِ في الأرضِ دُقَّ وقد","حازَتْ به الرُّشْدَ أنْحاءٌ وأقطارُ",68,"ر",1,0],["وطبيبه لم يدر ما","يشكوه من ألم الأذى",69,"ا",1,0],["وطبولُ الأفراحِ دَقَّت وُعوداً","بابتهاجٍ لكى تُجيبَ النَّفيرا",70,"ر",2,0],["وطِبْتُ لمَّا فَهمْتُ رمْزِي","وفَهْمُه المطْلَبُ القَويمُ",71,"م",1,0],["وطَبَّقُوا البحرَ سفيناً فما","بانَ وسَاروا فوقها فِي قِفَارْ",72,"ر",1,0],["وطباعاً محمودة منه رقّت","وبتلكَ الأخلاق فاقَ الرِجالا",73,"ل",2,0],["وطبتمُ في قديمِ الدهر إذ سطرت","فيه البريَّةُ مَرحوماً ومَلعونا",74,"ن",2,0],["وطباء بات مصاب صارم لحظها","من سقمه مضنى الحشاشة لم يبل",75,"ل",1,0],["وَطِبت بِهِ نَفساً وَسرّ مؤرخ","وَطابَ فَهذا مَنصبُ المَجدِ وَالسّعدِ",76,"د",1,0],["وَطَبع هَذا الدُبّ أَنَّهُ إِذا","شاهَد مَيتاً لَم يَحظ بِهِ أَذى",77,"ذ",2,0],["وطباعُ الأنام فالبعض كالن","حْل مَذاقاً والبعض كالأقراظ",78,"ظ",1,0],["وطبْنا بها نفوساً","ولو صُيِّرت حراما",79,"م",2,0],["وطَبْيٍ من نَصارى الشام ألمىَ","يهيم بحسنه يَمَنٌ وشامُ",80,"م",1,0],["وَطِبنَ وَلاَ غَيْرَ النُّهُودِ أزَاهِرٌ","وَلُحْنَ وَلاَ غَيْرَ القُدُودِ زَوَاهِرُ",81,"ر",1,0],["وطبعك يابسٌ حدٌّ محرٌّ","يضرّ بكل ممروض موَّجعْ",82,"ع",1,0],["وطبعهُ التمريغ فوق الفرشِ","أحذر كذا من كل جنس الوحشِ",83,"ش",1,0],["وطبقت ثرى البسيط جثثاً","ودحت الهام على الجلامد",84,"د",1,0],["وطب فالعطا من فيض فضلي لقد نما","وقد جاءك النصر العزيز بلا ونى",85,"ن",2,0],["وطباع الأشكال توجب للأش","كال جمعا مؤلّفا واقترابا",86,"ب",2,1],["وطبّ عين عليٍّ عندما رمدت","بتفلة خرجت منه ريقه الشبم",87,"م",1,0],["وطبقَةُ الصادات مع ذيول ما","عرفتهُ وبدء سينٍ قد ما",88,"م",2,0],["وطَبَّقَ البُطنانَ بالماءِ الرِّوى","فَغَاثَها فِي مَرِّهِ وَأوبِهِ",89,"ه",1,0],["وطبق أرجاء البسيطة حزنه","وأحدث روعاً هولهُ هون الحشرا",90,"ر",2,0],["وطبعاً كريماً وعقلاً حكيماً","وراياً مصيباً وعزماً قويّا",91,"ي",2,0],["وَطَبَّقَ آفَاقَ البَسِيطَةِ مَدْحُهُ","فَسَا