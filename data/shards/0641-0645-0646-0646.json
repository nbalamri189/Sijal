{"poems":[[55,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[79,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[79,"لنا في الفخر أسنمة مطلة","https://www.aldiwan.net/poem36334.html","الوافر"],[79,"أبا ثابت كن في الشدائد ثابتا","https://www.aldiwan.net/poem36696.html","الطويل"],[88,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[56,"وإنك إن غبت عني ولم","https://www.aldiwan.net/poem27425.html","المتقارب"],[85,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[90,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[87,"أعزيك أبا مكسى","https://www.aldiwan.net/poem7116.html","مجزوء الوافر"],[63,"قصاراك أن تلقى الزمان مسلما","https://www.aldiwan.net/poem51453.html","الطويل"],[63,"أحل بعقوة الشرف التليد","https://www.aldiwan.net/poem51689.html","الوافر"],[63,"سهادي فيك أعذب من رقادي","https://www.aldiwan.net/poem51721.html","الوافر"],[76,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[107,"جمعن المشارق في المؤتمر","https://www.aldiwan.net/poem42051.html","المتقارب"],[52,"أتوب إليك من السيئات","https://www.aldiwan.net/poem64728.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[119,"سلوك طريق الرجال الأدب","https://www.aldiwan.net/poem41739.html","المتقارب"],[147,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[147,"دعوا القول فيمن جاد منا ومن ضنا","https://www.aldiwan.net/poem11826.html","الطويل"],[164,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[164,"الحمد لله أزال الحزنا","https://www.aldiwan.net/poem58932.html","الرجز"],[168,"بنا لا بك الوصب المؤلم","https://www.aldiwan.net/poem67816.html","المتقارب"],[169,"اعزفا لي بلذة قينتيا","https://www.aldiwan.net/poem721.html",""],[171,"تغير الفتح","https://www.aldiwan.net/poem1071.html",""],[190,"سألت عن العمى قوما ظرافا","https://www.aldiwan.net/poem43644.html","الوافر"],[202,"بأي نعي صبحتنا الركائب","https://www.aldiwan.net/poem51977.html","الطويل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[290,"سلام يا إمام المسلمينا","https://www.aldiwan.net/poem39409.html","الوافر"],[369,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[382,"علوت قدرا فصرت أما","https://www.aldiwan.net/poem59438.html","مخلع البسيط"],[422,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[482,"ألا حي آثار الرسوم الدوائر","https://www.aldiwan.net/poem15243.html","الطويل"],[482,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[498,"فمن نظر يسارع في صلاحي","https://www.aldiwan.net/poem67350.html","الوافر"],[520,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[543,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96982","المتقارب"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44610","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104566","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38486","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37799","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90568","الوافر"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132417","الطويل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64894","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56603","الوافر"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93100","الوافر"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111124","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66268","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124726","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96033","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53167","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141734","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67895","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88645","المتقارب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106861","المتقارب"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101397","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93600","الطويل"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98171","المتقارب"],[2818,"","https://poetry.dctabudhabi.ae/diwan/poem/101869","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100216","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132619","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48435","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104828","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45756","الطويل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141895","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110084","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91777","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59444","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4101,"","https://poetry.dctabudhabi.ae/diwan/poem/97580","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73207","الطويل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130866","الطويل"],[4453,"","https://poetry.dctabudhabi.ae/diwan/poem/141373","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[457,"خليليَّ بانَ البان وازدهر الزهْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=40856",""],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""],[5147,"أطار النسيم الغض قلبي بمسراه","https://www.poetsgate.com/ViewPoem.aspx?id=166755",""],[5213,"وقائلة هلا ترحلت طالبا","https://www.poetsgate.com/ViewPoem.aspx?id=170471",""],[2365,"ألم تسألا بجنوب السلام","https://www.poetsgate.com/ViewPoem.aspx?id=200657",""],[5280,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=190764",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5410,"رسالة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=133058",""],[5598,"فوانيس السماء","https://www.poetsgate.com/ViewPoem.aspx?id=213905",""],[5776,"لوحةٌ رسَمَها دمُ الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199919",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""]],"verses":[["فَمِن ناظِرٍ لَم تَبقَ إِلّا دُموعُهُ","وَمِن مُهجَةٍ لَم يَبقَ إِلّا غَليلُها",0,"ل",3,0],["فمِنْ نورِهِ الأرجاءُ باهِرةُ السّنا","ومِنْ ذِكْرِهِ الأفواهُ عاطِرَةُ الرَّيّا",1,"ي",2,0],["فَمِنْ نَارِ الْوَغَى فِيْ كُلِّ وَادٍ","وَمِنْ نَارِ الْقِرَى فِي كُلّ حِلَّهْ",2,"ل",2,0],["فَمِنْ نَفْسِ حُرٍّ أوْثَقَ الحُزْنُ كَظْمَها","ومِنْ نَفَسٍ بالوَجْدِ أصْبحَ خافِتا",3,"ت",2,0],["فَمِن نُبلٍ إِلى مَجدٍ أَثيلٍ","إِلى عِلمٍ إِلى نَفعٍ عَميمِ",4,"م",1,0],["فَمِن ناكِثينَ وَمِن قاسِطينَ","وَمِن مارِقينَ وَمِن مُجتَرِم",5,"م",1,0],["فمن نور مرآه الكواكبُ تهتدي","ومن فيض جَدْوَاهُ الحَيَا نتوكَّفُ",6,"ف",1,0],["فمن نفثات الشعر سجع حمامة","على أَيْكة يُشجي المشوق لها هدر",7,"ر",1,0],["فمن نطلب للطب","ومن نندب للدرس",8,"س",1,0],["فمِن ناشدٍ للمكرُماتِ ومُنشِدٍ","عسَى وطنٌ يدنو بهم ولَعلَّما",9,"م",2,0],["فمِنْ نَظْمٍ تُدبِّجُه مليحٍ","ومن نَثْرٍ تُهَذِّبُهُ سَديدِ",10,"د",1,0],["فمِنْ نَشوانَ من شَوْقٍ طَريفٍ","أضفناه إلى شَوْقٍ تِلادِ",11,"د",1,0],["فَمِن نورِ رَأيٍ لَو تَراءى لِناظِرٍ","لَلاحَ بِهِ تَحتَ الدُجُنَّةِ فَرقَدُ",12,"د",1,0],["فمن نمطٍ لِلأَذَى رَائِعٍ","إلى نَمطٍ غيرِه مُبْتكَرْ",13,"ر",1,0],["فَمَن نالَ خَيراً عَلى قُبلَةٍ","فَلا بارَكَ اللَهُ في قُبلَتي",14,"ت",2,0],["فَمَنْ نَظَرَ الدُّنْيَا بِحِكْمَةِ نَاقِدٍ","دَرَى أَنَّهَا بَيْنَ الأَنَامِ تُقَامِرُ",15,"ر",1,0],["فَمِنْ نَفْسِهَا نَالَتْ وَشِيكاً جَزَاءَهَا","وَمُشْقِي الوَرَى مِنْهَا أَنَمَّ شَقَاءَهَا",16,"ه",2,0],["فمن نازع الشيخ في أهله","بذم وأمل منه الأرب",17,"ب",1,0],["فَمِن نِعَمٍ مَوهوبَةٍ لِعُفاتِهِم","وَمِن نَعَمٍ مَأكولَةٍ وَهيَ في الكَلا",18,"ل",2,0],["فَمِن ناظِرٍ يَرنو وَمِن مِسمَعٍ يَعي","وَمِن مِقوَلٍ يُثني وَمِن خِنصَرٍ تُثنا",19,"ن",2,0],["فمن نظرت إليه وهو محتقرٌ","أمسى عزيزاً على العيّوق منزلُهُ",20,"ل",2,0],["فمن نهني بك كل فرج","أهم ما نبدأ به أنفسنا",21,"ن",2,0],["فَمَن نالَ مِن كَرَمٍ رُتبَةً","فَيَومُكَ مِن دَهرِهِ أَكرَمُ",22,"م",1,0],["فمننا عليه بعد علو","بوفاء وكنت قدما وفيا",23,"ي",2,0],["فمن نعاتبُ لو نعفيكِ من عتب ٍ","وأنتِ فينا جراح ٌ بعد ُ لم تَطب ِ",24,"ب",1,0],["فمن نظم القريض سمعت شعرا","ركيكاً تكره الأذن استماعه",25,"ع",2,0],["فمِن نبأٍ تسودُّ منه قلوبنا","ومِنْ حَدَثٍ تبيضُّ منه الذوائب",26,"ب",1,0],["فمِن نهرِ هُندوسٍ إلى النّيلِ نَعيُها","ومن بحرِ قزوينٍ إلى بحرِ مرمرا",27,"ر",2,0],["فمن نال التفاتا منك أضحى","بفضل اللَه ذا حبل متينا",28,"ن",2,0],["فمِن نَثرِه فيه فرائدُ نُصَّعٌ","ومن نَظْمِه فيِه أوابِدُ شُرَّد",29,"د",1,0],["فمن نبيٍّ ومن وليٍّ","ومن رسولٍ ومن شهيدِ",30,"د",1,0],["فمن ناله منك الرضا هو رابحٌ","ومن فاته منك الرضا فهو نادم",31,"م",1,0],["فمن نِعمةٍ خضراءَ تسبق نعمةً","له ويدٍ بيضاءَ لاحقةٍ يدا",32,"د",2,0],["فمِنْ ناشدٍ بينَ المنازلِ قلبَهُ","ومِن مشتكٍ فيها صدودَ الجآذرِ",33,"ر",1,0],["فمِنْ نفحاتِ الطيبِ واشٍ عليهمُ","نمومٌ ومِنْ جَرْسِ الحُليَّ رقيبُ",34,"ب",1,0],["فَمِن نَظَرٍ يُسارِعُ في صَلاحي","وَمِن وَصفٍ يَحُثُّ عَلى نِفاقي",35,"ي",1,1],["فمن ناصريه عزه وتقيه","وسيفاه منهم والصلاح وفخره",36,"ر",2,0],["فَمِن ناطِقٍ بالحمدِ يَشكُرُ ربَّهُ","وآخَرَ يرجُوه وآخر دَاعيا",37,"ي",2,0],["فمن نال في عزمه النيران","لم يعيه نيله للسحب",38,"ب",1,0],["فَمِن نَرجِسٍ لَما رَأى حُسنَ نَفسِهِ","تَداخَلَهُ عُجبٌ بِها فَتَبَسَّما",39,"م",2,0],["فمِن نوركَ الزّاهي تألّقَ زاهراً","ومن مجدِكَ العالي تعالى مُمجّدا",40,"د",2,0],["فمنْ نخلٍ ومن سروٍ","يباهي عِيطُهُ عِيطَه",41,"ط",2,0],["فَمِن نَرجِسٍ في الطَرف صَيّر صارماً","وَصَيَّر مِن آسِ العذارِ لَهُ دِرعا",42,"ع",2,0],["فَمِن نَفسِهِ لِلنّاسِ تَبدو تِهامَةٌ","وَمِن قَدرِهِ السامي لَقَد ظَهَرَ نجدُ",43,"د",1,0],["فمِن نغَماتِه يُبدي حنيناً","إلى تلكَ الأحاديثِ الرِّقاقِ",44,"ق",1,0],["فمن نظروا إليه بعين خير","ولم تطمس عقولهم الحقود",45,"د",1,0],["فمن نفس منه مضى عن سلوكها","جنيبا فما أولى بغبن وخسران",46,"ن",1,0],["فمن نحاك بالحسام ظارباً","جسما تغذى بالتقى وما اتقى",47,"ق",2,0],["فمِنْ نَداهُ الرِّفْدُ للمُعتَفي","ومنْ ثَناهُ المِسْكُ لِلنَّاشقِ",48,"ق",1,0],["فمن نخشى وفوق العر","ش مهما يغترر بشر",49,"ر",1,0],["فمن نرجسٍ يخشى فراق فريقه","ترى الدمع في أجفانه يترقرق",50,"ق",1,0],["فمن نغماتها طربى ومما","تصبب من دم الهامات راحي",51,"ح",2,0],["فمن نظم النجوم الزهر عقداً","وقد لها أديم البحر نحرا",52,"ر",2,0],["فمن نداهُ البحورُ الفعم مترعها","ومن علاهُ المعالي الغُرّ مشرعها",53,"ع",3,0],["فمن نكح اعتداءً وهو غرٌّ","وزينَ فعلَ ذاكَ له الغرورُ",54,"ر",1,0],["فمن ناشد تيماً على ضعف رأيها","وقبح الذي أبدى أخوها وابدعا",55,"ع",2,0],["فمن نعم تضفو علينا ظلالها","ومن كرم تصفو لدينا مناهله",56,"ل",2,0],["فمَنْ نامَ عن وقتِ الصلاةِ فأنه","غريبٌ وحيد الدهرِ وطب قد استوى",57,"ا",1,0],["فَمَن نفسُهُ منكم كنفسِ مُحمَّدٍ","ألا بأبي نفسُ المُطهَّرِ والطُّهرِ",58,"ر",1,0],["فمن نثره فالتقط لؤلؤا","ومن نظمه الدر والجوهرا",59,"ر",2,0],["فمن ناظريك المنى تستهلُّ","إلى النفس كالنجم حين أنارا",60,"ر",2,0],["فمن نازح قد غيب الرمس شخصه","ومن غائب قد حان من دونه الستر",61,"ر",1,0],["فَمن نافث نَفث الَّذي ضاقَ صَدره","فَيكظم للمقدور كَظمة صابر",62,"ر",1,0],["فمن ناقلين الى غاسل","الى حاملين الى دافن",63,"ن",1,0],["فمن نوره تهدى الأنام من العمى","ومن فضله تحيا القلوب وتبصر",64,"ر",1,0],["فمن نازل يمشي على قدم له","ومن راكب ولّى بحث الركائبا",65,"ب",2,0],["فمن نشوان من قانى","دم الأعداء لا الخمره",66,"ر",2,0],["فمن نازعَ السلطانَ فِي الملك لَمْ يجد","عن القتل مَا يَحميه عنه ويَعْصِم",67,"م",1,0],["فمن نار قبضهم لظى صار حرها","عذابا لأقوام مجانا مع ذلة",68,"ه",1,0],["فمِن نورِ مرْآها سَنا سُرَّ من رأى","ومن وشيِها صنعاءُ إنْ أحسَنَتْ وَشْيا",69,"ي",2,0],["فَمَن نَظَر","فَقَد خبر",70,"ر",1,0],["فمن ناضر منها على الحسن ناظر","ومن حاجب عن أعين الناس حاجب",71,"ب",1,0],["فَمن ناطق بِالحمد وَالشُكر وَالثَنا","وَمِن صامت يُصغي لِإِلقاء مُنشد",72,"د",1,0],["فمن نوارها للفرع قرط","ومن ريحانها للأصل قرطق",73,"ق",1,0],["فمن نُقطةٍ كانت تبوخُ جهنَّمٌ","وتُوفي قِصاصَ الذنبِ بالكيفِ والكمِّ",74,"م",1,0],["فمن نَأى فَبطاحُ الأَرض واسعةٌ","وَمن دَنا فبإقبال وَترحيب",75,"ب",1,0],["فمن ناجرٍ أو كاشطٍ أو مُوشقٍ","ومن مُقدر أو نِاشقٍٍ أو مضهّبِ",76,"ب",1,0],["فَمِن نَصلِهِ الرُمحُ عُنفاً تَكَسَّر","وَمِريونُ بَينَ ذَويهِ تَقَهقَر",77,"ر",1,0],["فَمِن نَفَسِها دارَت على عَتَباتِها","وَأَعلَت صَرِيفاً هائلاً وَهيَ تُفتَحُ",78,"ح",1,0],["فمن نافذٍ في صدر كل مدججٍ","من المرد فهاقٍ سريته تصمي",79,"ي",1,0],["فَمن نهرٍ يطوفُ بكلِّ روضٍ","وَمِن روض يرفّ بكلّ وادي",80,"د",2,0],["فَمن ناثِرٍ منهمُ حَديثَ جُمانهِ","بَداً من سلوكِ الدَّمعِ وهوَ مُنظَّمُ",81,"م",1,0],["فمن ناطح السلطان كسر قرنه","وهل ضرر يلقى أشد من الكسر",82,"ر",1,0],["فَمَن نَحنُ نُؤمِنهُ يَبِت وَهوَ آمِنٌ","وَمَن لا نُجزِهِ يُمسِ مِنّا مَفزَعا",83,"ع",2,1],["فمن نكث التعاهر بعد هذا","فذاك لربه يضحى خؤونا",84,"ن",2,0],["فَمَن نَظَرَتها عَينُهُ فَهوَ ناظِري","وَتُبصِرُها عَينٌ إِلَيَّ تُطالِعُ",85,"ع",1,0],["فمن نفس منه مضى عن سلوكها","جنيبا فما أولى بغين وخسران",86,"ن",1,0],["فمن نواةٍ إلى كونٍ إلى فلكِ","في إثر آخر حتى تعبرَ السدما",87,"م",2,0],["فمن نَرجِسٍ غضٍّ ووردٍ وسوْسَنٍ","وآسٍ ونَسْرين يفوحُ لنا النَشْرُ",88,"ر",1,0],["فمنْ نفسك النهج للإتجاه","ومن عزمك السير في المأزقِ",89,"ق",1,0],["فمن ناشد لي والصبابة معقلي","عريباً بجرعاء الغريين مثواه",90,"ا",2,0],["فمن نوره شمس الهداية اشرقت","ومن جود كفيه الغنى وبه البسر",91,"ر",1,0],["فمن ناكبين ومن قاسطي","ن ومن مارقين ومن مجترم",92,"م",1,0],["فمن نعزّي وكل الناسِ ذو ألمٍ","وكم أقولُ فما يُقضى به الوَطَرُ",93,"ر",1,0],["فمن نال كنز المال وازور جانباً","عن الضيف والعاني كفعل الأراذل",94,"ل",1,0],["فمَنْ ناله منكم ثواءً بغربةٍ","فما سامحَ الأعداءَ في مثْلِهِ مثْلُ",95,"ل",1,0],["فمن نحن...؟، وأين ترى","كرامتنا تدانينا...؟!",96,"ن",2,0],["فمن نظّر البحر رهن القيود","وخبّأ الشمس طيّ السراب",97,"ب",1,0],["فمن نحرهِ أبقى دمَ النّهرِ جاريا","ولولاهُ أضحى للجفافِ مسالا",98,"ل",2,0],["فمن نورها كان الوجود وقد بدا","بتكوينها عن محض حكم المشيئة",99,"ه",1,0],["فمن نوره كان الوجود أصالة","على أن منه الكائنات استمدتي",100,"ت",2,0],["فمَنْ نَصَرَ الطغاةَ وعاشَ عبدًا","وأنكَرَ عقلُهُ القولَ الحكيما",101,"م",2,0],["فمن نطق الفصحى يراه بنصه","وللعجم معناه الرفيع مترجَم",102,"م",1,0]]}