gate.com/ViewPoem.aspx?id=165471",""],[5660,"وَ الوَجدُ يَربَحُ وَ النَّوى تَقتاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=35775",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[5701,"أشرق الليل بنور العرس","https://www.poetsgate.com/ViewPoem.aspx?id=164688",""],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5956,"الرَّنين","https://www.poetsgate.com/ViewPoem.aspx?id=184781",""],[5956,"أَمَرَ البصيرُ نبيَّه","https://www.poetsgate.com/ViewPoem.aspx?id=192631",""],[5956,"بركات خالد","https://www.poetsgate.com/ViewPoem.aspx?id=193795",""],[5956,"تُنسينا السيارة","https://www.poetsgate.com/ViewPoem.aspx?id=193870",""],[5956,"لله درُّك يا بنيَّ كمالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194392",""],[5964,"أيها القرم الذي","https://www.poetsgate.com/ViewPoem.aspx?id=181309",""],[5974,"فاتِني ما أكْمَلَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200224",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""],[6117,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=182777",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["وَأَعادَ إيوانَ المَدائِنِ مَحرَماً","عُريانَ مِن بُردِ العُلى المَسدولِ",0,"ل",1,0],["وَأَعادَني مِنها عَلى أَسَفٍ","وَأَباتَني فيها عَلى ضَمدِ",1,"د",1,0],["وَأَعادا عَهدَ الرَشيدِ لِعَبّا","سٍ فَكانا يَراعَهُ وَالحُساما",2,"م",2,0],["وَأَعادَ أَيّاماً مَضينَ حَميدَةً","ما بَينَ حَرَّة عالِقين وَعَشتَرا",3,"ر",2,0],["وَأَعَاظِمُ القُطْرَينِ مُجْتَمِعُونَ مِنْ","زُعَمَاءِ أَوْ عُلَمَاءِ أَوْ أَعْيَانِ",4,"ن",1,0],["وأعاد وجهَ رُباك طلقاً مشرقاً","متضاحكاً بمباسم النوّارِ",5,"ر",1,0],["وأعاني العيش الهنيّ وأهنى ال","عيش يا صاح عيشةُ النشوان",6,"ن",1,0],["وأعارتْ هواءَ دارِكَ ثوباً","من نَداها فَكانَ ماءً هواءَ",7,"ا",2,0],["وأعادٍ قد أحاطوا","لحق الناسَ القُنوطُ",8,"ط",1,0],["وأعانَتْك على ذا","لك أعراقٌ كرامُ",9,"م",1,0],["وَأَعارَ واتِرلو جَلالَ يَراعِهِ","فَجَلالُ ذاكَ السَيفِ عَنهُ قَصيرُ",10,"ر",1,0],["وأعادتِ الأيامُ بهجَتَها","فالملك غَضُّ العود مقتبلُ",11,"ل",1,0],["وَأَعانوا عَلى كَتائِبِ أَريا","طَ بِطَعنٍ عَلى النُحورِ وَدَعسِ",12,"س",1,0],["وَأُعاطي كُؤوسَها المَلِكَ الأَب","لَجَ فِعلَ النَدمانِ بِالنَدمانِ",13,"ن",1,0],["وَأَعافُ شُربَ الماءِ يَطفَحُ لُجُّهُ","فَأَصُدُّ عَنهُ وَأَنثَني بِظَماءِ",14,"ا",2,0],["وَأُعاجِلُ العِزَّ المُقيمَ وَلَم أَبِع","نَقدَ المَسَرَّةِ وَالهَناءِ بِفَقدِهِ",15,"د",2,0],["وَأَعافُ تَسآلَ الدَليلِ تَرَفَّعاً","عَن أَن يَفوهَ فَمي بِلَفظِ سُؤالِ",16,"ل",1,0],["وَأُعافي العافينَ مِن سَقَمِ الجو","عِ وَأَسقي سَيفي دَمَ العُرقوبِ",17,"ب",1,0],["وأَعادَتْ عَلَى قَتَادَةَ عَيْنَاً","فَهْيَ حتى مماتِه النَّجْلاءُ",18,"ا",2,0],["وَأَعَادَ مِصْرَ إِلَى جَمالِ شَبابِها","مِنْ بَعْدِ مَا لَبِسَتْ خِمَارَ مَشِيبِ",19,"ب",1,0],["وَأَعَادُوا جَمَالَهَا فِي زُهَاهُ","يَتَرَاءَى قَديمُهُ فِي المُعَادِ",20,"د",1,0],["وأَعَانهُ أَدَبٌ يُرَقْرِقُهُ","فَكأَنهُ يَسْقِي النُّهَى خَمْرَا",21,"ر",2,0],["وأعاركُ الدنيا وأهوى صفوَها","لكنْ كما يهوى الكلامَ الأبكمُ",22,"م",1,0],["وأعادوا إلى الحياةِ عُكَاظاً","تنشر الشعرَ عبقري المعاني",23,"ن",2,0],["وَأَعَادَتْ إِلَى سَلِيلَةِ عَدْنَا","نَ شَبَاباً غَضّاً وَمَجْداً أَثِيلا",24,"ل",2,0],["وأعَاد مجدَ الخالِدين بنَهْضةٍ","تَجْتَاح شُمَّ الرَّاسياتِ وتُقْهَر",25,"ر",1,0],["وأعادَ مَجْدَ الأَوَّلِين بَعزْمةٍ","إِيرادُها للّه والإِصْدَار",26,"ر",1,0],["وأعادَتْ إِلَى العُلوم مَنَاراً","كان صُبْحَ الدُّجَى وهَدْىَ السُّرَاةِ",27,"ه",1,0],["وأعاني مرّ السؤال ، ويتلو","ه سؤال أمرّ ممّا أعاني",28,"ن",2,0],["وأعادَت الذكرى إليَّ أليمةً","لما انبريتُ بجمعِها مستعرِضا",29,"ض",2,0],["وأُعاطي كُؤوسَها المَلِكَ الأبْ","لَخَ، فِعلَ النَّدْمَانِ والنَّدْمَانِ",30,"ن",1,0],["وأعاد مطويّ العصور وآدما","يحنو بأدمعه على هابيلا",31,"ل",2,0],["وَأَعانة لَبَنيّ إِذ هُوَ قَد غَدا","شَروى عَصيفير لَدى عقبان",32,"ن",1,0],["وأعادت روحي براحة ثغر","سرماء الحياة مازج ماها",33,"ه",2,0],["وأعانق الأخطار نحوك والعنا","كيما أعانق غصنك الأملودا",34,"د",2,0],["وأعاضه من تاج فارسَ عِمةً","إذ عنده تاجُ الأعارب أرفعُ",35,"ع",1,0],["وأعابهم نفرٌ بلا سببٍ سوى","أن المعايبَ بين قومٍ تَجمَعُ",35,"ع",1,0],["وأعادا روحه مذ سكبا","ماء ورد المزن في مسك الثرا",36,"ر",2,0],["وأعاض كتاب الشمال مكاشطاً","يكشطنَ ما أمروا ما أمروا به أن يكتبا",37,"ب",2,0],["وأَعاضهم عنه نعيماً لو سرى","بعذابِ نار جهنم لاستعذبا",37,"ب",2,0],["وأعاده لك كل يوم هكذا","ورضاك عادات على عوراتِهِ",38,"ت",2,0],["وأَعافُ مِصرَ وعيشُها رَغَد","ويَشوقُني وطني ولو عَجِفَا",39,"ف",2,0],["وأعاتبُ الزمن الخؤون حماقة","غيظ يزيد وحسرة ما تقلع",40,"ع",1,0],["وأعارض الركبان من أمم","ولهان أنشد من رأي دعدا",41,"د",2,0],["وَأعادوهُ وهو صدرٌ سليمُ","فَعليهِ الصلاة والتسليمُ",42,"م",1,0],["وَأَعارَها الحَدَثان مِنكَ مَوَدَّةً","وَأُعيرَ غَيرُكَ وُدُّها وَهَواها",43,"ا",3,0],["وأعافُ الورقَ مهما سجعتْ","فحكتْ بالسجع تغريدَ النديم",44,"م",1,0],["وأعادت لهم مامر من بأس","عمرو وجلال المعتصم",45,"م",1,0],["وأعارَها الأَصداغُ فه","يَ بها شقيقٌ مُعلَم",46,"م",1,0],["وأعارَها مَرَضاً تَصِحْ","ح به القلُوبُ وتُسقَمُ",46,"م",1,0],["وأعار للأجفان سُقْ","ماً تسترِقُّ به العِبادا",47,"د",2,0],["وَأَعادَ عَين قَتادَة فَتَمَيَّزَت","بِجَمالِها في وَجهِهِ العَينانِ",48,"ن",1,0],["وَأَعانَهُ العَبّاسُ وَاِبنا عَمِّهِ","قثمٌ وَفَضلٌ بورِكَ الوَلَدانِ",48,"ن",1,0],["وَأَعادَ لَمّا عادَ أَي","يامَ السُرورِ كَما بَداها",49,"ا",3,0],["وأعاد ربُّك للممالك أهلَها","وفضالُ رب العالمين جزيل",50,"ل",1,0],["وإعادةِ الملكِ السليبِ فإنه","إرثٌ يثبِّتُهُ حطامُ الأعصر",51,"ر",1,0],["وَأَعَادَ الدُّنْيَا لِنَضْرَتِها","وَعَتيد النّصر مُعَوّدُهُ",52,"د",2,0],["وَأَعادَ الهوى له عيدَ وجدٍ","منع النوم بالبُكاءِ جفونَه",53,"ن",2,0],["وَأعاد (عثمان) الشهيدَ مضرجاً","بدمائِه يبكي له قرآنه",54,"ن",2,0],["وأعارض النفحات أسألها","برد الجوى فتزيد في الوقد",55,"د",1,0],["وَأَعانَهُ في كُلِّ مَشروعٍ لَهُ","وَأَعاذَهُ مِن خُلَّةِ الأَعياءِ",56,"ا",2,0],["وأعاد النظم روضاً ناضراً","بعد ما قيل رباه ذويت",57,"ت",1,0],["وأعادَ الحديث حتَّى رحَلْنا","ونزلنا بالسَّفح من نعمانا",58,"ن",2,0],["وأُعاتِبُ الدَّهرَ المِشُتَّ","وهَلْ يفيد الدَّهر عتب",59,"ب",1,0],["وأعاضه عما مضى","بكواسرٍ أبهى مآثر",60,"ر",1,0],["وَأَعادنا والبَرُّ أَوْطَأُ مَرْكِباً","بَحْرٌ صحِبْنَا ماءَهُ بالطِّينِ",61,"ن",1,0],["وأعاد عودَ الدّين لدْناً بعدما","عبثَتْ بعِطفَيهِ سَمومُ رِياحه",62,"ح",2,0],["وأعادَ فيها ما كسا","هُ بُرودَ أمداحٍ وأبدى",63,"د",2,0],["وأعانَهُ فيه ذكاءٌ مُفرطٌ","متوقدٌ كالنارِ في الإشعالِ",64,"ل",1,0],["وأَعادَ عاداتٍ جَرَتْ لَكَ بالمُنى","ربٌّ عَلَى أَضعافِهِنَّ قديرُ",65,"ر",1,0],["وأعاد أياما بها ولياليا","بيضا سمرناهن بالسُمرات",66,"ت",1,0],["وأعارته حُسْنَ أوصافِ مدْح","هي أولى بعطف ذاك الكمالِ",67,"ل",1,0],["وأعانَ إِبراهيمَ في","تكسيرِ أصنامِ الرُّقُومِ",68,"م",1,0],["وأعاف ذكر زنيمة غالى بها","فهوى من العلياء أيّ زنيم",69,"م",1,0],["وأعادوا حكايةَ الرشوةِ الكبرى","وباهوا بهذه العبقرية",70,"ي",2,0],["وأعان الرقادُ حَيْرةَ طَرفٍ","لم يجِدْ في الطّلاب يقظانَ رُشْدا",71,"د",2,0],["وأعادَ نقص المجد فضْلاً كاملاً","لمَّا تحلَّى بالكمالِ الكاملِ",72,"ل",1,0],["وأعافُ إدْراكَ الغِنى بمذلَّةٍ","وغنى الذليل عديلُ فقْرِ المُعدمِ",73,"م",1,0],["وأعادَ ما ضَمَّ الدفاترُ فعْلُه","صدْقاً يقيناً بغير توهُّمِ",73,"م",1,0],["وأعاضت الجوَّ الفسيحَ عن النَّدى","بالقُرِّ وخَّازاً كَحَدِّ المِعْبَلِ",74,"ل",1,0],["وأعاد يومهم كأمسِ وليثُ ال","غاب لا يغضي على ذحل",75,"ل",1,0],["وأعافُ وصلَ الغانيات وموضعي","منهنَّ بين جوانح وترائب",76,"ب",1,0],["وَأَعادَها مِنهُ وَقَد","صارَت مُزَعفَرَ الثِيابِ",77,"ب",1,0],["وأعاد النيران بردً سلاماً","أخمدتها من الغيوب السيول",78,"ل",1,0],["وأعاد فارعة القلوب لربها","إنَّ العباد وليُّها باريها",79,"ي",3,0],["وأَعادَ الصَّبا شَذاها زَكِيًّا","من رِحابِ الصَّيَّادِ عزِّ الدِّينِ",80,"ن",1,0],["وأَعادَ الرَّوعُ من فرسانِهِ","أَمْنَ قلبٍ وأَزالَ النَّكَدَا",81,"د",2,0],["وأَعادَ الخُسْرَ نصراً قاهِراً","بمعالي بأْسِهِ حِزْبَ العِدَى",81,"د",2,0],["وأَعانَهُ في جمعِ