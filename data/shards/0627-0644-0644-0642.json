{"poems":[[102,"عند مجهولة","https://www.poetsgate.com/ViewPoem.aspx?id=50413",""],[4682,"عناكب الهوجاس","https://www.poetsgate.com/ViewPoem.aspx?id=79149",""],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[4987,"وسيع البال","https://www.poetsgate.com/ViewPoem.aspx?id=49572",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5739,"هيه يالمسترجله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=131708",""],[5739,"علمها عند الفهيم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=162751",""],[6001,"أبو ظبي","https://www.poetsgate.com/ViewPoem.aspx?id=375",""]],"verses":[["اللقاء الحلو مرّ ها هنا","وتناجى الحب دقّات رتيبه",0,"ب",2,0],["اللقمة اللي مايجيبه عرق وجه","مع لينها كان تبعتها ممنة",1,"ن",2,1],["اللقب طوفان شعرٍ معي ختم المريد","كم على عدوِي عدا رهط عبقر لا نفر",2,"ر",1,0],["اللقا لحظات والغيبه شهور","تقصر الخطوات ويطول إنتظاري",3,"ر",2,0],["اللقاءاتُ لَيتني لا أَراها","إنها داؤنا العَريقُ العريقُ",4,"ق",1,0],["اللقب بويه ومنهجها السفور.","شي محزن.! في مدارسنا نذير.",5,"ر",1,0],["اللقا صايم .! عن اطرافي صيام.","والاشاره .. علمها عند الفهيم.",6,"م",1,0],["اللقا أول وتاليها","لاجل شوفك يا بعد عمري",7,"ر",2,0]]}