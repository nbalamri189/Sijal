{"poems":[[55,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[33,"نعق الغراب ببين ذات الدملج","https://www.aldiwan.net/poem42592.html","الكامل"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[52,"أأرقت بعد رقادك الأواب","https://www.aldiwan.net/poem64844.html","الكامل"],[33,"نَعَقَ الغُرَابُ بِبَيْنِ ذاتِ الدُّمْلُجِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18811&r=&rc=74",""],[566,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138107",""],[1850,"","https://poetry.dctabudhabi.ae/diwan/poem/121889","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27148","الرمل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120846","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125943","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89576","الكامل"],[5320,"ولدى","https://www.poetsgate.com/ViewPoem.aspx?id=43105",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5691,"غراب صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=206340",""]],"verses":[["نَعَقَ الزَمانُ بِجَمعِهِم عَن لَعلَعٍ","وَأَقَضَّ مَنزِلَهُم عَلى نَجرانِ",0,"ن",1,0],["نَعَقَ الغُرابُ بِبَينِ ذاتِ الدُملُجِ","لَيتَ الغُرابَ بِبَينِها لَم يَزعَجِ",1,"ج",1,1],["نَعَقَ الغُرابُ وَدَقَّ عَظمَ جَناحِهِ","وَذَرَت بِهِ الأَرواحُ بَحرَ السَمهَجِ",1,"ج",1,0],["نعق الحارثُ يدعوكم إلى","أن تبيدوا ليته لم يَنعَقِ",2,"ق",1,0],["نَعَقَ الغُرابُ فَخَنَّقَتني عَبرَةٌ","وَبَكَيتُ مِن جَزعٍ عَلى الأَحبابِ",3,"ب",1,0],["نَعَقَ الغُرَابُ وَدَقّ عَظْمَ جَنَاحِهِ","وَذَرَتْ بِهِ الأَرْياحُ بَحْرَ السَّمْهَجِ!",4,"ج",1,0],["نَعقِلُ مَرّاتٍ وَمَرّاً نَبذَخُ","إِذا الأَعادي حَسَبونا بَخبَخوا",5,"خ",3,0],["نعق الغراب فهللوا لنعيقه","وارحمتا للطائر المرنان",6,"ن",1,0],["نَعِقَ الغُرابُ فَقُلتُ مَن","تَنعَاهُ وَيحَكَ يا غُراب",7,"ب",1,1],["نَعَقَت أَغرِبَةُ البَينِ بِهِم","لا رَعى اللَهُ غُراباً نَعَقا",8,"ق",2,0],["نعقت بتفريق العدا غربانها","فإذا جموع المشركين حصيد",9,"د",1,1],["نعق الغراب بساحة لك طالما","في الليل أطربها نشيد البلبل",10,"ل",1,0],["نَعَقَت بِها غِربانُها","تِلكَ الرُسومُ العافِيَه",11,"ي",2,0],["نعق الغراب وبومة الشؤم التى","صرخت بموتك ذاك أمر رابنى",12,"ن",2,0],["نَعقَ الغرابُ بأرضنا فتمايلتْ","بقرُ الحظيرة والجوابُ خوارُ",13,"ر",1,0],["نَعَقَ الغُرابُ بَيانَ خيْبَتِهِ","بلِسانِ منْ ندَبَتْهُ صُهيونُ !",14,"ن",1,0]]}