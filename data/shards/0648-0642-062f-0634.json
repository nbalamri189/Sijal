{"poems":[[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"لقد جثمت تعبيسة في المضاحك","https://www.aldiwan.net/poem29921.html","الطويل"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[63,"وبارقة تمخض بالمنايا","https://www.aldiwan.net/poem45914.html","الوافر"],[63,"رمى الله سعدا بالذي هو أهله","https://www.aldiwan.net/poem45926.html","الطويل"],[63,"النجح تحت خطا المهرية النجب","https://www.aldiwan.net/poem46090.html","البسيط"],[63,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[3,"إذا جحد الجميل بنو قراد","https://www.aldiwan.net/poem140.html",""],[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"أمن جانب الغربي نفحة بارح","https://www.aldiwan.net/poem36643.html","الطويل"],[9,"فدى لبني ذهل ابن شيبان ناقتي","https://www.aldiwan.net/poem21917.html","الطويل"],[71,"يا سيداً عرضه عار من العار","https://www.aldiwan.net/poem3981.html","البسيط"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[35,"أهاجك ليلى إذ أجد رحيلها","https://www.aldiwan.net/poem39101.html","الطويل"],[35,"تقطع من ظلامة الوصل أجمع","https://www.aldiwan.net/poem39137.html","الطويل"],[83,"لمن قبة حمراء مد نضارها","https://www.aldiwan.net/poem54346.html","الطويل"],[88,"بكت في ظلام الليل تندب أهلها","https://www.aldiwan.net/poem44803.html","الطويل"],[27,"أجدك لا يصحو الفؤاد المعلل","https://www.aldiwan.net/poem5970.html","الطويل"],[51,"أرى العصفور يعبث بالفخاخ","https://www.aldiwan.net/poem9440.html","الوافر"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"إذا ما جلته الحرب أعرض رمحه","https://www.aldiwan.net/poem66001.html","الطويل"],[70,"يا ذا الندى والمعالي","https://www.aldiwan.net/poem43010.html","المجتث"],[45,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[45,"سل الحلبي عن حلب","https://www.aldiwan.net/poem11047.html","مجزوء الوافر"],[45,"له الويل من ليل تطاول آخره","https://www.aldiwan.net/poem63564.html","الطويل"],[45,"أقيم على التشوق أم أسير","https://www.aldiwan.net/poem63579.html","الوافر"],[45,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[45,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[28,"إني رأيت أبا الأشبال قد ذهبت","https://www.aldiwan.net/poem5211.html","البسيط"],[28,"ترى جسدا عيناك تنظر ساكنا","https://www.aldiwan.net/poem5287.html","الطويل"],[61,"فؤادي بك مشغوف","https://www.aldiwan.net/poem51550.html","الهزج"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[61,"أجانبها حذارا لا اجتنابا","https://www.aldiwan.net/poem51817.html","الوافر"],[49,"أجاب الله داعيك","https://www.aldiwan.net/poem64262.html","الهزج"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[66,"سلوا بعد تسآل الورى عنكم عني","https://www.aldiwan.net/poem41581.html","الطويل"],[80,"إلى كم أراني في هوى النفس خائضا","https://www.aldiwan.net/poem31411.html","الطويل"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[33,"فيا قلب مت حزنا ولا تك جازعا","https://www.aldiwan.net/poem25952.html","الطويل"],[102,"أحرارنا قد كشفتم عن بطولتكم","https://www.aldiwan.net/poem32981.html","البسيط"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[48,"لقد كنت وما في الناس","https://www.aldiwan.net/poem63347.html","الهزج"],[50,"تلوم ابنة السعدي في حل عقدة","https://www.aldiwan.net/poem63915.html","الطويل"],[50,"وقد شذبتك الحادثات وإنما","https://www.aldiwan.net/poem64764.html","الطويل"],[46,"وجدت الأنام على خطة","https://www.aldiwan.net/poem22749.html","المتقارب"],[46,"ما راعها من قرى عم وجارمها","https://www.aldiwan.net/poem23042.html","البسيط"],[46,"أما البليغ فإني لا أجادله","https://www.aldiwan.net/poem23168.html","البسيط"],[46,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30478","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54988","الوافر"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[77,"أبا مالك أنت نجل الملوك","https://www.poetsgate.com/ViewPoem.aspx?id=34153",""],[77,"أمن جانب الغربي نفحة بارح","https://www.poetsgate.com/ViewPoem.aspx?id=33654",""],[90,"منى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=178934",""]],"verses":[["وَقَد شَمَلَتهُ شُفوفُ الشَمالِ","وَرَصَّعَ قُطرَيهِ قُطرُ الرِهام",0,"م",1,0],["وَقَد شَرِبَت ذَودَ العَوالي أَنامِلٌ","وَلَكِنَّها بَينَ الطُلى في مَبارِكِ",1,"ك",1,0],["وَقَد شَنَّ فيها حادِثُ المَوتِ غارَةً","ثَنَتنا وَلَم تَطلُع إِلَينا كَتائِبا",2,"ب",2,0],["وَقَد شَمَّرَ التَحجيلُ عَن جَنَباتِها","وَحَجَّلَها خَوضاً نَجيعُ المَقانِبِ",3,"ب",1,0],["وَقَدْ شَامَتْ مَخيَلَتَها سُيوفٌ","تَلَمَّظُ في دمٍ سَرِبِ العَزالي",4,"ي",1,0],["وَقَدْ شَرِبَتْ أَكْوارُها مِنْ ظُهورِها","دَمَاً وَالكَرى يُلْقِي يَداً في المَحاجِرِ",5,"ر",1,0],["وَقَدْ شَكَتْ فَشَفاهَا اللهُ وَارْتَجَعتْ","لَحْظاً أَحَدَّ مِنَ المَأْثُورَةِ الرُّسُبِ",6,"ب",1,0],["وقد شَمَلَتْني نِعْمَةٌ أنتَ ربُّها","هيَ الرّوضُ غاداهُ الحَيا وهْوَ مُغْزِرُ",7,"ر",1,0],["وقد شبّهَتْني إذ وُلِدْتُ قَوابِلي","منَ الأُسْدِ مَجْدولَ الذِّراعَيْنِ ضَيْغَما",8,"م",2,0],["وقَد شارَكَتْ غسّانَ فيهنَّ حِمْيَرٌ","وما سَلِمَتْ مِنهُنَّ قَيْسٌ ولا بَكْرُ",9,"ر",1,0],["وقَد شَمِلَتْ عَدْنانَ نِعْمَتُكَ التي","نَعَشْتَ بِها قَحْطانَ إذْ خانَها الوَفْرُ",9,"ر",1,0],["وَقَد شاهَدتُمُ في يَومِ طَيٍّ","فِعالي بِالمُهَنَّدَةِ الحِدادِ",10,"د",1,0],["وقد شابَ فَوْدُ اللّيلِ منْ روعةِ الضِّيا","وطارَتْ قلوبُ النّجْمِ من شِدّةِ الخَفْقِ",11,"ق",1,0],["وقد شفّني وجْدٌ إليْكَ ولوْعَةٌ","هيَ الجَمْرُ أو أذْكى وَقوداً منَ الجَمْرِ",12,"ر",1,0],["وقد شُنّتِ الغاراتُ منْ كلِّ تلْعَةٍ","فأصْبَحَ حُرُّ القوْمِ عنْ كَثَبٍ عبْدا",13,"د",2,0],["وقدْ شُرِعَتْ في مَجْمَعِ الحَقْلِ نَحْوَهُ","أسِنّةُ حَرْبٍ للعُيونِ اللّوامِحِ",14,"ح",1,0],["وَقَد شَمَّرَت بِالناسِ شَمطاءُ لاقِحٌ","عَوانٌ شَديدٌ هَمزُها فَأَضَلَّتِ",15,"ت",1,0],["وَقَد شَقيتُ فَخَلّصني بِضَرَّتِها ال","بَيضاءِ أَو أُختِها السَوداءِ مِن قارِ",16,"ر",1,0],["وَقَد شَرقَت زرقُ الأَسِنَّةِ بِالدما","وَأَنكَرَ حَدَّ المَشرَفيِّ قِرابُهُ",17,"ب",2,0],["وَقَد شَخَصَت بِالسابِرِيَّةِ فَوقَهُ","مُعَلَّبَةَ الأُنبوبِ ماضٍ أَليلُها",18,"ل",3,0],["وَقَد شَبَّ مِن أَترابِ ظَلّامَةَ الدُمى","غَرائِرُ اِبكارٌ لِعَينَيكَ مَقنَعُ",19,"ع",1,0],["وقد شبّه الرحمن خلقتنا به","وحسبُك فخراً بان منه اعتلاؤُها",20,"ا",3,0],["وقد شَخَصت نحو السماء بطرفها","لها كلَّ آن زَفرة وحنين",21,"ن",1,0],["وَقَد شَقَّقَت يَومَ الرَحوبِ سُيوفُنا","عَواتِقَ لَم يَثبُت عَلَيهِنَّ مِحمَلُ",22,"ل",1,0],["وقد شاع الحديثُ بها ولكن","إخَال النَّغْل مسدود الصِّمَاخِ",23,"خ",1,0],["وقد شمتمُ منه ومن أوليائه","بوارقَ لم يُخلِف هناك لموعها",24,"ع",3,0],["وقد شمّرتْ عن ساقها غير أنها","تركّضُ في ذيلٍ من النفعِ ذائلِ",25,"ل",1,0],["وقد شمّرت عن ساقها غير أنها","تركَّضُ في ذيلٍ من النقعِ ذائلِ",26,"ل",1,0],["وَقَد شَوَينا خَروفاً","وَتَحتَهُ جوذابَه",27,"ب",2,0],["وَقَد شَحَذَت مِنهُ حَداثَةَ سِنِّهِ","شَهامَةُ غِطريفٍ حِدادٍ مَخالِبُه",28,"ب",2,0],["وَقَد شَمَّرتَ عَن جِدٍّ","كَأَنَّكَ مُشعَرٌ غَضَبا",29,"ب",2,0],["وَقَد شاغَبَ الإِسلامَ خَمسينَ حِجَّةً","فَلا الخَوفُ ناهيهِ وَلا الحِلمُ زاجِرُه",30,"ر",2,0],["وَقَد شَمِلَ اِمتِنانُكَ كُلَّ حَيٍّ","فَهَل مَنٌّ يُفَكُّ بِهِ أَسيرُ",31,"ر",1,0],["وَقَد شُهِرَت بيضُ السُيوفِ وَأُعرِضَت","صُدورُ المَذاكي مِن كُمَيتٍ وَأَبلَقِ",32,"ق",1,0],["وَقَد شَمِلَت بِشراً لِأَوسٍ صَنيعَةٌ","بِما أَمَرَت سُعدى وَوَرَّثَ لامُ",33,"م",1,0],["وَقَد شَرِقَت جِبالُ الطيبِ مِنهُم","بِيَومٍ مِثلِ يَومِ النَهرَوانِ",34,"ن",1,0],["وَقَد شَكَرتُ أَبا الأَشبالِ ما صَنَعَت","يَداهُ عِندي وَخَيرُ الناسَ مَن شَكَرا",35,"ر",2,0],["وَقَد شابَ صُدغاكَ اللَئيمانِ عاتِباً","عَلَينا وَفينا أُمُّكَ الغولُ تَمزَعُ",36,"ع",1,0],["وقد شيَّعَني طَرْفٌ","بماءِ الشَّوقِ مَطروفُ",37,"ف",1,0],["وقد شَغَلتْ كعوبُ الرمحِ منه","يَديهِ عن مُلامَسَةِ الكِعابِ",38,"ب",1,0],["وقد شغلَ النَّدى الألبابَ فيه","فباتتْ تَنظِمُ الكَلِمَ اللُّبابا",39,"ب",2,0],["وَقَد شاعَ بِأَنَّ الخَز","زَ يُؤذيكِ وَيُدميكِ",40,"ك",1,0],["وَقَد شَمَّرَ المَوتُ عَن ساقِهِ","وَكَشَّرَتِ الحَربُ عَن نابِها",41,"ب",3,0],["وَقَد شاهَدَت نَثري وَنَظمِيَ في الوَغى","لِهامِ العِدى وَالنَحرِ بِالضَربِ وَالطَعنِ",42,"ن",1,0],["وقد شَمِلَتنْي شيبةٌ لم أبِتْ بها","فما ليَ في ليلي وقد طَلَعَتْ شمسي",43,"س",2,0],["وقَد شُقّ خَيطُ الفَجرِ في جُنحِ لَيلِنا","كَما شُقّ حَدُّ السيفِ في جانِبِ الغِمدِ",44,"د",1,0],["وَقَد شَسَعَت لَيلى وَشَطَّ مَزارُها","وَغَيَّرَها عَن عَهدِها قَولُ حاسِدِ",45,"د",1,0],["وقد شبعتم ظهوراً في مظاهرةٍ","مشروعةٍ وسكرتم بالهتافاتِ",46,"ت",1,0],["وقد شَغَرَتْ مِنهمْ حُصونٌ أَواهِلٌ","وما راعها مِنْ قبل ذاك شُغُورُ",47,"ر",1,0],["وَقَدْ شَهِدَتْ بِذاهُلْبا سُوَيْدٍ","وَهُلْبا بَعْجَةٍ حَرْباً زَبُونا",48,"ن",2,0],["وقد شاقني إيماضُ بْرقٍ بذي الغَضى","كما حُرِّكتْ في الشمس بيض المناصل",49,"ل",1,0],["وَقَد شاعَ الَّذي أُخفي","وَقَد كانَ الَّذي أَحذَر",50,"ر",1,0],["وَقَد شَفَّني أَلّا تَزالَ كَليفَةً","تُنَصِّبُني فيها فَأُصبِحُ مُكمَدّا",51,"د",2,0],["وَقَد شَذَّبَتكَ الحادِثاتُ وَإِنَّما","يُفَرِّعُ غُصنُ الدَوحِ حينَ يُشَذَّبُ",52,"ب",1,1],["وَقَد شَرِبَ الدَهرُ صَفوَ الأَنامِ","فَلَم يَبقَ في الأَرضِ إِلّا العَكَر",53,"ر",1,0],["وَقَد شَهِدتَ مَخاريقَ الوَغى لَعِبَت","مُجيدَةً لِدُروعِ القَومِ تَخريقا",54,"ق",2,0],["وَقَد شَرِبتَ نُمَيراً فَاِجتَرَأتَ بِهِ","فَلِم حَمَلتَ مِنَ الصَهباءِ أَرطالا",55,"ل",2,0],["وَقَد شَهَرا سَيفَينِ في كُلِّ مَعشَرٍ","يَقُدّانِ ما هَمّا بِهِ أَو يَقُطّانِ",56,"ن",1,0],["وَقَد شَهِدَ النَصارى أَنَّ عيسى","تَوَّخَتهُ اليَهودُ لِيَصلِبوهُ",57,"ب",3,0],["وقد شَرّفْتَني وَرَفَعْتَ إِسْمي","به وأنَلْتَني الحَظّ الرّبيحا",58,"ح",2,0],["وَقد شاقَنِي الوُرْقُ السّواجعُ بالضُّحى","ومَن يسْتمع داعِي الصّبابَةِ يشتَقِ",59,"ق",1,0],["وَقَد شَقِيَت تَيمٌ بِأَمرِ غَوِيِّها","وَقالَ لِتَيمٍ قَد أَمَرتُكُمُ أَمري",60,"ر",2,0],["وَقَدْ شَاقَنِي وَالصُّبْحُ فِي خِدْرِ أُمِّهِ","حَنِينُ حَمَامَاتٍ تَجَاوَبْنَ فِي وَكْرِ",61,"ر",1,0],["وقَدْ شفَّتْ عَزِيمَة رَأْ","يِهِ جُثْمانَهُ الْبَضَّا",62,"ض",2,0],["وَقَد شَهِدَ المِسواكُ عِندي بِطيبِهِ","وَلَم أَرَ عَدلاً وَهوَ سَكرانُ يَطفَحُ",63,"ح",1,0],["وقد شاهدت منك خلقا جميلا","أناف على درجات الكمال",64,"ل",1,0],["وقد شرعت في مجمع القول نحوه","أسنة حرب للعيون اللوامح",65,"ح",1,0],["وقد شردت فكري هنالك ضجة","لأطيارها تدعو بنبذ التفاكك",66,"ك",1,0]]}