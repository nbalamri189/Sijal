://www.aldiwan.net/poem12707.html","الطويل"],[433,"أعن وسن ترنو عيونك أم سكر","https://www.aldiwan.net/poem12797.html","الطويل"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[440,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[440,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[442,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[442,"يموت الصحيح ويحيا المصاب","https://www.aldiwan.net/poem14346.html","المتقارب"],[454,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[462,"سقى الله المهيمن قبر ثاو","https://www.aldiwan.net/poem15417.html","الوافر"],[465,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[469,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[471,"فقالت تشكى غربة الدار بعدما","https://www.aldiwan.net/poem4632.html","الطويل"],[501,"أواه من ذاك الغزيل الأغن","https://www.aldiwan.net/poem37569.html","الرجز"],[516,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[538,"كفى حزنا أن تطعن الخيل بالقنا","https://www.aldiwan.net/poem69408.html","الطويل"],[539,"لسانكم بالفخر دوما يردد","https://www.aldiwan.net/poem48234.html","عموديه"],[539,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[539,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[544,"يا أم سودة بل يا أم عباد","https://www.aldiwan.net/poem1758.html","البسيط"],[552,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[552,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[552,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[559,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[560,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[563,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[576,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[587,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[588,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"]],"verses":[["وَقَد شَمَلَتهُ شُفوفُ الشَمالِ","وَرَصَّعَ قُطرَيهِ قُطرُ الرِهام",0,"م",1,0],["وَقَد شَرِبَت ذَودَ العَوالي أَنامِلٌ","وَلَكِنَّها بَينَ الطُلى في مَبارِكِ",1,"ك",1,0],["وَقَد شَنَّ فيها حادِثُ المَوتِ غارَةً","ثَنَتنا وَلَم تَطلُع إِلَينا كَتائِبا",2,"ب",2,0],["وَقَد شَمَّرَ التَحجيلُ عَن جَنَباتِها","وَحَجَّلَها خَوضاً نَجيعُ المَقانِبِ",3,"ب",1,0],["وَقَدْ شَامَتْ مَخيَلَتَها سُيوفٌ","تَلَمَّظُ في دمٍ سَرِبِ العَزالي",4,"ل",2,0],["وَقَدْ شَرِبَتْ أَكْوارُها مِنْ ظُهورِها","دَمَاً وَالكَرى يُلْقِي يَداً في المَحاجِرِ",5,"ر",1,0],["وَقَدْ شَكَتْ فَشَفاهَا اللهُ وَارْتَجَعتْ","لَحْظاً أَحَدَّ مِنَ المَأْثُورَةِ الرُّسُبِ",6,"ب",1,0],["وقد شَمَلَتْني نِعْمَةٌ أنتَ ربُّها","هيَ الرّوضُ غاداهُ الحَيا وهْوَ مُغْزِرُ",7,"ر",1,0],["وقد شبّهَتْني إذ وُلِدْتُ قَوابِلي","منَ الأُسْدِ مَجْدولَ الذِّراعَيْنِ ضَيْغَما",8,"م",2,0],["وقَد شارَكَتْ غسّانَ فيهنَّ حِمْيَرٌ","وما سَلِمَتْ مِنهُنَّ قَيْسٌ ولا بَكْرُ",9,"ر",1,0],["وقَد شَمِلَتْ عَدْنانَ نِعْمَتُكَ التي","نَعَشْتَ بِها قَحْطانَ إذْ خانَها الوَفْرُ",9,"ر",1,0],["وَقَد شاهَدتُمُ في يَومِ طَيٍّ","فِعالي بِالمُهَنَّدَةِ الحِدادِ",10,"د",1,0],["وقد شابَ فَوْدُ اللّيلِ منْ روعةِ الضِّيا","وطارَتْ قلوبُ النّجْمِ من شِدّةِ الخَفْقِ",11,"ق",1,0],["وقد شفّني وجْدٌ إليْكَ ولوْعَةٌ","هيَ الجَمْرُ أو أذْكى وَقوداً منَ الجَمْرِ",12,"ر",1,0],["وقد شُنّتِ الغاراتُ منْ كلِّ تلْعَةٍ","فأصْبَحَ حُرُّ القوْمِ عنْ كَثَبٍ عبْدا",13,"د",2,0],["وقدْ شُرِعَتْ في مَجْمَعِ الحَقْلِ نَحْوَهُ","أسِنّةُ حَرْبٍ للعُيونِ اللّوامِحِ",14,"ح",1,0],["وَقَد شَمَّرَت بِالناسِ شَمطاءُ لاقِحٌ","عَوانٌ شَديدٌ هَمزُها فَأَضَلَّتِ",15,"ت",1,0],["وَقَد شَقيتُ فَخَلّصني بِضَرَّتِها ال","بَيضاءِ أَو أُختِها السَوداءِ مِن قارِ",16,"ر",1,0],["وَقَد شَرقَت زرقُ الأَسِنَّةِ بِالدما","وَأَنكَرَ حَدَّ المَشرَفيِّ قِرابُهُ",17,"ب",2,0],["وَقَد شَخَصَت بِالسابِرِيَّةِ فَوقَهُ","مُعَلَّبَةَ الأُنبوبِ ماضٍ أَليلُها",18,"ل",3,0],["وَقَد شَبَّ مِن أَترابِ ظَلّامَةَ الدُمى","غَرائِرُ اِبكارٌ لِعَينَيكَ مَقنَعُ",19,"ع",1,0],["وقد شبّه الرحمن خلقتنا به","وحسبُك فخراً بان منه اعتلاؤُها",20,"ا",3,0],["وقد شَخَصت نحو السماء بطرفها","لها كلَّ آن زَفرة وحنين",21,"ن",1,0],["وَقَد شَقَّقَت يَومَ الرَحوبِ سُيوفُنا","عَواتِقَ لَم يَثبُت عَلَيهِنَّ مِحمَلُ",22,"ل",1,0],["وقد شاع الحديثُ بها ولكن","إخَال النَّغْل مسدود الصِّمَاخِ",23,"خ",1,0],["وقد شمتمُ منه ومن أوليائه","بوارقَ لم يُخلِف هناك لموعها",24,"ع",3,0],["وقد شمّرتْ عن ساقها غير أنها","تركّضُ في ذيلٍ من النفعِ ذائلِ",25,"ل",1,0],["وقد شمّرت عن ساقها غير أنها","تركَّضُ في ذيلٍ من النقعِ ذائلِ",26,"ل",1,0],["وَقَد شَوَينا خَروفاً","وَتَحتَهُ جوذابَه",27,"ب",2,0],["وَقَد شَحَذَت مِنهُ حَداثَةَ سِنِّهِ","شَهامَةُ غِطريفٍ حِدادٍ مَخالِبُه",28,"ب",2,0],["وَقَد شَمَّرتَ عَن جِدٍّ","كَأَنَّكَ مُشعَرٌ غَضَبا",29,"ب",2,0],["وَقَد شاغَبَ الإِسلامَ خَمسينَ حِجَّةً","فَلا الخَوفُ ناهيهِ وَلا الحِلمُ زاجِرُه",30,"ر",2,0],["وَقَد شَمِلَ اِمتِنانُكَ كُلَّ حَيٍّ","فَهَل مَنٌّ يُفَكُّ بِهِ أَسيرُ",31,"ر",1,0],["وَقَد شُهِرَت بيضُ السُيوفِ وَأُعرِضَت","صُدورُ المَذاكي مِن كُمَيتٍ وَأَبلَقِ",32,"ق",1,0],["وَقَد شَمِلَت بِشراً لِأَوسٍ صَنيعَةٌ","بِما أَمَرَت سُعدى وَوَرَّثَ لامُ",33,"م",1,0],["وَقَد شَرِقَت جِبالُ الطيبِ مِنهُم","بِيَومٍ مِثلِ يَومِ النَهرَوانِ",34,"ن",1,0],["وَقَد شَكَرتُ أَبا الأَشبالِ ما صَنَعَت","يَداهُ عِندي وَخَيرُ الناسَ مَن شَكَرا",35,"ر",2,0],["وَقَد شابَ صُدغاكَ اللَئيمانِ عاتِباً","عَلَينا وَفينا أُمُّكَ الغولُ تَمزَعُ",36,"ع",1,0],["وقد شيَّعَني طَرْفٌ","بماءِ الشَّوقِ مَطروفُ",37,"ف",1,0],["وقد شَغَلتْ كعوبُ الرمحِ منه","يَديهِ عن مُلامَسَةِ الكِعابِ",38,"ب",1,0],["وقد شغلَ النَّدى الألبابَ فيه","فباتتْ تَنظِمُ الكَلِمَ اللُّبابا",39,"ب",2,0],["وَقَد شاعَ بِأَنَّ الخَز","زَ يُؤذيكِ وَيُدميكِ",40,"ك",1,0],["وَقَد شَمَّرَ المَوتُ عَن ساقِهِ","وَكَشَّرَتِ الحَربُ عَن نابِها",41,"ب",3,0],["وَقَد شاهَدَت نَثري وَنَظمِيَ في الوَغى","لِهامِ العِدى وَالنَحرِ بِالضَربِ وَالطَعنِ",42,"ن",1,0],["وقد شَمِلَتنْي شيبةٌ لم أبِتْ بها","فما ليَ في ليلي وقد طَلَعَتْ شمسي",43,"س",2,0],["وقَد شُقّ خَيطُ الفَجرِ في جُنحِ لَيلِنا","كَما شُقّ حَدُّ السيفِ في جانِبِ الغِمدِ",44,"د",1,0],["وَقَد شَسَعَت لَيلى وَشَطَّ مَزارُها","وَغَيَّرَها عَن عَهدِها قَولُ حاسِدِ",45,"د",1,0],["وقد شبعتم ظهوراً في مظاهرةٍ","مشروعةٍ وسكرتم بالهتافاتِ",46,"ت",1,0],["وقد شَغَرَتْ مِنهمْ حُصونٌ أَواهِلٌ","وما راعها مِنْ قبل ذاك شُغُورُ",47,"ر",1,0],["وَقَدْ شَهِدَتْ بِذاهُلْبا سُوَيْدٍ","وَهُلْبا بَعْجَةٍ حَرْباً زَبُونا",48,"ن",2,0],["وقد شاقني إيماضُ بْرقٍ بذي الغَضى","كما حُرِّكتْ في الشمس بيض المناصل",49,"ل",1,0],["وَقَد شاعَ الَّذي أُخفي","وَقَد كانَ الَّذي أَحذَر",50,"ر",1,0],["وَقَد شَفَّني أَلّا تَزالَ كَليفَةً","تُنَصِّبُني فيها فَأُصبِحُ مُكمَدّا",51,"د",2,0],["وَقَد شَذَّبَتكَ الحادِثاتُ وَإِنَّما","يُفَرِّعُ غُصنُ الدَوحِ حينَ يُشَذَّبُ",52,"ب",1,1],["وَقَد شَرِبَ الدَهرُ صَفوَ الأَنامِ","فَلَم يَبقَ في الأَرضِ إِلّا العَكَر",53,"ر",1,0],["وَقَد شَهِدتَ مَخاريقَ الوَغى لَعِبَت","مُجيدَةً لِدُروعِ القَومِ تَخريقا",54,"ق",2,0],["وَقَد شَرِبتَ نُمَيراً فَاِجتَرَأتَ بِهِ","فَلِم حَمَلتَ مِنَ الصَهباءِ أَرطالا",55,"ل",2,0],["وَقَد شَهَرا سَيفَينِ في كُلِّ مَعشَرٍ","يَقُدّانِ ما هَمّا بِهِ أَو يَقُطّانِ",56,"ن",1,0],["وَقَد شَهِدَ النَصارى أَنَّ عيسى","تَوَّخَتهُ اليَهودُ لِيَصلِبوهُ",57,"ب",3,0],["وقد شَرّفْتَني وَرَفَعْتَ إِسْمي","به وأنَلْتَني الحَظّ الرّبيحا",58,"ح",2,0],["وَقد شاقَنِي الوُرْقُ السّواجعُ بالضُّحى","ومَن يسْتمع داعِي الصّبابَةِ يشتَقِ",59,"ق",1,0],["وَقَد شَقِيَت تَيمٌ بِأَمرِ غَوِيِّها","وَقالَ لِتَيمٍ قَد أَمَرتُكُمُ أَمري",60,"ر",2,0],["وَقَدْ شَاقَنِي وَالصُّبْحُ فِي خِدْرِ أُمِّهِ","حَنِينُ حَمَامَاتٍ تَجَاوَبْنَ فِي وَكْرِ",61,"ر",1,0],["وقَدْ شفَّتْ عَزِيمَة رَأْ","يِهِ جُثْمانَهُ الْبَضَّا",62,"ض",2,0],["وَقَد شَهِدَ المِسواكُ عِندي بِطيبِهِ","وَلَم أَرَ عَدلاً وَهوَ سَكرانُ يَطفَحُ",63,"ح",1,0],["وقد شاهدت منك خلقا جميلا","أناف على درجات الكمال",64,"ل",1,0],["وقد شرعت في مجمع القول نحوه","أسنة حرب للعيون اللوامح",65,"ح",1,0],["وقد شردت فكري هنالك ضجة","لأطيارها تدعو بنبذ التفاكك",66,"ك",1,0],["وقد شرق المجد الاثيل بدمعه","وبات عليلا ناكصا راس خامل",67,"ل",1,0],["وقد شببنا على مبذول انعمه","كالغصن جمل حين ازدان بالورق",68,"ق",1,0],["وقد شرب السم النقيع مبسملا","فكان كماء طيب الطعم بارد",69,"د",1,0],["وقد شغفوا عن داء حقد اطاشهم","يقول اذا ما جئت هذا حبيبه",70,"ب",2,0],["وقد شهدوا لذاتك معجزات","بدست الصدق تم لها انجلاء",71,"ا",2,0],["وقد شهدت مجلى تجليك فانطوى","لها عالم الأسرار في ذلك المجلى",72,"ل",2,0],["وقد شربنا كؤوس الود مترعة","نخب الصداقة والاخلاص ساقينا",73,"ن",2,0],["وقد شيّدتَ للعليا ربوعاً","ومالك يا وحيد الدهر ثانِ",74,"ن",1,0],["وقد شِمْتَ راحات العمومِ براحةٍ","خصوصية إذ أن ذا شيمة الحرِ",75,"ر",1,0],["وَقَد شَفَعتَ الغِنى لي بِالعُلى كَرَماً","فَصِرتُ ذا نَسَبٍ في المَجدِ وَالنَسَبِ",76,"ب",1,0],["وَقَد شَهِدَت مَنابِرُهَ بِحَقٍّ","مَلائِكَةُ السَماءِ بِهِ شُهودُ",77,"د",1,0],["وَقَد شَمِلَ الخَوفُ النَبيَّ وَماعَدا","فَلوذوا بِهِ تَنجوا فَإِنَّ مُحَمَّدا",78,"د",2,0],["وقَد شَهِدتُ بها إبداعَ بَارئِها","حتَّى تمشَّى يَقِيني في شَرايِيني",79,"ن",2,0],["وَقَدْ شَربوا حتَّى كأَنَّ رؤوسَهُمْ","مِنَ السُّكْرِ فِي أَعْنَاقها سِنَةُ الكرى",80,"ا",1,0],["وقد شيبّت بالهجر رأسي لوم تخفْ","أما في صباغ بالبياض أثام",81,"م",1,0],["وقد شرعوا شرعا أباح لهم به","إمامهم أن يعبدوا الشمس والعجلا",82,"ل",2,0],["وَقَد شَرِقَت لِلغَبنِ عَيني بِمائِها","وَحُقَّ لِماءِ العَينِ أَن يَتَهَمَّلا",83,"ل",2,0],["وقد شَجا أَكبُداً أَرِّخ بِحُرقَتِها","مِن بَعدِ يَعقوبَ قاست حُ