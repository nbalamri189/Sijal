"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[72,"دمت للآداب تنشي رسمها","https://www.poetsgate.com/ViewPoem.aspx?id=189417",""],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[77,"بإسماعيل ثم أخيه قيس","https://www.poetsgate.com/ViewPoem.aspx?id=33648",""],[77,"وافي بعطفتك البشير فلو غدت","https://www.poetsgate.com/ViewPoem.aspx?id=34155",""],[77,"ما ضر لو سلم أو ودعا","https://www.poetsgate.com/ViewPoem.aspx?id=34175",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[90,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[54,"إنَّ ابن طوقٍ وبني تغلبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14294",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[80,"أين مني عتبُ أحبابٍ هجود","https://www.poetsgate.com/ViewPoem.aspx?id=3156",""],[28,"بكت عين محزون فطال انسجامها","https://www.poetsgate.com/ViewPoem.aspx?id=20996",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["دَمعاً إِذا ما فاضَ صَوَّرَ أَعيُناً","حَيثُ اِستَقَرَّ بِهِ مِنَ الغُدرانِ",0,"ن",1,0],["دِماءٌ نِيامٌ في الأَباجِلِ أوقِظَت","وَظَنِّيَ يَوماً أَن يَطولَ سِفاكُ",1,"ك",1,0],["دَمٌ جاشَ شُؤبوبُهُ عَن يَدٍ","يُقَلِّبُها البَطَلُ الأَروَعُ",2,"ع",1,0],["دَمعي كَجودي عِندَ بَذلِ النَدى","وَحَرُّ بَأسي مِثلُ أَنفاسي",3,"ي",1,0],["دَمٌ أُمويٌّ ليس يسكنُ فورُهُ","وما بعدَه إِلّا الفِرارُ أو القَتلُ",4,"ل",1,0],["دُموعٌ في الخُدودِ لَها مَسيلُ","وَعَينٌ نَومُها أَبَداً قَليلُ",5,"ل",1,1],["دُموعُ عَيني تَسبُقُ الطَرفا","أَجهَدُ أَن تَخفى فَما تَخفى",6,"ف",2,1],["دُموعٌ دَعاهُنَّ الهَوى فَأَجَبنَهُ","تَحَدَّرنَ شَتّى وَهيَ تَجري عَلى خَدّي",7,"ي",1,1],["دُمْتَ رفيعَ المُلْكِ سامِي العُلا","ما طافَ بالبَيْتِ امْرُؤ أو سَعى",8,"ع",2,0],["دِمْنَتِي لاِنْتِجَاعِي الْحَرْثَ كَلَّتْ","فهِيَ الْيَوْمَ دِمْنَةٌ وَكَلِيلَهْ",9,"ه",1,0],["دُمْ فِي ذِمَامِ الله حِزْبُكَ غَالِبٌ","وَحِمَاكَ مَحْرُوسٌ وَمُلْكُكَ مُعْتَلِي",10,"ي",1,0],["دِمَنٌ غُذيَتْ بهِنّ أخْلافَ الهَوى","ولبِسَ ريْعانُ الشّبابِ جَديدا",11,"د",2,0],["دُمْتَ في عِزّةٍ ورِفْعَة قَدْرٍ","بيْنَ مَغْدىً موفَّقٍ ومَراحِ",12,"ح",1,0],["دَمُ الأخَوَيْنِ دَوى جُرْحَ قَلبي","وعالَجَني وحَسْبُكِ منْ عِلاجِ",13,"ج",1,0],["دِمنَةٌ قَفرَةٌ تَعاوَرَها الصَي","فُ بِريحَينِ مِن صَباً وَشَمالِ",14,"ل",1,0],["دَمعَةٌ مِن دُموعِ عَهدِ الشَبابِ","كُنتُ خَبَّأتُها لِيَومِ المُصابِ",15,"ب",1,1],["دَمعُكَ اليَومَ مِثلُ أَمرِكَ بِالأَم","سِ مُطاعٌ في سَيِّدٍ وَمَسودِ",16,"د",1,0],["دُم يا فُؤادُ مُؤَيَّداً","بِالمالِ وَالأَرواحِ تُفدى",17,"د",2,0],["دِمَشقُ فَبي شَوقٌ إِلَيها مُبَرَّحٌ","وَإِن لَجَّ واشٍ أَو أَلَحَّ عَذولُ",18,"ل",1,0],["دُم مُوَقّىً وَلِيُّكَ الدَهرَ مَجبو","رٌ مَساعيكَ وَالعَدُوُّ مَهيضُ",19,"ض",1,0],["دمتم عماد الحمى ودام ال","حمى بكم راقياً أمينا",20,"ن",2,0],["دم كرم صفا فرد لماءٍ","ثم أضحى روحاً بفعل الزمان",21,"ن",1,0],["دُمْتَ ذُخْراً لَهُ مَآثِرُهُ فِي","نَفْعِ هَذَا الحِمَى وَفِي رَفْعِ شَأْنِهْ",22,"ن",2,0],["دُمْ رَافِعاً بَيْنَ مَنَارِ الهُدَى","مَنَارَةَ المَشْرِقِ فِي العَالَمِينْ",23,"ن",1,0],["دَمِي مِنْهُ يَجْرِي فِي الغُصُونِ وَمُهْجَتِي","يُحَسُّ لَهَا تَحْتَ السُّكُونِ حَنِينُ",24,"ن",1,0],["دَمِيَتْ مُهْجَةُ الشَّآمِ وَسَالَتْ","بِالصَّفَا فِي لُبْنَانَ مِنْهُ العُيُونُ",25,"ن",1,0],["دُمْتِ لِلإِحْسَانِ مَا طَالَ المَدَى","وَأَعَزَّ اللهُ أُمَّ المُحْسِنِينْ",26,"ن",1,0],["دُموعُ عَيني بِها اِنبِساطُ","وَنَومُ عَيني بِهِ اِنقِباضُ",27,"ض",1,1],["دِمائُهُم لَيسَ لَها طالِبٌ","مَطلولَةٌ مِثلَ دَمِ العُذرَه",28,"ر",2,0],["دمت بدرا في كمال","ساحبا برد الجمال",29,"ل",1,0],["دِمَنٌ عهدتُ بها الشبيبة والهوى","سقياً لها ولعهدها المتقدِّمِ",30,"م",1,0],["دمتُ ربعاً للتهاني","أنظم الشمل الجميعا",31,"ع",2,0],["دمتَ روحاً للمعاني","ما سرى في الجسم روحُ",32,"ح",1,0],["دمت عبد العزيز للعرب ذخراً","ولأهل الإسلام عزاً وفخرا",33,"ر",2,0],["دِمَنٌ تَلاعَبَتِ الرِياحُ بِرَسمِها","حَتّى تَنَكَّرَ نُؤيُها المَهدومُ",34,"م",1,0],["دِمَنٌ تَجَرَّمَ بَعدَ عَهدِ أَنيسِها","حِجَجٌ خَلَونَ حَلالُها وَحَرامُها",35,"م",3,0],["دِمناً تهيج رسومها بعد البلى","طرباً وكيف سؤال أعجم بالي",36,"ل",2,0],["دَمِنٌ تَعاقَبَها الرِياحُ دَوارِسٌ","وَالمُدجِناتُ مِنَ السِماكِ الأَعزَلِ",37,"ل",1,0],["دمتَ سامي المقامِ هامي العطايا","قاهر البأس فارجَ الغماء",38,"ا",2,0],["دَمعي مجيبٌ حالتي مستخبراً","للهِ دمعاً سائلاً ومجاوبا",39,"ب",2,0],["دمعي عليكَ مجانسٌ قلبي","فانظرْ على الحالينِ للصب",40,"ب",1,1],["دم يا أخيّ الدِّين والدُّنيا معاً","تملى بيوت الفضل منك وتكتب",41,"ب",1,1],["دماً هدر","هلاّ نظر",42,"ر",1,0],["دمعي نهر","على زَهر",42,"ر",1,0],["دمتم بني حجر الكرا","م لكم فخارٌ معتبر",43,"ر",1,0],["دُمْ يا علاء الدِّين وضَّاح السنا","في أفق العليا وهل يخفى القمر",44,"ر",1,0],["دُم كذا في كل وقت سامعاً","مدحاً يعي مداها الفكرا",45,"ر",2,0],["دُمْ وابقَ للسرِّ الشريف أمينهُ","على السرِّ في كلِّ المقادير والجهر",46,"ر",1,0],["دُمْ للعلى يا ابن فضل الله ذا رتبٍ","عزيزةٍ يا عزيز المصر يا غالي",47,"ي",1,0],["دم يا ابن فضل الله في حلي الثنا","والأجر كم زفّت عليه معالي",48,"ل",2,0],["دم للعلى يا ابن فضل الله مرتقياً","أفق المعالي وقد أربى على الأول",49,"ل",1,0],["دم جمالاً لمخبرٍ","وحياةً لمجتلي",50,"ل",2,0],["دمْ في مراتب فضل","عضدت فيها الأصاله",51,"ل",2,0],["دم هنيئاً بألف صومٍ وفطرٍ","مسعد في اقتباله وانصرامهْ",52,"م",2,0],["دمع يجاوب مسراه تبسمها","كالروض يضحك حيث الغيث ينسجم",53,"م",1,0],["دمْ واحداً للعلوم يعجبه","من التصانيف أنس أحلامه",54,"م",2,0],["دمت ذا إقبال سعدٍ خادمٍ","وندى كفّ إلينا محسن",55,"ن",1,0],["دم يا علاء الدين في رفعة","رأيك فيما يقتضي أعلى",56,"ل",2,1],["دَمَّرتْ أهلَهُ مكائدُ كانت","لأسودِ الطغاةِ كالتقشيبِ",57,"ب",1,0],["دماءُ بني عبَّاسكم وعَلِيِّهمْ","لكم كدماء الترك والروم تُهْرَجُ",58,"ج",1,0],["دمٌ قد كنت أنظر من قريبٍ","إليه فصرتُ أنظر من بعيدِ",59,"د",1,0],["دمعٌ وشعرٌ مساعدٌ أتيا","طوعاً وما طائع كمقتَسرِ",60,"ر",1,0],["دمَّنَتْهُ الأرواحُ قِدْماً فريَّا","هُ كريَّا حرائرِ الأهضام",61,"م",1,0],["دُم على ما أراه منك فمالي","حاجةٌ في هديّةٍ بخصومه",62,"م",2,0],["دِمَنٌ تُذَعذِعُها الرِياحُ وَتارَةً","تُسقى بِمُرتَجِزِ السَحابِ ثَقالِ",63,"ل",1,0],["دِمَنٌ لِقاتِلَةِ الغَرانِقِ ما بِها","إِلّا الوُحوشُ خَلَت لَهُ وَخَلا لَها",64,"ل",3,0],["دُميَةٌ حَسناءُ تُغري النَظَرا","أَم مَلاكٌ طاهِرٌ فَوقَ الثَرى",65,"ر",2,1],["دُمتَ يا خَيرَ المُلوكِ لَهُ","غَيرَ ما هَمٍّ وَلا سَقَمِ",66,"م",1,0],["دَميمَةٌ تُشبِهُ في قُبحِها","مَدينَةً مَهجورَةً عافِيَه",67,"ه",1,0],["دُمتَ في أَرغَدِ عَيشٍ","كُلَّ يَومٍ في مَزيدِ",68,"د",1,1],["دُمتَ في عَيش هِنيٍّ","صَفوُهُ غَيرُ مُكَدّرْ",69,"ر",1,0],["دَمي شَرابٌ لَكَ وَاللَحمُ قَد","أَكَلتهُ لا تَهشم الأَعظُما",70,"م",2,0],["دمعتي لا تعولي في رزايا","ك على وعد دهرك الكذّاب",71,"ب",1,0],["دمياط شاعرك الفياض مغترف","من نهرك العذب أو من بحرك الطامي",72,"ي",1,1],["دمت مشكور المساعي","أيها المولى الجليل",73,"ل",1,0],["دماء قد فدتك ولم تصنها","نفضت يديك يوم التل منها",74,"ه",2,0],["دَمُ الثُوّارِ تَعرِفُهُ فَرَنسا","وَتَعلَمُ أَنَّهُ نورٌ وَحَقُّ",75,"ق",1,0],["دُمِّرَ الناسُ وَالرَعِيَّةُ في تَش",