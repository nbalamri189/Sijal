[5956,"يا رحمة المولى على أنقى امرِئ","https://www.poetsgate.com/ViewPoem.aspx?id=183551",""],[5956,"ومضة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=193456",""],[5956,"يا رحمة الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=193834",""],[5956,"يا باسِطين حنانكم لجميعنا","https://www.poetsgate.com/ViewPoem.aspx?id=194128",""],[5969,"سِفرُ الخلاصْ","https://www.poetsgate.com/ViewPoem.aspx?id=198863",""],[5997,"ليل جموح","https://www.poetsgate.com/ViewPoem.aspx?id=214234",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6127,"رحلة الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=192766",""],[6142,"يا حجة الله وابن السادة الحجج","https://www.poetsgate.com/ViewPoem.aspx?id=155767",""],[6147,"لو.","https://www.poetsgate.com/ViewPoem.aspx?id=151497",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[242,"أزف الرحيل فخانني صبري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563697",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[6334,"سيد الأزمان !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82263&r=&rc=13",""],[5567,"عناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82100&r=&rc=141",""]],"verses":[["يَا رَحْمَةً لِلْعَاشِقِينَ تَقَحَّمُوا","خَطَرَ النَّوَى وَعَلَى الشَّدَائِدِ عَوَّلُوا",0,"ل",3,0],["يا رَحمَةَ اللَهِ هَذا قَبرُهُ فَقِفي","وَآنِسي روحَهُ يا رَحمَةَ اللَهِ",1,"ه",1,0],["يَا رَحِلاً فِي مِصْرَ يَخْلُدُ ذِكْرُهُ","مَا دَامَ النَّيلُ وَالْهَرَمانِ",2,"ن",1,0],["يا رحمةً بثّت الرُّحمَى بأندلسٍ","لولاك زُلزلتِ الدنيا بمن فيها",3,"ي",3,0],["يا رحمة الله التي ألطافها","سحبت علينا للقبول ذيولا",4,"ل",2,0],["يا رحمتا لمُنادميه تجشَّموا","ألمَ العيون للذَّةِ الآذان",5,"ن",1,0],["يا رحمةَ الرحمنِ أُمِّي أبي","واللهِ ما كانَ أبي أُمِّي",6,"م",2,0],["يا رَحمَةً بِالغَربِ شامِلَةً بَدَت","فيهِ أَعَمَّ مِنَ النَهارِ وَأَشهَرا",7,"ر",2,0],["يا رحيماً بالمؤمنين إذا ما","ذَهِلَت عن أبنائها الرُّحَماءُ",8,"ا",2,0],["يا رَحْمَةً لِلعَالَمِينَ أَلَم يَكُن","طِفلاً لِضُرِّ العالَمِينَ مُزيلا",9,"ل",2,0],["يا رَحِمَ اللَهُ الَّذي مَسَّني","مِنكِ بِأَوجاعٍ وَأَوصابِ",10,"ب",1,0],["يا رَحمَةَ اللَهِ حُلّي في مَنازِلِنا","وَجاوِرينا فَدَتكِ النَفسُ مِن جارِ",11,"ر",1,0],["يا رَحمَةَ اللَهِ حُلّي في مَنازِلِنا","حَسبي بِرائِحَةِ الفِردَوسِ مِن فيكِ",12,"ك",1,0],["يا رَحمَةَ اللَهِ حُلّي غَيرَ صاغِرَةٍ","عَلى حَزينٍ بِدارِ الحُبِّ مَرّارِ",13,"ر",1,0],["يا رحمةَ اللَّهِ في برِيَّتهِ","بكَ استقامَ الزَّمانُ من مَيَلهْ",14,"ل",2,0],["يا رَحمَةَ اللَّهِ جاوِري جَدَثاً","دَفَنْتُ فِيهِ حُشاشَتي بِيَدِي",15,"د",2,0],["يا رحمةَ اللَّهِ اهبطي وانظري","ما حصدَ الموتُ ودكَّ العَدَمْ",16,"م",1,0],["يا رحمة الله يا مبعوثَ رأفته","يا مظهر اللطف في الأرواح والصور",17,"ر",1,0],["يا رحيلي هذي بلادي تغنّي","داخلي تغتلي تدقّ بسرعه",18,"ع",2,0],["يا رَحمَةً بُعِثَت فَأَحيَت أُمَّةً","قَد طالَما مُنِيَت بِمَن لَم يَرحَمِ",19,"م",1,0],["يا رحمتا لمتيم لعبت به","أيدي الغرام فصار كالولهان",20,"ن",1,0],["يا رَحمةَ اللَهِ حِلِّي فَوقَ رابيةٍ","بِسَفحِ لُبنانَ وَارَت طيَّها جَبَلا",21,"ل",2,0],["يا رَحمةَ اللَهِ حلّي في ثَرى قَمَرٍ","قَد اِرتَدى بِالدُّجى مِن أَجلِهِ القَمرُ",22,"ر",1,0],["يا رحمةَ العشاقِ من أحبابهمْ","ناموا وباتوا الليلَ غيرَ نيامِ",23,"م",1,0],["يا رحمتا للصبِّ فيما نابهُ","حتى كرى جفنيهِ من عذالِهِ",24,"ل",2,0],["يَا رَحْمَةَ الرَّحْمَانِ أَرْسَلَهَا","وَالنَّاسُ فِي بَحْرٍ مِنَ الشَّرِّ",25,"ر",1,0],["يَا رَحْمَةَ اللهِ عُوجِي بِضَرِيحِهِمَا","وَلاَ تَزَالِي تَنُثِِّي لَهُمَا خَبَرَا",26,"ر",2,0],["يا رحمة اللَه حي روحه أَبَدا","عنى وَظلى وَباتى حيثما قبرا",27,"ر",2,0],["يا رَحمة الدنيا وَعصمة أَهلها","وَأَمان كل مشرق وَمغرب",28,"ب",1,0],["يا رحمة المهين","بلى له ثراه",29,"ا",2,0],["يا رحمة اللَه زوري","وأنعمي بحضور",30,"ر",1,1],["يا رَحيماً آثار رَحمته تَن","شَأُ عَنهُنَّ رَحمَة الرُحَماءِ",31,"ا",2,0],["يا رَحمَةً لِسَعادَةٍ","قضد أَصبَحَت في قَيدِ جَهلِه",32,"ل",2,0],["يا رحمةَ اللَهِ