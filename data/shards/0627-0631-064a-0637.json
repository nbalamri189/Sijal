{"poems":[[57,"تقول وقد كشفت المرط عنها","https://www.aldiwan.net/poem26391.html","الوافر"],[29,"عجبت لهاذا الزائر المترقب","https://www.aldiwan.net/poem5662.html","الطويل"],[87,"تغامر في الأمور تظن قصدا","https://www.aldiwan.net/poem7583.html","الوافر"],[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[18,"أهاج قذاء عيني الإذكار","https://www.aldiwan.net/poem23953.html","الوافر"],[82,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[107,"إلى طيئ يا ابن عم النبي","https://www.aldiwan.net/poem43588.html","المتقارب"],[48,"أرى طولا عم البرية كلها","https://www.aldiwan.net/poem22309.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[82,"أخذتُ برأيٍ في الصبا أنا تاركُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=3425",""],[48,"أرى طِوَلاً عمَّ البرِيّةَ كلّها،","https://www.poetsgate.com/ViewPoem.aspx?id=18299",""],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[29,"عجبتُ لهذا الزائرِ المترقب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16343&r=&rc=7",""],[98,"شاعر مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66378&r=&rc=54",""],[181,"خليقان هلهالان لا خير فيهما","https://www.aldiwan.net/poem4504.html","الطويل"],[371,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[376,"أرى طارقا يصبو إلي ويصبيني","https://www.aldiwan.net/poem57085.html","الطويل"],[463,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[466,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[545,"نهاني ابن الرسول عن المدام","https://www.aldiwan.net/poem56649.html","البسيط"],[556,"أأسقى نمير الماء ثم يلذ لي","https://www.aldiwan.net/poem48117.html","الطويل"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[580,"أرى طب جالينوس للجسم وحده","https://www.aldiwan.net/poem3013.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64223","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77429","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87700","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132577","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129446","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92442","الوافر"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76452","الطويل"],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5358,"لا تجرحي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183416",""],[5725,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=180536",""],[5943,"وجهَ البراءةِ","https://www.poetsgate.com/ViewPoem.aspx?id=34704",""]],"verses":[["أَرى طَرفي يُشَوِّقُني إِلَيها","كَأَنَّ القَلبَ يَعلمُ ما أُريدُ",0,"د",1,0],["أَرى طائِراً أَشفَقتُ مِن نَعَباتِهِ","فَإِن فارَقوا غَدراً فَما شِئتَ فَاِنعَبِ",1,"ب",1,0],["ارى طوفان هذا الغرب يطغى","واهل الشرق سادتهم نيام",2,"م",1,0],["أَرى طَيّارَهُم أَوفى عَلَينا","وَحَلَّقَ فَوقَ أَرؤُسِنا وَحاما",3,"م",2,0],["أَرى طولَ الحَياةِ وَقَد تَوَلّى","كَما قَد يُسلَبُ الشَيءُ المُعارُ",4,"ر",1,0],["أَرى طَرَفاً لي من لِسانِكَ جارِحاً","وفي طَرَفِ السيفِ المهَنَّد باتِكُه",5,"ك",2,0],["أرى طَيِّئاً خَذلتْ ربَّها","فما من مَلاذٍ ولا مُعتصَمْ",6,"م",1,0],["أَرى طِوَلاً عَمَّ البَرِيَّةَ كُلُّها","فَيُقصَرُ بِالحُكمِ الإَِلهِيِّ أَو يُرخى",7,"خ",2,1],["أرى طَيْفَ معشوقٍ أرى روحَ عاشقٍ","أرى حُلمَ أجيالٍ أرى وجهَ شاعرِ",8,"ر",1,0],["أرى طرفاً لي من لسانك جارحاً","فما بال جَدوَى لا تُدارِكُه",9,"ك",2,0],["أرى طِوَلاً عمَّ البرِيّةَ كلّها،","فيُقْصَرُ بالحكم الإلهيّ، أو يُرْخا",10,"خ",2,1],["أرى طيفك المعسول في كلّ ما أرى","وحدت ولكن لم أجد منه مهربا",11,"ب",2,0],["أرى طائراً أشفقتُ من نعبائه","فان فارقوا غدراً فما شئتَ فانعبِ",12,"ب",1,0],["أرى طيف معشوق ، وأرى روح عاشق","ارى حلم أجيال ، أرى وجه شاعر",13,"ر",1,0],["أَرى طائِرَيَّ الأَوَّلَيْنِ تَبَدَّلا","إِليَّ فما لي منهما بَدَلانِ",14,"ن",1,0],["أَرى طَيفَكُم كالحَظِّ في الدَهرِ ما لَهُ","سُرىً أَبَداً إِلّا إلى عَينِ نائِمِ",15,"م",1,0],["أرَى طارِقاً يَصبُو إليَّ ويُصبِيني","ويُذكرُني ما كانَ هجرُكَ يُنسِيني",16,"ن",2,1],["أُرِي طَرفَها أنّ الخضابين واحدُ","ولكنَّه ما بَهرجَ الشيبَ ناقدُ",17,"د",1,1],["ارَى طَلْحَةَ الخيْراتِ شمسَ مَناقِبٍ","لَها المَجْدُ أوْجٌ والمَعالي مَطالِعُ",18,"ع",1,0],["أَرى طيبَ الحَلالِ عَليَّ خُبثاً","وَطيبَ النَفسِ في خُبثِ الحَرامِ",19,"م",1,0],["أَرى طَخْيةً فينا فَأَينَ صَباحُها","وَداءً عَلى داءٍ فأين شفاءُ",20,"ا",2,0],["أرى طالباً مِنّا الزِّيادةَ لا الحسْنى","بفِكرٍ رَمى سهْماً فعَدَّى بهِ عدْنا",21,"ن",2,1],["أَرى طِبَّ جالينوسَ للجسمِ وحده","وطبُّ أَبي عمرانَ للعقل والجِسْمِ",22,"م",1,1],["أرى طُهراً سيثمر بعد عُرْسٍ","كما قد تثمرُ الطربَ المدامَهْ",23,"ه",1,1],["أَرى طائِرَ الإِسلامِ في الشَرقِ غافِلا","يهِمُّ بِهِ مِن دَوحَةِ الغَربِ باشِقُ",24,"ق",1,1],["أَرى طالِعي المَيمون قَد طارَ بازه","وَأَقبَل نَحوي لِلنحوس غراب",25,"ب",1,0],["ارى طرفي والنجم","حليفين على السهد",26,"د",1,0],["أرى طيب خيم الفرع أعظم شاهد","على أصله في طيب خيم الجراثم",27,"م",1,0],["أَرى طول الحَياة أَلذَّ شيء","لأَنّي قد شفيت بذاكَ كيدا",28,"د",2,1],["ارى طفلة في حضن ام ولوعة","بها وَهيَ في تَقبيلها تَتَنوع",29,"ع",1,0],["أرى طالع الأدبار والنحس قد بدا","فأظلم كل الكون لما تايدا",30,"د",2,1],["أرى طيورَكِ نُزّالاً مُهاجِرةً","ما عادَ طيْرُكِ معروفاً بأهْليهِ",31,"ي",2,0],["ارى طاغوتنا عهد الرزايا","وفي انجاسه سفها تمادى",32,"د",2,0],["أرى طيوفَ المنى في سحرِ نظرتِها","بشائرَ الخيرِ ضاءتْ في ليالينا",33,"ن",2,0]]}