{"poems":[[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[93,"يا أيها الشعر أسعفني فأرثيه","https://www.aldiwan.net/poem62808.html","عموديه"],[93,"يا قائد القوم","https://www.poetsgate.com/ViewPoem.aspx?id=53388",""],[31,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[358,"يا رزق ما مثلك من أَغيد","https://www.aldiwan.net/poem39976.html","السريع"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199623","المسحوب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93661","الخفيف"],[4869,"حليب امك بفمك","https://www.poetsgate.com/ViewPoem.aspx?id=151661",""],[5725,"يا غصينا","https://www.poetsgate.com/ViewPoem.aspx?id=202816",""]],"verses":[["يَأرِزنَ مِن حِسِّ مِضرابٍ لَهُ ذَأَبٌ","مُشَمِّرٍ عَن عَمودِ الساقِ مُرتَقَبِ",0,"ب",1,0],["يا رِزقُ قَلبي عَلَيكَ اليَومَ مُنفَطِرٌ","وَكُلُّ قَلبٍ كَقَلبي في تَشَظّيهِ",1,"ي",2,0],["يا رزق ، قلبي عليك اليوم منفطر","وكلّ قلب كقلبي في تشطّيه",2,"ي",2,0],["يأرِزْنَ مِنْ حِسِّ مِضرارٍ لهُ دأبٌ","مشمرٍ عنْ عمودِ الساقِ، مرتقبِ",3,"ب",1,0],["يا رزق ما مثلك مِن أَغيدٍ","بِهِ سُروري وَالهَنا كامِلُ",4,"ل",1,1],["يا رزم يا متعلّي","يا متعلّى الزميم",5,"م",1,1],["يا رَزين الوقار سفن القَوافي","لَكَ سيرتها ببحر خَفيف",6,"ف",1,0],["يارزق أتعبني تحويشك","والفكر متشتت يلمك",7,"ك",1,0],["يا رزانا فضاعة الرمح قتلا","حين يبرى بمهجة المطعونِ",8,"ن",1,0]]}