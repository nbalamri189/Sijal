{"poems":[[51,"عجبا لأرباب العقول","https://www.aldiwan.net/poem63064.html","مجزوء الكامل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54298","المتقارب"],[276,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[447,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[500,"فؤادك أين سباه بماذا","https://www.aldiwan.net/poem9775.html","المتقارب"],[567,"سل ابنة القوم هل تدري بما صنعت","https://www.aldiwan.net/poem52879.html","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88597","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[826,"","https://poetry.dctabudhabi.ae/diwan/poem/140227",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96751","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53216","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65977","الطويل"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198225","الخفيف"],[4767,"باب الحوائج","https://www.poetsgate.com/ViewPoem.aspx?id=179962",""],[1914,"إِن أَشرَبِ الخَمرَ أَشرَبها لِلَذَّتِها","https://www.poetsgate.com/ViewPoem.aspx?id=9650",""]],"verses":[["سُلّابِ أَكسِيَةِ الأَرا","مِلِ وَاليَتامى وَالكُهولِ",0,"ل",1,0],["سَلْ أبا جَهلها وَقوماً دعاهم","فاستجابوا جَهالةً وغرورا",1,"ر",2,0],["سَلاَّبَةٍ خَلاَّبَةٍ غَلاَّبَةٍ","بِاللَّفْظِ أَوْ بِاللَّحْظِ أَوْ بِالجِيدِ",2,"د",1,0],["سَلاَ بِكَ لَيْلَى وَأَتْرَابَهَا","وَنَامَ عَنِ الْعَذْلِ وَالْعُذَّلِ",3,"ل",1,0],["سل ابن آدمجدا","تعزى اليه الجدود",4,"د",1,0],["سلابة بجمالها وخلالها","تختال في برد من العصراء",5,"ا",2,0],["سل أبرَقَ الحَنّانِ واحبس به","أين ليالينا على الأبرقِ",6,"ق",1,1],["سِلاَباً نعم أين وسط الطريق","متى اليوم هذا سلاب غريب",7,"ب",1,0],["سَل ابنْةَ القَومِ هل تَدري بما صَنَعتْ","ألحاظُها بفُؤادٍ فيهِ قد رَتَعَتْ",8,"ت",1,1],["سل أَبرق الحنان عن جيراننا","هل حيهم بالأَجرعين مقيم",9,"م",1,0],["سَل اِبنَ عدلانَ عَن تَحقيقه وَأَبا","حَيّان وَاِعدِل إِذا حُكِّمت واِعتبرِ",10,"ر",1,0],["سَلْ أباكَ البَرَّ لما أن رأى","قفزةَ الأغنام في عالي البِنا",11,"ن",2,0],["سل أَبا سلطان تحظى","عندَه جاهاً ومالا",12,"ل",2,0],["سل أبرق الحنان عنه فطالما","خفقت جوانح برقه لحنينه",13,"ن",2,0],["سل ابنك اقبال الفتى ومظفراً","وسل محرماً ذا الجود يا بن البهالل",14,"ل",1,0],["سل ابن خلدون علينا فلنا","بيَمَنٍ مآثرٌ لم تمحق",15,"ق",1,0],["سَلابَةَ أَلبابِ أَربابِ النُهى","يَذُرُّ الحَليمِ لَها الوِقارُ تفتَنا",16,"ن",2,0],["سَلْ ((أبا ظَبْيِ))كَمْ حَوَتْ مِنْ هُمامٍ","وكَمِّي غَشَمْشَمٍ صِنديدِ",17,"د",1,0],["سلِ ابنَ يقطينَ كم كانت له إحنٌ","في قصرِ هارونَ حتى عيَّنوا رصدا",18,"د",2,0],["سلابَةً لِلفَتى ما لَيسَ في يَدَيهِ","ذَهّابَةً بِعُقولِ القَومِ وَالمالِ",19,"ل",1,0]]}