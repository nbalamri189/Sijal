ctabudhabi.ae/diwan/poem/83171","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66146","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77696","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99123","البسيط"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132198","الطويل"],[4691,"يا من تستر عني","https://www.poetsgate.com/ViewPoem.aspx?id=61705",""],[5000,"نسيمَ الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=5821",""],[5111,"سَلامٌ لِحَرف","https://www.poetsgate.com/ViewPoem.aspx?id=212685",""],[5127,"عصينا مَنْ ﻻمَ بغيرِ اهتمامْ","https://www.poetsgate.com/ViewPoem.aspx?id=177358",""],[5136,"يا راقد الليل لم تشعر لمن سهرا","https://www.poetsgate.com/ViewPoem.aspx?id=121584",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5409,"ذكراك وهي لها في الدهر تجديد","https://www.poetsgate.com/ViewPoem.aspx?id=155263",""],[5497,"كجنةٍ عرضت","https://www.poetsgate.com/ViewPoem.aspx?id=209013",""],[6031,"يا فَتْحَ مَنْ أُغْلِقَتْ أبْوَابُ مَطْلَبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46357",""]],"verses":[["فَلَو رامَ قِسمَةَ عُمري لَهُ","لَمَ أَرضَ لَهُ العُمرَ إِلّا مَشاعا",0,"ع",2,0],["فلَوْ راعَ صرْفَ الدّهْرِ يوْماً بجَيْشِه","لأصْبَحَ نِسْياً آخرَ الدّهْرِ منْسِيّا",1,"ي",2,0],["فَلَوْ رُميتْ مِصْرٌ بِهَا وَصَعِيدُهَا","لأَضحَتْ خَلاَءً بَلْقَعاً بَعْدَ عُمْرَانِ",2,"ن",1,0],["فَلَوْ رآكَ زُهَيْرٌ مَا تَخَلَّفَهَا","غُرّاً عَلَى مدَدَ الأَحْقَابِ فِي هَرِم",3,"م",1,0],["فَلَو رَآهُ اِبنُ أَوسٍ ما قَرَأتَ لَهُ","السَيفُ أَصدَقُ أَنباءٍ مِنَ الكُتُبِ",4,"ب",1,0],["فلو رأيت وقد شبّ الحريق به","والريح دلعتها فيه نيرانا",5,"ن",2,0],["فلو رأيت وقد شبّ الحريق به","والريح تصفق للنيران أردانا",5,"ن",2,0],["فلو رأيتهُم يستخرجون دمِي","رأيت أكثر خلق الله عدوانا",6,"ن",2,0],["فلو رامها الطائيّ من قبل لم يقل","لهانَ علينا أن نقول ونفعلا",7,"ل",2,0],["فلو رُفعتْ في رأس علياءَ لاهتدى","بكوكبها السارونَ في الشرق والغربِ",8,"ب",1,0],["فلو رَآها شَيْخُها ما عبَّسا","قال بُوركتِ كَمِيَّاً مِدعسا",9,"س",2,0],["فَلَو رَأَيتُم سُروري","بِكُم لَكان عَجيبا",10,"ب",2,0],["فَلَو رَأَيتَ إِلى قَومي إِذا اِنفَرَجَت","عَن سابِقٍ وَهُوَ يَجري غَيرِ مَسبوبِ",11,"ب",1,0],["فَلو رَأَيتَ مُصابي عِندَما رَحَلوا","رَثَيثَ لي مِن عَذابي يَومَ بَينِهِمِ",12,"م",1,0],["فَلَو رَأَت بَأسَكَ الآسادُ لَاِضطَرَبَت","بِهِ فَرائِصُها مِن شِدَّةِ الفَرَقِ",13,"ق",1,0],["فَلَو رُدَّ مِن كَفِّ المَنِيَّةِ هالِكٌ","بِنَوحِ بَناتٍ كانَ أوَّلَ مَنْ رُدّا",14,"د",2,0],["فلو رامَ قسٌ وصفَ باقِل خدِّهِ","لعيَّرَ قسَّاً بالفهاهةِ باقلُ",15,"ل",1,0],["فَلَو رَآهُ حَبيسٌ فَوقَ صَومَعَةٍ","لَقالَ في مِثلِ هَذا فَاِدخُلوا النارا",16,"ر",2,0],["فلو رأى ما دهاني من كِتابِكُمُ","وما دها شِعْرَهُ منكم لما شَعُرا",17,"ر",2,0],["فَلَو رَآها أَنوشُروانُ صَوَّرَها","فيما يَحوكُ مِنَ الديباجِ وَالسَرَقِ",18,"ق",1,0],["فَلَو رُدَّ في كِسرى ابنِ ساسانَ روحُهُ","إِذَن لَاصطَفاني دونَ كُلِّ نَديمِ",19,"م",1,0],["فَلَوْ رَدَّتِ الأَيَّامُ مُهْجَةَ هُرْمُسٍ","لأَعْوَلَ مِنْ حُزْنٍ عَلَى نُوَبِ الدَّهْرِ",20,"ر",1,0],["فلو رآك زهير ما تخلفها","غرا على مرر الأحقاب في هرم",21,"م",1,0],["فلو ريْمَ كشفُ الستر عن قبر أحمدٍ","إذن لشجانا نَوْحُه وحنينه",22,"ن",2,0],["فلو رمت من سيال جيحون شربة","من الماء مست صوفها بلهيب",23,"ب",1,0],["فلو رآه أبقراطٌ وشيعته","لقال من مبتدا هذا نهاياتي",24,"ت",2,0],["فلو رِزقُ نفسِك أمسى إليك","لما زدتَها فوق هذا السَّناءِ",25,"ا",2,0],["فَلَو رَآكَ المُقَرِّظونَ لَهُم","عادوا يَذُمّونَ كُلَّ مَن حَمِدوا",26,"د",3,0],["فَلَو رُدَّ فِيَّ الرُّوحُ بَعْدَ فِراقِهِمْ","لَما وَجَدَتْ رُوحي لَها فِيَّ مَوْضِعَا",27,"ع",2,0],["فلو رزقوا رشدا وجاؤك أولاً","ولم يحدثوا الأمر العظيم ولا القتلا",28,"ل",2,0],["فَلو رَأى عُمَرُ الفاروقُ سيرَتَهُ","لَقالَ هَذا رَحى الإِسلامِ وَالقُطُبُ",29,"ب",1,0],["فلو رام قلبي سَلْوةً حالَ دونَه","رَسيسُ غَرامٍ من تَليدٍ وطارِف",30,"ف",1,0],["فلو رأوا موضعي في ارضهم حجراً","رأيتهم عرفوهُ غير ناسينا",31,"ن",2,0],["فَلَو رَأَيتِهِمُ وَالخَيلُ تُثبِتُهُم","وَالبيضُ تَأخُذُهُم مَثنىً وَوِحدانا",32,"ن",2,0],["فلو رأى قصر ما حاز حار ولم","تذكر له دولة كسرى ولا دارا",33,"ر",2,0],["فلو رُدَّ في كسرى بن ساسان روحهُ","إذاً لاصطفاني دون كلِّ نديم",34,"م",1,0],["فلو رأى ما يعاني من مواهبه","معن لأعياه والطائي لم يطب",35,"ب",1,0],["فَلَوْ رُمْتُ الكَواكِبَ ظَاهَرَتْنِي","سَعَادَتُهُ عَلى نَيْلِ المَرامِ",36,"م",1,0],["فَلَو رَآهُ اِبنُ عبّادٍ لَصارَ لَهُ","عَبداً وَزَلَّت بِهِ عَن شَأوِهِ القَدَمُ",37,"م",1,0],["فَلَو رَآهُ مَلِكٌ صارَ مَم","لوكاً لَهُ قَسراً عَلى رَغمِهِ",38,"م",2,0],["فَلَو رَآهُم أَميرُ المُؤمِنينَ لما","قالَ انحُ ذا النَحوَ يا با الأَسوَدِ الدُّؤَلي",39,"ل",2,0],["فَلَو رَأَتهُ مُقلَة اِبنِ مُقلَة ال","كاتِبِ نادى مُعلِناً يا للعَجَب",40,"ب",1,0],["فَلَو رَأَو خُبزاً عَلى شاهِقٍ","لَأَسرَعوا لِلخُبزِ بِالجَمزِ",41,"ز",1,0],["فَلَو ريمَ مِنها حيثُ تَخطو تقرّباً","لِجوهرِ عقدٍ ثيلَ لَم يعدُهُ لقطا",42,"ط",2,0],["فَلَو رامَه وصفاً عطاردُ لاِنثَنَت","فَصاحَتهُ عيّا وَحِكمَته نطّا",42,"ط",2,0],["فَلَو رَآهُ نَجيبُ عِندي","وَلَم يَكُن بِالذَهابِ عِجلُ",43,"ل",1,0],["فَلَوْ رَأَيْتَهما شَاهَدْتَ مِن عَجَبٍ","أَلا رَأَيْتَ وَلمْ تَسمَعْ بَأخبارِ",44,"ر",1,0],["فَلَو رَأى مُبتَدِأي عاتِبٌ","لَم يَثنِهِ عَن خَبَري العَتبُ",45,"ب",1,0],["فَلَو رَآهُ سُرورٌ كانَ يُنكِرُهُ","وَالهَمُّ لَو قَد يَراهُ قالَ هَذا لي",46,"ل",2,0],["فلو رأَوْني لقالوا مات أسعدُنا","وعاشَ للهَمِّ والأحزانِ أشقانا",47,"ن",2,0],["فلو رَمَتْ بالشّرارِ بَعدَهُمُ","أحْنَاءُ صَدري ما قلت وَيْكِ قَدِي",48,"د",2,0],["فلَو رأَوْا قَلبِي رَضُوا كلَّ ما","يُعلِنُهُ فيهمْ ومَا يَكتُمُ",49,"م",1,0],["فلو رام أسباب السماء لنالها","وسار بمضمار المرام وما كدا",50,"د",2,0],["فلو رمت قلع الرَّواسي بها","أعدت الرَّواسي كثيباً مهيلا",51,"ل",2,0],["فلو رأى الغيث فيض راحته","ما صابنا صوبه ولا قطره",52,"ر",2,0],["فلو روّى ليفرِق بين ماءٍ","وماء مثلهِ وجدَ الفروقا",53,"ق",2,0],["فَلَو رَنَّةٌ في فيهِ خَفَّت","عَلى سَمعي إِذاً ما خَفَّ صَبري",54,"ر",2,0],["فلو ردُّوا اليها بعد لأيٍ","وقد هلكوا بصَيلَمِها لعادوا",55,"د",3,0],["فلو رضيت انتعشت","فاصفح لتزداد فضلا",56,"ل",2,0],["فلو ريء للنعمان قال خورنقي","وكم حكموا بالفضل ظلما لسابق",57,"ق",1,0],["فلو رمى كلكل سلطانه","على ثبير لتردى وطاح",58,"ح",1,0],["فلو رامَ جَرِيرٌ أَنْ","يُجارِيكَ طَوَى حَبْلَهْ",59,"ل",2,0],["فلَو رأيتَ سيدي","ما بِه طُرًّا فاهُوا",60,"ا",1,0],["فلو رامه الأفقُ ما ناله","ولولاك كفواً له ما عداني",61,"ن",2,0],["فلو رآها عذولٌ تاب معتذراً","من أنْ يعود إلى شيءٍ من العَذَلِ",62,"ل",1,0],["فلو رامَ بُرجاً في السماءِ لما عَصى","عليه وقِرْناً في السَّحاب لمَا نَجا",63,"ج",2,0],["فَلَوْ رُمْتُ أَنِّي عَنْهُ أَثْني أَعِنَّتي","لَشَوْقِي يُنادي لُطْفَهُ أَيْنَ تَذهَبُ",64,"ب",1,0],["فَلوْ رأَى بَدْرُ الدُّجى","ضِياءَ خَدَّيْهِ سَجَدْ",65,"د",1,0],["فلو رأيت ظلالاً منه وارفة","لقلت روض يزهر البرِّ قد نضرا",66,"ر",2,0],["فلو رآه الذي قال الهزال حجى","لراح يحلف ان الفضل في السمن",67,"ن",1,0],["فلو رجعتم إلى الحسنى لكان لكم","إلى صحابتكم رجعَى ومنقلب",68,"ب",1,0],["فَلَو رُمت جَوبَ الأَرضِ فيهِ لَجُبتها","بِمدّةِ يَومٍ قَد ذَهبت وَأُبتها",69,"ه",2,0],["فَلَو رَأى خدَّ حِبّي والعِذارُ به","رَأى الزُّمرُّدَ في الياقوتِ قَد غاصَا",70,"ص",2,0],["فَلَو رامَ أَن يَرقى السِّماكَ لَجاءَهُ","عَلى هامِهِ كَالبَرقِ هَرولةً يَسري",71,"ر",2,0],["فَلَو رامَ أَخذَ النّجمِ مِن كَبد السّما","عَلَيهِ لَطالَ النّجمُ مِن ذَلكَ الكبدِ",72,"د",1,0],["فلو رامَتِ الكُومُ المَراسيل شَأْوَها","لقُلنا لها كُفّي لك العَقْرُ والشَّحْطُ",73,"ط",1,0],["فلو رقرقته لمنحدر من","السيل لاستوقفته فتورا",74,"ر",2,0],["فَلَو رَأَتِ الأَنصارُ ظُلمَ اِبنِ عَمِّكُم","لَكانوا لَهُ مِن ظُلمِهِ حاضِري النَصرِ",75,"ر",1,0],["فلورثى هذي الذخيرة في الورى","خير الجزا وله الثواب الاكبرُ",76,"ر",1,0],["فَلَوْ رأَتْهُ بَلْقِيسُ أَغْنى","هُداهُ عَنْ صَرْحِها المُمَّردْ",77,"د",1,0],["فَلو رَدَّ أَهلُ الحَقِّ مَن ماتَ مِنكُمُ","إِلى حَقّه لَم تُدفَنوا في المَقابِرِ",78,"ر",1,0],["فلو رآه عابد","عن التنسك اشتغل",79,"ل",1,0],["فَلَو رَأى ضَبَّةُ عِصيَانَهُم","لَم يَنسُبِ السَّيفَ لِسَبقِ العَذَل",80,"ل",1,0],["فلو رآه زهير في شبيبته","إذاً لفدَّاه واختارَ الفدا هرما"