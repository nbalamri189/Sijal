{"poems":[[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[50,"فديت من حملته حاجة","https://www.aldiwan.net/poem10411.html","السريع"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[207,"يا نبي الهدى إليك لجا حي","https://www.aldiwan.net/poem68171.html","الخفيف"],[234,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[303,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[325,"أشكر الله يا محمد وأحمد","https://www.aldiwan.net/poem67196.html","الخفيف"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[637,"","https://poetry.dctabudhabi.ae/diwan/poem/79677","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71080","الخفيف"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177824","السريع"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3062,"","https://poetry.dctabudhabi.ae/diwan/poem/204403",""],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138774",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118772","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119558","السريع"],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5984,"لهف نفسي على الغزال الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=200379",""]],"verses":[["ثُمَّ ثَناها وَأَتاها الكَلبُ","هُما عَلَيها وَالزَمانُ إِلبُ",0,"ب",1,0],["ثُمَّ ثَنى ثَوباً عَلى وَجهِهِ","فَبَلَّهُ مِن خَجَلٍ بِالبُكاء",1,"ا",2,0],["ثمَّ ثَنى عنانَهُ الأَميرُ","وحولهُ التهليلُ والتَّكبيرُ",2,"ر",1,0],["ثمَّ ثَنى الراياتِ في طريقهِ","إلى بني ذي النونِ من توفيقهِ",2,"ه",1,0],["ثمّ ثنى الإمامُ من عِنانِهِ","وقد شَفى الشَّجيَّ من أشجانِهِ",2,"ه",1,0],["ثُمَّ ثابَت إِلَيهِ مَن بِهِمُ الخَز","رَجُ وَالأَوسُ أَنجُمَ الهَيجاءِ",3,"ا",2,0],["ثم ثَنَتْ كفّي على خافقٍ","من قلبها مُرْتَجِفٍ مُسْتَطار",4,"ر",1,0],["ثمَّ ثنّينا فساغتْ سهلةً","راضها التقبيلُ من بعدِ شماس",5,"س",1,0],["ثُمَّ ثَنى بِما بِهِ تَتَثَنّى","في المَعالي مَعاطِفٌ وَمَناكِبِ",6,"ب",1,0],["ثم ثابوا فأدركوا بَعدُ نُكراً","لا يُجارَى ولم تُبحهُ الضوارى",7,"ر",2,0],["ثم ثَنَّى بمثلِهِ إذ رأى المو","تَ عِياناً في لحظةِ النعْمانِ",8,"ن",1,0],["ثُمَّ ثاروا ما بينَ مُلتاثِ ثَوبَيهِ","وجاثٍ وماثِلٍ في اعتِدالِ",9,"ل",1,0],["ثم ثنى ورباعٌ ومن","بعد رباعٍ سدسٌ جرشعُ",10,"ع",1,0],["ثمّ ثاروا واستنهضوا كل ماحا","زَ عروض تهامة للنفورِ",11,"ر",1,0],["ثم ثنت عنانها لطيبة","تؤم خير العالمين أحمدا",12,"د",2,0],["ثُمَّ ثَلاثينَ بِقَيد الأَسر","قَد أَوقَعونا في شَديدِ الفِكر",13,"ر",1,0],["ثم ثارت عجاجة","تحتها الموت منقعا",14,"ع",2,0],["ثم ثادوا أسد الله فيا","أعينَ العليا اُسكبي الدَّمع انسفاحا",15,"ح",2,0],["ثم ثلاثين دعوا معمولا","اتقانها يبلِّغ المأمولا",16,"ل",2,0],["ثم ثوى المأمون في جهاده","رهناً بما قدمه من زاده",17,"ه",1,0],["ثم ثوى القائم بعد مده","وبايعوا لمقتديهم بعده",17,"ه",1,0],["ثُمَّ ثوونَ وَأَنوَ قَتَلا","فَجاءَهُ خَرسيدَمٌ مُشتَعِلا",18,"ل",2,0],["ثم ثناه الدهر عن رأيه","فحال والدهر بقوم يحول",19,"ل",1,0],["ثم ثناها بثانية","رغم ذي السلطان والخدم",20,"م",1,0],["ثم ثنى والقوم قد طربوا من","ه قياما به لفضل السرور",21,"ر",1,0]]}