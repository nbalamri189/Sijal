{"poems":[[53,"بخلت علي بجدوى سواك","https://www.aldiwan.net/poem66528.html","المتقارب"],[47,"تعود عوائد الدمع المراق","https://www.aldiwan.net/poem65196.html","الوافر"],[104,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[240,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62668","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145107","المنسرح"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202066","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97902","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216422",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70031","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4858,"انصروا الله تنالوا نصره","https://www.poetsgate.com/ViewPoem.aspx?id=30637",""],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[5186,"أبدع الله في الورى تجنيسه","https://www.poetsgate.com/ViewPoem.aspx?id=156436",""],[5431,"أنوحُ وقد نجا بالركبِ نوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=189541",""],[5431,"ولا وأبيك لا أهجو الذبابا","https://www.poetsgate.com/ViewPoem.aspx?id=197167",""],[5431,"كيف تنجو بخبثها الأشرارُ؟...","https://www.poetsgate.com/ViewPoem.aspx?id=211836",""],[5606,"يقول عيسى وعيسى يرفع أقواله","https://www.poetsgate.com/ViewPoem.aspx?id=197970",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[6344,"جنوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87977&r=&rc=17",""],[5064,"لَمْ يبقَ للحُبِّ العظِيمِ مكَانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87536&r=&rc=31",""]],"verses":[["وخِستَ بأمرٍ تضمَّنته","ومثلُك خاسَ بما يَضمَنُ",0,"ن",1,0],["وَخُسرانُ المَوَدَّةِ في السَجايا","كَخُسرانِ التِجارَةِ في الوِراقِ",1,"ق",1,0],["وَخُسوف تَحدَّث البَدر فيهِ","بِفَم الحوت منذراً برزيَّه",2,"ه",1,0],["وَخِسَّةٍ تَحتَ الثِيا","بِ مِنهُمُ وَالأَردِيَه",3,"ي",2,0],["وخسر خبر محذوف وبالنّ","صب على الذَمّ ووزن فاعلِ",4,"ل",1,0],["وخسرت إذ باعت","بَاقِيَها بالفاني",5,"ن",2,0],["وخسفُها والبسُط والجمعُ على","حكم الذي ضارعها فيما خلا",6,"ل",2,0],["وخسرنا جهاد عشرين عاما","بك فيها الأيام كادت تدول",7,"ل",1,0],["وخسارة محمولةٌ في مرة","يأتي لها عوض بدور ثان",8,"ن",1,0],["وخسرت فيك خسارتي","ن، وخلت أني أكسب",9,"ب",1,0],["وَخسرتُ بَينَ الخازنين حَياةَ من","دَعمت عماد المَجد فيَّ يَمينهُ",10,"ن",2,0],["وخسرنا يا ابنتي العزَّ القديمْ","فغدونا عرضةً للخطرِ",11,"ر",1,0],["وَخَسِرْتُمْ مَجْدَ أسلافِكُمُ يا خاسرونْ","قُمْ صَلاحَ الدينِ فَالأَقْصَى يُقاسي شرَّ هُونْ",12,"ن",1,0],["وَخَسِرْتُ آلاْفَ الْغَوَاْنِيْ بَعْدَمَاْ","جَاْبَهْتُ فِيْ بَحْرِ الْغَرَاْمِ اللُّوَّمَاْ",13,"م",2,0],["وخسيس أودت به وبأوطا","ن وأهل أغراض نفس خسيسه",14,"س",2,0],["وخستهم تقطّع منك روحي","فتهوي منهكا وأنا الضريح",15,"ح",1,0],["وخستهم جرت مجرى هواهم","وقد ملأت جوانحهم خرابا",16,"ب",2,0],["وخساراتٌ لم تزلْ في ازديادٍ","وانشطارٌ مروّعٌ وانهيارُ",17,"ر",1,0],["وخسران من زاد سياته بجواله","وخسران من قال قول يقل مقداره",18,"ر",2,0],["وخسران من قال ما يخطر على باله","وخسران من ضاق صدره يكتم أسراره",18,"ر",2,0],["وخسرتم محبة الشعب ذخراً","كان حرزاً لكم وحصناً حصينا",19,"ن",2,0],["وَخَسِرْتَ حَرْبَ الأُمْنِيَاتِ وَخِلْتَهَا","مِنْ كَثْرَةِ الأَوْهَامِ فِيكَ فُتُوحَا",20,"ح",2,0],["وخسَارَةُ العُشَّاقِ أعظَمُ قِصَّةٍ","كانُوا بحُزنِ سطُورِهَا مَا كانوا",21,"ن",3,0]]}