m/ViewPoem.aspx?id=212221",""],[5186,"تلك الخمائل ما تمايل بأنها","https://www.poetsgate.com/ViewPoem.aspx?id=156464",""],[5200,"ما أملح التفاح فى الهدايا","https://www.poetsgate.com/ViewPoem.aspx?id=200815",""],[5224,"يا أملي وبغيتي ليس هواي في سواك","https://www.poetsgate.com/ViewPoem.aspx?id=121302",""],[5230,"دهاء معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=10997",""],[5277,"يا ممطل الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=191087",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5458,"الغدفة","https://www.poetsgate.com/ViewPoem.aspx?id=113375",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5542,"قراءة متأنية في سجل التطرف","https://www.poetsgate.com/ViewPoem.aspx?id=10031",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[1214,"مَنْ مُجيري مِنْ عُلَيَّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=115278",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[5956,"مات الرفاق","https://www.poetsgate.com/ViewPoem.aspx?id=183964",""],[6093,"إلا الخروج","https://www.poetsgate.com/ViewPoem.aspx?id=191466",""],[520,"شغل الزمان بما تقول وتفعل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577611",""],[2220,"نحنُ حزبُ اللهِ من يلحقنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11806&r=&rc=676",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""]],"verses":[["ما أَمتَعَ الآمالَ لَولا أَنَّها","تَعتاقُ دونَ بُلوغِها الآجالُ",0,"ل",1,0],["ما أملح مه فصل الربيع","ذا بدت أمّ الحسن",1,"ن",1,1],["ما امتاز قطّ عن ابن آ","وى شخصه بسوى ثيابه",2,"ب",2,0],["ما آمنتْ نفسُ من رجاك بما","أنزل ربُّ السماءِ في السور",3,"ر",1,0],["ما أُمَّكَ اجتاحتِ المنايا","كل فُؤادٍ عليكَ أُمُّ",4,"م",1,0],["ما امْتَنَعَ الدَّمْعُ وإِسْبالُهُ","عَلَيَّ لَمّا امْتَنَعَ المَطْلَبُ",5,"ب",1,0],["ما أَمَلي فيكَ بِالضَعيفِ وَلا","ظَنِّيَ في نُجحِهِ بِمَكذوبِ",6,"ب",1,0],["ما أُمُّ خِشفٍ بِرَوضاتِ الذِهابِ لَها","مَرعى فَرودٍ مِنَ الأُلّافِ مِطفالِ",7,"ل",1,0],["ما أَمكَنَ القَولُ بِالصَوابِ فَقُل","وَاِحذَر إِذا قُلتَ مَوضِعَ الضَرَرِ",8,"ر",1,0],["ما أَمَّتِ العَينُ مِنهُ ناحِيَةً","إِلّا أَقامَت مِنهُ عَلى حَسَنِ",9,"ن",1,0],["ما أُمُّ دَفرٍ أُمُّ طيبٍ وَلَو","أَنَّكَ بِالعَنبَرِ ضَمَّختَها",10,"ت",3,0],["ما أُمٌّ لَيلاكِ العَتيقَةُ بَرَّةٌ","كَنَّيتِها لِلقَومِ أَو سَمَّيتِها",11,"ت",3,0],["ما أُمُّ سِرياحٍ إِذا ما غَدَت","مُوَرِّثَتي أَدمُعَ دَرّاجِ",12,"ج",1,0],["ما أُمُّ دَفرٍ في الحَياةِ مَروَعَةٌ","بِطَلاقِ ذي شَرَفٍ وَلا بِظِهارِ",13,"ر",1,0],["ما أَمِنَت هَذِهِ الثُرَيّا","أَن يَتَرامى بِها النُزولُ",14,"ل",1,0],["ما أَمسِ بِالشَبَحِ الَّذي إِن مَرَّ بي","فَرُجوعُهُ مِن بَعدِ ذَلِكَ مُمكِنُ",15,"ن",1,1],["ما امرُؤ القَيسِ بالمُصَلّي إذا جا","راهُ في الشعر بل سُكَيْتُ الرّهانِ",16,"ن",1,0],["ما أمجدَ الحبَّ وما أروعا","إذا تحدَّى العاشقان الخطرْ",17,"ر",1,0],["مَا أَمَّ مَشْرَعَ جَاهِهِ أَوْ مَالِهِ","قَمِنٌ بِتَحْقِيقِ الرَّجَاءِ فَخَابَا",18,"ب",2,0],["مَا أَمْهَلَتْكَ يَدُ المَنِيَّةِ","رَيْثَمَا يُجْنى جَنَاكْ",19,"ك",1,0],["مَا أَمْهَلَتْ حَتَّى نَرَا","كَ كَمَا وَدِدْنَا أَنْ نَرَاكْ",19,"ك",1,0],["ما أَمَرَّها حُرقاً","في الحَشا كَأَفجَرِها",20,"ر",3,0],["ما أَم ساحة جودِهِ","ذو محنة إِلّا مَنَح",21,"ح",1,0],["ما أم سدة بابهم عاني الشقا","إلا وصيره الإله سعيدا",22,"د",2,0],["ما أمَّ ساحتَه مُقوٍ ألمَّ به","إلاّ وفاءَ برزقٍ منه مضمونِ",23,"ن",1,0],["ما أَمَّ يحرَك آملٌ يرجو ندىً","إلا وفاء بما يُرَجِّى الآمِلُ",24,"ل",1,0],["ما أَمَّ قَفراً لَم تَجَفَّل أَسدُهُ","فَرَقاً كَما جَفَلَت بِهِ ظِلمانُهُ",25,"ن",2,0],["ما أمَّ أرضك رائحاً ومبكراً","متقلل فرجعته متمولا",26,"ل",2,0],["ما أمطر الأرض ريَّاً تحت رايته","دمّ الجماجم برق الصارم الخدم",27,"م",1,0],["ما أمِنَّا الزمانَ إلا كما يأ","منُ إبليسَ زاهدُ الزهادِ",28,"د",1,0],["ما أمرَّ الخروج من بلدة في","ها حبيبي وما ألذَّ القدوما",29,"م",2,0],["ما أمركم أخبروني","في الحب تهت وتهتم",30,"م",1,0],["ما أمركم ما هواكم قد بليت بكم","بلوى الظماء بنهرٍ غير مورود",31,"د",1,0],["ما أَمَروا بِطاعَةٍ","وَلا نَهَوا عَن مَعصِيَه",32,"ي",2,0],["ما اِمتَطى راحَةً يَراعٌ وما خَط","طَت يَمينٌ رَقشاً عَلى قِرطاسِ",33,"س",1,0],["ما أمهرتها فكرتي","لسواك إلا بالطلاق",34,"ق",1,0],["ما أمه الراجون إلا أبصروا","ما جل عن أبصارهم والمسمع",35,"ع",1,0],["ما أَمَّ جَيشاً وَلا اِنتَحى بَلَداً","إِلّا اِنثَنى بِالتَأييدِ وَالنَصرِ",36,"ر",1,0],["ما أَمَّهُ في دَهرِنا مِن قاصِدٍ","فَشَدَّ عَنساً بَعدَها لِقَصدِ",37,"د",1,0],["ما أَمُُّ غُفرِ عَلى دَعجاءَ ذي عَلَقٍ","يَنفي القَراميدَ عَنها الأَعصَمُ الوَقِلُ",38,"ل",1,0],["ما أمَّ ذو أملٍ حِمى اِبن عروسِ","إلّا اِجتلى الأملَ اِجتلاء عروسِ",39,"س",1,1],["ما آمن الواشي بآيةِ صَبْوَتي","حتَّى رأى دمعي بحبّك مرسلا",40,"ل",2,0],["ما أمَّ فضلَك مستفيدٌ في الورى","إلاَّ استفاد فضيلةً وأفادا",41,"د",2,0],["ما امتطَيْنا أُخْتَ السحائِبِ إِلا","لتُوافي بنا أَخا الأَمطارِ",42,"ر",1,0],["ما أَمالَ الريحُ عِطْفَيْ","غُصُن الريحِ القويمِ",43,"م",1,0],["ما أم ذو أمل نداكم قاصداً","إلا وتشكر سعيه الفيغاء",44,"ا",2,0],["ما أملك الميل عنكم","يا مالكين قيادي",45,"د",2,0],["ما أمُّ أولادٍ كثيرٍ في العددْ","تُروِي رِضاعاً وهي بِكرٌ لم تلدْ",46,"د",1,1],["ما أَمِنَ الذَمَّ خَلفَهُ أَحَدٌ","إِن لَم يَكُن مِن وَراهُ يَحمَدُهُ",47,"د",2,0],["مَا أَمدَحُ وَاهِبَاً سِواهُ أبَدا","لا أُشرِكُ في ثَناءِ ربي أَحَدَا",48,"د",2,0],["ما امتد ظل الأمن فوق رواقها","إلا وتاجك بالفنا يتظلل",49,"ل",1,0],["ما أمَّ قط عُصاةً في تَمَرُّدِهِم","إلا وبدَّدهُم في السَّهلِ والجَبلِ",50,"ل",1,0],["ما أَمسكَتْ يوم الوغى","إلّا ظُباها أوْ قَناها",51,"ا",3,0],["ما آمنوا بالغيب حتى على","قلوبهم فيض التجلي يسوح",52,"ح",1,0],["ما أُمِنَتْ منه سُطاهُ على","أَمينهِ الماضي ومأَمونهِ",53,"ن",2,0],["ما أم مكروب الهموم رحابه","الا عن المكروب وقرا خففا",54,"ف",2,0],["ما أمها أحد لجني زهورها","إلا وكان لها شذاها قائدا",55,"د",2,0],["ما أمّ يومَ الوَغى زَحفاً بِرايتِهِ","إلاَّ تضعضع ثمّ انصاع مُنهَزِما",56,"م",2,1],["ما أمَّنِي سَحَراً بالطيب يَنشرُهُ","إلاّ أتانِي الدُّجى في حسن مستَتِرِ",57,"ر",1,0],["ما أمَّهُ طالبٌ إلاّ وشاطرَهُ","في قوتِهِ دائماً دَعْ ناجِباً وكَسَا",58,"س",2,0],["ما أمْلَحَ الفُرسانَ لَوْ لَمْ يَكُنْ","خَصْلُهُمُ قَلْبي وفِيهِ الرِّهانْ",59,"ن",1,0],["ما أمت الوفاد ربعاً من عناً","إلا وقد ملأ السرور إهابها",60,"ب",3,0],["ما أمّني العافونَ الا عاينُوا","بِشراً بوجهي واخضلالاً في يدِي",61,"د",2,0],["ما امتد للصبح باع الشرق فاعتنقا","أو حنّ نحو لقاء الإلف نازحه",62,"ح",2,0],["ما أمرَّ الهوى إذا كان حلْواً","عند مثلي فكيف إِنْ كان مُرّا",63,"ر",2,0],["ما أمَّكمْ مسْتنقصُ الزيادَهْ","إلا وصار بالغا مرادهْ",64,"د",2,0],["ما أَمكَنَت فُرصَةُ الإِمكانِ ذا أَرَبٍ","فَمالَ عَنها لِتَسويفٍ وَتأخِيرِ",65,"ر",1,0],["ما أم صفا إلى قتال","إلا له أدبر المعادي",66,"د",2,0],["مَا أمّ صَفَّا لِلْقِتَالِ سِنَانُهُ","إلاَّ وَنَادَى أيْنَ يَا بَاغِي الْمَفَرَ",67,"ر",1,0],["ما اِمتَدَّ مِنها عَلى أَرجائِهِ ذَهَبٌ","إِلّا تَحَدَّرَ مِن حافّاتِهِ وَرَقُ",68,"ق",1,0],["ما امَّ بابك شاعرٌ","امسى لمدحك منشدا",69,"د",2,0],["ما أمّت الوجناء في راحولها","منه أبرّ مواثقاً ومقالا",70,"ل",2,0],["ما امّ روضة حلمه الزاهي فتى","الاّ اجتنى ما يبتغي ويريدُ",71,"د",1,0],["ما امّ نداه فتىً الاَّ","وحظي بالغوث وبالمددِ",72,"د",1,0],["ما امّ ساحة فضلهِ من قاصدٍ","يرجو بان يحظى بنعم بشارَهْ",73,"ر",2,0],["ما أمه الركب إلا عاد منتجعاً","فما رأينا امتناناً في عطاياه",74,"ا",2,0],["ما أمك الرجون إلا أدركوا","من فيض جودك والعطا ما راموا",75,"م",3,0],["ما أَميَلَ النَفسَ إِلى الباطِلِ","وَأَهوَنَ الدُنيا عَلى العاقِلِ",76,"ل",1,1],["ما أَمَةٌ تَملِكُها","أَو حُرَّةٌ بِطاهِرَه",77,"ر",2,0],["ما أَمين الحُب نادى مُنشِداً","يا خَليلي في الهَوى دَع ذكر مَي",78,"ي",1,0],["ما أَمين الحُب نادى","هَيَّمَتني تَيَّمتني",79,"ن",2,0],["ما أَم وجهة بيت الله معتمر","يمحو بخطو مطاياه خطاياه",80,"ا",2,0],["مَا أَمَّلَ القَوْمُ العُتَاةُ خَلاَصَهُمْ","إِلاَّ وَعَاجَلَهُمْ بِغَيْرِ خَلاَصِ",81,"ص",1,0],["ما أم علياه في خطب مؤملّه","إلا وأعطاه ما أربى على الأمل",82,"ل",1,0],["ما أم كفك معتفٍ أو رادها","إلا جعلت عناءه أورادها",83,"د",3,0],["ما أملوا فيها وقالوا كن يكن","أمر ورب العالمين عجاب",84,"ب",1,0],["ما أملح الدن