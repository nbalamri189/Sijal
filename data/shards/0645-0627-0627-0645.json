{"poems":[[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[85,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[90,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[58,"مات حبيب فمات ليث","https://www.aldiwan.net/poem58517.html","مخلع البسيط"],[58,"نديم عيني بعدك الكوكب","https://www.aldiwan.net/poem58652.html","السريع"],[47,"كم من حنين إليك مجلوب","https://www.aldiwan.net/poem11046.html","المنسرح"],[30,"كم للملاءة من أطلال منزلة","https://www.aldiwan.net/poem5379.html","البسيط"],[51,"ما للفتى مانع من القدر","https://www.aldiwan.net/poem62070.html","الكامل"],[50,"لا تبك للذاهبين في الظعن","https://www.aldiwan.net/poem65299.html","المنسرح"],[48,"لا أخطب الدنيا إلى مالك الدن","https://www.aldiwan.net/poem22180.html","السريع"],[48,"كفي شموسك فالسرار أمانة","https://www.aldiwan.net/poem22216.html","الكامل"],[48,"حالي حال اليائس الراجي","https://www.aldiwan.net/poem22270.html","السريع"],[48,"الشيب أزهار الشباب فما له","https://www.aldiwan.net/poem22705.html","الكامل"],[48,"ما أطيب العيش عند قوم","https://www.aldiwan.net/poem23138.html","مجزوء البسيط"],[48,"ما أمس بالشبح الذي إن مر بي","https://www.aldiwan.net/poem23459.html","الكامل"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[112,"حتام في ليل الهموم","https://www.aldiwan.net/poem16731.html","مجزوء الكامل"],[118,"سبقوا البرية طارفا وتليدا","https://www.aldiwan.net/poem41963.html","الكامل"],[131,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[131,"أبلعرب الملك الهمام العادل","https://www.aldiwan.net/poem50543.html","الكامل"],[146,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[153,"حمل الفؤاد على الهوى وتحملا","https://www.aldiwan.net/poem68463.html","الكامل"],[153,"لم تبق معلوة إلا خصصت بها","https://www.aldiwan.net/poem68465.html","البسيط"],[202,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[207,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[214,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[214,"يا ليلة العيد ماذا أنت صانعة","https://www.aldiwan.net/poem46320.html","البسيط"],[238,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[238,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[264,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[264,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[285,"يا ذا العذار الذي به عذري","https://www.aldiwan.net/poem32766.html","المنسرح"],[285,"من مبلغ نجدا ومن بنجد","https://www.aldiwan.net/poem32810.html","الرجز"],[303,"شط المزار بجدوى وانتهى الأمل","https://www.aldiwan.net/poem45468.html","البسيط"],[308,"ما أم ذو أمل حمى ابن عروس","https://www.aldiwan.net/poem56501.html","الكامل"],[419,"ما ودع الصب المشوق وما قلى","https://www.aldiwan.net/poem53997.html","الكامل"],[419,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[435,"سفرت عنك أوجه الأسفار","https://www.aldiwan.net/poem12416.html","الخفيف"],[435,"أندى وجه وسيم","https://www.aldiwan.net/poem12425.html","مجزوء الرمل"],[440,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[450,"سقى ملث الغوادي","https://www.aldiwan.net/poem53731.html","المجتث"],[460,"ما أم أولاد كثير في العدد","https://www.aldiwan.net/poem56210.html","الرجز"],[470,"لا ترد البخل ما حييت فما","https://www.aldiwan.net/poem60187.html","المنسرح"],[506,"الحمد لمن أنار قلبي وهدى","https://www.aldiwan.net/poem38393.html","عموديه"],[517,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[540,"مثل التهامي ما في الأرض من بطل","https://www.aldiwan.net/poem47989.html","عموديه"],[553,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[560,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[577,"ما أخشن الدهر على لينه","https://www.aldiwan.net/poem2772.html","السريع"]],"verses":[["ما أَمتَعَ الآمالَ لَولا أَنَّها","تَعتاقُ دونَ بُلوغِها الآجالُ",0,"ل",1,0],["ما أملح مه فصل الربيع","ذا بدت أمّ الحسن",1,"ن",1,1],["ما امتاز قطّ عن ابن آ","وى شخصه بسوى ثيابه",2,"ب",2,0],["ما آمنتْ نفسُ من رجاك بما","أنزل ربُّ السماءِ في السور",3,"ر",1,0],["ما أُمَّكَ اجتاحتِ المنايا","كل فُؤادٍ عليكَ أُمُّ",4,"م",1,0],["ما امْتَنَعَ الدَّمْعُ وإِسْبالُهُ","عَلَيَّ لَمّا امْتَنَعَ المَطْلَبُ",5,"ب",1,0],["ما أَمَلي فيكَ بِالضَعيفِ وَلا","ظَنِّيَ في نُجحِهِ بِمَكذوبِ",6,"ب",1,0],["ما أُمُّ خِشفٍ بِرَوضاتِ الذِهابِ لَها","مَرعى فَرودٍ مِنَ الأُلّافِ مِطفالِ",7,"ل",1,0],["ما أَمكَنَ القَولُ بِالصَوابِ فَقُل","وَاِحذَر إِذا قُلتَ مَوضِعَ الضَرَرِ",8,"ر",1,0],["ما أَمَّتِ العَينُ مِنهُ ناحِيَةً","إِلّا أَقامَت مِنهُ عَلى حَسَنِ",9,"ن",1,0],["ما أُمُّ دَفرٍ أُمُّ طيبٍ وَلَو","أَنَّكَ بِالعَنبَرِ ضَمَّختَها",10,"ت",3,0],["ما أُمٌّ لَيلاكِ العَتيقَةُ بَرَّةٌ","كَنَّيتِها لِلقَومِ أَو سَمَّيتِها",11,"ت",3,0],["ما أُمُّ سِرياحٍ إِذا ما غَدَت","مُوَرِّثَتي أَدمُعَ دَرّاجِ",12,"ج",1,0],["ما أُمُّ دَفرٍ في الحَياةِ مَروَعَةٌ","بِطَلاقِ ذي شَرَفٍ وَلا بِظِهارِ",13,"ر",1,0],["ما أَمِنَت هَذِهِ الثُرَيّا","أَن يَتَرامى بِها النُزولُ",14,"ل",1,0],["ما أَمسِ بِالشَبَحِ الَّذي إِن مَرَّ بي","فَرُجوعُهُ مِن بَعدِ ذَلِكَ مُمكِنُ",15,"ن",1,1],["ما امرُؤ القَيسِ بالمُصَلّي إذا جا","راهُ في الشعر بل سُكَيْتُ الرّهانِ",16,"ن",1,0],["ما أمجدَ الحبَّ وما أروعا","إذا تحدَّى العاشقان الخطرْ",17,"ر",1,0],["مَا أَمَّ مَشْرَعَ جَاهِهِ أَوْ مَالِهِ","قَمِنٌ بِتَحْقِيقِ الرَّجَاءِ فَخَابَا",18,"ب",2,0],["مَا أَمْهَلَتْكَ يَدُ المَنِيَّةِ","رَيْثَمَا يُجْنى جَنَاكْ",19,"ك",1,0],["مَا أَمْهَلَتْ حَتَّى نَرَا","كَ كَمَا وَدِدْنَا أَنْ نَرَاكْ",19,"ك",1,0],["ما أَمَرَّها حُرقاً","في الحَشا كَأَفجَرِها",20,"ر",3,0],["ما أَم ساحة جودِهِ","ذو محنة إِلّا مَنَح",21,"ح",1,0],["ما أم سدة بابهم عاني الشقا","إلا وصيره الإله سعيدا",22,"د",2,0],["ما أمَّ ساحتَه مُقوٍ ألمَّ به","إلاّ وفاءَ برزقٍ منه مضمونِ",23,"ن",1,0],["ما أَمَّ يحرَك آملٌ يرجو ندىً","إلا وفاء بما يُرَجِّى الآمِلُ",24,"ل",1,0],["ما أَمَّ قَفراً لَم تَجَفَّل أَسدُهُ","فَرَقاً كَما جَفَلَت بِهِ ظِلمانُهُ",25,"ن",2,0],["ما أمَّ أرضك رائحاً ومبكراً","متقلل فرجعته متمولا",26,"ل",2,0],["ما أمطر الأرض ريَّاً تحت رايته","دمّ الجماجم برق الصارم الخدم",27,"م",1,0],["ما أمِنَّا الزمانَ إلا كما يأ","منُ إبليسَ زاهدُ الزهادِ",28,"د",1,0],["ما أمرَّ الخروج من بلدة في","ها حبيبي وما ألذَّ القدوما",29,"م",2,0],["ما أمركم أخبروني","في الحب تهت وتهتم",30,"م",1,0],["ما أمركم ما هواكم قد بليت بكم","بلوى الظماء بنهرٍ غير مورود",31,"د",1,0],["ما أَمَروا بِطاعَةٍ","وَلا نَهَوا عَن مَعصِيَه",32,"ي",2,0],["ما اِمتَطى راحَةً يَراعٌ وما خَط","طَت يَمينٌ رَقشاً عَلى قِرطاسِ",33,"س",1,0],["ما أمهرتها فكرتي","لسواك إلا بالطلاق",34,"ق",1,0],["ما أمه الراجون إلا أبصروا","ما جل عن أبصارهم والمسمع",35,"ع",1,0],["ما أَمَّ جَيشاً وَلا اِنتَحى بَلَداً","إِلّا اِنثَنى بِالتَأييدِ وَالنَصرِ",36,"ر",1,0],["ما أَمَّهُ في دَهرِنا مِن قاصِدٍ","فَشَدَّ عَنساً بَعدَها لِقَصدِ",37,"د",1,0],["ما أَمُُّ غُفرِ عَلى دَعجاءَ ذي عَلَقٍ","يَنفي القَراميدَ عَنها الأَعصَمُ الوَقِلُ",38,"ل",1,0],["ما أمَّ ذو أملٍ حِمى اِبن عروسِ","إلّا اِجتلى الأملَ اِجتلاء عروسِ",39,"س",1,1],["ما آمن الواشي بآيةِ صَبْوَتي","حتَّى رأى دمعي بحبّك مرسلا",40,"ل",2,0],["ما أمَّ فضلَك مستفيدٌ في الورى","إلاَّ استفاد فضيلةً وأفادا",41,"د",2,0],["ما امتطَيْنا أُخْتَ السحائِبِ إِلا","لتُوافي بنا أَخا الأَمطارِ",42,"ر",1,0],["ما أَمالَ الريحُ عِطْفَيْ","غُصُن الريحِ القويمِ",43,"م",1,0],["ما أم ذو أمل نداكم قاصداً","إلا وتشكر سعيه الفيغاء",44,"ا",2,0],["ما أملك الميل عنكم","يا مالكين قيادي",45,"د",2,0],["ما أمُّ أولادٍ كثيرٍ في العددْ","تُروِي رِضاعاً وهي بِكرٌ لم تلدْ",46,"د",1,1],["ما أَمِنَ الذَمَّ خَلفَهُ أَحَدٌ","إِن لَم يَكُن مِن وَراهُ يَحمَدُهُ",47,"د",2,0],["مَا أَمدَحُ وَاهِبَاً سِواهُ أبَدا","لا أُشرِكُ في ثَناءِ ربي أَحَدَا",48,"د",2,0],["ما امتد ظل الأمن فوق رواقها","إلا وتاجك بالفنا يتظلل",49,"ل",1,0],["ما أمَّ قط عُصاةً في تَمَرُّدِهِم","إلا وبدَّدهُم في السَّهلِ والجَبلِ",50,"ل",1,0],["ما أَمسكَتْ يوم الوغى","إلّا ظُباها أوْ قَناها",51,"ا",3,0],["ما آمنوا بالغيب حتى على","قلوبهم فيض التجلي يسوح",52,"ح",1,0],["ما أُمِنَتْ منه سُطاهُ على","أَمينهِ الماضي ومأَمونهِ",53,"ن",2,0]]}