//www.poetsgate.com/ViewPoem.aspx?id=198279",""],[4857,"الإنتفاضة","https://www.poetsgate.com/ViewPoem.aspx?id=30117",""],[4907,"يا ساحر الطرف يا من مهجتي سحراً","https://www.poetsgate.com/ViewPoem.aspx?id=127122",""],[2177,"خليلي خلتكما تحسدان","https://www.poetsgate.com/ViewPoem.aspx?id=127094",""],[5039,"نجد واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=48112",""],[5050,"مقام في القصور على قصور","https://www.poetsgate.com/ViewPoem.aspx?id=38189",""],[585,"ماذا الجمود وجرعاء الديار دم","https://www.poetsgate.com/ViewPoem.aspx?id=161903",""],[5273,"عانس","https://www.poetsgate.com/ViewPoem.aspx?id=180576",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5431,"حبكِ ثابتي حاءٌ...وباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=183467",""],[5512,"شجون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=204171",""],[5526,"الياس","https://www.poetsgate.com/ViewPoem.aspx?id=192390",""],[5543,"ضجيعي في ليلى جوىً ونحيب","https://www.poetsgate.com/ViewPoem.aspx?id=181704",""],[5616,"نُقوشٌ إسلاميَّةٌ على الحَجرِ الفِلَسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205253",""],[5830,"يَاقُدْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=200771",""],[5897,"رمضان يستعيد الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=156849",""],[5909,"ألحبُ أقوى أم وعاء الدجلِ","https://www.poetsgate.com/ViewPoem.aspx?id=210576",""],[5943,"إلى من رخصت نفسها فخسرتها","https://www.poetsgate.com/ViewPoem.aspx?id=61959",""],[6069,"وجائلة الوشاح تريك وجهاً","https://www.poetsgate.com/ViewPoem.aspx?id=105707",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[6193,"ألا لا يعيب المجد والفضل إقلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55438&r=&rc=14",""],[463,"إذا فاتها روضُ الحمى وجنوبهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59984&r=&rc=40",""],[2638,"دنيا الأذكياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87840&r=&rc=4",""]],"verses":[["وَكَم جاوَزَت مِن رَملَةٍ ثُمَّ عاقِرٍ","وَأُخرى يَضُفُّ الرَوضُ فيها الغَوادِيا",0,"ي",2,0],["وَكَم جَفَّ دَمعٌ فيكَ قَد كانَ غَربُهُ","بَطيئاً إِذا ما ريمَ لَم يَتَسَرَّعِ",1,"ع",1,0],["وَكَم جَهدِ نائِبَةٍ قَد لَقيتُ","لِأَجلِكِ يا بِنتَ عَمّي وَنَكبَه",2,"ب",2,0],["وَكَم جُيوشٍ لَقَد فَرَّقتُها فِرَق","وَعارِضُ الحَتفِ مِثلُ العارِضِ الهَطِلِ",3,"ل",1,0],["وَكَمْ جَمَعَتْ يُمْنَاكَ بَعْدَ افْتِرَاقِهَا","خَصيمَيْ نِجَارٍ مِنْ يَرَاعِ وَلَهْذَمِ",4,"م",1,0],["وَكَم جَريحٍ باسِطٍ كَفَّهُ","يَدعو أَخاهُ وَهوَ لا يُبصِرُ",5,"ر",1,0],["وَكَم جاوَزَت مِن رَملَةٍ بعد رملة","وَصَحراءَ خَوقاءِ المَسافَةِ هَوجَلِ",6,"ل",1,0],["وكم جال طِرْفُ الطَّرف في روض حسنه","يقيده فيه العِذارُ بسندسِ",7,"س",1,0],["وكم جَنَّبَتْني عزّة النفس مَنهَلاً","يطيب به لكن مع الذُل مَوْرد",8,"د",1,0],["وكم جربت منكَ الملوكُ ميامناً","ونصحاً على فقد الميامن والنصح",9,"ح",1,0],["وكم جاز فرط الحزن للمرء لم يفد","فما بالنا لا نستفيد ونأثم",10,"م",1,0],["وكم جَاهَرتْه وقالت له","تَغَافل كأنَك في مَرْعش",11,"ش",1,0],["وكم جاهلٍ قد أبدأ الجهلَ مرةً","فقلت أعدْهُ إنني عائدُ الحلمِ",12,"م",1,1],["وَكَم جاءَت لَنا عَنكُم","أَحاديثٌ رَدَدناها",13,"ا",3,0],["وكم جنيت جهرة","من لذة لم تدم",14,"م",1,0],["وَكَم جَمَعَتهُمو حَربٌ فَكانوا","حَدائِدَها وَكانَ هُوَ الحُساما",15,"م",2,0],["وَكَم جاءَتِ الأَيامُ رَسلاً تَقودُني","إِلى نائِلٍ مِن راحَتَيكَ مُعادِ",16,"د",1,0],["وَكَم جاءَني عَنكَ مِن مَنطِقٍ","يَكادُ الحَليمُ لَهُ يَجهَلُ",17,"ل",1,0],["وَكَم جَريءٍ عَلى عِنادِكَ قَد","عادَ هُزالاً في مَتنِهِ سِمَنُه",18,"ن",2,0],["وَكَم جَعَلَت مِنّي عَلَيَّ طَليعَةً","فَعَيني لَها في ذاكَ عَينٌ عَلى قَلبي",19,"ب",2,0],["وَكَم جَرَّبتُ قَبلَكَ مِن مَليحٍ","فَأَمسى جيدُ حالِيَ مِنهُ حالي",20,"ل",2,0],["وَكَم جَبَلٍ بِالبَذِّ مِنهُم هَدَدتَهُ","وَغاوٍ غَوى حَلَّمتَهُ لَو تَحَلَّما",21,"م",2,0],["وَكَم جَولَةٍ لا يُحسِنُ البَغلُ مِثلَها","أَتَت عَجَلاً لَم يَجنِ مَكروهَها جانِ",22,"ن",1,1],["وَكَم جاوَزَ الحَقَّ في مُشرَفٍ","فَعُدَّ شَحيحاً وَبارى الرِياحا",23,"ح",2,0],["وكم جَاوَزَ الإِبْدَاعُ في الحُسْنِ حَدَّهُ","فَأَوْهَمَنا أَنَّ الحَقيقَةَ زُورُ",24,"ر",1,0],["وَكَمْ جَعَلَ الْفَقِيهُ الْعَدْلَ ظُلْماً","وَصَيَّرَ بَاطِلاً حَقَّاً مُبِينا",25,"ن",2,0],["وكم جَحفلٍ مَجْرٍ قرعتَ صَفاتَهُ","بصاعقَةٍ يَصْلى بها وهي جاحم",26,"م",1,0],["وَكَم جَميلٍ حَطَّهُ بِرَغمِهِ","وَقَد سَقاهُ عَلَلاً مِن شَمِّهِ",27,"م",2,0],["وَكَم جاوَزَت مِن ظَهرِ أَرعَنَ شاخِصٍ","وَمِن بَطنِ وادٍ جَوفُهُ مُتَصَوِّبُ",28,"ب",1,0],["وَكَم جَنَت المَعاصِمُ مِن مَعاصٍ","تَعودُ بِها المَعاضِدُ مُعصِماتِ",29,"ت",1,0],["وَكَم جَمَعَ النَفائِسَ رَبُّ مالٍ","فَلَمّا جَدَّ مُرتَحِلاً ذَراها",30,"ا",3,0],["وَكَم جَريح طَريح","لا يَستَطيع قياما",31,"م",2,0],["وكم جبل هبطتَ برأس وادٍ","يعزُّ الجنَّ أن ترقَى سنامهْ",32,"م",2,0],["وكم جِئْتِهِ بأرقِّ الغناءِ","وأشرقتِ فيه بوحيِ السماءْ",33,"ا",2,0],["وكم جُبْتُ أرضاً ما انْتَعَلْتُ بمَرْوِها","وجاوَزْتُ أُخرَى ما شَددتُ لها شِسْعي",34,"ع",2,0],["وكم جلاها في اليماني المسبل","من قبلت منه ومن لم تقْبَلِ",35,"ل",1,0],["وَكَم جُيوشٍ لَقَد فَرَّقتُها فِرَقاً","وَعارِضُ الحَتفِ مِثلُ العارِضِ الهَطِلِ",36,"ل",1,0],["وَكَمْ جَمَاعَةٍ وَكَمْ نِقَابَةٍ","أُلْتَ بِهَا مَرَافِقَ العِبَادِ",37,"د",1,0],["وكم جرَتِ الدّماءُ ، لها هَديرٌ","على حبَّاتِه وبها نزيف",38,"ف",1,0],["وَكَمْ جُرِّعَتْ مِنْ صَبْرِهَا كَأْس حَنْظَلِ","وَكَمْ نَالَهَا صَرْفٌ مِنْ الدَّهْرِ مُبْتَلي",39,"ي",1,0],["وكَمْ جاوزَتْ بحْراً ولَيْلاً، يخُضْنهُ","إلَيْكَ أميرَ المؤمنينَ ومِن سَهْبِ",40,"ب",1,0],["وكم جَمَعَتْهُمُ حربٌ، فكانوا","حدائدها ، وكان هو الحسما",41,"م",2,0],["وكم جازيت عن شرّ بخير","وكم جازاك بالغدر الأنام",42,"م",1,0],["وكم جهولٌ لجا في باب دولته","بعد الشقاوة أضحى من ذوي الحكم",43,"م",1,0],["وَكَم جِيدِ رَقٍّ كَانَ قَبلِى مُعَطَّلاً","فَحَلاَّهُ بِالعِقيَانِ خَطُّ بَنَاني",44,"ن",2,0],["وكَم جَابُوا التَّنَائِفَ فَوقَ نُوقٍ","يَحَاكِى عَدوُهَا عَدوَ الرِّئَالِ",45,"ل",1,0],["وَكَم جاهِلٍ أَغرى بِمَجدِكَ كَيدُهُ","وَلَكِنَّهُ أَودى وَما كانَ ما وَدّا",46,"د",2,0],["وَكَم جَدَّ مُجتَهِدٌ في طِلابِ","عُلاكَ فَلَم يَكتَحِل بِالأَثَر",47,"ر",1,0],["وَكَم جاوَزتَ في طَلَبِ المَعالي","طَريقاً ما وَجَدتَ بِهِ رَفيقا",48,"ق",2,0],["وكم جبرا بجاهٍ أو بمال","خروقاً من مساعيك القباح",49,"ح",1,0],["وكم جاهل عد الحصون معاقلا","يرد بها عن نفسه الإِنس والجنا",50,"ن",2,0],["وَكَم جُبتُ مِن مَجهولَةٍ وَمُشَيِّعي","بِها قَلبُ مَأثورٍ وَشَيخانُ آفِقُ",51,"ق",1,0],["وَكَم جُبتُ مِن مَوماةِ أَرضٍ تَرى بِها","مَعَ الآلِ حَقَّ العَينِ وَالأُذنِ باطِلا",52,"ل",2,0],["وَكَم جُبتُ مِن خَرقا تَمُوتُ بِها الظِبا","بِهِمَّةِ مَضّاءٍ عَلى الهَولِ حازِمِ",53,"م",1,0],["وَكَم جُبتُ مِن خَرقا تَمُوتُ بِها الظِبا","بِعَزمَةٍ مَضّاءٍ عَلى الهَولِ حازِمِ",54,"م",1,0],["وَكَم جاهَدوا في البحرِ والبرِّ أُمّةً","وَمِن لَحمها قد أشبعوا الحوتَ والنسرا",55,"ر",2,0],["وكم جهولٍ تراه مشترياً","سرور وقتٍ بغمِّ أوقاتِ",56,"ت",1,0],["وكم جئت صفر الكف بابك قبلها","فعادت بدي ملأى من البيض والصفر",57,"ر",1,0],["وكم جرع الأبطال نجلك في الوغى","كؤوس المنايا والحسام لها يد",58,"د",1,0],["وكم جاهلٍ يُصفيك وُدّاً بجهلِه","وأفضَلُ من هذا الوِداد التَّصارمُ",59,"م",1,0],["وكم جاحِدٍ فَضْلِي لإسقاطِ فَضْله","ذَوُو النَّقْصِ مذ كانوا أعادي ذوي الفضِل",60,"ل",1,0],["وكم جامعٍ فيه نعيمٌ ونعمةٌ","ومأذنةٍ فيها عُلاً وعلاء",61,"ا",2,0],["وكم جسورٍ عَقَدنا من قَناطِرِها","أقواسَ نصرٍ على نهرٍ يرئّينا",62,"ن",2,0],["وكم جاهل لم يزدجر الذي جرى","على آدم من فعله كل خزية",63,"ه",1,0],["وكم جمع الحبّ في قيده","أخا البؤس بالأروع الأمجد",64,"د",1,0],["وَكَم جَهولٌ قَد نالَ بُغيَتَه","وَمِن أَديبٍ أَكدى عَلى أَدَبِه",65,"ب",2,0],["وَكَمْ جَلا اللَّهُ مِن غَمَّاءَ أَدَركَها","بِلُطفهِ لا بِحَوْلِ المَرْءِ والحِيَلِ",66,"ل",1,0],["وَكَم جاهل لِلمَجد تَطمَحُ عَينُهُ","وَثَغر المَعالي مِنهُ يَضحَكُ عَن بُعدِ",67,"د",1,0],["وَكَم جَلَت شَمس خَدر حَولها قَمَر","تَبدو إِذا ترفعُ الأَستارُ وَالحجبُ",68,"ب",1,0],["وَكَم جَذَبت أَذيالُنا نِسمَة الصِبا","عَلى أَنَّهُ مِنها أَرق وَأَلطَف",69,"ف",1,0],["وكم جاء بي نِضْوٌ طوَى الأرضَ ذارِعاً","فعاد بما أَوْقَرْتَهُ وهْو شابر",70,"ر",1,0],["وكم جُدْتُ بالنّفْسِ العزيزةِ فيكمُ","كجودِ أخي الإحسانِ للوَفْدِ بالوَفر",71,"ر",1,0],["وكم جاد بالدّنيا على الدّينِ كَفُّه","وأصبح يَجْنِي عَفْوُهُ جَمْرةَ الحِقْد",72,"د",1,0],["وَكَم جيدِ لَيلِ سِمطُهُ مِن سِماطِهِ","عَلى أَنَّهُ سِمطٌ تَنَظَّمَ لِلنَثرِ",73,"ر",1,0],["وكَم جاءَني ما قالَهُ فيكَ كاشِحٌ","فزِدتُكَ حُبّاً كلَّما زادَني نَعيا",74,"ي",2,0],["وَكَم جُفونٍ مَقتُولَةٍ سَقَماً","رُميتُ مِن أَسرِها بِقَتَّالِ",75,"ل",1,0],["وكم جادَ بالفَضل الكَبيرِ وكم جَنى","كثيراً عَلى قَومٍ مُلوكٍ أكابِرِ",76,"ر",1,0],["وكم جَحفلٍ لجِبٍ قادَه","إلى جَحفلٍ وغُبارٍ أثارَه",77,"ر",2,0],["وكم جاءت له من معجزات","بها قد خصه ذو الكبرياء",78,"ا",2,0],["وكم جابتِ الأرضَ البسيطة باسمِهِ","قوافٍ سوارٍ في الثناء شوارد",79,"د",1,0],["وكم جمعت وشجّعت الرجال وكم","علّمتها الحرب بعد الجبن والخور",80,"ر",1,0],["وكم جَمَل أَعْيَي المُزَارِعَ طِبُّهُ","يُبَلِّطُ بالرِّجْلَيْنِ ما هُوَ حارِثُ",81,"ث",1,0],["وكم جذبَ الصبا طرفَيْ عِناني","فغادرَهُ بسالفتَيْ شُرود",82,"د",1,0],["وكم جَفْنِ ضيفِ سائلِ الدمعِ ساهرٍ","وكم جفنِ سيفٍ جامدِ الدمِ هاجعِ",83,"ع",1,0],["وكم جرّدتْ دونَ الظِباءِ من الظُبى","لقتلِ شحٍ لا يُرْتَجى أخذُ ثارِه",84,"ر",2,0],["وكم جَلّلُوني نِعْمَةً قَدْ جَلَوْتُها","عَلَى غابِرِ الأزمانِ فِي حُلَّةِ الخُلدِ",85,"د",1,0],["وكم جَلَّيْتَ من خطْبٍ جليلٍ","وكم دَاوَيْتَ من داءٍ عَياءِ",86,"ا",2,0],["وكم جوعة عندي والعيص مولع","فما قنعت نفسي من حشف القش",87,"ش",1,0],["وكم جذع منك أقرحته","ومُثَّغرٍ بعد لم يجذَعِ",88,"ع",1,0],["وكم جَنَى الرَّيثُ على حازمٍ","فودّ لو قدَّمَ ما أخَّرا",89,"ر",2,0],["وكم جَمدَ الرزقُ البطيءُ على يدي","فسلستَ من كفَّيْك ماءً يُذيبُهُ",90,"ب",2,0],["وكم جُرِّعتْ مني رجالٌ بحورُها","كئوسُ أنتقامٍ مُرّها في فمي عَذْبُ",91,"ب",1,0],["وكم جل جرم فاحش فمنحته","رقيق الحواشي بالأناة موسَّعا",92,"ع",2,0],["وكم جلَّ جرمٌ فاغتفرتَ خطيرهُ","بحلم جميل الصَّفح رحب التَّغمد",93,"د",1,0],["وكم جاوزَتْ أحياء عذْرٍ نواكثاً","يكاثرُ رمْلَ الأنْعمَيْنِ لِئامُها",94,"م",3,0],["وكم جيش هم كنت كفوءًا المثله","تلقَّيتهُ بالعيسِ والبيدِ والوَخد",95,"د",1,0],["وكم جائني عنهُ خطابٌ مضمَّنٌ","ثناءً كأنفاس القسيمة في النفح",96,"ح",1,0],["وكم جادَ أكناف الغضا من سحابةٍ","فمازال لولا خصب دمعي جدوبها",97,"ب",3,0],["وكم جر الغرور لها غبيّا","وما ذاك الغرور سوى اعتيادي",98,"د",2,0],["وكم جَرَرْتُ حقوفي بعد ما شَحَطَتْ","بنصرهم من لَهاةِ الضّيغمِ الضّاري",99,"ر",2,0],["وكم جريحٍ بلا آسٍ تمزّقُهُ","إمّا النُّسُورُ وإمَّا أضبُعُ البيدِ",100,"د",1,0],["وَكَم جهدَ الأعداءُ فيما يسوؤُني","فما خوّفوا أَمْني ولا ذَعْذَعوا سِرْبي",101,"ب",2,0],["وَكَم جَذب السُّعاة عَلَيكَ ضَبْعِي","فَما أَوسَعتُهم إلّا جِذابا",102,"ب",2,0],["وكم جلائل أعمال أقمت لنا","وضحن كالشمس ما استدعين برهانا",103,"ن",2,0],["وكم جموع بلا حصر ولا عددٍ","كالحشر لم تدر احصآء وتبيانا",104,"ن",2,0],["وكم جاب البسيطة سائحات","أفدن مواطناً ومواطنات",105,"ت",1,0],["وَكَم جَفَّت عَلَيكَ شُؤونُ دَمعٍ","بِعَينٍ لَم تَجِفَّ لَها دِماءُ",106,"ا",2,0],["وكم جاء في فن الخليل بن أحمد","بأحمد أقوال أتت بالفواصل",107,"ل",1,0],["وَكَم جبهة تودي بِجبهة عسكر","إِلى الحَتف وَالأهوال في يَوم نقمة",108,"ه",1,0],["وكم جاءك العذّال يتهمونني","وعندك أني لا عليَّ ولا ليا",109,"ي",2,0],["وكم جاهدتُ فيه بكل فتوى","فما أغنى ارتجالي وارتجازي",110,"ز",2,0],["وكم جريضٍ بما لاقاهُ من كمَدٍ","على الحسين وإن لم يشتك الجرَضا",111,"ض",2,0],["وَكَم جاءَ بَعدَ الصّبرِ نِعم لِصابِرٍ","وَكَم جاءَ بَعدَ العُسرِ يُسرٌ بِمَغنَمِ",112,"م",1,0],["وَكَم جاءَ فَتحُ اللَّهِ في فَتحِ بابِهِ","وَخَفقٍ في راياتِهِ عندهُ النّصرُ",113,"ر",1,0],["وكم جفونٍ وعدت بالمنىَ","يا عجباً تمرض وهيَ الصحاح",114,"ح",1,0],["وكم جزمت عفة","وكم نصبت كفة",115,"ه",1,0],["وكم جلوت الدررا","على الندى المفعم",115,"م",1,0],["وكم جلبت جلة","برمحي المقوم",115,"م",1,0],["وكم جذمت منصبا","بمنصبي ومنصبا",115,"ب",2,0],["وكم جلا كربة وجلى","بالسيف والرمح من أعادي",116,"د",2,0],["وكم جلوت محيا البسط مغتبطا","كما جنيت ثمار الأنس مغتنمنا",117,"م",3,0],["وَكَمْ جحدتْ عَيْنَاهُ قتليَ عَامِداً","ووجنتهُ الحَمْرَاءُ تُخْبِرُ عَنْ دَمِي",118,"م",2,0],["وكم جاهل قد زاده الحلم عزة","على غيره لما فسحت له المدى",119,"د",2,0],["وَكَمْ جَلا مَرْوانُ حَتَّى أَشْرَقا","مِنْ غَمَراتٍ تَبْلُغُ المُخَنَّقا",120,"ق",2,0],["وكَم جَابَ مِن قَفرٍ مُضِلٍّ إِلَى الهُدَى","وكَم حَطَّ مِن وِزرٍ وكَم شَدَّ مِن أزرِ",121,"ر",1,0],["وكم جد في المولى بصدق وهمة","واحيا ظلاما بالقيام مرتلا",122,"ل",2,0],["وكم جادكم أولا ضعافا أذلة","واسعف مضطرا له الشكر والحمد",123,"د",1,0],["وكم جلبت سرى به كم بدت به","مزايا وكم بانت له من مصيبة",124,"ه",1,0],["وكم جدول جارٍ يطارد جدولاً","وكم جوسق عال يوازيه جوسقُ",125,"ق",1,0],["وكم جلبت إلى الأعداء عادية","وكم نهبت لهم من جاملٍ وشوى",126,"ش",3,0],["وكم جحفل قد دك منه صفاته","له فوق أصوات الحديد صواقع",127,"ع",1,0],["وكم جاهل قابلته مثل جاهل","لارفع عني عنده عار عالم",128,"م",1,0],["وكم جمعت بدار اللحد من نفر","جمع الفراق وكم فرقت اخوانا",129,"ن",2,0],["وَكَم جَبان عافَهُ قَومَهُ","فَصارَ في الأَحياءِ لا يُذكَرُ",130,"ر",1,0],["وَكَمْ جِئْتُهَا خَلْفَ بَرْقٍ لَمُوعٍ","كِلاَنَا لَعَمْرِيَ يَحْدُو الْقِطَارَا",131,"ر",2,0],["وكم جرت بين وصفيه مناظرةٌ","فالحب يثبته والسقم ينفيه",132,"ي",2,0],["وكم جفنات معروف وبر","يعم ندى قراها آل جفنه",133,"ن",2,0],["وكم جاء وفاد سراع يرمنه","جلاءً لمحل فابتداهم بذي بشر",134,"ر",1,0],["وكم جامح في خبط عشوا معاند","غدا جانحا يقفو الهدى ويصاحب",135,"ب",1,0],["وكم جذب الإفرنج قوماً بمالهم","وحنّا إلى مال الأجانب ما حنّا",136,"ن",2,0],["وكم جارٍ ليدرِكَ منْ غُباري","تردَّى لِلْجَبينِ ولليدين",137,"ن",1,0],["وكم جَبَلٍ في الأَرضِ أشمخُ ذروةً","وأحمى حمىً لو أنَّ نَجْوَتَهُ تُجدي",138,"د",2,0],["وكم جلينا عروساً من محاسنه","تلك الليالي فكانت كلها عرسا",139,"س",2,0],["وكم جريت جيش العزم زخار","ببحر النصر في عامر وقافر",140,"ر",1,0],["وكم جنبت الى الاعداء عادية","وكم نهبت لهم من جامل وشوي",141,"و",2,0],["وكم جبل جزنا ورمل وحاجز","ولله كم واد وشعب عبرناه",142,"ن",3,0],["وَكَم جَلَبَت مَجلوبَةٌ سُقمَ مُهجَةٍ","فَهَل كُلَّ مَجلوبٍ بِهِ السُقمُ مَجلُوبُ",143,"ب",1,0],["وكم جزمت برفع الصحن مُذ عطفوا","فيه المشور منصوباً ومجرورا",144,"ر",2,0],["وكم جلست على هذه الصخور وكم","ابكيت طير الفيافي عند شكواي",145,"ا",2,0],["وكم جلست بناديها يضاحكني","فيه أحاديث فتياني بأسراري",146,"ر",2,0],["وكم جوادٍ أَزرقِ اللَّوْنِ غريبْ","وليسَ ندري أَجَنُوبٌ أم جنيبْ",147,"ب",1,0],["وكم جوادٍ في الصِّفات قد سَما","مثل الثُّرَيا بالهلال أُلْجِما",147,"م",2,0],["وكم جوادٍ حسَن الخصائلِ","ما مثلهُ يُوْجَدُ في الأَصايلِ",147,"ل",1,0],["وكم جنحوا لأغراض قباح","وجنح الليل قد أرخى ستاره",148,"ر",2,0],["وَكَم جَأجَاوا بي لِلوُرودِ فَلَم أَكُن","لِأَشرَبَ مِن ماءٍ وَبٍ مُتَوَخِّمِ",149,"م",1,0],["وكم جرعته غصة بعد غصة","وكم اوقفته في خطير المعاطب",150,"ب",1,0],["وكم جدَّ في التفتيش طاغي زمانه","ليفشي سرَّ الله فانكتم السرُّ",151,"ر",1,0],["وكم جحفل إذ ذاك قبل لقائه","بنو الأصفر انحازت وأوجهها صفر",151,"ر",1,0],["وكم جماد وعجماً له نطقا","كالضبِّ والدبِّ والحصباء والحجر",152,"ر",1,1],["وَكَم جيفة وَحش الفَلاة يَعافها","تَنازَعَ فيها جُوّعٌ وَتَنافسوا",153,"س",3,0],["وكم جاءه حتى اتيت مفوض","ولم يصف فيه قبلما جئت مورد",154,"د",1,0],["وكم جموحٍ عندما قام بال","أمر رأى القهر فخلّى الجماح",155,"ح",1,0],["وكم جميل إلينا لا تكافئه","آيات مدحى وإن عزت مبانيها",156,"ي",3,0],["وكم جمعنا الشمل في الوراقه","عين ثراها بالصفا برّاقه",157,"ه",1,0],["وَكَم جَرَت حَتى لَم تَدَع لِمؤمل","لَدَى الستر إِلّا لَبسة المُتَفَضل",158,"ل",1,0],["وكم جواد زين في مواكب","ركوبة وجنب الجنيب",159,"ب",1,0],["وكم جاءني يوماً دنئٌ مطالبا","بسفري وقد أبدي بسفري اعجابا",160,"ب",2,0],["وكم جاءني شعرٌ وسرعان ما مضى","فأبقى بقلبي حسرةً تتسعّر",161,"ر",1,0],["وكمجأورات أو حاليه","وسببية مسببيه",162,"ه",1,0],["وكم جنت المنون على كرام","وجندلت الكمى بلا قتال",163,"ل",1,0],["وَكم جارَ دهرك في حكمه","فعارض فيكِ زَمانا ظلَم",164,"م",1,0],["وكم جمال وكم كمال","يعجز عن وصفه الأديب",165,"ب",1,0],["وكم جمعت يوم السويقة عندهم","رجال وأولاد بناتٌ ونسوان",166,"ن",1,0],["وَكَم جاءَت صروف الدهر آداً","وَما علمت بأنّ الأَمر أدُّ",167,"د",1,0],["وكم جيادٍ إذا جالتْ نَمَيْتَ إلى","جمْرٍ أمامَ هُبوبِ الريحِ مشْبوبِ",168,"ب",1,0],["وكم جارحٍ يستقْبِلُ الطّيرَ جارحاً","إذا وثبَتْ في جوّها يتغمّصُ",169,"ص",1,0],["وَكَم جَهلت نُهىً لَما عَرفتُ هَوىً","وَكَم عَثرت وَفكري إِذ غَوى رَكضا",170,"ض",2,0],["وَكَم جَرت أَدمُعٌ قبلي عَلى أَممٍ","فَالحُزنُ متفقٌ في حال مختلف",171,"ف",1,0],["وَكَم جبت من فيفاءَ ضلَّ هداتُها","وَخضت بحار الآلِ طامي الجَوانب",172,"ب",1,0],["وَكَم جسومٍ تلافى مِن تَلاف ضنىً","أَرواحها إِذ هداها روعها هدأ",173,"ا",1,0],["وكم جهبذ من صيد أحفاده اقتفى ال","جدود إلى أن نال بالجد ما نالوا",174,"ل",3,0],["وكم جاوروا جهّال قوم فأفسدوا","عقائدهم والنار للجار حارقه",175,"ق",2,0],["وكم جوار أتت من كل ناحية","في خدمة الدوح تجري فهي في خبب",176,"ب",1,0],["وكم جيش يجر إلى الأعادي","كتائيبه كأعراض الجبالي",177,"ل",2,0],["وكم جاس نقعاً فانجلى عن جبينه","بأبلج رفّاف على تاجه النصر",178,"ر",1,0],["وكم جاس نقعا فانجلى من جبينه","بأبلج رفاف على تاجه السعد",179,"د",1,0],["وكم جيش يؤمك مستفيدا","سينعم منك بالكرم المفيد",180,"د",1,0],["وَكَم جالَت نَواظِرُنا تراعي","إِيابَ الغائِبينَ إِلى القُصورِ",181,"ر",1,0],["وَكَم جَبَل قَد صارَ حبلا حَقيقَة","وَلا خبل في مَن أَتى ذا بفكره",182,"ر",2,0],["وكم جحفل للحرب ثار قتامه","رماه الردى من بأسه بجحافل",183,"ل",1,0],["وَكَم جزت من بحر وَذا خر فكرتي","يَزيد عَلى البَحر الخَضم عَميقَه",184,"ق",2,0],["وَكَم جاهد يَشقى لراحة قاعد","وَكَم قاعد يَختال وَهوَ سَليب",185,"ب",1,0],["وَكَم جاءَ في جور الخطوب مُعربِداً","يسلُّ إلى قَتلي حساما ومرهفا",186,"ف",2,0],["وكم جَرَّ من جُرد الرَزايا جحافلاً","بِعَزمٍ لكم هزَّ الجبال وأرجفا",186,"ف",2,0],["وكم جهول أتى يَزهو بغرَّتهِ","ممدوحةٌ منهُ بين الناس أطوارُ",187,"ر",1,0],["وَكَم جسورٍ يَروع الكون هيكله","قد قيل لا روح فيهِ فهو مجدارُ",187,"ر",1,0],["وكم جاءَ يهيدنا النسيم عبيرهُ","فكان إلى الأرواح خير الهديَّةِ",188,"ه",1,0],["وكم جاءَ المماذق في خداعٍ","ويفغرُ فاهُ بالقول الطويلِ",189,"ل",1,0],["وكم جناح نجاحٍ رِشْتَه فقضى","لكم بذكْرٍ على الآفاقِ طيَّار",190,"ر",1,0],["وكم جُبْنَ من غبراءَ لم يُسْقَ نَبْتُها","دراكاً ولم يُنْضَحْ بماءٍ فيغسل",191,"ل",1,0],["وكمْ جنَّةٍ قد رُدْتُّ في ظلِّ كافرٍ","فلم أجز ما أهداهُ كفراً ولا غمطا",192,"ط",2,0],["وكم جنبوها خلف معتادة السُّرى","غواربَ لم تَعْرِفْ زفيراً ولا نحطا",192,"ط",2,0],["وكم جالدت عنه العداةَ سعودهُ","وكم جادلت عنه بألسنة لدّ",193,"د",1,0],["وكم جاء في القرآن أيضاً وسنةٍ","ثناءٌ عظيمٌ للصبور فرددوا",194,"د",3,0],["وكم جهبذٍ قطب عظيمٍ مبجلٍ","وكم منهم صافي الفواد مكمل",195,"ل",1,0],["وَكَم جَزَوا ودَّكَ الغالي عُقُوقَهُمُ","فَلَم تُبالِ بِما قالُوا وَما فَعَلُوا",196,"ل",3,0],["وكم جاءتْكَ من نُذُر","أتتك جميعُها تَتْرَى",197,"ر",2,0],["وكم جاءه في لهوه متغافلاً","وآخرُ يتلو خيله وهو زاجر",198,"ر",1,0],["وكم جاءتكَ من نُذُرٍ","وحلَّ الشيبُ والشَّمَطُ",199,"ط",1,0],["وكم جعفر من مدمع لابنه جرى","وساق كأنبوب السقي المذلل",200,"ل",1,0],["وكم جنى ممن جنى بطشه","غلاظ أعناق بحدٍّ الرقاق",201,"ق",1,0],["وكم جريت بشطى ضفيته الى","محاسن للهوى فيهن وقفات",202,"ت",1,0],["وكم جاء ملهوف لنحوك قاصداً","فكنت له غوثاً معيناً ومنجدا",203,"د",2,0],["وكم جردت كفاي منه مهنداً","جرازاً على طول الضريبة لا ينبو",204,"ب",2,0],["وكم جرى فارهاً إذ لاح عن بعد","زفاف خود إليها بالغ الأمد",205,"د",1,0],["وَكَم جَهِدَ النَسيمُ بِهِ","لِيُحسِنَها فَما قَدَرا",206,"ر",2,0],["وَكَم جَرَّدوا لِلحَربِ فَاِستَلهَت بِما","أَرادَ حَبيبي فَاِزدَرَتها الوَقائِعُ",207,"ع",1,0],["وكَم جَبَلٍ أَشَمَّ أَطَلَّ فِيها","وأَصبَحَ شاعِرًا, ولهُ شُعُورُ",208,"ر",1,0],["وكم جادتْ يدٌ لكمُ","بِها ذو حاجةٍ رُزقا",209,"ق",2,0],["وكم جارَ العتاةُ على إمامٍ","فما في القوم يا هذا شريف",210,"ف",1,0],["وكم جاهل ظن القلوب كقلبه","ومستصغر ظن الرؤوس عمائما",211,"م",2,0],["وكم جرحت فؤادي كم ضنى جسدي","أليس دمعي حبيبي مذ هجرت جرى",212,"ر",2,0],["وكم جلت بالطرف كيما أرى","نظيرا فعز النظير المدان",213,"ن",1,0],["وكم جاهل ٍ في نظمها قد فتلها","والكي ماهو دايم بلذعة النار",214,"ر",1,0],["وكم جيش سحبت له عباب","تدفق مثل أمواج البحور",215,"ر",1,0],["وكم جيوبٍ تعد اليوم وارثةً","لجيب بلفور ترضيكم وتستلم",216,"م",1,0],["وكمْ جَسَدي يُؤنِّبُني بِصَمْتٍ","يُحاوِلُ أن يُخَلِّصَني اعْتِذارا",217,"ر",2,0],["وَكَمْ جَهِدَتْ أُمَيَّةُ مَحْوَ ذِكْرٍ","لِشَخْصِكَ فَازْدَهَى مِنْكَ الكِيَانُ(٥)",218,"ن",1,0],["وكم جر من جيش لهام عرمرم","يغاد به شوس الملوك السوامد",219,"د",1,0],["وكم جرح طويناه بصمتٍ","فإنَّ الصبرَ للجرحِ الدواءُ",220,"ا",2,0],["وكمْ جئتُ ألقى طيفهَا قبل موعدٍ","لأنهلَ منْ نورٍ وأرشفَ من ندى",221,"د",2,0],["وكم جاريه نامت على نبض ضرغام","الناس كلٍ بالغلا له ميوله",222,"ل",2,0],["وكم جاهلٍ قد قال لي أنت ناقص","فهيج ليث الحقد وهو غضوب",223,"ب",1,0],["وَكَمْ جَرَيْتُمْ إِلَى الأَبْوَابِ تَقْرَعُهَا","كَفٌّ وَيَقْرَعُكُمْ مِنْ صَمْتِهَا ضَجَرُ!",224,"ر",1,0],["وَ كَمْ جِرَاحٍ لَنَا تَهْوِي بِمُهْجَتِنَا","لِيُصْبِحَ الشَّرُّ لَيْلاً بِالضِّيَاءِ عَمِي",225,"م",2,0],["وكم جمعوا من الخيرات حرصاً","فكان لكل مجتهدٍ رصيدُ",226,"د",1,0],["وكم جمعت راقياً بساحرٍ","أصابني من سحرهِ بمقتلِ",227,"ل",1,0],["وكم جثوتِ بركنِ العشقِ باكيةً","يُفجّرُ الدمعَ من عينيكِ بركانا",228,"ن",2,0],["وكم جعل النطاق لها عناناً","تقاد به إلى دار النعيم",229,"م",1,0],["وكم جرعتها غصص المنايا","بيومٍ فيه يكتهل الفطيم",230,"م",1,0],["وكم جهبذ من صيد أحفاده اقتفى","الجدود إلى أن نال بالمجد ما نالوا",231,"ل",3,0],["وكم جمدَ الرزقُ البطيءُ على يدي","فسلسلتَ من كفيك ماءً يذيبهُ",232,"ب",2,0],["وكم جلبوا أشطرًا لا تدر","وإن أرهقوا صباح مساء",233,"ا",2,0]]}