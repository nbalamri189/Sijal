,"الطويل"],[464,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[464,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[464,"إذا هز بانات العذيب جنوبها","https://www.aldiwan.net/poem3620.html","عموديه"],[479,"هي الأعمار نقص في ازدياد","https://www.aldiwan.net/poem36938.html","الوافر"],[551,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[551,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[551,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[551,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"]],"verses":[["وَكَم جاوَزَت مِن رَملَةٍ ثُمَّ عاقِرٍ","وَأُخرى يَضُفُّ الرَوضُ فيها الغَوادِيا",0,"ي",2,0],["وَكَم جَفَّ دَمعٌ فيكَ قَد كانَ غَربُهُ","بَطيئاً إِذا ما ريمَ لَم يَتَسَرَّعِ",1,"ع",1,0],["وَكَم جَهدِ نائِبَةٍ قَد لَقيتُ","لِأَجلِكِ يا بِنتَ عَمّي وَنَكبَه",2,"ب",2,0],["وَكَم جُيوشٍ لَقَد فَرَّقتُها فِرَق","وَعارِضُ الحَتفِ مِثلُ العارِضِ الهَطِلِ",3,"ل",1,0],["وَكَمْ جَمَعَتْ يُمْنَاكَ بَعْدَ افْتِرَاقِهَا","خَصيمَيْ نِجَارٍ مِنْ يَرَاعِ وَلَهْذَمِ",4,"م",1,0],["وَكَم جَريحٍ باسِطٍ كَفَّهُ","يَدعو أَخاهُ وَهوَ لا يُبصِرُ",5,"ر",1,0],["وَكَم جاوَزَت مِن رَملَةٍ بعد رملة","وَصَحراءَ خَوقاءِ المَسافَةِ هَوجَلِ",6,"ل",1,0],["وكم جال طِرْفُ الطَّرف في روض حسنه","يقيده فيه العِذارُ بسندسِ",7,"س",1,0],["وكم جَنَّبَتْني عزّة النفس مَنهَلاً","يطيب به لكن مع الذُل مَوْرد",8,"د",1,0],["وكم جربت منكَ الملوكُ ميامناً","ونصحاً على فقد الميامن والنصح",9,"ح",1,0],["وكم جاز فرط الحزن للمرء لم يفد","فما بالنا لا نستفيد ونأثم",10,"م",1,0],["وكم جَاهَرتْه وقالت له","تَغَافل كأنَك في مَرْعش",11,"ش",1,0],["وكم جاهلٍ قد أبدأ الجهلَ مرةً","فقلت أعدْهُ إنني عائدُ الحلمِ",12,"م",1,1],["وَكَم جاءَت لَنا عَنكُم","أَحاديثٌ رَدَدناها",13,"ا",3,0],["وكم جنيت جهرة","من لذة لم تدم",14,"م",1,0],["وَكَم جَمَعَتهُمو حَربٌ فَكانوا","حَدائِدَها وَكانَ هُوَ الحُساما",15,"م",2,0],["وَكَم جاءَتِ الأَيامُ رَسلاً تَقودُني","إِلى نائِلٍ مِن راحَتَيكَ مُعادِ",16,"د",1,0],["وَكَم جاءَني عَنكَ مِن مَنطِقٍ","يَكادُ الحَليمُ لَهُ يَجهَلُ",17,"ل",1,0],["وَكَم جَريءٍ عَلى عِنادِكَ قَد","عادَ هُزالاً في مَتنِهِ سِمَنُه",18,"ن",2,0],["وَكَم جَعَلَت مِنّي عَلَيَّ طَليعَةً","فَعَيني لَها في ذاكَ عَينٌ عَلى قَلبي",19,"ي",1,0],["وَكَم جَرَّبتُ قَبلَكَ مِن مَليحٍ","فَأَمسى جيدُ حالِيَ مِنهُ حالي",20,"ي",1,0],["وَكَم جَبَلٍ بِالبَذِّ مِنهُم هَدَدتَهُ","وَغاوٍ غَوى حَلَّمتَهُ لَو تَحَلَّما",21,"م",2,0],["وَكَم جَولَةٍ لا يُحسِنُ البَغلُ مِثلَها","أَتَت عَجَلاً لَم يَجنِ مَكروهَها جانِ",22,"ن",1,1],["وَكَم جاوَزَ الحَقَّ في مُشرَفٍ","فَعُدَّ شَحيحاً وَبارى الرِياحا",23,"ح",2,0],["وكم جَاوَزَ الإِبْدَاعُ في الحُسْنِ حَدَّهُ","فَأَوْهَمَنا أَنَّ الحَقيقَةَ زُورُ",24,"ر",1,0],["وَكَمْ جَعَلَ الْفَقِيهُ الْعَدْلَ ظُلْماً","وَصَيَّرَ بَاطِلاً حَقَّاً مُبِينا",25,"ن",2,0],["وكم جَحفلٍ مَجْرٍ قرعتَ صَفاتَهُ","بصاعقَةٍ يَصْلى بها وهي جاحم",26,"م",1,0],["وَكَم جَميلٍ حَطَّهُ بِرَغمِهِ","وَقَد سَقاهُ عَلَلاً مِن شَمِّهِ",27,"م",2,0],["وَكَم جاوَزَت مِن ظَهرِ أَرعَنَ شاخِصٍ","وَمِن بَطنِ وادٍ جَوفُهُ مُتَصَوِّبُ",28,"ب",1,0],["وَكَم جَنَت المَعاصِمُ مِن مَعاصٍ","تَعودُ بِها المَعاضِدُ مُعصِماتِ",29,"ت",1,0],["وَكَم جَمَعَ النَفائِسَ رَبُّ مالٍ","فَلَمّا جَدَّ مُرتَحِلاً ذَراها",30,"ا",3,0],["وَكَم جَريح طَريح","لا يَستَطيع قياما",31,"م",2,0],["وكم جبل هبطتَ برأس وادٍ","يعزُّ الجنَّ أن ترقَى سنامهْ",32,"م",2,0],["وكم جِئْتِهِ بأرقِّ الغناءِ","وأشرقتِ فيه بوحيِ السماءْ",33,"ا",2,0],["وكم جُبْتُ أرضاً ما انْتَعَلْتُ بمَرْوِها","وجاوَزْتُ أُخرَى ما شَددتُ لها شِسْعي",34,"ع",2,0],["وكم جلاها في اليماني المسبل","من قبلت منه ومن لم تقْبَلِ",35,"ل",1,0],["وَكَم جُيوشٍ لَقَد فَرَّقتُها فِرَقاً","وَعارِضُ الحَتفِ مِثلُ العارِضِ الهَطِلِ",36,"ل",1,0],["وَكَمْ جَمَاعَةٍ وَكَمْ نِقَابَةٍ","أُلْتَ بِهَا مَرَافِقَ العِبَادِ",37,"د",1,0],["وكم جرَتِ الدّماءُ ، لها هَديرٌ","على حبَّاتِه وبها نزيف",38,"ف",1,0],["وَكَمْ جُرِّعَتْ مِنْ صَبْرِهَا كَأْس حَنْظَلِ","وَكَمْ نَالَهَا صَرْفٌ مِنْ الدَّهْرِ مُبْتَلي",39,"ي",1,0],["وكَمْ جاوزَتْ بحْراً ولَيْلاً، يخُضْنهُ","إلَيْكَ أميرَ المؤمنينَ ومِن سَهْبِ",40,"ب",1,0],["وكم جَمَعَتْهُمُ حربٌ، فكانوا","حدائدها ، وكان هو الحسما",41,"م",2,0],["وكم جازيت عن شرّ بخير","وكم جازاك بالغدر الأنام",42,"م",1,0],["وكم جهولٌ لجا في باب دولته","بعد الشقاوة أضحى من ذوي الحكم",43,"م",1,0],["وَكَم جِيدِ رَقٍّ كَانَ قَبلِى مُعَطَّلاً","فَحَلاَّهُ بِالعِقيَانِ خَطُّ بَنَاني",44,"ي",1,0],["وكَم جَابُوا التَّنَائِفَ فَوقَ نُوقٍ","يَحَاكِى عَدوُهَا عَدوَ الرِّئَالِ",45,"ل",1,0],["وَكَم جاهِلٍ أَغرى بِمَجدِكَ كَيدُهُ","وَلَكِنَّهُ أَودى وَما كانَ ما وَدّا",46,"د",2,0],["وَكَم جَدَّ مُجتَهِدٌ في طِلابِ","عُلاكَ فَلَم يَكتَحِل بِالأَثَر",47,"ر",1,0],["وَكَم جاوَزتَ في طَلَبِ المَعالي","طَريقاً ما وَجَدتَ بِهِ رَفيقا",48,"ق",2,0],["وكم جبرا بجاهٍ أو بمال","خروقاً من مساعيك القباح",49,"ح",1,0],["وكم جاهل عد الحصون معاقلا","يرد بها عن نفسه الإِنس والجنا",50,"ن",2,0],["وَكَم جُبتُ مِن مَجهولَةٍ وَمُشَيِّعي","بِها قَلبُ مَأثورٍ وَشَيخانُ آفِقُ",51,"ق",1,0],["وَكَم جُبتُ مِن مَوماةِ أَرضٍ تَرى بِها","مَعَ الآلِ حَقَّ العَينِ وَالأُذنِ باطِلا",52,"ل",2,0],["وَكَم جُبتُ مِن خَرقا تَمُوتُ بِها الظِبا","بِهِمَّةِ مَضّاءٍ عَلى الهَولِ حازِمِ",53,"م",1,0],["وَكَم جُبتُ مِن خَرقا تَمُوتُ بِها الظِبا","بِعَزمَةٍ مَضّاءٍ عَلى الهَولِ حازِمِ",54,"م",1,0],["وَكَم جاهَدوا في البحرِ والبرِّ أُمّةً","وَمِن لَحمها قد أشبعوا الحوتَ والنسرا",55,"ر",2,0],["وكم جهولٍ تراه مشترياً","سرور وقتٍ بغمِّ أوقاتِ",56,"ت",1,0],["وكم جئت صفر الكف بابك قبلها","فعادت بدي ملأى من البيض والصفر",57,"ر",1,0],["وكم جرع الأبطال نجلك في الوغى","كؤوس المنايا والحسام لها يد",58,"د",1,0],["وكم جاهلٍ يُصفيك وُدّاً بجهلِه","وأفضَلُ من هذا الوِداد التَّصارمُ",59,"م",1,0],["وكم جاحِدٍ فَضْلِي لإسقاطِ فَضْله","ذَوُو النَّقْصِ مذ كانوا أعادي ذوي الفضِل",60,"ل",1,0],["وكم جامعٍ فيه نعيمٌ ونعمةٌ","ومأذنةٍ فيها عُلاً وعلاء",61,"ا",2,0],["وكم جسورٍ عَقَدنا من قَناطِرِها","أقواسَ نصرٍ على نهرٍ يرئّينا",62,"ن",2,0],["وكم جاهل لم يزدجر الذي جرى","على آدم من فعله كل خزية",63,"ه",1,0],["وكم جمع الحبّ في قيده","أخا البؤس بالأروع الأمجد",64,"د",1,0],["وَكَم جَهولٌ قَد نالَ بُغيَتَه","وَمِن أَديبٍ أَكدى عَلى أَدَبِه",65,"ب",2,0],["وَكَمْ جَلا اللَّهُ مِن غَمَّاءَ أَدَركَها","بِلُطفهِ لا بِحَوْلِ المَرْءِ والحِيَلِ",66,"ل",1,0],["وَكَم جاهل لِلمَجد تَطمَحُ عَينُهُ","وَثَغر المَعالي مِنهُ يَضحَكُ عَن بُعدِ",67,"د",1,0],["وَكَم جَلَت شَمس خَدر حَولها قَمَر","تَبدو إِذا ترفعُ الأَستارُ وَالحجبُ",68,"ب",1,0],["وَكَم جَذَبت أَذيالُنا نِسمَة الصِبا","عَلى أَنَّهُ مِنها أَرق وَأَلطَف",69,"ف",1,0],["وكم جاء بي نِضْوٌ طوَى الأرضَ ذارِعاً","فعاد بما أَوْقَرْتَهُ وهْو شابر",70,"ر",1,0],["وكم جُدْتُ بالنّفْسِ العزيزةِ فيكمُ","كجودِ أخي الإحسانِ للوَفْدِ بالوَفر",71,"ر",1,0],["وكم جاد بالدّنيا على الدّينِ كَفُّه","وأصبح يَجْنِي عَفْوُهُ جَمْرةَ الحِقْد",72,"د",1,0],["وَكَم جيدِ لَيلِ سِمطُهُ مِن سِماطِهِ","عَلى أَنَّهُ سِمطٌ تَنَظَّمَ لِلنَثرِ",73,"ر",1,0],["وكَم جاءَني ما قالَهُ فيكَ كاشِحٌ","فزِدتُكَ حُبّاً كلَّما زادَني نَعيا",74,"ي",2,0],["وَكَم جُفونٍ مَقتُولَةٍ سَقَماً","رُميتُ مِن أَسرِها بِقَتَّالِ",75,"ل",1,0],["وكم جادَ بالفَضل الكَبيرِ وكم جَنى","كثيراً عَلى قَومٍ مُلوكٍ أكابِرِ",76,"ر",1,0],["وكم جَحفلٍ لجِبٍ قادَه","إلى جَحفلٍ وغُبارٍ أثارَه",77,"ر",2,0],["وكم جاءت له من معجزات","بها قد خصه ذو الكبرياء",78,"ا",2,0],["وكم جابتِ الأرضَ البسيطة باسمِهِ","قوافٍ سوارٍ في الثناء شوارد",79,"د",1,0],["وكم جمعت وشجّعت الرجال وكم","علّمتها الحرب بعد الجبن والخور",80,"ر",1,0],["وكم جَمَل أَعْيَي المُزَارِعَ طِبُّهُ","يُبَلِّطُ بالرِّجْلَيْنِ ما هُوَ حارِثُ",81,"ث",1,0],["وكم جذبَ الصبا طرفَيْ عِناني","فغادرَهُ بسالفتَيْ شُرود",82,"د",1,0],["وكم جَفْنِ ضيفِ سائلِ الدمعِ ساهرٍ","وكم جفنِ سيفٍ جامدِ الدمِ هاجعِ",83,"ع",1,0],["وكم جرّدتْ دونَ الظِباءِ من الظُبى","لقتلِ شحٍ لا يُرْتَجى أخذُ ثارِه",84,"ر",2,0],["وكم جَلّلُوني نِعْمَةً قَدْ جَلَوْتُها","عَلَى غابِرِ الأزمانِ فِي حُلَّةِ الخُلدِ",85,"د",1,0],["وكم جَلَّيْتَ من خطْبٍ جليلٍ","وكم دَاوَيْتَ من داءٍ عَياءِ",86,"ا",2,0],["وكم جوعة عندي والعيص مولع","فما قنعت نفسي من حشف القش",87,"ش",1,0],["وكم جذع منك أقرحته","ومُثَّغرٍ بعد لم يجذَعِ",88,"ع",1,0],["وكم جَنَى الرَّيثُ على حازمٍ","فودّ لو قدَّمَ ما أخَّرا",89,"ر",2,0],["وكم جَمدَ الرزقُ البطيءُ على يدي","فسلستَ من كفَّيْك ماءً يُذيبُهُ",90,"ب",2,0],["وكم جُرِّعتْ مني رجالٌ بحورُها","كئوسُ أنتقامٍ مُرّها في فمي عَذْبُ",91,"ب",1,0],["وكم جل جرم فاحش فمنحته","رقيق الحواشي بالأناة موسَّعا",92,"ع",2,0],["وكم جلَّ جرمٌ فاغتفرتَ خطيرهُ","بحلم جميل الصَّفح رحب التَّغمد",93,"د",1,0],["وكم جاوزَتْ أحياء عذْرٍ نواكثاً","يكاثرُ رمْلَ الأنْعمَيْنِ لِئامُها",94,"م",3,0],["وكم جيش هم كنت كفوءًا المثله","تلقَّيتهُ بالعيسِ والبيدِ والوَخد",95,"د",1,0],["وكم جائني عنهُ خطابٌ مضمَّنٌ","ثناءً كأنفاس القسيمة في النفح",96,"ح",1,0],["وكم جادَ أكناف الغضا من سحابةٍ","فمازال لولا خصب دمعي جدوبها",97,"ب",3,0],["وكم جر الغرور لها غبيّا","وما ذاك الغرور سوى اعتيادي",98,"ي",1,0],["وكم جَرَرْتُ حقوفي بعد ما شَحَطَتْ","بنصرهم من لَهاةِ الضّيغمِ الضّاري",99,"ي",1,0],["وكم جريحٍ بلا آسٍ تمزّقُهُ","إمّا النُّسُورُ وإمَّا أضبُعُ البيدِ",100,"د",1,0],["وَكَم جهدَ الأعداءُ فيما يسوؤُني","فما خوّفوا أَمْني ولا ذَعْذَعوا سِرْبي",101,"ي",1,0],["وَكَم جَذب السُّعاة عَلَيكَ ضَبْعِي","فَما أَوسَعتُهم إلّا جِذابا",102,"ب",2,0]]}