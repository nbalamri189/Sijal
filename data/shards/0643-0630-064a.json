{"poems":[[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[37,"أفي رسم أطلال بشطب فمرجم","https://www.aldiwan.net/poem38832.html","الطويل"],[4,"فإن تك ذاعر رثت قواها","https://www.aldiwan.net/poem21220.html","الوافر"],[53,"ألا أيهذا السائلي عن معاشر","https://www.aldiwan.net/poem66751.html","الطويل"],[40,"تهانفت واستبكاك رسم المنازل","https://www.aldiwan.net/poem7740.html","الطويل"],[87,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[82,"ومرتفع في الجذع إذ حط قدره","https://www.aldiwan.net/poem31213.html","الطويل"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[52,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[52,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[52,"ألا يا صنم الأززد","https://www.aldiwan.net/poem64851.html","الهزج"],[48,"عجبت لشارب بزجاج راح","https://www.aldiwan.net/poem22480.html","الوافر"],[8,"كأن رعالهن بواردات","https://www.aldiwan.net/poem21837.html","الوافر"],[4,"فإن تك ذاعر رثت قواها","https://www.poetsgate.com/ViewPoem.aspx?id=792",""],[41,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""],[87,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""],[141,"أليس عظيما أن أرى كل وارد","https://www.aldiwan.net/poem67952.html","الطويل"],[203,"لم ينكشف همي ولكنني","https://www.aldiwan.net/poem45551.html","السريع"],[208,"أعاذل حسب المرء بالشيب عاذلا","https://www.aldiwan.net/poem53155.html","الطويل"],[376,"تولى بتهويمة الهائم","https://www.aldiwan.net/poem57151.html","المتقارب"],[438,"وكم رام مجدك من حاسد","https://www.aldiwan.net/poem12492.html","المتقارب"],[466,"يرجى نداه في القطوب وجوده","https://www.aldiwan.net/poem16133.html","الكامل"],[466,"تبلج وجه الدهر بعد قطوبه","https://www.aldiwan.net/poem16344.html","الطويل"],[556,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216404",""],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17044","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21671","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128717","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79949","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93688","البسيط"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105742","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79708","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103926","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117942","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117863","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21515","الهزج"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103803","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17779","الوافر"],[4773,"أشمس أفق تبدت أم محياك","https://www.poetsgate.com/ViewPoem.aspx?id=169635",""],[4797,"ماهوب كفو الوقت حبك يمحّيه","https://www.poetsgate.com/ViewPoem.aspx?id=50259",""],[5057,"شاخت أروى","https://www.poetsgate.com/ViewPoem.aspx?id=203629",""],[5206,"ضاق ذرعي","https://www.poetsgate.com/ViewPoem.aspx?id=148341",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5596,"ردي على قصيدة ناصر بن سعيد الرواحي","https://www.poetsgate.com/ViewPoem.aspx?id=206691",""]],"verses":[["كَذِئبِ الغَضا أَبصَرتَهُ عِندَ مَطمَعٍ","إِذا هَبَطَ البَيداءَ شَمَّ تُرابَها",0,"ب",3,0],["كَذي الظَلعِ إِن يَقصِد عَلَيهِ فَإِنَّهُ","يَهُمُّ وَإِن يَخرَق بِهِ يَتَيَمَّمِ",1,"م",1,0],["كَذي زادٍ مَتى ما يَكرِ مِنهُ","فَلَيسَ وَرائَهُ ثِقَةٌ بِزادِ",2,"د",1,0],["كذي جيفِ الغرقي إذا هي أنْتَنت","وأجوت بطون الماءِ تعلو طوافيا",3,"ي",2,0],["كَذي رَمَلٍ مِن وَحشِ حَومَلَ بَلَّهُ","أَهاضيبُ في قِسٍّ مِنَ الريحِ شامِلِ",4,"ل",1,0],["كَذِئابِ القَفرِ مِن طولِ الوَغى","وَاِختِلافِ النَقعِ لَوناً وَإِهابا",5,"ب",2,0],["كذي غَرَقٍ مَدّ الذراعينِ سابحاً","من الجوّ بحراً عَوْمُهُ ليس يُمكنُ",6,"ن",1,0],["كَذي الطَرائِدِ يَرميها إِذا اِنجَفَلَت","بِكُلِّ ضارٍ هَريتِ الشَدقِ طَيّانِ",7,"ن",1,0],["كَذي الأَفعى يُرَبّيها لَدَيهِ","وَذي الجِنِيِّ أَرسَلَها تُسابُ",8,"ب",1,0],["كَذي الظَنِّ لا يَنفَكُّ عَوضُ كَأَنَّهُ","أَخو جَهرَةٍ بِالعَينِ وَهوَ خُدوعُ",9,"ع",1,0],["كَذي الوَحدَةِ نَحّاني","هَواها فَتَنَحَّيتُ",10,"ت",1,0],["كَذي الطِبِّ تَعَنّاهُ","وَما بِالقَلبِ مِن طِبِّ",11,"ب",1,0],["كَذي الوَسواسِ لا يُعتِ","بُ مَن عاتَبَ أَو سَبّا",12,"ب",2,0],["كَذي القِرنَينِ لَكِن ضَلَّ هَذا","وَيُسَّرَ ذاكَ لِلرَأي السَديدِ",13,"د",1,0],["كَذي داءٍ بِإِحدى خِصيَتَيهِ","وَأُخرى ما تَشَكّى مِن سَقامِ",14,"م",1,0],["كذي زاد متى ما يكر منه","فليس وراءه ثقة بزاد",15,"د",1,0],["كَذِي الظَّنِّ لاَ يَنْفَكُّ كَأَنَّهُ","أَخُو جَهْرَة ٍ بالعَيْنِ وَهْوَ خُدُوعُ",16,"ع",1,0],["كذي رَمَدٍ على الضوءِ امتناعا","أخا سيشيلَ ، لا تذكرْ يحاراً",17,"ا",1,0],["كَذي قَبضَةٍ يَوماً عَلى عُرضِ هَبوَةٍ","يَشُدُّ عَلَيها كَفِّهُ بِالأَنامِلِ",18,"ل",1,0],["كذي هزالٍ خانهُ جسمهُ","فاستلفتَ الناسَ إلى ثوبهِ",19,"ب",2,0],["كذي جوهرٍ راز المعادن كلَّها","بتهذيبها كي تستتمَّ الفضائلا",20,"ل",2,0],["كذي شَمَطٍ يَستَسر المَشيبَ","إلى كَتمِ ما ليسَ بالكاتِمِ",21,"م",1,0],["كذئبِ النُميرَةِ لما أتى","يحاول قتل أبي عارمِ",22,"م",1,0],["كذي هيْدَبٍ جَوْنٍ تُخافُ بُروقُهُ","ويُرجى نداهُ ساجياً غير مُرْزِم",23,"م",1,0],["كذي شُطبٍ ماضي الغرارين مرهف","إذا هُزَّ للعلْياءِ راحَ مُصَمَّما",24,"م",2,0],["كَذِي ضنىً مُلقىً وَلَيتَ الّذي","سيطَ بِهِ جِسمكَ كانَ الضّنى",25,"ا",1,0],["كِذيه قعَّتْ سَكّنة «إلْييف»","من عقُب ذاك الوقت لي مَرّ",26,"ر",1,0],["كَذي دَلٍّ عَلَيهِ مُعَصفَراتٌ","يُدِلُّ عَلى المَشوقِ المُستَهامِ",27,"م",1,0],["كذي وتي ذهي تهي وذه وته","واكسرهما وتا وذات فانتبه",28,"ه",1,0],["كَذي الكَلمِ دامَلَهُ ثُمَّ خافَ","مِنهُ خِلافَ الجُفوفِ اِنتِكاثا",29,"ث",2,0],["كذي يزنٍ وذي جدن وذي","فايش مع ذي الكلاع وذي رعين",30,"ن",1,0],["كذئب الفضا تلقاه رخواً إذا مشى","ويشتدُّ إن واثبتَه وهو قاطع",31,"ع",1,0],["كَذي داءٍ يُرى في الناسِ يَمشي","وَيَكتُمُ داءَهُ زَمَناً عَميدا",32,"د",2,0],["كَذي يَدين أَمد اللَه واحِدة","بِقُوة البَطش والأُخرى التوت شَللا",33,"ل",2,0],["كذي الكلب لما اسمن الكلبَ رابَهُ","باحدى الدواهي حين فارقه الجهلُ",34,"ل",1,0],["كذي هم تعاطى الراح يوماً","فدان له مع الراح السرور",35,"ر",1,0],["كذئب خلا بالصيد حتى أضله","هزير له من جانب الغيل مطلع",36,"ع",1,0],["كذي رُمَلٍ فرْدٍ رمتْهُ عشيّةٌ","لها سبَلٌ مُستقبِلٌ وصَبيرُ",37,"ر",1,0],["كذي مروق وذي نكث أصر ومَن","بيت الهدى بأفاعي قسطهم لدغا",38,"غ",2,0],["كذي الثفنات الحبر والباقر الذي","أبان الهدى والصادق البحر جعفرا",39,"ر",2,0],["كَذِيِ الخَمرِ تَمَنّاها","وَقَد أُترِفَ ساقيهِ",40,"ي",2,0],["كذي دلال لم يستطع ارقا","فنام والنور واصل ارقه",41,"ق",2,0],["كَذيوميذَ وَأوذيسَ وَأَت","ريذَ مِن فُلكِهِمِ أَمّوا السُرى",42,"ر",2,0],["كَذِيُومِيذٍ وأَترِيذٍ أَيَاس","وَثَلاثاً كادَ يَندَكُّ الأَساس",43,"س",1,0],["كَذي الأُلّافِ إِذ أَدلَجنَ عَنهُ","فَحَنَّ وَلا يَتوقُ إِلى مَتاقِ",44,"ق",1,0],["كذي فقار علي يوم سل على","أصحاب بغي والحاد وإشراك",45,"ك",1,0],["كذيه ومن الله يازين وإليه","واغلى طروش القلب ودواه من داه",46,"ا",2,0],["كذِئابٍ في غفلَةِ راعٍ","تتصيّدُ آمِنَةً نشوى",47,"و",2,0],["كذئبٍ وخنزيرٍ وكلبٍ وثعلبٍ","وقردٍ ونمرٍ أرْقطٍ وشُجاع",48,"ع",1,0],["كذئبٍ يخاف الصيد إثر مجاعة","أتته ضباع الجوع بالصيد تبطشُ",49,"ش",1,0],["كذي همم باع النعيم ببلغة","وأسس صرحاً بالعلوم ينير",50,"ر",1,0]]}