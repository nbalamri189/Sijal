{"poems":[[95,"رأيت العروس وأترابها","https://www.aldiwan.net/poem11368.html","المتقارب"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[93,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[87,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[45,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[47,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[50,"أيا من كنت بالبصرة","https://www.aldiwan.net/poem62609.html","الهزج"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140929",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39661","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[119,"ان جزت في بطحاء ام عبيدة","https://www.aldiwan.net/poem41080.html","عموديه"],[242,"صلاة السميع العليم","https://www.aldiwan.net/poem19788.html","المتقارب"],[242,"عليه صلاة حليم","https://www.aldiwan.net/poem19790.html","المتقارب"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[285,"جرى لك بالتوفيق أيمن طائر","https://www.aldiwan.net/poem60716.html","الطويل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[445,"اسعد كما سعدت بك الأيام","https://www.aldiwan.net/poem34855.html","الكامل"],[447,"الحمد الله رب اللوح واللوح","https://www.aldiwan.net/poem14288.html","البسيط"],[509,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[519,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86758","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137590",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62559","المجتث"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107198","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56242","المجتث"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216725",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136209","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49920","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35798","الوافر"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26680","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28610","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122491","البسيط"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145868","المتقارب"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114308","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117285","الكامل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139755",""],[592,"اتاني تكتاب من صفى وذي ود","https://www.poetsgate.com/ViewPoem.aspx?id=128844",""],[5740,"تندغ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=211474",""],[5848,"محراب صمتك","https://www.poetsgate.com/ViewPoem.aspx?id=53163",""]],"verses":[["وَأَبْهَى ذَوَاتِ التَّجَلِّي بِهَا","عَلَى كُلِّ مُشْرِقَةٍ مَرْيَمُ",0,"م",1,0],["وأبْهَرُ نُوراً للعيون من الَّتي","تُضَاهِيهِ في العلياء حين تَكَبَّدُ",1,"د",1,0],["وابهجوا يا آل وهبٍ إنها","كَرَّةٌ رابحة لا خاسره",2,"ر",2,0],["وَأَبهى مِنَ الديباجِ وَالخَزِّ عِندَها","فَراشٌ مِنَ العُشبِ الخَضيلِ رَطيبُ",3,"ب",1,0],["وَأَبهى مِنَ الوَردِ تَحتَ النَدى","إِذا رَفَّ في فَرعِهِ الأَهدَبِ",4,"ب",1,0],["وَأَبهَرُ آياتِ التِهامِيِّ أَنَّهُ","أَبوكَ وَأَجدى مالَكُم مِن مَناقِبِ",5,"ب",1,0],["وأبهى رِباعاً وسْطَها ومنازلاً","وأزكى صُحوناً حولَها وهِضَابَا",6,"ب",2,0],["وَأَبهَجَنا ضَربُ الدَنانيرِ بِاسمِهِ","وَتَقليدُهُ مِن أَمرِنا ما تَقَلَّدا",7,"د",2,0],["وَأَبهى مِنكُمُ شَكلاً","وَأَحلى مِنكُمُ قَدّا",8,"د",2,0],["وأبهر آيات التهامى أنه","أبوك وإحدى ما لكم من مناقب",9,"ب",1,0],["وأُبهِمَ فهو رجْعُ صدىً وطيفٌ","بعيدٌ ليس يستجلِيهِ قُرْبُ",10,"ب",1,0],["وأُبْهِمَ حتى بانَ كالظلِّ طامساً","ودَاوَر حتى راغَ في الدَّوَرَانِ",11,"ن",1,0],["وابهج بظل ابي العريجا آمنا","وابشر فكل الصيد في جوف القرا",12,"ر",2,0],["وَأَبْهَجَ نَفْسِي بِمَا","يُبَصِّرُهَا مِنْ عَمَى",13,"م",2,0],["وَأَبْهِجْ بِذَاتِ الشَّمِيمْ","صَلاَةِ الرَّقِيبِ الشَّهِيدْ",14,"د",1,0],["وأبهج ما شاهدته ورأيته","نسورك في الأجواء تعلو تصخب",15,"ب",1,0],["وَأَبْهى مَحَلاً فِي الْقُلُوبِ وَمَوْقِعاً","وَأَشْهى إِلى لَحْظِ الْعُيُونِ النَّواظِرِ",16,"ر",1,0],["وَأبهجَ الدينَ والدنيا بكم شيمٌ","يَفري الفريُّ لهنّ العلمُ والحكمُ",17,"م",1,0],["وابْهَرْ بملك ثابتٍ أَركانُهُ","فِي باذخٍ للعزِّ لَيْسَ يُرَامُ",18,"م",1,0],["وأبهج الروض بالزهر النضير وبالن","نبت المماشج من غض ومن شيح",19,"ح",1,0],["وا بهجة سلب القلوب بلحظه","وبقده وبخده وبخاله",20,"ل",2,0],["واِبهَج بعيدٍ أنت أسنى غُرّة","منه وأبهى في القلوبِ وأبهَجُ",21,"ج",1,0],["وأبهجت أمري في البيان فصنته","وانكرت عرفا كنت قبل عرفته",22,"ه",1,0],["وَأَبهَج نظمٌ لِلجُنود ابتدعته","بذوق سَليم بِالنجاح معضَّد",23,"د",1,0],["وأبهنَ فاستشرفنَ لي من خلفها","من بينِ مسدلةِ النقابِ وحاسرِ",24,"ر",1,0],["وأبهر ما مر في خاطر","وكان نتاج النهى والغنى",25,"ن",2,0],["وأبهجت لي قلباً","فحِكْتُ للشيخ بُردا",26,"د",2,0],["وَأَبهَى ثَناءٍ نَغَّمَتهُ يَدُ الهَوى","وَأَلَّفتُ فيهِ بَعضَ أَوصافِكَ الحُسنى",27,"ن",2,0],["وأبهج الخلق طراً","زوال أهل الفجورِ",28,"ر",1,0],["وابهج قلبك نظرها","حسن وجَوٍّ لطيف",29,"ف",1,0],["وابهمها في الناس لطفا ورحمة","بهم وعليها دار حكم القضا القهري",30,"ر",2,0],["وابهَجْ بها من عَروسٍ في قلائِدها","وفي مجاسِدِها تَبقَى مدى الحُقُبِ",31,"ب",1,0],["وَأَبْهَجَتِ الأَبْصَارَ وَالْحُسْنُ مُبْهِجٌ","بِدُرَّيْنِ مِنْ عِقْدٍ نَفِيسٍ وَمِنْ ثَغْرِ",32,"ر",1,0],["وَأَبهى الناسَ سالِفَةً","وَمُبتَسماً وُمُلتَزما",33,"م",2,0],["وأبهَجَنَا طلوعهما بدستٍ","طلوعَ الأصلِ والفرعِ اتصالا",34,"ل",2,0],["وَأَبهى بَياناً فَوقَ أَعوادِ مِنبَرٍ","وَأَمضى جِناناً فَوقَ ظَهرِ حِصانِ",35,"ن",1,0],["وأبهَجَ المجلسَ الدَّرسيَّ تشهَدُهُ","أشتاتُ قومٍ لَنَفيِ الجَهلِ تلتَئِمُ",36,"م",1,0],["وأبهج أيامنا الخالدات","ومفخرة الجيش درع البلاد",37,"د",1,0],["وأبهمت أمرها عن الخلق جملة","سوى عارف صفى من كل علة",38,"ه",1,0],["وأبهمَ النُّصح عذَّالي بشقشقةٍ","وليتَ شقَّ الحشا من قبل نصحهمِ",39,"م",1,0],["وَأبْهَمْتُهُ عَنِ الوُشَاةِ مُوَرِّياً","لِإِشْكَالِهِ وَمَا هَوَى الصَّبِّ مُشْكلُ",40,"ل",1,0],["وابهج بشهر قد سعدت به تكن","للبان ثدى المعلوات رضيعا",41,"ع",2,0],["وأَبهم النصح عذالي بشقشقةٍ","وليت شقَّ الحشى من قبل نصحهم",42,"م",1,0],["وأبهرت الألبابَ منه مسائلٌ","به الفقه أضحى مسفراً عن محيّاه",43,"ا",2,0],["وأبهى من الروض الأنيق الذي جدت","عليه غواد بالهوامع والرعد",44,"د",1,0],["وأبهَجَ الكونُ دنياهُ بمقدمكم ..","ورش في جوها مسكا وريحانا",45,"ن",2,0],["وابهمس لك أحبك يا حياتي","وانا ودي عليها تسبقيني",46,"ن",2,0]]}