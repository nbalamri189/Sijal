iewPoem.aspx?id=180068",""],[3591,"ألم تزالوا على الحسن الذي سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=149466",""],[3591,"أشد عوادي الدهر خلق لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=149432",""],[5143,"أشدُّ قبالَ نَعْلي أنْ يراني","https://www.poetsgate.com/ViewPoem.aspx?id=186632",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[5277,"فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=185232",""],[5277,"صهيلُ الوتر","https://www.poetsgate.com/ViewPoem.aspx?id=186070",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[5411,"هذا نَصيبك منْ شِعْري","https://www.poetsgate.com/ViewPoem.aspx?id=185429",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5480,"عزوتي","https://www.poetsgate.com/ViewPoem.aspx?id=16305",""],[5491,"أحبك فوق ما تتصور","https://www.poetsgate.com/ViewPoem.aspx?id=215087",""],[5573,"ياهجسُ مالكَ لاتميلُ لراحتي","https://www.poetsgate.com/ViewPoem.aspx?id=213731",""],[5612,"بالبابِ باتَ العائدونْ","https://www.poetsgate.com/ViewPoem.aspx?id=179613",""],[5704,"اُسْكُبْ خمورك في كاسات آلامي٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204225",""],[5851,"قبس في منتصف الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=175274",""],[5853,"(((((هل تذكرين)))))","https://www.poetsgate.com/ViewPoem.aspx?id=175684",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5878,"مابين حتفين","https://www.poetsgate.com/ViewPoem.aspx?id=199190",""],[5926,"حر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213773",""],[5939,"اللغز السهل","https://www.poetsgate.com/ViewPoem.aspx?id=185490",""],[5956,"إلى الله تعالى كل فعل يصعد","https://www.poetsgate.com/ViewPoem.aspx?id=192595",""],[6019,"رمادٌ تدره الرياح","https://www.poetsgate.com/ViewPoem.aspx?id=53048",""],[6131,"الجذرُ..العتيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=189264",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[313,"أنت وغيرك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66506&r=&rc=28",""],[6213,"ما أحيلاه العناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76271&r=&rc=28",""],[6259,"فؤادي الفداءُ لها من قببْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59354&r=&rc=2",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[402,"كلانا فاقد أما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54008&r=&rc=860",""],[454,"يئس الصغار من الكبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82661&r=&rc=25",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[147,"شفاءُ الهدى ياسيفهُ العضبَ أنْ تشفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27434&r=&rc=1",""]],"verses":[["أشَدُّهُمُ إذا اجتَلَدوا قِتالاً","وأوثَقُهُمْ إذا عَقَدوا حِبالا",0,"ل",2,0],["أَشَدُّ حَياءً مِن فَتاةٍ حَيِيَّةٍ","وَأَمضى مَضاءً مِن سِنانٍ مُؤَلَّلِ",1,"ل",1,0],["أَشَدَّ عَلى صُروفِ الدَهرِ أَيداً","وَأَفصَلَ في الخُطوبِ بِغَيرِ لَبسِ",2,"س",1,0],["أَشَدَّ القَتْلِ لِلْمَنْطِيقِ","فِيهَا قَتْلُهَا غِلْمَا",3,"م",2,0],["أَشَدَّ إِذا ما اِستَحصَدَ الحَبلُ مِرّةً","وَأَجبَرَ لِلمُستَجيرينَ الضَرائِكِ",4,"ك",1,0],["أَشَدُّ اِمرِئٍ قَبضاً عَلى أَهلِ ريبَةٍ","وَخَيرُ وُلاةِ المُسلِمينَ المُهاجِرُ",5,"ر",1,0],["أَشداقُها كَصدوع النَبعِ في قُلَل","مِثلِ الدَحاريجِ لَم يَنبُت لَها زَغَبُ",6,"ب",1,0],["أَشِدَّةٌ ما أَراهُ مِنكَ أَم كَرَمُ","تَجودُ بِالنَفسِ وَالأَرواحُ تُصطَلَمُ",7,"م",1,1],["أَشَدُّ الفارِسينَ وَإِن أَبَرّوا","أَخَفَّ الفارِسينَ إِلى الصِياحِ",8,"ح",1,0],["أشدّ من ألف في الكفّ يكرع من","نون وأمنع يوم الرّوع من لام",9,"م",1,0],["أشدْ بأيامنا لتشهرَها","وقلْ بها معلناً لتظهرَها",10,"ر",3,1],["أشد من السيل الغَشَمْشَم حملةً","وأثبتُ من بعض الأسود الرهائص",11,"ص",1,0],["أشدُّ لنيل المجدِ رحلي مُشمِّراً","وهل بعده شيءٌ أشدُّ له غَرضِي",12,"ض",2,0],["أشدُّ ما بيَ مِنْ شَكْوٍ ومن ألمٍ","فَقْدي جَنَى مقلتِي من وجهِكَ الحَسَنِ",13,"ن",1,0],["أَشَدُّ مِنَ الدَهرِ مكراً بَنوهُ","فَوَيلٌ لِمَن لَيسَ بِالماكِرِ",14,"ر",1,0],["أشدُو برنّاتِ النِّياحَةِ والأسى","مشبوبةً بعواطفي وشُعوري",15,"ر",2,0],["اشدو بمالهن من","حسن ومن مناقب",16,"ب",1,0],["أَشَدُّ مِنَ الرِياحِ الهوجِ بَطشاً","وَأَسرَعُ في النَدى مِنها هُبوبا",17,"ب",2,0],["أَشَدُّ عَصفِ الرِياحِ يَسبِقُهُ","تَحتِيَ مِن خَطوِها تَأَيُّدُها",18,"د",3,0],["أَشَدُّهُمُ في النَدى هِزَّةً","وَأَبمَدُهُم في عَدُوٍّ مُغارا",19,"ر",2,0],["أَشَدُّ الغَمِّ عِندي في سُرورٍ","تَيَقَّنَ عَنهُ صاحِبُهُ اِنتِقالا",20,"ل",2,0],["أَشَدَّ تَنازُعاً لِكَريمِ أَصلٍ","وَأَشبَهُ مَنظَراً بِأَبِ هِجانِ",21,"ن",1,0],["أَشَدُّ البَرايا بِالعِبادِ تَهاوُناً","وَأَسفَكُهُم ظُلماً دِماءَ ذَوي الوُدِّ",22,"د",1,0],["أَشِدّاءَ ما شَدّوا كَأَنَّ قُلوبَهُم","وَآراءَهُم في الحَربِ يُنحَتنَ مِن صَخرِ",23,"ر",1,0],["أَشَدُّهُمُ لِلحَربِ إِتقانَ عُدَّةٍ","وَأَثقَبُهُم فيها اِشتِعالَ ذُبالِ",24,"ل",1,0],["أَشَدَّ تَقَرُّباً مِن كُلِّ حَمدٍ","وَأَبعَدَ مَنزِلاً مِن كُلَّ ذامِ",25,"م",1,0],["أَشَدُّ حِبالٍ بَينَ حَيَّينِ مِرَّةً","حِبالٌ أُمِرَّت مِن تَميمٍ وَمِن كَلبِ",26,"ب",1,0],["أَشَدَّ قُوى حَبلٍ لِمَن يَستَجيرُهُ","وَأَطوَلَ إِذ شَرُّ الحِبالِ قَصيرُها",27,"ر",3,0],["أَشَدُّ الناسِ يَومَ البَأسِ كَلبٌ","وَأَثقَلُهُ مَوازينُ الحُلومِ",28,"م",1,0],["أَشَدَّ عَلى صُروفِ الدَهرِ إِدّاً","وَخَيراً في الحَياةِ وَفي القُبورِ",29,"ر",1,0],["أَشدُد حيازَيمكَ لِلمَو","تِ فَإِنَّ المَوتَ لاقيكا",30,"ك",2,1],["أَشَدُّ الجِهادِ جِهادُ الهَوى","وَما كَرَّمَ المَرءَ إِلّا التُقى",31,"ا",1,1],["أَشَدُّ الناسِ لِلعِلمِ اِدِّعاءً","أَقَلُّهُمُ بِما هُوَ فيهِ عِلما",32,"م",2,0],["أَشَدَّ وِطاءً","وَأَقوَمَ قيلِ",33,"ل",1,0],["أَشدو بِمَدحِكُمُ حُبّاً وَبي مِحَنٌ","لَو أَنَّ أَيسَرَها بِالوُرقِ ما صَدَحَت",34,"ت",1,0],["أَشَدُّ اِزدِلافاً بَينَ دِرعَينِ مُقبِلاً","وَأَحسَنُ وَجهاً بَينَ بُردَينِ مُحرِما",35,"م",2,0],["أُشدُد يَدَيكَ بِحَبلِ نوحٍ مُعصِماً","تَلقاهُ حَبلاً بِالنَدى مَوصولا",36,"ل",2,0],["أَشَدُّ مِنَ الصُّخُورِ الصُّمِّ قَلْبِي","وَأَرْهَفُ مِنْ شَبَا سَيْفِي لِسَانِي",37,"ن",2,0],["أَشَدْتَ بِذِكْرِي بَادِئاً وَمُعَقِّبَاً","وَأَمْسَكْتُ لَمْ أَهْمِسْ وَلَمْ أَتَكَلَّمِ",38,"م",1,1],["أَشُدُّ بِأَعناقِ النَوى بَعدَ هَذِهِ","مَرائِرَ إِن جاذَبتُها لَم تَقَطَّعِ",39,"ع",1,0],["اشْدُدْ يديكَ عليه إنّ غِرارَهُ","حَتْفُ الظَّلومِ ومَصرعُ المُتَمرِّدِ",40,"د",1,0],["أشدو بذكركِ في الحوادثِ عاطلاً","والصّامتُ اللَّاهي بغيركِ حالِ",41,"ل",1,0],["أَشَدُّ خَطبٍ يُتَّقى","فِراقُ روحٍ لِجَسَد",42,"د",1,0],["أُشدُد يَدَيكَ بِما أَقو","لُ فَقَولُ بَعضِ الناسِ دُرُّ",43,"ر",1,1],["أَشَدُّ عِقاباً مِن صَلاةٍ أَضَعتَها","وَصَومٍ لِيَومٍ واجِبٍ ظُلمُ دِرهَمِ",44,"م",1,1],["أشَدُّ الرّزايا عندَهُ عَقْرُ نابِهِ","وأبْعَدُ شيءٍ ضَيْفُه مِن طَعامِهِ",45,"م",2,0],["أشَدَّ على مَن حارَبَتْه تسلّطاً","وأبْعَدَ منها في البلادِ مُغارا",46,"ر",2,0],["أشدّهم في النّدى هزّةً","وأبعدهم في عدوٍّ مغارا",47,"ر",2,0],["أَشدّ على قواضبها مراساً","وأَنفذ مِن مضاربها هُمامهْ",48,"م",2,0],["أشدو فيلقي إليّ الكون مسمعه","يصغي إليّ كما أصغي لك الآنا",49,"ن",2,0],["أشَدتُ بما شِدتم فرادى وكلكم","يُفاخر جيلٌ بالذي هُو باني",50,"ن",2,0],["أَشَدُّ خَلْقِ اللهِ كِبْراً فَإِنْ","فَاجَأْتَهُ كَرَّ عَلَى عَقْبِهِ",51,"ب",2,0],["أَشَدُّ مَضَاءً مِنْ فُؤَادِي عَلَى الْعِدا","وَأَبْطَأُ نَصْرِي عَلَى الشَّوْقِ مِنْ فِنْدِ",52,"د",1,0],["أشَدَّ بَسَالةً مِنّا إذا ما","أَرَدْناهُ وأَلْيَنَ في الوِدادِ",53,"د",1,0],["اشدو... ويسري اللحن في النسيمْ","لحني القديمْ- عبدالحليم! -",54,"م",1,0],["أشداء ما باهى الجهادُ بمثلهم","وهم بينهم في أمرهِم رُحماءُ",55,"ا",2,0],["أَشْدُوا فَإِنْ شِئْتَ أَن تُصْغِي لِسَاجِعَةٍ","مِنَ الْخُلُودِ فأَنْصِتْ تَحْتَ أَوْكَارِي",56,"ر",2,0],["أشدُّ الجِهَادِ جهادُ الورَى","ومَا كرَّمَ المرءَ إلاَّ التُّقَى",57,"ا",1,1],["أَشَدُّهُمُ في النَدى هِزَّةً","وَأَبدُهُمْ في عَدُوٍّ مُغارا",58,"ر",2,0],["اَشَدُّهُمُ لِلحَرْبِ إِتقانَ عُدَّةٍ،","وأَثْقَبُهُمْ فِيها اشْتِغالَ ذُبالِ",59,"ل",1,0],["أَشَدَّ طِبَاقٍ فِي الطَّوِيَّةِ وَالشَّكْلِ","نَعَمْ هِيَ لَيْلَى لَكْنِ الآنَ تَكْذِبُ",60,"ب",1,0],["أَشْدُو فَإِنْ شِئْتَ أَن تُصْغِي لِسَاجِعَة ٍ","مِنَ الْخُلُودِ فأَنْصِتْ تَحْتَ أَوْكَارِي",61,"ر",2,0],["أشدو بذكرك في الجوادث عاطلا","والصامت اللاهي بغيرك حال",62,"ل",1,0],["أَشدو وَتَشدو حَمامات الأَراك وَما","أَشجان هاتيك إِلّا بَعض أَشجاني",63,"ي",1,1],["أَشُدُّ عَلى صَروفِ الدَهرِ إِدّاً","وَآمَرَ مِنهُم فيها بِصَبرِ",64,"ر",1,0],["أَشَدَّهُمُ كَفّاً لِنائِبَةٍ عَرَت","وَأَنداهُمُ إِن سيلَ مَكرُمَةً كَفّا",65,"ف",2,0],["اشددْ يديك بحبل ربك واثقاً","بضمانِه فهو الوفيُّ ضَمانا",66,"ن",2,0],["اشدد يدْيكَ بحبلِ منهُ معتصماً","تجدْهُ بالجودِ موصوَلاًفما قَطعا",67,"ع",2,0],["اشدد بعروتهيديك إذا عرا","خطب فعروته الوثيقة في العرا",68,"ر",2,0],["اشدد يديك بحبلهم مستعصما","تلقاه حبلا بالندى موصولا",69,"ل",2,0],["اشدد يد الرجوى إليه وناده","ان الكريم يجيب من ناداه",70,"ا",2,0],["أَشَدُّ فِعلاً مِنَ الأَسيافِ حَيثُ بَدا","أَجلى وَأَشرَقَ رَأياً مِن خَواشيها",71,"ي",3,0],["أشدّ من خفت منه مكرا","من كنت في زعمه صديقه",72,"ق",2,0],["أشدّهم رغبة في ودّ صاحبه","عند الرخاء وفي اللأواء لا ورر",73,"ر",1,0],["أشدّ من صعقة القبور","دخول همّ على سرور",74,"ر",1,1],["أشدّ ممّا لقيت أخشى","وكل ما لم يطق شديد",75,"د",1,1],["أَشدُّ منَ الكفّار فينا نكايةً","وَأَعظم مِنهم في دِيانتنا ضرّا",76,"ر",2,0],["أَشدُّ رحالي كَي أَرى البدر مشرقاً","بِمطلعهِ فيها وما ضرّه العوّا",77,"و",2,0],["أشدو وكَم أسكَرتُ أرواحنا","بموسيقى ابتِكاري",78,"ر",2,0],["أَشُدَّ عَلى الكَتيبَةِ لا أُبالي","أَحتَفي كانَ فيها أَم سِواها",79,"ا",3,0],["أشدو بحسن أصيل في بدائعه","ومن بدائعه قد كان ديواني",80,"ي",1,0],["أَشَدَّ نَفاراً مِن جُفوني عَنِ الكَرى","وَأَضعَفَ مِن عَزمي عَلى الصَبرِ مُشتاقا",81,"ق",2,0],["أشد ما كان من نوائبه","فقد قريب وقرب منفقد",82,"د",1,0],["أَشِدْ بِالقَوَافِي ذِكْرَ علْوَةَ أَوْ عَلْيَا","وَ