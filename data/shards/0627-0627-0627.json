{"poems":[[112,"أحسد الاغبيا","https://www.poetsgate.com/ViewPoem.aspx?id=8403",""],[4869,"برد المسا","https://www.poetsgate.com/ViewPoem.aspx?id=138047",""],[4869,"بدويّه","https://www.poetsgate.com/ViewPoem.aspx?id=162816",""],[5039,"المسامح كريم","https://www.poetsgate.com/ViewPoem.aspx?id=48114",""],[5431,"الله رمى....","https://www.poetsgate.com/ViewPoem.aspx?id=213796",""],[5526,"انكسار الشم انوف","https://www.poetsgate.com/ViewPoem.aspx?id=192756",""],[5704,"غابوا...","https://www.poetsgate.com/ViewPoem.aspx?id=197401",""],[5764,"قلبي كما هو","https://www.poetsgate.com/ViewPoem.aspx?id=161548",""],[5818,"الشعب واللص","https://www.poetsgate.com/ViewPoem.aspx?id=199688",""],[5848,"بدون","https://www.poetsgate.com/ViewPoem.aspx?id=53182",""],[5848,"أنا اقصد حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=52026",""],[5848,"صباحات معتقه","https://www.poetsgate.com/ViewPoem.aspx?id=53201",""],[5848,"اطيب قلب","https://www.poetsgate.com/ViewPoem.aspx?id=53168",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""],[6056,"الجبين المستدير","https://www.poetsgate.com/ViewPoem.aspx?id=130330",""],[6056,"عشراء الركاب","https://www.poetsgate.com/ViewPoem.aspx?id=130349",""],[6056,"معاذير العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=130352",""],[6056,"جرح السنين","https://www.poetsgate.com/ViewPoem.aspx?id=130356",""],[6056,"مجاريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=130501",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6056,"مفهوم المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=130509",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""],[6113,"وافرض","https://www.poetsgate.com/ViewPoem.aspx?id=58847",""]],"verses":[["أأأتفيقر بالمشاعر.. والاّ قلبي ..مرهي","مستعد أأأعشق بيتن .. تستحي ... جدرانه",0,"ن",2,0],["آآآه لو تصفا الليآلي للمرآح","وتعود لي وْاعود لآ افرآح المسآ",1,"س",2,0],["آآآه منها ترمي العقل بخطيّه","وكم خطآيا تنسري لأجل الطرآوه",2,"ا",3,0],["آآآآه .. ياوالله اللي صرت عقبي يتيم","والله إن مايحبك مثل قلبي حبايب",3,"ب",1,0],["آآآهٍ إذا ما قطعته إربا","لا ليس يشكو يلقاك مبتسما",4,"م",2,0],["اااه ياكثر اللي فيني وفيني منك حاجتين","فيني أغصان الورود ونوتة أنغام وعزوف",5,"ف",1,0],["آاااهٍ وألف من رحيل أحبتي","فله بروحي حرقة تنسابُ",6,"ب",1,0],["اااالله ياهو قلب أبيض وياهوّ","كامل لو أنه مابه إنسان كآمل",7,"ل",1,0],["آآآهٍ من الجوع منّا من هزائمنا","أوّاه يا صاح هذا الجرح كم نزفا",8,"ف",2,0],["آآآآه يا ليت لي قدره واشد الرحال","نوب اشرق / واغرب لا تضايقت نوب",9,"ب",1,0],["آآآآه يا كبر جرح مرني من خلال","يا ( بنود ) او ( بدون ) وكلبوهن ذنوب",9,"ب",1,0],["آآآه من ضيقتي وآآهين مما يريب","صدر عاشق من انفاس المحبة يذوب",10,"ب",1,0],["آآآه تولد ... وآآآه تدفن ب صدرٍ ما يضيق","وانت صوتك ينتشلني ... من يدين الزحام",11,"م",1,0],["آآآه من قسوتك وآآآهين من ضيق المكان","يوم صار الكون سجني وسجّاني يمون !",12,"ن",1,0],["آآآآه ياقلب العنا ، وش جاك ماعد بك تأنىّّ","وأنا خبري بك ثقيل ٍ ، بالتصرف ومتأنيّ",13,"ن",2,0],["آآآآه يانار بصدري الحشا منها يكوّى","من لهبها ذاب قلبي والسراجيف انكوو",14,"و",2,0],["آآآه ياقلب العنا مطلبك أصبح سراب","درب شايك والعشاشيق وسطه ضايعين",15,"ن",1,0],["آآآه ، يا دنيا التعاسة والعذاب","ما تهنيت ،، بحياتي لو دقيقة",16,"ق",2,0],["آآآه أنا عزّي لحالي من شقا جرح السنين","السنين اللي انقضت من مشكلة في مشكلة",17,"ل",2,1],["آآآه يا كل الغلا ،، يا بعد خلاّني وهلي","عاذلي عن شوفتك بالناس مقطوع النصيب",18,"ب",1,0],["آآآه ، يا وقتي اللي راح ، كله نكود","فيه ، زهرة شباب العمر ، أفنيتها",19,"ت",3,0],["آآآآه ياسعدي وهنايه من بعد هالصبر كلّه","عادت أيام السعادة تبتسم لي والأماني",20,"ن",2,1],["أ / أأن الأنة وأن الأنين بإن أنّي آه","أواني آن لأن الآن أناني مأنّيني",21,"ن",2,1],["آآآه من ريحةعطرهايخطف قلوب عصيه","حتى ابونوره بنفسه شافهاوغنى لها",22,"ل",3,0]]}