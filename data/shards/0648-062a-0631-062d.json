{"poems":[[68,"هجرت بعدك القلوب الجسوما","https://www.aldiwan.net/poem40293.html","الخفيف"],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[186,"مقل في دجى العرور نيام","https://www.aldiwan.net/poem67032.html","الخفيف"],[308,"أما ترثي لجسم عاد رثا","https://www.aldiwan.net/poem58149.html","الوافر"],[422,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[520,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59245","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64730","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64566","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108719","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147326","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48455","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138576",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216512","الطويل"],[3732,"","https://poetry.dctabudhabi.ae/diwan/poem/131939","الرمل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107289","الكامل"],[4682,"يامرحبا في حرب","https://www.poetsgate.com/ViewPoem.aspx?id=85373",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[5038,"سر فنجاني","https://www.poetsgate.com/ViewPoem.aspx?id=189965",""],[5055,"الفردوس لروح الأستاذ / ناصر البلال","https://www.poetsgate.com/ViewPoem.aspx?id=100736",""],[5135,"غريبٌ أمرُ عالمنا","https://www.poetsgate.com/ViewPoem.aspx?id=201798",""],[5348,"مسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=59561",""],[5480,"تغاريد الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=1145",""],[5480,"صوغ الألماس","https://www.poetsgate.com/ViewPoem.aspx?id=29629",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[6029,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=189441",""],[6032,"لماذا وحين","https://www.poetsgate.com/ViewPoem.aspx?id=181502",""],[6093,"تحج نوايا لا مطايا تقلها","https://www.poetsgate.com/ViewPoem.aspx?id=205931",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6271,"زمان الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80699&r=&rc=5",""]],"verses":[["وَتَرَحَّلتَ عَن فِنائي رَحيلاً","صَيَّرَ الحُزنَ في الفُؤادِ مُقيما",0,"م",2,0],["وترحموا كرماً علي","ي برحمة ألقى صفاها",1,"ا",3,0],["وَتَرَحَّلتَ نَحوَ رَبِّكَ تَبغِي","عِندَهُ الخُلدَ وَالحَياةُ لِمامُ",2,"م",1,0],["وترحم ذا دموع فيك أضحت","تحث على البكاء دما وتحثى",3,"ث",2,0],["وترحَّلت بي عن مَباركِها","ولاّجة في المهمه القفر",4,"ر",1,0],["وترحلت سكانها عنها إلى","دار بعز القاسطين وصالها",5,"ل",3,0],["وترحلت من بعد ما زودتها","بر التهجد والأنام هجود",6,"د",1,0],["وَتَرَحَّلَت مَعَهُ المَكارِمُ كُلُّها","لَمّا أَجَدَّ فَأَزمَعَ التَرحالا",7,"ل",2,0],["وَتَرَحَّلَتْ عَنْهُمْ رَكَاِئِبُنَا فَهَلْ","لِي بَعْدَ بُعْدِ المُلْتَقَى أنْ نَلْتَقِي",8,"ق",2,0],["وتَرَحَّ مِنْ عَرَضِ الدُّنا","بالقُرْصِ والماءِ النُّقاخِ",9,"خ",1,0],["وترحم تضراعي وطول تبتلى","بأسمائك الحسنى لديك وتقبلا",10,"ل",2,0],["وترحم صبّاً فارق الصبر قلبه","وفارقه القلب الذي فارق الصبرا",11,"ر",2,0],["وترحم بؤسي، في مصاب وفاجع","فمن راحمي في أحلك الظلمات؟",12,"ت",1,0],["وَتَرْحَلُ الرُّوحُ فِي مَوجٍ غَمَامَتُهُ","حَلاوَةُ الشِّعْرِ إِذْ أُلْقِي بِمنْسَأَتِي",13,"ت",2,0],["وترحّلَ الشهْر الكريمُ مؤكّداً","لك من رضاهُ مواثِقاً وعُهودا",14,"د",2,0],["وترحلت من كربلا ورؤوسها","فوق الرماح وثقلها منهوب",15,"ب",1,0],["وترحم أحياناً وفيك قساوة","وأنت بأن تقسو جدير وترحما",16,"م",2,0],["وترحلت لاحراز العلا","فافترقنا والهوى ما افترقا",17,"ق",2,0],["وتَرَحَّلوا عنهُ ولم يَتَلفَّتُوا","كرماً لِطِيبِ مَساكِنٍ وضِياعِ",18,"ع",1,0],["وترحيبة اللي خايل الغيم من غرب","يوم استهل بمكرمات المزوني",19,"ن",2,0],["وَتَرْحَلُ كُلُّ ذُيُوْلِ القُرُوْدِ","وَمَنْ كَاْنَ كَالْقِرْدِ خَوْفاً يًجَرّْ",20,"ر",1,0],["وترْحل دونَ توديعي","وليلُ الصبّ أضْواني",21,"ن",2,0],["وترحل في جنان الخلد على جنح التقى والدين","عسى تنظر لوجه الله يقيناً دون ماحجابا",22,"ب",2,0],["وترحلُ عنْ مرابعهمْ سنيناً","وتلقاهمْ كأنكَ لا تغيبُ",23,"ب",1,0],["وترحل في ظلّهن قلوب","وتلهث من دونهن بحارْ",24,"ر",1,0],["وترحل بي هموم الكل فبحري وأضرب المجداف","أسافر يا \"حميد\" اليوم بحزني وقت الأسحاري",25,"ر",2,0],["وترحيبتن تضفي على فوعة الياس","وأحلى من العطر المخضب زبادي",26,"د",2,0],["وترحلُ عنّي كالرياحِ مواجعي","فترجعُ إعصارا يُعانقُ إعصارا",27,"ر",2,0],["وترحّموا للراحلي","ن فرحمة المولى انسكاب",28,"ب",1,0],["وترحَّلَتْ روحي الهمومُ ولم تزَلْ","تجري بها في الحِلِّ والأسْفارِ",29,"ر",1,0],["وترحلُ عني كأن لم تكنْ","أتوه بدرب الخطى العاثره",30,"ر",2,0],["وترحلُ بعدَ الحجِّ قافلةُ المُنَى","فيرفعها نَجْدٌ ويُقْبِلُ سهلُها",31,"ل",3,0],["وَتَرحل بعدما هي عنوبي وَلا لَنا","وَينكعوها بالرسن وَزمام",32,"م",1,0],["\" وترحل .. صرختي تذبل بوادي \"","ونكس رأسه الصبح الكئيب",33,"ب",1,0]]}