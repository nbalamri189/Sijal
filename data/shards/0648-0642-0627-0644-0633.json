{"poems":[[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43900","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[325,"أتيت دمنهورا أروح بالصفا","https://www.aldiwan.net/poem61631.html","الطويل"],[353,"تخلو همومي بي وأخلو بها","https://www.aldiwan.net/poem20022.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66816","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86685","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77658","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77634","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112888","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108539","الطويل"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122426","الطويل"],[2738,"","https://poetry.dctabudhabi.ae/diwan/poem/142668","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65492","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206141","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131294",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[6115,"ياوجودي وجد من ضيع احذي","https://www.poetsgate.com/ViewPoem.aspx?id=180519",""]],"verses":[["وَقالَ سَأَقضي حاجَتي ثُمَّ أَتَّقي","عَدُوّي بِأَلفٍ مِن وَرائِيَ مُلجَمِ",0,"م",1,0],["وقال سِرْ يا رسولي فَانْهَ صَاحِبَنَا","عَنِ القِتالِ فَحَسبي ما جَنَى وكَفَى",1,"ف",2,0],["وَقالَ سَوفَ أَفتَحُ السَوادا","وَأَملِكُ العِبادَ وَالبِلادا",2,"د",2,0],["وقال سلامٌ والثَّواب جزاءُ مَن","ألمَّ عَلى قبرِ الغَريبِ فَسلَّما",3,"م",2,0],["وقال سيأتينا من الصين خاتم","من الأوليا للأولياءِ الأكابر",4,"ر",1,0],["وَقالَ سَأَكفيكَ العَنا بِنُعاسِها","وَأُقسِمُ بِالعَينَينِ وَهوَ يَمينِ",5,"ن",1,0],["وَقَالَ سَامَرْتُ نُجُومَ السَّمَا","مُذْ غَرَّبَتْ عَنْكَ بُدورُ السَّمَاحْ",6,"ح",1,0],["وقال سري عندكم علانية","أن الذي كنى لكم معاوية",7,"ه",1,0],["وقال سَتُنبحين كلابَ قومٍ","من الأعرابِ والمتعرَّبينا",8,"ن",2,0],["وقالَ سَتركبين على خِدبٍّ","يُسمى عَسكراً فَتُقاتلينا",8,"ن",2,0],["وَقال سيجزيني المَليك بفعلَتي","فَقالَ سَأَعفو عَنكَ حالاً وَأَصفح",9,"ح",1,0],["وَقالَ سِر لا سارَ إِلّا رَسمُك","وَلا غَدا بَينَ الحَمير اِسمُك",10,"ك",1,0],["وَقالَ سَيدهم ماذا دَعاك إِلى الن","نِداء يا صاحب البُستان قُل تجدِ",11,"د",1,0],["وقُ السوء والزلات يا رب رحمة","وجنب من الأعراض عنك من الونى",12,"ن",2,0],["وقال سفيه القوم جرعك الهوى ال","هوان ألا تقوى عليه بسلوة",13,"ه",1,0],["وقال سأُعطي الرايةَ اليومَ صارِماً","كميّاً مُحِبّاً للرسولِ مُواليا",14,"ي",2,0],["وقال سلوت متهماً غرامي","ولست وإن سلا عنّي بسالي",15,"ل",2,0],["وقال سائقهُ للبرق سيرك ذا","وراء خطوي ولو أمشي على مهل",16,"ل",1,0],["وقال سيدنا المختار في خبر","سموا باسمى فان تختر به اتسم",17,"م",1,0],["وقال سيروا أنا معكم بلا جزعِ","تسهَّموا الأرض وادعوا سائر الأممِ",18,"م",1,0],["وقال سلام قلت فاسلم وإن يكن","دعائي لميْتٍ بالسلامة واهيا",19,"ي",2,0],["وقال سواهم إنما هي مومسٌ","ابت من قبيح الاثم ان تتحرجا",20,"ج",2,0],["وَقَاْلَ: سَلِّمْ عَلَىْ عَفْرَاْءَ إِنْ رَفَعَتْ","رَأْساًº وَأَعْصَتْ قَوَاْنِيْنَ الَّذِيْ مَرِضَاْ",21,"ض",2,0],["وقال سدد قبل تاجيك مثنيه","بالدبل لو كنت بالحيل فقراني",22,"ن",2,0]]}