tps://www.aldiwan.net/poem47353.html","الكامل"],[549,"من مبلغ عني بنى مالك","https://www.aldiwan.net/poem47397.html","السريع"],[549,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[559,"أنيخ مسحول مع الصبار","https://www.aldiwan.net/poem27822.html","الرجز"],[565,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[565,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"],[573,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[585,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["وَمَن مَطَلَ الدُيونَ أَعَدَّ صَبراً","عَلى عَنَتِ المُطالِبِ وَالغَريمِ",0,"م",1,0],["وَمَن ماتَ لَم يَعلَم وَقَد عانَقَ الثَرى","بَكاهُ خَليلٌ أَم سَلاهُ خَليلُ",1,"ل",1,0],["وَمِن مَأثُراتٍ غَيرَ هاتيكَ لَم تَزَل","لَها عُنُقٌ عالٍ عَلى الناسِ مُشرِفُ",2,"ف",1,0],["وَمَن ماتَ في حَبسِ المَذَلَّةِ قَلبهُ","رَأى العِزَّ في دارِ المَذَلَّةِ مَولِدا",3,"د",2,0],["وَمِن مَشرَبٍ أَنبَطتُ يَنبوعَ مائِهِ","بِأَعلى الرَوابي وَالرِياضِ الأَثائِثِ",4,"ث",1,0],["وَمِن مُهجَةٍ لا تَرأَمُ الضَيمَ مَرَّةً","يُعَجِّلُ عَن دارِ المَذَلَّةِ نَهضَتي",5,"ي",1,0],["وَمِن مَخافَةِ بَينٍ كُنتُ أَحذَرُهُ","لَم أَذكُرِ القَدَّ كَي لا أَذكُرَ البانا",6,"ن",2,0],["وَمَن مَلَكَ البَرقَ المُرَجّى نَوالُهُ","نَدىً لَم يُراقِب دونَ نَفحَتِهِ الرَّعدُ",7,"د",1,0],["ومنْ مُوقِديها غادَةٌ دونَها الظُّبا","تَلوحُ بأيْدي غِلْمَةٍ غيرِ أنْكاسِ",8,"س",1,0],["ومِنْ مَساعيكَ فَتْحٌ إذ سَلَلْتَ لهُ","رَأياً فَلَلتَ به الصّمْصامَةَ الخَذِما",9,"م",2,0],["وَمِن مُخطِئٍ حينَ طابَت لَهُ","فَظَلَّ لِما فاتَ مِنها حَزينا",10,"ن",2,0],["وَمَن مَوعِدُهُ دانٍ","وَجَدواهُ مَعَ النَجمِ",11,"م",1,0],["وَمَن مَنَحَ الجُهّالَ عِلماً أَضاعَهُ","وَمَن مَنَعَ المُستَوجِبينَ فَقَد ظَلَم",12,"م",1,0],["وَمَنْ مِثْلُ إِبْرَاهِيمَ فِي ثَبْتِ مَوْقِفٍ","إِذَا مَا الْتَقَى فِي مَوْقِف الْحَرْبِ صَفَّانِ",13,"ن",1,0],["وَمَنْ مِثْلُهُ قَدْ أَعْجَزَ الدَّهْرَ مِثْلُهُ","إِ ذَا ذُكِرَ الْعَزْمُ الصَّرِيحُ أَوِ الْحَزْمُ",14,"م",1,0],["ومن مؤثل جاه في تجارته","أو في صناعته أغنى الحمى وغنى",15,"ن",2,0],["وَمَنْ مَنَاقِبَ أَزْكَاهَا وَأشْرَفَهَا","تَكَرُّمُ الطَّبْعِ عَنْ حِقْدٍ وَعَنْ غَضَبِ",16,"ب",1,0],["ومن مثل جرح طاهر النفس والهوى","ومن مثله حر ومن مثله نجد",17,"د",1,0],["وَمِنْ مُسْرِفٍ فِي النَّدَى وَالفِدَى","لِكُلِّ لَهِيفٍ وَكُلِّ مَضِيمِ",18,"م",1,0],["وَمِنْ مُتَقَاضٍ شَدِيدِ المِرَاسِ","وَمِنْ مُتَغَاضٍ غَفُورٍ رَحِيمِ",18,"م",1,0],["وَمِن مُلَمَّعَةٍ غَبراءَ مُظلِمَةٍ","تُرابُها بِالشِعافِ الغُبرِ مَعصوبُ",19,"ب",1,0],["ومن مبكيات الدهر أو مضحكَاته","لدى الناس حرٌّ لم يكن خصمه حرا",20,"ر",2,0],["ومن مبلغ عنا السَنوسيّ أنه","يمدّ لهذا الصدع منه يدَ الرَأب",21,"ب",1,0],["ومن مضحكات الدهر حامل سُبحة","تُقبَّل جهلاً كفّه للتبرُّك",22,"ك",1,0],["وَمَن مُكرِهي إِن شِئتُ أَن لا أَقولُهُ","وَفَجعُ الأَمينِ شيمَةٌ غَيرُ طائِلِ",23,"ل",1,0],["ومن مزجَ الغصن الرطيب بعطفه","فكانَ مزاج المعطفين قواما",24,"م",2,0],["ومن مَساعٍ لك ألَّفتها","لا من مساعي الناس لَفَّفْتُها",25,"ت",3,0],["وَمِن مُوَدِّئَةٍ أُخرى تَدارَكَني","مِثلُ الرُدَينِيِّ لا واهٍ وَلا أَوِدُ",26,"د",1,0],["وَمِن مَجرى غَوارِبِ أُقحُوانٍ","شَتيتِ النَبتِ في عامٍ خَصيبِ",27,"ب",1,0],["وَمِن مَشيَخَةِ الوادي","وَمِن أَشبالِهِ المُردِ",28,"د",1,0],["وَمَن مَضَت غَيرَ مَوروثٍ خَلائِقُها","وَإِن مَضَت يَدُها مَوروثَةَ النَشَبِ",29,"ب",1,0],["وَمِن مُنانا بَقائُهُ أَبَداً","حَتّى يُعَزّى بِكُلِّ مَولودِ",30,"د",1,0],["وَمَن مِثلُ كافورٍ إِذا الخَيلُ أَحجَمَت","وَكانَ قَليلاً مَن يَقولُ لَها اِقدُمي",31,"م",2,0],["وَمَن مَناياهُمُ بِراحَتِهِ","يَأمُرُها فيهِمِ وَيَنهاها",32,"ا",3,0],["ومن مُقْصِرٍ يصمي حَماطةَ قلبهِ","صوائبُ وُطْفٌ ما كُسِينَ لُغَابَا",33,"ب",2,0],["وَمَن مَلَكَت كَفّاهُ مَن كانَ مُذنِباً","فَقُدرَتُهُ تُنسي وَتَذهَبُ بِالحِقدِ",34,"د",1,0],["وَمِن مُهرَةٍ شَوهاءَ أَودى عِنانِها","وَقَد كانَ مَحفوظاً لَها غَيرَ ضائِعِ",35,"ع",1,0],["وَمِن ماجِدٍ تَغشى الأَرامِلُ بَيتَهُ","يُعارِضُ أَيّامَ الصَبا كَالمَخائِلِ",36,"ل",1,0],["وَمِن مُتَمَنٍّ أَن أَموتَ وَقَد بَنَت","حَياتي لَهُ شُمّاً عِظاماً قِبابُها",37,"ب",3,0],["ومن مغنىً جعلنا الشوقَ فيه","سؤالاً والدموعَ له جوابا",38,"ب",2,0],["وَمَن مِثلُ حِصنٍ في الحُروبِ وَمِثلُهُ","لِإِنكارِ ضَيمٍ أَو لِأَمرٍ يُحاوِلُه",39,"ل",2,0],["وَمَن مازالَ صَدرَ الجَي","شِ وَالمَوكِبِ وَالدَستِ",40,"ت",1,0],["ومنْ مالُهُ بالجود يَسرحُ في الورى","طَليقاً وكَم مالٍ مِنَ البخلِ في أسرِ",41,"ر",1,0],["وَمِن مالِئٍ عَينَيهِ مِن شَيءِ غَيرِهِ","إِذا راحَ نَحوَ الجَمرَةِ البيضُ كَالدُمى",42,"ا",1,0],["وَمَنْ مِثلُ عُثمَانَ يَرْعَى النُّفوسَ","إذا آدَها الأمرُ أو عَالَها",43,"ل",3,0],["وَمِنْ مَلِيكٍ ما فَوْقَ رُتْبَتِهِ","على عظيم اتِّضاعِهِ رُتْبَهْ",44,"ب",2,0],["وَمِنْ مَواشٍ وَأَطْيارٍ وَآتِيَةٍ","وَمِنْ زُرُوعٍ وَمَكْيُولٍ وَمَوْزُونِ",45,"ن",1,0],["ومِنْ مَواهِبِهِ الرّايَاتُ خَافِقَةً","والعادِيَاتُ إلى الهَيْجاءِ تَسْتَبِق",46,"ق",1,0],["ومَن مذنِبٌ في الهجرِ غيَركِ مجرمٌ","ومَن ناقضٌ للعهدِ غيرَكِ ناكث",47,"ث",1,0],["وَمِن مُنى النَفسِ أَخدانٌ لِجارِيَةٍ","لَم تَلقَ بُؤساً وَلَم تُصبح عَلى سَفَرِ",48,"ر",1,0],["وَمِن مَباءَةِ رِبعانٍ وَمِن عَطَنٍ","يَدِبُّ بَينَهُمُ القِردانُ وَالقَرَدُ",49,"د",1,0],["وَمِن مالَهُ مالي إِذا كُنتُ مُعدِماً","وَما لي لَهُ إِن عَضَّ دَهرٌ بِغارِبِ",50,"ب",1,0],["ومن منهل للعلم أثرى به الحجى","فأكبره أَهلُ الرجاحة واللب",51,"ب",1,0],["ومن معايب في ألفاظه سلما","لم يقرض الشعر يوماً في حقيقته",52,"ه",1,0],["ومن منانا بقاؤه أبداً","حتّى يعزّى بكلّ مولود",53,"د",1,0],["ومن مَلَكٍ مثلُ هذا الحديث","طُمأنينةُ المهجِ الحائره",54,"ه",1,0],["ومِن مَوْقِفٍ ضَنْكٍ زَحَمْتَ به العِدى","وقَد نَفَضَتْ فيهِ العُقَابُ رِداءَهَا",55,"ا",3,0],["وَمِنْ مَبَاحِثَ فِي التَّارِيخِ شَائِقَةٍ","وَفِي البِحَارِ وَفِي الأَمْصَارِ وَالبِيدِ",56,"د",1,0],["وَمِنْ مَفاخِرَ في البِلاَد ثوابِتٍ","أَخْلدْتِهَا وَلِمِثْلِهَا الإِخلاَدُ",57,"د",1,0],["ومِنْ مَجْدِهِمْ مَا يَسْتَظِل بِظِلهِ","بَنو الوَطَنِ الحُرِّ العَزِيزِ المُمَجَّدِ",58,"د",1,0],["وَمِنْ مُنشِدٍ يُحْيِي فَخَارَ جُدُودِهِ","فَيُكْسِبُهُمْ مَجْداً بِذَاكَ مجَدَّدَا",59,"د",2,0],["وَمنْ مِثْلهُ فِي أَهْلِهِ وَرِفَاقِهِ","لَهُ شِيِمٌ كَالرَّوْضِ بَاكَرَهُ الطَّلُّ",60,"ل",1,0],["وَمَنْ مِثْلهُ وَافِي الرجُولَةِ كُلُّمَا","دَعَا الْحَقُّ لاَ يَأْبَى عَلَيْهِ وَيَعْتَل",60,"ل",1,0],["وَمَنْ مِثْلُ جُرْجُ طَاهِرُ النَّفْسِ وَالْهَوَ","ىَ وَمَنْ مِثْلُهُ حُرٌّ وَمَنْ مِثْلُهُ نَجْدُ",61,"د",1,0],["وَمِن مَذهَبي حُبُّ الدِيارِ لِأَهلِها","وَلِلناسِ فيما يَعشَقونَ مَذاهِبُ",62,"ب",1,0],["وَمِن مُتَوَلّي فَصدِ يُمناكَ كَيفَ لَم","يَهُلهُ عُبابُ البَحرِ في مُعظَمِ المَدِّ",63,"د",1,0],["ومن مستعمر بادٍ","إلى مستعمر أخفى",64,"ف",2,0],["ومن مثل إبراهيم إن حمى الوغَى","وأمطرت الأرضُ السماءَ بحاصبِ",65,"ب",1,0],["ومَن مثلُ فاروقٍ وللعرشِ عزَّةٌ","وللمُلْكِ والمجدِ الأثيلِ مَهَابُ",66,"ب",1,0],["ومِنْ مقْتِها للقيود تكاد ال","فتاةُ تحطِّمُ خَلخَالَها",67,"ل",3,0],["ومن مثارِ همومٍ لا انتهاءَ له","ومن مَصَبِّ عناءٍ غيرِ منضوب",68,"ب",1,0],["ومن منح الجهال علماً أضاعه","ومن منع المستوجيين فقد ظلم",69,"م",1,0],["ومن مذنبٌ في الهجرِ غيركِ مجرمٌ","ومَن ناقصٌ للعهدِ غيرَكِ ناكث",70,"ث",1,0],["ومنْ مالىء ٍ عينيهِ من شيءِ غيره،","إذا رَاحَ نَحْوَ الجَمْرَة ِ البيضُ كَالدُّمَى",71,"ا",1,0],["ومن معجزات المصطفى ان سره","سرى بنفوذ الهمة المتواصل",72,"ل",1,0],["ومن مثل سلطان بن سيف وولدِه","وفاءً وحلماً في الموازين تثقلُ",73,"ل",1,0],["ومَن مالُه مالي ومالي مالُه","ومَن مدحه بعد الصلاة دعاءُ",74,"ا",2,0],["ومن مُحاشاةِ الرقيب خِلُتنى","يومَ الرحيل في الهوى مُنافقا",75,"ق",2,0],["وَمِن مُستَخلَفٍ بِالهونِ راضٍ","يُذادُ عَنِ الحِياضِ وَلا يَذودُ",76,"د",1,0],["وَمَن مَهَرَ العَلياءَ حِلماً وَنائِلاً","وَمَحمِيَةً كانَت حَلالاً لَهُ طِلقا",77,"ق",2,0],["وَمِن مَلابِسِهِ ما فَخرُهُ أَبَداً","باقٍ عَلَيكَ إِذا ما رَثَّتِ الحُلَلُ",78,"ل",1,0],["وَمِن مُسلِمٍ خانَ إِسلامَهُ","وَيُظهِرُ لِلشِركِ رَعيَ الذِمَم",79,"م",1,0],["ومن مال منهم واثقا من حصونه","بحصن تبراَّ الحصن منه وخانا",80,"ن",2,0],["وِمن مالِكٍ بِنتِ الفَخارِ بنِ عامِرٍ","فَوارِسُ أَرواحُ الأَعادي نِهابُها",81,"ب",3,0],["وَمَن مِثلُ مَسعودِ الأَميرِ إِذا غَدا","يَغُصُّ بِفَضلِ الرّيقِ وَالماءِ شارِبُهْ",82,"ب",2,0],["وَمِن ماءِ نَهرِ الجَوهَرِيَّةِ لَو صَفَا","ذُبابَةُ حَسيٍ لا يُرَجّى نُبُوعُها",83,"ع",3,0],["وَمِن مَروَزِيٍّ بِالقَطيفِ وَلالِسٍ","عَباءٌ بوَادي طَيّئٍ وَنُطُوعُها",83,"ع",3,0],["وَمَن مَلَّكَ الأَعداءَ تَدبيرَ أَمرِهِ","فَذاكَ الَّذي يُدعى العَديمَ المُثَكَّلا",84,"ل",2,0],["وَمِنْ مَلِيحِ الذَّنُوبِ إِنْ ذُكَرِتْ","لَثْمِيَ فَاهُ وَرَشْفُ رِيقَتِهِ",85,"ت",2,1],["ومن مراغمة الأقدار طاردة","لكم كتيار يم حول طرّاد",86,"د",1,0],["ومن مزاولة الأرزاق بغيتها","تزاحمون بأقدام وأعضاد",86,"د",1,0],["ومن مكابدة الأدواء صاطية","ومن نوازل لا تحصى بتعداد",86,"د",1,0],["وَمِن مَناهِلِ علمٍ راقَ مَورِدُها","وَمِن فضائلَ سارَت في الوَرى مَثَلا",87,"ل",2,0],["وَمِن مُعجزاتِ الأفقِ مَولاه خصّه","بِدَعوة حقٍّ سهمُها شقَّقَ البدرا",88,"ر",2,0],["وَمِن مُستَجيرٍ يُنادي الغَريقَ","هُناكَ وَمِن صائِحٍ مُعوَلِ",89,"ل",1,0],["ومن مثله اسرى إلى العرش راكبا","وكان له جبريل في السير يخدم",90,"م",1,0],["ومن مقيلي طاب في ظلة","اسمع مقال الصدق من قائل",91,"ل",1,0],["ومَنْ مثلُهُ إن حامَ في حَلْقة الوغى","يُفَلِّقُ للأعداء لُبّاً ومنحرا",92,"ر",2,0],["وَمَن مُبلِغٌ حَزماً وَتَيماً وَمالِكاً","وَأَربابَ حامي الجَفرِ رَهطَ شَبيبِ",93,"ب",1,0],["وَمِن مُرهَفاتِ الحَدِّ تَهزَأُ بِالظُبى","وَيَفرَقُ مِنها كُلُّ أَسمَرَ عَسّالِ",94,"ل",1,0],["وَمِن مُرادِ ذَوي الفَض","لِ رَبعُهُ المَعمورُ",95,"ر",1,0],["وَمِنْ مَنْعِي مِنَ النَّفْعِ","وَمِنْ حَجْرِي وَمِنْ حَجْزِي",96,"ز",2,0],["ومن مجده حي ومن جوده حيا","ومن سره ميت ومن صدره قبر",97,"ر",1,0],["ومن مثل عثمانٍ تُقىً وتعبّداً","إذا عُرِضَ القرآن والشهداء",98,"ا",2,0],["وَمن مثل يحيى وَهو افضل من مشى","عَلى الأَرض قَطعا مِن مغير وَمُمَجَدِ",99,"د",1,0],["ومن ماء وَجهي عَن سؤال مذلة","وَعَن جوردهر لَم يزل حلوه مرا",100,"ر",2,0],["ومن محن الدنيا والاخرى تولهم","بخير وَيسرهم بفضلك اليسرى",100,"ر",2,0],["وَمِن مَديحِ المُصطَفى ما بِهِ","أَرجو غَداً فَوزاً بِدارِ الجِنان",101,"ن",1,0],["وَمِن مُنى الأَغصانِ لَو أَنَّها","كَقَدِّهِ آهاً عَلى ضَمِّهِ",102,"م",2,0],["ومن مفتاح أوساسي والا","فمن مستنطق شهم رؤوف",103,"ف",1,0],["ومن محيّاهُ صبحٌ إِن أَضاءَ لنا","جَلا الدُجى بصباحٍ منه مُنبَلجِ",104,"ج",1,0],["وَمِن محمّدٍ الأَسمى أبيهِ بصل","ب الغوثِ عبدِ السلامِ الجامع اِلتَأموا",105,"م",3,0],["ومن مخبر لا يعجز اللَه قدره","عليه ولا يخشى بوادر نقمة",106,"ه",1,0],["وَمَن مِنَ الحِلمِ قَد شادوا لَهَ لَقَبا","مِصداقُهُ فيهِ عُنونٌ وَتَفسيرِ",107,"ر",1,0],["وَمِن مَعانٍ وَأسرارٍ لَها اِتَّعَظا","فَإشن تَكُن ذا يَقينٍ عالَماً يَقَظا",108,"ظ",2,0],["وَمِن مُقْلتيهِ وَخَطِّ العِذارِ","حَلَفْتُ على السَّيْفِ والمُصَحَفِ",109,"ف",1,0],["وَمِن مَقولي لي صارِمٌ فيهِ صارِمٌ","لِجُثَّةٍ أَضدادي وَلِلهامِ شادِخُ",110,"خ",1,0],["وَمِن مُضمَرٍ في مَظهَرٍ لي بَدا لَهُم","خَفانا لَهُم عَنهُم وَلِلسِرِّ أَسرارُ",111,"ر",1,0],["وَمَن مِنهُم العَباس في أَوجه العِدا","إِذا قابَلَ الدَهرَ العَبوس تَبَسَّما",112,"م",2,0],["وَمِن مَذهبي في شرعة الحُبِّ أَنَّني","أَغار عَلى وَرد الرياض لأَجلِهِ",113,"ه",1,0],["وَمَن مَواهبه تَنمو عَن العَدَدِ","أَدعوكَ يا رَبِّ وَالأَعداءُ واثِبة",114,"ه",1,0],["وَمَن مِنهمُ ذا الفاضل القُدوة الَّذي","لَهُم شادَ مِن أَطواد عزّتهم رُكحا",115,"ح",2,0],["ومن مقلاتها قلَتُ البرايا","ومن أسنانها أصل السنان",116,"ن",1,0],["ومَن مثْلُ ذي الفَخْرَينِ فَخْرٍ بنفسه","وفَخرٍ بمَنْ أبقَوا له غايةَ الفَخر",117,"ر",1,0],["ومِن مَوْقفٍ يومَ الوَداعِ وقَفْتُه","وقد هاجَ أشجانَ القلوبِ الجَرائح",118,"ح",1,0],["وَمِن مِنَني تَعويدُهُ بَل وَجَدتُهُ","كَذَلِكَ يَهوى الشُكرَ وَالصِدقَ في الشُكرِ",119,"ر",1,0],["ومِن مُهجَةٍ مذ نَأت ما ثَوَت","بأرضٍ ومِن سَكنٍ ما سكن",120,"ن",1,0],["ومن منصفٍ يَقضي بشرعٍ محقَّقٍ","ويَفصلُ في دعواه إشكالَ مبهم",121,"م",1,0],["ومن مغازلة الطُلا","إن رمت حسن الأرب",122,"ب",1,0],["ومِن مزاياهُ التي لا تُجحَدُ","وكلُّ قَرَّبهُ من المَلِك",123,"ك",1,0],["وَمِن مِثلُهُ إِذ أَحرَزَ الحُسن وَجهَهُ","كَما أَنَ فَتح اللَه قَد أَحرَز الحُسنى",124,"ن",2,0],["ومن معاصي اللسان غيبة وهي قال","ذكرك أخاك بما يكره ولو كان زال",125,"ل",1,0],["ومَنْ مَلأَ القلوبَ أسىً وحُزْناً","فكلُّ فتىً لِمَصْرعِهِ حزينُ",126,"ن",1,0],["ومن مِدَحٍ كالرَّوض حُسناً بعثتُها","إلى ذي العطاء الجمّ والنّائل الجزلِ",127,"ل",1,0],["ومن من الرواة","ليس من الثقاة",128,"ه",1,0],["ومن من اليم أخرج الكليم وقد","ألقى طفلاً لم يغذ باللبن",129,"ن",1,0],["ومن مال نحو المال والجاه لم يكن","له خلة عندي ولا لي مقصد",130,"د",1,0],["وَمَن مُدَّ في أَيّامِهِ فَتَأَخَّرَت","مَنِيَّتُهُ فَالشَيبُ لا شَكَّ شامِلُه",131,"ل",2,0],["ومن مثلهنَّ أخاف الصّدام","ويَصدِمُ مثلي ولا يُصدم",132,"م",1,0],["ومن مضض الأَيَّام مدحي عصابة","بذلت يداً فيهم وما نلتُ إصبعا",133,"ع",2,0],["ومن مكرمات تملكُ الحرَّ رقَّةً","تطوّق من أيديك يداً ومنحرا",134,"ر",2,0],["ومن مرضٍ أٌقاسيه ووجدٍ","رضيتُ من الغنيمة بالإياب",135,"ب",1,0],["ومن مشكلات بالعلوم عرفتها","فأعربت عما كانَ فيهم معجما",136,"م",2,0],["ومن محياه نور جلّ عن نظر","ومذ غدا وجهه بالشمس ذا أثر",137,"ر",1,0],["ومن مياه فو ال له","تبييضة ورجيع العلا تصفير",138,"ر",1,0],["ومن مَلَّ أُنْسَ المالِ حَتَّى تحَكَّمَتْ","عَلَى مَا حَوَتْ كفَّاهُ أَن يَتَحَكَّما",139,"م",2,0],["ومن مُؤْيِدٍ صَمَّاءَ تَقصُرُ من يدِي","ومعضلةٍ دهياءَ تكبُرُ عن دفعِي",140,"ع",2,0],["ومن معقِلٍ أُشْرِعْنَ حولَيْهِ فاغتدى","أَذَلَّ لوطْءِ المُقْرَباتِ من الفَقْعِ",140,"ع",1,0],["ومَنْ مَلَّ الجلاءَ فعاذَ منه","بسُورِ الأَمْنِ فِي البَلَدِ الحرامِ",141,"م",1,0],["ومَنْ مُلْكُهُ إِنْ جَلَّ خَطْبٌ مِلاكُهُ","وأَعلامُهُ إِنْ رابَ دَهْرٌ مَعالِمُهْ",142,"م",2,0],["ومن ماء ريحان قليل يسط به","وأَسقه ماء الصمغ سقياً كمثل ما",143,"م",2,0],["ومن مكارمه عمت وشيد بها","بيت المعالي حتى احتل أعلاها",144,"ا",3,0],["ومن مَعَدٍّ فتاةُ السن جاريةٌ","من مطلها الكهل مذ كانت على سَنَنِ",145,"ن",1,0],["ومن مُوقِهِ لم يدَّرئْهم بصَرفه","وهم جُنَنٌ من صَرفه ونِصالُ",146,"ل",1,0],["ومن مستطيلٍ لها عرقُهُ","إلى غير بيتك لم ينزِعِ",147,"ع",1,0],["ومن ملَّ طولَ العمرِ والعزِّ قاده","لك الحَيْنُ في حبلِ الشناءةِ والغِمرِ",148,"ر",1,0],["ومِن منجبٍ فيه أبوه وأمُّهُ","وما وَلَدُ الإنسانِ إلا نَجيبُهُ",149,"ب",2,0],["ومن مثلُ الغِياثِ إذا تمطَّتْ","عِتاقُ الخيلِ وادُّرِعَ الحِذارُ",150,"ر",1,0],["ومَن مثل قُطب الدين فارس مَعْركٍ","صبوراً إذا حمس الفوارس مَلَّتِ",151,"ت",1,0],["ومَن مثل الوزير الصَّدر يُقْضى","بحُجَّتِهِ إذا عَزَبَ الصَّوابُ",152,"ب",1,0],["ومن معجز الحسن الذي هيَ ربُّهُ","تصرفُ جسمٍ في هواها ولا روح",153,"ح",1,0],["وَمِن مَصائِرِ أطفالٍ تُطالِبُهُ","عُيونُهُم دونَ أن يُدني لَهُم طَلَبا",154,"ب",2,0],["وَمَن مُحَيّاهُ لِلنَدامى","رَوضٌ وَفي كَفِّهِ غَمامَه",155,"م",2,0],["ومِن مقلةِ لا يعرفِ الغُمْضَ جفنُها","إِذا هجعَ الرُّكبانُ فوقَ النجائبِ",156,"ب",1,0],["ومِن مدنفٍ لاقى البعادَ وهولَهُ","بأنف على حكم التفرُّقِ راغمِ",157,"م",1,0],["ومِن مقلةٍ لم يَفْنَ فائضُ غَربِها","على الدارِ إلا فاضَ مِن بعدِه غَربُ",158,"ب",1,0],["وَمِن مُطعِمٍ يَومَ الصَبا غَيرَ جامِدٍ","إِذا شَصَّ عَن أَبنائِهِنَّ المَراضِعُ",159,"ع",1,0],["ومن مروجٍ كظهر الترس مظلمةٍ","كأن حصباءها تحت الدجى سبج",160,"ج",1,0],["ومن مِسكِ الغُبارِ أثارَ سُحباً","مخضّبةَ المَبارقِ بالمَلابِ",161,"ب",1,0],["ومن مِحنَة النَّفسِ تُفسِدُها","بمَا لا يُنَاط به سَعدُها",162,"د",3,0],["ومن محَبَّتي لَه","شَرعِي غدَت ومِلَّتِي",163,"ي",1,0],["وَمِن مِنَنٍ مَلَكنَ الفَضلَ حتّى","خَلَطنَ كِرامَ دَهرك باللئامِ",164,"م",1,0],["ومِنْ مُغرَمٍ يَقْلِي لذيذَ اِنتباهِهِ","ويَهْوى لما جرّ المنامُ منامَهُ",165,"م",2,0],["ومِنْ مُسعِفٍ جُنْحاً بطيبِ عناقِهِ","وكم حَرَمَ العُشّاقَ صُبحاً كلامَهُ",165,"م",2,0],["ومِنْ مُلْتَقىً عَذْبِ المَذاقِ وتحتَهُ","فلم يرضَ لي حتّى رَبِحتُ أَثامَهُ",165,"م",2,0],["ومن مغرمٍ بالجود لم يَثنِ عنده","بلا ملئها من رِفْدِه كفّ سائلِ",166,"ل",1,0],["ومن مُلحِقٍ بالجبان الشّجا","ع فضلاً وذا الجود بالباخلِ",167,"ل",1,0],["ومن مقالٍ إذا فاه الرُّواةُ به","كأنّه في قديم الدّهر لم يُقَلِ",168,"ل",1,0],["ومِن مُعْوِلٍ يشكو الفراقَ وواجمٍ","ومِن آخذٍ ما يبتغيه وتاركِ",169,"ك",1,0],["ومُنَمَّقٍ طبعاً وكلُّ مُنَمَّقٍ","بتعسّفٍ يلقاك غيرَ مُنَمَّقِ",170,"ق",1,0],["ومِن مُصِرٍّ زاد إصرارَه","إِنْ لِيمَ في السِّيّءِ أو عُنِّفا",171,"ف",2,0],["ومَنْ مَلأت سَمعَه الذابلاتُ","وَقَرعُ الظبا لَم يَرُعْه الصَّدى",172,"ا",1,0],["وَمِن مُغَنٍّ بَربَرَ البَربارِ","وَزَجَلِ القِطارِ وَالقِطارِ",173,"ر",1,0],["وَمِنْ مُشَارٍ عَلَى التَّرَائِبِ فِي","صَحِيْحَةِ الصَّدْرِ غَيْرُ مُنْكَسِرَهْ",174,"ر",2,0],["ومن مُدامٍ ومَثَان تصطخِبْ","وهمَّةٍ طامحةٍ إلى الرُّتَبْ",175,"ب",1,0],["ومِنْ مُديرِ الكَأْسِ سُكْرِي فَلا","أُحيلُ بِالكأْسِ عَلى الدَّائِر",176,"ر",1,0],["وَمِنْ مُحَمَّد إِقْدامي وَمِعْرفَتي","وَمِنْ مُحمَّدَ إِعْرامي وتهذيبي",177,"ب",2,0],["ومن مدع للدين والحق ثم لا","يحامي عن الإسلام عن التزاحم",178,"م",1,0]]}