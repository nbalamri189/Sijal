{"poems":[[53,"لعمر الطير يوم ثوى ابن ليلى","https://www.aldiwan.net/poem29808.html","الوافر"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[63,"ونفحة من ربا ذي الأثل قابلني","https://www.aldiwan.net/poem45794.html","البسيط"],[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[63,"سل الركب يا ذواد عن آل جساس","https://www.aldiwan.net/poem46149.html","الطويل"],[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[55,"بكت عيني على جسمي","https://www.aldiwan.net/poem26096.html","الهزج"],[57,"أأنثر درا بين سارحة البهم","https://www.aldiwan.net/poem24639.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[93,"طوقتموني بأطواق من المنن","https://www.aldiwan.net/poem9166.html","البسيط"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[93,"لمصر الجديدة عيد سعيد","https://www.aldiwan.net/poem11327.html","المتقارب"],[30,"أمنكر أنت ربع الدار عن عفر","https://www.aldiwan.net/poem29614.html","البسيط"],[88,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[88,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[88,"سأبدي لدهري ناج المتضحك","https://www.aldiwan.net/poem45011.html","الطويل"],[23,"أجدك لم تهتج لرسم المنازل","https://www.aldiwan.net/poem21351.html","الطويل"],[72,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[32,"بثغر قد سقين المسك منه","https://www.aldiwan.net/poem27752.html","الوافر"],[85,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[43,"ما سدكت علة بمورود","https://www.aldiwan.net/poem9527.html","المنسرح"],[43,"فراق ومن فارقت غير مذمم","https://www.aldiwan.net/poem10570.html","الطويل"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[45,"أراد سلوا عن سليمى وعن هند","https://www.aldiwan.net/poem63510.html","الطويل"],[28,"لو أعلم الأيام راجعة لنا","https://www.aldiwan.net/poem5276.html","الطويل"],[28,"تبغت جوارا في معد فلم تجد","https://www.aldiwan.net/poem5408.html","الطويل"],[28,"أبى الحزن أن أسلى بني وسورة","https://www.aldiwan.net/poem5648.html","الطويل"],[61,"أجانبها حذارا لا اجتنابا","https://www.aldiwan.net/poem51817.html","الوافر"],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[66,"ألا يا ملك العصر","https://www.aldiwan.net/poem39072.html","الهزج"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[31,"وكم من قتيل لا يباء به دم","https://www.aldiwan.net/poem42659.html","الطويل"],[105,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[67,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[75,"أبلغ ربيعة عن ذي الحي من يمن","https://www.aldiwan.net/poem69056.html","البسيط"],[75,"لمن صولجان فوق خدك عابث","https://www.aldiwan.net/poem69097.html","الطويل"],[50,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[50,"تود عدوي ثم تزعم","https://www.aldiwan.net/poem64757.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85520","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140961",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54727","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54706","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[73,"","https://poetry.dctabudhabi.ae/diwan/poem/7561","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142324","الهزج"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[106,"أجادير","https://www.poetsgate.com/ViewPoem.aspx?id=179602",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[57,"أأنثر دراً بين سارحة البهم","https://www.poetsgate.com/ViewPoem.aspx?id=3396",""],[75,"لمن صَولجانٌ فوقَ خدّكِ عابِثُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10792&r=&rc=12",""],[31,"وَكَمْ مِنْ قَتِيلٍ لا يُباءُ بِهِ دَمٌ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18744&r=&rc=7",""]],"verses":[["وَمَن مَطَلَ الدُيونَ أَعَدَّ صَبراً","عَلى عَنَتِ المُطالِبِ وَالغَريمِ",0,"م",1,0],["وَمَن ماتَ لَم يَعلَم وَقَد عانَقَ الثَرى","بَكاهُ خَليلٌ أَم سَلاهُ خَليلُ",1,"ل",1,0],["وَمِن مَأثُراتٍ غَيرَ هاتيكَ لَم تَزَل","لَها عُنُقٌ عالٍ عَلى الناسِ مُشرِفُ",2,"ف",1,0],["وَمَن ماتَ في حَبسِ المَذَلَّةِ قَلبهُ","رَأى العِزَّ في دارِ المَذَلَّةِ مَولِدا",3,"د",2,0],["وَمِن مَشرَبٍ أَنبَطتُ يَنبوعَ مائِهِ","بِأَعلى الرَوابي وَالرِياضِ الأَثائِثِ",4,"ث",1,0],["وَمِن مُهجَةٍ لا تَرأَمُ الضَيمَ مَرَّةً","يُعَجِّلُ عَن دارِ المَذَلَّةِ نَهضَتي",5,"ي",1,0],["وَمِن مَخافَةِ بَينٍ كُنتُ أَحذَرُهُ","لَم أَذكُرِ القَدَّ كَي لا أَذكُرَ البانا",6,"ن",2,0],["وَمَن مَلَكَ البَرقَ المُرَجّى نَوالُهُ","نَدىً لَم يُراقِب دونَ نَفحَتِهِ الرَّعدُ",7,"د",1,0],["ومنْ مُوقِديها غادَةٌ دونَها الظُّبا","تَلوحُ بأيْدي غِلْمَةٍ غيرِ أنْكاسِ",8,"س",1,0],["ومِنْ مَساعيكَ فَتْحٌ إذ سَلَلْتَ لهُ","رَأياً فَلَلتَ به الصّمْصامَةَ الخَذِما",9,"م",2,0],["وَمِن مُخطِئٍ حينَ طابَت لَهُ","فَظَلَّ لِما فاتَ مِنها حَزينا",10,"ن",2,0],["وَمَن مَوعِدُهُ دانٍ","وَجَدواهُ مَعَ النَجمِ",11,"م",1,0],["وَمَن مَنَحَ الجُهّالَ عِلماً أَضاعَهُ","وَمَن مَنَعَ المُستَوجِبينَ فَقَد ظَلَم",12,"م",1,0],["وَمَنْ مِثْلُ إِبْرَاهِيمَ فِي ثَبْتِ مَوْقِفٍ","إِذَا مَا الْتَقَى فِي مَوْقِف الْحَرْبِ صَفَّانِ",13,"ن",1,0],["وَمَنْ مِثْلُهُ قَدْ أَعْجَزَ الدَّهْرَ مِثْلُهُ","إِ ذَا ذُكِرَ الْعَزْمُ الصَّرِيحُ أَوِ الْحَزْمُ",14,"م",1,0],["ومن مؤثل جاه في تجارته","أو في صناعته أغنى الحمى وغنى",15,"ن",2,0],["وَمَنْ مَنَاقِبَ أَزْكَاهَا وَأشْرَفَهَا","تَكَرُّمُ الطَّبْعِ عَنْ حِقْدٍ وَعَنْ غَضَبِ",16,"ب",1,0],["ومن مثل جرح طاهر النفس والهوى","ومن مثله حر ومن مثله نجد",17,"د",1,0],["وَمِنْ مُسْرِفٍ فِي النَّدَى وَالفِدَى","لِكُلِّ لَهِيفٍ وَكُلِّ مَضِيمِ",18,"م",1,0],["وَمِنْ مُتَقَاضٍ شَدِيدِ المِرَاسِ","وَمِنْ مُتَغَاضٍ غَفُورٍ رَحِيمِ",18,"م",1,0],["وَمِن مُلَمَّعَةٍ غَبراءَ مُظلِمَةٍ","تُرابُها بِالشِعافِ الغُبرِ مَعصوبُ",19,"ب",1,0],["ومن مبكيات الدهر أو مضحكَاته","لدى الناس حرٌّ لم يكن خصمه حرا",20,"ر",2,0],["ومن مبلغ عنا السَنوسيّ أنه","يمدّ لهذا الصدع منه يدَ الرَأب",21,"ب",1,0],["ومن مضحكات الدهر حامل سُبحة","تُقبَّل جهلاً كفّه للتبرُّك",22,"ك",1,0],["وَمَن مُكرِهي إِن شِئتُ أَن لا أَقولُهُ","وَفَجعُ الأَمينِ شيمَةٌ غَيرُ طائِلِ",23,"ل",1,0],["ومن مزجَ الغصن الرطيب بعطفه","فكانَ مزاج المعطفين قواما",24,"م",2,0],["ومن مَساعٍ لك ألَّفتها","لا من مساعي الناس لَفَّفْتُها",25,"ت",3,0],["وَمِن مُوَدِّئَةٍ أُخرى تَدارَكَني","مِثلُ الرُدَينِيِّ لا واهٍ وَلا أَوِدُ",26,"د",1,0],["وَمِن مَجرى غَوارِبِ أُقحُوانٍ","شَتيتِ النَبتِ في عامٍ خَصيبِ",27,"ب",1,0],["وَمِن مَشيَخَةِ الوادي","وَمِن أَشبالِهِ المُردِ",28,"د",1,0],["وَمَن مَضَت غَيرَ مَوروثٍ خَلائِقُها","وَإِن مَضَت يَدُها مَوروثَةَ النَشَبِ",29,"ب",1,0],["وَمِن مُنانا بَقائُهُ أَبَداً","حَتّى يُعَزّى بِكُلِّ مَولودِ",30,"د",1,0],["وَمَن مِثلُ كافورٍ إِذا الخَيلُ أَحجَمَت","وَكانَ قَليلاً مَن يَقولُ لَها اِقدُمي",31,"م",2,0],["وَمَن مَناياهُمُ بِراحَتِهِ","يَأمُرُها فيهِمِ وَيَنهاها",32,"ا",3,0],["ومن مُقْصِرٍ يصمي حَماطةَ قلبهِ","صوائبُ وُطْفٌ ما كُسِينَ لُغَابَا",33,"ب",2,0],["وَمَن مَلَكَت كَفّاهُ مَن كانَ مُذنِباً","فَقُدرَتُهُ تُنسي وَتَذهَبُ بِالحِقدِ",34,"د",1,0],["وَمِن مُهرَةٍ شَوهاءَ أَودى عِنانِها","وَقَد كانَ مَحفوظاً لَها غَيرَ ضائِعِ",35,"ع",1,0],["وَمِن ماجِدٍ تَغشى الأَرامِلُ بَيتَهُ","يُعارِضُ أَيّامَ الصَبا كَالمَخائِلِ",36,"ل",1,0],["وَمِن مُتَمَنٍّ أَن أَموتَ وَقَد بَنَت","حَياتي لَهُ شُمّاً عِظاماً قِبابُها",37,"ب",3,0],["ومن مغنىً جعلنا الشوقَ فيه","سؤالاً والدموعَ له جوابا",38,"ب",2,0],["وَمَن مِثلُ حِصنٍ في الحُروبِ وَمِثلُهُ","لِإِنكارِ ضَيمٍ أَو لِأَمرٍ يُحاوِلُه",39,"ل",2,0],["وَمَن مازالَ صَدرَ الجَي","شِ وَالمَوكِبِ وَالدَستِ",40,"ت",1,0],["ومنْ مالُهُ بالجود يَسرحُ في الورى","طَليقاً وكَم مالٍ مِنَ البخلِ في أسرِ",41,"ر",1,0],["وَمِن مالِئٍ عَينَيهِ مِن شَيءِ غَيرِهِ","إِذا راحَ نَحوَ الجَمرَةِ البيضُ كَالدُمى",42,"ا",1,0],["وَمَنْ مِثلُ عُثمَانَ يَرْعَى النُّفوسَ","إذا آدَها الأمرُ أو عَالَها",43,"ل",3,0],["وَمِنْ مَلِيكٍ ما فَوْقَ رُتْبَتِهِ","على عظيم اتِّضاعِهِ رُتْبَهْ",44,"ب",2,0],["وَمِنْ مَواشٍ وَأَطْيارٍ وَآتِيَةٍ","وَمِنْ زُرُوعٍ وَمَكْيُولٍ وَمَوْزُونِ",45,"ن",1,0],["ومِنْ مَواهِبِهِ الرّايَاتُ خَافِقَةً","والعادِيَاتُ إلى الهَيْجاءِ تَسْتَبِق",46,"ق",1,0],["ومَن مذنِبٌ في الهجرِ غيَركِ مجرمٌ","ومَن ناقضٌ للعهدِ غيرَكِ ناكث",47,"ث",1,0],["وَمِن مُنى النَفسِ أَخدانٌ لِجارِيَةٍ","لَم تَلقَ بُؤساً وَلَم تُصبح عَلى سَفَرِ",48,"ر",1,0],["وَمِن مَباءَةِ رِبعانٍ وَمِن عَطَنٍ","يَدِبُّ بَينَهُمُ القِردانُ وَالقَرَدُ",49,"د",1,0],["وَمِن مالَهُ مالي إِذا كُنتُ مُعدِماً","وَما لي لَهُ إِن عَضَّ دَهرٌ بِغارِبِ",50,"ب",1,0],["ومن منهل للعلم أثرى به الحجى","فأكبره أَهلُ الرجاحة واللب",51,"ب",1,0],["ومن معايب في ألفاظه سلما","لم يقرض الشعر يوماً في حقيقته",52,"ه",1,0],["ومن منانا بقاؤه أبداً","حتّى يعزّى بكلّ مولود",53,"د",1,0],["ومن مَلَكٍ مثلُ هذا الحديث","طُمأنينةُ المهجِ الحائره",54,"ه",1,0],["ومِن مَوْقِفٍ ضَنْكٍ زَحَمْتَ به العِدى","وقَد نَفَضَتْ فيهِ العُقَابُ رِداءَهَا",55,"ا",3,0],["وَمِنْ مَبَاحِثَ فِي التَّارِيخِ شَائِقَةٍ","وَفِي البِحَارِ وَفِي الأَمْصَارِ وَالبِيدِ",56,"د",1,0],["وَمِنْ مَفاخِرَ في البِلاَد ثوابِتٍ","أَخْلدْتِهَا وَلِمِثْلِهَا الإِخلاَدُ",57,"د",1,0],["ومِنْ مَجْدِهِمْ مَا يَسْتَظِل بِظِلهِ","بَنو الوَطَنِ الحُرِّ العَزِيزِ المُمَجَّدِ",58,"د",1,0],["وَمِنْ مُنشِدٍ يُحْيِي فَخَارَ جُدُودِهِ","فَيُكْسِبُهُمْ مَجْداً بِذَاكَ مجَدَّدَا",59,"د",2,0],["وَمنْ مِثْلهُ فِي أَهْلِهِ وَرِفَاقِهِ","لَهُ شِيِمٌ كَالرَّوْضِ بَاكَرَهُ الطَّلُّ",60,"ل",1,0],["وَمَنْ مِثْلهُ وَافِي الرجُولَةِ كُلُّمَا","دَعَا الْحَقُّ لاَ يَأْبَى عَلَيْهِ وَيَعْتَل",60,"ل",1,0],["وَمَنْ مِثْلُ جُرْجُ طَاهِرُ النَّفْسِ وَالْهَوَ","ىَ وَمَنْ مِثْلُهُ حُرٌّ وَمَنْ مِثْلُهُ نَجْدُ",61,"د",1,0],["وَمِن مَذهَبي حُبُّ الدِيارِ لِأَهلِها","وَلِلناسِ فيما يَعشَقونَ مَذاهِبُ",62,"ب",1,0],["وَمِن مُتَوَلّي فَصدِ يُمناكَ كَيفَ لَم","يَهُلهُ عُبابُ البَحرِ في مُعظَمِ المَدِّ",63,"د",1,0],["ومن مستعمر بادٍ","إلى مستعمر أخفى",64,"ف",2,0],["ومن مثل إبراهيم إن حمى الوغَى","وأمطرت الأرضُ السماءَ بحاصبِ",65,"ب",1,0],["ومَن مثلُ فاروقٍ وللعرشِ عزَّةٌ","وللمُلْكِ والمجدِ الأثيلِ مَهَابُ",66,"ب",1,0],["ومِنْ مقْتِها للقيود تكاد ال","فتاةُ تحطِّمُ خَلخَالَها",67,"ل",3,0],["ومن مثارِ همومٍ لا انتهاءَ له","ومن مَصَبِّ عناءٍ غيرِ منضوب",68,"ب",1,0],["ومن منح الجهال علماً أضاعه","ومن منع المستوجيين فقد ظلم",69,"م",1,0],["ومن مذنبٌ في الهجرِ غيركِ مجرمٌ","ومَن ناقصٌ للعهدِ غيرَكِ ناكث",70,"ث",1,0],["ومنْ مالىء ٍ عينيهِ من شيءِ غيره،","إذا رَاحَ نَحْوَ الجَمْرَة ِ البيضُ كَالدُّمَى",71,"ا",1,0]]}