www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5582,"شَغَفَ القَلْبَ اشْتِياقاً وَنَهَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=63549",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[5720,"طَيِّبَةُ اللَّمَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=213055",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[402,"ألنيل عبدك والمياه جواري","https://www.poetsgate.com/ViewPoem.aspx?id=35726",""],[5894,"حين استهل الظبيُ كالمصباح","https://www.poetsgate.com/ViewPoem.aspx?id=131415",""],[5894,"ما فخر ديروط على البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=131409",""],[5943,"ثلم النوى طيفَ الخيالِ بمدية","https://www.poetsgate.com/ViewPoem.aspx?id=35873",""],[5970,"حلت لي عزلتي وحلا مقامي","https://www.poetsgate.com/ViewPoem.aspx?id=130615",""],[6031,"حُلَّتْ عَليكَ مَعَاقدُ الأَنْدَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=46282",""],[3792,"حلت ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=129244",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6113,"الحمد لله بس عدت على خير","https://www.poetsgate.com/ViewPoem.aspx?id=27074",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""],[6316,"في رثاء الشيخ بن باز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65165&r=&rc=0",""],[4222,"بالله يا ريح الشمال تحملي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52874&r=&rc=166",""],[5567,"ناسكة الأسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81812&r=&rc=62",""]],"verses":[["حَلَّت حُباها المَنايا في كَتائِبِهِ","بِالضَربِ فَاِجتَثَّتِ الأَجسادَ بِالقُضُبِ",0,"ب",1,0],["حَلَّت بِأَرضِ الزائِرينَ فَأَصبَحَت","عَسِراً عَلَيَّ طِلابُكِ اِبنَةَ مَخرَمِ",1,"م",1,0],["حَلَّت نَوارُ بِأَرضٍ لا يُبَلِّغُها","إِلّا صُموتُ السُرى لا تَسأَمُ العَنَقا",2,"ق",2,0],["حَلَّت بِها الجَوزاءُ عِقدَ نِطاقِها","فَتَباشَرَت بِالخصبِ وَالإِمراعِ",3,"ع",1,0],["حَلَّت سُلَيمى بِخَبتٍ أَو بِفَرتاجِ","وَقَد تُجاوِز أَحياناً بَنى ناجِ",4,"ج",1,1],["حَلَّت لِيَ الخَمرُ وَكُنتُ اِمرَ","عَن شُربِها في شُغُلٍ شاغِلِ",5,"ل",1,0],["حَلَّت مَحَلّاً بِقُطرِ الأَرضِ مُنتَبِذاً","تُقَصِّرُ الريحُ عَنهُ كُلَّما جَرَتِ",6,"ت",1,0],["حَلَّت طُهَيَّةُ مِن سَفاهَةِ رَأيِها","مِنّي عَلى سَنَنِ المُلِحِّ الوابِلِ",7,"ل",1,0],["حلَّتْ وأطربتْ المصغي وحزت بها","فضل السباق فسمَّاها الورَى قصبا",8,"ب",2,0],["حلت ليَ منها نسبة قاهريَّة","على أنَّ قلبي في هواها مشبك",9,"ك",1,0],["حلت للورى جدوى يديه فأصبحت","دُعاة الرجا من حوله كمال",10,"ل",1,0],["حَلَّت سراويلي على واسعٍ","ما خِلتُه إلا سراوِيلا",11,"ل",2,0],["حلَّتْ خلائقُهُ بُمُتَّسعٍ","فعُفاةُ نائله بمُزْدَحَمِ",12,"م",1,0],["حَلَّت صُبَيرَةُ أَمواهَ العِدادِ وَقَد","كانَت تَحُلُّ وَأَدنى دارِها تُكُدُ",13,"د",1,1],["حَلَّت سُلَيمى بِدَوغانٍ وَشَطَّ بِها","غَربُ النَوى وَتَرى في خُلقِها أَوَدا",14,"د",2,1],["حَلَّت عَلَيها فَلَم تُنكِر زَخارِفَها","فَطالَما أَبصَرَت أَشباهَها صُوَرا",15,"ر",2,0],["حَلَّتِ الخَمرُ وكانَت حَرَاماً","وَبِلأيٍ ما أَلَمَّت تَحِلُّ",16,"ل",1,0],["حَلَّت طُيورُكَ بي وَقَد","قَرّبتَ مِنها ما بُعدْ",17,"د",1,0],["حلت على ذهب المعز طلاسم","ومشت على سيف المعز عوادى",18,"د",2,0],["حَلَّتِ السَبعونَ في هَيكَلِها","فَتَداعى وَهيَ مَوفورٌ بِناها",19,"ا",3,0],["حَلَّت مَكاناً عِندَهُم","فَوقَ المُعَلِّمِ وَالزَعيمِ",20,"م",1,0],["حُلتِ دونَ المَزارِ فَاليَومَ لَو زُر","تِ لَحالَ النُحولُ دونَ العِناقِ",21,"ق",1,0],["حَلَّت رِكابُ العُلا وَالمَجدِ أَرحُلَها","بِهِ وَشالَت رِكابُ البُخلِ بِالبَخَلِ",22,"ل",1,0],["حلَّتْ فِناءَ الأميرِ فاشتملَتْ","ظِلاً من العُرفِ ليسَ يَنتَقِلُ",23,"ل",1,0],["حلَّتْ نَسيمَ عِقالِها وتوشَّحَتْ","بالأُرْجُوانِ وشَدَّدَتْ أزرارَها",24,"ر",3,0],["حَلَّت مَكارِمُهُ عِقالَ خَصاصَتي","إِذ راشَ مِن بَعدِ الخُمولِ جَناحي",25,"ح",2,0],["حَلَّتِ المومِياءُ وَهيَ مِنَ المَي","تَةِ بَعدَ التَحريمِ لِلنَفعِ فيها",26,"ي",3,1],["حَلَّت بِمَزجِها المُدامُ","فَالمَزجُ لِنَقصِها تَمامُ",27,"م",1,1],["حُلتَ ما بَيني وَبَي","نَ رُقادي",28,"ي",1,0],["حَلَّت رِكابُ البَغيِ مِن وائِلٍ","في رَهطِ جَسّاسٍ ثِقالِ الوُسوق",29,"ق",1,0],["حَلَّت مَحَلَّ البِكرِ مِن مُعطىً وَقَد","زُفَّت مِنَ المُعطي زِفافَ الأَيِّمِ",30,"م",1,0],["حَلَت نُطَفٌ مِنها لِنِكسٍ وَذو النُهى","يُدافُ لَهُ سُمٌّ مِنَ العَيشِ مُنقَعُ",31,"ع",1,0],["حَلَّت عُرا أَثقالِها وَهُمومَها","أَبناءُ إِسماعيلَ فيهِ وَهودِ",32,"د",1,0],["حلتْ رباطَ الخروفِ تنشدُهُ","أما ترى الشمسَ حلَّتِ الحَملا",33,"ل",2,0],["حلَّتْ رباطَ الخروفِ منشدةً","أما ترى الشمسَ حلَّتِ الحملا",34,"ل",2,0],["حُلتَ عَن عَهدِنا وَطاوَعتَ حُسّا","داً قَديماً كانوا عَلَيكَ رِغاما",35,"م",2,0],["حُلتِ دونَ الفوآدِ وَالتَذَّكِ القَل","بُ وَخَلّى لَكِ النِساءُ الوِصالا",36,"ل",2,0],["حَلَّت بِمَكَّةَ وَالنَوى قُذُفٌ","هَيهاتَ مَكَّةُ مِن قُرى لُدِّ",37,"د",1,0],["حَلَّت أَواصِرُهُ بِهِ مِن عامِرٍ","في حَيثُ حَلَّت مُقلَةٌ مِن مِحجَرِ",38,"ر",1,0],["حَلَّت بِهِ الأَقدارُ نَحوَ عاشِقٍ","لِحَمدِهِ صَبٍّ بِتَفريقِ النَشَب",39,"ب",1,0],["حَلَّت سُعادُ وَأَهلُها سَرِفا","قَوماً عِدىً وَمَحَلَّةً قَذفا",40,"ف",2,1],["حَلَّت قِناعَ الوَشيِ عَن صورَةٍ","أَلبَسَها اللَهُ التَحاسينا",41,"ن",2,0],["حَلَّت نِحاسَ الناموسِ فِضَّةُ شَي","بٍ لَكَ حَلَّت هَديدَ مِقراضِ",42,"ض",1,0],["حَلَّت بِدارٍ فَظَنَّت أَنَّها وَطَنٌ","لَها وَمالِكُ تِلكَ الدارِ نافيها",43,"ي",3,0],["حَلَّت تُماضِرُ بَعدَنا رَبَبا","فَالغَمرَ فَالمُرّينِ فَالشُعَبا",44,"ب",2,1],["حَلَّت شَآمِيَّةً وَحَلَّ قَساً","أَهلي فَكانَ طِلابُها نَصَبا",44,"ب",2,0],["حَلَّت كُبَيشَةُ بَطنَ ذاتِ رُؤامِ","وَعَفَت مَنازِلُها بِجَوِّ بَرامِ",45,"م",1,1],["حَلَّت عَزالِيَهُ الجَنوبُ","فَثَجَّ واهِيَةً خُروقُه",46,"ق",2,0],["حَلَتْ له النجوى ولذَّ الطوافْ","بعالم الحسنِ ودنيا الخيالْ",47,"ل",1,0],["حَلَّ تَركُ الصَلاةِ في هَذِهِ الأَر","ضِ وَحَلَّت لَنا عَلَيها الخُمورُ",48,"ر",1,0],["حَلَّتْ سَرَائِرُهُمْ سَوَادَ عُيُونِهِمْ","شَوْقاً إِليْكَ فَثِرْنَ فِي الأَبْصَارِ",49,"ر",1,0],["حَلَّت يَدُ الدَهرِ عِقداً","قَد كُنتُ قَبلُ شَدَدتُه",50,"ت",2,0],["حَلَتْ وَأُحِلَّتْ كريقِ الحبيبِ","فطابَ الصَّبوحُ بها والغَبوقُ",51,"ق",1,0],["حلَّت بِعَبدِ الغنيّ طارِقَةٌ","دَرَّت عَلَيهِ الحَنان وَالشَفَقا",52,"ق",2,1],["حَلَّت لِيَ الخَمرُ وَكُنتُ اِمرَأً","عَن شُربِها في شُغُلٍ شاغِلِ",53,"ل",1,0],["حلتْ لها نجدة الأغيار فاندفعت","لهم تزجي حقوقاً جمةً ودما",54,"م",2,0],["حُلْتِ دُونَ الفُؤادِ، وکلتَذَّكِ القَلْ","بُ، وَخَلَّى لَكِ النِّساءُ الوِصالا",55,"ل",2,0],["حُلْتَ عَنْ عَهْدِنا، وَطَاوَعْتَ حُسا","داُ قيماً كانوا عليكَ رغاما",56,"م",2,0],["حَلَّتُه بَعدَ الأُولى حلُّوهُ إِذ ظَعَنُوا","أيدِى الزَّعَازِعِ مِن نَسجِ البِلَى حُلَلا",57,"ل",2,0],["حلّت من القلبِ سويداءَهُ","وارتسمت في الذهنِ أي إرتسام",58,"م",1,0],["حَلَت لِلناطِقينَ بِها فَظَنّوا","حَماماً طارَ بِالأَخبارِ يَحلا",59,"ل",2,0],["حَلَّت معقودَ ضَفائِرها","أَبكارُ الشِعرِ وخرَّدُهُ",60,"د",2,0],["حلّت مطيته بأشرف منزل","منه المكارم والتقى يستنبط",61,"ط",1,0],["حَلَّتْ حُلَى حَسَنِ الْحُلَى زَيْدَانِ","حَامِي الْحِمَى مَا حَلَّ مِنْ بُلْدَانِ",62,"ن",1,1],["حَلَتْ لَكَ أَيَّامُهُمْ بِالْعُذَيْبِ","وَمِنْ نَكْبَةٍ قَدْ خَلَوْا فَحَلَوْا",63,"و",2,0],["حَلتِ التجاربُ مِنكَ لي فقَبلتُها","والرِّبحُ لي والخاسرُ القدّيس",64,"س",1,0],["حلَّتُكِ الخضراءُ اجتَذَبَت","قلبي فغَدا يهوى الحبَقا",65,"ق",2,0],["حلت محاسنه الايام وامتلأت","منها جهات كَثيرات واقطار",66,"ر",1,0],["حلت مَحاسنهم جيد الزَمان فَما","أصفى الزمات وابها جيده الحالي",67,"ل",2,0],["حَلَتْ أَعْراقُهُ كَرَماً فَباتَتْ","تُتَيِّمُ كُلَّ ذِي أَمَلٍ وَتُصْبِي",68,"ب",2,0],["حَلَّت عَقيدَتُهُ عِقدَ الشُكوكِ فَبِال","أَلفاظِ جَلَّت وَإِن دَقَّت مَعانيها",69,"ي",3,0],["حَلَّت عُقودَ البَردِ عَنّا وَقَد","حَلَّت مِنَ السَعدِ بِأَعلى مَكان",70,"ن",1,0],["حَلَّت بِنَجدٍ وَحَلَّ الوَجدُ في كَبِدي","لِلَّهِ نَجدٌ إِذا أَهدَت نَسيمَ صَبا",71,"ب",2,0],["حَلَّت بِقَلبي وَثَوَت","شَمسٌ لَها البدر حَسَد",72,"د",1,1],["حَلَت حلاه لِقَلبي إذُ شُغِفتُ به","وَالحبُّ أَعذَبُ لي من عَذلكَ السَمِجِ",73,"ج",1,0],["حَلَّت عَقَارِبُ صُدغِهِ في خَدِّهِ","قَمَرا فَجَلَّ بِهَا عَنِ التَّشبِيهِ",74,"ه",1,1],["حَلَّت تُباري النَجمَ في عَليائِهِ","وَاِستَحقَرَت لِلنَيِّرَينِ وَلا عَجَب",75,"ب",1,0],["حَلَّت لَهُ خُطَّةُ العُليا فَلازَمَها","وَقُل ما يَبتَغي مِنها مَحلولُها",76,"ل",3,0],["حَلَّت بِيَثرِبَ داراً دارَ نِعمَتِها","وَحالَ مِن دونِها الأَبوابُ وَالغُرَفُ",77,"ف",1,0],["حَلَّت بِنَعفَي شَرافٍ وَهيَ عاصِفَةٌ","تَخدي عَلى يَسَراتٍ غَيرِ أَعصالِ",78,"ل",1,0],["حَلَّتْ بِنادِي الصَّاحِبِ ابنِ مُحمَّدٍ","فَهْيَ العَرُوسُ ومَنْ جَلاهَا التَّاجُ",79,"ج",1,0],["حلَّت عمامةَ رأسه فتضوعت","منه مفارقه بمثل الزنبق",80,"ق",1,0],["حَلَّت دِيارَكَ آمالُ العُفاةِ وَلا","حَلَّت يَدُ الدَهرِ مِنها مَعقِدَ الطُنُبِ",81,"ب",1,0],["حلّت ولَكن حرَّموا أختها","من ريقةٍ تُجلى على الشاربِ",82,"ب",1,0],["حلَّت بُروجَ السعد حتى أثَّرت","من دورِها في الكائنات مطالبا",83,"ب",2,0],["حلت لكن خلت عن كل معنى","يسوغ أن يسمى بالجواب",84,"ب",1,0],["حلّت كرايمه البديع نظامها","جيد البلاغة في كالأطواقِ",85,"ق",1,0],["حلت بدر ثناك عاطل جيدها","وعن الجمان لها بذاك غناء",86,"ا",2,0],["حلت فؤادي ثم حلت بعضه","خالا بوجنتها هو المرسوم",87,"م",1,0],["حلّت ففاح شذاء عطر بشارة","لاحت برمز من سناء أولي الرشد",88,"د",1,0],["حُلّتْ عُرى النوم عن أجفانِ ساهرة","ردّ الهوى هُدْبَها بالنجم معقودا",89,"د",2,0],["حلّتْ مطاياهم بملتفِّ الغضى","فكأنّما شبّوهُ في الأكبادِ",90,"د",1,0],["حلّتْ مناقِبُك الحسانُ عُقودَها","من لَبّةِ العلياءِ جيداً أتْلَعا",91,"ع",2,0],["حلت قوى صبري وقد علّمت","هاروت أجفانك سحرا أحلال",92,"ل",1,0],["حلت فحلت رباك من حلل","الرياض ما فتح الندى زهرَه",93,"ر",2,0],["حلت عقود المكرمات وقبل ذا","كانت بطلعتك البهية تنظم",94,"م",1,0],["حلتْ في حلوق الذائقين جَنَاتُها","به ولأخلاقِ الرجال طُعومُ",95,"م",1,0],["حلّت لأهل العذَيبِ بعدي","ملحاءُ ممطولةُ السجالِ",96,"ل",1,0],["حلّتْ عن الماضي فعادت يدُ ال","باقي بها تَعقِدُ أزرارَهْ",97,"ر",2,0],["حَلتْ نومةُ العجزِ في عينه","فلم يدرِ ما فضلُ من يَسهَرُ",98,"ر",1,0],["حَلَتْ مِدَحِي لقومٍ لم يَهشّوا","وغنّاه فأطربه المديحُ",99,"ح",1,0],["حلت باسمهِ الأشعار بعد مرارةٍ","وجاد فحلّى جيدها وهو عاطل",100,"ل",1,0],["حلّتْ لها أسماعنا عقد الحُبى","وكذا تُحلُّ لكلِّ شيءٍ هائل",101,"ل",1,0],["حلَّت عزاليه عشيةَ خيط","المزن فيها غير منحلّ",102,"ل",1,0],["حلَ