aspx?id=189885",""],[3591,"هكذا هكذا وإلاّ فلالا","https://www.poetsgate.com/ViewPoem.aspx?id=149456",""],[5111,"كُؤوسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212314",""],[5111,"نَوَاسٍ","https://www.poetsgate.com/ViewPoem.aspx?id=212526",""],[5111,"يا قُضَاةً","https://www.poetsgate.com/ViewPoem.aspx?id=212529",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5187,"دمعة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=29697",""],[307,"ضحايا كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=214753",""],[5443,"جنَّة الدُّنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185139",""],[5452,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=119185",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5732,"ياما برأس الناب","https://www.poetsgate.com/ViewPoem.aspx?id=177954",""],[5747,"شبيك لبيك","https://www.poetsgate.com/ViewPoem.aspx?id=61616",""],[5751,"قرويةٌ هذي الأغاني","https://www.poetsgate.com/ViewPoem.aspx?id=215017",""],[5837,"وجه الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=181759",""],[5943,"بيروت تقصفُ","https://www.poetsgate.com/ViewPoem.aspx?id=34804",""],[5982,"يا سماك البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176599",""],[6113,"قصتي مع هيله...","https://www.poetsgate.com/ViewPoem.aspx?id=77497",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""],[6142,"ما كل حمال أعباء البلا بصبو","https://www.poetsgate.com/ViewPoem.aspx?id=155721",""],[6176,"رأيت جرحي واقفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65154&r=&rc=5",""],[6223,"حقول الشوك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1214&r=&rc=3",""],[6287,"عزوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66138&r=&rc=2",""]],"verses":[["ذاقَهُم مُستَحلِياً أَرواحَهُم","وَرَأى المَضغَ طَويلاً فَاِستَرَطَ",0,"ط",1,0],["ذَاقَ الطُّغَاةُ مَرَارَةَ الوِرْدِ الَّذِي","شَرَعُوا وَسَاءَتْ شِرعَةُ الطُّغْيَانِ",1,"ن",1,0],["ذَاقَ أَذَى النَّاسِ وَلَكِنَّهُ","لَمْ يَنْتَقِمْ يَوْماً وَلَمْ يَنْقِمِ",2,"م",1,0],["ذاقوا كَما ذاقَ مَن قَد كانَ قَبلَهُمُ","وَاِستَعقَبوا عَثرَةَ الأَقيانِ إِذ عَثَروا",3,"ر",3,0],["ذاقَ الفَرَزدَقُ وَالأُخَيطِلُ حَرَّها","وَالبارِقِيُّ وَذاقَ مِنها البَلتَعُ",4,"ع",1,0],["ذاقَ الزُبَيرِيُّ غِبَّ الحِنثِ وَاِنكَشَفَت","عَنِ اِبنِ فاطِمَةَ الأَقوالُ وَالتُهَمُ",5,"م",1,0],["ذاقَ الهَوى صِرفاً فَأَعقَبَ قَلبَهُ","فِكرَ الصُحاةِ وَسَكرَةَ المُتَنَبِّذِ",6,"ذ",1,0],["ذاق ما ذاق فيّ الصبابة إلا","ذَبحَةَ الرُّوحِ وانفصالَ التوائم",7,"م",1,0],["ذاقوا به كلّ ضيقٍ لا انفساحَ له","تصافنوا فيه طَرْقَ الماء واقتسموا",8,"م",3,0],["ذاقُوا الرَّدى جُرَعاً فَاِستَسلَمُوا جَزَعاً","لِلصُّلحِ وَالحَربُ مَرقاةٌ إِلى السَّلَمِ",9,"م",1,0],["ذاقوا الوَبالَ فَما اِستَفاقَ غُواتُهُم","وَالناسُ يَكشِفُ غَيَّهُم ما جَرَّبوا",10,"ب",3,0],["ذاقَ من شِدّةِ الطوَى ما كفاهُ","وهو مُستحصِدُ العزيمةِ رَاضِ",11,"ض",1,0],["ذاقَت مِنَ الأَعادي","عَينايَ لَحظاً مُرّا",12,"ر",2,0],["ذاقَها مُذْ كان في الغاب لعوبا","يتغذّى من ثمار الشَّجرِ",13,"ر",1,0],["ذاقَ أَيّامَهُ فكانَ سَواءً","عِنْدَهُ طَعْمُ شُهْدِها والصّابِ",14,"ب",1,0],["ذاقتِ الثُّكْلَ فِي بنُوَّتِهَا الأمْ","جَادِ بَعْدَ الأُبوَّةِ الأمْجَادِ",15,"د",1,0],["ذَاقَ مِنْ تَعْذِيبِ دُقْلَتْ","يَانِ نَاراً وَحَدِيدا",16,"د",2,0],["ذا قوّة وسلطان","لا تخش ضدّ معيان",17,"ن",1,0],["ذاق الهوان على البطحاء منبطح","وهام ليلاً إلى الأقطار مغترب",18,"ب",1,0],["ذاقَ ما ذاقَ مِن","خمرِ الهَوى وانتحبْ",19,"ب",1,0],["ذاق مليكُ الروم من صابها","ما لم يكن قبلُ بذوَاقِ",20,"ق",1,0],["ذاق المرار لفرقة أوطانه","فقد المراة فرقة الروح البدنْ",21,"ن",1,0],["ذَا قَبَلٍ دَيدَنَها فَاَوجَفَت","تَنفِى بِرِجلَيها الحَصَى كَما نَفَت",22,"ت",1,0],["ذاقوا الرّدى وتُخُرِّموا","بِيَدِ الدِعيّ ابنِ الدعِيّه",23,"ي",2,0],["ذاقُوا ندامةً لو أَكَلُوا ال","خُّطْبانَ لم يُوجَدْ لهُ عَلْقَمْ",24,"م",1,0],["ذاقت من ابنٍ مرَّها بمرارةٍ","مُرّاً وأدنى مُرِّ ذاكَ الصاب",25,"ب",1,0],["ذاقت نميراً في العُذَيب ماءه","وقد أُذيقَتْ بعده وبالَها",26,"ل",3,0],["ذَاقُوا لَذِيذَ الْفُسْتُقِ الْعَذْبِ الْجَنَى","فِيهِ كَمَا انْتَقَدُوا لَدَيْهِ السُّكَّرا",27,"ر",2,0],["ذاق الخلود بألوان مجنحة","فوق النجوم وفي ألوان آكام",28,"م",1,0],["ذاقوا مِنَ الوجدِ وأسبابِه","بعدَ نوى الجيرةِ ما ذاقوا",29,"ق",3,0],["ذاقوا من الحبِّ راحاً بالنُهى مُزِجَتْ","فأدركوا الصّحوَ في حالاتِ سُكرِهمِ",30,"م",1,0],["ذاق الأمرين من ذل ومصغبة","ومن مظالم ما ينفك يرويها",31,"ي",3,0],["ذاقوا الرّدى مِن بعد ما ذوّقوا","أمثالَهُ بالبيضِ والسُّمْرِ",32,"ر",1,0],["ذاقَ الرّدى دافعُ القصرِ المَشيدِ به","وناعمٌ بين جنّاتٍ وأنهارِ",33,"ر",1,0],["ذاق الرّدى متكِرّمٌ ومبخّلٌ","وأتى الحِمامَ معجّلٌ ومعمّرُ",34,"ر",1,0],["ذاقَتْ شِفاهُهُمُ طعمَ الرّدى مَقِراً","وَطالَما كانَ يَجري بينها الشَّهَدُ",35,"د",1,0],["ذاقَ الحِمامَ مبذّرٌ ومُقتّرٌ","وَأَتى إليه مبغضٌ ومحبّبُ",36,"ب",1,0],["ذاق المحب له حلاوة ذكره","فبذكره لا بالحلاوة يغتذي",37,"ذ",2,0],["ذاقت العين من محيَّ","اهُ مِلْحاً وسُكَّرهْ",38,"ر",2,0],["ذاقوا الأمر من العذاب وبعضهم","جادوا لفادي الخلق بالأعمار",39,"ر",1,0],["ذاقَ العِدا مِن سُلافِ طَعنِهِم","كَأساً بِغَيرِ العَنقودِ تَختَمِرُ",40,"ر",1,0],["ذا قاذفٍ كبداً له قطعاً وذا","في كربلاء مقطع الأعضاء",41,"ا",2,0],["ذا قويقٌ وجوشنٌ قابَ قَوْسَيْ","نِ وهذي الرُّبى وهذي القصور",42,"ر",1,0],["ذا قبرُ (جعفر) يطفو فوقها كَمَدَاً","ما زلتَ مفتقِدَاً ما زالَ مفتَقَدَا",43,"د",2,0],["ذاقت (به) كأس المنية عنوة","فغدت بها كاس المنية تشرب",44,"ب",1,0],["ذاقَ الحَديدَ فَما عَلَتهُ كَزازَةٌ","تَعلو وُجوهَ الصيدِ وَهيَ كَوالِحُ",45,"ح",1,0],["ذا قُحَم أَمْسَتْ بِهِ سَوامِرا","شُهْباً تَشُقُّ الظُلَم الأَخاضِرا",46,"ر",2,0],["ذاقوا المرارة حلوة لما رأوا","ما كان فيها من وفور جزاء",47,"ا",2,0],["ذاق كأس الموت سما ناقعا","حين لم يضمر من الموت حذارا",48,"ر",2,0],["ذاقوا بأَفواه القلوب طَعاما","يحيي الموات وَيبرىء الأسقاما",49,"م",2,1],["ذا قول وعاد أقوال لشاعر طنان","هواجسه وقت الحروب كثيره",50,"ر",2,0],["ذاق الزمان فما استحلى مذاقته","وجرب الدهر تجريب الفتى الحذر",51,"ر",1,0],["ذاق وبال آمره حيث هوى","في هوة ليس له من منقذ",52,"ذ",1,0],["ذاقت الموت مرةً هي أما","أنا فالموتُ كلَّ يوم غذائي",53,"ي",1,0],["ذاق البلية واجفاً وهو الذي","ان سار سار الناس حول ركابه",54,"ب",2,0],["ذاقَ عَذلَ المحافِظينَ مِنَ القَو","مِ وَمُرَّ المَلامِ وَالتَفنيدِ",55,"د",1,0],["ذاقَ المَنونَ بِكَفِّهِ مُتَجَرِّعاً","وَمَضى يَجُرُّ ذُيولَ عارٍ أَكبَرِ",56,"ر",1,0],["ذَاقَ طعمَ الوِصالِ مِرآتُ كُلِّى","بالمُحَيَّا الجميلِ مَهما تَحُوذُ",57,"ذ",1,0],["ذا قومي يهزه الدل غصنا","بين دعصين من نقا ردفيه",58,"ي",2,0],["ذاق موتاً محمد بن طغج","هو ليث الشرى وغيث الغمام",59,"م",1,0],["ذا قُرَشِيٌّ كَما يَقولُ وَذا","مَولَىً وَهَذا بِزَعمِهِ عَرَبي",60,"ب",2,0],["ذاق ذرعا بالأماني","وهو في نفس المكان",61,"ن",1,0],["ذاقه ستا تركن","كل معنى خاويا",62,"ي",2,0],["ذاقَ الغَرام فَلا يَنفك ذا شجن","إِلى الوِصال وَمَن ذاقَ الغَرام دَرى",63,"ر",2,0],["ذاقوا ببدر منه بأس باسل","وشاهدوا بالفتح عفو مقتدر",64,"ر",1,0],["ذا قُوَّةٍ وَذا شَبابٍ مُقتَبَل","لا جَزعَ اليَومَ عَلى قُربِ الأَجَل",65,"ل",1,0],["ذاقَت تميمٌ عركَتَينِ عذابَنا","بالسند من عمرٍ وم داودِ",66,"د",1,0],["ذاقت فراق أحبة من بعدهم","سهرت نواظرها على جفن قذي",67,"ذ",2,0],["ذاقت عيوني بعد أن","أرسلت لذات المنام",68,"م",1,0],["ذاقها صابرًا وساغ مريرًا","من جني دهره ومن إنسانِهْ",69,"ن",2,0],["ذاق المدامة وانثنى فكأنه","غصن رطيب بالنسبم قد اغتذا",70,"ذ",2,0],["ذاقوا بيض الظبى حمر المنون وإن","شككت تخبرك الاشلاء والرمم",71,"م",1,0],["ذا قبس أخي فِي يدّك","أو فصوص ياقوت أحمر",72,"ر",1,0],["ذا قاتل الخل الحبيب دنا","فعسى هنا فصل الخطاب لنا",73,"ن",2,0],["ذا قُرصُك مَن حَدَّقَ فيهِ نَظَراً","بالنارِ سملتِ عَينَه تَكحيلا",74,"ل",2,0],["ذاقَت مَريرَ السَقمِ مِن عَهدِ الصِبا","حَتّى قَضَت أَيّامَها تَتَوَجَّع",75,"ع",1,0],["ذاقَها ادَمٌ فَهامَ مِنَ الوَجْدِ","عَمِيدا نَشْوانَ مِنْ رَياها",76,"ا",3,0],["ذَاْقَ الأَعَاْدِيْ - فِي الْمَعَاْرِكِ - بَأْسَهُ","فَلِكُلِّ بَأْسٍ - مَاْ عَدَاْهُ - نَفَاْدُهُ",77,"د",2,0],["ذا قلبها يُشوَى على جمر المكا","رهِ والجوى يوري الزناد ويشعفُ",78,"ف",1,0],["ذَاقَ قَلبِي كَوْثَرًا فِي جَنَّتِي","حِينَ زِنْتِ البَيْتَ رَاقَ المَطْعَمُ",79,"م",1,0],["ذا قاربيْ، ولقدْ تجاوزَ عهدَهُ","وهناكَ بحرٌ، لستُ أبلُغُ مَدَّهُ",80,"د",2,1],["ذا قوامٌ أعجب به من قوامٍ","قامت الأرض حين قام ومالا",81,"ل",2,0],["ذا قَصِيْدي فِيْ حُتُوفٍ","ذِكْرَياتِي مَزَّقَتْهَا",82,"ت",3,0],["ذَا قَصِيْدِيْ اسْكِرِيْهِ","مِنْ نَوَاسِيْ شَفَتَيْكْ",83,"ك",1,1],["ذَا قَصِيْدِيْ فِيْ غَدِيْرٍ","حَرَمَتْهُ مِنْ صَفَا",84,"ف",2,0],["ذَا قَرِيضِي جَاءَكُمْ لَبَّى النِّدَا","فَخْرُهُ لُقْيَا أَسَاتِيذِ اللِّسَانِ",85,"ن",1,0],["ذاقت فمر مذاقها فتيقظت","فتضامنت فتوحد التدبير",86,"ر",1,0],["ذاقَ طعمَ الوجدِ وازْداد الجوى","فاستفاقَ الليلُ يبكي مِن أساهْ",87,"ا",2,0],["ذاقوا الوباء أوابداً من ضرِّها","شابَ الوليدُ وأجهشَ المتريّبُ",88,"ب",1,0],["ذاقَ المرارةَ في دنياه محتمِلاً","أوزاره عند محصيها مثاقيلا",89,"ل",2,0],["ذاق العراق وبالا من مظالمهم","يستنجد العدل والإسلام قد حظرا",90,"ر",2,0],["ذاق طعم العُلى فطاب فأرسى","في علاها بناءه وادّعاها",91,"ا",3,0],["ذا قد حبونا بالمعالي","أخا قد كان كالعبد المهين",92,"ن",1,0],["ذاق مُرَّ العذاب رهن الزنا","زينِ وبطش ِالجلادِ واسْتِجْوابِهْ",93,"ب",2,0],["ذاق أنْجالي غربةَ الدار أعواماً","فلمْ يُنْسهم بها الدار حينُ",94,"ن",1,0],["ذا قول من هو ساهر الطرف ما نام","يعد شيء شاهر بالنظاير",95,"ر",1,0],["ذا قلبي اللي تحت رحمة ولاتك","يمشي على طاعتك شبيك لبيك",96,"ك",1,0],["ذاقوا غباري خائبينَ وخَوَّضوا","في محض ضحضاحٍ وأوهنَهُمْ تَعَبْ",97,"ب",1,0],["ذاق المذلة من مدح كل شحّاذ","يبغى الغناة وزاد بالهزل هدره",98,"ر",2,0],["ذاقت مرارًا عهودًا لاضياءَ لها","بكلِّ مخزٍ وفسقٍ أوْجدوا فيها",99,"ي",3,0],["ذاق من لحمي ونال ما تمنّى,","أنني والحلم ما زلنا نعاني.",100,"ن",2,0],["ذاق الشعرمن شيخةالجن هيله","من حرصهاسوت على الراس فيه",101,"ي",2,0],["ذاقوا عسيلة شيطان الهوى فَهَوَوْا","واستمرؤوا البغيَ، حتى جورهم غَلَبا",102,"ب",2,0],["ذاق الأمير أمري محنةٍ وبلا","لا تستطيع لهاة الصبر تحسيها",103,"ي",3,0],["ذاقوا وما ذقتُ إلا مرّ قافيةٍ","تحتَ اللسانِ وفي الفَودينِ تستعرُ",104,"ر",1,0],["..........ذاق اللذائذ جاهلا وغدا يُعالجُ مرّها!","ماكان أشقاه بها! لو كان يعلم ضُرّها!",105,"ا",1,0],["ذا قلبها أم تراه البحر في غضب","يحكي المواجع إن طالت لياليه",106,"ي",2,0]]}