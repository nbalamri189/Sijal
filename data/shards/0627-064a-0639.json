{"poems":[[53,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[53,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[53,"أي عيد من الهوى عاد قلبي","https://www.aldiwan.net/poem30718.html","الخفيف"],[77,"يا نسيم الصبا على الأوراق","https://www.aldiwan.net/poem35898.html","الخفيف"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[86,"ثمن المجد والمحامد غالي","https://www.aldiwan.net/poem10352.html","الخفيف"],[86,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[71,"حنين إلى الأوطان ليس يزول","https://www.aldiwan.net/poem4008.html","الطويل"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[93,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[93,"يا عائداً برعاية الرحمن","https://www.aldiwan.net/poem11169.html","الكامل"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[93,"لم يخطيء التوفيق صاحبه","https://www.aldiwan.net/poem11208.html","أحذ الكامل"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[83,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[23,"أوحش الجنبذان فالدير منها","https://www.aldiwan.net/poem21573.html","الخفيف"],[72,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أيادي بني الجراح عندي كثيرة","https://www.aldiwan.net/poem64032.html","الطويل"],[51,"أيعيب مشيي جاهل لو أنه","https://www.aldiwan.net/poem64670.html","الكامل"],[51,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[51,"إني رأيتك حالما أنشدتني","https://www.aldiwan.net/poem65964.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"ألا أيها الموسوم باسم وكنية","https://www.aldiwan.net/poem66404.html","الطويل"],[91,"سألت وقد مرت الشمأل","https://www.aldiwan.net/poem9059.html","عموديه"],[91,"يا عبيد اللّه لا زلت","https://www.aldiwan.net/poem61853.html","مجزوء الرمل"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[92,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[89,"لا تلم في يوم ضعيفا اذا ما","https://www.aldiwan.net/poem44624.html","الخفيف"],[89,"قد تعذبت في العراق كثيرا","https://www.aldiwan.net/poem44870.html","الكامل"],[85,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"نصيبي منك لوم العاذلات","https://www.aldiwan.net/poem62649.html","الوافر"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[45,"نفقت نفوق الحمار الذكر","https://www.aldiwan.net/poem63583.html","الخفيف"],[28,"أيعجب الناس أن أضحكت خيرهم","https://www.aldiwan.net/poem5161.html","البسيط"],[61,"أما آن للملحي أن ينشر الودا","https://www.aldiwan.net/poem51722.html","الطويل"],[61,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[49,"طالما احلولى معاشي وطابا","https://www.aldiwan.net/poem10344.html","المديد"],[49,"أي عيش يكون أبلغ من عي","https://www.aldiwan.net/poem62174.html","الخفيف"],[66,"إن أكن قد جنيت في السكر ذنبا","https://www.aldiwan.net/poem39042.html","الخفيف"],[74,"أي عيش أو غذاء أو سنه","https://www.aldiwan.net/poem13272.html","الرمل"],[105,"أهاب الحق فاستبقوا كراما","https://www.aldiwan.net/poem41938.html","الوافر"],[105,"يا أيها القوم ماذا في حقائبكم","https://www.aldiwan.net/poem43072.html","البسيط"],[46,"إذا كان إكرامي صديقي واجبا","https://www.aldiwan.net/poem22078.html","الطويل"],[46,"لا تبدأوني بالعداوة منكم","https://www.aldiwan.net/poem22485.html","الكامل"],[46,"أما الحسام فما أدناك من أجل","https://www.aldiwan.net/poem22791.html","البسيط"],[46,"أيعلم نجم طارق برزية","https://www.aldiwan.net/poem23016.html","الطويل"],[46,"حياة وموت وانتظار قيامة","https://www.aldiwan.net/poem23509.html","الطويل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199492","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[45,"نَفّسَتْ قُرْبَها عَلَيناَ كَنُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=32955",""]],"verses":[["أَيَعلَمُ قَبرٌ بِالجُنَينَةِ أَنَّنا","أَقَمنا بِهِ نَنعى النَدى وَالمَعالِيا",0,"ي",2,1],["أَيُّ عُذرٍ لَهُ إِلى المَجدِ إِن ذُل","لَ غُلامٌ في غِمدِهِ المَشرَفِيُّ",1,"ي",1,0],["أَيَعرُقُني الطَوى وَالرَوضُ حالٍ","وَيَغلِبُني الظَما وَالبَحرُ طامِ",2,"م",1,0],["أَيَعومُ المَجهولُ بَحراً وَلا يَن","قَعُ غُلّاً لِلفاضِلِ المَعروفِ",3,"ف",1,0],["أَيُّ عيدٍ مِنَ الهَوى عادَ قَلبي","بَعدَما جَعجَعَ الدُجى بِالرَكبِ",4,"ب",1,1],["أيُّ عيْشٍ فيهِ قطَعْنا وأُنْسٍ","ساقَ شمْلَ السّرورِ أيَّ مَساقِ",5,"ق",1,0],["أَيُّ عَهْدٍ لَيْسَ يُرْمَى","بِانْتِكَاثٍ وَانْتِقَاضِ",6,"ض",1,0],["أيَعْقُوبُ مَا حُزْنِي عَلَيْكَ بِمُنْقَضٍ","وَلاَ أُنْسُ إِنْسَانٍ مُصَابَكَ أَنْسَانِي",7,"ي",1,0],["أَيَعيشُ الرِئبالُ في الغابِ جيلاً","وَيَمُرُّ الغُرابُ بِالأَجيالِ",8,"ل",1,0],["أَيُعجِبُني مِنكِ يَومَ الوِفاقِ","سُكوتُ الجَمادِ وَلِعبُ الصَبي",9,"ي",1,0],["أَيَعودُ مِنكَ الآمِلونَ بِما رَجَوا","وَنَعودُ نَحنُ بِذَلِكَ الحِرمانِ",10,"ن",1,0],["أَيَعثُرُ بي دَهري عَلى ما يَسوءُني","وَلي في ذَرا المُلكِ العَزيزِ مَقيلُ",11,"ل",1,0],["أَيُعوِرُ مِن جارِ السِماكَينِ جانِبٌ","وَيُمعِزُ في ظِلِّ الرَبيعِ جَنابُ",12,"ب",1,0],["أيعدل باقٍ صيغ من جوهر النهى","ببعض الثرى الفاني وإن كان عسجدا",13,"د",2,0],["أَيَعُودُ فِي رَايَاتِ مِصْرَ وَظِلُّهُ","فَوْقَ القُرَى يَمْشِي بِلا اسْتِئْذَانِ",14,"ن",1,0],["أَيُّ عَذْبِ الخِطَابِ حُلْوِ المَعَانِي","رُزْئَتْهُ أَسْمَاعُهُمْ وَالعُيُونُ",15,"ن",1,0],["أَيَعِزُّ أَمْنَعُ مَا يَعِزُّ عَلَى","تِلْكَ العَزَائِمِ مِنْكَ وَالفِطَنِ",16,"ن",1,0],["أَيْ عُصْبَهَ الْخَيْرِ الَّتِي رَقَدَتْ وَقَدْ","نَفِذَتْ عَزَائِمُهَا وَحَقَّ جَمَامُ",17,"م",1,0],["أي عروسا بخماره","تسحر النس بخماره",18,"ه",1,0],["أيُعَدّ فخراً للوزير جلوسه","فَرِحاً على الكرسيّ وهو مُكتَّف",19,"ف",1,0],["أَيُّ عَيشٍ أَلَذُّهُ لَستِ فيهِ","أَو تُرى نِعمَةٌ بِهِ وَسُرورُ",20,"ر",1,0],["أيعلم ذو التسليك أن جفوننا","على شخصه النائي قد انْتثرت دُرَّا",21,"ر",2,0],["أيعزُبُ عنك الرأيُ في أن تُثيبني","مقيماً مصوناً عن عناء المطالبِ",22,"ب",1,0],["أيعجب الناس أن أضحكتُ سيدهم","خليفةَ الله يُستسقى به المطر",23,"ر",1,0],["أيعطش أمثالي وواديك فائضٌ","ويُجدِب أمثالي وواديك أخضر",24,"ر",1,0],["أيعيبُ مشيي جاهلٌ لو أنه","يمشي لأصبح ضُحكةً في الناسِ",25,"س",1,1],["أيعجِزُ فضلُك عن خادمٍ","وأنت بأمر الورى مستقلُّ",26,"ل",1,0],["أيعوذُني متعوِّذٌ من دهرِهِ","فأعيذَ مالي بالمعاذر والعِلَلْ",27,"ل",1,0],["أيُّ عذرٍ لتائبٍ لا إلى اللَّ","ه ولكن إلى شبِيه الثغام",28,"م",1,0],["أيُّ عُذْرٍ لنا وأيُّ جوابٍ","حين نُدْعَى على رؤوسِ الأنامِ",29,"م",1,0],["أيعرضُ عني باخلاً بكتابهِ","أخٌ ليَ قلبي عندَهُ غَلِق الرَّهن",30,"ن",1,0],["أَيَعدو وَراءَكِ جَيشٌ كَثيفٍ","أَمِثلَكِ يُرهِبُهُ الجَحفَلُ",31,"ل",1,0],["أي عبدٍ منك لِلَّ","هِ يُسَمَّى بِعُبَيْدِ",32,"د",1,0],["أَيُّ عيشٍ هذا وأَيُّ حياةٍ","رُبَّ عيشٍ أَخَفُّ منه الحِمَامُ",33,"م",1,0],["أيُعَدُّ هذا في الوجود جريمةً","أينَ العدالةُ يا رفاقَ شبابي",34,"ي",1,0],["أي عصفور والضعيف جبان","ليس يخشى من صولة البازي",35,"ي",1,0],["أي عدل يجيئ ممن يرى العذ","ل لحقد في نفسه ان يجورا",36,"ر",2,0],["أي عصر ببعلبك دفين","تحت ذاك الثرى وتلك العماد",37,"د",1,0],["أيّ عزيز هانا","أىّ قدير ودانا",38,"ن",2,0],["أَيُعبَدُ اللَهُ بِسَومِ الوَرى","ما لا يُسامُ العَيرُ في المِقوَدِ",39,"د",1,0],["أَيُّ عَينٍ تَأَمَّلَتكَ فَلاقَت","كَ وَطَرفٍ رَنا إِلَيكَ فَآلا",40,"ل",2,0],["أَيَعتَرِضُ المُؤَبِّنُ دونَ حَقّي","وَتِلكَ مِنَ الدَواهي المُعضِلاتِ",41,"ت",1,0],["أَيَعودُ الشَبابُ أَم يَتَوَلّى","مِنهُ في الدَهرِ دَولَةٌ ما تَعودُ",42,"د",1,0],["أَيَعقوبَ أَختارُ أَم صالِحاً","وَما فيهِما مِن خِيارٍ لِحُر",43,"ر",1,0],["أَيَعجَبُ الناسُ أَن أَضحَكتُ خَيرَهُمُ","خَليفَةَ اللَهِ يُستَسقى بِهِ المَطرُ",44,"ر",1,1],["أيعضَبُ أن حَلَّيْتُ كفَّ ابنِ هاشمٍ","سِوارَ هِجاج يَقرِضُ القلبَ لا الزَّنْدا",45,"د",2,0],["أَيعودُ أَيَّتُها الخيامُ زمانُنا","أَم لا سبيلَ إليه بعدَ ذَهابِه",46,"ب",2,0],["أَيُّ عَيشٍ دامَ فيها لِحَيٍّ","أَيُّ حَيٍّ ماتَ فيها فَآبا",47,"ب",2,0],["أَيُّ عَيشٍ يَكونُ أَبلَغَ مِن عَي","شٍ كَفافٍ قوتٍ بِقَدرِ البَلاغِ",48,"غ",1,1],["أَيُّ عَقلٍ يَبقى هُناكَ لِمِثلي","بَينَ سُكرِ الهَوى وَسُكرِ الراحِ",49,"ح",1,0],["أَيُّ عَيشٍ أَو غِذاءٍ أَو سِنَه","لِاِبنِ إِحدى وَثَمانينَ سَنَه",50,"ن",2,1],["أَيعرفُ مَوْضِعَ الأحياءِ قومٌ","أَحَبّوا الموتَ واخْتاروا الحِماما",51,"م",2,0],["أَيَعلَمُ القَومُ أَنّا لا حُلومَ لَنا","أَم يَجهَلُ الوَفدُ أَنّا لَيسَ نَتَّفِقُ",52,"ق",1,0],["أَيَعقِلُ نَجمُ اللَيلِ أَو بَدرُ تِمِّهِ","فَيُصبِحَ مِن أَفعالِنا يَتَعَجَّبُ",53,"ب",1,0],["أَيَعيثُ ضَوءُ الصُبحِ ناظِرَ مُدلِجٍ","أَم نَحنُ أَجمَعُ في ظَلامٍ سَرمَدِ",54,"د",1,0],["أَيَعلَمُ اللَيثُ لَمّا راحَ مُفتَرِساً","بِأَنَّهُ عَن قَريبٍ سَوفَ يُفتَرَسُ",55,"س",1,0],["أَيَعلَمُ نَجمُ طارِقٍ بِرَزِيَّةٍ","مِنَ الدَهرِ أَم لا هَمَّ لِلإِنسِ طارِقُه",56,"ق",2,1],["أَيَعكِسُ هَذا الخَلقَ مالِكُ أَمرِهِ","لَعَلَّ الحِجى وَالحَظُّ يَجتَمِعانِ",57,"ن",1,0],["أيّ عَيش مَرّ لي في ظِلّهِ","أسَفي إذ صارَ حظّي منهُ أَيْ",58,"ي",1,0],["أيعاد ما فد مر من عُمرانها","أم ذلك العمران غير معاد",59,"د",1,0],["أيْ عميقَ اللجات ماذا بأيا","م صبانا ماذا بهن صنعتِ",60,"ت",1,0],["أيُّ عُدوانٍ زَريِّ المظهَرِ","بِدَمٍ قانٍ ودمْعٍ مُهْدَرِ",61,"ر",1,0],["أَيَعْجِزُ هَذَا الأَيْدُ وَالمَجْدُ كُلُّهُ","فَيَرْجِعُ دُونَ البَيْنِ وَهْوَ كَلِيلُ",62,"ل",1,0],["أَيَعْرُوهُ حُزْنٌ فَاقْرَإِ الْوَصْفَ تُلْفِهِ","سَحَاباً رَمَى ظَلاًّ عَلَى الْكَوْنِ أَرْبدَا",63,"د",2,0],["أَيُعْطَى الشُّغْلُ أَضْعَافاً","لِمَا يُعْطِي مِنَ الأَجْرِ",64,"ر",1,0],["أَيُّ عَيْشٍ فَانٍ يَطِيبُ لِذِي قَدْ","رٍ خَطِيرٍ بِغَيْرِ مَعْنىً خَطِيرِ",65,"ر",1,0],["أَي عِصْبَةَ الْخَيْرِ دَارُوا أَبْرِيَاءَ هَوَوْا","صَرْعَى مَطامِعِ قُوَّادٍ وَسُوَّاسِ",66,"س",1,0],["أَيَعْقِلُ حُزْني عَنْ وَدَاعِكَ مَنْطِقِي","وَأَعْلَمُ أَنَّا عَنْ قَرِيبٍ سَنَلْتَقِي",67,"ق",2,1],["أَيَعلَمُ مانَلقى نَعَم يَعلَمونَهُ","عَلى النَأيِ أَحبابٌ لَنا وَحَبائِبُ",68,"ب",1,0],["أيعذرني جمالك إنْ رآني","وأظفار الكهولة في ضلوعي؟",69,"ي",1,0],["أيُّ عهدٍ يرتضيه باسلٌ","عربي النَبْعِ ريفيُّ الْجِماح",70,"ح",1,0],["أيُّ عهدٍ هو أن أُذْبحَ من","غيرِ سكِّينٍ ولا أشكو الذباح",70,"ح",1,0],["أيُعْوِزُهُ دم، ولنا عروقٌ","جرت فيها دماء لاَ تُكَال؟",71,"ل",1,0],["أيعود الشّبابُ، أمْ مَا يتَوَلّى","مِنْهُ في الدّهْرِ، دَوْلَةً ما تَعودُ",72,"د",1,0]]}