net/poem32012.html","الطويل"],[270,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[270,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[280,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[304,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[309,"أيعتز الفتى بالمال زهوا","https://www.aldiwan.net/poem50301.html","الوافر"],[348,"أي عيد مضى ومملوكك الو","https://www.aldiwan.net/poem20252.html","الخفيف"],[361,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[364,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[371,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[371,"سما لك برق أو بدا لك نور","https://www.aldiwan.net/poem57391.html","البسيط"],[393,"أيعسوب دين الله صنو نبيه","https://www.aldiwan.net/poem53623.html","الطويل"],[400,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[400,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[402,"أأطيع العذول في السلوان","https://www.aldiwan.net/poem46429.html","الخفيف"],[402,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[403,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[405,"أي عذر أن صام عنه ثنائي","https://www.aldiwan.net/poem49568.html","الخفيف"],[416,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[432,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[437,"أين الخليط وأية سلكوا","https://www.aldiwan.net/poem2600.html","الكامل"],[441,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[453,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[453,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[458,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[464,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[464,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[465,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[495,"سل الملك الكريم إلام تبني","https://www.aldiwan.net/poem9760.html","الوافر"],[495,"يا نفس صبرا وإلا فاهلكي جزعا","https://www.aldiwan.net/poem10236.html","البسيط"],[500,"أبدر الحي غلغلت الستاره","https://www.aldiwan.net/poem38010.html","الوافر"],[500,"أي عين رأت حبيبي ونامت","https://www.aldiwan.net/poem38057.html","الخفيف"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[551,"يا عليل الطرف رفقا","https://www.aldiwan.net/poem47264.html","مجزوء الرمل"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[558,"قل لمن هام تابعا أوهامه","https://www.aldiwan.net/poem33499.html","الخفيف"],[575,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[575,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"]],"verses":[["أَيَعلَمُ قَبرٌ بِالجُنَينَةِ أَنَّنا","أَقَمنا بِهِ نَنعى النَدى وَالمَعالِيا",0,"ي",2,1],["أَيُّ عُذرٍ لَهُ إِلى المَجدِ إِن ذُل","لَ غُلامٌ في غِمدِهِ المَشرَفِيُّ",1,"ي",1,0],["أَيَعرُقُني الطَوى وَالرَوضُ حالٍ","وَيَغلِبُني الظَما وَالبَحرُ طامِ",2,"م",1,0],["أَيَعومُ المَجهولُ بَحراً وَلا يَن","قَعُ غُلّاً لِلفاضِلِ المَعروفِ",3,"ف",1,0],["أَيُّ عيدٍ مِنَ الهَوى عادَ قَلبي","بَعدَما جَعجَعَ الدُجى بِالرَكبِ",4,"ب",1,1],["أيُّ عيْشٍ فيهِ قطَعْنا وأُنْسٍ","ساقَ شمْلَ السّرورِ أيَّ مَساقِ",5,"ق",1,0],["أَيُّ عَهْدٍ لَيْسَ يُرْمَى","بِانْتِكَاثٍ وَانْتِقَاضِ",6,"ض",1,0],["أيَعْقُوبُ مَا حُزْنِي عَلَيْكَ بِمُنْقَضٍ","وَلاَ أُنْسُ إِنْسَانٍ مُصَابَكَ أَنْسَانِي",7,"ي",1,0],["أَيَعيشُ الرِئبالُ في الغابِ جيلاً","وَيَمُرُّ الغُرابُ بِالأَجيالِ",8,"ل",1,0],["أَيُعجِبُني مِنكِ يَومَ الوِفاقِ","سُكوتُ الجَمادِ وَلِعبُ الصَبي",9,"ي",1,0],["أَيَعودُ مِنكَ الآمِلونَ بِما رَجَوا","وَنَعودُ نَحنُ بِذَلِكَ الحِرمانِ",10,"ن",1,0],["أَيَعثُرُ بي دَهري عَلى ما يَسوءُني","وَلي في ذَرا المُلكِ العَزيزِ مَقيلُ",11,"ل",1,0],["أَيُعوِرُ مِن جارِ السِماكَينِ جانِبٌ","وَيُمعِزُ في ظِلِّ الرَبيعِ جَنابُ",12,"ب",1,0],["أيعدل باقٍ صيغ من جوهر النهى","ببعض الثرى الفاني وإن كان عسجدا",13,"د",2,0],["أَيَعُودُ فِي رَايَاتِ مِصْرَ وَظِلُّهُ","فَوْقَ القُرَى يَمْشِي بِلا اسْتِئْذَانِ",14,"ن",1,0],["أَيُّ عَذْبِ الخِطَابِ حُلْوِ المَعَانِي","رُزْئَتْهُ أَسْمَاعُهُمْ وَالعُيُونُ",15,"ن",1,0],["أَيَعِزُّ أَمْنَعُ مَا يَعِزُّ عَلَى","تِلْكَ العَزَائِمِ مِنْكَ وَالفِطَنِ",16,"ن",1,0],["أَيْ عُصْبَهَ الْخَيْرِ الَّتِي رَقَدَتْ وَقَدْ","نَفِذَتْ عَزَائِمُهَا وَحَقَّ جَمَامُ",17,"م",1,0],["أي عروسا بخماره","تسحر النس بخماره",18,"ه",1,0],["أيُعَدّ فخراً للوزير جلوسه","فَرِحاً على الكرسيّ وهو مُكتَّف",19,"ف",1,0],["أَيُّ عَيشٍ أَلَذُّهُ لَستِ فيهِ","أَو تُرى نِعمَةٌ بِهِ وَسُرورُ",20,"ر",1,0],["أيعلم ذو التسليك أن جفوننا","على شخصه النائي قد انْتثرت دُرَّا",21,"ر",2,0],["أيعزُبُ عنك الرأيُ في أن تُثيبني","مقيماً مصوناً عن عناء المطالبِ",22,"ب",1,0],["أيعجب الناس أن أضحكتُ سيدهم","خليفةَ الله يُستسقى به المطر",23,"ر",1,0],["أيعطش أمثالي وواديك فائضٌ","ويُجدِب أمثالي وواديك أخضر",24,"ر",1,0],["أيعيبُ مشيي جاهلٌ لو أنه","يمشي لأصبح ضُحكةً في الناسِ",25,"س",1,1],["أيعجِزُ فضلُك عن خادمٍ","وأنت بأمر الورى مستقلُّ",26,"ل",1,0],["أيعوذُني متعوِّذٌ من دهرِهِ","فأعيذَ مالي بالمعاذر والعِلَلْ",27,"ل",1,0],["أيُّ عذرٍ لتائبٍ لا إلى اللَّ","ه ولكن إلى شبِيه الثغام",28,"م",1,0],["أيُّ عُذْرٍ لنا وأيُّ جوابٍ","حين نُدْعَى على رؤوسِ الأنامِ",29,"م",1,0],["أيعرضُ عني باخلاً بكتابهِ","أخٌ ليَ قلبي عندَهُ غَلِق الرَّهن",30,"ن",1,0],["أَيَعدو وَراءَكِ جَيشٌ كَثيفٍ","أَمِثلَكِ يُرهِبُهُ الجَحفَلُ",31,"ل",1,0],["أي عبدٍ منك لِلَّ","هِ يُسَمَّى بِعُبَيْدِ",32,"د",1,0],["أَيُّ عيشٍ هذا وأَيُّ حياةٍ","رُبَّ عيشٍ أَخَفُّ منه الحِمَامُ",33,"م",1,0],["أيُعَدُّ هذا في الوجود جريمةً","أينَ العدالةُ يا رفاقَ شبابي",34,"ي",1,0],["أي عصفور والضعيف جبان","ليس يخشى من صولة البازي",35,"ي",1,0],["أي عدل يجيئ ممن يرى العذ","ل لحقد في نفسه ان يجورا",36,"ر",2,0],["أي عصر ببعلبك دفين","تحت ذاك الثرى وتلك العماد",37,"د",1,0],["أيّ عزيز هانا","أىّ قدير ودانا",38,"ن",2,0],["أَيُعبَدُ اللَهُ بِسَومِ الوَرى","ما لا يُسامُ العَيرُ في المِقوَدِ",39,"د",1,0],["أَيُّ عَينٍ تَأَمَّلَتكَ فَلاقَت","كَ وَطَرفٍ رَنا إِلَيكَ فَآلا",40,"ل",2,0],["أَيَعتَرِضُ المُؤَبِّنُ دونَ حَقّي","وَتِلكَ مِنَ الدَواهي المُعضِلاتِ",41,"ت",1,0],["أَيَعودُ الشَبابُ أَم يَتَوَلّى","مِنهُ في الدَهرِ دَولَةٌ ما تَعودُ",42,"د",1,0],["أَيَعقوبَ أَختارُ أَم صالِحاً","وَما فيهِما مِن خِيارٍ لِحُر",43,"ر",1,0],["أَيَعجَبُ الناسُ أَن أَضحَكتُ خَيرَهُمُ","خَليفَةَ اللَهِ يُستَسقى بِهِ المَطرُ",44,"ر",1,1],["أيعضَبُ أن حَلَّيْتُ كفَّ ابنِ هاشمٍ","سِوارَ هِجاج يَقرِضُ القلبَ لا الزَّنْدا",45,"د",2,0],["أَيعودُ أَيَّتُها الخيامُ زمانُنا","أَم لا سبيلَ إليه بعدَ ذَهابِه",46,"ب",2,0],["أَيُّ عَيشٍ دامَ فيها لِحَيٍّ","أَيُّ حَيٍّ ماتَ فيها فَآبا",47,"ب",2,0],["أَيُّ عَيشٍ يَكونُ أَبلَغَ مِن عَي","شٍ كَفافٍ قوتٍ بِقَدرِ البَلاغِ",48,"غ",1,1],["أَيُّ عَقلٍ يَبقى هُناكَ لِمِثلي","بَينَ سُكرِ الهَوى وَسُكرِ الراحِ",49,"ح",1,0],["أَيُّ عَيشٍ أَو غِذاءٍ أَو سِنَه","لِاِبنِ إِحدى وَثَمانينَ سَنَه",50,"ن",2,1],["أَيعرفُ مَوْضِعَ الأحياءِ قومٌ","أَحَبّوا الموتَ واخْتاروا الحِماما",51,"م",2,0],["أَيَعلَمُ القَومُ أَنّا لا حُلومَ لَنا","أَم يَجهَلُ الوَفدُ أَنّا لَيسَ نَتَّفِقُ",52,"ق",1,0],["أَيَعقِلُ نَجمُ اللَيلِ أَو بَدرُ تِمِّهِ","فَيُصبِحَ مِن أَفعالِنا يَتَعَجَّبُ",53,"ب",1,0],["أَيَعيثُ ضَوءُ الصُبحِ ناظِرَ مُدلِجٍ","أَم نَحنُ أَجمَعُ في ظَلامٍ سَرمَدِ",54,"د",1,0],["أَيَعلَمُ اللَيثُ لَمّا راحَ مُفتَرِساً","بِأَنَّهُ عَن قَريبٍ سَوفَ يُفتَرَسُ",55,"س",1,0],["أَيَعلَمُ نَجمُ طارِقٍ بِرَزِيَّةٍ","مِنَ الدَهرِ أَم لا هَمَّ لِلإِنسِ طارِقُه",56,"ق",2,1],["أَيَعكِسُ هَذا الخَلقَ مالِكُ أَمرِهِ","لَعَلَّ الحِجى وَالحَظُّ يَجتَمِعانِ",57,"ن",1,0],["أيّ عَيش مَرّ لي في ظِلّهِ","أسَفي إذ صارَ حظّي منهُ أَيْ",58,"ي",1,0],["أيعاد ما فد مر من عُمرانها","أم ذلك العمران غير معاد",59,"د",1,0],["أيْ عميقَ اللجات ماذا بأيا","م صبانا ماذا بهن صنعتِ",60,"ت",1,0],["أيُّ عُدوانٍ زَريِّ المظهَرِ","بِدَمٍ قانٍ ودمْعٍ مُهْدَرِ",61,"ر",1,0],["أَيَعْجِزُ هَذَا الأَيْدُ وَالمَجْدُ كُلُّهُ","فَيَرْجِعُ دُونَ البَيْنِ وَهْوَ كَلِيلُ",62,"ل",1,0],["أَيَعْرُوهُ حُزْنٌ فَاقْرَإِ الْوَصْفَ تُلْفِهِ","سَحَاباً رَمَى ظَلاًّ عَلَى الْكَوْنِ أَرْبدَا",63,"د",2,0],["أَيُعْطَى الشُّغْلُ أَضْعَافاً","لِمَا يُعْطِي مِنَ الأَجْرِ",64,"ر",1,0],["أَيُّ عَيْشٍ فَانٍ يَطِيبُ لِذِي قَدْ","رٍ خَطِيرٍ بِغَيْرِ مَعْنىً خَطِيرِ",65,"ر",1,0],["أَي عِصْبَةَ الْخَيْرِ دَارُوا أَبْرِيَاءَ هَوَوْا","صَرْعَى مَطامِعِ قُوَّادٍ وَسُوَّاسِ",66,"س",1,0],["أَيَعْقِلُ حُزْني عَنْ وَدَاعِكَ مَنْطِقِي","وَأَعْلَمُ أَنَّا عَنْ قَرِيبٍ سَنَلْتَقِي",67,"ق",2,1],["أَيَعلَمُ مانَلقى نَعَم يَعلَمونَهُ","عَلى النَأيِ أَحبابٌ لَنا وَحَبائِبُ",68,"ب",1,0],["أيعذرني جمالك إنْ رآني","وأظفار الكهولة في ضلوعي؟",69,"ي",1,0],["أيُّ عهدٍ يرتضيه باسلٌ","عربي النَبْعِ ريفيُّ الْجِماح",70,"ح",1,0],["أيُّ عهدٍ هو أن أُذْبحَ من","غيرِ سكِّينٍ ولا أشكو الذباح",70,"ح",1,0],["أيُعْوِزُهُ دم، ولنا عروقٌ","جرت فيها دماء لاَ تُكَال؟",71,"ل",1,0],["أيعود الشّبابُ، أمْ مَا يتَوَلّى","مِنْهُ في الدّهْرِ، دَوْلَةً ما تَعودُ",72,"د",1,0],["أيعدّون قتل شعب حلالا","ويعدّون قتل فردا حراما",73,"م",2,0],["ايعذر من لمقي الزمام الى الدينا","وما هي الا في الحقيقة كالرؤيا",74,"ي",2,1],["أي عزم له اذا قلت غوثا","قل عزم العضب الصقيل اليماني",75,"ن",2,0],["أَيَعُودُ الضِّياءُ لِلقَلبِ نُورًا","قُدُسِيًّا، يرعى الهُدى والمَحَبَّةْ؟",76,"ب",2,0],["أي عذر من بعد هذا الكتابِ","لِعَرِيٍّ عن حلْيِةِ الكتّابِ",77,"ب",1,1],["أيُّ عُشبٍ في ذلك الأبطحِ السه","ل وماءٍ لمَرتَعٍ ولوِردِ",78,"د",1,0],["أَيُّ عُذرٍ وَقَد أَحَطتِ بِصَرفِ ال","دَهرِ عِلماً وَقَد دَرَستِ الكِتابا",79,"ب",2,0],["أيّ عيشٍ يهنا لي من بعدهم","طار قلبي وعظامي ملّحوا",80,"ح",3,0],["أيعمد ذو لبّ لخدّ مورّد","ويقسمه عمداً إلى شرّ قسمة",81,"ه",1,0],["أيعزل بالمرتد مفت بكفره","ويرفع اجلالا وأهل الهدى تروى",82,"ا",1,0],["أَيُّ عِزٍّ قَد قَدَّموهُ لِرُمحٍ","مِنكُم لَم يُصَدَّ 