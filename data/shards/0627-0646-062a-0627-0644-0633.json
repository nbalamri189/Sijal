[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73098","البسيط"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105174","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76729","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76694","الكامل"],[4739,"انت السؤال","https://www.poetsgate.com/ViewPoem.aspx?id=36914",""],[4750,"خارطة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=180399",""],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[4767,"عزاء القديح","https://www.poetsgate.com/ViewPoem.aspx?id=89967",""],[5010,"هيا ارجعي","https://www.poetsgate.com/ViewPoem.aspx?id=190546",""],[5120,"مِنْ بَعْدِهَا،لَا يَنْتَهِي السَّفَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=181582",""],[5125,"الراهب","https://www.poetsgate.com/ViewPoem.aspx?id=188655",""],[5176,"جرش","https://www.poetsgate.com/ViewPoem.aspx?id=215833",""],[5190,"الكذبة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=153355",""],[5216,"أحزانُ أمَّتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=186987",""],[5257,"والمؤلف ما هلك","https://www.poetsgate.com/ViewPoem.aspx?id=206789",""],[5302,"ملكت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=202727",""],[5324,"يازائرا قبر الحسين.","https://www.poetsgate.com/ViewPoem.aspx?id=210987",""],[5351,"الكرار من جديد","https://www.poetsgate.com/ViewPoem.aspx?id=202211",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[5431,"يامن لحبك بعد الله أنتسبُ","https://www.poetsgate.com/ViewPoem.aspx?id=185167",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5431,"باريس ...","https://www.poetsgate.com/ViewPoem.aspx?id=208588",""],[5525,"ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=7195",""],[5605,"من وحي رمضان 1436 ه","https://www.poetsgate.com/ViewPoem.aspx?id=177651",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5720,"أنتَ الإِلٰهُ","https://www.poetsgate.com/ViewPoem.aspx?id=201610",""],[5818,"وجد وأرق","https://www.poetsgate.com/ViewPoem.aspx?id=197072",""],[5847,"المولد النبوي الشريف لعام 1435 ه","https://www.poetsgate.com/ViewPoem.aspx?id=176834",""],[5861,"شمس الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=188046",""],[5873,"الجمال الأخاذ","https://www.poetsgate.com/ViewPoem.aspx?id=215304",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[5956,"المجد ينبع من عينيك والهممُ","https://www.poetsgate.com/ViewPoem.aspx?id=206263",""],[5956,"يا رب فك الغمة عن طحال ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=214668",""],[6019,"إلى هَجر الحب والنقاﺀ..للأحساﺀ أنشود","https://www.poetsgate.com/ViewPoem.aspx?id=137673",""],[6106,"سيدتنا الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=6302",""],[6106,"واحتنا الغراء","https://www.poetsgate.com/ViewPoem.aspx?id=6311",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[6152,"احفظ غيابي ولا تسمح لعابرة","https://www.poetsgate.com/ViewPoem.aspx?id=213217",""]],"verses":[["أنت السراج المنير والكلأ ال","مُمرِع حَفّت رياضُه غُدَره",0,"ر",2,0],["أنت السماحة يا خليل بأصلها","وبذاتها وبعينها وبأنفها",1,"ف",3,0],["أنتَ السماءُ فَمَن جذبتَ بضَبعِه","كان الورى أرضاً وكان لهم سَما",2,"م",2,0],["أَنتَ السَليلُ فَسُلَّ السَيفُ مُنتَصِراً","لِذِمَّةِ الشِعرِ إِذ ضاعَت لَهُ الذِمَمُ",3,"م",1,0],["أنت السّعيدُ بها ولو أتْبعَتها","كُلَّ الذي لك لم تَزِدْ إلا غِنَى",4,"ن",2,0],["أَنتَ السِماكُ مِنَ البِعادِ وَرُبَّما","سَمّاكَ لَحظُكَ بِالسِماكِ الرامِحِ",5,"ح",1,0],["أنتَ السّبيلُ إلى مصرٍ وطاعَتِها","ونُصْرَةِ الدّين والإسلامِ في حلَب",6,"ب",1,0],["أَنت السَعادة أَنتِ","نامي بربك نامي",7,"ي",1,0],["أنت السعادة والكآبه","والوجد حبك والصبابه",8,"ب",2,1],["أنت السراب ولكني على ظمأي","بأنهر الخمر في الفردوس أفديه",9,"ي",2,0],["أنت السراب عذاب وقده وردى","وتؤنس العين أفياء وأمواه",10,"ا",2,0],["أنتَ السبيلُ إلى النجاةِ فكلنا","لولاكَ كان على شفيرٍ هارِ",11,"ر",1,0],["أنتِ السماء مقرُّ كل موفقٍ","من ربه وبسيره تفضيل",12,"ل",1,0],["أنت السماء بدت لنا","واستعصمت بالبعد عنّا",13,"ن",2,0],["أنت السلام الوارث المتعال وال","متكبر الصمد المجيد المؤمنا",14,"ن",2,0],["أنت السحاب الذي فاضت مناهلهُ","حتى ارتوى كلُّ صادٍ ذائب الكبدِ",15,"د",1,0],["أنت السفينة والصراط","المستقيم لكل عابر",16,"ر",1,0],["أنت السلام فسلمن يا مؤمن","للمؤمنين بحالنا ومآل",17,"ل",1,0],["أَنتِ السَرابُ وَأَنتِ داءٌ كامِنٌ","بَينَ الضُلوعِ فَما أَعَزَّ دَواكِ",18,"ك",1,0],["أَنتَ السَعيد بنا ومن أَسعدته","فَهوَ السَعيد ومن أَبى فالحاصب",19,"ب",1,0],["أَنتِ السَّعادَةُ والمُنى","ترعاكِ عينٌ لا تَنام",20,"م",1,0],["أَنتَ السَخِيُّ فَلِم بَخِلتَ عَلى الوَرى","أَن يُشبِهُوكَ وَلَستَ في البُخَلاءِ",21,"ا",2,0],["أنتَ السماء قريبة قد أطلعت","نجم الوجوه على مياهك راني",22,"ن",2,0],["انت السياسي الحزوم حفيد من","بذوائب الشرف الرفيع تعلقوا",23,"ق",3,0],["أنت السريع والسميعُ الورى","أنت وليي سامعٌ حاديا",24,"د",3,0],["أَنتَ السميّ لهُ وجئتَ مماثلاً","بفضائلٍ تسمو على شُمِّ الذُرى",25,"ر",2,0],["أنت السمي لَهُ والمقتَفي أَثرا","إلى مآثر أبقتها عنايتُهُ",26,"ت",2,0],["أنتَ السَّخيُّ بمُرِّ الهَجرِ لي وأنا","بأدمعُي وغياثُ الدِّينِ بالبِدرَ",27,"ر",1,0],["أنت السرور لكل صب واله","أضحى على مضض الغرام جليدا",28,"د",2,0],["انت السحاب على مكان ينهمي","بالمكرمات وعن مكان يقلع",29,"ع",1,0],["انت السماء فما بها لك رفعة","اطلع علينا الشهب من ابراجها",30,"ج",3,0],["انت السؤال اللي حياتي جوابه","مبادئي ما تعترض مع مباديك",31,"ك",1,0],["أنت السميع لمن حمد وانت المزيد لمن شكر","واللي ما يشكر نعمة المنعم عليه تزولها",32,"ل",3,0],["أنت السلام اللي لك الإسلام وأنت المشمخرر","اللي عجايب قدرتك في المعجبين ذهولها",32,"ل",3,0],["أَنتَ السَّماءُ إِذا الوُجُوهُ خَبَت","أَموَاهُها، واستَأسَدَ الجِبسُ",33,"س",1,0],["أنت السميع لمن دعاك بقلبه","فاسمع إلهي خالص الدعوات",34,"ت",1,0],["أَنْتِ السَّعَادَةُ وَالْهَنَا","طَعْمُ الْحَيَاةِ الرَّاضِيَةْ",35,"ي",2,0],["أَنْتِ السَّنَا،فَأُفُولُ الزَّهْرِ وَاقِفَةٌ","تَرْجُوكِ أَنْ تَقِفِي،وَ الْأَيْكُ،وَ الشَّجَرُ",36,"ر",1,0],["انتِ السحابُ إذا أَقلَّت بالمُنىٰ","مِن مهدِ عينيكِ استَوى العُظماءُ",37,"ا",2,0],["أَنتِ السنا عُمُدٌ لِمَجْدِكِ نُصِّعَت","فَتَأَلَّقِي... يَهنيكِ أَن تَتَأَلَّقي",38,"ق",2,0],["أَنتِ السَّرَابُ ، حَسِبْتُهُ نَهَراً","فَمَشَيْتُ خَلفَ بَرِيقِهِ عُمرَا",39,"ر",2,0],["أنتَ السِّراجُ مُنيرًا دامَ مشْرِقُهُ","ولو تَبِعْناكَ صرنا أكرمَ الأُم",40,"م",1,0],["أنتَ السَّعَادَةُ يَا مُؤلِّفُ .. فَابتَسِم","مِفتَاحُهُم حِينَ المَصَائِبُ .. تَشتَبِكْ",41,"ك",1,0],["أنت السعادة والهناء فأكملي","ما بيننا بالعدل والإنصاف",42,"ف",1,0],["انت السلاح ومنك كلّ شرارة","للثائرين وظل وهجك مشعلا",43,"ل",2,0],["أنت السلام وهم هنا الإرهابُ","وهم العدو الحاقد الكذابُ",44,"ب",1,1],["أنْتَ السَّلام وفيكَ اسْتَسْلمتْ لُغَتي","فَما أّقول وَلَنْ تكْفيكَ أفْكاري",45,"ر",2,0],["أنت السلام إليك القلب منجذبٌ","لولا ضياؤك كاد القلب يغتربُ",46,"ب",1,0],["أنتَ السلامُ وفيكَ القلبُ مُنشغِلٌ","لولا سَلامُك كادَ الغمُ يُقترفُ",47,"ف",1,0],["أنت السفين وموج العطر يضربه","وقد يعوذ من الإبحار إبليسُ !!",48,"س",1,0],["إنت السما عندك... نجومه ... نواوير","ومن الفرح عجعج سناها ... وفاحي",49,"ح",2,0],["أَنتَ السَّبِيلُ الذِّي قَد بَاتَ يَجمَعُنَا","فِي الذِّكرِ وَالشُّكر،أَنتَ الغَيثُ وَالمَطَرُ",50,"ر",1,0],["أنت السماويّ لَمْ نملكْ لديكَ سوى","دمع كأنّك فيمأ كُنتهُ جَسَدُ",51,"د",1,0],["أنتَ السميعُ لمن دعا","ك ومن أتاكَ تُساعدُ",52,"د",1,0],["أنتِ السماء وأنتِ الأرض يا وجعي","أنّى اتجهت اليكِ العين والطرق",53,"ق",1,0],["أنت السبيل ُ إلى الإله بشرعِهِ","هو أوسط المنهاجِ شرعٌ محكمُ",54,"م",1,0],["أنْتَ السَّرابُ وَأنْتَ كُلُّ حَقِيقَتي","شَمْسٌ على عمري تغيبُ وتُشْرِقُ",55,"ق",1,0],["أنت السرور لخاطري أنت المنى","كم أستلذّ بقربك استلذاذا",56,"ذ",2,0],["أنت السميع وإن خبت أصواتنا","وتكانفتنا بالردى اللأواءُ",57,"ا",2,0],["أنت السموحُ الذي تعلو مداركُه","لتحتوي كلَّ واعٍ كان أو غَفِلِ",58,"ل",1,0],["أنت السميع مجيبٌ هاتِ برهنة","حتى بكل الوصايا منك ألتزمُ",59,"م",1,0],["أنت السميع المستجيب المجتبِي","فكم اجتبيتَ المجهِشين دعاءا",60,"ا",3,0],["أنتِ السحابُ وكلي ذلك المطرُ","هل تَستَفِيقُ بِنا الأحلامُ يا (هَجَرُ)؟",61,"ر",1,1],["أنت السماء تظلنا بجمالها","كم هام في أجوائك الشعراء",62,"ا",2,0],["أنت السماء علواً أنت بهجتنا","يا شمس آدابنا يا واحة الأدب",63,"ب",1,0],["أنت السناء الذي في العرش قد بزغا","وآدم عالم الإيجاد ما بلغا",64,"غ",2,1],["أنت السكون لروحي والحياة لها","وأنت غاية ماأرجوه ،والشغفُ",65,"ف",1,0]]}