{"poems":[[47,"وما خفت جدي في الصديق يسوءه","https://www.aldiwan.net/poem62694.html","الطويل"],[136,"أثار غريمى وشجا عقيلى","https://www.aldiwan.net/poem54762.html","الطويل"],[214,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[234,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[287,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[371,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[447,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[447,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[519,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[591,"متى بالقرب يخبرني الرسول","https://www.aldiwan.net/poem17645.html","الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145811","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136277","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136128","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109198","الوافر"],[1390,"","https://poetry.dctabudhabi.ae/diwan/poem/117140","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104816","المتقارب"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137978",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48430","الطويل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127814","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85039","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85044","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127172","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117319","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120550","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120507","الطويل"],[4737,"التنوير","https://www.poetsgate.com/ViewPoem.aspx?id=212156",""],[4737,"سورة الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=213331",""],[4759,"خذي فليس معي","https://www.poetsgate.com/ViewPoem.aspx?id=203999",""],[4816,"ليالي السعد","https://www.poetsgate.com/ViewPoem.aspx?id=8470",""],[4578,"متى بوصالكم توفي الوعود","https://www.poetsgate.com/ViewPoem.aspx?id=49409",""],[5187,"بوم النصر","https://www.poetsgate.com/ViewPoem.aspx?id=29242",""],[5358,"ساعات تحت النار","https://www.poetsgate.com/ViewPoem.aspx?id=21892",""],[5452,"غادة الطوارق","https://www.poetsgate.com/ViewPoem.aspx?id=112029",""],[5703,"يابارد الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=211909",""],[5790,"متى بت إلا في هواك موحدا","https://www.poetsgate.com/ViewPoem.aspx?id=112031",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""]],"verses":[["مَتى بِعتُ مُختاراً رِضاهُ بِسُخطِهِ","تَبَدَّلتُ خُسري كُلَّهُ بِفِلاحي",0,"ح",2,0],["مُتَيبِيعُ الهُوىِّ لَهُ فُوَيهٍ","نُتَينٌ كالجُييفَةِ مِن فُيَيلِ",1,"ل",1,0],["متى بشركي اقضي حق واجبه","ومن بمدحك يقضي بعض ما وجبا",2,"ب",2,0],["متى بعث الرحمنُ منكم كجدّهم","نبيّاً علت للحقّ منه زناد",3,"د",1,0],["مَتى بَدا أَخجَلَ الغَزالَةَ أَو","رَنا بِطَرفٍ حَليفِ تَكسيرِ",4,"ر",1,0],["متى باشَر الخطْبَ الجليلَ برأْيهِ","أتَى المُلكَ بالفَتْحِ القريبِ بَشير",5,"ر",1,0],["مَتى بَلَغَت مُذ قَطُّ أَرضٌ إِلى سَما","وَمَن ذا الَّذي الحوتِ لِلحوتِ قَد سَما",6,"م",2,1],["متى بنا العيس ينكحن السماليقا","فتنتج الحرم والحرم المخاريقا",7,"ق",2,1],["متى بالعدل نزواكم أصينت","فكل عمان تحت لوى لواها",8,"ا",3,0],["متى بعدَهُ الأيّامُ تُطفي أُوامَنا","وقد غوّرَتْ بالأرضِ بحرَ المَواهِبِ",9,"ب",1,0],["مَتى بِالقُرْبِ يُخْبرني الرَّسُولُ","وَيَسْمَحُ بِاللّقا دَهْرٌ بَخِيلُ",10,"ل",1,1],["متى بالدمع ِمحض ِالدمع ِ","عاد َلأهلهِ وطن ُ",11,"ن",1,0],["متى بالحمى تبدو بشائر قربهم","وتسمح أيام التواصل بالبذل",12,"ل",1,0],["متى بسفحك نعقل الرواحل","وننتشي من كاسك المطيب",13,"ب",1,0],["متى بلغت لبانتها الليالي","ولم تترك هدىً للعاقلينا",14,"ن",2,0],["متى بطرت قوم أذلّ عزيزها","وإن عثرت جهلا أقال عثارها",15,"ر",3,0],["مَتَى بِنتُ عَنكُم فَجِسمِى هُنا","وَرُوحِىَ مَعكُم مَدَى العُمرُ دَام",16,"م",1,0],["متى بالقاه في غدرا بليل اظلم","ولا يحضر معي شاهد ولا مشهد",17,"د",1,0],["متى بلقاك خلك يا لطيف الفم","وسط روضه زهيه ظلها ممدود",17,"د",1,0],["متَى بعُدَتْ عنّي أثيرٌ محلُّها","لديّ وفي قلْبي وثيرٌ مِهادُها",18,"د",3,0],["متى برز القضاءُ بحكم ربٍّ","جرى عجلاً فلا يعطيك صبرا",19,"ر",2,0],["مَتى بابُ القِلى يَضحى بِغَلقِ","وَقِفلُ الوَصلِ يُمسي في اِنفِتاحِ",20,"ح",1,0],["مَتى بِالتَلاقي تَقِرُّ العُيونَ","لا رَفلَ في بَهجَةٍ وَاِنشِراحِ",21,"ح",1,0],["متى بميدان فخار جرى","حاز يراع السبق دن الجميع",22,"ع",1,0],["متى بمغانيهم ينعّم ناظرى","ويعذُبُ إيرادي بها ومصادرى",23,"ر",2,0],["متى بسمت دنياك خادنك العدى","وان كلحت الفيت اهلك اعداء",24,"ا",2,1],["متى برقت منه اسرة نبله","تيقنت ان الشبل نجل الضبارم",25,"م",1,0],["\"متى بلغَ الفطامَ لنا صبيٌ\"","نُفخِّخَهُ بكرهِ الآخرينا",26,"ن",2,0],["متى بغمزةِ عينيِها رمتْ أفقاً","يهوي كما حَجَرٍ منْ قمَّةِ الجَبلِ",27,"ل",1,0],["متى بكيتِ عليه كيف أرجِعُه","وقفتُ من حوله من ذا يعزيني",28,"ن",2,0],["متى بتعود يا بهجة حياتي","ونتصافى وزهور الود نهدي",29,"د",2,0],["متى بوصالكم توفي الوعود","ويروق في رياض القرب عودُ",30,"د",1,1],["متى بالنَّصرِ يجمعنا لقاءٌ","وأمة يعرب أهل ودار",31,"ر",1,0],["متى بربِّكِ يا شقراءُ نتّفقُ","فا لعمرُ عرّجَ والساعاتُ تحترقُ",32,"ق",1,1],["متى بدت حبست أنفاسنا ظرفا","كالموت إن بلغت منا تراقينا",33,"ن",2,0],["متى بحَلالِ الوصلِ والقُربِ ننعَمُ","وأنتَ بطيءُ الخَطوِ لاتتقدّمُ ؟؟",34,"م",1,1],["متى بت إلا في هواك موحدا","فلا زلت في نار الصدود مخلدا",35,"د",2,1],["مَتَى بَلَّ بي كَفّاً فليسَ بآسِفٍ","على دِرْهَمٍ إنْ لم ينلْهُ ودِينارِ",36,"ر",1,0]]}