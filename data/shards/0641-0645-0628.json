{"poems":[[53,"وشيخ ينظف أعفاجه","https://www.aldiwan.net/poem64042.html","المتقارب"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[82,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[447,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138276",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66735","السريع"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34420","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96744","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113963","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42427","الوافر"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134196","الخفيف"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86319","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133279","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44652","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4831,"ولادة حلم","https://www.poetsgate.com/ViewPoem.aspx?id=208009",""],[5121,"لِلْكَرَوَانِ فُلَّة","https://www.poetsgate.com/ViewPoem.aspx?id=179415",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5582,"سُطُورُ هَوَىً ما فِي حَقِيقَتِها لَغْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=187334",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5829,"إنه شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=204021",""],[161,"قصيدة شكر وعرفان لآل العروض الرقمي","https://www.poetsgate.com/ViewPoem.aspx?id=166365",""],[6068,"أقسام قلبي...-15-","https://www.poetsgate.com/ViewPoem.aspx?id=175861",""]],"verses":[["فمَبْعرُهُ مثلُ حُلقومه","وإن قلتُ مَبعرهُ أطهر",0,"ر",1,0],["فَمُبصِرٌ مِمّا جَنَيتَ لِمِصرٍ","أَيُّ داءٍ ما إِن إِلَيهِ دَواءُ",1,"ا",2,0],["فَمُبيضُّ عضبي بِمُسوَدِّهِ","وأحمرُه بنجيع القُلَل",2,"ل",1,0],["فمبْلَغُ العِلْمِ فيهِ أنهُ بَشَرٌ","وأنهُ خَيرُ خَلْقِ اللهِ كلِّهِمِ",3,"م",1,0],["فمبايعات يلينها ويلينها","يغدو مبايعهم بأَوفر بيعةِ",4,"ه",1,0],["فمبارك عقباك فهو مبارك","عقب الغروب من الضياء طلوع",5,"ع",1,0],["فمبارك من جاء باسم الرب في","فرح وفي جذل وفي استبشار",6,"ر",1,0],["فمبغضُ الله يَرى بُغضَهم","يَصيرُ للخِزيِ وللنّارِ",7,"ر",1,0],["فَمبدأُ بَيني كان آخرَ راحَتي","وَآخرُ عَيشي كانَ بَدءَ ذَهابي",8,"ب",2,0],["فمبدأ القول فيه لا انتهاء له","وغاية العلم فيه أنه السلول",9,"ل",1,0],["فمبسمه لم يكن إذ نشأ","نقبّله غير قضبانهِ",10,"ن",2,0],["فمبدأ التحريف من وجه القلم","وانزل بسنٍّ في الوضع ثم",11,"م",1,0],["فمَبلَغُ العلمِ منّا غيرُ بالغهِ","فضلاً فسُبحانَ من أخلاقَهُ خلَقا",12,"ق",2,0],["فمبدا الكونِ أنتَ بغيرِ شكٍّ","وسِرُّ الكائناتِ ولا مِراءُ",13,"ا",2,0],["فَمبلغ العلم فيه أَنه بشر","نالَ الكَرامة في عرش وَفي حَرم",14,"م",1,0],["فَمبلغ العلم فيهِ أَنه بشر","وَأنهُ مَصدر الأَفضال وَالنعم",15,"م",1,0],["فمباديه غاية لسواه","والكمالات لا تناهي انفصاما",16,"م",2,0],["فمبسوطا من به ولا تكن بالهوى","ولا بسط إلا بعد محو البقية",17,"ه",1,0],["فَمَبداهُ لَنا حَرفٌ وَحَرفُ","بِهِ حار النحاةُ لَدى الكَلام",18,"م",1,0],["فمبغضو الشرع في ضيق وفي ضعة","وإن هم بجناح المال قد طاروا",19,"ر",3,0],["فَمباهجُ الدُنيا لَدَينا كَثرةٌ","يا لَيتَ شِعري ما الَّذي أَبكانا",20,"ن",2,0],["فمبدأهم في مجده مثلُ ختمهم","وختمهمُ للبدء أكرم مُشبه",21,"ب",2,0],["فَمَبْسمٌ يَجْلُو بِسِحْرٍ عابِقٍ","أنْغامُهُ كَباقَةٍ تُزهِّرُ",22,"ر",1,0],["فَمُبَارَكٌ يَا (أَحْمَداً)..وَعَسَى الإِلَ","هُ يَمُدُّ عُمْرَكَ فِي الْحَيَاةِ حَرِيِرَا",23,"ر",2,0],["فمبلغ العلم فيه أنه بسُر","لكن علا حيث ما الأملاك لم تحم",24,"م",1,0],["فَمَبْعَثُهُ لَدَى الضُّعَفَاءِ نَصْرٌ","وَ لِلْكُفَّارِ كَانَ أفُولَ نَجْمِ",25,"م",1,0],["فَمَبْسِمُها طَلْعٌ وَزَهْرُ أَقاحَةٍ","وَنَكْهَتُها الحَوْذانُ وَالرَّنْدُ وَالعُنْوُ",26,"و",1,0],["فَمَبْسِمُهُ لَمْ يَكُنْ مُذْ نَشا","تُقَبِّلُهُ غَيْرُ قُضْبانِهِ",27,"ن",2,0],["فمبارك من ساح في نفحاته","بين الرياض يؤمه القرآن",28,"ن",1,0],["17- فَمُبارك جهد تفانى مُظهِرا","جُهْدٌ يفاخر وجْهَهُ مَعْنَاهُ",29,"ا",2,0],["10-فَمُبَجَّلٌ صِنْوُ الفوارس باسل","يبكيه من يأتيك دونه ناعيا",30,"ي",2,0]]}