{"poems":[[51,"وشيخ ينظف أعفاجه","https://www.aldiwan.net/poem64042.html","المتقارب"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"]],"verses":[["فمَبْعرُهُ مثلُ حُلقومه","وإن قلتُ مَبعرهُ أطهر",0,"ر",1,0],["فَمُبصِرٌ مِمّا جَنَيتَ لِمِصرٍ","أَيُّ داءٍ ما إِن إِلَيهِ دَواءُ",1,"ا",2,0],["فَمُبيضُّ عضبي بِمُسوَدِّهِ","وأحمرُه بنجيع القُلَل",2,"ل",1,0],["فمبْلَغُ العِلْمِ فيهِ أنهُ بَشَرٌ","وأنهُ خَيرُ خَلْقِ اللهِ كلِّهِمِ",3,"م",1,0]]}