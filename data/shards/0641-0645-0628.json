{"poems":[[51,"وشيخ ينظف أعفاجه","https://www.aldiwan.net/poem64042.html","المتقارب"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[438,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"]],"verses":[["فمَبْعرُهُ مثلُ حُلقومه","وإن قلتُ مَبعرهُ أطهر",0,"ر",1,0],["فَمُبصِرٌ مِمّا جَنَيتَ لِمِصرٍ","أَيُّ داءٍ ما إِن إِلَيهِ دَواءُ",1,"ا",2,0],["فَمُبيضُّ عضبي بِمُسوَدِّهِ","وأحمرُه بنجيع القُلَل",2,"ل",1,0],["فمبْلَغُ العِلْمِ فيهِ أنهُ بَشَرٌ","وأنهُ خَيرُ خَلْقِ اللهِ كلِّهِمِ",3,"م",1,0],["فمبايعات يلينها ويلينها","يغدو مبايعهم بأَوفر بيعةِ",4,"ه",1,0],["فمبارك عقباك فهو مبارك","عقب الغروب من الضياء طلوع",5,"ع",1,0]]}