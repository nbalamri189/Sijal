ml","الكامل"],[432,"شعري كمجدك من يرمه مقصر","https://www.aldiwan.net/poem12631.html","الكامل"],[458,"يا صاحبي شكواي هل ناصر","https://www.aldiwan.net/poem55841.html","السريع"],[461,"لا تعجب الناس من كري مدائحه","https://www.aldiwan.net/poem15682.html","البسيط"],[479,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[479,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[500,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[515,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[515,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[538,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[540,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[540,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[551,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[551,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[553,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[561,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[561,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[562,"أوصى بها من بني العبسي منتقل","https://www.aldiwan.net/poem52516.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"]],"verses":[["أَو صارَتِ البيضُ في الأَغمادِ آجِنَةً","فَإِنَّما الضَربُ ماءٌ غَيرُ مَشروبِ",0,"ب",1,0],["أوْصافُ حقٍّ في مِثالِ باطِنٍ","وآلةٌ مَنْهيّةٌ مأمورَهْ",1,"ر",2,0],["أوصيكَ بالشّيْخ أبي بَكْرَهْ","لا تأمَنَنْ في حالةٍ مَكْرَهْ",2,"ه",1,1],["أوَصِّلُ في حالِ الإقامَةِ للمُنى","وأضْمَنُ للرُّكّابِ كلَّ مُرادِ",3,"د",1,0],["أَوصَلتَ صُرمَ الحَبلِ مِن","سَلمى لِطولِ جِنابِها",4,"ب",3,1],["أَو صَعلَةٌ بِالقارَتَينِ تَرَوَّحَت","رَبداءَ تَتَّبِعُ الظَليمَ الأَربَدا",5,"د",2,0],["أَو صاغَهُ وَرِقاً مَحضاً وَتَوَّجَهُ","مِن ناصِعِ التِبرِ إِبداعاً وَتَحسينا",6,"ن",2,0],["أَوصَت بِلائِمَةٍ لِزيقٍ وَاِبنِهِ","إِنَّ الكَريمَ تَشينُهُ الأَصهارُ",7,"ر",1,0],["أوصيكَ بِالصَبرِ الجَمي","لِ فَإِنَّهُ خَيرُ الوَصِيَّه",8,"ي",2,0],["أوصيكَ بِالحُزنِ لا أوصيكَ بِالجَلَدِ","جَلَّ المُصابُ عَنِ التَعنيفِ وَالفَنَدِ",9,"د",1,1],["أَوصاهُمُ بِالكُفرِ عِندَ مَماتِهِ","وَتَأَلَّفَ الإِشراكُ وَالتَكذيبِ",10,"ب",1,0],["أَوصى أَبونا مالِكٌ بِوِصايَةٍ","عَمراً وَعَوفاً إِذ تَجَهَّرَ غادِيا",11,"ي",2,1],["أوصل بخيرِ البدور مدحاً","يبقى إذا بادت العناصر",12,"ر",1,0],["أوصاف مجدٍ أينعت فترنَّمت","بالسجعِ فيها ألسنُ الوُصَّاف",13,"ف",1,0],["أو صنت عن ناظرِي مرج العذار فلا","هرْجٌ ومرْجٌ بأشجانِي وعذَّالي",14,"ي",1,0],["أوصلني الحلمُ بالتشحط للْ","قسْمِ إذا كان شرّ أقسامي",15,"م",2,0],["أَو صورَةً مِثلَ الرَبيعِ جَميلَةً","في خاطِرٍ أَو ناظِرٍ مُستَمتِعِ",16,"ع",1,0],["أوْصَبَ الصَّبَّ صَدُّهُ","والشَّقا لَوْ تَرَفَّقا",17,"ق",2,0],["او صراطا الى الجنا","ن قد امتد واستمر",18,"ر",1,0],["أَو صيعَ مِن غُرِّ الفَضائِلِ وَالعُلا","كَفَنٌ لَبِستَ أَحاسِنَ الأَكفانِ",19,"ن",1,0],["أوصي تَميماً إِن قُضاعَةَ ساقَها","قَوا الغَيثِ مِن دارٍ بُدومَةَ أَو جَدبِ",20,"ب",1,1],["أَوصى عَشِيَّةَ حينَ فارَقَ رَهطَهُ","عِندَ الشَهادَةِ وَالصَفيحَةِ دَغفَلُ",21,"ل",1,0],["أَو صالَحوا فَلَهُ أَمنٌ وَمُنتَفَذٌ","وَعَقدُ أَهلِ وَفاءٍ غَيرُ مَخذولِ",22,"ل",1,0],["أو صورة صاغها أجدادنا القدما","بلا سقام فصاروا بالهوى سقمى",23,"م",2,0],["أوصيكَ فإنْ قبلْتَ مني","أفلحتَ ونلتَ ما تحبُّ",24,"ب",1,1],["أوصِ المروجَ بنا خيراً لعَّل بها","من ضَنكةِ الروح فينا ما يُداوينا",25,"ن",2,0],["أَو صِليهِ وَصلاً يُقَرُّ عَلَيهِ","إِنَّ شَرَّ الوِصالِ وَصلُ الكِذابِ",26,"ب",1,0],["أَوصيتُ زرعةَ أن يكونَ لهم يداً","كَيَدِ القرينِ يَشُدُّ أزْرَ قرينِهِ",27,"ه",1,0],["أوصها بالصلاة فَهْيَ عِلاجٌ","أو سياجٌ يَذودُ عنها الشُّرورا",28,"ر",2,0],["أَو صَرَمَ الحَبلَ ما حَيِيتُ فَلَم","يَصِلهُ أَو مَن سِواهُمُ وَصَلا",29,"ل",2,0],["أَو صَوتُ تَصفيقِ الجَليسِ تَطَرُّباً","وَبُكاءُ خابِيَةٍ وَضِحكُ قَناني",30,"ن",2,0],["أوصي أُخَيُّ إلى النديم","بخلافِ لقمان الحكيم",31,"م",1,1],["أَو صالَحوكَ فَصُلحٌ ما رَعَوكَ بِهِ","أَو حارَبوكَ فَفي سِربالِكَ الأَسَدُ",32,"د",1,0],["أَوصَيتُ نَفسي وَعَن وُدٍّ نَصَحتُ لَها","فَما أَجابَت إِلى نُصحي وَإِيصائي",33,"ي",1,1],["أَو صادَفَتهُ حِبالَةٌ نُصِبَت","فَظَلَّ فيها كَأَنَّما كُتِفا",34,"ف",2,0],["أَوصى فَلَم يَقبَلوا مِنهُ وَعاهَدَهُم","فَقابَلوا بِخِلافٍ كُلَّ ما رَسَما",35,"م",2,0],["أَوصى اِبنَتَيهِ لَبيدٌ ال","ماضي وَلا أوصي اِبنَتَيّا",36,"ت",3,0],["أُوَصّي بَنِيَّ وَأَعمامَهُم","بِأَنَّ المَنايا لَهُم راصِدَه",37,"د",2,1],["أَو صِرتُ ذا بومَةٍ في رَأسِ رابِيَةٍ","أَو في قَرارٍ مِنَ الأَرضينَ قِرواحِ",38,"ح",1,0],["أَو صيحة كانَ فيها","للناكثين انصداع",39,"ع",1,0],["أو صدَى رَاعٍ على تلكَ الرُّبى","صَبَّ في النَّاي أغاني حُبِّهِ",40,"ه",1,0],["أَوْ صَارِمٍ يَفْرِي نِيَاطَ الْكُلَى","وَلَمْ يَزَلْ فِي جَفْنِهِ مُغْمَدَا",41,"د",2,0],["أَوْ صَبَا بِهَا","باخِلٌ سَمَحْ",42,"ح",1,0],["أو صفقت للهو في أترابها","ماج لها الوادي وغنى الشجر",43,"ر",1,0],["أو صدَى \" طَلقةٍ \" يبيتُ عليها","أحدُ الجانبينِ وهو حريب",44,"ب",1,0],["أوْصى الظِّلالَ الخافقاتِ نسائماً","ألاَّ تُبرِّدَ من شَذاتي لاهبا",45,"ب",2,0],["أو صوتِ مِجدافٍ يُبينُ بوقعه","فوقَ الحصى عن شجوه وعويله",46,"ل",2,0],["أوْ صلعة ٌ بالقارلتينِ تروّحتْ","ربداءَ، تتبعُ الظّليمَ الأربدا",47,"د",2,0],["أوصيك بالحزن ولا أوصيك بالجلد","جل المصاب عن التعنيف والفند",48,"د",1,1],["أوْصَى عَشِيّةَ حِينَ فَارَقَ رَهْطَه،","عندَ الشّهادَةِ وَالصّحيفَةِ، دَغفَلُ",49,"ل",1,0],["أوصيكمُ لا تركبُوا","عصيانَ سيدِنا الأبرُّ",50,"ر",1,0],["أُوصيكَ لا تصحبْ فتىً","ينحو إلى طلب المثالبْ",51,"ب",1,0],["أوصيكُمو يا أيها العُقلاءُ","بوصيَّة تعنو لها الحُكماءُ",52,"ا",2,1],["أوصى إليَّ فقمتُ غيرَ مُضيِّعٍ","لوصايَةٍ منهُ أغني منشدا",53,"د",2,0],["أوصي بِنَصرِ النَبِيِّ الخَير مُشهِدَهُ","عَلِيّاً اِبني وَعَمَّ الخَيرِ عَبّاسا",54,"س",2,1],["أوصافه الغَرّا تؤيد أنهُ","متوحدٌ في المكرماتِ فضيلُ",55,"ل",1,0],["أَوصابُ جِسمي مِن جِنايَةِ بُعدِكُم","وَالصَبرُ صَبرٌ بَعدَكُم أَو صابُ",56,"ب",1,0],["أوصيكَ بي خَيراً فَإِنّي في الأُلى","أَصبَحتَ مالِكَ رِقِّهِم مَعدودُ",57,"د",1,0],["أوصافه فوق ما ذو العقل يعهده","وفوق ما عهدت في أهلها أمم",58,"م",1,0],["أَو صابَتِ القانِتَ في مُخلَولِقٍ","مُستَصعَبِ المَسلَكِ وَعرِ المُرتَقى",59,"ا",1,0],["أوصى بك اللهُ ما أوصت بك الصُحفُ","والشعرُ يدنو بخوفٍ ثم ينصرفُ",60,"ف",1,1],["أَوصاكَ سِحرُ جُنونِهِ بِتَسهّدٍ","وَتَلَذُّذٍ فَقبِلتَ ما أَوصى بِهِ",61,"ب",2,0],["أَوصاكَ رَبُّكَ بِالتُّقى","وَأُولوا النّهى أَوصوا مَعَه",62,"ه",1,1],["أو صَعدةٌ سمراءُ أو مثلها","يراعةٌ تَطعنُ إذ تَكتُبُ",63,"ب",1,0],["اوصافه حاشاه لا نقص بها","وعلاه في فلك السعود تمام",64,"م",1,0],["اوصافه قد علمتني في الورى","نظم القوافي والنوادر والملح",65,"ح",1,0],["أوصيكَ إيصاءَ اِمرِئٍ لَكَ ناصِحٍ","طَبِنٍ بِرَيبِ الدَهرِ غَيرِ مُغَفَّلِ",66,"ل",1,0],["أَوصَدتُ دونَ الحُبِّ قَلبي فَما","يَرجو الهَوى من قَلبِيَ الموصَدِ",67,"د",1,0],["أَو صَدىً رَدَّدته أَطلالُ رَبعٍ","جَرَّ أَذيالَهُ عليهِ العَفاء",68,"ا",2,0],["أَو صَرَّدَ الباخِلُ القِرى فَهِقَت","مُكَلَّلاتٍ جِفانُهُ الرُذُمُ",69,"م",1,0],["أَوْ صَاحِبَ الصَّمْصَامِ لَيْ","ثَ الْقَادِسِيَّةِ حِينَ يَنْهَدْ",70,"د",1,0],["أَوْ صَابِرٍ فِي النَّائِبَاتِ مُرَزَّإٍ","ثَبْتٍ عَلَى كَدْشِ الزَّمَانِ وَخَدْشِهِ",71,"ش",2,0],["أوصيك بالأغنام شراً وهل","يوصي أبو جعدة بالشر",72,"ر",1,0],["أوصيك في القوم بهذا الذي","عقدته في السر والجهر",72,"ر",1,0],["أوصِد فؤادَكَ ثم بابكَ واندفِن","في خلوةٍ تُرخي عليكَ دُجاها",73,"ا",3,0],["أوصيكَ خيراً بأشجارٍ مقدّسةٍ","لأنها كلُّها من غرسِ أيدينا",74,"ن",2,0],["أوصى اليك لعلمي أن لطفك بي","دون الوَرى لَم يحل عني اذا حالوا",75,"ل",3,0],["أوصافه قد أسعَدت","وصَّافه منها التجل",76,"ل",1,0],["أَو صَوبُ غادِيَةٍ أَدَرَّتهُ الصَبا","بِبَزيلِ أَزهَرَ مُدمَجٍ بِسَياعِ",77,"ع",1,0],["أَوصافُه اِنسجمت للذاكرين لها","في هل أَتى في سَبا في نون والقَلمِ",78,"م",1,0],["أَو صَدحت حَمائم الأَشجان","في رَوض قَلب المُدنف الوَلهانِ",79,"ن",1,0],["أَو صَدح الطَير بِدَوح الربى","فَهَيَّج الوَجد بِأَهلِ الغَرام",80,"م",1,0],["أَوصافك الغر فاقَت","عَما أحيط وَأَعلَم",81,"م",1,0],["أَو صُقِلَت بَواتِرٌ أَو رادُهُ","مِلءَ المَلا صَفَت فَما فيها صَدي",82,"د",2,0],["أو صيغَ من بعضِ ما أمسى يفرِّقُه","نَدى أبي الحَسنِ الأستاذِ مُعتَذِرا",83,"ر",2,0],["أوصيكَ خيراً بالسقام الذي","فيهنَّ واعلم أنه صاحبي",84,"ب",2,0],["أوصيك يا من أنت عندي أعزُّ من","نفسي وأنت هو الأعزُّ الأمنع",85,"ع",1,0],["أَو صَحَّ أَن ينزلَ أَو أَن يَصعَدا","لَصَحَّ أَن يَنامُ أَو أَن يَسهَدا",86,"د",2,0],["أو صحبة من بذلوا أنفساً","سالت على الصارم والسمهري",87,"ي",1,0],["أوصي سعيداً بالتُّقَى","إن التَّقِيَّ هو السعيد",88,"د",1,0],["أو صدقات قد جرت أو قضى","مرابطاً أو مسجداً قد بنى",89,"ا",1,0],["أَوصِ الزَّمانَ بحِفظي مِن نَوائِبِه","فإن أحداثَهُنَّ السُّودَ تلعَبُ بي",90,"ي",1,0],["أوْصِ دّهري بِحفظِ نَفسي وأهلي","فهو عَبْدٌ لِما تُحِبُّ وتَهْوى",91,"ه",3,0],["أوصِلاني إلى المُنى أوصِلاني","بالأماني التي تُنيلُ الأماني",92,"ي",1,1],["أوْصِ الزَّمانَ فإنَّهُ لكَ خادِمٌ","بِصيانَتي في ضِمنِهِ وضَمانِهِ",93,"ه",1,0],["أوصاكَ تسحَرُ عينَهُ بتَسهُّدٍ","وتبلُّدٍ فقبلتَ ما أوصى بِهِ",94,"ب",2,0],["أوصال يوماً بعسال يلاعبه","فكم كميٍّ إذا ما مال منجدل",95,"ل",1,0],["أَوصافُ مجدِكَ وَرْدَةٌ يَرْدَى بها","فلذاكَ نَكَّبَ دونها بِنِياطِه",96,"ط",2,0],["أَوصافُ آلِ زُرَيْعٍ رَفَّ مَنْبِتُها","فبات حاسِدُها الأَشقى على الحَسَكِ",97,"ك",1,0],["أوصافه قد أعجزتْ وُصّافَها","فغدا يُعدُّ مقصِّراً مَنْ أسهَبا",98,"ب",2,0],["أو صار من بعضِ الحديدِ فكنْ له","داودَ يُنْهى في يدَيهِ ويُؤمَرُ",99,"ر",1,0],["أوصيه بالدمع دواءً فإن","ضنَّ عليه جفنُه فالأنينْ",100,"ن",1,0],["أوصافُه علَّمتْني كلَّ مُعْجِزةٍ","من الغرائب لا التَّجويدُ في الأدبِ",101,"ب",1,0],["أوصيكما بالذي أوصى الاله به","فلترعياه وهذا غاية الأرب",102,"ب",1,0],["أوصيتني بالدين حتى خلتكم","محييه مذ شاهدت منك نظيرا",103,"ر",2,0],["أوصل حبال قطيعتي باللطف واج","بر كسر قلبي فالعدو قد اشتفى",104,"ف",2,0],["أو صفحت حمدان لم","تأت بشيء ينكر",105,"ر",1,0],["أوصى إليك بها ابن عمك بعده","نصاكما نص النبي على علي",106,"ل",2,0],["أو صورت حسنات مجدك لم تكن","إلا جميلاً فائصاً وجلالا",107,"ل",2,0],["أوصَلَتنَا حيثُ شِئنَا ورَسَت","ودَخَلنَا في تَهَادٍ والتِصَاق",108,"ق",1,0],["أَوصافُ زيدٍ بِأَعلى الأَمرِ منزلَة","فَما أَخذتَ قَبيحَ الأَمرِ بالحَسنِ",109,"ن",1,0],["أَوصي غَنيّاً فَما أَنفكُّ أَذمرُهُ","أَخشى عليه أُموراً ذاتَ عقّالِ",110,"ل",1,1],["أوْ صانه عن بذله مرّةً","فَهوَ الّذي يَرجعُ مُستبذلا",111,"ل",2,0],["أَو صَعْدةٌ فُجِعَتْ ببعض كُعوبها","ولها كعوبٌ بعد ذاك وأكعُبُ",112,"ب",1,0],["أَو صَنَمٌ بَهِيٌّ","في دَيرِهِ مَعبودُ",113,"د",1,0],["أَو صَوتَ داعٍ ناشِدٍ إِفالا","إِنّا أُناسٌ نَحمِلُ الأَعيالا",114,"ل",2,0],["أَو صاحِبِ السَهمِ وَما رُميتُ","مَسلَمَ لا أَنساكَ ما بَقيتُ",115,"ت",1,0],["أوصَى بها مِن بَنِي العَبْسيِّ منتقلٌ","مِن عهدِ عامٍ إلى أبراجِ أفلاكِ",116,"ك",1,1],["أوصى إلى شيث فخلى شيئا","خليفة ولم يكن مبعوثا",117,"ث",2,0],["أوصى فقال منهم فريق","وصيّه المستخلف الصديق",117,"ق",1,0],["أوصى إلى الحسن ثم اوصى","إلى الحسين كلهم قد نصا",117,"ص",2,0],["أَوْصَى أَيَادِيه فقا","لَ لها رُويدَكِ لاَ تَبُوحي",118,"ح",2,0]]}