{"poems":[[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[77,"يا من يفيد الطين كل صوره","https://www.aldiwan.net/poem36431.html","الرجز"],[77,"أوصيك بالشيخ أبي بكره","https://www.aldiwan.net/poem36444.html","السريع"],[77,"إذا نمت نم للأمن فوق مهاد","https://www.aldiwan.net/poem36546.html","الطويل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[47,"لولا العجوز بمنبج ما خفت","https://www.aldiwan.net/poem24810.html","مجزوء الكامل"],[47,"أوصيك بالحزن لا أوصيك بالجلد","https://www.aldiwan.net/poem25330.html","البسيط"],[23,"والله ما أوصى أمية بكره","https://www.aldiwan.net/poem21315.html","الكامل"],[23,"أوصى أبونا مالك بوصاية","https://www.aldiwan.net/poem21377.html","الكامل"],[72,"يا خير من تبسط المساعي","https://www.aldiwan.net/poem18746.html","مخلع البسيط"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[91,"يا نفس قد ذهب الرفيق الألمعي","https://www.aldiwan.net/poem8979.html","عموديه"],[92,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[28,"أوصي تميماً إن قضاعة ساقها","https://www.aldiwan.net/poem1237.html",""],[28,"فلئن فخرت بهم لمثل قديمهم","https://www.aldiwan.net/poem5476.html","الكامل"],[2,"أبلغ لديك بني الصيداء كلهم","https://www.aldiwan.net/poem25058.html","البسيط"],[69,"أوصيك فإن قبلت مني","https://www.aldiwan.net/poem28099.html","مجزوء الدوبيت"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[31,"شاق قلبي تذكر الأحباب","https://www.aldiwan.net/poem42632.html","الخفيف"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[48,"لا تحزنن لفرقة الأقران","https://www.aldiwan.net/poem65305.html","الكامل"],[48,"أوصي أخي إلى النديم","https://www.aldiwan.net/poem66608.html","مجزوء الكامل"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[46,"أوصيت نفسي وعن ود نصحت لها","https://www.aldiwan.net/poem22030.html","البسيط"],[46,"فاء لك الحلم فاله عن رشإ","https://www.aldiwan.net/poem22993.html","المنسرح"],[46,"جاران شاك ومسرور بحالته","https://www.aldiwan.net/poem23345.html","البسيط"],[46,"أصبحت ألحى خلتيا","https://www.aldiwan.net/poem23615.html","مجزوء الكامل"],[15,"أوصي بني وأعمامهم","https://www.aldiwan.net/poem45276.html","المتقارب"],[15,"يا صاح مهلا أقل العذل يا صاح","https://www.aldiwan.net/poem45278.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42554","المتدارك"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[9,"أثوى ، قصّرَ ليلة ً ليزوَّدا،","https://www.poetsgate.com/ViewPoem.aspx?id=20031",""],[47,"أوصيك بالحزن ولا أوصيك بالجلد","https://www.poetsgate.com/ViewPoem.aspx?id=12902",""],[28,"إن الذي سمك السماء بنى لنا","https://www.poetsgate.com/ViewPoem.aspx?id=22079",""]],"verses":[["أَو صارَتِ البيضُ في الأَغمادِ آجِنَةً","فَإِنَّما الضَربُ ماءٌ غَيرُ مَشروبِ",0,"ب",1,0],["أوْصافُ حقٍّ في مِثالِ باطِنٍ","وآلةٌ مَنْهيّةٌ مأمورَهْ",1,"ر",2,0],["أوصيكَ بالشّيْخ أبي بَكْرَهْ","لا تأمَنَنْ في حالةٍ مَكْرَهْ",2,"ه",1,1],["أوَصِّلُ في حالِ الإقامَةِ للمُنى","وأضْمَنُ للرُّكّابِ كلَّ مُرادِ",3,"د",1,0],["أَوصَلتَ صُرمَ الحَبلِ مِن","سَلمى لِطولِ جِنابِها",4,"ب",3,1],["أَو صَعلَةٌ بِالقارَتَينِ تَرَوَّحَت","رَبداءَ تَتَّبِعُ الظَليمَ الأَربَدا",5,"د",2,0],["أَو صاغَهُ وَرِقاً مَحضاً وَتَوَّجَهُ","مِن ناصِعِ التِبرِ إِبداعاً وَتَحسينا",6,"ن",2,0],["أَوصَت بِلائِمَةٍ لِزيقٍ وَاِبنِهِ","إِنَّ الكَريمَ تَشينُهُ الأَصهارُ",7,"ر",1,0],["أوصيكَ بِالصَبرِ الجَمي","لِ فَإِنَّهُ خَيرُ الوَصِيَّه",8,"ي",2,0],["أوصيكَ بِالحُزنِ لا أوصيكَ بِالجَلَدِ","جَلَّ المُصابُ عَنِ التَعنيفِ وَالفَنَدِ",9,"د",1,1],["أَوصاهُمُ بِالكُفرِ عِندَ مَماتِهِ","وَتَأَلَّفَ الإِشراكُ وَالتَكذيبِ",10,"ب",1,0],["أَوصى أَبونا مالِكٌ بِوِصايَةٍ","عَمراً وَعَوفاً إِذ تَجَهَّرَ غادِيا",11,"ي",2,1],["أوصل بخيرِ البدور مدحاً","يبقى إذا بادت العناصر",12,"ر",1,0],["أوصاف مجدٍ أينعت فترنَّمت","بالسجعِ فيها ألسنُ الوُصَّاف",13,"ف",1,0],["أو صنت عن ناظرِي مرج العذار فلا","هرْجٌ ومرْجٌ بأشجانِي وعذَّالي",14,"ي",1,0],["أوصلني الحلمُ بالتشحط للْ","قسْمِ إذا كان شرّ أقسامي",15,"م",2,0],["أَو صورَةً مِثلَ الرَبيعِ جَميلَةً","في خاطِرٍ أَو ناظِرٍ مُستَمتِعِ",16,"ع",1,0],["أوْصَبَ الصَّبَّ صَدُّهُ","والشَّقا لَوْ تَرَفَّقا",17,"ق",2,0],["او صراطا الى الجنا","ن قد امتد واستمر",18,"ر",1,0],["أَو صيعَ مِن غُرِّ الفَضائِلِ وَالعُلا","كَفَنٌ لَبِستَ أَحاسِنَ الأَكفانِ",19,"ن",1,0],["أوصي تَميماً إِن قُضاعَةَ ساقَها","قَوا الغَيثِ مِن دارٍ بُدومَةَ أَو جَدبِ",20,"ب",1,1],["أَوصى عَشِيَّةَ حينَ فارَقَ رَهطَهُ","عِندَ الشَهادَةِ وَالصَفيحَةِ دَغفَلُ",21,"ل",1,0],["أَو صالَحوا فَلَهُ أَمنٌ وَمُنتَفَذٌ","وَعَقدُ أَهلِ وَفاءٍ غَيرُ مَخذولِ",22,"ل",1,0],["أوصيكَ فإنْ قبلْتَ مني","أفلحتَ ونلتَ ما تحبُّ",23,"ب",1,1],["أوصِ المروجَ بنا خيراً لعَّل بها","من ضَنكةِ الروح فينا ما يُداوينا",24,"ن",2,0],["أَو صِليهِ وَصلاً يُقَرُّ عَلَيهِ","إِنَّ شَرَّ الوِصالِ وَصلُ الكِذابِ",25,"ب",1,0],["أَوصيتُ زرعةَ أن يكونَ لهم يداً","كَيَدِ القرينِ يَشُدُّ أزْرَ قرينِهِ",26,"ه",1,0],["أوصها بالصلاة فَهْيَ عِلاجٌ","أو سياجٌ يَذودُ عنها الشُّرورا",27,"ر",2,0],["أَو صَرَمَ الحَبلَ ما حَيِيتُ فَلَم","يَصِلهُ أَو مَن سِواهُمُ وَصَلا",28,"ل",2,0],["أَو صَوتُ تَصفيقِ الجَليسِ تَطَرُّباً","وَبُكاءُ خابِيَةٍ وَضِحكُ قَناني",29,"ن",2,0],["أوصي أُخَيُّ إلى النديم","بخلافِ لقمان الحكيم",30,"م",1,1],["أَو صالَحوكَ فَصُلحٌ ما رَعَوكَ بِهِ","أَو حارَبوكَ فَفي سِربالِكَ الأَسَدُ",31,"د",1,0],["أَوصَيتُ نَفسي وَعَن وُدٍّ نَصَحتُ لَها","فَما أَجابَت إِلى نُصحي وَإِيصائي",32,"ي",1,1],["أَو صادَفَتهُ حِبالَةٌ نُصِبَت","فَظَلَّ فيها كَأَنَّما كُتِفا",33,"ف",2,0],["أَوصى فَلَم يَقبَلوا مِنهُ وَعاهَدَهُم","فَقابَلوا بِخِلافٍ كُلَّ ما رَسَما",34,"م",2,0],["أَوصى اِبنَتَيهِ لَبيدٌ ال","ماضي وَلا أوصي اِبنَتَيّا",35,"ت",3,0],["أُوَصّي بَنِيَّ وَأَعمامَهُم","بِأَنَّ المَنايا لَهُم راصِدَه",36,"د",2,1],["أَو صِرتُ ذا بومَةٍ في رَأسِ رابِيَةٍ","أَو في قَرارٍ مِنَ الأَرضينَ قِرواحِ",37,"ح",1,0],["أَو صيحة كانَ فيها","للناكثين انصداع",38,"ع",1,0],["أو صدَى رَاعٍ على تلكَ الرُّبى","صَبَّ في النَّاي أغاني حُبِّهِ",39,"ه",1,0],["أَوْ صَارِمٍ يَفْرِي نِيَاطَ الْكُلَى","وَلَمْ يَزَلْ فِي جَفْنِهِ مُغْمَدَا",40,"د",2,0],["أَوْ صَبَا بِهَا","باخِلٌ سَمَحْ",41,"ح",1,0],["أو صفقت للهو في أترابها","ماج لها الوادي وغنى الشجر",42,"ر",1,0],["أو صدَى \" طَلقةٍ \" يبيتُ عليها","أحدُ الجانبينِ وهو حريب",43,"ب",1,0],["أوْصى الظِّلالَ الخافقاتِ نسائماً","ألاَّ تُبرِّدَ من شَذاتي لاهبا",44,"ب",2,0],["أو صوتِ مِجدافٍ يُبينُ بوقعه","فوقَ الحصى عن شجوه وعويله",45,"ل",2,0],["أوْ صلعة ٌ بالقارلتينِ تروّحتْ","ربداءَ، تتبعُ الظّليمَ الأربدا",46,"د",2,0],["أوصيك بالحزن ولا أوصيك بالجلد","جل المصاب عن التعنيف والفند",47,"د",1,1],["أوْصَى عَشِيّةَ حِينَ فَارَقَ رَهْطَه،","عندَ الشّهادَةِ وَالصّحيفَةِ، دَغفَلُ",48,"ل",1,0]]}