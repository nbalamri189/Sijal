{"poems":[[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[29,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[29,"مالك عز التغلبي الذي له","https://www.aldiwan.net/poem6090.html","الطويل"],[92,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[89,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[85,"يا قصر رأس التين","https://www.aldiwan.net/poem7145.html","السريع"],[45,"نوائب دهر أيهن أنازل","https://www.aldiwan.net/poem65620.html","الطويل"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39591","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147482","الوافر"],[45,"نَوَائِبُ دَهْرٍ، أيُّهُنّ أُنَازِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32106",""],[96,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""],[141,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[148,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[209,"وصلت إلى الثغر الجميل يحثني","https://www.aldiwan.net/poem46297.html","الطويل"],[248,"ضننت على نفسي وقد كنت قادرا","https://www.aldiwan.net/poem15068.html","الطويل"],[326,"يا أيها الشاكي جفاه الرقاد","https://www.aldiwan.net/poem55041.html","السريع"],[549,"بجانب الكرخ من بغداد عن لنا","https://www.aldiwan.net/poem47816.html","البسيط"],[556,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"]],"verses":[["ضَفَت مَلابِسُ نُعماهُ عَلَيَّ فَقَد","رُدَّت بِهاليَ أَثوابُ الصِبى القُشُبُ",0,"ب",1,0],["ضفادع جيأة حسِبت أضاةً","منضِّبةً ستمنعها وطينا",1,"ن",2,0],["ضفادِع جَيَّة حَسِبَت أضَاةً","مُنضِّبَةً سَتَمنَعُهَا وَطِينَا",2,"ن",2,0],["ضفت حلل الثنا وصفت لديه","وآدمُ بعدَها طينٌ وماء",3,"ا",2,0],["ضَفادِعُهُ غَرقى رِواءٌ كَأَنَّها","قِيانُ شُروبٍ رَجعُهُنَّ نَشيجُ",4,"ج",1,0],["ضَفادِعُ في ظَلماءِ لَيلٍ تَجاوَبَت","فَدَلَّ عَلَيها صَوتُها حَيَّةَ البَحرِ",5,"ر",1,0],["ضَفادِعُ غَرَّتها صَراةٌ فَقَلَّصَت","مِنَ البَحرِ عَن آذِيِّهِ المُتَدارِكِ",6,"ك",1,0],["ضِفَافِ الشَّفَقِ","لِيَرى رُوحَ الحَبيبْ",7,"ب",1,0],["ضفدعا لولا ماله من نقيق","ما تظنيت كونه مخلوقا",8,"ق",2,0],["ضفتم جنابا عاليا طاهرا","ضاف لكم بالأمس أزكى جناب",9,"ب",1,0],["ضِفَنّونَ مِن تَحتِ الدُروعِ كَأَنَّهُم","إِذا رَكِبوا الخَيلَ النِساءُ الحَوامِلُ",10,"ل",1,0],["ضَفَتِ الرِياضُ وَما أَضَرَّ بِها","إِخلافُ وَعدِ البَرقِ في الوَمضِ",11,"ض",1,0],["ضِفَّةُ النيلِ وهي بعض مغاني","هِ صحت تسأل الربى عن صداحهْ",12,"ح",2,0],["ضفا برد الشباب عليه حتى","مضت حقب وملبسه جديد",13,"د",1,0],["ضِفَنُّونَ مِنْ تَحْتِ الدُّروعِ كأَنَّهُمْ","إِذا َكِبُوا الخَيْلَ النِّسَاءُ الحَوامِلُ",14,"ل",1,0],["ضفّة النّيل ، وهي بعض مغاني","ه صحت وتسأل الرّبى عن صداحه",15,"ح",2,0],["ضَفَت نِعمَتانِ خَصَّتاكَ وَعَمَّتا","حَديثُهُما حَتّى القِيامَةِ يُؤثَرُ",16,"ر",1,0],["ضَفا ظِلُّهُ سِتراً عَلى كُلِّ مُسلِمِ","فَنَحنُ بِهِ في غايَةِ الأَمنِ وَالخَفضِ",17,"ض",1,0],["ضفائرها قبل الغروب أشعّة","بوارق بالسحر الأصيل تصول",18,"ل",1,0],["ضَفَى ظلِّهُ والنارُ ذاتُ توقُّد","تَحضُّ على إرهابنا غايةَ الحضِّ",19,"ض",1,0],["ضفافها ما ينسج الناظر","من ذروة أو غيلة أو فضاء",20,"ا",2,0],["ضَفيرتاهُ على قَتلي تَضافَرَتا","فمن رأى شاعراً أودى به الشَّعَرُ",21,"ر",1,0],["ضفدعُ الماء نقَّ يطلب ماءً","وهو في الماء بين روض أريض",22,"ض",1,0]]}