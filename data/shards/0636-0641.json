{"poems":[[73,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[39,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[74,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[31,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[31,"مالك عز التغلبي الذي له","https://www.aldiwan.net/poem6090.html","الطويل"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[87,"يا قصر رأس التين","https://www.aldiwan.net/poem7145.html","السريع"],[47,"نوائب دهر أيهن أنازل","https://www.aldiwan.net/poem65620.html","الطويل"],[68,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39591","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147482","الوافر"],[47,"نَوَائِبُ دَهْرٍ، أيُّهُنّ أُنَازِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32106",""],[98,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[154,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[215,"وصلت إلى الثغر الجميل يحثني","https://www.aldiwan.net/poem46297.html","الطويل"],[255,"ضننت على نفسي وقد كنت قادرا","https://www.aldiwan.net/poem15068.html","الطويل"],[333,"يا أيها الشاكي جفاه الرقاد","https://www.aldiwan.net/poem55041.html","السريع"],[556,"بجانب الكرخ من بغداد عن لنا","https://www.aldiwan.net/poem47816.html","البسيط"],[563,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77499","الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16940","الخفيف"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111169","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64740","السريع"],[463,"","https://poetry.dctabudhabi.ae/diwan/poem/25189","المتقارب"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206189",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126215","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93587","الرجز"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84525","الكامل"],[501,"","https://poetry.dctabudhabi.ae/diwan/poem/142581","الرمل"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143943","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140029","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129372","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128945","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114604","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114480","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135235","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111060","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86456","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119679","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81241","السريع"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[5083,"قهوةُ صيدا","https://www.poetsgate.com/ViewPoem.aspx?id=53728",""],[5216,"قَيْس","https://www.poetsgate.com/ViewPoem.aspx?id=187654",""],[2110,"ضوء الأهلة أم برق الحمى ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=156277",""],[5680,"قريب على بعد أنا منك","https://www.poetsgate.com/ViewPoem.aspx?id=204357",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[6082,"فلَة","https://www.poetsgate.com/ViewPoem.aspx?id=59817",""]],"verses":[["ضَفَت مَلابِسُ نُعماهُ عَلَيَّ فَقَد","رُدَّت بِهاليَ أَثوابُ الصِبى القُشُبُ",0,"ب",1,0],["ضفادع جيأة حسِبت أضاةً","منضِّبةً ستمنعها وطينا",1,"ن",2,0],["ضفادِع جَيَّة حَسِبَت أضَاةً","مُنضِّبَةً سَتَمنَعُهَا وَطِينَا",2,"ن",2,0],["ضفت حلل الثنا وصفت لديه","وآدمُ بعدَها طينٌ وماء",3,"ا",2,0],["ضَفادِعُهُ غَرقى رِواءٌ كَأَنَّها","قِيانُ شُروبٍ رَجعُهُنَّ نَشيجُ",4,"ج",1,0],["ضَفادِعُ في ظَلماءِ لَيلٍ تَجاوَبَت","فَدَلَّ عَلَيها صَوتُها حَيَّةَ البَحرِ",5,"ر",1,0],["ضَفادِعُ غَرَّتها صَراةٌ فَقَلَّصَت","مِنَ البَحرِ عَن آذِيِّهِ المُتَدارِكِ",6,"ك",1,0],["ضِفَافِ الشَّفَقِ","لِيَرى رُوحَ الحَبيبْ",7,"ب",1,0],["ضفدعا لولا ماله من نقيق","ما تظنيت كونه مخلوقا",8,"ق",2,0],["ضفتم جنابا عاليا طاهرا","ضاف لكم بالأمس أزكى جناب",9,"ب",1,0],["ضِفَنّونَ مِن تَحتِ الدُروعِ كَأَنَّهُم","إِذا رَكِبوا الخَيلَ النِساءُ الحَوامِلُ",10,"ل",1,0],["ضَفَتِ الرِياضُ وَما أَضَرَّ بِها","إِخلافُ وَعدِ البَرقِ في الوَمضِ",11,"ض",1,0],["ضِفَّةُ النيلِ وهي بعض مغاني","هِ صحت تسأل الربى عن صداحهْ",12,"ح",2,0],["ضفا برد الشباب عليه حتى","مضت حقب وملبسه جديد",13,"د",1,0],["ضِفَنُّونَ مِنْ تَحْتِ الدُّروعِ كأَنَّهُمْ","إِذا َكِبُوا الخَيْلَ النِّسَاءُ الحَوامِلُ",14,"ل",1,0],["ضفّة النّيل ، وهي بعض مغاني","ه صحت وتسأل الرّبى عن صداحه",15,"ح",2,0],["ضَفَت نِعمَتانِ خَصَّتاكَ وَعَمَّتا","حَديثُهُما حَتّى القِيامَةِ يُؤثَرُ",16,"ر",1,0],["ضَفا ظِلُّهُ سِتراً عَلى كُلِّ مُسلِمِ","فَنَحنُ بِهِ في غايَةِ الأَمنِ وَالخَفضِ",17,"ض",1,0],["ضفائرها قبل الغروب أشعّة","بوارق بالسحر الأصيل تصول",18,"ل",1,0],["ضَفَى ظلِّهُ والنارُ ذاتُ توقُّد","تَحضُّ على إرهابنا غايةَ الحضِّ",19,"ض",1,0],["ضفافها ما ينسج الناظر","من ذروة أو غيلة أو فضاء",20,"ا",2,0],["ضَفيرتاهُ على قَتلي تَضافَرَتا","فمن رأى شاعراً أودى به الشَّعَرُ",21,"ر",1,0],["ضفدعُ الماء نقَّ يطلب ماءً","وهو في الماء بين روض أريض",22,"ض",1,0],["ضفدَعَة مَرَّت عَلَيها فارَه","قالَت لَها يا مَرحَباً يا جاره",23,"ه",1,1],["ضُفتُ عَمراً فَجاءَني بِرَغيفٍ","زادَني أَكلُهُ عَلى الجوعِ جوعا",24,"ع",2,1],["ضفت برود الجلال سابغة","على علاه والمجد طرزها",25,"ز",3,0],["ضَفَتْ على الأُمَّةِ في صَوْمِها","مِنْ بِرِّهِ الكاملِ أَبرادُ",26,"د",1,0],["ضفا فوقها رأيُك السمهريُّ","وقد صاح بالضارب المقتَلُ",27,"ل",1,0],["ضِفِيّ في الراحه وفي الضيج كالطود","في حين يجزي صاحب الذل بالزاد",28,"د",1,0],["ضفا حلق الحديد عليه مثنى","وظاهر فوق بيضته الرخاما",29,"م",2,0],["ضِفدَعُ القلبِ صائِحٌ بِبِحَارٍ","من علومِ نورِيِّنا قد يخُوضُ",30,"ض",1,1],["ضفت عَلى عَطفيهِ أَبراد العُلى","قَديمة النَسج وَتلقاها جدد",31,"د",1,0],["ضفت الظلال وَقَد صفت أَنهارها","وَتدبجت حمر الربا ببياض",32,"ض",1,0],["ضفّتاكِ ارتاحَتا في خاطِري","واحتمى طيرُكِ في الظّنِّ وَحَامْ",33,"م",1,0],["ضفيرتاه على قتلي تضافرتا","يا من رأى شاعراً أودى به الشعر",34,"ر",1,0],["ضفت بركاتُ المصطفى فزمانهم","ربيعٌ وآجامُ الليوث مرابض",35,"ض",1,0],["ضفادع لو حان في مائها","لنادوا من الرعب ابن المفر",36,"ر",1,0],["ضِف يا غبيُّ شُروقَ شمسك","في السَماءِ إلى انمِحائِك",37,"ك",1,0],["ضفدعة من مائها النمير","قد خرجت لضفة الغدير",38,"ر",1,1],["ضفرَ الصباحُ ذوائباً","مسدولةً من مفرقِ",39,"ق",1,1],["ضفا ضوؤُهُ في الوضعِ رافِعَ دُجيَةٍ","من الكفرِ فيهِ كلنا ناهِضٌ نهضا",40,"ض",2,0],["ضفا فتراءت من أباطحِ مكَّةٍ","قُصُورٌ بشامٍ فاض ضوءٌ بها فيضا",40,"ض",2,0],["ضفا ساجداً للربِّ رافعَ رأسِهِ","وخافِضاً الدنيا بقبضِ الثرى قبضا",40,"ض",2,0],["ضفائِرُهُ والوجهُ سُورَةُ والضحى","إذا تليت أعطتك كلَّ الذي ترضى",40,"ض",2,0],["ضفا خُلُقاً فوق الضرائب حسنه","وأحسن ما يضفي الأنام الطبائعُ",41,"ع",1,0],["ضفت قواي من الهموم","وشغلت في عد النجوم",42,"م",1,1],["ضفت عزة في عفة وتمنع","لتسكن منها في ثلاث قباب",43,"ب",1,0],["ضفيرتاه على قتلي تضافرتا","وكم بعيني من أجفانه سَهَر",44,"ر",1,0],["ضفافها السَحرية المورقه","يَخفق قَلب النيل في صَدرِها",45,"ه",2,0],["ضفا للمكرمات عليك برد","وانج فيك للعلياء قصد",46,"د",1,0],["ضفادِعُ حول الماءِ تلعَبُ فرحَةً","أصبَرٌ على هذا ويونُسُ في القعرِ",47,"ر",1,0],["ضِفَّتي ظِلٌّ ظليلٌ","للنَدى والماءِ كَوْثَرْ",48,"ر",1,0],["ضفائرُ شَعْرِكِ سودُ الّليالي","فكيفَ تعانقٌ صبحَ الضياءْ",49,"ا",2,0],["ضفت عطاياه حتى كل سارية","في جنب جوهر جدواه غدت عرضا",50,"ض",2,0],["ضفادعها في العد مثل بعوضها","وداحسها في عدوه يسبق الغبرا",51,"ر",2,0],["ضف ريشه من مقره بالكويت","وأصطفق وأرعب جميع الطايرات",52,"ت",1,0],["ضفاف القلب محتلًة","وبالاشواق معتلًة",53,"ل",2,1]]}