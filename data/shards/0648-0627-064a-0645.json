8","الوافر"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104486","الطويل"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4852,"فارش الأميال","https://www.poetsgate.com/ViewPoem.aspx?id=214335",""],[4852,"سكوتي احتراقي","https://www.poetsgate.com/ViewPoem.aspx?id=215465",""],[5050,"لشغلي بأهل الدهر إحدى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=38188",""],[5072,"سيبكي الليل","https://www.poetsgate.com/ViewPoem.aspx?id=52560",""],[5135,"الجمال الحقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=201892",""],[5397,"تطارحني الحمائم بالنواح","https://www.poetsgate.com/ViewPoem.aspx?id=157915",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5493,"نافذة الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=196993",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5582,"أَتَعْلَمُ ذاتُ الغُنْجِ أَمْ لَيْسَ تَعْلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=187302",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5690,"تقلبت في هزل الغرام وجدّه","https://www.poetsgate.com/ViewPoem.aspx?id=172210",""],[5691,"أمَّةٌ عمْياءُ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207880",""],[5725,"لك ياحلوتي في القلب ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=192578",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5829,"حبل الله المتين","https://www.poetsgate.com/ViewPoem.aspx?id=202151",""],[5923,"سَأَم الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=162750",""],[5937,"مأوى العطور","https://www.poetsgate.com/ViewPoem.aspx?id=211811",""],[5952,"تباريني حروف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=197111",""],[5956,"الشياه الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=183495",""],[5956,"حكيماً كان سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=192635",""],[5956,"لم أكتب عند الله كذابا","https://www.poetsgate.com/ViewPoem.aspx?id=193590",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[5956,"بكل جلاله يأتي إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=194012",""],[5956,"تكاد البنت نحو الموت أن تثبا","https://www.poetsgate.com/ViewPoem.aspx?id=194711",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[5975,"هفت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=58783",""],[6048,"أروح بروحي لوقت وأرجع","https://www.poetsgate.com/ViewPoem.aspx?id=201218",""],[6120,"الحجاز","https://www.poetsgate.com/ViewPoem.aspx?id=213484",""],[285,"إذا لمْ يكنْ مِنْ حادِثِ الدَّهْرِ موئِلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7309&r=&rc=6",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[6346,"لك المدائح ياشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83384&r=&rc=0",""]],"verses":[["وَأَيمٍ مِنَ السُمرِ طاغي اللِسا","نِ يَأبى اللَديغُ بِهِ أَن يُبِلّا",0,"ل",2,0],["وَأَيُّ مَقامٍ لِلوَرى تَحتَ ظِلِّهِ","مَهيبٍ يُطاطي مِن عُيونِ الحَدائِقِ",1,"ق",1,0],["وَأَيُّ مُمَنَّعٍ يَأبى عَليهِم","إِذا آبوا بِأَسلابِ الأُسودِ",2,"د",1,0],["وَأَيمانٌ إِذا مَطَرَت عَطاءً","حَسِبتَ الناسَ كُلَّهُمُ جَوادا",3,"د",2,0],["وَأَيُّ مَضَاءٍ فِي لَطِيفِ طِبَاعِه","كَمَا سَكَنَ التَّصْمِيمُ فِي ظُبَةِ الْعَضْبِ",4,"ب",1,0],["وَأَيُّ مَزورٍ أَشعَثِ الرَأسِ هاجِعٍ","إِلى دَفِّ هَوجاءِ الوَنِيِّ عِقالُها",5,"ل",3,0],["وَأَيُّ مَعَدِّيٍّ يَخافُ وَقَد رَأى","جِبالَ مَعَدٍّ وَالعَديدَ المُجَمهَرا",6,"ر",2,0],["وَأَيِّ مَزارٍ زُرتَ حَرفٌ شِمِلَّةٌ","وَطاوي الحَشا مُستَأنِسُ القَفرِ ناحِلُ",7,"ل",1,0],["وأي مزور نحن أم أي زائر","إذا بلغ القَودُ الوِكال من الندب",8,"ب",1,0],["وأيماننا مبسوطة بسيوفنا","مُطَبّقَةٌ يوم الوغى حين تُشهَرُ",9,"ر",1,0],["وَأَيمَنُ لَم يَجبُن وَلَكِنَّ مُهرَهُ","أَضَرَّ بِهِ شُربُ المَديدِ المُخَمَّرِ",10,"ر",1,0],["وأيَّ مقامٍ في العلى لا يسوسه","وأيَّ همامٍ في الورى لا يسوده",11,"د",2,0],["وَأَيُّما نَغمَةٍ أَدّى عُذوبَتَا كَلامُ","راوٍ وَلا شادٍ يُغَنّيها",12,"ي",3,0],["وَأَيَّ مُجيرٍ بَعدَ مَروانَ أَبتَغي","لِنَفسِيَ أَو حَبلٍ لَهُ حينَ أَجرَما",13,"م",2,0],["وإيماضاً يَشُقُّ الجوَّ شَقّاً","كما اقْتَبَسَتْ إماءُ الحيِّ نارا",14,"ر",2,0],["وَأَيُّ مَنيعِ يَفوتُ الفَنا","إِذا كانَ يَفنى الصَفا وَالحَديدُ",15,"د",1,0],["وأيما خطرةٌ فالريحُ ناقلةٌ","والشطُّ حاكٍ لها والأفقُ أصداءُ",16,"ا",2,0],["وأيما لفظة فالريح ناقلة","والشط حاكٍ لها والأفق أصداء",17,"ا",2,0],["وَأَيُّ مَرامٍ عَنهُ يَعدو نِياطُهُ","عَدا أَو تَفُلُّ الناعِجاتِ أَخاشِبُه",18,"ب",2,0],["وأيُّ مُلكٍ رَمَتْهُ في مَعَاقِلهِ","بِراجفٍ من عَوادِيها فَما زَالا",19,"ل",2,0],["وأي مستكبرٍ يعيا عليك إذا","قدت الصعاب فلا تسأل عن الذُلل",20,"ل",1,0],["وأيّ محام كنت لما تقطعت","إلى ما ترى أقرانها وقيودها",21,"د",3,0],["وأيَّ مضطربٍ في ضِفتيَّ مَشَتْ","فيه الملايينُ من ساعٍ ومحتفلِ",22,"ل",1,0],["وَأَيُّ مَطْلُوبٍ عَزِيزٍ نَأَى","لَمْ يُدْنِهِ الإِيمَانُ وَالصَّبْرُ",23,"ر",1,0],["وَأَيِّ مَجْلىً بَدِيع","للإِبْتِهَاجِ أُعِدَّا",24,"د",2,0],["وَأَيٌّ مِن القُرآنِ تُتلى بِفَضلِهِ","وَإيثارُهُ بِالقوتِ في اللَزباتِ",25,"ت",1,0],["وإيمانٍ رسا كالطو","د، أو أَرْسَى من الطود",26,"د",1,0],["وأي مضاءَ في لطيفِ طِباعِه","كما سكَنَ التّصْميمُ في ضُبَّة ِ القُضْب",27,"ب",1,0],["وإيِمانٌ يقودُ الناسَ طَوعاً","إلى الغَمَراتِ فَتوىً واجتهادا",28,"د",2,0],["وأيّما نغمة أدّى عذوبتها","كلام راو ولا شاد يغنّيها",29,"ي",3,0],["وأيمَنَها وأمَنَها مُضَافاً","وأمرَعَها وأرواهَأ نُجُودَا",30,"د",2,0],["وَأَيُّما بُغيَةٍ تَنأى عَلى أَمَلي","وَذا المَقامُ إِلى ما أَبتَغي لَقَمُ",31,"م",1,0],["وأي مولا سوى جنابك","يجود مع موجب العذاب",32,"ب",1,0],["وأى مليك مثل أحمد حلمه","وهل يستوى البحران عذب ومالح",33,"ح",1,0],["وَأَيُّ مُعتَصِمٍ بِاللَّهِ مُنتَصِرٍ","لَلّهِ مِنهُ الرِّضا في اللَّهِ وَالغَضَبِ",34,"ب",1,0],["وأيّ مكان للأمانة والتقى","إذا لم يكن للمرء حظّ يساعده",35,"د",2,0],["وأيما لغةٍ تنسي امرأً لغةً","فإنها نكبةٌ من فيهِ تنسكبُ",36,"ب",1,0],["وَأَيُّ مِسخٍ أَحالَ شِعري","إِلى نُباح",37,"ح",1,0],["وأيُّ مجد لم أَلِجْ بابَه","وأيُ علمٍ لم يلِجْ صدري",38,"ر",2,0],["وإيماننا بضع وسبعون شعبةً","حديث صحيح النقل لا يتضعضع",39,"ع",1,0],["وأيمن مولود وأبرك مرضع","يدر له ثدي وأنجب مارث",40,"ث",1,0],["وَأَيُّ مَقامٍ يَرتَضيهِ أَخو النُهى","وَلا فاضِلاً يَلقى وَلا مُتَفَضِّلا",41,"ل",2,0],["واي محل عاطل لم تحله","علوم أبي يمن العلا ويمينها",42,"ن",3,0],["وإيمانُ قلبكَ في الشعرِ لاح","يُعزِّيكَ حُسناً وراءَ لِثام",43,"م",1,0],["وَأَيُّ مَرْأَى صَادِقٍ وَقَاصِد","صاعِدَةٌ إلى المَحلّ الصاعِدِ",44,"د",1,0],["وَأَيُّ مَرامٍ أَبْتَغِي بَعْدَ جُودِهِ","كَفى الْغَيْثُ مَنْ يُجْدى عَلَيْهِ وَمَنْ يُجْدِي",45,"د",2,0],["وَأَيُّ مُلِمٍّ فِي عَلائِكَ يَرْتَقِي","وَأَيُّ الرَّزايا فِي صَفاتِكَ يَقْدَحُ",46,"ح",1,0],["وَأَيُّ مُلِمٍّ يزدهيك وإنما","بحملك في أمثاله يتمثل",47,"ل",1,0],["وأي منامٍ لمن دمعه","بنوءِ الثريا يبل الثرى",48,"ر",2,1],["وَأَيُّ مَساءٍ ها هُنا قَد رَأَيتُهُ","فَها أَنا فيهِ إِذ دَجا اللَيلُ باكِرُ",49,"ر",1,0],["وإيمانك فجدد","بتكرير الشهادات",50,"ت",1,0],["وأيم الله إنك مستهام","إذا استعذبت في الحبِّ العذابا",51,"ب",2,0],["وَأَئِمَّةٍ جَمَعُوا الْعُلُومَ وَهَذَّبُوا","سنَنَ الْحَديثِ وَمُشْكِلَ الْقُرْآنِ",52,"ن",1,0],["وأَيُّ مُخْتَشِعٍ للهِ مُتَّضِعٍ","حُرِّ الشمائِلِ فِي حَرِّ الثَّرى وَضَعُوا",53,"ع",3,0],["وأيّ مكان تصطفيه مكرّم","وفي كل قطر أنت فرد معظّم",54,"م",1,0],["وأيّ مشهد يبي","ن لي بتلك البغتة",55,"ه",1,0],["وأي معنى من معاني السحر","يند عن أستاذنا بالحصر",56,"ر",1,0],["وأيُّ معنىً زائدٍ","أُحدثَ فيك بعدَنا",57,"ن",2,0],["وإيمانٌ بمعجزكم وشكرٌ","وكفرٌ تارة بكُمُ وفِسقُ",58,"ق",1,0],["وأيُّما عَلاقةٍ","بين الغرامِ والعُمُرْ",59,"ر",1,0],["وأيمان تضيعُ بها المعاني","وتحفظها الأناملُ والعِدادُ",60,"د",1,0],["وأيُّما صارمٍ لم يعلهُ صدأٌ","يوماً وبدرِ تمامٍ ليس ينكسفِ",61,"ف",1,0],["وأيْمانُهمْ خُلقتْ في الهِياجِ","لضربٍ يقطُّ الطُّلى أو طِعانِ",62,"ن",1,0],["وأيُّ مليكٍ قبلك اليومَ قادرٌ","مضى لم يطُفْ فيه بَربْعِ أثامِ",63,"م",1,0],["وَأَيُّ ماشٍ في مزلّاتِ الرّدى","جاز ولم يُخش عليه مِن زَلَلْ",64,"ل",1,0],["وأيُّ ماشٍ بين أث","ناءِ الورى ما زلقا",65,"ق",2,0],["وأيُّ مُخْتَرِقٍ يُضحِي وَلَيس بهِ","إلى الفضيلةِ منك النَّصُّ والعَنَقُ",66,"ق",1,0],["وأيُّ مُقصىً عن المعروف ليس له","مُصْطَبحٌ بين ما تُولِي ومُغْتَبَقُ",66,"ق",1,0],["وأيُّ مُرادٍ لم أنَلْهُ بعزّةٍ","فأنفسُ حظِّي منه أنْ يتبعّدا",67,"د",2,0],["وأيمانٌ خلقن الدّهْ","ر للطّعن وللضّربِ",68,"ب",1,0],["وإيماننا بالمرسلين جميعهم","وبالأنبيا طراً أولي الفضل والندى",69,"د",2,0],["وأيُّ ماءٍ بهِ يذكو اللهيبُ سِوَى","دمعُ الحزينِ الذي فوقَ الثَّرى هَطَلا",70,"ل",2,0],["وأيُّ مَحَلٍّ لا لكفّيْهِ نِعْمةٌ","على أهلِهِ من أرضِ بَرٍّ ولا بَحْرِ",71,"ر",1,0],["وَأيُّ مُصيبَةٍ عَظُمَت وَجَلَّت","مُصيبَتُها عَليّ مُصيبَتانِ",72,"ن",1,1],["وأيمنُ إن تَصدم بهِ الفقرَ تَنقلِب","غَنياً وإن تَصدُم بِه النَّحسَ تَسعد",73,"د",1,0],["واي محال في التسلسل إنه","تحكم آراها لها في المرا عشق",74,"ق",1,0],["وأيّما نِعمةٍ منْ قبلُ نَشْكُرها","والشُّكرُ مِنْها وشُكرُ الشُّكر وَلْتَقِسِ",75,"س",1,0],["وأيُّ مَرْءٍ سالمٌ مِنْ هَوىً","وقد رأى تلك الظُّبَيَّاتِ",76,"ت",1,0],["وأي معيد لم يكن منك آخذاً","وأي مجيد لم يكن لك حاكيا",77,"ي",2,0],["وأي معاهد لك لم تفده","غنى الدهرِ المواثق والعهود",78,"د",1,0],["وأيمان صدق أحكم الود عقدها","تزول الرواسي وهي ليس تزول",79,"ل",1,0],["وأئمةُ العدل الخلائفُ في الهدى","للأنبياء فلا جواز لعاذلِ",80,"ل",1,0],["وأئمة إن غاب منهم واحد","فرضاً يقوم مقام ذاك إمام",81,"م",1,0],["وأيمن إبراقا فاعود مشيما","وأعرق إرعادا فانحل متهما",82,"م",2,0],["وأئمتي قوم إذا ظُلموا فهم","لا يظلمون الناس وزن فتيل",83,"ل",1,0],["وأي مال أديت زكاته","هوَّت قلوصه ودرّت شاته",84,"ه",1,0],["وَأَيُّ مَعنى لِحُسنِ مَغنى","لَيسَ لِأَربابِهِ ثُبوت",85,"ت",1,0],["وأي ملح بالأسامي رددته","وقد عاش في اذكارها متبتلا",86,"ل",2,0],["وأي ملاحةٍ بقيت فتبقى","حياة الموصلي على الزمان",87,"ن",1,0],["وأي مكانٍ حللتم به","فلم يمس من نشركم يعبق",88,"ق",1,0],["وَأَيُّ مُلاَقٍ وَالخُيُولُ طَوَالِعُ","كَمَا أَمَّتِ الوِرْدَ النَّعَامُ الخَوَاضِبُ",89,"ب",1,0],["وإيمانُ الُمقلدِ ذُو اعِتَبارٍ","بأنواعِ الدلائلِ كالنَّصالِ",90,"ل",1,0],["وأيُّ معنًى إليه يغدو","في وصفِ معناك أو يروحُ",91,"ح",1,0],["وأيم اللَه لو كنت ابن كسرى","لما درت عليك بغير مهر",92,"ر",1,0],["وإيمانُ القلوب وكلُّ صدق","وركن البيت للمتيمِّنينا",93,"ن",2,0],["وأي مملكةٍ كانت مسيطرة","على البلاد تريها الخير والذّهبا",94,"ب",2,0],["وأيم الله ما برحت","به الأطوار تختلف",95,"ف",1,0],["وَأَيُّ مَرامٍ رُمتَهُ لَم تَقُم بِهِ","لَكَ المُرهَفاتُ البيضُ وَالذُبَّلُ المُلدُ",96,"د",1,0],["وإيماضُ بَرْقٍ أَم شِفارُ صَوارِمٍ","بَدَتْ أَم سِهَامٌ من لِحاظِكِ أم سِحْرُ",97,"ر",1,0],["وأيّ مجد مثل ذا","وأيّ فخر قد سمع",98,"ع",1,0],["واي مكرمة أُثني عليه بها","والطبع منهُ على أفرادها اشتملا",99,"ل",2,0],["وَأَيُّ مَعالي الجَيشِ كانَت تَروقُني","إِذا لَم أَقُد يَوماً مِنَ الدَهرِ جَحفَلا",100,"ل",2,0],["وَإِيمانُ صِدقٍ لا يُشابُ بِباطِلٍ","وَفِعلٌ إِذا جَرَّ الفَعالُ كَلامُ",101,"م",1,0],["وأي محلة قابلت منها","رأيت كواكباً فيها تسير",102,"ر",1,0],["وأَيَّمتَ مِنّا الَّتي لَم تَلِد","كيتمِ بَنيك وَكُنتَ الخَليلا",103,"ل",2,0],["وَأَيُّ مَليكٍ مِن مَعَدٍّ عَلِمتَمُ","يُعَذِّبُ عَبداً ذي جَلالٍ وَذي كَرَم",104,"م",1,0],["وأيمَ عمري قد تناثرنَ مثلما","تناثَرُ أوراقُ الغصون أوارا",105,"ر",2,0],["وَايماضُ ذي جَد وِاعَراض هازِلٍ","وِسورة ذي طَيشٍ وَعَطفٌ لَبيب",106,"ب",1,0],["وايُّ ملامٍ للمحبِّين في الهوى","إذا ما الدَّواعي صَدَّقَت للمخائِلِ",107,"ل",1,0],["وأيم أيبيس إِن لم تنهجوا سبلى","لم أبق فى أرضكم داراً لديَّار",108,"ر",1,0],["وَأَيّ مَرافِقٍ تُرِكَت فَقامَت","بِها الفَوضى سُقوطاً وَاِنحِدارا",109,"ر",2,0],["وأي ملاذ للبرية أنتما","إِذا نابهم خطب من الدهر داهم",110,"م",1,0],["وأي مليك عاش حراً كعيشتي","وهل مجد أرباب العروش سوى وهم",111,"م",1,0],["وأي مصير غير جاهك حيثما","نحا نحوه الراجي تعزز بالمجد",112,"د",1,0],["واي مراد غير ما شئت كيفما","تخيرته فيه ازدهى طالع السعد",112,"د",1,0],["وأي معضلةٍ جلاء فاقمه","سقت ذوي الدين من كاساتها جرعا",113,"ع",2,0],["وإيماني تضاعف بامتحاني","وسوق معارفي زادت نفاقا",114,"ق",2,0],["وَايمُنُ هَمزُال كَذَا وَيُبدَلُ","مَدا فِى الإستِفهامِ أو يُسَهَّلُ",115,"ل",1,0],["وأَيمُ اللَهِ انكَ في أمورٍ","عديمةِ كُلِّ بِرٍّ وانتِظ