ستبنى بوسط الغيم شعراجنائنه",142,"ن",2,0],["وَأَيْمِ اللهِ قَدْ ضَاعَتْ وَضَلَّتْ","طَريقَ النُّورِ عَنْهَا قدْ تنَحّى",143,"ح",2,0],["وإيماننا قول وفعل ونية","ويزداد بالتقوى وينقص بالردا",144,"د",2,0],["وَأَيُّ مُقامٍ كانَ فُضِّلَ سُوحُهُ","كَما فُضِّلَ البَيْتُ العَتِيقُ المُحَرَّمُ",145,"م",1,0],["وأيُّ معنىً لتحرير إذا حُبِسَتْ","أنفاسُ شعْب عليهِ القَصْدُ ينعقدُ",146,"د",1,0],["وأيُّ مسعىً إذا ما ساءَ فاعلُهُ","ضَلَّتْ معانيهِ مهما كانَ يَعتذِرُ",147,"ر",1,0],["وايم اللّه والعتق قاتلي","عبيدٌ أسير الصدق بل عبد عبدهِ",148,"د",2,0],["وإيمانِها بالحَقِّ ضِمْنَ عَدالَةٍ","وحُكْمٍ رَشيدٍ ، في الأُمورِ لهُ نَظْرَهْ",149,"ر",2,0],["وايم الحب فاتنتي مداناً","وما صنت العهود وانت صنتِ",150,"ت",1,0],["وأي مكان جر هذب جلاله","عليه فسمت الكعبة الحقيقيتي",151,"ت",2,0],["وأيم الله لا يغنيك دفع","لكلِّ مصيبة إلا اليقينُ",152,"ن",1,0],["وأي مسرة نحيا وداري","من الأرزاء تترى تستباحُ",153,"ح",1,0],["وأي مناكيرٍ ستقبلُ أرفُفي","إذا لم تكنْ من ناعِمَيكِ الأظافِرُ",154,"ر",1,0],["وأيم الله ما برحت حروفي","تُسائلُني ويغشاها الذهولُ",155,"ل",1,0],["وأيمُ الله أَحترم الشياها","كما في الحبِّ احترمُ الشِّفاها",156,"ا",3,0],["وأَيمُ الله لست أُكِنُّ شرَّاً","ولو أُشْرِبتُ من دَمِكُنَّ جاها",156,"ا",3,0],["وإيمانٍ بمعبودٍ وحيدٍ","ورسْلٍ عدةٍ قبلَ الخليلِ",157,"ل",1,0],["وأيم الله لم أكذبْ","بعمري غير واحدةٍ",158,"ه",1,1],["وأيم الله ما حققتُ جدْوَى","سوى شاركتُ غيري والعيالِ",159,"ل",1,0],["وأيم الله لم أصحب صديقاً","كهذا الشهم فهو أخٌ أثيرُ",160,"ر",1,0],["وأيمُ الله أُرجِعُها لصحتها","إذا ما شاهدتْ وجهي قدِ اقتربا",161,"ب",2,0],["وأيم الله لم أكْسَبْ هناء","سوى أَكْسَبْتُ قومي أو ذوِيَّهْ",162,"ي",2,0],["وأيُّ محجّةٍ حجّت ولبّتْ","كتلكَ ورغمَ ذا الدهرِ الخؤونِ",163,"ن",1,0],["وإيماني قويا وقلبي عفيا","وفكري نقيا وشعريٓ أمتع",164,"ع",1,0],["وَأَيْمُ اللهِ لَوْلَا الْخَوْفَ مِنْهُ","لَقُلْتُ بِأَنَّ فِيهَا قِبَلَتَيْنِ",165,"ن",1,0],["وأيُّ مُلِمٍّ يَزْدَهِيكَ وإنَّمَا","بحلمكَ في أمثالِهِ يُتمثَّلُ",166,"ل",1,0],["وأي مجد أقلته صحائفه","إلا إليها مع الأمجاد ينتسب",167,"ب",1,0],["وَأَيْمُ 