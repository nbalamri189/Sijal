{"poems":[[88,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[99,"أيكون ذنبي أن رفع","https://www.aldiwan.net/poem24919.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[102,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[102,"ليالي السجن","https://www.poetsgate.com/ViewPoem.aspx?id=50145",""],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[102,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[280,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[556,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"روح تغذت بتقوى الله طيبة","https://www.aldiwan.net/poem34449.html","البسيط"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44792","الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67846","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96365","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105431","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110272","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108485","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9640","المتقارب"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125952","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131047",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136476",""],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130289","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141601","البسيط"],[4755,"صَيَّادُ البُرُوق","https://www.poetsgate.com/ViewPoem.aspx?id=199741",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4862,"معزوفة الشجن","https://www.poetsgate.com/ViewPoem.aspx?id=55383",""],[5135,"أزْرَتْ بهِ الأشْواقُ","https://www.poetsgate.com/ViewPoem.aspx?id=202004",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5409,"علموا الميسر العروب وقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=155317",""],[5956,"القناعة كنز لا يفنى","https://www.poetsgate.com/ViewPoem.aspx?id=192382",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6102,"فَ.......","https://www.poetsgate.com/ViewPoem.aspx?id=184545",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6261,"تباريحُ الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82137&r=&rc=9",""]],"verses":[["وَجَثا الطَبيبُ يَجُسُّ نَبضاً خافِتاً","وَيَرودُ مَكمَنَ دائِها القَتّالِ",0,"ل",1,0],["وجثوتُ في محراب قُد","سك عابداً هذا الرُّواء",1,"ا",2,0],["وجثموا إلا عيونا ساميهْ","تجسّ حصناً أو تجوس حاميهْ",2,"ه",1,0],["وجثت مصر به خاشعة","تذرف الدمع على خير البنين",3,"ن",1,0],["وجثا، يحنو عليه منزلٌ","سقفه الثلج، وجدران المساءِ",4,"ا",2,0],["وجثت على قلبي كأنّي صخرة","لا تفهم التنويه والتلميحا",5,"ح",2,0],["وجثا الفتى بين الجراح كمدنف","يستنجد العوّاد بالزفرات",6,"ت",1,0],["وجثّة شوّش التعطير جيفتها","كأنّها ميته في ثوب عطّار",7,"ر",1,0],["وَجثا الشعرُ لِلَّصلاةِ جثّو ال","مُؤمِنينَ العُفاةَ وَالأُمَناءِ",8,"ا",2,0],["وجَثَا يُقَبِّل قَبْلَ راحَتِكَ الثَّرَى","غَرِداً بِما أوْلَيْتَهُ مُتَرَنِّما",9,"م",2,0],["وَجَثا ناشئاً على خشب الملْ","ك فأرجا في العالمين وأمضى",10,"ض",2,0],["وجثتي أبهمتها صبوة عظمت","يا ليت أحداهما في حيز العدم",11,"م",1,0],["وجثة نبتت مما يحل لها","من المآكل ما في ضعفها باس",12,"س",1,0],["وَجَثُمتَ فَوقَ عِظامَهِ","فَصَرَخنَ تَحتَ الجاثِمِ",13,"م",1,0],["وجثوا مطاياهم وجد سباقهم","يَعِزُّ عَلَيْنَا هَجْرُهُمْ وَفِرَقُهُمْ",14,"م",1,0],["وَجَثَت على رَكبٍ تهدُّ بها الصفا","وعلى الكلاكِلِ بالنَّقِيلِ المُطرِقِ",15,"ق",1,0],["وجثث علىالركب الخلائق كلهم","للهيب نار أسعرت بتشعل",16,"ل",1,0],["وجثمانه بالحق قامت صفاته","وأسماؤهُ في الخلق تسمو وتعظم",17,"م",1,0],["وجثثاً فوق الثرى ودت لها","تكون أحداق المعالي فرشا",18,"ش",2,0],["وجثا الناسُ كلهم في خضوعٍ","إذا تجلع مهابة الرحمنِ",19,"ن",1,0],["وجثت في ظلالِ صفصافة حا","كت ذؤاباتها وحاكت حياها",20,"ا",3,0],["وجثت على قدمي أبيها ترتجي","لطفاً ولكن خانها حكم القدر",21,"ر",1,0],["وَجَثّامُ إِذ سارَ في قَومِهِ","سَفاهاً إِلَينا وَحُمرانُها",22,"ن",3,0],["وَجَثّامَةُ الذُهلِيُّ قَد وَسَجَت بِهِ","إِلى أَهلِنا مَخزومَةٌ وَهوَ مُحقَبُ",23,"ب",1,0],["وجثت تبكى على جثته","ودموع الموت لم تنسجم",24,"م",1,0],["وجثت أمام الرمس تلثمه ومن","عبراتها وبل عليه يهطل",25,"ل",1,0],["وجثوا لشارعة الرماح بمعركٍ","كادت تزولُ به ربىً وهضاب",26,"ب",1,0],["وجثوتها سعد وفي جنباتها","نمير وبيض من كلاب عواتق",27,"ق",1,0],["وجثئته بشعير لا يخالطه","ماس ولا عسجد خوفاً من الدرد",28,"د",1,0],["وجَثَا الخَيَالُ على ضَرِيحِكَ مِثلما","يَجثُو على أنقاضِهِ المُنهَارُ",29,"ر",1,0],["وجثمتَ دهراَ فوق ضعف صدورنا","فلأنتَ جاثومٌ يُري الأرزاءَ",30,"ا",2,0],["وجثت على صدري الهموم بثقلها","فوجدتها كاالراسيات جبالا",31,"ل",2,0],["وجَثَا يُلَمْلِمُ دَمْعَهُ بِكُفُوفِهِ","هلْ مِثْلُهُ عندَ البُكاءِ يُلاَمُ ؟!",32,"م",1,0],["وجثت بجاثية عليهم صخرة","تنحط مثل الرجس عن أو ثانه",33,"ن",2,0],["وجثت قرب ربوةٍ ضرب الجن","د عليها سرادقاً وخياما",34,"م",2,0],["وجثا جوارهما أبٌ يهواهما","يدعو الكريم مُحقّقَ الآمالِ",35,"ل",1,0],["وَجثَا على حَيّيْ نِزارَ ويعرُبٍ","عَرَكاً كما سِيمَ الدباغَ أَديمُ",36,"م",1,0],["وَجَثَوتُ مُتَّكِئًا عَلَى نَدَمِي","فَحَمَلتُها, فَتَنَهَّدَ الصَّدرُ",37,"ر",1,0],["وجثمانه نهب لأزرق مارقٍ","وأسمر عسالٍ وأبيض باتر",38,"ر",1,0],["وجَثا الضياءُ فَفَرَّ من طرقِ الدنا","ورأيتُه يطفو على الإمسَاءِ",39,"ا",2,0],["وجَثَتْ مهجتي على ركبتيها","وتكوَّمتُ دمعةً قُدَّامَهْ",40,"م",2,0]]}