{"poems":[[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[97,"أيكون ذنبي أن رفع","https://www.aldiwan.net/poem24919.html","مجزوء الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"ليالي السجن","https://www.poetsgate.com/ViewPoem.aspx?id=50145",""],[221,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[273,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[549,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[556,"روح تغذت بتقوى الله طيبة","https://www.aldiwan.net/poem34449.html","البسيط"]],"verses":[["وَجَثا الطَبيبُ يَجُسُّ نَبضاً خافِتاً","وَيَرودُ مَكمَنَ دائِها القَتّالِ",0,"ل",1,0],["وجثوتُ في محراب قُد","سك عابداً هذا الرُّواء",1,"ا",2,0],["وجثموا إلا عيونا ساميهْ","تجسّ حصناً أو تجوس حاميهْ",2,"ه",1,0],["وجثت مصر به خاشعة","تذرف الدمع على خير البنين",3,"ن",1,0],["وجثا، يحنو عليه منزلٌ","سقفه الثلج، وجدران المساءِ",4,"ا",2,0],["وجثت على قلبي كأنّي صخرة","لا تفهم التنويه والتلميحا",5,"ح",2,0],["وَجثا الشعرُ لِلَّصلاةِ جثّو ال","مُؤمِنينَ العُفاةَ وَالأُمَناءِ",6,"ا",2,0],["وجَثَا يُقَبِّل قَبْلَ راحَتِكَ الثَّرَى","غَرِداً بِما أوْلَيْتَهُ مُتَرَنِّما",7,"م",2,0],["وَجَثا ناشئاً على خشب الملْ","ك فأرجا في العالمين وأمضى",8,"ض",2,0],["وجثتي أبهمتها صبوة عظمت","يا ليت أحداهما في حيز العدم",9,"م",1,0],["وجثة نبتت مما يحل لها","من المآكل ما في ضعفها باس",10,"س",1,0]]}