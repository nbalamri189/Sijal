{"poems":[[88,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[99,"أيكون ذنبي أن رفع","https://www.aldiwan.net/poem24919.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[102,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[102,"ليالي السجن","https://www.poetsgate.com/ViewPoem.aspx?id=50145",""],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[102,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[226,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[278,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[553,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[560,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[560,"روح تغذت بتقوى الله طيبة","https://www.aldiwan.net/poem34449.html","البسيط"],[939,"","https://poetry.dctabudhabi.ae/diwan/poem/9640","المتقارب"],[939,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"]],"verses":[["وَجَثا الطَبيبُ يَجُسُّ نَبضاً خافِتاً","وَيَرودُ مَكمَنَ دائِها القَتّالِ",0,"ل",1,0],["وجثوتُ في محراب قُد","سك عابداً هذا الرُّواء",1,"ا",2,0],["وجثموا إلا عيونا ساميهْ","تجسّ حصناً أو تجوس حاميهْ",2,"ه",1,0],["وجثت مصر به خاشعة","تذرف الدمع على خير البنين",3,"ن",1,0],["وجثا، يحنو عليه منزلٌ","سقفه الثلج، وجدران المساءِ",4,"ا",2,0],["وجثت على قلبي كأنّي صخرة","لا تفهم التنويه والتلميحا",5,"ح",2,0],["وجثا الفتى بين الجراح كمدنف","يستنجد العوّاد بالزفرات",6,"ت",1,0],["وجثّة شوّش التعطير جيفتها","كأنّها ميته في ثوب عطّار",7,"ر",1,0],["وَجثا الشعرُ لِلَّصلاةِ جثّو ال","مُؤمِنينَ العُفاةَ وَالأُمَناءِ",8,"ا",2,0],["وجَثَا يُقَبِّل قَبْلَ راحَتِكَ الثَّرَى","غَرِداً بِما أوْلَيْتَهُ مُتَرَنِّما",9,"م",2,0],["وَجَثا ناشئاً على خشب الملْ","ك فأرجا في العالمين وأمضى",10,"ض",2,0],["وجثتي أبهمتها صبوة عظمت","يا ليت أحداهما في حيز العدم",11,"م",1,0],["وجثة نبتت مما يحل لها","من المآكل ما في ضعفها باس",12,"س",1,0],["وَجَثّامُ إِذ سارَ في قَومِهِ","سَفاهاً إِلَينا وَحُمرانُها",13,"ن",3,0],["وَجَثّامَةُ الذُهلِيُّ قَد وَسَجَت بِهِ","إِلى أَهلِنا مَخزومَةٌ وَهوَ مُحقَبُ",14,"ب",1,0]]}