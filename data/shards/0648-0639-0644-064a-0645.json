=155262",""],[5411,"مِصْر العُروبَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=185426",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5464,"حكاية في ليل بهيّ","https://www.poetsgate.com/ViewPoem.aspx?id=27916",""],[5595,"يَا قلبُ صَبْرَاً","https://www.poetsgate.com/ViewPoem.aspx?id=177967",""],[1117,"رفيق الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=19376",""],[5722,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=12682",""],[5751,"طِفلة الورد","https://www.poetsgate.com/ViewPoem.aspx?id=214766",""],[5751,"رسْمٌ بذاكرةِ اللَّيلَك","https://www.poetsgate.com/ViewPoem.aspx?id=214774",""],[5751,"جاءتكَ شاعرةً","https://www.poetsgate.com/ViewPoem.aspx?id=215008",""],[5751,"أميرة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=215029",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5770,"نحن سبعة","https://www.poetsgate.com/ViewPoem.aspx?id=178734",""],[5783,"لم تعقمي يا أمة الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=34050",""],[5790,"سطرتها والسمهرية شرع","https://www.poetsgate.com/ViewPoem.aspx?id=112068",""],[5790,"ولقد ذكرتك والصوارم لمع","https://www.poetsgate.com/ViewPoem.aspx?id=111909",""],[4615,"أيداً تفيضُ وخاطراً متوقدا","https://www.poetsgate.com/ViewPoem.aspx?id=17840",""],[5909,"شوقٌ إذا حل المساءُ كففته","https://www.poetsgate.com/ViewPoem.aspx?id=210235",""],[5909,"شوقٌ إذا حل المساءُ كففته","https://www.poetsgate.com/ViewPoem.aspx?id=210698",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[402,"وعلي من فعلي في الجى إذا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54075&r=&rc=927",""],[6318,"السهم الأخير وفتىًُ يفَجَّر نفسَهَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66168&r=&rc=18",""],[6336,"بعد العاصفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73566&r=&rc=27",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""]],"verses":[["وَعَلَيَّ مِنُّكَ ضافِياً","وَعَلى أَعاديكَ المَنونُ",0,"ن",1,0],["وعلَيَّ مِن حُلَلِ الشَّبابِ ذَوائِبٌ","عَبِقَتْ بِرَيَّا المِسْكِ وهْوَ فَتيقُ",1,"ق",1,0],["وَعَلَى مَقَامِكُمُ سَلاَمٌ عَاطِرٌ","تُهْدِيه دَارِينٌ لَدَى نَفَحَاتِهَا",2,"ت",3,0],["وَ عَلِي مَنْ فَعَلِيٍّفي الجلى إذَا","مَا نُودِيَ المُتَحَفِّزُ العَزَّامُ",3,"م",1,0],["وَعَلَى مُرَاوَدَةِ المَنَافِعِ عَهْدُهُ","أبداً وَثِيقٌ وَالذِّمامُ ذِمَامُ",4,"م",1,0],["وعلى من يتمنّى","يومه مرجوعُ وكسِه",5,"س",2,0],["وَعَلى ما تَصعَدُ كَالسَحابَةِ في الفَضا","وَإِلى التُرابِ مَصيرُ كُلِّ سَحابِ",6,"ب",1,0],["وَعَلى ما فيكَ مِن صَلَفٍ","أَنتَ مَأمونٌ وَمَأمولُ",7,"ل",1,0],["وعلى مطالعة وفي هالاته","بزغت شموس العز والأقمار",8,"ر",1,0],["وعلى مرآة مجرحة من","ها جرى دمعه السخيّ الهتون",9,"ن",1,0],["وعلى موعدها أطبقت عيني","وعلى تذكارها وسدت رأسي",10,"ي",1,0],["وعلى مجلسِ التنعّمِ بُؤسٌ","فبديلُ السّماعِ فيهِ العويلُ",11,"ل",1,0],["وَعَلَى مَضاجِعهِم وكلِّ ثَنِيَّةٍ","كلٌّ يُسِرُّ وَيُعلِنُ التَّهْلِيلا",12,"ل",2,0],["وعلى مَطاها فِتيَةٌ شِيعيّةٌ","ما إن لها إلاّ الوَلاءَ شِعار",13,"ر",1,0],["وعلى مُفارَقَةِ الشَّبابِ شَمتْنَ بي","وعلى مُعاداةِ الصِّبا عادَينَني",14,"ن",2,0],["وعلى من أتوا هنا","لك ما يشاء يغضب",15,"ب",1,0],["وعلى مَسْمَعيكَ تَنْهلُّ نوحاً","وعويلاً مُرًّا شجونُ القُلوبِ",16,"ب",1,0],["وَعَلَى مُحَيَّاكَ ابْتِسَامٌ رَائِقٌ","يَجْلُو فَسَامَتَهُ وَضوْءٌ رَائِعُ",17,"ع",1,0],["وَعَلَى مُنْحَنَاهُ قَوْسُ سَحَابٍ","تَتَبَاهَى بِكُلِّ لَوْنٍ مُنِيرِ",18,"ر",1,0],["وعلى منعطفٍ أو شارعٍ","من دم الذكرى وأنقاض الرجاءِ",19,"ا",2,0],["وعلى موعد رقت في ثوان","كتّف القصر بالهوى مستنيره",20,"ر",2,0],["وَعَلَى مَضاجِعِهِمْ وكلِّ ثَنِيَّة","ٍ خَتَمَتْ وصِيَّتُهُ لهنَّ فصُولا",21,"ل",2,0],["وعلى مقرب من الدوح يجر","ي جدول سكب ماؤه سلسبيل",22,"ل",1,0],["وعلى مظهر الجلال علي","صنو طه وصهره الكرار",23,"ر",1,0],["وعلى ما عذبت أو ملحت","حرقه الصدر نصيبي والظما",24,"ا",1,0],["وعلى مساعدةِ الهوى","طال احتمالي واحتمالُكْ",25,"ك",1,0],["وعلى مثل فلس مثقال يبكى","لا على درهم ولا دينار",26,"ر",1,0],["وعلى منابر ايكها اطيارها","سجعت وبالافراح كادت تنطق",27,"ق",1,0],["وعلى م الجهد في الزرع إذا","كان قبل النضج يودي بالزروع",28,"ع",1,0],["وعليّ مذهلت مزينة","رب الجمال أقامها والي",29,"ل",2,0],["وَعَلى مَحجَرِ اليَتيمِ مِنَ القَلبِ","دِماءٌ مَحمومَةٌ بِالزَفيرِ",30,"ر",1,0],["وَعَلى مفرقي وَقَلبي سَيَبقى","غُصنُكِ الرَطبُ وَهوَ حَيٌّ رَطيبُ",31,"ب",1,0],["وَعَلى مُقلَتَيَّ حُلماً لَذيذاً","حامِلاً مِن سَمائِهِ أَلحانا",32,"ن",2,0],["وَعَلى مَرأى الضَميرِ","إِبنِ لِلنَّفسِ مقرّا",33,"ر",2,0],["وَعَلَيَّ مِن حِلَلِ الصِبى فَضفاضَةٌ","أَختالُ في حَبراتِها الأَفوافِ",34,"ف",1,0],["وَعَلَيَّ مِن حُلَلِ الشَبابِ مُلاءَةٌ","إِنسُ الجَليسِ وَمِلءُ عَينِ الناظِرِ",35,"ر",1,0],["وَعَلَى مَقَامِكُمُ الذِي خَفَضَ الْعُلاَ","أَزْكَى سَلاَمٍ كَالْعَبِيرِ الصَّائِكِ",36,"ك",1,0],["وَعَلَى مَقَامِكُمُ الْعَلِِّي تَحِيَّتِي","مَا رَدَّدَتْ وَرْقَاءُ فِي أَزْجَالِهَا",37,"ل",3,0],["وعلى من قام بنصرته","وعلى الساري بطريقته",38,"ه",1,0],["وعلى من مهّد للأرضي","ن كما قد برّح في الحبجِ",38,"ج",1,0],["وعلى منازِلنا جَرَت عَبراتُها","لمَّا تذكَّرتِ النَّعيمَ النائي",39,"ا",2,0],["وعَلى مَيامِنِهِ الكَوافِلِ بِالمُنى","تأمِينُ ظَبْي القَفْر عَدْوةَ ذيبِهِ",40,"ب",2,0],["وَعَلَيَّ مِن حُلَلِ القَناعَةِ حُلَّةٌ","إِنّي لَمُختالٌ بِها وَفَخورُ",41,"ر",1,0],["وعلى موائد أنس شهم قد سما","دارت كؤوس في رياض ختان",42,"ن",1,0],["وعَلَى من بشديدِ الجورِ والظلم مِني","قال: يا ذا المالِ ما في المال لي من مطمع",43,"ع",1,0],["وعلى منص الجمع قف متخليا","عن كل فان للتفرق نافي",44,"ف",2,0],["وعلى من ليل الغموم دجنة","أمسيت فيها حائر الأفكار",45,"ر",1,0],["وعلى مذبَح القداسات أدّي","نا صلاة العواطف الحمراء",46,"ا",2,0],["وعلى مُتونِ الخيلِ أحْلاسٌ لها","من كُلُّ مِطْعامِ النَّدى مِطْعان",47,"ن",1,0],["وعلى مناكِبها إذا هي قايَستْ","لأبيكَ أو لكَ حَمْلُ شُكْرٍ أزْيد",48,"د",1,0],["وَعَلى مَقادير الرِجالِ فِعالِهِم","قَطع المُهَنَّدِ تابِعٌ لِحَديدِهِ",49,"د",2,0],["وعلى ما أنا فيه من جوًى","ما أظنُّ الوَجْدَ يبقى لي فؤادا",50,"د",2,0],["وعلى ما هو فيه لم يزلْ","أو يقال التّبر قد عادَ رغاما",51,"م",2,0],["وعلى منبَرِ هامات العدى","خطبت بالحتف والموت الزُّؤام",52,"م",1,0],["وعلى ما يلوح لي منه مرأًى","قَرَأَ المجدُ سَطْرَه واستملاّ",53,"ل",2,0],["وعلى ما عُوِّدت آباؤُه","عوّدته من قديم فتعوَّد",54,"د",1,0],["وعلى منبر خديه استوى","خاله الزنجي بالحسن خطب",55,"ب",1,0],["وعليّ من نظراتِ جاهكَ لأْمةٌ","أبداً تَقيني أسهمَ الحدَثانِ",56,"ن",1,0],["وعليم أنت بمن يطوي","لكم الاحشاء على ضمد",57,"د",1,0],["وعلى مِنىً أبياتُ طاهرةٍ","بالخصبِ تَقرِي الشّهدَ والسَّمْنا",58,"ن",2,0],["وعلى ما رابهم أو رابني","من زماني ما بقيتم ما أبالي",59,"ل",2,0],["وعليَّ من نُعمَى يديك طلاوةٌ","أمشي وتتبعني لها الأبصارُ",60,"ر",1,0],["وعلى ما صفحوا أو نَقموا","ما أرى لي منكِ يا ظبيةُ بُدَّا",61,"د",2,0],["وعليّ من ثوبَيْ هواي وعفّتي","شوقٌ يُبَلُّ وخَلوةٌ لا تَقبُحُ",62,"ح",1,0],["وَعَليَّ مِن وَرَقِ الشَبابِ وَظِلِّهِ","غُصنٌ تَفَرَّعَ في الغُصونِ ظَليلُ",63,"ل",1,0],["وعلى متن الأماني حملت","متى أصبحت مع الفلك تسير",64,"ر",1,0],["وعلى مُنشئ اليواقيتِ فيها","واللآلي مَباسِماً وشِفاها",65,"ا",3,0],["وعلى ما عهٍِدتَ مِنِّي ثَناءً","لم أزَل في العَشيِّ والإبكاَرِ",66,"ر",1,0],["وعلى مَ نُسقَى الصّابَ فيه وإنّه","يُسقى هناك كما يشاء السَّلْسَلا",67,"ل",2,0],["وعلى مثل ما عهدنا ليوثُ ال","غاب تمضي قِدْماً عهدنا الشُّبولا",68,"ل",2,0],["وعليَّ مِن نَسْجِ الأسنّةِ نَثْلَةٌ","وعلى كُماةِ الرَّوْعِ نسجُ يَلامِقِ",69,"ق",1,0],["وعلى مساكنهمْ وإنْ سكنوا الثّرى ال","أَرَجُ الذكيُّ أو النّسيمُ الأعبقُ",70,"ق",1,0],["وعلى مِنىً غُرَرٌ رمين نفوسَنا","قَبْلَ الجِمارِ من الهوى بحُتُوفِ",71,"ف",1,0],["وعَلَيَّ مِن خِلَعِ القَنا حَلَقٌ","لَم يدنها نَسجٌ ولا سَرْدُ",72,"د",1,0],["وعلى ملة المفضل طه","عيشهم كان ههنا وأبيدوا",73,"د",3,0],["وعلى مثل خليل الله من","جاء بالحق وإسحق الذبيح",74,"ح",1,0],["وعليَّ من عين السرادق أعين","للحق تحفظني مدى الأيام",75,"م",1,0],["وَعَلى مَذَاقِ المُرِّ مِنْ ثَمَرِ الجَفَا","يَبْلَى الصَّحيحُ هَوىً مِنَ المُذَّاقِ",76,"ق",1,0],["وعلى محياه السنيّ","تلوح أنوار السعود",77,"د",1,0],["وَعليّ مِن رمدٍ بهِ داويته","ف