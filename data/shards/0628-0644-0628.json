/www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5491,"واعد بالوصل","https://www.poetsgate.com/ViewPoem.aspx?id=196728",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"خوفٌ على الروحِ الوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=192328",""],[5970,"ينقم الناقمون فعل الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=130600",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""],[6183,"طير شارد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79844&r=&rc=34",""]],"verses":[["بِلُبنى أُنادى عِندَ أَوَّلِ غَشيَةٍ","وَلَو كُنتِ بَينَ العائِداتِ أُفيقُ",0,"ق",1,0],["بَل بَكَت عَينٌ فَرَوَّت تُربَهُ","هَل عَلى أَحجارِهِ خَطَّ أَحَد",1,"د",1,0],["بُلْبُلُ الرِّوْضِ إِنْ شَدَا بِاحْتِفَالٍ","مَلَكَ السَّمْعَ أَوْ شَدَا بِارْتِجَالِ",2,"ل",1,0],["بل بأن شاهدوا السماء سُموّاً","برُقيٍّ في المَكْرُماتِ الصِّعابِ",3,"ب",1,0],["بل بِسنا الصبح إذا تبلَّجا","لأكسُونَّ الكَلِمَ المدبَّجا",4,"ج",2,0],["بَلْ بدا البدر بين سعدين لا يُجْ","هَلُ عنْد الذَّكِيِّ والمبْلُودِ",5,"د",1,0],["بل بأن يُنْصب حُرٌّ نفسَه","وبأن يسهر والناس رُقودُ",6,"د",1,0],["بل بنحول العظام مُحتقِراً","ذاك وإن كان غير محتقرِ",7,"ر",1,0],["بل باجتناب الشفاء بل بتوخ","خي النفس ما يُتَّقى من الضّررِ",7,"ر",1,0],["بل بيت بِرٍّ تظل كعبتهُ","محجوجةً للنوال معتَمرَه",8,"ر",2,0],["بل بِنىً تُذْكِرهُ الجن","نة في خير عَقَار",9,"ر",1,0],["بل بغاء مستحرٌّ وخبلٌ","مستمرٌّ مذ غذاك الرضاع",10,"ع",1,0],["بل بالسَّدَى والندى الغَمْ","ر والأيادي الجسامِ",11,"م",1,0],["بل بالمكارم والمج","د والمساعي العظامِ",11,"م",1,0],["بل بالمشورة في الخُطْ","طَةِ العياء العُقَامِ",11,"م",1,0],["بل بات يمري فكره تحت الظُّلمْ","مريَ أنوف البهم أطراف الحُلَمْ",12,"م",1,0],["بل بسحناءِ وجهِ سهلٍ طليقٍ","وبطيبٍ من نفسِ سمْحٍ كريم",13,"م",1,0],["بلْ بِرَدْعِ الحوادث المُصْمَئِلّا","ت ومرِّ الشهور والأعوام",14,"م",1,0],["بَل بَكَينا لِأَنَّنا قَد حُرِمنا","بِالمَنونِ المَزيدَ مِن آياتِه",15,"ت",2,0],["بُلبُلٌ إِسكَندَرِيٌّ أَيكُهُ","لَيسَ في الأَرضِ وَلَكِن في السَماء",16,"ا",2,0],["بُلبُلٌ عَلَّمَهُ البَينُ البَيان","باتَ في حَبلِ الشُجونِ اِرتَبَكا",17,"ك",2,0],["بَل بِاِمرِىءٍ أَسدى إِلَيهِ سَماحَةً","نِعَماً فَكانَ المَدحُ غايَةَ جُهدِهِ",18,"د",2,0],["بل بُعْدُهُ قُرْبُهُ لا فَرْقَ بَيْنَهُمَا","أزْدَادُ شَوْقاً إليهِ غَابَ أَوْ شَهِدَا",19,"د",2,0],["بل بعلمٍ واجتهادٍ","وبما أشبهَ ذلكْ",20,"ك",1,0],["بلبالُهُ مخلَّدٌ في بالي","فما لهُ مغيِّرٌ بحالِ",21,"ل",1,0],["بل بآلامٍ وصبرٍ وضنىً","ودموع ودمٍ حُرٍّ سجامِ",22,"م",1,0],["بل بأمثال صالح يتحدى","شَعْبُ ليبيا، ويرفع الشرقُ هامَه",23,"م",2,0],["بلبها البرق كأن سائقا","يزجها نحا بأسواط السنا",24,"ا",1,0],["بل بات يمري فكره تحت الظُّلم","مريَ أنوف إليهم أطراف الحلم",25,"م",1,0],["بُلْبُلٌ يحمِلُ في منقاره","وَرْقَةً من وردةٍ ذاتِ جمالِ",26,"ل",1,1],["بَل بدرًَ تَمِّ أَشرَقَت أنوَارُهُ","في الأُفقِ بَل مَا حُزتِ شَمسَ زَوَالِ",27,"ل",1,0],["بِلِبَاسِ مَحْزُونٍ وَدَمْعَةِ عَاشِقٍ","وَحَنِينِ مُشْتاقٍ وَأَنَّةِ جَازعِ",28,"ع",1,0],["بل بحقٍ ظاهرٍ بُرهانُه","مُذْ أضاءتْ شمسُه لم تَغْرُب",29,"ب",1,0],["بلباقةٍ ورشاقَةٍ","ووضوحِ معنىً باقتِدارِ",30,"ر",1,0],["بل بعصرٍ فيهِ الضعيفُ مُهانٌ","فالنجاةَ النجاةَ المشرفيّه",31,"ي",2,0],["بلبل في حلقك الشادي ينوح","آه من حلقك آها ثم آه",32,"ه",1,0],["بُلبُل الأَرضِ وَالسَما","ناشِرَ النورِ فيهِما",33,"م",2,0],["بل بماضي عناية وبعزم","صادق واجتناب غير الجنس",34,"س",1,0],["بلبلٌ في الرياض يُلهِمُه الوحيُ","فيشجي القلوب عذبُ بيانِه",35,"ن",2,1],["بَلْبلَتْ مُقْلتُهُ عَقلي وَقَدْ","سَحَرَتْهُ فَأَرَتْني بَابِلا",36,"ل",2,1],["بَل بِقَصدٍ فيما أُحِلَّ وَزُهدٍ","في حَرامٍ وَرَغبَةٍ في ثَوابِ",37,"ب",1,0],["بَل بِاِقتِفا الباطِنِ مِن ظاهِرٍ","أَنزَلَهُ اللَهُ هُدىً لِلأَنامِ",38,"م",1,0],["بلبل الأنس 