{"poems":[[37,"ألما على سلمى نسلم ونسأل","https://www.aldiwan.net/poem39099.html","الطويل"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[74,"سبتني صفان السكري الذي حكى","https://www.aldiwan.net/poem18935.html","الطويل"],[31,"لأسماء محتل بناظرة البشر","https://www.aldiwan.net/poem6183.html","الطويل"],[40,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[33,"يقول خليلي إذ أجازت حمولها","https://www.aldiwan.net/poem42550.html","الطويل"],[42,"يقول خليلي والمطي خواضع","https://www.aldiwan.net/poem42310.html","الطويل"],[78,"أيا ويح نفسي وويل أمها","https://www.aldiwan.net/poem38881.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62208","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62258","الطويل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[35,"يقولون ليْلى بالْعِرَاقِ مَريضة","https://www.poetsgate.com/ViewPoem.aspx?id=2682",""],[47,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[37,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[34,"ألا ليتَ ريعانَ الشبابِ جديدُ","https://www.poetsgate.com/ViewPoem.aspx?id=15920",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[121,"مراكش (عندا علي)(1)","https://www.aldiwan.net/poem24035.html","الوافر"],[136,"سبت لبه من بعد كبرته جمل","https://www.aldiwan.net/poem54770.html","الطويل"],[136,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[136,"سبت قلبي المليحة بنت فارا","https://www.aldiwan.net/poem54843.html","الوافر"],[141,"أحب الغناء وشرب الطلاء","https://www.aldiwan.net/poem68000.html","المتقارب"],[201,"سباك الجيد والقد","https://www.aldiwan.net/poem39863.html","مجزوء الوافر"],[208,"سنة يزاد بها الأمير جمالا","https://www.aldiwan.net/poem53156.html","الكامل"],[254,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[287,"أدر يا نديمي علينا عقارا","https://www.aldiwan.net/poem32782.html","المتقارب"],[302,"سقى تلك الأباطح والرمالا","https://www.aldiwan.net/poem33190.html","الوافر"],[358,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[438,"سبت فؤادي وطرفي","https://www.aldiwan.net/poem12745.html","المجتث"],[463,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[463,"وصفحة وجه من وجوه علقتها","https://www.aldiwan.net/poem56267.html","الطويل"],[568,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67022","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59613","الطويل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145630","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59374","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65031","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64736","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49623","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[2321,"","https://poetry.dctabudhabi.ae/diwan/poem/147007","الطويل"],[2327,"","https://poetry.dctabudhabi.ae/diwan/poem/123667","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46744","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65941","الطويل"],[2835,"","https://poetry.dctabudhabi.ae/diwan/poem/198815","الوافر"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71321","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68061","الطويل"],[3434,"","https://poetry.dctabudhabi.ae/diwan/poem/203218","الوافر"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140255",""],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21498","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81713","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4320,"","https://poetry.dctabudhabi.ae/diwan/poem/133905","الطويل"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198560","الطويل"],[4859,"سبتمبر التحرير!","https://www.poetsgate.com/ViewPoem.aspx?id=206932",""],[5285,"هدير السواقي","https://www.poetsgate.com/ViewPoem.aspx?id=203583",""],[5302,"إلى أروى","https://www.poetsgate.com/ViewPoem.aspx?id=200129",""],[5302,"ملكت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=202727",""],[5302,"ولكنه حظ الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=204916",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[2110,"سريت بها والليل داجي الحنادس","https://www.poetsgate.com/ViewPoem.aspx?id=156274",""],[5704,"بدرٌ وجمال...","https://www.poetsgate.com/ViewPoem.aspx?id=191805",""],[5997,"سِبْتَمْبَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214461",""],[5309,"طلبت من الورد الممنع شمه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573616",""]],"verses":[["سَبَتهُ بِعَذبِ الريقِ صافٍ غُروبُهُ","رَقيقِ الثَنايا بارِدٍ لَم يُفَلَّلِ",0,"ل",1,0],["سَبَتني إِذ شَبابي لَم يُعَصَّب","وَإِذ لا يَستَبِلُّ لَها قَتيلُ",1,"ل",1,0],["سَبَتني بِعَينَي ظِبيَةٍ يَستَنيمُها","أَغَنُّ البُغامِ أَعيَسُ اللَّونِ راشِحُ",2,"ح",1,0],["سَبَتْ لُبَّهُ أَسْمَاءُ مُنْذُ احْتِلامِهِ","فَكَانَ الْهَوَى يَنْمُو بِهِ كُلَّمَا نَمَا",3,"م",2,0],["سبتني صفان السكريّ الذي حكى","بضاعته حتَّى عدمت قراري",4,"ي",1,1],["سَبَتكَ بِمُرتَجِّ الرَوادِفِ ناعِمٍ","وَأَبيَضَ عَذبِ الريقِ مُعتَدِلِ الثَغرِ",5,"ر",1,0],["سَبَتكَ بِعَينَي جُؤذَرٍ حَفَلَتهُما","رِعاثٌ وَبَرّاقٌ مِنَ اللَونِ واضِحُ",6,"ح",1,0],["سَبتٌ وَنَوروزٌ وَنَجدَةُ سَيِّدٍ","ما خابَ بَهجَةُ خُلقِهِ بِتَخَلُّقِ",7,"ق",1,0],["سَبَتهُ بِوَحفٍ في العِقاصِ كَأَنَّهُ","عَناقيدُ دَلّاها مِنَ الكَرمِ قاطِفُ",8,"ف",1,0],["سَبَتهُ بِوَحفٍ في العِقاصِ مُرَجَّلٍ","أَثيثٍ كَقِنوِ النَخلَةِ المُتَكَوِّرِ",9,"ر",1,0],["سبَتني غَداةَ النَحرِ مِنها بِفاحِمٍ","وَذي أُشُرٍ أَطرافُهُ لَم تَثَلَّمِ",10,"م",1,0],["سَبَتْني بجيدٍ وخدٍّ ونحرٍ","غداةَ رمَتْني بأسهُمِها",11,"م",3,0],["سبتنيَ ليلى إذ بدت بمحاسن","كثرن ومن حازت محاسنها تسبي",12,"ب",2,0],["سَبَتْكَ بِمَأْشُورِ الثَّنَايَا كَأَنَّهُ","أَقَاحِي غَدَاةٍ بَاتَ بِالدَّجْنِ يُنْضَحُ",13,"ح",1,0],["سَبَتْنِي بِعَيْنَيْ جُؤْذَرٍ حَفَلَتْهُمَا","رِعَاثٌ وبَرَّاقٌ مِنَ اللَّوْنِ وَاضِحُ",14,"ح",1,1],["سَبَتني بِعَينَي جُؤذُرٍ وَسطَ رَبرَبٍ","وَصَدرٌ كَفاثورِ اللُجَينِ وَجيدُ",15,"د",1,0],["سَبَتْنِي بِعَيْنَيْهَا وَقَالَتْ لِتِرْبِهَا","أَلا مَا لِهَذا الْغِرِّ يَتْبَعُنِي قَصْدِي",16,"د",2,0],["سبتني شمس يخجل البدر نورها","ويكسف ضوء البرق وهو بروق",17,"ق",1,0],["سَبْتٌ، وَنَوْرُوزٌ، وَنجدَةُ سيّدٍ،","ما شَابَ بَهجَةَ خُلْقِهِ بتَخَلّقِ",18,"ق",1,0],["سبتني إذْ شبابي لم يُعصَّبْ","وإذ لا يستبلُّ لها فتيلُ",19,"ل",1,0],["سبتني بعيني جؤذرٍ وسطَ ربربٍ","وصدرٌ كفاثورِ اللجينَ جيدُ",20,"د",1,0],["سَبَتْ بِالحَيَاءِ الكَاذِبِ المُتَكِلَّف","وَدَاجَتْ فَصَادَتْ بِالمَقَالِ المُلَطَّفِ",21,"ف",1,0],["سَبَتْ قَلْبًا يَتُوبُ عَنِ الغَواني","ويغرقُ في العيونِ المَغْرِبيّةْ",22,"ي",2,0],["سَبَت لُبَّهُ مِن بَعدِ كَبرَتِهِ جُملُ","ففي جَفنِهِ وَبلٌ وفي عَقلِهِ خَبلُ",23,"ل",1,1],["سَبَتني مِنهَا نَظرَةٌ وإشَارَةٌ","بِطَرفٍ كَحِيلٍ مَا أُمِرَّ بِهِ كُحلُ",23,"ل",1,0],["سَبَتكَ خَرِيدَةٌ حَورَاءُ تَبدُو","نَضارَةُ وَجِهَهَا مِثلَ النُّضَارِ",24,"ر",1,0],["سَبَت قَلبي المَلِيحَةُ بِنتُ فَارَا","ففاض الدَمعُ مِن عَيني وفَارَا",25,"ر",2,1],["سَبَتني البَغومُ بِدَلِّ رَخيمٍ","وَوَجهٍ نَضيرٍ شَبيهِ القَمَر",26,"ر",1,0],["سبتك وكم وكم من","شاعر أودى به الوجد",27,"د",1,0],["سبتك وأسرفت بدلالها","والأهل كم ودوا",27,"د",3,0],["سبتك بحسنها والحب","قتال ولا حدّ",27,"د",1,0],["سبتك بحسنها لتروح","مجذوبا ولا تغدو",27,"د",2,0],["سبتك بحسنها والحب","فيه الصاب والشهد",27,"د",1,0],["سبت دعوة ذا الحلال مُوَاتراً","سنةً فما تَركُ الصبوح حلالا",28,"ل",2,0],["سَبَتهُ وَلَم تَخشَ الَّذي فَعَلَت بِهِ","مُنَعَّمَةٌ مِن نَشءِ أَسلَمَ مُعصِرُ",29,"ر",1,0],["سبتها التجارُ فَجاءوا بِها","إِلى الشَربِ من صَيدنا يا وقارا",30,"ر",2,0],["سَبت جَفنيَّ نومَهما لكيلا","أواصلُ في المَنام لها خَيالا",31,"ل",2,0],["سَبَت مُهجَتي خودٌ حَوَت كُلَّ بَهجَةٍ","فَما تَرَكَت لِلشَمس في مُقلَةٍ أسره",32,"ر",2,0],["سبَتْ فؤادي وطرفي","سمراءُ مثلُ الرُدَيْني",33,"ن",2,1],["سبتِ القلوب ففي أناملها","دَمُها يُرينَك إنه الحِنّا",34,"ن",2,0],["سَبَتني بألفاظِ الرجال وطابَ لي","جَناها ولم تنطقْ ولم أرَ طيبا",35,"ب",2,0],["سَبَتني فَقَبَّلتُ الثَرى مُتَخَلِّصاً","أَمامَ اِمتِداحِ اِبنِ الشَريفِ مُحَمَّدِ",36,"د",1,0],["سَبَتْنِي على عَهْدٍ من السِّلْم بيننا","ولَوْ أنَّها حَرْبٌ لكانتْ هي السَّبْيَا",37,"ا",1,0],["سبتني من الغيد الحسان بُدورُ","فدمعي على حكم الغرام بُحور",38,"ر",1,1],["سَبَتْك فانتزعَتْ قَلبًا على صِغَرٍ","فصِرتَ شَبَّابَةَ العُشَّاقِ فِي فِيها",39,"ي",3,0],["سَبَتْ أيدي السماء لُجَيْنَ شمسٍ","وَأخْفَتْهُ مِنَ اللَّيْلِ البَهِيمِ",40,"م",1,1],["سَبَتْني كاسيةٌ بالجَمالِ","فرُوحي عِنْدي لَهَا عارِيَهْ",41,"ي",2,0],["سَبَتْ فؤاديَ مِنْها طَعْنَةٌ عَرَضٌ","كأَنَّها طعنةٌ مِنْ كفِّ محمودِ",42,"د",1,0],["سبتُ فؤادي ذات الخال قادرة","ولا نصيب لهُ منها سِوى النصب",43,"ب",1,0],["سَبَتني بَعَينَي جُؤذُرٍ بَخَميلَةٍ","وَجيدٍ كَجيدِ الرِئمِ زَيَّنَهُ النظمُ",44,"م",1,0],["سبتني وقالت من سباك وما الذي","على قلبك استولى فقلت مكلمي",45,"م",2,0],["سبت مهجتي لما أصابت حشاشتي","بسهم وقيدي بالصبابة أدهم",46,"م",1,0],["سَبَتني بِجيدٍ لَم يُعَطَّل ولبَّةٍ","عَلَيها رِدافا لؤلؤٍ وَجُمانِ",47,"ن",1,0],["سبتك ولم تنظر سوى الساق حرمة","بغير اعتماد نظرة المتحرج",48,"ج",1,0],["سَبَتْ كل العيون فكل قلب","تراهُ مِن مفاتنها أسيرا",49,"ر",2,0],["سَبَتْنَا الجُفُونُ البَابِليَّاتُ مِنْكُمُ","وَإِنَّ لُبَانَاتِ الُّلَباءَةِ فِي الحَبِّ",50,"ب",1,0],["سبَتْك الليالي لا رعى اللهُ يومَها","مُولَّعة يَسْبِين كلَّ طريفِ",51,"ف",1,0],["سبت قلبي لواحظه وولى","فصار الخضر يتبعه الكليم",52,"م",1,0],["سبت فؤادي بحسن الدل حين رنا","خلخالها مشبهاً بالصوت أوتارا",53,"ر",2,0],["سبَتكَ فَتاةٌ لُباخِيَّةٌ","بِوجهٍ أَسيلٍ وَخَلقٍ رِفَل",54,"ل",1,0],["سَبَتِ العِدا حتَّى غَدوا أيدي سبا","وتمزّقوا في الأرض كلَّ ممزّق",55,"ق",1,0],["سبت عُرُباً من نسوةِ العُرْب تَسْتَبي","إذا ما اسبكَرَّتْ بين درع وَمِجْوَل",56,"ل",1,0],["سبتها يد الأعداء رغم أنوفكم","وقد هتكوا الخدر المصون وحطموا",57,"م",3,0],["سبتني بصوت لو يباع اشتريته","بما مر من عمري وذاك يسير",58,"ر",1,0],["سبتمبر التحريرِ رمز خلودنا","سيف العدالةِ والكرامةِ والوطن",59,"ن",1,1],["سَبتُه الروابي وعشقُ السواقي","وأشلاءُ ذكراهُ أضْحتْ صَريما",60,"م",2,0],["سبتني بكل الحسن لما أتت أروى","فقلبي هوى والقلب يهوي بمن يهوى",61,"و",2,1],["سبت الفؤاد ولست أجهل ما الذي","يجري وليس عن الفؤاد بخافي",62,"ف",2,0],["سبتني فتاة ذات يوم وأوقدت","به جذوة والعين في الرأس تغمض",63,"ض",1,0],["سَبَتِ العيونَ تحومُ أوجَ سمائِها","فتمايلتْ عشقاً تميسُ سحابَها",64,"ب",3,0],["سبت بشذاها كل عطر وأوشكت","تنشقها الآذان قبل المعاطس",65,"س",1,0],["سبتْ خاطري واحتوتْ عمْقَ روحي","وحلَّتْ بقلبي فزادتْ غرامَهْ",66,"م",2,0],["سِبْتَمْبَرُ الْمَعْصُوْمِ عَاْدَ مُضَرَّجاً","بِدُمِ الْغُرُوْبِ وَحَسْرَة الْإِشْرَاْقِ",67,"ق",1,0],["سَبَتَهُ المُنى وَاستَعبَدَتهُ المَطامِعُ","وَقَد يَشتَهي الإِنسانُ ما فيهِ حَتفُهُ",68,"ه",1,0]]}