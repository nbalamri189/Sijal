{"poems":[[3,"لقد وجدنا زبيداَ غير صابرة","https://www.aldiwan.net/poem177.html",""],[93,"يوسف يا سبط الندى والعلى","https://www.aldiwan.net/poem9776.html","عموديه"],[93,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[93,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[51,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[91,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[45,"هاجي بني بحتر وطيئها","https://www.aldiwan.net/poem62765.html","المنسرح"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116999","الطويل"],[91,"عطش الارواح","https://www.poetsgate.com/ViewPoem.aspx?id=53426",""],[91,"عطش الارواح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66219&r=&rc=20",""],[235,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[364,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[403,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[495,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[551,"يا رب ليل أخذنا فيه منيتنا","https://www.aldiwan.net/poem47809.html","البسيط"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[575,"بنفسي فتاة يكتب الغصن إن مشت","https://www.aldiwan.net/poem2961.html","الطويل"],[586,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["وَلي جَوادٌ لَدى الهَيجاءِ ذو شَغَبٍ","يُسابِقُ الطَيرَ حَتّى لَيسَ يُلتَحَقُ",0,"ق",1,0],["وليجيء اليوم المروم الذي","تدرك فيه سر هذا الخطاب",1,"ب",1,0],["وليجعل الخلق العظيم خلاقهم","فبه تتم عظائم الأوطار",2,"ر",1,0],["وَليَجْذَلِ الجَذْلان وَليَبْكِ مَنْ","يبكي لِشَكْوى نَفْسِهِ الشَّاكِيهْ",3,"ي",2,0],["ولَيُجزلنَّ لك الثوابَ ولم يكن","لخليقة منه نَتيجٌ مُخْدَجُ",4,"ج",1,0],["وليجعلِ الإذنَ رسماً لا زوالَ له","كالإذنِ للقومِ من أصحابهِ النُبُلِ",5,"ل",1,0],["وَليَجئ طوفانُ نوحٍ قَبلَما","تَغرَقُ الأَرضُ بِطوفانِ الدِماء",6,"ا",2,0],["وَلي جَليسٌ لَولا خَساسَتُهُ","لَقَد أَقامَ الهِجاءُ مِن أَوَدِه",7,"د",2,0],["ولي جلساءٌ ما أمَلُّ حديثَهم","ألبّاءُ مأمنون غيباً ومشهَدا",8,"د",2,1],["وليجىء طوفان نوح قياما","تغرق الأرض بطوفان الدماء",9,"ا",2,0],["وليجىء طوفان نوح قبلما","تغرق الأرض بطوفان الدماء",10,"ا",2,0],["وَليَجعَلَنَّ الدَمعَ بَعدَكَ دَأبَهُ","وَالحُزنَ ما اِمتَدَّ الزَمانُ وَطالا",11,"ل",2,0],["ولي جَفْنٌ قليلُ الصَّحْوِ مهما","تَنفّسَ لائمٌ بالعَذْلِ غاما",12,"م",2,0],["ولي جلساء لام يمل حديثهم","يناجون طرفي بالأحاديث لا سمعي",13,"ع",2,0],["ولي جسد كواحدة المثاني","له كبد كثالثة الأثافي",14,"ي",1,0],["وَلي جُفونٌ بِغَيرِ السُّهدِ ما اِكتَحَلَت","وَلي رُسومٌ بِغَير السُّقمِ لَم تُسَمِ",15,"م",1,0],["ولِي جَنانٌ كأنّ الأرضَ ساحتُهُ","فما يضيق لمرهوبٍ يُخامرُهُ",16,"ر",2,0],["ولِي جفونٌ من البَلْوى مُسَهَّدَةٌ","لا تعرفُ الغَمْضَ ممّا ترقُبُ الصُّبُحا",17,"ح",2,0],["ولي جَسدٌ ما زال مأْسورَ صَدِّها","إِلى أَن حَكَى في السُّقْم ماسُورَ خدِّها",18,"د",3,0],["وَلي جَلدٌ عِنْدَ بِيضِ الظُّبَى","وَبِالأعْيُنِ النُّجْلِ ما لي قِبلْ",19,"ل",1,0]]}