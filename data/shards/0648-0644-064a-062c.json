{"poems":[[3,"لقد وجدنا زبيداَ غير صابرة","https://www.aldiwan.net/poem177.html",""],[95,"يوسف يا سبط الندى والعلى","https://www.aldiwan.net/poem9776.html","عموديه"],[95,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[95,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[53,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[93,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[47,"هاجي بني بحتر وطيئها","https://www.aldiwan.net/poem62765.html","المنسرح"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116999","الطويل"],[93,"عطش الارواح","https://www.poetsgate.com/ViewPoem.aspx?id=53426",""],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[93,"عطش الارواح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66219&r=&rc=20",""],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[369,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[409,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[500,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[556,"يا رب ليل أخذنا فيه منيتنا","https://www.aldiwan.net/poem47809.html","البسيط"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[580,"بنفسي فتاة يكتب الغصن إن مشت","https://www.aldiwan.net/poem2961.html","الطويل"],[591,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145959","الوافر"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1785,"","https://poetry.dctabudhabi.ae/diwan/poem/198824","السريع"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104779","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113741","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105012","الكامل"],[2469,"","https://poetry.dctabudhabi.ae/diwan/poem/203619","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204749","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202393","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118834","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121415","المتقارب"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108156","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108325",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107536","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119644","البسيط"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143033","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120193","الكامل"],[4755,"إلى الحُبِّ مِمَّا مَضَى أَبرَأُ","https://www.poetsgate.com/ViewPoem.aspx?id=202247",""],[4767,"سيف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215269",""],[4790,"يا نخلة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=144354",""],[4578,"بحبك برهان الغرام مسلم","https://www.poetsgate.com/ViewPoem.aspx?id=49522",""],[4929,"سجال البوابة","https://www.poetsgate.com/ViewPoem.aspx?id=211691",""],[5781,"يَبابهُ وربيعي","https://www.poetsgate.com/ViewPoem.aspx?id=202855",""],[402,"وافى الحديث إلى غريب الدار","https://www.poetsgate.com/ViewPoem.aspx?id=35742",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5872,"هواكم بقلبي ما لنحكمه نسخ","https://www.poetsgate.com/ViewPoem.aspx?id=120616",""],[5943,"رمسُ الحبيب بدمع العين يسقينا","https://www.poetsgate.com/ViewPoem.aspx?id=34784",""],[5970,"خذ من الدنيا الذي أعطت ولا","https://www.poetsgate.com/ViewPoem.aspx?id=130593",""]],"verses":[["وَلي جَوادٌ لَدى الهَيجاءِ ذو شَغَبٍ","يُسابِقُ الطَيرَ حَتّى لَيسَ يُلتَحَقُ",0,"ق",1,0],["وليجيء اليوم المروم الذي","تدرك فيه سر هذا الخطاب",1,"ب",1,0],["وليجعل الخلق العظيم خلاقهم","فبه تتم عظائم الأوطار",2,"ر",1,0],["وَليَجْذَلِ الجَذْلان وَليَبْكِ مَنْ","يبكي لِشَكْوى نَفْسِهِ الشَّاكِيهْ",3,"ي",2,0],["ولَيُجزلنَّ لك الثوابَ ولم يكن","لخليقة منه نَتيجٌ مُخْدَجُ",4,"ج",1,0],["وليجعلِ الإذنَ رسماً لا زوالَ له","كالإذنِ للقومِ من أصحابهِ النُبُلِ",5,"ل",1,0],["وَليَجئ طوفانُ نوحٍ قَبلَما","تَغرَقُ الأَرضُ بِطوفانِ الدِماء",6,"ا",2,0],["وَلي جَليسٌ لَولا خَساسَتُهُ","لَقَد أَقامَ الهِجاءُ مِن أَوَدِه",7,"د",2,0],["ولي جلساءٌ ما أمَلُّ حديثَهم","ألبّاءُ مأمنون غيباً ومشهَدا",8,"د",2,1],["وليجىء طوفان نوح قياما","تغرق الأرض بطوفان الدماء",9,"ا",2,0],["وليجزم التكبير والتسليم كي","يقعا من المأموم بعد على الاثر",10,"ر",1,0],["وليجتهد عند الدعاء معمما","لا يختصص بدعائه عمن حضر",10,"ر",1,0],["وليجىء طوفان نوح قبلما","تغرق الأرض بطوفان الدماء",11,"ا",2,0],["وَليَجعَلَنَّ الدَمعَ بَعدَكَ دَأبَهُ","وَالحُزنَ ما اِمتَدَّ الزَمانُ وَطالا",12,"ل",2,0],["ولي جَفْنٌ قليلُ الصَّحْوِ مهما","تَنفّسَ لائمٌ بالعَذْلِ غاما",13,"م",2,0],["ولي جلساء لام يمل حديثهم","يناجون طرفي بالأحاديث لا سمعي",14,"ع",2,0],["ولي جسد كواحدة المثاني","له كبد كثالثة الأثافي",15,"ف",2,0],["وَلي جُفونٌ بِغَيرِ السُّهدِ ما اِكتَحَلَت","وَلي رُسومٌ بِغَير السُّقمِ لَم تُسَمِ",16,"م",1,0],["ولِي جَنانٌ كأنّ الأرضَ ساحتُهُ","فما يضيق لمرهوبٍ يُخامرُهُ",17,"ر",2,0],["ولِي جفونٌ من البَلْوى مُسَهَّدَةٌ","لا تعرفُ الغَمْضَ ممّا ترقُبُ الصُّبُحا",18,"ح",2,0],["ولي جَسدٌ ما زال مأْسورَ صَدِّها","إِلى أَن حَكَى في السُّقْم ماسُورَ خدِّها",19,"د",3,0],["وَلي جَلدٌ عِنْدَ بِيضِ الظُّبَى","وَبِالأعْيُنِ النُّجْلِ ما لي قِبلْ",20,"ل",1,0],["ولي جَسَدٌ جَهدتُ بأنْ يُلاقي","منازفهُ بأوردَةٍ ضِخامِ",21,"م",1,0],["وليجتنوا رطب المعارف والتقى","من عذق حالهما الجنى الدّاني",22,"ن",2,0],["ولي جليس قربه مني","بعد الأماني كلها عني",23,"ن",2,1],["وَلِى جُرعَةٌ فِى العِشقِ لَو طُرِحَت علَى","بِحارٍ مِلاَحٍ لاستَحالَت عُذُوبَةِ",24,"ه",1,0],["ولي جوارٌ بأعتابٍ حَلَلتُ بها","فعندها العرشُ والكرسِيُّ يُحتَقَرُ",25,"ر",1,0],["وليجر أدمعه اليراع لكاتب","أجراه في جفن الهداية مرودا",26,"د",2,0],["ولي جهة غربية أشرقت بها","لعيني شمس الأفق من غير لا حجب",27,"ب",1,1],["وليجتنب موضع كسر الآنيه","وموضع العروة للكراهيه",28,"ه",1,0],["ولي جورب للبرد أحمله معي","ولست للبسي جوربا بالمقنن",29,"ن",1,0],["ولي جنة في الروح حرّاً سكنتها","وعفت جناناً تجمع المال والرقّا",30,"ق",2,0],["ولي جفون عليك قرحى","وهجرك اليوم قد كواني",31,"ي",1,1],["ولي جارةٌ لا يلم الكرى","بأجفانها الدعجِ فيما يلم",32,"م",1,1],["ولَّى جمالك فاندب أزمناً سلفت","وقل سلام على حسني إلى سلفا",33,"ف",2,1],["ولي جسد ماء الجوى قاطرٌ كما","لها جسد ماء المحاسن ينبعُ",34,"ع",1,0],["وَليجر من دمع المداد لما جرى","بتذلل الشهم البليغ قضاء",35,"ا",2,0],["وَليُجَندِل كُلَّ جَبَّارٍ أَبِي","فائزاً مِنهُ بِحُرِّ السَّلَبِ",36,"ب",1,0],["وليجتمع اهلُ المدينة كلهم","ليروا جزاءَ الخانة الفجارِ",37,"ر",1,0],["ولي جنان يقدّ الصخر مرهفه","كسيف سلمان في الهيجاء سُلّ لها",38,"ه",2,0],["وليجمل الصنع من دان الجمال له","وليحسن الخلق ممن خلقه حسن",39,"ن",1,0],["وليجعلن لواء إمرته على","رغم الحسود مويدا معصوما",40,"م",2,0],["ولِي جَنَّةٌ داخِلي عَرضُها ال","سَّماواتُ والأَرضُ، لا تَصدَأُ",41,"ا",1,0],["وليجعلِ البدرُ منكِ الليلَ ذا وَضَحٍ","ولْتَزهُ مِن شمسِ ما تُبدينَ أيام",42,"م",1,0],["ولي جراحٌ بِعُمْقِ الروحِ يُرْعِبُني","أَنْ تَسْتَفيقَ فَتُلقيني بِكَفِّ ردى",43,"د",2,0],["ولي جدل في الشعر يبدي خطابه","إذا غالط العشاق بالعذل لوَّم",44,"م",1,0],["ولي جنونٌ ، أولوا الألباب لوعرفوا","فحْواهُ أمسيتُ منهم اشتكي الحسَدا",45,"د",2,0],["وَلي جَفْنَةٌ بالسُّهْدِ أكْحَلَها الهوى","وبَوْحُ النَّدى لوْ يَسْتَظِلُّ بِدَمْعتي",46,"ت",2,0],["وليجعل الخلق العظيم خلاقهم","فبم تتم عظائم الأوطار",47,"ر",1,0],["ولي جلد عند بيض الظبا","وبالأعين السود مالي قبل",48,"ل",1,0],["ولي جلد أضحى قنيص غرامه","ولا شرك يدني إليه ولا فخ",49,"خ",1,0],["وليجعلِ اللهُ حوضَ الحِبِّ موعدَنا","تحتَ اللواءِ وعفو الله يأتينا",50,"ن",2,0],["وليجدها بعض قوم حلوة","وليجدها من سواهم حنظلا",51,"ل",2,0]]}