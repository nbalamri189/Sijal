ldiwan.net/poem54175.html","أحذ الكامل"],[433,"لست أدري أتحفة تتهادى","https://www.aldiwan.net/poem12431.html","الخفيف"],[444,"أمعروف قد واسيت قلب المتيم","https://www.aldiwan.net/poem56019.html","عموديه"],[449,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[453,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[454,"أخي سليمان هذي غربتي بلغت","https://www.aldiwan.net/poem61238.html","البسيط"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[459,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[459,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[465,"أمعنى فيمن هويت جهالة","https://www.aldiwan.net/poem3312.html","عموديه"],[465,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[515,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[516,"الدمع يهمل والفؤاد عليل","https://www.aldiwan.net/poem12226.html","الكامل"],[516,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[517,"أمعارف الدمن القفار توهم","https://www.aldiwan.net/poem48611.html","الكامل"],[539,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[539,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[549,"أمعتقلي ريب المنون ولم أرع","https://www.aldiwan.net/poem1174.html",""],[574,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[587,"وافى وأرواح العذيب نواسم","https://www.aldiwan.net/poem17701.html","الكامل"]],"verses":[["أَمُعيني عَلى بُلوغِ الأَماني","وَشِفائي مِن عِلَّتي وَاِشتِياقي",0,"ق",2,0],["أَمُعَشِّرَ الأَحداثِ في أَذيالِها","ناجاكَ مَدحي وَالجُدودُ عَواثِرُ",1,"ر",1,0],["أَمَعاهِدَ الأَحبابِ هَل عَودٌ إِلى","مَغدىً نَبُلُّ بِهِ الجَوى وَمَراحِ",2,"ح",1,0],["أم عَلَينا جُرّى حَنيفَةَ أَو ما","جَمَّعَت مِن مُحارِبٍ غَبراءُ",3,"ا",2,0],["أَم عَلَينا جَرّى العِبادُ كَما ني","طَ بِجَوزِ المَحمَلِ الأَعباءُ",3,"ا",2,0],["أَم عَلَينا جَرّى قُضاعَةَ أَم لَي","سَ عَلَينا مِمّا جَنوا أَنداءُ",3,"ا",2,0],["أَم عَلَينا جَرّى إِيادٍ كَما قي","لَ لِطَسمٍ أَخوكُم الأَبّاءُ",3,"ا",2,0],["أَمُعْمِلَهَا فِي حَوْمَةِ الْجُودِ غَارَةً","تَأَزَّرَ فِيهَا النَّصْرُ وَاسْتَبْحَرَ الْغُنْمُ",4,"م",1,0],["أمُعَلِّلي بمَطامِعٍ منْ دونِها","قطْعُ النّفوسِ مراحِلَ الأعْمارِ",5,"ر",1,0],["أَم عَلى العَهدِ فَعِلمي أَنَّهُ","خَيرُ مَن رَوَّحَ مالاً وَسَرَح",6,"ح",1,0],["أَمعَنَ التَقليدُ فيها فَغَدَت","لا تَرى إِلّا بِعَينِ الكُتُبِ",7,"ب",1,0],["أَم عَلى الأَزرارِ مِن حُلَّتها","بَدرُ تمٍّ في قَضيبٍ أَملَدِ",8,"د",1,0],["أَمُعْجِزَةَ البَيَانِ لَقَدْ أَرَانِي","أَسَاكَ اليَوْمَ مَعْجزَةَ البَيانِ",9,"ن",1,0],["أمع الذِلّة كِبر","أم مع الجبن جساره",10,"ر",2,0],["أمعيد سرح الملك يزهى شأنه","من بعدِ ما مرَّت عليه سنون",11,"ن",1,0],["أمعتصِمٌ بأنك ذو صِحابٍ","من الشعراء نصرُهُمُ قريبُ",12,"ب",1,0],["أم عَوارٌ فاحش مني بدا","وخلالُ الخير والشر لُمَع",13,"ع",1,0],["أمْ على أنَّني أمشي حسيراً","وأرى النَّاسَ كلَّهُمْ رُكْبانا",14,"ن",2,0],["أمْ على أنني ثكلتُ شقيقي","وعدِمْتُ الثَّراءَ والأوطانا",14,"ن",2,0],["أَمَعشَرَ قَيسٍ لَم يُمَتَّع أَخوكُمُ","عُمَيرٌ بِأَكفانٍ وَلا بِطَهورِ",15,"ر",1,0],["أَمَعشَرَ كَلبٍ لا تَكونوا كَأَنَّكُم","بِعَمياءَ مَسدودٍ عَلَيكُم سَبيلُها",16,"ل",3,0],["أَمَعشَرَ قَيسٍ طالَما قَد بَطِنتُمُ","مِنَ الخُبثِ فَاِطوُوا مِن بُطونِ الخَواصِرِ",17,"ر",1,0],["أَم عَزيز وَلِلبَعوضَةِ مِن خَدَّي","كَ قوت وَفي يَدَيكَ المُهَنَّد",18,"د",1,0],["أَمُعاشِرَ الإِفرَنجِ لَيسَ شَهامَةً","ما تَفعَلونَ إِذا أَمِنتُم عارا",19,"ر",2,0],["أَم عَقيقاً كَمُهجَتي يَتَلَظّى","وَالعَقيقُ الثَمينُ في شَفَتَيكِ",20,"ك",1,0],["أَمُعَذِّبي بِالهَجرِ هَل","لي فيكَ يَومٌ أَستَريحُه",21,"ح",2,0],["أمعتَضِداً بِاللَه دَعوَةَ آمِلٍ","رَجاكَ عَلى بُعدِ فَأَصبَح ذا قُربِ",22,"ب",1,1],["أمع المشانق رحمة ومودّة","ومع السياط صداقة ووفاء",23,"ا",2,0],["أُمَّ عَبّاسٍ وَما لي لَم أَقُل","أُمَّ مِصرَ مِن بَناتٍ وَبَنين",24,"ن",1,0],["أَمُعَلِّمي الوادي وَساسَةَ نَشئِهِ","وَالطابِعينَ شَبابَهُ المَأمولا",25,"ل",2,0],["أَمعَنتُما في العِزِّ وَاِستَعصَمتُما","هُوَ في السَحابِ وَأَنتِ في أَهليكِ",26,"ك",1,0],["أَمُعَفِّرَ اللَيثِ الهِزَبرِ بِسَوطِهِ","لِمَنِ اِدَّخَرتَ الصارِمَ المَصقولا",27,"ل",2,0],["أم عاق مسراكِ بيدٌ بات أرحُلُنا","يخفقنَ منهنَّ فيما بينَ أحضانِ",28,"ن",1,0],["أمعذَّبٌ والنارُ في عَذَباتِهِ","كمعذَّبٍ والنارُ في أحشائِهِ",29,"ا",3,0],["أَمَعشَرَ قَيسٍ قَيسِ عَيلانَ إِنَّكُم","حُماةُ الوَغى يَومَ الوَغى وَمَساعِرُه",30,"ر",2,0],["أَمُعَنِّفي إنْ زِدْتَ في التَّعْنيفِ","فاردُدْ سَوابِقَ دَمْعيَ المَذروفِ",31,"ف",1,1],["أَمْ عارِضٌ لا يَزالُ مُعْتَرِضاً","يَصْدَعُ أَحشايَ كلَّما انصَدَعا",32,"ع",2,0],["أم عن محاجرِ رَبرَبٍ","كشَفَتْ لنا تلك المَعاجِر",33,"ر",1,0],["أَمَعَ المَماتِ يَطيبُ عَيشُكَ يا أَخي","هَيهاتَ لَيسَ مَعَ المَماتِ يَطيبُ",34,"ب",1,0],["أم عن قساوةِ هاجرٍ","في الناعِمينَ مدلّلِ",35,"ل",1,0],["أم عروسٌ فوق كرسيِّ يدي","يجتليها اللهوُ في عقدِ الحبب",36,"ب",1,0],["أَم عَدُوٌّ يَمشي بِزورٍ وَإِفكٍ","كاشِحٌ دَبَّ بِالنَميمَةِ لَمّا",37,"م",2,0],["أَمُعاوِدَ الأَوطانِ بَعدَ فِراقِها","أَنَوَيتَ إِلّا فُرقَةً وَرَحيلا",38,"ل",2,0],["أمَعَ الصُّبحِ للنجومِ تَجَلٍّ","أمْ مع الشمسِ للظلامِ بَقاءُ",39,"ا",2,0],["أَمُعَنَّفِي أَنِّي أُطِيلُ مَدِيحَهُ","مَنْ عَدَّ مَوجَ البَحرِ عَدَّ طَوِيلا",40,"ل",2,0],["أمُعِزَّ أنصارِ المُعزّ من الوَرَى","والمُنزِلُ النُّصّابَ دارَ هَوانِ",41,"ن",1,0],["أمُعِزَّ دينِ اللّه إنّ زمانَنا","بكَ فيه بَأوٌ جَلَّ واستكبار",42,"ر",1,0],["أَم عارِضٌ بِرِدٌ بِالماءِ يُخمِدُها","حَتّى يُنَشنِشَها شُؤبوبُهُ البَرَدُ",43,"د",1,0],["أُمَّ عَمروٍ ما زالَ حُبُّكِ يَغتا","لُ عَزائي حَتّى اِفتَضَحتُ اِفتِضاحا",44,"ح",2,0],["أَمُعطِيَّ الجَزيلِ بِلا اِمتِنانٍ","بِهِ أَم مَن أَفَدتُ بِهِ الجَزيلا",45,"ل",2,0],["أمْ على النيل ضِفافاً وعُبابا","لمحَتْ عيناكَ للمجدِ سرابا",46,"ب",2,0],["أم عاشقان تُرى أم زائران هما","وهل مع الفجر عشَّاقٌ وزوَّارُ",47,"ر",1,0],["أمُعاتِبي في الهَجْرِ إنْ جارَيْتَني","طَلَقَ الجِدالِ وُجِدتَ عَينَ الظالمِ",48,"م",1,1],["أَمُعِيدَ هَذا الشَّرْقِ بَعدَ سَحَابَةٍ","غشِيَتْهُ دهْراً مَصْدَرَ الأَنْوَارِ",49,"ر",1,0],["أَمُعَلِّمُ النَّاسِ الشَّجَاعَةَ يَغْتَدِي","فِي مِصْرَ وَهْوَ مُعَلِّمُ الأَوْجَالِ",50,"ل",1,0],["أَمُعْرِضٌ أَنْتَ عَنْ الشِّعْرِ يَا","مَنْ شِعْرُه هَذَا فَمَا تَتَّقِي",51,"ق",2,0],["أَمْعنَ فِي كُلِّ مَا تَوَخَّى","إِلى نِهَايَاتِ مَا اسْتُطِيعَا",52,"ع",2,0],["أَمُعِيدَ الاِسْتِقلالِ مُكْتَمِلاً إِلى","بَلدٍ أَبَى الضَّيْمَ المُذِلَّ فَثَارَا",53,"ر",2,1],["أَمَعلولاً بِعَبرَتِهِ عَليلا","لَحاهُ عَلى البُكا لاح صَحيحُ",54,"ح",1,0],["أمعلِّمي الوادي، إذا حدَّثْتُمُو","نَشْءَ البلاد الغَضَّ عن أبطالِهِ",55,"ل",2,0],["أم علينا جرى إيادٍ كما ني","ط بجوز المحمل الأعباء",56,"ا",2,0],["أم علينا جرى حنيفة أم ما","جمعت من محاربٍ غبراء",56,"ا",2,0],["أم علينا جرى قضاعة أم لي","س علينا فيما جنوا أنداء",56,"ا",2,0],["أمعانياً حاولتَ تَنْظِمُها","تختارُ ما تَهْوى وتَبْتَكِر",57,"ر",1,0],["أمّ عُقَيلٌ، فما عنْ ظُلمها عُقُلٌº","تلك الصريراتُ، فيهم، ضاعت الصُّرر",58,"ر",1,0],["أم عافكم عنا كما","قد عافنا عنكم كِبرْ",59,"ر",1,0],["أَمُعيبُ شعري كُفَّ قولك وارعوى","ألا تُصيبُكَ شِدَّةٌ بقضائى",60,"ا",2,0],["أم عِشتَ في ظِلٍّ من الغابِ لم","تُشرِق عليه الشمسُ منذُ القِدَم",61,"م",1,0],["أَمَعشَرَ مَن يَبكي لِفَقدِ حَبيبِهِ","ضَعوا عَنكُمُ الأَوزارَ إِنلُذتُم بِهِ",62,"ه",1,0],["أَمْعَنْتُ فِيهَا بَصِيرَتِي فَبِهَا","أَيْقَنْتُ أَنَّ المُنَى ارْتَقَتْ وَحْيَا",63,"ي",2,0],["أَم عَبيدٌ لِراشدٍ ولِموسى","أَيُّ هذي الأَصنافِ أَنتُم فَقولوا",64,"ل",3,0],["أَم عَنِ البَدرِ تَسَرّى","موهِناً ذاكَ النَصيفُ",65,"ف",1,0],["أَم عَلى ليتَي غَزالٍ","عُلِّقَت تِلكَ الشُنوفُ",65,"ف",1,0],["أَم عمارَةُ السُوقِ الَّتي صَغَّرَت","سوق ثُلثا بغدادَ في بَغدادِ",66,"د",1,0],["أمعذبي كيف استطعت على الأذى","جلداً وأجزع ما يكون الريم",67,"م",1,0],["أَمُعيرَ بدرِ التِّمِّ وجها والظِّبا","حَدَقا وأغصانِ الرياضِ قُدودا",68,"د",2,1],["امعنفي عني اليك فانني","خلفي بغير الحب لا اتخلف",69,"ف",1,0],["أَم عَلى وَجنَتَيكِ ظِلُّ الخَطايا","مِن بَغِيٍّ أَتى إِلَيكِ يَتوبُ",70,"ب",1,0],["أَم عِقاب لما تَسَّحقَّ مِن حُ","بّيَ في لِذَّتي وَفي أَشواقي",71,"ق",2,0],["أَمَعروفٌ شَطرٌ مِن فُؤادي أَذَبتَه","وَكم مَرَّةً ذَوَّبتَ قَلبِيَ في سَطرِ",72,"ر",1,0],["أمَعْشَرَ أهْلِ الأرْضِ بالطولِ والعرْضِ","بهذا أُنادِي في القِيامَةِ والعَرْضِ",73,"ض",1,1],["أم عائد زمني بأجدر تربة","بالقصد في أكناف خير جدار",74,"ر",1,0],["أَم عادَةٌ عِندَكِ في دينِ الهَوى","أَن لا يُبالي راقِدٌ بِساهِرِ",75,"ر",1,0],["أمعذبي وعذوبة الثغر الذي","أحرمتنيه يقنع المحروما",76,"م",2,1],["أمعللى منه بوعد وصاله","هل كان ذا روح فمات الموعد",77,"د",1,0],["أمعاقبي بجميع ما حاسبتني","دعني يحاسبني النهي ويعاقب",78,"ب",1,0],["أَمُعَذِّبِي بِالنّارِ سَلْ بِجَوانِحِي","عِنْدِي مِنَ الزَّفَراتِ ما يَكْفِينِي",79,"ن",2,1],["أَمُعتَمَدَ المُلكِ قَد ضَمَّني ال","خُمولُ كَما ضَمَّ لَحماً وَضَم",80,"م",1,0],["أم عادة الأيام تبدي شهرة","في كل يوم قيل في اليوم عيد",81,"د",1,0],["أَمَعادُ هَل يُفضي إليكِ مَعادي","يَوماً برغم مُعاندٍ ومُعادِ",82,"د",1,1],["أَمعلنَ النَوح في أَغصانِه شجناً","خفِّض عليك فقد أَودى بك الشجنُ",83,"ن",1,1],["أَمعيرَ الظُبى شباً وَغِرارا","لحظُهُ والظِبا رَناً واِحوِرارا",84,"ر",2,0],["أَم عَذولي بِتَرك ودّيَ أَغراه","أَرسل اللَهُ لِلعَذول نكالا",85,"ل",2,0],["أَمُعيرُ قَولي أنت سَمْعَك ساعةً","كَرماً فاذكُرْ إن رأَيْتَ فُضولا",86,"ل",2,0],["أَمُعتَقِدٌ أَنَّ القُلوبَ صَحيحَةً","فَسَل نَظَرَ الأَقوامِ مالَكَ تَمرَضُ",87,"ض",1,0],["أمعَنتَ في طلبِ العُلى فحويتَها","وأتيتَ مُعتَذِراً كمَن لم يُمعِنِ",88,"ن",1,1],["أم عِقد مدحٍ فيه عَقدُ أليَّتي","قسماً وقد كان اليمين غموسا",89,"س",2,0],["أَمع التَبصبص لِلكِلاب تَكبر","غَير التَبَختُر مَشية المَهزوم",90,"م",1,0],["أَمعذبي قَد مَلَّ طَو","ق الأَسر مِن نَحر الأَسير",91,"ر",1,0],["أَمعذب الصَب العَليل","بِصَدِهِ وَمَلالِهِ",92,"ل",2,0],["أم عيون للنرجس الغض تسري","بالعيون الكحيلة البابليه",93,"ي",2,0],["أم عندكم عثمان أضحى قتله","شيئاً مباحاً إن ذا تمويه",94,"و",3,0],["أم عين حاسدنا أصيبت بالعمى","نظرت فصارت حسرة تتلهف",95,"ف",1,0],["أمعنِّفَ المشتاق في أشجانه","إيَّاك تعذل بالهوى مستغربا",96,"ب",2,0],["أمْعِنْ بدقَّة معنى ذاته نظراً","وانظر بعينيك واستغن عن الخبر",97,"ر",1,0],["أمُعَذِّبي من غير ذنبٍ","صَبوةً وجوًى وصدَّا",98,"د",2,0],["أمعلّلي بحديثه كرماً","حَدِّثْ ولا حرج عن البحر",99,"ر",1,0],["أم عهودٌ قد أَضْحَكَ الدهرُ فيها","مَبْسِمَ الزهرِ حين أَبْكَى العِهادا",100,"د",2,0],["أمعروف قد واسيت قلب المتيم","وداويت جرحا فت مهجة مريم",101,"م",1,1],["أمعذبي بدلاله ومنعمي","بجماله وبهائه المشهود",102,"د",1,0],["أمعاهدَ الأحباب دُمْتِ كعهدنا","ريّا المزاهر تُمطَري وترَاحِي",103,"ح",2,0],["أم عبقرية تمثيل خصصت به","حتى تعدد في ألوان إيحاء",104,"ا",2,0],["أم عند تلك العيونِ المتبِلات لنا","دمٌ على أسهم الرامين محظورُ",105,"ر",1,0],["أم عند ليلاتي الطِّوالِ ببابلٍ","من ردّ أيّامي القصارِ بحاجرِ",106,"ر",1,0],["أمعترِضٌ صدودُكِ أمَّ سعدٍ","ببعض الشرِّ أم خُلُقٌ وعادُ",107,"د",1,0],["أمِعي هزيلاً ثم أن","ت عليَّ إن أُعطيتَ نَفْجا",108,"ج",2,0],["أمعجل الآمال في إحسانه","ومخجل اللؤماء والبخال",109,"ل",1,0],["أمعّنى فيمن هويتُ جهالةً","انظر بعين العدل فيمن تعذلُ",110,"ل",1,1],["أمعنفَ المشتاق باح بشجوه","لولا دفيه غرامهِ ما أعلنا",111,"ن",2,0],["أم عليهِ تَرى الملاعِبَ أم لا","ما عليهِ أملَتْ ذبولُ البُرودِ",112,"د",1,0],["أمعفراً في الترب رهناً للبلى","حزني عليك مع الزمان طويل",113,"ل",1,0],["أمعتسف المهامه والموامي","على قلص سواهم كالسهام",114,"م",1,1],["أمعارف الدمن القفار توهم","وَلَقَد مَضى حَول لهنَّ مُجرَّم",115,"م",1,1],["أم عن إجَابةِ دَعوَتِي","يَا لَيتَ شِعرِي من نَهَاك",116,"ك",1,0],["أمُعَذِّباً بِحَديثهِ أفكارَنا","أشفِق عليها إنَّها أفكَارُ",117,"ر",1,0],["أَمُعتَقِلي رَيبُ المَنونِ وَلَم أَرُع","عَصافيرَ وادٍ بَينَ جَأشٍ وَمَأرِبِ",118,"ب",1,1],["أَمَعَ الأَعِنَّةَ تَمرَحينَ تَجاذُباً","وَعَلى الكَتيبَةِ شِدَّةُ التَصميمِ",119,"م",1,0],["أَمُعَنِّفِينَ عَلى الغَرَامِ وَقَلَّمَا","يُصْغِي لأَوْهَامِ العَوَاذِلِ هَائِمُ",120,"م",1,0]]}