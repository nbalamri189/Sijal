{"poems":[[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[53,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"نفحت فشبت لافح التذكار","https://www.aldiwan.net/poem36518.html","الكامل"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[86,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[82,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[93,"إذا ولى فتاك وأنت حي","https://www.aldiwan.net/poem11250.html","الوافر"],[88,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[72,"أرأيت نهج الحق كيف يبين","https://www.aldiwan.net/poem20170.html","الكامل"],[51,"أبا حسن وأنت فتى أديب","https://www.aldiwan.net/poem8181.html","الوافر"],[51,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[51,"أيها الحاسدي على صحبتي العسر","https://www.aldiwan.net/poem66408.html","الخفيف"],[29,"رأيت قريشا حين ميز بينها","https://www.aldiwan.net/poem6025.html","الطويل"],[29,"دنا البين من أروى فزالت حمولها","https://www.aldiwan.net/poem6159.html","الطويل"],[29,"لعمري لقد ناطت هوازن أمرها","https://www.aldiwan.net/poem6165.html","الطويل"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[91,"ما بالهم نقضوا العهود جهارا","https://www.aldiwan.net/poem8862.html","عموديه"],[91,"أي شيء في العيد أهدي إليك","https://www.aldiwan.net/poem9050.html","عموديه"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[78,"أمعتضدا بالله دعوة آمل","https://www.aldiwan.net/poem14066.html","الطويل"],[85,"شكرتك في أجداثها الشهداء","https://www.aldiwan.net/poem7258.html","الكامل"],[85,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[85,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[62,"ومروح سري سرور لقائه","https://www.aldiwan.net/poem52508.html","الكامل"],[45,"له الويل من ليل تطاول آخره","https://www.aldiwan.net/poem63564.html","الطويل"],[61,"أمعنفي إن زدت في التعنيف","https://www.aldiwan.net/poem51547.html","الكامل"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[61,"أعن الأهلة في الدياجر","https://www.aldiwan.net/poem51676.html","مجزوء الكامل"],[49,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[97,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[31,"أيها العاذل الذي لج في الهج","https://www.aldiwan.net/poem41330.html","الخفيف"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[50,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1238","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39643","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16670","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55069","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54838","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[46,"أسِيتُ، إذ غابتِ الأحجالُ والغُرَرُº","https://www.poetsgate.com/ViewPoem.aspx?id=20081",""]],"verses":[["أَمُعيني عَلى بُلوغِ الأَماني","وَشِفائي مِن عِلَّتي وَاِشتِياقي",0,"ق",2,0],["أَمُعَشِّرَ الأَحداثِ في أَذيالِها","ناجاكَ مَدحي وَالجُدودُ عَواثِرُ",1,"ر",1,0],["أَمَعاهِدَ الأَحبابِ هَل عَودٌ إِلى","مَغدىً نَبُلُّ بِهِ الجَوى وَمَراحِ",2,"ح",1,0],["أم عَلَينا جُرّى حَنيفَةَ أَو ما","جَمَّعَت مِن مُحارِبٍ غَبراءُ",3,"ا",2,0],["أَم عَلَينا جَرّى العِبادُ كَما ني","طَ بِجَوزِ المَحمَلِ الأَعباءُ",3,"ا",2,0],["أَم عَلَينا جَرّى قُضاعَةَ أَم لَي","سَ عَلَينا مِمّا جَنوا أَنداءُ",3,"ا",2,0],["أَم عَلَينا جَرّى إِيادٍ كَما قي","لَ لِطَسمٍ أَخوكُم الأَبّاءُ",3,"ا",2,0],["أَمُعْمِلَهَا فِي حَوْمَةِ الْجُودِ غَارَةً","تَأَزَّرَ فِيهَا النَّصْرُ وَاسْتَبْحَرَ الْغُنْمُ",4,"م",1,0],["أمُعَلِّلي بمَطامِعٍ منْ دونِها","قطْعُ النّفوسِ مراحِلَ الأعْمارِ",5,"ر",1,0],["أَم عَلى العَهدِ فَعِلمي أَنَّهُ","خَيرُ مَن رَوَّحَ مالاً وَسَرَح",6,"ح",1,0],["أَمعَنَ التَقليدُ فيها فَغَدَت","لا تَرى إِلّا بِعَينِ الكُتُبِ",7,"ب",1,0],["أَم عَلى الأَزرارِ مِن حُلَّتها","بَدرُ تمٍّ في قَضيبٍ أَملَدِ",8,"د",1,0],["أَمُعْجِزَةَ البَيَانِ لَقَدْ أَرَانِي","أَسَاكَ اليَوْمَ مَعْجزَةَ البَيانِ",9,"ن",1,0],["أمع الذِلّة كِبر","أم مع الجبن جساره",10,"ر",2,0],["أمعيد سرح الملك يزهى شأنه","من بعدِ ما مرَّت عليه سنون",11,"ن",1,0],["أمعتصِمٌ بأنك ذو صِحابٍ","من الشعراء نصرُهُمُ قريبُ",12,"ب",1,0],["أم عَوارٌ فاحش مني بدا","وخلالُ الخير والشر لُمَع",13,"ع",1,0],["أمْ على أنَّني أمشي حسيراً","وأرى النَّاسَ كلَّهُمْ رُكْبانا",14,"ن",2,0],["أمْ على أنني ثكلتُ شقيقي","وعدِمْتُ الثَّراءَ والأوطانا",14,"ن",2,0],["أَمَعشَرَ قَيسٍ لَم يُمَتَّع أَخوكُمُ","عُمَيرٌ بِأَكفانٍ وَلا بِطَهورِ",15,"ر",1,0],["أَمَعشَرَ كَلبٍ لا تَكونوا كَأَنَّكُم","بِعَمياءَ مَسدودٍ عَلَيكُم سَبيلُها",16,"ل",3,0],["أَمَعشَرَ قَيسٍ طالَما قَد بَطِنتُمُ","مِنَ الخُبثِ فَاِطوُوا مِن بُطونِ الخَواصِرِ",17,"ر",1,0],["أَم عَزيز وَلِلبَعوضَةِ مِن خَدَّي","كَ قوت وَفي يَدَيكَ المُهَنَّد",18,"د",1,0],["أَمُعاشِرَ الإِفرَنجِ لَيسَ شَهامَةً","ما تَفعَلونَ إِذا أَمِنتُم عارا",19,"ر",2,0],["أَم عَقيقاً كَمُهجَتي يَتَلَظّى","وَالعَقيقُ الثَمينُ في شَفَتَيكِ",20,"ك",1,0],["أَمُعَذِّبي بِالهَجرِ هَل","لي فيكَ يَومٌ أَستَريحُه",21,"ح",2,0],["أمعتَضِداً بِاللَه دَعوَةَ آمِلٍ","رَجاكَ عَلى بُعدِ فَأَصبَح ذا قُربِ",22,"ب",1,1],["أمع المشانق رحمة ومودّة","ومع السياط صداقة ووفاء",23,"ا",2,0],["أُمَّ عَبّاسٍ وَما لي لَم أَقُل","أُمَّ مِصرَ مِن بَناتٍ وَبَنين",24,"ن",1,0],["أَمُعَلِّمي الوادي وَساسَةَ نَشئِهِ","وَالطابِعينَ شَبابَهُ المَأمولا",25,"ل",2,0],["أَمعَنتُما في العِزِّ وَاِستَعصَمتُما","هُوَ في السَحابِ وَأَنتِ في أَهليكِ",26,"ك",1,0],["أَمُعَفِّرَ اللَيثِ الهِزَبرِ بِسَوطِهِ","لِمَنِ اِدَّخَرتَ الصارِمَ المَصقولا",27,"ل",2,0],["أم عاق مسراكِ بيدٌ بات أرحُلُنا","يخفقنَ منهنَّ فيما بينَ أحضانِ",28,"ن",1,0],["أمعذَّبٌ والنارُ في عَذَباتِهِ","كمعذَّبٍ والنارُ في أحشائِهِ",29,"ا",3,0],["أَمَعشَرَ قَيسٍ قَيسِ عَيلانَ إِنَّكُم","حُماةُ الوَغى يَومَ الوَغى وَمَساعِرُه",30,"ر",2,0],["أَمُعَنِّفي إنْ زِدْتَ في التَّعْنيفِ","فاردُدْ سَوابِقَ دَمْعيَ المَذروفِ",31,"ف",1,1],["أَمْ عارِضٌ لا يَزالُ مُعْتَرِضاً","يَصْدَعُ أَحشايَ كلَّما انصَدَعا",32,"ع",2,0],["أم عن محاجرِ رَبرَبٍ","كشَفَتْ لنا تلك المَعاجِر",33,"ر",1,0],["أَمَعَ المَماتِ يَطيبُ عَيشُكَ يا أَخي","هَيهاتَ لَيسَ مَعَ المَماتِ يَطيبُ",34,"ب",1,0],["أم عن قساوةِ هاجرٍ","في الناعِمينَ مدلّلِ",35,"ل",1,0],["أم عروسٌ فوق كرسيِّ يدي","يجتليها اللهوُ في عقدِ الحبب",36,"ب",1,0],["أَم عَدُوٌّ يَمشي بِزورٍ وَإِفكٍ","كاشِحٌ دَبَّ بِالنَميمَةِ لَمّا",37,"م",2,0],["أَمُعاوِدَ الأَوطانِ بَعدَ فِراقِها","أَنَوَيتَ إِلّا فُرقَةً وَرَحيلا",38,"ل",2,0],["أمَعَ الصُّبحِ للنجومِ تَجَلٍّ","أمْ مع الشمسِ للظلامِ بَقاءُ",39,"ا",2,0],["أَمُعَنَّفِي أَنِّي أُطِيلُ مَدِيحَهُ","مَنْ عَدَّ مَوجَ البَحرِ عَدَّ طَوِيلا",40,"ل",2,0],["أمُعِزَّ أنصارِ المُعزّ من الوَرَى","والمُنزِلُ النُّصّابَ دارَ هَوانِ",41,"ن",1,0],["أمُعِزَّ دينِ اللّه إنّ زمانَنا","بكَ فيه بَأوٌ جَلَّ واستكبار",42,"ر",1,0],["أَم عارِضٌ بِرِدٌ بِالماءِ يُخمِدُها","حَتّى يُنَشنِشَها شُؤبوبُهُ البَرَدُ",43,"د",1,0],["أُمَّ عَمروٍ ما زالَ حُبُّكِ يَغتا","لُ عَزائي حَتّى اِفتَضَحتُ اِفتِضاحا",44,"ح",2,0],["أَمُعطِيَّ الجَزيلِ بِلا اِمتِنانٍ","بِهِ أَم مَن أَفَدتُ بِهِ الجَزيلا",45,"ل",2,0],["أمْ على النيل ضِفافاً وعُبابا","لمحَتْ عيناكَ للمجدِ سرابا",46,"ب",2,0],["أم عاشقان تُرى أم زائران هما","وهل مع الفجر عشَّاقٌ وزوَّارُ",47,"ر",1,0],["أمُعاتِبي في الهَجْرِ إنْ جارَيْتَني","طَلَقَ الجِدالِ وُجِدتَ عَينَ الظالمِ",48,"م",1,1],["أَمُعِيدَ هَذا الشَّرْقِ بَعدَ سَحَابَةٍ","غشِيَتْهُ دهْراً مَصْدَرَ الأَنْوَارِ",49,"ر",1,0],["أَمُعَلِّمُ النَّاسِ الشَّجَاعَةَ يَغْتَدِي","فِي مِصْرَ وَهْوَ مُعَلِّمُ الأَوْجَالِ",50,"ل",1,0],["أَمُعْرِضٌ أَنْتَ عَنْ الشِّعْرِ يَا","مَنْ شِعْرُه هَذَا فَمَا تَتَّقِي",51,"ق",2,0],["أَمْعنَ فِي كُلِّ مَا تَوَخَّى","إِلى نِهَايَاتِ مَا اسْتُطِيعَا",52,"ع",2,0],["أَمُعِيدَ الاِسْتِقلالِ مُكْتَمِلاً إِلى","بَلدٍ أَبَى الضَّيْمَ المُذِلَّ فَثَارَا",53,"ر",2,1],["أَمَعلولاً بِعَبرَتِهِ عَليلا","لَحاهُ عَلى البُكا لاح صَحيحُ",54,"ح",1,0],["أمعلِّمي الوادي، إذا حدَّثْتُمُو","نَشْءَ البلاد الغَضَّ عن أبطالِهِ",55,"ل",2,0],["أم علينا جرى إيادٍ كما ني","ط بجوز المحمل الأعباء",56,"ا",2,0],["أم علينا جرى حنيفة أم ما","جمعت من محاربٍ غبراء",56,"ا",2,0],["أم علينا جرى قضاعة أم لي","س علينا فيما جنوا أنداء",56,"ا",2,0],["أمعانياً حاولتَ تَنْظِمُها","تختارُ ما تَهْوى وتَبْتَكِر",57,"ر",1,0],["أمّ عُقَيلٌ، فما عنْ ظُلمها عُقُلٌº","تلك الصريراتُ، فيهم، ضاعت الصُّرر",58,"ر",1,0]]}