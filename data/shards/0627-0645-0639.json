om/ViewPoem.aspx?id=197099",""],[5943,"أهلا سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=53799",""],[5956,"غروب حب","https://www.poetsgate.com/ViewPoem.aspx?id=182477",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[6317,"أ معلّمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86080&r=&rc=3",""]],"verses":[["أَمُعيني عَلى بُلوغِ الأَماني","وَشِفائي مِن عِلَّتي وَاِشتِياقي",0,"ق",2,0],["أَمُعَشِّرَ الأَحداثِ في أَذيالِها","ناجاكَ مَدحي وَالجُدودُ عَواثِرُ",1,"ر",1,0],["أَمَعاهِدَ الأَحبابِ هَل عَودٌ إِلى","مَغدىً نَبُلُّ بِهِ الجَوى وَمَراحِ",2,"ح",1,0],["أم عَلَينا جُرّى حَنيفَةَ أَو ما","جَمَّعَت مِن مُحارِبٍ غَبراءُ",3,"ا",2,0],["أَم عَلَينا جَرّى العِبادُ كَما ني","طَ بِجَوزِ المَحمَلِ الأَعباءُ",3,"ا",2,0],["أَم عَلَينا جَرّى قُضاعَةَ أَم لَي","سَ عَلَينا مِمّا جَنوا أَنداءُ",3,"ا",2,0],["أَم عَلَينا جَرّى إِيادٍ كَما قي","لَ لِطَسمٍ أَخوكُم الأَبّاءُ",3,"ا",2,0],["أَمُعْمِلَهَا فِي حَوْمَةِ الْجُودِ غَارَةً","تَأَزَّرَ فِيهَا النَّصْرُ وَاسْتَبْحَرَ الْغُنْمُ",4,"م",1,0],["أمُعَلِّلي بمَطامِعٍ منْ دونِها","قطْعُ النّفوسِ مراحِلَ الأعْمارِ",5,"ر",1,0],["أَم عَلى العَهدِ فَعِلمي أَنَّهُ","خَيرُ مَن رَوَّحَ مالاً وَسَرَح",6,"ح",1,0],["أَمعَنَ التَقليدُ فيها فَغَدَت","لا تَرى إِلّا بِعَينِ الكُتُبِ",7,"ب",1,0],["أَم عَلى الأَزرارِ مِن حُلَّتها","بَدرُ تمٍّ في قَضيبٍ أَملَدِ",8,"د",1,0],["أَمُعْجِزَةَ البَيَانِ لَقَدْ أَرَانِي","أَسَاكَ اليَوْمَ مَعْجزَةَ البَيانِ",9,"ن",1,0],["أمع الذِلّة كِبر","أم مع الجبن جساره",10,"ر",2,0],["أمعيد سرح الملك يزهى شأنه","من بعدِ ما مرَّت عليه سنون",11,"ن",1,0],["أمعتصِمٌ بأنك ذو صِحابٍ","من الشعراء نصرُهُمُ قريبُ",12,"ب",1,0],["أم عَوارٌ فاحش مني بدا","وخلالُ الخير والشر لُمَع",13,"ع",1,0],["أمْ على أنَّني أمشي حسيراً","وأرى النَّاسَ كلَّهُمْ رُكْبانا",14,"ن",2,0],["أمْ على أنني ثكلتُ شقيقي","وعدِمْتُ الثَّراءَ والأوطانا",14,"ن",2,0],["أَمَعشَرَ قَيسٍ لَم يُمَتَّع أَخوكُمُ","عُمَيرٌ بِأَكفانٍ وَلا بِطَهورِ",15,"ر",1,0],["أَمَعشَرَ كَلبٍ لا تَكونوا كَأَنَّكُم","بِعَمياءَ مَسدودٍ عَلَيكُم سَبيلُها",16,"ل",3,0],["أَمَعشَرَ قَيسٍ طالَما قَد بَطِنتُمُ","مِنَ الخُبثِ فَاِطوُوا مِن بُطونِ الخَواصِرِ",17,"ر",1,0],["أَم عَزيز وَلِلبَعوضَةِ مِن خَدَّي","كَ قوت وَفي يَدَيكَ المُهَنَّد",18,"د",1,0],["أَمُعاشِرَ الإِفرَنجِ لَيسَ شَهامَةً","ما تَفعَلونَ إِذا أَمِنتُم عارا",19,"ر",2,0],["أَم عَقيقاً كَمُهجَتي يَتَلَظّى","وَالعَقيقُ الثَمينُ في شَفَتَيكِ",20,"ك",1,0],["أَمُعَذِّبي بِالهَجرِ هَل","لي فيكَ يَومٌ أَستَريحُه",21,"ح",2,0],["أمعتَضِداً بِاللَه دَعوَةَ آمِلٍ","رَجاكَ عَلى بُعدِ فَأَصبَح ذا قُربِ",22,"ب",1,1],["أمع المشانق رحمة ومودّة","ومع السياط صداقة ووفاء",23,"ا",2,0],["أُمَّ عَبّاسٍ وَما لي لَم أَقُل","أُمَّ مِصرَ مِن بَناتٍ وَبَنين",24,"ن",1,0],["أَمُعَلِّمي الوادي وَساسَةَ نَشئِهِ","وَالطابِعينَ شَبابَهُ المَأمولا",25,"ل",2,0],["أَمعَنتُما في العِزِّ وَاِستَعصَمتُما","هُوَ في السَحابِ وَأَنتِ في أَهليكِ",26,"ك",1,0],["أَمُعَفِّرَ اللَيثِ الهِزَبرِ بِسَوطِهِ","لِمَنِ اِدَّخَرتَ الصارِمَ المَصقولا",27,"ل",2,0],["أم عاق مسراكِ بيدٌ بات أرحُلُنا","يخفقنَ منهنَّ فيما بينَ أحضانِ",28,"ن",1,0],["أمعذَّبٌ والنارُ في عَذَباتِهِ","كمعذَّبٍ والنارُ في أحشائِهِ",29,"ا",3,0],["أَمَعشَرَ قَيسٍ قَيسِ عَيلانَ إِنَّكُم","حُماةُ الوَغى يَومَ الوَغى وَمَساعِرُه",30,"ر",2,0],["أَمُعَنِّفي إنْ زِدْتَ في التَّعْنيفِ","فاردُدْ سَوابِقَ دَمْعيَ المَذروفِ",31,"ف",1,1],["أَمْ عارِضٌ لا يَزالُ مُعْتَرِضاً","يَصْدَعُ أَحشايَ كلَّما انصَدَعا",32,"ع",2,0],["أم عن محاجرِ رَبرَبٍ","كشَفَتْ لنا تلك المَعاجِر",33,"ر",1,0],["أَمَعَ المَماتِ يَطيبُ عَيشُكَ يا أَخي","هَيهاتَ لَيسَ مَعَ المَماتِ يَطيبُ",34,"ب",1,0],["أم عن قساوةِ هاجرٍ","في الناعِمينَ مدلّلِ",35,"ل",1,0],["أم عروسٌ فوق كرسيِّ يدي","يجتليها اللهوُ في عقدِ الحبب",36,"ب",1,0],["أَم عَدُوٌّ يَمشي بِزورٍ وَإِفكٍ","كاشِحٌ دَبَّ بِالنَميمَةِ لَمّا",37,"م",2,0],["أَمُعاوِدَ الأَوطانِ بَعدَ فِراقِها","أَنَوَيتَ إِلّا فُرقَةً وَرَحيلا",38,"ل",2,0],["أمَعَ الصُّبحِ للنجومِ تَجَلٍّ","أمْ مع الشمسِ للظلامِ بَقاءُ",39,"ا",2,0],["أَمُعَنَّفِي أَنِّي أُطِيلُ مَدِيحَهُ","مَنْ عَدَّ مَوجَ البَحرِ عَدَّ طَوِيلا",40,"ل",2,0],["أمُعِزَّ أنصارِ المُعزّ من الوَرَى","والمُنزِلُ النُّصّابَ دارَ هَوانِ",41,"ن",1,0],["أمُعِزَّ دينِ اللّه إنّ زمانَنا","بكَ فيه بَأوٌ جَلَّ واستكبار",42,"ر",1,0],["أَم عارِضٌ بِرِدٌ بِالماءِ يُخمِدُها","حَتّى يُنَشنِشَها شُؤبوبُهُ البَرَدُ",43,"د",1,0],["أُمَّ عَمروٍ ما زالَ حُبُّكِ يَغتا","لُ عَزائي حَتّى اِفتَضَحتُ اِفتِضاحا",44,"ح",2,0],["أَمُعطِيَّ الجَزيلِ بِلا اِمتِنانٍ","بِهِ أَم مَن أَفَدتُ بِهِ الجَزيلا",45,"ل",2,0],["أمْ على النيل ضِفافاً وعُبابا","لمحَتْ عيناكَ للمجدِ سرابا",46,"ب",2,0],["أم عاشقان تُرى أم زائران هما","وهل مع الفجر عشَّاقٌ وزوَّارُ",47,"ر",1,0],["أمُعاتِبي في الهَجْرِ إنْ جارَيْتَني","طَلَقَ الجِدالِ وُجِدتَ عَينَ الظالمِ",48,"م",1,1],["أَمُعِيدَ هَذا الشَّرْقِ بَعدَ سَحَابَةٍ","غشِيَتْهُ دهْراً مَصْدَرَ الأَنْوَارِ",49,"ر",1,0],["أَمُعَلِّمُ النَّاسِ الشَّجَاعَةَ يَغْتَدِي","فِي مِصْرَ وَهْوَ مُعَلِّمُ الأَوْجَالِ",50,"ل",1,0],["أَمُعْرِضٌ أَنْتَ عَنْ الشِّعْرِ يَا","مَنْ شِعْرُه هَذَا فَمَا تَتَّقِي",51,"ق",2,0],["أَمْعنَ فِي كُلِّ مَا تَوَخَّى","إِلى نِهَايَاتِ مَا اسْتُطِيعَا",52,"ع",2,0],["أَمُعِيدَ الاِسْتِقلالِ مُكْتَمِلاً إِلى","بَلدٍ أَبَى الضَّيْمَ المُذِلَّ فَثَارَا",53,"ر",2,1],["أَمَعلولاً بِعَبرَتِهِ عَليلا","لَحاهُ عَلى البُكا لاح صَحيحُ",54,"ح",1,0],["أمعلِّمي الوادي، إذا حدَّثْتُمُو","نَشْءَ البلاد الغَضَّ عن أبطالِهِ",55,"ل",2,0],["أمعنت في هذي الصروف بصيرتي","وسبرت ما تقضيه بالمسبار",56,"ر",1,0],["أم علينا جرى إيادٍ كما ني","ط بجوز المحمل الأعباء",57,"ا",2,0],["أم علينا جرى حنيفة أم ما","جمعت من محاربٍ غبراء",57,"ا",2,0],["أم علينا جرى قضاعة أم لي","س علينا فيما جنوا أنداء",57,"ا",2,0],["أمعانياً حاولتَ تَنْظِمُها","تختارُ ما تَهْوى وتَبْتَكِر",58,"ر",1,0],["أمّ عُقَيلٌ، فما عنْ ظُلمها عُقُلٌº","تلك الصريراتُ، فيهم، ضاعت الصُّرر",59,"ر",1,0],["أم عقوق وبئس الأم تحضننا","على غذاء سموم من أفاعيها",60,"ي",3,0],["أم عافكم عنا كما","قد عافنا عنكم كِبرْ",61,"ر",1,0],["أَمُعيبُ شعري كُفَّ قولك وارعوى","ألا تُصيبُكَ شِدَّةٌ بقضائى",62,"ا",2,0],["أم عِشتَ في ظِلٍّ من الغابِ لم","تُشرِق عليه الشمسُ منذُ القِدَم",63,"م",1,0],["أَمَعشَرَ مَن يَبكي لِفَقدِ حَبيبِهِ","ضَعوا عَنكُمُ الأَوزارَ إِنلُذتُم بِهِ",64,"ه",1,0],["أَمْعَنْتُ فِيهَا بَصِيرَتِي فَبِهَا","أَيْقَنْتُ أَنَّ المُنَى ارْتَقَتْ وَحْيَا",65,"ي",2,0],["أَم عَبيدٌ لِراشدٍ ولِموسى","أَيُّ هذي الأَصنافِ أَنتُم فَقولوا",66,"ل",3,0],["أَم عَنِ البَدرِ تَسَرّى","موهِناً ذاكَ النَصيفُ",67,"ف",1,0],["أَم عَلى ليتَي غَزالٍ","عُلِّقَت تِلكَ الشُنوفُ",67,"ف",1,0],["أَم عمارَةُ السُوقِ الَّتي صَغَّرَت","سوق ثُلثا بغدادَ في بَغدادِ",68,"د",1,0],["أمعذبي كيف استطعت على الأذى","جلداً وأجزع ما يكون الريم",69,"م",1,0],["أَمُعيرَ بدرِ التِّمِّ وجها والظِّبا","حَدَقا وأغصانِ الرياضِ قُدودا",70,"د",2,1],["امعنفي عني اليك فانني","خلفي بغير الحب لا اتخلف",71,"ف",1,0],["أَم عَلى وَجنَتَيكِ ظِلُّ الخَطايا","مِن بَغِيٍّ أَتى إِلَيكِ يَتوبُ",72,"ب",1,0],["أَم عِقاب لما تَسَّحقَّ مِن حُ","بّيَ في لِذَّتي وَفي أَشواقي",73,"ق",2,0],["أَمَعروفٌ شَطرٌ مِن فُؤادي أَذَبتَه","وَكم مَرَّةً ذَوَّبتَ قَلبِيَ في سَطرِ",74,"ر",1,0],["أمَعْشَرَ أهْلِ الأرْضِ بالطولِ والعرْضِ","بهذا أُنادِي في القِيامَةِ والعَرْضِ",75,"ض",1,1],["أم عائد زمني بأجدر تربة","بالقصد في أكناف خير جدار",76,"ر",1,0],["أَم عادَةٌ عِندَكِ في دينِ الهَوى","أَن لا يُبالي راقِدٌ بِساهِرِ",77,"ر",1,0],["أمعذبي وعذوبة الثغر الذي","أحرمتنيه يقنع المحروما",78,"م",2,1],["أمعللى منه بوعد وصاله","هل كان ذا روح فمات الموعد",79,"د",1,0],["أمعاقبي بجميع ما حاسبتني","دعني يحاسبني النهي ويعاقب",80,"ب",1,0],["أَمُعَذِّبِي بِالنّارِ سَلْ بِجَوانِحِي","عِنْدِي مِنَ الزَّفَراتِ ما يَكْفِينِي",81,"ن",2,1],["أَمُعتَمَدَ المُلكِ قَد ضَمَّني ال","خُمولُ كَما ضَمَّ لَحماً وَضَم",82