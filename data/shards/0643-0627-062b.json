{"poems":[[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[43,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[45,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[46,"تنكر صالح فضباب قيس","https://www.aldiwan.net/poem22866.html","الوافر"],[295,"يا هماما له المعالي قصور","https://www.aldiwan.net/poem33270.html","الخفيف"],[429,"ذكر الركب الذي نزحا","https://www.aldiwan.net/poem12393.html","المديد"],[456,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"]],"verses":[["كَأَثلٍ مِنَ الأَعراضِ مِن دونِ بَيشَةٍ","وَدونَ الغُمَيرِ عامِداتٍ لِغَضوَرا",0,"ر",2,0],["كاثَرَت نائِلَ الأَميرِ مِنَ الما","لِ بِما نَوَّلَت مِنَ الإيراقِ",1,"ق",1,0],["كاثَرتُهُ فَإِذا المُروءَةُ عِندَهُ","تُعدي المُفاوِضَ مِن أَقاصي صَحبِهِ",2,"ب",2,0],["كاثَرَت أُمُّهُ النُجومَ وَلَم تَر","ضَ بِضِعفٍ مِنها عِداداً بُعولَه",3,"ل",2,0],["كَآثارِ النَؤورِ لَهُ دُخانٌ","أُسِفَّ مُتونَ مُقتَرَحٍ رَصينِ",4,"ن",1,0],["كَأَثمارٍ وَما اِقتَرَشَت ذُنوباً","وَأَرماحُ التَنازُعِ في اِقتِراشِ",5,"ش",1,0],["كاثرَتني الخطوبُ والجَدُّكابٍ","وَقَليلٌ من الخطوب كَثيرُ",6,"ر",1,0],["كأَثافيها حمائِمُها","أَوَ لَيْسُوا بالنَّوى صُدُحا",7,"ح",2,0],["كاثرني بالنوال حتى","حبوتُ من فضل ما حباني",8,"ي",1,0]]}