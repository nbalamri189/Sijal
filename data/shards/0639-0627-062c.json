{"poems":[[55,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[102,"وجوه دخانية في مرايا الليل","https://www.aldiwan.net/poem24840.html","عموديه"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[95,"عاجت أصيلاً بالرياض تطوفها","https://www.aldiwan.net/poem11120.html","الكامل"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[58,"قالوا السلام عليك يا أطلال","https://www.aldiwan.net/poem58537.html","الكامل"],[68,"إني ليطربني العذول فأنثني","https://www.aldiwan.net/poem41355.html","الكامل"],[76,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[107,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[50,"عاج الشقي على دار يسائلها","https://www.aldiwan.net/poem62547.html","البسيط"],[50,"لله ما تصنع الأجياد والمقل","https://www.aldiwan.net/poem65573.html","البسيط"],[52,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54644","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54263","الكامل"],[47,"للهِ ما تَصْنَعُ الأَجْيادُ والمُقَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32071",""],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[190,"رحل الفريق فأسرعوا الوخدا","https://www.aldiwan.net/poem43881.html","الكامل"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[234,"أسهرني طول ليلتي رشا","https://www.aldiwan.net/poem51182.html","المنسرح"],[240,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[259,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[259,"قلب معذب","https://www.aldiwan.net/poem36216.html","مجزوء الرمل"],[280,"عاج له دهره فعاجله","https://www.aldiwan.net/poem25454.html","المنسرح"],[310,"الدهر حرب بالرزايا الفجع","https://www.aldiwan.net/poem56486.html","الكامل"],[374,"مات معز الدين من قبل أن","https://www.aldiwan.net/poem4301.html","السريع"],[402,"عاجت أصيلا بالرياض تطوفها","https://www.aldiwan.net/poem10987.html","عموديه"],[411,"عاجلت ثوب علاك بالتوسيخ","https://www.aldiwan.net/poem50011.html","الكامل"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[466,"يشرق النادي إذا حل به","https://www.aldiwan.net/poem16150.html","الرمل"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[510,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[510,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[534,"ربنا أنفذ بي الحق","https://www.aldiwan.net/poem37111.html","مجزوء الكامل"],[556,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[563,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110380","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63789","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70827","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70913","المجتث"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115914","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107306","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11986","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49566","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101030","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108461","الخفيف"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115415","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200004","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99474","السريع"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120161","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104385","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62829","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48432","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132021","الرمل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32674","البسيط"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130556","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111198","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111190","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[242,"حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","https://www.poetsgate.com/ViewPoem.aspx?id=38124",""],[5277,"مهرةٌ بلا فارس..","https://www.poetsgate.com/ViewPoem.aspx?id=206839",""],[5277,"دموعٌ في مكاحلِ الزمن..","https://www.poetsgate.com/ViewPoem.aspx?id=210585",""],[5409,"هكذا من حقه من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5463,"قصه كذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25529",""],[5725,"النار في جسدي","https://www.poetsgate.com/ViewPoem.aspx?id=201832",""],[5781,"أناقة العشق...وتصبُّري","https://www.poetsgate.com/ViewPoem.aspx?id=210380",""],[6068,"عاجلتها بالشوق حتى كرهتها -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175881",""],[6294,"هل لامسّت معطفها ! ! !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69183&r=&rc=24",""]],"verses":[["عاجَلَ أَدواءِ العُروقِ فَحَسَم","حَثحَثَةَ الذِئبِ عَوى مِنَ القَرَم",0,"م",1,0],["عاجن الفرن … أتدري ؟ سنة","وأنا أعجن أحزاني وغمي",1,"م",2,0],["عاجَلَتْني بهِ وفي الوقْتِ فَضْلٌ","لاهتِزازي الى الهَوى وارتِياحي",2,"ح",2,0],["عَاجَتْ أَصِيلاً بِالرِّيَاضِ تَطُوفُهَا","كَمَلِيكَةٍ طَافَتْ مَعاهِدَ حُكْمِهَا",3,"م",3,1],["عاجزٌ واهنُ القُوى يتعاطى","صبغةَ اللَّه في قناع المشيبِ",4,"ب",1,0],["عاج بنا مائلاً إلى حِلَلٍ","قصورِ مُلكٍ له تخيرها",5,"ر",3,0],["عاج الشقيُّ مُرادُهُ دِمَنُ البِلَى","ومُرادُ عيني قُلّةٌ وحِجالُ",6,"ل",1,0],["عاجَلتُهُ حَذَراً عَليهِ مِنَ الرَدى","عَجَلَ الجُفونِ إِلى حِفاظِ الأَعيُنِ",7,"ن",1,0],["عاجَ الرَجاءُ عَلى عُلاكَ بِهِ فَلَم","يَعُجِ المَطِيَّ بِرَسمِ رَبعٍ دارِسِ",8,"س",1,0],["عاجلت بعلَها اغتيالاً فما تب","صرُ إلا البُعولَ تَردِي عِجالا",9,"ل",2,0],["عاجَ الشَقِيُّ عَلى دارٍ يُسائِلُها","وَعُدتُ أَسأَلُ عَن خَمّارَةِ البَلَدِ",10,"د",1,1],["عاجِل بِنا الرَحَ وَالرَيحانَ مُبتَكِراً","فَلَيسَ يَحسُنُ إِلّا فيهِما العَجَلُ",11,"ل",1,0],["عاجِلاً قَبلَ أَن أَرى","فيكُمُ لينَ جانِبِ",12,"ب",1,0],["عاجزةَ الباع ويأبى الزوال","لوردةٍ من عَدن أن تذبلا",13,"ل",2,0],["عَاجلَهُ البَيْنُ فَوَلّى وَلَمْ","يَزِنْهُ مِنْ بَعْدِ الشَّبَابِ المَشِيبْ",14,"ب",1,0],["عَاج الْخَيالُ فلم يَبُلَّ أُوَامَا","ومَضَى وخَلَّفَ في الضلُوعِ ضِرامَا",15,"م",2,1],["عَاجلْ بنَا الرَّاحَ والرَّيْحانَ مُبْتَكِراً","فَلَيْسَ يَحسُنُ إِلاَّ فِيهمَا العَجَلُ",16,"ل",1,0],["عاجلت أحلام الدّجى فطويتها","والرّوح ترشف ثغرها المعسولا",17,"ل",2,0],["عاجز الرأي والمروءة والنف","س ضئيل الآمال والأهواء",18,"ا",2,0],["عاجَمتُ أَيّامي وَما الغِرُّ كَمَن","تَأَزّرَ الدَهرُ عَلَيهِ وَاِرتَدى",19,"ا",1,0],["عاجمت أيامي وقد عاجمنني","فتركتهنّ عواريا جردا",20,"د",2,0],["عاجلته ضربة في الرأس دامغة","أقعى لها وهو بالأمشاج ملدود",21,"د",1,0],["عاجِزاً عن أقلّه الثقلانِ","وَلهُ البدرُ شقَّ فهو اِثنانِ",22,"ن",1,0],["عاجَتْ على عاج خدّه ظُلَمٌ","كأنها الليلُ فوق إصباحِهْ",23,"ح",2,0],["عاجَلتَ أَهلَ البَغي حينَ تَجَمَّعوا","وَرَأَيتَهُم بِالرَأيِ كَيفَ تَفَرَّقوا",24,"ق",3,0],["عاجَلَتهُ بَهِمَّةٍ تَسَعُ الدُن","يا وَجَيشٍ يَضيقُ عَنهُ الفَضاءُ",25,"ا",2,0],["عاجزٌ عن كَفِّ دمعي","فمتى ينزاحُ كربي؟",26,"ب",2,0],["عاجز عن فهم دائي","مادرى من أين جاء!",27,"ا",2,0],["عَاجَ لَهُ دَهْرهُ فَعَاجَلَهُ","بِمُنكَرٍ مِنْ خُطُوبِهِ عَرَفَهْ",28,"ه",1,1],["عاجَلتَنا وَعثيتَ فينا فاِتّئدِ","هَل بَعد مصرع بيرم من مصرعِ",29,"ع",1,0],["عاجله المقدارُ في نفسه","فابتزَّه من دون أترابه",30,"ب",2,0],["عاجت أصيلا بالرياض تطوفها","آمليكة طافت معاهد حكمها",31,"م",3,1],["عاجلْتَ ثَوبَ علاكَ بالتَّوسيخِ","وخدَجْتَ وجهَ رِضاكِ بالتَّوبيخِ",32,"خ",1,1],["عاجلننا بفراقهنَّ فُجاءَةَ","قَبلَ الصَباحِ وَناعب الغُربانِ",33,"ن",1,0],["عاجلْ بها جَدْعَ أنوفٍ طغتْ","وأرؤسٍ قد أينعتْ للحَصادْ",34,"د",1,0],["عاجلُ الزَّاد إذا عَزَّ القِرى","صادقُ الجودِ إذا الرَّعدُ كذَبْ",35,"ب",1,0],["عاجِزٌ والسَّعادَةُ اكْتَنَفَتْني","فدَعَتْني بالعارِفِ الأَحمَدِيِّ",36,"ي",1,0],["عاجِزٌ مُذنِبٌ كليلٌ كسولٌ","ذو انْحِطاطٍ عن همَّةِ العُظَماءِ",37,"ا",2,0],["عاجلاً أو اجلاً ستهبُّ","مِنْ ثناياهُ رياحُ الشمالِ",38,"ل",1,0],["عاجَلوكَ طفلاً وما صَبروا حت","تى تَلاقى فيْ فيكَ هاءٌ وميمُ",39,"م",1,0],["عَاجِلاً مِنْ غَيْرِ رَيْثٍ","يا مُجِيبَ السَّائِلينا",40,"ن",2,0],["عاجوا على ثَمدِ البِطاحِ وحُبّهمْ","أجرى العيونَ غداة بانوا أبحُرا",41,"ر",2,0],["عاجوا عَلَينا بالوَداعِ وليس لِي","صَبرٌ عليهِ فَلَيتَهمْ ما عاجوا",42,"ج",3,0],["عاجزة عنه تعالى فلا","تدرك منه غير تغييره",43,"ر",2,0],["عاجَ المتيَّمُ بالأطلالِ في العَلَمِ","فأبرَعَ الدَمعُ في استهلالِهِ العَرِمِ",44,"م",1,1],["عاجَلَ الدهرُ مستردًّا عطاهُ","وهو لا يستحي بردِّ النوالِ",45,"ل",1,0],["عاج بنا نحوها الخُمارُ وما","إِن زالَ ذا دأبَ كلِّ مخمور",46,"ر",1,0],["عاجز عن مراده وهْو في العا","لم أردا طبعاً وأرغمُ أنفا",47,"ف",2,0],["عاجتْك نفسُك عن رُشْدها","وعاجَتْ جِمالَكْ",48,"ك",1,0],["عاجله ضربة براه بها","شطرين من بأسه وسطوته",49,"ت",2,0],["عاجَلتهُ المنيَّةُ إذ تَمَّ بدراً","ومع التِّمِّ تُكسَفُ الأقمارُ",50,"ر",1,0],["عاجلت قلبي عن التحفظ في","أمري برهز كالبرق مشتعل",51,"ل",1,0],["عاجِلاً أو لا فَزُرنِي","يا حَبيبي لَو مَناما",52,"م",2,0],["عاجَلتَهُم فَتَرَكتَ الخَيلَ خالِيَةً","مِنهُم وَقَد خُلِقَ الإِنسانُ مِن عَجَلِ",53,"ل",1,0],["عاجَتْ عُلاهُ على القوافي عَوْجَةً","نَفَضَتْ رِمامَ رسُوْمِها الأدْرَاس",54,"س",1,0],["عاجله المقدار في لمحة","نرقب فيها بره عاجلا",55,"ل",2,0],["عاج الردى إن عجت المطى على","رسمٍ أسائلُ عن ه وعن مللِ",56,"ل",1,0],["عاجَلته المَنون كَهلاً وَأَبقَت","ثَلمة ما لسدِّها مِن سَبيلِ",57,"ل",1,0],["عاجلته رُسلُ المنية لما","طار صيتاً ونال ذكراً حميداً",58,"د",2,0],["عاجلتنا فأتاك عاجل برنا","قلا ولو أمهلتنا لم يقلل",59,"ل",1,1],["عاجز عن بيانها فأصيخوا","تسمعوا ما سمعته بالضمائر",60,"ر",1,0],["عاجية الشعر إذا استضحكت","أبدت ثنايا آبنوسيه",61,"ي",2,0],["عاجلت يا موت مولانا وسيدنا","تبّت يداك لقد أورثتنا العدمَ",62,"م",1,0],["عاجلته بمريج من بليّته","كمجدب جئته بالوابل الغدق",63,"ق",1,0],["عاجِرٍ ضاعَ عزمُه بينَ هَمَّيْ","ك وفوز الأسارِ والأطلاقِ",64,"ق",1,0],["عاجِزٌ عن شُكْرِه","كُلُّ ذي لفْظٍ نطَقْ",65,"ق",1,0],["عاجز منتفض من دائه","قد حماه أهله والأقربون",66,"ن",1,0],["عاجَت عَلَيها مَطايا الغَيثِ مُسبَلَةً","لَهُنَّ في ضَحِكّاتٍ أَدمُعٌ هُتُنُ",67,"ن",1,0],["عاجلتها بالمشرفية فانثنت","ميل الرقاب نواكس الأعلام",68,"م",1,0],["عاج بالكوفةِ ابتغاءَ صديقٍ","يختفي عندهُ من الأعداءِ",69,"ا",2,0],["عاجلته بالرمح ثم علوته","بالسيف يدمي غربه لم يثلم",70,"م",1,0],["عاجل بيومك من شرابك واطرح","ما أنت مستبق لنفسك في غد",71,"د",1,0],["عاجلُ الشَرِّ وَهوَ يَأمُرُ بِالخَي","رِ قَديرٌ لَم يَعفُ عَفوَ القَديرِ",72,"ر",1,0],["عَاجَلَهُ مِنَ الْهُمومِ بَعْثُ","سَيَّانِ فيهَا وَالْمَآلُ فَرْثُ",73,"ث",1,0],["عاجلتُها بالقولِ \" أيُّ مصيبةٍ","حَلّتْ عليكِ\" أسيرةَ الحرمانِ",74,"ن",1,0],["عاجوا وماجوا واسْتبيحَ ذمارُهم","ممّنْ به مسٌّ من الوسواسِ",75,"س",1,0]