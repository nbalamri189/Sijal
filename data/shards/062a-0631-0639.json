{"poems":[[110,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[55,"برقت بالوعد في دجى أملي","https://www.aldiwan.net/poem29937.html","المنسرح"],[55,"اذهب ولا تبعدن من رجل","https://www.aldiwan.net/poem30731.html","المنسرح"],[37,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[95,"يا من لها القصر المنيف","https://www.aldiwan.net/poem11092.html","مجزوء الكامل"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[31,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[40,"ومن يك باديا ويكن أخاه","https://www.aldiwan.net/poem7808.html","الوافر"],[87,"بأرض الجيزة اجتاز الغمام","https://www.aldiwan.net/poem8084.html","الوافر"],[87,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[45,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[64,"نغدو إليك إذا اعترتنا حاجة","https://www.aldiwan.net/poem52254.html","الكامل"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[47,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[30,"شعثا شوازب قد طوى أقرابها","https://www.aldiwan.net/poem5483.html","الكامل"],[63,"الكأس قطب السرور والطرب","https://www.aldiwan.net/poem51765.html","المنسرح"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[82,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[50,"لا يصرفنك عن قصف وإصباء","https://www.aldiwan.net/poem10400.html","البسيط"],[48,"يا ليل قد نام الشجي ولم ينم","https://www.aldiwan.net/poem22581.html","الكامل"],[48,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62208","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62233","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[47,"ما أنتَ، للكَلِفِ المَشُوقِ، بصَاحِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31560",""],[82,"وَرْدُ الخدودِ ونرّجسُ المُقَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=3528",""],[31,"هَبَطْنَ مُناخاً يَنْتَطِحْنَ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=17338",""],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[37,"غشيتُ لليلى بالبَرودِ مساكناً","https://www.poetsgate.com/ViewPoem.aspx?id=22022",""],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[118,"أيجحد من جلالتك السناء","https://www.aldiwan.net/poem41473.html","عموديه"],[131,"أهدى السلام إلى الكريم المفضل","https://www.aldiwan.net/poem50544.html","الكامل"],[145,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[158,"بدر تقنع بالظلام","https://www.aldiwan.net/poem55793.html","مجزوء الكامل"],[172,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[184,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[201,"يا برق نجد هل شعرت بمتهم","https://www.aldiwan.net/poem51892.html","الكامل"],[238,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[238,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[270,"لئن رحلت جملي إن لي سعة","https://www.aldiwan.net/poem1148.html",""],[274,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[278,"أشد بالقوافي ذكر علوة أو عليا","https://www.aldiwan.net/poem25451.html","الطويل"],[290,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[303,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[308,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[331,"لهف نفسي والمنايا تلتظى","https://www.aldiwan.net/poem55052.html","الرمل"],[356,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[366,"هل حبل شماء قبل البين موصول","https://www.aldiwan.net/poem1715.html","البسيط"],[382,"ترعى بخوين نجيلا غامدا","https://www.aldiwan.net/poem4542.html","الرجز"],[382,"ترعى سميراء إلى أرمامها","https://www.aldiwan.net/poem4582.html","الرجز"],[382,"ترعى الى جد لها مكين","https://www.aldiwan.net/poem4587.html","الرجز"],[403,"للحب قلب نابض","https://www.aldiwan.net/poem6705.html","عموديه"],[406,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[419,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[435,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[460,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[460,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[463,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[466,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[472,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[481,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[502,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[502,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[569,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18704","الطويل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2556","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18994","الطويل"]],"verses":[["ترعى بإدلاجها رسم السراة ولا","ترعى لمدلجها في السير ما رسموا",0,"م",3,0],["تُرعى الجَماجِمُ وَالجَميمُ إِزاءَها","وَدَمُ الطُلى بَدَلاً مِنَ الغُدرانِ",1,"ن",1,0],["تَرعى سَوامَ العَبيدِ هَيبَتُهُ","فَكَيفَ يَرضى وَذَودُهُ هَمَلُ",2,"ل",1,0],["تَرعِ العِدا عَن جَوانِبي بِيَدٍ","يَروعُ فيها النُضارُ وَالوَرَقا",3,"ق",2,0],["تَرعِيَّةٌ طاعَتِ الصِعابُ لَهُ","وَاِستَوسَقَت في زَمامِهِ العَرَبُ",4,"ب",1,0],["تَرَعّى بِهِ البَردَينِ ثُمَّ مَقِلُها","ذُرى تَأَوي إِليها الجآذِرُ",5,"ر",1,0],["تَرْعَاكِ عَيْنٌ لِلْعِنَا","يَةِ لا القَنَا وَالسُّمْهُرِيّ",6,"ي",1,0],["تُرْعَى لَهُ حُرْمَةٌ فِي كُلِّ مَنْزِلَةٍ","سَمَا إِلَيْهَا وَتُرْعَى عِنْدَهُ الْحُرَمُ",7,"م",1,0],["تَرعى وتمثُل في صِلاتِك تارةً","لمن احتباك فخلفُه لك يَمْثُلُ",8,"ل",1,0],["تَرعى بَحازِجُها خِلالَ رِياضِها","وَتَميسُ بَينَ سَباسِبٍ وَرِمالِ",9,"ل",1,0],["تَرَعّى مِن جُنوبِ ثُعالِباتٍ","أَسِرَّةَ عازِبٍ نَحَرَ الهِلالا",10,"ل",2,0],["تَرَعرَعَتِ الحَضارَةُ في حُلاهُ","وَشَبَّ عَلى جَواهِرِهِ النِظامُ",11,"م",1,0],["تُرعِشُ الأَيدي وَمَن يُر","عِش مِنَ الصُنّاعِ خابا",12,"ب",2,0],["تَرَعرَعَ المَلِكُ الأُستاذُ مُكتَهِلاً","قَبلَ اِكتِهالٍ أَديباً قَبلَ تَأديبِ",13,"ب",1,0],["ترعَى لمن غابَ الذمامَ مجاملاً","وتُنيلُ من حضَر الرغائبَ مُحسنا",14,"ن",2,0],["ترعَى إِذا غفلوا وتسهرُ إنْ","ناموا وتَحلم كلَّما جَهِلُوا",15,"ل",3,0],["تَرعى السُهُلَةَ وَالحُزونُ يَقينَها","حَدَّينِ بَينَ أَظافِرٍ وَمَخالِبِ",16,"ب",1,0],["تَرعى الزَعانِفَ حَولَنا بِقِيادِها","وَغُدُوُّهُنَّ مُرَوَّحَ التَشلالِ",17,"ل",1,0],["تَرْعُدُ أحشاؤه لديَّ كما","تَرْعُدُ أحشاءُ هائمٍ وَصِبِ",18,"ب",1,0],["تَرعى الصُروبَ بِكَفّيها وَأَرجُلِها","وَتَحفَظُ الأَصلَ مِن نَقصٍ وَتَغيِيرِ",19,"ر",1,0],["ترعى سجاياهُ من قُصّاده ذِمماً","وليس يَرْعى لمالٍ بَذْلُهُ ذِمَما",20,"م",2,0],["ترعَى الرسيمَ إلى الوجيفِ بنا","بَدَلاً من الحَوذانِ والنّفَلِ",21,"ل",1,0],["تَرعى أَزاهيرَ غيطانٍ وَأَودِيَةٍ","وَتَشرَبُ الصَفوَ مِن غُدرٍ وَأَحساءِ",22,"ا",2,0],["تَرعاهُ راعِيَةٌ وَتَهتِكُ بُردَهُ","أُخرى وَمِنهُ شَقائِقٌ وَبَهارُ",23,"ر",1,0],["تَرعى خوافي الرُّبْدِ في حَجَراتِها","سَغْباً وتَعْثُرُ بالغَطَاطِ النُّوَمِ",24,"م",1,0],["تَرَعَّى جَنَاباً طَيِّباً ثُمَّ تَنْتَحِي","لأَعْيَطَ مِنْ أَقْرَابِهِ المِسْكُ يَنْفَحُ",25,"ح",1,0],["تَرَعَّاهُ حَتَّى إِذَا أَظْلَمَتْ","تَأَوَّتْ فَأَزْجَتْ إِلَيْهَا غَزَالاَ",26,"ل",2,0],["ترعى النهار وتتقي غسق الدجى","هذا يطمئنها وذاك يريبها",27,"ب",3,0],["تَرْعَى الايَامَى وَالْيَتَامَى إِذَا","عَزَّهُمُ الْعَوْنُ وَعَزَّ النَّدَى",28,"د",2,0],["تَرْعى الْخُزَامَى وَالثُّمَامَ نَشِيطَةً","مَحْمودَةَ الإِصْدَارِ والإِيَرادِ",29,"د",1,0],["تَرَعْرَعَ فِيهِ جَنَّاتٌ","وَتَينَعُ فِيهِ أَثْمَارُ",30,"ر",1,0],["ترعى السفالة في مجاهل قلبه","وتطل إن شبعت من الآماق",31,"ق",1,0],["تَرْعَى السّهُولَةَ، وَالحزُونُ يَقينَهَا","حَدّينِ: بين أظَافِرٍ وَمَخَالِبِ",32,"ب",1,0],["ترعَى الرسيمَ إلى الوجيفِ بنا","بدلاً من الحودانِ والنّفلِ",33,"ل",1,0],["تَرْعاهُ إنْ خافَ أقوامٌ وإنْ أمِنوا","وفي القبائلِ عنهُ غيرنا لزمُ",34,"م",1,0],["تَرْعَى الفَلاَة َ بِهَاأَوَابِدُرُتَّع","ٌ نُبْلٌ هَجائنُ مِثلُ ذَوْدِ القافلِ",35,"ل",1,0],["تَرَعّى بهِ البَرْدَيْنِ ثُمَّ مَقِيلُها","ذُرَى سَلَمٍ تَأوِي إليها الجآذِرُ",36,"ر",1,0],["ترعية ً للدين لا ينام","عنه إذاا استثقل النوامُ",37,"م",1,0],["ترعرع فيك طبع ما تثنى","لغيرك فاق من ذهبوا وجاؤا",38,"ا",2,0],["ترعى النعيمَ مخلَّداً في لذةٍ","متنعماً بتشرفٍ وتَفَضُّلِ",39,"ل",1,0],["ترعَى بها زُهرَ النجوم جيادُهم","ومن السحاب يَرِدنَ في غُدرانِ",40,"ن",1,0],["تَرْعى وما استرعَيْتُها","ثَمَر القلوبِ بِلا دبيبِ",41,"ب",1,0],["تَرَعرَعَ المُلكُ في أَبياتِنا وَنَشا","حَتّى اِستَوى وَمُرَبِّيهِ مُرَبِّينا",42,"ن",2,0],["تَرعَى رُبولاً مِنَ الوَسمىِّ عَازِبةً","جَرَّت بِهضا المُزنُ سَحَّ فَانسَكَبَا",43,"ب",2,0],["ترعى الكواكبُ منه كوكبَ غُرَّةٍ","ينشقُّ عنه دجى الغبار الأقتم",44,"م",1,0],["تَرعى لِحاظُكَ مِن بَدائِعِ وَشيها","أَزهارَ جَنّاتٍ وَنورَ خَمائِلِ",45,"ل",1,0],["تَرعى الرَعايا لَهُ جُفونٌ","مُستَيقِظاتٌ وَهُم هُجوعُ",46,"ع",1,0],["تَرعى الروائِمُ أَحرار البُقولِ بِها","لا مِثلَ رَعيِكُمُ مِلحاً وَغَسويلا",47,"ل",2,0],["تَرعى النَواظر في محاجر خده","روضا اقام الحسن فيه وخيما",48,"م",2,0],["تَرَعْرَعَ بَيْنَ البَأْسِ والجُودِ مِثْلَما","تَبَحْبَحَ فِي المَجْدِ المُؤَثَّلِ وَالعَلْيَا",49,"ي",2,0],["تَرعى رِياضَ الأَخرَمَينِ لَهُم","فيها مَوارِدُ ماؤُها غَدَقُ",50,"ق",1,0],["تَرعى القَطاةُ الخِمسَ قَفورَها","ثُمَّ تَعُرُّ الماءَ فيمَن يَعُرُّ",51,"ر",1,0],["تَرعى سوائِمُه الهشيمَ تلمّظاً","وَثرى المواردِ في الرياح يثورُ",52,"ر",1,0],["ترعش الحمى حناياه فلا","تجد المهد وأنّى بالمهود",53,"د",1,0],["تَرعى الرَعيّة عَيناه وَقَد هَجعت","في ظلّ أَمن إِذا قرح الرَدى قرحا",54,"ح",2,0],["تَرعى مَنابِتَ وَسمِيٍّ أَطاعَ لَهُ","بِالجِزعِ حَيثُ عَصى أَصحابَهُ الفيلُ",55,"ل",1,0],["ترعى بخوين نجيلاً غامدا","قد أكلت وارسه والخاضدا",56,"د",2,1],["ترعى سميراء إلى أرمامها","إلى الطريفات إلى أهضامها",57,"م",3,1],["ترعى الى جد لها مكين","أكناف خو فبراق التين",58,"ن",1,1],["ترعى العلوم بها وتلك رعاية","فيها على إحسانك البرهان",59,"ن",1,0],["ترعرع ذهني في رياض علومه","وغذاه بالتحقيق وهو وليد",60,"د",1,0],["ترعرعوا في حجر أمِّ العلى","وأرضِعوا منها غريب اللقاح",61,"ح",1,0],["ترعرعَ في بُرْدَيْهِ غُصْنُ أَراكَةٍ","ذَوَي الغُصْنُ مِنِّي والتوى مذ تَرَعْرَعَا",62,"ع",2,0],["تُرعى وتُروَى ما ضفا وما صفا","وللرُّعاة بعدَها أسآرُها",63,"ر",3,0],["ترعاك عينُ اللّه لي","من شرّ أعين البشرْ",64,"ر",1,0],["ترْعى شَكيرَ الهامِ وهو مُمَنَّعٌ","وتُبيحُ وِرْدَ الهامِ وهو محرَّمُ",65,"م",1,0],["ترعرعَ الدين طفلاً بين أظهرهم","وما ألمَّ به وهنٌ وتكهيل",66,"ل",1,0],["تُرعَدُ وَهيَ تُصاديهِ خَصائِلُها","كَأَنَّما مَسَّها مِن قِرَّةٍ صَرَدُ",67,"د",1,0],["ترعى بنونا على الأحقاب عترتكم","في ذلك الفضل لا طول ينسيها",68,"ي",3,0],["ترعب الآسادُ في الغابات من","خادمٍ حفَّت به نفحتنا",69,"ن",2,0],["ترعدها الغصة إن ما سألت","ولا مجيبٌ سامعٌ سوآلها",70,"ل",3,0],["تَرْعَى القلوبَ وتَرْتَعي ال","غِزْلاَنُ بَرْوَقَهُ وَشِيْحَهْ",71,"ح",2,0],["ترعى لهم أحواله وتنظره","في كل ما يسره ويجهره",72,"ه",1,0],["تَرعَيِّ بِأَذنابِ الشِعابِ وَدونَها","رِجالٌ يَصُدّونَ الظَلومَ عَنِ الهَوى",73,"ا",1,0],["تَرعى فَزارَةُ في مَقَرِّ بِلادِها","وَتَهيمُ بَينَ شَقائِقٍ وَرِمالِ",74,"ل",1,1],["تَرَعّى الفَضاءَ كُلَّ مَجرى سَحابَةٍ","وَفي النَفسِ مِنهُ رَأفَةٌ وَهَواجِسُ",75,"س",1,0]]}