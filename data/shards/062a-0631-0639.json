{"poems":[[108,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"برقت بالوعد في دجى أملي","https://www.aldiwan.net/poem29937.html","المنسرح"],[53,"اذهب ولا تبعدن من رجل","https://www.aldiwan.net/poem30731.html","المنسرح"],[35,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[93,"يا من لها القصر المنيف","https://www.aldiwan.net/poem11092.html","مجزوء الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[38,"ومن يك باديا ويكن أخاه","https://www.aldiwan.net/poem7808.html","الوافر"],[85,"بأرض الجيزة اجتاز الغمام","https://www.aldiwan.net/poem8084.html","الوافر"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[43,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[62,"نغدو إليك إذا اعترتنا حاجة","https://www.aldiwan.net/poem52254.html","الكامل"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[28,"شعثا شوازب قد طوى أقرابها","https://www.aldiwan.net/poem5483.html","الكامل"],[61,"الكأس قطب السرور والطرب","https://www.aldiwan.net/poem51765.html","المنسرح"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[48,"لا يصرفنك عن قصف وإصباء","https://www.aldiwan.net/poem10400.html","البسيط"],[46,"يا ليل قد نام الشجي ولم ينم","https://www.aldiwan.net/poem22581.html","الكامل"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[45,"ما أنتَ، للكَلِفِ المَشُوقِ، بصَاحِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31560",""],[80,"وَرْدُ الخدودِ ونرّجسُ المُقَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=3528",""],[29,"هَبَطْنَ مُناخاً يَنْتَطِحْنَ بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=17338",""],[35,"غشيتُ لليلى بالبَرودِ مساكناً","https://www.poetsgate.com/ViewPoem.aspx?id=22022",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[116,"أيجحد من جلالتك السناء","https://www.aldiwan.net/poem41473.html","عموديه"],[129,"أهدى السلام إلى الكريم المفضل","https://www.aldiwan.net/poem50544.html","الكامل"],[143,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[156,"بدر تقنع بالظلام","https://www.aldiwan.net/poem55793.html","مجزوء الكامل"],[170,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[182,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[199,"يا برق نجد هل شعرت بمتهم","https://www.aldiwan.net/poem51892.html","الكامل"],[236,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[236,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[268,"لئن رحلت جملي إن لي سعة","https://www.aldiwan.net/poem1148.html",""],[272,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[276,"أشد بالقوافي ذكر علوة أو عليا","https://www.aldiwan.net/poem25451.html","الطويل"],[288,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[301,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[306,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[329,"لهف نفسي والمنايا تلتظى","https://www.aldiwan.net/poem55052.html","الرمل"],[354,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[364,"هل حبل شماء قبل البين موصول","https://www.aldiwan.net/poem1715.html","البسيط"],[380,"ترعى بخوين نجيلا غامدا","https://www.aldiwan.net/poem4542.html","الرجز"],[380,"ترعى سميراء إلى أرمامها","https://www.aldiwan.net/poem4582.html","الرجز"],[380,"ترعى الى جد لها مكين","https://www.aldiwan.net/poem4587.html","الرجز"],[401,"للحب قلب نابض","https://www.aldiwan.net/poem6705.html","عموديه"],[404,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[417,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[433,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[462,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[465,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[471,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[480,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[501,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[501,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[568,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["ترعى بإدلاجها رسم السراة ولا","ترعى لمدلجها في السير ما رسموا",0,"م",3,0],["تُرعى الجَماجِمُ وَالجَميمُ إِزاءَها","وَدَمُ الطُلى بَدَلاً مِنَ الغُدرانِ",1,"ن",1,0],["تَرعى سَوامَ العَبيدِ هَيبَتُهُ","فَكَيفَ يَرضى وَذَودُهُ هَمَلُ",2,"ل",1,0],["تَرعِ العِدا عَن جَوانِبي بِيَدٍ","يَروعُ فيها النُضارُ وَالوَرَقا",3,"ق",2,0],["تَرعِيَّةٌ طاعَتِ الصِعابُ لَهُ","وَاِستَوسَقَت في زَمامِهِ العَرَبُ",4,"ب",1,0],["تَرَعّى بِهِ البَردَينِ ثُمَّ مَقِلُها","ذُرى تَأَوي إِليها الجآذِرُ",5,"ر",1,0],["تَرْعَاكِ عَيْنٌ لِلْعِنَا","يَةِ لا القَنَا وَالسُّمْهُرِيّ",6,"ي",1,0],["تُرْعَى لَهُ حُرْمَةٌ فِي كُلِّ مَنْزِلَةٍ","سَمَا إِلَيْهَا وَتُرْعَى عِنْدَهُ الْحُرَمُ",7,"م",1,0],["تَرعى وتمثُل في صِلاتِك تارةً","لمن احتباك فخلفُه لك يَمْثُلُ",8,"ل",1,0],["تَرعى بَحازِجُها خِلالَ رِياضِها","وَتَميسُ بَينَ سَباسِبٍ وَرِمالِ",9,"ل",1,0],["تَرَعّى مِن جُنوبِ ثُعالِباتٍ","أَسِرَّةَ عازِبٍ نَحَرَ الهِلالا",10,"ل",2,0],["تَرَعرَعَتِ الحَضارَةُ في حُلاهُ","وَشَبَّ عَلى جَواهِرِهِ النِظامُ",11,"م",1,0],["تُرعِشُ الأَيدي وَمَن يُر","عِش مِنَ الصُنّاعِ خابا",12,"ب",2,0],["تَرَعرَعَ المَلِكُ الأُستاذُ مُكتَهِلاً","قَبلَ اِكتِهالٍ أَديباً قَبلَ تَأديبِ",13,"ب",1,0],["ترعَى لمن غابَ الذمامَ مجاملاً","وتُنيلُ من حضَر الرغائبَ مُحسنا",14,"ن",2,0],["ترعَى إِذا غفلوا وتسهرُ إنْ","ناموا وتَحلم كلَّما جَهِلُوا",15,"ل",3,0],["تَرعى السُهُلَةَ وَالحُزونُ يَقينَها","حَدَّينِ بَينَ أَظافِرٍ وَمَخالِبِ",16,"ب",1,0],["تَرعى الزَعانِفَ حَولَنا بِقِيادِها","وَغُدُوُّهُنَّ مُرَوَّحَ التَشلالِ",17,"ل",1,0],["تَرْعُدُ أحشاؤه لديَّ كما","تَرْعُدُ أحشاءُ هائمٍ وَصِبِ",18,"ب",1,0],["تَرعى الصُروبَ بِكَفّيها وَأَرجُلِها","وَتَحفَظُ الأَصلَ مِن نَقصٍ وَتَغيِيرِ",19,"ر",1,0],["ترعى سجاياهُ من قُصّاده ذِمماً","وليس يَرْعى لمالٍ بَذْلُهُ ذِمَما",20,"م",2,0],["ترعَى الرسيمَ إلى الوجيفِ بنا","بَدَلاً من الحَوذانِ والنّفَلِ",21,"ل",1,0],["تَرعى أَزاهيرَ غيطانٍ وَأَودِيَةٍ","وَتَشرَبُ الصَفوَ مِن غُدرٍ وَأَحساءِ",22,"ا",2,0],["تَرعاهُ راعِيَةٌ وَتَهتِكُ بُردَهُ","أُخرى وَمِنهُ شَقائِقٌ وَبَهارُ",23,"ر",1,0],["تَرعى خوافي الرُّبْدِ في حَجَراتِها","سَغْباً وتَعْثُرُ بالغَطَاطِ النُّوَمِ",24,"م",1,0],["ترعى النهار وتتقي غسق الدجى","هذا يطمئنها وذاك يريبها",25,"ب",3,0],["تَرْعَى الايَامَى وَالْيَتَامَى إِذَا","عَزَّهُمُ الْعَوْنُ وَعَزَّ النَّدَى",26,"د",2,0],["تَرْعى الْخُزَامَى وَالثُّمَامَ نَشِيطَةً","مَحْمودَةَ الإِصْدَارِ والإِيَرادِ",27,"د",1,0],["تَرَعْرَعَ فِيهِ جَنَّاتٌ","وَتَينَعُ فِيهِ أَثْمَارُ",28,"ر",1,0],["ترعى السفالة في مجاهل قلبه","وتطل إن شبعت من الآماق",29,"ق",1,0],["تَرْعَى السّهُولَةَ، وَالحزُونُ يَقينَهَا","حَدّينِ: بين أظَافِرٍ وَمَخَالِبِ",30,"ب",1,0],["ترعَى الرسيمَ إلى الوجيفِ بنا","بدلاً من الحودانِ والنّفلِ",31,"ل",1,0],["تَرْعاهُ إنْ خافَ أقوامٌ وإنْ أمِنوا","وفي القبائلِ عنهُ غيرنا لزمُ",32,"م",1,0],["تَرَعّى بهِ البَرْدَيْنِ ثُمَّ مَقِيلُها","ذُرَى سَلَمٍ تَأوِي إليها الجآذِرُ",33,"ر",1,0],["ترعية ً للدين لا ينام","عنه إذاا استثقل النوامُ",34,"م",1,0],["ترعرع فيك طبع ما تثنى","لغيرك فاق من ذهبوا وجاؤا",35,"ا",2,0],["ترعى النعيمَ مخلَّداً في لذةٍ","متنعماً بتشرفٍ وتَفَضُّلِ",36,"ل",1,0],["ترعَى بها زُهرَ النجوم جيادُهم","ومن السحاب يَرِدنَ في غُدرانِ",37,"ن",1,0],["تَرْعى وما استرعَيْتُها","ثَمَر القلوبِ بِلا دبيبِ",38,"ب",1,0],["تَرَعرَعَ المُلكُ في أَبياتِنا وَنَشا","حَتّى اِستَوى وَمُرَبِّيهِ مُرَبِّينا",39,"ن",2,0],["تَرعَى رُبولاً مِنَ الوَسمىِّ عَازِبةً","جَرَّت بِهضا المُزنُ سَحَّ فَانسَكَبَا",40,"ب",2,0],["ترعى الكواكبُ منه كوكبَ غُرَّةٍ","ينشقُّ عنه دجى الغبار الأقتم",41,"م",1,0],["تَرعى لِحاظُكَ مِن بَدائِعِ وَشيها","أَزهارَ جَنّاتٍ وَنورَ خَمائِلِ",42,"ل",1,0],["تَرعى الرَعايا لَهُ جُفونٌ","مُستَيقِظاتٌ وَهُم هُجوعُ",43,"ع",1,0],["تَرعى الروائِمُ أَحرار البُقولِ بِها","لا مِثلَ رَعيِكُمُ مِلحاً وَغَسويلا",44,"ل",2,0],["تَرعى النَواظر في محاجر خده","روضا اقام الحسن فيه وخيما",45,"م",2,0],["تَرَعْرَعَ بَيْنَ البَأْسِ والجُودِ مِثْلَما","تَبَحْبَحَ فِي المَجْدِ المُؤَثَّلِ وَالعَلْيَا",46,"ي",2,0],["تَرعى رِياضَ الأَخرَمَينِ لَهُم","فيها مَوارِدُ ماؤُها غَدَقُ",47,"ق",1,0],["تَرعى القَطاةُ الخِمسَ قَفورَها","ثُمَّ تَعُرُّ الماءَ فيمَن يَعُرُّ",48,"ر",1,0],["تَرعى سوائِمُه الهشيمَ تلمّظاً","وَثرى المواردِ في الرياح يثورُ",49,"ر",1,0],["ترعش الحمى حناياه فلا","تجد المهد وأنّى بالمهود",50,"د",1,0],["تَرعى الرَعيّة عَيناه وَقَد هَجعت","في ظلّ أَمن إِذا قرح الرَدى قرحا",51,"ح",2,0],["تَرعى مَنابِتَ وَسمِيٍّ أَطاعَ لَهُ","بِالجِزعِ حَيثُ عَصى أَصحابَهُ الفيلُ",52,"ل",1,0],["ترعى بخوين نجيلاً غامدا","قد أكلت وارسه والخاضدا",53,"د",2,1],["ترعى سميراء إلى أرمامها","إلى الطريفات إلى أهضامها",54,"م",3,1],["ترعى الى جد لها مكين","أكناف خو فبراق التين",55,"ن",1,1],["ترعى العلوم بها وتلك رعاية","فيها على إحسانك البرهان",56,"ن",1,0],["ترعرع ذهني في رياض علومه","وغذاه بالتحقيق وهو وليد",57,"د",1,0],["ترعرعوا في حجر أمِّ العلى","وأرضِعوا منها غريب اللقاح",58,"ح",1,0],["ترعرعَ في بُرْدَيْهِ غُصْنُ أَراكَةٍ","ذَوَي الغُصْنُ مِنِّي والتوى مذ تَرَعْرَعَا",59,"ع",2,0],["تُرعى وتُروَى ما ضفا وما صفا","وللرُّعاة بعدَها أسآرُها",60,"ر",3,0],["ترعاك عينُ اللّه لي","من شرّ أعين البشرْ",61,"ر",1,0],["ترْعى شَكيرَ الهامِ وهو مُمَنَّعٌ","وتُبيحُ وِرْدَ الهامِ وهو محرَّمُ",62,"م",1,0],["ترعرعَ الدين طفلاً بين أظهرهم","وما ألمَّ به وهنٌ وتكهيل",63,"ل",1,0],["تُرعَدُ وَهيَ تُصاديهِ خَصائِلُها","كَأَنَّما مَسَّها مِن قِرَّةٍ صَرَدُ",64,"د",1,0],["ترعى بنونا على الأحقاب عترتكم","في ذلك الفضل لا طول ينسيها",65,"ي",3,0],["ترعب الآسادُ في الغابات من","خادمٍ حفَّت به نفحتنا",66,"ن",2,0],["ترعدها الغصة إن ما سألت","ولا مجيبٌ سامعٌ سوآلها",67,"ل",3,0],["تَرْعَى القلوبَ وتَرْتَعي ال","غِزْلاَنُ بَرْوَقَهُ وَشِيْحَهْ",68,"ح",2,0],["ترعى لهم أحواله وتنظره","في كل ما يسره ويجهره",69,"ه",1,0]]}