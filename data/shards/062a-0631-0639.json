ا الجآذِرُ",5,"ر",1,0],["تَرْعَاكِ عَيْنٌ لِلْعِنَا","يَةِ لا القَنَا وَالسُّمْهُرِيّ",6,"ي",1,0],["تُرْعَى لَهُ حُرْمَةٌ فِي كُلِّ مَنْزِلَةٍ","سَمَا إِلَيْهَا وَتُرْعَى عِنْدَهُ الْحُرَمُ",7,"م",1,0],["تَرعى وتمثُل في صِلاتِك تارةً","لمن احتباك فخلفُه لك يَمْثُلُ",8,"ل",1,0],["تَرعى بَحازِجُها خِلالَ رِياضِها","وَتَميسُ بَينَ سَباسِبٍ وَرِمالِ",9,"ل",1,0],["تَرَعّى مِن جُنوبِ ثُعالِباتٍ","أَسِرَّةَ عازِبٍ نَحَرَ الهِلالا",10,"ل",2,0],["تَرَعرَعَتِ الحَضارَةُ في حُلاهُ","وَشَبَّ عَلى جَواهِرِهِ النِظامُ",11,"م",1,0],["تُرعِشُ الأَيدي وَمَن يُر","عِش مِنَ الصُنّاعِ خابا",12,"ب",2,0],["تَرَعرَعَ المَلِكُ الأُستاذُ مُكتَهِلاً","قَبلَ اِكتِهالٍ أَديباً قَبلَ تَأديبِ",13,"ب",1,0],["ترعَى لمن غابَ الذمامَ مجاملاً","وتُنيلُ من حضَر الرغائبَ مُحسنا",14,"ن",2,0],["ترعَى إِذا غفلوا وتسهرُ إنْ","ناموا وتَحلم كلَّما جَهِلُوا",15,"ل",3,0],["تَرعى السُهُلَةَ وَالحُزونُ يَقينَها","حَدَّينِ بَينَ أَظافِرٍ وَمَخالِبِ",16,"ب",1,0],["تَرعى الزَعانِفَ حَولَنا بِقِيادِها","وَغُدُوُّهُنَّ مُرَوَّحَ التَشلالِ",17,"ل",1,0],["تَرْعُدُ أحشاؤه لديَّ كما","تَرْعُدُ أحشاءُ هائمٍ وَصِبِ",18,"ب",1,0],["تَرعى الصُروبَ بِكَفّيها وَأَرجُلِها","وَتَحفَظُ الأَصلَ مِن نَقصٍ وَتَغيِيرِ",19,"ر",1,0],["ترعى سجاياهُ من قُصّاده ذِمماً","وليس يَرْعى لمالٍ بَذْلُهُ ذِمَما",20,"م",2,0],["ترعَى الرسيمَ إلى الوجيفِ بنا","بَدَلاً من الحَوذانِ والنّفَلِ",21,"ل",1,0],["تَرعى أَزاهيرَ غيطانٍ وَأَودِيَةٍ","وَتَشرَبُ الصَفوَ مِن غُدرٍ وَأَحساءِ",22,"ا",2,0],["تَرعاهُ راعِيَةٌ وَتَهتِكُ بُردَهُ","أُخرى وَمِنهُ شَقائِقٌ وَبَهارُ",23,"ر",1,0],["تَرعى خوافي الرُّبْدِ في حَجَراتِها","سَغْباً وتَعْثُرُ بالغَطَاطِ النُّوَمِ",24,"م",1,0],["تَرَعَّى جَنَاباً طَيِّباً ثُمَّ تَنْتَحِي","لأَعْيَطَ مِنْ أَقْرَابِهِ المِسْكُ يَنْفَحُ",25,"ح",1,0],["تَرَعَّاهُ حَتَّى إِذَا أَظْلَمَتْ","تَأَوَّتْ فَأَزْجَتْ إِلَيْهَا غَزَالاَ",26,"ل",2,0],["ترعى النهار وتتقي غسق الدجى","هذا يطمئنها وذاك يريبها",27,"ب",3,0],["تَرْعَى الايَامَى وَالْيَتَامَى إِذَا","عَزَّهُمُ الْعَوْنُ وَعَزَّ النَّدَى",28,"د",2,0],["تَرْعى الْخُزَامَى وَالثُّمَامَ نَشِيطَةً","مَحْمودَةَ الإِصْدَارِ والإِيَرادِ",29,"د",1,0],["تَرَعْرَعَ فِيهِ جَنَّاتٌ","وَتَينَعُ فِيهِ أَثْمَارُ",30,"ر",1,0],["ترعى السفالة في مجاهل قلبه","وتطل إن شبعت من الآماق",31,"ق",1,0],["تَرْعَى السّهُولَةَ، وَالحزُونُ يَقينَهَا","حَدّينِ: بين أظَافِرٍ وَمَخَالِبِ",32,"ب",1,0],["ترعَى الرسيمَ إلى الوجيفِ بنا","بدلاً من الحودانِ والنّفلِ",33,"ل",1,0],["تَرْعاهُ إنْ خافَ أقوامٌ وإنْ أمِنوا","وفي القبائلِ عنهُ غيرنا لزمُ",34,"م",1,0],["تَرْعَى الفَلاَة َ بِهَاأَوَابِدُرُتَّع","ٌ نُبْلٌ هَجائنُ مِثلُ ذَوْدِ القافلِ",35,"ل",1,0],["تَرَعّى بهِ البَرْدَيْنِ ثُمَّ مَقِيلُها","ذُرَى سَلَمٍ تَأوِي إليها الجآذِرُ",36,"ر",1,0],["ترعية ً للدين لا ينام","عنه إذاا استثقل النوامُ",37,"م",1,0],["ترعرع فيك طبع ما تثنى","لغيرك فاق من ذهبوا وجاؤا",38,"ا",2,0],["ترعى النعيمَ مخلَّداً في لذةٍ","متنعماً بتشرفٍ وتَفَضُّلِ",39,"ل",1,0],["ترعَى بها زُهرَ النجوم جيادُهم","ومن السحاب يَرِدنَ في غُدرانِ",40,"ن",1,0],["تَرْعى وما استرعَيْتُها","ثَمَر القلوبِ بِلا دبيبِ",41,"ب",1,0],["تَرَعرَعَ المُلكُ في أَبياتِنا وَنَشا","حَتّى اِستَوى وَمُرَبِّيهِ مُرَبِّينا",42,"ن",2,0],["تَرعَى رُبولاً مِنَ الوَسمىِّ عَازِبةً","جَرَّت بِهضا المُزنُ سَحَّ فَانسَكَبَا",43,"ب",2,0],["ترعى الكواكبُ منه كوكبَ غُرَّةٍ","ينشقُّ عنه دجى الغبار الأقتم",44,"م",1,0],["تَرعى لِحاظُكَ مِن بَدائِعِ وَشيها","أَزهارَ جَنّاتٍ وَنورَ خَمائِلِ",45,"ل",1,0],["تَرعى الرَعايا لَهُ جُفونٌ","مُستَيقِظاتٌ وَهُم هُجوعُ",46,"ع",1,0],["تَرعى الروائِمُ أَحرار البُقولِ بِها","لا مِثلَ رَعيِكُمُ مِلحاً وَغَسويلا",47,"ل",2,0],["تَرعى النَواظر في محاجر خده","روضا اقام الحسن فيه وخيما",48,"م",2,0],["تَرَعْرَعَ بَيْنَ البَأْسِ والجُودِ مِثْلَما","تَبَحْبَحَ فِي المَجْدِ المُؤَثَّلِ وَالعَلْيَا",49,"ي",2,0],["تَرعى رِياضَ الأَخرَمَينِ لَهُم","فيها مَوارِدُ ماؤُها غَدَقُ",50,"ق",1,0],["تَرعى القَطاةُ الخِمسَ قَفورَها","ثُمَّ تَعُرُّ الماءَ فيمَن يَعُرُّ",51,"ر",1,0],["تَرعى سوائِمُه الهشيمَ تلمّظاً","وَثرى المواردِ في الرياح يثورُ",52,"ر",1,0],["ترعش الحمى حناياه فلا","تجد المهد وأنّى بالمهود",53,"د",1,0],["تَرعى الرَعيّة عَيناه وَقَد هَجعت","في ظلّ أَمن إِذا قرح الرَدى قرحا",54,"ح",2,0],["تَرعى مَنابِتَ وَسمِيٍّ أَطاعَ لَهُ","بِالجِزعِ حَيثُ عَصى أَصحابَهُ الفيلُ",55,"ل",1,0],["ترعى بخوين نجيلاً غامدا","قد أكلت وارسه والخاضدا",56,"د",2,1],["ترعى سميراء إلى أرمامها","إلى الطريفات إلى أهضامها",57,"م",3,1],["ترعى الى جد لها مكين","أكناف خو فبراق التين",58,"ن",1,1],["ترعى العلوم بها وتلك رعاية","فيها على إحسانك البرهان",59,"ن",1,0],["ترعرع ذهني في رياض علومه","وغذاه بالتحقيق وهو وليد",60,"د",1,0],["ترعرعوا في حجر أمِّ العلى","وأرضِعوا منها غريب اللقاح",61,"ح",1,0],["ترعرعَ في بُرْدَيْهِ غُصْنُ أَراكَةٍ","ذَوَي الغُصْنُ مِنِّي والتوى مذ تَرَعْرَعَا",62,"ع",2,0],["تُرعى وتُروَى ما ضفا وما صفا","وللرُّعاة بعدَها أسآرُها",63,"ر",3,0],["ترعاك عينُ اللّه لي","من شرّ أعين البشرْ",64,"ر",1,0],["ترْعى شَكيرَ الهامِ وهو مُمَنَّعٌ","وتُبيحُ وِرْدَ الهامِ وهو محرَّمُ",65,"م",1,0],["ترعرعَ الدين طفلاً بين أظهرهم","وما ألمَّ به وهنٌ وتكهيل",66,"ل",1,0],["تُرعَدُ وَهيَ تُصاديهِ خَصائِلُها","كَأَنَّما مَسَّها مِن قِرَّةٍ صَرَدُ",67,"د",1,0],["ترعى بنونا على الأحقاب عترتكم","في ذلك الفضل لا طول ينسيها",68,"ي",3,0],["ترعب الآسادُ في الغابات من","خادمٍ حفَّت به نفحتنا",69,"ن",2,0],["ترعدها الغصة إن ما سألت","ولا مجيبٌ سامعٌ سوآلها",70,"ل",3,0],["تَرْعَى القلوبَ وتَرْتَعي ال","غِزْلاَنُ بَرْوَقَهُ وَشِيْحَهْ",71,"ح",2,0],["ترعى لهم أحواله وتنظره","في كل ما يسره ويجهره",72,"ه",1,0],["تَرعى مَصَالحُهم تَسْعى لِوحدتِهِم","تَدعُو الجميعَ إلى نَبذِ الخِلافاتِ",73,"ت",1,0],["ترعي بها ما تشتهي","والقلب في ذات الوقود",74,"د",1,0],["تَرعَى المَنايا السّائِماتُ نُفُوسَنا","رَعيَ السَّوام الشّيحَ والقَيصُوما",75,"م",2,0],["تَرعرَعَ سَيِّداً ونَشا رَئيسا","فَحَسبُكَ في الريِّاسَة والسّياده",76,"د",2,0],["ترعَى المنايا السائماتُ نفوسَنا","فكأنها نَغَمٌ ونحن نَبات",77,"ت",1,0],["تُرعِدُهُ خيفَةٌ وتَخنُقُه","مِن أسَفٍ عَبرَةٌ فَيختَنِقُ",78,"ق",1,0],["تَرعَينَ أفئِدَةَ القُلُوبِ وَسِربُها","تَرعى الخَمائِلَ وَهيَ تَرعَى العَلَّفا",79,"ف",2,0],["ترعى بحز نك ضحك الورد محترقا","تنأى وتوغل في وجد السموات",80,"ت",1,0],["ترعاه بالمقلة اليق