{"poems":[[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"سوار شكرا لأيري فضل نعمته","https://www.aldiwan.net/poem66297.html","البسيط"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[89,"يطلبون الوصول إن عبروه","https://www.aldiwan.net/poem45101.html","الخفيف"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[80,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[69,"من ثغر من أهوى ومبسمه","https://www.aldiwan.net/poem28610.html","أحذ الكامل"],[48,"إذا الشياطين رأت زنبورا","https://www.aldiwan.net/poem63409.html","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55076","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[113,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[184,"فرخ الحرف وزقا","https://www.aldiwan.net/poem43563.html","مجزوء الرمل"],[184,"كم جليس إلي وهو على الأر","https://www.aldiwan.net/poem43719.html","الخفيف"],[187,"من ثنايا العذراء لاح بريق","https://www.aldiwan.net/poem35153.html","الخفيف"],[202,"حلو الشمائل ناعم الأعطاف","https://www.aldiwan.net/poem53238.html","الكامل"],[208,"صد من أهواه عني وسلا","https://www.aldiwan.net/poem13370.html","الرمل"],[221,"تذكري حين يزف الضحى","https://www.aldiwan.net/poem41618.html","السريع"],[303,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[364,"زارت فزارك في الظلام ضياء","https://www.aldiwan.net/poem16913.html","الكامل"],[364,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[397,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[406,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[413,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[451,"ما جاء قبلك للتخليد إنسان","https://www.aldiwan.net/poem61247.html","البسيط"],[451,"الجلاء الجلاء رددت الأصداء","https://www.aldiwan.net/poem61259.html","الخفيف"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[536,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"]],"verses":[["مَنْثُورَةَ الأَفْرَادِ مَنْظُومَةً","جَمْعاً بِمَا لا تُدْرِكُ الْعَيْنَانِ",0,"ن",1,0],["من ثِقاتِ الندى ومن ناصريه","من ظهور الحجا ومن أَعْضادِهْ",1,"د",2,0],["من ثغرها الدرُّ النظي","مُ ولفظُها الدرُّ النثيرُ",2,"ر",1,0],["من ثفْرِها وجِعبَّاها ومن فمها","قَسْمَ السويةِ ما فيهن مَظْلومُ",3,"م",1,0],["من ثقفته الحادثات ملمة","يلقى الخطوب بصدره بساما",4,"م",2,0],["من ثمار تجني ولحم طري","وشراب من سلسبيل براد",5,"د",1,0],["مِنْ ثَمَّ أَوْصى بهِ نَبِيُّكُمُ","نَصَّاً فأَبْدَى عَداوةَ الكَلِبِ",6,"ب",1,0],["من ثَغَبٍ باردٍ حصاه","منظم اللؤلؤ الشنيبِ",7,"ب",1,0],["مِنْ ثغرِ مَنْ أهوى ومبسمِهِ","سرقَ السحابُ البرْدَ والبرَدا",8,"د",2,1],["مِن ثَعلَبٍ غادَرَهُ عَفيرا","أَو أَرنَبٍ جَوَّرَها تَجويرا",9,"ر",2,0],["مِن ثَواءٍ فيهِ المَلالُ لِزامٌ","أَو رَحيلٍ فيهِ العَناءُ كَثيرُ",10,"ر",1,0],["مِن ثَيِّباتٍ لم تُبلْ","كشْفَ الخُدُودِ ولا المَعاصِمْ",11,"م",1,0],["مِنْ ثَمَرٍ قَلّ مَا يُنَافِسُهُ","فِي نَوْعِهِ بِالمُذَاقِ وَالعَبَقِ",12,"ق",1,0],["من ثمر الفرصاد في ذروته","الريانة المعطار كبش أحمر",13,"ر",1,0],["من ثغره كم من","كأس شربناه",14,"ا",2,0],["من ثياب الشام عود","ومن بيض وزرقا",15,"ق",2,0],["من ثبير ومن عسيب ورضوى","ولكام والطود من بيّاس",16,"س",1,0],["مِن ثَنايا العذراءِ لاح بريق","فجَرى مِن دموعِ عيني عقيقُ",17,"ق",1,1],["من ثغره نور التبسم ضاحكٌ","بأديمه ماء البشاشة صافِ",18,"ف",1,0],["من ثناياه ومن الحاظه","حكت نظمي ونسجت الغزلا",19,"ل",2,0],["منثنياً خلفَ رداءٍ لَهُ","قَد فَضَّضَتهُ الأَنجمُ الساهِدَه",20,"ه",1,0],["مَن ثَنى الجيدَ عمد طيرٍ برجمِ","يُرم حجراً مِن ثني عبد المجيدِ",21,"د",1,0],["مِن ثَغرِهِ وَحُلِيِّهِ وَنَسيمِهِ","ما لا تَقومُ بِكَتمِهِ الظَلماءُ",22,"ا",2,0],["مِن ثَمَّ ما ساغَ لي إِن قُلتَ تُشبِهُهُ","وَأَينَ شِبهُ ثَرىً مِن صَيِّبٍ هَطَلا",23,"ل",2,0],["من ثكالى وَلَجْن بابَ المآسي","شاحباتٍ يبكينَ فقد البنينِ",24,"ن",1,0],["مَن ثَنائِي طَوَى إليه الفَيافِي","وهْو من كلِّ ذِي اقترابٍ قريبُ",25,"ب",1,0],["من ثغورٍ رضابها من شمولِ","حبّذا أوْجُهٌ تروقُك وَصْفا",26,"ف",2,0],["من ثار في الناس لا تخشى عقيدته","إلا الإله فلم يردعه طغيان",27,"ن",1,0],["من ثراها ومن سماها ومن","كل الذي أنبتته فنا وفكرا",28,"ر",2,0],["مَن ثلَّ عرشَك واستقادك خاطماً","فانقدتَ يا قطَّاعَ تلك الأحبُلِ",29,"ل",1,0],["منثورُها ذاك ومنظومُها","هذا كلا الدرّين لم يُثقَبِ",30,"ب",1,0],["من ثُلوجٍ لها يُكَلِّلُ هاما","فَتُبيحُ الأنهارَ منهُ الهدايا",31,"ي",2,0]]}