{"poems":[[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"سوار شكرا لأيري فضل نعمته","https://www.aldiwan.net/poem66297.html","البسيط"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[89,"يطلبون الوصول إن عبروه","https://www.aldiwan.net/poem45101.html","الخفيف"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[80,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[69,"من ثغر من أهوى ومبسمه","https://www.aldiwan.net/poem28610.html","أحذ الكامل"],[48,"إذا الشياطين رأت زنبورا","https://www.aldiwan.net/poem63409.html","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55076","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"]],"verses":[["مَنْثُورَةَ الأَفْرَادِ مَنْظُومَةً","جَمْعاً بِمَا لا تُدْرِكُ الْعَيْنَانِ",0,"ن",1,0],["من ثِقاتِ الندى ومن ناصريه","من ظهور الحجا ومن أَعْضادِهْ",1,"د",2,0],["من ثغرها الدرُّ النظي","مُ ولفظُها الدرُّ النثيرُ",2,"ر",1,0],["من ثفْرِها وجِعبَّاها ومن فمها","قَسْمَ السويةِ ما فيهن مَظْلومُ",3,"م",1,0],["من ثقفته الحادثات ملمة","يلقى الخطوب بصدره بساما",4,"م",2,0],["من ثمار تجني ولحم طري","وشراب من سلسبيل براد",5,"د",1,0],["مِنْ ثَمَّ أَوْصى بهِ نَبِيُّكُمُ","نَصَّاً فأَبْدَى عَداوةَ الكَلِبِ",6,"ب",1,0],["من ثَغَبٍ باردٍ حصاه","منظم اللؤلؤ الشنيبِ",7,"ب",1,0],["مِنْ ثغرِ مَنْ أهوى ومبسمِهِ","سرقَ السحابُ البرْدَ والبرَدا",8,"د",2,1],["مِن ثَعلَبٍ غادَرَهُ عَفيرا","أَو أَرنَبٍ جَوَّرَها تَجويرا",9,"ر",2,0],["مِن ثَواءٍ فيهِ المَلالُ لِزامٌ","أَو رَحيلٍ فيهِ العَناءُ كَثيرُ",10,"ر",1,0],["مِن ثَيِّباتٍ لم تُبلْ","كشْفَ الخُدُودِ ولا المَعاصِمْ",11,"م",1,0],["مِنْ ثَمَرٍ قَلّ مَا يُنَافِسُهُ","فِي نَوْعِهِ بِالمُذَاقِ وَالعَبَقِ",12,"ق",1,0],["من ثمر الفرصاد في ذروته","الريانة المعطار كبش أحمر",13,"ر",1,0]]}