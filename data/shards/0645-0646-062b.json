m/72394","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72350","الخفيف"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4702,"مارد وشيطانيه","https://www.poetsgate.com/ViewPoem.aspx?id=155200",""],[4767,"عزاء القديح","https://www.poetsgate.com/ViewPoem.aspx?id=89967",""],[4767,"ثمار الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=214196",""],[4874,"جروح المسا","https://www.poetsgate.com/ViewPoem.aspx?id=176617",""],[5092,"تائهان","https://www.poetsgate.com/ViewPoem.aspx?id=178351",""],[5121,"ريّان","https://www.poetsgate.com/ViewPoem.aspx?id=33582",""],[5121,"سحر الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36283",""],[5191,"العِطر","https://www.poetsgate.com/ViewPoem.aspx?id=212016",""],[5213,"بشراك قد انجزت الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=170454",""],[5232,"بوحٌ ونظرة","https://www.poetsgate.com/ViewPoem.aspx?id=212687",""],[5246,"أين الأثافي وأين النُؤْيُ والطلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187075",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5431,"دع عنك شكا في الوجود مؤرقا","https://www.poetsgate.com/ViewPoem.aspx?id=187362",""],[5436,"مهابة التأريخ(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34913",""],[5512,"عيد الثامن من آذار","https://www.poetsgate.com/ViewPoem.aspx?id=204502",""],[5587,"أَتَى الرَّبِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193849",""],[5616,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=204848",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5739,"اكتبيني بقرطاس ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131226",""],[5747,"ضوامي","https://www.poetsgate.com/ViewPoem.aspx?id=61677",""],[5836,"فجأة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=196680",""],[5848,"اطيب قلب","https://www.poetsgate.com/ViewPoem.aspx?id=53168",""],[6075,"لقاءٌ ساحرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204403",""],[6127,"الأملُ الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=198207",""],[6328,"في رحاب الضاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82139&r=&rc=14",""],[572,"عَذِيريَ منْ صرفِ هذا الزّمنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9489&r=&rc=346",""]],"verses":[["مَنْثُورَةَ الأَفْرَادِ مَنْظُومَةً","جَمْعاً بِمَا لا تُدْرِكُ الْعَيْنَانِ",0,"ن",1,0],["من ثِقاتِ الندى ومن ناصريه","من ظهور الحجا ومن أَعْضادِهْ",1,"د",2,0],["من ثغرها الدرُّ النظي","مُ ولفظُها الدرُّ النثيرُ",2,"ر",1,0],["من ثفْرِها وجِعبَّاها ومن فمها","قَسْمَ السويةِ ما فيهن مَظْلومُ",3,"م",1,0],["من ثقفته الحادثات ملمة","يلقى الخطوب بصدره بساما",4,"م",2,0],["من ثمار تجني ولحم طري","وشراب من سلسبيل براد",5,"د",1,0],["مِنْ ثَمَّ أَوْصى بهِ نَبِيُّكُمُ","نَصَّاً فأَبْدَى عَداوةَ الكَلِبِ",6,"ب",1,0],["من ثَغَبٍ باردٍ حصاه","منظم اللؤلؤ الشنيبِ",7,"ب",1,0],["مِنْ ثغرِ مَنْ أهوى ومبسمِهِ","سرقَ السحابُ البرْدَ والبرَدا",8,"د",2,1],["مِن ثَعلَبٍ غادَرَهُ عَفيرا","أَو أَرنَبٍ جَوَّرَها تَجويرا",9,"ر",2,0],["مِن ثَواءٍ فيهِ المَلالُ لِزامٌ","أَو رَحيلٍ فيهِ العَناءُ كَثيرُ",10,"ر",1,0],["مِن ثَيِّباتٍ لم تُبلْ","كشْفَ الخُدُودِ ولا المَعاصِمْ",11,"م",1,0],["مِنْ ثَمَرٍ قَلّ مَا يُنَافِسُهُ","فِي نَوْعِهِ بِالمُذَاقِ وَالعَبَقِ",12,"ق",1,0],["من ثمر الفرصاد في ذروته","الريانة المعطار كبش أحمر",13,"ر",1,0],["من ثغره كم من","كأس شربناه",14,"ا",2,0],["من ثياب الشام عود","ومن بيض وزرقا",15,"ق",2,0],["من ثبير ومن عسيب ورضوى","ولكام والطود من بيّاس",16,"س",1,0],["مِن ثَنايا العذراءِ لاح بريق","فجَرى مِن دموعِ عيني عقيقُ",17,"ق",1,1],["من ثغره نور التبسم ضاحكٌ","بأديمه ماء البشاشة صافِ",18,"ف",1,0],["من ثناياه ومن الحاظه","حكت نظمي ونسجت الغزلا",19,"ل",2,0],["منثنياً خلفَ رداءٍ لَهُ","قَد فَضَّضَتهُ الأَنجمُ الساهِدَه",20,"ه",1,0],["مَن ثَنى الجيدَ عمد طيرٍ برجمِ","يُرم حجراً مِن ثني عبد المجيدِ",21,"د",1,0],["مِن ثَغرِهِ وَحُلِيِّهِ وَنَسيمِهِ","ما لا تَقومُ بِكَتمِهِ الظَلماءُ",22,"ا",2,0],["مِن ثَمَّ ما ساغَ لي إِن قُلتَ تُشبِهُهُ","وَأَينَ شِبهُ ثَرىً مِن صَيِّبٍ هَطَلا",23,"ل",2,0],["من ثكالى وَلَجْن بابَ المآسي","شاحباتٍ يبكينَ فقد البنينِ",24,"ن",1,0],["مَن ثَنائِي طَوَى إليه الفَيافِي","وهْو من كلِّ ذِي اقترابٍ قريبُ",25,"ب",1,0],["من ثغورٍ رضابها من شمولِ","حبّذا أوْجُهٌ تروقُك وَصْفا",26,"ف",2,0],["من ثار في الناس لا تخشى عقيدته","إلا الإله فلم يردعه طغيان",27,"ن",1,0],["من ثراها ومن سماها ومن","كل الذي أنبتته فنا وفكرا",28,"ر",2,0],["مَن ثلَّ عرشَك واستقادك خاطماً","فانقدتَ يا قطَّاعَ تلك الأحبُلِ",29,"ل",1,0],["منثورُها ذاك ومنظومُها","هذا كلا الدرّين لم يُثقَبِ",30,"ب",1,0],["من ثُلوجٍ لها يُكَلِّلُ هاما","فَتُبيحُ الأنهارَ منهُ الهدايا",31,"ي",2,0],["منثور هذا الكتاب حين أتى","يسمو على الدر وهو منظوم",32,"م",1,1],["مَن ثَمَّ لَو شامَهُ الأَعداءُ مُنفَرِداً","شاموهُ وَاللَّه مِثلَ الجَحفَلِ اللّجبِ",33,"ب",1,0],["من ثناء كأسه اس","كر من كأس النديمِ",34,"م",1,0],["من ثغره متعبي بالعدل عنفني","فقلت دعني فلي في الثغر راحات",35,"ت",1,0],["منثورها زّين منظومها","زينة خود بلئاليها",36,"ي",3,0],["من ثنايا رشا شاكي السلاح","وسقيانها لمى لا صرف راح",37,"ح",1,0],["منثورُها فرعٌ عن الرقاعِ","والنسخُ في التقطيع والاوضاعِ",38,"ع",1,0],["من ثنايها وقاني خدها","متّ سكراً بالحميا والمحي",39,"ي",1,0],["من ثواني يراعِهِ فوقَ طرسٍ","فدُموعُ الحزينِ تأبى الثَّواني",40,"ن",2,0],["من ثَوى ساكِناً بصَنْعاءَ فالبَوْ","ن فما بينها إلى نَجْران",41,"ن",1,0],["مِن ثَناياهُ فَجَّرَ اللَهُ في الجَن","نَةِ لِلعاشِقينَ نَهر مُدامِ",42,"م",1,0],["مِنْ ثلاث شُهور مَا شِفْتِك","حَيّ هذا اليوم لِيْ يابك",43,"ك",1,1],["من ثابتين لدى الجلي وقد نفرت","قوم وسيان فيها العرب والعجم",44,"م",1,0],["من ثناء كالمثاني قد حلا","لذوي الذوق السليم الكمل",45,"ل",1,0],["من ثدي أُنثى ومن طه مراضعُه","فتلك منقبةٌ ما مثلها سُمعت",46,"ت",1,0],["من ثنى عنه الخيول باكنا","فها الخطية الشول",47,"ل",1,0],["من ثاكل حرى الفؤاد مروعة","أضحت تجاذبها العدى حبراتها",48,"ت",3,0],["مِن ثاكِلٍ تذرع البيدا وَمُرمِلةٍ","قَد جُشِّمَت نَهسَ أَقتاب وَأَحداج",49,"ج",1,0],["مِن ثَعابينَ حامِلينَ نُيوباً","عُصُلا ذابِلاً وَنَبلاً وَنَصلا",50,"ل",2,0],["مِن ثَمَّ جاءَت بِهِ وَالبَظرُ حَنَّكَهُ","كَأَنَّهُ في اِستِها تِمثالُ يُسروعِ",51,"ع",1,0],["مِن ثَمَّ للشَّمال يا ذكيُّ","فأَفضلُ الكواكبِ الجُدَيُّ",52,"ي",1,0],["منثوره درر في سمطه نظمت","نظماً بلاغته جاءت بأسرار",53,"ر",1,0],["من ثنايا الخطوب والارزاء","وثنايا الحروب والأشلاء",54,"ا",2,1],["من ثغر منضود كالدر النظيم","من ذاق ريقه عن الإحساس غاب",55,"ب",1,0],["منثورة ما اغتدى من قبلها أبدا","أزهى وأبهى من المنظوم منثور",56,"ر",1,0],["من ثم فاق ذوو العرفان وارتفعوا","قدرا على عابد بالجهل كالبهم",57,"م",1,0],["من ثغرهِ شهدي ومن","ألحاظه أتشهَّدُ",58,"د",1,0],["من ثديٍ لا تسقوني","اسقوني اسقوني البيلا",59,"ا",1,0],["منثورة في اللانهاية ما لها","أيد الزمان مع الزمان براح",60,"ح",1,0],["من ثرائي ومن سخائي عليه","لا بخيلا ذا ثروة ونفاق",61,"ق",1,0],["من ثنايا مقصورة أنا فيها","مثل سر في عالم النسيان",62,"ن",1,0],["مِنْ ثَغْرِها الوَضَّاحِ أَوْ خَدِّها","وَاخَجْلَةَ الجَوْهَرِ وَالعَسْجَدِ",63,"د",1,0],["من ثم صاح يا أياس الأكبرا","ويا منيلا يا أياس الأصغرا",64,"ر",2,0],["من ثم حلو صاهلات الجرد","ونزعوا زاهي السلاح الصلد",65,"د",1,0],["من ثم أفرغ فيه قدرته","فانقضَّ لا يرتد مبتعدا",66,"د",2,0],["من ثم فليرد الحمام كما","غزل القضاء سنيه مذ وجدا",66,"د",2,0],["من ثم قوسيذٌ بأسرته","هرعوا إلى السور الذي ارتقعا",66,"ع",2,0],["من ثم دردانوس منه نشا ال","مولى إرخثونٌ فتى الفطن",66,"ن",1,0],["من ثم أرسل رمحه فمضى","وعلى المجن سنانه وقعا",66,"ع",2,0],["من ثم غادره بموقفه","وخلاف هذا القول لم يقل",66,"ل",1,0],["من ثم آخيل انثنى وسعى","وفليذر ابن ملكهم صرعا",66,"ع",2,0],["من ثم أحدق ثم صاح به","هي ادن فالموت الزؤام هنا",66,"ن",2,0],["من ثم من موليس اقتربا","وبصعدةٍ ذاك الفتى ضربا",66,"ب",2,0],["من ثم تعرض للهوان على القنا","أفتلبثن عن الكفاح بمعزل",67,"ل",1,0],["مِن ثَمَّ للمِغفَرِ أَتريذُ عَمَد","يَلبَسُهُ مِن بَعدِ هاتيكَ العُدَد",68,"د",1,0],["مِن ثَمَّ إِليونَ أَتاها بَرّا","فَذا الذي أَتىريذَ رامَ كِبرا",68,"ر",2,0],["مِن ثَمَّ أَلقَت فَوقَها دَسيعَه","مُؤَلَّقٌ نُحاسُها بَديعَه",68,"ه",1,0],["مِن ثَمَّ أَعدَدنا الضَحياي الغُرّا","لِزَفسَ نَستَمِدُّ مِنهُ النَصرا",68,"ر",2,0],["من ثم في خيمته فليقم","مأدبةً تضمن صافي التواد",69,"د",1,0],["من ثَمَّ عَنِّي غَابَ مُحتَجِباً","لَكِنَّني أُهبِبتُ مُضطَراَّ",70,"ر",2,0],["مِن ثَمَّ أَتبَعَهُ فيلونَ يَلحَقُهُ","أُرمينُ عَن طَعنةٍ في جَوفِهِ مَرَقَت",71,"ت",1,0],["مِن ثَمَّ بَينَ يَدَيهِ مُمسِكاً جَذَبا","إِحدا داعائِمِ سَطحِ السورِ فاَضطَرَبا",71,"ب",2,0],["مِن ثَمَّ تُوقِظُ في لَهفٍ جَوَارِيَها","وَينتَحِبنَ بِدَمعٍ فاضَ مُنسَكِبِ",72,"ب",1,0],["مِن ثَمَّ بادَرَهُ وأَوهنَ ظَهرَهُ","بالصَّولَجانِ بضَربَةٍ دَمَوِيَّةِ",73,"ه",1,0],["من ثناياك استعارت حببا","ومن الريق طلاها تستعار",74,"ر",1,0],["من ثريا عنقودها عصرت","شمساً أضاءت بها جميع العصور",75,"ر",1,0],["من ثريا عنقودها عصرت شم","سا أضأت بها جميع العصور",76,"ر",1,0],["من ثابتُ دون الكُماةِ سواه إنْ","زلّتْ بهم أَقدامُهم في الموقفِ",77,"ف",1,0],["مُنثني العطفِ مُنتشي الطرفِ في في","هِ الحُميا وطَرْفُهُ المخمورُ",78,"ر",1,0],["مِن ثُلثِ قَرنٍ ذا وَخَمسٍ قَد قَضى","بِهُدىً وَأَفتى والدراسَةَ يَلزَمُ",79,"م",1,0],["مِن ثَغرِ مَن سَبَتِ الأَلبابَ ثُمَّ رَنَت","إِلى الوُشاةِ وَقالَت لي أتَّخِذ سَبَباً",80,"ب",2,0],["من ثم تبدو لهم الأعلام","وتكثر الصلاة والسلام",81,"م",1,0],["من ثرى قبره استفدنا ثراء","فتساوى الممدود والمقصور",82,"ر",1,0],["من ثراه لي ثروة وحذاف","ير دعاني بهنَّ أغنى معيل",83,"ل",1,0],["من ثقات محققين لهم","في الحكم آيات بيناتٌ جليَّة",84,"ي",2,0],["من ثقّله فاز به","من خفّ خسرانيه",85,"ن",3,0],["من ثغر طفل يستغيث وطفلة","في حالة من أسوء الحالات",86,"ت",1,0],["من ثمار الحرف يحلو ال","مُرُّ عن قيل وقال",87,"ل",1,0],["من ثغرك العذب احتسا","قلبي قوانين الهبال",88,"ل",1,0],["مِنْ ثلجِ أيامي تجمّدتْ الرؤى","ويظلُّ نبضيَ في التمنّيَ موقَدَا",89,"د",2,0],["منْ ثغرِكَ الشِّعرُ سَلسانٌ بلا وَتَرٍ","فالحرفُ يصدو ويشدو مَنْ بهِ طَرِبا",90,"ب",2,0],["مِنْ ثَنَايَا الْفُؤَادِ مَجَّتْ ثِمَارٌ","سُكَّرٌ سَاحَ مِنْ صَفَاهُ الْشِّفَاءُ",91,"ا",2,0],["من ثمَّ أصحو من غياهبِهِ","وأمدُّ منهُ لدفتري جِسرا",92,"ر",2,0],["من ثغرها الخمري خمري ومن","ألحانها تسمعني معبدا",93,"د",2,0],["مِنْ ثغركِ القُرمزيِّ الوعدُ أقطفهُ","مِنْ بوحكِ البحَّةُ الغنَّاءُ والدررُ",94,"ر",1,0],["من ثم أدركت أني ليس من غرضي","أبكي المكان واستبكي الأولى نزلوا",95,"ل",3,0],["مِنْ ثَغرِهِ يَنسابُ شَهْدُ بلاغةٍ","صِدقاً ويعرفُ للقلوبِ سَبيلا",96,"ل",2,0],["من ثغري الزاد منزوعٌ لثغرهمُ","للآن حتّى وهم فوق العُلا قممُ",97,"م",1,0],["من ثنايا الآلامِ جئتم نذيرًا","من صَداهُ قد زلزل الأشرارُ",98,"ر",1,0],["من ثمّرَ الخير الوفير بسعيه","وكأنه غيث السما مدرار",99,"ر",1,0],["من ثورة العشرين صارَ لباسُنا","ارث ُالكرام ِعلى الكرامِ مفصّلُ",100,"ل",1,0],["من ثورةِ الأحرارِ نبني بيتَنا","للدَّربِ من أطيافِها أنوارُ",101,"ر",1,0],["مِنْ ثَوْبِ مِيلَادٍ تَجَلْبَبَ لَيْلُهُ","وَ اسْتَمْتَعَتْ بِضِيَائِهِ الظَّلْمَاءُ",102,"ا",2,0],["من ثُلْث قرنٍ لم أشاهد كُوةً","بشعاعها تتكحل العينانِ!",103,"ن",1,0],["من ثلث قرنٍ لم يعطر بيتنا","زهرٌ ولا أصغى إلى كروانِ",103,"ن",1,0],["من ثلث قرن والعذاب يَسُوطني","وأنا أُجالدهم على الغُدرانِ",103,"ن",1,0],["من ثَمَّ أوْصى جزاءً للحمارِ بأنْ","يُعْطى الوزارةَ مخْفوراً بحُجّابِ !",104,"ب",1,0],["مِنْ ثَمَّ عادَ لَدَيْهِ خَيْرُ هَدِيَّةٍ","تَحْوي الصَّلاة َوَأجْرَها المرْقوما",105,"م",2,0],["مِنْ ثَمَّ قال السهدُ : واألمي","كمْ مقلةٍ للنوم تفتَقِرُ !",106,"ر",1,0],["منثور بك ود وغلا ماله اجناس.","ياللي ملكت القلب لملم عشيرك.",107,"ك",1,0],["من ثقل همي قو حيلي تهدد","ياونتي من جاير الوقت لازاد",108,"د",1,0],["مِنْ ثمَّ تأتي بيومِ الحشْرِ عاريَةً","لا ينْفَعنَّكِ إلا الحُسْنُ في العمَلِ",109,"ل",1,0],["من ثمان الا ربع وانت ما انت اللي زمان","انت صرت انسان ثاني ما اعرفه من تكون",110,"ن",1,1],["مِنْ ثَغْرِهَا تُهْدِي الْلَّطِيفَةُ وَرْدَةً","غَمَرَتْ حَيَاتِي كُلَّهَا بِشَذّاهَا",111,"ا",3,0],["منثورهُ الدرُّ فاحَ النورُ مُذ نطقا","يا ذلك الروحُ فجرٌ خيطَهُ نَظَما",112,"م",2,0],["من ثغْر ِ\"عبلتِها\" وبَيْن ِ\"سُعادِها\"","تهمي دموعُ العاشق ِالولهان ِ",113,"ن",1,0],["منثورُ لفظٍ كمعروفِكَ ال","جَميلِ الذي لم يُكَدَّرْ بِمَنّْ",114,"ن",1,0]]}