em.aspx?id=29435",""],[4797,"عقب اربعين سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=180552",""],[4984,"فيا رمضان الجد","https://www.poetsgate.com/ViewPoem.aspx?id=175575",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""],[460,"سرى لكَ طيفٌ زارَ من أمِّ عاصمِ","https://www.poetsgate.com/ViewPoem.aspx?id=22234",""],[5055,"ورد وتهاني","https://www.poetsgate.com/ViewPoem.aspx?id=103660",""],[5061,"قصيدة المواد","https://www.poetsgate.com/ViewPoem.aspx?id=147164",""],[5183,"مُلغِزَه رق293م","https://www.poetsgate.com/ViewPoem.aspx?id=186399",""],[5183,"رداء الحياء","https://www.poetsgate.com/ViewPoem.aspx?id=186498",""],[5183,"إلى البهلاني","https://www.poetsgate.com/ViewPoem.aspx?id=180208",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5606,"ترى مافي حبيش الاسنامه","https://www.poetsgate.com/ViewPoem.aspx?id=194247",""],[5606,"يامرحبا ترحيبة دايم الدوم","https://www.poetsgate.com/ViewPoem.aspx?id=195279",""],[5606,"يدوم لك البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=197840",""],[5732,"يامرجع ليعقوب غاليه","https://www.poetsgate.com/ViewPoem.aspx?id=177866",""],[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[6056,"الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=130328",""],[6056,"الأصل غلاّب","https://www.poetsgate.com/ViewPoem.aspx?id=156709",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[240,"ألا أبلِغْ عمادَ الدينِ عنّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26486&r=&rc=11",""],[276,"أغيبُ وذو اللطائفِ لا يغيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59272&r=&rc=11",""]],"verses":[["وَراعَهُم ما رأَوْا مِنهُ وَلَيسَ لَهُ","دَمٌ عَلَيهِم وَلافي قَومِهِم ثارُ",0,"ر",1,0],["وَراعِ رَعاكَ اللَهُ أَحوالَ كُوفَنٍ","وَنَقِّرْ هَداكَ اللَهُ عَنَّا وَفَتِّشِ",1,"ش",1,0],["وراعَ صاحبُ كسرى أنْ رأى عُمَراً","بين الرَّعيّةِ عُطلاً وهو راعيها",2,"ي",3,0],["وراعيتَ غيري وأغفلتني","خلافاً لميزانِكَ القائمِ",3,"م",1,0],["وَراعَ إِلى النيرانِ كُلُّ مُعَصَّبٍ","لَمُثنٍ عَلى بَكرٍ بِشَرِّ أَثامِ",4,"م",1,0],["وراعت العين امواج قد اصطخبت","كأنهن عفاريت وجنان",5,"ن",1,0],["وَراعَكَ ما راعَ مِن خَيلِ قَمبي","زَ تَرمي سَنابِكَها بِالشَرَر",6,"ر",1,0],["وَرَاعَها أَنَّ دَمْعاً فاضَ مُنْتَشِراً","لا أَوْ تَرَى كَبِدي للحُزْنِ تَنْتَثِرُ",7,"ر",1,0],["وراعَ جَنانِي نبأةُ الخطبِ بعدَهْ","ويا رُبَّما هانتْ عليَّ زماجِرُهْ",8,"ر",2,0],["وراعَني ووراءَ الليلِ طاردُه","وَرْيٌ من الشَّيبِ في آثارِها لَهَبُ",9,"ب",1,0],["وَراعٍ يُراعِ اللَيلَ في حِفظِ أُمَّةٍ","يُدافِعُ عَنها الشَرَّ غَيرَ رَقودِ",10,"د",1,0],["وراعٍ سوامُ الشمسِ لم يَشوِ وجهها","ولا لاح للتلويح منه شحوبُ",11,"ب",1,0],["وراعٍ لهُ ردْفٌ وشعرٌ كأنما","كثيبٌ مهيلٌ فوقَهُ حيةٌ تسعى",12,"ع",2,1],["وَراعَ الكرائِمَ فَاسْتَلَّها","وأَطلقَها مِن وَراءِ السُّتُرْ",13,"ر",1,0],["وَراعِها وهِيَ في الأعمالِ سائِمَةٌ","وإنْ هِيَ اسْتَحَلَتِ المَرعَى فلا تُسِمِ",14,"م",1,0],["وراعى النّجومَ فأعشَيْنَه","فباتَ يظنُّ الثّريّا السُّهَى",15,"ا",1,0],["وَراعَنا في ميمِهِ كافِرٌ","خَليفَةُ الشَمسِ وَتستيرُ",16,"ر",1,0],["وَراعَني لِلحِسابِ ذَكَرٌ","وَغَرَّني أَنَّهُ بَعيدُ",17,"د",1,0],["وَراعَ بِقَهرٍ مِن جَناحَكِ آمِناً","فَظَلَّ عَلى الريشِ النُهوضُ مُحَرَّما",18,"م",2,0],["وَرَاعَهُمُ ذَلِكَ التَّوْأَمَا","نِ وَطَوْقَاهُمَا مِنْ دَمِ الأَكْبُدِ",19,"د",1,0],["وَرَاعَ نَوَاظِرَنَا أَيِّلٌ","مَضَى قَرْنُهُ صُعُداً وَانْشَعَبْ",20,"ب",1,0],["وَرَاعَ فِي شُهُبِ مِنْ جِيلِهِ سَطَعَتْ","فَلْيَغْدِ في جِيلِهِ مِنْ أَرْوَعِ الشُّهُبِ",21,"ب",1,0],["وراعت الطائرَ الظمآنَ هيبتُه","فمرَّ وهو جبانٌ فوقَه حذِر",22,"ر",1,0],["وراعٍ سوامُ الشمسِ لم يَشْوِ وجهه","ولا لاح للتلويح منه شحوبُ",23,"ب",1,0],["وراعى النّجومَ فأعشَيْنَه","سأفُضّ بين يديْهِ هذا المِقنَبا",24,"ب",2,0],["وراع بعين العطف ضعفي لاجتلي","معاني رسول الله منك مدى عمري",25,"ر",2,0],["وراعيا جماجماً صلابا","ومجرياً دماءها عبابا",26,"ب",2,0],["ورَاعِ حقهما في كلِّ منزلةٍ","فإنّ برَّهما من أطيبِ السَّيَرِ",27,"ر",1,0],["وَراعَ الأَعادي أَنَّهُ المُلكُ عَن يَدٍ","إِلى أُختِها وَهيَ اليَمينُ تَنَقَّلا",28,"ل",2,0],["وراعهم ما رأوه من جراءته","ومن تعاطى عظيم الكفر والكذب",29,"ب",1,0],["وراعِ الأمانةَ والزمْ لها","شروطَ المروءةِ أيَّ التزام",30,"م",1,0],["وراعيت أحوال الرعيّة مشفقا","فدرت عليهم بالنقيّ المكاسب",31,"ب",1,0],["وَراعَهُنَّ بِوَجهي بَعدَ جِدَّتِهِ","شَيبٌ تَفَشَّغَ في الصُدغَينِ فَاِشتَعَلا",32,"ل",2,0],["وَراعِ لَها ما أَسلَفَت مِن مَوَدَّةٍ","وَما أَحكَمَتهُ مِن ذِمامٍ وَمِن إِلِّ",33,"ل",1,0],["وَراعِ حُقوقَ مُرسِلِهِ قَديماً","وَعَجِّل مَااِستَطَعتَ لَهُ الإِيابا",34,"ب",2,0],["وَراع حمايتي وَتول نصري","وَشد عراى ان عرت الخطوب",35,"ب",1,0],["وراع فتى قد شاع بالكذب وصفه","ولا تعتمد في قوله قبل امعان",36,"ن",1,0],["وراع طوت نايَهُ السافياتُ","وغاب بجوف الروابي صداه",37,"ه",1,0],["وراعِ في القُرْبِ أو في البُعْدِ أمْرَ فتىً","عليكَ وحدَك بعد اللهِ مُتَّكَلي",38,"ل",2,0],["وراعَني يومَ تَشْييعي هَوادجَهمْ","والعيسُ من عَجَلِ في السّيْرِ تَبتَرِك",39,"ك",1,0],["وراعَهم أن لم يَرَوا قَبلَها","يَراعَة في يَدِ ذي لِبدَتَين",40,"ن",1,0],["وَراعَ قُلوب الحاسِدين يَراعهُ","بِما يَقتَضيهِ مِن بَدائع تِبيان",41,"ن",1,0],["وَراعها حَرُّ أَنفاسي فَقلت لَها","هَوايَ نارٌ وَأَنفاسي مِنَ الشَرَرِ",42,"ر",1,0],["وَرَاعَوْها وَمَا ليَ غَيْرُ جَفْني","وأَجْفانِي لِسِرْبِهِمُ رِعاءُ",43,"ا",2,0],["وراعِ فيَّ همّةً أهزلتَها","بالصدِّ وارجِعْ بي إلى إسمانِها",44,"ن",3,0],["وراعِ في الإمكان ما أغفلت","منّيَ عينُ المحرِجِ المرهِقِ",45,"ق",1,0],["وراعتْ سَراةَ الحَيِّ منه مَهابةٌ","أعادتْ فصيحَ الحيِّ وهو مُجمْجِمُ",46,"م",1,0],["وَراعِهِ حَقَّ مُراعاتِهِ","إِن شِئتَ بِالطاسِ أَو الجامِ",47,"م",1,0],["وراعني لا راعني بعدها","للبين اِرعادٌ واِبراقَ",48,"ق",1,0],["وَراعَنِي مِنهُ دَمعٌ كَادَ يَغسِلُنِي","أَعُوذُ بِاللهِ من آثَامِ ذِي الظُنَنِ",49,"ن",1,0],["وَراعَتهُ أَماراتٌ لِأُمٍّ","بَدَت لِلقُطبِ عَيناً كِالشُهودِ",50,"د",1,0],["وراع الرعايا باهتمام وفطنة","ووالهم بالفضل يا متفضل",51,"ل",1,0],["وَرَاعتْكَ لها عِيْسٌ","لِوَشْكِ البَيْنِ مَحْدُوجَهْ",52,"ج",2,0],["وراعك أن الظلم خيم مطبقاً","ففي الهضب ما في السهل منه وفي الحزن",53,"ن",1,0],["وراعي أمَّةٍ لَولاه عانا","بِشرخِ شُعوبِها لاقَت شُعوبا",54,"ب",2,0],["وراع مراعاة العيان لكي ترى","بمرآك أعيان المعاني العلية",55,"ه",1,0],["وراعيته إذ لم يراعوه ضلةً","وصار لديهم منهلاً أي منهلِ",56,"ل",1,0],["وراعينا به الوحْشَ","يراعي سِرْبُه خِيطَه",57,"ط",2,0],["وراعُوا حفظ داركم بعدل","فمأرب إذ عَدت رُميَت بطمسِ",58,"س",1,0],["وراع منها مرحٌ مُستيهر","كأنه إعصارُ ريح أغبرُ",59,"ر",1,0],["وراع نجيب الغيم واجر رعده","كما ارتاع من صوت الجلاجل ذيب",60,"ب",1,0],["وَرَاعَى الغُصْنُ ناظِرَ مِعْطَفَيْهِ","وَقَالَ كَذَا مُرَاعَاَةُ النَّظِيرِ",61,"ر",1,0],["وراع اتباع الحق في كل لحظة","ولاحظ علاه عند كل تنفس",62,"س",1,0],["وَراعِ بالبَيْنِ مُهْجَةً تَلِفَتْ","لولا قدومُ السُّلطانِ لم تَخُشِ",63,"ش",1,0],["وراعكَ ما بدا لك مِنْ ولوعي","بكأْسِ الرَّاحِ أَو كأَسِ الرُّضابِ",64,"ب",1,0],["وراعها ما اتته","فاسرعت تتخبى",65,"ب",2,0],["وراعى حق من أولاك علما","تفيد به سواك وتستفيد",66,"د",1,0],["وراعيتنا اذ عفت فينا يراعه","وما فضله معنا سوى خط معناه",67,"ا",2,0],["وراعِ اختلالي سراً ولا","تراع رباء اختلالي جهارا",68,"ر",2,0],["وَراعَ لِأَعقابِ العَشيرَةِ حافِطٍ","يَجودُ بِمَعروفٍ كَثيرٍ لِسايِمٍ",69,"م",1,0],["وراعِ حدودَ اللَهِ لا تتعَدّها","وصَغِّر وعظِّم ما أهانَ وعظَّما",70,"م",2,0],["وراعِ حقوقَ الضيفِ والجارِ إنَّهُ","لعَمرُكَ أوصى أن يُبَرَّ ويُكرَما",70,"م",2,0],["وراعهمُ زأرُهُ فيهمُ","ولو كانَ في غيرهمْ ما عوى",71,"ا",1,0],["وراعك يوم ذات الاثل ظعن","ألَّح عليك بالزفرات وخدا",72,"د",2,0],["وَراعى الحَضرَمِيَّةَ في الَّذي قَد","جَنى مِن وُدِّه وَردَ الجِنانِ",73,"ن",1,0],["وَراعَيتَ الَّذي راعى شَبيبٌ","سَقَت مَثواهُ سارِيَةٌ هَتُونُ",74,"ن",1,0],["وَراعَهُ صَوتُ قَنّاصٍ بِعَقوَتِهِ","مُقَلَّدينَ الضراءَ القِدَّ وَالعَقَبا",75,"ب",2,0],["وراعوا حقوق الناس من كل مسلم","غريب ومكين ضعيفٍ ومضطر",76,"ر",1,0],["وَراعُوا خِلالاً كُنَّ في مَكرُماتِكُم","لكُم سَلِمَت فيها السَعادَةُ والبُشرى",77,"ر",2,0],["وراعيت عهد الود منهم لذمة","تراعى واصلاح الطعام على الملح",78,"ح",1,0],["ورَاعو نعمَةً لله رَبِّي","تعاظَمَ لَم يَرُم ولداً وعرسَا",79,"س",2,0],["وَراعها وَهي في الأعمال سائمة","وَنم بعين وَبالأخرى فَلا تنم",80,"م",1,0],["وراعها وَهيَ في الأَعمال سائِمة","فَإنَّها العُروة الوثقى لملتزم",81,"م",1,0],["وراعها بجثيّ في بواطنها","ويل النفوس وفي مقذوفها الحرب",82,"ب",1,0],["وراع مهما اسطعت قُربَ الرمسِ","وآثر الصلاة عندَ الرأسِ",83,"س",1,0],["وراعِ في ذلك حال الأكثرِ","وما به يكثُرُ نفعُ الحضر",84,"ر",1,0],["وراعَ قتادة من عاره","بأزرق زَاحَم منه الكَلل",85,"ل",1,0],["وراع الفصل والأقطار واحكم","نظافتها فأنت بها وصي",86,"ي",1,0],["وَرَاعِ ذَا التَّرتِيبَ إلاَّ فِى الذِى","كلَيتَ فِيها أو هُنا غَيرَ البَذِى",87,"ذ",2,0],["وراعي رُعاةِ اللَهِ في كل بِيعةٍ","مَنُوطٌ على أَحكامِهِ الحُكمُ والفصلُ",88,"ل",1,0],["وراعَ الأَعادي والحواسدَ جَمَّةً","كما رَوَّعَت قلبَ البُغاثِ الجوارحُ",89,"ح",1,0],["وَراعَ لَهُ حُسن الوِدادِ وَإِن نَبا","زَمانٌ وَلا تَسمَع مَقالَةَ مُجرِمِ",90,"م",1,0],["وَراعِ لِإخوانِ الصَفاءِ حُقوقَهُم","وَإِن أَنتَ ضَيّعتَ الوَفا خِلِّ تَندَمِ",90,"م",1,0],["وراع حقاً عندما تغلي النفوسْ","رُبَّ سكوتٍ كالجواب في الأسوسْ",91,"س",1,0],["وراعت فؤاد الدهر منه بأروع","تناشد غسان فتسمع تغلب",92,"ب",1,0],["وراعهم صرع ملكهم","فولوا وقد جلت الأربى",93,"ب",2,0],["وَراعَ أَنجالُهُ الأَنجابَ سادتنا","مَن زَينوا فَضلهم في حليةِ الأَدَبِ",94,"د",2,0],["وَراعى مَجد وَالينا بِعَينٍ","تَصونُ حَياتهُ خَيرَ الصيانِ",95,"ن",1,0],["وراعهم يوم جبر انهم فقدوا","من عصبة العلم احناهم على الكتب",96,"ب",1,0],["وراعي شعب لبنان عدولاً","لأن العدل في الدنيا خديني",97,"ن",2,0],["وراعها عجباً أن رُحتُ في سَمَلٍ","وما دَرَت دُرُّ أنَّ الدرَّ في الصَدَفِ",98,"ف",1,0],["وراع أبا البيضاء فيه وحزبَهُ","بني أصفرٍ جيشٌ تجيشُ مقانبه",99,"ب",2,0],["وراعَ قلبي سائقُ الركب بكم","والشيبُ فيكم لشَبابي روعا",100,"ع",2,0],["وراعكَ من خيلهِ حاشرٌ","من القومِ ليست لهُ قبلَه",101,"ل",2,0],["وَراعِ فَهمَ الناسِ","تَكُن 