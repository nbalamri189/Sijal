ا وإني","https://www.aldiwan.net/poem37964.html","الوافر"],[513,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[549,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[549,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[551,"قطعت قتول قرينة الحبل","https://www.aldiwan.net/poem68394.html","الكامل"],[551,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[556,"ربنا الله ذلك المتعالي","https://www.aldiwan.net/poem34231.html","الخفيف"],[556,"أيها الناي عندك الخبر","https://www.aldiwan.net/poem34554.html","الخفيف"],[560,"كلفت حمل تحيتي ريح الصبا","https://www.aldiwan.net/poem52966.html","الكامل"],[560,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[560,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[562,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[565,"كلف الفؤاد بجاره","https://www.aldiwan.net/poem69602.html","مجزوء الكامل"],[565,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[565,"كلف الفؤاد بشادن أبصرته","https://www.aldiwan.net/poem69765.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[573,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[584,"كلفت بمحبوب كثير حياؤه","https://www.aldiwan.net/poem17484.html","الطويل"],[584,"له مني المحبة والوداد","https://www.aldiwan.net/poem17485.html","الوافر"],[584,"كلفت بحب مستوفي","https://www.aldiwan.net/poem17499.html","مجزوء الوافر"]],"verses":[["كُلُّ فَرعٍ مالَ جانِبُهُ","فَكَأَنَّ الأَصلَ سَكرانُ",0,"ن",1,0],["كُلُّ فَتىً يَفضَحُ أَطواقَهُ","وَجهٌ مُضيءُ الجيدِ وَالمَلطَمِ",1,"م",1,0],["كَلَّفتَ عَينَكَ نَظرَةً مَزؤودَةً","مَنَعَتكَ لَذَّتَها مَدامِعُ تَسفَحُ",2,"ح",1,0],["كَلِفتُ بِالشَمسِ مَن رَأى رَجُلاً","بِالشَمسِ يا قَومُ قَلبُهُ كَلِفُ",3,"ف",1,0],["كلِفَتْ نُفوسُ النّاسِ منْهُ بأرْوَعٍ","جَذْلانَ لا بَطِرٍ ولا تَيّاهِ",4,"ه",1,0],["كَلِفٌ بإِدْرَاكِ الْمَعَالِي هَائِمٍ","صَبٍّ بِأَبْكَارِ الْمَكَارِمِ مُغْرَمِ",5,"م",1,0],["كلِفْنا بهِ في سِياقِ الحَديثِ","فقُمْنا نُعاقِرُ فيهِ العُقارا",6,"ر",2,0],["كَلِفْتَ بالْبَدْرِ وَالأَقْدَارُ غَالِبَةٌ","تَقْفُو مَدَارِجَهُ طَوْراً وَتَعْتَقِبُ",7,"ب",1,0],["كَلِفُ الْجَنَانِ إِذَا جَرَى ذِكْرُ الْحِمَى","وَالْبَانِ حَنَّ لَهُ حَنِينَ النِّيبِ",8,"ب",1,0],["كَلَّفتُ عانِسَةً أَمو","ناً في نَشاطِ هِبابِها",9,"ب",3,0],["كَلَّفتُ مَجهولَها نَفسي وَشايَعَني","هَمّي عَلَيها إِذا ما آلُها لَمَعا",10,"ع",2,0],["كَلَّفتُها حُرَّةَ اللَيتَينِ ناجِيَةً","قَصرَ العَشِيِّ تُباري أَينُقاً عُصُفا",11,"ف",2,0],["كَلِفٌ بِمَحمودِ الخِلالِ مُتَيَّمٌ","بِالبَذلِ بَينَ يَدَيكِ وَالإِنفاقِ",12,"ق",1,0],["كَلِفَت بِها وَتَمَسَّكَت","قَبلَ الفَيالِقِ وَالجَواري",13,"ي",1,0],["كِلَفٌ بِنَفْعِ بِلاده مُتَغَمِّدٌ","ذَنْبَ المُسِيءِ إِلَيْهِ بِالغُفْرَانِ",14,"ن",1,0],["كُلُّ فِعْلٍ لِلْخَيْرِ سَاهَمَ فِيهِ","وَأَجَابَ الدُّعَاةَ أَيّاً كَانُوا",15,"ن",3,0],["كل فعل الدهر فعل","فيه للحرّ إِساره",16,"ر",2,0],["كل فَخار أسبابه انقطعت","إلا فخاراً يكون من سببه",17,"ب",2,0],["كَلَّفتُ حاجَةَ ما أُكَلِّفُ ضُمَّراً","مِثلَ القِسِيِّ مِنَ السَراءِ بُرينا",18,"ن",2,0],["كَلَّفتُ لاحِقَةَ النَميلِ خَوامِساً","غُبرَ المَخارِمِ وَهيَ خاشِعَةُ الصُوى",19,"ا",1,0],["كَلَّفتُ مَن حَلَّ مَلحوباً فَكاظِمَةً","أَيهاتَ كاظِمَةٌ مِنها وَمَلحوبُ",20,"ب",1,0],["كَلَّفتُ صَحبِيَ أَهوالاً عَلى ثِقَةٍ","لِلَّهِ دَرُّهُمُ رَكباً وَما كَلِفوا",21,"ف",3,0],["كَلِفٌ بِعارِيَةِ الوَظيفِ شِمِلَّةٍ","يَمشي خِلالَ الشَريِ في خيطانِ",22,"ن",1,0],["كلفت بشائبٍ لا عذلَ يثني","جماحي في هواهُ ولا لجاجي",23,"ي",1,1],["كلفت به من قبل ما طال قدّه","فطوّله فرطُ العناق المردَّد",24,"د",1,0],["كلفت بهِ حلوَ اللَّمى بابليه","فمن أين يحلو عنه للمرء صبره",25,"ر",2,0],["كلفتموني مواريثَ الذين قضوا","من الغرامِ فهل للوصلِ مرتجع",26,"ع",1,0],["كل فعال العلاء يعجبني","كأنني بالعلاء مفتون",27,"ن",1,1],["كَلَفٌ في شُحوب وجهك يَحْكي","نُكَتاً فوق وَجْنَةٍ بَرْصاءِ",28,"ا",2,0],["كلَّف النفس خطة","لم تطقها وغرَّها",29,"ر",3,0],["كلَّفتُه حملي إليك فخفَّ بي","وابتاع خطوته بقرب أليفه",30,"ف",2,0],["كلَّفْتُ تخفيف ما امتَننْتَ به","شُكريك فازداد كاهلي ثِقلا",31,"ل",2,0],["كلفتني ما تستحق وبعضُه","ثقل على المتكلفين ثقيلُ",32,"ل",1,0],["كُلُّ فحْلٍ أبوك عدْلاً من اللَ","هِ وعيسى بلا أبٍ كاليتيم",33,"م",1,0],["كَلَّفتُمونا أُناساً قاطِعي قَرَنٍ","مُستَلحَقينَ كَما يُستَلحَقُ اليَسَرُ",34,"ر",1,0],["كَلَفتُ بِها بَيضاءَ سَكرى مِنَ الصِبا","وَما شَرِبَت خَمراً وَلا هِيَ تَشرَبُ",35,"ب",1,0],["كَلِفٌ بِأَصحابِ التَعَبُّدِ وَالتُقى","وَالشَرُّ ما بَينَ التَعَبُّدِ وَالتُقى",36,"ق",2,0],["كَلَفَت بِها نَفسي وَدونَ وُصولِها","وَصلُ المَنونِ وَثَمَّ لَيثُ عَرينِ",37,"ن",1,0],["كُلُّ فَضلٍ في الوَرى أَض","عافُهُ فيكَ فُضولُ",38,"ل",1,0],["كَلِفتُ بِهِ أَحوى الجُفونِ مُهَفهَفاً","مِنَ الظَبيِ أَحلى أَو مِنَ الغُصنِ أَرشَقا",39,"ق",2,0],["كَلِفتُ بِغُصنٍ وَهوَ غُصنٌ مُمَنطَقٌ","وَهِمتُ بِظَبيٍ وَهوَ ظَبيٌ مُشَنَّفُ",40,"ف",1,0],["كَلِفتُ بِها وَقَد تَمَّت حِلاها","وَزَيَّنها المَلاحَةُ وَالوَقارُ",41,"ر",1,1],["كَلِفتُ بِشَمسٍ لا تَرى الشَمسُ وَجهَها","أُراقِبُ فيها أَلفَ عَينٍ وَحاجِبِ",42,"ب",1,1],["كَلَّفتُ مَجهولَها نوقاً يَمانِيَةً","إِذا الحُداةُ عَلى أَكسائِها حَفَدوا",43,"د",3,0],["كلفوك الزلفى فلم تستطعها","ليتهم كلفوك ما تستطيع",44,"ع",1,0],["كلفوا صافعا به وهو لا يد","رى لذا راح صافعا كفه",45,"ه",1,0],["كَلِفٌ بحبَّاتِ القلوب كأنَّما","يبغي الوقوفَ على الضميرِ المودَعِ",46,"ع",1,0],["كَلِفاً بِشِعبِ نُقانَ يَعلَمُ أَنَّهُ","لاقٍ مَتى مازالَ عَنهُ شَعوبا",47,"ب",2,0],["كَلَّفتُمونا حُدودَ مَنطِقِكُم","في الشِعرِ يُلغى عَن صِدقِهِ كَذِبُه",48,"ب",2,0],["كَلَّفتَني قَدَراً غَلَّت ضَرورَتُهُ","عَزيمَتي وَقَضاءً ما أُغالِبُهُ",49,"ب",2,0],["كَلَّفَتني تَحَمُّلَ اِبنَي شَمامٍ","نُوَبٌ مِن تَحَمُّلِ اِبنَي سَميرِ",50,"ر",1,0],["كَلَّفَتني الخَرقاءُ إِنجاحَ سَعيِ","أَوَ ما قامَتِ الحُظوظُ بِعُذري",51,"ي",1,0],["كَلِّفهُ حاجاتِكَ يَقعُد بِها","مُكَلَّفٌ بِالبُخلِ مُستَهتِرُ",52,"ر",1,0],["كَلِفٌ يُكَفكِفُ عَبرَةً مُهراقَةً","أَسَفاً عَلى عَهدِ الشَبابِ وَما اِنقَضى",53,"ض",2,0],["كَلَّفَني فَوقَ الَّذي أَستَطيعُ","مُعتَزِمٌ في لَومِهِ ما يَريع",54,"ع",1,1],["كَلَّفتُها الصَبرَ فَاِعتاصَت مُمانِعَةً","وَسامَحَت لَكَ إِذ كَلَّفتُها الجَزَعا",55,"ع",2,0],["كَلِفٌ بِجَمعِ الخَرجِ يُصبِحُ لُبُّهُ","مُتَفَرِّقاً في إِثرِهِ مُتَقَسَّما",56,"م",2,0],["كَلَفي ما أَراهُ عَنى يَريمُ","وَصُروفُ النَوى عَذابٌ أَليمُ",57,"م",1,1],["كَلَفُ البيضِ بِالمُغَمَّرِ قَدراً","حينَ يَكلَفنَ وَالمُصَغَّرِ سِنّا",58,"ن",2,0],["كَلَّفَتني أَريَحيّاتُ الصِبا","طَلَقاً في الشَوقِ مُمتَدَّ السَنَن",59,"ن",1,0],["كَلِفٌ بِحُبِّكِ مولَعٌ وَيَسُرُّني","أَنّي امرُؤٌ كَلِفٌ بِحُبِّكِ مولَعُ",60,"ع",1,0],["كَلِفٌ بِدُرِّ الحَمدِ يَبرُمُ سِلكَه","حتَّى يُرى عِقداً عليه منظَّما",61,"م",2,0],["كَلِفٌ ضاقَ في الجَوانحِ مَثْوا","هُ ودَمْعٌ تَضيقُ عنه المآقي",62,"ق",2,0],["كَلِفٌ تَذَكَّرَ قبلَ ناهيةِ النُّهى","ظِلَّيْنِ ظِلَّ هوىً وظلَّ حَديقِ",63,"ق",1,0],["كلُّ فتاةٍ نشأَتْ بجُورِ","تختالُ في مِدرَعِها القَصيرِ",64,"ر",1,0],["كَلَّفتُها عِرمِساً عُذافِرَةً","ذاتَ هِبابٍ فَعماً مَناكِبُها",65,"ب",3,0],["كُلٌّ فَقُدّامَهُ لَهُ أَمَلٌ","يُلهي وَلَكِنَّ خَلفَهُ الأَجَلا",66,"ل",2,0],["كُلِّفتُ مِن حُبِّ رَخيمٍ لَما","لُمتَ عَلى الحُبِّ فَذَرني وَما",67,"م",2,0],["كَلَّفتِني حَملَ أَثقالٍ عَجَزتُ بِها","وَحَبَّذا ثِقلُها إِن كانَ أَرضاكِ",68,"ك",1,0],["كَلَفي بِحَجّامٍ تَحكَّمَ طَرفُهُ","فَغَدا عَلى سَفكِ الدِماءِ يُواطي",69,"ي",1,1],["كَلَّفَني في النَظمِ عَدَّ ذَلِكا","وَقالَ لَخِّص ذاكَ في نِظامِكا",70,"ك",2,0],["كُلِّفَ إِخفاءَ الهَوى قَلبُهُ","فَعَزَّ مِن ذَلِكَ إِمكانُه",71,"ن",2,0],["كلفته اليقظةُ الكبرى بها","مهجةً ترعى وعيناً لم تنَم",72,"م",1,0],["كلفته اليقظة الكبرى بها","همة ترعى وعيناً لم تنم",73,"م",1,0],["كُلُّ فَضلٍ مُقسَّمٍ في البَرايا","منه والشمسُ عُنْصُرُ الأَنوارِ",74,"ر",1,0],["كَلِفتُ بِكاساتِ الصّبوحِ مُبَكِّراً","وَكَم بَرَكاتٍ لِلفَتى في بُكورِهِ",75,"ر",2,0],["كَلِفٌ بِرَبِّ المَجدِ يَزعُمُ أَنَّهُ","