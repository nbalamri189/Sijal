//poetry.dctabudhabi.ae/diwan/poem/137397",""],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100496","السريع"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74174","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133988","الكامل"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136891","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82822","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52984","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61259","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45796","الكامل"],[3796,"","https://poetry.dctabudhabi.ae/diwan/poem/124128","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114446","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102986","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35509","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40163","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90865","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90830","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90891","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54353","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94426","البسيط"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33827","المديد"],[4770,"هذه دولة تخيرها الله","https://www.poetsgate.com/ViewPoem.aspx?id=181336",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5582,"لَمْ أَسْتَمِعْ يا هِنْدُ نَوْحَ حَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=187299",""],[242,"أملى الهنا والسعد ردد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563696",""],[6290,"هَلْ تَسْتَقِيمُ جُذُوعُنَا يَوْماً؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85166&r=&rc=16",""]],"verses":[["مِلِكٌ عَزِيزُ الْجَارِ مَمْنُوعُ الْحِمَى","مَمْنُوحُ مُنْهَلِّ النَّدَى مَبْذُولُهُ",0,"ل",2,0],["مَلِكٌ عَدَوتُ عَلى الزَمانِ بِحَولِهِ","وَغَدَوتُ في آلائِهِ أَتَنَعَّمُ",1,"م",1,0],["مَلِكٌ عَمِيمُ الخَيْرِ فِي أَكْنَافِهِ","وَالعَيْشُ عَيْشُ سَعَادَةٍ وَسَلامِ",2,"م",1,0],["ملك عمر","بما نشر",3,"ر",1,0],["ملك على عهد المعالي ثابت","لكنه في فضله متفنن",4,"ن",1,0],["ملك عَفٌّ تلقّى","كل فحش بازورا",5,"ر",2,0],["مَلِكٌ عِندَهُ عَلى كُلِّ حالٍ","كَرَمٌ زائِدٌ عَلى التَقديرِ",6,"ر",1,0],["مَلِكٌ عَلَيهِ مَهابَةُ المَلِكِ اِلتَقى","قَمَرُ التَمامِ بِهِ وَشَمسُ نَهارِ",7,"ر",1,0],["مَلِكٌ عُقودُ الحمدِ مِلْءُ يمينِه","ونَداه ملءُ حقائبِ الطُّلاَّبِ",8,"ب",1,0],["مِلكٌ عُدَّتِ الملوكُ من الأز","دِ فكان الشريفَ منها الأديبا",9,"ب",2,0],["مَلِكٌ عَزيزٌ لا يُفارِقُ عِزُّهُ","يُعصى وَيُرجى عِندَهُ الغُفرانُ",10,"ن",1,0],["مَلَكٌ عَرَفتُ بِهِ المُلوكَ فَلَم يَزَل","شِعري بِهِ عالي سِعرِيَ غالي",11,"ل",2,0],["مَلكٌ عَلا جَدّاً وَقَدراً وَسَناً","فَجاءَ في طُرقِ العُلى عَلى سَنَن",12,"ن",1,0],["مَلِكٌ على الإسلامِ ذِمّتُهُ","سِتْرٌ مَديدٌ ظِلّهُ خَصِرُ",13,"ر",1,0],["مَلِكٌ عن ثُغْرَةِ الدّين اتّقى","ورمى الأعداءَ بالجيش اللجب",14,"ب",1,0],["مَلِكٌ عادلٌ أقامَ عليكم","من كريمِ الجوارِ حِصْناً حَصينا",15,"ن",2,0],["مَلَكٌ عِندَ رَأسِهِ باسم الثَغ","رِ جَناحاه فَوقَهُ يَخفقان",16,"ن",1,0],["مَلِكٌ عَلَيهِ جَوهَرٌ","في سُندُسٍ قَد أُكنِفا",17,"ف",2,0],["مَلِكٌ عَلى مَضَضِ العَدُوِّ مَحَلُّهُ","يُعطي الجَزيلَ وَيَقتُلُ الصِنديدا",18,"د",2,0],["مَلِكٌ عَنْ أَعَاظِمِ الخَلْقِ","أَعْلَتْهُ بِحَقِّ مَكَارِمُ الأَخْلاَقِ",19,"ق",1,0],["ملك عزائمه تخر لها الملو","ك وفوق هام المشتري أقدامها",20,"م",3,0],["ملكٌ عليهِ مسحةٌ ملكيةٌ","لبسَ الزمانُ جمالها جلبابا",21,"ب",2,0],["مَلِكٌ عَناؤُكَ أَن تُحاوِلَ مَجدَهُ","فَإِذا عَدَقتَ بِجودِهِ التَأميلا",22,"ل",2,0],["ملك عقيم وسطا وعزة","ومنتهى الجود وحسن الأثرِ",23,"ر",1,0],["ملكٌ عقيمٌ جاء ما خطت له","حرفاً بذاك ولا ثنيت عنانا",24,"ن",2,0],["ملك عقيم واحتفال بالهدى","حقٌّ يقام وباطل مدحوضُ",25,"ض",1,0],["ملك عقيمٌ واراء مسددة","وشيمة لا تداني فضلها الشيم",26,"م",1,0],["ملك عظيم أتى من غير مسئلة","وكل أمر أتى عفوا وما سئلا",27,"ل",2,0],["ملك عظيم وخلق كلما عظمت","من الجلالة في سلطانه لانا",28,"ن",2,0],["ملك على التقوى تأسس والرضى","لا يمترى في يمنه اثنان",29,"ن",1,0],["ملك عَرشِه المَصائِب وَاله","مُّ وَياقوت تاجِه الأَحزانُ",30,"ن",1,0],["مَلِكٌ عَلاَ فَوْقَ الْعُلاَ","وَالْعَفْوُ عَنْ ذِي الْجُرْمِ يَشْهَدْ",31,"د",1,0],["مَلِكٌ علَى الأَقْدارِ خِدْمَةُ أَمْرِهِ","فَقَصِيُّ ما يَسْمُو إلَيْهِ طَيِّعُ",32,"ع",1,0],["مَلكٌ عُفاةُ الطَيرِ مِن ضيفانِهِ","وَضيافِنٌ غُبشٌ تَخوتُ وَتَعسِلُ",33,"ل",1,0],["ملِكٌ علُوُّ الجَدِّ زاد تراقِياً","ما شيّدتْهُ له عُلا الأجداد",34,"د",1,0],["مَلكٌ عَلاَ عن مداناة الملوك لَهُ","وفات حصر علاه كل ذي لسنِ",35,"ن",1,0],["ملكٌ علا رُتبَ الفِخار بهمّةٍ","رفعتْهُ فوقَ الكَوْكَبِ الوقّادِ",36,"د",1,0],["مَلِكٌ عِندَ سلمِهِ تأمن الدَهرَ وَفي حَربِهِ","حُسامٌ صَقيلُ",37,"ل",1,0],["ملِكٌ عادلٌ أنَارَ به الدِّي","نُ فعمَّ الإسلامَ منهُ الشُروقُ",38,"ق",1,0],["ملك على ايام منه سكينة","ولخفه قلب الحوادث يرعد",39,"د",1,0],["مَلكٌ عندهُ قِراءانِ للضَّيْ","فِ وللجيش فتْكهُ والرِّفدُ",40,"د",1,0],["ملِكٌ عليّ إذا همَمْتُ بمَدْحِه","تُملي شمائِلُه بَديعَ مَعاني",41,"ن",2,0],["ملِكٌ عَصرُه تَباهى وباهى","به مِن سالفِ الزَّمانِ عُصورا",42,"ر",2,0],["مَلِكٌُ عندهُ لذي العلمِ جاهٌ","كصنيعِ الرَّسولِ مع آلِ بدرِ",43,"ر",1,0],["ملك عظيم الشأن نحو رعية","كأبى البنين بعطفه والجود",44,"د",1,0],["مَلكٌ عَلا فَوقَ بُرجِ النَّجمِ مَنزِلَةً","وَفي البَريُّةِ مُنغَضُّ وَمُرتَفِعُ",45,"ع",1,0],["مَلك عَظيم لا مَليك نَظيره","عِزّ الملوكِ وَفيهِ رِفعة شَانها",46,"ن",3,0],["ملك عظيم القدر مرتفع البنا","رحب وسيع الصدر أنجب أنجدُ",47,"د",1,0],["ملك عطاياه همت عفواً فلم","يحتجْ إلى التصريح والتعريض",48,"ض",1,0],["ملك على الكرسي إن وافيتَه","تلقاه يُشرق كالغمام الماطرِ",49,"ر",1,0],["مَلْكٌ عظيمُ الحِلم ذو هيبةٍ","يغدو لها الرئبال كالثعلبِ",50,"ب",1,0],["ملك عظيم الحلم منهلُّ الندا","صعبٌ شديد البطش معتدل القوى",51,"و",2,0],["ملك على إحسانه","دون الورى تثنى الخناصر",52,"ر",1,0],["ملك عرضه مصون كمن حل","ل ذراه ووفره مبذولُ",53,"ل",1,0],["ملك عظيم قد تولّى عصرهُ","وَكذا الزمان يؤول للإفسادِ",54,"د",1,0],["ملك عمَّ جميع الن","ناسِ بأساً ونوالا",55,"ل",2,0],["ملك