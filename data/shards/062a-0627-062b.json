{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[280,"أشدو بها وسط الندي الحاشد","https://www.aldiwan.net/poem25593.html","الرجز"],[382,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[422,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[568,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64603","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64535","الطويل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123643","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130048","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111453","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111449","الطويل"],[4654,"","https://poetry.dctabudhabi.ae/diwan/poem/206247","الوافر"],[1901,"رويْدَكَ لا تُشمتْ بصاحِبكَ العِدَى","https://www.poetsgate.com/ViewPoem.aspx?id=160420",""],[5629,"أحلامنا","https://www.poetsgate.com/ViewPoem.aspx?id=184505",""],[5652,"عقولٍ تعشق الرأفه بليده دون فكرية","https://www.poetsgate.com/ViewPoem.aspx?id=178408",""],[5956,"يا صاحبَ الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=182226",""],[5956,"حيوية الدنيا بوجه أسفر","https://www.poetsgate.com/ViewPoem.aspx?id=182286",""],[5956,"أسيرُ النعومة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182288",""],[5956,"أرجوك دعني أبدأ الإسهاما","https://www.poetsgate.com/ViewPoem.aspx?id=193429",""],[5956,"لا يستطيب القلب أن ينساك","https://www.poetsgate.com/ViewPoem.aspx?id=194637",""],[5956,"لله درُّ الناي لحنٌ خالدُ","https://www.poetsgate.com/ViewPoem.aspx?id=202209",""],[6001,"خطاك الشر","https://www.poetsgate.com/ViewPoem.aspx?id=407",""]],"verses":[["تأثَّم بالفنِّ حتى غوَى","وما الفنُّ بالمرأةِ الخاطئهْ",0,"ه",1,0],["تَأَثَّر خَطْوَ الْحَزْمِ في كُلِّ مَطْلَبٍ","وهَلْ يَعْظُم المَطْلُوبُ والْحَزمُ طَالِبُه",1,"ب",2,0],["تأثرُها البحارُ في المَشاهِد","تَحَدُّثَ الرُّواةِ بِالمَسانِد",2,"د",1,0],["تأثيرها في كل برجٍ ظاهرٌ","وبكل برجٍ كان فيها آئبا",3,"ب",2,0],["تأثَّل في أبطاله ورجاله","فلم يُغْنِ سِحْرٌ غابَ عنه مكتما",4,"م",2,0],["تَأَثَّلَ مِنكَ النَجمُ كَيفِيَّةَ الهُدى","وَشَمسُ الضُحى الإِشراقَ وَالعَنبَرُ العَرفا",5,"ف",2,0],["تَأَثَّلَ جَمعُها لَكَ مِن فُتوحٍ","قَد اِطعَمَها سُيوفَكَ في قِراها",6,"ا",3,0],["تأثلوا صالح الأعمال وامتثلوا","بغضاً ولم يستقيموا نحو تاليها",7,"ي",3,0],["تأثرت الأسباب عنه فأثرت","بحكمته التأثير بالبسببية",8,"ه",1,0],["تأثلوا المال في أيامه وبه","نالوا مكاناً من العلياء لم ينل",9,"ل",1,0],["تأثيره التغليظ للعظام","والدفع للجذام والبرسام",10,"م",1,0],["تأثيرُها في نفوس القوم ينكرهُ","مَن أنكرَ الشمسَ في الأفلاك واِتّهما",11,"م",2,0],["تأثروا الإغريق بالمغاول","نفحاً ووخزاً بظبي العوامل",12,"ل",1,0],["تأَثَّرَ قِبرِيساً وَأَدمى يَمينَها","وَأَقبَلَ نحوي بَعدَ ذلِكَ يَقرَبُ",13,"ب",1,0],["تأَثَّرَهُ أُورِيفِلٌ وَهوَ قافِلٌ","فَلَم يُجدِهِ أَن يُستذَلَّ وَيُهزَما",14,"م",2,0],["تأثّل حبُّ عثمة في فؤادي","فباديه مع الخافي يسير",15,"ر",1,1],["تأثَّل عن سعيٍ وجهد وخبرة","فلا هو موهوبٌ ولا هو مجتدى",16,"د",2,0],["تأثثنا جروح وحزننا الديكور","نفضنا من حصير اليأس أمانينا",17,"ن",2,0],["تأثرنا وثرنا في ثرانا كننا حجاج","وكثيرٍ مننا يسكن مساكن ناس جبرية !!",18,"ر",3,0],["تأثير فتنتكم قد شلَّ قدرتنا","على الصمود لكي نبقى ميامينا",19,"ن",2,0],["تأثير هذا الوجه في نفسي سرى","لأرَى الحلاوة والطلاوةَ والذُّرى",20,"ر",2,0],["‏تأثير حُسنِكِ قد رماني ليلتي","‏ ‏ فوق السرير محارِباً طعّانا",21,"ن",2,0],["تأثير دمعي والنحيبِ سويّة","تأثير غيثٍ يشبع الأكماما",22,"م",2,0],["تأثير رسمك في الفؤاد يُنيلني","كنزَ الصداقةِ والمودةِ والولا",23,"ل",2,0],["تأثيرها يُذْكي بنا أقوى القوى","إلهامها لفنوننا يتوالدُ",24,"د",1,0],["تأثَّرت بصوابك من غلاك","وعشت بحسرتي مثل الوديع",25,"ع",1,0]]}