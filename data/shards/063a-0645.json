n.net/poem15455.html","الوافر"],[461,"اذا كنت جارا للفرات وهاطل","https://www.aldiwan.net/poem15587.html","الطويل"],[461,"طليق الوجه أغلب هاشمي","https://www.aldiwan.net/poem15629.html","الوافر"],[461,"لك الله ما لاح الصباح وعزت ال","https://www.aldiwan.net/poem15676.html","الطويل"],[461,"وخاطر من حديث المجد ساورني","https://www.aldiwan.net/poem15908.html","البسيط"],[461,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[461,"قل للحجيج ومن أضحت منازله","https://www.aldiwan.net/poem16131.html","البسيط"],[461,"تحوي القلوب له مكاسر لطفه","https://www.aldiwan.net/poem16147.html","الكامل"],[461,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[461,"الله جار الوزير الصدر ما طلعت","https://www.aldiwan.net/poem16429.html","البسيط"],[500,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[538,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[551,"ألا لله ما صنع الحمام","https://www.aldiwan.net/poem47251.html","الوافر"],[551,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[553,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[558,"غيم الحوادث حال دون البازغ","https://www.aldiwan.net/poem33541.html","الكامل"],[558,"هو أمر وكل أمر","https://www.aldiwan.net/poem34499.html","مجزوء الخفيف"],[559,"أيها الناظر فيه في سطح المرى","https://www.aldiwan.net/poem69354.html","الرمل"],[561,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[562,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[562,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[562,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[563,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[567,"الليل يا صاحبي منطلق","https://www.aldiwan.net/poem69572.html","أحذ الكامل"]],"verses":[["غَمائِمُ لِلرُعودِ بِها أَزيزٌ","رُغاءُ العَودِ رازَمَتِ المَتالي",0,"ل",2,0],["غَمرُ العَطِيَّةِ لا يُبقي عَلى نَشَبٍ","وَإِن رَأى قُلَّبِيَّ الرَأيِ مُحتَنِكا",1,"ك",2,0],["غَمَستُ يَدَيَّ في أَمرٍ فَمَن لي","وَأَينَ بِنَزعِ كَفّي وَاِنكِفافي",2,"ي",1,0],["غَمامُكَ فَيّاضٌ وَريحُكَ غَضَّةٌ","وَحَوضُكَ مَلآنٌ وَرَوضُكَ مُعشِبُ",3,"ب",1,0],["غَمَزَتْ مِنّي اللَّيالي صَعْدَةً","لَمْ يُقَوِّمْ دّرْءَها عَضُّ الثِّقافِ",4,"ف",1,0],["غَمَّتْ نِزاراً وَسَاءَتْ يَعْرُبَاً مِدَحٌ","زُفَّتْ إِلى ذَنَبٍ إِذْ لَمْ أَجِدْ راسَا",5,"س",2,1],["غَمْرُ الندىً لم يحتَضِنْ سَمْعَهُ","في جُودِهِ عَذْلٌ وتأنيبُ",6,"ب",1,0],["غَمَرَاتُ طَرْفِكَ فِي القُلُوبِ تَخَالُهَا","مِثْلُ السِّهَامِ مَضَتْ إِلَى الأَغْرَاضِ",7,"ض",1,0],["غَمامُ نَدىً جادَ البِلادَ فأصْبَحَتْ","تُجرِّرُ ذيْلَ الخصْبِ والعِيشةِ الرّغْدِ",8,"د",1,0],["غَمَرَ الحُزنُ نَواحي نَفسِهُ","وَأَذابَت لُبَّهُ سودُ الخُطوبِ",9,"ب",1,0],["غَمَرَتنا سودُ الأَهاويلِ فيهِ","وَالأَمانِيُّ بَينَ جَزرٍ وَمَدِّ",10,"د",1,0],["غَمَزتَ بِها دينَ النَبِيِّ وَإِنَّنا","لَنَغضَبُ إِن أَغضَبتَ في القَبرِ أَحمَدا",11,"د",2,0],["غَمَرَتني لَكَ الأَيادي البيضُ","نَشَبٌ وافِرٌ وَجاهُ عَريضُ",12,"ض",1,1],["غَمامٌ يُظِلُّ وَشَمسٌ تُنيرُ","وَبَحرٌ يَفيضُ وَسَيفٌ يُسَلّ",13,"ل",1,0],["غمُوضٌ عَضُوضُ الحِجلِ لَو أَنهَا مَشَت","بِهِ عِندَ بابَ السَّبسَبِيِّينَ لا نفَصَل",14,"ل",1,0],["غَمرُ الرِداءِ إِذا تَبَسَّمَ ضاحِكاً","غَلِقَت لِضَحكَتِهِ رِقابُ المالِ",15,"ل",1,0],["غَمُومٌ لِطَيرِ الزَاجِرِيها أُرِيبَةٌ","إِذا حَاوَلَت ضُرًّا لِذِي الضِغنِ ضَرَّتِ",16,"ت",1,0],["غَمَائِمٌ دُكْنٌ شَوَّهَتْ قَسَمَاتِهَا","وَغَيَّبَتِ الوَضَّاحَ مِنْ ذَلِكَ النَّسَبْ",17,"ب",1,0],["غَمَرَتْ صَبَاحَتُهَا لَيَالِيَهَا فَلَمْ","تَقَعِ اللِّحَاظُ بِهَا عَلَى إِظْلامِ",18,"م",1,0],["غَميمُ النَسا إِلّا عَلى عَظمِ ساقِهِ","مُشَرِّفُ أَطرافِ القَرا مُتَماحِلُه",19,"ل",2,0],["غمرتْنا منك الأيادي اللَّواتي","ما لِمعْشارِها لدينا كِفاءُ",20,"ا",2,0],["غموض الحق حين تذبُّ عنه","يقلِّلُ ناصرَ الخصم المحقِّ",21,"ق",1,1],["غمامٌ جدَّ في آثارِ سارٍ","أغذَّ سُرىً فأدركه الغمامُ",22,"م",1,0],["غَموسُ الدُجى تَنشَقُّ عَن مُتَضَرِّمٍ","طَلوبِ الأَعادي لا سَؤومٍ وَلا وَجبِ",23,"ب",1,0],["غَمَرناكَ إِسلاماً وَإِن تَكُ فِتنَةٌ","تَكُن ثَعلَباً دارَت عَلَيهِ الدَوائِرُ",24,"ر",1,0],["غَمَرَتها أَمواجُ الغَسَقِ","فَتَوارَت خَلفَ الأَمواجِ",25,"ج",1,0],["غَمامٌ هَمى بَحرٌ طَمى قَمَرٌ أَضا","حُسامٌ مَضى لَيثٌ قَسا جَبَلٌ رَسا",26,"س",2,0],["غَمزُ الحَواجِبِ بَينَنا","أَحلى مِنَ القَولِ الصَريحِ",27,"ح",1,0],["غمّ النجوم ما تقا","سيه من المصائب",28,"ب",1,0],["غمر القاع ثم عب فانحى","يعتدي مزبداً على كثبانه",29,"ن",2,0],["غمر الجانبين منه وانحجى","يتسامى الى التلاع فاربى",30,"ب",2,0],["غمرة يشفق الضياغم منها","خاضها لم يهب عواقب وِرد",31,"د",1,0],["غُمرت بموسيقى الجمال تلالُها","وتفجرت عن مائه الاحجار",32,"ر",1,0],["غمرنا بالحضارة ساحليه","فما عيَّا بحائطها اضطلاعا",33,"ع",2,0],["غمرت مصائبه فأُغرقنا بها","والغمر فيه تستوى الأعماق",34,"ق",1,0],["غَمَزتُ إِباءَهُمْ حَتّى تَلَظَّتْ","أُنوفُ الأُسدِ وَاضطَرَمَ المَدَقُّ",35,"ق",1,0],["غَمَراتٌ عارَضَت مُقتَحِما","عالِيَ النَفسِ أَشَمَّ المَعطِسِ",36,"س",1,0],["غَمَرتَ القَومَ إِطراءً وَحَمداً","وَهُم غَمَروكَ بِالنِعَمِ الجسامِ",37,"م",1,0],["غَمائِمُ في مَحلِ السِنينِ هَواطِلٌ","مَصابيحُ في لَيلِ الشُكوكِ هُداةُ",38,"ه",1,0],["غَمّتْ مُصِيبَتُكَ الهُدَى فَغَدَا ال","إسْلامُ لا يَدْرِي بِمَا يَدْرِي",39,"ر",2,0],["غَمَدتَ صَوارِماً لَو لَم يَتوبوا","مَحَوتَهُمُ بِها مَحوَ المِدادِ",40,"د",1,0],["غَمَرَتني فَوائِدٌ شاءَ فيها","أَن يَكونَ الكَلامُ مِمّا أَفادُه",41,"د",2,0],["غَمامٌ عَلَينا مُمطِرٌ لَيسَ يُقشِعُ","وَلا البَرقُ فيهِ خُلَّباً حينَ يَلمَعُ",42,"ع",1,0],["غَمامٌ رُبَّما مَطَرَ اِنتِقاماً","فَأَقحَطَ وَدقُهُ البَلَدَ المَريعا",43,"ع",2,0],["غَمرَ الخلافُ الناسَ واتفقتْ","فيه وفيك العُجْمُ والعُرْبُ",44,"ب",1,0],["غَمرُ النَوالِ إِذا الآمالُ أَكذَبَها","ثِمادُ نَيلٍ مِنَ الأَقوامِ ضَحضاحِ",45,"ح",1,0],["غَماغِمُ أَصواتٍ وَجَرسُ تُقارُعٍ","وَمُختارَةُ المَرذولِ يَدمى وَريدُها",46,"د",3,0],["غَمامُ حَياً ما تَستَريحُ بُروقُهُ","وَعارِضُ مَوتٍ لا تَفيلُ رَواعِدُه",47,"د",2,0],["غَمامُ سَماحٍ ما يَغَبُّ لَهُ حَياً","وَمِسعَرُ حَربٍ ما يَضيعُ لَهُ وِترُ",48,"ر",1,0],["غَمرٌ إِذا نُقِلَت إِلَيهِ بَضاعَةٌ","لِلشِعرِ أَوشَكَ عِلقُها أَن يُشتَرى",49,"ر",2,0],["غَمرٌ مَتى سَخِطَ الخَلائِقَ ساخِطٌ","كانَ الخَليقُ خَليقَةً أَن تُرتَضى",50,"ض",2,0],["غَمرٌ يَمُدُّ إِلى العَلياءِ مِنهُ يَداً","تُعطيهِ عادَتُها المَمنوعَ وَالسَعَفا",51,"ف",2,0],["غَمرٌ كَفاني وَلَم أَخطُب كِفايَتَهُ","نَصَّ المَطِيِّ عَلى أَينٍ وَإِعمالِ",52,"ل",1,0],["غَمَرتَ الناسَ إِفضالاً وَفَضلاً","وَإِنعاماً مُبِرّاً وَاِنتِقاما",53,"م",2,0],["غُمَّ عَنّا مَكانُ مَن بِالغَميمِ","وَتَناءى مَرامُ ذاكَ الريمِ",54,"م",1,0],["غَمَرَتهُ جَلالَةُ المُلكِ وَاِستَو","لَت عَلَيهِ شَمائِلُ الفِتيانِ",55,"ن",1,0],["غُمَّ عَنّا أَينَ السَماحُ وَأَضلَل","نا مَكانَ المَعروفِ لَولا مَكانُه",56,"ن",2,0],["غَمَرَ الخَلائِفَ قَبلَهُ وَهُوَ الَّذي","قَتَلَ النِفاقَ أَبوهُ بِالإِسلامِ",57,"م",1,0],["غَموسٍ إِلى الغاياتِ يُلفى عَزيمُهُ","إِذا سَإِمَت أَقرانُهُ غَيرَ سائِمِ",58,"م",1,0],["غَمامٌ مثلُ جُودِك في انسكابٍ","وعيدٌ مثلُ وجهِك في قُدومِ",59,"م",1,0],["غَمامٌ متى تَخْفِقْ لساريهِ رايَةٌ","على الأرضِ لا يُقلِعْ وفي الأرضِ مَخفَقُ",60,"ق",1,0],["غَمَرَتْنا له سِجَالُ عطَايا","كَسِجالِ الغَمامِ أسرفَ جِدَّا",61,"د",2,0],["غَمْرِ المَواهبِ لا يُساجلُ مُرغِباً","في المكرماتِ ولا يُطاولُ مُرهِبا",62,"ب",2,0],["غَمَرَ العالَمينَ نائِلُ كَفَّي","هِ بِبَذلِ النَوالِ وَالإِسباغِ",63,"غ",1,0],["غَمَّ أَعداءَ لا بَرِحتَ بِمُلكٍ","آمِناً مِن شَوائِبِ الإِرتِياغِ",63,"غ",1,0],["غمرتني بالجميل حتى","لجت قوافيَّ في العثار",64,"ر",1,0],["غُمِستْ في السواد بيضُ وجوهٍ","فكأنّ الطلوعَ فيه أُفُولُ",65,"ل",1,0],["غَمَرَ الشَّيبُ الدُّجى مِن لِمَّتي","بِنُجومٍ طُلَّعٍ لَيسَتْ تَغور",66,"ر",1,0],["غَمَسَتهُمُ في غَمرَةٍ من هَولها","صَبَروا لها بِسُرَاهمُ فتَجلّتِ",67,"ت",1,0],["غَمَرَ الأَرضَ بِعِلمٍ زاخِرٍ","وَرَمى الدُنيا بِبِأسٍ مُستَعِرْ",68,"ر",1,0],["غَمائِمُ لُحنَ مِن بيضٍ وَسودٍ","تُريقُ مِنَ المَنايا ما تُريقُ",69,"ق",1,0],["غَمرُ البَديهَةِ بِالنَوا","لِ إِذا غَدا سَبطُ الأَنامِل",70,"ل",1,0],["غَمَرَ البَرِيَّةِ عَدلُهُ فَصَدِيقُهُ","وعَدُوُّه لا يُظْلَمُونَ فَتِيلا",71,"ل",2,0],["غمائمٌ في نواحي الجوِّ عاكفَةٌ","جَعْدٌ تَحَدَّرَ منها وابلٌ سَبِط",72,"ط",1,0],["غَمَرَ الرِّعانَ الباذخاتِ وأغرَقَ ال","قُنَنَ المُنيفةَ ذلك التَّيّار",73,"ر",1,0],["غمَرْتَ ندىً جزْلاً فلا البْرقُ خُلَّباً","لديكَ ولا المزْنُ الكنَهْوَرُ زِبرِجا",74,"ج",2,0],["غَمَضَ الحَديدُ بِصاحِبَيكَ فَغَمَّضا","وَبَقيتَ تَطلُبُ في الحِبالَةِ مَنهَضا",75,"ض",2,1],["غَمّازَةٌ في الجُنحِ ضَحّاكَةٌ","لِأَسفِياتِ الحَيِّ زمّامَه",76,"م",2,0],["غَمامَانِ مُبْيَضّانِ مُنْذُ بَراهُما","لنا اللّهُ لم نَحْفِلْ بسُودِ غَمامهِ",77,"م",2,0],["غَمرَ الأرضَ رحمةً وسلاماً","وجلا الكونَ فتنةً ووسامَه",78,"م",2,0],["غَمَدَتْها نَواقِرُ النّبْعِ في الحَرْ","بِ فما إنْ رَزَأْنَ منها نَقيرا",79,"ر",2,0],["غَمْرِ النّوالِ ولن تُبْقي على أحدٍ","حتى تَوَفّى بجُودٍ ضِدَّ مُحْتَبِسِ",80,"س",1,0],["غُمْضٌ يُحيلُ على السهادِ بزَوْرَةٍ","وكذا السّهادُ على الرّقادِ يُحيل",81,"ل",1,0],["غمّ على الحجاز فاسترابا","نزول ذاك القمر الترابا",82,"ب",2,0],["غَمَامَةٌ أَلْقَتْ بِأَفْلاذِهَا","وَجَدْوَلٌ مَدَّ إِلَيْنَا يَدَا",83,"د",2,0],["غَمَزَتْهَا يَدُ الصَّبَا فَتَلَوَّتْ","رَاقِصَاتٍ عَلَى غِنَاءِ الْقَمَارِي",84,"ر",2,0],["غَمَامَانِ فَيَّاضَانِ هَذَا بِأُفْقِهِ","يَسيرُ وَهَذا فِي طِبَاقِ الثَّرَى يَسْري",85,"ر",2,0],["غمَرَتْنا نُعْماكَ في كلِّ حالٍ","فحمدْنا نُعْماكَ في كلِّ حالِ",86,"ل",1,0],["غمر الظلامُ البحر حتى أوشكت","في الليل تخشى أن تطلَّ الأنجم",87,"م",1,0],["غمزات طرفك في القلوب تخالها","مثل السهام مضت إلى الأغراض",88,"ض",1,0],["غمام ندى جاد البلاد فأصبحت","تجرر ذيل الخصب والعيشة الرعد",89,"د",1,0],["غموضُ السياسة يبدو عليك","في مظهر الهادئ الساكن",90,"ن",1,0],["غموضُ غضوض الحِجل لو أنها مشت","به عند باب الَّسبْسَبيَن لَلاَنفصلْ",91,"ل",1,0],["غماغم أ