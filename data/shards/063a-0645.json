t/poem63556.html","الطويل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[45,"يأبى الخلي بكاء المنزل الخالي","https://www.aldiwan.net/poem65572.html","البسيط"],[45,"عذيري فيك من لاح إذا ما","https://www.aldiwan.net/poem65672.html","الوافر"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[45,"أدمع قد غرين بالهملان","https://www.aldiwan.net/poem66672.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[28,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[61,"ليالينا بأحياء الغميم","https://www.aldiwan.net/poem51454.html","الوافر"],[61,"طوى الشوق لولا بارق يتألق","https://www.aldiwan.net/poem51510.html","الطويل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[61,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[66,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[97,"بأي لفظ يفيك شعري","https://www.aldiwan.net/poem24969.html","مجزوء البسيط"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"حبذا فتيان صدق أعرسوا","https://www.aldiwan.net/poem31454.html","الرمل"],[80,"ولقد سريت بفتية قطعوا الفلا","https://www.aldiwan.net/poem31534.html","الكامل"],[105,"أنشروا الآثار واستقصوا السير","https://www.aldiwan.net/poem43071.html","الرمل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[75,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[50,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[46,"ألمم بدار النسك إلمامه","https://www.aldiwan.net/poem23358.html","السريع"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39563","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16674","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[77,"حكم الجفون على فؤادي ماض","https://www.poetsgate.com/ViewPoem.aspx?id=34171",""],[77,"قفا فاسألا في ساحة الأجدع الفرد","https://www.poetsgate.com/ViewPoem.aspx?id=33812",""],[90,"المازني وداغر","https://www.poetsgate.com/ViewPoem.aspx?id=179154",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[75,"أمِنْكِ اجْتِيازُ البرْقِ يلتاحُ في الدُّجى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10793&r=&rc=13",""],[53,"أيُّ العُيُونِ تُجَانِبُ الأقْذاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9806&r=&rc=3",""]],"verses":[["غَمائِمُ لِلرُعودِ بِها أَزيزٌ","رُغاءُ العَودِ رازَمَتِ المَتالي",0,"ل",2,0],["غَمرُ العَطِيَّةِ لا يُبقي عَلى نَشَبٍ","وَإِن رَأى قُلَّبِيَّ الرَأيِ مُحتَنِكا",1,"ك",2,0],["غَمَستُ يَدَيَّ في أَمرٍ فَمَن لي","وَأَينَ بِنَزعِ كَفّي وَاِنكِفافي",2,"ي",1,0],["غَمامُكَ فَيّاضٌ وَريحُكَ غَضَّةٌ","وَحَوضُكَ مَلآنٌ وَرَوضُكَ مُعشِبُ",3,"ب",1,0],["غَمَزَتْ مِنّي اللَّيالي صَعْدَةً","لَمْ يُقَوِّمْ دّرْءَها عَضُّ الثِّقافِ",4,"ف",1,0],["غَمَّتْ نِزاراً وَسَاءَتْ يَعْرُبَاً مِدَحٌ","زُفَّتْ إِلى ذَنَبٍ إِذْ لَمْ أَجِدْ راسَا",5,"س",2,1],["غَمْرُ الندىً لم يحتَضِنْ سَمْعَهُ","في جُودِهِ عَذْلٌ وتأنيبُ",6,"ب",1,0],["غَمَرَاتُ طَرْفِكَ فِي القُلُوبِ تَخَالُهَا","مِثْلُ السِّهَامِ مَضَتْ إِلَى الأَغْرَاضِ",7,"ض",1,0],["غَمامُ نَدىً جادَ البِلادَ فأصْبَحَتْ","تُجرِّرُ ذيْلَ الخصْبِ والعِيشةِ الرّغْدِ",8,"د",1,0],["غَمَرَ الحُزنُ نَواحي نَفسِهُ","وَأَذابَت لُبَّهُ سودُ الخُطوبِ",9,"ب",1,0],["غَمَرَتنا سودُ الأَهاويلِ فيهِ","وَالأَمانِيُّ بَينَ جَزرٍ وَمَدِّ",10,"د",1,0],["غَمَزتَ بِها دينَ النَبِيِّ وَإِنَّنا","لَنَغضَبُ إِن أَغضَبتَ في القَبرِ أَحمَدا",11,"د",2,0],["غَمَرَتني لَكَ الأَيادي البيضُ","نَشَبٌ وافِرٌ وَجاهُ عَريضُ",12,"ض",1,1],["غَمامٌ يُظِلُّ وَشَمسٌ تُنيرُ","وَبَحرٌ يَفيضُ وَسَيفٌ يُسَلّ",13,"ل",1,0],["غمُوضٌ عَضُوضُ الحِجلِ لَو أَنهَا مَشَت","بِهِ عِندَ بابَ السَّبسَبِيِّينَ لا نفَصَل",14,"ل",1,0],["غَمرُ الرِداءِ إِذا تَبَسَّمَ ضاحِكاً","غَلِقَت لِضَحكَتِهِ رِقابُ المالِ",15,"ل",1,0],["غَمُومٌ لِطَيرِ الزَاجِرِيها أُرِيبَةٌ","إِذا حَاوَلَت ضُرًّا لِذِي الضِغنِ ضَرَّتِ",16,"ت",1,0],["غَمَائِمٌ دُكْنٌ شَوَّهَتْ قَسَمَاتِهَا","وَغَيَّبَتِ الوَضَّاحَ مِنْ ذَلِكَ النَّسَبْ",17,"ب",1,0],["غَمَرَتْ صَبَاحَتُهَا لَيَالِيَهَا فَلَمْ","تَقَعِ اللِّحَاظُ بِهَا عَلَى إِظْلامِ",18,"م",1,0],["غَميمُ النَسا إِلّا عَلى عَظمِ ساقِهِ","مُشَرِّفُ أَطرافِ القَرا مُتَماحِلُه",19,"ل",2,0],["غمرتْنا منك الأيادي اللَّواتي","ما لِمعْشارِها لدينا كِفاءُ",20,"ا",2,0],["غموض الحق حين تذبُّ عنه","يقلِّلُ ناصرَ الخصم المحقِّ",21,"ق",1,1],["غمامٌ جدَّ في آثارِ سارٍ","أغذَّ سُرىً فأدركه الغمامُ",22,"م",1,0],["غَموسُ الدُجى تَنشَقُّ عَن مُتَضَرِّمٍ","طَلوبِ الأَعادي لا سَؤومٍ وَلا وَجبِ",23,"ب",1,0],["غَمَرناكَ إِسلاماً وَإِن تَكُ فِتنَةٌ","تَكُن ثَعلَباً دارَت عَلَيهِ الدَوائِرُ",24,"ر",1,0],["غَمَرَتها أَمواجُ الغَسَقِ","فَتَوارَت خَلفَ الأَمواجِ",25,"ج",1,0],["غَمامٌ هَمى بَحرٌ طَمى قَمَرٌ أَضا","حُسامٌ مَضى لَيثٌ قَسا جَبَلٌ رَسا",26,"س",2,0],["غَمزُ الحَواجِبِ بَينَنا","أَحلى مِنَ القَولِ الصَريحِ",27,"ح",1,0],["غمّ النجوم ما تقا","سيه من المصائب",28,"ب",1,0],["غمر القاع ثم عب فانحى","يعتدي مزبداً على كثبانه",29,"ن",2,0],["غمر الجانبين منه وانحجى","يتسامى الى التلاع فاربى",30,"ب",2,0],["غمرة يشفق الضياغم منها","خاضها لم يهب عواقب وِرد",31,"د",1,0],["غُمرت بموسيقى الجمال تلالُها","وتفجرت عن مائه الاحجار",32,"ر",1,0],["غمرنا بالحضارة ساحليه","فما عيَّا بحائطها اضطلاعا",33,"ع",2,0],["غمرت مصائبه فأُغرقنا بها","والغمر فيه تستوى الأعماق",34,"ق",1,0],["غَمَزتُ إِباءَهُمْ حَتّى تَلَظَّتْ","أُنوفُ الأُسدِ وَاضطَرَمَ المَدَقُّ",35,"ق",1,0],["غَمَراتٌ عارَضَت مُقتَحِما","عالِيَ النَفسِ أَشَمَّ المَعطِسِ",36,"س",1,0],["غَمَرتَ القَومَ إِطراءً وَحَمداً","وَهُم غَمَروكَ بِالنِعَمِ الجسامِ",37,"م",1,0],["غَمائِمُ في مَحلِ السِنينِ هَواطِلٌ","مَصابيحُ في لَيلِ الشُكوكِ هُداةُ",38,"ه",1,0],["غَمّتْ مُصِيبَتُكَ الهُدَى فَغَدَا ال","إسْلامُ لا يَدْرِي بِمَا يَدْرِي",39,"ر",2,0],["غَمَدتَ صَوارِماً لَو لَم يَتوبوا","مَحَوتَهُمُ بِها مَحوَ المِدادِ",40,"د",1,0],["غَمَرَتني فَوائِدٌ شاءَ فيها","أَن يَكونَ الكَلامُ مِمّا أَفادُه",41,"د",2,0],["غَمامٌ عَلَينا مُمطِرٌ لَيسَ يُقشِعُ","وَلا البَرقُ فيهِ خُلَّباً حينَ يَلمَعُ",42,"ع",1,0],["غَمامٌ رُبَّما مَطَرَ اِنتِقاماً","فَأَقحَطَ وَدقُهُ البَلَدَ المَريعا",43,"ع",2,0],["غَمرَ الخلافُ الناسَ واتفقتْ","فيه وفيك العُجْمُ والعُرْبُ",44,"ب",1,0],["غَمرُ النَوالِ إِذا الآمالُ أَكذَبَها","ثِمادُ نَيلٍ مِنَ الأَقوامِ ضَحضاحِ",45,"ح",1,0],["غَماغِمُ أَصواتٍ وَجَرسُ تُقارُعٍ","وَمُختارَةُ المَرذولِ يَدمى وَريدُها",46,"د",3,0],["غَمامُ حَياً ما تَستَريحُ بُروقُهُ","وَعارِضُ مَوتٍ لا تَفيلُ رَواعِدُه",47,"د",2,0],["غَمامُ سَماحٍ ما يَغَبُّ لَهُ حَياً","وَمِسعَرُ حَربٍ ما يَضيعُ لَهُ وِترُ",48,"ر",1,0],["غَمرٌ إِذا نُقِلَت إِلَيهِ بَضاعَةٌ","لِلشِعرِ أَوشَكَ عِلقُها أَن يُشتَرى",49,"ر",2,0],["غَمرٌ مَتى سَخِطَ الخَلائِقَ ساخِطٌ","كانَ الخَليقُ خَليقَةً أَن تُرتَضى",50,"ض",2,0],["غَمرٌ يَمُدُّ إِلى العَلياءِ مِنهُ يَداً","تُعطيهِ عادَتُها المَمنوعَ وَالسَعَفا",51,"ف",2,0],["غَمرٌ كَفاني وَلَم أَخطُب كِفايَتَهُ","نَصَّ المَطِيِّ عَلى أَينٍ وَإِعمالِ",52,"ل",1,0],["غَمَرتَ الناسَ إِفضالاً وَفَضلاً","وَإِنعاماً مُبِرّاً وَاِنتِقاما",53,"م",2,0],["غُمَّ عَنّا مَكانُ مَن بِالغَميمِ","وَتَناءى مَرامُ ذاكَ الريمِ",54,"م",1,0],["غَمَرَتهُ جَلالَةُ المُلكِ وَاِستَو","لَت عَلَيهِ شَمائِلُ الفِتيانِ",55,"ن",1,0],["غُمَّ عَنّا أَينَ السَماحُ وَأَضلَل","نا مَكانَ المَعروفِ لَولا مَكانُه",56,"ن",2,0],["غَمَرَ الخَلائِفَ قَبلَهُ وَهُوَ الَّذي","قَتَلَ النِفاقَ أَبوهُ بِالإِسلامِ",57,"م",1,0],["غَموسٍ إِلى الغاياتِ يُلفى عَزيمُهُ","إِذا سَإِمَت أَقرانُهُ غَيرَ سائِمِ",58,"م",1,0],["غَمامٌ مثلُ جُودِك في انسكابٍ","وعيدٌ مثلُ وجهِك في قُدومِ",59,"م",1,0],["غَمامٌ متى تَخْفِقْ لساريهِ رايَةٌ","على الأرضِ لا يُقلِعْ وفي الأرضِ مَخفَقُ",60,"ق",1,0],["غَمَرَتْنا له سِجَالُ عطَايا","كَسِجالِ الغَمامِ أسرفَ جِدَّا",61,"د",2,0],["غَمْرِ المَواهبِ لا يُساجلُ مُرغِباً","في المكرماتِ ولا يُطاولُ مُرهِبا",62,"ب",2,0],["غَمَرَ العالَمينَ نائِلُ كَفَّي","هِ بِبَذلِ النَوالِ وَالإِسباغِ",63,"غ",1,0],["غَمَّ أَعداءَ لا بَرِحتَ بِمُلكٍ","آمِناً مِن شَوائِبِ الإِرتِياغِ",63,"غ",1,0],["غمرتني بالجميل حتى","لجت قوافيَّ في العثار",64,"ر",1,0],["غُمِستْ في السواد بيضُ وجوهٍ","فكأنّ الطلوعَ فيه أُفُولُ",65,"ل",1,0],["غَمَرَ الشَّيبُ الدُّجى مِن لِمَّتي","بِنُجومٍ طُلَّعٍ لَيسَتْ تَغور",66,"ر",1,0],["غَمَسَتهُمُ في غَمرَةٍ من هَولها","صَبَروا لها بِسُرَاهمُ فتَجلّتِ",67,"ت",1,0],["غَمَرَ الأَرضَ بِعِلمٍ زاخِرٍ","وَرَمى الدُنيا بِبِأسٍ مُستَعِرْ",68,"ر",1,0],["غَمائِمُ لُحنَ مِن بيضٍ وَسودٍ","تُريقُ مِنَ المَنايا ما تُريقُ",69,"ق",1,0],["غَمرُ البَديهَةِ بِالنَوا","لِ إِذا غَدا سَبطُ الأَنامِل",70,"ل",1,0],["غَمَرَ البَرِيَّةِ عَدلُهُ فَصَدِيقُهُ","وعَدُوُّه لا يُظْلَمُونَ فَتِيلا",71,"ل",2,0],["غمائمٌ في نواحي الجوِّ عاكفَةٌ","جَعْدٌ تَحَدَّرَ منها وابلٌ سَبِط",72,"ط",1,0],["غَمَرَ الرِّعانَ الباذخاتِ وأغرَقَ