{"poems":[[95,"يا ليل أبدعت نظام الحلى","https://www.aldiwan.net/poem9846.html","السريع"],[29,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[4,"يا بشر بشر إياد أيكم","https://www.aldiwan.net/poem21162.html","الكامل"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[30,"يا عجبا للعذارى يوم معقلة","https://www.aldiwan.net/poem5098.html","البسيط"],[50,"يا بشر ما لي والسيف والحرب","https://www.aldiwan.net/poem10776.html","المنسرح"],[52,"منيتني بشرا وبشر فتى","https://www.aldiwan.net/poem64884.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[98,"أَمِيرَةُ الشَّرْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=187845",""],[52,"منَّيْتَنِي بِشْراً وبشرٌ فتًى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8362&r=&rc=4",""],[4,"يا بشرُ بشرَ بني إيادٍ أيّكُمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10918&r=&rc=14",""],[325,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[435,"يا بشير العلى ويا خير مولى","https://www.aldiwan.net/poem40739.html","الخفيف"],[435,"يا بشير السعود دم في هناء","https://www.aldiwan.net/poem40765.html","الخفيف"],[435,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[435,"يا بشير السعود وافى محب","https://www.aldiwan.net/poem41425.html","الخفيف"],[475,"يا بشر يا رب محزون بمصرعنا","https://www.aldiwan.net/poem4832.html","البسيط"],[521,"يا بشر يابن الجعفرية ما","https://www.aldiwan.net/poem48623.html","أحذ الكامل"],[566,"أصبح مسحول يوازي شقا","https://www.aldiwan.net/poem27830.html","الرجز"],[572,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2505","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87270","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96449","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112840","الرمل"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134228","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77738","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93804","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136992",""],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22090","البسيط"],[4980,"عَذِّب بِمَا شِئتَ","https://www.poetsgate.com/ViewPoem.aspx?id=190541",""],[5212,"رزءُ العليل","https://www.poetsgate.com/ViewPoem.aspx?id=212052",""],[5216,"مع سيرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187130",""],[5455,"آخر دروبي","https://www.poetsgate.com/ViewPoem.aspx?id=213954",""],[5652,"ناديت لكن مالقى صوتي مجيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=177404",""],[5652,"مازلت اهذري في شموخ العزيزين !","https://www.poetsgate.com/ViewPoem.aspx?id=177734",""],[5652,"معالي / توفيق الربيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177752",""],[5652,"فقر وصندقه","https://www.poetsgate.com/ViewPoem.aspx?id=178103",""],[6126,"النَّخْلة","https://www.poetsgate.com/ViewPoem.aspx?id=190002",""],[572,"أيُّ حِرَاكٍ غالَ منكَ السكونْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9491&r=&rc=348",""]],"verses":[["يا بشر هذا المنزل المزدهي","بالشمس تلقى البدر في منزل",0,"ل",1,0],["يا بِشرُ حُقَّ لِبِشرِكَ التَبشيرُ","هَلّا غَضِبتَ لَنا وَأَنتَ أَميرُ",1,"ر",1,0],["يا بِشرُ إِنَّكَ لَم تَزَل في نِعمَةٍ","يَأتيكَ مِن قِبَلِ الإِلَهِ بَشيرُ",1,"ر",1,0],["يا بِشرُ بِشرَ إِيادٍ أَيُّكُم","أَدّى أُرَيكَةَ يَومَ هَضبِ الأَجشُرِ",2,"ر",1,1],["يا بشراً صاغه المصوِّر من","نورٍ على سُنّة من الفِطرِ",3,"ر",1,0],["يا بِشرُ لَو لَم أَكُن مِنكُم بِمَنزِلَةٍ","أَلقى يَدَيهِ عَلَيَّ الأَزلَمُ الجَذَعُ",4,"ع",1,0],["يا بِشرُ إِنَّكَ سَيفُ اللَهِ صيلَ بِهِ","عَلى العَدُوِّ وَغَيثٌ يُنبِتُ الشَجَرا",5,"ر",2,0],["يا بِشرُ ما لي وَالسَيفِ وَالحَربِ","وَإِنَّ نَجمي لِلَّهوِ وَالطَرَبِ",6,"ب",1,1],["يا بِشرُ ما بالُ الَتي وَقَفَت","بِالفَتحِ تَبكي بَينَ أَعداءِ",7,"ا",2,0],["يا بِشرُ حَمّامُ بَني يَشكُرٍ","حَدَّثَني عَنها بِأَشياءِ",7,"ا",2,0],["يا بشير السِّلم لا يكذِبْكَ ظنِّي","أنا ظمآنُ إلى الشدو فزِدني",8,"ي",1,0],["يا بشيرَ المُنَى، أحُلْمُ شبابٍ","مَرَّ بالنهر، أمْ غرامٌ جديدُ؟",9,"د",1,1],["يا بشرُحمَّامُ بني يشكرٍ","حدَّثني عنْهما بأشْياء",10,"ا",2,0],["يا بشرُ بشرَ بني إيادٍ أيّكُمْ","أدّى أريكة َ يومَ هضبِ الأجشرِ",11,"ر",1,1],["يا بَشيرَ الأُنسِ قُل لي","قُل وَلا تَخشى جَريرُهُ",12,"ر",2,0],["يا بشير العلى ويا خير مولىً","ساد قدراً ونال نعم الرغائب",13,"ب",1,1],["يا بشير السعود دم في هناءٍ","زادك اللَه بهجة وجمالا",14,"ل",2,1],["يا بشير له السعود اشارت","وشهابا به العلى تستنيرُ",15,"ر",1,0],["يا بشير السعود وافى محبّ","قد ضناه البعاد بعد النشاط",16,"ط",1,1],["يا بِشرُ يا رُبَّ مَحزونٍ بِمَصرَعِنا","وَشامِتٍ جَذِلٍ ما مَسَّهُ الحَزَنُ",17,"ن",1,1],["يا بِشرُ هُبِّي فَإِنَّ النَومَ أَرَّقَهُ","نأيٌ مُشِتٌّ وَأَرضٌ غَيرُها الوَطَنُ",17,"ن",1,0],["يا بشر يَاِبن الجَعفَرِيَّة ما","خَلق الاله يَدَيك لِلبُخل",18,"ل",1,1],["يا بُشرَتا إِن كانَ هَذا حَقّا","إِذا السَرابُ الرَقرَقانُ اِنعَقّا",19,"ق",2,0],["يَا بِشْرُ إِنْ تُودَ فَكُلُّ امْرِىءٍ","يَوْمَاً بِمَا صِرْتَ إِلَيْهِ رَهِيْنْ",20,"ن",1,0],["يا بِشرَ يا اِبنَ الجَعفَرِيَّةِ ما","خَلَقَ الإِلَهُ يَدَيكَ لِلبُخلِ",21,"ل",1,1],["يا بشر باشر بِالوَطن","هَذا السَعيدَ أَخا الفطنْ",22,"ن",1,0],["يا بشر فتى عوف الأثير غناء","يا نجح مغازي أبي عبيدة إذ جال",23,"ل",1,0],["يا بِشرُ حَقَّ لِوَجهِكَ التَّبشِيرُ","هَلاَّ غضِبتَ لَنَا وَأنتَ أَمِيرُ",24,"ر",1,0],["يا بشيرا لا يوازي","لكم الزلات تعفا",25,"ف",2,0],["يا بشيري به لبشرت منا","أبداً كل آملٍ بالنجاح",26,"ح",1,0],["يا بشر بشر أَردشير هود","هادي قلوب هادها المريد",27,"د",1,0],["يا بشر قل للآصفي مهنئاً","أبشر فسيفك للحواسد قاصم",28,"م",1,0],["يا بشير الانس أنت كما","تبتغي العليا أخو كرم",29,"م",1,0],["يا بِشرُ إِنَّكِ قَد شَطَّ البِعادُ بِكُم","وَما نَسيتُ لَكُم وَصلاً وَلا صُرُما",30,"م",2,0],["يَا بِشرَ مَن أبرَقَت عَينَاهُ فِي ظُلَمِي","مَا عَادَلَ العَينَ مِن ماسٍ وَمِن ذَهَبِ",31,"ب",1,0],["يا بِشْرُ سِرْ نَحْوَ المَدِينَةِ وَانْعَنا","عِنْدَ النَّبيِّ وَفي البَقِيعِ وَلِلْعَلَنْ",32,"ن",1,0],["يا بِشرَ \"آمنةٍ\" رَأت من نفسِها","نورًا يطوفُ مُغَرِّبًا ومُشَرِّقا",33,"ق",2,0],["يا بشر تكفون حلّو عن سمايه","ما يصيب الهرج لو الهرج صوبي",34,"ب",2,1],["يابشيّر اسمع والحكايا تمني","ناديت لكن مالقى صوتي مجيب",35,"ب",1,1],["يابشيّر اسمع من قبل عام الألفين","ظلم الهموم الموجعات السقيمه",36,"م",2,0],["يابشت من فضلك بليا براهين","أعط الوزير اليوم نقطه إشاره ..!!",37,"ر",2,0],["يابشت من فضلك ترى حالنا ماش","والحال ضاق وضيّق الحال جاشه !!",38,"ش",2,0],["يا بِشرَنا في لِينَة أطْلعْتِها","فوق الغصون النَّاظرات الفائقة",39,"ق",2,0],["يا بشرُ إنْ تُودِ فكُلّ أمرىء ٍ","بمثلما صرتَ إليه رَهِينْ",40,"ن",1,0]]}