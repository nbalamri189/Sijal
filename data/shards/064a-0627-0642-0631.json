px?id=180973",""],[4984,"كأنني من زمن","https://www.poetsgate.com/ViewPoem.aspx?id=215862",""],[5038,"حزني يغني","https://www.poetsgate.com/ViewPoem.aspx?id=189872",""],[5057,"سلوة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=197255",""],[5121,"ميميّة الأم","https://www.poetsgate.com/ViewPoem.aspx?id=33578",""],[5121,"شكرًا","https://www.poetsgate.com/ViewPoem.aspx?id=33661",""],[5136,"نفس على برحى الشوق أطويها","https://www.poetsgate.com/ViewPoem.aspx?id=121778",""],[5183,"مُلْغِزَه رق265م","https://www.poetsgate.com/ViewPoem.aspx?id=186405",""],[5410,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=142234",""],[5467,"حَديثُ اللَّيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=199828",""],[5525,"دروبي رمل","https://www.poetsgate.com/ViewPoem.aspx?id=924",""],[5573,"ياقربنا من بعضنا بالكلام الفصيح","https://www.poetsgate.com/ViewPoem.aspx?id=204537",""],[5790,"تلفت والله روحي","https://www.poetsgate.com/ViewPoem.aspx?id=111989",""],[5922,"أفضل امرءة في التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=183795",""],[5975,"قريتي","https://www.poetsgate.com/ViewPoem.aspx?id=52985",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6068,"هل تنجزيني الموعدا -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175856",""],[6068,"يا قرة العينين أفديك -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175869",""],[6097,"بيدي ودَعتُك...","https://www.poetsgate.com/ViewPoem.aspx?id=190689",""],[6152,"حياة روح","https://www.poetsgate.com/ViewPoem.aspx?id=203140",""],[520,"لو اطلعت على سري وإضماري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577530",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[2220,"يا قرّة َ العين يا مدى أملي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11620&r=&rc=494",""],[6328,"حتّى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84883&r=&rc=24",""]],"verses":[["يا قَريعَ الزَمانِ دِعوَةَ صَبٍّ","بِالأَماني مُتَيَّمٍ بِالمُرادِ",0,"د",1,0],["يا قُرَّةَ العَينِ يا مَن لا أُسمّيهِ","يا مَن إِذا خَدِرَت رِجلي أُناديهِ",1,"ي",2,1],["يا قُرّةَ العيْنِ وُقِيتَ الرّدَى","منْ أعْيُنِ الجنّةِ والإنْسِ",2,"س",1,0],["يَا قُرَّةَ الْعَيْنِ وَيَا حَسْرَتَهَا","يَوْمَ يُوَفَّى النَّاسُ مَا قَدْ عَمِلُوا",3,"ل",3,0],["يا قَريباً حينَ يَنأى","حاضِراً حينَ يَغيبُ",4,"ب",1,0],["يا قُرطُ إِنَّكُمُ قَرينَةُ خِزيَةٍ","وَاللُؤمُ مُعتَقِلٌ قُيونَ عِقالِ",5,"ل",1,0],["ياقَرحُ لَم يَندَمِلِ الأَوَّلُ","فَهَل بِقَلبي لَكُما مَحمَلُ",6,"ل",1,1],["يا قريراً بالمنى يا سيدِي","يا صديقاً للتهاني ألِفا",7,"ف",2,1],["يا قريباً من المحبِّ بعيداً","وعذاباً إلى المحبِّ شهيّا",8,"ي",2,0],["يا قرب مستقياته لوروده","يا بعد أغوار هناك عماق",9,"ق",1,0],["يا قُرَوِيّاً عَظُمَت نَفسُهُ","حَتّى تَرَضَّتها نُفوسُ العُتاة",10,"ه",1,0],["يا قريب الجواب في الفصل والهز","ل عزيز علىّ بطء جوابك",11,"ك",1,0],["يا قُرَّةَ العَينِ كَيفَ أَمسَيتِ","أَعزِز عَلَينا بِما تَشَكَّيتِ",12,"ت",1,1],["يا قرير العيون رق لعين","فجرتها دموعها تفجيرا",13,"ر",2,1],["يا قرة العينين يا تملي","يا واسع التدبير والحيلِ",14,"ل",1,1],["يا قَريبَ المَزارِ","لَكِنَّهُ لا يُساعِفُ",15,"ف",1,0],["يَا قَرِيرَ الْعَيْنِ بِالْوَسَنِ","مَا الَّذِي أَلْهَاكَ عَنْ شَجَنِي",16,"ن",2,1],["يا قَرمَطِيّونَ هَلّا قامَ قَبلَكُمُ","كَمِثلِ ما قامَ قَبلَ البَعثِ أَو تُرِكا",17,"ك",2,1],["يا قَريبَ الدارِ ما وَص","لُكَ مِنّي بِقَريبِ",18,"ب",1,0],["يا قَريبَ الدارِ مِن داري وَقَد","زادَ في البُعدِ عَلى مَن بَعُدا",19,"د",2,1],["يا قُرَّةَ العَينَينِ ما بالُنا","نَشقى وَيَلتَذُّ خَيالانا",20,"ن",2,0],["يا قُرَّةَ العَينِ إِنّي لا أُسَمّيكِ","أَكني بِأُخرى أُسَمّيها وَأعنيكِ",21,"ك",1,1],["يَا قُرَّةً لِعُيُوِني","فِي الصَّدْرِ مِنْهَا سَعِيرُ",22,"ر",1,0],["يا قُرَّةَ العَينِ ما لي","حَتّى أَراكَ قَرارُ",23,"ر",1,0],["يا قُرَّةَ العَينِ ما وَفَتكَ بَكاً","إِذا بَكَت وَالدُموعُ أَمواهُ",24,"ا",2,0],["يا قريبًا من القلوب، بعيدًا","عن رياح الحزبيّة الهَوجاء",25,"ا",2,0],["يا قريش اذكري نمتنا جميعا","صحبة سمحة وقربى أثيره",26,"ر",2,0],["يا قرة العين الا","ترى ضنى حالي الا",27,"ل",2,0],["يا قرة العين وانسانها","انت بملك القلب مني امير",28,"ر",1,0],["يا قرة العيني يا سكني","بلل غليل الموجع الضمن",29,"ن",1,1],["يا قرة العين أنت حسبي","لولاك ما أثمرت غصوني",30,"ن",2,0],["يا قرطُ لا تخفق فقل","بي في هواءِ العشقِ طارْ",31,"ر",1,0],["يا قرّة العين عني أن سألت جوى","قد بتّ في ألم من شدة الوهن",32,"ن",1,1],["يا قرّة العين قل لي كيف بتّ فقد","واللّه بتّ وقلبي في لظى الحزن",33,"ن",1,1],["يا قَرْمَ آلِ محمّدٍ","والقَرْمُ مِن نَسْل القُرومِ",34,"م",1,0],["يا قريباً عصيت فيه التنائي","وعزيزاً اطعت فيه الهوانا",35,"ن",2,1],["يا قرحة السل التي","هدت شراسيف الصدور",36,"ر",1,0],["يا قرحةً في ناظرٍ","غلطوا عليها بالذرور",36,"ر",1,0],["يا قُرَّةَ العَيْنِ إنَّ العَينَ تَهْوَاكِ","فَما تَقَرُّ بِشَيء غير مَرآكِ",37,"ك",1,1],["يا قُرَّةً لعيونِ المجد قد سَخنَت","بَكى لَها الأَشرَفان المَجدُ والشرفُ",38,"ف",1,0],["يا قُرَّةً للعين أَسخَنها الرَدى","وعزيمةً للقَلب فَلَّ شَباها",39,"ا",3,0],["يا قَريباً يا مُجيباً","يا عَليماً يا سَميعا",40,"ي",3,0],["يا قرة العين داركيه","قبل التورط في الهلاك",41,"ك",1,0],["يا قرّة العينِ وقيتَ الأسى","وَدمتَ في عزّ صباحَ مسا",42,"س",2,1],["يا قروداً منقوصة الخالق غيبي","لأرى الموت مستنير المحيا",43,"ي",2,0],["يا قران السعد أكبر","تك عن كل قِرانِ",44,"ن",1,0],["يَا قَرِيبَ النِّفارِ غَيرَ قَرِيبٍ","وَبَعِيدَ الوِصَالِ غَيرَ بَعِيدِ",45,"د",1,0],["يا قريباً من الفؤادِ وإن كا","نَ بَعيدَ المَحلِّ في الآفاق",46,"ق",1,0],["يا قريب الفرج يارب يافارج الهم","يا قريب الفرج يا رب يا كاشف الغم",47,"م",1,1],["يا قريب الفرج فرج على كل مهتم","ياقريب الفرج نسألك تغفر وترحم",47,"م",1,0],["يا قريب الفرج فرج علينا تكرم","استر الحال قبل الصبر يارب ينتم",47,"م",1,0],["يا قُربَ ما اقْتَصِّيتمُ منْ جدّه","وذكرتمُ بدراً عليه وخَيْبَرا",48,"ر",2,0],["يا قرة العين الذي من فقده","هجر المنام نواظري ومقامي",49,"م",2,0],["يا قرير العين في بلده","طيبة في السفح من أجده",50,"د",2,1],["يا قريعَ الزَّمانِ من كُل ذَنبِ","أَعفِني من مَضاضَةِ التَّقريعِ",51,"ع",1,0],["