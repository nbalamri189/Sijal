{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[43,"وشادن روح من يهواه في يده","https://www.aldiwan.net/poem9560.html","البسيط"],[28,"أو تعطف العيس صعرا في أزمتها","https://www.aldiwan.net/poem5053.html","البسيط"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[158,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[235,"قسما بمن بالصد قد أضناني","https://www.aldiwan.net/poem19096.html","الكامل"],[273,"لا جاه للعبد كالخمول","https://www.aldiwan.net/poem25398.html","مخلع البسيط"],[295,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[374,"ما أزمتي اشتدت لوقر خطيتي","https://www.aldiwan.net/poem59284.html","الكامل"],[400,"بالله يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[456,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[498,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[536,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[573,"تدعي العقل وهو أشرف ما فيك","https://www.aldiwan.net/poem2757.html","الخفيف"]],"verses":[["ما أَهمَلوا السائِماتِ حَيثُ رَعَوا","وَلا أَضاعوا الأُمورَ حينَ وَلوا",0,"ل",3,0],["ما اهتزّ كالغصن في أوراق بردته","إلا تساقط من أجفانيَ الغَيم",1,"م",1,0],["ما اِهتَزَّ مِنهُ عَلى عُضوٍ لِيَبتُرَهُ","إِلّا اِتَّقاهُ بِتُرسٍ مِن تَجَلُّدِهِ",2,"د",2,0],["ما اِهتَزَّ عودٌ لَهُ عِرقانِ مِثلُهُما","إِذا تَرَوَّحَ في جُرثومِهِ الشَجَرُ",3,"ر",1,0],["ما اِهتَزَّ وافِرُ رِدفِهِ في خَطوِهِ","إِلّا تَشَكّىالخَصرُ مِن أَثقالِهِ",4,"ل",2,0],["ما أهون النفسَ والنفيس إِذا","ما بقى العرضُ غيرَ ممتهن!",5,"ن",1,0],["ما اهتدى بالنجم في جنح الدُّجى","بل سرى النجمُ لعَمْري في سَناهْ",6,"ا",2,0],["ما اهتز نعشك يوم صفف عوده","الا لأنك كنت من خطبائه",7,"ا",3,0],["ما أهلَ باغتة بأقوى منهمُ","كلا ولا من في فسال أضعفا",8,"ف",2,0],["مَا اهْتَاجَ قُمْرِيٌّ بِأَفْنَانِ الرُّبَى","وَتَمَايَسَتْ هَيْفَا غُصُونِ الْبَانِ",9,"ن",1,0],["ما أهمل الحزم في الخصايا","غاسلُتها بالدمِ الهمول",10,"ل",1,0],["ما اِهتزَّ من طَرَبٍ إلّا شَدا طَرَباً","من الحُليِّ على عِطفيه صادِحُهُ",11,"ح",2,0],["ماأهدت الأفكار ثَمْرَ رويتي","إلّا وأردفتُ الهدى والسبحَلَهْ",12,"ل",2,0],["ما اهتز لينا قَدُّه","إلا اهتززت طربا",13,"ب",2,0],["ما أُهِّلوا لما ابتنى موسدا","جِلستَهم وما سقَى وما خَتَمْ",14,"م",1,0],["ما اهتزَّ برقُ الحِما الشَّرقِيِّ مضْطَرِباً","إِلاَّ ومنه الفُؤادُ الوالِهُ اضْطَرَبَا",15,"ب",2,0],["ما اهتَزَّ قلبُ الشعبِ من َفَرَحٍ إذا","بحلولِ عيدِ العرشِ جاءَ بَشيرُ",16,"ر",1,0],["ما أَهانَ الوَرَى ولا مَلَكَ الدُّنْ","يَا ولا حَازَها سوى المُتنَسِّك",17,"ك",1,0]]}