{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[74,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[45,"وشادن روح من يهواه في يده","https://www.aldiwan.net/poem9560.html","البسيط"],[30,"أو تعطف العيس صعرا في أزمتها","https://www.aldiwan.net/poem5053.html","البسيط"],[68,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[108,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[92,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[164,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[242,"قسما بمن بالصد قد أضناني","https://www.aldiwan.net/poem19096.html","الكامل"],[280,"لا جاه للعبد كالخمول","https://www.aldiwan.net/poem25398.html","مخلع البسيط"],[302,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[382,"ما أزمتي اشتدت لوقر خطيتي","https://www.aldiwan.net/poem59284.html","الكامل"],[409,"بالله يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[463,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[505,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[543,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[580,"تدعي العقل وهو أشرف ما فيك","https://www.aldiwan.net/poem2757.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63835","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38949","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55931","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56094","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202162","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77273","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28518","الكامل"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216401",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45796","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117847","الكامل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21416","الرجز"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147249","الكامل"],[4104,"","https://poetry.dctabudhabi.ae/diwan/poem/125321","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83532","السريع"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139247","السريع"],[5163,"عراق","https://www.poetsgate.com/ViewPoem.aspx?id=34064",""],[5277,"مقهى البيروتي.. ذاكرة المكان..","https://www.poetsgate.com/ViewPoem.aspx?id=185251",""],[5574,"تائية أبي ريما","https://www.poetsgate.com/ViewPoem.aspx?id=206045",""],[5781,"عراقُ فاتحةُ القصيدةِ والنهايات","https://www.poetsgate.com/ViewPoem.aspx?id=202842",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[5952,"في يوم مولده","https://www.poetsgate.com/ViewPoem.aspx?id=207804",""],[5956,"مجدي وماجدة كانا كقيس وليلى","https://www.poetsgate.com/ViewPoem.aspx?id=194220",""],[5956,"من الجلوس اللّا سليم ظهر نجلي اْحدَودَب","https://www.poetsgate.com/ViewPoem.aspx?id=194784",""],[6056,"الجرح القديم","https://www.poetsgate.com/ViewPoem.aspx?id=130355",""],[6125,"كان الهجير وبعض الوصل ما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=210895",""],[6189,"حاشية على الجرح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83547&r=&rc=14",""],[6198,"القرط الأزرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79237&r=&rc=11",""]],"verses":[["ما أَهمَلوا السائِماتِ حَيثُ رَعَوا","وَلا أَضاعوا الأُمورَ حينَ وَلوا",0,"ل",3,0],["ما اهتزّ كالغصن في أوراق بردته","إلا تساقط من أجفانيَ الغَيم",1,"م",1,0],["ما اِهتَزَّ مِنهُ عَلى عُضوٍ لِيَبتُرَهُ","إِلّا اِتَّقاهُ بِتُرسٍ مِن تَجَلُّدِهِ",2,"د",2,0],["ما اِهتَزَّ عودٌ لَهُ عِرقانِ مِثلُهُما","إِذا تَرَوَّحَ في جُرثومِهِ الشَجَرُ",3,"ر",1,0],["ما اِهتَزَّ وافِرُ رِدفِهِ في خَطوِهِ","إِلّا تَشَكّىالخَصرُ مِن أَثقالِهِ",4,"ل",2,0],["ما أهون النفسَ والنفيس إِذا","ما بقى العرضُ غيرَ ممتهن!",5,"ن",1,0],["ما اهتدى بالنجم في جنح الدُّجى","بل سرى النجمُ لعَمْري في سَناهْ",6,"ا",2,0],["ما اهتز نعشك يوم صفف عوده","الا لأنك كنت من خطبائه",7,"ا",3,0],["ما أهلَ باغتة بأقوى منهمُ","كلا ولا من في فسال أضعفا",8,"ف",2,0],["مَا اهْتَاجَ قُمْرِيٌّ بِأَفْنَانِ الرُّبَى","وَتَمَايَسَتْ هَيْفَا غُصُونِ الْبَانِ",9,"ن",1,0],["ما أهمل الحزم في الخصايا","غاسلُتها بالدمِ الهمول",10,"ل",1,0],["ما اِهتزَّ من طَرَبٍ إلّا شَدا طَرَباً","من الحُليِّ على عِطفيه صادِحُهُ",11,"ح",2,0],["ماأهدت الأفكار ثَمْرَ رويتي","إلّا وأردفتُ الهدى والسبحَلَهْ",12,"ل",2,0],["ما اهتز لينا قَدُّه","إلا اهتززت طربا",13,"ب",2,0],["ما أُهِّلوا لما ابتنى موسدا","جِلستَهم وما سقَى وما خَتَمْ",14,"م",1,0],["ما اهتزَّ برقُ الحِما الشَّرقِيِّ مضْطَرِباً","إِلاَّ ومنه الفُؤادُ الوالِهُ اضْطَرَبَا",15,"ب",2,0],["ما اهتَزَّ قلبُ الشعبِ من َفَرَحٍ إذا","بحلولِ عيدِ العرشِ جاءَ بَشيرُ",16,"ر",1,0],["ما أَهانَ الوَرَى ولا مَلَكَ الدُّنْ","يَا ولا حَازَها سوى المُتنَسِّك",17,"ك",1,0],["ما أهلها بالمسلمي","ن ولا اليهودِ ولا النصارى",18,"ر",2,0],["ما اِهتَزَّ غُصنٌ ما شَدا الحمامُ","ما لاحَ بَرقُ ما هَمى الغَمامُ",19,"م",1,0],["ما اِهتَزَّ غُصنٌ وَما الوَرقاءُ قَد خَطَبت","فَوقَ الغصونِ فَأَبدت أَحسَن الخطَبِ",20,"ب",1,0],["ما اهتزّ عصنٌ في الرياض وباكرت","تشدو البلابل فوقه وتغردُ",21,"د",1,0],["ما اهتز غصن عليه الصادحات شدت","وما ضيا البدر من شمس الضحى أفلا",22,"ل",2,0],["ما اهْتَزَّ في الجُودِ مِنْ مِثْلٍ لَهُ وكَذا","ما هَزَّ عِطْفيهِ بَيْنَ البيضِ والأَسَلِ",23,"ل",1,0],["ما اهتَزَّ غُصنُ الصِّبا مِن عِطْف قامته","إِلاّ وأَزْرى بِغُصن البانِ أَو هَزَأَ",24,"ا",1,0],["ما أَهلُ أوربا لَدَيهِ وَفَنُّهُم","كَم طارَ قَبلهُمُ غُرابٌ أَسحَمُ",25,"م",1,0],["ما أَهوَنَ الدُّنيا إِذا نَظَرَ امرؤ","فيها وَآنَ لِحازِمٍ أَن يَنظُرا",26,"ر",2,0],["ما اَهَقِي لي فايت يْرِدّي","مِثل عُمْرٍ وقَّف حْسابه",27,"ب",2,0],["ما أَهل هَذا القطر غَير سَحابة","بِالقطر جادَت منهُ بَحر قَد عَلا",28,"ل",2,0],["ما اهتز روض بالحيا وترنّمت","أطياره من صافر أو هادل",29,"ل",1,0],["ما اهتَجتُ حَتّى هَتَّكوا الخوالِفا","غَدَوا وَرَدُّوا جِلَّةً مَقاذِفا",30,"ف",2,0],["ما اهتزَّ منهم شعرةٌ لمصاحفٍ","حُرِقت ولا دحروا الذي عاداكَ",31,"ك",1,0],["ما أهلك الامم الماضين قبلكم","إلا الجدال وخلط الجد بالهزل",32,"ل",1,0],["ما أَهَّلتني لِلعُلى نَظرَةٌ","مِنكَ وَكَم أَهَّلتَ من أُهِّلا",33,"ل",2,0],["ما أهنأ الإنسان في عيشه","ما بين أهليه وفي منزله",34,"ل",2,1],["ما اهتز رمشك وهو مشتَمِلٌ","بالحسنَيَيْنُ وانتَ في ألقِ",35,"ق",1,0],["ما أهونَ الدمعَ إنْ فاضتْ بِهِ مقلٌ","تبكي العراقَ وسالتْ مِنْ مآقيهِ",36,"ي",2,0],["١٥- ما أهنأ القلبَ الذي قدْ طافَ في","حَرَمِ العِناقِ مُلبّياً بجِهاتِها",37,"ت",3,0],["ما اهتزَّ جَفْني بِوَقدِ النَّارِ في مُقَلي","فالشَّمسُ إنْ نَظَرَتْ عَيْنَيَّ تضْطرِبُ",38,"ب",1,0],["ما اهتدى مثلي بدُجْناتِ الهوى","لو سَرى والليل . حتَّى يتْبَعَك",39,"ك",1,0],["ما اهتزت الأرض إلا من سعادتها","\"يا جدُّ\" إذْ قيلَ \"إن النورَ يُلتَقَفُ\"",40,"ف",1,0],["ما أهملتْكَ ولم ترتدَّ عن سُبُل","تُفضي لبرْئك، كانت خير جائدةٍ",41,"د",2,0],["ما اهتم قطُّ بعزمه في صحوهِ","ومنامهِ حتى اغتدى رمزَ الغبا...",42,"ب",2,0],["مااهتني بالنوم من صالي اللهب","مشعل ٍ في ضامري نارالجحيم",43,"م",1,0],["ما أهلك الوجد في نفسي إذا اتكأت","أركان مثلي لتُحيي فيكِ أركانا",44,"ن",2,0],["ما اهتز حبل السَّرجِ من تحته","ولا عرفنا مُهره يجمح",45,"ح",1,0],["ما اهتزَّ - مذ درج الهوى في مهجتي","إلا سنابلُ من عذابٍ... تخفق",46,"ق",1,0]]}