","https://poetry.dctabudhabi.ae/diwan/poem/62781","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126936","الوافر"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20616","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109976","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89988","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114408","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114272","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114104","البسيط"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142989","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111421","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136917",""],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105136","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100666","الكامل"],[4475,"","https://poetry.dctabudhabi.ae/diwan/poem/206212","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58033","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136404",""],[4859,"بديع خصالي","https://www.poetsgate.com/ViewPoem.aspx?id=187708",""],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[4978,"الدكتور إسلام مازني","https://www.poetsgate.com/ViewPoem.aspx?id=191567",""],[3591,"رأيت فقيراً قد أتى يسأل الطعما","https://www.poetsgate.com/ViewPoem.aspx?id=149425",""],[5348,"صوت من الصف الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=59563",""],[567,"ألوى علي فضمني وضممته","https://www.poetsgate.com/ViewPoem.aspx?id=201616",""],[5582,"أَلا حَدِّثانِي عَنْ رُسُومِ المَعاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63501",""],[5587,"فضاء عذابي","https://www.poetsgate.com/ViewPoem.aspx?id=196770",""],[5616,"حب","https://www.poetsgate.com/ViewPoem.aspx?id=203185",""],[5703,"حط العصفور بشباكي","https://www.poetsgate.com/ViewPoem.aspx?id=207400",""],[5751,"خطوتانِ لقَمَرٍ هارب","https://www.poetsgate.com/ViewPoem.aspx?id=214718",""],[5759,"بانَ السهادُ","https://www.poetsgate.com/ViewPoem.aspx?id=214824",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6152,"لقاء على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=204740",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""]],"verses":[["فَكانَ كَلِبدَةِ الضِرغامِ عِزّاً","إِذا ذَلَّ المُوَقِّعُ لِلخُصومِ",0,"م",1,0],["فَكانَ كَالكَلبِ ضَرّاهُ مُكَلِّبُهُ","لِصَيدِهِ فَعَدا فَاِصطادَ كَلّابَه",1,"ب",2,0],["فكأنكم لم تسمعوا بمُشَبِّهٍ","قبلي ولم تتعودوا تصويبَهُ",2,"ب",2,0],["فكأنك الينبوتُ في إبدائهِ","شوكاً يذودُ به عن الخرّوبِ",3,"ب",1,0],["فكان كلا البدرين صعباً مرامُهُ","ليَ الويل من بدر السماء ومن بدري",4,"ر",2,0],["فكأنك البدرُ المنيرُ مكلَّلاً","من طالعاتِ سعودهِ إكليلا",5,"ل",2,0],["فكأنك المقدارُ يخفَى شخصُه","ويُحرِّك الأشياءَ طُرّاً ساكنا",6,"ن",2,0],["فَكانَ كَالكَوكَبِ يَمشي عَلى","ضِيائِهِ الرَكب وَذِئبُ الفَلاة",7,"ه",1,0],["فَكانَ كَذي تَبلٍ تَذَكَّرَ ما مَضى","وَقَد كَرَّ كَرّاتِ الكَريمِ المُقاتِلِ",8,"ل",1,0],["فَكَأَنَّكَ المَأمونُ في سُلطانِهِ","في ظِلِّكَ الأَعلامُ وَالأَقلامُ",9,"م",1,0],["فَكَأَنَّكَ الفاروقُ في كُرسِيِّهِ","نَعِمَت شُعوبُ الأَرضِ تَحتَ ظِلالِهِ",10,"ل",2,0],["فَكَأَنَّ كُلَّ سَحابَةٍ وَكَفَت بِها","تَبكي بِعَينَي عُروَةَ اِبنِ حِزامِ",11,"م",1,0],["فَكانَ كَما ظَنّوا بِهِ وَالَّذي رَجَوا","لَهُم حينَ أَلقوا عَن حَراجيجَ لُغَّبِ",12,"ب",1,0],["فَكانَ كَعَنزِ السوءِ قامَت بِظِلفِها","إِلى مُديَةٍ وَسطَ التُرابِ تُثيرُها",13,"ر",3,0],["فكأنك الدهر المحيط عليهم","وكأنهم من حولك الأيام",14,"م",1,0],["فَكانَ كَشاةِ الرَملِ قَيَّضَهُ الرَدى","لِقانِصِهِ مِن قَبلِ نَصبِ الحَبائِلِ",15,"ل",1,0],["فَكَأَنَّ كَأسَ سُلافَةٍ","ضَحِكَت إِلَيهِم عَن حَبابِ",16,"ب",1,0],["فكأنَّ كُلّاً مُعرِسٌ وكأنَّما","منه ومِنك مُهنِّئٌ ومُرفِّحُ",17,"ح",1,0],["فَكَأَنَّ كَفَّيهِ تُقَسِّمُ في","أَقداحِنا قِطَعاً مِنَ الشَمسِ",18,"س",1,0],["فكأنّكَ المقدارُ يعرفُه الورى","من غيرِ تكييفٍ ولا تحديد",19,"د",1,0],["فَكانَ كَما قَلَ اِبنُ نوحٍ سَأَرتَقي","إِلى جَبَلٍ مِن خَشيَةِ الماءِ عاصِمِ",20,"م",1,0],["فكأن كل خميلة ألقت على","كتفيه أردية ، من الأفواف",21,"ف",1,0],["فَكَأَنَّ كُلَّ سَحابَةٍ وَكَفَت بِها","تَبكي بِعَينَي عُروَةَ بنِ حِزامِ",22,"م",1,0],["فَكانَ كَاللَيلِ البَهيمِ حَلَّ في","أَرجائِهِ ضَوءُ صَباحٍ فَاِنجَلى",23,"ا",1,0],["فكان كأنما الساعا","ت في اثنائه تُحَف",24,"ف",1,0],["فكان كما زار الخيالُ مسلِّما","وودَّع إلا أنني فيه يقظان",25,"ن",1,0],["فكان كأجيادِ الظباء تلفَّتت","فأظهرْنَ تدريجا هناك مُغَضَّنا",26,"ن",2,0],["فَكانَ كَالجَهلِ لِلعُرفانِ عَجرَفَةٌ","وَكانَ لِلجَهلِ كَالعِرفانِ عُرفانِ",27,"ن",1,0],["فَكَأَنَّكُم عِندي نَهاري كُلُّهُ","وَإِذا رَقَدتُ يَكونُ تَحتَ وِسادي",28,"ي",1,0],["فكان كلَّما كذب","وَقال إِفكاً واِنتدَب",29,"ب",1,0],["فكان كسهم غدا صاعداً","ولما انتهت قوةُ الدفع عاد",30,"د",1,0],["فَكأنّ كلّ شريعةٍ مِن قَبلها","في صلِّها صنو من الصنوانِ",31,"ن",1,0],["فَكَأَنَّ كُلَّ قَرارَةٍ قارورَةٌ","رَقَّت فَلاحَ ضَميرُها المَستورُ",32,"ر",1,0],["فكان كالبَحْرِ زَخَر","فَعَمَّ كُلاً بالمَطَر",33,"ر",1,0],["فكأنَّ كأسَ عُقارنا في كفِّها","بطلٌ من الفُرسانِ في المَيدانِ",34,"ن",1,0],["فكان كلامهم في الأرض ملحاً","يزيلُ فسادها والإغتيالا",35,"ل",2,0],["فكأنك العشواءُ تخبطُ في الدجى","مُتسكّعاً تتوقّعُ الإفضاءَ",36,"ا",2,0],["فكان كالعدل يجر جرا","أدنيته من أهله فسرا",37,"ر",2,0],["فكان كما قال الزمان وساعدت","وشاة وعذالاً أشاعوا وشيعوا",38,"ع",3,0],["فكان كالبحر وهو ملحٌ","لم يُرْوَ من مائه أوام",39,"م",1,0],["فكأَنَّ كأس الرَّاح برق لامع","وكأَنَّ جنح الليل غيم مطبق",40,"ق",1,0],["فكانَ كأَنَّهُ جَفْنٌ سَخينٌ","أسالَ دماً على خَدٍّ أسيلِ",41,"ل",1,0],["فكان كلُّ درهم","في ماله لِقبلَهْ",42,"ل",2,0],["فكأنكم ومدىً بعيدٌ بينكم","يومَ افتقدتُكَ زٌلتُمُ عن مَوعِدِ",43,"د",1,0],["فَكانَ كَلاً ولا ما أَبصروها","وَضَلّوا من قتيلٍ أَو سَليبِ",44,"ب",1,0],["فكان كَعارضٍ هَتِنٍ سَحوحٍ","تَداركَ رُفْقَةً وبها أُوامُ",45,"م",1,0],["فكأنَّ كل خميلةٍ مطولةٍ","تثني إليك لمى المهاة الرودِ",46,"د",1,0],["فكان كرجع الطرف وحشة آهل","من العز حتى قيل أونس آهله",47,"ل",2,0],["فكانَ كرَيْعان الضُّحى كُلَّما دَنا","يَزِيد علينا بَسطةً ويَطولُ",48,"ل",1,0],["فَكَأَنَّ كِسْرَى فِي الزُّجَاجَةِ سَابحٌ","فِي المَاءِ يَغْرَقُ تَارَةً وَيَعُومُ",49,"م",1,0],["فكان كما كانت صفات نتاجه","مراصد عدوان وهوات آجال",50,"ل",1,0],["فكأن كارثتي نُكبت بها ولا","سلوى تلطف وقعها تلطيفا",51,"ف",2,0],["فكأنك الشمس المضيئة أشرقت","بين البرية فامّحى الديجور",52,"ر",1,0],["فكأنَّ كفَّك دِيمةٌ مُزنيَّةٌ","وكأنَّ قلبَك زُبرَةَ الحَدّادِ",53,"د",1,0],["فكأن كل واحدٍ منهم يع","قوب قد جاءه بنوه عشاءا",54,"ا",3,0],["فكأن كل الأرض كانت عنده","حرماً وكل الدهر يوم ترهب",55,"ب",1,0],["فَكَأنك الفاروق قامَ بِنَصرِها","ما بَين أُمة زَمزم وَحَطيم",56,"م",1,0],["فكان كصفصافة زعزعت","وللفور فوق البساط جثا",57,"ث",2,0],["فكانَ كبدرٍ عارَضتهُ سحابةٌ","لتحجبهُ عنّا فلم يحتجب عنّا",58,"ن",2,0],["فكأن كانت أحاديث منى","أو منى ما خانني فيه انتباهي",59,"ا",3,0],["فكان كقاب قو","سين أوفقل أدنى أمد",60,"د",1,0],["فَكانَ كعمدان وكنت كربّه","وَما خابَ سعي فيهم لمجاهدِ",61,"د",1,0],["فَكانَ كُل الخَلق عَبداً لَهُم","وَلَستُ في مَقالتَي أتهم",62,"م",1,0],["فكان كالإقواء فيه المانع","مع أخويه مطلقا والرابع",63,"ع",1,0],["فكأنّك الأيامُ ليس","يسرُّها إلاّ عِنادى",64,"د",2,0],["فَكانَ كَلَمعِ البَرقِ أَومَضَ ضوؤُهُ","فَلَمّا خَفا الأَلحاظَ سارَ فَأَسرَعا",65,"ع",2,0],["فكأَنَّ كلَّ مقامٍ احتلاّ به","حرمٌ وحجٌّ كلَّ يومٍ يُخلق",66,"ق",1,0],["فكأن كلا من قبائله","خنساؤه وكأنه صخر",67,"ر",1,0],["فكان كما قال امرؤ القس واصفاً","جواداً كريماً ذا قياد مذلل",68,"ل",1,1],["فكان كعمر الدهر طولاً وكيف لا","يطول دجى فيه الكواكب لا تسري",69,"ر",2,0],["فكان كموسى قد أتى بيمينه","عصاً أبطلت ما يأفكون من السحر",70,"ر",1,0],["فَكانَ كَذاتِ الحَيضِ لَم تُبقِ ماءَها","وَلَم تُنقِ عَنها غُسلَها لأوانِ",71,"ن",1,0],["فكان كطيبِ الأمنِ وافى لخائفٍ","وكالنيّر الأعلى به يهتدى الساري",72,"ر",2,0],["فكأنّ كنيتهُ غدت موضوعهُ","من ربّه والوصف منه مقرّرا",73,"ر",2,0],["فكان كل منهما مجلياً","والأصل قد يأتي نجيباً فرعه",74,"ع",2,0],["فكان كما قالت بطيئا بابله","شفيقا من البيداء غير ملول",75,"ل",1,0],["فكان كوعد عرقوب أخاه","بيثرب إذ به قدماً ألما",76,"م",2,0],["فكأنك في المعنى موسى","وبنو إسرائيل العسكر",77,"ر",1,0],["فكان كمَنْ أهدى إلى النارِ أُكلَها","وكنْتَ كمَنْ راضَ الشّموسَ وذَلّلا",78,"ل",2,0],["فكان كجيفة نتنت وإني","كعود زاده الأحراق طيبا",79,"ب",2,0],["فَكَأَنَّكُم فيما مَضى مِن عيشَتي","لَم تَعلَموا وَتَرَوا هَوايَ وَتَسمَعوا",80,"ع",3,0],["فكأَنَّ كُلاً منكمُ هو عنترٌ","وخيولكم ما منها الا ابجرُ",81,"ر",1,0],["فكانَ كالكاتبِ سطراً سها","فيهِ فما لبَّثَ حتى محاه",82,"ا",2,0],["فكأنَّكُم شمسُ الأصيلِ وظلُّها","شَوقي فمهلاً قد براني سعيكُم",83,"م",1,0],["فَكَانَ كَتَالِيهِ مُهَيّا لِفَتحِهِ","وَثَالِثُهَا لَم يُبلَ بِالقَطعِ وَالقَطِّ",84,"ط",1,0],["فَكَانَ كُلُّ لَبِيبٍ غَيرَ قَابِلِهَا","وإن بَرَت مِن مَفَاسِدٍ نَقِيَّاتِ",85,"ت",1,0],["فكان كنمل دب في العاج قاصداً","ليجتز في رفقٍ من الصدغ عقربا",86,"ب",2,0],["فكانَ كالفَحل ما بَينَ الصِّوَارِ متى","يَقُم شُمُوخاً على قُطعانِهِ يَسُدِ",87,"د",1,0],["فكان كل منهما يا صاح","أبدع فيه فالق الإصباح",88,"ح",1,0],["فكان كإبراهيم زار مقامه","وفي حجر إسماعيل كان كباينه",89,"ي",3,0],["فكان كطيب نما عرفه","ونمّ عليه بريق العيون",90,"ن",1,0],["فكان كالمسك بين العجم والعرب","يفوح نشر حديثي من شذا أدبي",91,"ي",1,0],["فكان كنجمٍ يستدل بمشهد","بوجه كبدرٍ طالع بين أنجم",92,"م",1,0],["فكأنكم ملتم سما","عاً نحو افواه العدى",93,"د",2,0],["فكان كفضة سكت عموداً","عليها أسطر باللازورد",94,"د",1,0],["فكان كلُّ الذي عاينتُ في زمني","كطيفِ حُلْمٍ أَتَيٍ في ليلةٍ سحرا",95,"ر",2,0],["فكان كناطح صخراً وأعشى","يرى الزرقاء ذات عشى قبيح",96,"ح",1,0],["فكأنّ كبرَك قد أصابكَ بالعمى","عن كل حسنٍ في الدّنى وجمالِ !",97,"ل",1,0],["فَكَأَنَّ كِسْرَىْ مَاْ تَكَسَّرَ إِنَّمَاْ","خَضَعَتْ لِجَذْوَةِ نَاْرِهِ الأَمْجَاْدُ",98,"د",1,0],["فكأنك البشرى أتيت مبلسما","قلبا تجشم بالفراق نكالا",99,"ل",2,0],["فكان كفاني حسرتي وكآبتي","عليه وأغناني بكائي والغمّا",100,"م",2,0],["فكأنَّ كَفّكَ لَمْ تَربت خَدَّهُ","يوماً، ولَمْ تَسد إليهِ جميلا",101,"ل",2,0],["فكأن كل الدهر مدة لحظة","وكأن كل الأرض دارة درهم",102,"م",1,0],["فَكانَ كَغُمْدانٍ وَكُنْتَ كَرَبِّهِ","وَما خابَ سَعْيٌ فِيهِمُ لِمُجاهِدِ",103,"د",1,0],["فَكَأَنَّ كُلَّ كِتَابَةٍ وَصَفَتْ بِهَا","تَشْكِي بِشِعْرِي مُرَّهُ بِمُصَابِي",104,"ب",2,0],["فكأن كل كلامنا معزوفةٌ","ممجوجةٌ وتكلّفٌ ونفاق!",105,"ق",1,0],["فكأنكَ ياروحي قَمرٌ","نجماتُ الليلِ ستسرقُهُ",106,"ق",2,0],["فكأنَّ كَوْناً مِنْ قلوبٍ خافِقاتٍ","فيهِ ، والريحَ العقيمَ ؛ وما غَدا",107,"د",2,0],["فكأنكُم تتعمّدونَ مَساءَتي","مُرتادةً حُلُماً بها يَرتادُ",108,"د",1,0],["فكأنَّكِ استقللتِ دمعَهُمُ على","هَذَا المُصَابِ فَجِئْتِ بالإمْدَادِ",109,"د",1,0],["فكأن كل الحسن فيكِ مجمع","لا ريب فيكِ وما عليكِ غبارُ",110,"ر",1,0],["فكان كالغيمة الحُبلى تُراقبني","أمشي,أنامُ, أبيعُ الجمرَ والوجعَا",111,"ع",2,0]]}