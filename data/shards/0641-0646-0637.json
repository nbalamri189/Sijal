{"poems":[[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[33,"وَلَقَدْ أَشْهَدُ المُحَدِّثَ عِنْدَ کلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19117&r=&rc=379",""],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[396,"سلام على أهل الظنون الجميلة","https://www.aldiwan.net/poem54605.html","عموديه"],[447,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[463,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[539,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77519","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77476","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77673","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77634","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67998","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109979","البسيط"],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""]],"verses":[["فَنَطا الكَرى عن مُقلَتَيْهِ شادِنٌ","عَبِثَ الفُتورُ بلَحْظِهِ وَسْنانُ",0,"ن",1,0],["فَکنْطَلِقْ صَاغِراً فَلَيْسَ لَهَا الصَّرْ","مُ لَدَيّنا، وَلاَ إَلَيْها الهَوَانُ",1,"ن",1,0],["فنطوف القدوم أول شيء","ابتداء بالبيت كالأختتام",2,"م",1,0],["فنطلب مولانا لنا وله بان","يمن علينا ذو الجلال بتوبة",3,"ه",1,0],["فنطلب منك أن تنشي سحابا","ورعداً بعد ما نشأت حداها",4,"ا",3,0],["فنطقن والأشعار خُرسٌ عندنا","ونجون سبقاً والقوافي طُلَّحُ",5,"ح",1,0],["فنطق الضاد منطقنا جميعا","ودين الشعب إسلام ترامي",6,"م",2,0],["فَنَطَّ وَاِستَوى عَلى عِصِيِّها","وَحوَّط المَكارُ رجليهِ بِها",7,"ه",2,0],["فَنَطرت ثَوراً عَظيم الجرم","وَاستضغرت جثتها في الحجم",8,"م",1,0],["فَنَطَقت بِمَنطقٍ فَصيحِ","وَأخبرت بِالخَبَر الصَحيحِ",9,"ح",1,0],["فَنَطَّ فيهِ وَما زالَت أَصابِعه","تُمزّق الغُصنَ كَالتَمزيقِ في الجَسَدِ",10,"د",1,0],["فَنط أُمور الدار","بِهِ وَلا تمار",11,"ر",1,0],["فَنَطحُكَ نِصفٌ ثُمَّ أربَعَ عَشرَةَ","على جَاهِ تِسعٍ في جميعِ المَضَارِبِ",12,"ب",1,0],["فنُطعمكم لحمَ الظباء مهضَّباً","رمتْه أيادينا بظَهر السَّباسِب",13,"ب",1,0],["فنُطفةٌ مَذِرَت او جيفةٌ قَذُرَت","في رَحمِ حَوَّاءَ في أَرحامِ أرماسِ",14,"س",1,0],["فنطاح، ولا نطاح معيز،","فقراع، ولا قراع رماح",15,"ح",1,0]]}