5926,"يمانية","https://www.poetsgate.com/ViewPoem.aspx?id=214312",""],[5937,"موجزٌ عربي","https://www.poetsgate.com/ViewPoem.aspx?id=211884",""],[5956,"بكل جلاله يأتي إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=194012",""],[5997,"المنصور اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=215047",""],[6093,"ربابٌ ( الوافر)","https://www.poetsgate.com/ViewPoem.aspx?id=176208",""],[6093,"بوجه نَعُومٍ رأيت شروقاً ( المتقارب )","https://www.poetsgate.com/ViewPoem.aspx?id=176585",""],[6124,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=109745",""],[6125,"سَحيقٌ في حناياهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210596",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[6243,"قهرية البوح المفاجئ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84427&r=&rc=1",""],[6334,"في الرمل حمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82250&r=&rc=0",""],[6351,"جواب يفتش عن سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86046&r=&rc=6",""]],"verses":[["يُماطِلنَ بِالوَخدِ عِندَ الجِذابِ","كَأَنَّ الزَمامَ مَكانَ العِقالِ",0,"ل",1,0],["يَمانِيَةٌ مِن أَجلِها لا يُغبُّني","تَذَكُّرُ حَيٍّ بالعُذَيْبِ هِجانِ",1,"ن",1,0],["يُمارِينَ بالرُّكْبانِ وهْماً كأنّهُ","يُحاذِرُ صِلاًّ آخِذاً بالمُخَطَّمِ",2,"م",1,0],["يَمَانِيَةُ الْمَنَاسِبِ وَالْمَوَاضِي","مَفَاخِرُهَا رُسُومٌ مُسْتَقِلَّهْ",3,"ل",2,0],["يُماشيهِ جِبريلٌ وَتَسعى وَراءَهُ","مَلائِكَةٌ تَرعى خُطاهُ وَتَخفِرُ",4,"ر",1,0],["يُماثِلُ نَصلي في صَفاءِ فِرِندِهِ","وَيَحكيهِ مِنهُ رَونَقٌ وَغِرارُ",5,"ر",1,0],["يَمانِيَةٌ تَدنو وَيَنأى مَزارُها","فَسِيّانِ مِنها في الهَوى القُربُ وَالبُعدُ",6,"د",1,0],["يَمانٍ لَهُ التاجُ مِن بَينِهِم","بِما أَورَثَ التُبَّعونَ الأُوَل",7,"ل",1,0],["يَمانيَةٌ تُلِم بِنَا فَتُبدِي","دَقيقَ مَحَاسنٍ وَتُكِنُّ غَيلا",8,"ل",2,0],["يَمانيَةٌ في وَثبِها عَجرَفيَّةٌ","إِذا انضَمَّ إِطلاها وَأَودى سَنامُها",9,"م",3,0],["يُمارِسُ غُلَّ أَسمَرَ سَمهَرِيٍّ","قَصيرَ الخَطوِ مُختَضِعَ القِيادِ",10,"د",1,0],["يُماشي عَدِيّاً لُؤمُها ما تُجِنُّهُ","مِنَ الناسِ ما ماشَت عَدِيّاً ظِلالُها",11,"ل",3,0],["يَمانونَ عادِيّونَ لَم يَلتَبِس بِنا","مُناسِبُ شابَت مِن أُلي وَأولَئِكِ",12,"ك",1,0],["يَمانونَ تَدعونا سَبا فَنُجيبَها","إِلى الجَوهَرِ المَكنونِ خَيرِ الجَواهِرِ",13,"ر",1,0],["يَمَانُونَ مَيْمُونو النَّقائِبِ فيكُمُ","مُنَاصَحَةٌ صِرْفٌ لمن يَتَمَعْدَدُ",14,"د",1,0],["يمانُون ميمونُو النقائب لم يزل","لكم نَسبٌ في محتدِ القوم واسِط",15,"ط",1,0],["يمّاً تلاطم في غزارته","آذيُّهُ وطمى تولُّعه",16,"ع",2,0],["يَمانِيَةٍ أَحيا لَها مَظَّ مَأبِدٍ","وَآلِ قَراسٍ صَوبُ أَسقِيَةٍ كُحلِ",17,"ل",1,0],["يَمانٍ كَلَونِ المِلحِ يُرعَدُ مَتنُهُ","إِذا هُزَّ مَطبوعٌ عَلى السَمِّ جارِحُ",18,"ح",1,0],["يَمانِيةٌ تزجي أغنَّ مهلهلاً","كأنّ النعام الرُّمدَ فيه يرودُ",19,"د",1,0],["يَمامَةٌ كانَت بِأَعلى الشَجَرَه","آمِنَةً في عُشِّها مُستَتِرَه",20,"ه",1,1],["يَمانِيَةٌ كَأَنَّ شَآمِياتٌ","رَجَحنَ بِجانِبَيهِ عَنِ الغُؤورِ",21,"ر",1,0],["يمانٍ كلما استمطرْتُ صوْباً","به من عارض المهَجات صابا",22,"ب",2,0],["يُمارسُ فيه شِرَّةَ كلِّ ضارٍ","سريعِ الشَّدِّ مُستعِرِ الوُثوبِ",23,"ب",1,0],["يُمانِعُ ضَوءَ الفَجرِ وَالفَجرُ صادِعٌ","كَما عارَضَ البُرهانَ قَولٌ مُلَفَّقُ",24,"ق",1,0],["يَمانِيٌّ تَبوَّغُ لِلمَساعي","يَجاهُ وَكُلُّ ذي حَسَبٍ يَماني",25,"ن",2,0],["يُماصِعُهُ كُلٌّ يُشَجِّعُ قَومُهُ","وَما ضَربُهُ هامَ العِدى لِيُشَجَّعا",26,"ع",2,0],["يَمانِيَّةٌ هاجَت فُؤادي وَوَكِّلَت","بِها النَفس حَتّى دَمعُ عَينَيَّ يَذرِفُ",27,"ف",1,0],["يَمانِيَةٌ مِن أَهلِ فَوزٍ تَشُوقُني","وَتَأتي بِرَيّاها الرِياحُ الزَعازِعُ",28,"ع",1,0],["يمانِيّةٌ في نَجْرِها أزدِيّةٌ","أُفصّلُها نَظماً وأُحْكِمُها رَصْفا",29,"ف",2,0],["يُماطِلُ جَدٌّ أَخا حاجَةٍ","لَهُ أَجَلٌ بِالرَدى ناجِزُ",30,"ز",1,0],["يُماحِلُ في الدُنيا الخَؤَونِ وَإِنَّما","يُؤَمِّلُ نَزراً فانِياً بِمُحالِهِ",31,"ل",2,0],["يمارس شعري اليوم إصلاح أُمَّة","فَلِلَّه شعري اليوم ماذا يمارس",32,"س",1,0],["يَمَانِيَةٌ تَجْزِي الشَّمَالُ قُرُوضَهَا","أَفَانِينَ مِنْهَا هَاجَ هَجْراً مُؤْصَلا",33,"ل",2,0],["يَمَانِيَةٌ تَمْرِي الرَّبَابَ كَأَنَّهُ","رِئَالُ نَعَامٍ بَيْضُهُ قَدْ تَكَسَّرَا",34,"ر",2,0],["يَمانونَ أحياناً شَآمونَ تارةً","يُعالُونَ عن غَوْرِ العِراقِ لينْحَطّوا",35,"ط",3,0],["يَمانِيَةٌ صُهبٌ تُدَمّي أُنوفَها","أَزابِيُّ مِن مَرفوعِها المُتَقاذِفِ",36,"ف",1,0],["يُمَاصِعُهُ كُلٌّ يُشَجِّعُ قَوْمُهُ","وَمَا ضَرْبُهُ هَام العِدَا ليُشَجَّعَا",37,"ع",2,0],["يَمَانِيَة ٌ،تَجْزِي الشَّمَالُ قُرُوضَهَا","أَفانينَ منها هاجَ هَجْراً ومُؤْصَلا",38,"ل",2,0],["يمان محلّى فهو في السلم زينة","وتكشف عنف الموت في حدّة الحرب",39,"ب",1,0],["يماطلني إنْ رُمت إنجازَ وعده","بنفسي غزالٌ لا بقي بوعوده",40,"د",2,0],["يَمانِيَةٌ هَبَّت بِلَيلٍ فَأَرَّقَت","حُشَاشَةَ نَفسٍ قَد تَمَنَّى طَبِيبُهَا",41,"ه",2,1],["يمازج منك الدمع دمعي على الثرى","فيلهيك عن حلي عليك تناسقه",42,"ق",2,0],["يَمَانٍ كلاعِيٌّ نَماهُ إلى العُلَى","تَمامٌ حَواهُ قَبْلَ عَقْدِ التَّمائِمِ",43,"م",1,0],["يَمانُونَ في أيْمانِهِم مُلْتَقى العُلَى","سَماحٌ إذا قَرَّوا وَبَأسٌ إذا كَرُّوا",44,"ر",3,0],["يُماصِعُ عَن شِبلَيهِ في الغيلِ عابِساً","فَفي وَجهِهِ عِندَ اللِقاءِ كُلوحُ",45,"ح",1,0],["يمازجها رنين العود","ما بعدت من السحر",46,"ر",1,0],["يَمانِيَّةُ مَرّانُ شَبوَةَ دونَها","وَشَيخٌ شَآمٌ هَل يَمانٍ بِمُشئِمِ",47,"م",1,0],["يمانع الفكر عنها ما تقسمه","من كل حزن بطي الصدر مكنون",48,"ن",1,0],["يُماطِلني بِالشُكرِ عِندَ وُجوبِهِ","وَلَكِنَّهُ بِالعَبِ ظُلماً يُناجِزُ",49,"ز",1,0],["يُماطلُني ويوعِدُني مُحالاً","لأنِّي قلتُ في مَدحي مُحالا",50,"ل",2,0],["يَمانِيَّةَ لِلبَدرِ شُبِّهَ وَجهُها","وَلِلظَّبي مِنها مُقلَتاها وَجيدُها",51,"د",3,0],["يَمانِيَّةٌ يَنأى القَريبُ مَحَلَّةً","بِهِنَّ وَيَدنو الشاحِطُ المُتَباعِدُ",52,"د",1,0],["يماط عن الثياب وكان يكسو","غداة الروع سابغة الدؤادي",53,"د",2,0],["يماطل نومَه عن مقلتيه","تطلُّعُ نفسِهِ ضيفاً أتاها",54,"ا",3,0],["يماطلني عَنها المليُّ وقد درى","على غدره أن العهودَ ديونُ",55,"ن",1,0],["يماطلُ ثم يُنجزُ كلَّ دَيْنٍ","ولم ينجز بذي العلمين وعدي",56,"د",2,0],["يمانيَةٌ تلوذُ بذي رُعَيْنٍ","قبائلُها المنيعةُ والشعوب",57,"ب",1,0],["يماطلُ بالماءِ المُباحِ جِيادَه","وتنشرقُ من ماء النُّحور صواهلهْ",58,"ل",2,0],["يُماصع شُمساً من خطوبٍ وتمتري","بآماله أعقابُ مَرْوٍ وجَنْدَلِ",59,"ل",1,0],["يَمانِيَّةٌ أَمسَت بِنَجرانَ دارُها","وَأَنتَ عِراقِيٌّ هَواكَ نَزوحُ",60,"ح",1,0],["يَمانِيَةٌ شَطَّت فَأَصبَحَ نَفعُها","رَجاءً وَظنّاً بِالمَغيبِ مُرَجَّما",61,"م",2,0],["يمانِيَة أَقصى بِلاد تحلها","إِذا أَول الوَسمي جادَت أَوائِلُه",62,"ه",1,1],["يُمازِجُها حَياءٌ في وقارٍ","وأخلاقٌ يفاوِحُها العَبيرُ",63,"ر",1,0],["يُمازِجُهَا السَّاقِي فَيطفُو حُبَابُهَا","أيطفُو بسَطحِ الماءِ لُؤلُؤهُ الرَّطبُ",64,"ب",1,0],["يُمَالِئُ الأَعداءَ حتَّى رأَوْا","ما أَمَّلوُا في زمن الهضْمِ",65,"م",1,0],["يمازجُ هذا القلبَ حالٌ هي المُنى","يخالد هذا العقلَ شيءٌ هوَ السحرُ",66,"ر",1,0],["يَمانٍ وَفي قَيسٍ لَهُ مَدخَلٌ وَكَم","ظهور له في قَومِهِ وَبطونُ",67,"ن",1,0],["يماطلهم وهمُ واقفون","على بابه وقفة السائل",68,"ل",1,0],["يُمازِجُه سِحر البَيانِ قَدِ اِرتَقى","مَراتِبَ لَم تدرك عَلى القُربِ وَالبعدِ",69,"د",1,0],["يَمانِيَّةٍ تُذري الأَكُفَّ وَتارَةً","بِخَيلٍ عِتافٍ مُقرَباتٍ سَلاهِبِ",70,"ب",1,0],["يَمامَتِي كُلَّ فَجْرِ صَوْتُهَا غَرِدٌ","تَنُوحُ إلْفًا تَهاوَى في مَراثِينا",71,"ن",2,0],["يَمَانِيَّةٌ طَرْفاً بِدَلّ مُجَمَّلٍ","حجَازيَّةٌ لُطْفاً بحُسْن مُتَمَّمِ",72,"م",1,0],["يمانية هبَّت طُروقاً فزعزعت","فروعَ الغضا هزَّ القنا المتراجِف",73,"ف",1,0],["يمازج كأسَ الخمرِ لي برضابهِ","فَيعذُب لي في خلطه واِمتزاجهِ",74,"ج",2,0],["يَمَانِيَةٌ تَذُودُ النَّاسَ عَنهُ","وَتَخطِرُ فِى جَوَانِبهَا الفُحُولُ",75,"ل",1,0],["يُمَارِس الأَعْضالَ بِالتَمَلُّغِ","وَهوَ أَذلُّ الشائِلات الوزَّغِ",76,"غ",1,0],["يَمانِيَّةٌ أَلْفَتْكَ عَضْباً يَمانِياً","تُشارِكُها في مَجْدِها وتُلائِمُ",77,"م",1,0],["يمانيةً تخيّرها يمان","منمنمة البيوت مقطعات",78,"ت",1,0],["يمان في يدي ماض يمان","فلا نابي الغرار ولا كهام",79,"م",1,0],["يماسين أجراز الصحارى وتغتدى","بأجواز أخرى تعسف السهل والحزنا",80,"ن",2,0],["يَمانِيَّةٌ يَسري بِمِسكٍ إِذا سَرَت","نَسيمٌ لَها يَشفي مِنَ الداءِ طَيِّبُ",81,"ب",1,0],["يَمانِيَةُ مَحجُوبَةُ الشَخصِ مِثلُها","رَسِيسٌ بِها ما بَينَ جَنبَيَّ مَحجُوبُ",82,"ب",1,0],["يمازجُ ألفاظَ البلاغةِ صوتُه","فيبدي لنا دُرَّ