{"poems":[[85,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[45,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[49,"نغص الموت كل لذة عيش","https://www.aldiwan.net/poem63184.html","البسيط"],[74,"طاف الظلام به فأسرج أدهما","https://www.aldiwan.net/poem13248.html","الكامل"],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[187,"لا وحق التنزيل والتأويل","https://www.aldiwan.net/poem43463.html","الخفيف"],[329,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[459,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"]],"verses":[["ما آذنتك ولا مشى","في عارضيك بها النذير",0,"ر",1,0],["ما أَذكَرَتكَ بِمُترِحٍ صَرفِ الجَوى","إِلّا ثَنَتهُ بِمُفرِحٍ يُنسيكا",1,"ك",2,0],["ما أَذَلَّ المُقِلَّ في أَعيُنِ النا","سِ لِإِقلالِهِ وَما أَقماهُ",2,"ا",2,0],["ما أَذكَرَتني العَهدَ فيهِ أَيكَةٌ","إِلّا بَكَيتُ فَسالَ واديها دَما",3,"م",2,0],["ما أذلَّ الطيرَ الغريبَ عن الدَّو","ح وإن عاش في جنان الخلود!",4,"د",1,0],["ما أذم الزمان لكن أذم","م الناس من بين ظالم وبخيل",5,"ل",1,0],["ما أذلّ الحياةَ إن كان دنبي","هو زهدي في الجوهر المعبود",6,"د",1,0],["ما أذلَّ الخصبَ في دارِ الأذى","وألذَّ العزَّ في دار الجُدوبِ",7,"ب",1,0],["ما أذعنوا لك حتّى كنتَ فذَّهمُ","وللفضائلِ إنكارٌ وإذْعانُ",8,"ن",1,0]]}