{"poems":[[87,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[47,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[51,"نغص الموت كل لذة عيش","https://www.aldiwan.net/poem63184.html","البسيط"],[76,"طاف الظلام به فأسرج أدهما","https://www.aldiwan.net/poem13248.html","الكامل"],[108,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[190,"لا وحق التنزيل والتأويل","https://www.aldiwan.net/poem43463.html","الخفيف"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[556,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[1531,"","https://poetry.dctabudhabi.ae/diwan/poem/99866","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28522","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102544","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93272","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[4831,"ولادة حلم","https://www.poetsgate.com/ViewPoem.aspx?id=208009",""],[5055,"شوف ألماس","https://www.poetsgate.com/ViewPoem.aspx?id=103651",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5344,"شوف غيري ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180713",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5526,"كسرة نعاس","https://www.poetsgate.com/ViewPoem.aspx?id=192343",""],[5526,"نبراس","https://www.poetsgate.com/ViewPoem.aspx?id=192529",""],[5730,"بمن تفكر؟","https://www.poetsgate.com/ViewPoem.aspx?id=210351",""],[5817,"ياحب","https://www.poetsgate.com/ViewPoem.aspx?id=190756",""],[5937,"مآذِنٌ ناسِفة","https://www.poetsgate.com/ViewPoem.aspx?id=211826",""],[6113,"بحر جده","https://www.poetsgate.com/ViewPoem.aspx?id=26381",""],[6113,"الهايج والذلول......","https://www.poetsgate.com/ViewPoem.aspx?id=37153",""]],"verses":[["ما آذنتك ولا مشى","في عارضيك بها النذير",0,"ر",1,0],["ما أَذكَرَتكَ بِمُترِحٍ صَرفِ الجَوى","إِلّا ثَنَتهُ بِمُفرِحٍ يُنسيكا",1,"ك",2,0],["ما أَذَلَّ المُقِلَّ في أَعيُنِ النا","سِ لِإِقلالِهِ وَما أَقماهُ",2,"ا",2,0],["ما أَذكَرَتني العَهدَ فيهِ أَيكَةٌ","إِلّا بَكَيتُ فَسالَ واديها دَما",3,"م",2,0],["ما أذلَّ الطيرَ الغريبَ عن الدَّو","ح وإن عاش في جنان الخلود!",4,"د",1,0],["ما أذم الزمان لكن أذم","م الناس من بين ظالم وبخيل",5,"ل",1,0],["ما أذلّ الحياةَ إن كان دنبي","هو زهدي في الجوهر المعبود",6,"د",1,0],["ما أذلَّ الخصبَ في دارِ الأذى","وألذَّ العزَّ في دار الجُدوبِ",7,"ب",1,0],["ما أذعنوا لك حتّى كنتَ فذَّهمُ","وللفضائلِ إنكارٌ وإذْعانُ",8,"ن",1,0],["ما أذاب الفؤاد إلا احتراق","واشتياق يزيد قلبي اشتعالا",9,"ل",2,0],["ما أَذالَت مِن دَمعِها أُمُّ دَفرٍ","لا عَلى والِدٍ وَلا مَولودِ",10,"د",1,0],["ما أَذاعَت ريحُ الصَّبا لَكَ سِرّاً","إِنَّما عَرَّضَت بِهِ وَهيَ سَكرى",11,"ر",2,1],["ما آذنت إلا لقصد صالح أبداً","لقاصد جاء أو للأهل والجار",12,"ر",1,0],["ما أَذعنتْ لك في فؤادي طاعةٌ","إِلاّ وأَنتَ على القلوب أَمير",13,"ر",1,0],["ما أذهب الرجس المهي","من عنكمو وأزال ضيرا",14,"ر",2,0],["ما أذكر أنّي وَقَدْ هِمْتُ بِها","سَكرْتُ أو سُقِيْتُ شَيْئاً يُسكِرُ",15,"ر",1,0],["ما أذل الرأس من سيل العرقّ","والسنافي في مقانيصه يزوف",16,"ف",1,0],["مَأَاْذِنُنَاْ تُكَبِّرُ فِيْ حَيَآءٍ","مُؤَذِّنُهَاْ يَصِيْحُ أَيَاْ مُعِيْنَاْ",17,"ن",2,0],["ما أذكر اني بالمشاعر تسليت","وما سقت رجلي في دروب التغلِّي..",18,"ل",2,0],["ما آذنته بينها أسماء","فتقول ثاو مل منه ثواء",19,"ا",2,1],["مااذكر وش اللي ترتدينه من لباس","عطرك يدوّخ لابقٍ في يديني",20,"ن",2,0],["ما اذكر بأني ياعشيري تندمت","إلّا على ذيك الليالي الكئيبه",21,"ب",2,1],["ما أذّنَ الناس أن العيرَ آتيةٌ","إلا انتظرتُ قميص الحب في الأثر ِ",22,"ر",1,0],["ماإذ يأتي فيك الشوق","حتى للبعد يجدده",23,"د",2,0],["ما أَذَّنَتْ للشعر باسمك غيمةٌ","إلا وقامت للصلاةِ ، سنابِلُ",24,"ل",1,0],["مااذكراني في حياتي حرت اوجافيت نومي","لين جتني هالبنيه تحفرالجرح وتزيده",25,"د",2,0],["مااذكراني حرت وإلا قلت وين","لوتجي بقعاءلقيت لهاحلول",26,"ل",1,0]]}