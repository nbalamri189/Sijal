ِهِ ذِكراهُمُ نَهَضا",5,"ض",2,0],["ويَمْشينَ رَهْواً مِشْيَةً قُرَشيّةً","تَنوءُ بكُثْبانِ النّقا المُتَرَجْرِجِ",6,"ج",1,0],["ويمْرَحُ في ثِنْيِ العِذارِ كأنّهُ","تَسَرْبَلَ لَيلاً والثُّريّا لِجامُهُ",7,"م",2,0],["ويَمْتارُ نُعْمى لا تُغِبُّ ويجْتَلي","مُحيّا يَروقُ النّاظِرَ المتَوَسِّما",8,"م",2,0],["ويَمْتَرونَ سِجالَ العُرْفِ مُتْرَعَةً","هذي المَكارِمُ لا قَعْبانِ منْ لَبَنِ",9,"ن",1,0],["ويَمُدُّ ساعِدَهُ الطِّعانُ كما لَوَتْ","للفَحْلِ مِنْ طَرَفِ العَسيبِ الشّائِلُ",10,"ل",1,0],["وَيَمنَعَنا مِن كُلِّ ثَغرٍ نَخافُهُ","أَقَبُّ كَسَرحانِ الأَباءَةِ ضامِرُ",11,"ر",1,1],["ويَمينَكَ السّمْحاءَ مُسْتَلَمَ الوَرى","وحِماكَ مَبْرَكَ آنفٍ وجَباهِ",12,"ه",1,0],["وَيمَّمتُم خُلْدَ النَّعِيمِ فَإِنَّنِي","لأشْقَى فَيَا بُؤْسِي بِسُكَّانِ نَعْمَانِ",13,"ن",1,0],["وَيُمْطِرُ مِنْ وَدْقِ السِّهَامِ بِحَاصِبٍ","سَحَائِبُهُ مِنْ كُلِّ عَوْجَاءَ مِرْنَانِ",14,"ن",1,0],["ويمرضنا العفاف فكم عليل","وَمَا غَيْرُ الْهَوَى وَالْكَتْمُ عِلَّهْ",15,"ل",2,0],["وَيَمنَعُهُ يَومَ الصِياحِ مَصونَةٌ","سِراعٌ إِلى الداعي تَثوبُ وَتُركَبُ",16,"ب",1,0],["وَيَمنَعُ الحَقَّ أَن يُغشي تَبَلُّجَهُ","ما في السِياسَةِ مِن زورٍ وَمِن كَذِبِ",17,"ب",1,0],["وَيَمشي نَحوَ رايَتِهِ","فَتَحميهِ مِنَ العَطَبِ",18,"ب",1,0],["ويَمَّمَتْ حَضَرَةَ الهادي وقد مَلأَتْ","أنوارُ طَلعتِه أرجاءَ ناديها",19,"ي",3,0],["وَيَمِّنهُ وَاِنثُر مِن سُعودِكَ فَوقَهُ","وَتَوِّجهُ بِالبُشرى وَمُرهُ بِإِسفارِ",20,"ر",1,0],["وَيَمُرُّ مُعتَلُّ النَسيمِ بِرَوضِها","فَتَخالُ عَطّاراً يُحَرِّقُ مَندَلا",21,"ل",2,0],["وَيَمنَعُها بَنو شَمجى بنِ جَرمٍ","مَعيزَهُم حَنانَكَ ذا الحَنانِ",22,"ن",1,0],["وَيَمرُر عَلَيها فَرطُ عامَينِ قَد خَلَت","وَلِلَوَحشِ فيها مُستَرادٌ وَمَرتَعُ",23,"ع",1,0],["وَيَمْنَحُ جُلُّهُ رَكْبِي جَلاَلاً","يُرِينِي أَنَّ كُلَّ الخَلْقِ دُوِني",24,"ي",1,0],["ويَمْضِ فدِىً لأَرْوَعَ شِمَّرِيٍّ","مُحِيطٍ بِالْعُلُومِ وَبِالُفُنُونِ",24,"ن",1,0],["ويميّل إذي خطر","قصائد وازحال لابن زمرك",25,"ك",1,0],["ويُمسي الهند عندئذ طليقاً","من الأسر الذي قطع الوَتينا",26,"ن",2,0],["ويمسي الناس قاطبةً سواءً","بدين أُخُوةٍ متدينينا",26,"ن",2,0],["وَيَمضونَ أَرسالاً وَنَخلُفُ بَعدَهُم","كَما ضَمَّ أُخرى التالِياتِ المُشايِعُ",27,"ع",1,0],["وَيَمنَعُنا ظُلمُ العَشيرَةِ أَنَّنا","إِلى ضُرِّها لَو نَبتَغي ضُرِّها أَهدى",28,"د",2,0],["ويمناً على مصرٍ وشامٍ أفاضهُ","وزير زمانٍ ساعد السعد مبْعَثه",29,"ث",2,0],["ويمضي العيدُ في أكلٍ وشربٍ","وما لي في الشريحةِ منه ريحه",30,"ح",2,0],["ويممت مغناه بركب مدائح","يسيل بها غوْرٌ ويطفو بها نجد",31,"د",1,0],["ويمدحكم حسَّانها اليوم أو غدًا","بدار البقا بعد الطويل من العمر",32,"ر",1,0],["ويميل عني من يصدّ وأنني","قسماً إليه مع الصدود لأميل",33,"ل",1,0],["ويمنع الله بالراقي لرتبته","فقد تشابهت الأخلاق والشّيمُ",34,"م",1,0],["ويمّم هاتيك المناسم أروعٌ","تهمّ على أعطافه بسلام",35,"م",1,0],["ويمم الشام فأغصانه","أناملٌ نحو الهنا تومي",36,"م",2,0],["ويمنى لها في الحظ والجود والتقى","ملأت صفات لم تحد عن وليه",37,"ي",2,0],["ويميناً لألعبنَّ بأشلا","ئِك بين الإشْواء والإصْماءِ",38,"ا",2,0],["ويمينٍ كَعَطِّكَ البُرْدَ لا تنْ","ظر في سُقمها وفي الإبراءِ",39,"ا",2,0],["ويمنع منّي الماءَ واللَّوحُ جاهدٌ","ويُغرِقني والريُّ رَطْبُ المحَالِب",40,"ب",1,0],["ويُمسي النخل والشَّجراء منها","وجُلُّهما صريعٌ للجُنوبِ",41,"ب",1,0],["ويمنعنا الحَرَاكَ أشدَّ منعٍ","وإلا سامنا حَطْمَ الرقابِ",42,"ب",1,0],["ويُمن رأيٍ ورفقٍ لو مشى بهما","بين الأنيس وبين الجنَّة اصطلحا",43,"ح",2,0],["ويَميناً بكلِّ شأوٍ بَطينٍ","من مَسَاعيكَ لي وشَوْطٍ طَرُودِ",44,"د",1,0],["ويميناً إنك المرْءُ الذي","حُبُّهُ عندي سواءٌ والسُّجودُ",45,"د",1,0],["ويميناً لقد تَقَيَّلْتَ مَهْدِي","يَكَ ف أمْرِ قاسم ورشيدَكْ",46,"ك",1,0],["ويُمكنني عِرضُ الرميِّ فأرْعوي","وأُبقي ولو أمكنْتة لرمى عرضي",47,"ي",1,0],["ويمين الله لو أن يدي","ملكت تنكير نكر ما طرفْ",48,"ف",1,0],["ويُمسكهُ الحجا حتى تراه","وما في جانبٍ منه انثلامُ",49,"م",1,0],["ويملكني حيائي حين تُربي","على شكري دسائِعُك الضخامُ",49,"م",1,0],["ويميناً مَبْرورةً إنَّ نفساً","حَرَمَتْني الطفيفَ للمَحْرومه",50,"م",2,0],["ويمنعني وردَ الشرائع أهلُها","ويشرع غيري في السحاب فيرتوي",51,"ت",3,0],["وَيُمازِحُني وَيُداعِبُني","فَكَأَنِّيَ شَخصٌ يَعرُفُهُ",52,"ه",1,0],["وَيَمَّحي كُلُّ بُغضٍ غَيرُ بَغضِكُمُ","فَإِنَّهُ آمِنٌ مِن كُلِّ نُقصانِ",53,"ن",1,0],["وَيَمضي يَملَءُ الوادي ثَناءً","عَلَيكُم وَالأَباطِحَ وَالحُزونا",54,"ن",2,0],["وَيَميلُ بي نَحوَ الصِبا","قَلبٌ رَقيقُ الحاشِيَه",55,"ي",2,0],["وَيَمنَعُكُم مُستَنُّ كُلِّ سَحابَةٍ","مُصابَ الرَبيعِ يَترُكُ الماءَ ناقِعا",56,"ع",2,0],["ويُماشي النَّاسَ وما أَحَدٌ","مِنْهُمْ يَشْجِيهِ تَفَرُّدُهُ",57,"د",2,0],["ويمشي الزَّمانُ فتنمو صروفٌ","وتذوي صروفٌ وتحيا أُخَرْ",58,"ر",1,0],["ويمسى نور أحمد في","ظلام الجهل يهزمه",59,"م",2,0],["ويمضي على حال ويأتي بضدها","زمان ظروف كله وأمور",60,"ر",1,0],["ويميل من طربٍ إذا","ما مِلت يا غصن الأراك",61,"ك",1,0],["وَيُمطِرونَ فَما بِالأَرضِ مِن مَحَلٍ","وَلا بِمَن باتَ فَوقَ الأَرضِ مِن عُدُمِ",62,"م",1,0],["وَيَمشي الصَدرُ فيهِ كُلَّ يَومٍ","بِمَوكِبِهِ السَنِيِّ وَحارِسَيهِ",63,"ي",2,0],["وَيَمُرُّ رائِعُ صَمتِها","بِالحِسِّ كَالنُطقِ المُبين",64,"ن",1,0],["وَيُمطِرُنا مِن لَفظِهِ كُلَّ جامِدٍ","وَيُمطِرُنا مِن رَيلِهِ شَرَّ سائِلِ",65,"ل",1,0],["وَيَمشي بِهِ العُكّازُ في الدَيرِ تائِباً","وَما كانَ يَرضى مَشيَ أَشقَرَ أَجرَدا",66,"د",2,0],["وَيَمنَعُني مِمَّن سِوى اِبنِ مُحَمَّدٍ","أَيادٍ لَهُ عِندي تَضيقُ بِها عِندُ",67,"د",1,0],["وَيَمتَحِنُ الناسَ الأَميرُ بِرَأيِهِ","وَيُغضي عَلى عِلمٍ بِكُلِّ مُمَخرِقِ",68,"ق",1,0],["وَيَمنَعُ ثَغرَهُ مِن كُلِّ صَبٍّ","وَيَمنَحُهُ البَشامَةَ وَالأَراكا",69,"ك",2,0],["وَيُميتُ قَبلَ قِتالِهِ وَيَبَشُّ قَب","لَ نَوالِهِ وَيُنيلُ قَبلَ سُؤالِهِ",70,"ل",2,0],["وَيَموتُ الفَتى وَإِن كانَ حَيّاً","حينَ يَستَكمِلُ النَفادَ شَبابُه",71,"ب",2,0],["وَيُمنى بِحِضنى لِحيَةٍ مُدلَهِمَّةٍ","لِخَدَّيهِ مِنها الوَيلُ إِن ساقَها قَدرُ",72,"ر",1,0],["وَيَمانٍ إِن يُسَل لا يَعتَلِل","كَاليَماني العَضبِ إِن هُزَّ بَتَك",73,"ك",1,0],["وَيُمسِك مِن ذُراها بِالنَواصي","وَخَيرَ فَوارِسٍ عُلِموا نِصابا",74,"ب",2,0],["وَيَمنَعُها مِن أَن يَقولَ سَبِيَّةٌ","بَنونَ لَها مِن غَيرِ أُسرَتِها زُهرُ",75,"ر",1,0],["وَيَمنَعُ جاراً إِن أَناخَ فِناءَهُ","لَهُ مُستَقىً عِندَ اِبنِ مَروانَ غارِفِ",76,"ف",1,0],["وَيَمنَعُ مَولانا وَإِن كانَ نائِياً","بِنا جارَهُ مِمّا يَخافُ وَيَأنَفُ",77,"ف",1,0],["ويميل من لين الصبا","في حلتي صلف ودل",78,"ل",1,0],["ويُمناك تَبْعَثُ في سُرْعةٍ","رَسولاً بيُسراك يُستَقبلُ",79,"ل",1,0],["ويمزُجُ الكأسَ بعَذْبٍ ريقُه","حتى تبدَّى الصُّبحُ مُبيضَّ العَذَبْ",80,"ب",1,0],["وَيُمسي وَيُصبِحُ في نَفسِهِ","كَريمَ المَساعي عَظيمَ الخَطَر",81,"ر",1,0],["وَيُمرِضُني التَأَلُّمُ مِن جَفاكُم","فَلَم أَرَ عائِداً لي مِن زَفيري",82,"ي",1,0],["وَيَمزُجُ لي في الكَأسِ بِكراً قَديمَةً","تَخالُ خِباها مِن جَنى النَحلِ مُحدَثا",83,"ث",2,0],["ويميناً لا ترى أر","وعَ مِن هذا انتقاما",84,"م",2,0],["وَيَمنَعُها مِن أَنْ تَطيرَ لَطافَةً","حَبابٌ عَلَيها دائِراتٌ شَبائِكُه",85,"ك",2,0],["ويَمدُّ فَوْقَ البحرِ عِندَ عُبورِهِ","جسراً بهادٍ للسماءِ معانقِ",86,"ق",1,0],["ويمرقُ بي السبق في كلّ حلبةٍ","فتحسبهُ سهماً يطير به النزعُ",87,"ع",1,0],["ويمتحُ نَفْسَ القِرْنِ عاملُ رُمْحِهِ","كما يَمتَحُ الماءُ الرشاءُ من الجُدِّ",88,"د",1,0],["ويمينُ ابنِ تميمٍ عَلّمَتْ","صنعةَ المعروفِ أيْمانَ الشّحاح",89,"ح",1,0],["وَيَمنَعُهُ مِن أَن يَبيتَ زَماعُهُ","عَلى عَجَلٍ أَنَّ القَضاءَ عَلى رِسلِ",90,"ل",1,0],["وَيَمتَحُ سَجلاً لَها كَالسِجالِ","وَدَلواً إِذا أُفرِغَت كَالدِلاءِ",91,"ا",2,0],["وَيَمَّمَت سَفَوان الخَيلُ سابِحَةً","بِكُلِّ مُعتَزِمٍ لِلقَرنِ مُلتَزِمِ",92,"م",1,0],["وَيَمَّمَ المُصطَفى بَدراً فَلاحَ لَهُ","بَدرٌ مِنَ النَّصرِ جَلَّى ظُلمَةَ الوَخَمِ",92,"م",1,0],["وَيَمَّمَ الطّائِفَ الغَنّاءَ ثُمَّ مَضى","عَنها إلى أَجَلٍ في الغَيبِ مُكتَتَمِ",92,"م",1,0],["وَيَمَّمَ اِبنُ أُنَيسٍ عُرضَ نَخلَةَ إِذ","طَغا اِبنُ ثَورٍ فَاصماهُ وَلَم يَخِمِ",92,"م",1,0],["وَيَميني بِمَثلِ ذَلِكَ أَنّي","لا أُصافي سِواكِ في العالَمينا",93,"ن",2,0],["وَيَمنَعُ سِربَنا في الحَربِ شُمٌّ","مَصاليتٌ مَساعِرُ لِلحُروبِ",94,"ب",1,0],["وَيَملَأُ رُعباً صُدورَ العِدى","فَيُرعِفُ بَأساً أُنوفَ الأَسَل",95,"ل",1,0],["وَيمْشِي يَجعلُ الأشلاءَ جِسراً","لِيَبْلُغَ مِن بني الدّنيا مَراما",96,"م",2,0],["ويُمنَعُ ذو القضاءِ الحقِّ منا","ويَقضي كلُّ أزورَ ذي نكوبِ",97,"ب",1,0],["وَيَمنَعُني الَّذي تَبغينَ نَفسٌ","تَهونُ الحادِثاتُ وَلا تَهونُ",98,"ن",1,0],["وَيُمسي مُلكُهُ في زِيِّ ثَكلى","كَساها فقدُ واحدِها الحِدادا",99,"د",2,0],["وَيَمشِ أَخو الوَغى مِنّا وَمِنهُم","عَلى جُثَثٍ مُطرَّحةٍ وَهامِ",100,"م",1,0],["ويَمنعُ مُهجتي ويصونُ ديني","وصارِمَه تَلَّقى باليمينِ",101,"ن",1,0],["ويَمُدُّ فوق المؤمناتِ جَناحَهُ","يقضِي لهنَّ الحقَّ من إعظامِهِ",102,"م",2,0],["ويملْنَ والأَغصانَ ما","خَطَرَ النسيمُ بروضهنَّه",103,"ن",2,0],["وَيَمنَعُهُ أَن يَطمَئِنَّ بِأَنَّهُ","تَذَكَرَ جُلّاً فَازدهاهُ وَمِقوَدا",104,"د",2,0],["وَيُمسي الغُرابُ الأَعوَرُ العَينِ واقِعاً","مَعَ الذِئبِ يَعتَسّانِ ناري وَمِفأَدي",105,"د",2,0],["وَيَمنَعُها مِن أَن تُضامَ فَوارِسٌ","كِرامٌ إِذا الأُخرى مِنَ القَومِ شُلَّتِ",106,"ت",1,0],["وَيُمَدُّ الزِمامُ مِنهُ بِجِزعٍ","مِثلَ ما مُدَّ حَيَّةٌ مَطوِيُّ",107,"ي",1,0],["وَيُمناكَ مُفتاحِ الفُتوحِ وَما حَنَت","عَلى قَلَمٍ إِلّا لِكَشفِ هُمومِ",108,"م",1,0],["وَيُمطِرُنا السَقفُ مِن بَينِنا","وَمِن تَحتِنا أَعيُنٌ تَنبُعُ",109,"ع",1,0],["وَيَمْلِكُنِي خُلْقٌ عَلَى السُّخْطِ والرِّضا","جَمِيلٌ كمِثْلِ البُرْدِ يُطْوَى ويُنْشَرُ",110,"ر",1,0],["ويَمَسُّهُ الألَمُ الَّذِي لَمْ يَسْتَطِع","صَرْفَاً لَهُ عنهُ ولا تَحْوِيلا",111,"ل",2,0],["ويممت في طرق الجهاد سبيلهم","لأصلى كما يصلون لفح السمائم",112,"م",1,0],["ويمّمَهُمْ مَنْ لا يَغيرُ بنعْمَةٍ","فَيَسْلُبَهُمْ لكن يزيدُ فيُوسِع",113,"ع",1,0],["ويُميلُ قِمّتَهُ النُّعاسُ كأنّهُ","في أُخرَياتِ اللّيل ذِفرَى أوقَص",114,"ص",1,0],["ويمشي في الجماشةِ قيدَ شبر","كمشية مذنب فوق الصراطِ",115,"ط",1,0],["وَيَموتُ راعي الضَأنِ عِندَ ثُمامِهِ","مَوتَ الطَبيبِ الفَيلَسوفِ العالِمِ",116,"م",1,0],["وَيُمارِسونَ مِنَ الظَلامِ غَياهِباً","وَيُواصِلونَ فَيَقطَعونَ السَبسَبا",117,"ب",2,0],["وَيَمرَحُ الإِنسانُ مِن جَهلِهِ","وَهُوَ أَسيرٌ في رِباطٍ وَقِدّ",118,"د",1,0],["وَيممت دار الملك أَحسب أَنَّني","إذا كنت فيها نازِلاً أتمتع",119,"ع",1,0],["ويمنعني ممن سوى ابن محمدٍ","أيادٍ له عندي يضيق بها عند",120,"د",1,0],["ويمرُّ بالأحداثِ مبتسماً","كالشمسِ حينَ يلفُّها الغيمُ",121,"م",1,0],["ويمضي إلى الهيجاءِ غرثانَ صادياً","فلِلَّهِ دنيا ذلكَ الساغبِ الصَّدي",122,"د",2,0],["ويَمَّمنا بجوفِ الصَّخرِ","دهليزاً مِنَ التِّبرِ",123,"ر",1,0],["وَيَمْتَنِعُونَ بِكُلِّ خَفِيٍّ","عَصِيٍّ عَلَى أَمْهَرِ الرُّوَّدِ",124,"د",1,0],["وَيَمِيدُ ظَهْرُ الأَرْضِ تَحْتَ رِكَابِهِ","وَرِكَابُهُ فِي المَتْنِ لاَ تَتَنَكَّبُ",125,"ب",1,0],["وَيَمَّمْنَ قصْداً وَاحداً فَمَنَحْنَهُ","مَهَابَةَ مِحْرَابٍ وَحُرْمَةَ مَقْدِسِ",126,"س",1,0],["وَيَمُرُّ بِالْعَيْشِ الكَرِي","مِ وَمَا لَهُ مِنْهُ نَصِيبُ",127,"ب",1,0],["ويميس البان في ضفاتها","أترى طاف به الساقي بكأس",128,"س",1,0],["ويمج أحياناً دماً. فعلى","منديله قطع من الكبد",129,"د",1,0],["ويمشي القَمْل والدي دي رَصيدٌ","يُصوِّبُ خلفه السهمَ الأسدّا",130,"د",2,0],["ويَمْضِي الْحِجَا مَا بَيْنَ يومٍ وليلةٍ","كَلَمْحَةِ طَرْفٍ أَو كَوَمْضَةِ مُبْرِق",131,"ق",1,0],["ويمينًا بضةً ناعمة","خُلقت للجدِّ، لا للعب",132,"ب",1,0],["ويُمدُّ وجداني تأَلُّقَ شمسه","بحرارةٍ تَنسَاب في أشعاري",133,"ر",2,0],["ويَمْنَعُها مِنْ أنْ تُضَامَ فوارسٌ","كرامٌ إذ الأخرى من الرَّوعِ شلَّتِ",134,"ت",1,0],["ويمرقُ بي في السبق في كلّ حلبة","ٍ فتحسبهُ سهماً يطيرُ به النزع",135,"ع",1,0],["ويمضي يملأ الوادي ثناء","عليكم ، والأباطح والحزونا",136,"ن",2,0],["ويمنحني ثَغْرُها مَوْعِدَا","فيخضرُّ في شفتيها الصَدَى",137,"د",2,1],["ويمنعني وردَ الشرائع أهلُها","ويسرع غيري في السحاب فيرتوي",138,"ت",3,0],["ويميناً لقد تَقَبَّلْتَ مَهْدِيّ","كَ في أمْرِ قاسمٍ ورشيدَكْ",139,"ك",1,0],["ويمر في الذكرى خيالُ شباَبها","فكأن يقظَتها شبابٌ ثاني",140,"ن",2,0],["ويمشي إن أريد له المشاءُ","هُمُ المتضمِّنون على المنايا",141,"ا",1,0]]}