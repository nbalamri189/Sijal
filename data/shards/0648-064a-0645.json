يكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[549,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[556,"يا من به تتكون الأكوان","https://www.aldiwan.net/poem33779.html","الكامل"],[556,"نحن أهل العلوم بالإلهام","https://www.aldiwan.net/poem33878.html","الخفيف"],[560,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[565,"هنيئا لأصحاب السيوف بطالة","https://www.aldiwan.net/poem69507.html","الطويل"],[565,"أنا أفدي التي تغدو","https://www.aldiwan.net/poem69590.html","مجزوء الوافر"],[573,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[573,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"],[573,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[573,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[584,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["وَيَمنَعُني مِن عادَةِ الشِعرِ أَنَّني","رَأَيتُ لِباسَ الذُلِّ بِالمالِ غالِيا",0,"ي",2,0],["وَيَمنَعُني المُدامَ طَروقُ هَمّي","فَما يَحظى بِها إِلّا نَديمي",1,"م",2,0],["وَيَمشُقُ بِالعَوالي في الهَوادي","وَطُرسُ اليَومِ مُختَلِطُ السُطورِ",2,"ر",1,0],["وَيَمنَعُني العَفافُ كَأَنَّ بَيني","وَبَينَ مَآرِبي مِنهُ هِضابا",3,"ب",2,0],["وَيَملأُ سَمعي مِن حَديثٍ بِمِثلِهِ","عَلى النَّحرِ مِنهُ نظَّمَ العِقدَ ناسِقُهْ",4,"ق",2,0],["وَيَمتَري دَمعَهُ ذِكرى أُصَيْبِيَةٍ","إِذا اِستَمَرَّت بِهِ ذِكراهُمُ نَهَضا",5,"ض",2,0],["ويَمْشينَ رَهْواً مِشْيَةً قُرَشيّةً","تَنوءُ بكُثْبانِ النّقا المُتَرَجْرِجِ",6,"ج",1,0],["ويمْرَحُ في ثِنْيِ العِذارِ كأنّهُ","تَسَرْبَلَ لَيلاً والثُّريّا لِجامُهُ",7,"م",2,0],["ويَمْتارُ نُعْمى لا تُغِبُّ ويجْتَلي","مُحيّا يَروقُ النّاظِرَ المتَوَسِّما",8,"م",2,0],["ويَمْتَرونَ سِجالَ العُرْفِ مُتْرَعَةً","هذي المَكارِمُ لا قَعْبانِ منْ لَبَنِ",9,"ن",1,0],["ويَمُدُّ ساعِدَهُ الطِّعانُ كما لَوَتْ","للفَحْلِ مِنْ طَرَفِ العَسيبِ الشّائِلُ",10,"ل",1,0],["وَيَمنَعَنا مِن كُلِّ ثَغرٍ نَخافُهُ","أَقَبُّ كَسَرحانِ الأَباءَةِ ضامِرُ",11,"ر",1,1],["ويَمينَكَ السّمْحاءَ مُسْتَلَمَ الوَرى","وحِماكَ مَبْرَكَ آنفٍ وجَباهِ",12,"ه",1,0],["وَيمَّمتُم خُلْدَ النَّعِيمِ فَإِنَّنِي","لأشْقَى فَيَا بُؤْسِي بِسُكَّانِ نَعْمَانِ",13,"ن",1,0],["وَيُمْطِرُ مِنْ وَدْقِ السِّهَامِ بِحَاصِبٍ","سَحَائِبُهُ مِنْ كُلِّ عَوْجَاءَ مِرْنَانِ",14,"ن",1,0],["ويمرضنا العفاف فكم عليل","وَمَا غَيْرُ الْهَوَى وَالْكَتْمُ عِلَّهْ",15,"ل",2,0],["وَيَمنَعُهُ يَومَ الصِياحِ مَصونَةٌ","سِراعٌ إِلى الداعي تَثوبُ وَتُركَبُ",16,"ب",1,0],["وَيَمنَعُ الحَقَّ أَن يُغشي تَبَلُّجَهُ","ما في السِياسَةِ مِن زورٍ وَمِن كَذِبِ",17,"ب",1,0],["وَيَمشي نَحوَ رايَتِهِ","فَتَحميهِ مِنَ العَطَبِ",18,"ب",1,0],["ويَمَّمَتْ حَضَرَةَ الهادي وقد مَلأَتْ","أنوارُ طَلعتِه أرجاءَ ناديها",19,"ي",3,0],["وَيَمِّنهُ وَاِنثُر مِن سُعودِكَ فَوقَهُ","وَتَوِّجهُ بِالبُشرى وَمُرهُ بِإِسفارِ",20,"ر",1,0],["وَيَمُرُّ مُعتَلُّ النَسيمِ بِرَوضِها","فَتَخالُ عَطّاراً يُحَرِّقُ مَندَلا",21,"ل",2,0],["وَيَمنَعُها بَنو شَمجى بنِ جَرمٍ","مَعيزَهُم حَنانَكَ ذا الحَنانِ",22,"ن",1,0],["وَيَمرُر عَلَيها فَرطُ عامَينِ قَد خَلَت","وَلِلَوَحشِ فيها مُستَرادٌ وَمَرتَعُ",23,"ع",1,0],["وَيَمْنَحُ جُلُّهُ رَكْبِي جَلاَلاً","يُرِينِي أَنَّ كُلَّ الخَلْقِ دُوِني",24,"ي",1,0],["ويَمْضِ فدِىً لأَرْوَعَ شِمَّرِيٍّ","مُحِيطٍ بِالْعُلُومِ وَبِالُفُنُونِ",24,"ن",1,0],["ويميّل إذي خطر","قصائد وازحال لابن زمرك",25,"ك",1,0],["ويُمسي الهند عندئذ طليقاً","من الأسر الذي قطع الوَتينا",26,"ن",2,0],["ويمسي الناس قاطبةً سواءً","بدين أُخُوةٍ متدينينا",26,"ن",2,0],["وَيَمضونَ أَرسالاً وَنَخلُفُ بَعدَهُم","كَما ضَمَّ أُخرى التالِياتِ المُشايِعُ",27,"ع",1,0],["وَيَمنَعُنا ظُلمُ العَشيرَةِ أَنَّنا","إِلى ضُرِّها لَو نَبتَغي ضُرِّها أَهدى",28,"د",2,0],["ويمناً على مصرٍ وشامٍ أفاضهُ","وزير زمانٍ ساعد السعد مبْعَثه",29,"ث",2,0],["ويمضي العيدُ في أكلٍ وشربٍ","وما لي في الشريحةِ منه ريحه",30,"ح",2,0],["ويممت مغناه بركب مدائح","يسيل بها غوْرٌ ويطفو بها نجد",31,"د",1,0],["ويمدحكم حسَّانها اليوم أو غدًا","بدار البقا بعد الطويل من العمر",32,"ر",1,0],["ويميل عني من يصدّ وأنني","قسماً إليه مع الصدود لأميل",33,"ل",1,0],["ويمنع الله بالراقي لرتبته","فقد تشابهت الأخلاق والشّيمُ",34,"م",1,0],["ويمّم هاتيك المناسم أروعٌ","تهمّ على أعطافه بسلام",35,"م",1,0],["ويمم الشام فأغصانه","أناملٌ نحو الهنا تومي",36,"م",2,0],["ويمنى لها في الحظ والجود والتقى","ملأت صفات لم تحد عن وليه",37,"ي",2,0],["ويميناً لألعبنَّ بأشلا","ئِك بين الإشْواء والإصْماءِ",38,"ا",2,0],["ويمينٍ كَعَطِّكَ البُرْدَ لا تنْ","ظر في سُقمها وفي الإبراءِ",39,"ا",2,0],["ويمنع منّي الماءَ واللَّوحُ جاهدٌ","ويُغرِقني والريُّ رَطْبُ المحَالِب",40,"ب",1,0],["ويُمسي النخل والشَّجراء منها","وجُلُّهما صريعٌ للجُنوبِ",41,"ب",1,0],["ويمنعنا الحَرَاكَ أشدَّ منعٍ","وإلا سامنا حَطْمَ الرقابِ",42,"ب",1,0],["ويُمن رأيٍ ورفقٍ لو مشى بهما","بين الأنيس وبين الجنَّة اصطلحا",43,"ح",2,0],["ويَميناً بكلِّ شأوٍ بَطينٍ","من مَسَاعيكَ لي وشَوْطٍ طَرُودِ",44,"د",1,0],["ويميناً إنك المرْءُ الذي","حُبُّهُ عندي سواءٌ والسُّجودُ",45,"د",1,0],["ويميناً لقد تَقَيَّلْتَ مَهْدِي","يَكَ ف أمْرِ قاسم ورشيدَكْ",46,"ك",1,0],["ويُمكنني عِرضُ الرميِّ فأرْعوي","وأُبقي ولو أمكنْتة لرمى عرضي",47,"ي",1,0],["ويمين الله لو أن يدي","ملكت تنكير نكر ما طرفْ",48,"ف",1,0],["ويُمسكهُ الحجا حتى تراه","وما في جانبٍ منه انثلامُ",49,"م",1,0],["ويملكني حيائي حين تُربي","على شكري دسائِعُك الضخامُ",49,"م",1,0],["ويميناً مَبْرورةً إنَّ نفساً","حَرَمَتْني الطفيفَ للمَحْرومه",50,"م",2,0],["ويمنعني وردَ الشرائع أهلُها","ويشرع غيري في السحاب فيرتوي",51,"ت",3,0],["وَيُمازِحُني وَيُداعِبُني","فَكَأَنِّيَ شَخصٌ يَعرُفُهُ",52,"ه",1,0],["وَيَمَّحي كُلُّ بُغضٍ غَيرُ بَغضِكُمُ","فَإِنَّهُ آمِنٌ مِن كُلِّ نُقصانِ",53,"ن",1,0],["وَيَمضي يَملَءُ الوادي ثَناءً","عَلَيكُم وَالأَباطِحَ وَالحُزونا",54,"ن",2,0],["وَيَميلُ بي نَحوَ الصِبا","قَلبٌ رَقيقُ الحاشِيَه",55,"ي",2,0],["وَيَمنَعُكُم مُستَنُّ كُلِّ سَحابَةٍ","مُصابَ الرَبيعِ يَترُكُ الماءَ ناقِعا",56,"ع",2,0],["ويُماشي النَّاسَ وما أَحَدٌ","مِنْهُمْ يَشْجِيهِ تَفَرُّدُهُ",57,"د",2,0],["ويمشي الزَّمانُ فتنمو صروفٌ","وتذوي صروفٌ وتحيا أُخَرْ",58,"ر",1,0],["ويمسى نور أحمد في","ظلام الجهل يهزمه",59,"م",2,0],["ويمضي على حال ويأتي بضدها","زمان ظروف كله وأمور",60,"ر",1,0],["ويميل من طربٍ إذا","ما مِلت يا غصن الأراك",61,"ك",1,0],["وَيُمطِرونَ فَما بِالأَرضِ مِن مَحَلٍ","وَلا بِمَن باتَ فَوقَ الأَرضِ مِن عُدُمِ",62,"م",1,0],["وَيَمشي الصَدرُ فيهِ كُلَّ يَومٍ","بِمَوكِبِهِ السَنِيِّ وَحارِسَيهِ",63,"ي",2,0],["وَيَمُرُّ رائِعُ صَمتِها","بِالحِسِّ كَالنُطقِ المُبين",64,"ن",1,0],["وَيُمطِرُنا مِن لَفظِهِ كُلَّ جامِدٍ","وَيُمطِرُنا مِن رَيلِهِ شَرَّ سائِلِ",65,"ل",1,0],["وَيَمشي بِهِ العُكّازُ في الدَيرِ تائِباً","وَما كانَ يَرضى مَشيَ أَشقَرَ أَجرَدا",66,"د",2,0],["وَيَمنَعُني مِمَّن سِوى اِبنِ مُحَمَّدٍ","أَيادٍ لَهُ عِندي تَضيقُ بِها عِندُ",67,"د",1,0],["وَيَمتَحِنُ الناسَ الأَميرُ بِرَأيِهِ","وَيُغضي عَلى عِلمٍ بِكُلِّ مُمَخرِقِ",68,"ق",1,0],["وَيَمنَعُ ثَغرَهُ مِن كُلِّ صَبٍّ","وَيَمنَحُهُ البَشامَةَ وَالأَراكا",69,"ك",2,0],["وَيُميتُ قَبلَ قِتالِهِ وَيَبَشُّ قَب","لَ نَوالِهِ وَيُنيلُ قَبلَ سُؤالِهِ",70,"ل",2,0],["وَيَموتُ الفَتى وَإِن كانَ حَيّاً","حينَ يَستَكمِلُ النَفادَ شَبابُه",71,"ب",2,0],["وَيُمنى بِحِضنى لِحيَةٍ مُدلَهِمَّةٍ","لِخَدَّيهِ مِنها الوَيلُ إِن ساقَها قَدرُ",72,"ر",1,0],["وَيَمانٍ إِن يُسَل لا يَعتَلِل","كَاليَماني العَضبِ إِن هُزَّ بَتَك",73,"ك",1,0],["وَيُمسِك مِن ذُراها بِالنَواصي","وَخَيرَ فَوارِسٍ عُلِموا نِصابا",74,"ب",2,0],["وَيَمنَعُها مِن أَن يَقولَ سَبِيَّةٌ","بَنونَ لَها مِن غَيرِ أُسرَتِها زُهرُ",75,"ر",1,0],["وَيَمنَعُ جاراً إِن أَناخَ فِناءَهُ","لَهُ مُستَقىً عِندَ اِبنِ مَروانَ غارِفِ",76,"ف",1,0],["وَيَمنَعُ مَولانا وَإِن كانَ نائِياً","بِنا جارَهُ مِمّا يَخافُ وَيَأنَفُ",77,"ف",1,0],["ويميل من لين الصبا","في حلتي صلف ودل",78,"ل",1,0],["ويُمناك تَبْعَثُ في سُرْعةٍ","رَسولاً بيُسراك يُستَقبلُ",79,"ل",1,0],["ويمزُجُ الكأسَ بعَذْبٍ ريقُه","حتى تبدَّى الصُّبحُ مُبيضَّ العَذَبْ",80,"ب",1,0],["وَيُمسي وَيُصبِحُ في نَفسِهِ","كَريمَ المَساعي عَظيمَ الخَطَر",81,"ر",1,0],["وَيُمرِضُني التَأَلُّمُ مِن جَفاكُم","فَلَم أَرَ عائِداً لي مِن زَفيري",82,"ي",1,0],["وَيَمزُجُ لي في الكَأسِ بِكراً قَديمَةً","تَخالُ خِباها مِن جَنى النَحلِ مُحدَثا",83,"ث",2,0],["ويميناً لا ترى أر","وعَ مِن هذا انتقاما",84,"م",2,0],["وَيَمنَعُها مِن أَنْ تَطيرَ لَطافَةً","حَبابٌ عَلَيها دائِراتٌ شَبائِكُه",85,"ك",2,0],["ويَمدُّ فَوْقَ البحرِ عِندَ عُبورِهِ","جسراً بهادٍ للسماءِ معانقِ",86,"ق",1,0],["ويمرقُ بي السبق في كلّ حلبةٍ","فتحسبهُ سهماً يطير به النزعُ",87,"ع",1,0],["ويمتحُ نَفْسَ القِرْنِ عاملُ رُمْحِهِ","كما يَمتَحُ الماءُ الرشاءُ من الجُدِّ",88,"د",1,0],["ويمينُ ابنِ تميمٍ عَلّمَتْ","صنعةَ المعروفِ أيْمانَ الشّحاح",89,"ح",1,0],["وَيَمنَعُهُ مِن أَن يَبيتَ زَماعُهُ","عَلى عَجَلٍ أَنَّ القَضاءَ عَلى رِسلِ",90,"ل",1,0],["وَيَمتَحُ سَجلاً لَها كَالسِجالِ","وَدَلواً إِذا أُفرِغَت كَالدِلاءِ",91,"ا",2,0],["وَيَمَّمَت سَفَوان الخَيلُ سابِحَةً","بِكُلِّ مُعتَزِمٍ لِلقَرنِ مُلتَزِمِ",92,"م",1,0],["وَيَمَّمَ المُصطَفى بَدراً فَلاحَ لَهُ","بَدرٌ مِنَ النَّصرِ جَلَّى ظُلمَةَ الوَخَمِ",92,"م",1,0],["وَيَمَّمَ الطّائِفَ الغَنّاءَ ثُمَّ مَضى","عَنها إلى أَجَلٍ في الغَيبِ مُكتَتَمِ",92,"م",1,0],["وَيَمَّمَ اِبنُ أُنَيسٍ عُرضَ نَخلَةَ إِذ","طَغا اِبنُ ثَورٍ فَاصماهُ وَلَم يَخِمِ",92,"م",1,0],["وَيَميني بِمَثلِ ذَلِكَ أَنّي","لا أُصافي سِواكِ في العالَمينا",93,"ن",2,0],["وَيَمنَعُ سِربَنا في الحَربِ شُمٌّ","مَصاليتٌ مَساعِرُ لِلحُروبِ",94,"ب",1,0],["وَيَملَأُ رُعباً صُدورَ العِدى","فَيُرعِفُ بَأساً أُنوفَ الأَسَل",95,"ل",1,0],["وَيمْشِي يَجعلُ الأشلاءَ جِسراً","لِيَبْلُغَ مِن بني الدّنيا مَراما",96,"م",2,0],["ويُمنَعُ ذو القضاءِ الحقِّ منا","ويَقضي كلُّ أزورَ ذي نكوبِ",97,"ب",1,0],["وَيَمنَعُني الَّذي تَبغينَ نَفسٌ","تَهونُ الحادِثاتُ وَلا تَهونُ",98,"ن",1,0],["وَيُمسي مُلكُهُ في زِيِّ ثَكلى","كَساها فقدُ واحدِها الحِدادا",99,"د",2,0],["وَيَمشِ أَخو الوَغى مِنّا وَمِنهُم","عَلى جُثَثٍ مُطرَّحةٍ وَهامِ",100,"م",1,0],["ويَمنعُ مُهجتي ويصونُ ديني","وصارِمَه تَلَّقى باليمينِ",101,"ن",1,0],["ويَمُدُّ فوق المؤمناتِ جَناحَهُ","يقضِي لهنَّ الحقَّ من إعظامِهِ",102,"م",2,0],["ويملْنَ والأَغصانَ ما","خَطَرَ النسيمُ بروضهنَّه",103,"ن",2,0],["وَيَمنَعُهُ أَن يَطمَئِنَّ بِأَنَّهُ","تَذَكَرَ جُلّاً فَازدهاهُ وَمِقوَدا",104,"د",2,0],["وَيُمسي الغُرابُ الأَعوَرُ العَينِ واقِعاً","مَعَ الذِئبِ يَعتَسّانِ ناري وَمِفأَدي",105,"د",2,0],["وَيَمنَعُها مِن أَن تُضامَ فَوارِسٌ","كِرامٌ إِذا الأُخرى مِنَ القَومِ شُلَّتِ",106,"ت",1,0],["وَيُمَدُّ الزِمامُ مِنهُ بِجِزعٍ","مِثلَ ما مُدَّ حَيَّةٌ مَطوِيُّ",107,"ي",1,0],["وَيُمناكَ مُفتاحِ الفُتوحِ وَما حَنَت","عَلى قَلَمٍ إِلّا لِكَشفِ هُمومِ",108,"م",1,0],["وَيُمطِرُنا السَقفُ مِن بَينِنا","وَمِن تَحتِنا أَعيُنٌ تَنبُعُ",109,"ع",1,0],["وَيَمْلِكُنِي خُلْقٌ عَلَى السُّخْطِ والرِّضا","جَمِيلٌ كمِثْلِ البُرْدِ يُطْوَى ويُنْشَرُ",110,"ر",1,0],["ويَمَسُّهُ الألَمُ الَّذِي لَمْ يَسْتَطِع","صَرْفَاً لَهُ عنهُ ولا تَحْوِيلا",111,"ل",2,0],["ويممت في طرق الجهاد سبيلهم","لأصلى كما يصلون لفح السمائم",112,"م",1,0],["ويمّمَهُمْ مَنْ لا يَغيرُ بنعْمَةٍ","فَيَسْلُبَهُمْ لكن يزيدُ فيُوسِع",113,"ع",1,0],["ويُميلُ قِمّتَهُ النُّعاسُ كأنّهُ","في أُخرَياتِ اللّيل ذِفرَى أوقَص",114,"ص",1,0],["ويمشي في الجماشةِ قيدَ شبر","كمشية مذنب فوق الصراطِ",115,"ط",1,0],["وَيَموتُ راعي الضَأنِ عِندَ ثُمامِهِ","مَوتَ الطَبيبِ الفَيلَسوفِ العالِمِ",116,"م",1,0],["وَيُمارِسونَ مِنَ الظَلامِ غَياهِباً","وَيُواصِلونَ فَيَقطَعونَ السَبسَبا",117,"ب",2,0],["وَيَمرَحُ الإِنسانُ مِن جَهلِهِ","وَهُوَ أَسيرٌ في رِباطٍ وَقِدّ",118,"د",1,0],["وَيممت دار الملك أَحسب أَنَّني","إذا كنت فيها نازِلاً أتمتع",119,"ع",1,0],["ويمنعني ممن سوى ابن محمدٍ","أيادٍ له عندي يضيق بها عند",120,"د",1,0],["ويمرُّ بالأحداثِ مبتسماً","كالشمسِ حينَ يلفُّها الغيمُ",121,"م",1,0],["ويمضي إلى الهيجاءِ غرثانَ صادياً","فلِلَّهِ دنيا ذلكَ الساغبِ الصَّدي",122,"د",2,0],["ويَمَّمنا بجوفِ الصَّخرِ","دهليزاً مِنَ التِّبرِ",123,"ر",1,0],["وَيَمْتَنِعُونَ بِكُلِّ خَفِيٍّ","عَصِيٍّ عَلَى أَمْهَرِ الرُّوَّدِ",124,"د",1,0],["وَيَمِيدُ ظَهْرُ الأَرْضِ تَحْتَ رِكَابِهِ","وَرِكَابُهُ فِي المَتْنِ لاَ تَتَنَكَّبُ",125,"ب",1,0],["وَيَمَّمْنَ قصْداً وَاحداً فَمَنَحْنَهُ","مَهَابَةَ مِحْرَابٍ وَحُرْمَةَ مَقْدِسِ",126,"س",1,0],["وَيَمُرُّ بِالْعَيْشِ الكَرِي","مِ وَمَا لَهُ مِنْهُ نَصِيبُ",127,"ب",1,0],["ويميس البان في ضفاتها","أترى طاف به الساقي بكأس",128,"س",1,0],["ويمج أحياناً دماً. فعلى","منديله قطع من الكبد",129,"د",1,0],["ويمشي القَمْل والدي دي رَصيدٌ","يُصوِّبُ خلفه السهمَ الأسدّا",130,"د",2,0],["ويَمْضِي الْحِجَا مَا بَيْنَ يومٍ وليلةٍ","كَلَمْحَةِ طَرْفٍ أَو كَوَمْضَةِ مُبْرِق",131,"ق",1,0],["ويمينًا بضةً ناعمة","خُلقت للجدِّ، لا للعب",132,"ب",1,0],["ويُمدُّ وجداني تأَلُّقَ شمسه","بحرارةٍ تَنسَاب في أشعاري",133,"ر",2,0],["ويَمْنَعُها مِنْ أنْ تُضَامَ فوارسٌ","كرامٌ إذ الأخرى من الرَّوعِ شلَّتِ",134,"ت",1,0],["ويمرقُ بي في السبق في كلّ حلبة","ٍ فتحسبهُ سهماً يطيرُ به النزع",135,"ع",1,0],["ويمضي يملأ الوادي ثناء","عليكم ، والأباطح والحزونا",136,"ن",2,0],["ويمنحني ثَغْرُها مَوْعِدَا","فيخضرُّ في شفتيها الصَدَى",137,"د",2,1],["ويمنعني وردَ الشرائع أهلُها","ويسرع غيري في السحاب فيرتوي",138,"ت",3,0],["ويميناً لقد تَقَبَّلْتَ مَهْدِيّ","كَ في أمْرِ قاسمٍ ورشيدَكْ",139,"ك",1,0],["ويمر في الذكرى خيالُ شباَبها","فكأن يقظَتها شبابٌ ثاني",140,"ن",2,0],["ويمشي إن أريد له المشاءُ","هُمُ المتضمِّنون على المنايا",141,"ا",1,0],["وَيمُّ الفَضل هَل يَحكي","هِ في تَيارِهِ الوَشل",142,"ل",1,0],["ويميل اخبابا ليهدم زاعما","شرفات مجد شامخ البنيان",143,"ن",1,0],["ويمدحنا امثالنا غير اننا","من الحق في كل الشؤن نوبخ",144,"خ",1,0],["ويمد الشراع من ساحل البح","ر بنشر الإيراد والإصدار",145,"ر",1,0],["ويميت من تحيي ليحيا ميت","لا خير فيه خلا القوام الفارع",146,"ع",1,0],["وَيَمنَعُ مِنها نَماءَ الإِفال","نسيءُ القِداحَ وَنَقدي التِجارا",147,"ر",2,0],["ويمناه تغنى الورَى بالندَى","وفي كفِّ يُسْراه موتُ الزُّؤامْ",148,"م",1,0],["ويمنعني من أن أجازي معادياً","شمائلُ من آرائكم وخِصَالُ",149,"ل",1,0],["ويمَّمتُ عِيسى قاصداً نحو سيد","ولم تَثنِني عنه فلاةٌ وصحصحُ",150,"ح",1,0],["وَيمنَعُهَا مَالِى وَيمنَعُ مَالَهُ","ألاَ هَيمَا مِن مِثلِ ذَاكَ وَهَيمَا",151,"م",2,0],["وَيمدَحُهُ لِضَعَافِ العُقُولِ","فَأَتلَفَ بالمَينِ مَا أتلَفَا",152,"ف",2,0],["ويمم الجنةَ الفيحاءَ مغتبقاً","كأسَ النعيمِ لدى حور وولدانِ",153,"ن",1,0],["وَيَمَّمتُ فَخرَ الدَولَةِ الواهِبَ الغِنى","وَشيكاً وَفي أَثنائِهِ العِزُّ وَالمَجدُ",154,"د",1,0],["وَيَمُدُّهُ بِالوَصلِ حينَ يَمُدُّهُ","بِبَديهَةٍ لا تُتعِبُ الأَفكارا",155,"ر",2,0],["وَيَمنَعُهُ مِن أَن يُعاوِدَ غِمدَهُ","إِلى أَن يَرى هامَ الأَعادي مُنَصَّفا",156,"ف",2,0],["وَيَمِّم بِها مِن وَراءِ الدُروبِ","لِيَلحَقَ بِالمُستَذِمَّ المُذِمّ",157,"م",1,0],["وَيَمنَعُ مَن تَحَدّاهُ حُدوداً","بِعِزِّ المَشرَفِيَّةِ أَن تُقاما",158,"م",2,0],["وَيَمحو ذُنوبي يَومَ نَشري لِمَوعِدي","كَبائِرُنا تُمحى بِجاهِ مُحمَدِّ",159,"د",1,0],["وَيَمِينُ الجَوْزَاءِ تَبْسُطُ باعاً","لِعِناقِ الدُّجى بِغَيْرِ بَنانِ",160,"ن",1,0],["وَيَميلُ مِنْ حَرَكاتِهِ فَكأنَّما","يَهْتَزُّ غُصْنُ البانِ في حَرَكاتِهِ",161,"ت",2,0],["ويممتَ المساجدَ مستبيحاً","من الحرماتِ مالا يستباحُ",162,"ح",1,0],["وَيَمنَعُني كَيدَ العَدُوِّ اِحتِقارُهُ","وَكَيد المُداجي عِفَّتي وَالتَكَرُّمُ",163,"م",1,0],["وَيُمسي قَريرَ العَينِ مَن في جَنابِهِ","وَإِن كانَ نَائي الدارِ جَمَّ الدَراهِمِ",164,"م",1,0],["وَيَمُتُّ بِأَرحامٍ وَشَجَت","مِن عِيصِكَ ذِي لَحمٍ وَدَمِ",165,"م",1,0],["ويمضي البدر كفته بحق","وهذا الخلق أكثرهم نيام",166,"م",1,0],["ويمشي على الأرض الثقيل كأنما","على ناظري يمشي وليس على الأرض",167,"ض",1,1],["ويمنعني أن يسط الجار عادة","وليس لمعروف المقل مزيد",168,"د",1,0],["وَيمدحُ وهّابيّةً لمسائلٍ","بِها قَد أَتوا نكراً وضلّوا بها فكرا",169,"ر",2,0],["وَيُمكنُ عفوُ اللَّه عَن كلِّ مُذنبٍ","وَما يَقتَضي أَن يركب المركبَ الوعرا",170,"ر",2,0],["وَيَمُجُّ ريقَتَهُ بِكُلِّ تَنوفَةٍ","سَحَّ المَزادُ إِذا تَبَعَّجَ وَاِنفَرى",171,"ا",1,0],["ويمجُّ رَعفاً لا يملُّ لسانُهُ","ويفيض بالآمالِ والآجالِ",172,"ل",1,0],["ويمكنه من غير دعوى تقدمت","لفطنته يقضي على الخصم للخصم",173,"م",1,0],["ويمسى رجال النيل أسداً غواضباً","تخايل في بردٍ من الفتك والزأر",174,"ر",1,0],["ويمزق عمامة لغلام","ثم يلقي بها إلى النيران",175,"ن",1,0],["ويمر أحلى الناس إن","هو صعر الخد الأسيل",176,"ل",1,0],["وَيُميعُ الفِراشَ ماءُ عيوني","كُنَّ يَعزِفنَ وَالصَدى في الرَقيعِ",177,"ع",1,0],["ويمنعني الشكوى إلى الله عِلْمُهُ","بجُمْلة ما ألقاه قبلَ أَقُول",178,"ل",1,0],["ويمناه شلت يوم أحد لدفعه","بها عن نبي الله لا يتزعزع",179,"ع",1,0],["وَيمثّل الدّنيا كَقائِلِ دَوحةٍ","وَمَضى وَخَلّفها بِغَيرِ تَواني",180,"ن",2,0],["وَيَميناً إِنَّهُ يُق","نِعُني مِنهُ اليَسيرُ",181,"ر",1,0],["وَيَمينُ هَذا مُزنَةٌ","لِلمُستَميحِ المُجتَدي",182,"د",2,0],["وَيَمينُ ذاكَ كَأَنَّها","مخلوقَةٌ مِن جَلمَدِ",182,"د",1,0],["وَيَميناً لِتَملِكَنَّ وَشيكاً","ما أَظَلَّتهُ تَحتَها الخَضراءُ",183,"ا",2,0],["وَيَمْتَطِي طِرْف رَدْعٍ","وَيَنْتَضِي سَيْفَ عُنْفِ",184,"ف",1,0],["ويُمسي عذولي غيرَ خالٍ من الأسى","إذا باتَ من أمثالها بيته خالي",185,"ي",1,0],["وَيَمنَعُني من أَن أَمرّ بِبابِهِ","وَأَرمُقُه أَنّي أَمرُّ فَيَخجَلُ",186,"ل",1,0],["وَيمرّ بي يَخشى الرَقيبَ وَلفظُهُ","شَتمٌ وَغنجُ لحاظِه تَسليمُ",187,"م",1,0],["ويمّم ربى روض ابن أدهمَ ذي العلا","وقف في حماه وقفة المتردّد",188,"د",1,0],["ويمّمي للتداني بالمسير فيا","سفينة الشوق بسم الله مجراك",189,"ك",1,0],["ويمنح القبول بالوصولِ","بسرّ سر السيّد الرسولِ",190,"ل",1,0],["ويمّم هداك الله منهاجَ رشده","لتدعى غنيّاً بعد ما كنت معدما",191,"م",2,0],["ويمنح العذب من موارده","من حقه دون شرب علقمه",192,"م",2,0],["ويميت العدا ويحي الأماني","ويجيب الندا ويعطي الظنونا",193,"ن",2,0],["وَيَمِيسُ أفْنَاناً فَتُبْصِرُ خُرَّداً","تَثْنِي القُدودَ لَطَافَةً وَلِبَانا",194,"ن",2,0],["ويَمَّمَهَا الرِّضْوَانُ أُماً كَرِيمَةً","لأَوْحَدَ مَخصوصٍ بِغُرِّ الْمَكَارِمِ",195,"م",1,0],["وَيَمَّمَ دَارَ المُلْكِ مُعْتَصِماً بِها","عَلَى ثِقَةٍ مِن فَوْزِهِ بِاعْتِصَامِهِ",196,"م",2,0],["ويُميتُ النُّكْرَ وَحُقّ له","بالعُرْفِ يَهُبُّ فَيَلْحَدُهُ",197,"د",2,0],["وَيَملِكُ ألبابَ الكُماةِ بِحُسنِهِ","وَيَملِكُهُ المَلكُ الهُمامُ المُعَظَّمُ",198,"م",1,0],["وَيَمدَحُ المِلحَ لِإِخوانِهِ","يَقولُ هَذا مِلحٌ سيرافِ",199,"ف",1,0],["ويمضي الشباب ويفنى الصبا","وعهد الشبيبة لا يرجع",200,"ع",1,0],["وَيموجُ مِنْ مَرّ النسيمِ جميعُها","كالماءِ تجري الريحُ فوق جِمامه",201,"م",2,0],["ويميمي سوح قوم","في ضنك عيش مريري",202,"ر",2,0],["ويمسي الكل منا","في نعمة وحبور",202,"ر",1,0],["وَيمنحَ السيّد الوالي نقابَتنا","مِن جدّنا رتبةً زًلفى لها شممُ",203,"م",1,0],["ويمس ممتطيا لسبع دجائج","مثل المهاري اجدقت بفنيق",204,"ق",1,0],["ويمجدون السلم وهو وسلية","في شرع أحكمهم إلى الهيجاء",205,"ا",2,0],["ويمزجُ ما ذاقَ من أمسه","بما يخبأ الغيب في برده",206,"ه",1,0],["وَيَمَّمَها مِن بَطنِ ذَروَةَ رُمَّةً","وَمِن دونِها مِن رَحرَحانَ مَفاوِزُ",207,"ز",1,0],["وَيَّمهُ مَن في البَسطِيْنِ سَالِكٌ","فَحَادٍ وَمَلاَّحٌ وَماشٍ وَرَاكِبُ",208,"ب",1,0],["وَيَمْتاحُها مِنَّا مُقِيمٌ وَسَائِرٌ","فَتُوسِعُ ذا جُوداً وَتُوسِعُ ذا رِفْدا",209,"د",2,0],["وَيُمسي لَها عَبداً بِدَعواهُ في الهَوى","وَيُصبِحُ مَولاها بِغَيرِ مَزِيَّةِ",210,"ه",1,0],["وَيَمنح كُلّ خلٍّ مِنهُ حَظّاً","عَلى حُكم النَدى كَرَماً وَبرّا",211,"ر",2,0],["وَيَمّمت بابك العالي مُهنّئة","بِيمن تَشريفك السامي كَما عُهدا",212,"د",2,0],["وَيمنٌ بِهِ غَيث الهَنا هَطلت عَلى","رِياض رُبى الآمال مِنّا سَحائبُه",213,"ب",2,0],["ويَملِكُ سِرَّ قلبي كُلُّ ظَبْيٍ","عليلِ اللّحظِ كالرَّشأ الخَذول",214,"ل",1,0],["ويُمِدُّ الوزيرَ منها بنَصْرٍ","فيكونُ الرُّكنَ الأعزَّ الأشَدّا",215,"د",2,0],["وَيَموتُ بِالداءِ الَّذي في قَلبِهِ","وَيَخافُ مِن عِلمِ الطَبيبِ بَدائِهِ",216,"ا",3,0],["وَيُملي عَلى الشِعرِ لَيسَ بِلُجَّةٍ","وَلا نُجمُهُ في اللَجِّ غَرقى وَعُوَّمُ",217,"م",1,0],["وَيَموتُ فيها شَمسُها غَرَقاً","وَيَندُبُها ضُحاها",218,"ا",3,0],["ويمدُّ همَّتَه وعُد","دَتَهُ ونجدَتَه وباعَه",219,"ع",2,0],["ويملأ مريماً شرفاً","بملء الطول والعرض",220,"ض",1,0],["وَيَمينهُ نَشأى البُرو","ق إِذا اِمتطت طَرف القَلَم",221,"م",1,0],["وَيَمين الصَباح مِن مَعطف الجَو","زاء كادَت وَتَحل عَقد النِطاق",222,"ق",1,0],["ويمسي كل مسلم في سرور","وفي شكر على نعم الرقيب",223,"ب",1,0],["وَيَمَّموهُ بِجَيشٍ","يَجيشُ مِن فِعلِ عَمرو",224,"ر",2,0],["ويمرّ القطيع بي فأرى الأغ","نام بين الذبّاح والسكّين",225,"ن",1,0],["ويموت الفلاح جوعا ليفترّ","لعيني رب القصور النعيم ؟",225,"م",1,0],["ويمضي مع الأيام يشدو بحبها","وفيها ولو يدري تقيم مقاتله",226,"ل",2,0],["ويمدّ للرّاجين كفّاً","لا تُدانيه السحائبُ",227,"ب",1,0],["ويُمطرُ في سَحابِ الخَدِّ خَلاً","إذا ما زارَهُ في العُرسِ خِلُّ",228,"ل",1,1],["وَيَمُدُّ نَحوَ المَكرُماتِ أَنامِلاً","لِلرِزقِ في أَثنائِهِنَّ مَجاري",229,"ر",2,0],["وَيَميلهن مِنَ الصبا أَنفاسِها","فَتَخال أَنفاس الرِياح الراحا",230,"ح",2,0],["ويملكني هواكِ وكلُّ حرٍّ","لمن يهواه يا سَلمى رقيق",231,"ق",1,0],["ويميناً إنَّه لوْ لمْ يَجدْ","في منام لم يذق قطّ مناما",232,"م",2,0],["ويمجُّ الشَّهدَ من ريقَتِه","ولحظّي منه تجريع العلاقم",233,"م",1,0],["ويميل من كرم الطباع كأنّما","شرِبَتْ شمائله المدام شمولا",234,"ل",2,0],["ويمنعها من ظلمه مستحقّها","ألا دعوةٌ للمجد نَوْفُ صدقها",235,"ه",2,0],["ويميناً لو يملكوها علينا","تركوها معالماً وطلولا",236,"ل",2,0],["ويميناً إنَّها إن صَدَمَتْ","جبلاً بالبأس منها خرَّ هدَّا",237,"د",2,0],["ويمدّها بيضاءَ يهطلُ وبلها","ويسيل شامل برها السيال",238,"ل",1,0],["ويمم الحي من تلك الطلول وقف","واقرأ تحية صبّ غير متهم",239,"م",1,0],["ويَمِيلُ فيه الزَّعْلَمشُّ لِطَبْعِهِ","فَيهُزُّ منه التِّيهُ مَعْطِفَ شارب",240,"ب",1,0],["ويمطِرُني نُعمى لساني ومَعطِفي","بها نبتُه لدنُ المهزّةِ أغيَدُ",241,"د",1,0],["ويمن الملك المفطّم قد أو","تي إمام الهدى بلوغ المراد",242,"د",1,0],["ويمزي درّ أجفانٍ موكلةٍ","من الدموعِ بغيض المسبل الهطل",243,"ل",1,0],["ويمنعني مما أحبّ فرقدةُ","أفوزُ بها أو رصدة حين يطرقُ",244,"ق",1,0],["ويَمَّمَتْكَ ملوكُ الأَرضِ مُعْمِلَةً","إِلَيْكَ نَصَّ نجاءِ الخيلِ والإِبلِ",245,"ل",1,0],["ويَمْرَعُ بالأَشْجَارِ عُودُ رَبِيعِها","ويُونِعُ بالأَثْمارِ كَرُّ خَريفِها",246,"ف",3,0],["ويمناكَ بالإِحسانِ حسبُ مَنِ اعتَفى","وسُقياكَ بالمعروفِ حَسبُ منِ استَسقى",247,"ق",2,0],["ويمد لي لو كنتم بظهورها","منكم كريم يدٍ يد المستعجل",248,"ل",1,0],["ويمزج الجد طي المزح تحسبه","يلهو وفيه أفانين لإغراء",249,"ا",2,0],["ويمثلون من المهازل للورى","صور المىسي القارحات جفونها",250,"ن",3,0],["ويُمطيك إعظاما قَرا كلِّ سابقٍ","مكانُك منه في العلاء مكينُ",251,"ن",1,0],["ويميناً لَمَنْ تمدُّ بأعرا","قك في الفخر أن يسودَ جديرُ",252,"ر",1,0],["ويُمْطَل دَيْني ودِين الوفا","ء تاركُه عندكم يَكْفُرُ",253,"ر",1,0],["وَيَمِين جاريةٍ سَلَكْتَ في","مِسبَاحِها وَذَهَبْتَ في آناتِها",254,"ت",3,0],["ويمضي بباقيه ابن كَوْزان لا سَقى","مواطنهُ إلا ربابٌ من القطر",255,"ر",1,0],["ويُمضي الأمر في المنطوقِ حتى","كأنَّ الأمر من فمه قَضاءُ",256,"ا",2,0],["ويمضي رعيل الرأي من قبل جيشه","فيهزمُ كَبَّاتِ الخطوبِ والطوارق",257,"ق",1,0],["ويمضي اذا أحْجَمَ الدَّارعونَ","واِنْ طاشَ عِطفُ حليمٍ وقَرْ",258,"ر",1,0],["ويُمْسي عميد الحيِّ بعد نَعيمهِ","إِلى الشُّخب عيمانَ الحشاشة صاديا",259,"ي",2,0],["ويمْدحُهُ من دارمٍ ذو بَلاغَةٍ","بنى فخْرَه صيْفِيُّهُ ومُجاشِعُه",260,"ع",2,0],["ويُمْسي ديمَةً يَهْمي إذا ما","سَحابَتُنا غَدَتْ قَزَعاً جَهاما",261,"م",2,0],["ويمْطرُ المحْل والأنواءُ مخلِفَةٌ","بوابلٍ من نَدى كَفَّيْهِ مِدْرارِ",262,"ر",1,0],["ويُمْطرُ مُغْبرَّ البلادِ بَنانُهُ","إذا الجدْبُ غالَ المُترفين غوائلُهْ",263,"ل",2,0],["ويملأُ أسْماعَ الرِّجالِ بَلاغَة","وأعْينُهم ما بين خطٍّ ومِقْوَلِ",264,"ل",1,0],["ويميناً لولا لقاءُ عماد الدي","ن ما اقصر الزمان اللئيم",265,"م",1,0],["ويمشي ربيط الجأش في كل دجيةٍ","سرى البرقِ فيها من مخافتهِ خطف",266,"ف",1,0],["ويميناً لم يعظم البرحُ لو كا","ن إلى السبيل منه سبيلُ",267,"ل",1,0],["وَيَمَّحي ظِلُّنا مِن فَرْطِ ما التَصَقَتْ","بِهامِنا الشَّمسُ نُدْنيها وَتُدنينا !",268,"ن",2,0],["ويُمسي حليفَ الشوقِ ذا جسدٍ له","بحكمِ الهوى بالٍ وذا مقلةٍ عبرى",269,"ر",2,0],["ويمموا الجامع الزيتونة العلوي","حيث الصلاة عليها في معاليه",270,"ي",2,0],["ويمنحني من سر سرك نفحة","إلهيّة مر الدهور الديموميه",271,"ي",2,0],["ويميناً لا تمثل","ت له فَقْعاً بقاع",272,"ع",1,0],["ويموج بحر الفيض في عتباته","وتلوذ في ساحاته الأقطاب",273,"ب",1,0],["ويملأ أقطار الوجودات كلِّها","فيبهت أفاك ويحتار حاسدُ",274,"د",1,0],["ويميت شهرته ليطوي نشرها","والحقُّ في ملكوته يحييها",275,"ي",3,0],["ويمحق ربي بالنكال فعالهم","ويثبت في لوح السعود فعالنا",276,"ن",2,0],["ويمرُّ بالحجر الأصنِّ فيلتوي","عطفاً عليهِ لأَنَّهُ المتوالِ",277,"ل",1,0],["ويمحو بعزم العون آثار خصمنا","فينحط من بيض المنابر للترب",278,"ب",1,0],["ويمُرُّ في صُفَفِ القُلُوبِ بسِرِّهِ","مَرَّ الشِّهابِ ببُرْجِهِ النُّوراني",279,"ي",1,0],["ويمنعُ العظْمَ حين يُمسي","مُعمَّدَ مجلسِ القداحِ",280,"ح",1,0],["ويمنعني الوفاء لكم بعهدي","وحسن الظن أن أجد اختلالا",281,"ل",2,0],["ويماني فوق القلب تبرد حره","ويسراي تحت الخد والعين تسفح",282,"ح",1,0],["ويَمينٌ بنانُها زاخِراتٌ","بالمَنايا وبالعطاءِ المَزيدِ",283,"د",1,0],["ويَميلُ صبّاً للرّماحِ كأنّهُ","صبٌّ بقاماتِ المِلاحِ مولَّعُ",284,"ع",1,0],["ويمينُ دولَتِه وآيةُ مُلكِه","ودليلُ نُصرتِه على الخُصَماءِ",285,"ا",2,0],["ويُمِدُّ والدَكم ودولةَ مجدِكم","بدوامِ إقبالٍ وطولِ بَقاءِ",285,"ا",2,0],["ويمين كريمة وجبين","مستهلان بالحيا والحياء",286,"ا",2,0],["ويُمْضِي اللّيلَ في نَشْرٍ وطَيٍّ","بِأَسْجالٍ قَديماتِ البِنَاءِ",287,"ا",2,0],["وَيُمنُّ بعدُ بِلُطفِه عن عَبدِه","حتَّى يَذوقَ حلاوةَ اللطفِ الخَفِي",288,"ي",1,0],["ويمَّمتُمُ الحمرَاءَ يحدُو رَكَابَكُم","تَشَوُّقُ أهلِيها إلى ذَلِكَ الرَّكبِ",289,"ب",1,0],["ويمدّ صَرْفُ الدّهرِ نَحِوى طَرْفَه","وَهو الّذي لَولاك ليس يراني",290,"ي",1,0],["ويمضي نهاري وإظلامُهُ","بما غيرُه الأحسنُ الأجملُ",291,"ل",1,0],["ويمقُتُ الوَعْدَ فإنْ أمَّهُ","نَغَّصَه بالمَطْلِ والخُلْفِ",292,"ف",1,0],["ويَمطُلُنِي بالوعد منه وإنّما","يماطل بالميعاد مَن ليس يُخلفُ",293,"ف",1,0],["وَيُمسِي حَديثُ القَومِ عنهُ وَيغتدي","ذَكيّاً شَذاهُ بَينهمْ أرِجَ النَّشرِ",294,"ر",1,0],["ويمينها الحجرُ السعيد لبيعة","قد مدَّ حيثُ شهودها الإيمان",295,"ن",1,0],["ويمد الجميع منه بجود","ووجود هو الضيا في الظلام",296,"م",1,0],["ويمينٍ تكون كلُّ يمينٍ","عند أَعمالِها لديها شِمالا",297,"ل",2,0],["وَيَمْكُثُ لاَ يَلْقَى عَدُوَّاً فَإِنْ غَزَا","فَوَاحِدَةً فِي الدَّهْرِ لَيْسَ بِتَوْأَمِ",298,"م",1,0],["وَيَمْنُعَها مِنَ الشَّكْوَى","إِلَيْنَا أَنَّهَا صَلِفَهْ",299,"ف",2,0],["ويمضغُه الدَّهرُ مَضْغَ الأَديم","ويَعْرُكُهُ النحسُ عرْك الأَدَم",300,"م",1,0],["ويمَّمْتُ يمّاً حُزْتُ في اليَمِّ قَبْلَهُ","إِليه فمِنْ يمٍّ وَصَلْتُ إِلى يَمِّ",301,"م",1,0],["ويمّموا الثغرَ وطَافوا به","وأَحْدقُوا كالغلِّ لاَ كَالسِّوَارْ",302,"ر",1,0],["ويميناً لَوْ عَرْبد الدَّهْر سُكْراً","لأُقيمَتْ مِنْهَا عَلَيْه الحُدُودُ",303,"د",1,0],["ويمنحُ المدنَ في الجَدْوى لسائِله","كمَا ترفَّعَ في الجدْوى عن الذَّهب",304,"ب",1,0],["ويُمَارِسُ الدُّنْيَا بِهِمَّة مَنْ يَرى","أَيَّامَهَا شَرَفاً لِوَقْعِ نِصَالِهِ",305,"ل",2,0]]}