{"poems":[[55,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[23,"أجمعت عمرة صرما فابتكر","https://www.aldiwan.net/poem21419.html","الرمل"],[74,"طربت بعهد الصبا بعد ما","https://www.aldiwan.net/poem18276.html","المتقارب"],[53,"لم يله في المهرجان أولى","https://www.aldiwan.net/poem7936.html","مخلع البسيط"],[47,"يلاوط والاست من عنده","https://www.aldiwan.net/poem65627.html","المتقارب"],[21,"يوقف الناس للحساب جميعا","https://www.aldiwan.net/poem36238.html","الخفيف"],[48,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54862","المنسرح"],[92,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[201,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[445,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[563,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[584,"تعود على الإحسان يغنيك زاده","https://www.aldiwan.net/poem28338.html","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6771","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61005","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204850","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205029","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204576",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62822","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129509","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[4978,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=177226",""],[5956,"السَّقام والإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=203300",""],[5970,"يوقد النقمة في قلب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=130620",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""],[6225,"اللغة العربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81025&r=&rc=262",""]],"verses":[["يُوَقِّعُ أَلحاظَهُ وَالشَجا","عُ يَلحَظُ عَن ناظِرٍ فاتِرِ",0,"ر",1,0],["يوقِدُ النارَ لِلقِرى وَعَليها","حَسَبٌ لَو خَبا الوُقودُ أَنارَا",1,"ر",2,0],["يُوَقِّرُها فَتَحسَبُها أُسوداً","وَيُطلِقُها فَتَحسَبُها ذِئابا",2,"ب",2,0],["يوقِدُ النارَ إِذا ما أُطفِئَت","يُعمِلُ القِدرَ بِأَثباجِ الجُزُر",3,"ر",1,0],["يُوَقِّرِني ودّه لا جفا","ويرْوي الصدى بره لا نضَب",4,"ب",1,0],["يُوقَى بهم أسهمَ المنايا","إذا ألمَّتْ به ويُفدى",5,"ا",1,0],["يُوَقِّرُ مِن رِدفِهِ لِلصَدي","قِ وَيَخبَأُ مِن أَيرِهِ لِلعِيالِ",6,"ل",1,0],["يوقَفُ الناسُ لِلحِسابِ جَميعاً","فَشَقيٌّ مُعَذَّبٌ وَسَعيدُ",7,"د",1,1],["يُوَقِّرُهُ الكَرى فَيَقَرُّ طَوراً","وَيَمنَعُهُ الحِذارُ مِنَ القَرارِ",8,"ر",1,0],["يُوِقدُ فِيهِ الذَّكَاءُ شِعْلَتَهُ","وَيَجْتَنِي مِنْ كنُوِزِه الْغُرِّ",9,"ر",1,0],["يُوَقِّعُ ما شاء عُودُ الزمان","ويبكي ويضحك منه الوتر",10,"ر",1,0],["يوقد النار فيصلاها","وتخبو فيعود",11,"د",1,0],["يُوقدِ القومُ نارهم في جدالٍ","فإذا قال أخمدوا الضوضاءَ",12,"ا",2,0],["يَوقِّرُ عنكُمْ سَمْعُهُ فيُصيخُهُ","ويَقصُرُ عَنْكُمْ طَرْفُهُ فَيَمُدُّهُ",13,"د",2,0],["يوقعه في جحود ما لا","يدريه مما درت ثقات",14,"ت",1,0],["يوقِّيهِ ما لا تستطيبُ لسانُهُ","لحاجةِ مملاقٍ أَضَلَّ رقادُهُ",15,"د",2,0],["يوقِنُ بِالنارِ وَلا يَرعَوي","كَأَنَّهُ يَرتابُ في النارِ",16,"ر",1,0],["يوقظ النفسَ بين حربٍ وكَربٍ","في جحيمٍ من زفرةِ الندمانِ",17,"ن",1,0],["يوقع الناس خادعاً وكذوباً","في شباك من مغرياتِ الأماني",17,"ن",2,0],["يُوَقى بستر الله من كلّ نكبةٍ","فلا زال في ستر من النكبات",18,"ت",1,0],["يوقّع شعري إحساسه","كما كان وقعه الخاطر",19,"ر",1,0],["يوقظ الناي له في لحنه","ذكريات مبهمات للسنين",20,"ن",1,0],["يوقظني الفار حين أغفي","بالقرض إن طاب لي المبيت",21,"ت",1,0],["يُوقّرُ بُعدَ الناعجات حنينُها","بأسمرَ يدعو حلمَها فيُجيبُ",22,"ب",1,0],["يوقدون النار ليلا للقرى","كرما لكن بها قلبي صليا",23,"ي",2,0],["يُوقِعُ اليَومَ سوفَ يَنهَضُ جاشا","ويُسِيلُ الدِّماءُ مِنهُم وَبلا",24,"ل",2,0],["يوقعه الممثّلُ من دعوه","وحيداً، إنّما هذا كِذابُ",25,"ب",1,0],["يُوقِف الوحيُ عطاياه إذا ما","أصبح الإحساسُ أحجاراً ودمية",26,"ي",2,0],["يوقد النقمة في قلب الكريم","سوء ما يلقى من الدهر اللئيم",27,"م",1,1],["يوقظ الطفلَ في الضحى دمع مزما","ري، وحَلواه من صنيع يديَّهْ",28,"ي",2,0],["يُوقِفُها .. والريحُ رُخاءٌ","يُطلِقُها .. والغيمُ ثقيلُ",29,"ل",1,0]]}