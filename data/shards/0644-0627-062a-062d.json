مْ تَكْتَحِلْ بالإِثْمِدِ",138,"د",1,0],["لا تَحظُرِ العَفوَ إِن كُنتَ اِمرَأً حَرِجاً","فَإِنَّ حَظرَكَهُ في الدينِ إِزراءُ",139,"ا",2,0],["لا تُحوِجُ الرامي إِلى اِنتِقائِها","فَهيَ تُراقي الطَيرَ في اِرتِقائِها",140,"ا",3,0],["لا تَحمَدَنَّ اِمرَأً مِن غَيرِ تَجرِبَةٍ","وَلا تَذُمَّنَّهُ إِلّا بِتَجريبِ",141,"ب",1,0],["لا تَحمِدَنَّ اِمرَأً حَتّى تُجَرِّبَهُ","وَلا تَذُمَّنَّهُ مِن غَيرِ تَجريبِ",142,"ب",1,0],["لا تَحسَبَنَّ عُقارَ خابِيَةٍ","وَالهَمَّ يَجتَمِعانِ في صَدرِ",143,"ر",1,0],["لا تَحزَنَنَّ لِفُرقَةِ الأَقرانِ","وَاِقرِ الفُؤادَ بِمُذهِبِ الأَحزانِ",144,"ن",1,1],["لا تَحفِلَنَّ بِقَولِ الزاجِرِ اللاحي","وَاِشرَب عَلى الوَردِ مِن مَشمولَةِ الراحِ",145,"ح",1,1],["لا تُحسِنُ الشِعرَ وَتَهجو الشاعِرا","يا اِبنَ الخُلَيقِ اِقعُد قَميئاً صاغِرا",146,"ر",2,0],["لا تَحسَبَنّي كَمَن تَجري مَدامِعُهُ","مِنَ الوَعيدِ مَعَ الحورِ الرَعاديدِ",147,"د",1,0],["لا تُحِبُّ الفِراقَ حَتّى غَدا البَي","نُ وَأَقوَت دِيارُنا بِالنِجادِ",148,"د",1,0],["لا تَحمَدَنَّ أَبا حَربٍ بِأُسرَتِهِ","قَد يَثبُتُ اللَيثُ وَالخِنزيرُ في الغابِ",149,"ب",1,1],["لا تَحسَبَنّي كَأَيرٍ بِتَّ تَمسَحُهُ","كَيما يَقومُ وَيَأبى غَيرَ إِغفاءِ",150,"ا",2,0],["لا تَحفِلنَ هَجوَهُم وَُمَدحَهُمُ","فَإِنَّما القَومُ أَكلُبٌ نُبُحُ",151,"ح",1,0],["لا تَحمِلَن ثِقلاً عَلَيَّ فَإِنَّني","وَهناً وَقُدّامَ الرِكابِ صَعودُ",152,"د",1,0],["لا تَحمَدَنَّ وَلا تَذَمَّنَّ اِمرِأً","فينا فَغَيرُ مُقَصِّرٍ كَمُقَصِّرِ",153,"ر",1,0],["لا تَحفَظِ الشَربَ مِثلَ الطَيرِ وارِدَةً","أَجناً إِذا ما أَصابوا رَيَّهُم قَلَسوا",154,"س",3,0],["لا تَحلِفَنَّ عَلى صِدقٍ وَلا كَذِبٍ","فَما يُفيدُكَ إِلّا المَأثَمَ الحَلِفُ",155,"ف",1,0],["لا تُحجَزُ الأَقدارُ وَهيَ كَثيرَةٌ","كَالغَيثِ وابِلُهُ يَصوبُ وَطَلُّهُ",156,"ل",2,0],["لا تَحمِلُ المَرأَةُ عِلماً بِأَنَّ الحُس","نَ في مِرآتِها دَيَّما",157,"م",2,0],["لا تُحدِثِ القَطعَ في كَفٍّ وَلا قَدَمٍ","وَلا تُعَرِّض مِدى الدُنيا لِسَفكِ دَمِ",158,"م",1,1],["لا تُحكمِ العَقدَ في حِلفٍ وَلا عِدَةٍ","فَإِنَّ طَبعَكَ يُدعى ناقِضَ الذِمَمِ",159,"م",1,0],["لا تَحلِفَنَّ عَلى صِدقٍ وَلا كِذبٍ","فَإِن أَبَيتَ فَعَدِّ الحَلفَ بِاللَهِ",160,"ه",1,0],["لا تَحزُنيني بِالفِراقِ فَإِنَّني","لا تَستَهِلُّ مِنَ الفِراقِ شُؤوني",161,"ن",2,0],["لا تحسَبُوني في الهوى مُتَصَنّعاً","كَلَفي بِكُمْ خُلُقٌ بغيرِ تكلُّف",162,"ف",1,0],["لا تحقر النجم إن أَبدى وَضاءَته","يا أَيُّها اللَيل إن النجم محترم",163,"م",1,0],["لا تحتقره لكونه","في أصله قد كان قردا",164,"د",2,0],["لا تحسن الشعرة حتى ترى","منشورة الضفرين يوم القتال",165,"ل",1,1],["لاتَ حين المزار أيتها الأش","باحُ فامضي فما عرفتكِ قبلا",166,"ل",2,0],["لا تَحسَبي أَنّي هَجَرتُكِ طائِعاً","حَدَثٌ لَعَمرُكِ رائِعٌ أَن تُهجَري",167,"ي",1,0],["لا تَحْسَبي إبِلي سُهَيْلاً طالِعاً","بالشأمِ فالمَرْئِيُّ شُعْلَةُ قابِس",168,"س",1,0],["لا تُحاوِلْ أنْ تنكرَ الشَّجْوَ إنّي","قَدْ خَبِرتُ الحياةَ خُبْرَ لَبيبِ",169,"ب",1,0],["لا تَحسَبيني مِثلَ مَن هُوَ قاعِدٌ","عَلى عُثَّةٍ أَو واثِقٌ بِكَسادِ",170,"د",1,1],["لا تَحْسَبِي قَوْلِي خَدِيعَةَ مَاكِرٍ","إِنَّ الْوَفِيَّ بِعَهْدِهِ لَمْ يَخْدَعِ",171,"ع",1,0],["لا تَحْسَبَنَّ الْهَوَى سَهْلاً فَأَيْسَرُهُ","خَطْبٌ لَعَمْرُكَ لَوْ مَيَّزْتَهُ جَلَلُ",172,"ل",1,0],["لا تَحْسَبَنَّ الرِّفْقَ يَنْزِعُ غِلَّهُمْ","الشَّرُّ دَاءٌ مَا لَهُ إِفْرَاقُ",173,"ق",1,0],["لا تَحْسَبِينِي مِلْتُ عَنْكِ مَعَ الْهَوَى","هَيْهَاتَ مَا تَرْكُ الْوَفاءِ بِعَادِي",174,"ي",1,0],["لاتِّحَادِ النِّسَاءِ فِي مِصْرَ فَضْلٌ","أَكْبَرَ النَّاسُ مِنْهُ مَا يَشْهَدُونَا",175,"ن",2,0],["لاَ تُحْجِمُوا عَنْ فَتْحِ بَا","بٍ لِلمَنَافِعِ بَعْدَ بَابِ",176,"ب",1,0],["لاتِّحَادِ النِّسَاءِ مِنْهُ نَصَيبٌ","لاَ يُوَفَّى تَجِلَّةً وَشُكُورَا",177,"ر",2,0],["لا تَحسُدَن قَوماً إِذا فاضَلتَهُم","فَضَلوكَ في الأَخلاقِ وَالأَجناسِ",178,"س",1,0],["لا تَحسَبيني ماذِقاً لِلهَوى","إِنّي عَلى حُبِّكِ مَطبوعُ",179,"ع",1,0],["لا تَحسَبي أَنَّ طولَ الدَهرِ غَيَّرَني","بَل زادَني شَغَفاً يا أَطيَبَ الناسِ",180,"س",1,0],["لا تَحسَبَنَّ مَدامِعي","بُغِتَ الغَليلُ بِها وَهيجا",181,"ج",2,1],["لا تَحْمِلوه عَلَى المَدَافِعِ إِنّما","فَخْرُ الزَّعيم قِيادَةُ الأَعْزَالِ",182,"ل",1,0],["لا تحسبيني سالياً ، إن تلمحي","في ناظري ، هذا الذهول المبهما",183,"م",2,0],["لا تحسبنِّي بعد موتك جامدًا","الله يعلم أن صدريَ وار",184,"ر",1,0],["لا تحصِ أعمارَ الملوك؛ فإنني","أجد الملوك: مداركًا، وعقولا",185,"ل",2,0],["لا تحسَبنَّ الموتَ بينًا، إنَّهُ","بِينَ الأحبةِ موعدٌ وتلاقي",186,"ق",2,0],["لا تحتمي من غاصبيك بهيئةٍ","دوليَّةٍ، لكنْ بنفسكِ فاحتمي",187,"م",2,0],["لا تَحْلُموا بالنصر حول موائدٍ","أضْفَى عليها الزَّيْفُ لونًا أخضرا",188,"ر",2,0],["لا تحذَروا خطرَ الهجو","م؛ فليس يظفرُ مَنْ يحاذرَ",189,"ر",1,0],["لا تحْسَبنَّ مرابضَ الآ","ساد سهلة الاقتحام",190,"م",1,0],["لا تحسبني محبًا أشتكي وصبًا","أهون بما في سبيل الحب ألقاه",191,"ا",2,0],["لا تحزنن فإن الله ثالثنا","وليس من يرعه الرحمن يكتئب",192,"ب",1,0],["لا تحسبوا العدَّ بالأرقام يُسعدكم","تحصى النجومُ وما تُحصى بلايانا",193,"ن",2,0],["لا تحسبوا ماءَ الفرات","كعهدكمْ فلقد أجَن",194,"ن",1,0],["لا تَحْسَبنَّ تمادي العمر أدبَّه","كذاك كان على العلات وهو صبي",195,"ب",2,0],["لا تحقرني فربما نفدتْ","في هَدْم يأجوجَ حيلة ُ",196,"ه",1,0],["لاتحسب المعروف لامعنى له","إلا نوافل حمده وثناه",197,"ه",1,1],["لا تحسبي حظاً خصصتِ به","رَجُلاً سَلَبْتِ فُؤَادَهُ صَبّا",198,"ب",2,0],["لاَ تَحْرِمِيهِ الوَصْلَ وکتَّخِذي","أَجْراً فَلَيْسَ بِذَاكَ مِنْ بَأْسِ",199,"س",1,0]]}