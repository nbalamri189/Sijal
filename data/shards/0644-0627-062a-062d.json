ctabudhabi.ae/diwan/poem/42683","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54958","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13598","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12738","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43685","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[95,"سر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=12258",""],[106,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[51,"لم أتخذ منك غير متخَذِ","https://www.poetsgate.com/ViewPoem.aspx?id=28614",""],[51,"لاتحسب المعروف لامعنى له","https://www.poetsgate.com/ViewPoem.aspx?id=26181",""],[31,"هلا ارعويتِ، فترحمي صبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18791&r=&rc=54",""],[31,"أَبَتِ البَخِيلَة ُ أَنْ تُنَوِّلَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18920&r=&rc=183",""]],"verses":[["لا تَحسَبوا أَنّي عَلى جُرأَتي","أَحجَمتُ حَتّى ضاقَ لي مَقدَمي",0,"م",2,0],["لا تَحسُدوا المُتَرادِفينَ عَلى العُلى","وَالغالِبينَ عَلى السَنامِ الأَكوَمِ",1,"م",1,0],["لا تَحسَبَن جَدَثاً طَواهُ ضَريحُهُ","قَبراً فَذاكَ مَغارُ بَعضِ الأَنجُمِ",1,"م",1,0],["لا تَحسَبيهِ وَإِن أَسَأتِ بِهِ","يُرضي الوُشاةَ وَيَقبَلُ العَذَلا",2,"ل",2,1],["لا تَحسَبِ العَيشَ ذا طولٍ فَتَركَبَهُ","يا قُربَ ما بَينَ عُنقِ اليَومِ وَالكَفَلِ",3,"ل",1,0],["لا تُحدِثَن طَمَعاً وَجَدُّكَ مُدبِرٌ","وَاِطلُب مَدى الدُنيا وَجَدُّكَ مُقبِلُ",4,"ل",1,0],["لا تُحرِجوا هَذي البِحارَ فَرُبَّما","كانَ الَّذي يَروي المَعاطِشَ يَغرَقُ",5,"ق",1,0],["لا تَحسَبَن قَولي مُماذَقَةً","وَجدي بِبُعدِكَ فَوقَ ما أَصِفُ",6,"ف",1,0],["لا تَحسُدَنَّ المَرءَ ثَروَتَهُ","إِنَّ البِطانَ إِلى غَدٍ خُمصُ",7,"ص",1,0],["لا تَحسَبوا أَنّي أَقَمتُ فَإِنَّما","قَلبُ المُقيمِ زَميلُ ذاكَ السائِرِ",8,"ر",1,0],["لا تُحوَجَنَّ إِلى العِصا","بِ وَأَنتَ في الضَرعِ الدَرورِ",9,"ر",1,0],["لا تَحسَبَنَّ الرِزقَ مُطَّرَحاً","فَالرِزقُ بَينَ مَواضِعِ الأُسدِ",10,"د",1,0],["لا تَحسَبوا ذا البُعدَ غَيَّرَني","فَالبُعدُ غَيرُ مُغَيِّرٍ وِدّي",10,"ي",1,0],["لا تَحفَلَن بِوَعيدٍ زَلَّ عَن فَمِهِ","فَما يَضُرُّ مِنَ المَغرورِ تَوعيدُ",11,"د",1,0],["لا تَحسَبَنَّ الخُلودَ بَعدَكَ لي","إِنَّ المَنايا أَعدى مِنَ الجَرَبِ",12,"ب",1,0],["لا تَحْسَبِ السِّرَ الذي استَوْدَعْتَني","ممّا يَفُرُّ حَشايَ عنهُ الواشي",13,"ش",2,0],["لا تَحمِلَّنَّ لِمَن يَمَنُّ","مِنَ الأَنامِ عَلَيكَ مِنَّه",14,"ن",2,1],["لاَ تُحِلُّوا دَمَ الْغَريبِ الْمُعَنَّى","وَعَلَى اللَّهِ فِي الْجَزَاءِ الْحَوَالَهْ",15,"ل",2,0],["لاَ تَحْسِبِ النَّاسَ فِي نَوْمٍ فَأَعْيُنُهُمْ","تَرْنُو إلَيْكَ فَعَامِلْهُمْ بِإِجْمَالِ",16,"ل",1,0],["لا تَحمدَنَّ امرءً حَتّى تُجَرِّبَهُ","وَلا تَذُمَنَّهُ مِن غَيرِ تَجريبِ",17,"ب",1,1],["لا تَحسَبَنّي عَنكُمُ غافِلاً","فَلَستُ بِالواني وَلا الفاتِرِ",18,"ر",1,0],["لا تَحمِلوهُ عَلى الرِقابِ فَقَد كَفى","ما حُمِّلَت مِن مِنَّةٍ وَعَطاءِ",19,"ا",2,0],["لا تَحسَبَنَّ الفَخرَ ما أَحرَزتَهُ","الفَخرُ بِالذِكرِ الجَميلِ رَهينُ",20,"ن",1,0],["لا تَحسَبَنَّ العِلمَ يَنفَعُ وَحدَهُ","ما لَم يُتَوَّج رَبُّهُ بِخَلاقِ",21,"ق",1,0],["لا تَحسبَن يا مُرُّ أَنَّكَ أَوَّلٌ","في صَفعِهِ ما أَنتَ إلّا رابِعُ",22,"ع",1,0],["لا تَحسبوا أَنَّ قَلبي عَن مَحَبَّتِكُم","وَإِن تَمادَيتُم في هَجرِكُم زاغا",23,"غ",2,1],["لا تَحسَبوا نَأيَكُم عَنّا يُغَيِّرُنا","أَن طالَما غَيَّرَ النَأيُ المُحِبّينا",24,"ن",2,0],["لا تَحْقِرِ الدِّرْهَمَ مِنْ مُسْعِدٍ","سَلْ أُمَمَ الْغَرْبِ بِهِ تَعْلَمِ",25,"م",1,1],["لا تَحسَبُوا مِصْرَ تَنْسَاكُمْ فَكُلكُمُ","يَبْقَى عَلَى الدَّهْرِ مَرؤُوماً وَمَرْحُومَاً",26,"م",2,0],["لا تَحمَدَن حَسَناً في الجودِ إِن مَطَرَت","كَفّاهُ جَزلاً وَلا تَذمُمهُ إِن رَزَما",27,"م",2,1],["لا تَحزُنَنَّكَ حاجاتي أَبا عُمَرِ","فَأَنتَ مِنهُنَّ بَينَ الشُكرِ وَالعِذَرِ",28,"ر",1,1],["لا تَحسَبَن جَهلي كَحِلمِ أَبي فَما","حِلمُ المَشايِخِ مِثلَ جَهلِ الأَمرَدِ",29,"د",1,0],["لاتحتقر صغر النجوم فإنما","أرقى الكواكب ما استبان ضئيلا",30,"ل",2,0],["لا تَحسِبَنَّ مِراسَ الحَربِ إِذ خَطَرَت","أَكلَ القِبابِ وَأَدمَ الرُغفِ بِالصيرِ",31,"ر",1,0],["لا تَحسِبي سَباسِبَ العِراقِ","وَنَغَضانَ القُلُصِ المَناقي",32,"ق",2,1],["لاتَحرُزُ الدُرعُ عَنّي نَفسَ صاحِبِها","وَلا أُجيرُ ذِمامَ البيضِ وَاليَلَبِ",33,"ب",1,0],["لا تحسب العقد في الأعناق يشبهه","فإنَّ للزندِ حلياً ليس للعُنق",34,"ق",1,0],["لا تحذرا مع عفو الله موبقة","تحصى ولا مع ندى السلطان إقْلالا",35,"ل",2,0],["لا تحسبنّك في هجائك تَفْتري","ما لم يجئنَ به من الفَحْشاءِ",36,"ا",2,0],["لا تحسب المعروفَ لا معنى له","إلاَ نَوَاقِلَ حمدهِ وثَنَاهُ",37,"ه",1,1],["لا تَحْقِرَنَّ سُيَيْباً","كم جَرَّ نفعاً سيَيْب",38,"ب",1,0],["لا تحسبنَّ عُرَامي إنْ مُنيتَ به","إحدى المواعِظِ أو بعضَ التجاريبِ",39,"ب",1,1],["لا تحسَبنِّي عنك في غَفْلةٍ","عَوْدِي وشيكٌ أيها الصاحبُ",40,"ب",1,0],["لا تحقِرنَّ سُبَيباً","كم جَرَّ سبّا سُبيبُ",41,"ب",1,0],["لا تُحلني على سواك فما أص","بح للطالبين غيرَك بابُ",42,"ب",1,0],["لا تحسبَنَّ على امرىءٍ في شتمِه","حُوباً فما في شتمه من حُوبِ",43,"ب",1,0],["لا تحقِر المُنْصُلَ الخشيبَ فقدْ","يُرضيك عند المِصاعِ مُختشبُهْ",44,"ب",2,0],["لا تحسَبُوا ضَرْبة صيَّادكم","أتت على المنتوج والنَّاتجِ",45,"ج",1,0],["لا تحمدنَّ بليغاً في مدائحه","أفعالُه فسحت في مدحه الفُسَحا",46,"ح",2,0],["لا تُحْوَجانِ إلى غِمْدٍ يضُمُّكما","كِلاكُما الدَّهرَ سَيْفٌ غير مغْمُودِ",47,"د",1,0],["لا تَحْمَدُوني أن جَوَّدْتُ مَدْحَكُمُ","فإنما قام تَشْييدٌ بِتوطيدِ",48,"د",1,0],["لاَ تَحْسَبُوني لشيء غيْرِ أنفُسِكُمْ","أُغْرَى بتجديدِ مَدْح بعْدَ تَجْدِيدِ",48,"د",1,0],["لا تَحْسَبَنَّ الزمانُ ينسئك ال","قرضَ ولكنه يداً بيدِ",49,"د",1,1],["لا تحرمن امرءاً ساق الرجاءُ به","وقد تَسلّف من جيرانه الحسدا",50,"د",2,0],["لا تحملنَّ هموم أيامٍ على","يومٍ لعلَّك أن تقصِّر عن غدِه",51,"ه",1,1],["لا تحقِرنَّ من الصِّلات قليلةً","تكفي فجودك بالسَّداد سدادُ",52,"د",1,0],["لا تحسبوني غَنيتُ بعدكُمُ","عنكم بشمس الضحى ولا القمرِ",53,"ر",1,0],["لا تحسبوني أنستُ بعدكمُ","إلى هديل الحمام في الشجرِ",53,"ر",1,0],["لا تحسبوني استرحت بعدكُمُ","إلى نسيم الشَّمال بالسّحرِ",53,"ر",1,0],["لا تحسبوا العين بعدكم سَرَّحت","في مسرحٍ من مسارح النظرِ",53,"ر",1,0],["لا تحمدنّي فما جرى قلمي","إلّا بأشياءَ منك مختَبره",54,"ر",2,0],["لا تُحْدِثنَّ لك الإقالة جُرأةً","فاللَّه من بعد الإقالة قادر",55,"ر",1,0],["لا تَحسبنَّ جداك أسكرني","حتى نسيتك ليس بي سُكرُ",56,"ر",1,0],["لا تحبسن الكأسَ فيما تحبسُ","واشرب معتّقةً تضيءُ وتُقبِسُ",57,"س",1,1],["لا تحسبنّي استَعضْتُ منك لُهى","كَفَّيك إنّي بكم من النُفُس",58,"س",1,0],["لا تَحمدنّي وشعري إن لبست بنا","وإنْ خَضَمْتَ بأشداقٍ وأضراس",59,"س",1,0],["لا تحمدنّ البليغَ في قذعٍ","من عَرك أمتار كل فحّاش",60,"ش",1,0],["لا تَحسبَنَّ الهِجاء يحفلُ بال","رفع ولا خفض خافضٍ خَفضا",61,"ض",2,0],["لا تحسبنِّي للهوى طعمةً","إنِ استجاش الرأي أشياعه",62,"ع",2,0],["لا تحسب الشيخ أبا حفصل","يعيش من أقلامه الصُلَّعِ",63,"ع",1,1],["لا تحسبَنْك خدعتهنَّ بخُدعةٍ","بل أنت ويْحك خادَعَتْك مُناكا",64,"ك",2,0],["لا تحسبِنَّ اللَّه مُطَّرحاً","مَن بِتَّ تَضْحَكُ منه حين بكى",65,"ك",2,0],["لا