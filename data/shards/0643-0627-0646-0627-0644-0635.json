e.com/ViewPoem.aspx?id=50227",""],[4767,"عمري","https://www.poetsgate.com/ViewPoem.aspx?id=87029",""],[4769,"أما لظلام ليلي من صباحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180981",""],[5005,"حُلمٌ في الضّجيج..","https://www.poetsgate.com/ViewPoem.aspx?id=190155",""],[5038,"جرح غريب","https://www.poetsgate.com/ViewPoem.aspx?id=189661",""],[5121,"أنِين","https://www.poetsgate.com/ViewPoem.aspx?id=215600",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[5212,"شموخُ العلم","https://www.poetsgate.com/ViewPoem.aspx?id=212107",""],[5431,"ارتديتُ حدادي","https://www.poetsgate.com/ViewPoem.aspx?id=183044",""],[5447,"راهب من صوت","https://www.poetsgate.com/ViewPoem.aspx?id=208294",""],[402,"يا دار اهلك بالسلامة عادوا","https://www.poetsgate.com/ViewPoem.aspx?id=35471",""],[5842,"حلب 2013 / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137040",""],[5992,"كأنَّ بروقَ الجوّ في حجراتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=41847",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6124,"همس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=128748",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[463,"أما والنقا لولا هوى ظيبة َ النقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60160&r=&rc=216",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["كَأَنَّ الصَريخَ يُهاهي بِهِم","أُسوداً تَهُبُّ مِنَ الغيلِ رُبدا",0,"د",2,0],["كَأَنَّ الصُقورَ اللامِحاتِ تَلَمَّظَت","إِلى الطُعمِ وَاِنصاعَت لَهُنَّ الأَباغِثُ",1,"ث",1,0],["كأنّ الصّافِناتِ الجُردَ فيهم","يُدافُ على قَوائِمِها الجِسادُ",2,"د",1,0],["كأنّ الصّباحَ الطّلْقَ طِفْلٌ مجرَّدٌ","تلقَفَهُ الثُعْبانُ ثمّ تبنّاهُ",3,"ه",1,0],["كَأَنَّ الصَّبَا جَاءَتْ تُخَبِّرُ قُضْبهَا","سُحَيْراً بِأَنَّ الْوَقْتَ ضَاقَ عَنِ الْفَرْضِ",4,"ض",1,0],["كأنّ الصَّبا عنْدَ الهُبوبِ تحيّةٌ","بطَيِّبها تخْتَصُّ أنْدَلُسَ الهِنْدُ",5,"د",1,0],["كأنّ الصّواري على ظهْرِها","طُرِحْنَ مَخافةَ هوْلٍ شَديدْ",6,"د",1,0],["كَأَنَّ الصَباحَ استَقبَسَ الشَمسَ نارَها","فَجاءَ لَهُ مِن مُشتَريهِ شِهابُ",7,"ب",1,0],["كَأَنَّ الصُوارَ إِذ تَجَهَّدَ عَدوُهُ","عَلى جَمَزى خَيلٍ تَجولُ بِأَجلالِ",8,"ل",1,0],["كان الصلاة بمسجد وبغيره","في الحكم واحدة لدى الأسلاف",9,"ف",1,0],["كَأَنَّ الصُبحَ أَبلَقُ ذو حُجولٍ","يَشِبُّ وَراءَ قَنبَلَةٍ وِرادِ",10,"د",1,0],["كَأَنَّ الصُبحَ قَد لَبِسَ الدَياجي","عَلَيكَ أَسىً لِذَلِكَ ما يَبينُ",11,"ن",1,0],["كَأَنَّ الصُلبَ وَالمَتنَينِ مِمهُ","وَإِيّاها إِذا اِجتَهَدا حِضارا",12,"ر",2,0],["كانَ الصبيُّ يَصيدُ","الفَراشَ بَيْنَ الزُّهُورِ",13,"ر",1,0],["كَأَنَّ الصُبحَ يَطرُدُها فَتَجري","مَدامِعُها بِأَربَعَةٍ سِجامِ",14,"م",1,0],["كَأَنَّ الصَبا توفي نُذوراً إِذا اِنبَرَت","تُراوِحُهُ أَذيالَها وَتُباكِرُه",15,"ر",2,0],["كأنَّ الصَّباحَ أسيرٌ نأَى","فليسَ يُفَكُّ ولا يُطلَقُ",16,"ق",1,0],["كَأَنَّ الصُبحَ أَلبَسَها حُجولاً","وَجِنحَ اللَيلِ قَمَّصَها إِهابا",17,"ب",2,0],["كأنّ الصبحَ معترضاً دجاهُ","خصيمٌ يستطيلُ على خصيمِ",18,"م",1,0],["كأنّ الصَّبا قُيّدَتْ خَلْفَهُ","مُقَصّرَةً عن مدى وثبته",19,"ت",2,0],["كَأَنَّ الصُوى فيها إِذا ما اِستَخَلتَها","عَقيرٌ بِمُستَنَّ السِرابِ يَكوعُ",20,"ع",1,0],["كَأَنَّ الصَبا هَبَّت بِأَنفاسِ رَوضَةٍ","لَها كَوكَبٌ في ذَروَةِ الشَمسِ لامِعُ",21,"ع",1,0],["كَأَنَّ الصَبا تُهدي إِلَيها إِذا جَرَت","عَلى تُربِها مِسكاً سَحيقاً وَعَنبَرا",22,"ر",2,0],["كأنّ الصَّبا فيه تُراقِبُ كامِناً","يثُورُ إليها من خِلالِ إكامهِ",23,"م",2,0],["كَأَنَّ الصَبا جاءَت بِريحِ لَطيمَةٍ","مِنَ المِسكِ لا تُسطاعُ بِالثَمَنِ الغالي",24,"ل",2,0],["كأَنَّ الصبا ما أَولع النفس بالصبا","عَلى الماء آلافاً من الماس تنثر",25,"ر",1,0],["كانَ الصديق الَّذي كن","تُ أَصطَفيه عدوا",26,"و",2,0],["كأنّ الصَّبا ألقَتْ إليَّ عِنانَها","تَخُبّ بسَرْجي مَرّةً وتُناقِل",27,"ل",1,0],["كَأَنَّ الصَّبَا تُلْقَى عَلَيْهِ إِذَا جَرَتْ","مَسَائِل فِي الأَرْقَامِ أَوْ تَلْعَبُ النَّرْدَا",28,"د",2,0],["كان الصراحةَ، والأفواهُ مطبقة","كان الوفاء بمصر غادر الذمم",29,"م",1,0],["كان الصُّعودُ إلى السَّماء خُرافةً","كُبْرَى، فَصارَ اليوم غَيرَ مُحالِ",30,"ل",1,0],["كأنّ الصبابات في أفقه","تئنّ فترتعش الأنجم",31,"م",1,0],["كَأنَّ الصُّلْبَ والْمَتْنَيْنِ مِنْهُ","وإيّاها إذا اجتهدا حضارا",32,"ر",2,0],["كأن الصَّبا لما أَثارتْ حَبابه","تُمرُّ على سيفٍ حديدٍ مباردا",33,"د",2,0],["كأن الصبا والشيب يطمس نورهُ","عروسُ أناس مات في ليلة العرس",34,"س",1,0],["كانَ الصِبا زَماناً أَرَقَّ مِنَ الصِبا","وَأَلَذَّ مِن غَفَواتِ عَينِ الساهِرِ",35,"ر",1,0],["كأنّ الصَبا راحت تروّح غصنها","تلاعبها إذ تنثني كالأسنّة",36,"ه",1,0],["كَأَنَّ الصَقرَ يَقلِبُ مُقلَتَيهِ","إِذا نَفَضَ العُيوبَ وَقَد خَفينا",37,"ن",2,0],["كان الصباحُ كأنه في نُورهم","ليلٌ وكانوا فيه صُبحاً زاهِرا",38,"ر",2,0],["كان الصحابة يكبحون جماحه","ويضّيقون طريقها ومجالها",39,"ل",3,0],["كان الصلاح له مع كل مكرمةٍ","وطهر نفسٍ قريناً والتقى خدنا",40,"ن",2,0],["كأن الصَّبا جرّت عليه ذيولَها","أصيلاً وفأرَ المسك عنها تفتَّقا",41,"ق",2,0],["كَأَنَّ الصَباحَ حَبيبٌ لَهُ","إِذا غابَ أَسهَرَهُ مُفكِرا",42,"ر",2,0],["كَأَنَّ الصُدغَ فَوقَ الخَدِّ مِنهُ","بَنَفسَجَةٌ تَعانَقَ جُلَّنارَه",43,"ر",2,0],["كأنَّ الصَّبا قد بشَّرتْني بأوبةٍ","لِمَنْ بانَ عن روضِ الحمى ورجوعِ",44,"ع",1,0],["كانَ الصِّبا وَطَري إِذ كُنتُ في وَطَنِي","فَقَد فُجِعتُ بِأَوطانِي وَأَوطارِي",45,"ر",2,0],["كَأَنَّ الصبحَ أَبلَقُ في حجُولٍ","يَشِبُّ وَيَتَّقي ضَرب الشَكيمِ",46,"م",1,0],["كَأَنَّ الصَبا تَحكي بِها حينَ واجَهَت","نَسيمَ الصَبا مَشيَ العَروسِ إِلى الخِدرِ",47,"ر",1,0],["كَأَنَّ الصَّبَا أَهْدَتْ إِليَّ تَحيَّةً","تُعَرِّفها نَشْراً وتَنْشُرهَا عَرْفا",48,"ف",2,0],["كانَ الصِّبا عاريَّةً فاستُرجِعَت","مِنهُ ودَيناً آن أن يُتَقاضا",49,"ض",2,0],["كَأَنَّ الصَّبا راحَ لَدى الفجرِ إِذ سَرت","بِهِ روحُ زهرِ الرّوض تَحيا وَتبتلُّ",50,"ل",1,0],["كأن الصبا عندي رسول مبلغ","أبوح بأسراري إليه فيكتم",51,"م",1,0],["كأن الصخور الشم شمع مذوب","تطرزها في أبدع النقش إ