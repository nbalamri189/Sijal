ى",77,"ا",1,0],["كأنَّ الصخرَ تغزلهُ الحكايا","فيصعدُ ثمَّ ينصبُ انصبابا",78,"ب",2,0],["كان الصديق مواسيا","مَن بالجراح تألما",79,"م",2,0],["كأن الصبح مهجور طريد","كأن الليل مات صريع راح",80,"ح",1,0],["كأنّ الصمتَ من حولي قبورٌ","بها قرعَ الرجالُ على الطّبولِ",81,"ل",1,0],["كأنَّ الصّدَّ أبْقاهُ غريباً","علامَ يلومني جرْحٌ غريبُ",82,"ب",1,0],["كأَنَّ الصَّوْتَ آهَاتٌ بِنَايٍ","وَقَدْ خُنِقَتْ بِأَنْفَاسِ الذَّبِيحِ",83,"ح",1,1],["كأن الصبا فيها إذا ما تنفست","شفاء النهى أو بغية المتفائل",84,"ل",1,0],["كأنَّ الصِّنوَ موسى والعلومُ عصا","بِكُلِّ الأرضِ عَينُ العِلمِ تَنْفَجِرُ",85,"ر",1,0],["كان الصراخُ الى العروبة موجعا","عبثا رأيت العرب للإنجاد",86,"د",1,0],["كأن الصمت هرطقةٌ بقلبي","وصوتك ذا.. تراتيلٌ حبيسة!",87,"س",2,0],["كان الصفاء به بتم لأهلها","لو لم يشب ذاك الصفاء حدا",88,"د",2,0],["كان الصبور على البلوىº فليس له","غير الرضى حامداً لله ما وهبا",89,"ب",2,0],["كأنَّ الصباحَ صارمٌ سَلَّهُ الدُّجَى","من البرقِ لم تلمَسْهُ أيدي الصياقلِ",90,"ل",1,0],["كانَ الصِّراعُ عَلى البَقاءِ, وَلَم يَكُنْ","غَيرِي إِلى رَهَبُوتِهِ يَتَقَحَّمُ",91,"م",1,0],["كأَنَّ الصوتَ في حلمي","عصافيرٌ تُناديهِ",92,"ي",2,0],["كأن الصخورالصامدات على المدى","إذا الموت داناها تدانت فيُرعَب",93,"ب",1,0],["كان الصَّباحُ مقيماً في أصابعها","وكان قلبي على أشلائه يقفُ",94,"ف",1,1],["كأنَّ الصَّبا جرّتْ عليهِ ذيولها","أصيلاً وفأرَ المسكِ عنها تفنَّقا",95,"ق",2,0],["كأنَّ الصَّخرَ ما كانَ اختيارًا","وما كانَ التحيَّة والسلاما",96,"م",2,0],["كان الصباحُ جميلاً حينما انطَلَقَتْ","ساقايَ نحوَ العُلا يحدوهُما الظَّفَرُ",97,"ر",1,0]]}