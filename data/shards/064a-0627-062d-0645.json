يا حمزة يا أَبا الأَشبال تكنية","لك المكارم ما بين الورى لقب",19,"ب",1,0],["يا حماة الحمى عقدتم لساني","باياد منا لها تقبيل",20,"ل",1,0],["يا حماة الحمى بكم صح جسم ال","عدل والعدل منذ عهد عليل",20,"ل",1,0],["يا حمام العادي إباءً وسطواً","وحياة الجادي سماحاً وجودا",21,"د",2,0],["يا حَمامَ الأَيكِ زِدنِي","من هنيهَاتِ السِّفاهِ",22,"ه",1,1],["يا حماة الدين نصراً فلقد","حارتِ الأقوام عن قصد السَّنن",23,"ن",1,0],["يا حُماة الدين يا أهل الوفا","يا كرام الناس قومُوا غضبا",24,"ب",2,0],["يا حِمى الإقليم يا سي","حان يا طود شمامِ",25,"م",1,0],["يا حميد الفعال ذا المن باللط","ف على خلقه انف عسري وقلي",26,"ل",2,0],["يا حمى الإسلام يابن المرتضى عالي الجناب","علة الإيجاد منكان لعلم الله باب",27,"ب",1,0],["يا حَمَد لي ناهب الحالِ","لي لْسِعد الحظ ياتي بَه",28,"ب",2,1],["يا حُماتي يا نجاتي سادتي","لمتى بالوصل أنت ممطل",29,"ل",1,0],["يا حمليه إلى الثرى أرأيتم","شُمَّ الجبال إلى الرجالم تصير",30,"ر",1,0],["يا حمامَ الأراكِ رِفقاً بصَبٍّ","ذِي فُؤادٍ من الجَوى حَرّانِ",31,"ن",1,0],["يا حمامَ الأراكِ ما لي أرا","كُنَّ تَجَاوَبنَ في ذُرَا الأَفنانِ",31,"ن",1,0],["يا حُماةَ الشَرى","وَشُراةَ الحِمى",32,"ا",1,1],["يا حماة الهدى ظهور العوادي","لا تهنت نواظر بكداها",33,"ا",3,0],["يا حُماةَ القَريضِ هل من بليغٍ","ينظِمُ الدُّرَّ واصفاً ما أعاني",34,"ن",2,0],["يا حمام النيل غَنِّ","مطرباً حُلوَ النشيد",35,"د",1,0],["يا حماة الديار هبوا جميعا","قد دعاكم إلى الوغى داعيان",36,"ن",1,0],["يا حمام الأيك غن لنا","إننا بالشوق ندمان",37,"ن",1,0],["يا حَمامَ الأَيْكِ هل عَلِقَت","بك من بَلْواه أَشْطانُ",38,"ن",1,0],["يا حُماةَ القَريضِ وَالعَصر نورٌ","أَسَمِعتُم ما قالَهُ القُدَماءُ",39,"ا",2,0],["يا حُماةَ القَريضِ في الخَمرِ نارٌ","جَمرُها فيهِ تَنضُجُ الأَحشاءُ",39,"ا",2,0],["يا حُماةَ القَريضِ في الخَمرِ سُمٌ","يَتَعاطاهُ بَينَكُم أَشقِياءُ",39,"ا",2,0],["يا حَمزُ للحَربِ يُذكيها بِمُنصَلِتٍ","في كَفِّهِ كَشهابِ الرَجمِ مُضطَرِمِ",40,"م",1,0],["يا حَمزُ قَرَّت قُلوبٌ كُنتَ مُرجِفها","مِن طائِرٍ حينَ تَلقاهُ وَمُختَرَمِ",40,"م",1,0],["يا حَمَد إنسان لِعيونِ","يِعْتِرِض لِيْ يَوْم بآصَلّي",41,"ل",2,0