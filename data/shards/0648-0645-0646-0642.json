ه","https://www.aldiwan.net/poem47368.html","الطويل"],[549,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[549,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[549,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[549,"إذا كنت أزمعت الرحيل فإننا","https://www.aldiwan.net/poem48106.html","الطويل"],[556,"لقد نظرت قوم بطرف لهم قذي","https://www.aldiwan.net/poem33813.html","الطويل"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[556,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[560,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[565,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[573,"تركت حبيب القلب تهمي جفونه","https://www.aldiwan.net/poem2847.html","الطويل"],[573,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[584,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"],[585,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"],[585,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَمِن قَبلَ ما أَردى جُذاماً وَحِميراً","وَأَطرَقَ زَورُ المَوتِ عوجاً وَعَملَقا",0,"ق",2,0],["وَمِن قَبلِ ما أَبلى بِبَدرٍ وَغَيرَها","وَلا مَوقِفٍ إِلّا لَهُ فيهِ مَوقِفُ",1,"ف",1,0],["وَمِن قَبلِ أَن يَسدي المُعادونَ بَينَنا","بُرودَ الخَنا ما شِئتَ في الطولِ وَالعَرضِ",2,"ض",1,0],["وَمَن قَيَّدَ الأَلفاظِ عِندَ نِزاعِها","بِقَيدِ النُهى أَغنَتهُ عَن طَلَبِ العُذرِ",3,"ر",1,0],["وَمِن قَبلُ ما كانَت تَقَلقَلُ خيفَةً","وَتَرقُبُ في الأَيّامِ وَهصَةَ كاسِرِ",4,"ر",1,0],["وَمَن قَمَرَ الدَهرُ أَموالَهُ","قَضى جَدُّهُ أَن يَرُدَّ القِمارا",5,"ر",2,0],["وَمَن قالَ إِنَّ جَميعَ الفَخارِ","لِغَيرِ ذَوائِبِ قَومي كَذَب",6,"ب",1,0],["وَمَن قَلقَلَ البَينُ أَطنابَهُ","وَنالَ أَقاصي المُنى بِالطَلَب",7,"ب",1,0],["ومَنْ قالَ حتّى ردَّ ذا النُّطْقِ مُفْحَماً","ومَنْ صالَ حتى غادرَ القِرْنَ مُحْرَضا",8,"ض",2,0],["وَمَن قالَ إِنّي سَيِّدٌ وَاِبنُ سَيِّدٍ","فَسَيفي وَهَذا الرُمحُ عَمّي وَخالِيا",9,"ي",2,0],["وَمَن قادَني لِلمَوتِ حَتّى إِذا صَفَت","مَشارِبُهُ السُمَّ الزُعافَ سَقاني",10,"ي",1,0],["ومَنْ قوْلُهُ فصْلٌ ومَنْ فصْلُهُ هُدىً","ومَنْ مُلْكُهُ رُشْدٌ بهِ أذْهَبَ الغَيّا",11,"ي",2,0],["وَمَنْ قَاسَ مِنْكَ الْجُودَ بِالْبَحْر وَالْحَيَا","فَقَدْ قَاسَ تَمْوِيهاً قِيَاسَ سُفْسَطَانِي",12,"ي",1,0],["ومنْ قمَرٍ سعْدٍ عشَوْتُ لنورِهِ","فسعّرَ أحْشائي وصعّدَ أنْفاسي",13,"س",2,0],["وَمَن قَبلُ ما قَدَّمتَ مَثنى نَوافِلٍ","يُلاقي بِها مَن صامَ مِن عَوَزٍ فِطرُ",14,"ر",1,0],["وَمنْ قَلْبُهُ الدَّاءُ الَّذِي هُوَ يَشْتَكِي","فَمَاذَا تَدَاوِيهِ وَمَاذَا وَسَائِلُهْ",15,"ل",2,0],["وَمِن قَبلُ موسى كَم بَدَت مِنهُ آيَةٌ","فَأَمسى يُعاني السُمَّ وَهوَ سَجينُ",16,"ن",1,0],["ومن قبل ما طوقتني كَلَّ نعمةٍ","كأني وإياها سِوَارٌ ومعصمُ",17,"م",1,0],["ومن قطع قد اجتمعت كباراً","فكانت كالقطيع من المواشي",18,"ي",1,0],["ومن قال حقاً قاله عن بديهة","ويحتاج للتفكير مّن مّوَّه الخُلفا",19,"ف",2,0],["وَمَنقوشَةٍ نَقشَ الدَنانيرِ عولِيَت","عَلى عَجَلٍ فَوقَ العِتاقِ العَياهِمِ",20,"م",1,0],["وَمِن قَيسٍ سَما بِكَ فَرعُ نَبعٍ","عَلى عَلياءَ خالِدَةِ الأَرومِ",21,"م",1,0],["وَمِن قَبلِهِ أَعيا أَباهُ فَلَم يَزَل","بِهِ التيهُ حَتّى ماتَ وَهوَ مُعَيَّلُ",22,"ل",1,0],["ومن قطع الأطماع من كلّ حاسدٍ","لقد زدت حتَّى ما يكون محسدا",23,"د",2,0],["ومَنْ قَبِلتُمْ فَمَقْبُولٌ لكمْ أبداً","ومنْ أبَيْتُمْ فَبِلْوٌ غَيْرُ معهودِ",24,"د",1,0],["ومن قبل ذلك ما راعهُمْ","سوادُ خِضاب أبي الأسودِ",25,"د",1,0],["ومن قبلتْ من الليالي فداءه","فحُقَّ بأن يَلْقيْنَهُ وهو حامدُ",26,"د",1,0],["ومن قبيحِ القبيح عندي","بظرٌ طويلٌ على قصيره",27,"ر",2,0],["ومَنْ قامَسَ الحوتَ الملجِّج مرةً","ليقمِسَه فالحوت لا شك قامسه",28,"س",2,0],["ومن قبل العبارة ما لقيتُم","بمعنىً فيه مصلحةُ الأنامِ",29,"م",1,0],["وَمِن قَومٍ مَساتيرِ","وَمِن قَومٍ مَساخيرِ",30,"ر",1,0],["ومنقلب النجوم إلى سكون","من الدوران يطويهن طيا",31,"ي",2,0],["ومن قطع الحياة صدى وجوعا","ومن مرت به شبعا وريا",31,"ي",2,0],["ومن قلبي وحبته","كِاس بات يهدمه",32,"م",2,0],["وَمِن قَلبي وَحَبَّتِهِ","كِناسٌ باتَ يَهدِمُهُ",33,"م",2,0],["وَمِن قَبلِ النِطاحِ وَقَبلَ ياني","تَبينُ لَكَ النِعاجُ مِنَ الكِباشِ",34,"ش",1,0],["وَمِن قَولِ سامٍ لَو رَآكَ لِنَسلِهِ","فِدى اِبنِ أَخي نَسلي وَنَفسي وَمالِيا",35,"ي",2,0],["ومن قيّم الأمر لا تذهلن عني","فأصل الفساد الذهولُ",36,"ل",1,0],["ومنقوبةُ البطنِ في جوفِهَا","كُراتٌ من الذهبِ الأحمرِ",37,"ر",1,0],["وَمِن قَبلُ ما جَرَّبتُ أَنباءَ جَمَّةً","وَلا يَعرِفُ الأَنباءَ إِلّا المُجَرِّبُ",38,"ب",1,0],["وَمِن قَصضي لِرَأسِ العَينِ أَسعى","إِلى حَظِرٍ بِعَقوَتِها زَهيدِ",39,"د",1,0],["وَمَن قَد حَوى مَجداً طَريفاً وَتالِداً","وَسامى نُجومَ الأُفقِ حينَ تَرَفَّعا",40,"ع",2,0],["وَمِن قُبَلٍ قَبلَ التَشاكي وَبَعدَهُ","نَكادُ لَها مِن شِدَّةِ الوَجدِ نَشرَقُ",41,"ق",1,0],["وَمِن قَبلِها حَنَّت عَجوزُكَ حِنَّةً","وَأُختُكَ لِلأَدنى حَنينَ النَوائِحِ",42,"ح",1,0],["وَمِن قَعنَبٍ هَيهاتَ ما حَلَّ قَعنَبٌ","بَني الخَطَفى بِالمَنزِلِ المُتَباعِدِ",43,"د",1,0],["وَمِن قَبلِها عُذتُم بِأَسيافِ مازِنٍ","غَداةَ كَسَوا شَيبانَ عَضباً مُهَنَّدا",44,"د",2,0],["وَمِن قَبلُ ماتَ الأَقرَعانِ وَحاجِبٌ","وَعَمرٌ وَماتَ المَرءُ قَيسُ اِبنُ عاصِمِ",45,"م",1,0],["ومن قصورٍ عليه مُشرفَةٍ","تُضيءُ والليلُ أسودُ الحُجُبِ",46,"ب",1,0],["وَمَن قَلَّت مَطامِعُهُ تَغَطّى","مِنَ الدُنيا بِأَثوابِ الأَمانِ",47,"ن",1,0],["وَمَن قَتَلتُم عَلى ما كانَ مِن عَجَبٍ","مِنّا فَقَد صادَفوا خَيراً وَقَد سَعِدوا",48,"د",3,0],["وَمُنقَضٍ ما تَراهُ العَينُ مُنقَطِعٌ","ما كُلُّ شَيءٍ يُرى إِلّا لِيَنقَضِيا",49,"ي",2,0],["وَمَن قَلبُهُ مَعَ غَيرِهِ كَيفَ حالُهُ","وَمَن سِرُّهُ في جَفنِهِ كَيفَ يُكتَمُ",50,"م",1,0],["ومُنقَطِعٍ بالسّبْقِ من كلّ حلبةٍ","فَتَحسَبُهُ يَجري إِلى الرَّهنِ مُفْرَدا",51,"د",2,1],["ومن قَسْوَرٍ شائِكِ البُرْثُنَينِ","له لِبْدَةٌ سُرِدَتْ من حديدِ",52,"د",1,0],["وَمَن قامَرَ الأَيّامَ عَن ثَمراتِها","فَأَحجِ بِها أَن تَنجَلي وَلَها القَمرُ",53,"ر",1,0],["وَمَن قَد عَصَيتُ الناسَ فيهِ جَماعَةً","وَصَرَّمتُ خِلّاني بِهِ وَجَفانِيا",54,"ي",2,0],["وَمَن قَد رَماهُ الناسُ بي فَاِتَّقاهُمُ","بِهَجرِيَ إِلّا ما تُجَنُّ ضَمائِرُه",55,"ر",2,0],["وَمِن قَبّل الحَجَرَ الأَسوَدا","وَظَلّله الرُكنُ لَمّا اِستَلَم",56,"م",1,0],["وَمَنْ قَتَلَ الفَرَنْجَ أشَدَّ قَتْلِ","وَمَنْ أَسَرَ الفَرَنْسِيس اللَّعِينا",57,"ن",2,0],["ومن قنا أكرهوا أسنتها","حتى تشكت إلى عواملها",58,"ل",3,0],["وَمَن قَد كُنتُ أَرعاهُ","وَإِن مَلَّ وَإِن صَدّا",59,"د",2,0],["وَمِن قَولِكَ آتيكَ","إِذا صُلِّيَتِ الظُهرُ",60,"ر",1,0],["وَمِن قَوارِعَ قَد أَخرَستَ ناطِقَها","يَحمِلنَ مِن مُخطَفاتِ القَومِ أَوساقا",61,"ق",2,0],["وَمِن قَلائِدَ قَد قَلَّدتَ باقِيَها","مِن أَهلِ فَنِّكَ أَجياداً وَأَعلاقا",61,"ق",2,0],["وَمَن قَد كانَ لي أَطوَ","عَ مِن طَيرِ سُلَيمانِ",62,"ن",1,0],["وَمِن قَبلُ نادى الوَكرُ أَينَ اِبنُ أَجدَلٍ","أَواني وَقالَ الغابُ أَينَ الخَوادِرُ",63,"ر",1,0],["وَمِن قَبلِهِ ما قَد رُزِئتُ بِوَحوَحٍ","وَكانَ اِبنَ أُمّي والخَليلَ المُصافِيا",64,"ي",2,0],["ومَن قامَ في الأَوْهامِ مِن غيرِ رُؤيةٍ","بأثبتَ مِن إدراكِ كُلِّ عِيانِ",65,"ن",1,0],["ومن قائل بل ربنا اللَه قوة","سرى فعلها في جسم كل الخلائق",66,"ق",1,0],["ومن قائل ما اللَه جسما وقوة","بل اللَه شيء فوق كل الخوارق",66,"ق",1,0],["ومن قبل النطاح وقبل يأتي","تبين لك النعاج من الكباش",67,"ش",1,0],["ومن قُوىً مشبوبة كاللظى","عارمة لا تنثني لا تلينْ",68,"ن",1,0],["وَمَن قَطَعَ الحَياةَ صَدّاً وَجوعاً","وَمَن مَرَّت بِهِ شِبَعاً وَرِيّا",69,"ي",2,0],["ومن قضى بعد غنى فقيرا","لم يجدوا في بيته نقيرا",70,"ر",2,0],["ومن قناه كل يوم في ظفرْ","وخيلهُ من سفرٍ الى سفر",71,"ر",1,0],["وَمَن قادَني لِلمَوتِ حَتّى إِذا صَفَت","مَشارِبُهُ سُمَّ الزُعافِ سَقاني",72,"ن",2,0],["ومَنْ قَبِلَ الظُّلْمَ فهْوَ الملومُ","وليس المَلامُ على من ظَلَمْ",73,"م",1,0],["ومن قوله فصل ومن فعله هدى","ومن ملكه رشد به أذهب الغيا",74,"ي",2,0],["ومُنقضٍ ما تراهُ العينُ منقطِعٍ","ما كُلُّ شيءٍ بدَا إلا لينقضِيَا",75,"ي",2,0],["ومن قبل كانوا إن أرادوا انتقاصةً","من الشِعر قالوا عنه لم يتعرَّق",76,"ق",1,0],["ومن قوافٍ بذَوْبِ الدَّمْع نشأتُها","ومن قصيدٍ لفرطِ الحُزْنِ منسوب",77,"ب",1,0],["ومن قضت الرجال له حقوقاً","ومن يعص الرجال فما أصابا",78,"ب",2,0],["ومن قصدي لرأس العين أسعى","إلى حظر بعقوتها زهيد",79,"د",1,0],["ومن قبل ما جربت أبناء جمة","ولا يعرف الأنباء إلا المجرب",80,"ب",1,0],["ومن قبلتْ منه الليالي فداءه","فحُقُّ بأن يَلْقيْنَهُ وهو حامدٌ",81,"د",1,0],["ومن قامَ للإسلامِ مثلَ مقامِهِ","يَكُن شُكرُهُ فرضاً وأمداحهُ ذِكرا",82,"ر",2,0],["وَمِن قَبلُ عاداكُم لِقَهرِكُمُ لَهُ","فَلَمّا رَآها فُرصَةً ما تَمَهَّلا",83,"ل",2,0],["وَمَن قَدَّمَتهُ نَفسُهُ وَإِباؤُهُ","وَهِمَّتُهُ عَلى الأَنامِ تَقَدَّما",84,"م",2,0],["وَمَن قَصَدَ المَحبوبَ لَم يَسألِ البُقيا","فَيا رَبَّنا في أَرضِهِ وَسَمائِهِ",85,"ه",1,0],["وَمِن قَبلِ وَحيٍ قَد هُدى لِرَشادِهِ","فَشاهَدَ مَولاهُ بِنورِ فُؤادِهِ",86,"ه",1,0],["وَمُنقِذُهُم بَعدَ التَعَرُّضِ لِلبَطشِ","بإِنقاذِهِ يَنجو مِنَ الهُلكِ مَن نَجا",87,"ج",2,0],["وَمَن قَدَّمَ المَحبوبَ أَيقَن بِالنُجحِ","يَداهُ هُما الحَدّانِ لِلبأسِ وَالنَدى",88,"د",2,0],["ومن قبل هذا ما شككت بأصلها","فقمت توالي نية إثر نية",89,"ه",1,0],["ومن قال في الأصنام مجلى إلهه","وعابدها ممن إلى الحق ينسب",90,"ب",1,0],["ومن قال لا قال الألوهة جعلنا","فمن يرتضى ربا فذاك المربب",90,"ب",1,0],["ومن قال قولا غير هذا فإنه","ينافق في الله الأعادي ويخنب",90,"ب",1,0],["وَمِن قَبلُ ما نادَيتُ في حَيِّ عامِرٍ","وَكُنتُ لِداعِيهِم إِذا الأَمرُ أَغفَلا",91,"ل",2,0],["وَمِن قَبلُ كَم أَولاهُما مِن صَنيعَةٍ","وَنُعمى تَفُوتُ الشُكرَ لَو شَكَراها",92,"ا",3,0],["وَمِن قَتَلاهُمُ قَطَنٌ وَمِنهُم","غَنِىٌّ فِى كُماةٍ مُقعَصِينَا",93,"ن",2,0],["وَمَن قلّدَ الشيطانَ في أمر دينهِ","يَنالُ بهِ مِن دينهِ الخزيَ والخُسرا",94,"ر",2,0],["وَمَن قالَ سفلٌ كلُّها فهوَ صادقٌ","فَليسَ لهُم رَبٌّ على هذه يُدرى",94,"ر",2,0],["وَمن قبرهِ خيرِ القبورِ أمدّهم","بِنورٍ وطيبٍ أَخجَلا الزهر والزهرا",95,"ر",2,0],["وَمِن قبلِ هذا ما سَمِعنا بأمّةٍ","قَدِ اِستَحسنَته هكَذا علناً جهرا",95,"ر",2,0],["وَمِن قَبلُ آمَنّا وَقَد كانَ قَومُنا","يُصَلّونَ لِلأَوثانِ قَبلَ مُحَمَّدا",96,"د",2,1],["ومن قال عَنّا من الناظِرين","نديما جَذيمةَ لا يَكذِب",97,"ب",1,0],["ومن قاس بَدْرَ التّمّ عند كمالِه","بنجم السها يَضْلِلْ قياساً ويَزْهَقِ",98,"ق",1,0],["ومِن قائل تجري بسَعْدٍ وَأَنْحُسٍ","وتَعْلَمُ ما يأتي من الخير والشر",99,"ر",1,0],["ومن قال إن الله جلّ بذاته","بكل مكانٍ جاهلٌ متسرع",100,"ع",1,0],["ومن قال إثبات الصفات شناعة","فجرأته إذ عارض النصّ أشنع",100,"ع",1,0],["وَمَن قيمَةُ الكَلبِ أَغلى وَقَد","أَثِمتُ مَعَ الكَلبِ مِن قيمَتِه",101,"ت",2,0],["وَمِنْ قبْلِ ذَا قد كُنتُ إذ كُنتَ ذاكِراً","نَهَيْتُكَ أنْ تَلْقَى الأَميرَ مُقَطِّبَا",102,"ب",2,0],["وَمِنْ قَوْلٍ بِلاَ فِعْلٍ","وَفِعْلٍ رَبُّهُ يُخْزِي",103,"ز",2,0],["ومن قبل لم تنقم على الترك غدرهم","وقد أوشكوا أن يستباحوا وينكبوا",104,"ب",3,0],["ومن قومه العجمان فالغدر خلقه","غذي دره حتى غدا وهو أشيب",105,"ب",1,0],["ومن قاس قسا في فصاحته به","فمن باقل بالعي أولى وأولع",106,"ع",1,0],["ومن قَصفاتِ الرّعدِ والبرقُ لامعٌ","ومن بَردِ أنفاس النّسيم المهينم",107,"م",1,0],["ومن قصبِ الرّاعي المرنّ نواحُهُ","على ضفتي واد مُنيرٍ ومُظلِم",107,"م",1,0],["ومن قومهِ الصُّهبِ العَثانينِ زُمرَةٌ","حواليهِ كانت منهُ أطغى وأفجرا",108,"ر",2,0],["وَمن قومه قوم الى اللَه هاجَروا","وَخلوا مَغاني دورهم وَتغربوا",109,"ب",3,0],["وَمن قومه في البئر سَبعون سيدا","قَتيلا وَمثل الهالِكين أَسير",110,"ر",1,0],["وَمَن قاسَ بِاللَّيْثِ الكَبيرِ أُضَيْبِعا","فَسَوفَ يُريهِ الشّبْل مَا صارَ فِي الفَهْدِ",111,"د",1,0],["وَمِنْ قَبْل ما اسْتَسقَتْكَ أنْدَلُسٌ فَلَمْ","تَجِدْ جُودَك الفَيَّاضَ غَيْضاً ولا بَرْضَا",112,"ض",2,0],["ومُنْقِذ عَانٍ في الأَداهِمِ راسِفٍ","يَنُوءُ بِرِجْلَيْ راسِفٍ في الأداهِمِ",113,"م",1,0],["ومن قبولُ ثنائي","إليه أسنى هباته",114,"ت",2,0],["ومن قضى الله في أرض منيَّته","ينخْ بها راضياً أوكارها شنفا",115,"ف",2,0],["وَمِن قَبلُ أَوصى اللَهُ بِالجارِ جارَهُ","وَإِنّي إِلَيهِ أَشتَكي جَورَ جيراني",116,"ي",1,0],["وَمِن قَبلِهِ ما رَأى الناسُ في","غُصونٍ مِنَ البانِ تَبدو بُدورُ",117,"ر",1,0],["وَمِن قَبلُ ما لَجَّ المحبُّون في الهَوى","وَما جَهِلوا أَنَّ الهوى مركبٌ وَعرُ",118,"ر",1,0],["ومَنْ قَصَّرَتْ عَنهُ البِحَارُ تَأخّرَتْ","خُطى الغَيْثِ عَنهُ شَاءَ ذلكَ أَو أبَى",119,"ب",2,0],["وَمَن قَطَعَ الأَميالَ في حُبِّ عُلوَةٍ","تَناهى إِلى ميقاتِ أَهلِ المَحَبَّةِ",120,"ه",1,0],["وَمَن قَضى شَرخَ شَبابٍ عَلى","غَيرِ هَواهُ فاتَهُ الشَرخُ",121,"خ",1,0],["وَمَن قَد حَباه اللَه نورَ بَصيرة","يَكاد بِها يَدري بِما كتم السرُّ",122,"ر",1,0],["وَمِن قَيسٍ الثاوي بِرَمّانَ بَيتُهُ","وَيَومَ حَقيلٍ فادَ آخَرُ مُعجِبُ",123,"ب",1,0],["وَمِن قَلَمٍ يَسعى إِلَيكَ بِرَأسِهِ","فَيَقضي مِنَ المَفروضِ ما هُوَ لازِمي",124,"م",2,0],["ومن قَبلُ لمّا جاء جَيّاً بعَزْمةٍ","تُزعزِعُ أعطافَ المُطَهّمَةِ الجُرد",125,"د",1,0],["وَمِن قَبلِهِ كُنّا نُرَجّيهِ لِلمُنى","فَأَمّا لِتَحبيرِ الثَناءِ فَمِن بَعدِ",126,"د",1,0],["ومن قبلُ قد شانت مقام رسولها","فكم صدَّقت رسلاً وكم كذَّبت رسلا",127,"ل",2,0],["ومن قد علا فوق الطبيعة نفسِها","ملائكة الرحمن تُضحي تُلائمه",128,"م",2,0],["ومن قال هذا فهو فَدْمٌ مُغفلُ","جسور على قول الجهالة مُجْترى",129,"ر",2,0],["ومن قال فعل العبد كسب فقد نجا","وإن كان هذا الكسب في بطن خفية",130,"ه",1,0],["ومن قصر الرأي أن الفتى","يشيدُ القصورَ لعمرٍ قصير",131,"ر",1,0],["وَمِن قبل أَن يَجري هَواهُ وَإِلفه","بِقَلبي جَريَ الماء في الغُصُنِ النَضرِ",132,"ر",1,0],["ومن قالَ تعليلاً لعلَّ وربَّما","فماذا عسى تغني لهلَّ وربَّما",133,"م",2,0],["ومن قد سمت أركان كعبتنا به","جديرٌ بأن يأوي الحجيج لبابه",134,"ه",1,0],["ومن قول الشجيّ سألت ربعاً","خلا ممَّن أُحبّ فما أجابا",135,"ب",2,0],["ومَن قرأ العلوم عليه أضحى","كنتَسِبٍ الى عبدِ المَدانِ",136,"ن",1,0],["ومن قبلُ مَا أَوْسَعْتَها صَدْرَ صافِحٍ","ونفساً يَلَذُّ المِسْكَ أَنفاسُها شَمَّا",137,"م",2,0],["ومِن قَبْلُ أَحفى الرُّسْلَ نحوَكَ ضارِعاً","عَلَى حينَ أَنْ عَزَّتْ لديكَ مطالبُهْ",138,"ب",2,0],["ومن قَصْفٍ وراحٍ قَصْفَ رِيحٍ","ومن لَعِبِ الهَوى لَعِبَ الهواءِ",139,"ا",2,0],["ومِنْ قِصَر اللَّيلِ تَحْتَ الحِجال","بِهَوْلِ السُّرى تَحْتَ ليلٍ طويلِ",140,"ل",1,0],["ومن قد جرى الماء المعين بكفه","متى تأته الصادون في الفر تشرب",141,"ب",1,0],["ومن قاسى شغوب الده","ر لم يرغب إلى شغب",142,"ب",1,0],["ومن قال عند النابرات مشمرا","أَيا لفلان يا القبائل اقبلوا",143,"ل",3,0],["ومن قال ان المصطفى هو ساحر","ومن عجم أَو شاعر وهو مقول",143,"ل",1,0],["ومن قلبٍ وفيٍ لا يداجِي","ومن حُبٍّ صفيٍّ لا يُرائي",144,"ا",2,0],["ومن قِرَى أضيافه أن تُنْحَرَ ال","بُدورُ حين تَنْحَرون الإبلا",145,"ل",2,0],["ومِن قَودِها لي في الصِّلاب ثنيّةً","وبزلاءَ تعصِي في القيادِ وتُصحِبُ",146,"ب",1,0],["ومن قبلها قصَّرت عني يد الرَّدى","وأنت بأخرى والسَّلام جديرُها",147,"ر",3,0],["ومن قتل النفس المحرّم قتلها","بعمد فقبّحه لعينا مدحرا",148,"ر",2,0],["ومن قبلِ خوضِ حشا غارةٍ","وشقِكَ ملمومةً من زرد",149,"د",1,0],["ومن قال إن الدهر تسمح نفسه","مثلك فهو المائن الكاذب الزعم",150,"م",1,0],["ومن قصد البدر ألغى السهى","ومن حاول البحر عاف الوشل",151,"ل",1,0],["ومن قال في الدنيا لفضلك مشبهٌ","فقولتهُ في شرع كل نهى قذف",152,"ف",1,0],["وَمَن قَد رَماهُ الناسُ بي فَاِتَّقاهُمُ","بِبَغضِيَ إِلّا ما تَجِنُّ ضَمائِرُه",153,"ر",2,0],["وَمَن قَدَّرتُ أَنَّ لَهُ نَظيراً","فَحينَ طَلَبتُ أَعوَزَني النَظيرُ",154,"ر",1,0],["ومن قاصية السند","إلى أقصى خراسان",155,"ن",1,0],["ومَنْ قادَ للأَغْيارِ فاهْجُرْ سَبيلَهُ","ووافِقْ مُحِبَّ اللهِ إنْ قلَّ أَو جَلاَّ",156,"ل",2,0],["ومن قائِلٍ فَرْطُ الهَوى قد أضَرَّني","وهل للهَوى في زَعمِ أصحابِهِ فَرطُ",157,"ط",1,0],["ومن قبل جمجوماً وزيراً وعبدَ قا","درٍ وفؤاداً ..هم نجوم سماها",158,"ا",3,0],["ومن قد خالفَ السّلف اتبداعاً","أتنفعه الصّلاة أَو الصِّيام",159,"م",1,0],["ومَنْ قَدَّمَ التّالي فذلِكَ مَهْيَعٌ","لَهُ مَنْهَجُ القانُونِ مِنْ نَحْوِنا يَحْوي",160,"و",2,0],["وَمَنْ قَصُرَتْ يَداهُ عَنْ مَساعٍ","سَعَى نَحْوَ الأكابِرِ للسُّؤالِ",161,"ل",1,0],["ومن قَصَّرَتْ عَنْ مَدَاهُ الشُّيوخُ","وَمَا أَنْبَتَ العارِضانِ الْعِذارا",162,"ر",2,0],["ومَنْ قَالَ ما جازَ اجْتِماعٌ بِمَسْجِدٍ","لِذِكْرٍ فَقُلْ هاتِ الدَّليلَ المشَيّدا",163,"د",2,0],["ومَنْ قَوْلُه قَدْ صَحَّ في غَيْرِ دفتر","وقام إليه في الموطن مرشدا",163,"د",2,0],["وَمَنْ قَالَ هذَا الشُّهْدُ مُرٌّ فَقُلْ لَهُ","مَرَارَةُ فِيكَ الْمُرِّمَرِّ بِها الشُّهْدُ",164,"د",1,0],["ومِن قامةٍ تختالُ تزهُو كأنما","بأعطافِها في روضِها ماسَتِ القُضبُ",165,"ب",1,0],["ومِن قِبَلِ الهوادِج يومَ بانوا","رُمِينا بالمحاسنِ إذْ رُمِينا",166,"ن",2,0],["وَمَن قَطع الزمانَ وفي يَديهِ","مَقادَةُ ذَلك الجيش اللهامِ",167,"م",1,0],["ومَن قوله يومَ الخصومةِ فيكمُ","يبرِّحُ بالخصمِ الألدِّ المماحِكِ",168,"ك",1,0],["ومِن قلّةِ الإنصافِ عيشيَ بعده","وفي الكفّ منّي لو أردتُ لُحوقهُ",169,"ق",2,0],["ومن قبل أنْ أُدْلى بملساءَ قفْرَةٍ","إلى جَدَثٍ ضَنْكِ الجوانب أغبرِ",170,"ر",1,0],["وَمَنْ قرّبته دارُ وُدٍّ مُصَحّحٍ","إليَّ فلا كان المقرّبُ مولِدا",171,"د",2,0],["وَمن قبلُ شَاقَتنِي وَنَحنُ عَلى مِنى","حمائمُ من فرعِ الأراكِ صوادحُ",172,"ح",1,0],["وَمَن قالَ إِنّ البينَ يُسلي عَنِ الهَوى","جَهول بِأَسبابِ الغَرامِ كَذوبُ",173,"ب",1,0],["ومن قبل خلق الخلق والعرش قد كنّا","سحاب غيوب الذات تمطر ماءَنا",174,"ا",1,0],["ومن قد أتى رحمة للورى","وعنا به قد أزيلت نقم",175,"م",1,0],["ومن قولي أنا أملي","وإني فوق ما أملي",176,"ي",1,0],["ومن قَصَدَ الرِّضَى للنَّاسِ طُرّاً","كمنْ في الدَّهرِ يُطمِعُهُ الخُلودُ",177,"د",1,0],["وَمَن قامَ في الإِسراءِ وَالحَشرِ خَلفَهُ","نَبيّو إِلَهِ الحَقِّ كُلُّهُمُ صَفّا",178,"ف",2,0],["ومن قَبْلِها أَمَرَ المُنْبِؤنَ","بِرَدَّ الأُمُورِ إلى الأوْصِيَاءِ",179,"ا",2,0],["ومن قَبْلِ أَن يستخلصَ القلبُ في الهوى","رهونِي ويُوفِيني الغرامُ دُيونِي",180,"ي",1,0],["ومِنْ قال إِنّ الخيزرانةَ قَدَّها","فقولوا لَه إِيَّاك أَنْ يَسْمَع القَدُّ",181,"د",1,0],["وَمِنْ قُدودٍ إذا انْثَنَتْ هَيَفاً","أَفْردَهَا الحسنُ في تَثنِّيها",182,"ي",3,0],["ومن قبل كانوا في الجهالة والردى","حيارى سكارى قد عثوا في المفاسد",183,"د",1,0],["ومن قال هذا بالنبي مخصص","فقول بعيد الرشد غير مسدد",184,"د",1,0],["ومن قال لا إصداق إلاَّ على الذي","يقدر من مال فليس يجيد",184,"د",1,0]]}