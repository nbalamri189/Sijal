صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[49,"إن السلامة أن ترضى بما قضيا","https://www.aldiwan.net/poem63202.html","البسيط"],[66,"أصدا وسخطا كيف يحكم","https://www.aldiwan.net/poem40108.html","الطويل"],[80,"ومنقطع بالسبق من كل حلبة","https://www.aldiwan.net/poem31484.html","الطويل"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[33,"بنفسي من لا بد لي أن أهاجره","https://www.aldiwan.net/poem25922.html","الطويل"],[102,"بِلاد الحِجاز إِليك هفا","https://www.aldiwan.net/poem32905.html","المتقارب"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[48,"أيا من كنت بالبصرة","https://www.aldiwan.net/poem62609.html","الهزج"],[48,"أيا من طرفه سحر","https://www.aldiwan.net/poem63339.html","الهزج"],[48,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[48,"ألا قولا لحمدان","https://www.aldiwan.net/poem66129.html","الهزج"],[46,"حوتنا شرور لا صلاح لمثلها","https://www.aldiwan.net/poem22526.html","الطويل"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[76,"أما والذي سوى السماء مكانها","https://www.aldiwan.net/poem38874.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85820","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140940",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19247","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[49,"إنّ السّلامَة َ أنْ نَرْضَى بمَا قُضِيَا،","https://www.poetsgate.com/ViewPoem.aspx?id=2742",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[57,"ومن هاب الرجال تهيبه","https://www.poetsgate.com/ViewPoem.aspx?id=3234",""],[45,"ألما يكف في طللي زرود","https://www.poetsgate.com/ViewPoem.aspx?id=31622",""],[45,"ألم تعلمي يا علو أني معذب","https://www.poetsgate.com/ViewPoem.aspx?id=31414",""],[51,"تعجَّل مولودٌ ليُمْهَل والدُ","https://www.poetsgate.com/ViewPoem.aspx?id=28595",""]],"verses":[["وَمِن قَبلَ ما أَردى جُذاماً وَحِميراً","وَأَطرَقَ زَورُ المَوتِ عوجاً وَعَملَقا",0,"ق",2,0],["وَمِن قَبلِ ما أَبلى بِبَدرٍ وَغَيرَها","وَلا مَوقِفٍ إِلّا لَهُ فيهِ مَوقِفُ",1,"ف",1,0],["وَمِن قَبلِ أَن يَسدي المُعادونَ بَينَنا","بُرودَ الخَنا ما شِئتَ في الطولِ وَالعَرضِ",2,"ض",1,0],["وَمَن قَيَّدَ الأَلفاظِ عِندَ نِزاعِها","بِقَيدِ النُهى أَغنَتهُ عَن طَلَبِ العُذرِ",3,"ر",1,0],["وَمِن قَبلُ ما كانَت تَقَلقَلُ خيفَةً","وَتَرقُبُ في الأَيّامِ وَهصَةَ كاسِرِ",4,"ر",1,0],["وَمَن قَمَرَ الدَهرُ أَموالَهُ","قَضى جَدُّهُ أَن يَرُدَّ القِمارا",5,"ر",2,0],["وَمَن قالَ إِنَّ جَميعَ الفَخارِ","لِغَيرِ ذَوائِبِ قَومي كَذَب",6,"ب",1,0],["وَمَن قَلقَلَ البَينُ أَطنابَهُ","وَنالَ أَقاصي المُنى بِالطَلَب",7,"ب",1,0],["ومَنْ قالَ حتّى ردَّ ذا النُّطْقِ مُفْحَماً","ومَنْ صالَ حتى غادرَ القِرْنَ مُحْرَضا",8,"ض",2,0],["وَمَن قالَ إِنّي سَيِّدٌ وَاِبنُ سَيِّدٍ","فَسَيفي وَهَذا الرُمحُ عَمّي وَخالِيا",9,"ي",2,0],["وَمَن قادَني لِلمَوتِ حَتّى إِذا صَفَت","مَشارِبُهُ السُمَّ الزُعافَ سَقاني",10,"ي",1,0],["ومَنْ قوْلُهُ فصْلٌ ومَنْ فصْلُهُ هُدىً","ومَنْ مُلْكُهُ رُشْدٌ بهِ أذْهَبَ الغَيّا",11,"ي",2,0],["وَمَنْ قَاسَ مِنْكَ الْجُودَ بِالْبَحْر وَالْحَيَا","فَقَدْ قَاسَ تَمْوِيهاً قِيَاسَ سُفْسَطَانِي",12,"ي",1,0],["ومنْ قمَرٍ سعْدٍ عشَوْتُ لنورِهِ","فسعّرَ أحْشائي وصعّدَ أنْفاسي",13,"س",2,0],["وَمَن قَبلُ ما قَدَّمتَ مَثنى نَوافِلٍ","يُلاقي بِها مَن صامَ مِن عَوَزٍ فِطرُ",14,"ر",1,0],["وَمنْ قَلْبُهُ الدَّاءُ الَّذِي هُوَ يَشْتَكِي","فَمَاذَا تَدَاوِيهِ وَمَاذَا وَسَائِلُهْ",15,"ل",2,0],["وَمِن قَبلُ موسى كَم بَدَت مِنهُ آيَةٌ","فَأَمسى يُعاني السُمَّ وَهوَ سَجينُ",16,"ن",1,0],["ومن قبل ما طوقتني كَلَّ نعمةٍ","كأني وإياها سِوَارٌ ومعصمُ",17,"م",1,0],["ومن قطع قد اجتمعت كباراً","فكانت كالقطيع من المواشي",18,"ي",1,0],["ومن قال حقاً قاله عن بديهة","ويحتاج للتفكير مّن مّوَّه الخُلفا",19,"ف",2,0],["وَمَنقوشَةٍ نَقشَ الدَنانيرِ عولِيَت","عَلى عَجَلٍ فَوقَ العِتاقِ العَياهِمِ",20,"م",1,0],["وَمِن قَيسٍ سَما بِكَ فَرعُ نَبعٍ","عَلى عَلياءَ خالِدَةِ الأَرومِ",21,"م",1,0],["وَمِن قَبلِهِ أَعيا أَباهُ فَلَم يَزَل","بِهِ التيهُ حَتّى ماتَ وَهوَ مُعَيَّلُ",22,"ل",1,0],["ومن قطع الأطماع من كلّ حاسدٍ","لقد زدت حتَّى ما يكون محسدا",23,"د",2,0],["ومَنْ قَبِلتُمْ فَمَقْبُولٌ لكمْ أبداً","ومنْ أبَيْتُمْ فَبِلْوٌ غَيْرُ معهودِ",24,"د",1,0],["ومن قبل ذلك ما راعهُمْ","سوادُ خِضاب أبي الأسودِ",25,"د",1,0],["ومن قبلتْ من الليالي فداءه","فحُقَّ بأن يَلْقيْنَهُ وهو حامدُ",26,"د",1,0],["ومن قبيحِ القبيح عندي","بظرٌ طويلٌ على قصيره",27,"ر",2,0],["ومَنْ قامَسَ الحوتَ الملجِّج مرةً","ليقمِسَه فالحوت لا شك قامسه",28,"س",2,0],["ومن قبل العبارة ما لقيتُم","بمعنىً فيه مصلحةُ الأنامِ",29,"م",1,0],["وَمِن قَومٍ مَساتيرِ","وَمِن قَومٍ مَساخيرِ",30,"ر",1,0],["ومنقلب النجوم إلى سكون","من الدوران يطويهن طيا",31,"ي",2,0],["ومن قطع الحياة صدى وجوعا","ومن مرت به شبعا وريا",31,"ي",2,0],["ومن قلبي وحبته","كِاس بات يهدمه",32,"م",2,0],["وَمِن قَلبي وَحَبَّتِهِ","كِناسٌ باتَ يَهدِمُهُ",33,"م",2,0],["وَمِن قَبلِ النِطاحِ وَقَبلَ ياني","تَبينُ لَكَ النِعاجُ مِنَ الكِباشِ",34,"ش",1,0],["وَمِن قَولِ سامٍ لَو رَآكَ لِنَسلِهِ","فِدى اِبنِ أَخي نَسلي وَنَفسي وَمالِيا",35,"ي",2,0],["ومن قيّم الأمر لا تذهلن عني","فأصل الفساد الذهولُ",36,"ل",1,0],["ومنقوبةُ البطنِ في جوفِهَا","كُراتٌ من الذهبِ الأحمرِ",37,"ر",1,0],["وَمِن قَبلُ ما جَرَّبتُ أَنباءَ جَمَّةً","وَلا يَعرِفُ الأَنباءَ إِلّا المُجَرِّبُ",38,"ب",1,0],["وَمِن قَصضي لِرَأسِ العَينِ أَسعى","إِلى حَظِرٍ بِعَقوَتِها زَهيدِ",39,"د",1,0],["وَمَن قَد حَوى مَجداً طَريفاً وَتالِداً","وَسامى نُجومَ الأُفقِ حينَ تَرَفَّعا",40,"ع",2,0],["وَمِن قُبَلٍ قَبلَ التَشاكي وَبَعدَهُ","نَكادُ لَها مِن شِدَّةِ الوَجدِ نَشرَقُ",41,"ق",1,0],["وَمِن قَبلِها حَنَّت عَجوزُكَ حِنَّةً","وَأُختُكَ لِلأَدنى حَنينَ النَوائِحِ",42,"ح",1,0],["وَمِن قَعنَبٍ هَيهاتَ ما حَلَّ قَعنَبٌ","بَني الخَطَفى بِالمَنزِلِ المُتَباعِدِ",43,"د",1,0],["وَمِن قَبلِها عُذتُم بِأَسيافِ مازِنٍ","غَداةَ كَسَوا شَيبانَ عَضباً مُهَنَّدا",44,"د",2,0],["وَمِن قَبلُ ماتَ الأَقرَعانِ وَحاجِبٌ","وَعَمرٌ وَماتَ المَرءُ قَيسُ اِبنُ عاصِمِ",45,"م",1,0],["ومن قصورٍ عليه مُشرفَةٍ","تُضيءُ والليلُ أسودُ الحُجُبِ",46,"ب",1,0],["وَمَن قَلَّت مَطامِعُهُ تَغَطّى","مِنَ الدُنيا بِأَثوابِ الأَمانِ",47,"ن",1,0],["وَمَن قَتَلتُم عَلى ما كانَ مِن عَجَبٍ","مِنّا فَقَد صادَفوا خَيراً وَقَد سَعِدوا",48,"د",3,0],["وَمُنقَضٍ ما تَراهُ العَينُ مُنقَطِعٌ","ما كُلُّ شَيءٍ يُرى إِلّا لِيَنقَضِيا",49,"ي",2,0],["وَمَن قَلبُهُ مَعَ غَيرِهِ كَيفَ حالُهُ","وَمَن سِرُّهُ في جَفنِهِ كَيفَ يُكتَمُ",50,"م",1,0],["ومُنقَطِعٍ بالسّبْقِ من كلّ حلبةٍ","فَتَحسَبُهُ يَجري إِلى الرَّهنِ مُفْرَدا",51,"د",2,1],["ومن قَسْوَرٍ شائِكِ البُرْثُنَينِ","له لِبْدَةٌ سُرِدَتْ من حديدِ",52,"د",1,0],["وَمَن قامَرَ الأَيّامَ عَن ثَمراتِها","فَأَحجِ بِها أَن تَنجَلي وَلَها القَمرُ",53,"ر",1,0],["وَمَن قَد عَصَيتُ الناسَ فيهِ جَماعَةً","وَصَرَّمتُ خِلّاني بِهِ وَجَفانِيا",54,"ي",2,0],["وَمَن قَد رَماهُ الناسُ بي فَاِتَّقاهُمُ","بِهَجرِيَ إِلّا ما تُجَنُّ ضَمائِرُه",55,"ر",2,0],["وَمِن قَبّل الحَجَرَ الأَسوَدا","وَظَلّله الرُكنُ لَمّا اِستَلَم",56,"م",1,0],["وَمَنْ قَتَلَ الفَرَنْجَ أشَدَّ قَتْلِ","وَمَنْ أَسَرَ الفَرَنْسِيس اللَّعِينا",57,"ن",2,0],["ومن قنا أكرهوا أسنتها","حتى تشكت إلى عواملها",58,"ل",3,0],["وَمَن قَد كُنتُ أَرعاهُ","وَإِن مَلَّ وَإِن صَدّا",59,"د",2,0],["وَمِن قَولِكَ آتيكَ","إِذا صُلِّيَتِ الظُهرُ",60,"ر",1,0],["وَمِن قَوارِعَ قَد أَخرَستَ ناطِقَها","يَحمِلنَ مِن مُخطَفاتِ القَومِ أَوساقا",61,"ق",2,0],["وَمِن قَلائِدَ قَد قَلَّدتَ باقِيَها","مِن أَهلِ فَنِّكَ أَجياداً وَأَعلاقا",61,"ق",2,0],["وَمَن قَد كانَ لي أَطوَ","عَ مِن طَيرِ سُلَيمانِ",62,"ن",1,0],["وَمِن قَبلُ نادى الوَكرُ أَينَ اِبنُ أَجدَلٍ","أَواني وَقالَ الغابُ أَينَ الخَوادِرُ",63,"ر",1,0],["وَمِن قَبلِهِ ما قَد رُزِئتُ بِوَحوَحٍ","وَكانَ اِبنَ أُمّي والخَليلَ المُصافِيا",64,"ي",2,0],["ومَن قامَ في الأَوْهامِ مِن غيرِ رُؤيةٍ","بأثبتَ مِن إدراكِ كُلِّ عِيانِ",65,"ن",1,0],["ومن قائل بل ربنا اللَه قوة","سرى فعلها في جسم كل الخلائق",66,"ق",1,0],["ومن قائل ما اللَه جسما وقوة","بل اللَه شيء فوق كل الخوارق",66,"ق",1,0],["ومن قبل النطاح وقبل يأتي","تبين لك النعاج من الكباش",67,"ش",1,0],["ومن قُوىً مشبوبة كاللظى","عارمة لا تنثني لا تلينْ",68,"ن",1,0],["وَمَن قَطَعَ الحَياةَ صَدّاً وَجوعاً","وَمَن مَرَّت بِهِ شِبَعاً وَرِيّا",69,"ي",2,0],["ومن قضى بعد غنى فقيرا","لم يجدوا في بيته نقيرا",70,"ر",2,0],["ومن قناه كل يوم في ظفرْ","وخيلهُ من سفرٍ الى سفر",71,"ر",1,0],["وَمَن قادَني لِلمَوتِ حَتّى إِذا صَفَت","مَشارِبُهُ سُمَّ الزُعافِ سَقاني",72,"ن",2,0],["ومَنْ قَبِلَ الظُّلْمَ فهْوَ الملومُ","وليس المَلامُ على من ظَلَمْ",73,"م",1,0],["ومن قوله فصل ومن فعله هدى","ومن ملكه رشد به أذهب الغيا",74,"ي",2,0],["ومُنقضٍ ما تراهُ العينُ منقطِعٍ","ما كُلُّ شيءٍ بدَا إلا لينقضِيَا",75,"ي",2,0],["ومن قبل كانوا إن أرادوا انتقاصةً","من الشِعر قالوا عنه لم يتعرَّق",76,"ق",1,0],["ومن قوافٍ بذَوْبِ الدَّمْع نشأتُها","ومن قصيدٍ لفرطِ الحُزْنِ منسوب",77,"ب",1,0],["ومن قضت الرجال له حقوقاً","ومن يعص الرجال فما أصابا",78,"ب",2,0],["ومن قصدي لرأس العين أسعى","إلى حظر بعقوتها زهيد",79,"د",1,0],["ومن قبل ما جربت أبناء جمة","ولا يعرف الأنباء إلا المجرب",80,"ب",1,0],["ومن قبلتْ منه الليالي فداءه","فحُقُّ بأن يَلْقيْنَهُ وهو حامدٌ",81,"د",1,0]]}