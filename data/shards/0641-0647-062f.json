{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[88,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[27,"نعوا عبد العزيز فقلت هذا","https://www.aldiwan.net/poem5749.html","الوافر"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[102,"لي بالحياة تعلق وتشدد","https://www.aldiwan.net/poem33119.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[50,"ليس النعيم وإن كنا نزن به","https://www.aldiwan.net/poem63928.html","البسيط"],[46,"أتت جامع يوم العروبة جامعا","https://www.aldiwan.net/poem22610.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[104,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[115,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[206,"فرح الزمان فضاء بالأنوار","https://www.aldiwan.net/poem919.html",""],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[348,"وعيشك لم أكد أسلوه كبشا","https://www.aldiwan.net/poem19902.html","الوافر"],[349,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[393,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[403,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[439,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[439,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[449,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[575,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"]],"verses":[["فَهَداهُم بِالأَسوَدَينِ وَأَمرُ اللَ","هِ بَلغٌ يَشقى بِهِ الأَشقياءُ",0,"ا",2,0],["فهدانا بها إله قديم","واحد عنده القرون ثوان",1,"ن",1,0],["فَهَدَّ الأَرضَ مَصرَعُهُ فَمادَت","رَواسيها وَنُضِّبَتِ البُحورُ",2,"ر",1,0],["فَهَدى إليه عُواؤُه","لمّا عوى رِئبالَ غابهْ",3,"ب",2,0],["فهدتْ عيونهم له أضواؤه","وهدت أنوفَهمُ له أرواحُه",4,"ح",2,0],["فهَدتْ عيونُهُمُ وأفرخَ روعُهم","وأقام منهم مَنْ أرادَ رحيلا",5,"ل",2,0],["فَهَدت سَبيل الشَرق في ظَلماته","فَجَرى يَغوّر في الحياة وَينجد",6,"د",1,0],["فهداكمْ بارقٌ مِنْ أضْلُعي","وسُقِيتُمْ بغَمامٍ مِن وَداد",7,"د",1,0],["فَهدَينِ طَوراً وَفَهّادَينِ آوِنَةً","ما كانَ قَبلَهُما فَهدٌ بِفَهّادِ",8,"د",1,0],["فَهَدّوا بِناءً كانَ يَأوي فِناءَهُ","فَواجِرُ أَلقَت لِلفَواحِشِ خُمرَها",9,"ر",3,0],["فهدأْنَ عند وصوله في وقته","وَشكرن بعد الخوف للرحمن",10,"ن",1,0],["فَهْدُ غَابٍ كُسِرَتْ شِرَّتُهُ","صَارَ كالهِرِّ وَمَا يُرْهِبُ فأْرا",11,"ر",2,0],["فهد مضى .. والعمر في ركبانه","ويغيب احمد ..والشباب شباب",12,"ب",1,0],["فهداهم بالأسودين وأمر الل","ه بلغٌ تشقى به الأشقياء",13,"ا",2,0],["فهدى الناس للمهيمن حتى","عظمت فيه رتبة الأتباع",14,"ع",1,0],["فَهَدى الناسَ لَفظُها وَمعاني","ها وَأَسرارها وكلٌّ ضياءُ",15,"ا",2,0],["فهدي الأنام إلى الطريق فأصبحوا","متيممين لحضرة الغفّار",16,"ر",1,0],["فَهَدى قَبائِلَهُ فَلَم يَتَقَبَّلوا","بَل قابَلوا المَعروفَ بِالنُّكرانِ",17,"ن",1,0],["فَهَدتهُ لِلحُسنى شَهادَةُ ضَبِّهِ","بِرِسالَةِ المَبعوثِ مِن عَدنانِ",17,"ن",1,0],["فَهَدّوا حَائِطاً أَخَذوهُ مِنهُ","وَعَنْهُ يَضِيقُ مُشْكلُ كُلِّ بَابِ",18,"ب",1,0],["فَهُد إِلى هودي وَعَن عادِهِ","عُد تائِباً يُمحَ لَكَ الذَنبُ",19,"ب",1,0],["فَهدى وَأَدّى لَيسَ بِفِكرُ في العِدى","وَالكفرُ دونَ جلادِهِ أَجلادُ",20,"د",1,0],["فهدى الإِله إلى الحديث جماعة","فازوا به إذ وفقوا لوفاقي",21,"ق",2,0],["فَهَدى وَأَهْدَانِي إِلَيْكَ مُبَرِّزاً","شَهِدَتْ لَهُ فِي السَّابِقَاتِ عُدُولُهُ",22,"ل",2,0],["فَهدَّمَتْ بك بُنيانَ العِدى فَرَقاً","وشيَّدَتْ لَكَ فَوْقَ النجمِ بُنيانا",23,"ن",2,0],["فهدد الغرب بالحرب الضروس فلم","تأبه به لا ولم تجبن لإنذار",24,"ر",1,0],["فهَدَى الملْكَ جودُه وجَدَاه","وحَمَى الملكَ بأْسُه ونَكَالُه",25,"ل",2,0]]}