{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[90,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[29,"نعوا عبد العزيز فقلت هذا","https://www.aldiwan.net/poem5749.html","الوافر"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[104,"لي بالحياة تعلق وتشدد","https://www.aldiwan.net/poem33119.html","الكامل"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[52,"ليس النعيم وإن كنا نزن به","https://www.aldiwan.net/poem63928.html","البسيط"],[48,"أتت جامع يوم العروبة جامعا","https://www.aldiwan.net/poem22610.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[106,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[119,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[210,"فرح الزمان فضاء بالأنوار","https://www.aldiwan.net/poem919.html",""],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[353,"وعيشك لم أكد أسلوه كبشا","https://www.aldiwan.net/poem19902.html","الوافر"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[409,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[454,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[580,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70658","الخفيف"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216881","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126185","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109039","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79791","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103219","الوافر"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83253","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105005","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93627","الكامل"],[2442,"","https://poetry.dctabudhabi.ae/diwan/poem/198632","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122494","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204958","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134202","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112565","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65123","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132793","المتدارك"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105090","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129446","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46023","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92436","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59482","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97067","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81919","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133161","الرمل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123457","الطويل"],[4785,"حضن الأم","https://www.poetsgate.com/ViewPoem.aspx?id=129745",""],[4836,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=207082",""],[4898,"هذا هُو المختارُ !","https://www.poetsgate.com/ViewPoem.aspx?id=180920",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5461,"نعم شاعرك","https://www.poetsgate.com/ViewPoem.aspx?id=5032",""],[5518,"في ذكرى المولد النبوي الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=187775",""],[5701,"وزائرة تدعي أنها","https://www.poetsgate.com/ViewPoem.aspx?id=164646",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5887,"دعونا اليوم نعلنها صراحة","https://www.poetsgate.com/ViewPoem.aspx?id=28327",""],[5910,"دعاكَ السُّهدُ والأرقُ العتيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=206954",""],[5957,"لأنكَ فجريَ الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=176901",""],[5977,"ودعتهم","https://www.poetsgate.com/ViewPoem.aspx?id=212715",""],[5977,"إلى أخي فهد رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=213141",""],[6008,"ترحيبيه بالإمير فهد بن بدر آل سعود","https://www.poetsgate.com/ViewPoem.aspx?id=60995",""],[6008,"الجوف زانت","https://www.poetsgate.com/ViewPoem.aspx?id=60997",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""],[6229,"يا خادم الحرمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82504&r=&rc=39",""],[402,"فتن النار إذا ما أذهبت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53565&r=&rc=417",""]],"verses":[["فَهَداهُم بِالأَسوَدَينِ وَأَمرُ اللَ","هِ بَلغٌ يَشقى بِهِ الأَشقياءُ",0,"ا",2,0],["فهدانا بها إله قديم","واحد عنده القرون ثوان",1,"ن",1,0],["فَهَدَّ الأَرضَ مَصرَعُهُ فَمادَت","رَواسيها وَنُضِّبَتِ البُحورُ",2,"ر",1,0],["فَهَدى إليه عُواؤُه","لمّا عوى رِئبالَ غابهْ",3,"ب",2,0],["فهدتْ عيونهم له أضواؤه","وهدت أنوفَهمُ له أرواحُه",4,"ح",2,0],["فهَدتْ عيونُهُمُ وأفرخَ روعُهم","وأقام منهم مَنْ أرادَ رحيلا",5,"ل",2,0],["فَهَدت سَبيل الشَرق في ظَلماته","فَجَرى يَغوّر في الحياة وَينجد",6,"د",1,0],["فهداكمْ بارقٌ مِنْ أضْلُعي","وسُقِيتُمْ بغَمامٍ مِن وَداد",7,"د",1,0],["فَهدَينِ طَوراً وَفَهّادَينِ آوِنَةً","ما كانَ قَبلَهُما فَهدٌ بِفَهّادِ",8,"د",1,0],["فَهَدّوا بِناءً كانَ يَأوي فِناءَهُ","فَواجِرُ أَلقَت لِلفَواحِشِ خُمرَها",9,"ر",3,0],["فهدأْنَ عند وصوله في وقته","وَشكرن بعد الخوف للرحمن",10,"ن",1,0],["فَهْدُ غَابٍ كُسِرَتْ شِرَّتُهُ","صَارَ كالهِرِّ وَمَا يُرْهِبُ فأْرا",11,"ر",2,0],["فهد مضى .. والعمر في ركبانه","ويغيب احمد ..والشباب شباب",12,"ب",1,0],["فهداهم بالأسودين وأمر الل","ه بلغٌ تشقى به الأشقياء",13,"ا",2,0],["فهدى الناس للمهيمن حتى","عظمت فيه رتبة الأتباع",14,"ع",1,0],["فَهَدى الناسَ لَفظُها وَمعاني","ها وَأَسرارها وكلٌّ ضياءُ",15,"ا",2,0],["فهدي الأنام إلى الطريق فأصبحوا","متيممين لحضرة الغفّار",16,"ر",1,0],["فَهَدى قَبائِلَهُ فَلَم يَتَقَبَّلوا","بَل قابَلوا المَعروفَ بِالنُّكرانِ",17,"ن",1,0],["فَهَدتهُ لِلحُسنى شَهادَةُ ضَبِّهِ","بِرِسالَةِ المَبعوثِ مِن عَدنانِ",17,"ن",1,0],["فَهَدّوا حَائِطاً أَخَذوهُ مِنهُ","وَعَنْهُ يَضِيقُ مُشْكلُ كُلِّ بَابِ",18,"ب",1,0],["فَهُد إِلى هودي وَعَن عادِهِ","عُد تائِباً يُمحَ لَكَ الذَنبُ",19,"ب",1,0],["فَهدى وَأَدّى لَيسَ بِفِكرُ في العِدى","وَالكفرُ دونَ جلادِهِ أَجلادُ",20,"د",1,0],["فهدى الإِله إلى الحديث جماعة","فازوا به إذ وفقوا لوفاقي",21,"ق",2,0],["فَهَدى وَأَهْدَانِي إِلَيْكَ مُبَرِّزاً","شَهِدَتْ لَهُ فِي السَّابِقَاتِ عُدُولُهُ",22,"ل",2,0],["فَهدَّمَتْ بك بُنيانَ العِدى فَرَقاً","وشيَّدَتْ لَكَ فَوْقَ النجمِ بُنيانا",23,"ن",2,0],["فهدد الغرب بالحرب الضروس فلم","تأبه به لا ولم تجبن لإنذار",24,"ر",1,0],["فهَدَى الملْكَ جودُه وجَدَاه","وحَمَى الملكَ بأْسُه ونَكَالُه",25,"ل",2,0],["فهداه ربُّ العباد إلى اله","جْرة معْ صاحبٍ كريم الأيادي",26,"د",2,0],["فهدّمَ منْ بُروجِ الحَضْرِ صَخْراً","كأنّ ثقالهُ زُبرُ الحديدِ",27,"د",1,0],["فهديء روعنا واصبر فإنا","سنجزع إن جزعت على القضاء",28,"ا",2,0],["فهداياكم الكلام ولا ترضو","ن منا إِلا بخير المعاني",29,"ن",2,0],["فهدوا بني الألبابِ لكن حيَّروا","بظهورِ بعض كمالِهم ألبابها",30,"ب",3,0],["فهدم الشيء أيسر غيركم","من البنيان عند الهادمينا",31,"ن",2,0],["فَهَديي هَديُهُم وَهُمُ افتلوني","كما افتُلِيَ العَتيقُ مِنَ المِهارِ",32,"ر",1,0],["فَهدَّ آطامَ مَن قَد هادَ إِذ طَمِعوا","في شَتِّهِ فَرَماهُم في شَتاتِهِمِ",33,"م",1,0],["فهدى وأرشد غير قلب شاعر","لامته في وادي الغرام غواته",34,"ت",2,0],["فهدّا مشاريعاً وحطم منية","وَأَخمَد روحاً كان لَولاهُ دائِبا",35,"ب",2,0],["فهدَّ من الإسلام حصناً ممنعاً","وهدَّم للإِيمان قصراً مشيَّدا",36,"د",2,0],["فَهَداني المَهدي لِخَير مَحلة","لِأماجد كانوا حماة الجار",37,"ر",1,0],["فهدا كمناع من الشم باذج","وهذا كهطالٍ من الغيث ساكب",38,"ب",1,0],["فهدَيت العُميانَ للمنهجِ المُن","جي وعَلَّمتَ لِلعيِيِّ الكَلاَمَا",39,"م",2,0],["فهدّت قوايَ وأنحفنني","وعضّتنيَ المحن الجائعه",40,"ع",2,0],["فهدى بنصح عزية قد بددت","شمل الضلال هزيمة بشتات",41,"ت",1,0],["فهد الشقل قوته","وأضنى منه أعصابه",42,"ب",2,0],["فهدى لك النّصر العزيز بأمره","وكفى بربّك هايا ونصيرا",43,"ر",2,0],["فهدمت قواعد سلطته","وغنمت فوائد ثروته",44,"ه",1,0],["فهدت شعوب الأرض قدما بنورها","وتلك شعوب في العمى خبطت خبطا",45,"ط",2,0],["فهديتَ الجَميعَ حَتّى استَناورا","وَأجابوا نِداءَ داعى السَلامِ",46,"م",1,0],["فهُدَى اللهِ قد تَحامَى حِماهُ","ومَدا الحتْفِ قرّبتْهُ المداعِسْ",47,"س",1,0],["فهدّت عروش الدين وانطمس الهدى","وأصبح ركن الحق واهي الدعائم",48,"م",1,0],["فهدم ما قد كان غير مهدّم","وشيد ما قد كان غير مشيد",49,"د",1,0],["فَهَدَّمَهُ في يَومِ بُؤسٍ دَجَت بِهِ","طَوالِعُ حُسنِ الفالِ وَاِحتَجَبَ السَّعدُ",50,"د",1,0],["فهديتي هي قيمتي","وقبولُها فضلٌ مزيدْ",51,"د",1,0],["فهدَّ انْصياعاً نابتاً في نِصابها","بروقيه والدَّيجورُ سفُعٌ ذلاذلهْ",52,"ل",2,0],["فَهَدَّهُمُ الرُّعبُ وَالكُلُّ قام","يُرِيقُ على الاَرضِ كَأسَ المُدَام",53,"م",1,0],["فَهَدَّتهُمُ مِن شِدَّةِ الهَولِ رِعدَةٌ","وَأَجَدَرُهُم بالبَطشِ وَلَّى وَأَدبَرا",54,"ر",2,0],["فهد الطراود ذاكي اللهف","على سرفدون وفاض الأسف",55,"ف",1,0],["فَهَدَّموا وَأَطرافَ الوَشيعِ رَمَوا","وَالمَعقِلَ اِبتَدَروا ثَغراً لِثُغرَتِهِ",56,"ه",1,0],["فهد ركن الهدى لما هوى وهوى","نجم الفخار وبدر السعد قد غربا",57,"ب",2,0],["فهد يسابقه النعام فينثني","عن شأوه بالعدو والطيران",58,"ن",1,0],["فهدى به الله الصراط قويما","صلوا عليه وسلموا تسليما",59,"م",2,0],["فهداني إلى رحيق شراب","بعد ركضي إلى لموع السراب",60,"ب",1,0],["فَهُدَّتْ بعضبٍ شُدَّ بعد صقاله","بأمراسِ كتَّانٍ إلى صُمِّ جَنْدل",61,"ل",1,0],["فهداه الله وأولاه نعيم","يا المقدم ويا سادة تريم",62,"م",1,0],["فهَدَّ بيوتاً أشقيت بنُحوسكم","ولم يكُ مجدٌ شادهُ بمهدَّم",63,"م",1,0],["فهدأ روعه وحنا عليه","وطيَّبَ قلبه بحنانه الجم",64,"م",1,0],["فهديَّتي روحي أنا لم أمْتَلِكْ","منْ سُنْدُس ٍأهْديهِ أوْ إسْتَبْرَق ِ!",65,"ق",1,0],["فَهَدى بِكَ الرَّحْمنُ جَلَّ جَلالُهُ","أُمَماً لِدِيْنِ الحَّقِّ بَعْدَ ضَيَاعِ",66,"ع",1,0],["فهداك أعمال البصيرة دون من","يرنو بطرف خاسئ وخسير",67,"ر",1,0],["فهدى الناس إلى نهج الهدى","وأبان الشرع حلا وحراما",68,"م",2,0],["فهدانا بنوره فاعتصمنا","بالهدى منه في جميع الأمور",69,"ر",1,0],["فهدانا به وناهيك بالذكر","كتاباً وبالنبي رسولا",70,"ل",2,0],["فهد زَيْزُومنا في كل ساحه","ظَهَرْ له بالوغَى ضرس وْضراوه",71,"ا",3,0],["فهدانا للنور وكنا","لا نعرف ربا نعبده",72,"د",2,0],["فهدأ ذ