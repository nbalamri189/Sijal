{"poems":[[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[72,"ولي رقيب إذا ما الحب واصلني","https://www.aldiwan.net/poem19579.html","البسيط"],[70,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[49,"يا نفس قد أزف الرحيل","https://www.aldiwan.net/poem63079.html","مجزوء الكامل"],[97,"أجر غربتي أيها العائد","https://www.aldiwan.net/poem24928.html","المتقارب"],[105,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[106,"راتبي","https://www.poetsgate.com/ViewPoem.aspx?id=179514",""],[133,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[158,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[184,"أرى ما أشتهيه يفر مني","https://www.aldiwan.net/poem44110.html","الوافر"],[233,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[259,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[279,"سأصبر حتى ينجز الله وعده","https://www.aldiwan.net/poem1363.html",""],[346,"ولي رزق يكدره لئام","https://www.aldiwan.net/poem19946.html","الوافر"],[347,"بدر بدر ثغره","https://www.aldiwan.net/poem15757.html","مجزوء الرجز"],[388,"عسى نفحة الرحمن تأت من الرب","https://www.aldiwan.net/poem54626.html","عموديه"],[402,"فديتك عز الصديق الصدوق","https://www.aldiwan.net/poem49846.html","المتقارب"],[426,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[429,"إليك تشد في العلم الرحال","https://www.aldiwan.net/poem12533.html","الوافر"],[441,"قد كان ذا الأحمق اللئيم قذى","https://www.aldiwan.net/poem55912.html","المنسرح"]],"verses":[["وَليَرعَهُ قَومُها فَإِنَّهُمُ","مِن خَيرِ حَيٍّ عَلِمتُهُم حَسَبا",0,"ب",2,0],["ولي رقيبٌ إذا ما الحبّ واصلني","قرينه قلت ليت الحبّ لم يصل",1,"ل",1,1],["وَلي رَسائِلُ في طَيِّ النَسيمِ لَكُم","فَفتِّشوا فيهِ آثاراً مِنَ القُبَلِ",2,"ل",1,0],["وَلَيَركَبَنَّ عَلَيكِ في","هِ مِنَ الثَرى ثِقلٌ ثَقيلُ",3,"ل",1,0],["ولي رمق صنته كي أراك","فاشفق على رمقي ريثما",4,"م",2,0],["وَلْيَرْقُبوا العُقْبَى وَزِلْزَالَها","إنْ أظْهَرَ الحِدْثَانُ ما أَضْمَرَا",5,"ر",2,0],["وَلْيَرْفَعِ الْجِيدَ كُلُّ مِنْ بَنِيهِ كَمَا","يَرَوْنَهُ رَافِعاً فَوْقَ الُّربَى جِيدَا",6,"د",2,0],["وَلْيَرْقَ بَيْنَ تَكْرُمَاتِ شَعْبِهِ","سُدَّتَهُ بِاليُمْنِ وَالتَّوِفيقِ",7,"ق",1,0],["وَلي رَشَأٌ ما فيهِ قَدحٌ لِقادِحٍ","سِوى أَنَّهُ مِن خَدِّهِ النارُ تَقدَحُ",8,"ح",1,0],["ولي راتبُ كالماء، تحويه راحتي","فيفلتُ من بين الأصابع هاربًا",9,"ب",2,1],["ولْيرق مَن شاء أعوادَ المنابرِ إذ","مات الذي يتقيه كل من خطبا",10,"ب",2,0],["وليرعَ بعضكم لبعض حقهُ","إِ ن التّجافي يورثُ الأحقادا",11,"د",2,0],["ولي رجلان خلقهُما طريفٌ","ولي حرف يجلّ عن الصفات",12,"ت",1,0],["وَلَيُرفَعَنَّ بِهِ كَما رُفِعَت عَلى ال","فُسطاطِ سودُ بُنودِها وَخِيامُها",13,"م",3,0],["ولي رتبة فوق الثريا محلها","ودون ثري فيه نعالك توضع",14,"ع",1,0],["ولي رغبةٌ شفعت فيها محمداً","نبي الهدى السامي بأفق العلا مجداً",15,"د",2,0],["وَلي رِزْقٌ يُكَدِّرُهُ لِئَامٌ","ذُبَابُهُمُ يَحُطُّ علَى جِراحِي",16,"ي",1,1],["وَلي رِضىً عَنهُ بِما","عَنّي لَهُ رِضى",17,"ض",2,0],["ولي ربي حاجات فياربي اقضها","جميعا قريبا ثم هب لي مناقلبي",18,"ي",1,0],["ولي رغبَةٌ فيكَ إمَّا وفَيْتَ","فهلْ راغِبٌ أنتَ في أنْ تَفي",19,"ف",2,0],["وليرجعنكما الينا بالمنى","في كل فضل دونه الأقران",20,"ن",1,0],["ولي رسمٌ عليك ولا دِفاعٌ","لديك تصدُّ عنه ولا مِطالُ",21,"ل",1,0],["وليرقصِ العلم بعده فرحا","والشعر من فقده لفي طرب",22,"ب",1,0]]}