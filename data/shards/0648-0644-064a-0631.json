{"poems":[[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[74,"ولي رقيب إذا ما الحب واصلني","https://www.aldiwan.net/poem19579.html","البسيط"],[72,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[51,"يا نفس قد أزف الرحيل","https://www.aldiwan.net/poem63079.html","مجزوء الكامل"],[99,"أجر غربتي أيها العائد","https://www.aldiwan.net/poem24928.html","المتقارب"],[107,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[108,"راتبي","https://www.poetsgate.com/ViewPoem.aspx?id=179514",""],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[139,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[164,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[190,"أرى ما أشتهيه يفر مني","https://www.aldiwan.net/poem44110.html","الوافر"],[240,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[266,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[286,"سأصبر حتى ينجز الله وعده","https://www.aldiwan.net/poem1363.html",""],[353,"ولي رزق يكدره لئام","https://www.aldiwan.net/poem19946.html","الوافر"],[354,"بدر بدر ثغره","https://www.aldiwan.net/poem15757.html","مجزوء الرجز"],[396,"عسى نفحة الرحمن تأت من الرب","https://www.aldiwan.net/poem54626.html","عموديه"],[411,"فديتك عز الصديق الصدوق","https://www.aldiwan.net/poem49846.html","المتقارب"],[435,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[438,"إليك تشد في العلم الرحال","https://www.aldiwan.net/poem12533.html","الوافر"],[449,"قد كان ذا الأحمق اللئيم قذى","https://www.aldiwan.net/poem55912.html","المنسرح"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100138","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77440","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49556","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202168","الكامل"],[1974,"","https://poetry.dctabudhabi.ae/diwan/poem/199430","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110313","الكامل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113741","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27634","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120588","المتدارك"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93662","الطويل"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116834","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201215","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202832","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200172","الطويل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101624","البسيط"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62890","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86298","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91204","البسيط"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105259","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119672","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94355","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204280","الوافر"],[4755,"لِدَارِ الأَسَى بَابَانِ.. عالٍ, وهابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=198745",""],[4767,"ابتلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200419",""],[1420,"اللّّه يشفي وينفي ما بجبهته","https://www.poetsgate.com/ViewPoem.aspx?id=87630",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5219,"أين المفر ..... ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=195014",""],[5232,"الهوايةُ والمستقبل","https://www.poetsgate.com/ViewPoem.aspx?id=213666",""],[5277,"قلبٌ على الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=200768",""],[223,"أمدُ من السماءِ الآنَ حرفا","https://www.poetsgate.com/ViewPoem.aspx?id=181159",""],[5431,"حنانيك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206968",""],[5609,"عتاب الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=215570",""],[5674,"حزن المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=198680",""],[5841,"قريته عكس ما يتلا","https://www.poetsgate.com/ViewPoem.aspx?id=34957",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5977,"رؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=213245",""],[6102,"رسول الهوى ..","https://www.poetsgate.com/ViewPoem.aspx?id=184161",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["وَليَرعَهُ قَومُها فَإِنَّهُمُ","مِن خَيرِ حَيٍّ عَلِمتُهُم حَسَبا",0,"ب",2,0],["ولي رقيبٌ إذا ما الحبّ واصلني","قرينه قلت ليت الحبّ لم يصل",1,"ل",1,1],["وَلي رَسائِلُ في طَيِّ النَسيمِ لَكُم","فَفتِّشوا فيهِ آثاراً مِنَ القُبَلِ",2,"ل",1,0],["وَلَيَركَبَنَّ عَلَيكِ في","هِ مِنَ الثَرى ثِقلٌ ثَقيلُ",3,"ل",1,0],["ولي رمق صنته كي أراك","فاشفق على رمقي ريثما",4,"م",2,0],["وَلْيَرْقُبوا العُقْبَى وَزِلْزَالَها","إنْ أظْهَرَ الحِدْثَانُ ما أَضْمَرَا",5,"ر",2,0],["وَلْيَرْفَعِ الْجِيدَ كُلُّ مِنْ بَنِيهِ كَمَا","يَرَوْنَهُ رَافِعاً فَوْقَ الُّربَى جِيدَا",6,"د",2,0],["وَلْيَرْقَ بَيْنَ تَكْرُمَاتِ شَعْبِهِ","سُدَّتَهُ بِاليُمْنِ وَالتَّوِفيقِ",7,"ق",1,0],["وَلي رَشَأٌ ما فيهِ قَدحٌ لِقادِحٍ","سِوى أَنَّهُ مِن خَدِّهِ النارُ تَقدَحُ",8,"ح",1,0],["ولي راتبُ كالماء، تحويه راحتي","فيفلتُ من بين الأصابع هاربًا",9,"ب",2,1],["وليرع تسوية الصفوف بنفسه","أو غيره كالفعل من خير البشر",10,"ر",1,0],["ولْيرق مَن شاء أعوادَ المنابرِ إذ","مات الذي يتقيه كل من خطبا",11,"ب",2,0],["وليرعَ بعضكم لبعض حقهُ","إِ ن التّجافي يورثُ الأحقادا",12,"د",2,0],["ولي رجلان خلقهُما طريفٌ","ولي حرف يجلّ عن الصفات",13,"ت",1,0],["وَلَيُرفَعَنَّ بِهِ كَما رُفِعَت عَلى ال","فُسطاطِ سودُ بُنودِها وَخِيامُها",14,"م",3,0],["ولي رتبة فوق الثريا محلها","ودون ثري فيه نعالك توضع",15,"ع",1,0],["ولي رغبةٌ شفعت فيها محمداً","نبي الهدى السامي بأفق العلا مجداً",16,"د",2,0],["وَلي رِزْقٌ يُكَدِّرُهُ لِئَامٌ","ذُبَابُهُمُ يَحُطُّ علَى جِراحِي",17,"ي",1,1],["وَلي رِضىً عَنهُ بِما","عَنّي لَهُ رِضى",18,"ض",2,0],["ولي ربي حاجات فياربي اقضها","جميعا قريبا ثم هب لي مناقلبي",19,"ب",2,0],["ولي رغبَةٌ فيكَ إمَّا وفَيْتَ","فهلْ راغِبٌ أنتَ في أنْ تَفي",20,"ف",2,0],["وليرجعنكما الينا بالمنى","في كل فضل دونه الأقران",21,"ن",1,0],["ولي رسمٌ عليك ولا دِفاعٌ","لديك تصدُّ عنه ولا مِطالُ",22,"ل",1,0],["وليرقصِ العلم بعده فرحا","والشعر من فقده لفي طرب",23,"ب",1,0],["وليرض مني بميسور الرثاء له","فليس يترك ميسور بمعسور",24,"ر",1,0],["ولْيروا منا سيوفاً رُهِفت","قَطفت منهم رؤوساً حبحبا",25,"ب",2,0],["وَلي رَحِمٌ مَوصُولة بِكَ أَبتَغي","لَها صِلَةً تُولي لَدَيك التَراضيا",26,"ي",2,0],["ولَّى رجالٌ غضاباً حين سُدْتُهُمُ","لا ذنبَ للخيل إذ لا عُذْرَ لِلْحُمُر",27,"ر",1,0],["وليردد الفضل إن أعطاه صاحبهُ","فوق الذي حده في شرطه السلفُ",28,"ف",1,0],["وَلْيَرِميَنَّ الناكثين بجِحْفلٍ","لَجِبٍ يُصَرِّفُ فيهمُ صَرْفَ القَضا",29,"ض",2,0],["وَلْيَرْجِعَنَّ به الجَموحُ شَكيمةً","سَلِسَ المَقادةِ في السّياسة رَيِّضا",29,"ض",2,0],["ولي رغبةٌ جاءتك وهي مدّلة","تسوق إليك الحمد وهو أزاهرُ",30,"ر",1,0],["وليرهب الحمل الوديع رماته","فلقد يكون لدى الوقيعة ضيغما",31,"م",2,0],["ولي رسائِلُ في فَضلِ الصلاة علي","ك والسلامِ وما في ذاك قد ذكَروا",32,"ر",3,0],["وليرتضي بما له لا يزد","على رضاه إنه في تَبار",33,"ر",1,0],["وَليُراجِع مَن شاءَ إِنجيلَ يو","حَنّا فَفيهِ للِباحِثينَ اِهتِداءُ",34,"ا",2,0],["ولّى رمضانُ يَشِيدُ بِما","أعمَالُكَ فِيه تُشَيِّدُهُ",35,"د",2,1],["وَلي رَمق باق عَلى اليَأس وَالرَجا","أَخاف عَلَيهِ مِن صُدودك يتلف",36,"ف",1,0],["ولي رَوعَةٌ عندَ الإيابِ وزَفرةٌ","لها تحتَ أحناءِ الضلوع سعيرُ",37,"ر",1,0],["ولي روحُ خبثٍ نثير الحياء","وروح من الطيب لي معجبة",38,"ه",1,1],["ولي روح الشباب وجسم شيخٍ","ولست لأيّ ذين بذي رضوخ",39,"خ",1,1],["ولي روح جبّار وجسمٌ مضعضع","أحلّ به كالنسر يسكن في عش",40,"ش",1,0],["وليرفع العزم والأعمال سدته","فوق السماكين لا الأقول والخطب",41,"ب",1,0],["ولي رفقة كانوا رفاقا لصحبهم","خفافا وللأعداء ثقل الزلازل",42,"ل",1,0],["وليردد الغصب منه المستعين على","أربابه عند غير العجز إن فعلا",43,"ل",2,0],["وَلِيربوعٍ بِضَاحِي طَخْفَةٍ","في بني المنذرِ مَنٌّ واِسَارُ",44,"ر",1,0],["ولي رُفقةٌ شتَّى النِّجارِ جعلتُها","مواقعَ لحظي والحَوادثُ تَطرُقُ",45,"ق",1,0],["وَلي رجاءٌ وَطيد فيكَ يا املي","فَلا تَخيب رَجا داعٍ اِلَيكَ جَعا",46,"ع",2,0],["وَليرغد العيش في أَهل وَفي وَطَن","وَلتزدهي مصر تَوطيداً وتَوطينا",47,"ن",2,0],["وليرحمن قلباً إذا ذكر الحمى","يزداد من تذكاره في وقده",48,"د",2,0],["ولي رقّةٌ عنها النسائم حدّثت","ولي مقة فلّت لديها المفاصل",49,"ل",1,0],["وليرمِ نفساً إلى التيار يخطفها","ولا يمرَّ على جسر الدني أَبَدا",50,"د",2,0],["ولي رأي غيور في المعاني","فما آتي بها إلاّ افتراعا",51,"ع",2,0],["ولِي _رُغمَ ما قالُوا عَن الوَهمِ_ مَوطِنٌ","سَيَأتِي.. وبي شَوقٌ على الجَرحِ ضَاغِطُ",52,"ط",1,0],["وليرفعِ الكفين عند صلاتهِ","يدعو الذي ما خيَّب المتوسلا",53,"ل",2,0],["وليرسل العلق المصاص يرشف من","دم القذال ويغني عن حجامته",54,"ت",2,0],["وليّ رضيّ مؤمن القلب صالح","رءوف رحيم ذو حنوّ لإخوان",55,"ن",1,0],["ولَّى ربيع العمر يعدو مسرعا","فابكِ الصبا .. ما عاد بالإمكانِ",56,"ن",1,0],["٢-ولى ربيع العمر يعدو مسرعاً","أين المفر ؟ فما سيجدي المدمع ؟",57,"ع",1,0],["ولي رفاقٌ كِبارٌ في تَطلُّعِهِمْ","هُمُ انعكاسٌ لِمَا أهوى بمرآتي",58,"ت",2,0],["ولي ربٌّ يراني ...لا أراهُ","وأدعوهُ إذا حادَ المسارُ",59,"ر",1,0],["ولي رئتانِ : ذاكرةٌ ومنفى","أُضيفُ لهذهِ ما قالَ هذا !",60,"ذ",2,0],["ولي روحٌ مجنّحة تسامت","لها دأبٌ إلى كشفٍ عميقِ",61,"ق",1,0],["ولى ربيع حياتي رغم خضرته","وبات في داخلي من وجدها لهبا",62,"ب",2,0],["ولَّى ربيع العمر عني مسرعا","عطر الفرات يعيدني فدعوني",63,"ن",2,0],["ولي روحِ تناجيها بعشق المغرم الولهان","أحبك يا بعد روحي متيم بك يا محبوبه",64,"ب",2,0],["ولي رَبةُ الرمان تلهو بعبدِها","وقد يوشك الرمّان يلهو بربّهِ",65,"ب",2,0],["ولي رؤيةٌ من ثاقبِ الذِّهن شأنُها","كمُرسلِ ضوءٍ والضبابُ مُكثَّفُ",66,"ف",1,0],["ولي روحٌ تتوق إلى لقاكِ","فداكِ الروح يا عذب السجايا",67,"ا",3,0],["وَلِي رَفارِفُ قَلبٍ أَنتِ سِدرَتُها","وَعَبقَرِيُّ شَغافٍ حَولَهُ حُورُ",68,"ر",1,0],["وليرَ وجودَ الحقِّ قبل وجودهِ","وبعدَ وجودهِ وحيثُما تولّى",69,"ل",2,0]]}