28","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33670","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72401","الرمل"],[4767,"شباك الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210275",""],[4791,"اجمع الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=36959",""],[5061,"قصيدة المواد","https://www.poetsgate.com/ViewPoem.aspx?id=147164",""],[5077,"نصٌّ من الحبّ القديم ..","https://www.poetsgate.com/ViewPoem.aspx?id=36887",""],[5081,"لَيْسَ عَيْبَاً فِيْكَ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=186509",""],[5225,"بك هلا","https://www.poetsgate.com/ViewPoem.aspx?id=27615",""],[5353,"صدى صمتي","https://www.poetsgate.com/ViewPoem.aspx?id=212457",""],[5431,"ليس لي في الأمر يد!!...","https://www.poetsgate.com/ViewPoem.aspx?id=214123",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5573,"يا سحابه حال قطرك دون شوفك سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=205472",""],[5606,"يحسب إن الفوزياجي بالرشاوي","https://www.poetsgate.com/ViewPoem.aspx?id=198631",""],[5956,"يُقتل الهمُّ بمثلِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182024",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""],[5956,"فيه سرُّ الله في أسمى البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193919",""],[5956,"الذكرى الخالدة لوحدة الجمهورية العربية المتحدة","https://www.poetsgate.com/ViewPoem.aspx?id=193991",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[6004,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=33679",""],[6213,"سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76275&r=&rc=32",""],[6258,"وطني قات وقتل واختطافْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75510&r=&rc=82",""],[6258,"قاعدة النظام اليمني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75490&r=&rc=62",""],[454,"هدر المداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82647&r=&rc=11",""]],"verses":[["كُلُّ ما يُرضيكَ يا مَو","لايَ عِندي وَعَلَيَّه",0,"ي",2,0],["كُلُّ ما يُرضيكَ عِندي","فَعَلى رَأسي وَعَيني",1,"ن",2,0],["كلما يممتَ منزلةً","بّشرت بالغيث والمطر",2,"ر",1,0],["كُلَّما يُسِّرَ الرِكابُ لِأَرضٍ","أوثِرَت دونَ غَيرِها بِالحُبورِ",3,"ر",1,0],["كل ما يرغبون فيه مباحٌ","كلٌّ ما يشتهونه ميسور",4,"ر",1,0],["كل ما يبقى تراب وسراب","كَذَبَ الواشي وخاب",5,"ب",1,0],["كلّ ما يشجيك يبكيني","ويضني ويعنّي",6,"ي",1,0],["كل ما يحسن منها عطب","وهو من لا شيء في القدر أقل",7,"ل",1,0],["كُلُّ ما يُردِي سِواكَ اجتَزتُهُ","كُلُّ ما أضناكَ أو يُضني أَصَحَّك",8,"ك",1,0],["كُلُّ مَا يَطلُبُهُ لُبنَانُ مِنكُم","أَن تُحِبُوهُ ... تُحِبُّوهُ قَلِيلاَ",9,"ل",2,0],["كل ما يبسط الحياة صديق","لك أما ما غمها فلدود",10,"د",1,0],["كلما يشهد بي من ألم","فعليه أن يحققه وله",11,"ه",1,0],["كُلُّ ما يَمْلِكُهُ في عُمْرِهِ","حُبَّهُ الأهلَ وبُغْضَ الزَّمَنِ",12,"ن",1,0],["كُلّما يمَّمْتُ دَرْبًا تاهَ بي","واقتفاني مُشْعِلا بي سَأمي",13,"م",2,0],["كل ما يلتذّه","الشبان في العيش يفوتّه",14,"ت",2,0],["كلما يزدهي يثير شجوني","من مجيري من الاسى ومعيني",15,"ن",2,0],["كُلَّما يَمَّمَ عافٍ رَبْعَهُ","عَذُبَ الْمَنْهَلُ أَوْ ساغَ الْجنا",16,"ن",2,0],["كل ما يحويه ملتفع","بدثار البؤس والحزن",17,"ن",1,0],["كل ما يعنيك فالزمه وما","ليس يعنيك من الأشياء فذر",18,"ر",1,0],["كلما يعييك إن تسدده","فالحذر من فتحه كل الحذر",18,"ر",1,0],["كلما يطلبه يسره","ووقاه ربه من كل شر",19,"ر",1,0],["كُلَّما يقرب منِّي عاذلٌ","بملام قلتُ للعاذل بعدا",20,"د",2,0],["كلّما يلحظني ناظره","عكس الأمر فكان النحس سعدا",20,"د",2,0],["كلما يطلبهُ من طَرَفٍ","فيه قد سَطَّرَهُ مَنْ من سطَّرا",21,"ر",2,0],["كلما يدنيني الحب له","منعت ماء الهوى عن قلب صاد",22,"د",1,0],["كَلِماً يُعِرْن الشِّيبَ أرديةَ الصِّبا","فكأنّهمْ طرباً بها لم يكْبَرُوا",23,"ر",3,0],["كل ما يخلقه العقل أملْ","والذي يخلقه الله عملْ",24,"ل",1,1],["كلما يُذكرُ اسمكم في مكانٍ","فهو بالفضلِ والنَّدا ذو اقتِرانِ",25,"ن",1,0],["كُلَّما يَنثَني أَنالُ اِنزِعاجاً","كَيفَ لا وَهوَ راعَ قلبيَ رَوعا",26,"ع",2,0],["كل ما يزعمه الإنسان","غنما فهو مغرم",27,"م",1,0],["كلما يبعث الشجون فقابل","وادن واقرب من ساجع العندليب",28,"ب",1,0],["كل ما يفعل الجمي","ل جميلٌ ولو ظلم",29,"م",1,0],["كل ما يُشرَى يزكَّى","ومزكيه يثاب",30,"ب",1,1],["كلّ ما يجريه في الأرض الفتى","باطلٌ إن لم يكن للوطن",31,"ن",1,0],["كلما يمّمت على اليم نهجاً","صافحتها بالأمن أيدي الصعاب",32,"ب",1,0],["كلما يَمَّمَتْ سبيل نجاة","وجدت دونه سبيل رداها",33,"ا",3,0],["كلُّ ما يرضى به يرضي بهِ","ولهُ التاج ومفتاحُ الحبا",34,"ب",2,0],["كلُّ ما يحويه ميزان","فيه نقصانٌ ورجحانُ",35,"ن",1,1],["كُلَّما يَرتَقي الزَمانُ يَرى الخَي","رَ أَضافَتهُ مِلَّةٌ سَمحاءُ",36,"ا",2,0],["كلّ ما يصدر منه حسنٌ","لم يذقني في الهوى مرّ الغضَب",37,"ب",1,0],["كلما يسنح لي من خاطر","فهو في حبكم قد سنحا",38,"ح",2,0],["كل ما يعمل محسوب له","اكثر الانسان فيه أو أقل",39,"ل",1,0],["كل ما يبغيه يأتيه","ولا يحمل كدا",40,"د",2,0],["كِلْ ما يَهولُ من الأُمورِ إِلى الذي","عَلِمَ السَريرةَ فهو بالمِرْصادِ",41,"د",1,0],["كلما يستنُّ في مرح","قلت هذا الضامر الارن",42,"ن",1,0],["كلما يلفظ من قول يرى","حاضراً ثم رقيبا وعتيدا",43,"د",2,0],["كلّ ما يصدرُ منكم حسن","وبعلياكُم تحلّى الزمنُ",44,"ن",1,1],["كلُّ ما يفعلُ الالهُ جميلٌ","لا تَرُم لاقتضاءِ ربّك دفعا",45,"ع",2,0],["كلما يختتمُ الرشدُ هوىً","بدأ الغيُّ بهِ فافتُتحا",46,"ح",2,0],["كلّما يذكر ذا العَهد ترى","أَثبتَ الوَجدُ جَواه وَمحا",46,"ح",2,0],["كل ما يعظم من أعمالكم","هو تخليد لذكرى العظماء",47,"ا",2,0],["كلَّما يممتُ داري قلتَ لي","أجناحان لنا أم قدمان",48,"ن",1,0],["كل ما يبقى له من ذكره","ضَجَّة من حولها ثار غبار",49,"ر",1,0],["كلما يظمأ الحبيب ويأتي","يشرب الماء منه ألثم فاه",50,"ه",1,0],["كل ما ينتجه مفض إلى","فئةٍ قد زاحمت فيه اليتامى",51,"م",2,0],["كُل ما يَبتَغي يَسير وَما المَر","ء بصعب عَلَيهِ اِصلاح شانه",52,"ن",2,0],["كلما يوجد في الآفا","ق من شتى الأمم",53,"م",1,0],["كلما يشكرُ الرجاءَ عليلٌ","بعثتهُ على فُؤادِي الظنونُ",54,"ن",1,0],["كل ما يلفي لديه منكمو","مستفاد كل ما يلفى لديه",55,"ي",2,0],["كلما يبدو بصيصٌ مِن بعيدٍ","أحسَبُ الآمالَ منها البدرُ أشرق",56,"ق",1,0],["كل ما يفعل أجمل خلق ربي جميل","لا تعذب مودٍ مشفيٍ في هواك",57,"ك",1,0],["كلما يشرح الأستاذ افهي","ولاسالنا يقلب الدنيا علينا",58,"ن",2,0],["كلّما يَغْتالُ أحزاني لِقاءٌ","تَلِدُ الأحْزَانُ للحبّ صبيّا",59,"ي",2,0],["كُلَّمَا يَدْنُو تَنَاءَتْ","وَاسْتَبَاحَتْ مَقْتَلَهْ",60,"ل",2,0],["كلّ ما يبغيه نفذنا","نمتثل لامره ومشّينا",61,"ن",2,0],["كلُّ ما يعنيهِ منّي مفردي","صرت ُ لا أعنيهِ إلا مفردا",62,"د",2,0],["كلّ مايأتي انتقاما","إنّه صوت الجسد",63,"د",1,0],["كلَّما يغفو في فؤادِك هَمٌّ","أيقظته الشجونُ والآلام",64,"م",1,0],["كل مايممت وجهاتي ابي غيرك تجيني","كنك انتي لي قواميس الشعر ويا الكتابه",65,"ب",2,0],["كل ما يهرج تقل بسه تماوي","اللغه مستعربه ماهي فصيحه",66,"ح",2,0],["كلُّ ما يُمْتِعُ قلبي","قد تلاشى بعدَ دَلّكْ",67,"ك",1,0],["كل ما يشعره سكانها","عوّدتْهم قولَه القولَ المبينْ",68,"ن",1,0],["كلما يعلو يُعَلّيهم وفاءً","لإله بالتآخي قد أمرْ",69,"ر",1,0],["كلما يدعى لإعطاء الندىً","يرغَد الداعي بزخات المطرْ",70,"ر",1,0],["كل ما يُبنى على الأخلاق يبقى","شامخَ البنيان طول الزمنِ",71,"ن",1,0],["كلما يزداد عزماً","كلما يُهلِكُ أهلَهْ",72,"ل",2,0],["كُلّمَا يَخْبُوْ حَرِِيْقٌ أَشْعَلَتْهُ","رِيِحُ شَكّ ٍ، وَالْهَوَى عَنْهَا نَهَانَا",73,"ن",2,0],["كلما يأتي جديد عارض","بيد أني لست ألفيه جديد",74,"د",1,0],["كلما يرفع رأس رأسه","يشهر العسكرُ سيفا للقطافْ",75,"ف",1,0],["كلما يدخل النظام","مأزقا قال للعسس",76,"س",1,1],["كلما يدنيني الحب لها","منعت ماء الهوى عن قلب صاد",77,"د",1,0]]}