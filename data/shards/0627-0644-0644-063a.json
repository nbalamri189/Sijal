{"poems":[[43,"أمن آل زينب جد البكور","https://www.aldiwan.net/poem42535.html","المتقارب"],[46,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48808","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62621","البسيط"]],"verses":[["أَلِلغَورِ أَم أَنجَدَت دارُها","وَكانَت قَديماً بِعَهدي تَغورُ",0,"ر",1,0],["أَلِلغِمدِ المَشوفِ عَلَيكَ رَدٌّ","وَلَيسَ لُبابَهُ ذَكَرٌ خَشيبُ",1,"ب",1,0],["أَلِلْغَرِيبِ اخْتِيالٌ في مَسَارِحِها","وَلِلْقَريبِ انْزِواءُ في زَواياها؟",2,"ا",3,0],["أللغاضب الباغي عليك بقية","من العذر إلا أنه لك حاسد",3,"د",1,0],["اللغز نهج لأرباب البطالةِ لا","تسلكهُ واسْلك طريقاً قد زكا عملا",4,"ل",2,0]]}