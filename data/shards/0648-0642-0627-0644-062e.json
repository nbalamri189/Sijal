{"poems":[[37,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[37,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[37,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[34,"ألم تسأل الربع الخلاء فينطق","https://www.aldiwan.net/poem27817.html","الطويل"],[87,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[71,"مشتملا بالسيف قد","https://www.aldiwan.net/poem28440.html","السريع"],[52,"أشاقك مغنى منزل متأبد","https://www.aldiwan.net/poem63906.html","الطويل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[93,"1931","https://www.poetsgate.com/ViewPoem.aspx?id=53444",""],[113,"أذاقني الحين قبل حيني","https://www.aldiwan.net/poem16506.html","مخلع البسيط"],[164,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[438,"تاه بخال خده","https://www.aldiwan.net/poem12369.html","مجزوء الرجز"],[505,"تجرد من مكابرة وجحد","https://www.aldiwan.net/poem37949.html","الوافر"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[591,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66763","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34420","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77524","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77581","الرجز"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96568","الطويل"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130584","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200495","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89420","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123927","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85259","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114361","المتقارب"],[5072,"إليكِ من فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53686",""]],"verses":[["وَقالَ خَليلي يَومَ رُحنا وَفُتِّحَت","مِنَ الصَدرِ أَشراجٌ وَفُضَّت خُتومُها",0,"م",3,0],["وَقالَ خَليلي ما لَها إِذ لَقيتَها","غَداةَ الشَبا فيها عَلَيكَ وُجومُ",1,"م",1,0],["وَقالَ خَليلَي قَد وَقعتَ بِما تَرى","وَأَبلَغتَ عُذرًا في البغايَةِ فَاِقصِدِ",2,"د",1,0],["وَقالَ خَليلِيَ الهَناءُ القُصورُ","وَكَيف وَقَد مُلِأَت أَذأُبا",3,"ب",2,0],["وَقالَ خَليلي إِنَّ ذا لَصَبابَةٌ","أَلا تَزجُرُ القَلبَ اللَجوجَ فَيُلحَقُ",4,"ق",1,0],["وقال خذها يا رجل","وعن هواها لا تحل",5,"ل",1,0],["وقال خالفْتُ كلامَ العدى","فيكَ وقد زرتُكَ بالسيفِ",6,"ف",1,0],["وَقالَ خَليلي قَد مَضَت لِمَضائِها","فَأَبقِ لِأُخرى مِن هَواكَ وَأَرشِدِ",7,"د",1,0],["وَقالَ خَليلي طالِعاتٌ مِنَ الصَفا","فَقُلتُ تَأَمَّل لَسنَ حَيثُ تُريني",8,"ن",2,0],["وقال خليلي : الهناء القصور","ىو كيف وقد ملئت أذؤبا",9,"ب",2,0],["وَقالَ خُذ حَسرة لِقَلبي","وَقالَ هات البُكا لِعَيني",10,"ن",2,0],["وقال خذوني ان أخذتم بحجة","وإن لم يكن ذنب فراعوا الشرائعا",11,"ع",2,0],["وقال خليل الله في الذبح واهم","ورؤيا ابنه تحتاج تعبير عابر",12,"ر",1,0],["وقال خَدِّي رَوْضّةٌ","تَرْتَعُ فيها المُقَلُ",13,"ل",1,0],["وقالَ خُذوا القُلوبَ إلى جَنابي","فَعلمي سابقٌ والسِّرُّ لاحِقُ",14,"ق",1,0],["وقال خليلي حزنُك اليومَ مُسرفٌ","كأنّ عليك الحزنَ ضربةُ لازِبِ",15,"ب",1,0],["وقال خير منهما أبوهما","فاستوجب الفضل به عليهما",16,"م",2,0],["وَقال خُذِ الهَجْرَ المُبرِّحَ بِالحَشَا","فَقُلْتُ خُذ الصَّبْرَ المُبرِّحَ بالهَجْرِ",17,"ر",1,0],["وقالَ خلّفت لكم كتابهُ","وعِترَتي وكلُّ هذين ثِقَلْ",18,"ل",1,0],["وَقال خَليلي إِنّ في الدمع راحَة","وَكفّ دموع العين غيرُ صَوابِ",19,"ب",1,0],["وَقالَ خُذها وَانشرح بصرفها","وَأتحف النَفس بِحُسن ظَرفِها",20,"ه",2,0],["وَقالَ خُذ مالك وَاردد نَومي","فَما غَفلتُ لَيلَتي وَيَومي",20,"ي",1,0],["وَقالَ خلوا قسمة الوَظائِف","بِحسب العُلوم وَالمَعارِف",21,"ف",1,0],["وقال خليلى بعد طول إقامةٍ","على أَىِّ شىءٍ أَنت فى الدار واقف",22,"ف",1,0],["وقال خذ راية الهدى يا","ولي الله وأسرع إلى كرامته",23,"ت",2,0],["وقال خليلي والبكاليَ غالبٌ","أقاضِ عليك ذا الاسى والتشوقُ",24,"ق",1,0],["وقال خذْ من فمه قبلةً","من كل آلامك تشفيكا",25,"ك",2,0],["وقال خيري بعبد الباقي في فرحٍ","لنا الهناء ببشرى من نهنيه",26,"ي",2,0],["وقال خذيني يا سيوف فليس لي","وراءهم بالعيش بلغة ناجح",27,"ح",1,0],["وقال خير الورى حثا لخازنه","انفق ولا تخش أقلالاً ولا تخف",28,"ف",1,0],["وَقَالَ خِلِيلِي أتَدرِي بِنَجسٍ","تَطَهَّرَ حَقّا وَمَا غُسِّلا",29,"ل",2,1],["وقال : خذني أنزوي فيك نبضة ً","بصدر ٍ له تحنو الشفاه ُ إذا انشقّا",30,"ق",2,0]]}