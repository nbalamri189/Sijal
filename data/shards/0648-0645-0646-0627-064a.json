8,"","https://poetry.dctabudhabi.ae/diwan/poem/103569","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127127","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123490","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28949","الوافر"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22802","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4578,"تكمَّل بالتوفيق حجك والمنا","https://www.poetsgate.com/ViewPoem.aspx?id=49533",""],[4862,"إلى مجرمة","https://www.poetsgate.com/ViewPoem.aspx?id=214188",""],[585,"رويداً فحرب المرجفين سجال","https://www.poetsgate.com/ViewPoem.aspx?id=161916",""],[5121,"بِنْتُ العَجَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=215069",""],[5277,"وللغرامِ شهودُ","https://www.poetsgate.com/ViewPoem.aspx?id=192393",""],[5388,"سوف أمضي","https://www.poetsgate.com/ViewPoem.aspx?id=206913",""],[5431,"الكولا وعنترة العبسي!","https://www.poetsgate.com/ViewPoem.aspx?id=215610",""],[5653,"لَعَلَّكَ بالوادي المُقَدَّسِ شاطىء ُ","https://www.poetsgate.com/ViewPoem.aspx?id=26369",""],[5725,"الا ياسليمى","https://www.poetsgate.com/ViewPoem.aspx?id=178415",""],[5725,"على اي عود","https://www.poetsgate.com/ViewPoem.aspx?id=191981",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5957,"وحرفكَ زاهٍ بلا شارحة","https://www.poetsgate.com/ViewPoem.aspx?id=181596",""],[6019,"إشتياق بعنوان آخر !!","https://www.poetsgate.com/ViewPoem.aspx?id=53047",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""]],"verses":[["وَمِن أَينَ تَعرِفُكَ اليَعمَلا","تُ وَالدَمعُ في خَدِّها مُزدَحِم",0,"م",1,0],["ومِنْ أينَ يَسْتَولي منَ العُرْبِ رامِحٌ","على بَلَدٍ فيهِ منَ التُّرْكِ نابِلُ",1,"ل",1,0],["ومِنْ أيِّ عِطفَيْكَ التَفَتَّ تَعَطَّفَتْ","عَليكَ بِهِ الشَّمْسُ المُضيئَةُ والبَدْرُ",2,"ر",1,0],["وَمِنْ آيِتِي أَنَّي عَلَى حَالِ عِزَّتِي","قَعَدْتُ بِبَابِ الْمُلْكِ مَقْعَدَ حَاجِبِ",3,"ب",1,0],["وَمُنايَ لَو مُحِقَت ذُكا","ءُ وَغالَها لَيلٌ بَهيمُ",4,"م",1,0],["ومن أيادٍ بها أوطانهم زهيت","وقومهم بين أقوامٍ وأوطان",5,"ن",1,0],["وَمِن آئِلٍ كَالوَرسِ نَضحاً كَسَونَهُ","مُتونَ الصَفا مِن مُضمَحِلٍ وَناقِعِ",6,"ع",1,0],["ومن أين جئنا أم إلى أين قصدُنا","وفي أيّ ليل من تشككنا نسري",7,"ر",2,0],["وَمِن أَينَ يُنكِرُني الأَبعَدونَ","أَمِن نَقصِ جَدٍّ أَمِن نَقصِ أَب",8,"ب",1,0],["ومن أيادي فضلكم أنكم","لا تُعْدِموني من به أأْتسي",9,"س",2,0],["وَمُنايَ مِنهُ نَظرَةٌ","فَعَسى يُشيرُ الحاجِبان",10,"ن",1,0],["وَمَنايا مِنّا فَكِسرى فَذي القَر","نَينِ فَالقَيصَرَينِ فَالفاروقِ",11,"ق",1,0],["وَمِن أَيِّ ماءٍ كانَ يَسقي جِيادَهُ","وَلَم تَصفُ مِن مَزجِ الدِماءِ المَناهِلُ",12,"ل",1,0],["وَمِن أَينَ أَصبو بَعدَ شَيبي وَبَعدَما","تَأَلّى الخَلِيُّ أَنَّ ذا الشَيبِ لايَصبو",13,"ب",2,0],["وَمِن أَينَ يَكثُرُ أَنصارُهُ","فَيَأتي الأَحَجُّ لَهُ فَالأَحَج",14,"ج",1,0],["وَمِن أَينَ لا يَثني الرَجاءُ مُعَوَّلي","عَلَيكَ وَيَحدوني إِلَيكَ التَشَوُّقُ",15,"ق",1,0],["وَمِن أَينَ أَخشى الفَقرَ بَعدِ الَّذي اِلتَقى","بِكَفَّيكَ مِن مَعروفِ ما أَنا طالِبُه",16,"ب",2,0],["وَمِن أَينَ يَخشى جارُ مَروانَ بَعدَما","أَناخَ وَحَلَّ الرَحلُ لَمّا تَقَدَّما",17,"م",2,0],["وَمِن أَينَ يَخشى جارُكُم وَالحَصى لَكُم","إِذا خِندِفٌ هَزّوا الوَشيجَ المُقَوَّما",17,"م",2,0],["وَمِن أَينَ لِلشَمسِ المُنيرَةِ بِالضُحى","بِمَكحولَةِ العَينَينِ في طَرفِها فَترُ",18,"ر",1,0],["وَمِن أَياديهِ عَلى الكَبيرِ","مِنَ العِبادِ وَعَلى الصَغيرِ",19,"ر",1,0],["ومن أين تَعْدوهُ سياسةُ مثلِها","وقد قُلِّصَتْ في الحربِ عن ساقِه الإزر",20,"ر",1,0],["وَمِن أَيَّامِنا يَومٌ عَجِيبٌ","شَهِدناه بِأَقرِيَةِ الرِداعِ",21,"ع",1,1],["وَمِنْ آيَةِ الفَضْلِ أَنَّ الأُولَى","أَبَوْهَا عَلَيْهِ بِهَا سَلَّمُوا",22,"م",3,0],["وَمِنْ آيِهَا تَكْرِيمُنَا اليَوْمَ حَافِظاً","وَتَمْجِيدُنَا مِنْهُ سَرِيّاً مُمَجَّدَا",23,"د",2,0],["وَمِنْ أَيْنَ لِلرُّمْحِ المُثَقَّفِ عَزْمُهُ","وَمِنْ أَيْنَ لِلرُّمْحِ الطَّوِيلِ طَوَائِلُهْ",24,"ل",2,0],["ومن أين ؟ من كلّ البقاع ، لانه","يجود ولا يدرون ، من أين أمطرا",25,"ر",2,0],["ومنايا تمضي وتأتي منايا","وقتال دام يثير قتالا",26,"ل",2,0],["وَمن أينَ أخشى الفقرَ بَعد الذي التَقى","بكَفّيكَ من مَرُوفِ ماأنا طالِبُهْ",27,"ب",2,0],["ومن اين تلوى للعتاب وطورها","لأبعد شيء في هواكم عن العتب",28,"ب",1,0],["ومن اين يدري لذة الشرف امروء","تمحض عن لؤم بكل حليب",29,"ب",1,0],["ومن أين يَسْلُو القلب بعد فراقِكم","وليسَ فؤادِي من تدكركم يَخْلُو",30,"ل",2,0],["ومن أينَ ذا يفنى وإن ثوابَه","لباقٍ بقاءَ الدهر ما بَعْدَه بُعدُ",31,"د",1,0],["وَمِن أَينَ يَعدو النُجحُ فيكَ وَسائِلي","وَما نَزَلَت إِلّا بِأَوفى الوَرى إِلّا",32,"ل",2,0],["وَمَنائِحٌ كَسَبَت مَدائِحَ هَدَّمَت","ما شادَتِ الأَقوالِ لِلأَقيالِ",33,"ل",1,0],["ومن اين أخشى من عدو أساءة","وسترك ضاف من جميع الجوانب",34,"ب",1,0],["وَمِنْ أَيْنَ لِلْغُصْنِ القَوامُ وَإِنَّما","رَأى قَدَّهُ فَانْقَدَّ مِنْهُ تَكَلُّفا",35,"ف",2,0],["وَمِن أَينَ لي قَلبٌ يُؤَدّي عِبارَةً","إِلى مَنطِقي وَالبَينُ بِالقَلبِ آبِقُ",36,"ق",1,0],["وَمِن آياتِ رَبِّك أَن تَرَانَأ","بِمَسكَنَةِ القَبائِلِ مارَضِينَأ",37,"ن",2,0],["وَمِن آياتِ رَبِّكَ مُحكَماتٍ","مَواثِلَ مَادَرَسنَ وَما نَسِينَا",37,"ن",2,0],["وَمِن أينَ تَأتينا الخواطرُ هل لها","سَحابٌ على الأفكارِ تمطرُها مطرا",38,"ر",2,0],["وَمِن أَين تأتي المرءَ رُؤيا منامه","وَلا عقلَ يُبديها هناك ولا فكرا",38,"ر",2,0],["وَمِن أينَ حلّت في إِشارَتكم بهِ","عَلى جِسمِكم تستدفعونَ بهِ الشرّا",38,"ر",2,0],["وَمِن أَينَ يَسمُو لِنَيلِ العُلا","وَما بَثَّ مالاً وَلا راشَ جاها",39,"ه",2,0],["ومن أين يخفى عنك عشقٌ لعاشقٍ","وعينُك عينٌ تعرف السرَّ والأخفى",40,"ف",2,0],["ومن اياديه لنا","مزن الحيا ينسكب",41,"ب",1,0],["ومن أينَ تأتيكَ المحامدُ والندى","وأنت الذي بالمُفْضِحاتِ مُخَصَّصُ",42,"ص",1,0],["ومن أين لا أغدو ولي كّل مَفْخَرٍ","يَضِيقُ افتخار الناس عنه ويُحْجَبُ",43,"ب",1,0],["ومِنْ أيْنَ أو كَيْفَ التَّجَلُّدُ للنَّوَى","ومَدُّ الأسى في القَلْبِ لَيْس له جَزْرُ",44,"ر",1,0],["ومن آية تبكي منوّر صبحها","إذا قام في جنحٍ من الليل حالك",45,"ك",1,0],["ومناي أني","أعيش وأقولك",46,"ك",1,0],["ومناي أذبل زهرها","الظمآن عصف النائبات",47,"ت",1,0],["وَمِن أَينَ لي عَنها وَفي جَوِّ دارِها","ذَهاني كَما ظَنَّ الغُواةُ ذَهابُ",48,"ب",1,0],["ومن أينَ لي صبرٌ وفي كلِّ ساعةٍ","أرى حَسَناتي في مَوازين أَعدائي",49,"ي",1,0],["ومن أيّ حال الهوى تشتكي","فؤاداً مروعاً وشوقاً مُريعا",50,"ع",2,0],["ومن أين يخفى عليك الهوى","وقد بان ما بي وأبْصَرْتِ حالي",51,"ل",2,0],["ومنْ أينَ تخفى لوعةٌ قد كتمتُها","محاذرة الواشي وبالرغم ما أبدي",52,"د",2,0],["ومن أين يُلغى للمظفّر شبه","إذا احتدمت بالدار عين الملاحم",53,"م",1,0],["ومن أين التاسىّ في المآسي","ودنيانا يعُّج بها الشقاء",54,"ا",2,0],["ومن أين تخشَى خطَّةَ الجور أمةٌ","وأنت لها بالصالحات زعيمُ",55,"م",1,0],["ومن آيتي في الشعر أن لا عيافتي","تخيبُ ولا فالي الجريّ يخيمُ",55,"م",1,0],["ومن آيةٍ قامتْ بتثبيتِ مُلكه","وقد كادت الأقدامُ أن تتزيَّلا",56,"ل",2,0],["ومن آياتِ جودك أن غَنينا","به وإلى القليلِ بك افتقارُ",57,"ر",1,0],["ومن أين يَنسَى من يَرَى الغصنَ مائلاً","مثالَكِ والظبيَ المروَّعَ سانحا",58,"ح",2,0],["ومن أين ترنو إليك العيونُ","وأنت ببَوْغائها في سُجُفْ",59,"ف",1,0],["ومن أين أطلب في حُسنهِ","لَه الشَّبه والحسنُ من عندِهِ",60,"د",2,0],["وَمِن أَينَ لي في غيرها عِوَضٌ بها","وقد أحرزتْ سُبْلَ الفضائلِ وحدَها",61,"د",3,0],["وَمِنَ اِينَ البقاءُ والجسمُ تُربٌ","يَتَلاشى وإنّما الرُّوحُ روحُ",62,"ح",1,0],["ومن أين لِي من بعده بَدَلٌ بهِ","وأين بديلٌ عن زُلالٍ لشاربِ",63,"ب",1,0],["ومنائر العمران ينطح روقها","رأس السماك ويزدري الهرم الجليل",64,"ل",1,0],["ومنائرٌ خُضرٌ علي","ها الوِرقُ شجواً ساجعات",65,"ت",1,0],["وَمَن إِياسُ الذكا أَمسى بحضرته","مجرّداً عَن بَلاغات وَأَفهام",66,"م",1,0],["ومن أين أرجو بُرْءَ نَفْسِي من الجَوَى","وما كلُّ ذي سُقْمٍ من السُّقْم بارئُ",67,"ا",1,0],["ومن أين يلقى أو يرى الضأن مترف","إذا فقد المرعى لدى المترف الضأن",68,"ن",1,0],["ومن أين اتهامك في كنوز","جعلت لها الملائك حارسينا",69,"ن",2,0],["ومن أين للعمران هودٌ وصالحٌ","إذا عبثتْ عادٌ به وثمود",70,"د",1,0],["وَمِنْ أين لا يُلقى الحوائجَ خَلفَه","مَنِ اعتادَ أن يقضي الحوائج من خلف",71,"ف",1,0],["ومن آي القران المنديع","يقصر دونه نظم ونثرُ",72,"ر",1,0],["ومن آيه إعطاء سلمان بيضة","من التبر فاستوفت حقوق المقاطع",73,"ع",1,0],["ومن آيه أن رد عين قتادة","وشق خبيب بعد قصم الأضالع",73,"ع",1,0],["ومن آيه أن ردّ رجل ابن أكوع","وكف ابن عفرا بعد قطع الأصابع",73,"ع",1,0],["ومن أين لي قدرة بَحْرُها","تَغَطْمَط مرسى لفُلْكي ومَجْرَى",74,"ر",2,0],["وَمِن أَي الجِهات أَظن سلما","إِذا حوربت مِن جهة الأَمان",75,"ن",1,0],["ومِنْ أَيِّ وَجْهٍ وَاجَهَتْهُ عُيونُنا","تَبَدّى لَها بَدْرٌ وبَحْرٌ وضَيْغَمُ",76,"م",1,0],["ومن أيد قد اقتطعت وكانت","بحار ندى إذا انتجع الوفود",77,"د",1,0],["ومن أينَ يدري غيَّهُ من رَشادهِ","غداً وهو ساهٍ عن تصاريفِ أمسِهِ",78,"ه",1,0],["ومن أين تحيا أمة في محيطها","يطيب مقاماً في الأنام المدلِّس",79,"س",1,0],["ومن أين ياتيني البلاء بكفه","ونعماى ممتوح عليه وصيبها",80,"ب",3,0],["ومن أيسي إلى ليسي","ومن ليسي إلى أيسي",81,"س",2,0],["ومن أين جاءتْ ليت شعري ففرِّعوا","كلامي الذي قد قلت فيه وفصِّلوا",82,"ل",3,0],["ومن أين أن يحظى بطول بقائه","وحكم القضا في ذلك الأمر مبرم",83,"م",1,0],["ومن أي شيء كان يحرم مطلقا","ولو كان مطبوخا بغير تقيّد",84,"د",1,0],["وَمِن أَينِها بَعدَ إِبدانِها","وَمِن شَحمِ أَثباجِها الهابِطِ",85,"ط",1,0],["ومن أين لي صبرٌ وأين أخو الأسى","من الصبر لا كان المعزى على الهجر",86,"ر",1,0],["ومن أين لا أبكي وروحي مفارقي","ومالي سوى حوض المنية مشرع",87,"ع",1,0],["وَمنايَ إذا أثارَ غباراً","أَغبراً لو كُحِلتُ منه بِكُحْلَه",88,"ل",2,0],["وَمُنايَ أنتَ إذا أَقامَ على منى","قوم ومَعرفَتي ذُرى عَرَفات",89,"ت",1,0],["وَمِن آي طه منطقُ الضَب شاهداً","وأُنس غزال البر وهي نفور",90,"ر",1,0],["ومن أين لي إرجاع وقتٍ أضعتِه","وعينٍ بلا نفع بحبّك أسهرت",91,"ت",1,0],["ومن أين في شعر المشيب وبرده","لظىً كان في شعر الصبا متسعرا",92,"ر",2,0],["ومن أين القى لي قريباً لفكرتي","قريب حجىً حتى بعشر من العشر",93,"ر",1,0],["وَمِن أَين لِلأَقوام إدراك مصقع","إِلى أَوج أَفلاك البَلاغة سامي",94,"م",2,0],["ومن أين يعرف سلطان قوم","اذا ما نفى قومه أجمعين",95,"ن",1,0],["ومن أين أقضي حقوق الرفاق","وهل أستطيع تحدي القدر",96,"ر",1,0],["وَمن اين