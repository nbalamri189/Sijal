{"poems":[[53,"قل لأبي سهل الذي ترك","https://www.aldiwan.net/poem65915.html","المنسرح"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[132,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[234,"إليك مدت رقابها العرب","https://www.aldiwan.net/poem51240.html","المنسرح"],[275,"هلا يقارن منك الحسن إحسانا","https://www.aldiwan.net/poem35272.html","البسيط"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[447,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63755","السريع"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105444","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116648","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53240","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27340","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27857","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2636,"","https://poetry.dctabudhabi.ae/diwan/poem/124123","البسيط"],[2976,"","https://poetry.dctabudhabi.ae/diwan/poem/34527","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133994","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134036","المجتث"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133976","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89425","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89077","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89418","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91185","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91208","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/143556","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133116","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58178","السريع"],[5144,"إن قدم الحظ قوماً ما لهم قدم","https://www.poetsgate.com/ViewPoem.aspx?id=181822",""],[5545,"أهواكَ مُلهَمةً","https://www.poetsgate.com/ViewPoem.aspx?id=185001",""]],"verses":[["فهكذا دأبُنا تجودُ فإنْ","أثْنيْتُ أتبعْتَ ناقةً جملا",0,"ل",2,0],["فهكذا التراقُبُ المَوصُوفُ","وكُلُّهُ في شَطْرهِ مَعْروفُ",1,"ف",1,0],["فهكذَا مَنْ أطاعَ اللّهَ خالقَه","أطاعَه كلُّ ذى روحِ بتكوينِ",2,"ن",1,0],["فهكذا تَصْدَع الملوكُ إذا","صالَت وتَنْفي الضَّلالةَ الشُّهُب",3,"ب",1,0],["فهكذا بنتُ حواءَ الضعيفةُ لا","تُريدُ إلا من العشَّاقِ فُرسانا",4,"ن",2,0],["فهكذا إذا أُضيفَ يَنْثَني","مُنْصرِفاً ما ليس بالمُنْصَرِف",5,"ف",1,0],["فَهكَذا قَد جاءَ في التَنزيلِ","في مُحكَمِ القَولِ بِلا تَأويلِ",6,"ل",1,0],["فهكذا لا شك إذهابه","موت عليّ ابن أبي القاسم",7,"م",1,0],["فهكذا العشّاقُ أرواحُهُمْ","مَرْضَى وألوانُهُمُ صُفْر",8,"ر",1,0],["فهكذا هكذا العلياء يخطبها","من شاء يخطبها بالجد لا اللعب",9,"ب",1,0],["فَهَكَذا مَكارِمُ الأَخلاق","وَشَرَف النفوس وَالأَعراق",10,"ق",1,0],["فَهكذا يذهبُ الزّمانُ وَيَف","نَى العِلمُ فِيهِ ويَدرُسُ الأَثَرُ",11,"ر",1,0],["فهكذا توجب أحكام الهوى","إن السقيم يخدع البريّا",12,"ي",2,0],["فهكذا ألبستُها","من كلِّ شيخٍ مُنجبِ",13,"ب",1,0],["فهكذا أمر الإ","له في الوجودِ والورى",14,"ر",2,0],["فَهكذا في الأبحُر المجهولَه","ميِّز بالأفكارِ ما أقولُه",15,"ه",1,0],["فهكذا العدل لا زالت دعائمه","قويمة بنهى شهم ومفضال",16,"ل",1,0],["فَهَكَذا فَاِشرَب وَإِلّا فَكُن","مُجاوِراً بَعضَ النَواويسِ",17,"س",1,0],["فهكذا العود بالإخلاص يحمده","اهل الصداقة للراقي مراقيها",18,"ي",3,0],["فهكذا الصفو لاحت","ايامه والليالي",19,"ل",2,0],["فهكذا العدل بالفضل الذي ظهرت","في الكون آياته إذ أنت مبديها",20,"ي",3,0],["فهكذا الفخر يا صدر الصدور فقد","شرحت صدر زمان أنت محييه",21,"ي",2,0],["فهكذا هكذا الناس الذين رقوا","بعقلهم درج العلياء والرشد",22,"د",1,0],["فهكذا تكون آثار الملو","ك هكذا تفاخر الملكيه",23,"ي",2,0],["فَهَكذا الفَوز وَالعليا تؤرّخه","مصر بعز أَفندينا همت مرحا",24,"ح",2,0],["فَهَكذا الفَوز وَالعليا مؤرّخة","يَعم خديوينا بنصر من اللَه",25,"ه",1,0],["فهكطورٌ أميلت لل","جحيم هناك كفته",26,"ه",1,0],["فهكطوراً بشدته","نميت بوجه أسرته",26,"ه",1,0],["فهكطور التظى قهرا","لنصلٍ زاهقاً طرا",26,"ر",2,0],["فهكطور لن نرعى كآخيل إنما","بإليون لا مرءٌ كهكطور نصطفي",27,"ي",1,0],["فهكطوراً استبقى لدى الفلك حانقاً","ليرجعه خوف السخط إن يتخوف",27,"ف",1,0],["فهكطور بالرأس مستمسكٌ","وفطرقل بالقدمين كذا",28,"ذ",2,0],["فَهَكَذا اِشتَدَّ ذانِ الباسِلانِ وَما","ريعا لِكُلِّ قُوى جَيشٍ وَكَثرَتِهِ",29,"ه",1,0],["فَهَكطُرٌ مُذ أَتاهُ أَثبَتَ القَدَما","مُفَرِّجاً بَينَ ساقيهِ رَحا وَرَمى",29,"م",2,0],["فهكطور ألفى جالساً وقد انتعش","يحاط والرشح جف وما ارتعش",30,"ش",1,0],["فهكطور إستيخيسا كر قاتلاً","زعيم البيوتيين مدرعي اللأم",30,"م",1,0],["فهكذا الفلك العلوي أنجمه","تقدم الثور فيها أنجم الأسد",31,"د",1,0],["فهكذا درج الأخيارُ من قدمٍ","فانظر قلاهم لها من ظاهر السير",32,"ر",1,0],["فهكذا آخرُنا لاحقٌ","بأوَّلٍ يوماً إلى الداهيَهْ",33,"ي",2,0],["فهكذا الفلك العلوي أنجمه","تقدم الثور فيها رتبة الأسد",34,"د",1,0],["فهكذا الحُبُ في قلبي اُصورهُ","على امتداد عِراقِ الفَخْرِ والمَجْدِ",35,"د",1,0]]}