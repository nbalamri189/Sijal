{"poems":[[51,"قل لأبي سهل الذي ترك","https://www.aldiwan.net/poem65915.html","المنسرح"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[129,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[230,"إليك مدت رقابها العرب","https://www.aldiwan.net/poem51240.html","المنسرح"],[271,"هلا يقارن منك الحسن إحسانا","https://www.aldiwan.net/poem35272.html","البسيط"],[365,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[394,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[442,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"]],"verses":[["فهكذا دأبُنا تجودُ فإنْ","أثْنيْتُ أتبعْتَ ناقةً جملا",0,"ل",2,0],["فهكذا التراقُبُ المَوصُوفُ","وكُلُّهُ في شَطْرهِ مَعْروفُ",1,"ف",1,0],["فهكذَا مَنْ أطاعَ اللّهَ خالقَه","أطاعَه كلُّ ذى روحِ بتكوينِ",2,"ن",1,0],["فهكذا تَصْدَع الملوكُ إذا","صالَت وتَنْفي الضَّلالةَ الشُّهُب",3,"ب",1,0],["فهكذا بنتُ حواءَ الضعيفةُ لا","تُريدُ إلا من العشَّاقِ فُرسانا",4,"ن",2,0],["فهكذا إذا أُضيفَ يَنْثَني","مُنْصرِفاً ما ليس بالمُنْصَرِف",5,"ف",1,0],["فَهكَذا قَد جاءَ في التَنزيلِ","في مُحكَمِ القَولِ بِلا تَأويلِ",6,"ل",1,0],["فهكذا لا شك إذهابه","موت عليّ ابن أبي القاسم",7,"م",1,0]]}