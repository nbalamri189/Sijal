www.aldiwan.net/poem41892.html","الطويل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"حللت حلول الغيث في البلد المحل","https://www.aldiwan.net/poem31791.html","الطويل"],[233,"يا قضيبا إذا انثنى","https://www.aldiwan.net/poem31897.html","مجزوء الخفيف"],[235,"قد مسني الكرب وأنت العالم","https://www.aldiwan.net/poem19084.html","الرجز"],[248,"غياث الورى يوم القيامة أحمد","https://www.aldiwan.net/poem15072.html","الطويل"],[257,"الحمد لله مهذب النفوس","https://www.aldiwan.net/poem35935.html","الرجز"],[259,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[278,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[340,"دنياي دنيا الموت دنيا الحياة","https://www.aldiwan.net/poem55360.html","السريع"],[374,"وارحمتاه لميت في دينه","https://www.aldiwan.net/poem59421.html","الكامل"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[438,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[451,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[456,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[456,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[477,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[480,"أرجو الذي سجدت له الأكوان كر","https://www.aldiwan.net/poem24489.html","عموديه"],[480,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[513,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[513,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[549,"متى يبدي الكثيب لنا غزاله","https://www.aldiwan.net/poem47314.html","الوافر"],[549,"أتتني كما بلغت منية","https://www.aldiwan.net/poem47799.html","المتقارب"],[549,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[551,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[556,"غيم الحوادث حال دون البازغ","https://www.aldiwan.net/poem33541.html","الكامل"],[560,"غراب البين أسرع في البكور","https://www.aldiwan.net/poem52801.html","الوافر"],[560,"أرى فتنة الدنيا هي الآية الكبرى","https://www.aldiwan.net/poem52811.html","الطويل"]],"verses":[["غَفَرتُ ذُنوباً مِنكَ أَذكَت عَزايمي","وَكادَ شِهابُ السُخطِ يَطلَعُ مِن صَدري",0,"ي",1,0],["غَفَرَ الله لي لقَدْ جِئْتُ زُوراً","بجِدالٍ مُلَفَّقٍ وحِجاجِ",1,"ج",1,0],["غَفَلَت غَفلَةً فَلَم تَرَ إِلّا","ذاتَ نَفسٍ مِنها تَكوسُ عَقيرا",2,"ر",2,0],["غَفراً فَلَستُ بِبالِغٍ فيكَ المَدى","إِنّي غَذَذتُ إِلى مَداكَ رِكابي",3,"ب",2,0],["غَفا المَحزونُ وَالشاكي وَأَغفى","أَخو البَلوى وَنامَ المُستَهامُ",4,"م",1,0],["غَفَلَت عَنكَ لِلبِلى نَظَراتٌ","وَتَخَطَّتكَ إِبرَةُ الرَفّاءِ",5,"ا",2,0],["غُفرانَكَ اللَهُمَّ إِن","ني مِن ظُلامَتِهِ بَري",6,"ر",2,0],["غَفَرتُ لِدَهري ما جَنى مِن ذُنوبِهِ","وَأَصبَحتُ راضي القَلبِ عَن كُلِّ مُذنِبِ",7,"ب",1,0],["غفل الدهر والرقيب وبتنا","فعجبنا من اتفاق المحال",8,"ل",1,0],["غَفَرتُ ذُنوبَهُ وَصَفَحتُ عَنهُ","مَخافَةَ أَن أَكونَ بِلا صَديقِ",9,"ق",1,0],["غَفَرَ اللهُ بِهِ","سَيِّئَاتِ الزَّمَنِ",10,"ن",1,0],["غفرانَك اللهُ من جهل بُليت به","فمن أفاد وجودي كيف أنساهُ",11,"ا",2,0],["غفرت لدهري بعدَها كلَّ ما جنى","سوى ما جنى فدُ المشيبِ على فَؤدِي",12,"د",2,0],["غَفَلتُ عَنِ الحُسّادِ مِن غَيرِ غَفلَةٍ","وَبِتُّ طَويلَ النَومِ عَن غَيرِ راقِدِ",13,"د",1,0],["غَفْلةً فوقَ غفلةٍ ثم سَهْواً","فوق سهوٍ عَدِمْتُهم أذكياءَ",14,"ا",2,0],["غفورٌ لمن لم يوفِهِ كُنْهَ حقّه","من المدح معطاء على ذاك مقْثَمُ",15,"م",1,0],["غَفَرتُ ذَنبَ النَوى بِزَورَتِها","ذَنبُ النَوى بَِلِّقاءِ يُغتَفَرُ",16,"ر",1,0],["غُفرانَكَ اللَهُمَّ ما أَنا كافِرٌ","فَلِمَ تُعَذِّبُ مُهجَتي بِالنارِ",17,"ر",1,0],["غَفا صَحبي وَبَعضُهُم تَغَفى","وَلَم أَذُقِ الكَرى إِلّا غِرارا",18,"ر",2,0],["غَفا الناسُ وَاِستَولَت عَلَيهِم سَكينَةٌ","فَما بالُهُ اِستَولى عَلَيهِ ذُهولُ",19,"ل",1,0],["غَفَلوا عَن ساهِرٍ حَولَ الحِمى","باسِطٍ مِن ساعِدَي مُفتَرِسِ",20,"س",1,0],["غَفِلتُ عَنِ الكَأسِ حَتّى طَغَت","وَلي أَدَبٌ لَيسَ بِالغافِلِ",21,"ل",1,0],["غَفَرَ اللَهُ لَهُ ما ضَرَّهُ","لَو قَضى مِن لَذَّةِ العَيشِ الوَطَر",22,"ر",1,0],["غَفَلنا عَنِ الأَيّامِ أَطوَعَ غَفلَةِ","وَما خَونُها المَخشِيُّ عَنّا بِغافِلِ",23,"ل",1,0],["غَفورٌ بَعدَ مَقدِرَةٍ إِذا ما","تَرَجَّحَ بَينَ عَفوٍ وَاِنتِقامِ",24,"م",1,0],["غَفِرَت ذُنوبُ الدَهرِ فيما قَد مَضى","أَلآنَ إِذ قَد تابَتِ الأَيّامُ",25,"م",1,0],["غَفَرتُ ذُنوباً وَعاقَبتُها","فَأَولى لَكُم يا بَني الأَعرَجِ",26,"ج",1,1],["غَفَلاتُ دَهْرٍ غَيُّهُ وضَلالُه","أَولى بنا من هَدْيهِ ورَشَادِه",27,"د",2,0],["غَفَلَت فَخالَفَها السِباعُ فَلَم تَجِد","إِلّا الإِهابَ تَرَكنَهُ بِالمَرقَدِ",28,"د",1,0],["غَفَلتُ وَلَيسَ المَوتُ عَنّي بِغافِلِ","وَإِنّي أَراهُ بي لَأَوَّلَ نازِلِ",29,"ل",1,1],["غَفَلَت هِمَّتي عَنِ السَعيِ حَتّى","بَلَّغَتني الأَيّامُ شَرِّ بَلاغِ",30,"غ",1,0],["غفر الله وهمها من ليالٍ","صوّرت لي الربيع والروض أجرد",31,"د",1,0],["غفر الله لها ما صنعت","كلما شاكيتها تندى كآبه",32,"ه",1,0],["غُفلا أتيناكِ لم تعلَقْ بنا غُرَرٌ","ولا حُجولٌ وإنْ رفَّتْ هوادينا",33,"ن",2,0],["غَفَلنَ عَنِ اللَيلِ حَتّى بَدَت","تَباشيرُ مِن واضِحٍ أَسفَرا",34,"ر",2,0],["غَفلتْ مَواقِعُها عَنِ الدّمِ إذ جَرَى","فكأنّها بِدَمِ الرُّماةِ تُخَضَّبُ",35,"ب",1,0],["غَفَلَ الرَّقِيبُ فَفُزتُ مِنهُ بِنَظرَةٍ","يا لَيتَهُ لَو دامَ فِي غَفَلاتِهِ",36,"ت",2,0],["غَفَلتُ عَمّا أَرادَ قَيِّمُهُم","إِنَّ أَخا الحُبِّ رُبَّما غَفَلا",37,"ل",2,0],["غَفولٌ فَلا تُخشى غَوائِلُ شَرِّها","عَنِ الزادِ ميسانُ العَشِيِّ رَقودُ",38,"د",1,0],["غَفَرتُ ذَنبَ النَوى إِذ كُنتُ باخِلَهُ","أَيّامَ أَمكَنَ مِنكَ الوُدُّ وَاللَطَفُ",39,"ف",1,1],["غَفّارُ مُوبِقَةِ الجَرائم صافحٌ","وسَجِيّةٌ من ماجِدٍ غُفرانها",40,"ن",3,0],["غَفَرَ اللَهُ ذَنبَ مَن","خافَ فَاِستَشعَرَ الحَذَر",41,"ر",1,0],["غَفَرتُ زَماناً في اِنتِكاسِ مَآثِمٍ","وَعِندَ مَليكِ الناسِ يُلتَمَسُ الغَفرُ",42,"ر",1,1],["غُفرانَ رَبِّكَ هَل تَغدو مُؤَمِّلَةً","أَغفارُ شابَةَ أَن تُدعى بِها فُدُرا",43,"ر",2,0],["غَفَرنا وَما أَعنى اِغتِفاراً وَإِنَّما","عَنَيتُ اِنتِكاسَ البُرءِ لا كَرَمَ الغَفرِ",44,"ر",1,0],["غَفَرنا بَينَ أَمراضِ الدَنايا","وَرَبُّكَ أَهلُ إِحسانٍ وَغَفرِ",45,"ر",1,0],["غُفرانَ رَبِّكَ قَلَّما فَعَلَ الفَتى","ما لَيسَ مُحوِجَهُ إِلى اِستِغفارِ",46,"ر",1,0],["غَفَرَ اللَهُ لِعَبدٍ غافِلٍ","هُوَ في أَعظَمِ جَهلٍ وَخَطَر",47,"ر",1,0],["غَفَلتُ وَمِن غَزوي فَقُلتُ بِخَيبَةٍ","وَلَم يَعدُني ريبُ الحَوادِثِ مُغفِلا",48,"ل",2,0],["غفلان لا يعنيه أمرٌ جرى","أيُولَد الحيُّ بها أم يموت",49,"ت",1,0],["غفرتُ لها كلَّ أخطائها","سِوَى دَمعتينِ لتبريرها",50,"ه",2,0],["غَفَرَ الكَلْمُ حينَ لم يَتْرُكِ المِغْ","فَرَ بالمَفْرِقَيْنِ إلاّ شَكيرا",51,"ر",2,0],["غُفِرَت جَرائِمُ لَحظِهِ لِسَقامِهِ","فَسَطا وَلَم تُكتَب عَلَيهِ ذُنوبُهُ",52,"ب",2,0],["غَفَرَ اللهُ لِي إِذَا كَانَ صِدْقاً","وَعَفَا اللهُ عَنْكَ إِنْ كَانَ كِذْبَا",53,"ب",2,0],["غَفَرْنَا ذَنْبَ ذَاكَ الْعَا","مِ مَا آذى وَمَا أرَدَى",54,"د",2,0],["غَفْراً فُؤَادُ أَبا الفارُوقِ إِن عَجَزَتْ","عَنْ عَدِّ آلائِكَ الغَرَّاءِ أوْزاني",55,"ن",2,0],["غفوة يحاولها","والظنون تنتهر",56,"ر",1,0],["غفا صحبي وبعضهم تغافى","ولم أذق الكرى إلاّ غرارا",57,"ر",2,0],["غفَرْنا وما أغنى اغتفاراً، وإنّما","عَنيتُ انتكاسَ البُرْءِ لا كرَمَ الغَفْر",58,"ر",1,0],["غُفرانَكَ اللهُمَّ إنِّ","ي مِن ظُلامَتِهِ بَري",59,"ر",2,0],["غفلتَ وما غفلتَ عن المعاصى","لك النيران قد جُعلتْ حصيرَا",60,"ر",2,0],["غَفلَةٌ مِنكَ مَا اطَّلَعتَ عَلَيهَا","فَتَنَبَّه تَجِدكَ وَغداً زَنِيمَا",61,"م",2,0],["غِفارِيَّةٌ حَلَّت بِبَولانَ خلَّةً","فَيَنبُعَ أَو حَلَّت بِهَضبِ الرَجائِمِ",62,"م",1,0],["غَفِلتَ عن حتفك في أصلها","بزهرة غَرَّتكَ في فرعها",63,"ع",3,0],["غَفَوتُ لَعَلِّي أن أرَى مَن أُحِبُّهُ","وأينَ الكَرَى مِن سَاهرٍ يتمَرَّغُ",64,"غ",1,0],["غفرت بها ذنب الزمان وما بقي","عليه لها عتب فادعوه ظالما",65,"م",2,0],["غفلت مذاهبه الكوا","ئن في القديم على اعتقاله",66,"ل",2,0],["غَفِلتُ عَنِ الزَمانِ وَقَد تَراءَت","نَوائِبُهُ وَحادِثُ صَرفِها لِي",67,"ي",1,0],["غفرتُ للأيامِ ذنبَ الفراقْ","أنْ فزتُ من توديعهمْ بالعناقْ",68,"ق",1,1],["غفتْ تلكَ المرابعُ والمغاني","وما عفتِ المودةُ والإخاءُ",69,"ا",2,0],["غفرت لدهري إحجافه","فهل غفر الدهر فيمن غفر",70,"ر",1,0],["غفلنا عن غنائمنا","أهذا الدهر غفلان",71,"ن",1,0],["غفرانك اللَه هذي نفثة غلبت","ألقى بها الشعر لم تسبق بإصرار",72,"ر",1,0],["غَفَرتُ كَما غَفَرت في الرَبيعِ","زُهورُ الرُبى لِشتاءٍ كَفَر",73,"ر",1,0],["غَفَت مِلءَ عَينَيها وَلكِنَّ روحَها","تَرَدَّدَ في صَدرِ الحَياةِ زُهوقُها",74,"ق",3,0],["غَفَرَ الإِلَهُ لَهُ الذُنوبَ وَلَم يَزَل","مُستَغفِراً ما أَقبَلَ المَلَوانِ",75,"ن",1,0],["غَفَرتُ لِدَهري ما جَنَتهُ خُطوبُهُ","بِقُربِكَ وَالأَيّامُ في أَوسَعِ الحِلِّ",76,"ل",1,0],["غَفِلَ الدَهرُ بُرهَةً","فيهِ عَنّا وَأَعرَضا",77,"ض",2,0],["غُفْرَانَكَ اللَّهُمَّ إِنِّي جَارِمُ","رُحْمَاكَ يَا رَحْمَانُ إِنِّي نَادِمُ",78,"م",1,0],["غفرتُ ذنوبَ الدَّهر إن زرتُ قَبرَهُ","فطُوبى لوجه في ثراهُ يُمَرَّغُ",79,"غ",1,0],["غفلت عن غرسي لصالح العملْ","وصرت فرداً عنه بالنفس استقلْ",80,"ل",1,0],["غفور وعضب الأقتدار مجرد","على من اقام الذنب في ذنبه عذرا",81,"ر",2,0],["غَفَرْتُ ذُنُوبَ هذا الدَّهْرِ لَمّا","أَصارَ إِلَيَّ رُؤْيَتَكَ اعْتِذَارا",82,"ر",2,0],["غفا بعد أن مرّت الزوبعه","يقاسم أحلامه مضجَعه",83,"ه",1,1],["غفرانك اللهم إني أثيم","يا رب إني غارق في الذنوب",84,"ب",1,0],["غُفرت ذنوبي فاتقيتُ جهنماً","لكن عقابي بعدَه لم يُغفَر",85,"ر",1,0],["غفرانك اللهم نفسي أملت","وبرحب عفوك لم تخب آمالها",86,"ل",3,0],["غفلن عنه ولم يشعرن يقظته","وأنه لاشتياق الموت في مضض",87,"ض",1,0],["غفرنا ذنوبَ الدهر إلاَّ ذنوَبه","على المبدعِ الفنانِ لو أنه غفر",88,"ر",1,0],["غفلةٌ للدهر كانت تحت سترٍ","من سواد الشعر مسدولٍ مذالِ",89,"ل",1,0],["غفلاتٌ كنَّ حُلماً فانقضى","وشبابٌ كان ظلّاً فانتقلْ",90,"ل",1,0],["غَفْراً متى قصَّرتُ عنك فإنني","بالمدح أولَى لو بلغتُك بالمِدَحْ",91,"ح",1,0],["غفلنا عنه تفريطا","نسينا فيه أرحاما",92,"م",2,0],["غفرانك اللهم قد أودى بنا","شؤم الذنوب إلى بساط هوان",93,"ن",1,0],["غفرانك غفرا إلهي فأنت أن","ت وإنني البين الخسران",93,"ن",1,0],["غفور عن الزلات مغض إذا بدت","عورات إخوان كريم مداويا",94,"ي",2,0],["غفرت به ذنب الليالي التي مضت","وربتما يستوجب العفو مذنب",95,"ب",1,0],["غفلت عنها وقد جاءت مذكرة","لك القوافي ترجي فطنة الكرم",96,"م",1,0],["غفرتُ له ذنوبَ الدّهرِ لمّا","أَتى كفّي فأعلقها وصالَهْ",97,"ل",2,0],["غفرتُ له هفواتِ الزّمان","وكنّ الكبار فصرن الصِّغارا",98,"ر",2,0],["غَفَرتُ ذنوبهُ حتّى كأنّي","عَلِقتُ به وليس له ذنوبُ",99,"ب",1,0],["غَفَرتُ ذُنوبَها وَصَفَحَتُ عَنها","فَلَم تَصفَح وَلَم تَغفِر ذُنوبي",100,"ب",2,0],["غفرانه يمحو ذنوب وجودنا","معه فتنزل بالمقام البالغ",101,"غ",1,0],["غفلنا عنكَ لم نُصحِبْكَ زاداً","فكانَ القلبُ زادَكَ في المسيرِ",102,"ر",1,0],["غَفَلْنا بها عمَّا بها عن جَهالةٍ","فليسَ بما في البيتِ صاحبُهُ أدرَى",103,"ر",2,0]]}