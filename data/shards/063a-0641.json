Poem.aspx?id=183841",""],[5563,"العين أصدق في الخبر","https://www.poetsgate.com/ViewPoem.aspx?id=213594",""],[5628,"زهور ذابلة","https://www.poetsgate.com/ViewPoem.aspx?id=178513",""],[5628,"بين بغداد والقاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=179813",""],[5691,"لا ينحني نخل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207062",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5747,"غربة الترحال","https://www.poetsgate.com/ViewPoem.aspx?id=61605",""],[5756,"الذيب والراعي","https://www.poetsgate.com/ViewPoem.aspx?id=5419",""],[5758,"شهقة المعنى","https://www.poetsgate.com/ViewPoem.aspx?id=200502",""],[5768,"بَيْرُوتُ وأُمَّتُنَا الْجَرِيحَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=215488",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5880,"ليلة المزرعة","https://www.poetsgate.com/ViewPoem.aspx?id=208586",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""],[5956,"مزاح وسماح","https://www.poetsgate.com/ViewPoem.aspx?id=194188",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""],[6193,"لذي سلم والبان لولاك لم أهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55424&r=&rc=0",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""],[6225,"تسرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78013&r=&rc=100",""],[6229,"في سكون الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65187&r=&rc=13",""],[2220,"لكيوان الثباتِ بغير شكٍّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11910&r=&rc=779",""],[6310,"السُّبات الدَّامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74588&r=&rc=16",""],[6349,"صُورَة جماعِيَّة لِشَخْصٍ وَاحِد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85447&r=&rc=1",""]],"verses":[["غفت مقلة الإسلام ثم وعت به","على الشرك دبت بالنفاق عقاربه",0,"ب",2,0],["غَفَرتُ ذُنوباً مِنكَ أَذكَت عَزايمي","وَكادَ شِهابُ السُخطِ يَطلَعُ مِن صَدري",1,"ر",2,0],["غَفَرَ الله لي لقَدْ جِئْتُ زُوراً","بجِدالٍ مُلَفَّقٍ وحِجاجِ",2,"ج",1,0],["غَفَلَت غَفلَةً فَلَم تَرَ إِلّا","ذاتَ نَفسٍ مِنها تَكوسُ عَقيرا",3,"ر",2,0],["غَفراً فَلَستُ بِبالِغٍ فيكَ المَدى","إِنّي غَذَذتُ إِلى مَداكَ رِكابي",4,"ب",2,0],["غَفا المَحزونُ وَالشاكي وَأَغفى","أَخو البَلوى وَنامَ المُستَهامُ",5,"م",1,0],["غَفَلَت عَنكَ لِلبِلى نَظَراتٌ","وَتَخَطَّتكَ إِبرَةُ الرَفّاءِ",6,"ا",2,0],["غُفرانَكَ اللَهُمَّ إِن","ني مِن ظُلامَتِهِ بَري",7,"ر",2,0],["غَفَرتُ لِدَهري ما جَنى مِن ذُنوبِهِ","وَأَصبَحتُ راضي القَلبِ عَن كُلِّ مُذنِبِ",8,"ب",1,0],["غفل الدهر والرقيب وبتنا","فعجبنا من اتفاق المحال",9,"ل",1,0],["غَفَرتُ ذُنوبَهُ وَصَفَحتُ عَنهُ","مَخافَةَ أَن أَكونَ بِلا صَديقِ",10,"ق",1,0],["غَفَرَ اللهُ بِهِ","سَيِّئَاتِ الزَّمَنِ",11,"ن",1,0],["غفرانَك اللهُ من جهل بُليت به","فمن أفاد وجودي كيف أنساهُ",12,"ا",2,0],["غفرت لدهري بعدَها كلَّ ما جنى","سوى ما جنى فدُ المشيبِ على فَؤدِي",13,"د",2,0],["غَفَلتُ عَنِ الحُسّادِ مِن غَيرِ غَفلَةٍ","وَبِتُّ طَويلَ النَومِ عَن غَيرِ راقِدِ",14,"د",1,0],["غَفْلةً فوقَ غفلةٍ ثم سَهْواً","فوق سهوٍ عَدِمْتُهم أذكياءَ",15,"ا",2,0],["غفورٌ لمن لم يوفِهِ كُنْهَ حقّه","من المدح معطاء على ذاك مقْثَمُ",16,"م",1,0],["غَفَرتُ ذَنبَ النَوى بِزَورَتِها","ذَنبُ النَوى بَِلِّقاءِ يُغتَفَرُ",17,"ر",1,0],["غُفرانَكَ اللَهُمَّ ما أَنا كافِرٌ","فَلِمَ تُعَذِّبُ مُهجَتي بِالنارِ",18,"ر",1,0],["غَفا صَحبي وَبَعضُهُم تَغَفى","وَلَم أَذُقِ الكَرى إِلّا غِرارا",19,"ر",2,0],["غَفا الناسُ وَاِستَولَت عَلَيهِم سَكينَةٌ","فَما بالُهُ اِستَولى عَلَيهِ ذُهولُ",20,"ل",1,0],["غَفَلوا عَن ساهِرٍ حَولَ الحِمى","باسِطٍ مِن ساعِدَي مُفتَرِسِ",21,"س",1,0],["غَفِلتُ عَنِ الكَأسِ حَتّى طَغَت","وَلي أَدَبٌ لَيسَ بِالغافِلِ",22,"ل",1,0],["غَفَرَ اللَهُ لَهُ ما ضَرَّهُ","لَو قَضى مِن لَذَّةِ العَيشِ الوَطَر",23,"ر",1,0],["غَفَلنا عَنِ الأَيّامِ أَطوَعَ غَفلَةِ","وَما خَونُها المَخشِيُّ عَنّا بِغافِلِ",24,"ل",1,0],["غَفورٌ بَعدَ مَقدِرَةٍ إِذا ما","تَرَجَّحَ بَينَ عَفوٍ وَاِنتِقامِ",25,"م",1,0],["غَفِرَت ذُنوبُ الدَهرِ فيما قَد مَضى","أَلآنَ إِذ قَد تابَتِ الأَيّامُ",26,"م",1,0],["غَفَرتُ ذُنوباً وَعاقَبتُها","فَأَولى لَكُم يا بَني الأَعرَجِ",27,"ج",1,1],["غَفَلاتُ دَهْرٍ غَيُّهُ وضَلالُه","أَولى بنا من هَدْيهِ ورَشَادِه",28,"د",2,0],["غَفَلَت فَخالَفَها السِباعُ فَلَم تَجِد","إِلّا الإِهابَ تَرَكنَهُ بِالمَرقَدِ",29,"د",1,0],["غَفَلتُ وَلَيسَ المَوتُ عَنّي بِغافِلِ","وَإِنّي أَراهُ بي لَأَوَّلَ نازِلِ",30,"ل",1,1],["غَفَلَت هِمَّتي عَنِ السَعيِ حَتّى","بَلَّغَتني الأَيّامُ شَرِّ بَلاغِ",31,"غ",1,0],["غفر الله وهمها من ليالٍ","صوّرت لي الربيع والروض أجرد",32,"د",1,0],["غفر الله لها ما صنعت","كلما شاكيتها تندى كآبه",33,"ه",1,0],["غُفلا أتيناكِ لم تعلَقْ بنا غُرَرٌ","ولا حُجولٌ وإنْ رفَّتْ هوادينا",34,"ن",2,0],["غَفَلنَ عَنِ اللَيلِ حَتّى بَدَت","تَباشيرُ مِن واضِحٍ أَسفَرا",35,"ر",2,0],["غَفلتْ مَواقِعُها عَنِ الدّمِ إذ جَرَى","فكأنّها بِدَمِ الرُّماةِ تُخَضَّبُ",36,"ب",1,0],["غَفَلَ الرَّقِيبُ فَفُزتُ مِنهُ بِنَظرَةٍ","يا لَيتَهُ لَو دامَ فِي غَفَلاتِهِ",37,"ت",2,0],["غَفَلتُ عَمّا أَرادَ قَيِّمُهُم","إِنَّ أَخا الحُبِّ رُبَّما غَفَلا",38,"ل",2,0],["غَفولٌ فَلا تُخشى غَوائِلُ شَرِّها","عَنِ الزادِ ميسانُ العَشِيِّ رَقودُ",39,"د",1,0],["غَفَرتُ ذَنبَ النَوى إِذ كُنتُ باخِلَهُ","أَيّامَ أَمكَنَ مِنكَ الوُدُّ وَاللَطَفُ",40,"ف",1,1],["غَفّارُ مُوبِقَةِ الجَرائم صافحٌ","وسَجِيّةٌ من ماجِدٍ غُفرانها",41,"ن",3,0],["غَفَرَ اللَهُ ذَنبَ مَن","خافَ فَاِستَشعَرَ الحَذَر",42,"ر",1,0],["غَفَرتُ زَماناً في اِنتِكاسِ مَآثِمٍ","وَعِندَ مَليكِ الناسِ يُلتَمَسُ الغَفرُ",43,"ر",1,1],["غُفرانَ رَبِّكَ هَل تَغدو مُؤَمِّلَةً","أَغفارُ شابَةَ أَن تُدعى بِها فُدُرا",44,"ر",2,0],["غَفَرنا وَما أَعنى اِغتِفاراً وَإِنَّما","عَنَيتُ اِنتِكاسَ البُرءِ