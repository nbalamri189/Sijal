{"poems":[[53,"أتحسب سوء الظن يجرح في فكري","https://www.aldiwan.net/poem30426.html","الطويل"],[77,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[86,"لي كساء أنعم به من كساء","https://www.aldiwan.net/poem68838.html","الخفيف"],[86,"وافى كتابك يزدري","https://www.aldiwan.net/poem68852.html","مجزوء الكامل"],[71,"أبعد مقامي في دباوند أبتغي","https://www.aldiwan.net/poem3994.html","الطويل"],[82,"عللاني بذكر تلك الليالي","https://www.aldiwan.net/poem29397.html","الخفيف"],[35,"صديقك حين تستغي كثير","https://www.aldiwan.net/poem39123.html","الوافر"],[93,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[83,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[47,"لمن جاهد الحساد أجر المجاهد","https://www.aldiwan.net/poem25321.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"سرى يطوي بنا الأميال طيا","https://www.aldiwan.net/poem8858.html","عموديه"],[91,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"فدتك الجوانح من نازل","https://www.aldiwan.net/poem63025.html","المتقارب"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[45,"تقضى الصبا إلا تلوم راحل","https://www.aldiwan.net/poem65618.html","الطويل"],[45,"خيال يعتريني في المنام","https://www.aldiwan.net/poem65653.html","الوافر"],[45,"اللوم منك وإن نصحت غرام","https://www.aldiwan.net/poem66646.html","الكامل"],[28,"غفرت ذنوبا وعاقبتها","https://www.aldiwan.net/poem4969.html","المتقارب"],[61,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[49,"غفلت وليس الموت عني بغافل","https://www.aldiwan.net/poem63076.html","الطويل"],[66,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[97,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[31,"ألم تسأل المنزل المقفرا","https://www.aldiwan.net/poem42499.html","المتقارب"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[81,"عبثت بقلب عميده لحظاته","https://www.aldiwan.net/poem61369.html","عموديه"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[22,"ألا طرقت هند الهنود وصحبتي","https://www.aldiwan.net/poem22008.html","الطويل"],[52,"غفرت ذنب النوى إذ كنت باخله","https://www.aldiwan.net/poem26824.html","البسيط"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"يا بني النقص والعبر","https://www.aldiwan.net/poem63405.html","مجزوء الخفيف"],[46,"غفرت زمانا في انتكاس مآثم","https://www.aldiwan.net/poem22517.html","الطويل"],[46,"أما الحياة ففقر لا غنى معه","https://www.aldiwan.net/poem22619.html","البسيط"],[46,"أرى كفرطاب أعجز الماء حفرها","https://www.aldiwan.net/poem22649.html","الطويل"],[46,"سئمت الكون في مصر وكفر","https://www.aldiwan.net/poem22677.html","الوافر"],[46,"يا أم دفر إنما أكرمت عن","https://www.aldiwan.net/poem22714.html","الكامل"],[46,"رحت في الناس كربع دارس","https://www.aldiwan.net/poem22739.html","الرمل"],[46,"دع الراح في راح الغواة مدارة","https://www.aldiwan.net/poem23160.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[81,"","https://poetry.dctabudhabi.ae/diwan/poem/11439","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42531","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54692","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[98,"غيرة","https://www.poetsgate.com/ViewPoem.aspx?id=55306",""],[91,"في القطار","https://www.poetsgate.com/ViewPoem.aspx?id=53084",""],[46,"أرى كفْرَ طابٍ أعجزَ الماء حفْرَها،","https://www.poetsgate.com/ViewPoem.aspx?id=20216",""],[86,"وافَى كِتابُكَ يَزْدَرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13064&r=&rc=19",""]],"verses":[["غَفَرتُ ذُنوباً مِنكَ أَذكَت عَزايمي","وَكادَ شِهابُ السُخطِ يَطلَعُ مِن صَدري",0,"ي",1,0],["غَفَرَ الله لي لقَدْ جِئْتُ زُوراً","بجِدالٍ مُلَفَّقٍ وحِجاجِ",1,"ج",1,0],["غَفَلَت غَفلَةً فَلَم تَرَ إِلّا","ذاتَ نَفسٍ مِنها تَكوسُ عَقيرا",2,"ر",2,0],["غَفراً فَلَستُ بِبالِغٍ فيكَ المَدى","إِنّي غَذَذتُ إِلى مَداكَ رِكابي",3,"ب",2,0],["غَفا المَحزونُ وَالشاكي وَأَغفى","أَخو البَلوى وَنامَ المُستَهامُ",4,"م",1,0],["غَفَلَت عَنكَ لِلبِلى نَظَراتٌ","وَتَخَطَّتكَ إِبرَةُ الرَفّاءِ",5,"ا",2,0],["غُفرانَكَ اللَهُمَّ إِن","ني مِن ظُلامَتِهِ بَري",6,"ر",2,0],["غَفَرتُ لِدَهري ما جَنى مِن ذُنوبِهِ","وَأَصبَحتُ راضي القَلبِ عَن كُلِّ مُذنِبِ",7,"ب",1,0],["غفل الدهر والرقيب وبتنا","فعجبنا من اتفاق المحال",8,"ل",1,0],["غَفَرتُ ذُنوبَهُ وَصَفَحتُ عَنهُ","مَخافَةَ أَن أَكونَ بِلا صَديقِ",9,"ق",1,0],["غَفَرَ اللهُ بِهِ","سَيِّئَاتِ الزَّمَنِ",10,"ن",1,0],["غفرانَك اللهُ من جهل بُليت به","فمن أفاد وجودي كيف أنساهُ",11,"ا",2,0],["غفرت لدهري بعدَها كلَّ ما جنى","سوى ما جنى فدُ المشيبِ على فَؤدِي",12,"د",2,0],["غَفَلتُ عَنِ الحُسّادِ مِن غَيرِ غَفلَةٍ","وَبِتُّ طَويلَ النَومِ عَن غَيرِ راقِدِ",13,"د",1,0],["غَفْلةً فوقَ غفلةٍ ثم سَهْواً","فوق سهوٍ عَدِمْتُهم أذكياءَ",14,"ا",2,0],["غفورٌ لمن لم يوفِهِ كُنْهَ حقّه","من المدح معطاء على ذاك مقْثَمُ",15,"م",1,0],["غَفَرتُ ذَنبَ النَوى بِزَورَتِها","ذَنبُ النَوى بَِلِّقاءِ يُغتَفَرُ",16,"ر",1,0],["غُفرانَكَ اللَهُمَّ ما أَنا كافِرٌ","فَلِمَ تُعَذِّبُ مُهجَتي بِالنارِ",17,"ر",1,0],["غَفا صَحبي وَبَعضُهُم تَغَفى","وَلَم أَذُقِ الكَرى إِلّا غِرارا",18,"ر",2,0],["غَفا الناسُ وَاِستَولَت عَلَيهِم سَكينَةٌ","فَما بالُهُ اِستَولى عَلَيهِ ذُهولُ",19,"ل",1,0],["غَفَلوا عَن ساهِرٍ حَولَ الحِمى","باسِطٍ مِن ساعِدَي مُفتَرِسِ",20,"س",1,0],["غَفِلتُ عَنِ الكَأسِ حَتّى طَغَت","وَلي أَدَبٌ لَيسَ بِالغافِلِ",21,"ل",1,0],["غَفَرَ اللَهُ لَهُ ما ضَرَّهُ","لَو قَضى مِن لَذَّةِ العَيشِ الوَطَر",22,"ر",1,0],["غَفَلنا عَنِ الأَيّامِ أَطوَعَ غَفلَةِ","وَما خَونُها المَخشِيُّ عَنّا بِغافِلِ",23,"ل",1,0],["غَفورٌ بَعدَ مَقدِرَةٍ إِذا ما","تَرَجَّحَ بَينَ عَفوٍ وَاِنتِقامِ",24,"م",1,0],["غَفِرَت ذُنوبُ الدَهرِ فيما قَد مَضى","أَلآنَ إِذ قَد تابَتِ الأَيّامُ",25,"م",1,0],["غَفَرتُ ذُنوباً وَعاقَبتُها","فَأَولى لَكُم يا بَني الأَعرَجِ",26,"ج",1,1],["غَفَلاتُ دَهْرٍ غَيُّهُ وضَلالُه","أَولى بنا من هَدْيهِ ورَشَادِه",27,"د",2,0],["غَفَلَت فَخالَفَها السِباعُ فَلَم تَجِد","إِلّا الإِهابَ تَرَكنَهُ بِالمَرقَدِ",28,"د",1,0],["غَفَلتُ وَلَيسَ المَوتُ عَنّي بِغافِلِ","وَإِنّي أَراهُ بي لَأَوَّلَ نازِلِ",29,"ل",1,1],["غَفَلَت هِمَّتي عَنِ السَعيِ حَتّى","بَلَّغَتني الأَيّامُ شَرِّ بَلاغِ",30,"غ",1,0],["غفر الله وهمها من ليالٍ","صوّرت لي الربيع والروض أجرد",31,"د",1,0],["غفر الله لها ما صنعت","كلما شاكيتها تندى كآبه",32,"ه",1,0],["غُفلا أتيناكِ لم تعلَقْ بنا غُرَرٌ","ولا حُجولٌ وإنْ رفَّتْ هوادينا",33,"ن",2,0],["غَفَلنَ عَنِ اللَيلِ حَتّى بَدَت","تَباشيرُ مِن واضِحٍ أَسفَرا",34,"ر",2,0],["غَفلتْ مَواقِعُها عَنِ الدّمِ إذ جَرَى","فكأنّها بِدَمِ الرُّماةِ تُخَضَّبُ",35,"ب",1,0],["غَفَلَ الرَّقِيبُ فَفُزتُ مِنهُ بِنَظرَةٍ","يا لَيتَهُ لَو دامَ فِي غَفَلاتِهِ",36,"ت",2,0],["غَفَلتُ عَمّا أَرادَ قَيِّمُهُم","إِنَّ أَخا الحُبِّ رُبَّما غَفَلا",37,"ل",2,0],["غَفولٌ فَلا تُخشى غَوائِلُ شَرِّها","عَنِ الزادِ ميسانُ العَشِيِّ رَقودُ",38,"د",1,0],["غَفَرتُ ذَنبَ النَوى إِذ كُنتُ باخِلَهُ","أَيّامَ أَمكَنَ مِنكَ الوُدُّ وَاللَطَفُ",39,"ف",1,1],["غَفّارُ مُوبِقَةِ الجَرائم صافحٌ","وسَجِيّةٌ من ماجِدٍ غُفرانها",40,"ن",3,0],["غَفَرَ اللَهُ ذَنبَ مَن","خافَ فَاِستَشعَرَ الحَذَر",41,"ر",1,0],["غَفَرتُ زَماناً في اِنتِكاسِ مَآثِمٍ","وَعِندَ مَليكِ الناسِ يُلتَمَسُ الغَفرُ",42,"ر",1,1],["غُفرانَ رَبِّكَ هَل تَغدو مُؤَمِّلَةً","أَغفارُ شابَةَ أَن تُدعى بِها فُدُرا",43,"ر",2,0],["غَفَرنا وَما أَعنى اِغتِفاراً وَإِنَّما","عَنَيتُ اِنتِكاسَ البُرءِ لا كَرَمَ الغَفرِ",44,"ر",1,0],["غَفَرنا بَينَ أَمراضِ الدَنايا","وَرَبُّكَ أَهلُ إِحسانٍ وَغَفرِ",45,"ر",1,0],["غُفرانَ رَبِّكَ قَلَّما فَعَلَ الفَتى","ما لَيسَ مُحوِجَهُ إِلى اِستِغفارِ",46,"ر",1,0],["غَفَرَ اللَهُ لِعَبدٍ غافِلٍ","هُوَ في أَعظَمِ جَهلٍ وَخَطَر",47,"ر",1,0],["غَفَلتُ وَمِن غَزوي فَقُلتُ بِخَيبَةٍ","وَلَم يَعدُني ريبُ الحَوادِثِ مُغفِلا",48,"ل",2,0],["غفلان لا يعنيه أمرٌ جرى","أيُولَد الحيُّ بها أم يموت",49,"ت",1,0],["غفرتُ لها كلَّ أخطائها","سِوَى دَمعتينِ لتبريرها",50,"ه",2,0],["غَفَرَ الكَلْمُ حينَ لم يَتْرُكِ المِغْ","فَرَ بالمَفْرِقَيْنِ إلاّ شَكيرا",51,"ر",2,0],["غُفِرَت جَرائِمُ لَحظِهِ لِسَقامِهِ","فَسَطا وَلَم تُكتَب عَلَيهِ ذُنوبُهُ",52,"ب",2,0],["غَفَرَ اللهُ لِي إِذَا كَانَ صِدْقاً","وَعَفَا اللهُ عَنْكَ إِنْ كَانَ كِذْبَا",53,"ب",2,0],["غَفَرْنَا ذَنْبَ ذَاكَ الْعَا","مِ مَا آذى وَمَا أرَدَى",54,"د",2,0],["غَفْراً فُؤَادُ أَبا الفارُوقِ إِن عَجَزَتْ","عَنْ عَدِّ آلائِكَ الغَرَّاءِ أوْزاني",55,"ن",2,0],["غفوة يحاولها","والظنون تنتهر",56,"ر",1,0],["غفا صحبي وبعضهم تغافى","ولم أذق الكرى إلاّ غرارا",57,"ر",2,0],["غفَرْنا وما أغنى اغتفاراً، وإنّما","عَنيتُ انتكاسَ البُرْءِ لا كرَمَ الغَفْر",58,"ر",1,0],["غُفرانَكَ اللهُمَّ إنِّ","ي مِن ظُلامَتِهِ بَري",59,"ر",2,0]]}