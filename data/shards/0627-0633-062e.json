{"poems":[[86,"ألبسوك الدماء فوق الدماء","https://www.aldiwan.net/poem10925.html","الخفيف"],[51,"نفرٌ من الخلطاءِ والأصحابِ","https://www.aldiwan.net/poem8329.html","الكامل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"قل للذين مدحتهم فكأنما","https://www.aldiwan.net/poem65493.html","الكامل"],[51,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[91,"يا من قربت من الفؤاد","https://www.aldiwan.net/poem8819.html","عموديه"],[91,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[85,"أسخطت جدى الشاذلي","https://www.aldiwan.net/poem7288.html","مجزوء الكامل"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[43,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[80,"عذبت رقة قلبي","https://www.aldiwan.net/poem31559.html","المجتث"],[44,"كان لنفسي أمل فانقضى","https://www.aldiwan.net/poem29691.html","السريع"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[46,"أستغفر الله رب مدكر","https://www.aldiwan.net/poem22917.html","المنسرح"],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[91,"الكرنفال","https://www.poetsgate.com/ViewPoem.aspx?id=53142",""],[158,"الفرق بين الكفر والإيمان","https://www.aldiwan.net/poem59187.html","الكامل"],[208,"يا حاتم الجود وبحر الندى","https://www.aldiwan.net/poem13527.html","السريع"],[233,"آنسن في الفودين وخط بياض","https://www.aldiwan.net/poem31901.html","الكامل"],[374,"يا هاجي الورد قد أسرفت مفتريا","https://www.aldiwan.net/poem59352.html","البسيط"],[451,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[462,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[491,"في الحلم ما ينهى ذوي الارحام","https://www.aldiwan.net/poem67284.html","عموديه"],[549,"أسخطتني فرضيت من كلف","https://www.aldiwan.net/poem48074.html","أحذ الكامل"],[549,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[551,"واكبدا أحرق الهوى كبدي","https://www.aldiwan.net/poem68369.html","المنسرح"]],"verses":[["أَسخَطوها فَصابَرَتهُم زَماناً","ثُمَّ أَنحَت عَلَيهِمُ بِالجَزاءِ",0,"ا",2,0],["أَسخطتُ إخواني وأَخفقَ مطمعي","فبقيتُ بين الدُّورِ والأبوابِ",1,"ب",1,0],["أسخطَ حسادَهُ وأرغمهمْ","أنْ سار في الناس فارتضوْا سِيَره",2,"ر",2,0],["أسخطت خلّاق البرية فيكم","فبلغتمُ مني رضى الخلاق",3,"ق",1,0],["أسخَّى عن الدارِ المقيمِ نعيمُها","سِوى أنها شيء يُنال على مهلِ",4,"ل",1,0],["أَسخاهُمُ بِنُضارِهِ","أَقسى مِنَ الحَجَرِ الصَلود",5,"د",1,0],["أَسخَرُ مِنهُم لِأَنَّهُم سَخِروا","مِنّي اِختَلَفنا وَنَحنُ نَتَّفِقُ",6,"ق",1,0],["أسخطتُ جدى الشاذلي","إذ خنت نعمة فندلى",7,"ل",2,1],["أسخط الأرباب منها ما سما","وتولى الجنّ عنا مغضَبين",8,"ن",1,0],["أَسخى المُلوكِ بِنَقلِ مَملَكَةٍ","مَن كادَ عَنهُ الرَأسُ يَنتَقِلُ",9,"ل",1,0],["أَسخَطَتهُ بِالبارِقاتِ وَإِنَّما","أَرضَيتَهُ لَو كانَ غَيرَ مُحَرَّفِ",10,"ف",1,0],["أَسْخَطْتَني وجناةُ عَيشِك حُلوَةٌ","فجنَيْتَ مُرَّ العَيْشِ من إسخاطي",11,"ط",2,0],["اسخري يا حياه","قهقهي يا رعود",12,"د",1,0],["اسخري يا حياه","قهقهي يا غيوب",12,"ب",1,0],["أسخطْتُ كلّ عدُوٍّ","رَضِيْتِهِ لمُحِبّك",13,"ك",1,0],["أَسخَطَني دَهرِيَ بَعدَ الرِضا","وَاِرتَجَعَ العُرفَ الَّذي قَد مَضى",14,"ض",2,0],["أَسَخِرْتَ بالبطلِ الصّغيرِ فهل نَجَا","مِنه بِمُهجَتِهِ الكبيرُ الأَشْيَبُ",15,"ب",1,0],["أَسخَطَهُ البَينُ ثُمَّ أَرضَتهُ عُقباهُ","فَنالَ الرِضا مِنَ السَخطِ",16,"ط",1,0],["أُسخّرهم طوراً لنفسي وتارةً","أصُبّ على الأوطان منهم مصائبا",17,"ب",2,0],["أسخر منهم لأنمهم سخروا","مني، اختلفا ونحن نتّفق",18,"ق",1,0],["أسخطت ربك مرضيا أعداءه","يا بئس ما استبدلت بالإيمان",19,"ن",1,0],["اسخى من الغيث اذا ما همى","وكفه اندى من البحر",20,"ر",1,0],["أَسخَطتُ فيهِ العاذِلاتِ وَلَيتَهُ","عَنّي بِإِسخاطِ العَواذِلِ راضي",21,"ي",1,0],["أسخطت من نور نور الورد رونقه","تعدياً فرماك اللَه في سَخَطِهْ",22,"ط",2,0],["اسخر صديقي إذن مهما بكيتَ دماً","كما بكيتُ بسخري إذ بذلتُ دمى",23,"م",2,0],["إسخر وأنتَ زعيمُ السخر في أدبٍ","حي تَنزَّهَ عن موتٍ وعن هَرَم",23,"م",1,0],["اسخر إلى أن يدورَ الكونُ دورته","على الحياةِ فنمضي بَعدُ في الظلم",23,"م",1,0],["أسخى بين الدنيا وأكرمُ شيمةً","وأجلُّ معروفاً وأشرفُ معشرا",24,"ر",2,0],["أسخطت عمداً في عقوقي دولة","ثبتها نصراً بحسن قيامي",25,"م",2,0],["أَسْخَطْتَنِي فَرضيتُ من كَلَفٍ","ولربّما رضِيَ الّذي غَضِبا",26,"ب",2,1],["أَسُخطاً بَعدَ سُخطٍ وَاِزوِراراً","وَنأياً بَعد نأيٍ وَاِجتِنابا",27,"ب",2,0],["أَسخَنتِ عَيني إِن كانَ هَجرُكِ لا","يَنفَكُّ في القُربِ مِنكِ وَالبُعُدِ",28,"د",1,0]]}