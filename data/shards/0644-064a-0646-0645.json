{"poems":[[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[90,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[72,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[87,"قضى أريحي القوم والقوم من همو","https://www.aldiwan.net/poem6832.html","الطويل"],[87,"في مهرجان الحق أو يوم الدم","https://www.aldiwan.net/poem62949.html","الكامل"],[45,"لئن مر بالفسطاط عيشي فقد حلا","https://www.aldiwan.net/poem10636.html","الطويل"],[47,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[30,"إذا ما بريد النضر جاء بنصره","https://www.aldiwan.net/poem1247.html",""],[35,"أتضرب ليلى كلما زرت دارها","https://www.aldiwan.net/poem25998.html","الطويل"],[107,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[83,"لك العذر إن لم أعد زورة","https://www.aldiwan.net/poem61509.html","المتقارب"],[104,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[104,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[77,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[112,"ملائكة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=8412",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[147,"أبا طاهر أنت عيب الزمان","https://www.aldiwan.net/poem11740.html","المتقارب"],[147,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[159,"أيا ربع صبري كيف طاوعك البلى","https://www.aldiwan.net/poem55799.html","الطويل"],[203,"لئن منعوك سلك المنام","https://www.aldiwan.net/poem45175.html","المتقارب"],[214,"فؤاد بذكر العامرية مغرم","https://www.aldiwan.net/poem13295.html","الطويل"],[214,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[214,"وقفت في الدار عنهم اسأل الطللا","https://www.aldiwan.net/poem13463.html","البسيط"],[242,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[242,"هي الدنيا يغر بنا سناها","https://www.aldiwan.net/poem19730.html","الوافر"],[302,"أئن من الشوق الذي في جوانحي","https://www.aldiwan.net/poem33299.html","الطويل"],[303,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[376,"سما لك برق أو بدا لك نور","https://www.aldiwan.net/poem57391.html","البسيط"],[447,"عزاء وصبرا كل حي فميت","https://www.aldiwan.net/poem14441.html","الطويل"],[447,"أعيدي بديع النوح ويك أعيدي","https://www.aldiwan.net/poem14453.html","الطويل"],[466,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[469,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[482,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[482,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[519,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[567,"سل ابنة القوم هل تدري بما صنعت","https://www.aldiwan.net/poem52879.html","البسيط"],[567,"سلام وما يغني السلام على البعد","https://www.aldiwan.net/poem52946.html","الطويل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139019",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86601","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34423","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39021","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48777","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63802","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202085","الطويل"],[1241,"","https://poetry.dctabudhabi.ae/diwan/poem/73653","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108542","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113717","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109333","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103758","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76093","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100248","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70412","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145041","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48288","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48353","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140288",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140289",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4227,"","https://poetry.dctabudhabi.ae/diwan/poem/144283","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28923","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28943","الطويل"],[4525,"","https://poetry.dctabudhabi.ae/diwan/poem/124050","الوافر"],[4728,"حسبي الله على ورقا","https://www.poetsgate.com/ViewPoem.aspx?id=176885",""],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[4947,"لئن مطلتني الليالي بوعد","https://www.poetsgate.com/ViewPoem.aspx?id=187161",""],[5026,"فراشة سكرى","https://www.poetsgate.com/ViewPoem.aspx?id=210477",""],[5200,"بدا فكأن بدر التم أوفى","https://www.poetsgate.com/ViewPoem.aspx?id=200793",""],[5455,"صمت المكان","https://www.poetsgate.com/ViewPoem.aspx?id=34700",""],[5490,"ملك البيان","https://www.poetsgate.com/ViewPoem.aspx?id=176292",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[6079,"قسوة الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=207049",""],[242,"سلام عليكم والحوادث الوان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563731",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""],[5616,"أننسى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1925&r=&rc=0",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["لَئِن مُنيتَ بِنا عَن غِبِّ مَعرَكَةٍ","لَم تُلفِنا مِن دِماءِ القَومِ نَنتَفِلُ",0,"ل",1,0],["لئن ملؤوا الأرض الفضاء جرائماً","فهم أجرموا والدين ليس بمجرم",1,"م",1,0],["لئن منحتُك إشفاقاً تكنَّفهُ","وُدّان من بين إعلان وإسرار",2,"ر",1,0],["لَئِن ماتَ فيها مِن سَطاكَ أَنيسُها","لَقَد عاشَ فيها وَحشُها وَنُسورُها",3,"ر",3,0],["لئن مت فالإنسان لا بدّ ميت","ولكن رزء الناس بالحرّ مؤلم",4,"م",1,0],["لِيَنَم أَبو الأَشبالِ مِلءَ جُفونِهِ","لَيسَ الشُبولُ عَنِ العَرينِ بِنُوَّمِ",5,"م",1,0],["لَئِن مرّ بالفُسطاطِ عيشي فقد حلا","بعبدِ العزيزِ الماجدِ الطرفَينِ",6,"ن",1,1],["لَئِن مَدّوا إِلى العَليا أَكُفّاً","لَهُنَّ عَلى أَكُفِّ الناسِ طولُ",7,"ل",1,0],["لَئِن مالِكٌ أَمسى قَدِ اِنشَعَبَت بِهِ","شَعوبُ الَّتي يودى لَها كُلُّ ذاهِبِ",8,"ب",1,0],["لَئِن مالِكٌ أَمسى ذَليلاً لَطالَما","سَعى في الَّتي لا فا لَها غَيرَ آيِبِ",8,"ب",1,0],["لَئِن مَنَعوا لَيلى السَلامَ وَضَيَّقوا","عَلَيها لِأَجلي وَاِستَمَرَّ رَقيبُها",9,"ب",3,0],["لَئِن مادَ عَرشُ الفاتِحينَ بِرَبِّهِ","لَقَد زُلزِلَت مِن كُلِّ عَرشٍ جَوانِبُه",10,"ب",2,0],["لَئِن مَسَّ جِسمَكَ حَرُّ الضَنى","وَلَوَّحَ ذاكَ المُحَيّا الأَغَرّ",11,"ر",1,0],["لئِن مضى عهدُ ذوينا وفيات","ولم يَعُدْ من أملٍ في الرجوع",12,"ع",1,0],["لَئن ماتَ يا غَمدان جبرٌ فَشدَّما","أَعدَّ رِجالاً للحياةِ وَجنّدا",13,"د",2,0],["لَئِن مَرَّ في كَرمانَ لَيلى فَرُبَّما","حَلا بَينَ تَلَّي بابِلٍ فَالمُضَيَّحِ",14,"ح",1,0],["لَئِنْ مُلِئَتْ منهُ الجوانحُ رَهْبَةً","لقد راقَها من منظرِ العَينِ مُونِقُه",15,"ق",2,0],["لين مت من الحزن.. والمفارق والهجر..؟","مدري.؟ أصارع دوافعه..؟ والا أصارعه..",16,"ع",2,0],["لئن منيت بنا عن غب معركةٍ","لا تلفنا عن دماء القوم ننتقل",17,"ل",1,0],["لَئِن مَثَلٌ لِطُويسٍ جَرى","فَإِنَّكَ أَشأَمُ مِن غُرَّتِه",18,"ت",2,0],["لَئِن مُنِعوا بِالهَمِّ في بُعدِكَ الكَرى","لَقَد مَنَعَ الأَيّامَ قُربُكَ أَن تَعدو",19,"د",2,0],["لَئِن ماتَ مَقصورَ الحَياةِ فَلَم يَزَل","أَمَدَّ الوَرى طَولاً وَباعاً وَتُبَّعا",20,"ع",2,0],["لَئِنْ ماتَ يأْسِي منهُ إِذْ عاشَ مَطْمعي","فَإِنّي قَدِ اسْتَمْسَكْتُ مِنْ لَحْظِهِ الرَّجَا",21,"ا",1,0],["لئن منعوكَ سلكَ المنام","ما انفكَ ما بيننا ينقلُ",22,"ل",1,1],["لئن ملت يوما عن هواها لغيرها","فلا صدق الواشي بما كان يزعم",23,"م",1,0],["لئن ملت يوما عن هواه لسلوة","فلا دمعتي ترقا ولا مقلتي تكرى",24,"ر",2,0],["لئن مضى فلقد ابقت مآثره","ذكرا له ليس يطوى في الحياة إلى",25,"ل",2,0],["لَئِنْ مَنْطِقِي قَدْ أَخْرَسَتْهُ نَوَاكُمُ","فَحَالِي بِمَا أَبْقَى مِنَ الْبَيْنِ سَحْبَانُ",26,"ن",1,0],["لَئِنْ مَاتَتْ فَمَا مَاتَتْ حُلاَهَا","وَإِنْ أَوْدَتْ فَمَا أَوْدَى عُلاَهَا",27,"ا",3,0],["لَئن مرَّ دَهرٌ بالتَنائي فقد حلا","غَبوقي بهم فيما مَضى وَصَبوحي",28,"ح",2,0],["لَيِّنٌ ما فدحته قسوةٌ","ربَّ قاسٍ كان أَجدى منه لين",29,"ن",1,0],["لئن مدَحَ النّاسُ الكرامَ فأحسنوا","فمَجْدُك بَحرٌ للمُجِيدين غالب",30,"ب",1,0],["لئن ماتَ ما ماتَت محاسنُه التي","لها بينَ أصحابِ الحديثِ نُشورُ",31,"ر",1,0],["لئن مات منكم سيد في مقامه","يقوم فتى حلو الشمائل أَصلت",32,"ت",1,0],["لئن مت قبلي راشد انني بكم","قطار فحيني قائم بوصيدي",33,"د",2,0],["لئن منع الإدرار بعد إباحةٍ","ولم يخش من نظمي الفصيح ولا نثري",34,"ر",2,0],["لئن مات مسعودٌ لما مات علمه","وقد بات مسعوداً به وافر الغنم",35,"م",1,0],["لئن ملت أدباً كلّ صدرٍ","لقد شنَّفت طرباً كلَّ أذنٍ",36,"ن",1,0],["لئن مَنَّ هذا الدهرُ بالقربِ بعدَما","تناءيتمُ عنّي سأُوسِعُه شكرا",37,"ر",2,0],["لَئِن مِنَعتُكَ قَومَك مِن حَديثي","فَكَم باتَت تُساجلك الأَماني",38,"ن",2,0],["لئِنْ منحَتْكَ اليومَ جهراً وصالَها","لقد كان هذا الأمرُ في نفسِها سِرّا",39,"ر",2,0],["لَئنْ مَضَت دَولةُ المُلكِ القديم بها","فدَولةُ العِلمِ منها قَطُّ ما انقَطَعتْ",40,"ت",1,0],["لَئن مَنَعَتْ غُبْرُ السباسبِ وَفدنا","فما مَنَعَتْ ريحَ الجَنُوبِ من الوَفْدِ",41,"د",1,0],["لئن مهد التمهيد مضجعه له","فكوكبه من بعده غير آفل",42,"ل",1,0],["لَئن ماتَ هَذا السَيد الحبر وَاِنقَضى","فَما ماتَ تَأليف لَهُ وَصَواب",43,"ب",1,0],["لئن مالَ إِنساني لرؤية غيرهم","فَوَالعصر إِنّي بَعدَ ذا الصبر في خسرِ",44,"ر",1,0],["لئنْ مَحَتْها أكفُّ الدَّهر عَنْ بَصَري","فإنَّ مَشْهَدَها في القَلْب غيرُ خَفي",45,"ف",2,0],["لئن مرضت فمن أعباء ما تركوا","وإن غضبت فللخير الذي اعترضوا",46,"ض",3,0],["لئن مضى الصيفُ وهو يُشْكَرُ فالش","تاءُ أيضاً في فِعْلِهِ يُشْكَر",47,"ر",1,0],["لَئِن مَدَّ لِلأَعداءِ بِالطّعنِ رُمحَهُ","وَلَو بَعُدُوا نِيلوا لَدى ذَلكَ المَدِّ",48,"د",1,0],["لئن مسَّنى بالنَّفي قُرْحٌ فإنني","بلغتُ به في بعض هَمِّي الامانيا",49,"ي",2,0],["لَئِن مَرِضَ الحَبيبُ فَقَد تَحَلّى","مَحَاسِنَ كُلُّنا فيها يَحارُ",50,"ر",1,1],["لئن ملئت بالحور جلق وازدهت","فقد ملئت بالحور مصر ودلت",51,"ت",1,0],["لَئِن مِلتَ عنّي أو مَلَلتَ مَوَدّتي","فإنيَ لا واللَهِ ما ملّكَ القَلبُ",52,"ب",1,1],["لئن من جيشهم قد فر ابني","بعيداً عن عيون الناصحينا",53,"ن",2,0],["لِيَّنٌ ما لم تخاشنه ففي","صفحه والبطش معنى في الصفاح",54,"ح",1,0],["لئن مال دهري بي عنكمُ","فقلبي نحوكمُ مائلُ",55,"ل",1,0],["لَئِن مُنِعَت مِنّا زَماناً فَطالَما","لَنا مُنِحَت نَجني بِها كُلَّ ما نَهوى",56,"و",2,0],["لئن مرضت بصحتك الأعادي","فجودك طب أنفسها الشحاح",57,"ح",1,0],["لئن مال في تلك المناطق ينثني","فللشّمس ميلٌ في المناطق يُنقلُ",58,"ل",1,0],["لئن مات من يرجى فمعطيهمُ الَّذِي","يرجونه باق فلوذي ببابه",59,"ب",2,0],["لئن مضت عنه أجيال وأزمنة","تترى فهل سامه نقض وتحويل",60,"ل",1,0],["لئن مَطَلَتْ بكَ أيّامُهُ","فقَد أنجَزَتْ منكَ لي المَوْعِدا",61,"د",2,0],["لَئِن مُنِعَ الوصْلُ الذي فيه راحَتي","فَما يُمْنَعُ المشتاقُ أن يتوهّما",62,"م",2,0],["لئن مس طيباً لم تطب نفسه شجى","وان ورد الما فالفؤاد تسعرا",63,"ر",2,0],["لئن مات ذاك الحبر فينا فأنتم","له خلف فينا مدى الدهر أحبار",64,"ر",1,0],["لئن مات ذاك الشيخ منا فخلفه","جهابذةٌ من آله لن تزعزعا",65,"ع",2,0],["لئن مات الفتى الجلد","وفيه أنفذ الحد",66,"د",1,0],["لئن ملت دنوي واستقلت","فلست أمل راحلتي وكوري",67,"ر",2,0],["لئنْ مَنَعَ الغيثُ عن زورةٍ","فغيثُ فضائلهِ زائرُ",68,"ر",1,0],["لئن ملكَ الدنيا على الجَور قبلَنا","ملوكٌ فما في العالمين لما مثلُ",69,"ل",1,1],["لئن مالكٌ خلّى عليَّ مكانَهُ","لفي أسوةٍ إن كان ينفعني الأسى",70,"ا",1,0],["لَئِن مالِكٌ خَلّىِ علي مكانَهُ","لنِعمَ فتى العَزّاء والزمنِ المحلِ",71,"ل",1,0],["لئن منع البعاد وصول جسمي","إلى من لا يفارقها فؤادي",72,"د",2,0],["لين ما اطلقت من بالي طيور العاطفة في سفوح المرقا","وابتدت قصةٍ تحوي معاني سيف صبري وجرح اعماقي",73,"ق",2,0],["لين ما خلّيت من بينهم حسنٍ فريد","يوم معهم شربة الما مثل علة نحر",74,"ر",1,0],["لئن مطلتني الليالي بوعد","فكم أمسك الغيث ثم انهمل",75,"ل",1,1],["لي نَمْلَةٌ في القَلْبِ تَبني دولةً","ما ضَمَّ دولَتَها التُّرابُ ولا الثَّرى",76,"ر",2,0],["لئن ملكته كفك يا ابن عيسى","وليس بمستحق رق كلب",77,"ب",1,0],["لين ماتنهي زعلنا ضحكة ٍ بين الشفايا","ضحكة ٍ غابت ولكن شانها مازال شان",78,"ن",1,0],["لئن مارت الأرضُ في كل فجٍّ","وأشرعَت الريحُ عرضاً وطولا",79,"ل",2,0],["لئن مضيت بما لم تجن متهماً","إذن فدعني بما أجنيه أتهم",80,"م",1,0],["لينمو الظلم متسعاً","فيمضي رافعاً فاسه",81,"س",2,0],["لئن مرّتِ الأيّامُ والبُعدُ آسِرٌ","فما فنيَ الإنسانُ ما دامَ في الأسرِ",82,"ر",1,0],["لَئِن مَنطِقي قَد أَخرَستُهُ نَواكُمُ","فَحالي بِما أَلقى مِنَ البَينِ سَحبانُ",83,"ن",1,0],["لئن مددنا يدا تهْوي مداعبة","تهوِي علينا بما لم يأت في الكتب",84,"ب",1,0],["لئن مِتنا فإنَّ لنا قبوراً","ستحكي كلَّ قصتنا القبور",85,"ر",1,0],["لئن مرّت بنا أطيافُ حلْمٍ","تمادى النومُ للأحلامِ حَجْبا",86,"ب",2,0]]}