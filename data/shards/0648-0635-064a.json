html","الكامل"],[303,"أما والذي قد قدر البعد بيننا","https://www.aldiwan.net/poem56563.html","الطويل"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[311,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[318,"تعودت مس الضر حتى ألفته","https://www.aldiwan.net/poem67112.html","الطويل"],[346,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[351,"علام يلوم العاذلون على وجدي","https://www.aldiwan.net/poem40389.html","الطويل"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[369,"جزعت فجزع دمع عينك بالدم","https://www.aldiwan.net/poem57157.html","الطويل"],[374,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[374,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[374,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[377,"الحمد لله الذي حمده","https://www.aldiwan.net/poem48751.html","السريع"],[388,"وصيتي يا علي","https://www.aldiwan.net/poem54589.html","عموديه"],[390,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[400,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[400,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[400,"وحرق عمدا للدلائل دفترا","https://www.aldiwan.net/poem33955.html","الطويل"],[402,"ألم تر ما أتاه أبو علي","https://www.aldiwan.net/poem49910.html","الوافر"],[413,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[413,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[426,"لعمرك يا أخا الأشواق أنا","https://www.aldiwan.net/poem40258.html","الوافر"],[426,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[426,"للصيد فضل في ثمان فوائد","https://www.aldiwan.net/poem40762.html","الكامل"],[426,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[436,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[468,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4795.html","الخفيف"],[498,"أبو السبطين جلجلة التجلي","https://www.aldiwan.net/poem37667.html","الوافر"],[498,"ما قول هند إذا ما صدها القدر","https://www.aldiwan.net/poem37697.html","البسيط"],[498,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[498,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[498,"لعمري أبو العباس أعلم من طوى","https://www.aldiwan.net/poem38100.html","الطويل"],[498,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[549,"عرفت ويا ليتني ما عرفت","https://www.aldiwan.net/poem47382.html","المتقارب"],[549,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[556,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[556,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["وَصَيِّراني سَبَباً إِلى العُلى","إِنِّيَ عَينُ البَطَلِ الحُلاحِلِ",0,"ل",1,0],["وصيّرَ أوْثانَ الضّلالةِ خُضَّعا","إلَيْها فلمْ يتْرُكْ سُواعاً ولا وُدّا",1,"د",2,0],["وَصَيَّرْتَ صَعْبَ الشَّرْقِ لِلْغَرْبِ هَيِّناً","وَكُنْتَ مُسِرّاً لِلْخُلُوصِ وَمعْلِنَا",2,"ن",2,0],["وَصيحَ عَلَينا بِالسِياطِ وَبِالقَنا","إِلى غايَةٍ مَرفوعَةٍ عِندَ مَوسِمِ",3,"م",1,0],["وَصَيَّرتَ مَنثورَ الكَواكِبَ في الدُجى","نَظيماً بِأَسلاكِ المَعاني مُنَضَّدا",4,"د",2,0],["وَصِيُّ النَبِيِّ المُصطَفى وَاِبنُ عَمِّهِ","وَفَكّاكُ أَغلالٍ وَقاضي مَغارِمِ",5,"م",1,0],["وصيد من الحيَّيْن أبناء قيلةٍ","تكفُّ العوادي أو تبيد الأعاديا",6,"ي",2,0],["وَصِيَّةَ عَمّي بِاِبنِ خِلٍّ فَلا تَرُم","مَساعِيَ قَومٍ لَيسَ مِنكَ سِجالُها",7,"ل",3,0],["وَصُيِّرَت بَينَهُم شورى كَأَنَّهُمُ","لا يَعرِفونَ وُلاةُ الحَقِّ أَيَّهُمُ",8,"م",1,0],["وصيرني الواشون حتى حذرتهم","فها أنا مقتولٌ على حبه صبرا",9,"ر",2,0],["وَصِيفٌ وإبريقٌ رذُومٌ ومُرشقٌ","على شرف كلُّ الثلاثة أجْيَدُ",10,"د",1,0],["وَصَيَّرَ لي ذِكراً جَميلاً لِأَنَّني","أُحَسِّنُ أَفعالي لِتُسمَعَ أَسمائي",11,"ي",1,0],["وصيروه مثالا بعده حسنا","يبقى مدى الدهر عنوان المكافاة",12,"ه",1,0],["وَصَيَّروا المُلكَ إِلى صِبيانهم","فَوَجَد الفَرصة مَن لَهُ صَبا",13,"ا",1,0],["وَصيفَةَ فِرعَونَ في ساحَةٍ","مِنَ القَصرِ واقِفَةً تَرتَقِب",14,"ب",1,0],["وَصَيَّروا الدَهرَ هُزءاً يَسخَرونَ بِهِ","حَتّى يَنالَ لَهُم بِالهَدمِ بُنيانا",15,"ن",2,0],["وَصينَ جَلالُ المُلكِ وَاِمتَدَّ عِزُّهُ","وَدامَ عَلَيهِ الحُسنُ وَالحَسَناتُ",16,"ت",1,0],["وصيّرتُ رأيي بعد عزميَ رائِدي","وخلّفت آراءً توالَت بمَسمَعي",17,"ع",2,0],["وَصَيقَلُ آراءٍ يَبيتُ يَكُدُّها","وَيَشحَذُها شَحذَ المُدى لِلنَوائِبِ",18,"ب",1,0],["وَصيفَةٌ في النِساءِ رودٌ","كَأَنَّها خِفَّةً وَصيفُ",19,"ف",1,0],["وَصِيَّتَهُ إِذ قالَ هَل أَنتَ مُخبِرٌ","عَنِ الناسِ ما أَمسوا بِهِ يا اِبنَ غالِبِ",20,"ب",1,0],["وَصِيَّةَ ثاني اِثنَينِ بَعدَ مُحَمَّدٍ","ضِرابَ كِرامٍ غَيرَ عُزلٍ وَلا نُكبِ",21,"ب",1,0],["وَصَيَّرتَ ذا فَقرٍ غَنِيّاً وَمُثرِياً","فَقيراً وَكُلّاً قَد حَذَوتَ بِلا وَعدِ",22,"د",1,0],["وَصُيّابَةُ السَعدَينِ حَولي قُرومُها","وَمِن مالِكٍ تُلقى عَلَيَّ الشَراشِرُ",23,"ر",1,1],["وَصِيَّةً مِن أَبي حَفصٍ لِسِتَّتِهِم","كانوا أَحِبّاءَ مَهدِيٍّ وَمَأمورِ",24,"ر",1,0],["وصَيامٌ أزعجَت بارحَه","سانحاتٌ الفِطرِ من حيثُ سَنَح",25,"ح",1,0],["وَصَيَّرَني يَأسي مِنَ الناسِ راجِياً","لِسُرعَةِ لُطفِ اللَهِ مِن حَيثُ لا أَدري",26,"ي",1,0],["وَصَيَّرَهُ دونَ الأَنامِ أَخاً لَهُ","وَصِنواً وَفيهِم مَن لَهُ دونَهُ الفَضلُ",27,"ل",1,0],["وَصَيَّرَ جَأشَهُ في البِيدِ جَيشاً","وَمِن حَزمِ الأُمورِ لَهُ رَبايا",28,"ا",3,0],["وصيامٌ بكلّ مطلَع شمسٍ","قيامٌ بكلّ مطلع نجمِ",29,"م",1,0],["وصِيدٍ يصيدون الفوارسَ بالقنا","إذا نَكَلَ الأبطالُ في الرّوْعِ أقدموا",30,"م",3,0],["وصَيّرَ في إقحامهِ مهجَ العدى","تسيلُ على مذلوقةِِ الأسَل السُّمرِ",31,"ر",1,0],["وَصَيَّروا الأَبرُجَ العُليا مُرَتَّبَةً","ما كانَ مُنقَلِباً أَو غَيرَ مُنقَلِبِ",32,"ب",1,0],["وَصَيَّرَها مِحنَةً لِلوَرى","تَغُرُّ الغَوِيَّ بِغَزواتِها",33,"ت",3,0],["وَصَيدُنا ظِباءٌ","كَأَنَّها الصَباحُ",34,"ح",1,0],["وَصَيدِ البازِ وَالشاهي","نِ وَالأَكلُبِ وَالفَهدِ",35,"د",1,0],["وَصَيدٌ بَأَسفَعَ شاكي السِلاحِ","سَريعِ الإِغارَةِ وَالشَدَّه",36,"د",2,0],["وَصَيَّرنا عَلى السَبَقِ","مَكانَ القَصَبِ الآسا",37,"س",2,0],["وَصيفُ كَأسٍ مُحَدِّثٌ وَلَها","تيهُ مُغَنٍّ وَظُرفُ زِنديقِ",38,"ق",1,0],["وَصيفَةٌ كَالغُلامِ تَصلُحُ لِل","أَمرَينِ كَالغُصنِ في تَثَنّيها",39,"ي",3,0],["وَصِيَّةُ مَن أَراهُ عَلَيَّ رَبّاً","وَعَهدٌ لا يَنامُ بِهِ الوَفاءُ",40,"ا",2,0],["وَصَيَّرَتهُ مَلِكاً هُماما","حَتّى عَلا وَجاوَزَ الأَقواما",41,"م",2,0],["وَصَيَّرَ جَفناً جَفنَهُ وَغِرارَهُ","غِراراً لِعَينَيهِ وَشَفرَتَهُ شُفرا",42,"ر",2,0],["وَصَيَّروا لِأُناسٍ في الأَذى طُرُقاً","وَذَلَّلوا الإِثمَ إِعمالاً وَتَطريقا",43,"ق",2,0],["وصَيَّرتهُ طارقا","تُ السقم وَقراً مُتعِبا",44,"ب",2,0],["وصيّر الدمعَ في المآقي","على ابتساماتهِ يذوب",45,"ب",1,0],["وصيَّرني سِحرُ هذا الهوى","وبي قوةُ القادرِ الظّافرِ",46,"ر",1,0],["وصيحةُ مُخفقةٍ في الهوى","مُعَربدةِ الرُّوحِ سكرَى اللسانْ",47,"ن",1,0],["وصيّر البيت سليب الحقّ","والآل من سيادة لرقّ",48,"ق",1,0],["وَصِياحُ القَومِ فيهِ","وَهوَ لِلأَبطالِ داني",49,"ي",1,0],["وَصِيِّ مُحَمَّدٍ بِأَبي وَأُمّي","وَأَكرَمِ مَن مَشى بَعدَ النَبِيِّ",50,"ي",1,0],["وصَيَّرْتُ أنّاتي تفاعيلَ بحرِهِ","وجِئْتُ بوَزْنٍ في القَريضِ عجيبِ",51,"ب",1,0],["وصيحةٌ كالردى مباغتة","لا نابه ردّها ولا ظفره",52,"ر",2,0],["وصيَّرَ أقواتَها قسمةً","وما كان أعدَ لَهُ إذ قَسَمْ:",53,"م",1,0],["وصيتٍ من العواتك لا تن","هاه إلا مبيضةٌ رعلاء",54,"ا",2,0],["وَصيقل أَرواحِنا رَخيم لَفظُهُ","وَفي كُؤُوس البَسط مِنها حَبب",55,"ب",1,0],["وصياد القلوب ابو علي","تلاه يميس بالهمم الضخام",56,"م",1,0],["وصيرتني مضنى وحيرت فكرتي","فلم يعترف قلبي بشيء سوى الحب",57,"ب",1,0],["وصى رسول اللَه حيدرة الذي","مناقيد في كل تكرمةٍ تقرا",58,"ر",2,0],["وصيرني طلاب العلم","علامة إِملاق",59,"ق",1,0],["وصَيَّرَ سَاقَهُ السَّاقِى جُذَاذاً","وإِذَا المِفرَاجُ مُلتَهِب الفُؤَادِ",60,"د",1,0],["وَصَيَّرتُكُم في خَالِصِ الوِدِّ أولاً","وَقَّربتُكُم عن كل خِلٍّ مُقَرَّبِ",61,"ب",1,0],["وَصَيَّرَت قَصرَكَ العافونَ مَوطِنَهُم","إِذا مَضَت عُصَبٌ مِنها أَتَت عُصَبُ",62,"ب",1,0],["وَصَيَّرتَهُ لِلأَمنِ رَبعاً وَقَبلَها","غَدا لِذُيولِ الخَوفِ وَهوَ مَساحِبُ",63,"ب",1,0],["وَصَيَّرتُمُ البَذلَ الَذي شاعَ ذِكرُهُ","مُضافاً إِلى العَدلِ الَّذي يوجِبُ الخُلدا",64,"د",2,0],["وَصّى بِها حَيدانُ مَهرَةَ سالِفاً","وَنَمى الجَديلُ أُصولَها وَالعيدُ",65,"د",1,0],["وَصّى بِذاكَ الحاكِمُ العَدلُ اِبنَهُ","قِدماً وَأَوصى الظاهِرُ المُستَنصِرا",66,"ر",2,0],["وَصَيَّرَها تِبرُ الكَلامِ وَدُرُّهُ","عَلى هامَةِ العَلياءِ تاجاً مُرَصَّعا",67,"ع",2,0],["وَصَيَّرَهُ كَيما يُخَلِّدَ مَجدَهُ","تَلوذُ بِهِ الأَبصارُ في الحَشرِ وَحدَهُ",68,"ه",1,0],["وَصيَّرتُ أَجْفاني وِطاءً لِوَطْئِها","حذاراً عليها من صروف النوائبِ",69,"ب",1,0],["وصيرتم في الواعظات مواعظاً","لعبس وعبس غير خافية عنكا",70,"ك",2,0],["وصير أرض الواعظات وواسطا","مواعظ تنهى من تزل به الرجل",71,"ل",1,0],["وصير قحرا ثم غنما وعافقا","ترابا وطينا لا تشاك بها رجل",71,"ل",1,0],["وصير لي في كل أرض بعيدة","جوارك ما يشجي الحسود من الأنبا",72,"ب",2,0],["وصير العلم لي شغلا وكلفني","حلا لرمز وتسهيلا لما صعبا",73,"ب",2,0],["وَصَيَّرَني لِما أَلقاهُ أَرضى","مِن التَمرينِ أَسرَتنا وَسادا",74,"د",2,0],["وصَيَّرني مهما شَممت نَسيمكم","أَشُدُّ لقلبي راحتي وأَميد",75,"د",1,0],["وصيغَ شبابهم ذهباً أليستْ","على الدينارِ زخرفةُ الشبابِ",76,"ب",1,0],["وصيغ أعلاه من نورٍ ومن ظُلَمٍ","وجهاً وفرعاً يمجُّ المسك والبانا",77,"ن",2,0],["وصيحه الغر في بدر بطلعته","تهللوا ولهم بالنصر تكميل",78,"ل",1,0],["وصيرتهم نهب الصوارم والقنا","فلا غرو ان دانت لك البيض والسمر",79,"ر",1,0],["وصيرتني لا صرت مثلي عبرةً","لكلّ ألوف الروح جمّ العلائق",80,"ق",1,0],["وَصيحوا بِهِ رُدَّ ما قَد","سَرَ