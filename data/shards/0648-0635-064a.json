لى غايَةٍ مَرفوعَةٍ عِندَ مَوسِمِ",3,"م",1,0],["وَصَيَّرتَ مَنثورَ الكَواكِبَ في الدُجى","نَظيماً بِأَسلاكِ المَعاني مُنَضَّدا",4,"د",2,0],["وَصِيُّ النَبِيِّ المُصطَفى وَاِبنُ عَمِّهِ","وَفَكّاكُ أَغلالٍ وَقاضي مَغارِمِ",5,"م",1,0],["وصيد من الحيَّيْن أبناء قيلةٍ","تكفُّ العوادي أو تبيد الأعاديا",6,"ي",2,0],["وَصِيَّةَ عَمّي بِاِبنِ خِلٍّ فَلا تَرُم","مَساعِيَ قَومٍ لَيسَ مِنكَ سِجالُها",7,"ل",3,0],["وَصُيِّرَت بَينَهُم شورى كَأَنَّهُمُ","لا يَعرِفونَ وُلاةُ الحَقِّ أَيَّهُمُ",8,"م",1,0],["وصيرني الواشون حتى حذرتهم","فها أنا مقتولٌ على حبه صبرا",9,"ر",2,0],["وَصِيفٌ وإبريقٌ رذُومٌ ومُرشقٌ","على شرف كلُّ الثلاثة أجْيَدُ",10,"د",1,0],["وَصَيَّرَ لي ذِكراً جَميلاً لِأَنَّني","أُحَسِّنُ أَفعالي لِتُسمَعَ أَسمائي",11,"ي",1,0],["وصيروه مثالا بعده حسنا","يبقى مدى الدهر عنوان المكافاة",12,"ه",1,0],["وَصَيَّروا المُلكَ إِلى صِبيانهم","فَوَجَد الفَرصة مَن لَهُ صَبا",13,"ا",1,0],["وَصيفَةَ فِرعَونَ في ساحَةٍ","مِنَ القَصرِ واقِفَةً تَرتَقِب",14,"ب",1,0],["وَصَيَّروا الدَهرَ هُزءاً يَسخَرونَ بِهِ","حَتّى يَنالَ لَهُم بِالهَدمِ بُنيانا",15,"ن",2,0],["وَصينَ جَلالُ المُلكِ وَاِمتَدَّ عِزُّهُ","وَدامَ عَلَيهِ الحُسنُ وَالحَسَناتُ",16,"ت",1,0],["وصيّرتُ رأيي بعد عزميَ رائِدي","وخلّفت آراءً توالَت بمَسمَعي",17,"ع",2,0],["وَصَيقَلُ آراءٍ يَبيتُ يَكُدُّها","وَيَشحَذُها شَحذَ المُدى لِلنَوائِبِ",18,"ب",1,0],["وَصيفَةٌ في النِساءِ رودٌ","كَأَنَّها خِفَّةً وَصيفُ",19,"ف",1,0],["وَصِيَّتَهُ إِذ قالَ هَل أَنتَ مُخبِرٌ","عَنِ الناسِ ما أَمسوا بِهِ يا اِبنَ غالِبِ",20,"ب",1,0],["وَصِيَّةَ ثاني اِثنَينِ بَعدَ مُحَمَّدٍ","ضِرابَ كِرامٍ غَيرَ عُزلٍ وَلا نُكبِ",21,"ب",1,0],["وَصَيَّرتَ ذا فَقرٍ غَنِيّاً وَمُثرِياً","فَقيراً وَكُلّاً قَد حَذَوتَ بِلا وَعدِ",22,"د",1,0],["وَصُيّابَةُ السَعدَينِ حَولي قُرومُها","وَمِن مالِكٍ تُلقى عَلَيَّ الشَراشِرُ",23,"ر",1,1],["وَصِيَّةً مِن أَبي حَفصٍ لِسِتَّتِهِم","كانوا أَحِبّاءَ مَهدِيٍّ وَمَأمورِ",24,"ر",1,0],["وصَيامٌ أزعجَت بارحَه","سانحاتٌ الفِطرِ من حيثُ سَنَح",25,"ح",1,0],["وَصَيَّرَني يَأسي مِنَ الناسِ راجِياً","لِسُرعَةِ لُطفِ اللَهِ مِن حَيثُ لا أَدري",26,"ر",2,0],["وَصَيَّرَهُ دونَ الأَنامِ أَخاً لَهُ","وَصِنواً وَفيهِم مَن لَهُ دونَهُ الفَضلُ",27,"ل",1,0],["وَصَيَّرَ جَأشَهُ في البِيدِ جَيشاً","وَمِن حَزمِ الأُمورِ لَهُ رَبايا",28,"ا",3,0],["وصيامٌ بكلّ مطلَع شمسٍ","قيامٌ بكلّ مطلع نجمِ",29,"م",1,0],["وصِيدٍ يصيدون الفوارسَ بالقنا","إذا نَكَلَ الأبطالُ في الرّوْعِ أقدموا",30,"م",3,0],["وصَيّرَ في إقحامهِ مهجَ العدى","تسيلُ على مذلوقةِِ الأسَل السُّمرِ",31,"ر",1,0],["وَصَيَّروا الأَبرُجَ العُليا مُرَتَّبَةً","ما كانَ مُنقَلِباً أَو غَيرَ مُنقَلِبِ",32,"ب",1,0],["وَصَيَّرَها مِحنَةً لِلوَرى","تَغُرُّ الغَوِيَّ بِغَزواتِها",33,"ت",3,0],["وَصَيدُنا ظِباءٌ","كَأَنَّها الصَباحُ",34,"ح",1,0],["وَصَيدِ البازِ وَالشاهي","نِ وَالأَكلُبِ وَالفَهدِ",35,"د",1,0],["وَصَيدٌ بَأَسفَعَ شاكي السِلاحِ","سَريعِ الإِغارَةِ وَالشَدَّه",36,"د",2,0],["وَصَيَّرنا عَلى السَبَقِ","مَكانَ القَصَبِ الآسا",37,"س",2,0],["وَصيفُ كَأسٍ مُحَدِّثٌ وَلَها","تيهُ مُغَنٍّ وَظُرفُ زِنديقِ",38,"ق",1,0],["وَصيفَةٌ كَالغُلامِ تَصلُحُ لِل","أَمرَينِ كَالغُصنِ في تَثَنّيها",39,"ي",3,0],["وَصِيَّةُ مَن أَراهُ عَلَيَّ رَبّاً","وَعَهدٌ لا يَنامُ بِهِ الوَفاءُ",40,"ا",2,0],["وَصَيَّرَتهُ مَلِكاً هُماما","حَتّى عَلا وَجاوَزَ الأَقواما",41,"م",2,0],["وَصَيَّرَ جَفناً جَفنَهُ وَغِرارَهُ","غِراراً لِعَينَيهِ وَشَفرَتَهُ شُفرا",42,"ر",2,0],["وَصَيَّروا لِأُناسٍ في الأَذى طُرُقاً","وَذَلَّلوا الإِثمَ إِعمالاً وَتَطريقا",43,"ق",2,0],["وصَيَّرتهُ طارقا","تُ السقم وَقراً مُتعِبا",44,"ب",2,0],["وصيّر الدمعَ في المآقي","على ابتساماتهِ يذوب",45,"ب",1,0],["وصيَّرني سِحرُ هذا الهوى","وبي قوةُ القادرِ الظّافرِ",46,"ر",1,0],["وصيحةُ مُخفقةٍ في الهوى","مُعَربدةِ الرُّوحِ سكرَى اللسانْ",47,"ن",1,0],["وصيّر البيت سليب الحقّ","والآل من سيادة لرقّ",48,"ق",1,0],["وَصِياحُ القَومِ فيهِ","وَهوَ لِلأَبطالِ داني",49,"ن",2,0],["وَصِيِّ مُحَمَّدٍ بِأَبي وَأُمّي","وَأَكرَمِ مَن مَشى بَعدَ النَبِيِّ",50,"ي",1,0],["وصَيَّرْتُ أنّاتي تفاعيلَ بحرِهِ","وجِئْتُ بوَزْنٍ في القَريضِ عجيبِ",51,"ب",1,0],["وصيحةٌ كالردى مباغتة","لا نابه ردّها ولا ظفره",52,"ر",2,0],["وصيَّرَ أقواتَها قسمةً","وما كان أعدَ لَهُ إذ قَسَمْ:",53,"م",1,0],["وصياحُ الأطفال -والأَبُ غَافٍ-","نَغَمَاتٌ شجيَّة وغنَاءُ",54,"ا",2,0],["وصيتٍ من العواتك لا تن","هاه إلا مبيضةٌ رعلاء",55,"ا",2,0],["وصيت على الجبل الشموخ أشعّة","مسحورة كطفولة القبلات",56,"ت",1,0],["وصير البحر لنا منزلاً","فنحن ضيفان على موجتين",57,"ن",1,0],["وَصيقل أَرواحِنا رَخيم لَفظُهُ","وَفي كُؤُوس البَسط مِنها حَبب",58,"ب",1,0],["وصياد القلوب ابو علي","تلاه يميس بالهمم الضخام",59,"م",1,0],["وصيرتني مضنى وحيرت فكرتي","فلم يعترف قلبي بشيء سوى الحب",60,"ب",1,0],["وصى رسول اللَه حيدرة الذي","مناقيد في كل تكرمةٍ تقرا",61,"ر",2,0],["وصيرني طلاب العلم","علامة إِملاق",62,"ق",1,0],["وصَيَّرَ سَاقَهُ السَّاقِى جُذَاذاً","وإِذَا المِفرَاجُ مُلتَهِب الفُؤَادِ",63,"د",1,0],["وَصَيَّرتُكُم في خَالِصِ الوِدِّ أولاً","وَقَّربتُكُم عن كل خِلٍّ مُقَرَّبِ",64,"ب",1,0],["وَصَيَّرَت قَصرَكَ العافونَ مَوطِنَهُم","إِذا مَضَت عُصَبٌ مِنها أَتَت عُصَبُ",65,"ب",1,0],["وَصَيَّرتَهُ لِلأَمنِ رَبعاً وَقَبلَها","غَدا لِذُيولِ الخَوفِ وَهوَ مَساحِبُ",66,"ب",1,0],["وَصَيَّرتُمُ البَذلَ الَذي شاعَ ذِكرُهُ","مُضافاً إِلى العَدلِ الَّذي يوجِبُ الخُلدا",67,"د",2,0],["وَصّى بِها حَيدانُ مَهرَةَ سالِفاً","وَنَمى الجَديلُ أُصولَها وَالعيدُ",68,"د",1,0],["وَصّى بِذاكَ الحاكِمُ العَدلُ اِبنَهُ","قِدماً وَأَوصى الظاهِرُ المُستَنصِرا",69,"ر",2,0],["وَصَيَّرَها تِبرُ الكَلامِ وَدُرُّهُ","عَلى هامَةِ العَلياءِ تاجاً مُرَصَّعا",70,"ع",2,0],["وَصَيَّرَهُ كَيما يُخَلِّدَ مَجدَهُ","تَلوذُ بِهِ الأَبصارُ في الحَشرِ وَحدَهُ",71,"ه",1,0],["وَصيَّرتُ أَجْفاني وِطاءً لِوَطْئِها","حذاراً عليها من صروف النوائبِ",72,"ب",1,0],["وصيرتم في الواعظات مواعظاً","لعبس وعبس غير خافية عنكا",73,"ك",2,0],["وصير أرض الواعظات وواسطا","مواعظ تنهى من تزل به الرجل",74,"ل",1,0],["وصير قحرا ثم غنما وعافقا","ترابا وطينا لا تشاك بها رجل",74,"ل",1,0],["وصير لي في كل أرض بعيدة","جوارك ما يشجي الحسود من الأنبا",75,"ب",2,0],["وصير العلم لي شغلا وكلفني","حلا لرمز وتسهيلا لما صعبا",76,"ب",2,0],["وَصَيَّرَني لِما أَلقاهُ أَرضى","مِن التَمرينِ أَسرَتنا وَسادا",77,"د",2,0],["وصَيَّرني مهما شَممت نَسيمك