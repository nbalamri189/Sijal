{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"كل زرع فإنه للحصاد","https://www.aldiwan.net/poem10885.html","الخفيف"],[93,"ما لهند وكل حسناء هند","https://www.aldiwan.net/poem8807.html","عموديه"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[469,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133857","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108772","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201536","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121639","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97927","الرمل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216539",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83195","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66164","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[5912,"عرس القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=205015",""],[6102,"لا نامت أعين الجبناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=184861",""]],"verses":[["كلّ زمانٍ يتقضَّى بالجذلْ","زمان عيش كيفما دارَ اعْتدلْ",0,"ل",1,0],["كلُّ زرعٍ فإنه للحصادِ","والمنايا روائح وغوادي",1,"د",2,1],["كُلُّ زَوجٍ شاك وَكُلُّ صَغيرٍ","دامِعِ الطَرفِ كارِهٍ لِلوُجودِ",2,"د",1,0],["كلُّ زهرٍ يَضُوعُ منهُ أَريجٌ","من بخُورِ الرَّبيعِ جَمُّ الفُتونِ",3,"ن",1,0],["كلُّ زنجيَّةٍ كأن سوادَ ال","لَيلِ أهدَى لها سوادَ الإهابِ",4,"ب",1,0],["كُلُّ زِحافٍ كانَ في حَرفَينِ","حَلَّ مِنَ الجُزءِ بمَوْضِعَينِ",5,"ن",1,0],["كلُّ زمانِ عامِها ربيعُها","لا جدبُ شهباء ولا إعصارُها",6,"ر",3,0],["كلٌّ زعيمٌ في العلى","ولهُ على القوم الزّعامة",7,"م",2,0],["كل زمان قبل أن نلتقي","أبعد يا حلو من الأبعد",8,"د",1,0],["كل زهرٍ يزيد في الموت حسناً","كبدور تمامها في المحاق",9,"ق",1,0],["كلّ زاد الميت السعيد من الأه","ل إزارٌ وقبضة من نواح",10,"ح",1,0],["كلُّ زَرْعٍ زَرَعْتُه في شبابِي","فله مِنْجَلُ انْحِنائِيَ حَاصِدْ",11,"د",1,0],["كل زوجين كأمي وأبي","في التقى والسن كانا والدي",12,"ي",1,0],["كِلّ زين مَعْ زينه تْخَرَّبْ","كِلّه ابْراك لْطَيّب الفال",13,"ل",1,0],["كُلُّ زَخارِيفِ الحَياة زُورُ","وَكُلُّ مَن صَبا لَها مَغرورُ",14,"ر",1,0],["كلُّ زَهْرٍ في جَنَّةِ الحُبِّ عَبْدٌ","ناكِسُ الرَّأْسِ خادِمٌ قَدَمَيْها",15,"ي",3,0],["كلُّ زَهْرٍ خادِمٌ وهْيَ الأَمِيرْ","باسِطاً كَفَّ العَطايا للرَّعِيَّه",16,"ه",1,0],["كل زوّاري ذكور","ليس فيهم من إناث",17,"ث",1,0],["كل زهر فيه الجمال يثار","تتهاوى من عطره أسرار",18,"ر",1,1],["كُلُّ زَعِيمٍ بِكُلِّ ما ارتَهَنَتْ","أَهواؤُهُ- مَعْ شَيطانِهِ- ارتَهَنا",19,"ن",2,0]]}