{"poems":[[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"كل زرع فإنه للحصاد","https://www.aldiwan.net/poem10885.html","الخفيف"],[91,"ما لهند وكل حسناء هند","https://www.aldiwan.net/poem8807.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[464,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"]],"verses":[["كلّ زمانٍ يتقضَّى بالجذلْ","زمان عيش كيفما دارَ اعْتدلْ",0,"ل",1,0],["كلُّ زرعٍ فإنه للحصادِ","والمنايا روائح وغوادي",1,"د",2,1],["كُلُّ زَوجٍ شاك وَكُلُّ صَغيرٍ","دامِعِ الطَرفِ كارِهٍ لِلوُجودِ",2,"د",1,0],["كلُّ زهرٍ يَضُوعُ منهُ أَريجٌ","من بخُورِ الرَّبيعِ جَمُّ الفُتونِ",3,"ن",1,0],["كلُّ زنجيَّةٍ كأن سوادَ ال","لَيلِ أهدَى لها سوادَ الإهابِ",4,"ب",1,0],["كُلُّ زِحافٍ كانَ في حَرفَينِ","حَلَّ مِنَ الجُزءِ بمَوْضِعَينِ",5,"ن",1,0],["كلُّ زمانِ عامِها ربيعُها","لا جدبُ شهباء ولا إعصارُها",6,"ر",3,0],["كلٌّ زعيمٌ في العلى","ولهُ على القوم الزّعامة",7,"م",2,0]]}