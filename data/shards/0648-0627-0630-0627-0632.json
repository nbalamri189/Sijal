{"poems":[[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[66,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[75,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[46,"ما لي غدوت كقاف رؤبة قيدت","https://www.aldiwan.net/poem22007.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[141,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[191,"ربما أمتع القليل","https://www.aldiwan.net/poem13080.html","مجزوء الخفيف"],[193,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[250,"لا يبخلون بزادهم عن سائل","https://www.aldiwan.net/poem1452.html",""],[364,"ليس في الأرض ما يفوق سوى الشام","https://www.aldiwan.net/poem17892.html","الخفيف"],[388,"يا عمران زرت سيدنا الرسول","https://www.aldiwan.net/poem54519.html","عموديه"],[400,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[436,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[456,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[527,"ولد المرء لا يبالي إذا ما","https://www.aldiwan.net/poem37511.html","الخفيف"],[549,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[549,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[560,"واحد في الحمى فدته ألوف","https://www.aldiwan.net/poem52775.html","الخفيف"]],"verses":[["وَإِذا زَعزَعَها الدَهرُ سَمَت","لَدنَةً تَنمي عَلى طولِ القِدَم",0,"م",1,0],["وإذا زجَروها مُعْرِقينَ فهَل سَروا","بشَطِّ دُجيْلٍ أم أجازوا على الجِسْرِ",1,"ر",1,0],["وإذا زَلَّةً لكم دَفَن الده","رُ أملّوا بنَبْشِها الأقلاما",2,"م",2,0],["وإذا زاول الأمورَ فثَبْتٌ","رابطُ الجأش أَيِّد الأركان",3,"ن",1,0],["وَإِذا زُرتِني وَأَبصَرتِ وَجهي","قَد مَحا المَوتُ شَكَّهُ وَقينَه",4,"ن",2,0],["وَإِذا زارَ مَجلِساً لَكَ فَدمٌ","مِنهُمُ غَيرُ مولَعٍ بِمُدامِ",5,"م",1,0],["وَإذَا زَارَ حبيبٌ مُحِبَّاً","لا تَسَلْ عن زائرٍ كَيفَ آبا",6,"ب",2,0],["وإذا زَعْزَعَ الوَشيجَ وألقْىَ","بجِرَانٍ عَلى الأعادي وبَرْك",7,"ك",1,0],["وَإِذا زَجَرتُ النَفسَ عَن شَغَفٍ بِها","فَكَأَنَّ زَجرَ غَويِّها إِغراؤُها",8,"ا",3,0],["وَإِذَا زَكَّى فَجَارِي دَمِهِ","فِي سَبيلِ الوَطَنِ الحُرِّ زَكَاةُ",9,"ه",1,0],["وَإِذا زَفَفتُ إِلى نَدِيِّكَ كاعِباً","أَثنى عَلَيَّ بِحُسنِها حُضّارُهُ",10,"ر",2,0],["وَإِذا زادَ كَثرَةً","وَعَدا القَدرَ أَتلَفا",11,"ف",2,0],["وَإِذا زاغَ عَنكَ مِنهُم طَريدٌ","طاحَ ثُمَّ اِرتَمَت بِهِ الأَرجاءُ",12,"ا",2,0],["وَإِذا زِنادُ الحَربِ أَخمدَ نارَها","قَدَحوا بِأَطراف الأَسِنَّةِ نارا",13,"ر",2,0],["وَإِذا زُرتِ غُلَّتي بِنَسيمِ","قامَ بَينَ الحَشا مَقامَ العِناقِ",14,"ق",1,0],["وإذا زرتم قبا أو أحدا","فهبولي وفروعي والأصول",15,"ل",1,0],["وإذا زفت من النحو إلى","خيمة الأفكار",16,"ر",1,0],["وإِذا زَجَرْتَ ليُمنِ يَومِكَ طائراً","حُشرَتْ إِليكَ بِيُمنِها الأَطيارُ",17,"ر",1,0],["وإذا زكا حَسَبٌ لها","لم تخُتَدَعْ عنه بثروَهْ",18,"و",2,0],["وإذا زففتُ لديك من نحلاتها","عِظمَ الفصاحةِ في المقال الأعظمِ",19,"م",1,0],["وإذَا زَاغَ عَنْ طَرِيقِ صَوَابٍ","رَدَّهُ مُسْرِعاً طَرِيقَ الصَّوابِ",20,"ب",1,0],["وإذا زارَهُ العُفاةُ أصابو","هُ مَرادَ النّدى ومَحْنى العودِ",21,"د",1,0],["وإذا زاره الرّجالُ فلا زا","ل عليهم منه الذَّكاءُ يفوحُ",22,"ح",1,0],["وإذا زارَ فالخريفُ ربيعٌ","وإذا غابَ فالرَّبيعُ خريفُ",23,"ف",1,0]]}