{"poems":[[44,"وساجع في فروع الأيك هيجني","https://www.aldiwan.net/poem50282.html","البسيط"],[95,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[85,"وغريبة قطعت إليك على الونى","https://www.aldiwan.net/poem54295.html","الكامل"],[47,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[52,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[53,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[102,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[113,"فدا لك روحي من رشا متبرم","https://www.aldiwan.net/poem16245.html","الطويل"],[151,"خليلي وافت منكم ذات خلخال","https://www.aldiwan.net/poem47679.html","الطويل"],[214,"قدوم أتى باليسر والسعد مقبلا","https://www.aldiwan.net/poem13308.html","الطويل"],[369,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[580,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105617","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59813","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113972","الطويل"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33887","المنسرح"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10494","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121003","البسيط"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105333","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103480","الرجز"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112555","الرمل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99329","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81712","البسيط"],[4806,"ماخنت ابنظر","https://www.poetsgate.com/ViewPoem.aspx?id=190863",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6052,"ثمار الخير","https://www.poetsgate.com/ViewPoem.aspx?id=35377",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""]],"verses":[["مُوَشَّحٌ سُندُساً خُضرٌ مناكِبُهُ","تَرى مِنَ المِسكِ في أَذيالِهِ لُمَعا",0,"ع",2,0],["مُوَشَّحاً بِشُعَاع","أَوْ مُسْتَقِلاًّ سَحَابَهْ",1,"ب",2,0],["مُوَشَّحَةً حُقباً كَأَنَّ ظُهورَها","صَفا رَصفٍ مَجرى سُيولٍ دَوافِعِ",2,"ع",1,0],["موشيّة الأعطاف رائقة الحلى","رقمت بدائعها يدُ الأقدارِ",3,"ر",1,0],["موشِكٌ عَزمُهُ وَمِن حَسَبِ السَي","فِ إِذا هُزَّ أَن يُهَزَّ غِرارُه",4,"ر",2,0],["موشِّحٌ شبليك في عزّةٍ","قعساءَ مرماها بعيدُ المرام",5,"م",1,0],["مُؤَشَّرٍ طَيِّبِ المَذاقَةِ كَال","راحِ بِطَعمِ التُفّاحِ مُنجَرِدِ",6,"د",1,0],["موشحة بيضاء حاب حبيكها","لها حلق بعد الأنامل فاضل",7,"ل",1,0],["مُوشِكٌ فِي تَوَاضُعِ النَّفْسِ أَنْ","يُسْرِفَ لَولاَ جَلاَلُهُ المَوْفُورُ",8,"ر",1,0],["مُوشي بُرْد المدح شَرعَبيه","سَيفِّي وقع القِدْح نشابيِّه",9,"ب",3,0],["((موشى)) ما عاد هناك … هنا","وهنا ألفا ((موشى ديّان))",10,"ن",1,0],["مُوشَحة الأَعطاف حالية الطَلا","تَقلد عِقداً مِن دُموعي وَمِن دَمي",11,"م",2,0],["موشحة من طرزكم ببدائع","محجّبة عن كل ذي فطنة خال",12,"ل",1,0],["موشّعة تحلو بدر الندى الذي","علينا به قاضي القضاة تفضلا",13,"ل",2,0],["مَوشِيّةً وَشْيَ الرّياضِ وقد","سَحَبتْ عليها ذَيْلَها السُّحب",14,"ب",1,0],["موشحاً كلامه بالدرر","مكملاً ما قاله من غرر",15,"ر",1,0],["موشَّحَةً بأَرءَامٍ وأُسْدٍ","متوَّجةً براياتٍ وهامِ",16,"م",1,0],["موشَّحاتٌ ولكنْ من ذوائِبِه","لمَّا رآه مُحَشَّى الطرفِ بالكَحَلِ",17,"ل",1,0],["موشاةً جوانبُها بزَهْرٍ","أضرَّ بقيمةِ الوشي النفيس",18,"س",1,0],["موشحة أزرت بكل موشح","حديث رشيق اللفظ أو متقادم",19,"م",1,0],["موَشراً ذا غروب","عُلَّ بمسك وخمر",20,"ر",1,0],["موشّح برداء النصر متخذ","بعزة الأكرمين الروح والذات",21,"ت",1,0],["مُؤَشِّرَةُ الأنيابِ مهضوبَةُ الحَشى","بعيدةُ مهوى القُرطِ رَيّا خلاخِلا",22,"ل",2,0],["موشى تخال به مطرفاً","بديع التفاويف والنمنمه",23,"م",2,0],["مَوشِيَّةً لَم أَزَل بِبائِعِها","أُرغِبُ حَتّى زَها عَلَيَّ بِيَه",24,"ي",2,0],["مُوَشَّحَةٌ جَيداءُ يَقصُرُ سَربَها","عِضاةٌ مُشيرٌ بِالرَبيعِ وَمُفتِلُ",25,"ل",1,1],["مَوشِيُّ ثَوبٍ طواه الدَّهرُ آوِنَةً","فها هو اليوم للأبصار ناشرُهُ",26,"ر",2,0],["موشحة في ساعدي وحمائلي","سواعدها والثغر منها على ثغري",27,"ر",2,0],["موشيَّةِ الصُدورِ والعَواتقِ","بكُلِّ وَشيٍ فاخِرٍ وفائِقِ",28,"ق",1,0],["موشك ركبي إلى هذي الرحاب","تنقضي الدنيا ولله المآب",29,"ب",1,1],["موشي اثواب الجمال بالغيد","وفر حظ جيده من الجيد",30,"د",1,0],["موشَّحٌ ضاحكته غُرَّةُ الفلق","لما سَهرتُ له في آخر الغسقِ",31,"ق",1,1],["مو شرط بجسد إلا اليخون يخون","اكو بنية البشر نوبات تلگة ازروف",32,"ف",1,0],["موشحة بطيوف العفاء","كأن بها جنة باديه",33,"ي",2,0],["موشك أن يحظى بظل جنابهم","وأحرى محب عاشق للحقيقة",34,"ه",1,0],["موشومة بجناح الروح صورته","أنفاسه بالتقى والخير تتسم",35,"م",1,0],["موشح الخصر كم قريضي","مسمط الثغر منك زين",36,"ن",1,0]]}