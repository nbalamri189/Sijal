{"poems":[[85,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[74,"لله خال على خد الحبيب له","https://www.aldiwan.net/poem18447.html","البسيط"],[53,"لله خالد الطائي من رجل","https://www.aldiwan.net/poem8141.html","البسيط"],[53,"لله خالد الطائي من رجل","https://www.aldiwan.net/poem8687.html","البسيط"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[68,"لله خط كتاب خلته دررا","https://www.aldiwan.net/poem40653.html","البسيط"],[139,"لله خط قويم الشكل رونقه","https://www.aldiwan.net/poem49019.html","البسيط"],[189,"لله خد بدت من حسنه حجج","https://www.aldiwan.net/poem14648.html","البسيط"],[237,"يا قبلتي جدلي بقبله","https://www.aldiwan.net/poem14755.html","مجزوء الكامل"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[358,"ليهن ورق الحمى في الأيك تغريد","https://www.aldiwan.net/poem40400.html","البسيط"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[409,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[435,"لله خير جراءة","https://www.aldiwan.net/poem40718.html","مجزوء الكامل"],[463,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[519,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39088","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37718","المنسرح"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143131","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136253","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79807","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95378","الكامل"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132171","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53199","البسيط"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105407","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100503","الرجز"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100500","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100492","السريع"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109826","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134014","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132551","السريع"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138788",""],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141904","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85161","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85104","المجتث"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114447","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102984","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127358","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94487","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83529","الكامل"],[4818,"ذات الخال","https://www.poetsgate.com/ViewPoem.aspx?id=204637",""],[4578,"الآن حققت إن الشمس تنكشف","https://www.poetsgate.com/ViewPoem.aspx?id=49484",""],[4935,"آيات شعري من سما برهانها","https://www.poetsgate.com/ViewPoem.aspx?id=129467",""],[4935,"طير الهنا فوق الغصون يغرد","https://www.poetsgate.com/ViewPoem.aspx?id=129326",""],[5002,"سهم المنايا...","https://www.poetsgate.com/ViewPoem.aspx?id=205731",""]],"verses":[["لله خيلك إنها لَسَوَابح","بحر القتام وموجُه متهيّلُ",0,"ل",1,0],["لله خال على خدِّ الحبيب له","في العاشقين كما شاء الهوى عبث",1,"ث",1,1],["للَّهِ خالد الطائيُّ من رجلٍ","كم شُبهةٍ من عَويص الفقهِ جلّاها",2,"ا",3,1],["لله خالدٌ الطائيُّ من رجلٍ","ثَبْتِ المقام إذا ما حُجّةٌ عَزَبَتْ",3,"ت",1,1],["للَّهِ خالك ذو المكا","رم إنهُ بك للخبيرُ",4,"ر",1,0],["لِلَّهِ خَطُّ كِتابٍ خِلتُهُ دُرَراً","أَو رَوضَةً رَصَّعَتها السُحُب بِالبَرَدِ",5,"د",1,1],["لله خط قويم الشكل رونقه","حُلاه تنبيك عن إحكامِ كاتبه",6,"ه",1,1],["للهِ خَدٌّ بَدَتْ من حُسْنِه حُجَجٌ","تُريح عاشقَه من عَتْبِ لائمِهِ",7,"م",2,1],["لِلَهِ خَطبُ جَفائِكَ الصَع","ب الشَدائِد فما أَجَلَّه",8,"ل",2,0],["لِلَّه خرقه أَنوار تداولها","أَئمة لهم التَمكين والجاه",9,"ا",2,0],["لِلّه خَلقٌ بَديع زانَهُ خُلقٌ","مكرَّم فَهوَ مَمدوح وَمَحمودُ",10,"د",1,0],["لله خيلُ بُكاً تَجْري صَوالِجُها","أهدابُ عَيني وقَطْرُ الدّمع كالأُكر",11,"ر",1,0],["للّه خطرتك التي","ما كان تخطر في حسابي",12,"ب",2,0],["للَّه خير جراءةٍ","تسمو بمطلعها العجيبِ",13,"ب",1,1],["للّه خائلةٌ رأيتُ ودادَها","بدلالة التوفيقِ في مِرآتِها",14,"ت",3,0],["للّه خاتَمُك الّذي في نَقشه","كتبَ المصوّرُ أعظمَ الأسماءِ",15,"ا",2,0],["للهِ خَزِّيَّةُ الجلْبابِ صوَّنَها","طُولُ الحِجابِ فَلَمْ يُمْدَدْ لها ظُفُرُ",16,"ر",1,1],["للّه خل أراني العز حين قضى","نحبا وأنسي بأيام الصبا ذهبا",17,"ب",2,0],["للّهِ خالٌ بوسطِ وَجْنَتِهِ","بحُبِّهِ الصَّبُّ ما بهِ رَمَقُ",18,"ق",1,1],["لله خيل لا تراح ظهورها","حتى يتاح على العدوِّ ظهورها",19,"ر",3,1],["لله خل صادق","عهدته على الوفا",20,"ف",2,0],["لله خطب منه كل حشًى","مكلّمة النواحي",21,"ح",2,0],["للَه خاروف أتى في دسته","يحكيه ذو القرنين بالألقاب",22,"ب",1,0],["لله خير خلائف في أرضه","طالت مبانيهم على كيوان",23,"ن",1,0],["لله خيلك إذ تغدو مسوّمة","بالدارعين ونار الحرب تضطرم",24,"م",1,0],["للَه خطب قد عرا فأماد من","عدنان طوداً لا يكاد يسام",25,"م",1,0],["للَّه خطب جلل من عظمه","قلوبنا باتت على جمر الغضا",26,"ض",2,1],["للَه خطب فادح","صفو الكرام به تكدر",27,"ر",1,1],["للَه خطب جلل شب في","كل فؤاد لهب الوجد",28,"د",1,1],["لِلّه خطبك في الخطوب فانه","ملأ البلاد مناحة وتفجعا",29,"ع",2,0],["لله خلق منه تزكية الصيا","م صلات من صحة له آماله",30,"ل",2,0],["لله خطب فادح قد رمى","عقيلة الحي الكرام الحماة",31,"ه",1,0],["لله خَطبٌ هَدَّ دينَ الهُدَى","مِنهُ بِكَسرٍ مَا لَهُ جَابِرُ",32,"ر",1,0],["لله خطّة أصفهان فما رأت","عين لها فوق البسيط عديلا",33,"ل",2,0],["للَه خير منادم","من حازه لم يندم",34,"م",1,0],["للَه خود تسامت","وسما وذاتا ووصفا",35,"ف",2,1],["للهِ خردكَ التي زفت لنا","وبها تمتع ناظِرُ السلطانِ",36,"ن",1,0],["للَه خمر لم يخامر جرمها","خبث فكانت للطهور طهورا",37,"ر",2,0],["لله خوخ رائق أهداه لي","مولى غدا دون الورى شقيقي",38,"ي",1,1],["لِلَّه خودٌ قد سمت بمحاسنٍ","خلقاً وأخلاقاً تعظم من بَرا",39,"ر",2,0],["لِلَّهِ خطبٌ فادِحٌ لَولا التُقى","هَدَّ القُوى من كلّ ذي وجدانِ",40,"ن",1,0],["للهِ خلّي كلّ ما يأتيهِ","فاقتْ محاسنُهُ عن التّشبيهِ",41,"ي",2,1],["لله خطبٌ خطيب البين قام بهِ","يفري قلوباً عنها بالنوي الأسف",42,"ف",1,0],["لله خير أميرة بكمالها","وجلالها سادت ورفعة شأنها",43,"ن",3,0],["لله خير شمائل بجمالها","حار الملا وأنا بذلك أشهد",44,"د",1,0],["لله خلدٌ هو الرحَّمن والأحدُ","إليه مرجعُنا ياسعد َمن زهدوا",45,"د",3,0]]}