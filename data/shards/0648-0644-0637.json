{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[55,"ردت علي هدية لو أنها","https://www.aldiwan.net/poem26407.html","الكامل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[71,"لولا ادكارك تل راهط والحمى","https://www.aldiwan.net/poem4004.html","الكامل"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[73,"ما للمدام تديرها عيناك","https://www.aldiwan.net/poem11913.html","الكامل"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[93,"تبسمت مصر وقد زرتها","https://www.aldiwan.net/poem11077.html","السريع"],[93,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[54,"يا أمة قتلت حسنا عنوة","https://www.aldiwan.net/poem27434.html","الكامل"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"إن ابن بلبل نخلة","https://www.aldiwan.net/poem8121.html","مجزوء الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[91,"سفرت فقلت لها أهذا كوكب","https://www.aldiwan.net/poem8740.html","عموديه"],[91,"يا أيها الشرق التعيس انظر إلى","https://www.aldiwan.net/poem62698.html","عموديه"],[91,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[85,"اليوم ينتحر المقطم","https://www.aldiwan.net/poem7276.html","مجزوء الكامل"],[43,"غاضت أنامله وهن بحور","https://www.aldiwan.net/poem9574.html","الكامل"],[43,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[61,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[49,"أبلغ سلمت أبا الوليد سلامي","https://www.aldiwan.net/poem64907.html","الكامل"],[49,"أجفوتني فيمن جفاني","https://www.aldiwan.net/poem65339.html","مجزوء الكامل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[44,"يا موضع الشدنية الوجناء","https://www.aldiwan.net/poem30593.html","الكامل"],[69,"في دير بيرة دادخين حور","https://www.aldiwan.net/poem28805.html","الكامل"],[74,"لله نهر سال في بطحاء","https://www.aldiwan.net/poem12819.html","الكامل"],[21,"وفي دينكم من رب مريم آية","https://www.aldiwan.net/poem36159.html","الطويل"],[52,"يا حادي الأظعان أين تريد","https://www.aldiwan.net/poem27096.html","الكامل"],[48,"تباعد ما استطعت من الشقوق","https://www.aldiwan.net/poem66603.html","الوافر"],[46,"بين الغريزة والرشاد نفار","https://www.aldiwan.net/poem22580.html","الكامل"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[90,"الجيل الجَديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=179209",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[91,"الحسن لا يشترى ولا يستجلب","https://www.poetsgate.com/ViewPoem.aspx?id=14220",""],[88,"رقت بوصف جمالك الاقوال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19568&r=&rc=71",""],[91,"الحسن لا يشرى ولا يستجلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66225&r=&rc=25",""]],"verses":[["وَلَطالَما اِستَصرَفتُها مَلَلاً","وَلَئِن صَحَوتُ فَسَوفَ أَصرِفُها",0,"ف",3,0],["وَلَطالَما مَزَجَت بِريقي رِيقَها","كَالماءِ صُفِّقَ بِالسُلافِ المُزبَدِ",1,"د",1,0],["ولَطالَما طرَقَ الخُسوفُ أهِلّةً","ولَطالَما اعْترَضَ الكُسوفُ شُموسا",2,"س",2,0],["وَلَطالَما شِمتُ السَحابَ وَكَفَّهُ","فَتَدافَقا فَجَهِلتُ أَيُّهُما السَما",3,"م",2,0],["وَلَطالَما شيمَت بَوارِقُ كَفِّهِ","فَهمَت سَحائِبُها عَلَينا عَسجَدا",4,"د",2,0],["وَلَطالَما حَطَمَ الوَشيجَ بِكَفِّهِ","مِن بَعدِ حَشوِ الدرعِ بَينَ الأَضلُعِ",5,"ع",1,0],["وَلَطالَما غَشِيَ الوَغى بِثَلاثَةٍ","في ظَهرِ مَنسوبٍ يَطيرُ بِأَربَعِ",5,"ع",1,0],["وَلَطالَما اِعتَلَّ النَسيمُ فَخِلتُهُ","شَكوايَ رَقَّت فَاِقتَضَت شَكواكِ",6,"ك",1,0],["وَلَطالَما أَبدَيتِ إِذ حَيَّيتِنا","كَفّاً هِيَ الكَفُّ الخَضيبُ خَضيبا",7,"ب",2,0],["ولطفت بهجتها جوها","فكان في الصيف رجوع الربيع",8,"ع",1,0],["وَلَطَالَمَا لَقِيَ الأَذَى مُتَغَمِّداً","ذَنْبَ المُسِيءِ إِلَيْهِ بِالغُفْرَانِ",9,"ن",1,0],["وَلَطالَما ناداهُمُ بِكَلامِهِ","جَدّي النَبِيِّ خَصيمُكُم في المَوعِدِ",10,"د",1,0],["وَلَطالَما حَطَّمتُ صَدرَ مُثَقَّفٍ","وَلَطالَما أَرعَفتُ أَنفَ سِنانِ",11,"ن",1,0],["وَلَطالَما قُدتُ الجِيادَ إِلى الوَغى","قُبَّ البُطونِ طَويلَةَ الأَرسانِ",11,"ن",1,0],["ولطيفها كم هاجَ لوعةَ بينها","فالويل إن أهجع وإن لم أهجع",12,"ع",1,0],["ولَطَالَ ما ملكَ الرجا","لَ بذلّةٍ مثل النساءِ",13,"ا",2,0],["وَلَطَعْمُ اكْتِحالةٍ مِنْهُ بالزَّا","ئر أحلى في عَيْنه من رُقادِهْ",14,"د",2,0],["ولَطالما اسْتغنَى الفقي","رُ بكم وما انجبر الكسيرُ",15,"ر",1,0],["وَلَطالَما بَعضُ النِساءِ حَسَدنَها","وَلَطالَما حَسَدَ السَليمَ الأَجرَبُ",16,"ب",1,0],["وَلَطالَما شِدتَ القُصورَ مِنَ المُنى","خابَ الرَجاءُ وَساءَ ما تَتَوَهَّمُ",17,"م",1,0],["وَلَطالَما كانَت تُعَزُّ بِعِزِّها","مِصرٌ وَيَحمي ذِكرَها أَنطاكِيَه",18,"ي",2,0],["وَلَطالَما اِشتاقَت لِقُربِكَ أَنفُسٌ","كادَت مِنَ الأَشواقِ أَن تَتَفَطَّرا",19,"ر",2,0],["ولطالما قلب الحقا","ئق في سياسته وأوهم",20,"م",1,0],["وَلَطالَما اِنهَمَلَت بِماءٍ أَحمَرٍ","في شَفرَتَيهِ جَماجِمٌ وَنُحورُ",21,"ر",1,0],["وَلَطالَما أَفنَيتُ ريقَ كَعابِها","فيها وَأَفنَت بِالعِتابِ كَلامي",22,"م",2,0],["ولطافةٍ لو أنَّها رأبتْ","شعبَ الزُّجَاجِ تلاءَم الشَّعْبُ",23,"ب",1,0],["وَلَطالَما عَقَلَ الشبابُ شَوارداً","منهنَّ لي في ظِلِّه وعَقائِلا",24,"ل",2,0],["وَلَطالَما وَفَدَت إِلَيكَ مَدائِحي","مَحظوظَةً فَلَيَأتِ كُلُّ مَلامِ",25,"م",1,0],["وَلَطالَما أَمَّنتَني","مِمّا أَرى كُلَّ الأَماني",26,"ي",1,0],["وَلَطالَما أَمسى فُؤادُكَ مَنزِلاً","وَمَحَلَّةً لِظِباءِ ذاكَ المَنزِلِ",27,"ل",1,0],["وَلَطابَ مُرتَبَعٌ بِطيبَةَ وَاِكتَسَت","بُردَينِ بُردَ ثَرىً وَبُردَ ثَراءِ",28,"ا",2,0],["ولطالما رتعتْ بهِ الظَّبْياتُ في","أُنسٍ فليسَ يشنهنَّ نفورُ",29,"ر",1,0],["وَلَطالَما عاطَيتُ فيهِ مُدامَةً","صَفراءَ تَخضِبُ أَيدِيَ النُدَماءِ",30,"ا",2,0],["ولَطَّت حِجابَ البَيتِ مِن دُونِ أَهلِها","تغَيَّبُ عَنهُم في صَحاريِّ رِمرِمِ",31,"م",1,0],["وَلَطالَما ظَمِأَت إِلَيكَ نُفوسُهُم","وَطَريقُ بابِكَ عَنهُمُ مَسدودُ",32,"د",1,0],["ولط بالخلقِ كلّهمُ جميعاً","فإنّ العيشَ في الدين الرقيق",33,"ق",1,0],["وَلَطالَما صابَرتُ لَيلاً عاتِماً","فَمَتى يَكونُ الصُبحُ وَالإِسفارُ",34,"ر",1,0],["ولُطْفُ الأواني في الحقيقة تابع","لِلُطْفِ المعاني والمَعاني بها تَنْمُو",35,"م",2,0],["ولطمن وجهاً صين من مسِّ الأذى","وَشققنَ جيبَ الواجد الثكلان",36,"ن",1,0],["وَلُطْفُ حَدِيثٍ يُطْرِبُ السَّمْعَ آخِذٌ","لِكُلِّ طَرِيفٍ يَشْرَحُ الصَّدْرَ مُونِقِ",37,"ق",1,0],["ولطالما وقفا على الوادي وقد","صرخا هناك ليلتقي الصديان",38,"ن",1,0],["ولطالما لاح الوزير لناظري","وكأنه فرعون ذو الأوتاد!",39,"د",1,0],["ولُطِّفَتِ الابادةُ ، فهو حُرٌّ","بأيِّ يَدٍ يُفَضِّلُ أنْ يُبادا!",40,"د",2,0],["ولطالما اشتطّ الطغاةُ وأرجفوا","للمصلحين وأقعدوا وأقاموا",41,"م",3,0],["وَلطيفِ معنىً فيك ضاقَ بليدُها","بذكِّيهِ ، ودقيقُها بجَليله",42,"ل",2,0],["ولطاما بعض النساء حسدتها","ولطالما حسد السليم الأجرب",43,"ب",1,0],["ولطَّعتْ دون الأكف قلوبَها","شوقاً إليك مع النساء رجال",44,"ل",1,0],["ولطاما بعض النساء حسدنَها","ولطالما حسد السليم الأجرب",45,"ب",1,0]]}