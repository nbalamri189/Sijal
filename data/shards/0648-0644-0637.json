ttps://www.aldiwan.net/poem14341.html","الكامل"],[445,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[445,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[461,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[464,"ومسنت حي ينكر الإنس آله","https://www.aldiwan.net/poem16074.html","الطويل"],[467,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[467,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[467,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[467,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[467,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[467,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[480,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[485,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[496,"تنكب مذهب الهمج","https://www.aldiwan.net/poem67404.html","مجزوء الوافر"],[503,"وطد فؤادك كلنا عشاق","https://www.aldiwan.net/poem37944.html","الكامل"],[517,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[517,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[541,"وحقك يا منيتي ما أحب","https://www.aldiwan.net/poem48284.html","عموديه"],[554,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[554,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[554,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[554,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[554,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[561,"أجهلت قدرك أيها الإنسان","https://www.aldiwan.net/poem33842.html","الكامل"],[561,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[561,"بدت الحقيقة من خلال ستورها","https://www.aldiwan.net/poem34461.html","الكامل"],[565,"ماذا الوقوف على رسوم المنزل","https://www.aldiwan.net/poem52907.html","الكامل"],[565,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[570,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"],[570,"بيض لبسن حدادهن لمأتم","https://www.aldiwan.net/poem69686.html","الكامل"],[576,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[578,"حاشا لمجدك أن يضاما","https://www.aldiwan.net/poem3008.html","مجزوء الكامل"],[578,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[578,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["وَلَطالَما اِستَصرَفتُها مَلَلاً","وَلَئِن صَحَوتُ فَسَوفَ أَصرِفُها",0,"ف",3,0],["وَلَطالَما مَزَجَت بِريقي رِيقَها","كَالماءِ صُفِّقَ بِالسُلافِ المُزبَدِ",1,"د",1,0],["ولَطالَما طرَقَ الخُسوفُ أهِلّةً","ولَطالَما اعْترَضَ الكُسوفُ شُموسا",2,"س",2,0],["وَلَطالَما شِمتُ السَحابَ وَكَفَّهُ","فَتَدافَقا فَجَهِلتُ أَيُّهُما السَما",3,"م",2,0],["وَلَطالَما شيمَت بَوارِقُ كَفِّهِ","فَهمَت سَحائِبُها عَلَينا عَسجَدا",4,"د",2,0],["وَلَطالَما حَطَمَ الوَشيجَ بِكَفِّهِ","مِن بَعدِ حَشوِ الدرعِ بَينَ الأَضلُعِ",5,"ع",1,0],["وَلَطالَما غَشِيَ الوَغى بِثَلاثَةٍ","في ظَهرِ مَنسوبٍ يَطيرُ بِأَربَعِ",5,"ع",1,0],["وَلَطالَما اِعتَلَّ النَسيمُ فَخِلتُهُ","شَكوايَ رَقَّت فَاِقتَضَت شَكواكِ",6,"ك",1,0],["وَلَطالَما أَبدَيتِ إِذ حَيَّيتِنا","كَفّاً هِيَ الكَفُّ الخَضيبُ خَضيبا",7,"ب",2,0],["ولطفت بهجتها جوها","فكان في الصيف رجوع الربيع",8,"ع",1,0],["وَلَطَالَمَا لَقِيَ الأَذَى مُتَغَمِّداً","ذَنْبَ المُسِيءِ إِلَيْهِ بِالغُفْرَانِ",9,"ن",1,0],["وَلَطالَما ناداهُمُ بِكَلامِهِ","جَدّي النَبِيِّ خَصيمُكُم في المَوعِدِ",10,"د",1,0],["وَلَطالَما حَطَّمتُ صَدرَ مُثَقَّفٍ","وَلَطالَما أَرعَفتُ أَنفَ سِنانِ",11,"ن",1,0],["وَلَطالَما قُدتُ الجِيادَ إِلى الوَغى","قُبَّ البُطونِ طَويلَةَ الأَرسانِ",11,"ن",1,0],["ولطيفها كم هاجَ لوعةَ بينها","فالويل إن أهجع وإن لم أهجع",12,"ع",1,0],["ولَطَالَ ما ملكَ الرجا","لَ بذلّةٍ مثل النساءِ",13,"ا",2,0],["وَلَطَعْمُ اكْتِحالةٍ مِنْهُ بالزَّا","ئر أحلى في عَيْنه من رُقادِهْ",14,"د",2,0],["ولَطالما اسْتغنَى الفقي","رُ بكم وما انجبر الكسيرُ",15,"ر",1,0],["وَلَطالَما بَعضُ النِساءِ حَسَدنَها","وَلَطالَما حَسَدَ السَليمَ الأَجرَبُ",16,"ب",1,0],["وَلَطالَما شِدتَ القُصورَ مِنَ المُنى","خابَ الرَجاءُ وَساءَ ما تَتَوَهَّمُ",17,"م",1,0],["وَلَطالَما كانَت تُعَزُّ بِعِزِّها","مِصرٌ وَيَحمي ذِكرَها أَنطاكِيَه",18,"ي",2,0],["وَلَطالَما اِشتاقَت لِقُربِكَ أَنفُسٌ","كادَت مِنَ الأَشواقِ أَن تَتَفَطَّرا",19,"ر",2,0],["ولطالما قلب الحقا","ئق في سياسته وأوهم",20,"م",1,0],["وَلَطالَما اِنهَمَلَت بِماءٍ أَحمَرٍ","في شَفرَتَيهِ جَماجِمٌ وَنُحورُ",21,"ر",1,0],["وَلَطالَما أَفنَيتُ ريقَ كَعابِها","فيها وَأَفنَت بِالعِتابِ كَلامي",22,"م",2,0],["ولطافةٍ لو أنَّها رأبتْ","شعبَ الزُّجَاجِ تلاءَم الشَّعْبُ",23,"ب",1,0],["وَلَطالَما عَقَلَ الشبابُ شَوارداً","منهنَّ لي في ظِلِّه وعَقائِلا",24,"ل",2,0],["وَلَطالَما وَفَدَت إِلَيكَ مَدائِحي","مَحظوظَةً فَلَيَأتِ كُلُّ مَلامِ",25,"م",1,0],["وَلَطالَما أَمَّنتَني","مِمّا أَرى كُلَّ الأَماني",26,"ن",2,0],["وَلَطالَما أَمسى فُؤادُكَ مَنزِلاً","وَمَحَلَّةً لِظِباءِ ذاكَ المَنزِلِ",27,"ل",1,0],["وَلَطابَ مُرتَبَعٌ بِطيبَةَ وَاِكتَسَت","بُردَينِ بُردَ ثَرىً وَبُردَ ثَراءِ",28,"ا",2,0],["ولطالما رتعتْ بهِ الظَّبْياتُ في","أُنسٍ فليسَ يشنهنَّ نفورُ",29,"ر",1,0],["وَلَطالَما عاطَيتُ فيهِ مُدامَةً","صَفراءَ تَخضِبُ أَيدِيَ النُدَماءِ",30,"ا",2,0],["ولَطَّت حِجابَ البَيتِ مِن دُونِ أَهلِها","تغَيَّبُ عَنهُم في صَحاريِّ رِمرِمِ",31,"م",1,0],["وَلَطالَما ظَمِأَت إِلَيكَ نُفوسُهُم","وَطَريقُ بابِكَ عَنهُمُ مَسدودُ",32,"د",1,0],["ولط بالخلقِ كلّهمُ جميعاً","فإنّ العيشَ في الدين الرقيق",33,"ق",1,0],["وَلَطالَما صابَرتُ لَيلاً عاتِماً","فَمَتى يَكونُ الصُبحُ وَالإِسفارُ",34,"ر",1,0],["ولُطْفُ الأواني في الحقيقة تابع","لِلُطْفِ المعاني والمَعاني بها تَنْمُو",35,"م",2,0],["ولطمن وجهاً صين من مسِّ الأذى","وَشققنَ جيبَ الواجد الثكلان",36,"ن",1,0],["وَلُطْفُ حَدِيثٍ يُطْرِبُ السَّمْعَ آخِذٌ","لِكُلِّ طَرِيفٍ يَشْرَحُ الصَّدْرَ مُونِقِ",37,"ق",1,0],["ولطالما وقفا على الوادي وقد","صرخا هناك ليلتقي الصديان",38,"ن",1,0],["ولطالما لاح الوزير لناظري","وكأنه فرعون ذو الأوتاد!",39,"د",1,0],["ولطالما صلت على لباتها","زمر الحديد سهامها وحسامها",40,"م",3,0],["ولُطِّفَتِ الابادةُ ، فهو حُرٌّ","بأيِّ يَدٍ يُفَضِّلُ أنْ يُبادا!",41,"د",2,0],["ولطالما اشتطّ الطغاةُ وأرجفوا","للمصلحين وأقعدوا وأقاموا",42,"م",3,0],["وَلطيفِ معنىً فيك ضاقَ بليدُها","بذكِّيهِ ، ودقيقُها بجَليله",43,"ل",2,0],["ولطاما بعض النساء حسدتها","ولطالما حسد السليم الأجرب",44,"ب",1,0],["ولطَّعتْ دون الأكف قلوبَها","شوقاً إليك مع النساء رجال",45,"ل",1,0],["ولطاما بعض النساء حسدنَها","ولطالما حسد السليم الأجرب",46,"ب",1,0],["ولطف ثغرك والراح الذي بشذا ال","مسك الالهي نال المزج قرقفه",47,"ف",2,0],["ولطيف اوقات بقربك لي مضت","اعقبتها بجفاء قلب قاسي",48,"س",2,0],["ولطيف ذاتك مررت بخاطري","الا كساني الشوق مرطا اصفرا",49,"ر",2,0],["ولطف معانيكم وساعات قربكم","وكاسات وصل دون لذتها الشهد",50,"د",1,0],["ولطف معان انت نسختها التي","متى ما رأيتها العين تفعل في اللب",51,"ب",1,0],["ولطيفة نشرت فؤادي في غضا","جمر الجفا وطوته تحت خيامها",52,"ه",2,1],["ولطيفة سكنت بوادي المنحنى","من أضلعي وتمكنت بفجاجه",53,"ه",1,1],["ولطف الكاس إِثر","الكاس نشربها تولانا",54,"ن",2,0],["ولطالَما كنا جميعاً في حِمىً","متنعمين بلذةِ الإيصالِ",55,"ل",1,0],["ولطالما اعتقب العواذل مسمعى","فزجرنَ منه مُصْعَبا ولا يُخطَمُ",56,"م",1,0],["وَلَطالَما صَبَّحتَهُم في غارَةٍ","أَلفَوا بِها أُمَّ اللُهَيمِ وَلودا",57,"د",2,0],["وَلَطالَما خَصَّت نُحوسُ كَواكِبٍ","قَوماً وَكُنَّ لآِخَرينَ سُعودا",57,"د",2,0],["وَلَطالَما وَجَدَت يَدَيكَ عِطاشُهُم","أَنُدى مِنَ الدِيَمِ الغِزارِ وَأَجوَدا",58,"د",2,0],["وَلَطالَما زادَ التَخَوُّفُ فَالتُقى","بِجَنابِ مُلكِكَ مُرسِلٌ وَرَسولُ",59,"ل",1,0],["وَلَطالَما وَصَلَت يَدَيَّ صِلاتُهُم","فَأَبَت يَميني قَبضَها وَشِمالي",60,"ل",2,0],["وَلَطالَما كَفَرَ المُعافى صِحَّةً","فَأَحالَها كُفرانُها أَسقاما",61,"م",2,0],["وَلَطالَما أَغنَيتَ غَيرَ مُشارَكٍ","عَن صَوبِ غادِيَةٍ بِصَوبِ بَنانِ",62,"ن",1,0],["ولطالما لام العذول بحبّكم","وأطال عتبي ناصحا ومعنفا",63,"ف",2,0],["ولِطَرفِ المخافِ عنك اغتماضٌ","ولطرف المراد منك انتباه",64,"ا",2,0],["ولطال ما خدعت سواه فقد رأت","أن ليس ينخدعُ الإمام الزاهد",65,"د",1,0],["وَلَطالَما فَعَلَت تُطيلُ مُرورَها","وَتَجِيءُ عَمداً كَي تَراكَ وَتَذهَبُ",66,"ب",1,0],["وَلَطالَما أَبصَرنَني فَعَثَرنَ في","أَذيالِهنَّ القانِتاتُ العُبَّدُ",67,"د",1,0],["وَلَطالَما حَمَلَت لِيَ العَذراءُ مِن","شَوقٍ إِلَيَّ فَلَم يَلِقها المَورِدُ",67,"د",1,0],["وَلَطالَما خَلّى الرُؤوسَ كَأَنَّها","لِلبُعدِ ساخِطَةٌ عَلى الأَجسامِ",68,"م",1,0],["ولَطُفتُ حتى أنني","عَرَضٌ يقوم بنفسه",69,"س",2,0],["ولطمة عالم في الخدّ منّي","أحبّ إلي من شربِ الرحيق",70,"ق",1,0],["ولطالما عاديته زمنا","أقفو المنى وأنازل الأسدا",71,"د",2,0],["ولطالما أبضعت في طلب الغنى","وكسيت فيه الحمد والمحدا",71,"د",2,0],["ولطالما لبس الدروعَ غلائلا","ولطالما جرَّ الرماح ذيولا",72,"ل",2,0],["ولطائفاً تشفي مآثرها","من قد تعالج نفسه النزعا",73,"ع",2,0],["ولطالما نزل الكتاب بوفق ما","يقضيه فيما يعتر ويفاجى",74,"ج",2,0],["وَلَطالَما سُمِعَ الأَزيرُ لِصَدرِهِ","كَالمرجلِ الفَهّاقِ بِالغَلَيانِ",75,"ن",1,0],["وَلِطَرفٍ حِلٍّ عَلى ال","دَمعِ حِجرٍ عَلى الوَسَن",76,"ن",1,0],["وَلَطالَما عُفتُ المَطالِبَ قَبلَها","وَنَفَضتُ مِن جَدوى المُلوكِ يَميني",77,"ن",2,0],["وَلَطالَما نَزَّهتُها عَن مَوقِفٍ","يُجزي الكِرامَ وَصُنتُها عَن جاهِلِ",78,"ل",1,0],["وَلَطالَما قَضى الشَبابُ مَآرِبي","فيكِ اِختِلاساً وَالحَوادِثُ غُفَّلُ",79,"ل",1,0],["وَلَطالَما نَزَّهتُها","عَن مَوقِفِ الشِعرِ الذَليلِ",80,"ل",1,0],["وَلَطالَما ضَنَّت بِزَو","رِ خَيالِها الساري المُطيفِ",81,"ف",1,0],["ولطالما حاشاك اغضبنا","على عجل سروره",82,"ر",2,0],["ولطالما أبصرت من","عبثت بيسراه اليمين",83,"ن",1,0],["ولطالما برزت سيفاً للعلا","فعلوت يوم ندى ويوم براز",84,"ز",1,0],["ولطالما أصفيت قبلك خلتي","من لا أراه موافقاً لأخائي",85,"ا",2,0],["ولطالما ضمدَت جراحاً كفُّها","ما أجملَ الإحسانَ بالحسناء",86,"ا",2,0],["ولطفُ ابتِسامٍ في عذوبةِ مَنطقٍ","وحسنُ كلامٍ في حديثٍ منوَّع",87,"ع",1,0],["ولَطَالَمَا أَذْرَتْن