{"poems":[[511,"يا رشأ حظى إبعاده","https://www.aldiwan.net/poem2442.html","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59110","الكامل"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198723","السريع"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140299",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123914","الرمل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107098","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73183","الكامل"]],"verses":[["بي ظمأٌ بّرح لكنّه","زهد في المَوردِ ورَّاده",0,"د",2,0],["بِي ظبيةٌ صَاغهَا البَاري وَصَوَّرَهَا","مِنْ جَوْهَرِ اللُّطْفِ أوْ من عَنْبَرِ التَّرَفِ",1,"ف",1,0],["بي ظمأ برح إلى صرفة","تمطرها ماء العناقيد",2,"د",1,0],["بي ظمأ لا يطيق قلب","وإن بدين الغرام جحده",3,"د",2,0],["بي ظبي وبألحاظ الظبا","منك ولي مفلتا من قانصيه",4,"ه",1,0],["بيظٌ مني وبالظا ما سوى حدث","من صرف فظع ومجدى العصر من حمظا",5,"ظ",2,0],["بي ظاعِنٌ كم دونَ يومِ لِقائِهِ","من فَتِّ أكبادٍ وَشَيبِ نَواصي",6,"ص",2,0]]}