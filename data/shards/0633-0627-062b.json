{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[27,"لقد هتف اليوم الحمام ليطربا","https://www.aldiwan.net/poem5659.html","الطويل"],[47,"سأثني على تلك الثنايا لأنني","https://www.aldiwan.net/poem25281.html","الطويل"],[51,"سأثني بنعماك التي لو كفرتها","https://www.aldiwan.net/poem7949.html","الطويل"],[51,"سأثلج باصطناع العرف صدري","https://www.aldiwan.net/poem8300.html","الوافر"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[51,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[45,"أجدك ما ينفك يسري لزينبا","https://www.aldiwan.net/poem10897.html","الطويل"],[28,"حباني بها البهزي نفسي فدائه","https://www.aldiwan.net/poem5036.html","الطويل"],[28,"فتحت لهم حتى فككت قيودهم","https://www.aldiwan.net/poem5226.html","الطويل"],[66,"سأثني على نعماك بالكلم التي","https://www.aldiwan.net/poem41344.html","الطويل"],[66,"سأثني على نعماك مادمت باقيا","https://www.aldiwan.net/poem41347.html","الطويل"],[66,"سأثني على نعماك بالكلم","https://www.aldiwan.net/poem41348.html","الطويل"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[52,"سأثني على عهد المطيرة والقصر","https://www.aldiwan.net/poem27054.html","الطويل"],[48,"وأسمع منك النفس ما ليس تسمع","https://www.aldiwan.net/poem64380.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[45,"وبِي فَضلَةٌ أَن أَغْتَدِي غَيْرَ شَاكِرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31875",""],[51,"سأثني بنعماك التي لو كَفَرْتُها","https://www.poetsgate.com/ViewPoem.aspx?id=26052",""],[128,"سلام وتسليم وألف تحية","https://www.aldiwan.net/poem50599.html","الطويل"],[143,"بقيت لذا العز الذي عز مطلبا","https://www.aldiwan.net/poem11733.html","الطويل"],[143,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[143,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[143,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[204,"عن الجار يسأل باغي المحلل","https://www.aldiwan.net/poem53199.html","المتقارب"],[229,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[229,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[280,"أبا حسن لئن كانت أجابت","https://www.aldiwan.net/poem60736.html","الوافر"],[298,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[402,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[466,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[479,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[573,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[575,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"]],"verses":[["سَأُثني بِأَشعاري عَليكَ فَإِنَّني","رَأَيتُ مَسودَ القَومِ يُطري المُسَوَّدا",0,"د",2,0],["سَأُثني عَلى تَيمٍ بِما لا يَسُرُّها","إِذا أَركُبٌ وافَوا بِنَعمانَ أَركُبا",1,"ب",2,0],["سَأَثني عَلى تِلكَ الثَنايا لِأَنَّني","أَقولُ عَلى عِلمٍ وَأَنطِقُ عَن خُبرِ",2,"ر",1,1],["سأُثني بنُعماك التي لو كَفَرْتُها","لأنثت بها منها شواهدُ لا تَخْفى",3,"ف",2,1],["سأُثْلِجُ باصطناع العُرف صدري","وأُعدِمُ كاهلي ثِقَلَ الذُّنوبِ",4,"ب",1,1],["سأثني على الدهر المذَمّم إذ أتى","بأمثالكم أو لا فإنِّيَ باخس",5,"س",1,0],["سأثني بآلاء الشبيبةِ باسِطاً","لساني بها حتى أحينَ فأُقبَضا",6,"ض",2,0],["سَأَثني فُؤادي عَنكِ أَو أَتبَعُ الهَوى","إِلَيكِ إِنِ اِستَعصى فُؤادِيَ أَو أَبى",7,"ب",2,0],["سَأُثني بِما أَولَيتَني وَأَعُدُّهُ","إِذا القَومُ عَدّوا فَضلَهُم في المَشاهِدِ",8,"د",1,0],["سَأَثني عَلى خَيرِ البَرِيَّةِ وَالَّذي","عَلى الناسِ ناءَ الغَيثُ مِنهُ فَأَمطَرا",9,"ر",2,0],["سَأُثني عَلى نُعماكِ بِالكَلِمِ الَّتي","مَحاسِنُها تُبلي الزَمانَ وَلا تَبلى",10,"ل",2,1],["سَأُثني عَلى نُعماكَ مادُمتُ باقِياً","وَإِن مِتُّ يُثني مَنطِقُ الطِرسِ مِن بَعدي",11,"ي",1,1],["سَأُثني عَلى نُعماكَ بِالكَلِمِ الَّتي","بِها تُضرَبُ الأَمثالُ في اللَفظِ وَالفَضلِ",12,"ل",1,1],["سَأُثيرُها مِنْ كُلِّ طاعِنَةٍ","صَدْرَ الفلاةِ بأذْرُعٍ فُتُلِ",13,"ل",1,0],["سَأُثني عَلى عَهدِ المَطيرَةِ وَالقَصرِ","وَأَدعو لَها بِالساكِنينَ وَبِالقَطرِ",14,"ر",1,1],["سَأُثني بِهَذا ما حَيِيتُ عَلى المُنى","وَإِن أَغفَلَ العُشّاقُ ذاكَ وَضَيَّعوا",15,"ع",3,0],["سأثني على قوم رعوني بفضلهم","ومن نال ما قد نلت من حظوة أثنى",16,"ن",2,0],["سأُثنِي وإِنْ لم يَبْلُغِ الْقَوْلُ مُنعِماً","فإِنَّ لِسَانَ الْحالِ لَيْسَ بأَعْجَمِ",17,"م",1,0],["سأثني بنعماك التي لو كَفَرْتُها","لأثنت بها منها شواهدُ لا تُخفى",18,"ف",2,1],["سأثنى عليه ما حييتُ وإنْ أمُت","فلا لومَ يعرونى إذا ضمّنى القبرُ",19,"ر",1,0],["سَأُثني بِقَدرِ الجَهدِ لِلعيِّ غالِباً","وَلا أَبتَغي ما تَستَحِقُّ فَأُغلَبا",20,"ب",2,0],["سَأُثني بِنُعماكَ الَّتي مَلَأَت يَدي","وَإِن فاتَ حَدَّ العَدِّ نائِلُكَ العِدُّ",21,"د",1,0],["سَأُثني بِما أَولاهُ أَبناءُ صالِحٍ","بِجَهدي فَأَمّا أَن أُكافِيَهُم فَلا",22,"ل",2,0],["سَأُثني بِما أَولَيتَ في كُلِّ مَوقِفٍ","يَرانِيَ فيهِ الجاهِلِيَّ المُخَضرَما",23,"م",2,0],["سأُثني عليك كلا الحالَتَي","ن ثنائي على المُحسن المُجمِلِ",24,"ل",1,0],["سَأَثْنِي خطوبَ الدّهرِ عني بماجدٍ","تخاف خطوبُ الدّهرِ منه وتَتّقِي",25,"ق",2,0],["سأَثني دَراريَّ النجوم وأَنْثَني","وأَعْطِفُ أطرافَ الرِّماح وأركبُ",26,"ب",1,0],["سَأُثْنِي بِالَّذِي أَوْلَيْتَ جَهْدِي","وَيُثْنِي السّامِعُونَ عَلَى ثَنائِي",27,"ي",1,0],["سأثني من عنانِ العُتبِ آنا","عسى لك منْ شؤونك ما يعوق",28,"ق",1,0],["سأثني عناني نحوَهُ غير سامعٍ","ملاماً وكيف الكفرُ من بعدِ إيمان",29,"ن",1,0],["سَأَثني عَلى نَجدٍ بِما هُوَ أَهلُهُ","قِفا راكِبَي نَجدٍ لَنا قُلتَ أَسمَعا",30,"ع",2,0],["سأثير من قومي عواطف ملّة","سمحاء تنهض للعلى وتثور",31,"ر",1,0],["سَأَثني عَلَيهِ بِالَّذي هُوَ أَهلُهُ","وَإِن يَكُ تَقصيرٌ فَإِقصارُ ذي لَسَن",32,"ن",1,0],["سأُثْنِي عَلَيْكَ وما قلَّ ما","يَقُومُ بما يَسْتَحِقُّ الثَّناءُ",33,"ا",2,0]]}