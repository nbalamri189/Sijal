{"poems":[[53,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[63,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[51,"يا أمين الله ما لي","https://www.aldiwan.net/poem64296.html","مجزوء الرمل"],[68,"كثر الله مثل مجدك في الأرض","https://www.aldiwan.net/poem40952.html","الخفيف"],[107,"صاحب السيفين ماذا صنعا","https://www.aldiwan.net/poem44212.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[2,"غَشِيتُ دِياراً بالبَقيعِ فثَهْمَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19485&r=&rc=11",""],[178,"ألذ وأشفى لنا من طرب","https://www.aldiwan.net/poem46071.html","المتقارب"],[234,"أنا من رقة الهوى والهواء","https://www.aldiwan.net/poem51268.html","الخفيف"],[327,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[415,"تبذل حتى قد مللت عتابه","https://www.aldiwan.net/poem32334.html","الطويل"],[580,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63956","السريع"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119329","الخفيف"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216686",""],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47510","المنسرح"],[1557,"","https://poetry.dctabudhabi.ae/diwan/poem/124309","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18053","الوافر"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102379","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205738",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34661","المنسرح"],[4764,"ثلج الدفا","https://www.poetsgate.com/ViewPoem.aspx?id=29777",""],[4978,"سألت إله العرش ما كان أطيبا","https://www.poetsgate.com/ViewPoem.aspx?id=191577",""],[5122,"((((( عيون الاخبار )))))","https://www.poetsgate.com/ViewPoem.aspx?id=37320",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5431,"لاتلومي تعلّقي بالرجالِ....","https://www.poetsgate.com/ViewPoem.aspx?id=200455",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""]],"verses":[["تبذُلْ ثواباً لك الحسناءُ موعدَها","لكنَّ نائلها للمُرْدِ مبذولُ",0,"ل",1,0],["تَبذُلُ من دُرِّها وبَهْجَتِها","ما ليسَ إلا لَدَيْكَ يُبتَذَلُ",1,"ل",1,0],["تَبُذُّ الأُلى يَأتِينَها مِن وَرائِها","وَإِن تَتَقَدَّمها السَوابِقُ تَصطَدِ",2,"د",1,0],["تَبذُلُ الحَقَّ وَتُعطي","عَن يَمينٍ وَشِمالِ",3,"ل",1,0],["تَبذُلُ المالَ ثُمَّ تَبخُلُ بِالعِر","ضِ وَتَسطو إِلّا عَلى ذي لِسانِ",4,"ن",1,0],["تَبذلينَ الحَلْي والمالَ على","أن جناه جاهلياً مُفظعا",5,"ع",2,0],["تَبْذُلُ النَّفْسَ وَالنَّفِيسَ احْتِسَاباً","خَالِصاً وَالمَرَامُ نِعْمَ المَرَامُ",6,"م",1,0],["تَبْذُلُ لاَ عَابِساً وَلاَ بَرِماً","بِطِيبِ نَفْسٍ يُضاعِفُ البَدَلاَ",7,"ل",2,0],["تَبْذُلُ فِي الباقِياتِ بَذْلاً","أَلْطَفَ مَغْزىً مِنْ أَنْ يذِيعَا",8,"ع",2,0],["تبذلُ الخيرَ لم يُكدَّر بمنٍّ","وكثيرُ مِنّا إذا مَنَّ مَنَّا",9,"ن",2,0],["تبذُّ الألَى يأتينها، من ورائها","وَإنْ يَتَقَدّمْها السّوابقُ تَصْطَدِ",10,"د",1,0],["تَبَذَّبُ سَاقٍ أَدَارَ العُقَارَ","يَكْفِيكَ بِالْبَذْلِ ذُلَّ الطَّلَبْ",11,"ب",1,0],["تَبْذُل الخُرَّدُ الحسانُ لِيَ الأَوْ","جُهَ دون الأُمَّات والآباء",12,"ا",2,0],["تَبُذُّ العِينَ إِن قَعَدَت جَمالاً","وَتَنطِقُ مَن رَآها حينَ تَمشي",13,"ش",2,0],["تَبذّلَ حَتّى قَد مَلِلتُ عِتَابَه","وأعرضْتُ عَنه لا أريدُ اقْتِرَابَهُ",14,"ه",1,1],["تبذَّل في الله يَومَ الجِلادِ","وكَانَ مِنَ النَّصْرِ في مَعْقِل",15,"ل",1,0],["تُبْذَلُ للقبلةِ حسناً ولا","تَصلُحُ إن تُبذَلَ للعضَّه",16,"ض",2,0],["تبذل الجهد كلما جبت فجا","بعد فج من المكان السحيق",17,"ق",1,0],["تبذل على قرب المدى والمسافات","من كفّ يمنى ما يوقف عطاها",18,"ا",3,0],["تَبَذُّلاً مِنْهُ في حَوائِجِنا","وَلا يزَالُ الْكَريمُ مُبْتَذلا",19,"ل",2,0],["تَبُذُّ العيس لاحقَةً كلاها","وتطوى البيد مسنَفَةَ اللبانِ",20,"ن",1,0],["تَبذُلِ الماءَ لارتشافٍ كما","يُبذَل ثغرُ الملاح للرشفات",21,"ت",1,0],["تَبُذُّ الغانِياتِ بِكُلِّ أَرضٍ","إِذا أَخَذَت وِشاحاً أَو بَريما",22,"م",2,0],["تبذ الناس مكرمة إذا ما","فخرت ومن كمثلك في الفخار",23,"ر",1,0],["تبذله للموت والحداد","رعيًا لمن باتوا على وساد",24,"د",1,0],["تبذلي بذلةً تقرُّ بها ال","عَين ولا تحصري وتحتشمي",25,"م",2,0],["تبذر بها وكل البذر ذبلاني","ولا أثمرت تعصف بها لغيومي",26,"م",2,0],["تبذّ به أستاذها، إن شرحها","له فعل سحر في العقول تسرّبا",27,"ب",2,0],["تبذير دون شعوروالوقت دوار","والمال عند الخبل يصبح حسافه",28,"ف",2,0],["تبذلُ الروح في رضا وسرورٍ","أيُ قربى !! ببذلها البرهانُ !!",29,"ن",1,0],["تبذل الروح منحة في دفاعٍ","عن مساكين عمرهم في اغتيالِ",30,"ل",1,0],["تبذل النفس والنفيس جهاداً","نعم ذاك الجهاد والإتّجار",31,"ر",1,0],["تبذل النفس والنفيس احتسابا","خالصا واملرام نعم المرام",32,"م",1,0]]}