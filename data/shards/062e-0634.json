9,"منذ البداية","https://www.poetsgate.com/ViewPoem.aspx?id=29409",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5956,"خشيت من الخروج إلى المروج","https://www.poetsgate.com/ViewPoem.aspx?id=201543",""],[6019,"نحو الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=174249",""],[6035,"الغيّ ياكسرى عَصِيّ كَيّه .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177042",""],[6056,"الشعر أكذبه  أعذبه","https://www.poetsgate.com/ViewPoem.aspx?id=130138",""],[6056,"خشف المها","https://www.poetsgate.com/ViewPoem.aspx?id=130384",""],[6093,"يوماً وقفتُ بسَفْحِ الرِّيمِ مُخْتار (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""],[6093,"قالوا: خرجتَ عن القديم أجابهم (الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176081",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["خَشيتِ صُدودي لَيسَ ذاكَ بِكائِنٍ","أَتى دُونَهُ حُبٌّ لِعَينَيَّ مُسهِرَ",0,"ر",1,1],["خَشِيَ الصَرارِي صَولَةً","مِنهُ فَعاذوا بِالكَوازِل",1,"ل",1,0],["خَشَعَت أَبصارُهُم لَمّا بَدَت","وَإِلى الأَذقانِ خَرّوا ساجِدين",2,"ن",1,0],["خَشَعَ البَحرُ إِذ رَكِبتَ جَواري","هِ خُشوعَ القُلوبِ يَومَ الحِسابِ",3,"ب",1,0],["خشيتُ أنِّي ومن كَلفْتُ به","لا نتلاقى ونحن في بلدِ",4,"د",1,0],["خَشِنِ الإِهابِ كَأَنَّهُ في جَوشَنٍ","وَكَأَنَّما في كُلِّ عُضوٍ مِنجَلُ",5,"ل",1,0],["خَشيتَ عَلَيهِ أَن يُطَوِّحَهُ الهَوى","فَأَلفاكَ هَذا الخَوفُ في الهُوَّةِ السُفلى",6,"ل",2,0],["خَشيَةً أَن أَرى الَّذي لا يَراهُ","لي أَو أَن أُريدَ ما لا يُريدُه",7,"د",2,0],["خشَعَتْ له إنْ بانَ عنها صادراً","وتبسَّمَتْ لما أتاها وَارِدا",8,"د",2,0],["خَشَيتُ اِنفِساخَ العَهدِ عَنّي وَإِنَّني","لِعَهدِكَ لا وَاللَهِ ما أَنا فاسِخُ",9,"خ",1,0],["خَشيتُ عَلى الآراكِ سَطوَةَ بَأسِهِ","وَأَطوادُ رَضوى دونَها وَالشَمارِخُ",9,"خ",1,0],["خَشُنتَ عَلى الأَعداءِ في الحَربِ مَلمَساً","وَغُصنُكَ غَضٌّ في الشَبيبَةِ شارِخُ",9,"خ",1,0],["خَشُنتَ عَلى التَأديبِ فَهماً وَمَنطِقاً","وَلِنتَ عَلى الأَيّامِ ليتاً وَأَخدَعا",10,"ع",2,0],["خَشُنتِ عَلَيهِ أُختَ بَني خُشَينِ","وَأَنجَحَ فيكِ قَولُ العاذِلَينِ",11,"ن",1,1],["خَشَعوا لِصَولَتِكَ الَّتي هِيَ عِندَهُم","كَالمَوتِ يَأتي لَيسَ فيهِ عارُ",12,"ر",1,0],["خشيتُ على حبيبِ القلبِ لما","أتى حمامَهُ ونضى الثيابا",13,"ب",2,1],["خشونةُ أهلِ العلمِ غيرُ عجيبةٍ","وإنْ بالغوا في الحفظ والبحثِ والفكرِ",14,"ر",1,1],["خشيتُ على حبيبِ القلبِ لمَّا","أتى حمَّامَهُ ونَضا الثيابا",15,"ب",2,1],["خَشيتَ أَن يَعرِفَ إِعجامَها","مَولاكَ في الخَدِّ فَيَقراها",16,"ا",3,0],["خُشّابَ هَل لِمُحِبٍّ عِندَكُم فَرَجُ","أَو لا فَإِنّي بِحَبلِ المَوتِ مُعتَلِجُ",17,"ج",1,1],["خُشّابَ جودي جِهاراً أَو مُسارَقَةً","فَقَد بُليتُ وَمَرَّت بِالمُنى حِجَجُ",17,"ج",1,0],["خَشيَةُ اللَهِ وَأَنّي رَجُلٌ","إِنَّما ذِكري كَنارٍ بِقَبَل",18,"ل",1,0],["خشيتي ان اكون ساعة تدعي","ن الى العود قد هلكت قصيا",19,"ي",2,0],["خشيَتي أن تطيل في القبر نوماً","فيشق البلى إليك سَبيلا",20,"ل",2,0],["خشيت عَلى نَفسي فأزمعت رجعة","إلى بلدي من قبل أني أصرع",21,"ع",1,0],["خشعتْ له النَّسَمات وهي هوازجٌ","وتنصّتَ العصفورُ وهو يُهينمُ",22,"م",1,0],["خشعوا فلم يجروهما أو ينبسوا","إلا كما يتخافت القراء",23,"ا",2,0],["خَشَعَت لفَيْضِ جَلالِكَ الأَبْصارُ","وَذَكَتْ بِمِسْك خِلاَلِكَ الأَشْعَارُ",24,"ر",1,1],["خَشِيتَ اللهَ عن علمٍ ، وحقٌّ","إذا لم تَخشَ في الحقّ العبادا",25,"د",2,0],["خشيت عليه أن يطوحه الهوى","فألقاك هذا الخوف في الهوّة السفلى",26,"ل",2,0],["خشَوا أن يضِلَّ الضيفُ عنهم فرفَّعوا","من النار في الظلماء ألويةً حُمرا",27,"ر",2,0],["خَشِيَ القومُ أَن تهبَّ بنكبا","تِ الرزايا عليهمُ النكباءُ",28,"ا",2,0],["خَشيتُكَ حتى قيلَ إنيَ لم أَثِق","بِأنَّك تَعفو عن كَثيرٍ وَترحمُ",29,"م",1,1],["خَشوا أَن يُلاقوا جَحفَلاً كُلَّ فارِسٍ","يعدونَه منه خَميساً وَجَحفَلا",30,"ل",2,0],["خشونةُ دنّها ثقلت عَليها","وكيفَ تحبُّ ضاحكةٌ عبوسا",31,"س",2,0],["خُشُوعٌ وَإِيمانٌ وَعَدْلٌ وَرَأْفَةٌ","فَقَدْ حُقَّ بِالنَّعْماءِ مِنْكَ حَقِيقُها",32,"ق",3,0],["خشعتُ إِذْ قَرَعَ الناقوسُ في سحرٍ","من ليلةٍ ذات أسدافٍ وَأحلاك",33,"ك",1,0],["خشب مسندة","وراءها حطب",34,"ب",1,0],["خَشُنتَ لِحالٍ كَشَوكِ القَتادِ","وَلِنتُ لِأُخرى كَشَوكِ السِيالِ",35,"ل",1,0],["خشي الإلهُ عليه عند كماله","والنقصُ في أهل الفضيلة مولع",36,"ع",1,0],["خَشيتُ عليه اليُتم بعدي فَليتَني","رُميتُ بما أَخْشى ولم أُرْمَ بالثَّكلِ",37,"ل",1,0],["خَشِيتُ عليه اليُتْمَ لكنَّ ثُكْلَهُ","ولوعَتَه لم يخطُرَا لي على فِكْرِ",38,"ر",1,0],["خشية الواشين صبٌّ لم يزلْ","يُظهِرُ الدَّمع ويخفي الكمدا",39,"د",2,0],["خشية الله درعه وتقاه","إذ يلقيه نضرة وسرورا",40,"ر",2,0],["خشيتُ بسدلها في الحيّ من أن","يُهبَّ أشَطَهُمْ أدنى شَذَاها",41,"ا",3,0],["خشُنَتْ جِعادُ أكفِّهم فكأنما","في اللؤم صيغت من طباع الأزمنِ",42,"ن",1,0],["خُشُنٌ والضَّيمُ مُعْتَرضٌ","ذُلُلٌ والنَّاسُ إِخوان",43,"ن",1,0],["خَشن النَّجدةِ لا كِبْرٌ به","لينُ الملمسٍ من غيرِ خُوَرْ",44,"ر",1,0],["خشيان من ذي العرش لو خاضت به","ساعاتُه بين القنا لم يجْزعِ",45,"ع",1,0],["خشونةٌ لا يطولُ الجبرؤُتُ بها","ولِينةٌ كرُمتْ عن رقَّةِ الخورِ",46,"ر",1,0],["خَشِنُ البطْشَةِ لا بَغْيَ بهِ","لَيِّنُ الملمس من غير فَشَلْ",47,"ل",1,0],["خَشْيانَ مقْصوبٍ على غَلْوائهِ","جَمِّ المَحاسب في السُّرى والمنزل",48,"ل",1,0],["خشاشاً كنصل السيف في كفِّ باسلٍ","يَعُزُّ به ذِمْرٌ ويَبْهَجُ ناظِرُ",49,"ر",1,0],["خشيان يطوي منهُ جن","حُ الليل ما نشرَ العبقْ",50,"ق",1,0],["خِشفٌ لَهُ مِن ثَغرِهِ","مِثلُ الَّذي في عِقدِهِ",51,"د",2,0],["خشيت تصدع بالوداع جوانحي","فغدت تحث السير قبل عويلي",52,"ل",2,0],["خشيتْ مُشاركتي بذَنبِ تخلّفي","عنكم فكان لها لديكَ تسرُّعُ",53,"ع",1,0],["خشنتم ولانت في هواكم معاطفي","وما يستوي يوماً قتاد ولا مرخ",54,"خ",1,0],["خشنت بالله لهم","حتى ألنت الخشنا",55,"ن",2,0],["خشعتِ فلا عينٌ تراكِ لناظرٍ","دثوراً ولا نطقٌ يخبّرنا عنكِ",56,"ك",1,0],["خُشُبٌ مسنّدَةٌ على","تلك المطارحِ والمسانِدْ",57,"د",1,0],["خَشعت وَعادتني لَدى حصن طارق","هُمومي وَاِبتَلَت لَدَيهِ جُفون",58,"ن",1,0],["خشيت غيور الحمى أن يرى","وصالهما فيثير الكفاحا",59,"ح",2,0],["خشن الزَّمانُ لديَّ حين جئتهُ","فرفلتُ في نعماهُ فوق حرير",60,"ر",1,