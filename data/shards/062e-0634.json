{"poems":[[55,"خشيت صدودي ليس ذاك بكائن","https://www.aldiwan.net/poem26333.html","الطويل"],[9,"قالت سمية من مدح","https://www.aldiwan.net/poem21971.html","مجزوء الكامل"],[86,"لاح منها حاجب للناظرين","https://www.aldiwan.net/poem68836.html","الرمل"],[86,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[51,"ألف بين الفؤاد والكمد","https://www.aldiwan.net/poem61956.html","المنسرح"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[44,"تحاول شيئا قد تولى فودعا","https://www.aldiwan.net/poem29669.html","الطويل"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[69,"خشيت على حبيب القلب لما","https://www.aldiwan.net/poem28262.html","الوافر"],[69,"خشونة أهل العلم غير عجيبة","https://www.aldiwan.net/poem28500.html","الطويل"],[69,"خشيت على حبيب القلب لما","https://www.aldiwan.net/poem28829.html","الوافر"],[48,"يا ماسح القبلة من خده","https://www.aldiwan.net/poem66183.html","السريع"],[50,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85384","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[91,"الشباب والحب","https://www.poetsgate.com/ViewPoem.aspx?id=53231",""]],"verses":[["خَشيتِ صُدودي لَيسَ ذاكَ بِكائِنٍ","أَتى دُونَهُ حُبٌّ لِعَينَيَّ مُسهِرَ",0,"ر",1,1],["خَشِيَ الصَرارِي صَولَةً","مِنهُ فَعاذوا بِالكَوازِل",1,"ل",1,0],["خَشَعَت أَبصارُهُم لَمّا بَدَت","وَإِلى الأَذقانِ خَرّوا ساجِدين",2,"ن",1,0],["خَشَعَ البَحرُ إِذ رَكِبتَ جَواري","هِ خُشوعَ القُلوبِ يَومَ الحِسابِ",3,"ب",1,0],["خشيتُ أنِّي ومن كَلفْتُ به","لا نتلاقى ونحن في بلدِ",4,"د",1,0],["خَشِنِ الإِهابِ كَأَنَّهُ في جَوشَنٍ","وَكَأَنَّما في كُلِّ عُضوٍ مِنجَلُ",5,"ل",1,0],["خَشيتَ عَلَيهِ أَن يُطَوِّحَهُ الهَوى","فَأَلفاكَ هَذا الخَوفُ في الهُوَّةِ السُفلى",6,"ل",2,0],["خَشيَةً أَن أَرى الَّذي لا يَراهُ","لي أَو أَن أُريدَ ما لا يُريدُه",7,"د",2,0],["خشَعَتْ له إنْ بانَ عنها صادراً","وتبسَّمَتْ لما أتاها وَارِدا",8,"د",2,0],["خَشَيتُ اِنفِساخَ العَهدِ عَنّي وَإِنَّني","لِعَهدِكَ لا وَاللَهِ ما أَنا فاسِخُ",9,"خ",1,0],["خَشيتُ عَلى الآراكِ سَطوَةَ بَأسِهِ","وَأَطوادُ رَضوى دونَها وَالشَمارِخُ",9,"خ",1,0],["خَشُنتَ عَلى الأَعداءِ في الحَربِ مَلمَساً","وَغُصنُكَ غَضٌّ في الشَبيبَةِ شارِخُ",9,"خ",1,0],["خَشُنتَ عَلى التَأديبِ فَهماً وَمَنطِقاً","وَلِنتَ عَلى الأَيّامِ ليتاً وَأَخدَعا",10,"ع",2,0],["خَشُنتِ عَلَيهِ أُختَ بَني خُشَينِ","وَأَنجَحَ فيكِ قَولُ العاذِلَينِ",11,"ن",1,1],["خَشَعوا لِصَولَتِكَ الَّتي هِيَ عِندَهُم","كَالمَوتِ يَأتي لَيسَ فيهِ عارُ",12,"ر",1,0],["خشيتُ على حبيبِ القلبِ لما","أتى حمامَهُ ونضى الثيابا",13,"ب",2,1],["خشونةُ أهلِ العلمِ غيرُ عجيبةٍ","وإنْ بالغوا في الحفظ والبحثِ والفكرِ",14,"ر",1,1],["خشيتُ على حبيبِ القلبِ لمَّا","أتى حمَّامَهُ ونَضا الثيابا",15,"ب",2,1],["خَشيتَ أَن يَعرِفَ إِعجامَها","مَولاكَ في الخَدِّ فَيَقراها",16,"ا",3,0],["خُشّابَ هَل لِمُحِبٍّ عِندَكُم فَرَجُ","أَو لا فَإِنّي بِحَبلِ المَوتِ مُعتَلِجُ",17,"ج",1,1],["خُشّابَ جودي جِهاراً أَو مُسارَقَةً","فَقَد بُليتُ وَمَرَّت بِالمُنى حِجَجُ",17,"ج",1,0],["خَشيَةُ اللَهِ وَأَنّي رَجُلٌ","إِنَّما ذِكري كَنارٍ بِقَبَل",18,"ل",1,0],["خشيتي ان اكون ساعة تدعي","ن الى العود قد هلكت قصيا",19,"ي",2,0],["خشيَتي أن تطيل في القبر نوماً","فيشق البلى إليك سَبيلا",20,"ل",2,0],["خشيت عَلى نَفسي فأزمعت رجعة","إلى بلدي من قبل أني أصرع",21,"ع",1,0],["خشعتْ له النَّسَمات وهي هوازجٌ","وتنصّتَ العصفورُ وهو يُهينمُ",22,"م",1,0],["خشعوا فلم يجروهما أو ينبسوا","إلا كما يتخافت القراء",23,"ا",2,0],["خَشَعَت لفَيْضِ جَلالِكَ الأَبْصارُ","وَذَكَتْ بِمِسْك خِلاَلِكَ الأَشْعَارُ",24,"ر",1,1],["خَشِيتَ اللهَ عن علمٍ ، وحقٌّ","إذا لم تَخشَ في الحقّ العبادا",25,"د",2,0],["خشيت عليه أن يطوحه الهوى","فألقاك هذا الخوف في الهوّة السفلى",26,"ل",2,0]]}