{"poems":[[55,"خشيت صدودي ليس ذاك بكائن","https://www.aldiwan.net/poem26333.html","الطويل"],[9,"قالت سمية من مدح","https://www.aldiwan.net/poem21971.html","مجزوء الكامل"],[86,"لاح منها حاجب للناظرين","https://www.aldiwan.net/poem68836.html","الرمل"],[86,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[51,"ألف بين الفؤاد والكمد","https://www.aldiwan.net/poem61956.html","المنسرح"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[44,"تحاول شيئا قد تولى فودعا","https://www.aldiwan.net/poem29669.html","الطويل"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[69,"خشيت على حبيب القلب لما","https://www.aldiwan.net/poem28262.html","الوافر"],[69,"خشونة أهل العلم غير عجيبة","https://www.aldiwan.net/poem28500.html","الطويل"],[69,"خشيت على حبيب القلب لما","https://www.aldiwan.net/poem28829.html","الوافر"],[48,"يا ماسح القبلة من خده","https://www.aldiwan.net/poem66183.html","السريع"],[50,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85384","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[91,"الشباب والحب","https://www.poetsgate.com/ViewPoem.aspx?id=53231",""],[142,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[225,"خشيتك حتى قيل إني لم أثق","https://www.aldiwan.net/poem55104.html","الطويل"],[252,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[270,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[280,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[298,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[342,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[366,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[377,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[409,"لعمرك ما ينسيني الدهر روعتي","https://www.aldiwan.net/poem31852.html","الطويل"],[409,"إلى الله أشكو روعتي ورزيتي","https://www.aldiwan.net/poem31862.html","الطويل"],[416,"من مجيري من فؤاد كلما","https://www.aldiwan.net/poem54048.html","الرمل"],[437,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[452,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[458,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[461,"ربعي من بني جشم","https://www.aldiwan.net/poem15121.html","المديد"],[461,"شرف الدولة بحر زاخر","https://www.aldiwan.net/poem15129.html","الرمل"],[461,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[461,"السيف والحجة الغراء قد شهدا","https://www.aldiwan.net/poem15158.html","البسيط"],[461,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[461,"لله درك من مقارن همة","https://www.aldiwan.net/poem16024.html","الكامل"],[461,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[464,"طال السهاد مع القلق","https://www.aldiwan.net/poem3469.html","عموديه"],[468,"أنحلني بصده","https://www.aldiwan.net/poem60183.html","مجزوء الرجز"],[479,"أبت الوداع فبكرت برحيل","https://www.aldiwan.net/poem36916.html","الكامل"],[514,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[515,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[515,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[551,"أفي دارهم من بعدما ارتحلوا تبكي","https://www.aldiwan.net/poem47342.html","الطويل"],[567,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"]],"verses":[["خَشيتِ صُدودي لَيسَ ذاكَ بِكائِنٍ","أَتى دُونَهُ حُبٌّ لِعَينَيَّ مُسهِرَ",0,"ر",1,1],["خَشِيَ الصَرارِي صَولَةً","مِنهُ فَعاذوا بِالكَوازِل",1,"ل",1,0],["خَشَعَت أَبصارُهُم لَمّا بَدَت","وَإِلى الأَذقانِ خَرّوا ساجِدين",2,"ن",1,0],["خَشَعَ البَحرُ إِذ رَكِبتَ جَواري","هِ خُشوعَ القُلوبِ يَومَ الحِسابِ",3,"ب",1,0],["خشيتُ أنِّي ومن كَلفْتُ به","لا نتلاقى ونحن في بلدِ",4,"د",1,0],["خَشِنِ الإِهابِ كَأَنَّهُ في جَوشَنٍ","وَكَأَنَّما في كُلِّ عُضوٍ مِنجَلُ",5,"ل",1,0],["خَشيتَ عَلَيهِ أَن يُطَوِّحَهُ الهَوى","فَأَلفاكَ هَذا الخَوفُ في الهُوَّةِ السُفلى",6,"ل",2,0],["خَشيَةً أَن أَرى الَّذي لا يَراهُ","لي أَو أَن أُريدَ ما لا يُريدُه",7,"د",2,0],["خشَعَتْ له إنْ بانَ عنها صادراً","وتبسَّمَتْ لما أتاها وَارِدا",8,"د",2,0],["خَشَيتُ اِنفِساخَ العَهدِ عَنّي وَإِنَّني","لِعَهدِكَ لا وَاللَهِ ما أَنا فاسِخُ",9,"خ",1,0],["خَشيتُ عَلى الآراكِ سَطوَةَ بَأسِهِ","وَأَطوادُ رَضوى دونَها وَالشَمارِخُ",9,"خ",1,0],["خَشُنتَ عَلى الأَعداءِ في الحَربِ مَلمَساً","وَغُصنُكَ غَضٌّ في الشَبيبَةِ شارِخُ",9,"خ",1,0],["خَشُنتَ عَلى التَأديبِ فَهماً وَمَنطِقاً","وَلِنتَ عَلى الأَيّامِ ليتاً وَأَخدَعا",10,"ع",2,0],["خَشُنتِ عَلَيهِ أُختَ بَني خُشَينِ","وَأَنجَحَ فيكِ قَولُ العاذِلَينِ",11,"ن",1,1],["خَشَعوا لِصَولَتِكَ الَّتي هِيَ عِندَهُم","كَالمَوتِ يَأتي لَيسَ فيهِ عارُ",12,"ر",1,0],["خشيتُ على حبيبِ القلبِ لما","أتى حمامَهُ ونضى الثيابا",13,"ب",2,1],["خشونةُ أهلِ العلمِ غيرُ عجيبةٍ","وإنْ بالغوا في الحفظ والبحثِ والفكرِ",14,"ر",1,1],["خشيتُ على حبيبِ القلبِ لمَّا","أتى حمَّامَهُ ونَضا الثيابا",15,"ب",2,1],["خَشيتَ أَن يَعرِفَ إِعجامَها","مَولاكَ في الخَدِّ فَيَقراها",16,"ا",3,0],["خُشّابَ هَل لِمُحِبٍّ عِندَكُم فَرَجُ","أَو لا فَإِنّي بِحَبلِ المَوتِ مُعتَلِجُ",17,"ج",1,1],["خُشّابَ جودي جِهاراً أَو مُسارَقَةً","فَقَد بُليتُ وَمَرَّت بِالمُنى حِجَجُ",17,"ج",1,0],["خَشيَةُ اللَهِ وَأَنّي رَجُلٌ","إِنَّما ذِكري كَنارٍ بِقَبَل",18,"ل",1,0],["خشيتي ان اكون ساعة تدعي","ن الى العود قد هلكت قصيا",19,"ي",2,0],["خشيَتي أن تطيل في القبر نوماً","فيشق البلى إليك سَبيلا",20,"ل",2,0],["خشيت عَلى نَفسي فأزمعت رجعة","إلى بلدي من قبل أني أصرع",21,"ع",1,0],["خشعتْ له النَّسَمات وهي هوازجٌ","وتنصّتَ العصفورُ وهو يُهينمُ",22,"م",1,0],["خشعوا فلم يجروهما أو ينبسوا","إلا كما يتخافت القراء",23,"ا",2,0],["خَشَعَت لفَيْضِ جَلالِكَ الأَبْصارُ","وَذَكَتْ بِمِسْك خِلاَلِكَ الأَشْعَارُ",24,"ر",1,1],["خَشِيتَ اللهَ عن علمٍ ، وحقٌّ","إذا لم تَخشَ في الحقّ العبادا",25,"د",2,0],["خشيت عليه أن يطوحه الهوى","فألقاك هذا الخوف في الهوّة السفلى",26,"ل",2,0],["خشَوا أن يضِلَّ الضيفُ عنهم فرفَّعوا","من النار في الظلماء ألويةً حُمرا",27,"ر",2,0],["خَشِيَ القومُ أَن تهبَّ بنكبا","تِ الرزايا عليهمُ النكباءُ",28,"ا",2,0],["خَشيتُكَ حتى قيلَ إنيَ لم أَثِق","بِأنَّك تَعفو عن كَثيرٍ وَترحمُ",29,"م",1,1],["خَشوا أَن يُلاقوا جَحفَلاً كُلَّ فارِسٍ","يعدونَه منه خَميساً وَجَحفَلا",30,"ل",2,0],["خشونةُ دنّها ثقلت عَليها","وكيفَ تحبُّ ضاحكةٌ عبوسا",31,"س",2,0],["خُشُوعٌ وَإِيمانٌ وَعَدْلٌ وَرَأْفَةٌ","فَقَدْ حُقَّ بِالنَّعْماءِ مِنْكَ حَقِيقُها",32,"ق",3,0],["خشعتُ إِذْ قَرَعَ الناقوسُ في سحرٍ","من ليلةٍ ذات أسدافٍ وَأحلاك",33,"ك",1,0],["خشب مسندة","وراءها حطب",34,"ب",1,0],["خَشُنتَ لِحالٍ كَشَوكِ القَتادِ","وَلِنتُ لِأُخرى كَشَوكِ السِيالِ",35,"ل",1,0],["خشي الإلهُ عليه عند كماله","والنقصُ في أهل الفضيلة مولع",36,"ع",1,0],["خَشيتُ عليه اليُتم بعدي فَليتَني","رُميتُ بما أَخْشى ولم أُرْمَ بالثَّكلِ",37,"ل",1,0],["خَشِيتُ عليه اليُتْمَ لكنَّ ثُكْلَهُ","ولوعَتَه لم يخطُرَا لي على فِكْرِ",38,"ر",1,0],["خشية الواشين صبٌّ لم يزلْ","يُظهِرُ الدَّمع ويخفي الكمدا",39,"د",2,0],["خشية الله درعه وتقاه","إذ يلقيه نضرة وسرورا",40,"ر",2,0],["خشيتُ بسدلها في الحيّ من أن","يُهبَّ أشَطَهُمْ أدنى شَذَاها",41,"ا",3,0],["خشُنَتْ جِعادُ أكفِّهم فكأنما","في اللؤم صيغت من طباع الأزمنِ",42,"ن",1,0],["خُشُنٌ والضَّيمُ مُعْتَرضٌ","ذُلُلٌ والنَّاسُ إِخوان",43,"ن",1,0],["خَشن النَّجدةِ لا كِبْرٌ به","لينُ الملمسٍ من غيرِ خُوَرْ",44,"ر",1,0],["خشيان من ذي العرش لو خاضت به","ساعاتُه بين القنا لم يجْزعِ",45,"ع",1,0],["خشونةٌ لا يطولُ الجبرؤُتُ بها","ولِينةٌ كرُمتْ عن رقَّةِ الخورِ",46,"ر",1,0],["خَشِنُ البطْشَةِ لا بَغْيَ بهِ","لَيِّنُ الملمس من غير فَشَلْ",47,"ل",1,0],["خَشْيانَ مقْصوبٍ على غَلْوائهِ","جَمِّ المَحاسب في السُّرى والمنزل",48,"ل",1,0],["خشاشاً كنصل السيف في كفِّ باسلٍ","يَعُزُّ به ذِمْرٌ ويَبْهَجُ ناظِرُ",49,"ر",1,0],["خشيان يطوي منهُ جن","حُ الليل ما نشرَ العبقْ",50,"ق",1,0],["خِشفٌ لَهُ مِن ثَغرِهِ","مِثلُ الَّذي في عِقدِهِ",51,"د",2,0],["خشيت تصدع بالوداع جوانحي","فغدت تحث السير قبل عويلي",52,"ل",2,0],["خشيتْ مُشاركتي بذَنبِ تخلّفي","عنكم فكان لها لديكَ تسرُّعُ",53,"ع",1,0],["خشنتم ولانت في هواكم معاطفي","وما يستوي يوماً قتاد ولا مرخ",54,"خ",1,0],["خشنت بالله لهم","حتى ألنت الخشنا",55,"ن",2,0],["خشعتِ فلا عينٌ تراكِ لناظرٍ","دثوراً ولا نطقٌ يخبّرنا عنكِ",56,"ك",1,0],["خُشُبٌ مسنّدَةٌ على","تلك المطارحِ والمسانِدْ",57,"د",1,0]]}