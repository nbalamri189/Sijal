{"poems":[[73,"لما تشكى ابن عصرون إلي حمى","https://www.aldiwan.net/poem3816.html","البسيط"],[71,"حمى فلان أطبقت ليتها","https://www.aldiwan.net/poem28617.html","السريع"],[107,"ألا إن هذا وفد كندة قد أتى","https://www.aldiwan.net/poem44007.html","الطويل"],[242,"طال الطريق إلى فاس على الساعي","https://www.aldiwan.net/poem19491.html","البسيط"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[447,"من لائمي إن سفحت الدمع من مقلي","https://www.aldiwan.net/poem14476.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[2082,"","https://poetry.dctabudhabi.ae/diwan/poem/22575","الوافر"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101704","البسيط"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11257","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100792","الطويل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130440","البسيط"]],"verses":[["وَقالَ داءٌ عُضالٌ قَد رُميتُ بِهِ","أَعيا وَقَصَّرَ عَنهُ كُلُّ مِسبارِ",0,"ر",1,0],["وقالَ دعني ما أنا طيِّبٌ","فقلتُ خبِّرْني متى طِبْتا",1,"ت",2,0],["وقال دَعوْها عادةً جاهليّةً","فلا أنا ذُو مُلْكٍ ولا بِيَ من أشَرْ",2,"ر",1,0],["وَقَالَ دَاعِي السُّرَى نَادَيْتُ مُسْتَمِعاً","وَقَالَ دَاعِي الْعَنَا أَبْلَغْتَ أَسْمَاعِي",3,"ع",2,0],["وقال دُرّي لِمَنْ أَصبَحْتَ تَقْصِدُ بي","غداً وماذا الذي أمسَيْتَ تَنْويه",4,"ي",2,0],["وقال دافنها ذي دقة دفنت","في الترب يا ليتها في القلب والمقل",5,"ل",1,0],["وَقالَ داعي الندى في الناس حيّ عَلى","خَير الصِلات فَإِنّ الوقت مَشهودُ",6,"د",1,0],["وَقالَ دَليلُهُم لَمّا أَتاهُم","بِأَعلى الخَبتِ داهِيَةٌ عَقوقُ",7,"ق",1,0],["وقال داء هوى يأبى الشفاء فان","أهملته زاد أو داويته نكسا",8,"س",2,0],["وَقالَ دَعِ الهِجاءَ وَقُل جَميلاً","فَإِنَّ القَصدَ أَقرَبُ لِلثَوابِ",9,"ب",1,0],["وقال دع الدنيا فقد يبلغ المنى","أخو اللؤم فيها والكريم يخيب",10,"ب",1,0],["وقال دونكها إن شئت من قدحي","أو من لمى شفتي اللعساء أو حدقي",11,"ق",2,0]]}