{"poems":[[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[93,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[109,"كيف عشقت امرأة لم ألقها.. ؟","https://www.poetsgate.com/ViewPoem.aspx?id=214005",""],[107,"أتسأل مصر ما حمل العميد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55036&r=&rc=206",""],[146,"قلت لعمرو جذلا","https://www.aldiwan.net/poem58372.html","مجزوء الرجز"],[214,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[463,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138278",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83319","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122736","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66632","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64734","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64456","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79823","المتقارب"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66274","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48265","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53087","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123753","المتقارب"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201576","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91751","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"فتح بلدة نفعا","https://www.poetsgate.com/ViewPoem.aspx?id=124499",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[4955,"تخاطبني الدموع بلا كلام","https://www.poetsgate.com/ViewPoem.aspx?id=197905",""],[5145,"هنيئاً لدينٍ قد غدوت يمينه","https://www.poetsgate.com/ViewPoem.aspx?id=108174",""],[5550,"لقد وعدتني","https://www.poetsgate.com/ViewPoem.aspx?id=211487",""],[5605,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=159457",""],[5789,"أفنية العنادل","https://www.poetsgate.com/ViewPoem.aspx?id=201407",""],[5956,"النِّيلُ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184947",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6102,"كَأَنَّ يَومَ الهَوَانِ عِيدُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=184855",""]],"verses":[["فَما أُجشِمتِ مِن إِتيانِ قَومٍ","هُمُ الأَعداءُ وَالأَكبادُ سودُ",0,"د",1,0],["فَمَا أَجْدَرَ الْقَلْبَيْنِ فِيهِ تَلاقَيَا","عَلَى سِقْوَةٍ أَنْ يَسْلُوهَا وَيَنْعَمَا",1,"م",2,0],["فما اجتلاهُ غير مُستحسنٍ","ولا ابتلاهُ غيرُ مستنْفس",2,"س",1,0],["فَما أَجمَلَ الصَيفَ في الخَلَواتِ","وَأَروَعَ آياتِهِ البَيِّنات",3,"ت",1,0],["فما أجلها وما أرقها","إن عرفت حقي عرفت حقها",4,"ه",2,0],["فما أجد بمالك أمر مصر","وما بالشعب جبن أو جمود",5,"د",1,0],["فما اجتويتَ منزلا","إلا انتجعتَ منزلا",6,"ل",2,0],["فما آجالنا الا هبات","وما الانسان الا كالهباء",7,"ا",2,0],["فما اجتمعت بَروجِرْدٌ وفقرٌ","ولا أحدٌ رأى سعداً ونحسا",8,"س",2,0],["فما اجتلاها امرؤ إلا رأى عجبا","وقال إن اختباري صدق الخبرا",9,"ر",2,0],["فَما آجَلُ يَرجونَهُ غَيرَ عاجِلِ","وَما عاجِلٌ يَأبونَهُ غَيرَ آجِلِ",10,"ل",1,0],["فَما أجلَّك إذ تُمسي عَلَى أَمل","مِن الحياةِ وَإذ تُضحي عَلَى أمَلِ",11,"ل",1,0],["فما أجابوا في النِّدا","سوى الوصيِّ المُرْتَضى",12,"ا",1,0],["فما أَجْدَى عليَّ سِوى ثَنائي","على مَلِكٍ غَدا للدِّينِ مَجْدا",13,"د",2,0],["فما أجدر الدعوى لمن تلك حاله","برد ودحض المدعي دون حجة",14,"ه",1,0],["فما أجلت الحربُ عن مِثله","صريعاً يجبّن شُجعانَها",15,"ن",3,0],["فما أجلت الطرفَ في تاريخه","أما ترى محمداً تلا علي",16,"ل",2,0],["فَمَا أجْرَاهُ أن ما ظَنَّ هّذا","وقَلْبُكَ في القَضِيَّةِ مِن شُهُودي",17,"د",2,0],["فما اجْتَدى بقريضٍ قطُّ ذا كرمٍ","إلا محمدَ نجلَ السادةِ الكُرَما",18,"م",2,0],["فما أجملت جُمل ولا نُعم أنعمت","ولا سمحت يوماً سعاد بإسعاد",19,"د",1,0],["فما اجتنيت خدوداً من شقائقها","إلا اجتنيت ثغوراً من أقاحيها",20,"ي",3,0],["فما أجلد القلبَ في النائباتِ","ويا قلبُ صبراً لهذي الكُلوم",21,"م",1,0],["فَما أَجابوهُ عَلى الفَور وَقَد","كانَ بِهِم خُبث عَظيم وَحِقد",22,"د",1,0],["فما أجمل الموت المبكر قبل أن","نشاهد بالعينين موت الفضائل",23,"ل",1,0],["فَما أَجدر النائين بالنوح وَالبُكا","إِذا أَبصروا المَغنى فَلم يَجدوا القَوما",24,"م",2,0],["فما أجهله بالخل","ق ذاك العالم العانى",25,"ن",2,0],["فَما أَجابَ مُجيبٌ وَالتَوَوا قَلَقاً","وَكادَ جَيشُ العِدى لِلسورِ يَندَفِعُ",26,"ع",1,0],["فما أجدتهم نفعاء نفعا","ولا حصنتهم من كل رام",27,"م",1,0],["فما أجدتهم نفعاء نفعاً","ولا حصنتهم من كل رامي",28,"م",2,0],["فما أجملَ الغدَ واليومُ عزٌّ","وما أبأسَ اليومَ والأمسُ مُقْلِقْ",29,"ق",1,0],["فما أجراكِ فوقَ الخدِّ قولي","كأنَّكِ في المسيرِ غدوتِ نهرا",30,"ر",2,0],["فما أجدر الأيام أن يتقينه","وما أقدر الأقدار أن يقتدينه",31,"ن",2,0],["فما أجْملَ الأيّامَ والوصْلُ حاضرٌ","وما أقبح الأيّام حين يغيبُ",32,"ب",1,0],["فما أجمل الدنيا عروسا تزينت !","وكل الذي فيها جميل وأجمل",33,"ل",1,0],["فَمَا أجمَلَ الغَيمَ فَوقَ َالظِّلَال","تمَنَّيتُ فِي الرِّيحِ كَي أنقُلَك",34,"ك",1,0],["فما أجمل المنقار يبلغ غابةً","وجسمه في عش وعنه يقارعُ",35,"ع",1,0],["فَمَا أجَابَ الحُزْنُ رَاهِبَهُ","وَلَا أعَادَ الأَمسَ مِنْ غَسَمِ",36,"م",1,0],["فَمَا أَجَبتُ سِوى بِرَدٍّ : ( كَأَنَّ يَومَ الهَوَانِ عِيدُ )","مُذ مَزَّقَتنِي رَبَتْ عَلَى شِريَانِي بِتَمزِيقِها الوُرُودُ",37,"د",1,0]]}