{"poems":[[55,"أبيعك بيع الأديم النغل","https://www.aldiwan.net/poem29857.html","المتقارب"],[37,"سيأتي أمير المؤمنين ودونه","https://www.aldiwan.net/poem38819.html","الطويل"],[32,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[29,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[68,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[46,"ضاحكن من أسف الشباب المدبر","https://www.aldiwan.net/poem29983.html","الكامل"],[41,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[48,"أفنوا الذخائر فالقضاء مجهز","https://www.aldiwan.net/poem22718.html","الكامل"],[136,"عجبت لأسرة الحسن الدينا","https://www.aldiwan.net/poem54720.html","الوافر"],[520,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[543,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[587,"قعيدك يا يزيد أبا قبيس","https://www.aldiwan.net/poem1747.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126704","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86957","البسيط"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18530","الرمل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72326","الكامل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18223","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12022","الوافر"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17514","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69406","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69316","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88634","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93872","المتدارك"],[2841,"","https://poetry.dctabudhabi.ae/diwan/poem/133886","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100221","المتقارب"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66438","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111114","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54345","البسيط"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138828",""],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107127","الكامل"],[4791,"اهل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=34896",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[5485,"افخر أبا جعفر ان كنت مفتخرا","https://www.poetsgate.com/ViewPoem.aspx?id=200787",""],[5493,"افخر بأني","https://www.poetsgate.com/ViewPoem.aspx?id=197563",""]],"verses":[["أَفَخراً فَحَسبي بِما قَد أَطا","لَ باعي وَأَنزَلَني في القُلَل",0,"ل",1,0],["أُفَخِّمُ فيها آلَ مَروانَ إِنَّهُم","إِذاعَمَّ خوفُ عَبدِ شَمسٍ حُصونُها",1,"ن",3,0],["أَفَخراً حِينَ تَحمِلُ قَريَتاكُم","وَلُؤماً في المَواطِنِ وَاِنِكسارا",2,"ر",2,0],["أَفَخراً إِذا رابَت وَطابُ مُجاشِعٍ","وَجاءَت بِتَمرٍ مِن حُوارينَ عيرُها",3,"ر",3,0],["أَفَخرَ الدينِ كَم أَعلَيتَ فَخراً","لِآلِكَ حينَ تَشهَدُ أَو تَغيبُ",4,"ب",1,0],["إِفخَر بِجودِكَ دونَ فَخرِكَ إِنَّما","جَدواكَ تَنشُرُ عَنكَ ما لَم تَنشُرِ",5,"ر",1,0],["أَفَخراً تِميميّاً إِذا فِتنَةٌ خَبَت","وَلُؤماً إِذا ما المَشرَفِيَّةُ سُلَّتِ",6,"ت",1,0],["إِفخَرهُمُ وَلَو أَنَّهُم ذَهَبٌ صَفا","ذَهَبوا فَكَيفَ وَهُم مِنَ الفَخّارِ",7,"ر",1,0],["أفَخرُ بَعدَمَا قد بُلًّغَتهُ","شُهودُ الحَاضِرينَ الغَائِبِينَا",8,"ن",2,0],["أفخر فحسبك ما أوتيت من حسب","كفاك مجدك من إرث ومكتسب",9,"ب",1,1],["أَفَخرَ مُلوكِ الأرضِ لا زِلتَ فَخرَهُم","ويَكفيهِمُ أن لا تَزال لهم فَخرا",10,"ر",2,0],["أَفَخراً في الخلاءِ بغيرِ فخرٍ","وَعندَ الحربِ خوّاراً ضَجورا",11,"ر",2,0],["أَفَخري هذا في التراب مغيّب","أمِ البدر في هذا الضريح محجّبُ",12,"ب",1,1],["أَفخري مُذ فارقتَ شعبك أصبَحَت","عليك بنو العلياء للدمع تسكبُ",12,"ب",1,0],["افخَر بِمَولد نجل طابَ مَنبعُهُ","وَاشكر فَطالعُه المَسعود يَرفعُهُ",13,"ه",1,1],["أَفَخَرتُم أَن قَتَلتُم أَعبُداً","وَهَزَمتُم مَرَّةً آلَ عَزَل",14,"ل",1,0],["أفخرتم بالغار لما حله معه","امرؤ في صفه وأمان",15,"ن",1,0],["اِفخَر بِنا إِن كُنتَ يَوماً فاخِراً","تَلقَ الأُلى فَخَروا بِفَخرِكَ أُفرِدوا",16,"د",3,0],["أَفَخرَ الدينِ زِد فَخراً وَعِزّاً","عَلى الأَملاكِ مِن قاصٍ وَدانِ",17,"ن",1,0],["اِفخَر وَكاثِر بِالقَريحَ","ةِ إِنَّها فَخرُ المَكاثِر",18,"ر",1,1],["أَفَخرَ المُلكِ عِش أَبَداً فَإِنّي","بِعَيشِكَ مِن زَماني في أَمانِ",19,"ن",1,0],["أَفَخرِ مَخلوقٍ فَخَر","مِن نَفَرٍ خَيرِ نَفَر",20,"ر",1,0],["افخرا على قوم ابوها استرقكم","لدى الروع اذ كنتم اذل واحقرا",21,"ر",2,0],["افخرا بيوم الطف اذ هم عصابة","حشدتم عليها ما خلا الجن عسكرا",21,"ر",2,0],["أفخالوا الغابة خالية","لا صبر على زأر القسور",22,"ر",1,0],["أفخراً على المولى إذا ما بطِنتُمُ","ولؤماً إذا ما الحربُ شَبّ سعيرُها",23,"ر",3,0],["أفخر العشيرة من غالب","ألان أضيع رجا الطالب",24,"ب",1,1],["افخَر بفاطِمَةٍ وافخَر بِحَيدَرَةٍ","إذَا مليكٌ بآباءٍ لَهُ افتَخَرَا",25,"ر",2,0],["أفخر المدح ما أتى من مَجيدٍ","مدحته الأنام بالفضل طرّا",26,"ر",2,0],["أَفَخِلتَ جَيشَهُمُ إِزاءَ سَفِينِنا","في السَّهلِ فَوقَ هِضابِهِ قَد أَنجَدا",27,"ا",1,0],["أفخر بر في الملا مفتخر","يابن الميامين الألى من هاشم",28,"م",1,0],["إفخْر فإن ملوكَ الأرضِ أذهلهمْ","ما قد فعلتَ فكلٌّ فيكَ مفتكرُ",29,"ر",1,0],["افخرْ فإنَّ ملوكَ الأرضِ قاطبةً","أَفلاكُها منكَ قد دارتْ على قُطَبِ",30,"ب",1,0],["أفخرٌ وبابُ الفخرُ دونكَ مُغلَقُ","وكِبرٌ وطيرُ الكِبر عنكَ مُحَلّقُ",31,"ق",1,1],["أفخر على كل الملوك على بما","أعطاك رب واحد قهّار",32,"ر",1,0],["أفخر بحبك واماري بك","لأهل الهوى ما حسبت حساب",33,"ب",1,0],["افخر بقافي وكل ربعي تفخر","كما يفاخر بمْحفوظ اللامي",34,"م",2,0],["افخر أبا جعفر ان كنت مفتخرا","فقد نبهت وصرت العدل والحكما",35,"م",2,1],["اِفخر بأني بثوب العز أستترُ","واصدَعْ وقلْ إنها بالحقّ تشتهرُ",36,"ر",1,1]]}