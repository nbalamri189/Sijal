{"poems":[[65,"يا عبرتي هذه الأطلال والدمن","https://www.aldiwan.net/poem45695.html","البسيط"],[53,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54921","الرمل"],[132,"يا نفس أنت محادده","https://www.aldiwan.net/poem50643.html","مجزوء الكامل"],[164,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[303,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[396,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[409,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64955","الهزج"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108563","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202555","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47159","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137409",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91634","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131116",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135647","المجتث"],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5186,"خلوا عقيم البحث في خلخالها","https://www.poetsgate.com/ViewPoem.aspx?id=156494",""],[5216,"غَرامي","https://www.poetsgate.com/ViewPoem.aspx?id=187641",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[5455,"الوصية","https://www.poetsgate.com/ViewPoem.aspx?id=213961",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5691,"ليوث الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=206859",""],[5725,"الحاضرون","https://www.poetsgate.com/ViewPoem.aspx?id=210514",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""]],"verses":[["والأُذنُ تَسمَعُها وَالقَلبُ يَصحَبُهُم","وَأَنتِ يا عَينُ لا يَعتادُكِ الوَسَنُ",0,"ن",1,0],["وألَّ إذ صكته صكاً بعد صكّْ","مسوّماتٌ تترك السمع أسكّْ",1,"ك",1,0],["وَالأَذَى مَا فِيه شَكٌّ","جَاءَهُ مِنْ حَيْثُ يَدْرِي",2,"ر",2,0],["والأذن قالت مُرْسِلي","قلبٌ فِصرْتُ القائِدَهْ",3,"د",2,0],["والإِذن يبرز في أَهل الفياح بأَن","يؤتى بهم رجل من بعده رجُلُ",4,"ل",1,0],["والأُذنُ تسمعُ من تطريبه نغماً","يكاد منه نياطُ القلبِ ينقطع",5,"ع",1,0],["والأذن تعصي إذا سمعت لقيل وقال","من كل ما لا يجوز قوله من ضلال",6,"ل",1,0],["وَالأُذنُ تَقضي ما تُريد وَتَشتَهي","مِن طِفلَةٍ مَع عودِها كَالمُطفِل",7,"ل",1,0],["والأذن سكرى من شراب حديثهم","فلذاك تهزأ بالعذول ولا تعي",8,"ع",2,0],["وإِلاّ ذَهَبَتْ نَفْسُ","كَ بالحَسْرةِ مَوسومَهْ",9,"م",2,0],["والٍ إذا رعت الدجنة باسمه","عزَّى الغراب بها الصدى الصياحا",10,"ح",2,0],["والأذن في تقبيل مجزيا","من بطنها النعماء ترشف ظهرها",11,"ر",3,0],["والأذن في صَمَمٍ والسّاقُ في سكن","واليدُّ في سدل فالكلّ منخذل",12,"ل",1,0],["والأذن تعشق بالسماع وربما","سبقت عيون بنى الهوى برحاؤها",13,"ا",3,0],["والأذن تجهل صوت الرعد من صمم","وَينكر الفم طعم الماء من سقم",14,"م",1,0],["وَإِلا ذاك دمعٌ أَرسلته","لفرقة كرمها بنتُ الدنان",15,"ن",1,0],["والأذن إن سمعت من منشد طرب","لحنا شجيا إليه أهدت الطربا",16,"ب",2,0],["والإذن في الورد كي ما","به يعود مُحَلَّى",17,"ل",2,0],["والأُذْنُ لضحْكِكُمُ حَنّتْ!","فهو الأنغامُ لها سِحْرُ!",18,"ر",1,0],["والإذاعات تشجب الواقع ال","مرّ وشجب العدو ما أنكاه",19,"ا",2,0],["والأذن عانية إلى نخاسها","والعين شاخصة إلى دلالها",20,"ل",3,0],["والأُذْنُ قدْ طَرِبَتْ مِنْ سِحْرِ أغنيةٍ","إذْ رتَّلتْها شِفاهٌ صَمتُها نَطَقا",21,"ق",2,0],["والأُذْنُ قدْ سَمِعَتْ والعَيْنُ مُبْصِرَةٌ","طِفْلٌ بسَاحِ الوَغَى وسَيفَهُ حَجَرُ",22,"ر",1,0],["والا ذاك ان شاع ذكره وان تساما","والله اني خابره راعي رديه",23,"ي",2,0],["والاذنين لوتنصت فلاهي بتستمع","وهي دوم بحظور المليمين غايبه",24,"ب",2,0],["والأذن في صممِ والعين في ظلمٍ","والفكر في غممِ والقلب في ضرمِ",25,"م",1,0],["والإذاعاتُ على كثْرتها","تصِفُ الأمة َوصْفَ العَجَبِ !",26,"ب",1,0],["وألأذن لا تصغي لغير حديثكم","فكأنّ بيني والحديث حجابُ",27,"ب",1,0],["26- والإذِّكَارُ يُقَلِّبُ الأمسَ الذِي","طُوِيَتْ مَلامِحُهُ بِيَوْمٍ فَانِ",28,"ن",1,0]]}