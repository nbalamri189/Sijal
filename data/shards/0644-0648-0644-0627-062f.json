{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[88,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[73,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[53,"ضرطة إبراهيم في البربخ","https://www.aldiwan.net/poem9990.html","السريع"],[87,"قم ناج جلق وانشد رسم من بانوا","https://www.aldiwan.net/poem63693.html","البسيط"],[47,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[30,"لولا دفاعُك يوم العقر ضاحيةً","https://www.aldiwan.net/poem1299.html",""],[107,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[107,"أعد البناء وجدد الميثاقا","https://www.aldiwan.net/poem43050.html","الكامل"],[50,"وعاشقين التف خداهما","https://www.aldiwan.net/poem62566.html","السريع"],[52,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[214,"عدمت صبري غداة البين أو جلدي","https://www.aldiwan.net/poem13368.html","البسيط"],[234,"حدا الفراق فمهلا أيها الحادي","https://www.aldiwan.net/poem51127.html","البسيط"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[291,"من كان يملك درهمين تعلمت","https://www.aldiwan.net/poem34067.html","الكامل"],[310,"سيان أن لبس التجمل أو عري","https://www.aldiwan.net/poem56550.html","الكامل"],[470,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[482,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[556,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[556,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[556,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[558,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[580,"يا منية النفس يا مسكية النفس","https://www.aldiwan.net/poem2925.html","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128710","البسيط"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123778","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101014","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101038","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89538","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102573","السريع"],[2841,"","https://poetry.dctabudhabi.ae/diwan/poem/133895","السريع"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134205","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101640","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67996","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82844","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117898","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85259","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131259",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66543","السريع"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99237","الكامل"],[3856,"","https://poetry.dctabudhabi.ae/diwan/poem/124139","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114304","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35423","البسيط"],[4984,"لَوْلَا ..","https://www.poetsgate.com/ViewPoem.aspx?id=201164",""],[5274,"أشواق دمشقية","https://www.poetsgate.com/ViewPoem.aspx?id=203450",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=203436",""],[5956,"بَشَرٌ حقير","https://www.poetsgate.com/ViewPoem.aspx?id=183753",""],[5956,"الذكرى تنفعُ المؤمنين","https://www.poetsgate.com/ViewPoem.aspx?id=184490",""],[6093,"اكتظاظ","https://www.poetsgate.com/ViewPoem.aspx?id=205280",""],[6093,"ولادة معنى","https://www.poetsgate.com/ViewPoem.aspx?id=206567",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""]],"verses":[["لَوْلاَ دِفَاعُ اللهِ عَنْكَ وَعِصْمَةٌ","أَصْبَحْتَ فِي أَبْرَادِهَا تَتَسَرْبَلُ",0,"ل",1,0],["لَولا دِفاعُ اللَهِ لَاِنطَوَتِ المُنى","عِندَ اِنطِوائِكَ وَاِنقَضى التَأميلُ",1,"ل",1,0],["لَولا دِفاعُكَ بِالصَوارِمِ وَالقَنا","عَن حَوزَةِ الإِسلامِ عادَ كَما بَدا",2,"د",2,0],["لولا دجى طرته لم أبتْ","سهرانَ لا أجرٌ ولا أجرَه",3,"ر",2,0],["لولا دفاعُ اللَّه قد زُلزلت","بالأرض في أجبالها الشمَّخِ",4,"خ",1,0],["لَولا دِمَشقُ لَما كانَت طُلَيطِلَةٌ","وَلا زَهَت بِبَني العَبّاسِ بَغدانُ",5,"ن",1,0],["لَولا دِفاعُكَ كانَ المُلكُ مُهتَضِماً","وَالشَعبُ مُنفَرِجاً وَالأَمرُ مُختَلِفا",6,"ف",2,0],["لَولا دِفاعُكَ يَومَ العَقرِ ضاحِيَةً","عَنِ العِراقِ وَنارُ الحَربِ تَلتَهِبُ",7,"ب",1,1],["لَولا دِفاعُكَ عَنهُم عارِضاً لِجِباً","لَأَصبَحوا عَن جَديدِ الأَرضِ قَد ذَهَبوا",7,"ب",3,0],["لولا دِفاعُكَ طارتْ نارُها شُعَلاً","واسْترسلَ الدَّمُ في أرجائها دُفَعا",8,"ع",2,0],["لولا دفاعُ أوليِ الحميَّةِ أعولت","جَزَعاً وضَجَّ حُماتُها إشفاقا",9,"ق",2,0],["لَولا دِفاعُ الناسِ إِيّاهُما","لَما استَفاقا آخَرَ المُسنَدِ",10,"د",1,0],["لَولا دَلَفتَ لِمَن دَهاكَ بِأَيرِهِ","فَحَسَرتَ عَنكَ حَزازَةً لا تَبرُدُ",11,"د",1,0],["لَولا دَليل الجذب ما","ملكت بهذا السعي رشدا",12,"د",2,0],["لولا دُخانُ التَّبغ خلتَهمو","أنصافَ آلهةٍ وأربابِ",13,"ب",1,0],["لولا دجى شعرها طالت مسافته","ما بت اشكو لها سهدي ولا كمدي",14,"د",2,0],["لولا دموعيَ في يوم الوَداع إذاً","لأَحرقَتْ زَفَراتي ثَمَّ عُوّادي",15,"د",2,0],["لَولا دُعاء سابِق أَضحى لَفي","وَسَطِ المَدينَةِ لُعبَةَ الصِّبيانِ",16,"ن",1,0],["لولا دَراهِمُهُ الَّتي فِي كِيسِهِ","لَرَأَيْتَهُ شَرَّ البَرِيَّةِ حالا",17,"ل",2,0],["لَولا دفاع اللّه ناساً بَعضَهم","بِالبعضِ كانت أرضهم لم تعمرِ",18,"ر",1,0],["لولا دِماءُ بَنيكَ تَسقي تُربَه ُ","لحَسِبتَ أنَّ الأرضَ قاعٌ بَلْقَعُ",19,"ع",1,0],["لولا دموعي يومَ توديعكمْ","لم تكُ أسرارُ الهوى تُعلَمُ",20,"م",1,0],["لولا دموعي يوم قامتْ ودّعتْ","ما كان روضُ الحَزْنِ بالمطلولِ",21,"ل",1,0],["لَولا دِفاعُك ما اِستَقَرّ بمَفْرَقي","ذاك المتوَّجِ تاجُهُ المعقودُ",22,"د",1,0],["لَولا دفاعِيَ عَنكمْ يومَ أمْطَرَكمْ","نَوء السماكينَ أَشفيتمْ على العَطَبِ",23,"ب",1,0],["لَولا دِفاعُكَ بَأسَ الرومِ إِذ بَكَرَت","عَن عِترَةِ الدينِ لَم تَأمَن مِنَ الثَكَلِ",24,"ل",1,0],["لولا دمُوعِيَ لَمْ يدْرِ العَذُولُ بنا","فالله يرْمي لسانَ الدَّمْعِ بالخرَسِ",25,"س",1,0],["لولا دعاؤك بالإِمساك ما انقطعت","من بعد سبعٍ ولا طابوا بأرضهم",26,"م",1,0],["لولا دموعٌ كصوب العارض الغدقِ","ما رُحت أروي حديث الوجد من طرقِ",27,"ق",1,1],["لولا دُخانُ تَأوُّهٍ من نار أش","واقٍ به لم تُلفهِ عُوادّهُ",28,"د",2,0],["لولا دواعي العلا تعلو بهمته","حتى يبين من العلياء موضعه",29,"ع",2,0],["لولا دفاع اللَه عن أنصاره","راحت بها في الذهبات سبيل",30,"ل",1,0],["لَولا دِفاعُ إلهِ العالَمينَ إِذاً","ماجَت بِنا الأَرضُ أَو ضاقَت بِنا الدارُ",31,"ر",1,0],["لولا دموعي والضنا لم أبح","قد ينطق المرء بغير اللسان",32,"ن",1,0],["لولا دفاعي كنتم أعبداً","مسكنُها الحيرة فالسيلمون",33,"ن",1,0],["لولا دموع من الأجفان هاطلة","لأحرقت ما على الدنيا التهابات",34,"ت",1,0],["لولا دمٌ عربيٌّ في العروق جرى","هجرتُ من أَجلكِ الدنيا وأوطاني",35,"ن",2,0],["لولا دليلُ المكرماتِ يقودُها","لَمْ تستطع تقبيلَ تُربِ ثرائه",36,"ا",3,0],["لَولا دُروسٌ عَلَينا كنتَ تَقرَأُها","في الصَبرِ ما كان يُلقى عِندَنا صَبرُ",37,"ر",1,0],["لولا دواع في الطبا","ع لهم بها ولنا ارتياح",38,"ح",1,0],["لولا دفاع إله العالمين بهم","لأصبح الدين بين الناس كالهدف",39,"ف",1,0],["لولا دسائسها لما اقترف امرؤ","إثماً ولا أشقى البلاد تعصب",40,"ب",1,0],["لَولا دُموعِي وَالضَّنى لَمْ أَبُحْ","قَد يَنْطِقُ المَرْءُ بِغَيْرِ اللَّسان",41,"ن",1,0],["لولا دماءُ العاشقين شَفَحْنَها","ما احمرَّ في وَجَناتها التَّوْريد",42,"د",1,0],["لولا ديارك يا سلمى لما سفحت","عيني الدموع لبرق في الدجى ساري",43,"ر",2,1],["لَوْلاَ دِيَارُ المُصْطَفَى وَرُبُوعُهُ","مَا شَاقَنِي فَاسٌ وَلاَ أطْلاَلُهَا",44,"ل",3,1],["لَولا دُموعي لَكانَ القَلبُ مُحتَرِقاً","وَلَو خَبا الحُرُّ كانَ الطرفُ في لَججِ",45,"ج",1,0],["لولا دفاع الناس عن بعضهم","لبعثرت أعْظَم تلك الصفوف",46,"ف",1,0],["لولا دمشقُ لمَا لاحَتْ مرفرفة","راياتنا واحتَفَتْ بالنّوْرِ بلدانُ",47,"ن",1,0],["لولا دعائي ممزوجاً به وجعي","لما عثرت على أيقونة لأبي!",48,"ب",2,0],["لولا درَى الباري بما هم لم يُصِبْ","أحداً بضُرٍّ ، إنه الله الفطينْ",49,"ن",1,0],["لولا درى اللهُ الحكيمُ بحالِنا","لم يَدْعُ للصلواتِ خَمْسَ حُروفِ",50,"ف",1,0],["لَولا دُخَانٌ لمَا نامتْ عواذِلُهم","فقد أشاعوا بأنَّ الشمعَ قد فسَقُوا",51,"ق",3,0],["لولادة المعنى بخاطر شاعر","طقس يشاكل ما نراه من البشر",52,"ر",1,1],["لولا دماء الموتِ في مُهَجِ الحيا","ما أَخْصَبَ الماءُ المواتُ المقفرُ!\"",53,"ر",1,0],["لولا دُموعُكَ ما بَكيتُ، تَصرُّماً،","لكن بَكيتَ فأسبَلت أهدابي",54,"ب",2,0],["لولا دمشق لتاهت الدنيا بنا","فبدونها وجه اليقين يشيحُ",55,"ح",1,0]]}