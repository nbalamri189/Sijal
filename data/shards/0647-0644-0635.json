{"poems":[[51,"دابر أوطاره إلى الذكر","https://www.aldiwan.net/poem62983.html","الطويل"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[105,"من كان يؤثر أن يجيب فقد دعا","https://www.aldiwan.net/poem43048.html","الكامل"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[46,"سم الهلال إذا عاينته قمرا","https://www.aldiwan.net/poem22544.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[393,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[422,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[551,"ومن عجائب أمري أنني أبدا","https://www.aldiwan.net/poem47272.html","البسيط"]],"verses":[["هل صِبغة الله فيك عائدةٌ","يوماً ولو بعد طول منتظر",0,"ر",1,0],["هل صادق قول من يقول","إن الدجى فيه مكفهر",1,"ر",1,0],["هل صِينَ حقُّ القومِ أو مُنِعَ الحِمى","بمُساوِمينَ على الذِّمارِ تِجارِ",2,"ر",1,0],["هَل صينَ عِرضٌ بِالعَفافِ مُطَهَّرٌ","صَوني لَهُ أَيّامَ لَم نَتَبَدَّدِ",3,"د",1,0],["هَل صَحَّ قَولٌ مِنَ الحاكي فَنَقبَلَهُ","أَم كُلُّ ذاكَ أَباطيلٌ وَأَسمارُ",4,"ر",1,0],["هل صح أنك راقدٌ في حفرةٍ","فيها عليك من الثرى أطباق",5,"ق",1,0],["هَل صَيَّرَ اللَهُ النِساءَ أَئمةً","يا أُمَّةً مِثلَ النَعامِ المُهمَلِ",6,"ل",1,0],["هل صحبة تقوم بين سيدٍ عظيم","وخادمٍ محتال؟",7,"ل",1,0],["هل صحّةٌ من سقامٍ لا دواءَ له","وكيف أبقى ولمّا يبقَ أمثالي",8,"ل",2,0]]}