{"poems":[[53,"دابر أوطاره إلى الذكر","https://www.aldiwan.net/poem62983.html","الطويل"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[107,"من كان يؤثر أن يجيب فقد دعا","https://www.aldiwan.net/poem43048.html","الكامل"],[107,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[48,"سم الهلال إذا عاينته قمرا","https://www.aldiwan.net/poem22544.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[556,"ومن عجائب أمري أنني أبدا","https://www.aldiwan.net/poem47272.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37750","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77629","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202076","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111838","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108485","الكامل"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48099","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199933","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131986","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128945","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125860","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45040","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89601","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104903","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4755,"كُله جشائب","https://www.poetsgate.com/ViewPoem.aspx?id=191418",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[4980,"مَا لِلفَتَى","https://www.poetsgate.com/ViewPoem.aspx?id=191451",""],[4981,"حُظُوظٌ سَيّئة","https://www.poetsgate.com/ViewPoem.aspx?id=190704",""],[5030,"يا عيدُ عُذرًا!","https://www.poetsgate.com/ViewPoem.aspx?id=215724",""],[5232,"قامة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=213786",""],[5273,"زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=28760",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[5320,"إلى الرغيف","https://www.poetsgate.com/ViewPoem.aspx?id=43255",""],[5431,"موت الضمير...","https://www.poetsgate.com/ViewPoem.aspx?id=201304",""],[5431,"عنه الظلامُ بحول الله منكفئُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201569",""],[5638,"حُلم العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=198256",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5939,"سارقة الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=131444",""],[6068,"طمع الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177484",""],[6124,"فرشاة الأسنان","https://www.poetsgate.com/ViewPoem.aspx?id=159888",""],[6143,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=176851",""],[6167,"الربان الجسور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85570&r=&rc=53",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""]],"verses":[["هل صِبغة الله فيك عائدةٌ","يوماً ولو بعد طول منتظر",0,"ر",1,0],["هل صادق قول من يقول","إن الدجى فيه مكفهر",1,"ر",1,0],["هل صِينَ حقُّ القومِ أو مُنِعَ الحِمى","بمُساوِمينَ على الذِّمارِ تِجارِ",2,"ر",1,0],["هَل صينَ عِرضٌ بِالعَفافِ مُطَهَّرٌ","صَوني لَهُ أَيّامَ لَم نَتَبَدَّدِ",3,"د",1,0],["هَل صَحَّ قَولٌ مِنَ الحاكي فَنَقبَلَهُ","أَم كُلُّ ذاكَ أَباطيلٌ وَأَسمارُ",4,"ر",1,0],["هل صح أنك راقدٌ في حفرةٍ","فيها عليك من الثرى أطباق",5,"ق",1,0],["هَل صَيَّرَ اللَهُ النِساءَ أَئمةً","يا أُمَّةً مِثلَ النَعامِ المُهمَلِ",6,"ل",1,0],["هل صحبة تقوم بين سيدٍ عظيم","وخادمٍ محتال؟",7,"ل",1,0],["هل صحّةٌ من سقامٍ لا دواءَ له","وكيف أبقى ولمّا يبقَ أمثالي",8,"ل",2,0],["هل صادقُ الودِّ مثلُ خَارصِهِ","حتى تُساوي بالأصدقِ الأخْرَص",9,"ص",1,0],["هَل صَدَّكم عَن مَنزِلي عَزولُنا","يا مَن بِهِم أَضاءَتِ الأكوانُ",10,"ن",1,1],["هَل صَحَّ أَنك اِبتَغيتَ تَركي","وَقَد صَحبتَ عُصبَةً مِن تُرك",11,"ك",1,0],["هل صادِقٌ في الُحبِّ يُشْبِه مَاذقاً","هَلْ تستوي الأمواتُ والأحْياء",12,"ا",2,0],["هل صادَ هم شرك الردى فأبادَهم","صرفٌ اناخَ عَلَى ثمود وعادِ",13,"د",1,0],["هل صنعةٌ أحكمُ في صنعها","عندَ أولي الألباب من شعري",14,"ر",2,0],["هل صار سلب حقوقها سهلاً وما","لا بنيك فضل كي تنيلهما الوطر",15,"ر",1,0],["هل صَمَّ سمعٌ عن جَلِيَّةِ عُذْرِهِ","أَوْ ضاقَ ذَرْعٌ عن تَغَمُّدِ جُرْمِهِ",16,"م",2,0],["هل صور اسرافيل في أبواقهم","فعلام ليس يقوم من في الأقبر",17,"ر",1,0],["هل صبا نجد تداوي من صبا","بشذى فيه شفاء الدنف",18,"ف",1,0],["هل صغت شعرك من رضا","ب الغيد أم بنت العنب",19,"ب",1,0],["هل صرت في حجمك يا رفيقتي","قالت لها في لهجة التحقير",20,"ر",1,0],["هل صانعوا اليوم اليهود","لما رووه عن زهير",21,"ر",1,0],["هَل صاحِ تُبصِرُ غَيرَ ثَغرٍ باسِمٍ","لَولا المَهابَةُ قالَ يا ساقِ اِسقِنا",22,"ن",2,0],["هَل صورُ إِسرافيلَ نا","يُ القَينَةِ بِنتِ العَرَب",23,"ب",1,0],["هل صيغ من قلبي الخفوق","لك الرعاث فما استقرا",24,"ر",2,0],["هل صفا العيش لامرئٍ والليالي","تارةً راحة وطوراً عناء",25,"ا",2,0],["هَل صَارَ جُودًا أنْ تُكْرِمُوهُ","فِي عَرْضِ دَفنٍ أو نِصْفِ رَاتِبْ؟",26,"ب",1,0],["هل صح بحرٌ بلا ثغر يكون بهِ","دوماً مفاصلة يا من يجافينا",27,"ن",2,0],["هَل صَحَّ سُلطَانٌ عَلَى قَلبٍ وَهَلْ","يُدرَى لِتَوقٍ أينَ يَأتِي أو مَتَى",28,"ت",2,0],["هل صارَ مرجانُكَ المدفونُ مُفتَقَداً","وَ لَحمُ حُوتِكَ لَمّا جِئتُهُ حَسَكَا؟!",29,"ك",2,0],["هل صارَ شيءٌ حادثٌ في دينكم","أم أنّ هذا كلّهُ كابوسُ؟!",30,"س",1,0],["7 –هلْ صاغها شاعرٌ فذّ ٌ ونابغة ٌ","لو لمْ تكنْ جوهرَ الحسِّ الذي صدقا",31,"ق",2,0],["هَلْ صِرْتَ كالحَجَرِ الأصَمِّ ألا تَرى","ماذا دَهاكَ ألا تَحسُ وتَسمَعُ",32,"ع",1,0],["هَلْ صِرتَ تَعرِفُ مَن هَذا الذي عَبَقَتْ","أَبيَاتُ شِعري لَهُ حُبًّا وإِنصَافا؟",33,"ف",2,0],["هل صار قوت الكا دحين مهانة","وإلى متى سيظل صوت الحق حائر",34,"ر",1,0],["هل صخرة قد بات عالمنا؟","اخيرَ لاإحساس جوّاه؟!!",35,"ا",2,0],["هل صدقَ العجزُ أن ضلّت محافلنا","هل آنسَ الصحْبُ ليلَ الذُل فانطفأوا",36,"ا",1,0],["هل صدقَ الناس أنّ الليل منسدلٌ ؟؟","حتى القيامة في أوكاره اختبأوا !!",36,"ا",1,0],["هَلْ صِرْتُ حَقًّا فِي الصَّبَابَةِ شَاعِرًا","مُتَقَلِّبًا فِي رَوْضَةٍ وَضِرَامِ",37,"م",1,0],["هَلْ صَارَ بُعْدُكِ فَوْقَ قَدْرِ عَزِيمَتِي","وَأَنَا الْجَسُورُ الْقَاهِرُ الآلامِ",37,"م",1,0],["هل صلاح الدين إلاناركم","كيف أسكتم لظاها في البطون",38,"ن",1,0],["هل صادَكِ سَهمي، أم أنّي","أحتاجُ إلى حظٍّ أوفَرْ؟",39,"ر",1,0],["هل صار تعبدها لحسن جمالها","ولقد جننت بحبها وبهائها",40,"ا",3,0],["هل صدقُ الكلماتِ عبيرٌ","أم سوسٌ في أزمنةِ الغربان؟.",41,"ن",1,0],["هل صاحَ صوتٌ في الذراري, أُصلحتْ؟","أو باتَ ينزعُ أجمل الأكداس",42,"س",1,0],["هل صَفَّقَتْ في الجوِّ أَجنحةٌ ضحىً","إلا لكى نرثَ السعادةَ والحبورْ؟",43,"ر",1,0],["هل صام صائمهم لكسب فضيلة","أم صام صائمهم لزوم مظاهر",44,"ر",1,0]]}