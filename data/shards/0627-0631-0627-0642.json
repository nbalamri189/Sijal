327,"","https://poetry.dctabudhabi.ae/diwan/poem/73265","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73258","البسيط"],[4733,"النظرة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=210308",""],[4927,"غَرِيْقُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29845",""],[4927,"مي","https://www.poetsgate.com/ViewPoem.aspx?id=29958",""],[4927,"ذِكْرَيَاْت","https://www.poetsgate.com/ViewPoem.aspx?id=30173",""],[460,"سرى همّي وهمُّ المرءِ يسري","https://www.poetsgate.com/ViewPoem.aspx?id=22190",""],[5065,"سبحة الإنطواء","https://www.poetsgate.com/ViewPoem.aspx?id=205183",""],[5102,"بنت السجان","https://www.poetsgate.com/ViewPoem.aspx?id=12893",""],[5121,"نُورَ الطَّيْفِ","https://www.poetsgate.com/ViewPoem.aspx?id=215931",""],[5186,"إاذا كانت الآمال بالوصل أوهاما","https://www.poetsgate.com/ViewPoem.aspx?id=156475",""],[5273,"فضول","https://www.poetsgate.com/ViewPoem.aspx?id=178288",""],[5277,"أطلالُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=185555",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5358,"ساعات تحت النار","https://www.poetsgate.com/ViewPoem.aspx?id=21892",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[243,"شهداء الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=50492",""],[5725,"عراق شعلان وضاري","https://www.poetsgate.com/ViewPoem.aspx?id=177471",""],[5784,"حكاية عشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190105",""],[5881,"وحيداً في الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=183756",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[6052,"بستان جهدي","https://www.poetsgate.com/ViewPoem.aspx?id=50109",""],[6124,"سواد الهدب","https://www.poetsgate.com/ViewPoem.aspx?id=109744",""],[6152,"أراقب جوها","https://www.poetsgate.com/ViewPoem.aspx?id=213145",""],[6185,"أحلى مهاة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86942&r=&rc=2",""],[6242,"دمشق يا وردة تاهَ النّسيم بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87573&r=&rc=20",""]],"verses":[["أُراقِبُ الضَيفَ أَن يَرعى مَطيَّتَهُ","وَبَينَنا مَنكِبٌ عالٍ مِنَ الظُلَمِ",0,"م",1,0],["أُراقِبُ مِن طَيفِ الحَبيبِ وِصالا","وَيَأبى خَيالٌ أَن يَزورَ خَيالا",1,"ل",2,1],["أَراقِمٌ تَحمِلُها","عَقارِبٌ شَوائِلُ",2,"ل",1,0],["أُراقِبُ ليلَةً فيهمْ عَماساً","تمَخّضُ لي بيَوْمٍ أرْوَنانِ",3,"ن",1,0],["أُراقِبُ طولَ اللَيلِ حَتّى إِذا اِنقَضى","رَقَبتُ طُلوعَ الشَمسِ حَتّى المَغارِبِ",4,"ب",1,0],["أُراقِبُها في اللَيلِ مِن كُلِّ مَطلَعٍ","كَأَنّي بِرَعيِ السائِراتِ كَفيلُ",5,"ل",1,0],["أراقب من همَّ التفرق فرجةً","وما الدَّهر إلاَّ غمَّةٌ وانفراجها",6,"ج",3,0],["أراق دمعي هوى ظبيٍ أراق دمي","يا للقَتيل بكى منْ حُبِّ قاتلِهِ",7,"ل",2,0],["أُراقِبُ وَقتَها مِن غَيرِ شَوقٍ","مُراقَبَةَ المَشوقِ المُستَهامِ",8,"م",1,0],["أُراقِبُ رَأيَكَ حَتّى يَصِحَّ","وَأَنظُرُ عَطفَكَ حَتّى يَثوبا",9,"ب",2,0],["أَراقَبتُمُ إِجلاءَ عُسري وَإِنَّما","ثَنى رَغبَتي تِلقاءَ يُسرِكُمُ عُسري",10,"ر",2,0],["أَراقَت دَمَ العُشّاقِ في مَعرَكِ الهَوى","فَصارَ اِحمِراراً في الجُفونِ اِحوِرارُها",11,"ه",2,0],["أَراقِمٌ لينُها عَن غَيرِ مَقدِرَةٍ","لِذاكَ إِن أَمكَنَتها فُرصَةٌ لَسَعَت",12,"ت",1,0],["أراقبُ دولةَ الخَلَفِ المُرجَّى","وأخشى ما أصابَ بني عتيبِ",13,"ب",1,0],["أَراقَ فيها المَزاجَ فَاِشتَعَلَت","كَمِثلِ نارٍ أَطعَمتَها سَعَفا",14,"ف",2,0],["أُراقِبُ الصُبحَ كَأَنّي اِمرُؤٌ","مِن راحَةٍ فيهِ عَلى مَوعِدِ",15,"د",1,0],["أُراقِبُ النَفسَ في الحَياةِ وَقَد","أَيقَنتُ أَنّي بِتَركِها عَطِبُ",16,"ب",1,0],["اراقب الجد في نصري فينشدني","لا ناقة لي في هذا ولا جمل",17,"ل",1,0],["أراقب والأصرار دأبيَ توبة","وهيهات لا يُجنَى من الصّاب ناطف",18,"ف",1,0],["أراقب الصّبح والأحشاءُ مظلمة","وهل ينير فؤاد كلُّه غسق",19,"ق",1,0],["أراق دمي بألحاظٍ مراضٍ","يفلّ بها شبا بيضِ النصول",20,"ل",1,0],["أَراقَ دَمي وَكانَ دَمي حَراماً","فَوا عَجَباهُ مِن حِلِّ الحَرامِ",21,"م",1,0],["أُراقِبُ مَنْ عَاشَرْتُ منهم كأنَّني","أُراقِبُ كلباً أَوْ أُراقِبُ عَقْرَبا",22,"ب",2,0],["أُراقِبُ في السَماءِ بَناتِ نَعشٍ","وَقَد دارَت كَما عُطِفَ الصِوارُ",23,"ر",1,0],["اراقب فيها الفرقدين بمقلة","مقرحة بالسيد ذات كلوم",24,"م",1,0],["اراقب اخراها عسي تنجلي","وليل من بلا آخر",25,"ر",1,0],["أَراقَتْ عَلَى الدأماءِ حُمْرَ دمائِهم","فَراقَت شَقيقا في البنَفسج مُحْمرّا",26,"ر",2,0],["أرَاقِمُ للبُستَانِ خَيْرُ رَواقِم","سَوالِبُ لِلأشْجان خَيْرُ سَوالِبِ",27,"ب",1,0],["أُراقِبُ النَجمَ كَأَنّي مولَعٌ","بِحَيثُ يَجري النَجمُ حَتّى يَقتَحِم",28,"م",1,0],["أراق دم العشاق سيف جفونه","ومن بعد ذا أضحى عليهم يخايل",29,"ل",1,0],["أراق دماء المشرق ظلما وغاله","ومزّقهُ بطشا وحطّمه جورا",30,"ر",2,0],["أراقت عليها معاني الفناء","ظلال السكون الحزين الرهيب",31,"ب",1,1],["أراقِبُهُ في حالَةِ الخَوفِ وَالرَجا","وَأَصبِحَ بَينَ الحالَتَينِ كَما أَمسي",32,"س",2,1],["أُراقِبُهُ خَوفاً وَأَرجو مَعَ الحَيا","وَأَشتاقُ أُنساً وَهوَ فيهِ يَقيني",33,"ي",1,1],["أُراقِبُهُ وَهوَ الرَقيبُ بِخاطِري","وَفِيَّ لَهُ مِنّي عُيونٌ وَأَعوانُ",34,"ن",1,1],["أراقوا دماء المسلمين خيانة","فَبِئس خيانات عواقبها غدرا",35,"ر",2,0],["أٌراقِبُ طَيفاً منَ الظّاعِنينَ","إذا هجَروا مُستهاماً وصَل",36,"ل",1,0],["أُراقِب من طَيْفِ البخيلةِ مَوعداً","وهان عليها أن أبيتَ مُسهَّدا",37,"د",2,1],["أُراقِبُ وَجهَ الأُفقِ حَتّى كَأَنَّما","أُحاوِلُكُم بَينَ النُجومِ الزَواهِرِ",38,"ر",1,0],["أُراقبُ منه مَوعِداً بلِقائه","إذا التَقَيا والعمرُ ليسَ بِمَضمُونِ",39,"ن",1,0],["أراقَ جِمامَ الدمعِ فيكُم فإن دعَا","بهِ الوجدُ لبّى وهو مُستكرهٌ نَزْرُ",40,"ر",1,0],["أَراقِمُ تَقْرِي ناقعَ السّمِّ مَا لَهَا","بما حَملت دون الغواة مقيلُ",41,"ل",1,0],["اراقب بعد النوم للفجر طلعة","تزحزح ستر الليل والليل مسود",42,"د",1,0],["أراق دمي الحرامَ فضولُ عيني","فثأري بين أجفاني وماقي",43,"ق",2,0],["أراقمُ لا ترجو الرقاةُ اختداعَها","ولا يبلغُ الدِّرياقُ موضِعَ تلسعُ",44,"ع",1,0],["أراقب منه العفو والذنبُ ذنبهُ","ويسأل عنّي قومهُ وهو عالم",45,"م",1,0],["أُراقِبُ النَجمَ كالحَيرانِ مُرتَقِباً","وَقَلَّصَ النَومُ عَن عَينيَّ فانشَمَرا",46,"ر",2,0],["أَراقَت دَمي ظُلماً مَحاسِنُ وَجهِهِ","فَأَضحى وَفي عَينَيهِ آثارُهُ تَبدو",47,"د",2,0],["أَراقوا مِن وجوهِهم حياءً","وَما أَخذوا بهِ إِلّا تُرابا",48,"ب",2,0],["أراقوا الدم الغالي وضحوا نفوسهم","معززة كي تستقل الأعارب",49,"ب",1,0],["اراقبها بدراً له الطرق هالة","ومنزله وسط الذراع الموسد",50,"د",1,0],["أَراق سِجالَهُ بالرَّقتين","جنوبيٌّ صَخوبُ الجانبينِ",51,"ن",1,1],["أُراقِبُ النّجمَ طولَ اللّيلِ مِن سَهَرٍ","وَالنّجمُ لي رَأفَةً فيّا يُساهِرُني",52,"ن",2,0],["أُراقِب النّجمَ طولَ اللَّيل مِن وَلَهي","حَتّى جَهِلتُ الكَرى في كلِّ أَوقاتي",53,"ي",1,1],["إراقة دمع الصب في الربع واجبُ","كذا حكمت في الحبِّ فينا المذاهبُ",54,"ب",1,1],["أراقَ دمعي لا بل أراق دمي","ظلما بظُلمٍ مِن رِيقهِ الشَبِمِ",55,"م",1,1],["أُراقب النجمَ في جنح الدُجى سهراً","كَأَنَّني راصدٌ للنجم أَوصابي",56,"ب",2,0],["أَراقَ لهُ كَأْسَ الفُكاهَةِ والكَرَى","وأَتْرَعَ أَحْواضَ النَّدَى والتَّورُّعِ",57,"ع",1,0],["أراقَ دمي بسيفِ اللحظِ ظلماً","وها أثرُ الدماءِ بوجنتيهِ",58,"ه",1,1],["أراق دمي عهداً بأسيافِ لحظه","وأرق أجفاني القريحة صده",59,"د",2,0],["أراقب الصبح وريح الصبا","والموتُ من دون الصبا والصباح",60,"ح",1,0],["أراقبُ قلبي مرَّةً بعد مرَّةٍ","فألفيه ذيّاك الذي أنا أعرفُ",61,"ف",1,0],["أراق دَماً قد كان قبلُ يَصُونُه","كدمعةِ مُضنَى القلب رَوَّعَهُ الجَفَا",62,"ف",2,0],["أراقت مقلتي طوفان نوح","وقد بلغ الزبى لما ألما",63,"م",2,1],["أُراقِبُ في المَجَرَّةِ كُلَّ نَجمٍ","تَعَرَّضَ لِلمَجَرَةِ كَيفَ يَجري",64,"ر",2,0],["أُراقِبُ الحيَّ حتّى إذ رأيتهُم","جدّوا سِراعاً وما عاجوا لتَوديعي",65,"ع",2,0],["أراق على عطفيه منه طلاوةً","مدى الدهرِ ملتاحُ الجبينِ مهيبُ",66,"ب",1,0],["أراق بالأرض ثجا صوب ريّقهِ","فحل بالروض نسجا رائق الحلَل",67,"ل",1,0],["أراق دماء المشركين بفيصل","أطال حنين الأمهات الفواقد",68,"د",1,0],["أراقب منه خلوة كل لحظة","فيبعد عنى غير مستظهر هجرة",69,"ر",2,0],["أراقب نجم الصج من حيث أنه","يشاكل قرطيها كأني منجم",70,"م",1,0],["أراقب منه طرةً فوق غرةٍ","فأعجبُ أني يستوي الليل والفجر",71,"ر",1,0],["أراقب نجماً في الدجى نابذ الكرى","ولو شئته ما كان للجفن ينعم",72,"م",1,0],["أراقماً أرسل منْ جعدهِ","تحمي من الجنّة والناس",73,"س",1,0],["أراقبُ الموجَ بعيداً إنني","لا أركبُ البحرَ فأَخشى الفرقا",74,"ق",2,0],["أراقب من ليل التمام نجومه","لدن غاب قرن الشمس حتى بدا الفجر",75,"ر",1,0],["اراقب نور الشمس من كوة الحما","طوال الليالي علني ان ارى الفجرا",76,"ر",2,0],["أُراقِبُهُ حَتّى إِذا قُلتُ قَد مَضى","تَثوبُ إِلَيهِ نَفسُهُ فَتَعودُ",77,"د",1,0],["أراقب اليوم الذي تبسم لي","وترى آي الرضا في مقلتى",78,"ا",1,0],["أراقب عذَّلاً لي فيك أبدت","ضمائرها على حنق حقودا",79,"د",2,0],["أراق دمي جراز جفون هند","كذاك السيف يقطع وهو هندي",80,"د",2,1],["أُراقبُ أشيَائِي التِي في حَقيبتِي","وَبيني وبَينَ الراحِلينَ.. جِهاتِي",81,"ت",2,0],["أُراقِبُ لَوحاً مِن سُهَيلٍ كَأَنَّهُ","إِذا ما بَدا مِن آخِرِ اللَيلِ يَطرِفُ",82,"ف",1,0],["اراق بعدي لهم عيش فبعدهم","اراق فيض دم من دمعي السجم",83,"م",1,0],["أراقب اسراب الكواكب في الدجى","وهن على نهر المجرة وقف",84,"ف",1,0],["أراق على يديه دماً بريئاً","فنال جزاءَ ما كسبت يداه",85,"ه",1,0],["أراقوا دماهم ظالمين وقد دروا","وما قتلوا غيرَ العلا والتكرم",86,"م",1,0],["أَراقِبُ مِرزَمَ الجَوزاءِ حَتّى","تَضَمَّنَهُ مِن الأُفقِ السُجودُ",87,"د",1,0],["أراقك حسن غيبه لك تأريق","وتبريد وصل سره فيك تحريق",88,"ق",1,1],["أراقت دم الهادين ظلماً وليتها","بسفك دمٍ منكم رضوا عوض السفك",89,"ك",1,0],["أراقب منهم لمحات طرفٍ","وأرضيهم ولو كانوا غضابا",90,"ب",2,0],["اراقمُ آثامٍ رَقَمنَ ليَ الرَدى","تجاوَزَتِ الأَعدادَ واللَهُ راقمُ",91,"م",1,0],["أراقَ البَحْدليُّ دماءَ قيْسٍ","وألصَقَ خَدَّ قيْسٍ بالتُّرابِ",92,"ب",1,0],["أَراقبُ بدراً بين هذي المطالعِ","وَيؤنسي تضلالُ تيك المطامعِ",93,"ع",1,1],["أَراقبُ سَيرَ النجم بَين الغَياهبِ","وَمن مثلها بين الحَشا وَالتَرائبِ",94,"ب",1,1],["أَراقَت دَمي غَيداءُ راقَت لِناظري","فَقامَت عَلى قَتلي بِقامة عسّالِ",95,"ل",1,1],["أُراقِبُ مِن آفاقِ جودِكَ نَفحَةً","تُثبِتُ ما يُلقي عَلى القَلبِ وَالسَمعِ",96,"ع",1,0],["أراق دمي من مأربي رشف ريقه","بإطراقه إذ مر بي في طريقه",97,"ق",2,1],["أراقته مني شيمة عربية","على صفحتيها يلمع الفضل والرشد",98,"د",1,0],["أَراقَ دَم