html","المتقارب"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[459,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[462,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[462,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[465,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[515,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[530,"سددت الأذن عن داعي التصابي","https://www.aldiwan.net/poem37528.html","الوافر"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[552,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[552,"سلام وهل يغني السلام على الذي","https://www.aldiwan.net/poem48118.html","الطويل"],[554,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[554,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[568,"سارية بين الدياجي السود","https://www.aldiwan.net/poem69731.html","الرجز"],[576,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["سَدَدتَ فُروجَهُ بِالقَولِ حَتّى","مَدَدتَ مُشَيِّعاً باعَ البَنانِ",0,"ن",1,0],["سَدَّ العُلى وَأَنارَ لا","فَظَّ القَضاءِ وَلا ظَلوما",1,"م",2,0],["سُدَّت فَواغِرُ أَفواهِ القُبورِ بِهِم","وَلَيسَ لِلأَرضِ لا رَيٌّ وَلا شَبَعُ",2,"ع",1,0],["سَدّوا النَجاءَ عَلَيهِ دونَ جُمامِهِ","بِقِراعِ لا عُزلٍ وَلا نُكّاسِ",3,"س",1,0],["سَدَّ البِلى وَأَنارَ فَوقَ جُسومِهِم","مِن كُلِّ مُنهالِ النَقا مَوّارِ",4,"ر",1,0],["سُدَّتْ على عُونِ الرّزايا طُرْقُها","فسَمَتْ لنا بخُطوبِها الأبْكارِ",5,"ر",1,0],["سَدَّدَ الله ابنَ مَرْزُو","قٍ إِلى تِلْكَ المَرَاضِي",6,"ض",2,0],["سُدَّ بابُ القَبولِ دوني وما لي","يا غِياثي سِواكَ منْ مِفْتاحِ",7,"ح",1,0],["سَديسٍ مُقَذَّفَةٍ بِاللَكي","كِ ذاتِ نَماءٍ بِأَجلادِها",8,"د",3,0],["سُدتَ بَني الأَحوَصِ لَم تَعدُهُم","وَعامِرٌ سادَ بَني عامِرِ",9,"ر",1,0],["سَدَّ بابَ الحَياءِ مِنهُ فَلا يَل","قى صَديقاً إِلّا بِقبحِ اِجتِرامِه",10,"م",2,0],["سَدَنتَ بِبَيتِ اللَهِ حُبَّ جِوارِهِ","لَكَ اللَهُ بِالأَجرِ المُضاعَفِ كافِلُ",11,"ل",1,0],["سُدتَ الجَميعَ فَلَيسَ مِنهُم مُنكِرٌ","أَن صِرتَ فَذَّهُمُ الَّذي لا يُتأَمُ",12,"م",1,0],["سَديسٍ تُطاوي البُعدَ أَو حَدَُ نابِها","صَبيٌَ كخُرطومِ الشَّعيرَةِ فاطِرُ",13,"ر",1,0],["سُدُماً قَديماً عَهدُهُ بِأَنيسِهِ","مِن بَينِ أَصفَرَ ناصِعٍ وَدِفانِ",14,"ن",1,0],["سدْ يا عليُّ فلا نكراً ولا عجبا","واعقدْ لبيتكَ في نجمِ السما طنبا",15,"ب",2,1],["سددت رأياً حباك العزّ متضحاً","فزادك الله من عزٍّ ومن سدد",16,"د",1,0],["سد من حضر","ومن غبر",17,"ر",1,0],["سدْ يا ابن فضل الإله كيف تشا","سيادةً ما لذكرها ناس",18,"س",1,0],["سد يا عليّ فما أبقيت منقبة","يمتاز عنك بها في الأعصر الأول",19,"ل",1,0],["سدْ يا عليّ بن يحيى كيف شئت فما","في فرعك المجتنى والأصل من ذام",20,"م",1,0],["سدْ يا عليّ على ذوي قلمٍ وقلْ","ليراعك اضْحك بالصريرِ وقهقهِ",21,"ه",1,0],["سَدَّ السَّدَادُ فَمي عَمَّا يُرِيبُكُمُ","لكنْ فَمُ الحالِ مني غيرُ مسدودِ",22,"د",1,0],["سدَّ شيطانُ حُبِّها كلَّ فَجٍّ","إنَّ شيطان حبِّها لَمَرِيدُ",23,"د",1,0],["سُدْتَ أنتَ الملوكَ حزْماً وعزْماً","ومُلوكيَّةً وساد عبيدَكْ",24,"ك",1,0],["سداها مخازيك التي قد علمتَها","ولحمتها منّي الكلام المحبر",25,"ر",1,0],["سدى غِرَّةٍ لا أعرف اليوم باسمه","وأعمل فيه اللهو مرأىً ومسمعا",26,"ع",2,0],["سدت أوائله سبيل أواخر","لم يدر سائقهن كيف يسوق",27,"ق",1,0],["سُدَّتْ على الخَلَلِ المداخلُ كُلُّها","ولقد يُرى في كل بابٍ يدخُلُ",28,"ل",1,0],["سُدتم فكنتم للوجوه معاطساً","شُمّاً وكنتم للرؤوس جماجما",29,"م",2,0],["سُدتم بخفَّةِ أقدامٍ مُسارعة","إلى الكرائه في رُجحان أحلامِ",30,"م",1,0],["سَدَّدَ الدَهرُ قَوسَه وَرَماني","لَم تَحُد مُهجَتي وَلا السَهمُ حادا",31,"ا",1,0],["سُدتَ أَو لَم رَسُد فَما أَنتَ إِلّا","حَيَوانٌ مُسَيَّرٌ مُستَعبَد",32,"د",1,0],["سَدّوا عَلى الباغي المَسالِكَ كُلَّها","فَالمَوتُ إِن وَلّى وَإِن هُوَ أَقبَلا",33,"ل",2,0],["سَدَدتَ سَبيلَ البَرِّ وَالبَحرِ عَنهُمُ","بِسابِحَةٍ دُهمٍ وَسابِحَةٍ غُرِّ",34,"ر",1,0],["سُدُماً إِذا اِلتَمَسَ الدِلاءُ نِطافَهُ","صادَفنَ مَشرِفَةَ المَثابِ دَحولا",35,"ل",2,0],["سدت مصرا بصدق حبك فيها","وفشا في ربوعها سلطانك",36,"ك",1,0],["سدم ما تراه ابيض في اعماقه","قد ذهبن مبتعدات",37,"ت",1,0],["سدلت حسناء الطبيعة عن","بخل علي وجهها الجميل قناعا",38,"ع",2,0],["سُدّت مسامعها لأول وهلة","دون الرزية تتقى أنباءها",39,"ا",3,0],["سَديدُ المَرامي قَد رَماهُ مُسَدِّدٌ","وَداهِيَةُ السُوّاسِ لاقى الدَواهِيا",40,"ي",2,0],["سُدِلَ السِتارُ وَهَل شَهِدتَ رِوايَةً","لَم يَعتَرِضها في الفُصولِ سِتارُ",41,"ر",1,0],["سَدَّدَت بِالهِلالِ قَوساً وَسَلَّت","خِنجَراً يَنفُذانِ مِن كُلِّ تُرسِ",42,"س",1,0],["سَدَّدَ السَهمَ إِلى صَدرِ الصِبا","وَرَماهُ في حَواشيهِ الغُرَر",43,"ر",1,0],["سُدتَ الثَلاثينَ الطِوا","لَ وَلَسنَ بِالحُكمِ القَصير",44,"ر",1,0],["سَدَّت عَلَيهِ المَشرَفِيَّةُ طُرقَهُ","فَاِنصاعَ لا حَلَباً وَلا بَغداذا",45,"ذ",2,0],["سدِكتُ بصَرفِ الدهرِ طفلاً ويافِعاً","فأفنَيتُهُ عزماً ولم يُفنني صبرا",46,"ر",2,0],["سَدَّت مُجانِبَةً وَخَلَّفَني الهَوى","عَن هَجرِها فَوَصَلتُ غَيرَ مُجانِبِ",47,"ب",1,0],["سَدِكَ النِساءُ بِنا مَلامَةَ عانِسٍ","نُلحى عَلى غَزَلٍ وَصَدِّ كَعابِ",48,"ب",1,0],["سَدادٌ فَتَلتَ بِهِ يَومَ ذا","كَ حَبلَ الخِلافَةِ حَتّى اِستَمَر",49,"ر",1,0],["سَدِكَت بِدِجلَةَ سارِياتُ رِكابِنا","يَرصُدنَها لِلوِردِ إِغيابَ السُرى",50,"ر",2,0],["سَدَّ تَدبيرُهُ الفَضاءَ عَلَيهِم","بَعدَ شَغبٍ مِن دَرئِهِم وَاِعتِراضِ",51,"ض",1,0],["سُدتَ في سِنِّكَ الحديثِ وَما النَج","دَةُ إِلّا لِلأَجدَلِ الغِطريفِ",52,"ف",1,0],["سُدَّت وُجوهُ فِجاجِ الأَرضِ دونَهُمُ","حَتّى كَأَنَّهُمُ في حَيرَةِ الرَدمِ",53,"م",1,0],["سَدَّتْ سيوفُكَ خَلَّةَ الثَّغْرَيْنِ","وَفَتَحْتَ من آرائِكَ السُّدَّيْنِ",54,"ن",1,1],["سَدَّتْ عَزائِمهُ الثُّغورَ وحالفَتْ","آراؤُه التَّسديدَ والتَّوفي