],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54306","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[100,"خدعة","https://www.poetsgate.com/ViewPoem.aspx?id=50386",""],[13,"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","https://www.poetsgate.com/ViewPoem.aspx?id=180808",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[100,"لا اكتراث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67636&r=&rc=124",""]],"verses":[["سَدَدتَ فُروجَهُ بِالقَولِ حَتّى","مَدَدتَ مُشَيِّعاً باعَ البَنانِ",0,"ن",1,0],["سَدَّ العُلى وَأَنارَ لا","فَظَّ القَضاءِ وَلا ظَلوما",1,"م",2,0],["سُدَّت فَواغِرُ أَفواهِ القُبورِ بِهِم","وَلَيسَ لِلأَرضِ لا رَيٌّ وَلا شَبَعُ",2,"ع",1,0],["سَدّوا النَجاءَ عَلَيهِ دونَ جُمامِهِ","بِقِراعِ لا عُزلٍ وَلا نُكّاسِ",3,"س",1,0],["سَدَّ البِلى وَأَنارَ فَوقَ جُسومِهِم","مِن كُلِّ مُنهالِ النَقا مَوّارِ",4,"ر",1,0],["سُدَّتْ على عُونِ الرّزايا طُرْقُها","فسَمَتْ لنا بخُطوبِها الأبْكارِ",5,"ر",1,0],["سَدَّدَ الله ابنَ مَرْزُو","قٍ إِلى تِلْكَ المَرَاضِي",6,"ي",1,0],["سُدَّ بابُ القَبولِ دوني وما لي","يا غِياثي سِواكَ منْ مِفْتاحِ",7,"ح",1,0],["سَديسٍ مُقَذَّفَةٍ بِاللَكي","كِ ذاتِ نَماءٍ بِأَجلادِها",8,"د",3,0],["سُدتَ بَني الأَحوَصِ لَم تَعدُهُم","وَعامِرٌ سادَ بَني عامِرِ",9,"ر",1,0],["سَدَّ بابَ الحَياءِ مِنهُ فَلا يَل","قى صَديقاً إِلّا بِقبحِ اِجتِرامِه",10,"م",2,0],["سَدَنتَ بِبَيتِ اللَهِ حُبَّ جِوارِهِ","لَكَ اللَهُ بِالأَجرِ المُضاعَفِ كافِلُ",11,"ل",1,0],["سُدتَ الجَميعَ فَلَيسَ مِنهُم مُنكِرٌ","أَن صِرتَ فَذَّهُمُ الَّذي لا يُتأَمُ",12,"م",1,0],["سَديسٍ تُطاوي البُعدَ أَو حَدَُ نابِها","صَبيٌَ كخُرطومِ الشَّعيرَةِ فاطِرُ",13,"ر",1,0],["سُدُماً قَديماً عَهدُهُ بِأَنيسِهِ","مِن بَينِ أَصفَرَ ناصِعٍ وَدِفانِ",14,"ن",1,0],["سدْ يا عليُّ فلا نكراً ولا عجبا","واعقدْ لبيتكَ في نجمِ السما طنبا",15,"ب",2,1],["سددت رأياً حباك العزّ متضحاً","فزادك الله من عزٍّ ومن سدد",16,"د",1,0],["سد من حضر","ومن غبر",17,"ر",1,0],["سدْ يا ابن فضل الإله كيف تشا","سيادةً ما لذكرها ناس",18,"س",1,0],["سد يا عليّ فما أبقيت منقبة","يمتاز عنك بها في الأعصر الأول",19,"ل",1,0],["سدْ يا عليّ بن يحيى كيف شئت فما","في فرعك المجتنى والأصل من ذام",20,"م",1,0],["سدْ يا عليّ على ذوي قلمٍ وقلْ","ليراعك اضْحك بالصريرِ وقهقهِ",21,"ه",1,0],["سَدَّ السَّدَادُ فَمي عَمَّا يُرِيبُكُمُ","لكنْ فَمُ الحالِ مني غيرُ مسدودِ",22,"د",1,0],["سدَّ شيطانُ حُبِّها كلَّ فَجٍّ","إنَّ شيطان حبِّها لَمَرِيدُ",23,"د",1,0],["سُدْتَ أنتَ الملوكَ حزْماً وعزْماً","ومُلوكيَّةً وساد عبيدَكْ",24,"ك",1,0],["سداها مخازيك التي قد علمتَها","ولحمتها منّي الكلام المحبر",25,"ر",1,0],["سدى غِرَّةٍ لا أعرف اليوم باسمه","وأعمل فيه اللهو مرأىً ومسمعا",26,"ع",2,0],["سدت أوائله سبيل أواخر","لم يدر سائقهن كيف يسوق",27,"ق",1,0],["سُدَّتْ على الخَلَلِ المداخلُ كُلُّها","ولقد يُرى في كل بابٍ يدخُلُ",28,"ل",1,0],["سُدتم فكنتم للوجوه معاطساً","شُمّاً وكنتم للرؤوس جماجما",29,"م",2,0],["سُدتم بخفَّةِ أقدامٍ مُسارعة","إلى الكرائه في رُجحان أحلامِ",30,"م",1,0],["سَدَّدَ الدَهرُ قَوسَه وَرَماني","لَم تَحُد مُهجَتي وَلا السَهمُ حادا",31,"ا",1,0],["سُدتَ أَو لَم رَسُد فَما أَنتَ إِلّا","حَيَوانٌ مُسَيَّرٌ مُستَعبَد",32,"د",1,0],["سَدّوا عَلى الباغي المَسالِكَ كُلَّها","فَالمَوتُ إِن وَلّى وَإِن هُوَ أَقبَلا",33,"ل",2,0],["سَدَدتَ سَبيلَ البَرِّ وَالبَحرِ عَنهُمُ","بِسابِحَةٍ دُهمٍ وَسابِحَةٍ غُرِّ",34,"ر",1,0],["سُدُماً إِذا اِلتَمَسَ الدِلاءُ نِطافَهُ","صادَفنَ مَشرِفَةَ المَثابِ دَحولا",35,"ل",2,0],["سدت مصرا بصدق حبك فيها","وفشا في ربوعها سلطانك",36,"ك",1,0],["سدم ما تراه ابيض في اعماقه","قد ذهبن مبتعدات",37,"ت",1,0],["سدلت حسناء الطبيعة عن","بخل علي وجهها الجميل قناعا",38,"ع",2,0],["سُدّت مسامعها لأول وهلة","دون الرزية تتقى أنباءها",39,"ا",3,0],["سَديدُ المَرامي قَد رَماهُ مُسَدِّدٌ","وَداهِيَةُ السُوّاسِ لاقى الدَواهِيا",40,"ي",2,0],["سُدِلَ السِتارُ وَهَل شَهِدتَ رِوايَةً","لَم يَعتَرِضها في الفُصولِ سِتارُ",41,"ر",1,0],["سَدَّدَت بِالهِلالِ قَوساً وَسَلَّت","خِنجَراً يَنفُذانِ مِن كُلِّ تُرسِ",42,"س",1,0],["سَدَّدَ السَهمَ إِلى صَدرِ الصِبا","وَرَماهُ في حَواشيهِ الغُرَر",43,"ر",1,0],["سُدتَ الثَلاثينَ الطِوا","لَ وَلَسنَ بِالحُكمِ القَصير",44,"ر",1,0],["سَدَّت عَلَيهِ المَشرَفِيَّةُ طُرقَهُ","فَاِنصاعَ لا حَلَباً وَلا بَغداذا",45,"ذ",2,0],["سدِكتُ بصَرفِ الدهرِ طفلاً ويافِعاً","فأفنَيتُهُ عزماً ولم يُفنني صبرا",46,"ر",2,0],["سَدَّت مُجانِبَةً وَخَلَّفَني الهَوى","عَن هَجرِها فَوَصَلتُ غَيرَ مُجانِبِ",47,"ب",1,0],["سَدِكَ النِساءُ بِنا مَلامَةَ عانِسٍ","نُلحى عَلى غَزَلٍ وَصَدِّ كَعابِ",48,"ب",1,0],["سَدادٌ فَتَلتَ بِهِ يَومَ ذا","كَ حَبلَ الخِلافَةِ حَتّى اِستَمَر",49,"ر",1,0],["سَدِكَت بِدِجلَةَ سارِياتُ رِكابِنا","يَرصُدنَها لِلوِردِ إِغيابَ السُرى",50,"ر",2,0],["سَدَّ تَدبيرُهُ الفَضاءَ عَلَيهِم","بَعدَ شَغبٍ مِن دَرئِهِم وَاِعتِراضِ",51,"ض",1,0],["سُدتَ في سِنِّكَ الحديثِ وَما النَج","دَةُ إِلّا لِلأَجدَلِ الغِطريفِ",52,"ف",1,0],["سُدَّت وُجوهُ فِجاجِ الأَرضِ دونَهُمُ","حَتّى كَأَنَّهُمُ في حَيرَةِ الرَدمِ",53,"م",1,0],["سَدَّتْ سيوفُكَ خَلَّةَ الثَّغْرَيْنِ","وَفَتَحْتَ من آرائِكَ السُّدَّيْنِ",54,"ن",1,1],["سَدَّتْ عَزائِمهُ الثُّغورَ وحالفَتْ","آراؤُه التَّسديدَ والتَّوفيقا",55,"ق",2,0],["سَديدَ الرأي والرُّمحِ استقامتْ","طَرائِقُهُ على طُرُقِ السَّدادِ",56,"د",1,0],["سَدَّ منه وجهَ الخُطوبِ فأضحَى","دونَ ما يتَّقي من الدَّهرِ سَدَّا",57,"د",2,0],["سَديسٍ كُبارِيٍّ تَئِطُّ نُسوعُهُ","أَطيطَ رِتاجٍ ذي مَساميرَ مُغلَقِ",58,"ق",1,0],["سُد في الأَنامِ فَلا بَرَحتَ مُؤَمَّلاً","تَسوي الخَلائِقَ في النَدى وَتُواسي",59,"س",2,0],["سَدَّدَ سَهماً ماعَدا رَوعَهُ","وَرَوَّعَ العُصمَ وَلِلأُسدِ صاد",60,"د",1,0],["سَدَّت حَوافِرُها الفَضاءَ بِعَثيَرٍ","غَنِيَت بِهِ العِقبانُ عَن وُكُناتِها",61,"ت",3,0],["سدّ من الدنيا ومن أغلالها","وعواثر الألبابِ والأفهامِ",62,"م",1,0],["سُدْتم وجدْتم فأوطان النجوم لكم","مراتبٌ من علوّ القدر والهممِ",63,"م",1,0],["سَددت بأقيالِ الأسود ثُغورَهُ","وحقّ بها فَتحَ الثغور منَ السدِّ",64,"د",1,0],["سَدِكَت بِهِ الأَقدارُ حَتّى إِنَّها","لَتَكادُ تَفجَأُهُ بِما لَم يَقدُرِ",65,"ر",1,0],["سَدِكُ الكَفِّ بِالنَدى عائِرُ السَم","عِ إِلى حَيثُ صَرخَةُ المَكروبِ",66,"ب",1,0],["سَدِّد مَرامي الطِفلِ في شَأنِهِ","بِلَفظَةٍ تَشدُد بِها أَزرَه",67,"ر",2,1],["سُدّوا المسامِعَ إلا أن يُقالَ لكم","هُزّوا الكِنانةَ باستقلالها فرحا",68,"ح",2,0],["سَدَّ القَضاءُ عَلَيهِ أَقطارَ الدُنى","فَفَتَحتَ عَنهُ مَغالِقَ الأَقطارِ",69,"ر",1,0],["سُدّوا سَبيلَ الشَرِّ وَاِجتَنِبوا الأَذى","وَخُذوا الأُمورَ بِحِكمَةٍ وَصَوابِ",70,"ب",1,0],["سَدّوا الفَضاءَ وَإِنَّني لَإِخالُهُم","خُبّاً بِأَرضِ الشَرقِ أَو أَغوالا",71,"ل",2,0],["سُدَّتِ السُّبلُ يا أبا العاصِ فَانْظُرْ","أينَ تمضِي إذنْ وأينَ تَحِيدُ",72,"د",1,0],["سَدُّوا السبيل عليه ستة أشهر","وأتى عليٌّ بالكتاب فرحّبوا",73,"ب",3,0],["سَدَدتَ مَفَاقِرِي وَشَدَدتَ رُكنِي","بِعِزَّةِ نَاصِرٍ وَنَدىً مُنِيلِ",74,"ل",1,0],["سَدّوا عَلَيَّ الطُرقَ خَوفَ طَريقِهِم","فَالطَيفُ لا يَسري عَلى تَأمينِ",75,"ن",1,0],["سَدَلَت لَيلَةُ الوِصالِ عَلَينا","ظُلمَةً تَملأُ الخَواطِرَ نورا",76,"ر",2,0],["سَدِّد خِلالَكَ مِن مالٍ تُجَمِّعُهُ","حَتّى تُلاقي الَّذي كُلُّ اِمرِئٍ لاقي",77,"ق",2,0],["سَدَّت مَسامِعَها بِفُرجِ مَراجِلٍ","مِن نَسجِ حَيٍّ مِثلُهُ لا يَنسُجُ",78,"ج",1,0],["سَدَّدنَ لي أَعيُناً نُجلاً كَما نَظَرَت","أُدمٌ هِجانٌ أَتاها مُصعَب قَطِمُ",79,"م",1,0],["سَدَّ الفِناءَ بِمِصباحٍ مُجالِحَةٍ","شَيحانَةٍ خُلِقَت خَلقَ المَصاعيبِ",80,"ب",1,0],["سُدتُمُ الحارِثَ بنَ كَعبٍ أُ","لي السُؤدَدِ في مَجدِها بِعَشرِ خِلالِ",81,"ل",1,0],["سُدْتُمُ النّاسَ بالتُّقَى وَسِواكم","سَوَّدَتْهُ البَيْضاءُ والصَّفْراءُ",82,"ا",2,0],["سَدّ الإمامُ بكَ الثغورَ وقبلَهُ","هَزَمَ النبيُّ بقوْمكَ الأحزابا",83,"ب",2,0],["سَدَّ الثُغورَ بِخَيلِ اللَهِ مُلجَمَةٍ","وَفي الخُيولِ وَفي فُرسانِها سَدَدُ",84,"د",1,0],["سَدِيسٌ لَدِيسٌ عَيطَمُوسٌ شِمِلَّةٌ","تُبارُ إِليها المُحصَناتُ النَجائِبُ",85,"ب",1,0],["سِداوَتُها من ناصعِ اللونِ أبيضٍ","ولُحمتُها من فاقعِ اللونِ أصفرا",86,"ر",2,0],["سُدَّتْ فِجاجُ الخافقَينِ عليهمُ","فكأنَّما خُلقا بغيرِ فِجاجِ",87,"ج",1,0],["سدم هَذه المجرَّة تنأى","وَشموس جلَّت عَن الإحصاء",88,"ا",2,0],["سَدٌّ من الرُّعب بلا آخر","يعبُّ عبَّ الأبد الزاخر",89,"ر",1,0],["سدِّدي بالنار قوساً واصرعي","مارِدَ الشرِّ بمشبوب السِّهامِ",90,"م",1,0],["سَدَّتْ طريقكما الحُتوفُ وأنتما","تتحرقانِ هوىً إلى الأوطانِ",91,"ن",1,0],["سَدَدنَ خَصاصَ الخَيمِ لَمّا دَخَلنَهُ","بِكُلِّ لَبانٍ واضِحٍ وَجَبينِ",92,"ن",1,0],["سَدَّدَتْ في سكينة الكون للأعما","قِ نفسي لَحْظاً بعيدَ الرُّسوبِ",93,"ب",1,0],["سَدِكَاتٍ بِالرُّمْحِ مِنْهُ بَنانٌ","تَمْلأُ الأَرْضَ والسَّماءَ جِرَاحَا",94,"ح",2,0],["سَدِّدْ قَوِيمَ سِنَانِهِ","فِي صَدْرِ مَنْ لَمْ يَسْتَقِمْ",95,"م",1,0],["سَدَّ بِهَا خَلَّةَ أَوْطَانِهِ","أَرْوَعُ ذُو رَأْيٍ حَلِيفِ السَّدَادْ",96,"د",1,0],["سُدَّ مَا اسطَعْتَ مِنْ مَفَاقِرَ وامْنَعْ","عِرْضَ حُرٍّ سِتَارُهُ مَسْدُولُ",97,"ل",1,0],["سُدَّت سَبيلي إِلَيكَ إِن لَم","تَكُن ثَوابي بِما أُقاسي",98,"ي",1,0],["سَدُّوا الشِّعَابَ وأَقْبَلَتْ أَرْسالُهم","كالزَّاخِرِ الهَدَّارِ في ضَوْضَائه",99,"ا",3,0],["سدَّ القَضاءُ منافِذَ الأسماعِ","ماذا يقولُ إذا نعاكَ الناعِي",100,"ي",1,1],["سددت عليّ الطُرْقَ لم ألْقَ مَسْلكاً","وأوسعت طُرْقَ المجدِ والحسبِ الضخمِ",101,"م",1,0],["سدى ، تمدين اليه اللظى","لن تستحرّ الكومة الخامده",102,"د",2,0],["سَدِّدْ خِلاَلَكَ مِنْ مَالٍ تُجَمِّعُهُ","حَتَّى تُلاَقِي الَّذي كُلُّ امْرِىءٍ لاَقِ",103,"ق",1,0],["سددتَ عليه الرأيَ حتى تركتَه","يَرى من سَدادِ الرأيِ ما عدَّه سبَّا",104,"ب",2,0],["سَدَّتْ عليَّ مجاري العيشِ صافيةً","كفُّ الليالي وأجرتها بأقذاء",105,"ا",2,0],["سدى ، تمنيّن من ماتت رغائبه","من طول ما أغتبق (القطران) واصطبحا",106,"ح",2,0]]}