أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5956,"شعرتُ بأني غبارٌ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=182531",""],[5956,"مِن معجزاتك يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=200035",""],[5956,"حنينٌ لقرية \"بيت أجنادٍ\" ثم انطفاءُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=207910",""],[5957,"يا أيها الوطن المسافر في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=177344",""],[6029,"أسمعتُمُ أنّ الورودَ تُضامُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=188861",""],[6068,"كتبت على أوراقها -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175936",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6152,"بنا من شوقنا ما لايقال","https://www.poetsgate.com/ViewPoem.aspx?id=207649",""],[469,"خلا الدست من ذاك الجلال الممنع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574819",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""],[5724,"فجعت لفرط فراقك الاخوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55152&r=&rc=19",""],[434,"عَدَدْنالهُ خَمْسا وعشرين حجَّة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26712&r=&rc=0",""],[6235,"نسرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77693&r=&rc=8",""],[572,"بأبي أقيكَ من الحوادثِ والرّدَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9481&r=&rc=338",""]],"verses":[["فُجِعَت بِمُنصَلِتٍ يُعَرِّضُ لِلقَنا","أَعناقَها وَيُحَصِّنُ الأَكفالا",0,"ل",2,0],["فُجِعَت بِعِلقِ مَضَنَّةٍ يَدُهُ","فَأَقامَ لا عِوَضٌ وَلا خَلَفُ",1,"ف",1,0],["فُجِعَت سَماؤُكِ بِالشُموسِ وَحُوِّلَت","عَنها وَعَنكِ مَطالِعُ الأَقمارِ",2,"ر",1,0],["فُجِعوا بِتاجِ الدين حتى عَضّهُمْ","زَمَنٌ ألَحَّ بشِرَّةٍ وعُرامِ",3,"م",1,0],["فجعَلْتُ بابَكَ عنْ يَمينكَ نائِباً","أهْديهِ عنْدَ زيارَتي تَقْبيلا",4,"ل",2,0],["فُجِعَتْ بِهِ الدُّنْيَا وَكُدِّرَ شِرْبُهَا","وَشَكَا الْعِرَاقُ مُصَابَهُ وَالشَّامُ",5,"م",1,0],["فَجَعَلتَ أَمرَ الناسِ شورى بَينَهُم","وَأَقَمتَ شَرعَ الواحِدِ الدَيّانِ",6,"ن",1,0],["فَجَعَلتُ سِرَّ القَلبِ سَتراً دونَهُ","فَمَنِ الأَمينُ البَرُّ إِن قَلبٌ وَشى",7,"ش",2,0],["فَجَعَلتَ عاليها مَكانَ أَساسِها","وَأَلَنتَ لِلأَخشابِ فيها الجامِدا",8,"د",2,0],["فُجِعَت رَحى الإِسلامِ مِنكَ بِقُطبِها","لَيتَ الحَسودَ فِداكَ فَهُوَ ثِفالُ",9,"ل",1,0],["فَجَعتُهُمُ بِخَيرِهِمِ نَديم","وَأَطعَمِهِم لَدى قَحطِ القِطارِ",10,"ر",1,0],["فُجِعْنَا بِمَيْمُونِ النَّقِيبَةِ أَرْوَعٍ","تَقُرُّ بِهِ حِينَ اللِّقَاءِ عُيُونُ",11,"ن",1,0],["فُجِعَ القَرِيضُ وَقَدْ ثَوَى حَسَّانُ","وَخَلا بِبَيْتِ المَقْدِسِ المَيْدَانُ",12,"ن",1,1],["فُجِعَتْ مِصْرَ فِي فَرِيدَةِ عِقْدٍ","أيْنَ مِنهَا الْفَرِيدُ فِي التَّثْمِينِ",13,"ن",1,0],["فُجِعُوا بِهَجْعَتِهِ وَلَمْ تَكُ قَبْلَهَا","لِتَطُولَ عن بِرٍّ وعن إحْسَانِ",14,"ن",1,0],["فَجَعْتَنِي فِي أَخٍ كَانَتْ مَوَدَّتُهُ","دُنِيَا تَحَلَّتْ مِنَ النُّعْمَى بِأَلْوَانِ",15,"ن",1,0],["فُجع الجميع بواحدٍ جمعت له","شتَّى العُلا ومكارم الأخلاقِ",16,"ق",1,0],["فَجَعْتَنا يا علم في أمرنا","أمعتِب أنت إذا نجزع",17,"ع",1,0],["فَجَعَ الأَجارِبُ بِالزُبَيرِ وَمِنقَرٌ","لَم يَختِلوكَ وَجاهَروكَ جِهارا",18,"ر",2,0],["فُجِعنا بِحَمّالِ الدَياتِ اِبنِ غالِبٍ","وَحامي تَميمٍ عِرضَها وَالمُراجِمِ",19,"م",1,1],["فَجَّعَني الرَعدُ وَالصَواعِقُ بِال","فارِسِ يَومَ الكَريهَةِ النَجُدِ",20,"د",1,0],["فجعجنا بهن وكان ضرب","ترى منها جماجمهم فيْنا",21,"ن",2,0],["فَجَعجَعنَا بِهِن وكانَ ضَرباً","تُرَى مِنهُ جَماجِمُهُم فئينا",22,"ن",2,0],["فَجَعنا بِنِصفِ الجَيشِ جَونَةَ كُلَّها","وَأَرهَقَ جَرّاحٌ وَوَلّى مُغاوِرُ",23,"ر",1,0],["فَجَعَلتَني غَرَضَ اللِئامِ فَكُلُّهُم","يَرمي بِلُؤمِهِ بالِغاً كَمُقَصِّرِ",24,"ر",1,0],["فَجَّعَنا فَيروزُ لا دَرَّ دَرُّهُ","بِأَبيَضَ يَتلو المُحكَماتِ مُنيبِ",25,"ب",1,1],["فُجعَت فلا عادت إليك فجيعةٌ","كما يُفجَع الأملاك بالملِكاتِ",26,"ت",1,0],["فجَّعني صرفُهُ بمؤنسةٍ","تبعث مَيْت النشاط والأشرِ",27,"ر",1,0],["فجعلت إهدائي إليك مدائحاً","مثل الرياض من الكلام المبدع",28,"ع",1,0],["فجعلت صاحبهم طويسَ وما","لاقى طويسُ أولئك التسعه",29,"ع",2,0],["فجعلت إهدائي إليك قصيدة","بكراً بخاتم ربها لم تفتقِ",30,"ق",1,0],["فَجَعَلَت تَنثُرُ أَوراقَها","بِأَنمُلٍ كَالغَنَمِ الرَطبِ",31,"ب",1,0],["فُجِعنا بِهِ كَالبَدرِ عِندَ تَمامِهِ","وَلَم نَرَ بَدراً قَبلَهُ الأَرضَ وُسِّدا",32,"د",2,0],["فجعت مصر بالزعيم الجليل","بأبي الشعب كله زغلول",33,"ل",1,0],["فجع المشرقين خطب جليل","وعرى المغربين حزن طويل",34,"ل",1,1],["فجعت مصر بابنها البر شوقي","فهي ثكلى كثيرة التشهاق",35,"ق",1,0],["فجعت مصر والعراق بتيمو","ر فيا لهفتي على تيمور",36,"ر",1,0],["فُجعت بخير بُناتها ومضت به","ريح المنية قبل حين حصاد",37,"د",1,0],["فجعلت شعرك فيهما ولطالما","قد كنت عبد المدح والتاريخ",38,"خ",1,0],["فَجَعَلتني خَلفَها","أَنجو بِها وَأَختَبي",39,"ب",2,0],["فُجِعَت رُبى الوادي بِواحِدِ أَيكِها","وَتَجَرَّعَت ثُكلَ الغَديرِ الصافي",40,"ف",2,0],["فُجِعَ البَيانُ وَأَهلُهُ بِمُصَوِّرٍ","لَبِقٍ بِوَشيِ المُمتِعاتِ صَناعِ",41,"ع",1,0],["فُجِعَت بِهِ فَكَأَنَّهُ وَكَأَنَّها","نَجمُ الهِدايَةِ لَم يَدُم لِلساري",42,"ر",2,0],["فُجِعَ الناسُ يَومَ ماتَ الحَمولي","بِدَواءِ الهُمومِ في عَطّارِهِ",43,"ر",2,0],["فُجِعنا كُلُّنا بِعَلائِلِيٍّ","كَرُكنِ النَجمِ أَو أَسنى عَلاءَ",44,"ا",2,0],["فَجَعَ المَكارِمَ فاجِعٌ في رَبِّها","وَالمَجدَ في بانيهِ وَالعَلياءَ",45,"ا",2,0],["فُجِعَ القَريضُ بخاتمِ الشُّعراءِ","وغَديرِ رَوْضَتِها حَبيبِ الطّائي",46,"ي",1,1],["فَجَعَلتُ رَدّي عِرسَهُ كَفّارَةً","عَن شُربِها وَشَرِبتُ غَيرَ أَثيمِ",47,"م",1,0],["فُجِعَتْ بها نفسِي وأيامُ الفتى","نَسَماتُ أرواحٍ لهنَّ هُبوبُ",48,"ب",1,0],["فَجَعَلنا الوَداعَ فيهِ سَلاماً","وَجَعَلنا الفِراقَ فيهِ لِقاءَ",49,"ا",2,0],["فَجْعٌ تَطيرُ له على أحشائِنا","شُعَلٌ وتَسقُطُ في القلوبِ سِهامُ",50,"م",1,0],["فُجعَتْ أنفُسُ الملوكِ أبا الهَيْ","جاءِ حَرباً بأنفَسِ الأَعْلاقِ",51,"ق",1,0],["فُجِعُوا بأحمدَ مُستضا","مَ القِرْنِ مُختَرَمَ المُنافِس",52,"س",1,0],["فُجِعنا بِأَدنى الناسِ مِنكَ قَرابَةً","وَمَن زَلَّ عَن كِبدي فَقَلَّ تَصَبُّري",53,"ر",2,0],["فَجَعَلتُ عُذري الاِعتِرافَ بِزَلَّتي","إِذ بِها في طَيِّ عِلمِكَ مَن خَفا",54,"ف",2,0],["فَجَعَلنا داعي الصَبوحِ لَدَينا","بَدَلاً مِن سُحورِهِ وَالأَذانِ",55,"ن",1,0],["فُجِعتُ بِنَدبٍ كانَ يَملَأُ ناظِري","فَأَصبَحَ ناعي نَدبِهِ مالِئاً أُذني",56,"ن",2,0],["فَجُعَت بِكَ الدُنيا فَلا وَجهُ العُلى","طَلُقٌ وَلا صَدرُ الزَمانِ رَحيبُ",57,"ب",1,0],["فَجَعَلتُ نَجمَ الدينِ سَهمي عِندَما","عايَنتُ شَيطانَ الخُطوبِ مَريدا",58,"د",2,0],["فجعتني الأيام فيه فلم يَب","قَ على الأرض ما يسرُّ ويحمد",59,"د",1,0],["فَجَعَتني الأَيّامُ فيكَ فَأُنسي","في اِختِلالي وَعِصمَتي في اِضطِرابي",60,"ب",2,0],["فَجَعَتني الأَيّامُ بِالصادِقِ النُط","قِ فَتى المَكرُماتِ وَالآدابِ",60,"ب",1,0],["فَجَعَلتُ قَيِّمَها الضَميرَ وَمُكِّنَت","مِنهُ فَصارَت قَيِّماً لِلقَيِّمِ",61,"م",1,0],["فُجعَتْ حماةُ ببدرِها بل صدرِها","بل بحرِها بل حبرِها الغواصِ",62,"ص",1,1],["فُجعتْ بكتَّانيِّها مصرُ","فبمثلِهِ لا يسمحُ الدهرُ",63,"ر",1,1],["فَجَعَتنا أُمُّ بِشرٍ","بَعدَ قُربٍ بِاِحتِمالِ",64,"ل",1,1],["فَجَعَلتُ أُثلِجُها يَميناً بَرَّةً","بِاللَهِ حَلفَةَ صادِقٍ لَم يَكذِبِ",65,"ب",1,0],["فَجعوني فيهِ بابنٍ صالحٍ","وأخٍ حُرِّ السّجايا وابنِ عَمّْ",66,"م",1,0],["فُجِعُوا في النَّهبِ والسَّبْيِ معاً","وسُقُوا أَسْوَأَ شِرْبِ المُسْتَقِي",67,"ي",1,0],["فَجَعتَ الرَقيبَ وَالعاذِل","حَتّى قَد رَحَمتُ عُذّالي",68,"ي",1,0],["فُجِعت بَنو مَصر بِفَقد زَعيمها","اللَهُ أَكبر أَي أَروَع تَفقد",69,"د",1,0],["فُجِعَت بَنو أَسَدٍ بِهِ","وَبَنو نِزارٍ قاطِبَه",70,"ب",2,0],["فَجَعوني يَومَ زَمّوا عيرَهُم","بِرَخيمِ الصَوتِ مَلثومٍ عَطِر",71,"ر",1,0],["فَجَعَلْتُ خَلْعِي للْعِذَار لِثَامَه","إذ كان من لثْم العِذار مُعاذا",72,"ذ",2,0],["فَجَعَلتُ ما تُهدي إِلَيَّ هَدِيَّةً","مِنّي إِلَيكَ وَظَرفَها التَأميلا",73,"ل",2,0],["فُجِعَتْ نهضةُ البلاد ببانٍ","شدّ من ركنها وشادَ وطنَّبْ",74,"ب",1,0],["فَجَعتُهُمُ بِخَيرِهِمِ نَديماً","وَأَطعَمِهِم لَدى قَحطِ القِطارِ",75,"ر",1,0],["فَجَعَتْنِي بِوالِدَيَّ وَأَهْلِي","ثُمَّ أَنْحَتْ تَكُرُّ فِي أَتْرَابِي",76,"ب",2,0],["فُجِعَ النُّبْلُ بِهَا وَالدِّ","ينُ وَالعَقْلُ الأتَمُّ",77,"م",1,0],["فجِعتْ مِصْرُ فِيكَ فَجْعَةَ أُمٍّ","فِي الأَعَزِّ الأغْلَى مِنَ الأَبْنَاءِ",78,"ا",2,0],["فَجَعَ الكِنَانَةَ بِابْنِهَا وَبِسَيْفِهَا","وَبِرَأْيِهَا فِي المَوْقِفِ المُتَضَايِقِ"