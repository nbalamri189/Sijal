[5431,"زان العمرَ إيمانُ","https://www.poetsgate.com/ViewPoem.aspx?id=183237",""],[5431,"شهوة الموت...","https://www.poetsgate.com/ViewPoem.aspx?id=204950",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5720,"جمالُ الروح ..","https://www.poetsgate.com/ViewPoem.aspx?id=198836",""],[5720,"ريمُ البَان ..","https://www.poetsgate.com/ViewPoem.aspx?id=199060",""],[5736,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=210606",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5829,"العاشق الجسور","https://www.poetsgate.com/ViewPoem.aspx?id=215927",""],[5836,"مكارم الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=195085",""],[5912,"شام الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=205018",""],[5956,"عيونٌ تدري مقاصدنا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182273",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"جوبي السهول","https://www.poetsgate.com/ViewPoem.aspx?id=184926",""],[5956,"الجمالُ الحيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=185813",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5956,"في عمق وادي الحُسْن","https://www.poetsgate.com/ViewPoem.aspx?id=196805",""],[5956,"ماذا يفيد سؤالٌ لا انتفاع به","https://www.poetsgate.com/ViewPoem.aspx?id=204370",""],[5956,"\"مِن غير شرٍّ\" يا أعزَّ صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=214989",""],[5989,"دق الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=181670",""],[5991,"بكماله ما في الوجو مظاهر","https://www.poetsgate.com/ViewPoem.aspx?id=116384",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6068,"الجمال -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175908",""],[6253,"اختيار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6417&r=&rc=0",""],[6290,"الْقَنْطَرَةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85654&r=&rc=43",""],[2220,"إني رأيتُ وجوداً لستُ أعرفهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11666&r=&rc=540",""]],"verses":[["إِنَّ الجِيادَ عَلى المَرا","بِطِ تَشتَكي طولَ الجُمامِ",0,"م",1,0],["إِنَّ الجَمالَ حَبا فَوزاً بِخِلعَتِهِ","حَذواً بِحَذوٍ وَأَصفاها بِتَحويرِ",1,"ر",1,0],["إِنَّ الجَوادَ إِذا حَلَلتَ بِبابِهِ","وَإِذا تُسائِلُهُ أَبو يَعفورِ",2,"ر",1,0],["إِنَّ الجَهولَ إِذا تَصَدَّرَ بِالغِنى","في مَجلِسٍ فَوقَ العَليمِ الفاضِلِ",3,"ل",1,1],["إِنَّ الجَديدَينِ في طولِ اِختِلافِهِما","لا يَفسُدانِ وَلَكِن يَفسُدُ الناسُ",4,"س",1,0],["أن الجسوم إذا تكون نشيطةً","تقوى بفضل نشاطها الأحلام",5,"م",1,0],["إِنَّ الجَميعَ تَفَرَّقَت أَهوائُهُم","إِنَّ النَوى بِهَوى الأَحِبَّةِ تَفجَعُ",6,"ع",1,0],["إِنَّ الجِيادَ يَبِتنَ حَولَ قِبابِنا","مِن آلِ أَعوَجَ أَو لِذي العُقّالِ",7,"ل",1,0],["إِنَّ الجَراثيمَ كُبراها يَكونُ لَنا","لا حَقَّ لِلتَيمِ في تِلكَ الجَراثيمِ",8,"م",1,0],["إن الجماهيرَ قد ذلَّت رقابهُم","إلى كمالك واسْتوفاهمُ الهلع",9,"ع",1,0],["أن الجميع على طباعٍ واحد","وبما يرونَ تفاضلُ الأطوارِ",10,"ر",1,0],["إِنَّ الجَواهِرَ بِالجَواهِرِ أُنسُها","أَمّا التُرابُ فَبِالتُرابِ حُبورُهُ",11,"ر",2,0],["إِنَّ الجَهولَ إِذا تَعَلَّم وَاِهتَدى","بَثَّ الهُدى في صَحبِهِ وَالآلِ",12,"ل",1,0],["إِنَّ الجَمالَ يَغيبُ مِثلُ القُبحِ تَحتَ البُرقُعِ","لَكِن لِماذا تَجزَعينَ عَلى النَهارِ وَلِلدُجى",13,"ج",2,0],["إن الجمال كساك من","ورق المحاسن ماكساك",14,"ك",1,0],["إِنَّ الجَواهِرَ أَسناها وَأَكرَمُها","ما يَقذِفُ المَهدُ لا ما يَقذِفُ الزَبَدُ",15,"د",1,0],["إنّ الجزيرة في البحر المحيط لها","سور وباب وفيها غرفة الملكِ",16,"ك",1,1],["إِنَّ الجَهولَ إِذا أُلزِمتُ صُحبَتَهُ","قَسراً فَصاحَبتُهُ عَن غَيرِ إيثارِ",17,"ر",1,1],["إن الجمالَ الساحرَ الفاتنا","يا ويحه حين تغير الغضون",18,"ن",1,0],["إِنَّ الجِيادَ عَلى عِلّاتِها صُبُرٌ","ما إِن تَشَكّى الوَجا في حالَةِ الأَينِ",19,"ن",1,0],["إِنَّ الجِيادَ إِذا عَلَتها صَنعَةٌ","راقَت ذَوي الأَلبابِ وَالإِفهامِ",20,"م",1,0],["إِنَّ الجَبابِرَةِ الأُلى أَخَذوا الدُنى","أُخِذوا وَكانَ حِسابُهُم أَن يُترَكوا",21,"ك",3,0],["إِنّا لَجَأنا إِلَيهِ نَستَعينُ بِهِ","عَلى الحَوادِثِ إِذ قامَت تُناوينا",22,"ن",2,0],["إن الجبالَ التي في الأرضِ لو كفرتْ","لَدَكَّها جَبلُ الإسلامِ أو نَسَفَا",23,"ف",2,0],["إِن الجمال إِذا تجمّع شَمله","فَالوَيل كُل الوَيل للشعراءِ",24,"ا",2,0],["إنَّ الجَلالَةَ مُنْذُ رُمْتُ مَدِيحَكم","لم تَرْضَ لي ذكرَ الحِسَانِ الخُرَّدِ",25,"د",1,0],["إِنَّ الجَنابَةَ مِمَّن","جَنُبتُ مِنهُ طَهورُ",26,"ر",1,0],["إِنَّ الجَديدَينِ اللَذَينِ هُما","سِبقانِ بَذّاتي وَما بُذّا",27,"ذ",2,0],["إِنَّ الجَديدَينِ قَد جَرَّبتُ فَعلَهُما","جِنسَينِ ضِدَّيّنِ مِن نِعَمٍ وَمِن بيسِ",28,"س",1,1],["إِنَّ الجَديدَينِ ما رَثّا وَلا خَلُقا","وَلَم يَدوما عَلى نُعمى وَلا بوسِ",29,"س",1,1],["إِنَّ الجَديدَينِ ما ظَنّا وَما عَلِما","بَل طائِرانِ عَلى جَدٍّ أَحَذّانِ",30,"ن",1,0],["إِنَّ الجَماهيرَ في الآفاقِ هاتِفَةٌ","تُثني عَلَيكَ وَتَرجو عِندَكَ القُربا",31,"ب",2,0],["أن الجماعة دون الفرد معرفة","وفوقه بصروف الدهر إحساسا",32,"س",2,0],["إِنَّ الجهالة قد قَضَت","أَن يَستَكين فَلا مردّا",33,"د",2,0],["أنالَ جلالُ اليوم منك فخِلتَهُ","رُؤى يقظةٍ بل ذاك رأيُ عيانِ",34,"ن",1,0],["إن الجمال حليةُ الأقمار","ما أضيع الحسن على الأغمار",35,"ر",1,0],["إِنَّ الْجَمَالَ لَفِي الْفُؤَادِ وَإِنَّما","خَفِيَ الصَّوَابُ لأَنَّهُ لا يَظْهَرُ",36,"ر",1,0],["إنَّ الْجَمَادَ أَبَرُّ مِنْ أَرْوَاحِهِمْ","بهِمُ وَأَمْتَنُ في الدِّفَاعِ وَأَصْلَبُ",37,"ب",1,0],["إِنَّ الجُمَيِّلَ فِي الجَمَالِ وَفَنِّه","لأَدَقُّ مُبْتَدِعٍ وَخَيْرُ مُجَدِّدِ",38,"د",1,0],["إِنَّ الْجُنُودَ بِه تَلُوذُ وَتَحْتَمِي","وَلَكَمْ عُرُوش تحْتَمِي بِجُنُودِ",39,"د",1,0],["إنّ الجديدَيْنِ، اللّذيْنِ هُما","سِبْقانِ، بذّاني وما بُذّا",40,"ذ",2,0],["ان الجنون وراء نصف قصائدي","أوليس في بعض الجنون صواب ؟!",41,"ب",1,0],["ان الجهالة ان كانت قذى بصر","رأى الضلال هدى واستسمن الورما",42,"م",2,0],["ان الجمال لمسكر اصحابه","سكر الدلال وليس يعرف ذا الخلي",43,"ل",2,0],["ان الجمال اذا يشاب بخفة","وبسوء خلق لم يكن بجمال",44,"ل",1,0],["إنَّ الجزائرَ والكِفاحَ مَلاحِمي","تُروى إذا كَتَمَ اللِّسانُ سَرائري",45,"ر",2,0],["إنَّ الجزائرَ والكِفاحَ تَعاشَقا","وعَشِقْتُ ذَيْنِ العاشِقَينِ فحاذِرِ",45,"ر",1,0],["إن الجمال دواء دا","ئك فليكن منك اللصيق",46,"ق",1,0],["إِنَّ الجَلالَةَ مِن أَفعالِكَ اِنتَقَلَت","فَإِن خُصِصتَ بِأَوفاها فَلا عَجَبُ",47,"ب",1,0],["إِنَّ الجَزيرَةَ بابٌ ظَلتَ توسِعُهُ","هَزّاً وَلَم يَبقَ غَيرُ الفَتحِ فَاِرتَقِبِ",48,"ب",1,0],["إِنَّ الجَديدَينِ إِذا ما اِستَولَيا","عَلى جَديدٍ أَدنياهُ لِلبِلى",49,"ا",1,0],["إن الجواسيس حولي","في أي أرض حللت",50,"ت",1,0],["إن الجمال طعامي","وخمرتي إن ظمئت",50,"ت",1,0],["إن الجحيم وإن طالت غوائله","أخفّ من مرض يغزوك في الصغر",51,"ر",1,0],["إن الجمال هو الكما","ل وليس مازان الظباء",52,"ا",2,0],["ان الجزيرة لا عدا","جوديها الجود الهتون",53,"ن",1,0],["إن الجواهرَ عندَ الجوهريِّ غَلت","وليسَ يَعلمُ ما تَسواه نحّاس",54,"س",1,0],["إنَّ الجزيرة أصبَحت مَفتوحة","ومشاعِرُ الحرَمينِ لا تشتام",55,"م",1,0],["إن الجمال به عزاءُ الأنفُسِ","فافْدِ المَلِمَّةَ بالأعزِّ الأنفَسِ",56,"س",1,1],["إن الجفا والبعد قد عناني","وحل بي منه الذي كفاني",57,"ي",1,0],["إِنّ الجوادَ لئن ينال بجودهِ","راجيه أسرع من نسيم منبرِ",58,"ر",1,0],["إنّ الجِنانَ هَدِيٌّ أنت خاطبُها","ومَهْرُها عَمَلٌ من عامِلٍ زاك",59,"ك",1,0],["إِنّ الجمالَ معادنٌ","وَمَنَاقبٌ أَورَثنَ مَجدا",60,"د",2,0],["إِن الجُنون هُوَ الهَوى","أَفعاقِلٌ مَن عَنَفا",61,"ف",2,0],["أنَّ الجنان زُخْرِفَتْ","لِمَعْشَر الزيديَّهْ",62,"ه",1,0],["إنَّ الجَهولَ تَضرُّني أخلاقه","ضررُ السُّعالِ بِمَنْ بهِ اسْتِسقاءُ",63,"ا",2,0],["إِنَّ الجَوادَ اِبنَ يَحيى الفَضلَ لا وَرِقٌ","يَبقى عَلى جودِ كَفَّيهِ وَلا ذَهَبُ",64,"ب",1,0],["إنَّ الجميلَ وأهْلَه ومحلَّه","وأبو الجميل ابن الجميل محمد",65,"د",1,0],["إنَّ الجهاد على الروافض لازمٌ","ويثاب فاعله عليه ويؤجر",66,"ر",1,0],["إن الجميل إذا تحكم بالجما","ل فما ظلم",67,"م",1,0],["إن الجماعة بالزعيم فلو هفت","قدم له لهفا الجَميع وضوعا",68,"ع",2,0],["إنَّ الجحاجح من قُريشٍ أدركوا","شَرَفاً تُقِرُّ بفضلهِ الأعْداءُ",69,"ا",2,0],["أنَّ الجديدين استمالا 