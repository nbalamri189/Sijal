,"الكامل"],[102,"روحي فداء عصابة زرقاء","https://www.aldiwan.net/poem33033.html","الكامل"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[48,"قالوا اغتسل أتت الظهر","https://www.aldiwan.net/poem63337.html","المجتث"],[46,"يا واعظي بالصمت ما لك لا","https://www.aldiwan.net/poem22505.html","الكامل"],[46,"إن الجديدين قد جربت فعلهما","https://www.aldiwan.net/poem22832.html","البسيط"],[46,"إن الجديدين ما رثا ولا خلقا","https://www.aldiwan.net/poem22834.html","البسيط"],[46,"قد آذنتنا بأمر فادح أذن","https://www.aldiwan.net/poem23517.html","البسيط"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49288","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85777","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[46,"يا واعظي بالصّمتِ! ما لك لا","https://www.poetsgate.com/ViewPoem.aspx?id=20053",""],[99,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""],[88,"قد يطفح اللؤم حتى ان صاحبه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19581&r=&rc=84",""],[115,"يا قلب لا تقبل مقالة ناصح","https://www.aldiwan.net/poem40607.html","عموديه"],[115,"قسما برقة خصرك الميال","https://www.aldiwan.net/poem40624.html","عموديه"],[117,"جزائري","https://www.aldiwan.net/poem24036.html","الكامل"],[124,"قل للمليحة مالها","https://www.aldiwan.net/poem23782.html","مجزوء الكامل"],[143,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[143,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[211,"مع الحبيب سبحت","https://www.aldiwan.net/poem45543.html","المجتث"],[211,"قد كنت تكتب والآمال قادمة","https://www.aldiwan.net/poem46776.html","البسيط"],[221,"ألبست من بعد الوفاء","https://www.aldiwan.net/poem55303.html","مجزوء الكامل"],[261,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[270,"الخمر في كأسها الياقوت والماس","https://www.aldiwan.net/poem35295.html","البسيط"],[270,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[270,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[304,"يا جيرة بالمعهد اليماني","https://www.aldiwan.net/poem16842.html","الرجز"],[305,"سيان أن لبس التجمل أو عري","https://www.aldiwan.net/poem56550.html","الكامل"],[364,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[365,"ليس الجمال بمئزر","https://www.aldiwan.net/poem44524.html","مجزوء الكامل"],[380,"يقضي علي تعسفا","https://www.aldiwan.net/poem48808.html","مجزوء الكامل"],[402,"ألية أليه","https://www.aldiwan.net/poem46959.html","منهوك الرجز"],[405,"لا انس إلا في مجالس تلتقي","https://www.aldiwan.net/poem50123.html","الكامل"],[410,"ما الفصل إلا شهاب لا أفول له","https://www.aldiwan.net/poem67531.html","البسيط"],[416,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[416,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[429,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[441,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[461,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[464,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[544,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"إن الجميع حدود في العقول وفي","https://www.aldiwan.net/poem34626.html","البسيط"],[562,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[562,"للشعر في كل عصر مركب خشن","https://www.aldiwan.net/poem52868.html","البسيط"],[567,"يا خاضب الشيب والأيام تظهره","https://www.aldiwan.net/poem69609.html","البسيط"]],"verses":[["إِنَّ الجِيادَ عَلى المَرا","بِطِ تَشتَكي طولَ الجُمامِ",0,"م",1,0],["إِنَّ الجَمالَ حَبا فَوزاً بِخِلعَتِهِ","حَذواً بِحَذوٍ وَأَصفاها بِتَحويرِ",1,"ر",1,0],["إِنَّ الجَوادَ إِذا حَلَلتَ بِبابِهِ","وَإِذا تُسائِلُهُ أَبو يَعفورِ",2,"ر",1,0],["إِنَّ الجَهولَ إِذا تَصَدَّرَ بِالغِنى","في مَجلِسٍ فَوقَ العَليمِ الفاضِلِ",3,"ل",1,1],["إِنَّ الجَديدَينِ في طولِ اِختِلافِهِما","لا يَفسُدانِ وَلَكِن يَفسُدُ الناسُ",4,"س",1,0],["أن الجسوم إذا تكون نشيطةً","تقوى بفضل نشاطها الأحلام",5,"م",1,0],["إِنَّ الجَميعَ تَفَرَّقَت أَهوائُهُم","إِنَّ النَوى بِهَوى الأَحِبَّةِ تَفجَعُ",6,"ع",1,0],["إِنَّ الجِيادَ يَبِتنَ حَولَ قِبابِنا","مِن آلِ أَعوَجَ أَو لِذي العُقّالِ",7,"ل",1,0],["إِنَّ الجَراثيمَ كُبراها يَكونُ لَنا","لا حَقَّ لِلتَيمِ في تِلكَ الجَراثيمِ",8,"م",1,0],["إن الجماهيرَ قد ذلَّت رقابهُم","إلى كمالك واسْتوفاهمُ الهلع",9,"ع",1,0],["أن الجميع على طباعٍ واحد","وبما يرونَ تفاضلُ الأطوارِ",10,"ر",1,0],["إِنَّ الجَواهِرَ بِالجَواهِرِ أُنسُها","أَمّا التُرابُ فَبِالتُرابِ حُبورُهُ",11,"ر",2,0],["إِنَّ الجَهولَ إِذا تَعَلَّم وَاِهتَدى","بَثَّ الهُدى في صَحبِهِ وَالآلِ",12,"ل",1,0],["إِنَّ الجَمالَ يَغيبُ مِثلُ القُبحِ تَحتَ البُرقُعِ","لَكِن لِماذا تَجزَعينَ عَلى النَهارِ وَلِلدُجى",13,"ج",2,0],["إن الجمال كساك من","ورق المحاسن ماكساك",14,"ك",1,0],["إِنَّ الجَواهِرَ أَسناها وَأَكرَمُها","ما يَقذِفُ المَهدُ لا ما يَقذِفُ الزَبَدُ",15,"د",1,0],["إنّ الجزيرة في البحر المحيط لها","سور وباب وفيها غرفة الملكِ",16,"ك",1,1],["إِنَّ الجَهولَ إِذا أُلزِمتُ صُحبَتَهُ","قَسراً فَصاحَبتُهُ عَن غَيرِ إيثارِ",17,"ر",1,1],["إن الجمالَ الساحرَ الفاتنا","يا ويحه حين تغير الغضون",18,"ن",1,0],["إِنَّ الجِيادَ عَلى عِلّاتِها صُبُرٌ","ما إِن تَشَكّى الوَجا في حالَةِ الأَينِ",19,"ن",1,0],["إِنَّ الجِيادَ إِذا عَلَتها صَنعَةٌ","راقَت ذَوي الأَلبابِ وَالإِفهامِ",20,"م",1,0],["إِنَّ الجَبابِرَةِ الأُلى أَخَذوا الدُنى","أُخِذوا وَكانَ حِسابُهُم أَن يُترَكوا",21,"ك",3,0],["إِنّا لَجَأنا إِلَيهِ نَستَعينُ بِهِ","عَلى الحَوادِثِ إِذ قامَت تُناوينا",22,"ن",2,0],["إن الجبالَ التي في الأرضِ لو كفرتْ","لَدَكَّها جَبلُ الإسلامِ أو نَسَفَا",23,"ف",2,0],["إِن الجمال إِذا تجمّع شَمله","فَالوَيل كُل الوَيل للشعراءِ",24,"ا",2,0],["إنَّ الجَلالَةَ مُنْذُ رُمْتُ مَدِيحَكم","لم تَرْضَ لي ذكرَ الحِسَانِ الخُرَّدِ",25,"د",1,0],["إِنَّ الجَنابَةَ مِمَّن","جَنُبتُ مِنهُ طَهورُ",26,"ر",1,0],["إِنَّ الجَديدَينِ اللَذَينِ هُما","سِبقانِ بَذّاتي وَما بُذّا",27,"ذ",2,0],["إِنَّ الجَديدَينِ قَد جَرَّبتُ فَعلَهُما","جِنسَينِ ضِدَّيّنِ مِن نِعَمٍ وَمِن بيسِ",28,"س",1,1],["إِنَّ الجَديدَينِ ما رَثّا وَلا خَلُقا","وَلَم يَدوما عَلى نُعمى وَلا بوسِ",29,"س",1,1],["إِنَّ الجَديدَينِ ما ظَنّا وَما عَلِما","بَل طائِرانِ عَلى جَدٍّ أَحَذّانِ",30,"ن",1,0],["إِنَّ الجَماهيرَ في الآفاقِ هاتِفَةٌ","تُثني عَلَيكَ وَتَرجو عِندَكَ القُربا",31,"ب",2,0],["أن الجماعة دون الفرد معرفة","وفوقه بصروف الدهر إحساسا",32,"س",2,0],["إِنَّ الجهالة قد قَضَت","أَن يَستَكين فَلا مردّا",33,"د",2,0],["أنالَ جلالُ اليوم منك فخِلتَهُ","رُؤى يقظةٍ بل ذاك رأيُ عيانِ",34,"ن",1,0],["إن الجمال حليةُ الأقمار","ما أضيع الحسن على الأغمار",35,"ر",1,0],["إِنَّ الْجَمَالَ لَفِي الْفُؤَادِ وَإِنَّما","خَفِيَ الصَّوَابُ لأَنَّهُ لا يَظْهَرُ",36,"ر",1,0],["إنَّ الْجَمَادَ أَبَرُّ مِنْ أَرْوَاحِهِمْ","بهِمُ وَأَمْتَنُ في الدِّفَاعِ وَأَصْلَبُ",37,"ب",1,0],["إِنَّ الجُمَيِّلَ فِي الجَمَالِ وَفَنِّه","لأَدَقُّ مُبْتَدِعٍ وَخَيْرُ مُجَدِّدِ",38,"د",1,0],["إِنَّ الْجُنُودَ بِه تَلُوذُ وَتَحْتَمِي","وَلَكَمْ عُرُوش تحْتَمِي بِجُنُودِ",39,"د",1,0],["إنّ الجديدَيْنِ، اللّذيْنِ هُما","سِبْقانِ، بذّاني وما بُذّا",40,"ذ",2,0],["ان الجنون وراء نصف قصائدي","أوليس في بعض الجنون صواب ؟!",41,"ب",1,0],["ان الجهالة ان كانت قذى بصر","رأى الضلال هدى واستسمن الورما",42,"م",2,0],["ان الجمال لمسكر اصحابه","سكر الدلال وليس يعرف ذا الخلي",43,"ل",2,0],["ان الجمال اذا يشاب بخفة","وبسوء خلق لم يكن بجمال",44,"ل",1,0],["إنَّ الجزائرَ والكِفاحَ مَلاحِمي","تُروى إذا كَتَمَ اللِّسانُ سَرائري",45,"ي",1,0],["إنَّ الجزائرَ والكِفاحَ تَعاشَقا","وعَشِقْتُ ذَيْنِ العاشِقَينِ فحاذِرِ",45,"ر",1,0],["إن الجمال دواء دا","ئك فليكن منك اللصيق",46,"ق",1,0],["إِنَّ الجَلالَةَ مِن أَفعالِكَ اِنتَقَلَت","فَإِن خُصِصتَ بِأَوفاها فَلا عَجَبُ",47,"ب",1,0],["إِنَّ الجَزيرَةَ بابٌ ظَلتَ توسِعُهُ","هَزّاً وَلَم يَبقَ غَيرُ الفَتحِ فَاِرتَقِبِ",48,"ب",1,0],["إِنَّ الجَديدَينِ إِذا ما اِستَولَيا","عَلى جَديدٍ أَدنياهُ لِلبِلى",49,"ا",1,0],["إن الجواسيس حولي","في أي أرض حللت",50,"ت",1,0],["إن الجمال طعامي","وخمرتي إن ظمئت",50,"ت",1,0],["إن الجحيم وإن طالت غوائله","أخفّ من مرض يغزوك في الصغر",51,"ر",1,0],["إن الجمال هو الكما","ل وليس مازان الظباء",52,"ا",2,0],["ان الجزيرة لا عدا","جوديها الجود الهتون",53,"ن",1,0],["إن الجواهرَ عندَ الجوهريِّ غَلت","وليسَ يَعلمُ ما تَسواه نحّاس",54,"س",1,0],["إنَّ الجزيرة أصبَحت مَفتوحة","ومشاعِرُ الحرَمينِ لا تشتام",55,"م",1,0],["إن الجمال به عزاءُ الأنفُسِ","فافْدِ المَلِمَّةَ بالأعزِّ الأنفَسِ",56,"س",1,1],["إن الجفا والبعد قد عناني","وحل بي منه الذي كفاني",57,"ي",1,0],["إِنّ الجوادَ لئن ينال بجودهِ","راجيه أسرع من نسيم منبرِ",58,"ر",1,0],["إنّ الجِنانَ هَدِيٌّ أنت خاطبُها","ومَهْرُها عَمَلٌ من عامِلٍ زاك",59,"ك",1,0],["إِنّ الجمالَ معادنٌ","وَمَنَاقبٌ أَورَثنَ مَجدا",60,"د",2,0],["إِن الجُنون هُوَ الهَوى","أَفعاقِلٌ مَن عَنَفا",61,"ف",2,0],["أنَّ الجنان زُخْرِفَتْ","لِمَعْشَر الزيديَّهْ",62,"ه",1,0],["إنَّ الجَهولَ تَضرُّني أخلاقه","ضررُ السُّعالِ بِمَنْ بهِ اسْتِسقاءُ",63,"ا",2,0],["إِنَّ الجَوادَ اِبنَ يَحيى الفَضلَ لا وَرِقٌ","يَبقى عَلى جودِ كَفَّيهِ وَلا ذَهَبُ",64,"ب",1,0],["إنَّ الجميلَ وأهْلَه ومحلَّه","وأبو الجميل ابن الجميل محمد",65,"د",1,0],["إنَّ الجهاد على الروافض لازمٌ","ويثاب فاعله عليه ويؤجر",66,"ر",1,0],["إن الجميل إذا تحكم بالجما","ل فما ظلم",67,"م",1,0],["إن الجماعة بالزعيم فلو هفت","قدم له لهفا الجَميع وضوعا",68,"ع",2,0],["إنَّ الجحاجح من قُريشٍ أدركوا","شَرَفاً تُقِرُّ بفضلهِ الأعْداءُ",69,"ا",2,0],["أنَّ الجديدين استمالا ناظري","عن لذَّةٍ يصيبه حسنُ جديدها",70,"د",3,0],["إنَّ الجنونَ وقد رآكَ أَباً لهُ","ما زال يمنحُني هُوِيَّةَ نَجْلِهِ",71,"ل",2,0],["إنّ الجيوش بلا عميدٍ بعده","فَوْضى كسِيد الدَّوِّ راع سَواما",72,"م",2,0],["ان الجمادات خير من ذوي خطر","في قصة الجذع تلميح بجهلهم",73,"م",1,0],["إن الجميع حدود في العقول وفي","مراتب الحسن قد زادت على العددِ",74,"د",1,1],["إنَّ الجِبالَ تَهُزُّهُنَّ زلازلٌ","لكن سيعقُبها سُكونٌ لازمُ",75,"م",1,0],["إنَّ الجميلَ قليلٌ عَزَّ مَطلَبُهُ","من كُلِّ ما تَشتهيهِ العينُ والأُذُنُ",76,"ن",1,0],["إِنَّ الجَدِيْدَ إِذَا ما زِيْدَ فِي خَلَقِ","تَبَيَّنَ النَّاسُ أَنَّ الثَّوْبَ مَرْقُوعُ",77,"ع",1,0]]}