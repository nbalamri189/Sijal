{"poems":[[53,"أبا هرم أنحها إنني","https://www.aldiwan.net/poem29792.html","المتقارب"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[6,"نحن من عامر بن ذبيان","https://www.aldiwan.net/poem379.html",""],[35,"أتاني ودوني بطن غول ودونه","https://www.aldiwan.net/poem39167.html","الطويل"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[54,"إن زرته ألفيته متبذلا","https://www.aldiwan.net/poem27530.html","الكامل"],[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[23,"ونبئت أن أبا منذر","https://www.aldiwan.net/poem21587.html","المتقارب"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"قذفك بالفحشاء من لم يكن","https://www.aldiwan.net/poem65969.html","السريع"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[85,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[87,"أول النفس نطفة أخلصتها","https://www.aldiwan.net/poem8226.html","الخفيف"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[105,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[105,"الله أكبر جل الخطب واحتكمت","https://www.aldiwan.net/poem43158.html","البسيط"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67301","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""]],"verses":[["قَذَفتُكَ في التيهِ مِن بَعدِ ما","سَلَكتُ بِكَ السَنَنَ الأَقوَما",0,"م",2,0],["قَذِيَت لَهُ مُقَلُ السَماحِ وَقَد شَكا","وَهَوَت لَهُ قُلَلُ العَلاءِ وَقَد نُعي",1,"ع",2,0],["قَذى المَآقي لَبِدُ العَناصي","في مُطلَقٍ أَنجُمُهُ شَواصي",2,"ي",1,0],["قَذَفوكَ في غَمّائِها وَتَباعَدوا","عَنها وَقالوا قُم لِنَفسِكَ وَاِقعُدِ",3,"د",1,0],["قَذَفَتكَ الأَيّامُ بِالحَدَثِ الأَك","بَرِ مِنها وَشابَ رَأسُ الصَغيرِ",4,"ر",1,0],["قَذيتُ بِها وَالعينُ سهوٌ دمُوعُها","وَعُوّارُها في باطِنِ الجَفنِ زائدُ",5,"د",1,0],["قَذىً بِعَينِكِ أَم بِالعَينِ عُوّارُ","أَم ذَرَفَت إِذ خَلَت مِن أَهلِها الدارُ",6,"ر",1,1],["قَذَفَت بِهِ الغَرَضَ البَعيدَ مِنَ العُلا","هِمَمٌ تَرَكنَ طَريقَهُ مَتبوعا",7,"ع",2,0],["قَذوفٍ بِعَينَيها إِذا اِسوَدَّ غَرضُها","جَؤوبِ المَوامي حينَ يَدمى نَقيلُها",8,"ل",3,0],["قَذوفٌ بِأَعناقِ المَراسيلِ خَلفَها","إِذا السَربَخُ المَعقُ اِرتَمى بِالنَجائِبِ",9,"ب",1,0],["قذفت بحورُ الفكر منها جوهراً","لما وصفت أناملاً ببحارِ",10,"ر",1,0],["قَذالُكَ أَحسَنُ مِن وَجهِهِ","وَأُمُّكَ خَيرٌ مِنَ المُنذِرِ",11,"ر",1,0],["قَذَعٌ إذا سَفَعَ الحدي","دَ سعيرُ أيسرِه أَذابهْ",12,"ب",2,0],["قذفُكَ بالفحشاءِ مَنْ لم يكنْ","يُعرَفُ بالفحشاءِ تضليلُ",13,"ل",1,1],["قذوفُ النَّوى جوابةُ الأرض لا تَني","تُقَلْقلُ في أنجادها والتهائمِ",14,"م",1,0],["قُذُفَ الغُدُوِّ إِذا غَدَونَ لِحاجَةٍ","دُلُفَ الرَواحِ إِذا أَرَدنَ قُفولا",15,"ل",2,0],["قَذَفَت هَهُنا زَئيراً وَناباً","وَرَمَت هَهُنا عُواءٌ وَظُفرا",16,"ر",2,0],["قَذَفتَهُم بِالرِياحِ الهوجِ مُسرَجَةً","يَحمِلنَ أُسدَ الشَرى في البَيضِ وَاليَلَبِ",17,"ب",1,0],["قَذائِفُ تَخشى مُهجَةُ الشَمسِ كُلَّما","عَلَت مُصعِداتٍ أَنَّها لا تُصَوَّبُ",18,"ب",1,0],["قذفت بالبدور عنك ظهورُ ال","بُدن قذف القسِيِّ بالنُشاب",19,"ب",1,0],["قَذَفَت بِمَن فيها إِلَيكَ كَأَنَّما","عَلَّمتَها مِن راحَتَيكَ الجودا",20,"د",2,0],["قَذَفَتْ حَبّةَ قَلبي في الهَوى","هَل رَأَيتَ الجَمرَ في المُفتَأَدِ",21,"د",1,0],["قُذِعتُمُ فَمَشَيتُم مَشيَةً أُمَماً","كَذاكَ يَحسُنُ مَشيُ الخَيلِ في اللُجُمِ",22,"م",1,0],["قَذَفَتْهَا إِلَى الْبُطُونِ ظُهُورٌ","وَحَوَتْهَا بَعْدَ الظُّهُورِ بُطُونُ",23,"ن",1,0],["قذوف بالمنازل ما يبالي","تناهى الوجد أم بلغ العذاب",24,"ب",1,0],["قذف الغرورُ بها إلى أوطانِه","بطلاً يصونُ محارمَ الأوطانِ",25,"ن",1,0],["قَذفَ المُغيرُ بها يُحاولُ مأرباً","كذبَ المُغيرُ لقد أراد مُحالا",26,"ل",2,0],["قَذَفَت بِهِ دارُ الجِهادِ إِلى الَّتي","ما بَعدَها لِمُجاهِدٍ مِن دارِ",27,"ر",1,0],["قَذائِفُ مِلءَ الجَوِّ يَرمي حِثاثَها","مِنَ الحَتفِ ذي الأَهوالِ رامٍ مُسَدَّدُ",28,"د",1,0],["قَذّافَةٌ بِالمَنايا الحُمرِ صارِخَةً","مِلءَ الفجاجَ حِثاثاً ما بِها مَهلُ",29,"ل",1,0],["قَذَفَت بِهِ المَرمى البَعيدَ صَريمَةٌ","تَهفو نَوازِعُها بِأَبلَجَ أَمجَدِ",30,"د",1,0],["قَذَفَت بِهانوتو فَطاحَ بَهبوَةٍ","تَرمِي بِأَبطالِ الرِجالِ وَتقذفُ",31,"ف",1,0],["قذَفتْ قُرطها بَعيداً ورضّتْ","من وُجوهِ النبيِّ وَجهاً نضيرا",32,"ر",2,0],["قَذَفَتْ به أَيْدِي النَّوَى مِنْ حالِقٍ","سامِي المَحَلِّ إلى الحَضيضِ الأوهَدِ",33,"د",1,0],["قذفوه في هوةٍ ليس منها","مخرجٌ للمقذوف فهي قَعور",34,"ر",1,0],["قذفت به عنها وغودر جيشه","بددا تعقّبه الخوف وحوبها",35,"ب",3,0],["قذفوا به غَضب السرائر فانظروا","للحصن يسقط في يديْ ثُوَّارِهِ",36,"ر",2,0],["قَذَفْنا في السَّوَابغِ كلَّ صَقْرٍ","كريمٍ غيرِ مُعْتَلِثِ الزِّنادِ",37,"د",1,0],["قذفوا السلاحَ فصبّه أعداؤُهم","غُلاً فكاد حديدهُ يُرْديك",38,"ك",1,0],["قَذَفَ الكُتْبَ بهَا طَاغِيَةٌ","هَلْ دَرَى ما كَنَزَتْه دَفَّتاها",39,"ا",3,0],["قذفوا «النيازك» في الفضاء، فخلتها","مشبوبةً من عزمه الوقاد",40,"د",1,0],["قذَف الأرضَ باللظى، وتولى","في حمى الجو آمنًا أن يُصابا",41,"ب",2,0],["قُذِفتْ خِيفة ُ الملامة منه","في فؤادٍ مشيَّع كلَّ قذف",42,"ف",1,0]]}