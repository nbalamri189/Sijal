{"poems":[[55,"أبا هرم أنحها إنني","https://www.aldiwan.net/poem29792.html","المتقارب"],[55,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[55,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[55,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[6,"نحن من عامر بن ذبيان","https://www.aldiwan.net/poem379.html",""],[37,"أتاني ودوني بطن غول ودونه","https://www.aldiwan.net/poem39167.html","الطويل"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[56,"إن زرته ألفيته متبذلا","https://www.aldiwan.net/poem27530.html","الكامل"],[32,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[32,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[23,"ونبئت أن أبا منذر","https://www.aldiwan.net/poem21587.html","المتقارب"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"قذفك بالفحشاء من لم يكن","https://www.aldiwan.net/poem65969.html","السريع"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[87,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[68,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[82,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[46,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[89,"أول النفس نطفة أخلصتها","https://www.aldiwan.net/poem8226.html","الخفيف"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[107,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[107,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[107,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[107,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[107,"الله أكبر جل الخطب واحتكمت","https://www.aldiwan.net/poem43158.html","البسيط"],[107,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[107,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29335","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67301","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[108,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[135,"قذف الشرق من بلاد الحياض","https://www.aldiwan.net/poem54808.html","الخفيف"],[145,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[153,"قفوا فاسألوني اليوم عن لوعة الهوى","https://www.aldiwan.net/poem68556.html","الطويل"],[169,"بعت عبدا كان لي سكنا","https://www.aldiwan.net/poem46846.html","المديد"],[226,"أطبق جناحيك معقودا لك الظفر","https://www.aldiwan.net/poem39690.html","البسيط"],[226,"مغناك ملتهب وكأسك مترعه","https://www.aldiwan.net/poem41598.html","الكامل"],[238,"يا خير منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[238,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[308,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[331,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[340,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[365,"غضب التراب","https://www.aldiwan.net/poem11592.html","عموديه"],[366,"صحا قلبه وأقصر اليوم باطله","https://www.aldiwan.net/poem1724.html","الطويل"],[369,"هذا عذاب لا يفتر","https://www.aldiwan.net/poem16991.html","مجزوء الكامل"],[419,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[419,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[463,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[507,"نسوة الحيّ الشرقيّ","https://www.aldiwan.net/poem27890.html","الخفيف"],[516,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[517,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[553,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[555,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[560,"كلنا بالتخصيص والتعميم","https://www.aldiwan.net/poem33852.html","الخفيف"],[560,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[759,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[957,"","https://poetry.dctabudhabi.ae/diwan/poem/200295","الكامل"],[1094,"نعى ناعياً ليلى عشياً فراعني","https://www.poetsgate.com/ViewPoem.aspx?id=186543",""]],"verses":[["قَذَفتُكَ في التيهِ مِن بَعدِ ما","سَلَكتُ بِكَ السَنَنَ الأَقوَما",0,"م",2,0],["قَذِيَت لَهُ مُقَلُ السَماحِ وَقَد شَكا","وَهَوَت لَهُ قُلَلُ العَلاءِ وَقَد نُعي",1,"ع",2,0],["قَذى المَآقي لَبِدُ العَناصي","في مُطلَقٍ أَنجُمُهُ شَواصي",2,"ص",2,0],["قَذَفوكَ في غَمّائِها وَتَباعَدوا","عَنها وَقالوا قُم لِنَفسِكَ وَاِقعُدِ",3,"د",1,0],["قَذَفَتكَ الأَيّامُ بِالحَدَثِ الأَك","بَرِ مِنها وَشابَ رَأسُ الصَغيرِ",4,"ر",1,0],["قَذيتُ بِها وَالعينُ سهوٌ دمُوعُها","وَعُوّارُها في باطِنِ الجَفنِ زائدُ",5,"د",1,0],["قَذىً بِعَينِكِ أَم بِالعَينِ عُوّارُ","أَم ذَرَفَت إِذ خَلَت مِن أَهلِها الدارُ",6,"ر",1,1],["قَذَفَت بِهِ الغَرَضَ البَعيدَ مِنَ العُلا","هِمَمٌ تَرَكنَ طَريقَهُ مَتبوعا",7,"ع",2,0],["قَذوفٍ بِعَينَيها إِذا اِسوَدَّ غَرضُها","جَؤوبِ المَوامي حينَ يَدمى نَقيلُها",8,"ل",3,0],["قَذوفٌ بِأَعناقِ المَراسيلِ خَلفَها","إِذا السَربَخُ المَعقُ اِرتَمى بِالنَجائِبِ",9,"ب",1,0],["قذفت بحورُ الفكر منها جوهراً","لما وصفت أناملاً ببحارِ",10,"ر",1,0],["قَذالُكَ أَحسَنُ مِن وَجهِهِ","وَأُمُّكَ خَيرٌ مِنَ المُنذِرِ",11,"ر",1,0],["قَذَعٌ إذا سَفَعَ الحدي","دَ سعيرُ أيسرِه أَذابهْ",12,"ب",2,0],["قذفُكَ بالفحشاءِ مَنْ لم يكنْ","يُعرَفُ بالفحشاءِ تضليلُ",13,"ل",1,1],["قذوفُ النَّوى جوابةُ الأرض لا تَني","تُقَلْقلُ في أنجادها والتهائمِ",14,"م",1,0],["قُذُفَ الغُدُوِّ إِذا غَدَونَ لِحاجَةٍ","دُلُفَ الرَواحِ إِذا أَرَدنَ قُفولا",15,"ل",2,0],["قَذَفَت هَهُنا زَئيراً وَناباً","وَرَمَت هَهُنا عُواءٌ وَظُفرا",16,"ر",2,0],["قَذَفتَهُم بِالرِياحِ الهوجِ مُسرَجَةً","يَحمِلنَ أُسدَ الشَرى في البَيضِ وَاليَلَبِ",17,"ب",1,0],["قَذائِفُ تَخشى مُهجَةُ الشَمسِ كُلَّما","عَلَت مُصعِداتٍ أَنَّها لا تُصَوَّبُ",18,"ب",1,0],["قذفت بالبدور عنك ظهورُ ال","بُدن قذف القسِيِّ بالنُشاب",19,"ب",1,0],["قَذَفَت بِمَن فيها إِلَيكَ كَأَنَّما","عَلَّمتَها مِن راحَتَيكَ الجودا",20,"د",2,0],["قَذَفَتْ حَبّةَ قَلبي في الهَوى","هَل رَأَيتَ الجَمرَ في المُفتَأَدِ",21,"د",1,0],["قُذِعتُمُ فَمَشَيتُم مَشيَةً أُمَماً","كَذاكَ يَحسُنُ مَشيُ الخَيلِ في اللُجُمِ",22,"م",1,0],["قَذَفَتْهَا إِلَى الْبُطُونِ ظُهُورٌ","وَحَوَتْهَا بَعْدَ الظُّهُورِ بُطُونُ",23,"ن",1,0],["قذوف بالمنازل ما يبالي","تناهى الوجد أم بلغ العذاب",24,"ب",1,0],["قذف الغرورُ بها إلى أوطانِه","بطلاً يصونُ محارمَ الأوطانِ",25,"ن",1,0],["قَذفَ المُغيرُ بها يُحاولُ مأرباً","كذبَ المُغيرُ لقد أراد مُحالا",26,"ل",2,0],["قَذَفَت بِهِ دارُ الجِهادِ إِلى الَّتي","ما بَعدَها لِمُجاهِدٍ مِن دارِ",27,"ر",1,0],["قَذائِفُ مِلءَ الجَوِّ يَرمي حِثاثَها","مِنَ الحَتفِ ذي الأَهوالِ رامٍ مُسَدَّدُ",28,"د",1,0],["قَذّافَةٌ بِالمَنايا الحُمرِ صارِخَةً","مِلءَ الفجاجَ حِثاثاً ما بِها مَهلُ",29,"ل",1,0],["قَذَفَت بِهِ المَرمى البَعيدَ صَريمَةٌ","تَهفو نَوازِعُها بِأَبلَجَ أَمجَدِ",30,"د",1,0],["قَذَفَت بِهانوتو فَطاحَ بَهبوَةٍ","تَرمِي بِأَبطالِ الرِجالِ وَتقذفُ",31,"ف",1,0],["قذَفتْ قُرطها بَعيداً ورضّتْ","من وُجوهِ النبيِّ وَجهاً نضيرا",32,"ر",2,0],["قَذَفَتْ به أَيْدِي النَّوَى مِنْ حالِقٍ","سامِي المَحَلِّ إلى الحَضيضِ الأوهَدِ",33,"د",1,0],["قذيفة شيطان رجيم رمى بها","فصارت ضواة في لهازم ضرزم",34,"م",1,0],["قذفوه في هوةٍ ليس منها","مخرجٌ للمقذوف فهي قَعور",35,"ر",1,0],["قذفت به عنها وغودر جيشه","بددا تعقّبه الخوف وحوبها",36,"ب",3,0],["قذفوا به غَضب السرائر فانظروا","للحصن يسقط في يديْ ثُوَّارِهِ",37,"ر",2,0],["قَذَفْنا في السَّوَابغِ كلَّ صَقْرٍ","كريمٍ غيرِ مُعْتَلِثِ الزِّنادِ",38,"د",1,0],["قذفوا السلاحَ فصبّه أعداؤُهم","غُلاً فكاد حديدهُ يُرْديك",39,"ك",1,0],["قَذَفَ الكُتْبَ بهَا طَاغِيَةٌ","هَلْ دَرَى ما كَنَزَتْه دَفَّتاها",40,"ا",3,0],["قذفوا «النيازك» في الفضاء، فخلتها","مشبوبةً من عزمه الوقاد",41,"د",1,0],["قذَف الأرضَ باللظى، وتولى","في حمى الجو آمنًا أن يُصابا",42,"ب",2,0],["قُذِفتْ خِيفة ُ الملامة منه","في فؤادٍ مشيَّع كلَّ قذف",43,"ف",1,0],["قَذَفَ الشَّرقُ مِن بِلاَدِ الحِيَاضِ","بِخِضمٍّ غَطمطَمٍ فَيَّاضِ",44,"ض",1,1],["قذفتْ منه الليالي بِقرنٍ","تنكُص ألأبطالُ عنه انتكاصا",45,"ص",2,0],["قَذَفتُ بِنَفسي فِي بِحارِ مَحَبَّةٍ","تَغَرُّ ظُنونَ السَّابحينَ فَتُغرِقُ",46,"ق",1,0],["قذيتْ عيني مُذ قذيتْ","عينُ مِيزانِي من ثَمَنِهْ",47,"ن",2,0],["قَذائِفٌ لَن يُرى فَجرُ النسورِ عَلى","أَحلامِها البيضِ إِلّا حينَ تَنفَجِرُ",48,"ر",1,0],["قَذفتك صحراءُ الزِنى بِحَضارَة","ثَكلى مُشَوَّهَةِ الوُجوهِ مُفَجَّعَه",49,"ع",2,0],["قُذِفوا بِشُهبٍ مِن سُطاكَ ثَواقِبٍ","شَبَّت عَلَيهِم مِن وَرا وَأَمامِ",50,"م",1,0],["قَذَفتَهُمُ بِالرُعبِ في كُلِّ مَسلَكٍ","فَكُلُّ سَبيلٍ أَمَّ رائِدُهُم وَعرُ",51,"ر",1,0],["قذفَت عَلى الأدباءِ منه صواعقٌ","لِقلوبِها فمصقّع ومصدّعُ",52,"ع",1,0],["قَذَفَتني الغيوب بالرغم منّي","في عُباب من الحوادث طام",53,"م",1,0],["قَذوفٌ إِذا ما خالَطَ الظَبيَ سَهمُها","وَإِن ريغَ مِنها أَسلَمَتهُ النَواقِزُ",54,"ز",1,0],["قذفوا إلى لجج البحار برايتي","فمضت شراعًا غالَبَ الإعصارا",55,"ر",2,1],["قَذَفنَ بِفي مَن ساءَهُنَ بِصَخرَةٍ","وَذُمَّ نَجيلُ الرُمَّتَينِ وَناصِلُه",56,"ل",2,0],["قَذَفوهُ في نِسيانِهِم","حَتّى وَلا بِالسوءِ يُذكَر",57,"ر",1,0],["قَذَفَتْ أنجُمُها كأسَ الطلا","كلّ شيطانٍ من الهمِّ مريد",58,"د",1,0],["قذفتها بالنوى أيدي السّرى","في مواميها عراقاً وشآما",59,"م",2,0],["قذفت به في لهوة الموت مُهجةً","ترى كل شيءٍ ما خلا العمر فانيا",60,"ي",2,0],["قذفتْ أحلاهنَّ سحراً بعيني","فأصابَ منها غطاها فشلَّهْ",61,"ل",2,0],["قذَفْتَهُمُ بشُهْبٍ من حديدٍ","وأقْمارٍ سَواءٍ في الكَمالِ",62,"ل",1,0],["قذفت نوى قذفت بنا عن أرضه","فغدا قريب الصبر عنه بعيدا",63,"د",2,0],["قذفتُ جميلاً كان بيني وبينه","وإنْ كنتُ ذا ضنٍّ به في القواذفِ",64,"ف",1,0],["قَذَفَت بِهِ الأَيّامُ بَينَ قَوارِعٍ","تَأتي بِهِنَّ حَوادِثٌ وَخُطوبُ",65,"ب",1,0],["قذفتنا نواظر العشق لما","أن رأونا أسرى لواحظ ريم",66,"م",1,0],["قذفتهم عنها بوهم حلولٍ","صوَّروه بهم ووهم اتحاد",67,"د",1,0],["قَذفَكَ بالقِدحِ من الساسَم ال","أَجرَد قِدحَ الصَنع المُغتَلي",68,"ل",2,0],["قَذَفُوا الرِّمَاحَ وَبَاشَرُوا بِنُحُورِهِمْ","عِنْدَ الضِّرَابِ بِكُلِّ لَيْثٍ ضَيْغَمِ",69,"م",1,0],["قذفن بها لا عن هوى من أقارب","ولا عن رضا منا كذاك البوائق",70,"ق",1,0]]}