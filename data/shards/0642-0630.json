gate.com/ViewPoem.aspx?id=192266",""],[5351,"ماذا هناك","https://www.poetsgate.com/ViewPoem.aspx?id=202284",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5409,"هكذا من حقه من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5431,"شغوفٌ كما قلبي..","https://www.poetsgate.com/ViewPoem.aspx?id=190343",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5459,"الصديقة","https://www.poetsgate.com/ViewPoem.aspx?id=190904",""],[5720,"عاصِفةُ الحَزْم","https://www.poetsgate.com/ViewPoem.aspx?id=199941",""],[5725,"ولجارتي عتب عليّ","https://www.poetsgate.com/ViewPoem.aspx?id=192275",""],[5759,"غيا يتوب فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=213396",""],[5770,"ليلة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=178358",""],[3976,"نعى ناعياً ليلى عشياً فراعني","https://www.poetsgate.com/ViewPoem.aspx?id=186543",""],[5956,"الرَّفْضُ السَّلْبِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=183335",""],[6102,"كُرَةُ النَّدَم !!","https://www.poetsgate.com/ViewPoem.aspx?id=186288",""],[199,"غَشِيْتُ بِعِفْرَى أو بِرِجْلَتِهَا رَبْعاً","https://www.poetsgate.com/ViewPoem.aspx?id=22422",""],[3057,"من رقص مذبوح وأن كظيم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=593856",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["قَذَفتُكَ في التيهِ مِن بَعدِ ما","سَلَكتُ بِكَ السَنَنَ الأَقوَما",0,"م",2,0],["قَذِيَت لَهُ مُقَلُ السَماحِ وَقَد شَكا","وَهَوَت لَهُ قُلَلُ العَلاءِ وَقَد نُعي",1,"ع",2,0],["قَذى المَآقي لَبِدُ العَناصي","في مُطلَقٍ أَنجُمُهُ شَواصي",2,"ص",2,0],["قَذَفوكَ في غَمّائِها وَتَباعَدوا","عَنها وَقالوا قُم لِنَفسِكَ وَاِقعُدِ",3,"د",1,0],["قَذَفَتكَ الأَيّامُ بِالحَدَثِ الأَك","بَرِ مِنها وَشابَ رَأسُ الصَغيرِ",4,"ر",1,0],["قَذيتُ بِها وَالعينُ سهوٌ دمُوعُها","وَعُوّارُها في باطِنِ الجَفنِ زائدُ",5,"د",1,0],["قَذىً بِعَينِكِ أَم بِالعَينِ عُوّارُ","أَم ذَرَفَت إِذ خَلَت مِن أَهلِها الدارُ",6,"ر",1,1],["قَذَفَت بِهِ الغَرَضَ البَعيدَ مِنَ العُلا","هِمَمٌ تَرَكنَ طَريقَهُ مَتبوعا",7,"ع",2,0],["قَذوفٍ بِعَينَيها إِذا اِسوَدَّ غَرضُها","جَؤوبِ المَوامي حينَ يَدمى نَقيلُها",8,"ل",3,0],["قَذوفٌ بِأَعناقِ المَراسيلِ خَلفَها","إِذا السَربَخُ المَعقُ اِرتَمى بِالنَجائِبِ",9,"ب",1,0],["قذفت بحورُ الفكر منها جوهراً","لما وصفت أناملاً ببحارِ",10,"ر",1,0],["قَذالُكَ أَحسَنُ مِن وَجهِهِ","وَأُمُّكَ خَيرٌ مِنَ المُنذِرِ",11,"ر",1,0],["قَذَعٌ إذا سَفَعَ الحدي","دَ سعيرُ أيسرِه أَذابهْ",12,"ب",2,0],["قذفُكَ بالفحشاءِ مَنْ لم يكنْ","يُعرَفُ بالفحشاءِ تضليلُ",13,"ل",1,1],["قذوفُ النَّوى جوابةُ الأرض لا تَني","تُقَلْقلُ في أنجادها والتهائمِ",14,"م",1,0],["قُذُفَ الغُدُوِّ إِذا غَدَونَ لِحاجَةٍ","دُلُفَ الرَواحِ إِذا أَرَدنَ قُفولا",15,"ل",2,0],["قَذَفَت هَهُنا زَئيراً وَناباً","وَرَمَت هَهُنا عُواءٌ وَظُفرا",16,"ر",2,0],["قَذَفتَهُم بِالرِياحِ الهوجِ مُسرَجَةً","يَحمِلنَ أُسدَ الشَرى في البَيضِ وَاليَلَبِ",17,"ب",1,0],["قَذائِفُ تَخشى مُهجَةُ الشَمسِ كُلَّما","عَلَت مُصعِداتٍ أَنَّها لا تُصَوَّبُ",18,"ب",1,0],["قذفت بالبدور عنك ظهورُ ال","بُدن قذف القسِيِّ بالنُشاب",19,"ب",1,0],["قَذَفَت بِمَن فيها إِلَيكَ كَأَنَّما","عَلَّمتَها مِن راحَتَيكَ الجودا",20,"د",2,0],["قَذَفَتْ حَبّةَ قَلبي في الهَوى","هَل رَأَيتَ الجَمرَ في المُفتَأَدِ",21,"د",1,0],["قُذِعتُمُ فَمَشَيتُم مَشيَةً أُمَماً","كَذاكَ يَحسُنُ مَشيُ الخَيلِ في اللُجُمِ",22,"م",1,0],["قَذَفَتْهَا إِلَى الْبُطُونِ ظُهُورٌ","وَحَوَتْهَا بَعْدَ الظُّهُورِ بُطُونُ",23,"ن",1,0],["قذوف بالمنازل ما يبالي","تناهى الوجد أم بلغ العذاب",24,"ب",1,0],["قذف الغرورُ بها إلى أوطانِه","بطلاً يصونُ محارمَ الأوطانِ",25,"ن",1,0],["قَذفَ المُغيرُ بها يُحاولُ مأرباً","كذبَ المُغيرُ لقد أراد مُحالا",26,"ل",2,0],["قَذَفَت بِهِ دارُ الجِهادِ إِلى الَّتي","ما بَعدَها لِمُجاهِدٍ مِن دارِ",27,"ر",1,0],["قَذائِفُ مِلءَ الجَوِّ يَرمي حِثاثَها","مِنَ الحَتفِ ذي الأَهوالِ رامٍ مُسَدَّدُ",28,"د",1,0],["قَذّافَةٌ بِالمَنايا الحُمرِ صارِخَةً","مِلءَ الفجاجَ حِثاثاً ما بِها مَهلُ",29,"ل",1,0],["قَذَفَت بِهِ المَرمى البَعيدَ صَريمَةٌ","تَهفو نَوازِعُها بِأَبلَجَ أَمجَدِ",30,"د",1,0],["قَذَفَت بِهانوتو فَطاحَ بَهبوَةٍ","تَرمِي بِأَبطالِ الرِجالِ وَتقذفُ",31,"ف",1,0],["قذَفتْ قُرطها بَعيداً ورضّتْ","من وُجوهِ النبيِّ وَجهاً نضيرا",32,"ر",2,0],["قَذَفَتْ به أَيْدِي النَّوَى مِنْ حالِقٍ","سامِي المَحَلِّ إلى الحَضيضِ الأوهَدِ",33,"د",1,0],["قذيفة شيطان رجيم رمى بها","فصارت ضواة في لهازم ضرزم",34,"م",1,0],["قذفوه في هوةٍ ليس منها","مخرجٌ للمقذوف فهي قَعور",35,"ر",1,0],["قذفت به عنها وغودر جيشه","بددا تعقّبه الخوف وحوبها",36,"ب",3,0],["قذفوا به غَضب السرائر فانظروا","للحصن يسقط في يديْ ثُوَّارِهِ",37,"ر",2,0],["قَذَفْنا في السَّوَابغِ كلَّ صَقْرٍ","كريمٍ غيرِ مُعْتَلِثِ الزِّنادِ",38,"د",1,0],["قذفوا السلاحَ فصبّه أعداؤُهم","غُلاً فكاد حديدهُ يُرْديك",39,"ك",1,0],["قَذَفَ الكُتْبَ بهَا طَاغِيَةٌ","هَلْ دَرَى ما كَنَزَتْه دَفَّتاها",40,"ا",3,0],["قذفوا «النيازك» في الفضاء، فخلتها","مشبوبةً من عزمه الوقاد",41,"د",1,0],["قذَف الأرضَ باللظى، وتولى","في حمى الجو آمنًا أن يُصابا",42,"ب",2,0],["قُذِفتْ خِيفة ُ الملامة منه","في فؤادٍ مشيَّع كلَّ قذف",43,"ف",1,0],["قَذَفَ الشَّرقُ مِن بِلاَدِ الحِيَاضِ","بِخِضمٍّ غَطمطَمٍ فَيَّاضِ",44,"ض",1,1],["قذفتْ منه الليالي بِقرنٍ","تنكُص ألأبطالُ عنه انتكاصا",45,"ص",2,0],["قَذَفتُ بِنَفسي فِي بِحارِ مَحَبَّةٍ","تَغَرُّ ظُنونَ السَّابحينَ فَتُغرِقُ",46,"ق",1,0],["قذيتْ عيني مُذ قذيتْ","عينُ مِيزانِي من ثَمَنِهْ",47,"ن",2,0],["قَذائِفٌ لَن يُرى فَجرُ النسورِ عَلى","أَحلامِها البيضِ إِلّا حينَ تَنفَجِرُ",48,"ر",1,0],["قَذفتك صحراءُ الزِنى بِحَضارَة","ثَكلى مُشَوَّهَةِ الوُجوهِ مُفَجَّعَه",49,"ع",2,0],["قُذِفوا بِشُهبٍ مِن سُطاكَ ثَواقِبٍ","شَبَّت عَلَيهِم مِن وَرا وَأَمامِ",50,"م",1,0],["قَذَفتَهُمُ بِالرُعبِ في كُلِّ مَسلَكٍ","فَكُلُّ سَبيلٍ أَمَّ رائِدُهُم وَعرُ",51,"ر",1,0],["قذفَت عَلى الأدباءِ منه صواعقٌ","لِقلوبِها فمصقّع ومصدّعُ",52,"ع",1,0],["قَذَفَتني الغيوب بالرغم منّي","في عُباب من الحوادث طام",53,"م",1,0],["قَذوفٌ إِذا ما خالَطَ الظَبيَ سَهمُها","وَإِن ريغَ مِنها أَسلَمَتهُ النَواقِزُ",54,"ز",1,0],["قذفوا إلى لجج البحار برايتي","فمضت شراعًا غالَبَ الإعصارا",55,"ر",2,1],["قَذَفنَ بِفي مَن ساءَهُنَ بِصَخرَةٍ","وَذُمَّ نَجيلُ الرُمَّتَينِ وَناصِلُه",56,"ل",2,0],["قَذَفوهُ في نِسيانِهِم","حَتّى وَلا بِالسوءِ يُذكَر",57,"ر",1,0],["قَذَفَتْ أنجُمُها كأسَ الطلا","كلّ شيطانٍ من الهمِّ مريد",58,"د",1,0],["قذفتها بالنوى أيدي السّرى","في مواميها عراقاً وشآما",59,"م",2,0],["قذفت به في لهوة الموت مُهجةً","ترى كل شيءٍ ما خلا العمر فانيا",60,"ي",2,0],["قذفتْ أحلاهنَّ سحراً بعيني","فأصابَ منها غطاها فشلَّهْ",61,"ل",2,0],["قذَفْتَهُمُ بشُهْبٍ من حديدٍ","وأقْمارٍ سَواءٍ في الكَمالِ",62,"ل",1,0],["قذفت نوى قذفت بنا عن أرضه","فغدا قريب الصبر عنه بعيدا",63,"د",2,0],["قذفتُ جميلاً كان بيني وبينه","وإنْ كنتُ ذا ضنٍّ به في القواذفِ",64,"ف",1,0],["قَذَفَت بِهِ الأَيّامُ بَينَ قَوارِعٍ","تَأتي بِهِنَّ حَوادِثٌ وَخُطوبُ",65,"ب",1,0],["قذفتنا نواظر العشق لما","أن رأونا أسرى لواحظ ريم",66,"م",1,0],["قذفتهم عنها بوهم حلولٍ","صوَّروه بهم ووهم اتحاد",67,"د",1,0],["قَذَفَت بِها غَربُ النَوى","فَعَسى تَكونُ لَنا مَريرَه",68,"ر",2,0],["قذيت جفوني بعدهم","فغدت تعثر في الدموع",69,"ع",1,0],["قذفت لكم سهم الولا","وبقلب حاسدكم نفد",70,"د",1,0],["قَذَفَتْ بي الخطوبُ في لُجَج البح","ر فَطوراً أطفُو وطَوراً أغوص",71,"ص",1,0],["قذفت به من شاهق","أيدي امتحانك وابتلائك",72,"ك",1,0],["قذفَ البحرُ لؤلؤاً ولجينا","لخليلٍ قد قرَّ صدْراً وعينا",73,"ن",2,1],["قِذافٍ بذاتِ الواحٍ تراها","ولا يرجو بها القومُ اضطجاعا",74,"ع",2,0],["قذارة الإِنسان","يا عرس العقبان",75,"ن",1,0],["قَذْفاً بِمِرْجامِ الرِجام الأَرْكَنِ","مِنْ سُمْرِ صَيّاحِ الجِبالِ الأُنَّنِ",76,"ن",1,0],["قُذافَةٍ بِحَجَرٍ القُذّافِ","وَلاَ تَشِنْ قَوْلَكَ بِالإِخْلافِ",77,"ف",1,0],["قَذَفَتْ صَميمَ فُؤادِهِ بِشُواظِ","شُعَلٌ أَرَتْهُ نَصائحَ الوُعَّاظِ",78,"ظ",1,1],["قَذَفْتَ بِوَشْكِ الْبَيْنِ في كَبِدي نارا","فَأَرْسَلْتُ الْعَيْنِ بَعْدَكَ مِدْرارا",79,"ر",2,1],["قُذفٍ لَها جُوفٍ وَشِدقٍ أَهدَلِ","كَأَنَّ صَوتَ جَرعِها المُستَعجَلِ",80,"ل",1,0],["قذفت إخاء كدر المذق صفوه","ولاحت عليه للضغون طلايع",81,"ع",1,0],["قُذِفنا بلُجِّ البحرِ والقيدُ آخذٌ","بأرجلِنا والريحُ بالموجِ تعصِفُ",82,"ف",1,0],["قذفت بهنَّ يدُ الخطوبِ بقفرةٍ","هيماءَ صاليةِ الهجير شطون",83,"ن",1,0],["قَذَفَت بِنا أَيدي النَوى جوزَ الفَلا","وَكَأَنَّها قَوسٌ وَنَحنُ سِهامُ",84,"م",1,0],["قذف الصباح بها سبيل بني الندى","لتجير من غلو الخطوب عيالها",85,"ل",3,0],["قَذفَكَ بالقِدحِ من الساسَم ال","أَجرَد قِدحَ الصَنع المُغتَلي",86,"ل",2,0],["قَذُوفٍ إذا ما استانت من مناخها","سما طَرفُها واستوفزتَ لِتقربا",87,"ب",2,0],["قَذائِفُهُ نارُ الجَحيمِ إِذا رَمى","بِها الفُلكَ دَوّى الرَعدُ وَاِستَحكَمَ الوَجمُ",88,"م",1,0],["قذف الدهن من فواه القدود","واستوى الطبخ واستقامت أموري",89,"ر",2,1],["قذائف لو أصبن صميم صخر","أصم أذَبنه سحقاً وصهرا",90,"ر",2,0],["قذوف ترى الهادي بها متحيرا","تجور به أصواب بومٍ صوائح",91,"ح",1,0],["قذفت بهم نحو العراق فاصبحت","فقرا وقد طمس البلى اطلالها",92,"ل",3,0],["قذفوا به من حالقٍ في هوَّةٍ","هَجَرَت معالِمَها الغوادي الرُوَّح",93,"ح",1,0],["قَذائفٌ بِها الجِبالُ","زَعزِعَت وَالأَرضون",94,"ن",1,0],["قَذفت بِتركيّا إِلى غمرة الوَغى","وَعَرَّفتها في الحَرب ما تَلد الحَرب",95,"ب",1,0],["قذفت لنا يا أيها البحر موجة","من النظم في أثنائها الدر راسب",96,"ب",1,0],["قذفوا النفوس بنقع غيهبها","تقضي الرجال وتنقضي الدولُ",97,"ل",1,0],["قذ سفحنا الدموع بالرمث حمراً","يوم شمنا القباب حمراً برمث",98,"ث",1,0],["قذفاً على سرب المكارم عزمة","بهويها بزّت فراخ بزاتها",99,"ت",3,0],["قَذَفَتْهُ أَلْسِنَةُ الشُّكُوكِ بِلَذْعِهَا","فِي حُرْقَةٍ تَعْلُو الوَرِيدَ وتصْعَدُ",100,"د",1,0],["قَذَفُوا الرِّمَاحَ وَبَاشَرُوا بِنُحُورِهِمْ","عِنْدَ الضِّرَابِ بِكُلِّ لَيْثٍ ضَيْغَمِ",101,"م",1,0],["قذفتنا به الرياح عناداً","مثلما يقذف الحصى في المآقي",102,"ق",2,0],["قذائف نيران ورعد مدافع","إذا صرخت مادت لها الأرض بالرعد",103,"د",1,0],["قَذَفَت بِعَبدِ العِرقِ جاءَ مِن استِها","وَرِثَ المذمَّة والسفال جدودا",104,"د",2,0],["قذفتُ الكرى في الدمع والصبر في الأسى","وهيهات أن يطفى وموقده الشحط",105,"ط",1,0],["قذفْنا الحَرُوريَّ في شِدقِهِ","وأُبطِنَ مُلَحَمُ فيهِ العِذارا",106,"ر",2,0],["قذفَتْهمُ فِرَقاً فمنهمْ راكنٌ","ومُؤَوِّبٌ لهواكَ غيرَ مُبالِ",107,"ل",1,0],["قذىً كن بآماق الطغام وكن شجى","طلاع الحشا منها وملء الحلاقم",108,"م",1,0]