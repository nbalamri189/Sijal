om/ViewPoem.aspx?id=194806",""],[5956,"أعضاؤها لخدامتي تتسابقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205481",""],[5956,"يا زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=213556",""],[5956,"القدِّيسة النقية تقية","https://www.poetsgate.com/ViewPoem.aspx?id=215548",""],[5956,"يومُ الخميس يحوز مني رأفتي","https://www.poetsgate.com/ViewPoem.aspx?id=215907",""],[6019,"موج قصيدة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53046",""],[6146,"لك الحمد يا أللهُ يا الواحدُ البَرُّ","https://www.poetsgate.com/ViewPoem.aspx?id=122040",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[5355,"من أجلها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87224&r=&rc=49",""],[6225,"أبنائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80989&r=&rc=258",""],[6230,"مِنْ أجْلِهَا ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67163&r=&rc=37",""],[6236,"من أجلك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82000&r=&rc=19",""],[6258,"وحي الفراسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75482&r=&rc=54",""],[2220,"منازلُ القرآنِ لا تعلمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11750&r=&rc=620",""],[6320,"بَلْسَمُ الرُّوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84332&r=&rc=29",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["مِن أَجلِها يَرضى الغَري","بُ بِالبَوادي وَطَنا",0,"ن",2,0],["مِن أَجلِ حُبُّكِ قُلتُ عاوَدَ أُنسَهُ","ذاكَ الحِمى وَسُقي اللَوى وَالأَبرَقُ",1,"ق",1,0],["مِن أَجلِ هَذا الناسِ أَبعَدتُ الهَوى","وَرَضيتُ أَن أَبقى وَما لي صاحِبُ",2,"ب",1,0],["مِنْ أَجْلِهَا تَلْقَى وَمَجْدُكَ صَادِق","تَبْجِيلَ هَذَا الشَّعْبِ وَالتَّعْظِيمَا",3,"م",2,0],["مِنْ أَجْلِ قَوْمِكَ كَمْ بِ","تَّ فِي لَيَالٍ جَوَاهُمْ",4,"م",1,0],["من أجل هذا المشهد المحزِن","والليل قد طال على من شتا",5,"ت",2,0],["من أجلها أمست لكم شهرةٌ","عمّ البرايا صيتها الطائر",6,"ر",1,0],["من أجل ذاك الرعايا فيهم اندمجوا","مستعربين وما كانوا من العرب",7,"ب",1,0],["من أجرة المسكن في","إعراب همٍّ أشهرا",8,"ر",2,0],["من أجل مبسمه الشهيّ تفتَّحت","في كفهِ أبداً شفاه الكاس",9,"س",1,0],["من أجل ما عقد المدّاح خنصرهم","عليه ميز من جلي نجا تام",10,"م",1,0],["من أجْحَدِ الناس لنعمى له","تزداد إسْفاراً على الجَحْدِ",11,"د",1,0],["من اجل صوت رخيم منك يسمعه","يا ام كلثوم جاء الجمع يزدحم",12,"م",1,0],["مِن أَجلِهم نَضا السَوادَ ساعَةً","فَقالَ قَومٌ خَلع الوالي الحَيا",13,"ا",1,0],["مِن أَجلِهِنَّ أَنا الشَفي","قُ عَلى الدُمى وَأَنا الغَيور",14,"ر",1,0],["مِنَ اجلِكِ ظَلَّ العاذِلاتُ يَلُمنَني","وَيَزعُمنَ أَنّي في طِلابِكِ عانِ",15,"ن",1,1],["مَن أَجابَ الهَوى إِلى كُلِّ ما يَد","عوهُ مِمّا يُضِلُّ ضَلَّ وَتاها",16,"ا",3,1],["مناجيا في الحجر ربا له","طورا وفي البيت العتيق الحرام",17,"م",1,0],["مناجاة أشواق وتجديد موثق","وتبديد أوهامٍ وفض ظنون",18,"ن",1,0],["مِنْ أَجْلِهِ وُضِعَ الأَحْبَابُ فِي صَفَدٍ","وَهْوَ الذي جَاءَ يُلْقِي عَنْهُمُ الصَّفَدَا",19,"د",2,0],["مِن أَجلِ ذَلِكَ كانَتِ العَرَبُ الأُلى","يَدعونَ هَذا سُؤدُداً مَحدودا",20,"د",2,0],["منْ أجلِ ذلكَ قدْ جانبْتُ أكثرَهُمُ","وقلتُ يا أزمةُ اشتدي لتنفرجي",21,"ج",2,0],["من أجلِ قاضٍ قد رَمَوْهُ بعلةٍ","ودَعَوْهُ بالمستثقَلِ المنقوصِ",22,"ص",1,0],["مِن أَجلِها حُبِسَت رَكائِبُنا","شَهراً تَجَرَّمَ بَعدَهُ شَهرا",23,"ر",2,0],["من أجل هذا قُدّرَ المقدورُ في","أمّ الكِتابِ وكُوّنَ التكوين",24,"ن",1,0],["مَن أَجادَ الظَنَّ بِالنا","سِ دَهاهُ ما دَهاني",25,"ن",2,0],["مَناجيدُ لَبّاسُونَ كُلَّ مُفاضَةٍ","كأنّ غَديراً فاضَ منها عَلى الجِسْمِ",26,"م",1,0],["مُناجاةً لَأَنتِ أَحَبُّ شُيءٍ","وَأَملَحُ ما نَكُونُ إِذا اِنتُجِينا",27,"ن",2,0],["مِنْ أَجْلِ مِصْرَ يَؤُمُّ كُلَّ مُيَمَّمٍ","فِي قَوْمِه وَيَزُورُ كُلَّ مَزَارِ",28,"ر",1,0],["مِن أَجلِهِ كُنتُ مادِحاً مَن","لَيسَ لِمَدحي بِمُستَحقِّ",29,"ق",1,0],["مِن أَجلِ حُزني عَلَيهِ يُعجِبُني","عَيشٌ أَمَرَّ الحِمامُ أَحلاهُ",30,"ا",2,0],["من إجتماعٍ لعُرْسٍ","إلى إجتماعٍ لدفن",31,"ن",1,0],["من أجل مصرٍ ما يجيشُ بصدره","من حُبِّه للناس أو بغضائه",32,"ا",3,0],["مِن أجلها هَجَرَ الأحبة، والكرى","والعيشَ في ظل النعيم رغيدا",33,"د",2,0],["مناجمُ لم تصل أيدٍ إليها","وماء لم تَنلْ منه الثغور",34,"ر",1,0],["من أجل أن ترعَوا مبادئَ \" مُحسنٍ \"","لتَكنْ أمامَكُمُ له أثواب",35,"ب",1,0],["من أجل ذاك ترانا رائحين له","ومغتدين بنا ترمى له الجُدَدُ",36,"د",1,0],["مِن أَجلِها سَلَّموا ما أودِعوا فَرَقاً","وَلَو تَشاءُ أَباحوكَ الَّذي اِدَّخَروا",37,"ر",3,0],["مَناجيبُ لا حيلانُ يُعزى إِلَيهمُ","وَلا عُدَّ فيهم ذُو كِتابٍ مُعانِدُ",38,"د",1,0],["من أجل ذلك ما قد قيل في مثل","أجاد شاعره الإيضاح عن أربه",39,"ب",2,0],["من أجل هذا غزاك الحزن مضطرما","والحزن أعنف غزوا من لظى اللهب",40,"ب",1,0],["من أجل حبك يا روحا فتنت به","فكان وجهك ف نجواي محرابي",41,"ي",1,0],["من أجل وجهك أرضى أن يكلفّني","هذا التليفون بعد العتب إعتابي",41,"ي",1,0],["من أجل بخلك بالوصال لقد","ساءت وحق هواك أحوالي",42,"ل",2,0],["مِنْ أَجْلِ ذَا بُحْتُ بِالتأْبِينِ مُنْتَحِباً","مِنْ مَوْتِ مَنْ لَمْ يَدَعْ دَمْعاً لِمُنْتَحِبِ",43,"ب",1,0],["مِنْ أَجْلِهَا أَجْلَلْتُ قَدْرَ خِطَابِهَا","بِعَزَائِهِ بِأَخٍ لَهُ ذِي شَانِ",44,"ن",1,0],["مِنْ أَجْلِ أَنَّ جَدَاهُ فِي حُكْمِ النُّهَى","أَنْجَادُ قَلْبٍ مُزَلْزَلِ الأَرْكَانِ",44,"ن",1,0],["مِنْ أَجْلِ أَوْزَارٍ تَحَمَّلَ ثِقْلَهَا","لاَ تَيْأَسَنْ فَالْعَفْوُ يَنْقُضُ غَزْلَهَا",45,"ه",2,0],["من أجل هذا أنا مذ جئتما","ما بين سكرانٍ ومخمور",46,"ر",1,0],["مَنَاجِيدُ وَثَّابُونَ فِي كُلِّ صَهْوَةٍ","مَنَ الْعِزِّ قَوَّالُون لِلْمَجْدِ فُعَّلُ",47,"ل",1,0],["مِن أَجلِ ذا سُمِّيَ مَو","دودَ فَذا بُرهانُ",48,"ن",1,0],["من أجل أوطاننا ما نحن نبذلُه","وفي سبيل العلا قد كان ما كانا",49,"ن",2,0],["من أَجلِ نومِ الرَّعايا آمنينَ به","لا يَكْحَلُ العَيْنَ غُمْضاً في لياليه",50,"ي",2,0],["من أجلِ هذا أصبحتُ مُنْكَنِساً","في كِسْرِ بيتٍ كالوَحشِ في الكُنُس",51,"س",1,0],["مِن أَجلِ أَنِّي قُلتُ إِنَّكَ عادِلٌ","فيما قَضَيتَ وقالَ ليسَ بِعادِلِ",52,"ل",1,0],["مِن أَجل أَن الوَرد وَصف خَده","يُغَيرُني شمُّ نَسيم الوَرد",53,"د",1,0],["مناجيبُ لم يدنس من اللُّؤم عرضهم","ولا عَلِقَتْ أُمٌّ 