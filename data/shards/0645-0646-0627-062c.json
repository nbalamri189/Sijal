{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[93,"يا من تحيي مصر عالي شأنه","https://www.aldiwan.net/poem11294.html","الكامل"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[88,"قد كانت الأغصان مخضرة","https://www.aldiwan.net/poem44411.html","السريع"],[88,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[88,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[72,"قل للفهيم الناصري","https://www.aldiwan.net/poem18769.html","مجزوء الرجز"],[72,"لله ظبي كنيسة لاحظته","https://www.aldiwan.net/poem19033.html","الكامل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[45,"من اجلك ظل العاذلات يلمنني","https://www.aldiwan.net/poem66836.html","الطويل"],[49,"من أجاب الهوى إلى كل ما يد","https://www.aldiwan.net/poem65360.html","الخفيف"],[66,"وأعجمي أخرس ناطق","https://www.aldiwan.net/poem38426.html","السريع"],[97,"ولما التقينا بعد نأي وغربة","https://www.aldiwan.net/poem24795.html","الطويل"],[44,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[69,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[69,"حال النحاة على العموم تميزت","https://www.aldiwan.net/poem29158.html","الكامل"],[31,"يا عمر حم فراقكم عمرا","https://www.aldiwan.net/poem42516.html","الكامل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[48,"أحمد الله الذي أسكننى","https://www.aldiwan.net/poem66161.html","مجزوء الرمل"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[40,"","https://poetry.dctabudhabi.ae/diwan/poem/93187","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"إلى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179547",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[130,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[141,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[167,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[184,"يا فاضلا حاز فخر الفضل عن أدبه","https://www.aldiwan.net/poem44113.html","البسيط"],[209,"غلا الحزن في عينيك والحزن جمرة","https://www.aldiwan.net/poem46591.html","الطويل"],[209,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[219,"الصبر أصبح درعه بالي","https://www.aldiwan.net/poem55306.html","أحذ الكامل"],[235,"حاولت صبرا على ما ناب من نوب","https://www.aldiwan.net/poem18065.html","البسيط"],[235,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[235,"ما شأن دنيانا سوى الإنذار","https://www.aldiwan.net/poem19781.html","الكامل"],[254,"قد صخب البم مع الزير","https://www.aldiwan.net/poem48462.html","السريع"],[278,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[280,"بانوا وقد أبانوا","https://www.aldiwan.net/poem32390.html","مجزوء الرجز"],[288,"يا بلبلا غردا غني فأشجانا","https://www.aldiwan.net/poem11689.html","البسيط"],[362,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[362,"لي فرس صائم حكى فرس الشطرنج","https://www.aldiwan.net/poem60870.html","المنسرح"],[369,"أرأيت ما سبقت إليه مخائلي","https://www.aldiwan.net/poem57236.html","الكامل"],[377,"تنسمي بالله ريح نجد","https://www.aldiwan.net/poem49209.html","الرجز"],[413,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[475,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[498,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[513,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[536,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[556,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[556,"يا شرفي بأنه يعلمني","https://www.aldiwan.net/poem33732.html","الرجز"],[556,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[556,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[560,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["مِن أَجلِها يَرضى الغَري","بُ بِالبَوادي وَطَنا",0,"ن",2,0],["مِن أَجلِ حُبُّكِ قُلتُ عاوَدَ أُنسَهُ","ذاكَ الحِمى وَسُقي اللَوى وَالأَبرَقُ",1,"ق",1,0],["مِن أَجلِ هَذا الناسِ أَبعَدتُ الهَوى","وَرَضيتُ أَن أَبقى وَما لي صاحِبُ",2,"ب",1,0],["مِنْ أَجْلِهَا تَلْقَى وَمَجْدُكَ صَادِق","تَبْجِيلَ هَذَا الشَّعْبِ وَالتَّعْظِيمَا",3,"م",2,0],["مِنْ أَجْلِ قَوْمِكَ كَمْ بِ","تَّ فِي لَيَالٍ جَوَاهُمْ",4,"م",1,0],["من أجل هذا المشهد المحزِن","والليل قد طال على من شتا",5,"ت",2,0],["من أجلها أمست لكم شهرةٌ","عمّ البرايا صيتها الطائر",6,"ر",1,0],["من أجل ذاك الرعايا فيهم اندمجوا","مستعربين وما كانوا من العرب",7,"ب",1,0],["من أجرة المسكن في","إعراب همٍّ أشهرا",8,"ر",2,0],["من أجل مبسمه الشهيّ تفتَّحت","في كفهِ أبداً شفاه الكاس",9,"س",1,0],["من أجل ما عقد المدّاح خنصرهم","عليه ميز من جلي نجا تام",10,"م",1,0],["من أجْحَدِ الناس لنعمى له","تزداد إسْفاراً على الجَحْدِ",11,"د",1,0],["من اجل صوت رخيم منك يسمعه","يا ام كلثوم جاء الجمع يزدحم",12,"م",1,0],["مِن أَجلِهم نَضا السَوادَ ساعَةً","فَقالَ قَومٌ خَلع الوالي الحَيا",13,"ا",1,0],["مِن أَجلِهِنَّ أَنا الشَفي","قُ عَلى الدُمى وَأَنا الغَيور",14,"ر",1,0],["مِنَ اجلِكِ ظَلَّ العاذِلاتُ يَلُمنَني","وَيَزعُمنَ أَنّي في طِلابِكِ عانِ",15,"ن",1,1],["مَن أَجابَ الهَوى إِلى كُلِّ ما يَد","عوهُ مِمّا يُضِلُّ ضَلَّ وَتاها",16,"ا",3,1],["مناجيا في الحجر ربا له","طورا وفي البيت العتيق الحرام",17,"م",1,0],["مناجاة أشواق وتجديد موثق","وتبديد أوهامٍ وفض ظنون",18,"ن",1,0],["مِن أَجلِ ذَلِكَ كانَتِ العَرَبُ الأُلى","يَدعونَ هَذا سُؤدُداً مَحدودا",19,"د",2,0],["منْ أجلِ ذلكَ قدْ جانبْتُ أكثرَهُمُ","وقلتُ يا أزمةُ اشتدي لتنفرجي",20,"ج",2,0],["من أجلِ قاضٍ قد رَمَوْهُ بعلةٍ","ودَعَوْهُ بالمستثقَلِ المنقوصِ",21,"ص",1,0],["مِن أَجلِها حُبِسَت رَكائِبُنا","شَهراً تَجَرَّمَ بَعدَهُ شَهرا",22,"ر",2,0],["من أجل هذا قُدّرَ المقدورُ في","أمّ الكِتابِ وكُوّنَ التكوين",23,"ن",1,0],["مَن أَجادَ الظَنَّ بِالنا","سِ دَهاهُ ما دَهاني",24,"ي",1,0],["مَناجيدُ لَبّاسُونَ كُلَّ مُفاضَةٍ","كأنّ غَديراً فاضَ منها عَلى الجِسْمِ",25,"م",1,0],["مُناجاةً لَأَنتِ أَحَبُّ شُيءٍ","وَأَملَحُ ما نَكُونُ إِذا اِنتُجِينا",26,"ن",2,0],["مِنْ أَجْلِ مِصْرَ يَؤُمُّ كُلَّ مُيَمَّمٍ","فِي قَوْمِه وَيَزُورُ كُلَّ مَزَارِ",27,"ر",1,0],["مِن أَجلِهِ كُنتُ مادِحاً مَن","لَيسَ لِمَدحي بِمُستَحقِّ",28,"ق",1,0],["مِن أَجلِ حُزني عَلَيهِ يُعجِبُني","عَيشٌ أَمَرَّ الحِمامُ أَحلاهُ",29,"ا",2,0],["من إجتماعٍ لعُرْسٍ","إلى إجتماعٍ لدفن",30,"ن",1,0],["من أجل مصرٍ ما يجيشُ بصدره","من حُبِّه للناس أو بغضائه",31,"ا",3,0],["مِن أجلها هَجَرَ الأحبة، والكرى","والعيشَ في ظل النعيم رغيدا",32,"د",2,0],["مناجمُ لم تصل أيدٍ إليها","وماء لم تَنلْ منه الثغور",33,"ر",1,0],["من أجل أن ترعَوا مبادئَ \" مُحسنٍ \"","لتَكنْ أمامَكُمُ له أثواب",34,"ب",1,0],["من أجل ذاك ترانا رائحين له","ومغتدين بنا ترمى له الجُدَدُ",35,"د",1,0],["مِن أَجلِها سَلَّموا ما أودِعوا فَرَقاً","وَلَو تَشاءُ أَباحوكَ الَّذي اِدَّخَروا",36,"ر",3,0],["مَناجيبُ لا حيلانُ يُعزى إِلَيهمُ","وَلا عُدَّ فيهم ذُو كِتابٍ مُعانِدُ",37,"د",1,0],["من أجل ذلك ما قد قيل في مثل","أجاد شاعره الإيضاح عن أربه",38,"ب",2,0],["من أجل هذا غزاك الحزن مضطرما","والحزن أعنف غزوا من لظى اللهب",39,"ب",1,0],["من أجل حبك يا روحا فتنت به","فكان وجهك ف نجواي محرابي",40,"ي",1,0],["من أجل وجهك أرضى أن يكلفّني","هذا التليفون بعد العتب إعتابي",40,"ي",1,0],["من أجل بخلك بالوصال لقد","ساءت وحق هواك أحوالي",41,"ل",2,0],["مِنْ أَجْلِ ذَا بُحْتُ بِالتأْبِينِ مُنْتَحِباً","مِنْ مَوْتِ مَنْ لَمْ يَدَعْ دَمْعاً لِمُنْتَحِبِ",42,"ب",1,0],["مِنْ أَجْلِهَا أَجْلَلْتُ قَدْرَ خِطَابِهَا","بِعَزَائِهِ بِأَخٍ لَهُ ذِي شَانِ",43,"ن",1,0],["مِنْ أَجْلِ أَنَّ جَدَاهُ فِي حُكْمِ النُّهَى","أَنْجَادُ قَلْبٍ مُزَلْزَلِ الأَرْكَانِ",43,"ن",1,0],["مِنْ أَجْلِ أَوْزَارٍ تَحَمَّلَ ثِقْلَهَا","لاَ تَيْأَسَنْ فَالْعَفْوُ يَنْقُضُ غَزْلَهَا",44,"ه",2,0],["من أجل هذا أنا مذ جئتما","ما بين سكرانٍ ومخمور",45,"ر",1,0],["مَنَاجِيدُ وَثَّابُونَ فِي كُلِّ صَهْوَةٍ","مَنَ الْعِزِّ قَوَّالُون لِلْمَجْدِ فُعَّلُ",46,"ل",1,0],["مِن أَجلِ ذا سُمِّيَ مَو","دودَ فَذا بُرهانُ",47,"ن",1,0],["من أجل أوطاننا ما نحن نبذلُه","وفي سبيل العلا قد كان ما كانا",48,"ن",2,0],["من أَجلِ نومِ الرَّعايا آمنينَ به","لا يَكْحَلُ العَيْنَ غُمْضاً في لياليه",49,"ي",2,0],["من أجلِ هذا أصبحتُ مُنْكَنِساً","في كِسْرِ بيتٍ كالوَحشِ في الكُنُس",50,"س",1,0],["مِن أَجلِ أَنِّي قُلتُ إِنَّكَ عادِلٌ","فيما قَضَيتَ وقالَ ليسَ بِعادِلِ",51,"ل",1,0],["مِن أَجل أَن الوَرد وَصف خَده","يُغَيرُني شمُّ نَسيم الوَرد",52,"د",1,0],["مناجيبُ لم يدنس من اللُّؤم عرضهم","ولا عَلِقَتْ أُمٌّ لهم ببخيل",53,"ل",1,0],["مناجيدُ حربٍ تعثُر الخيلُ تحتهمْ","اِذا ما ارتدوا أسيافَهم بالجماجمِ",54,"م",1,0],["من أجلِ ذلك جُدْنا بالدُّموعِ لهم","حتَّى أَسلْنا على أَطلالِهِمْ سُحُبَا",55,"ب",2,0],["من أجل هيبة ذا المقام المذهل","لم تغن عن أحد شجاعة مقول",56,"ل",1,1],["مِن أَجلِهِ قد صِرتُ أكرهُ كلَّ لَو","نٍ أحمَرٍ حاشا خُدودَ حِسانِ",57,"ن",1,0],["مناجِيدُ أقيالٍ حُضورٌ لدَى النَّدَى","ألُوذُ بهم في الكربِ إن دَعهَمَ الكَربُ",58,"ب",1,0],["من أجلِ دارٍ فوقَ وَجْرَةَ أقفرتْ","سيلٌ من العينين لجّ همولُهُ",59,"ل",2,0],["من أجلهِ زال عنا المسخ تكرمة","والله فضلنا طراً على الأممِ",60,"م",1,0],["من أجل ذا كلامه أنزله","بعلمه لمن بهذا يعتني",61,"ي",1,0],["من أجل ذا يقول من","قد قال خالقي أنا",62,"ن",2,0],["من أجل هذا هي في الجهل لم","تبرح وفي غي وفي لبس",63,"س",1,0],["مِن أَجلِ أَنَّ وُدَّهُ لَم يَنسُلِ","مِنّي وَلا بَلاؤُهُ إِذ نَبتَلي",64,"ل",2,0],["من أجلِهِ خُلِقَ الزَمانُ وأهلُهُ","وكِلاهُما يَمضي عليهِ كما تَرَى",65,"ر",2,0],["من أَجل حزني قد أَعدَّ","وقد أَحدَّ شَباً وظُفْرَا",66,"ر",2,0]]}