قاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5582,"ما بالُ قَلْبِكَ زادَ فِي وَلْوالِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63554",""],[5736,"عانقت طيفك","https://www.poetsgate.com/ViewPoem.aspx?id=208467",""],[5776,"ورطة","https://www.poetsgate.com/ViewPoem.aspx?id=199417",""],[5781,"قلوبٌ مَأهولةٌ بالظَّامئين","https://www.poetsgate.com/ViewPoem.aspx?id=202829",""],[5894,"إن الفضيلة في الزمان تراد","https://www.poetsgate.com/ViewPoem.aspx?id=131439",""],[5956,"هل أنا أكبرُ المعمَّرين؟","https://www.poetsgate.com/ViewPoem.aspx?id=192731",""],[5957,"أهويتَ غيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=12236",""],[5994,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=184664",""],[6124,"أرق المنسرح","https://www.poetsgate.com/ViewPoem.aspx?id=104137",""],[6124,"شقراء مرت","https://www.poetsgate.com/ViewPoem.aspx?id=174657",""],[463,"غالِ بها فيما تسامُ واشترطْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60114&r=&rc=170",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""]],"verses":[["كَاللَيثِ يَقتَنِصُ الرِجا","لَ وَلا يُغيرُ عَلى السَوامِ",0,"م",1,0],["كَاللَيثِ إِلّا أَنَّهُ اِت","تَخِذَ العُلى وَالمَجدَ غيلا",1,"ل",2,0],["كَاللَيثِ يوهَنُ بِالتَرابِ وَيَمتَلي","نَوماً عَلى الأَضغانِ وَالأَحقادِ",2,"د",1,0],["كَاللَيثِ خَفَّ لِغيلِهِ","يَحمي فَريسَتَهُ شَكِس",3,"س",1,0],["كَاللَيثِ لَو أَزَمَ اللَيثُ الهُصورُ بِهِ","ما غَضَّ طَرفاً وَلَم يَجزَع وَلَم يَصُتِ",4,"ت",1,0],["كالليل لا بل يضعفو","ن عليه من بادٍ وحاضرْ",5,"ر",1,1],["كالليث يسطو كفه بأرقم","والبدر يرمي في الدجى بأنجم",6,"م",1,0],["كالليث في بأسهِ وآونةً","مثل الشُّجاع الخفيِّ مُنْسرَبُهْ",7,"ب",2,0],["كَاللَيلَةِ اللَيلاءِ ساجِيَةً","وَلَرُبَّ لَيلٍ ساطِعٍ غِرِّ",8,"ر",1,0],["كَاللَيثِ لَيسَ لَهُ سِلاحٌ في السُرى","إِلّا مَخالِبُهُ الَّتي لا تُثلَمُ",9,"م",1,0],["كَاللَيثِ يُسرِفُ في الفِعا","لِ وَلَيسَ يُسرِفُ في الزَئير",10,"ر",1,0],["كَاللَيثِ إِلّا أَنَّهُ ماجِدٌ","كَالغَيثِ إِلّا أَنَّهُ سَمحُ",11,"ح",1,0],["كَاللَيثِ إِلّا أَنَّ هَذا صائِلٌ","بِمُهَنَّدٍ ذَرِبٍ وَذاكَ بِمِخصَفِ",12,"ف",1,0],["كاللَّيثِ لا يسلُبُ الأعداءَ بَزَّهُمُ","في الرَّوْعِ لكن تَرى أرواحَهم سَلَبا",13,"ب",2,0],["كالليثِ آثارُ اللقاء مُبيَّنَةٌ","في لِبدَتَيْهِ وفي شَبا أنيابِه",14,"ب",2,0],["كَاللَيلِ ما أَسحَمَهُ وَأَطوَلَه","حَتّى إِذا سَرَّحَهُ وَأَسبَلَه",15,"ل",2,0],["كَاللَيثِ يَحمي غابَهُ بِزَئيرِهِ","طَوراً وَيُنشِبُ في القَنيصِ مَخالِبا",16,"ب",2,0],["كَاللَيلِ أَو كَاللوبِ أَو كَالنوبِ","مُنقادَةً لِعارِضٍ غِربيبِ",17,"ب",1,0],["كَاللَيثِ لَيثِ الغابِ إِلّا أَنَّ ذا","في الرَوعِ بَسّامٌ وَذاكَ شَتيمُ",18,"م",1,0],["كَاللَيثِ لا تُبقي مَخالِبُهُ","يَداً لِجارِحَةٍ إِذا بَطَشا",19,"ش",2,0],["كَاللَهَبِ المُرتَجِّ طارَ شَرَرُه","بِأَحجَنِ الكَلّوبِ أَقنى مِنسَرُه",20,"ر",2,0],["كاللُّوبِ يُبذل جمُّها وحَفيلُها","للجارِ وابنِ العمِّ والمنتابِ",21,"ب",1,0],["كاللّيث ليس سلاح في السّرى","مخالبه التي لا تلثم",22,"م",1,0],["كاللؤلؤ المكنونِ في","سُرُرٍ تُرَى مُتسانِدَهْ",23,"د",2,0],["كالليل إلا أها قد طُرِّزت","شفَقا على أفاقها يتشعشعُ",24,"ع",1,0],["كَاللَيلِ لا بَرقُ الأَسِنَّةِ خُلَّبٌ","فيهِ وَلا لَمعُ النُصولِ سَرابُ",25,"ب",1,0],["كاللؤلؤ الرطب لونُ ظاهِرِهِ","وفيه ماء العقيق قد بَطَنا",26,"ن",2,0],["كَاللَيثِ إِذ يَزاَرُ في تَختِهِ","عَرينُهُ يعرفُه الأُقصُرُ",27,"ر",1,0],["كالّلفظ ملتفّاً به معناه","تحسُد منه يدَه رجلاه",28,"ا",2,0],["كَاللَيلَةِ اللَيلاءِ يَن","هالُ النَهارُ عَلى دُجاها",29,"ا",3,0],["كال لي سوط عذابٍ","صَبَّ فوقي منه صَبّا",30,"ب",2,0],["كَاللَيثِ مُنتَفِضاً لِوَثبَتِهِ عَلى","شَثنِ البَراثِنِ دَأبُهُ الإِقدامُ",31,"م",1,0],["كَاللؤلُؤِ المَنظومِ يَعلو فِضَّةً","ذائِبَةً بِالمَزجِ صارَت ذَهَبا",32,"ب",2,0],["كاللَيثِ والغَيثِ في عَزمٍ وفي كَرَمٍ","وَالزَهرِ والدَهرِ في بِشر وفي غَضَبِ",33,"ب",1,0],["كَاللَيثُ حَلَّ مِنَ الأَشبالِ في أَجَمِ","كَم جادَلَ القَومَ في أَمرٍ لَهُ جَلَلُ",34,"ل",1,0],["كاللّيثِ فارقَ لاقْتناصٍ غِيلَهُ","ثمّ انثنَى جَذِلاً يَحُلُّ الغِيلا",35,"ل",2,0],["كَالليقَةِ السَوداءِ في أَطرافِها","عُشبُ المِدادِ مُبَيَّضٌ لِلِّيقَةِ",36,"ه",1,0],["كالليث واجه ردَّةُ مشؤومة","فأعاد للإسلام من جافاه",37,"ا",2,0],["كَاللَيثِ إِلّا أَنَّ جارك آمن","وَاللَيثُ لَيسَ بآمنِ الجيرانِ",38,"ن",1,0],["كاللواء المقدم الشهم الَّذي","كانَ في الهيجاء لا يألوك جهدا",39,"د",2,0],["كَاللَيثِ بَين الكَبواتِ الضَيغَم","يُرضِعنَ أَشبالاً وَلَمّا تُفطَمِ",40,"م",1,0],["كالليثِ لكن ترى يومَ الكفاح له","في هامِ الاعْداءِ طُرّاً صارِماً ذكَرا",41,"ر",2,0],["كالليثِ قد عزّ به العرينُ","كالدهرِ فيه شدةٌ ولينُ",42,"ن",1,0],["كالليث إلا أنّ ذلك صافل","جهلا وأحمد للنوائب كشفا",43,"ف",2,0],["كالليث يأنفُ مأكلاً","إلا عَبيطاً يُشرِقُهْ",44,"ق",2,0],["كالليث لا تحلو له مضغةُ ما","لم يفتلِذْ بكفّه ويعتبِطْ",45,"ط",1,0],["كالليث يُقلَى وهو يُطرَى أو كما","نافق أعداءٌ وزيرَ الوُزَرا",46,"ر",2,0],["كالليث والغمرُ استغرَّ بثغره","فدنا إليه فاسئلي عمَّا كلَحْ",47,"ح",1,0],["كالليثِ لا تحلو له فريسةٌ","لا ينتقي فيها ولا يُخَلِّبُ",48,"ب",1,0],["كالليل لوناً بهلال منعلٌ","جلالةً وبالثريا ملجم",49,"م",1,0],["كالّليثِ يجزمُ كلّ ناصب رايةٍ","يبغي النزال بعامل من عامل",50,"ل",1,0],["كالليثِ لم يقفر معرَّسهُ","ما دام مأهولاً من الشبل",51,"ل",1,0],["كاللجَّة الخضراء ما غاصوا بها","الأَّعلى درّ الكلام المنتقى",52,"ق",2,0],["كالليل فيه البدر بين نجومه","وهم البنون رعيتُهم بمحاجري",53,"ر",2,0],["كَاللَيلِ إِلا أَنَّ ثَوبَ ظَلامِهِ","مِن عَثيرٍ وَنُجومُهُ مِن لامِ",54,"م",1,0],["كَاللَّيثِ لَيثِ الغَابَةِ المُهَيَّجِ","إذَا دَعَاهُ القِرنُ لَم يُعَرِّجِ",55,"ج",1,0],["كاللّيثِ في وثَباتِه يومَ الوغى","والطّودِ في تمكينِه وثَباتِهِ",56,"ت",2,0],["كالليث إلا أن ذا باسم","والغيث إلا أن ذا أغزر",57,"ر",1,0],["كاللّيثِ يَستَدني فَريسَتهُ","فَيسانِدُ التَظفيرَ بِالعذمِ",58,"م",1,0],["كاللّيثِ أبرز شخصَه خَمَرٌ","والسّيفِ أعلَنَ مَتْنهُ غِمْدُ",59,"د",1,0],["كَاللَيثِ بَل مِثلُهُ اللَيثُ الهَصورُ إِذا","غَنّى الحَديدُ غِناءً غَيرَ تَغريدِ",60,"د",1,0],["كَاللَيثِ إِن هِجتَهُ فَالمَوتُ راحَتُهُ","لا يَستَريحُ إِلى الأَيّامِ وَالدُوَلِ",61,"ل",1,0],["كاللب والقشر أو الشمس مع","شعاعها فانظر إلى الشمس",62,"س",1,0],["كاللمح من بصر لمن","قرأ الكتاب وما درى",63,"ر",2,0],["كاللمح من أبصارنا أمرها","وهو الذي منه يكون الفتوح",64,"ح",1,0],["كالَّليثِ حين غَدا والبدرِ حين بدا","والغيثِ حين هَمى والنَّجْم حين عَلا",65,"ل",2,0],["كاللَّيْلِ إِلاَّ أَنَّه لما دَجا","كالمسكِ إِلاَّ أَنَّه لمّا نَفَح",66,"ح",1,0],["كالليث أنشب انيبا ومخالباً","فيمن سبى شبلا وحل الغيلا",67,"ل",2,0],["كاللَّيثِ في الغِيلِ في الكِفاحِ لَهُ","مِن قُضُبِ الهِندِ والقَنا غيلُ",68,"ل",1,0],["كالليث والغيث إن قيست بفعلهما","يمينهم بعض ما أفنى وما وهبا",69,"ب",2,0],["كالليث في الحرب والبحْ","ر في الندى والسخاءِ",70,"ا",2,0],["كالليث يُبطئ عن أذى جيرانه","ويكون أشرعَهم إلى الآثارِ",71,"ر",1,0],["كالليل لونا نجم غر","رته مضي الإنقيادِ",72,"د",1,0],["كَاللّيثِ يحرس شبلَه طوراً وفي","عضو القنيصةِ بِالمخالب ينشبُ",73,"ب",1,0],["كاللّيثِ ينشب في القميصِ مخالباً","وَيظلّ مُحتمياً إِلى أشبالهِ",74,"ل",2,0],["كالليل شعراً غاسقاً والصبح وج","هاً شارقاً أنواره تتلألأ",75,"ا",1,0],["كَاللَّيْلِ يَعْتَزُّ الجِبالَ القُهْبا","قَد أَصْبَح الناسُ عَلَيْنَا أَلْبا",76,"ب",2,0],["كالَّليثِ في يومِ حَرْبٍ","والغَيْثِ في يَوْمِ سِلْمِ",77,"م",1,0],["كاللمة السوداء أرسل عقصها","فوق الغلائل دون عقد التاج",78,"ج",1,0],["كالليثِ لما ضَغمَ الخنزيرا","وَلّى انهِزاماً خاسِئاً مدحُورا",79,"ر",2,0],["كالليث يزداد بالأشبال وهي به","بأسا وإن لم يزل بالبأس مشتهرا",80,"ر",2,0],["كَاللَيث لا يَعدو عَلى قُرنِه","الا عَلى الأَمكان من فرسه",81,"س",2,0],["كالليلِ كنتِ سكينة مخبوءة","بالياسمين صباحُنا يأتيكِ",82,"ك",1,0],["كاللَّيْث ليس بمُختارٍ فرائسَهُ","سِيّانِ ظَبْيُ كِناسٍ عنده ولأَي",83,"ا",2,0],["كَالليثِ يأنَفُ أَن يَدُقَّ فَريسَةً","لَم تَثوِ بَينَ مَلاطِهِ وَجِرانِهِ",84,"ه",1,0],["كَاللَيثِ عِندَ اللَبُواتِ الضَيغَمِ","يُرضِعنَ أَشبالاً وَلَمّا تُفطَمِ",85,"م",1,0],["كالليث هم كالبدر تم","وكم صرم عمراً وكم",86,"م",1,0],["كالليث تخشى عواديه وَسَوْرَتُهُ","والغيثِ تُرْجَى غواديه وَتُرْتَقَبُ",87,"ب",1,0],["كالليث أَصْحَر ثم عاد يحثه","شوق إلى المحمِيِّ من آجامه",88,"م",2,0],["كالليث يتخذ المفاضة لبدة","والسمر غاباً والسيوف أظافرا",89,"ر",2,0],["كالليثِ بَتْرُكُ قِرْنَهُ","مُتجَدِّلاً بين المجال