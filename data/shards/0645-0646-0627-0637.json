{"poems":[[66,"من سارروه فأبدى كل ما ستروا","https://www.aldiwan.net/poem67633.html","البسيط"],[53,"أفسدت توبتي علي غلام","https://www.aldiwan.net/poem66362.html","الخفيف"],[45,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[107,"هتف البشير به وحان الحين","https://www.aldiwan.net/poem42044.html","الكامل"],[48,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85780","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43847","البسيط"],[108,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[102,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[96,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[66,"الأهوال أمانات عند أهلها","https://www.poetsgate.com/ViewPoem.aspx?id=3098",""],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[136,"طبتنا اليوم عن ذكرى سعاد","https://www.aldiwan.net/poem54849.html","الطويل"],[190,"يا بعيد المزار أنت قريب","https://www.aldiwan.net/poem43895.html","الخفيف"],[343,"من أطلق الطرف اجتنى شهوة","https://www.aldiwan.net/poem68781.html","السريع"],[385,"بعينيه سحار يعلمني السحرا","https://www.aldiwan.net/poem49207.html","الطويل"],[409,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[458,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[563,"مراتب ذات في البرية تحكم","https://www.aldiwan.net/poem33536.html","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130209","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37996","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35382","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109307","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109279","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53059","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27658","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110747","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66458","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92291","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73211","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4578,"من أطلع الريحان في الجلنار","https://www.poetsgate.com/ViewPoem.aspx?id=49426",""],[5055,"غريبة","https://www.poetsgate.com/ViewPoem.aspx?id=103420",""],[5101,"زَرّر قميصك","https://www.poetsgate.com/ViewPoem.aspx?id=212659",""],[5120,"اَلْحَرْبُ اَلضَّرُوسُ","https://www.poetsgate.com/ViewPoem.aspx?id=180019",""],[5277,"سيدةُ المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=200484",""],[5444,"راية الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=209112",""],[5457,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=213388",""],[5495,"مو جيتك","https://www.poetsgate.com/ViewPoem.aspx?id=175438",""],[5790,"من أطلع البدر في داج من الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=112058",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[6058,"الأنفاس","https://www.poetsgate.com/ViewPoem.aspx?id=192258",""],[6336,"بعد العاصفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73566&r=&rc=27",""]],"verses":[["مَن أَطلَعوهُ عَلى سِرٍّ فَنَمَّ بِهِ","فَذاكَ مِثلِيَ بَينَ الناسَ قَد طاشا",0,"ش",2,0],["من أطالَ ارتضاعَ أخلافِ لَهْوٍ","شقَّ فيما أرى عليه الفطام",1,"م",1,0],["مَن أَطاقَ اِلتِماسَ شَيءٍ غِلاباً","وَاِغتِصاباً لَم يَلتَمِسهُ سُؤالا",2,"ل",2,0],["مَن أطلقَ الأفكارَ من أوهامِها","أَيَظلُّ طُولَ الدّهرِ وَهْوَ سجينُ",3,"ن",1,0],["مَناطِقُ غِلمانٍ وَأَحجالُ أُنَّسٍ","تَغُرُّ وَأَعمالُ الفَتى بِالخَواتِمِ",4,"م",1,1],["مَنِ اطمأنَّ بدين كان يرضعه","فَلَيسَ يسمع تأنيب البراهينِ",5,"ن",1,1],["مَنَاطُ نِظَامِهَا حَزْمٌ وَعَزْمٌ","وَمَجْلَى حُسْنِهَا كَرَمٌ وَطِيبُ",6,"ب",1,0],["مِن أَطيَبِ الطَيِّبينَ خيماً","كُنتَ وَمِن أَكرَمِ الكِرامِ",7,"م",1,0],["مَنْ أَطلقَ النِّيلَ أَمْسى وهْوَ يحبِسهُ","جمالُ، يثني عليكَ المُطَلقُ العاني",8,"ن",2,0],["من أطلقوا كصحو نيسان يكسون","الربى الجرد خضرة واخضلالا",9,"ل",2,0],["من أطفأ الجذوة الكبرى بأنفسنا","أدهرنا حال أم حالت سجايانا",10,"ن",2,0],["من أطلعوه على سرّ فنمَّ به","فذاك مثل يبين الناس طيّاشا",11,"ش",2,0],["من أطنب القرآن في مديحه","فاعجز البليغ عن توضيحه",12,"ه",1,0],["مَنَاطَ النَّجمِ كَانَت فَاطَّبَتهَا","خَطَاطِيفَ الدراهم للبلاد",13,"د",1,0],["من أطاع الهوى فأقلقه الشو","ق لقي بالصدود خطبا شديدا",14,"د",2,0],["مَن أَطلَقَ الطَرفَ اِجتَنى شَهوَةً","وَحارِسُ الشَهوَةِ غَضُّ البَصر",15,"ر",1,1],["مَناطِقهُ في خِصرِهِ أَبَداً حَيرى","كَحيرة قَلبي بَعدَ ما زايل الصَبرا",16,"ر",2,0],["من أطلع القمر المنير إذا دجى","ليلٌ فشابه صحبه بضيائه",17,"ا",3,0],["من أطلعت صنعاء نجم حضارة","عمت بأنفس روعة وأجلها",18,"ل",3,0],["مناط كلا الأمرين غيب مقدس","وجود له منه عليه مترجم",19,"م",1,0],["من أطلق القلم السيار في أثري","أريته من معاني معجزي عبرا",20,"ر",2,0],["مَن أَطبَقَت أَهلُ الفَضائِلِ أَنَّهُ","فَردٌ وَحيدٌ في الزَّمانِ وَأَجمَعوا",21,"ع",3,0],["مَناطُ أَمصارِ البِلادِ وَمَن","يَعنو لَهُ الحُرُّ بِها وَالرَقيق",22,"ق",1,0],["من أطاع الشيطانَ لا بدَّ يلقى","في الحياتين زفرةَ الندمانِ",23,"ن",1,0],["مناطيد حقد حلقت في سمائه","تجلى ولكن للخسوف بدورها",24,"ر",3,0],["من اطلع القمر الزاهي بطلعته","واودع السحر في أجفان مقلته",25,"ت",2,1],["مناطيدهم كالطير تسبح في الفضا","تحاول في أوج السماء لها وكرا",26,"ر",2,0],["من أطلع البدر في ديجور طرّته","وأودع السحر في تكسير مقلته",27,"ت",2,1],["مناط الثريا كان ايمنهم بنا","وأيسرهم إكليلها وهو من كمي",28,"م",2,0],["من أطلع اللَه من لألاء غرته","بدرا وأنزل في أوصافه كتبا",29,"ب",2,0],["من أطلع الشمس في غصنٍ من الذهب","وأثمر الورد في خدّ من اللهب",30,"ب",1,1],["منا طعينُ قويمها فينا كلي","مُ رَشيقها وبنا فعالُ ظلومها",31,"ه",2,0],["من اطمأن بذكرِ اللَهِ حان لَهُ","فتحٌ وطوبى له بوردِهِ الشبمِ",32,"م",1,0],["من أطلعَ الصبُّحَ في داجٍ الشَّعرِ","ومن تثنَّى كخوُطِ البانةِ النَّضرِ",33,"ر",1,1],["من أطعم الحية الرقطاء محتفلا","بها أذاقته طعم الموت بالختل",34,"ل",1,0],["مناطقه باللظف تبدى لمن رأي","لطائف من بالفضل أمسى ممنطقا",35,"ق",2,0],["من أطلع الريحان في الجلنار","حتى أثار الوجد من جل نار",36,"ر",1,1],["من أطرافي لأطرافي وصفني صبري بحبره","عجزة أقوم لايامي وأيامي ولا تدري",37,"ر",2,0],["من أطلقَ الشّمسَ من تحت القميصِ ضُحى","حتى احترقتُ وفاضت بالندى المُقَلُ",38,"ل",1,0],["مَنْ أَطْلَقَ اَلنَّايَ مِنْ قَاعِ اَلْحَنِينِ؟وَ مَنْ","أَبْقَاكِ يَا كَأْسُ لاَ خَمْرٌ وَ لاَ شَرَفُ",39,"ف",1,0],["مَناطُ الحبِّ أخلصُهُ سبيلاً","وإن جارَ الزمانُ على الأماكنْ",40,"ن",1,0],["مَنْ أطفأَ الأنوارَ عن معروفِه","في يومِ مَسْغَبةٍ وفَكِّ أيادي",41,"د",2,0],["من أطفأَ النورَ؟ والأنقاضُ تخنُقُهُ","تخفي الحقيقةَ في قبرِ من الظُلَمِ",42,"م",1,0],["من اطش بذرة كلامي بسطح الانهار","على الجرفين ينبت صوت مسموع",43,"ع",1,0],["من أطلع البدر في داج من الشعر","ومن تثنى كخوط البانة النضر",44,"ر",1,1],["مِنّا طُلَيْحَةُ وُالمُهَلَّبُ إذ تَرى","أنَّ الصَّحابَةَ مِنْ قَصيدي أَكبَرُ",45,"ر",1,0],["من اطرافه اذا تْوضى سقط خناس","مثل ما تسقط مْن اهدااابك الدمعه",46,"ع",2,0],["مَن أطفأ البرق الذي هتكَ الدجى","ومضاً ، ومن لجم الرعودَ القاصفه؟",47,"ف",2,0]]}