{"poems":[[64,"من سارروه فأبدى كل ما ستروا","https://www.aldiwan.net/poem67633.html","البسيط"],[51,"أفسدت توبتي علي غلام","https://www.aldiwan.net/poem66362.html","الخفيف"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[105,"هتف البشير به وحان الحين","https://www.aldiwan.net/poem42044.html","الكامل"],[46,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85780","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43847","البسيط"],[106,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[64,"الأهوال أمانات عند أهلها","https://www.poetsgate.com/ViewPoem.aspx?id=3098",""],[113,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[130,"طبتنا اليوم عن ذكرى سعاد","https://www.aldiwan.net/poem54849.html","الطويل"],[184,"يا بعيد المزار أنت قريب","https://www.aldiwan.net/poem43895.html","الخفيف"],[336,"من أطلق الطرف اجتنى شهوة","https://www.aldiwan.net/poem68781.html","السريع"],[377,"بعينيه سحار يعلمني السحرا","https://www.aldiwan.net/poem49207.html","الطويل"],[400,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[451,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[556,"مراتب ذات في البرية تحكم","https://www.aldiwan.net/poem33536.html","الطويل"]],"verses":[["مَن أَطلَعوهُ عَلى سِرٍّ فَنَمَّ بِهِ","فَذاكَ مِثلِيَ بَينَ الناسَ قَد طاشا",0,"ش",2,0],["من أطالَ ارتضاعَ أخلافِ لَهْوٍ","شقَّ فيما أرى عليه الفطام",1,"م",1,0],["مَن أَطاقَ اِلتِماسَ شَيءٍ غِلاباً","وَاِغتِصاباً لَم يَلتَمِسهُ سُؤالا",2,"ل",2,0],["مَن أطلقَ الأفكارَ من أوهامِها","أَيَظلُّ طُولَ الدّهرِ وَهْوَ سجينُ",3,"ن",1,0],["مَناطِقُ غِلمانٍ وَأَحجالُ أُنَّسٍ","تَغُرُّ وَأَعمالُ الفَتى بِالخَواتِمِ",4,"م",1,1],["مَنِ اطمأنَّ بدين كان يرضعه","فَلَيسَ يسمع تأنيب البراهينِ",5,"ن",1,1],["مَنَاطُ نِظَامِهَا حَزْمٌ وَعَزْمٌ","وَمَجْلَى حُسْنِهَا كَرَمٌ وَطِيبُ",6,"ب",1,0],["مِن أَطيَبِ الطَيِّبينَ خيماً","كُنتَ وَمِن أَكرَمِ الكِرامِ",7,"م",1,0],["مَنْ أَطلقَ النِّيلَ أَمْسى وهْوَ يحبِسهُ","جمالُ، يثني عليكَ المُطَلقُ العاني",8,"ن",2,0],["من أطلعوه على سرّ فنمَّ به","فذاك مثل يبين الناس طيّاشا",9,"ش",2,0],["من أطنب القرآن في مديحه","فاعجز البليغ عن توضيحه",10,"ه",1,0],["مَنَاطَ النَّجمِ كَانَت فَاطَّبَتهَا","خَطَاطِيفَ الدراهم للبلاد",11,"د",1,0],["من أطاع الهوى فأقلقه الشو","ق لقي بالصدود خطبا شديدا",12,"د",2,0],["مَن أَطلَقَ الطَرفَ اِجتَنى شَهوَةً","وَحارِسُ الشَهوَةِ غَضُّ البَصر",13,"ر",1,1],["مَناطِقهُ في خِصرِهِ أَبَداً حَيرى","كَحيرة قَلبي بَعدَ ما زايل الصَبرا",14,"ر",2,0],["من أطلع القمر المنير إذا دجى","ليلٌ فشابه صحبه بضيائه",15,"ا",3,0],["من أطلعت صنعاء نجم حضارة","عمت بأنفس روعة وأجلها",16,"ل",3,0],["مناط كلا الأمرين غيب مقدس","وجود له منه عليه مترجم",17,"م",1,0]]}