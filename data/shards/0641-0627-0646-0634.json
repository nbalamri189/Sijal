wan.net/poem60228.html","المنسرح"],[477,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[477,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[498,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[511,"وقد كان يسبي القلب في كل ليلة","https://www.aldiwan.net/poem67769.html","الطويل"],[514,"كسيت ولم املك سوادا وتحته","https://www.aldiwan.net/poem48646.html","الطويل"],[527,"أجزتك يا عبد الرحيم بكل ما","https://www.aldiwan.net/poem37424.html","الطويل"],[536,"أعبد اللطيف أجب عمرا","https://www.aldiwan.net/poem47462.html","عموديه"],[536,"بربه في شؤونه ذو اعتصام","https://www.aldiwan.net/poem47985.html","عموديه"],[549,"لا تنظري اليوم يا سلمى إلي فما","https://www.aldiwan.net/poem47770.html","البسيط"],[551,"ولا خير في ود امرئ متكاره","https://www.aldiwan.net/poem68277.html","الطويل"],[551,"وقفتك لم أمدحك لا لمذمة","https://www.aldiwan.net/poem68390.html","الطويل"],[556,"لمن أشتكي ما بي وما بي هو الله","https://www.aldiwan.net/poem33587.html","الطويل"],[556,"سواكم روى عنكم سوانا روى عنا","https://www.aldiwan.net/poem33841.html","الطويل"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[556,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[557,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"],[560,"تجلى في منازلنا هلال","https://www.aldiwan.net/poem52634.html","الوافر"],[565,"هو يوم شك علي","https://www.aldiwan.net/poem69457.html","مجزوء الكامل"],[568,"إن تك حرب فلم أجنها","https://www.aldiwan.net/poem59474.html","المتقارب"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["فَإِن شاءَ فَالوَسمُ الَّذي قَد عَرَفتُهُ","مُبينٌ لِعَينِ الناظِرِ المُتَوَسِّمِ",0,"م",1,0],["فَإِن شِئتِ حَرَّمتُ النِساءَ سِواكُمُ","بِحَلفٍ وَأَيمانٍ وَحُقَّ لَكُم حِلفي",1,"ي",1,0],["فَانْشُرْ بِهِ ذِكْراً وَفَخْراً وَاسْتَزِدْ","مِنْ أَجْلِهِ أَجْراً بِكُلِّ مَكَانِ",2,"ن",1,0],["فَإِنْ شَكْوْنَا إِلَيهِمْ مَا نُكَابِدُهُ","شَكَوْا مِنَ الْبُعْدِ عَنَّا مِثْلَ شَكْوَانَا",3,"ن",2,0],["فإنْ شكَتْ أسْيافُها منْ دَمي","يَقولُ للألْحاظِ مَهْ جُوروا",4,"ر",3,0],["فَإِنْ شِئْتَ إِخْلاَصاً فُؤَادُكَ خَالِصٌ","وَيَا دُرَّةً مَا حَازَهَا قَطُّ غَائِصُ",5,"ص",1,0],["فإنْ شِئْتَ في بحْرِ النّدى منْهُ فاغْتَرِفْ","وإنْ شِئْتَ في نارِ الهُدَى منْهُ فاقْبِسِ",6,"س",1,0],["فَإِن شِئتِ أَن تُهدي لِقَومِيَ فَاِسأَلي","عَنِ العِزِّ وَالإِحسانِ أَينَ مَصيرُها",7,"ر",3,0],["فَأَنشَأوا أَلفَ كُتّابٍ وَقَد عَلِموا","أَنَّ المَصابيحَ لا تُغني عَنِ الشُهُبِ",8,"ب",1,0],["فَأَنشَدتُهُ شِعراً تَخَيَّرتُ بَحرَهُ","فَرَقَّت مَعانيهِ وَراقَت مَذاهِبُه",9,"ب",2,0],["فَأَنشَبَ أَظفارَهُ في النِس","فَقُلتُ هُبِلتَ أَلا تَنتَصِر",10,"ر",1,0],["فَإِن شِئتَ قُلتَ لَهُ صادِقاً","وَجَدتُكَ بِالقُفِّ ضَبّاً جَحولا",11,"ل",2,0],["فَإِنَّ شِفائي نَظرَة إِن نَظَرتُها","إِلى ثافِلٍ يَوماً وَخَلفي شَنائِكُ",12,"ك",1,0],["فإِنْ شئت تشبيهاً له عن حقيقةٍ","تصيب بها المرمى وبوركتَ راميا",13,"ي",2,0],["فأنشأتَ برجاً صاعداً متنزّلاً","يكون رسولاً بينَهُنّ مداريا",13,"ي",2,0],["فإن شئت من بحر السماحة فاغترفْ","وإن شئت من نصر الهداية فاقبِسِ",14,"س",1,0],["فإن شئت يا هربر صموئيل فاختبر","خلائق منا لا تميل إلى الغَدْر",15,"ر",1,0],["فَإِن شِئتَ مِن قَيسٍ ذُرى مُتَمَنِّعٍ","وَإِن شِئتَ طَوداً خِندِفِيَّ المَخارِمِ",16,"م",1,0],["فَإِن شِئتَ كانَ اليَشكُرِيّونَ بَينَنا","بِحُكمِ كَريمٍ بِالفَريضَةِ عالِمِ",17,"م",1,0],["فَأَنشِد يا فَرَزدَقُ غَيرَ عالٍ","فَقَبلَ اليَومِ جَدَّعَكَ النَشيدُ",18,"د",1,0],["فإن شاء فليسكت وإن شاء فليقم","إلى حيث ألقت رحلها أمّ قشعم",19,"م",1,0],["فإن شئتمُ ورد الغمام بأفقكم","أطلتم خيال المستقي لركيّه",20,"ي",2,0],["فَإِن شِئتَ واصِلهُ وَإِن شِئتَ بِالجَفا","فَلَستُ أَرى قَلبي لِغَيرِكَ يَصلُحُ",21,"ح",1,0],["فإن شاء أن يأسَى أطاع له الأسى","وإن شاء صبراً جاءهُ الصبرُ يُجلَبُ",22,"ب",1,0],["فإن شمخت من بعد ذاك فإنني","قَذوعٌ لآنافٍ قليلٍ قُذوعها",23,"ع",3,0],["فأنشقَ أنفها من نَتْن فيه","كما أنشقْتَنا من نَتْن فيكا",24,"ك",2,0],["فإن شئتَ فاعذرني وإن شئت فالحَني","كلانا مُليم غيرَ أني ألْوَمُ",25,"م",1,0],["فَإِن شِئتُمُ عَنّي نَهَيتُم سَفيهَكُم","وَقالَ لَهُ ذو حِلمُكُم أَينَ تَذهَبُ",26,"ب",1,0],["فَإِن شِئتَ فَاِبكِ وَإِن شِئتَ دَع","فَهَذا إِلَيكَ وَهَذا إِلَيك",27,"ك",1,0],["فإن شئت خذ نورها مرهما","وخذ هدبها للتداوى فتيلا",28,"ل",2,0],["فَإِن شِئتَ تَحيا حَياةَ الكِبارِ","يُؤَمِّلُكَ الكُلُّ أَو يَحذرُ",29,"ر",1,0],["فَإِن شَقِيَت بِأَيديهِم جِيادي","لَقَد شَقِيَت بِمُنصُلِيَ الوُجوهُ",30,"و",2,0],["فَإِن شَهَروا الماذِيَّ كَي ما يُرَهِّبوا","شَهَرتَ لَهُم بَأساً عَلَيهِم مُحَقِّقا",31,"ق",2,0],["فإن شغلت يسراك ألام سقطة","لما شغلت يمناك عن فيض نائل",32,"ل",1,0],["فَإنْ شِئْتَ أن تَحْظى بِوَصْلِ غَزالَةٍ","مُهَفَهْفَةِ الكَشْحَيْنِ أو بِغَزالِ",33,"ل",1,0],["فَإِن شِئتَ أَن تَختَر لِنَفسِكَ حُرَّةً","عَلَيكَ بِبَيتِ الجودِ خُذ مِن خيارِهِ",34,"ر",2,0],["فَإِن شَنَّعَ الأَعداءُ عَنّي بِضِدِّهِ","فَلا تَشهَدوا إِلّا بِمَسموعِكُم مِنّي",35,"ي",1,0],["فَإِن شِئتَ يَوماً شُربَها فَاِتَّخِذ لَها","حَكيماً لَبيباً أَو نَديما مُهَذَّبا",36,"ب",2,0],["فَإِن شاقَ صَدرُ الخَودِ وَالنَهدُ مَعشَراً","يَشوقُكَ صَدرُ الدِستِ وَالفَرَسُ النَهدُ",37,"د",1,0],["فَإِن شَهِدَ المَقامَةَ يَومَ فَصلٍ","رَأَيتَ نَظيرَ لُقمانِ الحَكيمِ",38,"م",1,0],["فأنشدَهُ الحصنُ المنيعُ ملكتني","ولو أنني فوقَ السماكينِ نازلُ",39,"ل",1,0],["فَإِن شِئتِ هاتي نازِعيني خُصومَةً","وَإِن شِئتِ قَتلاً إِنَّ حُكمَكِ أَعدَلُ",40,"ل",1,0],["فَأُنشِدُها أَن تَجزِيَ الهَونَ وَالهَوى","وَتَمنَحَ نَفساً طالَ مَطلاً حُقوقُها",41,"ق",3,0],["فَاِنشُري حبهما في العلم","رَمزنا عَقد الثريا في الدَم",42,"م",1,0],["فَإِنَّ شِفاءَ الداءِ إِدراكُ ذَحلَةٍ","صَباحاً عَلى آثارِ حَومٍ عَرَمرَمِ",43,"م",1,0],["فَإِن شِئتِ أَحرَمتُ النِساءَ سِواكُمُ","وَإِن شِئتِ لَم أَطعَم نُقاخاً وَلا بَردا",44,"د",2,0],["فإنْ شَكَوْا بِغْضَةً مِمَّنْ مَضَى سَلَفَتْ","فما لِقَلْبٍ عَلَى البَغْضَاءِ مُصْطَبَرُ",45,"ر",1,0],["فإن شَمَّرُوا عِن ساقِ ظُلمِي فإنّني","لِذَمِّهِمُ عَن ساقِ جَدِّي مُشَمِّرُ",46,"ر",1,0],["فَإِن شَكَوتُ إِلَيهِ","ما قَد جَرى مِنهُ أَنكَر",47,"ر",1,0],["فَأَنشَدتُهُ مِدَحَ البَرمَكِيِّ","أَبي الفَضلِ أَعني الفَتى جَعفَرا",48,"ر",2,0],["فَإِن شَكا يَوماً جَواً باطِناً","قالَ لَهُ صَبراً وَعَزّاهُ",49,"ا",2,0],["فأنشدني يخوّفني","وورّدَ دمعَه بدم",50,"م",1,0],["فَإِن شِئتِ أَحرَمتُ وَصلَ النِساء","وَإِن شِئتِ لَم أَطعَمِ البارِدا",51,"د",2,0],["فَاِنشَقَّ عَنها عَمودُ الصُبحِ جافِلَةً","عَدوَ النَحوصِ تَخافُ القانِصَ اللَحِما",52,"م",2,0],["فَإِن شِئتَ أَن تُحظى بِمالِكَ فَاِحبُهُ","ذَوي الحاجِ أَو أَنفِقهُ تَبسُم لَكَ الجُهمُ",53,"م",1,0],["فَإِن شِئتُم فَاِرموا سُهوباً رَحيبَةً","وَإِن شِئتُم فَاِعلوا مَناكِبَها الشَمّا",54,"م",2,0],["فأنشب فيها الداء أَظفار فتكه","وأعجز من قد كان في الطب يمهر",55,"ر",1,0],["فإن شتمونا بعد ذلك كله","فما نحن للقوم المسيئين نشتم",56,"م",1,0],["فانشدوني بين أمواج الضياءِ","وانشدوا فوق البحيرات لقائي",57,"ي",1,0],["فإن شارفَ الأرضَ نادتْ بهِ","ففَتَّحَ عيناً كعينِ الرَّبيعْ",58,"ع",1,0],["فإنْ شئتِ أرجعتُها ثانياً","مضاعفةً للفمِ المنعمِ",59,"م",1,0],["فَإِنْ شَهِدْتِ زَمَاناً رَاحَ أَجْدَرُهُ","بِشُكْرِ نعمَاكِ وَهْوَ الجَاحِدُ الشَّاكِي",60,"ك",2,0],["فَانْشُدْ نَشِيدَ الأَمَانِي رُبَّ قَافِلَةٍ","قَدْ أَبْطَأَتْ في السَّرَى تَشْدُو بِهِ حُقُبَا",61,"ب",2,0],["فَأَنشَبَ أَظفارَهُ في النِسا","فَقُلتُ هُبِلتَ أَلا تَنتَصِر",62,"ر",1,0],["فَانْشُدِ الأَطْيَارَ واحِدَها","في الْحُلَى والْحُسْنِ والْجَدَن",63,"ن",1,0],["فانشر العدلَ والمساواة فينا","لا رَعى اللهُ عهدَ الاستثناء",64,"ا",2,0],["فَإنَّ شَفَاءَ الدَّاءِ إدْرَاكُ نُحْلَةٍ","صياحٌ عَلَى آثَارِ حَوْمٍ عَرَمْرَمِ",65,"م",1,0],["فانشقّ عنها عمودُ الصبح ، جافلة ً","، عدوَ الحوص تخافُ القانصَ اللحما",66,"م",2,0],["فانْ شابَها ما لم تجدْ عنه نُدحةً","شَفَعْتَ به حُكم الظروف مُسايرا",67,"ر",2,0],["فَإنْ شِئْتِ حَرَّمْتُ النِّساءَ سِوَاكُمُ","وَإنْ شِئْتُ لَم أَطْعَم نُقاخاً ولا بَرْدا",68,"د",2,0],["فَإِن شِئتَ وَصفاً بالِغاً ما بَلَغتَهُ","فَقِف حَيثُ فُتَّ الوَصلَ نَجعَل لَهُ حَدّا",69,"د",2,0],["فَإِن شَرِكوا الرومَ في شِركِهِم","فَما رُزِقوا الحَظَّ مِن مُلكِهِم",70,"م",1,