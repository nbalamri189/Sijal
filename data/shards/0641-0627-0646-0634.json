{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[55,"سرى طيف فوز آخر الليل بالطف","https://www.aldiwan.net/poem26241.html","الطويل"],[77,"لما رأيت الأرض دونك قدرها","https://www.aldiwan.net/poem36068.html","الكامل"],[77,"هات الحديث عن الركب الذي بانا","https://www.aldiwan.net/poem36075.html","البسيط"],[77,"أغرى بي الشامت ألحاظه","https://www.aldiwan.net/poem36513.html","السريع"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[77,"ألما على شط الفرات المقدس","https://www.aldiwan.net/poem35873.html","الطويل"],[9,"ألا حي ميا إذ أجد بكورها","https://www.aldiwan.net/poem21932.html","الطويل"],[86,"إن كنتم تبذلون المال عن رهب","https://www.aldiwan.net/poem10919.html","البسيط"],[71,"ظننت سليمانا جوادا يهزه","https://www.aldiwan.net/poem3738.html","الطويل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[35,"توهمت بالخيف رسما محيلا","https://www.aldiwan.net/poem39118.html","المتقارب"],[35,"شجا قلبه أظعان سعدى السوالك","https://www.aldiwan.net/poem39121.html","الطويل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[83,"أدرها ثلاثا من لحاظك واحبس","https://www.aldiwan.net/poem54280.html","الطويل"],[88,"خطاب يهودا قد دعانا إلى الفكر","https://www.aldiwan.net/poem44821.html","الطويل"],[27,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[27,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[72,"بكيت بأجفان المحب المتيم","https://www.aldiwan.net/poem19671.html","الطويل"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[64,"وكان فؤادي خاليا قبل حبكم","https://www.aldiwan.net/poem67569.html","الطويل"],[51,"أرى الصبر محمودا وعنه مذاهب","https://www.aldiwan.net/poem8316.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"ندمت على أن كنت يوما دعوتني","https://www.aldiwan.net/poem66019.html","الطويل"],[14,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem38318.html","الطويل"],[70,"أيا باكيا لزمان الصبا","https://www.aldiwan.net/poem42382.html","المتقارب"],[85,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[43,"لئن تك طيئ كانت لئاما","https://www.aldiwan.net/poem10602.html","الوافر"],[45,"لأوشك شعب الحي أن يتفرقا","https://www.aldiwan.net/poem65185.html","الطويل"],[61,"أمير العلا لا زلت كهفا لآمل","https://www.aldiwan.net/poem51330.html","الطويل"],[61,"إلام يروم الحاسدون نضالي","https://www.aldiwan.net/poem51479.html","الطويل"],[58,"رأتك الليالي يا ابن آدم ظالما","https://www.aldiwan.net/poem31011.html","الطويل"],[66,"شهدت بأني عبد مغناكم الذي","https://www.aldiwan.net/poem38518.html","الطويل"],[66,"أدرها بلطف واجعل الرفق مذهبا","https://www.aldiwan.net/poem39207.html","الطويل"],[66,"صروف الليالي لا يدوم لها عهد","https://www.aldiwan.net/poem40127.html","الطويل"],[44,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[69,"جهادك مقبول وعامك قابل","https://www.aldiwan.net/poem28976.html","الطويل"],[33,"ألا أيها القلب اللجوج المعذل","https://www.aldiwan.net/poem25851.html","الطويل"],[33,"فيا ليت ليلى وافقت كل حجة","https://www.aldiwan.net/poem25859.html","الطويل"],[102,"ديننا حبك يا هذا الوطن","https://www.aldiwan.net/poem32909.html","الرمل"],[13,"جزى الله فتياناً على العوص أمطرت","https://www.aldiwan.net/poem2200.html","الطويل"],[40,"لقد أرسلت في السر ليلى تلومني","https://www.aldiwan.net/poem42302.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[48,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[48,"وما أنزر الطرف فيمن نرى","https://www.aldiwan.net/poem63388.html","المتقارب"],[48,"متيم القلب معناه","https://www.aldiwan.net/poem66182.html","السريع"],[48,"مجون صب في صنم","https://www.aldiwan.net/poem66283.html","مجزوء الوافر"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[46,"كبار أناس مثل جلة سائم","https://www.aldiwan.net/poem23283.html","الطويل"],[46,"تصدق على الأعمى بأخذ يمينه","https://www.aldiwan.net/poem23333.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39604","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1940","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[13,"جَزَى اللَّهُ فِتْيَاناً عَلَى العَوْصِ أَمْطَرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180822",""],[7,"بانَتْ سُعادُ، وأمْسَى حَبلُها انجذما،","https://www.poetsgate.com/ViewPoem.aspx?id=17587",""],[90,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[31,"لَقَدْ أَرْسَلَتْ في السِّرِّ لَيْلَى تَلُومُني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18822&r=&rc=85",""]],"verses":[["فَإِن شاءَ فَالوَسمُ الَّذي قَد عَرَفتُهُ","مُبينٌ لِعَينِ الناظِرِ المُتَوَسِّمِ",0,"م",1,0],["فَإِن شِئتِ حَرَّمتُ النِساءَ سِواكُمُ","بِحَلفٍ وَأَيمانٍ وَحُقَّ لَكُم حِلفي",1,"ي",1,0],["فَانْشُرْ بِهِ ذِكْراً وَفَخْراً وَاسْتَزِدْ","مِنْ أَجْلِهِ أَجْراً بِكُلِّ مَكَانِ",2,"ن",1,0],["فَإِنْ شَكْوْنَا إِلَيهِمْ مَا نُكَابِدُهُ","شَكَوْا مِنَ الْبُعْدِ عَنَّا مِثْلَ شَكْوَانَا",3,"ن",2,0],["فإنْ شكَتْ أسْيافُها منْ دَمي","يَقولُ للألْحاظِ مَهْ جُوروا",4,"ر",3,0],["فَإِنْ شِئْتَ إِخْلاَصاً فُؤَادُكَ خَالِصٌ","وَيَا دُرَّةً مَا حَازَهَا قَطُّ غَائِصُ",5,"ص",1,0],["فإنْ شِئْتَ في بحْرِ النّدى منْهُ فاغْتَرِفْ","وإنْ شِئْتَ في نارِ الهُدَى منْهُ فاقْبِسِ",6,"س",1,0],["فَإِن شِئتِ أَن تُهدي لِقَومِيَ فَاِسأَلي","عَنِ العِزِّ وَالإِحسانِ أَينَ مَصيرُها",7,"ر",3,0],["فَأَنشَأوا أَلفَ كُتّابٍ وَقَد عَلِموا","أَنَّ المَصابيحَ لا تُغني عَنِ الشُهُبِ",8,"ب",1,0],["فَأَنشَدتُهُ شِعراً تَخَيَّرتُ بَحرَهُ","فَرَقَّت مَعانيهِ وَراقَت مَذاهِبُه",9,"ب",2,0],["فَأَنشَبَ أَظفارَهُ في النِس","فَقُلتُ هُبِلتَ أَلا تَنتَصِر",10,"ر",1,0],["فَإِن شِئتَ قُلتَ لَهُ صادِقاً","وَجَدتُكَ بِالقُفِّ ضَبّاً جَحولا",11,"ل",2,0],["فَإِنَّ شِفائي نَظرَة إِن نَظَرتُها","إِلى ثافِلٍ يَوماً وَخَلفي شَنائِكُ",12,"ك",1,0],["فإِنْ شئت تشبيهاً له عن حقيقةٍ","تصيب بها المرمى وبوركتَ راميا",13,"ي",2,0],["فأنشأتَ برجاً صاعداً متنزّلاً","يكون رسولاً بينَهُنّ مداريا",13,"ي",2,0],["فإن شئت من بحر السماحة فاغترفْ","وإن شئت من نصر الهداية فاقبِسِ",14,"س",1,0],["فإن شئت يا هربر صموئيل فاختبر","خلائق منا لا تميل إلى الغَدْر",15,"ر",1,0],["فَإِن شِئتَ مِن قَيسٍ ذُرى مُتَمَنِّعٍ","وَإِن شِئتَ طَوداً خِندِفِيَّ المَخارِمِ",16,"م",1,0],["فَإِن شِئتَ كانَ اليَشكُرِيّونَ بَينَنا","بِحُكمِ كَريمٍ بِالفَريضَةِ عالِمِ",17,"م",1,0],["فَأَنشِد يا فَرَزدَقُ غَيرَ عالٍ","فَقَبلَ اليَومِ جَدَّعَكَ النَشيدُ",18,"د",1,0],["فإن شاء فليسكت وإن شاء فليقم","إلى حيث ألقت رحلها أمّ قشعم",19,"م",1,0],["فإن شئتمُ ورد الغمام بأفقكم","أطلتم خيال المستقي لركيّه",20,"ي",2,0],["فَإِن شِئتَ واصِلهُ وَإِن شِئتَ بِالجَفا","فَلَستُ أَرى قَلبي لِغَيرِكَ يَصلُحُ",21,"ح",1,0],["فإن شاء أن يأسَى أطاع له الأسى","وإن شاء صبراً جاءهُ الصبرُ يُجلَبُ",22,"ب",1,0],["فإن شمخت من بعد ذاك فإنني","قَذوعٌ لآنافٍ قليلٍ قُذوعها",23,"ع",3,0],["فأنشقَ أنفها من نَتْن فيه","كما أنشقْتَنا من نَتْن فيكا",24,"ك",2,0],["فإن شئتَ فاعذرني وإن شئت فالحَني","كلانا مُليم غيرَ أني ألْوَمُ",25,"م",1,0],["فَإِن شِئتُمُ عَنّي نَهَيتُم سَفيهَكُم","وَقالَ لَهُ ذو حِلمُكُم أَينَ تَذهَبُ",26,"ب",1,0],["فَإِن شِئتَ فَاِبكِ وَإِن شِئتَ دَع","فَهَذا إِلَيكَ وَهَذا إِلَيك",27,"ك",1,0],["فإن شئت خذ نورها مرهما","وخذ هدبها للتداوى فتيلا",28,"ل",2,0],["فَإِن شِئتَ تَحيا حَياةَ الكِبارِ","يُؤَمِّلُكَ الكُلُّ أَو يَحذرُ",29,"ر",1,0],["فَإِن شَقِيَت بِأَيديهِم جِيادي","لَقَد شَقِيَت بِمُنصُلِيَ الوُجوهُ",30,"و",2,0],["فَإِن شَهَروا الماذِيَّ كَي ما يُرَهِّبوا","شَهَرتَ لَهُم بَأساً عَلَيهِم مُحَقِّقا",31,"ق",2,0],["فإن شغلت يسراك ألام سقطة","لما شغلت يمناك عن فيض نائل",32,"ل",1,0],["فَإنْ شِئْتَ أن تَحْظى بِوَصْلِ غَزالَةٍ","مُهَفَهْفَةِ الكَشْحَيْنِ أو بِغَزالِ",33,"ل",1,0],["فَإِن شِئتَ أَن تَختَر لِنَفسِكَ حُرَّةً","عَلَيكَ بِبَيتِ الجودِ خُذ مِن خيارِهِ",34,"ر",2,0],["فَإِن شَنَّعَ الأَعداءُ عَنّي بِضِدِّهِ","فَلا تَشهَدوا إِلّا بِمَسموعِكُم مِنّي",35,"ي",1,0],["فَإِن شِئتَ يَوماً شُربَها فَاِتَّخِذ لَها","حَكيماً لَبيباً أَو نَديما مُهَذَّبا",36,"ب",2,0],["فَإِن شاقَ صَدرُ الخَودِ وَالنَهدُ مَعشَراً","يَشوقُكَ صَدرُ الدِستِ وَالفَرَسُ النَهدُ",37,"د",1,0],["فَإِن شَهِدَ المَقامَةَ يَومَ فَصلٍ","رَأَيتَ نَظيرَ لُقمانِ الحَكيمِ",38,"م",1,0],["فأنشدَهُ الحصنُ المنيعُ ملكتني","ولو أنني فوقَ السماكينِ نازلُ",39,"ل",1,0],["فَإِن شِئتِ هاتي نازِعيني خُصومَةً","وَإِن شِئتِ قَتلاً إِنَّ حُكمَكِ أَعدَلُ",40,"ل",1,0],["فَأُنشِدُها أَن تَجزِيَ الهَونَ وَالهَوى","وَتَمنَحَ نَفساً طالَ مَطلاً حُقوقُها",41,"ق",3,0],["فَاِنشُري حبهما في العلم","رَمزنا عَقد الثريا في الدَم",42,"م",1,0],["فَإِنَّ شِفاءَ الداءِ إِدراكُ ذَحلَةٍ","صَباحاً عَلى آثارِ حَومٍ عَرَمرَمِ",43,"م",1,0],["فَإِن شِئتِ أَحرَمتُ النِساءَ سِواكُمُ","وَإِن شِئتِ لَم أَطعَم نُقاخاً وَلا بَردا",44,"د",2,0],["فإنْ شَكَوْا بِغْضَةً مِمَّنْ مَضَى سَلَفَتْ","فما لِقَلْبٍ عَلَى البَغْضَاءِ مُصْطَبَرُ",45,"ر",1,0],["فإن شَمَّرُوا عِن ساقِ ظُلمِي فإنّني","لِذَمِّهِمُ عَن ساقِ جَدِّي مُشَمِّرُ",46,"ر",1,0],["فَإِن شَكَوتُ إِلَيهِ","ما قَد جَرى مِنهُ أَنكَر",47,"ر",1,0],["فَأَنشَدتُهُ مِدَحَ البَرمَكِيِّ","أَبي الفَضلِ أَعني الفَتى جَعفَرا",48,"ر",2,0],["فَإِن شَكا يَوماً جَواً باطِناً","قالَ لَهُ صَبراً وَعَزّاهُ",49,"ا",2,0],["فأنشدني يخوّفني","وورّدَ دمعَه بدم",50,"م",1,0],["فَإِن شِئتِ أَحرَمتُ وَصلَ النِساء","وَإِن شِئتِ لَم أَطعَمِ البارِدا",51,"د",2,0],["فَاِنشَقَّ عَنها عَمودُ الصُبحِ جافِلَةً","عَدوَ النَحوصِ تَخافُ القانِصَ اللَحِما",52,"م",2,0],["فَإِن شِئتَ أَن تُحظى بِمالِكَ فَاِحبُهُ","ذَوي الحاجِ أَو أَنفِقهُ تَبسُم لَكَ الجُهمُ",53,"م",1,0],["فَإِن شِئتُم فَاِرموا سُهوباً رَحيبَةً","وَإِن شِئتُم فَاِعلوا مَناكِبَها الشَمّا",54,"م",2,0],["فأنشب فيها الداء أَظفار فتكه","وأعجز من قد كان في الطب يمهر",55,"ر",1,0],["فإن شتمونا بعد ذلك كله","فما نحن للقوم المسيئين نشتم",56,"م",1,0],["فانشدوني بين أمواج الضياءِ","وانشدوا فوق البحيرات لقائي",57,"ي",1,0],["فإن شارفَ الأرضَ نادتْ بهِ","ففَتَّحَ عيناً كعينِ الرَّبيعْ",58,"ع",1,0],["فإنْ شئتِ أرجعتُها ثانياً","مضاعفةً للفمِ المنعمِ",59,"م",1,0],["فَإِنْ شَهِدْتِ زَمَاناً رَاحَ أَجْدَرُهُ","بِشُكْرِ نعمَاكِ وَهْوَ الجَاحِدُ الشَّاكِي",60,"ك",2,0],["فَانْشُدْ نَشِيدَ الأَمَانِي رُبَّ قَافِلَةٍ","قَدْ أَبْطَأَتْ في السَّرَى تَشْدُو بِهِ حُقُبَا",61,"ب",2,0],["فَأَنشَبَ أَظفارَهُ في النِسا","فَقُلتُ هُبِلتَ أَلا تَنتَصِر",62,"ر",1,0],["فَانْشُدِ الأَطْيَارَ واحِدَها","في الْحُلَى والْحُسْنِ والْجَدَن",63,"ن",1,0],["فانشر العدلَ والمساواة فينا","لا رَعى اللهُ عهدَ الاستثناء",64,"ا",2,0],["فَإنَّ شَفَاءَ الدَّاءِ إدْرَاكُ نُحْلَةٍ","صياحٌ عَلَى آثَارِ حَوْمٍ عَرَمْرَمِ",65,"م",1,0],["فانشقّ عنها عمودُ الصبح ، جافلة ً","، عدوَ الحوص تخافُ القانصَ اللحما",66,"م",2,0],["فانْ شابَها ما لم تجدْ عنه نُدحةً","شَفَعْتَ به حُكم الظروف مُسايرا",67,"ر",2,0],["فَإنْ شِئْتِ حَرَّمْتُ النِّساءَ سِوَاكُمُ","وَإنْ شِئْتُ لَم أَطْعَم نُقاخاً ولا بَرْدا",68,"د",2,0]]}