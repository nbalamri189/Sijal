{"poems":[[55,"يا ليلة كرم الزمان","https://www.aldiwan.net/poem29946.html","مجزوء الكامل"],[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[53,"وخل كخلم السوء أنكرت وده","https://www.aldiwan.net/poem62857.html","الطويل"],[53,"وخلته أن نكر الدهر منظري","https://www.aldiwan.net/poem62858.html","الطويل"],[146,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[237,"بدا فأراني الظبي والغصن والبدرا","https://www.aldiwan.net/poem14761.html","الطويل"],[466,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[466,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[469,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[572,"يا حبذا يومنا ونحن على","https://www.aldiwan.net/poem69548.html","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31511","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93369","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100348","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92022","الطويل"],[4011,"","https://poetry.dctabudhabi.ae/diwan/poem/45531","الطويل"],[4876,"كالغيب","https://www.poetsgate.com/ViewPoem.aspx?id=207495",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[572,"يا حبَّذَا يومُنَا ونحنَ على","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9501&r=&rc=358",""]],"verses":[["كانَ اِتِّفاقٌ بَينَنا","جارٍ عَلى غَيرِ اِتِّفاقِ",0,"ق",1,0],["كَأَنّا تُغَني بَينَنا كُلَّ لَيلَةٍ","جَداجِدُ صَيفٍ مِن صَريرِ المَآخِرِ",1,"ر",1,0],["كأنا تعاقدْنا الخلالة بيننا","على أنني بَسْلٌ على الدهر أو حِجْرُ",2,"ر",1,0],["كأنا تعاقدنا الخلالة بيننا","لوجهٍ طرير أو لخلْقٍ مصوَّر",3,"ر",1,0],["كان اتفاقا ولَعى بِسربكم","وشرُّ أحداثِ الليالي ما اتفقْ",4,"ق",1,0],["كانَ أَتقى للَّه مِن كلِّ عبدٍ","أينَ منهُ العبادُ والأتقياءُ",5,"ا",2,0],["كَأَنّا تَعادينا السَقامَ لِحاجَةٍ","فَأَمرَضَني جِسماً وَأَنحَلتهُ خَصرا",6,"ر",2,0],["كأن أتيَّاً عن رعْنِ أيْهمٍ","تمطُّره إِثر العدو المُباسل",7,"ل",1,0],["كأنَّ أتِيّاً ذا غُثاءٍ إِذا غَزا","دماءُ الأعادي بالفلاةِ وهامُها",8,"م",3,0],["كانا تخوض بأشباحها","بحاراً من الآل من فوق سفن",9,"ن",1,0],["كَأَنَّ أُتْرُجَّهَا تَمِيْلُ بِهِ","أَغْصَانُهَا حَامِلاً وَمَحْمُولاَ",10,"ل",2,0],["كأنَّا تأهَّبنا لأوبة مقبلٍ","وكانَ ليأسٍ منكَ هذا التأهُّبُ",11,"ب",1,0],["كَأَنَّ أَتِيَّ السَيلِ مَدَّ عَلَيهِمُ","إِذا دَفَعَتهُ في البَداحِ الجَراشِعُ",12,"ع",1,0],["كَأَنّا تَمَتَّعنا لِقلَّة عمره","بِلمحةِ بَرقٍ أَو بِلَمحة طائِرِ",13,"ر",1,0],["كأنّ اتصال الدمع في جريانه","على النحر خيل تقطع البيد سبَّقا",14,"ق",2,0],["كأنا توسطنا الطَريق فمقبلٌ","وَماضٍ تَولَّى سيرَهنّ يريد",15,"د",1,0],["كأنا توافينا مع الليل مغزل","من الأدم جماء المدامع عوهجُ",16,"ج",1,0],["كأنَّا تحالفنا على الموتِ، مثلما","تحالفَ معْ أعمى البصيرةِ مقعَدُ",17,"د",1,0],["كأنّ اتقاد الحبّ نجمٌ بكوننا","وأرواحنا لفّت مدارا تساكنه",18,"ن",2,0],["كأَنَّ أَترُجَّهَا يميلُ بهِ","أغصانُهُ حاملاً ومحمولا",19,"ل",2,0]]}