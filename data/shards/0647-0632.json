ْ كَانَ نَاهٍ لابْنِ حَيَّة َ زَاجِراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26472&r=&rc=38",""]],"verses":[["هَزِجاتٌ مِنَ البُروقِ كَأَنَّ ال","بُلقَ فيها مَجرورَةُ الأَرسانِ",0,"ن",1,0],["هَزَزتُ المَواضي فَاِنثَنَت عَن ضَرائِبي","فَما أَرَبي في أَن أَهُزَّ كَليلَها",1,"ل",3,0],["هَزَّ المَجَرَّةَ أُفقُهُ وَكَأَنَّها","غُصنٌ بِأَحداقِ النُجومِ وَريقُ",2,"ق",1,0],["هَزَّ عِطفي إِلى الأَغَرِّ أَبي إِس","حَقَ وُدٌّ يَلوي عَلَيهِ صَليفي",3,"ف",2,0],["هَزِجُ الرُعودِ لَهُ بِكُلِّ ثَنيَّةٍ","زَجَلٌ كَشَقشَقَةِ الفَنيقِ الموضِعِ",4,"ع",1,0],["هَزِجِ البُروقِ كَأَنَّهُ مُتَمَطِّقٌ","بِأَراقِمٍ قِلنَ الرِمالَ نَضانِضِ",5,"ض",1,0],["هَزَّةَ الريحِ سَليماً","مِن وُصومٍ وَعُيوبِ",6,"ب",1,0],["هَزَّهُمْ بِالمَرْجِ ذِكْرى بابِلٍ","أنَّها مَرْمىً على العِيسِ شَسُوعُ",7,"ع",1,0],["هَزِجاً يَحُكُّ ذِراعَهُ بِذِراعِهِ","قَدحَ المُكِبِّ عَلى الزِنادِ الأَجذَمِ",8,"م",1,0],["هَزَمتُ تَميماً ثُمَّ جَندَلتُ كَبشَهُم","وَعُدتُ وَسَيفي مِن دَمِ القَومِ أَحمَرُ",9,"ر",1,0],["هَزِئَت أَن رَأَت غُلاماً حَديثَ ال","سِنِّ يَغشى الخُطوبَ فَهُوَ حَزينُ",10,"ن",1,0],["هَزِئَت بي وَنِلتُ ما شِئتُ مِنها","يا لَقَومي فَأَيُّنا المَغبونُ",10,"ن",1,0],["هَزَزْتُ أَبَا سَعِيد مِنْكَ دَوْحاً","بِهِ ما شِئْتُ مِنْ ظِلٍّ وَمَجْنَى",11,"ن",2,0],["هزَزْتَ الى إعْزازِها كُلَّ ذابِلٍ","وقُدْتَ الى إصْراخِها كُلَّ ذي لِبْدِ",12,"د",1,0],["هُزَّ منْ مِعْطَفَيْكَ ذابِلَ خَطٍّ","ذا قَوامٍ مُهَفْهَفٍ وانْدِماجِ",13,"ج",1,0],["هَزِجٌ عَلَيهِ التَومَتا","نِ إِذا نَشاءُ عَدا بِها",14,"ب",3,0],["هَزّوا مَغارِبَها فَهابَت بَأسَهُم","يا وَيلَكُم إِن لَم تَهُزّوا المَشرِقا",15,"ق",2,0],["هَزَّكَ البَيتُ الحَرامُ لَهُ","هِزَّةَ المُشتاقِ لِلوَطَنِ",16,"ن",1,0],["هزَبرٌ إِذا اِجتازِ الأُسودُ بغيلِهِ","فَأَشجَعُها خافي الخُطى خافِتُ الزارِ",17,"ر",1,0],["هَزَزنا بِهِ الصَمّامَ فَالعَزمُ حَدُّهُ","وَحِليَتُهُ العَليا وَإِفرِندُهُ البِشرُ",18,"ر",1,0],["هَزَّ مِنهُ الصَبا فَقَوَّمَ شَطراً","وَتَجافى عَنِ الوِشاحِ بِشَطرِ",19,"ر",1,0],["هِزَبرٌ هَريتُ الشَدقِ رِئبالُ غابَةٍ","مَخوفُ اللِقاءِ جائِبُ العَينِ أَنجَلُ",20,"ل",1,0],["هَزَّ ائْتِلافُهُمَا الدُّنْيَا وَبَشَّرَهَا","بِيُمْنِ حَالٍ لأَجْيَالٍ وَأَزْمَانِ",21,"ن",1,0],["هَزائِمُكَ الغُرُّ مَشهورَةٌ","يُقَرطِسُ فيهِنَّ مَن يَنضُلُ",22,"ل",1,0],["هَزَّ القَنا لانَ وَما تَخَضَّدا","يَركُضنَ رَيطَ اليَمَنِ المُعَضَّدا",23,"د",2,0],["هَزيمٌ كَأَنَّ البُلقَ مَجنوبَةً بِهِ","يُحامينَ أَمهاراً فَهُنَّ رَوامِحُ",24,"ح",1,0],["هزَزْت الطُور فهو يكاد يمشي","إليك على تَقَدُّسه احتراما",25,"م",2,0],["هَزّوا السُيوفَ فَأَشرَعوها فيكُمُ","وَذَوابِلاً يَخطِرنَ كَالأَشطانِ",26,"ن",1,0],["هَزِمٌ أَجَشُّ إِذا اِستَحارَ بِبَلدَةٍ","فَكَأَنَّما بِجِوائِها الأَنهارُ",27,"ر",1,0],["هزجات إذا أدرن على الكف","يُطَرِّبْنَ بالغناء المُديرا",28,"ر",2,1],["هززتكم لو أن فيكم مهزة","وذكرت ذا التأنيث فاستنوق الجمل",29,"ل",1,0],["هزَّت رؤوس السامعين بوصفه","طرباً فلم تحتج إلى تشبيب",30,"ب",1,0],["هُزءاً وسُخراً بما تنحّل والنا","سُ إذا ما تهكَّمُوا قلبوا",31,"ب",3,0],["هززتك فاغضبْ غضبةً جعفريةً","تكون على الأعداء راغية البَكرِ",32,"ر",1,0],["هز للماء هزمة كعصا مو","سى فأضحى عموده مفروقا",33,"ق",2,0],["هززتُكَ للحرمانِ فاقطع وتينَهُ","فما زلتَ صمْصاماً إذا هُزَّ صمَّما",34,"م",2,0],["هزَّهُ ماجدٌ يناصح في الهزْ","زِ هُمَامٌ مُتَوَّجٌ لهُمام",35,"م",1,0],["هَزَّ السِلاحَ لَهُنَّ مُصعَبُ قُفرَةٍ","مُتَخَمِّطٌ بِلُغامِهِ مَرثومُ",36,"م",1,0],["هَزَأَ الشاعِر مِنهُم قائِلاً","بَلَغَ السوسُ أُصولَ الشَجَرَه",37,"ر",2,0],["هَزَمَ الهَجرُ اِصطِباري","فَعَسى لِلوَصلِ رَدَّه",38,"د",2,0],["هز لحن به شدوت مجيدا","كل ما للقلوب من اوتار",39,"ر",1,0],["هزنا الفن في كمنجة سامي","وهو في اميرها الجحجاح",40,"ح",1,1],["هزت الليث ولما يَصح من","دم غليومَ وصيدٍ آخرين",41,"ن",1,0],["هَزَّت مَناكِبَها لَهُ فَكَأَنَّهُ","عُرسُ البَيانِ وَمَوكِبُ الأَقلامِ",42,"م",1,0],["هَزَّ الشَبابُ إِلى رَثائِكَ خاطِري","فَوَجَدتَ فِيَّ وَفي الشَبابِ وَفاءَ",43,"ا",2,0],["هَزَّ اللِواءُ بِعِزِّكَ الإِسلامُ","وَعَنَت لِقائِمِ سَيفِكَ الأَيّامُ",44,"م",1,1],["هَزَزتَ بَني الزَمانِ بِهِ صَبِيّاً","وَرُعتَ بِهِ بَني الدُنيا غُلاما",45,"م",2,0],["هُزّوا القُرى مِن كَهفِها وَرَقيمِها","أَنتُم لَعَمرُ اللَهِ أَعصابُ القُرى",46,"ر",2,0],["هَزَّت دِمَشقُ بَني أَيّوبَ فَاِنتَبِهوا","يَهنَئونَ بَني حَمدانَ في حَلَبِ",47,"ب",1,0],["هَزيمَةُ مَن لا هازِمٌ يَستَحِثُّهُ","وَلا طارِدٌ يَدعو لِذاكَ وَيوجِبُ",48,"ب",1,0],["هَزَّ اللِّواءَ على ما كانَ مِنْ سِنَةٍ","واهْتَزَّ ثُمَّ عَلا وارْتَجَّ ثُمَّ هَفا",49,"ف",2,0],["هَزَّ اللِواءَ بَنو عِجلٍ بِهِ فَغَدا","رَأساً لَهُم وَغَدا كُلٌّ لَهُم ذَنَبا",50,"ب",2,0],["هَزَمَت مَكارِمُهُ المَكارِمَ كُلَّها","حَتّى كَأَنَّ المَكرُماتِ قَنابِلُ",51,"ل",1,0],["هِزَبرٌ مَشى يَبغي هِزَبراً وَأَغلَبٌ","مِنَ القَومِ يَغشى باسِلَ الوَجهِ أَغلَبا",52,"ب",2,0],["هَزَّ مِنها شَرخُ الشَبابِ فَجالَت","فَوقَ خَصرٍ كَثيرِ جَولِ الوِشاحِ",53,"ح",1,0],["هَزلُهُ لِلسَماحِ شيمَتُهُ وَال","بَذلُ وَالحَزمُ وَالكِفايَةُ جِدُّه",54,"د",2,0],["هَزَرناهُ لِأَحداثِ اللَيالي","فَأَحمَدنا مَضارِبَ ذي الفَقارِ",55,"ر",1,0],["هَزيعُ دُجاً في الرَأسِ بادَرَهُ بَدرُ","وَلَيلٌ جَلاهُ لا صَباحٌ وَلا فَجرُ",56,"ر",1,1],["هَزَّ عِطفَيهِ النَدى مُكتَسِياً","وَرَقَ الحَمدِ أَثيثاً يَأتَلِق",57,"ق",1,0],["هَزِجُ الصَهيلِ كَأَنَّ في نَغَماتِهِ","نَبَراتِ مَعبَدَ في الثَقيلِ الأَوَّلِ",58,"ل",1,0],["هَزَّهُ العَجَبُ فَوَلّى","يَتَثَنّى كَالعِنانِ",59,"ن",1,0],["هِزَبرٌ يَرفِتُ القَصَراتِ رَفتاً","أَبى لِعُداتِهِ إِلّا اِغتِصابا",60,"ب",2,0],["هِزَبرٌ تَفادى الأُسدُ مِن وَثَباتِهِ","لَهُ مَربِضٌ عَنهُ يَحيدُ المُسافِرُ",61,"ر",1,0],["هِزَبرٌ هَريتُ الشَدقِ رِئبالُ غابَةٍ","إِذا سارَ عَزَّتهُ يَداهُ وَكاهِلُه",62,"ل",2,0],["هِزَبرٍ إِذا أَشبالَهُ سِرنَ حَولَهُ","تَشَظَّت سِباعُ الأَرضِ مِن ذي النَحائِمِ",63,"م",1,0],["هَزيعُ شَبيبَةٍ طَلَعَتْ عليه","كواكِبُه فرصَّعَتِ الهَزيعا",64,"ع",2,0],["هَزَزتُكَ هِزَّةَ السَيفِ المُحَلّى","فَلَمّا أَن ضَرَبتُ بِكَ اِنثَنَيتُ",65,"ت",1,1],["هَزَزتُكَ لا أَنّي وَجَدتُكَ ناسِياً","لِوَعدٍ وَلا أَني أَرَدتُ التَقاضِيا",66,"ي",2,1],["هَزَّ لِيُرضي العُلى عَزيمَتَهُ","فَأَصبَحَ المالُ بَعضَ قَتلاهُ",67,"ا",2,0],["هَزّوا الغُصونَ وَكَلَّفوا أَعطافَهُم","حَملَ الجِبالِ فَكانَ ظُلماً بَيِّنا",68,"ن",2,0],["هَزَّهُ بَل أَزَّهُ ذِكرُ الحِمى","فَتَثَنّى طَرَباً بَل رَعَشا",69,"ش",2,0],["هزبْرٌ له في فيه نارٌ وَشَفْرَةٌ","فما يَشتَوي لحم القتيلِ على الجمرِ",70,"ر",1,0],["هِزَبرُ الوغى بالسيفِ والرمح مقدمٌ","له الضربةُ الفرغاءُ وَالطعنةُ النجلا",71,"ل",2,0],["هِزَبرٌ على بحرٍ منَ الحربِ مُفْعَمٍ","على جِسمه نَهيٌ وفي يده نهرُ",72,"ر",1,0],["هزَمتُ فيك الهمومَ فانْهَزَمَتْ","بكرّ شُقْرِ الكؤوس والكُمْتِ",73,"ت",1,0],["هِزبَرا غَريفٍ شَدَّ مِن أَبهَرَيهِما","وَمَتنَيهِما قُربُ المُزَعفَرِ مِنهُما",74,"م",2,0],["هَزَزتَ أَميرَ المُؤمِنينَ مُحَمَّداً","فَكانَ رُدَينِيّاً وَأَبيَضَ مُنصُلا",75,"ل",2,0],["هَزَّتهُ مُعضِلَةُ الأُمورِ وَهَزَّها","وَأُخيفَ في ذاتِ الإِلَهِ وَخيفا",76,"ف",2,0],["هَزَزتَ لَهُ سَيفاً مِنَ الكَيدِ إِنَّما","تُجَذُّ بِهِ الأَعناقُ ما لَم يُجَرَّدِ",77,"د",1,0],["هَزَّنِي شِعْرُهُ فَأَيْقَظَ مِنِّي","فِكْرَةً كَانَ حَظُّهَا فِي الْمَنَامِ",78,"م",1,0],["هزمتَ بالتربِ كفاراً فأعينُهُمْ","تكادُ تعدمُ فيهِ خفةَ الشررِ",79,"ر",1,0],["هزَّ الصبا السالفَ في خدِّها","فَرَوَّحَ النارَ بريشِ الغرابْ",80,"ب",1,0],["هَزَزتُ لِأَغصانِ القُدودِ مَعاطِفاً","بِها وَلِرُمّانِ النُهودِ ثِمارا",81,"ر",2,0],["هَزَّت لَهُ أَعطافَها وَلَرُبَّما","خَلَعَت عَلَيهِ مَلاءَةَ الأَنوارِ",82,"ر",1,0],["هَزَّت مَعاطِفَ سامِعيها حِكمَةً","كادت تَهُزُّ مَعاطِفَ الأَسطارِ",83,"ر",1,0],["هَزَّت كَهَزّي نَصلَ سَيفي لَوعَةً","فَرَقَقتُ حاشِيَةً وَرَقَّ غِرارا",84,"ر",2,0],["هَزّازَةٌ ناءَت بِعَطفي عِزَّةٍ","حَتّى جَرَرتُ عَلى المَجَرِّ إِزارا",84,"ر",2,0],["هَزَجَت بِهِ هَزجَ الحَمامِ مَحامِدٌ","حَمَلَت حُلاهُ مَحمَلَ الأَطواقِ",85,"ق",1,0],["هَزَزتَ لَها عِطفَ القَضيبِ ورُبَّما","سَجَعَت لِبَثِّ الشَجوِ سَجعَ الحَمائِمِ",86,"م",1,0],["هزّ الرّواسِيَ مُقدِماً ما مثله","في البأسِ إعصارٌ ولا زلزالُ",87,"ل",1,0],["هزموا القُوَى ومضوا إلى غاياتِهم","في الفاتحينَ بقوَّةٍ لم تُهْزَمِ",88,"م",1,0],["هُزّ اللواءَ فما لقومِكَ نُصرةٌ","حتّى تَهُزَّ لِواءَكَ الخفّاقا",89,"ق",2,0],["هُزّي لِنُصرَتِكِ الخَليلَ وَهَيِّجي","فيهِ مَضاءَ الصارِمِ البَتّارِ",90,"ر",1,0],["هَزّوا المَمالِكَ في أَيمانِهِم فَهَوَت","عُروشُها الشُمُّ وَاِنهارَت صَياصيها",91,"ي",3,0],["هَزَّ المَنيعَ مِنَ الحُصونِ فَهَدَّهُ","وَمَضى البَلاءُ بِهِ فَبَزَّ الغالبا",92,"ب",2,0],["هَزَّ الجَناحَ يُريدُ دارَةَ قَشعَمٍ","مَلَكَ الجِواءَ وَظَلَّلَ الآفاقا",93,"ق",2,0],["هُزّوا مَعاطِفَكُم لِسَعيٍ تَكتَسي","فيهِ ثِيابَ مَثوبَةٍ أَو مَفخَرِ",94,"ر",1,0],["هَزلِتْ قضيَّتُكم فلا","لحمٌ هناك ولا دم",95,"م",1,1],["هزَّةٌ إثر هزَّةٍ تركته","طللاً دارساً من الأَطلال",96,"ل",1,0],["هَزَزتُكَ لا لِأَنّي وَجَدتُكَ ناسِياً","لِأَمري وَلَكِنّي أَرَدتُ التَقاضِيا",97,"ي",2,1],["هَزَجَت نَوادِبُ لِلعُقولِ فَخَيَّبَت","أُنثى تَرومُ لِطِفلِها تَهزيجا",98,"ج",2,0],["هِزَبْرٌ تظلّ الأُسْدُ مِن غُرّ قَوْمِهِ","تَحُفّ به من خلْفه وأمامهِ",99,"م",2,0],["هَزَّت يَمينُ مُحَمَّدٍ بِلِوائِها","رُكنَ السماحِ وَطَوَّحتَ بِالمِرزَمِ",100,"م",1,0],["هزموهم إلى معاقلهم في ال","ليلِ حتى بدا الصباحُ المنير",101,"ر",1,0],["هزأوا بالبنات والأمهاتِ","وأَهانوا الأزواج والأخواتِ",102,"ت",1,1],["هز اللواء بنو عجلٍ به فغدا","رأساً لهم وغدا كلٌّ له ذنبا",103,"ب",2,0],["هزّ أشبالها الكماةَ وأحيا","أملاً في صدورهم يتوثبْ",104,"ب",1,0],["هَزَأتْ بالجراحِ من مِخلب الْ","ليثِ وأنياب كل أفعى وصلِّ",105,"ل",1,0],["هزّ الفتى الأمويّ تحت إهابهِ","منه مَضاءٌ كالحسامِ مُصمِّمُ",106,"م",1,0],["هَزَّتْ فلسطينَ أنباءٌ يطير بها","برقٌ على جنباتِ الليل بسَّامُ",107,"م",1,0],["هزَّت ليالي الصيفِ ساحرَ صوتهِ","فشجى الشواطئَ واستخفَّ الماءَ",108,"ا",2,0],["هزَّتكِ بالرَّوعاتِ قبلَ مصابِنا","أممٌ ملكنَ أعنَّةَ الطيرانِ",109,"ن",1,0],["هزت إليك من القد ابن ذي يزن","ولاحظتك بهاروتٍ على عجل",110,"ل",1,1],["هَزَزْنَ لَتَقْليبِ الذّوابِلِ أذرُعاً","نَوافِرَ من هَزّ المُثَقّفَةِ الصُّمّ",111,"م",1,0],["هَزَزْتُكَ في نَصْرِي ضُحًى فكأَنَّنِي","هَزَزْتُ وقَدْ جِئْتُ الجبَالَ حِرَاءَهَا",112,"ا",3,0],["هُزِلَتْ سُوقُهُ إِلَى أَنْ تَثَنَّتْ","وَدنَا عُنْقُهُ إِلَى أَنْ تَسَفَّلْ",113,"ل",1,0],["هُزَّتْ مَنَابِرُهُ بِعَالِي صَوْتِكُمْ","وَأُثِيرَ فِيهِ الرَّأْيُ كُلَّ مَثَارِ",114,"ر",1,0],["هُزُّوا مَنَابِرَهُ بِعَالِي صَوْتِكُمْ","حَتَّى يَرِنَّ صَدَاهُ فِي الأَقْطَارِ",115,"ر",1,0],["هَزَّ مِيناً أَنْ عَادَ مُتَّصِلاً مَا","انْبَتَّ مِنْ مُلْكِهِ بِمُلْك جَدِيدِ",116,"د",1,0],["هَزَّ بِالإِيقاعِ أَفْلاكاً وَلَمْ","يَصْحَبِ العُودُ بِهِ طَبْلاً وَزَمْرَا",117,"ر",2,0],["هَزَّتْ مَنِيَّتُكَ البِلاَدَ وَلَمْ تَكُنْ","بِأَشَدَّ مِنْهَا هِزَّةُ الزِّلْزَالِ",118,"ل",1,0],["هَزَّتْ لِحَادِثِكَ الربَى وَتحَرَّكَتْ","لُجَجُ الأَثِيرِ ورُوِّعَتْ مُهَجُ الْوَرَى",119,"ر",2,0],["هَزئ الزَمانُ بِحُسَّدي","أَلمَفخَري يَبغونَ شاوا",120,"ا",3,1],["هَزَمتُ جُيوشَ الصَبرِ في مَعرَكِ الهَوى","وَقَصَّرتُ في الهَيجاءِ طولَ قَناهُ",121,"ا",2,0],["هزّتِ البُشْرَى جَناحَ الخافقيْنْ","ومضتْ تخطِرُ بين المشرقيْنْ",122,"ن",1,1],["هَزَّهُ شَوْقٌ إِلى سَكَنٍ","فَبَكَى للأَهْلِ والسَّكَن",123,"ن",1,0],["هَزَّ مِصْراً نَبَأٌ فاضَتْ لَهُ","عَبَراتُ الْقَوْمِ تَجْرِي مَطَرَا",124,"ر",2,0],["هَزَزْتَ إلى التَّأْليفِ كُلَّ مُبَرِّزٍ","أَدِيبٍ إذَا مَا أَرْسلَ الفِكْرَ سدَّدا",125,"د",2,0],["هَزَزْتُ أوتارَ شعري حول شُرْفَتِها","كما ترنّم بالأسحارِ رُعْيانُ",126,"ن",1,0],["هَزَّتْهُ كَفٌّ من الفُولاذِ قَبْضتُهَا","في الهَوْلِ ما عَرَفَتْ رِفْقاً ولا لِينَا",127,"ن",2,0],["هزمت جيشَ الأباطيلِ فما","غادرتْ غير جَريح أو طعين",128,"ن",1,0],["هزْليَّةٌ أحكم المحتلُّ حَبْكَتَها","لا تعرضوها فُصُولاً بعد ما ذهبا",129,"ب",2,0],["هزَّ شعري قومًا وراءَ الوادي","وبه ضاع نفخةً في رمادِ",130,"د",1,1],["هزّ الوجودَ بكفه في مهده","طفلٌ يتيمٌ من كنانةَ عاف",131,"ف",1,0],["هزموا العداة بكل أسمر مارن","مهند مثل الغدير يماني",132,"ن",2,0],["هزوا لتجربَة قُواك وساءهم","بعد العنا الاّ تخورَ قُواك",133,"ك",1,0],["هزُّوا العراق بما اسطاعوا فما أخذت","منه تَضارب انباء بأنباء",134,"ا",2,0],["هزَزْنا بها ذِكرى ، وتِهنا بزهوها","بُدوءاً ، ونُحنا من تصوَّرها عُقْبى",135,"ب",2,0],["هُزِّي الرِّتاجَ عليَّ أُحكِمُه","وتقحَّمي البابَ الذي انغلقا",136,"ق",2,0],["هُزَّ القلوبَ بإحساسٍ تَفيضُ به","ثم ادعُ حتى صخوراً صمةً تُجب",137,"ب",1,0],["هُزِّي بنصفِكِ واتركي نصفا","لا تحذَري لقَوامكِ القصفا",138,"ف",2,1],["هُزِّي لهم رِدفاً إذا رغِبوا","ودعي لنا ما جاورَ الرِّدفا",138,"ف",2,0],["هزجٌ اذا ما الوُرق نُحن لانني","خالفت في حب الأسى أذواقها",139,"ق",3,0],["هزجت فنظمت الدموع قلائداً","فليت مثالي كان لي من مثالك",140,"ك",1,0],["هززتُ فيها نياطَ القلبِ فانتثرت","بها شظايا فؤادٍ جدِّ مشعوب",141,"ب",1,0],["هزّت رزاياكِ أوتاراً لناهضةٍ","في الشرق فاهتَجْنَ منها الشجوَ لا النغما",142,"م",2,0],["هزني مدحُكم فقلتُ ولا يصلُح","عودُ الغناء حتى يُجَسّا",143,"س",2,0],["هَزَزْنَاهُ لأحْداثِ اللّيَالي،","فَأحْمَدْنَا مضارب ذي القِفارِ",144,"ر",1,0],["هزيع دجى في الرأس بارده بدر","وليل جلاه لا صباح ولا فجر",145,"ر",1,1],["هزمنا .. وما زلنا شِتاتَ قبائلِ","تعيشُ على الحقد الدفين وتثأرُ",146,"ر",1,0],["هزم الروم بعد سبع عجاف","وتعافى وجداننا المطعونُ",147,"ن",1,0],["هزَّ للماء هذمة ً كعصا مو","سى فأضحى عموده مفروقا",148,"ق",2,0],["هُزءاً وسُخراً تنحّل والنا","سُ إذا ما تهكَّمُوا قلبوا",149,"ب",3,0],["هزت يمين محمدٍ بلوائها","ركن السماك وطوحت بالمرزم",150,"م",1,0],["هَزَّتْ مَناكبَها له، فكأَنه","ظِلٌّ، وسُنْبُلة ٌ، وقَطرُ غَمام",151,"م",1,0],["هَزَمُوا الْعِدَاة َ بِكُلِ أَسْمَرَ مَارِنٍ","وَ مهندٍ مثلِ الغديرِ يماني",152,"ن",2,0]]}