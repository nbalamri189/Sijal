 راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[498,"جدي بواسط أوسط القوم الألى","https://www.aldiwan.net/poem38041.html","الكامل"],[512,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[513,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[527,"أكؤوس مترعات من عقار","https://www.aldiwan.net/poem37409.html","الرمل"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[549,"أسيف الدين قد حملت ظهري","https://www.aldiwan.net/poem47308.html","الوافر"],[549,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[549,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[549,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[549,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[556,"هي الحقيقة كل الكائنات لها","https://www.aldiwan.net/poem33534.html","البسيط"],[556,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[560,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[561,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[565,"بأبي أقيك من الحوادث والردى","https://www.aldiwan.net/poem69492.html","الكامل"],[565,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[565,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"],[573,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[576,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""]],"verses":[["هَزِجاتٌ مِنَ البُروقِ كَأَنَّ ال","بُلقَ فيها مَجرورَةُ الأَرسانِ",0,"ن",1,0],["هَزَزتُ المَواضي فَاِنثَنَت عَن ضَرائِبي","فَما أَرَبي في أَن أَهُزَّ كَليلَها",1,"ل",3,0],["هَزَّ المَجَرَّةَ أُفقُهُ وَكَأَنَّها","غُصنٌ بِأَحداقِ النُجومِ وَريقُ",2,"ق",1,0],["هَزَّ عِطفي إِلى الأَغَرِّ أَبي إِس","حَقَ وُدٌّ يَلوي عَلَيهِ صَليفي",3,"ف",2,0],["هَزِجُ الرُعودِ لَهُ بِكُلِّ ثَنيَّةٍ","زَجَلٌ كَشَقشَقَةِ الفَنيقِ الموضِعِ",4,"ع",1,0],["هَزِجِ البُروقِ كَأَنَّهُ مُتَمَطِّقٌ","بِأَراقِمٍ قِلنَ الرِمالَ نَضانِضِ",5,"ض",1,0],["هَزَّةَ الريحِ سَليماً","مِن وُصومٍ وَعُيوبِ",6,"ب",1,0],["هَزَّهُمْ بِالمَرْجِ ذِكْرى بابِلٍ","أنَّها مَرْمىً على العِيسِ شَسُوعُ",7,"ع",1,0],["هَزِجاً يَحُكُّ ذِراعَهُ بِذِراعِهِ","قَدحَ المُكِبِّ عَلى الزِنادِ الأَجذَمِ",8,"م",1,0],["هَزَمتُ تَميماً ثُمَّ جَندَلتُ كَبشَهُم","وَعُدتُ وَسَيفي مِن دَمِ القَومِ أَحمَرُ",9,"ر",1,0],["هَزِئَت أَن رَأَت غُلاماً حَديثَ ال","سِنِّ يَغشى الخُطوبَ فَهُوَ حَزينُ",10,"ن",1,0],["هَزِئَت بي وَنِلتُ ما شِئتُ مِنها","يا لَقَومي فَأَيُّنا المَغبونُ",10,"ن",1,0],["هَزَزْتُ أَبَا سَعِيد مِنْكَ دَوْحاً","بِهِ ما شِئْتُ مِنْ ظِلٍّ وَمَجْنَى",11,"ن",2,0],["هزَزْتَ الى إعْزازِها كُلَّ ذابِلٍ","وقُدْتَ الى إصْراخِها كُلَّ ذي لِبْدِ",12,"د",1,0],["هُزَّ منْ مِعْطَفَيْكَ ذابِلَ خَطٍّ","ذا قَوامٍ مُهَفْهَفٍ وانْدِماجِ",13,"ج",1,0],["هَزِجٌ عَلَيهِ التَومَتا","نِ إِذا نَشاءُ عَدا بِها",14,"ب",3,0],["هَزّوا مَغارِبَها فَهابَت بَأسَهُم","يا وَيلَكُم إِن لَم تَهُزّوا المَشرِقا",15,"ق",2,0],["هَزَّكَ البَيتُ الحَرامُ لَهُ","هِزَّةَ المُشتاقِ لِلوَطَنِ",16,"ن",1,0],["هزَبرٌ إِذا اِجتازِ الأُسودُ بغيلِهِ","فَأَشجَعُها خافي الخُطى خافِتُ الزارِ",17,"ر",1,0],["هَزَزنا بِهِ الصَمّامَ فَالعَزمُ حَدُّهُ","وَحِليَتُهُ العَليا وَإِفرِندُهُ البِشرُ",18,"ر",1,0],["هَزَّ مِنهُ الصَبا فَقَوَّمَ شَطراً","وَتَجافى عَنِ الوِشاحِ بِشَطرِ",19,"ر",1,0],["هِزَبرٌ هَريتُ الشَدقِ رِئبالُ غابَةٍ","مَخوفُ اللِقاءِ جائِبُ العَينِ أَنجَلُ",20,"ل",1,0],["هَزَّ ائْتِلافُهُمَا الدُّنْيَا وَبَشَّرَهَا","بِيُمْنِ حَالٍ لأَجْيَالٍ وَأَزْمَانِ",21,"ن",1,0],["هَزائِمُكَ الغُرُّ مَشهورَةٌ","يُقَرطِسُ فيهِنَّ مَن يَنضُلُ",22,"ل",1,0],["هَزَّ القَنا لانَ وَما تَخَضَّدا","يَركُضنَ رَيطَ اليَمَنِ المُعَضَّدا",23,"د",2,0],["هَزيمٌ كَأَنَّ البُلقَ مَجنوبَةً بِهِ","يُحامينَ أَمهاراً فَهُنَّ رَوامِحُ",24,"ح",1,0],["هزَزْت الطُور فهو يكاد يمشي","إليك على تَقَدُّسه احتراما",25,"م",2,0],["هَزّوا السُيوفَ فَأَشرَعوها فيكُمُ","وَذَوابِلاً يَخطِرنَ كَالأَشطانِ",26,"ن",1,0],["هَزِمٌ أَجَشُّ إِذا اِستَحارَ بِبَلدَةٍ","فَكَأَنَّما بِجِوائِها الأَنهارُ",27,"ر",1,0],["هزجات إذا أدرن على الكف","يُطَرِّبْنَ بالغناء المُديرا",28,"ر",2,1],["هززتكم لو أن فيكم مهزة","وذكرت ذا التأنيث فاستنوق الجمل",29,"ل",1,0],["هزَّت رؤوس السامعين بوصفه","طرباً فلم تحتج إلى تشبيب",30,"ب",1,0],["هُزءاً وسُخراً بما تنحّل والنا","سُ إذا ما تهكَّمُوا قلبوا",31,"ب",3,0],["هززتك فاغضبْ غضبةً جعفريةً","تكون على الأعداء راغية البَكرِ",32,"ر",1,0],["هز للماء هزمة كعصا مو","سى فأضحى عموده مفروقا",33,"ق",2,0],["هززتُكَ للحرمانِ فاقطع وتينَهُ","فما زلتَ صمْصاماً إذا هُزَّ صمَّما",34,"م",2,0],["هزَّهُ ماجدٌ يناصح في الهزْ","زِ هُمَامٌ مُتَوَّجٌ لهُمام",35,"م",1,0],["هَزَّ السِلاحَ لَهُنَّ مُصعَبُ قُفرَةٍ","مُتَخَمِّطٌ بِلُغامِهِ مَرثومُ",36,"م",1,0],["هَزَأَ الشاعِر مِنهُم قائِلاً","بَلَغَ السوسُ أُصولَ الشَجَرَه",37,"ر",2,0],["هَزَمَ الهَجرُ اِصطِباري","فَعَسى لِلوَصلِ رَدَّه",38,"د",2,0],["هز لحن به شدوت مجيدا","كل ما للقلوب من اوتار",39,"ر",1,0],["هزنا الفن في كمنجة سامي","وهو في اميرها الجحجاح",40,"ح",1,1],["هزت الليث ولما يَصح من","دم غليومَ وصيدٍ آخرين",41,"ن",1,0],["هَزَّت مَناكِبَها لَهُ فَكَأَنَّهُ","عُرسُ البَيانِ وَمَوكِبُ الأَقلامِ",42,"م",1,0],["هَزَّ الشَبابُ إِلى رَثائِكَ خاطِري","فَوَجَدتَ فِيَّ وَفي الشَبابِ وَفاءَ",43,"ا",2,0],["هَزَّ اللِواءُ بِعِزِّكَ الإِسلامُ","وَعَنَت لِقائِمِ سَيفِكَ الأَيّامُ",44,"م",1,1],["هَزَزتَ بَني الزَمانِ بِهِ صَبِيّاً","وَرُعتَ بِهِ بَني الدُنيا غُلاما",45,"م",2,0],["هُزّوا القُرى مِن كَهفِها وَرَقيمِها","أَنتُم لَعَمرُ اللَهِ أَعصابُ القُرى",46,"ر",2,0],["هَزَّت دِمَشقُ بَني أَيّوبَ فَاِنتَبِهوا","يَهنَئونَ بَني حَمدانَ في حَلَبِ",47,"ب",1,0],["هَزيمَةُ مَن لا هازِمٌ يَستَحِثُّهُ","وَلا طارِدٌ يَدعو لِذاكَ وَيوجِبُ",48,"ب",1,0],["هَزَّ اللِّواءَ على ما كانَ مِنْ سِنَةٍ","واهْتَزَّ ثُمَّ عَلا وارْتَجَّ ثُمَّ هَفا",49,"ف",2,0],["هَزَّ اللِواءَ بَنو عِجلٍ بِهِ فَغَدا","رَأساً لَهُم وَغَدا كُلٌّ لَهُم ذَنَبا",50,"ب",2,0],["هَزَمَت مَكارِمُهُ المَكارِمَ كُلَّها","حَتّى كَأَنَّ المَكرُماتِ قَنابِلُ",51,"ل",1,0],["هِزَبرٌ مَشى يَبغي هِزَبراً وَأَغلَبٌ","مِنَ القَومِ يَغشى باسِلَ الوَجهِ أَغلَبا",52,"ب",2,0],["هَزَّ مِنها شَرخُ الشَبابِ فَجالَت","فَوقَ خَصرٍ كَثيرِ جَولِ الوِشاحِ",53,"ح",1,0],["هَزلُهُ لِلسَماحِ شيمَتُهُ وَال","بَذلُ وَالحَزمُ وَالكِفايَةُ جِدُّه",54,"د",2,0],["هَزَرناهُ لِأَحداثِ اللَيالي","فَأَحمَدنا مَضارِبَ ذي الفَقارِ",55,"ر",1,0],["هَزيعُ دُجاً في الرَأسِ بادَرَهُ بَدرُ","وَلَيلٌ جَلاهُ لا صَباحٌ وَلا فَجرُ",56,"ر",1,1],["هَزَّ عِطفَيهِ النَدى مُكتَسِياً","وَرَقَ الحَمدِ أَثيثاً يَأتَلِق",57,"ق",1,0],["هَزِجُ الصَهيلِ كَأَنَّ في نَغَماتِهِ","نَبَراتِ مَعبَدَ في الثَقيلِ الأَوَّلِ",58,"ل",1,0],["هَزَّهُ العَجَبُ فَوَلّى","يَتَثَنّى كَالعِنانِ",59,"ن",1,0],["هِزَبرٌ يَرفِتُ القَصَراتِ رَفتاً","أَبى لِعُداتِهِ إِلّا اِغتِصابا",60,"ب",2,0],["هِزَبرٌ تَفادى الأُسدُ مِن وَثَباتِهِ","لَهُ مَربِضٌ عَنهُ يَحيدُ المُسافِرُ",61,"ر",1,0],["هِزَبرٌ هَريتُ الشَدقِ رِئبالُ غابَةٍ","إِذا سارَ عَزَّتهُ يَداهُ وَكاهِلُه",62,"ل",2,0],["هِزَبرٍ إِذا أَشبالَهُ سِرنَ حَولَهُ","تَشَظَّت سِباعُ الأَرضِ مِن ذي النَحائِمِ",63,"م",1,0],["هَزيعُ شَبيبَةٍ طَلَعَتْ عليه","كواكِبُه فرصَّعَتِ الهَزيعا",64,"ع",2,0],["هَزَزتُكَ هِزَّةَ السَيفِ المُحَلّى","فَلَمّا أَن ضَرَبتُ بِكَ اِنثَنَيتُ",65,"ت",1,1],["هَزَزتُكَ لا أَنّي وَجَدتُكَ ناسِياً","لِوَعدٍ وَلا أَني أَرَدتُ التَقاضِيا",66,"ي",2,1],["هَزَّ لِيُرضي العُلى عَزيمَتَهُ","فَأَصبَحَ المالُ بَعضَ قَتلاهُ",67,"ا",2,0],["هَزّوا الغُصونَ وَكَلَّفوا أَعطافَهُم","حَملَ الجِبالِ فَكانَ ظُلماً بَيِّنا",68,"ن",2,0],["هَزَّهُ بَل أَزَّهُ ذِكرُ الحِمى","فَتَثَنّى طَرَباً بَل رَعَشا",69,"ش",2,0],["هزبْرٌ له في فيه نارٌ وَشَفْرَةٌ","فما يَشتَوي لحم القتيلِ على الجمرِ",70,"ر",1,0],["هِزَبرُ الوغى بالسيفِ والرمح مقدمٌ","له الضربةُ الفرغاءُ وَالطعنةُ النجلا",71,"ل",2,0],["هِزَبرٌ على بحرٍ منَ الحربِ مُفْعَمٍ","على جِسمه نَهيٌ وفي يده نهرُ",72,"ر",1,0],["هزَمتُ فيك الهمومَ فانْهَزَمَتْ","بكرّ شُقْرِ الكؤوس والكُمْتِ",73,"ت",1,0],["هِزبَرا غَريفٍ شَدَّ مِن أَبهَرَيهِما","وَمَتنَيهِما قُربُ الم