],[5703,"يابارد الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=211909",""],[5771,"بطاقة زائر","https://www.poetsgate.com/ViewPoem.aspx?id=189060",""],[5771,"صَوتٌ لا يَموت","https://www.poetsgate.com/ViewPoem.aspx?id=189449",""],[5784,"كأني على ساحة الشعر ذيب....","https://www.poetsgate.com/ViewPoem.aspx?id=190729",""],[5837,"بعيد الشبح","https://www.poetsgate.com/ViewPoem.aspx?id=179316",""],[5848,"احباط","https://www.poetsgate.com/ViewPoem.aspx?id=48817",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5956,"الأعوام والإنعامُ","https://www.poetsgate.com/ViewPoem.aspx?id=193812",""],[5956,"حمْداً لِخالقِ فيصلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194670",""],[5956,"تربيتي الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=194887",""],[6001,"أمل مقتول","https://www.poetsgate.com/ViewPoem.aspx?id=692",""],[6102,"أَفكارٌ هارِبَةٌ!!","https://www.poetsgate.com/ViewPoem.aspx?id=185364",""],[6128,"ليلةُ المشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=213717",""],[6134,"أفديه لا أفدي سواه جميلاً","https://www.poetsgate.com/ViewPoem.aspx?id=169522",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[5190,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78337&r=&rc=50",""]],"verses":[["أُفكِرُ في حالَةٍ أُطاوِلُها","وَفَعلَةٍ تَخضِبُ القَنا بِيَدي",0,"د",2,0],["أَفَكَانَ ذَلِكَ ذَنْبَهَا","أَمْ كَانَ ذَنْبِي لا تَسَلْنِي",1,"ن",2,0],["أفكوكب نَحْس يُقارن في الورى","من سعد أخبية الغواني كوكبا",2,"ب",2,0],["أفكانوا مثلَنا مختلفين","لا يغيثون إذا خطب عرا",3,"ر",2,0],["أفكانوا في ظلمة الليل تجراً","هربّوا المال من جباة المكوس",4,"س",1,0],["أفكِّر في نِصابٍ أنت منهُ","فيُغْلَقُ دون عذرِك كلُّ بابِ",5,"ب",1,0],["أَفُكِّهَ معشرٌ ولهم فضولٌ","وأُغللنا وليس لنا فضولُ",6,"ل",1,0],["أُفَكِّرُ في الدُنيا وَأَبحَثُ في الوَرى","وَعَينِيَ ما بَينَ النُجومِ تَجولُ",7,"ل",1,0],["أَفكُلُّ ذِي شَجوٍ عَلِمتَ مكانَه","تَسلُو مودَّتَهُ ولَستَ بِسَالِ",8,"ل",1,0],["افكر في ليل يجيئ وراءه","فتنقلب الافراح عندي احزانا",9,"ن",2,0],["أُفَكِّرُ في مُعاقَرَةِ المَنايا","وَقودِ الخَيلِ مُشرِفَةَ الهَوادي",10,"د",2,0],["أفكِّر في ادعائهم قريشاً","وتركهمُ النصارى واليهودا",11,"د",2,1],["أَفَكنتِ ناسيةً فجدَّدَ ذِكرَها","أثرٌ بِعينكِ يا صفيّةُ أخضرُ",12,"ر",1,0],["إِفكُ الدُعاةِ مَحَتهُ دَعوَتُكَ الرِضى","فَعَصا الخَطيبِ بِها عَصا مُتَلَقِّفِ",13,"ف",1,0],["أُفَكِّهُ منها الطَّرْفَ في كلِّ شاهِدٍ","بأنَّ دليلَ اللّهِ في كلِّ ما برا",14,"ر",2,0],["أفكر في الماضي فيأتي خياله","جَميلاً أَمام العين ثم يَزول",15,"ل",1,0],["أَفَكانَ بَاهِرُ خُلْقُهَا","أَمْ خُلْقَها سَبَباً لِوَجْدكْ",16,"ك",1,0],["أفكان سرك أن ترى إحسانه","ثمن العفاف لضمة وعناق",17,"ق",1,0],["أفكِّر في غدهم فأُحسُّ","بداءٍ يخامرُ صدري دفين",18,"ن",1,0],["افكره فيغدو اليوم عاما","لوقت كان فيه العام يوما",19,"م",2,0],["أفكلّما طلبوا لعُقر دياركم","سلباً مضوا ونفوسُهم أسلابُ",20,"ب",1,0],["أفكارهم زُهُرٌ أنفاسهم زَهَرٌ","أجفانهم غدق أحشاؤهم حرق",21,"ق",1,0],["أفكِّرُ في نَأْيِ اللقاءِ وبُعْدِهِ","وأعلمُ أنَّ الصبرَ أنأى وأَبْعُد",22,"د",1,0],["أُفَكِّرُ لَيليَ حَتّى الصَبا","حِ فيها وَأُمسي كَما أُصبِحُ",23,"ح",1,0],["أفكر في مقامي وهو صعبٌ","وأصعب منه عن وطني ارتحالي",24,"ل",2,0],["أفكّرُ حائراً وأذوبُ وَجداً","ورأسي غائصٌ في راحتيّا",25,"ي",2,0],["أُفَكِّرُ فِي الْهَجْرِ كَيْفَ انْقَضى","وأَعْجَبُ لِلْوَصْلِ كَيْفَ اتَّفَقْ",26,"ق",1,0],["أفكّر هل شاء القضاء وأنت هو","فقلبك ما زالت عواطفه تقسو",27,"و",1,0],["افكر في مبهمات الوجود","ولغز حياة الورى الفانية",28,"ي",2,0],["أَفكارَهُم بِالحُظوظِ قَد شُغِلَت","عَنهُ وَأَبصارُهُم بِها لَحظَت",29,"ت",1,1],["أَفَكَيفَ يَخفى الغُش في","وَجه المَليح الأَلطَف",30,"ف",1,0],["أفكر لك فيمن مضى قبلك","عرب لك من قبل كانوا كان",31,"ن",1,0],["أفكر في دهر تغير طبعه","فجاء بأنواع تسوء وأجناس",32,"س",1,0],["أفكّرُ في فُرَيَّةَ ما تُلاقي","من الدّنيا فتغشانِي الهُمومُ",33,"م",1,1],["أفكِّرُ في مُفارقَتِي رِجالاً","همُ الكُرَمَاءُ أبناءُ الكِرامِ",34,"م",1,0],["أفكان الإِكسير والشَّعر والبَعْرُ","وهذي المقالة الشَّنعاء",35,"ا",2,0],["أفكانت أيَّامها أحلاما","ينْبِتُ الحُسن في ثراها غُصوناً",36,"ا",1,0],["أفكر فيك يا نور العيون","وأسأل عنك قلبي كل حين",37,"ن",1,1],["أَفَكلّما راعَ الخليطُ تصوّبتْ","عبراتُ عينٍ لم تقلَّ فتكثُرا",38,"ر",2,0],["أَفْكَرْتُ مُذْ غَابَ عَنِّي وَجْهُهُ سَهَرِي","حَيْثُ الكَرَى مُذْ تَغيبُ الشَّمْسُ يُنْتَظَرُ",39,"ر",1,0],["أفكِّرُ في العَقارِ وخَمرِ فيها","علَى التَّحقيق أيهما العُقار",40,"ر",1,0],["أفكِّرُ فيهما هذا أحادٌ","بلا ثانٍ يكونُ وذا أحاد",41,"د",1,0],["أفك فكاك من الغرام غريمه","أبدا به يحيا وفيه يقبر",42,"ر",1,0],["أفكلُّ هذا حيث قلتُ","لك الحشى روحي فداك",43,"ك",1,0],["أفكانت آذانها وهي تحبو","عن مقالٍ انتِ المنى صمَأَءَ",44,"ا",2,0],["أفكربلاء بالعرا","ق وكربلاء بمصر أخرى",45,"ر",2,0],["أفكر في بني أبي","وفعل بعض إخوتي",46,"ي",1,0],["أفكر لها بالقلب والسمع والبصر","وانظر واطالع حلها في مسيرها",47,"ر",3,0],["أُفَكِّرُ فيكَ مَصلوباً فَأَبكي","وَتُضحِكُني أَمانيكَ السَّخيفَه",48,"ف",2,0],["أفُكّ بها قيد التستر والحيا","فقد طال ما أكنى عليها وأسفرُ",49,"ر",1,0],["أفكلما بالغت في كتم الهوى","غلبتك زفرة حسرة لم تكتم",50,"م",1,0],["أفك ولم أمنن يدي يوم تمة","لجعفر من أسر المنون وثاق",51,"ق",1,0],["أفكرٌ وتمحوه يد الحدثان","فمن خالد في العالمين وفانِ",52,"ن",1,1],["أفكّر في حالي وفي الدهر لا أرى","سِوى ملكٍ يعنو له الشرقُ والغَرب",53,"ب",1,0],["أفَكِّرُ فى قلبي بأيِّ عُقوبةٍ","أعاقِبُهُ فيكم لِتَرضَوا فما أدري",54,"ر",2,0],["أفكاره حكم دقت ومنطقه","حكم ومقوله جد بلا هزل",55,"ل",1,0],["أفكل مشتاقٍ تسالمه الظُبا","يا ظبية القناص تقتله الدمى",56,"م",2,0],["أفكل مشتاقٍ لصدرٍ واسعٍ","يدنيه من مولاه حجلٌ ضيق",57,"ق",1,0],["أفكلّ لينة المعاطف قلبها","قاسٍ يصدُّ عن المراشف قسورا",58,"ر",2,0],["أفَكَان ربُّ العَرشِ جَلَّ جَلاَلُه","مِن قَبلُ ذَا عَجزِ وذَا نُقصَانِ",59,"ن",1,0],["أفكَانَ يَعجِزُ أن يُجِيبَ بِقَولِهِ","إن كَانَ حَيًّا دَاخِلَ البُنيَانِ",59,"ن",1,0],["أفكارها في المكر والكيد الذي","قد حار فيه فكرة الانسان",59,"ن",1,0],["أفكارهم مثل وري الزند ثاقبة","أو ومضة البرق مهما شع متقدا",60,"د",2,0],["أَفكل يَوم مِن عدا","ك لَنا إِلى عَلياك نَدبه",61,"ب",2,0],["أفكان عدلك في الصبابة والهوى","يقفو الظلام ويسهر المظلوم",62,"م",1,0],["أفكار حضرته الدقيقة قد غدت","تدع المعمي مثل يوم مشمس",63,"س",1,0],["أفكاره سوداءُ حالكة","وخيالها بالمقت محتجب",64,"ب",1,0],["أفكان ذاك تدللاً","دلت عليه دلائلك",65,"ك",1,0],["أفكر بالدواء أو الغذاء","ورتق الثوب أو رقع الحذاء",66,"ا",2,1],["أفكُ بأشجان الفؤاد قريحتي","وأفتح بالآلام أبواب أحلامي",67,"ي",1,1],["أفكر لا أرى لك أي نفع","لحقاً أنت من سقط المتاع",68,"ع",1,1],["أفكر يا دهر ماذا فعلتُ","بمثلك وغداً وماذا فعلتا",69,"ت",2,1],["أفكّر في خصمٍ فيولد غيره","سريعاً فيذكي في حشاي له بغضا",70,"ض",2,1],["أفكر بالسفاسف في الحياة","وأحسبها حقائق راهنات",71,"ت",1,1],["أفكر في ربّي فأطرق خاشعا","وأشعر اني صرت في الملأ الأعلى",72,"ل",2,1],["أفكر بالشعر فيما أقول","ويتبعني الوزن والقافية",73,"ي",2,1],["أفكّر في الآتي ابتغاء سعادةٍ","وبالفكر في الآتي الخسارةُ للحال",74,"ل",1,0],["أفكارنا طوع الإذاعة أصبحت","مهما تفكر بالأمور نفكر",75,"ر",1,0],["أفكر بالشيء المفيد لأمتي","لأعلي منهم أنفساً ومراتبا",76,"ب",2,1],["أفكر مثلهم فكراً يسيرا","وأجني مثلهم طرباً وفيرا",77,"ر",2,0],["أفكر في الأمور بغير فكري","وأصغي نحو جرس غير جرسي",78,"س",2,0],["أفكارنا أفكار قوم مضوا","يتصل الأعلى بأدناه",79,"ا",2,0],["افكاره اقتدرت في كل معجزة","حتى سمت في العلا عمن بساميها",80,"ي",3,0],["أفكاره عن سوى التّحقيق نائمةٌ","وذهنه لعويص العلم يقظانُ",81,"ن",1,0],["أفكر فِي حالي وقرب منيتي","وسيري حثيثاً فِي مصيري إِلَى القبرِ",82,"ر",1,1],["أفكارهم بهدى القرآن ثاقبة","فلا يخامرها في الرأي تضليل",83,"ل",1,0],["أفكر في كثرة عصيانه","فانخلع القلب من أعضائه",84,"ه",1,0],["أفَكّرُ في ما قد غَشاها مِنَ الأسى","فَأثني عنانَ الفِكرِ جَذلانَ باكِيَا",85,"ي",2,0],["أفكر فيهم سراً وجهراً","ولا سَمرى يطيب ولا رقادي",86,"د",2,0],["أفْكارُهُ عن بُلوغِ القَصْدِ قد وقفَتْ","في المَدْحِ إذ سرَحَتْ والوَصْفَ ما شرَحَتْ",87,"ت",1,0],["أَفكِّر في الجَفا أَنّى تَقضّى","وَأَعجَبُ للرِضا أَنّى تَهيّا",88,"ي",2,0],["أفكر في فعل الزمان وابناه","فأبناؤها في الجور شابهن أنباه",89,"ا",2,1],["أفكر في ذكرى ليالٍ تصرمت","بها أعينٌ قرت وسرت خواطر",90,"ر",1,0],["أَفَكانَ يَعلَمُ ذا ارسطاليسُهُم","تَدبيرَ ما اِنفرَدَت بِهِ الجَهَتانِ",91,"ن",1,0],["أفكر في أمر الزمان وأنّه","لأمرٍ يضيق الفكرُ عنه ويَعجزُ",92,"ز",1,1],["أَفكارُه بين الأَحبة وَالحِمى","تَشكو الشَتاتَ عَلى مديد زَمانه",93,"ن",2,0],["أفكّر في ذنبي فأبكي تحسرا","ومن خشية الجبار قلبي مزعزع",94,"ع",1,1],["أفكلما فطن الزمان لجيرة","طارت نعامته بذاك الموكب",95,"ب",1,0],["أَفَكُنتَ من أهلِ الوَغى وَالرَّأيِ فاس","تَمثِل بِمَن يَعلُو وِعندَكَ فاثبُتِ",96,"ت",1,0],["أَفَكُنتَ كُفأً لِلخِطابِ مُنَدِّداً","بالصِّيدِ تَنتَدِبُ المَلا لِلَعَودَةِ",96,"ه",1,0],["افكارُهُ وَفعالُهُ في عَزمِه","تُبدي سِباقاً وَاتِفاقاً حازِما",97,"م",2,0],["أَفكلُّ الأَنام أهلُ صلاحٍ","ما خلا ذا الفقير بين الأنامِ",98,"م",1,0],["أفكاره همم إيعاده نقم","وعوده قسم تأميله عصم",99,"م",1,1],["أفكلما لاحت معالم مطمع","أعدو إليها يا خيال وأدرج",100,"ج",1,0],["افك فكاك منغرام غريمه","وخصيمه حكم عليه يجور",101,"ر",1,0],["أَفكانَت إِلّا الأُصول اِستَقَرت","حَيث كانَت لِنازح ما اِستَقرا",102,"ر",2,0],["أفكِّر ماذنبي لديك فلا أرى","عليَّ سبيلاً غير أنَّك حاسد",103,"د",1,1],["أُفكّر في معنى الحَياة وَسِرِّها","وَأَحوالِ دُنيا حار في وَصفها فكري",104,"ر",2,0],["أفكارُهُ تَجلُو لَهُ ما اخْتَفَى","كالبَدْرِ يجلُو مُدْلَهِمَّ الظَّلامْ",105,"م",1,0],["أفكر ما عسى تجري","عليّ بها ولا أدري",106,"ر",2,0],["أفكر في ود تقادم بيننا","وفي دونه قربى لمن يتقرب",107,"ب",1,0],["أفكر في عصر مضى لك مشرقاً","فيرجع ضوء الصبح عندي مظلما",108,"م",2,0],["افكر في حال بلدتي وبما","آلت اليه ومالها آس",109,"س",1,0],["افكر في لقائهم كاني","اشتغلت بمدح عبدالله فكري",110,"ر",2,0],["أفكّر في لئامة طبع زوجي","فأكره كل أنثى في النساء",111,"ا",2,1],["أفكلما صرختْ فلسطينُ انهضوا","تتسابقونَ لنومكمْ كي تحلموا",112,"م",3,0],["أَفَكُلَّمَا أنهَيتُ نَزفَ قَصِيدةٍ","طُوِيَتْ لِيَبدَأَ بالنَّزِيفِ المَطْلَعُ ؟!",113,"ع",1,0],["