{"poems":[[29,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[101,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[46,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[108,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[46,"السَّيْفُ أَصْدَقُ إِنْبَاءً مِنَ الكُتُبِ","https://www.poetsgate.com/ViewPoem.aspx?id=64458",""],[139,"خل العزاء فذا مصاب أكبر","https://www.aldiwan.net/poem49160.html","الكامل"],[415,"يا رب حسن رجائي فيك حسن لي","https://www.aldiwan.net/poem31939.html","البسيط"],[534,"أستودع الله سيفا جردوه على","https://www.aldiwan.net/poem37296.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38387","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70921","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119921","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119994","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136229","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136263","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108951","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108904","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108601","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108593","الكامل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47143","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77347","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103769","السريع"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115478","السريع"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112560","المجتث"],[3109,"","https://poetry.dctabudhabi.ae/diwan/poem/102817","الكامل"],[3164,"","https://poetry.dctabudhabi.ae/diwan/poem/146990","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97885","المتدارك"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32364","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205514","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133310","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133222","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135323","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54444","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94460","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81719","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83585","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83534","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58011","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58157","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33327","الرجز"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123861","السريع"],[4802,"عيب العرب فيه","https://www.poetsgate.com/ViewPoem.aspx?id=34416",""],[4858,"كيف ننسى أسيرنا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138040",""],[4858,"حان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=139695",""],[4929,"أثناء مرضي","https://www.poetsgate.com/ViewPoem.aspx?id=214197",""],[5009,"إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=68090",""],[5010,"يا رب حقق لي","https://www.poetsgate.com/ViewPoem.aspx?id=189897",""],[5198,"نود الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=136094",""],[5277,"وإنَّ فيضَ رسولِ اللهِ دفّاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=206568",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5465,"أمستْ أمية قد أظلَ فَناؤها","https://www.poetsgate.com/ViewPoem.aspx?id=98425",""],[5526,"تأملات طفله","https://www.poetsgate.com/ViewPoem.aspx?id=198510",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[5956,"يا رب حقق رغبتي بسهامِ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181989",""],[5956,"ألمي عليها","https://www.poetsgate.com/ViewPoem.aspx?id=182412",""],[5956,"يا رب حَسّنْ صحتي لأحِبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=194000",""],[5956,"يا رب فك الغمة عن طحال ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=214668",""],[5977,"أشتاق لي","https://www.poetsgate.com/ViewPoem.aspx?id=213253",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6307,"أسئلة الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79014&r=&rc=2",""]],"verses":[["يا رُبَّ حَيٍّ نَعَشنا بَعدَ عَثرَتِهِم","كُنّا لَهُم كَسَقيفِ العَظمِ فَاِجتَبَروا",0,"ر",3,0],["يا رُبَّ حُسَّانةٍ منهنَّ قد فعلتْ","سوءاً وقد يَفْعَلُ الأسواءَ حُسَّان",1,"ن",1,0],["يا رب حين اجوزه","مشيا عليك توكلي",2,"ل",2,0],["يا رب حيٍ.. رخام القبر مسكنه","ورب ميتٍ.. على أقدامه انتصبا",3,"ب",2,0],["يا رُبَّ حَوباءَ حينَ اِجتُثَّ دابِرُهُم","طابَت وَلَو ضُمِّخَت بِالمِسكِ لَم تَطِبِ",4,"ب",1,0],["يا رُبَّ حربٍ بغير العلم ما اتَّقَدتْ","ورُبُّ جيشٍ بغير العلم ما صالا",5,"ل",2,0],["يا رُبَّ حوباءَ لمَّا اجتثَّ دابرهمْ","طابَتْ ولَوْ ضُمخَتْ بالمِسْكِ لم تَطِبِ",6,"ب",1,0],["يا ربِّ حيّ ضريحها بتحيةٍ","من رحمة أفرادها لا تحصرُ",7,"ر",1,0],["يا رَبِّ حُسْنُ رجائي فيكَ حسَّنَ لي","تضييعَ وقتيَ في لهوٍ وفي لَعِبِ",8,"ب",1,1],["يا رَبِّ حُطْ بِصَفِيِّ الدين حَوْزَتَنا","وادْفَعْ بِهِ بَغْيَ مَنْ مِنْ ديننا مَرَقا",9,"ق",2,0],["يا رَبِّ حُلَّ عُقدَتي","وَحُلَّها مِن ذا الوِثاق",10,"ق",1,0],["يا رُبَّ حلمٍ صار منقصةً وذامْ","ولربَّ مستحيل سِرَّ سامْ",11,"م",1,1],["يا رب حط يحيى الذي لم يزل","يحيى أخا الفقر ببذل النوال",12,"ل",1,0],["يا رب حدود رجاه فما","أصبح إلا وهو مجدودُ",13,"د",1,0],["يا رب حقق ظنون العبد ان له","ظناً جميلاً له في الكون تسيير",14,"ر",1,0],["يا رب حقق لآمالي وجد كرماً","بحفظ من في الهوى زادت علايقه",15,"ق",2,0],["يا رب حقق في رضاك ظني","بفتح لا إله إلا اللّه",16,"ه",1,0],["يا رب حتى رقادي","يغار مني عليه",17,"ي",2,0],["يا رب حتى خيالي من محبتها","يغار مني عليها وهو من بدني",18,"ن",2,0],["يا رب حتى الحجل مما نتقي","خوفاً من العذال والحساد",19,"د",1,0],["يا رب حتى الصبح يبعدني","عنها وحتى عفتي ضدي",20,"د",2,0],["يا ربّ حرّ ماجد تغرّبا","شرَّق في كسب العلى وغربا",21,"ب",2,0],["يا رَبِّ حَقِّقْ فيه قَوْلَ مؤرّخ","ألقاه وجهك نضرة وسرورا",22,"ر",2,0],["يا رَبّ حَقُّك عِندي هَل تُسامِحُني","فيهِ وَتَشمَلُ زَلّاتي بِغُفرانِ",23,"ن",1,0],["يا ربّ حَقّقنى إلهى بحقا","ئِقِ الذين اقترَبُوا تَحَقّقاً",24,"ق",2,0],["يا رب حمام لعنا به","أبدى الينا كل حمام",25,"م",1,1],["يا ربّ حالٍ مع طيبهِ","نهارهُ لا تنقضى غايتُه",26,"ه",1,1],["يا رب حتى ببؤسي","أرى مكانى وضيعا",27,"ع",2,0],["يا رب حجام كلفت بحبه","يجري الدماء وفوق وجنته الدم",28,"م",1,1],["يا رب حقق دعوة العبد","وارحم دعائي واشفني وحدي",29,"د",2,1],["يا رب حمدا على التوفيق يا املى","شكرا جزيلا بلا حد على النعم",30,"م",1,0],["يا رب حنانك فانفعي","برسول اللَه وبالمدد",31,"د",1,0],["يارَبِّ حَيِّ بِخَيرِ ما","حَيَّيتُ إِنساناً عُمارَه",32,"ر",2,0],["يا رُبَّ حَمْدٍ لم ينله الذي","قد ناله إلا لهجوي أنا",33,"ن",2,1],["يا رب حقق رجائي فيك يا أملى","بجاه من شرعه في الكون إصلاح",34,"ح",1,0],["يا رب حقق بجاه المصطفى أملى","فإنّ نعماك للمضطرّ مبذوله",35,"ل",2,0],["يا ربِّ حفظاً له من كل نازلةٍ","وكن لنا وله من خلفِ ما خلفا",36,"ف",2,0],["يا ربِّ حتّامِ أُعاني الهوى","في ذنب ذا المغرب لا أرتقي",37,"ي",1,1],["يا ربُّ حفظاً لهُ والنظرُ يشفعهُ","ما دام دهرٌ وما دارَت دوائرُهُ",38,"ر",2,0],["يا ربِّ حَقِّقْ في رضاكَ رجاءَنا","فرضاكَ أفضلُ ما رجاهُ الأفضلُ",39,"ل",1,0],["يا ربّ حسنُ رَجائي فيكَ تعلَمَهُ","منّي فَحقِّق رَجائي وَاِقضِ أَوطاري",40,"ر",2,0],["يا رَبّ حَقِّق رَجائي فيك أَجمَعَهُ","بِجاه طه فَإِنّي غيرُ ميؤوسِ",41,"س",1,0],["يا رِبْحَ عبدٍ قد تزوَّدَهُ إلى","يومِ القيامةِ عندَ هَوْلِ الموعدِ",42,"د",1,0],["يا رِبْحَ من بالحلم قد صامَهُ","محتسباً لازماً أيامَهُ",43,"ه",1,0],["يا رَبِّ حقِّق ما مرى","في أملي بالظفَرِ",44,"ر",1,1],["يا رب حلاق بلوني به","اذاقني من العذاب الأليم",45,"م",1,1],["يارب حطوا كل عيب العرب فيه","وانت الذي وحدك تعرف الحقيقة",46,"ق",2,1],["يا ربِّ حقّق ما نرومُ من المنى","فبقول كُنْ يغدو البعيد قريبا",47,"ب",2,0],["يا ربّ حقّق بالأمان رغائبا","وامنح أحبّتنا الجنى المحبوباً",48,"ب",2,0],["يا ربُّ حسنُ الظنِّ فيكَ مطِيَّتي","فارحمْ وفُكَّ من الذنوبِ وثاقي",49,"ق",2,0],["يا ربّ حكمتك اقتضتني مذنبا","لأجيء بابك أستجير وأضرع",50,"ع",1,0],["يا ربّ حقّق ليْ بفضلكَ بُغيتي","وامنحْ فؤادِي راحةً وسُرُورَا",51,"ر",2,1],["يارب حرّم وجه عبدك على النار","ودلّه على درب الهدى والرشادة",52,"د",2,0],["يا (ربْحُ) كلّي إليكِ اليومَ يشتاقُ","كوني التي حبُّها لِلقلبِ تِرياقُ",53,"ق",1,1],["يا ربُّ حَمْداً أنْ بَعثتَ مُحمَّداً","فينا نَبيئا للخِيار سَليلا..",54,"ل",2,0],["يا ربِّ حرمةِ مسلمٍ متعبد","هتكت وكشف بالعراء غطاؤها",55,"ا",3,0],["يارب حقّق للبراءه ما تبي","وكل شي نامت تنتظر به تناديه",56,"ي",2,0],["يا رب حسب ربى دماج ما ثكلت","متى يقول لها الإصباح بشراكِ",57,"ك",1,0],["يا رب حقق رغبتي بسهامِ","‏ ‏ حتى أواصلَ عيشتي بسلام",58,"م",1,1],["‏يا رب حقق بالسعادة مأملي","‏ ‏ ما خاب عندكَ يا كريمُ المأملُ",59,"ل",1,0],["يا رب حَسّنْ صحتي لأحبكا..","فالوهن قلّل عزم حبي نحوكا",60,"ك",2,1],["يا رب حسّنْ عيشتي وأقاربي","وجميع مَن هم سائرين بهديكا",60,"ك",2,0],["يا رب حقق أمنه وشفاءه","ووفاقه، حسّنْ له الأجواءا",61,"ا",3,0],["يارب حقق أمننا وسلامنا","لجمال دنيانا.. أنا أشتاق",62,"ق",1,0],["يا رب حبي للجمال شفاعة","أنت الجمال بمطلق المعيار",63,"ر",1,0],["ياربّ حتّى متى ياربّ أغترب؟","إلى متى ياإلهي في المدى أثب؟",64,"ب",1,0]]}