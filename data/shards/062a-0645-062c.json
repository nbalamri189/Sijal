{"poems":[[65,"أكوكب ما أرى يا سعد أم نار","https://www.aldiwan.net/poem45803.html","البسيط"],[95,"أبو حسن أصفى الرفاق سريرة","https://www.aldiwan.net/poem11102.html","الطويل"],[32,"عفا الزرق من أطلال مية فالدحل","https://www.aldiwan.net/poem29547.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[30,"يسقين بالموماة زغبا نواهضا","https://www.aldiwan.net/poem5464.html","الطويل"],[76,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[48,"لعمري لقد أدلجت والركب خائف","https://www.aldiwan.net/poem22322.html","الطويل"],[48,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[78,"بكفه ساحر البيان إذا","https://www.aldiwan.net/poem39322.html","المنسرح"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30492","الطويل"],[82,"","https://poetry.dctabudhabi.ae/diwan/poem/30296","الطويل"],[48,"لعمري! لقد أدلجتُ، والركب خالف،","https://www.poetsgate.com/ViewPoem.aspx?id=18314",""],[136,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[164,"اشارت من العنباء نحوى بحبة","https://www.aldiwan.net/poem58964.html","الطويل"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[216,"منازل للأحباب غبر طوامس","https://www.aldiwan.net/poem37874.html","الطويل"],[280,"ورافضة من مائها في هوائها","https://www.aldiwan.net/poem25634.html","الطويل"],[412,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[500,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122757","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64872","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64470","الطويل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96324","الطويل"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44750","الطويل"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44746","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66296","الكامل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216594",""],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206009","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66382","السريع"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34646","المتقارب"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21547","السريع"],[4160,"","https://poetry.dctabudhabi.ae/diwan/poem/123622","المنسرح"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45109","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72811","السريع"],[5121,"رَيَّانَةُ الدِّبْسِ / إبنتي حنين","https://www.poetsgate.com/ViewPoem.aspx?id=49548",""],[5126,"مزنة","https://www.poetsgate.com/ViewPoem.aspx?id=206090",""],[5338,"جفني لفقدك سهده فرض","https://www.poetsgate.com/ViewPoem.aspx?id=187597",""],[5431,"مزامير العبق....","https://www.poetsgate.com/ViewPoem.aspx?id=202601",""],[5508,"يا سيّدي قد رمُيتُ من زمني","https://www.poetsgate.com/ViewPoem.aspx?id=110835",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5897,"الحياء في لحظات الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=157485",""],[5970,"تمجلت في عهد الشباب إلى القبر","https://www.poetsgate.com/ViewPoem.aspx?id=130674",""],[6164,"أيها الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66015&r=&rc=25",""],[6259,"أخذن زمام الدَّمع خوف انسجامه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59398&r=&rc=46",""],[5126,"مزنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87787&r=&rc=2",""]],"verses":[["تَمُجُّ أَخفافُها والأَينُ يُثقِلُها","دَماً لَهُ في أَديمِ الأَرضِ آثارُ",0,"ر",1,0],["تَمُجُّ بِهَا تِلْكَ اليراعَة نُورَهَا","لِكَشْفِ ظَلامَاتِ الكِرَامِ وَلِلْهَديِ",1,"ي",1,0],["تَمُجُّ اللُغامَ الهَيَّبانَ كَأَنَّهُ","جَنى عُشرٍ تَنفيهِ أَشداقُها الهُدلُ",2,"ل",1,0],["تمج الفيء والمعروفَ مجّاً","وللأقلام حَطْم وانتقامُ",3,"م",1,0],["تَمُجُّ مُداماً عُتِّقَتْ فَتَنَفّسَتْ","بأَحْشَاءِ سَحٍّ عُدْمُلِيٍّ كراهِبِ",4,"ب",1,0],["تَمُجُّ أَداوى في أَداوى بِها اِستَقَت","كَما اِستَفرَغَ الساقي مِنَ السَجلِ بِالسَجلِ",5,"ل",1,0],["تَمُجُّ الرَيَّ أَنفاسُ المَجاني","بِهِ وَمغارِسُ العودِ السَليبِ",6,"ب",1,0],["تَمَجَّسَ حِرباءُ الهَجيرِ وَحَولَهُ","رَواهِبُ خَيطٍ وَالنَعامُ يَهودُ",7,"د",1,0],["تَمُجُّ قُلوبُهُم ما أودِعَتهُ","لِسوءٍ في الغَرائِزِ أُشرِبوهُ",8,"ب",3,0],["تَمُجُّ فكّاهُ ريقةً صَغُرتْ","وخَطْبُها في القلوبِ قد كبُرا",9,"ر",2,0],["تَمُجُّ بفِيها الشَّهْد صِرْفاً ويخْتَفِى","لمُشْتارِهِ ما بيْنَ أَحْشائِها سَهْمُ",10,"م",1,0],["تمجّ فتيتْ المسك منه أساودٌ","مُعَقْرَبَةٌ أَذنابُهُنَّ على النعلِ",11,"ل",1,0],["تمجّسَ حِرْباءُ الهجيرِي وحولَه","رَواهبُ خَيطٍ، والنّعامُ يهودُ",12,"د",1,0],["تمُجُّ البَقلَ فَهوَ لَهَا ضَمِينٌ","بِأن تُروَى وتَرعَى الدَّيدَمَانَا",13,"ن",2,0],["تمج إذا عظت إلى الفم ريقة","تسامت إلى وصل الملوك وعزت",14,"ت",1,0],["تمجُّ سماً وجَنَى نحلةٍ","فريقُها يُرجى كما يُرْهَبُ",15,"ب",1,0],["تمجُّ شرارا يضرمُ الماءَ والثرى","ويشوي طيورَ الجوّ وهي تطيرُ",16,"ر",1,0],["تَمُجُّ بُراها والأزِمَّةُ كَبْكَبَتْ","قماحدَها للسيرِ وهي تقايس",17,"س",1,0],["تمُجُّ كِبار الدُّرّ في دَوَرَانِها","فلو لُقِطتْ زانَتْ نُحورَ الكَواعبِ",18,"ب",1,0],["تَمُجُّ دروع القَوم منهم دِماءَهم","كَما مَجَّ فيض الخمر نسج فَدامِهِ",19,"م",2,0],["تمجُّ السمَّ من جوفاءَ خِيلتْ","ثِفالَ الموت هامتُها رَحاها",20,"ا",3,0],["تمجُّ دمَ القلوب ولم","تلجْ جرحا على بدنِ",21,"ن",1,0],["تمجّ حيّاتا ريق الحياة وإن","ينشط فلا قوت إلا ذلك الريق",22,"ق",1,0],["تَمُجُّ أُذناهُ ماءَ اللَّومِ في قَمَرٍ","سِيّانَ عاذِرُهُ فيهِ وَلائِمُهُ",23,"م",2,0],["تَمَّ جُوداً لِلْمُستَميحينَ مُعْفٍ","واغْتِفاراً عن المُسِيئينَ عافِ",24,"ف",1,0],["تمجدت يا حق الألوهة واجب","لوجهك منا واجبات العبودة",25,"ه",1,0],["تمجدت يا حق الجمال بماله","من الرحموت المحض والعاطفية",25,"ه",1,0],["تمجد ما يعلو الرجال وينتمي","اذا قام في يوم الحفيظة مغضبا",26,"ب",2,0],["تَمُجُّ سُلافاً مِن زِقاقٍ كَأَنَّها","شُيوخ بَني حام تَحَنَّت ظهورُها",27,"ر",3,0],["تمجُّ سُلافاً مِن قَواريرَ صُفِّفَت","وَطاسات صفر كلّها حَسَنُ القَدِّ",28,"د",1,0],["تمجَّ سلاف الغوطتين شفاهها","ولكنما داعي الهوى رشفاتها",29,"ت",3,0],["تَمّ جيلي ذِيْ تحيّاته","على النبي كونوا مْصَلّينا",30,"ن",2,0],["تمجُّ لُفَاظَ المِلح مَجّاً وتصطفي","سبَائِكَ لا تَصْدَا وإن قدُم العهدُ",31,"د",1,0],["تمجّها الأسماع إذ أصبحت","ما تحتها معنى ولا غايه",32,"ه",1,0],["تَمجُّ سوالِفُه مسكةً","وعنبرة رِيقُه والنسم",33,"م",1,0],["تَمجُّ مِن أَقداحِنا قَهوةٌ","تَضوع بِالمِسكِ وَبالعَنبَر",34,"ر",1,1],["تمج من صابك على بشر","كأنما ثوبه به علقه",35,"ق",2,0],["تَمُجُّ مِن ذَوبِها مِثلَ الجُمانِ إِلى","ذَوبَ السَحابِ فَلا يُدرى الَّذي غَلَبا",36,"ب",2,0],["تمجُّ من ريقتِها شهدةً","قلت نعم لكن مع القيمغي",37,"غ",2,0],["تَمُجُّ عَصِيِرَ الْحُبِّ وَرْدِيَّةَ الرِّوَى","وَتَحْلِبُ مِنْ مَرْجِي فُيُوضاً مِنَ الْحِسِّ",38,"س",1,0],["تمج الغيث في مسك شذيّ","له أرجٌ كتمزيقِ الجُيوبِ",39,"ب",1,0],["تَمْجيدُ أَوْصَافٍ بِكَ انْفَرَدَتْ","هِيَ جَوْهَرٌ وَلِغَيْرِكَ العَرْضُ(٥)",40,"ض",1,0],["تُمجّد النارَ لاتخشى معابدها","تخزّن الجمرَ والنانرج للغسقِ",41,"ق",1,0],["تمجٌّ أخلاقه إذا كتبت","ماء المنى من أسنّة الأسلِ",42,"ل",1,0],["تَمُجُّ بِحَارُنَا نَارًا وَعَارًا","وَأَيْسَرُ مَا نَرُدُّ بِهِ الْفَحِيحُ!",43,"ح",1,0],["تمجُّ عيونهم قسماتِ وجهي","وتنكرُ سالفَ العهدِ الجميلِ",44,"ل",1,0],["تمجلت في عهد الشباب إلى القبر","فهل كنت تخشي طول مثواك في الدهر",45,"ر",1,1],["تَمَجَّدتَ رَبَّي.. إنَّي مُتَطَلِّعٌ..","إلى اثْنَيْهما.. أَنْتَ الكَرِيمُ المُؤَمَّلُ!",46,"ل",1,0],["تمجُّ دروعُ القومِ منهُ دماءهم","كما مجَّ فيضَ الخمر نسجُ فدامهِ",47,"م",2,0],["تمج الغيث في مسك شذاه","له أرج كتمزيق الجيوب",48,"ب",1,0]]}