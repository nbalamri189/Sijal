{"poems":[[53,"ذلي لزهوك أرض","https://www.aldiwan.net/poem64957.html","المجتث"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66833","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131322","الرجز"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115322","الطويل"],[5573,"ايام الدراسه","https://www.poetsgate.com/ViewPoem.aspx?id=200337",""]],"verses":[["وقال طاردْتَ ظبْياً","ولم يُساعِدكَ ركض",0,"ض",1,0],["وقالَ طوبى أيكةٌ ظِلّها","صاحِ ظليلٌ ذاتُ أغصانِ",1,"ن",1,1],["وقال طورا هو الزهر الذي استبمت","عنه الرياض أو الغيث الذي انسجما",2,"م",2,0],["وقال طورا هو النور الذي محيت","به الدياجي أو الطيب الذي نسما",2,"م",2,0],["وقال طورا هو الدري في شرف","وقال طورا هو الورد الذي فغما",2,"م",2,0],["وقال طه الهاشميّ المُصطفى","صلى عليه رَبُّنا وشَرَّفا",3,"ف",2,0],["وقال طَه المُصطفى خيرُ الأنامْ","في أَوّل الأَقْوالِ أَطْعِمُوا الطّعام",4,"م",1,0],["وقالَ طواهُ الحجُّ فاخشع لِفَقدِهِ","ولا عيشَ حتى يستهل المحرَّمُ",5,"م",1,0],["وقال طالب للمدرس لحظة الحصه ملوله","جاوبه هذا المدرس خذ مثل غيرك وسام",6,"م",1,0]]}