{"poems":[[55,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[93,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[87,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[47,"خير نيليك إن أنلت الجزيل","https://www.aldiwan.net/poem65611.html","الطويل"],[82,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[71,"ثلاثة كن حذرا خائفا","https://www.aldiwan.net/poem28504.html","السريع"],[107,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[107,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85397","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[92,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[101,"الرجل الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=190720",""],[139,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[146,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[285,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[287,"أتحسبون غرب أجفاني جف","https://www.aldiwan.net/poem32704.html","الرجز"],[302,"وافى وأفق الدجى بالزهد متشح","https://www.aldiwan.net/poem33301.html","البسيط"],[302,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[308,"إذا بلغت من الدنيا ولذتها سبعا","https://www.aldiwan.net/poem57584.html","البسيط"],[354,"يأبي عادل القوام وإن ما","https://www.aldiwan.net/poem15857.html","الخفيف"],[371,"رب وعد منك جئت إلى","https://www.aldiwan.net/poem17757.html","المديد"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[463,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[469,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[484,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107277","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101489","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64126","البسيط"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123404","المديد"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145621","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44776","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96639","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72331","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56149","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112686","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53002","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62893","المنسرح"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48438","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91422","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117875","المجتث"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133295","البسيط"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90806","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143311","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113834","البسيط"],[4702,"المبسم الحالي","https://www.poetsgate.com/ViewPoem.aspx?id=156813",""],[4755,"مِن بَسمَةٍ _يا حُبُّ_ هذا الدَّمْ","https://www.poetsgate.com/ViewPoem.aspx?id=184809",""],[4829,"سنيني شيب","https://www.poetsgate.com/ViewPoem.aspx?id=34258",""],[4829,"الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=34267",""],[4883,"الفلوجة دائماً","https://www.poetsgate.com/ViewPoem.aspx?id=48356",""],[4915,"أُستاذُ إبليس","https://www.poetsgate.com/ViewPoem.aspx?id=211418",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4929,"قلت ياشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202415",""],[5007,"عسى يدركها ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155981",""],[5039,"حطين","https://www.poetsgate.com/ViewPoem.aspx?id=48128",""],[5055,"رحلة شقى","https://www.poetsgate.com/ViewPoem.aspx?id=104393",""],[5186,"بمحياك يا هلال العام","https://www.poetsgate.com/ViewPoem.aspx?id=156438",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5264,"جمرك البيوع","https://www.poetsgate.com/ViewPoem.aspx?id=180076",""],[5277,"مشاعرٌ موحشة","https://www.poetsgate.com/ViewPoem.aspx?id=192198",""],[5277,"المُرفِئ","https://www.poetsgate.com/ViewPoem.aspx?id=197924",""],[5277,"أخرُ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=198477",""],[5351,"مكر","https://www.poetsgate.com/ViewPoem.aspx?id=202028",""],[5353,"ملحمة فجر الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=212649",""],[5404,"ما لوحش الحفرة من مصرع","https://www.poetsgate.com/ViewPoem.aspx?id=186636",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5582,"يا بَرْقُ حَيِّ الأَبْرَقَيْنِ فَثَهْمَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63492",""],[5615,"يا أطهر الناس","https://www.poetsgate.com/ViewPoem.aspx?id=187949",""],[6070,"أنين الأعمى","https://www.poetsgate.com/ViewPoem.aspx?id=188675",""],[6093,"الزمكان","https://www.poetsgate.com/ViewPoem.aspx?id=198343",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["مالوا إِلَيكَ مَحَبَّةً فَتَجَمَّعوا","وَرَأَوا عَلَيكَ مَهابَةً فَتَفَرَّقَوا",0,"ق",3,0],["مالوا بودِّهمُ إلى رجلٍ","جعل البوار لأهله شرعه",1,"ع",2,0],["ما لوس أَنجِلوس سِوى أُنشودَةٍ","اللَهُ غَنّاها فَجُنَّ لَها الوَرى",2,"ر",2,0],["مالوا على نعمى الحياة وطيبها","حتى ذهبت فصابروا ضرَّاءها",3,"ا",3,0],["مالَ وَاِحتَجَب","وَاِدَّعى الغَضَب",4,"ب",1,1],["ما لِوَجهِ السَماءِ حينَ تَجَلّى","حُسنُ وَجهِ الوَزيرِ حينَ يُخيلُ",5,"ل",1,0],["مالوا عليها ازدحاماً وهي تَرْمَحُهُمْ","فكم بها من كسيرٍ لَيسَ يَنجَبِرُ",6,"ر",1,0],["مالٌ وإنْ زادَ وأنثى وإنْ","شابَتْ وسلطانٌ وإنْ قرَّبَكْ",7,"ك",1,0],["مَالوا بِميزانِ الحُقوقِ مع الهَوَى","فَأقامَ في أيديِهمُ المِيزانا",8,"ن",2,0],["مالوا عَنِ الشَرَفِ الصَميمِ وَأَحدَثوا","ما شاءَتِ الأَوهامُ وَالأَهواءُ",9,"ا",2,0],["ما لوث الدم عمداً ذيل سافكه","حتىَ يقال جريء غير ذي أَدَب",10,"ب",1,0],["مالوا بمصباح البيان صباحا","ومشوا به في الذاهبين رواحا",11,"ح",2,1],["مألومةٌ غيرُ مشكورٍ لها سَهرٌ","على الحقوقِ ولا مَرعيّةٌ ذِمَم",12,"م",1,0],["ما لوَّثَتْ منك الحقائبُ مسحة","موروثةً لك قبلَ أعصر عاد",13,"د",1,0],["مالون عينيكِ؟ إنّي لستُ أذكُرُه","كأني قبلُ لم أعرفهُما أبدا ..",14,"د",2,0],["ما لوشْ نظير في الرجالهِ","يخلقْ من الهبيك دوسهْ",15,"ه",1,0],["ما لؤلؤ البحر ولا مَرجانه","إلا وراءَ الهول من عُبابهِ",16,"ب",2,0],["مالوا عَنِ الحَقِّ فَاِستَنهَضتَ نَحوَهُمُ","فَوارِساً غَيرَ ما ميلٍ وَلا عُزُلِ",17,"ل",1,0],["مالُوا عَن المُصطَفى وَالوَحيُ بَينَهُمُ","وَفيهمُ تَنزِلُ الآياتُ وَالسُوَرُ",18,"ر",1,0],["مالُوا عَلَينا مَعَ الأَيّامِ وَاِستَمَعُوا","فِينا أَقاوِيلَ شانِينا وَقالِينا",19,"ن",2,0],["مالوا فقوم منهم كل مناظر","طَعْنٌ يُعَدِّلُ مِنْهُمْ كُلَّ جُوّارِ",20,"ر",1,0],["ما لُؤلُؤُ العُقودِ إِلّا نَظمُهُ","لا نَظمُ دُرٍّ صادِفٍ عَنِ الصَدَف",21,"ف",1,0],["مالوا إِلى فُرص اللَذّات من أُمَمٍ","ولم يَميلوا عن العَليا ولا جَنَحوا",22,"ح",3,0],["ما لِوَرقاءِ الحِمى لا صَدَحَت","أَنا أَهوى وَهيَ بالشَكوى تلحُّ",23,"ح",1,0],["مالٌ ومولى ومشروبٌ ومائدةٌ","ومطربٌ ومطابيعٌ ومردانُ",24,"ن",1,0],["ما لِوَجدي بُعدٌ يُرامُ لِعُذّا","لي عَلَيهِ إِذ مالَهُ فيهِ قَبلُ",25,"ل",1,0],["ما لِوَعدِ بَينَنا عَمَلٌ","إِن نَوَيتَ النُجحَ لا تَعِدِ",26,"د",1,0],["ما لَو سَألتَ يَسيراً من تنقصه","بِنَيل نفسك ما تَهوى وَلَم تطبِ",27,"ب",1,0],["مالوا ومالَوْا عَلى من كانَ مَوَّلَهُمْ","وقبلَهُ خَوَلا كانوا فخَوَّلَهُم",28,"م",1,0],["مال وقام فاستقا","م لامُهُ والألفُ",29,"ف",1,0],["ما لورقٍ هجعت صبوتها","نبَّهت في الدَّوح مني شجنا",30,"ن",2,0],["ما لوجه الدنيا يذمُّ وقد أص","بح وجهاً جماله موموق",31,"ق",1,0],["ما لوثت يدك البيضا حقوق فتى","ولا دعتك إلى حكم دواعيه",32,"ي",2,0],["ما لو أردت عدهم لم يحصوا","فكيف جاز عندكم أن يقصوا",33,"ص",3,0],["مالُوا يَميناً عنِ الدُّنيا وزَهرَتِها","لأَنَّها في عُيونِ القومِ أَقذَارُ",34,"ر",1,0],["مالوا لِحِطّينَ طالِبينَ نَجا","فَلَم يَفِدهُم ضَلعٌ وَلا دَبَرُ",35,"ر",1,0],["ما لوجهِ البدرِ يبدو أصفراً","قال حبّي هل ترى اعتلَّ القَمَر",36,"ر",1,1],["ما لوَّن الزعفرانُ ما قد","لوَّنَ من مائِهِ التراب",37,"ب",1,0],["مال والأغْصانُ مائِلةٌ","فَعَنَتْ صُغْراً لقامتِه",38,"ت",2,1],["مَا لَوْنُ عَيْنَيْهَا اللَّتَيْنِ","سَلَبْنَ قَلْبَكَ أَجْمَعَا؟",39,"ع",2,0],["مالوا إِلَيكَ وَكُلُّ قَلبٍ حَبَّةً","يَحدو بِهِ شَوقاً إِلَيكَ وَيَدفَعُهْ",40,"ع",2,0],["ما لو تُبايعني بروحي قبلةً","مِن ثَغرها أَمضي بها متبرّدا",41,"د",2,0],["ما لو مننتِ عليّ منك برشفةٍ","كانَت ألذّ منَ الزلالِ وأبردا",41,"د",2,0],["مالوا إليه وأوقدت أضغانهم","والنار دون توقد الأضغان",42,"ن",1,0],["ما لوا إلى رأيه المفسود واعتمدوا","ميدان لعبٍ فأفضى الامرُ للهتكِ",43,"ك",1,0],["مالُوا إِلَيهِ عَلى الرِحالِ كَما","مالَت بِشارِبِ كَأسِها الخمرُ",44,"ر",1,0],["ما لِوَفد عَلَيكَ حَق وَلَكن","أَنتَ تَقضي لِلمكرمات حُقوقا",45,"ق",2,0],["ما لو يلاقي بعضه الجبالا","لزلزلت من وقعه زلزالا",46,"ل",2,0],["مألوفةٌ عينُ الحياة فعيشه","خضر ونورُ جبينه وضّاح",47,"ح",1,0],["ما لُؤلُؤُ البحرِ في مواهبه","الا كما يضمحلُ من حَببِهْ",48,"ب",2,0],["مالُوا على الأقْتابِ حين تأمّلوا","فالرّكبُ بين توسّدٍ وتوسّمِ",49,"م",1,0],["ما لَوى قلبَ رَحبَعامَ فأَلوَت","عن لِواهُ أَسباطُهُ واستَمالوا",50,"ل",3,0],["مالو ليغروا منيَتي","عَن وصلتي وَما لهم",51,"م",1,0],["مال وأمن وتقوى","وصحّة وشباب",52,"ب",1,0],["ما لونت لك واختصت بأزمنةٍ","إلا لتحظى من الملالِ والسأمِ",53,"م",1,0],["مال وجاه ونور العلم ثالثها","وكل قسم له في الناس خلان",54,"ن",1,0],["ما لَوانا عن قيصر الروم جيش","أو ثنانا كسرى أنوشروانِ",55,"ن",1,0],["ما لوالينا بتاريخ الهنا","حصل التبريك في ابرك عام",56,"م",1,0],["مالُوا إلى وصلي فحينَ وَصَلتُهُم","ملُّوا وليس يُمَلُّ غير الواصلِ",57,"ل",1,0],["مالوا إلى هجرنا ومَلُّوا","ومِنْ عُقود العهود حَلُّوا",58,"ل",3,1],["مالوا عليهم عتوا واعتدوا وبغوا","وكم لهم بالأذى فيهم لعانات",59,"ت",1,0],["مالوم قلبي كان للريم هاويها","تهدّمت من زينها كامل ركونه",60,"ن",2,0],["مَألُوفَةٌ كالرُّوحِ, لَم ألْقَهَا","مِن قَبْلُ.. لكنَّ الهَوَى مُلْهَمْ",61,"م",1,0],["مالومها تصرخ تشلق بها الجيب","أضحت هدف كل علج عات(ن)و نهاب",62,"ب",1,0],["مالوم عينه لو يشق وينشلق","مالوم حاله لو ينّوح بالشدن",63,"ن",1,0],["مالوا على عدوانهم ميلة أحرار","وتلّحقوهم باللهب والزمهرير",64,"ر",1,0],["ما لو يمرُّ على روضٍ سَينسفُهُ","نسفاً ، ويبكي بلاءَ الدَّهرِ نَرجسُهُ",65,"س",2,0],["ما لو يمرُّ على عقلٍ سيلبسهُ","جهلٌ وكُلُّ ضلالِ الأَرضِ يَلبسُهُ",65,"س",2,0],["مَاْلُوْا مَعَ الْمَاْلِ مُذْ شَبُّوْاº وَمُذْ نَشَؤُوْا *** صَيْفاً شِتَاْءًº وَتَنْفِيْرًا وَإِيْلاْفَاْ","خَاْنُوْا تُرَاْثَكَ فِيْ حِلٍّ، وَفِيْ حَرَمٍ *** وَعَمَّ نُوْرُكَ بُلْدَاْناً وَأَخْيَاْفَاْ (9)",66,"ف",2,0],["ما لِوَبْلٍ من غيم رعدك زرعٌ","في صحارى لا جودَ فيها يفيد",67,"د",1,0],["مَا \"لُو\" كَلَوْ وَكِلاهُمَا نَفَس الرَّدَى","يا ذابح السّكين بالسّكين!",68,"ن",1,0],["مالومهن لو يغارن منك كل الضبا","مزيون فتان مترف ذرب هرج وطويل",69,"ل",1,0],["ما لوحت ناري له الضيف توضيح","يا نار حاتم مرفئ الضيف سايد",70,"د",1,0],["ما لورد الحمام دين وعيد","ديننا، عيدنا اتقاء الحمام",71,"م",1,0],["ما لواه الكلال والتهويم","ولذيذ النعاس عما يروم",72,"م",1,1],["مَالُوا إلى الوَهمِيِّ وَهمًا مُفرِطًا","هَذَا الحَقيقِيُّ الهَنِيُّ الآجِلُ",73,"ل",1,0],["مالوش غير ف المصايب وف الأوض ملطوع","يفتش ينتش ف الورق ويقعد عليه أسبوع",74,"ع",1,0],["ما لوّحتْ بابتسامٍ هَبَّ لي شفةٌ","إلا يدٌ لنشيجِ الروحِ ناديتِ",75,"ت",1,0],["ما لوعةٌ في ليلِ ذي سهدٍ بكى","ودموعُهُ في خدِّهِ لا تفتأُ",76,"ا",1,0],["ما لوّحتْ بابتسامٍ هَبَّ لي شفةٌ","إلا يدٌ ..كيفَ بالتلويحِ ناديتِ",77,"ت",1,0],["ما لون أخطائي إذا أحَصيَتُها","وأخذتُ أطعن صدقها مذهولا؟",78,"ل",2,0],["مالوا بأعناق الخيول على العدا","ولقد قروا منهم طيورا اوطرا",79,"ر",2,0],["ما لوحش الحفرة من مصرع","وأقبح الرنة من مسمع",80,"ع",1,1],["ما لَوْ سَمَحْتِ بِرَشْفٍ كَيْ يَعُودَ بِهِ","حَيًّا بِهِ كُلُّ قَلْبٍ ثُمَّ جُثْمانُ",81,"ن",1,0],["ما لَوْ تُبائِعُنِي بِرُوحِي قُبْلَةً","مِنْ ثَغْرِها أَمْضِي بِها مُتَزَوِّدَا",82,"د",2,0],["ما لونُ دُنيايَ كي أحيا بلا أَمَلٍ","أبيعُ دُنيايَ ، كي أحيا بدُنياكِ !",83,"ك",1,0],["ما لونُ هذا الكونِ يا أمّاهُ","أحقيقةٌ بيضاءُ أمْ ظلماءُ",84,"ا",2,1],["ما لوَّحُوا بِأكُفِّهمْ لودَاعِنَا","ما بَالهُمْ بَخِلُوا بِهَا يا عِيْدُ",85,"د",1,0],["ما لوَى أَذْرُعَنا إلَّا الهوى","في عناقٍ.. نحنُ أَحْبَبْنَا أَسَارَهْ",86,"ر",2,0]]}