{"poems":[[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[0,"أعني على برق أراه وميضِ","https://www.aldiwan.net/poem54.html","الطويل"],[30,"كأن ديار الحي بالزرق خلقة","https://www.aldiwan.net/poem29600.html","الطويل"],[27,"ألا قل لربع بالأفاقين يسلم","https://www.aldiwan.net/poem5989.html","الطويل"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[51,"جزى الله عني قبح وجهي سعادة","https://www.aldiwan.net/poem64029.html","الطويل"],[51,"أشجتك أطلال لخوله","https://www.aldiwan.net/poem64603.html","مجزوء الكامل"],[29,"لخولة بالدومي رسم كأنه","https://www.aldiwan.net/poem6210.html","الطويل"],[91,"لله ما أحلى البشير وقوله","https://www.aldiwan.net/poem62655.html","عموديه"],[85,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[28,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem1233.html",""],[61,"فتوحك ردت بهجة الملك سرمدا","https://www.aldiwan.net/poem51728.html","الطويل"],[66,"ذكر العهود فأسهر الطرف القذي","https://www.aldiwan.net/poem38493.html","الكامل"],[80,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[105,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[52,"ذعرت بقمري أغن ينوح","https://www.aldiwan.net/poem27160.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[127,"ألا صرمت من سلمى الزماما","https://www.aldiwan.net/poem24260.html","الوافر"],[127,"ألا تلك عرسي إذا أمعرت","https://www.aldiwan.net/poem24263.html","المتقارب"],[143,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[150,"ذكرتك فارتاح الفؤاد صبابة","https://www.aldiwan.net/poem68568.html","الطويل"],[229,"إذا استخدمتني في طلاب العلا همم","https://www.aldiwan.net/poem50819.html","الطويل"],[249,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[337,"كلا يومي طوالة وصل أروى","https://www.aldiwan.net/poem45418.html","الوافر"],[337,"لمن طلل عاف ورسم منازل","https://www.aldiwan.net/poem45427.html","الطويل"],[439,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[458,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[515,"ألا إن حد السيف لم يبق خاطراً","https://www.aldiwan.net/poem12091.html","الطويل"],[551,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[578,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""]],"verses":[["ذَعَرتُ الهُمومَ بِخَطّارَةٍ","تَسيلُ بِها في قُلوبِ الإِكامِ",0,"م",1,0],["ذَعَرتُ بِها سِرباً نَقِيّاً جُلودُهُ","وَأَكرُعُهُ وَشيُ البُرودِ مِنَ الخالِ",1,"ل",1,0],["ذَعَرتُ بِها سِرباً نَقِيّاً جُلودُهُ","كَما ذَعَرَ السَرحانُ جَنبَ الرَبيضِ",2,"ض",1,0],["ذَعَرناهُ عَن بيض حِسان بِأَجرَع","حَوى حَولَها مِن تُربِهِ بِإياِدِ",3,"د",1,0],["ذَعَرتَ عَلَينا اليَومَ وَحشاً غَريرَةً","وَنَفَّرتَ مِن أَطلالِها وَحشَ مُستَمي",4,"م",2,0],["ذَعَرتُ قِلاصَ الثَلجِ تَحتَ ظِلالِهِ","بِمَثنى الأَيادي وَالمَنيحِ المُعَقَّبِ",5,"ب",1,0],["ذَعَرْتُ به قوماً فأدَّوا إتاوةً","كأني عليهم عند ذاك أمير",6,"ر",1,0],["ذَعَرتْه نَبأةُ قانصٍ","فلهُ لِذاك توجُّس",7,"س",1,0],["ذَعَرتُ بِهِ سِرباً تَلوحُ مُتونُهُ","كَما لاحَ في أُفقِ السَماءِ الكَواكِبُ",8,"ب",1,0],["ذُعِرَ الطُيورِ سَطا عَليهِم باشِقٌ","وَبَناتِ آوى أَبصَرَت رِئبالا",9,"ل",2,0],["ذُعِرَت عُروشُ الظالِمينَ فَزُلزِلَت","وَعَلَت عَلى تيجانِهِم أَصداءُ",10,"ا",2,0],["ذُعِرَ الحَمامُ وَقَد تَرَنَّمَ فَوقَهُ","مِن مَنظَرٍ خَطِرِ المَزَلَّةِ هائِلِ",11,"ل",1,0],["ذَعَرتُ بِها سِرباً نَقِيّاً كَأَنَّهُ","نُجومُ الثُرَيّا أَسفَرَت مِن عَمائِها",12,"ا",3,0],["ذَعَرْتَهُمُ غَزواً دِراكاً فأصبحوا","على البُعْدِ خَفَّاقَ الحشا ومُسهَّدا",13,"د",2,0],["ذُعِرَ الزَمانُ وَقالَ هَل مِن عاصِمٍ","مِنهُ أَلوذُ بِهِ فَقُلتُ لَهُ لُذِ",14,"ذ",1,0],["ذعرتْ غرابَ الليلِ بي فكأنّني","لأصِيدَهُ منها ركبتُ عُقابا",15,"ب",2,0],["ذُعِرَتْ قُريشٌ هل يُبَدِّلُ دينَها","رَجلٌ ضَعيفٌ في العشيرةِ مُملِقُ",16,"ق",1,0],["ذَعر الحطيمَ وراع يثربَ عاصفٌ","للموت ضجّ لهوله الحرمانِ",17,"ن",1,0],["ذُعِرَتْ لِنكبتِه الجنودُ أعِزَّةً","وتَفزّعَ الأُسطولُ في دأمائهِ",18,"ا",3,0],["ذَعَرَ الجَآذِرَ وَالظِباءَ فَما وَفَت","أَفياءُ مِصرَ وَلا رُبى لُبنانِ",19,"ن",1,0],["ذُعِرَ الوطيحُ فأسلمتكِ حُماتُه","وحَللتِ بالحصنِ الذي لا يُذعَرُ",20,"ر",1,0],["ذُعِرَ الفوارسُ في مُتونِ جيادِهم","لمَّا تردَّى الفارسُ الوثّابُ",21,"ب",1,0],["ذُعِرَ الجمعُ فلو أنّ القطا","طار في آثارِهِ لم يَلحقِ",22,"ق",1,0],["ذُ عَزمَةٍ كَالتِمَاعِ البَرقِ واَقِدَةٍ","تَجِيءُ مِن نَصرِهِ بِالعَارِضِ الهَطِلِ",23,"ل",1,0],["ذُعِرتُ بِقُمرِيٍّ أَغَنَّ يَنوحُ","عَشِيَّةَ رُحنا وَالدُموعُ سُفوحُ",24,"ح",1,1],["ذُعِرْنَ بأبناءِ الضّبابِ وأعْوَجٍ","فأبْكَينَ أبناءَ الجَديلِ وشَدْقَم",25,"م",1,0],["ذَعَرَتْ مواكبُهُ الجبِالَ فأعلَنَتْ","هَضَبَاتُهَا التكبيرَ والتهليلا",26,"ل",2,0],["ذُعِرَ الموت أنَّهم لَمْ يَخافُو","هُ ولم يَرْهَبوا لِقاءَ الحديدِ",27,"د",1,0],["ذُعِر الجْنوبُ فقيلَ : كيدُ خوارجٍ !","وسكا الشَّمالُ فقيلَ : صنْعُ جِوار!",28,"ر",1,0],["ذَعَرْتُ أطغاهمْ فبات ساهدا","أسوانَ لا يستوثِرُ الوسائدا",29,"د",2,0],["ذَعَرتُ الذِئبَ يَحفِرُ كُلَّ حَوضٍ","وَيَقضمُ في مَعاطِنِها العِظاما",30,"م",2,0],["ذَعَرتُ عَصافيرَهُ بِالسَوادِ","أُوَزِّعُ ذا مَيعَةٍ مُستَطارا",31,"ر",2,0],["ذَعَرتَ حُماةَ الوَغى مِنهُمُ","كَما اِنذَعَرَت لِلهِزَبرِ الحُمُر",32,"ر",1,0],["ذُعِرتُ لِفُقدانِ الوِصَالِ بِضُرِّهِ","وذلكَ ذُعرٌ لَيسَ منهُ تَعَوُّذُ",33,"ذ",1,0],["ذَعرْتُ به شمْلاً من الطير جامعاً","وضَرَّجْتُها في كلّ ناحية بدَمْ",34,"م",1,0],["ذَعَرتُ ظِباءَهُ مُتَغَوِّراتٍ","إِذا اِدَّرَعَت لَوامِعَها الإِكامُ",35,"م",1,0],["ذَعَرتُ بِهِ القَطا وَنَفَيتُ عَنهُ","مَقامَ الذِئبِ كَالرَجُلِ اللَعينِ",36,"ن",1,0],["ذُعِرتُ بِها سِربَ القَطا وَهوَ هاجِدٌ","وَعَينُ الفَلاةِ لَم تُبَعِّث رِياضُها",37,"ض",3,0],["ذُعِرَتْ بِحِسِّ الإِنْسِ تَحْتَ حِجالِها","واسْتَأْنَسَتْ بِضَرَاغِمٍ وذِئَابِ",38,"ب",1,0],["ذُعِرتْ بحُكمِ الجاهليَّةِ أَن ترى","قَدْ دُسَّ فِي تُرْبِ الثَّرى مَوْؤُودُها",39,"د",3,0],["ذَعَرتُ زماني بأسمائهم","فكنَّ من الدهر دوني حصونا",40,"ن",2,0],["ذُعِرَتْ منهمُ القُلوبُ فأمسَتْ","بينَ أحشائهمْ كمَوتى القُبورِ",41,"ر",1,0],["ذعرت الورى حتى لقد خاف مصلح","على نفسه أضعاف ما خاف مفسد",42,"د",1,0],["ذَعَنَتْ لعزّتهمْ وهَيبتهمْ","الشّيبُ في الأحياء والمُرْدُ",43,"د",1,0],["ذعَرْتُ به المَها وأَرقْتُ لمّا","لبستُ قميصَه ماءَ التَّصابي",44,"ي",1,0],["ذَعَرتُ بِمُقوَرِّ اللِّياطِ مُصَنَّعٍ","مُمَرٍّ كَصَدرِ الرُمحِ عادٍ نَواهِقُهْ",45,"ق",2,0]]}