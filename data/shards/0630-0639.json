id=206240",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["ذَعَرتُ الهُمومَ بِخَطّارَةٍ","تَسيلُ بِها في قُلوبِ الإِكامِ",0,"م",1,0],["ذَعَرتُ بِها سِرباً نَقِيّاً جُلودُهُ","وَأَكرُعُهُ وَشيُ البُرودِ مِنَ الخالِ",1,"ل",1,0],["ذَعَرتُ بِها سِرباً نَقِيّاً جُلودُهُ","كَما ذَعَرَ السَرحانُ جَنبَ الرَبيضِ",2,"ض",1,0],["ذَعَرناهُ عَن بيض حِسان بِأَجرَع","حَوى حَولَها مِن تُربِهِ بِإياِدِ",3,"د",1,0],["ذَعَرتَ عَلَينا اليَومَ وَحشاً غَريرَةً","وَنَفَّرتَ مِن أَطلالِها وَحشَ مُستَمي",4,"م",2,0],["ذَعَرتُ قِلاصَ الثَلجِ تَحتَ ظِلالِهِ","بِمَثنى الأَيادي وَالمَنيحِ المُعَقَّبِ",5,"ب",1,0],["ذَعَرْتُ به قوماً فأدَّوا إتاوةً","كأني عليهم عند ذاك أمير",6,"ر",1,0],["ذَعَرتْه نَبأةُ قانصٍ","فلهُ لِذاك توجُّس",7,"س",1,0],["ذَعَرتُ بِهِ سِرباً تَلوحُ مُتونُهُ","كَما لاحَ في أُفقِ السَماءِ الكَواكِبُ",8,"ب",1,0],["ذُعِرَ الطُيورِ سَطا عَليهِم باشِقٌ","وَبَناتِ آوى أَبصَرَت رِئبالا",9,"ل",2,0],["ذُعِرَت عُروشُ الظالِمينَ فَزُلزِلَت","وَعَلَت عَلى تيجانِهِم أَصداءُ",10,"ا",2,0],["ذُعِرَ الحَمامُ وَقَد تَرَنَّمَ فَوقَهُ","مِن مَنظَرٍ خَطِرِ المَزَلَّةِ هائِلِ",11,"ل",1,0],["ذَعَرتُ بِها سِرباً نَقِيّاً كَأَنَّهُ","نُجومُ الثُرَيّا أَسفَرَت مِن عَمائِها",12,"ا",3,0],["ذَعَرْتَهُمُ غَزواً دِراكاً فأصبحوا","على البُعْدِ خَفَّاقَ الحشا ومُسهَّدا",13,"د",2,0],["ذُعِرَ الزَمانُ وَقالَ هَل مِن عاصِمٍ","مِنهُ أَلوذُ بِهِ فَقُلتُ لَهُ لُذِ",14,"ذ",1,0],["ذعرتْ غرابَ الليلِ بي فكأنّني","لأصِيدَهُ منها ركبتُ عُقابا",15,"ب",2,0],["ذُعِرَتْ قُريشٌ هل يُبَدِّلُ دينَها","رَجلٌ ضَعيفٌ في العشيرةِ مُملِقُ",16,"ق",1,0],["ذَعر الحطيمَ وراع يثربَ عاصفٌ","للموت ضجّ لهوله الحرمانِ",17,"ن",1,0],["ذُعِرَتْ لِنكبتِه الجنودُ أعِزَّةً","وتَفزّعَ الأُسطولُ في دأمائهِ",18,"ا",3,0],["ذَعَرَ الجَآذِرَ وَالظِباءَ فَما وَفَت","أَفياءُ مِصرَ وَلا رُبى لُبنانِ",19,"ن",1,0],["ذُعِرَ الوطيحُ فأسلمتكِ حُماتُه","وحَللتِ بالحصنِ الذي لا يُذعَرُ",20,"ر",1,0],["ذُعِرَ الفوارسُ في مُتونِ جيادِهم","لمَّا تردَّى الفارسُ الوثّابُ",21,"ب",1,0],["ذُعِرَ الجمعُ فلو أنّ القطا","طار في آثارِهِ لم يَلحقِ",22,"ق",1,0],["ذُ عَزمَةٍ كَالتِمَاعِ البَرقِ واَقِدَةٍ","تَجِيءُ مِن نَصرِهِ بِالعَارِضِ الهَطِلِ",23,"ل",1,0],["ذُعِرتُ بِقُمرِيٍّ أَغَنَّ يَنوحُ","عَشِيَّةَ رُحنا وَالدُموعُ سُفوحُ",24,"ح",1,1],["ذُعِرْنَ بأبناءِ الضّبابِ وأعْوَجٍ","فأبْكَينَ أبناءَ الجَديلِ وشَدْقَم",25,"م",1,0],["ذَعَرَتْ مواكبُهُ الجبِالَ فأعلَنَتْ","هَضَبَاتُهَا التكبيرَ والتهليلا",26,"ل",2,0],["ذَعَرْتُ بِهِ العَيْرَ مُسْتَوْزِياً","شَكِيرُ جَحَافِلِهِ قَدْ كَتِنْ",27,"ن",1,0],["ذَعَرْتُ بِجَوْسِ نَهْبَلَةٍ قَذَافٍ","مِنَ العِيدِيِّ بَاقِيَةِ القَتَالِ",28,"ل",1,1],["ذُعِرَ الموت أنَّهم لَمْ يَخافُو","هُ ولم يَرْهَبوا لِقاءَ الحديدِ",29,"د",1,0],["ذُعِر الجْنوبُ فقيلَ : كيدُ خوارجٍ !","وسكا الشَّمالُ فقيلَ : صنْعُ جِوار!",30,"ر",1,0],["ذَعَرْتُ أطغاهمْ فبات ساهدا","أسوانَ لا يستوثِرُ الوسائدا",31,"د",2,0],["ذَعَرتُ الذِئبَ يَحفِرُ كُلَّ حَوضٍ","وَيَقضمُ في مَعاطِنِها العِظاما",32,"م",2,0],["ذَعَرتُ عَصافيرَهُ بِالسَوادِ","أُوَزِّعُ ذا مَيعَةٍ مُستَطارا",33,"ر",2,0],["ذَعَرتَ حُماةَ الوَغى مِنهُمُ","كَما اِنذَعَرَت لِلهِزَبرِ الحُمُر",34,"ر",1,0],["ذُعِرتُ لِفُقدانِ الوِصَالِ بِضُرِّهِ","وذلكَ ذُعرٌ لَيسَ منهُ تَعَوُّذُ",35,"ذ",1,0],["ذَعرْتُ به شمْلاً من الطير جامعاً","وضَرَّجْتُها في كلّ ناحية بدَمْ",36,"م",1,0],["ذَعَرتُ ظِباءَهُ مُتَغَوِّراتٍ","إِذا اِدَّرَعَت لَوامِعَها الإِكامُ",37,"م",1,0],["ذَعَرتُ بِهِ القَطا وَنَفَيتُ عَنهُ","مَقامَ الذِئبِ كَالرَجُلِ اللَعينِ",38,"ن",1,0],["ذُعِرتُ بِها سِربَ القَطا وَهوَ هاجِدٌ","وَعَينُ الفَلاةِ لَم تُبَعِّث رِياضُها",39,"ض",3,0],["ذُعِرَتْ بِحِسِّ الإِنْسِ تَحْتَ حِجالِها","واسْتَأْنَسَتْ بِضَرَاغِمٍ وذِئَابِ",40,"ب",1,0],["ذُعِرتْ بحُكمِ الجاهليَّةِ أَن ترى","قَدْ دُسَّ فِي تُرْبِ الثَّرى مَوْؤُودُها",41,"د",3,0],["ذَعَرتُ زماني بأسمائهم","فكنَّ من الدهر دوني حصونا",42,"ن",2,0],["ذُعِرَتْ منهمُ القُلوبُ فأمسَتْ","بينَ أحشائهمْ كمَوتى القُبورِ",43,"ر",1,0],["ذعرت الورى حتى لقد خاف مصلح","على نفسه أضعاف ما خاف مفسد",44,"د",1,0],["ذَعَنَتْ لعزّتهمْ وهَيبتهمْ","الشّيبُ في الأحياء والمُرْدُ",45,"د",1,0],["ذعَرْتُ به المَها وأَرقْتُ لمّا","لبستُ قميصَه ماءَ التَّصابي",46,"ب",2,0],["ذَعَرتُ بِمُقوَرِّ اللِّياطِ مُصَنَّعٍ","مُمَرٍّ كَصَدرِ الرُمحِ عادٍ نَواهِقُهْ",47,"ق",2,0],["ذُعِرَت نُفورُ الآبِداتِ كَأَنَّما","نَصَبَ الصَباحُ لِصَيدِهِنَّ شِباكا",48,"ك",2,0],["ذَعَرَ المطيِّي فَزُحزِحَت ركبانها","ركبانها عن أذرُعٍ وكَراكِر",49,"ر",1,0],["ذعاف الموت أبرده","يقلي بهم واحره يجري",50,"ر",2,0],["ذعرْتُ السّكينَ به آيلاً","وعيْنَ نِعاجٍ تُراعي السّخَالا",51,"ل",2,0],["ذعرت من دبيب أطواده السم","ر ومن صهلة العراب الجياد",52,"د",1,0],["ذعرت فيه الخيل إذ جئتها","أختال فوق السابح الأشقر",53,"ر",1,0],["ذعرت بأيام الفراق متى أنا","بساعات أوقات اللقا أتلذذ",54,"ذ",1,0],["ذعرته يقظاناً وساقت خيفة","منه الرقاد إليه في أحلامه",55,"م",2,0],["ذُعر المجد من تكاليف قوم","نفرته فآنسته طباعه",56,"ع",2,0],["ذَعَروا الدُّجى فَتَناثَرَت مِن جيدِهِ","نَحوَ الصَّباحِ قَلائِدٌ وَعُقودُ",57,"د",1,0],["ذَعَروا الظَّلامَ فَما يَمُرُّ عَلَيهِمُ","إِلّا وَعِقدُ نُجومِهِ مَحلولُ",58,"ل",1,0],["ذَعَرتُ بِرَكبٍ يَطلُبونَكَ بَعدَما","تَجَلَّلَ رَقراقُ السَرابِ المَقارِيا",59,"ي",2,0],["ذعر المتيم حينما نبذوا الوَفا","لَيتَ الحسان عَلى سوآء ينبذوا",60,"ذ",3,0],["ذُعاف الخيل طلاّع الثَّنايا","إلى الأعداء بالحَتف المتاح",61,"ح",1,0],["ذُعِرْتُ لِفُقْدَانِ الوِصَالِ بِغُرَّةٍ","وَذَلِكَ ذُعْرٌ لَيْسَ مِنْهُ تَعَوُّذُ",62,"ذ",1,0],["ذُعرَت بِهِ هُوجُ الرياح فَما جَرَت","في جَوِّهِ إِلا بِقَلبٍ يخفقُ",63,"ق",1,0],["ذعرت متى شامت ضعيفا طالباً","قوتا يغذي أهله أو يغتذي",64,"ذ",2,0],["ذعر النيام لصائح","بالويل يصرخ والحرب",65,"ب",1,0],["ذعنوا لعزته ومن كان الهوى","سلطانه فسبيله أن يخضعا",66,"ع",2,0],["ذُعَافاً سَقَتهُمُ أبَارِيقُ قَهقهَت","بِأيدِي كِرَامٍ طَالَمَا فَلَذُوا فَلذَا",67,"ذ",2,0],["ذُعِرَنَا مِنَ الدَّهرِ الخَؤُونِ وَجَورِهِ","وَلَكِن خِتَامُ الرُّسلِ لُذنَا بِهِ لَوذَا",67,"ذ",2,0],["ذُعرَ الشَّيخُ وانثنى بدُعاءٍ","وفِبُوسُ استَجابهُ واستَجادَه",68,"د",2,0],["ذُعِرَ الشَّيخُ فَانثَنَى وَاجِماً فِي","جُرفِ بَحرٍ يَعُجُّ في الآفَاقِ",69,"ق",1,0],["ذعروا وصحبك يا نسون بجهدهم","فعلى البروكز لدى سراهم عول",70,"ل",1,0],["ذعرت بالسهى كما ربع ريم","ألف الضال باللوى والبشاما",71,"م",2,0],["ذَعرتُ السَوامَ بفرسانِها","إِذا طائِرُ الصُبحِ رامَ النُهوضا",72,"ض",2,0],["ذعرَ النّاس أَنّهم مائِتونا","جهلَ النّاسُ أَنّهم ذاهلونا",73,"ن",2,1],["ذعرتُ سربي بتَوديع الأَوانس لي","كما يُفاجيكَ سِربٌ وهو مذعور",74,"ر",1,0],["ذعذعي يانود من كل الجهاتي","وإفتحي قفل الصناديق السجينه",75,"ن",2,0],["ذعذاعها لا شك به عفن ومخيس","الخير قل ومجهم الشر واصل",76,"ل",1,0],["ذعرتُ فؤادي فاستجار بِلُطْفِهِ","فجاد بنُعْمى ما لها بعدُ مُبْطِلُ",77,"ل",1,0],["ذُعْرِي مِنَ النَّظَراتِ ( ذُعرُ قَصيدَةٍ )","لَقِيَتْ عَلَى مُهَجِ القُلُوبِ حِجَابا",78,"ب",2,0]]}