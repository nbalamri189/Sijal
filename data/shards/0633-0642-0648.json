{"poems":[[66,"سقوني وقالوا لا تغن ولا سقوا","https://www.aldiwan.net/poem67573.html","الطويل"],[14,"أرقت وصحبتي بمضيق عمق","https://www.aldiwan.net/poem38306.html","الوافر"],[101,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[51,"ألا يا أيها البشر","https://www.aldiwan.net/poem62097.html","مجزوء الوافر"],[54,"روينا فما نزداد يا رب من حيا","https://www.aldiwan.net/poem27065.html","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39403","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43641","الطويل"],[108,"عرش ينوح","https://www.poetsgate.com/ViewPoem.aspx?id=179684",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[113,"سقوط ألف من العليه","https://www.aldiwan.net/poem16634.html","مخلع البسيط"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[285,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[285,"سقوه كأس فرقتهم دهاقا","https://www.aldiwan.net/poem60789.html","الوافر"],[287,"بكم قلبي عليل ما يبل","https://www.aldiwan.net/poem32664.html","الوافر"],[408,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[415,"سقوف الدور في خربرت سود","https://www.aldiwan.net/poem31709.html","عموديه"],[422,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83319","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54149","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100580","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44839","الطويل"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138028","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101061","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94296","الرجز"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112604","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71302","المنسرح"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126938","الوافر"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34613","الهزج"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45965","الطويل"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62127","السريع"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28923","الطويل"],[4883,"صورة با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=48361",""],[5081,"سَلَامُ اللهِ يَا حُلْمَاً","https://www.poetsgate.com/ViewPoem.aspx?id=185620",""],[5213,"حتام تبقى بظهر الغيب محتجبا","https://www.poetsgate.com/ViewPoem.aspx?id=170420",""],[5431,"جدوى الحياة....","https://www.poetsgate.com/ViewPoem.aspx?id=205102",""],[5431,"العبودية الجديدة 2 -عمليات التجميل","https://www.poetsgate.com/ViewPoem.aspx?id=210782",""],[5431,"شعر معتّق...","https://www.poetsgate.com/ViewPoem.aspx?id=211179",""],[5732,"الجادل اللي","https://www.poetsgate.com/ViewPoem.aspx?id=177913",""],[5956,"تمدين كفيك","https://www.poetsgate.com/ViewPoem.aspx?id=182450",""],[6055,"إلى الحداثة....مع التحية","https://www.poetsgate.com/ViewPoem.aspx?id=30577",""],[520,"إذا قدرت على العلياء بالغلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577434",""],[6279,"العابث الهاذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78844&r=&rc=60",""],[422,"إذا نَبَتِ الدّيارُ بِحرِّ قومٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22246&r=&rc=2",""]],"verses":[["سَقَوني وَقالوا لا تُغَنَّ وَلا سَقَوا","جِبالَ حُنَينٍ ما سُقتُ لَغَنَّتِ",0,"ت",1,1],["سَقَوني النَسءَ ثُمَّ تَكَنَّفوني","عُداةُ اللَهِ مِن كَذِبٍ وَزورِ",1,"ر",1,0],["سقوا فلسطين أحلاماً ملونةً","وأطعموها سخيف القول والخطبا",2,"ب",2,0],["سُقوفُ بُيوتِهِم فيما","هُناكَ الطينُ وَالمَدَرُ",3,"ر",1,0],["سُقوفُ بُيوتي صِرنَ أَرضاً أَدوسُها","وَحيطانُ داري رُكَّعٌ وَسُجودُ",4,"د",1,0],["سَقَوني حِمامي يومَ ساقُوا حُمولَهُمْ","فرحتُ وراحُوا بينَ ساقٍ وسائِقِ",5,"ق",1,1],["سقوا الغَيثَ حَتّى يورِقَ العَيشُ عِندَهُم","وَيَختال في حَليٍ وَأَثواب سُندُسِ",6,"س",1,0],["سقوط المؤبِّنُ وهْو يَسمعُ شعرَه","من ذا يؤبِّنهُ بمثل بيانه؟",7,"ن",2,0],["سقَوا أرضَهم بنجيعً الدِّماءِ","فكانَ الشعارَ الدَّمُ المُستقى",8,"ا",1,0],["سُقوط أَلف مَن العليَّه","عِندَ ذَوي المَجد وَالحَميَّه",9,"ه",1,1],["سَقَوا صُدُورَ القَنا عَلّا وَقد نَهِلَت","وَأَكرَهُوا المازِنَ الخَطِّيَّ فَاِنحَطَما",10,"م",2,0],["سُقُوا وَرُعُوا بِجُودِكَ لا اسْتِقاءً","أَيا جَمَّ السَّماحِ وَلا احْتِيازا",11,"ز",2,0],["سَقَوْهُ كَأْسَ فُرْقَتِهِمْ دِهَاقا","وَأَسْكَرَهُ الْوَدَاعُ فَما أَفَاقا",12,"ق",2,1],["سَقَوا مِن نَرجِسِ الأَحداقِ وَرداً","فَفي وَردِ الخُدودِ الدَّمعُ طَلُّ",13,"ل",1,0],["سَقوا كلَّ أرضٍ من دماء رقابهم","وشِيعتِهم حتّى ارتوى الحزن والسَّهلُ",14,"ل",1,0],["سقوف الدور في خربرت سود","كستها النار أثواب الحداد",15,"د",1,1],["سَقَوا أعداءهم حمرَ المنايا","بسمر الخطِّ والبيضِ الصفاح",16,"ح",1,0],["سقوا بأسكر سُكرٍ لا انقضاء له","من قهوة الموت لا من قهوة العنب",17,"ب",1,0],["سَقوا تُربَةَ الأَرضَينِ سَهلاً وَمَرقَباً","مِنَ الدَمِ بِالأَنهارِ لا بالجَداوِلِ",18,"ل",1,0],["سقوا بكأس الردى من عند آخرهم","حتى رووا منه بين العل والنهل",19,"ل",1,0],["سَقوني بِها عَقلاً وروحاً وَجُثّةً","فَرُحتُ بِها الوَلهانَ وَالمُغرَمَ الصابي",20,"ب",2,0],["سقوه مدام الذل صرفاً لم يزل","يود بأن يسقي الحمام مشعشعا",21,"ع",2,0],["سَقَوا حسناً بِالسُّمِّ كَأساً رَوِيَّةً","وَلَم يَقرَعُوا سِنّاً وَلَم يَتَنَدَّموا",22,"م",3,0],["سَقَوْا حَسَناً سُمّاً ذعافاً وجَدَّلوا","أخاهُ حُسَيْناً بالقَنا والقَواضِبِ",23,"ب",1,0],["سقوا بأسنا صرفاً فهم بين طائح","على الموج صالٍ بالجحيم ومغرق",24,"ق",1,0],["سقونا بها مرّاً من العيش آجنا","ويا ليتهم لم يرهقوا الناس بالمن",25,"ن",1,0],["سقوا كؤوس الموت صرفا وانثنوا","من سكرهم ولا انثناء الثمل",26,"ل",1,0],["سقوط والوزير إذا لم يكن","إليه لأوطانه مفزع",27,"ع",1,0],["سُقُوا وَلَمْ يَسْكَروُا وَكَمْ فِئَةٍ","أَسْكَرَهُمْ عِطْرُهَا وَمَا شَرِبُوا",28,"ب",3,0],["سقوا جرع الردى منهم بسم","ومنهم في حدود الماضيات",29,"ت",1,0],["سقونا وسقيناهم","فكانت بهم الحرَّه",30,"ر",2,0],["سَقوني حُمَيّا حُبِّهِم غَيرَ مَرَّةٍ","ثَمِلتُ بِها سُكرا وَما عادَلي عَقلُ",31,"ل",1,0],["سقوهم عللاً من بعد ما نهلوا","منها فصار العطاش الهيم في سأب",32,"ب",1,0],["سقوط جدواك على آمل","همت بتكثير عطياته",33,"ت",2,0],["سقوا بالعقارِ الصرف حتى تتابعوا","كَدأبِ ثمودٍ إذ رَغا بكرُهم ضحى",34,"ا",1,0],["سْقوفها من زبرجد طّل مابين :",".ستاير ٍ ما حكت للريح نسيان!",35,"ن",1,0],["سَقَوْهَا مَاءَ أَطْمَاعٍ","فَلَمْ تُورِقْ مَعَانِيهَا",36,"ي",3,0],["سقوا اباك بكأس مر مطعمه","ما ان تسقيهم الكأس الذي شربا",37,"ب",2,0],["سقوطٌ إلى أحشاء حوتٍ مروّع","وليس لنا حبلٌ يُشدّ على التقوى!!",38,"و",2,0],["سقوطٌ في الوحول مع اصطيادٍ","ومائدة من الدون اللكاع",39,"ع",1,0],["سقوطٌ بأحضان الفراغ ملازمٌ","لفقدان فحوى الشعر مبنى ومنطق",40,"ق",1,0],["سقوا ليا من الليالي اضحكنا","وهلا وانا من خافق القلب هليت",41,"ت",1,0],["سقوطُ النساءِ قليلٌ ولكنْ","سقوطُ الرجال كَعَدِّ الدِّلاءِ",42,"ا",2,0],["سقوا النخلَ من براكين ألبا","بٍ تحيي الخنا وتعلي الرذيلة",43,"ل",2,0],["سقوا بأسكر سكراً لا انقضاء له","من قهوة الموت لا من قهوة العنب",44,"ب",1,0],["سُقوطٌ زمانُكَ لَستَ الوحيدَ","تأمَّعْ تَذَيَّلْ كَباقِ الفُتُوتْ",45,"ت",1,0],["سَقَو أعداءهم حمرَ المنايا","بسمر الخطِّ والبيضِ الصفاح",46,"ح",1,0]]}