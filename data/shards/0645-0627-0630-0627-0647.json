{"poems":[[102,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[102,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105355","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86407","الكامل"],[4691,"إن لم تكوني أنتِ من سيكونُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=207321",""],[4908,"وجع (هنا عدن )","https://www.poetsgate.com/ViewPoem.aspx?id=212779",""],[4978,"رد على قصيدة فلسفتي والنسبية","https://www.poetsgate.com/ViewPoem.aspx?id=177283",""],[1470,"نبع الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=12967",""],[5411,"سَيُهْزَمُ الْجَمْعُ","https://www.poetsgate.com/ViewPoem.aspx?id=208610",""],[5784,"من وحي الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=202425",""],[6089,"أرماحُ الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=213393",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[6308,"إني أحبكَ أكثر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87729&r=&rc=7",""]],"verses":[["ماذا هناك ؟ وراعه","شيء ، كلعلعة القذائف !",0,"ف",1,0],["ماذا هنا اليوم ، يا دنيا ؟ هنا يمن","طفل ، على شفتيه يبسم الظفر",1,"ر",1,0],["ماذا هُنالِكَ مِن أَسوانَ مُكتَئِبٍ","وَساهِفٍ ثَمِلٍ في صَعدَةٍ حِطَمِ",2,"م",1,0],["ماذا هدّوك في الدجى واخو الهوى","قلق الوسادة لا يقر من الظنا",3,"ن",2,0],["ماذا هدوك في الدجى وأخو الهوى","قلق الوسادة لا يقر من الضنى",4,"ن",2,0],["ماذا هنالك فوق هذا خبّري","كي تستريح من اليقين ظنونُ",5,"ن",1,0],["مَاذَا هُنَا؟ عَدَنُ الجَرِيحَةُ ويْحَكُمْ","أنْهَكْتَها الأمْرَاضُ والأمْطَارُ",6,"ر",1,0],["مَاذَا هُنَا؟ عَدَنٌ الأسِيفَةُ ويْحَكُمْ","لا صِحَّةٌ لا مَاءُ لا (تَيَّارُ)",6,"ر",1,0],["مَاذَا هُنَا؟ عَدَنُ السَّلام محَبَّةٌ","للسَّاكِنِين، وثَغْرُهَا نَوَّارُ",6,"ر",1,0],["ماذا هنا ؟ إطلالة فوق الوجود","من نفخة الرحمن شدت للخلود",7,"د",1,1],["ماذا هنالك في «القناة»؟ مجازرٌ","تتخطّف الأشياخ.. والفتيانا",8,"ن",2,0],["مَاذا هُناكَ سِوَى أَنِّي بَقَيْتُ هُنا","تَحْتَ العَذابِ ! وَما يُدْريكَ يا وَلَدي!!..",9,"د",2,1],["ماذا هناك سوى طلولٍ أَقْفرتْ","لكنَّ أعتاب الطلول مبلَّلهْ",10,"ل",2,0],["ماذا هنا؟ قلبٌ قلاهُ الصاحبُ","وعليه أرماحُ الأسى تتناوبُ",11,"ب",1,1],["ماذا هُنَاكَ ، لماذا الشَّمْسُ في خَفَرٍ","تُغَفْغِفُ اليومَ كالعذراءِ تَنْكَسِرُ؟",12,"ر",1,0],["مَاذَا هُنَا غَيْرُ شَوْقٍ","وَدَمْعَةٌ لا تُصَوَّرْ",13,"ر",1,0]]}