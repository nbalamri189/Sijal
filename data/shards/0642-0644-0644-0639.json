tml","البسيط"],[534,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[556,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[556,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[563,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[580,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63881","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119968","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119885","الرجز"],[1391,"","https://poetry.dctabudhabi.ae/diwan/poem/21202","الرمل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82325","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79851","الخفيف"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45367","الخفيف"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202565","المتقارب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106880","الكامل"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199885","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58459","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133974","الخفيف"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82360","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89255","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32410","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73162","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28645","الرمل"],[4729,"قُلْ لعماد الدين يَا كَاتباً","https://www.poetsgate.com/ViewPoem.aspx?id=109455",""],[4729,"قُلْ لِعمادِ الدين يَا شَاعرا","https://www.poetsgate.com/ViewPoem.aspx?id=109462",""],[4729,"قُل لعمادِ الدين عَني إذا","https://www.poetsgate.com/ViewPoem.aspx?id=109470",""],[4729,"قل لِ عماد الدين وهو الذي","https://www.poetsgate.com/ViewPoem.aspx?id=109449",""],[4729,"قُلْ لِ عماد الدين يَا كَاتبا","https://www.poetsgate.com/ViewPoem.aspx?id=109458",""],[5204,"قل لعبد الصمد","https://www.poetsgate.com/ViewPoem.aspx?id=200364",""],[4444,"قل لعريب لا تكوني مسلعسة","https://www.poetsgate.com/ViewPoem.aspx?id=85448",""]],"verses":[["قُل لِعَذولي اليَومَ نَم صامِتاً","فَقَد كَفاني الشَيبُ أَن أُعذَلا",0,"ل",2,0],["قُل لِعَبدِ الرَقيبِ قُل رَبِّيَ اللَ","هُ فَاِن قالَها فَلَيسَ بِجَعدي",1,"ي",1,1],["قل لعبد القويِّ أنت قويٌّ","فاتَّقِ اللَّهَ وَيْكَ في الضعفاءِ",2,"ا",2,1],["قل لعبدِ القويِّ تَبّاً لعلمٍ","لم يجد غيرَ عالمٍ بَغّاءِ",3,"ا",2,1],["قلْ لِعمَّارِ بن عمَّا","ر ألا تُعظِمُ قدري",4,"ر",2,1],["قُل لِعَدِيٍّ جاءَ مَن كُنتَ تَبتَغي","إِلَيكَ فَلا تَحفِل بُدورَ الدَراهِمِ",5,"م",1,1],["قلْ لعليٍّ سَقتْكَ غاديةٌ","مُسِفَّةُ الوَدْقِ ذاتُ إرذاذِ",6,"ذ",1,0],["قُل لِعَبدونَ أَينَ ذاكَ الحَياءُ","إِنَّ داءَ المُجونِ داءٌ عَياءُ",7,"ا",2,1],["قُل لَعاً لِاِبنِ عَثرَةٍ ما لَهُ مِن","ها بِشَيءٍ سِوى نَداكَ نُهوضُ",8,"ض",1,0],["قُلْ لِعَلِيٍّ الَّذي صَدَاقَتُهُ","عَلَى حُقُوقِ الإِخْوَانِ مؤْتَمَنَهْ",9,"ن",2,1],["قُل لِعَبدِ الكَريمِ يا اِبنَ أِبي العَو","جاءِ بِعتَ الإِسلامَ بِالكُفرِ موقا",10,"ق",2,1],["قُل لِعَبّادَةَ رُدّي","بَعضَ حُزني وَأَذاتي",11,"ت",2,0],["قُلْ لعدُوّ الأميرِ يا غَرَضَ الدْ","دَهْرِ ومن حَتْفُ نفْسِه دَدُها",12,"د",3,0],["قُل لِعينَيكَ عِدَا شَوقَ غَدِي","واحتَبِس في مَنبَتِ القَرنَينِ نوحَك",13,"ك",1,0],["قُل لِعَبدِ العُزّى أَخي وَشَقيقي","وَبَني هاشِمٍ جَميعاً عِزينا",14,"ن",2,1],["قل لعبد العظيم عني مقالا","فيه عَتبٌ أضحى طويلا عريضا",15,"ض",2,1],["قل لعذّالٍ عموا عن شمسها","هل ترى يوماً بألحاظ عُمَي",16,"ي",1,0],["قُلْ لِعَهدِ الوَلِيِّ هَذَا وَلِيُّ العَهدِ","يَشْفِي انْهِلالُهُ الإِمْحالا",17,"ل",2,0],["قُلْ لعمادِ الدينِ عن عَبْدِه","ما أنا من عَفْوِكَ بالقانِطِ",18,"ط",1,1],["قل لعليِّ الخيلُ قَد خَيّلَت","أنفُسَها الغُرَّ من الحَزمِ",19,"م",1,1],["قُل لِعُبَيدِ اللَّهِ مُستَرشِداً","فالحازِمُ الآخِذُ بِالحازِمِ",20,"م",1,0],["قلْ لعينيك إنَّها قَتَلْتنا","أحسِني بالمتيَّم الصبِّ قتلا",21,"ل",2,0],["قل لعذّالي فلا حَضَروا","ولحُسّادي فلا كانوا",22,"ن",3,0],["قل لعميد الدولة افلح بها","قد سلَّم الخصمُ وزال المِرَا",23,"ر",2,0],["قُلْ لعميدِ الحيّ بين بابلٍ","والطَّفِّ جادت ربعَك الغوادي",24,"د",2,0],["قُلْ لِعَلِيٍّ نَالا","مِنْ رَبِّهِ الإقْبالا",25,"ل",2,1],["قل لعينيَّ لا تَمَلّا الدّموعا","تارةً أدمعاً وأخرى نجيعا",26,"ع",2,1],["قلْ لعميدِ الدّولةِ الأشدِّ","وَالمُعتلِي في هضباتِ المجدِ",27,"د",1,0],["قل لعُبَّاد الخيالِ","كم قيام في الخبالِ",28,"ل",1,1],["قل لعدوٍّ جرى ليلْحَقه","هيهَات هيهاتَ لستَ باللاَّحِق",29,"ق",1,0],["قل لعمروٍ عمروِ بن عثمانِ يا فَا","رسَ طبٍّ أعيى على كلِّ فارسْ",30,"س",1,1],["قل لعلاء الدين أعلى الورى","قدرا فما أشكوه إلا الَيك",31,"ك",1,0],["قل لعلاء الدين يا","أكرم من فوق الثرى",32,"ر",2,1],["قُل لِعَدنانٍ فُديتُم شَمِّروا","لِبَني الأَعجامِ تَشميرَ الوَحى",33,"ا",1,0],["قُل لِعيسى الأميرِ عيسى بنِ عَمرٍو","ذي المَساعي العِظامِ في قَحطانِ",34,"ن",1,1],["قل لعبد الكريم بُشراكَ يا مَن","شاد بيتَ المكارم المعمورا",35,"ر",2,0],["قُل لِعَمرو بن مذحج","خابَ ما كُنتُ أَرتَجي",36,"ي",1,1],["قل لعبد القيس يا أكرم من","مد كفا بحباء واحتبا",37,"ب",2,0],["قل لعدوِّ غداً تصبحكم","بنتُ البحار ببأسها تفد",38,"د",1,0],["قل لعبد النضير مسلم الوغد","الدني اللئيم شيخ النصاب",39,"ب",1,1],["قُل لعين الأماثلِ الأعيان","وَمَحلِّ الإنسانِ من إنساني",40,"ن",2,1],["قل لعبد الهوى وقد كان حراً","أرضيت السواد بعد البياض",41,"ض",1,0],["قُل لعبدِ اللَّهِ يَشدُد في الهَرَب","نَجم الثَّائِر مِن وادي القَصَب",42,"ب",1,1],["قل لعين الدواة تبكي ودمع ال","حبر في وجنة الرقاع تريق",43,"ق",1,0],["قُل لِعَبّاسٍ أَخينا","يا ثَقيلَ الثَقَلاءِ",44,"ا",2,1],["قل لعينيكَ ما رأيتَ عِياناً","كيفَ يُحمَى بالنَّرجِس الجُلَّنارُ",45,"ر",1,0],["قُل لِعيسى أَنفِ أَنفِه","أَنفُهُ ضَعفٌ لِضَعفِهْ",46,"ف",2,1],["قُلْ لعماد الدين يَا كَاتباً","أنهضتُ منه غيرَ نَهّاضِ",47,"ض",1,1],["قُلْ لِعمادِ الدين يَا شَاعرا","أوزانُه في الشعرِ مَومُوقَهْ",48,"ق",2,1],["قُل لعمادِ الدين عَني إذا","رأيتَهُ في بُهرةِ الحَفلِ",49,"ل",1,1],["قل لِ عماد الدين وهو الذي","يَمتُّ بالفقهِ وبالشعرِ",50,"ر",1,1],["قُلْ لِ عماد الدين يَا كَاتبا","خُص بصيتِ المجدِ والرّفعَهْ",51,"ع",2,1],["قل لعبد الصمد الأح","مق لا يغضب عليّه",52,"ي",2,1],["قل لعريب لا تكوني مسلعسة","وكوني كنزيف وكوني كمونسه",53,"ه",1,1]]}