try.dctabudhabi.ae/diwan/poem/62909","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66438","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199024","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199019","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131077",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62136","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133063","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58150","الخفيف"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4755,"ثُمَّ باعُوا جَنوبَنا والشمالا","https://www.poetsgate.com/ViewPoem.aspx?id=190112",""],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4767,"ذهب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=180947",""],[4929,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199291",""],[4931,"مدارات الحِداد","https://www.poetsgate.com/ViewPoem.aspx?id=31110",""],[5150,"اللحن الخالد - دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=202798",""],[5216,"جاحدة","https://www.poetsgate.com/ViewPoem.aspx?id=187019",""],[5903,"لي هوىً","https://www.poetsgate.com/ViewPoem.aspx?id=124149",""],[5956,"الحب السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=181895",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6167,"نداء الأمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85478&r=&rc=7",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[5190,"طر يا حجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78347&r=&rc=60",""]],"verses":[["ثُمَّ بَنوا القَرمِ العَتيكِيِّ وَقَد","رَدّوا يَزيدَ العارِ مَخلوعَ الرَسَن",0,"ن",1,0],["ثُمَّ بِالعَينِ عُرَّةٌ تَكسِفُ الشَم","سَ وَيَوماً ما يَنجَلي إِظلاما",1,"م",2,0],["ثم بثّوا بها العيون يعيثو","ن فساداً في سُوحها والمباني",2,"ن",2,0],["ثُمَّ بَدا في خَلقِهِ ظاهِراً","في صورَةِ الآكِلِ وَالشارِبِ",3,"ب",1,0],["ثم بُرِّدتَ فانتصفتَ من النا","ر ببردٍ يُربي على الزمهرير",4,"ر",1,0],["ثُمَّ بِالغولِ أَبي هَدَّدَني","أَينَ مِن غولِ المَنايا مَهرَبي",5,"ب",2,0],["ثمَّ بانَتْ في سُفو","رٍ فاضِحٍ أيَّ افْتِضاحِ",6,"ح",1,0],["ثُمَّ بَرطَلتُهُ بِبَيدَقِ فيلي","وَدَفَعتُ الثاني عَلى الفَرَسَينِ",7,"ن",1,0],["ثُمَّ بَرَزنا نَقتَفي آثارَهُ","وَنَقصِدُ الأَملاقَ وَالمَناهِلا",8,"ل",2,0],["ثُمَّ بِرَعدٍ صَخِبِ الإِرعادِ","يَسلُقُها بِأَلسُنٍ حِدادِ",9,"د",1,0],["ثُمَّ باتَ الرَكبُ نُوّا","ماً وَلَم يَطعَم غُموضا",10,"ض",2,0],["ثُمَّ بَنى مِنَ الغُصوبِ دارا","فَأَصبَحَت موحِشَةً قِفارا",11,"ر",2,0],["ثُمَّ بَدا لِلسِرِّ مِن آلِ عَلي","مُجانِبٌ فِعالَ ذي الرُشدِ التَقي",11,"ي",1,0],["ثُمَّ بَكَوا مِن بَعدِهِ وَناحوا","جَهلاً كَذاكَ يَفعَلُ التِمساحُ",11,"ح",1,0],["ثُمَّ بَدا خالُهُ الفَريدُ الَّذي","لَيسَ لَهُ مُؤنِسٌ وَلا رَهِمُ",12,"م",1,0],["ثُمَّ بُدِّلتُ صَفحَتي لِلغَواني","كُلُّ شَيءٍ إِلى بِلىً مَردودُ",13,"د",1,0],["ثُمَّ بادَ المَصيدُ مِن بَعدُ وَالصا","ئِدُ لا شَيءَ غَيرَ ذَلِكَ حاصِل",14,"ل",1,0],["ثمَّ بَنى حِصْناً عليها راتبا","يَعْتَوِرُ القُوَّادَ فيهِ دائبا",15,"ب",2,0],["ثمَّ بَانَت ولم تُطلَّقْ ثلاثاً","لم تَبِنْ حُرَّةٌ بغَيرِ طَلاقِ",16,"ق",1,0],["ثم بعد أن نهضوا","برهة قد اِنقَلبوا",17,"ب",3,0],["ثمّ باسمِ الحصادِ في كلّ حقلٍ","تتناجى حبيبةٌ وحبيب",18,"ب",1,0],["ثُمَّ بَعدَ القَلاحِ وَالمُلكِ وَالنِع","مة وَأَرَتهُم هُناكَ القُبورُ",19,"ر",1,0],["ثمَّ بعدَ الّتي وبعد اللّتيّا","جاءَ كلّ الوَرى رسولاً نبيّا",20,"ي",2,0],["ثمَّ بدرُ البطحاءِ عبدُ منافٍ","هاشمٌ شيبةُ الفتى المعطاءُ",21,"ا",2,0],["ثُمَّ بانَ الصبا وَعَفَّ التَصابي","وَتَجافى الهَوى وَخَفَّ الحَريقُ",22,"ق",1,0],["ثم بعت الهناء وهو ثمين","بخسيس من الكآبة دون",23,"ن",1,0],["ثم بالحوض والشفاعة في الح","شر لكل الورى ورفع اللواء",24,"ا",2,0],["ثمّ بتنا نُهدي صلات صلاةٍ","لحبيب المهيمن الخلّاق",25,"ق",1,0],["ثُمَّ بِالأَحزابِ وَالفَتحِ مَعاً","كانَ فيها حَتفُ أَهلِ القِبلَتَين",26,"ن",1,0],["ثُم بِتنا مَعا ضجيعين من غي","هب لَيل الجَفا به في صيانِه",27,"ن",2,0],["ثم بِتنا عَلى فِراش التَهاني","بِصَليب من جيدِهِ وَذِراعي",28,"ع",2,0],["ثم بَغَى صرفُهُنَّ فانظُر","عُقباهُ لمَّا استَطالَ بَغيا",29,"ي",2,0],["ثم بعد الفنابقا","ثم كم فوق ذا مقام",30,"م",1,0],["ثم بالسمع قد حباك لتدري","أي صوت يهدي إلى آذانك",31,"ك",1,0],["ثم بيت التأريخ أصدق فال","صادق يا عماد من أحكامك",32,"ك",1,0],["ثم بتنا في ليلة ننظر الفك","ر بأجفان همة أمَّاله",33,"ل",2,0],["ثم بُحْ بالهوى ونَادِ جهاراً","مَن مُجيرِي من الهوى من مجيري",34,"ر",2,0],["ثم بعض كان في النور يعوم","ذاك نور البدر أو نور السحر",35,"ر",1,0],["ثُمَّ بَدا الصُبحُ بِوَجهٍ مُسفِرِ","وَغابَتِ الجَوزاءُ إِثرَ المُشتَري",36,"ي",1,0],["ثُم بالعُذرِ أسعِفُوه سَقِيما","وأخو السُّقمِ واجبُ الإسعَافِ",37,"ف",1,0],["ثُمّ بنيك الغُرّ مُلِّيتَ مِنْ","بقائهمْ بالأمثلِ الأمثلِ",38,"ل",1,0],["ثم بالأرواح ساروا","في غرام وشجون",39,"ن",1,0],["ثم بالنفخ كان مزج أصول","أربع واسمه المزاج اصطكاكا",40,"ك",2,0],["ثم بالشرع والحقيقة نأتي","ظاهراً باطناً ولا تخييرا",41,"ر",2,0],["ثم بي مال عنه لي وهو طوعي","فرأيت الأشفاع في الأفراد",42,"د",1,0],["ثم باآتي جيمعا","دخلت في ألفاتي",43,"ت",2,0],["ثم بادرتُ اليهِ","باحتيالٍ واعتمالِ",44,"ل",1,0],["ثم بعثنا ألفَ عين في جَسَد","فجئننا بمثلهنَّ في العدد",45,"د",1,0],["ثمَّ بَلِّغه مِنَ الصبِّ الَّذي","ذابَ بِالشَّوقِ صَلاةً وَسَلاما",46,"م",2,0],["ثُم بِنَعجَةٍ صَغيرَةٍ ظفِر","قَد وَقَعَت في يَدِهِ وَلَم تَفِرّ",47,"ر",1,0],["ثُمَ بَدا لَهُ الرُجوع ثانيا","وَسَأل الخدّام وَالعَوانيا",48,"ي"