.ae/diwan/poem/135899","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130560","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119598","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81686","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73193","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99113","البسيط"],[4782,"مواسم","https://www.poetsgate.com/ViewPoem.aspx?id=215403",""],[4858,"أبكي المروءة","https://www.poetsgate.com/ViewPoem.aspx?id=33887",""],[5186,"تجنت على عشاقها وارتضوا عشقا","https://www.poetsgate.com/ViewPoem.aspx?id=156458",""],[5279,"الصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=215615",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5351,"هنا اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=202214",""],[5525,"محبوبة المطر","https://www.poetsgate.com/ViewPoem.aspx?id=7269",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5725,"يا ليل شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214904",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5937,"مأوى العطور","https://www.poetsgate.com/ViewPoem.aspx?id=211811",""],[6093,"بوجه نَعُومٍ رأيت شروقاً ( المتقارب )","https://www.poetsgate.com/ViewPoem.aspx?id=176585",""],[3099,"أبكي الشبابَ لندمانٍ وغانية ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59178&r=&rc=2",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""]],"verses":[["وَلِلصَوارِمِ ما شاءَت مَضارِبُها","مِنَ الرِقابِ شَرابٌ غَيرُ مَنزورِ",0,"ر",1,0],["وَلِلصَّارِمِ المأثورِ يَحميهِ قَومُهُ","بِهِ مِن رِقابِ العاشِقينَ قِرابُ",1,"ب",1,0],["وللصُّقورِ مَدًى لا تَرْتَقي صُعُداً","إليهِ أغرِبةٌ تَهْفو خَوافيها",2,"ي",3,0],["وللصّبْرِ أوْلَى أنْ يَكونَ رُجوعُنا","إذا لَمْ نَكُنْ بالحُزْنِ نُرْجعُ فائِتا",3,"ت",2,0],["وللصديق ظهيرٌ","من عزه ونصير",4,"ر",1,0],["وللصنائع والآلاء تصفيةٌ","عند الكرام تراها تلكمُ الفِطر",5,"ر",1,0],["وَلِلصَهباءِ أَوقات وَهَذي","شَرابُ الناسِ في حَر وَقَرِّ",6,"ر",1,0],["وَلَلصوفُ أَولى بِالأَئِمَّةِ مِن سَبا ال","حَريرِ وَإِن راقَت بِصِبغِ جَسادِها",7,"د",3,0],["وَلِلصُّبحِ نورٌ في الظلامِ كَما اكتَسى","حَميماً بِطولِ الركضِ في الصدرِ أَدهَمُ",8,"م",1,0],["وَلَلصَبرُ خَيرٌ حينَ بانَت بِوُدِّها","وَزَجرُ فُؤادٍ كانَ لِلبَينِ يَخشَعُ",9,"ع",1,0],["وَلِلصاحِبُ المَتروكُ أَعظَمُ حُرمَةٌ","عَلى صاحِبٍ مِن أَن يَضِلَّ بَعيرُ",10,"ر",1,0],["وَلَلصَدمَةُ الكُبرى قَريبٌ وَإِنَّها","لِتِلكَ الَّتي يَزوَرُّ عَنها المُصادِمُ",11,"م",1,0],["وللصّارخِ الملهوفِ أوّلُ ناصرٍ","وللمُتْرَفِ الجبّارِ أوّلُ قاصم",12,"م",1,0],["وَلِلصَبابَةِ حَولي","مَدينَةٌ وَقَبيلُ",13,"ل",1,0],["وَلِلصَعبِ أَسبابٌ تَجُلُّ خُطوبُها","أَقامَ زَماناً ثُمَّ بانَت مَطالِبُه",14,"ب",2,0],["وللصُّبح عِنْدي مِنَّةٌ كُلَّمَا نَبَا","بي اللَّيْلُ أَوْ طَالَتْ عليّ هَيَادِبُهْ",15,"ب",2,0],["وللصبح سلطان على الليل قاهر","يرحله عنا بغير جنود",16,"د",1,0],["وللصبر سلطان على كل نكبة","وصبري فيه لا يقوم مؤود",17,"د",1,0],["وللصعبِ أسبابٌ نجلُّ خطوبها،","أقامَ زماناً، ثمّ بانتْ مطالبهُ",18,"ب",2,0],["ولِلصَّبْرِ أَثوابٌ تَشِفُّ إذا بكى","مُحِبٌّ، وحاشا صادقُ الحُبِّ يَدَّعِي",19,"ع",2,0],["وللصبا تنطوي صحائفه","ولم يزل نشرها يفاوحنا",20,"ن",2,0],["وللصدى حولنا حال مروعةٍ","كأنما تسكن الغيران جنان",21,"ن",1,0],["وللصائمين اليوم تبدو جوائزٌ","من الله أدناها التنقي من الذنبِ",22,"ب",1,0],["وللصلاة وللتسبيح لا لعبا","يغري امرءا بالتصابي وهو غير صبي",23,"ب",2,0],["وللصَّبا خَلَلَ الأغصانِ وَسْوَسةٌ","كالصَّبِّ للحِبِّ يشكوه ويُعْتِبه",24,"ب",2,0],["وللصلاةِ كمالٌ وهْو ذِكْركمُ","خِلالَها عندَ إصدارٍ وإيراد",25,"د",1,0],["وللصباحِ ألا فانْشُرْ رداءَ سناً","هذا الدُّجى قد طَوَتْهُ راحةُ السَّحَر",26,"ر",1,0],["وللصبحِ يبدي تباشيرَهُ","ويروي الهنا عن إمامِ الأدبْ",27,"ب",1,0],["وللصَّبا في الرُّبا نِسيمٌ","كأنّه عنبرٌ وبانُ",28,"ن",1,0],["وللصبا نشر روته السبل","كأنها ممن احب رسل",29,"ل",1,0],["وللصحائف تأتيني بها كرم","كأنه للأيادي البيضِ تمثيل",30,"ل",1,0],["وَلِلصَباح نَسيمٌ قد تأَرَّج من","رَيحانةِ الفجر أَو من وردَة الشَفَقِ",31,"ق",1,0],["وَللصراطِ عَليها موردٌ رهقٌ","يَلجا إِلى جشمهِ ناجٍ ومرتطمُ",32,"م",1,0],["وللصمت أصداءٌ كأنّ زفيفها","فحيح سقيم الروح يشجى الأفاعيا",33,"ي",2,0],["وَلِلصَديق الأَكرَم الأَجلِّ","بَدر التُقى عُمر أَفندي التلّي",34,"ي",1,0],["وللصَّدْرُ للإسلامِ درعٌ يَصونُه","وقَلبٌ أمينٌ سِرّه ليس يُنبَث",35,"ث",1,0],["وللصَّبّ آياتٌ تَدلُّ على الهوى","تُصرِّح أحياناً به وتجمجمُ",36,"م",1,0],["وللصّحب ملك الأنس واللطف والوفا","وبأسٌ شديد للعداة وضيغم",37,"م",1,0],["وللصبح عندي بردةٌ من عَجاجةٍ","زجاجِ العَوالي طَرْزها والمناصل",38,"ل",1,0],["وللصَّبر ما بين الحَيازيم والحَشا","كدعْس القَنا الخطِّيِّ صمَّمَ شَارعه",39,"ع",2,0],["وللصوارم في أجفانها أسف","تكاد من حره الأجفان تستعر",40,"ر",1,0],["وللِصَّحيح البُخارِي في الضُّحى خَتَموا","فَالنُّورُ مِنهُ ومِنها اليومَ نُورانِ",41,"ن",1,0],["وَلِلصَهباءِ أَسماءٌ وَلَكِن","جَهِلتُ بِأَنَّ في الأَسماءِ ريقا",42,"ق",2,0],["وللصديقِ التِفاتٌ مِن صَداقَتِهِ","إلاّ لدَى حُكمِ تسريحٍ وإمساكِ",43,"ك",1,0],["وَللصدأ المسود أَطيب عندنا","من المسك دافته الاكف الدوائف",44,"ف",1,0],["وَلِلصَدر إسماعيل في مَصر أَشرَقَت","شُموس تَهانٍ بِالنُفوس تَموج",45,"ج",1,0],["وللصباباتِ وعهد الصبا","والفرط السالف مع هندِ",46,"د",1,0],["وللصبا نسمات ما سرت سجراً","إلا وأهدت لنا روحاً وريحانا",47,"ن",2,0],["وَللصِّديقِ رُجحانٌ جليٌ","على الأَصحابِ من غَيرِ احتمالِ",48,"ل",1,0],["وللصديقةِ الرُّجحَانُ فاعلَم","علىَ الزهراءِ في بَعضِ الخِلالِ",48,"ل",1,0],["وَلِلصُرمِ هَولٌ عَلى ذي الهَوى","وَإِن لَجَّ يَدعو إِلَيهِ اِحتِثاثا",49,"ث",2,0],["وللصبا نفحة تذكرنا","طيب نسيم الصبا فما أطيبْ",50,"ب",1,0],["وَلِلصَبابَةِ أَحكامٌ رَضيتُ بِها","ما كانَ أَسعَدَني فيها وَأَشقاني",51,"ن",2,0],["وَلِلصَبا رِقَّةٌ هَيهاتَ يَعرِفُها","إِلّا حَليفُ الصَبا مِن تِلكُمُ الزُمَرِ",52,"ر",1,0],["وللصمت خيرٌ على عيه","من النطق تلزم فيه الخطاء",53,"ا",2,1],["وللصّدقَات قد أجريت بحراً","من البيضَاء والذهبِ المُصَانِ",54,"ن",1