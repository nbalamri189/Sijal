{"poems":[[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142017","الخفيف"],[128,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[154,"أصفيتك الود مضطرا ومختارا","https://www.aldiwan.net/poem68542.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[415,"قد كنت أسمع لكن خلته مثلا","https://www.aldiwan.net/poem31866.html","البسيط"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[520,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[556,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[563,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[563,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66792","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59744","الرمل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96372","الوافر"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96309","الطويل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82239","الوافر"],[2159,"","https://poetry.dctabudhabi.ae/diwan/poem/199986","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27836","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27439","الرمل"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60959","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60829","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116512","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201946","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48293","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66371","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17777","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94330","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66157","الرمل"],[4755,"كَغَريبٍ تَنَاهَشَتْهُ الهُمُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=187242",""],[4755,"وَطَنًا أرِيدُ الآنَ يا خَوَنَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=191998",""],[4791,"احبك..احبك","https://www.poetsgate.com/ViewPoem.aspx?id=37099",""],[4802,"يا ابن المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=32637",""],[4829,"بن سالف","https://www.poetsgate.com/ViewPoem.aspx?id=34269",""],[4869,"اللي يشوفك يحبك","https://www.poetsgate.com/ViewPoem.aspx?id=151629",""],[5039,"لحن الندى المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=48123",""],[5055,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=103542",""],[5061,"صدفه عابره","https://www.poetsgate.com/ViewPoem.aspx?id=158858",""],[5118,"صدى الأسمنت","https://www.poetsgate.com/ViewPoem.aspx?id=129793",""],[5122,"(( الشعر ))","https://www.poetsgate.com/ViewPoem.aspx?id=23975",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5183,"إلى الحسنى","https://www.poetsgate.com/ViewPoem.aspx?id=180186",""],[5461,"يموت الشجر واقف","https://www.poetsgate.com/ViewPoem.aspx?id=6442",""],[5573,"بدينا بذكر الي سماه اعتلى بها - مجالسي","https://www.poetsgate.com/ViewPoem.aspx?id=206494",""],[5573,"غنت الورقا","https://www.poetsgate.com/ViewPoem.aspx?id=211676",""],[5732,"حل الرحيل وفرقوا شمل الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=177871",""],[5775,"أنا يا بدر","https://www.poetsgate.com/ViewPoem.aspx?id=35139",""],[5809,"هواك وجفاك","https://www.poetsgate.com/ViewPoem.aspx?id=205937",""],[5821,"الممرضات","https://www.poetsgate.com/ViewPoem.aspx?id=113765",""],[5848,"المعقول واللا معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53187",""],[5956,"كل ما عندك لطفٌ وجَمال","https://www.poetsgate.com/ViewPoem.aspx?id=182049",""],[6115,"الا يازمان قام يلوي ذراعي لي","https://www.poetsgate.com/ViewPoem.aspx?id=196459",""],[6277,"سكر الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64479&r=&rc=42",""]],"verses":[["وَإِنَّ إِياساً مَتى تَدعُهُ","إِذا لَيلَةٌ طالَ بَلبالُها",0,"ل",3,0],["وأنا يشهد الغرامْ","بعتُ للسُهد ناظرينْ",1,"ن",1,0],["وأنا يا سيدي الشيخ كما","قلت عني حيث ينحو الحب أنحو",2,"ح",2,0],["وأن إيثاره للخير يفعله","لم يبق للناس في دعواه آثارا",3,"ر",2,0],["وإن أيقظ الذئب صوتُ الدماء","فلا ترتقب غير نوم الرعاه",4,"ه",1,0],["وأن أَيدِيَها شَلّتْ ولا انبسطَت","إذا ضَربنَ كَسرْن النّبعَ بالغَرَبِ",5,"ب",1,0],["وأنَّ أيّامَهمُ","فينا الشهورُ الحُرُمُ",6,"م",1,0],["وإن أيام بلبيس لعالمة","منك الغناء وإن لم يدر جهال",7,"ل",1,0],["وَإِنْ أَيقظتَه في ليل شَغْبٍ","فقد أوقدتَ منه فيه نارا",8,"ر",2,0],["وإنائي بالتجلي طافح","يتكفّى بفنون الملح",9,"ح",1,0],["وأنائي غسلته","وبدا الصبح أبلجا",10,"ج",2,0],["وإن ائتمنتهمُ أو استعملتهمْ","خانوك واتّخذوا خَراجَكَ مَغنما",11,"م",2,0],["وأنا يوسفها من دولة","أطلع الأنجم ملء الحدق",12,"ق",1,0],["وإنّا يومَ نازَلَهُم شُعيبٌ","كليثِ الغابِ أَصحَرَ فاستغارا",13,"ر",2,0],["وأنأى إذا ما كان بي أنا حاجَةٌ","إليه فيكفيني فَراشٌ ومطعَمُ",14,"م",1,0],["وَإِن أَيقَنتَ أَنَّ الغَيَّ فيما","دَعاكَ إِلَيهِ إِخوان الصَّفاءِ",15,"ا",2,0],["وإن أيسر ما ألقاه من ألم","أنى أموت وما تدري الأحبة بي",16,"ي",1,0],["وإن أيضاً عذابُ حجبى","عذابنا المؤلم الأليم",17,"م",1,0],["وإن إيمانَ الورى","في الورى معبَرُهْ",18,"ر",2,0],["وإن إياد أمن ترا رسمت بهم","فروع فخار حين تعزى ونيب",19,"ب",1,0],["وإن أيادِي راشد بن مظفر بن مس","عود تغْنى كلّ من طلبَ الغِنى",20,"ن",2,0],["وأنّ أيْسرَ حقٍ أَنْ أزورهم","سعياً على الراسِ لا سعياً على القدمِ",21,"م",1,0],["وآنا يصلى بالازار مقدما","وكان له ثوبان في جمعة الخير",22,"ر",1,0],["وانأى عن العلم المحيّرِ اهلَه","فلست أرى في أمة العلم عاقلا",23,"ل",2,0],["وإنّ أيْسرَ لحْظٍ منكَ يُقْنِعُني","دون العِناية عِندي المالُ والنّشَبُ",24,"ب",1,0],["وإن آياته ليست مساوية","لقدره عند ربّ العرش في العظم",25,"م",1,0],["وان ايضاً صَلاتي في مَسَرَّتهم","هذا اقتباسُ كِتاب السيِّدِ العَلَمِ",26,"م",1,0],["وإن إيماننا شرعاً حقيقته","قصد وقول وفعل للذي أمرا",27,"ر",2,0],["وَإِن أَيَّهَ القَومُ الكِرامُ أَجابَهُ","بِجُرجَيهِ مَوشِيُّ الأَكارِعِ مُوكَفُ",28,"ف",1,0],["وانا يَقيني بالقَناعة نِعمةٌ","عَيشٌ رَغيدٌ بهجةٌ وَحُبورُ",29,"ر",1,0],["وانا يا ظَبْيَةَ الوادي حَزِينْ","أَنْثُرُ الدَّمْعَ وقَلْبي يَضْرِبُ",30,"ب",1,0],["وأَنا يا هُنا هُناكَ بَعِيدٌ","وقَريبٌ, ولائِمٌ, ومَلُومُ",31,"م",1,0],["وأَنا يا هُناكَ تُشعِلُ رَأسِي","بمِدادٍ ضرُورتي واللُّزُومُ",31,"م",1,0],["وأنا يَمَانِيٌّ على ظَمَأٍ","مِن ثُلْثِ قَرنٍ لَم يَجِدْ يَمَنَهْ",32,"ن",2,0],["وأنا يا حبيبي كلما ضاعت الحيلات","دريت إنك إقبالي ولكن هيهاتي",33,"ت",2,0],["وانا ياوجه انسقت مع واقع الحال","قول الذي عجزت حروفي تقوله",34,"ل",2,0],["وانا يا قدار لاجيتك ابا اطحن هامتك لاجيت","مصيبة والله ارسلني ولاتقدر توقاها",35,"ا",3,0],["وانا ياسيد الحسن ..!! قلي بربك","وش موقفي لابعت كوني بكونك",36,"ك",1,0],["وأنا يوم الشليل اللي جمعنا علقته سنون","كتبتك حلم لا جاني دريت إني معك واعي",37,"ع",2,0],["وأنا يا بنت بك هيمان","ووقتك لي يسليني",38,"ن",2,0],["وانا يابنت كم دورت دارش عند جار وجار","وتعب عقلي وهو يتخيلش في كل حزاته",39,"ت",2,0],["وأنا ياما على اسمنتك كتبت : ( الذكريات ./ بيوت","/ عيون الشاردين من الحياة ./ وكبتها المعتاد ) .!",40,"د",1,0],["وأنا يكفيني أيلا قيل نعمين","نعم(ن)..عليه الغانمين محسوده",41,"د",2,0],["وإن أيقظت راقده ترامى","كشرّيب أقام على مدام",42,"م",1,0],["وإن أيقظتهم صاولت ليث غابة","وإن طاولتهم طاولت ريح زعزع",43,"ع",1,0],["وأنا يعتريني ضعف الإنسان والهقوات","أروم العزايم يوم وأيام مسلوبه",44,"ب",2,0],["وانا ياعريب الجد ماهين عزتي","ونفسي عزيزه لو يزيد الضما بها",45,"ب",3,0],["وانا يانديم العز لازلت مفتكر","افكر وش الدنيا وش الي جرى بها",45,"ب",3,0],["وانا ياغربة احلامي بعيد الدار والاوطان","وحيد ابرحلتي نفسي بعيد الي يسليها",46,"ي",3,0],["وانا يصارحني بلا سر وكتاب","وعن حالته يشرح لي العدل والميل",47,"ل",1,0],["وأنا يابدر مع طاري الصوت لين أمسيت","أبد .. لا بعد هالصوت جاني ولا قبله",48,"ل",2,0],["وأنا يضايقُني جفاك كأنَّني","رئةٌ يضايقُها الحجابُ الحاجزُ",49,"ز",1,0],["وانا يغبن قلبي قليلين الارباح","الي يبيع النفس من شان مصروف",50,"ف",1,0],["وانا يا وقت مالي فيك لا قدره ولا طاقه","ولااحدٍ في حياته جت حياته له على ذوقه",51,"ق",2,0],["‏وأنا يا حلوة َ الأحلام درعٌ","‏ ‏ لك لمّا يرتجَى منِّي الصِّيالُ",52,"ل",1,0],["وأنا يوم اسوى الطيب ماهو غريب عليّ","ولا هو غريبٍ يجحد الطيب الانذالي",53,"ل",2,0],["وأنا يا سيدي المفتي كما","قلت عنّي : حيث ينحو الحبّ أنحو",54,"ح",2,0]]}