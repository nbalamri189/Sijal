ae/diwan/poem/94432","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94790","الطويل"],[4282,"","https://poetry.dctabudhabi.ae/diwan/poem/144808","الطويل"],[4282,"","https://poetry.dctabudhabi.ae/diwan/poem/144806","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143027","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73299","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136552",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136738",""],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141122","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117215","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133158","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33603","الوافر"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145391","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139588",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101939","الطويل"],[4716,"أيا سيداً عم الخلائق بره","https://www.poetsgate.com/ViewPoem.aspx?id=125961",""],[4853,"أيا سائلي عن كنه علياه إنه","https://www.poetsgate.com/ViewPoem.aspx?id=181768",""],[4862,"أيا عمرو بن هندٍ لاتلمنا","https://www.poetsgate.com/ViewPoem.aspx?id=55366",""],[4862,"ليته في ذلك الليل رقد","https://www.poetsgate.com/ViewPoem.aspx?id=55627",""],[4882,"سمّي العراقَ اذا ما اصْلحتْ ذِمما-بهاء الدين الخاق","https://www.poetsgate.com/ViewPoem.aspx?id=11522",""],[4923,"أيا سائلي عن قد محبوبتي الذي","https://www.poetsgate.com/ViewPoem.aspx?id=181388",""],[4968,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208077",""],[4983,"حديث في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=11014",""],[4988,"رجع شادي","https://www.poetsgate.com/ViewPoem.aspx?id=186968",""],[4119,"ألا يا غزال الثغر هل أنت منشدي","https://www.poetsgate.com/ViewPoem.aspx?id=16129",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5197,"يثرب","https://www.poetsgate.com/ViewPoem.aspx?id=131029",""],[5291,"بلادى البيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=14022",""],[5323,"أيا سائلا","https://www.poetsgate.com/ViewPoem.aspx?id=209168",""],[5431,"وضعتك في أكف العشق طفلا...","https://www.poetsgate.com/ViewPoem.aspx?id=190158",""],[5490,"نساء","https://www.poetsgate.com/ViewPoem.aspx?id=176174",""],[5547,"أيا سرو لا يعطش منابتك الحيا","https://www.poetsgate.com/ViewPoem.aspx?id=187146",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5587,"أيا سهرتي","https://www.poetsgate.com/ViewPoem.aspx?id=198718",""],[5673,"سقى الله أرضا ضمت المجد والندى","https://www.poetsgate.com/ViewPoem.aspx?id=124960",""],[5690,"رأى نظري ربوعهم فما لا","https://www.poetsgate.com/ViewPoem.aspx?id=172171",""],[5796,"سلوا فتياتِ الحيِّ عنِّي فربَّما","https://www.poetsgate.com/ViewPoem.aspx?id=189038",""],[6093,"كلانا بِهِ شخصٌ يَذوبُ لصاحِبهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193224",""],[6127,"تدور مدار العشق","https://www.poetsgate.com/ViewPoem.aspx?id=188376",""],[6167,"بين الإثم والهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85542&r=&rc=25",""],[6183,"شموخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79825&r=&rc=15",""],[6269,"رحيل لم يحدث بعد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87854&r=&rc=16",""],[3984,"أخوة ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64410&r=&rc=16",""]],"verses":[["أَيا سَهماًرَمى غَرَضاً فَأَخطا","وَذي الأَقدارِ أَسهُمُها أَسَدُّ",0,"د",1,0],["أَيا سَيِّدَةَ الناسِ","لَقَد قَطَّعتِ أَنفاسي",1,"س",2,1],["أَيا ساكِني شَرقيَّ دِجلَةَ كُلُّكُم","إِلى النَفسِ مِن أَجلِ الحَبيبِ حَبيبُ",2,"ب",1,0],["أَيَا سَبُعَ الْميدَانِ غَيْرَ مُدَافعٍ","إِذَا بَرَقَتْ تَحْتَ الْعَجَاجِ الْمَنَاصِل",3,"ل",1,1],["أيا سَبُع المَيْدانِ دعْوةُ آمِلٍ","على يدِكَ النّصْرُ العَزيزُ على الدّهْرِ",4,"ر",1,1],["أَيا سَيِّدَي نَجرانَ لا أوصِيَنكُما","بِنَجرانَ فيما نابَها وَاِعتَراكُما",5,"م",2,1],["إِياسُ وَأَنتَ اِمرُؤٌ لا يُرى","لِنَفسِكَ في القَومِ مِعدالُها",6,"ل",3,0],["أَيْأَسُ مَا سَارَتْ بِأَطْمَارِهَا","لَمْ تَكُ إِلاَّ بَهْجَةً سَائِرَهُ",7,"ر",2,0],["أَيْأَسْتُمَاهُ مِنْ حَبَائِلِ كَيْدِهِ","تَتَعَثَّرَانِ بِهَا وَتَنْفَلِتَانِ",8,"ن",1,0],["أيا سائلاً عنا ببغداد إننا","بهائم في بيداء أعَوزها النبت",9,"ت",1,1],["أَيا سافِراً وَرِداءُ الخَجَل","مُقيمٌ بِوَجنَتِهِ لَم يَزَل",10,"ل",1,1],["أيا سالكَ التقوى طريقاً منيرةً","ويا بانيَ المعروف حصناً مشيدا",11,"د",2,0],["أيا سائلي عن مذهب العتب والولا","لأهل زمانٍ أنه لشديد",12,"د",1,1],["أيا سيدي إن لم تكن ثم زورة","فنظمٌ كأمثال العقود النفائس",13,"س",1,1],["أيا سيدي إن ذاك الذي","أمرت ببرِّي سها عن خليلي",14,"ي",1,1],["أيا سيدي إنني قد عييت","عن أن أشابه أهل الكرم",15,"م",1,1],["أيا سيدي ما لفظ شعري بروضة","ولا بحره للواردين بمشتهى",16,"ه",2,1],["أَيا سمكاً بين السّماكين عزَّةً","إلى كم يرانا اللَّهُ منك نَصومُ",17,"م",1,0],["أَيا سَيفَ رَبِّكَ لا خَلقِهِ","وَيا ذا المَكارِمِ لاذا الشُطَب",18,"ب",1,0],["أيا سابقاً طلّابُ غايتِه حَسْرَى","ويا واحِداً أمدادُ نعمتِه تَتْرَى",19,"ر",2,1],["أَيا سَكَناً فاتَ الفِراقُ بِأُنسِهِ","وَحالَ التَعادي دونَهُ وَالتَزَيُّلُ",20,"ل",1,0],["أَيا سائلي عن شِيمَةِ الحَسَنِ استَمِعْ","مَحاسِنَ من نَظْمِ الثَّناءِ أُذيعُها",21,"ع",3,0],["اِيأَس مِنَ الناسِ وَاِرجُ الواحِدَ الصَمَدا","فَإِنَّهُ هُوَ أَعلى مِنَّةً وَيَدا",22,"د",2,1],["أَيا ساكِني الأَجداثِ هَل لي إِلَيكُم","عَلى قُربِكُم مِنّي مَدى الدَهرِ مُطَّلَع",23,"ع",1,0],["أَيا ساقِيَ الراحِ لا تَنسَنا","وَيا جارَةَ العودِ غَنّي لَنا",24,"ن",2,1],["أَيا سَدرَةَ الوادي عَلى المَشرَعِ العَذبِ","سَقاكِ حَياً حَيُّ الثَرى مَيِّتُ الجَدبِ",25,"ب",1,1],["أَيا سَعيدَ اِبنَ وَهبٍ","اِسمَع فَدَيتُكَ قيلي",26,"ل",2,1],["أَيا سارِحاً في الجَوِّ دُنياكَ مَعدِنٌ","يَفورُ بِشَرٍّ فَاِبغَ في غَيرِها وَكرا",27,"ر",2,1],["أَيا سَيِّداً عَمَّني جودُهُ","بِفَضلِكَ نِلتُ السَنى وَالسَناءَ",28,"ا",2,1],["أيا سارِحاً في الجَوّ، دُنياكَ مَعدِنٌ","يفوزُ بشَرٍّ، فابْغِ، في غيرِها، وكْرَا",29,"ر",2,1],["أيا سائلا عنَّا ببغدادَ إننا","بهائم في بغداد اعوزها النبت",30,"ت",1,1],["أَي أَسد تَحوم حَول حِماهُ","وَكناس لَهُ الظِبا وَالرِماح",31,"ح",1,0],["أيا ساعة مليت فيها بحسنه","نشدتك إلّا كر منك نظائر",32,"ر",1,1],["أيا سُوقاً فلو صورت شخصاً","لَتِهْتُ على بقاع الأرض طيبَا",33,"ب",2,1],["أيَأَسَ العَاذِلُونَ مِنَّا لأنَّا","في أَمَانِ مِن فَقدِ بَعضِ الأمَانِ",34,"ن",1,0],["إيَاسِىُّ مَقلٍ حَاتِمِىُّ نَوَافِلٍ","فَلَم يَخشَى سَبقاً في المَعَالِى ولاَ غَبنَا",35,"ن",2,0],["أيَا سَائِلاً عني ابنُ مَن وَمَن أينَما","أتَيتُ تَرَفَّق بي فَلَستُ مُذَمَّمًا",36,"م",2,0],["أيا سامع الشكوى ويا دافع البلا","ويا منقذ الغرقى ويا واسع البر",37,"ر",1,0],["أيا سابقاً بالذي لم يجل","بفكري ثواباً ونعم الثواب",38,"ب",1,0],["أيا سيّداً فاق الكرام بمجده","وخلق كريم لم يزل طيّب النشر",39,"ر",1,1],["أَيا سَيِّدا نالَ أعلى الرُّتَبْ","وحاز الكمالَ بأَوْفَى سَبَبْ",40,"ب",1,1],["أيا سَيِّدي وأخي لا تَغِبْ","فعندي لك اليوم ما يُسْتحَبّ",41,"ب",1,1],["أيا سلوتي أن النحوسَ طوالعٌ","علينا وأفلاكُ السُّعودِ أفُولُ",42,"ل",1,0],["أَيا سائِلَ الصَخرِ عَن جارِهِ","دَعِ الصَخرَ يَنطِق بِأَخبارِهِ",43,"ه",1,0],["أَيا سَقَمي أَعداكَ رِقَّةُ خَصرِهِ","وَيا جَلَدي أَوهاكَ عقدة بَندِهِ",44,"د",2,0],["أَيا سَيدي شهر كَريم وَغربة","وَديناقاسيه ولست به جلدا",45,"د",2,0],["أَيا سُحبَ نيسانَ روّي الكروم","لترويَ خمرتها الأَكرَمينا",46,"ن",2,1],["أيا سادة كم أديرت لنا","براحاتهم بنت كرم الكرم",47,"م",1,1],["أَيَا سَيّدَ الوُزَرَاءِ اسْتَمِعْ","لِقِصَّةِ شَكْوَايَ وَانظُرْ مَا بي",48,"ب",2,1],["أيا سيد السادات هل منك عودةٌ","وهل هي بالأحيا تباع وهل تشرى",49,"ر",2,0],["أيا سَيِّدَ الرّؤساء الكبيرُ","أَرَى في عَلائكَ للّهِ سِرّا",50,"ر",2,0],["أيا سَيِّداً سَبْطَ الأناملِ بالنّدى","فِداؤك جَعْدٌ كَفُّه ليس بالجَعد",51,"د",1,0],["أيا سامِعاً وَحيَ المُنى مِن عَبيدِهِ","إِذا كانَ داءُ البُخلِ في السَمعِ كَالوَقرِ",52,"ر",1,0],["أيا ساكني قلبي على بعد دارِهم","لقد عِيلَ صبري مُذ شطَّت نواكم",53,"م",1,1],["أيا سيداً قدستَ أرضاً حللتَها","كتقديس ربِّ المجدِ أرضَ المواعد",54,"د",1,0],["أيا ساكنين الحي باللَه بلِّغوا","سلامي إلى من هي أعز حبائبي",55,"ب",2,0],["أياسيدي هل دعوة لاس