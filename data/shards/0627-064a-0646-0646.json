{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[74,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[47,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[51,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[99,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[71,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[76,"أيها التائه مهلا","https://www.aldiwan.net/poem13210.html","مجزوء الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[79,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[102,"ذكريات شيخين","https://www.poetsgate.com/ViewPoem.aspx?id=50390",""],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[203,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[261,"يا وقح الوجه جيد الحدقه","https://www.aldiwan.net/poem48475.html","المنسرح"],[290,"أين نيلك أين خيلك","https://www.aldiwan.net/poem39362.html","مجزوء الرمل"],[333,"رق وجه النسمات","https://www.aldiwan.net/poem55044.html","مجزوء الرمل"],[563,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[563,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48797","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205854","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58320","الرجز"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79698","الخفيف"],[3227,"","https://poetry.dctabudhabi.ae/diwan/poem/143349","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62902","السريع"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136538",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139471",""],[4755,"قد وَهَبناكَ فَوقَ ما تَستَطِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184812",""],[4755,"أَنتِ كُنَّا .. ولَم نَكُن مُدَّعِينا","https://www.poetsgate.com/ViewPoem.aspx?id=196614",""],[5388,"سوف أمضي","https://www.poetsgate.com/ViewPoem.aspx?id=206913",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""]],"verses":[["أَينَ نَدى كَفَّكَ الكَريمِ لَها","وَأَينَ عاداتُ طَولِكَ الأُوَلُ",0,"ل",1,0],["أيْنَ نورُ الإلاهِ منْ عُنْصُرِ النّا","رِ إذا ما اعْتَبَرْتَهُ يا صاحِ",1,"ح",1,0],["أينَ نظم السعيد منه ومن قوَّ","ةِ ما خطَّه ابن العديم",2,"م",1,0],["أَينَ نورُ الرَبيعِ مِن زَهرِ الشِع","رِ إِذا ما اِستَوى عَلى أَفنانِه",3,"ن",2,0],["أَينَ نابِلِيونُ ما غاراتُهُ","شَنَّها الدَهرُ عَلَيهِ مِن غِيَر",4,"ر",1,0],["أَينَ نَسرٌ قَد تَلَقّى قَبلَكُم","عِظَةَ الأَجيالِ مِن أَعلى بِناء",5,"ا",2,0],["أَينَ نَجَوا هارِبينَ عارَضَهُم","باغٍ مِنَ المَوتِ مُشرِفُ رَصَدُه",6,"د",2,0],["أَينَ نُمرودُ وَاِبنُهُ أَينَ قارو","نُ وَهامانُ ذو الأَوتادِ",7,"د",1,0],["أين ناديك وأين السمرُ","أين أهلوك بساطاً وندامى",8,"م",2,0],["أينَ نمرودُ وكنعانُ ومَنْ","ملكَ الأمرَ وولّى وعزَلْ",9,"ل",1,0],["أَينَ نَفسٌ فيكَ تُهدى","وَضُلوعٌ فيكَ تُصلى",10,"ل",2,0],["أَينَ نوحٌ وَأَينَ يافِثُ مِن بَع","دِ نَجاةٍ وَأَينَ حامٌ وسامُ",11,"م",1,0],["أين نور الإله من عنصر النار","إذا ما اعتبرته يا صاح",12,"ح",1,0],["أين نحن الآن ؟ وارى عهدنا","وجههه ، وانطفأت فيه الملّح",13,"ح",1,0],["أينَ نوحٌ وأين إبراهيمُ","كلّهم عن مقامهِ مفطومُ",14,"م",1,0],["أَئِنْ نفرُّوا الظبيَ لم تأنسا","لوحشةِ ليلي فلم آنسِ",15,"س",1,0],["أين نصيبي من الطعام وما","طمعت في لعقةٍ من المرقه",16,"ق",2,0],["أين نيلك أين خيلك","حزت فضلا فازجيلك",17,"ك",1,1],["أين نسيانك يا كأ","س وأين السبحات",18,"ت",1,0],["أين نور الإيمان من نور عقل","ناظر بالخيال في الأحكام",19,"م",1,0],["أين نبت الورد في الخدين من","كل بدرٍ طالع من نبت شيح",20,"ح",1,0],["أين نصحي لكم وأين نذيري","أيها الناس من زعيم وحاكمْ",21,"م",1,1],["أين نجواك في فم الناي تفضي","بأحاديث سرّك المكنون",22,"ن",1,0],["أينَ نَمشي يا بنتَ عَمٍّ وزينو","نُ أخي من قَضيّتي محبوسُ",23,"س",1,0],["أينَ نَمشي حُزناً خُراخِتْ زَمانِ","لا فيهِ ولا خَنْدَريس",23,"س",1,0],["أين نفس لولاك لم تك قفرا","أي دار لولاك لم تك غيلا",24,"ل",2,0],["أينَ نسيمُ الريحِ مُستحْقِباً","أعلامَ ضوءِ الفلَقِ البادي؟",25,"د",2,0],["أَينَ نسيمٌ كانَ يعتادُنا","منكَ اذا صادفَ داءً شَفى",26,"ا",1,0],["أين نار القوم من نار الإله","إنّ ربي هو خير الرازقين",27,"ن",1,0],["أين نعمانُ والظباء التي فيه","بلغنَ المنُى بعيشٍ رَغيد",28,"د",1,0],["أين نور الإله من نور شمسٍ","هي منه من جملة الأضواء",29,"ا",2,0],["أينَ نُخفِي قُلُوبَنَا؟ ذاكَ لِصٌّ","حَصَّنُوهُ, وذاكَ لِصٌّ مَنِيعُ",30,"ع",1,0],["أَينَ نَلقَاكِ؟! أَغلَقُوا كُلَّ دَربٍ","واستَعَاضُوا بِفَاسِدٍ أَربَعِينا",31,"ن",2,0],["أين نبضُ الحياة في خطواتي ؟!","كلّ خطوٍ مضى بثوب يبابِ !",32,"ب",1,0],["أين نيتْشا من المعرّي إذا ما","قورن العقل أينه من....ومنّي!",33,"ن",2,0],["أين نيلي كانَ سحراً","شافيًا كلَّ الأنامِ!",34,"م",1,0]]}