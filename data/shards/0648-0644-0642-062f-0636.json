{"poems":[[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[28,"فاسأل هوازن إن عند سراتهم","https://www.aldiwan.net/poem5242.html","الكامل"],[28,"يا أخت ناجبة ابن سامة إنني","https://www.aldiwan.net/poem5542.html","الكامل"],[17,"إن امرأً أمن الحوادث جاهل","https://www.aldiwan.net/poem1197.html",""],[52,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[28,"يا أخت ناجية بن سامة إنني","https://www.poetsgate.com/ViewPoem.aspx?id=21038",""],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[282,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[432,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[464,"عز الجفون وذلة الصبر","https://www.aldiwan.net/poem3484.html","عموديه"]],"verses":[["ولقَدْ ضاقَتِ الأمورُ على الموْ","لَى وخابَتْ برُنْدَة الأوْطارُ",0,"ر",1,0],["وَلَقَد ضَلَلتَ أَباكَ تَطلُبُ دارِماً","كَضَلالِ مُلتَمِسٍ طَريقَ وَبارِ",1,"ر",1,0],["وَلَقَد ضَنيتُ مِنَ النِساءِ وَلا أَرى","كَضَناً بِنَفسي مِنكِ أُمَّ الهَيثَمِ",2,"م",1,0],["وَلَقَد ضَرَبتُ بِفَضلِ مالِيَ حَقَّهُ","عِندَ الشِتاءِ وَهَبَّةِ الأَرواحِ",3,"ح",1,0],["وَلَقَد ضاعَت أَيادٍ عِندَكُم","غُرِسَت في تُرَبٍ غَيرِ جِيادي",4,"ي",1,0],["وَلَقَد ضَرَبتُ عَلَيهِ بَيتَ مَذَلَّةٍ","حَتّى أَصاخَ كَأَنَّهُ مَمطورُ",5,"ر",1,0],["وَلَقَدْ ضَنِيتُ مِنَ النّساءِ وَلا أرَى","كَضَنىً بِنَفْسِي مِنْكِ أُمَّ الهَيْثَمِ",6,"م",1,0],["وَلَقد ضلّ معشرٌ حَكموا العق","لَ وما هُم بحكمهم حكماءُ",7,"ا",2,0],["وَلَقَد ضَعُفتُ فَلَم أَزُركَ وَإِنَّ لي","قَلباً إِلَيكَ صَميمُهُ يَرتاحُ",8,"ح",1,0],["ولقد ضاعَ فؤادي عندَه","فأنا أطلبُ عنه بَدَلا",9,"ل",2,0],["ولقد ضربتِ بسيف لحظك مع","موداً فباءَ الجفنُ بالكسرِ",10,"ر",1,0]]}