{"poems":[[79,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[30,"فاسأل هوازن إن عند سراتهم","https://www.aldiwan.net/poem5242.html","الكامل"],[30,"يا أخت ناجبة ابن سامة إنني","https://www.aldiwan.net/poem5542.html","الكامل"],[17,"إن امرأً أمن الحوادث جاهل","https://www.aldiwan.net/poem1197.html",""],[54,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[52,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[30,"يا أخت ناجية بن سامة إنني","https://www.poetsgate.com/ViewPoem.aspx?id=21038",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[287,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[438,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[469,"عز الجفون وذلة الصبر","https://www.aldiwan.net/poem3484.html","عموديه"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44836","الكامل"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107343","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69391","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102959","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127081","الخفيف"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""]],"verses":[["ولقَدْ ضاقَتِ الأمورُ على الموْ","لَى وخابَتْ برُنْدَة الأوْطارُ",0,"ر",1,0],["وَلَقَد ضَلَلتَ أَباكَ تَطلُبُ دارِماً","كَضَلالِ مُلتَمِسٍ طَريقَ وَبارِ",1,"ر",1,0],["وَلَقَد ضَنيتُ مِنَ النِساءِ وَلا أَرى","كَضَناً بِنَفسي مِنكِ أُمَّ الهَيثَمِ",2,"م",1,0],["وَلَقَد ضَرَبتُ بِفَضلِ مالِيَ حَقَّهُ","عِندَ الشِتاءِ وَهَبَّةِ الأَرواحِ",3,"ح",1,0],["وَلَقَد ضاعَت أَيادٍ عِندَكُم","غُرِسَت في تُرَبٍ غَيرِ جِيادي",4,"د",2,0],["وَلَقَد ضَرَبتُ عَلَيهِ بَيتَ مَذَلَّةٍ","حَتّى أَصاخَ كَأَنَّهُ مَمطورُ",5,"ر",1,0],["وَلَقَدْ ضَنِيتُ مِنَ النّساءِ وَلا أرَى","كَضَنىً بِنَفْسِي مِنْكِ أُمَّ الهَيْثَمِ",6,"م",1,0],["وَلَقد ضلّ معشرٌ حَكموا العق","لَ وما هُم بحكمهم حكماءُ",7,"ا",2,0],["وَلَقَد ضَعُفتُ فَلَم أَزُركَ وَإِنَّ لي","قَلباً إِلَيكَ صَميمُهُ يَرتاحُ",8,"ح",1,0],["ولقد ضاعَ فؤادي عندَه","فأنا أطلبُ عنه بَدَلا",9,"ل",2,0],["ولقد ضربتِ بسيف لحظك مع","موداً فباءَ الجفنُ بالكسرِ",10,"ر",1,0],["ولَقد ضَربتُ طُلى العِدَى بِقَصائِدي","فسَطت علَى أسمائِهم أفعالُها",11,"ل",3,0],["ولقَد ضاقَ بي مكانِيَ حتى","ضاقَ صدري عن احتمالِ جَناني",12,"ن",2,0],["وَلَقَد ضَنِيتُ فَما يَكادُ مِنَ النَوى","جَسَدِي يَبِينُ لِطَيفِكِ المُنتَابِ",13,"ب",1,0],["وَلَقَد ضلّ بالخطيبين إفك","كرزن متقن له إِتقانا",14,"ن",2,0],["ولقد ضربت إليك أمواج الدجى","فشققت كل عباب بأس مزبد",15,"د",1,0],["ولقد ضمنت حشا السحب نارا","من جواها وناحت الورقاء",16,"ا",2,0],["ولقد ضَرَبتُ به فتُسقط ضربتي","ايدي الكماةِ كأنهنَّ الخروع",17,"ع",1,0],["ولقد ضحكت الأرض جميعا","والسموات ونور السواني",18,"ن",2,0]]}