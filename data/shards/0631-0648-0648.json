ae/diwan/poem/114188","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133237","الطويل"],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97102","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83638","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83494","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83671","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120509","المتقارب"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102017","البسيط"],[4730,"هذا الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=27831",""],[4755,"سَمَاءٌ سِوَى هذي دُخَانًا سَتُسْحِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=187385",""],[4755,"تَهَوَّدَ الجُولانُ","https://www.poetsgate.com/ViewPoem.aspx?id=203993",""],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[4932,"وحلاه من حسنى اساميه جملَة","https://www.poetsgate.com/ViewPoem.aspx?id=187281",""],[585,"هي الحرب فانظر كيف ومض البوارق","https://www.poetsgate.com/ViewPoem.aspx?id=161905",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[5237,"أبت همي إلا الولوع بمن تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=113109",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5277,"في عيدها","https://www.poetsgate.com/ViewPoem.aspx?id=205393",""],[5279,"النَّخلَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=183788",""],[5279,"الصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=215615",""],[5333,"إذا جاءت الأسماء يقدمُها الله","https://www.poetsgate.com/ViewPoem.aspx?id=9576",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5688,"هذا زادي إذا لم تعرفوه","https://www.poetsgate.com/ViewPoem.aspx?id=200679",""],[5736,"سها","https://www.poetsgate.com/ViewPoem.aspx?id=208478",""],[5764,"قويٌ لا رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=175604",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["رَؤوفٍ عَلى الأَدنى غَليظٍ عَلى العِدى","أَخي ثِقَةٍ في النائِباتِ نَجيبِ",0,"ب",1,0],["رووا الشجون على سمعي فإني من","قوم لحديث الشجو حفَّاظ",1,"ظ",1,0],["رَؤومُ صفاةٍ أنبتت وتفجرت","رَجومُ صفاةٍ أصلدت وقَروعها",2,"ع",3,0],["رؤوس مرائيسٌ قديماً تعمَّمتْ","لعمْرُكَ بالتيجانِ لا بالعمائمِ",3,"م",1,0],["رُؤُوسُ عِصِيٍّ كُنَّ مِن عودِ أَثلَةٍ","لَها قادِحُن يَبري وَآخَرُ مُخرِبُ",4,"ب",1,1],["رؤوفٍ على الأدنى ، غليظٍ على العدا","أخي ثقة ٍ في النائباتِ، نجيبِ",5,"ب",1,0],["رووا علم النبوة عن علي","وصي المصطفى ليث الزحام",6,"م",1,0],["رَووفٌ بأهلِ العلمِ والدينِ والتقَى","شديدٌ على أهل الخَنَا المظالمِ",7,"م",1,0],["رُؤوسُ نَهالٍ خامِساتٍ تُعينُها","دَلاءُ السُقاةِ وَالحِياضُ الدَعاثِرُ",8,"ر",1,0],["رَؤوفٌ بِأُمَّتِهِ رَحيمٌ يَترُكُ ال","عملَ الكَثير الأَجرِ في الميزانِ",9,"ن",1,0],["رؤوفٌ رحيمٌ واسعُ الصَّدرِ مُحسنٌ","عظيمٌ فلا تيهُ لديهِ ولا كِبرُ",10,"ر",1,0],["رؤوس العوالي للمعالي معاقل","وأيدي المواضي للأماني منازل",11,"ل",1,1],["رؤوف بامته رحيم مشفق","متعطف بالود للمتودد",12,"د",1,0],["رَووا حديثَ المَعالي عن أَبٍ فأَبٍ","وَساقَه خلفٌ يرويه عن سلفِ",13,"ف",1,0],["رووا وارتووا من بحر علم محمد","وليست لهم تلك المذاهب من ورد",14,"د",1,0],["رؤوفٌ بالمُلِمِّ له رحيمٌ","صديقٌ صادقٌ بَرٌّ وَدود",15,"د",1,0],["رؤوف بأعراض اللئام ينوشُه ال","أذى وهو محبوسُ المقالةِ كاظمُ",16,"م",1,0],["رؤوس الشهر أعياد","له يرعاه أياما",17,"م",2,0],["رووا من طريق اللضه للقوم ما خفا","عن العارفين الشعث غبر السرية",18,"ه",1,0],["رَوَوْا سندَ المفاخِر عن أبيهم","وعن أجدادِهم شرفَ الخِصالِ",19,"ل",1,0],["رؤوسٌ وجميعُ النّا","سِ أجسادٌ وأبدانُ",20,"ن",1,0],["رؤوسكم كلكم لتعرفوا","من بينهم بذلكم وانصرفوا",21,"ف",3,0],["رووا عن الأول فيما قد نسب","رواتهم إليه أنه خطب",21,"ب",1,0],["رؤوس من علوم خاليات","وما يحوين غير الترهات",22,"ت",1,0],["رؤوف رَحيم طاهر الذَيل محسن","بآيات زجر للمسيء نَذير",23,"ر",1,0],["رَؤُوفٌ عَلَى العَانِي وإذَا الدَّهْرُ خَانَهُ","صَفُوحٌ عَنِ الجَانِي إذَا الرّجْلُ زَلَّتِ",24,"ت",1,0],["روّوا محبهم بشهد نافع","وسقوا أعاديهم بسم منقع",25,"ع",1,0],["رووا حديث الفضل عن جدهم","وجدهم رواه عن أهل الكسا",26,"س",2,0],["رووا من أحاديث الغرام حكاية","تطيب بمعنى الصدق في صورة الوزر",27,"ر",1,1],["رؤوس كبر في نفوس عتت","جنود إِبليس عليها جلوس",28,"س",1,0],["رَؤوفٍ عَلى الأدنى غليظٍ عَلى العِدى","أَخي ثقةٍ في النائبات مجيبِ",29,"ب",1,0],["رؤوسهم في الشام يرنو شماتةً","إليهن طاغ عن أمية باذخ",30,"خ",1,0],["رووا الصحاح من الحقائق اسنتدت","عن سيد في الفضل يقفو سيدا",31,"د",2,0],["رؤوفٌ عطوفٌ أجملُ الناس خِلقةً","وأعظمُهم خُلقاً ومُنشرِحُ الصدرِ",32,"ر",1,0],["رووا مجدهم عن على جدهم","وآل هداة فهم خير آل",33,"ل",1,0],["رَؤُوفٌ مُحسِنٌ بَرٌ عَطُوفٌ","وَذُو صَفحٍ عَنِ الجَانِى حَلِيمُ",34,"م",1,0],["رؤوف بنا والنهي عن رأفة يكن","بحاكما في الزان إن حدَّه الله",35,"ل",2,0],["رووا حديث مجدهم عن جعفر","وجعفر يرويه عن اهل العبا",36,"ب",2,0],["رؤوسٌ قَد أَراحَتكَ","رُؤوسٍ في النَواويسِ",37,"س",1,0],["رؤوف بالعباد يرى الرعايا","برحمته كرؤيته بنيه",38,"ي",2,0],["رؤوف على المسكين يبدي بشاشته","ويعظم في عين الذي تاه بالكبر",39,"ر",1,0],["رؤوسٌ ملؤُها علمٌ وحزمٌ","تدبّر بالرؤوسِ الخالياتِ",40,"ت",1,0],["رؤوفٌ عطوفٌ أوسعَ الناس رحمة","وجادتْ عليهم سحُبه وغمائمهْ",41,"م",2,0],["رووا أن في بعث ابن جحش بنخلة","رأوا في الأعادي أول القتل والأسر",42,"ر",1,0],["رؤوفٌ رحيمٌ بالعبادِ مُسلّطٌ","كذلك نتلو في براءةِ والحشر",42,"ر",1,0],["رؤوف رحيم يطلب العفو دائما","لأهل نور الأيمان في كل ساعة",43,"ه",1,0],["رؤوفٌ عَطوفٌ منعِمٌ متفضِّلٌ","كَريمٌ حَليمٌ يغفِرُ العَمْدَ والخَطا",44,"ط",2,0],["رَؤوف بِأَهل البرّ برُّ نَواله","يَفيض فَلو جاراه بَحر تَجَعَدا",45,"د",2,0],["رُؤوسٌ وَأَوصالٌ يُزايِلُ بَينَها","سِباعٌ تَدَلَّت مِن أَبانينَ وَالهَضبِ",46,"ب",1,0],["رؤوف بنابر عطوف ولم يكن","تغير لو أن الزمان تغيرا",47,"ر",2,0],["رَوَوْا حديثاً صحيحاً","عن النّبي المطاع",48,"ع",1,0],["رُؤُوسها كُلُّهُمُ","بطاركٌ بطارقه",49,"ق",2,0],["رؤُوس كبائرٍ جاءت وِفاقاً","بكَمٍّ عِدَّة الايامِ سَبعا",50,"ع",2,0],["رَؤوف بِهِ عطفاً كَأَنَّ الَّذي بِهِ","مِنَ السقمِ فيهِ لا المداجي وَلا الجَعدُ",51,"د",1,0],["رؤوفٌ رحيمٌ","ملينُ الكلام",52,"م",1,0],["رَؤُوفٌ رَحِيمٌ خِلعَةٌ مِن مَلِيكِهِ","كَفَتهُ فَخَاراً فِي الخِتَامِ وَلاَ فَخرَا",53,"ر",2,0],["رؤوف رحيم بالأنام مكمل","كريم سخي الكف منبسط اليد",54,"د",1,0],["رؤوفٍ عطوفٍ ذي صفاءٍ وعفَّةٍ","خلّيٍ من الإغشاشِ غير مُمَالِقِ",55,"ق",1,0],["رؤوس فهر حملت فوق الصعاد","وغودرت أجسادها رهن الوهاد",56,"د",1,0],["رَؤوفٌ بِنا وَهو الرَحيمُ بَجمعنا","رَؤوفُ رَحيمٌ دونه الأُمّ وَالأَبُ",57,"ب",1,0],["رَؤوفٌ رَحيمٌ منعِمٌ متفضّلٌ","يداركني بِالعَفوِ والعفو أَوسَعُ",58,"ع",1,0],["رَؤوفٌ رَحيمٌ جاءَ في الذكر نعتهُ","وَأَكرم بِمَنعوتٍ بأسمى المَناقِبِ",59,"ب",1,0],["رؤوف بمن جاه مستجيرا","ولكن شديد على ذي المحال",60,"ل",1,0],["رؤوسهم فوق أطراف القنا رفعت","والجسم منهم على وجه الرمال رمي",61,"م",2,0],["رؤوفاً إنْ حَكَمتَ على عبادٍ","رحيماً لا يخيبُ بك الرَّجاءُ",62,"ا",2,0],["رُؤُوسُ الشَّياطِينِ التي شَاخَ مَكرُها","تَنَادَت وبَينَ الرّأسِ والرَّأسِ كَوكَبُ",63,"ب",1,0],["رُؤُوسُنَا يا حَربُ مَحمُومَةٌ","وصَاحِبُ الحُمَّى غَريبُ البَيَانْ",64,"ن",1,0],["رؤوسُ الكفرِ من شرقٍ وغربٍ","علينا حقدُها استعرَ استعارا",65,"ر",2,0],["رؤوف رَحِيم فاتح ومقدس","أَمِين قوي عَالم وشهيد",66,"د",1,0],["رؤوس وأيدٍ في العراء وأرجلٌ","تصيح بمرديها صياح النواعق",67,"ق",1,0],["رؤوس العرض تستزري بما في","رؤوس السمهرية والحراب",68,"ب",1,0],["رَؤُوفٌ رَحِيمٌ رَازِقُ الخَلقِ بَاسِطٌ","عَليمٌ حَكيمٌ صَادقٌ عَادِلٌ عَدْلُ",69,"ل",1,0],["رؤوف راحم أبدى حياء","وخلقا طاهرا واسأل لبيبا",70,"ب",2,0],["رؤوف عطوف ليس بالفظ لين","وفي الحرب ليث لا يطاق ولا يغوى",71,"و",2,0],["رو