ww.aldiwan.net/poem67861.html","الكامل"],[174,"سقى الله أطلالا رعيت بها الصبا","https://www.aldiwan.net/poem46067.html","الطويل"],[235,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[235,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[275,"لام المحبون الفراق ولمته","https://www.aldiwan.net/poem25515.html","الكامل"],[297,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[303,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[363,"صحا قلبه وأقصر اليوم باطله","https://www.aldiwan.net/poem1724.html","الطويل"],[364,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[366,"إني فقدت أحبتي نظرا","https://www.aldiwan.net/poem17005.html","أحذ الكامل"],[366,"إن كنت تلحاني فلست بحاني","https://www.aldiwan.net/poem17136.html","الكامل"],[384,"ظعنوا فخيم لاعجُ الأشواق","https://www.aldiwan.net/poem1314.html",""],[386,"ظعائن لا توفي بهن ظعائن","https://www.aldiwan.net/poem1838.html","الطويل"],[416,"يا قلب هل لك في السلو","https://www.aldiwan.net/poem53909.html","مجزوء الكامل"],[416,"شفها السير والأسى والغرام","https://www.aldiwan.net/poem53960.html","الطويل"],[416,"عيدي بيوم شفائكم لسقامي","https://www.aldiwan.net/poem54014.html","الكامل"],[416,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[416,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[416,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[416,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[437,"صب قتيل المقلتين","https://www.aldiwan.net/poem2556.html","مجزوء الكامل"],[437,"الحسن حيث المقلة الكحلاء","https://www.aldiwan.net/poem2578.html","الكامل"],[439,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[439,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[441,"أسير الهوى قل لي فما أنت صانع","https://www.aldiwan.net/poem14332.html","الطويل"],[458,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[477,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[477,"دمن حبسن على الغرام وأربع","https://www.aldiwan.net/poem15253.html","الكامل"],[477,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[477,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[479,"في اليم عمت وفي الدموع أعوم","https://www.aldiwan.net/poem36994.html","الكامل"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[540,"ظعن الخليط بلبك المتقسم","https://www.aldiwan.net/poem56660.html","الكامل"],[551,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"]],"verses":[["ظَعَنَ الغِنى عَنّي وَحَو","وَلَ رَحلَهُ إِلّا قَليلا",0,"ل",2,0],["ظَعَنوا فَلِلأَحشاءِ مُذ ظَعَنوا","حُرَقٌ تُعَسِّفُها وَتَعسِفُها",1,"ف",3,0],["ظَعَنوا فَما لَكَ لا تُفارِقُهُم","يا قَلبُ إِن رَحَلوا وَإِن حَطُّوا",2,"ط",3,0],["ظَعَنَ الَّذينَ فَراقَهُم أَتَوَقَّعُ","وَجَرى بِبَينِهِمُ الغُرابُ الأَبقَعُ",3,"ع",1,1],["ظَعَنَ الَّذينَ أُحِبُّهُم فَتَحَمَّلوا","نَفسي الفِداءُ لِظاعِنٍ مُتَحَمِّلِ",4,"ل",1,0],["ظَعَنْتَ عَنِ الدُّنْيَا حَمِيداً مُقَدَّسَا","وَسِرْتَ بَرِيئاً مِن ذَمِيم الْمَثَالِب",5,"ب",1,0],["ظَعائِنَ مِن بَني جُشَمَ بنِ بَكرٍ","خَلَطنَ بِمَيسَمٍ حَسَباً وَديناً",6,"ن",2,0],["ظَعائِنُ يَشفينَ السَقيمَ مِنَ الجَوى","بِهِ وَيُخَبِّلنَ الصَحيحَ المُسَلَّما",7,"م",2,0],["ظَعائِنُ كَالسَلوى الَّتي لا يَحُزنَها","أَو المَنَّ إِذ فاحَت بِهِنَّ الفَوائِحُ",8,"ح",1,0],["ظَعائِنَ يَحلُلنَ الفَلاةَ وَتارَةً","مَحاضِرَ عَذبٍ لَم تَخُضهُ الضَفادِعُ",9,"ع",1,0],["ظَعائِنُ لَم يَسلُكنَ أَكنافَ قَريَةٍ","بِسيفٍ وَلَم تَنغُض بِهنَّ القَناطِرُ",10,"ر",1,0],["ظَعائِنُ لَم يَحلُلنَ إِلاّ تَنوفَة","عَذاةً إِذا ما البَردُ هَبَّت جَنائِبُه",11,"ب",2,0],["ظَعائِنَ لَم يَدِنَّ مَعَ النَصارى","وَلا يَدرينَ ما سَمكُ القَراحِ",12,"ح",1,0],["ظعائنُ من بني الحُلاَّفِ تأوِي","إلى خُرسٍ نواطقَ كالفتينا",13,"ن",2,0],["ظَعَائن لَم تَزَل مِن مُسنمَات","غَنَائِمَ يَصطَبِحنَ وَيَدَّوِينَا",14,"ن",2,0],["ظعن الكرام الأولون وأقبلت","أيَّامه فكأنهم لم يظعنوا",15,"ن",3,0],["ظعنتم والربيع منصرمٌ","والأرض تبكي على شقائقها",16,"ق",3,0],["ظَعائِنُنا غَداةَ غَدَت عَلَينا","وَنِعمَت ساعَةُ السَيفِ الجُرازِ",17,"ز",1,0],["ظَعائِنُ إِمّا مِن هِلالٍ ذُؤابَةٌ","هِجانٌ وَإِمّا مِن سَراةِ الأَراقِمِ",18,"م",1,1],["ظَعائِنُ لَيلى وَالفُؤادُ مُكَلَّفٌ","بِلَيلى وَما تُعطي أَخا الوُدِّ طائِلا",19,"ل",2,0],["ظَعائِنُ مِئنافٍ إِذا مَلَّ بَلدَةً","أَقامَ الرِكابَ باكِرٌ مُتَرَوَّحُ",20,"ح",1,0],["ظَعائِنُ مِن كِرامِ بَني نُمَيرٍ","خَلَطنَ بِمَيسَمٍ حَسَباً وَدينا",21,"ن",2,0],["ظَعَنتُ وَوَدَّعتُ الخَليطَ اليَمانِيا","سُهَيلاً وَآذَنّاهُ أَن لا تَلاقِيا",22,"ي",2,1],["ظَعائِنُ ما في قُربِهُنَّ لِذي هَوىً","مِنَ الناسِ إِلّا شِقوَةٌ وَفُنونُ",23,"ن",1,0],["ظَعائِنُ أَظعَنَّ الكَرى عَن جُفونِنا","وَعَوَّضنَها مِنهُ سُهاداً وَأَدمُعا",24,"ع",2,0],["ظَعَنَت بِهِ أَيّامُهُ وَشُهورُهُ","إِنَّ المُقيمَ عَلى الحَوادِثِ ظاعِنُ",25,"ن",1,0],["ظعائنُ أشرقَتْ بالدمعِ عيني","وقد شَرِقَتْ بها تلك الشِّعابُ",26,"ب",1,0],["ظَعَنَ المَوتى إِلى ما","قَدَّموهُ وَجَدوهُ",27,"و",2,0],["ظَعَنوا فَبِتُّ أَسُحُّ دَمعي بَعدَهُم","وَأُجيلُ في تِلكَ الدِيارِ لِحاظي",28,"ي",1,0],["ظَعَنٌ يَقودُ إِلى الحَبيبِ نُفوسَنا","وَإِلى اِبنِ أُرتُقَ جَوهَرَ الأَلفاظِ",28,"ظ",1,0],["ظَعَنوا فَكانَ بُكايَ حَولاً بَعدَهُم","ثُمَّ اِرعَوَيتُ وَذاكَ حُكمُ لَبيدِ",29,"د",1,0],["ظعنوا بظبيٍ ساكنٍ","قلبي وقلبي ما سكنْ",30,"ن",1,0],["ظَعَنوا كَأَنَّ ظُعنَهُمُ","مونِعُ القُنوانِ أَو عُشَرُ",31,"ر",1,0],["ظَعائِنُ لَو يَصِفنَ بِدَيرِ لَيلى","مَنى لي أَن أُلاقيهِنَّ ماني",32,"ي",1,0],["ظَعائِنُ كُنتُ أَعهَدُهُنَّ قِدماً","وَهُنَّ لِذي الأَمانَةِ غَيرُ خونِ",33,"ن",1,0],["ظَعائِنُ يَستَحِدثنَ في كُلِّ مَوطِنٍ","رَهيناً وَلا يُحسِنَّ فَكَّ الرَهائِنِ",34,"ن",1,0],["ظُعُنٌ تَجاسَرُ بَينَ حَزمِ عُوارِضٍ","وَعُنَيزَتينِ رَبيعُهُنَّ الأَغيَدُ",35,"د",1,0],["ظَعائِنُ شِمنَ قَريحَ الخَريف","مِنَ الأَنجُمِ الفَرغِ وَالذابِحَه",36,"ح",2,0],["ظُعُناً مِن بَني عُقَيلِ بنِ كَعبٍ","مُشرِفاتِ الوُجوهِ عِيناً وَحوراً",37,"ر",2,0],["ظعن الَّذي أحبهم","عني إلى البلد الشَطير",38,"ر",1,0],["ظَعَنْتَ لِتَسْتَفيدَ أخاً وفِيّاً","وضَيّعْتَ القَديمَ المُسْتَفادا",39,"د",2,0],["ظَعنُوا وأُتبعُهُم عُذافِرَةص","حَرفاً أَمُوناً سَهوَةَ الَخَبَبِ",40,"ب",1,0],["ظَعنتُ يا اِبني فَذابَ قَلبي","وَرُبَّما رقَّتِ الغِلاظُ",41,"ظ",1,0],["ظَعنتُ وَقَلبي في يَدَيك وَديعَة","فَهَل أَنت لِلمُستَودَعاتِ حَفوظُ",42,"ظ",1,0],["ظَعائنُ أظعَنّ الكَرَى عن جُفونِنَا،","وَعَوّضْنَنَا مِنْهُ سُهَاداً وَأدْمُعَا",43,"ع",2,0],["ظعنَ الذينَ فراقهم أتوقعُ","وجرى بينهُمُ الغُرابُ الأَبْقعُ",44,"ع",1,1],["ظَعنوا فَكُلُ أَخي هَوى وَصَبابة","وَقف عَلى التِذكار وَالتَسئال",45,"ل",1,0],["ظعنوا بأقمارٍ علي","ها تُحسدُ الكومُ الجِلادُ",46,"د",1,0],["ظَعَنتَ فَلَم تَظعَن رِعايَتُكَ الَّتي","حَمَتهُم فَما ريعوا وَأَجدَت فَلَم يُكدوا",47,"د",3,0],["ظعَنتُ بِسِرِّي عَن سِواكَ لأَنَّني","رَأيتُكَ سِرَّ السرِّ مِن حَيثُ الحظُ",48,"ظ",1,0],["ظَعنوا فَفي كَنَفِ الإِلَهِ وَحِفظِهِ","لا زِلتُ أَرعى عَهدَهُم وَأُحافِظُ",49,"ظ",1,1],["ظَعَنْتَ وَقَدْ خَلَّفْتَنِي نُهْبَةَ الأَسَى","لِعَّلةِ وَجْدٍ لاَ يُصابُ طَبِيبهُا",50,"ب",3,0],["ظَعُناً أَستَودِعُ اللَهَ عَلى ال","نَأيِ قَلباً سارَ في أَظعانِها",51,"ن",3,0],["ظَعَنوا بِالعَزاءِ وَال","صَبرِ وَالوَهدُ ما ظَعَن",52,"ن",1,0],["ظَعَنُوا وَهُمْ قَدْ وَدَّعُوا أوْ سَلَّمُوا","وَظَعَنْتُ غَيْرَ مُوَدِّعٍ وَمُسَلِّمِ",53,"م",1,0],["ظعنوا وَالقَلبُ يَقفو إِثرَهُم","تَبِعَ العيسَ بُكوراً واِدِّلاجا",54,"ج",2,0],["ظعنتْ بابن يوسُفٍ قُلُص الأ","يّام تطوِى الإدلاجَ والإسراءَ",55,"ا",2,0],["ظَعائِنُ أَبرَقنَ الخَريفَ وَشِمنَهُ","وَخِفنَ الهُمامَ أَن تُقادَ قَنابِلُه",56,"ل",2,0],["ظَعنوا في أيّ واديّ الكُوَى","وحدا بالقلبِ أىُّ الحاديَيْن",57,"ن",1,0],["ظَعَنوا بِنورٍ لَستُ أَسأَلُهُ","لا الشَمسَ بَعدَهُم وَلا القَمَرا",58,"ر",2,0],["ظَعَنَت ذَخائِرُ أَدمُعي وَتَفَرَّقَت","مِن قَبلِ يَومِ تَفَرُّقِ الأَظعانِ",59,"ن",1,0],["ظَعَنوا فَخَيَّمَ لاعِجُ الأَشواقِ","يَومُ الفِراقِ قِيامَةُ العُشَّاقِ",60,"ق",1,1],["ظَعائِنُ لا توفي بِهِنَّ ظَعائِنٌ","وَلا الثاقِباتُ مِن لُؤَيِّ بِنِ غالِبِ",61,"ب",1,1],["ظَعَنَ الذين هَوَيْتَهم","وَحَدَتْ بهم نجبٌ ونجبُ",62,"ب",1,0],["ظَعَنَ الركب ضحوةً وأراني","لم يطب لي بعد الحبيب مقام",63,"م",1,0],["ظعنوا فما أبقَوا لمسلوب الحشى","إلاَّ توقُّد لوعة وغرام",64,"م",1,0],["ظعن الحيُّ وأضحى حبُّهم","يسأل الأرْسُمَ عنهم والطلولا",65,"ل",2,0],["ظعن الأُلى فتسابقت أظعانهم","تجتاب بين دكادكٍ وفدافد",66,"د",1,0],["ظعن الذين أحبّهم فتناهبت","مهج القلوب حواجب بعيون",67,"ن",1,0],["ظعن الظاعنون فاستمطر ال","دَمع فؤادي سحًّا عليهم وسجما",68,"م",2,0],["ظعن الفؤاد وصبرهُ","فبكى البعد الظاعنين",69,"ن",1,0],["ظعنت مودّعة فصبر طاعن","يوم النوى ومدامع أنواء",70,"ا",2,0],["ظُعُنٌ سَرَيْنَ الليلَ ضَرْبَةَ لازِمٍ","وسَرى إِليها الهَمُّ ضَرْبَةَ لازِبِ",71,"ب",1,0],["ظعائِنُ عُمْرانُ المعاهِدِ مُقفِرٌ","بهنَّ وقَفْرُ الأَرْضِ منهُنَّ عُمْرانُ",72,"ن",1,0],["ظعائن من حيي عمير وعامر","بها افتخرت يوم الفخار التبابع",73,"ع",1,0],["ظعنوا فشبتُ وما كبرتُ وإنما","راح الشباب يشيع الأظعانا",74,"ن",2,0],["ظعنَ الأحبَّةُ راحلينَ وخلَّفوا","قلباً بنيرانِ التفرُّقِ صاليا",75,"ي",2,0],["ظعنوا فلي جسمٌ يذوبُ صبابةً","مِنْ بعدِ ينهمُ وقلبٌ موجعُ",76,"ع",1,0],["ظعنوا فلو حلَّ الذي قد نالَه","بالصخرِ بعدَ نواهمُ لتفطَّرا",77,"ر",2,0],["ظعائنٌ قامَ لأشواقِنا","بعد تنائيهنَّ أسواقُ",78,"ق",1,0],["ظعن السلو مع الحجى وخلا لها","قلبي ولكن الفؤاد سقيم",79,"م",1,0],["ظعنت ومن ذي القعدة ال","باقي ليال أربع",80,"ع",1,0],["ظَعَنَ الخَليطُ بلُبِّكَ المُتَقَسِّمِ","وَرَموكَ عَن قَوسِ الخِبالِ بِأَسهُمِ",81,"م",1,1],["ظَعَنتْ لم تُراعها باِشتِياقٍ","وأنابتْ لم تدعُها بزَماعِ",82,"ع",1,0]]}