{"poems":[[53,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[63,"يا نجد ما لأحبتي شطوا","https://www.aldiwan.net/poem45737.html","أحذ الكامل"],[3,"ظعن الذين فراقهم أتوقع","https://www.aldiwan.net/poem101.html",""],[55,"من كان يبكي لي لرزء موجع","https://www.aldiwan.net/poem26173.html","الكامل"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[35,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[35,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[30,"أمنزلتي مي سلام عليكما","https://www.aldiwan.net/poem29573.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[29,"لعمر أبيك يا زفر ابن عمر","https://www.aldiwan.net/poem6066.html","الوافر"],[29,"ظعائن إما من هلال ذؤابة","https://www.aldiwan.net/poem6133.html","الطويل"],[29,"ألا لا تلوميني على الخمر عاذلا","https://www.aldiwan.net/poem6175.html","الطويل"],[38,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[38,"ظعنت وودعت الخليط اليمانيا","https://www.aldiwan.net/poem7822.html","الطويل"],[32,"شهدت بأني لم تغير مودتي","https://www.aldiwan.net/poem27813.html","الطويل"],[45,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[45,"بان الشباب وكل شيء بائن","https://www.aldiwan.net/poem66678.html","الكامل"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[69,"أفديك أيتها الدمن","https://www.aldiwan.net/poem29007.html","مجزوء الكامل"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[39,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[50,"قم خليلي فانظر أراك بصيرا","https://www.aldiwan.net/poem63816.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85447","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20994","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"],[45,"خُذا مِنْ بُكاءٍ في المَنازِلِ، أوْ دَعَا","https://www.poetsgate.com/ViewPoem.aspx?id=31218",""],[3,"ظعنَ الذينَ فراقهم أتوقعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10713&r=&rc=67",""]],"verses":[["ظَعَنَ الغِنى عَنّي وَحَو","وَلَ رَحلَهُ إِلّا قَليلا",0,"ل",2,0],["ظَعَنوا فَلِلأَحشاءِ مُذ ظَعَنوا","حُرَقٌ تُعَسِّفُها وَتَعسِفُها",1,"ف",3,0],["ظَعَنوا فَما لَكَ لا تُفارِقُهُم","يا قَلبُ إِن رَحَلوا وَإِن حَطُّوا",2,"ط",3,0],["ظَعَنَ الَّذينَ فَراقَهُم أَتَوَقَّعُ","وَجَرى بِبَينِهِمُ الغُرابُ الأَبقَعُ",3,"ع",1,1],["ظَعَنَ الَّذينَ أُحِبُّهُم فَتَحَمَّلوا","نَفسي الفِداءُ لِظاعِنٍ مُتَحَمِّلِ",4,"ل",1,0],["ظَعَنْتَ عَنِ الدُّنْيَا حَمِيداً مُقَدَّسَا","وَسِرْتَ بَرِيئاً مِن ذَمِيم الْمَثَالِب",5,"ب",1,0],["ظَعائِنَ مِن بَني جُشَمَ بنِ بَكرٍ","خَلَطنَ بِمَيسَمٍ حَسَباً وَديناً",6,"ن",2,0],["ظَعائِنُ يَشفينَ السَقيمَ مِنَ الجَوى","بِهِ وَيُخَبِّلنَ الصَحيحَ المُسَلَّما",7,"م",2,0],["ظَعائِنُ كَالسَلوى الَّتي لا يَحُزنَها","أَو المَنَّ إِذ فاحَت بِهِنَّ الفَوائِحُ",8,"ح",1,0],["ظَعائِنَ يَحلُلنَ الفَلاةَ وَتارَةً","مَحاضِرَ عَذبٍ لَم تَخُضهُ الضَفادِعُ",9,"ع",1,0],["ظَعائِنُ لَم يَسلُكنَ أَكنافَ قَريَةٍ","بِسيفٍ وَلَم تَنغُض بِهنَّ القَناطِرُ",10,"ر",1,0],["ظَعائِنُ لَم يَحلُلنَ إِلاّ تَنوفَة","عَذاةً إِذا ما البَردُ هَبَّت جَنائِبُه",11,"ب",2,0],["ظَعائِنَ لَم يَدِنَّ مَعَ النَصارى","وَلا يَدرينَ ما سَمكُ القَراحِ",12,"ح",1,0],["ظعائنُ من بني الحُلاَّفِ تأوِي","إلى خُرسٍ نواطقَ كالفتينا",13,"ن",2,0],["ظَعَائن لَم تَزَل مِن مُسنمَات","غَنَائِمَ يَصطَبِحنَ وَيَدَّوِينَا",14,"ن",2,0],["ظعن الكرام الأولون وأقبلت","أيَّامه فكأنهم لم يظعنوا",15,"ن",3,0],["ظعنتم والربيع منصرمٌ","والأرض تبكي على شقائقها",16,"ق",3,0],["ظَعائِنُنا غَداةَ غَدَت عَلَينا","وَنِعمَت ساعَةُ السَيفِ الجُرازِ",17,"ز",1,0],["ظَعائِنُ إِمّا مِن هِلالٍ ذُؤابَةٌ","هِجانٌ وَإِمّا مِن سَراةِ الأَراقِمِ",18,"م",1,1],["ظَعائِنُ لَيلى وَالفُؤادُ مُكَلَّفٌ","بِلَيلى وَما تُعطي أَخا الوُدِّ طائِلا",19,"ل",2,0],["ظَعائِنُ مِئنافٍ إِذا مَلَّ بَلدَةً","أَقامَ الرِكابَ باكِرٌ مُتَرَوَّحُ",20,"ح",1,0],["ظَعائِنُ مِن كِرامِ بَني نُمَيرٍ","خَلَطنَ بِمَيسَمٍ حَسَباً وَدينا",21,"ن",2,0],["ظَعَنتُ وَوَدَّعتُ الخَليطَ اليَمانِيا","سُهَيلاً وَآذَنّاهُ أَن لا تَلاقِيا",22,"ي",2,1],["ظَعائِنُ ما في قُربِهُنَّ لِذي هَوىً","مِنَ الناسِ إِلّا شِقوَةٌ وَفُنونُ",23,"ن",1,0],["ظَعائِنُ أَظعَنَّ الكَرى عَن جُفونِنا","وَعَوَّضنَها مِنهُ سُهاداً وَأَدمُعا",24,"ع",2,0],["ظَعَنَت بِهِ أَيّامُهُ وَشُهورُهُ","إِنَّ المُقيمَ عَلى الحَوادِثِ ظاعِنُ",25,"ن",1,0],["ظعائنُ أشرقَتْ بالدمعِ عيني","وقد شَرِقَتْ بها تلك الشِّعابُ",26,"ب",1,0],["ظَعَنَ المَوتى إِلى ما","قَدَّموهُ وَجَدوهُ",27,"و",2,0],["ظَعَنوا فَبِتُّ أَسُحُّ دَمعي بَعدَهُم","وَأُجيلُ في تِلكَ الدِيارِ لِحاظي",28,"ي",1,0],["ظَعَنٌ يَقودُ إِلى الحَبيبِ نُفوسَنا","وَإِلى اِبنِ أُرتُقَ جَوهَرَ الأَلفاظِ",28,"ظ",1,0],["ظَعَنوا فَكانَ بُكايَ حَولاً بَعدَهُم","ثُمَّ اِرعَوَيتُ وَذاكَ حُكمُ لَبيدِ",29,"د",1,0],["ظعنوا بظبيٍ ساكنٍ","قلبي وقلبي ما سكنْ",30,"ن",1,0],["ظَعَنوا كَأَنَّ ظُعنَهُمُ","مونِعُ القُنوانِ أَو عُشَرُ",31,"ر",1,0],["ظَعائِنُ لَو يَصِفنَ بِدَيرِ لَيلى","مَنى لي أَن أُلاقيهِنَّ ماني",32,"ي",1,0],["ظَعائِنُ كُنتُ أَعهَدُهُنَّ قِدماً","وَهُنَّ لِذي الأَمانَةِ غَيرُ خونِ",33,"ن",1,0],["ظَعائِنُ يَستَحِدثنَ في كُلِّ مَوطِنٍ","رَهيناً وَلا يُحسِنَّ فَكَّ الرَهائِنِ",34,"ن",1,0],["ظُعُنٌ تَجاسَرُ بَينَ حَزمِ عُوارِضٍ","وَعُنَيزَتينِ رَبيعُهُنَّ الأَغيَدُ",35,"د",1,0],["ظَعائِنُ شِمنَ قَريحَ الخَريف","مِنَ الأَنجُمِ الفَرغِ وَالذابِحَه",36,"ح",2,0],["ظُعُناً مِن بَني عُقَيلِ بنِ كَعبٍ","مُشرِفاتِ الوُجوهِ عِيناً وَحوراً",37,"ر",2,0],["ظعن الَّذي أحبهم","عني إلى البلد الشَطير",38,"ر",1,0],["ظَعَنْتَ لِتَسْتَفيدَ أخاً وفِيّاً","وضَيّعْتَ القَديمَ المُسْتَفادا",39,"د",2,0],["ظَعنُوا وأُتبعُهُم عُذافِرَةص","حَرفاً أَمُوناً سَهوَةَ الَخَبَبِ",40,"ب",1,0],["ظَعنتُ يا اِبني فَذابَ قَلبي","وَرُبَّما رقَّتِ الغِلاظُ",41,"ظ",1,0],["ظَعنتُ وَقَلبي في يَدَيك وَديعَة","فَهَل أَنت لِلمُستَودَعاتِ حَفوظُ",42,"ظ",1,0],["ظَعائنُ أظعَنّ الكَرَى عن جُفونِنَا،","وَعَوّضْنَنَا مِنْهُ سُهَاداً وَأدْمُعَا",43,"ع",2,0],["ظعنَ الذينَ فراقهم أتوقعُ","وجرى بينهُمُ الغُرابُ الأَبْقعُ",44,"ع",1,1]]}