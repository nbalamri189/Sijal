{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[303,"إِن الذين تجافى عنهم الشرف","https://www.aldiwan.net/poem36822.html","عموديه"],[354,"تبدى كالهلال وصار بدرا","https://www.aldiwan.net/poem15839.html","الوافر"],[543,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[556,"لنشر فضلك آثاري وأخباري","https://www.aldiwan.net/poem47791.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48535","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31648","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119628","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67663","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72824","السريع"],[5791,"غزلٌ فتيّ ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208173",""],[5997,"أوقفوا الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=214280",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[6206,"قُلْ \"للشَّريف\" المستجا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27272&r=&rc=13",""]],"verses":[["لنشربَ منْ دمِ هذا الفتى","مُصفَّى الرحيقِ بأكوابنَا",0,"ن",2,0],["لنشركنكمُ بالضرِّ فهو إذا","أُميط عنكم فعنّا الضر منكشف",1,"ف",1,0],["لِنَشهَدَ شَهرَهُ وَالصَومَ فيهِ","وَعيدَ الفِطرِ في يَومِ المَآلِ",2,"ل",1,0],["لنشرِها الفتِيقُ","وأنجمُ المجَرَّةِ",3,"ه",1,0],["لِنشرِ فَضلك آثاري وأخباري","وفي ولائك إعلاني وإسراري",4,"ر",2,1],["لنشر الدين مرماها البعيدُ","وباسم اللّه مسعاها الحميدُ",5,"د",1,0],["لَنُشارِكَنَّ بَني أُمَيْ","يةَ في الضَّلالِ المُشْتَهِرْ",6,"ر",1,0],["لنشكر معروفاً وحالك بيننا","شبيهٌ قريباً ودّ نفع الأقارب",7,"ب",1,0],["لنشرعَ في الأمر ما راعنا","سوى بدوةِ لك لم تُحتَسب",8,"ب",1,0],["لنشأة الصبا صبَت نشأتي","فشمت للنعمان فيها وشام",9,"م",1,1],["لنشهدنا ضفافاً من عناقٍ","يراودنا ويخسرُ من يعفُّ",10,"ف",1,0],["لَنَشْفِيْ الجِرَاْحَ الْتِيْ أَدْمَلَتْ","وَنَنْسُجْ أَمَلْنَاْ مِنَ الْعَنْكَبُوْت",11,"ت",1,0],["لِنْشربِ الماءَ دَمّاً من مذابحهِ","ولنحتسِ الخمرَ دمعاً من مآقيهِ",12,"ي",2,0],["لنُشاركنَّ «بني أُميَّ","ة َ في الضَّلال المُشْتَهِرْ",13,"ر",1,0]]}