[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78130","الرمل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95376","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125419","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71051","الخفيف"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77306","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58413","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65252","الكامل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99343","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117889","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90741","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139692",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[5055,"حرف شعري","https://www.poetsgate.com/ViewPoem.aspx?id=103544",""],[5055,"بتول","https://www.poetsgate.com/ViewPoem.aspx?id=106077",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5186,"يا هنائي ساعة اللقيا وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156511",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5461,"يا صقر","https://www.poetsgate.com/ViewPoem.aspx?id=508",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5596,"آه نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=206780",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""],[5739,"حالب النمله ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155467",""],[5784,"العشق بلوى...","https://www.poetsgate.com/ViewPoem.aspx?id=190790",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""]],"verses":[["بَينَ قُربٍ مُنَغَّصٍ بِصُدودٍ","وَوِصالٍ مُنَغَّصٍ بِرَقيبِ",0,"ب",1,0],["بَيْنَ قومٍ لا يَفْهَمونَ أَناشيدَ","فؤادي ولا معانيَ بؤسي",1,"ي",1,0],["بَينَ قَومٍ لَستُ المَلومَ إِذا أَذ","هَبتُ نَفسي عَلَيهِم حَسَراتِ",2,"ت",1,0],["بَينَ قَديمٍ وَزَميلٍ صادِقٍ","لا زالَ شُكري لَهُما مُواصِلا",3,"ل",2,0],["بَيْنَ قِنَانٍ عَلَى ثَرَاها","مِنْ سُتُراتِ الْغَمَامِ بُرْدُ",4,"د",1,0],["بين قومٍ ما رَنَّ في سمعِهم أح","لَى نشيداً من أصفرٍ رنّان",5,"ن",1,0],["بَينَ قُضاةِ السَوءِ وَالأَطفالِ","شَبيهَةِ الإِدبارِ بِالإِقبالِ",6,"ل",1,0],["بَينَ قَلبي وَسُلُوّي في الهَوى","مِثلُ ما بَينَ الثُرَيّا وَالثَرى",7,"ر",2,0],["بين قصد من عدو","ومداراة جهول",8,"ل",1,0],["بين قوم إذا اشتكيت","يقولون شمّ",9,"م",1,0],["بين قومٍ قد صَيروا المنع والم","نَّ لهم في الزمان دَأباً وملَّه",10,"ل",2,0],["بين قلبي وبين صَبري عنكم","مثلُ ما بين مسمَعي والملامَه",11,"م",2,0],["بَينَ قَومٍ لا يَرهَبونَ مِنَ المَو","تِ وَنارُ الهَيجاءِ ذاتُ سَعيرِ",12,"ر",1,0],["بَينَ قَوم جَعَلوا زينتهم","حللاً قَد شَمَلت كُلّ مُرابِ",13,"ب",1,0],["بين قومي وبين دَرْبِ المعالي","خَيْطُ وَهْمٍ، لو جاوَزوه كُفينَا",14,"ن",2,0],["بين قُطَّاع طريقٍ، ولصوصٍ","ما لهم في مُسْلمٍ إلٌّ وذِمَّهْ",15,"م",2,0],["بَيْنَ قَلْبٍ تُذيبُه","ودُموعٍ تريقُها",16,"ق",3,0],["بين قتيلٍ منكُمُ محاربٍ","يكفُرُ أو منافقٍ مسالمِ",17,"م",1,0],["بَينَ قَومٍ حرامُ قتل المحبي","نَ عَلى ما يرون غير حرامِ",18,"م",1,0],["بين قومٍ يزيدهمْ عذلُ اللّو","وامِ في المكرُماتِ حثّاً وحَضّا",19,"ض",2,0],["بينَ قلبِ المُحِبِّ والأحداقِ","كلُّ حربٍ قامَتْ على كلِّ ساقِ",20,"ق",1,1],["بينَ قفاهُ وبيم كفِّيَ ما","بين المضاريبِ والطنابير",21,"ر",1,0],["بَيْنَ قُرْطٍ وَخَاتَمٍ وَسِوَارٍ","وَوِشَاحٍ وَدُمْلُجِ وَعُقُودِ",22,"د",1,0],["بين قرون عُصْبة النُصَّابِ","في دَوْلَة الأزْلام والأنْصاب",23,"ب",1,0],["بين قومٍ جميعُ حظّيَ منهم","أنْ يسمّونني من الظُرفاء",24,"ا",2,0],["بين قومٍ دروا قياس ابن سينا","فأحبّوا عريض ذاك القياس",25,"س",1,0],["بَينَ قَيصومٍ وَربوه","قَد رَبي هَذا الغَزال",26,"ل",1,1],["بين قومٍ على اللحوم عكوف","قد تبدت خرفانهم كالبدور",27,"ر",1,0],["بين قلبي وسحر عَينيكِ حَربٌ","أشعل النارَ فيه وجدُ غرامي",28,"م",2,1],["بين قومٍ جميعهم لَي أَضْدا","دٌ وَحِيداً ما لي من القوم ثاني",29,"ن",2,0],["بين قبر ومنبر أنت منها","غاديا رائحا بلا إغباب",30,"ب",1,0],["بَينَ قَصرٍ وَبَينَ نَهرٍ كَريم","وَرِياضٍ خُضرٍ وَزَهرٍ نَضيرِ",31,"ر",1,0],["بينَ قومٍ لو قلتُ إني أبنُ سينا","ضَرَطوا في شَواربِ الغَزاليِ",32,"ل",2,0],["بين قضى في الصّبّ بالإجهاز","جورا وصال على الغراب البازي",33,"ز",2,1],["بين قوم إمامهم ساجد","للكأس أو راكع على المزمار",34,"ر",1,0],["بين قنص أو هراش أو كرى","يذهب التاريخ فيها ويعود",35,"د",1,0],["بين قلوب الكل إلف وإن","تباينت أجناسهم واللغات",36,"ت",1,0],["بَينَ قَومِ الإِغرِيقِ يَنهَبُ نَهبا","يَتَقَصَّى مُستَطلِعاً مُشرَئِبَّا",37,"ب",2,0],["بين قبر ومنبر في رباها","روضة من رياض دار الرضاء",38,"ا",2,0],["بين قوم على الدنان عكوف","قد سقاهم ساقي الشارب الطهور",39,"ر",1,0],["بين قوم على الدنان عكوف","قد سقاهم ساقي الشراب الطهور",40,"ر",1,0],["بين قومٍ حاربوا ربَّ السما","وعن الإسلام كلٌّ رجعا",41,"ع",2,0],["بين قربٍ ونوىً ليس يدومْ","غيرُ وجدٍ بالحشا مستترِ",42,"ر",1,0],["بين قربي وقربك كل شيء يحول","قلت أنادي خيالك عل طيفك يعين",43,"ن",1,0],["بين قربك وقربي كل شيءٍ يحول","قلت أنادي خيالك عل طيفك يعين",44,"ن",1,0],["بين قاني الدمع أو قاني الدما","حيث يهراق نجيع الزاكيات",45,"ت",1,0],["بين قد، عز من قومه،","واعتدال، جل خير الصانعين",46,"ن",1,0],["بين قوم دأبهم في الحي أن","يكرموا الضيف وأن يرعوا الذماما",47,"م",2,0],["بين قلبي وبينك فرق والله كبير","لى كفخت انطلقت ولى كفخت التوى",48,"و",2,0],["بين قَتْلِى ومولدي مُفْزِعاتٌ","هن عمري ومسرحي والروايهْ",49,"ا",3,0],["بين قابوس في تجليه شمساً","وابن مكتوم في السماء التقاء",50,"ا",2,0],["بين قلب مقيدٍ وغرام","أنهكته بوقعها الأنباء",51,"ا",2,0],["بين قلبي وبين قلبكِ سرٌّ","دافئُ الهمس ِما له ترْجُمانُ",52,"ن",1,0],["بين قدحة زند.! ونيّات الهواه.","دخّنَت .! في صدر وجهٍ شمها.",53,"م",3,0],["بينٙ قلْبِي ...حكايةٌ ليس تُرْوى","إِنّٙني ...قدْ عٙشقتُ والعشقُ بٙلْوى",54,"و",2,1],["بَينَ قَلبِي وَ قَلبِها ذِكرَياتٌ","قَطَعَتها مَباضِعُ الخُيَلاءِ",55,"ا",2,0]]}