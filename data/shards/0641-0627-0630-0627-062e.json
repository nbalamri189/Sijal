{"poems":[[93,"امنحيني يا نجوم الألقا","https://www.aldiwan.net/poem9047.html","عموديه"],[91,"ما رأت في الناس عيني","https://www.aldiwan.net/poem44968.html","مجزوء الرمل"],[99,"نزل الظلام فلات حين مقامي","https://www.aldiwan.net/poem24397.html","الكامل"],[50,"نفس المدامة أطيب الأنفاس","https://www.aldiwan.net/poem63435.html","الكامل"],[50,"ومؤاتي الطرف عف اللسان","https://www.aldiwan.net/poem65277.html","المديد"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[93,"في يوبيل شكيب ارسلان","https://www.poetsgate.com/ViewPoem.aspx?id=53169",""],[119,"ومهفهف لعب الشباب بطوره","https://www.aldiwan.net/poem41107.html","عموديه"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[325,"أطمعتني بالجود حين بدأتني","https://www.aldiwan.net/poem61770.html","الكامل"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[466,"وكريم الملتقى ذو لسن","https://www.aldiwan.net/poem16152.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138201",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103087","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70838","الكامل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62682","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133842","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118122","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53216","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93322","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205829","الخفيف"],[2943,"","https://poetry.dctabudhabi.ae/diwan/poem/111344","الكامل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96111","الكامل"],[3215,"","https://poetry.dctabudhabi.ae/diwan/poem/147368","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112346","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108084","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44907","الخفيف"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18978","الكامل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28647","الخفيف"],[4859,"ملام العذل","https://www.poetsgate.com/ViewPoem.aspx?id=186848",""],[4978,"تحية لأستاذتي عبير التميمي","https://www.poetsgate.com/ViewPoem.aspx?id=189769",""],[4984,"الْأَحْدَاثُ","https://www.poetsgate.com/ViewPoem.aspx?id=201165",""],[4999,"ثعالب بشرية","https://www.poetsgate.com/ViewPoem.aspx?id=184288",""],[5009,"إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=68090",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5190,"يا صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=123994",""],[5409,"عش في زمانك ما استطعت نبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155496",""],[5616,"حب","https://www.poetsgate.com/ViewPoem.aspx?id=203185",""],[5691,"الحليب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=205883",""],[5695,"براءة ووفاء..","https://www.poetsgate.com/ViewPoem.aspx?id=212553",""],[5937,"بَين رِمشَين","https://www.poetsgate.com/ViewPoem.aspx?id=211818",""],[6152,"الشعر إحساس وشوق يصرع","https://www.poetsgate.com/ViewPoem.aspx?id=203283",""]],"verses":[["فَإِذا خامَرَ نَفساً طَرِبَت","وَإِذا لامَسَ قَلباً خَفَقا",0,"ق",2,0],["فإذا خطَّ على القر","طاس أبدى العجبين",1,"ن",1,0],["فإذا خلونا عاوَدتنا ساعةٌ","رقد الهوى في ظلها البسَّامِ",2,"م",1,0],["فَإِذا خَلَوتَ بِشُربِها في مَجلِسٍ","فَاِكفُف لِسانَكَ عَن عُيوبِ الناسِ",3,"س",1,0],["فَإِذا خاطَبَكَ الجِدُّ عَنهُ","أَكذَبَ الجِدَّ حَديثُ الأَماني",4,"ن",2,0],["فَإِذْ أُخْرِجَتْ قَالَ لِلْمَاكِثِي","نَ وَهُمْ فِي ذُهُولِهُمُ المُجْمَدِ",5,"د",1,0],["فإِذا خَطَرْنَ فَهُنَّ رُؤْيَا نَائِمٍ","وإِذا هَمسْنَ فَهُنَّ رَجْعُ نَشِيدِ",6,"د",1,0],["فإذا خامر نفسا طربت","وإذا يروى لباك صفّقا",7,"ق",2,0],["فاذا خلوت فانت خلوة فكرتي","واذا جلوت فانت غاية ما ارى",8,"ر",2,0],["فَإِذا خيامُ الغيمِ في أرجائها","مَضروبةٌ وَحجابُها مستورُ",9,"ر",1,0],["فَإِذا خَلَقتَ مُنَعَّماً في غَبطَةٍ","أَفَلا أُؤَمِّلُ نِعمَةِ الأَتمامِ",10,"م",1,0],["فإذا خوَى قصبي وساندَ فيكُمُ","طلبَ الرفادةِ جنبيَ المهضومُ",11,"م",1,0],["فإذا خادَعَهُ زُخْرُفُها","سَلَّطَ التَّقْوى عليه فاضْمَحَل",12,"ل",1,0],["فإذا خفي أمر أبان ذكاؤه","ما كان عنا خافيا ومحجبا",13,"ب",2,0],["فإذا خفى كل الغيوب غيوبه","وإذا بدا فله العيون عيون",14,"ن",1,0],["فإذا خبَتْ نارُ الصبابةِ شَبَّها","نفحاتُ طيبٍ مِنْ صَباً وجنوب",15,"ب",1,0],["فإذا خَنَسنَ مضى على مُضوائِهِ","وإذا لَحِقنَ به أصَابَ طِعانا",16,"ن",2,0],["فإذا خمشتم باللحاظ قلوبنا","كم ناظر لخدودكم منا خَمَش",17,"ش",1,0],["فإذا خطرت فَخَلفَ جفنٍ واله","حُلمُاً كأروع ما يلوح لبال",18,"ل",1,0],["فإذا خطرت له ترنح مائلاً","وإذا ذكرت له ترنم وانتشى",19,"ش",2,0],["فإذا خصصت سواها فلم تب","ق لها ذمة لكي ترعاها",20,"ا",3,0],["فإذا خيوط المزن حاكتها الصبا","ظلت توشح عاريات متونه",21,"ن",2,0],["فَإِذا خَلَوتُ كَتَبتُها في راحَتي","وَبَكيتُ مُنتَحباً أَنا وَالراءُ",22,"ا",2,0],["فإذا خفّة القطاة إذا اختا","لت على الماء ساعة الآصال",23,"ل",1,0],["فاذا خدت أيدي المطي وكنتم","ممن يقول بذمة الخلان",24,"ن",1,0],["فإذا خمصتم قلتم يا عمنا","واذا بطنتم قلتم ابن الأزورِ",25,"ر",1,1],["فإذا خَلوتَ فخصه بَملاَمَةٍ","أو عِظّْهً موعِظةَ الأديب الأكيس",26,"س",1,0],["فإذا خلا كيسي عمدتُ إِلى","كأسٍ بها أخلو فأستَغني",27,"ي",1,0],["فإذا خجلتَ أخجل من الله الذي","حظر الأنام نقيصةً وحراما",28,"م",2,0],["فَإِذا خُضتَ في عَبابِكَ هَذا","كُنت نَهبَ الأَسماكِ وَالحيتانِ",29,"ن",1,0],["فَإِذا خَفَضتُ خَفَضتُ تَحتَ ضُبارِمٍ","أَحمَت وَقائِعُهُ سُلوكَ الفَدفَدِ",30,"د",1,0],["فإذا خطوتَ فقد وطِئْتَ قطيفةً","وإذا نظرتَ فخُضرةٌ وبهاءُ",31,"ا",2,0],["فَإِذا خَلفَهُ جَبَل","فَتَوقَّلتُ في الجَبَلْ",32,"ل",1,0],["فإذا خبت يوماً سيشعلها اللقا","لتضيءَ ليلَ العاشقِ المتزمّلِ",33,"ل",1,0],["فإذا خطّت فرسمٌ بارعٌ","كل خطِّ ينتهي حيث تشير",34,"ر",1,0],["فإذا خط الأماني صدفة","وافق المرغوب يرقى حلمه",35,"م",2,0],["فإذا خرجنَ من المخابئ خالفوا","تلك العهودِ ومزقوا ذاك الشعارْ.",36,"ر",1,0],["فإذاخشيت فقد عصيتك جاهلال","وإذا رجوت فإنّ عفوك أوسع",37,"ع",1,0],["فإذا خفت الموازين فالبلو","اء أو لا تخف فالنعماء",38,"ا",2,0],["فإذا خطرتُ كمثلِ طيفٍ عابرٍ","قُدَّامَ عينكَ في دجىً ونهارِ",39,"ر",1,0],["فإذا خطبت رأوك عنه معبراً","وإذا انتميت رأوك منه سليلا",40,"ل",2,0],["فإذا خبا وهج المروءة بيننا","سقط الوفاء وجفّت الأخلاق",41,"ق",1,0],["فإذا خرَجْتُ عنِ الحَقيقَةِ ذَرَّةً فاقْطَعْ يَدي","واحْكُمْ عَلَيَّ إذا رغِبْتَ بألْفِ ألْفِ مُؤَبَّدِ",42,"د",1,0],["فإذا خلا سرّ الحياةِ من الوفا","ومِنَ البراءةِ فالحياةُ وبالُ.",43,"ل",1,0],["فإذا خانني القصيد بمتنٍ","نفث الحب في يديّ متونا",44,"ن",2,0],["فإذا خلا من حِسه ودموعه","فهو الحروف وبحره مستنقعُ",45,"ع",1,0]]}