=188602",""],[5480,"(( يا علي ))","https://www.poetsgate.com/ViewPoem.aspx?id=1588",""],[5573,"يموت الداب في سمه ونابه","https://www.poetsgate.com/ViewPoem.aspx?id=204390",""],[5691,"حكومة الوفاق...!","https://www.poetsgate.com/ViewPoem.aspx?id=206342",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5894,"يا حداة السرى بحث المطي","https://www.poetsgate.com/ViewPoem.aspx?id=131438",""],[6002,"في موضع للسالك","https://www.poetsgate.com/ViewPoem.aspx?id=211682",""],[6093,"كالحق ينزل في ضيافة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=205866",""],[6102,"رسول الهوى ..","https://www.poetsgate.com/ViewPoem.aspx?id=184161",""],[469,"أهلك والليل منضيا جملك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574797",""],[6171,"غرفتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86323&r=&rc=6",""],[6259,"أتروم تغطية َ الهوى بجحوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59366&r=&rc=14",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""]],"verses":[["يَحفَظُها مَشايِحاً عَن سِربِها","فَإِن رَأى جِدَّ الرَدى أَضاعَها",0,"ع",3,0],["يَحُفُّ بها مِنْ فَرِْ خِنْدِفَ غِلْمَةٌ","كِنانيّةٌ تَنْحو خَمائِلَ مَنْعِجِ",1,"ج",1,0],["يَحِفُّ عُبَابُ اللَّيْلِ عَنْهَا جَوَاهِراً","فَيَكْثُرُ فِيهَا النَّهْبُ لِلْحِينِ وَاللَّقْطُ",2,"ط",1,0],["يُحَفِّزُ الخَوفُ أَحشاهُ وَتُزعِجُهُ","إِذا سَرَت نَسمَةٌ أَو وَسوَسَ الشَجَرُ",3,"ر",1,0],["يَحُفُّ بِها رَوضٌ يُحَيّي بُدورَها","بُكوراً بِرَيّا عَرفِهِ المُتَضَوِّعِ",4,"ع",1,0],["يُحَفِّرُهُ عَن كُلِّ ساقٍ دَفينَةٍ","وَعَن كُلِّ عِرقٍ في الثَرى مُتَغَلغِلِ",5,"ل",1,0],["يَحفِرَ أَعجازَ الرُخامى المُيَّدا","مِن حَبلٍ حوضى حَيثُ ما تَرَدَّدا",6,"د",2,0],["يحفُّه شبيطرٌ قويّ","في ملَّة الأطيار موسويّ",7,"ي",1,0],["يحفظْك فيه المحافظون إذا","أضحى من الضارطين بالكِسر",8,"ر",1,0],["يحفُّ بشخصه من أقربِيه","غيوثُ مَفاقرٍ وليوثُ بأس",9,"س",1,0],["يَحُفُّ أَغَرَّ لا قَوَدٌ عَلَيهِ","وَلا دِيَةٌ تُساقُ وَلا اِعتِذارُ",10,"ر",1,0],["يَحُفُّ بها آسادُ خُفَّانَ تحتَها","سراحينُ إلا أنهنَّ سَراحِيبُ",11,"ب",1,0],["يَحُفّونَ مَحفوفَ القِصاصِ تَغولُهُ","مَآكِلُهُ عَن أَكلِهِم وَمُشارِبُه",12,"ب",2,0],["يَحُفّونَ مَرجُواً كَأَنَّ سُيوبَهُ","سُيوحُ العِراقِ غُزرُها وَوُفورُها",13,"ر",3,0],["يَحُفُّ خَليفَةَ الرَحمَنِ مِنهُم","ذَوُو الآراءِ وَالهِمَمِ العِذامِ",14,"م",1,0],["يَحُفُّ الوَفْدُ منك بأَرْيَحيٍّ","تَحُفُّ به السَّكينَةُ والوَقارُ",15,"ر",1,0],["يَحُفُّ بها منهم كهولٌ وفتيةٌ","كأنهمُ عِقْدٌ يَحُفُّ مُقلَّدا",16,"د",2,0],["يَحفَظُ في الجوعِ أَلفَ مَنفَعَةٍ","وَمِثلَها في مَضَرَّةِ البِطنَه",17,"ن",2,1],["يَحُفّونَ بي حَتّى كَأَنّي لَدَيهِمُ","حَبيبٌ مُفَدّى أَو مَليكٌ يُمَلَّكُ",18,"ك",1,0],["يَحفَظُ العَهدَ وَلا يَس","مَعُ في الخِلِّ المَلاما",19,"م",2,0],["يَحْفَظْنَهُ ويَذُدْنَ عن مَمنوعِهِ","شَهواتِ كلِّ مُخادِعٍ فَتَّاكِ",20,"ك",1,0],["يَحفُفنَ أَحوَرَ كَالغَزا","لِ أُمِرَّ إِمرارَ العِنانِ",21,"ن",1,0],["يَحفِزُ دَفّاعاً كَطَردِ الصَردِ","حَفزَ اللاواذِيِّ عُبابَ المَدِّ",22,"د",1,0],["يَحُفُّهُ جانِبا نيقٍ وَتُتبِعُهُ","مِثلَ الزُجاجَةِ لَم تُكحَل مِنَ الرَمَدِ",23,"د",1,0],["يحْفِزُكَ الإِيمَان بِالحقِّ وَمَا","تَثْيِنكَ عَنْهُ صَوْلَةٌ لِعَادي",24,"د",2,0],["يحف به كل أبن عم إذا رنا","إلى الحي ردت مقلتيه المدامع",25,"ع",1,0],["يحفون محفوف القصاص تغوله","مآكله عن أكله ومشاربه",26,"ب",2,0],["يَحُفُّ خَليفَةَ الرّحمَنِ مِنهُمْ","ذَوُو الآرَاءِ، وَالهِمَمِ العِظامِ",27,"م",1,0],["يحفى من المشي في الرضاع فإن","عُولج منه رأيتَه أصغَرْ",28,"ر",1,0],["يحف به من تَوْءم الروض نرجِس","تناهَى سنا مُبْيضِّهِ فوق تَخْليقه",29,"ق",2,0],["يحفّه نَيْلَوْفَرٌ سابح","في الماء لا يُرْديه إغراق",30,"ق",1,0],["يَحُفُّها باِقلاءٌ نَبْتُها خَضِلٌ","شهِيَّةُ المُجْتَنى مَعْشُوقة الهيفِ",31,"ف",1,0],["يَحفِرُ بِالدَّبُّوسِ مِن ضَربَتِهِ","لِلقِرنِ قَبراً في مَجالِ المَعتَرَك",32,"ك",1,0],["يحفظ حقَّ غَيبتِك","يَصونُ ما في عَيبتك",33,"ك",1,0],["يَحُفُّ بها من سِرِّ قَيْسٍ فَوارسٌ","تَخُبُّ بهمْ خَيلٌ لوجْهِ الفلا تَغْطو",34,"ط",2,0],["يَحفَظُ الدِّينَ والمروءةَ في كُلْ","لِ مُقامٍ حِفْظَ العِقالِ الشَّرودا",35,"د",2,0],["يَحْفَظُ في خدمتِه الرَّسْمَ فلا","يَبْدو له في الطِّرْسِ غيرَ ساجد",36,"د",1,0],["يحفظ ما في الدار حفظ حاذق","وجنسه صرف كما ذكرته",37,"ت",2,0],["يَحُفُّه كل مَحفوفٍ مَواكِبُهُ","عِزّاً وَيخدمه ذو الجند وَالخَدَمِ",38,"م",1,0],["يَحُفُّ بأشنب الأَنياب أَحوى","كَأَنَّ رُضابَهُ ذوبُ الصَقيعِ",39,"ع",1,0],["يَحِفُّ بِها في الظَعن مِن سِرِّ عامِرٍ","بدورُ دُجى هالاتُهن خُدورُها",40,"ر",3,0],["يَحفِفنَ أَغيد يَغتَدي داءَ الهَوى","وَيَروح بَينَ مَروطهِ وَبُرودِهِ",41,"د",2,0],["يحفظُك الحافظُ من كيد العدى","وكانَ حصناً حفظه حصينا",42,"ن",2,0],["يحفظ عهد اللّه في المصطفى","وآلهِ الفرّ وهم خير آل",43,"ل",1,0],["يحفزها سائق عنيفٌ من ال","خوف وفحلٌ سياطُهُ العَذمُ",44,"م",1,0],["يحفظهم خائنين عهدي ودَا","نِين وفي وُجدِهم وإن عَدِموا",45,"م",3,0],["يحفِزهُ الضيمُ فتنبو به","مضاجعُ الغيدِ ولينُ المِهادْ",46,"د",1,0],["يَحفِزها من مثله سائقٌ","يَضِلُّ خِرّيتُ الفلا وهو هادْ",46,"د",1,0],["يحفظ الصاحبَ الخؤونَ وفاء","ثمَّ ينسى أفعالهُ بعدُ قبلا",47,"ل",2,0],["يحفظ قلبي ديناً هواك كما","ضيَّع سمعي من قبلها عذلك",48,"ك",1,0],["يَحُفّهُ نَرجِسٌ طابَت رَوائِحُهُ","فَلَيسَ يَصلُحُ إِلّا أُختَ نَكهَتِهِ",49,"ت",2,0],["يحفُّونَ بالبزلِ الحراجيجِ سُهَّماً","اليها وبالجُردِ العناجيجِ ضُمَّرا",50,"ر",2,0],["يحفر الشاعر في كفيه قبرا","إن تكلم !",51,"م",1,0],["يَحفى بيَ الكونُ شرقهُ والشْ","شمالُ والغربُ والجنوبُ",52,"ب",1,0],["يَحفِزُها الطَّعنُ فلو سامَها","دخولَ خرقٍ ضيّقٍ مرّتِ",53,"ت",1,0],["يحفظ من طوفان وسواسه","سفينة كان بها حفظ نوح",54,"ح",1,0],["يحفها سبطا النبي المؤتمن","في موكبيهما الحسين والحسن",55,"ن",1,0],["يحفه سندس من خضرة نضرت","والزهر ما بين منثور ومنضود",56,"د",1,0],["يحفظ الشعب لكم كل يد","أنقذته من نيوب العدم",57,"م",1,0],["يحفظُ الشنُّ ماءَهَ ما عَدَتْهُ","دِقَّتُ السيرِ واتساعُ الخُرْزَه",58,"ز",2,0],["يَحفِزُها زَأْرٌ كَضرْبِ الطَبْلِ","بَيْنَ مِجَذَّاتِ الرَجاجِ العُصْلِ",59,"ل",1,0],["يحفّه من بني نبهان كل فتى","مكرّم برداء الفَضل مشتملِ",60,"ل",1,0],["يحفّه كأسود الغاب من يمين","شمُّ العرانين في يوم الوغى صُبُرُ",61,"ر",1,0],["يَحُفُّكَ مَصحوباً بِأَلفَي تَحِيَّةٍ","رَوائِحُهُ لِلمِسكِ تَهدي له نَشرا",62,"ر",2,0],["يحفُّ بها الزَّهرُ ذاكي الأري","جِ فَتسحبُ بالعِطرِ أَردانَها",63,"ن",3,0],["يحففن هيلاهوت لما أَقبلت","إِقبال يوسف حوله الأَسباط",64,"ط",1,0],["يحفظ الغيد اللّواتي جلن في","حلبة الإحسان شوطاً أريحيا",65,"ي",2,0],["يَحفِزُهُ رَعدٌ وَبَرقٌ على","أَرجائِهِ مرتَجِزُ الأَزمَلِ",66,"ل",1,0],["يَحفَظُ ما أَوصى بِهِ أَبوهُ","لا يَتَخَطّاهُ وَلا يَعدوهُ",67,"ه",1,0],["يحفظك مِنْ علّق نجومه عناوين","مِنْ هيبة امره مَا تطيح الأهلّه",68,"ل",2,0],["يحفظك رَبِّيْ مِنْ سموم المكايد","يحميك مِنْ خلقه عَلَى البيت حجّاج",69,"ج",1,0],["يَحُفُّ بهِ كَالبَدْرِ حَفَّتُهُ هَالَةٌ","وَلَكِنَّهُ لِلمُفسِدينَ يَهُولُ",70,"ل",1,0],["يحف خليتاه به شاكرا","بهم من مصطفى وخليمتين",71,"ن",1,0],["يحفظُ إحسانكم بشُكرٍ","ما ضَيَّعَ النِّعمةَ الشَّكورُ",72,"ر",1,0],["يحفه من جوالي الشامُ منتظمٌ","لو خف لم يبغِ جيدٌ غيرهُ عقدا",73,"د",2,0],["يحفها إخوة ما نال عرضهم","عيب ولا زندهم في حادث صلدا",73,"د",2,0],["يحفظ الغيب يخلص الود يرعى ال","عهد يغضي عن زلة الاخدانِ",74,"ن",1,0],["يحفُّ في الروض به بنفسج","يَنْفُح منه أرج العبير",75,"ر",1,0],["يحفه الملأ الأعلى ويخدمه","فقل ونافس بمخدوم لدى الخدم",76,"م",1,0],["يحفه أخواه الماجدان به","مع الوزير شريف النفس عاليها",77,"ي",3,0],["يحف به غض من النبت نوره","يرف رفيف البرق بين غيوم",78,"م",1,0],["يحف بنا الأهلون بيضاً وجوههم","ووجه الحسود الخائن العهد أسودُ",79,"د",1,0],["يحف بك العطف الحميدي كأنما","له منك نجم وهو للنجم هيدب",80,"ب",1,0],["يحف به آل تغنى بحبهم","ويقدمه رهط الملائك موكبا",81,"ب",2,0],["يَحفَونَ طَوراً فَأَبكي ثُمَّ يَرفَعُها","آلُ الضُحى وَالهِبِلّاتُ المَراسيلُ",82,"ل",1,0],["يَحُفّه النهرُ ثَجّاجٌ لَهُ زَجَلٌ","ينهلُّ تيارُه من بحرِه الخَضِم",83,"م",1,0],["يحفظ ما ضيع الأَنام لَنا","عهود فضل في الدهر نعهدها",84,"د",3,0],["يحف بهم من آل أحمد أصيد","تسير المنايا حذوه أينما سرى",85,"ر",2,0],["يحفظ ما في عيبتك","يصون ما في غيبتك",86,"ك",1,0],["يحفها الموج زخاراً فتحسبه","من حولها هضبات بينها جبل",87,"ل",1,0],["يحفرُ بالروقِ يُريقُ أفرعاً","مِمَّا عَرَاهُ من تهاويل الدُّجى",88,"ا",1,0],["يحُفُّها سوْسَنٌ غَضّ يُغازِلُه","بنَرْجِس بِنِطَافِ السِّحر مَوْليِّ",89,"ي",1,0],["يَحِفُّ بِهِ الهَولُ ذو الغَمَرات","فَتاهُ الحَبيبُ أَبو الأَزَمات",90,"ت",1,0],["يَحُفُّكَ يا أَخِيّ خفيُّ لُطفٍ","عَلى ما شِئتَ كُن تَحمَد خِتامَه",91,"م",2,0],["يحف بها من صنوف البها","أحاطت بها حجرات بها",92,"ه",2,0],["يَحُفّ بِهِ جُندٌ حَيارى لِفَقدِهِ","وَلَمّا يَسلوا المَشرِفيّ المُهَنَّدا",93,"د",2,0],["يَحفَظُ ما في سِفرِه لا يَفهَمُ","كَأَنَّهُ مِما طَواهُ طَلسَمُ",94,"م",1,0],["يحفظن عهد الصبا والدهر ذو غير","ما غير الدهر من تلك المواعيد",95,"د",1,0],["يحفظ المعبود فيه","صادقاً من كل طارق",96,"ق",1,0],["يحفظك ربي لين قلبك اراعيه","وأخفض جناح الذل ثم أنعرج لك",97,"ك",1,0],["يحفظ العهد حين نقضك للعه","د ويأتي الذي تحب مجدا",98,"د",2,0],["يَحفُّهُ بالكراماتِ التي سَلَبتْ","لُبَّ الأنامِ فلا يَخفى لِرائيهِ",99,"ي",2,0],["يحفى الزمانُ وهل يخْتال مُنتَعِلا","إلا إلَيْكَ فهَيَّا أنْعِلِ الزمَنا",100,"ن",2,0],["يحفها القوم قد ضمت جوانحهم","حر الجحيم على الأحرار أضغانا",101,"ن",2,0],["يحف به قومٌ على كل سابحٍ","مناهم مناواةَ العدى ولقاها",102,"ا",3,0],["يَحُفُّ بِعَرْشِكَ أَمْلاكُ نُورٍ","تُرَتِّلُ حَمْدًا مِرَارًا مِرَارا",103,"ر",2,0],["يحفظ السرَّ واللقاء ونجوانا","ويُرخي عليه فيحَ السُّدول",104,"ل",1,0],["يحفل الجنيص ويداري","واثج الخطوات لي يدله",105,"ل",2,0],["يحفض احقوق جيرانه وداره","إلى عاد الأجل يسبق كتابه",106,"ب",2,0],["يحْفَظُ في غوّاصَةٍ","في جُزْرِ واقِ الواقِ !",107,"ق",1,0],["يحفُّ به زهرٌ من العلم ناجمٌ","وروض خلالٍ بالفضائل مُعْشبُ",108,"ب",1,0],["يحفظ الناس من مجاع وقحط","فهو خصب قد فاق كل سخي",109,"ي",1,0],["يحفظ في المسالك","من مطلق المهالك",110,"ك",1,0],["يَحْفَى سؤالٌ فوقَ دربِ مُدَلِّسٍ","كالظل يَرْمَضُ عندَ رجلِ النَّاعلِ",111,"ل",1,0],["يَحِفُّنِي ضَوءُ مِشكاةٍ كَأَنَّ لَها","وَقُودَ زَيتٍ عَلَى زَيتُونِهِ نُورُ",112,"ر",1,0],["يحفظ قلبي دنيا هواك كما","ضيّع سمعي من قبلها عذلكْ",113,"ك",1,0],["يحفر الصبر على الباب ! وفي الباب","أرى للصبر تمثالاً عجيبا",114,"ب",2,0],["يحففن أغيدَ يقتني داءَ الهوى","ويروح بين مروطه وبروده",115,"د",2,0],["يحفُّهُ كلُّ محفوف بموكبهِ","عزّاً ويخدُمه ذو الجند والخدم",116,"م",1,0]]}