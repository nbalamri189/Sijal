{"poems":[[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[93,"روض إذا زرته كئيبا","https://www.aldiwan.net/poem8761.html","عموديه"],[58,"لا ومكان الصليب في النحر","https://www.aldiwan.net/poem58467.html","الكامل"],[83,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[90,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[234,"ناعورة أنة أنين الهوى","https://www.aldiwan.net/poem50993.html","السريع"],[370,"ألم ترني إذ ضمني البلد القفر","https://www.aldiwan.net/poem44508.html","الطويل"],[445,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[572,"غيث أتانا مؤذنا بخفض","https://www.aldiwan.net/poem69621.html","الرجز"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108425","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137926",""],[2451,"","https://poetry.dctabudhabi.ae/diwan/poem/103353","المجتث"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140054",""],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22535","الوافر"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105801","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103162","السريع"],[5302,"أقمت على نهري","https://www.poetsgate.com/ViewPoem.aspx?id=200064",""]],"verses":[["وَاقْحَمْ وَزَاخِمْ وَاتَّخِذْ لَكَ حَيِّزاً","تَحْمِيهِ يَوْمَ كَرِيهَةٍ وَطِعَانِ",0,"ن",1,0],["وَأُقحُوانٍ يُريكَ دُرّاً","وَجُلَّنارٍ حَكى اللَهيبا",1,"ب",2,0],["وأُقْحُوانٍ بِفِيكِ مُنْتَظِمٍ","على شَبيهِ الغَديرِ مِنْ خَمْرِ",2,"ر",1,0],["وَأُقحُوانُ الرُبى بَدا سَحَراً","وَأُقحُوانُ النُجومِ قَد ذَبُلا",3,"ل",2,0],["وأقحمتُ منها كلِّ هول يراعيا","وسيرت سفني في طلاب فنونه",4,"ه",1,0],["وَأُقحِمُها المَهالِكَ لا أُبالي","أَغَيّاً كانَ ذَلِكَ أَم رَشادا",5,"د",2,0],["وأُقحوانٍ كثغور المَهَى","مفترَّةٍ من بعد تعبِيسها",6,"س",3,0],["وأَقحمتُ مُهري حينَ صادفتُ غِرَّةً","على الطَّفِّ حتى قِيلَ قد عُقِرَ المُهرُ",7,"ر",1,0],["وَأَقحَمَها مُخطراتِ الحُروبِ","وأَحْبَسَها فِي سبيل السَّواءِ",8,"ا",2,0],["وَأُقْحُوَانٍ كاللُّجَيْنِ المَحْضِ","وَنَرْجِسٍ ذَاكي النَّسِيْمِ بَضِّ",9,"ض",1,0],["واقحمن العذابَ مثلي فاني","بوصال شفيت دائي الدفينا",10,"ن",2,0],["واقحم قومه فيها اعتباطاً","واوغرهم على الحلفاءِ صدرا",11,"ر",2,0],["واقحوانٌ أَنيقٌ","برودُهُ مُبيَضّه",12,"ض",2,0],["واقحوان كشبه الثغر منتظم","وخيزران وبان مثل قامته",13,"ت",2,0],["وأقحلُ حين أدخلُ في حشاها","قحول القدّ في عنق الأسيرِ",14,"ر",1,0],["وأقحوانٍ كأنّ وردته","دراهمٌ بينها دنانيرُ",15,"ر",1,1],["وأَقحمُ النار من وَجدي بهم وَهَجا","فإن أَعظم ما يبدي إلى رَجا",16,"ج",2,0],["وأقحمنا عليهم كلَّ خَرقٍ","رَكوبِ الخيل مضطلع النِضال",17,"ل",1,0],["وأقحوانٍ راقني نوره","إذ ظل يرنو بعيونٍ حسان",18,"ن",1,1],["وأقحمت كأسي بين أنفاسها التي","تعالت وقد ملأت من أعذب الراح",19,"ح",1,0]]}