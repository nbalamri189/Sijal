{"poems":[[29,"حي الديار بعاقل فالأنعم","https://www.aldiwan.net/poem5982.html","الكامل"],[53,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[26,"لعمرك والمنايا غالبات","https://www.aldiwan.net/poem24090.html","الوافر"],[47,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[47,"حلي سعاد غروض العيس أو سيري","https://www.aldiwan.net/poem63624.html","البسيط"],[47,"صبابة راح عنها غير مزجور","https://www.aldiwan.net/poem63640.html","البسيط"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[46,"أفنى وليلي ليس يفنى آخره","https://www.aldiwan.net/poem30504.html","الكامل"],[107,"منايا القوم في جلد البعير","https://www.aldiwan.net/poem44061.html","الوافر"],[83,"ردوا على طرفي النوم الذي سلبا","https://www.aldiwan.net/poem61557.html","البسيط"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[41,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[240,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[240,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[287,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[302,"يا غزالا يخفي سناه الغزاله","https://www.aldiwan.net/poem33189.html","الخفيف"],[336,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[401,"أقول لما أتاني هُلكُ سيدنا","https://www.aldiwan.net/poem599.html",""],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[466,"حي المهابة والندى قد أربيا","https://www.aldiwan.net/poem15156.html","الكامل"],[490,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[556,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[566,"ورأس أعداء شديد أضمه","https://www.aldiwan.net/poem27859.html","الرجز"],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105271","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99971","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119859","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69370","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69345","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53206","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53092","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58352","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205004","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65421","الخفيف"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26121","الطويل"],[3361,"","https://poetry.dctabudhabi.ae/diwan/poem/202180","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109912","الطويل"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36775","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102732","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102749","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102742","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33066","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133085","المديد"],[1536,"ضَحِكَ الدَّهْرُ بعد طُول عُبُوسِ","https://www.poetsgate.com/ViewPoem.aspx?id=85705",""],[4929,"تنقيب عن معدن الكرامة في صحراء الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=199178",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[3271,"عاهل الريف الثور","https://www.poetsgate.com/ViewPoem.aspx?id=104127",""],[5575,"بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=211266",""],[5747,"البث المباشر","https://www.poetsgate.com/ViewPoem.aspx?id=61658",""],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5839,"الشعر بعدك","https://www.poetsgate.com/ViewPoem.aspx?id=62048",""],[6093,"فَذَكَّرَ مَا قد شاءَ مِنها وأنَّثَا","https://www.poetsgate.com/ViewPoem.aspx?id=190106",""]],"verses":[["مِردى الحُروبِ إِذَ الحُروبُ تَوَقَّدَت","وَحَياً إِذا كَثُرَت عِمادُ الرُزَّمِ",0,"م",1,0],["مِردىً بأمثال القَوام مِرْدسا","يُرسلهُنَّ نِقْرساً فنقرسا",1,"س",2,0],["مِرْدَى خطوبٍ للملو","ك برأيهِ عَقْدٌ وحَلُّ",2,"ل",1,0],["مَرَدٌّ قَد يَرى ما كانَ فيهِ","وَلكِن إِنَّما يُدعى النَجيبُ",3,"ب",1,0],["مَرَدَّدٌ في المُلكِ جارٍ عَلى","طَريقَةٍ مِنهُ وَمِنهاجِ",4,"ج",1,0],["مُرَدَّدٌ في قَديمٍ مِن نَباهَتِهِم","كَالمُشتَري لَم يَكُن مُستَحدَثَ النورِ",5,"ر",1,0],["مُرَدَّدٌ في بُيوتِ المَجدِ يوضِحُ عَن","مُرَدَّدٍ مِن فِعالِ الخَيرِ مَكرورِ",6,"ر",1,0],["مُرَدَّدٍ يُرضيكَ في تَرديدِهِ","شُهرَتُهُ تُغنيكَ عَن تَحديدِهِ",7,"ه",1,0],["مُر دَهرَهُ بِالكَفِّ عَن جَنَباتِهِ","فَالدَهرُ يَفعَلُ صاغِراً ما تامُرُه",8,"ر",2,0],["مَرَدُّ الأمرِ في رفعٍ وخَفْضٍ","لهذِي الأرضِ في الحَدَثِ الكبيرِ",9,"ر",1,0],["مُرَدِّداً في الدُجى لَهفاً وَلَو نَطَقَت","نُجومُها رَدَّدَت مِن حالَتي عَجَبا",10,"ب",2,0],["مُرداً عَلى جُردٍ إِلى","أُسدٍ مُكالِبَةٍ كَوالِح",11,"ح",1,0],["مِردى حُروبٍ مِثلُهُ ساسَها","مُتلِفِ أَموالٍ وَغَنّامِها",12,"م",3,0],["مُرَدِّدُ جأشٍ في التراقي فضَحتَه","وكانتْ له أُمُّ المنيّةِ أفضَحا",13,"ح",2,0],["مُردّداً في قرار نفسهْ","ما أبشع الغيرة الوضيعهْ",14,"ه",1,0],["مرداء تشبهه ولا شجراء","وكأنه نون يراعك خطها",15,"ه",2,0],["مُردي حُروبٍ تَرى تَحتَ العَجاجِ لَهُ","في الخَيلِ وَقعاً كَوَقعِ النّارِ في الحَطَبِ",16,"ب",1,0],["مُردي حُروبٍ مُنذُ كانَ مُعاوِدٌ","لِلكَرِّ مَخشِيُّ القَناةِ إِذا رَدى",17,"د",2,0],["مردوا على بت الدسايس","بالجزيرة منذ حين",18,"ن",1,0],["مُردي العَدُوِّ بِكُلِّ ما","ماضي الحَدِّ مَطرورٍ صَقيلِ",19,"ل",1,0],["مُرَدي الكُماةِ وَعاقِرُ الكَوماءِ ما","تَنفَكُّ تَقطُرُ مِن دَمٍ شَفَراتُهُ",20,"ت",2,0],["مُردي الكُماةِ وَقائِدُ ال","جُردِ السَوابِقِ شُزَّبا",21,"ب",2,0],["مُردي الفَوارِسِ مِن سروجِ جِيادِها","يَومَ الوَغى بِمُثَقَّفٍ وَمُهَنَّدِ",22,"د",1,0],["مرَّ دَهرٌ وَالعَيشُ صفوٌ إِلى أَن","ذاقَ قَلبي طَعمَ الهوى فَحَلا لَه",23,"ل",2,0],["مِردَى حُروبٍ شِهابٌ يُسْتَضَاءُ بِهِ","كَمَا أَضَاءَ سَوَادَ الصَّخْيَةِ القَمَرُ",24,"ر",1,0],["مِردى حروب إذا ما الخيل ضرجها","نضحُ الدماء وقد كانت أفاريقا",25,"ق",2,0],["مرَدَّدٌ من مَطا عدنانَ في كرم ال","أصلابِ كنزٌ لهذا الأمر مذخورُ",26,"ر",1,0],["مَرَدَتْ على عين الدليلِ ورأيِهِ","فتخالُه فيها أضلَّ بما خَرَتْ",27,"ت",1,0],["مُرْدي القنا والدارعينَ فبأسُهُ","حتف العادة ضحىً وحتف الذُّبلِ",28,"ل",1,0],["مردى حروب ونور يستضاء به","كما أضاء سواد الظلمة القمر",29,"ر",1,0],["مردّدٌ كلَّ يومٍ في مواهبِهِ","متوَّجٌ منه بالنعماءِ مُنْتَطِقُ",30,"ق",1,0],["مردّدٌ في كلّ مكروهةٍ","أُنقلُ من نابٍ إلى ظُفرِ",31,"ر",1,0],["مُردِفُ جُولٍ لا يُخافُ هَدَمُه","إِذا أَناخَ أَو أَنى مُستَعظَمُه",32,"م",2,0],["مردي القسا ورفي الوغى","ومدّمر من قد كفر",33,"ر",1,0],["مُرَدَّدٌ في المجونِ قَمَّصَهُ ال","مُجونُ قُمْصَ المجونِ إذ قَمَّص",34,"ص",1,0],["مَرْدَوَاجُ بِسَيْفِ حَظِّكَ مَفْتُو","لٌ فَأَهْوِنْ بِذَاكَ منْ مَرْمُوسِ",35,"س",1,0],["مردد الجود ما اعتلت له منن","فينا ولا احتجبت عن عين راجيها",36,"ي",3,0],["مُرَدَّدٌ في أُصُولٍ غَيرِ ذاوِيَةٍ","مِنَ النَدى بَينَ مِرداسٍ وَمَيّاسِ",37,"س",1,0],["مُرَدَّدُ الحَمدِ في بَدوٍ وَفي حَضَرٍ","كَما تَرَدَّدَتِ الأَسماءُ في الأُمَمِ",38,"م",1,0],["مردي العتاة وفكاك العناة ومن","يروي العفاة بصافي ورده الشبم",39,"م",1,0],["مردي العتاة وفكاك العناة ومن","يلقى العفاة بتعظيم وتمجيد",40,"د",1,0],["مَردي الكَتائب إِذ قُريش تَحزبوا","وَأَخوا الحَرايب يَوم جدّل مَرحب",41,"ب",1,0],["مردِّداً رِفدَهُ مِراراً","حتى لَقَد خِلتُه كناسي",42,"س",2,0],["مرّ دهر عليه لم ير صبغاً","غير صبغ الغبار والأقدام",43,"م",1,0],["مرّ دهري ولم أُفر منهُ إلا","بالعدا والآداب والحرمان",44,"ن",1,0],["مُردَّفَةٌ تَدعوكُمُ وَشِمالُها","بِخِلفٍ وَفي إِثرِ الهُذَيلِ يَمينُها",45,"ن",3,0],["مردى حروب أدير الأمر حابله","إذ بعضهم لأمور تعتري جزر",46,"ر",1,0],["مُردافهُ ينحوهُ بالقلبِ حازمٌ","ويَشناهُ ذو جهلٍ تعرَّى من الأَدَب",47,"ب",1,0],["مُرَدَّفاتٍ عَلى أَطرافِها زَمَعٌ","كَأَنَّها بِالعُجاياتِ الثَآليلُ",48,"ل",1,0],["مُرَدَّفةً بَعَوطَبٍ","تُسلِمُهُ لِلعَطبِ",49,"ب",1,0],["مرد وخلته ما حط","من هممي ولا خفضا",50,"ض",2,0],["مردى الكماة إذا تشاجرت القنا","والنقع اقتم والكمى مدجج",51,"ج",1,0],["مردى الاشاوس بالأسياف مرهفة","من كل أبيض للأعناق بتاك",52,"ك",1,0],["مردى الأشاوس رواض الشوامس","فلاق القوانس بالهندية القضب",53,"ب",1,0],["مردى الألوف إذا الزحوف تقابلت","والبيض تثلم والقنا يتهبض",54,"ض",1,0],["مُردٌ وَأَطفالٌ تَخالُهُم","دُرّاً تَطابَقَ فَوقَهُ الصَدَفُ",55,"ف",1,0],["مر دهري ولم أقض وطر","أوعد النفس حيناً بعد حين",56,"ن",1,0],["مَرْدَوَاجٌ بِسَيْفِ حَظِّكَ مَقْتُو","لٌ فَأَهْوِنْ بِذَاكَ منْ مَرْمُوسِ",57,"س",1,0],["مَرَدُوا على حُبِّ النِّفاقِ ووطَّدُوا","للجبتِ حكمَ رقابِهِم توطِيدَا",58,"د",2,0],["(مردي الأعادي بسيف انتقام)","مضيع أحكام إتقانها",59,"ن",3,0],["مَرَدَتْ على كتفيكَ مِحراباً إذا","صلّتْ به يَفري حشاك سجودُها",60,"د",3,0],["مردْتِ قلبي مريرَ الحب فانكشفت","ساقٌ يزيد على وطآتها الوجعُ",61,"ع",1,0],["مردودها في ساعةٍ دقت على الوقت الصحيح","واللي يهمه موعده لازم يوقت ساعته",62,"ت",2,0],["مرد المقفي بيلفيويستوفي ،وتوفينه","بعدليله،ثلاثه،أربعه،عشره،شهر،شهرين",63,"ن",1,0],["مَرَدَوا على قمعِ الطفولةِ والمدى","والشّمسِ والمجدِ الّذي نتوسّدُ",64,"د",1,0],["مردٌ لِمَنْ مِنْ نُطْفَةٍ أوْجَدَ الوَرَى","فذَكَّرَ مَا قَدْ شَاءَ مِنْها وأنَّثَا",65,"ث",2,0]]}