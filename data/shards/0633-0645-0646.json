{"poems":[[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"قل لهاجيك مطنبا في الهجاء","https://www.aldiwan.net/poem8140.html","الخفيف"],[14,"أأي الناس آمن بعد بلج","https://www.aldiwan.net/poem38286.html","الوافر"],[51,"يا أيها المتسمن","https://www.aldiwan.net/poem63142.html","مجزوء الكامل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[112,"يارفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=8388",""],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[189,"نقطع الأوقات بالكلف","https://www.aldiwan.net/poem14589.html","المديد"],[387,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122685","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122681","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132267","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95376","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108189","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[5282,"سيرةٌ شعرية","https://www.poetsgate.com/ViewPoem.aspx?id=214654",""],[5956,"مِن أكثر الناس الألى غشوا الملا","https://www.poetsgate.com/ViewPoem.aspx?id=193526",""],[5956,"لله درُّكَ يا أبا العظَمات","https://www.poetsgate.com/ViewPoem.aspx?id=193717",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[6097,"قل للشّهيدة في النّقاب الأسودِ","https://www.poetsgate.com/ViewPoem.aspx?id=190678",""]],"verses":[["سُمْنيَ الخَسْف كلّه أَقبلِ الخس","فَ بشكر ولا تَسُمْني الجفَاءَ",0,"ا",2,0],["سَمِّني لا تزد فأنت إذا ما","قلتَ أفعى أنبأتَ عن رَقْشاءِ",1,"ا",2,0],["سَمِنَّ عَلى الرَبيعِ فَهُنَّ ضُبطٌ","لَهُنَّ لَبالِبٌ تَحتَ السِخالِ",2,"ل",1,0],["سَمَّنتَ نَفسَكَ لِلبِلى","وَبَطِنتَ يا مُستَبطِنُ",3,"ن",1,0],["سمّني إن شئت نوّحا","وإن شئت مغنّي",4,"ي",1,0],["سمني .. ياهاجري.. والا.. عبيدي... وأقحطاني..","كل منها... يرفع الرجال ويزود.. رصيده.....",5,"د",2,0],["سِمني بِمَيسَمِ نُعماكَ الَّتي غَمَرَت","غَيري فَما تُغفِلُ الأَيّامُ مَن تَسِمُ",6,"م",1,0],["سِمَنُ المهزولِ مَهْلَكةٌ","يُقْنِع المعجوفَ بالعَجَف",7,"ف",1,0],["سَمِنَت فَاِستَحَشَّ أَكرُعُها لا الن","نَيُّ نَيٌّ وَلا السَنامُ سَنامُ",8,"م",1,0],["سمنت ونرجو عنك نرجع بالرضى","لما شفعت لنا ونحن هزالها",9,"ل",3,0],["سَمِنَت بِبِرِّك واستَفادَت بالقَنا","عَجَفاً فَآيُكَ بالسَمينِ الأعجَفِ",10,"ف",1,0],["سَمِنَت بفَضلِكَ هِمَّتي وَعَجَفتُ مِن","رُوحي فَكنتُ أنا السَّمينَ الأعجَفا",11,"ف",2,0],["سمنى بصوغك جاعلا من نصفها","واعطف بلا حد ووكد واعطف",12,"ف",1,0],["سمنة من بني النعيم أتتنا","طعمها ريحه كما البخور",13,"ر",1,0],["سمنا يا عذول بالعشاق","نحن نهوى بيض الطلى والتراقي",14,"ق",2,1],["سمنت انفسها من ماله","فغدا الناس جلوداً وعظاما",15,"م",2,0],["سُمْ نَفْسَكَ العلياءَ واسمُ بها","في بغيةِ الدُّنيا عن الوسمِ",16,"م",1,0],["س١:مَن أنتَ في دُنيا القَريضِ ومَن بهِ ؟","ج :إبنُ التُرابِ وسَوفَ أمضِي فيهِ",17,"ي",2,0],["س٨: مَنْ مِنْ كبار النظمِ تَرضىٰ شِعرَهُ؟","ج : هُم كالنُجُومِ تُضيئ ليلَ التِّيهِ",17,"ي",2,0],["سمّنتني لكنه قد سمّني","فرجعتُ مهزولاً نخاعي شاردُ",18,"د",1,0],["سمَّنْتني وفق المنى يا خالدي","أدعو إليك بأحسن الصِّحَّاتِ..",19,"ت",1,0],["سمِنتْ أمانينا وغارَ الفيلُ","لكنما تحقيقَها مهزولُ",20,"ل",1,0],["سَمِنَتْ جيوشُ الذُّلِّ من علْفٍ لها","وكذاك يسْمَنُ مُتْخَمٌ إن يَرْقُدِ",21,"د",1,0]]}