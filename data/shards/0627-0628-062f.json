ونهنَّ حجابُ","https://www.poetsgate.com/ViewPoem.aspx?id=33307",""],[90,"صورة للخواطر!","https://www.poetsgate.com/ViewPoem.aspx?id=179131",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[90,"النقمة","https://www.poetsgate.com/ViewPoem.aspx?id=178955",""],[45,"مِيلُوا إلى الدّارِ مِنْ لَيْلَى نُحَيّيهَا","https://www.poetsgate.com/ViewPoem.aspx?id=31648",""],[45,"قُولُوا لِسرْجَسَ يَابْنَ القَحْبَةِ الشَّبِقَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=33098",""],[55,"َأَبدى سَرائِرَكِ الظاعِنونا","https://www.poetsgate.com/ViewPoem.aspx?id=7940",""],[91,"الفقير","https://www.poetsgate.com/ViewPoem.aspx?id=53421",""],[46,"قد وعظتْني بكَ اللياليº","https://www.poetsgate.com/ViewPoem.aspx?id=18361",""],[99,"مهرجة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=362&r=&rc=67",""],[43,"أمن ازديارك في الدجى الرقباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5432&r=&rc=3",""]],"verses":[["أَبَدَلٌ مِنَ الشَبابِ لا بَدَل","سِرعانَ ما رَقَّ الأَديمُ وَنَغِل",0,"ل",1,0],["أَبدَت خَبِيَّ المَجدِ طَلعَتُهُ","وَأَذاعَ سِرَّ المَجدِ مَنطِقُهُ",1,"ق",2,0],["أُبدي التَصامُمَ عَنُه حينَ أَسمَعُهُ","عَمداً وَقَد أَبلَغَ الناعونَ أَسماعي",2,"ع",2,0],["أَبَداً عَلَيكَ وَأَدمُعٌ مَسفوحَةٌ","إِن لَم يُراوِحها البُكاءُ يُغادِها",3,"د",3,0],["أَبَداً يَدحو بِهِ الغَي","يُ إِلى الأَمرِ المُريبِ",4,"ب",1,0],["أُبدي التَجَلُّدَ لِلعَدوِّ وَلَو دَرى","بِتَمَلمُلي لَقَد اِشتَفى أَعدائي",5,"ي",1,0],["أَبَدنا جَمعَهُم لَمّا أَتَون","تَموجُ مَواكِبٌ إِنساً وَجِنّا",6,"ن",2,0],["أَْبدَتْ مَحَبَّتكَ الْمُلوكُ فَإِنَّ مَنْ","وَالاَكَ وَالَى اللَّهَ والإِسْلامَا",7,"م",2,0],["أبْدَى رُسومَ العِلْمِ بعْدَ عَفائِها","وأعادَ وَجْهَ الحَقِّ ذا إبْهاجِ",8,"ج",1,0],["أَبْدَى عَلَيْهَا الْمَزْجُ دُرَّ حَبَابِهِ","فَتَخَالُهُ دُرّاً عَلَى لَبَّاتِهَا",9,"ت",3,0],["أَبْدَى لِدَاعِي الْفَوْزِ وَجْهَ مُنِيبِ","وَأَفَاقَ مِنْ عَذْلٍ وَمِنْ تَأَنِيبِ",10,"ب",1,1],["أَبْدَيْتَ مِنْ تَقْوى الإِلاَهِ سَرِيرَةً","يُحْبَى مَقَامُكَ فَضْلَهَا وَيُثَابُ",11,"ب",1,0],["ابدأ بِنَفسِكَ وَانَها عَن غِيِّها","فَإِذا انتَهَت عَنهُ فَأَنتَ حَكيمُ",12,"م",1,0],["أَبدَعَت ما أَبدَعَت ثُمَّ اِنطَوَت","وَعَلى أَسرارِها الدَهرُ خَتَم",13,"م",1,0],["أَبَداً تَراهُ وَصَدرُهُ","في بَطنِهِ أَو ظَهرِهِ",14,"ه",1,0],["أَبَداً يَكتَسي العَواري مِنَ النا","سِ وَمَن يَكتَسي العَوارِيَ عاري",15,"ي",1,0],["أَبدَعتَ فيما تَنتَحيهِ فَأَبدَعَت","فيكَ المَدائِحُ أَيَّما إِبداعِ",16,"ع",1,0],["أَبَداً أُرَقّحُ كَي أُرَقّعَ خَلةً","مِن حالَةٍ مِثلَ الرَدا المُتَداعي",16,"ع",2,0],["أَبدَيتَ لي مِن أَفانينِ القِلى عِبَراً","أَرسَلنَني في أَحاديثِ الهَوى مَثَلا",17,"ل",2,0],["أَبدَعَها خاطِرٌ بَدائِعُهُ","في النَظمِ حازَت جَلالَةَ الخَطَرِ",18,"ر",1,0],["أَبدى لِيَ الجَفوَةَ مِن بَعدِهِ","مَن كانَ مِن ذي رَحِمٍ أَو جِوار",19,"ر",1,0],["أَبَداً فِي الصَّفَاءِ مِرْآةُ صِدْقٍ","لِصَفَاءِ فِي النَّفْسِ غَيْرِ مَشْوبِ",20,"ب",1,0],["أبدعت في ديوان شعرك","فجعلته مرآة عصرك",21,"ك",1,1],["أَبَداً يَظَلُّ عَلَى مِثَا","لِكَ فِي سَوَادِ القَلْبِ حَانِي",22,"ي",1,0],["أَبْدِعْ بِحَشْدِهِمُ الَّذِي انْتَظَمَ العُلَى","فِي مَوْضِعٍ وَجَلا الحِلَى فِي آنِ",23,"ن",1,0],["أَبْدَيْتَ فِي كُلِّ مَا تَوَلَّيْ","تَ حِكْمَةً تُصْلِحُ الشُّؤونَا",24,"ن",2,0],["أَبدْعٌ وَالمَسَافَةُ تِلْكَ أَنَّا","سَمِعْنَا الرَّعْدَ صَارَ إلى أنِينِ",25,"ن",1,0],["أَبْدَتْ بَوَاكِيرُ الجِنَانِ","زِينَاتِهَا قَبْلَ الأَوَانِ",26,"ن",1,1],["أَبْدَتْ مَبَادِئُهُ الْحُسْنَى تَوَالِيَهُ","لَهُمْ فَظَنُّوا فَكَانَ الْحَقَّ ظَنُّهُمُ",27,"م",1,0],["أَبَداً فِي ضَمِيرِنَا طِيبُ ذِكْرَا","كَ وَفِي الْفِكْرِ وَجْهُكَ المَرْسُومُ",28,"م",1,0],["أبداً يُوَالِي نُصْحَهُ بِتَلَطفٍ","فَيفُوزُ مِنْهُ بِنُفْرَةٍ وَتَجَهُّمِ",29,"م",1,0],["أَبدَ الدَهرِ خَلفَهُ","فارِسٌ في المُؤَخَّرَه",30,"ر",2,0],["أبدى لها وجهُ النَّهار طلاقةً","وافترّ من ثغر الأقاح مُقبَّلُ",31,"ل",1,0],["أبديت من حسن الصنيع عجائباً","تُروي على مرِّ الزمان وتنقلُ",32,"ل",1,0],["أبداً سماؤك وجهها متلوّن","فأراه يبسم تارة ويقطّب",33,"ب",1,0],["أبديه منقبضاً منه على شَجَن","فيملأ الليل أرناناً وينبسط",34,"ط",1,0],["أَبُدِّلَ اللَيلُ لا تَسري كَواكِبُهُ","أَم طالَ حَتّى حَسِبتُ النَجمَ حَيرانا",35,"ن",2,0],["ابدأن لا لوَّ فيما قال ناعتها","من صنعة ضامت الولدان في الحلبِ",36,"ب",1,1],["أبداً أميلُ إلى لقاه وإن جفا","وتحنّ أحشائي له وإن اعتدى",37,"د",2,0],["أبداه بالذكرِ فأعجب لمن","يبدأ بالساكنِ بنيانه",38,"ن",2,0],["أبداً به أتلو الشجون فليتها","عن نافع عن أنَّةِ المتأوِّه",39,"ه",1,0],["أبدت طرائفَ شتّى من زَواهرها","حُمراً وصُفراً وكلٌّ نبتُ غبراءِ",40,"ا",2,0],["أبداً حتى يملَّ العطايا","مُستميحوها ويَفْنى الحسابُ",41,"ب",1,0],["أبديتَ صفحة قسوةٍ وخشونةٍ","من دون تافِه نَيْلك المطلوبِ",42,"ب",1,0],["أبداً تراه راكعاً في ثَردةٍ","مأدومةٍ بإهالةِ المصلوبِ",42,"ب",1,0],["أبْدى وُجُوهاً غيْرَ مَقْبُوحَةٍ","في زَمَن ليْسَ بمقبوحِ",43,"ح",1,0],["أبَّدُوا الملْكَ فهو ملكُ خُلودٍ","لا كعهدِ الكفُورِ مُلْكُ بُيُودِ",44,"د",1,0],["أبداً عليه هزيمةٌ","في الحرب مُبْدأة مُعادَهْ",45,"د",2,0],["أُبِّدَ إحسانُها بحسْنٍ","هِي الأمانيُّ بل تزيدُ",46,"د",1,0],["أبداً عِرسُك وقفٌ","لصديقٍ أو لجار",47,"ر",1,0],["أبديتُ في أُوليات لؤمك ما","قدرتُ في أخرياته الأخرِ",48,"ر",1,0],["أبديتَ لي حبْلَ التكبُّرِ فاحتقبْ","عدلاً تبيتُ له بليل مخاض",49,"ض",1,0],["أبداً نحنُ في خلاف فمنّي","فرطُ حبٍ ومنك لي فرط بُغضِ",50,"ض",1,1],["أبداً عند ابن معدان فحل","يُشتَرى جهراً وأنثى تباع",51,"ع",1,0],["أبدرَ السماءِ وغيثَ السما","ءِ لا زلتَ حيّاً مُدالاً مُديلا",52,"ل",2,1],["أبدا تُضحي وألحا","ظك من وجهي صيامُ",53,"م",1,0],["أبدي ظواهرَ تحتَها إنْ فُتِّشتْ","مني بطائنُ تكذُبُ الإيهاما",54,"م",2,0],["أبدَلْتَني بُعداً بقربِ الذي","قد كان من حُزنيَ سُلوانا",55,"ن",2,0],["أَبَداً في نَضارَةٍ لا يَجُفُّ العُش","بُ فيها وَلا يَغيضُ الماءُ",56,"ا",2,0],["أَبَداً يُسَرُّ بَنو الزَمانِ وَما لَهُم","حَظٌّ كَغَيرِهِم مِنَ السَرّاءِ",57,"ا",2,0],["أَبَداً يَرُشُّ صُخورَهُ بِدُموعِهِ","أَتُراهُ يَغسِلُها مِنَ الأَوزارِ",58,"ر",1,0],["أَبَداً يَرى بُعدي وَأَطلُبُ قُربَهُ","وَلَو أَنَّني جارٌ لَهُ لَتَحَوَّلا",59,"ل",2,0],["أَبَداً أَزيدُ مَعَ الوِصالِ تَلَهُّفاً","كَالعِقدِ في جيدِ المَليحَةِ يَقلَقُ",60,"ق",1,0],["أَبَداً تَحِنُّ إِلى الطِرادِ جِيادُهُ","فَلَها إِ