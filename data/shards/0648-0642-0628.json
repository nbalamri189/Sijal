s://www.aldiwan.net/poem56204.html","المتقارب"],[459,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[459,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[466,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[483,"صار بفؤاد الوجد نحو ربوعها","https://www.aldiwan.net/poem24440.html","عموديه"],[501,"أحيباب قلبي والمحبة دينها","https://www.aldiwan.net/poem37631.html","الطويل"],[501,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[516,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[539,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[539,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[539,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[541,"دع البخلاء إذا شحوا وضنوا","https://www.aldiwan.net/poem56854.html","الكامل"],[552,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[552,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[552,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[552,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[562,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[563,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"كتاب كريم جاءني بعد فترة","https://www.aldiwan.net/poem2721.html","الطويل"],[576,"أموت بمن لو مر ذيل قميصه","https://www.aldiwan.net/poem2980.html","الطويل"],[576,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[576,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"],[576,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["وَقَبلَكَ ضاعَ حَقّي في اللَيالي","كَما ضاعَ الغَريبُ أَوِ اليَتيمُ",0,"م",1,0],["وَقَبلَ ما كُبَّت لَها","قِبابُ عادٍ وَإِرَم",1,"م",1,0],["وَقَبلَكَ أَوقَرَ الأَيّامَ مَجداً","وَأَوضَعَ بِالعُلى حَتّى أَكَلّا",2,"ل",2,0],["وَقِبابٍ كَأَنَّما رَفَعوا مِن","ها لِمُستَرشِدِ الظَلامِ مَنارا",3,"ر",2,0],["وَقَبٌ عاقِرٌ في الدَه","رِ مِن داءٍ يُخامِرُه",4,"ر",2,0],["وَقِبابُ المُلكِ في أَعطانِها","رُفِعَت مِنكُم بِعاديَّ العَمَد",5,"د",1,0],["وَقَبرُكِ الصَونُ مِن قَب","لِ أَن يَضُمَّكِ تُربُ",6,"ب",1,0],["وَقَبراً بِالطُفوفِ يَضُمُّ شِلواً","قَضى ظَمَأً إِلى بَردِ الشَرابِ",7,"ب",1,0],["وَقَبلَ اليَومِ ما أَغمَدنَ عَنّي","مِنَ الأَيّامِ نائِبَةً وَنابا",8,"ب",2,0],["وَقَبضيِ بِكِلْتا راحَتَيَّ عَلى الحَشَى","وَرَمي بإِحدى مُقلَتَيَّ إِلى الرَّكبِ",9,"ب",1,0],["وَقِبابُها تَحوي بُدوراً طُلَّع","مِن كُلِّ فاتِنَةٍ بِطَرفٍ أَحوَرِ",10,"ر",1,0],["وَقَبلَكِ ساعَيتُ في رَبرَبٍ","إِذا نامَ سامِرُ رُقّابِها",11,"ب",3,0],["وَقَبلَهُم غالَتِ المَنايا","طَسماً وَلَم يُنجِها الحِذارُ",12,"ر",1,0],["وَقِبابٍ مِثلِ الهِضابِ وَخَيلٍ","وَصِعادٍ حُمرٍ يَقينَ السِماما",13,"م",2,0],["وَقَبَسنا مِن نورِكُم فَكَتَبنا","وَأَجَدنا نِثارَنا وَالنِظاما",14,"م",2,0],["وَقَبرٌ بِأَرضِ الجَوزَجانِ مَحَلُّهُ","وَقَبرٌ بِباخَمرا لَدى العَرِماتِ",15,"ت",1,0],["وَقَبرٌ بِبَغدادٍ لِنَفسٍ زَكِيَّةٍ","تَضَمَّنَها الرَحمَنُ في الغُرُفاتِ",15,"ت",1,0],["وَقَبرٌ بِطوسٍ يا لَها مِن مُصيبَةٍ","تُرَدَّدُ بَينِ الصَدرِ وَالحَجَباتِ",15,"ت",1,0],["وقبر النبوة في يثربا","ومثوى ضجيعَيْه منوى التُقى",16,"ق",2,0],["وَقَبلَكَ ما أَخزى الأُخَيطِلُ قَومَهُ","وَأَسلَمَهُم لِلمَأزِقِ المُتَلاحِمِ",17,"م",1,0],["وَقَبيلٌ مِن عُقَيلٍ صادِقٌ","كَلُيوثٍ بَينَ غابٍ وَعَصَل",18,"ل",1,0],["وقبر أبي داود حيث تشققت","عليه المآلي عصبُها وسبيبها",19,"ب",3,0],["وقبِّل الأرضَ في بابِ العلاءِ فقدْ","حكيتَ من أجلِ هذا الثغرَ والشنبا",20,"ب",2,0],["وقبلة بعثتها في الكرى شفةٌ","بالليل منك فهلاّ عاودت شفتي",21,"ي",1,0],["وقبلتها مصرية حلوةَ اللمى","أكرّرُ في تقبيلها السكّر المصري",22,"ر",2,0],["وقبلك لم تبصر بنو الشام وابلاً","من الغيثِ تهدِيه إلى الشامِ مصره",23,"ر",2,0],["وَقَبضٌ ثُمَّ بَسطٌ ثُمَّ مَحوٌ","وَفَرقٌ ثُمَّ جَمعٌ ثُمَّ طَمسُ",24,"س",1,0],["وقبل ذلكَ كانوا يَمْهَدُون له","وتلكُم القُرْبةُ الكبرى من القُرَبِ",25,"ب",1,0],["وقبيحٌ بعد الطلاقةِ والبشْ","ر بذي المجد نَبوةٌ واحتجابُ",26,"ب",1,0],["وقَبْلَ برِّك بي ما بَرَّني مَلكٌ","لا تملِكُونَ عليه حَلَّ معْقُودِ",27,"د",1,0],["وقبَّلتُ أفواهاً عِذاباً كأنها","ينابيع خمرٍ حُصِّبت لؤلؤ البحرِ",28,"ر",1,0],["وقبَّحتَ عندي صورةَ الحِرص والغنى","وحسنت عندي صورة اليأس والفقر",29,"ر",1,0],["وقبلَكَ ما نُصرتُ على ظلومٍ","وما أعملتُ أطرافَ الإلالِ",30,"ل",1,0],["وقبل ذلك بِرٌّ منكَ آنسني","حتى سلوْتُ عن الخُلان والوطنِ",31,"ن",1,0],["وقبيحٌ يجوزُ كلَّ قبيحٍ","رُقعةٌ من مُعاتبٍ لا تُصانُ",32,"ن",1,0],["وَقَبَّحتُم بِأَسماءٍ","وَحَسَّنتُم مُسَمّاها",33,"ا",3,0],["وَقَبيحٌ وَحَقِّكَ ال","صَبرُ عَن وَجهِكَ الحَسَن",34,"ن",1,0],["وقبَّلَهُ قُبَلاً صامِتاتٍ كما","يَلْثُمُ الموتُ وَرْدَ الغُصُون",35,"ن",1,0],["وقبَّلها قُبَلاً في الشِّفاهِ","تُعيدُ الشَّبابَ الَّذي قدْ غَبَرْ",36,"ر",1,0],["وَقَبلكُما ما أَودَعَ القَلبَ حَسرَةً","تُجَدّدُ طولَ الدَهرِ ثكلُ أَبي عَمرِو",37,"ر",2,0],["وقبلة فوق خد ناعم عطِر","أبهى من الورد في ظل الندى الغادي",38,"د",2,0],["وقبل حسين ما تكلم مرضع","ولا نال علياء البيان فطيم",39,"م",1,0],["وقبلك لم يُنم عمرَ الأنام","وقد سهرت رعيته الكرام",40,"م",1,0],["وقبل النصر نصر قد تجلى","عُلاً في العصر آثارا وجلّى",40,"ل",2,0],["وَقَبرٍ مَنوطٍ بِالجَلالِ مُقَلَّدٍ","تَليدَ الخِلالِ الكُثرَ وَالطارِفَ الجَمّا",41,"م",2,0],["وَقُبورُ مَوتى مِن شَبابِ أُمَيَّةٍ","وَكُهولِهِم لَم يَبرَحوا أَحياءَ",42,"ا",2,0],["وَقِباؤُهُ نَسجُ الهُنودِ فَهَل تُرى","دَفَنوا الزَعيمَ مُكَفَّناً بِقَبائِهِ",43,"ا",3,0],["وَقُبوراً في السَمَواتِ العُلا","نَزَلوا أَم حُفَراتٌ وَرَغاما",44,"م",2,0],["وَقِبابٍ مِن لازَوَردٍ وَتِبرٍ","كَالرُبى الشُمِّ بَينَ ظِلٍّ وَشَمسِ",45,"س",1,0],["وَقَبراً كادَ مِن حُسنٍ وَطيبٍ","يُضيءُ حِجارَةً وَيَضوعُ طينا",46,"ن",2,0],["وَقَبلَ الحَربِ حَربٌ مِنكَ كانَت","نَتائِجُها لَنا ظَهَرَت وَبانَت",47,"ا",3,0],["وَقُبورٌ تَحُطُّ فيها اللَيالي","وَيُوارى الإِصباحُ وَالإِمساءُ",48,"ا",2,0],["وَقَبلَ يَرى مِن جودِهِ ما رَأَيتَهُ","وَيَسمَعَ فيهِ ما سَمِعتَ مِنَ العَذلِ",49,"ل",1,0],["وَقَبَّلَ كُمّاً قَبِّلَ التُربَ قَبلَهُ","وَكُلُّ كَمِيٍّ واقِفٌ مُتَضائِلُ",50,"ل",1,0],["وَقَبضُ نَوالِهِ شَرَفٌ وَعِزٌّ","وَقَبضُ نَوالِ بَعضِ القَومِ ذامُ",51,"م",1,0],["وَقَبرٌ عَن أَيامِنِ بَرقَعيدٍ","إِذا هِيَ ناحَرَت أُفُقَ الجَنوبِ",52,"ب",1,0],["وَقَبرانِ في أَعلى النِباجِ سَقَتهُما","بُروقُ سُيوفِ الغَوثِ غَيثاً مِنَ الدَمِ",53,"م",1,0],["وَقَبرٌ حَماهُ الجودُ أَن تَنسُجَ الصَبا","عَلَيهِ وَأَن تَعفو عَلَيها مَعالِمُه",54,"م",2,0],["وَقَبيحٌ إِذا إِستَعَنتُكَ أَن أَب","غي مُعيناً عَلى الَّذي أَستَعينُ",55,"ن",1,0],["وَقَبلَكَ ما أَحمَت عَدِيٌّ دِيارَها","وَأَصدَرَ راعيهِم بِفَلجٍ وَأَورَدا",56,"د",2,0],["وَقَبلَكَ ما أَخزى تَميماً أُسَيِّدٌ","وَقَنَّعَهُم ما لَيسَ عَنهُم يُحَوَّلُ",57,"ل",1,0],["وَقَبلَكَ عَجَّلنا اِبنَ عَجلى حِمامَهُ","بِأَسيافِنا يَصدَعنَ هامَ الجَماجِمِ",58,"م",1,0],["وقبر خالد في حمصٍ نلامسه","فيرجف القبر من زواره غضبا",59,"ب",2,0],["وقَبلُ ما قَبَّلَتْ محاسِنُه","وَجْهي وَوَجْهُ السُّرورِ مُقتبِلُ",60,"ل",1,0],["وَقبِّل يَدَ الجاني الَّذي لَستَ قادِراً","عَلى قَطعِها وَارقُب سُقوطَ جِدارِهِ",61,"ر",2,0],["وَقَبيحٌ أَن يُذكَرَ النافِرُ الوَح","شِيَ مِنها وَيُترَكَ المَأنوسُ",62,"س",1,0],["وَقَبيحٌ فيهِ التَنَسُّكُ إِلّا","بَعدَ سِتّينَ حِجَّةً وَثَماني",63,"ن",2,0],["وقَبّلْتُ خداً تَرَى ورده","نضيراً يشق عن الياسمين",64,"ن",1,0],["وقَبّلوا من مذاكي خيله فَرحاً","حوافراً قد علا أرساغَها العفرُ",65,"ر",1,0],["وَقَبيلَةً يَدَعُ المُتَوَّجُ خَوفَهُم","فَكَأَنَّما الدُنيا عَلَيهِ مُطبِقُ",66,"ق",1,0],["وَقَبيحٌ بِأَن تُعَرِّضَ جِسمي","ما أَرى مِن مَصارِعِ العُشّاقِ",67,"ق",1,0],["وَقَبَّلتُ ما بَينَ المُحَيّا إِلى الطُلى","وَعانَقتُ ما بَينَ التَراقي إِلى الخَصرِ",68,"ر",1,0],["وَقَبَضتُ ذَيلي رَغبَةً عَن مَعشَرٍ","عوجِ الطِباعِ كَأَنّهُم أَضلاعُ",69,"ع",1,0],["وَقَبَّلتُ رَسمَ الدارِ حُبّاً لِأَهلِها","وَمَن لَم يَجِد إِلّا صَعيداً تَيَمَّما",70,"م",2,0],["وَقَبِلتُ الكَأسَ مِن يَدِهِ","فَاِجتَنَينا الوَردَ مِن عَنَمِ",71,"م",1,0],["وَقَبلي أَعيَتِ البُرحاءُ قَوماً","فَما وَفَتِ القُلوبُ وَلا العُيونُ",72,"ن",1,0],["وَقَبلَكَ أَبكاني تَحَمُّلُ مَعشَرٍ","كَرِهتُ مُقامي بَعدَهُم وَبَقائِيا",73,"ي",2,0],["وَقَبلَكَ ضاعَ شِعري في دِيارٍ","شَجاني مِن بَنيها ما شَجاني",74,"ن",2,0],["وَقَبَّلتُ وَجنَتَهُ بِالدُموعِ","كَما اِلتُقِطَت وَردَةٌ مِن غَديرِ",75,"ر",1,0],["وَقَبَّلتُ في التُربِ مِنهُ خُطىً","أُمَيّزُها بِشَميمِ العَبيرِ",75,"ر",1,0],["وَقَبولٌ لَو لَم يَفُز ما سِواهُ","لَتَفَشَّت بِهِ الأَماني الحَرارُ",76,"ر",1,0],["وَقَبَلتني مِثلَها قُبلة","ما زِلت اَستَنشق رَياها",77,"ا",3,0],["وَقُبَّةِ حاصِنٍ أَدخَلتُ رَأسي","وَمِعصَمَها المُوَشَّمَ قَد لَوَيتُ",78,"ت",1,0],["وقُبَّةُ مارستانَ ليسَ لِعِلَّةٍ","عليه وإن طالَ الزَّمانَ مُرُورُ",79,"ر",1,0],["وقَبيلَةً قَتّلْتَها وقَبيلَةً","أثكَلْتَها بالبَرْك في الأعطانِ",80,"ن",1,0],["وقُبّةُ الصَّندَلِ الحَمراءُ قد فُتِحَتْ","للجودِ أبوابُها والوَفْدُ يَستَبق",81,"ق",1,0],["وقبضتَ أرواحَ العِدى وبسَطْتَها","ما بينَ تَلْيينٍ إلى تَشْديد",82,"د",1,0],["وَقَبَّلتُهُ ظَهراً لِبَطنِن وَتارَةً","يَكونُ بِساطُ الأَرضِ بِالباطِنِ الظَهرُ",83,"ر",1,0],["وَقَبِّل يَدَ الجاني الَّذي لَستَ واصِلاً","إِلى قَطعِها وَاِنظُر سُقوطَ جِدارِهِ",84,"ر",2,0],["وقَبيحٌ بنَا وإنْ قَدُمَ العَهْ","دُ هَوَانُ الآبَاءِ والأجْدادِ",85,"د",1,0],["وقبلَها ما خَضعتْ وأذعنتْ","إِستِجةُ وطالما قد صَنعتْ",86,"ت",1,0],["وقَبِلَ الإمام ذاكَ مِنْهُ","فضلاً وإحساناً وسارَ عنهُ",86,"ه",1,0],["وقبلَهم في هذه الغَزاةِ","قد هُدِّمتْ مَعاقلُ العُصاةِ",86,"ه",1,0],["وَقَبيلٍ باتوا جَميعاً بليل","فإذا هم في صبحه أَشتات",87,"ت",1,0],["وقبّل كمّاً قبّل الأرض قبله","وكلّ كميٍّ واقفٌ متضائل",88,"ل",1,0],["وقبِّلْ ثرىً فيه امتزجنا أُبوَّةً","ونُسلِمُهُ لابنٍ لنا وحفيدِ",89,"د",1,0],["وقبّلت في لواءٍ تحت إمرَتهِ","من فتيةِ النيلِ مقداماً ومغوارا",90,"ر",2,0],["وَقبِّل شهيداً على أَرضِها","دَعا باسمِهَا الله واستُشهِدَا",91,"د",2,0],["وقَبْلَ اليوْم وَدّعَني مِراحي","وأنسَتْنِيهِ أيّاٌم طِوالُ",92,"ل",1,0],["وقبلك ما رأت عيني هموما","مدلّلة وأحزانا ملاحا",93,"ح",2,0],["وَقِبابُها تَحوي بُدوراً طُلَّعاً","مِن كُلِّ فاتِنَةٍ بِطَرفٍ أَحوَرِ",94,"ر",1,0],["وَقَبْلَهُ نَاءَ ذُو الأَيْدِ","وَهْوَ يَحْمِلُ نِصْفَهْ",95,"ف",2,0],["وَقَبَّلَهَا فَاسْتَلَّ جَوْهَرَ رُوحِهَا","وَأَبْقَى عَلى رَسْمٍ كَبَعْضِ الدُّمَى الغُرِّ",96,"ر",1,0],["وَقَبَسَاتٍ مِنْ هُدَى الأَسْفَارِ فِي","حَواَضِرِ الدُّنْيَا وَفِي البَوَادِي",97,"د",2,0],["وَقَبْلَهُ كَانَ جُوعٌ لاَ اكْتِرَاثَ لَهُ","وَكَانَ عُرْيٌ وَلَمْ يُسْتَرْ وكانَ حَفَا",98,"ف",2,0],["وقبلَ اليومِ ما عَرَفُوا وَذَاقُوا","وَقَائِعُنَا بِهَا يُشفَى الغَلِيلُ",99,"ل",1,0],["وقبل أن أرقد","ودعيني",100,"ن",2,0],["وَقُبحُ شَتاتٍ بَعدَ حُسنِ تَأَلُّفٍ","وَوَحشَةُ قَبرٍ بَعدَ أُنسِ مَغانِ",101,"ن",1,0],["وَقَبَّلت الحورُ أَجفانهُ","وَإِذ أَهدَرَت دَمَهُ سُفَّكا",102,"ك",2,0],["وقبل أن يرنو إلى","شيء يرى ما أتفهه",103,"ه",1,0],["وقبرٌ كمحرابِ الصلاةِ مطهَّرٌ","عليه نعيمٌ وارفٌ وثواب",104,"ب",1,0],["وقبل النُّجح إخْفَاقٌ وثَان","وأول مِشْيَة الطِّفل العثَار",105,"ر",1,0],["وقَبْلَكُمُو بني هامانُ صرحًا","فكادَ النجمُ يدركُهُ انهيار",105,"ر",1,0],["وقُبُّراتٌ حُوَّمٌ تَجتبي","سنابلاً يَحْوِينَ غيرَ الحُبوب",106,"ب",1,0],["وقبلَك غمّت عزةٌ رَبَّ كندةٍ","وشرَّد صونُ العرض رَبَّ الخَورَنق",107,"ق",1,0],["وقِباحُ أشباح لمُرتَعِدي الحَشَا","بَرمٌ بها ، ولمُحرِبين هُيام",108,"م",1,0],["وقبَّلتُ صدرَك حيثُ الصَّميم","مِن القلب ، مُنْخَرقاً ، يُخرَم",109,"م",1,0],["وقبلاً قال ذا أدبٍ ظريفٍ","قِرى الأضياف قبل الزاد خُلقُ",110,"ق",1,0],["وقبلة حمراء مثل اللّظى","وقبلة بيضاء مثل اليقين",111,"ن",1,0],["وقبّة تحرس كنز الدجى","كأنّها في الغابة الديدبان",112,"ن",1,0],["وقبور إخواني وما أبقى من السيف الضراب","الصامتات وللطيور على مشارفها اصطخاب",113,"ب",1,0],["وقبلَكِ لم أوجَدْ فلمّا مرَرْتِ بي","تساءَلتُ في نفسي ترى كُنتُ من قَبلُ ؟",114,"ل",1,0],["وقبلَ قِيلِ الناس يا غلامُ","فُطِمتَ مذ آن لك الفِطَامُ",115,"م",1,0],["وقباح العروق مهما اصطفاهم","دهرهم لا تصرف اليهم بالا",116,"ل",2,0],["وقبلي الارض عني مثلما فعلت","في حالة البعد روح الغوث ذي الشرف",117,"ف",1,0],["وقبل ردة طرف العين من كرم","يقلب الأمر من ضيق إلى فرج",118,"ج",1,0],["وقبل في فم الإخلاص فكراً","ثرى الأعتاب بالوجل الوفير",119,"ر",1,0],["وقبيحٌ أن تسحب الذيل مختا","لاً وتشي على رقاب الصحاب",120,"ب",1,0],["وقبِّل يد الأقوى ولا تعصينه","فإنك إن قاوَمْتَه فهو يغلِبُ",121,"ب",1,0],["وَقَبلَ أن تَقرَأَ كَبِّر سَبعَا","في الرَّكعَةِ الأُولَى والغِ الرَّفعَا",122,"ع",2,0],["وَقَبلَ قَلعَتِهِ دامَت مُمَنَّعَةً","ما إِن رَأَينا سَماءً تُمطِرُ الذَهَبا",123,"ب",2,0],["وَقَبلَكَ ما خِلتُ البُدورَ لِنائِلٍ","تُرَجّى وَلا زُهرَ الكَواكِبِ تُصهَبُ",124,"ب",1,0],["وَقَبيحٌ أَن أَدَّعي الفَضلَ فيها","بَعدَ أَن أَنطَقَت عُلاكَ الجَمادا",125,"د",2,0],["وَقَبلَكُمُ ما أَبصَرَ الدَهرُ مِثلَكُم","فَبادَ فَلا يُبصِر لِأَيّامِكُم بُعدا",126,"د",2,0],["وَقَبلَكَ ما راءَ الأَنامُ وَلَن يَرَوا","مَدى الدَهرِ شَمساً حَولَها أَنجُمٌ زُهرُ",127,"ر",1,0],["وَقَبَّلوا كُلَّ نَهجٍ ظَلتَ تَسلُكُهُ","حَتّى يَصيرَ ثَراهُ في الشِفاهِ لَما",128,"م",2,0],["وَقَبلَكُم وَالجِيادُ الجارِياتُ بِكُم","تَشتَدُّ ما اِمتَطَتِ الآسادُ عِقبانا",129,"ن",2,0],["وقبيح أن تضنّ وقد","مُلئت كفَّاك بالمنن",130,"ن",1,0],["وَقَبلَ الإِحتِلامِ سَقى المَواضي","دَمَ الأَعداءِ ريّاً وَالصِعادا",131,"د",2,0],["وَقُبحاً لِدَهرٍ أَصبَحَ العَلُّ فيلُهُ","وَأَضحَت بُزاةُ الطَيرِ فيهِ عُلاعِلُه",132,"ل",2,0],["وَقَبلَ أَذانِ العَصرِ نُودي بِمُلكِهِ","نِداءاً أَرانا الدَهرَ يَفتَرُّ جاذِلا",133,"ل",2,0],["وَقَبلُ كَم سامَني خَسفاً وَألزَمَني","ما لَيسَ لِي ناقَةٌ فيه وَلا جَمَلُ",134,"ل",1,0],["وَقَبلُ رَدَّت رُبُوعَ القَومِ أَربَعَةٌ","مِنّا فَمَن ذا إِلى مَجدٍ يُسامِينا",135,"ن",2,0],["وقبّة الحجّاج مبنيّة","أحكمها بالجصّ بانيها",136,"ه",2,1],["وقبوله لضلاله","بالشك من شيطانه",137,"ن",2,0],["وَقبلَ غروبِ الشمسِ صاحبتُ شيخهُ","لِقربِ العشا أيّامَ جاورتُ في مِصرا",138,"ر",2,0],["وقَبَرتُ فيكَ مواهبي","واستَنزَفَت غُللي شُؤوني",139,"ن",2,0],["وقبراً أرى تلك المقابر كعبةً","وذاك بها الركن الكريم المعظما",140,"م",2,0],["وقبلتهُ ثمَّ أدنيتهُ","من القلبِ كالعينِ والإثمدِ",141,"د",1,0],["وقُبلة منه على غفلةٍ","زيادةٌ في مُدَّةِ العُمرِ",142,"ر",1,0],["وقبّلنا الحجر وكذا سجدنا","عليه أخ بذلٍّ حامدينا",143,"ن",2,0],["وقبلتُ أرضَ الدارِ حينَ دَخَلْتُها","وأسْجُدُ فِيها سَجْدةً بعدَ سَجْدةِ",144,"ه",1,0],["وقبيح مني وحقك هجري","أو هل أنت يا صديقي مقيلي",145,"ل",2,0],["وَقَبَّلَهُ وَقالَ أَراكَ يا اِبني","بِفاطِمَةَ اِبنَةِ الأَعمامِ أَحرى",146,"ر",2,0],["وَقِبابَ الأَبراجِ يوقِظُها النورُ","كَجِنِّ عَلى قُبورٍ قَديمَه",147,"ه",1,0],["وَقَبَّلتُ مِنكِ الثَغرَ مُذ كُنتِ زَهرَةً","تَقطّرك الأَنداءُ عِندَ المَغارِبِ",148,"ب",1,0],["وقَبْلُهْم كان فيكُمُ قِصَرٌ","وكان فيكُمْ عن العُلا ثِقُل",149,"ل",1,0],["وقبلُ وقاه الله في أرض مكة","أذى كل حلاف من القوم حانث",150,"ث",1,0],["وَقَبلَكِ ما أَنهَضتُ عَزمي لِحاجَةٍ","وَأَدرَكتُها إِلّا بِحَدِّ سِنانِ",151,"ن",1,0],["وَقَبلَكَ كُنتُ أُشفِقُ أَن يَراها","وَقَد مَدَّت إِلَيهِ يَداً مُنيلُ",152,"ل",1,0],["وَقَبيحُ آثارٍ عَلى","أَعقابِكُم تُروى وَتُؤثَر",153,"ر",1,0],["وَقَبُولُكُمْ إِيَّاهُ يَا","مَوْلايَ يَرْفَعُهُ فَيَسْعَدْ",154,"د",1,0],["وقبيحٌ عليَّ أن أشتكي بَرا","وبحراً وأنت برٌّ رَحِيمُ",155,"م",1,0],["وقبّل به ثغر الزهور مرنّحاً","بضمّك من أغصانها كلَّ أملد",156,"د",1,0],["وقبلك صاحبت الزمان وأهله","فما شاقني خل ولا وراق موضع",157,"ع",1,0],["وقبلك حاربت الورى مذ خبرتهم","واقصيتهم عني فقالوا به كبر",158,"ر",1,0],["وقبلتُ أنقى وجنتينِ ومبسمٍ","وأسقَمَ أجفانٍ تشرَّبنَ إثمدا",159,"د",2,0],["وقبَّلتُها حتى نَثرتُ دُموعَها","وما كان قلبي بالعناقِ ليشتَفي",160,"ف",2,0],["وقبّلَ الأرضَ كي تحني عليَّ فمِي","وبلَّ ذيلك جفنٌ خاشعٌ باك",161,"ك",1,0],["وَقبرا فيه من ملأ النَواحي","هدى وَندى وايمانا وَيمنا",162,"ن",2,0],["وَقبل ثرى ذاكَ الحَبيب مسلما","عَلى خيرمَقبور بخير المَقابِر",163,"ر",1,0],["وَقَبل الجُودَ طفَّاحاً غَوارِبُهُ","مِن رَاحَةٍ غاصَ فيها البَحرُ فانغَمَسا",164,"س",2,0],["وَقَبلَها لَم يُرَ با","نٌ حَملُهُ الرُمّانُ",165,"ن",1,0],["وَقبلَك لامَ اللائمون فَلَم يَكن","لهم عند أَهل العشق حمدٌ ولا أَجرُ",166,"ر",1,0],["وقبل خد الوردِ وهو مضرجٌ","وثغر الأقاحي في الربا إذ تبسما",