,"بكيت فأبكيت الطلول البواليا","https://www.aldiwan.net/poem43394.html","الطويل"],[105,"أراك على المغيب فهل تراني","https://www.aldiwan.net/poem43403.html","الوافر"],[81,"ولما عزمنا ولم يبق من","https://www.aldiwan.net/poem61516.html","المتقارب"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[17,"عفا من آل فاطمة الخبيت","https://www.aldiwan.net/poem1192.html",""],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[75,"أبلغ ربيعة عن ذي الحي من يمن","https://www.aldiwan.net/poem69056.html","البسيط"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[48,"غدوت وما يشجي فؤادي خوادش","https://www.aldiwan.net/poem63271.html","الطويل"],[46,"يقول لك العقل الذي بين الهدى","https://www.aldiwan.net/poem22656.html","الطويل"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141005",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39679","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9931","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67334","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199472","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[99,"أحبكِ لا أدري","https://www.poetsgate.com/ViewPoem.aspx?id=206832",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""]],"verses":[["وَقَبلَكَ ضاعَ حَقّي في اللَيالي","كَما ضاعَ الغَريبُ أَوِ اليَتيمُ",0,"م",1,0],["وَقَبلَ ما كُبَّت لَها","قِبابُ عادٍ وَإِرَم",1,"م",1,0],["وَقَبلَكَ أَوقَرَ الأَيّامَ مَجداً","وَأَوضَعَ بِالعُلى حَتّى أَكَلّا",2,"ل",2,0],["وَقِبابٍ كَأَنَّما رَفَعوا مِن","ها لِمُستَرشِدِ الظَلامِ مَنارا",3,"ر",2,0],["وَقَبٌ عاقِرٌ في الدَه","رِ مِن داءٍ يُخامِرُه",4,"ر",2,0],["وَقِبابُ المُلكِ في أَعطانِها","رُفِعَت مِنكُم بِعاديَّ العَمَد",5,"د",1,0],["وَقَبرُكِ الصَونُ مِن قَب","لِ أَن يَضُمَّكِ تُربُ",6,"ب",1,0],["وَقَبراً بِالطُفوفِ يَضُمُّ شِلواً","قَضى ظَمَأً إِلى بَردِ الشَرابِ",7,"ب",1,0],["وَقَبلَ اليَومِ ما أَغمَدنَ عَنّي","مِنَ الأَيّامِ نائِبَةً وَنابا",8,"ب",2,0],["وَقَبضيِ بِكِلْتا راحَتَيَّ عَلى الحَشَى","وَرَمي بإِحدى مُقلَتَيَّ إِلى الرَّكبِ",9,"ب",1,0],["وَقِبابُها تَحوي بُدوراً طُلَّع","مِن كُلِّ فاتِنَةٍ بِطَرفٍ أَحوَرِ",10,"ر",1,0],["وَقَبلَكِ ساعَيتُ في رَبرَبٍ","إِذا نامَ سامِرُ رُقّابِها",11,"ب",3,0],["وَقَبلَهُم غالَتِ المَنايا","طَسماً وَلَم يُنجِها الحِذارُ",12,"ر",1,0],["وَقِبابٍ مِثلِ الهِضابِ وَخَيلٍ","وَصِعادٍ حُمرٍ يَقينَ السِماما",13,"م",2,0],["وَقَبَسنا مِن نورِكُم فَكَتَبنا","وَأَجَدنا نِثارَنا وَالنِظاما",14,"م",2,0],["وَقَبرٌ بِأَرضِ الجَوزَجانِ مَحَلُّهُ","وَقَبرٌ بِباخَمرا لَدى العَرِماتِ",15,"ت",1,0],["وَقَبرٌ بِبَغدادٍ لِنَفسٍ زَكِيَّةٍ","تَضَمَّنَها الرَحمَنُ في الغُرُفاتِ",15,"ت",1,0],["وَقَبرٌ بِطوسٍ يا لَها مِن مُصيبَةٍ","تُرَدَّدُ بَينِ الصَدرِ وَالحَجَباتِ",15,"ت",1,0],["وقبر النبوة في يثربا","ومثوى ضجيعَيْه منوى التُقى",16,"ق",2,0],["وَقَبلَكَ ما أَخزى الأُخَيطِلُ قَومَهُ","وَأَسلَمَهُم لِلمَأزِقِ المُتَلاحِمِ",17,"م",1,0],["وَقَبيلٌ مِن عُقَيلٍ صادِقٌ","كَلُيوثٍ بَينَ غابٍ وَعَصَل",18,"ل",1,0],["وقبر أبي داود حيث تشققت","عليه المآلي عصبُها وسبيبها",19,"ب",3,0],["وقبِّل الأرضَ في بابِ العلاءِ فقدْ","حكيتَ من أجلِ هذا الثغرَ والشنبا",20,"ب",2,0],["وقبلة بعثتها في الكرى شفةٌ","بالليل منك فهلاّ عاودت شفتي",21,"ي",1,0],["وقبلتها مصرية حلوةَ اللمى","أكرّرُ في تقبيلها السكّر المصري",22,"ر",2,0],["وقبلك لم تبصر بنو الشام وابلاً","من الغيثِ تهدِيه إلى الشامِ مصره",23,"ر",2,0],["وَقَبضٌ ثُمَّ بَسطٌ ثُمَّ مَحوٌ","وَفَرقٌ ثُمَّ جَمعٌ ثُمَّ طَمسُ",24,"س",1,0],["وقبل ذلكَ كانوا يَمْهَدُون له","وتلكُم القُرْبةُ الكبرى من القُرَبِ",25,"ب",1,0],["وقبيحٌ بعد الطلاقةِ والبشْ","ر بذي المجد نَبوةٌ واحتجابُ",26,"ب",1,0],["وقَبْلَ برِّك بي ما بَرَّني مَلكٌ","لا تملِكُونَ عليه حَلَّ معْقُودِ",27,"د",1,0],["وقبَّلتُ أفواهاً عِذاباً كأنها","ينابيع خمرٍ حُصِّبت لؤلؤ البحرِ",28,"ر",1,0],["وقبَّحتَ عندي صورةَ الحِرص والغنى","وحسنت عندي صورة اليأس والفقر",29,"ر",1,0],["وقبلَكَ ما نُصرتُ على ظلومٍ","وما أعملتُ أطرافَ الإلالِ",30,"ل",1,0],["وقبل ذلك بِرٌّ منكَ آنسني","حتى سلوْتُ عن الخُلان والوطنِ",31,"ن",1,0],["وقبيحٌ يجوزُ كلَّ قبيحٍ","رُقعةٌ من مُعاتبٍ لا تُصانُ",32,"ن",1,0],["وَقَبَّحتُم بِأَسماءٍ","وَحَسَّنتُم مُسَمّاها",33,"ا",3,0],["وَقَبيحٌ وَحَقِّكَ ال","صَبرُ عَن وَجهِكَ الحَسَن",34,"ن",1,0],["وقبَّلَهُ قُبَلاً صامِتاتٍ كما","يَلْثُمُ الموتُ وَرْدَ الغُصُون",35,"ن",1,0],["وقبَّلها قُبَلاً في الشِّفاهِ","تُعيدُ الشَّبابَ الَّذي قدْ غَبَرْ",36,"ر",1,0],["وَقَبلكُما ما أَودَعَ القَلبَ حَسرَةً","تُجَدّدُ طولَ الدَهرِ ثكلُ أَبي عَمرِو",37,"و",1,0],["وقبلة فوق خد ناعم عطِر","أبهى من الورد في ظل الندى الغادي",38,"د",2,0],["وقبل حسين ما تكلم مرضع","ولا نال علياء البيان فطيم",39,"م",1,0],["وقبلك لم يُنم عمرَ الأنام","وقد سهرت رعيته الكرام",40,"م",1,0],["وقبل النصر نصر قد تجلى","عُلاً في العصر آثارا وجلّى",40,"ل",2,0],["وَقَبرٍ مَنوطٍ بِالجَلالِ مُقَلَّدٍ","تَليدَ الخِلالِ الكُثرَ وَالطارِفَ الجَمّا",41,"م",2,0],["وَقُبورُ مَوتى مِن شَبابِ أُمَيَّةٍ","وَكُهولِهِم لَم يَبرَحوا أَحياءَ",42,"ا",2,0],["وَقِباؤُهُ نَسجُ الهُنودِ فَهَل تُرى","دَفَنوا الزَعيمَ مُكَفَّناً بِقَبائِهِ",43,"ا",3,0],["وَقُبوراً في السَمَواتِ العُلا","نَزَلوا أَم حُفَراتٌ وَرَغاما",44,"م",2,0],["وَقِبابٍ مِن لازَوَردٍ وَتِبرٍ","كَالرُبى الشُمِّ بَينَ ظِلٍّ وَشَمسِ",45,"س",1,0],["وَقَبراً كادَ مِن حُسنٍ وَطيبٍ","يُضيءُ حِجارَةً وَيَضوعُ طينا",46,"ن",2,0],["وَقَبلَ الحَربِ حَربٌ مِنكَ كانَت","نَتائِجُها لَنا ظَهَرَت وَبانَت",47,"ا",3,0],["وَقُبورٌ تَحُطُّ فيها اللَيالي","وَيُوارى الإِصباحُ وَالإِمساءُ",48,"ا",2,0],["وَقَبلَ يَرى مِن جودِهِ ما رَأَيتَهُ","وَيَسمَعَ فيهِ ما سَمِعتَ مِنَ العَذلِ",49,"ل",1,0],["وَقَبَّلَ كُمّاً قَبِّلَ التُربَ قَبلَهُ","وَكُلُّ كَمِيٍّ واقِفٌ مُتَضائِلُ",50,"ل",1,0],["وَقَبضُ نَوالِهِ شَرَفٌ وَعِزٌّ","وَقَبضُ نَوالِ بَعضِ القَومِ ذامُ",51,"م",1,0],["وَقَبرٌ عَن أَيامِنِ بَرقَعيدٍ","إِذا هِيَ ناحَرَت أُفُقَ الجَنوبِ",52,"ب",1,0],["وَقَبرانِ في أَعلى النِباجِ سَقَتهُما","بُروقُ سُيوفِ الغَوثِ غَيثاً مِنَ الدَمِ",53,"م",1,0],["وَقَبرٌ حَماهُ الجودُ أَن تَنسُجَ الصَبا","عَلَيهِ وَأَن تَعفو عَلَيها مَعالِمُه",54,"م",2,0],["وَقَبيحٌ إِذا إِستَعَنتُكَ أَن أَب","غي مُعيناً عَلى الَّذي أَستَعينُ",55,"ن",1,0],["وَقَبلَكَ ما أَحمَت عَدِيٌّ دِيارَها","وَأَصدَرَ راعيهِم بِفَلجٍ وَأَورَدا",56,"د",2,0],["وَقَبلَكَ ما أَخزى تَميماً أُسَيِّدٌ","وَقَنَّعَهُم ما لَيسَ عَنهُم يُحَوَّلُ",57,"ل",1,0],["وَقَبلَكَ عَجَّلنا اِبنَ عَجلى حِمامَهُ","بِأَسيافِنا يَصدَعنَ هامَ الجَماجِمِ",58,"م",1,0],["وقبر خالد في حمصٍ نلامسه","فيرجف القبر من زواره غضبا",59,"ب",2,0],["وقَبلُ ما قَبَّلَتْ محاسِنُه","وَجْهي وَوَجْهُ السُّرورِ مُقتبِلُ",60,"ل",1,0],["وَقبِّل يَدَ الجاني الَّذي لَستَ قادِراً","عَلى قَطعِها وَارقُب سُقوطَ جِدارِهِ",61,"ر",2,0],["وَقَبيحٌ أَن يُذكَرَ النافِرُ الوَح","شِيَ مِنها وَيُترَكَ المَأنوسُ",62,"س",1,0],["وَقَبيحٌ فيهِ التَنَسُّكُ إِلّا","بَعدَ سِتّينَ حِجَّةً وَثَماني",63,"ن",2,0],["وقَبّلْتُ خداً تَرَى ورده","نضيراً يشق عن الياسمين",64,"ن",1,0],["وقَبّلوا من مذاكي خيله فَرحاً","حوافراً قد علا أرساغَها العفرُ",65,"ر",1,0],["وَقَبيلَةً يَدَعُ المُتَوَّجُ خَوفَهُم","فَكَأَنَّما الدُنيا عَلَيهِ مُطبِقُ",66,"ق",1,0],["وَقَبيحٌ بِأَن تُعَرِّضَ جِسمي","ما أَرى مِن مَصارِعِ العُشّاقِ",67,"ق",1,0],["وَقَبَّلتُ ما بَينَ المُحَيّا إِلى الطُلى","وَعانَقتُ ما بَينَ التَراقي إِلى الخَصرِ",68,"ر",1,0],["وَقَبَضتُ ذَيلي رَغبَةً عَن مَعشَرٍ","عوجِ الطِباعِ كَأَنّهُم أَضلاعُ",69,"ع",1,0],["وَقَبَّلتُ رَسمَ الدارِ حُبّاً لِأَهلِها","وَمَن لَم يَجِد إِلّا صَعيداً تَيَمَّما",70,"م",2,0],["وَقَبِلتُ الكَأسَ مِن يَدِهِ","فَاِجتَنَينا الوَردَ مِن عَنَمِ",71,"م",1,0],["وَقَبلي أَعيَتِ البُرحاءُ قَوماً","فَما وَفَتِ القُلوبُ وَلا العُيونُ",72,"ن",1,0],["وَقَبلَكَ أَبكاني تَحَمُّلُ مَعشَرٍ","كَرِهتُ مُقامي بَعدَهُم وَبَقائِيا",73,"ي",2,0],["وَقَبلَكَ ضاعَ شِعري في دِيارٍ","شَجاني مِن بَنيها ما شَجاني",74,"ي",1,0],["وَقَبَّلتُ وَجنَتَهُ بِالدُموعِ","كَما اِلتُقِطَت وَردَةٌ مِن غَديرِ",75,"ر",1,0],["وَقَبَّلتُ في التُربِ مِنهُ خُطىً","أُمَيّزُها بِشَميمِ العَبيرِ",75,"ر",1,0],["وَقَبولٌ لَو لَم يَفُز ما سِواهُ","لَتَفَشَّت بِهِ الأَماني الحَرارُ",76,"ر",1,0],["وَقَبَلتني مِثلَها قُبلة","ما زِلت اَستَنشق رَياها",77,"ا",3,0],["وَقُبَّةِ حاصِنٍ أَدخَلتُ رَأسي","وَمِعصَمَها المُوَشَّمَ قَد لَوَيتُ",78,"ت",1,0],["وقُبَّةُ مارستانَ ليسَ لِعِلَّةٍ","عليه وإن طالَ الزَّمانَ مُرُورُ",79,"ر",1,0],["وقَبيلَةً قَتّلْتَها وقَبيلَةً","أثكَلْتَها بالبَرْك في الأعطانِ",80,"ن",1,0],["وقُبّةُ الصَّندَلِ الحَمراءُ قد فُتِحَتْ","للجودِ أبوابُها والوَفْدُ يَستَبق",81,"ق",1,0],["وقبضتَ أرواحَ العِدى وبسَطْتَها","ما بينَ تَلْيينٍ إلى تَشْديد",82,"د",1,0],["وَقَبَّلتُهُ ظَهراً لِبَطنِن وَتارَةً","يَكونُ بِساطُ الأَرضِ بِالباطِنِ الظَهرُ",83,"ر",1,0],["وَقَبِّل يَدَ الجاني الَّذي لَستَ واصِلاً","إِلى قَطعِها وَاِنظُر سُقوطَ جِدارِهِ",84,"ر",2,0],["وقَبيحٌ بنَا وإنْ قَدُمَ العَهْ","دُ هَوَانُ الآبَاءِ والأجْدادِ",85,"د",1,0],["وقبلَها ما خَضعتْ وأذعنتْ","إِستِجةُ وطالما قد صَنعتْ",86,"ت",1,0],["وقَبِلَ الإمام ذاكَ مِنْهُ","فضلاً وإحساناً وسارَ عنهُ",86,"ه",1,0],["وقبلَهم في هذه الغَزاةِ","قد هُدِّمتْ مَعاقلُ العُصاةِ",86,"ه",1,0],["وَقَبيلٍ باتوا جَميعاً بليل","فإذا هم في صبحه أَشتات",87,"ت",1,0],["وقبّل كمّاً قبّل الأرض قبله","وكلّ كميٍّ واقفٌ متضائل",88,"ل",1,0],["وقبِّلْ ثرىً فيه امتزجنا أُبوَّةً","ونُسلِمُهُ لابنٍ لنا وحفيدِ",89,"د",1,0],["وقبّلت في لواءٍ تحت إمرَتهِ","من فتيةِ النيلِ مقداماً ومغوارا",90,"ر",2,0],["وَقبِّل شهيداً على أَرضِها","دَعا باسمِهَا الله واستُشهِدَا",91,"د",2,0],["وقَبْلَ اليوْم وَدّعَني مِراحي","وأنسَتْنِيهِ أيّاٌم طِوالُ",92,"ل",1,0],["وَقِبابُها تَحوي بُدوراً طُلَّعاً","مِن كُلِّ فاتِنَةٍ بِطَرفٍ أَحوَرِ",93,"ر",1,0],["وَقَبْلَهُ نَاءَ ذُو الأَيْدِ","وَهْوَ يَحْمِلُ نِصْفَهْ",94,"ف",2,0],["وَقَبَّلَهَا فَاسْتَلَّ جَوْهَرَ رُوحِهَا","وَأَبْقَى عَلى رَسْمٍ كَبَعْضِ الدُّمَى الغُرِّ",95,"ر",1,0],["وَقَبَسَاتٍ مِنْ هُدَى الأَسْفَارِ فِي","حَواَضِرِ الدُّنْيَا وَفِي البَوَادِي",96,"د",2,0],["وَقَبْلَهُ كَانَ جُوعٌ لاَ اكْتِرَاثَ لَهُ","وَكَانَ عُرْيٌ وَلَمْ يُسْتَرْ وكانَ حَفَا",97,"ف",2,0],["وقبلَ اليومِ ما عَرَفُوا وَذَاقُوا","وَقَائِعُنَا بِهَا يُشفَى الغَلِيلُ",98,"ل",1,0],["وقبل أن أرقد","ودعيني",99,"ي",1,0],["وَقُبحُ شَتاتٍ بَعدَ حُسنِ تَأَلُّفٍ","وَوَحشَةُ قَبرٍ بَعدَ أُنسِ مَغانِ",100,"ن",1,0],["وَقَبَّلت الحورُ أَجفانهُ","وَإِذ أَهدَرَت دَمَهُ سُفَّكا",101,"ك",2,0],["وقبل أن يرنو إلى","شيء يرى ما أتفهه",102,"ه",1,0],["وقبرٌ كمحرابِ الصلاةِ مطهَّرٌ","عليه نعيمٌ وارفٌ وثواب",103,"ب",1,0],["وقبل النُّجح إخْفَاقٌ وثَان","وأول مِشْيَة الطِّفل العثَار",104,"ر",1,0],["وقَبْلَكُمُو بني هامانُ صرحًا","فكادَ النجمُ يدركُهُ انهيار",104,"ر",1,0],["وقبلَك غمّت عزةٌ رَبَّ كندةٍ","وشرَّد صونُ العرض رَبَّ الخَورَنق",105,"ق",1,0],["وقِباحُ أشباح لمُرتَعِدي الحَشَا","بَرمٌ بها ، ولمُحرِبين هُيام",106,"م",1,0],["وقبَّلتُ صدرَك حيثُ الصَّميم","مِن القلب ، مُنْخَرقاً ، يُخرَم",107,"م",1,0],["وقبلاً قال ذا أدبٍ ظريفٍ","قِرى الأضياف قبل الزاد خُلقُ",108,"ق",1,0],["وقبلَكِ لم أوجَدْ فلمّا مرَرْتِ بي","تساءَلتُ في نفسي ترى كُنتُ من قَبلُ ؟",109,"ل",1,0],["وقبلَ قِيلِ الناس يا غلامُ","فُطِمتَ مذ آن لك الفِطَامُ",110,"م",1,0]]}