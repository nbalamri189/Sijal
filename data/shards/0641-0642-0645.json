,78,"ر",1,0],["فَقُمْنَا إِلَيْهِ وَاثِقِينَ بِجَوْدِهِ","نَسِيرُ وَيَعْرُونَا السُّرُورُ فَنَهْتِفُ",79,"ف",1,0],["فَقُمْ بِنا نَغْتَنِمْ شَبَاباً","وَلَذَّةً بَعْدَها فَنَاءُ",80,"ا",2,0],["فَقُمْنَا إِلَى خَيْلٍ كَأَنَّ مُتُونَها","مِنَ الضُّمْرِ خُوطُ الضَّيْمَرَانِ الْمُشَذَّبُ",81,"ب",1,0],["فَقُم لِتحدقَ إنَّ الصِبيَةَ اِنتَظَروا","وَعداً عَلَيكَ بِإِطلاقٍ وَإِطعامِ",82,"م",1,0],["فقم واخطب بحفِلك كم تَغَنّى","وهام بصوتكَ الرنّانِ حَفْلُ",83,"ل",1,0],["فقمت ولهانَ من وجدي أقبلها","زحتُ اللثام ،، رأيتُ البدر معتنقِ",84,"ق",1,0],["فقُم وعزِّ عُيونَ المجد في حَوَرٍ","فَقْدَنهُ ، وثغورَ الفضل في شَنَبَ",85,"ب",1,0],["فقمنا بأشلاء اللجام ولم نقد","إلى غُصْنِ بَانٍ نَاصِرٍ لم يُحرَّقِ",86,"ق",1,0],["فقم واخطب بحفلِك وكم تَغَنّى","وهام بصوتِكَ الرنّانِ حَفْلُ",87,"ل",1,0],["فَقُمْتُ إلَى عَنْسٍ تَخَوَّنَ نَيَّها","سُرَى اللَّيْلِ حَتَّى لَحْمُها مُتَحَسَّرُ",88,"ر",1,0],["فقم نغتنِم صفوَ البكورِ، فإنَّها","غداة ُ زهرُها باسِمُ الثغرِ",89,"ر",1,0]]}