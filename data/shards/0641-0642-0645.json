ttps://www.aldiwan.net/poem59347.html","الطويل"],[381,"يا غافلا والإثم حل بأرضه","https://www.aldiwan.net/poem59360.html","الكامل"],[381,"سقياك سقياك ربعا ظل مبتهجا","https://www.aldiwan.net/poem66893.html","البسيط"],[381,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[407,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[410,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[413,"أو ما ترى التين في الغصون بدا","https://www.aldiwan.net/poem31673.html","عموديه"],[413,"نفسي الفداء لظالم متعتب","https://www.aldiwan.net/poem31844.html","الكامل"],[420,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[433,"يا ذا الخليل الذي في قوله ثقة","https://www.aldiwan.net/poem40862.html","البسيط"],[433,"يا غائبا عن حبه","https://www.aldiwan.net/poem41005.html","مجزوء الرجز"],[436,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[436,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[438,"ألا حبذا نور البنفسج إذ بدا","https://www.aldiwan.net/poem26353.html","الطويل"],[441,"أجل قد تمادى الأمر وانصرم العمر","https://www.aldiwan.net/poem2542.html","الطويل"],[445,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[445,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[445,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[455,"مهينمة جاءت بأوصاف ماجد","https://www.aldiwan.net/poem13647.html","الطويل"],[455,"وافى الربيع بترنام الفواخيت","https://www.aldiwan.net/poem13672.html","البسيط"],[455,"تنفست نسمات السحر في السحر","https://www.aldiwan.net/poem13760.html","البسيط"],[455,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[455,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[458,"حللنا آمنين بخير عيش","https://www.aldiwan.net/poem26618.html","الوافر"],[461,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[461,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[461,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[461,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[461,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[461,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[464,"يا طالب المجد إن حاولت غايته","https://www.aldiwan.net/poem16051.html","البسيط"],[464,"يا مودع السر سر الله خص به","https://www.aldiwan.net/poem16266.html","البسيط"],[471,"غناء شحارير وزمر بلابل","https://www.aldiwan.net/poem59566.html","الطويل"],[471,"أرى الغيم يخلع من خزه","https://www.aldiwan.net/poem59613.html","المتقارب"],[471,"في الأرض فيروزج محلى","https://www.aldiwan.net/poem59718.html","مخلع البسيط"],[471,"يا من يحب أذى المحب بمطله","https://www.aldiwan.net/poem59749.html","الكامل"],[471,"أسير القطر قد أضحى طليقا","https://www.aldiwan.net/poem59803.html","الوافر"],[471,"سوالف سوسن وخدود ورد","https://www.aldiwan.net/poem59979.html","الوافر"],[471,"غناء وضرب بين ذاك وذا زمر","https://www.aldiwan.net/poem60034.html","الطويل"],[471,"نسيم كالرضا من حيث وافى","https://www.aldiwan.net/poem60035.html","الوافر"],[471,"القضب نشوى والزهر مخمور","https://www.aldiwan.net/poem60078.html","المنسرح"],[471,"نسيم كحلقى في نغمته","https://www.aldiwan.net/poem60353.html","المتقارب"],[471,"السحب قد نصبت في الجو أروقة","https://www.aldiwan.net/poem60442.html","البسيط"],[471,"الرعد منتحب والبرق ملتهب","https://www.aldiwan.net/poem60449.html","البسيط"],[482,"قد استنزلت من خلل السحاب","https://www.aldiwan.net/poem36885.html","الوافر"],[482,"يا ليلة قد تجلى","https://www.aldiwan.net/poem36972.html","المجتث"],[503,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[503,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[518,"خادم ذيل المجلس العادلي","https://www.aldiwan.net/poem12197.html","السريع"],[532,"قل لإمام الزمن","https://www.aldiwan.net/poem37130.html","الرجز"],[561,"صفا ماء الحقيقة فهو صافي","https://www.aldiwan.net/poem34351.html","الوافر"],[561,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[565,"يا جرجس الحجة المختار فزت بما","https://www.aldiwan.net/poem52651.html","البسيط"],[565,"أتتني وهي سافرة صباحا","https://www.aldiwan.net/poem52723.html","الوافر"],[566,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[570,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[570,"ما قمت حتى دعاني صوتها الغرد","https://www.aldiwan.net/poem69708.html","البسيط"],[572,"فقمت ولم تأخذ إلي رماحها","https://www.aldiwan.net/poem52013.html","الطويل"],[578,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[578,"جرى دمعه من مسيل الأسيل","https://www.aldiwan.net/poem2885.html","المتقارب"],[1022,"","https://poetry.dctabudhabi.ae/diwan/poem/89617","الرجز"]],"verses":[["فَقُمتُ أَنفُضُ بُرداً ما تَعَلَّقَهُ","غَيرَ العَفافِ وَراءَ الغَيبِ وَالكَرَمِ",0,"م",1,0],["فقُمْتُ بالخَطْبِ مَرْهوباً عَواقِبُهُ","للعَزْمِ مُحتَضِناً للحَزْمِ مُلتَزِما",1,"م",2,0],["فَقُمنا وَلَمّا يَصِح ديكُنا","إِلى جَونَةٍ عِندَ حَدّادِها",2,"د",3,0],["فَقُمتُ أَختارُ مِنها كُلَّ كاسِيَةٍ","تاهَت بِنَضرَتِها في ثَوبِها القَشِبِ",3,"ب",1,0],["فَقُمتُ عَنهُ وَأَذيالي عَلى كَتِفي","فَأَشرَفَت عِرسُهُ مِن شُرفَةِ الدارِ",4,"ر",1,0],["فَقُمنا بِأَشلاءِ اللِجامِ وَلَم نَقُد","إِلى غُصنِ بانٍ ناضِرٍ لَم يُحَرَّقِ",5,"ق",1,0],["فَقُمتُ وَقَد كادَت لِرَوعَةِ هُلكِهِ","وَفَزعَتِهِ نَفسي مِنَ الحُزنِ تَتبَعُ",6,"ع",1,0],["فَقُمنا إِلى مِثلِ الهِلالَينِ لاحَنا","وَإِيّاهُما عَرضُ الفَيافي وَطولُها",7,"ل",3,0],["فَقُمنا فَرُحنا وَالدَوامِغُ تَلتَظي","عَلى العيسِ مِن شَمسٍ بَطيءٍ زَوالُها",8,"ل",3,0],["فقم أيها الشيخ السنوسي مُدرِكاً","جنود بني عثمان في الجبل الغربي",9,"ب",2,0],["فقمتَ له في محِفل القوم خاطباً","تَجُرّ ذيول الفخر عُجباً وتختال",10,"ل",1,0],["فقمت له بالنَعل ضرباً فلم تزل","يدايَ به حتى اطمأنّت غواربه",11,"ب",2,0],["فقمت بين إناس حوله وقفوا","مستعبرين وكلٌ نحوه ران",12,"ن",1,0],["فقمنا لذكرى مجده بعد موته","نباهي به أحياءنا ونماجد",13,"د",1,0],["فقمت لديه وانحنيت أمامه","فقبلت بالتعظيم حاشية البرد",14,"د",1,0],["فقمت وبي من خشية الله رعدة","وأحسست من رؤياي بَرداً على كبدي",14,"د",2,0],["فقمنا جميعاً من وراء ستارها","نقول بشوق ما وراءك يا ستر",15,"ر",1,0],["فقمت وقام الناس كل لشأنه","كأنا حجيج البيت في ساعة النَّفر",16,"ر",1,0],["فَقُمنا بِأَسيافِنا دونَهُ","نُجالِدُ عَنهُ بُغاةَ الأُمَم",17,"م",1,0],["فَقُمتُ بِكَأسٍ قَهوَةٍ فَشَنَنتُها","بِذي رَونَقٍ مِن ماءِ زَمزَمَ فاتِرِ",18,"ر",1,0],["فقمت ولكن بعد أن وضح الدجى","وعدت بمشهور الثنا طاهر سمح",19,"ح",1,0],["فقمْ في ذرى العليا قيام عنايةً","سيمضي بها أزمان ذكرٍ وأزمان",20,"ن",1,0],["فَقُمنَ إِلى جَبّانَةٍ قَد عَلِمنَها","لَنا أَثَرٌ فيها كَمَنزِلَةِ السَفرِ",21,"ر",1,0],["فَقُم نَصطَلِح لا يَدخُلِ الناسُ بَينَنا","وَلا يَبلُغِ الواشينَ عَنكَ وَلا عَنّي",22,"ن",2,0],["فَقُم يا أَلفَ مَولايَ","أَدِرها غَيرَ مَأمورِ",23,"ر",1,0],["فقم إلى منبر التاريخ محتفلا","فقد تضوّع كالعودين ريحانا",24,"ن",2,0],["فقم خطيبا في بنى التاميز","وامدح مذل الوطن العزيز",25,"ز",1,0],["فقم بنا نندب المعالي","فجرحها اليوم في الوتين",26,"ن",1,0],["فقمت فقرّ في يدك العباب","وأوشكت العواصف أن تدينا",27,"ن",2,0],["فقم من طول نومك والغرور","وخذ بالحزن أو خذ بالسرور",28,"ر",1,0],["فَقُمتُ أَلقي السَمعَ في","السُتورِ وَالأَسِرَّةِ",29,"ه",1,0],["فَقُمتُ كَالعادَةِ بِالمَطلوبِ","وَجِئتُها أَنظُرُ مِن قَريبِ",30,"ب",1,0],["فَقُمتَ إِلى حُفرَةٍ هُيِّئَت","وَقُمتُ إِلى مِثلِها تُحتَفَر",31,"ر",1,0],["فَقُمتَ عَلَيهِ تَجرِبَةً وَخُبراً","وَمَدرَسَةُ الرِجالِ التَجرِباتُ",32,"ت",1,0],["فَقُمتُ أُجيلُ الطَرفَ حَيرانَ قائِلاً","أَهَذى ثُغورُ التُركِ أَم أَنا أَحسَبُ",33,"ب",1,0],["فَقُمنا عَلى عَجَلٍ وَالنُجو","مُ مُوَلِّيَةٌ قَد هَوَت مُدبِرَه",34,"ر",2,0],["فَقُمتَ مَقاماً يَعلَمُ اللَهُ أَنَّهُ","مَقامُ إِمامٍ تَركُ طاعَتِهِ كُفرُ",35,"ر",1,0],["فَقُمتُ وَحاذَرتُ السُرى أَن تَفوتَني","بِذي شُقَّةٍ تَعلو الكُسورَ الخَوافِيا",36,"ي",2,0],["فَقُمتُ إِلى البَركِ الهُجودِ وَلَم يَكُن","سِلاحي يُوَقّي المُربِعاتِ المَتالِيا",36,"ي",2,0],["فقُمْ بنا نَنعَمُ في مَنزلٍ","نعيمُه الدائمُ محبوبُ",37,"ب",1,0],["فَقُمتُ لَها بِ","وَفاءِ العُهودِ",38,"د",1,0],["فَقُم بِنا نَنهَبِ السُرورَ وَعِش","مِنَ التَهاني في حُسنِ مُنقَلَبِ",39,"ب",1,0],["فَقُم مِن بَعدِ نُهوضِ السَعدِ","فَإِنَّ الوَعدَ شَبيهُ الدَينِ",40,"ن",1,0],["فَقَمتُ أَسعى خيفَةً أَن يَقضي","أَغُضُّ عَن زَلّاتِهِ وَأُغضي",41,"ض",2,0],["فَقُم فَقَد تَمَّ لَنا طيبُ الهَنا","وَالدَهرُ قَد مَنَّ عَلينا بِالمُنى",42,"ن",2,0],["فَقُم بِنَصري فَقَد تَقاعَدَ بي","دَهري وَقَد ضاقَت بَعدَكَ الحِيَلُ",43,"ل",1,0],["فقمت وقد ضجَّ الهوى في جوانحي","وأنَّ من الكتمان أيّ أنينِ",44,"ن",1,0],["فقم نسخر من الأَمَلِ","ومن أعماقنا نضحك",45,"ك",1,0],["فَقُمْ عَاطِنِيهَا قَبْلَ أَنْ يَحْكُمَ النُّهَى","عَلَيَّ وَيَسْتَهْوِي الزَّمَانُ عَلَى زَهْوِي",46,"ي",1,0],["فَقُمنَ لِكَي يُخلينَنا فَتَرَقرَقَت","مَدامِعُ عَينَيها فَظَلَّت تَدَفَّقُ",47,"ق",1,0],["فَقُمتُ أَمشي وَقامَت وَهيَ فاتِرَةٌ","كَشارِبِ الخَمرِ بَطّى مَشيَهُ السَكَرُ",48,"ر",1,0],["فَقُمتُ إِلى مِغلاةِ أَرضٍ كَأَنَّها","إِذا اِلتَفَتَت مَجنونَةٌ حينَ تَنظُرُ",49,"ر",1,0],["فَقُمنَ يُبارينَ السُدولَ بِوافِرٍ","يُلاعِبُ عِطفَيهِ الجَريرُ وَدافِعُ",50,"ع",1,0],["فَقُم تَرَ ما دَهاها مِن شِقاءٍ","وَمِثلُكَ لَيسَ يُعييهِ القِيامُ",51,"م",1,0],["فَقُمتُ إِلى طِرفٍ مِنَ الخَيلِ لَم يَبِت","مُذالاً وَلَم تُقفِر عَلَيهِ المَذاوِدُ",52,"د",1,0],["فَقُمتُ مِنهُ خائِفاً مُرتاعا","وَقُلتُ ناموا وَيحَكُم سِراعا",53,"ع",2,0],["فَقُمتُ أَفرِشُ خَدَّي في الطَريقِ لَهُ","ذُلّاً وَأَسحَبُ أَذيالي عَلى الأَثَرِ",54,"ر",1,0],["فَقُم يا رَسولي فَاِلقَها غَيرَ خائِفٍ","فَإِنّي قَدِ اِستَمكَنتُ مِن لَحظِها حُبّا",55,"ب",2,0],["فقُمتُ بها عن ألسنِ القوم خُطبَةً","إذا ذُكِرَتْ لم تُخزِهم في المواسم",56,"م",1,0],["فَقُمتُ أَحبو إِلى الرَضاعِ كَما","تَحامَلَ الطِفلُ مَسَّهُ سَغَبُ",57,"ب",1,0],["فقُمنا إليه واحداً بعدَ واحِدٍ،","فكان بهِ من صَومِ غُربتنا الفِطرُ",58,"ر",1,0],["فَقُمِ الآنَ طائِعاً قُلتُ عُج بي","يا مَليكي إِلى الفِراشِ فَعاجا",59,"ج",2,0],["فَقُمتُ إِلَيهِ أَرفُلُ مُستَقيماً","وَقَد هَيَّأتُ كَبشي لِلنِطاحِ",60,"ح",1,0],["فَقُمتُ حَتّى حَلَلتُ مِئزَرَهُ","مِنهُ وَسَوَّيتُ فَخذَهُ بِيَدي",61,"د",2,0],["فَقُمتُ نُصبَ عَدُوٍّ","قاسي الفُؤادِ كَنودِه",62,"د",2,0],["فَقُمتُ إِلَيهِ وَالكَرى كُحلُ عَينِهِ","فَقَبَّلتُهُ وَالصَبُّ لَيسَ لَهُ صَبرُ",63,"ر",1,0],["فَقُمنا إِلَيهِ حينَ نامَ وَأُرعِدَت","فَرائِصُهُ تَجري بِميدانِهِ ضَمرا",64,"ر",2,0],["فَقُمنا بِها في فِتيَةٍ خَضَعَت لَهُم","رِقابُ صَناديدِ الكُماةِ البَطارِقِ",65,"ق",1,0],["فَقُم فَاصطَبِحها وَانفِ عَنكَ خُمارَها","فَلَيسَ لَها مِثلُ الصَبوحِ المُعاجِلِ",66,"ل",1,0],["فَقُم مُجتَلِياً فَاِظُر","بِعَينَي غَيرِ مَشغولِ",67,"ل",1,0],["فقمتُ من خيفةٍ أنبّههُم","أقولُ هل نالكم كما أجدُ",68,"د",1,0],["فقمتُ أمشقُ في قرطاسهِ بيدٍ","خطاطةٍ ما يعاني في القراطيس",69,"س",1,0],["فقمتُ باللعبِ فمازحتهُ","على طريق المزحِ والجمشِ",70,"ش",1,0],["فقمنا حوالي نعشه نندب العلى","ونبكيه طول الليل حتى بدا الفجر",71,"ر",1,0],["فَقُمْتُ أَلْجُمُهُ وقَامَ مُشْتَرِفاً","عَلَى سَنَابِكِهِ في شَائِلٍ يَسَرِ",72,"ر",1,0],["فَقُمْنَا إلى قُلُصٍ ضُمَّرٍ","نَشُدُّ بِأَجْوَازِهِنَّ الرِّحَالاَ",73,"ل",2,0],["فَقمِ الآن من مكانِكَ واغنمْ","في الكرى غَطّة الخليِّ الطروبِ",74,"ب",1,0],["فَقُمْ بِنَا يا صَاحِ نَرْعَ النَّدَى","وَنَسْأَلِ اللهِ عَمِيمَ النَّدَى",75,"د",2,0],["فَقُمْتُ أَسْأَلُ عَيْنِي رَجْعَ مَا سَمِعَتْ","أُذْنِي فَقَالَتْ لَعَلِّي أَبْلُغُ الْخَبَرَا",76,"ر",2,0],["فَقُمْ نَغْتَرِفْ خَمْرَ النُّهَى مِنْ دِنَانِها","وَنَجْنِي بِأَيدِي الْجِدِّ رَيْحَانَةَ الْعُمْرِ",77,"ر",1,0],["فَقُمْ بِنَا نَلْهُ بِلَذَّاتِنَا","فَإِنَّمَا الْعَيْشُ لَهُ آخِرُ",78,"ر",1,0],["فَقُمْ نَغْتَنِمْ صَفْوَ أَيَّامِنَا","وَنَدْفَعُ بِالرَّاحِ عَنَّا الأَذَى",79,"ذ",2,0],["فَقُمْ نَغْتَنِمْ صَفْوَ الْبُكُورِ فَإِنَّهَا","غَدَاةُ رَبِيعٍ زَهْرُهَا بَاسِمُ الثَّغْرِ",80,"ر",1,0],["فَقُمْنَا إِلَيْهِ وَاثِقِينَ بِجَوْدِهِ","نَسِيرُ وَيَعْرُونَا السُّرُورُ فَنَهْتِفُ",81,"ف",1,0],["فَقُمْ بِنا نَغْت