{"poems":[[53,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem29822.html","البسيط"],[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[86,"ماذا ادخرت لهذا العيد من أدب","https://www.aldiwan.net/poem68957.html","البسيط"],[71,"لما تشكى ابن عصرون إلي حمى","https://www.aldiwan.net/poem3816.html","البسيط"],[0,"ألا انعم صباحا أيها الربع وانطق","https://www.aldiwan.net/poem79.html","الطويل"],[10,"لقد صوت الناعي بفقد أخي الندى","https://www.aldiwan.net/poem21106.html","الطويل"],[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[88,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[88,"رويدك غورو أيهذا الجنيرال","https://www.aldiwan.net/poem44823.html","الطويل"],[88,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[88,"من سامع قصة لي كنت شاهدها","https://www.aldiwan.net/poem45041.html","البسيط"],[88,"لعمرك لو كانت حديدا جسومنا","https://www.aldiwan.net/poem45054.html","الطويل"],[88,"لقد بت مطروف النواظر بالسهد","https://www.aldiwan.net/poem45057.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[23,"رميت بها أهل المضيق فلم تكد","https://www.aldiwan.net/poem21420.html","الطويل"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[72,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[29,"لأسماء محتل بناظرة البشر","https://www.aldiwan.net/poem6183.html","الطويل"],[70,"سمعت حديثا ليتني لو حضرته","https://www.aldiwan.net/poem42675.html","الطويل"],[70,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[85,"العلم والبر هذا مهرجانهما","https://www.aldiwan.net/poem7124.html","البسيط"],[85,"يا سعد إن أنت دخلت لوندرة","https://www.aldiwan.net/poem7263.html","الرجز"],[85,"يا أقرب الناس من أمين","https://www.aldiwan.net/poem7785.html","مخلع البسيط"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"يا حبذا أمينة وكلبها","https://www.aldiwan.net/poem8066.html","الرجز"],[85,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[85,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"عدمت النغيل فما أدمره","https://www.aldiwan.net/poem63573.html","المتقارب"],[45,"أبر على الألواء نائلك الغمر","https://www.aldiwan.net/poem63606.html","الطويل"],[28,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[61,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[66,"شربنا سلافا بلا آنيه","https://www.aldiwan.net/poem38521.html","المتقارب"],[66,"قد أضحك الروض مدمع السحب","https://www.aldiwan.net/poem38809.html","المنسرح"],[66,"أيا ذا الفخر وملك العصر","https://www.aldiwan.net/poem39070.html","الهزج"],[66,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[66,"مولاي إني عليك متكل","https://www.aldiwan.net/poem41552.html","المنسرح"],[97,"ولما التقينا بعد نأي وغربة","https://www.aldiwan.net/poem24795.html","الطويل"],[97,"قضيت العمر تذكر لي","https://www.aldiwan.net/poem24803.html","مجزوء الوافر"],[87,"تصابيت بعد الحلم واعتادني شجوي","https://www.aldiwan.net/poem8194.html","الطويل"],[31,"فلما التقينا واطمأنت بنا النوى","https://www.aldiwan.net/poem42212.html","الطويل"],[31,"قل للمليحة قد أبلتني الذكر","https://www.aldiwan.net/poem42546.html","البسيط"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[33,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[105,"سلام أيها الملك الهمام","https://www.aldiwan.net/poem43407.html","الوافر"],[40,"ألم ينس ليلى عهدك المتباعد","https://www.aldiwan.net/poem42299.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"سقى المطيرة ذات الظل والشجر","https://www.aldiwan.net/poem26973.html","البسيط"],[52,"لقد عرضتني بالمحول قينة","https://www.aldiwan.net/poem27283.html","الطويل"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[48,"ألا فاسقني خمراً وقل لي هي الخمر","https://www.aldiwan.net/poem21954.html","عموديه"],[48,"وعقار كأنما نتعاطى","https://www.aldiwan.net/poem62484.html","الخفيف"],[48,"تعاتبني على شرب اصطباح","https://www.aldiwan.net/poem62513.html","الوافر"],[48,"رب غزال كأنه قمر","https://www.aldiwan.net/poem62561.html","المنسرح"],[48,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[48,"غدوت وما يشجي فؤادي خوادش","https://www.aldiwan.net/poem63271.html","الطويل"],[48,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[48,"ومجلس خمار إلى جنب حانة","https://www.aldiwan.net/poem64427.html","الطويل"],[48,"وندمان صدق من خزاعة في الذرا","https://www.aldiwan.net/poem64507.html","الطويل"],[48,"وفي الحمام يبدو لك","https://www.aldiwan.net/poem65003.html","الهزج"],[48,"وفتية ساعة قد اجتمعوا","https://www.aldiwan.net/poem66260.html","المنسرح"],[48,"لا أندب الربع قفرا غير مأنوس","https://www.aldiwan.net/poem66269.html","البسيط"],[48,"وشاطرِ أحورِ طاوي الحشا","https://www.aldiwan.net/poem66292.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42628","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42701","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[77,"جَاءَتْ مُعَذِّبَتِي فِي غَيْهَبِ الغَسَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=204622",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[0,"ألا انعم صباحاً أيها الربع وانطقِ","https://www.poetsgate.com/ViewPoem.aspx?id=4799",""],[101,"أقاموا بعضَ يومٍ فاستقلّوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62447&r=&rc=39",""],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""],[87,"رَمَتْ بِخُيُوطِ النُّورِ كَهْرَبَة ُ الْفَجْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23907&r=&rc=169",""]],"verses":[["فَقُمتُ أَنفُضُ بُرداً ما تَعَلَّقَهُ","غَيرَ العَفافِ وَراءَ الغَيبِ وَالكَرَمِ",0,"م",1,0],["فقُمْتُ بالخَطْبِ مَرْهوباً عَواقِبُهُ","للعَزْمِ مُحتَضِناً للحَزْمِ مُلتَزِما",1,"م",2,0],["فَقُمنا وَلَمّا يَصِح ديكُنا","إِلى جَونَةٍ عِندَ حَدّادِها",2,"د",3,0],["فَقُمتُ أَختارُ مِنها كُلَّ كاسِيَةٍ","تاهَت بِنَضرَتِها في ثَوبِها القَشِبِ",3,"ب",1,0],["فَقُمتُ عَنهُ وَأَذيالي عَلى كَتِفي","فَأَشرَفَت عِرسُهُ مِن شُرفَةِ الدارِ",4,"ر",1,0],["فَقُمنا بِأَشلاءِ اللِجامِ وَلَم نَقُد","إِلى غُصنِ بانٍ ناضِرٍ لَم يُحَرَّقِ",5,"ق",1,0],["فَقُمتُ وَقَد كادَت لِرَوعَةِ هُلكِهِ","وَفَزعَتِهِ نَفسي مِنَ الحُزنِ تَتبَعُ",6,"ع",1,0],["فَقُمنا إِلى مِثلِ الهِلالَينِ لاحَنا","وَإِيّاهُما عَرضُ الفَيافي وَطولُها",7,"ل",3,0],["فَقُمنا فَرُحنا وَالدَوامِغُ تَلتَظي","عَلى العيسِ مِن شَمسٍ بَطيءٍ زَوالُها",8,"ل",3,0],["فقم أيها الشيخ السنوسي مُدرِكاً","جنود بني عثمان في الجبل الغربي",9,"ب",2,0],["فقمتَ له في محِفل القوم خاطباً","تَجُرّ ذيول الفخر عُجباً وتختال",10,"ل",1,0],["فقمت له بالنَعل ضرباً فلم تزل","يدايَ به حتى اطمأنّت غواربه",11,"ب",2,0],["فقمت بين إناس حوله وقفوا","مستعبرين وكلٌ نحوه ران",12,"ن",1,0],["فقمنا لذكرى مجده بعد موته","نباهي به أحياءنا ونماجد",13,"د",1,0],["فقمت لديه وانحنيت أمامه","فقبلت بالتعظيم حاشية البرد",14,"د",1,0],["فقمت وبي من خشية الله رعدة","وأحسست من رؤياي بَرداً على كبدي",14,"د",2,0],["فقمنا جميعاً من وراء ستارها","نقول بشوق ما وراءك يا ستر",15,"ر",1,0],["فقمت وقام الناس كل لشأنه","كأنا حجيج البيت في ساعة النَّفر",16,"ر",1,0],["فَقُمنا بِأَسيافِنا دونَهُ","نُجالِدُ عَنهُ بُغاةَ الأُمَم",17,"م",1,0],["فَقُمتُ بِكَأسٍ قَهوَةٍ فَشَنَنتُها","بِذي رَونَقٍ مِن ماءِ زَمزَمَ فاتِرِ",18,"ر",1,0],["فقمت ولكن بعد أن وضح الدجى","وعدت بمشهور الثنا طاهر سمح",19,"ح",1,0],["فقمْ في ذرى العليا قيام عنايةً","سيمضي بها أزمان ذكرٍ وأزمان",20,"ن",1,0],["فَقُمنَ إِلى جَبّانَةٍ قَد عَلِمنَها","لَنا أَثَرٌ فيها كَمَنزِلَةِ السَفرِ",21,"ر",1,0],["فَقُم نَصطَلِح لا يَدخُلِ الناسُ بَينَنا","وَلا يَبلُغِ الواشينَ عَنكَ وَلا عَنّي",22,"ي",1,0],["فَقُم يا أَلفَ مَولايَ","أَدِرها غَيرَ مَأمورِ",23,"ر",1,0],["فقم إلى منبر التاريخ محتفلا","فقد تضوّع كالعودين ريحانا",24,"ن",2,0],["فقم خطيبا في بنى التاميز","وامدح مذل الوطن العزيز",25,"ز",1,0],["فقم بنا نندب المعالي","فجرحها اليوم في الوتين",26,"ن",1,0],["فقمت فقرّ في يدك العباب","وأوشكت العواصف أن تدينا",27,"ن",2,0],["فقم من طول نومك والغرور","وخذ بالحزن أو خذ بالسرور",28,"ر",1,0],["فَقُمتُ أَلقي السَمعَ في","السُتورِ وَالأَسِرَّةِ",29,"ه",1,0],["فَقُمتُ كَالعادَةِ بِالمَطلوبِ","وَجِئتُها أَنظُرُ مِن قَريبِ",30,"ب",1,0],["فَقُمتَ إِلى حُفرَةٍ هُيِّئَت","وَقُمتُ إِلى مِثلِها تُحتَفَر",31,"ر",1,0],["فَقُمتَ عَلَيهِ تَجرِبَةً وَخُبراً","وَمَدرَسَةُ الرِجالِ التَجرِباتُ",32,"ت",1,0],["فَقُمتُ أُجيلُ الطَرفَ حَيرانَ قائِلاً","أَهَذى ثُغورُ التُركِ أَم أَنا أَحسَبُ",33,"ب",1,0],["فَقُمنا عَلى عَجَلٍ وَالنُجو","مُ مُوَلِّيَةٌ قَد هَوَت مُدبِرَه",34,"ر",2,0],["فَقُمتَ مَقاماً يَعلَمُ اللَهُ أَنَّهُ","مَقامُ إِمامٍ تَركُ طاعَتِهِ كُفرُ",35,"ر",1,0],["فَقُمتُ وَحاذَرتُ السُرى أَن تَفوتَني","بِذي شُقَّةٍ تَعلو الكُسورَ الخَوافِيا",36,"ي",2,0],["فَقُمتُ إِلى البَركِ الهُجودِ وَلَم يَكُن","سِلاحي يُوَقّي المُربِعاتِ المَتالِيا",36,"ي",2,0],["فقُمْ بنا نَنعَمُ في مَنزلٍ","نعيمُه الدائمُ محبوبُ",37,"ب",1,0],["فَقُمتُ لَها بِ","وَفاءِ العُهودِ",38,"د",1,0],["فَقُم بِنا نَنهَبِ السُرورَ وَعِش","مِنَ التَهاني في حُسنِ مُنقَلَبِ",39,"ب",1,0],["فَقُم مِن بَعدِ نُهوضِ السَعدِ","فَإِنَّ الوَعدَ شَبيهُ الدَينِ",40,"ن",1,0],["فَقَمتُ أَسعى خيفَةً أَن يَقضي","أَغُضُّ عَن زَلّاتِهِ وَأُغضي",41,"ي",1,0],["فَقُم فَقَد تَمَّ لَنا طيبُ الهَنا","وَالدَهرُ قَد مَنَّ عَلينا بِالمُنى",42,"ن",2,0],["فَقُم بِنَصري فَقَد تَقاعَدَ بي","دَهري وَقَد ضاقَت بَعدَكَ الحِيَلُ",43,"ل",1,0],["فقمت وقد ضجَّ الهوى في جوانحي","وأنَّ من الكتمان أيّ أنينِ",44,"ن",1,0],["فقم نسخر من الأَمَلِ","ومن أعماقنا نضحك",45,"ك",1,0],["فَقُمْ عَاطِنِيهَا قَبْلَ أَنْ يَحْكُمَ النُّهَى","عَلَيَّ وَيَسْتَهْوِي الزَّمَانُ عَلَى زَهْوِي",46,"ي",1,0],["فَقُمنَ لِكَي يُخلينَنا فَتَرَقرَقَت","مَدامِعُ عَينَيها فَظَلَّت تَدَفَّقُ",47,"ق",1,0],["فَقُمتُ أَمشي وَقامَت وَهيَ فاتِرَةٌ","كَشارِبِ الخَمرِ بَطّى مَشيَهُ السَكَرُ",48,"ر",1,0],["فَقُمتُ إِلى مِغلاةِ أَرضٍ كَأَنَّها","إِذا اِلتَفَتَت مَجنونَةٌ حينَ تَنظُرُ",49,"ر",1,0],["فَقُمنَ يُبارينَ السُدولَ بِوافِرٍ","يُلاعِبُ عِطفَيهِ الجَريرُ وَدافِعُ",50,"ع",1,0],["فَقُم تَرَ ما دَهاها مِن شِقاءٍ","وَمِثلُكَ لَيسَ يُعييهِ القِيامُ",51,"م",1,0],["فَقُمتُ إِلى طِرفٍ مِنَ الخَيلِ لَم يَبِت","مُذالاً وَلَم تُقفِر عَلَيهِ المَذاوِدُ",52,"د",1,0],["فَقُمتُ مِنهُ خائِفاً مُرتاعا","وَقُلتُ ناموا وَيحَكُم سِراعا",53,"ع",2,0],["فَقُمتُ أَفرِشُ خَدَّي في الطَريقِ لَهُ","ذُلّاً وَأَسحَبُ أَذيالي عَلى الأَثَرِ",54,"ر",1,0],["فَقُم يا رَسولي فَاِلقَها غَير