{"poems":[[53,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[26,"أصبح من أم عمرو بطن مر فأج","https://www.aldiwan.net/poem24101.html","البسيط"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[47,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[68,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[33,"عاود القلب من تذكر جمل","https://www.aldiwan.net/poem41275.html","الخفيف"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[69,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[50,"أنزف دمعي طول تسكابه","https://www.aldiwan.net/poem10782.html","السريع"],[50,"دع لباكيها الديارا","https://www.aldiwan.net/poem63264.html","مجزوء الرمل"],[50,"غننا بالطلول كيف بلينا","https://www.aldiwan.net/poem65279.html","الخفيف"],[50,"اسقني يا ابن أذين","https://www.aldiwan.net/poem65290.html","مجزوء الرمل"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[47,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[285,"صرت بين الصادين يا بن المجلي","https://www.aldiwan.net/poem60731.html","الطويل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[422,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[500,"ما كان ليلي ليلا","https://www.aldiwan.net/poem9881.html","المجتث"],[543,"قلت يوما لها وكنت حياتي","https://www.aldiwan.net/poem47923.html","عموديه"],[580,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109133","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79875","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202558","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98163","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205009","الخفيف"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117975","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111471","الخفيف"],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5897,"ندى","https://www.poetsgate.com/ViewPoem.aspx?id=176414",""],[6093,"حبذا اللهو وأيام الصغر","https://www.poetsgate.com/ViewPoem.aspx?id=215106",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["ثم شيءٌ عرفْتَهُ بالتَّجَاري","ب وأخلصتَه بكشف الغطاءِ",0,"ا",2,0],["ثُم شَرِبنَ بِنَبطٍ والجِمالُ كَأَن","نَ الرَشحَ منهُنَّ بِالآباطِ أَمساحُ",1,"ح",1,0],["ثم شبت بين الفريقين حرب","كثرت في الغمار منها الجراح",2,"ح",1,0],["ثُمَّ شُقّوا الجُيوبَ قَد قَرُبَ الأَم","رُ وَاِتِّساعُهُ كَأَبي الدُروكِ",3,"ك",1,0],["ثُمَّ شاغَلتُهُ وَأَرسَلتُ فيلي","مِنجَنيقاً يَرمي عَلى القِطعَتَينِ",4,"ن",1,0],["ثُمَّ شَكَّت فَلَستُ أَعرِفُ مِنها","مِقَةً لي وَلا قِلىً مُستَبينا",5,"ن",2,0],["ثُمَّ شَدُّوهُ بالإِزَارِ فخِلْنا","هُ الْخَيالِيَّ مِنْ وَرَاءِ السِّتَارَهْ",6,"ر",2,0],["ثم شَرَّفْتُ مسْمَعِي بِتُؤَامٍ","وَفُرادَى مِنْ دُرِّهِ المَنثُورِ",7,"ر",1,0],["ثُمَّ شَدا لَمّا جَرَت كَأسُهُ","صِرفاً وَمَرَّت بَينَ أَترابِهِ",8,"ب",2,0],["ثُمَّ شُجَّت فَأَدارَت","فَوقَها طَوقاً فَدارا",9,"ر",2,0],["ثُمَّ شُجَّت فَاِستَضحَكَت عَن لَآلٍ","لَو تَجَمَّعنَ في يَدٍ لَاِقتُنينا",10,"ن",2,0],["ثُمَّ شُجَّت فَأَدارَت","فَوقَها مِثلَ العُيونِ",11,"ن",1,0],["ثُمَّ شامَ الفِراخَ فَاِرتَدَّ فَارمَد","دَ فَشَقَّ الغَميرَ بَعدَ الغَميرِ",12,"ر",1,0],["ثُمّ شابَ الدّجى وخافَ من الهجْ","رِ فغَطّى المَشيبَ بالزّعفرانِ",13,"ن",1,0],["ثم شئتَ العذاب لي ولماذا","لم تجرني منه وأنت المجير",14,"ر",1,0],["ثم شاءوا المجدَ فيما يُقتَنَى","حِلْيةً تُضفي على البيتِ جَمالا",15,"ل",2,0],["ثُمَّ شُقُّوا الْجُيُوب قَدْ","الأَمْرُ واتِّساعه كأَبيّ الدروك",16,"ك",1,0],["ثم شامَتْ منه برقا صادقا","لم يكن منذ خَفَا بالْخُلَّب",17,"ب",1,0],["ثُمَّ شِينَيْنِ شُؤْمِ جَدٍّ وَشِعْرٍ","لَمِغِيضٍ فِيهِ يَنابِيعُ كُنْفِ",18,"ف",1,0],["ثم شاءَ الزمان أن يتمنى","فتمنّى لعوديَ التحطيما",19,"م",2,0],["ثم شِمْنا برق المكارم قد لا","ح سناه من بين تلك المباسم",20,"م",1,0],["ثم شربنا وطبنا","حتى انقضى الليل شطرا",21,"ر",2,0],["ثُمَّ شَدَّت بساعِدي واستَحالت","صارماً عَضباً مُصلَتاً في يَميني",22,"ن",2,0],["ثم شَابَ العِذَارُ عَنيِّ ويكفي","كَ مشيبُ العِذَارِ عِنْد العَذارَى",23,"ر",2,0],["ثم شنوا الغارة الشعواءَ يج","نونها أرواحنا جني",24,"ي",1,0],["ثمَّ شفعتَ الوعدَ في إيصاله","مُكرِّراً لم لا عليَّ تَعتمد",25,"د",1,0],["ثم شَدّوا على المعارِفِ من لَفحِ","السمومِ البرودَ بالأذيالِ",26,"ل",1,0],["ثم شعشعتها فلم اتبين","هي في الكأس أم الكاس فيها",27,"ي",3,0],["ثمَّ شُمُطرَه عِندَ ذِي الأَلبابِ","هذي صفاتي لَكَ بالصَّوابِ",28,"ب",1,0],["ثم شفوا بالحديد انفسهم","منك ولم يربعوا على احد",29,"د",1,0],["ثم شاء الزمان أن نتلاقى","إذ حباني الزمان عيشا رضيا",30,"ي",2,0],["ثم شببنا النار واصطلينا","ومذ ركبنا بعد ذا ولينا",31,"ن",2,0],["ثم شمالي السادة البخشيه","ضريح شيخ كامل المزيه",32,"ه",1,0],["ثم شكوه عاجلاً للشحنة","وربما تمت عليه محنة",33,"ه",1,0],["ثم شريك أو عدوّ إذا","أنكرت والطبع بذا حاكم",34,"م",1,0],["ثم شوقتني الى طلب العلم","لأسمو به على أقراني",35,"ن",2,0],["ثم شددنا فيه قبل الظّهر","إلى الفُرَيشِ في أشد الحرِّ",36,"ر",1,0],["ثُمَّ شَحُّوا فِي وَاضِعِ الرُّكنِ مِنهُم","وَبِمِثلِهِ تَبخَلُ الأسرِيَاءُ",37,"ا",2,0],["ثم شاةً بيضاء أقبل ينحر","وذووه من بعد أن سلخوها",38,"ه",2,0],["ثم شادوا الضريح إذ دفنوها","وحواليه أوقفوا الأرصادا",38,"د",2,0],["ثُمَّ شادَ الأَبوابَ لكِن أَراهُ","مِن لِقا هَكطُرَ المُدَمِّرِ راعِس",39,"س",1,0],["ثم شارك عطر ثوبي او غلب به","كنني جالس معه فتره طويله",40,"ل",2,0],["ثمّ شوفي لو هو طرف العين بالظلمات نام","ذِيبي لعبه شفاتك فوق فمّّي كالعصير",41,"ر",1,0],["ثم شع النور في شرق العرب","وأشرقت شمس الفضيله بالصلات",42,"ت",1,0],["ثم شبّت نبتة ميمونة","أخذت من كل مجد موعدا",43,"د",2,0],["ثم شبينا وحالوا بيننا","وأرى العمر على الحب خطر",44,"ر",1,0],["ثم شَدّت من أزرهم بلفيف ٍ","من فلولِ الشُذّاذِ والأ ُبّاقِ",45,"ق",1,0]]}