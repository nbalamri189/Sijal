{"poems":[[5,"لا يستوي الأخوان أما بكرنا","https://www.aldiwan.net/poem291.html",""],[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[94,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[47,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[46,"أصب بحميا كأسها مقتل العذل","https://www.aldiwan.net/poem29689.html","الطويل"],[46,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[54,"أسرع البرد هجوما","https://www.aldiwan.net/poem27236.html","مجزوء الرمل"],[48,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54892","الرمل"],[108,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[47,"سَقاني القَهْوَةَ السّلْسَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=32066",""],[119,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[189,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[295,"حسب قلبي من الحزن","https://www.aldiwan.net/poem11681.html","مجزوء الخفيف"],[382,"حاشاكم من وصمة تزري بكم","https://www.aldiwan.net/poem59368.html","الكامل"],[409,"يا رفاقا حلوا بأكناف صنعا","https://www.aldiwan.net/poem33687.html","الخفيف"],[473,"أخمد من أحزاننا ما اضطرم","https://www.aldiwan.net/poem59705.html","السريع"],[482,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[558,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130621","الطويل"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104409","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121996","البسيط"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107344","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137952",""],[2603,"","https://poetry.dctabudhabi.ae/diwan/poem/134215","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58352","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109822","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99524","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59503","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102955","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17757","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111060","الكامل"],[4146,"","https://poetry.dctabudhabi.ae/diwan/poem/204097","الطويل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4912,"أخمد بحلمك ما يذكيه ذو سفه","https://www.poetsgate.com/ViewPoem.aspx?id=181780",""],[4955,"إن السعادة سرها الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=201568",""],[4976,"دموع شموع","https://www.poetsgate.com/ViewPoem.aspx?id=207689",""],[5688,"أخ ما أنجبته الأم","https://www.poetsgate.com/ViewPoem.aspx?id=200689",""],[5943,"سلاح الضعفِ","https://www.poetsgate.com/ViewPoem.aspx?id=61782",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""]],"verses":[["أَخُمَاعَ لَو أَصبَحتِ وَسطَ رِحالِهِم","عَرَفَت خُماعَةُ أَنَّها لا تُخفَرُ",0,"ر",1,0],["أَخْمَدَ المَوْتَ ذَلِكَ العَزْمَ فِي","نَدْبٍ عَلَى الضَّيْمِ سَاعَةً لا يُقِيمُ",1,"م",1,0],["أَخْمَدوا صَوْتَهُ الإِلهيَّ بالعَسْفِ","أَماتوا صُدَاحَهُ وَنُواحَهْ",2,"ح",2,0],["أَخٌ ماغَيَّرَ العَهدَ ال","لَذي كانَ وَلا بَدَّل",3,"ل",1,0],["أَخمَدتُ بِالإِدلاجِ أَنفاسَ الفَلا","وَكَحَلتُ طَرفي في الظَلامِ بِسُهدِهِ",4,"د",2,0],["أَخَمسَةُ أَحوالٍ مَضَت لِمَغيبِهِ","وَشَهرانِ بَل يَومانِ نِكلٌ مِنَ النِكلِ",5,"ل",1,0],["أَخمَدتَهُ وَالدَهرُ مِن خَطبِهِ","كَأَنَّما أُضرِمَ فيهِ الوَطيس",6,"س",1,0],["أَخمَدَ النارَ وَلَم تُط","فَأ فَصارَت ذَهَبا",7,"ب",2,0],["أَخَمسينَ قَد أَفنَيتُها لَيسَ نافِعي","بِتَأخيرِ يَومٍ أَن أَعَضَّ عَلى خَمسي",8,"س",2,0],["أخمدتُ فوق شفاههنّ شبيبتي","وذبحتُ بين عيونهنَّ غرامي",9,"م",2,0],["أخمرٌ ونار لقد ضاق بي","كِياني وأوشِكُ أن أختنِقْ",10,"ق",1,0],["أَخْمِدُوا الأَنْفَاسَ هَذَا جُهْدُكمْ","وَبِه مَنْجاتُنَا مِنْكُمْ فَشكْرَا",11,"ر",2,0],["أَخمدَا جذوةَ الخلاف بخُلْقٍ","يُطفئ النارَ كالنَّمير الزُّلال",12,"ل",1,0],["أخٌ مَا غَيّرَ العَهْدَ ال","ذي كانَ، وَلا بَدّلْ",13,"ل",1,0],["أخمد النار بالكرامة والعز","م وأخفى آثار سم الأفاعي",14,"ع",2,0],["أخملتَ ذِكْرَ السابقين ببعِضها","فَمديحُهم مهما ذكرتَ أَهاج",15,"ج",1,0],["أخمَدَت نار أضلعي","فهي من أقدس النعم",16,"م",1,0],["أخمدتمُ الكفرَ الفظيع بأرضكم","والهرطقاتِ وكن قبل نواشي",17,"ش",2,0],["آخ من دهرك الخؤون لقد صا","ر عدواً لذي الفضائل طبعا",18,"ع",2,0],["أَخمَدَ مِن أَحزانِنا ما اِضطَرَم","وَرَمَّ مِن أَفراحِنا ما اِنهَدَم",19,"م",1,1],["أخمرُ في الزجاجِ تدارُ وَهْناً","على النُّدماءِ أم في الكأْس نارُ",20,"ر",1,0],["أَخَمَدتَ بِالشَرقِ نيراناً مُؤَجَّجَةً","قَد كانَ عَزَّ عَلى الإِسلامِ مُخبيها",21,"ي",3,0],["اخ ماجد لم يرضه غير مجده","خليلا يرى فرضا عليه التوددا",22,"د",2,0],["أخ ماجد لم يخزه يوم مشهد","له عضد في الحادثات وساعد",23,"د",1,0],["أَخٌ مَوَدَّتُهُ فِي الَّلهِ صَادِقَةٌ","وَدِرْهَمٌ مِنْ حَلاَلٍ طَابَ مَكْسَبُهُ",24,"ه",1,0],["أخِماصٌ أنتُنَّ ظَمأى ولا يُن","كَرُ شَكوى من ظامِئٍ خَمصانِ",25,"ن",1,0],["اخمد النيل نارهَ بمفيضٍ","غامرٍ للبقاع والغيطان",26,"ن",1,0],["أخ ماجد ما دنس اللؤم عرضه","ولا خاط كشحيه على الغدر والمكر",27,"ر",1,0],["أخمَصهُ ما يزالُ فوق ال","فخار مثولهُ عندَ رأسي",28,"س",2,0],["أخمد الدهر من فؤادي جمرا","والآن الزمان مني صخرا",29,"ر",2,1],["أخٍ مزجت بروحي روحه جرى","مني كمجرى دمي في الجسم أفديه",30,"ي",2,1],["أخمدُ الهولَ إذا الهولُ عَلا","وأميتُ الجوع جَوداً والعَدَمْ",31,"م",1,0],["أخمِصُ الرِّجلِ قَد تَماسَكَ رَملٌ","وَطِئَتهُ وَلانَتِ الصَّفوَاءُ",32,"ا",2,0],["أخمد اللَه به ما اتقدا","سالكا نهج المعالي الأرشدا",33,"د",2,0],["أَخمدت في أَرضهم واسفاه","نارهم فاِستَملحوا ذاك الخمود",34,"د",1,0],["أخمدوها بصرف خمر الدنان","ولفيف الإخوان والخلان",35,"ن",1,0],["أخمدت النيران والنوآن","كهفهما أما يدمدمان",36,"ن",1,0],["أخمد شرارتها وارتد مجتنباً","هكطور لا تنخرط إياك وسطهم",37,"م",1,0],["أَخمَدَ أَنفاسَهُما وَراحا","مِن بَعدِ ذا يَستَلِبُ السِلاحا",38,"ح",2,0],["أَخٌ ماجِدٌ لَم يُخزِني يَومَ مَشهَدٍ","كَما سَيفُ عَمرٍو لَم تَخُنهُ مَضارِبُه",39,"ب",2,0],["أخمدت حر لهيبها","برضاك يا بحر العلوم",40,"م",1,0],["آخِ مَن شئتَ ثم رُمْ منه شيّاً","تلف من دون ما تروم الثريا",41,"ي",2,1],["أخملت ذكر قيصر وتبع","لم تبق في قوس العلى من منزع",42,"ع",1,0],["أخمد بحلمك ما يذكيه ذو سفه","من نار غيظك واصفح إن جنى جاني",43,"ي",1,1],["أخمد إلهي الجمرَ في كبدي","فالرَّأس فيه الشَّيبُ يشتعلُ",44,"ل",1,0],["أخمدتُ ثورةَ عقلٍ كان منتوياً","للصدِّ صداً وللحرمانِ حرمانا",45,"ن",2,0],["أخ ما أنجبته الأمّ كلّا","أخ جادت عليّ به الإماء",46,"ا",2,0],["أخمائل الأشعارِ في روضِ الفِكرْ","هل للجمالِ سوى السماعِ أو النظرْ؟",47,"ر",1,1],["أَخْمَدتِ ضَوءَ الكَوْكبِ الوقَّادِ منْ","آفاقِهِ وأمَلْتِ طَوْدَ النَّادِي",48,"د",2,0]]}