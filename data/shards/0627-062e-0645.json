{"poems":[[5,"لا يستوي الأخوان أما بكرنا","https://www.aldiwan.net/poem291.html",""],[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[94,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[47,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[46,"أصب بحميا كأسها مقتل العذل","https://www.aldiwan.net/poem29689.html","الطويل"],[46,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[54,"أسرع البرد هجوما","https://www.aldiwan.net/poem27236.html","مجزوء الرمل"],[48,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54892","الرمل"],[108,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[47,"سَقاني القَهْوَةَ السّلْسَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=32066",""],[118,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[188,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[293,"حسب قلبي من الحزن","https://www.aldiwan.net/poem11681.html","مجزوء الخفيف"],[380,"حاشاكم من وصمة تزري بكم","https://www.aldiwan.net/poem59368.html","الكامل"],[406,"يا رفاقا حلوا بأكناف صنعا","https://www.aldiwan.net/poem33687.html","الخفيف"],[470,"أخمد من أحزاننا ما اضطرم","https://www.aldiwan.net/poem59705.html","السريع"],[479,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[555,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/17757","الطويل"]],"verses":[["أَخُمَاعَ لَو أَصبَحتِ وَسطَ رِحالِهِم","عَرَفَت خُماعَةُ أَنَّها لا تُخفَرُ",0,"ر",1,0],["أَخْمَدَ المَوْتَ ذَلِكَ العَزْمَ فِي","نَدْبٍ عَلَى الضَّيْمِ سَاعَةً لا يُقِيمُ",1,"م",1,0],["أَخْمَدوا صَوْتَهُ الإِلهيَّ بالعَسْفِ","أَماتوا صُدَاحَهُ وَنُواحَهْ",2,"ح",2,0],["أَخٌ ماغَيَّرَ العَهدَ ال","لَذي كانَ وَلا بَدَّل",3,"ل",1,0],["أَخمَدتُ بِالإِدلاجِ أَنفاسَ الفَلا","وَكَحَلتُ طَرفي في الظَلامِ بِسُهدِهِ",4,"د",2,0],["أَخَمسَةُ أَحوالٍ مَضَت لِمَغيبِهِ","وَشَهرانِ بَل يَومانِ نِكلٌ مِنَ النِكلِ",5,"ل",1,0],["أَخمَدتَهُ وَالدَهرُ مِن خَطبِهِ","كَأَنَّما أُضرِمَ فيهِ الوَطيس",6,"س",1,0],["أَخمَدَ النارَ وَلَم تُط","فَأ فَصارَت ذَهَبا",7,"ب",2,0],["أَخَمسينَ قَد أَفنَيتُها لَيسَ نافِعي","بِتَأخيرِ يَومٍ أَن أَعَضَّ عَلى خَمسي",8,"س",2,0],["أخمدتُ فوق شفاههنّ شبيبتي","وذبحتُ بين عيونهنَّ غرامي",9,"م",2,0],["أخمرٌ ونار لقد ضاق بي","كِياني وأوشِكُ أن أختنِقْ",10,"ق",1,0],["أَخْمِدُوا الأَنْفَاسَ هَذَا جُهْدُكمْ","وَبِه مَنْجاتُنَا مِنْكُمْ فَشكْرَا",11,"ر",2,0],["أَخمدَا جذوةَ الخلاف بخُلْقٍ","يُطفئ النارَ كالنَّمير الزُّلال",12,"ل",1,0],["أخٌ مَا غَيّرَ العَهْدَ ال","ذي كانَ، وَلا بَدّلْ",13,"ل",1,0],["أخمد النار بالكرامة والعز","م وأخفى آثار سم الأفاعي",14,"ع",2,0],["أخملتَ ذِكْرَ السابقين ببعِضها","فَمديحُهم مهما ذكرتَ أَهاج",15,"ج",1,0],["أخمَدَت نار أضلعي","فهي من أقدس النعم",16,"م",1,0],["أخمدتمُ الكفرَ الفظيع بأرضكم","والهرطقاتِ وكن قبل نواشي",17,"ش",2,0],["آخ من دهرك الخؤون لقد صا","ر عدواً لذي الفضائل طبعا",18,"ع",2,0],["أَخمَدَ مِن أَحزانِنا ما اِضطَرَم","وَرَمَّ مِن أَفراحِنا ما اِنهَدَم",19,"م",1,1],["أخمرُ في الزجاجِ تدارُ وَهْناً","على النُّدماءِ أم في الكأْس نارُ",20,"ر",1,0],["أَخَمَدتَ بِالشَرقِ نيراناً مُؤَجَّجَةً","قَد كانَ عَزَّ عَلى الإِسلامِ مُخبيها",21,"ي",3,0],["أَخٌ ماجِدٌ لَم يُخزِني يَومَ مَشهَدٍ","كَما سَيفُ عَمرٍو لَم تَخُنهُ مَضارِبُه",22,"ب",2,0]]}