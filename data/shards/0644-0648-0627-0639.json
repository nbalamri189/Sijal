{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[55,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[65,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[95,"النجم في عليائه خافقٌ","https://www.aldiwan.net/poem9835.html","السريع"],[90,"لواعج الهم في جنبي تضطرم","https://www.aldiwan.net/poem44812.html","البسيط"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[53,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[93,"لي صاحب دخل الغرور فؤاده","https://www.aldiwan.net/poem8722.html","عموديه"],[47,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[30,"لو أعلم الأيام راجعة لنا","https://www.aldiwan.net/poem5276.html","الطويل"],[68,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[46,"نبئت عتبة يعوي كي أشاتمه","https://www.aldiwan.net/poem30053.html","البسيط"],[83,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42682","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54623","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[123,"ملك ترويك منه شيمة","https://www.aldiwan.net/poem4344.html","الرمل"],[139,"ريب المنون وصرف الدهر أعياني","https://www.aldiwan.net/poem49155.html","البسيط"],[151,"عن الحب ما لي كلما رمت سلوانا","https://www.aldiwan.net/poem47620.html","الطويل"],[159,"كم زفرات وكم دموع","https://www.aldiwan.net/poem55639.html","مخلع البسيط"],[164,"لي منكم يا كهف الملوك والدول","https://www.aldiwan.net/poem58757.html","الرجز"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[215,"يا قلب هذا هوى جديد","https://www.aldiwan.net/poem46563.html","مخلع البسيط"],[230,"إن ما بت تشتكي منه داء","https://www.aldiwan.net/poem55207.html","الخفيف"],[266,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[303,"صنع الجميل وفعل الخير إن أثرا","https://www.aldiwan.net/poem36309.html","عموديه"],[572,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88610","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59707","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144106","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46675",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109209","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121989","الطويل"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130232","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126222","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100278","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48300","الخفيف"],[3785,"","https://poetry.dctabudhabi.ae/diwan/poem/107317","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44639","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101382","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146765","المنسرح"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33336","البسيط"],[4778,"لكل شيءٍ أوان","https://www.poetsgate.com/ViewPoem.aspx?id=191070",""],[4978,"إليكمُ سال من وجدانيَ القلم","https://www.poetsgate.com/ViewPoem.aspx?id=177291",""],[5087,"لو أعرض الناس كلهم وأبوا","https://www.poetsgate.com/ViewPoem.aspx?id=96357",""],[5186,"خلوا عقيم البحث في خلخالها","https://www.poetsgate.com/ViewPoem.aspx?id=156494",""],[5397,"ليلة ميلاد الزكي المجتبى","https://www.poetsgate.com/ViewPoem.aspx?id=157910",""],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[5409,"فقد الناس فيك ثبتاً إماماً","https://www.poetsgate.com/ViewPoem.aspx?id=155481",""],[5431,"بلقيس...","https://www.poetsgate.com/ViewPoem.aspx?id=204633",""],[5459,"عام يودعنا","https://www.poetsgate.com/ViewPoem.aspx?id=195045",""],[5484,"ثمرة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=206308",""],[5648,"انا اسف","https://www.poetsgate.com/ViewPoem.aspx?id=155191",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[5875,"صراخ المهابيل","https://www.poetsgate.com/ViewPoem.aspx?id=211769",""],[5942,"هزي بجذع حنيني","https://www.poetsgate.com/ViewPoem.aspx?id=215683",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6056,"صبر أيوب","https://www.poetsgate.com/ViewPoem.aspx?id=130343",""],[6056,"أبدع المنظوم","https://www.poetsgate.com/ViewPoem.aspx?id=156714",""]],"verses":[["لَواعِجُ الشَوقِ تُخطيهِم وَتُصميني","وَاللَومُ في الحُبِّ يَنهاهُم وَيَغريني",0,"ن",2,1],["لَواعِجٌ أَفصَحَت عَنها الدُموعُ وَقَد","كادَت تُجَمجِمُها الأَحشاءُ وَالضِلَعُ",1,"ع",1,0],["لواعِجُ الحبِّ أُخْفيها وأُبْديها","والدّمْعُ يَنشُرُ أسراري وأطْويها",2,"ي",3,1],["لو أعطى المرء على قدره","لكان ما يوهب مما تهب",3,"ب",1,0],["لواعج الهمّ في جنبيّ تضطرم","والهم مِقداره من أهله الهمم",4,"م",1,1],["لو أعرضَ البحرُ دون مكرُمةٍ","لحَدَّث النفسَ أنه يَثِبُهْ",5,"ب",2,0],["لو أعرض البحر دون مكرمةٍ","وليس للبحر مَعْبر ضَبرَه",6,"ر",2,0],["لو أُعير الزمانُ ما في ابنِ موسَى","من وفاءٍ لما تفانت قرونه",7,"ن",2,0],["لو أعيرَ الحُسامُ ما في ابن موسى","من صفاءٍ لما جلته قيونه",7,"ن",2,0],["لَو أُعجِبَ القَمَرُ المُنيرُ بِنَفسِهِ","لَرَأَيتَهُ يَهوي إِلى الغَبراءِ",8,"ا",2,0],["لَو أَعرَبَ النَجمُ عَن مَناقِبِهِ","لَم يَتَجاوَز أَحسابُنا حَسَبُه",9,"ب",2,0],["لَو أَعلَمُ الأَيّامَ راجِعَةً لَنا","بَكَيتُ عَلى أَهلِ القِرى مِن مُجاشِعِ",10,"ع",1,1],["لَو أَعارَ الظَلامَ أَخلاقَهُ الغُر","رَ لَأَغنَت بِهِ عَنِ النَيِّراتِ",11,"ت",1,0],["لَوِ اِعتَدى أَعوَجٌ يَعدو بِهِ المَرَطى","أَو لاحِقٌ لَتَمَنّى أَنَّهُ وَتَدُ",12,"د",1,0],["لَو أَعرَبَت طاعَةٌ عَن طائِعٍ شَهِدَت","بِأَنَّها لَكَ طَوقٌ لَيسَ تَخلَعُهُ",13,"ع",2,0],["لَوَاعِبُ بِالأَسْمَاءِ يَبْتَدِرُونَهَا","سَفَاهاً وَبِالأَلْقَابِ فَهْيَ بَضَائِعُ",14,"ع",1,0],["لَوْ أُعْطِيَ الْمَرءُ عَلَى قَدْرِهِ","لَكَانَ مَا تُوْهَبُ مِمَّا تَهِبْ",15,"ب",1,0],["لَو أَعَزَّ المُقَامَ قَرْب مِنَ النَّا","سِ إِذَنْ هَانَ فِي الجِبَالِ ثِبيرُ",16,"ر",1,0],["لو اعج لا يهدئها التأسي","ولا يطفأن من سح الشئون",17,"ن",1,0],["لواعجٌ هي إنْ أبديتَها شَرَرٌ","يُصلي اللسانَ وانْ اخفيتَها سَقَم",18,"م",1,0],["لو أعارَ السهمَ ما في رأيِهِ","من سدادٍ وهُدى لم يَصِفِ",19,"ف",1,0],["لو أعِطى الحرّ فيها قدر قيمتهِ","لما وقفنا مع الأعدا بميدانِ",20,"ن",1,0],["لواعج لو أن البحار جميعها","صببن لكان الحر أضعاف ما كانا",21,"ن",2,0],["لَوْ أَعْشَبَ الخَدُّ مِنْ دُمُوعٍ","لَكانَ في خَدِّيَ الرَّبيعُ",22,"ع",1,0],["لو اعرتني لحظك فرد نظرة","أدركت أقصى السؤل منها والأمل",23,"ل",1,0],["لَوِ اِعتَسَفتَ الأَرضَ فَوقَ مَتنِهِ","يَجوبُها ما خِفت أَن يَشكو الوَجى",24,"ا",1,0],["لواعجٌ ثار بي شجاها","والناس من غفلةٍ هجود",25,"د",1,0],["لَو أُعِدَّت لِلصامِتين العَطايا","أُغرِقَ البُكمُ إِذ يَفيضُ العطاء",26,"ا",2,0],["لو اعتبر الرائي مواقع لفظها","تيقن ان السحر في الشعر يجمع",27,"ع",1,0],["لو أَعْوَزَ الماءُ أَصحابي سقيتهم","دمي وَلست عَلَى العِلاَّت معتذرا",28,"ر",2,0],["لَوْ أَعْرَضَتْ مَعْشُوقَةٌ عَنْ عَاشِقٍ","إِعْرَاضَهُ عَنِّي لَكَانَ يَهِيْمُ",29,"م",1,0],["لَو أعرتَ البُدُورَ ضَوءَك ما نمَّ","عَلَيها ما نمَّ عندَ السِّرار",30,"ر",1,0],["لَو أَعارت أَخلاقك الغر قَوماً","لألانت من الوَرى كل جبس",31,"س",1,0],["لو أعادوا عليَّ رجْع سلام","لم يكونوا إلى الجوَى أسلموني",32,"ن",2,0],["لو أُعطيَ الدّسْتُ لساناً فنطقْ","لقال: تاجُ الملكِ بي منكم أحقّ",33,"ق",1,1],["لو أُعطيَ الدّستُ لِسانا فنطَق","لقال تاجُ الملكِ بي منك أحق",34,"ق",1,1],["لو اعوزته وأحبست أنفاسه","لغدا بها ثملا بغير شراب",35,"ب",1,0],["لَوَاعِبَ مَا بَيْنَ الْخِيَامِ يَحُفُّهَا","كُمَاةٌ بِأَطْرَافِ الرِّمَاحِ لَوَاعِبُ",36,"ب",1,0],["لو أعظم الحدثان شيئاً قبله","بعد النبيّ به لكنت المعظما",37,"م",2,0],["لواعج شوقي في مُحرِقَاتِ شَغَافِهِ","دُمُوعى على صحنِ الخُدودِ سوائِلُ",38,"ل",1,0],["لو اعترضته خجلة من محبه","تدبج ورد من حيا بخدود",39,"د",1,0],["لو أعَرْتِ القَبولَ عَرْفاً وطيباً","لمْ يهُبَّ النّسيمُ إلا بَليلا",40,"ل",2,0],["لَوَاعِجُ أَحزانِي وَنَارُ تَلَهُّفي","يُؤجِّجُها فِي القَلبِ ما عِشتُ شاعِلُه",41,"ل",2,0],["لَواعجُ صَبٍّ إِذا اللَيل أَرخى","ذوائبه غابَ مُنجِدهُ",42,"د",2,0],["لو اعطي الدنيا لما","جذبته زينتها فيظعن",43,"ن",1,0],["لو أعتب الدهر من يعاتبه","ولان للعاذلين جانبه",44,"ب",2,1],["لو أعينُ الوهمِ ترميهِ بأضعفِها","أثَّرنَ في خدهِ من رقةٍ أثَرا",45,"ر",2,0],["لو أُعطيَ الأرض طُرّا لابتغى زُحلا","ولن يُراضى إذا ما غادر الطمعا",46,"ع",2,0],["لواعج الشوق قد سالت صُهارَتها","كما البراكين تحكي هولها الحِمَمُ",47,"م",1,0],["لو أعرض الناس كلهم وأبوا","لم ينقصوا رزقي الذي قسما",48,"م",2,1],["لو أعقب استبسالها بعنادها","خيرا لصلينا، على استبسالها",49,"ل",3,0],["لو أعين الدنيا عليه اطلعت","لامتلأ الجنان منها رعبا",50,"ب",2,0],["لو أعير الفؤاد مني جناها","كامن الوجد بالخفوق أطاره",51,"ر",2,0],["لو أعالي لبنان يشعرن فيه","ساعة اجتاز لانحنين احتراما",52,"م",2,0],["لو أُعطيَ النارَ مخبولٌ سيطلقها","دون احتسابٍ بفحوى اللعب مهووسُ",53,"س",1,0],["لو اعتصمنا بحبل الله في ثقة ٍ","لَاسَّاقَطَ الخيرُ في أوطاننا رُطبا ..",54,"ب",2,0],["لواعجُ أحزانٍ وآلامُ فرقةٍ","قد اعتَوَرا قلبي فكيف يكون؟",55,"ن",1,0],["لو اعرف اكذب .. لعيش العمر حوت","لكن انا سلطان مامثل الدور",56,"ر",1,0],["لو أعشق .. تختلف الدنيا","في وجهي .. وتضيع القِبلة",57,"ل",2,0],["لو أعتزي على صرااااخ.. المهابيل","من..مالكين العرف نلت الزريه",58,"ي",2,0],["لواعجُ الحبِّ في الدنيا لها أمَدٌ","وعندي الحبُّ دفّاقٌ ويزدهرُ",59,"ر",1,0],["لو أعدّد همومي وأضرب ابهن مثال","ماهقيت إن قافي ، يشمل المحتوى",60,"و",2,0],["لو أعدّد وصوفك ، ما توفر مجال","كل خوفي تصيبك ، نظرة الحاسدين",61,"ن",1,0],["لو أعددّ ،، ماحوى حسن الفتاة","ماهقيت ،، إن القوافي تستجيب",62,"ب",1,0]]}