{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[74,"ربع لعزة صامت لا يفهم","https://www.aldiwan.net/poem19680.html","الكامل"],[66,"لا تسأمن مقالتي يا صاح","https://www.aldiwan.net/poem67570.html","الكامل"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[47,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[47,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[47,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[47,"ترى الليل يقضي عقبة من هزيعه","https://www.aldiwan.net/poem64683.html","الطويل"],[82,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[76,"يا راكضا في شوط كل سيادة","https://www.aldiwan.net/poem13197.html","الكامل"],[41,"إن بمعن إن فخرت لمفخرا","https://www.aldiwan.net/poem53693.html","الطويل"],[69,"تجنب أحاديث الحسود فواجب","https://www.aldiwan.net/poem18144.html","الطويل"],[48,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[41,"إنَّ بمعنٍ إنْ فخرتَ لمفخراً","https://www.poetsgate.com/ViewPoem.aspx?id=4336",""],[146,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[173,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[203,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[234,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[237,"لمن اللحاظ مريضة الأجفان","https://www.aldiwan.net/poem14748.html","الكامل"],[240,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[257,"فلا وصلها يبدو فتبلى بلا بلى","https://www.aldiwan.net/poem1427.html",""],[287,"كفى حزنا أني عن الحي سآل","https://www.aldiwan.net/poem32671.html","الطويل"],[325,"رعى الله أعضاء النيابة أنهم","https://www.aldiwan.net/poem67189.html","الطويل"],[347,"إليك إليك يا وطني","https://www.aldiwan.net/poem55317.html","مجزوء الوافر"],[382,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[382,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[408,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[412,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[412,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[415,"يا رب عفوا من مسيء","https://www.aldiwan.net/poem31618.html","عموديه"],[422,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[438,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[505,"متى قربت من الخمسين طرت إلى","https://www.aldiwan.net/poem38054.html","البسيط"],[520,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[520,"أنسيم عرفك أم شميم عرار","https://www.aldiwan.net/poem12150.html","الكامل"],[567,"قل للوزير إذا وقفت ببابه","https://www.aldiwan.net/poem52800.html","الكامل"],[572,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112431","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64069","الوافر"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129524","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59148","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59112","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108627","الوافر"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102047","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102074","المتقارب"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202172","الكامل"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71043","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42475","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42472","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53046","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53031","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121188","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45652","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200591","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205051","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132579","الكامل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89415","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52991","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62900","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48288","المتقارب"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45765","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129328","الطويل"],[3685,"","https://poetry.dctabudhabi.ae/diwan/poem/203147",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103058","الوافر"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138051","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139422",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86465","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136709",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5431,"حيدرة ...دعوة للمحبة","https://www.poetsgate.com/ViewPoem.aspx?id=204619",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5956,"أوحى له جبريل","https://www.poetsgate.com/ViewPoem.aspx?id=192632",""],[6069,"هذا الفراق وأنت شاهده","https://www.poetsgate.com/ViewPoem.aspx?id=105661",""],[6069,"متيقظٌ لولا تضرم بأسه","https://www.poetsgate.com/ViewPoem.aspx?id=105689",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[6259,"لمن الرسومُ بعرصة ِ البردانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59405&r=&rc=53",""],[6259,"إن الحمولَ غداة َ غربة غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59356&r=&rc=4",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["مُتَيَقِّظٌ لا القَلبُ يَفتُرُ هَمُّهُ","يَوماً وَلا الجَفنانِ يَنعَقِدانِ",0,"ن",1,0],["متيقّظ الآراء تحسب أنه","كلُّ الأمور لديه غيباً يُعلم",1,"م",1,0],["مُتَيَقِّناً مُتَصَبِّراً مُتَشَمِّراً","مُستَمطِراً مُتَقَصِّدِ السُيّاحِ",2,"ح",1,0],["مُتَيَقِّظٌ أبداً لفعلِ كريمةٍ","وعلى الطِّلابِ لشكرِها مُتساهي",3,"ه",2,0],["مُتَيَقِّظٌ حَفَظَت عَلَيهِ أُمورَهُ","حَرَكاتُ نَجدٍ في المَساعي أَيِّدِ",4,"د",1,0],["مُتَيَقِّظٌ عَصِمَت بَوادِرُ أَمرِهِ","بِعُرىً مِنَ الرَأيِ الأَصيلِ شِدادِ",5,"د",1,0],["مُتَيَقِّظُ الأَحشاءِ أَصبَحَ لِلعِدى","حَتفاً يُبيدُ وَلِلعُفاةِ رَبيعا",6,"ع",2,0],["مُتَيَقِّظاً كَالأُفعُوانِ نَفى الكَرى","عَن ناظِرَيهِ فَما يَذوقُ هُجوعا",6,"ع",2,0],["مَتى قِظتُ في شَرقِ البِلادِ فَإِنَّني","زَعيمٌ بِأَنَّ قَيظَهُ مِن رَبيعِهِ",7,"ع",2,0],["مُتَيَقِّظٌ ملأ الزمانَ لأهله","أمنْاً أنامَ به وخوفاً أسهَرا",8,"ر",2,0],["مُتَيَقّظُ العَزَمات تحسبُها","ينتابُها من خَوْفِهِ السّهَرُ",9,"ر",1,0],["مُتَيَقِّظاً تَندى حَواشي لَفظِهِ","سَلَساً وَيَلفَحُ فَهمُهُ إِحراقا",10,"ق",2,0],["مَتى قُدتَ يا اِبنَ العَنبَرِيَّةِ عُصبَةً","مِنَ الناسِ تَهديها فِجاجَ المَخارِمِ",11,"م",1,0],["مَتَى قال عَنِّي السُّوءَ عِنْدَكَ إنَّهُ","كذَاكَ يَقُولُ السُّوءَ عَنْكَ وَيَنْقُلُ",12,"ل",1,0],["مَتّى قَرقَرَ الهاتِفُ العِكرِمِيُّ","هَيَّجَ صَبّاً إِلى قَرقَرى",13,"ر",2,0],["متيقناً أن الحكومة كلها","أسرٌ يغلّ الناس واسترقاق",14,"ق",1,0],["مَتَى قُدْتَ يَا بْنَ العَنْبَرِيَّة ِ عُصْبَة","ً مِنَ النَّاسِ تَهْدِيها فِجَاجَ المَخَارِمِ",15,"م",1,0],["متيقِّظٌ فمتى تُصِبه نَفثةٌ","للشكر في عُقَدِ المطامعِ يُسحَرِ",16,"ر",1,0],["متى قَدِمَتْ من سفرةِ الهجر عيسُهم","تلقيتُها بِالوَصلِ من كلِّ جانبِ",17,"ب",1,0],["مُتَيَقِّظُ العَزماتِ يُخبِرُ وَجهُهُ","عَن حَزمِهِ وَمَضائِهِ وَذكائِهِ",18,"ا",3,0],["متى قلتُ يا ليتني مرةً","لأمرٍ توجعتُ منها مرارا",19,"ر",2,0],["متى قطُّ أضحى عبد شمس كهاشمٍ","لقد قلَّ إنصاف وطال شِراد",20,"د",1,0],["مُتَيَقِّظٌ لِلقَتلِ ناعِسُ طَرفِهِ","وَيلاهُ مِن مُتَيَقِّظٍ نَعسانِ",21,"ن",1,0],["مُتَيَقِّظٌ يَرعى الرَعايا طَرفُهُ","وَهُمُ رُقودٌ في المَضاجِعِ نُوَّمُ",22,"م",1,0],["مَتى قَصَدت في طُرقها دونَ عزه","فَلا اِنفرجت عَن سَهلِ أَمرٍ حزونُها",23,"ن",3,0],["مَتى قابَلَ العافونَ غُرَّةَ وَجهِهِ","تَلَقّاهُمُ مِنهُ قَبولٌ وَإِقبالُ",24,"ل",1,0],["مَتى قامَ فينا أَيُّهُم بِخَطابَةٍ","لَدَفَعَ خِصامٌ أَو لِشَرحِ حَقيقَةِ",25,"ه",1,0],["متى قد طال منتظري","متى قد عيل مصطبري",26,"ر",2,0],["متى قرعت صلاتُهم الليالي","أزالت يأسَ مرذول الفعال",27,"ل",1,0],["متى قرع الأسحارَ صوتُ صلاتهم","أزال من الخاطي إياساً وتعبيسا",28,"س",2,0],["مُتَيقّناً جورَ الغَرامِ وأَنّ مَا","يُرْوَى عَن المقَلِ المراضِ صَحيحُ",29,"ح",1,0],["متيقناً أَنَّ الثَناءَ مخلد","بآقٍ وَأَنَّ المال شَيءٌ فاني",30,"ن",2,0],["مُتَيَقِّظٌ في كُلِّ جارِحَةٍ لَهُ","مَخصوصة قَلب وَعين تَنظُرُ",31,"ر",1,0],["متَيقظ أَخشى عَلَيهِ إِذا ارتأى","مِن رأيهِ المتوقد المُتَلَهِّبِ",32,"ب",1,0],["متيقن أن سوف يصلى","النار إن لم تعف عنه",33,"ه",1,0],["متيقظ الأفكار يدرك رأيه","ما لم يكن بالظنّ والتخمين",34,"ن",1,0],["متيقظٌ فطنٌ أغرُّ مهذبٌ","جمُّ العطايا صادقٌ في الموعدِ",35,"د",1,0],["متى قَرُبْتَ من الخمسينَ طِرْتَ إلى","رِحابِ حالي ولاحَتْ فيكَ بارِقتي",36,"ي",1,1],["متيقظ حزماً يصيب فرأيه","أبداً على ليل الخطوب نهار",37,"ر",1,0],["متيقناً أني بقصدك لم أغب","عنها ولا عن مجلس السفار",38,"ر",1,0],["مُتَيقِّظٌ للدَّهرِ ينظرُ ما بدا","منهُ ولا يَخَفى عليهِ ما اختَفى",39,"ف",2,0],["مُتَيَقَّظُ العَزَماتِ يَجْ","تَنِبُ الكَرَى إلاّ غِرَارَهْ",40,"ر",2,0],["متيقناً أن الفضائل للفتى","مثلَ السلاح بهن عنه يذود",41,"د",1,0],["متيقظ نجد وملء إهابه","شرف ومجد طيب الأردان",42,"ن",1,0],["متى قِسنا إليكمْ ذا","ندىً ماضٍ ومؤتَنَف",43,"ف",1,0],["متى قنص البوم البزاة أم استوى","حضيض الثرى فوق النجوم الثواقب",44,"ب",1,0],["مُتَيَقِّظُ العَزَمَاتِ لَكِن سَيْفه","قَدْ قَامَ في جفنِ الأمَانِ بِهِ وَقَرْ",45,"ر",1,0],["متيقِّظٌ عُصِمَتْ بوَادرُ أمْره","بعزَائمٍ يَقْتَادُهَا العِرْفَانُ",46,"ن",1,0],["متى قال الجهاد منِ ابن بوحي","وقال الناس اللهم نصرا",47,"ر",2,0],["متى قال مشتاق لمدح بنظمه","صلاة وتسليم على خير مرسل",48,"ل",1,0],["متى قال صب وزمزم وحاد","وساق المطايا بظعن وحاد",49,"د",1,0],["مُتَيَقِّظاً في صَوْن مُلْكِهما الذي","عَزَماته جيشٌ لَدَيْه عَرْمرمُ",50,"م",1,0],["متى قستها بالمنى جاءتا","سواءً كما جاءت الأبلمه",51,"م",2,0],["مُتَيَقِّناً أَنَّ المَنِيَّةَ مَنْزِلٌ","لا بُدَّ ينزله بحُكْمٍ لازمِ",52,"م",1,0],["متى قابلتْ خدّاً أثار شُعَاعُهُ","بقلبيَ ناراً لا تَمَلُّ من الوقدِ",53,"د",1,0],["متى قلتُ هذا الصَّدغُ أبدى عقارباً","وإنْ رمتُ أجني الوردَ أحماهُ بالجمرِ",54,"ر",1,0],["متيقظ العزمات وهو مهوم","متبسم في الحادث المتقطب",55,"ب",1,0],["متيقظ العزمات في الأزمات لا يحت","ل مقلة عينه إغفاء",56,"ا",2,0],["متى قال قف للبدر لم يك آفلا","وغب فهو من دون الكواكب غائب",57,"ب",1,0],["مُتَيَقِظات في المَسير كَأَنَّها","باتَت تُناجي بِالَّذي يَتَوَقع",58,"ع",1,0],["متى قلت شُعراً أستشرْ فيه فكرتي","فلي حكمٌ من فكرتي ليس يرحم",59,"م",1,1],["متى قلت اتئد بالقرع وارفق","فقد حطمت لي بالقرع راسي",60,"س",2,0],["متيقظ لا يعتري اجفانه","الا غراراً في الظلام هجود",61,"د",1,0],["مَتى قُلتُ أَبغي الأَمرَ قالَ ليَ اِصطَبِر","وَإِن رُمتُ فِعلَ البِرِّ فَهوَ مُحارِبي",62,"ب",2,0],["متى قلت مظلومٌ حسابي يقول لي","سهوتُ بتهليل فأسجد للسهو",63,"و",1,0],["مَتى قِسْتَه بِفَرْدٍ منهم ظلمته","فقد زينت كلَّ الملوك خلالُه",64,"ل",2,0],["متى قلت فيما ساءني أَنتَ مذنبٌ","اِليَّ وفيما ضرَّني أَنتَ ضائِرُ",65,"ر",1,0],["متَى قصدَتهُ الجيادُ التي","تُضمّرها نالتِ المَقْصَدا",66,"د",2,0],["مَتى قامَ بي شَوق رَمَتني عَوائق","مِن القَدر الجاري فَأَصبَحَت مَقعَدا",67,"د",2,0],["متى قاصرات الطرف يبصرن خدرها","تيقن شمسا حجبت بمغيب",68,"ب",1,0],["متيقِّظٌ فإذا استُضِي","فَ به يصيرُ من النِّيامِ",69,"م",1,1],["متى قيست به الاشراف هانت","وأين الخف من شرف السنام",70,"م",1,0],["مَتى قرَّ فِي غمْدٍ حُسامٌ وَبانَ عَنْ","حِصانٌ لِجامٌ وَالْفَتى غَرَضُ الْبَلا",71,"ل",2,0],["مُتَيَقِّظاً كَالعادِلِ المُلكِ الَّذي","تَعنو المُلوكُ لِعَزمِهِ المُتَوَقِّد",72,"د",1,0],["متيقظاً حذراً وما يخشى العدى","نبهان من وسنات ليل الهاجع",73,"ع",1,0],["متيقظ للعز ناظره","يخشى ويرجى ضر أو نفعا",74,"ع",2,0],["متيقظ للفتك ناعس طرفه","من منصفي من ناعس يقظان",75,"ن",1,0],["متى قال قالَ الدهرُ سمعاً وطاعةً","وإن جالَ جالَ الموتُ بين عداته",76,"ت",2,0],["متى قدروا عفوا كرما وبذلا","فنعم القادرون الباذلونا",77,"ن",2,0],["متى قلت لاء الوا اهذب جارتي","بحيلة نفسي فالذي جئته العمى",78,"م",2,0],["متى؟ قال: منتصف العام يا","طموحات هُزي فم الأغنية",79,"ي",2,0],[": متى قُطعتْ حبائلنا؟؟","وحبل الله إسورتي!!",80,"ر",3,0],["متى قال حادينا رويداً فبينكم","وبين الحمى مقدار يومين أو أدنى",81,"ن",2,0],["مُتيقّناً أنّي اُحبُّكَ طالما","نبضٌ بقلبيَ مُخلصٌ مُتفانِ",82,"ن",1,0],["متيقّناً أن الحفيظ يُعِينهُ","في دعوةٍ تسمو بها الجوزاءُ",83,"ا",2,0],["متيقظٌ ورث الكمال فما","يخشى اعتراض النقص زائده",84,"د",2,0],["متيقظٌ لولا تضرم بأسه","كاد الوشيج على يديه يورق",85,"ق",1,1],["متى قَلِقِي هذا يَعودُ سِكِينَةً","فَأَرْتَدُّ مِنْها بالحقيقةِ أَجْهَرُ؟!",86,"ر",1,0],["متيقناً أن الثناء مخلَّد","باقٍ وأن المال شيء فان",87,"ن",1,0],["متيقظ أخثى عليهِ إذا ارتأى","من رأيهِ المتوقّد المتلهب",88,"ب",1,0],["مَتَى قُطِعَتْ حِبَالُ اللهِ فِينَا","تَفَرَّقْنَا وَإِنْ كُنَّا أُلُوفَا",89,"ف",2,0]]}