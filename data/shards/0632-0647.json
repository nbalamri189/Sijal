{"poems":[[24,"بكرت علي بسحرة تلحاني","https://www.aldiwan.net/poem21887.html","الكامل"],[86,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[35,"تلهو فتختضع المطي أمامها","https://www.aldiwan.net/poem39141.html","الكامل"],[93,"هذا أديب العرب","https://www.aldiwan.net/poem9794.html","عموديه"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[30,"ألا حي الدار قفرا جنوبها","https://www.aldiwan.net/poem29610.html","الطويل"],[88,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[88,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[88,"أرى بغداد من بعد أغبرار","https://www.aldiwan.net/poem44976.html","الوافر"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[23,"هل سر أولاد اللقيطة أننا","https://www.aldiwan.net/poem21401.html","الكامل"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[72,"تذكرت مصرا والأخلاء والدهرا","https://www.aldiwan.net/poem18713.html","الطويل"],[72,"يا صاحبا صحبت معارفه الورى","https://www.aldiwan.net/poem18790.html","الكامل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[70,"لحاظك أمضى من المرهف","https://www.aldiwan.net/poem42815.html","المتقارب"],[78,"زهر الأسنة في الهيجا غدت زهري","https://www.aldiwan.net/poem14261.html","البسيط"],[89,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[89,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[89,"أعظم شأن أبيات أتتني","https://www.aldiwan.net/poem45083.html","الوافر"],[85,"في ذي الجفون صوارم الأقدار","https://www.aldiwan.net/poem7894.html","الكامل"],[85,"إلى حسين حاكم القنال","https://www.aldiwan.net/poem63688.html","الرجز"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[45,"كم ليلة فيك بت أسهرها","https://www.aldiwan.net/poem63639.html","المنسرح"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[45,"قف العيس قد أدنى خطاها كلالها","https://www.aldiwan.net/poem65539.html","الطويل"],[28,"إلى ملك ما أمه من محارب","https://www.aldiwan.net/poem5115.html","الطويل"],[61,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[49,"لهفي على الزمن القصير","https://www.aldiwan.net/poem64191.html","مجزوء الكامل"],[66,"زار والليل مؤذن بالبراز","https://www.aldiwan.net/poem38491.html","الخفيف"],[66,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[66,"أهلا بها كالقضب في كثبانها","https://www.aldiwan.net/poem41343.html","الكامل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[44,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[44,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[44,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem30617.html","الطويل"],[87,"ديني الحنيف وربي الله","https://www.aldiwan.net/poem8200.html","أحذ الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[33,"زها جسم ليلى في الثياب كما زها","https://www.aldiwan.net/poem25953.html","الطويل"],[33,"زها جسم ليلى في الثياب تنعما","https://www.aldiwan.net/poem25954.html","الطويل"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[81,"أهدى نسيم الصباح","https://www.aldiwan.net/poem61390.html","المجتث"],[40,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"زهر الروض بنت دمع الغمام","https://www.aldiwan.net/poem69020.html","الخفيف"],[48,"نعزي أمير المؤمنين محمدا","https://www.aldiwan.net/poem63356.html","الطويل"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[48,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"زهدت جنان في الذي","https://www.aldiwan.net/poem64320.html","مجزوء الكامل"],[46,"زهوي على المرء فوقي متلف على","https://www.aldiwan.net/poem22534.html","البسيط"],[46,"قد باشروك بمكروه أديت به","https://www.aldiwan.net/poem22664.html","البسيط"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85498","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39588","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20992","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54975","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54575","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54528","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55189","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55022","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142036","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141992","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54206","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54307","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[96,"إمرأة وشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17498",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[90,"سبحان من خلق الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=179013",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[45,"أتَرَاكَ تَسْمَعُ، للحَمَامِ الهُتَّفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32843",""],[46,"زهوي على المرءِ، فوقي، متلِفٌ، وعلى","https://www.poetsgate.com/ViewPoem.aspx?id=20082",""]],"verses":[["زَهراءُ مُقلَتُها تَردّدَّ فَوقَها","عِندَ المُعَرَّسِ مُدلِجُ القِردانِ",0,"ن",1,0],["زَهِدتَ فيها وَهامَ العابِدونَ لَها","بِجَمعٍ فانٍ يُعاني جَمعَهُ فاني",1,"ي",1,0],["زَهِدتَ عَلى شُهرَةٍ طَبَّقَت","وَجاهٍ أَظَلَّ وَفَضلٍ بَهَر",2,"ر",1,0],["زَهَرَت أَخلاقُكُم فَابتَسَمَت","كَاِبتِسامِ الوَردِ عَن لُؤلُؤِ طَلّ",3,"ل",1,0],["زَهِمُ المَشاشِ مِنَ النَواشِطِ بِاللَوى","أَو بِالجَنابِ رَأَينَ أَسهُمَ عائِرِ",4,"ر",1,0],["زَهَتْ بِهِ زَهْوَ مَنْ","سَعَى فَنَالَ الأَرَبْ",5,"ب",1,0],["زُهْرٌ مَآثِرُهُمْ زَهْرٌ مَفَاخِرُهُمْ","فِي مُجْتَلَى الْحِلْمِ أَوْ فِي مُجْتَنَى الْحِكَمِ",6,"م",1,0],["زَهَرٌ ذَابِلٌ كَأَنّي أَرَاهُ","ثَمِلاً مِنْ أَنْفَاسِهِ فِي الْكَمَائِمْ",7,"م",1,0],["زَهْرَةٌ لَمْ تَكَدْ تُوفِي رَبِيعاً","ذَبُلَتْ وَاللِّدَاتُ لُدْنٌ نَوَاعِمْ",7,"م",1,0],["زَهاليلُ أَشباهٌ كَأَنَّ هَوِيَّها","إِذا نَحنُ أَدلَجنا هَوِيُّ جَهامِ",8,"م",1,0],["زَهالِيلُ لا يَعبُرنَ خَرقاً سَبَحنَهُ","بِأَكوارِنا إِلا وَهُنَّ عَواسِرُ",9,"ر",1,0],["زَهاليلَ نَجوات إِذا ما تَناطَحَت","لَنا بَينَ أَجوازِ الفَيافي سُهوبُها",10,"ب",3,0],["زهرة قد بدت من الأكمام","فتجلّى مها الجمال السامي",11,"م",2,1],["زهرة تبهج النواظر حسناً","ورواءً وتنعش الروح طيبا",12,"ب",2,0],["زهت بكبيرها أدباً وعلماً","زهت بطبيب علّتها المداوي",13,"ي",1,0],["زُهرٌ أصِحَّاءُ لا حَدِيثُهم","واهٍ ولا في قَدِيمِهم عَطَبُ",14,"ب",1,0],["زَهواً بِكُلِّ مُقَلِّصٍ وَطِمِرَّةٍ","في كُلِّ مُعتَرَكٍ عَطَفنَ وَوادِ",15,"د",1,0],["زها أفقُ مصرَ بتدبيرهِ","فطالعَها أبداً يزهر",16,"ر",1,0],["زهى غصنه حتى إذا خيفت الوغى","رنا وانثنى كالسيف والصعدة السمرا",17,"ر",2,0],["زهراء معلمة إذا لاقيتها","لاقيت منها العيش أبيض أخضرا",18,"ر",2,0],["زهت رياض الملك من حين ما","هزَّت من الأقلامِ أغصانه",19,"ن",2,0],["زهراء خضراء الإهاب معجبه","ممَّا ثوت بين الرياض المعشبه",20,"ه",1,0],["زهى الملكُ والإسلامُ ممن مضى له","بخمسة آباءٍ لهم منه سادس",21,"س",1,0],["زَهرَةٌ لَكِنَّها لَم تُقطَفِ","وَجَمالُ الزَهرِ في رَوضَتَيهِ",22,"ه",1,0],["زُهِقَت أَرواحُهُم في شَكلِ ماء","لِلأَسى لِلَّهِ ما أَقسى الحِمام",23,"م",1,0],["زَهَدَ الناسُ حينَ دارَت عَلَيهِم","بِالَّتي في كُؤوسِهِم وَالقَنانِ",24,"ن",1,0],["زَها وَردُ خَدَّيكَ لَكِنَّهُ","بِغَيرِ النَواظِرِ لَم يُقطَفِ",25,"ف",1,0],["زُهرُ الأَسِنَّة في الهَيجا غَدَت زَهري","غَرَستُ أَشجارَها مُستَجزِلَ الثَمَرِ",26,"ر",1,1],["زهرة حشوها جمال وعرف","نبقت من بين الحصى والرمال",27,"ل",1,0],["زهره باسم للحن القماري","فيلذ الانظار والاسماعا",28,"ع",2,0],["زهت أبيات شعرك حين وافت","كما تزهو لناظرها النجوم",29,"م",1,0],["زهراءُ بالأفق الذي من دونه","وثب النهى وتطاول الأفكار",30,"ر",1,0],["زَهرُكَ لَيسَ لِلزُهورِ رَونَقُهُ","تَكادُ مِن فَرطِ اِعتِناءٍ تَخلُقُهُ",31,"ه",1,0],["زَهراءَ عَونِ العاشِقينَ عَلى الهَوى","مُختارَةِ الشُعَراءِ في آذارِ",32,"ر",1,0],["زَهِدتُ الَّذي في راحَتَيكَ وَشاقَني","جَوائِزُ عِندَ اللَهِ مُبتَغَياتُ",33,"ت",1,0],["زَها بِهِ تاجُها وَتاهَ بِهِ","سَريرُها المُعتَلى وَمَنبَرُها",34,"ر",3,0],["زُهرٌ إِذا اِلتَهَبَت بِهِم شُعلُ الظُبا","عَطَفوا عَلى أولى القَنا المُتَعَطِّفِ",35,"ف",1,0],["زَهَت سُرَّ مَن را بِالخَليفَةِ جَعفَرٍ","وَعادَ إِلَيها حُسنُها وَجَمالُها",36,"ل",3,0],["زُهَيرٌ وَمَروانُ الحِجازِ كِلاهُما","أَبوها لَها أَيّامُهُ وَمَآثِرُه",37,"ر",2,0],["زُهْرٌ إذا صَافَحْنَ سَمْعَ مُعاندٍ","خَفَضَ الكلامَ وغَضَّ طَرْفاً خاشِعا",38,"ع",2,0],["زهرةٌ غَضَّةُ النَّسيمِ غَذَاها","صفوُ ماءِ العلومِ والآدابِ",39,"ب",1,0],["زَهراءَ مِثلِ الكَوكَبِ الدُرِّي","يِ في كَفِّ المُديرِ",40,"ر",1,0],["زَهَرٌ في حَوادِثِ النَقعِ حَتّى","يَجعَلُ الخَيلَ كَالنَعامِ النَوازي",41,"ز",2,0],["زَهَتِ الدُنيا حينَ أَصبَحَ فيها","فَغَدَت وَهيَ لِلسَماءِ تُوازي",41,"ز",2,0],["زُهرٌ إِذا أَرخى الظَلامُ سُتورَهُ","فَعَلَت بِها كَصَحيفَةِ المُتَلَمِّسِ",42,"س",1,0],["زُهرٌ حَكَت خَدَّ الحَبيبِ وَإِنَّما","تَحكي فُؤادَ الصَبِّ في خَفَقانِها",43,"ن",3,0],["زُهْرٌ خَبَتْ أنوارُهَا فَكَأَنَّها","سُرُجُ المَشاكي عُولِجَت بِخُمودِ",44,"د",1,0],["زهد الغناةُ من الغنى في جودِهِ","ولراحتَيه بِبَذله إِلحاحُ",45,"ح",1,0],["زَهرَةٌ غَضَّةٌ تَفَتَّقَ عَنها ال","مَجدُ في مَنبِتٍ أَنيقِ الجَنابِ",46,"ب",1,0],["زَهراءَ أَحلى في الفُؤادِ مِنَ المُنى","وَأَلَذَّ مِن ريقِ الأَحِبَّةِ في الفَمِ",47,"م",1,0],["زُهراً إِذا طَلَعَت عَلى حُجُبِ الكُلى","نَحَسَت وَإِن غابَت تَكونُ سُعودا",48,"د",2,0],["زَهِدتُ وَزُهدي في الحَياةِ لِعِلَّةٍ","وَحُجَّةُ مَن لا يَبلُغُ الأَمَلَ الزُهدُ",49,"د",1,0],["زَهَتِ الْقُلُوبُ بِنُورِ حِكْمَتِهِ","وَتَعَطَّرَتْ بِالذِّكْرِ أَفْوَاهُ",50,"ا",2,0],["زهدتَ في زينةِ الدنيا لآخرةٍ","والليلُ إن طالَ غالَ اليومَ بالقصرِ",51,"ر",1,0],["زَها جِسمُ لَيلى في الثِيابِ كَما زَها","مَعَ الغُصنِ غَضٌّ قَد تَزايَدَ عودُها",52,"ه",2,1],["زَها جِسمُ لَيلى في الثِيابِ تَنَعُّماً","فَيا لَيتَني لَو كُنتُ بَعضَ بُرودِها",53,"د",3,1],["زَهَتِ البِلادُ وما فَتِئْنَ هوامداً","ومضى الزّمانُ وما بَرِحْن حِرارا",54,"ر",2,0],["زَهرٌ وَظِلٌّ وَنَهرُ","وَشادِنٌ وَرَحيق",55,"ق",1,0],["زَهراءُ يَسمُو لِلعَلاءِ بِها","آباؤُها وَعَقائِلٌ زُهرُ",56,"ر",1,0],["زَهِدُوا في الدُّنَا فما عُرِفَ المَي","لُ إلَيْهَا منهم وَلا الرَّغْبَاءُ",57,"ا",2,0],["زهرُ الروض بنتُ دمعِ الغمام","وبكاءُ الغمامِ لا من غَرَامِ",58,"م",1,1],["زَهَت بِأَميرِ المُؤمِنينَ مُحَمَّدٍ","أَسِرَّةُ مُلكٍ وَاستَقَرَّت مَنابِرُ",59,"ر",1,0],["زَهَرٌ يَطيرُ فَراشُهُ","كَتَساقُطِ الدُرِّ النَثيرِ",60,"ر",1,0],["زَها بِالخَصيبِ السَيفُ وَالرُمحُ في الوَغى","وَفي السِلمِ يَزهو مِنبَرٌ وَسَريرُ",61,"ر",1,0],["زَهِدَت جِنانٌ في الَّذي","رَغِبَت إِلَيها فيهِ نَفسي",62,"س",2,1],["زَهوي عَلى المَرءِ فَوقي مُتلِفٌ عَلى","مِثلي غَباً وَعَلى مَن دونَهُ أَشَرُ",63,"ر",1,1],["زَهوُ التَكَبُّرِ لا زَهوُ النَخيلِ بِهِم","وَالنَبعُ لَيسَ بِمَجنِيٍّ مِنَ العُشرِ",64,"ر",1,0],["زَهْرَاءُ يحلُمُ في العواصفِ جمرُها","وتَقَرّ إلا هَزّةَ الأعْطافِ",65,"ف",1,0],["زهر أَراه باسماً","فوق الأباطح والأكام",66,"م",1,0],["زهر به ثغر الروابي باسم","والجو منه معطر الأردان",67,"ن",1,0],["زهوٌ تملَّكني فأذهلني","ومن الذهولِ طرائفُ المُلحِ",68,"ح",1,0],["زهراتٌ مثَّلتْ عشّاقها","بعيونٍ غرِقاتٍ في كراها",69,"ا",3,0],["زهراتي تلك ما كانت سوى","شهواتٍ جسميَ الطاغي نماها",69,"ا",3,0],["زهَاهَا العُريُ فاستحيتْ","عُيونَ الناسِ في البرِّ",70,"ر",1,0],["زَهَرَاتُكِ الحُمْرُ التي أسْلمْتِها","بيديْ مودِّعةٍ يمينَ مُودِّعِ",71,"ع",1,1],["زهرةٌ أطلعها فردوسُ حُبِّكْ","استشفَّتْ فجرَها من ناظريكْ",72,"ك",1,0],["زهو الصناديد بني الجلاد","ونفخة بالقوم والميلاد",73,"د",1,0],["زهراء في قرطبة تألق","بغداد منها اقتبستْ وجلق",74,"ق",1,0],["زَهمُ الصُّلبِ ربَاعٌ جانِبٌ","مارِحُ الآخِر مِنهُ قَد نَجم",75,"م",1,0],["زَهْرٌ يَرفُّ عَلَى كَمَائِمِهِ","وَنَدَىً يَشِفُّ وَمُزْنَةٌ تَكِفُ",76,"ف",1,0],["زُهْرٌ تَأَلَّقُ بِالْفَضَاءِ كَأَنَّهَا","حَبَبٌ تَرَدَّدَ فِي غَدِيرٍ مُتْرَعِ",77,"ع",1,0],["زَهْرٌ يَرِفُّ عَلَى الْغُصُونِ وَطَائِرٌ","غَردُ الْهَدِيرِ وَجَدْوَلٌ زَخَّارُ",78,"ر",1,0],["زُهَيْرَاتٌ نَجَتْ عَجَباً","مِنَ الآفَاتِ وَالْعِلَلِ",79,"ل",1,0],["زَهَرَاتٌ بَائِعَاتٌ زهَراً","يَا لَقَوْمِي هَلْ دَرَيْتُمْ مَا تَبِيعْ",80,"ع",1,0],["زهَا سَامٍ بِمَوْلودٍ غلاَمٍ","فَصُنْ مَولودَهُ اللَّهُمَّ وَاحْرُسْ",81,"س",1,1],["زَهْوَ العَرُوسِ غَلاَ نِظَامُ حُلِيِّهَا","وَتَبَرَّجَتْ طُرُقَاتُهَا بِنِثَارِ",82,"ر",1,0],["زَهِيَ الشَّبَابُ بِأَنْ يُعَرِّ","بَ عَنْهُمُ زَيْنُ الشَّبَابِ",83,"ب",1,0],["زُهِيَتْ مَوَاعِظُهُ بِكُلِّ يَتِيمَةٍ","فِي كُلِّ دَاجِيَةٍ لَهَا لأْلاَءُ",84,"ا",2,0],["زَهِيَتْ مَعَالِمُهُ بِآيَاتِ النَّهى","مِنْ زَيِّ أَلْوَانٍ وَغُرِّ شُكُولِ",85,"ل",1,0],["زَهِيَتْ حَاضِرَةُ الْمُلْكِ وَقَدْ","وَسَمُوا بِاسْمِكِ فِيهَا شَارِعَا",86,"ع",2,0],["زهرةَ الوردِ صدرُ هند لكِ العرشُ","فهل تطمعينَ بعدُ بعرشِ",87,"ش",1,1],["زهرةٌ ملءُ عيونِ الأمَلِ","في الربى الخضراء",88,"ا",2,1],["زهر الطبيعةِ يبقى في أماكنهِ","وزهرهُ في فمِ الدنيا وأيديها",89,"ي",3,0],["زَهَّدَني في النَعيمِ حَتّى","يَدنُس ثَوبي فَلا أُنَقّي",90,"ي",1,0],["زَهرَةَ دُنيايَ حَليَ دَهري","غادَرتَ مَغنايَ كَالمَفازِ",91,"ز",1,0],["زَهَّدَني في الحَياةِ مَوتٌ","أَودى بِكسرى وَأَبروازِ",91,"ز",1,0],["زها الشرقُ إعجاباً به وبمثلِه","وقد عاش دهراً قبلَه يشتكي العُقْما",92,"م",2,0],["زُهِينَا على الدُّنْيا بِجامِعَةٍ غَدَتْ","حَدِيثاً بأُذْنِ الشَّرْقِ حُلْواً مُرَدَّدا",93,"د",2,0],["زَهَتْ دولةُ الطبِّ لمَّا شُفيتَ","وعاوَدَها الأملُ الناهضُ",94,"ض",1,1],["زَهَراتٌ تَتِيهُ بالغُصْنِ زَهْواً","وغُصونٌ تَتِيهُ بالزَّهَراتِ",95,"ت",1,0],["زهاها على الرياتِ أن انتصارَها","على الدهرِ لم يُقْسَم لعُرْبٍ ولا عُجْمِ",96,"م",1,0],["زُهِيَتْ مِصْرُ جمَالاً وَسَناً","بِأَبِي الأشْبالِ واهْتَزَّتْ رُباها",97,"ا",3,0],["زُهِيَ المهدُ فَمَنْ أنبأه","أنه يحوي العُلا والهِممَا",98,"م",2,0],["زهراتي تلك ، ما كنت سوى","شهوات ، جسمي الطاغي نماها",99,"ا",3,0],["زَها الوجودُ بذاك الوجهِ مفتخراً","واليوم يفخَر إذ يحظَى به العَدَم",100,"م",1,0],["زَهَرْت رياضك واجَتليتَ محَّلثاً","وصفت مياهك واحْتسيْتَ مرنقا",101,"ق",2,0],["زهوُ حُمْرِ القبِاب في الجبَلِ الأخضرِ","يَسبي كزهو أهلِ القباب",102,"ب",1,0],["زُهْرٌ، إذا التَهَبَتْ بهمْ شُعَلُ الظُّبَا","عِنْد اجتِماعِ الجَحفَلِ المُتَألِّفِ",103,"ف",1,0],["زهوي على المرءِ، فوقي، متلِفٌ، وعلى","مثلي، غَباً، وعلى منْ دونَه، أشرُ",104,"ر",1,1]]}