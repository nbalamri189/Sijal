,"الخفيف"],[459,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[462,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[462,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[462,"إذا ما سنى ملقاكم فات ناظري","https://www.aldiwan.net/poem16160.html","الطويل"],[462,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"شمت الظبى وسللت كل صحيفة","https://www.aldiwan.net/poem3172.html","عموديه"],[465,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[465,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[465,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[469,"زها بالخمائل من شعره","https://www.aldiwan.net/poem60088.html","المتقارب"],[469,"زها بصدغ وخد","https://www.aldiwan.net/poem60197.html","المجتث"],[501,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[501,"يا عيون النرجس الغض ألا","https://www.aldiwan.net/poem38029.html","الرمل"],[515,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[515,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[515,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[539,"فتحت في روضها زهرة","https://www.aldiwan.net/poem47421.html","عموديه"],[539,"ضاءتا كالفرقدين","https://www.aldiwan.net/poem47422.html","عموديه"],[539,"هنيئا بعرس سرور زها","https://www.aldiwan.net/poem47518.html","عموديه"],[559,"زينة الله منه حرز حريز","https://www.aldiwan.net/poem33549.html","الطويل"],[563,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[568,"عرش العلا منهدم مؤتفك","https://www.aldiwan.net/poem69561.html","الرجز"],[576,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[576,"زهادتي في جلستك","https://www.aldiwan.net/poem2820.html","مجزوء الرجز"],[576,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"],[576,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["زَهراءُ مُقلَتُها تَردّدَّ فَوقَها","عِندَ المُعَرَّسِ مُدلِجُ القِردانِ",0,"ن",1,0],["زَهِدتَ فيها وَهامَ العابِدونَ لَها","بِجَمعٍ فانٍ يُعاني جَمعَهُ فاني",1,"ن",2,0],["زَهِدتَ عَلى شُهرَةٍ طَبَّقَت","وَجاهٍ أَظَلَّ وَفَضلٍ بَهَر",2,"ر",1,0],["زَهَرَت أَخلاقُكُم فَابتَسَمَت","كَاِبتِسامِ الوَردِ عَن لُؤلُؤِ طَلّ",3,"ل",1,0],["زَهِمُ المَشاشِ مِنَ النَواشِطِ بِاللَوى","أَو بِالجَنابِ رَأَينَ أَسهُمَ عائِرِ",4,"ر",1,0],["زَهَتْ بِهِ زَهْوَ مَنْ","سَعَى فَنَالَ الأَرَبْ",5,"ب",1,0],["زُهْرٌ مَآثِرُهُمْ زَهْرٌ مَفَاخِرُهُمْ","فِي مُجْتَلَى الْحِلْمِ أَوْ فِي مُجْتَنَى الْحِكَمِ",6,"م",1,0],["زَهَرٌ ذَابِلٌ كَأَنّي أَرَاهُ","ثَمِلاً مِنْ أَنْفَاسِهِ فِي الْكَمَائِمْ",7,"م",1,0],["زَهْرَةٌ لَمْ تَكَدْ تُوفِي رَبِيعاً","ذَبُلَتْ وَاللِّدَاتُ لُدْنٌ نَوَاعِمْ",7,"م",1,0],["زَهاليلُ أَشباهٌ كَأَنَّ هَوِيَّها","إِذا نَحنُ أَدلَجنا هَوِيُّ جَهامِ",8,"م",1,0],["زَهالِيلُ لا يَعبُرنَ خَرقاً سَبَحنَهُ","بِأَكوارِنا إِلا وَهُنَّ عَواسِرُ",9,"ر",1,0],["زَهاليلَ نَجوات إِذا ما تَناطَحَت","لَنا بَينَ أَجوازِ الفَيافي سُهوبُها",10,"ب",3,0],["زهرة قد بدت من الأكمام","فتجلّى مها الجمال السامي",11,"م",2,1],["زهرة تبهج النواظر حسناً","ورواءً وتنعش الروح طيبا",12,"ب",2,0],["زهت بكبيرها أدباً وعلماً","زهت بطبيب علّتها المداوي",13,"ي",1,0],["زُهرٌ أصِحَّاءُ لا حَدِيثُهم","واهٍ ولا في قَدِيمِهم عَطَبُ",14,"ب",1,0],["زَهواً بِكُلِّ مُقَلِّصٍ وَطِمِرَّةٍ","في كُلِّ مُعتَرَكٍ عَطَفنَ وَوادِ",15,"د",1,0],["زها أفقُ مصرَ بتدبيرهِ","فطالعَها أبداً يزهر",16,"ر",1,0],["زهى غصنه حتى إذا خيفت الوغى","رنا وانثنى كالسيف والصعدة السمرا",17,"ر",2,0],["زهراء معلمة إذا لاقيتها","لاقيت منها العيش أبيض أخضرا",18,"ر",2,0],["زهت رياض الملك من حين ما","هزَّت من الأقلامِ أغصانه",19,"ن",2,0],["زهراء خضراء الإهاب معجبه","ممَّا ثوت بين الرياض المعشبه",20,"ه",1,0],["زهى الملكُ والإسلامُ ممن مضى له","بخمسة آباءٍ لهم منه سادس",21,"س",1,0],["زَهرَةٌ لَكِنَّها لَم تُقطَفِ","وَجَمالُ الزَهرِ في رَوضَتَيهِ",22,"ه",1,0],["زُهِقَت أَرواحُهُم في شَكلِ ماء","لِلأَسى لِلَّهِ ما أَقسى الحِمام",23,"م",1,0],["زَهَدَ الناسُ حينَ دارَت عَلَيهِم","بِالَّتي في كُؤوسِهِم وَالقَنانِ",24,"ن",1,0],["زَها وَردُ خَدَّيكَ لَكِنَّهُ","بِغَيرِ النَواظِرِ لَم يُقطَفِ",25,"ف",1,0],["زُهرُ الأَسِنَّة في الهَيجا غَدَت زَهري","غَرَستُ أَشجارَها مُستَجزِلَ الثَمَرِ",26,"ر",1,1],["زهرة حشوها جمال وعرف","نبقت من بين الحصى والرمال",27,"ل",1,0],["زهره باسم للحن القماري","فيلذ الانظار والاسماعا",28,"ع",2,0],["زهت أبيات شعرك حين وافت","كما تزهو لناظرها النجوم",29,"م",1,0],["زهراءُ بالأفق الذي من دونه","وثب النهى وتطاول الأفكار",30,"ر",1,0],["زَهرُكَ لَيسَ لِلزُهورِ رَونَقُهُ","تَكادُ مِن فَرطِ اِعتِناءٍ تَخلُقُهُ",31,"ه",1,0],["زَهراءَ عَونِ العاشِقينَ عَلى الهَوى","مُختارَةِ الشُعَراءِ في آذارِ",32,"ر",1,0],["زَهِدتُ الَّذي في راحَتَيكَ وَشاقَني","جَوائِزُ عِندَ اللَهِ مُبتَغَياتُ",33,"ت",1,0],["زَها بِهِ تاجُها وَتاهَ بِهِ","سَريرُها المُعتَلى وَمَنبَرُها",34,"ر",3,0],["زُهرٌ إِذا اِلتَهَبَت بِهِم شُعلُ الظُبا","عَطَفوا عَلى أولى القَنا المُتَعَطِّفِ",35,"ف",1,0],["زَهَت سُرَّ مَن را بِالخَليفَةِ جَعفَرٍ","وَعادَ إِلَيها حُسنُها وَجَمالُها",36,"ل",3,0],["زُهَيرٌ وَمَروانُ الحِجازِ كِلاهُما","أَبوها لَها أَيّامُهُ وَمَآثِرُه",37,"ر",2,0],["زُهْرٌ إذا صَافَحْنَ سَمْعَ مُعاندٍ","خَفَضَ الكلامَ وغَضَّ طَرْفاً خاشِعا",38,"ع",2,0],["زهرةٌ غَضَّةُ النَّسيمِ غَذَاها","صفوُ ماءِ العلومِ والآدابِ",39,"ب",1,0],["زَهراءَ مِثلِ الكَوكَبِ الدُرِّي","يِ في كَفِّ المُديرِ",40,"ر",1,0],["زَهَرٌ في حَوادِثِ النَقعِ حَتّى","يَجعَلُ الخَيلَ كَالنَعامِ النَوازي",41,"ز",2,0],["زَهَتِ الدُنيا حينَ أَصبَحَ فيها","فَغَدَت وَهيَ لِلسَماءِ تُوازي",41,"ز",2,0],["زُهرٌ إِذا أَرخى الظَلامُ سُتورَهُ","فَعَلَت بِها كَصَحيفَةِ المُتَلَمِّسِ",42,"س",1,0],["زُهرٌ حَكَت خَدَّ الحَبيبِ وَإِنَّما","تَحكي فُؤادَ الصَبِّ في خَفَقانِها",43,"ن",3,0],["زُهْرٌ خَبَتْ أنوارُهَا فَكَأَنَّها","سُرُجُ المَشاكي عُولِجَت بِخُمودِ",44,"د",1,0],["زهد الغناةُ من الغنى في جودِهِ","ولراحتَيه بِبَذله إِلحاحُ",45,"ح",1,0],["زَهرَةٌ غَضَّةٌ تَفَتَّقَ عَنها ال","مَجدُ في مَنبِتٍ أَنيقِ الجَنابِ",46,"ب",1,0],["زَهراءَ أَحلى في الفُؤادِ مِنَ المُنى","وَأَلَذَّ مِن ريقِ الأَحِبَّةِ في الفَمِ",47,"م",1,0],["زُهراً إِذا طَلَعَت عَلى حُجُبِ الكُلى","نَحَسَت وَإِن غابَت تَكونُ سُعودا",48,"د",2,0],["زَهِدتُ وَزُهدي في الحَياةِ لِعِلَّةٍ","وَحُجَّةُ مَن لا يَبلُغُ الأَمَلَ الزُهدُ",49,"د",1,0],["زَهَتِ الْقُلُوبُ بِنُورِ حِكْمَتِهِ","وَتَعَطَّرَتْ بِالذِّكْرِ أَفْوَاهُ",50,"ا",2,0],["زهدتَ في زينةِ الدنيا لآخرةٍ","والليلُ إن طالَ غالَ اليومَ بالقصرِ",51,"ر",1,0],["زَها جِسمُ لَيلى في الثِيابِ كَما زَها","مَعَ الغُصنِ غَضٌّ قَد تَزايَدَ عودُها",52,"ه",2,1],["زَها جِسمُ لَيلى في الثِيابِ تَنَعُّماً","فَيا لَيتَني لَو كُنتُ بَعضَ بُرودِها",53,"د",3,1],["زَهَتِ البِلادُ وما فَتِئْنَ هوامداً","ومضى الزّمانُ وما بَرِحْن حِرارا",54,"ر",2,0],["زَهرٌ وَظِلٌّ وَنَهرُ","وَشادِنٌ وَرَحيق",55,"ق",1,0],["زَهراءُ يَسمُو لِلعَلاءِ بِها","آباؤُها وَعَقائِلٌ زُهرُ",56,"ر",1,0],["زَهِدُوا في الدُّنَا فما عُرِفَ المَي","لُ إلَيْهَا منهم وَلا الرَّغْبَاءُ",57,"ا",2,0],["زهرُ الروض بنتُ دمعِ الغمام","وبكاءُ الغمامِ لا من غَرَامِ",58,"م",1,1],["زَهَت بِأَميرِ المُؤمِنينَ مُحَمَّدٍ","أَسِرَّةُ مُلكٍ وَاستَقَرَّت مَنابِرُ",59,"ر",1,0],["زَهَرٌ يَطيرُ فَراشُهُ","كَتَساقُطِ الدُرِّ النَثيرِ",60,"ر",1,0],["زَها بِالخَصيبِ السَيفُ وَالرُمحُ في الوَغى","وَفي السِلمِ يَزهو مِنبَرٌ وَسَريرُ",61,"ر",1,0],["زَهِدَت جِنانٌ في الَّذي","رَغِبَت إِلَيها فيهِ نَفسي",62,"س",2,1],["زَهوي عَلى المَرءِ فَوقي مُتلِفٌ عَلى","مِثلي غَباً وَعَلى مَن دونَهُ أَشَرُ",63,"ر",1,1],["زَهوُ التَكَبُّرِ لا زَهوُ النَخيلِ بِهِم","وَالنَبعُ لَيسَ بِمَجنِيٍّ مِنَ العُشرِ",64,"ر",1,0],["زَهْرَاءُ يحلُمُ في العواصفِ جمرُها","وتَقَرّ إلا هَزّةَ الأعْطافِ",65,"ف",1,0],["زهر أَراه باسماً","فوق الأباطح والأكام",66,"م",1,0],["زهر به ثغر الروابي باسم","والجو منه معطر الأردان",67,"ن",1,0],["زهوٌ تملَّكني فأذهلني","ومن الذهولِ طرائفُ المُلحِ",68,"ح",1,0],["زهراتٌ مثَّلتْ عشّاقها","بعيونٍ غرِقاتٍ في كراها",69,"ا",3,0],["زهراتي تلك ما كانت سوى","شهواتٍ جسميَ الطاغي نماها",69,"ا",3,0],["زهَاهَا العُريُ فاستحيتْ","عُيونَ الناسِ في البرِّ",70,"ر",1,0],["زَهَرَاتُكِ الحُمْرُ التي أسْلمْتِها","بيديْ مودِّعةٍ يمينَ مُودِّعِ",71,"ع",1,1],["زهرةٌ أطلعها فردوسُ حُبِّكْ","استشفَّتْ فجرَها من ناظريكْ",72,"ك",1,0],["زهو الصناديد بني الجلاد","ونفخة بالقوم والميلاد",73,"د",1,0],["زهراء في قرطبة تألق","بغداد منها اقتبستْ وجلق",74,"ق",1,0],["زَهمُ الصُّلبِ ربَاعٌ جانِبٌ","مارِحُ الآخِر مِنهُ قَد نَجم",75,"م",1,0],["زَهْرٌ يَرفُّ عَلَى كَمَائِمِهِ","وَنَدَىً يَشِفُّ وَمُزْنَةٌ تَكِفُ",76,"ف",1,0],["زُهْرٌ تَأَلَّقُ بِالْفَضَاءِ كَأَنَّهَا","حَبَبٌ تَرَدَّدَ فِي غَدِيرٍ مُتْرَعِ",77,"ع",1,0],["زَهْرٌ يَرِفُّ عَلَى الْغُصُونِ وَطَائِرٌ","غَردُ الْهَدِيرِ وَجَدْوَلٌ زَخَّارُ",78,"ر",1,0],["زُهَيْرَاتٌ نَجَتْ عَجَباً","مِنَ الآفَاتِ وَالْعِلَلِ",79,"ل",1,0],["زَهَرَاتٌ بَائِعَاتٌ زهَراً","يَا لَقَوْمِي هَلْ دَرَيْتُمْ مَا تَبِيعْ",80,"ع",1,0],["زهَا سَامٍ بِمَوْلودٍ غلاَمٍ","فَصُنْ مَولودَهُ اللَّهُمَّ وَاحْرُسْ",81,"س",1,1],["زَهْوَ العَرُوسِ غَلاَ نِظَامُ حُلِيِّهَا","وَتَبَرَّجَتْ طُرُقَاتُهَا بِنِثَارِ",82,"ر",1,0],["زَهِيَ الشَّبَابُ بِأَنْ يُعَرِّ","بَ عَنْهُمُ زَيْنُ الشَّبَابِ",83,"ب",1,0],["زُهِيَتْ مَوَاعِظُهُ بِكُلِّ يَتِيمَةٍ","فِي كُلِّ دَاجِيَةٍ لَهَا لأْلاَءُ",84,"ا",2,0],["زَهِيَتْ مَعَالِمُهُ بِآيَاتِ النَّهى","مِنْ زَيِّ أَلْوَانٍ وَغُرِّ شُكُولِ",85,"ل",1,0],["زَهِيَتْ حَاضِرَةُ الْمُلْكِ وَقَدْ","وَسَمُوا بِاسْمِكِ فِيهَا شَارِعَا",86,"ع",2,0],["زهرةَ الوردِ صدرُ هند لكِ العرشُ","فهل تطمعينَ بعدُ بعرشِ",87,"ش",1,1],["زهرةٌ ملءُ عيونِ الأمَلِ","في الربى الخضراء",88,"ا",2,1],["زهر الطبيعةِ يبقى في أماكنهِ","وزهرهُ في فمِ الدنيا وأيديها",89,"ي",3,0],["زَهَّدَني في النَعيمِ حَتّى"