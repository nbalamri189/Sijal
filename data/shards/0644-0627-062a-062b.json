{"poems":[[97,"رسالتها المترجمة","https://www.aldiwan.net/poem60152.html","عموديه"],[91,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[87,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[87,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[47,"لما استعنت على الخطوب بصالح","https://www.aldiwan.net/poem65624.html","الكامل"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[50,"وابأبي من إذا ذكرت له","https://www.aldiwan.net/poem66099.html","المنسرح"],[48,"لو أنني سميت طيفك صادقا","https://www.aldiwan.net/poem22137.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85679","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[190,"أيها الغر بالزما","https://www.aldiwan.net/poem43728.html","مجزوء الخفيف"],[202,"الجيش يملي نصره الملوان","https://www.aldiwan.net/poem51881.html","الكامل"],[333,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[438,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[469,"إن يوم النوى شنيع سماعه","https://www.aldiwan.net/poem3396.html","عموديه"],[473,"صيد السرور أجل من المعقول","https://www.aldiwan.net/poem60006.html","مجزوء الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87186","الرمل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34484","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54156","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77644","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145976","مجزوء الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102297","المنسرح"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52108","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52109","الخفيف"],[2553,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[2823,"","https://poetry.dctabudhabi.ae/diwan/poem/146730","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133045","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86524","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135625","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81261","المجتث"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139223","الخفيف"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139179","الرمل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35126","الرمل"],[4929,"حكمة ( عمل المعروف)","https://www.poetsgate.com/ViewPoem.aspx?id=199564",""],[5278,"يا نذير الشؤمِ...","https://www.poetsgate.com/ViewPoem.aspx?id=202542",""],[5376,"لا تثقلنَّ على عيدٍ منازلَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=205914",""],[2553,"يا دار عمرة","https://www.poetsgate.com/ViewPoem.aspx?id=1423",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5739,"من يسرق البلبل اجناحه","https://www.poetsgate.com/ViewPoem.aspx?id=126712",""],[5791,"حيود في نسق المحبرة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208644",""],[6102,"الحب في الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=182875",""],[6152,"دروب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=207353",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["لا تثر ذكرى هوانا ربما","نفرت عن مقلتيّ الوسنا",0,"ن",2,0],["لا تثق بالعباب قد فاض يرغى","فإذا غاض البحر غاض العباب",1,"ب",1,0],["لا تثق بالجمهور يا عقل يوما","ان رأي الجمهور غير سديد",2,"د",1,0],["لا تُثيبوها عَلى ما قَلَّدَت","مِن أَيادٍ حَسَداً أَو شَنَآنا",3,"ن",2,0],["لا تُثبِتُ العَينُ شَيئاً أَو تُحَقِّقُهُ","إِذا تَحَيَّرَ فيها الدَمعُ وَاِضطَرَبا",4,"ب",2,0],["لا تَثلِمُ الأَطماعُ فيهِ وَلا يُرى","بَينَ الخِيانَةِ وَالعَفافِ مُمَيَّلا",5,"ل",2,0],["لا تَثبُتُ الأَسوارُ حينَ تُقيمُها","إِلّا إِذا كانَت دَماً وَعِظاما",6,"م",2,0],["لا تَثنِني وَيكَ عَن مَحَبَّتِهِ","ما دامَ روحي مُصاحِباً بَدَني",7,"ن",2,0],["لا تُثبِتُ الأَقلامُ زَلَّةَ راقِدٍ","إِن كُنتَ بِتَّ بِحُلمِهِ مُرتابا",8,"ب",2,0],["لا تثق بالناس ما عا","شرتهم إلا قَليلا",9,"ل",2,1],["لا تثقن بالضياء منها","فإنما نورها ابنُ نارِ",10,"ر",1,0],["لا تثنينَّكُمُ المنايا إنها","سرُّ البقاءِ وسنةُ العمرانِ",11,"ن",1,0],["لا تثوروا على تُراثِ امرىء القيْ","سِ وصونوا ديباجةَ الذُبياني",12,"ن",2,0],["لا تُثبِت العينانِ أين مقرُّهُ","في الأرض لولا نقعُه المترفِّعُ",13,"ع",1,0],["لا تثق فيه بامرىء","لست من أهل جنسه",14,"س",2,0],["لا تَثْبُتُ الأقدامُ عند لقائهمْ","ولو أنَّهم حُملوا على ثهلان",15,"ن",1,0],["لا تثوري على الحياة فقد جفّ","ت زهور الحياة في راحتيك",16,"ك",1,0],["لا تثلبُنَّ سواكمُ في دائكم","فالنَتنُ ينشا من فساد طعام",17,"م",1,0],["لا تثْنِ جيدَك إنّ الروضَ قد جِيدا","ما عطّل القَطْرُ من نُوّارِه جيدا",18,"د",2,1],["لا تثبت العينان فيها لحظةً","إلا اختطاف الشمس تنصف آلا",19,"ل",2,0],["لا تثق بالهوى فقد رأتا","عيناك ماذا أحل مني خداعُه",20,"ع",2,0],["لا تَثنِ سَمعَكَ شَهوَةً","لِلطَيرِ عَن مَثنى وَزيرِ",21,"ر",1,0],["لا تَثق يَوماً بِخائنْ","فَهوَ في الإِيمان مائنْ",22,"ن",1,1],["لا تَثِق من فلانَةٍ قطُّ بالوع","دِ فَإِنَّ الوداد منها سَقيمُ",23,"م",1,1],["لا تِثقْ منه بودٍّ","إنّه يَهْواكَ أعمَى",24,"م",2,0],["لا تُثمر الأَشجار أَو لا تُنبت","إِلّا وَأَنتَ في التُراب مَيِّتُ",25,"ت",1,0],["لا تثقْ كلُّ مَنْ أتى","في (البساطيل) مُذعِنُ",26,"ن",1,0],["لا تثقلِ الجَسَدَ الدامي فتكسرهُ","برديٍّةٌ هوَ قد أسميتَهُ جَسَدَا",27,"د",2,0],["لا تثبت النفس على الانابة","لكل ما تكرهه كسابه",28,"ه",1,0],["لا تثن عطفاً إلى الوشاة فما","سلاك قلبي لكنهم عشقوا",29,"ق",3,0],["لا تثق بالكذوب واطلب صديقا","واشكر السعيّ إن ظفرت بواحد شاكر",30,"ر",1,0],["لا تثق بالكذوب واطلب صدوقا","واشكر السعي إن ظفرت بشاكر",31,"ر",1,0],["لا تُثمِروا المالَ لِلأَعداءِ إِنَّهُمُ","إِن يَظهَروا يَحتَووكُم وَالتِلادَ مَعا",32,"ع",2,0],["لا تثقلني بالزيارة إنني","أزداد من خجل ومن إفحام",33,"م",1,0],["لا تثق بالمنى فما كلُّ باغ","نال ما يرتجي ووفّى مرامه",34,"م",2,0],["لا تُثلمنكم خمرة","راووقها عَسلٌ وَخَلُّ",35,"ل",1,0],["لا تثنكريه فإنَّ صُفرَتَه","غَطَّت عليها دماءُ عَينَيهِ",36,"ه",1,0],["لا تَثِق بِالاِصلِ اِو تركن لَهُ","دونَ آداب بِها المَرءَ اِتَّصَل",37,"ل",1,0],["لا تثمروا الأفعال حتى تغتذي","أعراقها بدم الوتين الجاري",38,"ر",2,0],["لا تُثبتنْ لا تنفينْ لا تبطِلَنْ","بل صحِّحَنْ ولِتعدلنْ لا تبغيا",39,"ي",2,1],["لا تَثأَري مِن فُؤادي","كَفى بِدَمعي ثارا",40,"ر",2,1],["لا تثقل على جليس وخفف","إن من خف عد شخصاً نبيلا",41,"ل",2,0],["لا تثق بالود ممن تصطفي","كم صديق تصطفيه يتلفك",42,"ك",1,0],["لا تُثِرها فِتنَةً مِن رَبرَبٍ","تُرعِدُ الأُسدُ لَدَيهِ فَرَقا",43,"ق",2,0],["لا تَثِقْ في زهرِ اغصانِ الشَّجرْ","واضمنِ المعروفَ في جَنْيِ الثَّمَرْ",44,"ر",1,1],["لاَ تثِقْ يوماً بطيرٍ ناعقٍ","واعتبِرْ بالغَيرِ إنَّ الجهلَ عَيْ",45,"ي",1,0],["لا تثقلنَّ على عيدٍ منازلَهُ","أتى بودٍ فلا تنأى خمائله",46,"ل",2,1],["لا تثمروا المالَ للأعداء إنهم","إن يظفروا يحتووكم والتّلاد معا",47,"ع",2,0],["لا تُثْنِكَ العينُ مهما تَبدو شاخِصةً","إنَّ التميمةَ آيُ اللهِ والسُّوَرُ",48,"ر",1,0],["لا تُثيرا به كمائنَ صدرٍ","رَدَّدَتها الأحزانُ في أبياتِهْ",49,"ت",2,0],["لاتثني الغصن ... بالقوّه.","وتذرف لك أورود فوّاحه.",50,"ح",2,0],["لا تثقلي باللومِ نزفَ المحبرةْ","فالشعرُ ذنبٌ والقراءةُ مغفرةْ",51,"ر",2,1],["لَا تُثِيرُ الفُؤَادَ زِينَةُ عَقْلٍ","إِنَّما تَستَفِزُّنَا الأَثداءُ",52,"ا",2,0],["لا تثنك العثرات ؛ قاومها","فقد حُفت دروب المجد بالعثراتِ",53,"ت",1,0],["لا تثق في مزاعم ٍ ألبَسوها","حُسْنَ ديباجةٍ وحسنَ سِياق",54,"ق",1,0]]}