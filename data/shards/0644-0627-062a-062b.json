{"poems":[[97,"رسالتها المترجمة","https://www.aldiwan.net/poem60152.html","عموديه"],[91,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[87,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[87,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[47,"لما استعنت على الخطوب بصالح","https://www.aldiwan.net/poem65624.html","الكامل"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[50,"وابأبي من إذا ذكرت له","https://www.aldiwan.net/poem66099.html","المنسرح"],[48,"لو أنني سميت طيفك صادقا","https://www.aldiwan.net/poem22137.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85679","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[190,"أيها الغر بالزما","https://www.aldiwan.net/poem43728.html","مجزوء الخفيف"],[202,"الجيش يملي نصره الملوان","https://www.aldiwan.net/poem51881.html","الكامل"],[332,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[381,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[436,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[461,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[467,"إن يوم النوى شنيع سماعه","https://www.aldiwan.net/poem3396.html","عموديه"],[471,"صيد السرور أجل من المعقول","https://www.aldiwan.net/poem60006.html","مجزوء الكامل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[880,"يا دار عمرة","https://www.poetsgate.com/ViewPoem.aspx?id=1423",""]],"verses":[["لا تثر ذكرى هوانا ربما","نفرت عن مقلتيّ الوسنا",0,"ن",2,0],["لا تثق بالعباب قد فاض يرغى","فإذا غاض البحر غاض العباب",1,"ب",1,0],["لا تثق بالجمهور يا عقل يوما","ان رأي الجمهور غير سديد",2,"د",1,0],["لا تُثيبوها عَلى ما قَلَّدَت","مِن أَيادٍ حَسَداً أَو شَنَآنا",3,"ن",2,0],["لا تُثبِتُ العَينُ شَيئاً أَو تُحَقِّقُهُ","إِذا تَحَيَّرَ فيها الدَمعُ وَاِضطَرَبا",4,"ب",2,0],["لا تَثلِمُ الأَطماعُ فيهِ وَلا يُرى","بَينَ الخِيانَةِ وَالعَفافِ مُمَيَّلا",5,"ل",2,0],["لا تَثبُتُ الأَسوارُ حينَ تُقيمُها","إِلّا إِذا كانَت دَماً وَعِظاما",6,"م",2,0],["لا تَثنِني وَيكَ عَن مَحَبَّتِهِ","ما دامَ روحي مُصاحِباً بَدَني",7,"ن",2,0],["لا تُثبِتُ الأَقلامُ زَلَّةَ راقِدٍ","إِن كُنتَ بِتَّ بِحُلمِهِ مُرتابا",8,"ب",2,0],["لا تثق بالناس ما عا","شرتهم إلا قَليلا",9,"ل",2,1],["لا تثقن بالضياء منها","فإنما نورها ابنُ نارِ",10,"ر",1,0],["لا تثنينَّكُمُ المنايا إنها","سرُّ البقاءِ وسنةُ العمرانِ",11,"ن",1,0],["لا تثوروا على تُراثِ امرىء القيْ","سِ وصونوا ديباجةَ الذُبياني",12,"ن",2,0],["لا تُثبِت العينانِ أين مقرُّهُ","في الأرض لولا نقعُه المترفِّعُ",13,"ع",1,0],["لا تثق فيه بامرىء","لست من أهل جنسه",14,"س",2,0],["لا تَثْبُتُ الأقدامُ عند لقائهمْ","ولو أنَّهم حُملوا على ثهلان",15,"ن",1,0],["لا تثوري على الحياة فقد جفّ","ت زهور الحياة في راحتيك",16,"ك",1,0],["لا تثلبُنَّ سواكمُ في دائكم","فالنَتنُ ينشا من فساد طعام",17,"م",1,0],["لا تثْنِ جيدَك إنّ الروضَ قد جِيدا","ما عطّل القَطْرُ من نُوّارِه جيدا",18,"د",2,1],["لا تثبت العينان فيها لحظةً","إلا اختطاف الشمس تنصف آلا",19,"ل",2,0],["لا تثق بالهوى فقد رأتا","عيناك ماذا أحل مني خداعُه",20,"ع",2,0],["لا تَثنِ سَمعَكَ شَهوَةً","لِلطَيرِ عَن مَثنى وَزيرِ",21,"ر",1,0],["لا تُثمِروا المالَ لِلأَعداءِ إِنَّهُمُ","إِن يَظهَروا يَحتَووكُم وَالتِلادَ مَعا",22,"ع",2,0],["لا تثمروا المالَ للأعداء إنهم","إن يظفروا يحتووكم والتّلاد معا",23,"ع",2,0]]}