{"poems":[[95,"رسالتها المترجمة","https://www.aldiwan.net/poem60152.html","عموديه"],[89,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[45,"لما استعنت على الخطوب بصالح","https://www.aldiwan.net/poem65624.html","الكامل"],[105,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[48,"وابأبي من إذا ذكرت له","https://www.aldiwan.net/poem66099.html","المنسرح"],[46,"لو أنني سميت طيفك صادقا","https://www.aldiwan.net/poem22137.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85679","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"]],"verses":[["لا تثر ذكرى هوانا ربما","نفرت عن مقلتيّ الوسنا",0,"ن",2,0],["لا تثق بالعباب قد فاض يرغى","فإذا غاض البحر غاض العباب",1,"ب",1,0],["لا تثق بالجمهور يا عقل يوما","ان رأي الجمهور غير سديد",2,"د",1,0],["لا تُثيبوها عَلى ما قَلَّدَت","مِن أَيادٍ حَسَداً أَو شَنَآنا",3,"ن",2,0],["لا تُثبِتُ العَينُ شَيئاً أَو تُحَقِّقُهُ","إِذا تَحَيَّرَ فيها الدَمعُ وَاِضطَرَبا",4,"ب",2,0],["لا تَثلِمُ الأَطماعُ فيهِ وَلا يُرى","بَينَ الخِيانَةِ وَالعَفافِ مُمَيَّلا",5,"ل",2,0],["لا تَثبُتُ الأَسوارُ حينَ تُقيمُها","إِلّا إِذا كانَت دَماً وَعِظاما",6,"م",2,0],["لا تَثنِني وَيكَ عَن مَحَبَّتِهِ","ما دامَ روحي مُصاحِباً بَدَني",7,"ن",2,0],["لا تُثبِتُ الأَقلامُ زَلَّةَ راقِدٍ","إِن كُنتَ بِتَّ بِحُلمِهِ مُرتابا",8,"ب",2,0],["لا تثق بالناس ما عا","شرتهم إلا قَليلا",9,"ل",2,1],["لا تثقن بالضياء منها","فإنما نورها ابنُ نارِ",10,"ر",1,0],["لا تثنينَّكُمُ المنايا إنها","سرُّ البقاءِ وسنةُ العمرانِ",11,"ن",1,0],["لا تثوروا على تُراثِ امرىء القيْ","سِ وصونوا ديباجةَ الذُبياني",12,"ي",1,0]]}