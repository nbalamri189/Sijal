{"poems":[[95,"رسالتها المترجمة","https://www.aldiwan.net/poem60152.html","عموديه"],[89,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[45,"لما استعنت على الخطوب بصالح","https://www.aldiwan.net/poem65624.html","الكامل"],[105,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[48,"وابأبي من إذا ذكرت له","https://www.aldiwan.net/poem66099.html","المنسرح"],[46,"لو أنني سميت طيفك صادقا","https://www.aldiwan.net/poem22137.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85679","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[142,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[186,"أيها الغر بالزما","https://www.aldiwan.net/poem43728.html","مجزوء الخفيف"],[198,"الجيش يملي نصره الملوان","https://www.aldiwan.net/poem51881.html","الكامل"],[328,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[377,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[432,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[458,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[464,"إن يوم النوى شنيع سماعه","https://www.aldiwan.net/poem3396.html","عموديه"],[468,"صيد السرور أجل من المعقول","https://www.aldiwan.net/poem60006.html","مجزوء الكامل"]],"verses":[["لا تثر ذكرى هوانا ربما","نفرت عن مقلتيّ الوسنا",0,"ن",2,0],["لا تثق بالعباب قد فاض يرغى","فإذا غاض البحر غاض العباب",1,"ب",1,0],["لا تثق بالجمهور يا عقل يوما","ان رأي الجمهور غير سديد",2,"د",1,0],["لا تُثيبوها عَلى ما قَلَّدَت","مِن أَيادٍ حَسَداً أَو شَنَآنا",3,"ن",2,0],["لا تُثبِتُ العَينُ شَيئاً أَو تُحَقِّقُهُ","إِذا تَحَيَّرَ فيها الدَمعُ وَاِضطَرَبا",4,"ب",2,0],["لا تَثلِمُ الأَطماعُ فيهِ وَلا يُرى","بَينَ الخِيانَةِ وَالعَفافِ مُمَيَّلا",5,"ل",2,0],["لا تَثبُتُ الأَسوارُ حينَ تُقيمُها","إِلّا إِذا كانَت دَماً وَعِظاما",6,"م",2,0],["لا تَثنِني وَيكَ عَن مَحَبَّتِهِ","ما دامَ روحي مُصاحِباً بَدَني",7,"ن",2,0],["لا تُثبِتُ الأَقلامُ زَلَّةَ راقِدٍ","إِن كُنتَ بِتَّ بِحُلمِهِ مُرتابا",8,"ب",2,0],["لا تثق بالناس ما عا","شرتهم إلا قَليلا",9,"ل",2,1],["لا تثقن بالضياء منها","فإنما نورها ابنُ نارِ",10,"ر",1,0],["لا تثنينَّكُمُ المنايا إنها","سرُّ البقاءِ وسنةُ العمرانِ",11,"ن",1,0],["لا تثوروا على تُراثِ امرىء القيْ","سِ وصونوا ديباجةَ الذُبياني",12,"ي",1,0],["لا تُثبِت العينانِ أين مقرُّهُ","في الأرض لولا نقعُه المترفِّعُ",13,"ع",1,0],["لا تثق فيه بامرىء","لست من أهل جنسه",14,"س",2,0],["لا تَثْبُتُ الأقدامُ عند لقائهمْ","ولو أنَّهم حُملوا على ثهلان",15,"ن",1,0],["لا تثوري على الحياة فقد جفّ","ت زهور الحياة في راحتيك",16,"ك",1,0],["لا تثلبُنَّ سواكمُ في دائكم","فالنَتنُ ينشا من فساد طعام",17,"م",1,0],["لا تثْنِ جيدَك إنّ الروضَ قد جِيدا","ما عطّل القَطْرُ من نُوّارِه جيدا",18,"د",2,1],["لا تثبت العينان فيها لحظةً","إلا اختطاف الشمس تنصف آلا",19,"ل",2,0],["لا تثق بالهوى فقد رأتا","عيناك ماذا أحل مني خداعُه",20,"ع",2,0],["لا تَثنِ سَمعَكَ شَهوَةً","لِلطَيرِ عَن مَثنى وَزيرِ",21,"ر",1,0]]}