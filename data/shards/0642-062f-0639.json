لرِجالِ الطالِبُ",7,"ب",1,0],["قَد عَرَفنا الَّذي تُريدُ بِهَذا","فَأتِ ما شِئتَ راشِداً ما تَعنّى",8,"ن",2,0],["قَد عَرَفناكَ مُذ زَمانٍ وَدَهرٍ","فَعَرَفناكَ قاطِعاً ظَلّاما",9,"م",2,0],["قد عاوَدَتْ دولَةُ الإسلامِ جِدّتَها","والكُفْرُ مُشتَمِلٌ بالواهِنِ الخَلِقِ",10,"ق",1,0],["قد عادَ ذو الإقْدامِ منْكَ بسِلْمِهِ","ذُعْراً وأذْعَنَ رَهْبَةً جَبّارُهُ",11,"ر",2,0],["قَد عَلِمَت فارِسٌ وَحِميَرُ وَال","أَعرابُ بِالدَشتِ أَيُّهُم نَزَلا",12,"ل",2,0],["قَد عِشتَ فينا نَميراً طابَ مَورِدُهُ","أَسمى سَجايا الفَتى أَدنى سَجاياكا",13,"ك",2,0],["قَد عَقَدتُ العُهودَ مِن عَهدِ فِرعَو","نَ فَفي مِصرَ كانَ أَوَّلُ عَقدِ",14,"د",1,0],["قَد عاقَني سوءُ حَظّي","عَن حَفلَةِ المِهرَجانِ",15,"ن",1,0],["قَد عَيَّدَ الناسُ في نُعماكَ في جُدُدٍ","لكِنَّني بَينَهُم عَيَّدتُ في خَلَقِ",16,"ق",1,0],["قَد عَلِمنا عِلمَ ظَنٍّ","هُوَ لا شَكَّ مُصيبُ",17,"ب",1,0],["قَد عَلِقنا سِواكِ عِلقاً نَفيساً","وَصَرَفنا إِلَيهِ عَنكِ النُفوسا",18,"س",2,1],["قَد عِشتَ فينا وَلا تُرمى بِفاحِشَةٍ","حَتّى تَوَفّاكَ رَبُّ الناسِ مَحمودا",19,"د",2,0],["قَد عَرَفَ الناسُ لَهُ أَنَّهُ","بِالمَنزِلِ الأَتلَعِ غَيرُ الضَئيل",20,"ل",1,0],["قد عاد سر كيس من الفيوم","بلطفه وظرفه المعلوم",21,"م",1,0],["قَدْ عَهِدْتُ الخُلُوصَ شِيمَتَكُمْ","وَكَعَهْدِي شَهِدْتُهُ الآنَا",22,"ن",2,0],["قد عُوُدوا قنصَ الكماة كأنما","عقبانها ينقضُ منها أجْدَلُ",23,"ل",1,0],["قد عُوَّدوا النصر العزيز وخوَّلوا","الفتح المبين بملتقى الأبطالِ",24,"ل",1,0],["قد عانقته سدرة المنتهى","وغازلته جنّة المأوى",25,"ا",3,0],["قد عَيّ عن وصف ما أوتيتَ من حِكم","كلا كلامَيّ أطنابي وإيجازي",26,"ز",2,0],["قد علمتني الليالي في تقلُّبها","أن الموفق",27,"ق",1,0],["قد عرفنا حقيقة القول فيه","وتركنا للغافلين مجازه",28,"ز",2,0],["قَد عَجَّلوا لَكَ يا فَرَزدَقُ خَزيَةً","فَطَلَبتَ لَيلَةَ بَيَّتوكَ ضِمارا",29,"ر",2,0],["قَد عَذُبَ المَوتُ بِأَفواهِنا","وَالمَوتُ خَيرٌ مِن مَقامِ الذَليلِ",30,"ل",1,1],["قَد عَرَفنا مَغزاكَ ياعَيّارُ","وَتَلَظَّت كَما أَرَدتَ النارُ",31,"ر",1,1],["قَد عَدِمَ الدُنيا وَلَذّاتِها","لَكِنَّهُ ما عَدِمَ الصَبرا",32,"ر",2,0],["قَد عَلِمَت أَسلَمُ الأَنذالُ أَنَّ لَهُم","جاراً سَيَقتُلُهُ في دارِهِ الجوعُ",33,"ع",1,0],["قَد عَفا جاسِمٌ إِلى بَيتِ راسٍ","فَالجَوابي فَجانِبِ الجَولانِ",34,"ن",1,1],["قد علَّم الله في أقلام راحته","وبالسيوف فأرزاقٌ وآجال",35,"ل",1,0],["قد عرانا من طوانا زمنٌ","ما عهدنا مثله من زمن",36,"ن",1,0],["قد عاش دهراً خفيفَ الرأس نعلمه","حتى تزوجها بكراً على كبرِهْ",37,"ر",2,0],["قد عُجِّلت لي عقوبة الخورِ","وأنت فاحذرْ عقوبة البطرِ",38,"ر",1,1],["قد عُوّدوا مسَّ الهوا","ن فمالهم حَفلٌ بمسه",39,"س",2,0],["قد علم القرن عند حيصته","عنك بأي السيوف تضطبع",40,"ع",1,0],["قد عجبنا أنك المرء يشقى","عنده ناس وتحظى سباع",41,"ع",1,0],["قد عرفنا مقدارَ سُخطِك فاجهدْ","أن نرى العفوَ منك أيسر جهدك",42,"ك",1,0],["قد عضضْناك عضَّةً بمُزاحٍ","هو من طِرْزِك المليحِ وشانِك",43,"ك",1,0],["قدْ عدَّ قبْلَكَ مَنْ رأيْ","تَ ولسْتَ تلْبثُ أن يَعُدَّكْ",44,"ك",1,0],["قد عذَّبَ اللَّه امرءاً ناكها","طورينِ تعجيلاً وتأجيلا",45,"ل",2,0],["قَد عُرِّيَت حِقبَةً حَتّى اِستَطَفَّ لَها","كِترٌ كَحافَةِ كيرِ القَينِ مَلمومُ",46,"م",1,0],["قَد عَضَّهُ اليَأسُ الشَديدُ بِنابِهِ","في نَفسِهِ وَالجوعُ في الأَحشاءِ",47,"ا",2,0],["قَد عَرَّضَت نَفسَها لِلحُبِّ واهِيَةً","فَنالَ مِنها الهَوى الجَبّارُ مُقتَدِرا",48,"ر",2,0],["قَد عاشَ مِثلَكَ لِلمُروأَةِ وَالعُلى","مُتَعَفِّفاً كَالزاهِدِ المُتَوَرِّعِ",49,"ع",1,0],["قَد عَزَّ عَلَيَّ سوءُ حالي","ما يَفعَلُ ما فَعَلتُ عاقِل",50,"ل",1,0],["قَد عَزَّ جَيشٌ أَنتَ مِن أُمَرائِهِ","وَأُمورُ إِقليمٍ إِلَيكَ تَؤولُ",51,"ل",1,0],["قد عفوا عمن لم يكن بمسيء","ما الى العفو حاجة للبريء",52,"ي",2,1],["قد عدت بعد ذهاب منك يا عيد","اذ كل شيء يسر النفس مفقود",53,"د",1,1],["قد علمتني تجاريبي التي سبقت","ان ليس يظفر بالحاجات رعديد",53,"د",1,0],["قد عزوتم الى السفور غروراً","طائشاً قد يفضى الى الهفوات",54,"ت",1,0],["قد عبدت الإله ستين عاماً","ودعوت الإله في كل عام",55,"م",1,1],["قد عشت في البيت عمرا","وليس في البيت فاره",56,"ر",2,0],["قَد عِشتُ في خِدمَتِهِم","وَلا تَراني تَعِبا",57,"ب",2,0],["قَد عَرَفتَ الدارَ وَالأَهلَ بِهِ","كُلُّ حُبٍّ شُعبَةٌ مِن حُبِّهِ",58,"ه",1,0],["قَد عِشتَ تُحدِثُ لِلنَصارى أُلفَةً","وَتُجِدُّ بَينَ المُسلِمينَ وِئاما",59,"م",2,0],["قَد عَجِبتُ مِن قَلمٍ","ثاكِلٍ وَيَنجَرِدُ",60,"د",1,0],["قَد عِشتَ تَنصُرُهُ وَتَمنَحُ أَهلَهُ","عَوناً فَكَيفَ تَكونُ مِن غُرَبائِهِ",61,"ا",3,0],["قَد عَرَفنا بِنَجمِهِ كُلَّ أُفقٍ","وَاِستَبَنّا الكِتابَ مِن عُنوانِه",62,"ن",2,0],["قَد عَزَّ شُهودي إِذ رَمَتا","فَأَشَرتُ لِخَدِّكَ أُشهِدُهُ",63,"د",2,0],["قَد عَرَضتَ الدَهرَ وَالجَيشَ مَعاً","غايَةٌ قَصَّرَ عَنها الفاتِحون",64,"ن",1,0],["قَد عَسكَرَت مَعَها الرَزايا عَسكَراً","وَتَكَتَّبَت فيها الرِجالُ كَتائِبا",65,"ب",2,0],["قَد عَرَّضَ السَيفَ دونَ النازِلاتِ بِهِ","وَظاهَرَ الحَزمَ بَينَ النَفسِ وَالغِيَلِ",66,"ل",1,0],["قَد عَلِمنا مِن قَبلُ أَنَّكَ مَن لَم","يَمنَعِ اللَيلُ هَمَّهُ وَالغَمامُ",67,"م",1,0],["قَد عَلَّمَ البَينُ مِنّا البَينَ أَجفانا","تَدمى وَأَلَّفَ في ذا القَلبِ أَحزانا",68,"ن",2,1],["قَد عَلِمَ الباحِثُ الشَنآنُ ما حَسبي","وَبانَ لِلعاجِمِ المُجتَسِّ ما عودي",69,"د",2,0],["قَد عَدَدنا اليَومَ الَّذي جِئتَهُ في","هِ لِإِفراطِهِ حُسنِهِ يَومَ عيدِ",70,"د",1,0],["قَد عَشِقنا كَما عَشِقتَ وَما دُم","تَ وَدُمنا وَالحُبُّ لَو دُمتَ داما",71,"م",2,0],["قَد عَلِمَت خِندِفٌ وَالمَجدُ يَكنُفُها","أَنَّ لَنا عِزِّها في أَوَّلِ الحِقَبِ",72,"ب",1,0],["قد علمنا وليس في ذاك شك","أن من مات سودوا باب داره",73,"ر",2,0],["قد عَقَلْتُ اللِّسانَ دونَك والخا","ئِنُ مَنْ سُلِّطَتْ عليه القَوافي",74,"ي",1,1],["قَد عولِيَت فَهيَ مَرفوعٌ جَواشِنُها","عَلى قَوائِمَ عوجٍ لَحمُها زِيَمُ",75,"م",1,0],["قَد عايَنَ الأَحزابَ مِن تَأييدِهِ","جُندُ النَبيِّ ذي البَيانِ المُرسَلِ",76,"ل",1,0],["قَد عَلِمَ القَومُ لَدى الصِياح","أَني في الهَيجاءِ ذو نِطاح",77,"ح",1,1],["قَد عَلِموا أَنَّهُ الإِلَهُ وَلَ","كِن عَجِزَ العالِمونَ عَن صِفَتِه",78,"ه",1,0],["قَد عَلِمَ الناسُ أَنَّ وَجهَكَ يَس","تَغني إِذا ما رَآهُ مُعدِمُهُم",79,"م",1,0],["قَد عُهِدَ الجَوهَرُ بِالحُزنِ","فَلا تَخَف عاقِبَةَ السِجنِ",80,"ن",1,1],["قَد عَلِمَ السُلطانُ مِن قَبلِها","أَنِّيَ مِن ذَلِكَ بِالعَكسِ",81,"س",1,0],["قَد عَلا مَجدُه فَكاد","هامَةَ المَجدِ يَرتَقي",82,"ي"