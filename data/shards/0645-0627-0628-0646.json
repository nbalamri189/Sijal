{"poems":[[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[91,"ما بنا خوف اذا الموت دنا","https://www.aldiwan.net/poem44842.html","الرمل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[45,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[68,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[108,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[108,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[79,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[139,"أهدي إلى السامي المقام سلاميه","https://www.aldiwan.net/poem48994.html","الكامل"],[215,"دخلت أسيوط والآمال تعصف بي","https://www.aldiwan.net/poem46311.html","البسيط"],[412,"صب نأى فأفاعي البين تلسعه","https://www.aldiwan.net/poem50148.html","البسيط"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137339",""],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202080","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80008","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69361","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101605","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74091","السريع"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46031","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114571","الخفيف"],[4802,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=34304",""],[4987,"لمثلها والا بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=49571",""],[4987,"ضحيت بالواقع","https://www.poetsgate.com/ViewPoem.aspx?id=49585",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""]],"verses":[["مَا بِنْتُ عَنْهُ لِفَرْطِ جُبْنٍ فَاضِحٍ","كَلاَّ فَمَا قَلْبِيِ لِذُعْرٍ يُنْخَبُ",0,"ب",1,0],["ما بِناءٌ بُنَاتُهُ آلُ وهبٍ","بِوَضِيع الذُّرَا ولا مَهْدُودِ",1,"د",1,0],["ما بنا خوف اذا الموت دنا","نحن للموت كما الموت لنا",2,"ن",2,1],["ما بُنِيَت مِن خُلُقٍ دَولَتُهُ","قَد يَشيدُ الدُوَلَ الشُمَّ الخُلُق",3,"ق",1,0],["ما بِنا مِن هَوى العُيونِ اللَواتي","لَونُ أَشفارِهِنَّ لَونُ الحِداقِ",4,"ق",1,0],["ما بَنَيتُ العَلياءَ إِلّا بِجِدّي","وَرُكوبي أَخطارَها وَاِجتِهادي",5,"د",2,0],["ما بنَى مِثلَهُ على الدَّهرِ غِرٌّ","رَاحَ يَبني خَوَرْنقاً أو سَديرا",6,"ر",2,0],["ما بنفسي مخافة من حفيري","انا لا اثوى في حفيري حيا",7,"ي",2,0],["مَا بَنْك مِصْرٍ غَيْر مسْتَقْبَلٍ","يُعَدُّ أَوْ مَاضٍ مَجِيدٍ يعَادْ",8,"د",1,0],["ما بنى التأميمُ سَدًّا عاليًا","بل بنى للنيل جاهًا أيَّ جاهْ",9,"ا",2,0],["ما بني إلا بموسوعاتها","وتبناها؛ فكانت منَعه",10,"ع",2,0],["ما بنينا سدًّا؛ ولكن بَنَيْنَا","مجدَ مصرٍ، ونحن خيرُ البناة",11,"ه",1,0],["ما بنت سدها بصخر ومرو","بل بنَتْهُ بصادقِ العَزَمات",11,"ت",1,0],["ما بناها إلا أشاوِسُ صيدٌ","عِتْرَةٌ السِّبْط أو بنو مروانا",12,"ن",2,0],["ما بِنْتُ عنه لفَرْطِ جبنٍ فاضِحٍ","كلا فما قلبي لذُعْرٍ يَنْحَبُ",13,"ب",1,0],["ما بنتمو عن مهجتي يوماً ولو","بنتم وطال البين عن إنسانيهْ",14,"ي",2,0],["ما بنك مصر وإن طالت لجاجتهُ","أشقّ منك على روح الفتى العاني",15,"ن",2,0],["ما بنت عنه قِلىً مَنّي لصُحبَتِهِ","وَلا لودٍ سَها عنه يضيعُهُ",16,"ع",2,0],["ما بناهُ الأَلمان في نصف قرن","زعزعتهُ من أسه كفُّ غورو",17,"ر",2,0],["ما بَنَانِي للِهَدْم بَانيَّ حشا","هُ وبعْضٌ لِمَا بَنَى هَدَّام",18,"م",1,0],["ما بنى اللهُ من سماء علومٍ","وهو بدرٌ في أُفقها قد أنارا",19,"ر",2,0],["ما بَنَينا إِلّا كَما كانَ يَبني","هِ قَديماً آباؤُنا وَالجُدودُ",20,"د",1,0],["ما بناها إِلا لهدم المباني","ولسفك الدماء في طيرانه",21,"ن",2,0],["ما بَنيتَه","لَيسَ يَنهَدِم",22,"م",1,0],["ما بنت عنّي يا غَزال النقا","ما خطر السلوان في خاطِري",23,"ر",2,0],["ما بنينا في الأرض داراً ولا دا","ر علينا إلا افلا والقفار",24,"ر",1,0],["ما بِنتُ حِشمت إِلّا زَهرَة نَبَتَت","في مَنبت لَم يَزَل بِالمَجدِ مَأنوسا",25,"س",2,0],["ما بَنَيتَ لكَ العوالِمَ إلاَّ","لِتَراها بِعَينِ مَن لا يَرَاها",26,"ه",2,1],["ما َبن وجه بكفها ولا انقرا بُن","ومن يومها زل الكلام معسوله",27,"ل",2,0],["مابنيت بيوت شعرى من قشاش","ليه أخاف إن الرياح تهدّها",28,"د",3,0],["ما بنحسب عمر البنادم بالاعوام","بعض السنين نعيش فيها ليالي",29,"ل",2,0],["ما بنينا بيتا على الأرض زهدا","وبنينا للشعر أبقى القصور",30,"ر",1,0],["ما بنا طوعا غدونا","في الهوى صُمّا وخُرسا",31,"س",2,0]]}