{"poems":[[88,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[90,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[11,"وقائلة أهلكت بالجود مالن","https://www.aldiwan.net/poem241.html",""],[72,"وعاذلة باتت تلوم على الهوى","https://www.aldiwan.net/poem42924.html","الطويل"],[64,"أرقت لبرق لاح عني وميضه","https://www.aldiwan.net/poem52462.html","الطويل"],[60,"خوفني منجم أخو خبل","https://www.aldiwan.net/poem30898.html","الرجز"],[33,"أرقت ولم آرق لسقم أصابني","https://www.aldiwan.net/poem41851.html","الطويل"],[33,"قل للمليحة قد أبلتني الذكر","https://www.aldiwan.net/poem42546.html","البسيط"],[50,"رب غزال كأنه قمر","https://www.aldiwan.net/poem62561.html","المنسرح"],[50,"لله طيف سرى فأرقني","https://www.aldiwan.net/poem66127.html","المنسرح"],[50,"تعزى قلبنا عن ذكرِ راح","https://www.aldiwan.net/poem66213.html","الوافر"],[52,"غدا مالك بملاماته","https://www.aldiwan.net/poem24445.html","المتقارب"],[52,"يزهدني في حب عبدة معشر","https://www.aldiwan.net/poem64790.html","الطويل"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10176","المجتث"],[79,"ودير أنخنا في قراراته العيسا","https://www.poetsgate.com/ViewPoem.aspx?id=34190",""],[11,"وقائِلَة ٍ أهْلَكْتَ بالجودِ، مالَنا","https://www.poetsgate.com/ViewPoem.aspx?id=16845",""],[119,"يا من ولهت به والقلب طار له","https://www.aldiwan.net/poem40936.html","عموديه"],[136,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[138,"تقول ابنتي أين أين الرحيل","https://www.aldiwan.net/poem21014.html","المتقارب"],[202,"دعا بإقامة الشوق الرحيل","https://www.aldiwan.net/poem51908.html","الوافر"],[208,"وأحور صبحته في المساء","https://www.aldiwan.net/poem53110.html","المتقارب"],[275,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[325,"وإنى ليرضيني حنانيك نظرة","https://www.aldiwan.net/poem61695.html","الكامل"],[366,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[398,"خوفني منجم أخو خبل","https://www.aldiwan.net/poem53462.html","مشطور الرجز"],[398,"يقولون لي أودى كثير بن أحمد","https://www.aldiwan.net/poem53634.html","الطويل"],[409,"وشادن قد لام من","https://www.aldiwan.net/poem33462.html","مجزوء الرجز"],[411,"قل لمن رام سموا وعلامه","https://www.aldiwan.net/poem49733.html","الرمل"],[435,"سلا ظبية الوعساء أين يمينها","https://www.aldiwan.net/poem39912.html","الطويل"],[463,"أسترشد البان وهو غضبان","https://www.aldiwan.net/poem55858.html","المنسرح"],[505,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66645","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54094","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104623","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104547","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96618","الطويل"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67701","الطويل"],[1207,"","https://poetry.dctabudhabi.ae/diwan/poem/198631","المجتث"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115970","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79882","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108970","الطويل"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117816","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103768","المجتث"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143112","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58445","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201315","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200556","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74179","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74175","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74173","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107065","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112334","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112412","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62998","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123939","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138559",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85265","الطويل"],[3800,"","https://poetry.dctabudhabi.ae/diwan/poem/146656","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127342","المجتث"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94824","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81731","البسيط"],[4306,"","https://poetry.dctabudhabi.ae/diwan/poem/121966","الطويل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124620","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72673","الرجز"],[4984,"وقالوا تجاهلت","https://www.poetsgate.com/ViewPoem.aspx?id=215391",""],[5054,"نَعيمُ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=213763",""],[5145,"سلام على من لم أفز بلقائه","https://www.poetsgate.com/ViewPoem.aspx?id=108231",""]],"verses":[["فَقُلتُ دَعي ما تَحذَرينَ فَإِنَّني","أُصاحِبُ قَلباً بَينَ جَنبَيَّ أَيِّدا",0,"د",2,0],["فقلت دع عنك هذا إنه خبرٌ","سواه يَبعث في أحشائي الشَجَنا",1,"ن",2,0],["فَقُلتُ دَعيني إِنَّما تِلكَ عادَتي","لِكُلِّ كَريمٍ عادَةٌ يَستَعيدُها",2,"ه",2,0],["فَقُلتُ دَعيني أَغتَنِمها مَسَرَّةً","فَما كُلُّ وَقتٍ يَستَقيمُ سُرورُ",3,"ر",1,0],["فقلتُ دعيني والهَوى فجوانحِي","إليهِ على طولِ العَنَاءِ جوانحُ",4,"ح",1,0],["فَقُلتُ دَعني مِن أَكاذيبِ الحِيَل","المُشتَري عِندي سَواءٌ وَزُحَل",5,"ل",1,0],["فَقُلتُ دَعاني حُبُّكُم فَأَجَبتُهُ","إِلَيكِ فَقالَت بَل خُلِقتَ عَجولا",6,"ل",2,0],["فَقُلتُ داعٍ دَعا قَلبي فَأَرَّقَهُ","وَلا يُتابِعُني فيكُم فَيَنزَجِرُ",7,"ر",1,0],["فَقُلتُ دَعنا وَقُم لِنَأخُذَها","مِمّا تُزِفُّ العُلوجُ بِالعُمُدِ",8,"د",1,0],["فَقُلتُ دَعني وَمَن كَلِفتُ بِهِ","أَلوى بِعَقلي الهَوى فَدَلَّهَني",9,"ن",2,0],["فقلتُ دعي التمثّل ليس هذا","وعيشكِ وقتَ هجوٍ وامتداحِ",10,"ح",1,0],["فَقُلتُ دَعِ اللَومَ في حُبِّها","فَقَبلَكَ أَعيَيتُ عُذّالِيَه",11,"ل",3,0],["فَقُلتُ دَعوا قَلبي بِما اِختارَ وَاِرتَضى","فَبِالقَلبِ لا بِالعَينِ يُبصِرُ ذو اللُبِّ",12,"ب",1,0],["فقلت دعوا التأفيف فالعار لاصق","بكم واتركوا الترجيع فالأمر أفظع",13,"ع",1,0],["فَقُلتُ دينارُ مَن هُوَ","فَقالَ والي الجِبالِ",14,"ل",1,0],["فقلت دع الإنكار إنا عصابة","يطيعون فيما تشتهي النفس إبليسا",15,"س",2,0],["فقلتُ دَعيني، إنّما تِلكَ عادَتي","لكل كريمٍ عادة يستعدها",16,"ه",2,0],["فقلت دعني لذي اللذات عاقبة","لا خير في لذة من بعدها سقر",17,"ر",1,0],["فقلتُ دعوا الملامة إن غدرا","نصيحةُ مَن تملَّكُه الغرام",18,"م",1,0],["فَقُلتُ دَعُوا الخَوضَ في دِينِهِ","فَقَد كُنتُ مِنكُم بِهِ أعرَفَا",19,"ف",2,0],["فَقُلتُ دَعيني فَإِنّي اِمرُؤٌ","أُريدُ النَجاشِيَّ في جَعفَرِ",20,"ر",1,0],["فقلت دعي الزمان يفلّ غربي","فليس يعيب ذا شطب فلول",21,"ل",1,0],["فقلتُ دهشتُ لما قد رأيتُ","ومَن ذا يراك ولا يدهشُ",22,"ش",1,0],["فقلتُ دَعيني للمكارِمِ إِنني","رأيتُ اقتِدائي بامرئ القيس أمجدا",23,"د",2,0],["فَقُلتُ دَعوني وَالهَوى إيما جَنى","فَعِندي حُلوٌ في رِضاهُم تَأَلُّمي",24,"م",2,0],["فَقُلتُ دَهري بَخيل","بِالفَضل وَاللَه أَكرَم",25,"م",1,0],["فَقُلتُ دَعني مِن أَباطيل الحيَل","فَالمُشتَري عِندي سَواءٌ وَزُحَل",26,"ل",1,0],["فَقُلتُ دَعوني وَالعلى نبكِهِ معاً","فَمِثلُ كَثيرٍ في الرِجالِ قَليلُ",27,"ل",1,0],["فقلت دعه إنه","يقول ما لا يفعل",28,"ل",1,0],["فقلْتُ دَعوني ولا تعذُلوا","فما اصطادَ قلبَ كَريم كَريمِ",29,"م",1,0],["فقلت دعيني والهوى ان مهجتي","مديح الشريف الاريحي معينها",30,"ن",3,0],["فقُلْتُ دهري عدْل القصيّة أَوْ","غير ابن أيوبَ فيهِ إنسَانُ",31,"ن",1,0],["فقلتُ دمعي قد نَمّ","ظنَّ العَواذِلُ نُوَّمْ",32,"م",1,0],["فقلتُ دَعيني لن أُحَبِّر مدحةً","لغيرهمِ ما حجَّ للهِ أَرْكُبُ",33,"ب",1,0],["فقلتُ دعيني الحزنُ فرض على الورى","أما قد حوى أعداؤنا جبل الفتح",34,"ح",1,0],["فقلت دعوني انَّني لمجربٌ","فليس اقتناصُ الكهل كالحدثِ الغرِّ",35,"ر",1,0],["فقلتُ دعني فإني عنكَ في شُغُلٍ","بوجههِ عن هوى نفسي وعن وَطَري",36,"ر",2,0],["فَقُلتُ دَبِّر خَلاصي يا خدينَ حِجى","فَأَنتَ تَنصُر في الجُلّى وَفي الجَللِ",37,"ل",1,0],["فَقلتُ دعوا وصفَ الرياضِ وَذكرها","وجدّوا فإنّ الجدّ أَولى وأوجبُ",38,"ب",1,0],["فَقُلْتُ دَعُوا لي لا أَبا لأَبِيكُمُ","فما مِنْكُمُ قَيْضٌ لَهُ غيرُ أَعْوَرِ",39,"ر",1,0],["فقلت: دونك فاجعل","سفينةً من ضلوعي",40,"ع",2,0],["فقلت دعونى هذه سُنَّةُ الهوى","وفَرطُ الأسى بالعاشق الصَّبِّ لائقُ",41,"ق",1,0],["فقلتُ دعوا النصحَ في عذلِكم","فلا رأيَ لي أن أطيعَ العذولا",42,"ل",2,0],["فقلت دوائي لو يباع اشتريتُه","من المبسم الحالي فولَّى يقول لو",43,"و",1,0],["فقلتُ دعوني لا أباً لأبيكم","فلم أحظَ رأياً في المقامِ ولا الندّي",44,"د",2,0],["فقلت دُر ودر","من زاخر وغمام",45,"م",1,0],["فقلت دواء الدبر طعنة أجرد","عريض القفا عريان أقرع أعور",46,"ر",1,0],["فَقُلتُ دعوهُ سوفَ ترمدُ عَيْنُهُ","وكم رَمَدَتْ عينٌ منَ السّعْي في الشّمسِ",47,"س",1,0],["فقلت دعوا الإطار فان شعري","كروحي مبغضٌ سِجن الإطار",48,"ر",1,0],["فقلت دعهم إنهم أمواتٌ","قد سكنوا للفقر في أجداث",49,"ث",1,0],["فَقُلت دَعيني وَالقِياس فَإِنَّني","سَأَتلو أَحاديث الأَماجد مسنَدا",50,"د",2,0],["فَقُلت دَعيني مِن حَديث خرافة","فَإِنا أناس نَعشق المَجد مُذ كُنا",51,"ن",2,0],["فَقُلت دَعوني لا يَهمكم أمري","هِي الظبية الغَناء وَالقَلب دارها",52,"ه",2,0],["فقلت دعوني والعزاء فانني","حليف الأسى خدن الجوى وعديل",53,"ل",1,0],["فقلتُ دعوني أصرِف العمرَ بالبُكا","فإنّ ربيعي في الحياة نأى عنّي",54,"ي",1,0],["فقلتُ دعيني في رشادي فإنّني","أعوّض عما يشربُ الحزن من قلبي",55,"ي",1,0],["فقلتُ دعى فليس أَوانَ فخرٍ","ولا بأَوانِ هَجْوٍ وامتداحِ",56,"ح",1,0],["فقلت دعبه انما العمر رحلة","وهذي الليالي للأنام مراحل",57,"ل",1,0],["فَقُلتُ دِيار العاشِقينَ بلاقعُ","يُبادِرنَني بِالعَذل وَالرَكب مزمعٌ",58,"ع",1,0],["فقلت دعيني ما حنيني لمربعٍ","ولكن لمن بالطف ألقت عصا السرى",59,"ر",2,0],["فقلت دعيني أن يكن مات فيصل","فخالقه حي وما مات نائله",60,"ل",2,0],["فقلت: \"دردي دن\" بل عصارته","وإنما القوم أحداث من الحدث",61,"ث",1,0],["فقلت دع عنك هذي","ما كل سوداء تمره",62,"ه",1,0],["فقلت دعيهم لا أبا لأبيهم","ولا أم منهم بالسؤال خبير",63,"ر",1,0],["فقلتُ دعني وشأني في مغالطةِ","حسبي يقولون قد اجريت إهداء",64,"ا",2,0],["فقلتُ دعني أحق عضو","يحظى بلبسٍ السواد عيني",65,"ن",2,0],["فقلت دمي والدمع أفناهما البكا","وهذا سوادُ المقلتين يَسيل",66,"ل",1,0],["فقلت دعوني لا أبا لأبيكم","فكل بعيد دون باب قريب",67,"ب",1,0],["فقلت دعني من هوى تلك وذي","وهذه إن هي الا اسما",68,"م",2,0],["فقلت دعوا الغرس حتى يُرى","إذا كان في حقله ناضجا",69,"ج",2,0],["فقلتُ دعيني حيثُ كُنت لأنني","أرى نبضات القلب تُوحي بِلوعتي",70,"ت",2,0],["فقلت: دعيني إنّ قلبي وإن هفا","لأدرى بمغزاه وأحرى بدائه",71,"ا",3,0]]}