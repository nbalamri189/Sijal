{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[275,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[333,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[408,"يا قبر جادك وابل الرضوان","https://www.aldiwan.net/poem46437.html","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205774","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87395","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117847","الكامل"],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5376,"من أرضِها عَرَجَ النبيُّ محمدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214064",""],[5491,"أرضنا الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=197189",""],[6026,"مساحة للأرق","https://www.poetsgate.com/ViewPoem.aspx?id=214647",""]],"verses":[["وعلى ثغركِ المشوقِ ابتسامٌ","ضَرَّجَتهُ الأشواقُ والأهواءُ",0,"ا",2,0],["وَعَلَى ثَابِتٍ مِنَ شَادَتْ","مَجْدَهُّنَّ الجَديدَ فِي تَمْكِينِ",1,"ن",1,0],["وَعلى ثَغرِكِ الجَميلِ ثِمارٌ","حَجَبَت شَهوَةَ الرَدى في العَصيرِ",2,"ر",1,0],["وعلى ثمالة كأسهِ وغرامهِ","تحنو جنانٌ والهوى استعباد",3,"د",1,0],["وعلى ثغره وف شفَتيه","يتلاشى السكون في الهذيان",4,"ن",1,0],["وعلى ثراكَ تخطّرت ريحُ المنى","تَسري بنَشْر البرِّ والإِحسانِ",5,"ن",1,0],["وعلى ثغرة إبتسامة بشر","بعثتها هشاشة في الفؤاد",6,"د",1,0],["وَعَلى ثراك من السَموات العُلى","اذ أَرَّخوك انهلَّ غيثُ مراحمِ",7,"م",1,0],["وعلى ثرى أجداثهم جد من صلا","تك والسلام بمستهل هاطل",8,"ل",1,0],["وعلى ثَرى حِمْصٍ تبَاعدَ شأْوُهُمْ","الرَّافِضُونَ إلى الخُنُوعِ سَبِيلا",9,"ل",2,0],["وعلى ثرى الأحقاف كان عقوبة","فيما مضى والضيق في وديانه",10,"ن",2,0],["وعلى ثراك أقامَ ليلاً خاشعاً","بالانبياءِ على صعيدٍ ساجِ",11,"ج",1,0],["وعلى ثراكَ تنزّلتْ أرواحُنا","وبك انتشاء الكائنات مؤجّلُ",12,"ل",1,0],["وعَلَى ثنَايَا الغَدْرِ واجِفةً","مَكْلُومَةَ الأنْفَاسِ والعَرقِ",13,"ق",1,0]]}