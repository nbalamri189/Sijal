3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216363","الخفيف"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32702","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73172","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136615",""],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139547",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204354","الخفيف"],[4728,"الأمل قبلة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176950",""],[4748,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=6662",""],[4764,"يرحم ابويه الي فطمني على الزين","https://www.poetsgate.com/ViewPoem.aspx?id=35480",""],[4797,"ياطير لو ساموك","https://www.poetsgate.com/ViewPoem.aspx?id=178143",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[5057,"يا لجرحِ اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=197179",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[5582,"قِفْ بِالدِّيارِ مُخاطِباً وَاسْتَخْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63518",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5848,"الجادل","https://www.poetsgate.com/ViewPoem.aspx?id=50589",""],[5950,"نتابني ضيق وأخذ ضيقتي وأشرف","https://www.poetsgate.com/ViewPoem.aspx?id=139974",""],[5956,"لو أتى السيّاف","https://www.poetsgate.com/ViewPoem.aspx?id=182114",""],[6056,"شهيد المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=130353",""],[6056,"طيور الظلامي","https://www.poetsgate.com/ViewPoem.aspx?id=130381",""],[6110,"في كاظمة أو ذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=141177",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""]],"verses":[["لَو وَنى ذَلِكَ الغَمامُ لَأَطلَق","تُ مَزادَ الدُموعِ مِن أَجفاني",0,"ن",2,0],["لَو وَلي ما قَد وَلوا مِن عِترَتي","قائِمُ الشَركِ لَأَبقى وَرَعى",1,"ا",1,0],["لَو وَفى بِالزَكاةِ مَن جَمَعَ الدُن","يا وَأَهوى عَلى اِقتِناءِ الحُطامِ",2,"م",1,0],["لو وَازَرَ الماءَ اسْتَفَادَ قُوَى الصَّفَا","جَلَداً ولو كادَ الصَّفا لَتَضَيَّحَا",3,"ح",2,0],["لو وزنّا بالذي أوليتنا","شُكر أهل الأرض طُرّاً ما اتَّزن",4,"ن",1,0],["لَو وَلَجَ الناسُ في سَرائِرِهِم","هانَت وَرَبّي عَلَيهِم سَقَرُ",5,"ر",1,0],["لَو وَصَلتُم مُحِبَّكُم","ما الَّذي كانَ ضَرَّكُم",6,"م",1,0],["لو وَصَّلوا ما استدخلوا من فيشةٍ","في طولهم وصلوا السماء قعودا",7,"د",2,0],["لَو واصَلَت أَحَداً سِوى أَصحابِها","مِنهُم لَكانَ لَها أَخاً وَصَديقا",8,"ق",2,0],["لَو وازَنوا حَضَناً مالَت حُلومُهُمُ","بِالراسِياتِ الثِقالِ الشُمِّ مِن حَضَنِ",9,"ن",1,0],["لو وجَدَتْ للفِراقِ ما وَجَدا","لافتقَدَتْ نومَها كما افتَقَدا",10,"د",2,0],["لو وُزِنَتْ كلُّ صلاةٍ بها","من أنبياءِ اللَّهِ لم تَعدلِ",11,"ل",1,0],["لَو وَعَدَتني مَوعِداً صادِقاً","أَو كاذِباً بِالجِدِّ أَو بِاللَعِب",12,"ب",1,0],["لَو وُفِّقَ المَرءُ لَم يَبهَش إِلى اِمرَأَةٍ","أَوِ الغَريرَةُ لَم تُزفَف إِلى رَجُلِ",13,"ل",1,0],["لَوْ وَعِظَ النَّاسُ لمَا خُوطِبُوا","بِحَادِثٍ أَشْجَى وَلاَ أَرْوَعا",14,"ع",2,0],["لَو وَزَنَا بما أَقَمْتَ من الدُّسْتُورِ","آلاءَه اخْتَفَتْ آلاؤه",15,"ا",3,0],["لَوْ وَعَاهَا مَا اهْتَزَّ يُنْشِدُ يَوْماً","ذَاكَ وادِي الأَرَاكِ فَاحْبِسْ قَلِيلاَ",16,"ل",2,0],["لو وضعنا عن المروءَة سِفْرًا","كان عنوان سفرها، بنُّونه",17,"ن",2,0],["لو وضعت كفها على كتفي","ينبت من تحتها جناحان",18,"ن",1,0],["لو وجهه نعلا حصانين ، لو","ساقاه (مبغا) في قميص النهار",19,"ر",1,0],["لو وجدت الرحيق ما ذبت شجوا","وتحرّقت في المنى أشجانا",20,"ن",2,0],["لَو وَزَنّا بِكَ المُلوك اِمتِحاناً","في العَطايا لَكُنتَ أَرجَح وَزنا",21,"ن",2,0],["لو وطِئوا الضخر بأقدامهم","أو لمَستهُ راحُهم رَوّضا",22,"ض",2,0],["لو وفقوا الجروا في الخير طوع يد","جري الجواد ولم يلووا على البخل",23,"ل",1,0],["لَو وَضَعتم بدرَ السما في شمالي","وَبِيُمنايَ كانَ منكم ذكاءُ",24,"ا",2,0],["لَو وَنى عَزمهُ لما فازَ بِالقِد","حِ المُعَلّى في القُبَّةِ الزَرقاء",25,"ا",2,0],["لو وازن الأطوادَ فضلُك فاقها","عظماً ومال بعالِج وبيَذْبُلِ",26,"ل",1,0],["لَو وَسَموني وَسمَ العَبيدِ وَبا","عوني بِسوقِ الأَعرابِ ما قَنِعوا",27,"ع",3,0],["لو وَضعتمْ بيديَّ الش","مسَ والبدر قسامه",28,"م",2,0],["لَوْ وَجَدَ الّلائِمُ بَعْضَ مَاوَجَدْ","في الحُبِّ مَافَنَّدَهُ هذا الفَنَدْ",29,"د",1,1],["لَو وَجَدَ العُشاق لل","نَجاة باباً وَلَجوا",30,"ج",3,0],["لو وازنته ملوك الأرض قاطبة","لكان أرجحها في العز ميزانا",31,"ن",2,0],["لو واخذ اللّه أهل الحب إذ عشقوا","أو أن يعذّب أهوانا لهوانا",32,"ن",2,0],["لو وَهَبَ المرءُ يوماً نفسَهُ سَرَفاً","لم يَهبِ النفسَ إلا وهو مختصِرُ",33,"ر",1,0],["لو وَطِئتْ شَوكَ القنا نابتاً","في طُرُق العلياءِ لم تُنقَبِ",34,"ب",1,0],["لو واثَقَ الرمضاء في حبِّ الصدى","لغدا يَعُدُّ الضبَّ حوتَ الخضْرم",35,"م",1,0],["لو وطئت صم الحصى حوافياً","أنبعن عذب الماء من صفوانها",36,"ن",3,0],["لو وازنوه بغيره","لرأيت إبراهيم راجح",37,"ح",1,0],["لو وفى صاحبٌ وفى لي سوادٌ","زارَ فَوْدَيَّ منذُ كنتُ صَبيّا",38,"ي",2,0],["لَو وَزَنَ العاشِقونَ حُبَّهُمُ","لَكانَ حُبّي بِحُبِّهِم يَزِنُ",39,"ن",1,0],["لو وَاصلتني يوماً أَمُتْ كمداً","إِذ كُنتُ أَدخلُ فِردوساً وأَعرافا",40,"ف",2,0],["لو وَاصَلَتْنِيَ يَوْماً لم أَمُتْ أَبَداً","أَوْ لَمْ تَصِلْنِي فَيا مَوْتِي بها كمَدا",41,"د",2,1],["لَوْ وَاصَلْتني في الدُّجَى لَمْ يَبِتْ","قَلْبِي مِنْهَا وَهْوَ بالهاجِرَهْ",42,"ر",2,0],["لَو وُشِّعتَ غُرَرَ البُرودِ بِوَشيِها","كانَت لأفوافِ البُرُودَ وَشائِعا",43,"ع",2,0],["لَو وَجدتُ السبيلَ جدتُ بخدّي","عِوضاً عَن خمارِ تلكَ الوَليده",44,"ه",1,1],["لووا عزمَهم عنه وولوا وجوههم","إلى حيث سلبُ الحق لا يتعذر",45,"ر",1,0],["لَو واعَدوا أَخلَفوا لَو حَدَّثوا كَذبوا","إِذ أَوجَبوا الخلفَ بَينَ القَولِ وَالعَمَلِ",46,"ل",1,0],["لو وقعتْ في ورطةٍ آيست","كأنها لم ترجُ مها إياب",47,"ب",1,0],["لو واعدوك إلى شعبانَ مكرُمةً","لنجَّحوا أمرَك المطلوبَ في رجب",48,"ب",1,0],["لو وهبت كفاك الدنا لمرجي","ك لقينا بعد معذرا",49,"ر",2,0],["لو وازنَ الدنيا وَساكنها معاً","ما وازنوا في القدرِ ظفر شمالهِ",50,"ل",2,0],["لو واجه البدر المنير بوجهه","لغدا به البدر المنير هلالا",51,"ل",2,0],["لَو وافَقَتْ أَمْوالُهُ جُودَهُ","أثْرَى بِها مَنْ حَلَّ فَوْقَ الثَّرى",52,"ر",2,0],["لو وطّنا كانت رماله قفر","يكرم اللّافي ويحمي المستجير",53,"ر",1,0],["لو وصفت اشتياق قلبي إليكم","ما رأيت الاقلام تحصي عداده",54,"د",2,0],["لو وجدنا إلى اللقاء سبيلا","لشفينا بالقرب منكم غليلا",55,"ل",2,1],["لَوْ وُضِعَ الْوَرْدُ على خَدِّهِ","مَا عُرِفَ الَخْدُّ مِنَ الْوَرْدِ",56,"د",1,0],["لو وكلنا إلى النفوس وما تخ","تار كان اختيارنا للبوار",57,"ر",1,0],["لو وجدنا إلى الوداع سبيلاً","لمهدنا الخدود للركب سبلا",58,"ل",2,0],["لَو وَزنّاهُ بِالَّذي تَحمِلُ الأَر","ضُ عَلَيها لَمالَ في ميزانِه",59,"ن",2,0],["لَو وازنَ الطَودَ الأَشَمَّ بِحِلمِهِ","لانحَطَّ وَاِرتَفَعَ الأَشَمُّ الأَرفَعُ",60,"ع",1,0],["لَو وَردت البِحار أَطلب ماءً","جَفَ قَبل الوَرد ماء البِحار",61,"ر",1,0],["لو وفقوا ما لفقوا أقوالَ من","لعبوا بهم كتلاعبِ الوِلدان",62,"ن",1,0],["لو وافقوك وخالفوه كنت تش","هد أنهم حقا أولو الايمان",63,"ن",1,0],["لَو وَفَيتُم واصَلتُمونا عَلى عَم","دٍ وَكانَ التِقاؤنا بِاتفاقِ",64,"ق",1,0],["لَو وازَنَتك الناس في علمائها","كانوا القشور وَكُنت أَنتَ لبابها",65,"ب",3,0],["لووا جانبا عن مورد الظيم فانثنوا","على الأرض صرعى سيداً بعد سيد",66,"د",1,0],["لَو واصل بن عَطاء الباني لَها","تُلِيَت توهم انها آيات",67,"ت",1,0],["لو وجدنا إلى التلاقي سبيلا","ما هجرنا وضاق عنا السبيل",68,"ل",1,0],["لو ورد الأمر بنزع أعيني","بادرت للأمر ولا أستريب",69,"ب",1,0],["لو وَفى طَيفُك المُلِمُّ بوَعدي","لرأى للرَقيبِ ألفَ خيالِ",70,"ل",1,0],["لَو وَقَفوا ساعَةً نُسائِلُهُم","رَيثَ يُضَحّي جِمالَهُ السَلَفُ",71,"ف",1,0],["لو وضعت السحر في ادبي","أو نظمت الدر في كلمي",72,"م",2,0],["لو وضعت الأحجار في قالب الضغط","لانت وإن تكن من رخام",73,"م",1,0],["لو واصلَتهُ وجادت","منها بأنسٍ وقربِ",74,"ب",1,0],["لو وازنت قسمتي في العيش موهبتي","لما جرى قدر في غير أفلاكي",75,"ك",2,0],["لو وسعت أمواله جوده","لعز في الكون وجود العفاة",76,"ه",1,0],["لو وجد السبط له أنصارا","لما جرى ما قد جرى وصارا",77,"ر",2,1],["لو وجدنا لما اعتذرت طريقة","لفتحنا إلى الوصال طريقه",78,"ه",1,1],["لَو وقف الرأي عَلى مكره","لَقالَ ذا فارِس فرسانِ",79,"ن",1,0],["لو وقفتم يومًا إلى جانب المغ","لوب ما فاز غالب قط ظلما",80,"م",2,0],["لو وهبوه لسائل لأبي","وقال أخذي له من الغين",81,"ن",1,1],["لووثا عين أزواجي","جزيل كنوزه كرما",82,"م",2,0],["لوو ثوةٌ بنت ألتيس من","على ثغر ستينويس قطن",83,"ن",1,0],["لو وفَى عدلُ طيفهِ بالضَّمان","كنتُ من جَورِ طَرفِه في أَمانِ",84,"ن",1,1],["لو وجَدنا الى الوداع سَبيلا","لشَفينا لواعجاً وغَليلا",85,"ل",2,1],["لو وافق المشروع في الإصابه","فهو هباء لم ينل ثوابه",86,"ه",1,0],["لو وجدنا لعتبهم من سبيلٍ","لعتبنا وأين منّا العتاب",87,"ب",1,0],["لو وثقنا بأن عمرك يمتد","بأعمارنا قتلنا النفوسا",88,"س",2,1],["لو وراها يرخصون الذهب والدرهمي","سمّعتهم قولة : (الباب ياسع له جمل)",89,"ل",1,0],["لو وصفته .. المعاجم في وصفه قليله","شرحها ما يوفي رقته والدلالي",90,"ل",2,0],["لو وزه الخافي على الشين في حين","يحسب بأني واحده من خواته",91,"ت",2,0],["لو وصلوك اهل النظر ستة ارقام","مابعت طمعٍ فيك ماني بطماع",92,"ع",1,0],["لو وطيت بكل حالات الرمالي","من سنين(ن)صار لك جيّه وجيّه",93,"ي",2,0],["لو وّعى النطقَ كلّ شيءٍ لكانت","صرخَة الدهرِ ياااااا لجرحِ اليماني!!!",94,"ن",2,0],["لو ونى الدمع عن صداها تلظّت","جمراتٍ ملذّعاتٍ سواعر",95,"ر",1,0],["لو وازنوه ملوك الأرض شالهخم","بكفه ذات وزن منه رجاح",96,"ح",1,0],["لووا عن الدنية أعطافا أبين لهم","مس الدنية تكريما وتنزيها",97,"ي",3,0],["لو وعوهن لاستبان إليهم","كيف ترقى المنابر الخطباء",98,"ا",2,0],["لو وَعَينا جراحَنا لانتَفَضْنا","وَدَعانا إلى الأمامِ الأمام",99,"م",1,0],["لَوْ وازَنَتْ كَفَّهُ الدُّنْيا وَساكِنُها","قَدْراً أَمالَ بِهِمْ فِي الوَزْنِ خِنْصِرُها",100,"ر",3,0],["لَوْ وازَنَتْ كَبْكَباً يَوْماً سَكِينَتُهُ","لَخَفَّ مِنْ جانِبِ القِسْطاسِ كَبْكُبُها",101,"ب",3,0],["لَوْ وَازَنَتْ مِنْهُ البَرِيَّةُ خِنْصِراً","فِي القَدْرِ مِنْهُ ما وَفَتْ عَنْ خِنْصِرِ",102,"ر",1,0],["لو واحدٌ هجرَ المنا","مَ وراحَ يهدرُ لاسترابُوا",103,"ب",3,0],["لو وَرِثْنا محاسِنًا كُنتَ أَوْلى","من بُدورٍ تجمَّلتْ بِرُؤاكَ",104,"ك",1,0],["لو وصلها شح بنت الناس مصيونه","تمشي واقول انها تمشي بوجداني",105,"ن",2,0],["لو واقع الناس مثل كتابة الأحرف","ماكان ذيب الظروف يمرّني حايف",106,"ف",1,0],["لو وَعى أيُّ مُحامٍ قصَّتي","عَرَفَ القانونَ حُكْماً أَبْلَها",107,"ه",2,0],["لو، وريدي قلم ، والقلب دمه مداده","مايوفيّه مدحي جعل عمره مديد",108,"د",1,0],["لو واحد ٍ جاب الحكي قلت مغتاب","لكن بعيني ، شفت كلّش أمامي",109,"م",2,0],["لو واجه غرتها شمس","لغدت أسفاً رهن الندم",110,"م",1,0],["لو وعاها حراء لاندك أو ذا","بَ وذابت من حوله الصحراء",111,"ا",2,0]]}