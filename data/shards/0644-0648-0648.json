{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[70,"إن شكا القلب هجركم","https://www.aldiwan.net/poem42888.html","مجزوء الخفيف"],[43,"هينا فقدت من الرجال بليدا","https://www.aldiwan.net/poem10621.html","الكامل"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[28,"إني حلفت برب البدن مشعرة","https://www.aldiwan.net/poem5646.html","البسيط"],[61,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[48,"تخرج إما سفرت حاسرا","https://www.aldiwan.net/poem10796.html","السريع"],[46,"يا خاطري لا توجه وجه سيئة","https://www.aldiwan.net/poem23220.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54995","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""]],"verses":[["لَو وَنى ذَلِكَ الغَمامُ لَأَطلَق","تُ مَزادَ الدُموعِ مِن أَجفاني",0,"ن",2,0],["لَو وَلي ما قَد وَلوا مِن عِترَتي","قائِمُ الشَركِ لَأَبقى وَرَعى",1,"ا",1,0],["لَو وَفى بِالزَكاةِ مَن جَمَعَ الدُن","يا وَأَهوى عَلى اِقتِناءِ الحُطامِ",2,"م",1,0],["لو وَازَرَ الماءَ اسْتَفَادَ قُوَى الصَّفَا","جَلَداً ولو كادَ الصَّفا لَتَضَيَّحَا",3,"ح",2,0],["لو وزنّا بالذي أوليتنا","شُكر أهل الأرض طُرّاً ما اتَّزن",4,"ن",1,0],["لَو وَلَجَ الناسُ في سَرائِرِهِم","هانَت وَرَبّي عَلَيهِم سَقَرُ",5,"ر",1,0],["لَو وَصَلتُم مُحِبَّكُم","ما الَّذي كانَ ضَرَّكُم",6,"م",1,0],["لو وَصَّلوا ما استدخلوا من فيشةٍ","في طولهم وصلوا السماء قعودا",7,"د",2,0],["لَو واصَلَت أَحَداً سِوى أَصحابِها","مِنهُم لَكانَ لَها أَخاً وَصَديقا",8,"ق",2,0],["لَو وازَنوا حَضَناً مالَت حُلومُهُمُ","بِالراسِياتِ الثِقالِ الشُمِّ مِن حَضَنِ",9,"ن",1,0],["لو وجَدَتْ للفِراقِ ما وَجَدا","لافتقَدَتْ نومَها كما افتَقَدا",10,"د",2,0],["لو وُزِنَتْ كلُّ صلاةٍ بها","من أنبياءِ اللَّهِ لم تَعدلِ",11,"ل",1,0],["لَو وَعَدَتني مَوعِداً صادِقاً","أَو كاذِباً بِالجِدِّ أَو بِاللَعِب",12,"ب",1,0],["لَو وُفِّقَ المَرءُ لَم يَبهَش إِلى اِمرَأَةٍ","أَوِ الغَريرَةُ لَم تُزفَف إِلى رَجُلِ",13,"ل",1,0],["لَوْ وَعِظَ النَّاسُ لمَا خُوطِبُوا","بِحَادِثٍ أَشْجَى وَلاَ أَرْوَعا",14,"ع",2,0],["لَو وَزَنَا بما أَقَمْتَ من الدُّسْتُورِ","آلاءَه اخْتَفَتْ آلاؤه",15,"ا",3,0],["لَوْ وَعَاهَا مَا اهْتَزَّ يُنْشِدُ يَوْماً","ذَاكَ وادِي الأَرَاكِ فَاحْبِسْ قَلِيلاَ",16,"ل",2,0],["لو وضعنا عن المروءَة سِفْرًا","كان عنوان سفرها، بنُّونه",17,"ن",2,0]]}