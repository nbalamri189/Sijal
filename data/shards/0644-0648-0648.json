{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[91,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[70,"إن شكا القلب هجركم","https://www.aldiwan.net/poem42888.html","مجزوء الخفيف"],[43,"هينا فقدت من الرجال بليدا","https://www.aldiwan.net/poem10621.html","الكامل"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[28,"إني حلفت برب البدن مشعرة","https://www.aldiwan.net/poem5646.html","البسيط"],[61,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[48,"تخرج إما سفرت حاسرا","https://www.aldiwan.net/poem10796.html","السريع"],[46,"يا خاطري لا توجه وجه سيئة","https://www.aldiwan.net/poem23220.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54995","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[107,"تقبيل","https://www.poetsgate.com/ViewPoem.aspx?id=214007",""],[100,"التاريخ السري .. للجدار العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=50343",""],[100,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[109,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[142,"قد طال للماطل أن يقتضى","https://www.aldiwan.net/poem58443.html","السريع"],[186,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[225,"أهجر النوم في طلاب العلاء","https://www.aldiwan.net/poem55222.html","الخفيف"],[229,"نعم المعين على الوغى في مأزق","https://www.aldiwan.net/poem50885.html","الكامل"],[235,"خليفة الله أنت في الدين وال","https://www.aldiwan.net/poem31824.html","المنسرح"],[298,"سامح الله الحمامه","https://www.aldiwan.net/poem36251.html","عموديه"],[348,"لو وجد اللائم بعض ماوجد","https://www.aldiwan.net/poem20074.html","مجزوء الرجز"],[380,"أذاب قلبي الوهج","https://www.aldiwan.net/poem49229.html","مجزوء الرجز"],[416,"يا سيدا ساد في الأشراف أجمعها","https://www.aldiwan.net/poem53847.html","البسيط"],[437,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[458,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[461,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[464,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[479,"لي صاحب في كل ف","https://www.aldiwan.net/poem36987.html","مجزوء الكامل"],[551,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[553,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[575,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[575,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[586,"وحق هذي الأعين الساحره","https://www.aldiwan.net/poem17530.html","السريع"]],"verses":[["لَو وَنى ذَلِكَ الغَمامُ لَأَطلَق","تُ مَزادَ الدُموعِ مِن أَجفاني",0,"ن",2,0],["لَو وَلي ما قَد وَلوا مِن عِترَتي","قائِمُ الشَركِ لَأَبقى وَرَعى",1,"ا",1,0],["لَو وَفى بِالزَكاةِ مَن جَمَعَ الدُن","يا وَأَهوى عَلى اِقتِناءِ الحُطامِ",2,"م",1,0],["لو وَازَرَ الماءَ اسْتَفَادَ قُوَى الصَّفَا","جَلَداً ولو كادَ الصَّفا لَتَضَيَّحَا",3,"ح",2,0],["لو وزنّا بالذي أوليتنا","شُكر أهل الأرض طُرّاً ما اتَّزن",4,"ن",1,0],["لَو وَلَجَ الناسُ في سَرائِرِهِم","هانَت وَرَبّي عَلَيهِم سَقَرُ",5,"ر",1,0],["لَو وَصَلتُم مُحِبَّكُم","ما الَّذي كانَ ضَرَّكُم",6,"م",1,0],["لو وَصَّلوا ما استدخلوا من فيشةٍ","في طولهم وصلوا السماء قعودا",7,"د",2,0],["لَو واصَلَت أَحَداً سِوى أَصحابِها","مِنهُم لَكانَ لَها أَخاً وَصَديقا",8,"ق",2,0],["لَو وازَنوا حَضَناً مالَت حُلومُهُمُ","بِالراسِياتِ الثِقالِ الشُمِّ مِن حَضَنِ",9,"ن",1,0],["لو وجَدَتْ للفِراقِ ما وَجَدا","لافتقَدَتْ نومَها كما افتَقَدا",10,"د",2,0],["لو وُزِنَتْ كلُّ صلاةٍ بها","من أنبياءِ اللَّهِ لم تَعدلِ",11,"ل",1,0],["لَو وَعَدَتني مَوعِداً صادِقاً","أَو كاذِباً بِالجِدِّ أَو بِاللَعِب",12,"ب",1,0],["لَو وُفِّقَ المَرءُ لَم يَبهَش إِلى اِمرَأَةٍ","أَوِ الغَريرَةُ لَم تُزفَف إِلى رَجُلِ",13,"ل",1,0],["لَوْ وَعِظَ النَّاسُ لمَا خُوطِبُوا","بِحَادِثٍ أَشْجَى وَلاَ أَرْوَعا",14,"ع",2,0],["لَو وَزَنَا بما أَقَمْتَ من الدُّسْتُورِ","آلاءَه اخْتَفَتْ آلاؤه",15,"ا",3,0],["لَوْ وَعَاهَا مَا اهْتَزَّ يُنْشِدُ يَوْماً","ذَاكَ وادِي الأَرَاكِ فَاحْبِسْ قَلِيلاَ",16,"ل",2,0],["لو وضعنا عن المروءَة سِفْرًا","كان عنوان سفرها، بنُّونه",17,"ن",2,0],["لو وضعت كفها على كتفي","ينبت من تحتها جناحان",18,"ن",1,0],["لو وجهه نعلا حصانين ، لو","ساقاه (مبغا) في قميص النهار",19,"ر",1,0],["لو وجدت الرحيق ما ذبت شجوا","وتحرّقت في المنى أشجانا",20,"ن",2,0],["لَو وَزَنّا بِكَ المُلوك اِمتِحاناً","في العَطايا لَكُنتَ أَرجَح وَزنا",21,"ن",2,0],["لو وطِئوا الضخر بأقدامهم","أو لمَستهُ راحُهم رَوّضا",22,"ض",2,0],["لو وفقوا الجروا في الخير طوع يد","جري الجواد ولم يلووا على البخل",23,"ل",1,0],["لَو وَضَعتم بدرَ السما في شمالي","وَبِيُمنايَ كانَ منكم ذكاءُ",24,"ا",2,0],["لَو وَنى عَزمهُ لما فازَ بِالقِد","حِ المُعَلّى في القُبَّةِ الزَرقاء",25,"ا",2,0],["لو وازن الأطوادَ فضلُك فاقها","عظماً ومال بعالِج وبيَذْبُلِ",26,"ل",1,0],["لَو وَسَموني وَسمَ العَبيدِ وَبا","عوني بِسوقِ الأَعرابِ ما قَنِعوا",27,"ع",3,0],["لو وَضعتمْ بيديَّ الش","مسَ والبدر قسامه",28,"م",2,0],["لَوْ وَجَدَ الّلائِمُ بَعْضَ مَاوَجَدْ","في الحُبِّ مَافَنَّدَهُ هذا الفَنَدْ",29,"د",1,1],["لَو وَجَدَ العُشاق لل","نَجاة باباً وَلَجوا",30,"ج",3,0],["لو وازنته ملوك الأرض قاطبة","لكان أرجحها في العز ميزانا",31,"ن",2,0],["لو واخذ اللّه أهل الحب إذ عشقوا","أو أن يعذّب أهوانا لهوانا",32,"ن",2,0],["لو وَهَبَ المرءُ يوماً نفسَهُ سَرَفاً","لم يَهبِ النفسَ إلا وهو مختصِرُ",33,"ر",1,0],["لو وَطِئتْ شَوكَ القنا نابتاً","في طُرُق العلياءِ لم تُنقَبِ",34,"ب",1,0],["لو واثَقَ الرمضاء في حبِّ الصدى","لغدا يَعُدُّ الضبَّ حوتَ الخضْرم",35,"م",1,0],["لو وطئت صم الحصى حوافياً","أنبعن عذب الماء من صفوانها",36,"ن",3,0],["لو وازنوه بغيره","لرأيت إبراهيم راجح",37,"ح",1,0],["لو وفى صاحبٌ وفى لي سوادٌ","زارَ فَوْدَيَّ منذُ كنتُ صَبيّا",38,"ي",2,0],["لَو وَزَنَ العاشِقونَ حُبَّهُمُ","لَكانَ حُبّي بِحُبِّهِم يَزِنُ",39,"ن",1,0],["لو وَاصلتني يوماً أَمُتْ كمداً","إِذ كُنتُ أَدخلُ فِردوساً وأَعرافا",40,"ف",2,0],["لو وَاصَلَتْنِيَ يَوْماً لم أَمُتْ أَبَداً","أَوْ لَمْ تَصِلْنِي فَيا مَوْتِي بها كمَدا",41,"د",2,1],["لَوْ وَاصَلْتني في الدُّجَى لَمْ يَبِتْ","قَلْبِي مِنْهَا وَهْوَ بالهاجِرَهْ",42,"ر",2,0]]}