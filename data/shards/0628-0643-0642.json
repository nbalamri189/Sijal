{"poems":[[240,"يا جمال الدين الذي أظهر العد","https://www.aldiwan.net/poem31585.html","الخفيف"],[353,"بك قد تيمنت الملوك الصيد","https://www.aldiwan.net/poem20046.html","الكامل"],[369,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[415,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[443,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[463,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[505,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138357",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138201",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126883","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136325","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136221","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136205","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136211","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136159","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79851","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79932","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49572","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88665","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93540","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100257","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100339","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65152","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65118","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86511","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135797","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111484","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72757","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139487",""],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102000","الرمل"],[5561,"يوم ذي قار","https://www.poetsgate.com/ViewPoem.aspx?id=208542",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5628,"حب بلا حدود","https://www.poetsgate.com/ViewPoem.aspx?id=191439",""],[5952,"يا ذا الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=210795",""],[6127,"آية الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=189497",""]],"verses":[["بِكَ قامَت سوقُ المَديحِ وَلَولا","كَ غَدَت وَهيَ أَكسَدُ الأَسواقِ",0,"ق",1,0],["بِكَ قَدْ تَيمَّنتِ المُلوكُ الصِّيدُ","إذْ حَيْثُ سِرْتَ تَيسَّرَ المَقْصُودُ",1,"د",1,1],["بك قَرطَس الغَرَضَ الإمامُ وقد رمَى","فغَدا منَ الباغي مُصيبَ المَقْتَل",2,"ل",1,0],["بك قصرُ قيصرَ قد تداعى مذ هوى","من كِسرِهِ كسرى أنوشروان",3,"ن",1,0],["بك قد أعز الله حزب جنوده","وأذل حزب الكفر والطغيان",4,"ن",1,0],["بك قد عاد عصبة أغنياء","حين راحوا ن قبلها فقراء",5,"ا",2,0],["بكَ قامتْ للنَدَى مُسكَتُه","وهو لولا الرمَقُ النِّضْوُ القتيلُ",6,"ل",1,0],["بك قد أعظم الإله مقامي","وحباني مجداً جليلا جليّا",7,"ي",2,0],["بك قطرنا يختال في حلل البها","جذلا وذيل التيه إعجابا سحب",8,"ب",1,0],["بك قد هنئنا يا كريم وكيف لا","نهنا بشهم جل عن أمثال",9,"ل",1,0],["بك قد بلغنا ذروة الإصلاح من","عمل بدا للغير شاقا مطلبا",10,"ب",2,0],["بِكَ قَد زَهَت أرضُ الطفوفِ زمانا","وَضيا جبينك ربعَها قد زانا",11,"ن",2,1],["بك قد صفت من دهرنا الأيام","وتشرفت بوجودك الأعوام",12,"م",1,1],["بك قد لذت مستجيرا فكن لي","حافظا واكفني الزمان وشره",13,"ر",2,0],["بك قد لذت يا عياذي فعذني","من زمان فيه الجفا والشرور",14,"ر",1,0],["بك قد لذت يا الهي ووصفي","مثل ما قد علمته الافتقار",15,"ر",1,0],["بك قد لذت فانتقذني وعذني","بعياذ من شر كل حسود",16,"د",1,0],["بك قرَّت عينا أخيك كما طَر","فُك قد عاد في أخيك قريرا",17,"ر",2,0],["بكَ قد دفعتُ الحادثات بقوَّةٍ","عنِّي وكنتُ وليسَ فيَّ حِراكُ",18,"ك",1,0],["بك قامَ القسطاسُ وانتعشَ الحقُّ","وَصِيْنَتْ مُذَالَةُ الأَعناق",19,"ق",1,0],["بك قرت من قريب كل عين","فلكل فيك يرجى وطر",20,"ر",1,0],["بِكَ قَد قَصرن مَع الأَحبة أَزمن","ما مرّ يَومك وَهوَ سَعد أَيمن",21,"ن",1,0],["بِكَ قَد تَشرفت العراق وفاخرت","مصراً لِأَنك ما بَرحت خَصيبا",22,"ب",2,0],["بك قد ضربت بقلَّصي","خوصا تقدُّ البيد قدّا",23,"د",2,0],["بك قد اذبت حشاشة","نزفت مع الدمع المكفكف",24,"ف",1,0],["بك قد آمن المعري وهذي","أعظم المعجزات شأناً وحرمه",25,"م",2,0],["بك قد تشرّفت الكتابةُ لا بها","مُستشرفٌ ولها بذاك فخارُ",26,"ر",1,0],["بك قد غدا وجهُ البسيطة مُشرقا","وعلاها بالعدل منك منارُ",27,"ر",1,0],["بك قد أراد اللَه أن يمحو البلا","ويلم شمل الدولة المفروقا",28,"ق",2,0],["بك قد استنصرتُ يا رحمنُ","ويا رحيماً بي لك الغفرانُ",29,"ن",1,0],["بِكَ قد ظَفِرنا لا تَرُم لَكَ نَجوَةً","وَلَئِن بذَلتَ لَنا البَلاغَ الأَصوَبا",30,"ب",2,0],["بك قد سمت فيك احتمت","من بعد ما سميت لخسف",31,"ف",1,0],["بك قد سرَّت الممالك كالزو","راء عيناً وسُرَّت العلياء",32,"ا",2,0],["بك قد هامت أسود منهم","حين أسبلت عقاصا منك سودا",33,"د",2,0],["بكِ قد نُصرنا وانتصرنا عزّةً","هيهاتَ تنتصِرُ الدناءةُ في الخُطَبْ",34,"ب",1,0],["بك ِ قدْ دخلتُ عوالم َ ال","مجهول ِ فامتدّت جسورُ",35,"ر",1,0],["بك ِ قد عرفت ُ الحبَّ فار","تفعت عن النفس ِ الستورُ",35,"ر",1,0],["بكِ قدْ تآلفت المشاعرُ كُلّها","وتوحّدتْ وعقيدتي التوحيدُ",36,"د",1,0],["بك قد تحلّى في البطاح ترابها","كالحور حلَّتْ مِعصماً بسِوارِ",37,"ر",1,0],["بكِ قدْ عرَفْنا أنَّ رَبِّي حاكمٌ","والحكمُ للمادونَ جورٌ يُفسِدُ",38,"د",1,0],["بكِ قدْ عَلِمْنا أنَّ ميزانَ النهى","هذا الكتابُ وما عداهُ يُبَددُ",38,"د",1,0]]}