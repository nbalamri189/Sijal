{"poems":[[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84527","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107098","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129498","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105532","الوافر"],[5122,"صدفه","https://www.poetsgate.com/ViewPoem.aspx?id=31519",""]],"verses":[["ظئر الكَمال اذا قَضى أَمراً فَلَم","يَلفى بأمر قد قضاه مظاظ",0,"ظ",1,0],["ظيا سوى سيرٍ أو وقفٍ وظورة را","ضعٍ بظا صرف بظرٍ هكذا حفظا",1,"ظ",2,0],["ظيان قد هز المديح إلا الندى","أعطافه لتعطف الوعاظ",2,"ظ",1,0],["ظئيلات الطلى لا هن عجف","ولا هن البطيئات الثقال",3,"ل",1,0],["ظيعت قلبي عساها من الجنه تظيع","من سببها ظاع حجزي وسجلت انتظار",4,"ر",1,0]]}