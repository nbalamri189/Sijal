{"poems":[[95,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[90,"أم كلثوم في فنون الأغاني","https://www.aldiwan.net/poem44430.html","الخفيف"],[68,"ذكر العهود فأسهر الطرف القذي","https://www.aldiwan.net/poem38493.html","الكامل"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[119,"للنبي صاحب البراق نحا","https://www.aldiwan.net/poem42007.html","المديد"],[168,"ذاب من فرط شوقه القلب حتى","https://www.aldiwan.net/poem67869.html","الخفيف"],[259,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[384,"قالت سليمى إنني لا أبغيه","https://www.aldiwan.net/poem4588.html","الرجز"],[435,"جاءت الأفراح بالبشرى على","https://www.aldiwan.net/poem41021.html","الرمل"],[482,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[543,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[563,"ذو العلم يعرف أن أصل المأخذ","https://www.aldiwan.net/poem33551.html","الكامل"],[580,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101341","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55953","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55934","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52078","السريع"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100445","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110280","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105002","البسيط"],[2297,"","https://poetry.dctabudhabi.ae/diwan/poem/178069","المنسرح"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126208","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60893","السريع"],[2437,"","https://poetry.dctabudhabi.ae/diwan/poem/127804","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84519","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99433","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103513","المديد"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65445","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130388","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112336","السريع"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127024","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86297","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129490","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110020","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92032","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117913","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36741","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131058",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69905","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36248","الدوبيت"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45129","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94361","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83632","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72979","المجتث"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105184","الخفيف"],[4935,"بقلم الأقدار دهري كتبا","https://www.poetsgate.com/ViewPoem.aspx?id=129390",""],[4935,"بلسان الشكر نهدي","https://www.poetsgate.com/ViewPoem.aspx?id=129345",""],[5002,"نجم السهى","https://www.poetsgate.com/ViewPoem.aspx?id=202367",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5598,"وشم على قافية الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=214173",""],[6090,"قدمت فليهن فيك المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=170911",""]],"verses":[["ذَاعَتْ دِعَايَتُهُمْ فَعَادَ نِدَاؤُهُمْ","بِإِجَابَةٍ وَالْفَضْلُ لِلْمُتَقَدِّمِ",0,"م",1,0],["ذاع من صوتها لها اليوم صيت","عمّ كلّ الأمصار والبلدان",1,"ن",1,0],["ذاعَت سَرائِرُ فَضلِهِ بَينَ الوَرى","وَسَما الأَنامُ بِجودِهِ المُستَحوَذِ",2,"ذ",1,0],["ذا عِفاءٍ يَفري الفَرِيَّ وَتَحدو","هُ النُعامى مُزوَرَّةً عَن سَفيرِ",3,"ر",1,0],["ذَاعَ فِي الشَّعْبِ وَصْفُهَا فَفَشَتْ آ","لاَمُهَا فِي القُلوبِ وَالأَجْسَادِ",4,"د",1,0],["ذا عليه الصلاة قد ثبتت","قبل بدء الخلق في الأزل",5,"ل",1,0],["ذاعَ ما كُنتُ كاتِماً مِن جَوى الحُب","بِ الَّذي ضَمَّهُ الفُؤادُ الوَقيذُ",6,"ذ",1,0],["ذا عذابي زاد ضعفاً","قد سقاني سُمَّ حتفي",7,"ف",2,0],["ذا عرمض يخضر كف عافيه","جاءت ولا تسأله بما فيه",8,"ي",2,0],["ذا علوم وكمال وهدى","ونظام سار في أوج العلى",9,"ل",2,0],["ذا عليلٌ من حرقةِ البينِ","والهجرِ بغيرِ اقترابِه لن يُبَلاّ",10,"ل",2,0],["ذا عيدُ تَحريرٍ قُبَيلَه مِثلُ ما","ياتي بُعَيدَه عيدُ مِسكِ خِتامِ",11,"م",1,0],["ذا عنده التحقيق ليس الشيء من","عدم كما في ظن ذي الطرف القذي",12,"ذ",2,0],["ذا عزَّني فيك وذَا عَادَني","لأَنَّه يَنْظر فِي نَاظِري",13,"ر",2,0],["ذاعت صنائع كفه وتضوعت","نفحاتها فكأنّما هي عنبرُ",14,"ر",1,0],["ذا علي تروى الأحاديث عنه","مسندات وللعلى إملال",15,"ل",1,0],["ذا علومٍ وكمالٍ وهدى","ونظام سار في أوج العلا",16,"ا",1,0],["ذاعت مآثر بره مذ كفه","ضاهى السحاب وقد حكى امطارَهْ",17,"ر",2,0],["ذاع في افريقية بك نشر","مثلما ضوع النوار هضابه",18,"ب",2,0],["ذا عِلةٍ في أزّمُنِ لاَزمتْ","كَانَ كَأن لَمْ يَرَهَا وَاجَهَتْ",19,"ت",1,0],["ذا عزمةٍ لو كان مارس بعضها","الحجر الأصم أو الحديد لذابا",20,"ب",2,0],["ذا عليٌّ راحلاً مرتزقا","راكباً في كلِّ هول مركبا",21,"ب",2,0],["ذَا عَابِدُ المعدُومِ لاَ سُبحَانَهُ","أبداً وَهَذَا عَابِدُ الأوثَانِ",22,"ن",1,0],["ذا عصمة من ضروب النائبات وذا","للحق حبل به أهل الهدى اعتصموا",23,"م",3,0],["ذاعت لنا في هواك أسرار","يا ظبية في الحشا لها دار",24,"ر",1,1],["ذاعَ بالخيرِ بينَ قومٍ كرامٍ","حسنُ ذِكرٍ فى لوحِهِ مَنبُوذُ",25,"ذ",1,0],["ذا عُمَرُ الفاروقُ مِنْ حَولِه","محمدٌ كالمصطفى المَرْسَل",26,"ل",1,0],["ذاعت مناقب فضلهِ بين الورى","ولها حديثٌ في البلاد يُترجَمُ",27,"م",1,0],["ذاعَ الحَديث بصبوتي فيهم كَما","ذاعَت صفات الشهم ذاكَ الجهبذ",28,"ذ",1,0],["ذا عزمة مشحوذة لم تكهم","لا زال يغشي الزند حد المخذم",29,"م",1,0],["ذا على خده من المسك سطرٌ","وعلى طرف ذا من الغنج سطر",30,"ر",1,0],["ذا عليه طِمرُ ذي شَعَثٍ","مَلَّت الأيامُ من قِدَمِه",31,"م",2,0],["ذا عبدُكم صالحٌ أتاكم","لهُ إلى الّطاعة انقيادُ",32,"د",1,0],["ذا عجيب كل من","خاله يستغربه",33,"ب",2,0],["ذا علّةٍ أمسى ولكنّهُ","يبدو صَحِيحاً كي يُضلّ الظنون",34,"ن",1,0],["ذاعت فضائله في الخافقين فدع","عنك التفاصيل واسألني عن الجمل",35,"ل",1,0],["ذا عِلَّة في صُحبَة لا تَتَّخِذ","ذَرهُ نَسِيّاً في الزَوايا وَاِنتَبِذ",36,"ذ",1,0],["ذا عصر سلطان النهى فالى متى","في موبقات الجهل كالمتنبذ",37,"ذ",1,0],["ذا عُذرُ من يرجوك حُسنَ قَبُولهِ","يا مَن بِهِ آمالنا تتعلَّقُ",38,"ق",1,0],["ذا عِقدُ واسطةِ الكِرامِ وسِلكُهُ","فكأنهُ للفضلِ شَملٌ شاملُ",39,"ل",1,0],["ذا عَليٌّ حَلَّ جَناتٍ زَهَت","مِن رضى الرَحمن في أَعلى جوار",40,"ر",1,0],["ذاعت صفات كماله وسمت به","شيم بها كبد الحسود تفلّذا",41,"ذ",2,0],["ذا عَزمَةٍ كَغِرارِ السَيفِ ماضيهِ","وَهمَّة مَنزِلِ الجوزاءِ تَكتَنِسُ",42,"س",1,0],["ذا عمره يومان يو","م فيه نيل المبتغي",43,"ي",1,0],["ذاعت مَآثرهُ شاعت مَفاخرهُ","ضاءَت مَنائِرهُ العليا لِمَن بَصَروا",44,"ر",3,0],["ذا عَريق المجدِ احيا","نَفحُ رَيّاهُ النُفوس",45,"س",1,0],["ذا عيشيَ رُدَّ شهدُهُ كالصابِ","ما أَثَّرَ نصحُ مَن أَوصى بي",46,"ي",1,0],["ذاعَ ما كانَ اِنكَتَم","فاِمضِ وَارُكني نُعاني",47,"ن",2,0],["ذا عجابٌ قد غزا الظَبيُ الأسود","بنفار وهو هيّابٌ سقيم",48,"م",1,0],["ذا عنصرُ التَوحيدِ فيه القُوى","لَعَلَّنا نَقوى وَنستكثرُ",49,"ر",1,0],["ذا عقد درّ نضيدِ","من مبدعات قصيدي",50,"د",2,1],["ذاع سرّ ما بيننا كان خاف","وهو قدما إلى الورى لن يذاعا",51,"ع",2,0],["ذا عمر الخطاب خير من رقى","منابر الدين وفيه خطبا",52,"ب",2,0],["ذا على كم تفرد","بالندى بين الكرام",53,"م",1,0],["ذا عمر حوريتي والشم كوكبها","قصيدة بالتمني بين أوردتي",54,"ت",2,0],["ذَا عيد تَبليِغ الرَّسالةِ سَمحةً","عَبرَ القُرونِ ، وَفىِ أَدقِ أَداء",55,"ا",2,0],["ذا \"عقبةُ \" المجد يحكي للورى قصة","و\"طارق\" الفذُّ حبّا في الورى سبقَا",56,"ق",2,0],["ذاعت بشائر يوم فيه جئت وقد","أضحت تناقلها البلدان والبيد",57,"د",1,0]]}