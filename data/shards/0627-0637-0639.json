طَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=215719",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5943,"تشطير (الشّعرُ لي )","https://www.poetsgate.com/ViewPoem.aspx?id=138283",""],[5956,"راعي","https://www.poetsgate.com/ViewPoem.aspx?id=184695",""],[5956,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=192541",""],[5973,"احذري أن تحصي من المراق","https://www.poetsgate.com/ViewPoem.aspx?id=13682",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6093,"لا تأخذوا رأيي بشعر معاصر","https://www.poetsgate.com/ViewPoem.aspx?id=192870",""],[6097,"أطعتُ هواك","https://www.poetsgate.com/ViewPoem.aspx?id=197432",""],[5309,"وطني هو الأرض التي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573566",""],[6218,"وطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65865&r=&rc=19",""],[6268,"فرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82914&r=&rc=0",""],[6300,"في رحاب الذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82837&r=&rc=8",""],[5190,"شَهد وسُهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85035&r=&rc=110",""]],"verses":[["أَطَعتَ وُشاةً لَم يَكُن لَكَ فيهِمُ","خَليلٌ وَلا جارٌ عَلَيكَ شَفيقُ",0,"ق",1,0],["أطعن الطاعنين للضاد من بالضّ","اد قد أنطق الاله لسانه",1,"ن",2,0],["أطعِم العقل ما اشتهاه من العل","م وإلا اسْتقَأت من سوء هَضم",2,"م",1,0],["أَطَعتُم أَمرَهُ فَتَبِعتُموهُ","وَيَأتي الغَيَّ مُنقَطِعَ العِقالِ",3,"ل",1,0],["أطعت بها الغواية والتصابي","وعاصيت النَّصيحة والملامهْ",4,"م",2,0],["أَطَعتُ مَطامِعي فَاِستَعبَدَتني","وَلَو أَنّي قَنَعتُ لَكُنتُ حُرّا",5,"ر",2,0],["أطعتِ فيَّ الأعادي","وكلّهُمْ قد عصيتُ",6,"ت",1,0],["اطعن بحدِّ القُمُدِّ قِدْماً","ما اسطاع في مَطْعن نفاذا",7,"ذ",2,1],["أَطَعتَ الوُشاةَ وَالمُشاةَ بِصُرمِها","فَقَد أَنهَجَت حِبالُها لِلتَقَضُّبِ",8,"ب",1,0],["أَطَعتُ الآمِرينَ بِصَرمِ سَلمى","فَطاروا في عِضاهِ اليَستَعورِ",9,"ر",1,0],["أَطَعتُ الهَوى بِالكُرهِ مِنِّيَ لا الرِضا","وَلو خَيَّروني كُنتُ غَيرَ مُطيعِ",10,"ع",1,0],["أَطَعتُكَ في سِرّي وَجَهريَ جاهِداً","فَلَم يَكُ لي إِلّا الملامَ ثَوابُ",11,"ب",1,0],["أَطعَمَ الوَرى","لَم يَقُل جَدَب",12,"ب",1,0],["أَطعَنُها بِالقَناةِ أَصرَبُها","بِالسَيفِ جَحجاحُها مُسَوَّدُها",13,"د",3,0],["أَطَعتُ الغَواني قَبلَ مَطمَحِ ناظِري","إِلى مَنظَرٍ يَصغُرنَ عَنهُ وَيَعظُمُ",14,"م",1,0],["أَطَعناكَ طَوعَ الدَهرِ يا اِبنَ اِبنِ يوسُفٍ","لِشَهوَتِنا وَالحاسِدو لَكَ بِالرُغمِ",15,"م",1,0],["أَطَعتَ لِسُلطانِ التَكَرُّمِ وَالعُلا","وَعاصَيتَ سُلطانَ الجَوى وَالتَذَكُّرِ",16,"ر",1,0],["أَطعَمتَنا الزَقومَ حينَ أَبَتَّنا","في خانِها وَسَقَيتَنا الغِسلينا",17,"ن",2,0],["أَطَعتُكَ يا إِبليسُ سَبعينَ حِجَّةً","فَلَمّا اِنتَهى شَيبي وَتَمَّ تَمامي",18,"م",2,0],["إِطعَن بِها طَعنَ أَبيكَ تُحمَدِ","لا خَيرَ في حَربٍ إِذا لَم تُوقَدِ",19,"د",1,1],["أَطَعتُ ما سَنَّ أَعدائي وَما فَرَضوا","وَشاهَدوكَ بِسُخطي راضِياً فَرَضوا",20,"ض",3,1],["أَطَعتُ داعي الهَوى رَغماً عَلى العاصي","لَمّا نَزَلنا عَلى ناعورَةِ العاصي",21,"ص",2,1],["أَطَعتُكَ جُهدي فَاِحتَفِظ بي فَإِنَّني","لِنَصرِكَ لا يَنفَلُّ جَدّي وَلا عَزمي",22,"م",2,0],["أَطَعتَ رَبَّكَ فيهِم وَالخَليفَةَ قَد","أَرضَيتَهُ وَشَفَيتَ العُربَ وَالعَجَما",23,"م",2,0],["أَطعَمَ السَيفَ نِصفَهُم وَرَمى النِص","فَ بِرَأيٍ صافي النِجارِ عَريقِ",24,"ق",1,0],["أَطَعْتُ الْغَيَّ فِي حُبِّ الْغَوَانِي","وَلَمْ أَحْفِلْ مَقَالَةَ مَنْ نَهَانِي",25,"ن",2,1],["أَطَعْتُ الْهَوَى فِيهَا وَإِنْ كَانَ ظَالِمَاً","وَعَاصَيْتُ فِي حُبِّي لَهَا كُلَّ رَاحِمِ",26,"م",1,0],["أَطَعتِ الوُشاةَ الكاشِحينَ وَمَن يُطِع","مَقالَةَ واشٍ يَقرَعِ السِنَّ مِن نَدَم",27,"م",1,0],["أَطَعتُهُ وَعَصَيتُ الناسَ كُلَّهُمُ","في أَمرِهِ وَهَواهُ وَهوَ يَعصيني",28,"ن",2,0],["أطعتم أمرَهُ فتلقّفتكم","من الأحداثِ داهيةٌ أكولُ",29,"ل",1,0],["أَطَعتُ هَوى طَرفي لِحَتفي لَو أَنَّي","غَضَضتُ جُفوني ما عَضَضتُ بَناني",30,"ن",2,0],["أَطعم العزّاب رَبّي مثلها","رَبِّ ما ضَرك لَو أَطعَمتنا",31,"ن",2,0],["أَطَعتُ ذَوي الأَحلام وَالرَأي وَالنُهى","حَديثاً وَقَد كُنتُ المَلُومَ المُعَذَّلا",32,"ل",2,0],["أَطَعنا رَسولَ اللَهِ إِذ كانَ صادِقاً","فَيا عَجَباً ما بالُ دينِ أَبي بَكرِ",33,"ر",1,0],["أطعتُ غيَّ الصَبَا في الحَالَتينِ وَما","حَصَلْتُ إلاَّ عَلَى الآثَامِ والنَّدَمِ",34,"م",1,0],["أَطِعِ الخَليفَةَ وَاِعصِ ذا عَزفِ","وَتَنَحَّ عَن طَرَبٍ وَعَن قَصفِ",35,"ف",1,1],["أَطَعتُ لِشَقوَتي قَلباً غَوِيّاً","إِلى اللَذّاتِ مَخلوعَ العِنانِ",36,"ن",1,0],["أَطَعتِ بِنا الوُشاةَ وَقَد عَصَينا","إِلَيكِ الناصِحينَ مَعَ الأَعادي",37,"د",2,0],["أَطَعتُ في الأَيّامِ سَدّاجي","وَسارَتِ الدُنيا بِأَحداجي",38,"ج",2,1],["أَطعت ضرورات الحياة وليتَني","عصيت ولكن كيف أسطيع عصيانا",39,"ن",2,0],["أَطَعت الهَوى فيك مستسلماً","ومن شام عينيك يَستَسلِم",40,"م",1,0],["\"أطعنها بالقناة أضربها","بالسيف، جحجاحها مسودها\"",41,"د",3,0],["أَطعَتَ بَني بُقَيلَةَ في وِثاقي","وكُنَّا في حُلُوقِهُمُ ذُبَاحا",42,"ح",2,0],["أَطْعْنَاهُ لَمْ نَعْدِلْهُ فِينا بِغَيْرِهِ","شَهَاباً لَنَا في ظُلْمَِ اللّيلِ هادِيَا",43,"ي",2,0],["أَطعتُ الصَبرَ في نوبٍ","عَلَيَّ الدَهرُ لَوَّنَها",44,"ن",3,0],["أَطَعتُ بَني نَفيلَةَ في وِثاقي","وَكُنّا مِن حُلوقِهِمِ ذُباحا",45,"ح",2,0],["اطعت بي العذال والدين منهجي","وطرزي التقى المحبوك بالصدق والصبر",46,"ر",1,0],["أطعتَ فيهم أناةً لا يسوِّغها","حلمٌ وقد خُلق الإنسانُ من عجلِ",47,"ل",1,0],["أَطَعتَ شارِعَ دينٍ أَنتَ ناصِرُهُ","فَصارَ يَجري بِما أَحبَبتَهُ القَدَرُ",48,"ر",1,0],["أَطَعناهُ كَرهاً حينَ لَم نَلقَ ناصِراً","عَلَيهِ وَلا في كَفِّ عَدواهُ مَطمَعا",49,"ع",2,0],["أطع مولاك تظفر بالنّجاح","وراقبهُ تَحُز قَصبَ الفَلاحِ",50,"ح",1,1],["أطعت الدهر فيَّ فلا أبالي","إذا ما أنت لي والدهر حزب",51,"ب",1,0],["أَطَعتِ الآمِرِيكِ بِقَطعِ حَبلِى","مُرِيهِم فِى أَحِبَّتِهِم بِذَاكِ",52,"ك",1,1],["أَطَعتُكِ حَتى أَبغَضَتنى عَشِيرتي","وأَقصَى إِمَامِي مَجلسِى وجَفانِى",53,"ن",2,0],["أَطَعتُ بِكم داعي التَّهتُّكِ ذاهِباً","بِنَفسي وَخالَفتُ العَذولَ المفنِّدا",54,"د",2,0],["أَطعَمُ الحاسِدونَ أَلوانَ غَمٍّ","في قَصاعِ الأَحزانِ وَالأَدواءِ",55,"ا",2,0],["أطعتُ فيه نَزَعَات الهوى","ولم أزلْ أعصي به العاذلين",56,"ن",1,0],["أَطَعناكَ حَتّى أَسلَمَ الناسُ كُلُّهُم","وَحَتّى صَبَحنا الجَمعَ أَهلَ يَلَملَما",57,"م",2,0],["أَطعَمتُهُ شَفَتي حيناً فَساوَمَ بي","كَأَنَّني سِلعَةٌ تُشرى وَتُحتَكَرُ",58,"ر",1,0],["أطَعْتُ الصِبَا وشبابي نضيرُ","ولم يبدُ في عارضِيَّ القَتِيرُ",59,"ر",1,1],["أطعنا الصبا في مواخِيرِها","ونِلنا المنى في مقاصِيرها",60,"ر",3,0],["أَطَعتَ هَوى المِلاح طِوالَ دَهري","وَمَن يُطعِ الهَوى يَعصَ اللَواحي",61,"ح",2,0],["أَطعهمُ إِن أَمروا","وصِلهُم إِن هَجَروا",62,"ر",3,0],["أَطَعتُ الصِبا في حبِّهنَّ مَدى الصِبا","فَلَمّا اِنقَضى اِستبدلتُ عنه التَصابيا",63,"ي",2,0],["أَطعهمُ واِحذَر العِصيان تنجُ إِذا","بيضُ الوجوه غدت في النار كالفَحمِ",64,"م",1,0],["أَطعتُ هَواها ما اِستَطَعتُ ولم يكن","لغير الهَوى نهيٌ عليَّ ولا أَمرُ",65,"ر",1,0],["أطع ربك البارى وصفوة رحمان","وذا الأمر والآباء في خير أديان",66,"ن",1,1],["أطعموا البائسَ الفقيرَ فإن جعتُم","فعيشوا على صدى الذكريات",67,"ت",1,0],["أطعمته تفّاحة حرمته","من ظلال الفرادس الوارفات",68,"ت",1,0],["أطعمته ترابها واستبدت","بقواه فلم يعد بالقوي",69,"ي",1,0],["أطعت الهوى عكس القضية ليتني","خلقت كبيراً وانتقلت إلى الصغر",70,"ر",1,0],["أَطَعتُ في حُبِّهِ أَمرَ الهَوى وَعَصا","قَلبي عَلَيهِ نَهى مَن عَنهُ يَنهاني",71,"ن",2,0],["أَطَعتُ أَمرَ الهَوى فيكُم بِمَعصِيَتي","مِن غَيرِ ما غِرَّةٍ عَنكُم نُهى الناهي",72,"ي",1,1],["أَطعْنا لَهُنّ شفيعَ الصِّبا","ورُحْنا عُصاةً على مَن عَذَل",73,"ل",1,0],["أَطَعتُ الرِضا في أَمرِها وَلَها الرِضا","وَأَرغَمتُ فيها عاذِلي وَلَهُ الرَغمُ",74,"م",1,0],["أطعَمتَها في الكَرَى ثمَّ ارتَحلتَ بِه","ما كانَ عَن ذا وذا في الحُبِّ أغناها",75,"ا",3,0],["أطعني واتخذني يا سميري","نصوحاً مخلصاً سرّاً وجهرا",76,"ر",2,0],["أطع رأي الخلافة في بنيها","ولا يذهب بك الرأي الجديد",77,"د",1,0],["أطعني فقد جربت ما قد ذكرته","وما جاء بالتجريب تسليمه ربح",78,"ح",1,0],["أطعني فقد جربت ما قد سمعته","وأين الذي تهديك فيه تجاربه",79,"ب",2,0],["أطعْتَ في حكمِكَ فيَّ الهَوَى","وما كذا يفعَلُ مَن يحكُمُ",80,"م",1,0],["أطعتُ حُكم الليالِي في فراقِيَ مَن","وِجدانُنا كُلَّ شيءٍ بعدَه عدَمُ",81,"م",1,0],["أَطِع الَهوى واعْصِ المُعاتِبْ","واصْدِف عن الواشِي المُراقِبْ",82,"ب",1,1],["أَطْعَمَتْهُ في فيك أطماعُنا في","ك فما نال بردَها والسَّلاما",83,"م",2,0],["أطعتُ الهوى ما إنْ دعاني له الهوى","ولما دَعَوتُ الصَّبر يومئذٍ أبى",84,"ب",2,0],["اطعلت من فوق وجنته","مثلما في مهجتي أجدُ",85,"د",1,0],["أطعت هوى نفسي وللنفس قائد","إلى كل ما فيه عقاب ولائم",86,"م",1,0],["أَطعني أَطع مولاك سرا وجهرة","تنل فضل خير ما بقيت وجاه",87,"ه",1,0],["أطعمتُها إبلى يرود بها","راعٍ بوسم عِلاطهِ يُعنَى",88,"ن",2,0],["أطعت العُلى لما غدوت لِتاجَها","ظهيراً على طرد الخطوب الغواشمِ",89,"م",1,0],["أطعت ملوك الأرض طاعة جاهلٍ","فأسفرَ حظي واستراحت عواذلُهْ",90,"ل",2,0],["أطع فيَّ العُلى وازجر رجالاً","سعوا في شأن مجدي بالفسادِ",91,"د",1,0],["أطْعتُ النُّهى في نجْدتي وبياني","فأصبح سيفي مُغمداً ولساني",92,"ن",2,1],["أطعتُ فيها الغيّ بعد العصيان","ديني الغرامُ والغرام أديان",93,"ن",1,0],["أطعت الهوى العذريّ وجداً بنازح","يطاعُ الهوى فيهِ وتعصى عواذله",94,"ل",2,0],["أطعتُ الغَوايةَ في حبَّها","غراماً بها وعصيتُ العّذولا",95,"ل",2,0],["أطعتُها وهوىً في دارها وُلِدا","وما خلا نفسَها فلم تطِعْ أحَدا",96,"د",2,0],["أطعن من هز طوال القنا","ما كل من هز القنا ماهر",97,"ر",1,0],["أطعتَ الهوى حتّى أضرَّ بك الهوى","وعلّم حزماً ما تقول العواذلُ",98,"ل",1,0],["أَطَعتَ رَبَّكَ فيما الحَقُّ لازِمُهُ","حَتّى أَطاعَكَ في أَعدائِكَ الأَجَلُ",99,"ل",1,0],["أطعَمَ المَنَّ لفظُهُ كلَّ سَمْعٍ","وعَصاهُ تلقَّفتْ كلَّ سِحْرِ",100,"ر",1,0],["أطَعْنا وسلَّمنا إلى الله أمرَنا","على كُلِّ حالٍ أنَّهُ مالكُ الأمرِ",101,"ر",1,0],["أطعَمتُهُ قلبي الكليمَ فما اكتَفَى","وسقَيتُهُ دمعي السَّجيمَ فما ارتَوَى",102,"و",2,0],["أطَعتَ العاذِلينَ بقتلِ صَبٍّ","يُريدُ القتلَ لكن عن رِضاكا",103,"ك",2,0],["اطعلتَ من سِحرِ البيانِ لطائفاً","سُحَراءُ بابلَ دُونَهُنَّ تَهيمُ",104,"م",1,0],["أَطِعْ في حبيبك غِشّ الهوى","وعاصِ العذول إِذا ما نصح",105,"ح",1,0],["أَطَعْتُ العِشْقَ في وَجْدِي عَلَيْهِ","وَقَلْبِي قَدْ عَصَى فيهِ المَواعِظْ",106,"ظ",1,0],["أطعمنَ مضن عضته انياب الشقا","والدهر عن أ