{"poems":[[74,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[369,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[466,"قدمت قدوم الصبح من بعد غيهب","https://www.aldiwan.net/poem16157.html","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95507","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93649","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130088","الكامل"],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[5829,"عرس حلب","https://www.poetsgate.com/ViewPoem.aspx?id=210425",""]],"verses":[["فأسطره نحو الدَّراري سلالمٌ","وإلاَّ فنحو الدّر في البحر أشطان",0,"ن",1,0],["فاسْطُرْ بِكَفِّكَ أسطُراً","تُشْبِهْنَ من حُسْنِ المِثال",1,"ل",1,0],["فأسطرُهُ ماذيُّ نَحْلٍ ولُؤْلُؤٌ","ولا ضربَ إِلا في شُجاعٍ مُصمِّم",2,"م",1,0],["فأسطرُهُ ماذيُّ نَحْلٍ ولُؤْلُؤٌ","نظيمٌ ومَزْجٌ من مُجاجةِ أرْقَم",2,"م",1,0],["فاسطع عليه بطلعةٍ ميمونة","لا يرتضى منها الغداة بديلا",3,"ل",2,0],["فَأَسطره للمسلمين سَلاسل","كَما أَنَّها للمسلمين دُروع",4,"ع",1,0],["فاِسطَع أبا الفاروق إنّ قلوبنا","قد شاقَها ذاك الجلال المُستَتِر",5,"ر",1,0],["فأسطرٌ من جهادٍ غير طامسةٍ","وأشطرٌ من حماس الشعر تؤتنف",6,"ف",1,0],["فاسطعي يا شمس من مشرقنا","نحن وجه الشمس سادات العرب",7,"ب",1,0]]}