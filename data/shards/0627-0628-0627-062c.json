{"poems":[[79,"تذكرت عهدا للشباب الذي ولى","https://www.aldiwan.net/poem35727.html","الطويل"],[79,"أبا جعفر إن الثقيل الذي ثوى","https://www.aldiwan.net/poem35835.html","الطويل"],[56,"أبا جعفر وأصول الفتى","https://www.aldiwan.net/poem27454.html","المتقارب"],[53,"أبا جعفر لا زلت معطى وواهبا","https://www.aldiwan.net/poem8161.html","الطويل"],[53,"أبا جعفر واصفح عن الفاء إنها","https://www.aldiwan.net/poem8302.html","الطويل"],[53,"رأيتك لم تحسن ثوابي ولم تجب","https://www.aldiwan.net/poem64016.html","الطويل"],[53,"أبا جعفر هل أنت قابل شاعر","https://www.aldiwan.net/poem65722.html","الطويل"],[53,"ظهور الأمور خلاف البطون","https://www.aldiwan.net/poem66401.html","المتقارب"],[47,"محمد ما آمالنا بكواذب","https://www.aldiwan.net/poem10648.html","الطويل"],[47,"أبا جعفر ليس فضل الفتى","https://www.aldiwan.net/poem10910.html","المتقارب"],[47,"أبا جعفر كل أكرومة","https://www.aldiwan.net/poem62671.html","المتقارب"],[47,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[47,"أبا جعفر كان تجميشنا","https://www.aldiwan.net/poem66849.html","المتقارب"],[63,"أبا جعفر لم تنسى الصنيعا","https://www.aldiwan.net/poem51569.html","المتقارب"],[63,"أبا جعفر كانت يداك سحائبا","https://www.aldiwan.net/poem51667.html","الطويل"],[51,"أبا جعفر هلا اقتطعت مودتي","https://www.aldiwan.net/poem64237.html","الطويل"],[46,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[46,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[46,"أبا جعفر أضحى بك الظن ممرعا","https://www.aldiwan.net/poem30568.html","الطويل"],[76,"أنفحة طيب ما تنسمت أم نظم","https://www.aldiwan.net/poem13259.html","الطويل"],[50,"أبا جعفر لازلت مشترك الرفد","https://www.aldiwan.net/poem63482.html","الوافر"],[108,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[79,"تذكرت عهدا للشباب الذي ولى","https://www.poetsgate.com/ViewPoem.aspx?id=34196",""],[190,"أبا جامحا أمسك عنانك مقصرا","https://www.aldiwan.net/poem43843.html","الطويل"],[197,"أبا جعفر هل فضضت الصدف","https://www.aldiwan.net/poem13077.html","المتقارب"],[242,"أبا جيد قد أممت بحرك جائدا","https://www.aldiwan.net/poem18048.html","الطويل"],[422,"أبا جميل قر عينا بمن","https://www.aldiwan.net/poem53939.html","السريع"],[458,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[466,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[466,"تبارى شبا آرائه ورماحه","https://www.aldiwan.net/poem16112.html","الطويل"],[466,"إذا كنت مضعوفا بأدنى فراقكم","https://www.aldiwan.net/poem16126.html","الطويل"],[466,"يرجى نداه في القطوب وجوده","https://www.aldiwan.net/poem16133.html","الكامل"],[466,"إذا الشمس غابت عن مسالك مسهل","https://www.aldiwan.net/poem16148.html","الطويل"],[466,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16179.html","الطويل"],[466,"ويا رب إن جازيت بالخير محسنا","https://www.aldiwan.net/poem16359.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126760","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126745","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126731","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97001","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96994","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97002","المتقارب"],[736,"","https://poetry.dctabudhabi.ae/diwan/poem/131444","المتقارب"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53897","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104579","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59818","الطويل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122864","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82632","المتقارب"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82628","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82666","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82623","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79876","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49595","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26506","الطويل"],[1941,"","https://poetry.dctabudhabi.ae/diwan/poem/145507","المتقارب"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143185","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110615","الرمل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17741","الطويل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105399","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82946","المتقارب"],[2613,"","https://poetry.dctabudhabi.ae/diwan/poem/144622","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122463","المتقارب"],[3069,"","https://poetry.dctabudhabi.ae/diwan/poem/198296","المتقارب"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11280","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107053","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112400","المتقارب"],[3662,"","https://poetry.dctabudhabi.ae/diwan/poem/45553","الطويل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32821","المتقارب"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93258","المتقارب"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67674","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139690",""],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124660","الطويل"],[5485,"تطاول في بغداد ليلى وضافنى","https://www.poetsgate.com/ViewPoem.aspx?id=200786",""],[6031,"سَلاَمي عَلَى مَولىً تَمَلَّكَ بِرُّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46388",""]],"verses":[["أبا جَعْفَرٍ جارَيْتَ كلَّ معلِّمٍ","ففُقْتَ بَنيهِ في طريقَتِكَ المُثْلى",0,"ل",2,0],["أبا جعْفَرٍ إنّ الثّقيلَ الذي ثَوى","بمَضْرِبِنا قدْ أعْجَلَتْهُ يدُ النّوى",1,"و",2,1],["أَبا جَعفَرٍ وَأُصولُ الفَتى","تَدُلُّ عَلَيهِ بِأَغصانِهِ",2,"ن",2,1],["أبا جعفرٍ لا زلت مُعطىً وواهبا","ومُكْسِبَ أموالٍ رِغابٍ وكاسبا",3,"ب",2,1],["أبا جعفر واصفحْ عن الفاء إنّها","تزيدك في جَعْرٍ من الأَفِّ جانبا",4,"ب",2,1],["أبا جعفرٍ صبراً فما زلتَ صابراً","على الذمّ لا تعدَم ذميماً من الصبر",5,"ر",1,0],["أبا جعفر هل أنت قابل شاعرٍ","كذوب يريد الانقياد إلى الصدقِ",6,"ق",1,1],["أبا جعفرٍ عَدِّ عَنيِّ وعنْ","كَ وُدّاً تُزَيِّنُهُ بالعُهون",7,"ن",1,0],["أَبا جَعفَرٍ مارِفدُ رِفدٍ بِمُسلِمي","إِلى مَذهَبٍ عَنكُم وَلا سَيبُ سائِبِ",8,"ب",1,0],["أَبا جَعفَرٍ لَيسَ فَضلُ الفَتى","إِذا راحَ في فَرطِ إِعجابِهِ",9,"ب",2,1],["أَبا جَعفَرٍ كُلُّ أُكرومَةٍ","بِأَخلاقِكَ البيضِ مَنسوجَه",10,"ج",2,1],["أَبا جَعفَرٍ هَذي مَساعيكَ غَضَّةٌ","وَهَذا لِساني قاطِعُ الحَدِّ مُطلَقُ",11,"ق",1,0],["أَبا جَعفَرٍ كانَ تَجميشُنا","غُلامَكَ إِحدى الهَناتِ الدَنِيَّة",12,"ي",2,1],["أبا جَعفَرٍ لِمَ تَنْسَى الصَّنيعا","وقد كُنتَ تُحْسِنُ فِيَّ الصَّنيعا",13,"ع",2,1],["أبا جعفَرٍ كانت يداكَ سَحائباً","تَفيضُ على الرَّكْبِ العُفاةِ غِزارُها",14,"ر",3,1],["أَبا جَعفَرٍ هَلّا اقتَطَعتَ مَوَدَّتي","فَكُنتَ مُصيباً فِيَّ أَجراً وَمَصنَعا",15,"ع",2,1],["أَبا جَعفَرٍ لِيُعِركَ الزَمانُ","عِزّاً وَيُكسِبكَ طولَ البَقاءِ",16,"ا",2,0],["أَبا جَعفَرِ إِنَّ الجَهالَةَ أُمُّها","وَلودٌ وَأُمُّ العِلمِ جَدّاءُ حائِلُ",17,"ل",1,0],["أَبا جَعفَرٍ إِنَّ الخَليفَةَ إِن يَكُن","لِوُرّادِنا بَحراً فَإِنَّكَ ساحِلُ",17,"ل",1,0],["أَبا جَعفَرٍ أَجرَيتَ في كُلِّ تَلعَةٍ","لَنا جَعفَراً مِن فَيضِ كَفَّيكَ سَلسَلا",18,"ل",2,0],["أَبا جَعفَرٍ أَضحى بِكَ الظَنُّ مُمرِعاً","فَمِل بِرَواعيهِ عَنِ الأَمَلِ الجَدبِ",19,"ب",1,1],["أَبا جَعفَرٍ لِلَّهِ دَرُّكَ فارِساً","بِحَيثُ سُطورُ الشِعرِ خَيلٌ لَهُ دُهمُ",20,"م",1,0],["أَبا جَعفَرٍ لازِلتَ مُشتَرِكَ الرِفدِ","تُعيدُ مِنَ المَعروفِ أَضعافَ ما تُبدي",21,"د",2,1],["أبَا جابر، كلُّ حي يصيرُ","إلى حتفه، كارهًا، أو مُريدا",22,"د",2,0],["أبا جابرٍ، شاهَ وجهُ الحياةِ","وصار الورى للحُطام عبيدا!",22,"د",2,0],["أبا جابر، ما نسينا الوفاءَ","ولا علَّمتنا الحروبُ الجحودا",22,"د",2,0],["أبا جعفر جاريت كل معلم","ففت بنيه في طريقتك المثلا",23,"ل",2,0],["أبا جامحا أمسك عنانك مقصرا","فإن مطايا الدهر تكبو ونعثر",24,"ر",1,1],["أَبا جَعفرٍ هَل فَضَضتَ الصَدف","وَهَل إِذ رَمَيتَ أَصَبتَ الهَدف",25,"ف",1,1],["أبَا جِيدَ قدْ أَمَّمْتُ بَحْرَكَ جَائِداً","لِأَكْرَعَ فِي سَلْسَالِ عَذْبِ الْمَوَاهِبِ",26,"ب",1,1],["أبَا جِيدَ جِيدُ الْكِيسِ أَصْبَحَ عَاطِلاً","وَغَالَتْ عُقُودَ الْوَفْرِكَفُّ النَّوَائِبِ",26,"ب",1,0],["أبا جميلٍ قُرَّ عيناً بمَنْ","بَلَّغَك الله به ما تريدْ",27,"د",1,1],["أبا جرير برغمي أن تَخَّط يدي","هذا العزاءَ ويبكى عاثراً قلمي",28,"م",2,1],["أبا جعفرٍ حيث النداءُ لخِضْرمٍ","بعيدِ النَّواحي لا خليجٍ وجعفرِ",29,"ر",1,0],["أبا جعفرٍ تاجَ المُلوكِ الذي لهُ","من المجدِ فضلٌ حادثٌ وقَديمُ",30,"م",1,0],["أبا جعفرٍ تاجَ الملوكِ الذي به","غَدَتْ دارسات الفضل وهي عوامر",31,"ر",1,0],["أبا جعفرٍ حاوي المَعالي قَديمها","وحادِثِها ما بين بأسٍ وأنْعُمِ",32,"م",1,0],["أبا جعفرٍ ما صامَ للّهِ صائمٌ","وعيَّدَ ذو عيدٍ وهَلَّ هِلالُ",33,"ل",1,0],["أبا جعفرٍ تاجَ المُلوكِ وإِنَّما","أُنادي مُشار الدهر بل شَرف الدهر",34,"ر",1,0],["أبا جعفرٍ ما لاحَ نجمٌ وما بَدا","صباحٌ وما غَنَّى الحَمامُ وغَرَّدا",35,"د",2,0],["أبا جعفرٍ إنّا نُشاطِرك الأسى","وَنَرجو منَ الرَحمن يمنحك الصبرا",36,"ر",2,1],["أبا جعفرٍ ما زلتُ أشكرُ نعمةً","عليّ تفضّلتم بها أبَدَ الدهرِ",37,"ر",1,1],["أبا جعفر يا اِبن الّذين بحبّهم","تنادي الورى آمالها والمقاصدا",38,"د",2,1],["أبا جعفرٍ أنت المرجى لمحنةٍ","إذا أكشلت أضحى إلى الحق مشرعا",39,"ع",2,0],["أبا جعفرٍ أنت نعم الدليل","لمن حار يوماً ونعم المجير",40,"ر",1,0],["أبا جعفرٍ لم أفه بالعزا","لأنك أذكى ذوي دهره",41,"ر",2,0],["أبا جعفر فتوقَّ الإله","ولا تذكر اللّه من فقحة",42,"ح",2,0],["أبا جعفرٍ كمْ ذا تَصُدُّ وتَهْجُرُ","وقلبي بما حَمَّلْتَه ليس يَصْبِرُ",43,"ر",1,1],["أبا جعفرٍ يا باني المجدِ بعدما","تهدَّمَ ركنُ المجدِ في كلِّ موضعِ",44,"ع",1,0],["أبا جعفر هل في الوصال بقية","فلم يبق لي صبر وإني لصابر",45,"ر",1,0],["أبا جعفر ما أحسن العفو كله","ولا سيما عن قائل ليس لي عذر",46,"ر",1,1],["أَبا جَعفَر سُمتَني خُطّة","تَجاوَزتَ فيها وَلَم تَعدِل",47,"ل",1,1],["أَبا جَعفَر خَف تَبوة بَعد صَولَة","وَقَصِّر قَليلاً عن مَدى غُلُوائِكا",48,"ك",2,1],["أَبا جَعفَر إِن كانَ قَدّمك الرَّدى","أَمامي وَعاداكَ الحِمامُ فَأَسرَعا",49,"ع",2,0],["أَبا جَعفَر هَلّا اِصطَنَعتَ مَوَدّتي","وَكُنتَ مُصيبا فيَّ أَجراً وَمَصنَعا",50,"ع",2,1],["أبا جعفرٍ أنت لطفُ الإِله","وأنت لرأفتهِ مَظهَرُ",51,"ر",1,0],["أبا جعفرٍ هذي المكارمُ والعُلا","دعاءً بحقٍّ وادعاءً على عِلم",52,"م",1,0],["أَبا جَعفَرٍ عَرِّج عَلى خُلَطائِكا","وَأَقصِر قَليلاً مِن مَدى غُلَوائِكا",53,"ك",2,1],["أبا جعفر أنت من معشر","حووا في العلا شرف المنصب",54,"ب",1,1],["أبا جعفر كم جعفر من مدامع","ترقرقه ذكرى ليال تسلفت",55,"ت",1,1],["أبا جعفر أنت أزكى أب","ولدت بحجر العلى المنجب",56,"ب",1,1],["أَبا جَنبَرٍ أَبصِر طَريقَكَ وَاِلتَمِس","سِوى حَقِّنا مَعداكَ إِن كُنتَ عادِيا",57,"ي",2,0],["أبا جعفرٍ عفواً ولم تك هفوةٌ","فغيري من يهفو ومثلك من يعفو",58,"ف",2,1],["أَبا جعفر لست بِالمُنصفِ","وَلستَ إِذا قلتَ قولا تفي",59,"ي",1,1],["أبا جعفرٍ إنَّ الأمور إذا الْتوتْ","وأعْيَتْ بزَيْغ الخُلْف كلَّ مُقَوِّمِ",60,"م",1,1],["أَبَا جندَرٍ ضاعَ نفعُ الصَّدِيقِ","ونفعُكَ للحاسِدِ الماكِرِ",61,"ر",1,0],["أبا جعفر مات فيك الجمال","فأظهر خَدّك لبْسَ الحِداد",62,"د",1,1],["أَبا جَعفَرٍ يا بنَ الجَحاجِحَةِ الغُرِّ","بَدَت حاجَةٌ وَالحُرُّ يَأوي إِلى الحُرِّ",63,"ر",1,1],["أبا جعفر يا ابن الإمام إصاخة","لرق لكم في الرق تعلو مناحبه",64,"ب",2,0],["أبا جعفر كل المديح ضلالة","سوى مدحكم فرض من اللَه واجبه",64,"ب",2,0],["أبا جعفر عطفاً علي فانني","مقيم على مغناك لست اجانبه",64,"ب",2,0],["أبا جيرَةَ الحيّ أين الطريق","فإني ضَلَلت عنِ المَنزِلِ",65,"ل",1,0],["أَبا جُندَبٍ وَالفَخرُ إِن كُنتَ فاخِراً","أَبا جُندَبٍ عِندَ القَطيعِ المُصَلَّبِ",66,"ب",1,0],["أَبا جُندَبٍ وَإِذ يَقولُ خُوَيلَدٌ","بِذاتِ المَجازِ أَدرَكَ القَومُ فَاِذهَبِ",66,"ب",1,0],["أَبا جَعفَرٍ لا تَنالُ العُلا","بِتيهِكَ في المَجلِسِ الحاشِدِ",67,"د",1,1],["أَبا جعفر أَشرقتْ دولةٌ","أَضاء لها بدرُك الكامِل",68,"ل",1,0],["أبا جعفرٍ إنّ الولاية إن تكن","مُنبِّلَةً قوماً فأنت لها نبْلُ",69,"ل",1,1],["أبا جعفرٍ عطفاً فانَّ مآربي","لغيرك مهما زاحمت لا أذيعها",70,"ع",3,0],["أبا جعفر بكر اليك زففتها","عروسا يفوح المسك منها وبعبق",71,"ق",1,0],["ابا جعفر يا خير وائل كلها","اذا نزلت بالناس احدي النوائب",72,"ب",1,0],["أبَا جَعفَرٍ إنِّي ومَنْ ضُرِبَتْ لَهُ","بُطُونُ المطَايَا تَحملُ الشِّيبَ والمردَا",73,"د",2,0]]}