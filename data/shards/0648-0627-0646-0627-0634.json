{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[23,"وإنما الشعر لب المرء يعرضه","https://www.aldiwan.net/poem21516.html","البسيط"],[93,"وسائلة أي المذاهب مذهبي","https://www.aldiwan.net/poem62662.html","عموديه"],[94,"يا صميم الحياة إني وحيد","https://www.aldiwan.net/poem38927.html","الخفيف"],[94,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[68,"كفى الشعر فخرا أنه كل مشكل","https://www.aldiwan.net/poem40652.html","الطويل"],[68,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[99,"أهب ببيانك الصافي تدفق","https://www.aldiwan.net/poem24394.html","الوافر"],[99,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141934","الرمل"],[102,"مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=50153",""],[92,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[96,"دمعة على الشاعر عبد الحميد الرافعي","https://www.poetsgate.com/ViewPoem.aspx?id=13792",""],[154,"قل للمحدث الصوفي من","https://www.aldiwan.net/poem68486.html","المنسرح"],[171,"تغير الفتح","https://www.aldiwan.net/poem1071.html",""],[201,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[214,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[242,"زعموا أني برطال","https://www.aldiwan.net/poem19060.html","مجزوء الرمل"],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[353,"إذا أوترت قوس السحاب وفوقت","https://www.aldiwan.net/poem20772.html","الطويل"],[354,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[358,"أشاقك صوت غنا الأورق","https://www.aldiwan.net/poem40020.html","المتقارب"],[369,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[376,"إذا أنت لم ترع البروق اللوامحا","https://www.aldiwan.net/poem57514.html","الطويل"],[445,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[500,"أنا في اعتقادي للتسن","https://www.aldiwan.net/poem10252.html","مجزوء الكامل"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[580,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48683","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122330","الطويل"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19934","الطويل"],[1019,"","https://poetry.dctabudhabi.ae/diwan/poem/123317","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133776","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95536","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125480","الرمل"],[2378,"","https://poetry.dctabudhabi.ae/diwan/poem/199544","الوافر"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199841","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93926","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205036","الوافر"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52994","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94464","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136742",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83491","الوافر"],[4603,"","https://poetry.dctabudhabi.ae/diwan/poem/204425","البسيط"],[4728,"الهلامة والصتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=176970",""],[4728,"رسالة من غريب (هلالي قصير)","https://www.poetsgate.com/ViewPoem.aspx?id=176996",""],[4755,"تَجْتَاحُنِيْ فِيْ هَذِهِ الآوِنَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=184716",""],[4790,"من بعض ما قال العراق","https://www.poetsgate.com/ViewPoem.aspx?id=109649",""],[4791,"اهل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=34896",""],[4802,"انا المخلص لأبونا آدم","https://www.poetsgate.com/ViewPoem.aspx?id=32675",""],[4867,"بيان الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=25022",""],[4883,"شمس مالها مغرب","https://www.poetsgate.com/ViewPoem.aspx?id=48432",""],[5032,"إمتداد من جراح","https://www.poetsgate.com/ViewPoem.aspx?id=190348",""],[585,"عليك وإلا ما عقدت رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=161913",""],[5135,"القهوة","https://www.poetsgate.com/ViewPoem.aspx?id=201885",""],[5183,"الدويّ الحيران","https://www.poetsgate.com/ViewPoem.aspx?id=180175",""],[5302,"خير الأحبة نجود","https://www.poetsgate.com/ViewPoem.aspx?id=201738",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[5561,"ضفاف دجلة","https://www.poetsgate.com/ViewPoem.aspx?id=197385",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5587,"أنت الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=202780",""],[5594,"أعقبت من فعلى النّدامه","https://www.poetsgate.com/ViewPoem.aspx?id=201058",""],[5841,"على شطي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=61596",""],[5843,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=51289",""],[6093,"النت ( مجزوء الكامل المرفل)","https://www.poetsgate.com/ViewPoem.aspx?id=181568",""],[6186,"متجردٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82884&r=&rc=4",""],[6237,"مسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77905&r=&rc=47",""],[463,"منْ حاكمٌ وخصوميَ الأقدارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60069&r=&rc=125",""]],"verses":[["وإنْ أشرَقْنَ فاكْتَحَلَتْ عُيونٌ","بها لمْ تَرْضَ بالقَمَرِ اكْتِحالا",0,"ل",2,0],["وَإِنَّ أَشعَرَ بَيتٍ أَنتَ قائِلُهُ","بَيتٌ يُقالَ إِذا أَنشَدتَهُ صَدَقا",1,"ق",2,0],["وَأَن أَشرَبِ الصَهباءَ أَعلَمُ أَنَّني","شَرِبتُ بَشاشاتِ الزَمانِ الَّذي وَلّى",2,"ل",2,0],["وأَناشيدَ يأكُلُ اللَّهَبُ الدَّا","مي مَسَرَّاتِها ويُبقي أَساها",3,"ه",2,0],["وأناشيدَ تُسْكِرُ الملأَ الأعلى","وتُشْجي جَوانحَ الجلمودِ",4,"د",1,0],["وَإِن أَشكَلَت في الشَرعِ غامِضُ نُكتَةٍ","إِلى النَظمِ يُلجا حينَ يُعوِزُ بِالنَثرِ",5,"ر",1,0],["وَإِن أَشبَهَتهُم في الفَخارِ خَلائِقي","وَفِعلي فَهَذا الراحُ مِن ذَلِكَ الكَرمِ",6,"م",1,0],["وإن أشكر يداً لك وَهيَ تسدي","فتلكَ يدُ العظيمِ إلى العظيمِ",7,"م",1,0],["وأناشيدكم وما","صاغه الفنُّ من عِظم",8,"م",1,0],["وإن أشهى الأغاني في مسامعنا","ما سالَ وهو حزينُ اللحنِ مكتئب",9,"ب",1,0],["وأناشيد الهوى في أذنيك","همساتُ القطرِ بل رنّاتُ أيكِ",10,"ك",1,0],["وأنا شاعر وما الشعر إلاّ","خفقاتي تذوب شجوا منغّم",11,"م",1,0],["وإن أشرَّ ما يلقى أريبٌ","وأوجعَ ما يَحار به الدَّهاء",12,"ا",2,0],["وأنا شاعر الشباب وعندي","ما يشاؤون من منى وقصيد",13,"د",1,0],["وإن أشاع الصحاب حبَّهم","قصرت حبي على ابن معروف",14,"ف",1,0],["وإن أشاكيكِ إذ عزّتْ معانقةً","وعزَّ منك وصال ٌ دونما سبب ِ",15,"ب",1,0],["وأنا شاعر خلقتُ لأشدو","لا لأتلو القرآن في المحراب",16,"ب",1,0],["وان اشفقت من ذنب","فان الله ذو بر",17,"ر",1,0],["وَأَنَا شَخْصٌ ظَرِيفٌ","أُطْرِبُ النَّاسَ بِأَقْوَالْ",18,"ل",1,0],["وان اشد القتل عند ذوي النهى","بأن تجعل الأعداء حولك حسدا",19,"د",2,0],["وإِن أَشارَ مُغريا","بالشرِّ كانَ مغويا",20,"ي",2,0],["وَإنْ أَشبَهتْ أَلوانُها زَهْرَ الرُّبَا","عَرْفتُ لِتلكَ القَوسِ قُدرةَ بَارِيها",21,"ه",2,0],["وَإِنَّ أَشَرَّ الناسِ ذَمّاً لِنَفسِهِ","إِذا اِفتَخَروا مَن بِالرُفاةِ لَهُ الفَخرُ",22,"ر",1,0],["وَإِن أَشدَّ بِلاءِ الحَليم","مُعاشرة الجاهلِ الأَحمَقِ",23,"ق",1,0],["وإن أَشرقَتْ شَرِقَتْ عُصبَةٌ","من الحاسدِينَ بإشْراقها",24,"ق",3,0],["وإن أشرقَت ألفاظُه فطروسُه","دجى الليل ما بين النهارين جانِحا",25,"ح",2,0],["وإِن أُشْرِعَتْ من دونِ مشربِهِ القنا","وكاشَرَ عَنهُ الأسدُ دامِيَةَ الأَلْحِي",26,"ح",2,0],["وإِنْ أَشْرَقَ النَّادِي بنور سَناهُما","فَبُشرى الأَماني عَيْنَك لا ضِمَارَكِ",27,"ك",1,0],["وإن اشتفى وحَلاَ بفيه غدرُهُ","أنَّ اعتقابَ حلاوتيه مُرارُ",28,"ر",1,0],["وإن اشتغلت بهؤلا","ء فلست أغفل عن أولئك",29,"ك",1,0],["وإِنّا شَبَبْنا في عِراصِ دياركمْ","ضياءً وليلُ الكفر فيهنّ مُسْدَفُ",30,"ف",1,0],["وإنْ أَشبهوه خِلْقةً لا سجيَّة","فلا عجباً قد يشبه العسجدَ الصُّفْرُ",31,"ر",1,0],["وإن اشتهى نعماك كل مسالم","فقد ابتلى مرماك كل محارب",32,"ب",1,0],["وان اشتيقاي بالأصائل والضحى","بقلبي منه موضع الشوق مفعم",33,"م",1,0],["وإن أشرفت من آكم الماء ميفعاً","لوت رجلها اليسرى بالأخرى فحنت",34,"ت",1,0],["وإن اشتياقي نحوها ليطيربي","لاقر بها منى بأجنحة النسر",35,"ر",1,0],["وأناشيد كبوح الزهر في","اذن العتمة بين السمراء",36,"ا",2,0],["وإنّ أشبالك الأنجاب قد قبسوا","منك الصفات فكم فازوا وكم نجحُوا",37,"ح",3,0],["وأناشيد المُنَى","والأمَل",38,"ل",1,0],["وإن أشكو الزمان فإن ذخري","أمين الدولة المولى الوزير",39,"ر",1,0],["وإن أشد أهل الأرض حزناً","وغماً منهما لا يستفيق",40,"ق",1,1],["وإن أشرقت في الشرق شمس افتخارهم","ففي الغرب منهم كل بدر قد استهل",41,"ل",1,0],["وإن أشد ما يشجي بكاء","يخون الدمع فيه والنحيب",42,"ب",1,0],["وإن اشتكت مصر نواهُ برهةً","وغدتْ لبشرى عَوده تتنسم",43,"م",1,0],["وَإِن أَشرَعتَ لدن القُدودِ لَكَ القَنا","وَفَوَّقتَ الأَلحاظِ نَحوَكَ أَسهُما",44,"م",2,0],["وإن أشهرت سهماً على قوس حاجب","يرنُّ باخلابٍ ولو كان في الغمدِ",45,"د",1,0],["وإن أشرتُ من بعيدٍ بالثنا","قبلَ اللقا حرفة عانٍ صُرعا",46,"ع",2,0],["وَإِن أَشكو العَقارِبَ وَالأَفاعي","فعند الكلّ ترياقُ الأفاعي",47,"ع",2,0],["وإن أشرت إلى صوت تكرره","إنا محيوك فاسلم أيها الطلل",48,"ل",1,0],["وأنا شقاي أكبر شقى والعلامة","ترنيمتك بين البكى والشكيمة",49,"م",2,0],["وأنا شجيٍّ يوم أفكّر بصاحبي","على نمارق مثل ريش نعام",50,"م",1,0],["وإنَّ أشهَى مُخرَجَاتِ الحِوَا..","مِن مُدخَلَاتِ الدّولةِ الضَّامِنه",51,"ن",2,0],["وانْ أشكو فَمَنْ يُصْغي وفينا","جَميعُ الحاكمينَ هُمُ ذُيولُ",52,"ل",1,0],["وان اشتغل بي خفا غيبك","كني ملكت العرب بكتاب",53,"ب",1,0],["وانا شاعر ياناس البنت لقاها ضحكت أبياته","عشقهامزعجة يمكن لقى بإزعاجها راحة",54,"ح",2,0],["وانا شفت الزمان منصف على كل حال","بس وحدنا يا بني البشر ما به منه قنعان",55,"ن",1,0],["وأنا شِعري قصيْد ٍ مِن قصيْد ٍ شِعره يْعِيْدك:","لقندِيله، لنوره، للخَطَا، للذَنْب، للمُذْنِب !",56,"ب",1,0],["وأَنا شَرُّ طُمُوحٍ لَبِسَتْ","جُبَّةَ الدِّينِ وعُوُدَ الخَيْزَران",57,"ن",1,0],["وإن أشد الضعف بأس مزور","يكون معاراً أو يكون عطاء",58,"ا",2,0],["وَإنْ أَشْتَمَّ رِيْحَتَهَا تَجِدْنِي","خَفِيْفَ النَّفْسَ مُرْتَاحاً طَرُوْبا",59,"ب",2,0],["وأناشيد في الفضاء صُداها","ضائع خلف صوتها المتعوب",60,"ب",1,0],["وإن اشتكى سالت دموع عيونه","والصوت بين دموعه مخنوق",61,"ق",1,0],["وإن أشد من هذا السعي","بقطع معاشهم لما استقام",62,"م",1,0],["وأناشيدُ الصمتِ تُسكرُ روحي","ليتَني كنتُ في نشيدٍ هديلْ",63,"ل",1,0],["وانا شاهد الي ماستراحت بمجلسك","على العز والنوماس والفخر دايبه",64,"ب",2,0],["وَ إِنْ أَشْعَلْتُ أَنْفَاسِي شُمُوعًا","تَرُومُ الشَّمْسُ لِلضَّوْءِ انْتِسَابَا",65,"ب",2,0],["وأنا شكوت إلى الّذى","ورث الخلافة والامامه",66,"م",2,0],["وأنا شوقي لكل الربع باحي","ضعف قلبي واجرى الكل نصحه",67,"ح",2,0],["وانا شاعر يجاذبني غلاك مجاذب النسناس","لوردٍ في شفاء الطايف ومنظودٍ على سقفين",68,"ن",1,0],["وأُناشُدُ الأشعَارَ لِيْ","بِيَّاً يُطَّرِبُ فانطربتُ",69,"ت",1,0],["وأنا شربت الماء بالملح الذي","أدمى جراحي في شقوق جداري",70,"ر",2,0],["وأنا شاعر وما الشعر إلا","رحلة الفكر في محيط الخواطرْ",71,"ر",1,0],["وإن اشتفى وحلا بفيه غدرهُ","أنَّ اعتقابَ حلاويته مرارُ",72,"ر",1,0]]}