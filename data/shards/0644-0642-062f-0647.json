],[5540,"تهاني","https://www.poetsgate.com/ViewPoem.aspx?id=216063",""],[5550,"أَبُثُّ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213054",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5686,"دروب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203361",""],[5804,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184421",""],[5851,"وصية مرتحلة","https://www.poetsgate.com/ViewPoem.aspx?id=175272",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[6093,"فَمَا كُلُّ قَولٍ يُقَالُ صَحِيْحاً (المتقارب)","https://www.poetsgate.com/ViewPoem.aspx?id=181457",""],[6345,"جور الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78653&r=&rc=24",""]],"verses":[["لَقَد هاجَ هَذا الرُزءُ رَيعانَ زَفرَةٍ","تَلَقَّيتَها بِالقَولِ عَن قَلبِ موجَعِ",0,"ع",1,0],["لَقَد هَزَّ أَحشاءَ البَعيدِ مُصابُهُ","فَكَيفَ المُداني وَالقَريبُ المُصاقِبُ",1,"ب",1,0],["لَقَد هانَ عِندي الدَهرُ لَمّا عَرَفتُهُ","وَإِنّي بِما تَأتي المُلِمّاتُ أَخبَرُ",2,"ر",1,0],["لَقَد هَدَّ الهَوى بَدَني وَأَضنى","فُؤادي الهَمُّ مِن طولِ اِشتِياقي",3,"ق",2,0],["لَقَدْ هَزَّ مِنْكَ الْعَزْمُ لمَّا انْتَضَيْتَهُ","ذَوَائِبَ رَضْوَى أَوْ مَنَاكِبَ ثَهْلاَنِ",4,"ن",1,0],["لَقَدْ هَاجَنِي شَوْقٌ إِلَيْهَا مُبَرَحٌ","إِذَا شِمْتُ بَرْقَ الشَّرْقِ شَبَّ ذُبَالُهُ",5,"ل",2,0],["لقدْ هدّ أرْكانَ الوجودِ مُصابُهُ","وأنْطَقَ منهُ الشّجْوُ مَنْ كانَ صامِتا",6,"ت",2,0],["لَقَد هَجَرَت سُعدى وَطالَ صُدودُها","وَعاوَدَ عَيني دَمعُها وَسُهودُها",7,"د",3,1],["لقد هجتني يا أحمد اليومِ بالأسى","وذكَّرتني ما كَنت بالأمس ناسيا",8,"ي",2,0],["لقد هَوَّنت رُزء اليتم حتى","غفرنا للزمان بك الأثاما",9,"م",2,0],["لَقَد هَتَفَ اليَومَ الحَمامُ لِيُطرِبا","وَعَنّى طِلابُ الغانِياتِ وَشَيِّبا",10,"ب",2,1],["لَقَد هاجَ هَذا الشَوقُ عَيناً مَريضَةً","أَجالَت قَذاً ظَلَّت بِهِ العَينُ تَمرَحُ",11,"ح",1,0],["لَقَد هاجَ هاذا الشَوقُ عَيناً مَريضَةً","وَنَوحُ الحَمامِ الصادِحاتِ السَواجِعِ",12,"ع",1,0],["لَقَد هاجَ نَفسَكَ أَشجانُها","وَعاوَدَها اليَومَ أَديانُها",13,"ن",3,1],["لقد هتكتْ ما أتى دونه","بحدٍّ حديدٍ وبأْسٍ شديد",14,"د",1,0],["لَقَد هَزَأوا لَمّا تَنَبَّهَ بَعضُهُ","فَلِم ذُعِروا لَمّا تَنَبَّهَ سائِرُه",15,"ر",2,0],["لَقَد هَوى بِكُما نِجمانِ ما رَميا","إِلّا مِن العُلوِّ بِالأَلحاظِ كيوانا",16,"ن",2,0],["لقد هاجَني والصبحُ طلْقُ المباسمِ","على ملعب الأفنان ورقُ الحمائِمِ",17,"م",1,1],["لَقَد هَتَكَ العَبدُ الطِرِمّاحُ سِترَهُ","وَأَصلى بِنارٍ قَومَهُ فَتَصَلَّتِ",18,"ت",1,1],["لَقَد هاجَ مِن عَينَيَّ ماءً عَلى الهَوى","خَيالٌ أَتاني آخِرَ اللَيلِ زائِرُه",19,"ر",2,1],["لَقَد هَدَّ فَقدُكَ أَهلُ الحِفاظِ","فَصَلى عَلَيكَ وَلِيُّ النِعَم",20,"م",1,0],["لَقَد هانَ عَلى الناسِ","مَن اِحتاجَ إِلى الناسِ",21,"س",1,1],["لَقَد هَذَّبَتني يَقظَةُ الرَأيِ وَالنُهى","إِذا هَذَّبَت غَيري ضُروبُ التَجارِبِ",22,"ب",1,0],["لَقَدْ هَانَتِ الدُّنْيَا عَلَى النَّاسِ عِنْدَمَا","رَأَوْكَ بِهَا فِي مُلْكِ يُوسُفَ تَحْكُمُ",23,"م",1,0],["لقد هُنتُ حتى صرْتُ للمجدِ فاعلاً","ألا في سبيل المجدِ ما أنا فاعلُ",24,"ل",1,0],["لقدْ هانَ المقلُّ على البرايا","فلمْ يخطرْ لمخلوقٍ ببالِ",25,"ل",1,0],["لَقَد هَزَّني في رَيطَةِ الشَيبِ هَزَّةً","أَرَتني وَرائي في الشَبابِ أَمامي",26,"م",2,0],["لَقَد هِجتَ مِني عِندَ نَوحِكَ ساكِناً","وَأَضرَمتَ ناراً في الفُؤادِ سَعيرُها",27,"ر",3,0],["لَقَد هَتَفَت في جُنحِ لَيلٍ حَمامَةٌ","عَلى فَنَنٍ وَهناً وَإِنّي لَنائِمُ",28,"م",1,1],["لَقَد هَمَّ قَيسٌ أَن يَزُجَّ بِنَفسِهِ","وَيَرمي بِها مِن ذَروَةِ الجَبَلِ الصَعبِ",29,"ب",1,1],["لَقَد هَدَّ المَمالِكَ ما تُعاني","مِنَ القَدرِ المُتاحِ وَما تَذوقُ",30,"ق",1,0],["لَقَد هَمَّ راعي السوءِ أَن يَتَحَكَّما","فَصادَفَ قَوماً غافِلينَ وَنُوَّما",31,"م",2,0],["لَقَد هاجَ رَسمُ الدارِ وَجدَكَ إِذ عَفا","وَحَسبُكَ وَجداً أَن تَرى الرَسمَ عافِيا",32,"ي",2,0],["لَقَد هَرِمت مصرٌ وَنزعَمُ أَنَّها","فَتاةٌ فَهَل أُدعى فَتىً حينَ أَهرَمُ",33,"م",1,0],["لقد هَممتُمْ بمن لا حَيَّ يَعدِلُه","إن نُوزِعَ المجدُ بين النّاسِ والشَّرفُ",34,"ف",1,0],["لَقَد هاجَ دَمعي نازِحٌ بِنٌزوحِهِ","وَنَومي إِذا ما نَوَّمَ الناسَ أَنزَحُ",35,"ح",1,0],["لَقَد هَجَمَ الزَمانُ عَلى تَميمٍ","بِأَجمَعِهِم فَمَن آلُ الهُجَيمِ",36,"م",1,1],["لَقَد هاجَ لَيلُ البين شجوي وَلا غروا","إذا هاجَ لَيلُ البين من مغرمٍ شجوا",37,"و",2,1],["لَقَد هاجَت الوَرقاء شجوي بشدوها","عَلى دوحة الليمون بين فروع",38,"ع",1,0],["لَقَد هاجَ فيَّ الشعرَ ذكرُ أحبتي","وأحسن شعر قيل ما هاجه الذكرُ",39,"ر",1,1],["لَقَد هانَت صُروفُ الدَهرِ عِندي","وَهانَت أَهلُهُ عِندي وَقَلّوا",40,"ل",3,0],["لَقَدْ هَدَّ فَقْدُكَ أهل الحِفاظِ","فصل عليك وليُّ النّعم",41,"م",1,0],["لقد هزّت الأشواقُ قلباً عهِدتُهُ","إلى غيرِ أربابِ العُلى غير شيِّق",42,"ق",1,0],["لقد هجرت أخاك الفجر وانتبهت","شمس الصباح على أنّات مهجور",43,"ر",1,0],["لقد هزلت شويهاتي فأرف","ق حسبها حلب",44,"ب",1,0],["لقد هوى في أفق هذا المكانْ","بدر العلي عريان فخر الزمانْ",45,"ن",1,1],["لَقَد هَمَّت نُفوسٌ بِالمَعالي","فَمُنذُ هَمَمتَ لَم تَترُك هُماما",46,"م",2,0],["لَقَد هاجَمتُهُ الحادِثاتُ مَغيرَةً","بِأَذلقَ حَدّاً مِن ظُباهُ وَأَقطَعِ",47,"ع",1,0],["لقد هاج لي الوجد","غزال دائم الصد",48,"د",1,1],["لقد هجرَ الحبُّ جلَّ القلوب","ولكنهُ في ضلوعي أقامْ",49,"م",1,0],["لقد هام قلبي هام واشتد شوقه","وأصبح جمرا دونه وقدة الجمر",50,"ر",1,0],["لَقَد هَجَرتْني أمُّ سَعْدٍ وحُبُّها","يَدِبُّ بأعضائي دَبِيْبَ دِماهَا",51,"ا",3,1],["لقد هاجَ لي وشكُ الوَداع صَبابةً","تُمَزّقُ عنّي الصبرَ كُلَّ مُمزَّقِ",52,"ق",1,0],["لَقَد هاجَ لي تَغريدُ كُنَّ عَشِيَّةً","لَواعِجَ شَوقٍ مِن هَوىً مُتَقادِمِ",53,"م",1,0],["لقد هاله فقد ابنه وهو ساعد","ومن معه من خيرة القوم منكب",54,"ب",1,0],["لقد هاجَ الدّمُ العربيُّ فينا","فبتُّ على عروبَتنا أخاك",55,"ك",1,0],["لقد هَرمَت وشابَت في القناني","وشبَّت حينَ لامسَتِ الكُؤوسا",56,"س",2,0],["لقد هاجَ الهوى هذا الحريرُ","أَمِن شَفَتَيكِ أم منهُ العبيرُ",57,"ر",1,1],["لقد هانَ دَمعي في ديارِ أحبّتي","وفي غيرِها قد عزَّ وهو رماء",58,"ا",2,0],["لقد هَدَمنا بأيدينا منازلَنا","فلنسمعنَّ من الغربان تنعابا",59,"ب",2,0],["لَقَدْ هَوِيتم ظُلمي فَمَوْتي","بِكُم حتْمٌ وعَيشِي مُستَحيلُ",60,"ل",1,0],["لَقَدْ هُزَّ لِلطَّعْنِ رُمْحٌ سَدِيدٌ","وَجُرِّدَ لِلضَّرْبِ نَصْلٌ طَرِيرُ",61,"ر",1,0],["لَقَد