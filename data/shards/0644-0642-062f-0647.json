{"poems":[[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[53,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[3,"إذا كانَ أمر الله أمراً يقدر","https://www.aldiwan.net/poem160.html",""],[55,"بكيت غداة بنت بدمع عين","https://www.aldiwan.net/poem26213.html","الوافر"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"سلو عن فؤادي بعدكم كيف حاله","https://www.aldiwan.net/poem36368.html","الطويل"],[77,"أبا ثابت كن في الشدائد ثابتا","https://www.aldiwan.net/poem36696.html","الطويل"],[35,"لقد هجرت سعدى وطال صدودها","https://www.aldiwan.net/poem39162.html","الطويل"],[88,"علام حرمنا منذ حين تلاقيا","https://www.aldiwan.net/poem44994.html","الطويل"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[27,"لقد هتف اليوم الحمام ليطربا","https://www.aldiwan.net/poem5659.html","الطويل"],[27,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[27,"أكلفت تصعيد الحدوج الروافع","https://www.aldiwan.net/poem5914.html","الطويل"],[23,"لقد هاج نفسك أشجانها","https://www.aldiwan.net/poem21380.html","المتقارب"],[51,"أتت من بريدينا ضرطة","https://www.aldiwan.net/poem61902.html","المتقارب"],[91,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[78,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[62,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[28,"لقد هتك العبد الطرماح ستره","https://www.aldiwan.net/poem4964.html","الطويل"],[28,"لقد هاج من عيني ماء على الهوى","https://www.aldiwan.net/poem5197.html","الطويل"],[58,"أبا طالب عصمة المستجير","https://www.aldiwan.net/poem30874.html","المتقارب"],[49,"لقد هان على الناس","https://www.aldiwan.net/poem62126.html","البسيط"],[66,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[87,"وما مصر عمر الدهر إلا غنيمة","https://www.aldiwan.net/poem8245.html","الطويل"],[69,"وآجرت مجد الدين داري فلم يزل","https://www.aldiwan.net/poem28719.html","الطويل"],[69,"إذا كان المحب قليل مال","https://www.aldiwan.net/poem28926.html","الوافر"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[33,"ألا يا حمام الأيك أجريت أدمعي","https://www.aldiwan.net/poem25729.html","الطويل"],[33,"لقد هتفت في جنح ليل حمامة","https://www.aldiwan.net/poem25827.html","الطويل"],[33,"لقد هم قيس أن يزج بنفسه","https://www.aldiwan.net/poem25990.html","الطويل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[105,"بكيت فأبكيت الطلول البواليا","https://www.aldiwan.net/poem43394.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[105,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[50,"وطال علي الليل حتى كأنه","https://www.aldiwan.net/poem63959.html","الطويل"],[46,"لقد هجم الزمان على تميم","https://www.aldiwan.net/poem23404.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85285","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85314","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85524","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[58,"أبا طالب عصمة المستجير","https://www.poetsgate.com/ViewPoem.aspx?id=22819",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[94,"خالقه","https://www.poetsgate.com/ViewPoem.aspx?id=15633",""],[125,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[136,"لقد هوى في أفق هذا المكان","https://www.aldiwan.net/poem48879.html","السريع"],[144,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[183,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[187,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[200,"إذا ما بكيت فنح يا حمام","https://www.aldiwan.net/poem45592.html","المتقارب"],[212,"تذكرت في يوم الثلاثاء أنني","https://www.aldiwan.net/poem46243.html","الطويل"],[213,"لقد هجرتني أم سعد وحبها","https://www.aldiwan.net/poem37826.html","الطويل"],[230,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[236,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[240,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[271,"دهاني يا غزالة ما دهاك","https://www.aldiwan.net/poem35233.html","الوافر"],[271,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[271,"لقد هاج الهوى هذا الحرير","https://www.aldiwan.net/poem35446.html","الوافر"],[271,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[271,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[276,"تمكن من مسامعه العذول","https://www.aldiwan.net/poem25544.html","الوافر"],[281,"ألا هكذا تستهل البدور","https://www.aldiwan.net/poem60773.html","الطويل"],[283,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[298,"أما وابتسام الروض عن شنب الزهر","https://www.aldiwan.net/poem33260.html","الطويل"],[304,"لقد هز عطف الرجا جوده","https://www.aldiwan.net/poem57690.html","المتقارب"],[304,"لقدها إذ تنثني صولة","https://www.aldiwan.net/poem57880.html","السريع"],[306,"هناء سواء كلنا في سروره","https://www.aldiwan.net/poem56541.html","الكامل"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[323,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[365,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[372,"ببعض الدمى قام بعض الفتن","https://www.aldiwan.net/poem57084.html","البسيط"],[378,"قد أومضت حكمة الإنجيل عن رسل","https://www.aldiwan.net/poem59236.html","البسيط"],[378,"سقياك سقياك ربعا ظل مبتهجا","https://www.aldiwan.net/poem66893.html","البسيط"],[381,"لقد هان عندي العدل في جانب الحب","https://www.aldiwan.net/poem49247.html","الطويل"],[406,"لقد هنت من طول المقام ومن يقم","https://www.aldiwan.net/poem49486.html","الكامل"],[430,"يا در ثغر حبيبي","https://www.aldiwan.net/poem41031.html","المجتث"],[454,"دور من القدم الغالي مجللة","https://www.aldiwan.net/poem61368.html","البسيط"],[465,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[465,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[478,"متى ينجلي بالقرب ذا الناظر القذي","https://www.aldiwan.net/poem15282.html","الطويل"],[478,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[483,"أما لغراب البين ينحل مقتضى","https://www.aldiwan.net/poem24337.html","عموديه"],[483,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[501,"أحيباب قلبي والمحبة دينها","https://www.aldiwan.net/poem37631.html","الطويل"],[501,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[507,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[552,"عجبت من الأيام كيف تروعني","https://www.aldiwan.net/poem48088.html","الطويل"],[563,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[568,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"]],"verses":[["لَقَد هاجَ هَذا الرُزءُ رَيعانَ زَفرَةٍ","تَلَقَّيتَها بِالقَولِ عَن قَلبِ موجَعِ",0,"ع",1,0],["لَقَد هَزَّ أَحشاءَ البَعيدِ مُصابُهُ","فَكَيفَ المُداني وَالقَريبُ المُصاقِبُ",1,"ب",1,0],["لَقَد هانَ عِندي الدَهرُ لَمّا عَرَفتُهُ","وَإِنّي بِما تَأتي المُلِمّاتُ أَخبَرُ",2,"ر",1,0],["لَقَد هَدَّ الهَوى بَدَني وَأَضنى","فُؤادي الهَمُّ مِن طولِ اِشتِياقي",3,"ق",2,0],["لَقَدْ هَزَّ مِنْكَ الْعَزْمُ لمَّا انْتَضَيْتَهُ","ذَوَائِبَ رَضْوَى أَوْ مَنَاكِبَ ثَهْلاَنِ",4,"ن",1,0],["لَقَدْ هَاجَنِي شَوْقٌ إِلَيْهَا مُبَرَحٌ","إِذَا شِمْتُ بَرْقَ الشَّرْقِ شَبَّ ذُبَالُهُ",5,"ل",2,0],["لقدْ هدّ أرْكانَ الوجودِ مُصابُهُ","وأنْطَقَ منهُ الشّجْوُ مَنْ كانَ صامِتا",6,"ت",2,0],["لَقَد هَجَرَت سُعدى وَطالَ صُدودُها","وَعاوَدَ عَيني دَمعُها وَسُهودُها",7,"د",3,1],["لقد هجتني يا أحمد اليومِ بالأسى","وذكَّرتني ما كَنت بالأمس ناسيا",8,"ي",2,0],["لقد هَوَّنت رُزء اليتم حتى","غفرنا للزمان بك الأثاما",9,"م",2,0],["لَقَد هَتَفَ اليَومَ الحَمامُ لِيُطرِبا","وَعَنّى طِلابُ الغانِياتِ وَشَيِّبا",10,"ب",2,1],["لَقَد هاجَ هَذا الشَوقُ عَيناً مَريضَةً","أَجالَت قَذاً ظَلَّت بِهِ العَينُ تَمرَحُ",11,"ح",1,0],["لَقَد هاجَ هاذا الشَوقُ عَيناً مَريضَةً","وَنَوحُ الحَمامِ الصادِحاتِ السَواجِعِ",12,"ع",1,0],["لَقَد هاجَ نَفسَكَ أَشجانُها","وَعاوَدَها اليَومَ أَديانُها",13,"ن",3,1],["لقد هتكتْ ما أتى دونه","بحدٍّ حديدٍ وبأْسٍ شديد",14,"د",1,0],["لَقَد هَزَأوا لَمّا تَنَبَّهَ بَعضُهُ","فَلِم ذُعِروا لَمّا تَنَبَّهَ سائِرُه",15,"ر",2,0],["لَقَد هَوى بِكُما نِجمانِ ما رَميا","إِلّا مِن العُلوِّ بِالأَلحاظِ كيوانا",16,"ن",2,0],["لقد هاجَني والصبحُ طلْقُ المباسمِ","على ملعب الأفنان ورقُ الحمائِمِ",17,"م",1,1],["لَقَد هَتَكَ العَبدُ الطِرِمّاحُ سِترَهُ","وَأَصلى بِنارٍ قَومَهُ فَتَصَلَّتِ",18,"ت",1,1],["لَقَد هاجَ مِن عَينَيَّ ماءً عَلى الهَوى","خَيالٌ أَتاني آخِرَ اللَيلِ زائِرُه",19,"ر",2,1],["لَقَد هَدَّ فَقدُكَ أَهلُ الحِفاظِ","فَصَلى عَلَيكَ وَلِيُّ النِعَم",20,"م",1,0],["لَقَد هانَ عَلى الناسِ","مَن اِحتاجَ إِلى الناسِ",21,"س",1,1],["لَقَد هَذَّبَتني يَقظَةُ الرَأيِ وَالنُهى","إِذا هَذَّبَت غَيري ضُروبُ التَجارِبِ",22,"ب",1,0],["لَقَدْ هَانَتِ الدُّنْيَا عَلَى النَّاسِ عِنْدَمَا","رَأَوْكَ بِهَا فِي مُلْكِ يُوسُفَ تَحْكُمُ",23,"م",1,0],["لقد هُنتُ حتى صرْتُ للمجدِ فاعلاً","ألا في سبيل المجدِ ما أنا فاعلُ",24,"ل",1,0],["لقدْ هانَ المقلُّ على البرايا","فلمْ يخطرْ لمخلوقٍ ببالِ",25,"ل",1,0],["لَقَد هَزَّني في رَيطَةِ الشَيبِ هَزَّةً","أَرَتني وَرائي في الشَبابِ أَمامي",26,"م",2,0],["لَقَد هِجتَ مِني عِندَ نَوحِكَ ساكِناً","وَأَضرَمتَ ناراً في الفُؤادِ سَعيرُها",27,"ر",3,0],["لَقَد هَتَفَت في جُنحِ لَيلٍ حَمامَةٌ","عَلى فَنَنٍ وَهناً وَإِنّي لَنائِمُ",28,"م",1,1],["لَقَد هَمَّ قَيسٌ أَن يَزُجَّ بِنَفسِهِ","وَيَرمي بِها مِن ذَروَةِ الجَبَلِ الصَعبِ",29,"ب",1,1],["لَقَد هَدَّ المَمالِكَ ما تُعاني","مِنَ القَدرِ المُتاحِ وَما تَذوقُ",30,"ق",1,0],["لَقَد هَمَّ راعي السوءِ أَن يَتَحَكَّما","فَصادَفَ قَوماً غافِلينَ وَنُوَّما",31,"م",2,0],["لَقَد هاجَ رَسمُ الدارِ وَجدَكَ إِذ عَفا","وَحَسبُكَ وَجداً أَن تَرى الرَسمَ عافِيا",32,"ي",2,0],["لَقَد هَرِمت مصرٌ وَنزعَمُ أَنَّها","فَتاةٌ فَهَل أُدعى فَتىً حينَ أَهرَمُ",33,"م",1,0],["لقد هَممتُمْ بمن لا حَيَّ يَعدِلُه","إن نُوزِعَ المجدُ بين النّاسِ والشَّرفُ",34,"ف",1,0],["لَقَد هاجَ دَمعي نازِحٌ بِنٌزوحِهِ","وَنَومي إِذا ما نَوَّمَ الناسَ أَنزَحُ",35,"ح",1,0],["لَقَد هَجَمَ الزَمانُ عَلى تَميمٍ","بِأَجمَعِهِم فَمَن آلُ الهُجَيمِ",36,"م",1,1],["لَقَد هاجَ لَيلُ البين شجوي وَلا غروا","إذا هاجَ لَيلُ البين من مغرمٍ شجوا",37,"و",2,1],["لَقَد هاجَت الوَرقاء شجوي بشدوها","عَلى دوحة الليمون بين فروع",38,"ع",1,0],["لَقَد هاجَ فيَّ الشعرَ ذكرُ أحبتي","وأحسن شعر قيل ما هاجه الذكرُ",39,"ر",1,1],["لَقَد هانَت صُروفُ الدَهرِ عِندي","وَهانَت أَهلُهُ عِندي وَقَلّوا",40,"ل",3,0],["لَقَدْ هَدَّ فَقْدُكَ أهل الحِفاظِ","فصل عليك وليُّ النّعم",41,"م",1,0],["لقد هزّت الأشواقُ قلباً عهِدتُهُ","إلى غيرِ أربابِ العُلى غير شيِّق",42,"ق",1,0],["لقد هجرت أخاك الفجر وانتبهت","شمس الصباح على أنّات مهجور",43,"ر",1,0],["لقد هزلت شويهاتي فأرف","ق حسبها حلب",44,"ب",1,0],["لقد هوى في أفق هذا المكانْ","بدر العلي عريان فخر الزمانْ",45,"ن",1,1],["لَقَد هَمَّت نُفوسٌ بِالمَعالي","فَمُنذُ هَمَمتَ لَم تَترُك هُماما",46,"م",2,0],["لَقَد هاجَمتُهُ الحادِثاتُ مَغيرَةً","بِأَذلقَ حَدّاً مِن ظُباهُ وَأَقطَعِ",47,"ع",1,0],["لقد هاج لي الوجد","غزال دائم الصد",48,"د",1,1],["لقد هجرَ الحبُّ جلَّ القلوب","ولكنهُ في ضلوعي أقامْ",49,"م",1,0],["لقد هام قلبي هام واشتد شوقه","وأصبح جمرا دونه وقدة الجمر",50,"ر",1,0],["لَقَد هَجَرتْني أمُّ سَعْدٍ وحُبُّها","يَدِبُّ بأعضائي دَبِيْبَ دِماهَا",51,"ا",3,1],["لقد هاجَ لي وشكُ الوَداع صَبابةً","تُمَزّقُ عنّي الصبرَ كُلَّ مُمزَّقِ",52,"ق",1,0],["لَقَد هاجَ لي تَغريدُ كُنَّ عَشِيَّةً","لَواعِجَ شَوقٍ مِن هَوىً مُتَقادِمِ",53,"م",1,0],["لقد هاله فقد ابنه وهو ساعد","ومن معه من خيرة القوم منكب",54,"ب",1,0],["لقد هاجَ الدّمُ العربيُّ فينا","فبتُّ على عروبَتنا أخاك",55,"ك",1,0],["لقد هَرمَت وشابَت في القناني","وشبَّت حينَ لامسَتِ الكُؤوسا",56,"س",2,0],["لقد هاجَ الهوى هذا الحريرُ","أَمِن شَفَتَيكِ أم منهُ العبيرُ",57,"ر",1,1],["لقد هانَ دَمعي في ديارِ أحبّتي","وفي غيرِها قد عزَّ وهو رماء",58,"ا",2,0],["لقد هَدَمنا بأيدينا منازلَنا","فلنسمعنَّ من الغربان تنعابا",59,"ب",2,0],["لَقَدْ هَوِيتم ظُلمي فَمَوْتي","بِكُم حتْمٌ وعَيشِي مُستَحيلُ",60,"ل",1,0],["لَقَدْ هُزَّ لِلطَّعْنِ رُمْحٌ سَدِيدٌ","وَجُرِّدَ لِلضَّرْبِ نَصْلٌ طَرِيرُ",61,"ر",1,0],["لَقَد هَتَفَت يُمناهُ في الدَهرِ بِالغِنى","فَما أَحَدٌ غَيري بِهِ يَشتَكي الفَقرا",62,"ر",2,0],["لَقَد هاجَ وَجدي ذكرُ آرام رامةٍ","وأورى بِقَلبي ناره لاعجُ الذِكرِ",63,"ر",1,0],["لقد هز عطف الرجا جوده","فأصبح يرتاح بعد انتحاب",64,"ب",1,1],["لقدها إذ تنثني صولةٌ","معروفةٌ ما بين عشاقها",65,"ه",2,1],["لَقد هشّ حتّى كادّ لو كان ناطقاً","تُحيّيكَ بالبُغيا جميع وكورهِ",66,"ر",2,0],["لَقد هانَ ما ألقى إذا ما تمحّصت","به تبعات تثقل الظهر في العقبى",67,"ب",2,0],["لَقَد هازَلتُها في يَومِ دَجنٍ","عَلى عُتُقٍ مِنَ الديباجِ فُرشِ",68,"ش",1,0],["لقد هَرِم الدُّنيا فلو بُدِّلَتْ لنا","بأُخرى تَجيءُ النّاسَ وهْي كَعاب",69,"ب",1,0],["لقَد هَتنَت بيضُ أخلاقِهِ","ولَم أرَ قطُّ جَهاماً هَتَن",70,"ن",1,0],["لقد هدَى مذ بدا بالشرع عاقلَه","وظل يخبط في عشواه من جُنَّا",71,"ن",2,0],["لقد هجرت ربوع الأرض راغبةً","عنها بملك نعيمٍ نوره انبلجا",72,"ج",2,0],["لَقَد هانَ عِندي العَدل في جانب الحُب","وَحالَت بِهِ حالي فَأَنكرني صَحبي",73,"ب",2,1],["لقد هُنْتُ من طُولِ المقامِ ومَنْ يُقِمْ","طويلاً يهُنْ مِنَ بَعدِ ما كانَ مُكرَما",74,"م",2,1],["لقد هتكت اللالي","كن بالعقيق رحيما",75,"م",2,0],["لقد هجدرت نيويورك لأعبدها","فكيف أحذرها في فرط غيماني",76,"ن",2,0],["لقد هزني ذكر العذيب وحاجرٍ","كصرف الحميا عطف شنوان هائم",77,"م",1,0],["لقد هجعتْ ليلَ السليم ونبّهت","لبانات طيفٍ جاءَ منها مسلّما",78,"م",2,0],["لقد هزأتْ مِن أهل ذا الفن جملةً","بلابسِ شُربُوشِ ولابسِ مِشْوَذِ",79,"ذ",1,0],["لقد همَّ فيها المزنُ أن يُمْسِكَ الحيا","وعارضَهُ دمعي بها فتحدَّرا",80,"ر",2,0],["لقد هموا بالدهر من حيث غلبت","فواعله فاستل ما في الجوانح",81,"ح",1,0],["لقد هامت فتاة الحي لما","رأت منه الجمال من الجمال",82,"ل",1,0],["لقد هزَّ جلجال الغيوب بعزمه","فلا عجبٌ عن هزَّ في حبه القلبا",83,"ب",2,0],["لقد هجَرَ المَضاجِعِ حزبُ طَهَ","فلم يعبأْ بواعِثَةِ السُّهادِ",84,"د",1,0],["لقَد هَصَرَت كَفُّ المَنُونِ إِلى البِلى","قَضيبَ شَبابٍ كانَ مِن أنضَرِ القُضبِ",85,"ب",1,0],["لَقد هَوّنتْ صَرفُ اللّيالي بَصيرَتي","وَآنَسُ شَيءٍ بِالفؤادِ المَصائبُ",86,"ب",1,0],["لقد هانَ الغِنَى والفَقْرُ عِندي","لعلمي أنَّ كُلَّهما يزولُ",87,"ل",1,0],["لقد هتكت حُرَمُ المصطفى","وحلّ بهنّ عظيمُ البلاءِ",88,"ا",2,0]]}