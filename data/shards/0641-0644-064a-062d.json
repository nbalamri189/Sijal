m/69906","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69915","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86470","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86374","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123483","الكامل"],[4767,"معركة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=184948",""],[4929,"العراق الحر","https://www.poetsgate.com/ViewPoem.aspx?id=207477",""],[5038,"إبن الفراتين","https://www.poetsgate.com/ViewPoem.aspx?id=188955",""],[5191,"غزلٌ لا إراديّ","https://www.poetsgate.com/ViewPoem.aspx?id=212086",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5596,"لطف الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=206379",""],[5596,"اليحمدي","https://www.poetsgate.com/ViewPoem.aspx?id=206710",""],[5809,"تحذير","https://www.poetsgate.com/ViewPoem.aspx?id=205320",""],[5853,"((لمن ..أغني ؟))","https://www.poetsgate.com/ViewPoem.aspx?id=175660",""],[5906,"قصدتك يا كريم","https://www.poetsgate.com/ViewPoem.aspx?id=188230",""],[6084,"أبي حسبي أني أعيش بذلة","https://www.poetsgate.com/ViewPoem.aspx?id=170866",""],[6152,"أمي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=203525",""],[6152,"أنتِ رمضاني","https://www.poetsgate.com/ViewPoem.aspx?id=204604",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""]],"verses":[["فَلْيَحْذَرِ الْمَرْءُ دَوَامَ الأَذَى","وَأَصْلُهُ الْغَفْلَةُ عَنْ رَبِّهِ",0,"ه",1,0],["فَلْيَحْيَ فِي غِبْطَةٍ حَسِيبٌ","وَلْيسْعِدِ الأَهْلُ وَالْقَبِيلَهْ",1,"ل",2,0],["فَلْيَحْيَى ذُخْراً لِوَادِي النِّيلِ سَيِّدُهُ","وَليَبْلُغِ الشَّأْوَ مِنْ جَاهِ وَسُلْطَانِ",2,"ن",1,0],["فَلْيُحَاذِرْ شَذاتيَ الرَّجُلُ العِرْ","ريضُ أوْ لاَ فخدُّهُ والجَبُوبُ",3,"ب",1,0],["فلْيحزمِ الناظر في الأمور","فإن نجا من كبوة العَثور",4,"ر",1,0],["فليُحيِه الملك الهُمام فلم يَفُت","مَحياهُ قدرتَهُ ولا سلطانَهُ",5,"ن",2,0],["فليُحْيينَّ معالِماً مطموسةً","وَلْيُسْقِينَّ جنابَ مجدٍ أمحلا",6,"ل",2,0],["فَلْيَحْيَ في ظَفَرٍ وعاشَ له","في نَعمَةٍ أبداً مُظفَّرُه",7,"ر",2,0],["فَليَحسُنِ العُذرُ في إيرادِهُنَّ إِذا","رَأَيتَ جَريَ لِساني غَيرَ مُنطَلِقِ",8,"ق",1,0],["فَلْيَحْيَ حُرّاً مُمَتَّعاً بِجَمِي","لِ الذِّكْرِ فَالذِّكْرُ مَفْخَرٌ حَسَنُ",9,"ن",1,0],["فَليَحِدهُ عَلى قُرىً حَرَّبَتهُ","كُفرُ توتا مِنهُ وَكُفرُ تَبيلِ",10,"ل",1,0],["فليحيَ ناسٌ كرامٌ","بهم قد ازداد قدري",11,"ي",1,0],["فليحى بين النصارى","وَالمسلمين الإخاء",11,"ا",2,0],["فليحمِني الحسنُ زهرَ جنَّتهِ","وليقصني العمرُ عنه حرمانا",12,"ن",2,0],["فَلْيَحْيَا مَكْسِيمُوس بَطْرِيقُ الهُدَى","تَاجاً لِهَامَةِ شَعْبِهِ الْمُخْتَارِ",13,"ر",1,0],["فَلَيُحْدِثّنَّ النَّاسُ مَا هُوَ فَوْقَهُ","عِظَماً وَإتْقَاناً وَمَا هُوَ أَغْرَبُ",14,"ب",1,0],["فَلْيَحْيَا عَبَّاسُ العُلَى وَشَقِيقُهُ","وَلْتحْيَا مِصْرُ وَقوْمُهَا الأَخْيارُ",15,"ر",1,0],["فَليُحَيِّ اللَهُ أَرضاً حَوَتهُ","بِالحَيا وَليَحبُها بِالحَبِيِّ",16,"ي",1,0],["فليحمني الحسن زهر جنّته","وليقضي العمر عنه حرمانا",17,"ن",2,0],["فليحذر الكتابُ ما قد غاله","وأخصُّ بينهم الفقيه أبا الحسن",18,"ن",1,0],["فَليَحذَروا مَلِكاً تَخَلَّت عَنوَةً","لِسُطاهُ عَن أَجَماتِها الآسادُ",19,"د",1,0],["فَليَحقِنِ المُستَعصِمونَ بِمَنبِجٍ","باقي دَمٍ مُتَعَرِّضٍ لِمُروقِهِ",20,"ق",2,0],["فليحمد الله الجميع فإِنه","أرضاك بالملك الذي أرضانا",21,"ن",2,0],["فليحمد الله عبدالله أن له","من ربه خيرة في كل ما فعلا",22,"ل",2,0],["فليحذرن المعادي منه طارقه","فالسيل بالليل لا ينجو مفاجيه",23,"ي",2,0],["فليحمد الله امرؤ أوصله","الى لقاء الجزري عمره",24,"ر",2,0],["فليحمدوا زمناً طوا","ه تداخل المتواسطين",25,"ن",1,0],["فلي حرمة الإسلام والشيب والذي","أدين به من سنّة لم تحرّف",26,"ف",1,0],["فَليَحمَدَنَّ اللَهَ ما أَمسَيتَ مِن","أَعضاءِ دَولَتِهِ وَمِن خُلَصائِهِ",27,"ا",3,0],["فَلي حَقٌّ أَمُتُّ بِهِ إِلَيهِ","وَأَعلَمُ أَنَّهُ وافي الذِمامِ",28,"م",1,0],["فليحرقوا كل النخيل بساحنا","سنطلّ من فوق النخيل نخيلا",29,"ل",2,0],["فلي حجّةٌ تبدي محجّةُ فضله","لجاحده في وجهه ظلمةَ البهت",30,"ت",1,0],["فليَحيَ في ضفَّةٍ خضراءَ مُزهِرةٍ","وفي خمائلِ وادٍ طابَ مَرتَعه",31,"ع",2,0],["فليحمد الأقوام حالا نالهم","فيه اكتساب أو فمولانا شديد",32,"د",1,0],["فليحذر الشخص من التبرم","وكثرة الشكوى لدى التألم",33,"م",1,0],["فليحتسب أهل القري","ض لما أتاهم من مصاب",34,"ب",1,0],["فليَحْذَر الصَّمصام من لحظاته","والصَعدة السمراء من أملوده",35,"د",2,0],["فليحنّيَ الحساد بالعيب ما شاؤوا","ولا عاش حاسد لم يخنّي",36,"ن",2,0],["فليحذر الأحرارُ وليتكاتفوا","فالعدلُ غيرَ الظلم رغمَ خضابه",37,"ب",2,0],["فليحمدنّي في كلّ قافيةٍ","تزيدُ حسنا في دُرّها الثُّقَبُ",38,"ب",1,0],["فليحمدنَّك من عينتَ بأمرهِ","وأقلُّ حالةِ منعمٍ أن يحمدا",39,"د",2,0],["فليحمد الأمراء سيرتك التي","أحمدت فيها طاعة الأمراء",40,"ا",2,0],["فليحي ما حييت مدائح مجده","وليبق مابقي الزمان معمرا",41,"ر",2,0],["فليَحىَ مولانا المَليكُ لِشَعبِهِ","وليَسقُطَن وليَهبِطن هِتليرُ",42,"ر",1,0],["فليحي دور العدل فينا آخذاً","شرف الرقي بسيرة الدستور",43,"ر",1,0],["فليحي شبلك يا مولاي في نعم","ما طير يمن على أفنانه خطبا",44,"ب",2,0],["فليحىَ سلطاننا المحبوب فهو لنا","حياة كل رجاً بل مصدر النعم",45,"م",1,0],["فليَحيَ سيّدنا المقدامُ في رغدٍ","لولاه ما كان أمرُ الأمّة اِنتَظما",46,"م",2,0],["فَليحيَ قوم طريق العلم قد سلَكوا","وفي الثقافة والتهذيب قد رَغِبوا",47,"ب",3,0],["فليحيَ عصرُ النور مشرقةً","بينَ الورى أيّامه الزهرُ",48,"ر",1,0],["فَليحيَ سيّدنا الهما","م بحقّ سادات البقيعِ",49,"ع",1,0],["فَلَيَحسُوَن صَديقُهُ وعَدُؤُهُ","مِن بَعدِ ذاكَ الشُّهدَ سُمّا ناقِعا",50,"ع",2,0],["فَليَحذَرِ المَرءُ المُخالِفُ أَمرَهُ","مِن فِتنَةٍ أَو مِن عَذابٍ يؤلِمُ",51,"م",1,0],["فليحسنن من نظام الملك موقعها","فغنها عصرةٌ من أعظم العصر",52,"ر",1,0],["فليحذرِ النارَ التي","تُسقِط هذا الشَّررا",53,"ر",2,0],["فلْيُحسِّنْ خُبزَهُ بي","ما له والله مِثْلِي",54,"ي",1,0],["فليحدثوا في كل فجٍّ ضجة","إن لم تصبك يد ويسطُ لسان",55,"ن",1,0],["فلي حرمة الجار جار الكرام","وما انا في الود رث الحبال",56,"ل",1,0],["فليحارب من يشأ أقرانَهُ","ولْيَدعْ حرب السَّلاطين القِمَمْ",57,"م",1,0],["فلْيَحْمَدُوا أَزْهَرَ في دَهْرِهِ","أَيامُ شهرِ الصَّومِ أَعيادُ",58,"د",1,0],["فليحيَ وفدٌ كان فيه","العزمُ والإخلاصُ وَفْدا",59,"د",2,0],["فليحي جرال البطل",