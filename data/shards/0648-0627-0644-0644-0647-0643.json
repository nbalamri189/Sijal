{"poems":[[449,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28014","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109442","الدوبيت"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97885","المتدارك"],[4829,"الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=34267",""],[4978,"الفقيرة زينب","https://www.poetsgate.com/ViewPoem.aspx?id=189776",""],[5150,"حوران .. الثورة ..!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202805",""],[5401,"تويتر والفيس بوك","https://www.poetsgate.com/ViewPoem.aspx?id=142371",""],[5848,"الخامس الأول","https://www.poetsgate.com/ViewPoem.aspx?id=48824",""],[5848,"لا صار خلك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=53365",""],[5956,"وصلتْ إليّ رسالةٌ من درِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193810",""],[6106,"ما بين الهجرة والهجمة على سيد الخلق صلى الله عليه","https://www.poetsgate.com/ViewPoem.aspx?id=6303",""]],"verses":[["واللّه كفيل في الجنا","ت بعمر ثان لا ينفد",0,"د",1,0],["والله كان مع الأعلون في درج","ترقى بهم عن حضيضِ الطبع والسَّفَل",1,"ل",1,0],["واللَه كرامةً له قد أهدى","نجلاً لمظاهر العلا مولودا",2,"د",2,0],["وَاللهُ كَانَ وَليسَ شَيءٌ غَيرُهُ","سُبحَانَهُ جَلَّ العَظِيمُ الشَّانِ",3,"ن",1,0],["وَالله كَانَ وَلَيسَ شَيءٌ غَيرُهُ","وَبَرَى البرِية وَهيَ ذُو حَدثَانِ",3,"ن",1,0],["واللَه كفيلٌ بك ما لم","ترج المخلوقَ وتستجدِ",4,"د",1,0],["والله كن القلب عقب المغترب","كوز(ن)مجخّا من عذابه بالصدن",5,"ن",1,0],["والله كرّمها بالفكر نيّرِهِ","من يُعطه بحبال الحق يتّصِلِ",6,"ل",1,0],["واللهُ كرَّمها وكرّمَ أهلها","بعقيدةٍ في وحدةِ الأديانِ",7,"ن",1,0],["والله كأن الوقت عصر امرؤ القيس","فيه انمحت كل القيم والفواصل",8,"ل",1,0],["والله كنه وهو في حلم يتجوّل","يختار حلمه .. يصير الواقع ب عينه",9,"ن",2,0],["والله كنك على نفسي تفرّقني","لا غاب صوتك وانا اتحراه في حلّه",10,"ل",2,0],["والله كنت أرى نقوداً في المَلا","أبكي على نفسي تتوق لشطْرِ",11,"ر",1,0],["والله كاشف ما تكن صدورهم","في سقطةٍ أو ما تخط أيادي",12,"د",2,0]]}