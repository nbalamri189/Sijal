{"poems":[[95,"أهديت والمهدى ثمين","https://www.aldiwan.net/poem11276.html","مجزوء الكامل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[63,"زارني في دجا الظلام البهيم","https://www.aldiwan.net/poem51284.html","الخفيف"],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[82,"كل يوم مودع أو مودع","https://www.aldiwan.net/poem31388.html","الخفيف"],[82,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[46,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[33,"يا ثريا الفؤاد ردي السلاما","https://www.aldiwan.net/poem41340.html","الخفيف"],[33,"أصبح القلب قد صحا وأنابا","https://www.aldiwan.net/poem42637.html","الخفيف"],[76,"وصقيلة الأنوار تلوي عطفها","https://www.aldiwan.net/poem12939.html","الكامل"],[53,"أغرُّ مُخيلاتِ الأماني لَمُوعها","https://www.poetsgate.com/ViewPoem.aspx?id=29518",""],[242,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[242,"فالهاشمية بعد قرب مزارها","https://www.aldiwan.net/poem19736.html","الكامل"],[369,"ألم تر أن الدهر يكتب ما تملي","https://www.aldiwan.net/poem60792.html","الطويل"],[396,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[556,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97046","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86687","الخفيف"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67828","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108931","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108513","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119216","البسيط"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27108","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45624","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75939","الرمل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136985",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89206","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127017","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127055","الطويل"],[3622,"","https://poetry.dctabudhabi.ae/diwan/poem/204345","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91427","الوافر"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22097","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94446","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62162","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83128","الرمل"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101289","البسيط"],[4702,"صرف الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=155204",""],[4829,"التوابع والزوابع","https://www.poetsgate.com/ViewPoem.aspx?id=34253",""],[5092,"لهُ الحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=179342",""],[5105,"يا من بجودِ يديه يُضْرَبُ المثلُ","https://www.poetsgate.com/ViewPoem.aspx?id=135324",""],[5145,"رحلوا بقلبك عرّجوا أم ساروا","https://www.poetsgate.com/ViewPoem.aspx?id=108063",""],[2365,"ومطيع الفؤاد عاصى اللّسان","https://www.poetsgate.com/ViewPoem.aspx?id=200659",""],[5561,"الحوار الرابع عشر","https://www.poetsgate.com/ViewPoem.aspx?id=202115",""],[402,"أهديت والمهدي ثمين","https://www.poetsgate.com/ViewPoem.aspx?id=36419",""],[5937,"اللحن باب الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=211896",""],[5956,"أنا منتظر لُقْياهُ","https://www.poetsgate.com/ViewPoem.aspx?id=182107",""]],"verses":[["بِحَدِيثِ فِتْنَتِهِ وَإِنَّ","حَدِيثَ لُبْنَانٍ شُجُونُ",0,"ن",1,0],["بحديث حمَّادٍ ومَقْبَسِ مالكٍ","يَشْفي الأُحَاحَ من استَحَرَّ أحَاحُه",1,"ح",2,0],["بحدٍّ جرت جري الرياح فأصبحت","سطوع ضياء النيِّرين سطوعها",2,"ع",3,0],["بحديث كأنه عودة الصح","ة في الجسم بعد يأس السقيم",3,"م",1,0],["بِحَدٍّ يَراعي أَم حُسامي عَلَوتُهُ","وَبِالكُتبِ أَردَيناهُ أَم بِالكَتائِبِ",4,"ب",1,0],["بحداءٍ من واصفِ البين غادٍ","وَنَعيبٍ من حالكِ اللّون أبقَع",5,"ع",1,0],["بحديثٍ يُسْحَرُ السحر به","يَتمنَّاه مُعَاداً أن يَعود",6,"د",1,0],["بِحَديقَةِ الأَدَبِ الَّتي قَد حُصِّنَت","بِاللُبِّ إِنَّ العَقلَ أَحرَزُ مَعقِلِ",7,"ل",1,0],["بِحَديثٍ إِن أَنتِ لَم تَقبَليهِ","لَم أُنازِعكِ ما حَيِيتُ الكَلاما",8,"م",2,0],["بِحَديثٍ فيهِ مَلامٌ لِصَبٍّ","موجَعِ القَلبِ عاشِقٍ فَأَجابا",9,"ب",2,0],["بِحَديقَةٍ ظَلَّ اللِمى ظِلّاً بِها","وَتَطَلَّعَت شَنَباً بِها الأَنوارُ",10,"ر",1,0],["بحدٍّ جرتْ جريَ الرياح فأصبحت","سُطوعُ حياء النيِّرين سُطوعها",11,"ع",3,0],["بِحَدِّ سِيَادَةٍ مَعَهُ انْتِهَاءٌ","لِجُمْلَتِهَا بِِحَزْرٍ أَوْ بِعَدِّ",12,"د",1,0],["بِحَدِيثِهَا إِنَّ الْقُلُوبَ تَلَذُّهُ","فَكََأَنَّهَا شَرِبَتْ بِهِ أَمْوَاهَا",13,"ا",3,0],["بحَدْباءَ إن نَوّخْتُ خرَّتْ لدى الفتى","صَريعاً وإن ثَوّرْتُ قامتْ على رِجْل",14,"ل",1,0],["بحدي طاهر طهر فؤادي","من الأرجاس من شك وريب",15,"ب",1,0],["بِحِدِّ عَزمكَ وهو الصَّارِمُ الخَذِمُ","وأصبحوا في نعيمٍ ما له خَطرُ",16,"ر",1,0],["بِحَدَائِقِ الحَدَقِ الَّتِي لاقَيْنَنِي","بأَحَدَّ من سيفي ومن نُشَّابِي",17,"ب",2,0],["بحديثٍ يستعجل الراح بالرا","ح ويحتث أنجماً سيَّاره",18,"ر",2,0],["بحديثٍ أو قصةٍ لم تلقَّن","دون نُبل الحياةِ للأدهارِ",19,"ر",1,0],["بحدٍّ كَحدّ السّيفِ غَير مثلّمٍ","وَعودٍ كَعودِ الرّمح غير مُوَصّمِ",20,"م",1,0],["بحديثٍ وفي عناق وضم","وارتشافٍ والفوز بالتقبيل",21,"ل",1,0],["بِحَديث معنعن عن ثِقات","نَقلوا عَن أَبيه ثُمَ عن الجَدّ",22,"د",1,0],["بِحَدِّ الْمَوَاضِي وَالرِّمَاحِ الرَّوَاكِزِ","أَمُوتُ عَلى حُبِّ النَّبيِّ وَأُقْبَرُ",23,"ر",1,0],["بحديقة ضلت عيون رقيبها","عنها وكان دليلنا الشيطان",24,"ن",1,0],["بحديقةٍ غناء ماثل طلعها","طلع المقبل حين أقبل عاتبا",25,"ب",2,0],["بِحَدِّ لا غَمْرٍ ولا مُغَفّل","حُلاحِلٍ سَمَيْدَعٍ شَمَرْدل",26,"ل",1,0],["بحد سيفك سيف الدولة انحطمت","قواعد الشرك والارواح تنحطم",27,"م",1,0],["بِحَدٍّ سِنانٍ يُستَعَدُّ لِمِثلِهِ","وَرِقمِ لِسانٍ لا عَيِيٍّ وَلا هَذرِ",28,"ر",1,0],["بِحَديث يَقيم لِلأُنس شَوقاً","وَاِبتِسام يَكف لَوعَةَ صَدري",29,"ر",2,0],["بِحَديثِ المُصطَفى وَالفقهِ وَالن","نَحوِ وَالشعرِ الَّذي قَد حُبِّرا",30,"ر",2,0],["بحد العوالي والسيوف القواضب","نوال المعالي واكتساب المطالب",31,"ب",1,1],["بحديقة كقصيدة الغزل التي","قد أبدعت بتدبُّجٍ وتجنس",32,"س",1,0],["بحد يراع كالمهند غربه","يفل الظبى ضربا ويفلق مفرقا",33,"ق",2,0],["بحد شباها ميزت كل فرقة","عن الحق ضلت فهي في النار هاويه",34,"ي",2,0],["بحدك ألق أعاديك","لا بحد اليماني",35,"ن",2,0],["بحدّ رائقٍ للحسن ماء","بِهِ يَسقي رِياض الأرجوان",36,"ن",1,0],["بِحَدِّ سَيْفِكَ آياتُ العَصَا نُسِخَتْ","إِذْا تَفَرْ عَنَ يَوْمَ الرَّوْعِ كافِرُهُ",37,"ر",2,0],["بِحَدائِقٍ مَحفوفَةٍ","بِالبَيتِ مِن عِنَبٍ وَتينِ",38,"ن",1,0],["بحديقةٍ تَتلو لنور حدائقٍ","خذ من ضياءي لا تكن متسترا",39,"ر",2,0],["بحد قاسع لا تحفل بجد","أبت لك صحبة فيه الجدود",40,"د",1,0],["بِحَديثٍ كادَ أَن يَخلُقَ مِن","سِحرِهِ في كُلِّ شيء مَسمَعا",41,"ع",2,0],["بحدة السيف أفنيت الخوارج لا","بالبيض والآثم المرتاب محدود",42,"د",1,1],["بحْدود دينه قال زينه وشينه","الزين له حسنات والشين سيّه",43,"ي",2,0],["بحدي يعزفن العود وضرب الطبل والادفاف","سمعت الّي بحد اذني تهامس لي لها غمّه",44,"م",2,0],["بحداثةٍ إنّا رقصنا ها هنا","في كلِّ ساعات الدنى- بَنْدول -",45,"ل",1,0],["بحدِّ جودك في جَنْبِ اللها أبداً","يا حاتمَ الجود جُرْحٌ ليس يندمل",46,"ل",1,0],["بحديثه يستروح السّفّار","وبذكره يتبّرك السمّار",47,"ر",1,0],["بحديث اراده فكني عن","ه ولم يبد صفحة الإعلان",48,"ن",1,0],["بحديثِ عينيكَ انتشلتَ مواجعي","ومسامعي سكَرَتْ بصفنةِ شادِ",49,"د",1,0],["بحديث فتنته وإن","حديث لبنن شجون",50,"ن",1,0],["بحديقة القدرِ التقاها ، ظبيةً","فرأته لَيثاً فوق صخرةِ غابِهِ",51,"ب",2,0],["بحديثه ينمو إلهامي","‏ ‏ وبعطر شعوره أتطيّبْ",52,"ب",1,1]]}