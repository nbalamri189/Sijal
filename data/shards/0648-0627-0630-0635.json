{"poems":[[47,"محل على القاطول أخلق داثره","https://www.aldiwan.net/poem63630.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[203,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[228,"وأهوى على صدرها باكيا","https://www.aldiwan.net/poem39699.html","المتقارب"],[412,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[568,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144614","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93424","الطويل"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[307,"بذكر المصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=215238",""],[6259,"هبُوا أنّ سجني مانع لوصاله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59393&r=&rc=41",""]],"verses":[["وَإِذ صِيحَ فيهِ بِالرَحيلِ فَهُتِّكَت","عَلى عَجَلٍ أَستارُهُ وَسَتائِرُه",0,"ر",2,0],["وإذ صرَّح الناعي له بوفاته","وقد راعني من أجل ما قاله الذعر",1,"ر",1,0],["وإذ صاحَ صيحةَ الببنِ فينا","تركَ العاشقينَ طرّاً حيارى",2,"ر",2,0],["وَإِذ صَعِدَ البَدرُ خَلفَ الجِبالِ","وَذابَ عَلى الرَبوَةِ العالِيَه",3,"ي",2,0],["وَإِذ صارَ سَعد وابنه مَعِقلاً لَهُ","فَما العُذر في إِطلاقِهِ من عِقالِهِ",4,"ل",2,0],["وَإِذ صَلِيَت تَميمٌ نارَ عَمرٍو","مُضيفِ البُرجُمِيِّ إِلى تَميمِ",5,"م",1,0],["وإذ صارم الأفراح واللهو منتضى","على الهمّ في يمناي لم ينبُ حده",6,"د",2,0],["وَإِذ صارَ سَعدٌ وَاِبنه معقلاً لَهُ","فَما العُذرُ في إِطلاقِهِ عَن عقالِهِ",7,"ل",2,0],["وإذ صدفت عنه المراضع كلها","نواكص إذ شاهدن من شأنه اليتما",8,"م",2,0],["وإذْ صلّى على طه عليلٌ","يُشافى والصلاةُ له الطبابُ",9,"ب",1,0],["وإذ صار سعد وابنهُ معقلاً لهُ","فما العذر من إطلاقه من عقاله",10,"ل",2,0]]}