{"poems":[[45,"محل على القاطول أخلق داثره","https://www.aldiwan.net/poem63630.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[199,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[223,"وأهوى على صدرها باكيا","https://www.aldiwan.net/poem39699.html","المتقارب"],[406,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[563,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"]],"verses":[["وَإِذ صِيحَ فيهِ بِالرَحيلِ فَهُتِّكَت","عَلى عَجَلٍ أَستارُهُ وَسَتائِرُه",0,"ر",2,0],["وإذ صرَّح الناعي له بوفاته","وقد راعني من أجل ما قاله الذعر",1,"ر",1,0],["وإذ صاحَ صيحةَ الببنِ فينا","تركَ العاشقينَ طرّاً حيارى",2,"ر",2,0],["وَإِذ صَعِدَ البَدرُ خَلفَ الجِبالِ","وَذابَ عَلى الرَبوَةِ العالِيَه",3,"ي",2,0],["وَإِذ صارَ سَعد وابنه مَعِقلاً لَهُ","فَما العُذر في إِطلاقِهِ من عِقالِهِ",4,"ل",2,0],["وَإِذ صَلِيَت تَميمٌ نارَ عَمرٍو","مُضيفِ البُرجُمِيِّ إِلى تَميمِ",5,"م",1,0]]}