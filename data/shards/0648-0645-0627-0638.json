{"poems":[[63,"وليل طويل الباع فرقت شمله","https://www.aldiwan.net/poem45907.html","الطويل"],[86,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[35,"يقول العدا يا عز قد حال دونكم","https://www.aldiwan.net/poem39087.html","الطويل"],[35,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[35,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[51,"كبرت وفي خمس وخمسين مكبر","https://www.aldiwan.net/poem64018.html","الطويل"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[58,"وما ظبية تسبي القلوب بطرفها","https://www.aldiwan.net/poem31034.html","الطويل"],[44,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[31,"وما ظبية من ظباء الأراك","https://www.aldiwan.net/poem42611.html","المتقارب"],[102,"حسبت أن الشبابا","https://www.aldiwan.net/poem33070.html","المجتث"],[50,"وما ظفرت عيني غداة لقيتها","https://www.aldiwan.net/poem62373.html","الطويل"],[46,"إذا طلع النسران غارت ظعائن","https://www.aldiwan.net/poem22825.html","الطويل"],[46,"نسوم على وجه البسيطة مرة","https://www.aldiwan.net/poem23296.html","الطويل"],[46,"أعاذل إن ظلمتنا الملوك","https://www.aldiwan.net/poem23330.html","المتقارب"],[46,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[76,"متى أشفي غليلي","https://www.aldiwan.net/poem39009.html","الهزج"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20981","الوافر"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[28,"حرف الياء لعمري لقد نبهت يا هند ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=17969",""],[31,"وما ظبية ٌ من ظباءِ الاراكِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18792&r=&rc=55",""]],"verses":[["وَما ظَنُّهُ وَالنَّجْمُ واهٍ نِطاقُهِ","بِأَرْوَعَ مُحْيي لَيْلِهِ وَمُميتِهِ",0,"ت",2,0],["وَما ظَفِرَت مِن بَعدِ هارونَ أَرضُها","بِمِثلِكَ مَيمونَ النَقيبَةِ مُنعِما",1,"م",2,0],["وَما ظَلَمَتكِ النَفسُ يا عَزَّ في الهَوى","فَلا تَنقمي حُبّي فَما فيهِ مَنقَمُ",2,"م",1,0],["وَما ظَعَنَت طَوعاً وَلَكِن أَزالَها","زَمانٌ نَبا بِالصالِحينَ مَشومُ",3,"م",1,0],["وَما ظَنَّةٌ في جَنبِكَ اليَومَ مِنهُم","أُزَنُّ بِها إِلّا اِضطَلَعتُ اِحتِمالَها",4,"ل",3,0],["وما ظنَّ من حَسَّنَ الظن فيك","فأنت الحقيقُ به لا المُحابى",5,"ب",2,0],["وما ظلمتْك الغانياتُ بصدّها","وإن كان من أحكامها ما يُجوَّر",6,"ر",1,0],["وَما ظَلَمَ الشَوقُ الجَوانِحَ إِنَّما","غَدا ظالِماً لِلشَوقِ شَيبِيَ وَالدَهرُ",7,"ر",1,0],["وَما ظَفِرَت مِنهُم خُراسانَ بِالَّتي","أَقامَت إِلَيها بُرهَةً تَتَطَلَّعُ",8,"ع",1,0],["وَما ظَنَنتُ هَوى ظَمياءِ مَنزِلُنا","إِلى مُواتاةِ خِلٍّ لا يُواتينا",9,"ن",2,0],["وَما ظَلَمَ المُلكَ اِبنُ عاتِكَةَ الَّتي","لَها كُلُّ بَدرٍ قَد أَضارَ اللَيالِيا",10,"ي",2,0],["وَما ظَبيَةٌ تَسبي القُلوبَ بَطَرفِها","إِذا اِلتَفَتت خِلنا بِأَجفانِها سِحرا",11,"ر",2,1],["وَما ظَفِروا بِهِ حَتّى قَراهُم","قَشاعِمَ أَنسُرٍ وَضِباعَ بيدِ",12,"د",1,0],["وَما ظَبيَةٌ مِن ظِباءِ الأَرا","كِ تَقرو دِمَثَ الرُبى عاشِبا",13,"ب",2,1],["وما ظننتُ فؤادي","إلاَّ اهتدى وأنابا",14,"ب",2,0],["وَما ظَفِرَت عَيني غَداةَ لَقيتُها","بِشَيءٍ سِوى أَطرافِها وَالمَحاجِرِ",15,"ر",1,1],["وَما ظَفِرَت أَفراسُ قَومٍ يَحُثُّها","فَوارِسُها في عُنجُدٍ وَقَراسِ",16,"س",1,0],["وَما ظَعَنَت إِلّا وَلِلدَهرِ صَولَةٌ","تَبينُ عَلى أَوطانِها وَوُسومُ",17,"م",1,0],["وَما ظَفَرُ المَلِكِ في جَيشِهِ","سِوى ظَفَرٍ بِالرَدى يُقلَمُ",18,"م",1,0],["وَما ظَلَمَ العَشيرَ وَلا قِراهُ","ظَليمُ المُقفِراتِ وَلا قُراها",19,"ا",3,0],["وما ظهري لباغي الضَّي","مِ بالظّهر الذَّلولِ",20,"ل",1,0],["وما ظفروا بأثبت منك عوداً","ولا أقوى وأصلب في الحمول",21,"ل",1,0],["وما ظُلمُ أمرئٍ في الجِيدِ غُلٌّ","وفي السَّاقَينِ ذُو حَلَقٍ طَويلُ",22,"ل",1,0],["وما ظنُّ راجٍ ما لديه بكاذبٍ","ولا مخُّ راعٍ في ذَراه برير",23,"ر",1,0],["وَمَا ظَلَمَ المُلْكَ ابنُ عاتِكَةَ الّتي لهَا","كُلُّ بَدْرٍ قَدْ أضَاءَ اللّيَالِيَا",24,"ي",2,0],["وما ظبية ٌ من ظباءِ الاراكِ،","تَقْرو دِماثَ الرُّبَى عَاشِبَا",25,"ب",2,1]]}