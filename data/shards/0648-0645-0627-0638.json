{"poems":[[63,"وليل طويل الباع فرقت شمله","https://www.aldiwan.net/poem45907.html","الطويل"],[86,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[35,"يقول العدا يا عز قد حال دونكم","https://www.aldiwan.net/poem39087.html","الطويل"],[35,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[35,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[51,"كبرت وفي خمس وخمسين مكبر","https://www.aldiwan.net/poem64018.html","الطويل"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[58,"وما ظبية تسبي القلوب بطرفها","https://www.aldiwan.net/poem31034.html","الطويل"],[44,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[31,"وما ظبية من ظباء الأراك","https://www.aldiwan.net/poem42611.html","المتقارب"],[102,"حسبت أن الشبابا","https://www.aldiwan.net/poem33070.html","المجتث"],[50,"وما ظفرت عيني غداة لقيتها","https://www.aldiwan.net/poem62373.html","الطويل"],[46,"إذا طلع النسران غارت ظعائن","https://www.aldiwan.net/poem22825.html","الطويل"],[46,"نسوم على وجه البسيطة مرة","https://www.aldiwan.net/poem23296.html","الطويل"],[46,"أعاذل إن ظلمتنا الملوك","https://www.aldiwan.net/poem23330.html","المتقارب"],[46,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[76,"متى أشفي غليلي","https://www.aldiwan.net/poem39009.html","الهزج"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20981","الوافر"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[28,"حرف الياء لعمري لقد نبهت يا هند ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=17969",""],[31,"وما ظبية ٌ من ظباءِ الاراكِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18792&r=&rc=55",""],[135,"ألا من لهم آخر الليل منصب","https://www.aldiwan.net/poem20990.html","الطويل"],[136,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[144,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[200,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[271,"إذا افتر ثغر الخود أو طرفها رنا","https://www.aldiwan.net/poem35425.html","الطويل"],[283,"مرضت لطيف كان منه صدود","https://www.aldiwan.net/poem32807.html","الطويل"],[410,"ونافستني صروف دهري في","https://www.aldiwan.net/poem31631.html","عموديه"],[410,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[417,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[417,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[454,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[459,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[478,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[483,"أما لغراب البين ينحل مقتضى","https://www.aldiwan.net/poem24337.html","عموديه"],[516,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[516,"رجونا قطع هجرك بالوصال","https://www.aldiwan.net/poem12224.html","الوافر"],[525,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[528,"وغاظ مدحك أقواما وفي يدهم","https://www.aldiwan.net/poem45976.html","البسيط"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"إذا لم تكوني دار فضل ونفحة","https://www.aldiwan.net/poem47762.html","الطويل"],[554,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[554,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[559,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[568,"تعز أبا بكر المرتجى","https://www.aldiwan.net/poem69616.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَما ظَنُّهُ وَالنَّجْمُ واهٍ نِطاقُهِ","بِأَرْوَعَ مُحْيي لَيْلِهِ وَمُميتِهِ",0,"ت",2,0],["وَما ظَفِرَت مِن بَعدِ هارونَ أَرضُها","بِمِثلِكَ مَيمونَ النَقيبَةِ مُنعِما",1,"م",2,0],["وَما ظَلَمَتكِ النَفسُ يا عَزَّ في الهَوى","فَلا تَنقمي حُبّي فَما فيهِ مَنقَمُ",2,"م",1,0],["وَما ظَعَنَت طَوعاً وَلَكِن أَزالَها","زَمانٌ نَبا بِالصالِحينَ مَشومُ",3,"م",1,0],["وَما ظَنَّةٌ في جَنبِكَ اليَومَ مِنهُم","أُزَنُّ بِها إِلّا اِضطَلَعتُ اِحتِمالَها",4,"ل",3,0],["وما ظنَّ من حَسَّنَ الظن فيك","فأنت الحقيقُ به لا المُحابى",5,"ب",2,0],["وما ظلمتْك الغانياتُ بصدّها","وإن كان من أحكامها ما يُجوَّر",6,"ر",1,0],["وَما ظَلَمَ الشَوقُ الجَوانِحَ إِنَّما","غَدا ظالِماً لِلشَوقِ شَيبِيَ وَالدَهرُ",7,"ر",1,0],["وَما ظَفِرَت مِنهُم خُراسانَ بِالَّتي","أَقامَت إِلَيها بُرهَةً تَتَطَلَّعُ",8,"ع",1,0],["وَما ظَنَنتُ هَوى ظَمياءِ مَنزِلُنا","إِلى مُواتاةِ خِلٍّ لا يُواتينا",9,"ن",2,0],["وَما ظَلَمَ المُلكَ اِبنُ عاتِكَةَ الَّتي","لَها كُلُّ بَدرٍ قَد أَضارَ اللَيالِيا",10,"ي",2,0],["وَما ظَبيَةٌ تَسبي القُلوبَ بَطَرفِها","إِذا اِلتَفَتت خِلنا بِأَجفانِها سِحرا",11,"ر",2,1],["وَما ظَفِروا بِهِ حَتّى قَراهُم","قَشاعِمَ أَنسُرٍ وَضِباعَ بيدِ",12,"د",1,0],["وَما ظَبيَةٌ مِن ظِباءِ الأَرا","كِ تَقرو دِمَثَ الرُبى عاشِبا",13,"ب",2,1],["وما ظننتُ فؤادي","إلاَّ اهتدى وأنابا",14,"ب",2,0],["وَما ظَفِرَت عَيني غَداةَ لَقيتُها","بِشَيءٍ سِوى أَطرافِها وَالمَحاجِرِ",15,"ر",1,1],["وَما ظَفِرَت أَفراسُ قَومٍ يَحُثُّها","فَوارِسُها في عُنجُدٍ وَقَراسِ",16,"س",1,0],["وَما ظَعَنَت إِلّا وَلِلدَهرِ صَولَةٌ","تَبينُ عَلى أَوطانِها وَوُسومُ",17,"م",1,0],["وَما ظَفَرُ المَلِكِ في جَيشِهِ","سِوى ظَفَرٍ بِالرَدى يُقلَمُ",18,"م",1,0],["وَما ظَلَمَ العَشيرَ وَلا قِراهُ","ظَليمُ المُقفِراتِ وَلا قُراها",19,"ا",3,0],["وما ظهري لباغي الضَّي","مِ بالظّهر الذَّلولِ",20,"ل",1,0],["وما ظفروا بأثبت منك عوداً","ولا أقوى وأصلب في الحمول",21,"ل",1,0],["وما ظُلمُ أمرئٍ في الجِيدِ غُلٌّ","وفي السَّاقَينِ ذُو حَلَقٍ طَويلُ",22,"ل",1,0],["وما ظنُّ راجٍ ما لديه بكاذبٍ","ولا مخُّ راعٍ في ذَراه برير",23,"ر",1,0],["وَمَا ظَلَمَ المُلْكَ ابنُ عاتِكَةَ الّتي لهَا","كُلُّ بَدْرٍ قَدْ أضَاءَ اللّيَالِيَا",24,"ي",2,0],["وما ظبية ٌ من ظباءِ الاراكِ،","تَقْرو دِماثَ الرُّبَى عَاشِبَا",25,"ب",2,1],["وَما ظُلمُ مَن يَدعو إِلى البِرِّ وَالتُقى","وَرَأب الثَأيِ في يَومِ لا حينَ مَشعَبِ",26,"ب",1,0],["وما ظفر الفتى إلاّ بسرٍ","خفيّ أو بقوة الاحتيالِ",27,"ل",1,0],["وَما ظَلَمَ الشَيبُ المُلِمُّ بِلِمَّتي","وَإِن بَزَّني حَظّي مِنَ الظَلمِ وَاللَمى",28,"م",2,0],["وما ظماءي وفي جنبيَّ نهرٌ","تدفقَ بينَ قلبي والحجابِ",29,"ب",1,0],["وما ظهَرَ المعلولُ إِلا بعلِّةٍ","هما اتَّصلا فافِصلهما ثم أوصِنا",30,"ن",2,0],["وَما ظَبيَةٌ أَدماءُ تَزجي شُوَيدِناً","أَغَنَّ فَعَنهُ ما تَكادُ تَحيدُ",31,"د",1,0],["وما ظننت الذي لقيت من الد","نيا تراه عيناي في الحلم",32,"م",1,0],["وما ظننتُكَ تَنسى حقَّ معرفتِي","إنّ المعارفَ في أهلِ النُّهى ذِمَمُ",33,"م",1,0],["وما ظَفرتْ كفُّ اللَّيالي من الورى","بأرغب منِّي في نداك وأطمعا",34,"ع",2,0],["وما ظنَّت الرُّوم العراق بأنَّه","يجرُّ عليك فيك أردية الفخر",35,"ر",1,0],["وما ظمىء الجبار إلا وهده","عتي من الأحداث للعدل أظمأ",36,"ا",1,0],["وماظننتُ الطيرَ وهي بهُمٌ","على مواقيت الردى تدُلُّني",37,"ن",2,0],["وما ظَمِئتْ إلا وقلتُ مسارعاً","لعينَّيجودا بالدموعِ السواكبِ",38,"ب",1,0],["وما ظمأ الأحباب يقطعه اتصا","ل روحانيات في اقتناص مراوح",39,"ح",1,0],["وما ظفر الراجي من المجد غاية","إذا هو لم يرج الأجل المظفر",40,"ر",1,0],["وما ظل الشباب وإن تمادت","لياليه بمأمون الزوال",41,"ل",1,0],["وَما ظَفرت وَاللَّه كَفيّ بِبغية","سِوى أَن يَكُن فيها بطه توسّلي",42,"ل",2,0],["وما ظعنت على نهرٍ فأغضبهُ","لكن ذكرت عباب الزاخر الطامي",43,"م",2,0],["وَما ظَننتُ طَليقاً ما لَهُ أرَبٌ","يأتي بجُنْحِ اللّيالي رَبْعَ محبوسِ",44,"س",1,0],["وَما ظاهِري في النّاسِ إلّا كَباطني","وليلِيَ في ثوبِ التُّقى كنهارِي",45,"ر",2,0],["وَما ظَلَمَت وَلَكِنّا ظَلَمنا","فَقَد تُبنا إِلَيها مِن قَريبِ",46,"ب",1,0],["وَما ظَلَموا لَكِن نُفوسُ عُداتِهِم","وَأَموالُهُم في الناسِ مِنهُم تَظَلَّمُ",47,"م",1,0],["وما ظاهر إلا الوجود بكلهم","مقام يسمى قاب قوسين أو أدنى",48,"ن",2,0],["وَمَا ظَلَمَ المَوْتُ فِي حُكْمِهِ","لَعَمْرَكَ حَيَّاً وَلاَ غَالَطَهْ",49,"ط",2,0],["وما ظننت أنه سيجعله","فذاك ظن منك قد لا يفعله",50,"ه",1,0],["وما ظنه الجهال إن اعتماده","على السيف فيما يزعمون لمقصد",51,"د",1,0]]}