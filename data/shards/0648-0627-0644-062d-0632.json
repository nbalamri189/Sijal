الزيفِ والعدم","https://www.poetsgate.com/ViewPoem.aspx?id=140754",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[5457,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=213117",""],[5463,"ألف ونّه وسط قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=25292",""],[5525,"بالي","https://www.poetsgate.com/ViewPoem.aspx?id=843",""],[5533,"يا وَيْحَ نَفْسِي","https://www.poetsgate.com/ViewPoem.aspx?id=176700",""],[5660,"مَن لَم يُعَزِّز عِشقَهُنَّ ذَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23711",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5736,"مقايضة","https://www.poetsgate.com/ViewPoem.aspx?id=214923",""],[5781,"أُمُّ الشَّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=198835",""],[5833,"حميا الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=197004",""],[5848,"عشق ونعاس ومصايب","https://www.poetsgate.com/ViewPoem.aspx?id=53452",""],[5848,"كثري منها","https://www.poetsgate.com/ViewPoem.aspx?id=53165",""],[5897,"على بركات الله","https://www.poetsgate.com/ViewPoem.aspx?id=177077",""],[5943,"بشذا الورودِ ندى تفوحْ","https://www.poetsgate.com/ViewPoem.aspx?id=60770",""],[6019,"ذبولٌ يطوقُ زهرةَ عُمرك","https://www.poetsgate.com/ViewPoem.aspx?id=175268",""],[6167,"أغنية الأحزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85547&r=&rc=30",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""]],"verses":[["والحزمُ في نَقْمي ولكنني","أُوثرُ إحساني على حزمي",0,"م",2,0],["وَالحَزمُ يَذهَبُ غَيرَ مُلتاثٍ إِلى","تَصويبِهِ في الرَأيِ أَو تَصعيدِهِ",1,"د",2,0],["وَالحُزنُ لا يَبقى وَلا السُرورُ","فَالآنَ حينَ اِستَأمَنَ الغَيورُ",2,"ر",1,0],["والحزقة القدمى وأنَّ عشيرتي","زرعوا الحروث وأنَّنا لا نزرعُ",3,"ع",1,0],["والحُزنُ في النّفْسِ نبعٌ لا يمرُّ بهِ","صادٍ منَ النفسِ إلا عادَ رَيّانا",4,"ن",2,0],["وَالحُزن باقٍ عَلى ما كُنت أَعهدهُ","وَإِن تَكرر عيد بُعدَهُ عيدُ",5,"د",1,0],["وَالحُزنُ يَتبَعُ حُبَّ مَن فارَقَتَ لا","أَيامَ مَفقودٍ يعدُّ كرورها",6,"ر",3,0],["وَالحَزمُ عاقدُها وَالفَوزُ عاضِدُها","وَالسَعدُ راصِدُها وَالفَتحُ راعيها",7,"ي",3,0],["وَالْحُزْنُ أَسْمَعُ مِنْ سِمْعٍ وَأَفْتَكُ مِنْ","عَمْرٍو وَأَحْرَدُ مِنْ ذِمْرٍ بِهِ دَعَكُ",8,"ك",1,0],["والحزم صيرني إليك وإنه","يدنى القريب إلى البعيد النائي",9,"ا",2,0],["والحزنُ والهمُّ أذبلاها","وكم أرَتها النّوى سُرورا",10,"ر",2,0],["وَالحُزنُ قَد عَمَّ جَميعَ المَلا","فَلا تَرى غَيرَ بَكي حَزينِ",11,"ن",1,0],["والحزن يا اقدار منتشر","والبشر يا اقدار منتحر",12,"ر",1,0],["والحزن أبرح أن تشقق حلة","ويخد خد بالأكف شموع",13,"ع",1,0],["والحزن ما رسم الكآبة هكذا","عين مسهدة وقلب مغرم",14,"م",1,0],["والحزنُ بالصبر الجميل مقامُه","أسمى من الحزن الذي يتجهَّمُ",15,"م",1,0],["والحزم أن تجزع من حيث تسر","وآخر الصفو وإن لذ الكدر",16,"ر",1,0],["والحزم قبل العزم فاحزم واعزم","وإذا استبان لك الصواب فصمم",17,"م",1,0],["والحزم كالسيف في جمع العداة ردى","والعزم كالسيف في التقريق للقمم",18,"م",1,0],["والحزن والخوف في الدنيا وشهوتها","غباوة شره إصرار من فسدا",19,"د",2,0],["والُحزنُ يُنشِئُهُ الحبيبُ كما نَشا","فإذا بَلِي كبَلآئهِ لم يَعْتَدِ",20,"د",1,0],["والحزن يقتلُ كلَّ من","لا يقتلُ الأَحزانَ صَبْرَا",21,"ر",2,0],["والحزن أصلى صدرنا وضلوعنا","وأضل عقلا كل ملء الرأس",22,"س",1,0],["وَالحَزم مَعْهُ ربا في مَهده وَعَلى","دِيوانه علَمُ الإِقبال مَعقود",23,"د",1,0],["والحزن آلفه حفظاً لعهدهما","مع اعتقادي بأن لا ينفع الحون",24,"ن",1,0],["وَالحَزم وَالتَدبيرُ روح العَزم","لا خَيرَ في عَزمِ بِغَيرِ حَزم",25,"م",1,0],["والحزن مردٍ في هواه مرددٌ","والخد من مطر الدموع مرذذ",26,"ذ",1,0],["وَالحُزنُ ضَيفٌ ثَقيلٌ إِن عِشتَ بِهِ","وَإِن تَبَسَّمتَ حلاً هَبَّ وَاِنتَقَلا",27,"ل",2,0],["والحزم تقوى اللّه فاتقه","ترشد وليس لفاجر حزمُ",28,"م",1,0],["وَالحَزم كُل الحَزم في المُطاوَلَة","وَالصَّبر لا في سُرعة المُزاوَلَة",29,"ه",1,0],["والحز بالقطف وبالقصر عرف","والحك بالجزء وبالقطف ألف",30,"ف",1,0],["والحزم عند الأمن والطعانِ","والملك والنائل والحفانِ",31,"ن",1,0],["والحَزْنُ إلا يكنْ والأمرُ مُسْتَبِهٌ","فيه الغديرُ وفيهُ الروضةُ الأنُفُ",32,"ف",1,0],["والحزمُ تصديقُ العدوّ المدّعي","وُدّاً وإرضاءُ الصديق العائب",33,"ب",1,0],["والحزن عم بني الخوري ومن أسفوا","لظافر إذ بها داعي الردى ظفرا",34,"ر",2,0],["والحزن بلبل مصرا مع طرابلس","واظلمت ثم آصال وابكار",35,"ر",1,0],["والحزم والعزم فيها كان عزّهما","بقومنا وكذا العرفان والمدد",36,"د",1,0],["والحزم أنفع من تسربل جُنَّة","ماذية وغرار أبيض مَخْذَم",37,"م",1,0],["والحزم سيفٌ عند قبضته","وقرارهُ البتّارُ لم يغبِ",38,"ب",1,0],["والحَزْمُ أضن تختار فيما دونه ال","مران وخز أَسِنّة المُرّان",39,"ن",1,0],["والحزن مثل السرور ان عظما","تلاقيا بي في اللا نهايات",40,"ت",1,0],["والحزنُ والبكاءُ خيرُ آية","تُشعِرُ بالحبّ وبالولاية",41,"ه",1,1],["والحزنُ في فؤادي","كالسيفِ مُنتَضى",42,"ض",2,0],["والحزن عمَّ بكل مجدٍ يا له","من حزن مرؤسٍ لفقد رئيس",43,"س",1,0],["والحزم والعزم في الاقوام من خُلقى","كما الفصاحةُ في الاقوالِ من كَلِمَي",44,"م",2,0],["والحزن ساور كل أهل عقيدة","مذ ساءت الأحوال والأوضاع",45,"ع",1,0],["والحَزمُ في الأحكام حُكمٌ فيصَلٌ","تشقى بهِ ناسٌ وناسٌ تَسعَدُ",46,"د",1,0],["وَالحَزم أَقبل خاشِعاً","عَما مَضى يُبدي الأَسَف",47,"ف",1,0],["والحزم أن تحذر ما تتقي","وقلَّما يغنيك فيه الحذر",48,"ر",1,0],["والحزم لو شكروا النعماء وادخروا","للحرب خيلاً وفرسانا وأبطالا",49,"ل",2,0],["والحزم للحرّ الكريم مقلّدٌ","عطل امرؤ يتقلّد الآمالا",50,"ل",2,0],["والحزم حيزوم الأبى فخذ به","لا ترع شاءك في المكان المذئب",51,"ب",1,0],["وَالحزمُ أن يَسِيرَ مَن لَم يَعلَم","مَع رُفتَةٍ مَأمُونَةٍ لِيَسلَم",52,"م",1,0],["وَالحَزمُ في كُلِّ الأُمورِ مُقارَن","لِلفَوزُ في نَيلِ المَرامِ الأَبعَد",53,"د",1,0],["والحزنُ يَفتِكُ في النفو","سِ بِفَتْكهِ ذاك الذريعِ",54,"ع",1,0],["والحزن يعقبه السرور وبينما ال","إعساء إذ يلقى الفتى الأيسارا",55,"ر",2,0],["والحزم كل الحزم بين ذوي النهى","بمحلها لن توضع الأشياء",56,"ا",2,0],["والحزن بات أرَختُ لهج مشارقٍ","وزهَت بنعمة ربها دار النعيم",57,"م",1,0],["والحزن مهما مزقت أسيافه","أحشاءنا كمداً فليس 