s://www.poetsgate.com/ViewPoem.aspx?id=183899",""],[6050,"الغَسَق","https://www.poetsgate.com/ViewPoem.aspx?id=115431",""],[6068,"كتبت على أوراقها -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175936",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""]],"verses":[["كفَروا باللّهِ فأرْهَقَهُم","وملَكْتَ فزادَهُمُ رَهَقا",0,"ق",2,0],["كُفِرَتْ صَنائِعُهُ فيمّمَ دارَها","مُسْتَظْهِراً منْها بعِزِّ جِوارِ",1,"ر",1,0],["كفر الذي أوليته من نعمة","لا تأنْسُ النَّعماء بالكفّارِ",2,"ر",1,0],["كفر الذي أوليته من نعمة","واللهُ قد حتم العذابَ لمن كفرْ",3,"ر",1,0],["كفروا بأنعمها وهم أبناؤها","فلذاك باؤا بالفضيحة في الدنى",4,"ن",2,0],["كَفَرتُم بِالقُرانِ وَقَد أُتيتُم","بِتَصديقِ الَّذي قالَ النَذيرُ",5,"ر",1,0],["كَفَرْخ قطاةِ الدَّوّ بانَ جَنَاحُهَا","فباتَ إلى حِصْنٍ بِغَيْرِ جَنَاحِ",6,"ح",1,0],["كَفَروا بِنِعمَتِهِ الَّتي أَسداهُمُ","وَرَمَوهُ بِالإِلحادِ وَالكُفرانِ",7,"ن",1,0],["كَفَريدٍ وَأَينَ ثاني فَريدٍ","أَيُّ ثانٍ لِواحِدِ الآحادِ",8,"د",1,0],["كَفَرخٍ رَمى الرامي أَباهُ فَغالَهُ","فَقامَت إِلَيهِ أُمُّهُ فَرَماها",9,"ا",3,0],["كَفَرتُ مَكارِمَكَ الباهِرا","تِ إِن كانَ ذَلِكَ مِنّي اِختِيارا",10,"ر",2,0],["كَفِرِندي فِرِندُ سَيفي الجُرازِ","لَذَّةُ العَينِ عُدَّةٌ لِلبَرازِ",11,"ز",1,1],["كَفَرْنَ بذلك الصَّنمِ المُفَدَّى","وكُنَّ له سُجوداً أو رُكوعا",12,"ع",2,0],["كَفْرتُ ولم أشكُرْ نصيحةَ فارسٍ","وكم من نصيحٍ مِثله حُرِمَ الشُّكرا",13,"ر",2,1],["كَفَرضِ الصَلاةِ فَروضُ الصِلاتِ","وَمَطلُ العِداتِ كَحَربِ العُداةِ",14,"ا",2,1],["كَفَروا فَأَمَّنتَ الرُؤوسَ لِأَنَّها","خَرَّت لِسَيفِكَ رُكَّعاً وَسُجودا",15,"د",2,0],["كفراشةٍ حامت علَي","كِ وأيّ قلبٍ لَم يحم",16,"م",1,0],["كفرتُ بالعلم صِفْرَ القلب تحمله","للبيع في السوق أشباه البراذين",17,"ن",1,0],["كُفرٌ على كُفرٍ رمُوا بركامه","والكفرُ أقبحُ ما يُرى مركوما",18,"م",2,0],["كَفَرتُم يَدي فيكُم فَحُلَّ عِقالُها","إِلى غَيرِكُم لَمّا يُشَدُّ لَها رَبطُ",19,"ط",1,0],["كَفَّرتُمُ كَريماً","حَنَّ لَكُم وَدَرّا",20,"ر",2,0],["كفَرَتْ عَلَى عِلمٍ بهم علماؤُهم","جَرِبَ الصَّحِيحُ وَلَمْ يَصِحَّ الأجربُ",21,"ب",1,0],["كَفَرتُ بِاللَهِ وَآياتِهِ","إِن أَنا لَم أَهجُرهُ فَليُبصِرِ",22,"ر",1,0],["كفرت ثورتك الكبرى به","وهو المحسنُ يجزى بالكنود",23,"د",1,0],["كفَراشةِ العَذْبِ النَّمِيرِ بَدَتْ لهمْ","والحِجْرُ دونَ غِمَارِهِ وتَبُوك",24,"ك",1,0],["كَفَرَاشِ الرَّيَاضِ إِذْ يَتَبَارَى","مَرَحاً مَا لَهُ مِنِ اسْتِقْرَارِ",25,"ر",1,0],["كَفَرتُ بِدينِ الحُبِّ لَولا مُهَفهَفٍ","قَضَت لِدَمي أَلحاظُ عَينَيهِ بِالسَفكِ",26,"ك",1,0],["كَفَرتُ بِدينِ اللَهِ وَالكُفرُ واجِبٌ","عَلَيَّ وَعِندَ المُسلِمينَ قَبيحُ",27,"ح",1,1],["كفرت بالرّوح بعد الرّيب آونة","وكان زلفى إلى نجواه كفراني",28,"ن",2,0],["كفرت بالحسب السّامي إلى مضر","استغفر المجد إنكارا وكفرانا",29,"ن",2,0],["كفرت للخلق القبيح انعما","عليك مد ظلها المطنب",30,"ب",1,0],["كفرت بكل عاطفة","لها بمبادئي نسبة",31,"ب",2,0],["كفروا لما كثروا وزَكَت","أموالُهُم ونما العدَدُ",32,"د",1,0],["كفردوسٍ حوى ثمراً شهياً","لذاك دعوتها باسم الجنانِ",33,"ن",1,0],["كَفَرتَ يَداً مِن مُنعِمٍ لَو شَكَرتَها","جَزاكَ بِها الرَحمنُ ذو الفَضلِ وَالمَنِّ",34,"ن",1,0],["كفرك الإِحسان يمنع فضلنا","ولا شكرك النعماء في جودنا شرطا",35,"ط",2,0],["كفرت بروحي يوم همت بحسنكم","فحسنكم اللماح حسن مزوّق",36,"ق",1,0],["كفرتُ بهذا الخلق كفراً مؤبّداً","وهل أبصرَ الإيمان أجمل من كفري",37,"ر",2,0],["كفروا بِربّ محمدٍ","بَغْياً فما حَفِظوا نبِيَّه",38,"ي",2,0],["كَفَرَت به الأصحابُ إذ","أوراقُه بالشعر رَسلُه",39,"ل",2,0],["كفرتُ وقد رأيتُ البطلَ شرعاً","وما للحقِّ في الدنيا بزوغ",40,"غ",1,0],["كفرق وجمع والحضور وغيبة","وصحو ومحو وانفصال ووصلة",41,"ه",1,0],["كفراغٍ في تخومِ الأرضِ مخنوقُ السَّنا","يصمتُ الإحساسُ فيه وتموتُ الأزمنَةْ",42,"ن",2,0],["كفرت بها رباه فامنن فربّما","بكيت أسى يوماً وأفنانيَ الوجد",43,"د",1,0],["كفروا بالجمال والحبّ والحقّ","وجنّوا بالشرّ والأطماع",44,"ع",1,0],["كفروا بالحياة إذ آمن الموتى","وعاشوا كالسائم الأرضي",45,"ي",1,0],["كُفْراً بكافورٍ وقُبْحاً بعدَه","لابنِ الحسينِ الفردِ في إحسانِه",46,"ن",2,0],["كفرت صحابتي وخفرت سلمي","فنحرَك والسنانَ وأنت قرني",47,"ن",2,0],["كفِّر وكن مستثنيا إلا إذا","أقسمتَ أنك لا ترى إنسانا",48,"ن",2,0],["كفرتْ وجوهُهُم البدورَ وآمنتْ","لأكفِّهم أيدي السحابِ فكَفَّرتْ",49,"ت",1,0],["كَفَرتُ بِالكافورِ مِن ثَغرِهِ","وَلا عَبَدتُ المِسكَ مِن شَعرِهِ",50,"ر",2,1],["كَفَرت الذِي أَسدَوا إِلَيك وَسَدَّدُوا","مِنَ الحُسنِ وَالنُعمَى فَخَدُّك ضارِعُ",51,"ع",1,0],["كَفَرت الَّذي أَسدَوا إِلَيكَ وَوَسَّدوا","مِنَ الحُسنِ إِنعاماً وَجَنبُكَ ضارِعُ",52,"ع",1,1],["كفرْتَ في ربِّكَ الثاني وخُنتَ به","يَكفيكَ ما فيكَ من حِرمانِ نِعمتِهِ",53,"ت",2,0],["كفردوس حوى ثمراً شهياً","وأكثره يُمِرُّ على اللسانِ",54,"ن",1,0],["كفر وجهل وغدر والخيانة مع","كبر وعجب وإخلاف لما وعدا",55,"د",2,0],["كفرتموه واستبتموه","فإن أبى التوب قتلتموه",56,"ه",1,0],["كفر أبي بكر بنصبه عمر","وكفره لما أتى عن الخبر",56,"ر",1,0],["كفرهما إذ خالفا وابتدعا","من بعده خلاف ما قد صنعا",56,"ع",2,0],["كفرْتُ الهوى إِن كنتُ خنتُك ساعةً","فإِن لهَوي للعاشِقين إِلهُ",57,"ا",3,0],["كفر الشآمُ وعسقلانٌ مؤمنٌ","حاشاه وهو عرينُه أَنْ يَكْفُرا",58,"ر",2,0],["كَفر بِرَيبِ المَنايا وَأَعظا وَجَزا","رُشداً لِمَن كانَ مِن دُنيا عَلى غُرَر",59,"ر",1,0],["كَفَّرَ الدَهرُ فيهِ عَن كُلِّ ما جَرَّ","فَلَم يَتَّجِه عَلَيهِ مَلامِ",60,"م",1,0],["كَفرا عند شتمٍ آل رسولِ الل","ه نسلَ المهذَّبِ المَعصومِ",61,"م",1,0],["كف روت سيفها يوم الحروب دما","حكى تضرج خديه الذي شربا",62,"ب",2,0],["كفٌ رقى رتباً لولا السبوق لها","أبا مراد فقد فاق الورى رتبا",62,"ب",2,0],["كفرجِكَ خَفقتانَ وشيٍ بدا","بياضَ الغلالة من فرجه",63,"ج",2,0],["كَفر الزياتِ بعدَه قد مَرَّ بِه","طَبخ البرود بعدَه لا يشتَبه",64,"ه",1,0],["كفرتُ بما أراهُ فألفُ ربٍّ","وعرشٌ واحدٌ فوقَ القَمَامِ",65,"م",1,0],["كفرتُ بهذا النفاقِ الذي","يُهَادِنُ كلَّ فمٍ ناعِبِ",66,"ب",1,0],["كفرت ُبها قوَّسَت ْظفرَها","بجسمي كما قُوِّسَ المنزعُ",67,"ع",1,0],["كفر الَّذي جعل التكبر سنة","وَبأن تصغير الكبار الأوفق",68,"ق",1,0],["كَفَرَ العِذَارُ نَعِيمَ وَجْنَتِهِ لِذَا","ألْقَاهُ فِي نَارِ الجَحِيمِ مُخَلَّداَ",69,"د",2,0],["كفرت بسالف الأيام ، لولا","دم الشهداء يعبق بالنضوح",70,"ح",1,0],["كَفَرتُ بِوَحيِكُم وَجَعَلتُ نَذراً","عَلىّ قِتَالَكُم حَتّى المُمَاتِ",71,"ت",1,0],["كفرض ربع المال في الزكاة","والماء لا سواه في الصلاة",72,"ه",1,0],["كفروا بما أوليتهم","من فيض أنعمك السجام",73,"م",1,0],["كُفرهم بِرَبهم وَفسقهم","وَقَتلهم أَنفسهم وَحمقهم",74,"م",1,0],["كفروا به أو ينظروه جهرة","فنهاهم فعتوا عتواً خوفه",75,"ف",2,0],["كَفَرت نِعمَة بَنو الجَحافِ","وَتَوَلَّت مَنيعَةَ الأَعطافِ",76,"ف",1,0],["كفَر الضبابُ بشمسه فَدَجا","رهوا وضلَّ السائقُ الحذِر",77,"ر",1,0],["كفريدة بيضاء حان ضياعها","من بعد ما ملأت يد الغواص",78,"ص",1,0],["كَفَرُوا فما الإِنسانُ إلا هيكلٌ","جَسدٌ سيُصبحُ طعمَةَ الدِّيدانِ",79,"ن",1,0],["كفروا بمن خلقَ الوجودَ وأَشرَكوا","بالواحدِ المتكبرِ الدِّيانِ",79,"ن",1,0],["كَفَرَوا وَلَو شَكَروا لَدَامَت فِيهِمُ","لَكِنَّهُم ما مُتِّعُوا بِدَوامِ",80,"م",1,0],["كَفَرنا أَيادي الدَهر مِنهُ فَهَذِهِ","رزاياه تَتَرى حشوهن حُروب",81,"ب",1,0],["كفَرسٍ من الخُيول تُبْهجُ","لأَنَّها مُلْجَمةٌ وتُسْرَجُ",82,"ج",1,0],["كَفَرَ النصارى بعد ما","عَقَدُوا به دينَ المسيح",83,"ح",1,0],["كفرت بالظلام والظلم حكما","في البرايا وبالنفاق مآلا",84,"ل",2,0],["كَفَّرتُم أصحَابَ سُنَّتِهِ وَهُم","فُسَّاقَ مِلَّتِهِ فَمَن يلحَانِي",85,"ن",2,0],["كُفرَانَ هَذَا الإِسمُ لاَ سُبحَانَهُ","أبداً وَسُبحَانَ العَظِيمِ الشَّانِ",85,"ن",1,0],["كَفَّرتُمُ وَاللهِ مَن شَهِدَ الرَّسُو","لُ بِأنَّهُ حَقًّا علَى الإِيمَانِ",85,"ن",1,0],["كفرتم من قال ما قد قاله","في كتبه حقا بلا كتمان",85,"ن",1,0],["كَفَرَت بها ناسٌ وناس آمَنَت","تَبَّاً لقَومٍ آمنوا بمَهَالِكِ",86,"ك",1,0],["كفرا بعلمك يا ابن رُستُم كلِّه","وَبِما حَفظت سِوى الكِتاب المُنزل",87,"ل",1,1],["كفرت به الفئتان لكن ليستا","شرعا فان النصب كفر خارق",88,"ق",1,0],["كفّر ما قدّمتمُ آخرٌ","والخيرُ لن يبرحَ للشرّ صاح",89,"ح",1,0],["كفرت بها فئةٌ اذا أنصفتَها","طهَّرت من آثامها الإقليما",90,"م",2,0],["كفرتُمُ صُنْعنا المشكورَ أَنْ