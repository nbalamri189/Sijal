ps://www.poetsgate.com/ViewPoem.aspx?id=99718",""],[6102,"ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=183322",""],[6102,"فَ.......","https://www.poetsgate.com/ViewPoem.aspx?id=184545",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""],[572,"ورايتُهُ في الطّرسِ يَكْتُبُ مرَّة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9171&r=&rc=28",""]],"verses":[["فَوَدَّعَتهُ وَقالَت يا أخَا مُضَرٍ","هَذا لَعَمْري كَلامٌ يُعجِبُ العَرَبا",0,"ب",2,0],["فوَدّوا منَ البَغْضاءِ أنّ جُفونَهُمْ","عَقَدْنَ بهُدْبٍ دونَ رؤيَتها هُدْبا",1,"ب",2,0],["فوَدَّ كُلُّ بَريءٍ مُذْ عُرِفْتَ بهِ","دون البَريّةِ أنْ يَلْقاكَ مُجْتَرِما",2,"م",2,0],["فَوَدِدْتُ أنَّ شَبيبتي ودَّعْتُها","وأقامَ ذاكَ العَصْرُ لا يتَصَرَّمُ",3,"م",1,0],["فَوَدِدتُ أَنّي إِذ تَخَلَّفَ لَم أَسِر","أَولَيتَهُ إِذ سِرتُ لَم يَتَخَلَّفِ",4,"ف",1,0],["فَودِدتُ أَنَّ اللَيلَ دامَ وَأَنَّهُ","ذَهَبَ النَهارُ فَلا يَكونُ نَهارُ",5,"ر",1,0],["فَوَدِّع لَنا الطَودَ الَّذي كانَ شامِخاً","وَشَيِّع لَنا البَحرَ الَّذي كانَ مُزبِدا",6,"د",2,0],["فَوُدُّهُ فِي الْفُؤَادِ بَاقٍ","لا يَمْلِكُ الدَّهْرُ أَنْ يُزِيلَهْ",7,"ل",2,0],["فَوَدَّعنَ مُشتاقاً أَصَبنَ فُؤادَهُ","هَواهُنَّ إِن لَم يَصرِهِ اللَهُ قاتِلُه",8,"ل",2,0],["فَوَدَّعنَ أَقواعَ الشَماليلِ بَعدَما","ذَوى بَقلُها أَحرارُها وَذُكورُها",9,"ر",3,0],["فَوَدَّت نِساءُ الدارِمِيِّنَ لَو تَرى","عُتَيبَةَ أَو عايَنَّ في الخَيلِ قَعنَبا",10,"ب",2,0],["فَوَدّوا يَومَ ذَلِكَ إِذ رَأَونا","نَحُسُّ الأُسدَ لَو رَكِبوا النَعاما",11,"م",2,0],["فَوَدِّع بِالسَلامِ أَبا حُزَيزَ","وَقَلَّ وَداعُ أَربَدَ بِالسَلامِ",12,"م",1,0],["فَوَدِدتُ أَنَّكَ لَو تُخَبِّرُنا","مَن والِداكَ وَمَنصِبُ الشَعبِ",13,"ب",1,0],["فودُّنا المستقيمُ يسندُ عن","سهلٍ فلا تسنديهِ عن شعبه",14,"ب",2,0],["فَوَدِدتُ أَنّي غَرسَةٌ أَو زَهرَةٌ","وَوَدِدتُ أَنَّكِ عاصِفٌ أَو ماءُ",15,"ا",2,0],["فوددت لو ان الذين تجادلوا","جعلوا الوفاق على الصواب ختاما",16,"م",2,0],["فوداعا لك يا دنيا سنتركها","عما قليل خلفنا",17,"ن",2,0],["فَوَدّعَ قَتْلاهُمْ وَشَيّعَ فَلَّهُمْ","بضَرْبٍ حُزُونُ البَيضِ فيهِ سُهولُ",18,"ل",1,0],["فودْقُها وبَرْقُها","ماءُ حياةٍ ولَهَبْ",19,"ب",1,0],["فَوَدِدتُ أَنّي لَو بَصُرتُ عَشِيَّةً","بِالعِلجِ وَهوَ مُتَلتَلٌ عَجلانُ",20,"ن",1,0],["فوَدَّا وقد وُفِّقَا للفِراقِ","بأنَّ التَّلاقيَ يومَ الحِسابِ",21,"ب",1,0],["فَوَدَدتُ أَنّي لا أَراهُ فَإِنَّني","بَكَرَت إِلَيَّ مُغيرَةُ الأَعرابِ",22,"ب",1,0],["فَوَدَّعتُهُم عِندَ التَفَرُّقِ ضاحِكاً","إِلَيها وَلَم أَعلَم بِأَن لا تَلاقِيا",23,"ي",2,0],["فَوَدَّعتُها وَالنارُ تَقدَحُ في الحَشا","وَتَوديعُها عِندي أَمَرُّ مِنَ الصَبرِ",24,"ر",1,0],["فَودَدت لَو يَشفى الفُؤا","د مِن الأَسى المُتقادم",25,"م",1,0],["فَوَدَّعَ بَعضُنا بَعضاً","وَكُلٌّ بِالهَوى صَرَحا",26,"ح",2,0],["فَوَددتُ لَو أنَّ النُّجُوم أبَارِقٌ","والقَطرَ خَمرٌ والسَّحابَ كُرُومُ",27,"م",1,0],["فَوَدَّجَ خَصرَها فَبَدا لِسانٌ","كَأَنَّ لُعابَهُ عَلَقٌ يَسيلُ",28,"ل",1,0],["فَوَدَّ بِجَدعِ الأَنفِ لَو أَنَّ ظَهرَها","مِنَ الناسِ أَعرى مِن سَراةِ أَديمِ",29,"م",1,0],["فَوَدَّجَها مِن جانِبَيها كِلَيهُما","فَلِلَّهِ ماذا أَبرَزَ الوَدَجانِ",30,"ن",1,0],["فَوَدَّ أَبو لَيلى طُفَيلُ بنُ مالِكٍ","بِمُنعَرَجِ السُؤبانِ لَو يَتَقَصَّعُ",31,"ع",1,0],["فودَّ أنْ لو نمتَ في تربهِ","ليشفيَ النفسَ بهذا الجوارْ",32,"ر",1,0],["فَوَدَّعَتْهُ بِنَوْحٍ","مُفَتِّتِ الأَكْبَادِ",33,"د",1,0],["فوَدَدْتُ لو كُنْتُمْ بَذَلتُمْ عَهْدَكُم","لَبَقِي أَمِيرُكُمُ عَلَى مَا كَانَا",34,"ن",2,0],["فودع الباقي منها مخلصا","بالباقيات الصالحات في اللقا",35,"ا",1,0],["فوددتُ لو أنّي استقيتُ تَرفُّهاً","فيها استَقَيتُ من المجونَ تَبرُّضا",36,"ض",2,0],["فودتْ نساءُ الدارميينَ لو ترى","عُتَيْبَة َ أوْ عايَنّ في الخَيلِ قَعْنَبَا",37,"ب",2,0],["فوددت لو أني استطعت حمية","للكوخ قبل العقد سل لسانه",38,"ن",2,0],["فَوَدَّعتُها والقَلبُ يغلي صَبَابَةً","وقَامَت لِتَودِيعِى إلَى جَنبِ كَرِّهَا",39,"ر",3,0],["فَوَدَّعتُهُ توديعَ مَن ليس هَمُّهُ","إِذَا جَاءَهُ ذاك التحدثُّ وَحدَهُ",40,"د",2,0],["فَوَدَّت قُريشٌ لَو فَدَتهُ بِشَطرِها","وَقَلَّ لَعَمري لَو فَدَوهُ لَهُ الشَطرُ",41,"ر",1,0],["فَوَدِدتُ أَيّامي تَكونُ لَدَيكَ أَع","واماً وَساعاتي القَصيرَةَ أَشهُرا",42,"ر",2,0],["فود المصلى لو يسير بنفسه","ليلقاك أو يدنو إليك بعيده",43,"د",2,0],["فَوَدَّ الفَتَى حَتّى كأَنَّ فُؤَادَهُ","عَمِيدٌ بِمَطرُورٍ مَضَى غَيرَ شَاعِفِ",44,"ف",1,0],["فَوَدّعتُهُ ثُمَّ انصَرَفتُ كأنَّنى","سُدىً لم تُصِبنى لَوعَةُ الحَدَثَانِ",45,"ن",1,0],["فودعتْني وقالت وهْي باكية","إني أخاف عليك الموت إنْ تَعُد",46,"د",1,0],["فودّعته والقلب يرجو معاده","ألا إنني في اليأس أرجو وآمل",47,"ل",1,0],["فَوَدَّعتْهُا ثم انصرفتُ إلى العُلا","وعند مسيري ظَلّلَتْني القَسَاطِلُ",48,"ل",1,0],["فَوَدّعَتْ ولآلي الدّرِ تَنْشُرُهُا","كجودِ سيّدِنا السلطانِ يَرْتَدِفُ",49,"ف",1,0],["فودعته والأرحبيةُ سَيْرُها","حثيثٌ وتمضي في أزمتها تحبو",50,"ب",2,0],["فوددتُ أن تبقى أنامِلُها على","صدري كماءِ الرّقمةِ المُتبجّس",51,"س",1,0],["فوددتُ أن أمشي عليهِ إليك من","شوقي وألمس جانبَ الزرقاء",52,"ا",2,0],["فَوَدَّ لَو اسْتَعْصَى عِنَاداً عَلَى الهَوَى","بِحَيْثُ رَأَى المَنْجَى عَلَيْهِ قَدِ اسْتَعْصَى",53,"ص",2,0],["فَوَدَّعْنَّ بَلْ أَوْدَعْنَ قَلْبِي حَزازَةً","وَخَلَّفْنَ فَرْدَ الشَّوْقِ بِالْعَلَمِ الْفَرْدِ",54,"د",1,0],["فودَّعوا وانصرفوا","وَالدَمعُ منهم يذرفُ",55,"ف",1,0],["فودَّ كاشحُنا لو ناله صمَمٌ","إِذ باتَ من كثبٍ للسَمع يَستَرِقُ",56,"ق",1,0],["فوداعا على المحبة والشو","ق وداعاً ولهفةً وسلاما",57,"م",2,0],["فودَّعْتُ مَجدَك لا عَن قلىً","وفارَقْتُ فضْلَك لا عَن مَلَل",58,"ل",1,0],["فَودَّ قلبي والفلا بيننا","يُعْيِي المطايا بُعدُ أقطاري",59,"ر",2,0],["فوددت تقبيل السيوف لأنها","تنبو إذا لاقيتها بك عن هُدى",60,"د",2,0],["فَوَدِّعها وَإِن كانَت أَناةً","مُبَتَّلَةً لَها خَلقٌ أَنيَقُ",61,"ق",1,0],["فودّي لَهُمْ صافٍ وخُلْقي لهم رِضىً","وكفّي لهم بحرٌ وصدري لهم رَحْبُ",62,"ب",1,0],["فودَادِي ذلك الودُّ الذي","منه يستجدِيَ أربابُ الهوى",63,"و",2,0],["فوددت أن الليل دام وزدته","من ناظريّ ولم تكن أسحارُ",64,"ر",1,0],["فودَّعْتِ فِيهِ إِمامَ الهُدى","وَدَاعَ نوىً مَا لَهَا من لِقَاءِ",65,"ا",2,0],["فودَّ إذاً لو شُقَّ عنه إهابُهُ","وما شَقَّ بالغدرِ المصَرِّ عصاكا",66,"ك",2,0],["فَوَدَّ رِجالٌ أَنَّ أُمّي تَقَنَّعَت","بِشَيبٍ يُغَشِّي الرأسَ وَهيَ عَقيمُ",67,"م",1,0],["فوددتُ أنّي في يده صحيفةٌ","ووددتُه لا يهتَدِي لصَوابِهِ",68,"ه",1,0],["فَودَّعنا لا عَنْ مَلَالٍ وَلَا قِلىً","وقُلنا دَنَا التَّفْرِيقُ وَالشَّمْلُ جَامِعُ",69,"ع",1,0],["فودّع الشعب لمّا غابَ مُرتَحِلا","عنهُ وسارَ إلى الجنّات مُنصَرِفا",70,"ف",2,0],["فوددتُّ لَوْ أنَّ الصداقةَ لم تكنْ","ولو انَّني أحداً بها لم أخْصُصِ",71,"ص",1,0],["فوددت لو كان الفؤاد مجالَه","أو كان كحلاً للعيون قَتامه",72,"م",2,0],["فَوَدَّت نُجومُ الأُفقِ لَو أَنّها السّما","وَهَل كانَ ودُّ المُستَحيلاتِ بِالمُجدي",73,"د",2,0],["فَوددتُ الطّعنَ منهُ في الحَشا","إِذ تَثنَّى بِاِهتِزازٍ وَأَوَد",74,"د",1,0],["فَوَددت من فيكَ المُعطَّرِ نُقطَةً","في فِيَّ عِلماً أَن تَردّ حَياتي",75,"ي",1,0],["فَوددتُ تَقبيلَ السّيوفِ لِأنّها","لَمَعت كَبارِقِ ثَغرك المتَبَسِّمِ",76,"م",1,0],["فودّع سليمة إن الفؤاد","غدا عن زيارتها أخيبُ",77,"ب",1,0],["فَوَدَدْتُ لو أنّي لقِيتُكَ خَالياً","أمشي بكَفّي صَعْدَةٌ وكتيفُ",78,"ف",1,0],["فودّعتها رغما وأودعتها إلى","كريم حيفظ لم يضيع ودائعي",79,"ع",2,0],["فودادهم جبلت عليه فضرتي","وولائهم حنيت عليه أضلعي",80,"ع",2,0],["فوددت أن الليل طال وأ","ن الصبح لم يفتر مبتسماً",81,"م",2,0],["فودعتني عجلي وأدمعها","يبل أردانها تحدرها",82,"ر",3,0],["فَوَدِدتُ أَنَّ اللَّيلَ أَصبَحَ حاضِراً","عِندي وَأَنَّ الصُّبحَ كانَ ضِمارا",83,"ر",2,0],["فوداعاً يا مجلساً كنت شمساً","أتجلى فيه على الحضار",84,"ر",1,0],["فودّي على الأَيّام ما تعلمونه","وعهدي على طول المَزار وثيق",85,"ق",1,0],["فودا تراها إذا كلّت نجائِبُ من","صاحبتُه وهى بي تنصاع من عاج",86,"ج",1,0],["فوددتُ أقطع كفَّ ماشطةِ الصب","كي لا ترجِّل شعرها بمرورها",87,"ر",3,0],["فوديعةُ الرحمن بين عبادهِ","قد أودعتهُ أُميةٌ رمضاءها",88,"ا",3,0],["فوداده من حسبهم","وودادهم من حسبه",89,"ب",2,0],["فَودَّ لو أني عِقْدُه ووشاحُهُ","وإن لم يُطقْ حَمْلَ الوشاحِ ولا العِقْد",90,"د",1,0],["فوددتُ أنكِ كنتِ حيثُ تَريْنَني","صالٍ بِلَومِهِمُ غَريقاً في دمي",91,"م",2,0],["فودي ودي غير منفصم العرى","وعهدي على ما كنت تعلمه عهدي",92