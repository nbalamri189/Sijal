{"poems":[[85,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85642","الطويل"],[186,"قف بي نحي رباها أيها الحادي","https://www.aldiwan.net/poem61045.html","البسيط"],[510,"الحسد","https://www.aldiwan.net/poem61088.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122668","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127946","الوافر"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44901","الوافر"],[5986,"أقدم سيدي منك اعتذارا","https://www.poetsgate.com/ViewPoem.aspx?id=162954",""]],"verses":[["وعلك تخفق الأعلام","والسعود تجر فريحه",0,"ه",1,0],["وعلك يا لَيلى إذا مت نائياً","تجلين بعد الموت ذاكرة حبي",1,"ب",2,0],["وعلّك اليوم خلوٌ من مفاسدها","وان نكن قد خلقنا خلق أنداد",2,"د",1,0],["وعلّكَ المُمتلِيْ إنْ هُمْ به سُنِدُوا","وعلّكَ المُبْتَلىْ إنْ عادَهمْ ندَمُ",3,"م",1,0],["وعَلًَّكَ مُبدِلي بالرَّملِ رَملاً","فأصبرُ عَنه أو بالجِزعِ جِزعا",4,"ع",2,0],["وعلك ان تطل تدرى بأنى","مشوق لذلى فيك النواح",5,"ح",1,0],["وَعَلَّكَ إِن سافَرتَ فُزتَ بِماجِدٍ","نَبيلٍ مُنيلٍ مُسعِدٍ في النَوائِبِ",6,"ب",1,0],["وَعَلَّك لَم تَصُن حُبّي","بِعَونٍ مِنكَ أَو عَطفِ",7,"ف",1,0],["وعلك كان للطلاب بحراً","يفوق بمده أبداً بحارا",8,"ر",2,0]]}