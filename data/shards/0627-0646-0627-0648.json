 والورى باسم الهوى سيان","https://www.aldiwan.net/poem15971.html","الكامل"],[353,"خلياني وصبوتي وشجوني","https://www.aldiwan.net/poem39775.html","الخفيف"],[361,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[364,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[364,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[364,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[377,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[380,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[393,"أنا وجميع من فوق التراب","https://www.aldiwan.net/poem53625.html","الوافر"],[402,"أنا وحدي في المكان","https://www.aldiwan.net/poem46526.html","مجزوء الرمل"],[402,"أَنا والله مغرم","https://www.aldiwan.net/poem46703.html","مجزوء الخفيف"],[402,"أَنا والله منك في","https://www.aldiwan.net/poem46722.html","مجزوء الخفيف"],[403,"حسبك الله لم أطلت جفاكا","https://www.aldiwan.net/poem33611.html","الخفيف"],[432,"ما زال يخدع قلبه حتى هفا","https://www.aldiwan.net/poem12801.html","الكامل"],[437,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[443,"أنا وحق ولائك وعهد وفائك","https://www.aldiwan.net/poem55914.html","الرجز"],[458,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[461,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[461,"أنا والزناد ببرده وتصبري","https://www.aldiwan.net/poem16445.html","الكامل"],[464,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[479,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[479,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[500,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[500,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[500,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[500,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[500,"بين الكتائب والكثبان جلجلة","https://www.aldiwan.net/poem37780.html","البسيط"],[500,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[500,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[538,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[551,"قل لقوم لا أبالي","https://www.aldiwan.net/poem47239.html","مجزوء الرمل"],[558,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[558,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[558,"يا طلعة الشمس أو يا طلعة القمر","https://www.aldiwan.net/poem34551.html","البسيط"],[558,"يا سقى الله لذة الموت لما","https://www.aldiwan.net/poem34935.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[575,"لا تلومي العذال من أجل عذلي","https://www.aldiwan.net/poem2941.html","الخفيف"]],"verses":[["إِنَّ أَولى بِالصَبرِ إِن حُرَّجَتهُ","مَن حَشاهُ مِنها كَثيرُ القُروفِ",0,"ف",1,0],["إِن أورِدوا الماءَ لَم تَنهَل جِيادُهُمُ","حَتّى تُعَلَّ بِرَقراقِ الدَمِ السَرِبِ",1,"ب",1,0],["أنا والمَطيُّ وجِنْحُ لَيلٍ مُظْلِمٍ","ولديَّ إنْ نزَلَ الهَوانُ رَحيلُ",2,"ل",1,0],["أَنا وَعَمُّكِ مِثلُ المُهرِ يَمنَعُهُ","مِن قوتِهِ مَربِضُ المُستَأسِدِ الضاري",3,"ي",1,0],["أنا واللهِ أجعَلُ الجَفْنَ منْها","حُبُساً دائِماً لسُكْنى السهادِ",4,"د",1,0],["أَنّا وَرِثنا العِزَّ وَال","مَجدَ المُؤَثَّلَ ذا السَرارَه",5,"ر",2,0],["أَنا وَاللَهِ لا أُحابيهِ في القَو","لِ فَقَد كانَ صاحِبي لا يُحابي",6,"ب",2,0],["أَنا وَالأَيّامُ تَقذِفُ بي","بَينَ مُشتاقٍ وَمُفتَتِنِ",7,"ن",1,0],["أَنا وَاِبنُ شيثٍ في الخِيامِ زِيادَةٌ","وَاِبنُ النَفيسِ وَذا المُلقُّ الصوفي",8,"ف",2,1],["أَنا وَاِبنُ شيثٍ وَالرَشيدُ ثَلاثَةٌ","لا تُرتَجى فينا لِخَلقٍ فائِدَه",9,"د",2,1],["إِنَّا وَمَطْلَبُنَا أَقَ","لُّ الْحَقِّ لاَ نَغْلُو طِلاَبَا",10,"ب",2,0],["إِنَّا وَجَدْنَا وَقَدْ طَالَ المَطَافُ بِنَا","فِي طُولِ كَرْمَ رِجَالَ الطَّوْلِ وَالكَرَمِ",11,"م",1,1],["أَنا وَإِيّاكَ أَهلُ البَيتِ يَجمَعُنا","حَسّانُ في باذِخٍ فَخرٌ لِمَن فَخَرا",12,"ر",2,0],["إن أوردوا هِيمَ السيوف غدائراً","مصقولةٌ فلطالما حَمِدُوا الصِّدَرْ",13,"ر",1,0],["أنا والله لا أريد بأن أو","قع شراً ولو على من يعادي",14,"د",2,0],["إِنّا وَجَدنا قَنانَ اللُؤمِ إِذ نَبَتوا","أَصلاً خَبيثاً وَفَرعاً بادِيَ الأُبَنِ",15,"ن",1,0],["إِنّا وَإِن رَغَمَت أُنوفُ مُجاشِعٍ","خَيرٌ فَوارِسَ مِنهُمُ وَوُفودا",16,"د",2,0],["إِنّا وَقَينُكُمُ يُرَقِّعُ كيرَهُ","سِرنا لِنَغتَصِبَ المُلوكَ وَساروا",17,"ر",3,0],["إِنّا وَأُمُّكَ ما تُرجى ظُلامَتُنا","عِندَ الحِفاظِ وَما في عَظمِنا خَوَرُ",18,"ر",1,0],["إِنّا وَجَدنا بَني القَبحاءِ لَيسَ لَهُم","في اِبنَي نِزارٍ قَداميسٌ وَلا جولُ",19,"ل",1,0],["إِنّا وَما حَجَّ الحَجيجُ لِبَيتِهِ","رِكبانُ مَكَّةَ مَعشَرَ الأَنصارِ",20,"ر",1,0],["أنا والجارية القفحاء في","حال جوع مخرس للألسن",21,"ن",1,0],["إنَّا وإن غدرت فينا عهودكُم","من الذين همُ للعهدِ راعونا",22,"ن",2,0],["إنْ أوسْوَسْ فحقيقٌ","يُسْعَدُ القرد وأُنْحَس",23,"س",1,0],["أنا واللَّه عميدٌ","بك صبٌّ مُذْ رأيتُكْ",24,"ك",1,0],["أنا واللَّهِ يا دريرةُ أهوا","كِ وإن ذقتُ في هواك الهوانا",25,"ن",2,0],["أنا واش بسوء حالي إليكا","طال تَشنيعُها برغمي عليكا",26,"ك",2,1],["إِنّا وَهَبناكَ القُلوب وَلَم نَهَب","إِلّا الَّذي لَكَ قَبلَنا تَدبيرُهُ",27,"ر",2,0],["أَنا واحِدٌ مِنكُمُ يا نُجومُ","بِلادي مَتى تَسطَعوا أَسطُعِ",28,"ع",1,0],["إِنّا وَجَدنا العيسَ خَيراً بَقِيَّةً","مِنَ القُفعِ أَذناباً إِذا ما اِقشَعَرَّتِ",29,"ت",1,1],["أنا واللَه أصلح للمعالي","وأَمشي مشيتي وأتيهُ تيها",30,"ه",2,1],["إنا ولدنا وكنا","من قبلكم واجِدِينا",31,"ن",2,0],["أنا والله أصلح للمخازى","وأفعل فعلتي وأتيه تيها",32,"ه",2,1],["إِنَّ أَوهى الخُيوطِ فيما بَدا لي","خَيطُ عَيشٍ مُعَلَّقٌ بِالوَريدِ",33,"د",1,0],["أُناوِلُ مِن شِعرِ الخِلافَةِ رَبَّها","وَأَكسو القَوافي ما يَدومُ فَيُقشِبُ",34,"ب",1,0],["إِن أَوحَشَتكَ المَعالي","فَإِنَّها دارُ غُربَه",35,"ب",2,0],["أناولكَ الصَّهباءَ طَوراً وتارةً","تناولني والحادِثَاتُ رقودُ",36,"د",1,0],["إِن أَوقَعَ الكُتّابَ أَمرٌ مُشكِلٌ","في حَيرَةٍ رَجَعوا إِلى تَسديدِهِ",37,"د",2,0],["أَنا وَفدُ نازِلَةِ الشَآمِ لُعُظمِ ما","يَعنيهِمِ وَلِسانُ أَهلِ العَسكَرِ",38,"ر",1,0],["إِنَّ أَوهى الحِبالِ حَبلُ وِدادٍ","أَوشَكَت صَرمَةُ مَهاةُ الصَريمِ",39,"م",1,0],["إِنّا وَجَدنا كَثيراً يَقدَحونَ لَهُ","بِخَيرِ عودٍ عَتيقٍ زَندُهُ واري",40,"ي",1,0],["إِنّا وَإِيّاكَ كَالدَلوِ الَّتي وَقَعَت","عَلى يَدَي مائِحٍ بِالحَمدِ ما شَعَرا",41,"ر",2,0],["إِنّا وَأُمِّكَ ما تَظَلُّ جِيادُنا","إِلّا شَوازِبَ لاحَهُنَّ غِوارُ",42,"ر",1,0],["إِنّا وَإِن طالَ الزَمانُ بِنا","غَرَضُ الحَوادِثِ حَيثُما كُنّا",43,"ن",2,0],["أَنَ أَولى بِما بَكَيتُ عَلى نَف","سي مِنَ الباكِياتِ يَوماً عَلَيّا",44,"ي",2,0],["إِنّا وَإِن حُزتَ أَلقاباً مَكَرَّمَةً","لَسنا نُسَمّيكَ إِجلالاً وَتَكرِمَةً",45,"ه",1,0],["إِن أولِكَ المَدحَ الجَميلَ فَحَراً","وَإِن كَبا فِكرُ سِوايَ أَو حَرَن",46,"ن",1,0],["أنا وحدي في البِيدِ حيرانُ هائم","فمتى تَذكُرُ القفارَ الغمائم",47,"م",1,1],["آناؤُها وَطُلولُها وَنِجادُها","وَوِهادُها وَحَدِثُها وَقَديمُها",48,"م",3,0],["أَنا وَلهانُ في وِدادِكَ ما عِش","تُ وَنَشوانُ فيكَ غَيرُ مُفيقِ",49,"ق",1,0],["إنّا وقد جُزْنا المَدَى وتقاربتْ","آجالُنا . وأمضّنا التجريب",50,"ب",1,0],["إنّا وَفَيْنا للبلادِ فلم نَخُنْ","والدّهرُ يَظلِمُ والخُطوبُ تَخونُ",51,"ن",1,0],["إِنّا وَإِن قَدُمَ المَدى لَبَنو أَبٍ","يُغدى بنا في شَأنِهِ وَيُراحُ",52,"ح",1,0],["إنّا وراءكَ يا مُحَمَّدُ نَبتَغِي","ما اللّهُ يُعطِي المتَّقِينَ وَيَمنَحُ",53,"ح",1,0],["أَنا وَالبِساطُ وَأَنتَ أَشرَفُ مادِحٍ","وَأَجَلُّ مَمدوحٍ وَأَشرَفُ مَوقِفِ",54,"ف",1,0],["إِن أُواخَذ بِما اِجتَرَمتُ فَإِنّي","سَوفَ أَلقى مِنَ العَذابِ فَرِيّا",55,"ي",2,0],["إِن أودِعوا السِرَّ ضَيَّعوهُ وَلا","يُغضونَ طَرفاً عَنِ الجِناياتِ",56,"ت",1,0],["إنّا وَجَدْنا فَتْحَ مصرٍ آخِراً","لكَ ذِكرُهُ في سالِفِ الأزْمانِ",57,"ن",1,0],["أنّا وإيّاكُمُ فَرْعانِ من كرمٍ","قد بُوركا وزكا الأثمارُ والورَق",58,"ق",1,0],["إنَا وفي آمَالِ أنفُسِنَا","طُولٌ وفي أعمارِنَا قِصَرُ",59,"ر",1,0],["إنّا وبكراً في الوغى لبنو أبٍ","وإن اختلَفْنا حينَ تَنسِبُنا أبَا",60,"ب",2,0],["أَنا وَاللَهِ مُشتاقٌ","إِلى الحيرَةِ وَالخَمرِ",61,"ر",1,1],["أَنا وَاللَهِ أَشتَهي سِحرَ عَينَي","كِ وَأَخشى مَصارِعَ العُشّاقِ",62,"ق",1,0],["إِنّا وَإِن لَم تَكُن مِنّا مُساعَفَةٌ","بِما هَويتَ وَكُنّا عَنكَ في أَشَبِ",63,"ب",1,0],["أَنا واحد ممن تنغص عيشهم","فمضوا يجوبون البلاد وَساحوا",64,"ح",3,0],["أَنا وَالحق في العراق مضاعا","نِ وَما فيه غيرنا بمضاع",65,"ع",1,0],["أَنا والأسى وَالشعر يوم وفاته","كنا معا كَثَلاثةٍ أَحلاف",66,"ف",1,0],["أنا وحدي هيمانُ في لجك الطا","مي غريقٌ في حيرتي وارتيابي",67,"ب",2,0],["أنا والهمّ كلّما أقبل الهمّ","مشوق يلقى أخاه المشوقا",68,"ق",2,0],["أَنَا وَاللهِ مُغْرَمٌ بِهَواهُ","حَيْثُمَا دُرْتُ بَيْنَ هِنْدٍ وَسِنْدِ",69,"د",1,0],["أَنَا وَاللهِ مُنْذُ غِبْتَ عَلِيلٌ","لَيْسَ لِي غَيْرَ أَنْ أَرَاكَ دَوَاءُ",70,"ا",2,0],["أَنَا وَاحِدٌ في الجَازِعِينَ عَلَيْكُمَا","وَكَأَنَّمَا ذَاكَ البَلاءُ بَلاَئِي",71,"ا",2,0],["أنا وفد أبناء الصبابة ساجد","من ترب عذرة في أذل مكان",72,"ن",1,0],["أنا والشعرُ فداكِ","والشباب",73,"ب",1,0],["إن أوْمَأَ المُحْتَلُّ، أوْ","مَأَكلُ وَالٍ بالسجود",74,"د",1,0],["إنَّ أولى الورى بتوحيد شملٍ","أمةٌ كان دينها التوحيدا",75,"د",2,0],["أنا واللهِ كنتُ أستشعرُ","معنَى الحياةِ إذْ يَتَغَنى",76,"ن",2,0],["انا والروضُ وأشباحُكُمُ","نتناجى تحتَ نُور القمر",77,"ر",1,0],["إنا وانتُمْ – والتوجُع واحد -","لَيَزيدُنا المستعمرون تقرُّبا",78,"ب",2,0],["أنَا وَفْدُ نازِلَةِ الشّمالِ لِعِظمِ ما","يَعنِيهِمِ، وَلِسانُ أهلِ العَسكَرِ",79,"ر",1,0],["أَن أُوضح الجَبريَّةَ المُقَدَّمَه","في أَحرُفٍ قَلِيلةٍ مُنَظَّمه",80,"ه",1,0],["انا وردناه عذبا طيبا ولنا","به الكفاية ان ضن الهراميت",81,"ت",1,0],["أنا والظبية التي سلبتني","وحلا ثغرها بماء الكوثر",82,"ر",1,0],["أنا والليل في هواهم كلانا","قطع الوقت خفيةً وانسلالا",83,"ل",2,0],["أنا والعِراقُ نَكونُ بَنْدًا واحدًا","فعَلامَ تُغْلَقُ دُونِيَ الأبوابُ؟",84,"ب",1,0],["أنا (وَضَّاحُ) جِئتُ على غَرامي","وخلفي مِن ديارِ العُرْبِ شَرْقُ",85,"ق",1,0],["أنا، والقَصيدةُ، والحَبيبةُ، والقَلَمْ","وصُداعُ يومٍ بالسّياسةِ والتَّحاوُرِ والأَلَمْ",86,"م",1,1],["أَنَا والأنامُ جميعهُم يا مُنْيَتي","فالكلُّ مِنّا يقتدي بضياكِ",87,"ك",1,0],["أَنَا ولْهانُ من وِدادِ أميمٍ","طولَ دهرى نشوانُ غيرُ مُفِيقِ",88,"ق",1,0],["أنا وعيني نَطيرُ شَوقاً","نَسيرُ رَكضاً بلا انزِعاج",89,"ج",1,0],["أنا وحدي ترى أهذا مَنامٌ","آهِ لا إنَّ ما أراهُ العِيانُ",90,"ن",1,0],["أنا وصنوي والزما","نُ والمكان والولي",91,"ل",2,1],["إنّ أولادي على كثرتهم","ليس فيهم بعدُ من يكسب بارهْ",92,"ر",2,0],["إن أوجب العيدُ الجديد تهانئاً","فوجوب آياتِ التعازي أسبَق",93,"ق",1,0],["أناً واحد في نشر ما","تطوي سيادتُك الوحيده",94,"د",2,0],["أَنا واللَّه ضعيفٌ وفقير","باِحتياجٍ زائدٍ للمددِ",95,"د",1,0],["أَنا واللَّه ذليلٌ وحقير","إنّما عزّي أَتى من سيّدي",95,"ي",1,0],["أنا ولهان من لقلبي وروحي","أنا حيران يا أولي الألباب",96,"ب",1,0],["أنا واللهِ أشتهي الموتَ في الحبِّ","ليأسى عليَّ هذا البخيلُ",97,"ل",1,0],["أنا والسما خصمانِ في قمرٍ","من حينَ أخجلَ بدرها بدري",98,"ر",2,0],["أنا واللَهِ وامقٌ","رَقَّ لي كلُّ وامقِ",99,"ق",1,0],["أنا واللَهِ أرحم العُشّاقا","ويل مَن كان عاشقاً مشتاقا",100,"ق",2,1],["إِنّا وَفَينا بِالَّذي عاهَدتَنا","وَالخَيلُ تُقدَعُ بِالكُماةِ وَتُضرَسُ",101,"س",1,0],["أنا واف بما وعدت فدعني","أنثر الروح في طريقك دعني",102,"ي",1,0],["أنا والحب يغتلي في فؤادي","من عتابي عليك وخزٌ وجرحُ",103,"ح",1,0],["أنا وحدي آسرٌ ذاك القمر","والبيان العذب نارٌ وشَرر",104,"ر",1,0],["أنا واهبٌ بإرادتي","قلبي لغير معوِّضِ",105,"ض",1,0],["إِن أَومَضَ البَرقُ نَجدِيّاً بَعَثتُ لَهُ","جارٍ مِنَ الدَمعِ مِدراراً وَمِهراقا",106,"ق",2,0],["أَنا وَالأَحِبَّة مُنجِدٌ وَمُغَوّرُ","فَعَلامَ لا اَحنو وَلا أَتَذَكَّرُ",107,"ر",1,1],["إِن أَومَضوا صابوا وَإِن","أَوموا إِلى غَرَضٍ أَصابوا",108,"ب",3,0],["أَنا وَالصاحِبُ شِعراً","وَنَداً نِلنا السَماءا",109,"ا",3,0],["إِنّا وَباهِلَةَ بنَ يَعصُرَ بَينَنا","داءُ الضَرائِرِ بِغضَةٌ وَتَقافي",110,"ي",1,1],["أنا واللَه من رعاياك مازِل","تُ وأنت الأَميرُ في النوروزِ",111,"ز",1,0],["أنا والله مغرمٌ في هواهم","بتّ في حبّهم حليف الشجون",112,"ن",1,0],["أنا وحدي الشجيّ فيها بوجدي","بصري منطقي بها وسماعي",113,"ع",2,0],["أنا واعتنائي في هواك لصادق","أو كنت من يخفي عليه الكاذب",114,"ب",1,0],["أنا وردةٌ قد نوَّرت قبلَ حينها","فشَوكي لأعدائي وعطري لأحبابي",115,"ب",2,0],["إِنْ أَوْرَقَتْ بِنَدى أَكُفِّهِمُ القَنَا","فَانْظُرْ إلَى الهَامَاتِ مِنْ ثَمَرَاتِها",116,"ت",3,0],["إِنّا وَإِنْ عَظُمَ الْمُصابُ فَلا الأَسى","فِيهِ الْعَصِيُّ ولا السَّلُّوُ بِطَيِّعِ",117,"ع",1,0],["أَنا وَالنَّدى سَيْفانِ في","يَدِ ماجِدٍ نَصَرَ الْمَكارِمْ",118,"م",1,1],["أنا والحبيب ومن يلوم ثلاثةٌ","لهم بديع الحب أصبح ينتمي",119,"ي",1,1],["أنا والشَّوقُ في الغرامِ ضحايا","سرَقَ البُعدُ عُمرَنا والغياب",120,"ب",1,0],["أنا وما يظهر مجد الإله","لا شيء في الناموس إلّا هما",121,"م",2,0],["أنا وجه الوجه الجميل ومرآ","ه ومهدى ندائه الكينوني",122,"ن",2,0],["أنا وحدي أوّاه من أنا وحدي","عشتُ فهيا حتى أرتني لحدي",123,"ي",1,1],["أنا وحدي وسوف أذهب وحدي","ليس روحي لا تعرف الحزن بعدي",123,"ي",1,0],["أنا وحدي أجل فلا شيء يجدى","أنا وحدي لا أعرف الحزن وحدي",123,"ي",1,0],["أَنا وَالوَرى بِاِسمِ الهَوى سِيّانِ","لَو لَم أَفُز مِن عَينِهِ بِعَياني",124,"ي",1,1],["أَنا وَالوُرقُ في الحَدائق سيّا","ن غَراماً حَنينها وَحَنيني",125,"ن",2,0],["أَنا وَالَّذي أَولاكَ قَلبي مُغرَم","صَبّ لِقُربِك دائِما اِشتاق",126,"ق",1,0],["أنا والدِّهرُ كقِرنَيْ مَعْرَكٍ","فتبصَّرْ أيُّنا أوفَى انْتِقاما",127,"م",2,0],["أنا والرَّجاءُ وأنت والكَرَمُ","ولكَ الفَعالُ كما ليَ الكَلِمُ",128,"م",1,1],["أنا والبَدائعُ لن أَزالَ لها","أُمسي بجَفْنٍ ليس يَنطبِق",129,"ق",1,0],["أنا والنّسيمُ ومُقلتاهُ بَيْننا","في طُولِ سُقْمٍ لا يُعادُ تَآس",130,"س",1,0],["أنا وأخي لفظاً ومعنىً ونسبةً","ولكنَّه مني أرق وألطف",131,"ف",1,0],["أَنا وَالحَمام مَع الصَباح","فَرسا رِهان في النواح",132,"ح",1,1],["أَنا وَجَميعُ مَن فَوق التُرابِ","فداءُ ترابِ نَعلِ أَبي تُرابِ",133,"ب",1,1],["أنا وحدي في المكانِ","لم يكنْ لي فيه ثاني",134,"ي",1,1],["أَنا والله مغرمٌ","بكَ صَبٌّ مُعَذّبُ",135,"ب",1,1],["أَنَا واللهِ مِنكَ في","مِحَنٍ لا أطيقُها",136,"ق",3,1],["أنا واللّه لا أحول عن العه","د ولا أرتضى بِخِلٍّ سواكا",137,"ك",2,0],["أنا والمُدامُ بكفّهِ وجُونِه","ما شئتَ سمِّ من الثلاثةِ مُدنَفا",138,"ف",2,0],["أنا والعشيرة عائدون ببابكم","وعليك بعد إلهنا نتوكّل",139,"ل",1,0],["أنا وحقّ ولائك وعهد وفائك","ما خنت ذاك الودّ والغراما",140,"م",2,1],["أُناوِبُك المديح مدى حياتي","وأنشدهُ أمامك يومَ حشري",141,"ي",1,0],["أنَّ أولى التيجانِ من خِنْدفٍ","قومي إذا ما ذكرَ الفخرُ",142,"ر",1,0],["أنا والزِّنادُ ببَرْدهِ وتَصَبُّري","سِيَّانِ في الإِخْفاءِ والكِتْمانِ",143,"ن",1,1],["إن أوحشت منك الشآم فطالما","آنست يومي بؤسها ورخائها",144,"ا",3,0],["إنا وآلامنا أسباب نهضتنا","في مأمن كلما اشتدت من الفشل",145,"ل",1,0],["أنا واللّه صبها","هب بها تعذبت هب",146,"ب",1,0],["أنا ويلاه قد تحمَّل قلبي","فيك ما لا تقوى عليه القلوب",147,"ب",1,0],["أنا والنوح على دين الهوى","أبداً بالسير لا نفترق",148,"ق",1,0],["أنا والعذال أمري عجبٌ","ما رأوا جهدي إلا اختلقوا",148,"ق",3,0],["أنا وارِثُ الهادي بِسُنَّةِ هَدْيِهِ","فإذا انْتَسَبْتُ فإنَّني السُّنِّي",149,"ي",1,0],["أَنا واحِدُ الأَفرادِ فيَّاضُ العَطا","من دونِ ذَيْلي صاحِبُ الإِيوَانِ",150,"ن",1,0],["أَنا وأَنتَ لأشواقٍ وزمزَمَةٍ","على طَريقَيْنِ في الأَمرَيْنِ ننقَسِمُ",151,"م",1,0],["أَنا والحمدُ لوهَّابِ الجَميلْ","قد أَقرَّ اللهُ عيني بالشُّهودْ",152,"د",1,0],["أَنا والمسلِمونَ كلُّ سواءٌ","نعمُ الأمرُ ضمنَهُ إِعلاءُ",153,"ا",2,0],["إِنَّا وقوفٌ حولَ قَبرِكَ خُشَّعٌ","نَبكي عليكَ بِمَدمَعٍ هَتَّانِ",154,"ن",1,0],["أنَا وحدي دائمٌ وَجْ","داً بمن ليس يدومُ",155,"م",1,0],["أنا والأشواق نحتكمُ","يا هنا قلبي ويا طربي",156,"ي",1,0],["إن أومأت كانت الأكوان ظاهرة","عنها وإلا ففيها الكل أسرار",157,"ر",1,0],["أنا وأنت كلانا واحد ظهرا","على البرية في بدو وفي حضر",158,"ر",1,0],["أنا والله لست في حكم طبع","لا أرى عنه نفرة يا أديب",159,"ب",1,0],["إن أولي الأرحام من غير حرج","بعضهم أولى ببعض فخرج",160,"ج",1,0],["إِنَّ أَوْلَى أَن تَجْعَلَ الحُزْنَ عَبْداً","كُلُّ مَوْلىً غَدا له الحسنُ عبْدا",161,"د",2,0],["أَنا واللهِ أَقْتَضِي منهُمُ العَذْ","لَ لِعلْمِي بأَنَّهُ فيكَ يُغْرِي",162,"ي",1,0]]}