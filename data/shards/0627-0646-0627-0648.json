{"poems":[[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[77,"إن أكن غيركم نظرت بعيني","https://www.aldiwan.net/poem36527.html","الخفيف"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[86,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[86,"حال بين الجفن والوسن","https://www.aldiwan.net/poem68962.html","المديد"],[71,"أنا وابن شيث في الخيام زيادة","https://www.aldiwan.net/poem3899.html","الكامل"],[71,"أنا وابن شيث والرشيد ثلاثة","https://www.aldiwan.net/poem3900.html","الكامل"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"إنا وجدنا وقد طال المطاف بنا","https://www.aldiwan.net/poem11421.html","البسيط"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"ألم يكن في وسوم قد وسمت بها","https://www.aldiwan.net/poem4449.html","البسيط"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[23,"ما البكر إلا كالفصيل وقد نرى","https://www.aldiwan.net/poem21436.html","الكامل"],[72,"بأبي مائسة يثني على","https://www.aldiwan.net/poem20158.html","الرمل"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[51,"يرجف القرد بأني","https://www.aldiwan.net/poem64612.html","مجزوء الرمل"],[51,"أم حفص صلعة الشيخ","https://www.aldiwan.net/poem65802.html","مجزوء الرمل"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[51,"أنا واش بسوء حالي إليكا","https://www.aldiwan.net/poem66729.html","البسيط"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[91,"أنا من أنا يا ترى في الوجود","https://www.aldiwan.net/poem8977.html","عموديه"],[38,"إنا وجدنا العيس خيرا بقية","https://www.aldiwan.net/poem7692.html","الطويل"],[79,"أنا واللَه أصلح للمعالي","https://www.aldiwan.net/poem29566.html","الوافر"],[85,"مشيئة الله كانت","https://www.aldiwan.net/poem6834.html","المجتث"],[85,"أنا والله أصلح للمخازى","https://www.aldiwan.net/poem7555.html","الوافر"],[85,"سر أبا صالح إلى الله واترك","https://www.aldiwan.net/poem62903.html","الخفيف"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[62,"تمنى رجال ما أرادوا وإنما","https://www.aldiwan.net/poem52441.html","الطويل"],[45,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[45,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[45,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[28,"دعي الذين هم البخال وانطلقي","https://www.aldiwan.net/poem5092.html","البسيط"],[28,"ولو لقيت الذي تكنى بكنيته","https://www.aldiwan.net/poem5222.html","البسيط"],[28,"وإذا نظرت رأيت فوقك دارما","https://www.aldiwan.net/poem5253.html","الكامل"],[49,"كن عند أحسن ظن من ظنا","https://www.aldiwan.net/poem63145.html","الكامل"],[49,"أسعداني بالدمع يا عينيا","https://www.aldiwan.net/poem63201.html","البسيط"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[44,"لامته لام عشيرها وحميمها","https://www.aldiwan.net/poem30348.html","الكامل"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[90,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[105,"هتف البشير به وحان الحين","https://www.aldiwan.net/poem42044.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[81,"أهدت نجاتك عوذة المتخوف","https://www.aldiwan.net/poem61460.html","الطويل"],[21,"عند ذي العرش يعرضون عليه","https://www.aldiwan.net/poem36133.html","الخفيف"],[52,"يا دهر يا صاحب الفجيعات","https://www.aldiwan.net/poem27201.html","المنسرح"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[75,"أبلغ ربيعة عن ذي الحي من يمن","https://www.aldiwan.net/poem69056.html","البسيط"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"أنا والله مشتاق","https://www.aldiwan.net/poem63294.html","الهزج"],[50,"عبد إني إليك بالأشواق","https://www.aldiwan.net/poem62313.html","الخفيف"],[50,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85646","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85470","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42575","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42498","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141934","الرمل"],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"إلى الوفد الرياضي الإيراني","https://www.poetsgate.com/ViewPoem.aspx?id=179210",""],[45,"هَجَرَتْ وَطَيفُ خَيَالِهَا لم يَهجُرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31248",""]],"verses":[["إِنَّ أَولى بِالصَبرِ إِن حُرَّجَتهُ","مَن حَشاهُ مِنها كَثيرُ القُروفِ",0,"ف",1,0],["إِن أورِدوا الماءَ لَم تَنهَل جِيادُهُمُ","حَتّى تُعَلَّ بِرَقراقِ الدَمِ السَرِبِ",1,"ب",1,0],["أنا والمَطيُّ وجِنْحُ لَيلٍ مُظْلِمٍ","ولديَّ إنْ نزَلَ الهَوانُ رَحيلُ",2,"ل",1,0],["أَنا وَعَمُّكِ مِثلُ المُهرِ يَمنَعُهُ","مِن قوتِهِ مَربِضُ المُستَأسِدِ الضاري",3,"ي",1,0],["أنا واللهِ أجعَلُ الجَفْنَ منْها","حُبُساً دائِماً لسُكْنى السهادِ",4,"د",1,0],["أَنّا وَرِثنا العِزَّ وَال","مَجدَ المُؤَثَّلَ ذا السَرارَه",5,"ر",2,0],["أَنا وَاللَهِ لا أُحابيهِ في القَو","لِ فَقَد كانَ صاحِبي لا يُحابي",6,"ب",2,0],["أَنا وَالأَيّامُ تَقذِفُ بي","بَينَ مُشتاقٍ وَمُفتَتِنِ",7,"ن",1,0],["أَنا وَاِبنُ شيثٍ في الخِيامِ زِيادَةٌ","وَاِبنُ النَفيسِ وَذا المُلقُّ الصوفي",8,"ف",2,1],["أَنا وَاِبنُ شيثٍ وَالرَشيدُ ثَلاثَةٌ","لا تُرتَجى فينا لِخَلقٍ فائِدَه",9,"د",2,1],["إِنَّا وَمَطْلَبُنَا أَقَ","لُّ الْحَقِّ لاَ نَغْلُو طِلاَبَا",10,"ب",2,0],["إِنَّا وَجَدْنَا وَقَدْ طَالَ المَطَافُ بِنَا","فِي طُولِ كَرْمَ رِجَالَ الطَّوْلِ وَالكَرَمِ",11,"م",1,1],["أَنا وَإِيّاكَ أَهلُ البَيتِ يَجمَعُنا","حَسّانُ في باذِخٍ فَخرٌ لِمَن فَخَرا",12,"ر",2,0],["إن أوردوا هِيمَ السيوف غدائراً","مصقولةٌ فلطالما حَمِدُوا الصِّدَرْ",13,"ر",1,0],["أنا والله لا أريد بأن أو","قع شراً ولو على من يعادي",14,"د",2,0],["إِنّا وَجَدنا قَنانَ اللُؤمِ إِذ نَبَتوا","أَصلاً خَبيثاً وَفَرعاً بادِيَ الأُبَنِ",15,"ن",1,0],["إِنّا وَإِن رَغَمَت أُنوفُ مُجاشِعٍ","خَيرٌ فَوارِسَ مِنهُمُ وَوُفودا",16,"د",2,0],["إِنّا وَقَينُكُمُ يُرَقِّعُ كيرَهُ","سِرنا لِنَغتَصِبَ المُلوكَ وَساروا",17,"ر",3,0],["إِنّا وَأُمُّكَ ما تُرجى ظُلامَتُنا","عِندَ الحِفاظِ وَما في عَظمِنا خَوَرُ",18,"ر",1,0],["إِنّا وَجَدنا بَني القَبحاءِ لَيسَ لَهُم","في اِبنَي نِزارٍ قَداميسٌ وَلا جولُ",19,"ل",1,0],["إِنّا وَما حَجَّ الحَجيجُ لِبَيتِهِ","رِكبانُ مَكَّةَ مَعشَرَ الأَنصارِ",20,"ر",1,0],["أنا والجارية القفحاء في","حال جوع مخرس للألسن",21,"ن",1,0],["إنَّا وإن غدرت فينا عهودكُم","من الذين همُ للعهدِ راعونا",22,"ن",2,0],["إنْ أوسْوَسْ فحقيقٌ","يُسْعَدُ القرد وأُنْحَس",23,"س",1,0],["أنا واللَّه عميدٌ","بك صبٌّ مُذْ رأيتُكْ",24,"ك",1,0],["أنا واللَّهِ يا دريرةُ أهوا","كِ وإن ذقتُ في هواك الهوانا",25,"ن",2,0],["أنا واش بسوء حالي إليكا","طال تَشنيعُها برغمي عليكا",26,"ك",2,1],["إِنّا وَهَبناكَ القُلوب وَلَم نَهَب","إِلّا الَّذي لَكَ قَبلَنا تَدبيرُهُ",27,"ر",2,0],["أَنا واحِدٌ مِنكُمُ يا نُجومُ","بِلادي مَتى تَسطَعوا أَسطُعِ",28,"ع",1,0],["إِنّا وَجَدنا العيسَ خَيراً بَقِيَّةً","مِنَ القُفعِ أَذناباً إِذا ما اِقشَعَرَّتِ",29,"ت",1,1],["أنا واللَه أصلح للمعالي","وأَمشي مشيتي وأتيهُ تيها",30,"ه",2,1],["إنا ولدنا وكنا","من قبلكم واجِدِينا",31,"ن",2,0],["أنا والله أصلح للمخازى","وأفعل فعلتي وأتيه تيها",32,"ه",2,1],["إِنَّ أَوهى الخُيوطِ فيما بَدا لي","خَيطُ عَيشٍ مُعَلَّقٌ بِالوَريدِ",33,"د",1,0],["أُناوِلُ مِن شِعرِ الخِلافَةِ رَبَّها","وَأَكسو القَوافي ما يَدومُ فَيُقشِبُ",34,"ب",1,0],["إِن أَوحَشَتكَ المَعالي","فَإِنَّها دارُ غُربَه",35,"ب",2,0],["أناولكَ الصَّهباءَ طَوراً وتارةً","تناولني والحادِثَاتُ رقودُ",36,"د",1,0],["إِن أَوقَعَ الكُتّابَ أَمرٌ مُشكِلٌ","في حَيرَةٍ رَجَعوا إِلى تَسديدِهِ",37,"د",2,0],["أَنا وَفدُ نازِلَةِ الشَآمِ لُعُظمِ ما","يَعنيهِمِ وَلِسانُ أَهلِ العَسكَرِ",38,"ر",1,0],["إِنَّ أَوهى الحِبالِ حَبلُ وِدادٍ","أَوشَكَت صَرمَةُ مَهاةُ الصَريمِ",39,"م",1,0],["إِنّا وَجَدنا كَثيراً يَقدَحونَ لَهُ","بِخَيرِ عودٍ عَتيقٍ زَندُهُ واري",40,"ي",1,0],["إِنّا وَإِيّاكَ كَالدَلوِ الَّتي وَقَعَت","عَلى يَدَي مائِحٍ بِالحَمدِ ما شَعَرا",41,"ر",2,0],["إِنّا وَأُمِّكَ ما تَظَلُّ جِيادُنا","إِلّا شَوازِبَ لاحَهُنَّ غِوارُ",42,"ر",1,0],["إِنّا وَإِن طالَ الزَمانُ بِنا","غَرَضُ الحَوادِثِ حَيثُما كُنّا",43,"ن",2,0],["أَنَ أَولى بِما بَكَيتُ عَلى نَف","سي مِنَ الباكِياتِ يَوماً عَلَيّا",44,"ي",2,0],["إِنّا وَإِن حُزتَ أَلقاباً مَكَرَّمَةً","لَسنا نُسَمّيكَ إِجلالاً وَتَكرِمَةً",45,"ه",1,0],["إِن أولِكَ المَدحَ الجَميلَ فَحَراً","وَإِن كَبا فِكرُ سِوايَ أَو حَرَن",46,"ن",1,0],["أنا وحدي في البِيدِ حيرانُ هائم","فمتى تَذكُرُ القفارَ الغمائم",47,"م",1,1],["آناؤُها وَطُلولُها وَنِجادُها","وَوِهادُها وَحَدِثُها وَقَديمُها",48,"م",3,0],["أَنا وَلهانُ في وِدادِكَ ما عِش","تُ وَنَشوانُ فيكَ غَيرُ مُفيقِ",49,"ق",1,0],["إنّا وقد جُزْنا المَدَى وتقاربتْ","آجالُنا . وأمضّنا التجريب",50,"ب",1,0],["إنّا وَفَيْنا للبلادِ فلم نَخُنْ","والدّهرُ يَظلِمُ والخُطوبُ تَخونُ",51,"ن",1,0],["إِنّا وَإِن قَدُمَ المَدى لَبَنو أَبٍ","يُغدى بنا في شَأنِهِ وَيُراحُ",52,"ح",1,0],["إنّا وراءكَ يا مُحَمَّدُ نَبتَغِي","ما اللّهُ يُعطِي المتَّقِينَ وَيَمنَحُ",53,"ح",1,0],["أَنا وَالبِساطُ وَأَنتَ أَشرَفُ مادِحٍ","وَأَجَلُّ مَمدوحٍ وَأَشرَفُ مَوقِفِ",54,"ف",1,0],["إِن أُواخَذ بِما اِجتَرَمتُ فَإِنّي","سَوفَ أَلقى مِنَ العَذابِ فَرِيّا",55,"ي",2,0],["إِن أودِعوا السِرَّ ضَيَّعوهُ وَلا","يُغضونَ طَرفاً عَنِ الجِناياتِ",56,"ت",1,0],["إنّا وَجَدْنا فَتْحَ مصرٍ آخِراً","لكَ ذِكرُهُ في سالِفِ الأزْمانِ",57,"ن",1,0],["أنّا وإيّاكُمُ فَرْعانِ من كرمٍ","قد بُوركا وزكا الأثمارُ والورَق",58,"ق",1,0],["إنَا وفي آمَالِ أنفُسِنَا","طُولٌ وفي أعمارِنَا قِصَرُ",59,"ر",1,0],["إنّا وبكراً في الوغى لبنو أبٍ","وإن اختلَفْنا حينَ تَنسِبُنا أبَا",60,"ب",2,0],["أَنا وَاللَهِ مُشتاقٌ","إِلى الحيرَةِ وَالخَمرِ",61,"ر",1,1],["أَنا وَاللَهِ أَشتَهي سِحرَ عَينَي","كِ وَأَخشى مَصارِعَ العُشّاقِ",62,"ق",1,0],["إِنّا وَإِن لَم تَكُن مِنّا مُساعَفَةٌ","بِما هَويتَ وَكُنّا عَنكَ في أَشَبِ",63,"ب",1,0],["أَنا واحد ممن تنغص عيشهم","فمضوا يجوبون البلاد وَساحوا",64,"ح",3,0],["أَنا وَالحق في العراق مضاعا","نِ وَما فيه غيرنا بمضاع",65,"ع",1,0],["أَنا والأسى وَالشعر يوم وفاته","كنا معا كَثَلاثةٍ أَحلاف",66,"ف",1,0],["أنا وحدي هيمانُ في لجك الطا","مي غريقٌ في حيرتي وارتيابي",67,"ب",2,0],["أَنَا وَاللهِ مُغْرَمٌ بِهَواهُ","حَيْثُمَا دُرْتُ بَيْنَ هِنْدٍ وَسِنْدِ",68,"د",1,0],["أَنَا وَاللهِ مُنْذُ غِبْتَ عَلِيلٌ","لَيْسَ لِي غَيْرَ أَنْ أَرَاكَ دَوَاءُ",69,"ا",2,0],["أَنَا وَاحِدٌ في الجَازِعِينَ عَلَيْكُمَا","وَكَأَنَّمَا ذَاكَ البَلاءُ بَلاَئِي",70,"ا",2,0],["أنا وفد أبناء الصبابة ساجد","من ترب عذرة في أذل مكان",71,"ن",1,0],["أنا والشعرُ فداكِ","والشباب",72,"ب",1,0],["إن أوْمَأَ المُحْتَلُّ، أوْ","مَأَكلُ وَالٍ بالسجود",73,"د",1,0],["إنَّ أولى الورى بتوحيد شملٍ","أمةٌ كان دينها التوحيدا",74,"د",2,0],["أنا واللهِ كنتُ أستشعرُ","معنَى الحياةِ إذْ يَتَغَنى",75,"ن",2,0],["انا والروضُ وأشباحُكُمُ","نتناجى تحتَ نُور القمر",76,"ر",1,0],["إنا وانتُمْ – والتوجُع واحد -","لَيَزيدُنا المستعمرون تقرُّبا",77,"ب",2,0],["أنَا وَفْدُ نازِلَةِ الشّمالِ لِعِظمِ ما","يَعنِيهِمِ، وَلِسانُ أهلِ العَسكَرِ",78,"ر",1,0]]}