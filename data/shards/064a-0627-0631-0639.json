 درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4690,"زمانُ الوَصْل","https://www.poetsgate.com/ViewPoem.aspx?id=120304",""],[4691,"حُبّهَا شَادٍ بِقَلْبِي غَرّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=75080",""],[4929,"تطريز (ذكريات)","https://www.poetsgate.com/ViewPoem.aspx?id=202406",""],[4935,"هنئو هذا الكريم الراقيا","https://www.poetsgate.com/ViewPoem.aspx?id=129513",""],[4984,"لا تلم حظك..","https://www.poetsgate.com/ViewPoem.aspx?id=175536",""],[5186,"يا رعى الله ما رعت بكفيا","https://www.poetsgate.com/ViewPoem.aspx?id=156509",""],[5198,"البساط احمدي","https://www.poetsgate.com/ViewPoem.aspx?id=136230",""],[5351,"مكر","https://www.poetsgate.com/ViewPoem.aspx?id=202028",""],[5952,"طفل الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=202319",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6069,"صدقوا ما لأنفس العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=105693",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[5309,"يا رعاة القلب ماذا ردكم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573664",""]],"verses":[["يا رعى الله زماناً لو يدوم","كان للدهر كأيام الصبا",0,"ب",2,0],["يا رعى الله سفحَ نعمانَ سفحاً","وسقى الله عهد نعمان عهدا",1,"د",2,0],["يا رَعاهُ اللَهِ مِن عامٍ خَلا","فَلَقَد كانَ سَلاما وَأَمان",2,"ن",1,0],["يا رَعى اللَهُ نُفوسَ الشُهَداء","وَسَقى أَجداثُهُم صَوَبُ الغَمام",3,"م",1,0],["يا رعى الله قوامًا لينًا","يَنْحَنِي كالقوس خلفَ المكتب!",4,"ب",1,0],["يا رَعى اللَه عَصر يَوم الخَميس","أَضحَكَ الناس في الزَمان العَبوس",5,"س",1,1],["يا رعَى الله مسجداً قد تحلى","في بناه وللمحاسن ألبسْ",6,"س",1,1],["يا رَعَى اللهُ مُبدِعَ الحَمّامِ","فلقد فاقَ حكمةً في الأنامِ",7,"م",1,1],["يا رَعى اللَهُ طَيبَةً مِن رِياضٍ","طابَ فيها الهَوى وَطابَ الهَواءُ",8,"ا",2,0],["يا رعى الله منهم رشأ","جلّ في الحسن عن ظبا السرب",9,"ب",1,0],["يَا رَعَى اللهُ لَيْلَ وَصْلِ سَحَبْنَا","فيهِ ذَيْلَ السرورِ واللَّذَّاتِ",10,"ت",1,0],["يَا رَعَى اللهُ لَيَالٍ قدْ خَلَتْ","كَلَآلٍ فِي سُلُوكٍ مِنْ نُضَارْ",11,"ر",1,1],["يا رعى اللَه ليلةً بتُّ فيها","بين ضَمٍ إلى الصباح ولَثمِ",12,"م",1,0],["يا رعى الله ذلك العهد إذ كا","نت لياليه خير عيدٍ وزينه",13,"ن",2,0],["يا رعى الله ما مضى من ليالٍ","أطلعت لي كواكبَ الإشراق",14,"ق",1,0],["يا رعى اللَه بسفحِ المنحنى","رشأً تحميه آسادُ لؤي",15,"ي",1,0],["يا رَعى اللَه ربوعاً بالحِمى","وَسَقاها صوبَ دَمعي فالغماما",16,"م",2,0],["يا رَعى اللَه عَهدَنا بالمُصلّى","وَسَقى عصرَنا بكثبان سَلعِ",17,"ع",1,0],["يا رَعى اللَهُ بالحِمى عصرَ أنسٍ","عشتُ فيه حيناً من الدَهر رَغدا",18,"د",2,0],["يا رعي اللَه ليالي بالمعاهد","نلت فيها ما أريه وزائد",19,"د",1,0],["يا رعى اللَه زمانا","مربي في شعب عامر",20,"ر",1,0],["يا رَعى اللّه لي بأكناف نجدٍ","مَربعاً اِنجلَت به أشجاني",21,"ن",2,0],["يا رَعى اللّه ناظرَ المجدِ والفخ","رِ الّذي حاطَ حُرمتي ورعاني",21,"ن",2,0],["يا رَعاكَ اللّه مِن مشتبهٍ","لاحَ في زيّ محبٍّ ومُحَب",22,"ب",1,0],["يا رعى اللَه عَهدَ أُنسٍ دَعوناه","لِتَقاضي الهَنا فَلَبّى اِمتِثالا",23,"ل",2,0],["يا رَعى اللَه لَيلَة ما اِستَتمي","ت سَلامي حَتّى اِبتَدَأَت الشعاع",24,"ع",1,0],["يا رَعى اللَهُ مَجلسا أَنتَ فيه","بَينَ أَهلِ الكَمالِ وَالعلم فَرقَد",25,"د",1,0],["يا رَعدُ ما هَذي القَعاقِعْ","يا بَرقُ ما هَذي اللَوامِعْ",26,"ع",1,1],["يا رعى اللَه عهدَ لبنان عني","وسقاه العِهادَ عَرضاً وطولا",27,"ل",2,0],["يا رعى اللَه عهد لبنان عني","هل أراني أزور تلك الطلولا",28,"ل",2,0],["يا رعى اللَه وادياً بهواها","زاد قدساً وطاب ترباً وسفحا",29,"ح",2,0],["يا رعى الله للأحبَّة في الجَزْع","زماناً مضى وعَهداً تقضّى",30,"ض",2,1],["يا رعى الله نُزولاً بالحمى","عَثْرةَ المُغرمِ فيهم لَنْ تُقالا",31,"ل",2,0],["يا رعى عهد الهوى إنَّ الهوى","جارَ بالحكمِ عليه واعتدى",32,"د",2,0],["يا رعى الله بها لي قمراً","مُشرِقَ الطلعة لمنْ غربا",33,"ب",2,0],["يا رعى اللَه طيب عهد التداني","وزماناً صفا بانس وجودك",34,"ك",1,0],["يا رعى اللَه بيت دين التهاني","وسقاها الحياءُ طلّاً ووبلا",35,"ل",2,0],["يا رعى اللَه بيت دين المعالي","قد حكى روضها رياض الجنان",36,"ن",1,0],["يا رعى الله ثنيّات بها","قد زهت في كل ربع خضل",37,"ل",1,0],["يا رعى اللَه معالي طبقة","زفها السعد وحيّاها الوفود",38,"د",1,1],["يا رعى اللَه ديارا حلها","منتهى الآمال فيها والطلب",39,"ب",1,0],["يا رعى اللّه طيب أيام أنس","في مغانيكم تقضّى صفاها",40,"ا",3,0],["يا رعي الله منه ذاك المحيّا","والقوام المخنّثَ الأعطاف",41,"ف",1,0],["يا رَعى اللَّهُ ليلةً أَلبسَتْنا","بعد فرطِ العِتابِ عِقدَ العِناقِ",42,"ق",1,0],["يا رَعى اللّهُ رامةً وسَقاها","ضاحِكاتُ البُروقِ دمعَ حَباها",43,"ا",3,0],["يَا رَعى اللهُ إخوَةً كَتَبُوا لي","وَأنا فِي ظَلامِ تِلكَ السُّجُونِ",44,"ن",1,1],["يا رَعى الله إخوةً كَرَّمُوني","مَن مُعِينِي عَن شكرهم مَن مُعِيني",45,"ن",2,1],["يا رعى الله قباباً بقِباً","عادها عادت ورامت إرم",46,"م",1,0],["يا رعاة الحمى أماناً أمانا","جئتُ كي أصطلي فهل لي إلى نا",47,"ن",2,0],["يا رعى الله بالأجارع قوماً","هم لدينا يا دهرُ من حسناتك",48,"ك",1,0],["يا رَعى اللَهُ عَيشَنا سابِقاً وَالدَه","رُ وَلّى بِذَيلِهِ يَتَعَثَّر",49,"ر",1,0],["يا رَعاك الَّذي حَباك بِحلم","عش سَعيداً في عزة وَأَمان",50,"ن",1,0],["يا رَعى اللَّهُ لَيلةً قَد تَقَضَّتْ","لِيَ فيهِ بِطيبِ عَيْشٍ رَغيدِ",51,"د",1,0],["يا رَعاهُ اللَّهُ مِن شَهمٍ جَليلْ","وَوَجيهٍ لا يُضاهيهِ وَجيهْ",52,"ه",1,0],["يا رَعاهُ اللَّه مِن شَهمٍ فريدْ","بِشرُهُ في وَجهِهِ كالبلجِ",53,"ج",1,0],["يا رَعى اللَّه حِماها مِن حِمى","وَسَقاها بِالمُلثّ الأَقدسِ",54,"س",1,0],["يا رَعاهُ اللَّه مِن حَبْرٍ إِمامْ","إِذ بِهِ كلُّ إِمامٍ يَقتدي",55,"ي",1,0],["يا رَعاهُ اللَّهُ مِن شَهمٍ وَجيهْ","وَأَريبٍ في البَرايا أَلْمعي",56,"ي",1,0],["يا رعاه اللَه من واد وسيم","رق فيه الماء واعتل النسيم",57,"م",1,1],["يا رعى الله ليلة بتُّ فيهَا","أجتلي خيفةً كؤوس الأمانِ",58,"ن",1,0],["يا رعى الله عهدنا بالمصلى","لا دَهاه من الخطوب انصرامُ",59,"م",1,0],["يا رَعى اللَّهُ لَيالي وَصلِهِ","وَتَغَنِّيهِ بِشِعري وَنِظامِي",60,"ي",1,0],["يا رَعى اللَّه زَماناً مَرَّ في","أَيمَنِ الشّعبِ وشعبِي ما انشَعَب",61,"ب",1,0],["يا رعى الله عهده من حبيب","شأنه الصدق في وفا الميعاد",62,"د",1,0],["يا رعى الله عهوداً بالحمى","وليالٍ أشرقت بالأنسِ",63,"س",1,1],["يا رعى الله أنسَ يوم سعيدٍ","فيه وافت تفي المحب وعودا",64,"د",2,0],["يا رعاه الله من حرّ كريمْ","قد محا في عدله الجور الذميمْ",65,"م",1,0],["يا رعى الله صفاه وسقى","عهده صوب الرضى الوافي المديدْ",66,"د",1,0],["يا رعاه الله من فردٍ عَلَمْ","في الورى فخر الملا عَين الزمَنْ",66,"ن",1,0],["يا رعى الله ثنيّاتٍ بها","قد زهت في كل روض خضلِ",67,"ل",1,0],["يا رعى الله الندامى والحمى","وربى تلك المغاني الأنسِ",68,"س",1,1],["يا رعاة الود والعهد القديم","يا بدوراً في المباهي أشرقوا",69,"ق",3,0],["يا رعى اللَه لِلرَبيع شبابه","إِذ أشاب البطاح زهر تشابه",70,"ب",2,1],["يا رعاك اللَه من بحر ندى","بيتك الكعبة للوفاد مثوى",71,"و",2,0],["يا رعى الله وقتنا بالمصلى","حيث يلقى حبيبنا اجتابه",72,"ب",2,0],["يا رعى الله ما شهدناه ذوقا","في معاني الصفات والأسماء",73,"ا",2,0],["يا رعى الله ما بها من كؤوس","قداد يرت من صرف خمر الشهود",74,"د",1,0],["يا رعى الله مشهد العجز فهو ال","اصل في الوصل والفروع كثير",75,"ر",1,0],["يا رعا اللَه ما مضى من ليالي","كان فيها الوصال طوع مرادي",76,"د",2,0],["يا رعا اللَه زمانا قد مضت","فيه لذات كثيرات الهنا",77,"ن",2,0],["يا رعا اللَه اويقات مضت","في زيارات الشفيع والبقيع",78,"ع",1,0],["يا رعاها الله أيامَ اللعِب","كم بكيناها بدمعٍ من دمِ",79,"م",1,0],["يا رَعاهُ اللَه مِن بَدر","لاحَ في لَيل مِن الشعر",80,"ر",1,0],["يَا رَعَى اللَّهُ بِالخِيَامِ زَمَاناً","قَدْ مَرَى مَا حَلَى وَسَنَّ مَرَامَا",81,"م",2,0],["يا رعى الله ليلة طوقتنا","بعد فرط العتاب عقد العناق",82,"ق",1,0],["يا رعاك الإله أنّى تراءت","من مجانيك طيباتُ المآثر",83,"ر",1,0],["يا رعى اللّه جيرة خيّموا بال","منحنى من ضلوعه المستهامة",84,"م",2,0],["يا رعى الله زمانا بالحمى","وأويقات تقضّت باللوي",85,"ي",1,0],["يا رعاك الله كفي عن دمي","سهم عينيك فقد أوما إلي",85,"ي",1,0],["يا رعى اللّه جيرة الجرعاء","وقبابا عهدتها بقباء",86,"ا",2,1],["يا رعى الله يوم انسٍ تقضَّى","في رياضٍ بزهرها تتباهى",87,"ا",3,0],["يا رَعى اللَهُ مِنهُ أَيَّ هُمامٍ","قَد أَذاقَ الهُمومَ حِزبَ الضَلالِ",88,"ل",1,0],["يا رعى اللَه والياً قادح الزن","د سليم الخلال من كل 