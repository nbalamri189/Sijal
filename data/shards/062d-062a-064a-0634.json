{"poems":[[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[92,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[145,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[435,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[472,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"]],"verses":[["حَتّى شَتا وَهوَ مَغبوطٌ بِغائِطِهِ","يَرعى ذُكوراً أَطاعَت بَعدَ أَحرارِ",0,"ر",1,0],["حتى شواطئُ دجلةٍ منسابةً","تأبى تُشاهد منظراً مفجوعا",1,"ع",2,0],["حتّى شَتَيْنَ بنيسابورَ باليةً","إلا عِظاما مُواراةً بأجلادِ",2,"د",1,0],["حَتَّى شَقَقْتُ اللَّيْلَ عَنْ إصْبَاحِهِ","وَطَوَيْتُ ذَيْلَ ظَلامِهِ المَجْرورا",3,"ر",2,0],["حَتّى شَدَدتُ عَلَيها الرَحلَ فانجَرَدَت","مَرَّ الظَليمِ شأَتهُ الأُبَّدُ الشُرُدُ",4,"د",1,0],["حَتّى شَآها كَليلٌ مَوهِناً عَمِلٌ","باتَت طِراباً وَباتَ اللَيلَ لَم يَنَمِ",5,"م",1,0]]}