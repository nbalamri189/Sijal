{"poems":[[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[92,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[146,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[438,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[475,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122544","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70806","البسيط"],[954,"","https://poetry.dctabudhabi.ae/diwan/poem/203457","المنسرح"],[1529,"","https://poetry.dctabudhabi.ae/diwan/poem/140211",""],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111856","الكامل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132693","السريع"],[4728,"رسالة من غريب (هلالي قصير)","https://www.poetsgate.com/ViewPoem.aspx?id=176996",""],[4805,"لجة صمت 2","https://www.poetsgate.com/ViewPoem.aspx?id=176603",""],[4816,"اهداء للصديق سعيد الحجري","https://www.poetsgate.com/ViewPoem.aspx?id=199475",""],[4830,"رسول الرحمة محمدﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=193598",""],[4858,"رحماك ربي","https://www.poetsgate.com/ViewPoem.aspx?id=34590",""],[4869,"ورديّ الاحلام","https://www.poetsgate.com/ViewPoem.aspx?id=151512",""],[4875,"صافي نوايا","https://www.poetsgate.com/ViewPoem.aspx?id=133361",""],[4929,"ليل أشد من الظلماء","https://www.poetsgate.com/ViewPoem.aspx?id=199471",""],[585,"بكيت والحزن سد الأفق وازدحمت","https://www.poetsgate.com/ViewPoem.aspx?id=161956",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5431,"أفيون....","https://www.poetsgate.com/ViewPoem.aspx?id=204084",""],[5691,"أمام المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=206736",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[6093,"تركة شيب","https://www.poetsgate.com/ViewPoem.aspx?id=206166",""]],"verses":[["حَتّى شَتا وَهوَ مَغبوطٌ بِغائِطِهِ","يَرعى ذُكوراً أَطاعَت بَعدَ أَحرارِ",0,"ر",1,0],["حتى شواطئُ دجلةٍ منسابةً","تأبى تُشاهد منظراً مفجوعا",1,"ع",2,0],["حتّى شَتَيْنَ بنيسابورَ باليةً","إلا عِظاما مُواراةً بأجلادِ",2,"د",1,0],["حَتَّى شَقَقْتُ اللَّيْلَ عَنْ إصْبَاحِهِ","وَطَوَيْتُ ذَيْلَ ظَلامِهِ المَجْرورا",3,"ر",2,0],["حَتّى شَدَدتُ عَلَيها الرَحلَ فانجَرَدَت","مَرَّ الظَليمِ شأَتهُ الأُبَّدُ الشُرُدُ",4,"د",1,0],["حتى شدا الوادي السعيد لي الهنا","قد نلت بالملك السعيد شفائي",5,"ا",2,0],["حتى شَعبتَ به صُدوعاً فَرّقت","فرقاً فكُنَّ قبائلاً وشعوبا",6,"ب",2,0],["حتى شُنِئْتَ وشانَ الفعلُ منك كما","غدا يذمك بين الناسِ كلُّ حفي",7,"ف",2,0],["حتَّى شَتا بادناً يقال ألا","يَطوون من بُدنهِ وقد أُضمرْ",8,"ر",1,0],["حتى شجراتُكَ يغشاها","بالحسن الماءُ الرقراق",9,"ق",1,0],["حتى شكت طول المسير واوشكت","مما الّم بها تصيحُ وتصرخُ",10,"خ",1,0],["حَتّى شَآها كَليلٌ مَوهِناً عَمِلٌ","باتَت طِراباً وَباتَ اللَيلَ لَم يَنَمِ",11,"م",1,0],["حتى شهدت البأس من فيلق","يزحف لكن بمناياك",12,"ك",1,0],["حتى شربت من القصايد بحورها","تحيي هيام وتستميت هيام",13,"م",1,0],["حتى شطير الهم لا دك بعظام","يمكن يهوّن مار انا ما اهونّ",14,"ن",1,1],["حتى شهدو لك حق ولا انت حقك","ترجح موازينه وما كان طافي",15,"ف",2,0],["حتى شدَونَ بانغام الجوى شغفاً","على زفير الحشا والعازفُ القلمُ",16,"م",1,0],["حتى شببتم يا بني وصرتم","علماً يرفرف عالياً خفاقاً",17,"ق",2,0],["حتى شكت من كثر ما اشكيك الاقلام","وبحر القصايد فيك لله درّه",18,"ر",2,0],["حتيش لو شفت يابن الناس حتيش","صافي نوايا ولابه شي مغشوش",19,"ش",1,0],["حتى شقَقَنَا على مرآى الورى فَلَقاً","في جوفِهِ من دمانا غيرَ ذي دَخَنِ",20,"ن",1,0],["حتى شعرت بأن اللفظ قد وثبت","به الحياة وحفت منه بي زمر",21,"ر",1,0],["حتى شربت خصاله","واستسلمت لي طائعة",22,"ع",2,0],["حتى شبعت وإنني بوعائه","رهن العناق مهاجم مفتون",23,"ن",1,0],["حتى شعرْتُ كأني لست أعرفه","أو ناب عينيَّ كيما لا أراه عمى !",24,"م",2,0],["حتّى شعوب الأرض في دستوركمْ","وكلّ مافي الأرضِ مِنْ خيرٍ وفيرْ",25,"ر",1,0],["حتى شَخصتُ بعيني نحوَ صادقةٍ","لسانُها صورةٌ والصدقَ تحكيهِ",26,"ي",2,0]]}