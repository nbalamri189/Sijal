.ae/diwan/poem/55140","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54988","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43656","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54237","الوافر"],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[77,"هلم فجفن الدهر قد لاذ بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=34170",""],[100,"يا نجوم","https://www.poetsgate.com/ViewPoem.aspx?id=50456",""],[100,"الربيع والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50128",""],[96,"إمرأة وشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17498",""],[96,"تحية واعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=13206",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[45,"لابِسٌ مِنْ شَبِيبَةٍ أمْ نَاضِ","https://www.poetsgate.com/ViewPoem.aspx?id=31132",""],[78,"تَظُنُّ بِنا أُمُّ الرَّبيع سآمَةً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86477&r=&rc=22",""],[85,"إن الوُشاة َ وإن لم أَحْصِهم عددا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9541&r=&rc=31",""]],"verses":[["وَرَوَّحتُ حِلمي بَعدَما غَرَّبَت بِهِ","ذُنوبُ بَني عَمّي غُروبَ السَوائِمِ",0,"م",1,0],["وُرودٌ مِنَ الآجالِ لا يَستَجِمُّنا","وَوِردٌ مِنَ الآمالِ لا نَستَجِمُّهُ",1,"م",2,0],["وَرَوا كَبِدي في آخِرِ الدَهرِ لَوعَةً","بِما بَرَّدوا قَلبي عَلى أَوَّلِ الدَهرِ",2,"ر",1,0],["وَرودَ خَفيفِ الوِردِ أَوَّلَ وارِدٍ","طُروقاً إِلى ماءٍ وَأَوَّلَ صادِرِ",3,"ر",1,0],["وَرَوعَةِ يَومِ النَحرِ وَالهَديُ حائِرٌ","وَكُلِّ دَمٍ أَودى بِجُمَّتِهِ الرَكبُ",4,"ب",1,0],["وَرَوضي مَطارِفُهُ غَضَّةٌ","تُطَرِّزُ أَطرافَها بِالذِهابِ",5,"ب",1,0],["وَرَواحَ الحَجيجِ لَيلَةَ جَمعٍ","وَبِجَمعٍ مَجامِعُ الأَهواءِ",6,"ا",2,0],["وَرَوضَةٍ زُرتُها وَالحِميريُّ مَعي","وَصارِمٌ خَذِمُ الغَربَينِ وَالفَرَسُ",7,"س",1,1],["وَرَوْضٍ زُرْتُهُ وَالأُّفْقُ يُصْحِي","أَحايِيناً وَآوِنَةً يَغيمُ",8,"م",1,1],["وروى فم التاريخ سحر جماله","فكراً مجنحة ووحياً محكما",9,"م",2,0],["وَرُوِّعنَ بِالصُبحِ أَبصَرتَنا","نُفَدّي بِأَنفُسِنا أَجمَعينا",10,"ن",2,0],["وَرَوْصٍ دَنَتْ لِلْهَاصِرِينَ قِطَافُهَا","فَكَانَ كَلاَمُ الْقَوْمِ بَعْضاً إِلَى بَعْضِ",11,"ض",1,0],["وَرَوَيْتُ غُرَّ مآثِر أَسْنَدْتُهَا","لِعُلاَكَ بَيْنَ صَحَائِحٍ وَحِسَانِ",12,"ن",1,0],["وَرَوْضٍ سَقَاهُ النَّصْرُ صَوْبَ غَمَامِهِ","وَدَارَتْ عَلَيْهِ مُفْعَمَاتُ سِجَالِهِ",13,"ل",2,0],["ورَوَتْ حَديثَ عُلاكَ حتّى","التُّرْك كَلاّ والتّطَرْ",14,"ر",1,0],["وروّى ظِماءَ الجيْشِ ماءُ بَنانِهِ","فلِلّهِ أمْواهٌ هُناكَ سَوائِحُ",15,"ح",1,0],["وَرَوْضَ بَنَانٍ أَيْنَعَتْ وَرَقَاتُهُ","وَقَدْ سَحَّ فِيهَا مِنْ بَنَانِكَ سَاكِبُ",16,"ب",1,0],["وَرومِيَّةٍ في الدارِ عِندي عَزيزَةٍ","عَلَيَّ تُرَوّيني الحَديثَ بِلا ضَجَر",17,"ر",1,1],["وَرُواقِ ملكٍ أَنتَ شِدتَ ظِلالَهُ","لَولاكَ زالَ ظِلالُهُ وَتَقَوَّضا",18,"ض",2,0],["وَرَوضاً إِذا ما الريحُ فيهِ تَنَسَّمَت","سُحَيراً تخالُ المَندَلَ الرطبَ أُضرِما",19,"م",2,0],["وَرُوِّعَتِ الفُسْطَاطُ لَكِنَّهَا طَغَى","عَلَى حُزْنِهَا فِي ذَلِكَ اليَوْمِ أَحْزَانُ",20,"ن",1,0],["وروضة حسن للشباب نضيرةٍ","هصرتُ بغصن البانِ فيها المجانيا",21,"ي",2,0],["وروّضَ المحل منها كلُّ منبجسٍ","إذا اشتَكَتْ بقليل الجدب يُرويها",22,"ي",3,0],["وروض شباب ماس غصن قوامه","وفتّح فيه اللحظ أزهار نرجسِ",23,"س",1,0],["وروى عبد الضحاك عن زَهر الربُّى","ما أسند الزهري عنه عن مطرْ",24,"ر",1,0],["وروض جمال ضاع عَرفُ نسيمه","وما ضاع غير الورد في صفحة الخدِّ",25,"د",1,0],["وروتْ أحاديث الفتوح غرائباً","والنصر يملي والبشائرُ تنقلُ",26,"ل",1,0],["وروح الفتى بعد الردى إن يكن لها","بقاء وحسّ فالحياة هي الخُسر",27,"ر",1,0],["وَروِّحَتِ اللِقاحُ بِغَيرِ دَرٍّ","إِلى الحُجُراتِ تُعجِلُ بِالرَسيمِ",28,"م",1,0],["وروحت اللقاح مُبهلت","ولم تعطف على الرُبع السَّلوبُ",29,"ب",1,0],["وروحت الأشوال والشمس حيَّة","حدابير حُدْباً كالحقائق نيبها",30,"ب",3,0],["وَرَوضَةٌ مِن رِياضِ الفِكرِ دَبَّجَها","صَوبُ القَرائِحِ لاصَوبٌ مِنَ المَطَرِ",31,"ر",1,0],["وروضة لحدٍ حلها غصنُ قامةٍ","لعمري لقد طابت وقد طاب نبتها",32,"ت",3,0],["وروّى نباتياً من القولِ طالما","سقاهُ أبوهُ الغيث نوا مثججا",33,"ج",2,0],["وروَّضنَ أقطار الشآم بأحرفٍ","سقى أصلها طاف من النيل طافح",34,"ح",1,0],["وروضة العيش في العلياءِ آنفة","ما واصلت بين اتهام وإنجاد",35,"د",1,0],["وروض لفظك ريحان القلوب إذا","سجَّعته فإذا الريحان منثور",36,"ر",1,0],["وروائح المعروف لا تخفى على","حال فشمُوا من أنامليَ العَبق",37,"ق",1,0],["وروضاً كأنَّ سقاه المدام","تبتري سواقيه الجاريه",38,"ي",2,0],["وروحي تتوق إلى غيره","وأنت إلى العرف عندي تتوق",39,"ق",1,0],["وَرودٌ سَبَنتاةٌ تُسامي جَديلُها","بِأَسجَحَ لَم تَخنِس إِلَيهِ المَشافِرُ",40,"ر",1,0],["وَرَوَّيْتَ بالدَّمِ قَلْبَ التُّرابِ","وأَشْربتَهُ الدَّمعَ حتَّى ثَمِلْ",41,"ل",1,0],["وَرَوضَةَ حُسنٍ أَجتَني مِن ثِمارِها","وَبارِدَ ظَلمٍ لَم تُكَدّر شَرائِعُهْ",42,"ع",2,0],["ورؤس نواكس ورقاب","في خشوع منها الى الغش ميل",43,"ل",1,0],["ورويت في بيض القلا","نس عن عذارى الهيكل",44,"ل",1,0],["ورؤوس منثور خفضن لعزه","تيجانهن عواطر الأرواح",45,"ح",1,0],["وروحك مركز للطف طرّا","فكل اللطف مرجعه إليك",46,"ك",1,0],["وروتر من ذهول لا يخبى","يباهي الأرض في شرق وغرب",47,"ب",1,0],["وَرُوِّعَ شَيخُها العالي بِيَومٍ","فَكانَ بِمَنكِبَيهِ لَهُ وِقاءَ",48,"ا",2,0],["وَرَوى مَواكِبَكَ الزَمانُ لِأَهلِهِ","وَتَنَقَّلَت بِجَلالِها الأَخبارُ",49,"ر",1,0],["وَرَوّى عَلى رِيِّها الناهلا","تِ وَرَدَّ الظِماءَ فَلَم تَشرَبِ",50,"ب",1,0],["وَرَوضٍ كَما شاءَ المُحِبّونَ ظِلُّهُ","لَهُم وَلِأَسرارِ الغَرامِ مَديدُ",51,"د",1,0],["وَروحِ صَبٍّ أَطالَ الحُبُّ غُربَتَها","يَخافُ إِن رَجَعَت أَن تُنكِرَ الجَسَدا",52,"د",2,0],["وَروموا النُبوغَ فَمَن نالَهُ","تَلَقّى مِنَ الحَظِّ أَسنى التُحَف",53,"ف",1,0],["وروى الأطبّةُ أنّ ما بك قاتِلٌ","حُمْقٌ شفاؤُكَ كان منه بعيدا",54,"د",2,0],["وَروحِ الأجساد في حلّها","فحلَّها أمر علينا يسير",55,"ر",1,0],["وروحه ينفخ فيها على ال","تدريج من شهر إلى شهرِ",56,"ر",1,0],["وَرَوضٍ كَساهُ الطَلُّ وَشياً مُجَدَّداً","فَأَضحى مُقيماً لِلنُفوسِ وَمُقعِدا",57,"د",2,1],["وَرومِيَّةٍ فيها المَنايا ضَرَبتَها","بِشَهباءَ يُعشي الناظِرينَ قَتيرُها",58,"ر",3,0],["وَرَواحُ مُعصِفَةٍ وَغَدوَتُها","شَهراً تُواصِلُهُ إِلى شَهرِ",59,"ر",1,0],["وَرودٍ لِأَعدادِ المِياهِ إِذا اِنتَحى","عَلَيهِ الرَزايا مِن حَسيرٍ وَزاحِفِ",60,"ف",1,0],["وروى لي عن ناهدي حكايا..","فهما جدولا نبيذ وقهوة",61,"و",2,0],["وروضة بات طل الغيث ينسجها","حتى إذا نسجت أضحى يدبجها",62,"ج",3,1],["وروضُه المُدَبَّجُ المُفَوَّفُ","تُرْبٌ صَحيحٌ وهواءٌ مُدْنَفُ",63,"ف",1,0],["ورَوْضٍ فيه تَدبيجٌ","منَ النُّوْرِ وتَفويفُ",64,"ف",1,0],["ورَوضتهُ غَيْثُ أقلامِهِ","وقد كانَ من قَبلِهِ بَلْقَعا",65,"ع",2,0],["ورَوْضٍ كَساهُ الغَيثُ إذ جادَ أرضَه","مَجاسِدَ وَشْيٍ من بهارٍ ومَنثورِ",66,"ر",1,1],["ورَوْضٌ يُراقُ بماء الحياةِ","فنُوَّارُهُ يَملأُ العَينَ نُورا",67,"ر",2,0],["وروضةُ آذَرْيونَ قد زُرَّ وسْطَها","نَوافجُ مِسْكٍ هيَّجَت قلبَ مُهتاجِ",68,"ج",1,1],["وروضٌ إذا ما راضَه الغيثُ أنشأتْ","حدائقُه وَشْياً كوَشْيِ السّبائبِ",69,"ب",1,0],["وَرَوى بِلاداً جودُ كَفِّكَ غَيثُها","فَفي كُلِّ قُطرٍ مِن نَداكَ بِها قَطرُ",70,"ر",1,0],["وَرَوَوا عَنهُ أَنَّ ذاكَ زَواجٌ","ثابِتٌ يَقتَضي شُروطَ اللُزومِ",71,"م",1,0],["وَرَوَّوا بِماءِ الجودِ غَرسَ أَبيهِمُ","فَأَينَعَ في أَغصانِهِ ثَمَرُ الشُكرِ",72,"ر",1,0],["ورويت أذني من حدي","ثكِ وهو معبود النغم",73,"م",1,0],["ورواية رويت وموجزها","صحبٌ مضوا وأحبةٌ هجروا",74,"ر",3,0],["وروضة حسنٍ غَرّدَت فوقَ نحرها","عصافيرُ حَلْيٍ تلقطُ الدرّ لا الحبّا",75,"ب",2,0],["ورؤوسٌ بالمواضي تُخْتَلى","ونفوسٌ بالعوالي تُنتهب",76,"ب",1,0],["وَرَوِّح مِنكَبَيكَ فَقَد أُعيدا","حُطاماً مِن زِحامِكَ في قُضاعَه",77,"ع",2,0],["وروضٍ غدا عن سحبِهِ طيّبَ الثنا","بنفسجُهُ يحكي الخُدَيْدَ المفضضا",78,"ض",2,0],["ورودَ مرسومٍ لكمْ ظنَّهُ","كتابَهُ أُوتيَهُ باليمينْ",79,"ن",1,0],["وَرَوضَةٍ طَلقَةٍ حَياءً","غَنّاءَ مُخضَرَّةٍ جَنابا",80,"ب",2,0],["ورُوِّعَتِ الخلافةُ في حماها","وضجَّ بنو الخلافةِ نادبينا",81,"ن",2,0],["وَرَوى ابنُ سُفيانَ الحديثَ فلو دَرى","لُغةَ السُّيوفِ لَخَالها تَتَكلّم",82,"م",1,0],["وَروحاً عَلى القَلب مثل النَسيم","يَهبُّ فَينعش قَلب الكَئيب",83,"ب",1,0],["وَرَوَّحَها في المَورِ مور حَمامَةٍ","عَلى كُلِّ إِجرِيّائِها هُوَ رائِزُ",84,"ز",1,1],["وَروَّى عَسْكَراً بِحليبِ شاةٍ","فعاوَدَهُم بهِ العَيْشُ الخصيبُ",85,"ب",1,0],["وروحِ هُدىً في جسم نورٍ يُمِدُّهُ","شُعاعٌ من الأعلى الذي لم يُجَسَّم",86,"م",1,0],["وَروقَةٍ بِكرٍ يُصَلّى بِها","حينَ تُجَلّى وَيُطالُ القُنوتُ",87,"ت",1,0],["وَرَوحُ الفَتى أَشبَهَت طائِراً","أُطيرَ فَما عادَ لَمّا نَفَر",88,"ر",1,0],["وَروقٍ كَالهَبا وَأَقَلُّ مُلقىً","عَلى شَوكِ القَتادِ أَو الهَراسِ",89,"س",1,0],["وَرَومُ الفَتى ما قَد طَوى اللَهُ عِلمَهُ","يُعَدُّ جُنوناً أَو شَبيهَ جُنونِ",90,"ن",1,0],["ورَوضَةِ وَردٍ حُفَّ بالسَّوسَنِ الغَضِّ","تَحلَّتْ بلونِ السَّامِ وَالذَّهَبِ المَحْضِ",91,"ض",1,1],["ورَوضَةٍ عقدَتْ أَيْدِي الربيعِ بِها","نَوْراً بِنَوْرٍ وتَزْويجاً بتَزْويجِ",92,"ج",1,1],["وَرواء في الخد منها جَميل","فهو ماء مصفق لَيسَ ينضب",93,"ب",1,0],["وروَّعَ الأمة الغلباءَ في رَجُلٍ","شدَّتهُ قوساً وسلَّتْ منه بتَّارا",94,"ر",2,0],["ورووا عنها أحاديثَ هوىً","آثمٍ يُغرِبُ فيها من رواها",95,"ا",3,0],["وروودتْ بلبيس حتى أذعنتْ","وركبت بالمسلمين إذ عنتْ",96,"ت",1,0],["وَرَوْعَاءِ الْمَسَامِعِ مَا تَمَطَّتْ","بِحَمْلٍ بَيْنَ سَائِمَةٍ مَخَاضِ",97,"ض",1,1],["وَرَوْضَةُ إِينَاسِي وَلَهْوِي تَحَوَّلَتْ","فَلاَ حُسْنُهَا يُسْلِي ولاَ الشَّدْوُ يَشْغَلُ",98,"ل",1,0],["وَروحٌ كالْخُلاصَة مِن","عَبِيرٍ خَتْمُها فُضَّا",99,"ض",2,0],["وُرودُ الرَدى أَولى وَإِن عيفَ وردُهُ","لِمَن باتَ ظَمآناً إِلى ريق مَن يَهوى",100,"و",2,0],["وَرَوضاً كَأَن لَم تَغن بِالأَمسِ أَرضهُ","وَلا أَخَذت مِن حُسنِهِ كُلَّ زخرَفِ",101,"ف",1,0],["ورُوحٌ سَرى السارون في نورِ هَدْيه","فلم يُخْطِئوا للمجدِ نَهْجاً ولا قصدا",102,"د",2,0],["وَرَوْضَاتٌ حَلَتْ في كُلِّ عَيْنٍ","وَأَغْرَتْ بِالأَزَاهِرِ كُلَّ رَائي",103,"ا",2,0],["ورواية من عهد ذي القرنين ما","بَرِحَ الزمانُ مرددًا أدوارها",104,"ر",3,0],["وروَى عن اليونان لل","جبل الحديث وترجما",105,"م",2,0],["وروض دنت للهاصرين قطوفها","فكان كلام القوم بعضا إلى بعض",106,"ض",1,0],["ورؤى ، تستفزني وتولّى","ورؤى تزرع المساء سهادا",107,"د",2,0],["وروى فم التاريخ سحر جمالها","فكرا مجنّحة ووحيا محكما",108,"م",2,0],["ورووا عنها أحاديث هوى","آثم يغرب فيها رواها",109,"ا",3,0],["وروّع الأمة الغلباء في رجل","شدذته قوسا وسلّت منه بتّارا",110,"ر",2,0],["ورِوايةٍ حبَكَ الزَّمانُ فُصولَها","فبدَتْ لنا ممسوخةً الأدوار",111,"ر",1,0],["ورَوَّضْتُ بالتوطينِ نفساً غريبةً","تراني وما تبغيه لا نتشاكل",112,"ل",1,0],["ورُوِّعَ السمعُ حتى بات من ذَهَل","يود سَمعُ الفتى لو أنه بَصَر",113,"ر",1,0],["وَرُوَاءُ المَشيبِ كالبحصِ في عَيْ","ني فقُلْ فيهِ في العيُونِ المِرَاضِ",114,"ض",1,0],["وَرَوضَةَ حُسنٍ أَجتَنيها، وباردٍ","مِن الظَّلم، لَم تُحظَر عليَّ شَرائِعُه",115,"ع",2,0],["ورُوحِ صبٍّ أَطالَ الحبُّ غُرْبَتَها","يخافُ إن رجعتْ أن تنكرَ الجسدَ",116,"د",1,0]]}