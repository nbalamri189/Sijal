{"poems":[[85,"يهني زمانك أعياد مجددة","https://www.aldiwan.net/poem54232.html","البسيط"],[74,"لا أظلم الشيب فمن قبله","https://www.aldiwan.net/poem18321.html","السريع"],[93,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[91,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[47,"يا أبا صالح صديق الصلاح","https://www.aldiwan.net/poem62703.html","الخفيف"],[47,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[63,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[52,"لا أظلم الليل ولا أدعي","https://www.aldiwan.net/poem62405.html","السريع"],[83,"","https://poetry.dctabudhabi.ae/diwan/poem/11530","الرجز"],[164,"حلفت يقظان مروج العنان","https://www.aldiwan.net/poem58767.html","السريع"],[189,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[215,"يا ليل يا ليلى يا ليل","https://www.aldiwan.net/poem46606.html","المواليا"],[310,"صبحا بدا من رأي خير الدين","https://www.aldiwan.net/poem56390.html","الكامل"],[409,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144841","الكامل"],[5956,"لوعة","https://www.poetsgate.com/ViewPoem.aspx?id=182154",""],[5970,"نحن يا أيام أضياف لديك","https://www.poetsgate.com/ViewPoem.aspx?id=130588",""],[6056,"مفهوم الأذواق","https://www.poetsgate.com/ViewPoem.aspx?id=130522",""],[5309,"لا اظلم الناس فالمظلوم معدود","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573812",""]],"verses":[["لا أظلم الله أفقاً أنت نَيِّرهُ","لا أهمل الله سرحاً أنت ترعاهُ",0,"ا",2,0],["لا أظلم الشيب فمن قبله","ما كان لي في طيب عيشٍ نصيب",1,"ب",1,1],["لا أَظلُمُ الأَيّامَ فيما قَد جَنَت","لا تَأمَنِ الأَيّامَ أَن تَتَفَرَّقا",2,"ق",2,0],["لا اظن الحياة تلقى سلاما","من بلايا وراءهن بلايا",3,"ي",2,0],["لا اظن الارواح تقبل اسراً","بعد حرية لها وانطلاق",4,"ق",1,0],["لا أَظُنُّ الصَباحَ يوفي بِإِشرا","قِ خِلالٍ في ساحَتَيكَ صِباحِ",5,"ح",1,0],["لا أَظُنُّ البُخّالَ يوفونَكَ الشُك","رَ وَلَو كانَ بُكرَةً وَأَصيلا",6,"ل",2,0],["لا أظِلمُ الحُبَّ في رَيَّا وإنْ ظَلمتْ","ولا أُكَفكِفُ فيه الدَّمعَ ما انسجَما",7,"م",2,0],["لا أَظلِمُ النَأيَ قَد كانَت خَلائِقُها","مِن قَبلِ وَشكِ النَوى عِندي نَوىً قَذَفا",8,"ف",2,0],["لا أَظلِمُ اللَيلَ وَلا أَدَّعي","أَنَّ نُجومَ اللَيلِ لَيسَت تَغور",9,"ر",1,1],["لا أَظلِمُ البَينَ أَقو","لُ شَتِّتِ المُؤتَلِفا",10,"ف",2,0],["لا أظلم الدهر فقد سرني","وعشت من أحداثه في الزمان",11,"ن",1,0],["لا أظلمُ البينَ حالي كالذي كانا","سِيّانِ إنْ غاب من أهوى وإن دانا",12,"ن",2,1],["لا أظلم الأقدار","إن الهوى والنار",13,"ر",1,0],["لا أَظهُراً أبقَوا ولا شققاً طووا","تنضى قواهُم حوّماً بوكونِ",14,"ن",1,0],["لا أظن الدهر لي مستيقظاً","نافياً عن طرفه طيب الوسن",15,"ن",1,0],["لا أظلمُ الليلَ الطويلَ وأشتكي","منه وما لي في الصباح رجاءُ",16,"ا",2,1],["لا أظنُّ الفِعلَ هذا","مِنْكَ، بل هذا القدَرْ",17,"ر",1,0],["لا أظن الغيب قد زج بنا","لنلاقي ما نلاقي من يديك",18,"ك",1,0],["لا اظلم سواد الليل بالجوف حسيت","شيء ٍ على رمانة القلب ، دقاق",19,"ق",1,0],["لا أَظلِمُ النّاسَ فَالمَظلومُ مَعدودُ","في الرّابِحينَ وَبَعضُ الظُّلمِ تَخليدُ",20,"د",1,1]]}