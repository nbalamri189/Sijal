{"poems":[[95,"يا ليل أبدعت نظام الحلى","https://www.aldiwan.net/poem9846.html","السريع"],[74,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[68,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[71,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55210","السريع"],[108,"عاهل الصحافة","https://www.poetsgate.com/ViewPoem.aspx?id=179688",""],[112,"بسألك","https://www.poetsgate.com/ViewPoem.aspx?id=8395",""],[119,"بلذة العيش عش يا خالي البال","https://www.aldiwan.net/poem40629.html","عموديه"],[137,"يا سيدي جاءتك رفعة شاعر","https://www.aldiwan.net/poem4209.html","الكامل"],[173,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[189,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[500,"أنعت ليلا ذا سواد كالسبج","https://www.aldiwan.net/poem9804.html","مشطور الرجز"],[505,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[518,"قسمك عليك الدهر نصفا تعتبا","https://www.aldiwan.net/poem67783.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138271",""],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130145","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79927","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137417",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94269","الرجز"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112594","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65129","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97889","السريع"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104366","المتقارب"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105758","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132127","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117888","المجتث"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130558","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111048","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111053","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33385","المنسرح"],[4896,"في وجه العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=180880",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5324,"بغداد مشفقة على أعدائها .","https://www.poetsgate.com/ViewPoem.aspx?id=207568",""],[5324,"اليقين .","https://www.poetsgate.com/ViewPoem.aspx?id=211660",""],[5409,"زيدي بنيك محاسناً وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=155304",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5455,"خلاص","https://www.poetsgate.com/ViewPoem.aspx?id=34577",""],[243,"تسديد الحساب","https://www.poetsgate.com/ViewPoem.aspx?id=50560",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[402,"يا ليل أبدعت نظام الحلى","https://www.poetsgate.com/ViewPoem.aspx?id=36184",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["لو أدرك المحبوب من نقطها","لم يختلف في المعجز المنزل",0,"ل",1,0],["لو أدركتك بنو العبَّاس لانتصرت","بمقدمٍ في ظلامِ الخطب ضحَّاك",1,"ك",1,0],["لَوِ اِدَّعَت جودَكَ الأَفواهُ لَاِتُّهِمَت","وَلَو تَعاطاهُ لُجُّ البَحرِ لَاِفتَضَحا",2,"ح",2,0],["لو ادعى أنهُ يحكيهِ قلتُ لهُ","لقدْ حكيتَ ولكنْ فاتَكَ الشنبُ",3,"ب",1,0],["لو أدركتْ نُوحاً","عشنا بلا أرضِ",4,"ض",1,0],["لَوْ أُدْرِكَ المَحْجُوبُ فِي لَفْظِهَا","لَمْ يَخْتَلِفْ فِي المُعْجِزِ المُنْزَلِ",5,"ل",1,0],["لو أدرَجُوهُ بصُحفهِ أغنتهمو","ببياضها عن خُضرةَ الأعلام",6,"م",1,0],["لو أدري أن مستقبلي .. مستقبلك..؟","ماكان نقّصني .. الغياب .. وزادني",7,"ن",2,0],["لو ادركتك عيون الغيد ناعسة","برمشة لرماك الوجد في الحال",8,"ل",1,0],["لو أدركَ النعمانَ في أيامهِ","لرأى له فضلاً على الذبياني",9,"ن",2,0],["لَو أَدرَكَ الفُصحَاء العُرب أَفحَمَها","وَقَصَّرَت عَن مَعانيهِ مَعانيها",10,"ي",3,0],["لو ادَّعتْ أنها بكتْ كَذَبت","وشاهدُ الحالِ صادقُ المنطق",11,"ق",1,0],["لوادينا القوىّ عنت وجوهٌ","عززن بالانتساب والاكتساب",12,"ب",1,0],["لو أدرج العالم فيه لاندرج","أو نسج الحرمان منه لا نتسج",13,"ج",1,0],["لو أَدرَكوا التَّصريفَ والوَهْبَ الَّذي","سُدلَتْ عليه سَتائِرُ الغاراتِ",14,"ت",1,0],["لو أدنو لأقللت العتاب ولم أزد","على أن تراني في امتداحك مطنبا",15,"ب",2,0],["لوادي النيل قد شرفت قدرا","وثوب المجد قد ألبست مصرا",16,"ر",2,1],["لو أدرك المتنبي عزمه لدرى","من سيف دولته أمضى بواتره",17,"ر",2,0],["لوادغُ أحشاءٍ يبيتُ سليمُها","ودرياقُه عذبٌ من الريقِ سائغ",18,"غ",1,0],["لو ادعى المجد سواه مدع","رد لسان المجد ذاك المدعى",19,"ع",2,0],["لو أدركت آل سحبان بلاغته","إذن لأزرت بسحبان قبائله",20,"ل",2,0],["لو ادعت بأنها إذ تنسب","تعد أمثالا لكانت تضرب",21,"ب",1,0],["لو ادّخرتم كراما بعض مالكمو","لقوة الجيش أمسى جدّ غلّاب",22,"ب",1,0],["لو أدع الشّمس عدلا وهي في حمل","لم تبرح الشّمس يوما دارة الحمل",23,"ل",1,0],["لو أدرك الأعرابُ إجهادها","ما كانت الأنثى إذاً توءد",24,"د",1,0],["لوادي الغري مقام خواه","وسر طواه بوادي طواه",25,"ه",1,1],["لو أدرناها على مَي","تٍ لكان الميتُ يطرب",26,"ب",1,0],["لو أدلت الدنيا إليّ بأمرها","أطلقت في عصب العروش بناني",27,"ن",2,0],["لو أدركوا منتهى ما","تجني لفتوك فتّاً",28,"ت",2,0],["لو أدركته الأنبياء لما ارتضت","الا به التمجيد والتقديسا",29,"س",2,0],["لو أدركت عصر الكليم بلحظها","سحرت وصيرت العباد عبادها",30,"د",3,0],["لو ادركته النصارى كان ملتها","ولم نجد غيرها من سائر الملل",31,"ل",1,0],["لو أدركَ اللاحظونَ صورتَهُ","يوماً لقالوا المسيحُ قد رَجَعا",32,"ع",2,0],["لو أدركوا قيمة الإنسان ما جمحت","بهم لمقتل حر نزوة الأرب",33,"ب",1,0],["لو أدركت مكنون إحساسه","لأرسلت بالدمع آماقها",34,"ق",3,0],["لَوْ أَدْرَكَتْهُ يَدُ الفَنَّانِ عَاشِقَةً","لخَلَّدَتْهُ وَ زَادَتْ في تَسَامِيهِ",35,"ي",2,0],["لو أدرك الباغون شرّ فعالهم","ماسيق منهمو فاجر ٌ محتالُ",36,"ل",1,0],["لو أدرك الأعداءُ سرّ رجالنا","ما ضلّ منهم معتد ملعونُ",37,"ن",1,0],["لو أدركوا ثمن الحياة لأرخصوا","في سوقك الأرواح والأموالا",38,"ل",2,0],["لَو أَدرَكَتْكَ الحَادِثَاتُ بِمَنْطِقٍ","لَتَوَسَّلتْ مِنْ كَفِّكَ التَقْبِيْلا",39,"ل",2,0],["لو أدري إنه مرافقني على حاجه","لأمسّكه حاجته.. وأقول : فارقني",40,"ن",2,0],["لو أدع الله إياها أمانته","لنالهنّ على إستيداعها ندم",41,"م",1,0],["لو أدانيكَ باكرتني شجونٌ","أوْجَعتْني فما الذي أقصاكَ",42,"ك",1,0],["لو أدرك المحجوب في لفظها","لم يحتلف في المعجز المنزل",43,"ل",1,0],["لَو أَدرَكَ الأغنياءُ البُؤسَ لارتَدَعوا","وَاستَعظموا الفَرقَ بَينَ الجِدِّ وَاللَّعِبِ",44,"ب",1,0],["لَو أَدرَكَ المرءُ أَنَّ المالَ تارِكُهُ","لَمَلَّ صُحبَةَ خَوّانِ الوِدَادِ عَمي",45,"م",2,0]]}