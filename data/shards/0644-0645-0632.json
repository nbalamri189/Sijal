{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[309,"ما بال جيراننا بالبان","https://www.aldiwan.net/poem16823.html","مخلع البسيط"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56192","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27414","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27259","الطويل"],[4929,"صحن الفول","https://www.poetsgate.com/ViewPoem.aspx?id=208721",""]],"verses":[["لَمَزؤودٍ تَقاذَفُهُ المَطايا","وَيُسنِدُهُ إِلى ظَهرٍ حَسيرِ",0,"ر",1,0],["لمزَّقتُ وَجهاً بالخديعةِ باسِماً","ولا شيتُ ثَغراً بالضَغينةِ مُفترّا",1,"ر",2,0],["لمزقت قلبي الأحزان","وذبت من شدة الكرب",2,"ب",1,0],["لمزايا خصَّك الله بها","أكثرَ الناسُ لها شكراً وحمدا",3,"د",2,0],["لمزيد أمنٍ فيه أشرق منك مع","عدل به لولاك كاد يُبادُ",4,"د",1,0],["لمزيد الأجرِ وافينَ المقاما","وبمغناه طرحنَ القتبا",5,"ب",2,0],["لمزجه برحمته لم تضق","فهي لدي بطشي كالخدش",6,"ش",1,0],["لمزدَلفِ الحجاجِ أعلمت ناقتي","لأنعمَ بالزُّلفى وألحقَ بالجنسِ",7,"س",1,0],["لمزجة البصل المحروق رائحةٌ","تُحيِي شهية من سُدَّتْ مشاهيه",8,"ي",2,0]]}