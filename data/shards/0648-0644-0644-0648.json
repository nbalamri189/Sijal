{"poems":[[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[32,"أمن دمنة بالجو جو جلاجل","https://www.aldiwan.net/poem29571.html","الطويل"],[49,"أقلي فأيام المحب قلائل","https://www.aldiwan.net/poem25203.html","الطويل"],[49,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[53,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[87,"مقادير من جفنيك حولن حاليا","https://www.aldiwan.net/poem7584.html","الطويل"],[45,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[50,"خذ العيش الهني من المجوس","https://www.aldiwan.net/poem66598.html","الوافر"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[82,"ما للوشاة ِ عليها أذكتِ الحَدَقا","https://www.poetsgate.com/ViewPoem.aspx?id=3423",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[119,"نسخت بحبي آية العشق من قبلي","https://www.aldiwan.net/poem40612.html","عموديه"],[266,"هل المجد إلا دوحة أنت فرعها","https://www.aldiwan.net/poem38142.html","الطويل"],[422,"يا قلب هل لك في السلو","https://www.aldiwan.net/poem53909.html","مجزوء الكامل"],[463,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[473,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[563,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[572,"كتبت وعندنا ورد وراح","https://www.aldiwan.net/poem69747.html","الوافر"],[591,"أوائل حب ما لهن أواخر","https://www.aldiwan.net/poem17524.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86601","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48508","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129529","المتقارب"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100566","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59110","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64883","الهزج"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136781",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108831","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141356","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125376","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[2668,"","https://poetry.dctabudhabi.ae/diwan/poem/105581","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109851","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118825","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132534","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100806","البسيط"],[3453,"","https://poetry.dctabudhabi.ae/diwan/poem/203557","المتقارب"],[3480,"","https://poetry.dctabudhabi.ae/diwan/poem/202493","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48315","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91329","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91274","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91603","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66547","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135899","الرجز"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105566","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101355","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86370","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86404","الطويل"],[4074,"","https://poetry.dctabudhabi.ae/diwan/poem/204145","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136521",""],[4343,"","https://poetry.dctabudhabi.ae/diwan/poem/123794","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83125","السريع"],[4755,"لصوتك حين يرجعه صداه","https://www.poetsgate.com/ViewPoem.aspx?id=199194",""],[4578,"نهي بك الأيام والبشر شامل","https://www.poetsgate.com/ViewPoem.aspx?id=49506",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["وَلِلوَحشِ وَالجَنّانِ كُلَّ عَشِيَّةٍ","بِها خِلفَةٌ مِن عازِفٍ وَبُغامِ",0,"م",1,0],["وَلِلُؤمِ في صَدرِ اِمرِئِ السوءِ مَخدَعٌ","إِذا حُنِيَت مِنهُ عَلَيه ضُلوعُ",1,"ع",1,0],["وَلِلوَفرِ مِتلافٌ وَلِلحَمدِ جامِعٌ","وَلِلشَرِّ تَرّاكٌ وَلِلخَيرِ فاعِلُ",2,"ل",1,0],["وَلِلوُرّاثِ إِرثُ أَبي وَجَدّي","جِيادُ الخَيلِ وَالأَسَلِ الطِوالِ",3,"ل",1,0],["وللوصايا والنهَى مُدارسه","وللعلوم كلها مُداوِسه",4,"س",2,0],["وللودّ دل لا يكدِّر صفوه","ولكن كثيرا ما يغر الأعاديا",5,"ي",2,0],["وَلِلواجِدِ المَكروبِ مِن زَفَراتِهِ","سُكونُ عَزاءٍ أَو سُكونُ لُغوبِ",6,"ب",1,0],["وللوَلِيَّيْنِ مِنْ قَبْلِي فَشِعْرُهُمَا","أَبَانَ للشُّعَرَاءِ اللاحِبَ الجَدَدَا",7,"د",2,0],["وللوشاةِ عيونٌ غير واقعةٍ","عَلى ضَجيعَينِ مِنَّا في الكرى اعتَنَقا",8,"ق",2,0],["وللَوحْيِ بُرهانٌ ألَدٌّ خِصامُهُ","ولكنّهُ إن لم تُؤيّدْهُ يُخْصَم",9,"م",1,0],["وللوجَناتُ أفرسُهنّ أشهى","من الفرَس الفريس إلى الفريس",10,"س",1,0],["وللوَفْدِ أعطانٌ وللرَّكْبِ مَنزِلٌ","وللزَّوْرِ أوطانٌ وللحَمْدِ مَبْسِمُ",11,"م",1,0],["وللوشاة ِ عيونٌ غير واقعة","ٍ على ضجيعين من في الكرى اعتنقا",12,"ق",2,0],["وَلِلوارِثِ الباقي مِنَ المالِ فَاِترُكي","عِتابي فَإِنّي مُصلِحٌ غَيرُ مُفسِدِ",13,"د",1,0],["وللوجد فتيان كرام نفوسهم","منزهة الحالين بالقول والفعل",14,"ل",1,0],["وللورق في الأوراق لحن مرجع","واعذب من لحن الأغاريد رجعها",15,"ع",3,0],["وللوعتي وتجلُّدي","في الحبّ إيجاب وسلبُ",16,"ب",1,0],["ولَلْوُدّ يخلطني بالنفو","س أحظى لديَّ من النائلِ",17,"ل",1,0],["وَلِلَوزِنا وَلِنَبقِنا","طَعمُ اِجتِنابِ الإِجتِنابِ",18,"ب",1,0],["وللوجه كان الروح مرآته التي","تلوح بها آثاره والمقاصد",19,"د",1,0],["وللوسْمِيِّ بالقَطْرِ ابْتِدَارٌ","وللشَّرْب ابْتِهَاج وَارْتِيَاحُ",20,"ح",1,0],["وَلِلْوَجْدِ ما أَنْشَا لِسَاني ومَدْمَعِي","وَلِلْودِّ ما ضمَّت عليه السَّرائِرُ",21,"ر",1,0],["وللوهم بالعقل المحيط مبكتا","فإن لكون الجسم في الأرض منبتا",22,"ت",2,0],["وَلِلوارد الظَمآن ماءُ علومِه","فُراتٌ وَماء المدّعين سَراب",23,"ب",1,0],["وللوفود ازدحام تحت عرشك لم","يضق به بابك العالي ومحتشد",24,"د",1,0],["وللورق صدح بأفنانها","كألحان داود يتلو الزبورا",25,"ر",2,0],["وللوجوه الناظرات نظرةً","لساحة القدس وآثار الحبا",26,"ب",2,0],["وَلِلْوِشَاحِ اعْتِنَاقٌ مَعْ مَعَاطِفِهَا","أمَا رَأيْتَ اعْتِنَاقَ اللاَّمِ بِالألِفِ",27,"ف",1,0],["وللوط وللخليل وموسى","ولعيسى الفتى ويحيى الحصور",28,"ر",1,0],["وللورق تغريد على قضب بأنها","فللبان أعراس وللطير مأتم",29,"م",1,0],["وللواحظ كرات يفر لها","كذلك الحرب كرات وفرات",30,"ت",1,0],["ولِلْواشينَ عنَّا نَوْ","مُ أَهْلِ الكَفِّ في الكَهْفِ",31,"ف",1,0],["وللورق أحاديثٌ","على الأوراقِ تمليها",32,"ي",3,0],["وللوغى من لظى أسيافه شعلٌ","لا يبرح الجيش عنها غير مشتعل",33,"ل",1,0],["وللوشاية أعوان ذوو سفهٍ","لا يأمن الجار من إفسادهم جارا",34,"ر",2,0],["وللوردِ ريحٌ واحدٌ لا يجُوزُهُ","ونشركِ ريحُ الوردِ والمسكِ والنَّدِّ",35,"د",1,0],["وللوجهِ تفسيرٌ سوى ذا كله من","الجاه والمعنى من الفعل فانحسم",36,"م",1,0],["وللوحي تفسيرٌ ثلاثةُ أوجهٍ","فوجهانِ منهُ بالرسالةِ واللهم",36,"م",1,0],["وللورد ماء الورد فرع يزينه","ولليث شبل الليث مثل يقارب",37,"ب",1,0],["وللورد شوك يمنع الناس قطفه","وحاشاك من شوك على ذلك القد",38,"د",1,0],["وللورد ريح واحد لا يجوزه","ونسرك ريح العطر والورد والند",38,"د",1,0],["وللوفود حقوق أنت تعرفها","وأنت تعرف حق الضيف والخدم",39,"م",1,0],["وللوطن المحبوب يبذل واهباً","نفائس ما جادت عليه مواهبه",40,"ب",2,0],["وللوزير الذي أطراك عن ثقة","مدح على صفحات البرقِ منقول",41,"ل",1,0],["وللواو بابٌ إلى جنبه","من المقت أحسبه قد لعن",42,"ن",1,0],["وللود ما بين الأخلاء شاهد","أحاديثهم عند المغيب تراجمه",43,"م",2,0],["وللوَخْدِ طِرْفٌ ما كَفَفْنا جِماحَهُ","فجالَ بمَيْدانِ التّصابي وهَمْلَجا",44,"ج",2,0],["وَللوُرقِ أَلحانٌ أَهاجَت مِن الهَوى","قَديماً وَقَد ماسَت من الرَوضة المُلْد",45,"د",1,0],["وَللورد وَجناتٌ وَللطلّ أَدمعٌ","يَكفكفها مَنثورها بِالأَصابع",46,"ع",1,0],["وَللورد خدٌّ بِهِ حمرةٌ","وَللغصنِ قَدٌّ زَهى بِالميس",47,"س",1,0],["وللوجنتين احمرار ندٍ","بما من رؤائهما أشربا",48,"ب",2,0],["وَلِلْوَحْشِ سِرْبٌ بِقيعانِها","وَلِلطَّيْرِ فِي جَوِّها سَطْرُ كاتِبْ",49,"ب",1,0],["وللوباءِ فاصرفنَّ بالكمالْ","يا هو عنا في جميع كلِّ حالْ",50,"ل",1,0],["وللوفد قوض قوض الجود والندى","وصوح نبت القاع والورق النضر",51,"ر",1,0],["وللورقاء في الأوراق صدح","فمن بم يقرطنا وزير",52,"ر",1,0],["وللورد من خلقه نفحة","وفي أذفر المسك منها عبق",53,"ق",1,0],["وللود عندي حرمة لا أطيعها","حفظت إذا لم يرع غيري دمامها",54,"م",3,0],["وللورى موتة في الدهر واحدة","ولي من الهم والأحزان موتات",55,"ت",1,0],["وللوردِ خدٌّ بالبنفسجِ معذرٌ","ونرجسهُ طرفٌ رَنا بفتورِهِ",56,"ر",2,0],["وللوردِ خدُّ للحياءِ مُوَرَّدٌ","وللبانِ قَدٌ جيدُهُ أَبداً يَعْطو",57,"ط",2,0],["وللوداع بعده تطوفوا","وما عليهم لمليكهم وفوا",58,"ف",3,0],["وللوَجد شملٌ في فؤادي مجمعٌ","وشملُ اصطباري بالصُدود مُشتت",59,"ت",1,0],["وللورد خدّ قد حكى بروائه","محياً ابن صدّيق النبي أبي بكر",60,"ر",1,0],["وَللوشاياتِ بِها دَولَةٌ","يَزيدُ فيها الشَرُّ مِن جُندِهِ",61,"د",2,0],["ولِلوَلَهِ الذي حَمَلَتْهُ رُوحِي","كَحَسْرَةِ عازِفٍ بُتِرَت يَدَاهُ",62,"د",3,0],["وللورق في الأوراق سجعٌ تعيده","فنبدي به دري الهنا وتواصل",63,"ل",1,0],["وللوطنِ المُضمّخِ بالضّحايا","وللشّهدَا ألوفاً في ألوفِ",64,"ف",1,0],["وللواصلاتِ الناكصاتِ ولايد","خيولٌ تراءتْ حيثما لا خيولُ",65,"ل",1,0],["وللوعيد يا عيون فاهمعي","فانما الله شديد النقم",66,"م",1,0],["وللوالدين والأهالي وإخوتي","وإخواننا في الله رفقة صحبتي",67,"ت",2,0]]}