{"poems":[[55,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[75,"يا سؤل نفسي إن أحكم","https://www.aldiwan.net/poem11872.html","مجزوء الكامل"],[95,"جلس الأمير إلى الطعام عشية","https://www.aldiwan.net/poem11380.html","الكامل"],[48,"كيف يصفو المقيم في أم دفر","https://www.aldiwan.net/poem23583.html","الخفيف"],[124,"سيل همومي قد طغى عبابا","https://www.aldiwan.net/poem49337.html","الرجز"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[214,"يا حبيبي يوسف ظهر لك نور","https://www.aldiwan.net/poem13487.html","الطويل"],[352,"أنضيت هرتي الغضبى وجدياني","https://www.aldiwan.net/poem20761.html","البسيط"],[353,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[464,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[554,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[554,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[554,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[561,"يا صاحب الجهل المركب","https://www.aldiwan.net/poem34920.html","مجزوء الكامل"],[561,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[578,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28943","الطويل"]],"verses":[["وَبَزلاءَ مِن جُندِ اللَيالي لَقيتُها","بِقَلبٍ بَعيدِ العَزمِ فيها قَريبِهِ",0,"ب",2,0],["وَبِزَعمِهِم أَن لَيسَ مِثلي","في الرِضى بِالدونِ يُعذَر",1,"ر",1,0],["وَبِزَعْمِهِ أَنَّ الطَّبِيبَ نَهَاهُ عَنْ","غَيْرِ الحَلِيبِ فَإِنْ يُخَالِفُ يَنْدَمِ",2,"م",1,0],["وَبُزاةُ الأَنيسِ تَختَطِفُ اللَذ","ذاتِ لَو سُلِّمَت لِمُختَطِفيها",3,"ي",3,0],["وبز هذي الأنفس الصعابا","أرواحها وأولغ الذئابا",4,"ب",2,0],["وَبِزوجاتكَ الألى عمّهنَّ ال","فَضلُ إِذ ضمّهنّ منك البناءُ",5,"ا",2,0],["وبزوجِ النورَين خير حييٍّ","منهُ يأتي الملائك اِستحياءُ",5,"ا",2,0],["وبزخرف صف العذار اسبيت","كل الأحزاب أتوا إليك فرقان",6,"ن",1,0],["وَبُزُّ عنهُ إهابٌ كان مُمتلئاً","شَحماً وَلَحْماً كَدُرٍّ فَوقَ مَرْجانِ",7,"ن",1,0],["وَبِزِنّاري بِخَصري","إِذا لَهُ حَلٌّ وَعَقدُ",8,"د",1,0],["وبَزَّ الكَرى والأمن اِدمان سيره","نهاراً وليلاً فهو خشيانُ ساهِرُ",9,"ر",1,0],["وبُزّتِ الأسلابُ أو تمَخّضَتْ","بلا تمامٍ بطنُ كلِّ حامِلِ",10,"ل",1,0],["وبزمزمٍ والكارعي","ن لما بها نهلوا وعَلُّوا",11,"ل",3,0],["وبزفرةٍ شهد العذولُ بأنّها","من حاملٍ ثِقْلَ الهوى ملهوفِ",12,"ف",1,0],["وبزعمه حرنا على الد","دمع قطَّرَهُ وسكَّبْ",13,"ب",1,0],["وبزهد وعفة وخشوع","وعلوم بها العقول تحار",14,"ر",1,0],["وبزَّني عقْلي أَلْتفِت","واسْتَلَبَ القلْبَ فَلَم أَكْره",15,"ر",2,0],["وبَزَي وأثوابي ورَحلي لذكرِهِ","وماليَ لو يجدي فدى لك من بَذلِ",16,"ل",1,0]]}