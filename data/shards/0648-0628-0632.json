0","المتقارب"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137945",""],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100497","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132158","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131233",""],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103790","المجتث"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135232","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94547","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198226","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28943","الطويل"],[4929,"غزوة مؤتة","https://www.poetsgate.com/ViewPoem.aspx?id=199493",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5183,"الموقف الحق","https://www.poetsgate.com/ViewPoem.aspx?id=180156",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""]],"verses":[["وَبَزلاءَ مِن جُندِ اللَيالي لَقيتُها","بِقَلبٍ بَعيدِ العَزمِ فيها قَريبِهِ",0,"ب",2,0],["وَبِزَعمِهِم أَن لَيسَ مِثلي","في الرِضى بِالدونِ يُعذَر",1,"ر",1,0],["وَبِزَعْمِهِ أَنَّ الطَّبِيبَ نَهَاهُ عَنْ","غَيْرِ الحَلِيبِ فَإِنْ يُخَالِفُ يَنْدَمِ",2,"م",1,0],["وَبُزاةُ الأَنيسِ تَختَطِفُ اللَذ","ذاتِ لَو سُلِّمَت لِمُختَطِفيها",3,"ي",3,0],["وبز هذي الأنفس الصعابا","أرواحها وأولغ الذئابا",4,"ب",2,0],["وَبِزوجاتكَ الألى عمّهنَّ ال","فَضلُ إِذ ضمّهنّ منك البناءُ",5,"ا",2,0],["وبزوجِ النورَين خير حييٍّ","منهُ يأتي الملائك اِستحياءُ",5,"ا",2,0],["وبزخرف صف العذار اسبيت","كل الأحزاب أتوا إليك فرقان",6,"ن",1,0],["وَبُزُّ عنهُ إهابٌ كان مُمتلئاً","شَحماً وَلَحْماً كَدُرٍّ فَوقَ مَرْجانِ",7,"ن",1,0],["وَبِزِنّاري بِخَصري","إِذا لَهُ حَلٌّ وَعَقدُ",8,"د",1,0],["وبَزَّ الكَرى والأمن اِدمان سيره","نهاراً وليلاً فهو خشيانُ ساهِرُ",9,"ر",1,0],["وبُزّتِ الأسلابُ أو تمَخّضَتْ","بلا تمامٍ بطنُ كلِّ حامِلِ",10,"ل",1,0],["وبزمزمٍ والكارعي","ن لما بها نهلوا وعَلُّوا",11,"ل",3,0],["وبزفرةٍ شهد العذولُ بأنّها","من حاملٍ ثِقْلَ الهوى ملهوفِ",12,"ف",1,0],["وبزعمه حرنا على الد","دمع قطَّرَهُ وسكَّبْ",13,"ب",1,0],["وبزهد وعفة وخشوع","وعلوم بها العقول تحار",14,"ر",1,0],["وبزَّني عقْلي أَلْتفِت","واسْتَلَبَ القلْبَ فَلَم أَكْره",15,"ر",2,0],["وبزمزم لو كان يخلط ريقه","لأتت من الماء الفرات بأعذب",16,"ب",1,0],["وَبَزَّنيَ السَّقامُ جديدَ عيشي","وأسلمني إلى العيشِ اللبيس",17,"س",1,0],["وَبِزُهدٍ فيما بِأَيدي البَرايا","وَعَفافٍ مُشاهَدٍ بِالعَيانِ",18,"ن",1,0],["وبزوْراتٍ على مَهَلٍ","منه عافاه مُعَافيه",19,"ي",2,0],["وبزوجه وببنته وببعلها","وآبنيهما وبعمه العباس",20,"س",1,0],["وَبِزَحْفِهَا الأَنْهَارُ مَا مِنْ مَصَّةٍ","فِيهَا تُبَرِّدُ غُلَّةَ المَصَّاصِ",21,"ص",1,0],["وبزجرها بسياط قنفذ وشحّت","بالطف في زجر لهن متون",22,"ن",1,0],["و( بزايد) الخيرات تهتف يعرب","والقدس قد صاغ المديح قصيدا",23,"د",2,0],["وبزت سرابيله عنوةً","فألفي لما تعرى تحلى",24,"ل",2,0],["وبز السرابيل عن أفرخٍ","تخال بها فلذ الأسنمه",25,"م",2,0],["وبزّ أخاهُ النهار المتوعَ","وكالليث صال عليهِ وكر",26,"ر",1,0],["وِبَزْرُهُ يُزِيلُ حُرْقَ البَوْلِ","لِبَائِتٍ من أَجْله فِي هَوْل",27,"ل",1,0],["وِبَزْرُه مُفَتِّتُ الحَصَاةِ","بِسُكَّر أوِ الْجَوَارِشَاتِ",27,"ت",1,0],["وَبِزْرُهُ مِنْ أَفْضَلِ النَّبَاتِ","مُدِرُّ بَوْلٍ مُخْرِجُ الحَصَاة",27,"ه",1,0],["وبزورة المختار نال الغابة ال","قصوى التي عنها الكواكب تقصر",28,"ر",1,0],["وبزنبق الوادي وفيض","الساقيات وقد هدر",29,"ر",1,0],["وبزرت مختالا يحفك فيلقٌ","ملأت كتائبه الفضاء لهام",30,"م",1,0],["وبزر كتان اوفى","بكل وهد ونجد",31,"د",1,1],["وبزجٍّ للغيث زَجّاً وغيثاً","راحماً يأتي باشتهار شهيرُ",32,"ر",1,0],["وبزند ذوقليونٍ البطل","وأرى السنان بمجمع العضل",33,"ل",1,0],["وبزوج الكرّار أمّهما من","لقبت بالبتول والزهراء",34,"ا",2,0],["وبز الملوك الصيد أسلاب عزهم","فاضحوا له فوق البسيطة سجدا",35,"د",2,0],["وبزالت الأتراح عنا","منشد الألحان انشد",36,"د",1,0],["وبزفهِ قال المؤرخ أُمَّتي","بسما الأعالي قارن الشمس القمر",37,"ر",1,0],["و((بزائدِ))الأفراحُ قد عمَّتْ لنا","وَ((بعيدِهِ))غُصْنُ الفَضائِلِ تُورقُ",38,"ق",1,0],["وبَزَي وأثوابي ورَحلي لذكرِهِ","وماليَ لو يجدي فدى لك من بَذلِ",39,"ل",1,0],["وبزَندِ سيف الله ثم بعقلِهِ","فرَ العدوُّ وملؤُه الإعياءُ",40,"ا",2,0],["وبزر قطوني والكثيري الجفا الرحى","وهنباء أيضاً والضحى وسفاء",41,"ا",2,0],["وبزه ما قد تجلى له","فعزه الصاحب بالجنب",42,"ب",1,0],["وبزدراءٍ على البصَّار أنظره","وما بعقلي لتنجيمٍ بتأييدِ",43,"د",1,0],["وبزاويتهِ قد بني نعم ألبنا","هل لا وذا وعدٌ من الرحمنِ",44,"ن",1,0],["وَبِزَوْجَةٍ كَانَتْ لِعُمْرَانِ النَّبِيْ","فِي ذِكْرِهَا طَرَفٌ مِنَ الْإيرَادِ",45,"د",1,0],["وَبِزَحْفِ كُلِّ المُسْلِمِينَ عَلَى هُدىً","مِنْ رَبِّهِمْ لاَ مِنْ مَزَارِعِ (سَامِ)",46,"م",1,0]]}