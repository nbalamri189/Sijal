{"poems":[[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63874","المنسرح"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49995","المنسرح"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27110","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117956","الرمل"],[5121,"لاَ شَيْء","https://www.poetsgate.com/ViewPoem.aspx?id=213488",""]],"verses":[["بين ظلالِ النعيمِ مُكْتَنَفٌ","وفي بحارِ السُّرورِ مغموس",0,"س",1,0],["بين ظباء الحمى تصيّدنا","سهامُ طَرفٍ قِسيّها الحدَق",1,"ق",1,0],["بَين ظالِمٍ إِن تَظلِموني فَإِنَّني","إِلى صالِحِ الأَقوامِ غَيرُ بَغيضِ",2,"ض",1,1],["بَينَ ظبىً لَو رأَيتنا وَقَنا","نسحب مِن ذي وَذي تجرّدها",3,"د",3,0],["بين ظهرانيكم الملك الذي","كلّف الباغي ابتلاع الحسك",4,"ك",1,0],["بَيْنَ ظِلٍّ وَبَيْنَ وَهْمٍ أَرَانِي","وَطُيُوفٌ تُمَوِّهُ الْمِصْبَاحَاَ",5,"ح",2,0]]}