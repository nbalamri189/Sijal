ab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6072,"دَوّامات الندى والغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85443&r=&rc=30",""],[463,"بكرتْ هيماً تحلُّ الرَّبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60115&r=&rc=171",""],[6260,"حنين إلى الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68319&r=&rc=11",""],[6291,"فتوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87670&r=&rc=3",""],[6304,"ضفاف الغدير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1614&r=&rc=4",""],[5164,"ذُلُّ الهَوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75663&r=&rc=17",""],[6320,"ثَلْجُ الجَحِيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83636&r=&rc=17",""],[6334,"في الرمل حمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82250&r=&rc=0",""],[6345,"صقيع ماض ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78658&r=&rc=29",""]],"verses":[["ظَمائي إِلى مَن لَو أَرادَ سَقاني","وَديني عَلى مَن لَو يَشاءُ قَضاني",0,"ن",2,1],["ظَمأى إِلَيكَ وَأَينَ عَنكَ مَحيدُها","وَالرَعيُ عِندَكَ وَالرُوا وَالمَرتَعُ",1,"ع",1,0],["ظَمآنَ سَلّى نَجيعُ الطَعنِ غُلَّتَهُ","عَن بارِدٍ مَن عُبابِ الماءِ مَقرورِ",2,"ر",1,0],["ظَمِئَتْ إِلَى السُّقْيَا الأَبَاطِحُ وَالُّربَى","حَتَّى دَعَوْنَا الْعَامَ عَاماً مُجْدِبَا",3,"ب",2,1],["ظمئاً ما لغله","من ندى الدمع مرتوي",4,"و",2,0],["ظمئت إلى تقبيل كفٍّ كريمةٍ","تكادُ بها الأقلام تعشب باللمس",5,"س",1,1],["ظِماء إلى وِرد الدماء نواهلٌ","لها مورد من غير مأتاهُ نَصدُر",6,"ر",1,0],["ظمِئْتُ إلى النُّورِ فوقَ الغصونِ","ظمِئْتُ إلى الظِّلِّ تحتَ الشَّجَرْ",7,"ر",1,0],["ظمِئْتُ إلى النَّبْعِ بَيْنَ المروج","يغنِّي ويرقصُ فوقَ الزَّهَرْ",7,"ر",1,0],["ظمِئْتُ إلى نَغَماتِ الطُّيورِ","وهَمْسِ النَّسيمِ ولحنِ المَطَرْ",7,"ر",1,0],["ظمِئْتُ إلى الكونِ أَيْنَ الوجودُ","وأَنَّى أَرى العالَمَ المنتظَرْ",7,"ر",1,0],["ظمأ البلاد غليك في هذى النوى","ظمأ النبات إلى الغمام النائى",8,"ا",2,0],["ظَمِئَ الحُرُّ لِلدِيارِ وَإِن كا","نَ عَلى مَنهَلٍ مِنَ الخُلدِ دائِم",9,"م",1,0],["ظَمِئتُ وَمِثلي بَرِيٍّ أَحَقُّ","كَأَنّي حُسَينٌ وَدَهري يَزيد",10,"د",1,0],["ظِماءٌ إِلى ماءِ الوريدِ وإنَّها","ليطغَى بها حَدٌّ من الماء مُتْرَعُ",11,"ع",1,0],["ظَمِأَت مَراشِفُنا إِلَيهِ وَرَيُّها","في ذَلِكَ اللَعسِ المُمَنَّعِ وَاللَمى",12,"م",2,0],["ظَمِئَت مَضارِبُ غَفرَتَيهِ فَأَصبَحَت","مِن عَدَمِ اللَهَواتِ ذاتَ لَماظِ",13,"ظ",1,0],["ظَمآنَةٌ لِلقاكَ وَهيَ رَوِيَّةٌ","بِبِدائِعٍ تَروي غَليلَ رُواتِها",14,"ت",3,0],["ظمآن حين الماء ليلى وحدَها","عزَّت عليه ولمَ تُتح لظماءِ",15,"ا",2,0],["ظمأٌ على ظمأ على ظمأ","ومواردٌ كثرٌ ولم أردِ",16,"د",1,0],["ظمآن لو باع الأحبة قطرة","بالعمر والدنيا جميعاً لا شترى",17,"ر",2,0],["ظَمآنُ يَستسقي أُجاجَ دموعِهِ","من عارِضِ البَرِد الشنيبِ زلالا",18,"ل",2,0],["ظمأى إلى غدرانِهِ ورياضِهِ","ظمأٌ يزيد القلبَ منهُ تأججا",19,"ج",2,0],["ظِماءٌ تُريدُ الرِيَّ مَن ذا يَذودُها","أَتُوزَعُ والأقوامُ شَتَّى ورُودُها",20,"د",3,1],["ظَمِئَت جَوانِحُهُ إِلى حَرِّ الوَغى","فَسَقَتهُ شُؤبوبَ النَجيعِ القاني",21,"ن",2,0],["ظَمِئَت إِلى وِردِ الأُسودِ نُفوسُهُم","وَالمَوتُ يَنقَعُ غُلَّةَ الظَمآنِ",21,"ن",1,0],["ظَمِئتِ من سعدٍ إلى نظرةٍ","تُطفِئُ حَرَّ اللاعجِ المشعَل",22,"ل",1,0],["ظَمِئْتَ سيوفُكَ يا مُحمّدُ فَاسْقِها","من خيرِ ما تُسقَى السُّيوفُ وتُنضَحُ",23,"ح",1,0],["ظَمِئتُ مِنكَ لِوَعدٍ","فَكانَ وِردي السَرابا",24,"ب",2,0],["ظَمِئتُ إِلَيها فَلَم تَسقِني","بِرِيٍّ وَلَم تَشفِني مِن سَقَم",25,"م",1,0],["ظَمِئتُ فَلَم أَظمَأ إِلى بَردِ مَشرَبٍ","وَلَكِن إِلى وَجهِ الحَبيبِ ظَميتُ",26,"ت",1,0],["ظَمآى إِلى وِردِ الحَياةِ فَإِن تَرِد","تَرِدِ المَنِيَّةَ في لُعابِ الأَرقَمِ",27,"م",1,0],["ظمئت فَلَم تنقع أواميَ دجلة","وَللناس في بغداد من دجلة ورد",28,"د",1,0],["ظمأي قاتلي فما حَذري","مَوردي منكِ مَوْردَ العَطَبِ",29,"ب",1,0],["ظَمِئتُ إِلَى صافِي الهَواءِ وَطَلقِهِ","فَهَل لي يَوماً في رِضاكَ ورُودُ",30,"د",1,0],["ظَمْآنُ يَطْلُبُ رِيَّهُ","جَوْعَانُ يَلْتَمِسُ الْغِذَاءْ",31,"ا",2,0],["ظَمْأَى إِلَى المَوْتِ رَيَّا","مِنَ الأَسَى وَالْبِعَادِ",32,"د",1,0],["ظَمْأَى إِلَيْهَا حِينَ ضَرَّجَهَا","لَوْنُ الحَيَاءِ وَزَانَهَا الخَفَرُ",33,"ر",1,0],["ظمآن والأهواء جارية","كالسلسبيل، مسى يرد يرد",34,"د",1,0],["ظمِئتَ فكيفَ خانَتْكَ السواقي؟","وهمتَ .. فأينَ أوديةُ العِراقِ؟",35,"ق",1,1],["ظمِئْتُ ومُنْهَلُّ المَدامِعِ مَنْهلي","ولا حَوْم لِي إِلّا عَلى ورْدِ حَوْمَلِ",36,"ل",1,1],["ظَمِئت إِذ حالَ دونَ وِردي","صرفُ زَمانٍ لَهُ عِظاظُ",37,"ظ",1,0],["ظَمِئتُ إِلى اللُقيا وَفي الحَشرِ نَلتَقي","فَيا سَلسَبيلي ما إِلَيكَ سَبيلُ",38,"ل",1,0],["ظَمِئتُ وَما يَشفي لي الماءُ غلَّةً","وأشوى كَأَنّي لِلزَّفيرِ أَقيظُ",39,"ظ",1,0],["ظمئت، وأخطأها الروى","فكأنّ زهوتها أهانْ",40,"ن",1,0],["ظِماءٌ إلى ماءٍ بدِجْلةَ سَلْسَلٍ","تودُّ بنور العين لو رأتِ الوِردا",41,"د",2,0],["ظَمِىءَ الشْعرُ للثناءِ فهل آ","نَ له أن يفيضَ شكراً وحمدا",42,"د",2,0],["ظمآنَ، هام بقطرة معسولة","من نيل مصر فما استطاع ورودا",43,"د",2,0],["ظمآن يرتشف الجمال وكلّما","أروي أواما صاح فيه أوام",44,"م",1,0],["ظمآنَ لاوِردٌ سواه فَينثنى","عنه ولا يسطيع خوض مَخوفه",45,"ف",2,0],["ظَمِئَتْ مَرَاشِفُنَا إلَيهِ، وَرَيُّهَا","في ذلكَ اللَّعَسِ المُمَنَّعِ واللَّمَى",46,"م",2,0],["ظمأى ويندى ثراها لوعة وهوى","إذا ألمّ بها من غربتي خبر",47,"ر",1,0],["ظمأى إلى القبل الأثيمة عذبة","كالبابليّ مريرة كالصّاب",48,"ب",1,0],["ظمأى حيارى وخلف الركب طائفة","حمر اللواحظ من أسد وذؤبان",49,"ن",1,0],["ظمأى تسير على الخضمّ مجرجرا","سير الذلول ولا تبلّ أوارها",50,"ر",3,0],["ظمىء الحرُّ للديار، وإن كا","ن على منهلٍ من الخلد دائم",51,"م",1,0],["ظَمأي أَراني الناس ماءً سُغتَهُ","غَصصاً هِيَ التَكدبر وَالتَنكيدُ",52,"د",1,0],["ظمئ ترويه قبلته","كيف ريى وهو ظمآن",53,"ن",1,0],["ظمىء إلى ماء النُّقَيْبِ لأنَّه","وِرْدُ اللَّمَى ومناهلُ الأغصانِ",54,"ن",1,0],["ظمنت له الذِّكرَ الجميلا معجلا","جدواهُ والأجر الجزيلَ مؤجلا",55,"ل",2,0],["ظَمِئتُ وأَجفانِي بدَمعِيَ فُيَّضُ","وَعِشتُ وأَضلاعي بِرُوحيَ فُيَّظُ",56,"ظ",1,1],["ظمئت روحها ولم تر كأسا","غير كاس الردى تبلّ صداها",57,"ا",3,0],["ظُماءَةُ جوفٍ أجَّ شوقاً إلى الورى","وبعضَ الظما قد يلتظي حينَ ينقعُ",58,"ع",1,0],["ظمأَ الفؤادُ إلى رضاك","ظمأ المحب إلى رضابكْ",59,"ك",1,0],["ظمآن لا ترويه إلا عبرةٌ","أو مهجة هطلت بجنبي مولعِ",60,"ع",1,0],["ظماءُ العيونِ عصرنَ القدودَ","كأنَّهُمُ عطشوا فارتَوَوا",61,"و",3,1],["ظمئنا والرياض بها حياض","بها ماء يفيض ولا يجود",62,"د",1,0],["ظمئت وما شفائي غير كأس","أعاقرها من الثغر الرشوف",63,"ف",1,0],["ظمأ قاتل يعانيه روحي","وبثغريك مورد سلسبيل",64,"ل",1,0],["ظمىء القلب إلى عهد الصيال","وإلى البلوى بعذل السفهاء",65,"ا",2,0],["ظمئت روحي إلى ورد صفاك","ظمئت عيني إلى نور سناك",66,"ك",1,0],["ظمأ الشفاه طبيعة ألهمنها","منذ ارتوين بثغرك المعسول",67,"ل",1,0],["ظمأ تؤججه القلوب خوافقاً","تنزو بعارم لهفة وغليل",67,"ل",1,0],["ظَمِئَت إِلى إِشراقِ وَج","هِكِ مُقلَتي فَاِنقَع صَداها",68,"ا",3,0],["ظَمآنَ يَقذِفُ نَفسَهُ مُستَشعِراً","خَوفَ القِيامَةِ في الهَجيرِ الواغِرِ",69,"ر",1,0],["ظَمئتُ إلى تقبيل تُربةِ أحمدٍ","وحَسبي وعظُ الشَّيبِ إن لم يَكُن وعظَ",70,"ظ",1,0],["ظمأٌ يَزيدُ حَشاكِ ماءُ جُفونِها","وزَفيرُها نارٌ بها تُلظيك",71,"ك",1,0],["ظمئت مرا شفنا اليه وريها","في ذلك للعس المعسل وَاللمى",72,"م",2,0],["ظَمْآنُ رَاحَ لأُفْقِ الشَّرْق مُلْتَهِما","لَكِنْ غَدَا بِنَجِيع الجَوْفِ رَيَّانا",73,"ن",2,0],["ظَمَأي فيه ظَما آخِره","ليتين أَوَّلُه ممّا عَراني",74,"ن",2,0],["ظمان يسآل عن وِرد ينال به","ريّ الغليل وفي أجفانه النيل",75,"ل",1,0],["ظمىء السنين فجاء ينقع غلّه","لكنه لم يلق غير تباب",76,"ب",1,0],["ظَمئت أَمانيُّ الرِجال لَدى العُلى","فوردتَ منهلَها وَلَمّا تَصدُرِ",77,"ر",1,0],["ظَمأً إِلى المنهلِ المحمود موردهُ","بَداهةُ الخاطرِ المكدود تحتدمُ",78,"م",1,0],["ظمئت لمرآها النَواظر بَعدَما","وَردت مِن الحَمد المَسامِع منهلا",79,"ل",2,0],["ظَمْآنَ أم ريّانَ أم مُتوسِّطاً","لا بُدَّ من صَدَرِ الرِعّاءِ الوارد",80,"د",1,0],["ظّمِئَتْ إلى ماءِ السّماءِ جديبةً","أيامَ أصبَحتِ الخلافةُ في عَدِي",81,"د",2,0],["ظَمآنُ أَعطَشَهُ الصَبا","حُ وَإِن جَرى جَرى الزُلالُ",82,"ل",1,0],["ظَمَئِي من الثَّغرِ البَرُود فمَن رأى","ظَمآنَ من بَرْدٍ يُعلُّ بَقَرقَفِ",83,"ف",1,0],["ظماً لثناياك العِذاب وإنَّها","عَذابٌ لقلبي يا أُميمُ أليم",84,"م",1,0],["ظمياء جاءت تستقي","من نيل كف فاض يم",85,"م",1,0],["ظمِئتُ وقد يَظْمَا البعيدُ مناهِلاً","وصادَفْتُ ذاكَ العَذْبَ منك تَمَرَّجا",86,"ج",2,0],["ظِماءُ ح