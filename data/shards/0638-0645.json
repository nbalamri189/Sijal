ب ولم أفد","https://www.aldiwan.net/poem11672.html","الكامل"],[298,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[354,"المجد كبر بالسرور وهللا","https://www.aldiwan.net/poem39589.html","الكامل"],[365,"إن الذي نصب المكارم للورى","https://www.aldiwan.net/poem60939.html","الكامل"],[365,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[367,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[410,"لا تغترر بنحول خصر أهيف","https://www.aldiwan.net/poem32566.html","الكامل"],[417,"أقول لسعد حين لام على الهوى","https://www.aldiwan.net/poem53950.html","الطويل"],[430,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[433,"لجأت إلى عتباك فاستبق من لجا","https://www.aldiwan.net/poem12365.html","الطويل"],[433,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[440,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[454,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[454,"عيدان عيد تحرر وتفاؤل","https://www.aldiwan.net/poem61377.html","الكامل"],[459,"أيا بانة الغور عطفا سقيت","https://www.aldiwan.net/poem56084.html","المتقارب"],[459,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[459,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[462,"كأن بلاد الله مما أجنه","https://www.aldiwan.net/poem15131.html","الطويل"],[462,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[462,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[465,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[465,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[465,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[465,"خليلي هل من شربة تجدانها","https://www.aldiwan.net/poem3359.html","عموديه"],[465,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[465,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[465,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[559,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[563,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[563,"خلت الديار كأنها لم تؤهل","https://www.aldiwan.net/poem52933.html","الكامل"],[563,"طيف بلبنان من مصر إلي سرى","https://www.aldiwan.net/poem52958.html","البسيط"],[576,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[587,"ظمئت إلى ماء الشباب ولم يزل","https://www.aldiwan.net/poem22886.html","الطويل"]],"verses":[["ظَمائي إِلى مَن لَو أَرادَ سَقاني","وَديني عَلى مَن لَو يَشاءُ قَضاني",0,"ن",2,1],["ظَمأى إِلَيكَ وَأَينَ عَنكَ مَحيدُها","وَالرَعيُ عِندَكَ وَالرُوا وَالمَرتَعُ",1,"ع",1,0],["ظَمآنَ سَلّى نَجيعُ الطَعنِ غُلَّتَهُ","عَن بارِدٍ مَن عُبابِ الماءِ مَقرورِ",2,"ر",1,0],["ظَمِئَتْ إِلَى السُّقْيَا الأَبَاطِحُ وَالُّربَى","حَتَّى دَعَوْنَا الْعَامَ عَاماً مُجْدِبَا",3,"ب",2,1],["ظمئاً ما لغله","من ندى الدمع مرتوي",4,"و",2,0],["ظمئت إلى تقبيل كفٍّ كريمةٍ","تكادُ بها الأقلام تعشب باللمس",5,"س",1,1],["ظِماء إلى وِرد الدماء نواهلٌ","لها مورد من غير مأتاهُ نَصدُر",6,"ر",1,0],["ظمِئْتُ إلى النُّورِ فوقَ الغصونِ","ظمِئْتُ إلى الظِّلِّ تحتَ الشَّجَرْ",7,"ر",1,0],["ظمِئْتُ إلى النَّبْعِ بَيْنَ المروج","يغنِّي ويرقصُ فوقَ الزَّهَرْ",7,"ر",1,0],["ظمِئْتُ إلى نَغَماتِ الطُّيورِ","وهَمْسِ النَّسيمِ ولحنِ المَطَرْ",7,"ر",1,0],["ظمِئْتُ إلى الكونِ أَيْنَ الوجودُ","وأَنَّى أَرى العالَمَ المنتظَرْ",7,"ر",1,0],["ظمأ البلاد غليك في هذى النوى","ظمأ النبات إلى الغمام النائى",8,"ا",2,0],["ظَمِئَ الحُرُّ لِلدِيارِ وَإِن كا","نَ عَلى مَنهَلٍ مِنَ الخُلدِ دائِم",9,"م",1,0],["ظَمِئتُ وَمِثلي بَرِيٍّ أَحَقُّ","كَأَنّي حُسَينٌ وَدَهري يَزيد",10,"د",1,0],["ظِماءٌ إِلى ماءِ الوريدِ وإنَّها","ليطغَى بها حَدٌّ من الماء مُتْرَعُ",11,"ع",1,0],["ظَمِأَت مَراشِفُنا إِلَيهِ وَرَيُّها","في ذَلِكَ اللَعسِ المُمَنَّعِ وَاللَمى",12,"م",2,0],["ظَمِئَت مَضارِبُ غَفرَتَيهِ فَأَصبَحَت","مِن عَدَمِ اللَهَواتِ ذاتَ لَماظِ",13,"ظ",1,0],["ظَمآنَةٌ لِلقاكَ وَهيَ رَوِيَّةٌ","بِبِدائِعٍ تَروي غَليلَ رُواتِها",14,"ت",3,0],["ظمآن حين الماء ليلى وحدَها","عزَّت عليه ولمَ تُتح لظماءِ",15,"ا",2,0],["ظمأٌ على ظمأ على ظمأ","ومواردٌ كثرٌ ولم أردِ",16,"د",1,0],["ظمآن لو باع الأحبة قطرة","بالعمر والدنيا جميعاً لا شترى",17,"ر",2,0],["ظَمآنُ يَستسقي أُجاجَ دموعِهِ","من عارِضِ البَرِد الشنيبِ زلالا",18,"ل",2,0],["ظمأى إلى غدرانِهِ ورياضِهِ","ظمأٌ يزيد القلبَ منهُ تأججا",19,"ج",2,0],["ظِماءٌ تُريدُ الرِيَّ مَن ذا يَذودُها","أَتُوزَعُ والأقوامُ شَتَّى ورُودُها",20,"د",3,1],["ظَمِئَت جَوانِحُهُ إِلى حَرِّ الوَغى","فَسَقَتهُ شُؤبوبَ النَجيعِ القاني",21,"ن",2,0],["ظَمِئَت إِلى وِردِ الأُسودِ نُفوسُهُم","وَالمَوتُ يَنقَعُ غُلَّةَ الظَمآنِ",21,"ن",1,0],["ظَمِئتِ من سعدٍ إلى نظرةٍ","تُطفِئُ حَرَّ اللاعجِ المشعَل",22,"ل",1,0],["ظَمِئْتَ سيوفُكَ يا مُحمّدُ فَاسْقِها","من خيرِ ما تُسقَى السُّيوفُ وتُنضَحُ",23,"ح",1,0],["ظَمِئتُ مِنكَ لِوَعدٍ","فَكانَ وِردي السَرابا",24,"ب",2,0],["ظَمِئتُ إِلَيها فَلَم تَسقِني","بِرِيٍّ وَلَم تَشفِني مِن سَقَم",25,"م",1,0],["ظَمِئتُ فَلَم أَظمَأ إِلى بَردِ مَشرَبٍ","وَلَكِن إِلى وَجهِ الحَبيبِ ظَميتُ",26,"ت",1,0],["ظَمآى إِلى وِردِ الحَياةِ فَإِن تَرِد","تَرِدِ المَنِيَّةَ في لُعابِ الأَرقَمِ",27,"م",1,0],["ظمئت فَلَم تنقع أواميَ دجلة","وَللناس في بغداد من دجلة ورد",28,"د",1,0],["ظمأي قاتلي فما حَذري","مَوردي منكِ مَوْردَ العَطَبِ",29,"ب",1,0],["ظَمِئتُ إِلَى صافِي الهَواءِ وَطَلقِهِ","فَهَل لي يَوماً في رِضاكَ ورُودُ",30,"د",1,0],["ظَمْآنُ يَطْلُبُ رِيَّهُ","جَوْعَانُ يَلْتَمِسُ الْغِذَاءْ",31,"ا",2,0],["ظَمْأَى إِلَى المَوْتِ رَيَّا","مِنَ الأَسَى وَالْبِعَادِ",32,"د",1,0],["ظَمْأَى إِلَيْهَا حِينَ ضَرَّجَهَا","لَوْنُ الحَيَاءِ وَزَانَهَا الخَفَرُ",33,"ر",1,0],["ظمآن والأهواء جارية","كالسلسبيل، مسى يرد يرد",34,"د",1,0],["ظمِئتَ فكيفَ خانَتْكَ السواقي؟","وهمتَ .. فأينَ أوديةُ العِراقِ؟",35,"ق",1,1],["ظمِئْتُ ومُنْهَلُّ المَدامِعِ مَنْهلي","ولا حَوْم لِي إِلّا عَلى ورْدِ حَوْمَلِ",36,"ل",1,1],["ظَمِئت إِذ حالَ دونَ وِردي","صرفُ زَمانٍ لَهُ عِظاظُ",37,"ظ",1,0],["ظَمِئتُ إِلى اللُقيا وَفي الحَشرِ نَلتَقي","فَيا سَلسَبيلي ما إِلَيكَ سَبيلُ",38,"ل",1,0],["ظَمِئتُ وَما يَشفي لي الماءُ غلَّةً","وأشوى كَأَنّي لِلزَّفيرِ أَقيظُ",39,"ظ",1,0],["ظمئت، وأخطأها الروى","فكأنّ زهوتها أهانْ",40,"ن",1,0],["ظِماءٌ إلى ماءٍ بدِجْلةَ سَلْسَلٍ","تودُّ بنور العين لو رأتِ الوِردا",41,"د",2,0],["ظَمِىءَ الشْعرُ للثناءِ فهل آ","نَ له أن يفيضَ شكراً وحمدا",42,"د",2,0],["ظمآنَ، هام بقطرة معسولة","من نيل مصر فما استطاع ورودا",43,"د",2,0],["ظمآن يرتشف الجمال وكلّما","أروي أواما صاح فيه أوام",44,"م",1,0],["ظمآنَ لاوِردٌ سواه فَينثنى","عنه ولا يسطيع خوض مَخوفه",45,"ف",2,0],["ظَمِئَتْ مَرَاشِفُنَا إلَيهِ، وَرَيُّهَا","في ذلكَ اللَّعَسِ المُمَنَّعِ واللَّمَى",46,"م",2,0],["ظمأى ويندى ثراها لوعة وهوى","إذا ألمّ بها من غربتي خبر",47,"ر",1,0],["ظمأى إلى القبل الأثيمة عذبة","كالبابليّ مريرة كالصّاب",48,"ب",1,0],["ظمأى حيارى وخلف الركب طائفة","حمر اللواحظ من أسد وذؤبان",49,"ن",1,0],["ظمأى تسير على الخضمّ مجرجرا","سير الذلول ولا تبلّ أوارها",50,"ر",3,0],["ظمىء الحرُّ للديار، وإن كا","ن على منهلٍ من الخلد دائم",51,"م",1,0],["ظَمأي أَراني الناس ماءً سُغتَهُ","غَصصاً هِيَ التَكدبر وَالتَنكيدُ",52,"د",1,0],["ظمئ ترويه قبلته","كيف ريى وهو ظمآن",53,"ن",1,0],["ظمىء إلى ماء النُّقَيْبِ لأنَّه","وِرْدُ اللَّمَى ومناهلُ الأغصانِ",54,"ن",1,0],["ظمنت له الذِّكرَ الجميلا معجلا","جدواهُ والأجر الجزيلَ مؤجلا",55,"ل",2,0],["ظَمِئتُ وأَجفانِي بدَمعِيَ فُيَّضُ","وَعِشتُ وأَضلاعي بِرُوحيَ فُيَّظُ",56,"ظ",1,1],["ظمئت روحها ولم تر كأسا","غير كاس الردى تبلّ صداها",57,"ا",3,0],["ظُماءَةُ جوفٍ أجَّ شوقاً إلى الورى","وبعضَ الظما قد يلتظي حينَ ينقعُ",58,"ع",1,0],["ظمأَ الفؤادُ إلى رضاك","ظمأ المحب إلى رضابكْ",59,"ك",1,0],["ظمآن لا ترويه إلا عبرةٌ","أو مهجة هطلت بجنبي مولعِ",60,"ع",1,0],["ظماءُ العيونِ عصرنَ القدودَ","كأنَّهُمُ عطشوا فارتَوَوا",61,"و",3,1],["ظمئنا والرياض بها حياض","بها ماء يفيض ولا يجود",62,"د",1,0],["ظمئت وما شفائي غير كأس","أعاقرها من الثغر الرشوف",63,"ف",1,0],["ظمأ قاتل يعانيه روحي","وبثغريك مورد سلسبيل",64,"ل",1,0],["ظمىء القلب إلى عهد الصيال","وإلى البلوى بعذل السفهاء",65,"ا",2,0],["ظمئت روحي إلى ورد صفاك","ظمئت عيني إلى نور سناك",66,"ك",1,0],["ظمأ الشفاه طبيعة ألهمنها","منذ ارتوين بثغرك المعسول",67,"ل",1,0],["ظمأ تؤججه القلوب خوافقاً","تنزو بعارم لهفة وغليل",67,"ل",1,0],["ظَمِئَت إِلى إِشراقِ وَج","هِكِ مُقلَتي فَاِنقَع صَداها",68,"ا",3,0],["ظَمآنَ يَقذِفُ نَفسَهُ مُستَشعِراً","خَوفَ القِيامَةِ في الهَجيرِ الواغِرِ",69,"ر",1,0],["ظَمئتُ إلى تقبيل تُربةِ أحمدٍ","وحَسبي وعظُ الشَّيبِ إن لم يَكُن وعظَ",70,"ظ",1,0],["ظمأٌ يَزيدُ حَشاكِ ماءُ جُفونِها","وزَفيرُها نارٌ بها تُلظيك",71,"ك",1,0],["ظمئت مرا شفنا اليه وريها","في ذلك للعس المعسل وَاللمى",72,"م",2,0],["ظَمْآنُ رَاحَ لأُفْقِ الشَّرْق مُلْتَهِما","لَكِنْ غَدَا بِنَجِيع الجَوْفِ رَيَّانا",73,"ن",2,0],["ظَمَأي فيه ظَما آخِره","ليتين أَوَّلُه ممّا عَراني",74,"ن",2,0],["ظمان يسآل عن وِرد ينال به","ريّ الغليل وفي أجفانه النيل",75,"ل",1,0],["ظمىء السنين فجاء ينقع غلّه","لكنه لم يلق غير تباب",76,"ب",1,0],["ظَمئت أَمانيُّ الرِجال لَدى العُلى","فوردتَ منهلَها وَلَمّا تَصدُرِ",77,"ر",1,0],["ظَمأً إِلى المنهلِ المحمود موردهُ","بَداهةُ الخاطرِ المكدود تحتدمُ",78,"م",1,0],["ظمئت لمرآها النَواظر بَعدَما","وَردت مِن الحَمد المَسامِع منهلا",79,"ل",2,0],["ظَمْآنَ أم ريّانَ أم مُتوسِّطاً","لا بُدَّ من صَدَرِ الرِعّاءِ الوارد",80,"د",1,0],["ظّمِئَتْ إلى ماءِ السّماءِ جديبةً","أيامَ أصبَحتِ الخلافةُ في عَدِي",81,"د",2,0],["ظَمآنُ أَعطَشَهُ الصَبا","حُ وَإِن جَرى جَرى الزُلالُ",82,"ل",1,0],["ظَمَئِي من الثَّغرِ البَرُود فمَن رأى","ظَمآنَ من بَرْدٍ يُعلُّ بَقَرقَفِ",83,"ف",1,0],["ظماً لثناياك العِذاب وإنَّها","عَذابٌ لقلبي يا أُميمُ أليم",84,"م",1,0],["ظمياء جاءت تستقي","من نيل كف فاض يم",85,"م",1,0],["ظمِئتُ وقد يَظْمَا البعيدُ مناهِلاً","وصادَفْتُ ذاكَ العَذْبَ منك تَمَرَّجا",86,"ج",2,0],["ظِماءُ حروبٍ من قلوبِ عداتِهمْ","لهم قُلُبٌ والسّمهريّةُ أشطانُ",87,"ن",1,0],["ظِماءٌ وَمَا يَدْرُونَ فِي الأَرْضِ مَشْرَباً","سِوى كَبِدي الْحَرّى ومُهْجَتيَ الظَّمْيا",88,"ي",2,0],["ظِمَاءٌ وَمَا غَيْرَ الدماءِ مشارِبٌ","لَهُنَّ ولا غَيْرَ القُلُوبِ مَطَاعِمُ",89,"م",1,0],["ظمأ الشوق للملاحة والدف","ء وللنور بعد تعذيب ناقم",90,"م",1,0],["ظمئي إلى وطني ظماء معذّب","فداه لا مستثمر متمادي",91,"د",2,0],["ظمئتُ إلى أعذبِ الشربتيْن","فكلتاهما قد حوتها يداكِ",92,"ك",1,0],["ظمأ لا يتبغِّين له","مُشتَكىً إلا وسيعاتِ الخُطا",93,"ط",2,0],["ظمئنا بعدكم أسفاً وشوقاً","كما جِيدتْ بكم يُبْسُ البلادِ",94,"د",1,0],["ظماءُ القنا والبيضِ لا يشتكيهمُ","بيوم الوغى قرن الكمي ولا النحرُ",95,"ر",1,0],["ظمأى إلى الماءِ تطْويه وتنْظُرُه","مشغولةً بقراعِ القومِ عن بَللِ",96,"ل",1,0],["ظمأى إِلى ماءٍ الجِراحِ كأنما","تجري مواردُها بخَدْع سَرابِ",97,"ب",1,0],["ظمأي بمهضوم الحشا ريَّان من","ماءِ الشَّباب وخصرهُ يشكو الصّدى",98,"د",2,0],["ظمئت فكان ذاك ضامن نقعها","وشكت فكان السيف حاسم دائها",99,"ا",3,0],["ظمئت فما وردت وليس ببدعةٍ","من ماء بشرك آجناً متأسنا",100,"ن",2,0],["ظمئت وما بالي ظمئت ولم أبتْ","بدارات حزوى لا ولا منبت النخل",101,"ل",1,0],["ظمآنة الخصر ريَّا الردف جامعةٌ","بين النشاط إلى الحاجات والكسلِ",102,"ل",1,0],["ظمإي يزيد بمنهلٍ من ثغرهِ","والماء تروي الصادياتِ نطافه",103,"ف",2,0],["ظمئتُ لما خفَّ عنك الدُّمى","فلا أضافتكِ الغيوثُ الثقال",104,"ل",1,0],["ظمأ أزيل عن القلوب بها وقد","نزلت ونيران القلوب تلظظ",105,"ظ",1,0],["ظمآنُ يَصدى بِكُم والحَيُّ جانِبَهُ","من نجدِهِ ماؤُهُ يُحيي فُؤادَ ظَمي",106,"م",2,0],["ظَمأٌ تأجَّجَ في الرِّكابِ فعندما","وَرَدتْ أتاها الرِيُّ قبلَ المَنهَلِ",107,"ل",1,0],["ظمآنُ يحلو إذا اشتَدَّ الظَّماءُ لهُ","ماءٌ ولكنَّ في إفراطِهِ خَطَرا",108,"ر",2,0],["ظَمِئت إِلى شُكرٍ يَقُومُ بِحَقِّهِ","وأَعْجِبْ بظمآنٍ وقد جاوز البَحْرَا",109,"ر",2,0],["ظَمِئتُ إِلى ماءِ الشَبابِ وَلَم يَزَل","يَغورُ عَلى طولِ المَدى وَيَغيضُ",110,"ض",1,1]]}