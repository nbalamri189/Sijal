{"poems":[[53,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"صاحت بذودي بغداد فآنسني","https://www.aldiwan.net/poem30446.html","البسيط"],[77,"ظمئت إلى السقيا الأباطح والربى","https://www.aldiwan.net/poem36709.html","الطويل"],[93,"ذنبها أنها رأت","https://www.aldiwan.net/poem9153.html","مجزوء الخفيف"],[72,"ظمئت إلى تقبيل كف كريمة","https://www.aldiwan.net/poem19043.html","الطويل"],[51,"ترى شبه الآساد فيهم مبينا","https://www.aldiwan.net/poem62894.html","الطويل"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[85,"يوم أغر محجل الأنباء","https://www.aldiwan.net/poem7747.html","الكامل"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"سنون تعاد ودهر يعيد","https://www.aldiwan.net/poem63719.html","المتقارب"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[97,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[97,"إن عدت أو أخلفت لم تعد","https://www.aldiwan.net/poem24792.html","أحذ الكامل"],[97,"ألمي محا ذنبي إليك وكفرا","https://www.aldiwan.net/poem24995.html","الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[105,"ظماء تريد الري من ذا يذودها","https://www.aldiwan.net/poem42111.html","الطويل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[81,"يدنيك زور الأماني","https://www.aldiwan.net/poem61553.html","المجتث"],[50,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[50,"ألا يا اسقياني بالرحيق فنيت","https://www.aldiwan.net/poem64738.html","الطويل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85601","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30509","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54713","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54874","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199486","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43881","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[45,"أمَحلّتَيْ سَلمَى، بكاظمةَ، أسلَما","https://www.poetsgate.com/ViewPoem.aspx?id=32072",""],[85,"لك في الأرض والسماءِ مآتمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9626&r=&rc=116",""]],"verses":[["ظَمائي إِلى مَن لَو أَرادَ سَقاني","وَديني عَلى مَن لَو يَشاءُ قَضاني",0,"ي",1,1],["ظَمأى إِلَيكَ وَأَينَ عَنكَ مَحيدُها","وَالرَعيُ عِندَكَ وَالرُوا وَالمَرتَعُ",1,"ع",1,0],["ظَمآنَ سَلّى نَجيعُ الطَعنِ غُلَّتَهُ","عَن بارِدٍ مَن عُبابِ الماءِ مَقرورِ",2,"ر",1,0],["ظَمِئَتْ إِلَى السُّقْيَا الأَبَاطِحُ وَالُّربَى","حَتَّى دَعَوْنَا الْعَامَ عَاماً مُجْدِبَا",3,"ب",2,1],["ظمئاً ما لغله","من ندى الدمع مرتوي",4,"و",2,0],["ظمئت إلى تقبيل كفٍّ كريمةٍ","تكادُ بها الأقلام تعشب باللمس",5,"س",1,1],["ظِماء إلى وِرد الدماء نواهلٌ","لها مورد من غير مأتاهُ نَصدُر",6,"ر",1,0],["ظمِئْتُ إلى النُّورِ فوقَ الغصونِ","ظمِئْتُ إلى الظِّلِّ تحتَ الشَّجَرْ",7,"ر",1,0],["ظمِئْتُ إلى النَّبْعِ بَيْنَ المروج","يغنِّي ويرقصُ فوقَ الزَّهَرْ",7,"ر",1,0],["ظمِئْتُ إلى نَغَماتِ الطُّيورِ","وهَمْسِ النَّسيمِ ولحنِ المَطَرْ",7,"ر",1,0],["ظمِئْتُ إلى الكونِ أَيْنَ الوجودُ","وأَنَّى أَرى العالَمَ المنتظَرْ",7,"ر",1,0],["ظمأ البلاد غليك في هذى النوى","ظمأ النبات إلى الغمام النائى",8,"ا",2,0],["ظَمِئَ الحُرُّ لِلدِيارِ وَإِن كا","نَ عَلى مَنهَلٍ مِنَ الخُلدِ دائِم",9,"م",1,0],["ظَمِئتُ وَمِثلي بَرِيٍّ أَحَقُّ","كَأَنّي حُسَينٌ وَدَهري يَزيد",10,"د",1,0],["ظِماءٌ إِلى ماءِ الوريدِ وإنَّها","ليطغَى بها حَدٌّ من الماء مُتْرَعُ",11,"ع",1,0],["ظَمِأَت مَراشِفُنا إِلَيهِ وَرَيُّها","في ذَلِكَ اللَعسِ المُمَنَّعِ وَاللَمى",12,"م",2,0],["ظَمِئَت مَضارِبُ غَفرَتَيهِ فَأَصبَحَت","مِن عَدَمِ اللَهَواتِ ذاتَ لَماظِ",13,"ظ",1,0],["ظَمآنَةٌ لِلقاكَ وَهيَ رَوِيَّةٌ","بِبِدائِعٍ تَروي غَليلَ رُواتِها",14,"ت",3,0],["ظمآن حين الماء ليلى وحدَها","عزَّت عليه ولمَ تُتح لظماءِ",15,"ا",2,0],["ظمأٌ على ظمأ على ظمأ","ومواردٌ كثرٌ ولم أردِ",16,"د",1,0],["ظمآن لو باع الأحبة قطرة","بالعمر والدنيا جميعاً لا شترى",17,"ر",2,0],["ظَمآنُ يَستسقي أُجاجَ دموعِهِ","من عارِضِ البَرِد الشنيبِ زلالا",18,"ل",2,0],["ظمأى إلى غدرانِهِ ورياضِهِ","ظمأٌ يزيد القلبَ منهُ تأججا",19,"ج",2,0],["ظِماءٌ تُريدُ الرِيَّ مَن ذا يَذودُها","أَتُوزَعُ والأقوامُ شَتَّى ورُودُها",20,"د",3,1],["ظَمِئَت جَوانِحُهُ إِلى حَرِّ الوَغى","فَسَقَتهُ شُؤبوبَ النَجيعِ القاني",21,"ن",2,0],["ظَمِئَت إِلى وِردِ الأُسودِ نُفوسُهُم","وَالمَوتُ يَنقَعُ غُلَّةَ الظَمآنِ",21,"ن",1,0],["ظَمِئتِ من سعدٍ إلى نظرةٍ","تُطفِئُ حَرَّ اللاعجِ المشعَل",22,"ل",1,0],["ظَمِئْتَ سيوفُكَ يا مُحمّدُ فَاسْقِها","من خيرِ ما تُسقَى السُّيوفُ وتُنضَحُ",23,"ح",1,0],["ظَمِئتُ مِنكَ لِوَعدٍ","فَكانَ وِردي السَرابا",24,"ب",2,0],["ظَمِئتُ إِلَيها فَلَم تَسقِني","بِرِيٍّ وَلَم تَشفِني مِن سَقَم",25,"م",1,0],["ظَمِئتُ فَلَم أَظمَأ إِلى بَردِ مَشرَبٍ","وَلَكِن إِلى وَجهِ الحَبيبِ ظَميتُ",26,"ت",1,0],["ظَمآى إِلى وِردِ الحَياةِ فَإِن تَرِد","تَرِدِ المَنِيَّةَ في لُعابِ الأَرقَمِ",27,"م",1,0],["ظمئت فَلَم تنقع أواميَ دجلة","وَللناس في بغداد من دجلة ورد",28,"د",1,0],["ظمأي قاتلي فما حَذري","مَوردي منكِ مَوْردَ العَطَبِ",29,"ب",1,0],["ظَمِئتُ إِلَى صافِي الهَواءِ وَطَلقِهِ","فَهَل لي يَوماً في رِضاكَ ورُودُ",30,"د",1,0],["ظَمْآنُ يَطْلُبُ رِيَّهُ","جَوْعَانُ يَلْتَمِسُ الْغِذَاءْ",31,"ا",2,0],["ظَمْأَى إِلَى المَوْتِ رَيَّا","مِنَ الأَسَى وَالْبِعَادِ",32,"د",1,0],["ظَمْأَى إِلَيْهَا حِينَ ضَرَّجَهَا","لَوْنُ الحَيَاءِ وَزَانَهَا الخَفَرُ",33,"ر",1,0],["ظمآن والأهواء جارية","كالسلسبيل، مسى يرد يرد",34,"د",1,0],["ظمِئتَ فكيفَ خانَتْكَ السواقي؟","وهمتَ .. فأينَ أوديةُ العِراقِ؟",35,"ق",1,1],["ظمِئْتُ ومُنْهَلُّ المَدامِعِ مَنْهلي","ولا حَوْم لِي إِلّا عَلى ورْدِ حَوْمَلِ",36,"ل",1,1],["ظَمِئت إِذ حالَ دونَ وِردي","صرفُ زَمانٍ لَهُ عِظاظُ",37,"ظ",1,0],["ظَمِئتُ إِلى اللُقيا وَفي الحَشرِ نَلتَقي","فَيا سَلسَبيلي ما إِلَيكَ سَبيلُ",38,"ل",1,0],["ظَمِئتُ وَما يَشفي لي الماءُ غلَّةً","وأشوى كَأَنّي لِلزَّفيرِ أَقيظُ",39,"ظ",1,0],["ظمئت، وأخطأها الروى","فكأنّ زهوتها أهانْ",40,"ن",1,0],["ظِماءٌ إلى ماءٍ بدِجْلةَ سَلْسَلٍ","تودُّ بنور العين لو رأتِ الوِردا",41,"د",2,0],["ظَمِىءَ الشْعرُ للثناءِ فهل آ","نَ له أن يفيضَ شكراً وحمدا",42,"د",2,0],["ظمآنَ، هام بقطرة معسولة","من نيل مصر فما استطاع ورودا",43,"د",2,0],["ظمآنَ لاوِردٌ سواه فَينثنى","عنه ولا يسطيع خوض مَخوفه",44,"ف",2,0],["ظَمِئَتْ مَرَاشِفُنَا إلَيهِ، وَرَيُّهَا","في ذلكَ اللَّعَسِ المُمَنَّعِ واللَّمَى",45,"م",2,0],["ظمىء الحرُّ للديار، وإن كا","ن على منهلٍ من الخلد دائم",46,"م",1,0]]}