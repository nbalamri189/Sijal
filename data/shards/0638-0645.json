ps://www.aldiwan.net/poem68560.html","الطويل"],[195,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[197,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[197,"حطي نقابك لحظة","https://www.aldiwan.net/poem45618.html","مجزوء الكامل"],[197,"مرت لياليها ولما ترجع","https://www.aldiwan.net/poem45649.html","الكامل"],[202,"ظماء العيون عصرن القدود","https://www.aldiwan.net/poem53160.html","المتقارب"],[209,"نعود إلى مآثمنا نعود","https://www.aldiwan.net/poem46255.html","الوافر"],[209,"بلا أمل نداعبه حضرنا","https://www.aldiwan.net/poem46260.html","الوافر"],[209,"عند هذا المساء يلقاك روح","https://www.aldiwan.net/poem46269.html","الخفيف"],[209,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[209,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[224,"تحية الحياة","https://www.aldiwan.net/poem24238.html","عموديه"],[233,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[233,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[248,"ظهور رسول الله أظهر ديننا","https://www.aldiwan.net/poem15070.html","الطويل"],[268,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[269,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[273,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[277,"صدني بعد اقتراب وجفاني","https://www.aldiwan.net/poem2640.html","الرمل"],[279,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[288,"أسفا لقد ولى الشباب ولم أفد","https://www.aldiwan.net/poem11672.html","الكامل"],[295,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[303,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[351,"المجد كبر بالسرور وهللا","https://www.aldiwan.net/poem39589.html","الكامل"],[362,"إن الذي نصب المكارم للورى","https://www.aldiwan.net/poem60939.html","الكامل"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[364,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[406,"لا تغترر بنحول خصر أهيف","https://www.aldiwan.net/poem32566.html","الكامل"],[413,"أقول لسعد حين لام على الهوى","https://www.aldiwan.net/poem53950.html","الطويل"],[426,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[429,"لجأت إلى عتباك فاستبق من لجا","https://www.aldiwan.net/poem12365.html","الطويل"],[429,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[451,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[451,"عيدان عيد تحرر وتفاؤل","https://www.aldiwan.net/poem61377.html","الكامل"],[456,"أيا بانة الغور عطفا سقيت","https://www.aldiwan.net/poem56084.html","المتقارب"],[456,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[456,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[459,"كأن بلاد الله مما أجنه","https://www.aldiwan.net/poem15131.html","الطويل"],[459,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[459,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[462,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[462,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[462,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[462,"خليلي هل من شربة تجدانها","https://www.aldiwan.net/poem3359.html","عموديه"],[462,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[462,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[462,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[556,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[560,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[560,"خلت الديار كأنها لم تؤهل","https://www.aldiwan.net/poem52933.html","الكامل"],[560,"طيف بلبنان من مصر إلي سرى","https://www.aldiwan.net/poem52958.html","البسيط"],[573,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[584,"ظمئت إلى ماء الشباب ولم يزل","https://www.aldiwan.net/poem22886.html","الطويل"]],"verses":[["ظَمائي إِلى مَن لَو أَرادَ سَقاني","وَديني عَلى مَن لَو يَشاءُ قَضاني",0,"ي",1,1],["ظَمأى إِلَيكَ وَأَينَ عَنكَ مَحيدُها","وَالرَعيُ عِندَكَ وَالرُوا وَالمَرتَعُ",1,"ع",1,0],["ظَمآنَ سَلّى نَجيعُ الطَعنِ غُلَّتَهُ","عَن بارِدٍ مَن عُبابِ الماءِ مَقرورِ",2,"ر",1,0],["ظَمِئَتْ إِلَى السُّقْيَا الأَبَاطِحُ وَالُّربَى","حَتَّى دَعَوْنَا الْعَامَ عَاماً مُجْدِبَا",3,"ب",2,1],["ظمئاً ما لغله","من ندى الدمع مرتوي",4,"و",2,0],["ظمئت إلى تقبيل كفٍّ كريمةٍ","تكادُ بها الأقلام تعشب باللمس",5,"س",1,1],["ظِماء إلى وِرد الدماء نواهلٌ","لها مورد من غير مأتاهُ نَصدُر",6,"ر",1,0],["ظمِئْتُ إلى النُّورِ فوقَ الغصونِ","ظمِئْتُ إلى الظِّلِّ تحتَ الشَّجَرْ",7,"ر",1,0],["ظمِئْتُ إلى النَّبْعِ بَيْنَ المروج","يغنِّي ويرقصُ فوقَ الزَّهَرْ",7,"ر",1,0],["ظمِئْتُ إلى نَغَماتِ الطُّيورِ","وهَمْسِ النَّسيمِ ولحنِ المَطَرْ",7,"ر",1,0],["ظمِئْتُ إلى الكونِ أَيْنَ الوجودُ","وأَنَّى أَرى العالَمَ المنتظَرْ",7,"ر",1,0],["ظمأ البلاد غليك في هذى النوى","ظمأ النبات إلى الغمام النائى",8,"ا",2,0],["ظَمِئَ الحُرُّ لِلدِيارِ وَإِن كا","نَ عَلى مَنهَلٍ مِنَ الخُلدِ دائِم",9,"م",1,0],["ظَمِئتُ وَمِثلي بَرِيٍّ أَحَقُّ","كَأَنّي حُسَينٌ وَدَهري يَزيد",10,"د",1,0],["ظِماءٌ إِلى ماءِ الوريدِ وإنَّها","ليطغَى بها حَدٌّ من الماء مُتْرَعُ",11,"ع",1,0],["ظَمِأَت مَراشِفُنا إِلَيهِ وَرَيُّها","في ذَلِكَ اللَعسِ المُمَنَّعِ وَاللَمى",12,"م",2,0],["ظَمِئَت مَضارِبُ غَفرَتَيهِ فَأَصبَحَت","مِن عَدَمِ اللَهَواتِ ذاتَ لَماظِ",13,"ظ",1,0],["ظَمآنَةٌ لِلقاكَ وَهيَ رَوِيَّةٌ","بِبِدائِعٍ تَروي غَليلَ رُواتِها",14,"ت",3,0],["ظمآن حين الماء ليلى وحدَها","عزَّت عليه ولمَ تُتح لظماءِ",15,"ا",2,0],["ظمأٌ على ظمأ على ظمأ","ومواردٌ كثرٌ ولم أردِ",16,"د",1,0],["ظمآن لو باع الأحبة قطرة","بالعمر والدنيا جميعاً لا شترى",17,"ر",2,0],["ظَمآنُ يَستسقي أُجاجَ دموعِهِ","من عارِضِ البَرِد الشنيبِ زلالا",18,"ل",2,0],["ظمأى إلى غدرانِهِ ورياضِهِ","ظمأٌ يزيد القلبَ منهُ تأججا",19,"ج",2,0],["ظِماءٌ تُريدُ الرِيَّ مَن ذا يَذودُها","أَتُوزَعُ والأقوامُ شَتَّى ورُودُها",20,"د",3,1],["ظَمِئَت جَوانِحُهُ إِلى حَرِّ الوَغى","فَسَقَتهُ شُؤبوبَ النَجيعِ القاني",21,"ن",2,0],["ظَمِئَت إِلى وِردِ الأُسودِ نُفوسُهُم","وَالمَوتُ يَنقَعُ غُلَّةَ الظَمآنِ",21,"ن",1,0],["ظَمِئتِ من سعدٍ إلى نظرةٍ","تُطفِئُ حَرَّ اللاعجِ المشعَل",22,"ل",1,0],["ظَمِئْتَ سيوفُكَ يا مُحمّدُ فَاسْقِها","من خيرِ ما تُسقَى السُّيوفُ وتُنضَحُ",23,"ح",1,0],["ظَمِئتُ مِنكَ لِوَعدٍ","فَكانَ وِردي السَرابا",24,"ب",2,0],["ظَمِئتُ إِلَيها فَلَم تَسقِني","بِرِيٍّ وَلَم تَشفِني مِن سَقَم",25,"م",1,0],["ظَمِئتُ فَلَم أَظمَأ إِلى بَردِ مَشرَبٍ","وَلَكِن إِلى وَجهِ الحَبيبِ ظَميتُ",26,"ت",1,0],["ظَمآى إِلى وِردِ الحَياةِ فَإِن تَرِد","تَرِدِ المَنِيَّةَ في لُعابِ الأَرقَمِ",27,"م",1,0],["ظمئت فَلَم تنقع أواميَ دجلة","وَللناس في بغداد من دجلة ورد",28,"د",1,0],["ظمأي قاتلي فما حَذري","مَوردي منكِ مَوْردَ العَطَبِ",29,"ب",1,0],["ظَمِئتُ إِلَى صافِي الهَواءِ وَطَلقِهِ","فَهَل لي يَوماً في رِضاكَ ورُودُ",30,"د",1,0],["ظَمْآنُ يَطْلُبُ رِيَّهُ","جَوْعَانُ يَلْتَمِسُ الْغِذَاءْ",31,"ا",2,0],["ظَمْأَى إِلَى المَوْتِ رَيَّا","مِنَ الأَسَى وَالْبِعَادِ",32,"د",1,0],["ظَمْأَى إِلَيْهَا حِينَ ضَرَّجَهَا","لَوْنُ الحَيَاءِ وَزَانَهَا الخَفَرُ",33,"ر",1,0],["ظمآن والأهواء جارية","كالسلسبيل، مسى يرد يرد",34,"د",1,0],["ظمِئتَ فكيفَ خانَتْكَ السواقي؟","وهمتَ .. فأينَ أوديةُ العِراقِ؟",35,"ق",1,1],["ظمِئْتُ ومُنْهَلُّ المَدامِعِ مَنْهلي","ولا حَوْم لِي إِلّا عَلى ورْدِ حَوْمَلِ",36,"ل",1,1],["ظَمِئت إِذ حالَ دونَ وِردي","صرفُ زَمانٍ لَهُ عِظاظُ",37,"ظ",1,0],["ظَمِئتُ إِلى اللُقيا وَفي الحَشرِ نَلتَقي","فَيا سَلسَبيلي ما إِلَيكَ سَبيلُ",38,"ل",1,0],["ظَمِئتُ وَما يَشفي لي الماءُ غلَّةً","وأشوى كَأَنّي لِلزَّفيرِ أَقيظُ",39,"ظ",1,0],["ظمئت، وأخطأها الروى","فكأنّ زهوتها أهانْ",40,"ن",1,0],["ظِماءٌ إلى ماءٍ بدِجْلةَ سَلْسَلٍ","تودُّ بنور العين لو رأتِ الوِردا",41,"د",2,0],["ظَمِىءَ الشْعرُ للثناءِ فهل آ","نَ له أن يفيضَ شكراً وحمدا",42,"د",2,0],["ظمآنَ، هام بقطرة معسولة","من نيل مصر فما استطاع ورودا",43,"د",2,0],["ظمآنَ لاوِردٌ سواه فَينثنى","عنه ولا يسطيع خوض مَخوفه",44,"ف",2,0],["ظَمِئَتْ مَرَاشِفُنَا إلَيهِ، وَرَيُّهَا","في ذلكَ اللَّعَسِ المُمَنَّعِ واللَّمَى",45,"م",2,0],["ظمىء الحرُّ للديار، وإن كا","ن على منهلٍ من الخلد دائم",46,"م",1,0],["ظَمأي أَراني الناس ماءً سُغتَهُ","غَصصاً هِيَ التَكدبر وَالتَنكيدُ",47,"د",1,0],["ظمئ ترويه قبلته","كيف ريى وهو ظمآن",48,"ن",1,0],["ظمىء إلى ماء النُّقَيْبِ لأنَّه","وِرْدُ اللَّمَى ومناهلُ الأغصانِ",49,"ن",1,0],["ظمنت له الذِّكرَ الجميلا معجلا","جدواهُ والأجر الجزيلَ مؤجلا",50,"ل",2,0],["ظَمِئتُ وأَجفانِي بدَمعِيَ فُيَّضُ","وَعِشتُ وأَضلاعي بِرُوحيَ فُيَّظُ",51,"ظ",1,1],["ظمئت روحها ولم تر كأسا","غير كاس الردى تبلّ صداها",52,"ا",3,0],["ظُماءَةُ جوفٍ أجَّ شوقاً إلى الورى","وبعضَ الظما قد يلتظي حينَ ينقعُ",53,"ع",1,0],["ظمأَ الفؤادُ إلى رضاك","ظمأ المحب إلى رضابكْ",54,"ك",1,0],["ظمآن لا ترويه إلا عبرةٌ","أو مهجة هطلت بجنبي مولعِ",55,"ع",1,0],["ظماءُ العيونِ عصرنَ القدودَ","كأنَّهُمُ عطشوا فارتَوَوا",56,"و",3,1],["ظمئنا والرياض بها حياض","بها ماء يفيض ولا يجود",57,"د",1,0],["ظمئت وما شفائي غير كأس","أعاقرها من الثغر الرشوف",58,"ف",1,0],["ظمأ قاتل يعانيه روحي","وبثغريك مورد سلسبيل",59,"ل",1,0],["ظمىء القلب إلى عهد الصيال","وإلى البلوى بعذل السفهاء",60,"ا",2,0],["ظمئت روحي إلى ورد صفاك","ظمئت عيني إلى نور سناك",61,"ك",1,0],["ظمأ الشفاه طبيعة ألهمنها","منذ ارتوين بثغرك المعسول",62,"ل",1,0],["ظمأ تؤججه القلوب خوافقاً","تنزو بعارم لهفة وغليل",62,"ل",1,0],["ظَمِئَت إِلى إِشراقِ وَج","هِكِ مُقلَتي فَاِنقَع صَداها",63,"ا",3,0],["ظَمآنَ يَقذِفُ نَفسَهُ مُستَشعِراً","خَوفَ القِيامَةِ في الهَجيرِ الواغِرِ",64,"ر",1,0],["ظَمئتُ إلى تقبيل تُربةِ أحمدٍ","وحَسبي وعظُ الشَّيبِ إن لم يَكُن وعظَ",65,"ظ",1,0],["ظمأٌ يَزيدُ حَشاكِ ماءُ جُفونِها","وزَفيرُها نارٌ بها تُلظيك",66,"ك",1,0],["ظمئت مرا شفنا اليه وريها","في ذلك للعس المعسل وَاللمى",67,"م",2,0],["ظَمْآنُ رَاحَ لأُفْقِ الشَّرْق مُلْتَهِما","لَكِنْ غَدَا بِنَجِيع الجَوْفِ رَيَّانا",68,"ن",2,0],["ظَمَأي فيه ظَما آخِره","ليتين أَوَّلُه ممّا عَراني",69,"ي",1,0],["ظمان يسآل عن وِرد ينال به","ريّ الغليل وفي أجفانه النيل",70,"ل",1,0],["ظمىء السنين فجاء ينقع غلّه","لكنه لم يلق غير تباب",71,"ب",1,0],["ظَمئت أَمانيُّ الرِجال لَدى العُلى","فوردتَ منهلَها وَلَمّا تَصدُرِ",72,"ر",1,0],["ظَمأً إِلى المنهلِ المحمود موردهُ","بَداهةُ الخاطرِ المكدود تحتدمُ",73,"م",1,0],["ظمئت لمرآها النَواظر بَعدَما","وَردت مِن الحَمد المَسامِع منهلا",74,"ل",2,0],["ظَمْآنَ أم ريّانَ أم مُتوسِّطاً","لا بُدَّ من صَدَرِ الرِعّاءِ الوارد",75,"د",1,0],["ظّمِئَتْ إلى ماءِ السّماءِ جديبةً","أيامَ أصبَحتِ الخلافةُ في عَدِي",76,"د",2,0],["ظَمآنُ أَعطَشَهُ الصَبا","حُ وَإِن جَرى جَرى الزُلالُ",77,"ل",1,0],["ظَمَئِي من الثَّغرِ البَرُود فمَن رأى","ظَمآنَ من بَرْدٍ يُعلُّ بَقَرقَفِ",78,"ف",1,0],["ظماً لثناياك العِذاب وإنَّها","عَذابٌ لقلبي يا أُميمُ أليم",79,"م",1,0],["ظمياء جاءت تستقي","من نيل كف فاض يم",80,"م",1,0],["ظمِئتُ وقد يَظْمَا البعيدُ مناهِلاً","وصادَفْتُ ذاكَ العَذْبَ منك تَمَرَّجا",81,"ج",2,0],["ظِماءُ حروبٍ من قلوبِ عداتِهمْ","لهم قُلُبٌ والسّمهريّةُ أشطانُ",82,"ن",1,0],["ظِماءٌ وَمَا يَدْرُونَ فِي الأَرْضِ مَشْرَباً","سِوى كَبِدي الْحَرّى ومُهْجَتيَ الظَّمْيا",83,"ي",2,0],["ظِمَاءٌ وَمَا غَيْرَ الدماءِ مشارِبٌ","لَهُنَّ ولا غَيْرَ القُلُوبِ مَطَاعِمُ",84,"م",1,0],["ظمأ الشوق للملاحة والدف","ء وللنور بعد تعذيب ناقم",85,"م",1,0],["ظمئي إلى وطني ظماء معذّب","فداه لا مستثمر متمادي",86,"ي",1,0],["ظمئتُ إلى أعذبِ الشربتيْن","فكلتاهما قد حوتها يداكِ",87,"ك",1,0],["ظمأ لا يتبغِّين له","مُشتَكىً إلا وسيعاتِ الخُطا",88,"ط",2,0],["ظمئنا بعدكم أسفاً وشوقاً","كما جِيدتْ بكم يُبْسُ البلادِ",89,"د",1,0],["ظماءُ القنا والبيضِ لا يشتكيهمُ","بيوم الوغى قرن الكمي ولا النحرُ",90,"ر",1,0],["ظمأى إلى الماءِ تطْويه وتنْظُرُه","مشغولةً بقراعِ القومِ عن بَللِ",91,"ل",1,0],["ظمأى إِلى ماءٍ الجِراحِ كأنما","تجري مواردُها بخَدْع سَرابِ",92,"ب",1,0],["ظمأي بمهضوم الحشا ريَّان من","ماءِ الشَّباب وخصرهُ يشكو الصّدى",93,"د",2,0],["ظمئت فكان ذاك ضامن نقعها","وشكت فكان السيف حاسم دائها",94,"ا",3,0],["ظمئت فما وردت وليس ببدعةٍ","من ماء بشرك آجناً متأسنا",95,"ن",2,0],["ظمئت وما بالي ظمئت ولم أبتْ","بدارات حزوى لا ولا منبت النخل",96,"ل",1,0],["ظمآنة الخصر ريَّا الردف جامعةٌ","بين النشاط إلى الحاجات والكسلِ",97,"ل",1,0],["ظمإي يزيد بمنهلٍ من ثغرهِ","والماء تروي الصادياتِ نطافه",98,"ف",2,0],["ظمئتُ لما خفَّ عنك الدُّمى","فلا أضافتكِ الغيوثُ الثقال",99,"ل",1,0],["ظمأ أزيل عن القلوب بها وقد","نزلت ونيران القلوب تلظظ",100,"ظ",1,0],["ظمآنُ يَصدى بِكُم والحَيُّ جانِبَهُ","من نجدِهِ ماؤُهُ يُحيي فُؤادَ ظَمي",101,"م",2,0],["ظَمأٌ تأجَّجَ في الرِّكابِ فعندما","وَرَدتْ أتاها الرِيُّ قبلَ المَنهَلِ",102,"ل",1,0],["ظمآنُ يحلو إذا اشتَدَّ الظَّماءُ لهُ","ماءٌ ولكنَّ في إفراطِهِ خَطَرا",103,"ر",2,0],["ظَمِئت إِلى شُكرٍ يَقُومُ بِحَقِّهِ","وأَعْجِبْ بظمآنٍ وقد جاوز البَحْرَا",104,"ر",2,0],["ظَمِئتُ إِلى ماءِ الشَبابِ وَلَم يَزَل","يَغورُ عَلى طولِ المَدى وَيَغيضُ",105,"ض",1,1]]}