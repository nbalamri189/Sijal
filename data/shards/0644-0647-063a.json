{"poems":[[73,"صليل المواضي واهتزاز القنا السمر","https://www.aldiwan.net/poem4024.html","الطويل"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[87,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[119,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[189,"جام حوى في الظرف كل باب","https://www.aldiwan.net/poem14090.html","الرجز"],[208,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[216,"حصاني لا في الصافنات التي مضت","https://www.aldiwan.net/poem37883.html","الطويل"],[408,"وأهيف مشروط الخدود لطرفه","https://www.aldiwan.net/poem46688.html","الطويل"],[412,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[473,"يا من شراني له نخاس همته","https://www.aldiwan.net/poem60356.html","المنسرح"],[563,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"],[580,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126871","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66647","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62493","الطويل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177916","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64799","المتقارب"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126666","الوافر"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133975","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112530","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100736","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68037","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82832","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129406","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85236","الطويل"],[3770,"","https://poetry.dctabudhabi.ae/diwan/poem/111346","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127294","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96075","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120486","الوافر"],[4578,"لقلبي في مهاوي الحب أهوى","https://www.poetsgate.com/ViewPoem.aspx?id=49607",""],[5277,"سدرةُ الحُسْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=205979",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[5732,"حي نوده","https://www.poetsgate.com/ViewPoem.aspx?id=177896",""],[5739,"عيون حظ ٍ مفلسه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127068",""],[6259,"ألمَّ وليلى بالكواكب أشيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59357&r=&rc=5",""]],"verses":[["لَهُ غُنيَةٌ عَن غَيرِكُم مِن قَناعَةٍ","وَأَمّا إِلى مَعروفِكُم فَأَخو فَقرِ",0,"ر",1,0],["لَهُ غَلَلٌ في ظِلِّ كُلِّ حَديقَةٍ","يُعارِضُ يَعبوباً مِنَ الماءِ سَلسَلا",1,"ل",2,0],["لَهُ غَداً رَأيُهُ فيها وَحِكمَتُهُ","إِذا تَمَهَّلَ فَوقَ الشَوكِ أَو وَثَبا",2,"ب",2,0],["لَهُ غُرَّةٌ تَستَصحِبُ النَصرَ طَلقَةٌ","كَفاكَ بِها في سَورَةِ الحَشرِ مِن عَشرِ",3,"ر",1,0],["لَهُ غُدُواتٌ يَتْبَعُ الْوَحْشُ ظِلَّها","وَتَغْدُو عَلى آثارِها الطَّيْرُ تَنْعَبُ",4,"ب",1,0],["له غرر في جبهة الدين لم تزل","تنوه عن ذاك الامير المجاهد",5,"د",1,0],["له غِشاءٌ صيغ من إهاب","حُرِّر بالأيدي وبالألباب",6,"ب",1,0],["له غُرَّة من تحت شَعرٍ كأنَّه","تبلُّجُ صبحٍ تحت جنح مساءِ",7,"ا",2,0],["له غرّةُ كالبدرِ فوقَ جبينِهِ","وتُشرِفَ في الآفاقِ وهي تُنيرُ",8,"ر",1,0],["لَه غُرّةٌ فتّانةٌ تَنْتمي إلى","هلالٍ وطرفٌ ينتمي لِمُحَارِب",9,"ب",1,0],["لَهُ غِرَّة لِلبشر فيها تَرَقرُق","ترحب بِالعافين قَبلَ يرحِّبُ",10,"ب",1,0],["له غَداةَ الحربِ إن مارَسْتَه","ومعظَمُ الحربِ على ساقٍ بدا",11,"ا",1,0],["لَهُ غِناءٌ يَهُزُّ القَلبَ مِن طَرَبٍ","إِن هَزَّ أَعطافُهُ في ثَوبِ نَغمَتِهِ",12,"ت",2,0],["له غرام بمن تجلى","به وما عنده تسلي",13,"ل",2,0],["له غُصْنُ قدٍّ عادلٍ جار في الحَشَا","خلا ما ترى هل لا وِفاقَ يُرَغِّبُ",14,"ب",1,0],["له غرّة مثل شمس الضُحى","ونور محيّاه يَجلو الظُلَم",15,"م",1,0],["له غاية الغايات تعزى وعزه","يمنعه بالمنع في كل منعة",16,"ه",1,0],["له غيبةٌ لا بدّ من أن يَغيبها","فصلّى عليه اللهُ من مُتَغَيِّبِ",17,"ب",1,0],["له غارةٌ في كل يوم يشنُّها","لغزو عِداهُ أو لإتلاف ماله",18,"ل",2,0],["له غصن قدّ بالملاحة مزهر","وديباج خدٍ بالعذار مطرز",19,"ز",1,0],["لَهُ غُصْنُ قدٍ يَفوقُ الغُصونَ","بفَائقِ أَجناسِ أَثْمارِهِ",20,"ر",2,0],["له غمد تغيب الشمس منه","تنادى يا له تبرا وغمدا",21,"د",2,0],["له غرر الامثال في كل معضل","من الحكم الغرّاء في الصفحات",22,"ت",1,0],["له غراس من الإحسان باسقة","فما بدا الخير إلا وهي تثمره",23,"ر",2,0],["له غير عرش الملك عرش قلوبنا","فما نبتغي منه الحياة بديلا",24,"ل",2,0],["له غرة تعشى العيون صقيلة","وخد كما تهوى العيون أسيل",25,"ل",1,0],["لَهُ غُرَّة باليُمْنِ تُسْفِر كالبدرِ","إِذَا مَا مشى كالبحرِ يَمْرح سابحُ",26,"ح",1,0],["لهُ غَيرَةٌ تَأبى على الحَقِّ غَيرَه","فَيَقضى وَما يَقضي الأُمورَ على بُطلِ",27,"ل",1,0],["له غرست بيض الضبا كل سرحة","من العز يجني ما يشاء ويقطف",28,"ف",1,0],["له غيرة تحمي الرعا يا كأنها","حمية ضرغام جسور مواثب",29,"ب",1,0],["له غرة نهتدي في الدجى","بنور سناها وتجلو النهارا",30,"ر",2,0],["له غرة سالت فزادته رونقاً","كأن الثريا علقت في جبينه",31,"ه",1,0],["له غضارة طبع","من يانع الورد تؤثر",32,"ر",1,0],["له غمُّ على الجُلساءِ مُؤذٍ","نوافِلُه إذا شربوا قليل",33,"ل",1,0],["له غرر المعاني رافلات","بابهى حلة اللفظ الفصيح",34,"ح",1,0],["له غرر المعالي لو افيضت","على دهم الليالي عدن غرا",35,"ر",2,0],["لهُ غزوٌ وغزلٌ في فؤادي","وجسمي حين ينسج برد بلوى",36,"و",2,0],["لهُ غايةُ الأوصافِ منْ كلِّ شاعرٍ","وغايةُ وصفِ الفرقِ عندَ التباينِ",37,"ن",1,0],["له غابة من صحبه هو ليثها","لديهم مرير الموت عذب المناهل",38,"ل",1,0],["له غرة شقرا جذت عن قرونه","ما هوب في زين الجواهر محلا",39,"ل",2,0],["له غرست الود في صدر السراب.","أرقبه بعيون حظ ٍ .....! مفلسه.",40,"س",2,0],["له غرة ٌ للبشر فيها ترقرقٌ","يرحب بالعافين قبل يرحّب",41,"ب",1,0]]}