{"poems":[[71,"صليل المواضي واهتزاز القنا السمر","https://www.aldiwan.net/poem4024.html","الطويل"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[113,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[183,"جام حوى في الظرف كل باب","https://www.aldiwan.net/poem14090.html","الرجز"],[202,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[210,"حصاني لا في الصافنات التي مضت","https://www.aldiwan.net/poem37883.html","الطويل"],[399,"وأهيف مشروط الخدود لطرفه","https://www.aldiwan.net/poem46688.html","الطويل"],[403,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[429,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[466,"يا من شراني له نخاس همته","https://www.aldiwan.net/poem60356.html","المنسرح"],[556,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"],[573,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"]],"verses":[["لَهُ غُنيَةٌ عَن غَيرِكُم مِن قَناعَةٍ","وَأَمّا إِلى مَعروفِكُم فَأَخو فَقرِ",0,"ر",1,0],["لَهُ غَلَلٌ في ظِلِّ كُلِّ حَديقَةٍ","يُعارِضُ يَعبوباً مِنَ الماءِ سَلسَلا",1,"ل",2,0],["لَهُ غَداً رَأيُهُ فيها وَحِكمَتُهُ","إِذا تَمَهَّلَ فَوقَ الشَوكِ أَو وَثَبا",2,"ب",2,0],["لَهُ غُرَّةٌ تَستَصحِبُ النَصرَ طَلقَةٌ","كَفاكَ بِها في سَورَةِ الحَشرِ مِن عَشرِ",3,"ر",1,0],["لَهُ غُدُواتٌ يَتْبَعُ الْوَحْشُ ظِلَّها","وَتَغْدُو عَلى آثارِها الطَّيْرُ تَنْعَبُ",4,"ب",1,0],["له غرر في جبهة الدين لم تزل","تنوه عن ذاك الامير المجاهد",5,"د",1,0],["له غِشاءٌ صيغ من إهاب","حُرِّر بالأيدي وبالألباب",6,"ب",1,0],["له غُرَّة من تحت شَعرٍ كأنَّه","تبلُّجُ صبحٍ تحت جنح مساءِ",7,"ا",2,0],["له غرّةُ كالبدرِ فوقَ جبينِهِ","وتُشرِفَ في الآفاقِ وهي تُنيرُ",8,"ر",1,0],["لَه غُرّةٌ فتّانةٌ تَنْتمي إلى","هلالٍ وطرفٌ ينتمي لِمُحَارِب",9,"ب",1,0],["لَهُ غِرَّة لِلبشر فيها تَرَقرُق","ترحب بِالعافين قَبلَ يرحِّبُ",10,"ب",1,0],["له غَداةَ الحربِ إن مارَسْتَه","ومعظَمُ الحربِ على ساقٍ بدا",11,"ا",1,0],["لَهُ غِناءٌ يَهُزُّ القَلبَ مِن طَرَبٍ","إِن هَزَّ أَعطافُهُ في ثَوبِ نَغمَتِهِ",12,"ت",2,0],["له غرام بمن تجلى","به وما عنده تسلي",13,"ي",1,0],["له غُصْنُ قدٍّ عادلٍ جار في الحَشَا","خلا ما ترى هل لا وِفاقَ يُرَغِّبُ",14,"ب",1,0]]}