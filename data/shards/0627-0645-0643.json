{"poems":[[53,"ومروع لي بالسلام كأنما","https://www.aldiwan.net/poem30097.html","الكامل"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[3,"قف بالديار وصح إلى بيداه","https://www.aldiwan.net/poem222.html","الكامل"],[86,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[88,"أم كلثوم في فنون الأغاني","https://www.aldiwan.net/poem44430.html","الخفيف"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[27,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[23,"يا حار في سنة من نوم أولكم","https://www.aldiwan.net/poem21347.html","البسيط"],[51,"سوءة سوءة لك ابن البراء","https://www.aldiwan.net/poem7975.html","الخفيف"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[51,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[85,"أنا والله أصلح للمخازى","https://www.aldiwan.net/poem7555.html","الوافر"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[62,"ما للظباء غداة سائفة النقا","https://www.aldiwan.net/poem52335.html","الكامل"],[66,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"ودع لبابة قبل أن تترحلا","https://www.aldiwan.net/poem41852.html","الكامل"],[33,"آل ليلى إن ضيفكم","https://www.aldiwan.net/poem25714.html","المديد"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[81,"وردا فمضمون نجاح المصدر","https://www.aldiwan.net/poem61521.html","الكامل"],[40,"هل في ادكار الحبيب من حرج","https://www.aldiwan.net/poem42274.html","المنسرح"],[40,"هل أنت إن ظعن الأحبة غادى","https://www.aldiwan.net/poem42307.html","الكامل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[48,"دعني من الدار أبكيها وأرثيها","https://www.aldiwan.net/poem66175.html","البسيط"],[50,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[76,"قلب بلوعات الهوى معمود","https://www.aldiwan.net/poem39451.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85298","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85383","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/3227","المديد"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8835","البسيط"],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[51,"سوءة ًسوءة لك ابن البراء","https://www.poetsgate.com/ViewPoem.aspx?id=26084",""],[3,"قفْ بالديار وصحْ إلى بيداها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10775&r=&rc=129",""],[79,"أنا واللَه أصلح للمعالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73325&r=&rc=8",""]],"verses":[["أَم كَيفَ يُطرِبُنا غِناءُ مُشَوَّةٍ","أَبَداً نُهالُ بِوَجهِهِ وَنُراعُ",0,"ع",1,0],["أَم كَيفَ يَرأَمُني وَليسَ بِمُنجِبي","أَتَرى الرَؤومَ تَكونُ غَيرَ وَلودِ",1,"د",1,0],["أَم كَيفَ تُظلِمُ أَرضٌ","أُجِنَّ فيها الشُهبُ",2,"ب",1,0],["أَم كَيفَ تَأمُلُ فَلتَةً أَجسادُهُ","مِن ذا الزَمانِ وَحَشوُها أَدواؤُهُ",3,"ا",3,0],["أَم كَيفَ تَسأَلُ دِمنَةً عادِيَّةً","سَفَتِ الجُنوبِ دِمانَها وَثَراها",4,"ا",3,0],["أُمُّكُم أُمُّنا وَقَد أَرضَعَتنا","مِن هَواها وَنَحنُ نَأبى الفِطاما",5,"م",2,0],["أَمْ كَانَ مَا أَدْرَكْتْ مِصْرٌ عَلَى يَدِهِ","ذَاكَ المَقَامُ الَّذِي أَزْرَى بِكِيوَانِ",6,"ن",1,0],["أم كلثوم في فنون الأغاني","أمةٌ وحدها بهذا الزمان",7,"ن",1,1],["أم كيف تَبتدع المعالي أمةٌ","في العلم قلّ نصيبها المفروض",8,"ض",1,0],["أَم كَلَّمَتكَ بِسُلمانينَ مَنزِلَةٌ","يا مَنزِلَ الحَيِّ جادَتكَ الأَهاضيبُ",9,"ب",1,0],["أَم كُنتَ يا بنَ زِيادٍ حينَ تَقتُلُهُ","بِغِرَّةٍ في فَضاءِ الأَرضِ مَجهولِ",10,"ل",1,0],["أم كلا المعنيَيْنِ فيك جميعاً","حين تحلو بالقِصة العَوْراءِ",11,"ا",2,0],["أمكن الخُمْصُ وقد خَاليتُها","من عناق كاد يأباه النُّهودُ",12,"د",1,0],["أم كيف يهتز امرؤٌ","غَرِضٌ بمهجته وعِرسه",13,"س",2,0],["أمَّكَ والشيخَ اللَئيم مَعْطسا","لا بُورِك الزوجان بل لا قُدِّسا",14,"س",2,0],["أم كُنتَ إلا كفارةٍ خَرَقَتْ","بَرْزخَ طامي الحِدابِ جيّاش",15,"ش",1,0],["أمكُّوكَ الخسار سأنتحيكا","بإحدى الفاقرات ولا أقيكا",16,"ك",2,1],["أمكن صدقُ القولِ فاعدُ المؤتفَكْ","واهتك وما نهتكُ إلا منهتَكْ",17,"ك",1,0],["أمكان وليس فيه أمان","وزمان وليس فيه ربيع",18,"ع",1,0],["أمكروب داءِ السل هل أنت عارف","لمن أنت تؤذي أو بمن أنت تنكل",19,"ل",1,0],["أمكن صاحبي من صحن خدي","وأعطى ذمتي من يشتريها",20,"ه",2,0],["أُمُّكَ النَفسُ قَديماً أَكرَمَت","وَأَبوكَ الفَضلُ خَيرُ المُنجِبين",21,"ن",1,0],["أم كيف آنسُ بالصِحَاب وقد رأتْ","عينايَ منهم قلَّةَ الإشفَاقِ",22,"ق",1,0],["أَم كَيفَ أَصبِرُ مُغتَرّاً بِأُمنِيَةٍ","وَالدارُ تَبعُدُ وَالآجالُ تَقتَرِبُ",23,"ب",1,0],["أَم كَيفَ يَخذُلُنِي مِن بَعدِ تَسمِيَتِي","بِاسمٍ لَهُ في سَماءِ العَرشِ مُحتَرَمِ",24,"م",1,0],["أُمكُث بَعَمرِكَ لَيلَةً وَتَأَنَّها","فَلَعَلَّ ما بَخِلَت بِهِ أَن يُبذَلا",25,"ل",2,0],["أَمكِنوهُ مِن ثَنِيَّتِها","لَم يُرِد خَمراً وَلا عَسَلا",26,"ل",2,0],["أم كَنْتَ للشرِّ ذُخراً","تَخشى الطّواغيتُ فَقْدَكْ",27,"ك",1,0],["أمكتوبٌ عليكنَّ القتالُ","لَكُنَّ الأمنُ إن فزعوا فزالوا",28,"ل",3,0],["أَم كَيفَ تَفتَخِرُ الجِيادُ بِأَعوَجٍ","فيكُم وَتَنتَسِبُ الرِماحُ لِسَمهَرِ",29,"ر",1,0],["أَم كَيفَ أَنسى مَسِيرنا حُرُماً","يَومَ حَلَلنا بِالنَخلِ مشن أَمَجِ",30,"ج",1,0],["أَم كَيفَ قَلبُكَ إِن ثَوَيتَ مُخامِراً","سَقَماً خِلافَهُمُ وَحُزنُكَ بادى",31,"د",2,0],["أمُكَلِّفِي نَظْمَ النَّسِيبِ وَقد رَأى","عُودَ الشَّبابِ الرَّطْب عادَ يَبِيسا",32,"س",2,0],["أَمكَنتُ عاذِلَتي في الخَمرِ مِن أُذُنٍ","يُغني صَداها جَواباً مَن يُناديها",33,"ي",3,0],["أَم كَيفَ لا كَيفَ لي بِحاضِنَتي","يا حِبُّ لَو كانَ يَنفَعُ الحَذَرُ",34,"ر",1,0],["أمْ كَيفَ أَسْلو غَادَةً ما حُبُّها","إِلّا قَضاءٌ ما لَهُ مَرْدودُ",35,"د",1,0],["أَم كانَ ما عيني تشا","هد من خَيالات اللَيالي",36,"ي",1,0],["أمك القبر لا تَصون كَما أَر","جو ملاحات تلكم الوجنات",37,"ت",1,0],["أمْ كنتِ صَيّرْتِها له كَفَناً","فتلكَ ليستْ مِن آلةِ الرَّجَم",38,"م",1,0],["أمْ كُنْتِ أوْدَعْتِها أخا ثِقَةٍ","فخانَ والخَوْنُ أقْبَحُ الشِّيَم",38,"م",1,0],["أَم كيفَ جِزتَ فُيوجاً حَولَهُم حَرَسٌ","وَمُترَصاً بابُهُ بالشَّكِّ صَرَّارا",39,"ر",2,0],["أَمْ كَيْفَ أَسْلُو وَلِي قَلْبٌ إِذَا الْتَهَبَتْ","بِالأُفْقِ لَمْعَةُ بَرْقٍ كَادَ يَلْتَهِبُ",40,"ب",1,0],["أَمَكَانُهُ هَذا أَتِلْكَ حُلِيُّهُ","وَالبَيْتُ خالٍ وَالمُقَلَّدُ عَارِي",41,"ر",2,0],["أَمكِنوهُ مِن ثَنِيَّتِها","لَم يُرِد سَمناً وَلا عَسَلا",42,"ل",2,0],["أَمكَنتُ عاذِلَتي مِن صَمتِ أَبّاءِ","ما زادَهُ النَهيُ شَيئاً غَيرَ إِغراءِ",43,"ا",2,1],["أم كان تنويمًا خضعوعهمو له؟","ما ذلك السرُّ العميقُ الخافي؟",44,"ف",2,0],["أم كيف يسلو عنك نشوان ومِن","كأس الغرام صَبوحهُ وغَبوقه",45,"ق",2,0],["أم كلا المعنين فيك جميعاً","حين تحلو بالقصة العوْراء",46,"ا",2,0],["أم كيفَ تسأل دمنة ً عادية َ","سفت الجنوبُ دمائها وثراها",47,"ا",3,0],["َأمكنُ عاشقي من صحن خدّي","وأعطي قُبلتي مَن يشتهيها",48,"ه",2,0]]}