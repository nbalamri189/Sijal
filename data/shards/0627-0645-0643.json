https://www.aldiwan.net/poem45484.html","البسيط"],[304,"هل للذي جد بالأظعان يا حادي","https://www.aldiwan.net/poem16753.html","البسيط"],[305,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[320,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[328,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[328,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[361,"صاح قل لي ما هذه الانوار","https://www.aldiwan.net/poem68098.html","الخفيف"],[364,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[366,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[371,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[371,"ما لريم الكناس ليس يريم","https://www.aldiwan.net/poem57152.html","الخفيف"],[371,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[377,"أمكرديج زد فضلا","https://www.aldiwan.net/poem59380.html","مجزوء الوافر"],[380,"أمسى المعنى يعاني ما يعانيه","https://www.aldiwan.net/poem48841.html","البسيط"],[380,"أنا في هواك مخاطر","https://www.aldiwan.net/poem49240.html","مجزوء الكامل"],[402,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[429,"غدر الزمان واظهر التفنيدا","https://www.aldiwan.net/poem41035.html","الكامل"],[437,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[439,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[439,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[458,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[458,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[458,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[470,"هل في ادكار الحبيب من حرج","https://www.aldiwan.net/poem4654.html","المنسرح"],[513,"من لي بعطف أخ خلي الإخاء ورا","https://www.aldiwan.net/poem67719.html","البسيط"],[513,"أغريتني بحياتي إذ غريت بها","https://www.aldiwan.net/poem67794.html","البسيط"],[551,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[551,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[551,"كم ذا تطيش سهام الموت مخطئة","https://www.aldiwan.net/poem47169.html","البسيط"],[551,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[551,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[551,"المرء يجمع والدنيا مفرقة","https://www.aldiwan.net/poem47755.html","البسيط"],[553,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[563,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[586,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"],[586,"أمل سعيت أجد في إتمامه","https://www.aldiwan.net/poem17764.html","الكامل"]],"verses":[["أَم كَيفَ يُطرِبُنا غِناءُ مُشَوَّةٍ","أَبَداً نُهالُ بِوَجهِهِ وَنُراعُ",0,"ع",1,0],["أَم كَيفَ يَرأَمُني وَليسَ بِمُنجِبي","أَتَرى الرَؤومَ تَكونُ غَيرَ وَلودِ",1,"د",1,0],["أَم كَيفَ تُظلِمُ أَرضٌ","أُجِنَّ فيها الشُهبُ",2,"ب",1,0],["أَم كَيفَ تَأمُلُ فَلتَةً أَجسادُهُ","مِن ذا الزَمانِ وَحَشوُها أَدواؤُهُ",3,"ا",3,0],["أَم كَيفَ تَسأَلُ دِمنَةً عادِيَّةً","سَفَتِ الجُنوبِ دِمانَها وَثَراها",4,"ا",3,0],["أُمُّكُم أُمُّنا وَقَد أَرضَعَتنا","مِن هَواها وَنَحنُ نَأبى الفِطاما",5,"م",2,0],["أَمْ كَانَ مَا أَدْرَكْتْ مِصْرٌ عَلَى يَدِهِ","ذَاكَ المَقَامُ الَّذِي أَزْرَى بِكِيوَانِ",6,"ن",1,0],["أم كلثوم في فنون الأغاني","أمةٌ وحدها بهذا الزمان",7,"ن",1,1],["أم كيف تَبتدع المعالي أمةٌ","في العلم قلّ نصيبها المفروض",8,"ض",1,0],["أَم كَلَّمَتكَ بِسُلمانينَ مَنزِلَةٌ","يا مَنزِلَ الحَيِّ جادَتكَ الأَهاضيبُ",9,"ب",1,0],["أَم كُنتَ يا بنَ زِيادٍ حينَ تَقتُلُهُ","بِغِرَّةٍ في فَضاءِ الأَرضِ مَجهولِ",10,"ل",1,0],["أم كلا المعنيَيْنِ فيك جميعاً","حين تحلو بالقِصة العَوْراءِ",11,"ا",2,0],["أمكن الخُمْصُ وقد خَاليتُها","من عناق كاد يأباه النُّهودُ",12,"د",1,0],["أم كيف يهتز امرؤٌ","غَرِضٌ بمهجته وعِرسه",13,"س",2,0],["أمَّكَ والشيخَ اللَئيم مَعْطسا","لا بُورِك الزوجان بل لا قُدِّسا",14,"س",2,0],["أم كُنتَ إلا كفارةٍ خَرَقَتْ","بَرْزخَ طامي الحِدابِ جيّاش",15,"ش",1,0],["أمكُّوكَ الخسار سأنتحيكا","بإحدى الفاقرات ولا أقيكا",16,"ك",2,1],["أمكن صدقُ القولِ فاعدُ المؤتفَكْ","واهتك وما نهتكُ إلا منهتَكْ",17,"ك",1,0],["أمكان وليس فيه أمان","وزمان وليس فيه ربيع",18,"ع",1,0],["أمكروب داءِ السل هل أنت عارف","لمن أنت تؤذي أو بمن أنت تنكل",19,"ل",1,0],["أمكن صاحبي من صحن خدي","وأعطى ذمتي من يشتريها",20,"ه",2,0],["أُمُّكَ النَفسُ قَديماً أَكرَمَت","وَأَبوكَ الفَضلُ خَيرُ المُنجِبين",21,"ن",1,0],["أم كيف آنسُ بالصِحَاب وقد رأتْ","عينايَ منهم قلَّةَ الإشفَاقِ",22,"ق",1,0],["أَم كَيفَ أَصبِرُ مُغتَرّاً بِأُمنِيَةٍ","وَالدارُ تَبعُدُ وَالآجالُ تَقتَرِبُ",23,"ب",1,0],["أَم كَيفَ يَخذُلُنِي مِن بَعدِ تَسمِيَتِي","بِاسمٍ لَهُ في سَماءِ العَرشِ مُحتَرَمِ",24,"م",1,0],["أُمكُث بَعَمرِكَ لَيلَةً وَتَأَنَّها","فَلَعَلَّ ما بَخِلَت بِهِ أَن يُبذَلا",25,"ل",2,0],["أَمكِنوهُ مِن ثَنِيَّتِها","لَم يُرِد خَمراً وَلا عَسَلا",26,"ل",2,0],["أم كَنْتَ للشرِّ ذُخراً","تَخشى الطّواغيتُ فَقْدَكْ",27,"ك",1,0],["أمكتوبٌ عليكنَّ القتالُ","لَكُنَّ الأمنُ إن فزعوا فزالوا",28,"ل",3,0],["أَم كَيفَ تَفتَخِرُ الجِيادُ بِأَعوَجٍ","فيكُم وَتَنتَسِبُ الرِماحُ لِسَمهَرِ",29,"ر",1,0],["أَم كَيفَ أَنسى مَسِيرنا حُرُماً","يَومَ حَلَلنا بِالنَخلِ مشن أَمَجِ",30,"ج",1,0],["أَم كَيفَ قَلبُكَ إِن ثَوَيتَ مُخامِراً","سَقَماً خِلافَهُمُ وَحُزنُكَ بادى",31,"د",2,0],["أمُكَلِّفِي نَظْمَ النَّسِيبِ وَقد رَأى","عُودَ الشَّبابِ الرَّطْب عادَ يَبِيسا",32,"س",2,0],["أَمكَنتُ عاذِلَتي في الخَمرِ مِن أُذُنٍ","يُغني صَداها جَواباً مَن يُناديها",33,"ي",3,0],["أَم كَيفَ لا كَيفَ لي بِحاضِنَتي","يا حِبُّ لَو كانَ يَنفَعُ الحَذَرُ",34,"ر",1,0],["أمْ كَيفَ أَسْلو غَادَةً ما حُبُّها","إِلّا قَضاءٌ ما لَهُ مَرْدودُ",35,"د",1,0],["أَم كانَ ما عيني تشا","هد من خَيالات اللَيالي",36,"ي",1,0],["أمك القبر لا تَصون كَما أَر","جو ملاحات تلكم الوجنات",37,"ت",1,0],["أمْ كنتِ صَيّرْتِها له كَفَناً","فتلكَ ليستْ مِن آلةِ الرَّجَم",38,"م",1,0],["أمْ كُنْتِ أوْدَعْتِها أخا ثِقَةٍ","فخانَ والخَوْنُ أقْبَحُ الشِّيَم",38,"م",1,0],["أَم كيفَ جِزتَ فُيوجاً حَولَهُم حَرَسٌ","وَمُترَصاً بابُهُ بالشَّكِّ صَرَّارا",39,"ر",2,0],["أَمْ كَيْفَ أَسْلُو وَلِي قَلْبٌ إِذَا الْتَهَبَتْ","بِالأُفْقِ لَمْعَةُ بَرْقٍ كَادَ يَلْتَهِبُ",40,"ب",1,0],["أَمَكَانُهُ هَذا أَتِلْكَ حُلِيُّهُ","وَالبَيْتُ خالٍ وَالمُقَلَّدُ عَارِي",41,"ر",2,0],["أَمكِنوهُ مِن ثَنِيَّتِها","لَم يُرِد سَمناً وَلا عَسَلا",42,"ل",2,0],["أَمكَنتُ عاذِلَتي مِن صَمتِ أَبّاءِ","ما زادَهُ النَهيُ شَيئاً غَيرَ إِغراءِ",43,"ا",2,1],["أم كان تنويمًا خضعوعهمو له؟","ما ذلك السرُّ العميقُ الخافي؟",44,"ف",2,0],["أم كيف يسلو عنك نشوان ومِن","كأس الغرام صَبوحهُ وغَبوقه",45,"ق",2,0],["أم كلا المعنين فيك جميعاً","حين تحلو بالقصة العوْراء",46,"ا",2,0],["أم كيفَ تسأل دمنة ً عادية َ","سفت الجنوبُ دمائها وثراها",47,"ا",3,0],["َأمكنُ عاشقي من صحن خدّي","وأعطي قُبلتي مَن يشتهيها",48,"ه",2,0],["أَمْ كيف لا يأْتى إلي","نا عنكم خبر يَسُرّْ",49,"ر",1,0],["أم كنتَ عُوداً عندَ مُستنقَعٍ","في نَبتةٍ تَمتَصُّ ماءَ الرِمَم",50,"م",1,0],["أَم كَيفَ حَالِى إِذ اُكُونُ بِحُفرَةٍ","مَهجُورَةٍ بِقَوَاتِمِ الأَعمَاقِ",51,"ق",1,0],["أمك نعسَى الآن هل تبتغي","شيئاً فيُقضَى لك طبق المراد",52,"د",1,0],["أم كيف يطمع في الصفاء فتىً له","بالطين والماء المهين تكوُّن",53,"ن",1,0],["أَم كَيفَ يَخشى جُموعَ المُفسِدينَ وَقَد","فَلَّ الصَوارِمَ سَيفٌ قَطُّ ما كَهِما",54,"م",2,0],["أم كيف يسلو المستهام وقلبه","في أسر مأسور الضريح رهينة",55,"ن",2,0],["أمُّ كلثوم زينب القاسم إبرا","هيمُ نعمَ البنات والأبناءُ",56,"ا",2,0],["أَم كَيفَ يَنفَعُ ما تُعطي العَلوقَ بِهِ","رِئمانَ أَنفٍ إِذا ما ضُنَّ بِاللَبَنِ",57,"ن",1,0],["أمكةُ هل ذنبٌ إليك جنيتهُ","سوى الحب من قلب تجسّم في دمعي",58,"ي",1,0],["أمكة داري كيف هاتيك دارة","يقول بها الشرك الأثيم فتخنع",59,"ع",1,0],["أم كيف ترجى نجاتي","من ساجيات الجفون",60,"ن",1,0],["أُمَكِّنُ صافِعي من لَطمِ خَدّي","وَأعطي ذِمَّتي من يَشتَريها",61,"ه",2,0],["أَم كيف أَسْطيع مكافاةَ مَنْ","أَسْخَطَ حُسَّادي وأَرضاني",62,"ن",2,0],["أمْ كِبْرَه صَلفاً أم لِينَهُ تَرَفاً","أم خَصْرَه هَيفاً أم رِدفَهُ ثِقَلا",63,"ل",2,0],["أَم كَيفَ أَشكُرُ ما أَولَيتَ مِن نِعَمٍ","قُبولُ شُكري عَلى إِسدائِها نِعَمُ",64,"م",1,0],["أَم كَيفَ يَخبو لِلشَوقِ في كَبِدي","نارٌ لَها نارُ خَدِّهِ مَدَدُ",65,"د",1,0],["أَمْ كيْفَ يُحْصَى عَلَى عُودِ الْبَخُورِ بُكَا","مَنْ كَانَ فِي الأَصْلِ مِنْ أَثْلٍ وَمِنْ خَشَبِ",66,"ب",1,0],["أَمْ كَانَ كُلٌّ مِنْهُمَا فِي حَقِّ مَا","جَلَبَ الأُجُورَ وَفَادِحَ الأَشْجَانِ",67,"ن",1,0],["أم كيف يعرج للسماء بجسمه","صُعُداً بلا سبب ولا أدراج",68,"ج",1,0],["أم كنت من رزق الهوى وهوانه","وحدي ومن حرم المنى والمؤنسا",69,"س",2,0],["ام كيف ييأس من روح الاله غدا","عبد عليه من الاسلام سربال",70,"ل",1,0],["أَم كَيفَنسلو في الغوير وَربعنا","شام وَربع النجدين يماني",71,"ي",1,0],["أَم كَيفَ لا تَهوى العَمى لك مقلةٌ","قد كنتَ قرَّتها وكنت سَناها",72,"ا",3,0],["أَم كان من صنيع كلٍ منهما","حُرُّ الثرى أثْنى وَجادَ ابنُ السما",73,"م",2,0],["أَم كُنتَ تَعرِفُ آياتِ فَقَد جَعَلَت","أَطلالُ إِلفِكَ بِالوَدكاءِ تَعتَذِرُ",74,"ر",1,0],["أم كيف أنسى غريبا صار قربهم","أقصى مرادي ومطاوبي ومرتادي",75,"ي",1,0],["أم كيف أنسى لهم عهداً وقد منحوا","محض الوداد جادوا قبل إيجادي",75,"ي",1,0],["أَم كيفَ أَجحد نعمةً أُوليتها","وَلِسانُها بالحالِ أصدق معلمِ",76,"م",1,0],["أَم كانَ في شكٍّ مريبٍ فليعد","نَظراً فداعيهِ المبينُ المسمعُ",77,"ع",1,0],["أَم كَيفَ يَسعى إِلى ما فيهِ نَكبَتُهُ","مَن لَم يَكُن في غِنى عَن نَهلَةِ الوَشَلِ",78,"ل",1,0],["أمُّ كلّ الأنام قَبضة طينٍ","فاعذر النور إن أبي أن يزيدا",79,"د",2,0],["أم كلثوم أي معجزة تس","بح في مائج من الأنغام",80,"م",1,0],["أم كلثوم أي نبع إلهي","هو الريُّ للقلوب الظوامى",80,"م",2,0],["أم كلثوم أيّ لحن من الخل","د صداه يسمو على الأفهام",80,"م",1,0],["أم كلثوم أي فرحة قلب","ناسك الشعر عبقريّ الهيام",80,"م",1,0],["أمّ كلثوم أيّ أغينة تن","دى حناناً على فم الأيام",80,"م",1,0],["أم كلثوم أي حلم سعيد","عطر الطيف عاشق الأنسام",80,"م",1,0],["أَم كُنوز مَملوءَة بِلآل","أَمرُموز في ضمنها أَسرار",81,"ر",1,0],["أم كيف يُمكِنُ فَوتُ ما أنا آمِلٌ","ولكَمْ رجَعْتُ بنَيْلٍ ما لم آمُل",82,"ل",1,0],["أَم كَيفَ خُضتَ مِنَ المَدامِعِ أَبحُراً","تَرمي زَواخِرُها بِشاطي الوَجنَةِ",83,"ه",1,0],["أم كلُّ قَلبٍ غيرَ قَلبي في الهَوى","ممَّا يُجِنُّ من الصَّبابَةِ هائِمُ",84,"م",1,0],["أم كذاكَ الظِّباء يُعرَفُ في نَظ","رَتِها مَن يضيفُ ممَّن يَشِيمُ",85,"م",1,0],["أَم كانَ شَوقي مثلَ طَيفِكَ كاذِباً","فعمَرتَ بَينَ الكاذِبينَ طَريقا",86,"ق",2,0],["أمَكَّرديجُ زد فضلاً","فأنت الفضل في الناس",87,"س",1,1],["أَم كَيفَ يَخمد جَمر بِالرِياح أَما","هَذا وَبالٌ جُنون الحُب جانيهِ",88,"ي",2,0],["أَم كَيفَ يَسمَح أَو يَفي","لِلحرّ دَهر غادِرُ",89,"ر",1,0],["أمكلّفي صَبراً جَميلاً في الْهوى","تَكْليفُ ما لاَ يُستطَاعُ قبيحُ",90,"ح",1,0],["أم كيف مصباح الهداية والهدى","متوارياً في تربةٍ ملحودا",91,"د",2,0],["أم كيف يبغي القرب من بعدت به","أيدي النوى ومفازة يهاء",92,"ا",2,0],["أَمُكَلَّلٌ وجهِي ووَجْهُكَ بارِزٌ","لِشَبا الأَسِنَّةِ والهواجِرُ تضطرِمْ",93,"م",1,0],["أَمكَنْتَ من رِقِّهِ الإِسلامَ مُحْتَكِماً","فِيهَا وأَسْلَمَها حَرَّانُ مُلْتَهِفُ",94,"ف",1,0],["أم كرات حيرت أهل الحجى","أم دنى دارت بترتيب بديع",95,"ع",1,0],["أم كلُّ فضل في الزمان وأهلِه","حتى الوزارة مهملٌ مظلومُ",96,"م",1,0],["أمكنك الإقبالُ من قَودها","ورأسُها صعبٌ على الإنفتالْ",97,"ل",1,0],["أمكنني من الندى أخو الندى","في قومه وابنُ العلا وآلها",98,"ل",3,0],["أم كان يومُ البين حاشاكُمُ","أوّلَ شيء ما له آخرُ",99,"ر",1,0],["أمكَنَتِ العاذلَ من قِيادِها","فانتزع الرحمةَ من فؤادِها",100,"د