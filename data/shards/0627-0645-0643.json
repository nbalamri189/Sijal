/poem33083.html","الكامل"],[302,"أما ترى تحية السحاب","https://www.aldiwan.net/poem36833.html","عموديه"],[304,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[308,"هل للذي جد بالأظعان يا حادي","https://www.aldiwan.net/poem16753.html","البسيط"],[309,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[309,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[324,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[332,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[332,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[365,"صاح قل لي ما هذه الانوار","https://www.aldiwan.net/poem68098.html","الخفيف"],[368,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[370,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[375,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[375,"ما لريم الكناس ليس يريم","https://www.aldiwan.net/poem57152.html","الخفيف"],[375,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[381,"أمكرديج زد فضلا","https://www.aldiwan.net/poem59380.html","مجزوء الوافر"],[384,"أمسى المعنى يعاني ما يعانيه","https://www.aldiwan.net/poem48841.html","البسيط"],[384,"أنا في هواك مخاطر","https://www.aldiwan.net/poem49240.html","مجزوء الكامل"],[406,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[433,"غدر الزمان واظهر التفنيدا","https://www.aldiwan.net/poem41035.html","الكامل"],[441,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[443,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[443,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[447,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[461,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[461,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[461,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[461,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[461,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[473,"هل في ادكار الحبيب من حرج","https://www.aldiwan.net/poem4654.html","المنسرح"],[516,"من لي بعطف أخ خلي الإخاء ورا","https://www.aldiwan.net/poem67719.html","البسيط"],[516,"أغريتني بحياتي إذ غريت بها","https://www.aldiwan.net/poem67794.html","البسيط"],[554,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[554,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[554,"كم ذا تطيش سهام الموت مخطئة","https://www.aldiwan.net/poem47169.html","البسيط"],[554,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[554,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[554,"المرء يجمع والدنيا مفرقة","https://www.aldiwan.net/poem47755.html","البسيط"],[556,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[566,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[578,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[589,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"],[589,"أمل سعيت أجد في إتمامه","https://www.aldiwan.net/poem17764.html","الكامل"],[862,"","https://poetry.dctabudhabi.ae/diwan/poem/21211","الكامل"]],"verses":[["أم كيف من لم يفق من كرع خمرته","يغدوا عليهم أميراً دونه الحشم",0,"م",1,0],["أَم كَيفَ يُطرِبُنا غِناءُ مُشَوَّةٍ","أَبَداً نُهالُ بِوَجهِهِ وَنُراعُ",1,"ع",1,0],["أَم كَيفَ يَرأَمُني وَليسَ بِمُنجِبي","أَتَرى الرَؤومَ تَكونُ غَيرَ وَلودِ",2,"د",1,0],["أَم كَيفَ تُظلِمُ أَرضٌ","أُجِنَّ فيها الشُهبُ",3,"ب",1,0],["أَم كَيفَ تَأمُلُ فَلتَةً أَجسادُهُ","مِن ذا الزَمانِ وَحَشوُها أَدواؤُهُ",4,"ا",3,0],["أَم كَيفَ تَسأَلُ دِمنَةً عادِيَّةً","سَفَتِ الجُنوبِ دِمانَها وَثَراها",5,"ا",3,0],["أُمُّكُم أُمُّنا وَقَد أَرضَعَتنا","مِن هَواها وَنَحنُ نَأبى الفِطاما",6,"م",2,0],["أَمْ كَانَ مَا أَدْرَكْتْ مِصْرٌ عَلَى يَدِهِ","ذَاكَ المَقَامُ الَّذِي أَزْرَى بِكِيوَانِ",7,"ن",1,0],["أم كلثوم في فنون الأغاني","أمةٌ وحدها بهذا الزمان",8,"ن",1,1],["أم كيف تَبتدع المعالي أمةٌ","في العلم قلّ نصيبها المفروض",9,"ض",1,0],["أَم كَلَّمَتكَ بِسُلمانينَ مَنزِلَةٌ","يا مَنزِلَ الحَيِّ جادَتكَ الأَهاضيبُ",10,"ب",1,0],["أَم كُنتَ يا بنَ زِيادٍ حينَ تَقتُلُهُ","بِغِرَّةٍ في فَضاءِ الأَرضِ مَجهولِ",11,"ل",1,0],["أم كلا المعنيَيْنِ فيك جميعاً","حين تحلو بالقِصة العَوْراءِ",12,"ا",2,0],["أمكن الخُمْصُ وقد خَاليتُها","من عناق كاد يأباه النُّهودُ",13,"د",1,0],["أم كيف يهتز امرؤٌ","غَرِضٌ بمهجته وعِرسه",14,"س",2,0],["أمَّكَ والشيخَ اللَئيم مَعْطسا","لا بُورِك الزوجان بل لا قُدِّسا",15,"س",2,0],["أم كُنتَ إلا كفارةٍ خَرَقَتْ","بَرْزخَ طامي الحِدابِ جيّاش",16,"ش",1,0],["أمكُّوكَ الخسار سأنتحيكا","بإحدى الفاقرات ولا أقيكا",17,"ك",2,1],["أمكن صدقُ القولِ فاعدُ المؤتفَكْ","واهتك وما نهتكُ إلا منهتَكْ",18,"ك",1,0],["أمكان وليس فيه أمان","وزمان وليس فيه ربيع",19,"ع",1,0],["أمكروب داءِ السل هل أنت عارف","لمن أنت تؤذي أو بمن أنت تنكل",20,"ل",1,0],["أمكن صاحبي من صحن خدي","وأعطى ذمتي من يشتريها",21,"ه",2,0],["أُمُّكَ النَفسُ قَديماً أَكرَمَت","وَأَبوكَ الفَضلُ خَيرُ المُنجِبين",22,"ن",1,0],["أم كيف آنسُ بالصِحَاب وقد رأتْ","عينايَ منهم قلَّةَ الإشفَاقِ",23,"ق",1,0],["أَم كَيفَ أَصبِرُ مُغتَرّاً بِأُمنِيَةٍ","وَالدارُ تَبعُدُ وَالآجالُ تَقتَرِبُ",24,"ب",1,0],["أَم كَيفَ يَخذُلُنِي مِن بَعدِ تَسمِيَتِي","بِاسمٍ لَهُ في سَماءِ العَرشِ مُحتَرَمِ",25,"م",1,0],["أُمكُث بَعَمرِكَ لَيلَةً وَتَأَنَّها","فَلَعَلَّ ما بَخِلَت بِهِ أَن يُبذَلا",26,"ل",2,0],["أَمكِنوهُ مِن ثَنِيَّتِها","لَم يُرِد خَمراً وَلا عَسَلا",27,"ل",2,0],["أم كَنْتَ للشرِّ ذُخراً","تَخشى الطّواغيتُ فَقْدَكْ",28,"ك",1,0],["أمكتوبٌ عليكنَّ القتالُ","لَكُنَّ الأمنُ إن فزعوا فزالوا",29,"ل",3,0],["أَم كَيفَ تَفتَخِرُ الجِيادُ بِأَعوَجٍ","فيكُم وَتَنتَسِبُ الرِماحُ لِسَمهَرِ",30,"ر",1,0],["أَم كَيفَ أَنسى مَسِيرنا حُرُماً","يَومَ حَلَلنا بِالنَخلِ مشن أَمَجِ",31,"ج",1,0],["أَم كَيفَ قَلبُكَ إِن ثَوَيتَ مُخامِراً","سَقَماً خِلافَهُمُ وَحُزنُكَ بادى",32,"د",2,0],["أمُكَلِّفِي نَظْمَ النَّسِيبِ وَقد رَأى","عُودَ الشَّبابِ الرَّطْب عادَ يَبِيسا",33,"س",2,0],["أَمكَنتُ عاذِلَتي في الخَمرِ مِن أُذُنٍ","يُغني صَداها جَواباً مَن يُناديها",34,"ي",3,0],["أَم كَيفَ لا كَيفَ لي بِحاضِنَتي","يا حِبُّ لَو كانَ يَنفَعُ الحَذَرُ",35,"ر",1,0],["أمْ كَيفَ أَسْلو غَادَةً ما حُبُّها","إِلّا قَضاءٌ ما لَهُ مَرْدودُ",36,"د",1,0],["أَم كانَ ما عيني تشا","هد من خَيالات اللَيالي",37,"ل",2,0],["أمك القبر لا تَصون كَما أَر","جو ملاحات تلكم الوجنات",38,"ت",1,0],["أمْ كنتِ صَيّرْتِها له كَفَناً","فتلكَ ليستْ مِن آلةِ الرَّجَم",39,"م",1,0],["أمْ كُنْتِ أوْدَعْتِها أخا ثِقَةٍ","فخانَ والخَوْنُ أقْبَحُ الشِّيَم",39,"م",1,0],["أَم كيفَ جِزتَ فُيوجاً حَولَهُم حَرَسٌ","وَمُترَصاً بابُهُ بالشَّكِّ صَرَّارا",40,"ر",2,0],["أَمْ كَيْفَ أَسْلُو وَلِي قَلْبٌ إِذَا الْتَهَبَتْ","بِالأُفْقِ لَمْعَةُ بَرْقٍ كَادَ يَلْتَهِبُ",41,"ب",1,0],["أَمَكَانُهُ هَذا أَتِلْكَ حُلِيُّهُ","وَالبَيْتُ خالٍ وَالمُقَلَّدُ عَارِي",42,"ر",2,0],["أَمكِنوهُ مِن ثَنِيَّتِها","لَم يُرِد سَمناً وَلا عَسَلا",43,"ل",2,0],["أَمكَنتُ عاذِلَتي مِن صَمتِ أَبّاءِ","ما زادَهُ النَهيُ شَيئاً غَيرَ إِغراءِ",44,"ا",2,1],["أم كان تنويمًا خضعوعهمو له؟","ما ذلك السرُّ العميقُ الخافي؟",45,"ف",2,0],["أم كيف يمكن سلواني فضائلها","نعم لدي لذا السلوان سلوان",46,"ن",1,0],["أم كيف يسلو عنك نشوان ومِن","كأس الغرام صَبوحهُ وغَبوقه",47,"ق",2,0],["أم كلا المعنين فيك جميعاً","حين تحلو بالقصة العوْراء",48,"ا",2,0],["أم كيفَ تسأل دمنة ً عادية َ","سفت الجنوبُ دمائها وثراها",49,"ا",3,0],["َأمكنُ عاشقي من صحن خدّي","وأعطي قُبلتي مَن يشتهيها",50,"ه",2,0],["أَمْ كيف لا يأْتى إلي","نا عنكم خبر يَسُرّْ",51,"ر",1,0],["أم كنتَ عُوداً عندَ مُستنقَعٍ","في نَبتةٍ تَمتَصُّ ماءَ الرِمَم",52,"م",1,0],["أَم كَيفَ حَالِى إِذ اُكُونُ بِحُفرَةٍ","مَهجُورَةٍ بِقَوَاتِمِ الأَعمَاقِ",53,"ق",1,0],["أمك نعسَى الآن هل تبتغي","شيئاً فيُقضَى لك طبق المراد",54,"د",1,0],["أم كيف يطمع في الصفاء فتىً له","بالطين والماء المهين تكوُّن",55,"ن",1,0],["أَم كَيفَ يَخشى جُموعَ المُفسِدينَ وَقَد","فَلَّ الصَوارِمَ سَيفٌ قَطُّ ما كَهِما",56,"م",2,0],["أم كيف يسلو المستهام وقلبه","في أسر مأسور الضريح رهينة",57,"ن",2,0],["أمُّ كلثوم زينب القاسم إبرا","هيمُ نعمَ البنات والأبناءُ",58,"ا",2,0],["أَم كَيفَ يَنفَعُ ما تُعطي العَلوقَ بِهِ","رِئمانَ أَنفٍ إِذا ما ضُنَّ بِاللَبَنِ",59,"ن",1,0],["أمكةُ هل ذنبٌ إليك جنيتهُ","سوى الحب من قلب تجسّم في دمعي",60,"ي",1,0],["أمكة داري كيف هاتيك دارة","يقول بها الشرك الأثيم فتخنع",61,"ع",1,0],["أم كيف ترجى نجاتي","من ساجيات الجفون",62,"ن",1,0],["أُمَكِّنُ صافِعي من لَطمِ خَدّي","وَأعطي ذِمَّتي من يَشتَريها",63,"ه",2,0],["أَم كيف أَسْطيع مكافاةَ مَنْ","أَسْخَطَ حُسَّادي وأَرضاني",64,"ن",2,0],["أمْ كِبْرَه صَلفاً أم لِينَهُ تَرَفاً","أم خَصْرَه هَيفاً أم رِدفَهُ ثِقَلا",65,"ل",2,0],["أَم كَيفَ أَشكُرُ ما أَولَيتَ مِن نِعَمٍ","قُبولُ شُكري عَلى إِسدائِها نِعَمُ",66,"م",1,0],["أَم كَيفَ يَخبو لِلشَوقِ في كَبِدي","نارٌ لَها نارُ خَدِّهِ مَدَدُ",67,"د",1,0],["أَمْ كيْفَ يُحْصَى عَلَى عُودِ الْبَخُورِ بُكَا","مَنْ كَانَ فِي الأَصْلِ مِنْ أَثْلٍ وَمِنْ خَشَبِ",68,"ب",1,0],["أَمْ كَانَ كُلٌّ مِنْهُمَا فِي حَقِّ مَا","جَلَبَ الأُجُورَ وَفَادِحَ الأَشْجَانِ",69,"ن",1,0],["أم كيف يعرج للسماء بجسمه","صُعُداً بلا سبب ولا أدراج",70,"ج",1,0],["أم كنت من رزق الهوى وهوانه","وحدي ومن حرم المنى والمؤنسا",71,"س",2,0],["ام كيف ييأس من روح الاله غدا","عبد عليه من الاسلام سربال",72,"ل",1,0],["أَم كَيفَنسلو في الغوير وَربعنا","شام وَربع النجدين يماني",73,"ن",2,0],["أَم كَيفَ لا تَهوى العَمى لك مقلةٌ","قد كنتَ قرَّتها وكنت سَناها",74,"ا",3,0],["أَم كان من صنيع كلٍ منهما","حُرُّ الثرى أثْنى وَجادَ ابنُ السما",75,"م",2,0],["أَم كُنتَ تَعرِفُ آياتِ فَقَد جَعَلَت","أَطلالُ إِلفِكَ بِالوَدكاءِ تَعتَذِرُ",76,"ر",1,0],["أم كيف أنسى غريبا صار قربهم","أقصى مرادي ومطاوبي ومرتادي",77,"د",2,0],["أم كيف أنسى لهم عهداً وقد منحوا","محض الوداد جادوا قبل إيجادي",77,"د",2,0],["أَم كيفَ أَجحد نعمةً أُوليتها","وَلِسانُها بالحالِ أصدق معلمِ",78,"م",1,0],["أَم كانَ في شكٍّ مريبٍ فليعد","نَظراً فداعيهِ المبينُ المسمعُ",79,"ع",1,0],["أَم كَيفَ يَسعى إِلى ما فيهِ نَكبَتُهُ","مَن لَم يَكُن في غِنى عَن نَهلَةِ الوَشَلِ",80,"ل",1,0],["أمُّ كلّ الأنام قَبضة طينٍ","فاعذر النور إن أبي أن يزيدا",81,"د",2,0],["أم كلثوم أي معجزة تس","بح في مائج من الأنغام",82,"م",1,0],["أم كلثوم أي نبع إلهي","هو الريُّ للقلوب الظوامى",82,"م",2,0],["أم كلثوم أيّ لحن من الخل","د صداه يسمو على الأفهام",82,"م",1,0],["أم كلثوم أي فرحة قلب","ناسك الشعر عبقريّ الهيام",82,"م",1,0],["أمّ كلثوم أيّ أغينة تن","دى حناناً على فم الأيام",82,"م",1,0],["أم كلثوم أي حلم سعيد","عطر الطيف عاشق الأنسام",82,"م",1,0],["أَم كُنوز مَملوءَة بِلآل","أَمرُموز في ضمنها أَسرار",83,"ر",1,0],["أم كيف يُمكِنُ فَوتُ ما أنا آمِلٌ","ولكَمْ رجَعْتُ بنَيْلٍ ما لم آمُل",84,"ل",1,0],["أَم كَيفَ خُضتَ مِنَ المَدامِعِ أَبحُراً","تَرمي زَواخِرُها بِشاطي الوَجنَةِ",85,"ه",1,0],["أم كلُّ قَلبٍ غيرَ قَلبي في الهَوى","ممَّا يُجِنُّ من الصَّبابَةِ هائِمُ",86,"م",1,0],["أم كذاكَ الظِّباء يُعرَفُ في نَظ","رَتِها مَن يضيفُ ممَّن يَشِيمُ",87,"م",1,0],["أَم كانَ شَوقي مثلَ طَيفِكَ كاذِباً","فعمَرتَ بَينَ الكاذِبينَ طَريقا",88,"ق",2,0],["أمَكَّرديجُ زد فضلاً","فأنت الفضل في الناس",89,"س",1,1],["أَم كَيفَ يَخمد جَمر بِالرِياح أَما","هَذا وَبالٌ جُنون الحُب جانيهِ",90,"ي",2,0],["أَم كَيفَ يَسمَح أَو يَفي","لِلحرّ دَهر غادِرُ",91,"ر",1,0],["أمكلّفي صَبراً جَميلاً في الْهوى","تَكْليفُ ما لاَ يُستطَاعُ قبيحُ",92,"ح",1,0],["أم كيف مصباح الهداية والهدى","متوارياً في تربةٍ ملحودا",93,"د",2,0],["أم كيف يبغي القرب من بعدت به","أيدي النوى ومفازة يهاء",94,"ا",2,0],["أَمُكَلَّلٌ وجهِي ووَجْهُكَ بارِزٌ","لِشَبا الأَسِنَّةِ والهواجِرُ تضطرِمْ",95,"م",1,0],["أَمكَنْتَ من رِقِّهِ الإِسلامَ مُحْتَكِماً","فِيهَا وأَسْلَمَها حَرَّانُ مُلْتَهِفُ",96,"ف",1,0],["أم كرات حيرت أهل الحجى","أم دنى دارت بترتيب بدي