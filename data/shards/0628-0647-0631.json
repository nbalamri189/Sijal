],"verses":[["بهرت فأخفيت الملوك وذكرها","ولا عجبٌ فالشمس تخفي الدراريا",0,"ي",2,0],["بهرت حسناً بها فحيث ترى","يقالُ ذا يوسفُ بنُ يعقوب",1,"ب",1,0],["بِهِ رُجُماتٌ بَينَهُنَّ مَخارِمُ","نُهوجٌ كَلَبّاتِ الهِجانِ تَفيحُ",2,"ح",1,0],["بِهِ رَحِمَ اللَهُ الجُنودَ فَأَقبَلَت","وَقَد مالَتِ الأَهواءُ كُلَّ مَميلِ",3,"ل",1,0],["بَهَرَت مَحاسِنُهُ العُقولَ فَما بَدا","إِلّا وَسَبَّحَ مَن رَآهُ وَكَبَّرا",4,"ر",2,0],["بَهَرَ المَلائِكَ في السَماءِ دِيانَةً","اللَهُ أَكبَرُ ما أَبَرَّ وَأَطهَرا",4,"ر",2,0],["بَهَرتَ عُقولَ السامِعينَ بِخُطبَةٍ","هِيَ الزَهَرُ المَبثوثُ وَاللُؤلُؤُ النَثرُ",5,"ر",1,0],["بِهِ رَكَزَ الرِماحَ بَنو تَميمٍ","عَشِيَّةَ حَلَّتِ الظُعُنُ النِسارا",6,"ر",2,0],["بهر النور عيوني فترفق","حين تدنو أنني لا أستطيع",7,"ع",1,0],["بَهَرَتكَ شيمَتُكَ الشَحاحُ زِنادُها","لَمّا اِحتَثَثتُكَ في اِتِّقاءِ النائِلِ",8,"ل",1,0],["بَهَرتِ جَمالاً فَرُعتِ البَصَر","وَذُبتُ سَقاماً فَفُتُّ النَظَر",9,"ر",1,1],["بَهَرَتهُ ساعَةُ فِرقَةٍ فَكَأَنَّما","في كُلِّ عُضوٍ مِنهُ قَلبٌ يَخفِقُ",10,"ق",1,0],["بهرت ويوم عمرك في شروقٍ","فدام ضحًى ولا بلغ الأصيلا",11,"ل",2,0],["بَهَرَ الْعُقْولَ وَزَادَ فِي إِعْجَابِهَا","بِفَضَائِلَ فِي سِنِّهِ لَمْ تَعْهَدِ",12,"د",1,0],["بَهَرَ النَّاسَ مِنْ فَضائِلِكَ الغُرِّ","شُعَاعٌ وَمِنْ حَلاَكَ شُعَاعُ",13,"ع",1,0],["بَهَرت الحِسانَ سَنا غُرَّةٍ","وَما خُطتَ حينَ فَشَوا خُوَّظا",14,"ظ",2,0],["بَهَرَ الوُجُودَ بلؤلؤيِّ ضِيَائهِ","نَجْمٌ تألَّقَ في بَدِيع سَمائِه",15,"ا",3,1],["بهر العذارى حسنَه فوددْن لو","صيغت قلائدهنّ من عقيانه",16,"ن",2,0],["بَهرْتِ بني الزمانِ حُلىً وحُسناً","ودلَّهتِ الأواخرَ والقدامَىَ",17,"م",2,0],["بَهَرَ الغَرْبَ طَلْعَةٌ مِنْك كادَتْ","تَتَمَشَّى شَوْقاً لها أَرْجَاؤه",18,"ا",3,0],["بَهْرْتَ رِجالَ العلمِ في الغَرْبِ فَانْثَنَوْا","إليكَ يَسوقونَ الثَناءَ المَنضَّدا",19,"د",2,0],["بُهِرَ الشعْرُ فانْثَنَى يَلثِمُ الأرْ","ضَ ويَدْعُو بالعِزِّ والإِقبال",20,"ل",1,0],["بَهَرتْ رِجالَ الغَرْب منك شَمائِلٌ","خُلُقٌ أَغَرُّ ورَاحةٌ مِدْرار",21,"ر",1,0],["بَهَرَ الشِّعْرَ أن يُحيط بمَعْنىً","مِن مَعانِي صِفاتِه الباهِراتِ",22,"ت",1,0],["بهر العذارى حسنُه، فوددن لو","صِيغَت فلائدُهُنَّ من عِقيانه",23,"ن",2,0],["بهرَ الساسةَ الدهاةَ حصيفٌ","ذائع الصيتِ بين كلِّ حصيف",24,"ف",1,0],["به راحت اسود الغاب مما","الكلاب روته تتخذ الحجاشا",25,"ش",2,0],["بهرت أنوارُ خلافتكم","وسماءُ العلم بها علمُ",26,"م",1,0],["بهرت عجائبه الخواطِرَ فاستوى","من كان فيها مجملاً ومفصلا",27,"ل",2,0],["بِهِ رُحتُ إِلى صَحبي","وَنَدماني أَبي كامِل",28,"ل",1,0],["بَهَرَ الوَرى بِالحُكمِ فيهِم حاكِماً","عَدلاً وَراعَهُمُ خَطيباً مِصقَعا",29,"ع",2,0],["بَهَرَتنا صِفاتُ مَجدِكَ حَتّى","قَصَّرَ الواصِفونَ عَنها نُكولا",30,"ل",2,0],["بهرت معاليك العراق ففارساًُ","فالشام فالفسطاط ثم الموصلا",31,"ل",2,0],["بهر العقولَ بديعُ مصنوعاتِهِ","لما تقدَّمها الدليلُ القاصد",32,"د",1,0],["بهر العقول بهاؤه وكماله","فضلا وحق لمثله أن يبهرا",33,"ر",2,0],["بَهراً لَها أَوَ ما دَرَت أَنّي الَّذي","يُدعى مَسَرَّتَها وَغَيظَ عِداتِها",34,"ت",3,0],["بِهِ راقَ الصَفاءُ لَدَيك لَمّا","أَعادَ لَكَ اِسمهُ عَهدُ السَمِيِّ",35,"ي",1,0],["بَهرتْ مَحاسُنك الورى","فأعادتِ الفُصحاءَ لُكنا",36,"ن",2,0],["بَهَرَ الناسَ مِنهُ خَلقٌ فَما الشَم","سُ وَخُلقٌ ما الرَوضَةُ الغَنّاءُ",37,"ا",2,0],["بَهَرتهُم أنوارهُ حيّرتهم","حبّذا حَيرةٌ هي الإهتداءُ",37,"ا",2,0],["بَهرَجتَ نفسَك والعيون بهارجٌ","عكفت عليك وأنت كالدِّينارِ",38,"ر",1,0],["بَهرَجتَ جسمك والظنون جهابذٌ","عُكفٌ عليك وأنت كالدينارِ",39,"ر",1,0],["بهرتْني أضدادُ فضلك لمَّا","أن تجمَّعن فيك شَفْعاً وَوِترا",40,"ر",2,0],["بَهَرَتْنِي أَبْيَاتُكَ الْغُرُّ بَلْ","آيَاتُكَ الْمُعْجِزَاتُ فِي التَّخْيِيلِ",41,"ل",1,0],["بهرته آيُ جلالِكُمْ","لِلَّهِ مَا أَسْنَى وَأَعْظَمْ",42,"م",1,0],["بَهَرَت صِفاتُكَ مادِحيك وَطالَما","وَقَد جاوَزَ الاحصاءَ أَن لا يبهرا",43,"ر",2,0],["بهر الخليقة فيك فضل بارع","والفضل يبهر كل من لم يبهر",44,"ر",1,0],["بِهِ رُدَّ نَحْوِي فائِتُ الْحَظِّ راغِماً","وَأَسْخَطَ فِيَّ الدَّهْرُ مَنْ كانَ أَرْضاهُ",45,"ا",2,0],["بَهَرَ الشَمسَ في الضُحى وَجهُهُ حُس","ناً وَيُزري بِأَوجِها أَزرارُه",46,"ر",2,0],["بَهَرَت عُقولَ العالَمينَ صِفاتُهُ","فَمُبَسمِلٌ مِن حَولِهِ وَمُعَوِّذُ",47,"ذ",1,0],["بهرت آياتُه إِذ ظهرَت","فَلَها بالسَعد إِشراقٌ ولَمحُ",48,"ح",1,0],["بَهَرتُ بَدائِعَهُ العُقو","لَ فَغَدا المُوَفَّقُ موقِنا",49,"ن",2,0],["بَهَرتُهُمُ وَأُفحِمَ ناطِقوهُم","كَما بَهَرَ المُحَمَّلَةَ الصُعود",50,"د",1,0],["بَهَرَتْ أَشِعَتُها فَلا شَمْسُ الضُّحَى","شَمْسُ الضُّحاءِ ولا السِّراجُ سِرَاجُ",51,"ج",1,0],["بِه رَأَيت ضِياء العرف منتَشِرا","مِن بَعد ما قلت مِصباح السَخاء طَفى",52,"ف",2,0],["بَهَرتْ آياتُها فانْقَسَمَ ال","حُسْنُ بينَ اللّفظِ والمعنى انْقساما",53,"م",2,0],["بَهَرنَ فَمِن قَومٍ عُقِدنَ خَناصِرٌ","عَلَيها وَمِن قَومٍ عُضِضن أَباهِم",54,"م",1,0],["بهَرْنَ فُلولاً ما بهِ من دِيانةٍ","لَخِلْناهُ قد أَوحَى بها سُوَراً تُتْلَى",55,"ل",2,0],["بهَرتْ أعينَ الورَى لشهابِ الدْ","دَين من نُورِ وَجْهِه الطّلْقِ سَطْعه",56,"ع",2,0],["بَهَرت فإن أطنَبْتُ كنتُ كُمُوجزٍ","عَجْزاًوإن أوجزتُ كنتُ كمُطنِب",57,"ب",1,0],["بهرن فَلو تَبَين عَلى حُسودٍ","لَقالَ بِغَيرِ شَهوَتِهِ أَجادا",58,"د",2,0],["به رجعت في عنفوان شبابها","ونضرتها من بعد ما هرمت مصر",59,"ر",1,0],["بهر العقول جميله وجمالُه","وجلاله وكماله وبهاؤه",60,"ا",3,0],["بَهْرَجَهُ صَيرف الخطوب إِذا","باشَرَهُ بالمَحَكِّ فَانَتَقَدَه",61,"د",2,0],["بَهَرَت مَحاسِنُكَ المَحاسِنَ كُلَّها","إِنّ السِراجَ سَنا الضُحى يُخفيهِ",62,"ي",2,0],["بَهَرَتْ مناقِبُكَ الضُّحى وتقاصَرَتْ","عن كُنْهِها الأَشباهُ والأَمثالُ",63,"ل",1,0],["بَهرَتْ فهنُّ عَلَى ابن يَحيى فِي الوغى","نورٌ لَهُ وَعَلَى ابن شنجٍ نارُ",64,"ر",1,0],["بِهِ رُدَّ فِي جَوِّ الخلافةِ نُورُها","وَقَدْ أَظْلَمَتْ منها قصورٌ وأوطانُ",65,"ن",1,0],["بهر المدائح جودُ عشركَ","لي وأعجز فضلُ آيك",66,"ك",1,0],["بهرام مفتاح لكل ناكث","أصبح في بحر النفاق شارعا",67,"ع",2,0],["بهر الجمال العاضدي خواطراً","خطر الخلافة عندهن جليل",68,"ل",1,0],["بهرت مناقب مجدك الأوهاما","واسعبدت حسناتك الأفهاما",69,"م",2,1],["بَهَرَتْكَ أَوّلَ مَوْقِفٍ","تَرَكَتْكَ للأشْجانِ حِلْفا",70,"ف",2,0],["بهرتنا صفاتُهُ ففنينا","وتساوى شروقه بالغروب",71,"ب",1,0],["بَهَرَ العُيُونَ إضاءةً في زُرْقَةٍ","فكأنّني مُتَخَتِّمٌ بعُطَارِدِ",72,"د",1,0],["بَهَرتْ وَقَدْ طَهُرَتْ سَناً وت