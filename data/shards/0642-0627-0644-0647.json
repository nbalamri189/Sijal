{"poems":[[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[91,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[85,"نظر الليث إلى عجل سمين","https://www.aldiwan.net/poem8041.html","الرمل"],[45,"ذكرتنيك روحة للشمول","https://www.aldiwan.net/poem65597.html","الخفيف"],[69,"أثر الحزن بقلبي أثرا","https://www.aldiwan.net/poem29053.html","الرمل"],[31,"عاود القلب من تذكر جمل","https://www.aldiwan.net/poem41275.html","الخفيف"],[105,"اسألي يا نجد أهل الميفعه","https://www.aldiwan.net/poem43578.html","الرمل"],[105,"جرد السيف أبا بكر فما","https://www.aldiwan.net/poem43579.html","الرمل"],[105,"يوم بدر وأنت أعلى مقاما","https://www.aldiwan.net/poem44220.html","الخفيف"],[50,"يا لقوم للزائر المنتاب","https://www.aldiwan.net/poem64812.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30441","الرمل"],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[91,"أفاتحة أم ختام","https://www.poetsgate.com/ViewPoem.aspx?id=53303",""],[90,"جلوة المعشوق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64318&r=&rc=97",""],[200,"جاءها خاطبا وبين يديه","https://www.aldiwan.net/poem45534.html","الخفيف"],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[343,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[401,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[404,"وخليل رأى من الناس جمعا","https://www.aldiwan.net/poem33373.html","الخفيف"],[417,"قال لي صاحبي ونحن بسلع","https://www.aldiwan.net/poem53832.html","الخفيف"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[454,"ها هو الشحاذ لصق البنك","https://www.aldiwan.net/poem61577.html","مجزوء الرمل"],[454,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[469,"عندنا زهرة لها إشراق","https://www.aldiwan.net/poem59831.html","الخفيف"],[501,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"]],"verses":[["قالَ هَجِّدنا فَقَد طالَ السُرى","وَقَدَرنا إِن خَنى دَهرٍ غَفَل",0,"ل",1,0],["قال هون عنك الأسى يابن عبد","الله واحقن لنا كريم الدماء",1,"ا",2,0],["قالَ هَل تَشتَهي الوُصولَ إِلَيها","قُلتُ إِنّي لا أَشتَهي إِلّاها",2,"ا",3,0],["قالَ هَل تَجهَلُ يا حُلوَ الصِفات","أَنَّ مَولانا أَبا الأَفيالِ مات",3,"ت",1,0],["قالَ هَذا لَنا وَنَحنُ فَتَقنا","غَيبَهُ لِلسائِلِ وَالمَسؤولِ",4,"ل",1,0],["قال هذي عورةٌ قد سُترتْ","قلت لا بل ذاكَ بعضي قُبِرا",5,"ر",2,0],["قالَ هارونُ قِف فَيا لَيتَ أَنّي","كُنتُ طاوَعتُ ساعَةً هارونا",6,"ن",2,0],["قال هل شَقَّ الفتى عن قلبهِ","فَيرى السِّرَّ ويَدْرِي مَوضِعَهْ",7,"ع",2,0],["قال هَبْها لي فلم يَبخلْ بها","ومضى من أمرِها ما سَدَّدا",8,"د",2,0],["قال هذا بَطْنِي لِبطنِكَ كُفؤٌ","فَاسْتَقِدْ إنَّ للضّعيفِ ذِماما",9,"م",2,0],["قالَ هَجرُ الحَبيبِ يُسليكَ عَنها","لَن تَنالَ السُلُوَّ قَبلَ اِجتِنابِ",10,"ب",1,0],["قال هلا كسبت غير المعاصي","قلت إن لم أكسب فربي غفورُ",11,"ر",1,0],["قال هل صدقت النبيين فيما","بلغوه ولم يُعقْكَ الغرورُ",11,"ر",1,0],["قال هل كنت للصلاة مقيماً","قلت عنها ما إن عراني فتورُ",11,"ر",1,0],["قال هل صمت الشهر من رمضان","قلت قد صمته وطاب الفطورُ",11,"ر",1,0],["قال هل كنت للزكاة بِمُؤتٍ","قلت ما كان بي لها تأخيرُ",11,"ر",1,0],["قال هل كنت للجهاد خفيفاً","قلت إني لبالجهادِ فخورُ",11,"ر",1,0],["قال هل كنت قائلاً بنشورٍ","قلت ربي على النشور قديرُ",11,"ر",1,0],["قال هل في السفور نفعٌ يرجَّى","قلت خيرٌ من الحجاب السفور",11,"ر",1,0],["قال هل في الإله عندك شك","قلت لا والذي إليه المصير",11,"ر",1,0],["قال هذا هو الهراء وما إن","لاحتجاجٍ تلغو به تأثير",11,"ر",1,0],["قالَ هذا العَبْدُ مَن دَلَّلَهُ","ما الَّذِي أَمَّنَهُ مِن غَضَبي",12,"ب",2,0],["قال هل القنَّه قلتُ : تَعْيَا","قال : حتى غباره قلتُ : نَحسْا",13,"س",2,0],["قالها في رثاء الاسقف","عمانوئيل أبو حطب",14,"ب",1,1],["قال : هذا سنةٌ توجبها","جلوةُ المعشوقِ في يومِ الوصال",15,"ل",1,0],["قال هذا المشيبُ نورٌ فقالتْ","أوقدوا في السراجِ هذا المشيبا",16,"ب",2,0],["قالَ هَل هزّك اِشتياقٌ إليهِ","قلتُ أي واِستفزّني وشجاني",17,"ن",2,0],["قال هذا مستحيل","ان هذا لن يكون",18,"ن",1,0],["قالها الطفلُ، وقُلنا معه","إنَّ بيعَ القدس بَيعُ الخاسرين",19,"ن",1,0],["قال هلا نبهتهم عن هواهم","قلت ذرهم في خوضهم يلعبونا",20,"ن",2,0],["قالها والغرامُ يوقِدُ في القلب","ولوعاً ويَضْرِمُ النيرانا",21,"ن",2,0],["قال هل هذي مصابيح الدجى","أم دنانير على وجه الرقيع",22,"ع",1,0],["قال هذي جنة قد حجبت","عن عيون الأنس من يضع دهور",22,"ر",1,0],["قال هذي رأس مالي بل","هي الكنز الحقيقي",23,"ي",1,0],["قال هل تقسمون ذلك عهدٌ","فأجابوا أجل لساناً وقلبا",24,"ب",2,0],["قالَهُ فَالعَيشُ مِن عُداةِ التَواني","مِثلَ البَدرِ مِن عُداةِ المِحاقُ",25,"ق",1,0],["قالَ هل تنظِمُ المَعاني رِقاقاً","قلتُ تَظْمَ العُقودِ قالَ بعِقْدِي",26,"د",2,0],["قالَ هل تشرَحُ العُهودَ بنشْرٍ","قلت دُرًّا فقال طِرزاً بعَهْدِي",26,"د",2,0],["قالَ هل ترتَجي الوُجودَ بقبْلٍ","أَو ببعْدٍ فقلتُ لا قالَ عَبْدِي",26,"د",2,0]]}