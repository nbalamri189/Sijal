wan/poem/130390","الرمل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139944","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112319","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48348","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92286","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85083","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128940","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128882","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32904","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111457","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125876","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125899","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133163","الرمل"],[4791,"السكوت ارحم","https://www.poetsgate.com/ViewPoem.aspx?id=36949",""],[5056,"<< هذيانُ شاعر..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33175",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[585,"لا تلوموا مولعاً مضطربا","https://www.poetsgate.com/ViewPoem.aspx?id=161861",""],[5072,"حوار","https://www.poetsgate.com/ViewPoem.aspx?id=53580",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5198,"الممكن المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=135392",""],[5220,"مزحة شباب","https://www.poetsgate.com/ViewPoem.aspx?id=25569",""],[5277,"أنت عمري","https://www.poetsgate.com/ViewPoem.aspx?id=185801",""],[5431,"قال يوما أحبها للرياح....","https://www.poetsgate.com/ViewPoem.aspx?id=199598",""],[5431,"إنّ ربي بمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=213011",""],[5461,"استريحي يا الظنون الثايرة","https://www.poetsgate.com/ViewPoem.aspx?id=503",""],[5463,"عشق الثماله","https://www.poetsgate.com/ViewPoem.aspx?id=25225",""],[5480,"(هذا الزمن) في غلاء المهور","https://www.poetsgate.com/ViewPoem.aspx?id=4166",""],[5536,"المسيح ومريم العذرا وجذع النخلة!!","https://www.poetsgate.com/ViewPoem.aspx?id=27505",""],[5596,"طبع الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=205611",""],[5616,"حينما التقيك","https://www.poetsgate.com/ViewPoem.aspx?id=207395",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[5691,"قالها شافيز...!","https://www.poetsgate.com/ViewPoem.aspx?id=207080",""],[5885,"ذرة في الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=194689",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""]],"verses":[["قالَ هَجِّدنا فَقَد طالَ السُرى","وَقَدَرنا إِن خَنى دَهرٍ غَفَل",0,"ل",1,0],["قال هون عنك الأسى يابن عبد","الله واحقن لنا كريم الدماء",1,"ا",2,0],["قالَ هَل تَشتَهي الوُصولَ إِلَيها","قُلتُ إِنّي لا أَشتَهي إِلّاها",2,"ا",3,0],["قالَ هَل تَجهَلُ يا حُلوَ الصِفات","أَنَّ مَولانا أَبا الأَفيالِ مات",3,"ت",1,0],["قالَ هَذا لَنا وَنَحنُ فَتَقنا","غَيبَهُ لِلسائِلِ وَالمَسؤولِ",4,"ل",1,0],["قال هذي عورةٌ قد سُترتْ","قلت لا بل ذاكَ بعضي قُبِرا",5,"ر",2,0],["قالَ هارونُ قِف فَيا لَيتَ أَنّي","كُنتُ طاوَعتُ ساعَةً هارونا",6,"ن",2,0],["قال هل شَقَّ الفتى عن قلبهِ","فَيرى السِّرَّ ويَدْرِي مَوضِعَهْ",7,"ع",2,0],["قال هَبْها لي فلم يَبخلْ بها","ومضى من أمرِها ما سَدَّدا",8,"د",2,0],["قال هذا بَطْنِي لِبطنِكَ كُفؤٌ","فَاسْتَقِدْ إنَّ للضّعيفِ ذِماما",9,"م",2,0],["قالَ هَجرُ الحَبيبِ يُسليكَ عَنها","لَن تَنالَ السُلُوَّ قَبلَ اِجتِنابِ",10,"ب",1,0],["قال هلا كسبت غير المعاصي","قلت إن لم أكسب فربي غفورُ",11,"ر",1,0],["قال هل صدقت النبيين فيما","بلغوه ولم يُعقْكَ الغرورُ",11,"ر",1,0],["قال هل كنت للصلاة مقيماً","قلت عنها ما إن عراني فتورُ",11,"ر",1,0],["قال هل صمت الشهر من رمضان","قلت قد صمته وطاب الفطورُ",11,"ر",1,0],["قال هل كنت للزكاة بِمُؤتٍ","قلت ما كان بي لها تأخيرُ",11,"ر",1,0],["قال هل كنت للجهاد خفيفاً","قلت إني لبالجهادِ فخورُ",11,"ر",1,0],["قال هل كنت قائلاً بنشورٍ","قلت ربي على النشور قديرُ",11,"ر",1,0],["قال هل في السفور نفعٌ يرجَّى","قلت خيرٌ من الحجاب السفور",11,"ر",1,0],["قال هل في الإله عندك شك","قلت لا والذي إليه المصير",11,"ر",1,0],["قال هذا هو الهراء وما إن","لاحتجاجٍ تلغو به تأثير",11,"ر",1,0],["قالَ هذا العَبْدُ مَن دَلَّلَهُ","ما الَّذِي أَمَّنَهُ مِن غَضَبي",12,"ب",2,0],["قال هل القنَّه قلتُ : تَعْيَا","قال : حتى غباره قلتُ : نَحسْا",13,"س",2,0],["قالها في رثاء الاسقف","عمانوئيل أبو حطب",14,"ب",1,1],["قال : هذا سنةٌ توجبها","جلوةُ المعشوقِ في يومِ الوصال",15,"ل",1,0],["قال هذا المشيبُ نورٌ فقالتْ","أوقدوا في السراجِ هذا المشيبا",16,"ب",2,0],["قالَ هَل هزّك اِشتياقٌ إليهِ","قلتُ أي واِستفزّني وشجاني",17,"ن",2,0],["قال هذا مستحيل","ان هذا لن يكون",18,"ن",1,0],["قالها الطفلُ، وقُلنا معه","إنَّ بيعَ القدس بَيعُ الخاسرين",19,"ن",1,0],["قال هلا نبهتهم عن هواهم","قلت ذرهم في خوضهم يلعبونا",20,"ن",2,0],["قالها والغرامُ يوقِدُ في القلب","ولوعاً ويَضْرِمُ النيرانا",21,"ن",2,0],["قال هل هذي مصابيح الدجى","أم دنانير على وجه الرقيع",22,"ع",1,0],["قال هذي جنة قد حجبت","عن عيون الأنس من يضع دهور",22,"ر",1,0],["قال هذي رأس مالي بل","هي الكنز الحقيقي",23,"ي",1,0],["قال هل تقسمون ذلك عهدٌ","فأجابوا أجل لساناً وقلبا",24,"ب",2,0],["قالَهُ فَالعَيشُ مِن عُداةِ التَواني","مِثلَ البَدرِ مِن عُداةِ المِحاقُ",25,"ق",1,0],["قالَ هل تنظِمُ المَعاني رِقاقاً","قلتُ تَظْمَ العُقودِ قالَ بعِقْدِي",26,"د",2,0],["قالَ هل تشرَحُ العُهودَ بنشْرٍ","قلت دُرًّا فقال طِرزاً بعَهْدِي",26,"د",2,0],["قالَ هل ترتَجي الوُجودَ بقبْلٍ","أَو ببعْدٍ فقلتُ لا قالَ عَبْدِي",26,"د",2,0],["قال هلاَّ ارضيتِ بعضَ رفاقي","فقوامُ الرؤوس بالاعضاءِ",27,"ا",2,0],["قالَ هات ذَهَب وَدورُ لَك","فَقُلتُ لَو تَخشى در",28,"ر",1,0],["قال هذا خير ما ارتا","ض به الراجي كمالا",29,"ل",2,0],["قال هذا يدعى","ضُمَّني لا أُطْفَا",30,"ف",2,0],["قالَ هَل موفيكَ غَير عَذول","قَالَ عَدّى مِن قَبلهِ ستُّونا",31,"ن",2,0],["قالَ هُنا لا تدخل الأساةُ","وَلا تمدُّ رجلَها الرُقاةُ",32,"ه",1,0],["قال هل جازتك قنبلة","حولها الأجناد والحرس",33,"س",1,0],["قال هذا محمدٌ ذلك الصا","لحُ قد عادَ شخصه منشورا",34,"ر",2,0],["قال هذا لنا ونحن كشفنا","عنه للمستدل والمسؤول",35,"ل",1,0],["قال هل كلكم مثلى ألم","تعلموا الدمع على غيرى حراما",36,"م",2,0],["قال هل يستطيعُ قومٌ كفرُوا","عملَ الإيمان من غيرِ وطر",37,"ر",1,0],["قال هذا الفتى يكون لاسقا","ط وانهاض اكثر الفتيان",38,"ن",1,0],["قَالَهُ الحق وأعلام الهدى","وحيا الخلق وفرسان الصَّباح",39,"ح",1,0],["قالَهُ الصَّادقُ الحديثُ ولن يف","ترِقا دون حوضِهِ واردينِ",40,"ن",1,0],["قالَ هُم يَلبِسونَ أَثوابَ حَملا","نٍ ذِئابَ بَينا هُمُ أَنبِياءُ",41,"ا",2,0],["قال هيهات أنت والنحس تربا","ن وقد كنتما رضيعي لبان",42,"ن",1,0],["قال هذا السر في حرز النهى","من بني جنسي دفينٌ يبطن",43,"ن",1,0],["قال هذا حيوان","ذو حياة مستقره",44,"ر",2,0],["قال هذا مرسل الحب يتلو","ولقد جاءك من نبأ المر",45,"ر",1,0],["قال هذا ليس نصرا","إنه درس ثمين",46,"ن",1,0],["قال هب نفسك ميتا","ثم قل لي ما الحياة",47,"ه",1,0],["قال هب نفسك عفري","تا من الجن قدير",47,"ر",1,0],["قال هوّن عليك عندي دواء","خذه إن لم تجد به من باس",48,"س",1,0],["قال هلاّ اشتريت منيَ زهراً","ضمّ أبهى شقائقٍ وورود",49,"د",1,0],["قال هذا حكم الطبيعة جار","منذ كانت وماله تحريف",50,"ف",1,0],["قال هذه حرارة الإيمان","قلت : لا بل حرارة الإفلاس",51,"س",1,0],["قال هذا رزق أتاني صباحاً","فغدا يشكر الإله الحميدا",52,"د",2,0],["قال هَذا وَاِختَفى عَن ناظِري","مِثلَما الدُّخانُ تذريهِ الرِّياح",53,"ح",1,0],["قاله المختار حقاً","ناصحاً صحباً وعتره",54,"ر",2,0],["قاله عامَ ستةٍ وثمانين","وستٍ من المئات مجازه",55,"ز",2,0],["قال هاكَ القمحَ كُلهُ فمشى","ذلك العصفورُ للقمح سعيد",56,"د",1,0],["قال هلْ يُقْنِعُ المشوقَ خيالٌ","قلتُ لوْلا أنّ الخَيالَ كَذوبُ",57,"ب",1,0],["قال هَلْ طابَ بعدَها لكَ عيشٌ","قلتُ دون الوِصالِ كيفَ يَطيبُ",57,"ب",1,0],["قال هل حالَ منكَ بالبُعْدِ حالٌ","قلتُ حالِي مَدامِعٌ ونَحيبُ",57,"ب",1,0],["قال هل تنقَعُ الدموعُ غَليلاً","قلتُ طيَّ الضّلوعِ منْها لَهيبُ",57,"ب