{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[55,"ألا ذهبت فوز بعقل أبي الفضل","https://www.aldiwan.net/poem26189.html","الطويل"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[91,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[46,"خلافك بعض الناس يرجى به المنى","https://www.aldiwan.net/poem23285.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[58,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""]],"verses":[["أَلا ذَكَرتَ إِن طَلَبتَ أُسوَةً","ما يَضمَنُ الأُسوَةَ لِلقَلبِ الضَمِن",0,"ن",1,0],["أَلا ذَهَبَت فَوزٌ بِعَقلِ أَبي الفَضلِ","وَما خِلتُ إِنساناً يَعيشُ بِلا عَقلِ",1,"ل",1,1],["أَلا ذَهَبَ المُحافِظُ وَالمُحامي","وَمانِعُ ضَيمِنا يَومَ الخِصامِ",2,"م",1,1],["إلاَّ ذوي كلمٍ لو أنَّ محتسباً","تكلمت من جميع القوم هامات",3,"ت",1,0],["أَلاَ ذلكَ الفتْحُ المبين هَنَاؤه","فَتَمَّ وَلاَقَاهُ يَزِيدٌ ومَزْيَدُ",4,"د",1,0],["ألاَ ذَلِكَ الفوْز الذي لا إخاله","على غيره من سائر القوم يُحْشَدُ",4,"د",1,0],["ألا ذاك بناء الحياض ورودها","ألا ذاك حلاب اللقاح رضوعها",5,"ع",3,0],["ألا ذاكَ مجَّاجُ السُّلافِ علمتُه","وإني لمجاجٌ لما ليس بالنطلِ",6,"ل",1,0],["إِلّا ذَوُّ السِحَنِ السَوداءِ واعَجَباً","أَجَنَّةٌ وَذُبابٌ في نَواحيها",7,"ي",3,0],["الإذنُ جاءَ فقل لقومِكَ أقبلوا","بالبيضِ تَبرقُ والصّوافنِ تَضبحُ",8,"ح",1,0],["أَلا ذَلِّلوا هَذي النُفوسَ فَإِنَّها","رَكائِبُ سوءٍ لَيسَ يَضبِطُها الحَزمُ",9,"م",1,0],["ألا ذكِّريهِ بمثَّاله","ونادي بحيَّتِهِ الخالدهْ",10,"ه",1,0],["الاذن والعين لم تسمع ولم تره","ولم يجر في قلوب الخلق ما فيها",11,"ي",3,0]]}