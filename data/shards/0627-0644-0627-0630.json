{"poems":[[55,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[57,"ألا ذهبت فوز بعقل أبي الفضل","https://www.aldiwan.net/poem26189.html","الطويل"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[93,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[48,"خلافك بعض الناس يرجى به المنى","https://www.aldiwan.net/poem23285.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[60,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""],[93,"فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53393",""],[190,"ألا ذرفت عيني ودام سجومها","https://www.aldiwan.net/poem43334.html","الطويل"],[215,"أعوذ بالله من يوم تصول به","https://www.aldiwan.net/poem46586.html","البسيط"],[228,"رفينا تعالي كأس خمر ونارة","https://www.aldiwan.net/poem41628.html","الطويل"],[434,"ألا ذهب الحلال في القفرات","https://www.aldiwan.net/poem769.html",""],[482,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[545,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[592,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122694","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66852","المتقارب"],[1157,"","https://poetry.dctabudhabi.ae/diwan/poem/102900","الطويل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20577","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33863","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116500","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127912","البسيط"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28858","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94573","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4729,"رأى البرقَ غَوري الوميِض فأنجدا","https://www.poetsgate.com/ViewPoem.aspx?id=109441",""],[6053,"تِلْكَ الرِّسَالَةُ ... !","https://www.poetsgate.com/ViewPoem.aspx?id=197035",""],[6068,"‫أقسمت في جنح الظلام ونوم‬-14-","https://www.poetsgate.com/ViewPoem.aspx?id=175857",""],[6134,"الا ذا الجمال اليوم اصبح مهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=169554",""]],"verses":[["أَلا ذَكَرتَ إِن طَلَبتَ أُسوَةً","ما يَضمَنُ الأُسوَةَ لِلقَلبِ الضَمِن",0,"ن",1,0],["أَلا ذَهَبَت فَوزٌ بِعَقلِ أَبي الفَضلِ","وَما خِلتُ إِنساناً يَعيشُ بِلا عَقلِ",1,"ل",1,1],["أَلا ذَهَبَ المُحافِظُ وَالمُحامي","وَمانِعُ ضَيمِنا يَومَ الخِصامِ",2,"م",1,1],["إلاَّ ذوي كلمٍ لو أنَّ محتسباً","تكلمت من جميع القوم هامات",3,"ت",1,0],["أَلاَ ذلكَ الفتْحُ المبين هَنَاؤه","فَتَمَّ وَلاَقَاهُ يَزِيدٌ ومَزْيَدُ",4,"د",1,0],["ألاَ ذَلِكَ الفوْز الذي لا إخاله","على غيره من سائر القوم يُحْشَدُ",4,"د",1,0],["ألا ذاك بناء الحياض ورودها","ألا ذاك حلاب اللقاح رضوعها",5,"ع",3,0],["ألا ذاكَ مجَّاجُ السُّلافِ علمتُه","وإني لمجاجٌ لما ليس بالنطلِ",6,"ل",1,0],["إِلّا ذَوُّ السِحَنِ السَوداءِ واعَجَباً","أَجَنَّةٌ وَذُبابٌ في نَواحيها",7,"ي",3,0],["الإذنُ جاءَ فقل لقومِكَ أقبلوا","بالبيضِ تَبرقُ والصّوافنِ تَضبحُ",8,"ح",1,0],["أَلا ذَلِّلوا هَذي النُفوسَ فَإِنَّها","رَكائِبُ سوءٍ لَيسَ يَضبِطُها الحَزمُ",9,"م",1,0],["ألا ذكِّريهِ بمثَّاله","ونادي بحيَّتِهِ الخالدهْ",10,"ه",1,0],["الاذن والعين لم تسمع ولم تره","ولم يجر في قلوب الخلق ما فيها",11,"ي",3,0],["إلاّ ذوو السحن السوداء واعجبا","أجنّة وذباب في نواحيها ؟",12,"ي",3,0],["ألا ذرفت عيني ودام سجومها","وأفقدها طيب المنام منيمها",13,"م",3,1],["ألاذهم بتجنيه فأهلكهم","عيبٌ عليهم فظيع إن همو عادوا",14,"د",3,0],["أَلا ذَوِّبي إِن شِئتِ جَورَكِ في الهَوى","وَهذا فُؤادي يَشهَدُ اللَهُ فَاِسكُبي",15,"ب",2,0],["أَلا ذَهَبَ الحُلاّلُ في القَفَرات","وَمَن يَملأُ الجَفناتِ في الجَحَراتِ",16,"ت",1,1],["اِلاّ ذكرتُ زماناً كانَ يجمعُنا","والدهرُ بالأهلِ والأُلاّفِ ما وَلَعا",17,"ع",2,0],["إِلّا ذكرتُ ابنَ زيدٍ وَهوَ ذو صِلَةٍ","عند السنين وَعوّادٌ عَلى الزمَنِ",18,"ن",1,0],["ألا ذهب الحبر المحبب في الورى","مجدد أصل الدين غيظ المناظر",19,"ر",1,0],["آلٌ إذا افتَخَرَت ضاقَت بِفَخرِهُم الآ","فاقُ لَو زيدَ في الآفاقِ آفاقُ",20,"ق",1,0],["ألا ذا إذا مِتُّ مولاكُم","فأفهمَهُ العُرْبَ والأعجميّا",21,"ي",2,0],["ألا ذهب الغزو المقرب للغنى","ومات الندى والجود بعد المهلب",22,"ب",1,1],["أَلا ذَرَفَت مِن مُقلَتَيكَ دُموعُ","وَقَد بانَ مِن حَبلِ الشَبابِ قُطوعُ",23,"ع",1,1],["أَلا ذَهَبَ الأَيرُ الَّذي كانَ مَرَّةً","يُساعِدُني فيما أُريدُ وَيُسعِفُ",24,"ف",1,0],["الا ذاك مهدى الانام محمد","خدين الهدى اعلا مسن الرواتب",25,"ب",1,0],["الا ذاك عبد اللّه نجل محمد","فاكرم به من حاضر غير غائب",25,"ب",1,0],["ألا ذوو نجدة ألا ذوو همم","ألا ذوو غيرة للحق أعوان",26,"ن",1,0],["أَلا ذَكِّراني يا خَليلَيَّ ما قَضى","مِنَ العَيشِ إِذ لَم يَبْقَ إِلّا تَذَكُّري",27,"ر",2,1],["ألا ذا معجب أن شمت عندي","ملائكة السماءِ بلا خمورِ",28,"ر",1,0],["إلا ذكرت الخرود","وحجرها والمقام",29,"م",1,0],["ألاذ بموموق الهدى باهر العلى","كريم القرى طلقِ النقيبة أوحدا",30,"د",2,0],["الأُذْنُ تَشْرَبُ سُكْرَهَا فَرَحًا","وَالرُّوحُ قَيْدُ النُّورِ فِي الفَلَكِ",31,"ك",1,0],["‫إلا ذكرت سميّها في شطره‬","ذكرا صريحا دون لبس عقيم‬",32,"م",1,0],["الا ذا الجمال اليوم اصبح مهلاً","افي رأس جمال يبين لي السر",33,"ر",1,1]]}