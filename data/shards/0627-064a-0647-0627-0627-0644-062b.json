{"poems":[[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[87,"أيها الثغر بلغت الأملا","https://www.aldiwan.net/poem7143.html","الرمل"],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[230,"أبصر الثعلب الغراب على غص","https://www.aldiwan.net/poem55143.html","الخفيف"],[333,"يتناهى الأنام والأيام","https://www.aldiwan.net/poem54925.html","الخفيف"],[543,"أيها الثقلاء بالله فينا","https://www.aldiwan.net/poem48314.html","عموديه"],[556,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133784","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81275","المتقارب"],[5274,"دموع القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=203255",""],[5970,"أيها الثاوي الذي ليس يزار","https://www.poetsgate.com/ViewPoem.aspx?id=130675",""],[1100,"أترى انت دليلي تهت من فكر ضليل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612986",""]],"verses":[["أيها الثاوي في حفير وطيء","إن مجدا بنيته لرفيع",0,"ع",1,0],["أيها الثغر بلغت الأملا","قم إلى الركب وزف المحملا",1,"ل",2,1],["أيُّّها الثاوونَ في جَولاتكم","طِبْتُمُ مَثوى ً وعُطّرتُمْ مجالا",2,"ل",2,0],["أَيُّها الثَعلَبُ ارتَحِل لا هَنِيئاً","لا مَريئاً أَلأمَ اللُؤماءِ",3,"ا",2,0],["أيها الثائر المحرر ماذا","من معانيك تدرك الأفهام",4,"م",1,0],["أيها الثُّقلاَءُ باللَّهِ فينَا","إتقُوا اللهَ أيهَا الثُّقَلاءُ",5,"ا",2,1],["أيّها الثّاكل المحبّةَ لا تث","كلْ جزاءً عنها طويلاً كُثارا",6,"ر",2,0],["أيها الثاكل في جن","بيّ يا رجع هديل",7,"ل",1,0],["أيُّها الثاقب نوراً كلَّما","قصدوا إطفاءه زاد ثُقوبا",8,"ب",2,0],["أَيُّها الثاوي عَلى بلقعة","وَالمَواري بَينَ هاتيك الحُفَر",9,"ر",1,0],["أيُّهَا (الثغْر)ُ مالذّي حَلّ قلّ لي","كيْف تَصْفُوْ قلوبُنَا وهْيَ تُعْصَرْ",10,"ر",1,0],["أيها الثاوي الذي ليس يزار","أو ما أستوحشت من هذا القرار",11,"ر",1,1],["أيها الثاوي الذي لم يستمع","غير ذؤبان بقاع تستثار",11,"ر",1,0],["أيها الثاكل في جنبيّ يا رجع هديل","أقصر اليوم فكم شيعت من حلم جميل",12,"ل",1,0]]}