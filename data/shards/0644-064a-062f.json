{"poems":[[95,"فوجئت فيك بأنكر الأنباء","https://www.aldiwan.net/poem9849.html","الكامل"],[95,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[94,"يود الفتى لو خاض عاصفة الردى","https://www.aldiwan.net/poem38955.html","الطويل"],[87,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[45,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[47,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[47,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[47,"باكرتنا بواكر الوسمي","https://www.aldiwan.net/poem66865.html","الخفيف"],[30,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[30,"عجبت لحادينا المقحم سيره","https://www.aldiwan.net/poem5310.html","الطويل"],[51,"كل على الدنيا له حرص","https://www.aldiwan.net/poem62136.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55009","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55014","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54538","الكامل"],[136,"لعبت بعد ما انقضى الريعان","https://www.aldiwan.net/poem54719.html","الخفيف"],[139,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[147,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[275,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[276,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[408,"أَنا والله مغرم","https://www.aldiwan.net/poem46703.html","مجزوء الخفيف"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[500,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[521,"لعمري على فوت لاية نظرة","https://www.aldiwan.net/poem48604.html","الطويل"],[543,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[580,"","https://poetry.dctabudhabi.ae/diwan/poem/47713","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130195","الخفيف"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145601","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48499","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63955","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38828","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77639","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120075","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202123","الطويل"],[1142,"","https://poetry.dctabudhabi.ae/diwan/poem/27077","الطويل"],[1256,"","https://poetry.dctabudhabi.ae/diwan/poem/146034","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56623","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108788","الكامل"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115298","الخفيف"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101427","الخفيف"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131320","الرمل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199821","المسحوب"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47165","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77296","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93532","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106988","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137056",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70359","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202008","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201428","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204591","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65347","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132587","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97998","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48355","الخفيف"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205645","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66590","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69956","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86392","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94472","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94327","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81264","الخفيف"],[4737,"التنوير","https://www.poetsgate.com/ViewPoem.aspx?id=212156",""],[4767,"وزير الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=178353",""],[4802,"سنابل قمح","https://www.poetsgate.com/ViewPoem.aspx?id=32338",""],[4922,"لي دينٌ في هواه","https://www.poetsgate.com/ViewPoem.aspx?id=16527",""],[5038,"البضعة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=196622",""],[5072,"إدانة الصفصاف","https://www.poetsgate.com/ViewPoem.aspx?id=55364",""],[5092,"العيش في ذكرى الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=153631",""],[5092,"لوحة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=178843",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5431,"أحجية...","https://www.poetsgate.com/ViewPoem.aspx?id=213354",""],[5525,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=847",""],[5564,"ياللْه يا كافي الأمور الشدايد","https://www.poetsgate.com/ViewPoem.aspx?id=186845",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5725,"اذّن الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=178817",""],[5758,"العاتِرِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=200505",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[5997,"ليداء","https://www.poetsgate.com/ViewPoem.aspx?id=214977",""],[6093,"إِذَا وَعَظَ المَوْتُ الحَيَاةَ ( الطّويل )","https://www.poetsgate.com/ViewPoem.aspx?id=187181",""],[6160,"مَرايا لِعُروَة ابنِ الوَرد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87098&r=&rc=15",""]],"verses":[["ليدم لهم أخواك بعدك سلوةً","وينرهم أثراك في الغلماء",0,"ا",2,0],["لِيَدُمْ جُدُّهُ","عَالِياً سَرْمَدَا",1,"د",2,0],["ليُدْرِكَ أَمجادَ الحُروبِ ولوْ دَرَى","حقيقَتَها مَا رامَ مِنْ بيْنها مَجْدا",2,"د",2,0],["لي دَولَةُ الشِعرِ دونَ العَصرِ وائِلَةٌ","مَفاخِري حِكَمي فيها وَأَمثالي",3,"ل",2,0],["لِيَدفَعَ ما نالَهُ عَنهُما","فَيا لَلرِجالِ لِهَذا العَجَب",4,"ب",1,0],["لِيَدُم لَنا المُعتَزُّ فَه","وَإِمامُنا المَرجُوُّ رِفدُه",5,"د",2,0],["لِيَدُم لَنا المُعتَزُّ إِنَّ بِمُلكِهِ","عَزَّ الهُدى وَخَبا ضَلالُ الباطِلِ",6,"ل",1,0],["لِيَدُم دَهرُكَ المُحَبَّبُ في النا","سِ بِعُمرٍ باقٍ وَعَيشٍ رَضِيِّ",7,"ي",1,0],["لِيُدرِكَ مَسعاةَ الكِرامِ وَلَم يَكُن","لِيُدرِكَها حَتّى يُكَلِّمَ تُبَّعا",8,"ع",2,0],["لِيُدنينَنا مِمَّن إِلَينا لِقاؤُهُ","حَبيبٌ وَمِن دارٍ أَرَدنا لِتَجمَعا",9,"ع",2,0],["لِيَدِ المَنِيَّةِ في تَلَطُّفِها","عَن ذُخرِ كُلِّ شَفيقَةٍ فَحصُ",10,"ص",1,0],["لِيَدُمْ مُزْهِراً زَوَاجكُمَا","وَلْيَكُ فِيهِ الإِثْمَارُ وَالإِينَاعُ",11,"ع",1,0],["لِيَدُمْ فُؤَادٌ سَائِداً وَمُصَرِّفاً","حُكْمَ السِّيَادَةِ فِي الزَّمَانِ الخَاضِعِ",12,"ع",1,0],["لِيَدُمْ مُنِيراً فَرْقَدَاهُ بُعْدَهُ","مُتَلأْلأً أَثْرَاهُ في الظَلْمَاءِ",13,"ا",2,0],["لِيَدَيهِ عَلَى العُفَاةِ والأَضيا","فِ وأهلِى جِوَارِهِ هَطلاَنُ",14,"ن",1,0],["ليدّعِ المدعون العلم والأدبا","فقد تغيّب عبدُ الله واحتجبا",15,"ب",2,1],["لِيَدُم لَكَ العِزُّ المُؤَثَّلُ وَليَدُم","لِمُريدِ كَيدِكَ ذُلُّهُ وَصَغارُهُ",16,"ر",2,0],["ليدخل في الإسلام ما لم يكن به","وما يستوى شيء خبيث وطيب",17,"ب",1,0],["ليدري الناسُ من منّا جبانٌ","إذا حامت عيونُ الشّاهدينا",18,"ن",2,0],["ليَدري شهاب الدين أَحمد أَنَّني","لداعية في كل الامور مجيب",19,"ب",1,0],["ليَ دَمعٌ مرقْرقٌ","وفؤادً مذبذبُ",20,"ب",1,0],["ليدرك البازي على هبته","أجرى من الرياح في سرعته",21,"ه",1,0],["ليدنِيَ اللّه أمراً ظل مبتعداً","ويفتح اللّه باباً بات منغلقا",22,"ق",2,0],["لِيُدرِكَ طرفي اهلَ وَدّان إِنَّني","بِوَدّان ذو شَجو حَديث وَقادِم",23,"م",1,0],["لِيَدُم للِعبادِ كَنزاً وذُخراً","جابراً مِنهمُ الجناحَ الكَسيرا",24,"ر",2,0],["لي ديونٌ عِنْدَ الْحبيبِ وقد أَص","بَحَ منِّي عِنْد الحبيبِ رُهُونُ",25,"ن",1,0],["لي دمع على فراقك سائل","ما كتبنا إلا ويمحو الرسائل",26,"ل",1,1],["ليدم سراج الله في هذا الورى","فضياؤه من فضل نور المسرج",27,"ج",1,0],["ليَ داع من فطرتي قبل أن أت","لو كتاباً إلى اليقين هداني",28,"ن",2,0],["لي دمعانِ مُذْهَبٌ","ذا وهذا مُفَضَّضُ",29,"ض",1,0],["لِيَ دَعوى عَلى الحَبيبِ بِأَنّي","مُغرَمٌ بِهواهُ وَفيهِ جُنونُهْ",30,"ه",1,1],["لِيَدفَع الجزيةَ كُلٌّ عَن يَدِ","وَمَن تَعَدّى أَمره فَمُعتَدي",31,"ي",1,0],["ليد الخلافة منك رمح طاعن","ثغر العداة وصارم لا يكهمُ",32,"م",1,0],["ليدخل ظلا في فناء وليه","ظليلا ويثوي آمنا في حمى القصر",33,"ر",1,0],["لِيُدرِكَ ثَأراً أَو لِيُدرِكَ مَغنَماً","جَزيلاً وَهَذا الدَهرُ جَمٌّ عَجائِبُه",34,"ب",2,0],["ليَ ديكٌ حَضَنْتُهُ وهو في البي","ضةِ من منصبٍ كريمِ الخيم",35,"م",1,0],["ليدم سليل شمائل حرة","يقتص إثرك للعلاء فيتبع",36,"ع",1,0],["ليدفعها ردًّا وعزمي يثيرُها","انا ابن الذي لا يرهب الموت قلبهُ",37,"ه",1,0],["ليدوم في تاريخه","مثل اسمه تحسين مالك",38,"ك",1,0],["لي دموع كأنّها من حديث","وحديث كأنه من دموعي",39,"ي",1,0],["ليَ دَمْعٌ أَجَادَ في الخَدِّ ما خَ","طَّ وَلِمْ لا يُجِيدُ وَهْوَ ابنُ مُقْلَه",40,"ل",2,0],["لي دموعٌ مرسلاتٌ قد أتى","نبأ عن فيضها دالٌ وميمْ",41,"م",1,0],["لي دعا روحي وقلبي في ضجر","من وداده في تقرّب في نفور",42,"ر",1,0],["ليدري صحيحُ الذّوق أنّ مليكَنا","له في طريق الكشف نَهْجٌ مُقَوَّمُ",43,"م",1,0],["لِيَدَي عَنتَرَةٍ مِن جَيشِنا","تَقطُرُ النَجدَة مِن مَصقولِهِ",44,"ل",2,0],["لَيديك منفعة السَحاب إِذا أَتَت","في الناس أَعوام بِغَير سَحاب",45,"ب",1,0],["لي دون مستن الرياض غزلة","ترعى بها أحشاي لا أزهارها",46,"ر",3,0],["ليدوم مرفوع اللواء وعرشه","ابداً تحف به ملائكه العلا",47,"ل",2,0],["ليدَّعِ الملكَ إِن يرض الخصيبُ فما","يبقَى عليه سواه في اللَّذاذاتِ",48,"ت",1,0],["لي ديونٌ على الحبيب كثيرٌ","وأرى حَظِّيَ المِطَالَ بَدْيني",49,"ن",2,0],["ليَ دَينٌ عليك قبلةُ ثغر","قال خذها غداً مع الأرباح",50,"ح",1,0],["ليدنو مني مبصرٌ بفؤاده","ويبعد عني مبصرٌ بالنواظر",51,"ر",1,0],["لي دهري كمبرد لحسام","ما دهاني إلا وأرهف بأسي",52,"س",2,0],["لي دارءٌ من سُقم جفنيه صعبٌ","وعلاجُ الهوى عليه يهونُ",53,"ن",1,0],["لي دين ان كنت تقضين ديناً","لغريم أو تنجزين الوعودا",54,"د",2,0],["ليدهشني هذا البكاء ألم يكن","تأثر خل من لقاء خليل",55,"ل",1,0],["لي دمْعٌ يُغْني عن الغيثِ مهْما","أخْلَفَ الغيثُ معْهدَ الأحْبابِ",56,"ب",1,0],["لي دين على الليالي قديم","ثابت الرسم منذ خمسين حجة",57,"ه",1,1],["لِيْ دُيونٌ عَلى عُلاَكَ وَهذَا","وَقْتُ يُسْرٍ فَأَوْفِ وَاصْنَعْ جَمِيلاَ",58,"ل",2,0],["لِيَدِهِ مُستَنِداً حَيثُ التَوى","وَأَظلَمَت عَيناهُ مُنهَدَّ القُوى",59,"ق",3,0],["ليدفن في اللحد حرّاً كريما","ونصب الكرام عليه يشاد",60,"د",1,0],["لِيَدفَعوا عَن خَلاياهُم وَمَحمَلِها","مِنَ الغَنائِمِ ما يَغلو بِقيمتِهِ",61,"ه",1,0],["ليدخلهُ المسنّ مَع الغلامِ","إِذا رامَ الفَتى يَروي صَداهُ",62,"ه",1,0],["لي دموع صبغتها زفرتي","فجري لؤلؤها الرطب عقيقا",63,"ق",2,0],["لي دَيدَنٌ دينٌ على حفظ الوَلا","ينمو بجسمي طالما عمري نَما",64,"م",2,0],["لي دَيدَنٌ في سما الأخلاق مرتفعٌ","يَحوم كالنسر والعليا قنيصتُهُ",65,"ت",2,0],["لِي دُنيا الفُنون وَالوَحي وَالإِل","هام مِن صدقه وَمِن مَسحوره",66,"ر",2,0],["ليدخلَ قصرَهُ بالخُلدِ رهواً","فحورُ العِينِ منهكةٌ حنينا",67,"ن",2,0],["ليدعوَ كل شاردةٍ","إليه ذلك المنظر",68,"ر",1,0],["لي دربي الخاص لي فكري ولي همي","لي ذكرياتي لي أحلامي لي أحزاني",69,"ن",2,0],["لي دينٌ في هواه","ليته أنجزَ دَينَه",70,"ه",1,1],["لِيَدِ الْهُدى ، يا أُّمُّةً بِعُقوقِها","سالَتْ دِما تِلْكَ الْيَدِ الْبَيضاءِ",71,"ا",2,0],["لِيُدينُني الصف