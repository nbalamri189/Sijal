{"poems":[[93,"فوجئت فيك بأنكر الأنباء","https://www.aldiwan.net/poem9849.html","الكامل"],[93,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[92,"يود الفتى لو خاض عاصفة الردى","https://www.aldiwan.net/poem38955.html","الطويل"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[45,"باكرتنا بواكر الوسمي","https://www.aldiwan.net/poem66865.html","الخفيف"],[28,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[28,"عجبت لحادينا المقحم سيره","https://www.aldiwan.net/poem5310.html","الطويل"],[49,"كل على الدنيا له حرص","https://www.aldiwan.net/poem62136.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55009","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55014","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54538","الكامل"]],"verses":[["ليدم لهم أخواك بعدك سلوةً","وينرهم أثراك في الغلماء",0,"ا",2,0],["لِيَدُمْ جُدُّهُ","عَالِياً سَرْمَدَا",1,"د",2,0],["ليُدْرِكَ أَمجادَ الحُروبِ ولوْ دَرَى","حقيقَتَها مَا رامَ مِنْ بيْنها مَجْدا",2,"د",2,0],["لي دَولَةُ الشِعرِ دونَ العَصرِ وائِلَةٌ","مَفاخِري حِكَمي فيها وَأَمثالي",3,"ي",1,0],["لِيَدفَعَ ما نالَهُ عَنهُما","فَيا لَلرِجالِ لِهَذا العَجَب",4,"ب",1,0],["لِيَدُم لَنا المُعتَزُّ فَه","وَإِمامُنا المَرجُوُّ رِفدُه",5,"د",2,0],["لِيَدُم لَنا المُعتَزُّ إِنَّ بِمُلكِهِ","عَزَّ الهُدى وَخَبا ضَلالُ الباطِلِ",6,"ل",1,0],["لِيَدُم دَهرُكَ المُحَبَّبُ في النا","سِ بِعُمرٍ باقٍ وَعَيشٍ رَضِيِّ",7,"ي",1,0],["لِيُدرِكَ مَسعاةَ الكِرامِ وَلَم يَكُن","لِيُدرِكَها حَتّى يُكَلِّمَ تُبَّعا",8,"ع",2,0],["لِيُدنينَنا مِمَّن إِلَينا لِقاؤُهُ","حَبيبٌ وَمِن دارٍ أَرَدنا لِتَجمَعا",9,"ع",2,0],["لِيَدِ المَنِيَّةِ في تَلَطُّفِها","عَن ذُخرِ كُلِّ شَفيقَةٍ فَحصُ",10,"ص",1,0],["لِيَدُمْ مُزْهِراً زَوَاجكُمَا","وَلْيَكُ فِيهِ الإِثْمَارُ وَالإِينَاعُ",11,"ع",1,0],["لِيَدُمْ فُؤَادٌ سَائِداً وَمُصَرِّفاً","حُكْمَ السِّيَادَةِ فِي الزَّمَانِ الخَاضِعِ",12,"ع",1,0],["لِيَدُمْ مُنِيراً فَرْقَدَاهُ بُعْدَهُ","مُتَلأْلأً أَثْرَاهُ في الظَلْمَاءِ",13,"ا",2,0]]}