{"poems":[[93,"فوجئت فيك بأنكر الأنباء","https://www.aldiwan.net/poem9849.html","الكامل"],[93,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[92,"يود الفتى لو خاض عاصفة الردى","https://www.aldiwan.net/poem38955.html","الطويل"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[45,"باكرتنا بواكر الوسمي","https://www.aldiwan.net/poem66865.html","الخفيف"],[28,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[28,"عجبت لحادينا المقحم سيره","https://www.aldiwan.net/poem5310.html","الطويل"],[49,"كل على الدنيا له حرص","https://www.aldiwan.net/poem62136.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55009","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55014","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54538","الكامل"],[132,"لعبت بعد ما انقضى الريعان","https://www.aldiwan.net/poem54719.html","الخفيف"],[135,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[143,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[270,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[271,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[402,"أَنا والله مغرم","https://www.aldiwan.net/poem46703.html","مجزوء الخفيف"],[429,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[495,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[516,"لعمري على فوت لاية نظرة","https://www.aldiwan.net/poem48604.html","الطويل"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"]],"verses":[["ليدم لهم أخواك بعدك سلوةً","وينرهم أثراك في الغلماء",0,"ا",2,0],["لِيَدُمْ جُدُّهُ","عَالِياً سَرْمَدَا",1,"د",2,0],["ليُدْرِكَ أَمجادَ الحُروبِ ولوْ دَرَى","حقيقَتَها مَا رامَ مِنْ بيْنها مَجْدا",2,"د",2,0],["لي دَولَةُ الشِعرِ دونَ العَصرِ وائِلَةٌ","مَفاخِري حِكَمي فيها وَأَمثالي",3,"ي",1,0],["لِيَدفَعَ ما نالَهُ عَنهُما","فَيا لَلرِجالِ لِهَذا العَجَب",4,"ب",1,0],["لِيَدُم لَنا المُعتَزُّ فَه","وَإِمامُنا المَرجُوُّ رِفدُه",5,"د",2,0],["لِيَدُم لَنا المُعتَزُّ إِنَّ بِمُلكِهِ","عَزَّ الهُدى وَخَبا ضَلالُ الباطِلِ",6,"ل",1,0],["لِيَدُم دَهرُكَ المُحَبَّبُ في النا","سِ بِعُمرٍ باقٍ وَعَيشٍ رَضِيِّ",7,"ي",1,0],["لِيُدرِكَ مَسعاةَ الكِرامِ وَلَم يَكُن","لِيُدرِكَها حَتّى يُكَلِّمَ تُبَّعا",8,"ع",2,0],["لِيُدنينَنا مِمَّن إِلَينا لِقاؤُهُ","حَبيبٌ وَمِن دارٍ أَرَدنا لِتَجمَعا",9,"ع",2,0],["لِيَدِ المَنِيَّةِ في تَلَطُّفِها","عَن ذُخرِ كُلِّ شَفيقَةٍ فَحصُ",10,"ص",1,0],["لِيَدُمْ مُزْهِراً زَوَاجكُمَا","وَلْيَكُ فِيهِ الإِثْمَارُ وَالإِينَاعُ",11,"ع",1,0],["لِيَدُمْ فُؤَادٌ سَائِداً وَمُصَرِّفاً","حُكْمَ السِّيَادَةِ فِي الزَّمَانِ الخَاضِعِ",12,"ع",1,0],["لِيَدُمْ مُنِيراً فَرْقَدَاهُ بُعْدَهُ","مُتَلأْلأً أَثْرَاهُ في الظَلْمَاءِ",13,"ا",2,0],["لِيَدَيهِ عَلَى العُفَاةِ والأَضيا","فِ وأهلِى جِوَارِهِ هَطلاَنُ",14,"ن",1,0],["ليدّعِ المدعون العلم والأدبا","فقد تغيّب عبدُ الله واحتجبا",15,"ب",2,1],["لِيَدُم لَكَ العِزُّ المُؤَثَّلُ وَليَدُم","لِمُريدِ كَيدِكَ ذُلُّهُ وَصَغارُهُ",16,"ر",2,0],["ليدخل في الإسلام ما لم يكن به","وما يستوى شيء خبيث وطيب",17,"ب",1,0],["ليدري الناسُ من منّا جبانٌ","إذا حامت عيونُ الشّاهدينا",18,"ن",2,0],["ليَدري شهاب الدين أَحمد أَنَّني","لداعية في كل الامور مجيب",19,"ب",1,0],["ليَ دَمعٌ مرقْرقٌ","وفؤادً مذبذبُ",20,"ب",1,0],["ليدرك البازي على هبته","أجرى من الرياح في سرعته",21,"ه",1,0],["ليدنِيَ اللّه أمراً ظل مبتعداً","ويفتح اللّه باباً بات منغلقا",22,"ق",2,0],["لِيُدرِكَ طرفي اهلَ وَدّان إِنَّني","بِوَدّان ذو شَجو حَديث وَقادِم",23,"م",1,0],["لِيَدُم للِعبادِ كَنزاً وذُخراً","جابراً مِنهمُ الجناحَ الكَسيرا",24,"ر",2,0]]}