{"poems":[[53,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[87,"ملَك بأفق الرمل هلّ كريما","https://www.aldiwan.net/poem7888.html","الكامل"],[63,"هل للمكارم من مجير","https://www.aldiwan.net/poem51641.html","مجزوء الكامل"],[92,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[98,"الشَّاطِئُ الْمَهْجُورُ","https://www.poetsgate.com/ViewPoem.aspx?id=187666",""],[469,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34411","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49087","الكامل"],[1856,"","https://poetry.dctabudhabi.ae/diwan/poem/31548","الكامل"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138799",""],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67200","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137143",""],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34891","الرمل"],[3864,"","https://poetry.dctabudhabi.ae/diwan/poem/144799","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90970","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94978","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35126","الرمل"],[4888,"الوأد في البحار","https://www.poetsgate.com/ViewPoem.aspx?id=207761",""],[4935,"يا رمس فاهنأ في رياضك أصبحت","https://www.poetsgate.com/ViewPoem.aspx?id=129516",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5111,"رمُنسيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=212339",""],[5111,"الْبَدْءُ سِيرْتَا","https://www.poetsgate.com/ViewPoem.aspx?id=212610",""],[5376,"قفْ على الأطلالٍ شوقاً وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=202346",""],[5512,"يا أيها الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=204865",""],[4615,"أيها الآمِلُ خَيْمَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=17862",""],[5956,"يا رمزَ خيرِ حضارةِ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=193684",""],[5956,"يا خادم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[5959,"القلب الأخضرانى","https://www.poetsgate.com/ViewPoem.aspx?id=12164",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""]],"verses":[["يا رَمِدَ العينِ قُمْ قبالَتَهُ","فداوِ باللحظ نحوه رَمَدَكْ",0,"ك",1,0],["يارملة الثغر استرقى واملكي","من بات من فتن الغرام سليما",1,"م",2,0],["يا رِمَّةً أَرَجُ الثَّرى","من طيبِها أَرَجُ العَبيرِ",2,"ر",1,0],["يا رملةَ اللَّهِ رُدِّي عن تحيَّتِنا","بخيرِ ما فيكِ من لُطفٍ وحيّينا",3,"ن",2,0],["يا رمالَ الكثبانِ تنقشُ فيها الر","ريحُ أسطورَةَ الحياة الغرورِ",4,"ر",1,0],["يا رمى اللّه يد الموت على","أخذ عبد اللّه رمياً بالشلل",5,"ل",1,0],["يا رمالَ الكثبان تنقشُ فيها الرِّي","حُ أسطورةَ الحياة الغرورِ",6,"ر",1,0],["يا رماة الحيَّ من باهلةٍ","فوقوا النَّيل وكفُّوا الأعينا",7,"ن",2,0],["يا رمحه عجباً لعس","سالٍ سَقى الأَعداء سمّا",8,"م",2,0],["يا رمس يوسف قد طويت مهنداً","وعليك من شغف القلوب جفون",9,"ن",1,0],["يا رَميَةً ما قَد رَمَيتُ مُرِشَّةً","أَرطاةَ ثُمَّ عَبَأتُ لِاِبنِ الأَجدَعِ",10,"ع",1,0],["يا رمية قد أصابت وهي مخطئة","من بعد خمسين من شطت مرابعه",11,"ع",2,0],["يا رميةً كبدُ الوصي بها انفرَت","وسَرتْ إلى عينِ الرسالة أحمدا",12,"د",2,0],["يا رمس بدر رجائنا قد غاب م","قال المؤرخ فيك غابت شمسه",13,"س",2,0],["يا رُماةَ المَنجَنيقِ","كُلُّكُم غَيرُ شَفيقِ",14,"ق",1,1],["يا رمحها العسال بل يا سيفها ال","قصال نارك ليس تخبو",15,"ب",2,1],["يا رمس اسعد احرزت السعادة إذ","فيك ابن فاطمة الزهراء قد رقدا",16,"د",2,1],["يا رمس حُسن اللمع فزتَ بحسنها","وغدوتَ بالشرف الرفيع تنافسُ",17,"س",1,1],["يا رُماةَ الحَيِّ مَوهوبٌ لَكُم","ما سَفَكتُم مِن دَمي يَومَ النَفا",18,"ف",2,0],["يا رملُ قبِّلْ ثغرَهُ وخدودَهُ","وارشف رحيقَ الأنسِ والرضوانِ",19,"ن",1,0],["يا رمس فاهنأ في رياضك أصبحت","ذات الصبانة والامانة والكرم",20,"م",1,1],["يا رمزَنا أنت َ قد بعناك َ وانْكشفت ْ","حقيقة ٌ مُزِّقَت ْ في ليلِها الحُجُب ُ",21,"ب",1,0],["يَا رُمَنْسِيِّةَ لَوْنِيْ","فَمَلاكِيْ لَكِ مَالاَ",22,"ل",2,0],["يَا رَمْزَ نَهْضَتِنَا، بِالْعِلْمِ سِرْتَ بِنَا","عَبْدُ الْحَمِيدِ بِكَ الأفْجَارُ تَبْتَسِمُ",23,"م",1,0],["يا رماداً مرَّ طيبٌ فوقه","فاستطابَ الذكرَ قلبٌ من بَلَلْ",24,"ل",1,0],["يا رملُ لا تتركِ الأحزانَ تنهشُنا","عجِّلْ قبيلَ انهيارِ الصَّدرِ والعَضُدِ",25,"د",1,0],["يا رُماة َ الحيِّ مَوْهُوبٌ لكمْ","ما سفكتمْ من دَمي يومَ النَّقَا",26,"ق",2,0],["يا رمزَ خيرِ حضارة الإنسانِ","ومنارِ أخلاقيةٍ وحنانِ",27,"ن",1,1],["يا رمزَ خير كرام الأرض أجمعهم","نَسّيْتَني كلَّ مَن في الأرض قد بَخِلا",28,"ل",2,0],["يا رموش قتاله وجارحه يا بوي","وعيون نيمانه وسارحه ياعين",29,"ن",1,0],["يا رماديَّةَ الوصالِ ويحلو","في رماديِّكِ العجيبِ الغناءُ",30,"ا",2,0],["يَا رِمشَها أَتلَفتَ أَخيِلَتِي","وَ حَرَمتَنِي اللَّذَاتِ , يَا وَغدُ",31,"د",1,0]]}