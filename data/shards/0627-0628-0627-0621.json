{"poems":[[55,"أظن الليالي بعدكم ستريع","https://www.aldiwan.net/poem30150.html","الطويل"],[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[49,"إباء إباء البكر غير مذلل","https://www.aldiwan.net/poem25207.html","الطويل"],[23,"أعين ألا ابكي سيد الناس واسفحي","https://www.aldiwan.net/poem21352.html","الطويل"],[53,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[47,"إن السماحة والتكرم والندى","https://www.aldiwan.net/poem65679.html","الكامل"],[30,"لعمرك ما ليث بخفان خادر","https://www.aldiwan.net/poem5567.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[47,"إنّ السّماحَةَ، والتَّكُرُّمَ، والنّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=32038",""],[128,"أهكذا حتى ولا مرحبا","https://www.aldiwan.net/poem23708.html","السريع"],[185,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[240,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[273,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[422,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[466,"إباءك أن المجد يأبى التهضما","https://www.aldiwan.net/poem16036.html","الطويل"],[469,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48778","المتقارب"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18485","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53183","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47153","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138567",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118004","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117924","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40110","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90827","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33468","السريع"],[5131,"أخذت المبادئ عن عصبةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=42206",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[307,"نشيدُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=213751",""],[5561,"يوم ذي قار","https://www.poetsgate.com/ViewPoem.aspx?id=208542",""]],"verses":[["إِباءً وَلَو طارَت بِكَفّي مُلَيحَةٌ","إِلى النيقِ رَبداءُ الجَناحِ لَموعُ",0,"ع",1,0],["إِباءٌ أَقامَ الدَهرَ عَنّي وَأَقعَدا","وَصَبرٌ عَلى الأَيّامِ أَنأى وَأَبعَدا",1,"د",2,1],["إِباءٌ إِباءُ البَكرِ غَيرُ مُذَلَّلِ","وَعَزمٌ كَحَدِّ السَيفِ غَيرُ مُفَلَّلِ",2,"ل",1,1],["إِباءً إِذا يَأبى وَأَليَنَ شيمَةً","وَأَنوَمَ عَن جارٍ إِذا اللَيلُ أَظلَما",3,"م",2,0],["آباءُ صِدْقٍ إذا بنيتَ من ال","مجد بناءً وجدتَهم عَمَدكْ",4,"ك",1,0],["آباءُ صِضقٍ قَوَّموا بِفِعالِهِم","صَعَرَ الزَمانِ وَكانَ غَيرَ مُؤَوَّمِ",5,"م",1,0],["أَباءَ بِشَيبانَ الثُؤورَ وَقَد رَأى","بَني فاتِكٍ هابوا الوَشيجَ المُقَوَّما",6,"م",2,0],["آباء بيروت للأبناء قد غرسوا","فذاقَ أبناءٌ بيروت من الثمَر",7,"ر",1,0],["إِبَاءٌ كَمَا شَاءَ الفَخَارُ وَصَبْوَةٌ","يَذِلُّ لَهَا في خِيسِهِ الأَسَدُ الْوَرْدُ",8,"د",1,0],["آباءُ صِدْقٍ قَوّمُوا بِفَعالِهِمْ","صَعَرَ الزّمانِ، وكان غيرَ مُقَوَّمِ",9,"م",1,0],["آباء صدق أورثوا حضرتي","من الخصال الغر ما أعجبا",10,"ب",2,0],["آباءِ آباءُ المَكارِمِ وَالعُلَى","وَالمُتلِفُونَ مُجَمَّعُ الأَموَالِ",11,"ل",1,0],["آباءُ صِدقٍ طابوا عَلى صالِحِ ال","دَهرِ أُصولاً فَطابَ ما وَلَدوا",12,"د",3,0],["إِباء إِباء الخَيلِ وَهيَ شَوامِسٌ","وَصَبرٌ كَصَبرِ الخَيلِ وَهيَ هَوامِسُ",13,"س",1,0],["إباءٌ يضيم الضَّيم وهو ممنّع","ويَصْفَعُ من ريب الزَّمان قذالا",14,"ل",2,0],["آباء صدقٍ دلّتْ عليهم","شهودُ أبنائها العدولُ",15,"ل",1,0],["إِباءك أنَّ المجدَ يأَبى التَهضُّما","وعزمك أن البيض تستمرىءُ الدما",16,"م",2,1],["إباءٌ كما أفنى العدى أوجد الهدى","وجودٌ كما أحيا الغنى قتل العدما",17,"م",2,0],["إِباء تَليد المَجد قر لَهُ رضى","وَقر لَهُ عَظم الفَراعين ملحدا",18,"د",2,0],["إباء على الخصم أم رجعة","إلى أنه الدولة الحاميه",19,"ي",2,0],["آباءُ سيفِ اللَهِ والعِصيان","مسكُ قريشٍ وجنى الريحانِ",20,"ن",1,0],["اباء أب أو جد جد مرامه","وبغيته إذ هَمَّ بَعْضَهم المال",21,"ل",1,0],["آباءَكَ الأطهارَ أَقْصِدُ يا أبا","إسحاقَ يا نَجْلَ المليك العالي",22,"ل",2,0],["إباء ضيمٍ وبسالةً حوى","فلم تجد به العداة مغمزا",23,"ز",2,0],["آباء صدق باذخ مجدهم","من كل وضاح أغر الجبين",24,"ن",1,0],["آباء مجد أنجبت بأماجد","ونجوم هدي نيّر من نيّر",25,"ر",1,0],["إِباءُ فارسَ مع لِينِ الشآم مَعَ الظ","ظَرْفِ العِراقيّ في النُّطْقِ الحِجازيِّ",26,"ي",1,0],["أباء أبناء سموا فتوا رثوا","شرف المفاخر كابرا عن كابر",27,"ر",1,0],["آباءُ صدقٍ لم يكن لهُم","مثلٌ وما لكَ في الوَرى مِثلُ",28,"ل",1,0],["اباء فما أنا بالمشتري","سراباً ولو أنني مدقع",29,"ع",1,0],["آباءنا ومن لنا بمثلهم","في الجوهرين العلم والحلم سوا",30,"ا",1,0],["إباءُ بلادي إباءُ النخيلِ","بجذعٍ يطولُ عُبابَ الغمام",31,"م",1,0],["أباءُهمْ هَزموا بعِزٍّ مارِدًا","مستوحِشًا, ف (اليومَ تنتَصَفُ العَرَبْ)",32,"ب",1,0]]}