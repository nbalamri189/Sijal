الخفيف"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199030","الرجز"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128953","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111408","الخفيف"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105182","الخفيف"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4755,"ثُمَّ باعُوا جَنوبَنا والشمالا","https://www.poetsgate.com/ViewPoem.aspx?id=190112",""],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4984,"أمنية العهد البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=175573",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5648,"حي الضمير ويجلد الذات كرباج","https://www.poetsgate.com/ViewPoem.aspx?id=157947",""],[2220,"هذا الثبوت الذي ما فيه تعطيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11644&r=&rc=518",""]],"verses":[["ثم زالَ الصبا ومن كانَ يصبي","وشجوني كما علمت شجوني",0,"ن",2,0],["ثم زاد المقصرون صناعا","ت اليها الاديب لا يرتاح",1,"ح",1,0],["ثُمَّ زُفَّت إِلى الزُجاجِ بِدِرعٍ","مِثلُ نارٍ تَحكي اِلتِهابَ الحَميمِ",2,"م",1,0],["ثُمَّ زارَتني وَصَحبي هُجَّعٌ","في خَليطٍ بَينَ بُردٍ وَنَمِر",3,"ر",1,0],["ثُمَّ زادوا أَنَّهُم في قَومِهِم","غُفُرٌ ذَنبَهُمُ غَيرُ فُخُر",3,"ر",1,0],["ثم زد ما تقول في جبل القا","ف أحقٌّ فحواه أم أسطور",4,"ر",1,0],["ثم زفت الى كَريم عروساً","ما بها من غميزة أَو ذام",5,"م",1,0],["ثُمَّ زُفَّت في قَميصٍ أَدكَنٍ","فَتَحَلَّت كَفَتاةٍ في العُرُس",6,"س",1,0],["ثُمَّ زادَ الأَمرُ حَتّى","قُلتُ يا جَبّارُ عافِه",7,"ه",1,0],["ثُمَّ زالَت تِلكَ الكَآبَةُ إِذ عا","دَ إِلَيها وَآذَنَت بِبِعادِ",8,"د",1,0],["ثم زرنا بأثره صاحبيه","الجديرين بعده بالقيام",9,"م",1,0],["ثم زادوا عليها أكؤس الدمع","تروى من جارم وبرى",10,"ر",2,0],["ثم زالوا ومضوا في غيهم","وعن الباطل ذو الحق أزيح",11,"ح",1,0],["ثم زعمتم أنه الصديق","دون جميع الناس والمحقوق",12,"ق",1,0],["ثم زعمتم لاعتقاد الغي","بأنه خليفة النبيِّ",12,"ي",1,0],["ثم زالت واقبلت صلة الاج","ر عواف تحكي نداك جسام",13,"م",1,0],["ثُمّ زُر بُقعةً لَقَد حَلَّ فيها","تَلقها الدّهرَ من أجلِّ البقاعِ",14,"ع",1,0],["ثمَّ زُرْ خَيرَ رَسولٍ حلَّها","وَبِهِ قَد شُرِّفت حيثُ أَقاما",15,"م",2,0],["ثم زدني أنعما وأمت","حسدي غيظا بغبنهم",16,"م",1,0],["ثم زاغت في المسلمين أُناس","لا أرى في العدى لهم أشباها",17,"ا",3,0],["ثم زاحمن في المضيق إلى أن","بعد لأي أجزن نجد الحقاب",18,"ب",1,0],["ثم زر ساحة الوزير شهاب ال","دين والثم أبوابه إعظاما",19,"م",2,0],["ثُمَّ زيداً مِن حاجِرٍ وَزَرودٍ","خَبراً عَن مَراتِعِ الغِزلانِ",20,"ن",1,0],["ثم زد ما استطعت حتى تراني","قد خلعت الوقار والبيقارا",21,"ر",2,0],["ثمَّ زُحَل والمشتري قد جَرَّه","مرِّيخُهُ والشَّمسُ ثمَّ الزُّهرَة",22,"ه",1,0],["ثُمَ زارُوا لِلمُصطَفى خَيرَ قَبرٍ","فيهِ خَيرُ الخَلائِقِ المُختارُ",23,"ر",1,0],["ثم زمزم بذكر زمزم وانزل","بمقام حيث المقام الكريم",24,"م",1,0],["ثم زنداي وشَّحاه وشاحاً","ما لزنَّاره بذاك يدانِ",25,"ن",1,0],["ثم زادوا على الغبار غطاءً","من نسيج مضعضع منهار",26,"ر",1,0],["ثم زيدٌ وأى زيد اذاً قي","لَ لضربِ الهاماتِ ويحكَ مَهْلا",27,"ل",2,0],["ثم زهير والفتى لبيب","ومنهم مجاهد اللبيب",28,"ب",1,0],["ثم زوري قبري زيارة صب","فارق الإلف بعد عهد متين",29,"ن",1,0],["ثم زودتني برقة قلب","للأيامى وللفقير العاني",30,"ن",2,0],["ثم زكاة بدن بالعللِ","زكاة ذي النعم بالعرف أَلِ",31,"ل",1,0],["ثُمَّ زَجَّى لها وقد قامَ كأساً","طَفَحَت قالَ هاكِ خَمراً زُلاَلا",32,"ل",2,0],["ثم زارت فارشفتني ريقا","أطفأت في الفؤاد منه وطيسا",33,"س",2,0],["ثم زالت تلك الصروح وولى","يافع العلم من حمى آسيَّة",34,"ي",2,0],["ثُمَّ زادَ اختِلافُنا بَعد عامٍ","فاتَّفَقنا بأَن نُطِيلَ الجِدالا",35,"ل",2,0],["ثم زينَ العبادِ من أظهر الح","قَّ الذي كان بالليالي خفيا",36,"ي",2,0],["ثم زاد السَّبك آنا فإذا","هي تبدو في رؤى وَشي جديد",37,"د",1,0],["ثم زادوا عليها أكؤس الدمع تُروّي من جارمٍ وبريّ","ويحهم كالقطيع ينشد راعيه . وراعيه في فم الوحشيّ",38,"ي",1,0],["ثم زيدي في حنينك والزياده مو حرام","الحرام إنك تخلّي قلب معشوقك ضرير",39,"ر",1,0],["ثُمَّ زَفَّتْ تعدو بِزقٍّ جِفالِ","مخطفات البطون ميث النوالي",40,"ل",2,0],["ثم زاد بل الطين باسلوب منعاج","طالع بعينه واستدار بخطاويه",41,"ي",2,0],["ثم زاد وارد الشرح:هذا الثبوت الذي ما فيه تعطيل","الروضُ منها إذا استنشقت مطلول",42,"ل",1,1]]}