""],[4858,"بين جهالة حمقاء وسياسة خرقاء","https://www.poetsgate.com/ViewPoem.aspx?id=139111",""],[4927,"نَسِيْمُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=30175",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[3271,"ويعيش أحرار العقول بظلها غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=104120",""],[585,"لم يغن تحذير ولا إغراء","https://www.poetsgate.com/ViewPoem.aspx?id=161847",""],[585,"درج الهلال من الخباء","https://www.poetsgate.com/ViewPoem.aspx?id=161864",""],[3591,"هذا الذي قد كان قبل فراق","https://www.poetsgate.com/ViewPoem.aspx?id=149465",""],[5212,"ربّانُ عشق","https://www.poetsgate.com/ViewPoem.aspx?id=212024",""],[5268,"رصيفُ الجامِعَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=206995",""],[5442,"يا مظهر حب الرسول وجهله","https://www.poetsgate.com/ViewPoem.aspx?id=114781",""],[5943,"أنا وقلبي للوفاءِ فداءُ","https://www.poetsgate.com/ViewPoem.aspx?id=11281",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6078,"أنفاسٌ وغراس","https://www.poetsgate.com/ViewPoem.aspx?id=204640",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""]],"verses":[["أَفَمِن بُكاءِ حَمامَةً في أَيكَةٍ","ذَرَفَت دُموعَكَ فَوقَ ظَهرِ المَحمِلِ",0,"ل",1,0],["أَفَما لِذَلِكَ حُرمَةٌ مَحفوظَةٌ","أُفٍّ لِمَن هُوَ قاطِعٌ غَدّارُ",1,"ر",1,0],["أَفَما لِهَذا حُرمَةٌ مَحفوظَةٌ","أَوَما لِهَذا يا فَدَيتُكِ مِن جَزا",2,"ا",1,0],["أَفَمَا تَرَوْنَ بَلاءهَا فِي نَفْحِهَا","عَنْ حَوْضِهَا للهِ حُسْنُ بَلائِهَا",3,"ا",3,0],["أفَمَا تَسْمَعِينَ إِنْشَادِيَ الشِّعْرَ","وَكُنْتِ الطَّرُوبَ إنْ تَسْمَعيني",4,"ن",2,0],["أَفَمَا شَعَرْتُمْ أَنَّهُ مُتَكَّلِّمٌ","بِلِسَانِ مَفْطورِ الفُؤَادِ مُكَلَّمِ",5,"م",1,0],["أَفَما يَزالُ يَهيجُ مِنكَ صَبابَةً","نُؤيٌ يُحالِفُ خالِداتٍ رُكَّدا",6,"د",2,0],["أَفَما تُريدُ لِحِقدِهِنَّ تَحَقُّداً","أَم ما تُريدُ عَنِ الهَوى إِقصارا",7,"ر",2,0],["أفما لذلك حُرمة مَرْعية","إنَّ الكرامَ إذاً لغيرُ كرام",8,"م",1,0],["أَفَما ذا مَن تَبتَغين وَأَبغي","وَصفَهُ قالَتِ المَليحَةُ كَلّا",9,"ل",2,0],["أَفَما شَبِعتِ وَلا رَوَي","تِ مِنَ القَطيعَةِ وَالجَفاءِ",10,"ا",2,0],["أَفَما تَنفَكُّ أَيدي المَنايا","تَسلُبُ المالَ وَتُفني الرِجالا",11,"ل",2,0],["أفٍّ منْ دهرٍ إذا استفهمتهُ","عنْ وفيٍّ قالَ هذا جنفُ",12,"ف",1,0],["أَفَما رأوها في منازلِ عِزِّها","غَضْبَى الليوثِ أبيَّةَ الأشبالِ",13,"ل",1,0],["أفما كفاكم قُوّةً من دينكم","ما جَمَّعَ الإِيمانُ فيه وأَلَّبا",14,"ب",2,0],["أفما لكم إن قام شعبٌ ناهضٌ","إلا خلافٌ قائمٌ وصياحُ",15,"ح",1,0],["أفَمَن يَبيعُ بلادَهُ كمجاهدٍ","ينأى بها عن بَيْعهِ وشرائهِ",16,"ا",3,0],["أفما يُفيقُ الجاهلونَ فتنقضي","غُمَمُ الحياةِ وتنجلي الغَمَراتُ",17,"ت",1,0],["أفما جَرّبتُمُ القومَ الأُلى","خُلِقُوا للشّرِّ فيمن جَرَّبا",18,"ب",2,0],["أفما يُرضيكَ في الدُّنيا سِوَى","موقفِ الجاني ومثوى المُذنبِ",19,"ب",1,0],["أفما تَرَوْنَ بَني غِفَارٍ أنَّه","من عندِ خيمتكم يفيضُ ويَنْبُعُ",20,"ع",1,0],["أفما رأيتم ما أصابَ مُحمّدٌ","مِن قومِكم لمّا أطاعوا الغاويا",21,"ي",2,0],["أفما صعقتَ له وبِتَّ بليلةٍ","تَسْرِي أراقمُها فَتُعِيي الراقيا",21,"ي",2,0],["أفَمن يعتِقُ من رِقِّ الهوى","أنفُسَ النّاسِ كمن لم يُعتَق",22,"ق",1,0],["أفما أبصرتِ رُكنَيْ أُحُدٍ","حِينَ سالَ الجرحُ كيف انصدعا",23,"ع",2,0],["أفما أُبصِرُ إلا لاهياً","أو مُعَنّىً بالأماني مُولَعا",23,"ع",2,0],["أفما رأيتَ أبا عُبيدةَ ثائراً","وأبوه في يدهِ يُتَلُّ ويُسْطَحُ",24,"ح",1,0],["أُفِّ مِن وَصفِ مَنزِلِ","بِعُكاظٍ فَحومَلِ",25,"ل",1,1],["أَفَما أَنى لَكِ يا عُبَيدَةُ أَن","تَشفي أَخا الأَحزانِ وَالكَمَدِ",26,"د",1,0],["أَفَمِلَّةُ الإِسلامِ يُنكِرُ مُنكِرٌ","وَقَضاءُ رَبِّكَ صاغَها وَأَتى بِها",27,"ب",3,0],["أَفَما يَكُرُّ عَلى مَعيشَتِهِ الفَتى","إِلّا بِما نَبَذَت إِلَيهِ الأَنجُمُ",28,"م",1,0],["أفَمِنْ أجلِ أنْ تعيشوا تُريدونَ","لثلْثّيْ أهلِ البلادِ الدّمارا",29,"ر",2,0],["أفما رأوها في منازل عزها","غضبى الليوث أبية الأشال",30,"ل",1,0],["أفماله في شرع نقدك شافع","حتى ولو أوحت به برفين",31,"ن",1,0],["أفما ترين عيوبَ نفسِ","ك كالجبال الراكِدَهْ",32,"د",2,0],["أفِّ من دهرٍ رآني","في غمارِ الفُضَلاءِ",33,"ل",3,1],["أفّ من معرفة النا","س على كل سبيل",34,"ل",1,0],["أَفَما يُساعِدُني الزَمانُ وَتلتَقي","عَيني بِهِم وَتَلَذُّ مِنهُم مَنظَرا",35,"ر",2,0],["أفمن بعد هؤلاء في حلبة","الآداب ترجو سباقك الفرسان",36,"ن",1,0],["أفمن من مثل من دهته الليالي","بعدما ازدهته يرجي البيان",36,"ن",1,0],["أَفَما تَخافُ مِن العِقابِ غَداً","يا مَن يُعَذِّبُني بِلا ذَنبِ",37,"ب",1,0],["أفمِثْلُ وُدِّي للكرامِ وإن جنَتْ","نُوَبُ الزمّانِ تُذَمُّ منه عُهود",38,"د",1,0],["أفَما كُنتَ تراني","بَعضَ ما كنتَ تَراني",39,"ن",2,0],["أَفما نَرى مِن بَحر جود قَطرة","يُروى بِها عَطَشي غَداة قُدومي",40,"م",2,0],["أفمهمتنا كل المراد وراقت","دمت في نعمة بنيل المراد",41,"د",1,0],["أفما ترى في ذي البَريَّةِ قاسياً","فتَذُمَّ قَسوَتَهُ بِشِعركَ دُوني",42,"ن",2,0],["أفمن ملوك الخافقين عزيمة","تنتاشُني من ضيغم الإعدامِ",43,"م",1,0],["أفما تخاف إذا وقفت محاسباً","وسئلت عن جل ونزر دقايق",44,"ق",1,0],["أفمستجيرا حيث عزَّ رُواقُه","لمخافةٍ دهِمتك أو إعدامِ",45,"م",1,0],["أفَمَرَّة ً أ ُخرى؟؟..ولن يَتَسَنَّشنوا","أوغادُ أمريكا ، وَلَنْ يَتَشَيَّعُوا",46,"ع",3,0],["أفما لعضبك في حياتك راحةٌ","يوماً فينسى كلَّ ما حمَّلتهُ",47,"ت",2,0],["افما جادَ بالوجودِ علينا","أَيُّ برٍ يفوقُ برَّ الوجود",48,"د",1,0],["أَفَمَن بَعد أَربعين نُجازي","في خداماتِنا بِما قَد سَمعنا",49,"ن",2,0],["أفما لرهط منكمُ يوماً هفا","من شافعين إذا انتهى وأثابا",50,"ب",2,0],["أفما تراهُ وقد تصفَّر لونُهُ","بعد احمرارٍ يُستضاءُ بوقدِهِ",51,"د",2,0],["أفمثلي بمثل هذي القوافي","غرض القصد في المديح يصيب",52,"ب",1,0],["أفما استحيت ولا احتسبت جواب ما","تحكيه كيف يخيف لينا ثعلب",53,"ب",1,0],["أَفَما رأيت الغيثَ في تمّوزهِ","في الجودِ دون الغيث في تشرينهِ",54,"ن",2,0],["أفمنقذ لهم من النيران من حملوا","إلى ابنته لظى النيران",55,"ن",1,0],["أفما درى إني وخلاّق الورى","إن كنت في روض الجنان ولم أرَ",56,"ر",1,0],["افما هو الغمر الذي لم يكفهِ","تلفيق شعرٍ فتقه لا يرتقُ",57,"ق",1,0],["أفما آن لنا أن نرتقي","مثلما ترقى الشّعوب الطّالعة",58,"ع",2,0],["أفما يكفيك هذا في الأمم","قلت لم أبرح كما كنت أنا",59,"ن",2,0],["أفما في الأنام ذو فطنة يَف","هَمُ هَذا ومن له فيه قَلبُ",60,"ب",1,0],["أَفَمِنكِ لا بَرقٌ كَأَنَّ وَميضَهُ","غابٌ تَشَيَّمَهُ ضِرامٌ مُثقَبُ",61,"ب",1,0],["أفمن يا ربِّ لنا غيرُك","والكل صنائعُ ربّهم",62,"م",1,0],["أَفَما عَلِمتُم أَن دُونَ حَرِيمِنا","قُضُباً تُشامُ وَمُقرَباتٍ تُلجَمُ",63,"م",1,0],["افما تراها أم أكرم أمةٍ","تزجى إلى جدث مع الأولاد",64,"د",1,0],["أفما ترى انفاسه قدسيةً","تلوي بعمر الشيخ عن آجاله",65,"ل",2,0],["أفما انثنت رسل المنون بجزية","كلا ولا سلبت سوى اسكندرا",66,"ر",2,0],["أفما سمعت موذن الراووق قد","وافى يسبح فالق الاصباح",67,"ح",1,0],["أفما بذاك علامة","لو ذو حجى يرعى العلامه",68,"م",2,0],["أَفَمَا رأيتَ الكُفْرَ ذَلَّ لعزّهم","وسنانُه لِسِواهُمُ خطّارُ",69,"ر",1,0],["أفَمَن حَوَالَتُهُ عَلَى التنزِيل وال","وَحي المبينِ ومُحكمِ القُرآنِ",70,"ن",1,0],["أفَمَيِّتٌ يَأتِي الصَّلاَةَ وَإنَّ ذَا","عَينُ المُحَالِ وَوَاضِحُ البُطلاَنِ",70,"ن",1,0],["أفما تصدق أن أعمال العبا","تحط يوم العرض في الميزان",70,"ن",1,0],["أَفَما تَرى ابن العامِرِيَّةِ سُبَّةً","شَنعاء مِثلَ حَديثِها لَم يُؤثَرِ",71,"ر",1,0],["افما الدويهي منهم وهو الذي","قد كان للاحبار خير امام",72,"م",1,0],["افما علمت بانه بالسيف يؤخذ","من بسيف كان ارخ آخذا",73,"ذ",2,0],["أفم الخليج أتذكرَن بك ليلةً","أفنيت فيها من عفافي ما بقي",74,"ي",1,1],["أفمن جمالك قد ظننت بأنني","أدع الجهاد لمقلتين ملاح",75,"ح",1,0],["أفم الأكمام عن زهر تبسم","أم صبا نجد شذاها قد تنسم",76,"م",1,1],["أفما رأيت أمامه وحياله","حرس البلاط مدججاً بحرابه",77,"ب",2,0],["أفمهما أوجست من شعبك المو","تور خوفاً دفعته للصدام",78,"م",1,0],["أفمالكُ لك مالكٌ","أم أنت موقوفٌ رهين",79,"ن",1,0],["أفَما خَشيتَ بأنْ يقولَ محدثٌ","في القومِ عرَّدَ فارسٌ عن راجِلِ",80,"ل",1,0],["أَفما لزيد زاجرٌ من همه","يكفيه ناحيةَ القطيع الأَسمَرِ",81,"ر",1,0],["أفماء الحياء في","خدك الأحمر انعقد",82,"د",1,0],["أفمن بعد تدمر يخدع السح","ر فتبنى قصوره والديا",83,"ي",2,0],["أفمن كان عن براءةَ معزو","لا بأمر من السميع البصير",84,"ر",1,0],["أفما تجدر باريس بتج","ريره فيها كمصر برد تَيه",85,"ي",2,0],["أَفَمُسلِمٌ هُوَ عِندكُم أَم كافِرٌ","أَم عاقِلٌ أَم جاهِلٌ أَم واني",86,"ن",2,0],["أَفما إِنَّ حربَ بابلَ تكفي","عن أُرَشلِيمَ او يكفُّ القِتالُ",87,"ل",1,0],["أفما يكف عن الشآم لطامع","وعن الكنانة والعراق زحام",88,"م",1,0],["أفما ترى وجه الغدير ومن","أيدي الصبا كانت صياقله",89,"ل",2,1],["أفمرسَلٌ هذا الغرابُ فعِلُمهُ","بالغيبِ جاءَ من السماءِ مُتاحا",90,"ح",2,0],["أفما الدنيا ترانا علناً","أولا ربٌّ رآنا وقفل",91,"ل",1,0],["أفما انحدرنا للكفاح هنا","لنقي أخيل اليوم كل عنا",92,"ن",2,0],["أفما ادكرت اليوم يوم على","إيذا فررت لدي مضطربا",92,"ب",2,0],["أَفَما في اطِّلابِ هِيلانَةٍ قد","جاءَ أَترِيذُ بالكُمَاة القَوامِس",93,"س",1,0],["أَفَما بِأَبناءِ الأَخاءَةِ فِتيَةٌ","يَسعَونَ في اتنهاضِ قومِكَ رُوَّدا",94,"ا",1,0],["أفما جاءكم دوي نداه","وبحرق السفين يغري سراه",95,"ه",1,0],["أفما مقتل ابن عمك يوري","في حشاك للهيف ذاكي الشرار",95,"ر",1,0],["أفما خلتهم تراموا عليه","لانتزاع السلاح من عانقيه",95,"ه",1,0],["أفما رمت في الطرواد قرما","بظباة القناة يرمي فيصمي",95,"ي",1,0],["أفٍّ من الأَيّام أن صروفها","حلَّت بنا بعد الرضاءِ تغضُّبا",96,"ب",2,0],["أفَما رَأيتم كيف باِسمِ اللَّه قد","نَزَل الفَسادُ بأهل هذي الدارِ",97,"ر",1,0],["افَما رايْتَ سُطُورَها تَتْلُو عَلَى","زُوارِها حِكْما تَحارُ بِها الفِكَرْ",98,"ر",1,0],["أفما في الكون من","أنثى ولا جنس الخناث",99,"ث",1,0],["أفّ من الدنيا وأيامها","فإنّها للحزن مخلوقهْ",100,"ق",2,1],["أفَمَا رأيتَ البدرَ مذ باراه قد","وَلّى لنظرته سناهُ قبيحا",101,"ح",2,0],["أَفَمَن تَجَرَّعَ فَقْدَها قَلِقًا كَمَن","رَكِبَ الدِّماءَ لِفِتنةٍ وتَعَصُّبِ!",102,"ب",1,0],["أَفَمَن تَعَثَّرَ بالنّجُومِ كَمَن","بقَوَامِهِ العَثَرَاتُ تَستَنِدُ!",103,"د",1,0],["أفما رأيتم حاجزاً وصف الخنا؟","أفما رأيتم بطشة الطّغيان؟!",104,"ن",1,0],["أفما رأيتَ ( نزيهنا ) متضرّجاً","بدمائه الفيحا لدى الرّحمن؟!",104,"ن",1,0],["أفما رأيت القيد أدْمى معصما؟!","أفلا نثورُ كثورة البركان؟!",104,"ن",1,0],["أفما ترى أسرَ الحبيبِ وصحبِهِ","جعل الحياةَ بلاقعاً وجديبا ؟",105,"ب",2,0],["أفما شعرتَ بما أعاني من حنين ؟","هيّا استمع هذا النّشيجَ معَ الأنين",106,"ن",1,1],["أفما عرفتم مَن أراد هوانكم","بالجهل والتّشريد في الطّرُقات ؟",107,"ت",1,0],["أفما عرفتم مَن يُضَيّع عمركم","بالتّيه في بحرٍ مِن الظّلمات؟",107,"ت",1,0],["أَ فَمَاْ تَرَاْهَاْ؟ يَاْ بَنَفْسَجُ! بَعْدَمَاْ","سَفَرَتْº وَهَاْمَ بِحُبِّهَا الشُّعَرَاْءُ",108,"ا",2,0],["أَ فَمَاْ رَأَيْتُمْ يَاْ عُتَاْةُ بِلاْدَنَاْ؟؟","كَيْفَ اسْتَبَدَّ بِأَهْلِهَا الإِعْيَاْءُ؟؟",109,"ا",2,0],["أفمنْ يظل على المبادئِ ثابتاً","قذّفتِهِ في البؤس شرّ قذاف",110,"ف",1,0],["أفما دروا أن الرشاد أعزنا","فاليوم لا وهنٌ ولا إبطاء",111,"ا",2,0],["أفما قرأت بوجهه","سور الخديعة والرئاء",112,"ا",2,0],["أفما وعدتم أن تزفّوا في النوى","كتباً لهذا المغرم الّواق",113,"ق",1,0],["أَفَما رَأيتَ السَّهْمَ نامَ بِصَدرِهِ","وَكَذاكَ نامَ الخَدُّ وَهْوَ عَفَيْرُ",114,"ر",1,0],["أفمن يغيبُ كمن يمدُّ لأجلِها","نحوَ الشروقِ يداً ليدركَ مَطلَعَهْ",115,"ع",2,0],["أفما يردك عن ضلالك والهوى","عقل فإن الدين ما يعنى به",116,"ب",2,0],["أفما تراها يافؤادي منيةً","في عالمٍ ضلَّتْ بهِ حواءُ؟",117,"ا",2,0],["افما رأيت الذاكرين عيونهم","محجوزة عن مطلق الترداد",118,"د",1,0],["أفما دروا أنَّ الحياةَ كلمحةٍ؟","وتلوكهم كاللُّقمةِ الأرجاسُ",119,"س",1,0],["27. أفما يقول الحقُ في تنزيلهِ","أنَّ الشَّهيدَ بكلِّ خَْيرٍ يُرْفَدُ",120,"د",1,0]]}