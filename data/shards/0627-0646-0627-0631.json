{"poems":[[77,"أنا روضة وجه الأمير محمد","https://www.aldiwan.net/poem36503.html","الكامل"],[86,"بالذي أجراك يا ريح الخزامى","https://www.aldiwan.net/poem10684.html","الرمل"],[86,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[73,"لم يكن هجر حبيبي عن قلى","https://www.aldiwan.net/poem11899.html","الرمل"],[93,"أعروس إكليلها يعلوها","https://www.aldiwan.net/poem11121.html","الخفيف"],[54,"حسن ظني إليك أسعدك الله","https://www.aldiwan.net/poem27409.html","الخفيف"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[72,"يا إماما في مدح علياه صدق","https://www.aldiwan.net/poem18491.html","الخفيف"],[72,"لو لم تفه برثاء فيك أشعاري","https://www.aldiwan.net/poem18718.html","البسيط"],[72,"كيف قاسوا قد الحبيب بغصن","https://www.aldiwan.net/poem20160.html","الخفيف"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[51,"أنا راع لما صفا منك قدما","https://www.aldiwan.net/poem65699.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[91,"ذات شوك كالحراب أو كأظفار العقاب","https://www.aldiwan.net/poem8752.html","عموديه"],[70,"أيها الغائب قد آن","https://www.aldiwan.net/poem42778.html","مجزوء الرمل"],[92,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[89,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[89,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[85,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[85,"يتنازع الأرباب فيك نفاسة","https://www.aldiwan.net/poem7252.html","الكامل"],[85,"كان للغربان في العصر مليك","https://www.aldiwan.net/poem8044.html","الرمل"],[45,"قل لأهل الوقوف موتوا بغيظ","https://www.aldiwan.net/poem10219.html","الخفيف"],[45,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[45,"أصدود غلا بها أم دلال","https://www.aldiwan.net/poem65596.html","الخفيف"],[45,"بالله يا ربع لما ازددت تبيانا","https://www.aldiwan.net/poem66659.html","البسيط"],[45,"إسمع مديحي في كعب وما وصلت","https://www.aldiwan.net/poem66803.html","البسيط"],[45,"يا أبا الصقر وعدك المضمون","https://www.aldiwan.net/poem66815.html","الخفيف"],[58,"مالي على فوت فائت أسف","https://www.aldiwan.net/poem30957.html","المنسرح"],[66,"أيها المعرض المعرض بالشيب","https://www.aldiwan.net/poem39218.html","الخفيف"],[66,"مرحبا مرحبا بأبطال لهو","https://www.aldiwan.net/poem40671.html","الخفيف"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[87,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[87,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[69,"أقول لقابلة أدمعي","https://www.aldiwan.net/poem28228.html","السريع"],[31,"من لقلب أمسى حزينا معنى","https://www.aldiwan.net/poem41299.html","الخفيف"],[31,"نعم الفؤاد مزارها محظور","https://www.aldiwan.net/poem42536.html","الكامل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[81,"ولما عزمنا ولم يبق من","https://www.aldiwan.net/poem61516.html","المتقارب"],[52,"ألم تحزن على الربع المحيل","https://www.aldiwan.net/poem26756.html","الوافر"],[48,"أنا رأس في الضلال","https://www.aldiwan.net/poem66277.html","مجزوء الرمل"],[68,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85522","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85336","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42498","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[51,"قالوا هجاك أبو حفصٍ فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=28476",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[85,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""]],"verses":[["أنا روْضَةٌ وجْهُ الأميرِ محمّدٍ","شمْسي ودوني للحُسامِ غَديرُ",0,"ر",1,1],["أَن أَرى في البَحرِ وَالبَرِّ لَنا","في الوَغى أَندادَ طوجو وَأُياما",1,"م",2,0],["إِن أَرهَقوا صَيّادَكُم فَلَعَلَّهُم","لِلقوتِ لا لِلمُسلِمينَ تَعَصَّبوا",2,"ب",3,0],["إِنّا رَأَينا كِراماً مِن رِجالِهِمُ","كانوا عَلَيهِم لَدَينا خَيرَ عُنوانِ",3,"ن",1,0],["إِنّا رَمَيناهُم بِنَدبٍ حُوَّلٍ","عَن قَصدِ وادي النيلِ لَيسَ يَحولُ",4,"ل",1,0],["أَنا راضٍ بِالَّذي يَرضى بِهِ","لِيَ مَن لَو قالَ مُت ما قُلتُ لا",5,"ل",2,0],["إِنْ أَرَدْتَ التَّشْبِيهَ دَعْهَا وَشَبِّهْ","رُبَّ حُسْنٍ لا يَقْبَلُ التَّشْبِيهَا",6,"ي",3,0],["إِن أَرَدتُم حَوائِجاً عِندَ قَومٍ","فَتَنَقَّوا لَها الوُجوهَ الصِباحا",7,"ح",2,0],["أنارت النار في أطرافها رهجاً","من الدخان كأن النار أبطال",8,"ل",1,0],["إنَّ أرجوزتي بدارِ حديث ال","شام تملي عواليَ الأمداح",9,"ح",1,0],["إن ارْتحلت فبرٌّ جدّ مقترب","وإن ثويت فذكرٌ جدّ سيَّار",10,"ر",1,0],["إن أردنا الهدى فأنوار شمس","أو أردنا الندى فأنواء مزنِ",11,"ن",1,0],["إن أردنا التقى لديه أو الجو","د وجدنا في الحالتينِ وليّا",12,"ي",2,0],["أنا راجٍ جميلَ رَدْعِك إيَّا","ه فلا تَجعلنَّهُ إغراءَ",13,"ا",2,0],["أنا راجٍ بعدل قاضيَّ أمناً","ومَحلّاً لديه بل تقريبا",14,"ب",2,0],["أنا راجٍ لأنْ يفوز بحظٍّ","منك قلبي وليتَه منك ناجي",15,"ج",2,0],["أنا راعٍ لما صفا منك قدماً","عائفٌ منك آجناً مطروقا",16,"ق",2,1],["إن أراد الحديثَ منك تنكَّب","تَ سبيلَ الإخباثِ والإقلالِ",17,"ل",1,0],["أَنا رَوضٌ لَم أُذِع كُلَّ عَبيري وَمَلابي","أَنا نَجمٌ لَم يُمَزِّق بَعدُ جِلبابَ الضَبابِ",18,"ب",1,0],["أَنا راضٍ عَنكَ لَكِن","لَيتَني نِلتُ رِضاكا",19,"ك",2,0],["أنْ أرَدتُنَّ أن يكون بهيجاً","رائعَ السِّحْر ذا جمالٍ فريدِ",20,"د",1,0],["إن أردتُنَّ أنْ يكونَ شنيعاً","مُظْلِمَ الأُفْقِ ميِّتَ التَّغريدِ",20,"د",1,0],["ان اردت الذكرى فحسبك في الار","ض قبور الآباء والامهات",21,"ت",1,0],["ان ارقى الاحياء في كل ارض","بشر بعضه على البعض عاد",22,"د",1,0],["أناروا ظلمة الدنيا وكانوا","لنار الظالمين بها صُلِيَّا",23,"ي",2,0],["أنا ربه سوّيته ورفعته","في الناس حتى ساير الأملاكا",24,"ك",2,0],["أَنا رَبُّ الشَوكَةِ الضافي الجَناح","أَنا ذو المِنقارِ غَلّابُ الرِياح",25,"ح",1,0],["إِن أَرَدتُم أَن تُبصِروا كَيفَ أَنتُم","فَاُنظُروا كَيفَ صارَ وَقفُ اِبنِ موسى",26,"س",2,0],["أَنا راضٍ وَواثِقٌ مِن أَبي الفَض","لِ بِفِعلٍ عَلى النَدى مَوقوفِ",27,"ف",1,0],["أَنا راضٍ بِأَن تَجودي بِقَولٍ","كاذِبٍ أَو يُطيفَ مِنكِ خَيالُ",28,"ل",1,0],["إِن أُربِحَت في اِبتِغاءِ المَجدِ صَفقَتُهُم","لَم يَحسِبوا غَبَناتِ المَجدِ خُسرانا",29,"ن",2,0],["إِن أَرمِكُم يَكُ مِن بَعضي لَكُم شُعَلٌ","تَهوي إِلَيكُم وَمِن بَعضي لَكُم جُنَنُ",30,"ن",1,0],["إِن أَرَدنا لَدَيكَ دُنيا فَدُنيا","أَو نُحاوِلُ لَدَيكَ ديناً فَدينُ",31,"ن",1,0],["أَنا راضٍ بِالعسرِ وَاليَسارِ فَما","تُدخلُني ذِلَةً وَلا صَلفُ",32,"ف",1,0],["أَنا راضٍ بِأَن أَشيبَ وَأَن يُص","بِحَ مِن هَولِ نَبتِهِ غَيرَ راضِ",33,"ض",1,0],["إِن أَرادوا لَها عَلى الوَشيِ رَكزاً","وَضَعوا تَحتَ كُلِّ لَدنٍ مِجَنّا",34,"ن",2,0],["إنّ أرضاً غودرتَ فيها لتهدي","ريحُها منك عَرْفَ مسكٍ ذكيِّ",35,"ي",1,0],["إِنّا رَحَلنا واثِقينَ بِواثِقِ","بِاللَهِ شَمسِ ضُحىً وَبَدرِ تَمامِ",36,"م",1,0],["أَنا راجِلٌ بِبِلادِ مَروٍ راكِبٌ","في جَودَةِ الأَشعارِ كُلَّ مُجيدِ",37,"د",1,0],["أَنَا رَاضٍ مِنْهُمْ بِذُكْرَةِ وُدٍّ","أَوْ كِتَابٍ إِنْ لَمْ أَفُزْ بِلِمَامِ",38,"م",1,0],["أَنَا رَاضٍ بِتَرْكِ مَالِي وَأَهْلِي","فَالْعَفَافُ الثَّرَاءُ وَالنَّاسُ أَهْلُ",39,"ل",1,0],["أنا رجلٌ موهبٌ للّقا","فقالتْ أنا امرأةٌ قابلَهْ",40,"ه",1,0],["أَن أَراهُ وَاللَهُ يَعلَمُ يَوماً","مُنتَهى رَغبَتي وَما أَتَمَنّى",41,"ن",2,0],["أَن أَرجِ رِحلَتَكَ الغَداةَ إِلى غَدٍ","وَثَواءُ يَومِ إِن ثَوَيتَ يَسيرُ",42,"ر",1,0],["أنَار بِك الإظلامُ فَالغَربُ مُشرِقٌ","وأخصب مِنك الجَدبُ فالصَّلدُ نَاعِمُ",43,"م",1,0],["أَنارٌ وَقَد وَقَدَت زَفرَتي","فَصارَ الغُدوُّ كَوَقتِ الهَجيرِ",44,"ر",1,0],["أَنارٌ مِن تِهامَةَ لَم تُغَمَّض","بَدَت لَكَ أَم سَنى بَرقٍ كَليلِ",45,"ل",1,0],["أنا رأسٌ في الضلالِ","أنا مأوى كلّ ضالِ",46,"ل",1,1],["أَنَارُ الغضا ضاءتْ وسلمى بذي الغضا","أمِ ابتَسَمتْ عمّا حكتهُ المدامع",47,"ع",1,0],["أنا راضٍ من البيوت بقبر","يتساوى عشيُّهُ والبكور",48,"ر",1,0],["إن أردت الغناء كان غناء","أو أردت البيان كان بيانا",49,"ن",2,0],["إِنَّ أَرضاً تَمشي عليها وَئيداً","كرة قَد تَدَحرَجَت في السماء",50,"ا",2,0],["إن أَرضاً كنا عليها نجولُ","بعد أَيام دوننا ستحولُ",51,"ل",1,1],["أَنا رَاضٍ بِنَظْرَةٍ مِنْكَ تَشْفِي","بَرْحَ قَلْبٍ هاجَتْ بِهِ الأَدْوَاءُ",52,"ا",2,0],["إِنْ أُرِيدَ الضِّيَاءُ فَهْوَ شِهَابٌ","أَوْ أُرِيدَ المَضَاءُ فَهْوَ حُسَامُ",53,"م",1,0],["إِنَّا رَأَيْنَا فِي رِحَابِكَ آيَتَيْ","حَزْمٍ وَفِيرِ جَنىً وَعَزْمٍ مُثْمِرِ",54,"ر",1,0],["إنْ أَرْجُ فَالإقْبَالُ مَا أَرْجُو لَكُمْ","وَإذَا دَعَوْتُ فَبِالرُّقِيِّ دُعَائِي",55,"ا",2,0],["أَنا راضٍ بِما قَضى اللَهُ عَدلاً","لَستَ مِمّا يَشاءُ بِالمُشمَئِزِّ",56,"ز",1,0],["أنا رهنٌ بشكره عن أيادي","ه ولكنني علِقْتُ برهني",57,"ي",1,0],["إِنْ أَرَدْتَ الظِّبَاءَ تَمْرَحُ فِي السَّهْلِ","فَطَهِّرْ أَكْنَافَهُ مِنْ ذِئابِهْ",58,"ب",2,0],["إنْ أرَّقَتْ أجفانَ مصرَ مُلمَّةٌ","تَرَ كلَّ جفن في دمَشْقَ مؤرَّقَا",59,"ق",2,0],["إن أرادوا السلام كان حماما","أو أرادوا الحروب كان غرابا",60,"ب",2,0],["أنَّا رَكِبِنا إلى غاياتِنا أمَلاً","رَخواً إذا ما شدَدْنا حَبلهُ انقطعا",61,"ع",2,0],["إن أرض الجولان تشبه عينيك","فماءٌ يجري.. ولوز.. وتينُ",62,"ن",1,0],["إن أرى خُوذة الصفعان قد صَدئت","ترفَّقوا سوف أعطيكُمْ جُرادتها",63,"ت",3,0],["أنا راض عنها وان تك قد حا","قت أخيراً منها بي الويلات",64,"ت",1,0],["أناروا ظلمة َ الدنيا، وكانوا","وإن هو ضَلَّ كان السامِريَّا",65,"ي",2,0]]}