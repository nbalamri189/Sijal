tps://www.aldiwan.net/poem53653.html","الطويل"],[400,"وقد رزينا به محضا خليقته","https://www.aldiwan.net/poem4511.html","البسيط"],[404,"أنار تشك ألهبت طي قرطاس","https://www.aldiwan.net/poem33727.html","الطويل"],[410,"عماد الدين أنت لكل داع","https://www.aldiwan.net/poem31705.html","عموديه"],[417,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[430,"أيها الوالد إني بعدكم","https://www.aldiwan.net/poem41015.html","الرمل"],[433,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[438,"أترى حان لكم نحوي التفات","https://www.aldiwan.net/poem2562.html","الرمل"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[442,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[450,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[454,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[454,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[459,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[459,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[465,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[469,"أبا علي اعف عني فقد","https://www.aldiwan.net/poem60435.html","السريع"],[471,"صرمت حبلك الغداة نوار","https://www.aldiwan.net/poem4700.html","الخفيف"],[480,"نادتك يا أختها الخضرا فلسطين","https://www.aldiwan.net/poem36961.html","البسيط"],[483,"يا ربنا اجعل خير عمري آخره","https://www.aldiwan.net/poem24529.html","عموديه"],[496,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[501,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[501,"ما للفؤاد بكم طرق","https://www.aldiwan.net/poem37946.html","مجزوء الكامل"],[515,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[539,"كأس الخطوب بذا العدو دهاق","https://www.aldiwan.net/poem47536.html","عموديه"],[539,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[539,"مقدم القائد الأعز نظيرا","https://www.aldiwan.net/poem48180.html","عموديه"],[539,"أنا ليلى التونسيه","https://www.aldiwan.net/poem48255.html","عموديه"],[552,"لا قضى الله لقلبي","https://www.aldiwan.net/poem47894.html","البسيط"],[559,"ليت شعري مذ كررت نظراتي","https://www.aldiwan.net/poem34727.html","الخفيف"],[559,"حرم آمن لكعبة قلبي","https://www.aldiwan.net/poem34955.html","الخفيف"],[576,"حسنها كل ساعة يتجدد","https://www.aldiwan.net/poem3089.html","الخفيف"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["أنا روْضَةٌ وجْهُ الأميرِ محمّدٍ","شمْسي ودوني للحُسامِ غَديرُ",0,"ر",1,1],["أَن أَرى في البَحرِ وَالبَرِّ لَنا","في الوَغى أَندادَ طوجو وَأُياما",1,"م",2,0],["إِن أَرهَقوا صَيّادَكُم فَلَعَلَّهُم","لِلقوتِ لا لِلمُسلِمينَ تَعَصَّبوا",2,"ب",3,0],["إِنّا رَأَينا كِراماً مِن رِجالِهِمُ","كانوا عَلَيهِم لَدَينا خَيرَ عُنوانِ",3,"ن",1,0],["إِنّا رَمَيناهُم بِنَدبٍ حُوَّلٍ","عَن قَصدِ وادي النيلِ لَيسَ يَحولُ",4,"ل",1,0],["أَنا راضٍ بِالَّذي يَرضى بِهِ","لِيَ مَن لَو قالَ مُت ما قُلتُ لا",5,"ل",2,0],["إِنْ أَرَدْتَ التَّشْبِيهَ دَعْهَا وَشَبِّهْ","رُبَّ حُسْنٍ لا يَقْبَلُ التَّشْبِيهَا",6,"ي",3,0],["إِن أَرَدتُم حَوائِجاً عِندَ قَومٍ","فَتَنَقَّوا لَها الوُجوهَ الصِباحا",7,"ح",2,0],["أنارت النار في أطرافها رهجاً","من الدخان كأن النار أبطال",8,"ل",1,0],["إنَّ أرجوزتي بدارِ حديث ال","شام تملي عواليَ الأمداح",9,"ح",1,0],["إن ارْتحلت فبرٌّ جدّ مقترب","وإن ثويت فذكرٌ جدّ سيَّار",10,"ر",1,0],["إن أردنا الهدى فأنوار شمس","أو أردنا الندى فأنواء مزنِ",11,"ن",1,0],["إن أردنا التقى لديه أو الجو","د وجدنا في الحالتينِ وليّا",12,"ي",2,0],["أنا راجٍ جميلَ رَدْعِك إيَّا","ه فلا تَجعلنَّهُ إغراءَ",13,"ا",2,0],["أنا راجٍ بعدل قاضيَّ أمناً","ومَحلّاً لديه بل تقريبا",14,"ب",2,0],["أنا راجٍ لأنْ يفوز بحظٍّ","منك قلبي وليتَه منك ناجي",15,"ج",2,0],["أنا راعٍ لما صفا منك قدماً","عائفٌ منك آجناً مطروقا",16,"ق",2,1],["إن أراد الحديثَ منك تنكَّب","تَ سبيلَ الإخباثِ والإقلالِ",17,"ل",1,0],["أَنا رَوضٌ لَم أُذِع كُلَّ عَبيري وَمَلابي","أَنا نَجمٌ لَم يُمَزِّق بَعدُ جِلبابَ الضَبابِ",18,"ب",1,0],["أَنا راضٍ عَنكَ لَكِن","لَيتَني نِلتُ رِضاكا",19,"ك",2,0],["أنْ أرَدتُنَّ أن يكون بهيجاً","رائعَ السِّحْر ذا جمالٍ فريدِ",20,"د",1,0],["إن أردتُنَّ أنْ يكونَ شنيعاً","مُظْلِمَ الأُفْقِ ميِّتَ التَّغريدِ",20,"د",1,0],["ان اردت الذكرى فحسبك في الار","ض قبور الآباء والامهات",21,"ت",1,0],["ان ارقى الاحياء في كل ارض","بشر بعضه على البعض عاد",22,"د",1,0],["أناروا ظلمة الدنيا وكانوا","لنار الظالمين بها صُلِيَّا",23,"ي",2,0],["أنا ربه سوّيته ورفعته","في الناس حتى ساير الأملاكا",24,"ك",2,0],["أَنا رَبُّ الشَوكَةِ الضافي الجَناح","أَنا ذو المِنقارِ غَلّابُ الرِياح",25,"ح",1,0],["إِن أَرَدتُم أَن تُبصِروا كَيفَ أَنتُم","فَاُنظُروا كَيفَ صارَ وَقفُ اِبنِ موسى",26,"س",2,0],["أَنا راضٍ وَواثِقٌ مِن أَبي الفَض","لِ بِفِعلٍ عَلى النَدى مَوقوفِ",27,"ف",1,0],["أَنا راضٍ بِأَن تَجودي بِقَولٍ","كاذِبٍ أَو يُطيفَ مِنكِ خَيالُ",28,"ل",1,0],["إِن أُربِحَت في اِبتِغاءِ المَجدِ صَفقَتُهُم","لَم يَحسِبوا غَبَناتِ المَجدِ خُسرانا",29,"ن",2,0],["إِن أَرمِكُم يَكُ مِن بَعضي لَكُم شُعَلٌ","تَهوي إِلَيكُم وَمِن بَعضي لَكُم جُنَنُ",30,"ن",1,0],["إِن أَرَدنا لَدَيكَ دُنيا فَدُنيا","أَو نُحاوِلُ لَدَيكَ ديناً فَدينُ",31,"ن",1,0],["أَنا راضٍ بِالعسرِ وَاليَسارِ فَما","تُدخلُني ذِلَةً وَلا صَلفُ",32,"ف",1,0],["أَنا راضٍ بِأَن أَشيبَ وَأَن يُص","بِحَ مِن هَولِ نَبتِهِ غَيرَ راضِ",33,"ض",1,0],["إِن أَرادوا لَها عَلى الوَشيِ رَكزاً","وَضَعوا تَحتَ كُلِّ لَدنٍ مِجَنّا",34,"ن",2,0],["إنّ أرضاً غودرتَ فيها لتهدي","ريحُها منك عَرْفَ مسكٍ ذكيِّ",35,"ي",1,0],["إِنّا رَحَلنا واثِقينَ بِواثِقِ","بِاللَهِ شَمسِ ضُحىً وَبَدرِ تَمامِ",36,"م",1,0],["أَنا راجِلٌ بِبِلادِ مَروٍ راكِبٌ","في جَودَةِ الأَشعارِ كُلَّ مُجيدِ",37,"د",1,0],["أَنَا رَاضٍ مِنْهُمْ بِذُكْرَةِ وُدٍّ","أَوْ كِتَابٍ إِنْ لَمْ أَفُزْ بِلِمَامِ",38,"م",1,0],["أَنَا رَاضٍ بِتَرْكِ مَالِي وَأَهْلِي","فَالْعَفَافُ الثَّرَاءُ وَالنَّاسُ أَهْلُ",39,"ل",1,0],["أنا رجلٌ موهبٌ للّقا","فقالتْ أنا امرأةٌ قابلَهْ",40,"ه",1,0],["أَن أَراهُ وَاللَهُ يَعلَمُ يَوماً","مُنتَهى رَغبَتي وَما أَتَمَنّى",41,"ن",2,0],["أَن أَرجِ رِحلَتَكَ الغَداةَ إِلى غَدٍ","وَثَواءُ يَومِ إِن ثَوَيتَ يَسيرُ",42,"ر",1,0],["أنَار بِك الإظلامُ فَالغَربُ مُشرِقٌ","وأخصب مِنك الجَدبُ فالصَّلدُ نَاعِمُ",43,"م",1,0],["أَنارٌ وَقَد وَقَدَت زَفرَتي","فَصارَ الغُدوُّ كَوَقتِ الهَجيرِ",44,"ر",1,0],["أَنارٌ مِن تِهامَةَ لَم تُغَمَّض","بَدَت لَكَ أَم سَنى بَرقٍ كَليلِ",45,"ل",1,0],["أنا رأسٌ في الضلالِ","أنا مأوى كلّ ضالِ",46,"ل",1,1],["أَنَارُ الغضا ضاءتْ وسلمى بذي الغضا","أمِ ابتَسَمتْ عمّا حكتهُ المدامع",47,"ع",1,0],["أنا راضٍ من البيوت بقبر","يتساوى عشيُّهُ والبكور",48,"ر",1,0],["إن أردت الغناء كان غناء","أو أردت البيان كان بيانا",49,"ن",2,0],["إِنَّ أَرضاً تَمشي عليها وَئيداً","كرة قَد تَدَحرَجَت في السماء",50,"ا",2,0],["إن أَرضاً كنا عليها نجولُ","بعد أَيام دوننا ستحولُ",51,"ل",1,1],["أَنا رَاضٍ بِنَظْرَةٍ مِنْكَ تَشْفِي","بَرْحَ قَلْبٍ هاجَتْ بِهِ الأَدْوَاءُ",52,"ا",2,0],["إِنْ أُرِيدَ الضِّيَاءُ فَهْوَ شِهَابٌ","أَوْ أُرِيدَ المَضَاءُ فَهْوَ حُسَامُ",53,"م",1,0],["إِنَّا رَأَيْنَا فِي رِحَابِكَ آيَتَيْ","حَزْمٍ وَفِيرِ جَنىً وَعَزْمٍ مُثْمِرِ",54,"ر",1,0],["إنْ أَرْجُ فَالإقْبَالُ مَا أَرْجُو لَكُمْ","وَإذَا دَعَوْتُ فَبِالرُّقِيِّ دُعَائِي",55,"ا",2,0],["أَنا راضٍ بِما قَضى اللَهُ عَدلاً","لَستَ مِمّا يَشاءُ بِالمُشمَئِزِّ",56,"ز",1,0],["أنا رهنٌ بشكره عن أيادي","ه ولكنني علِقْتُ برهني",57,"ن",2,0],["إِنْ أَرَدْتَ الظِّبَاءَ تَمْرَحُ فِي السَّهْلِ","فَطَهِّرْ أَكْنَافَهُ مِنْ ذِئابِهْ",58,"ب",2,0],["إنْ أرَّقَتْ أجفانَ مصرَ مُلمَّةٌ","تَرَ كلَّ جفن في دمَشْقَ مؤرَّقَا",59,"ق",2,0],["إن أرادوا السلام كان حماما","أو أرادوا الحروب كان غرابا",60,"ب",2,0],["أنَّا رَكِبِنا إلى غاياتِنا أمَلاً","رَخواً إذا ما شدَدْنا حَبلهُ انقطعا",61,"ع",2,0],["أنا رجّال .. مايؤمن .. بقول أن الزمن غلاّب","يغلبوني رجال ... ولا الزّمان ايصير .. غلاّبي",62,"ب",2,0],["إن أرض الجولان تشبه عينيك","فماءٌ يجري.. ولوز.. وتينُ",63,"ن",1,0],["إن أرى خُوذة الصفعان قد صَدئت","ترفَّقوا سوف أعطيكُمْ جُرادتها",64,"ت",3,0],["أنا راض عنها وان تك قد حا","قت أخيراً منها بي الويلات",65,"ت",1,0],["أناروا ظلمة َ الدنيا، وكانوا","وإن هو ضَلَّ كان السامِريَّا",66,"ي",2,0],["أنا رَغْمَ الَّذي جَنَيْتُ إلهي","لم أزلْ ضارِعًا على أَعتابِكْ",67,"ك",1,0],["أن أرى لي بيت شعر حوله","من شلايا قومك السرحان سرح",68,"ح",1,0],["إنا رزئنا لأن الحظ عاكسنا","وحالف القوم من قطاع هاجانا",69,"ن",2,0],["إن أردتمْ ترونَ كلّ عجيبِ","فانظرُوا أيها الورَى في ذُرَاها",70,"ا",3,0],["إن أردت المريدَ معنًى ولعنا","فآتِهِ تلفه مريدا رجيما",71,"م",2,0],["إِن أَرُم غَيرَ دِى الاُمُورِ تَبَدَّى","خَدُّهَا مِنهُ وَردَةٌ كالدِّهَانِ",72,"ن",1,0],["أنَارَ غوامِضَ العلمِ الدَّوَاجِى","وقَيَّدَ مِن شَوارِدِهِ الصِّعَابَا",73,"ب",2,0],["أَنارَ رَأيُكَ وَالأَيّامُ داجِيَةٌ","فَأَشرَقَت وَجَلا تَأثيرُكَ الكُرَبا",74,"ب",2,0],["إِن أَرَدنَ البَعيدَ كانَ قَريباً","أَو وَرَدنَ البِحارَ صارَت ثِمادا",75,"د",2,0],["إن ارتماضك مما لا دفاع له","شؤم عليك فكم ذا أنت ترتمض",76,"ض",1,0],["إنْ ارجُ خيراً فابن عباس يدي","أو خفت شراً كان حصني الأكبرا",77,"ر",2,0],["أنارت به الافاق والشمس أشرقت","بطلعته والليل تجلى غياهبه",78,"ب",2,0],["إِنّا رَضينا وَإِن غابَت جَماعَتُها","ما قالَ سَيِّدُنا رَوحُ بنُ زِنباعِ",79,"ع",1,1],["أنا روح تنوح طورا على الأر","ضِ وطوراً على متونِ السحاب",80,"ب",1,0],["أنا راضٍ بكلِّ ما يرضيكا","فإلى كم هذا النمنّعُ فيكا",81,"ك",2,1],["إن أراحهُ تعبٌ","شفَّ قلبهُ تعبُ",82,"ب",1,0],["أنا راضٍ بما صنعتَ فهل أن","تَ بقتلي يا أحسن الناس راض",83,"ض",1,0],["أنا راضٍ بأن أموت كريماً","وأصونَ الهوى عن الإعلانِ",84,"ن",1,0],["أنا روح من غرام وهيام","وصراع ونضال وجماح",85,"ح",1,0],["أَنا رَبابُ المُحبي","ن في يَدَي داودِ",86,"د",1,0],["إنَّ أرضا تَسعى إليكَ يَقيم ال","أُنس فيها وَيَصطَفيها الصَفاءُ",87,"ا",2,0],["أَنارت بك الأَيام حتى كأَنها","دُجىً أنت صبح في أَعاليه مقبِلُ",88,"ل",1,0],["إن أرادت إلى المعالي نهوضاً","نكستها حظوظها أي نكس",89,"س",1,0],["إن أردت الزهد الصريح فمنه","يقبس المتقي عفاف النفس",89,"س",1,0],["أَنا رَهنُ مَظَلِمَةٍ بِحُفرَتِكَ الَّتي","ضاقَت فَلا ضاقَت عَلَيكَ مَجالا",90,"ل",2,0],["إِن أَرقَصَ البَينُ المُشِت