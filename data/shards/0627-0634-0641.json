ewPoem.aspx?id=33666",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5436,"فجّر الثورة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35273",""],[5461,"ظلمتني","https://www.poetsgate.com/ViewPoem.aspx?id=6472",""],[5732,"اللي سباني بالهوى فارع الطول","https://www.poetsgate.com/ViewPoem.aspx?id=177944",""],[4623,"ماذا يضرك لو تركت ملامي ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146686",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[5804,"مساجلة مع جار الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=190655",""],[5939,"جحود","https://www.poetsgate.com/ViewPoem.aspx?id=178579",""],[5956,"كنا قصة محبوبين","https://www.poetsgate.com/ViewPoem.aspx?id=182134",""],[6124,"خلا","https://www.poetsgate.com/ViewPoem.aspx?id=174741",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["أَشَفَت فَكُنتَ شِفاءَها وَلَقَد تُرى","شِلواً بِأَظفارِ العَدوِّ يُمَزَّقُ",0,"ق",1,0],["إِشفاقُهُ داعٍ إِلى ظَنِّهِ","وَظَنُّهُ داعٍ إِلى الظُلمِ",1,"م",1,0],["اِشفَعي يا ظَلومُ لي عِندَ فَوزٍ","طالَما قَد نَفَعتِني يا ظَلومُ",2,"م",1,0],["أَشَفُّ الوَرى في النُهى رُتبَةً","وَأَشهَرُهُم في المَعالي مَثَل",3,"ل",1,0],["أَشْفَتْ غَلِيلَ فُؤَادِكَ الظَّمآنِ","تِلْكَ العُيُونُ تَسِيلُ مِنْ لُبْنَانِ",4,"ن",1,1],["أَشَفَتْ مِنْكُمُ النُّفُوسَ نِطَافٌ","جَارِيَاتٌ مِنْ ذلِكَ السَّلْسَالِ",5,"ل",1,0],["أَشفَقتُ مِن هَجري فَغَل","لَبتُ الظُنونَ عَلى اليَقينِ",6,"ن",1,1],["أَشفَقتُ يَعلَقُ نابُهُ بِرِدائي","فَرَفَستُهُ غَضَباً فَطارَ حِذائي",7,"ا",2,0],["أَشفَقتُ مِن هَمّي عَلى كَبِدي","وَخَشيتُ مِن دَمعي عَلى نَحري",8,"ر",2,0],["أَشفِق عَلَي وَلا تَنسَ وُعودَكَ لي","فَإِنَّ ما بِيَ لَو بِلصَخرِ لَاِنفَطَرا",9,"ر",2,0],["أَشْفَقْتُ أَنْ يَرِدَ الزَّمانُ بِغَدرِهِ","أَوْ أُبْتَلى بَعْدَ الوِصَالِ بَهَجْرِهِ",10,"ر",2,1],["أُشفِقُ عِندَ اِتِّقادِ فِكرَتِهِ","عَلَيهِ مِنها أَخافُ يَشتَعِلُ",11,"ل",1,0],["اشفعوا يا رجالَ منبجَ فينا","لارتفاعِ الوبا عنِ البلدانِ",12,"ن",1,1],["أَشَفَيْتَ نفسَك حين مِلتَ إلى الكرى","ونزلتَ منزل هَدْأةٍ وقرارِ",13,"ر",1,0],["أَشْفَى سليطٌ وابنُ عَوفٍ ضِغنَكم","أم ثَمَّ ضِغْنٌ وَاغِرٌ وضبابُ",14,"ب",1,0],["اِشفَعي لي صَريمَ عِندَ الكَنودِ","وَتَوَلَّي خَلاصَ قَلبٍ عَميدِ",15,"د",1,1],["أَشفي مِنَ اللَمَمِ المُعِن","نَ إِذا تَقَحَّمَ غَيرَ قاصِد",16,"د",1,0],["أشفقتُ أن تَشْقي وأن تألمي","معي فناشدتُكِ أنْ تَرجعي",17,"ي",1,0],["أشْفَقْتُ مِن عِبءِ البَقاءِ وعابِهِ","ومَلِلْتُ مِن أرْيِ الزمانِ وَصَابِهِ",18,"ب",2,1],["أَشْفَى الأَمَانِيِّ الَّتِي وُكِلت بِهَا","تَقْرِيبُنَا وَتمَزقِ الحسادِ",19,"د",1,0],["أَشَفَيْتَ قَلْبَكَ مِن مَحَاسِنِ فَنِّهِ","فِي شُكْرِ مَا لِلنِّيلِ مِنْ آلاَءِ",20,"ا",2,0],["أشفيقٌ سِرْ بالشبابِ حثيثاً","أملُ الشرقِ في يَدَيْ شُبّانه",21,"ن",2,0],["أشفى على جُرف المهالك موطنٌ","بيديهِ لا يدِ غيره مقتول",22,"ل",1,0],["اشفقت مما قد مُلكت قساوةً","ان لا ترِقَّ اذا ملكتَ فتُشفقا",23,"ق",2,0],["أشفق عليّ ولا تنس وعودك لي","فإنّ ما بي لو بالصّخر لانفطرا",24,"ر",2,0],["أَشفَقت مِن الجُنون لَما يُؤدي","أَقدام خَيالك العَزيز الغالي",25,"ي",1,0],["اشفعوا يا كرام فينا وقولوا","بفروق القصوى لنا اولاد",26,"د",1,0],["أشفع الوتر ياوزير فإني","أذكر العهد حين أنتم رقود",27,"د",1,0],["أشفقت من إخفاء ما لم تخفِهِ","فكشفت ما تُخشى غوائلُ كشفِهِ",28,"ف",2,1],["أَشفيق لا بَردى وَلا فَيحاؤُه","إِن كانَ بَرَدونيُّ وَحيك يدمعُ",29,"ع",1,0],["أَشفَت فَكُنتَ شِفاءَ عِ","لَّتِها وَحاصِمَ دائِها",30,"ا",3,0],["أشفقت مني وكان يقنعني","عندك ما ليس يوجب الشفقه",31,"ق",2,0],["أشفعِ الوتر أوتر الشفعَ تُهدَى","في التجلي إلى الصراط السويّ",32,"ي",1,0],["أَشفى على طرفِ الحياةِ ذَماؤُها","فاستبْق للدّين الحَنيف ذماءَها",33,"ا",3,0],["أَشفى يَمُجُّ الزَيتَ مُلتَمِسٌ","ظَمآنُ مُلتَهِبٌ مِنَ الفَقرِ",34,"ر",1,0],["أَشفقَ الناظرُ أَن تغربَ إذ","طَلَعَت فوقَ خدودٍ مِن شَفَق",35,"ق",1,0],["أشفقت بنت دارها من ذهولي","ورأتني كحظّها المخبول",36,"ل",1,0],["اشفق على مضنى فتونك انه","قاسى بك الاسعاد والتعذيبا",37,"ب",2,0],["أشفَقتُ إذ أوجَعوهُ ضَرباً","عليهِ من جوره خَشِيتُ",38,"ت",1,1],["أشْفِقْ على الدِّرهَمِ والعَيْنِ","تَسْلَمْ مِنَ العَيْنَةِ والدَّيْنِ",39,"ن",1,1],["أشفي الصُّدور بمدحِه ومديحُهُ","كالماء يَنْقعُ غُلَّة الظمآن",40,"ن",1,0],["أَشْفَارُ جَفْنِكَ لم تَزَلْ","عندي أَحَدَّ من الشِّفارِ",41,"ر",1,1],["أشفيت حر جوى ودمعك يهمل","يوم استقل فريقها المتحمّل",42,"ل",1,1],["أَشفعتم شرف الجهاد بمقْصِدٍ","أسْنَى ومسعاة لخير مفاد",43,"د",1,0],["أَشفقَ أن يَعْطُلَ وهي مفخرٌ","عرضُك منها والمحبُّ ذو شَفَقْ",44,"ق",1,0],["أَشفارُها أَم صارِمُ الحَجّاجِ","وَجُفونُها أَم فِتنَةُ الحَّلاجِ",45,"ج",1,1],["إشفع إلى الظافر المليك يجب","وغير بدعٍ برٌ وتعجيل",46,"ل",1,0],["أشفق الشامتون من فرط سقمي","كيف تبقى بعد النفوس الجسوم",47,"م",1,0],["أشفي على قصر الوصال وعهده ال","ماضي ومن ليلِ الصُّدود وطوله",48,"ل",2,0],["أشفقت من إعراضه وصدوده","فوقعت فيما خفت من إشفاقي",49,"ق",2,0],["أشفِ من عَيني سُهادا","واشفِ مِن عَقلي اختِبالا",50,"ل",2,0],["أَشَفاكُمُ مِن يَومِ بَدرٍ قَتلُهُ","تِلكَ الشَهادَةُ ما بِذَلِكَ مَن خَفى",51,"ف",2,0],["اشفيق لا تحزن فكل راحل","سبق الألى سبقوا ونحن سنلحق",52,"ق",1,0],["اشفيق ان مصابنا يدري به","بارى الانام فلا يفيد المنطق",52,"ق",1,0],["أشفقت من حرمانهم ورضيت أن","يقفوا أمامك موقف الرقباء",53,"ا",2,0],["أشفقتُ مما جنته منهمُ فئة","وجئت أطلب في الجاني الشفاعات",54,"ت",1,0],["اشفعْ كَرَماً فِيمَا جَنَاهُ ابنُ الخَلُوفْ","فَالذَّنْبُ مَخُوفْ",55,"ف",1,0],["أشفق أن أمسها","بشفة واحذر",56,"ر",1,0],["أشفقت أن تكون منها يتامى","حين أشفقن ان يكُنّ ثكالى",57,"ل",2,0],["أشفقت من دهري على أملي","واليوم أنظر كيف ينقطع",58,"ع",1,0],["أشفقت تلمسها لظاهرِ لينها","وإذا ثقبت بإبرةٍ لا تخرق",59,"ق",1,0],["أشفقت أشربها لباهر نورها","فانرتها وجعلتها مصباحي",60,"ح",2,0],["اشفَع لِعَبدٍ أَتى بِالمَدحِ فيكَ وَجُد","في حالِ مُحتَسِبٍ بِاللَهِ مُعتَصِمِ",61,"م",1,0],["أشفِي غَلِيلَ حَمَسِي وَأَشتَفِي","وَبِاصطِدامِ العَبَلاتِ أكتَفِي",62,"ي",1,0],["اشْفِ فؤادي مني فإن به","جرحاً أنا نكأته بيدي",63,"د",2,0],["أَشْفَقْتُ مِنْ مَرَضٍ أَتَاحَ تَخَلُّفِي","يَوْمَ الرَّحِيلِ عَنِ الرِّكَابِ الأَشْرَفِ",64,"ف",1,1],["اشفع عنايتك الجلي","لة لي لدى الملك الجليل",65,"ل",1,0],["أشفَقَت من هجومها وأعدّت","مُستدام النصيص للاشفاق",66,"ق",1,0],["إشفَع لِعَبدٍ أتَى زَلاَّتُهُ اشتَمَلَت","علَآ قَبائِحَ لاَ تُحكى لَها ثِقَلِ",67,"ل",1,0],["اشْفَعْ لنا فيما دهى تِرْشِيشَ مِنْ","إلزامها غُرْمَ الخراج المُثْقَل",68,"ل",1,0],["أشفى على مُرِّ التلاف وما شفى","قلباً فهل من عندك استنقاذه",69,"ذ",2,0],["إشفع وقل ما شئت إنك نازل","من ذي الجلالة بالمكان الأقرب",70,"ب",1,0],["اشفيق ماري قد وفتك بوعدها","واتت بوجه كالصباح تبلجا",71,"ج",2,1],["أشفق على اليد مهلاً لا ترق دمها","وارفق بها ففؤاد المبتلى فيها",72,"ه",2,0],["اشفِ قلبي أيّها الساقي الرحيم","بالتي يحيا بها العظم الرميم",73,"م",1,0],["اِشفِ فُؤادِي مِنّي فإنَّ به","مِنيَ جُرْحَاً نكأتهُ بِيَدي",74,"د",2,0],["اشفقتُ من أمني عليك تصاد في","غدرٍ وكم في الأمن من محذور",75,"ر",1,0],["أشفق على التاجر إن يفتقر","فما له شيء سوى المال",76,"ل",1,1],["أشفق من كفّي على حاسد","راح يوالي القذف والطعن بي",77,"ي",1,1],["أشفقتُ من نظرة تجلو عيوبهم","كم نظرةٍ أعدمت بالعيب انسانا",78,"ن",2,0],["اشفق من ضم النطاق خصره","لضعفه طورا وطورا احسده",79,"د",2,0],["أشْفِقْ عليه كم كذا تجُرُّهُ","ما بين يَأْسٍ زاجِرٍ لي وطَمَعْ",80,"ع",1,0],["أشفى قلوب بني البتول وحيدر","وقلوب شيعتهم مدى الأعصار",81,"ر",1,0],["أشفُّ الوجدِ ما أبكى العيوناَ","وأشفى الدمع ما نكأ الجفونا",82,"ن",2,1],["اشفقوا يا حسان أنَّا من اللح","مِ مصوغونَ لا من الجلمود",83,"د",1,0],["اشف قلبي من البلية ياظب","ي فإني بدون حسنك هَلك",84,"ك",1,0],["اشفق على قلبٍ تعود أنه","لو شام مسكيناً عليه يشفق",85,"ق",1,0],["اشف به الغواشي أي قرم","غدا من صارم المحكي أحكى",86,"ك",2,0],["اشفِ وجدي داو قلبي روِّني","بكؤوس الحب ترياق البقاء",87,"ا",2,0],["أشفقت بعدك من طول الحياة ولي","عيش إذا طاب عيش الناس لم يطب",88,"ب",1,0],["اشفع لنا عندَ الكريم وكُن لنا","وزراً حمى عند احمرارِ الباسِ",89,"س",1,0],["أشف من جوهر الأكسير نائله","هذا ومطلبه للناس مقترب",90,"ب",1,0],["أَشفى فَكنت شِفاءَه مِن حادِثٍ","غاداهُ عارِضُهُ مُرَدَّى بِالرَّدا",91,"د",2,0],["أشفق لي في الحب من لا يشفق","حتى الخيال منك حين يطرق",92,"ق",1,0],["أشفقت من نظر الحسود لوصلنا","فحجبته عن أعين الرقباء",93,"ا",1,0],["أَشْفَيتُ لولاكَ مِن ذَنْبِي على عَطَبِي","فَكُن شَفِيعي لِرَبِّي يَوْمَ مُنْقَلَبِي",94,"ي",1,0],["أشفَقت أُمِّيَ البتول على تق","صير عُمري وَقد أَحمّ حمامي",95,"م",2,0],["أشفى على سقمٍ يُشفى الرقيبُ بهِ","لو كان أسقمَهُ من كان يَرحمُهُ",96,"م",2,0],["أشفى على خطط الهلا","ك ومن وصالك ما اشتفى",97,"ف",2,0],["اشفعوا لى يا آل يس في جَم","مِ ذنوبٍ لهولها زدت نوحا",98,"ح",2,0],["أشفقَ الإسكندرُ الأكبرُ مِنْ","فتنةٍ أعلى مِنَ السيفِ انتصارا",99,"ر",2,0],["أَشْفَقْتُ مِنْ حُسْنٍ عَلَيْكِ فَإِنَّهُ","نُورٌ تَثَاَقلَ حَمْلُهُ .. أَيُخَفَّفُ؟",100,"ف",1,0],["أشْفَقْتُ مِن دمعٍ يسحُّ ترحُّماً","سفَّاحُ (قانا) قد جنى الفخْرا",101,"ر",2,0],["أشفق على علمٍ يجي منه من غير ..",".. لا يسمع اللي سولفوا به ونيني",102,"ن",2,0],["أَشَفَعتَ بعدَ عهودنا شغفاً","ولقد ظننتُكَ في الهوى وِتْرا",103,"ر",2,0],["أشفقت من عنف المسير ومن أذى","حر الهجير وشدة الرمضاء",104,"ا",2,0],["اشفق عليها شفقة البدو للسيل","تبغى الربيع بس ماهوب يدها",105,"د",3,0],["إشفي معلولا من مرضٍ","بشغاف فؤادك لم يخبرْ",106,"ر",1,0],["أشْفِهِ منْ كلِّ ضيق ٍ يا كريمًا","وابعثْ الأنوارَ فوجًا في القضاءِ",107,"ا",2,0],["اِشْفَعْ تُشَفَّعْ خُذْ عَظيمَ كَرامَةٍ","أَنْتُمْ عِبادِي.. أنْتُمُ الزُّعَماءُ",108,"ا",2,0],["اِشفِ قلبي من جراحٍ مُرَّةٍ","نثرتْها دولُ الغرْبِ شعابا",109,"ا",1,0],["أشفق على اللايم إلى جاب طاريك","ودي يطول الشرح في حال طرياك",110,"ك",1,0],["اشفق عليه وخاطري فيه مشغول","شوفه مرام النفس للروح عاذي",111,"ذ",2,0],["أشفقت من ايدائهم لك يا سليم","الصدر خشية نقمة العلام",112,"م",1,0],["أشفَقْتُ مِن حُزني على بَصري وما","أشْفَقتِ يالِله ما أقْساكِ",113,"ك",1,0],["اشفق فإنِّي شاعرُ الحزنِ الذي","تبكي على أيّامِهِ الأيّامُ",114,"م",1,0],["أَشفِي جراحَ غرورِها","صدري لِوحشتِها وَطَنْ",115,"ن",1,0],["أشفِقْ فوراً يا محبوبي","علّكَ تُنهِي هذا البَيْنْ",116,"ن",1,0],["أشفقتُ من طبعِ الوجودِ على الملا","فانسابَ وعدي خلف نجمٍ قد سلا",117,"ل",2,1],["أشفق أن أمسها بشفة واحذر","لكنها لخاطري ولفؤادي نُشر",118,"ر",1,0],["اشفي على تمثالِهِ برحيقِهِ","وكأَنَّه لي صاحبٌ ونَدِيمُ",119,"م",1,0]]}