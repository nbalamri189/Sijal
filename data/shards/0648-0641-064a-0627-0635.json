{"poems":[[82,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[275,"أزنبق كفك البيضاء فالعبق","https://www.aldiwan.net/poem35444.html","البسيط"],[412,"أذهبت رونق ماء النصح في العذل","https://www.aldiwan.net/poem50137.html","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53206","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[6093,"أسارةُ إنَّ الهّجْرَ للحبِّ قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=176430",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""]],"verses":[["وفي اصطِبارِكِ فيها والرَّدى جَزِعٌ","ما دلّ أنّك عنها غيرُ مُصْطَبرِ",0,"ر",1,0],["وفي أصابعها ماسٌ كدمعِ ندَى","على غصونٍ لمرِّ الريحِ تعتنق",1,"ق",1,0],["وَفي أُصول الثَنايا بارِد عَلِلٌ","نَفسي الفِداء لِتِلكَ البارِدِ العَلِلِ",2,"ل",1,0],["وفي اصطلاح العلماء بالأدب","علم به تعرف أشار العرَب",3,"ب",1,0],["وفي اصطناع الأيادي عن أبي دُلَفٍ","وغالب في قِرى الأضياف بالنَّعَم",4,"م",1,0],["وَفي أُصول الفقه كابن الحاجب","وَما لهُ عَن بابهِ بحاجب",5,"ب",1,0],["وفي أصلِ مجدٍ قدْ نَبَتُ وفرعهِ","وفي أمرِ غيري تستريبُ القبائِلُ",6,"ل",1,0],["وفي أصول الثنايا باردٌ عللُ","نفسي الفداءُ لذاك البارد العلل",7,"ل",1,0]]}