{"poems":[[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[63,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[354,"لبانتنا هواك وما لبينى","https://www.aldiwan.net/poem15975.html","الوافر"],[371,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[382,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[408,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[556,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133851","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132325","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102866","الوافر"],[5358,"أعاصير ومنافي","https://www.poetsgate.com/ViewPoem.aspx?id=21863",""],[5790,"هات حدث متى استقل الفريق","https://www.poetsgate.com/ViewPoem.aspx?id=112087",""]],"verses":[["فَمَغْفِرَةٌ حَيْثُ الأَبِيُّ مُجَنْدَلٌ","وَمَقْدِرَةٌ حَيْثُ الْجَبَانُ مُسَلِّمُ",0,"م",1,0],["فمغبوطٌ وليسَ له عَشاءٌ","ومَحسودٌ وليس له دِثارُ",1,"ر",1,0],["فَمَغرِبُ شَمسِ بَهجَتِها بِعَي","نِ الشَهادَةِ عَينُ مَشرِقِها عَلَيها",2,"ه",2,0],["فَمُغرِقُ ماءِ أَينَما سارَ دَمَّرَ","وَمِصعَقُ نارٍ أَينَما حَظَّ حَطَّما",3,"م",2,0],["فمغناطيسُ صوتهمِ حكيمٌ","بجذب حديد قلبٍ لا يبالي",4,"ل",2,0],["فم غادرٍ أبدَى السَّخائمُ واغتدت","تنوشُهمُ أظْفارُه ومَخالِبُهْ",5,"ب",2,0],["فمغاثِ ذي المَعِزِ القليلِ ثُغاؤُهُ","فالماءِ من حاراتِ عند الفَلَّةِ",6,"ه",1,0],["فمَغْنىً جفوتمْ لا وطأتُ تُرابه","ولا ضُربتْ يوماً عليه خيامي",7,"م",2,0],["فمغاني القريض أبيات نور","كن للحسن والغوى محرابا",8,"ب",2,0],["فمغيبُ كالبدر ترتقبُ","الورَى شوقاً طلوعه",9,"ع",2,0],["فمغتبطٌ منهم بوصلٍ وهائمٌ","دهاهُ الهوى عن طيب وصل ملاحهِ",10,"ه",1,1],["فمغاني غربها قد","أوحشت منها المساكن",11,"ن",1,0],["فمغنى الدهر في قتل الأعادي","وحسم رقابهم في كل واد",12,"د",1,0],["فمٌ غاضِبٌ منهم وقلبٌ مُتَيّمٌ","جُهِلتَ حبيبا ً واشتهرتَ مُعادِيا",13,"ي",2,0],["فمغيب البدر منهم طلوع","ومغيب الشموس منهم شروق",14,"ق",1,0]]}