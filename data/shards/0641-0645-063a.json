{"poems":[[93,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[61,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[347,"لبانتنا هواك وما لبينى","https://www.aldiwan.net/poem15975.html","الوافر"],[364,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[374,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[399,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"]],"verses":[["فَمَغْفِرَةٌ حَيْثُ الأَبِيُّ مُجَنْدَلٌ","وَمَقْدِرَةٌ حَيْثُ الْجَبَانُ مُسَلِّمُ",0,"م",1,0],["فمغبوطٌ وليسَ له عَشاءٌ","ومَحسودٌ وليس له دِثارُ",1,"ر",1,0],["فَمَغرِبُ شَمسِ بَهجَتِها بِعَي","نِ الشَهادَةِ عَينُ مَشرِقِها عَلَيها",2,"ه",2,0],["فَمُغرِقُ ماءِ أَينَما سارَ دَمَّرَ","وَمِصعَقُ نارٍ أَينَما حَظَّ حَطَّما",3,"م",2,0],["فمغناطيسُ صوتهمِ حكيمٌ","بجذب حديد قلبٍ لا يبالي",4,"ل",2,0],["فم غادرٍ أبدَى السَّخائمُ واغتدت","تنوشُهمُ أظْفارُه ومَخالِبُهْ",5,"ب",2,0],["فمغاثِ ذي المَعِزِ القليلِ ثُغاؤُهُ","فالماءِ من حاراتِ عند الفَلَّةِ",6,"ه",1,0],["فمَغْنىً جفوتمْ لا وطأتُ تُرابه","ولا ضُربتْ يوماً عليه خيامي",7,"ي",1,0]]}