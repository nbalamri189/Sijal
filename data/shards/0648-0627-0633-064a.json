ك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5431,"أنا ألف ملحمة وقلبٌ أخضرُ","https://www.poetsgate.com/ViewPoem.aspx?id=192158",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5638,"حنين إلى القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200124",""],[5685,"في رثاء زايد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34735",""],[5720,"النبيُّ المُجتَبىٰ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=202870",""],[5723,"ينابيع للشهادة والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=190280",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[5742,"رثاء الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=206959",""],[5829,"رحلة في تضاريس الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=181380",""],[5939,"أنا جدّا عليكِ أغار","https://www.poetsgate.com/ViewPoem.aspx?id=178598",""],[5939,"دستور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=186983",""],[5956,"القداسة في البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193842",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5956,"أرجوك ربي صِلْ فؤاده بي","https://www.poetsgate.com/ViewPoem.aspx?id=204462",""],[5957,"أنا لست شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187339",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6075,"أجيبي نبض قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190482",""],[6093,"كَمْ سَجِيْنٍ سِجْنُهُ مِنْهُ وَ فِيْهِ","https://www.poetsgate.com/ViewPoem.aspx?id=189723",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""],[6167,"معركة الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85480&r=&rc=9",""],[6242,"أرق المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87553&r=&rc=1",""],[463,"اللَّيلُ فالأرضُ للِّيثِ الشَّرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60078&r=&rc=134",""],[463,"لو شاءَ سارٍ ليلة َ النَّعفِ وقفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""],[463,"ألطيمة ٌ حبستْ بكاظمة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60221&r=&rc=277",""],[463,"حملوك لو علموا من المحمولُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60211&r=&rc=267",""],[5190,"عندما تعاتبني ابنتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78339&r=&rc=52",""]],"verses":[["وَأَسيرُ الأَقفاصِ قَد كانَ أَشقى","لَو سَأَلتَ الأَسفارَ عَن بايَزيدِ",0,"د",1,0],["وأَسيَر باللَّوامع خَافقَات","إِلَى الغَمَرَات حَتَّى يَنجلينَا",1,"ن",2,0],["وَأَسيرٍ إِلى أَسيرٍ يُساقونَ","تِباعاً إِلى الشَقاءِ العَتيدِ",2,"د",1,0],["وأَسيرُ في دُنيا المَشَاعرِ حالِماً","غَرِداً وتلكَ سَعادةُ الشعَراءِ",3,"ا",2,0],["واسير من جناته في روضه","غناء اجني ما اشاء واقطف",4,"ف",1,0],["وآسى على تشييعهم حيثُ يممَّوا","تأَسُّفَ مقصوصٍ على الطيرانِ",5,"ن",1,0],["وَأَسيرٍ غَدا لَهُ السِجنُ لَحداً","فَهُوَ حَيٌّ في حالَةِ المَلحودِ",6,"د",1,0],["وَأَسيرُ فَرداً في البِلادِ وَإِنَّني","مِن حَشدِ جَيشِ عَزائِمي في جَحفَلِ",7,"ل",1,0],["وَآسى عَلى جَيحانَ إِذ غاضَ ماؤُهُ","وَإِن كانَ ذَوداً غَيرَ ذَودِيَ ناهِلُه",8,"ل",2,0],["وَأَسيلٍ مِنَ الوُجوهِ نَضيرٌ","دَقَّ فيهِ حُسنُ الجَمالِ وَجَلّا",9,"ل",2,0],["وَأَسيافُنا في كُلِّ شَرقٍ وَمَغرِبٍ","بِها مِن قِراعِ الدارِعينَ فُلولُ",10,"ل",1,0],["واسيتِ مصرَ فما هو نجمٌ لها","إلَّا ومنكِ عليه صدرٌ حاني",11,"ن",2,0],["وآسى عُبَيْدُ اللّهِ ثَمَّ ابنَ أُمِّهِ","وَلَوْ شاءَ نجَّى يَوْمَ ذاكَ حبيِيبي",12,"ي",1,0],["وآسى عُبيدُ الله ثَمَّ ابنَ أُمّهِ","ولو شَاءَ نجّى يومَ ذاك حَبيبي",13,"ي",1,0],["واسيتِ مصرَ فما هوى نجمٌ لها","إلَّا ومنك عليه صدرٌ حاني",14,"ن",2,0],["وَأَسيرُ أَنعُمِكَ الثَناءُ فَلا قَضى","رَبُّ الخَلائِقِ أَن يُفَكَّ إِسارُهُ",15,"ر",2,0],["وأسيافنا قد جرّدت من جفونها","وردت إليها بعد ورد وقد روى",16,"و",2,0],["واسئل الله دوام ملكه","في نعم صفت من الأكدار",17,"ر",1,0],["وآسى وفي الأرضِ مثلُ العميدِ","أبي طاهرٍ خلفِ بنِ الحسَنْ",18,"ن",1,0],["وأسى المنافي قد سَقاكَ مِنَ النوى","وتعثّرَتْ في ظلّكَ الأضْواءُ",19,"ا",2,0],["وَأُسيدٌ سعدٌ رفاعة عبد ال","لَه سعدٌ يا حبّذا النقباءُ",20,"ا",2,0],["وَأَسيلَةِ الخَدَّينِ ساجٍ طَرفُها","بَيضاءَ مونِقَةٍ لعَينِ المُجتَلي",21,"ل",2,0],["واسيافهم غضبى يطير فرندها","كالحاظهم في البأس حين تدورُ",22,"ر",1,0],["وأسيادُها زربيَّةٌ خَلفَ دائصٍ","وطاغيةُ الإفرنجِ صارَ المؤمَّرا",23,"ر",2,0],["وأسيرُ فيكِ مشرّقاً ومغرّباً","وأجرّ ذيلَ التائهِ المتكبّر",24,"ر",1,0],["وَأَسِيرَ دَهْرٍ لا يُرامُ فَكاكُهُ","وَقَتِيلِ فَقْرٍ لا يُرى إِحْياؤُهُ",25,"ا",3,0],["وأسى إذا ما الصّبر ساجلَ كربَه","نفد التصبر والأسى لا ينفَد",26,"د",1,0],["واسى اليتامى وعالَ المعدمين وكمْ","عمَّنْ أَساءَ وآذاه لقد صفحا",27,"ح",2,0],["واسَيْتَ (جلَّق) في عظيمِ مُصابِها","وَنضحتَ عنها بالبيان مُجاهدا",28,"د",2,0],["وأَسىً ذَادَ عن العينِ الهجوعْ","ليتَ شِعري فيمَ تسكابُ الدُّموعْ",29,"ع",1,0],["واسيتِهِ وجواري السعدِ مدبرة","فربما أقبلتْ يوماً فواساك",30,"ك",1,0],["وَأسىً بِهِ حار الأساة ذوو النُهى","وَعَناً بِهِ جلدُ المُحبّ قَد اِنبَرى",31,"ر",2,0],["وَاِسئَل اَهيل الحَيّ عَن قَلبي فَمُذ","فارَقت طيبَة لَم أَجِد قَلبي مَعي",32,"ع",2,0],["واسِياني فللأخِلاء قِدْماً","بالتّواسي في النّائباتِ تَواص",33,"ص",1,0],["وَأَسِينا أَن لا نكونَ رَأَينا","هُ فَقد أَقرَحَ الصُدورَ أَسانا",34,"ن",2,0],["وأسيلِ الخَدِّ شاحِبهِ","كُحِلَت عَيناهُ بالفِتَنِ",35,"ن",1,0],["وَأَسيغ ماء الدَمع مِن تِذكارِها","وَاغص بِالماء الزلال وَأَشرَقُ",36,"ق",1,0],["واسيتُهُ وبقلبي مثلُ لوعتِهِ","وحسرةٌ لو درى عنها لواساني",37,"ن",2,0],["واسيتَ بالقول الجميل أحبَّةً","في لحظةٍ، وجدوا العمارَ دَمَارا",38,"ر",2,0],["واسَّيتني في النظام البديع","وما لي يا ولدي والأسا",39,"ا",1,0],["وأسيرٍ أتاه يرسُفُ في قي","دِ هوان ففكّ عنه عِقالَهْ",40,"ل",2,0],["وأسيرِ عُسْرٍ يُسْرَكَ بارقاً","فسقاهُ هاطلُ دَيْمةٍ تُقْلِعا",41,"ع",2,0],["وأسى ممرّ المجد منفصم العُرى","وعاد التئام الدين منثغرا الثغر",42,"ر",1,0],["وأَسيراً مُصَفَّداً فِي وَثَاقٍ","وغِياثاً لطارِقٍ جَفَّ فُوهُ",43,"و",2,0],["وأسياد حرب لم يخفهم هديرها","ولم يثنهم وشي الحرير المطرزِ",44,"ز",1,0],["وأسيرُ فوق ثَرَاكَ لا مترفقاً","ورعاً فحسبُ بل الشهيدَ الدامى",45,"م",2,0],["وأسيءُ ظنَّا وهي محسنةٌ","لا كالمسيء ويُحسنُ الظنَّا",46,"ن",2,0],["وأسيافٌ لَهنّ الهْا","مُ أغمادٌ وأجفانُ",47,"ن",1,0],["وآسى على زمنٍ مرّ بِي","وما لِيَ مثلك من كافلِ",48,"ل",1,0],["وأسيافٌ سُلِلْن على الديّاجي","لها عهدٌ قريبٌ بالصّقالِ",49,"ل",1,0],["وأسيرَ شَجْوٍ لا يُطيق فراقهمْ","يبكي وقد شَحَطَ الخليطُ طليقا",50,"ق",2,0],["وأسياف صقيلات وأرماح","طويلات وضرّاب وطعّان",51,"ن",1,0],["وأسير مكبَّلٌ وقتيل","دار سلمى ما دار فيها كثيفُ",52,"ف",1,0],["وأَسيرُ سيراً عنهمُ","لأَرى مرادَ القلبِ جَهْرا",53,"ر",2,0],["وَأَسيمُ في رَوضِ الحِسانِ مَوزِعاً","قَلباً وَهيَ بِالحَملِ غَيرَ موزِعِ",54,"ع",1,0],["وأسيل الخدّ آه لو ترى","ماء خديه بناء تلتهب",55,"ب",1,0],["واسيتمُ الفقراء عن بأسائهم","فاللّه يَجزيكم عن الفقراءِ",56,"ا",2,0],["واسيتَني وكَفَتَني وحَمَيتَني","إذ لَيسَ يَكفي سَيِّدٌ ويواسي",57,"س",2,0],["وَأُسِيمُ سَرحَ اللَحظِ بَينَ مَحاجِرٍ","وَمَعاجرٍ مِن مُعصِرٍ وَكِعابِ",58,"ب",1,0],["وأسيافه في البحث قاطعة الظبا","بجوهرها لم يفتقر للصياقل",59,"ل",1,0],["واسيتها بِالحَزم وَالسِياسهْ","وَفُزت في العِلاج بِالرياسهْ",60,"ه",1,0],["وأَسيافه بالوهم في أَنفس العدى","تَقُدُّ وَتَفري ما أَحدَّ نصالها",61,"ل",3,0],["واسيتِ بالنعمى دمشق ونبَّهتْ","دعواتُكِ الكبرى بني بغداد",62,"د",1,0],["وأسير باسمك أملأ الوادي كما","قد كنت تملؤه قنا وبنودا",63,"د",2,0],["وأسىً كلما خبا","ضوؤه عاد يقدحُ",64,"ح",1,0],["وأَسىً نِيطَ بالنياطِ حكى في","نهشه القلبَ أرقماً نَهَّاشا",65,"ش",2,0],["وأسىً عليَّ فإن أفأت بمقلتي","يحدو سوابقَ دمعها حاديها",66,"ي",3,0],["وآسير في لخلافي","لو يلحقني ندم",67,"م",1,0],["وَأَسيافُنا في كُلِّ شَرقٍ وَمَغرِبٍ","لَها وَقعُ فِعلٍ طارَ مِنه العقولُ",68,"ل",1,0],["وأسياف تشق إلى قلوب","لتتضح الضغاين بالعياق",69,"ق",1,0],["وأسيل الدموع شيئا فشيئا","وأجوب الربوع ميلا فميلا",70,"ل",2,0],["واسير بين خزامه وعواره","وأعود منه بزرنب وقرنفل",71,"ل",1,0],["وأسير من باب السلام مسلما","تسليم صب للتراب مقبل",71,"ل",1,0],["وَأسيلُ خدك أمْ رِيَاضٌ مُونِقٌ","أم ذَاكَ نُعْمَانٌ بِهِ نُعْمَانُ",72,"ن",1,0],["وَاسَيتني فيما حَوَت كفّاك من","تبرٍ وَمِن إبلٍ ومن أفراسِ",73,"س",1,0],["وَاسَيتني فيما سعدت ويا أيا","شكراً لمن هُو في السعادةِ واسا",74,"س",2,0],["وَآسى أَن تَطولَ يَدايَ مِنهُ","إِلى ما لا يُطاوِلهُ لِساني",75,"ن",2,0],["وأسياف مِقْوله والنصال","لأعمار أعدائه باترة",76,"ر",2,0],["وأسيادٍ من العبدان تتْرى","وأعراشٍ تُشيَّدُ من صفيح",77,"ح",1,0],["وَأَسياد القَبائل وَالمَوالي","إِلَيكَ عُيونَها أَبَداً تُدارُ",78,"ر",1,0],["واسئل عن الركب ايصال السلام لهم","ان ضن بالأخذ واقصص من عبارات",79,"ت",1,0],["واسيلٍ ورقيق صقيل","وطويل فيه عقد جُمانِ",80,"ن",1,0],["وأسير يرجو الفداء ويخشى","وقعة السيف قبل إنجاء فاد",81,"د",1,0],["واسي المحب فإن تنفس لم يدم","للغيد منسوجٌ ولا مصبوب",82,"ب",1,0],["واسيت جدك في المعروف حيدرة","حتى توفيت يوماً فيه يقتبر",83,"ر",1,0],["واسئل به إذ أتى الأحزاب يقدمهم","عمرو وصفين سل ان كنت لم تسل",84,"ل",1,0],["وَأَسيافُنا تَندى وَما كُل ساعة","عَلَيها النُفوس الجامِدات تَسيل",85,"ل",1,0],["واسيافكم حمر الضبا يوم معرك","لها الهام ملهى والترائب ملعب",86,"ب",1,0],["واسى الرَسولَ بِها في الغارِ مُصطَبِراً","عَلى عِضاضِ الأَفاعي لا يُباليها",87,"ي",3,0],["واسى الامام سميه","فغدا له في الحكم تابع",88,"ع",1,0],["وأسيافه لم تدر ما طعم ضربة","فهن صحاح ما بهن ثلوم",89,"م",1,0],["وَأَسيافُنا آثارُهُنَّ كَأَنَّها","مَشافِرُ قَرحى في مَبارِكِها هُدلُ",90,"ل",1,1],["وأسِيلةُ الخدّيْنِ في وجناتِها","وردٌ حماه السيفُ أنّ لا يُجتَنَى",91,"ن",2,0],["وَأَسياني عَلى الغَرام بلميا","يا خَليليَّ وَالخَليل المواسي",92,"س",2,0],["وَأَسيافُكُم يَنهلُّ مِنها دَم الطَلا","وَأيمانُكُم يَرفضُّ مِنها حَيا الجَدوى",93,"و",2,0],["وآسى كلوم الدهر طب زمانه","رشيف غزير الفضل ذي الاب",94,"ب",1,0],["واسئل فؤادك هل له أمل بما","يشفى ضناه وفيه منك سقام",95,"م",1,0],["واسئل مدينتنا عن الفوز الذي","نالته ان كانت تسيغ المنطقا",96,"ق",2,0],["وَآسَيتُ السَليمَ بِخَيرِ سَلوى","