{"poems":[[86,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[89,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[62,"أيا بانتي وادي الأراك وقيتما","https://www.aldiwan.net/poem52264.html","الطويل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[44,"جوى ساور الأحشاء والقلب واغله","https://www.aldiwan.net/poem30306.html","الطويل"],[31,"جن قلبي فقلت يا قلب مهلا","https://www.aldiwan.net/poem41849.html","الخفيف"],[17,"إذا المرء لم يدنس من اللؤم عرضه","https://www.aldiwan.net/poem1201.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72187","الطويل"],[36,"دعا قابضأ والموت يخفق ظله","https://www.poetsgate.com/ViewPoem.aspx?id=15860",""],[96,"الأجنحة المحترقة","https://www.poetsgate.com/ViewPoem.aspx?id=13191",""],[143,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[147,"توسد بمهد الأمن قد مرت النوى","https://www.aldiwan.net/poem47688.html","الطويل"],[160,"بالسعد دار نجم هذا الدار","https://www.aldiwan.net/poem58972.html","الرجز"],[166,"رعى الله عهد حبيب ظعن","https://www.aldiwan.net/poem46862.html","المتقارب"],[178,"موت يشتهيه الرثاء","https://www.aldiwan.net/poem50697.html","الكامل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[195,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[199,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[270,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[280,"يا حسنه قمرا وأنت سماؤه","https://www.aldiwan.net/poem60576.html","الكامل"],[281,"دمع بنيران الضلوع يصعد","https://www.aldiwan.net/poem1365.html",""],[298,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[298,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[298,"حق للمخزون أن ترثي له","https://www.aldiwan.net/poem36287.html","عموديه"],[298,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[353,"شجن تحار بدرك غايته الورى","https://www.aldiwan.net/poem40237.html","الكامل"],[361,"عج بالعقيق وقف بذات الاجرع","https://www.aldiwan.net/poem68093.html","الكامل"],[364,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[365,"إنني بالنبي موقنة نفسي","https://www.aldiwan.net/poem44475.html","الخفيف"],[371,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[380,"برق بدا جنح الدجى يتألق","https://www.aldiwan.net/poem48835.html","الكامل"],[400,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[400,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[403,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[432,"در علم يلوح في فلك الفضل","https://www.aldiwan.net/poem12460.html","الخفيف"],[432,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[437,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[439,"يا غياث العباد إن بخل المز","https://www.aldiwan.net/poem34805.html","الخفيف"],[451,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[453,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[458,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[558,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[575,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["وَأَسيرُ الأَقفاصِ قَد كانَ أَشقى","لَو سَأَلتَ الأَسفارَ عَن بايَزيدِ",0,"د",1,0],["وأَسيَر باللَّوامع خَافقَات","إِلَى الغَمَرَات حَتَّى يَنجلينَا",1,"ن",2,0],["وَأَسيرٍ إِلى أَسيرٍ يُساقونَ","تِباعاً إِلى الشَقاءِ العَتيدِ",2,"د",1,0],["وأَسيرُ في دُنيا المَشَاعرِ حالِماً","غَرِداً وتلكَ سَعادةُ الشعَراءِ",3,"ا",2,0],["واسير من جناته في روضه","غناء اجني ما اشاء واقطف",4,"ف",1,0],["وآسى على تشييعهم حيثُ يممَّوا","تأَسُّفَ مقصوصٍ على الطيرانِ",5,"ن",1,0],["وَأَسيرٍ غَدا لَهُ السِجنُ لَحداً","فَهُوَ حَيٌّ في حالَةِ المَلحودِ",6,"د",1,0],["وَأَسيرُ فَرداً في البِلادِ وَإِنَّني","مِن حَشدِ جَيشِ عَزائِمي في جَحفَلِ",7,"ل",1,0],["وَآسى عَلى جَيحانَ إِذ غاضَ ماؤُهُ","وَإِن كانَ ذَوداً غَيرَ ذَودِيَ ناهِلُه",8,"ل",2,0],["وَأَسيلٍ مِنَ الوُجوهِ نَضيرٌ","دَقَّ فيهِ حُسنُ الجَمالِ وَجَلّا",9,"ل",2,0],["وَأَسيافُنا في كُلِّ شَرقٍ وَمَغرِبٍ","بِها مِن قِراعِ الدارِعينَ فُلولُ",10,"ل",1,0],["واسيتِ مصرَ فما هو نجمٌ لها","إلَّا ومنكِ عليه صدرٌ حاني",11,"ن",2,0],["وآسى عُبَيْدُ اللّهِ ثَمَّ ابنَ أُمِّهِ","وَلَوْ شاءَ نجَّى يَوْمَ ذاكَ حبيِيبي",12,"ي",1,0],["وآسى عُبيدُ الله ثَمَّ ابنَ أُمّهِ","ولو شَاءَ نجّى يومَ ذاك حَبيبي",13,"ي",1,0],["واسيتِ مصرَ فما هوى نجمٌ لها","إلَّا ومنك عليه صدرٌ حاني",14,"ن",2,0],["وَأَسيرُ أَنعُمِكَ الثَناءُ فَلا قَضى","رَبُّ الخَلائِقِ أَن يُفَكَّ إِسارُهُ",15,"ر",2,0],["وأسيافنا قد جرّدت من جفونها","وردت إليها بعد ورد وقد روى",16,"و",2,0],["واسئل الله دوام ملكه","في نعم صفت من الأكدار",17,"ر",1,0],["وآسى وفي الأرضِ مثلُ العميدِ","أبي طاهرٍ خلفِ بنِ الحسَنْ",18,"ن",1,0],["وأسى المنافي قد سَقاكَ مِنَ النوى","وتعثّرَتْ في ظلّكَ الأضْواءُ",19,"ا",2,0],["وَأُسيدٌ سعدٌ رفاعة عبد ال","لَه سعدٌ يا حبّذا النقباءُ",20,"ا",2,0],["وَأَسيلَةِ الخَدَّينِ ساجٍ طَرفُها","بَيضاءَ مونِقَةٍ لعَينِ المُجتَلي",21,"ل",2,0],["واسيافهم غضبى يطير فرندها","كالحاظهم في البأس حين تدورُ",22,"ر",1,0],["وأسيادُها زربيَّةٌ خَلفَ دائصٍ","وطاغيةُ الإفرنجِ صارَ المؤمَّرا",23,"ر",2,0],["وأسيرُ فيكِ مشرّقاً ومغرّباً","وأجرّ ذيلَ التائهِ المتكبّر",24,"ر",1,0],["وَأَسِيرَ دَهْرٍ لا يُرامُ فَكاكُهُ","وَقَتِيلِ فَقْرٍ لا يُرى إِحْياؤُهُ",25,"ا",3,0],["وأسى إذا ما الصّبر ساجلَ كربَه","نفد التصبر والأسى لا ينفَد",26,"د",1,0],["واسى اليتامى وعالَ المعدمين وكمْ","عمَّنْ أَساءَ وآذاه لقد صفحا",27,"ح",2,0],["واسَيْتَ (جلَّق) في عظيمِ مُصابِها","وَنضحتَ عنها بالبيان مُجاهدا",28,"د",2,0],["وأَسىً ذَادَ عن العينِ الهجوعْ","ليتَ شِعري فيمَ تسكابُ الدُّموعْ",29,"ع",1,0],["واسيتِهِ وجواري السعدِ مدبرة","فربما أقبلتْ يوماً فواساك",30,"ك",1,0],["وَأسىً بِهِ حار الأساة ذوو النُهى","وَعَناً بِهِ جلدُ المُحبّ قَد اِنبَرى",31,"ر",2,0],["وَاِسئَل اَهيل الحَيّ عَن قَلبي فَمُذ","فارَقت طيبَة لَم أَجِد قَلبي مَعي",32,"ع",2,0],["واسِياني فللأخِلاء قِدْماً","بالتّواسي في النّائباتِ تَواص",33,"ص",1,0],["وَأَسِينا أَن لا نكونَ رَأَينا","هُ فَقد أَقرَحَ الصُدورَ أَسانا",34,"ن",2,0],["وأسيلِ الخَدِّ شاحِبهِ","كُحِلَت عَيناهُ بالفِتَنِ",35,"ن",1,0],["وَأَسيغ ماء الدَمع مِن تِذكارِها","وَاغص بِالماء الزلال وَأَشرَقُ",36,"ق",1,0],["واسيتُهُ وبقلبي مثلُ لوعتِهِ","وحسرةٌ لو درى عنها لواساني",37,"ي",1,0],["واسيتَ بالقول الجميل أحبَّةً","في لحظةٍ، وجدوا العمارَ دَمَارا",38,"ر",2,0],["واسَّيتني في النظام البديع","وما لي يا ولدي والأسا",39,"ا",1,0],["وأسيرٍ أتاه يرسُفُ في قي","دِ هوان ففكّ عنه عِقالَهْ",40,"ل",2,0],["وأسيرِ عُسْرٍ يُسْرَكَ بارقاً","فسقاهُ هاطلُ دَيْمةٍ تُقْلِعا",41,"ع",2,0],["وأسى ممرّ المجد منفصم العُرى","وعاد التئام الدين منثغرا الثغر",42,"ر",1,0],["وأَسيراً مُصَفَّداً فِي وَثَاقٍ","وغِياثاً لطارِقٍ جَفَّ فُوهُ",43,"و",2,0],["وأسياد حرب لم يخفهم هديرها","ولم يثنهم وشي الحرير المطرزِ",44,"ز",1,0],["وأسيرُ فوق ثَرَاكَ لا مترفقاً","ورعاً فحسبُ بل الشهيدَ الدامى",45,"م",2,0],["وأسيءُ ظنَّا وهي محسنةٌ","لا كالمسيء ويُحسنُ الظنَّا",46,"ن",2,0],["وأسيافٌ لَهنّ الهْا","مُ أغمادٌ وأجفانُ",47,"ن",1,0],["وآسى على زمنٍ مرّ بِي","وما لِيَ مثلك من كافلِ",48,"ل",1,0],["وأسيافٌ سُلِلْن على الديّاجي","لها عهدٌ قريبٌ بالصّقالِ",49,"ل",1,0],["وأسيرَ شَجْوٍ لا يُطيق فراقهمْ","يبكي وقد شَحَطَ الخليطُ طليقا",50,"ق",2,0],["وأسياف صقيلات وأرماح","طويلات وضرّاب وطعّان",51,"ن",1,0],["وأسير مكبَّلٌ وقتيل","دار سلمى ما دار فيها كثيفُ",52,"ف",1,0],["وأَسيرُ سيراً عنهمُ","لأَرى مرادَ القلبِ جَهْرا",53,"ر",2,0]]}