{"poems":[[53,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[53,"لو علمت أي فتى ماجد","https://www.aldiwan.net/poem30613.html","السريع"],[55,"من لي بمن أخشى الوشاة","https://www.aldiwan.net/poem26044.html","مجزوء الكامل"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[27,"حي الهدملة والأنقاء والجردا","https://www.aldiwan.net/poem5730.html","البسيط"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[47,"لم أؤاخذك بالجفاء لأني","https://www.aldiwan.net/poem25337.html","الخفيف"],[51,"حلفت برمان الثدي النواهد","https://www.aldiwan.net/poem61886.html","الطويل"],[51,"أبا الصقر لا تدعني للبراز","https://www.aldiwan.net/poem65769.html","المتقارب"],[91,"بأبي خيال لاح لي متلففا","https://www.aldiwan.net/poem62779.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[32,"إن المنازل هيجت أطرابي","https://www.aldiwan.net/poem27754.html","الكامل"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[43,"ما الشوق مقتنعا مني بذا الكمد","https://www.aldiwan.net/poem9538.html","البسيط"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[62,"قد قلت للتلميذ أذهله","https://www.aldiwan.net/poem52195.html","أحذ الكامل"],[45,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[45,"قالت الشيب بدا قلت أجل","https://www.aldiwan.net/poem65571.html","الطويل"],[80,"يا صورة الحسن التي طلعت","https://www.aldiwan.net/poem31267.html","أحذ الكامل"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[31,"يا صاحبي قفا نستخبر الدارا","https://www.aldiwan.net/poem42542.html","البسيط"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[81,"علقت ببدر لامني فييه عاذل","https://www.aldiwan.net/poem61376.html","الطويل"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[52,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[48,"باكر صبوحك فهو خير عتاد","https://www.aldiwan.net/poem62550.html","الكامل"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[50,"راحَتْ سُلَيْمَى تَدْعُوكَ بِالْعَنَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21671",""],[43,"ما الشوق مقتنعا مني بذا الكمد","https://www.poetsgate.com/ViewPoem.aspx?id=81",""],[67,"أهلُ التُّقَى والعِلم أهلُ السُّؤْدُدِ","https://www.poetsgate.com/ViewPoem.aspx?id=14531",""],[45,"باللهِ أُقسِمُ لو مُلِّكْتُ أَلْسِنَةً","https://www.poetsgate.com/ViewPoem.aspx?id=32030",""],[78,"سَكِّن فُؤادكَ لا تَذهَب بِكَ الفِكَرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86482&r=&rc=27",""],[31,"يا صاحبيّ، قفا نستخبرِ الطللا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19020&r=&rc=283",""],[125,"لما وجدت مكارم الأخلاق","https://www.aldiwan.net/poem23750.html","مجزوء الكامل"],[133,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[170,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[230,"لما وقفت مواقف العشاق","https://www.aldiwan.net/poem50923.html","الكامل"],[233,"لما وردت فديتها أسطركم","https://www.aldiwan.net/poem14921.html","الدوبيت"],[236,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[236,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[255,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[260,"لي منكم ورد الكتاب وضمنه","https://www.aldiwan.net/poem35789.html","الكامل"],[271,"لما وردت الماء صار لهيبا","https://www.aldiwan.net/poem35420.html","الكامل"],[276,"جمعت للناس بين الري والشبع","https://www.aldiwan.net/poem25427.html","البسيط"],[298,"وافى خيالك بعد طول نفار","https://www.aldiwan.net/poem33268.html","الكامل"],[347,"جاء البريد بقرطاس يخب به","https://www.aldiwan.net/poem24140.html","البسيط"],[349,"لم أودع من سار في دعة الل","https://www.aldiwan.net/poem19892.html","الخفيف"],[365,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[366,"لو كان عباس هنالك حاضرا","https://www.aldiwan.net/poem44507.html","الكامل"],[370,"بحمد الله وافتنا التهاني","https://www.aldiwan.net/poem4312.html","الوافر"],[407,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[417,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[442,"لولا مخافة بيع قائد الغبن","https://www.aldiwan.net/poem14431.html","البسيط"],[459,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[471,"وما الشعر إلا خطبة من مؤلف","https://www.aldiwan.net/poem4802.html","الطويل"],[501,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[507,"يا زائرا لم يقض أن ألقاه","https://www.aldiwan.net/poem2374.html","الكامل"],[515,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[516,"أنسيم عرفك أم شميم عرار","https://www.aldiwan.net/poem12150.html","الكامل"],[516,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[563,"خلت الديار كأنها لم تؤهل","https://www.aldiwan.net/poem52933.html","الكامل"]],"verses":[["لَم أُوتَ مِن نُصحٍ وَلا شَفَقٍ","فَالشَرُّ وَالأَعداءُ في قَرَنِ",0,"ن",1,0],["لَمّا وَفى لي مَوعِدي بِالنَوى","مِن غَيرِ ذَنبٍ وَوَفى وَاِعِدي",1,"د",2,0],["لَمّا وَقَفتُ بِبابِهِ","وَفَزِعتُ مِن هِجرانِهِ",2,"ن",2,0],["لَم أوتِ في الحالِ مِن سَعيي لَدَيكَ وَنىً","بَل بِالجُدودِ تَطيرُ الحالُ أَو تَقَعُ",3,"ع",1,0],["لَمّا وَرَدتُ بِوِردِ حَضرَتِكَ المُنى","فَهِقَت لَدَيَّ جِمامُها الأَعدادُ",4,"د",1,0],["لَمّا وَقَفتُ بِها القَلوصَ تَبادَرَت","حَبَبُ الدُموعِ كَأَنَّهُنَّ عَزالي",5,"ل",2,0],["لَمّا وَرَدنا مِنَ الفَيّاضِ مَشرَعَةً","جُزنا بِحَومَةِ بَحرٍ لَم يَكُن ثَمَدا",6,"د",2,0],["لَمّا وَضَعتُ عَلى الفَرَزدَقِ مَيسَمي","وَضَغا البَعيثُ جَدَعتُ أَنفَ الأَخطَلِ",7,"ل",1,0],["لَمّا وَليتَ لِثَغرِ قَومي مَشهَداً","آثَرتُ ذاكَ عَلى بَنِيِّ وَمالي",8,"ل",2,0],["لَم أُؤاخِذكَ بِالجَفاءِ لِأَنّي","واثِقٌ مِنكَ بِالوَفاءِ الصَحيحِ",9,"ح",1,1],["لما وَجَدَتْ وجدي بكم أُمُّ واحدٍ","تَعُوذُ من الأَسْواء فيه بواحدِ",10,"د",1,0],["لِما وَضَعَ الدهرُ من هِمَّتِي","وما رفع اللَّهُ منْ شأْنِكا",11,"ك",2,0],["لَمّا وَلَدَتهُمُ نُسوراً حَلَّقوا","لا يَقنَعونَ مِنَ العُلى بِالدونِ",12,"ن",1,0],["لَمّا وَعى اللَهُ شَكايا الوَرى","قالَ لَهُم كونوا كَما تَشتَهون",13,"ن",1,0],["لَم أُوتَ مِن زَمَني شَيئا أُسِرُّ بِهِ","فلست أَعهَدُ ما كأس وَلا وترُ",14,"ر",1,0],["لَمّا وَقَفتُ بِها القَلوصَ تَبادَرَت","مِنّي الدُموعُ لِفُرقَةِ الأَحبابِ",15,"ب",1,0],["لَمّا وَجَدتَ مُعِدّاتِ البِناءِ بَنَت","يَداكَ لِلقَومِ ما ذَمّوا وَما حَمَدوا",16,"د",3,0],["لَمّا وَزَنتُ بِكَ الدُنيا فَمِلتَ بِها","وَبِالوَرى قَلَّ عِندي كَثرَةُ العَدَدِ",17,"د",1,0],["لَمّا وَجَدتُ دَواءَ دائي عِندَها","هانَت عَلَيَّ صِفاتُ جالينوسا",18,"س",2,0],["لما وجدنا الأمر مختصرا","سهلاً سددنا دونه الطرقا",19,"ق",2,0],["لِما وَصَلَت أَسماءُ مِن حَبلِنا شُكرُ","وَإِن حُمَّ بِالبَينِ الَّذي لَم نُرِد قَدرُ",20,"ر",1,1],["لَم أُوَهَّم نِعمَتي تَغدُرُ بي","غَدرَةً الظِلُّ سَجا ثُمَّ اِنتَقَل",21,"ل",1,0],["لمّا وجدتُ هَواكِ خامَرَني","أيقنتُ أنّ هواك روحاني",22,"ن",2,0],["لَمّا وَرَدنَ حِياضَ سَيبِكَ طُلَّحاً","خَيَّمنَ ثُمَّ شَرِبنَ شُربَ الهيمِ",23,"م",1,0],["لَمّا وَقَفنا نُحَيِّهِم وَقَد صَرَخَت","هَواتِفُ البَينِ فَاِستَولَت بِهِم أُصُلا",24,"ل",2,0],["لَمّا وَقَفنا وَغَيَّبنا رَكائِبَنا","بَدَلنَ بِالعِرفِ بَعدَ الرَجعِ إِنكارا",25,"ر",2,0],["لَمّا وَقَفنا لِلوَداعِ عَشِيَّةً","خَفَقَت لِمَوقِفِنا قُلوبُ الحُسَّدِ",26,"د",1,0],["لَمَأ وَجدُ طَيرِ القَفصِ مُذ بَانَ وَكرُهُ","وَمَن ذَكَرَ الأوطَانَ وَالقَلبُ ذَائِبُ",27,"ب",1,0],["لَمّا وَرَدتُ الطَوِيَّ وَالحَوضُ كَالص","يرَةِ دَفنُ الإِزاءِ مُلتَبِدُه",28,"د",2,0],["لَمّا وَرَدنَ الماءَ خَلَّفنَ الصَدى","وَخَرَجنَ مِن سُقمِ الهَواجِرِ نُقَّها",29,"ه",2,0],["لَمّا وَقَفتُ عَلى الأَطلالِ أَبكاني","ما كانَ أَضحَكَني مِنها وَأَلهاني",30,"ن",2,0],["لَمَّا وَرَدْتُ عَلَى كَرِيمِ جَنَابِهِ","فوَرَدْتُ بَحْرَ الْجُودِ عَذْبَ المَوْرِدِ",31,"د",1,0],["لَمّا وَرَدناها نُلِمُّ بِشَيخِها","عِلجٌ يُحَدِّثُ عَن مَصانِعِ عادِ",32,"د",1,0],["لَمّا وَجَدنا قالَت لِقَينَتِها","قولي رَضينا فَنَم وَلا تَجِدِ",33,"د",1,0],["لما وصلتُ إلى المصيف حملتُها","كالطفلِ نامَ على ذراعِ المرضعِ",34,"ع",1,0],["لما وقفتَ تلفّتَ المحرابُ من","فرحٍ وأنتَ لديه حانٍ مطرقُ",35,"ق",1,0],["لَمَّا وَجَدْنَا قَالَتْ لِقَيْنَتِهَا:","قولي وضينا فنم ولا تجد",36,"د",1,0],["لما وزنت بك الدنيا رجحت بها","وبالورى قل عندي كثرة العدد",37,"د",1,0],["لَمَّا وَرَأَيتُ وَجْهاً أَشْرَقَتْ أَنْوَارُه","فَأضاءَ مثلَ الكوكَبِ المُتَوَقِّد",38,"د",1,0],["لَمَا وَفَيْتُ لِمَا أَوْلَيْتَ مِنْ حَسَنٍ","ولا نَهَضتُ بِمَا حَمَّلتَ مِنْ نِعَمِ",39,"م",1,0],["لَم أُوتَ مِن زَمَني شَيئًا ألذُّ بِهِ","فلستُ أَعهَدُ ما كأسٌ وَلا وتَرُ",40,"ر",1,0],["لَمّا وَقَفْنَا نُحَيّيهِمْ، وَقَدْ شَحَطَتْ","نَعَامَة ُ البَيْنِ، فَکسْتَوْلَتْ بِهِم أُصُلا",41,"ل",2,0],["لما وجدت مكارم الأخلاق","في الدنيا كلام",42,"م",1,1],["لَمَّا وَقَفتُ اُحَيِّيهَا وأندُبُهَا","أجرَى دُمُوعُىَّ جوي تِذكَارُ جِيرَانِ",43,"ن",1,0],["لَمّا وَقَفتُ العيسَ في عَرَصاتِها","ذَهَبَ العَزاءُ وَأَقبَلَت أَجفاني",44,"ن",2,0],["لما وقفتُ مواقِفَ العُشّاقِ","وتعلَّق المشتاقُ بالمشتاقِ",45,"ق",1,1],["لَمّا وَرَدَت فَدَيتُها أَسطُرُكُم","أَرسَلتُ جَوابَها لِكَي أَشكُرُكُم",46,"م",1,1],["لَمّا وَقَفنا لِلوَدا","عِ وَقَد دَعا داعي الرَحيلِ",47,"ل",1,0],["لَمّا وَقَفناهُ نُطارِحُ سُمرَهُ","بَثَّ الجَوى وَتُظِلُّنا سَمُراتُهُ",48,"ت",2,0],["لم أوافقْ فيه صدقاً","كاذبٌ صنفٌ مُريبُ",49,"ب",1,0],["لم أوفِ حقّ عهوده لو أنّني","أفنيت فيه مداركي ومشاعري",50,"ر",2,0],["لمّا وَرَدتُ الماءَ صارَ لهيبا","وبحُبِّها أستَعذِبُ التّعذيبا",51,"ب",2,1],["لَمَّا وَلِيتَ خَلعْت الخَيْرَ أجْمَعهُ","عَلَيْهِمُ فَبَدَوْا فِي أَجْمَلِ الخِلَعِ",52,"ع",1,0],["لم أوفِه حقّاً أَحال به على","قَلبي الكَئيبِ وَمدمعي المدرارِ",53,"ر",1,0],["لَمّا وَرَدتُ وَبابُ القَصرِ مُنطَبِقٌ","لِصَوتِ رَملَةَ هُدَّ القَلبُ فَاِنصَدَعا",54,"ع",2,0],["لَمْ أُوَدِّعْ مَن سَارَ في دَعَةٍ اللَّ","هِ وقَلْبي يَسِيرُ تَحْتَ رِكابِه",55,"ه",1,1],["لمّا وصَلْنا سالمِينَ قضَى","كُلٌّ غداةَ وُصولِه نَذرا",56,"ر",2,0],["لمّا وقعنا في التنازُلِ خَفخَفَت","مثلَ النعام مَخَافةً للأَشقرِ",57,"ر",1,0],["لما واجهت بالبُشرى سواها","وحسبي من فلانٍ أو فلان",58,"ن",1,0],["لما وجدوا لمجدك من قرينٍ","ولا وجدوا شبيهك في قِران",58,"ن",1,0],["لَمّا وَطئت دِمَشقاً بيع ما وطئت","رِجلاك مِنها بِسعر العَنبَر الذَفرِ",59,"ر",1,0],["لما وقفت على منازلها ضحىً","حَيَّيتُها بتحيَّةِ الكرماء",60,"ا",2,0],["لم أَورد الصرم فيكم بعد وصلكم","حتى تفارق روحي عندكم بدني",61,"ن",2,0],["لَمَا وفّتِ الصوارمُ والعوالي","بما جنتِ المحاجرُ والقدودُ",62,"د",1,0],["لَما وَخَدَت شَهراً بِرَحليَ جَسرَةٌ","تَفُلُّ مُتونَ البيدِ بَينَ الرَواحِلِ",63,"ل",1,0],["لمَّا وفَدْتُ على المُخْتارِ أَكرَمَني","وقالَ لي بينَهُمْ بورِكْتَ من رَجُلِ",64,"ل",1,0],["لما وجدت فناءَ داري عاطراً","أيقنتُ أنك قد وطئت ثراه",65,"ا",2,0],["لمّا ولَجْتُ إليهِ خِدراً ضمّ في","جَنَباته صنَماً فُتِنْتُ بوردِهِ",66,"د",2,0],["لما وليت على البحيرة أصبحت","حرماً رخيص الأمن والأسعار",67,"ر",1,0],["لما وصلت قاطعاً","إذا رأى جدي هزل",68,"ل",1,0],["لَمّا وَرَدتُ خِيامَهنّ سَقَيننِي","مِن كُلِّ مَعسولِ الرُّضاب بُرادِ",69,"د",1,0],["لمَّا وَفْدتَ على الدِّيارِ تَعجَّبت","من بعثِ بُولُسَ قبلَ يومِ المَحفَلِ",70,"ل",1,0]]}