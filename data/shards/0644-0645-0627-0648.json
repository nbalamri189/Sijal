42",""],[5419,"عذراً رسولَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=32217",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5472,"إنى إذا ما صاحبي تعدّى","https://www.poetsgate.com/ViewPoem.aspx?id=200474",""],[5616,"عدنا","https://www.poetsgate.com/ViewPoem.aspx?id=203479",""],[5956,"حكاية شخص فوق الرمال","https://www.poetsgate.com/ViewPoem.aspx?id=182719",""],[6184,"أمام مصحف عثمان في استنبول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78621&r=&rc=13",""],[6259,"صددت إذ عادَ روضُ الرأس ذا زهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59373&r=&rc=21",""]],"verses":[["لَم أُوتَ مِن نُصحٍ وَلا شَفَقٍ","فَالشَرُّ وَالأَعداءُ في قَرَنِ",0,"ن",1,0],["لَمّا وَفى لي مَوعِدي بِالنَوى","مِن غَيرِ ذَنبٍ وَوَفى وَاِعِدي",1,"د",2,0],["لَمّا وَقَفتُ بِبابِهِ","وَفَزِعتُ مِن هِجرانِهِ",2,"ن",2,0],["لَم أوتِ في الحالِ مِن سَعيي لَدَيكَ وَنىً","بَل بِالجُدودِ تَطيرُ الحالُ أَو تَقَعُ",3,"ع",1,0],["لَمّا وَرَدتُ بِوِردِ حَضرَتِكَ المُنى","فَهِقَت لَدَيَّ جِمامُها الأَعدادُ",4,"د",1,0],["لَمّا وَقَفتُ بِها القَلوصَ تَبادَرَت","حَبَبُ الدُموعِ كَأَنَّهُنَّ عَزالي",5,"ل",2,0],["لَمّا وَرَدنا مِنَ الفَيّاضِ مَشرَعَةً","جُزنا بِحَومَةِ بَحرٍ لَم يَكُن ثَمَدا",6,"د",2,0],["لَمّا وَضَعتُ عَلى الفَرَزدَقِ مَيسَمي","وَضَغا البَعيثُ جَدَعتُ أَنفَ الأَخطَلِ",7,"ل",1,0],["لَمّا وَليتَ لِثَغرِ قَومي مَشهَداً","آثَرتُ ذاكَ عَلى بَنِيِّ وَمالي",8,"ل",2,0],["لَم أُؤاخِذكَ بِالجَفاءِ لِأَنّي","واثِقٌ مِنكَ بِالوَفاءِ الصَحيحِ",9,"ح",1,1],["لما وَجَدَتْ وجدي بكم أُمُّ واحدٍ","تَعُوذُ من الأَسْواء فيه بواحدِ",10,"د",1,0],["لِما وَضَعَ الدهرُ من هِمَّتِي","وما رفع اللَّهُ منْ شأْنِكا",11,"ك",2,0],["لَمّا وَلَدَتهُمُ نُسوراً حَلَّقوا","لا يَقنَعونَ مِنَ العُلى بِالدونِ",12,"ن",1,0],["لَمّا وَعى اللَهُ شَكايا الوَرى","قالَ لَهُم كونوا كَما تَشتَهون",13,"ن",1,0],["لَم أُوتَ مِن زَمَني شَيئا أُسِرُّ بِهِ","فلست أَعهَدُ ما كأس وَلا وترُ",14,"ر",1,0],["لَمّا وَقَفتُ بِها القَلوصَ تَبادَرَت","مِنّي الدُموعُ لِفُرقَةِ الأَحبابِ",15,"ب",1,0],["لَمّا وَجَدتَ مُعِدّاتِ البِناءِ بَنَت","يَداكَ لِلقَومِ ما ذَمّوا وَما حَمَدوا",16,"د",3,0],["لَمّا وَزَنتُ بِكَ الدُنيا فَمِلتَ بِها","وَبِالوَرى قَلَّ عِندي كَثرَةُ العَدَدِ",17,"د",1,0],["لَمّا وَجَدتُ دَواءَ دائي عِندَها","هانَت عَلَيَّ صِفاتُ جالينوسا",18,"س",2,0],["لما وجدنا الأمر مختصرا","سهلاً سددنا دونه الطرقا",19,"ق",2,0],["لِما وَصَلَت أَسماءُ مِن حَبلِنا شُكرُ","وَإِن حُمَّ بِالبَينِ الَّذي لَم نُرِد قَدرُ",20,"ر",1,1],["لَم أُوَهَّم نِعمَتي تَغدُرُ بي","غَدرَةً الظِلُّ سَجا ثُمَّ اِنتَقَل",21,"ل",1,0],["لمّا وجدتُ هَواكِ خامَرَني","أيقنتُ أنّ هواك روحاني",22,"ن",2,0],["لَمّا وَرَدنَ حِياضَ سَيبِكَ طُلَّحاً","خَيَّمنَ ثُمَّ شَرِبنَ شُربَ الهيمِ",23,"م",1,0],["لَمّا وَقَفنا نُحَيِّهِم وَقَد صَرَخَت","هَواتِفُ البَينِ فَاِستَولَت بِهِم أُصُلا",24,"ل",2,0],["لَمّا وَقَفنا وَغَيَّبنا رَكائِبَنا","بَدَلنَ بِالعِرفِ بَعدَ الرَجعِ إِنكارا",25,"ر",2,0],["لَمّا وَقَفنا لِلوَداعِ عَشِيَّةً","خَفَقَت لِمَوقِفِنا قُلوبُ الحُسَّدِ",26,"د",1,0],["لَمَأ وَجدُ طَيرِ القَفصِ مُذ بَانَ وَكرُهُ","وَمَن ذَكَرَ الأوطَانَ وَالقَلبُ ذَائِبُ",27,"ب",1,0],["لَمّا وَرَدتُ الطَوِيَّ وَالحَوضُ كَالص","يرَةِ دَفنُ الإِزاءِ مُلتَبِدُه",28,"د",2,0],["لَمّا وَرَدنَ الماءَ خَلَّفنَ الصَدى","وَخَرَجنَ مِن سُقمِ الهَواجِرِ نُقَّها",29,"ه",2,0],["لَمّا وَقَفتُ عَلى الأَطلالِ أَبكاني","ما كانَ أَضحَكَني مِنها وَأَلهاني",30,"ن",2,0],["لَمَّا وَرَدْتُ عَلَى كَرِيمِ جَنَابِهِ","فوَرَدْتُ بَحْرَ الْجُودِ عَذْبَ المَوْرِدِ",31,"د",1,0],["لَمّا وَرَدناها نُلِمُّ بِشَيخِها","عِلجٌ يُحَدِّثُ عَن مَصانِعِ عادِ",32,"د",1,0],["لَمّا وَجَدنا قالَت لِقَينَتِها","قولي رَضينا فَنَم وَلا تَجِدِ",33,"د",1,0],["لما وصلتُ إلى المصيف حملتُها","كالطفلِ نامَ على ذراعِ المرضعِ",34,"ع",1,0],["لما وقفتَ تلفّتَ المحرابُ من","فرحٍ وأنتَ لديه حانٍ مطرقُ",35,"ق",1,0],["لَمَّا وَجَدْنَا قَالَتْ لِقَيْنَتِهَا:","قولي وضينا فنم ولا تجد",36,"د",1,0],["لما وزنت بك الدنيا رجحت بها","وبالورى قل عندي كثرة العدد",37,"د",1,0],["لَمَّا وَرَأَيتُ وَجْهاً أَشْرَقَتْ أَنْوَارُه","فَأضاءَ مثلَ الكوكَبِ المُتَوَقِّد",38,"د",1,0],["لَمَا وَفَيْتُ لِمَا أَوْلَيْتَ مِنْ حَسَنٍ","ولا نَهَضتُ بِمَا حَمَّلتَ مِنْ نِعَمِ",39,"م",1,0],["لَم أُوتَ مِن زَمَني شَيئًا ألذُّ بِهِ","فلستُ أَعهَدُ ما كأسٌ وَلا وتَرُ",40,"ر",1,0],["لَمّا وَقَفْنَا نُحَيّيهِمْ، وَقَدْ شَحَطَتْ","نَعَامَة ُ البَيْنِ، فَکسْتَوْلَتْ بِهِم أُصُلا",41,"ل",2,0],["لما وجدت مكارم الأخلاق","في الدنيا كلام",42,"م",1,1],["لَمَّا وَقَفتُ اُحَيِّيهَا وأندُبُهَا","أجرَى دُمُوعُىَّ جوي تِذكَارُ جِيرَانِ",43,"ن",1,0],["لَمّا وَقَفتُ العيسَ في عَرَصاتِها","ذَهَبَ العَزاءُ وَأَقبَلَت أَجفاني",44,"ن",2,0],["لما وقفتُ مواقِفَ العُشّاقِ","وتعلَّق المشتاقُ بالمشتاقِ",45,"ق",1,1],["لَمّا وَرَدَت فَدَيتُها أَسطُرُكُم","أَرسَلتُ جَوابَها لِكَي أَشكُرُكُم",46,"م",1,1],["لَمّا وَقَفنا لِلوَدا","عِ وَقَد دَعا داعي الرَحيلِ",47,"ل",1,0],["لَمّا وَقَفناهُ نُطارِحُ سُمرَهُ","بَثَّ الجَوى وَتُظِلُّنا سَمُراتُهُ",48,"ت",2,0],["لم أوافقْ فيه صدقاً","كاذبٌ صنفٌ مُريبُ",49,"ب",1,0],["لم أوفِ حقّ عهوده لو أنّني","أفنيت فيه مداركي ومشاعري",50,"ر",2,0],["لمّا وَرَدتُ الماءَ صارَ لهيبا","وبحُبِّها أستَعذِبُ التّعذيبا",51,"ب",2,1],["لَمَّا وَلِيتَ خَلعْت الخَيْرَ أجْمَعهُ","عَلَيْهِمُ فَبَدَوْا فِي أَجْمَلِ الخِلَعِ",52,"ع",1,0],["لم أوفِه حقّاً أَحال به على","قَلبي الكَئيبِ وَمدمعي المدرارِ",53,"ر",1,0],["لَمّا وَرَدتُ وَبابُ القَصرِ مُنطَبِقٌ","لِصَوتِ رَملَةَ هُدَّ القَلبُ فَاِنصَدَعا",54,"ع",2,0],["لَمْ أُوَدِّعْ مَن سَارَ في دَعَةٍ اللَّ","هِ وقَلْبي يَسِيرُ تَحْتَ رِكابِه",55,"ه",1,1],["لمّا وصَلْنا سالمِينَ قضَى","كُلٌّ غداةَ وُصولِه نَذرا",56,"ر",2,0],["لمّا وقعنا في التنازُلِ خَفخَفَت","مثلَ النعام مَخَافةً للأَشقرِ",57,"ر",1,0],["لما واجهت بالبُشرى سواها","وحسبي من فلانٍ أو فلان",58,"ن",1,0],["لما وجدوا لمجدك من قرينٍ","ولا وجدوا شبيهك في قِران",58,"ن",1,0],["لَمّا وَطئت دِمَشقاً بيع ما وطئت","رِجلاك مِنها بِسعر العَنبَر الذَفرِ",59,"ر",1,0],["لما وقفت على منازلها ضحىً","حَيَّيتُها بتحيَّةِ الكرماء",60,"ا",2,0],["لم أَورد الصرم فيكم بعد وصلكم","حتى تفارق روحي عندكم بدني",61,"ن",2,0],["لَمَا وفّتِ الصوارمُ والعوالي","بما جنتِ المحاجرُ والقدودُ",62,"د",1,0],["لَما وَخَدَت شَهراً بِرَحليَ جَسرَةٌ","تَفُلُّ مُتونَ البيدِ بَينَ الرَواحِلِ",63,"ل",1,0],["لمَّا وفَدْتُ على المُخْتارِ أَكرَمَني","وقالَ لي بينَهُمْ بورِكْتَ من رَجُلِ",64,"ل",1,0],["لما وجدت فناءَ داري عاطراً","أيقنتُ أنك قد وطئت ثراه",65,"ا",2,0],["لمّا ولَجْتُ إليهِ خِدراً ضمّ في","جَنَباته صنَماً فُتِنْتُ بوردِهِ",66,"د",2,0],["لما وليت على البحيرة أصبحت","حرماً رخيص الأمن والأسعار",67,"ر",1,0],["لما وصلت قاطعاً","إذا رأى جدي هزل",68,"ل",1,0],["لَمّا وَرَدتُ خِيامَهنّ سَقَيننِي","مِن كُلِّ مَعسولِ الرُّضاب بُرادِ",69,"د",1,0],["لمَّا وَفْدتَ على الدِّيارِ تَعجَّبت","من بعثِ بُولُسَ قبلَ يومِ المَحفَلِ",70,"ل",1,0],["لما وقفنَ العِيسَ في رسمِه","والعينُ من عِرفانِهِ تَدمَعُ",71,"ع",1,0],["لمّا وضعت على قلبي يدي بيدي","وصحتُ في الليلةِ الظلماءِ واكبدي",72,"د",2,1],["لَمّا وقفتُ عليهما يا سيّدي","وقرأتُ بعدَهما النّظامَ المُرتَضَى",73,"ض",2,0],["لمَّا وقفنَا بالثَّنيَّة لم يكنْ","إلاّ وداعُ مسلِّمٍ أو سائرِ",74,"ر",1,0],["لما وفدت على الجواد وجده","في حالة تشجي لها أعدائي",75,"ا",3,1],["لَمّا وَقَفتُ بِقَبره مُتَرَحّماً","بانَ العَزاءُ وَهاجَني اِستعبارُ",76,"ر",1,0],["لما وثقنا بالنبي المجتبي","في نقضه النبويّ أو إبرامه",77,"م",2,0],["لما وفت سلمى بحفظ عهودي","يمّمتُ روض تهائمي ونجودي",78,"د",2,1],["لما وَرَدنَ نَبِيّاً واستتبَّ بها","مُسحَنفِرٌ كخطوطِ السِّيحِ مُنسَحِلُ",79,"ل",1,0],["لَمَّا وَزَنْتُ بِكَ الدُّنْيَا فَمِلْتَ بِهَا","يَا مُنْتَهَى الجُودِ قَدْ حَقَقْتَ آمالِي",80,"ل",2,0],["لمّا وقفتُ الدارَ قلتُ مخاطباً","يا صاحبيَّ قِفا بِعرصتها قفا",81,"ف",2,0],["لما وردت بهديكم","بين الورى الورد المعينا",82,"ن",2,0],["لما وَجَدتُ نَديماً لا يُخالِفني","صيّرتُ نَفسي له عَبدا بِلا ثَمَن",83,"ن",1,1],["لما وقفت بقربه لسلامه","جادت دموعي واكف العبرات",84,"ت",1,0],["لما وَفنا بها تُسائِلُها","فاضَت من القوم أعينٌ سُجُمُ",85,"م",1,0],["لمَّا وجدْتُ لنَبْهانٍ مآثرَ قد","أُطْري بها شعرآء الأَمَّة العَرَبا",86,"ب",2,0],["لَمّا وَقَفتَ بِهِنَّ بَعدَ تَأنّسٍ","ذَرَفَت دُموعُكَ في الرِداءِ رَشاشا",87,"ش",2,0],["لمّا وَثِقتُ وَخُنتَني","فاظَت لِذاكَ النَّفسُ فَيظا",88,"ظ",2,1