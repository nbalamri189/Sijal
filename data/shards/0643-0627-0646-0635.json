y.dctabudhabi.ae/diwan/poem/91661","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59481","الطويل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32415","المنسرح"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199065","الطويل"],[4888,"لذة","https://www.poetsgate.com/ViewPoem.aspx?id=207678",""],[4897,"أظن الدهر قد آلى فبرا","https://www.poetsgate.com/ViewPoem.aspx?id=98898",""],[4981,"نداءٌ من لغتنا","https://www.poetsgate.com/ViewPoem.aspx?id=190503",""],[5038,"إبتعدي","https://www.poetsgate.com/ViewPoem.aspx?id=196694",""],[5136,"هاج اشتياقي إلى من لا أسميها","https://www.poetsgate.com/ViewPoem.aspx?id=121942",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5213,"إلية بأبي العباس ما خطرت","https://www.poetsgate.com/ViewPoem.aspx?id=170554",""],[5213,"سأركبها مسومة عرابا","https://www.poetsgate.com/ViewPoem.aspx?id=170413",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5425,"بَغداد .. حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=199911",""],[5431,"مات طفلي...","https://www.poetsgate.com/ViewPoem.aspx?id=202275",""],[5725,"وليل يكيل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=179909",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5910,"في وصفِ يومٍ حارٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=206236",""],[6122,"انْظُر إِلَى النبق فِي الأغصان منتظماً","https://www.poetsgate.com/ViewPoem.aspx?id=189292",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[463,"عجبتُ لمرّ النفسِ كيف يضامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60327&r=&rc=383",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""],[6270,"كأنما شمْعة الرقرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69083&r=&rc=7",""]],"verses":[["كَأَنَّ صَليلَ المَروِ حينَ تُشِذُّهُ","صَليلِ زُيوفٍ يُنتَقَدنَ بِعَبقَرا",0,"ر",2,0],["كَأَنَّ صَبيبَ غادِيَةٍ بِلَصبٍ","تُشَجُّ بِهِ شَآمِيَةٌ شَمولُ",1,"ل",1,0],["كَأَنَّ صِياحَ الكُدرِ يَنظُرنَ عَقبَنا","تَراطُنُ أَنباطٍ عَلَيهِ قِيامِ",2,"م",1,0],["كأنَّ صِلات البرِّ عند نوالهِ","صَلاةٌ يوفي نقصها وخدَاجها",3,"ج",3,0],["كأنَّ صرعى وحشها كفار","الموت عقبى أمرها والنار",4,"ر",1,0],["كأن صباحاً واضحاً في قِناعها","أناخَ عليه جُنْحُ ليلٍ مُغالثُ",5,"ث",1,0],["كأن صاحبه فرعون برهته","موكلا بنى اسرائيل يؤذيها",6,"ي",3,0],["كَأَنَّ صَهيلَ الخَيلِ ناعٍ مُبَشِّرٌ","تَراهُنَّ فيها ضُحَّكاً وَهيَ نُحَّبُ",7,"ب",1,0],["كَأَنَّ صُدورَ الخَيلِ غُدرٌ عَلى الدُجى","كَأَنَّ بَقايا النَضحِ فيهِنَّ طُحلُبُ",7,"ب",1,0],["كانَ صَديقاً فَصارَ مَعرِفَةً","بَعدُ كَذاكَ القُلوبُ تَنقَلِبُ",8,"ب",1,0],["كَأَنَّ صَفيحَ الهِندِ فَوقَ رُؤوسِهِم","مَصابيحُ لَيلٍ لا يُبالينَ مِغفَرا",9,"ر",2,0],["كأنَّ صنوفَ الطَّيرِ عاذَتْ بأرضِها","وقد سامَها ضَيْماً أُسُودُ سمائِها",10,"ا",3,0],["كأنَّ صوارِمَه في العَجاجِ","بوارِقُ تَصْدعٌ حُجْبَ العَماءِ",11,"ا",2,0],["كَأَنَّ صَريفَ نابَيهِ إِذا ما","أَمَرَّهُما تَرَنُّمُ أَخطَبانِ",12,"ن",1,0],["كأن صدر الظلام ضاق","من كَثرةِ البثِّ كل حين",13,"ن",1,0],["كأن صحاف الدار في عين صاحبي","غوان كستهن المحاسن مطرفا",14,"ف",2,0],["كأنّ صفَاءَ الجوّ يوْمَ عَطائِهِ","مشوبٌ بشؤبوب الغمام المديّمِ",15,"م",1,0],["كأنّ صَبَاها للعرانين فَتّقَتْ","نداها بندٍّ فهي طيِّبةُ النفح",16,"ح",1,0],["كأنّ صلالاً وسطها في مكامنٍ","تحركُ فيها ألسناً بلجاج",17,"ج",1,0],["كَأَنَّ صَوتَ النَعامِ فيهِ","إِذا دَعا صَوتُ مُستَغيثِ",18,"ث",1,0],["كأنّ صُفوفَ القومِ في جَنَباتِها","إذا جدَّتِ الهيجا صَفيفُ شُواءِ",19,"ا",2,0],["كَأَنَّ صارِمَهُ في كلِّ مُعْتَرَكٍ","نَذِيرُ مَوْتٍ خَلَتْ مِنْ قَبْلِهِ النُّذُرُ",20,"ر",1,0],["كأنّ صِعابَ البُختِ إذ ذُلِّلَتْ لهُ","أُسارى مُلوكٍ عضَّها القِدُّ ضُرَّع",21,"ع",1,0],["كَأَنَّ صُغرى وَكُبرى مِن فَواقِعِها","حَصباءُ دُرَّ عَلى أَرضٍ مِنَ الذَهَبِ",22,"ب",1,0],["كَأَنَّ صَفاءَ الدَمعِ في ساحِ خَدِّهِ","حَكى الدُرَّ مَنثوراً عَلى وَرَقٍ نَضرِ",23,"ر",1,1],["كَأَنَّ صُدغَيهِ في سَوادِهِما","خُطّا عَلى عارِضَينِ بِالقَلَمِ",24,"م",1,0],["كَأَنَّ صاعِقَةً في جَوفِ بارِقَةٍ","زَئيرُهُ واغِلاً في أُذنِ نابِحِها",25,"ح",3,0],["كَأَنَّ صَوَاهِلَ ذِبَّانِهِ","قُبَيْلَ الصَّبَاحِ صَهِيلُ الحُصُنْ",26,"ن",1,0],["كأَنَّ صَرِيعَ الأَثْلِ والطَّلْحِ وَسْطَهُ","بَخَاتِيُّ جُونٌ سَاقَهَا مُتَرِّبحُ",27,"ح",1,0],["كَأَنَّ صَبِيراً فَوْقَهُمْ مِنْ غَمَامَةٍ","إِذَا جَانِبٌ مِنْهَا تَهَلّلَ أَبْرَدَا",28,"د",2,0],["كأنّ صَبيّ البيضِ إنْ شاء مَسَّها","صَبيُّ أُناسٍ عَضّهُ الفَقْرُ بائِس",29,"س",1,0],["كَأَنَّ صِحَافَ الزَّهْرِ وَالطَّلُّ ذائِبٌ","عُيُونٌ يَسِيلُ الدَّمْعُ مِنْهَا وَتَشْخَصُ",30,"ص",1,0],["كَأَنَّ صِحَافَ النُّورِ والطَّلُّ جَامِدٌ","مَبَاسِمُ أَصْدَافٍ تَبَسَّمْنَ عَنْ دُرِّ",31,"ر",1,0],["كَانَ صَمْصَامَهَا إِذَا الْتُمِسَ الرَّأْ","يُ وَأَعْيَا مِنْ دُونِهِ الصَّمْصَامُ",32,"م",1,0],["كَانَ صَدْرُ النَّدِيِّ يَهْتَزُّ تِيهاً","حِينَ تَحْتَلُّهُ وَيَزْهُو رُوَاءَ",33,"ا",2,0],["كانَ صَبوحي فَكَيفَ أَصبَحَ جَذ","لانَ وَأَنسى فَكَيفَ أَنساهُ",34,"ا",2,0],["كَانَ صَبّاً بِمِصْرَ كَمْ هَامَ شَوْقاً","بِرُبَاهَا وَبَثَّهَا أَحْزانَهْ",35,"ن",2,0],["كان صوتاً عربياً خالصاً","يسلك البيد ويستّن الرعانا",36,"ن",2,0],["كأَن صدورَ الناس حين توهَّجت","أَضاءت بها أنوارُه ومنائره",37,"ر",2,0],["كان صليب العود في دنه","وكان في آرائه أصلبا",38,"ب",2,0],["كأنَّ صَريعَ الأَثْلِ والطَّلْحِ وَسْطَهُ","بَخاتِيُّ جُونٌ ساقَها مُتَرَيِّحُ",39,"ح",1,0],["كان صبح الخميس أو ظهر جمعه","أذهلني عني عن الوقت لوعه",40,"ع",2,1],["كَأنّ صَلِيلَ المَرْوِ حِينَ تُشِذُّهُ","صليل زيوفٍ ينقدنَ بعبقرا",41,"ر",2,0],["كانَ صُبحاً مِن كُل لَيلة عيدٍ","كانَ شَمساً بِزول مِنهُ الظَلام",42,"م",1,0],["كَأَنَّ صُهالَ الخَيلِ في حجَراتِهِ","وَمَعمَعَةَ الأَبطالِ مَعرَكَة الحَربِ",43,"ب",1,0],["كانَ صَرفُ الزَمانِ صَعباً وَلَكِن","صارَ لَمّا حَكَمتَ فيهِ ذَلولا",44,"ل",2,0],["كانَ صدّيقهُ الكبيرُ أبو بك","رٍ رفيقاً إذ عزّت الرفقاءُ",45,"ا",2,0],["كأنَّ صفاءَ الرحي","قِ نافسهُ الكوثرُ",46,"ر",1,0],["كأنَّ صباحاً طالعاً من جبينه","أناخ عليه اللَّيلُ بالحالك الوَحفِ",47,"ف",1,0],["كَأَنَّ صَموتاً صافَتَ النَحلُ حَولَها","تَناوَلَها مِن رَأسِ رَهوَةَ شائِرُ",48,"ر",1,1],["كان صدري فداك من هول ليل","خشيت هوله رواسي الجبال",49,"ل",1,0],["كان صدري به كأيام صدرِ الدين","لا تَهتدي إليه الهمومُ",50,"م",1,0],["كأن صبا نجد سقتها مدامة","عبيرية تهدي لمن لم يجدو جدا",51,"د",2,0],["كَأَنَّ صُروفَ الدَّهْرِ لَيْسَ يَعُدُّهَا","صُرُوفاً إِذَا مَكْرُوهُهُنَّ عَدَانِي",52,"ن",2,0],["كأَنَّ صغارَ الشُهب في غَسَق الدُجى","فِراخُ نُسورٍ والبُروج مَفارِخُ",53,"خ",1,0],["كأَنَّ صدرها فدته نفسي","لجةُ ماءِ في شعاع الشمسِ",54,"س",1,0],["كَأنّ صفات الفضلِ أَضحَت لِشخصهِ","مَرايا بَدَت فيهنّ طَلعَته الغرّا",55,"ر",2,0],["كَأَنَّ صِبَايَ قَدْ رُدَّتْ رُؤاهُ","عَلَى جَفْنِي المُسَهَّدِ أَوْ كَأَنِّي",56,"ن",2,0],["كأن صياغاً صاغ فوق غصونها","من الذهب الناري عراجين من تمرِ",57,"ر",1,0],["كأن صباحاً غارَ ليلةَ زارني","فَفاجَأني من وَجههِ مُتفجِّرا",58,"ر",2,0],["كأن صرمُ بغلٍ حين سَكْرَجَهُ","بعدَ البرازِ وباقي الرَّوثِ في وَسَطه",59,"ط",2,0],["كأَنَّ صِلاتَهُ لَهُمُ صَلاة","فَلَيسَ تَتِمُّ إِلّا أَن يوالي",60,"ل",2,0],["كانَ صَحبي بها وكنَّا جميعاً","نُشْبِهُ العِقْد بهجةً وانتظاما",61,"ا",1,0],["كأَنَّ صورته للعينِ إذ جُلِيَتْ","من فضةٍ قُدِّرت بالحسن تقديرا",62,"ر",2,0],["كان صديقي في ساعات الليل الأولى","يتجول في بلدتهِ",63,"ه",1,0],["كأن صفاءَ الماء ينفرج القَذَى","بها عنهُ وجهٌ عُطّ عنه لثامُ",64,"م",1,0],["كأنَّ صميمَ العزِّ في كلِّ هجمةٍ","على الموتِ مابينَ الحُماةِ المصاعبِ",65,"ب",1,0],["كأن صدري من ضيق ومن حرج","للوافدين إلى أبوابه سبل",66,"ل",1,0],["كأن صالحهم يوماً وعاذلهم","في صدر ذا الدست لم يقعد ولم يقم",67,"م",1,0],["كَأَنَّ صيرانَ المَها الأَخلاطِ","بِالرَملِ أُحبوشٌ مِنَ الأَنباطِ",68,"ط",1,0],["كان صورتها في الوصف إِذ وصفت","دينار عين من المصرية العتقِ",69,"ق",1,1],["كانّ صُبحي يخشى أن يُؤنبَهُ","أهلُ الهوى فاختفى بالليلِ وانتَقَبا",70,"ب",2,0],["كُأَنَّ صُدغاً لَهُ تَراهُ","وَهوَ عَلى خَدِّهِ مُدارُ",71,"ر",1,0],["كأن صفيره نغم المغني","لركبك والدخان له عبير",72,"ر",1,0],["كأنَّ صوتَ غَلْيها","غطيطُ مجنونٍ يَغطّ",73,"ط",1,0],["كأنَّ صُغْرَى وكُبْرى مِنْ فَواقِعِهِ","حَصْباءُ دُرٍّ على أرْضٍ منَ الذّهَبِ",74,"ب",1,0],["كأن صوتك طير الجنة انبعثت","منه الأغاريد فالأنغام ألوان",75,"ن",1,0],["كَانَ صَدِيقاً وافِراً وُدُّهُ","صَدَاقَةَ الأَنْفُسِ والجِنْسِ",76,"س",1,0],["كانَ صَديق زَوجها فَزاره","فَأبصَرته فاشتهت جواره",77,"ه",1,0],["كأنّ صلاح الدين علّم ناظرى","نَداهُ فغيثُ الدَّمع منه هَمولُ",78,"ل",1,0],["كأنَّ صُراخَ المُستَغيثِ سحيلُهُ","بكُلِّ صباحٍ غيرَ أن كان أعجَما",79,"م",2,0],["كأنصاف البرى وتدق عنها","شواها دقة تسع الخلالا",80,"ل",2,0],["كان صلبُ المسيح من قوم موسى","ليس إلا ضرباً من الهذيانِ",81,"ن",1,0],["كان صنانه المنباع نقس","تحدر من جوانب قمقمين",82,"ن",1,0],["كأن صليل البيض تنغيم شادنٍ","بذكر سعادٍ أو بثينة ناشدا",83,"د",2,0],["كأن صدور المسلمين مراجلٌ","غَلت فوق نارٍ لا تضيء لقابس",84,"س",1,0],["كَأَن صادَفوا دوني بِهِ لَحماً","ضافَ الرِتاجَةَ في رَحلِ تَباذيرِ",85,"ر",1,1],["كَأَنَّ صَوتَ حُداها وَالقَرينُ بِهِ","تَرجيعُ مُغتَرِبٍ نَشوانَ لَجلاجِ",86,"ج",1,0],["كان صليل المرهفات لسمعه","غوان تغني بالصبا وتشبب",87,"ب",1,0],["كان صدور البيض من ضربها الطلي","اخو صبوة مضنى الفؤاد معذب",87,"ب",1,0],["كأن صنعاء في أرجائها نشرت","برودها فاكتسى بالوشي عاريها",88,"ي",3,0],["كأنّ صغرى وكبرى من فقاقعها","حصباءُ درَّ على أرضٍ من الذهب",89,"ب",1,0],["كأن صفوف الئوس فوق صحيفة","حروف سطور تدهش المتأملا",90,"ل",2,0],["كأن صريراً في شباة يراعه","على الطرس من بيض السيوف صليل",91,"ل",1,0],["كان صبحاً شمسه طلعت","عاد جنحاً غائباً قمره",92,"ر",2,0],["كَأَنَّ صَوتَ رَسولِ اللَهِ ناداها","تَحِنُّ وَجداً لِمَغنى طَيبَةٍ وَبِها",93,"ه",2,0],["كان صبغ الدجى عليك ولما","لحت للشمس باخ عنك دهانُك",94,"ك",1,0],["كأن صمغتها الحمرا بقشرتها الدكنا","ء قرصٌ على أعكان سمراء",95,"ا",2,0],["كأن صارخُ البارُود منها وبيضهُ","رُجومٌ هوت إثر الصّواعق بالأرزا",96,"ز",2,0],["كأن صحيفة الدستور روض","بهيج الزهر ذوا ارج وطيب",97,"ب",1,0],["كأن صوت الذي تلقيه من فمها","رعد له بين أحشاء الدجى صخب",98,"ب",1,0],["كأن صبغ الدجى حبات أفئدة","ذابت لفقدك أو أحداق أبصار",99,"ر",1,0],["كان صبحاً عليه ليلٌ بهيمٌ","فمحوا ليلهُ وأبقوه صبحا",100,"ح",2,0],["كأَنَّ صياحَ مُلحَمَينِ تَقَلَّبا","بِصَيدَينِ فانقَضّا صِياحُ شَباهُما",101,"م",2,0],["