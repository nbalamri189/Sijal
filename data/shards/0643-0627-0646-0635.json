{"poems":[[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[35,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[72,"بروضة حسن والعذار سياجها","https://www.aldiwan.net/poem18452.html","الطويل"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"لها ناظر بالسحر في القلب نافث","https://www.aldiwan.net/poem9234.html","الطويل"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[28,"محارم للإسلام كنت انتهكتها","https://www.aldiwan.net/poem5108.html","الطويل"],[61,"أحذركم أمواج دجلة إذ غدت","https://www.aldiwan.net/poem51826.html","الطويل"],[61,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[80,"وما روضة حي ثرى أقحوانها","https://www.aldiwan.net/poem31526.html","الطويل"],[80,"ومشبهة في الجو أنوار أختها","https://www.aldiwan.net/poem31528.html","الطويل"],[44,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[105,"خذوني إلى دار النيابة واسألوا","https://www.aldiwan.net/poem42140.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[48,"ساع بكأس إلى ناش على طربي","https://www.aldiwan.net/poem10771.html","البسيط"],[48,"كأن صفاء الدمع في ساح خده","https://www.aldiwan.net/poem63330.html","الطويل"],[48,"لا تبك ربعا عفا بذي سلم","https://www.aldiwan.net/poem65107.html","المنسرح"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[100,"شاعر .. ووطنه في الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67707&r=&rc=194",""],[0,"سما لكَ شوقٌ بعدما كان أقصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14327&r=&rc=3",""],[109,"عصرت ماء حسنه الأيام","https://www.aldiwan.net/poem16520.html","الخفيف"],[134,"ألا أبلغا عني على ذات بيننا","https://www.aldiwan.net/poem20991.html","الطويل"],[143,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"رحيق كماء الشباب","https://www.aldiwan.net/poem45360.html","مجزوء المتقارب"],[204,"بديع ملاحات بمقلته حتفي","https://www.aldiwan.net/poem53233.html","الطويل"],[207,"كأن صموتا صافت النحل حولها","https://www.aldiwan.net/poem27956.html","الطويل"],[211,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[250,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[271,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[280,"لك الخير قد أنحى علي زماني","https://www.aldiwan.net/poem60787.html","الطويل"],[297,"أحباي أما الود مني فراسخ","https://www.aldiwan.net/poem33295.html","الطويل"],[298,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[305,"أمولاي والآمال تستعبد الحرا","https://www.aldiwan.net/poem56546.html","الكامل"],[308,"ثورة الشك","https://www.aldiwan.net/poem63238.html","عموديه"],[351,"وأعرافه الشم التي لاح دونها","https://www.aldiwan.net/poem68981.html","الطويل"],[371,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[377,"يا هاجي الورد قد أسرفت مفتريا","https://www.aldiwan.net/poem59352.html","البسيط"],[406,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[416,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[416,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[422,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[458,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[477,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[515,"ليت النسيم إذا حملت عاتقه","https://www.aldiwan.net/poem12238.html","البسيط"],[515,"صحت بدولتك الأيام من سقم","https://www.aldiwan.net/poem12269.html","البسيط"],[561,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[569,"كان صورتها في الوصف إِذ وصفت","https://www.aldiwan.net/poem52000.html","البسيط"]],"verses":[["كَأَنَّ صَليلَ المَروِ حينَ تُشِذُّهُ","صَليلِ زُيوفٍ يُنتَقَدنَ بِعَبقَرا",0,"ر",2,0],["كَأَنَّ صَبيبَ غادِيَةٍ بِلَصبٍ","تُشَجُّ بِهِ شَآمِيَةٌ شَمولُ",1,"ل",1,0],["كَأَنَّ صِياحَ الكُدرِ يَنظُرنَ عَقبَنا","تَراطُنُ أَنباطٍ عَلَيهِ قِيامِ",2,"م",1,0],["كأنَّ صِلات البرِّ عند نوالهِ","صَلاةٌ يوفي نقصها وخدَاجها",3,"ج",3,0],["كأنَّ صرعى وحشها كفار","الموت عقبى أمرها والنار",4,"ر",1,0],["كأن صباحاً واضحاً في قِناعها","أناخَ عليه جُنْحُ ليلٍ مُغالثُ",5,"ث",1,0],["كأن صاحبه فرعون برهته","موكلا بنى اسرائيل يؤذيها",6,"ي",3,0],["كَأَنَّ صَهيلَ الخَيلِ ناعٍ مُبَشِّرٌ","تَراهُنَّ فيها ضُحَّكاً وَهيَ نُحَّبُ",7,"ب",1,0],["كَأَنَّ صُدورَ الخَيلِ غُدرٌ عَلى الدُجى","كَأَنَّ بَقايا النَضحِ فيهِنَّ طُحلُبُ",7,"ب",1,0],["كانَ صَديقاً فَصارَ مَعرِفَةً","بَعدُ كَذاكَ القُلوبُ تَنقَلِبُ",8,"ب",1,0],["كَأَنَّ صَفيحَ الهِندِ فَوقَ رُؤوسِهِم","مَصابيحُ لَيلٍ لا يُبالينَ مِغفَرا",9,"ر",2,0],["كأنَّ صنوفَ الطَّيرِ عاذَتْ بأرضِها","وقد سامَها ضَيْماً أُسُودُ سمائِها",10,"ا",3,0],["كأنَّ صوارِمَه في العَجاجِ","بوارِقُ تَصْدعٌ حُجْبَ العَماءِ",11,"ا",2,0],["كَأَنَّ صَريفَ نابَيهِ إِذا ما","أَمَرَّهُما تَرَنُّمُ أَخطَبانِ",12,"ن",1,0],["كأن صدر الظلام ضاق","من كَثرةِ البثِّ كل حين",13,"ن",1,0],["كأن صحاف الدار في عين صاحبي","غوان كستهن المحاسن مطرفا",14,"ف",2,0],["كأنّ صفَاءَ الجوّ يوْمَ عَطائِهِ","مشوبٌ بشؤبوب الغمام المديّمِ",15,"م",1,0],["كأنّ صَبَاها للعرانين فَتّقَتْ","نداها بندٍّ فهي طيِّبةُ النفح",16,"ح",1,0],["كأنّ صلالاً وسطها في مكامنٍ","تحركُ فيها ألسناً بلجاج",17,"ج",1,0],["كَأَنَّ صَوتَ النَعامِ فيهِ","إِذا دَعا صَوتُ مُستَغيثِ",18,"ث",1,0],["كأنّ صُفوفَ القومِ في جَنَباتِها","إذا جدَّتِ الهيجا صَفيفُ شُواءِ",19,"ا",2,0],["كَأَنَّ صارِمَهُ في كلِّ مُعْتَرَكٍ","نَذِيرُ مَوْتٍ خَلَتْ مِنْ قَبْلِهِ النُّذُرُ",20,"ر",1,0],["كأنّ صِعابَ البُختِ إذ ذُلِّلَتْ لهُ","أُسارى مُلوكٍ عضَّها القِدُّ ضُرَّع",21,"ع",1,0],["كَأَنَّ صُغرى وَكُبرى مِن فَواقِعِها","حَصباءُ دُرَّ عَلى أَرضٍ مِنَ الذَهَبِ",22,"ب",1,0],["كَأَنَّ صَفاءَ الدَمعِ في ساحِ خَدِّهِ","حَكى الدُرَّ مَنثوراً عَلى وَرَقٍ نَضرِ",23,"ر",1,1],["كَأَنَّ صُدغَيهِ في سَوادِهِما","خُطّا عَلى عارِضَينِ بِالقَلَمِ",24,"م",1,0],["كَأَنَّ صاعِقَةً في جَوفِ بارِقَةٍ","زَئيرُهُ واغِلاً في أُذنِ نابِحِها",25,"ح",3,0],["كأنّ صَبيّ البيضِ إنْ شاء مَسَّها","صَبيُّ أُناسٍ عَضّهُ الفَقْرُ بائِس",26,"س",1,0],["كَأَنَّ صِحَافَ الزَّهْرِ وَالطَّلُّ ذائِبٌ","عُيُونٌ يَسِيلُ الدَّمْعُ مِنْهَا وَتَشْخَصُ",27,"ص",1,0],["كَأَنَّ صِحَافَ النُّورِ والطَّلُّ جَامِدٌ","مَبَاسِمُ أَصْدَافٍ تَبَسَّمْنَ عَنْ دُرِّ",28,"ر",1,0],["كَانَ صَمْصَامَهَا إِذَا الْتُمِسَ الرَّأْ","يُ وَأَعْيَا مِنْ دُونِهِ الصَّمْصَامُ",29,"م",1,0],["كَانَ صَدْرُ النَّدِيِّ يَهْتَزُّ تِيهاً","حِينَ تَحْتَلُّهُ وَيَزْهُو رُوَاءَ",30,"ا",2,0],["كانَ صَبوحي فَكَيفَ أَصبَحَ جَذ","لانَ وَأَنسى فَكَيفَ أَنساهُ",31,"ا",2,0],["كَانَ صَبّاً بِمِصْرَ كَمْ هَامَ شَوْقاً","بِرُبَاهَا وَبَثَّهَا أَحْزانَهْ",32,"ن",2,0],["كان صوتاً عربياً خالصاً","يسلك البيد ويستّن الرعانا",33,"ن",2,0],["كأَن صدورَ الناس حين توهَّجت","أَضاءت بها أنوارُه ومنائره",34,"ر",2,0],["كان صليب العود في دنه","وكان في آرائه أصلبا",35,"ب",2,0],["كان صبح الخميس أو ظهر جمعه","أذهلني عني عن الوقت لوعه",36,"ع",2,1],["كَأنّ صَلِيلَ المَرْوِ حِينَ تُشِذُّهُ","صليل زيوفٍ ينقدنَ بعبقرا",37,"ر",2,0],["كانَ صُبحاً مِن كُل لَيلة عيدٍ","كانَ شَمساً بِزول مِنهُ الظَلام",38,"م",1,0],["كَأَنَّ صُهالَ الخَيلِ في حجَراتِهِ","وَمَعمَعَةَ الأَبطالِ مَعرَكَة الحَربِ",39,"ب",1,0],["كانَ صَرفُ الزَمانِ صَعباً وَلَكِن","صارَ لَمّا حَكَمتَ فيهِ ذَلولا",40,"ل",2,0],["كانَ صدّيقهُ الكبيرُ أبو بك","رٍ رفيقاً إذ عزّت الرفقاءُ",41,"ا",2,0],["كأنَّ صفاءَ الرحي","قِ نافسهُ الكوثرُ",42,"ر",1,0],["كأنَّ صباحاً طالعاً من جبينه","أناخ عليه اللَّيلُ بالحالك الوَحفِ",43,"ف",1,0],["كَأَنَّ صَموتاً صافَتَ النَحلُ حَولَها","تَناوَلَها مِن رَأسِ رَهوَةَ شائِرُ",44,"ر",1,1],["كان صدري فداك من هول ليل","خشيت هوله رواسي الجبال",45,"ل",1,0],["كان صدري به كأيام صدرِ الدين","لا تَهتدي إليه الهمومُ",46,"م",1,0],["كأن صبا نجد سقتها مدامة","عبيرية تهدي لمن لم يجدو جدا",47,"د",2,0],["كَأَنَّ صُروفَ الدَّهْرِ لَيْسَ يَعُدُّهَا","صُرُوفاً إِذَا مَكْرُوهُهُنَّ عَدَانِي",48,"ي",1,0],["كأَنَّ صغارَ الشُهب في غَسَق الدُجى","فِراخُ نُسورٍ والبُروج مَفارِخُ",49,"خ",1,0],["كأَنَّ صدرها فدته نفسي","لجةُ ماءِ في شعاع الشمسِ",50,"س",1,0],["كَأنّ صفات الفضلِ أَضحَت لِشخصهِ","مَرايا بَدَت فيهنّ طَلعَته الغرّا",51,"ر",2,0],["كَأَنَّ صِبَايَ قَدْ رُدَّتْ رُؤاهُ","عَلَى جَفْنِي المُسَهَّدِ أَوْ كَأَنِّي",52,"ن",2,0],["كأن صياغاً صاغ فوق غصونها","من الذهب الناري عراجين من تمرِ",53,"ر",1,0],["كأن صباحاً غارَ ليلةَ زارني","فَفاجَأني من وَجههِ مُتفجِّرا",54,"ر",2,0],["كأن صرمُ بغلٍ حين سَكْرَجَهُ","بعدَ البرازِ وباقي الرَّوثِ في وَسَطه",55,"ط",2,0],["كأَنَّ صِلاتَهُ لَهُمُ صَلاة","فَلَيسَ تَتِمُّ إِلّا أَن يوالي",56,"ي",1,0],["كانَ صَحبي بها وكنَّا جميعاً","نُشْبِهُ العِقْد بهجةً وانتظاما",57,"ا",1,0],["كأَنَّ صورته للعينِ إذ جُلِيَتْ","من فضةٍ قُدِّرت بالحسن تقديرا",58,"ر",2,0],["كان صديقي في ساعات الليل الأولى","يتجول في بلدتهِ",59,"ه",1,0],["كأن صفاءَ الماء ينفرج القَذَى","بها عنهُ وجهٌ عُطّ عنه لثامُ",60,"م",1,0],["كأنَّ صميمَ العزِّ في كلِّ هجمةٍ","على الموتِ مابينَ الحُماةِ المصاعبِ",61,"ب",1,0],["كأن صدري من ضيق ومن حرج","للوافدين إلى أبوابه سبل",62,"ل",1,0],["كأن صالحهم يوماً وعاذلهم","في صدر ذا الدست لم يقعد ولم يقم",63,"م",1,0],["كَأَنَّ صيرانَ المَها الأَخلاطِ","بِالرَملِ أُحبوشٌ مِنَ الأَنباطِ",64,"ط",1,0],["كان صورتها في الوصف إِذ وصفت","دينار عين من المصرية العتقِ",65,"ق",1,1]]}