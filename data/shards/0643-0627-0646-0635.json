{"poems":[[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[74,"بروضة حسن والعذار سياجها","https://www.aldiwan.net/poem18452.html","الطويل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"لها ناظر بالسحر في القلب نافث","https://www.aldiwan.net/poem9234.html","الطويل"],[87,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[47,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[30,"محارم للإسلام كنت انتهكتها","https://www.aldiwan.net/poem5108.html","الطويل"],[63,"أحذركم أمواج دجلة إذ غدت","https://www.aldiwan.net/poem51826.html","الطويل"],[63,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[99,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[82,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[82,"وما روضة حي ثرى أقحوانها","https://www.aldiwan.net/poem31526.html","الطويل"],[82,"ومشبهة في الجو أنوار أختها","https://www.aldiwan.net/poem31528.html","الطويل"],[46,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[107,"خذوني إلى دار النيابة واسألوا","https://www.aldiwan.net/poem42140.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[50,"ساع بكأس إلى ناش على طربي","https://www.aldiwan.net/poem10771.html","البسيط"],[50,"كأن صفاء الدمع في ساح خده","https://www.aldiwan.net/poem63330.html","الطويل"],[50,"لا تبك ربعا عفا بذي سلم","https://www.aldiwan.net/poem65107.html","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62208","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62209","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[108,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[92,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[27,"هَلِ القَلْبُ عَنْ دَهْمَاءَ سَالٍ فَمُسْمِحُ","https://www.poetsgate.com/ViewPoem.aspx?id=18350",""],[102,"شاعر .. ووطنه في الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67707&r=&rc=194",""],[0,"سما لكَ شوقٌ بعدما كان أقصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14327&r=&rc=3",""],[112,"عصرت ماء حسنه الأيام","https://www.aldiwan.net/poem16520.html","الخفيف"],[137,"ألا أبلغا عني على ذات بيننا","https://www.aldiwan.net/poem20991.html","الطويل"],[146,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[192,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[202,"رحيق كماء الشباب","https://www.aldiwan.net/poem45360.html","مجزوء المتقارب"],[207,"بديع ملاحات بمقلته حتفي","https://www.aldiwan.net/poem53233.html","الطويل"],[210,"كأن صموتا صافت النحل حولها","https://www.aldiwan.net/poem27956.html","الطويل"],[214,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[253,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[274,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[283,"لك الخير قد أنحى علي زماني","https://www.aldiwan.net/poem60787.html","الطويل"],[300,"أحباي أما الود مني فراسخ","https://www.aldiwan.net/poem33295.html","الطويل"],[301,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[308,"أمولاي والآمال تستعبد الحرا","https://www.aldiwan.net/poem56546.html","الكامل"],[311,"ثورة الشك","https://www.aldiwan.net/poem63238.html","عموديه"],[354,"وأعرافه الشم التي لاح دونها","https://www.aldiwan.net/poem68981.html","الطويل"],[374,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[380,"يا هاجي الورد قد أسرفت مفتريا","https://www.aldiwan.net/poem59352.html","البسيط"],[409,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[419,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[419,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[425,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[460,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[479,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[517,"ليت النسيم إذا حملت عاتقه","https://www.aldiwan.net/poem12238.html","البسيط"],[517,"صحت بدولتك الأيام من سقم","https://www.aldiwan.net/poem12269.html","البسيط"],[563,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[571,"كان صورتها في الوصف إِذ وصفت","https://www.aldiwan.net/poem52000.html","البسيط"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/20560","الطويل"]],"verses":[["كَأَنَّ صَليلَ المَروِ حينَ تُشِذُّهُ","صَليلِ زُيوفٍ يُنتَقَدنَ بِعَبقَرا",0,"ر",2,0],["كَأَنَّ صَبيبَ غادِيَةٍ بِلَصبٍ","تُشَجُّ بِهِ شَآمِيَةٌ شَمولُ",1,"ل",1,0],["كَأَنَّ صِياحَ الكُدرِ يَنظُرنَ عَقبَنا","تَراطُنُ أَنباطٍ عَلَيهِ قِيامِ",2,"م",1,0],["كأنَّ صِلات البرِّ عند نوالهِ","صَلاةٌ يوفي نقصها وخدَاجها",3,"ج",3,0],["كأنَّ صرعى وحشها كفار","الموت عقبى أمرها والنار",4,"ر",1,0],["كأن صباحاً واضحاً في قِناعها","أناخَ عليه جُنْحُ ليلٍ مُغالثُ",5,"ث",1,0],["كأن صاحبه فرعون برهته","موكلا بنى اسرائيل يؤذيها",6,"ي",3,0],["كَأَنَّ صَهيلَ الخَيلِ ناعٍ مُبَشِّرٌ","تَراهُنَّ فيها ضُحَّكاً وَهيَ نُحَّبُ",7,"ب",1,0],["كَأَنَّ صُدورَ الخَيلِ غُدرٌ عَلى الدُجى","كَأَنَّ بَقايا النَضحِ فيهِنَّ طُحلُبُ",7,"ب",1,0],["كانَ صَديقاً فَصارَ مَعرِفَةً","بَعدُ كَذاكَ القُلوبُ تَنقَلِبُ",8,"ب",1,0],["كَأَنَّ صَفيحَ الهِندِ فَوقَ رُؤوسِهِم","مَصابيحُ لَيلٍ لا يُبالينَ مِغفَرا",9,"ر",2,0],["كأنَّ صنوفَ الطَّيرِ عاذَتْ بأرضِها","وقد سامَها ضَيْماً أُسُودُ سمائِها",10,"ا",3,0],["كأنَّ صوارِمَه في العَجاجِ","بوارِقُ تَصْدعٌ حُجْبَ العَماءِ",11,"ا",2,0],["كَأَنَّ صَريفَ نابَيهِ إِذا ما","أَمَرَّهُما تَرَنُّمُ أَخطَبانِ",12,"ن",1,0],["كأن صدر الظلام ضاق","من كَثرةِ البثِّ كل حين",13,"ن",1,0],["كأن صحاف الدار في عين صاحبي","غوان كستهن المحاسن مطرفا",14,"ف",2,0],["كأنّ صفَاءَ الجوّ يوْمَ عَطائِهِ","مشوبٌ بشؤبوب الغمام المديّمِ",15,"م",1,0],["كأنّ صَبَاها للعرانين فَتّقَتْ","نداها بندٍّ فهي طيِّبةُ النفح",16,"ح",1,0],["كأنّ صلالاً وسطها في مكامنٍ","تحركُ فيها ألسناً بلجاج",17,"ج",1,0],["كَأَنَّ صَوتَ النَعامِ فيهِ","إِذا دَعا صَوتُ مُستَغيثِ",18,"ث",1,0],["كأنّ صُفوفَ القومِ في جَنَباتِها","إذا جدَّتِ الهيجا صَفيفُ شُواءِ",19,"ا",2,0],["كَأَنَّ صارِمَهُ في كلِّ مُعْتَرَكٍ","نَذِيرُ مَوْتٍ خَلَتْ مِنْ قَبْلِهِ النُّذُرُ",20,"ر",1,0],["كأنّ صِعابَ البُختِ إذ ذُلِّلَتْ لهُ","أُسارى مُلوكٍ عضَّها القِدُّ ضُرَّع",21,"ع",1,0],["كَأَنَّ صُغرى وَكُبرى مِن فَواقِعِها","حَصباءُ دُرَّ عَلى أَرضٍ مِنَ الذَهَبِ",22,"ب",1,0],["كَأَنَّ صَفاءَ الدَمعِ في ساحِ خَدِّهِ","حَكى الدُرَّ مَنثوراً عَلى وَرَقٍ نَضرِ",23,"ر",1,1],["كَأَنَّ صُدغَيهِ في سَوادِهِما","خُطّا عَلى عارِضَينِ بِالقَلَمِ",24,"م",1,0],["كَأَنَّ صاعِقَةً في جَوفِ بارِقَةٍ","زَئيرُهُ واغِلاً في أُذنِ نابِحِها",25,"ح",3,0],["كَأَنَّ صَوَاهِلَ ذِبَّانِهِ","قُبَيْلَ الصَّبَاحِ صَهِيلُ الحُصُنْ",26,"ن",1,0],["كأَنَّ صَرِيعَ الأَثْلِ والطَّلْحِ وَسْطَهُ","بَخَاتِيُّ جُونٌ سَاقَهَا مُتَرِّبحُ",27,"ح",1,0],["كَأَنَّ صَبِيراً فَوْقَهُمْ مِنْ غَمَامَةٍ","إِذَا جَانِبٌ مِنْهَا تَهَلّلَ أَبْرَدَا",28,"د",2,0],["كأنّ صَبيّ البيضِ إنْ شاء مَسَّها","صَبيُّ أُناسٍ عَضّهُ الفَقْرُ بائِس",29,"س",1,0],["كَأَنَّ صِحَافَ الزَّهْرِ وَالطَّلُّ ذائِبٌ","عُيُونٌ يَسِيلُ الدَّمْعُ مِنْهَا وَتَشْخَصُ",30,"ص",1,0],["كَأَنَّ صِحَافَ النُّورِ والطَّلُّ جَامِدٌ","مَبَاسِمُ أَصْدَافٍ تَبَسَّمْنَ عَنْ دُرِّ",31,"ر",1,0],["كَانَ صَمْصَامَهَا إِذَا الْتُمِسَ الرَّأْ","يُ وَأَعْيَا مِنْ دُونِهِ الصَّمْصَامُ",32,"م",1,0],["كَانَ صَدْرُ النَّدِيِّ يَهْتَزُّ تِيهاً","حِينَ تَحْتَلُّهُ وَيَزْهُو رُوَاءَ",33,"ا",2,0],["كانَ صَبوحي فَكَيفَ أَصبَحَ جَذ","لانَ وَأَنسى فَكَيفَ أَنساهُ",34,"ا",2,0],["كَانَ صَبّاً بِمِصْرَ كَمْ هَامَ شَوْقاً","بِرُبَاهَا وَبَثَّهَا أَحْزانَهْ",35,"ن",2,0],["كان صوتاً عربياً خالصاً","يسلك البيد ويستّن الرعانا",36,"ن",2,0],["كأَن صدورَ الناس حين توهَّجت","أَضاءت بها أنوارُه ومنائره",37,"ر",2,0],["كان صليب العود في دنه","وكان في آرائه أصلبا",38,"ب",2,0],["كأنَّ صَريعَ الأَثْلِ والطَّلْحِ وَسْطَهُ","بَخاتِيُّ جُونٌ ساقَها مُتَرَيِّحُ",39,"ح",1,0],["كان صبح الخميس أو ظهر جمعه","أذهلني عني عن الوقت لوعه",40,"ع",2,1],["كَأنّ صَلِيلَ المَرْوِ حِينَ تُشِذُّهُ","صليل زيوفٍ ينقدنَ بعبقرا",41,"ر",2,0],["كانَ صُبحاً مِن كُل لَيلة عيدٍ","كانَ شَمساً بِزول مِنهُ الظَلام",42,"م",1,0],["كَأَنَّ صُهالَ الخَيلِ في حجَراتِهِ","وَمَعمَعَةَ الأَبطالِ مَعرَكَة الحَربِ",43,"ب",1,0],["كانَ صَرفُ الزَمانِ صَعباً وَلَكِن","صارَ لَمّا حَكَمتَ فيهِ ذَلولا",44,"ل",2,0],["كانَ صدّيقهُ الكبيرُ أبو بك","رٍ رفيقاً إذ عزّت الرفقاءُ",45,"ا",2,0],["كأنَّ صفاءَ الرحي","قِ نافسهُ الكوثرُ",46,"ر",1,0],["كأنَّ صباحاً طالعاً من جبينه","أناخ عليه اللَّيلُ بالحالك الوَحفِ",47,"ف",1,0],["كَأَنَّ صَموتاً صافَتَ النَحلُ حَولَها","تَناوَلَها مِن رَأسِ رَهوَةَ شائِرُ",48,"ر",1,1],["كان صدري فداك من هول ليل","خشيت هوله رواسي الجبال",49,"ل",1,0],["كان صدري به كأيام صدرِ الدين","لا تَهتدي إليه الهمومُ",50,"م",1,0],["كأن صبا نجد سقتها مدامة","عبيرية تهدي لمن لم يجدو جدا",51,"د",2,0],["كَأَنَّ صُروفَ الدَّهْرِ لَيْسَ يَعُدُّهَا","صُرُوفاً إِذَا مَكْرُوهُهُنَّ عَدَانِي",52,"ن",2,0],["كأَنَّ صغارَ الشُهب في غَسَق الدُجى","فِراخُ نُسورٍ والبُروج مَفارِخُ",53,"خ",1,0],["كأَنَّ صدرها فدته نفسي","لجةُ ماءِ في شعاع الشمسِ",54,"س",1,0],["كَأنّ صفات الفضلِ أَضحَت لِشخصهِ","مَرايا بَدَت فيهنّ طَلعَته الغرّا",55,"ر",2,0],["كَأَنَّ صِبَايَ قَدْ رُدَّتْ رُؤاهُ","عَلَى جَفْنِي المُسَهَّدِ أَوْ كَأَنِّي",56,"ن",2,0],["كأن صياغاً صاغ فوق غصونها","من الذهب الناري عراجين من تمرِ",57,"ر",1,0],["كأن صباحاً غارَ ليلةَ زارني","فَفاجَأني من وَجههِ مُتفجِّرا",58,"ر",2,0],["كأن صرمُ بغلٍ حين سَكْرَجَهُ","بعدَ البرازِ وباقي الرَّوثِ في وَسَطه",59,"ط",2,0],["كأَنَّ صِلاتَهُ لَهُمُ صَلاة","فَلَيسَ تَتِمُّ إِلّا أَن يوالي",60,"ل",2,0],["كانَ صَحبي بها وكنَّا جميعاً","نُشْبِهُ العِقْد بهجةً وانتظاما",61,"ا",1,0],["كأَنَّ صورته للعينِ إذ جُلِيَتْ","من فضةٍ قُدِّرت بالحسن تقديرا",62,"ر",2,0],["كان صديقي في ساعات الليل الأولى","يتجول في بلدتهِ",63,"ه",1,0],["كأن صفاءَ الماء ينفرج القَذَى","بها عنهُ وجهٌ عُطّ عنه لثامُ",64,"م",1,0],["كأنَّ صميمَ العزِّ في كلِّ هجمةٍ","على الموتِ مابينَ الحُماةِ المصاعبِ",65,"ب",1,0],["كأن صدري من ضيق ومن حرج","للوافدين إلى أبوابه سبل",66,"ل",1,0],["كأن صالحهم يوماً وعاذلهم","في صدر ذا الدست لم يقعد ولم يقم",67,"م",1,0],["كَأَنَّ صيرانَ المَها الأَخلاطِ","بِالرَملِ أُحبوشٌ مِنَ الأَنباطِ",68,"ط",1,0],["كان صورتها في الوصف إِذ وصفت","دينار عين من المصرية العتقِ",69,"ق",1,1],["كأَنَّ صياحَ مُلحَمَينِ تَقَلَّبا","بِصَيدَينِ فانقَضّا صِياحُ شَباهُما",70,"م",2,0]]}