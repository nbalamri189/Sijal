{"poems":[[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[95,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[23,"إبك بكت عيناك ثم تبادرت","https://www.aldiwan.net/poem21321.html","الكامل"],[40,"سالا عن الجود والمعروف أين هما","https://www.aldiwan.net/poem7865.html","البسيط"],[91,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[91,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[64,"أفنى الليالي شبابي","https://www.aldiwan.net/poem52489.html","المجتث"],[99,"أصبحت من يأسي لو ان الردى","https://www.aldiwan.net/poem25075.html","السريع"],[46,"ماذا بدا لك إذ نقضت هواكا","https://www.aldiwan.net/poem30014.html","الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[107,"هدأ المخيم واطمأن المضجع","https://www.aldiwan.net/poem44071.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[54,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[52,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[164,"يا من رأى مثل ابن تاج الدين","https://www.aldiwan.net/poem58960.html","الكامل"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[228,"ماذا بوسع الزمن المدعي","https://www.aldiwan.net/poem39728.html","السريع"],[302,"هذا الحجاز وذاك ضاله","https://www.aldiwan.net/poem33196.html","مجزوء الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[320,"عشقت عينيك","https://www.aldiwan.net/poem63032.html","عموديه"],[409,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[556,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[591,"ما ذاب سقاما في الهوى لولاكم","https://www.aldiwan.net/poem17706.html","الدوبيت"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122542","الكامل"],[666,"","https://poetry.dctabudhabi.ae/diwan/poem/147420","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48891","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122865","الكامل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45468","البسيط"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69498","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82236","البسيط"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131720",""],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87723","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201761","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79723","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140301",""],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97994","الرجز"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143509","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145116","الكامل"],[3910,"","https://poetry.dctabudhabi.ae/diwan/poem/131371","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29327","الكامل"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34748","الرجز"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4858,"ماذا بركبك يا أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=137598",""],[4927,"يا قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4540",""],[4929,"مأساة مسلمي بوورما 2","https://www.poetsgate.com/ViewPoem.aspx?id=199386",""],[5005,"ورقة في معجم الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=189123",""],[4119,"ماذا بأطراف الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=16168",""],[5136,"أفدي التي بت أبل الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=121611",""],[5142,"الفردوس المضرج","https://www.poetsgate.com/ViewPoem.aspx?id=11405",""],[5324,"ما عاد سجيل العراق يقضّهم .","https://www.poetsgate.com/ViewPoem.aspx?id=207471",""],[5351,"حسناً سأحدث","https://www.poetsgate.com/ViewPoem.aspx?id=202715",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5612,"بَدْرُ الدُّجَى","https://www.poetsgate.com/ViewPoem.aspx?id=179798",""],[5612,"ماذا بِوُسْعِكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179863",""],[5612,"صَلُّوا عَليْه","https://www.poetsgate.com/ViewPoem.aspx?id=179970",""],[5612,"ماذا برَأْيِكْ ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=180054",""],[5612,"ماذا ستفْعَلْ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=181615",""],[5612,"متَى ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=186140",""],[5704,"مسكين أنت يا وطني ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200014",""],[5737,"توبة الملاك","https://www.poetsgate.com/ViewPoem.aspx?id=177800",""],[5939,"صياد عجوز","https://www.poetsgate.com/ViewPoem.aspx?id=179281",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6093,"مَاذَا بِأرضيَ غَيْرُ مَكَةَ والمَديْنَه","https://www.poetsgate.com/ViewPoem.aspx?id=181835",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[2638,"عندما صمت الهزار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87864&r=&rc=21",""]],"verses":[["مَاذَا بَلَوْا مِنْ ظَرْفِ عَدْلِيِّ وَمِن","رَأَيٍ يُدَارُ وَمِنْ ثَبَاتٍ جَنَانِ",0,"ن",1,0],["مَاذَا بَلَوْتُ مِنَ الشَّمَائِلِ حُلْوَةً","فِيهِ وَمِنْ صِدْقٍ وَرعْيِ ذِمَامِ",1,"م",1,0],["ماذا بَكَيتَ عَلى الَّذينَ تَتابَعوا","هَلّا ذَكَرتَ مَكارِمَ الأَقوامِ",2,"م",1,0],["ماذا بِمَنبِجَ لَو تُنبَش مَقابِرُها","مِنَ التَهَدُّمِ بِالمَعروفِ وَالكَرَمِ",3,"م",1,0],["ماذا ببلبل ايكه وهو الذي","ملأ الفضاء شهاقه لا يشهق",4,"ق",1,0],["ماذا برقراق السحائب","ضمن المجرة من كواكب",5,"ب",1,1],["ماذا بعُشِّكَ فادْرُجْ","عن منزلٍ بك نابي",6,"ب",2,0],["ماذا بقائي ها هنا بعدما","نفضت منه اليوم كفيا",7,"ا",1,0],["ماذا بَدا لَكَ إِذ نَقَضتَ هَواكا","وَحَلَفتَ أَنّي لا أَشُمُّ قَفاكا",8,"ك",2,1],["ماذا بَدا لَكِ مِن أَعاجيبِ الوَغى","وَشَهِدتِ مِن أَسَدٍ وَمِن قِطعانِ",9,"ن",1,0],["ماذا بِسَعْدٍ يا رُفَيْدَةُ خَبِّري","إنّ القلوبَ من الجنُوبِ تَطَلَّعُ",10,"ع",1,0],["ماذا بَلغت من السَّناءِ على يدٍ","أدنَى أنامِلها السِّماكُ الأعزلُ",11,"ل",1,0],["ماذا بِأَوَّلِ حادِثٍ","كَشَّفتُهُ فَتَكَشَّفا",12,"ف",2,0],["ماذا بِإِرسالِها تُعاتِبُني","في زائِرٍ زارَني وَلَم يَعُدِ",13,"د",1,0],["ماذا بضاحية الرمي","ثة من غطارفة جحاجحْ",14,"ح",1,1],["مَاذَا بَثَثْتَ مِنَ الحَيَاةِ جدِيدَةً","فِي هَذِهِ الآسَادِ وَالأَشْبَالِ",15,"ل",1,0],["ما ذا بنفسك يا شقي صنعته","أخرجتها من جنة وعيون",16,"ن",1,0],["ماذا بِنا في طِلابِ العِزِّ نَنتَظِرُ","بِأَيِّ عُذرٍ إِلى العَلياءِ نَعتَذِرُ",17,"ر",1,1],["ماذا بِوِسعِ الزَمَن المُدَّعي","ما دمتِ في شِعري وَفي أَضلعي",18,"ع",2,1],["ماذا بكاءُ المستها","م برقمتيه وما سؤاله",19,"ل",2,0],["ماذا بِمَنزِلكم وَسوف تَذودكم","عنهُ النوى وَلَكم منازل أمرعُ",20,"ع",1,0],["ماذا بعينيك؛ شوق أم مكابدةٌ","عنيفة.. أم نداء فيهما لبقُ",21,"ق",1,0],["ماذا به غير ثنائي لكم","فهو به لا غير يستعذب",22,"ب",1,0],["ماذا بقربك من عزٍّ ومفخرةٍ","وما بكفّك من غُنمٍ ومن نَفَلِ",23,"ل",1,0],["ما ذابَ سُقاماً في الهَوَى لَوْلاكُمُ","ما أَتْلَفَ قَلْبَهُ جَوىً إِلَّاكُمُ",24,"م",1,1],["ماذا بَعثتَ عَلَيَّ يا نَفَسَ الصَّبا","مِن حَسرةٍ لِفَواتِ أيامِ الصِّبا",25,"ب",2,1],["ماذا بوسعي أن ابوح لعينها","لأنوثة في معصميها قاتله",26,"ل",2,0],["ماذا بنفسك بعد ما فارقته","غير الذي قدمت من إحسان",27,"ن",1,0],["ماذا بقلب أخيك مذ فارقته","ليكاد من شوق اليك يطير",28,"ر",1,0],["ماذا بَنى لَهُم مِن صالِحٍ حَسَنٌ","وَحَسنٌ وَعليّ وَاِبتَنوا لِغَدِ",29,"د",1,0],["ماذا بِبَغدادَ مِن طيبِ الأَفانينِ","وَمِن عَجائِبَ وَلِلدُّنيا وَلِلدّينِ",30,"ن",1,1],["مَاذَا بِعَدلٍ فِي العِبَارَةِ وَهيَ مُو","هِمةُ التَّحرُّكِ وانتِقَالِ مَكَان",31,"ن",1,0],["ماذا ببغداد من طيب أفانين","ومن عجائب للدنيا وللدين",32,"ن",1,1],["ماذا بفضلي عند فضلي","كم رأيت الفضل قاصر",33,"ر",1,0],["ماذا بعين زَحَلتا مِن مَها عَين","وَالفاتِنات حَفيداتِ السَلاطين",34,"ن",1,1],["ماذا بأول هائل فرجته","فلكم أجبت لصوت عبدٍ ناء",35,"ا",2,0],["ماذا بنفسك من علاءٍ باعثٍ","للزهوِ خبّر يا أدقّ خبير",36,"ر",1,0],["ماذا برأسي حرك الماضي الذي","درست معالمه وعفاها القدر",37,"ر",1,0],["ماذا به لقحت أم لا لقاح لها","وهل لها فيه تأنيث وتذكير",38,"ر",1,0],["ماذا بسني أو على","ثغري فقلت اقتربي",39,"ب",2,0],["ماذا بعيني قد ترى","فقلت عين الطلب",39,"ب",1,0],["ماذا بقلبي من بدرٍ بليت به","للّيث أخلاقه، والخشف خلقته",40,"ه",1,0],["ما ذا بحوران وَما","في الغَوطَتين تجمّعا",41,"ع",2,0],["ماذا بنفسك قد ألم","يا أيها البحر الخضم",42,"م",1,1],["ماذا بجنبة آبوط من الكرم","والعلم ومالحلم مدفونا مع العلم",43,"م",1,1],["ماذا بِوادي الشَرقِ كَوكَبَةٌ","غَيماءُ فَوقَ رُباهُ تَحتَرِقُ",44,"ق",1,0],["ماذا بِقَلبي مِن أَليمِ الخَفقِ","إِذا رَأَيتُ لَمَعانَ البَرقِ",45,"ق",1,1],["ماذا بِأَوَّلِ هائِلٍ فَرَّجتَهُ","بِعِنايَةٍ تَسمو عَلى الجَوزاءِ",46,"ا",2,0],["ماذا بركبك يا أيّار من خبر ؟","أجئتَ بالخير أم حُمّلْتَ بالكدر ؟",47,"ر",1,1],["ماذا بقي للشعر دونك أنت في","صفحات أهل الضاد أنت الضاد",48,"د",1,0],["ماذا بوسعِ الحرف حول حقيقةٍ","فاهت بها ( بُرْمَا) يخطُٰ ويكتبُ",49,"ب",1,0],["ماذا بحقّكَ قد جنيتُ لكي أرى","قلبي لديكَ مُعلّقاً صِفرا؟!",50,"ر",2,0],["ماذا بأطراف الثغر","من بارق على ثغر",51,"ر",1,1],["ماذا بخديك فقالت لهم","نمت ولا أدري على حرصي",52,"ص",2,0],["ماذا بِهِ اليوْمَ مَبْلولاً .. بِهِ بُقَعٌ","مُمَزَّقَ الطَّرْفِ .. غضَّ الطَّرْفَ عَيَّانا ؟",53,"ن",2,0],["ماذا بقى؟ والأرض تنزف بؤسها","وبها الدعيّ على الشريف مُنَصّبُ",54,"ب",1,0],["ماذا بوسعي أن أكون أظنني","في القبو جثمان القتيل وقاتلي",55,"ل",2,0],["ماذا به أثنى ولو","اضحى الحيا فيه رسلي",56,"ل",2,0],["ماذا به يحصي صفاتك واصف","والله نزل ذكرها تنزيلا",57,"ل",2,0],["ماذا بساحِ الكَوْنِ يجْري يا تُرى ؟؟","قد أشْرَقَ الرَيْحانُ فيهِ نَسائِما !!",58,"م",2,0],["ماذا بوُسْعِكَ يا مجْروحُ تفْعَلُهُ !!","في الحِلِّ جَمْرٌ وفي التَرْحالِ نيرانُ",59,"ن",1,0],["ماذا بوِسْعِكَ قَوْلاً ؟!! صاحَ بي قَلَمي","وهل سَيقْدِرُ جَيْشُ اللفْظِ تحْشدُهُ ؟!!",60,"د",2,0],["ماذا برَأْيِكَ ؟ قد وَفَيْتَ وما وَفا !","وحَفظْتَ عَهْداً للوِدادِ ، وأخْلَفا !",61,"ف",2,1],["ماذا برَأْيِكَ ؟ ما بأُفْقِكَ مَخْرَجٌ","تشْفى الجِراحُ وما لجُرْحِك من شِفا",61,"ف",2,0],["ماذا بِرأْيِكَ ؟ إنَّ السّيْرَ مَهْلَكَةٌ","كيْفَ السَّبيلُ وليْسَ الأمْرُ يُحْتَمَلُ",62,"ل",1,0],["ماذا برأْيِكَ فالحُدودُ كثيرةٌ ؟","ماذا ستفْعَلُ والسُّدودُ كِبارُ ؟",63,"ر",1,0],["ماذا بقي ؟ ماذا بقي لم يفعلِ!!؟","كسروك يا وطني العزيز بأكملِ",64,"ل",1,1],["ماذا بقي؟ ماذا بقي لم يفعل!!؟","جعلوا الشريعة في المقام الأسفل",64,"ل",1,0],["ماذا ؟ بلغتَ الأربعين ودون ودون؟!","كلا ! قرُبتُ وأوشك البينُ يكون",65,"ن",1,1],["ماذا بلغت الأربعين ؟ فتب إذن","عن أيِّ شيءٍ قد يتوب المدنفون ؟!",65,"ن",1,0],["ماذا برأيكِ قدْ أعوزْ؟","أناْ حَسْبُ صيادٌ عجوزْ",66,"ز",1,1],["مَا ذا برأيك يحمي الله مصحفَه","لمّا البلايين تقرا؟ أم ترى الخفضا؟",67,"ض",2,0],["ماذا بقي بعدما باتت مكائدهم","وأنت تعرف ماذا نحونا ركبوا",68,"ب",3,0],["مَاذَا بِأرضيَ غَيْرُ مَكَّةَ والمَديْنَه","حتَّى يحاربَهَا الأصَاغِرُ بالضَّغِيْنَه",69,"ن",2,1],["مَاذَا بِأرضيَ غَيْرُ زَمْزَمَ والصَّفَا","ومقَامِ خيْرِ أَبٍ وقومِيَ يَحرسُونَه",69,"ن",2,0],["مَاذَا بِأرضيَ غَيْرُ قَبْلةِ مسلمٍ","إن قَامَ في فرضٍ فوافقَ فيه حيْنَه",69,"ن",2,0],["مَاذَا بِأرضيَ غَيْرُ مَسْجِدِ أَحْمَدٍ","والرُّوضةِ الغراءِ تسْكُنُهَا السَّكِيْنَه",69,"ن",2,0],["ماذا بِوِسعِكَ أَن تَزُو","رَ؟ وَلا بُيوتَ! وَلا شَوارِعْ!",70,"ع",1,0],["ماذا بكفك من أسى ودموع","حتى تؤجج لوعة المفجوع.",71,"ع",1,1]]}