54",""],[54,"يا أَبا سعدِ قَوصَرَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14293",""],[73,"هَلْ تذكُرونَ غريباً عادَهُ شَجَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=201341",""],[45,"مَنْ عَذِيرِي مِنَ الظّبَاءِ الغِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31417",""],[45,"يا أبَا صَالحٍ، صَديقَ الصّلاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=33034",""],[45,"لا جَديدُ الصِّبَا، وَلاَ رَيَعَانُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31846",""],[91,"بنت سورية","https://www.poetsgate.com/ViewPoem.aspx?id=53216",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[31,"بكرَ العاذلاتِ فيها صراحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18816&r=&rc=79",""],[20,"ليس شيء على المنون بباق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70018&r=&rc=40",""]],"verses":[["أَوتَرتَها أَيّامَ باعُكَ صُلَّبٌ","وَكَدَدتَها بِالنَزعِ وَالإِغراقِ",0,"ق",1,0],["أَو تَعاطى مَداكَ فَالمَرءُ مَسبو","قٌ إِذا كَفَّ مِن عِنانِ الجَوادِ",1,"د",1,0],["أَو تَصَدّى لَمَجمَعٍ جَرَحَتهُ","أَلسُنُ القَومِ بِالعُيونِ الحِدادِ",1,"د",1,0],["آوَتْ نَبيَّ الهُدَى لمّا اسْتَجارَ بِها","والنّاسُ في فتْرَةٍ قدْ كذَّبوا الرُّسُلا",2,"ل",2,0],["أوْ تَدارَكَها بعَزائِمِهِ","ما مِثْلُ صِفاحِ الهِنْدِ رُقَى",3,"ق",2,0],["أو تقاعَدْتُ أصْبَحَ الأمْرُ فوْضى","تلعَبُ الشّاةُ فيهِ بالجَزّارِ",4,"ر",1,0],["أو تعرّضْتُ وانْتَدبْتُ سمعْتُ","النّقْدَ حالَ الإيرادِ والإصْدارِ",4,"ر",1,0],["آوَتْ عليّا عندَما ذهبَ الرّدى","والرّوْعُ بالأسْماعِ والأبْصارِ",5,"ر",1,0],["أَو تَسأَلوني عَن شَهي","دَي مَبدَإٍ فَهُما هُما",6,"م",2,0],["أَو تَسأَلوا القَلبَ يَقُل حاذِروا","وَصابِروا أَعداءَكُم تُفلِحوا",7,"ح",3,0],["أَو تَعمَلوا لِصَلاحِنا","فَتَدارَكوهُ إِلى النِهايَه",8,"ا",3,0],["أَو تَحتَبي بِالهَجرِ في نادي القِلى","فَلَكَم حَلَلتُ إِلى الوِصالِ حُباكِ",9,"ك",1,0],["اوتحفروا حفرة ً فالموتُ مكتنعٌ","عِنْدَ البُيوتِ حُصَيناً وابنَ سَيّارِ",10,"ر",1,0],["او ترحضوا عنكمُ عاراً تجلَّلكمْ","رَحضَ العَوارِكِ حَيضاً عندَ أطهارِ",10,"ر",1,0],["أُوتِيَتْ غَيْرَ حُسْنِهَا البَالِغِ الغَايَا","تِ نَفْساً فِي الغِيدِ تَسْتَثْنِيهَا",11,"ي",3,0],["أَوْ توأما رَحَمٍ وَلِيدا حُرَّةٍ","إِنْ حِيلَ بَيْنَهُمَا سَيَلْتَقِيَانِ",12,"ن",1,0],["أَوْ تَدْعُهُ لِلرَّأْيِ تُلْفِ لَهُ","فِيهِ جَلاءُ الصَّارِمِ الخَذِمِ",13,"م",1,0],["أُوتِيتَهُ خَلَفاً لأَسْلافٍ مَضَوْا","فَأَلبَسْهُ أَحْسَنَ لِبْسَةٍ لِدَوامِ",14,"م",1,0],["أَو تَرى الأَيرَ في اِستِهِ","قُلتَ ساقٌ بِمِقطَرَه",15,"ر",2,0],["أَو تَراهُ يَلوكُهُ","قُلتَ زُبدٌ بِسُكَّرَه",15,"ر",2,0],["أَو تَراهُ يَشَمُّهُ","قُلتَ مِسكٌ بِعَنبَرَه",15,"ر",2,0],["أو تُروِني يوماً مياه مجنّة","ويشيم طرفي شامَةٌ وطفيلا",16,"ل",2,0],["أوتيت فضلاً في النهى عجبا","يأتي من الآراء بالعجب",17,"ب",1,0],["أو تكن أرضنا من الشمس جزءاً","فهي سقط من جمرة مستحرّه",18,"ر",2,0],["أوتيتَ مِن جَذبِ الفُراتِ جَوارِياً","مِنها الهَنِيُّ وَسائِحٌ في قَرقَرى",19,"ا",1,0],["أَو تُبصِرانِ سَنا بَرقٍ أَضاءَ لَنا","رَملَ السُمَينَةِ ذا الأَنقاءِ وَالدورِ",20,"ر",1,0],["أَو تَطلُبونَ بِتَيمٍ لا أَبا لَكُمُ","مَن تَبلُغُ التَيمُ أَو تَيمٌ لَهُ خَطَرُ",21,"ر",1,0],["أَوَت لِلشِياحِ وَاِهتَدى لِصَليلِها","كَتائِبُ خُضرٌ لَيسَ فيهِنَّ ناكِلُ",22,"ل",1,0],["أَو تَرى أَمرَينِ جاءا","أَوَّلاً مِثلَ أَخيرِ",23,"ر",1,0],["أَو تُدبِروا فَلَبِئسَ ما سَافَرتُمُ","وَلَمِثلُ أَمرِ إِمامِكُم لَم يَهتَدِ",24,"د",1,0],["أوتيتَ يا أرجح الأنام نهى","فضائلاً في الورى لها شان",25,"ن",1,1],["أوْ تَرَى مِثل فضْلِهِ في صُنُوف ال","فَضْلِ مُذْ حازَ حالة الملْدُودِ",26,"د",1,0],["أو تُبْغض الدنيا كبُغضكَ عشْرَتي","أصبحتَ معدوداً من الزهَّادِ",27,"د",1,0],["أو تهب الشمال عندي بليل","فتَميس الغصون بالأسحار",28,"ر",1,0],["أو تَفِي بالذي وعدْتَ من التَّع","ريض مما فيه رِضا المُعْتاض",29,"ض",1,0],["أو تطوَّل على الجميع فقد أُو","تيت عند اكتنافهم أكنافا",30,"ف",2,0],["أو ترى منه فِئاماً","بعدَهم منك فئامُ",31,"م",1,0],["أو تُوقعَ الإكرام لي","وللذي أُكرمُهُ",32,"م",2,0],["أوتيَ الحكمَ والبيانَ صبيّاً","مثل عيسى ابن مريم ذي الحَنانِ",33,"ن",1,0],["أو تُثب عينَك الإجالة في نُزْ","هةِ وجهٍ يروق أو بستان",33,"ن",1,0],["أو تُثِبْ أذْنَك السماعَ فأدنى","حقِّ إصغائها إلى اللهفان",33,"ن",1,0],["أَو تَرجِعينَ فَراشَةً خَطّارَةً","أَنا في جَناحَيها الضُحى المَوشورُ",34,"ر",1,0],["أَو تَلتَقي عِندَ الكَئيبِ عَلى رِضىً","وَقَناعَةٍ صَفصافَة وَغَديرُ",34,"ر",1,0],["أَو تَكُن في الناسِ كُن أَقواهُمُ","لَيسَتِ العَلياءُ حَظَّ الوُكَّلِ",35,"ل",1,0],["أَو تَرى الخَطبَ عَظيماً","فَكَذا الأَجرُ عَظيمُ",36,"م",1,0],["أَو تَأَخَرتَ واحاشا","كَ فَإِنّي لَكَ عاذِر",37,"ر",1,0],["اوتيته ملكا فاصلح شأنه","لا خير في ملك بلا اصلاح",38,"ح",1,0],["او تضيعين بين لحيتي ال","بيضاء او تنضبين فوق التراب",39,"ب",1,0],["أو تلك جنات البيان تفجرت","فيها المعارف للبصائر أعينا",40,"ن",2,0],["أَو تَهاويلُ شاعِرٍ عَبقَرِيٍّ","طارَحَ البَحرَ وَالطَبيعَةَ شِعرا",41,"ر",2,0],["أَو تَلِ النَفسَ فَهيَ في كُلِّ عُضوٍ","أَو تَلِ الأُفقَ فَهيَ فيهِ ذُكاءُ",42,"ا",2,0],["أَو تُدنِيَنَّهُمُ نَوازِعُ في البُرى","عُجُلٌ كَوارِدَةِ القَطا المَسروبِ",43,"ب",1,0],["أَو تُجتَبى أَقلامُهُم لِكِتابَةِ","فَلَقَبلُ ما كانَت رِماحَ حُروبِ",43,"ب",1,0],["أَو تَبيتُ التِراسُ في غَيرِ حَربٍ","يَتَصَدَّعنَ عَن صُدورِ الرِماحِ",44,"ح",1,0],["أَو تَقدّى الشَجاعِ بادَرَ يَنضو","مِزَقاً مِن قَميصِهِ المُتَفَرّي",45,"ي",1,0],["أَو تَوَخّوا صِيانَةً كانَتِ الأَم","والُ أَولى بِها مِنَ الأَعراضِ",46,"ض",1,0],["أَو تَترُكَ الوُدَّ عَلى حالِهِ","وَتَستَوي أَقدامُنا صَفّا",47,"ف",2,0],["أَو تَغابى مُسامِحاً فَكَثيراً","ما أَرانا الغِنى تَغابى الكَريمِ",48,"م",1,0],["أَو تَسَل عَن قَديمِها فَزَعيما","سَلَفَيها يَزيدُهُ قَنانُه",49,"ن",2,0],["أَو تُحَصِّلهُ لا تُحَصِّل خِلافاً","بَينَ مَرآهُ بادِياً وَسَماعِه",50,"ع",2,0],["أَو تَعطِفَ العيسَ صُعراً في أَزِمَّتِها","إِلى اِبنِ لَيلى إِذا اِبزَوزى بِكَ السَفَرُ",51,"ر",1,1],["أو تَرى غيرَ ما رَأيتَ فإني","صافِحٌ عن مُمَوِّهٍ مِخراقِ",52,"ق",1,0],["أَو تَعاطى بِأَن يُحاكيكَ في الجو","دِ وَهَيهاتَ ما لِذاكَ اِعتِبارُ",53,"ر",1,0],["أَو تُرجِّي نَيلَ صادٍ لِلَّمى","قلتُ لولا الماءُ ما أوْرَقَ عود",54,"د",1,0],["أَو تَلقَ مِن دونِهِ حُجبٌ مُكَرَّمَةٌ","يَوماً فَقَد أُلقِيَت مِن دونِكَ الحُجُبُ",55,"ب",1,0],["أَو تَصَدَّعنَ عَن قِلىً لَكَفى بِال","شَيبِ بَيني وَبَينَهُنَّ حَسيبا",56,"ب",2,0],["أو تقبلُ الحمى الفدا","جعلتُ روحي عوضكْ",57,"ك",1,0],["أو تَحْسَبوُا أن الطريقَ كعهدِكم","بين الصفوفِ \" معبّدٌ \" ورحيب",58,"ب",1,0],["أَو تَقولي ما زِلتَ في الشِعرِ حَتّى","بُحتَ لِلناسِ غَيرَ أَن لَم تُسَمِّ",59,"م",1,0],["أَو تَحَبَّبنَ لا تَعُدنَ فَإِنّي","قَد أَريتُ الوُشاةَ مِنّي اِطِّراحا",60,"ح",2,0],["أوتيتَ بالفرقانِ مَشرعَ حكمةٍ","ما زِلْتَ تُورِدُه النُّفوسَ الهيما",61,"م",2,0],["أوتيتَ مُلكَ الحَمدِ غَيرَ مُدافِعٍ","وَلَبِستَ تاجَي سُؤدُدٍ وَفَخارِ",62,"ر",1,0],["أوتوا اليَقينَ فَلَم تُخذَل لَهُم هِمَمٌ","لَم تُبقِ في الأَرضِ جَيشاً غَيرَ مَخذولِ",63,"ل",1,0],["أُوتوا كِبارَ المُعجِزاتِ وَمُيِّزوا","بِرَوائِعِ الإِحكامِ وَالإِتقانِ",64,"ن",1,0],["أوتادُ هذِي الأرضِ أو أبدالُها","مِنهم فمشرِقُها لهم والمغرِبُ",65,"ب",1,0],["أُوتيتِ زَادَكِ مِن تُقىً وهدايةٍ","فَتَزوَّدِي سُبحانَ مَن نَجَّاكِ",66,"ك",1,0],["أوتِيتُ ما جاوزَ الآمالَ من أدبٍ","عالِي الجلالِ مَصُونٍ غيرِ مَبْتَذَلِ",67,"ل",1,0],["أُوتِيتَ نصراً يا محمدُ سَاطعاً","يبقَى على ظُلَمِ العصورِ سَناهُ",68,"ا",2,0],["أَو تِلكَ مِغفَرُ عِزٍّ فَوقَ مَفرِقِهِ","وَتِلكَ تاجٌ مَعاليهِ تُرَصِّعُهُ",69,"ع",2,0],["أَوتادُهُ وُرُكُ الرِحا","لِ مُطَنَّباتٍ بِالحَمائِل",70,"ل",1,0],["أَو تَجعَلِي نُطفَةً في الصَحنِ بارِدَةً","فَتَجعَلي فاكِ فيها ثُمَّ تَسقِيني",71,"ن",2,0],["أو تقولوا قد بَيَّنَتْهُ فما لِلْ","أُذْنِ عما تقوله صَمَّاءُ",72,"ا",2,0],["أَوْ تُرَى سَيِّئاتُهُ حَسَناتٍ","فيقَالُ اسْتحالتِ الصَّهْباءُ",72,"ا",2,0],["أُوتِيتَ فَضْلَ خِلافَةٍ كنُبُوّةٍ","ونَجِيَّ إلهامٍ كوَحْيٍ يُوحَى",73,"ح",2,0],["أو تحمدُ الحمراءُ من مُضَرٍ لكُمْ","مَلِكاً أغَرّ وقادةً أنجابا",74,"ب",2,0],["أَو تَغَنَّت قَصيدَةً","قَينَةٌ عِندَ شارِبِ",75,"ب",1,0],["أَو تَزجُروا مُكفَهِرّاً لا كِفاءَ لَهُ","كَاللَيلِ يَخلِطُ أَصراماً بِأَصرامِ",76,"م",1,0],["أو تُحسُّ الأرواحُ قصفَ الرياح ال","هوج فيه أو هدرةَ الرجَّافِ",77,"ف",1,0],["أوَ ترضى بالذي ما كُنْتَ ترضى","أيُّ دنيا من عذاب وشقاءْ",78,"ا",2,0],["أو تكُن روحك السجينة عافت","ذلك الخبزَ في الحياة طلابا",79,"ب",2,0],["أو تكُن منك عافتِ الشفتانِ","كاذبَ القول تستقيه سماما",79,"م",2,0],["أوَ تلكَ حانتُهُ فوا عجبا","أم صُنْعُ أحلامٍ وأهواءِ",80,"ا",2,0],["أو تبالي قدماها خاضتا","مسربَ الماءِ الدفوق الهامرِ",81,"ر",1,0],["أَو تَكُن وِجهَةق فتِلكَ سَبي","لُ النَّاسِ لا تَمنَعُ الُحتُوفَ الرَّواقي",82,"ق",2,0],["أَوْ تسْمَعُوا نوْحَ الحَمَامْ فَدُونَه","آلاَمُ دَامِيَةٍ مِنَ الأَكْبَادِ",83,"د",1,0],["أُوتِيتِ سَعْداً يَا عَرُو","سُ فَالْبَسِيهِ وَارْفُلِي",84,"ل",2,0],["أَوْ تَفْتَرِقْ فهِي الْجُيُو","شُ بِقَادَةٍ وَبِتبَّعِ",85,"ع",1,0],["أَوْ تُصْلَحُ الأُسْرَةُ فِي وُلْدِهَا","لِيَنْشَأ النِّشْءُ قَوِيمَ الخِلاَلْ",86,"ل",1,0],["أَوْتُوا مِنَ الْشَّارَاتِ أَحْسَنَ زِينَةٍ","وَأَحَبَّ مِنْهَا زينَةَ الأَلْبَابِ",87,"ب",1,0],["أَوْ تُرْضِعُ الأَثْدَاءَ مِمَّا أَقْبَلَتْ","تُرْوِي الْعِطَاشَ بِهِ صُدُورُ سَحَائِبِ",88,"ب",1,0],["أَوْ تُدْرِكُ الدَّاءَ الدَّوِيَّ بِنَصْلَةٍ","تَنْضُو الْحِجَابَ وَلاَ تَضِلُّ طَرِيقَا",89,"ق",2,0],["أُوْتِيتَ ذِهْناً خَصْباً وَعِلْماً","إِلى مَدَاهُ الأَقْصى وَسِيعَا",90,"ع",2,0],["أَوْ تَبْتَغِي لِيَ أَجْراً","كَفَى بِمَا فَاتَ أَجْرَا",91,"ر",2,0],["أُوْتِيَ العَقْلُ وَلَمْ يُؤْتَ الْهَوَى","عِلْمُ مَنْ هُمْ أَبْرِياءٌ أَو جُنَاةُ",92,"ه",1,0],["أو تحشد الدهماء خلفك موكبًا","ليسير باسمك هاتِفًا ومشيدا",93,"د",2,0],["أو تحملون على المذلة أمَّةً","عزلاءَ تعتبرُ الكرامةَ دينا؟",94,"ن",2,0],["أو تَفهمُ المقصودَ من خطابي","فإِن أقلْ تَهُمَّ بالجواب",95,"ب",1,0],["أو تعالى صراخُه، فكما طنَّ","بدَوْح الهجير صوتُ ذُبابه",96,"ب",2,0],["أو تبالي قدماها خاضتا","مسرب الماء الدّفوف الهامر",97,"ر",1,0],["أو تهزأون بقدرِه ما هذه الاحجارُ","ما هذي الصخورُ الاربَع؟",98,"ع",1,0],["أو تُحتَقَرْ \" وسيوف الهند مُغمَدةٌ","فقد نَظَرتُم إليها والسيوفُ دَم\"",99,"م",1,0],["أو تنس \"عمور \" وما دفعوا بها","لم تُنس \" قرطبةٌ\" ولا \" إشبيل \"",100,"ل",1,0],["او تنكروا مني حماسة شاعر","فالقومُ قومي والبلاد بلادي",101,"د",2,0],["أَو ترَى الأ.. في استِهِ","قلتَ : ساقٌ بمقطرهْ",102,"ر",2,0],["أو تَحْفظُون عهُودًا لا أُضَيِّعُها","إنَّ الكرامَ بِحفظِ العَهْدِ تُمْتَحنُ",1