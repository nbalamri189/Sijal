تابا","https://www.aldiwan.net/poem53601.html","مجزوء الرمل"],[399,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[399,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[400,"ما المنحنى قصده ورامه","https://www.aldiwan.net/poem33422.html","مخلع البسيط"],[400,"مثلي بهذا منك لا يرضى","https://www.aldiwan.net/poem33696.html","الكامل"],[400,"ما رحلتم عن مقلتي وسوادي","https://www.aldiwan.net/poem33943.html","الخفيف"],[413,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[413,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[413,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[413,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[426,"مرحبا مرحبا بربة خال","https://www.aldiwan.net/poem39904.html","الخفيف"],[426,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[434,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[436,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[436,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[436,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[444,"إن يكن قتلنا الملوك خطاءً","https://www.aldiwan.net/poem23917.html","الخفيف"],[450,"ليت عندي الحبيب أو","https://www.aldiwan.net/poem13719.html","مجزوء الخفيف"],[451,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[451,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[462,"عصفت به ريح الخطوب زعازعاً","https://www.aldiwan.net/poem3113.html","عموديه"],[463,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[468,"قالت وقلت تحرجي وصلي","https://www.aldiwan.net/poem4643.html","أحذ الكامل"],[480,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[484,"يا مال والسيد المعمم","https://www.aldiwan.net/poem480.html",""],[493,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[536,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[549,"لا تطمعي في سلو قلب","https://www.aldiwan.net/poem47147.html","مخلع البسيط"],[549,"من رأى لي في الدجى ذا خطل","https://www.aldiwan.net/poem47224.html","الرمل"],[549,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[556,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[565,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[565,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[573,"قد جاء جيش الحسن في قمر","https://www.aldiwan.net/poem2828.html","أحذ الكامل"],[573,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[582,"نحن بنات طارق","https://www.aldiwan.net/poem69385.html","مجزوء الرجز"]],"verses":[["أَوتَرتَها أَيّامَ باعُكَ صُلَّبٌ","وَكَدَدتَها بِالنَزعِ وَالإِغراقِ",0,"ق",1,0],["أَو تَعاطى مَداكَ فَالمَرءُ مَسبو","قٌ إِذا كَفَّ مِن عِنانِ الجَوادِ",1,"د",1,0],["أَو تَصَدّى لَمَجمَعٍ جَرَحَتهُ","أَلسُنُ القَومِ بِالعُيونِ الحِدادِ",1,"د",1,0],["آوَتْ نَبيَّ الهُدَى لمّا اسْتَجارَ بِها","والنّاسُ في فتْرَةٍ قدْ كذَّبوا الرُّسُلا",2,"ل",2,0],["أوْ تَدارَكَها بعَزائِمِهِ","ما مِثْلُ صِفاحِ الهِنْدِ رُقَى",3,"ق",2,0],["أو تقاعَدْتُ أصْبَحَ الأمْرُ فوْضى","تلعَبُ الشّاةُ فيهِ بالجَزّارِ",4,"ر",1,0],["أو تعرّضْتُ وانْتَدبْتُ سمعْتُ","النّقْدَ حالَ الإيرادِ والإصْدارِ",4,"ر",1,0],["آوَتْ عليّا عندَما ذهبَ الرّدى","والرّوْعُ بالأسْماعِ والأبْصارِ",5,"ر",1,0],["أَو تَسأَلوني عَن شَهي","دَي مَبدَإٍ فَهُما هُما",6,"م",2,0],["أَو تَسأَلوا القَلبَ يَقُل حاذِروا","وَصابِروا أَعداءَكُم تُفلِحوا",7,"ح",3,0],["أَو تَعمَلوا لِصَلاحِنا","فَتَدارَكوهُ إِلى النِهايَه",8,"ا",3,0],["أَو تَحتَبي بِالهَجرِ في نادي القِلى","فَلَكَم حَلَلتُ إِلى الوِصالِ حُباكِ",9,"ك",1,0],["اوتحفروا حفرة ً فالموتُ مكتنعٌ","عِنْدَ البُيوتِ حُصَيناً وابنَ سَيّارِ",10,"ر",1,0],["او ترحضوا عنكمُ عاراً تجلَّلكمْ","رَحضَ العَوارِكِ حَيضاً عندَ أطهارِ",10,"ر",1,0],["أُوتِيَتْ غَيْرَ حُسْنِهَا البَالِغِ الغَايَا","تِ نَفْساً فِي الغِيدِ تَسْتَثْنِيهَا",11,"ي",3,0],["أَوْ توأما رَحَمٍ وَلِيدا حُرَّةٍ","إِنْ حِيلَ بَيْنَهُمَا سَيَلْتَقِيَانِ",12,"ن",1,0],["أَوْ تَدْعُهُ لِلرَّأْيِ تُلْفِ لَهُ","فِيهِ جَلاءُ الصَّارِمِ الخَذِمِ",13,"م",1,0],["أُوتِيتَهُ خَلَفاً لأَسْلافٍ مَضَوْا","فَأَلبَسْهُ أَحْسَنَ لِبْسَةٍ لِدَوامِ",14,"م",1,0],["أَو تَرى الأَيرَ في اِستِهِ","قُلتَ ساقٌ بِمِقطَرَه",15,"ر",2,0],["أَو تَراهُ يَلوكُهُ","قُلتَ زُبدٌ بِسُكَّرَه",15,"ر",2,0],["أَو تَراهُ يَشَمُّهُ","قُلتَ مِسكٌ بِعَنبَرَه",15,"ر",2,0],["أو تُروِني يوماً مياه مجنّة","ويشيم طرفي شامَةٌ وطفيلا",16,"ل",2,0],["أوتيت فضلاً في النهى عجبا","يأتي من الآراء بالعجب",17,"ب",1,0],["أو تكن أرضنا من الشمس جزءاً","فهي سقط من جمرة مستحرّه",18,"ر",2,0],["أوتيتَ مِن جَذبِ الفُراتِ جَوارِياً","مِنها الهَنِيُّ وَسائِحٌ في قَرقَرى",19,"ا",1,0],["أَو تُبصِرانِ سَنا بَرقٍ أَضاءَ لَنا","رَملَ السُمَينَةِ ذا الأَنقاءِ وَالدورِ",20,"ر",1,0],["أَو تَطلُبونَ بِتَيمٍ لا أَبا لَكُمُ","مَن تَبلُغُ التَيمُ أَو تَيمٌ لَهُ خَطَرُ",21,"ر",1,0],["أَوَت لِلشِياحِ وَاِهتَدى لِصَليلِها","كَتائِبُ خُضرٌ لَيسَ فيهِنَّ ناكِلُ",22,"ل",1,0],["أَو تَرى أَمرَينِ جاءا","أَوَّلاً مِثلَ أَخيرِ",23,"ر",1,0],["أَو تُدبِروا فَلَبِئسَ ما سَافَرتُمُ","وَلَمِثلُ أَمرِ إِمامِكُم لَم يَهتَدِ",24,"د",1,0],["أوتيتَ يا أرجح الأنام نهى","فضائلاً في الورى لها شان",25,"ن",1,1],["أوْ تَرَى مِثل فضْلِهِ في صُنُوف ال","فَضْلِ مُذْ حازَ حالة الملْدُودِ",26,"د",1,0],["أو تُبْغض الدنيا كبُغضكَ عشْرَتي","أصبحتَ معدوداً من الزهَّادِ",27,"د",1,0],["أو تهب الشمال عندي بليل","فتَميس الغصون بالأسحار",28,"ر",1,0],["أو تَفِي بالذي وعدْتَ من التَّع","ريض مما فيه رِضا المُعْتاض",29,"ض",1,0],["أو تطوَّل على الجميع فقد أُو","تيت عند اكتنافهم أكنافا",30,"ف",2,0],["أو ترى منه فِئاماً","بعدَهم منك فئامُ",31,"م",1,0],["أو تُوقعَ الإكرام لي","وللذي أُكرمُهُ",32,"م",2,0],["أوتيَ الحكمَ والبيانَ صبيّاً","مثل عيسى ابن مريم ذي الحَنانِ",33,"ن",1,0],["أو تُثب عينَك الإجالة في نُزْ","هةِ وجهٍ يروق أو بستان",33,"ن",1,0],["أو تُثِبْ أذْنَك السماعَ فأدنى","حقِّ إصغائها إلى اللهفان",33,"ن",1,0],["أَو تَرجِعينَ فَراشَةً خَطّارَةً","أَنا في جَناحَيها الضُحى المَوشورُ",34,"ر",1,0],["أَو تَلتَقي عِندَ الكَئيبِ عَلى رِضىً","وَقَناعَةٍ صَفصافَة وَغَديرُ",34,"ر",1,0],["أَو تَكُن في الناسِ كُن أَقواهُمُ","لَيسَتِ العَلياءُ حَظَّ الوُكَّلِ",35,"ل",1,0],["أَو تَرى الخَطبَ عَظيماً","فَكَذا الأَجرُ عَظيمُ",36,"م",1,0],["أَو تَأَخَرتَ واحاشا","كَ فَإِنّي لَكَ عاذِر",37,"ر",1,0],["اوتيته ملكا فاصلح شأنه","لا خير في ملك بلا اصلاح",38,"ح",1,0],["او تضيعين بين لحيتي ال","بيضاء او تنضبين فوق التراب",39,"ب",1,0],["أو تلك جنات البيان تفجرت","فيها المعارف للبصائر أعينا",40,"ن",2,0],["أَو تَهاويلُ شاعِرٍ عَبقَرِيٍّ","طارَحَ البَحرَ وَالطَبيعَةَ شِعرا",41,"ر",2,0],["أَو تَلِ النَفسَ فَهيَ في كُلِّ عُضوٍ","أَو تَلِ الأُفقَ فَهيَ فيهِ ذُكاءُ",42,"ا",2,0],["أَو تُدنِيَنَّهُمُ نَوازِعُ في البُرى","عُجُلٌ كَوارِدَةِ القَطا المَسروبِ",43,"ب",1,0],["أَو تُجتَبى أَقلامُهُم لِكِتابَةِ","فَلَقَبلُ ما كانَت رِماحَ حُروبِ",43,"ب",1,0],["أَو تَبيتُ التِراسُ في غَيرِ حَربٍ","يَتَصَدَّعنَ عَن صُدورِ الرِماحِ",44,"ح",1,0],["أَو تَقدّى الشَجاعِ بادَرَ يَنضو","مِزَقاً مِن قَميصِهِ المُتَفَرّي",45,"ي",1,0],["أَو تَوَخّوا صِيانَةً كانَتِ الأَم","والُ أَولى بِها مِنَ الأَعراضِ",46,"ض",1,0],["أَو تَترُكَ الوُدَّ عَلى حالِهِ","وَتَستَوي أَقدامُنا صَفّا",47,"ف",2,0],["أَو تَغابى مُسامِحاً فَكَثيراً","ما أَرانا الغِنى تَغابى الكَريمِ",48,"م",1,0],["أَو تَسَل عَن قَديمِها فَزَعيما","سَلَفَيها يَزيدُهُ قَنانُه",49,"ن",2,0],["أَو تُحَصِّلهُ لا تُحَصِّل خِلافاً","بَينَ مَرآهُ بادِياً وَسَماعِه",50,"ع",2,0],["أَو تَعطِفَ العيسَ صُعراً في أَزِمَّتِها","إِلى اِبنِ لَيلى إِذا اِبزَوزى بِكَ السَفَرُ",51,"ر",1,1],["أو تَرى غيرَ ما رَأيتَ فإني"