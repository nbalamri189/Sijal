{"poems":[[102,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[32,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[74,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[53,"مرت ماء عيني فاستهل على النحر","https://www.aldiwan.net/poem63003.html","البسيط"],[47,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[50,"ألا قوموا إلى الكرخ","https://www.aldiwan.net/poem63331.html","الهزج"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[47,"هَبيهِ لمُنْهَلّ الدّموعِ السّوَاكِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31699",""],[161,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[190,"إلى صديق قليل الدين منهتك","https://www.aldiwan.net/poem43176.html","البسيط"],[236,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[240,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[276,"إلى صارم الدين الفتى ابن محمد","https://www.aldiwan.net/poem52060.html","الطويل"],[276,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[409,"طال التأخر منكم أيها النجب","https://www.aldiwan.net/poem34137.html","البسيط"],[458,"إلى ابنتي من أفديها ويسعدني","https://www.aldiwan.net/poem61742.html","البسيط"],[466,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[556,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66639","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69177","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112924","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79891","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78024","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49550","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[3444,"","https://poetry.dctabudhabi.ae/diwan/poem/130736","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117992","المتقارب"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76453","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4691,"وشم بخاصرة الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=61390",""],[4767,"شمس الرشاد","https://www.poetsgate.com/ViewPoem.aspx?id=179938",""],[4791,"اهل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=34896",""],[5028,"مرت على بالي اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=62108",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5376,"أهيم وداريا بدمعٍ أرومها","https://www.poetsgate.com/ViewPoem.aspx?id=188409",""],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5461,"من بادي الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=8543",""],[5692,"ذكر ( قبايل عبيدة قحطان )","https://www.poetsgate.com/ViewPoem.aspx?id=178919",""],[6225,"المبدع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71261&r=&rc=17",""]],"verses":[["إلى صوتها، من موتها تَدخل اسمه","تُسائل هل تلقى لهذا مُسوَّغا؟",0,"غ",2,0],["إِلى صَفَاةٍ عَلَى الدَّأْمَاءِ قَدْ رَسَخَتْ","وَلَمْ تُسِغْهَا لَهَاةُ البَحْرِ ذِي العُبُبِ",1,"ب",1,0],["إِلى صَهوَةٍ تَحدو مَحالا كَأَنَّهُ","صَفاً دَلَّصَتهُ طَحمَةُ السَيلِ أَخلَقُ",2,"ق",1,0],["إلى صنعةِ الشعر فليدع في","حمى الفضل شاعرك الأظهر",3,"ر",1,0],["إلى صاحبٍ أضحى فؤادي صاحباً","بفرقته للهم والحزن والفكر",4,"ر",1,0],["إِلى صامِتِيِّ الكَيدِ لَو لَم يَكُن لَهُ","قَريحَةُ كَيدٍ لَاِكتَفى بِالتَجارِبِ",5,"ب",1,0],["إِلى صَهباءَ كَالمِسكِ","لَدى جَونَةِ عَطّارِ",6,"ر",1,0],["إِلى صَعبِ المَقادَةِ ذي شَريسٍ","نَماهُ في فُروعِ المَجدِ نامِ",7,"م",1,0],["إلى صبية مثل المغالي وخرملٍ","روادٍ ومن شر النساء الخرامل",8,"ل",1,0],["إلى صامِتِيّ الكيْدِ، لوْ لمْ تكُنْ لهُ","قَريحَةُ كَيْدٍ لاكتفى بالتّجارِبِ",9,"ب",1,0],["إلى صُعُودِ مَرْكَبٍ","أَنْهَارُهَا تَفَجَّرَتْ",10,"ت",1,0],["إلى صديق قليل الدين منهتك","ما عازنا منذ صاحبناه",11,"ه",1,1],["إلى صلب إبراهيم والصادق ابنه","وأصبح من عدنان في خير أفخذ",12,"ذ",1,0],["إِلى صَلاحِ الدينِ اِرتَمَت بِبِني ال","آمالِ كومُ البُزلِ المَصاعيبِ",13,"ب",1,0],["إِلى صارم الدين الفَتى ابن محمد","رمت بي مقادير وحرب وَخطوب",14,"ب",1,1],["الى صارم الدين اِنتَهى أَمَلي فَلَم","أَجد قبله قبلا وَلا بعدهبعدا",15,"د",2,0],["إِلى صاحب الجاه العَريض رمت بنا","هموم لَها في ابن العَواتك مطلب",16,"ب",1,0],["إلى صلاة بأضعاف مضاعفة","في أجرها وطواف نوعه يجب",17,"ب",1,0],["إلى صفيةِ أحلامي بمولدها","من تهنئاتي أمانٍ قد تُنميِّها",18,"ي",3,0],["إِلى صَفِراتٍ من نعيمٍ خماصُها","تُكاثِرُ منْ نَعْمائهم بِبطانِ",19,"ن",1,0],["إلى صائلٍ لم تَطُفْ مرّةً","عليه صِقالاً يدا صاقِلِ",20,"ل",1,0],["إلى صدري مفوقة سهام","ولم أر مثلها صابت سوايا",21,"ا",3,0],["إلى صنم كانت خُزاعة كلُّها","تُوَقِّرُه كي يَكسراه ويَهربا",22,"ب",2,0],["إلى صخرٍ كأنَّ الدرّ","يكسُو ليطُهُ ليطه",23,"ط",2,0],["إِلَى صَمِيمٍ آزِرٍ مُعْرَنْزِمُهْ","فِي أُكْلِ أَجْرازٍ دَلَنْظَى زِيَمُهْ",24,"م",2,0],["إِلى صاحِب لا يُخلِق النأيُ عهده","لِناءٍ وَلا يَشقى بِهِ من يُصاقبه",25,"ب",2,0],["إلى صاحب الوجه الجميل غرامي","ومني له أهدى جزيل سلام",26,"م",1,1],["إلى صلبِ كلِّ تقيٍّ نقي","هبطتَ بأَمرِ العليِّ الودود",27,"د",1,0],["إلى صدور جمة الغرام","تحت أيادي جوده الجسامِ",28,"م",1,0],["إلى صورةٍ من عهدِ مأربَ خاصمتْ","سيوفُكُمُ عنها بأَلْسِنةٍ لُدِّ",29,"د",1,0],["إلى صفين تحشدها منايا","تجن إلى مواردها هياما",30,"م",2,0],["إلى صُفوَةِ اللَهِ الأَمينِ لِوَحيهِ","أبي القاسِمِ الهادِي إلى خيرِ مَشعَبِ",31,"ب",1,0],["إلى صفاقس دارِ الخيرِ مَنزلُهُ","اكرم بها في الثنا من دارِ عَبَّادِ",32,"د",1,0],["إلى صاحب الغار أحسابهم","فلا من ثقيف ولا من تميم",33,"م",1,0],["إِلى صقل مرآة الفخار إِلى متى","يضيع لدينا وَهُوَ أَشرف تالد",34,"د",1,0],["إلى صدره ضمها وابتدر","يهش لها واستقص الخبر",35,"ر",1,0],["إلى صدر من أهوى كتبتُ شكايتي","فمحَّى بجهلٍ منه ُ ما كنتُ أكتبُ",36,"ب",1,0],["إلى صَفوٍ به الأرواح تسمو","بعيداً عن طريق الارتدادِ",37,"د",1,0],["إلى صفالي زماني بك","فما فوق كل التراب تراب",38,"ب",1,1],["الى صحيت اعاتب الحظ والوم","الايام ... والايام منها تبرت",39,"ت",1,0],["إلى (صِنِّينَ)والسفْحِ النَضيرِ","وما تُخفيهِ طَيَّاتُ العَبيرِ",40,"ر",1,1],["إلى صنعاء ساقوها حروباً","على الأقحاح من أجل السلامة",41,"م",2,0],["إليَّ صحابي فالرحيل سبيلنا","فمن بعد داريا يهون عظيمُها",42,"م",3,0],["إلى صوفيّة الأرواح إمّا","على شبقٍ غريزيٍّ تُنقى",43,"ق",2,0],["إلى صاحب الحوض الذي كان مؤمن","سيروي غدا من فرط منهلة العذب",44,"ب",1,0],["إلى صفالك زمانك علّ يا ظامي","اشرب قبل لا يحوس الطين صافيها",45,"ي",3,0],["إلى صار ماجود على قدر حاجة","فكلٍّ إلى جاد الزمان يجود",46,"د",1,0],["إلى صدى النور فهو بدرٌ","يُحيلُ قلبَ الظلام فجرا",47,"ر",2,0]]}