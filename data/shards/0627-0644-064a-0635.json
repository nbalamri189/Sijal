{"poems":[[100,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[51,"مرت ماء عيني فاستهل على النحر","https://www.aldiwan.net/poem63003.html","البسيط"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[48,"ألا قوموا إلى الكرخ","https://www.aldiwan.net/poem63331.html","الهزج"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[45,"هَبيهِ لمُنْهَلّ الدّموعِ السّوَاكِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31699",""],[157,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[186,"إلى صديق قليل الدين منهتك","https://www.aldiwan.net/poem43176.html","البسيط"],[231,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[235,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[271,"إلى صارم الدين الفتى ابن محمد","https://www.aldiwan.net/poem52060.html","الطويل"],[271,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[271,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[403,"طال التأخر منكم أيها النجب","https://www.aldiwan.net/poem34137.html","البسيط"],[453,"إلى ابنتي من أفديها ويسعدني","https://www.aldiwan.net/poem61742.html","البسيط"],[461,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"]],"verses":[["إلى صوتها، من موتها تَدخل اسمه","تُسائل هل تلقى لهذا مُسوَّغا؟",0,"غ",2,0],["إِلى صَفَاةٍ عَلَى الدَّأْمَاءِ قَدْ رَسَخَتْ","وَلَمْ تُسِغْهَا لَهَاةُ البَحْرِ ذِي العُبُبِ",1,"ب",1,0],["إِلى صَهوَةٍ تَحدو مَحالا كَأَنَّهُ","صَفاً دَلَّصَتهُ طَحمَةُ السَيلِ أَخلَقُ",2,"ق",1,0],["إلى صنعةِ الشعر فليدع في","حمى الفضل شاعرك الأظهر",3,"ر",1,0],["إلى صاحبٍ أضحى فؤادي صاحباً","بفرقته للهم والحزن والفكر",4,"ر",1,0],["إِلى صامِتِيِّ الكَيدِ لَو لَم يَكُن لَهُ","قَريحَةُ كَيدٍ لَاِكتَفى بِالتَجارِبِ",5,"ب",1,0],["إِلى صَهباءَ كَالمِسكِ","لَدى جَونَةِ عَطّارِ",6,"ر",1,0],["إِلى صَعبِ المَقادَةِ ذي شَريسٍ","نَماهُ في فُروعِ المَجدِ نامِ",7,"م",1,0],["إلى صامِتِيّ الكيْدِ، لوْ لمْ تكُنْ لهُ","قَريحَةُ كَيْدٍ لاكتفى بالتّجارِبِ",8,"ب",1,0],["إلى صُعُودِ مَرْكَبٍ","أَنْهَارُهَا تَفَجَّرَتْ",9,"ت",1,0],["إلى صديق قليل الدين منهتك","ما عازنا منذ صاحبناه",10,"ه",1,1],["إلى صلب إبراهيم والصادق ابنه","وأصبح من عدنان في خير أفخذ",11,"ذ",1,0],["إِلى صَلاحِ الدينِ اِرتَمَت بِبِني ال","آمالِ كومُ البُزلِ المَصاعيبِ",12,"ب",1,0],["إِلى صارم الدين الفَتى ابن محمد","رمت بي مقادير وحرب وَخطوب",13,"ب",1,1],["الى صارم الدين اِنتَهى أَمَلي فَلَم","أَجد قبله قبلا وَلا بعدهبعدا",14,"د",2,0],["إِلى صاحب الجاه العَريض رمت بنا","هموم لَها في ابن العَواتك مطلب",15,"ب",1,0],["إلى صلاة بأضعاف مضاعفة","في أجرها وطواف نوعه يجب",16,"ب",1,0],["إلى صفيةِ أحلامي بمولدها","من تهنئاتي أمانٍ قد تُنميِّها",17,"ي",3,0],["إِلى صَفِراتٍ من نعيمٍ خماصُها","تُكاثِرُ منْ نَعْمائهم بِبطانِ",18,"ن",1,0],["إلى صائلٍ لم تَطُفْ مرّةً","عليه صِقالاً يدا صاقِلِ",19,"ل",1,0]]}