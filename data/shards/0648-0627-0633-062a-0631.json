com/ViewPoem.aspx?id=37456",""],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[5135,"أرض الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=201783",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5183,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=186425",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5325,"خطب أناخ على الإسلام كلكله","https://www.poetsgate.com/ViewPoem.aspx?id=171970",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5413,"العلم إكسير الرقي","https://www.poetsgate.com/ViewPoem.aspx?id=200577",""],[5442,"غنى بذكر الحمى فارتاح كل شجى","https://www.poetsgate.com/ViewPoem.aspx?id=114774",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5691,"شعارير","https://www.poetsgate.com/ViewPoem.aspx?id=205894",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5725,"ياظبية الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=179251",""],[5725,"عمّن سواك","https://www.poetsgate.com/ViewPoem.aspx?id=195059",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[5794,"مهد حمرين","https://www.poetsgate.com/ViewPoem.aspx?id=80289",""],[5855,"أما وأبي للصبر في حال خلة","https://www.poetsgate.com/ViewPoem.aspx?id=186641",""],[5875,"عبق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=37155",""],[5897,"على بركات الله","https://www.poetsgate.com/ViewPoem.aspx?id=177077",""],[5973,"ولماذا الخصام؟","https://www.poetsgate.com/ViewPoem.aspx?id=15893",""],[5974,"وداعا رحيمة","https://www.poetsgate.com/ViewPoem.aspx?id=206700",""],[6031,"حُلَّتْ عَليكَ مَعَاقدُ الأَنْدَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=46282",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[463,"يا دار بين شرافَ فالنخلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60233&r=&rc=289",""],[6277,"ما ذم شعرك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64471&r=&rc=34",""],[6339,"مناجاة قلب..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87891&r=&rc=3",""],[5190,"الرزق الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78291&r=&rc=5",""]],"verses":[["وَاِستَرجَلَ الأَملاكَ قَسراً بَعدَما","رَكِبوا مِنَ الشَرَفِ المُطِلِّ جِبالا",0,"ل",2,0],["وَاِستَرجَعَت مِنكَ اللِحا","ظَ الخُرُّدُ العَقائِلُ",1,"ل",1,0],["وَاِستَروَحَ المَهجورُ مِن","زَفَراتِ هَمٍّ وَاِشتِياقِ",2,"ق",1,0],["واسْتَرْقَصَ السَّمْعَ الطَّروبَ رَواعِدٌ","واستَغْوَتِ العَينَ الطَّموحَ بُروقُ",3,"ق",1,0],["وَأَستَرزِقُ الرَحمَن لِلعَينِ نَظرَةً","إِلَيكِ تُداويها مِنَ العَبَراتِ",4,"ت",1,0],["واسْتَرْهَفوا البيضَ العِضابَ كأنّما","تُمْضى بكَفَّيْ خالِدٍ وضِرارِ",5,"ر",1,0],["واسترعت الدنيا لجانب قبره","أنات ملتاع الجوانح زافر",6,"ر",1,0],["وَاسْتُرِدَّتْ فَرَدَّهَا","مُؤْمِنُ القَلْبِ مُؤْتَمَنْ",7,"ن",1,0],["وَاسْتَرْسَلا كُلٌّ إِلَى آمَالِهِ","بِالقُرْبِ بَعْدَ تَطَاوُحِ الهِجْرَانِ",8,"ن",1,0],["واسْترق الجودُ أحرا","راً أتوك الكل تنجك",9,"ك",1,0],["وأستر ثغره باللثمِ خوفاً","على ليلي من الصبح المنير",10,"ر",1,0],["وَاِستَراحَ الفُؤادُ مِن","هَجرِهِ وَاِحتِجابِهِ",11,"ب",2,0],["واسترِبْ بالمُرِيبِ من كلِّ شيءٍ","واتَّهمْهُ لا تَحْتجنْك حُجونه",12,"ن",2,0],["وَاِستَرجَعَت دَولَةُ الأَقلامِ نَخوَتَها","وَكانَ أَدرَكَها الإِعياءُ وَالتَعَبُ",13,"ب",1,0],["وَاِستَرجِعي عَهدَ البَشاشَةِ وَالرِضى","فَالدَهرُ عادَ تَضاحُكاً وَتَصابي",14,"ب",2,0],["وَاِستَرَحنا مِن عِتابٍ","في الخَبايا وَالزَوايا",15,"ا",3,0],["وَاِستَرجَعَت دَولَتُهُ إِفرِندَها","أَبيَضَ رَيّانَ المُتونِ وَردَها",16,"د",3,0],["واسترزق الله بابتهال","فإنه الواحد القديرُ",17,"ر",1,0],["واسترقصتْ لممَ الأراكِ فخوطُه","من تحتِها مترنحٌ أوراكعُ",18,"ع",1,0],["وَاِستَروَحَت تَرهَبُ الأَبصارَ أَنَّ لَها","عَلى القُصَيبَةِ مِنهُ لَيلَ مَشؤومِ",19,"م",1,0],["وَاَستَرزِقِ اللَهَ مِمّا في خَزائِنِهِ","فَإِنَّما الأَمرُ بَينَ الكافِ وَالنونِ",20,"ن",1,0],["وَاَستَرزِقِ الرَحمنَ مِن فَضلِهِ","فَلَيسَ غَير اللَهِ مِن رازِقِ",21,"ق",1,0],["وَاِستَرَحنا مِنَ التَراويحِ وَاِعتَض","نا بِخَفقِ الجُنوكِ وَالعيدانِ",22,"ن",1,0],["وأستريح إلى كوبٍ يُطّمئنُني","أن ليس ما فيه مِن ماءٍ بغِسلين",23,"ن",1,0],["وَاِستَرجَفَ الأَرضَ الفَضاءَ بِوَثبَةٍ","فَكَأَنَّ رُكناً خَرَّ فيها مِن حِرا",24,"ر",2,0],["وَاسْتروحَ الإِسلامُ من نَفَحاتِها","رِيحَ الأُلىَ اخترم الزّمانُ الذاهبُ",25,"ب",1,0],["وَاِستَرسَلَت بِرَسولِ اللَهِ هِمَّتُهُ","تَرمي الصِعابَ وَتَلوي بِالعَراقيلِ",26,"ل",1,0],["وَاِستَرسَلَت تَرفَعُ النَجوى وَتَنفُثُها","أَيدي اليَتامى وَأَفواهُ المَراميلِ",26,"ل",1,0],["واستُر علينا ما عَلِمتَ فَلَم يُطِق","مِنَّا امْرُؤٌ لِخَطِيئَةٍ تَخجِيلا",27,"ل",2,0],["وَاِستَرخَت الكَفُّ لِلغَزالِ وَقا","لَت اُلهُ عَنّي وَالدَمعُ مُنحَدِرُ",28,"ر",1,0],["وَاِستَرادَتني عَلى الهَو","لِ بِطاعونِ الشَبابِ",29,"ب",1,0],["وَاِستَرِح بِالحَبيبِ فيما تُلاقي","كُلُّ شَيءٍ سِوى الحَبيبِ عَناءُ",30,"ا",2,0],["وَاِستَراحوا مِن ضَغطَةِ القَبرِ ميتاً","وَسُؤالٍ لِمَنكَرٍ وَنَكيرِ",31,"ر",1,0],["واسترزق اللَه مما في خزائنه","فإنما هي بين الكاف والنون",32,"ن",1,0],["واسترشد الأفكار فيك فأنثني","بأوضح أفهامي كأني واهم",33,"م",1,0],["واستراحت ها هنا مقبرة","قرب العمران منها فاكتسح",34,"ح",1,0],["واستردّ الأجيالَ من مُضَرَ الحَمْ","راءِ والشعرَ والحِجا والمواسم",35,"م",1,0],["واسترزق الله مما في خزانته","فإنما الأمر بين الكاف والنون",36,"ن",1,0],["واسترجعوا أحكامَهم مرفوضَةً","ناسٌ بحكمهمُ عليكَ تسرَّعوا",37,"ع",3,0],["واسترقص القمرُ الروضَ الذي ضحكت","ثغورُه عن أقاحٍ فيه ممطور",38,"ر",1,0],["واسْتُرْ ولا تَهْتِكْ إلهي كما","عَوَّدْتَنِي في السَنَّةِ الماضِيَةْ",39,"ي",2,0],["واستردوا إن استطعتم مردا","لثماتي من الخدود النوادي",40,"د",2,0],["واستروح القلب من شوق يلده","ومن دموعٍ لها في العين عينان",41,"ن",1,0],["واسترْ عُيوبَ قَريض مَن","وَالاكَ في هَزْلٍ وَجَدّْ",42,"د",1,0],["واسترق الأحرارَ بالجود والجدوى","وأجزلِ لهم يكونوا عبيدَا",43,"د",2,0],["واستُرجِعتْ عذراءَ لم يَنعَمْ بها","بعلٌ كما ارتَجع الوديعةَ مودِعُ",44,"ع",1,0],["واسترهم برداء الحفظ يا أملي","بحرمة السر بين الكاف والنون",45,"ن",1,0],["وَاسْتَرْجَعَتْ سَأَلَتْ عَنِّي فَقِيلَ لَهَا","مَا فِيهِ مِنْ رَمَقٍ دَقَّتْ يَداً بِيَدِ",46,"د",1,0],["واسْتَرْسَلَ النَّبْضُ بِنَا","فِي حِكْمَةٍ قَدْ قُدِّرَتْ",47,"ت",1,0],["واستر تحت أثوابي هزالا","إذا ابديته شمت السمين",48,"ن",1,0],["واسترزق الله مما في خزائنه","أعني خزائنه اللاتي لمولنا",49,"ن",2,0],["واستريحوا فلقد أتعبكم","ما أقتحمتم منذ دهرلا من قحم",50,"م",1,0],["واستراح القلب من وقد الفتون","بالثنايا الغرّ والثغر الرشوف",51,"ف",1,0],["وأستُرُ عنْها الفجرَ وهي غفولةٌ","وَنَبّهَها العُصْفُورُ وهو له هَدْرُ",52,"ر",1,0],["وَاِستَرجِعِ القُبلاتِ من خَدَّيّا","مَغفِرَةٌ ثَقيلَةٌ عَليّا",53,"ي",2,0],["وَاِستَريبي إِذا سَمِعتِ زَفيري","إِنَّ في صَدريَ الزَفيرَ زَئيرُ",54,"ر",1,0],["واسترِح فيهِ لقولك هل","تُنْسَبُ الأَفلاكُ للثّقلِ",55,"ل",1,0],["وَاِستُر مُحَيّاهُ عَن بَذ","لَةِ السُؤالِ وَصُنهُ",56,"ن",2,0],["وَاسْتُرْ عُبَيْدَكَ فِي دُنَاهُ وَوَارِهِ","حَتَّى يُوَارِيَ جِسْمَهُ قُرْمُوصُهُ",57,"ص",2,0],["واستر بالاعراض ما بي لذكرها","فيفضحني في ما احاوله الشجو",58,"و",1,0],["واسترسلوا جودك المعهود فاسقهمُ","سقياً ندى رحمةٍ فالقبض منبسط",59,"ط",1,0],["وَاِستَرزِقِ اللَهَ مِمّا في خَزائِنِهِ","تُدَل بِفَيضِ أَياديهِ وَلَم تُذَلِ",60,"ل",1,0],["واستراحت على الرمال فضجّت","صبوات في خاطري يقظانه",61,"ن",2,0],["واستراحا لهيام الر","مل والموج المُغنى",62,"ن",2,0],["وَاِسترزق اللَه مِمّا في خَزائِنِه","فَإِنَّ ذاكَ بَينَ الكافِ وَالنونِ",63,"ن",1,0],["وَأَستُرُ لَوعَتي بِكَ عَن صِحابي","وَأَوصابي عَلَيَّ بِها تُنادي",64,"د",2,0],["وَاِستَرامَ الرومَ عَن مَورِدِها","تَستَميحُ الرَيَّ مِن غَدرانِ طَي",65,"ي",1,0],["وَاِستر عَلى الخلِّ ما تَلقاه مِن خللٍ","لَيسَ الكَمال لِغَير اللَهِ وَالرُسُلِ",66,"ل",1,0],["واستَرابَتْ ببُكاها مُقلتي","كان مِن شَأْنَين أو من وَدَجَيْن",67,"ن",1,0],["واسترشد الروحَ المعزِّي الهاجسا","واستنجدِ الآن الملاك الحارسا",68,"س",2,0],["واستر لعورتك واحذر من صلاة العراء","يبطل صلاته بكشف الستر والله عطاه",69,"ا",2,0],["واسترني يارب واجبرني","وارحمني يارب ياحنان",70,"ن",1,0],["واستر إلهي بالفرج","من قبل يظهر شرخيم",71,"م",1,0],["واستر استر أنت أكرم من ستر","لا كشفت الحال يا مولى الموال",72,"ل",1,0],["واسترهنوا قلبي فوا عجبي","الذين لي وفؤادي الرهن",73,"ن",1,0],["وأَسْتُر أشْواقِي واعلَمُ أنّ لِي","لَدَى ذِكرِكُم أنفاسَ وجْدٍ تُبينُها",74,"ه",2,0],["واستَرجَعَتْ ما أعَارتْ من مَواهِبِها","فما هَفَا بي عَلَى آثارِهِ اللّهَفُ",75,"ف",1,0],["واسترْجِعِ الرشدَ من غيٍّ وَهَبْتَ لَهُ","فَضْلَ الدِّمامِ فَوَلَّى حيثُ لا يقِفُ",76,"ف",1,0],["واسْتَرْقَصَتْنِيَ كاسْتِرْقَاصِ حامِلِها","مُخْضَرَّةُ الوُرْقِ أَو مُخْضَرَّةِ الوَرَقِ",77,"ق",1,0],["واسترقصَ الفرحُ الأعطافَ فاشتهبتْ","فيه القوارعُ والهيفَ الأماليدا",78,"د",2,0],["واسْتَرْهَنَتْكَ ملوكُ الأَرضِ أَنْفُسَها","مَا استنفَدَ البَأْسُ أَوْ مَا اسْتَدْرَكَ الكَرَمُ",79,"م",1,0],["واسترزق اللَه بالعلم الجلي فقد","يقال بالعلم جمّ المال تكتسب",80,"ب",1,0],["واسترقصي بان الهضاب ورواحي","تلك المعاهد بالسّلام معطّرا",81,"ر",2,0],["واستراحوا إلى التدهور واليأ","سِ كأنَّ الرجاءَ لصُّ يدَانُ",82,"ن",1,0],["واسترسلوا بيد التحيّة واحتَبَوا","فصحاءَ بعد تطاول الإعجامِ",83,"م",1,0],["واستردّ الكهولُ مقتبلَ العم","ر تودّ اجتماعَه واعتدالَهْ",84,"ل",2,0],["واستروح الريحَ من سُلَيمى","مرّاً على ربعها المُحيلِ",85,"ل",1,0],["واسترعفتْ أيدي عشيرتِهِ","أوصالَها بالطَّرد والشلِّ",86,"ل",1,0],["واسترجعت باقي كرىً","بتنا اختطافاً نسرِقُهْ",87,"ق",2,0],["واسترقَّ الأسماعَ وصفُك فاشتق","تُ فهل من عطف على المشتاق",88,"ق",1,0],["وأستروحُ الأخبارَ وهي تسوءني","علائقَ منها في ذيولِ الجنائبِ",89,"ب",1,0],["وأسترُ شيباً أسْرع الهمُّ زوْرَه","مخافة أن ألْفى من الدهر شاكيا",90,"ي",2,0],["واسترجعوا العذب الموفي على قصبِ","المران ما استودعوه من صبيب دم",91,"م",1,0],["وأسترُ الوجدَ والتَّذكارُ يَفْضَحُهُ","اِذا تنسَّمَ عَرْفُ الرَّندِ أو فاحا",92,"ح",2,0],["واسترسلت لنساء الحي فاغترفت","منها الأيامي وسوتهن بالرجل",93,"ل",1,0],["واسترسلوا في الأمر دون تراجع","فالحبل منه انشقّت الصمّاء",94,"ا",2,0],["واسْتَرشَقوا رأيَهُمْ بالزَّعمِ إذْ مَكَروا","وكلُّهم تحت طيِّ القهرِ ممكُورُ",95,"ر",1,0],["واسْتُرْ عُبَيْداً فيكَ مَظهرُهُ الخَفا","والطُفْ بأسرارِ الغُيوبِ بِمن ظَهَرْ",96,"ر",1,0],["واسْتُرْ عُيوبي حينَ أج","فَلُ من ثَوايَ الى لِقائِكْ",97,"ك",1,0],["واستر علي فإني","أخاف هتك خلاقي",98,"ق",2,0],["وأستر شكرهم خجلاً فيبدو","وعرف المسك ينفح في الختام",99,"م",1,0],["واستر عليه ولا تهتك سريرته","بقول من يستحل الضيف في حرمك",100,"ك",1,0],["وأسترُ منهمْ جانبَ الذّمِّ مُبقياً","على خارقٍ منهمْ لذاك وهاتكِ",101,"ك",1,0],["وَاِستَردّ الزّمانُ من","نِيَ ما كان أقرضا",102,"ض",2,0],["وَاِستَردّ الزمانُ منك وَما سا","ور في ذاك كلّه ما أعارا",103,"ر",2,0],["وَاسْتَرْجَعَتْ مِنْهُمُ اللَّيَالِي","قُرُوضَهَا والحَيَاةُ قَرْضُ",104,"ض",1,0],["واسترد الأرض المسخر فيها","مستقلاً بها غراساً ونبتا",105,"ت",2,0],["واستراحت فيه النفوس من اللغ","ووما اهتاجه الجدال العقيم",106,"م",1,0],["واسترجعوا العاصي إلي","نا فهو بالطاعات ثائبْ",107,"ب",1,0],["واستردوا رهائن الشاعر الزا","رع كي يستقلَّ فيما استقلّا",108,"ل",2,0],["وَاِستَراحَت بِزَوجِها","وَلَهُ الأَمرَ سَلَّمت",109,"ت",1,0],["واسْتَرَدَّ الْعَدُوُّ وُكْدِي وَعَادَتْ","أَعْيُنُ السُّخْطِ وَهِيَ عَنِّيَ رَواضِي",110,"ض",2,0],["واسترسلتْ رسلُ الجهاد وقصدنا","مرُجوُّ نُصرتِنا ونعم المقصد",111,"د",1,0],["واسترق الأسَدَ الظبْيُ الربيب","غير أني منه أطفأت الغليل",112,"ل",1,0],["وَاستَرَدَّ الهِباتِ مِنّا بِعُنفٍ","فكَأنّا لهُ عَلَينا تِراتُ",113,"ت",1,0],["واستر ابن الخلوف واشف اذاه","وأته الخلد واكفه سجيلا",114,"ل",2,0],["واسترجعت عهد الصفاء لهم","وإذا غشاء فذاك يرتجع",115,"ع",1,0]