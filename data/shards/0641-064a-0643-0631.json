{"poems":[[42,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[108,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[154,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[226,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[259,"لا تخف","https://www.aldiwan.net/poem25016.html","مجزوء الرمل"],[347,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[466,"ولو أن نكسا خامل الذكر جاهلا","https://www.aldiwan.net/poem15409.html","الطويل"],[556,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126856","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77608","الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56598","السريع"],[1712,"","https://poetry.dctabudhabi.ae/diwan/poem/146383","البسيط"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76443","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136459",""],[4830,"نجيع الطف","https://www.poetsgate.com/ViewPoem.aspx?id=199845",""],[5038,"حسين العراق","https://www.poetsgate.com/ViewPoem.aspx?id=190164",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5431,"إيهِ مصر فداك مالي وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=211907",""],[5444,"زيتونة المسرى","https://www.poetsgate.com/ViewPoem.aspx?id=205084",""],[5595,"عشقاً إليكَ سيّدَ الأسيادِ","https://www.poetsgate.com/ViewPoem.aspx?id=144649",""],[5720,"كياد *","https://www.poetsgate.com/ViewPoem.aspx?id=199081",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5966,"عروس المصايف","https://www.poetsgate.com/ViewPoem.aspx?id=158862",""]],"verses":[["في كَراديسَ كَالجِبالِ وَرَجلٍ","يُفزِعُ الأَخشَبَينِ طُولُ قَناها",0,"ا",3,0],["في كربلاءَ قضى الحُسَيْ","نُ، وكَمْ هنا سِبْطٌ شهيد!",1,"د",1,0],["فَيُكرَمُ مَثوانا وَيُرقَبُ إِلُّنا","ظِلالُ سِوانا دونَ أُكلٍ وَظِلُّنا",2,"ن",2,0],["فيك رجاء وفيك يأس","يلمحه الفكر لا النظر",3,"ر",1,0],["في كَرْبَلاَء يجود بالنْ","نَفسِ المعطَّشةِ الصَّدِيّه",4,"ي",2,0],["فيك رِفْقٌ، فيك حُمْقٌ","أنتَ مجنونٌ فَطينُ",5,"ن",1,0],["في كريم المرابع","وصميم الأجارع",6,"ع",1,1],["فيكرهُ أنْ تمضي من الدهر ساعة","ولم يُرَ فيها بين حامٍ ومُرْفدِ",7,"د",1,0],["في كربةٍ لا تنجلي وَشَديدةٍ","لا تنقَضِي ودُجُنَّةٍ لا تُصبِحُ",8,"ح",1,0],["في كربلا حفلة الميلاد قد عُقِدَت","بروضةٍ جمَعت أبناءَها العُظَما",9,"م",2,0],["في كَرَّتي طردت أَلفَ نَفسِ","فَاِنهَزَمت من قُوَتي وَبَأسي",10,"ي",1,0],["في كَرَمِ الطَّبعِ وَبَذل المالِ","إِذا بَدا في وجهةِ الحَلالِ",11,"ل",1,0],["في كربلا ثوى ابن بنت","رسول رب العالمينا",12,"ن",2,0],["فيك ربوع أهّلت بالصبا","يا ليت شعري كيف تلك الربوع",13,"ع",1,0],["فيك رجاء وفيك يأس","كالحرّ والبرد في الزناد",14,"د",1,0],["في كُرورِ الدُّهورِ وَالاَعْوامِ","وَمُرورِ اللَيالِيَ وَالاَيّامِ",15,"م",1,0],["فيك رمز المُستَحيل الرابع","دس في كنهك تخفيف المصاب",16,"ب",1,0],["فيكَ روحي دع سوى عيني تنم","نومة اللحد",17,"د",1,0],["في كربلاء أناخَ اليوم ركبُهم","فاحبس فؤادي ياشوقي على الكُرب",18,"ب",1,0],["في كربلا دمعةٌ أسكبتُها شجناً","قد اودعَ الله فيها الشمسَ والقمرا",19,"ر",2,0],["في كرْبلاءَ دمٌ صارتْ منائرُهُ","راياتِ عزٍّ غدتْ للْحشْدِ والرّتَبِ",20,"ب",1,0],["فيك راح الهوى يخط ويملي","لم تقيده ذمة أو حياء",21,"ا",2,0],["فيك ردت جلالة الشعر بعثا","من فصيحٍ ورفعةٍ في البيان",22,"ن",1,0],["في(كَرَّةٍ) وفتيلُها زيتونةٌ","بلفيفِ (غرقدِ) جبنِهم هي والعَه",23,"ع",2,0],["في كربلا سَارتْ لترويَ خطبَكم","ولسانُ زينبَ حاضرُ الميعاد ِ",24,"د",1,0],["في كَرنَفَالٍ ، ماتعٍ ، ومنظمٍ","قاموا عليه بفطنةٍ وحُذاقِ",25,"ق",1,0],["في (كَرْبَلَاءَ) دَمُ الشَّهَادةِ مُزْهِرٌ","والرُّوضَتَانِ تَجُودُ بالنَّفَحَاتِ",26,"ت",1,0],["فيك رجال لهم في المجد منزلة","حازوا صفات العلا والصدق والشيم",27,"م",1,0]]}