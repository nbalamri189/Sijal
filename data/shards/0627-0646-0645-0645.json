{"poems":[[91,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[33,"عاود القلب من تذكر جمل","https://www.aldiwan.net/poem41275.html","الخفيف"],[242,"مظنة إتلاف المحب العواذل","https://www.aldiwan.net/poem18855.html","الطويل"],[266,"بروحي من أغرى الفؤاد لحبه","https://www.aldiwan.net/poem38359.html","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44574","الوافر"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82257","الخفيف"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101416","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120728","الرمل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103862","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117960","الرمل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32486","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""]],"verses":[["إن ممشوقة القوام سليمى","قد لعمري ضنّت فيا عينُ جودي",0,"د",2,0],["إِنَّ مَمشاكِ دونَ دارِ عَدِيٍّ","كانَ لِلقَلبِ فِتنَةً وَفُتونا",1,"ن",2,0],["أَنَمُّ مِنَ النُّوَّارِ يَصْقُلُهُ الْحَيَا","يُبَارِي شَذَا الْغِيطَانِ وَاللَّيْلُ رَاحِلُ",2,"ل",1,0],["انم من السؤال على عديم","ومن دوم السفار على غريب",3,"ب",1,0],["أَنَمُّ مِنَ النُصولِ عَلى مَشيبٍ","وَمِن صافي الزُجاجِ عَلى عُقارِ",4,"ر",1,0],["إِنَّ مَمشاكَ نَحوَ دارِ عَدِيٍّ","كانَ لِلقَلبِ شقوةً وَفُتونا",5,"ن",2,1],["أَنَمُّ من الرَّيحانِ والبَانِ ذِكْرُهُ","وأَذكَى من الجَادِيِّ بالمَنْدَلِ الرَّطْبِ",6,"ب",1,0],["إنَّ مملوككَ عَبدٌ مُسرِفٌ","مُقبِلٌ على الخطايا والخطل",7,"ل",1,0],["أنم من المرآة في كل ما درى","واقطع بين الناس من قصب الهند",8,"د",1,1],["إن ممّا يحفظ الصحة ما","عن أولى الحكمة قدماً نقلا",9,"ل",2,1],["إِنَّ مِمّا يَزيدُني فيكَ زُهدا","أَنَّني لا أَراكَ تَصدُقُ حَرفا",10,"ف",2,1],["ان ممن أنشا وجودي قوامي","وسقامي منه ومنه الشفاء",11,"ا",2,0]]}