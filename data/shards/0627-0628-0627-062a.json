{"poems":[[37,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[63,"أمن رقبة عاف السلام مودعا","https://www.aldiwan.net/poem51570.html","الطويل"],[63,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[136,"أبا تيلميت إن لغزك واضح","https://www.aldiwan.net/poem54872.html","الطويل"],[139,"يا أيذا الفيصل المزجي زواجره","https://www.aldiwan.net/poem48866.html","البسيط"],[147,"محل لهم بين النقا والأجارع","https://www.aldiwan.net/poem11772.html","الطويل"],[254,"تعناك نصب من أميمة منصب","https://www.aldiwan.net/poem2132.html","الطويل"],[362,"يا ليلة جادت الليالي","https://www.aldiwan.net/poem4168.html","مخلع البسيط"],[373,"أبأت بثعلبة بن الخشام","https://www.aldiwan.net/poem1875.html","المتقارب"],[415,"أبا تراب دهرنا جاهل","https://www.aldiwan.net/poem32211.html","السريع"],[466,"واني على همي بعصري وأهله","https://www.aldiwan.net/poem15938.html","الطويل"],[575,"جزاك الله خيرا من خليل","https://www.aldiwan.net/poem59465.html","الطويل"],[897,"","https://poetry.dctabudhabi.ae/diwan/poem/199878","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202072","الرجز"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122846","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132800","الطويل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101570","الطويل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31499","الطويل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216446",""],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138620",""],[4755,"مَسَاءَ الوَردْ يا طَشِّي","https://www.poetsgate.com/ViewPoem.aspx?id=183717",""],[4927,"أَحْلاْمُ الْعِشْق","https://www.poetsgate.com/ViewPoem.aspx?id=29948",""],[5090,"دموعُ العين","https://www.poetsgate.com/ViewPoem.aspx?id=184304",""],[5151,"قافية الخصر","https://www.poetsgate.com/ViewPoem.aspx?id=184824",""],[5277,"ابتهال النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=188114",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[6070,"كَتَبْتُ إليكِ ياعمري","https://www.poetsgate.com/ViewPoem.aspx?id=189820",""]],"verses":[["أَبَأتَ الَّذي وُلّيتَ حَتّى رَأَبتَهُ","وَأَنتَ لِذي القُربى وَذي الوُدِّ واصِلُ",0,"ل",1,0],["أباتَ المالُ نسوتَهم حبالى","وبتُّ وزوجتي بِكرٌ بتولُ",1,"ل",1,0],["أبا تغلبٍ لا زِلْتَ للقِرْنِ غالباً","إذا ارتدَّ للرَّوْعِ الكَمِيُّ مُرَوَّعا",2,"ع",2,0],["أبا تغلِبٌ صبراً وما زلتَ صابراً","إذا زَلَّ حَزمٌ ثابتٌ أو هَفا لُبُّ",3,"ب",1,0],["أَبَاتَ النَّجْمُ لَيْسَ لَهُ ضِيَاءٌ","وَبَاتَ السَّيْفُ لَيْسَ لَهَ صَلِيلُ",4,"ل",1,0],["أبا تيلميتٍ إنَّ لغزكَ واضحٌ","به سَفَحَت من كِيفَةٍ عَبَرَاتُها",5,"ه",2,1],["أباتَني والجِرشَّى حشوُها ضجرٌ","إن مسّ شِقِّي خشبُ الفلك قلقلهُ",6,"ل",2,0],["أَبا تَرجَمٍ جادَت يَداكَ تَبَرُّعاً","فَعالَ كَريمِ الصُنعِ جَمِّ الصَنائِعِ",7,"ع",1,0],["أَباتوا بِسَيحانَ بنِ أَرطاةَ لَيلَةً","شَديداً أَذاها لَم تَكَد تَتَجَوَّبُ",8,"ب",1,0],["أبَاتَ فِي مَنزِلي حَبيبِي","وقامَ في أهلِهِ بِعُذرِ",9,"ر",1,0],["أَبَأْتُ بِثَعْلَبَةَ بْنِ الخُشا","مِ عَمْرَو بْنَ عَوْفٍ فَزاحَ الوهَلْ",10,"ل",1,1],["أبا تُرابٍ دهرُنا جاهلٌ","يَرفع للشِّبهِ ذَوِي الجهْلِ",11,"ل",1,1],["أبا تغْلِبٍ صيتي بَعيدٌ وانما","أطَلْتُ بزوْراءِ العِراقِ ثَوائي",12,"ي",1,0],["أبأت به زهير بني بغيضٍ","وكنت لمثلها ولها حمولا",13,"ل",2,0],["أبأتهما بابن الشريد وغره","جواركم وكان غير مذمم",14,"م",1,0],["أبَا تَمِيم نَجْم سَعْدٍ لاحَ من","عَالَم قُدْسٍ أو هِلالٍ قَدْ أَهلْ",15,"ل",1,0],["أبا تمام الطائي انا","لقينا بعدك العجب العجيبا",16,"ب",2,0],["أباتت يَدُ الأستاذِ بين رياضها","تَدفَّقُ أم أهدَت إليها سَحَائبا",17,"ب",2,0],["أبات الليالي والشؤون سواكب","على ما أقاسي من شجون وأهوال",18,"ل",1,0],["أَباتَ عَلى مِقراكَ ثُمَّ قَتَلتَهُ","عَلى غَيرِ ذَنبٍ ذاكَ جَدَّبكَ الثُكلُ",19,"ل",1,0],["آبات ليلي في تناهيت","والحال منّي هوب مرتاح",20,"ح",1,0],["أبات يجول في عفج طحور","فأعلم أم أتاك به مغدي",21,"د",2,0],["أبات وأضحي في حنينٍ وفي وجد","لذكرى خطوبٍ قد دهت عترة الحمد",22,"د",1,1],["أَبَاتَ اللَّيلْ كالمَغشِي","مُرَاعِي لَحظَةَ الإِنعاشْ",23,"ش",1,0],["أَبَاْتُ º وَ أَرْعَىْ سَاْهِرَ النَّجْمِ حَاْلِماً","بِعَفْرَاْ، وَقَلْبِيْ فِيْ هَوَاْهَاْ مُلَوَّحُ",24,"ح",1,0],["أبات الليلَ مغموراً حزيناً","كأن النارَ في قلبي تثورُ",25,"ر",1,0],["أباتُ منكِ على حُبٍ فيُوقِظُني","عِشقٌ وكلي مع الحالينِ مَفْتونُ",26,"ن",1,0],["أباتُ الليلَ سهرانَ القوافي","كمجتثِّ البحورِ.. بلا سريرِ",27,"ر",1,0],["أبا تُرابٍ تظلُّ مُتّقِداً","ونجومُ السّماءِ تَنْكَسِفُ",28,"ف",1,0],["أبا تراب ٍ أنتَ العذبُ كوثرُهُ","اذْ يَمْلأُ النّفْسَ طِيباً مُاؤُكَ الغَدِقُ",29,"ق",1,0],["أبا تُرابٍ ضُمَّ اليتمَ مَنْقَبَة ً","يا يُتمَ رُوْحٍ تَهْوى الآلَ مُذْ خُلِقُوا",29,"ق",3,0],["أبا تُراب ٍ سَلامُ اللهِ في كَلمٍ","لا ريبَ فيهِ ، كَلامُ الله يتّسِقُ",29,"ق",1,0],["أبا تُرابٍ ، ذا القُرآن ُ منهجُكَ","نَهجُ البلاغةِ رَمزٌ خَطّهُ الحَذِق ُ",29,"ق",1,0],["أبا تُراب ٍ وَليُّ اللهِ يَا مَثلاً","أنّى التَفتْنا رَأيْنا العِلمَ يَنفلِقُ",29,"ق",1,0],["أباتُ على تِلاوتها","وخيرُ الذّكرِ قُرآنِ",30,"ن",1,0]]}