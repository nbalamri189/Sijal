{"poems":[[65,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[53,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[40,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[30,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[76,"وصهوة عزم قد تمطيت والدجى","https://www.aldiwan.net/poem12922.html","الطويل"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62239","الطويل"],[214,"وقالوا الخمر إثم قلت كلا","https://www.aldiwan.net/poem46225.html","الوافر"],[232,"أسرب مها عن أم سرب جنه","https://www.aldiwan.net/poem50754.html","المتقارب"],[235,"لا طيب من ذكري حبيب ومنزل","https://www.aldiwan.net/poem14828.html","الطويل"],[273,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[329,"سألت الديار وأطلالها","https://www.aldiwan.net/poem44248.html","المتقارب"],[356,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[419,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[577,"وصهباء رقت فاسترقت عقولنا","https://www.aldiwan.net/poem2731.html","الطويل"],[744,"","https://poetry.dctabudhabi.ae/diwan/poem/67415","المتقارب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21446","الطويل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22540","الطويل"]],"verses":[["وصُهْبٌ ينُمُّ بأعْراقِها","إذا ما ابْتَذَلْنَ الخُطا أرْحَبُ",0,"ب",1,0],["وَصَهباءَ صِرفٍ كَلَونِ الفُصو","صِ باكَرتُ في الصُبحِ سَوّارَها",1,"ر",3,0],["وَصَهباءَ صِرفٍ كَلَونِ الفُصوصِ","سَريعٍ إِلى الشِربِ إِكسالُها",2,"ل",3,0],["وَصَهباءَ طافَ يَهودِيُّها","وَأَبرَزَها وَعَلَيها خُتُم",3,"م",1,0],["وصهباءَ لها طوقٌ","شبيهُ اللؤلؤ الحَدر",4,"ر",1,0],["وَصَهباءَ مِن حانوتِ رَمّانَ قَد غَدا","عَلَيَّ وَلَم يَنظُر بِها الشَرقَ صابِحُ",5,"ح",1,0],["وَصُهبٌ لِحاهُم راكِزونَ رِماحَهُم","لَهُم دَرَقٌ تَحتَ العَوالي مُصَفَّفُ",6,"ف",1,0],["وَصَهوَةِ عَزمٍ قَد تَمَطَّيتُ وَالدُجى","مُكِبُّ كَأَنَّ الصُبحَ في صَدرِهِ سُرُّ",7,"ر",1,1],["وَصَهباءَ لا تُخفي القَذى وَهيَ دُونَهُ","تُصَفَّقُ في رَاوُوقِها ثُمَّ تُقطَبُ",8,"ب",1,0],["وصَهْبَاءَ يَسْتَوشي بِذِي اللُبِّ مِثْلُهَا","قَرَعْتُ بِهَا نَفْسي إِذَا الدِّيكُ أَعْتَمَا",9,"م",2,0],["وصهباء الرضاب شربت منها","كأن رضابها في الثغر لثم",10,"م",1,0],["وَصَهبْاءَ تَغْدو لِشُرّابِها","إذا ابْتَكروها مِن الهَمِّ جُنَّهْ",11,"ن",2,0],["وَصَهباءَ كَالمِصباحِ في كَفِّ شادِنٍ","رَقيقِ حَواشي الخَدِّ عَذبِ المَقبّلِ",12,"ل",1,0],["وصهيلُها كقصيفِ رعدٍ حاملٍ","بشرى الغيوثِ وبالصواعقِ منذِر",13,"ر",1,0],["وَصَهباءَ تَعمَلُ في الناظِرَينَ","شَرِبتُ عَلى الريقِ سَلسالَها",14,"ل",3,0],["وَصَهباءَ في المِعصار مِن عَصر آدمٍ","كَأَنَّ فُؤاد البَدر كانَ لَها دنّا",15,"ن",2,0],["وصهباءَ يسقيها مليحٌ تَلَذُّ لي","بأحوى غضيض الناظرين كحيل",16,"ل",1,0],["وصهباءَ رقَّتْ فاسترقَّتْ عُقُولَنا","عَلَى أَنَّها قد أَعْتَقَتْنَا مِنَ الهمِّ",17,"م",1,1],["وَصِهْرِ الرسُولِ وَمَن مِثْلُهُ","إذا كانَ يَوْمٌ يُشِيبُ الْقُرُونَا",18,"ن",2,0],["وَصَهباءَ مِنها كالسَّفينةِ نَضَّجَت","بِهِ الحَملَ حَتى زادَ شَهراً عَديدُها",19,"د",3,0],["وَصُهبٌ صَفايا قَد أَظَلَّ نِتاجُها","مَجاليحُ في عامِ الثُمامِ المُجَزَّلُ",20,"ل",1,0]]}