{"poems":[[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[28,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[74,"وصهوة عزم قد تمطيت والدجى","https://www.aldiwan.net/poem12922.html","الطويل"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[209,"وقالوا الخمر إثم قلت كلا","https://www.aldiwan.net/poem46225.html","الوافر"],[227,"أسرب مها عن أم سرب جنه","https://www.aldiwan.net/poem50754.html","المتقارب"],[230,"لا طيب من ذكري حبيب ومنزل","https://www.aldiwan.net/poem14828.html","الطويل"],[268,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[285,"وصهباء يستوشي بذي اللب مثلها","https://www.aldiwan.net/poem1909.html","الطويل"],[324,"سألت الديار وأطلالها","https://www.aldiwan.net/poem44248.html","المتقارب"],[351,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[413,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[573,"وصهباء رقت فاسترقت عقولنا","https://www.aldiwan.net/poem2731.html","الطويل"]],"verses":[["وصُهْبٌ ينُمُّ بأعْراقِها","إذا ما ابْتَذَلْنَ الخُطا أرْحَبُ",0,"ب",1,0],["وَصَهباءَ صِرفٍ كَلَونِ الفُصو","صِ باكَرتُ في الصُبحِ سَوّارَها",1,"ر",3,0],["وَصَهباءَ صِرفٍ كَلَونِ الفُصوصِ","سَريعٍ إِلى الشِربِ إِكسالُها",2,"ل",3,0],["وَصَهباءَ طافَ يَهودِيُّها","وَأَبرَزَها وَعَلَيها خُتُم",3,"م",1,0],["وصهباءَ لها طوقٌ","شبيهُ اللؤلؤ الحَدر",4,"ر",1,0],["وَصَهباءَ مِن حانوتِ رَمّانَ قَد غَدا","عَلَيَّ وَلَم يَنظُر بِها الشَرقَ صابِحُ",5,"ح",1,0],["وَصُهبٌ لِحاهُم راكِزونَ رِماحَهُم","لَهُم دَرَقٌ تَحتَ العَوالي مُصَفَّفُ",6,"ف",1,0],["وَصَهوَةِ عَزمٍ قَد تَمَطَّيتُ وَالدُجى","مُكِبُّ كَأَنَّ الصُبحَ في صَدرِهِ سُرُّ",7,"ر",1,1],["وَصَهباءَ لا تُخفي القَذى وَهيَ دُونَهُ","تُصَفَّقُ في رَاوُوقِها ثُمَّ تُقطَبُ",8,"ب",1,0],["وصهباء الرضاب شربت منها","كأن رضابها في الثغر لثم",9,"م",1,0],["وَصَهبْاءَ تَغْدو لِشُرّابِها","إذا ابْتَكروها مِن الهَمِّ جُنَّهْ",10,"ن",2,0],["وَصَهباءَ كَالمِصباحِ في كَفِّ شادِنٍ","رَقيقِ حَواشي الخَدِّ عَذبِ المَقبّلِ",11,"ل",1,0],["وصهيلُها كقصيفِ رعدٍ حاملٍ","بشرى الغيوثِ وبالصواعقِ منذِر",12,"ر",1,0],["وَصَهباءَ يَستَوشي بِذي اللَبِّ مِثلَها","قَرَعتُ بِها نَفسي إِذا الديكُ أَعتَما",13,"م",2,1],["وَصَهباءَ تَعمَلُ في الناظِرَينَ","شَرِبتُ عَلى الريقِ سَلسالَها",14,"ل",3,0],["وَصَهباءَ في المِعصار مِن عَصر آدمٍ","كَأَنَّ فُؤاد البَدر كانَ لَها دنّا",15,"ن",2,0],["وصهباءَ يسقيها مليحٌ تَلَذُّ لي","بأحوى غضيض الناظرين كحيل",16,"ل",1,0],["وصهباءَ رقَّتْ فاسترقَّتْ عُقُولَنا","عَلَى أَنَّها قد أَعْتَقَتْنَا مِنَ الهمِّ",17,"م",1,1]]}