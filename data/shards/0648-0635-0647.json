{"poems":[[65,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[53,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[40,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[30,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[76,"وصهوة عزم قد تمطيت والدجى","https://www.aldiwan.net/poem12922.html","الطويل"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62239","الطويل"],[215,"وقالوا الخمر إثم قلت كلا","https://www.aldiwan.net/poem46225.html","الوافر"],[234,"أسرب مها عن أم سرب جنه","https://www.aldiwan.net/poem50754.html","المتقارب"],[237,"لا طيب من ذكري حبيب ومنزل","https://www.aldiwan.net/poem14828.html","الطويل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[331,"سألت الديار وأطلالها","https://www.aldiwan.net/poem44248.html","المتقارب"],[358,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[422,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[580,"وصهباء رقت فاسترقت عقولنا","https://www.aldiwan.net/poem2731.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126769","المتقارب"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206045","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123402","الطويل"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67747","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67415","المتقارب"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76802","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21446","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74180","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74176","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22540","الطويل"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88962","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28743","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[5074,"الضَّيغم الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=153941",""],[5219,"سهم اللحاظ","https://www.poetsgate.com/ViewPoem.aspx?id=197682",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5431,"قبلت طفلي وانحنيت لأتبعه","https://www.poetsgate.com/ViewPoem.aspx?id=191111",""],[5431,"أعلنوه انسحابا ...","https://www.poetsgate.com/ViewPoem.aspx?id=212773",""],[5470,"كيف أمسى؟","https://www.poetsgate.com/ViewPoem.aspx?id=11008",""],[5829,"ولا تبقوا حصونا للهوان","https://www.poetsgate.com/ViewPoem.aspx?id=195343",""],[6075,"لَا تُخْفِ دَمْعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=201606",""],[6124,"سلام الله","https://www.poetsgate.com/ViewPoem.aspx?id=159580",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""]],"verses":[["وصُهْبٌ ينُمُّ بأعْراقِها","إذا ما ابْتَذَلْنَ الخُطا أرْحَبُ",0,"ب",1,0],["وَصَهباءَ صِرفٍ كَلَونِ الفُصو","صِ باكَرتُ في الصُبحِ سَوّارَها",1,"ر",3,0],["وَصَهباءَ صِرفٍ كَلَونِ الفُصوصِ","سَريعٍ إِلى الشِربِ إِكسالُها",2,"ل",3,0],["وَصَهباءَ طافَ يَهودِيُّها","وَأَبرَزَها وَعَلَيها خُتُم",3,"م",1,0],["وصهباءَ لها طوقٌ","شبيهُ اللؤلؤ الحَدر",4,"ر",1,0],["وَصَهباءَ مِن حانوتِ رَمّانَ قَد غَدا","عَلَيَّ وَلَم يَنظُر بِها الشَرقَ صابِحُ",5,"ح",1,0],["وَصُهبٌ لِحاهُم راكِزونَ رِماحَهُم","لَهُم دَرَقٌ تَحتَ العَوالي مُصَفَّفُ",6,"ف",1,0],["وَصَهوَةِ عَزمٍ قَد تَمَطَّيتُ وَالدُجى","مُكِبُّ كَأَنَّ الصُبحَ في صَدرِهِ سُرُّ",7,"ر",1,1],["وَصَهباءَ لا تُخفي القَذى وَهيَ دُونَهُ","تُصَفَّقُ في رَاوُوقِها ثُمَّ تُقطَبُ",8,"ب",1,0],["وصَهْبَاءَ يَسْتَوشي بِذِي اللُبِّ مِثْلُهَا","قَرَعْتُ بِهَا نَفْسي إِذَا الدِّيكُ أَعْتَمَا",9,"م",2,0],["وصهباء الرضاب شربت منها","كأن رضابها في الثغر لثم",10,"م",1,0],["وَصَهبْاءَ تَغْدو لِشُرّابِها","إذا ابْتَكروها مِن الهَمِّ جُنَّهْ",11,"ن",2,0],["وَصَهباءَ كَالمِصباحِ في كَفِّ شادِنٍ","رَقيقِ حَواشي الخَدِّ عَذبِ المَقبّلِ",12,"ل",1,0],["وصهيلُها كقصيفِ رعدٍ حاملٍ","بشرى الغيوثِ وبالصواعقِ منذِر",13,"ر",1,0],["وَصَهباءَ تَعمَلُ في الناظِرَينَ","شَرِبتُ عَلى الريقِ سَلسالَها",14,"ل",3,0],["وَصَهباءَ في المِعصار مِن عَصر آدمٍ","كَأَنَّ فُؤاد البَدر كانَ لَها دنّا",15,"ن",2,0],["وصهباءَ يسقيها مليحٌ تَلَذُّ لي","بأحوى غضيض الناظرين كحيل",16,"ل",1,0],["وصهباءَ رقَّتْ فاسترقَّتْ عُقُولَنا","عَلَى أَنَّها قد أَعْتَقَتْنَا مِنَ الهمِّ",17,"م",1,1],["وصهر الرسولِ وزوج البتول","أب المُجتبى البشير النذيرِ",18,"ر",1,0],["وصهباء من طول الكلال زجرتها","وقد جعلت عنها الأحزة تخنس",19,"س",1,1],["وَصَهْباء فاتت أن تُمَثَّلَ بالفَهمِ","أقولُ وقد رَقَّتْ عن اللَّحْظ والوهمِ",20,"م",1,1],["وَصَهْباءَ جُرْجَانِيَّة لمْ يَطُفْ بِهَا","حَنِيفٌ وَلَمْ تَنْغَرْ بِهَا سَاعَةً قِدْرُ",21,"ر",1,1],["وصهباء صِرف لامزاج لكأسِها","سِوى أَن يطلّ الطلّ فيها فيقطبا",22,"ب",2,0],["وَصِهْرِ الرسُولِ وَمَن مِثْلُهُ","إذا كانَ يَوْمٌ يُشِيبُ الْقُرُونَا",23,"ن",2,0],["وصهر النبي المجتبى وابن عمه","أبا الحسنين المحتوى كل سؤدد",24,"د",1,0],["وَصَهباءَ مِنها كالسَّفينةِ نَضَّجَت","بِهِ الحَملَ حَتى زادَ شَهراً عَديدُها",25,"د",3,0],["وَصه عذولي لَستُ أَول ناصح","خَفض عَليك وَخَلني وَبَلائي",26,"ي",1,0],["وَصهره الضَيغم الكرار مِن فَلقت","بِسَيفه هامة الاشراك وَانكسرا",27,"ر",2,0],["وَصهر رَسول اللَه أَكرَم مُرسل","وَزَوج البتول الطهر فاطمة الزَهرا",28,"ر",2,0],["وَصُهبٌ صَفايا قَد أَظَلَّ نِتاجُها","مَجاليحُ في عامِ الثُمامِ المُجَزَّلُ",29,"ل",1,0],["وصهره المجدُ، هو الأخميمي","المرتَضى، ذو المنهج القويم",30,"م",1,0],["وصهر جاه مليك الخير أيّ بها","كمثل أفراح بدر نجل إعلاء",31,"ا",2,0],["وَصُهِرَ الجَوُّ بِبَرقٍ ساهِرٍ","على الصُهيريجِ المُنيرِ المُجتَلى",32,"ا",1,0],["وَصَهباءَ كَرخِيَّةٍ عُتِّقَت","فَطالَت بِها في الدِّنانِ الطِّيلْ",33,"ل",1,1],["وصهيلُ الجياد عاد عويلا","والمواضي خانت بكل ذراع",34,"ع",1,0],["وَ صهيلُ الأحزانِ في كلِّ رُكْنٍ","وَ عَويلٌ مُفَجَّعٌ وَ بُكَاءُ",35,"ا",2,0],["وصهباء خمر قد أدار شرابها","وكأس المنايا في اليمين بكفه",36,"ف",2,0],["وصُهَيْبٌ وخالدٌ وسعيدٌ","وعليٌّ والصفوةُ الأطهارُ",37,"ر",1,0],["وصهرت من جمرات شوقي قلبه","ونثرت قمحا في الدماء ليزرعه",38,"ع",2,0],["وصهيلٍ يسابق البرق عدوا","يخرق الحسّ مسرعا وثّابا",39,"ب",2,0],["وَصَهِيلٌ يَضِجُّ بَينَ الحَنَايَا","ونَشِيجٌ كَحَشْرَجَاتِ الرَّبَابَهْ",40,"ب",2,0],["وصهيون تربع في حمانا","وإسرائيل صاحبة الزمان",41,"ن",1,0],["وَصَهِيلُ ذِكْرَانَا عَلَا","وَرَبِيعُ لُقْيَانَا دَنَا",42,"ن",2,0],["وصهدُ الشوقِ عشناهُ","بجمرِ القبلةِ الأولى.",43,"ل",2,0],["وصَهيلهُ العالي بكلِّ قصيدةٍ","يَعلو وقدْ جرَّ المسيرَ بِسلسِلَةْ",44,"ل",2,0]]}