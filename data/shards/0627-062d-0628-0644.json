{"poems":[[65,"هي الجرعاء صادية رباها","https://www.aldiwan.net/poem45792.html","الوافر"],[57,"رأيتك يدنيني إليك تباعدي","https://www.aldiwan.net/poem26452.html","الطويل"],[79,"أحب لحبها جملي ورحلي","https://www.aldiwan.net/poem35892.html","الوافر"],[29,"عشية أعلى مذنب الجوف قادني","https://www.aldiwan.net/poem5953.html","الطويل"],[91,"احبل الليل نهار","https://www.aldiwan.net/poem44680.html","مجزوء الرمل"],[71,"أحب لوجنتيه الجمرتين","https://www.aldiwan.net/poem28936.html","الوافر"],[33,"أحب لحب عبلة كل صهر","https://www.aldiwan.net/poem42213.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[119,"أحب لحبها السودان حتى","https://www.aldiwan.net/poem41705.html","الوافر"],[128,"أفي كل يوم أنت مضنى مروع","https://www.aldiwan.net/poem23779.html","الطويل"],[139,"أحب لغلة الظمآن يوما","https://www.aldiwan.net/poem48978.html","الوافر"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[193,"أحب لي من كل من فوق الثرى","https://www.aldiwan.net/poem35143.html","الرجز"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[237,"كذا من حاز في الحسن الكمالا","https://www.aldiwan.net/poem14751.html","الوافر"],[302,"لقد آن أن تثني أبي زمامها","https://www.aldiwan.net/poem33176.html","الطويل"],[309,"هدى الله معشوق الجمال إلى الهدى","https://www.aldiwan.net/poem16883.html","الطويل"],[310,"كل انتظام آيل لانصرام","https://www.aldiwan.net/poem56395.html","السريع"],[427,"أحب لقا الأحباب في كل ساعة","https://www.aldiwan.net/poem46395.html","الطويل"],[438,"وأبغضت فيك النخل والنخل يانع","https://www.aldiwan.net/poem12426.html","الطويل"],[463,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[505,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48865","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64071","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145976","مجزوء الخفيف"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33104","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117446","المواليا"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87839","البسيط"],[2184,"","https://poetry.dctabudhabi.ae/diwan/poem/104208","السريع"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140236",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60946","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65969","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200026","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100716","الطويل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138736",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52203","المتقارب"],[4691,"تبارك قلبي حين تصفو منابعه","https://www.poetsgate.com/ViewPoem.aspx?id=211312",""],[5409,"حياةُ الربيع وعصر الباب","https://www.poetsgate.com/ViewPoem.aspx?id=155499",""],[5538,"ترفع عن وضيع النفس تسلم","https://www.poetsgate.com/ViewPoem.aspx?id=142622",""],[5956,"سرُ ليلي وإعراضي","https://www.poetsgate.com/ViewPoem.aspx?id=182306",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[463,"سقى دارها بالرَّقمتينوحيَّاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60276&r=&rc=332",""]],"verses":[["أُحِبُّ لِحُبِّها تَلَعاتِ نَجدٍ","وَما شَغَفي بِها لَولا هَواها",0,"ا",3,0],["أَحَبُّ لِنَفسي مِن فِراقٍ عَلى قِلاً","وَقَد فاتَني مِن وُدِّكُم كُلُّ مَطلَبِ",1,"ب",1,0],["أحبُّ لحُبِّها جَمَلي ورحْلِي","وعزْمي والقَتادَةَ والطّريقَا",2,"ق",2,1],["أُحِبُّ لِحُبِّ العاصِمِيَّةِ مَعشَراً","مِنَ الناسِ ما كانوا صَديقاً وَلا أَهلا",3,"ل",2,0],["احبل الليل نهار","قد نزا ثم تولى",4,"ل",2,1],["أحبُّ لوجنتيهِ الجمرتين","وهمتُ لثغرِهِ بالأبرقينِ",5,"ن",1,1],["أُحِبُّ لِحُبِّ عَبلَةَ كُلَّ صِهرٍ","عَلِمتُ بِهِ لِعَبلَةَ أَو صَديقِ",6,"ق",1,1],["أُحِبُّ لُقياهُ وَالبُقيا لأَندُبَهُ","فَيا شعوبُ اِعجِلي إِن شِئتِ أَو رِيثي",7,"ث",2,0],["أحب لحبها السودان حتى","لها اسوديت لهفاً في ثيابي",8,"ي",1,1],["أحب لسمعي من تغاريد آلة","لغير بلادي يا أخا العرب تصنع",9,"ع",1,0],["أحب لغُلّة الظمآنِ يوماً","مسيل الماء من سيلِ النضارِ",10,"ر",1,1],["أُحبُّ له الخلخالَ لكنْ مُقيِّداً","ورِفْعتَهُ أختارُ لكن من الصّلْبِ",11,"ب",1,0],["أحبُّ لي من كلِّ من فوقَ الثرى","عربُ النقا روحي فدا عربِ النقا",12,"ا",1,1],["أُحبّ لأجلِ ذاتِ النخلِ نخلاً","بِها وحِجارةً فيها ورملا",13,"ل",2,0],["أُحِبُّ لِقَدِّهِ السُمرَ العَوالي","وَأَعشَقُ مِن تَلَفُّتِهِ الغَزالا",14,"ل",2,0],["أُحِبُّ لريّا نَشرها كلَّ نفحةٍ","تَمرُّ بنَجدٍ أَو خُزامى خزامِها",15,"م",3,0],["أحب لها دمون والنجد والربى","وظبية والشعب الذي نوره بدا",16,"د",2,0],["أَحبّ لُقياهُ فتاريخهُ","محمّدٌ أحبّ فوزَ الخِتام",17,"م",1,0],["أحب لقا الأحباب في كل ساعةٍ","لأن لقا الأحباب فيه المنافعُ",18,"ع",1,1],["أُحِبّ لِجَرَّاكِ السماوَةَ والغَضَا","ولو أَنَّ صِنْفَيْهِ وُشاةٌ وعُذَّالُ",19,"ل",1,0],["أحبُّ لظيماءَ العدا من قبيلها","وأهوى ترابَ الأرض ما كنتُ أهواها",20,"ا",3,0],["أحب ليلي طارحاً لوامها","وقاطعاً في حبها عذالها",21,"ل",3,0],["أحب لغيري أن خطبي عزاؤه","ولا أن أرى في خطب غيريْ عزائيا",22,"ي",2,0],["أُحبُّ لحبِّيهِ الربيعَ لأنه","بِخَدَّيْهِ يبدو وَرْدُهُ وشقائقُه",23,"ق",2,0],["أحبُلاً والأسى سَكَنُ","في زوايا ظَلامِهَا",24,"ه",2,0],["أُحِبُّ لَكُم قَيسَ بنَ عَيلانَ كُلُّها","وَيُعجِبُني فُرسانُها وَرِجالُها",25,"ل",3,0],["أحب لما كمل حسنه وجازَ حدّه","صار اهتزاز القنا شُوقه إلى قدَّه",26,"ه",1,1],["أُحِبُّ لِلحُبِّ لا أَبغي بِهِ غَرَضاً","لَو كانَ يَرحَمُ أَحشائي وَأَجفاني",27,"ن",2,0],["أحب للَه بأن أن تكون","تلاوة القرآن عند الصباح",28,"ح",1,0],["أحب لهم فخر الوفاء مرؤة","ومن لي بأن يرضوا بذلك مفخرا",29,"ر",2,0],["أحبُّ لها أن لا تزالُ صحيحةً","وتهوى بجسمي أنْ يكونَ عليلا",30,"ل",2,0],["أحب لاخواني بأن لا أرى الفتى","خلا منهم إلا لدى الطعن والقطف",31,"ف",1,0],["أحبّ للشاعر من فنه","وجدي به وجْد أبٍ بانبه",32,"ن",3,0],["أحب لقومي كل خير ونعمة","وأرجو لهم أسمى الذي يُتطلب",33,"ب",1,0],["أحب لأجلهم خفقان قلبي","وأهوى في محبتهم سهادي",34,"د",2,0],["أحب لرفع الملك تمزيق دينه","فاضرم نيران الفسوق وأوقدا",35,"د",2,0],["أُحِبُّ لوجه ابنِ سامي الصباحَ","وأهوى لنضرته الياسمينْ",36,"ن",1,1],["أحب لماهُ ليتني كنت قطرة","تحطّ على وجه غزيرٌ بدائعُه",37,"ع",2,0],["أحب لحبك هذا الربيع","ولولاك ما مر في باليه",38,"ه",1,0],["أحب له القدم قبل نفسي","أنشطه إذا في السعي أحجم",39,"م",1,0],["أحب لقاءها صبحاً لأنِّي","كعصفور تنوّمهُ (اللَيالُ)",40,"ل",1,0],["أحب لُجَينَ البحارِ المُسالْ","كما البدر سال بعمق الليالْ",41,"ل",1,0],["أحب لدى الرَّدَى تحنو عَليّا","يدُ النُّبلاءِ.. كالعُظمَا أُحَيَّى",42,"ي",2,1],["أحِبُّ لكل إنسانٍ مثيلي","يفوز بصحةٍ فوق الخيالِ",43,"ل",1,0],["أحبُّ لظمياءَ العدا من قبيلها","وأهوى ترابَ الأرض ما كنتُ أهواها",44,"ا",3,0]]}