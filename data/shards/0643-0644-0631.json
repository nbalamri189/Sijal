{"poems":[[55,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[72,"وثقيل إذا بدا","https://www.aldiwan.net/poem42441.html","مجزوء الخفيف"],[87,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[87,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[51,"كل رزق أرجوه من مخلوق","https://www.aldiwan.net/poem62192.html","الخفيف"],[82,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[50,"قد كان لي حمدان ذا زورة","https://www.aldiwan.net/poem64453.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[47,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[189,"ورؤوس جاءت بكل رئيس","https://www.aldiwan.net/poem14556.html","الخفيف"],[203,"فتكت في الناس أعينها","https://www.aldiwan.net/poem45234.html","المديد"],[257,"عاتباه في فرط ظلمي وهجري","https://www.aldiwan.net/poem1426.html",""],[310,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[369,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[449,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[463,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[463,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[563,"نورطه المصطفى منه جيمع الكائنات","https://www.aldiwan.net/poem34720.html","الرمل"],[627,"","https://poetry.dctabudhabi.ae/diwan/poem/146123","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96971","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63953","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99983","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59746","الخفيف"],[1089,"","https://poetry.dctabudhabi.ae/diwan/poem/105162","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113943","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[1947,"","https://poetry.dctabudhabi.ae/diwan/poem/178105","الخفيف"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105652","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130768","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132543","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100794","الخفيف"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142937","الخفيف"],[3192,"","https://poetry.dctabudhabi.ae/diwan/poem/125328","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26954","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205536","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117843","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36790","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81284","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73124","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120354","الكامل"],[5010,"ربي الله","https://www.poetsgate.com/ViewPoem.aspx?id=191132",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5358,"يمن أنت يا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=206165",""],[5409,"يا لها من فلتةٍ مبكيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155299",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5431,"بغداد ...","https://www.poetsgate.com/ViewPoem.aspx?id=208510",""],[5453,"الجمايل","https://www.poetsgate.com/ViewPoem.aspx?id=28020",""],[5461,"نادميني","https://www.poetsgate.com/ViewPoem.aspx?id=1312",""],[5848,"خجلك","https://www.poetsgate.com/ViewPoem.aspx?id=50600",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[6115,"يسلمون اللى تعنوا في لزومي","https://www.poetsgate.com/ViewPoem.aspx?id=196472",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""],[6268,"عَدُّودَةُ الخُروج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82921&r=&rc=7",""],[6302,"النَّايُ الْ.. حَكَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86225&r=&rc=23",""]],"verses":[["كُلُّ راقٍ مَرَّ بِالنَجمِ إِلى","قُنَنِ السُؤدَدِ وَالمَجدِ الطَوالِ",0,"ل",1,0],["كُلُّ رَملٍ بِعالِجٍ","لا تَرى فيهِ وَزنَهُ",1,"ن",2,0],["كل ركن كل زاوية","هيكل يهفو على وثن",2,"ن",1,0],["كُلُّ رَسمٍ مِن مَنزِلٍ أَو حَبيبٍ","سَوفَ يَمشي البِلى عَلَيهِ مُحيلا",3,"ل",2,0],["كُلُّ رَوحانَةٍ بِلَحنٍ كَعُرسٍ","أُلِّفَت لِلغِناءِ شَتّى قِيانِه",4,"ن",2,0],["كُلٌّ رَمَتهُ النَوى ريشَ الفِراقُ لَنا","سَهماً وَسُلَّ عَلَيكَ البَينُ سِكّينا",5,"ن",2,0],["كُلٌّ رِضاً وَأَرى ثَلاثَتَهُم كَفَوا","قَسرَ المُمانِعِ وَاِفتِتاحِ المُغلَقِ",6,"ق",1,0],["كُلُّ رَكّاضَةٍ مِنَ البُردِ يَغدو ال","ريشُ أَولى بِها مِنَ العُنوانِ",7,"ن",1,0],["كلُّ ريمٍ يَشفي إذا رُمتَ منه ال","وَصْلَ حَرَّ الهوى ببَرْدِ الرُّضابِ",8,"ب",1,0],["كُلُّ رِزقٍ أَرجوهُ مِن مَخلوقِ","يَعتَريهِ ضَربٌ مِنَ التَعويقِ",9,"ق",1,1],["كُلُّ راسي الحلم حامٍ مُلْكَهُ","عادلِ السيرةِ وافٍ بالعُهود",10,"د",1,0],["كُلُّ رَيّانٍ إِلى ظَمَإٍ","كُلُّ وِجدانٍ إِلى عَدَمِ",11,"م",1,0],["كلُّ رِجْسٍ يَزِيدُه الخُلُقُ السُّو","ءُ سِفاهاً والمِلَّةُ العَوْجاءُ",12,"ا",2,0],["كلُّ رَقراقِ الحَواشي فوقَهُمْ","كعيونٍ من أفاعٍ أو جَراد",13,"د",1,0],["كُلُّ رَغيفٍ ناصِعٍ لَونُهُ","مِن سابِرِيِّ الخُبزِ بَرّاقِ",14,"ق",1,0],["كلُّ روح بهُدىً من حُبّها","كلُّ قلبٍ بشعاعٍ من غرامِ",15,"م",1,0],["كُلَّ رَأْيٍ يَقِرُّهُ","لَيْسَ فِي غبِّهِ أَسِفْ",16,"ف",1,0],["كُلُّ رَيْعٍ وَكُلُّ نَجْعٍ جَنُوباً","وَشِمَالاً بِذَلِكَ الفَضْلِ يَشْهَدْ",17,"د",1,0],["كُلُّ رَسْمٍ قد وعَى نادِرَةً","لو جَرى النُطْقُ عليه لحَكَاها",18,"ا",3,0],["كلٌّ رَضِي، وَأرَى ثَلاثَتهم كُفوا","قَسْرَ المُمانِعِ، وَافتِتاحَ المُغلَقِ",19,"ق",1,0],["كلّ روض في الشرق من","دم آبائي مندّى معطّر مطلول",20,"ل",1,0],["كلُّ رأسٍ في طَيْلَسانٍ رُقاق","دقّ عما يُحاك في تِنِّيس",21,"س",1,0],["كلُّ رجلٍ في تنقلها","تحتها قلبٌ يُقَلبها",22,"ب",3,0],["كُلُّ رَدفٍ مِثلُ الكَثيبِ مِن","الرَملِ مَهيل يَميسُ زَهواً",23,"ه",3,0],["كلُّ رأسٍ وَفؤادٍ في اِختِفاق","حينَ يُجلى سرُّها في الخافقين",24,"ن",1,0],["كلٌّ رأي نفْسَه في عَيْنِ صاحبه","فالحُسْنُ أَضحكَه والحُزْنُ أَبكاني",25,"ن",2,0],["كلٌّ رأى كَسْبَ الثّراء غنيمةً","فأَبتْ يداه غير كَسْبِ ثنَاء",26,"ا",2,0],["كلٌّ رَفَعتَ صدورَهُنَّ لغارَةٍ","مَا إِنْ لَهَا قبلَ الصُّدورِ مُغارُ",27,"ر",1,0],["كل روض حكى بساطا انيقا","احكمت وشيه صناع القيان",28,"ن",1,0],["كلُّ رِخو الإزار حتى إذا سا","ر طوَى شَملةً وقلَّص رُدْنا",29,"ن",2,0],["كلّ ركّاضةٍ بذكرك في الأر","ض على ألسن الرواة الدُّلْعِ",30,"ع",1,0],["كلُّ ركوبٍ رأسَها إلى المدى","لم تزجُر الطيرَ ولمَّا تستشِرْ",31,"ر",1,0],["كلّ رَبوضٍ عُنْقُها بارزٌ","مثلُ سَنام الجَملِ الأنصبِ",32,"ب",1,0],["كل روعاءَ لو تقلَّدها الفا","رسُ أغنت عن مرهفٍ قِرْضابِ",33,"ب",1,0],["كل روح هي من نورسناه ظهرت","كل جسم هو منه ظاهر بالحركات",34,"ت",1,0],["كل رئيسٍ به ملالٌ","وكل رأسٍ به صداع",35,"ع",1,0],["كل راي ضر أيوب فما ركضت","رجل له غير حوض الكوثر العذب",36,"ب",1,0],["كلُّ ركنٍ إلى انقضاضٍ وركني","أبداً غيرُ مُؤذن بانقضاض",37,"ض",1,0],["كلُّ رزقٍ يهونُ عند ذوي الل","بِّ إذا لم يُرَزَّأ المرءُ عِرضَه",38,"ض",2,0],["كُلُّ رَهْنٍ فِي سُؤْدَدٍ أَغْلَقُوهُ","فَلَهُ السَّبْقُ فِيهِ وَالتَّسْلِيمُ",39,"م",1,0],["كلُّ رحمى وكل عطف فمنهم","فليجيروا من خَطب هذا الفراق",40,"ق",1,0],["كل رواق العز مد على الورى","والخلق تحت رواقه الممدود",41,"د",1,0],["كُلُّ رَقودِ الضحى مخبّأة","لَم تُبدِ في أَهلِها محاجرها",42,"ر",3,0],["كُلُّ رهنٍ لهُ فكاكٌ ولكِن","ما لِرَهنٍ لدى أُمَيمَةَ فادِ",43,"د",1,0],["كلُّ رخوِ الملاطِ يهوي بعَينا","ءِ رداحٍ من الهجانِ الخدالِ",44,"ل",1,0],["كلُّ رَحْبِ الذِّراعِ في مُلْتَقَى","الضَيقِ وَرَحْبِ الجَنَانِ رَحْبِ المجال",45,"ل",1,0],["كُلّ رِجلٍ فَارَقَتْ مَركَزَهُ","خُبِطَتْ مِنْ حِينِهَا في كَبَلِ",46,"ل",1,0],["كل ريمٍ يعطو فيصطاد ليثاً","عند ليثٍ يسطو فيصطاد ريما",47,"م",2,0],["كل روض بالشام منك عليه","عبق فائح على الأكمام",48,"م",1,0],["كل رصعاء بحتراتٍ شريم","فهي رسحاءُ وهي كالضهياء",49,"ا",2,0],["كل ريم ساجي الجفون غزير","ومهاة نشوى اللحاظ لعوب",50,"ب",1,0],["كل ربع فيه من صنع الربيع","حلل تزرى بصنعاء اليمن",51,"ن",1,0],["كل ركب سعى اليك مشوقا","وطوى الارض بين حزن ومعلم",52,"م",1,0],["كل ركن في أرض بلقيس أمسى","وبه قاتل وفيه قتيلُ",53,"ل",1,0],["كل رغيف اهله تسعة","كأنما صلى عليه المسيح",54,"ح",1,0],["كلّ ركن واهٍ إِذا قيل فينا","غير سعدٍ يشيّد الأَركانا",55,"ن",2,0],["كُلِّ رَداحِ الرَدفِ خُمصانَةٍ","كَالمُهرَةِ الضامِرِ لَم تُركَبِ",56,"ب",1,0],["كل راجٍ يلقي عليك مُناه","فإذا خاب كُنتَ أنت الملُوما",57,"م",2,0],["كل راء سامع والاهم","ولوى الرأس الأصم الأرمد",58,"د",1,0],["كُلُّ رودٍ أُلبِسَت شَرخَ الصِبا","وَكَساها الحُسنُ ديباجاً بَديعا",59,"ع",2,0],["كُلِّ رِجلٍ بِسناها اِشتَعلا","وَاِنبَرَت تَبرُزُ مِن طَيِّ الحِجاب",60,"ب",1,0],["كُل رَكب مِنها رَسول مِن القَل","ب المَعنّى إِلى المَلاك الممنع",61,"ع",1,0],["كلُّ ربعٍ ليسَ يُقضَى وَطرٌ","فيهِ ما ذلِكَ عندي وَطَنُ",62,"ن",1,0],["كل روى عن فضله","وبمدحه كل يساجل",63,"ل",1,0],["كُلُّ رِزْقٍ قَدْ قَضَاهُ اللَّهُ لِيْ","كَائِنٌ لَوْ كَانَ فِيْ فَكِّ أَسَدْ",64,"د",1,0],["كُلُّ رِعْشٍ فِي رُبُوعِي","شَعَّ لأْلاءً وَتِبْرَا",65,"ر",2,0],["كُلُّ رَعْشٍ فِي خُشُوعِي","زَاحَ أَحْزَاناً وَخَشْرَا",65,"ر",2,0],["كلُّ روحٍ رهينةٌ","حيثُ كانتْ على البَدَنْ",66,"ن",1,0],["كل راضٍ منكم عن آثمٍ","فهو في آثامه يشترك",67,"ك",1,0],["كلّ رسمٍ يذيعه راح يحكي","عن هروب مخلّع البرواز",68,"ز",1,0],["كلّ ربحٍ بلا ثراها افتراء","وخواءٌ من الرؤى وخنوع",69,"ع",1,0],["كل رجل (ن) بالمجالس... مانزح عن مقعدا","مانزح غير الضعيف... ولا نزح غير الكريم",70,"م",1,1],["كل رجل(ن) يستره قل الكلام","واللسان يجمّله والاّ يعيب",71,"ب",1,0],["كل ريحٍ تزمجر تفتح الفين باب","ضعت ما بينهن مدري وش اللي أبيه",72,"ي",2,0],["كل رأي غيرُ رأيي","ليس في رأييَ صائبْ",73,"ب",1,0],["كل رجالٍ مقدّر ومحشومي","فاله التقدير من سمن وسماني",74,"ن",2,0],["كلُّ روضٍ في حماكِ","كانَ رمزاً للسقامِ",75,"م",1,0],["كل رأسٍ تراه حولك غاو","والذي لا تراه يقبل أغوى",76,"و",2,0],[".. كلُّ روحٍ غُرِّبتْ واللهِ مَا..",".. كنتُ إلاَّ نَزْفَها.. النَّايَ الْ..حَكَى",77,"ك",2,0]]}