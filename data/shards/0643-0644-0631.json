{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[70,"وثقيل إذا بدا","https://www.aldiwan.net/poem42441.html","مجزوء الخفيف"],[85,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[49,"كل رزق أرجوه من مخلوق","https://www.aldiwan.net/poem62192.html","الخفيف"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"قد كان لي حمدان ذا زورة","https://www.aldiwan.net/poem64453.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[45,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[183,"ورؤوس جاءت بكل رئيس","https://www.aldiwan.net/poem14556.html","الخفيف"],[197,"فتكت في الناس أعينها","https://www.aldiwan.net/poem45234.html","المديد"],[250,"عاتباه في فرط ظلمي وهجري","https://www.aldiwan.net/poem1426.html",""],[303,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[362,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[362,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[436,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[441,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[456,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[456,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[459,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[556,"نورطه المصطفى منه جيمع الكائنات","https://www.aldiwan.net/poem34720.html","الرمل"]],"verses":[["كُلُّ راقٍ مَرَّ بِالنَجمِ إِلى","قُنَنِ السُؤدَدِ وَالمَجدِ الطَوالِ",0,"ل",1,0],["كُلُّ رَملٍ بِعالِجٍ","لا تَرى فيهِ وَزنَهُ",1,"ن",2,0],["كل ركن كل زاوية","هيكل يهفو على وثن",2,"ن",1,0],["كُلُّ رَسمٍ مِن مَنزِلٍ أَو حَبيبٍ","سَوفَ يَمشي البِلى عَلَيهِ مُحيلا",3,"ل",2,0],["كُلُّ رَوحانَةٍ بِلَحنٍ كَعُرسٍ","أُلِّفَت لِلغِناءِ شَتّى قِيانِه",4,"ن",2,0],["كُلٌّ رَمَتهُ النَوى ريشَ الفِراقُ لَنا","سَهماً وَسُلَّ عَلَيكَ البَينُ سِكّينا",5,"ن",2,0],["كُلٌّ رِضاً وَأَرى ثَلاثَتَهُم كَفَوا","قَسرَ المُمانِعِ وَاِفتِتاحِ المُغلَقِ",6,"ق",1,0],["كُلُّ رَكّاضَةٍ مِنَ البُردِ يَغدو ال","ريشُ أَولى بِها مِنَ العُنوانِ",7,"ن",1,0],["كلُّ ريمٍ يَشفي إذا رُمتَ منه ال","وَصْلَ حَرَّ الهوى ببَرْدِ الرُّضابِ",8,"ب",1,0],["كُلُّ رِزقٍ أَرجوهُ مِن مَخلوقِ","يَعتَريهِ ضَربٌ مِنَ التَعويقِ",9,"ق",1,1],["كُلُّ راسي الحلم حامٍ مُلْكَهُ","عادلِ السيرةِ وافٍ بالعُهود",10,"د",1,0],["كُلُّ رَيّانٍ إِلى ظَمَإٍ","كُلُّ وِجدانٍ إِلى عَدَمِ",11,"م",1,0],["كلُّ رِجْسٍ يَزِيدُه الخُلُقُ السُّو","ءُ سِفاهاً والمِلَّةُ العَوْجاءُ",12,"ا",2,0],["كلُّ رَقراقِ الحَواشي فوقَهُمْ","كعيونٍ من أفاعٍ أو جَراد",13,"د",1,0],["كُلُّ رَغيفٍ ناصِعٍ لَونُهُ","مِن سابِرِيِّ الخُبزِ بَرّاقِ",14,"ق",1,0],["كلُّ روح بهُدىً من حُبّها","كلُّ قلبٍ بشعاعٍ من غرامِ",15,"م",1,0],["كُلَّ رَأْيٍ يَقِرُّهُ","لَيْسَ فِي غبِّهِ أَسِفْ",16,"ف",1,0],["كُلُّ رَيْعٍ وَكُلُّ نَجْعٍ جَنُوباً","وَشِمَالاً بِذَلِكَ الفَضْلِ يَشْهَدْ",17,"د",1,0],["كُلُّ رَسْمٍ قد وعَى نادِرَةً","لو جَرى النُطْقُ عليه لحَكَاها",18,"ا",3,0],["كلٌّ رَضِي، وَأرَى ثَلاثَتهم كُفوا","قَسْرَ المُمانِعِ، وَافتِتاحَ المُغلَقِ",19,"ق",1,0],["كلُّ رأسٍ في طَيْلَسانٍ رُقاق","دقّ عما يُحاك في تِنِّيس",20,"س",1,0],["كلُّ رجلٍ في تنقلها","تحتها قلبٌ يُقَلبها",21,"ب",3,0],["كُلُّ رَدفٍ مِثلُ الكَثيبِ مِن","الرَملِ مَهيل يَميسُ زَهواً",22,"ه",3,0],["كلُّ رأسٍ وَفؤادٍ في اِختِفاق","حينَ يُجلى سرُّها في الخافقين",23,"ن",1,0],["كلٌّ رأي نفْسَه في عَيْنِ صاحبه","فالحُسْنُ أَضحكَه والحُزْنُ أَبكاني",24,"ن",2,0],["كلٌّ رأى كَسْبَ الثّراء غنيمةً","فأَبتْ يداه غير كَسْبِ ثنَاء",25,"ا",2,0],["كلٌّ رَفَعتَ صدورَهُنَّ لغارَةٍ","مَا إِنْ لَهَا قبلَ الصُّدورِ مُغارُ",26,"ر",1,0],["كل روض حكى بساطا انيقا","احكمت وشيه صناع القيان",27,"ن",1,0],["كلُّ رِخو الإزار حتى إذا سا","ر طوَى شَملةً وقلَّص رُدْنا",28,"ن",2,0],["كلّ ركّاضةٍ بذكرك في الأر","ض على ألسن الرواة الدُّلْعِ",29,"ع",1,0],["كلُّ ركوبٍ رأسَها إلى المدى","لم تزجُر الطيرَ ولمَّا تستشِرْ",30,"ر",1,0],["كلّ رَبوضٍ عُنْقُها بارزٌ","مثلُ سَنام الجَملِ الأنصبِ",31,"ب",1,0],["كل روعاءَ لو تقلَّدها الفا","رسُ أغنت عن مرهفٍ قِرْضابِ",32,"ب",1,0],["كل روح هي من نورسناه ظهرت","كل جسم هو منه ظاهر بالحركات",33,"ت",1,0]]}