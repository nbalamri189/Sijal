oetry.dctabudhabi.ae/diwan/poem/83171","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77693","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139630",""],[4729,"دَعْ الغَضَى لنَهْجه المسلوكِ","https://www.poetsgate.com/ViewPoem.aspx?id=109464",""],[4729,"للهِ أخلاقُ مطبوعٍ على كَرم","https://www.poetsgate.com/ViewPoem.aspx?id=109471",""],[4771,"سَمتُ بنَفسي غَداةَ الرَّحيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=106592",""],[4778,"عيون الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=188204",""],[4778,"سنن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=208698",""],[4935,"سمت بنات الفكر في كمالها","https://www.poetsgate.com/ViewPoem.aspx?id=129468",""],[4119,"هو السيف لا يغنيك إلا جلاده","https://www.poetsgate.com/ViewPoem.aspx?id=16111",""],[5055,"ساحة الأخوان","https://www.poetsgate.com/ViewPoem.aspx?id=101653",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5186,"يا تراما، كيفما سار ترامى","https://www.poetsgate.com/ViewPoem.aspx?id=156528",""],[5195,"وجاريات تجول","https://www.poetsgate.com/ViewPoem.aspx?id=186950",""],[5277,"الطهور","https://www.poetsgate.com/ViewPoem.aspx?id=205000",""],[5277,"بغدادُ ..أمي وأبي","https://www.poetsgate.com/ViewPoem.aspx?id=206965",""],[5310,"مِدَادُ الْقَلْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=211267",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5398,"شباب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=37156",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[520,"فؤاد يجم الشوق والوجد يحرق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577588",""],[147,"لاَ زِلْتَ تَعْلُو وَإِنْ حُسَّادُكَ اكْتَأَبُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27443&r=&rc=10",""]],"verses":[["سَمَّت وَليدَتَها فَوزاً مُغايَظَةً","عَذَرتُ لَو لَطَمَتني ذاتُ إِسوارِ",0,"ر",1,0],["سمَتْ منْكَ أعْناقُ الوَرى لخَليفَةٍ","لهُ في مَجالِ السّعْدِ وخْدٌ وإعْناقُ",1,"ق",1,0],["سَمَتْ نَحْوَ أَبْوَابِ السَّمَاءِ فَلَمْ تُرَعْ","بِتَشْغِيبِ بَوَّاب وَلاَ إِذْنِ حَاجِبِ",2,"ب",1,0],["سَمَتْ بِهِ عَنْ مَوْقِفٍ عِزّةُ","تَخْرُجُ بِالَأرْشَدِ عَنْ رُشْدِهِ",3,"د",2,0],["سُمتُ المَديحَ رِجالاً دونَ قِدرِهِمُ","صَدٌّ قَبيحٌ وَلَفظٌ لَيسَ بِالحَسَنِ",4,"ن",1,1],["سَمَت لي نَظرَةٌ فَرَأَيتُ بَرقاً","تِهامِيّاً فَراجَعَني اِدِّكاري",5,"ر",2,1],["سَمَت بِكَ خَيرُ الوَلِداتِ فَقابَلَت","لِلَيلَةِ بَدرٍ كانَ ميقاتُها قَدرا",6,"ر",2,0],["سَمَت بِيَ مِن شَيبانَ أُمٌّ نَزيعَةٌ","كَذالِكَ ضَربُ المُنجِباتِ النَزائِعِ",7,"ع",1,0],["سَمَت لَكَ مِنها حاجَةٌ بَينَ ثَهمَدٍ","وَمِذعى وَأَعناقُ المَطِيِّ خَواضِعُ",8,"ع",1,0],["سَمَت بِنا وائِلٌ وَفازَت","بِالعِزِّ أَخوالُنا تَميمُ",9,"م",1,0],["سَمَت هاشِمٌ لِلمَكرُماتِ وَلِلعُلى","وَغودِرتَ في كَأبٍ مِنَ اللُؤمِ جاثِما",10,"م",2,0],["سمت نحوه الأنظار حتَّى كأنها","بناريه من هنّا وهنّ صوالي",11,"ل",2,0],["سمَّتك يا عمرو عمراً وهي ظالمةٌ","رِمامُ سوءٍ وقد أودى بها العَفر",12,"ر",1,0],["سُمتني السلم والهجاءُ خليعٌ","جامحُ الغرب والقوافي عواصِي",13,"ص",2,0],["سمت بجدودهم رتبةٌ","جدودُ الملوك لها تصطرع",14,"ع",1,0],["سمتني الخسف والجفاء وغَرَّبْ","ت بذاك الجفاء بعد الشروق",15,"ق",1,0],["سُمتَني خُطةً من الكُره نقداً","بجزاءٍ يكونُ أو لا يكونُ",16,"ن",1,1],["سمتني أن أغيبَ عن كل شيء","أنا صبٌّ بقربه مفتون",16,"ن",1,0],["سُمتَني جفوةً فأظهرتُ سَلوَهْ","كلُّ ذي جَفْوه حقيقٌ بَسلوَهْ",17,"و",2,1],["سَمَتْ عيونُ الرَّدى إليهِ","وهيَ إلى المكرُمَاتِ تَسْمو",18,"م",2,0],["سَمَّتهُ أُسرَتُهُ العَلاءَ وَإِنَّما","قَصَدوا بِذَلِكَ أَن تَتِمَّ عُلاهُ",19,"ا",2,0],["سَمَتْ بأبي الفوارس في المعالي","ضرائبُ ما له فيها ضريبُ",20,"ب",1,0],["سُمتُ نَفسي وَرَعاً تَصدُقُهُ","فَنَهاها النَقصُ عَن ذاكَ الوَرَع",21,"ع",1,0],["سَمَت فَأَرَتهُ حَرَّ الكَرَّ بَرداً","وَيَحمومَ المَنِيَّةِ كَالزَلالِ",22,"ل",1,0],["سَمَت بي إِلى العَلياءِ نَفسٌ أَبِيَّةٌ","تَرى أَقبَحَ الأَشياءِ أَخذَ المَواهِبِ",23,"ب",1,0],["سُمْتُهَا الْقَوْلَ بَعْدَ لأْيٍ فَبَضَّتْ","بِيَسِيرٍ لَمْ يَرْوِ عُودَ ثُمَامِ",24,"م",1,0],["سَمَتْ نحوَهُ الأبصارُ حتى كأنَّهُ","بناريْهِ من هِنَّا وثمَّ صوالي",25,"ي",1,1],["سُمْتُها لَثْمَ الثنايا فقالتْ","إنَّ مِنْ دُونِكَ سُبْلاً صِعابا",26,"ب",2,0],["سُمْتُهَا قُبْلَةً تُسَرُّ بِها النَّفْسُ","فقالَت كذا أَكُونُ حَزِينَة",27,"ن",2,0],["سُمتُها عِندَ يَهودِي","يٍ خَصيبِ المُستَرادِ",28,"د",1,0],["سَمَّتكَ أُمُّكَ ديناراً وَقَد كَذَبَت","لَو كُنتَهُ لَم تَكُن حَمّالَ أَدناسِ",29,"س",1,1],["سَمَتْ نحوَهُ الأبْصارُ حتى كأنها","بنارَيْهِ مِن هَنّا وثَمّ صَوالي",30,"ل",2,0],["سَمَتْ صُعُداً أَفْنَانُهُ فَكَأَنَّمَا","لَهَا عِنْدَ إِحْدَى النَّيِّرَاتِ عَشِيقُ",31,"ق",1,0],["سَمَتْ مُنَاهُمْ وهَبوا","لا يَعْبَأُونَ بِكُلْفَهْ",32,"ف",2,0],["سِمْتَ سُلْمَانُ مَنْصِباً أُسْقُفِياً","كَانَ لِلاحصَفِ الابَرِّ مُعَدَّا",33,"د",2,0],["سَمتُهُ سَمتُ ذي تقىً وَعَفاف","لَو دَرى ما الهَوى أَنامَ الرَقيبا",34,"ب",2,0],["سَمَتِ الآدابُ والدُّنْيا بِهِ","وَبَدَتْ تَخْطِرُ في أَزْهَى حُلاها",35,"ا",3,0],["سمت الملوك وهدى الأنبياء على","أخلاقهم فكأن الفقر تيجان",36,"ن",1,0],["سمت بهم همة كالشمس نيرة","فكل هم عزيز تحتها ركعا",37,"ع",2,0],["سمتْ تَزْهو على السَفحَينِ منها","قصورٌ ملؤها زَهْوٌ وكِبْر",38,"ر",1,0],["سَمِتعُ وَقَد هَبَطنا مِن نُمارٍ","دَعاءَ أَبي المُثَلَّمِ يَستَغيثُ",39,"ث",1,0],["سمت به في مراقى المجد همتُه","حتى شىحين جارَى في العلا رجلا",40,"ل",2,0],["سَمَت إِلى حَيثُ قَوسُ المُزنِ فَاِعتَصَبَت","بِبَعضِهِ وَلَها مِن بَعضِهِ عَذَبُ",41,"ب",1,0],["سَمَت بِكَ هِمَّةٌ كَسَبَتكَ ذِكراً","وَسَمتَ بِها الزَمانَ وَكانَ غُفلا",42,"ل",2,0],["سَمَت رُتبَةُ الأَيّامِ مُنذُ أَتَت بِهِ","وَقَدرُ المَعالي مُنذُ صارَ بِها يُكنا",43,"ن",2,0],["سَمَت هِمَّةٌ نَحوَ اللَحاقِ بِهِ سَمَت","وَأَخَّرَها عَمّا إِلَيهِ تَقَدَّمَت",44,"ت",1,0],["سَمَتِ الأَزدُ بِالحُتوفِ إِلى الأَز","دِ وَموسى مُسَلَّمٌ مَغبوطُ",45,"ط",1,0],["سمت علياك عن رتب المعالي","فخرَّت سجداً آي المعاني",46,"ن",2,0],["سُمتُها يَومَ التَنائي ضَمَّةً","فَأَحالَتني عَلى