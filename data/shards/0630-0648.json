oem.aspx?id=3095",""],[38,"أبتْ آياتُ حبّى أنْ تبينا","https://www.poetsgate.com/ViewPoem.aspx?id=21235",""],[51,"مستبعدٌ هيهات إعتاقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29920",""],[51,"شجوُ قلبي من سائر الخلق شاجي","https://www.poetsgate.com/ViewPoem.aspx?id=27411",""],[51,"يا دهرُ ما سبْكُ غيرِ ذي الخَبَثِ","https://www.poetsgate.com/ViewPoem.aspx?id=27254",""],[51,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[75,"يا ربّ كلّ كتيبة ٍ شَهبْاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10781&r=&rc=1",""],[9,"باتتْ سعادُ وأمسى حبلها رابا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17255&r=&rc=2",""],[100,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""]],"verses":[["ذو نَسَبٍ تَستَخجِلُ الشَمسُ بِهِ","أَصفى عَلى السائِغِ مِن ماءِ المُزُن",0,"ن",1,0],["ذَوُو القِبابِ الحُمرِ يُنضى سَجفُها","عَن عَدَدٍ مِن سامِرٍ وَجامِلِ",1,"ل",1,0],["ذو راحَةٍ يَعتَرِكُ ال","بَأسُ بِها وَالنائِلُ",2,"ل",1,0],["ذَواكِرَ لِلنَجوى بِيَومٍ طِعانُهُ","يُنَسّي رُؤوسَ الخَيلِ جَذبَ العَلائِقِ",3,"ق",1,0],["ذو جِلدَةٍ حَمراءَ تَحسَبُ أَنَّها","مِن طولِ تَخليقِ الرِهانِ خُلوقُ",4,"ق",1,0],["ذَوائِبٌ مِن لُبابِ المَجدِ ما فَجِعوا","بِمِثلِ أَنفُسِهِم يَوماً وَلا فُجِعوا",5,"ع",3,0],["ذو عَزمَةٍ تُلهِمُ الدُنيا وَساكِنَها","وَهِمَّةٍ تَسَعُ الدُنيا وَما تَسَعُ",5,"ع",1,0],["ذَوارِعَ لِلبِلادِ بِغَيرِ حادٍ","تَخالُ فُضولَ أَنسُعِها سِياطا",6,"ط",2,0],["ذَوائِبُ المَجدِ المُنيفاتُ عَلى","جَماجِمٍ مُنيفَةٍ في مُضَرِ",7,"ر",1,0],["ذَوُو البِطاحِ الفيحِ وَالبَيتِ الَّذي","يَعلو الوَرى وَالعَدَدِ المُجَمهَرِ",7,"ر",1,0],["ذو شيمَةٍ تُعطي العُيونَ خُبرَها","لا تَحوِجُ الناظِرَ أَن يُقِرَّها",8,"ر",3,0],["ذو السِنِّ وَالشَرَفِ الَّذي جَمَعَت بِهِ","كَفّاهُ أَخمِطَهَ العُلى وَالجودِ",9,"د",1,0],["ذَوو الجَبَهاتِ البيضِ تَلمَعُ بَينَها","وُسومُ المَعالي وَالوُجوهِ المُضيئَةِ",10,"ه",1,0],["ذَوى قَبلَ أَن تَذوي الغُصونُ وَعَهدُه","قَريبٌ بِأَيّامِ الرَبيلَةِ وَالخِصبِ",11,"ب",1,0],["ذَوى كَما يَذبُلُ القَضيبُ وَكَم","مَأمولِ قَومٍ يَصيرُ مَندوبا",12,"ب",2,0],["ذو همّةٍ لنْ تَنالَ الشُّهْبُ غايَتَها","عَلَتْ وما احْتَفَلَتْ مِنها بمُرْتَدِفِ",13,"ف",1,0],["ذو راحةٍ ألِفَتْها في سَماحَتِها","مَكارِمٌ تتقاضاهُ بِها الشِّيَمُ",14,"م",1,0],["ذو هِمّةٍ تَرَكَتْ كَعْباً وأُسْرَتَهُ","بِغارِبٍ في مَراقي الفَخْرِ مَجْبوبِ",15,"ب",1,0],["ذو ساحَةٍ فَيحاءَ مَعروفٍ بِها","وَزَرُ اللّهيفِ وعُصْرَةُ المَنْجودِ",16,"د",1,0],["ذو سُؤْدَدٍ كأنابيبِ القَنا نَسَقٍ","في نَجْدَةٍ من دِماءِ الصِّيدِ تُرويها",17,"ي",3,0],["ذو مَحْتِدٍ سَنِمٍ رَفيعٍ سَمْكُهُ","تُعلي دَعائِمَ مَجدِهِ عَدنانُ",18,"ن",1,0],["ذو وَجْنَةٍ إنْ جَنَتْ عَينُ الرّقيبِ بها","وَرْدَ الحَياءِ كَساها وَرْسَهُ الوَجَلُ",19,"ل",1,0],["ذَوُو القَسَماتِ البِيضِ والأُفْقُ حالِكٌ","منَ النّقْعِ كاسٍ والمُهَنَّدُ عُريانُ",20,"ن",1,0],["ذُو همّةٍ بنَواصي النّجْمِ سافِعَةٍ","بثَّتْ على طُرُقِ العَلْياءِ أرْصادا",21,"د",2,0],["ذو هِمّةٍ بالعُلا مَشغوفَةٍ جَمَعَتْ","مِنَ المَكارِمِ أبكاراً إِلى عُونِ",22,"ن",1,0],["ذو غُربَةٍ عَن أَهلِهِ","مُجتَهِدٌ في الطَلَبِ",23,"ب",1,0],["ذُؤَابَةُ سَلْمَانٍ وَسَلْمَانُ كِنْدَةٍ","وَكِنْدَةُ ظِلٌّ مَا أَرَدْتَ ظَلِيلُ",24,"ل",1,0],["ذُو هِمّةٍ عَلْياءَ مَدّ المُشْتَري","طَرْفاً الى غاياتِها طَمّاحا",25,"ح",2,0],["ذُو الْمُعْجِزَاتِ التِي لاَحَتْ شَوَاهِدُهَا","فَشَاهَدَ الْقَوْمُ مِنْ آيَاتِهِ عَجَبَا",26,"ب",2,0],["ذوو الأَحسابِ أَكرَمُ مَخبراتٍ","وَأَصبَرُ عِندَ نائِبَةِ الحُقوقِ",27,"ق",1,0],["ذو صِبيَةٍ كَسبُ تِلكَ الضارِياتِ لَهُم","قَد حالَفوا الفَقرَ وَاللَأواءَ أَحقابا",28,"ب",2,0],["ذو أَذاةٍ عَلى الخَليطِ خَبيثُ ال","نَفسِ يَرمي مَراغَهُ بِالنُسالِ",29,"ل",1,0],["ذو طَرفَينِ إِذا نَسَبتَهُما","يَحارُ في ذاكَ كُلُّ ذي لُبِّ",30,"ب",1,0],["ذو باطِنٍ أُقبِسَ نورَ التُقى","وَظاهِرٍ أُشرِبَ ماءَ السَماح",31,"ح",1,0],["ذو الشيمَةِ الرَسلِ إِن هيجَت حَفيظَتُهُ","وَالجانِبِ السَهلِ وَالمُستَعتِبِ اليَسَرِ",32,"ر",1,0],["ذو مزة خطت على حرفه","وعن معاني لفظها لا تسل",33,"ل",1,0],["ذو سُفعَةٍ كَشِهابِ القَذفِ مُنصَلِتٌ","يَطفو إِذا ما تَلَقَّتهُ الجَراثيمُ",34,"م",1,0],["ذو سطوة مهما كفى ذو رحمة","مهما عفا ذو عفة مهما قدرْ",35,"ر",1,0],["ذو صَلاةٍ من صِلاتِ","كلُّها دأباً مُعَادَهْ",36,"د",2,0],["ذو حسام كأنه لمع برقٍ","في بنانِ كأنها غيث سحبِ",37,"ب",1,0],["ذو المعجزاتِ الغُرِّ والآي الألى","أُكْبِرْنَ عن عَدٌ وعن إحصاءِ",38,"ا",2,0],["ذو زخرف يبهج العين التي نظرت","حتى تراه لها نوراً وإنسانا",39,"ن",2,0],["ذو همّة فعّالة","ترك الجبال بها هزيزه",40,"ز",2,0],["ذوي منها الجمال الغَضّ وجداً","وكاد يَجِف ناعمه الرطيب",41,"ب",1,0],["ذوقوا وَقَد كُنتُمُ عَنها بِمُعتَزَلٍ","حَرباً تَحَرَّقُ مِن حَميٍ وَإيقادِ",42,"د",1,0],["ذَوُو الحَجَراتِ الشُمِّ مِن آلِ جَعفَرٍ","يُسَلَّمُ جانيها وَيُعطى فَقيرُها",43,"ر",3,0],["ذو العَرشِ قَدَّرَ أَن تَكونَ خَليفَةً","مُلِّكتَ فَاِعلُ عَلى المَنابِرِ وَاِسلَمِ",44,"م",1,0],["ذو الكبرياء الذي يرى البعدَ وال","حِدَّة من حيث ثابه القَربُ",45,"ب",1,1],["ذو بِرْكة لم تغص قيداً تشيع به","من الأفاويق في أحيانها الوَظُبُ",46,"ب",1,1],["ذو أربع ركبت في الرأس تكلؤه","مما يخاف ودون الكاليء الأجلُ",47,"ل",1,1],["ذُو الجَنَاحَينِ وابنُ هالةَ مِنهُم","أسَدُ الله والكَمِيُّ المُحَامِي",48,"م",2,0],["ذَوي عُلاها وَذَوي طُعّانِها","وَمُهرَةٌ تَمرَحُ في أَشطانِها",49,"ن",3,0],["ذُؤابَةُ هاشِمٍ وَالفَرعُ مِنهُم","وَقَد قَصُرَت عَنِ العَليا يَداكا",50,"ك",2,0],["ذو العِلم كالعلم المنشور تتبعه","بنو قرًى تترجاه وإقراء",51,"ا",2,0],["ذو الفضل من نسبٍ ومن شيمٍ فيا","لله منبتُ عودِه ونماؤه",52,"ا",3,0],["ذو الفضل قد دُعيت رواةُ فخاره","في الخافقينِ دعاءَها المتناسِبا",53,"ب",2,0],["ذو وجنةٍ بمجاري الدَّمعِ قد قرحتْ","وخاطر بجناحِ الشوقِ قد وجبا",54,"ب",2,0],["ذو البيت إن حدَّثت عنه العلى خبراً","جاءتْ بإسنادِها عنه أباً فأبا",54,"ب",2,0],["ذو الفضل لا تحصى مواقع سحبه","والشخص منفرداً يضيء شهابا",55,"ب",2,0],["ذو العلمِ والفضلِ مع شبيبته","ليسَ لهُ في سواهُما طَرْبه",56,"ب",2,0],["ذو همَّةٍ في العُلى والعلمِ قد بلغتْ","فوق السماك وما تنفكُّ في دَأَب",57,"ب",1,0],["ذو كبد حرّى وهم بعضها","فالكلُّ يشكو الشوق ألهوبا",58,"ب",2,0],["ذو نطاقٍ وسوارٍ لم يدَع","ناطقاً غيرهما عندي وصامت",59,"ت",1,0],["ذو الجود كم جملٍ من وفر راحته","قد عوجلت قبل تحصيلٍ بإخراج",60,"ج",1,0],["ذو ناظرٍ بالحيا والسحر مكتحل","فالموت إن غضت الأجفان أو فتحت",61,"ت",1,0],["ذو الرأي والقلم الهادي فواصف ذا","وذاك ما بين منصور وسفاح",62,"ح",1,0],["ذو القلمِ الرَّاقي حياً أو علاً","فيا له غصناً دَنا أو شمخ",63,"خ",1,0],["ذو العلم قلدَ طلاب الهدى منناً","حتى وصفناه عن علم وتقليد",64,"د",1,0],["ذو الجود والبأس في يومي ندًى وردًى","ما بين منسجمٍ يوماً ومتقدِ",65,"د",1,0],["ذو همةٍ في الفضل يحكم يومها","ويريك أحكم من فواصلها غدا",66,"د",2,0],["ذو الجود في عسر ويسر ومن","مثل ذوي التجريب في كل ناد",67,"د",1,0],["ذو الفضل من ذات ومن نسبة","والمجد لا يحصى بتعداد",68,"د",1,0],["ذو قلم يجني الغنى والقنا","من سمِّه الجاري ومن شهده",69,"د",2,0],["ذو همَّةٍ رأت المكارم في الورى","ضيعاً فأعْجبها افتراع نجودها",70,"د",3,0],["ذو العلم ألقوه إلى نجلِهم","لا نجلَ صبَّاغٍ وحدَّاد",71,"د",1,0],["ذو النظم والنثرِ كم قالت حلاوة ذا","وذا لعمرك ماذي حلاوة الماذي",72,"ي",1,0],["ذو طلعةٍ تعلو على المشتري","وغرّةٍ تزهو على الزّهره",73,"ر",2,0],["ذو حسامٍ مدَرَّبٍ لم يدَعْ في","جانب الشامِ للعدى ديَّارا",74,"ر",2,0],["ذو حجرٍ نسبةً وغيظاً","أنا وقومي نخاف ناره",75,"ر",2,0],["ذو الفضل وابن الفضل ما أحلى اللقا","وإن يكنْ بعضُ الجفا فما أمرّ",76,"ر",1,0],["ذو النفس تاقت لعليا دارها فجرت","ومن جنانِ غدٍ تاقت إلى دار",77,"ر",1,0],["ذو العلم والفضل الذين هُما هُما","شهبٌ بأفاقِ السيادة تزهر",78,"ر",1,0],["ذو وجنةٍ قد زان شع","رَ الصدغ منظرها النضير",79,"ر",1,0],["ذو الجود والبأس من يعرض لسطوته","يهلك ومن يرجُ نعمى كفه يفُز",80,"ز",1,0],["ذو البيت طافَ به الرجاء ملبياً","داعي الفخار إلى الندى والبأس",81,"س",1,0],["ذو يدٍ موسوية قد تحدَّت","بيراع كالحية النضناض",82,"ض",1,0],["ذو البيت نظماً ومجداً قد سخا وذكا"