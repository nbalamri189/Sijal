","https://www.aldiwan.net/poem16155.html","الطويل"],[464,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[466,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[467,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[467,"أيها الكامل المروءة والمفحم","https://www.aldiwan.net/poem3234.html","عموديه"],[467,"أركض جياد الصبي في حلبة اللعب","https://www.aldiwan.net/poem3615.html","عموديه"],[480,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[480,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[480,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[482,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[541,"قرنفلة حمراء أهدى ابن سودة","https://www.aldiwan.net/poem48141.html","عموديه"],[554,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[554,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[563,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[570,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[578,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"],[578,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216883",""],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/26739","الطويل"],[870,"","https://poetry.dctabudhabi.ae/diwan/poem/31476","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/7","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[1021,"أمِنْ طَلَل قَفْرٍ ومن منزلٍ عافِ","https://www.poetsgate.com/ViewPoem.aspx?id=17623",""]],"verses":[["وَمُبَخِّلٍ أَعطى القَليلَ وَرُبَّما","سَمَحَت حُروفُ التاءِ لِلتَمتامِ",0,"م",1,0],["وَمَبنى قِبابِ بَني عامِرٍ","عَلى الغَورِ أَطنابُهُنَّ العَوالي",1,"ل",2,0],["وَمُبَخَّلٍ شَهِدَت عَلَيهِ يَمينُهُ","في حَيثُ يَمنَعُها النَدى وَيَعوقُ",2,"ق",1,0],["وَمُبتَسِمٌ يَرتَجُّ في ماءِ حُسنِهِ","لَهُ مِن عُيونِ الناظِرينَ فَواقِعُ",3,"ع",1,0],["وَمُبَخَّلٍ إِن جادَ بَعدَ مَدىً","فَالماءُ يَطلُعُ مِن صَفاً صَلدِ",4,"د",1,0],["وَمَبسِمَها عَن شَتيتِ النَبا","تِ غَيرِ أَكَسٍّ وَلا مُنقَضِم",5,"م",1,0],["وَمَبثوثَةٍ مِثلَ الجَرادِ وَزَعتَها","لَها زَجَلٌ يَملا القُلوبَ مِنَ الذُعرِ",6,"ر",1,0],["وَمُبدٍ لَنا ضِغناً وَلَولا رِماحُنا","بِأَرضِ العِدى لَم يَرعَ صَوبَ البَوارِقِ",7,"ق",1,0],["وَمُبَلِّغٍ يَومَ الصُراخِ مُنَدِّدٍ","بِعِنانِ دامِيَةِ الفُروجِ كَليمِ",8,"م",1,0],["ومبيضّ آثارِ الصنائع أحمدت","مناقبه أيام كلّ مسود",9,"د",1,0],["ومبشّر بالقاصدين كأنه","وأبيك قاصدها وطالب جودها",10,"د",3,0],["ومبسماً لبهيِّ الدّرّ متَّسقاً","كأنه لبهاء الدِّين ألفاظ",11,"ظ",1,0],["ومبلغ علم بإعجازه","رمى في حشا الندّ بالحارق",12,"ق",1,0],["ومبتسم فيه اللآلي يتيمة","وليس على أسلاكه ذلة اليتم",13,"م",1,0],["ومبسمك العذب أم بارقٌ","تحثُّ سحائب أجفانيه",14,"ي",2,0],["ومبادلين بدمعتين حلاهما","هذا لهذا قائم بولائهِ",15,"ه",1,1],["ومُبتغِي العيشِ بعد خِلٍّ","كاذِبُهُ خُلَّةَ الصفاءِ",16,"ا",2,0],["ومبيتي بلا ضجيعٍ لدى القر","رِ وللوغد شادِنٌ مخضوبُ",17,"ب",1,0],["ومبتسمٌ للمدح في ذي مروءةٍ","فلما درى أنْ لم يثوِّبه كلَّحا",18,"ح",2,0],["وَمُبارَكُ الغَدَواتِ لا","يَبدو لَهُ إِلّا سَنيحُه",19,"ح",2,0],["وَمَبسَمّا نُظِّم مِن جَوهَرٍ","وَماؤُهُ مِن أَعطَرِ الخَمرِ",20,"ر",1,0],["وَمُبَشِّرٍ بِالصُلحِ قُلتُ لَعَلَّهُ","خَيرٌ عَسى أَن تَصدُقَ الأَحلامُ",21,"م",1,0],["وَمَبثوثَةً لا تُتَّقى بِطَليعَةٍ","وَلا يُحتَمى مِنها بِغَورٍ وَلا نَجدِ",22,"د",1,0],["وَمُبتَسِماتِ هَيجاواتِ عَصرٍ","عَنِ الأَسيافِ لَيسَ عَنِ الثُغورِ",23,"ر",1,0],["ومبذولةٌ يومَ الطِّرادِ يصونُها","من النَّقْعِ جُلٌّ أو من الدمِ بُرْقُعُ",24,"ع",1,0],["ومبسِمُ ابنِ رسولِ اللّه قد عبثتْ","بنو زيادٍ بثَغْرٍ منه منكوتِ",25,"ت",1,0],["وَمُبينَةٍ شَهَرَ المُنازِلُ وَسمَها","وَالخَيلُ تَكبو في العَجاجِ الكابي",26,"ب",2,0],["وَمُبَجَّلٌ وَسَطَ الرِجالِ خُفوفُهُم","لِقِيامِهِ وَقِيامُهُم لِقُعودِهِ",27,"د",2,0],["وَمُبارَكٌ ميلادُ مُلكِكَ مُخبِرٌ","بِقَريبِ عَهدٍ كانَ مِن ميلادِهِ",28,"د",2,0],["وَمُباحٌ مِمّا يُحَصِّنُهُ السو","رُ وَلَو باتَ دونَهُ مَعروضا",29,"ض",2,0],["ومبثوثة في كل شرق ومغرب","لها أمهات بالعراق قواطن",30,"ن",1,1],["ومَبنِيَّةٍ من خَيْزُرانٍ مُفَضَّضٍ","يُقَدِّمُها ِخشْفٌ من الإِنْسِ أروَعُ",31,"ع",1,1],["ومبيضَّةٍ مما قراه محمدٌ","أبوك لكي تَبيضَّ عِرْضاً ومَحتِدا",32,"د",2,0],["ومُبرِقةُ الحُتوفِ إذا أسالَتْ","دماءَ الشَّيبِ شابَ لها الوليدُ",33,"د",1,0],["ومبتسمٍ والطعنُ يَخضِبُ رُمحَه","كأنْ قد رأى منه بَناناً مُخَضَّبا",34,"ب",2,0],["ومباسماً تجلو شقائقَ روضةٍ","للأقحُوَانَةِ بينها نُوّارُ",35,"ر",1,0],["وَمُبَيِّنٌ لَكُمُ غَثاثَتَها","لَفظُ اِبنِ أَعمَشَ عِندَها سَمَرُ",36,"ر",1,0],["وَمُبتَدِرُ المَعروفِ تَسري هِباتُهُ","إِلَيهِم وَلا تَسري إِلَيهِم غَوائِلُه",37,"ل",2,0],["وَمَبثوثَةٍ دعَّاءَةٍ أَخَذَتكُمو","قَديماً بِأَمثالِ الأَباءِ المُضَرَّمِ",38,"م",1,0],["وَمُبارَكُ الآثارِ لَو وَطِىءَ الصَفا","لَجَرى بِمُنهَلِّ النَدى وَتَفَجَّرا",39,"ر",2,0],["وَمُبتَسِمٍ ضاحِكٍ وَجهُهُ","إِذا صالَ كُلُّ فَتىً باسِلِ",40,"ل",1,0],["وَمَبضوعَةً مِن رَأسِ فَرعٍ شَظِيَّةٍ","بِطَودٍ تَراهُ بِالسَحابِ مُجَلَّلا",41,"ل",2,0],["ومُبتدى عشرينَ مات الحاجبْ","مُوسى الذي كانَ الشهابَ الثاقبْ",42,"ب",1,0],["وَمُبْصِر لِلناسِ فِي أَرْزَاقِهِمْ","بِمَوَارِدٍ تُجْلى لَهُمْ وَمَصَادِرِ",43,"ر",1,0],["وَمُبْتَكَرَاتٌ كُلَّ آنٍ جَدِيدَةٌ","لَهَا مِنْ أَفَانِينِ الحِلَى كُلُّ رَوْنَقِ",44,"ق",1,0],["ومِبضعُ كلِّ مكلوم، وسوطٌ","يؤدِّبُ كلَّ جبَّارٍ عنيد",45,"د",1,0],["ومُبْدلُ الأُنس بالاكتِئَاب","وطاعنُ الصيف بلا حِرَاب",46,"ب",1,0],["ومباهج ما إن يروقك مشهد","من حسنه حتّى يشوقك مشهد",47,"د",1,0],["وَمَبْعَثٍ لِلفِكْرِ وَالذَّكَاءِ","وَمُنْتَدىً لِلشِعْرِ وَالغِنَاءِ",48,"ا",2,0],["وَمُبَرَّأً مِنْ كُلِّ غُبَّرِ حَيْضَةٍ","وَرَضَاعِ مُغِيلَةٍ وَدَاءٍ مُعْضِلِ",49,"ل",1,0],["ومُبَاحٌ ممّا يُحَضِّنُهُ السُّو","رُ، وَلَوْ بَاتَ دُونَهُ مَعشْروضَا",50,"ض",2,0],["ومبدل حرفا بحرف ان يكن","عن آفة أو فطرة وقع الأثر",51,"ر",1,0],["وَمُبَطرِقُ البِطريقِ يَأبى مِثلَهُ","إِن أَنتَ لَم تُعطِ الرَسولَ ذِماما",52,"م",2,0],["وَمُبَذَّلاتٍ لِلصَوارِمِ وَالقَنا","وَمُبَدَّلاتٍ العَليقِ شَكيما",53,"م",2,0],["ومبسم الصبح زانته كواكبه","كما تزين ثغر الكأس بالحبب",54,"ب",1,0],["وَمُبدِيَةٍ تِيهاً عَلَيَّ وَقَد رَأَت","بَياضاً بِرأسي قَد بَدا مِنهُ رَيعانُ",55,"ن",1,0],["ومُبخِّلَ الكرماءِ أَيْسَرُ جودِه","فكأنما حَسناتُهم أوزار",56,"ر",1,0],["ومبيد مُلْكِ الرومِ بالنصرِ الذي","نَطَقَت به الآياتُ من إنجليه",57,"ل",3,0],["وَمبجّلاً ومفضّلاً ومعظّما","وَمُتحّياً ومصلّياً ومسلّما",58,"م",2,0],["ومبسمها بما فيه","فأين الخمر والورد",59,"د",1,0],["ومبشِّري بقدوم مَن أهواهُ","لازال وهو مُبَشَّرٌ بمناهُ",60,"ه",1,1],["ومبتدئا يعطيك قبل سؤاله","حياء ويخشى ان تقول فيخجلا",61,"ل",2,0],["ومبتدئا يعطيك قبل سؤاله","علىغير مدح فوق ما انت سائله",62,"ل",2,0],["ومبسَمَكِ الدُّريَّ بالبرقِ والطِلا","بجيد طلاء الرِيم في مَهْمَةٍ قَفْرِ",63,"ر",1,0],["ومُبْتَدٍ لبناء وهو هادمُه","ومُدَّعٍ لصواب وهو لم يُصِب",64,"ب",1,0],["ومبكر يطوي جلابيب الفلا","عجلا غدا لا يستقر رسيمه",65,"م",2,0],["ومبكّر جدّت به عزماته","نحو العلى فاغذ لا يتثبط",66,"ط",1,0],["وَمُبيدَ شَملِ المالِ حَتّى خِلتَهُ","أَمسى يُنافِسُهُ عَلى عَليائِهِ",67,"ا",3,0],["وَمُبَشِّراتُكَ كَيفَ عُدنَ سَمائِماً","هوجاً وَكُنَّ عَلى القُلوبِ شَمالا",68,"ل",2,0],["وَمَبسوطٌ بِنائِلِهِ يَداهُ","اذا قَبِضَت بِهِ أَيدي الشِحاحِ",69,"ح",1,0],["ومباركٌ بكماله","نادى الكمال الايجل",70,"ل",1,0],["ومبرّزاً إِن رام سَبقاً أَقصَرت","عن أَن تحاولَ شأوَه أَقرانُهُ",71,"ن",2,0],["وَمُبخّلٍ بِالمالِ قُلتُ لَعَلَّهُ","يَنْدَى وَظَنّي فيهِ ظَنٌ مُخْلِفُ",72,"ف",1,1],["ومَبيتي ساهراً مُرتفِقاً","بالفلا والنِّضْو مَعقولٌ إزائي",73,"ا",2,0],["ومَبيتي مؤُرَّقاً طُولَ لَيلي","واقتْضائي مَدائحَ الكُبَراء",74,"ا",2,0],["ومبسمٌ لاحَ لنا من ضَوئِه","بَرقٌ ولكن ليسَ للبرقِ بقا",75,"ا",1,0],["ومبلغاً عن أحمد","خير الورى علماً وزهدا",76,"د",2,0],["ومبيدُ أملاكِ الفرنْ","جِ وجمعَهم حالاً فَحالا",77,"ل",2,0],["ومبتسم بوجه الضَّيف زاه","ووجه الدَّهر مشتدّ القطوب",78,"ب",1,0],["ومُبدي كلِّ مكرمةٍ معيدٌ","فيا لله من مبدٍ معيد",79,"د",1,0],["ومبانيه تملك اللبّ في الحسن","بلاغاً وحكمة واختصارا",80,"ر",2,0],["ومباني المجد في أفعاله","قد بناهنّ البناءَ المحكما",81,"م",2,0],["ومبدّد الأموال مهلكها","بالمكرمات لخالد الذكر",82,"ر",1,0],["ومبسم يفترّ عن لؤلوءٍ","منتظمٍ قد حيّر الناظمين",83,"ن",1,0],["ومُبَشِّرُ الأَيامِ أن تبقى لَهَا","ومبشّرُ الإِسلامِ أن تبقى لَنَا",84,"ن",2,0],["وَمَبسِمُكِ الوضَّاحُ أم ضوءُ بارِقٍ","حَداهُ دُعائي أن يجودَ ديارَكِ",85,"ك",1,0],["ومُبارِزَ الأُسْدِ الغِضابِ وَقَدْ غَلَتْ","حربٌ تُوَكِّلُ بالحتوفِ هِياجَهَا",86,"ج",3,0],["ومبتسم الأَحباب فِي جنباتها","أَقاحٍ كَساهُنَّ الربيع رُباها",87,"ا",3,0],["ومبينللمشكلات بعلم اك","تسبته همته وعلم ذاتي",88,"ت",2,0],["ومبهمَةٍ مذكَّرة زَبونٍ","تخال شَرار جاحمها ضِرامَهْ",89,"م",2,0],["ومبرَمةٌ الأسبابِ شائعُ ذكرِها","رقيبٌ على نعماك لي ووكيلُ",90,"ل",1,0],["ومبتسمين يُوري الملكُ منهم","جباهاً كلُّ واضحةٍ زنادُ",91,"د",1,0],["ومبرك أنضاءٍ ومُلقى سوابغِ","ومسحب أرماحٍ ومنْضى سوابق",92,"ق",1,0],["ومُبْهمةٍ كَدآدي الشتاءِ","تزيدُ الرَّويَّةُ اِشكالها",93,"ل",3,0],["ومبتسمٌ في الحفل والدمعُ غائضٌ","له بين أثناء الضُّلوعِ مَسيلُ",94,"ل",1,0],["ومُبتْاعُ حمدٍ من قريشٍ كأنما","مُحيَّاه شمس الصبح عالٍ طلوعها",95,"ه",2,0],["ومُبادي كُلِّ دَجْنٍ بارقٍ","بالمُحَيَّا الطَّلْقِ والكفِّ النَّدي",96,"د",2,0],["ومُبْتسمٌ للخطب والخطبُ كالحٌ","ولكن عن العوراء والشرّ باسِرُ",97,"ر",1,0],["ومُبْتسمٌ والبيض تبكي غُروبُها","بأحْمَرَ من ماءِ المَفارقِ ساكِب",98,"ب",1,0],["ومبشر مؤديها آداءً متمماً","بنيل الرضا والأجر يعطاه وافرا",99,"ر",2,0],["ومباهٍ بهِ الرجالَ وقد جلَّ","مكان الفخار في الأقوام",100,"م",1,0],["ومباهٍ بمدحه في البرايا","نكت السحر في عيون الملاح",101,"ح",1,0],["ومبسمُ الصبح زانتهُ كواكبهُ","كما يزيَّن ثغراُ الكأس بالحبب",102,"ب",1,0],["ومباسمٍ عَذُبَتْ موارِدُ ظَلِمْها","فحمتْهُ أسهمُ لحظِها أن يُوردا",103,"د",2,0],["ومبتسمٍ أضحتْ لآليءُ ثغرِهِ","تُخَجَّلُ منضودَ الفرائدِ بالنظمِ",104,"م",1,0],["ومباحٌ لهمُ أن يمنعوا","لرضاهمْ مقلتي مِن أن تناما",105,"م",2,0],["ومبلغ علمه أني شريف","نظيره هزّني شرف المقام",106,"م",1,0],["ومبسِمُه الدِّرّي تَأرَّجَ عِطرُهُ","