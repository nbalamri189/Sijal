{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[53,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[10,"أعيني هلا تبكيان على صخر","https://www.aldiwan.net/poem21080.html","الطويل"],[27,"ألا حي أهل الجوف قبل العوائق","https://www.aldiwan.net/poem5928.html","الطويل"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"حمدت دموعي إذ وفت بوعودها","https://www.aldiwan.net/poem18562.html","الكامل"],[72,"لا أترك الحب والعذال وعاظ","https://www.aldiwan.net/poem19156.html","البسيط"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[72,"فديت محيا في مسائله ينمي","https://www.aldiwan.net/poem19669.html","الطويل"],[72,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[72,"ومبادلين بدمعتين حلاهما","https://www.aldiwan.net/poem20590.html","الكامل"],[51,"عيني شحا ولا تسحا","https://www.aldiwan.net/poem7957.html","مخلع البسيط"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[78,"يا غرة تسخر بالبدر","https://www.aldiwan.net/poem14249.html","السريع"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"نسيت وما أنسى عتابا على الصد","https://www.aldiwan.net/poem9558.html","الطويل"],[43,"عذيري من عذارى من أمور","https://www.aldiwan.net/poem9584.html","الوافر"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[62,"أما الزمان ففي تنبيهه عظة","https://www.aldiwan.net/poem52472.html","البسيط"],[45,"قد كان طيفك مرة يغرى بي","https://www.aldiwan.net/poem11429.html","الكامل"],[45,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[45,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[45,"يا أبا جعفر غدونا حديثا","https://www.aldiwan.net/poem64636.html","الخفيف"],[61,"ومبثوثة في كل شرق ومغرب","https://www.aldiwan.net/poem51322.html","الطويل"],[61,"ومبنية من خيزران مفضض","https://www.aldiwan.net/poem51565.html","الطويل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[61,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[61,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"رحلت فغير دموعي الدرر","https://www.aldiwan.net/poem30046.html","الكامل"],[44,"جوى ساور الأحشاء والقلب واغله","https://www.aldiwan.net/poem30306.html","الطويل"],[105,"بني مصر ما للطامعين وما لكم","https://www.aldiwan.net/poem43152.html","الطويل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[50,"ويسبق إنجازه وعده","https://www.aldiwan.net/poem62255.html","المتقارب"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[93,"هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31925",""],[13,"وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180800",""],[45,"يا أبا جَعْفَرٍ! غَدَوْنَا حَديثاً","https://www.poetsgate.com/ViewPoem.aspx?id=31133",""]],"verses":[["وَمُبَخِّلٍ أَعطى القَليلَ وَرُبَّما","سَمَحَت حُروفُ التاءِ لِلتَمتامِ",0,"م",1,0],["وَمَبنى قِبابِ بَني عامِرٍ","عَلى الغَورِ أَطنابُهُنَّ العَوالي",1,"ل",2,0],["وَمُبَخَّلٍ شَهِدَت عَلَيهِ يَمينُهُ","في حَيثُ يَمنَعُها النَدى وَيَعوقُ",2,"ق",1,0],["وَمُبتَسِمٌ يَرتَجُّ في ماءِ حُسنِهِ","لَهُ مِن عُيونِ الناظِرينَ فَواقِعُ",3,"ع",1,0],["وَمُبَخَّلٍ إِن جادَ بَعدَ مَدىً","فَالماءُ يَطلُعُ مِن صَفاً صَلدِ",4,"د",1,0],["وَمَبسِمَها عَن شَتيتِ النَبا","تِ غَيرِ أَكَسٍّ وَلا مُنقَضِم",5,"م",1,0],["وَمَبثوثَةٍ مِثلَ الجَرادِ وَزَعتَها","لَها زَجَلٌ يَملا القُلوبَ مِنَ الذُعرِ",6,"ر",1,0],["وَمُبدٍ لَنا ضِغناً وَلَولا رِماحُنا","بِأَرضِ العِدى لَم يَرعَ صَوبَ البَوارِقِ",7,"ق",1,0],["وَمُبَلِّغٍ يَومَ الصُراخِ مُنَدِّدٍ","بِعِنانِ دامِيَةِ الفُروجِ كَليمِ",8,"م",1,0],["ومبيضّ آثارِ الصنائع أحمدت","مناقبه أيام كلّ مسود",9,"د",1,0],["ومبشّر بالقاصدين كأنه","وأبيك قاصدها وطالب جودها",10,"د",3,0],["ومبسماً لبهيِّ الدّرّ متَّسقاً","كأنه لبهاء الدِّين ألفاظ",11,"ظ",1,0],["ومبلغ علم بإعجازه","رمى في حشا الندّ بالحارق",12,"ق",1,0],["ومبتسم فيه اللآلي يتيمة","وليس على أسلاكه ذلة اليتم",13,"م",1,0],["ومبسمك العذب أم بارقٌ","تحثُّ سحائب أجفانيه",14,"ي",2,0],["ومبادلين بدمعتين حلاهما","هذا لهذا قائم بولائهِ",15,"ه",1,1],["ومُبتغِي العيشِ بعد خِلٍّ","كاذِبُهُ خُلَّةَ الصفاءِ",16,"ا",2,0],["ومبيتي بلا ضجيعٍ لدى القر","رِ وللوغد شادِنٌ مخضوبُ",17,"ب",1,0],["ومبتسمٌ للمدح في ذي مروءةٍ","فلما درى أنْ لم يثوِّبه كلَّحا",18,"ح",2,0],["وَمُبارَكُ الغَدَواتِ لا","يَبدو لَهُ إِلّا سَنيحُه",19,"ح",2,0],["وَمَبسَمّا نُظِّم مِن جَوهَرٍ","وَماؤُهُ مِن أَعطَرِ الخَمرِ",20,"ر",1,0],["وَمُبَشِّرٍ بِالصُلحِ قُلتُ لَعَلَّهُ","خَيرٌ عَسى أَن تَصدُقَ الأَحلامُ",21,"م",1,0],["وَمَبثوثَةً لا تُتَّقى بِطَليعَةٍ","وَلا يُحتَمى مِنها بِغَورٍ وَلا نَجدِ",22,"د",1,0],["وَمُبتَسِماتِ هَيجاواتِ عَصرٍ","عَنِ الأَسيافِ لَيسَ عَنِ الثُغورِ",23,"ر",1,0],["ومبذولةٌ يومَ الطِّرادِ يصونُها","من النَّقْعِ جُلٌّ أو من الدمِ بُرْقُعُ",24,"ع",1,0],["ومبسِمُ ابنِ رسولِ اللّه قد عبثتْ","بنو زيادٍ بثَغْرٍ منه منكوتِ",25,"ت",1,0],["وَمُبينَةٍ شَهَرَ المُنازِلُ وَسمَها","وَالخَيلُ تَكبو في العَجاجِ الكابي",26,"ب",2,0],["وَمُبَجَّلٌ وَسَطَ الرِجالِ خُفوفُهُم","لِقِيامِهِ وَقِيامُهُم لِقُعودِهِ",27,"د",2,0],["وَمُبارَكٌ ميلادُ مُلكِكَ مُخبِرٌ","بِقَريبِ عَهدٍ كانَ مِن ميلادِهِ",28,"د",2,0],["وَمُباحٌ مِمّا يُحَصِّنُهُ السو","رُ وَلَو باتَ دونَهُ مَعروضا",29,"ض",2,0],["ومبثوثة في كل شرق ومغرب","لها أمهات بالعراق قواطن",30,"ن",1,1],["ومَبنِيَّةٍ من خَيْزُرانٍ مُفَضَّضٍ","يُقَدِّمُها ِخشْفٌ من الإِنْسِ أروَعُ",31,"ع",1,1],["ومبيضَّةٍ مما قراه محمدٌ","أبوك لكي تَبيضَّ عِرْضاً ومَحتِدا",32,"د",2,0],["ومُبرِقةُ الحُتوفِ إذا أسالَتْ","دماءَ الشَّيبِ شابَ لها الوليدُ",33,"د",1,0],["ومبتسمٍ والطعنُ يَخضِبُ رُمحَه","كأنْ قد رأى منه بَناناً مُخَضَّبا",34,"ب",2,0],["ومباسماً تجلو شقائقَ روضةٍ","للأقحُوَانَةِ بينها نُوّارُ",35,"ر",1,0],["وَمُبَيِّنٌ لَكُمُ غَثاثَتَها","لَفظُ اِبنِ أَعمَشَ عِندَها سَمَرُ",36,"ر",1,0],["وَمُبتَدِرُ المَعروفِ تَسري هِباتُهُ","إِلَيهِم وَلا تَسري إِلَيهِم غَوائِلُه",37,"ل",2,0],["وَمَبثوثَةٍ دعَّاءَةٍ أَخَذَتكُمو","قَديماً بِأَمثالِ الأَباءِ المُضَرَّمِ",38,"م",1,0],["وَمُبارَكُ الآثارِ لَو وَطِىءَ الصَفا","لَجَرى بِمُنهَلِّ النَدى وَتَفَجَّرا",39,"ر",2,0],["وَمُبتَسِمٍ ضاحِكٍ وَجهُهُ","إِذا صالَ كُلُّ فَتىً باسِلِ",40,"ل",1,0],["وَمَبضوعَةً مِن رَأسِ فَرعٍ شَظِيَّةٍ","بِطَودٍ تَراهُ بِالسَحابِ مُجَلَّلا",41,"ل",2,0],["ومُبتدى عشرينَ مات الحاجبْ","مُوسى الذي كانَ الشهابَ الثاقبْ",42,"ب",1,0],["وَمُبْصِر لِلناسِ فِي أَرْزَاقِهِمْ","بِمَوَارِدٍ تُجْلى لَهُمْ وَمَصَادِرِ",43,"ر",1,0],["وَمُبْتَكَرَاتٌ كُلَّ آنٍ جَدِيدَةٌ","لَهَا مِنْ أَفَانِينِ الحِلَى كُلُّ رَوْنَقِ",44,"ق",1,0],["ومِبضعُ كلِّ مكلوم، وسوطٌ","يؤدِّبُ كلَّ جبَّارٍ عنيد",45,"د",1,0],["ومُبْدلُ الأُنس بالاكتِئَاب","وطاعنُ الصيف بلا حِرَاب",46,"ب",1,0],["وَمَبْعَثٍ لِلفِكْرِ وَالذَّكَاءِ","وَمُنْتَدىً لِلشِعْرِ وَالغِنَاءِ",47,"ا",2,0],["وَمُبَرَّأً مِنْ كُلِّ غُبَّرِ حَيْضَةٍ","وَرَضَاعِ مُغِيلَةٍ وَدَاءٍ مُعْضِلِ",48,"ل",1,0],["ومُبَاحٌ ممّا يُحَضِّنُهُ السُّو","رُ، وَلَوْ بَاتَ دُونَهُ مَعشْروضَا",49,"ض",2,0]]}