https://www.aldiwan.net/poem926.html",""],[462,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[462,"أيها الكامل المروءة والمفحم","https://www.aldiwan.net/poem3234.html","عموديه"],[462,"أركض جياد الصبي في حلبة اللعب","https://www.aldiwan.net/poem3615.html","عموديه"],[475,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[475,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[475,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[477,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[536,"قرنفلة حمراء أهدى ابن سودة","https://www.aldiwan.net/poem48141.html","عموديه"],[549,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[549,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[558,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[565,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[573,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"]],"verses":[["وَمُبَخِّلٍ أَعطى القَليلَ وَرُبَّما","سَمَحَت حُروفُ التاءِ لِلتَمتامِ",0,"م",1,0],["وَمَبنى قِبابِ بَني عامِرٍ","عَلى الغَورِ أَطنابُهُنَّ العَوالي",1,"ل",2,0],["وَمُبَخَّلٍ شَهِدَت عَلَيهِ يَمينُهُ","في حَيثُ يَمنَعُها النَدى وَيَعوقُ",2,"ق",1,0],["وَمُبتَسِمٌ يَرتَجُّ في ماءِ حُسنِهِ","لَهُ مِن عُيونِ الناظِرينَ فَواقِعُ",3,"ع",1,0],["وَمُبَخَّلٍ إِن جادَ بَعدَ مَدىً","فَالماءُ يَطلُعُ مِن صَفاً صَلدِ",4,"د",1,0],["وَمَبسِمَها عَن شَتيتِ النَبا","تِ غَيرِ أَكَسٍّ وَلا مُنقَضِم",5,"م",1,0],["وَمَبثوثَةٍ مِثلَ الجَرادِ وَزَعتَها","لَها زَجَلٌ يَملا القُلوبَ مِنَ الذُعرِ",6,"ر",1,0],["وَمُبدٍ لَنا ضِغناً وَلَولا رِماحُنا","بِأَرضِ العِدى لَم يَرعَ صَوبَ البَوارِقِ",7,"ق",1,0],["وَمُبَلِّغٍ يَومَ الصُراخِ مُنَدِّدٍ","بِعِنانِ دامِيَةِ الفُروجِ كَليمِ",8,"م",1,0],["ومبيضّ آثارِ الصنائع أحمدت","مناقبه أيام كلّ مسود",9,"د",1,0],["ومبشّر بالقاصدين كأنه","وأبيك قاصدها وطالب جودها",10,"د",3,0],["ومبسماً لبهيِّ الدّرّ متَّسقاً","كأنه لبهاء الدِّين ألفاظ",11,"ظ",1,0],["ومبلغ علم بإعجازه","رمى في حشا الندّ بالحارق",12,"ق",1,0],["ومبتسم فيه اللآلي يتيمة","وليس على أسلاكه ذلة اليتم",13,"م",1,0],["ومبسمك العذب أم بارقٌ","تحثُّ سحائب أجفانيه",14,"ي",2,0],["ومبادلين بدمعتين حلاهما","هذا لهذا قائم بولائهِ",15,"ه",1,1],["ومُبتغِي العيشِ بعد خِلٍّ","كاذِبُهُ خُلَّةَ الصفاءِ",16,"ا",2,0],["ومبيتي بلا ضجيعٍ لدى القر","رِ وللوغد شادِنٌ مخضوبُ",17,"ب",1,0],["ومبتسمٌ للمدح في ذي مروءةٍ","فلما درى أنْ لم يثوِّبه كلَّحا",18,"ح",2,0],["وَمُبارَكُ الغَدَواتِ لا","يَبدو لَهُ إِلّا سَنيحُه",19,"ح",2,0],["وَمَبسَمّا نُظِّم مِن جَوهَرٍ","وَماؤُهُ مِن أَعطَرِ الخَمرِ",20,"ر",1,0],["وَمُبَشِّرٍ بِالصُلحِ قُلتُ لَعَلَّهُ","خَيرٌ عَسى أَن تَصدُقَ الأَحلامُ",21,"م",1,0],["وَمَبثوثَةً لا تُتَّقى بِطَليعَةٍ","وَلا يُحتَمى مِنها بِغَورٍ وَلا نَجدِ",22,"د",1,0],["وَمُبتَسِماتِ هَيجاواتِ عَصرٍ","عَنِ الأَسيافِ لَيسَ عَنِ الثُغورِ",23,"ر",1,0],["ومبذولةٌ يومَ الطِّرادِ يصونُها","من النَّقْعِ جُلٌّ أو من الدمِ بُرْقُعُ",24,"ع",1,0],["ومبسِمُ ابنِ رسولِ اللّه قد عبثتْ","بنو زيادٍ بثَغْرٍ منه منكوتِ",25,"ت",1,0],["وَمُبينَةٍ شَهَرَ المُنازِلُ وَسمَها","وَالخَيلُ تَكبو في العَجاجِ الكابي",26,"ب",2,0],["وَمُبَجَّلٌ وَسَطَ الرِجالِ خُفوفُهُم","لِقِيامِهِ وَقِيامُهُم لِقُعودِهِ",27,"د",2,0],["وَمُبارَكٌ ميلادُ مُلكِكَ مُخبِرٌ","بِقَريبِ عَهدٍ كانَ مِن ميلادِهِ",28,"د",2,0],["وَمُباحٌ مِمّا يُحَصِّنُهُ السو","رُ وَلَو باتَ دونَهُ مَعروضا",29,"ض",2,0],["ومبثوثة في كل شرق ومغرب","لها أمهات بالعراق قواطن",30,"ن",1,1],["ومَبنِيَّةٍ من خَيْزُرانٍ مُفَضَّضٍ","يُقَدِّمُها ِخشْفٌ من الإِنْسِ أروَعُ",31,"ع",1,1],["ومبيضَّةٍ مما قراه محمدٌ","أبوك لكي تَبيضَّ عِرْضاً ومَحتِدا",32,"د",2,0],["ومُبرِقةُ الحُتوفِ إذا أسالَتْ","دماءَ الشَّيبِ شابَ لها الوليدُ",33,"د",1,0],["ومبتسمٍ والطعنُ يَخضِبُ رُمحَه","كأنْ قد رأى منه بَناناً مُخَضَّبا",34,"ب",2,0],["ومباسماً تجلو شقائقَ روضةٍ","للأقحُوَانَةِ بينها نُوّارُ",35,"ر",1,0],["وَمُبَيِّنٌ لَكُمُ غَثاثَتَها","لَفظُ اِبنِ أَعمَشَ عِندَها سَمَرُ",36,"ر",1,0],["وَمُبتَدِرُ المَعروفِ تَسري هِباتُهُ","إِلَيهِم وَلا تَسري إِلَيهِم غَوائِلُه",37,"ل",2,0],["وَمَبثوثَةٍ دعَّاءَةٍ أَخَذَتكُمو","قَديماً بِأَمثالِ الأَباءِ المُضَرَّمِ",38,"م",1,0],["وَمُبارَكُ الآثارِ لَو وَطِىءَ الصَفا","لَجَرى بِمُنهَلِّ النَدى وَتَفَجَّرا",39,"ر",2,0],["وَمُبتَسِمٍ ضاحِكٍ وَجهُهُ","إِذا صالَ كُلُّ فَتىً باسِلِ",40,"ل",1,0],["وَمَبضوعَةً مِن رَأسِ فَرعٍ شَظِيَّةٍ","بِطَودٍ تَراهُ بِالسَحابِ مُجَلَّلا",41,"ل",2,0],["ومُبتدى عشرينَ مات الحاجبْ","مُوسى الذي كانَ الشهابَ الثاقبْ",42,"ب",1,0],["وَمُبْصِر لِلناسِ فِي أَرْزَاقِهِمْ","بِمَوَارِدٍ تُجْلى لَهُمْ وَمَصَادِرِ",43,"ر",1,0],["وَمُبْتَكَرَاتٌ كُلَّ آنٍ جَدِيدَةٌ","لَهَا مِنْ أَفَانِينِ الحِلَى كُلُّ رَوْنَقِ",44,"ق",1,0],["ومِبضعُ كلِّ مكلوم، وسوطٌ","يؤدِّبُ كلَّ جبَّارٍ عنيد",45,"د",1,0],["ومُبْدلُ الأُنس بالاكتِئَاب","وطاعنُ الصيف بلا حِرَاب",46,"ب",1,0],["وَمَبْعَثٍ لِلفِكْرِ وَالذَّكَاءِ","وَمُنْتَدىً لِلشِعْرِ وَالغِنَاءِ",47,"ا",2,0],["وَمُبَرَّأً مِنْ كُلِّ غُبَّرِ حَيْضَةٍ","وَرَضَاعِ مُغِيلَةٍ وَدَاءٍ مُعْضِلِ",48,"ل",1,0],["ومُبَاحٌ ممّا يُحَضِّنُهُ السُّو","رُ، وَلَوْ بَاتَ دُونَهُ مَعشْروضَا",49,"ض",2,0],["وَمُبَطرِقُ البِطريقِ يَأبى مِثلَهُ","إِن أَنتَ لَم تُعطِ الرَسولَ ذِماما",50,"م",2,0],["وَمُبَذَّلاتٍ لِلصَوارِمِ وَالقَنا","وَمُبَدَّلاتٍ العَليقِ شَكيما",51,"م",2,0],["ومبسم الصبح زانته كواكبه","كما تزين ثغر الكأس بالحبب",52,"ب",1,0],["وَمُبدِيَةٍ تِيهاً عَلَيَّ وَقَد رَأَت","بَياضاً بِرأسي قَد بَدا مِنهُ رَيعانُ",53,"ن",1,0],["ومُبخِّلَ الكرماءِ أَيْسَرُ جودِه","فكأنما حَسناتُهم أوزار",54,"ر",1,0],["ومبيد مُلْكِ الرومِ بالنصرِ الذي","نَطَقَت به الآياتُ من إنجليه",55,"ل",3,0],["وَمبجّلاً ومفضّلاً ومعظّما","وَمُتحّياً ومصلّياً ومسلّما",56,"م",2,0],["ومبسمها بما فيه","فأين الخمر والورد",57,"د",1,0],["ومبشِّري بقدوم مَن أهواهُ","لازال وهو مُبَشَّرٌ بمناهُ",58,"ه",1,1],["ومبتدئا يعطيك قبل سؤاله","حياء ويخشى ان تقول فيخجلا",59,"ل",2,0],["ومبتدئا يعطيك قبل سؤاله","علىغير مدح فوق ما انت سائله",60,"ل",2,0],["ومبسَمَكِ الدُّريَّ بالبرقِ والطِلا","بجيد طلاء الرِيم في مَهْمَةٍ قَفْرِ",61,"ر",1,0],["ومُبْتَدٍ لبناء وهو هادمُه","ومُدَّعٍ لصواب وهو لم يُصِب",62,"ب",1,0],["ومبكر يطوي جلابيب الفلا","عجلا غدا لا يستقر رسيمه",63,"م",2,0],["ومبكّر جدّت به عزماته","نحو العلى فاغذ لا يتثبط",64,"ط",1,0],["وَمُبيدَ شَملِ المالِ حَتّى خِلتَهُ","أَمسى يُنافِسُهُ عَلى عَليائِهِ",65,"ا",3,0],["وَمُبَشِّراتُكَ كَيفَ عُدنَ سَمائِماً","هوجاً وَكُنَّ عَلى القُلوبِ شَمالا",66,"ل",2,0],["وَمَبسوطٌ بِنائِلِهِ يَداهُ","اذا قَبِضَت بِهِ أَيدي الشِحاحِ",67,"ح",1,0],["ومباركٌ بكماله","نادى الكمال الايجل",68,"ل",1,0],["ومبرّزاً إِن رام سَبقاً أَقصَرت","عن أَن تحاولَ شأوَه أَقرانُهُ",69,"ن",2,0],["وَمُبخّلٍ بِالمالِ قُلتُ لَعَلَّهُ","يَنْدَى وَظَنّي فيهِ ظَنٌ مُخْلِفُ",70,"ف",1,1],["ومَبيتي ساهراً مُرتفِقاً","بالفلا والنِّضْو مَعقولٌ إزائي",71,"ا",2,0],["ومَبيتي مؤُرَّقاً طُولَ لَيلي","واقتْضائي مَدائحَ الكُبَراء",72,"ا",2,0],["ومبسمٌ لاحَ لنا من ضَوئِه","بَرقٌ ولكن ليسَ للبرقِ بقا",73,"ا",1,0],["ومبلغاً عن أحمد","خير الورى علماً وزهدا",74,"د",2,0],["ومبيدُ أملاكِ الفرنْ","جِ وجمعَهم حالاً فَحالا",75,"ل",2,0],["ومبتسم بوجه الضَّيف زاه","ووجه الدَّهر مشتدّ القطوب",76,"ب",1,0],["ومُبدي كلِّ مكرمةٍ معيدٌ","فيا لله من مبدٍ معيد",77,"د",1,0],["ومبانيه تملك اللبّ في الحسن","بلاغاً وحكمة واختصارا",78,"ر",2,0],["ومباني المجد في أفعاله","قد بناهنّ البناءَ المحكما",79,"م",2,0],["ومبدّد الأموال مهلكها","بالمكرمات لخالد الذكر",80,"ر",1,0],["ومبسم يفترّ عن لؤلوءٍ","منتظمٍ قد حيّر الناظمين",81,"ن",1,0],["ومُبَشِّرُ الأَيامِ أن تبقى لَهَا","ومبشّرُ الإِسلامِ أن تبقى لَنَا",82,"ن",2,0],["وَمَبسِمُكِ الوضَّاحُ أم ضوءُ بارِقٍ","حَداهُ دُعائي أن يجودَ ديارَكِ",83,"ك",1,0],["ومُبارِزَ الأُسْدِ الغِضابِ وَقَدْ غَلَتْ","حربٌ تُوَكِّلُ بالحتوفِ هِياجَهَا",84,"ج",3,0],["ومبتسم الأَحباب فِي جنباتها","أَقاحٍ كَساهُنَّ الربيع رُباها",85,"ا",3,0],["ومبينللمشكلات بعلم اك","تسبته همته وعلم ذاتي",86,"ي",1,0],["ومبهمَةٍ مذكَّرة زَبونٍ","تخال شَرار جاحمها ضِرامَهْ",87,"م",2,0],["ومبرَمةٌ الأسبابِ شائعُ ذكرِها","رقيبٌ على نعماك لي ووكيلُ",88,"ل",1,0],["ومبتسمين يُوري الملكُ منهم","جباهاً كلُّ واضحةٍ زنادُ",89,"د",1,0],["ومبرك أنضاءٍ ومُلقى سوابغِ","ومسحب أرماحٍ ومنْضى سوابق",90,"ق",1,0],["ومُبْهمةٍ كَدآدي الشتاءِ","تزيدُ الرَّويَّةُ اِشكالها",91,"ل",3,0],["ومبتسمٌ في الحفل والدمعُ غائضٌ","له بين أثناء الضُّلوعِ مَسيلُ",92,"ل",1,0],["ومُبتْاعُ حمدٍ من قريشٍ كأنما","مُحيَّاه شمس الصبح عالٍ طلوعها",93,"ه",2,0],["ومُبادي كُلِّ دَجْنٍ بارقٍ","بالمُحَيَّا الطَّلْقِ والكفِّ النَّدي",94,"د",2,0],["ومُبْتسمٌ للخطب والخطبُ كالحٌ","ولكن عن العوراء والشرّ باسِرُ",95,"ر",1,0],["ومُبْتسمٌ والبيض تبكي غُروبُها","بأحْمَرَ من ماءِ المَفارقِ ساكِب",96,"ب",1,0],["ومبشر مؤديها آداءً متمماً","بنيل الرضا والأجر يعطاه وافرا",97,"ر",2,0],["ومباهٍ بهِ الرجالَ وقد جلَّ","مكان الفخار في الأقوام",98,"م",1,0],["ومباهٍ بمدحه في البرايا","نكت السحر في عيون الملاح",99,"ح",1,0],["ومبسمُ الصبح زانتهُ كواكبهُ","كما يزيَّن ثغراُ الكأس بالحبب",100,"ب",1,0],["ومباسمٍ عَذُبَتْ موارِدُ ظَلِمْها","فحمتْهُ أسهمُ لحظِها أن يُوردا",101,"د",2,0],["ومبتسمٍ أضحتْ لآليءُ ثغرِهِ","تُخَجَّلُ منضودَ الفرائدِ بالنظمِ",102,"م",1,0],["ومباحٌ لهمُ أن يمنعوا","لرضاهمْ مقلتي مِن أن تناما",103,"م",2,0],["ومبلغ علمه أني شريف","نظيره هزّني شرف المقام",104,"م",1,0],["ومبسِمُه الدِّرّي تَأرَّجَ عِطرُهُ","ولم ترَ من دُرٍّ تَنَفسَّ عَن عِطِر",105,"ر",1,0],["ومُبَرّأٍ من كلّ ما شمل الورى","ألقيتُ من ثِقَتي إليه عِناني",106,"ي",1,0],["ومبلَّغٌ آمالُهُ ومُخيَّبٌ","ومُجرِّرٌ ذيلَ الثّراءِ ومُعْدِمُ",107,"م",1,0],["ومُبارزٌ ..حمَلَ الهوى سيفاً","لا عفْوَ يُقنعُهُ ولا صلْحُ",108,"ح",1,0],["وَمَبْسِمْ عذبِ الأَشَرْ","فيه مع الطّيبِ خَصَرْ",109,"ر",1,0],["ومبشِّراً برضى ومغفرةٍ","وبنعمةٍ جعلتْك مَوْئِلَها",110,"ل",3,0],["ومبيدُ الحقودِ عَفْواً وصَفْحاً","رُبَّما شَانَت الكِرَامَ الحُقودُ",111,"د",1,0]]}