الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5431,"وبمثله هو يقتدي العظماء","https://www.poetsgate.com/ViewPoem.aspx?id=194798",""],[5431,"قصيدة قلقه...","https://www.poetsgate.com/ViewPoem.aspx?id=201108",""],[5431,"الحمد لله من قلبِ به سكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201907",""],[5431,"وكل قصيدة عتق...","https://www.poetsgate.com/ViewPoem.aspx?id=208652",""],[5431,"جنون مثلي...3","https://www.poetsgate.com/ViewPoem.aspx?id=212848",""],[5452,"سيّد الخلق","https://www.poetsgate.com/ViewPoem.aspx?id=149040",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5582,"جَفا جَفْنَهُ يَوْمَ الفِراقِ رُقادُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186903",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5582,"لِمن مربع بالسفحِ أَقوت ملاعبه","https://www.poetsgate.com/ViewPoem.aspx?id=63464",""],[3469,"أمِنْ طَلَل قَفْرٍ ومن منزلٍ عافِ","https://www.poetsgate.com/ViewPoem.aspx?id=17623",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5725,"زين الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=206115",""],[5732,"دار لنا","https://www.poetsgate.com/ViewPoem.aspx?id=177832",""],[5818,"في شفتيّ يرتعش الدعاء","https://www.poetsgate.com/ViewPoem.aspx?id=200200",""],[5939,"عاشقةٌ من حزب الكنبة!","https://www.poetsgate.com/ViewPoem.aspx?id=180001",""],[5943,"خسارة","https://www.poetsgate.com/ViewPoem.aspx?id=14669",""],[5943,"الموت حرقًا","https://www.poetsgate.com/ViewPoem.aspx?id=34329",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5964,"على الخيف من أكناف برقة أطلال","https://www.poetsgate.com/ViewPoem.aspx?id=181306",""],[5977,"لقاءات الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=213126",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6031,"ألاَ قُلْ لأحفَى النَّاسِ بِي وأَبَرَّهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46396",""],[6075,"لَا تُخْفِ دَمْعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=201606",""],[6078,"سلافة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=202777",""],[6101,"مبتور عدوك / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["وَمُبَخِّلٍ أَعطى القَليلَ وَرُبَّما","سَمَحَت حُروفُ التاءِ لِلتَمتامِ",0,"م",1,0],["وَمَبنى قِبابِ بَني عامِرٍ","عَلى الغَورِ أَطنابُهُنَّ العَوالي",1,"ل",2,0],["وَمُبَخَّلٍ شَهِدَت عَلَيهِ يَمينُهُ","في حَيثُ يَمنَعُها النَدى وَيَعوقُ",2,"ق",1,0],["وَمُبتَسِمٌ يَرتَجُّ في ماءِ حُسنِهِ","لَهُ مِن عُيونِ الناظِرينَ فَواقِعُ",3,"ع",1,0],["وَمُبَخَّلٍ إِن جادَ بَعدَ مَدىً","فَالماءُ يَطلُعُ مِن صَفاً صَلدِ",4,"د",1,0],["وَمَبسِمَها عَن شَتيتِ النَبا","تِ غَيرِ أَكَسٍّ وَلا مُنقَضِم",5,"م",1,0],["وَمَبثوثَةٍ مِثلَ الجَرادِ وَزَعتَها","لَها زَجَلٌ يَملا القُلوبَ مِنَ الذُعرِ",6,"ر",1,0],["وَمُبدٍ لَنا ضِغناً وَلَولا رِماحُنا","بِأَرضِ العِدى لَم يَرعَ صَوبَ البَوارِقِ",7,"ق",1,0],["وَمُبَلِّغٍ يَومَ الصُراخِ مُنَدِّدٍ","بِعِنانِ دامِيَةِ الفُروجِ كَليمِ",8,"م",1,0],["ومبيضّ آثارِ الصنائع أحمدت","مناقبه أيام كلّ مسود",9,"د",1,0],["ومبشّر بالقاصدين كأنه","وأبيك قاصدها وطالب جودها",10,"د",3,0],["ومبسماً لبهيِّ الدّرّ متَّسقاً","كأنه لبهاء الدِّين ألفاظ",11,"ظ",1,0],["ومبلغ علم بإعجازه","رمى في حشا الندّ بالحارق",12,"ق",1,0],["ومبتسم فيه اللآلي يتيمة","وليس على أسلاكه ذلة اليتم",13,"م",1,0],["ومبسمك العذب أم بارقٌ","تحثُّ سحائب أجفانيه",14,"ي",2,0],["ومبادلين بدمعتين حلاهما","هذا لهذا قائم بولائهِ",15,"ه",1,1],["ومُبتغِي العيشِ بعد خِلٍّ","كاذِبُهُ خُلَّةَ الصفاءِ",16,"ا",2,0],["ومبيتي بلا ضجيعٍ لدى القر","رِ وللوغد شادِنٌ مخضوبُ",17,"ب",1,0],["ومبتسمٌ للمدح في ذي مروءةٍ","فلما درى أنْ لم يثوِّبه كلَّحا",18,"ح",2,0],["وَمُبارَكُ الغَدَواتِ لا","يَبدو لَهُ إِلّا سَنيحُه",19,"ح",2,0],["وَمَبسَمّا نُظِّم مِن جَوهَرٍ","وَماؤُهُ مِن أَعطَرِ الخَمرِ",20,"ر",1,0],["وَمُبَشِّرٍ بِالصُلحِ قُلتُ لَعَلَّهُ","خَيرٌ عَسى أَن تَصدُقَ الأَحلامُ",21,"م",1,0],["وَمَبثوثَةً لا تُتَّقى بِطَليعَةٍ","وَلا يُحتَمى مِنها بِغَورٍ وَلا نَجدِ",22,"د",1,0],["وَمُبتَسِماتِ هَيجاواتِ عَصرٍ","عَنِ الأَسيافِ لَيسَ عَنِ الثُغورِ",23,"ر",1,0],["ومبذولةٌ يومَ الطِّرادِ يصونُها","من النَّقْعِ جُلٌّ أو من الدمِ بُرْقُعُ",24,"ع",1,0],["ومبسِمُ ابنِ رسولِ اللّه قد عبثتْ","بنو زيادٍ بثَغْرٍ منه منكوتِ",25,"ت",1,0],["وَمُبينَةٍ شَهَرَ المُنازِلُ وَسمَها","وَالخَيلُ تَكبو في العَجاجِ الكابي",26,"ب",2,0],["وَمُبَجَّلٌ وَسَطَ الرِجالِ خُفوفُهُم","لِقِيامِهِ وَقِيامُهُم لِقُعودِهِ",27,"د",2,0],["وَمُبارَكٌ ميلادُ مُلكِكَ مُخبِرٌ","بِقَريبِ عَهدٍ كانَ مِن ميلادِهِ",28,"د",2,0],["وَمُباحٌ مِمّا يُحَصِّنُهُ السو","رُ وَلَو باتَ دونَهُ مَعروضا",29,"ض",2,0],["ومبثوثة في كل شرق ومغرب","لها أمهات بالعراق قواطن",30,"ن",1,1],["ومَبنِيَّةٍ من خَيْزُرانٍ مُفَضَّضٍ","يُقَدِّمُها ِخشْفٌ من الإِنْسِ أروَعُ",31,"ع",1,1],["ومبيضَّةٍ مما قراه محمدٌ","أبوك لكي تَبيضَّ عِرْضاً ومَحتِدا",32,"د",2,0],["ومُبرِقةُ الحُتوفِ إذا أسالَتْ","دماءَ الشَّيبِ شابَ لها الوليدُ",33,"د",1,0],["ومبتسمٍ والطعنُ يَخضِبُ رُمحَه","كأنْ قد رأى منه بَناناً مُخَضَّبا",34,"ب",2,0],["ومباسماً تجلو شقائقَ روضةٍ","للأقحُوَانَةِ بينها نُوّارُ",35,"ر",1,0],["وَمُبَيِّنٌ لَكُمُ غَثاثَتَها","لَفظُ اِبنِ أَعمَشَ عِندَها سَمَرُ",36,"ر",1,0],["وَمُبتَدِرُ المَعروفِ تَسري هِباتُهُ","إِلَيهِم وَلا تَسري إِلَيهِم غَوائِلُه",37,"ل",2,0],["وَمَبثوثَةٍ دعَّاءَةٍ أَخَذَتكُمو","قَديماً بِأَمثالِ الأَباءِ المُضَرَّمِ",38,"م",1,0],["وَمُبارَكُ الآثارِ لَو وَطِىءَ الصَفا","لَجَرى بِمُنهَلِّ النَدى وَتَفَجَّرا",39,"ر",2,0],["وَمُبتَسِمٍ ضاحِكٍ وَجهُهُ","إِذا صالَ كُلُّ فَتىً باسِلِ",40,"ل",1,0],["وَمَبضوعَةً مِن رَأسِ فَرعٍ شَظِيَّةٍ","بِطَودٍ تَراهُ بِالسَحابِ مُجَلَّلا",41,"ل",2,0],["ومُبتدى عشرينَ مات الحاجبْ","مُوسى الذي كانَ الشهابَ الثاقبْ",42,"ب",1,0],["وَمُبْصِر لِلناسِ فِي أَرْزَاقِهِمْ","بِمَوَارِدٍ تُجْلى لَهُمْ وَمَصَادِرِ",43,"ر",1,0],["وَمُبْتَكَرَاتٌ كُلَّ آنٍ جَدِيدَةٌ","لَهَا مِنْ أَفَانِينِ الحِلَى كُلُّ رَوْنَقِ",44,"ق",1,0],["ومِبضعُ كلِّ مكلوم، وسوطٌ","يؤدِّبُ كلَّ جبَّارٍ عنيد",45,"د",1,0],["ومُبْدلُ الأُنس بالاكتِئَاب","وطاعنُ الصيف بلا حِرَاب",46,"ب",1,0],["ومباهج ما إن يروقك مشهد","من حسنه حتّى يشوقك مشهد",47,"د",1,0],["وَمَبْعَثٍ لِلفِكْرِ وَالذَّكَاءِ","وَمُنْتَدىً لِلشِعْرِ وَالغِنَاءِ",48,"ا",2,0],["وَمُبَرَّأً مِنْ كُلِّ غُبَّرِ حَيْضَةٍ","وَرَضَاعِ مُغِيلَةٍ وَدَاءٍ مُعْضِلِ",49,"ل",1,0],["ومُبَاحٌ ممّا يُحَضِّنُهُ السُّو","رُ، وَلَوْ بَاتَ دُونَهُ مَعشْروضَا",50,"ض",2,0],["ومبدل حرفا بحرف ان يكن","عن آفة أو فطرة وقع الأثر",51,"ر",1,0],["وَمُبَطرِقُ البِطريقِ يَأبى مِثلَهُ","إِن أَنتَ لَم تُعطِ الرَسولَ ذِماما",52,"م",2,0],["وَمُبَذَّلاتٍ لِلصَوارِمِ وَالقَنا","وَمُبَدَّلاتٍ العَليقِ شَكيما",53,"م",2,0],["ومبسم الصبح زانته كواكبه","كما تزين ثغر الكأس بالحبب",54,"ب",1,0],["وَمُبدِيَةٍ تِيهاً عَلَيَّ وَقَد رَأَت","بَياضاً بِرأسي قَد بَدا مِنهُ رَيعانُ",55,"ن",1,0],["ومُبخِّلَ الكرماءِ أَيْسَرُ جودِه","فكأنما حَسناتُهم أوزار",56,"ر",1,0],["ومبيد مُلْكِ الرومِ بالنصرِ الذي","نَطَقَت به الآياتُ من إنجليه",57,"ل",3,0],["وَمبجّلاً ومفضّلاً ومعظّما","وَمُتحّياً ومصلّياً ومسلّما",58,"م",2,0],["ومبسمها بما فيه","فأين الخمر والورد",59,"د",1,0],["ومبشِّري بقدوم مَن أهواهُ","لازال وهو مُبَشَّرٌ بمناهُ",60,"ه",1,1],["ومبتدئا يعطيك قبل سؤاله","حياء ويخشى ان تقول فيخجلا",61,"ل",2,0],["ومبتدئا يعطيك قبل سؤاله","علىغير مدح فوق ما انت سائله",62,"ل",2,0],["ومبسَمَكِ الدُّريَّ بالبرقِ والطِلا","بجيد طلاء الرِيم في مَهْمَةٍ قَفْرِ",63,"ر",1,0],["ومُبْتَدٍ لبناء وهو هادمُه","ومُدَّعٍ لصواب وهو لم يُصِب",64,"ب",1,0],["ومبكر يطوي جلابيب الفلا","عجلا غدا لا يستقر رسيمه",65,"م",2,0],["ومبكّر جدّت به عزماته","نحو العلى فاغذ لا يتثبط",66,"ط",1,0],["وَمُبيدَ شَملِ المالِ حَتّى خِلتَهُ","أَمسى يُنافِسُهُ عَلى عَليائِهِ",67,"ا",3,0],["وَمُبَشِّراتُكَ كَيفَ عُدنَ سَمائِماً","هوجاً وَكُنَّ عَلى القُلوبِ شَمالا",68,"ل",2,0],["وَمَبسوطٌ بِنائِلِهِ يَداهُ","اذا قَبِضَت بِهِ أَيدي الشِحاحِ",69,"ح",1,0],["ومباركٌ بكماله","نادى الكمال الايجل",70,"ل",1,0],["ومبرّزاً إِن رام سَبقاً أَقصَرت","عن أَن تحاولَ شأوَه أَقرانُهُ",71,"ن",2,0],["وَمُبخّلٍ بِالمالِ قُلتُ لَعَلَّهُ","يَنْدَى وَظَنّي فيهِ ظَنٌ مُخْلِفُ",72,"ف",1,1],["ومَبيتي ساهراً مُرتفِقاً","بالفلا والنِّضْو مَعقولٌ إزائي",73,"ا",2,0],["ومَبيتي مؤُرَّقاً طُولَ لَيلي","واقتْضائي مَدائحَ الكُبَراء",74,"ا",2,0],["ومبسمٌ لاحَ لنا من ضَوئِه","بَرقٌ ولكن ليسَ للبرقِ بقا",75,"ا",1,0],["ومبلغاً عن أحمد","خير الورى علماً وزهدا",76,"د",2,0],["ومبيدُ أملاكِ الفرنْ","جِ وجمعَهم حالاً فَحالا",77,"ل",2,0],["ومبتسم بوجه الضَّيف زاه","ووجه الدَّهر مشتدّ القطوب",78,"ب",1,0],["ومُبدي كلِّ مكرمةٍ معيدٌ","فيا لله من مبدٍ معيد",79,"د",1,0],["ومبانيه تملك اللبّ في الحسن","بلاغاً وحكمة واختصارا",80,"ر",2,0],["ومباني المجد في أفعاله","قد بناهنّ البناءَ المحكما",81,"م",2,0],["ومبدّد الأموال مهلكها","بالمكرمات لخالد الذكر",82,"ر",1,0],["ومبسم يفترّ عن لؤلوءٍ","منتظمٍ قد حيّر الناظمين",83,"ن",1,0],["ومُبَشِّرُ الأَيامِ أن تبقى لَهَا","ومبشّرُ الإِسلامِ أن تبقى لَنَا",84,"ن",2,0],["وَمَبسِمُكِ الوضَّاحُ أم ضوءُ بارِقٍ","حَداهُ دُعائي أن يجودَ ديارَكِ",85,"ك",1,0],["ومُبارِزَ الأُسْدِ الغِضابِ وَقَدْ غَلَتْ","حربٌ تُوَكِّلُ بالحتوفِ هِياجَهَا",86,"ج",3,0],["ومبتسم الأَحباب فِي جنباتها","أَقاحٍ كَساهُنَّ الربيع رُباها",87,"ا",3,0],["ومبينللمشكلات بعلم اك","تسبته همته وعلم ذاتي",88,"ت",2,0],["ومبهمَةٍ مذكَّرة زَبونٍ","تخال شَرار جاحمها ضِرامَهْ",89,"م",2,0],["ومبرَمةٌ الأسبابِ شائعُ ذكرِها","رقيبٌ على نعماك لي ووكيلُ",90,"ل",1,0],["ومبتسمين يُوري الملكُ منهم","جباهاً كلُّ واضحةٍ زنادُ",91,"د",1,0],["ومبرك أنضاءٍ ومُلقى سوابغِ","ومسحب أرماحٍ ومنْضى سوابق",92,"ق",1,0],["ومُبْهمةٍ كَدآدي الشتاءِ","تزيدُ الرَّويَّةُ اِشكالها",93,"ل",3,0],["ومبتسمٌ في الحفل