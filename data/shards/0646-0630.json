ViewPoem.aspx?id=205968",""],[5997,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=214219",""],[6019,"طيفاً أُعانقُ في محرابَكَ الأجلا","https://www.poetsgate.com/ViewPoem.aspx?id=143419",""],[6052,"شيخ القضية احمد","https://www.poetsgate.com/ViewPoem.aspx?id=35211",""],[6115,"عرفنا الشرود وبان من واجه الخصام","https://www.poetsgate.com/ViewPoem.aspx?id=196479",""],[6124,"سواد الهدب","https://www.poetsgate.com/ViewPoem.aspx?id=109744",""],[6131,"همسُ المَطَر","https://www.poetsgate.com/ViewPoem.aspx?id=189527",""],[6143,"عذرا رسول الله...","https://www.poetsgate.com/ViewPoem.aspx?id=175095",""],[6145,"ياسين طِبْ نفسا","https://www.poetsgate.com/ViewPoem.aspx?id=7802",""],[520,"نذرت لك العلى ونذرت برى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577432",""],[456,"لقاء الأندلس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84501&r=&rc=0",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""]],"verses":[["نَذارِ لَكُم مِن كَيدِهِ إِنَّ قَلبَهُ","ضَمومٌ عَلى الأَسرارِ غَيرُ مُذيلِ",0,"ل",1,0],["نَذارِ لَكُم مِن وَثبَةٍ ضَيغَميَّةٍ","لَها بَعدَ غَرّارِ السُكونِ حَراكُ",1,"ك",1,0],["نُذادُ وَيَروى الأَبعَدونَ بِمائِكُم","وَنَحنُ عَلى العِردِ الظِماءُ الخَوامِسُ",2,"س",1,0],["نَذبَحُ الدُبَّ وَنَفري جِلدَهُ","أَيَظُنُّ الدُبُّ أَلّا يُغلَبا",3,"ب",2,0],["نَذَرتُ شُكرَكَ لا أَنسى الوَفاءَ بِهِ","إِن أَسفَرَت لِيَ عَنها أَوجُهُ البُشَرِ",4,"ر",1,0],["نُذَكِّرُهُم بِاللَهِ مَن يُنهِلُ القَنا","وَيَفرِجُ ضيقَ المَأزِقِ المُتَلاحِمِ",5,"م",1,0],["نَذارِ نذارِ وإلا نظا","رِ مني قوارعَ تُوهِي الحديدا",6,"د",2,0],["نذيرٌ لما تُكْنَى به لذوي النُّهى","بشيرٌ لما تُسْمى به لا تُفنّدُ",7,"د",1,0],["نَذر الناسُ في القديم نذوراً","إنْ رأوا عيدك المأمَّل شكرا",8,"ر",2,0],["نذيري من عسى ولعل نفسي","ومن أختيهما حتى وسوفا",9,"ف",2,1],["نَذَرَتْ عصبةٌ بأنّيَ أستو","في رغيفاً وجانباً مِنْ قرينه",10,"ن",2,0],["نَذيراً وَما يُغني النَذيرُ بِشَبوَةٍ","لِمَن شاؤُهُ حَولَ البَدِيِّ وَجامِلُه",11,"ل",2,0],["نَذُمُّ السَحابَ الغُرَّ في فِعلِها بِهِ","وَنُعرِضُ عَنها كُلَّما طَلَعَت عَتبا",12,"ب",2,0],["نذرت أن أتركه مكتوما","سراً بختم ربه مختوما",13,"م",2,0],["نَذَارِ لقومٍ أخطأوا سُبُلَ الهُدى","فحاروا وتاهوا في الضَّلال وطخطَخُوا",14,"خ",3,0],["نَذَارِ لهم قبلَ التي لا شَوى لها","وعيداً يُصَكُّ السمعُ منه فَيُصمَخُ",14,"خ",1,0],["نَذيراً لَكُم مِنهُ بَشيراً لَكُم بِهِ","وَما لِيَ في هاتَينِ قَولَةُ كاذِبِ",15,"ب",1,0],["نَذُمُّ عَجزَ العُقولِ عَن خَطَرٍ","نَكيلُهُ بِالعُقولِ أَو نَزِنُه",16,"ن",2,0],["نَذرْتُ نذوراً فاقتضاني قضاءها","إيابُكَ من يوْمِ العروبة سالما",17,"م",2,0],["نُذادُ عن الحِياضِ ونحن هِيمٌ","فما نَرِدُ النِّطافَ ولا الجِماما",18,"م",2,0],["نَذودُ الوحشَ تطلُبنا جِياعاً","ونأبَى أن نكون لها طعاما",18,"م",2,0],["نذمُّ القائلين ولا حياةٌ","لمن يأبَى سبيلَ العاملينا",19,"ن",2,0],["نُذكِّرُهم بالمَشْرَفيِّ إذا نسوا","وللغافلِ النّاسي من الجهلِ شافعُ",20,"ع",1,0],["نَذكُرُ الحُكمَ ظالِماً ما رَأَينا","فيهِ عَدلاً وَلا وَجَدنا اِعتِدالا",21,"ل",2,0],["نَذكُرُ العَهدَ سَيِّئاً ما عَرَفنا","فيهِ حُرِّيَّةً وَلا اِستِقلالا",21,"ل",2,0],["نَذكُرُ الشَرَّ وَالبَلاءَ جَميعاً","فَاِذكُروا عَهدَكُم وَشُدّوا الرِحالا",21,"ل",2,0],["نَذرُ هندٍ هِيَ لولا أنها","لم تُسِغْها أكلتها أجمعا",22,"ع",2,0],["نَذرتْ يومَ أبيها نذْرها","عَلّها تشفِي الفُؤادَ المُوجَعا",22,"ع",2,0],["نَذَرَتْ إنْ جَمَعَتْ شَمْلِي لِبَابِكَ أَوْ","شَفَتْ فُؤَادِي بِهِ قَوْداءُ شِمْلِيلُ",23,"ل",1,0],["نَذَرُ الأَبطالَ صَرعى بَينَها","ما يَني مِنهُم كَمِيٌّ مُنعَفِر",24,"ر",1,0],["نَذَرُ الأَبطالَ صَرعى بَينَها","تَعكُفُ العِقبانُ فيها وَالرَخَم",25,"م",1,0],["نَذيرُ المَوْتِ أَرْسَلَهُ إليْنا","فَكَذَّبْنا بِما جاءَ النَّذيرُ",26,"ر",1,0],["نذيبُ بهِ صُلْبَ أعصابهم","وفي رِقَّةِ العود سِرُّ المناعهْ",27,"ه",1,0],["نذق قبلةً لا يعرفُ البؤسَ بعدها","ولا السقم روحانا ولا الجسدان",28,"ن",1,0],["نَذِيرٌ صَادِقٌ أدَّى كِتَاباً","وآياتٍ مبيَّنةً تُثيرُ",29,"ر",1,0],["نَذَرتُ دَمَ الأَعداءِ لَمّا نَظَرتهُ","كَأَنَّ عَدُوّاً شَجَّهُ فَشَجاني",30,"ن",2,0],["نذرت حياتي تحت ظل لوائه","وأحرزت خصلي اذ تحز الغلاصم",31,"م",1,0],["نَذيرَكَ مِن خَلْقٍ أُطيلَ امتهانُه","وإنْ باتَ في شكلِ الضَّعيفِ المُسالم",32,"م",1,0],["نَذيري من عسى ولعلَّ نسي","ومن أختيهما حتى وسوفا",33,"ف",2,1],["نذكر الخصر من غزالة أنس","كم بأعتابها استجار غضنفر",34,"ر",1,0],["نذوق شفاء العيش دون نعيمه","على أننا بالعيش أدرى وأعرف",35,"ف",1,0],["نذيل ذي صويحبة فضاعت","وقد ضاعت وُليدات النذيل",36,"ل",1,0],["نذلٌ تردَّى رداء الطيش واستَلبَت","منه الوقارَ خِلاَلُ الكبرِ والخُيُلاَ",37,"ل",2,0],["نذر العمر لأحلام الطلا","وطوى العمر انتشاء وانتباها",38,"ه",2,0],["نذرتَ إذا نلتَ هامَ الأمو","ر أن لا تُوشَّح بالكِبرياءِ",39,"ا",2,0],["نذر قرانا في صحائف خدهِ","لما بدا لا تظلمونَ فتيلا",40,"ل",2,0],["نذورا لمقدمك النذور وأسرفوا","واستحسن التبذير كل رشيد",41,"د",1,0],["نذكر الموت حين تدبر عنا","فإذا أقبلت فنحن ذهول",42,"ل",1,0],["نَذودُ بِذِكْرِ اللهِ عنّا مِنَ السُّرى","إِذا كانَ قلبانا بِنا يَجِفانِ",43,"ن",1,1],["نَذُوذُ بِذِكرِ اللهِ عَنَّا غَوَى الصِّبا","إِذا كانَ قَلبانا بِنا يَرِدانِ",44,"ن",1,0],["نَذُودُ النُّفُوسَ الحائماتِ عَنِ الهوى","إِذا كان قَلبانا بِنَا يَرِدَانِ",45,"ن",1,0],["نُذيقُكُمُ وَالمَوتُ يَبني سُرادِقاً","عَلَيكُم شَبا حَدِّ السُيوفِ البَواتِكِ",46,"ك",1,0],["نَذودُ أَخانا عَن أَخينا وَلَو نَرى","مَصالاً لَكُنّا الأَقرَبينَ نُتابِعُ",47,"ع",1,0],["نذل تقفطن بالنفا","ق ولف من جشع حزامه",48,"م",2,0],["نذق تملكه الغرو","ر فضل نهج الاستقامه",48,"م",2,0],["نذرت لها شقة مؤمنا","بأن الذي أخبرت لن يقع",49,"ع",1,0],["نَذَرتُ الصَومَ دَهري يَومَ تأتي","صَحيحَ الجِسمِ لِلَّه الحَميدِ",50,"د",1,0],["نذر فيه إذا التقينا","سكراً إلى الليل بعد سكر",51,"ر",1,0],["نذكره به بغير النفسِ","لذكرنا في حضرات القُدُسِ",52,"س",1,0],["نذوبُ صبابةً وهوىً ولطفاً","وروحانا المعذبتانِ روح",53,"ح",1,0],["نذوبُ على الوجه الذي تحجُبينه","ونقنعُ إن عزَّ اللقاءُ بنظرة",54,"ه",1,0],["نَذَرَتْ دَمِي قَبلَ اقْتِراحِ عِنَاقِها","فِئَةٌ لَها نَحوَ الأَذَى إِعْنَاقُ",55,"ق",1,0],["نَذَرتُ لِلَهِ نَذراً إِن حَظيتُ بِها","أَوَدُّ مِن وَصلَةٍ مِنهُ أُسائِلَها",56,"ل",3,0],["نذر العمر للغرام صبيا","وانقضى عمره ولم يجن شيّا",57,"ي",2,1],["ن