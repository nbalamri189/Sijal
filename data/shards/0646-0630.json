{"poems":[[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[86,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[73,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[27,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[51,"أيا ثقفي أراك الذي","https://www.aldiwan.net/poem11456.html","المتقارب"],[51,"تجرد من غمدين سيف مهند","https://www.aldiwan.net/poem61940.html","الطويل"],[51,"عظم الله يمن فطرك فطرا","https://www.aldiwan.net/poem62013.html","الخفيف"],[51,"نذيري من عسى ولعل نفسي","https://www.aldiwan.net/poem65448.html","الوافر"],[51,"قد يفي للصديق غير أمينه","https://www.aldiwan.net/poem66405.html","الخفيف"],[16,"من رجل أحبوه وناقتي","https://www.aldiwan.net/poem27672.html","الطويل"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[62,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[105,"صاحب السيفين ماذا صنعا","https://www.aldiwan.net/poem44212.html","الرمل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[76,"نجوم في المفارق ما تغور","https://www.aldiwan.net/poem39312.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202876","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[51,"نَذيري من عسى ولعلَّ نسي","https://www.poetsgate.com/ViewPoem.aspx?id=30774",""],[116,"ألم العشق في فؤادي أثر","https://www.aldiwan.net/poem41682.html","الخفيف"],[121,"سيعرقني يأسي ويغلبني ضني","https://www.aldiwan.net/poem49297.html","الطويل"],[133,"وقفت على التليل فبت ليلى","https://www.aldiwan.net/poem54646.html","الوافر"],[133,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[133,"سالت القطرة من كأسي التي","https://www.aldiwan.net/poem54931.html","الرمل"],[143,"نظرت ولم أبغ إلا شفائي","https://www.aldiwan.net/poem58423.html","المتقارب"],[161,"ردي جفونك عن حشاي قليلا","https://www.aldiwan.net/poem58771.html","الكامل"],[161,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[161,"لي في الله حسن ظن جميل","https://www.aldiwan.net/poem59139.html","السريع"],[178,"نذود بذكر الله عنا من السرى","https://www.aldiwan.net/poem4507.html","الطويل"],[182,"وبتنا فويق الحى لا نحن منهم","https://www.aldiwan.net/poem58729.html","الطويل"],[182,"خليلى إنى قد أرقت ونمتما","https://www.aldiwan.net/poem59077.html","الطويل"],[208,"ألا أبلغا عني ابن جذل","https://www.aldiwan.net/poem27922.html","الطويل"],[208,"عفا مجدل من أهله فمتالع","https://www.aldiwan.net/poem27933.html","الطويل"],[222,"ذهب الوفاء فلا ندامه","https://www.aldiwan.net/poem55272.html","مجزوء الكامل"],[222,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[253,"ألا يا ناصر الدين المرجى","https://www.aldiwan.net/poem1424.html",""],[257,"عمرك الله يا ابن عمرو","https://www.aldiwan.net/poem48441.html","مخلع البسيط"],[260,"الحمد للمذكور وهو الذاكر","https://www.aldiwan.net/poem35951.html","الرجز"],[271,"أسيدتي الظريفة أنت روح","https://www.aldiwan.net/poem35354.html","الوافر"],[271,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[276,"مهج تساق إلى الردى فتشاق","https://www.aldiwan.net/poem25476.html","الكامل"],[321,"عناية الله لا تخفى فضائلها","https://www.aldiwan.net/poem67172.html","البسيط"],[329,"نذر العمر للغرام صبيا","https://www.aldiwan.net/poem55029.html","الخفيف"],[343,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[350,"لأحمد في الذكر وصف عظيم","https://www.aldiwan.net/poem15879.html","المتقارب"],[365,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[365,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[406,"نذوب ولكننا لانتوب","https://www.aldiwan.net/poem50090.html","المتقارب"],[407,"بكرت عواذله تعاتبه","https://www.aldiwan.net/poem50158.html","أحذ الكامل"],[433,"دع العذل إني أكره العذل والغدرا","https://www.aldiwan.net/poem12480.html","الطويل"],[440,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[454,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[459,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[480,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[496,"نذير ولكنه صامت","https://www.aldiwan.net/poem9799.html","المتقارب"],[506,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[507,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[516,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[516,"نذرت لك العلا ونذرت بري","https://www.aldiwan.net/poem12007.html","الوافر"],[516,"فدى لبني رزيك قوم رفعتهم","https://www.aldiwan.net/poem12149.html","الطويل"],[559,"لا معه نحن ولا معنا","https://www.aldiwan.net/poem33753.html","السريع"]],"verses":[["نَذارِ لَكُم مِن كَيدِهِ إِنَّ قَلبَهُ","ضَمومٌ عَلى الأَسرارِ غَيرُ مُذيلِ",0,"ل",1,0],["نَذارِ لَكُم مِن وَثبَةٍ ضَيغَميَّةٍ","لَها بَعدَ غَرّارِ السُكونِ حَراكُ",1,"ك",1,0],["نُذادُ وَيَروى الأَبعَدونَ بِمائِكُم","وَنَحنُ عَلى العِردِ الظِماءُ الخَوامِسُ",2,"س",1,0],["نَذبَحُ الدُبَّ وَنَفري جِلدَهُ","أَيَظُنُّ الدُبُّ أَلّا يُغلَبا",3,"ب",2,0],["نَذَرتُ شُكرَكَ لا أَنسى الوَفاءَ بِهِ","إِن أَسفَرَت لِيَ عَنها أَوجُهُ البُشَرِ",4,"ر",1,0],["نُذَكِّرُهُم بِاللَهِ مَن يُنهِلُ القَنا","وَيَفرِجُ ضيقَ المَأزِقِ المُتَلاحِمِ",5,"م",1,0],["نَذارِ نذارِ وإلا نظا","رِ مني قوارعَ تُوهِي الحديدا",6,"د",2,0],["نذيرٌ لما تُكْنَى به لذوي النُّهى","بشيرٌ لما تُسْمى به لا تُفنّدُ",7,"د",1,0],["نَذر الناسُ في القديم نذوراً","إنْ رأوا عيدك المأمَّل شكرا",8,"ر",2,0],["نذيري من عسى ولعل نفسي","ومن أختيهما حتى وسوفا",9,"ف",2,1],["نَذَرَتْ عصبةٌ بأنّيَ أستو","في رغيفاً وجانباً مِنْ قرينه",10,"ن",2,0],["نَذيراً وَما يُغني النَذيرُ بِشَبوَةٍ","لِمَن شاؤُهُ حَولَ البَدِيِّ وَجامِلُه",11,"ل",2,0],["نَذُمُّ السَحابَ الغُرَّ في فِعلِها بِهِ","وَنُعرِضُ عَنها كُلَّما طَلَعَت عَتبا",12,"ب",2,0],["نذرت أن أتركه مكتوما","سراً بختم ربه مختوما",13,"م",2,0],["نَذَارِ لقومٍ أخطأوا سُبُلَ الهُدى","فحاروا وتاهوا في الضَّلال وطخطَخُوا",14,"خ",3,0],["نَذَارِ لهم قبلَ التي لا شَوى لها","وعيداً يُصَكُّ السمعُ منه فَيُصمَخُ",14,"خ",1,0],["نَذيراً لَكُم مِنهُ بَشيراً لَكُم بِهِ","وَما لِيَ في هاتَينِ قَولَةُ كاذِبِ",15,"ب",1,0],["نَذُمُّ عَجزَ العُقولِ عَن خَطَرٍ","نَكيلُهُ بِالعُقولِ أَو نَزِنُه",16,"ن",2,0],["نَذرْتُ نذوراً فاقتضاني قضاءها","إيابُكَ من يوْمِ العروبة سالما",17,"م",2,0],["نُذادُ عن الحِياضِ ونحن هِيمٌ","فما نَرِدُ النِّطافَ ولا الجِماما",18,"م",2,0],["نَذودُ الوحشَ تطلُبنا جِياعاً","ونأبَى أن نكون لها طعاما",18,"م",2,0],["نذمُّ القائلين ولا حياةٌ","لمن يأبَى سبيلَ العاملينا",19,"ن",2,0],["نُذكِّرُهم بالمَشْرَفيِّ إذا نسوا","وللغافلِ النّاسي من الجهلِ شافعُ",20,"ع",1,0],["نَذكُرُ الحُكمَ ظالِماً ما رَأَينا","فيهِ عَدلاً وَلا وَجَدنا اِعتِدالا",21,"ل",2,0],["نَذكُرُ العَهدَ سَيِّئاً ما عَرَفنا","فيهِ حُرِّيَّةً وَلا اِستِقلالا",21,"ل",2,0],["نَذكُرُ الشَرَّ وَالبَلاءَ جَميعاً","فَاِذكُروا عَهدَكُم وَشُدّوا الرِحالا",21,"ل",2,0],["نَذرُ هندٍ هِيَ لولا أنها","لم تُسِغْها أكلتها أجمعا",22,"ع",2,0],["نَذرتْ يومَ أبيها نذْرها","عَلّها تشفِي الفُؤادَ المُوجَعا",22,"ع",2,0],["نَذَرَتْ إنْ جَمَعَتْ شَمْلِي لِبَابِكَ أَوْ","شَفَتْ فُؤَادِي بِهِ قَوْداءُ شِمْلِيلُ",23,"ل",1,0],["نَذَرُ الأَبطالَ صَرعى بَينَها","ما يَني مِنهُم كَمِيٌّ مُنعَفِر",24,"ر",1,0],["نَذَرُ الأَبطالَ صَرعى بَينَها","تَعكُفُ العِقبانُ فيها وَالرَخَم",25,"م",1,0],["نَذيرُ المَوْتِ أَرْسَلَهُ إليْنا","فَكَذَّبْنا بِما جاءَ النَّذيرُ",26,"ر",1,0],["نذيبُ بهِ صُلْبَ أعصابهم","وفي رِقَّةِ العود سِرُّ المناعهْ",27,"ه",1,0],["نذق قبلةً لا يعرفُ البؤسَ بعدها","ولا السقم روحانا ولا الجسدان",28,"ن",1,0],["نَذِيرٌ صَادِقٌ أدَّى كِتَاباً","وآياتٍ مبيَّنةً تُثيرُ",29,"ر",1,0],["نَذَرتُ دَمَ الأَعداءِ لَمّا نَظَرتهُ","كَأَنَّ عَدُوّاً شَجَّهُ فَشَجاني",30,"ن",2,0],["نَذيرَكَ مِن خَلْقٍ أُطيلَ امتهانُه","وإنْ باتَ في شكلِ الضَّعيفِ المُسالم",31,"م",1,0],["نَذيري من عسى ولعلَّ نسي","ومن أختيهما حتى وسوفا",32,"ف",2,1],["نذكر الخصر من غزالة أنس","كم بأعتابها استجار غضنفر",33,"ر",1,0],["نذوق شفاء العيش دون نعيمه","على أننا بالعيش أدرى وأعرف",34,"ف",1,0],["نذيل ذي صويحبة فضاعت","وقد ضاعت وُليدات النذيل",35,"ل",1,0],["نذلٌ تردَّى رداء الطيش واستَلبَت","منه الوقارَ خِلاَلُ الكبرِ والخُيُلاَ",36,"ل",2,0],["نذر العمر لأحلام الطلا","وطوى العمر انتشاء وانتباها",37,"ه",2,0],["نذرتَ إذا نلتَ هامَ الأمو","ر أن لا تُوشَّح بالكِبرياءِ",38,"ا",2,0],["نذر قرانا في صحائف خدهِ","لما بدا لا تظلمونَ فتيلا",39,"ل",2,0],["نذورا لمقدمك النذور وأسرفوا","واستحسن التبذير كل رشيد",40,"د",1,0],["نذكر الموت حين تدبر عنا","فإذا أقبلت فنحن ذهول",41,"ل",1,0],["نَذودُ بِذِكْرِ اللهِ عنّا مِنَ السُّرى","إِذا كانَ قلبانا بِنا يَجِفانِ",42,"ن",1,1],["نَذُوذُ بِذِكرِ اللهِ عَنَّا غَوَى الصِّبا","إِذا كانَ قَلبانا بِنا يَرِدانِ",43,"ن",1,0],["نَذُودُ النُّفُوسَ الحائماتِ عَنِ الهوى","إِذا كان قَلبانا بِنَا يَرِدَانِ",44,"ن",1,0],["نُذيقُكُمُ وَالمَوتُ يَبني سُرادِقاً","عَلَيكُم شَبا حَدِّ السُيوفِ البَواتِكِ",45,"ك",1,0],["نَذودُ أَخانا عَن أَخينا وَلَو نَرى","مَصالاً لَكُنّا الأَقرَبينَ نُتابِعُ",46,"ع",1,0],["نذل تقفطن بالنفا","ق ولف من جشع حزامه",47,"م",2,0],["نذق تملكه الغرو","ر فضل نهج الاستقامه",47,"م",2,0],["نذرت لها شقة مؤمنا","بأن الذي أخبرت لن يقع",48,"ع",1,0],["نَذَرتُ الصَومَ دَهري يَومَ تأتي","صَحيحَ الجِسمِ لِلَّه الحَميدِ",49,"د",1,0],["نذر فيه إذا التقينا","سكراً إلى الليل بعد سكر",50,"ر",1,0],["نذكره به بغير النفسِ","لذكرنا في حضرات القُدُسِ",51,"س",1,0],["نذوبُ صبابةً وهوىً ولطفاً","وروحانا المعذبتانِ روح",52,"ح",1,0],["نذوبُ على الوجه الذي تحجُبينه","ونقنعُ إن عزَّ اللقاءُ بنظرة",53,"ه",1,0],["نَذَرَتْ دَمِي قَبلَ اقْتِراحِ عِنَاقِها","فِئَةٌ لَها نَحوَ الأَذَى إِعْنَاقُ",54,"ق",1,0],["نَذَرتُ لِلَهِ نَذراً إِن حَظيتُ بِها","أَوَدُّ مِن وَصلَةٍ مِنهُ أُسائِلَها",55,"ل",3,0],["نذر العمر للغرام صبيا","وانقضى عمره ولم يجن شيّا",56,"ي",2,1],["نذم الحياة وانا بها","لأصبى من الزاني بالزانية",57,"ي",2,0],["نَذيرٌ مُجيرٌ وَلِيٌّ نَصيرٌ","وَساعٍ وَداعٍ وَراعٍ حَميمُ",58,"م",1,0],["نذَرْتُ استلامَ الرُّكْنِ للبيت عندها","فألثَمني اليُمنَى لكَي أُوفيَ النَذْرا",59,"ر",2,0],["نذرَ الوشاةُ دَمي وتُصبحُ نادماً","إن لم تكُنْ مُتَبيَّناً مَتُثبِّتا",60,"ت",2,0],["نَذوبُ ولكِنَّنا لانَتوبُ","وما غابَ من عُمرِنا لا يَؤوبُ",61,"ب",1,1],["نَذَر الزَمانُ عَلى تفرُّقِنا","نَذراً فأبى يُصادِقُ النَذرِ",62,"ر",1,0],["نذرتُ إذا ما زار في النوم مضجعي","خيالٌ له صوماً ولا أخلِفُ النّذرا",63,"ر",2,0],["نَذَرْتَهُما لدينِ اللهِ نَصْراً","فَقَدْ قاما لنَذْرِكَ وَافِيَيْنِ",64,"ن",1,0],["نذيراً وتبشيرا ووعظا وحكمة","وما كان نصح مثل نصحي يرجأ",65,"ا",1,0],["نُذُرٌ فيكُمُ وآياتُ صدقٍ","لِيَ فيها شريعةٌ ومقالَهْ",66,"ل",2,0],["نذيريَ من زمنٍ بالعتا","ب عن خُ