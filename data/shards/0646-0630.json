{"poems":[[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[86,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[73,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[27,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[51,"أيا ثقفي أراك الذي","https://www.aldiwan.net/poem11456.html","المتقارب"],[51,"تجرد من غمدين سيف مهند","https://www.aldiwan.net/poem61940.html","الطويل"],[51,"عظم الله يمن فطرك فطرا","https://www.aldiwan.net/poem62013.html","الخفيف"],[51,"نذيري من عسى ولعل نفسي","https://www.aldiwan.net/poem65448.html","الوافر"],[51,"قد يفي للصديق غير أمينه","https://www.aldiwan.net/poem66405.html","الخفيف"],[16,"من رجل أحبوه وناقتي","https://www.aldiwan.net/poem27672.html","الطويل"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[62,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[105,"صاحب السيفين ماذا صنعا","https://www.aldiwan.net/poem44212.html","الرمل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[76,"نجوم في المفارق ما تغور","https://www.aldiwan.net/poem39312.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202876","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[51,"نَذيري من عسى ولعلَّ نسي","https://www.poetsgate.com/ViewPoem.aspx?id=30774",""]],"verses":[["نَذارِ لَكُم مِن كَيدِهِ إِنَّ قَلبَهُ","ضَمومٌ عَلى الأَسرارِ غَيرُ مُذيلِ",0,"ل",1,0],["نَذارِ لَكُم مِن وَثبَةٍ ضَيغَميَّةٍ","لَها بَعدَ غَرّارِ السُكونِ حَراكُ",1,"ك",1,0],["نُذادُ وَيَروى الأَبعَدونَ بِمائِكُم","وَنَحنُ عَلى العِردِ الظِماءُ الخَوامِسُ",2,"س",1,0],["نَذبَحُ الدُبَّ وَنَفري جِلدَهُ","أَيَظُنُّ الدُبُّ أَلّا يُغلَبا",3,"ب",2,0],["نَذَرتُ شُكرَكَ لا أَنسى الوَفاءَ بِهِ","إِن أَسفَرَت لِيَ عَنها أَوجُهُ البُشَرِ",4,"ر",1,0],["نُذَكِّرُهُم بِاللَهِ مَن يُنهِلُ القَنا","وَيَفرِجُ ضيقَ المَأزِقِ المُتَلاحِمِ",5,"م",1,0],["نَذارِ نذارِ وإلا نظا","رِ مني قوارعَ تُوهِي الحديدا",6,"د",2,0],["نذيرٌ لما تُكْنَى به لذوي النُّهى","بشيرٌ لما تُسْمى به لا تُفنّدُ",7,"د",1,0],["نَذر الناسُ في القديم نذوراً","إنْ رأوا عيدك المأمَّل شكرا",8,"ر",2,0],["نذيري من عسى ولعل نفسي","ومن أختيهما حتى وسوفا",9,"ف",2,1],["نَذَرَتْ عصبةٌ بأنّيَ أستو","في رغيفاً وجانباً مِنْ قرينه",10,"ن",2,0],["نَذيراً وَما يُغني النَذيرُ بِشَبوَةٍ","لِمَن شاؤُهُ حَولَ البَدِيِّ وَجامِلُه",11,"ل",2,0],["نَذُمُّ السَحابَ الغُرَّ في فِعلِها بِهِ","وَنُعرِضُ عَنها كُلَّما طَلَعَت عَتبا",12,"ب",2,0],["نذرت أن أتركه مكتوما","سراً بختم ربه مختوما",13,"م",2,0],["نَذَارِ لقومٍ أخطأوا سُبُلَ الهُدى","فحاروا وتاهوا في الضَّلال وطخطَخُوا",14,"خ",3,0],["نَذَارِ لهم قبلَ التي لا شَوى لها","وعيداً يُصَكُّ السمعُ منه فَيُصمَخُ",14,"خ",1,0],["نَذيراً لَكُم مِنهُ بَشيراً لَكُم بِهِ","وَما لِيَ في هاتَينِ قَولَةُ كاذِبِ",15,"ب",1,0],["نَذُمُّ عَجزَ العُقولِ عَن خَطَرٍ","نَكيلُهُ بِالعُقولِ أَو نَزِنُه",16,"ن",2,0],["نَذرْتُ نذوراً فاقتضاني قضاءها","إيابُكَ من يوْمِ العروبة سالما",17,"م",2,0],["نُذادُ عن الحِياضِ ونحن هِيمٌ","فما نَرِدُ النِّطافَ ولا الجِماما",18,"م",2,0],["نَذودُ الوحشَ تطلُبنا جِياعاً","ونأبَى أن نكون لها طعاما",18,"م",2,0],["نذمُّ القائلين ولا حياةٌ","لمن يأبَى سبيلَ العاملينا",19,"ن",2,0],["نُذكِّرُهم بالمَشْرَفيِّ إذا نسوا","وللغافلِ النّاسي من الجهلِ شافعُ",20,"ع",1,0],["نَذكُرُ الحُكمَ ظالِماً ما رَأَينا","فيهِ عَدلاً وَلا وَجَدنا اِعتِدالا",21,"ل",2,0],["نَذكُرُ العَهدَ سَيِّئاً ما عَرَفنا","فيهِ حُرِّيَّةً وَلا اِستِقلالا",21,"ل",2,0],["نَذكُرُ الشَرَّ وَالبَلاءَ جَميعاً","فَاِذكُروا عَهدَكُم وَشُدّوا الرِحالا",21,"ل",2,0],["نَذرُ هندٍ هِيَ لولا أنها","لم تُسِغْها أكلتها أجمعا",22,"ع",2,0],["نَذرتْ يومَ أبيها نذْرها","عَلّها تشفِي الفُؤادَ المُوجَعا",22,"ع",2,0],["نَذَرَتْ إنْ جَمَعَتْ شَمْلِي لِبَابِكَ أَوْ","شَفَتْ فُؤَادِي بِهِ قَوْداءُ شِمْلِيلُ",23,"ل",1,0],["نَذَرُ الأَبطالَ صَرعى بَينَها","ما يَني مِنهُم كَمِيٌّ مُنعَفِر",24,"ر",1,0],["نَذَرُ الأَبطالَ صَرعى بَينَها","تَعكُفُ العِقبانُ فيها وَالرَخَم",25,"م",1,0],["نَذيرُ المَوْتِ أَرْسَلَهُ إليْنا","فَكَذَّبْنا بِما جاءَ النَّذيرُ",26,"ر",1,0],["نذيبُ بهِ صُلْبَ أعصابهم","وفي رِقَّةِ العود سِرُّ المناعهْ",27,"ه",1,0],["نذق قبلةً لا يعرفُ البؤسَ بعدها","ولا السقم روحانا ولا الجسدان",28,"ن",1,0],["نَذِيرٌ صَادِقٌ أدَّى كِتَاباً","وآياتٍ مبيَّنةً تُثيرُ",29,"ر",1,0],["نَذَرتُ دَمَ الأَعداءِ لَمّا نَظَرتهُ","كَأَنَّ عَدُوّاً شَجَّهُ فَشَجاني",30,"ن",2,0],["نَذيرَكَ مِن خَلْقٍ أُطيلَ امتهانُه","وإنْ باتَ في شكلِ الضَّعيفِ المُسالم",31,"م",1,0],["نَذيري من عسى ولعلَّ نسي","ومن أختيهما حتى وسوفا",32,"ف",2,1]]}