{"poems":[[55,"من لي برعبلة من البزل","https://www.aldiwan.net/poem29900.html","الكامل"],[79,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[56,"لنقل الرمال وقطع الجبال","https://www.aldiwan.net/poem27413.html","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[211,"لأسماء رسم أصبح اليوم دارسا","https://www.aldiwan.net/poem27943.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[520,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35362","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64476","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77848","السريع"],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117122","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108596","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29558","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[4755,"بَرْهِنْ بأنكَ ما تَزالُ ضَريرا","https://www.poetsgate.com/ViewPoem.aspx?id=198964",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5943,"وحي النور","https://www.poetsgate.com/ViewPoem.aspx?id=11153",""],[6075,"سنسمو وحدة","https://www.poetsgate.com/ViewPoem.aspx?id=190499",""],[5080,"أُصرِّف آياتي على سورة النبضِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88131&r=&rc=1",""],[6320,"كِتَابُ الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84340&r=&rc=37",""]],"verses":[["وَاِحصُد قُوايَ فَإِنَّني أَبَداً","بَينَ القَرائِنِ مارِجُ الحَبلِ",0,"ل",1,0],["وأحْصَنُ دِرْعٍ أيْقَنوا بدِفاعِهِ","لِبأسِكَ إذْعانٌ إلَيْهِ وإخْلادُ",1,"د",1,0],["وَإِحصاءُ لُؤمِ سَعيدٍ لَنا","أَوِ الثَكلُ في وَلَدٍ مُنتَخَب",2,"ب",1,0],["وَأَحصَنتُ النِساءَ بِحَدِّ سَيفي","وَأَعدائي لِعُظمِ الخَوفِ فَلّوا",3,"ل",3,0],["وَأَحصَنَنا مِنهُم فَما يَبلُغونَنا","فَوارِسُ مِنّا يَحبِسونَ المَحابِسا",4,"س",2,0],["وأحصاء ما في البحر من كل قطرة","بحيث يحيط المحصي منها بعدة",5,"ه",1,0],["واحصر مقالك إن نطقت فربما","وعظ المقل بعثرة المكثار",6,"ر",1,0],["وَأُحِصَّ الشّعرُ مِنها جِلدُها","شَنَّةٌ في جَوفِ غارٍ مُنخَسِف",7,"ف",1,0],["واحصد عرى الكافرين وانصر","حماة الإسلام بالصعاد",8,"د",1,0],["وَاِحصُد رُؤوسَ المُشرِكينَ بِها فَقَد","آنَ الحَصادُ لَها وَأَرطَبَ بُسرُها",9,"ر",3,0],["واحصر تعجّب أو كذين والخلف","واعطف على مسوغ أو انعطف",10,"ف",1,0],["وأحصيت حفظاً طاعتي وتبتلي","وأحصيت حالاتي وطوري وفطرتي",11,"ي",1,0],["وأحصيت ما يأتي وما يذر العدى","وما أضمروا من سيئات الطوية",11,"ه",1,0],["وأحصيت ذرات المقاصد مطلقاً","وأحصيت أعمالي وقولي ونيتي",11,"ي",1,0],["وأحصيت أرزاق النفوس مقدراً","لكل بوفق الحكمة المصلحية",11,"ه",1,0],["وأحصيت أرزاق القلوب تنزلاً","لها حسب الاستعداد والقابلية",11,"ه",1,0],["وأحصيت أسرار الهدايات مورداً","لهائمة الأرواح بحر الحقيقة",11,"ه",1,0],["واحصب بأَنوار له من أَتا","إِلى الصبا في عسكر الفيل",12,"ل",1,0],["وأَحْصَرُ من إِذْ كارِهِ إِنْ لَقِيتُهُ","وصِدْقُ الحَيَاءِ مُلْجَمٌ بلِجَامِ",13,"م",1,0],["وأحصيت منه كل عضوٍ بفيلقٍ","ومن بعده لم أحص ألفاً بواحد",14,"د",1,0],["وَأَحصَنَهُ ثُجرُ الظُباتِ كَأَنَّها","إِذا لَم يُغَيِّبَها الجَفيرُ حَجيمُ",15,"م",1,0],["واحصد رؤوسهم فكم رأس لكم","حصدته بعد ولم يشب شباتها",16,"ت",3,0],["واحصُد من الأَرواحِ كُلَّ بَريئةٍ","حتى تُؤَمِّنَ مكةً وعَسيرا",17,"ر",2,0],["واحصنك تحصين الأرزاق عن درب الفساد","واعشقك عشق المظاليم لفراق السجون",18,"ن",1,0],["واحصدْ من الحسناتِ مايكفي لِما","تحظى بهِ مالا رأتْ عينانِ",19,"ن",1,0],["وَاحْصُدْ بَقِيَّةَ حُبِّنَا","شَيِّدْ صُرُوحَ الْمَكْرُمَاتْ",20,"ت",1,0],["وأُحصِي دروبَ الموتِ إبّانَ سيرِها","فأخشى انبساطَ العمرِ في ساعةِ القبضِ",21,"ض",1,0],["وَأَحْصَيْنَا خُيُولَ الشِّرْكِ عَدّاً","وَكَمْ نِلْنَا بَأَسْيُفِنَا الثَّوَابَا",22,"ب",2,0]]}