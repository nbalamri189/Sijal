{"poems":[[63,"النجم يبعد مرمى طرفه الساجي","https://www.aldiwan.net/poem46197.html","البسيط"],[3,"ما زلت مرتقياَ إلى العلياء","https://www.aldiwan.net/poem122.html",""],[77,"شغلت بيوم العرض عمن وسيلتي","https://www.aldiwan.net/poem36548.html","الطويل"],[77,"قد صح في سنن النبي محمد","https://www.aldiwan.net/poem36653.html","الكامل"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[93,"ما أنس من طيب عيشي","https://www.aldiwan.net/poem11193.html","المجتث"],[54,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem27410.html","المتقارب"],[27,"إليك كلفنا كل يوم هجيرة","https://www.aldiwan.net/poem5963.html","الطويل"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[72,"أهواه فتان اللواحظ أغيدا","https://www.aldiwan.net/poem18548.html","الكامل"],[72,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[64,"والله ما طلعت شمس ولا غربت","https://www.aldiwan.net/poem67558.html","البسيط"],[51,"أتيت ابن عمرو فصادفته","https://www.aldiwan.net/poem9223.html","المتقارب"],[51,"وكم معان وألفاظ مهذبة","https://www.aldiwan.net/poem64020.html","البسيط"],[51,"إذا شاخ قوم شيبوا وابن بلبل","https://www.aldiwan.net/poem65983.html","الطويل"],[29,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[91,"لمن يضوع العبير لمن تغني الطيور","https://www.aldiwan.net/poem8821.html","عموديه"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[43,"نرى عظما بالبين والصد أعظم","https://www.aldiwan.net/poem10539.html","الطويل"],[45,"ألا هل أتاها بالمغيب سلامي","https://www.aldiwan.net/poem65670.html","الطويل"],[28,"وهم بين بيت الأكثرين مجاشع","https://www.aldiwan.net/poem5258.html","الطويل"],[28,"وحرف كجفن السيف أدرك نقيها","https://www.aldiwan.net/poem5326.html","الطويل"],[28,"ألم تذكروا يا آل مروان نعمة","https://www.aldiwan.net/poem5500.html","الطويل"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[44,"قرى دارهم مني الدموع السوافك","https://www.aldiwan.net/poem30391.html","الطويل"],[69,"عثا في عرضه قوم سلاط","https://www.aldiwan.net/poem28860.html","الوافر"],[74,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[74,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[105,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[40,"يا من لقلب شديد الهم معمود","https://www.aldiwan.net/poem42280.html","البسيط"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"وفي الديوان غزلان","https://www.aldiwan.net/poem64362.html","الهزج"],[48,"عوجا صدور النجائب البزل","https://www.aldiwan.net/poem65038.html","المنسرح"],[48,"قد أغتدي والصبح في دجاه","https://www.aldiwan.net/poem66201.html","الرجز"],[48,"سأركب ما استطعت من الحرام","https://www.aldiwan.net/poem66280.html","الوافر"],[46,"أرمى وجدك من رامي بني ثعل","https://www.aldiwan.net/poem22538.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[77,"شغلت بيوم العرض عمن وسيلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33924",""],[77,"قد صح في سنن النبي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=33646",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["ولاّج بابٍ أناخَ الخَطْبُ كَلْكَلَهُ","بهِ ومِنْ غمَراتِ الموتِ خَرّاجِ",0,"ج",1,0],["وَلَأَجهَدَنَّ عَلى اللِقاءِ لِكَي أَرى","ما أَرتَجيهِ أَو يَحينَ قَضائي",1,"ا",2,0],["ولا جهِلَتْ نفْسي أياديَ التي","جعلْتُ لِساني بعْدَها رهْنَ حَمْدِهِ",2,"د",2,0],["ولأجْلِ هَذا اخْتَصّني بلِباسِه","مَلِكُ العُلى الأرْضَى أبو الحَجّاجِ",3,"ج",1,0],["وَلأِجْلِ قُطْرِكَ شَمْسُهَا وَنُجُومُهَا","عَدَلَتْ عَنِ التَّشْرِيقِ لِلتَّغْرِيبِ",4,"ب",1,0],["وَلا جَلاَلَ زَفَافِي","وَرَوْعَةَ المَهْرَجَانِ",5,"ن",1,0],["وَلا جُرمَ لي أَن أَسَأتَ جَنا","ةَ مَزرَعَةٍ كانَ حَرّاثَها",6,"ث",3,0],["وَلا جافِياً عَن قائِمِ السَيفِ قَبضُهُ","إِذا الفَشِلُ الرِعديدُ قُفَّت أَنامِلُه",7,"ل",2,0],["وَلا جُعبُساً عَيّابَةً مُتَهَكِّماً","عَلَينا وَلا فَهّاً كَهاماً مُفَيَّلا",8,"ل",2,0],["ولأجله الأغصان مالت من صباً","والبدر طول الليل بات مسهدا",9,"د",2,0],["ولا جلد على إنكار دهرٍ","رمى قلبي الوحيد بفرقتين",10,"ن",1,0],["وَلا جَلستُ إِلى قَومٍ أُحَدِّثُهُم","إِلّا وَأَنتَ حَديثي بَينَ جُلّاسي",11,"ي",1,0],["ولا جُرمَ لي أن أساءت جَنا","ةُ مزرعةٍ كان حَرَّاثَها",12,"ث",3,0],["ولا جُناحَ على حام حقيقتَهُ","لا ظلم في دَفْع ظلمٍ عند ذي بصر",13,"ر",1,0],["ولا جورَ إلا جورُهُ في اكتنائه","أبا الصقر أنَّى ذاك وهو ابنُ بلبلِ",14,"ل",1,0],["وَلا جُشَمٍ شَرِّ القَبائِلِ إِنَّها","كَبَيضِ القَطا لَيسوا بِسودٍ وَلا حُمرِ",15,"ر",1,0],["وَلا جَمالٌ أَنيقٌ","وَلا شَبابٌ نَضيرُ",16,"ر",1,0],["وَلا جَمالُ الشُهبِ ما حَيَّرَني","وَإِنَّما حَيَّرَني جَمالي",17,"ي",1,0],["وَلا جَزِعَ الشَجَرُ الناضِرُ","وَلا اِكتَأَبَ الجَدوَلُ المُطرَبُ",18,"ب",1,0],["وَلا جَبأَ أَكهى مُرِبٍّ بِعِرسِهِ","يُطالِعُها في شَأنِهِ كَيفَ يَفعَلُ",19,"ل",1,0],["وَلا جالَ إِلّا الخَيرُ بَينَ سَرائِري","لَدى سُدَّةٍ خَيرِيَّةِ الرَغَباتِ",20,"ت",1,0],["وَلا جَلَسَ البَحرُ المُحيطُ لِقاصِدٍ","وَمِن تَحتِهِ فَرشٌ وَمِن فَوقِهِ سَقفُ",21,"ف",1,0],["وَلا جُرحُهُ يُؤسى وَلا غَورُهُ يُرى","وَلا حَدُّهُ يَنبو وَلا يَتَثَلَّمُ",22,"م",1,0],["وَلا جَبَلاً كَالزَوِّ يوقَفُ تارَةً","وَيَنقادُ إِمّا قُدتَهُ بِزَمامِ",23,"م",1,0],["وَلا جابِراً وَالحَينُ يورِدُ أَهلَهُ","مَوارِدَ أَحياناً إِلى غَيرِ مَصدَرِ",24,"ر",1,0],["وَلا جارَ بَعدَ اللَهِ خَيرٌ مِنَ الَّذي","وَضَعتُ إِلى أَبوابِهِ رَحلُ خائِفِ",25,"ف",1,0],["وَلا جارَ إِلّا اللَهُ إِذ حالَ دونَهُ","كَمَروانَ أَوفى لِلجِوارِ وَأَكرَما",26,"م",2,0],["وَلا جَبَرَت كَفّاهُ في كُلِّ بَلدَةٍ","كَبيرَ كِرامٍ ما لِكَسرِهِمُ جَبرُ",27,"ر",1,0],["ولأجل العصا سطا على الأفرع الخض","راء زانت بواسق الأشجارِ",28,"ر",1,0],["ولأجل العصا سطا على خشب البي","تِ طموحاً حتى لباب الدارِ",28,"ر",1,0],["وَلَاِجتُذِبَت فُرشٌ مِنَ الأَمنِ تَحتَكُم","هِيَ المُثلُ في لينٍ بِها وَالأَرائِكُ",29,"ك",1,0],["ولا جاراكمُ في كسبِ مالٍ","ولم يُعْهَد لهُ بكمُ اختلاطُ",30,"ط",1,0],["وَلا جارَ إِلّا مِن حُسامٍ مُصَمَّمٍ","وَلا دارَ إِلّا في قُتودِ الرَكائِبِ",31,"ب",1,0],["وَلا جاذَبَتني اَلريحُ فَضلَ ذُؤابَةٍ","لَبِستُ بِها ثَوبَ الشَبيبَةِ مُعلَما",32,"م",2,0],["وَلا جاوَرَتهُم مُنذُ كانوا مَسَبَّةٌ","وَلا فارَقَتهُم مُنذُ حَلّوا المَكارِمُ",33,"م",1,0],["وَلا جرمَ لِلمِصرِيِّ فيما تَأَوَّلوا","وَلَكِن أَساءَ النيلُ صُنعاً وَأَجرَما",34,"م",2,0],["وَلا جَشِمتُ وَلا كَلَّفتُ راحِلَتي","أَجواز طامِسَةٍ أَعلامُها بِيدِ",35,"د",1,0],["وَلا جَوْرَ في أحْكَامِهِ غَيْرَ أَنه","عَلَى الخائِنِينَ الجَائرِينَ يَجُورُ",36,"ر",1,0],["ولا جَرّدُوا نَصْلاً تُخَافُ شَباتُه","ولكِنّ فُولاذاً غَدا وهو آنُك",37,"ك",1,0],["وَلا جانَبنَ مُذ كُنَّ","نَعيمَ العَيشِ وَالخَفضا",38,"ض",2,0],["وَلا جَميلاً في الناسِ نَعلَمُهُ","إِلّا وَأَدنى فِعالَهُ أَجمَل",39,"ل",1,0],["وَلا جَناحانِ تَكَنَّفاهُ","مِنهُ إِذا طارَ وَقَد تَلاهُ",40,"ا",2,0],["ولا جور الأمير وحجر قاضٍ","ولا قولِ المؤذّنِ والإمام",41,"م",1,0],["وَلاجَتِ النارُ كَالشَقراءِ يَحبِسُها","عَن مُهرِها القَيدُ وَهناً فَهيَ لا تَقِرُ",42,"ر",1,0],["وَلأَجْعَلَنَّ بِهِ البِلاَدَ مَنِيعَةً","يَرْتَدُّ عَنْهَا الطَّامِعُ المُتَوَثِّبُ",43,"ب",1,0],["ولا جُوِّعَ المرَّ مرَّ الدواءِ","ولا وخَزَتْ مَنكبِيه الإبر",44,"ر",1,0],["ولا جار في عهد المظالم حينما","تولَّى زمام الحكم في مصرَ جائره",45,"ر",2,0],["ولا جهلت نفسي أياديك التي","جعلت لساني بعدها رهن حمده",46,"د",2,0],["ولأجل هذا اختصني بلباسه","ملك العلا الأرضي أبو الحجاج",47,"ج",1,0],["ولا جَحوداً بان الليلَ يُعقبه","فَجرٌ تفجَّّرُ كمه الشمس مُطَّلَعا",48,"ع",2,0],["وَلاَ جُود لِلإِنْسَانِ إِلاَّ علَى دَخْلِ","تَحنُّ إِلى الصُّقْعِ الَّذِي لَمْ يَبَرَّهَا",49,"ه",2,0]]}