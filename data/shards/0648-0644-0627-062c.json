","https://www.poetsgate.com/ViewPoem.aspx?id=210573",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5364,"ثامن عشر آذار","https://www.poetsgate.com/ViewPoem.aspx?id=177161",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5525,"الشفق","https://www.poetsgate.com/ViewPoem.aspx?id=921",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5573,"دربي طويل وسكتي مالها زي","https://www.poetsgate.com/ViewPoem.aspx?id=201932",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[482,"بسوى قربِكَ لا يُشْفَى الغليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=111425",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5629,"التواضع","https://www.poetsgate.com/ViewPoem.aspx?id=184600",""],[5677,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=179981",""],[5691,"ضياغم بيْتا","https://www.poetsgate.com/ViewPoem.aspx?id=206209",""],[5718,"صروف الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=213982",""],[5804,"السر الخطير ( لغز )","https://www.poetsgate.com/ViewPoem.aspx?id=214755",""],[5823,"دثريني بالود","https://www.poetsgate.com/ViewPoem.aspx?id=61382",""],[5848,"عندي سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=48834",""],[5879,"السودان","https://www.poetsgate.com/ViewPoem.aspx?id=215936",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5956,"عيونهنّ","https://www.poetsgate.com/ViewPoem.aspx?id=181861",""],[5956,"شاعر من الإنس تزوج من جِنَّية","https://www.poetsgate.com/ViewPoem.aspx?id=184836",""],[5956,"مولدِ الطفل أدهم إيهاب","https://www.poetsgate.com/ViewPoem.aspx?id=193097",""],[5956,"المصائب الراتعة من ممارسات الأطباء الغبية المائعة","https://www.poetsgate.com/ViewPoem.aspx?id=193100",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"لا أقبل ما يرفضه عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=194413",""],[5956,"يا ليتني أشفيك من كل الضنا","https://www.poetsgate.com/ViewPoem.aspx?id=194650",""],[5956,"متأكدٌ أنا من مروءة حاتم","https://www.poetsgate.com/ViewPoem.aspx?id=194658",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5977,"أشتاق لي","https://www.poetsgate.com/ViewPoem.aspx?id=213253",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6102,"هَشِيمُ الهَجر !!","https://www.poetsgate.com/ViewPoem.aspx?id=185298",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""]],"verses":[["ولاّج بابٍ أناخَ الخَطْبُ كَلْكَلَهُ","بهِ ومِنْ غمَراتِ الموتِ خَرّاجِ",0,"ج",1,0],["وَلَأَجهَدَنَّ عَلى اللِقاءِ لِكَي أَرى","ما أَرتَجيهِ أَو يَحينَ قَضائي",1,"ا",2,0],["ولا جهِلَتْ نفْسي أياديَ التي","جعلْتُ لِساني بعْدَها رهْنَ حَمْدِهِ",2,"د",2,0],["ولأجْلِ هَذا اخْتَصّني بلِباسِه","مَلِكُ العُلى الأرْضَى أبو الحَجّاجِ",3,"ج",1,0],["وَلأِجْلِ قُطْرِكَ شَمْسُهَا وَنُجُومُهَا","عَدَلَتْ عَنِ التَّشْرِيقِ لِلتَّغْرِيبِ",4,"ب",1,0],["وَلا جَلاَلَ زَفَافِي","وَرَوْعَةَ المَهْرَجَانِ",5,"ن",1,0],["وَلا جُرمَ لي أَن أَسَأتَ جَنا","ةَ مَزرَعَةٍ كانَ حَرّاثَها",6,"ث",3,0],["وَلا جافِياً عَن قائِمِ السَيفِ قَبضُهُ","إِذا الفَشِلُ الرِعديدُ قُفَّت أَنامِلُه",7,"ل",2,0],["وَلا جُعبُساً عَيّابَةً مُتَهَكِّماً","عَلَينا وَلا فَهّاً كَهاماً مُفَيَّلا",8,"ل",2,0],["ولأجله الأغصان مالت من صباً","والبدر طول الليل بات مسهدا",9,"د",2,0],["ولا جلد على إنكار دهرٍ","رمى قلبي الوحيد بفرقتين",10,"ن",1,0],["وَلا جَلستُ إِلى قَومٍ أُحَدِّثُهُم","إِلّا وَأَنتَ حَديثي بَينَ جُلّاسي",11,"س",2,0],["ولا جُرمَ لي أن أساءت جَنا","ةُ مزرعةٍ كان حَرَّاثَها",12,"ث",3,0],["ولا جُناحَ على حام حقيقتَهُ","لا ظلم في دَفْع ظلمٍ عند ذي بصر",13,"ر",1,0],["ولا جورَ إلا جورُهُ في اكتنائه","أبا الصقر أنَّى ذاك وهو ابنُ بلبلِ",14,"ل",1,0],["وَلا جُشَمٍ شَرِّ القَبائِلِ إِنَّها","كَبَيضِ القَطا لَيسوا بِسودٍ وَلا حُمرِ",15,"ر",1,0],["وَلا جَمالٌ أَنيقٌ","وَلا شَبابٌ نَضيرُ",16,"ر",1,0],["وَلا جَمالُ الشُهبِ ما حَيَّرَني","وَإِنَّما حَيَّرَني جَمالي",17,"ي",1,0],["وَلا جَزِعَ الشَجَرُ الناضِرُ","وَلا اِكتَأَبَ الجَدوَلُ المُطرَبُ",18,"ب",1,0],["وَلا جَبأَ أَكهى مُرِبٍّ بِعِرسِهِ","يُطالِعُها في شَأنِهِ كَيفَ يَفعَلُ",19,"ل",1,0],["وَلا جالَ إِلّا الخَيرُ بَينَ سَرائِري","لَدى سُدَّةٍ خَيرِيَّةِ الرَغَباتِ",20,"ت",1,0],["وَلا جَلَسَ البَحرُ المُحيطُ لِقاصِدٍ","وَمِن تَحتِهِ فَرشٌ وَمِن فَوقِهِ سَقفُ",21,"ف",1,0],["وَلا جُرحُهُ يُؤسى وَلا غَورُهُ يُرى","وَلا حَدُّهُ يَنبو وَلا يَتَثَلَّمُ",22,"م",1,0],["وَلا جَبَلاً كَالزَوِّ يوقَفُ تارَةً","وَيَنقادُ إِمّا قُدتَهُ بِزَمامِ",23,"م",1,0],["وَلا جابِراً وَالحَينُ يورِدُ أَهلَهُ","مَوارِدَ أَحياناً إِلى غَيرِ مَصدَرِ",24,"ر",1,0],["وَلا جارَ بَعدَ اللَهِ خَيرٌ مِنَ الَّذي","وَضَعتُ إِلى أَبوابِهِ رَحلُ خائِفِ",25,"ف",1,0],["وَلا جارَ إِلّا اللَهُ إِذ حالَ دونَهُ","كَمَروانَ أَوفى لِلجِوارِ وَأَكرَما",26,"م",2,0],["وَلا جَبَرَت كَفّاهُ في كُلِّ بَلدَةٍ","كَبيرَ كِرامٍ ما لِكَسرِهِمُ جَبرُ",27,"ر",1,0],["ولأجل العصا سطا على الأفرع الخض","راء زانت بواسق الأشجارِ",28,"ر",1,0],["ولأجل العصا سطا على خشب البي","تِ طموحاً حتى لباب الدارِ",28,"ر",1,0],["وَلَاِجتُذِبَت فُرشٌ مِنَ الأَمنِ تَحتَكُم","هِيَ المُثلُ في لينٍ بِها وَالأَرائِكُ",29,"ك",1,0],["ولا جاراكمُ في كسبِ مالٍ","ولم يُعْهَد لهُ بكمُ اختلاطُ",30,"ط",1,0],["وَلا جارَ إِلّا مِن حُسامٍ مُصَمَّمٍ","وَلا دارَ إِلّا في قُتودِ الرَكائِبِ",31,"ب",1,0],["وَلا جاذَبَتني اَلريحُ فَضلَ ذُؤابَةٍ","لَبِستُ بِها ثَوبَ الشَبيبَةِ مُعلَما",32,"م",2,0],["وَلا جاوَرَتهُم مُنذُ كانوا مَسَبَّةٌ","وَلا فارَقَتهُم مُنذُ حَلّوا المَكارِمُ",33,"م",1,0],["وَلا جرمَ لِلمِصرِيِّ فيما تَأَوَّلوا","وَلَكِن أَساءَ النيلُ صُنعاً وَأَجرَما",34,"م",2,0],["وَلا جَشِمتُ وَلا كَلَّفتُ راحِلَتي","أَجواز طامِسَةٍ أَعلامُها بِيدِ",35,"د",1,0],["وَلا جَوْرَ في أحْكَامِهِ غَيْرَ أَنه","عَلَى الخائِنِينَ الجَائرِينَ يَجُورُ",36,"ر",1,0],["ولا جَرّدُوا نَصْلاً تُخَافُ شَباتُه","ولكِنّ فُولاذاً غَدا وهو آنُك",37,"ك",1,0],["وَلا جانَبنَ مُذ كُنَّ","نَعيمَ العَيشِ وَالخَفضا",38,"ض",2,0],["وَلا جَميلاً في الناسِ نَعلَمُهُ","إِلّا وَأَدنى فِعالَهُ أَجمَل",39,"ل",1,0],["وَلا جَناحانِ تَكَنَّفاهُ","مِنهُ إِذا طارَ وَقَد تَلاهُ",40,"ا",2,0],["ولا جور الأمير وحجر قاضٍ","ولا قولِ المؤذّنِ والإمام",41,"م",1,0],["وَلاجَتِ النارُ كَالشَقراءِ يَحبِسُها","عَن مُهرِها القَيدُ وَهناً فَهيَ لا تَقِرُ",42,"ر",1,0],["وَلأَجْعَلَنَّ بِهِ البِلاَدَ مَنِيعَةً","يَرْتَدُّ عَنْهَا الطَّامِعُ المُتَوَثِّبُ",43,"ب",1,0],["ولا جُوِّعَ المرَّ مرَّ الدواءِ","ولا وخَزَتْ مَنكبِيه الإبر",44,"ر",1,0],["ولا جار في عهد المظالم حينما","تولَّى زمام الحكم في مصرَ جائره",45,"ر",2,0],["ولا جبرت حداه يوم سللته","له في رقاب المؤمنين صرير",46,"ر",1,0],["ولا جهلت نفسي أياديك التي","جعلت لساني بعدها رهن حمده",47,"د",2,0],["ولأجل هذا اختصني بلباسه","ملك العلا الأرضي أبو الحجاج",48,"ج",1,0],["ولا جَحوداً بان الليلَ يُعقبه","فَجرٌ تفجَّّرُ كمه الشمس مُطَّلَعا",49,"ع",2,0],["وَلاَ جُود لِلإِنْسَانِ إِلاَّ علَى دَخْلِ","تَحنُّ إِلى الصُّقْعِ الَّذِي لَمْ يَبَرَّهَا",50,"ه",2,0],["ولا جبين منير","عليه يزهو الهلال",51,"ل",1,0],["ولأجلكم باع الفؤاد بلا ثمن","مستغرق بغرامكم أمد الزمن",52,"ن",1,0],["ولأجله صاغ الوجود بحكمةٍ","مدت بساط سنينه وشهوره",53,"ر",2,0],["ولا جرى في مسمعي صوته","جرى نمير الماء في الغدر",54,"ر",1,0],["ولا جناة ولا أَرض يضرجها","دم زكي ولا أخاذ بالثار",55,"ر",1,0],["ولا جيرةَ بالهوب خنا وِدادهمُ","لفرقتنا عنهم زماناً بلا جُرْمِ",56,"م",1,0],["ولا جزالة معناه الجليّ ولا","إنكار ما فيه من لطف الإشارات",57,"ت",1,0],["ولأجلها غَبَط الغَبي","طَ حجابُ قلبي والسوادُ",58,"د",1,0],["ولا جعلتُ اللَّمى وِرْدي وقد ضمِنتْ","غمامةُ الجود إصداري وإيرادي",59,"د",2,0],["ولا جُناحَ على مُرسٍ كلا كلَه","إذا تقدّم إعذارٌ وإنذارُ",60,"ر",1,0],["وَلا جاوَزَ الذَمُّ فيهِ الثَنا","وَلا ذَعَرَ الناسُ عَنهُ الأَمَل",61,"ل",1,0],["وَلا جاوَدا الأَجوادَ إِلّا وَأَربَيا","وَلا فاضَلا الأَمجادَ إِلّا وَفُضِّلا",62,"ل",2,0],["ولا جار في أمر على الجار حكمه","ولكن إذا علىَّ فتى منهلا علا",63,"ل",2,0],["وَلا جَمَعَتنا آخِرَ الدَهرِ نِيَّةٌ","إِلى أَن يَضُمَّ البَعثُ عاداً وَجُرهُما",64,"م",2,0],["وَلا جَوادٌ أَقَبُّ الظَهرِ مُنجَرِدٌ","يَهوي بِهِ كَهُوِيِّ الأَجدَلِ القَطِمِ",65,"م",1,0],["وَلِأَجلِهِ التاريخُ نادى نَظمَهُ","بالبِرِّ قُسطنطينُ قَد نالَ الفِدى",66,"د",2,0],["وَلِأَجلِها كَتبَ المُؤرِّخُ أَسطُراً","يُهدى بِها بُشرى الخَلاصِ لِمريَمِ",67,"م",1,0],["وَلأجلهِ كَتَبَ المُؤرِّخُ قائِلاً","قَمَرٌ أَتاهُ الخَسفُ قَبلَ كَمالِهِ",68,"ل",2,0],["ولا جفاني خلي كنت آلفه","إلا عدلت إلى ضرب من الجذل",69,"ل",1,0],["ولا جمل ولا نسب جميل","يصون الوجه عن بذل السؤال",70,"ل",1,0],["وَلا جائزٌ منهم هجومٌ عليهما","وَلَو بَقِيا في السرِّ وَحدهما شهرا",71,"ر",2,0],["وَلا جَعَلنَ مَحمَلَ ذي السِلاحِ مَجَنَّهُ","رَعنَ اليَتيمَةِ وَاِفتَرَشنَ لِواها",72,"ا",3,0],["ولاَّجُ أبوابِ الأمورِ برأيهِ","طلاَّعُ أنجادٍ لها وهضاب",73,"ب",1,0],["ولا جرى ذكر العقيق مذ بدا","الا جرى من مقلتي في خدي",74,"د",2,0],["ولاِجل اربك ووصلِك","صاحبت غير الحبايب",75,"ب",1,0],["ولا جاده الغيث مِن منزلٍ","كأنّ مجالسَه كُنْفُهُ",76,"ف",2,0],["وَلا جَهمٌ وَقَد أَلقَت عَصاها","بِساحَتِهِ الوُفودُ وَلا جَهامُ",77,"م",1,0],["ولأجل هذا السرّ قال وشمسُنا","أبداً على فَلَكِ العلا لا تغرب",78,"ب",1,0],["ولا جنةٌ تُرجى ولا نارُ تُختشى","فَأَنسَى وأُنسَى والوجودُ هو التعس",79,"س",1,0],["ولأجل عينيك البنفسج شاقني","فجنيتُه وشممتُه نشوانا",80,"ن",2,0],["ولا جسمَ منهوكٌ ولا صدرَ ضيِّقٌ","ولا قلبَ مصدوعٌ يعلُّ سماما",81,"م",2,0],["ولأجلنا صَلّينَ كلَّ عشيَّةٍ","وصبيحةٍ فصلاتُكنَّ تقينا",82,"ن",2,0],["وَلا جالَ فِي شَرْقِ الهَوَى مَشْرِق الضحَى","وَلا قالَ فِي ظِلِّ العُلا شامِخ الطَّودِ",83,"د",1,0],["وَلا جَدى المُزنِ إِلّا فَيضُ نائِلِهِ","وَلا شَذا المِسكِ إِلّا طيبُ رَيّاهُ",84,"ا",2,0],["وَلِأَجلِ ذا قالَ البَشيرُ مُؤَرِّخاً","يَحظى سُلَيمانَ بِيُمنِ مُحَمِّدِ",85,"د",1,0],["ولا جنيني فاعلمي بمتبعي","هذا جوابي فاستمري أو دعي",86,"ي",1,0],["ولا جعلَتْ إلاّ بوَجْهِكَ عِيدَها","ولا رَضيتْ إلاّ عِداكَ الأضاحيا",87,"ي",2,0],["ولا جَسداً تناءَتْ منه روحٌ","ويَبقى بعدَها حيّاً فُواقا",88,"ق",2,0],["ولا جُفونُ الرّجاءِ أن قَرِحَتْ","ولا فُؤادُ العُلا أنِ انصَدعا",89,"ع",2,0],["ولا جانبَ يَزْوَرُّ","ولا حاجبَ يُمتَطّ",90,"ط",1,0],["ولأجلِ عُذْرٍ واحدٍ","يَهَبُ الذُّنوبَ وهُنّ كُثر",91,"ر",1,0],["ولا جَمْعُ أهلِ الأرضِ ينفَعُهم إذا","بنَصْرِكُمُ ربُّ السماءِ تَفَرّدا",92,"د",2,0],["ولأجلِ ذلكَ ما بَلغتُ بِمَدحِهِ","إلا إلى أن أعلَمَ المَعلُوما",93,"م",2,0],["ولأجل ذلك ما يسمّى باسمه","حسناً ولم يلحقه إلا غاصبُه",94,"ب",2,0],["ولا جاهلٌ إلّا وفيها محكَّمٌ","ولا عاقلٌ إلّا وفيها ملطَّف",95,"ف",1,0],["ولا جَفَا النّومُ مِنْ بَعْدي نواظرَكم","وناظري بعدكم أودَى به السَّهَدُ",96,"د",1,0],["ولا جَرتْ لِلنّوى يوماً مَدامعكم","ومِدمعي أبداً في الخَدِّ يَطّردُ",96,"د",1,0],["ولا جمعوا مالاً ولا كسبوا لهم","قصوراً ولا باهوا برفع بناها",97,"ا",3,0],["ولا جبل يبقى وإن طال مكثه","وكل له بعد الوجود زوال",98,"ل",1,1],["ولاجتهدت بمنعته عقول","لها في الرأي حقّ الاجتهاد",99,"د",1,0],["ولا جنى برقعٌ ورد الخدود ولم","تعطِ الميازر عطفيها ولم تهبِ",100,"ب",1,0],["ولأَجْلِ صرفِ الدهرِ صرتُ متى","أَبصرتُ لم أَبصِرْ سوى ظُلَمِ",101,"م",1,0],["ولا جفن لي إلا وأقرحهُ البكا","ولا قلب إلا قد يراهُ التشوّق",102,"ق",1,0],["ولا جاشَتِ الآفاقُ من طِيبِ ذِكرِهِمْ","بِجَيشِ ثناً إلّا وَفِي وسْطِهُ بَندي",103,"د",2,0],["ولا جابُوا إِلَيْهِ القَفْرَ حَتَّى","تَجَاوَبَتِ الحمائِمُ بالبُكاءِ",104,"ا",2,0],["ولا جُدْتُ لِلدُّنيا بِخَلَّةِ واصِلٍ","ولَوْ بَرَزَتْ لي فِي غَلائِلِها الخُضْرِ",105,"ر",1,0],["ولأَجْلُوَنْ منها لأَبصارِ النُّهى","حُرَّ الخِطابِ وحُرَّةَ الخُطَّابِ",106,"ب",1,0],["ولأَجْعَلَنَّ ثناءها وجَزاءها","أَبَدَ الأَبِيدِ وعاقِبَ الأَعْقابِ",106,"ب",1,0],["ولأَجْعَلَنْ منها تمائِمَ خائفٍ","من طائِفٍ أَوْ مِنْ رجاءٍ خائبِ",107,"ب",1,0],["ولا جهلها عن بالغ الحلم عاقل","له واسع بالخطر والحجر والنبا",108,"ب",2,0],["ولا جادت قرائحنا بشعر","تضوع منه عطر الياسمين",109,"ن",1,0],["ولّاجَةً تطأ الصدورَ بها","كَلِمٌ توسِّعُ ضيِّق العُذرِ",110,"ر",1,0],["ولا جلوتُ ووجه اليوم مبتسمٌ","شمساً من السُّمر في ظلٍّ من السّمر",111,"ر",1,0],["ولا جرتْ أدمعي والشملُ مجتمعٌ","اِلاّ لما علمَ الأحبابُ مِن حَذَري",112,"ر",2,0],["ولأَجلِها هَجَرَ الأَحِ","بَّةَ والمَساكِنَ والإِقامَهْ",113,"م",2,0],["ولا جاهٌ ولا مالٌ","ولا عزٌّ وسلطانُ",114,"ن",1,0],["ولا جهل والعلم اللدنّي شعارها","ولا ذنب إذ منها التجاوز والعفو",115,"و",1,0],["ولأجل هذا كل شيء هالك","والكل فانٍ قال في التعبير",116,"ر",1,0],["ولا جنود عندنا","ولا نريد عسكرا",117,"ر",2,0],["ولأجلنا ظهر الوجود بكل ما","هو ظاهر وأنارت الأسحار",118,"ر",1,0],["ولأجله جاء الخطاب بعزهم","ولهم تزايد عندها المقدار",118,"ر",1,0],["ولأجل هذا جاءنا عن سبه","نهي النبي بعلمه الموروث",119,"ث",1,0],["ولأجلها كَتَبَ المؤرِّخُ راقِماً","في نحوِ عُمرِ البدرِ كانَ خُسوفُها",120,"ه",2,0],["ولأجلِها كَتَبَ المؤرِّخُ عاجِلاً","مِن عن يمينِ العرشِ قامَت مَريمُ",121,"م",1,0],["ولأجلهِ كَتَبَ المؤرِّخُ نظمَهُ","إنَّ الكواكبَ في السَّماءِ قَرارُها",122,"ر",3,0],["ولأجلهِ كَتَبَ المؤرِّخُ حُكمَهُ","في أرفَعِ الدَّرَجاتِ ميخائيلُ",123,"ل",1,0],["ولا جماد لا ولا نبات","في عامر الأرض ولا الفلاة",124,"ه",1,0],["ولا جاعلا عِرضي لمالي وقاية","ولكن أَقي عرضي فيحرزه وفري",125,"ر",2,0],["وَلا جَلَدي عَنهُم سَلُوّاً وَقَسوَةً","وَلَكِنَّ عودُ الأَكرَمينَ صَليبُ",126,"ب",1,0],["ولأَجْلِ قَبْرِك صِرْتُ من أَدَبِي","أُولي المقابرَ جُلَّ إِجْلاَلِي",127,"ل",2,0],["ولأَجْلِ ذاكَ حَدَدْتُهَا","بالدَّمْع حَدَّ المُفْتَرِي",128,"ر",2,0],["ولا جرى في مسم السمع من مسمر","إلاَّ ذكرت اجتماعي بالأخلاء",129,"ا",2,0],["ولا جلست بما نوس أخي تقسة","صافي المشارب من أغباء أعداء",129,"ا",2,0],["ولأجلك اِكتستِ الحداد تأسّفاً","إذ كنت أنتَ جمالها وبناءها",130,"ا",3,0],["وَلا جَلَبَ البَغيُ رأسَ امرِىءٍ","إلى سُوقِ عَزمِكَ إلاَّ نَفَق",131,"ق",1,0],["ولاجلهِ قد أَوضح التاريخ عن","صفو التهاني بالصفا للمُصطفى",132,"ف",2,0],["ولأجلكم خلق الوجود وفيكم","بين البرية كل صعب يسهل",133,"ل",1,0],["ولأجله تقع الرجال وتلتظي","حرقاً عليه وتصرع الأحرار",134,"ر",1,0],["ولأجل ذاك البدر لا شك اختفى","من غير من يرعى سناه أو أفل",135,"ل",1,0],["ولأجلِ ذلك حيثُ حلّتْ عيسُها","فالليل فجرٌ والنسيمُ بَليلُ",136,"ل",1,0],["ولا جازَهُ صَوْبُ الحيا أو تُجيزَه","أكفُّ الحيا منها بأسنى الجوائز",137,"ز",1,0],["وَلِأَجلِ أَن يَبقى عُيوني قَد غَدَت","تَبكي وَتَسقيهِ الزّمانَ بِمائِها",138,"ه",2,0],["وَلِأَجلِ تَشكيكِ الوُشاةِ وَوَهْمِهِم","في عَينِ مَن أَسرَرْتُهُ بِجَناني",139,"ن",2,0],["وَلِأَجلِ أَنّي لا يَكونُ مُشاركي","قَطعاً بِمَعرِفَةِ المُهَفهَفِ ثاني",139,"ن",2,0],["وَلا جَمالٌ لا وَلا مروَّه","وَلا شَبابٌ لا وَلا فتوَّه",140,"ه",1,0],["ولا جعلنا نجوب البيد في قطع الظ","ظلما ونقطع أرباعا وأحقافا",141,"ف",2,0],["ولا جليساً أخا علمٍ تجالسُه","يفيدُنا منه تعليماً وتدريسا",142,"س",2,0],["ولا جنيت الفراق طوعاً","ولا شكوتُ من الولوعْ",143,"ع",1,0],["ولأجل مولده السماء تزينت","وهوت كواعبها كطير وقع",144,"ع",1,0],["وَلا جدث أَتى إلّا","سقت أنواء غيثهما",145,"م",2,0],["ولا جرى في شريعة سلفت","على اختلاف الأديان والنحل",146,"ل",1,0],["ولأجل ما قد بات آل محمد","من مبدء في ظلمهم ومعيد",147,"د",1,0],["وَلا جُنَّةٌ إِلّا إِيالَتُكَ الَّتي","بِها اِستَصحَبَ الضِرغامُ وَالشاةُ في الفَلا",148,"ل",2,0],["وَلاَ جُندَباً إِذ صَالَ بالسَّيفِ صَولَةً","على سَاحِرٍ فِى حَافَةِ السُّوقِ لاَعِبِ",149,"ب",1,0],["ولا جرت والبرق في حلبة","إلا وأوهت منه أركانا",150,"ن",2,0],["ولا جاء ممنوعا ولا جاء جائزا","وعمت به البلوى وأنت به أدرى",151,"ر",2,0],["وَلا جَزعٌ مِنَ الحدثانِ يَوماً","وَلَكِنّي أَرودُ لَكُم وبارِ",152,"ر",1,0],["ولا جلوَةٍ منها يحيلنني بها","الا ليتني غيبتُ قبلك في القبرِ",153,"ر",1,0],["ولا جلوَةٍ منها يحلينني بها","إلا ليتني غيّبتُ قبلك في القبرِ",154,"ر",1,1],["وَلا جالَسوهُم وَهُم هُجنَةٌ","وَلا واكَبوهُم مَعَ الأَقرَبين",155,"ن",1,0],["ولا جانب الدنيا بسهل ولا ضحى","بطلق ولا غصن المسرة مائد",156,"د",1,0],["ولا جنح الأبرار أن يتزلفوا","إليك سوى من بابه عند قربة",157,"ه",1,0],["ولاجل اثبات البنوة قد اتى","بدلائل الايضاح والتبيان",158,"ن",1,0],["وَلاَ جُرَّ ذَيْلُ الآسِ فِي مَلْعَبِ ال