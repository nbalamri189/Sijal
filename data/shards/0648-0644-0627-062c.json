ارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[399,"الآن حين انتهى السلوان والجلد","https://www.aldiwan.net/poem46542.html","البسيط"],[400,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[400,"ولا جبل يبقى وإن طال مكثه","https://www.aldiwan.net/poem33475.html","الطويل"],[413,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[426,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[429,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[434,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[436,"تصدت لوشك البين من جفوة الصد","https://www.aldiwan.net/poem34776.html","الطويل"],[436,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[436,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[438,"أبا ساحباً ذيل البطالة والصبا","https://www.aldiwan.net/poem14400.html","الطويل"],[447,"أفكر فيك يا نور العيون","https://www.aldiwan.net/poem1004.html",""],[456,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[462,"وقد أخضب الدمع فاكفف رائد النظر","https://www.aldiwan.net/poem3578.html","عموديه"],[475,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[498,"قالت غزيلة الغوير","https://www.aldiwan.net/poem37771.html","مجزوء الكامل"],[549,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[556,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[556,"إن العوام كلها موجودة","https://www.aldiwan.net/poem34484.html","الكامل"],[556,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[556,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[556,"لما انثنت ثاء الثنا الموروث","https://www.aldiwan.net/poem34696.html","الكامل"],[560,"أسما قرينة أسعد بن خلاط قد","https://www.aldiwan.net/poem52533.html","الكامل"],[560,"قد فارقت بنت السماط ديارها","https://www.aldiwan.net/poem52627.html","الكامل"],[560,"مكسميس المظلوم بطركنا الذي","https://www.aldiwan.net/poem52635.html","الكامل"],[560,"مهلا بني النحلوس إن فقيدكم","https://www.aldiwan.net/poem52658.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[567,"ولست إذا ما سرني الدهر ضاحكا","https://www.aldiwan.net/poem52009.html","الطويل"],[571,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[573,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[573,"رقدت ولواحظ مسهري","https://www.aldiwan.net/poem2946.html","مجزوء الكامل"],[585,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"]],"verses":[["ولاّج بابٍ أناخَ الخَطْبُ كَلْكَلَهُ","بهِ ومِنْ غمَراتِ الموتِ خَرّاجِ",0,"ج",1,0],["وَلَأَجهَدَنَّ عَلى اللِقاءِ لِكَي أَرى","ما أَرتَجيهِ أَو يَحينَ قَضائي",1,"ا",2,0],["ولا جهِلَتْ نفْسي أياديَ التي","جعلْتُ لِساني بعْدَها رهْنَ حَمْدِهِ",2,"د",2,0],["ولأجْلِ هَذا اخْتَصّني بلِباسِه","مَلِكُ العُلى الأرْضَى أبو الحَجّاجِ",3,"ج",1,0],["وَلأِجْلِ قُطْرِكَ شَمْسُهَا وَنُجُومُهَا","عَدَلَتْ عَنِ التَّشْرِيقِ لِلتَّغْرِيبِ",4,"ب",1,0],["وَلا جَلاَلَ زَفَافِي","وَرَوْعَةَ المَهْرَجَانِ",5,"ن",1,0],["وَلا جُرمَ لي أَن أَسَأتَ جَنا","ةَ مَزرَعَةٍ كانَ حَرّاثَها",6,"ث",3,0],["وَلا جافِياً عَن قائِمِ السَيفِ قَبضُهُ","إِذا الفَشِلُ الرِعديدُ قُفَّت أَنامِلُه",7,"ل",2,0],["وَلا جُعبُساً عَيّابَةً مُتَهَكِّماً","عَلَينا وَلا فَهّاً كَهاماً مُفَيَّلا",8,"ل",2,0],["ولأجله الأغصان مالت من صباً","والبدر طول الليل بات مسهدا",9,"د",2,0],["ولا جلد على إنكار دهرٍ","رمى قلبي الوحيد بفرقتين",10,"ن",1,0],["وَلا جَلستُ إِلى قَومٍ أُحَدِّثُهُم","إِلّا وَأَنتَ حَديثي بَينَ جُلّاسي",11,"ي",1,0],["ولا جُرمَ لي أن أساءت جَنا","ةُ مزرعةٍ كان حَرَّاثَها",12,"ث",3,0],["ولا جُناحَ على حام حقيقتَهُ","لا ظلم في دَفْع ظلمٍ عند ذي بصر",13,"ر",1,0],["ولا جورَ إلا جورُهُ في اكتنائه","أبا الصقر أنَّى ذاك وهو ابنُ بلبلِ",14,"ل",1,0],["وَلا جُشَمٍ شَرِّ القَبائِلِ إِنَّها","كَبَيضِ القَطا لَيسوا بِسودٍ وَلا حُمرِ",15,"ر",1,0],["وَلا جَمالٌ أَنيقٌ","وَلا شَبابٌ نَضيرُ",16,"ر",1,0],["وَلا جَمالُ الشُهبِ ما حَيَّرَني","وَإِنَّما حَيَّرَني جَمالي",17,"ي",1,0],["وَلا جَزِعَ الشَجَرُ الناضِرُ","وَلا اِكتَأَبَ الجَدوَلُ المُطرَبُ",18,"ب",1,0],["وَلا جَبأَ أَكهى مُرِبٍّ بِعِرسِهِ","يُطالِعُها في شَأنِهِ كَيفَ يَفعَلُ",19,"ل",1,0],["وَلا جالَ إِلّا الخَيرُ بَينَ سَرائِري","لَدى سُدَّةٍ خَيرِيَّةِ الرَغَباتِ",20,"ت",1,0],["وَلا جَلَسَ البَحرُ المُحيطُ لِقاصِدٍ","وَمِن تَحتِهِ فَرشٌ وَمِن فَوقِهِ سَقفُ",21,"ف",1,0],["وَلا جُرحُهُ يُؤسى وَلا غَورُهُ يُرى","وَلا حَدُّهُ يَنبو وَلا يَتَثَلَّمُ",22,"م",1,0],["وَلا جَبَلاً كَالزَوِّ يوقَفُ تارَةً","وَيَنقادُ إِمّا قُدتَهُ بِزَمامِ",23,"م",1,0],["وَلا جابِراً وَالحَينُ يورِدُ أَهلَهُ","مَوارِدَ أَحياناً إِلى غَيرِ مَصدَرِ",24,"ر",1,0],["وَلا جارَ بَعدَ اللَهِ خَيرٌ مِنَ الَّذي","وَضَعتُ إِلى أَبوابِهِ رَحلُ خائِفِ",25,"ف",1,0],["وَلا جارَ إِلّا اللَهُ إِذ حالَ دونَهُ","كَمَروانَ أَوفى لِلجِوارِ وَأَكرَما",26,"م",2,0],["وَلا جَبَرَت كَفّاهُ في كُلِّ بَلدَةٍ","كَبيرَ كِرامٍ ما لِكَسرِهِمُ جَبرُ",27,"ر",1,0],["ولأجل العصا سطا على الأفرع الخض","راء زانت بواسق الأشجارِ",28,"ر",1,0],["ولأجل العصا سطا على خشب البي","تِ طموحاً حتى لباب الدارِ",28,"ر",1,0],["وَلَاِجتُذِبَت فُرشٌ مِنَ الأَمنِ تَحتَكُم","هِيَ المُثلُ في لينٍ بِها وَالأَرائِكُ",29,"ك",1,0],["ولا جاراكمُ في كسبِ مالٍ","ولم يُعْهَد لهُ بكمُ اختلاطُ",30,"ط",1,0],["وَلا جارَ إِلّا مِن حُسامٍ مُصَمَّمٍ","وَلا دارَ إِلّا في قُتودِ الرَكائِبِ",31,"ب",1,0],["وَلا جاذَبَتني اَلريحُ فَضلَ ذُؤابَةٍ","لَبِستُ بِها ثَوبَ الشَبيبَةِ مُعلَما",32,"م",2,0],["وَلا جاوَرَتهُم مُنذُ كانوا مَسَبَّةٌ","وَلا فارَقَتهُم مُنذُ حَلّوا المَكارِمُ",33,"م",1,0],["وَلا جرمَ لِلمِصرِيِّ فيما تَأَوَّلوا","وَلَكِن أَساءَ النيلُ صُنعاً وَأَجرَما",34,"م",2,0],["وَلا جَشِمتُ وَلا كَلَّفتُ راحِلَتي","أَجواز طامِسَةٍ أَعلامُها بِيدِ",35,"د",1,0],["وَلا جَوْرَ في أحْكَامِهِ غَيْرَ أَنه","عَلَى الخائِنِينَ الجَائرِينَ يَجُورُ",36,"ر",1,0],["ولا جَرّدُوا نَصْلاً تُخَافُ شَباتُه","ولكِنّ فُولاذاً غَدا وهو آنُك",37,"ك",1,0],["وَلا جانَبنَ مُذ كُنَّ","نَعيمَ العَيشِ وَالخَفضا",38,"ض",2,0],["وَلا جَميلاً في الناسِ نَعلَمُهُ","إِلّا وَأَدنى فِعالَهُ أَجمَل",39,"ل",1,0],["وَلا جَناحانِ تَكَنَّفاهُ","مِنهُ إِذا طارَ وَقَد تَلاهُ",40,"ا",2,0],["ولا جور الأمير وحجر قاضٍ","ولا قولِ المؤذّنِ والإمام",41,"م",1,0],["وَلاجَتِ النارُ كَالشَقراءِ يَحبِسُها","عَن مُهرِها القَيدُ وَهناً فَهيَ لا تَقِرُ",42,"ر",1,0],["وَلأَجْعَلَنَّ بِهِ البِلاَدَ مَنِيعَةً","يَرْتَدُّ عَنْهَا الطَّامِعُ المُتَوَثِّبُ",43,"ب",1,0],["ولا جُوِّعَ المرَّ مرَّ الدواءِ","ولا وخَزَتْ مَنكبِيه الإبر",44,"ر",1,0],["ولا جار في عهد المظالم حينما","تولَّى زمام الحكم في مصرَ جائره",45,"ر",2,0],["ولا جهلت نفسي أياديك التي","جعلت لساني بعدها رهن حمده",46,"د",2,0],["ولأجل هذا اختصني بلباسه","ملك العلا الأرضي أبو الحجاج",47,"ج",1,0],["ولا جَحوداً بان الليلَ يُعقبه","فَجرٌ تفجَّّرُ كمه الشمس مُطَّلَعا",48,"ع",2,0],["وَلاَ جُود لِلإِنْسَانِ إِلاَّ علَى دَخْلِ","تَحنُّ إِلى الصُّقْعِ الَّذِي لَمْ يَبَرَّهَا",49,"ه",2,0],["ولا جبين منير","عليه يزهو الهلال",50,"ل",1,0],["ولأجلكم باع الفؤاد بلا ثمن","مستغرق بغرامكم أمد الزمن",51,"ن",1,0],["ولأجله صاغ الوجود بحكمةٍ","مدت بساط سنينه وشهوره",52,"ر",2,0],["ولا جرى في مسمعي صوته","جرى نمير الماء في الغدر",53,"ر",1,0],["ولا جناة ولا أَرض يضرجها","دم زكي ولا أخاذ بالثار",54,"ر",1,0],["ولا جيرةَ بالهوب خنا وِدادهمُ","لفرقتنا عنهم زماناً بلا جُرْمِ",55,"م",1,0],["ولا جزالة معناه الجليّ ولا","إنكار ما فيه من لطف الإشارات",56,"ت",1,0],["ولأجلها غَبَط الغَبي","طَ حجابُ قلبي والسوادُ",57,"د",1,0],["ولا جعلتُ اللَّمى وِرْدي وقد ضمِنتْ","غمامةُ الجود إصداري وإيرادي",58,"د",2,0],["ولا جُناحَ على مُرسٍ كلا كلَه","إذا تقدّم إعذارٌ وإنذارُ",59,"ر",1,0],["وَلا جاوَزَ الذَمُّ فيهِ الثَنا","وَلا ذَعَرَ الناسُ عَنهُ الأَمَل",60,"ل",1,0],["وَلا جاوَدا الأَجوادَ إِلّا وَأَربَيا","وَلا فاضَلا الأَمجادَ إِلّا وَفُضِّلا",61,"ل",2,0],["ولا جار في أمر على الجار حكمه","ولكن إذا علىَّ فتى منهلا علا",62,"ل",2,0],["وَلا جَمَعَتنا آخِرَ الدَهرِ نِيَّةٌ","إِلى أَن يَضُمَّ البَعثُ عاداً وَجُرهُما",63,"م",2,0],["وَلا جَوادٌ أَقَبُّ الظَهرِ مُنجَرِدٌ","يَهوي بِهِ كَهُوِيِّ الأَجدَلِ القَطِمِ",64,"م",1,0],["وَلِأَجلِهِ التاريخُ نادى نَظمَهُ","بالبِرِّ قُسطنطينُ قَد نالَ الفِدى",65,"د",2,0],["وَلِأَجلِها كَتبَ المُؤرِّخُ أَسطُراً","يُهدى بِها بُشرى الخَلاصِ لِمريَمِ",66,"م",1,0],["وَلأجلهِ كَتَبَ المُؤرِّخُ قائِلاً","قَمَرٌ أَتاهُ الخَسفُ قَبلَ كَمالِهِ",67,"ل",2,0],["ولا جفاني خلي كنت آلفه","إلا عدلت إلى ضرب من الجذل",68,"ل",1,0],["ولا جمل ولا نسب جميل","يصون الوجه عن بذل السؤال",69,"ل",1,0],["وَلا جائزٌ منهم هجومٌ عليهما","وَلَو بَقِيا في السرِّ وَحدهما شهرا",70,"ر",2,0],["وَلا جَعَلنَ مَحمَلَ ذي السِلاحِ مَجَنَّهُ","رَعنَ اليَتيمَةِ وَاِفتَرَشنَ لِواها",71,"ا",3,0],["ولاَّجُ أبوابِ الأمورِ برأيهِ","طلاَّعُ أنجادٍ لها وهضاب",72,"ب",1,0],["ولا جرى ذكر العقيق مذ بدا","الا جرى من مقلتي في خدي",73,"ي",1,0],["ولاِجل اربك ووصلِك","صاحبت غير الحبايب",74,"ب",1,0],["ولا جاده الغيث مِن منزلٍ","كأنّ مجالسَه كُنْفُهُ",75,"ف",2,0],["وَلا جَهمٌ وَقَد أَلقَت عَصاها","بِساحَتِهِ الوُفودُ وَلا جَهامُ",76,"م",1,0],["ولأجل هذا السرّ قال وشمسُنا","أبداً على فَلَكِ العلا لا تغرب",77,"ب",1,0],["ولا جنةٌ تُرجى ولا نارُ تُختشى","فَأَنسَى وأُنسَى والوجودُ هو التعس",78,"س",1,0],["ولأجل عينيك البنفسج شاقني","فجنيتُه وشممتُه نشوانا",79,"ن",2,0],["ولا جسمَ منهوكٌ ولا صدرَ ضيِّقٌ","ولا قلبَ مصدوعٌ يعلُّ سماما",80,"م",2,0],["ولأجلنا صَلّينَ كلَّ عشيَّةٍ","وصبيحةٍ فصلاتُكنَّ تقينا",81,"ن",2,0],["وَلا جالَ فِي شَرْقِ الهَوَى مَشْرِق الضحَى","وَلا قالَ فِي ظِلِّ العُلا شامِخ الطَّودِ",82,"د",1,0],["وَلا جَدى المُزنِ إِلّا فَيضُ نائِلِهِ","وَلا شَذا المِسكِ إِلّا طيبُ رَيّاهُ",83,"ا",2,0],["وَلِأَجلِ ذا قالَ البَشيرُ مُؤَرِّخاً","يَحظى سُلَيمانَ بِيُمنِ مُحَمِّدِ",84,"د",1,0],["ولا جنيني فاعلمي بمتبعي","هذا جوابي فاستمري أو دعي",85,"ي",1,0],["ولا جعلَتْ إلاّ بوَجْهِكَ عِيدَها","ولا رَضيتْ إلاّ عِداكَ الأضاحيا",86,"ي",2,0],["ولا جَسداً تناءَتْ منه روحٌ","ويَبقى بعدَها حيّاً فُواقا",87,"ق",2,0],["ولا جُفونُ الرّجاءِ أن قَرِحَتْ","ولا فُؤادُ العُلا أنِ انصَدعا",88,"ع",2,0],["ولا جانبَ يَزْوَرُّ","ولا حاجبَ يُمتَطّ",89,"ط",1,0],["ولأجلِ عُذْرٍ واحدٍ","يَهَبُ الذُّنوبَ وهُنّ كُثر",90,"ر",1,0],["ولا جَمْعُ أهلِ الأرضِ ينفَعُهم إذا","بنَصْرِكُمُ ربُّ السماءِ تَفَرّدا",91,"د",2,0],["ولأجلِ ذلكَ ما بَلغتُ بِمَدحِهِ","إلا إلى أن أعلَمَ المَعلُوما",92,"م",2,0],["ولأجل ذلك ما يسمّى باسمه","حسناً ولم يلحقه إلا غاصبُه",93,"ب",2,0],["ولا جاهلٌ إلّا وفيها محكَّمٌ","ولا عاقلٌ إلّا وفيها ملطَّف",94,"ف",1,0],["ولا جَفَا النّومُ مِنْ بَعْدي نواظرَكم","وناظري بعدكم أودَى به السَّهَدُ",95,"د",1,0],["ولا جَرتْ لِلنّوى يوماً مَدامعكم","ومِدمعي أبداً في الخَدِّ يَطّردُ",95,"د",1,0],["ولا جمعوا مالاً ولا كسبوا لهم","قصوراً ولا باهوا برفع بناها",96,"ا",3,0],["ولا جبل يبقى وإن طال مكثه","وكل له بعد الوجود زوال",97,"ل",1,1],["ولاجتهدت بمنعته عقول","لها في الرأي حقّ الاجتهاد",98,"د",1,0],["ولا جنى برقعٌ ورد الخدود ولم","تعطِ الميازر عطفيها ولم تهبِ",99,"ب",1,0],["ولأَجْلِ صرفِ الدهرِ صرتُ متى","أَبصرتُ لم أَبصِرْ سوى ظُلَمِ",100,"م",1,0],["ولا جفن لي إلا وأقرحهُ البكا","ولا قلب إلا قد يراهُ التشوّق",101,"ق",1,0],["ولا جاشَتِ الآفاقُ من طِيبِ ذِكرِهِمْ","بِجَيشِ ثناً إلّا وَفِي وسْطِهُ بَندي",102,"د",2,0],["ولا جابُوا إِلَيْهِ القَفْرَ حَتَّى","تَجَاوَبَتِ الحمائِمُ بالبُكاءِ",103,"ا",2,0],["ولا جُدْتُ لِلدُّنيا بِخَلَّةِ واصِلٍ","ولَوْ بَرَزَتْ لي فِي غَلائِلِها الخُضْرِ",104,"ر",1,0],["ولأَجْلُوَنْ منها لأَبصارِ النُّهى","حُرَّ الخِطابِ وحُرَّةَ الخُطَّابِ",105,"ب",1,0],["ولأَجْعَلَنَّ ثناءها وجَزاءها","أَبَدَ الأَبِيدِ وعاقِبَ الأَعْقابِ",105,"ب",1,0],["ولأَجْعَلَنْ منها تمائِمَ خائفٍ","من طائِفٍ أَوْ مِنْ رجاءٍ خائبِ",106,"ب",1,0],["ولا جهلها عن بالغ الحلم عاقل","له واسع بالخطر والحجر والنبا",107,"ب",2,0],["ولا جادت قرائحنا بشعر","تضوع منه عطر الياسمين",108,"ن",1,0],["ولّاجَةً تطأ الصدورَ بها","كَلِمٌ توسِّعُ ضيِّق العُذرِ",109,"ر",1,0],["ولا جلوتُ ووجه اليوم مبتسمٌ","شمساً من السُّمر في ظلٍّ من السّمر",110,"ر",1,0],["ولا جرتْ أدمعي والشملُ مجتمعٌ","اِلاّ لما علمَ الأحبابُ مِن حَذَري",111,"ر",2,0],["ولأَجلِها هَجَرَ الأَحِ","بَّةَ والمَساكِنَ والإِقامَهْ",112,"م",2,0],["ولا جاهٌ ولا مالٌ","ولا عزٌّ وسلطانُ",113,"ن",1,0],["ولا جهل والعلم اللدنّي شعارها","ولا ذنب إذ منها التجاوز والعفو",114,"و",1,0],["ولأجل هذا كل شيء هالك","والكل فانٍ قال في التعبير",115,"ر",1,0],["ولا جنود عندنا","ولا نريد عسكرا",116,"ر",2,0],["ولأجلنا ظهر الوجود بكل ما","هو ظاهر وأنارت الأسحار",117,"ر",1,0],["ولأجله جاء الخطاب بعزهم","ولهم تزايد عندها المقدار",117,"ر",1,0],["ولأجل هذا جاءنا عن سبه","نهي النبي بعلمه الموروث",118,"ث",1,0],["ولأجلها كَتَبَ المؤرِّخُ راقِماً","في نحوِ عُمرِ البدرِ كانَ خُسوفُها",119,"ه",2,0],["ولأجلِها كَتَبَ المؤرِّخُ عاجِلاً","مِن عن يمينِ العرشِ قامَت مَريمُ",120,"م",1,0],["ولأجلهِ كَتَبَ المؤرِّخُ نظمَهُ","إنَّ الكواكبَ في السَّماءِ قَرارُها",121,"ر",3,0],["ولأجلهِ كَتَبَ المؤرِّخُ حُكمَهُ","في أرفَعِ الدَّرَجاتِ ميخائيلُ",122,"ل",1,0],["ولا جماد لا ولا نبات","في عامر الأرض ولا الفلاة",123,"ه",1,0],["ولا جاعلا عِرضي لمالي وقاية","ولكن أَقي عرضي فيحرزه وفري",124,"ي",1,0],["وَلا جَلَدي عَنهُم سَلُوّاً وَقَسوَةً","وَلَكِنَّ عودُ الأَكرَمينَ صَليبُ",125,"ب",1,0],["ولأَجْلِ قَبْرِك صِرْتُ من أَدَبِي","أُولي المقابرَ جُلَّ إِجْلاَلِي",126,"ي",1,0],["ولأَجْلِ ذاكَ حَدَدْتُهَا","بالدَّمْع حَدَّ المُفْتَرِي",127,"ي",1,0],["ولا جرى في مسم السمع من مسمر","إلاَّ ذكرت اجتماعي بالأخلاء",128,"ا",2,0],["ولا جلست بما نوس أخي تقسة","صافي المشارب من أغباء أعداء",128,"ا",2,0]]}