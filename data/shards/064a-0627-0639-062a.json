{"poems":[[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"سبحان جبار السماء","https://www.aldiwan.net/poem63210.html","مجزوء الكامل"],[51,"يا عتب هجرك مورث الأدواء","https://www.aldiwan.net/poem63211.html","الكامل"],[51,"يا عتب يا درة الغواص","https://www.aldiwan.net/poem64229.html","مخلع البسيط"],[51,"يا عتب ما لي ولك","https://www.aldiwan.net/poem64264.html","مجزوء الرجز"],[51,"من لم يذق لصبابة طعما","https://www.aldiwan.net/poem64898.html","الكامل"],[51,"يا عتب سيدتي أما لك دين","https://www.aldiwan.net/poem64915.html","الكامل"],[51,"بالله يا حلوة العينين زوريني","https://www.aldiwan.net/poem65335.html","البسيط"],[51,"يا عتب ما شاني وما شانك","https://www.aldiwan.net/poem65349.html","السريع"],[68,"ياعترة المختار يا من بهم","https://www.aldiwan.net/poem41390.html","السريع"],[68,"يا عترة المختار يا من","https://www.aldiwan.net/poem41542.html","السريع"],[46,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[398,"دمن عفون بذي الأراك","https://www.aldiwan.net/poem53665.html","مجزوء الكامل"],[572,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122353","السلسلة"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63990","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119863","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80002","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108691","الخفيف"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104434","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108181","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110003","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133250","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72409","الكامل"],[4862,"معزوفة الشجن","https://www.poetsgate.com/ViewPoem.aspx?id=55383",""],[4882,"سمّي العراقَ اذا ما اصْلحتْ ذِمما-بهاء الدين الخاق","https://www.poetsgate.com/ViewPoem.aspx?id=11522",""],[5106,"سَاْجَ الهَوَىْ وًرِشَاً ..","https://www.poetsgate.com/ViewPoem.aspx?id=137169",""],[6167,"الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85476&r=&rc=5",""]],"verses":[["يا عترة لم تزل ممدَّحة","ينكِّبُ الطعن عن خلائقها",0,"ق",3,0],["يا عُتبَ مَن لَم يَبكِ لي","مِمّا لَقيتُ مِنَ الشَقاءِ",1,"ا",2,0],["يا عُتبُ إِنَّكِ لَو شَهِد","تِ عَلَيَّ وَلوَلَةَ النِساءِ",1,"ا",2,0],["يا عُتبُ سَيِّدَتي أَعي","ني حُسنَ وَجهَكِ بِالسَخاءِ",1,"ا",2,0],["يا عُتبُ هَجرُكِ مورِثُ الأَدواءِ","وَالهَجرُ لَيسَ لِوُدِّنا بِجَزاءِ",2,"ا",2,1],["يا عُتبُ يا دُرَّةَ الغَوّاصِ","يا عُتبُ يا دُرَّةَ الغَوّاصِ",3,"ص",1,1],["يا عُتبُ ما لي وَلَكِ","يا لَيتَني لَم أَرَكِ",4,"ك",1,1],["يا عُتبُ ما أَنا عَن صَنيعِكِ بي","أَعمى وَلَكِنَّ الهَوى أَعمى",5,"م",2,0],["يا عُتبَ سَيِّدَتي أَما لَكَ دينُ","حَتّى مَتى قَلبي لَدَيكِ رَهينُ",6,"ن",1,1],["يا عُتبُ أَينَ أَفِرُّ مِنكِ أَميرَتي","وَعَلَيَّ حِصنٌ مِن هَواكِ حَصينُ",6,"ن",1,0],["يا عُتبَ ما أَنتِ إِلّا بُدعَةٌ خُلِقَت","مِن غَيرِ طينٍ وَخَلقُ الناسِ مِن طينِ",7,"ن",1,0],["يا عُتبَ ما شاني وَما شانِك","تَرَفَّقي أُختي بِسُلطانِك",8,"ك",1,1],["يا عُتبُ ما شاني وَماشانِك","تَرَفَّقي سِتّي بِسُلطانِك",8,"ك",1,0],["ياعِترَةَ المُختارِ يا مَن بِهِم","أَرجو نَجاتي مِن عَذابٍ أَليم",9,"م",1,1],["يا عِترَةَ المُختارِ يا مَن بِهِم","يَفوزُ عَبدٌ يَتَوَلّاهُمُ",10,"م",1,1],["يا عُتبَةَ بنَ أَبي عُصَيمٍ دَعوَةً","شَنعاءَ تَصدِمُ مِسمَعَيكَ فَتَصعَقُ",11,"ق",1,0],["يا عَترَةَ الزَهراءِ اِن","نَّ المَجدَ جَمٌّ في ذراكِ",12,"ك",1,0],["ياعترةً حبُّهمْ يبينُ بِهِ","صالِحُ هذا الوَرَى وطالِحُهْ",13,"ح",2,0],["يا عترة ذاك ا لامام فاق وفقتم","ان قصر مدحي لكم فعجزي ادراك",14,"ك",1,0],["يا عِتْرةَ المصطفى نفسي فداؤكُمُ","من عترةٍ بهمُ في الخوفِ نَمْتَنِع",15,"ع",1,0],["ياعتب لا عتب على طيف سرى","حيا فأحيا مستهاما مغرما",16,"م",2,0],["يا عترةَ الوحي الذين توطَّدت","بهم دعائم ملَّة التوحيد",17,"د",1,0],["يا عتابي وياشرابي الذكيي","ن على خده المورد جورا",18,"ر",2,0],["يا عترة الهادي النبي ومن بكم","قبل الإله من الورى استغفارها",19,"ر",3,0],["يا عتاباً عليك من بعد ودّ","وثناءٍ يزري بكلّ عبير",20,"ر",1,0],["يا عِترةَ الجَدِّ القديم دَعِي البُكا","كُفّي عن النَوحِ المبرّحِ وانكَفي",21,"ف",2,0],["يا عترة المصطفى من فيض أنعمكم","كم نلت عزا بكم في كل أطواري",22,"ر",2,0],["يا عترة الكرَّار يا","أبناء سيدة النساء",23,"ا",2,0],["ياعتمة نسجت عليّ رداءَها","هل لي إلى الفجر الجميل مجالا",24,"ل",2,0],["يا عترة عصمت في عصرنا بلدا","سمّي العراق اذا ما اصْلِحتْ ذِمما",25,"م",2,0],["يَاْ عِتْقَ رُوْحِيْ وَأَنْفَاْسيْ وِعِطْرَ دَمِيْ","بِاللهِ فَاسْقِ .. فَإِنَّ الصَّبْرَ قَدْ يَبِسَاْ",26,"س",2,0],["يا عتمةُ الليل البَهيمِ سلاكِ منْ","لا يَرقبنْ في الله فهو المزدري",27,"ر",2,0]]}