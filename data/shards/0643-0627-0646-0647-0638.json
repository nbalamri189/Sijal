{"poems":[[469,"وصاحبين تمادى جمع شملهما","https://www.aldiwan.net/poem3599.html","عموديه"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76559","البسيط"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205252","البسيط"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[3680,"","https://poetry.dctabudhabi.ae/diwan/poem/203333",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216728","المجتث"],[2365,"وحارس غفلة حرّاسه","https://www.poetsgate.com/ViewPoem.aspx?id=200644",""]],"verses":[["كأنهُ ظلّهُ ما أن يفارقهُ","إمّا مقيماً وإمّا سائراً",0,"ر",2,0],["كأنه ظنّ أني قد نسيت له","عهدا فعرّض لي بالّلام والألف",1,"ف",1,0],["كأنهُ ظلّهُ ما أن يفارقهُ","إمّا مقيماً وإمّا سائراً معه",2,"ع",2,0],["كأنه ظن جرح القلب كاس طلا","او ظن ما تنثر الاجفان رمانا",3,"ن",2,0],["كأنه ظن من صفاها","بأنها عينه فصاحا",4,"ح",2,0],["كأنه ظلُّ كونٍ","مغيّب في الدهور",5,"ر",1,0],["كأنه ظبي على رقبة","تشتبه المقلة والجيد",6,"د",1,0]]}