{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[53,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[86,"من لم يذق فقد أليف الصبا","https://www.aldiwan.net/poem10469.html","السريع"],[73,"إني ذكرتك بازهراء مشتاقا","https://www.aldiwan.net/poem11858.html","البسيط"],[73,"ما على ظني باس","https://www.aldiwan.net/poem11908.html","مجزوء الرمل"],[30,"نلم بدار قد تقادم عهدها","https://www.aldiwan.net/poem29449.html","الطويل"],[30,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[72,"سلوت لكن قلبي يا سعاد سلي","https://www.aldiwan.net/poem19470.html","البسيط"],[72,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"لعمرك ما أعطى الرجال حقوقهم","https://www.aldiwan.net/poem65513.html","الطويل"],[51,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"أطال الليل أم طال المقام","https://www.aldiwan.net/poem62708.html","عموديه"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[85,"بين سمع الله والبصر","https://www.aldiwan.net/poem7590.html","المديد"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[43,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[43,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[43,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[62,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[45,"نلت ما نلت يا بغيض بأم","https://www.aldiwan.net/poem10208.html","الخفيف"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[45,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[45,"عن أي ثغر تبتسم","https://www.aldiwan.net/poem65669.html","مجزوء الكامل"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[45,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[61,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[61,"نل من الأيام ثارا","https://www.aldiwan.net/poem51609.html","مجزوء الرمل"],[49,"إسمع فقد آذنك الصوت","https://www.aldiwan.net/poem10850.html","السريع"],[49,"عيب ابن آدم ما علمت كثير","https://www.aldiwan.net/poem62077.html","الكامل"],[49,"الخلق مختلف جواهره","https://www.aldiwan.net/poem62115.html","الكامل"],[49,"قلب الزمان سواد رأسك أبيضا","https://www.aldiwan.net/poem62140.html","الطويل"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[66,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[44,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[87,"ذهب الصبا وتولت الأيام","https://www.aldiwan.net/poem8289.html","الكامل"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[105,"الله أكبر جل الخطب واحتكمت","https://www.aldiwan.net/poem43158.html","البسيط"],[105,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[105,"نلومك يا يوم النحوس ونعذل","https://www.aldiwan.net/poem43568.html","الطويل"],[102,"هل كفر كنه مرجع لي ذكرها","https://www.aldiwan.net/poem33006.html","الكامل"],[40,"عوجي علينا ربة الهودج","https://www.aldiwan.net/poem42341.html","السريع"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[48,"من رأى مثل ما أغالي من البيع","https://www.aldiwan.net/poem64414.html","الخفيف"],[48,"عصيت في السكر من لحاني","https://www.aldiwan.net/poem66118.html","مجزوء البسيط"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[46,"إن دمعي نبع وما العود نبع","https://www.aldiwan.net/poem22948.html","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141038",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54930","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142062","البسيط"],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[58,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[51,"عيدٌ يعود كعود عُرفك دائماً","https://www.poetsgate.com/ViewPoem.aspx?id=30407",""]],"verses":[["نَلومُ أَكُفُّ المُحسِنينَ إِذا جَنَت","فَكيفَ بِأَيدٍ لا يُنالُ جَداها",0,"ا",3,0],["نِلتَ ما نِلتَهُ اِنفِراداً وَزاحَم","تَ الدَراري عَلى العَلاءِ اِشتِراكا",1,"ك",2,0],["نُليحُ أَن تَرتَعي الأَقدارُ أَنفُسَنا","وَكُلُّنا لِلمَنايا السودِ مُزدَرَعُ",2,"ع",1,0],["نَلهو وَمانَحنُ إِلّا لِلرَدىأُكَلٌ","وَالدَهرُ يَمضَغُنا وَالأَرضُ تَبتَلِعُ",2,"ع",1,0],["نَلُمُّكُمُ وَاللَهُ يَصدَعُ شَعبَكُم","وَلا يَجبُرُ الأَقوامُ ما اللَهُ كاسِرُ",3,"ر",1,0],["نُلينُ عَطائِفَنا لِلقَريبِ","وَنولي المُجانِبَ قُرباً أَجَدّا",4,"د",2,0],["نِلتَ بَعضاً وَسَوفَ تُدرِكُ كُلّاً","إِنَّما السَيلُ بَعدَ قَطرِ العِهادِ",5,"د",1,0],["نَلعَبُ بِاللَفظِ كَما نَشتَهي","وَنُضمِرُ المَعنى فَما يَظهَرُ",6,"ر",1,0],["نَلهو بِما يَستَميلُ العَينَ مِن زَهَرٍ","جالَ النَدى فيهِ حَتّى مالَ أَعناقا",7,"ق",2,0],["نَلبَسُ الدُنيا وَلَكِن","مُتعَةٌ ذاكَ اللِباسُ",8,"س",1,0],["نُلِمُّ بِدارٍ قَد تَقادَمَ عَهدُها","وَإِمّا بِأَمواتٍ أَلَمَّ خَيالُها",9,"ه",2,1],["نَلوثُ عَلى مَعارِفِنا وَتَرمي","مَحاجِرَنا شَآمَيَةٌ سَمومُ",10,"م",1,0],["نلوذ من المولى الإمامِ محمّدٍ","بظلٍّ على نهر المبرَة مُمُتَدِّ",11,"د",1,0],["نلك المدارس قد أوحشتها فغدت","خلواً من الدرس والطلاب والكتب",12,"ب",1,0],["نلنا المنى السهل يا من حلمهُ جبلٌ","يا فائض الفضل بين السهل والجبل",13,"ل",1,0],["نلت العلى وكبتّ الحاسدين على","يد اغتنائك لا حيْلي ولا حيَلي",14,"ل",2,0],["نَل النجمَ فاطمسْه وأنَّى تنالُه","ولو نلتَه ما خلتُ أنك طامسه",15,"س",2,0],["نُلقَّى عقوقاً من رجالٍ مبرة","فإن لج لقَّينا عقوقاً عقوقها",16,"ق",3,0],["نلقبه شَنُوفيّاً","برغم عُداته السفلَهْ",17,"ل",2,0],["نَلهو وَنَلعَبُ لا نُبالي ضَمَّنا","كوخٌ حَقيرٌ أَم حَوانا مَنزِلُ",18,"ل",1,0],["نُلامُ عَلى الكَلامِ وَقَد أَصَبنا","وَقَد ضَلّوا الصَوابَ فَلا يُلاموا",19,"م",3,0],["نلتِ في ما نلت من مظهرها","ومنحت الخلد ذكرا ونبا",20,"ب",2,0],["نلبى إن أشار براحتيه","إلى حصن فيسبقنا إليه",21,"ه",1,0],["نلت بالميلاد من فطن","ما ينال الناس بالعمر",22,"ر",1,0],["نِلتُم جَليلاً وَلا تُعطونَ خَردَلَةً","إِلّا الَّذي دَفَعَ الدُستورُ أَو جَلَبا",23,"ب",2,0],["نَلومُكَ يا عَلِيُّ لِغَيرِ ذَنبٍ","لِأَنَّكَ قَد زَرَيتَ عَلى العِبادِ",24,"د",1,0],["نِلتَ ما لا يُنالُ بِالبيضِ وَالسُم","رِ وَصُنتَ الأَرواحَ في الأَجسادِ",25,"د",1,0],["نِلتَ وَما نِلتَ مِن مَضَرَّةِ وَه","شوذانَ ما نالَ رَأيُهُ الفاسِد",26,"د",1,0],["نلوِّحُ وجداً في الضميرِ مجمجماً","ونمسحُ خدَّاً بالدموع منمنما",27,"م",2,0],["نِلتَ ما نِلتَ يا بَغيضُ بِأُمٍّ","هِيَ أَعطَتكَ رُتبَةَ الوُزَراءِ",28,"ا",2,1],["نِلناهُمُ قَبلَ الشُروقِ بِأَذرُعٍ","يَهزُرنَ في كَبِدِ الظَلامِ شُروقا",29,"ق",2,0],["نَلقى المَنونَ حَقائِقاً وَكَأَنَّنا","مِن غِرَّةٍ نَلقى بِهِنَّ شُكوكا",30,"ك",2,0],["نِلنا الهُدى بَعدَ العَمى","بِكَ وَالغِنى بَعدَ العَدَم",31,"م",1,0],["نُلحى عَلى الوَجدِ مِن ظُلمٍ فَدَيدَنُنا","وَجدٌ نُعانيهِ أَو لاحٍ يُعَنّينا",32,"ن",2,0],["نُليحُ مِنَ الغَرامِ إِذا اِعتَرانا","وَأَبرَحُ مِنهُ أَلّا يَعتَرينا",33,"ن",2,0],["نِلتَه إذ غدَت رماحُك سُوراً","حولَ سُورٍ له أبَى أن يُنالا",34,"ل",2,0],["نَلْ من الأيَّامِ ثارا","وانتَصِرْ منها انتِصارا",35,"ر",2,1],["نَل كُلَّ ما شِئتَ وَعِش آمِناً","آخِرُ هَذا كُلِّهِ المَوتُ",36,"ت",1,0],["نَل ما بَدا لَكَ أَن تَنالَ مِنَ الغِنى","إِن أَنتَ لَم تَقنَع فَأَنتَ فَقيرُ",37,"ر",1,0],["نَل ما بَدا لَكَ أَن تَنالَ مِنَ ال","دُنيا فَإِنَّ المَوتَ آخِرُهُ",38,"ر",2,0],["نَل أَيَّ شَيءٍ شِئتَ مِن نَوعِ المُنى","فَكَأَنَّ شَيئاً لَم تَنَلهُ إِذا اِنقَضى",39,"ض",2,0],["نُلَبّي مُنادي الإِصطِباحِ إِذا دَعا","وَنَدعو سَميعَ الإِغتِباقِ إِذا لَبّى",40,"ب",2,0],["نِلتُ مِن وُدِّكَ الجَميلِ اِنتِصافي","حَيثُ مِن سائِرِ القَذى أَنتَ صافي",41,"ي",1,1],["نَلقَ مَهَاة عيشك من مَهَاةٍ","وزينتها القلادةُ والسّوارُ",42,"ر",1,0],["نِلْتُ المُنَى بابنِ عبّادٍ فَقَيّدَني","عَنِ البدورِ الَّتي لي فيك بالبِدَرِ",43,"ر",1,0],["نَلِ الثُرَيّا أَوِ الشِعرى فَلَيسَ فَتىً","لَم يُغنِ خَمسينَ إِنساناً بِإِنسانِ",44,"ن",1,0],["نَلْهُو وَنَلْعَبُ بَيْنَ خُضْرِ حَدَائِقٍ","لَيْسَتْ بِغَيْرِ خُيُولِنَا تُسْتَامُ",45,"م",1,0],["نَلهو وَنَلعَبُ جاهِلينَ وَإِنَّني","لَأَرى حَياةَ الجاهِلينَ مُحالا",46,"ل",2,0],["نَلهو وَنَلعَبُ وَالأَرزاءُ مُحدِقَةٌ","بِنا وَحادي الرَدى في إِثرِنا عَجِلُ",47,"ل",1,0],["نَلقى جَبابِرَةَ الخُطوبِ أَعِزَّةً","وَنَهُمُّ بِالنُوَبِ العِظامِ عِظاما",48,"م",2,0],["نَلومُكَ يا يَومَ النُحوسِ وَنَعذِلُ","وَأَنتَ عَلى ما أَنتَ تَمضِي وَتُقبِلُ",49,"ل",1,1],["نلقي أحاجيَ بيننا فتثيرنا","للضّحكِ خاطئةٌ وذاتُ صواب",50,"ب",1,0],["نَلبَثُ حَولاً كامِلاً كُلَّهُ","لا نَلتَقي إِلّا عَلى مَنهَجِ",51,"ج",1,0],["نِلْتَ ما نِلْتَ لا بعقْلٍ رصينٍ","في المساعي ولا برأيٍ حصيف",52,"ف",1,0],["نِلتُ يَحيى وَأُمَّهُ وَأَباهُ","وَأَخاهُ وَأُختَهُ بِرَغيفِ",53,"ف",1,0],["نِلتُ لَذيذَ الحَرامِ مِنهُ","وَنالَهُ الناسُ بِالأَماني",54,"ي",1,0],["نَلهو إِلى نَورِ الخُزامى الثَعدِ","في زاهِرٍ مِن سَبِطٍ وَجَعدِ",55,"د",1,0],["نَلهو إِلَيهِ وَنَشكو بَثَّ أَنفُسِنا","في سَلوَةٍ وَزَوالُ اللَيلِ قَد أَفِدا",56,"د",2,0],["نَل يَسيراً مِنّي وَلا تَسبَعَنّي","في نَوالي فَإِنَّ ظمَئِيَ سِبعُ",57,"ع",1,0],["نلت وما نلت من مضرّة وهسو","ذان ما نال رأيه الفاسد",58,"د",1,0],["نلقي الخمائلَ بالخمائلِ حولنا","متعانقاتٍ سابغاتِ الفوفِ",59,"ف",1,0],["نُلقَّاهُ عن مَلكاتِ الزَّمانِ","أقاصيصَ لم يروِ عنها كتابْ",60,"ب",1,0],["نَلومُ على تَبلّدِها قُلوباً","تُكابِدُ من مَعيشَتِها جِهادا",61,"د",2,0],["نِلتَ الَّذي لَم يَنَلهُ بِالقَنا أَحَدٌ","فَاِهتِف لِأَنوَرِها وَاِحمِد نَيازيها",62,"ي",3,0],["نَلِينُ وإِنْ كُنَّا أَشِدَّاءَ لِلْهَوَى","وَنَغْضَبُ في شَرْوَى نَقِيرٍ فَنَشْتَدُّ",63,"د",1,0],["نَلْهُو بِهَا حِقْبَةً وَنَتْرُكُهَا","إِلى مَهَاوٍ فِي الأَرْضِ مُنْحَدِرَهْ",64,"ر",2,0],["نَلْتَقِي تَارَةً وَنَشْرُدُ أُخْرَى","كُلُّ تِرْبٍ فِي مَخْبَإٍ مُتَدَارِي",65,"ر",2,0],["نَلْقَى الصَّدِيقَ ابْنَ الأَصَادِقِ","وَالكَبِيرَ ابْنَ الأَكَابِرْ",66,"ر",1,0],["نَلْقَى العَدُوَّ بفَخْمَةٍ مَلْمُومَةٍ","تَنْفِي الجموعَ كَقَصْدِ رَأْسِ المَشْرِقِ",67,"ق",1,0],["نلقي على راحتيها أنفساً نهكت","فعل الغريق رأى في القرب مرساتا",68,"ت",2,0],["نلتَ ما لم تنلهُ -يا نيلُ- منا","ضاربات الأُسود والذُّؤبان",69,"ن",1,0],["نلهو ونامل امالا نسر بها","شريعة الموت تطوينا وتطويها",70,"ي",3,0],["نلوذ به من صَوْلة الظلم كالذي","يفرِ من الرَّمضاءِ بالنار يحتمي",71,"م",2,0],["نلقى أبا العباس بدراً طالعاً","وشقيقَه هارون نَجماً ناجما",72,"م",2,0]]}