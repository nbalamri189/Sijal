",2,"ع",1,0],["نَلهو وَمانَحنُ إِلّا لِلرَدىأُكَلٌ","وَالدَهرُ يَمضَغُنا وَالأَرضُ تَبتَلِعُ",2,"ع",1,0],["نَلُمُّكُمُ وَاللَهُ يَصدَعُ شَعبَكُم","وَلا يَجبُرُ الأَقوامُ ما اللَهُ كاسِرُ",3,"ر",1,0],["نُلينُ عَطائِفَنا لِلقَريبِ","وَنولي المُجانِبَ قُرباً أَجَدّا",4,"د",2,0],["نِلتَ بَعضاً وَسَوفَ تُدرِكُ كُلّاً","إِنَّما السَيلُ بَعدَ قَطرِ العِهادِ",5,"د",1,0],["نَلعَبُ بِاللَفظِ كَما نَشتَهي","وَنُضمِرُ المَعنى فَما يَظهَرُ",6,"ر",1,0],["نَلهو بِما يَستَميلُ العَينَ مِن زَهَرٍ","جالَ النَدى فيهِ حَتّى مالَ أَعناقا",7,"ق",2,0],["نَلبَسُ الدُنيا وَلَكِن","مُتعَةٌ ذاكَ اللِباسُ",8,"س",1,0],["نُلِمُّ بِدارٍ قَد تَقادَمَ عَهدُها","وَإِمّا بِأَمواتٍ أَلَمَّ خَيالُها",9,"ه",2,1],["نَلوثُ عَلى مَعارِفِنا وَتَرمي","مَحاجِرَنا شَآمَيَةٌ سَمومُ",10,"م",1,0],["نلوذ من المولى الإمامِ محمّدٍ","بظلٍّ على نهر المبرَة مُمُتَدِّ",11,"د",1,0],["نلك المدارس قد أوحشتها فغدت","خلواً من الدرس والطلاب والكتب",12,"ب",1,0],["نلنا المنى السهل يا من حلمهُ جبلٌ","يا فائض الفضل بين السهل والجبل",13,"ل",1,0],["نلت العلى وكبتّ الحاسدين على","يد اغتنائك لا حيْلي ولا حيَلي",14,"ل",2,0],["نَل النجمَ فاطمسْه وأنَّى تنالُه","ولو نلتَه ما خلتُ أنك طامسه",15,"س",2,0],["نُلقَّى عقوقاً من رجالٍ مبرة","فإن لج لقَّينا عقوقاً عقوقها",16,"ق",3,0],["نلقبه شَنُوفيّاً","برغم عُداته السفلَهْ",17,"ل",2,0],["نَلهو وَنَلعَبُ لا نُبالي ضَمَّنا","كوخٌ حَقيرٌ أَم حَوانا مَنزِلُ",18,"ل",1,0],["نُلامُ عَلى الكَلامِ وَقَد أَصَبنا","وَقَد ضَلّوا الصَوابَ فَلا يُلاموا",19,"م",3,0],["نلتِ في ما نلت من مظهرها","ومنحت الخلد ذكرا ونبا",20,"ب",2,0],["نلبى إن أشار براحتيه","إلى حصن فيسبقنا إليه",21,"ه",1,0],["نلت بالميلاد من فطن","ما ينال الناس بالعمر",22,"ر",1,0],["نِلتُم جَليلاً وَلا تُعطونَ خَردَلَةً","إِلّا الَّذي دَفَعَ الدُستورُ أَو جَلَبا",23,"ب",2,0],["نَلومُكَ يا عَلِيُّ لِغَيرِ ذَنبٍ","لِأَنَّكَ قَد زَرَيتَ عَلى العِبادِ",24,"د",1,0],["نِلتَ ما لا يُنالُ بِالبيضِ وَالسُم","رِ وَصُنتَ الأَرواحَ في الأَجسادِ",25,"د",1,0],["نِلتَ وَما نِلتَ مِن مَضَرَّةِ وَه","شوذانَ ما نالَ رَأيُهُ الفاسِد",26,"د",1,0],["نلوِّحُ وجداً في الضميرِ مجمجماً","ونمسحُ خدَّاً بالدموع منمنما",27,"م",2,0],["نِلتَ ما نِلتَ يا بَغيضُ بِأُمٍّ","هِيَ أَعطَتكَ رُتبَةَ الوُزَراءِ",28,"ا",2,1],["نِلناهُمُ قَبلَ الشُروقِ بِأَذرُعٍ","يَهزُرنَ في كَبِدِ الظَلامِ شُروقا",29,"ق",2,0],["نَلقى المَنونَ حَقائِقاً وَكَأَنَّنا","مِن غِرَّةٍ نَلقى بِهِنَّ شُكوكا",30,"ك",2,0],["نِلنا الهُدى بَعدَ العَمى","بِكَ وَالغِنى بَعدَ العَدَم",31,"م",1,0],["نُلحى عَلى الوَجدِ مِن ظُلمٍ فَدَيدَنُنا","وَجدٌ نُعانيهِ أَو لاحٍ يُعَنّينا",32,"ن",2,0],["نُليحُ مِنَ الغَرامِ إِذا اِعتَرانا","وَأَبرَحُ مِنهُ أَلّا يَعتَرينا",33,"ن",2,0],["نِلتَه إذ غدَت رماحُك سُوراً","حولَ سُورٍ له أبَى أن يُنالا",34,"ل",2,0],["نَلْ من الأيَّامِ ثارا","وانتَصِرْ منها انتِصارا",35,"ر",2,1],["نَل كُلَّ ما شِئتَ وَعِش آمِناً","آخِرُ هَذا كُلِّهِ المَوتُ",36,"ت",1,0],["نَل ما بَدا لَكَ أَن تَنالَ مِنَ الغِنى","إِن أَنتَ لَم تَقنَع فَأَنتَ فَقيرُ",37,"ر",1,0],["نَل ما بَدا لَكَ أَن تَنالَ مِنَ ال","دُنيا فَإِنَّ المَوتَ آخِرُهُ",38,"ر",2,0],["نَل أَيَّ شَيءٍ شِئتَ مِن نَوعِ المُنى","فَكَأَنَّ شَيئاً لَم تَنَلهُ إِذا اِنقَضى",39,"ض",2,0],["نُلَبّي مُنادي الإِصطِباحِ إِذا دَعا","وَنَدعو سَميعَ الإِغتِباقِ إِذا لَبّى",40,"ب",2,0],["نِلتُ مِن وُدِّكَ الجَميلِ اِنتِصافي","حَيثُ مِن سائِرِ القَذى أَنتَ صافي",41,"ي",1,1],["نَلقَ مَهَاة عيشك من مَهَاةٍ","وزينتها القلادةُ والسّوارُ",42,"ر",1,0],["نِلْتُ المُنَى بابنِ عبّادٍ فَقَيّدَني","عَنِ البدورِ الَّتي لي فيك بالبِدَرِ",43,"ر",1,0],["نَلِ الثُرَيّا أَوِ الشِعرى فَلَيسَ فَتىً","لَم يُغنِ خَمسينَ إِنساناً بِإِنسانِ",44,"ن",1,0],["نَلْهُو وَنَلْعَبُ بَيْنَ خُضْرِ حَدَائِقٍ","لَيْسَتْ بِغَيْرِ خُيُولِنَا تُسْتَامُ",45,"م",1,0],["نَلهو وَنَلعَبُ جاهِلينَ وَإِنَّني","لَأَرى حَياةَ الجاهِلينَ مُحالا",46,"ل",2,0],["نَلهو وَنَلعَبُ وَالأَرزاءُ مُحدِقَةٌ","بِنا وَحادي الرَدى في إِثرِنا عَجِلُ",47,"ل",1,0],["نَلقى جَبابِرَةَ الخُطوبِ أَعِزَّةً","وَنَهُمُّ بِالنُوَبِ العِظامِ عِظاما",48,"م",2,0],["نَلومُكَ يا يَومَ النُحوسِ وَنَعذِلُ","وَأَنتَ عَلى ما أَنتَ تَمضِي وَتُقبِلُ",49,"ل",1,1],["نلقي أحاجيَ بيننا فتثيرنا","للضّحكِ خاطئةٌ وذاتُ صواب",50,"ب",1,0],["نَلبَثُ حَولاً كامِلاً كُلَّهُ","لا نَلتَقي إِلّا عَلى مَنهَجِ",51,"ج",1,0],["نِلْتَ ما نِلْتَ لا بعقْلٍ رصينٍ","في المساعي ولا برأيٍ حصيف",52,"ف",1,0],["نِلتُ يَحيى وَأُمَّهُ وَأَباهُ","وَأَخاهُ وَأُختَهُ بِرَغيفِ",53,"ف",1,0],["نِلتُ لَذيذَ الحَرامِ مِنهُ","وَنالَهُ الناسُ بِالأَماني",54,"ي",1,0],["نَلهو إِلى نَورِ الخُزامى الثَعدِ","في زاهِرٍ مِن سَبِطٍ وَجَعدِ",55,"د",1,0],["نَلهو إِلَيهِ وَنَشكو بَثَّ أَنفُسِنا","في سَلوَةٍ وَزَوالُ اللَيلِ قَد أَفِدا",56,"د",2,0],["نَل يَسيراً مِنّي وَلا تَسبَعَنّي","في نَوالي فَإِنَّ ظمَئِيَ سِبعُ",57,"ع",1,0],["نلت وما نلت من مضرّة وهسو","ذان ما نال رأيه الفاسد",58,"د",1,0],["نلقي الخمائلَ بالخمائلِ حولنا","متعانقاتٍ سابغاتِ الفوفِ",59,"ف",1,0],["نُلقَّاهُ عن مَلكاتِ الزَّمانِ","أقاصيصَ لم يروِ عنها كتابْ",60,"ب",1,0],["نَلومُ على تَبلّدِها قُلوباً","تُكابِدُ من مَعيشَتِها جِهادا",61,"د",2,0],["نِلتَ الَّذي لَم يَنَلهُ بِالقَنا أَحَدٌ","فَاِهتِف لِأَنوَرِها وَاِحمِد نَيازيها",62,"ي",3,0],["نَلِينُ وإِنْ كُنَّا أَشِدَّاءَ لِلْهَوَى","وَنَغْضَبُ في شَرْوَى نَقِيرٍ فَنَشْتَدُّ",63,"د",1,0],["نَلْهُو بِهَا حِقْبَةً وَنَتْرُكُهَا","إِلى مَهَاوٍ فِي الأَرْضِ مُنْحَدِرَهْ",64,"ر",2,0],["نَلْتَقِي تَارَةً وَنَشْرُدُ أُخْرَى","كُلُّ تِرْبٍ فِي مَخْبَإٍ مُتَدَارِي",65,"ر",2,0],["نَلْقَى الصَّدِيقَ ابْنَ الأَصَادِقِ","وَالكَبِيرَ ابْنَ الأَكَابِرْ",66,"ر",1,0],["نَلْقَى العَدُوَّ بفَخْمَةٍ مَلْمُومَةٍ","تَنْفِي الجموعَ كَقَصْدِ رَأْسِ المَشْرِقِ",67,"ق",1,0],["نلقي على راحتيها أنفساً نهكت","فعل الغريق رأى في القرب مرساتا",68,"ت",2,0],["نلتَ ما لم تنلهُ -يا نيلُ- منا","ضاربات الأُسود والذُّؤبان",69,"ن",1,0],["نلهو ونامل امالا نسر بها","شريعة الموت تطوينا وتطويها",70,"ي",3,0],["نلوذ به من صَوْلة الظلم كالذي","يفرِ من الرَّمضاءِ بالنار يحتمي",71,"م",2,0],["نلقى أبا العباس بدراً طالعاً","وشقيقَه هارون نَجماً ناجما",72,"م",2,0],["نِلتُم مَراتبهم لا نَلتم رُشداً","بِلا نَدى وَذَكَرتُم مِثلَما ذَكَروا",73,"ر",3,0],["نلوذ بعد الله في ظله","وهو المغيث المسعف المنجد",74,"د",1,0],["نلتمس النور كل ملتمس","هيهات والحظ جد