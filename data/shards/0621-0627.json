{"poems":[[57,"ءأظن وما جربت مثلك أنما","https://www.aldiwan.net/poem26300.html","الطويل"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[54,"ءأمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem27014.html","الوافر"],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122715","الطويل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124056","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85272","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90921","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136640",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136577",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136630",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136535",""],[5829,"تطريز الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=210922",""]],"verses":[["ءأَظُنُّ وَما جَرَّبتُ مِثلَكِ أَنَّما","قُلوبُ نِساءِ العالَمينَ صُخورُ",0,"ر",1,1],["ءِ الكونِ بَيْنَ غياهبٍ وسدامِ","وأرى الفِجاجَ الدَّامِساتِ خلالَهُ",1,"ه",1,0],["ءأَميرَ المُؤمِنينَ فَدَتكَ نَفسي","لَقيتَ سَلامَةً وَرَبِحتَ أَجرا",2,"ر",2,1],["ءألا إنما تَبغي العُلى والمكارمُ","من الله أن يَبْقى لهنَّ \" مُزاحمُ \"",3,"م",1,1],["ءآمِرَة المشتاقِ بالصَّبرِ إنَّهُ","تَحَمَّلَ عَنهُ الصَّبر يَومَ تَحمَّلوا",4,"ل",3,0],["ءالى الزمان ألية مبرورة","أن لا يكون من الورى لك ثان",5,"ن",1,0],["ءاسلو وقلبي للغرام عزيم","وجسمي كطرف الغانيات سقيم",6,"م",1,1],["ءابا المنيرين الذين سناهما","من شمس سعدك نور كوكبه بدا",7,"د",2,0],["ءارضى وقد حَملتني الوجد والأسى","وتَغضبُ مهما قلت إنيّ عاني",8,"ن",2,0],["ءأخضعُ بعد العزِّ والانف راغمٌ","ومن نَكد الايام أني أخضَع",9,"ع",1,0],["ءأقتل ظلماً بسيف النَوى","وأحرم حتى لَذيذ المنام",10,"م",1,0],["ءآخي ولا وعدُ الوصال بصادقٍ","ولا ذمتي تُرعى ولا يحُفظ العهد",11,"د",1,0],["ء _ إن الذي بعث الكتاب مشرعا","يكفيكهم نصرا وأنت مكينُ",12,"ن",1,0]]}