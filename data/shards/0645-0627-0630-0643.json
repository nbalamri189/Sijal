{"poems":[[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[71,"ما ذكروا المصطفى بسوء","https://www.aldiwan.net/poem28012.html","مخلع البسيط"],[107,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[107,"يوم بدر وأنت أعلى مقاما","https://www.aldiwan.net/poem44220.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85833","الرمل"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[396,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[463,"يا صاحبي عرجا بي ساعة","https://www.aldiwan.net/poem55815.html","الرجز"],[505,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87271","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136145","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28538","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67220","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67217","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67234","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112661","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83481","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83530","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83499","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83395","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83588","الخفيف"],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22586","المنسرح"],[4799,"أمينة","https://www.poetsgate.com/ViewPoem.aspx?id=12259",""],[4869,"برد المسا","https://www.poetsgate.com/ViewPoem.aspx?id=138047",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5170,"صوت المطر","https://www.poetsgate.com/ViewPoem.aspx?id=176835",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5455,"صمت المكان","https://www.poetsgate.com/ViewPoem.aspx?id=34700",""],[6056,"نفحة نسانيس","https://www.poetsgate.com/ViewPoem.aspx?id=130322",""]],"verses":[["مَا ذِكْرُ أَيَّامِ الشَّبَابِ وَقَدْ مَضَى","أَوْ مَا الْغِنَى عِنْدَ الْفَقِيرِ الْمُعْدِمِ",0,"م",1,0],["ما ذكروا المصطفى بسوءٍ","إلا وسيقَ البلا إليهمْ",1,"م",1,1],["ما ذَكَرنا لَكُم مِنَ الخَيرِ شَيئاً","ما رَضينا لَكُم عَلى الدَهرِ حالا",2,"ل",2,0],["ما ذكرنا بِكَ القَواضبَ يَقْظَى","أنتَ أيقظتَها شُعوباً نِياما",3,"م",2,0],["ما ذكرت ذا إلا","تذكرت جحيما",4,"م",2,1],["ما ذَكَرتُ الأَوطانَ مُذ ظَلَّ طَرفي","راتِعاً في جَلالِ هَذي الخِلالِ",5,"ل",1,0],["ماذكر موته وقبره ماتزود لمعاده","ماحمد ربه تعالى من حمد مولاه زاده",6,"د",2,0],["ما ذكرتْ نفسِيَ أيّامَ الحمى","إلا وتجفو مقلتي كراها",7,"ا",3,0],["ما ذَكَرْناكَ إي وحَقِّكَ إِلاَّ","وسَحابُ الدُّموعِ كالسَّيلِ سالا",8,"ل",2,0],["ما ذكرنا في الدعاءِ","مع صفوف في الحذاءِ",9,"ا",2,0],["ما ذكرتُ الحسينَ بالطفِّ إِلاَّ","جاشَ صدري بما ذكرتُ وجاشا",10,"ش",2,0],["ما ذكرت الحما وأهليه الا","كان للقلب للحبيب انزعاج",11,"ج",1,0],["ما ذكر الرَّوضُ وَقَد تَنَفَّسا","غَير حديثِ الرَّكبِ حينَ عَرَّسا",12,"س",2,1],["ما ذكرناكِ يا منى النفس إلاّ","كان ذكراكِ خمرنا فسكرنا",13,"ن",2,0],["ما ذكرت الوصل إلاّ","صدَّ عني وأبى",14,"ب",2,0],["ما ذكرناك يا منى النفس إلاّ","وسكرنا فكانَ ذكركَ خَمرا",15,"ر",2,0],["ما ذكَروا مَصرَعَ تلكَ العِترَه","في الطف إلّا خنَقتهُ العَبَره",16,"ه",1,0],["ما ذكاء عند الشروق اذا لا","ح لراء في حلة حمراء",17,"ا",2,0],["ما ذكرنا الفسطاطَ إلا نسينا","ما رأَينا بالنيربينِ والأرْزَهْ",18,"ر",3,0],["ما ذكرتُ الحِمى بوجدٍ عَجيبٍ","وَفُؤادي الشَجِيُّ كلّهُ وجدُ",19,"د",1,0],["ما ذكرت الحَبيبَ روحَ البَرايا","في هِيامٍ إِلّا غَدا نَصبَ عَيني",20,"ن",2,1],["ما ذكرت النَخيلَ تهتزُّ إِلّا","هَزّني الشَوقُ لِلنَخيلِ بطَيبَه",21,"ب",2,1],["ما ذكَرت القَضاءَ يَشفَعه اللط","فُ وَأنّي قضَيتُ لَولاهُ نَحبي",22,"ب",2,0],["ما ذَكَرتُ الحَبيبَ أَو دارَ ذكرٌ","لِحَبيبي إِلّا وَوَجديَ وَجدُ",23,"د",1,0],["ما ذَكَّرَكَ الدِمنَةَ القِفارَ وَأَه","لَ الدارِ ما نَأوا عَنكَ أَو قَرَّبوا",24,"ب",3,1],["ماذكر بلفور للناس بقراره","كيف تشريد الأمم حاجه مهينه",25,"ن",2,0],["مآذكرت البُعد عن سيد الملآح","وعن لقآنآ ما اذكر بعمره نسآ",26,"س",2,0],["ما ذكر الذاكرون ما ذكروا","أشرف من لا إله إلا الله",27,"ل",2,0],["ماذكرك صوت المطر بايام عشناها سوا!؟","يوم الرحيل اثقل على صدري من اجبال السراه",28,"ا",2,1],["ماذكرت الطلول إلا أثارت","حادث الدمع والغرام القديما",29,"م",2,0],["ما ذكَرْتُ العِراقَ مُرْتَجِلاً","الاّ وبِتُّ عليهِ أرْتَجِفُ",30,"ف",1,0],["ماذكرت الا عيوب .. ولاتركت الا مزايا","سوّد الله وجه حظي .. والليالي .. والزمان",31,"ن",1,0],["ماذكرحسنه في الكتب والقواميس","ولا ، مع اهل البادية ، والمدينة",32,"ن",2,0]]}