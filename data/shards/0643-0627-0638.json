{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[422,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62943","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136480",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72411","المنسرح"]],"verses":[["كَاظِمِينَ الغيْظَ خَافِينَ إِلى","أَنْ يَلُوْا فِي وَجْهِهِ العُدْوَان جَهْرَا",0,"ر",2,0],["كاظم الغيظ سالم الصدر عافٍ","وما هوى قطّ صدره الأحقادا",1,"د",2,0],["كاظِمُ الغيظِ جَدُّهُ قد جلاهُ","بدرَ أُنسٍ مذْ لاحَ بالأبْواءِ",2,"ا",2,0],["كاظم الغَيظ منبع الفيض أَمسى","لطفه يَملأ العَوالم قدسا",3,"س",2,0],["كاظمٌ يملِكُ الزفيرَ فيخفي","هِ وواشٍ بدمعِهِ مَخنُوقُ",4,"ق",1,0],["كاظماً غيظه يريد رضا الله","فيلقى الردى بصبرٍ جميل",5,"ل",1,0],["كاظم غيظ له الرضا ولد","يقتل بالحلم حية الغضب",6,"ب",1,0]]}