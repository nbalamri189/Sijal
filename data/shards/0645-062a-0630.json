{"poems":[[88,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[51,"إن القريرة عينه عبد","https://www.aldiwan.net/poem62045.html","الكامل"],[113,"أدر المدامة يا نديمي","https://www.aldiwan.net/poem16378.html","مجزوء الكامل"],[199,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[445,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[447,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[572,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82799","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96988","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63979","الكامل"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115248","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123036","الكامل"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200278","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204582","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79719","الكامل"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140158",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66508","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125919","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127234","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127179","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[5246,"زرت المنازل بعد بين أنيسها","https://www.poetsgate.com/ViewPoem.aspx?id=187060",""],[5431,"هو في النهاية واقعٌ لايملصُ","https://www.poetsgate.com/ViewPoem.aspx?id=198801",""],[5732,"الله من هم بالأعماق مخفيه","https://www.poetsgate.com/ViewPoem.aspx?id=177821",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5956,"إخلاصُك المعروفُ عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194138",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[6320,"شَجْوِي الحَزِين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84348&r=&rc=45",""]],"verses":[["مُتَذَكِّراً يَومَ الإِمامِ بِهِ","يَومَ اِنتَوَيتُ بِذَلِكَ البَطَلِ",0,"ل",1,0],["مُتَذَكِّراً زَمَن الصِبى","زَمَن الغِوايَة وَالغُرورِ",1,"ر",1,0],["مُتَذاكِرانِ عَلى البِعادِ فَما يَنى","يُهدي الغَرامَ مُغَرِّبٌ لِمُشَرِّقِ",2,"ق",1,0],["مُتَذَلِّلٌ لِلَّهِ مُرتَقِبٌ","ما لَيسَ مِن إِتيانِهِ بُدُّ",3,"د",1,0],["مُتَذَكِراً عَهد الدُمى","مُتَناسِياً ذكر الرُسوم",4,"م",1,0],["مُتَذَيِّلٍ لَدنِ المَفاصِلِ فَوقَهُ","عَجَبٌ أَصَمُّ يَسُدُّ خَورَ صَلاها",5,"ا",3,0],["متذّئبونَ ولو ثغَت","شاةٌ للاذوا بالفِرارِ",6,"ر",1,0],["متذلِّلين مقصّرين لذنبهم","يا من يذلّ لعزِّهِ المستكبر",7,"ر",1,0],["متذلِّلٌ لَكَ عزُّ كلِّ مُمَنَّعٍ","متسهِّلٌ لَكَ صعبُ كلِّ مَرَامِ",8,"م",1,0],["متذكر الحُسنى ولو من مفسد","بالمن حُسناه وغير مقابح",9,"ح",1,0],["مُتَذَلِّلٌ سَهْلٌ لِخِلِّ صَدِيْقِهِ","وَعَلَى عَدُوِّ صَدِيْقِهِ سَلْطُ",10,"ط",1,0],["مُتَذَكِراً فيهِ وَكَم مِن عِبرة","لِمَن اِبتَغى فيهِ وَمِن تَذكير",11,"ر",1,0],["متذكراً آباءه الغر الألى","فيهم نجاة الخائف المترقب",12,"ب",1,0],["متذكراً سور المفاخر والعلى","مسطورة في هذه الصفحات",13,"ت",1,0],["متذلِّلٌ سَهْلٌ خلائقُهُ","وعلى عدوِّ صديقِه سَلْط",14,"ط",1,0],["متذكر في دار شقوته","دار النعيم ومنزل الطرب",15,"ب",1,0],["مُتذلّلاً في بابه","مستوهباً ما منك كان",16,"ن",1,0],["متذللا فلعل ساكن ربعها","ينعم لنا فيها بحظ أوفرا",17,"ر",2,0],["متذلل لم يدر علة ذلة","أو سرّ وطأة بؤسه المتجمع",18,"ع",1,0],["متذكراً ما مر من عهد الصبا","في ساعة الأهوال والبأساء",19,"ا",2,0],["متذكرا لقميص يوسف إذ أتى","لأبيه يعقوب يريح شفاء",20,"ا",2,0],["متذكراً ليلات وصلٍ قد مضت","أغنى سناك بها عن النبراس",21,"س",1,0],["متذكراً لغة يحر","ك شجوه منها النغم",22,"م",1,0],["متذكرا عصرا مضى","بالطف ما خلت انصرامه",23,"م",2,0],["متذكرا عصرا مضى","معكم بهاتيك الغرف",24,"ف",1,0],["متذكراً رمس القبور وهولها","متأهباً للعرض والميزان",25,"ن",1,0],["متذكرا عهدا خلا وكأنه","طيف الخيال أصارني مذهولا",26,"ل",2,0],["متذبذبٌ بريائه متخصصُ","مثل الذباب على الصفاقة يرقصُ",27,"ص",1,1],["متذكر غال على البعد ناحيه","لو حال من دونه ديار بعادي",28,"د",2,0],["متذكرٍ في مرقدي وش جرالي","وصفقت بالكفين ياس على ياس",29,"س",1,0],["متذكرٌ أنا مقلتيك وفيهما","أنقى إخاء للسماءِ تصاعدا",30,"د",2,0],["متذيل لون المناضل فوقه","عجب أصم يسل خور صلاها",31,"ا",3,0],["مُتَذَبْذِباً مِنْ بَعْدِ إِعْصَارٍ عَتَا","وَاقْتَادَنِي التَّبْكِيتُ لِلشَّجْوِ الحَزِينْ",32,"ن",1,0]]}