{"poems":[[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[49,"إن القريرة عينه عبد","https://www.aldiwan.net/poem62045.html","الكامل"],[110,"أدر المدامة يا نديمي","https://www.aldiwan.net/poem16378.html","مجزوء الكامل"],[196,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[198,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[417,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[440,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[442,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[568,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"]],"verses":[["مُتَذَكِّراً يَومَ الإِمامِ بِهِ","يَومَ اِنتَوَيتُ بِذَلِكَ البَطَلِ",0,"ل",1,0],["مُتَذَكِّراً زَمَن الصِبى","زَمَن الغِوايَة وَالغُرورِ",1,"ر",1,0],["مُتَذاكِرانِ عَلى البِعادِ فَما يَنى","يُهدي الغَرامَ مُغَرِّبٌ لِمُشَرِّقِ",2,"ق",1,0],["مُتَذَلِّلٌ لِلَّهِ مُرتَقِبٌ","ما لَيسَ مِن إِتيانِهِ بُدُّ",3,"د",1,0],["مُتَذَكِراً عَهد الدُمى","مُتَناسِياً ذكر الرُسوم",4,"م",1,0],["مُتَذَيِّلٍ لَدنِ المَفاصِلِ فَوقَهُ","عَجَبٌ أَصَمُّ يَسُدُّ خَورَ صَلاها",5,"ا",3,0],["متذّئبونَ ولو ثغَت","شاةٌ للاذوا بالفِرارِ",6,"ر",1,0],["متذلِّلين مقصّرين لذنبهم","يا من يذلّ لعزِّهِ المستكبر",7,"ر",1,0],["متذلِّلٌ لَكَ عزُّ كلِّ مُمَنَّعٍ","متسهِّلٌ لَكَ صعبُ كلِّ مَرَامِ",8,"م",1,0],["متذكر الحُسنى ولو من مفسد","بالمن حُسناه وغير مقابح",9,"ح",1,0],["مُتَذَلِّلٌ سَهْلٌ لِخِلِّ صَدِيْقِهِ","وَعَلَى عَدُوِّ صَدِيْقِهِ سَلْطُ",10,"ط",1,0]]}