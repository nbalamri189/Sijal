{"poems":[[95,"أحننت من شوق إلى لبنان","https://www.aldiwan.net/poem11270.html","الكامل"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[240,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28588","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28608","الكامل"],[3880,"","https://poetry.dctabudhabi.ae/diwan/poem/104203","الطويل"]],"verses":[["أَمَّا ظِلالُكَ فَهْيَ أَشْبَاحٌ لِمَا","فِي أَنْفُسِ النَّائِينَ مِنْ أَشْجَانِ",0,"ن",1,0],["أمَّا ظِهارتُه فسلطانيَّةٌ","وله بطانةُ مُخْبِتٍ أوَّاه",1,"ه",1,0],["أَما ظَمِئَت فَتَستَسقي بَناني","رِقاقُ البيضِ وَالأَسَلُ الحِرارُ",2,"ر",1,0],["أَمّا ظُباكَ فَقَد دانَت لَها الأُمَمُ","فَما تُخالِفُها عُرب وَلا عَجَمُ",3,"م",1,1],["أَمّا ظُباكَ فَقَد وَفَت بِضَمانِها","فَمَتى تَجودُ بِها عَلى أَجفانِها",4,"ن",3,1],["أما ظهر هذا الأرض أضحى معارضا","بنظمك أفلاكا تبطن بالزهر",5,"ر",1,0]]}