{"poems":[[53,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[53,"ونمى إلي من العجائب أنه","https://www.aldiwan.net/poem29657.html","الكامل"],[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[53,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[93,"لي مليك أحبه","https://www.aldiwan.net/poem11206.html","مجزوء الخفيف"],[93,"لمصر الجديدة عيد سعيد","https://www.aldiwan.net/poem11327.html","المتقارب"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[72,"في الريق سكر وفي الأصداغ تجعيد","https://www.aldiwan.net/poem18560.html","البسيط"],[72,"يا لهف قلبي على لقا رشاء","https://www.aldiwan.net/poem18679.html","المنسرح"],[72,"غصن بأوراق الغلائل يخطر","https://www.aldiwan.net/poem18772.html","الكامل"],[72,"رشقتني من اللحاظ بغمزه","https://www.aldiwan.net/poem19000.html","الخفيف"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"دعني وإيا أبي علي الأعور المعور الخبيث","https://www.aldiwan.net/poem9215.html","مخلع البسيط"],[51,"ضرطة إبراهيم في البربخ","https://www.aldiwan.net/poem9990.html","السريع"],[51,"إن كنت تعطيني عطاءك","https://www.aldiwan.net/poem11445.html","مجزوء الكامل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[91,"أحب إله في صباه إلاهة","https://www.aldiwan.net/poem8744.html","عموديه"],[70,"لي منزل إن زرته","https://www.aldiwan.net/poem42725.html","مجزوء الرجز"],[70,"أيها المولى الأجل","https://www.aldiwan.net/poem42742.html","مجزوء الرمل"],[70,"وجليس ليس فيه","https://www.aldiwan.net/poem42856.html","مجزوء الرمل"],[43,"لي منصب العرب البيض المصاليت","https://www.aldiwan.net/poem10620.html","البسيط"],[45,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[45,"ما لها أولعت بقطع الوداد","https://www.aldiwan.net/poem63473.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[61,"لي من عبيد الله خل ما أرى","https://www.aldiwan.net/poem51467.html","الكامل"],[61,"لي منزل كوجار الضب أنزله","https://www.aldiwan.net/poem51506.html","البسيط"],[61,"ألبرق سرى بأعلى البراق","https://www.aldiwan.net/poem51520.html","الخفيف"],[61,"آثار جودك في الخطوب تؤثر","https://www.aldiwan.net/poem51613.html","الطويل"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[44,"قد صحا القلب بعدما","https://www.aldiwan.net/poem30030.html","مجزوء الخفيف"],[44,"ملك جار إذ ملك","https://www.aldiwan.net/poem30142.html","مجزوء الخفيف"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[69,"ووعدت أمس بأن تزور فلم تزر","https://www.aldiwan.net/poem28244.html","الكامل"],[69,"لي مجموع صغير عند من","https://www.aldiwan.net/poem28702.html","الرمل"],[69,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[105,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[105,"ممالك الشرق ما في الحق من باس","https://www.aldiwan.net/poem42109.html","البسيط"],[52,"قمر فوق قضيب","https://www.aldiwan.net/poem26589.html","مجزوء الرمل"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[75,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85509","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16653","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43713","السريع"],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[45,"رَحَلَتْ ، وأَوْدَعَتِ الفُؤَادَ لَوَاحِظاً","https://www.poetsgate.com/ViewPoem.aspx?id=31700",""]],"verses":[["لي مَهجَةٌ لا أَرى لَها عِوَضاً","غَيرَ بُلوغِ العُلى وَلا ثَمَنا",0,"ن",2,0],["لي مِثلُ مُلكِكَ لَو أَطَعتُ تَقَنُّعي","وَذوو العَمائِمِ مِن ذَوي التيجانِ",1,"ن",1,0],["لي مَواعيدُ وَوَعدُ ال","غَيبِ عَقدٌ وَزِمامُ",2,"م",1,0],["لي مِنَ الدَهرِ ما يُشَ","يِّعُني في البَوائِقِ",3,"ق",1,0],["لي مُقلَةٌ ما تَستَفيقُ جَوىً","تَدمى وَيَقرَعُ ماؤُها خَدّي",4,"ي",1,0],["لي مَوطِنٌ في رُبوعِ النيلِ أُعظِمُهُ","وَلي هُنا في حِماكُم مَوطِنٌ ثاني",5,"ي",1,0],["لي مِنكَ فَليَذُبِ الحَسودُ تَلَظِّياً","لُطفُ المَكانَةِ وَالمَحَلُّ الأَكرَمُ",6,"م",1,0],["لِي مَلِيكٌ أُحِبُّهُ","وَهْوَ بِالكَاشِحِ افْتَنَنْ",7,"ن",1,1],["لِيَمْنَحْكَ رَبُّكَ عُمْراً مَدِيداً","وَيُبْلِغْكَ كُلَّ نَجَاحٍ مَرُومِ",8,"م",1,0],["ليَمْكُث فيك مُغتبطَاً سعيداً","ويكسب عندك الشرف الجُساما",9,"م",2,0],["ليَ من أدمعِي ولفظيَ درٌّ","حسنَ الاتِّساق والازْدِوَاج",10,"ج",1,0],["لي من مبادئ عمرِي فيكَ فرط ولا","فمُ المصائب عن ذكراه مسدود",11,"د",1,0],["لي مقلة منه قد جننت بها","وهكذا حال من به سودا",12,"د",2,0],["لي من نداه عادةٌ قد أخرت","عني وتأخير الندى لا يؤثر",13,"ر",1,0],["ليَ من خدِّها ومن مرشفيها","ولماها نُقلٌ وراحٌ ومنزه",14,"ز",2,0],["لي من نصيب هواك سهمٌ وافرٌ","وسهام سحر من جفونك ترشق",15,"ق",1,0],["لي مكانَ الحمارِ عند الفتى الما","جِد بَغْلٌ أوْ بغلةٌ سُرْحُوبُ",16,"ب",1,0],["لَيُمْطَرنَّ العذابَ حتَّى","تراهُ في حال مُستغيثِ",17,"ث",1,0],["لي مَنْجَنِيقٌ كنتَ في مَعْزِلٍ","عنها وعن أحْجَارها الشُّدَّخِ",18,"خ",1,0],["لي من جبينك بدر سَعْ","دٍ طالع لن يُفقدا",19,"د",2,0],["لي مديحٌ قلتُهُ في سَيّدٍ","لم تزل تُهْدي له الشعرَ الوُفودُ",20,"د",1,0],["لِيَ مُذ لجَّ بي الصدودُ ليالٍ","ليس نومي فيهنَّ غير غِشاش",21,"ش",1,0],["ليمَ في أختِه فقال مجيباً","تِلك نعلٌ وحقُّها التشريك",22,"ك",1,0],["ليَ منكم مواليَ اللَّه مولىً","مثلُهُ إن حكاه مثلٌ يُوالى",23,"ل",2,0],["ليُمطرني مطرةً لا يزا","ل عُودي منها وريقاً ظليلا",24,"ل",2,0],["لي مُذْ نأَوْا وجنةٌ ريَّا بِمشْربِها","من عَبْرتي وفمٌ ما عِشْتُ ظَمآن",25,"ن",1,0],["ليَ مُدْنٍ منكُمُ مجتهدٌ","وصَل اللَّه بخيرٍ قَرنه",26,"ن",2,0],["لِيُمسي عَلى الأَربابِ أَجمَعَ سَيِّداً","وَتُمسي تُباهي كُلَّ ذاتِ ذَوائِبِ",27,"ب",1,0],["لي مَنزِلٌ إِن زُرتَهُ","لَم تَلقَ إِلّا كَرَمَك",28,"ك",1,1],["لِيَ مِن كُلِّ حَبيبٍ","رُمتُ مِنهُ الوَصلَ مَطلُ",29,"ل",1,0],["لِيَ مِنهُ أَينَما كُن","تُ عَلى رُغمي حَبسُ",30,"س",1,0],["لي منصبُ العَرَبِ البيضِ المصاليتِ","ومنطِقٌ صيغَ من دُرٍّ وياقوتِ",31,"ت",1,1],["لي ما عَلِمتَ مِنَ اِتِّصالِ مَوَدَّةٍ","وَمُقَدِّماتِ رَسائِلٍ وَقَصائِدِ",32,"د",1,0],["لي مِنَ الشِعرِ نَخوَةٌ وَاِعتِزازٌ","وَهُجومٌ عَلى الأُمورِ الشِدادِ",33,"د",1,0],["لي مُعينانِ هِمَّةٌ وَاِعتِزازمٌ","تِلكَ مِن طارِفي وَذا مِن تِلادي",33,"ي",1,0],["لي مِنَ الدَهرِ كُلَّ يَومٍ عَناءٌ","فُرقَتي مَعشَري وَقِلَّةُ زادي",33,"ي",1,0],["لِيَ مِنهُ في كُلِّ يَومٍ نَوالٌ","لَم تَنَلهُ كُدورَةُ التَرنيقِ",34,"ق",1,0],["لي من عُبَيدِ اللهِ خُلٌّ ما أَرى","في جاهِه طَمَعاً ولا في مالِه",35,"ل",2,1],["لي منزلٌ كَوِجارِ الضَّبِّ أَنزِلُه","ضَنْكٌ تَقارَبَ قُطراهُ فقد ضاقَا",36,"ق",2,1],["لِيَ منه صَبابَةٌ في اتِّئادٍ","ليسَ تَنْأى وعَبْرَةٌ في استِباقِ",37,"ق",1,0],["لي من نَوالِكَ كلَّ شَهرٍ عادةٌ","مضَتِ الليالي دونَها والأشهرُ",38,"ر",1,0],["لي مِنهُمُ رَشَأٌ إِذا غازَلتُهُ","كادَت لَواحِظُهُ بِسِحرٍ تَنطِقُ",39,"ق",1,0],["لي مِنَ الصَبرِ حاكِمٌ","في الهَوى غَيرُ مُرتَشي",40,"ي",1,0],["لي مِنَ الحُزنِ مِثلُ ما","مِن بَديعِ الجَمالِ لَك",41,"ك",1,0],["لي مِن أَبي جَعفَرٍ آخِيَّةٌ سَبَبٌ","إِن تَبقَ يُطلَب إِلى مَعروفِيَ السَبَبُ",42,"ب",1,0],["ليَ مهجةٌ في النازعاتِ وعبرةٌ","في المرسلاتِ وفكرةٌ في هل أتى",43,"ت",2,0],["لي مجموعٌ صغيرٌ عندَ مَنْ","أنا كالغارقِ في نائلِهِ",44,"ه",1,1],["لي منطقٌ غيرُ مبذولٍ وأنتَ بهِ","أولى على أنَّ لي من بذله أَرَبا",45,"ب",2,0],["لي مجدُه العالي وَطِيبُ ظِلالهِ","وله بياني الصَّادقُ المأثورُ",46,"ر",1,0],["ليِ مِن يراعكَ في الصَّبابةِ مُسعِدٌ","فَامْزجْ مِدادَك في الهَوى بِمدادي",47,"ي",1,0],["ليِ مِن مُصابِكَ إن نَفْسُ امْرئٍ سكَنتْ","نَفسُ الجَريح وقلبُ الجازعِ الآسي",48,"س",2,0],["لِيَ مِن ذِكرِكَ مِرآ","ةٌ أَرى وَجهَكِ فيها",49,"ي",3,0],["لي مُهْجَةٌ تَرفَضُّ فيك تشَيُّعاً","حتى تكادَ مع المدائح تَهْمُل",50,"ل",1,0],["لي منْهُمُ سيْفٌ إذا جَرَّدْتُهُ","يوماً ضرَبْتُ به رِقابَ الأعصُر",51,"ر",1,0],["لِيَ مَولىً أَرتَجي مِن","هُ عَلى رَغمِكَ عِتقا",52,"ق",2,0],["لي من دموعي قصيد جئت أنظمها","وأجعل البث والأشجان عنوانا",53,"ن",2,1],["لي من تأخر كتبه عنا نعم","عجب إذا فكرت فيه عجاب",54,"ب",1,0],["لِيْمَتْ وليْلُ اللائِمِينَ تَعانُقٌ","حتى الصّباحِ وليْلُها الإِعْناق",55,"ق",1,0],["ليَمْنَحْكُمُ اللهُ العَزَاءَ وَخَيْرُهُ","تَعَهُّدكُمْ منْ مَجْدِهِ مَا تَعَهَّدَا",56,"د",2,0],["لي مَوعِدٌ فيكَ عَلى المُصطَفى","فَاِسأَلهُ لِلمَفجوعِ إِنجازَهُ",57,"ه",1,1],["لي من الأوراق أبهى حلل","ومن الزهر نفيسات الحلي",58,"ل",2,0],["لَيْمَياءُ تَبْسِمُ عَنْ شَتِيتٍ واضِحٍ","كالأَرْي يَرْوِي غُلَّةَ الصَّدْيانِ",59,"ن",1,0]]}