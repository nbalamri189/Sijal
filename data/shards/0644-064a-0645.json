et/poem33686.html","الخفيف"],[558,"لي من هوادي المطايا مذ هوت هادي","https://www.aldiwan.net/poem34619.html","المواليا"],[559,"سقيت كأس الهوى قديما","https://www.aldiwan.net/poem69371.html","مخلع البسيط"],[567,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[567,"لي من سر بني العباس","https://www.aldiwan.net/poem69631.html","مجزوء الكامل"],[567,"ما تغطي أكوار تلك البدور","https://www.aldiwan.net/poem69679.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[575,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[575,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[586,"لي من هواك بعيده وقريبه","https://www.aldiwan.net/poem17420.html","الكامل"],[586,"أرض الأحبة من سفح ومن كثب","https://www.aldiwan.net/poem17436.html","البسيط"],[586,"عشقت معاطف قده المياس","https://www.aldiwan.net/poem17561.html","الكامل"],[586,"لي من جمالك شاهد وكفيل","https://www.aldiwan.net/poem17651.html","الكامل"]],"verses":[["لي مَهجَةٌ لا أَرى لَها عِوَضاً","غَيرَ بُلوغِ العُلى وَلا ثَمَنا",0,"ن",2,0],["لي مِثلُ مُلكِكَ لَو أَطَعتُ تَقَنُّعي","وَذوو العَمائِمِ مِن ذَوي التيجانِ",1,"ن",1,0],["لي مَواعيدُ وَوَعدُ ال","غَيبِ عَقدٌ وَزِمامُ",2,"م",1,0],["لي مِنَ الدَهرِ ما يُشَ","يِّعُني في البَوائِقِ",3,"ق",1,0],["لي مُقلَةٌ ما تَستَفيقُ جَوىً","تَدمى وَيَقرَعُ ماؤُها خَدّي",4,"ي",1,0],["لي مَوطِنٌ في رُبوعِ النيلِ أُعظِمُهُ","وَلي هُنا في حِماكُم مَوطِنٌ ثاني",5,"ي",1,0],["لي مِنكَ فَليَذُبِ الحَسودُ تَلَظِّياً","لُطفُ المَكانَةِ وَالمَحَلُّ الأَكرَمُ",6,"م",1,0],["لِي مَلِيكٌ أُحِبُّهُ","وَهْوَ بِالكَاشِحِ افْتَنَنْ",7,"ن",1,1],["لِيَمْنَحْكَ رَبُّكَ عُمْراً مَدِيداً","وَيُبْلِغْكَ كُلَّ نَجَاحٍ مَرُومِ",8,"م",1,0],["ليَمْكُث فيك مُغتبطَاً سعيداً","ويكسب عندك الشرف الجُساما",9,"م",2,0],["ليَ من أدمعِي ولفظيَ درٌّ","حسنَ الاتِّساق والازْدِوَاج",10,"ج",1,0],["لي من مبادئ عمرِي فيكَ فرط ولا","فمُ المصائب عن ذكراه مسدود",11,"د",1,0],["لي مقلة منه قد جننت بها","وهكذا حال من به سودا",12,"د",2,0],["لي من نداه عادةٌ قد أخرت","عني وتأخير الندى لا يؤثر",13,"ر",1,0],["ليَ من خدِّها ومن مرشفيها","ولماها نُقلٌ وراحٌ ومنزه",14,"ز",2,0],["لي من نصيب هواك سهمٌ وافرٌ","وسهام سحر من جفونك ترشق",15,"ق",1,0],["لي مكانَ الحمارِ عند الفتى الما","جِد بَغْلٌ أوْ بغلةٌ سُرْحُوبُ",16,"ب",1,0],["لَيُمْطَرنَّ العذابَ حتَّى","تراهُ في حال مُستغيثِ",17,"ث",1,0],["لي مَنْجَنِيقٌ كنتَ في مَعْزِلٍ","عنها وعن أحْجَارها الشُّدَّخِ",18,"خ",1,0],["لي من جبينك بدر سَعْ","دٍ طالع لن يُفقدا",19,"د",2,0],["لي مديحٌ قلتُهُ في سَيّدٍ","لم تزل تُهْدي له الشعرَ الوُفودُ",20,"د",1,0],["لِيَ مُذ لجَّ بي الصدودُ ليالٍ","ليس نومي فيهنَّ غير غِشاش",21,"ش",1,0],["ليمَ في أختِه فقال مجيباً","تِلك نعلٌ وحقُّها التشريك",22,"ك",1,0],["ليَ منكم مواليَ اللَّه مولىً","مثلُهُ إن حكاه مثلٌ يُوالى",23,"ل",2,0],["ليُمطرني مطرةً لا يزا","ل عُودي منها وريقاً ظليلا",24,"ل",2,0],["لي مُذْ نأَوْا وجنةٌ ريَّا بِمشْربِها","من عَبْرتي وفمٌ ما عِشْتُ ظَمآن",25,"ن",1,0],["ليَ مُدْنٍ منكُمُ مجتهدٌ","وصَل اللَّه بخيرٍ قَرنه",26,"ن",2,0],["لِيُمسي عَلى الأَربابِ أَجمَعَ سَيِّداً","وَتُمسي تُباهي كُلَّ ذاتِ ذَوائِبِ",27,"ب",1,0],["لي مَنزِلٌ إِن زُرتَهُ","لَم تَلقَ إِلّا كَرَمَك",28,"ك",1,1],["لِيَ مِن كُلِّ حَبيبٍ","رُمتُ مِنهُ الوَصلَ مَطلُ",29,"ل",1,0],["لِيَ مِنهُ أَينَما كُن","تُ عَلى رُغمي حَبسُ",30,"س",1,0],["لي منصبُ العَرَبِ البيضِ المصاليتِ","ومنطِقٌ صيغَ من دُرٍّ وياقوتِ",31,"ت",1,1],["لي ما عَلِمتَ مِنَ اِتِّصالِ مَوَدَّةٍ","وَمُقَدِّماتِ رَسائِلٍ وَقَصائِدِ",32,"د",1,0],["لي مِنَ الشِعرِ نَخوَةٌ وَاِعتِزازٌ","وَهُجومٌ عَلى الأُمورِ الشِدادِ",33,"د",1,0],["لي مُعينانِ هِمَّةٌ وَاِعتِزازمٌ","تِلكَ مِن طارِفي وَذا مِن تِلادي",33,"ي",1,0],["لي مِنَ الدَهرِ كُلَّ يَومٍ عَناءٌ","فُرقَتي مَعشَري وَقِلَّةُ زادي",33,"ي",1,0],["لِيَ مِنهُ في كُلِّ يَومٍ نَوالٌ","لَم تَنَلهُ كُدورَةُ التَرنيقِ",34,"ق",1,0],["لي من عُبَيدِ اللهِ خُلٌّ ما أَرى","في جاهِه طَمَعاً ولا في مالِه",35,"ل",2,1],["لي منزلٌ كَوِجارِ الضَّبِّ أَنزِلُه","ضَنْكٌ تَقارَبَ قُطراهُ فقد ضاقَا",36,"ق",2,1],["لِيَ منه صَبابَةٌ في اتِّئادٍ","ليسَ تَنْأى وعَبْرَةٌ في استِباقِ",37,"ق",1,0],["لي من نَوالِكَ كلَّ شَهرٍ عادةٌ","مضَتِ الليالي دونَها والأشهرُ",38,"ر",1,0],["لي مِنهُمُ رَشَأٌ إِذا غازَلتُهُ","كادَت لَواحِظُهُ بِسِحرٍ تَنطِقُ",39,"ق",1,0],["لي مِنَ الصَبرِ حاكِمٌ","في الهَوى غَيرُ مُرتَشي",40,"ي",1,0],["لي مِنَ الحُزنِ مِثلُ ما","مِن بَديعِ الجَمالِ لَك",41,"ك",1,0],["لي مِن أَبي جَعفَرٍ آخِيَّةٌ سَبَبٌ","إِن تَبقَ يُطلَب إِلى مَعروفِيَ السَبَبُ",42,"ب",1,0],["ليَ مهجةٌ في النازعاتِ وعبرةٌ","في المرسلاتِ وفكرةٌ في هل أتى",43,"ت",2,0],["لي مجموعٌ صغيرٌ عندَ مَنْ","أنا كالغارقِ في نائلِهِ",44,"ه",1,1],["لي منطقٌ غيرُ مبذولٍ وأنتَ بهِ","أولى على أنَّ لي من بذله أَرَبا",45,"ب",2,0],["لي مجدُه العالي وَطِيبُ ظِلالهِ","وله بياني الصَّادقُ المأثورُ",46,"ر",1,0],["ليِ مِن يراعكَ في الصَّبابةِ مُسعِدٌ","فَامْزجْ مِدادَك في الهَوى بِمدادي",47,"ي",1,0],["ليِ مِن مُصابِكَ إن نَفْسُ امْرئٍ سكَنتْ","نَفسُ الجَريح وقلبُ الجازعِ الآسي",48,"س",2,0],["لِيَ مِن ذِكرِكَ مِرآ","ةٌ أَرى وَجهَكِ فيها",49,"ي",3,0],["لي مُهْجَةٌ تَرفَضُّ فيك تشَيُّعاً","حتى تكادَ مع المدائح تَهْمُل",50,"ل",1,0],["لي منْهُمُ سيْفٌ إذا جَرَّدْتُهُ","يوماً ضرَبْتُ به رِقابَ الأعصُر",51,"ر",1,0],["لِيَ مَولىً أَرتَجي مِن","هُ عَلى رَغمِكَ عِتقا",52,"ق",2,0],["لي من دموعي قصيد جئت أنظمها","وأجعل البث والأشجان عنوانا",53,"ن",2,1],["لي من تأخر كتبه عنا نعم","عجب إذا فكرت فيه عجاب",54,"ب",1,0],["لِيْمَتْ وليْلُ اللائِمِينَ تَعانُقٌ","حتى الصّباحِ وليْلُها الإِعْناق",55,"ق",1,0],["ليَمْنَحْكُمُ اللهُ العَزَاءَ وَخَيْرُهُ","تَعَهُّدكُمْ منْ مَجْدِهِ مَا تَعَهَّدَا",56,"د",2,0],["لي مَوعِدٌ فيكَ عَلى المُصطَفى","فَاِسأَلهُ لِلمَفجوعِ إِنجازَهُ",57,"ه",1,1],["لي من الأوراق أبهى حلل","ومن الزهر نفيسات الحلي",58,"ل",2,0],["لَيْمَياءُ تَبْسِمُ عَنْ شَتِيتٍ واضِحٍ","كالأَرْي يَرْوِي غُلَّةَ الصَّدْيانِ",59,"ن",1,0],["لي موطن في ربى لبنان ممتنع","ولي بنو العمّ من أبنائه النجب",60,"ب",1,1],["لِي مِن مَنيع حِماك أَمضى صَعدة","وَأَتَم سابغة وَخَير مُهَنَد",61,"د",1,0],["لي منكم الغوث الرفاعي الذي","خضعت لديه ايمة الحضرات",62,"ت",1,0],["لي من صدور كبارهم جدله","همم بها لاولي السقام شفاء",63,"ا",2,0],["لي مِنَ الذَّنْبِ ما عَلِمْتَ وإنّي","مُسْتَزِيدٌ ولاجِئٌ في رِحابِكْ",64,"ك",1,0],["لي من ملاحته وحيٌ يساعفني","إذا أعان على الأشعار شيطان",65,"ن",1,0],["ليَ ما شئتُ روضةٌ وغديرٌ","ومِراحٌ من ربعهِ المأنوس",66,"س",1,0],["لي من تَمَرُّضِ طَرْفِهِ وكَلامِهِ","سُكْران من خَمْرٍ ومن سِحْرِ",67,"ر",1,0],["لي منكمُ فوق مالي عند غيركم","مودة أدخلتني مدخل النسبِ",68,"ب",1,0],["لي منكم يا كهف الملوك والدول","أضعاف مالي في سواك من أمل",69,"ل",1,1],["ليَ مولىً لو طلبتَ له","مُشْبِهاً في الخَلْقِ لم تجد",70,"د",1,0],["لي مذهب في القنوع أكسبني","عزّ غناءٍ وضرّ ذي عجف",71,"ف",1,0],["لي من الناس أسوة في","أبي القاسم نصر ذي المنطق المطبوع",72,"ع",1,0],["لي من دموعي صهباءٌ أبلّ بها","غليل قلبي ودمعي المنهمي راح",73,"ح",1,0],["لي مهجةٌ تعشقُ الجمالَ وهلْ","يلامُ في حبِّ روحهِ الجسدُ",74,"د",1,0],["لي مهجة تبكي وطرف ساهر","وجوارح تضنَى وقلب مدنفُ",75,"ف",1,0],["لئمت مواطىء الاقدام الفا","والفا بعدها وازيد عدا",76,"د",2,0],["لي مُهجَةٌ كَدُموعِ الفَجرِ صافِيَة","نَقاوَتي وَالتُقى أُمٌّ لَها وَأَبُ",77,"ب",1,0],["لي مَوطِنٌ عاثَت بِهِ أَولادُهُ","فَبَكَت حُشاشَتُهُ عَلى أَولادِهِ",78,"د",2,0],["لي من الشمس خِدمَةٌ صفراء","لا أُبالي إذا أتاني الشَّتاءُ",79,"ا",2,1],["لي من الليل والنهار على الطو","لِ عزاءُ لا يَنقَضي وهَنَاءُ",79,"ا",2,0],["لي من جاهه وأخلاقه عن","د هجير الخطوب ظلٍّ وماءُ",79,"ا",2,0],["لي منكمُ وردَ الكتابُ وضمنه","نشرُ الّذي تطوى عليه سرائري",80,"ي",1,1],["لي منكِ في الأحزانِ تر","نيمٌ وريحانٌ وراح",81,"ح",1,0],["لي من مطامِعها بحرٌ يهدِّدُكم","بالرّيح والغيمِ والأمواجِ والزّبد",82,"د",1,0],["لي من ربا أطلال مكّة مرغبٌ","فعسى الإلهُ يجودُ لي بمرادي",83,"ي",1,0],["لي منك بل من بينك الغرواقية","بِاللَه تَغتال عَني كل مغتال",84,"ل",1,0],["لي مُذ خَلَت مِنكَ الدِيارُ فَلا خَلَت","بِدِمَشقَ شَوقٌ مُقعِدٌ وَمُقيمُ",85,"م",1,0],["لي ماءُ وَجهٍ صينَ عَن إِهراقِهِ","عِندَ المُلوكِ وَإِنَّهُ مَوفورُ",86,"ر",1,0],["لي مِن تَخَيُّلِ وَجهِهِ إِن غابَ عَن","عَين