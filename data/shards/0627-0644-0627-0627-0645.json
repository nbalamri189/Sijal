{"poems":[[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[82,"فعوضت شيبا من شبابي كأنني","https://www.aldiwan.net/poem31211.html","الطويل"],[71,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[107,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[376,"إن العيون على القلوب قواض","https://www.aldiwan.net/poem57342.html","الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123693","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27179","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77297","الوافر"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199884","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147323","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118898","الدوبيت"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97975","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127912","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3869,"","https://poetry.dctabudhabi.ae/diwan/poem/34843","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117211","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58140","الطويل"],[4727,"تجافى الشعرُ بعدك والقريضُ","https://www.poetsgate.com/ViewPoem.aspx?id=215162",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[4988,"خبري وليده ....","https://www.poetsgate.com/ViewPoem.aspx?id=154188",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5688,"رحيل العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200936",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[2220,"حسٌّ يفرقُ والأرواحُ تتحدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11285&r=&rc=159",""],[6299,"ألا أمُّ عَمْروٍ أجْمَعَتْ فکسْتَقَلَّتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19677&r=&rc=2",""]],"verses":[["أَلا أَمُّ عَمرو أَجمَعَت فَاِستَقَلَّتِ","وَما وَدَّعَت جيرانَها إِذ تَوَلَّتِ",0,"ت",1,1],["ألا آمنَ الرحمن خوفي بِعَفْوِهِ","فإنّيَ من نفسي أخاف على نفسي",1,"س",2,0],["إلا إمامُ الهدى قاضي القضاة وَمَنْ","أحيا العلومَ وأعلى رتبةَ الأدبِ",2,"ب",1,0],["أَلا أُمّةٌ تَنْهَى النُّفوسَ عنِ الهَوَى","وتُصْغِي إلى القَوْلِ الذي أنا قائِلُهْ",3,"ل",2,0],["إلا امرأً غَضِبَت له هِمَّاتُه","فرمَت به غَرضاً من الأغراضِ",4,"ض",1,0],["إلا امتداحك سيداً","قرّت به عين الفضائل الخ",5,"ل",2,0],["إِلّا أَمالَت وَنَمَّت في تَنَسُّمِها","بِما حَمَلنَ مِنَ الأَزهارِ وَالقُضُبِ",6,"ب",1,0],["أَلا أَمَلٌ يَجولُ بِنَفسِ حُرٍّ","لَهُ صَدرٌ جَحيم اليَأسِ صالِ",7,"ل",1,0],["ألا أمثل أمير المؤمنين بمسلم","وأفلق به الأحشاء من كل مجرم",8,"م",1,1],["إِلاَّ أَمَانِيَّ قَالَتْ حِينَ تَقتُلُنِي","وَيَبَّسَت نُطَفَ الآمَالِ عَن عَرقِي",9,"ق",2,0],["إلا أمسيت صانعاً لي فلكاً","كي لا أفنى بدمعي الطوفانِ",10,"ن",1,0],["إلا امرؤ في الحب أكدى رأيه","فعنا إلى عزى الجمال ولاته",11,"ت",2,0],["ألا أماجد ذبوا عن نبيهم","ألا حماة لعرض المصطفى صانوا",12,"ن",3,0],["إِلاَّ أميرَ الشرقِ قَدْ","رام الصوابَ فلم يُصِب",13,"ب",1,0],["الاَّ أَميرَ المؤمنينَ فانَّه","يلقاكَ باطنُ غيبهِ كالظَّاهِرِ",14,"ر",1,0],["إِلّا اِمتَطَيتُ الدُجى شَوقاً إِلَيكِ وَلَو","أَصبَحتُ في حَلَقِ الأَقيادِ مَصفودا",15,"د",2,0],["إلا امتداح الهاشمي وصحبه","فبذاك يجنى للسعود ثمارا",16,"ر",2,0],["ألا امنُنْ إلهي بالمتابِ وبالرضَى","لعلِّي أداوي بالمتابِ كِلاَمِي",17,"م",2,0],["ألا أَمسِكْٰ لسانك عن صعيدٍ","فإنَّ الطُّهْرَ يَنْسَخُه المَحِيضُ",18,"ض",1,0],["ألا أمرحْ على عيش ٍ فعمرك نافذ ٌ","كفى بك فخرا فيك أن ملّكَ الضرُ",19,"ر",1,0],["ألآآ من مبلغ آلأحباآاب .. عني","أنآ نفسي عقب صدك زهيده",20,"د",2,0],["ألا أمة المليار قد ضاع بأسها","فلا نخوة فيها تعاند باغيا",21,"ي",2,0],["إلّا امتلاه فذا ما كان عذّبني","وذا الذي أنا من بأسائه وجل",22,"ل",1,0],["ألا أمُّك الشمسُ تَرضَع منها","جميعَ قواك كما تامرُ",23,"ر",1,0],["إلا إمامٌ بعينِ الشرعِ أدركهُ","له الإصابة ُ نعمَ الركنُ والسند",24,"د",1,0],["ألا أمُّ عَمْروٍ أجْمَعَتْ فکسْتَقَلَّتِ","وَمَا وَدَّعَتْ جِيرَانَها إذْ تَوَلَّتِ",25,"ت",1,1]]}