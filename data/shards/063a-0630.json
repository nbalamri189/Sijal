{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[88,"وفي الألعاب لم تر قط عيني","https://www.aldiwan.net/poem44395.html","الوافر"],[72,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[62,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[61,"غذيت به طفلا وإن رمت تركه","https://www.aldiwan.net/poem51306.html","السريع"],[58,"أنا علي وابن عبد المطلب مهذب","https://www.aldiwan.net/poem31159.html","الرجز"],[21,"غذوتك مولودا وعلتك يافعا","https://www.aldiwan.net/poem36184.html","الكامل"],[22,"عرفت منازلا من آل هند","https://www.aldiwan.net/poem21670.html","الوافر"],[48,"دع الأطلال تسفيها الجنوب","https://www.aldiwan.net/poem10768.html","الوافر"],[46,"تعالي قدرة وخفوت جرس","https://www.aldiwan.net/poem22835.html","الوافر"],[46,"قد آذنتنا بأمر فادح أذن","https://www.aldiwan.net/poem23517.html","البسيط"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142015","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141918","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[36,"بعيدُ الثَّرَى لا يَبْلُغُ القَوْمُ قَعْرَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=15886",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[96,"الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=13197",""],[7,"أتارِكَة ٌ تدَلَلّهَا قَطامِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17593",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""]],"verses":[["غَذِيَّ زَماعٍ لا يَمَلُّ كَأَنَّما","يَرى اللَيلَ كَوراً وَالمَجَرَّةَ مِقوَدا",0,"د",2,0],["غَذَتْهُ رُبا نَجْدٍ فشَبَّ كأنّهُ","شَبا مَشْرَفيٍّ يَقيُرُ السُّمَّ مُنْقَعا",1,"ع",2,0],["غذاء النفوس وطب العقو","ل وحفظ الجسوم بها يطلب",2,"ب",1,0],["غذِيَ الرجاءَ نباتُها فانْظر لمن","وشَّاه من مدحٍ فمُ ابنِ نباتها",3,"ت",3,0],["غَذاهُ وَحَولِيُّ الثَرى فَوقَ مَتنِهِ","مَدَبُّ الأَتِيِّ وَالأَراكِ الدَوائِحُ",4,"ح",1,0],["غذتك بعد حَسَن المغبِة سائغٍ","وسقتك من جارى المياه بُراد",5,"د",1,0],["غَذَّينَها في مَهدِها","بِلِبانِهِنَّ الطاهِراتِ",6,"ت",1,0],["غَذا الهِندُوانِيّاتِ بِالهامِ وَالطُلى","فَهُنَّ مَداريها وَهُنَّ المَخانِقُ",7,"ق",1,0],["غذينها بالنار إلى أن","أدينا رماتها بفراقها",8,"ق",3,0],["غذيت به طفلا وإن رمت تركه","تأبى وأغرتني به ألفة المهد",9,"د",1,1],["غَذَيتُ في الحَربِ وَعِصيانَ النُّوَب","مِن بَيتِ عِزٍ لَيسَ فيهِ مُنشَعَب",10,"ب",1,0],["غَذوَتُكَ مولوداً وَعُلتُكَ يافِعاً","تُعَلُّ بِما أُحنيَ عَلَيكَ وَتَنهلُ",11,"ل",1,1],["غَذِيَّةُ بَينِ أَبوابٍ وَدورٍ","سَقاها بَردُ رائِحَةِ العَشِيِّ",12,"ي",1,0],["غَذَتهُ صَنعَةُ الداياتِ حَتّى","زَها فَزَها بِهِ دَلٌّ وَطيبُ",13,"ب",1,0],["غَذا العِرسانِ بِإِبنِهِما عَدوّاً","أَقَلُّ أَذيَّةً مِنهُ اِبنُ عِرسِ",14,"س",1,0],["غَذاكُمُ اللَهُ مِنّي ثُمَّ عَوَّضَني","مِمّا لَقيتُ فَبِالأَجسامِ غَذّاني",15,"ن",2,0],["غَذاهُنّ مُحْمَرَّ النّجيعِ قَوارِحاً","كما كُنّ يُغْذَيْنَ الضّريبَ مِهارا",16,"ر",2,0],["غذتها الضحايا بالجسوم فأخصت","وأترعها سيلٌ من الدمِّ جارفُ",17,"ف",1,0],["غُذيتُ النّعامَ الرّوحَ دونَ مَزارِكُمْ","وأسهَرَني زأرُ الضّراغِمَةِ الفُدْع",18,"ع",1,0],["غَذَاهَا البَيَانُ العَذْبُ تَهْمِي سَحَابُهُ","وَتُرْوِي البُّهَى أَنْهَارُهُ وَالسَّوَاعِدُ",19,"د",1,0],["غذا غنى حماة الحق شعري","فكم غنى البشامة والأراكا",20,"ك",2,0],["غذيت ماضيها بأكثر ما مضى","من صبوتى واليوم جئت بما بقى",21,"ق",2,0],["غذّت الأحداث منّا أنفُسا","لم يزدها العنف إلا عنفوانا",22,"ن",2,0],["غذيتها بدم الشباب وطيبه","وهرقت في لهواتها أفراحي",23,"ي",1,0],["غَذَا عِيسَنا بالبِيدِ شَدْوُ حُداتِنا","بذِكرِكَ فاِستَغنتْ عن الماءِ والحَمْضِ",24,"ض",1,0],["غَذّاهُ ماءُ النَعيمِ لكِن","ذَوى وَمذويهِ غَيرُ باغِ",25,"غ",1,0],["غذتْه أَطْبَاءُ طَلٍ","حيناً وأثْداءُ مُزْن",26,"ن",1,0],["غذا حل ركب في ذراه وظله","ليمنعهم مما تخاف نوازلهُ",27,"ل",2,0],["غَذَا همو من ثمار النيلِ يانُعها","ومن حَرَائر وادي النيل ألبان",28,"ن",1,0],["غذتها الضحايا بالجسوم فأخصبت","وأترعها سيلٌ من الدَّم جارفُ",29,"ف",1,0],["غذا فضتْ خواتمهُ علاهُ","يَبيسُ القُّمَّحانِ، منَ المُدامِ",30,"م",1,0],["غذاً فعاقبني ربي معاقبة ً ،","قرتْ بها عينُ منْ يأتيكَ بالفندِ",31,"د",1,0]]}