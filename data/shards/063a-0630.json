!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[5183,"الأبيات الحرى","https://www.poetsgate.com/ViewPoem.aspx?id=180266",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5187,"زورق الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29708",""],[5320,"الموظف","https://www.poetsgate.com/ViewPoem.aspx?id=40423",""],[5376,"يا ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5449,"لكِ الاختيار","https://www.poetsgate.com/ViewPoem.aspx?id=189263",""],[5542,"من أعماق القلب","https://www.poetsgate.com/ViewPoem.aspx?id=10052",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5628,"الحب الدائم","https://www.poetsgate.com/ViewPoem.aspx?id=178530",""],[5744,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=207274",""],[5956,"إني أمد إليك كل حبالي","https://www.poetsgate.com/ViewPoem.aspx?id=182290",""],[5956,"ما أروع التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=182322",""],[5956,"فؤادي غير مقتنع","https://www.poetsgate.com/ViewPoem.aspx?id=182482",""],[5956,"لم يبنوا مظلات للأغنام","https://www.poetsgate.com/ViewPoem.aspx?id=183387",""],[5956,"أجمل جنة في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184960",""],[5956,"كبُر الأطفال","https://www.poetsgate.com/ViewPoem.aspx?id=192726",""],[5956,"لبّت مطالبَ أبِّها أنْؤونُ","https://www.poetsgate.com/ViewPoem.aspx?id=206255",""],[6090,"يا نجم بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170919",""],[6093,"ما زال حبك في الضمائر ساكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201519",""],[6096,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=177138",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[463,"حبَّ إليها بالغضا نرتيعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60132&r=&rc=188",""],[463,"بدينكَ بعدما انفرقَ الجميعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60138&r=&rc=194",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["غَذِيَّ زَماعٍ لا يَمَلُّ كَأَنَّما","يَرى اللَيلَ كَوراً وَالمَجَرَّةَ مِقوَدا",0,"د",2,0],["غَذَتْهُ رُبا نَجْدٍ فشَبَّ كأنّهُ","شَبا مَشْرَفيٍّ يَقيُرُ السُّمَّ مُنْقَعا",1,"ع",2,0],["غذاء النفوس وطب العقو","ل وحفظ الجسوم بها يطلب",2,"ب",1,0],["غذِيَ الرجاءَ نباتُها فانْظر لمن","وشَّاه من مدحٍ فمُ ابنِ نباتها",3,"ت",3,0],["غَذاهُ وَحَولِيُّ الثَرى فَوقَ مَتنِهِ","مَدَبُّ الأَتِيِّ وَالأَراكِ الدَوائِحُ",4,"ح",1,0],["غذتك بعد حَسَن المغبِة سائغٍ","وسقتك من جارى المياه بُراد",5,"د",1,0],["غَذَّينَها في مَهدِها","بِلِبانِهِنَّ الطاهِراتِ",6,"ت",1,0],["غَذا الهِندُوانِيّاتِ بِالهامِ وَالطُلى","فَهُنَّ مَداريها وَهُنَّ المَخانِقُ",7,"ق",1,0],["غذينها بالنار إلى أن","أدينا رماتها بفراقها",8,"ق",3,0],["غذيت به طفلا وإن رمت تركه","تأبى وأغرتني به ألفة المهد",9,"د",1,1],["غَذَيتُ في الحَربِ وَعِصيانَ النُّوَب","مِن بَيتِ عِزٍ لَيسَ فيهِ مُنشَعَب",10,"ب",1,0],["غَذوَتُكَ مولوداً وَعُلتُكَ يافِعاً","تُعَلُّ بِما أُحنيَ عَلَيكَ وَتَنهلُ",11,"ل",1,1],["غَذِيَّةُ بَينِ أَبوابٍ وَدورٍ","سَقاها بَردُ رائِحَةِ العَشِيِّ",12,"ي",1,0],["غَذَتهُ صَنعَةُ الداياتِ حَتّى","زَها فَزَها بِهِ دَلٌّ وَطيبُ",13,"ب",1,0],["غَذا العِرسانِ بِإِبنِهِما عَدوّاً","أَقَلُّ أَذيَّةً مِنهُ اِبنُ عِرسِ",14,"س",1,0],["غَذاكُمُ اللَهُ مِنّي ثُمَّ عَوَّضَني","مِمّا لَقيتُ فَبِالأَجسامِ غَذّاني",15,"ن",2,0],["غَذاهُنّ مُحْمَرَّ النّجيعِ قَوارِحاً","كما كُنّ يُغْذَيْنَ الضّريبَ مِهارا",16,"ر",2,0],["غذتها الضحايا بالجسوم فأخصت","وأترعها سيلٌ من الدمِّ جارفُ",17,"ف",1,0],["غُذيتُ النّعامَ الرّوحَ دونَ مَزارِكُمْ","وأسهَرَني زأرُ الضّراغِمَةِ الفُدْع",18,"ع",1,0],["غَذَاهَا البَيَانُ العَذْبُ تَهْمِي سَحَابُهُ","وَتُرْوِي البُّهَى أَنْهَارُهُ وَالسَّوَاعِدُ",19,"د",1,0],["غذا غنى حماة الحق شعري","فكم غنى البشامة والأراكا",20,"ك",2,0],["غذيت ماضيها بأكثر ما مضى","من صبوتى واليوم جئت بما بقى",21,"ق",2,0],["غذّت الأحداث منّا أنفُسا","لم يزدها العنف إلا عنفوانا",22,"ن",2,0],["غذيتها بدم الشباب وطيبه","وهرقت في لهواتها أفراحي",23,"ح",2,0],["غَذَا عِيسَنا بالبِيدِ شَدْوُ حُداتِنا","بذِكرِكَ فاِستَغنتْ عن الماءِ والحَمْضِ",24,"ض",1,0],["غَذّاهُ ماءُ النَعيمِ لكِن","ذَوى وَمذويهِ غَيرُ باغِ",25,"غ",1,0],["غذتْه أَطْبَاءُ طَلٍ","حيناً وأثْداءُ مُزْن",26,"ن",1,0],["غذا حل ركب في ذراه وظله","ليمنعهم مما تخاف نوازلهُ",27,"ل",2,0],["غَذَا همو من ثمار النيلِ يانُعها","ومن حَرَائر وادي النيل ألبان",28,"ن",1,0],["غذاهم الوحي في مهد الرسالة من","طور إلى آخر كالماء في الشجر",29,"ر",1,0],["غذتها الضحايا بالجسوم فأخصبت","وأترعها سيلٌ من الدَّم جارفُ",30,"ف",1,0],["غذا فضتْ خواتمهُ علاهُ","يَبيسُ القُّمَّحانِ، منَ المُدامِ",31,"م",1,0],["غذاً فعاقبني ربي معاقبة ً ،","قرتْ بها عينُ منْ يأتيكَ بالفندِ",32,"د",1,0],["غذائي الحب يا من فيه حرمان","منى له أبدا ماعشت نشدان",33,"ن",1,1],["غذَّيته مُرَّ الفِطام","وحرمته ذَوقَ الغَرام",34,"م",1,0],["غذاؤهم من مسوخ البحر يزحة","وعومة أكلها سخف وتفنيد",35,"د",1,0],["غذاءُ أسماعنا غناءٌ","يكاد من لطفه يذوب",36,"ب",1,0],["غذتنِيَ مذ كُنتُ النبوّةُ والهدى","فحسبيّ أَن كانا هما لِيَ عُنصُرَا",37,"ر",2,0],["غِذَاؤُهُمْ ذِكْرُ حَبِيبِهِمُ","وَرُبَّمَا قَامَتْ بِهِ الْبِنْيَهْ",38,"ي",2,0],["غذى بلبان العلم طفلا ويافعاً","وأصبح في أثوابه يتقلب",39,"ب",1,0],["غَذاها قارِصٌ يَجري عَلَيها","وَمَحضٌ حينَ تَنبَعِثُ العِشارُ",40,"ر",1,0],["غَذاه عِرقٌ في المَكارِمِ معرقٌ","وَنَماهُ أَصلٌ في الفَخار أَصيلُ",41,"ل",1,0],["غَذَتكُم في غَداةِ الناسِ حِجا","غِذاءَ الجائِعِ الجَدعِ اللَئيمِ",42,"م",1,0],["غذى وربّى وأولى كل عارفةٍ","وبالحنانِ لنا في ظله كنفا",43,"ف",2,0],["غَذاهُ ثَديُ العُلى طِفلاً لِبانَ نَدىً","فَصارَ طَبعاً وَحَجرُ المُلكِ رَبّاهُ",44,"ا",2,0],["غذراً فقد طمس الشباب ونوره","وأضاء صبح الشيب عند طموس",45,"س",1,0],["غذاها النور والخمر","فأمر جمالها عجب",46,"ب",1,0],["غذاني وربَّاني صغيراً بعلمه","وما زال يغذوني به ويفيد",47,"د",1,0],["غَذَتْه به أُمُّ المعالي لبانَها","وطابتْ فروعٌ قد زكتْ وأُصول",48,"ل",1,0],["غذاءٌ لروحي مَدْحُهُ وثناؤه","وإنَّ أحاديثَ الكرام غذائي",49,"ي",1,0],["غذ ترى الأبطال صرعى خوفة","فرميل لا بضرب وبطعن",50,"ن",1,0],["غذي بلبان الجود كهلا ويافعا","فلا غرو أن أولى العطايا وكثّرا",51,"ر",2,0],["غَذَوْتَهُما لِبانَ الحربِ حَتَّى","تَرَكْتَهُما إِلَيْها آنِسَيْنِ",52,"ن",1,0],["غذاها نمير العلم من فيض نوره","جلت عن محياها المتوج بالبها",53,"ه",2,0],["غَذَّت محاسنها الحضارةَ فارتقت","في حينِ كانوا صائداً وَمصيدَا",54,"د",2,0],["غذوا لبان النهى صفواً بلا كدر","بيضُ الخلائق والأعراض والشيمِ",55,"م",1,0],["غذ تسربت قطع","من شوارد لظبا",56,"ب",2,0],["غذّي البنين وعلميهم نخوتي","عملي همو وحياتهم أنبائي",57,"ا",2,0],["غذ قد تحاط بك الجنو","د وأنت بينهمو مسوق",58,"ق",1,0],["غِذاؤُها أَزكى طَعام رَغَدا","لا تَشرَبُ الماءَ وَلا تَخشى الصَدا",59,"د",2,0],["غُذين الصِّبا حتّى اِرتَوَيْنَ من الصِّبا","سنينَ كما تغذو الصبيّ المطاعمُ",60,"م",1,0],["غذاهُ اللؤْمَ صِرْفاً والداهُ","فضمَّ إليهِ من صَلَفٍ مِزاجا",61,"ج",2,0],["غَذَتْهَا نِعْمَةٌ ولذيذُ عيشٍ","فأنبَتَ صدرها ثَمَر الشَّبابِ",62,"ب",1,0],["غذ هو أولى بالصواب منكم","وعلمه جم يغيب عنكم",63,"م",1,0],["غَذا دِماءَ المَسيحِ مَورِدُهُ","وَراقَهُ مِنهُ ريقُهُ النَضِرُ",64,"ر",1,0],["غذّاهُ مِن إبهامهِ","لَبَناً وقبّله وشمّه",65,"م",2,0],["غذاء الهوى ألحانها فإذا خبا","وخف لظاه ساورته فيُضرم",66,"م",1,0],["غذا الشرق فيضا من سماء بيانه","فلاحت منارا للسراة مناقبه",67,"ب",2,0],["غَذَتْها أَفاويقُ الْفَخارِ وجادَها","كمالٌ لأَدْواءِ النَّقائِصِ حاسِمُ",68,"م",1,0],["غذ جاءنا بقلّة كذاك من","تسلسل الأسباب والمنع فمن",69,"ن",1,0],["غُذِيتُ به طفلاً بإن رُمتسُ هَجره","تأَبِّى وأغرَتني به أُلفَةٌ المهدِ",70,"د",1,0],["غذيت بدَرِّ المكرمات ولم تزل","مُطاعاً مرجىّ سيداً في العشائِرِ",71,"ر",1,0],["غذونا ورحنا نشاوى نعاطى","نعياً ظليلا وعيشاً جنيّا",72,"ي",2,0],["غذاها الهواء نهاراً وليلاً","بدَرّ الغمائم عَلاَّ ونهلا",73,"ل",2,0],["غذا مصره بالمنشآت عظيمة","وبالعلم يجتاح الجهالة كالسُّحبِ",74,"ب",1,0],["غذيا ابا شبلين يشغل فرنه","اذا عض لم ينكل حشاها ونيبا",75,"ب",2,0],["غذّتهم والثدّي طاب لبانه","بأرق عاطفةٍ وأعذب عنصر",76,"ر",1,0],["غذ الدهرُ لم ينظر وجودك لا يني","يُباكِرُ رَوْضي منه طَلٌّ ووابل",77,"ل",1,0],["غذيت العلى طفلا وأصبحت عيلما","تود معاليك الورى حيثما تسري",78,"ر",2,0],["غذاها الدين مذ كانت فشبت","على التقوى رضاعاً وانفطاما",79,"م",2,0],["غَذاهُ مِنَ السِرَّينِ أَو بَطنِ حَليَةٍ","فُروعُ الأَباءِ في عَميمِ السَوائِلِ",80,"ل",1,0],["غَذِيِّ لِقاحٍ لا يَزالُ كَأَنَّهُ","حَميتٌ بِدَبغٍ عَظمُهُ غَيرُ ذي حَجمِ",81,"م",1,0],["غذاء نفوس المؤمنين وقوتها","مديح رسول الله بل هو أبلغ",82,"غ",1,1],["غُذّينَ بِكُلِّ مُنعَفِرٍ سَليبٍ","يُجاءُ بِهِ نَسلُ الدَريسُ",83,"س",1,0],["غِذاهُما بِلِحامِ القَومِ مُذ شَدنا","فَما يَزالُ بِوَصلي راكِب يَضَعُ",84,"ع",1,0],["غِذا قُمتُ وَقتاً لِلصَّلاةِ تَرَاكَمَت","علَىَّ مِنَ الدُّنيا الهُمُومُ وَحَفَّتِ",85,"ت",1,0],["غُذِّيتَ مُقْتَبَلَ الشبيبة حكمة","فقت الكهول بها وكنت وليدا",86,"د",2,0],["غذاؤُهُ في يومِه قليلُ","وجسمه من وجده نحيلُ",87,"ل",1,0],["غَذَت الغَزالَةُ بِالضِياءِ جَنينَها","ذَرّاً تَقَلَّبَ في بُطونِ رَبابِ",88,"ب",1,0],["غذيت في حب طه عند مرضعتي","بدرَّة أنا منها غير منفطم",89,"م",1,0],["غَذاهُ أَبوهُ بِحُبِّ النَّوالِ","فَلَم يَسلُ عَنهُ وَلَم يَنزَعِ",90,"ع",1,0],["غذاها عيش مرغدة وشيب","تمدحها وتعسفها النساء",91,"ا",2,0],["غُذّيَت بِالنَوى وِبِالكَسبِ وَال","قَت وَخُبزِ النَقا وَالحَلواءِ",92,"ا",2,0],["غذيتَهم بأفاويق الرَشاد كَما","يَغذي الرَضيعَ بِثديي أَمِّه اللَبَن",93,"ن",1,0],["غذته الخلافة في حجرها","فكان لتاج العلا جوهرا",94,"ر",2,0],["غذ العلوم بتذكارٍ تعش أبداً","فالنار تخمد مهما لم تجد حطبا",95,"ب",2,0],["غَذِيُّ عُلومٍ لَم يَزَل مُنذُ نَشئِهِ","يَلوحُ عَلى أُفقِ المَعارفِ سَعدُهُ",96,"د",2,0],["غُذِيتُ بعلم النَحو إِذ دَرَّ لي ثَديا","فَجسمي بِهِ ينمى وَروحي بِهِ تَحيا",97,"ي",2,1],["غَذيت بِدَرِّ الفَضلِ مُذ كُنتِ طفلَةً","وَكان بِتعليمِ القُرآن فِطامكِ",98,"ك",1,0],["غذاؤه ودمه محمود","قريبُ خير شره 