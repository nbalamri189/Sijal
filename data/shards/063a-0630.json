{"poems":[[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[90,"وفي الألعاب لم تر قط عيني","https://www.aldiwan.net/poem44395.html","الوافر"],[74,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[40,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[87,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[87,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[45,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[64,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[63,"غذيت به طفلا وإن رمت تركه","https://www.aldiwan.net/poem51306.html","السريع"],[60,"أنا علي وابن عبد المطلب مهذب","https://www.aldiwan.net/poem31159.html","الرجز"],[21,"غذوتك مولودا وعلتك يافعا","https://www.aldiwan.net/poem36184.html","الكامل"],[22,"عرفت منازلا من آل هند","https://www.aldiwan.net/poem21670.html","الوافر"],[50,"دع الأطلال تسفيها الجنوب","https://www.aldiwan.net/poem10768.html","الوافر"],[48,"تعالي قدرة وخفوت جرس","https://www.aldiwan.net/poem22835.html","الوافر"],[48,"قد آذنتنا بأمر فادح أذن","https://www.aldiwan.net/poem23517.html","البسيط"],[48,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142015","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141918","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[38,"بعيدُ الثَّرَى لا يَبْلُغُ القَوْمُ قَعْرَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=15886",""],[108,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[98,"الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=13197",""],[7,"أتارِكَة ٌ تدَلَلّهَا قَطامِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17593",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[215,"يا جنة الخلد كيف يشقى","https://www.aldiwan.net/poem46558.html","مخلع البسيط"],[233,"ليهنك أني لم أجد لك عائبا","https://www.aldiwan.net/poem51099.html","الطويل"],[241,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[243,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[253,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[256,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[264,"ألا أبلغ لديك أبا حميسٍ","https://www.aldiwan.net/poem1114.html",""],[285,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[286,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[314,"ضحكت وجوه الدهر بعد عبوس","https://www.aldiwan.net/poem59511.html","الكامل"],[332,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[407,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[420,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[420,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[441,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[441,"ترى زائري طيف الخيال الذي سرى","https://www.aldiwan.net/poem2571.html","الطويل"],[443,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[452,"من وحي العلم","https://www.aldiwan.net/poem987.html",""],[456,"عيد الضحية مرحبا بك عيدا","https://www.aldiwan.net/poem61686.html","الكامل"],[467,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[482,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[482,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[482,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[496,"من منصفي من محكم الكتاب","https://www.aldiwan.net/poem67302.html","الرجز"],[554,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[554,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[570,"ومنزل قينة سهل الجناب","https://www.aldiwan.net/poem69805.html","الوافر"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31488","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31486","الطويل"]],"verses":[["غَذِيَّ زَماعٍ لا يَمَلُّ كَأَنَّما","يَرى اللَيلَ كَوراً وَالمَجَرَّةَ مِقوَدا",0,"د",2,0],["غَذَتْهُ رُبا نَجْدٍ فشَبَّ كأنّهُ","شَبا مَشْرَفيٍّ يَقيُرُ السُّمَّ مُنْقَعا",1,"ع",2,0],["غذاء النفوس وطب العقو","ل وحفظ الجسوم بها يطلب",2,"ب",1,0],["غذِيَ الرجاءَ نباتُها فانْظر لمن","وشَّاه من مدحٍ فمُ ابنِ نباتها",3,"ت",3,0],["غَذاهُ وَحَولِيُّ الثَرى فَوقَ مَتنِهِ","مَدَبُّ الأَتِيِّ وَالأَراكِ الدَوائِحُ",4,"ح",1,0],["غذتك بعد حَسَن المغبِة سائغٍ","وسقتك من جارى المياه بُراد",5,"د",1,0],["غَذَّينَها في مَهدِها","بِلِبانِهِنَّ الطاهِراتِ",6,"ت",1,0],["غَذا الهِندُوانِيّاتِ بِالهامِ وَالطُلى","فَهُنَّ مَداريها وَهُنَّ المَخانِقُ",7,"ق",1,0],["غذينها بالنار إلى أن","أدينا رماتها بفراقها",8,"ق",3,0],["غذيت به طفلا وإن رمت تركه","تأبى وأغرتني به ألفة المهد",9,"د",1,1],["غَذَيتُ في الحَربِ وَعِصيانَ النُّوَب","مِن بَيتِ عِزٍ لَيسَ فيهِ مُنشَعَب",10,"ب",1,0],["غَذوَتُكَ مولوداً وَعُلتُكَ يافِعاً","تُعَلُّ بِما أُحنيَ عَلَيكَ وَتَنهلُ",11,"ل",1,1],["غَذِيَّةُ بَينِ أَبوابٍ وَدورٍ","سَقاها بَردُ رائِحَةِ العَشِيِّ",12,"ي",1,0],["غَذَتهُ صَنعَةُ الداياتِ حَتّى","زَها فَزَها بِهِ دَلٌّ وَطيبُ",13,"ب",1,0],["غَذا العِرسانِ بِإِبنِهِما عَدوّاً","أَقَلُّ أَذيَّةً مِنهُ اِبنُ عِرسِ",14,"س",1,0],["غَذاكُمُ اللَهُ مِنّي ثُمَّ عَوَّضَني","مِمّا لَقيتُ فَبِالأَجسامِ غَذّاني",15,"ن",2,0],["غَذاهُنّ مُحْمَرَّ النّجيعِ قَوارِحاً","كما كُنّ يُغْذَيْنَ الضّريبَ مِهارا",16,"ر",2,0],["غذتها الضحايا بالجسوم فأخصت","وأترعها سيلٌ من الدمِّ جارفُ",17,"ف",1,0],["غُذيتُ النّعامَ الرّوحَ دونَ مَزارِكُمْ","وأسهَرَني زأرُ الضّراغِمَةِ الفُدْع",18,"ع",1,0],["غَذَاهَا البَيَانُ العَذْبُ تَهْمِي سَحَابُهُ","وَتُرْوِي البُّهَى أَنْهَارُهُ وَالسَّوَاعِدُ",19,"د",1,0],["غذا غنى حماة الحق شعري","فكم غنى البشامة والأراكا",20,"ك",2,0],["غذيت ماضيها بأكثر ما مضى","من صبوتى واليوم جئت بما بقى",21,"ق",2,0],["غذّت الأحداث منّا أنفُسا","لم يزدها العنف إلا عنفوانا",22,"ن",2,0],["غذيتها بدم الشباب وطيبه","وهرقت في لهواتها أفراحي",23,"ح",2,0],["غَذَا عِيسَنا بالبِيدِ شَدْوُ حُداتِنا","بذِكرِكَ فاِستَغنتْ عن الماءِ والحَمْضِ",24,"ض",1,0],["غَذّاهُ ماءُ النَعيمِ لكِن","ذَوى وَمذويهِ غَيرُ باغِ",25,"غ",1,0],["غذتْه أَطْبَاءُ طَلٍ","حيناً وأثْداءُ مُزْن",26,"ن",1,0],["غذا حل ركب في ذراه وظله","ليمنعهم مما تخاف نوازلهُ",27,"ل",2,0],["غَذَا همو من ثمار النيلِ يانُعها","ومن حَرَائر وادي النيل ألبان",28,"ن",1,0],["غذاهم الوحي في مهد الرسالة من","طور إلى آخر كالماء في الشجر",29,"ر",1,0],["غذتها الضحايا بالجسوم فأخصبت","وأترعها سيلٌ من الدَّم جارفُ",30,"ف",1,0],["غذا فضتْ خواتمهُ علاهُ","يَبيسُ القُّمَّحانِ، منَ المُدامِ",31,"م",1,0],["غذاً فعاقبني ربي معاقبة ً ،","قرتْ بها عينُ منْ يأتيكَ بالفندِ",32,"د",1,0],["غذائي الحب يا من فيه حرمان","منى له أبدا ماعشت نشدان",33,"ن",1,1],["غذَّيته مُرَّ الفِطام","وحرمته ذَوقَ الغَرام",34,"م",1,0],["غذاؤهم من مسوخ البحر يزحة","وعومة أكلها سخف وتفنيد",35,"د",1,0],["غذاءُ أسماعنا غناءٌ","يكاد من لطفه يذوب",36,"ب",1,0],["غذتنِيَ مذ كُنتُ النبوّةُ والهدى","فحسبيّ أَن كانا هما لِيَ عُنصُرَا",37,"ر",2,0],["غِذَاؤُهُمْ ذِكْرُ حَبِيبِهِمُ","وَرُبَّمَا قَامَتْ بِهِ الْبِنْيَهْ",38,"ي",2,0],["غذى بلبان العلم طفلا ويافعاً","وأصبح في أثوابه يتقلب",39,"ب",1,0],["غَذاها قارِصٌ يَجري عَلَيها","وَمَحضٌ حينَ تَنبَعِثُ العِشارُ",40,"ر",1,0],["غَذاه عِرقٌ في المَكارِمِ معرقٌ","وَنَماهُ أَصلٌ في الفَخار أَصيلُ",41,"ل",1,0],["غَذَتكُم في غَداةِ الناسِ حِجا","غِذاءَ الجائِعِ الجَدعِ اللَئيمِ",42,"م",1,0],["غذى وربّى وأولى كل عارفةٍ","وبالحنانِ لنا في ظله كنفا",43,"ف",2,0],["غَذاهُ ثَديُ العُلى طِفلاً لِبانَ نَدىً","فَصارَ طَبعاً وَحَجرُ المُلكِ رَبّاهُ",44,"ا",2,0],["غذراً فقد طمس الشباب ونوره","وأضاء صبح الشيب عند طموس",45,"س",1,0],["غذاها النور والخمر","فأمر جمالها عجب",46,"ب",1,0],["غذاني وربَّاني صغيراً بعلمه","وما زال يغذوني به ويفيد",47,"د",1,0],["غَذَتْه به أُمُّ المعالي لبانَها","وطابتْ فروعٌ قد زكتْ وأُصول",48,"ل",1,0],["غذاءٌ لروحي مَدْحُهُ وثناؤه","وإنَّ أحاديثَ الكرام غذائي",49,"ي",1,0],["غذ ترى الأبطال صرعى خوفة","فرميل لا بضرب وبطعن",50,"ن",1,0],["غذي بلبان الجود كهلا ويافعا","فلا غرو أن أولى العطايا وكثّرا",51,"ر",2,0],["غَذَوْتَهُما لِبانَ الحربِ حَتَّى","تَرَكْتَهُما إِلَيْها آنِسَيْنِ",52,"ن",1,0],["غذاها نمير العلم من فيض نوره","جلت عن محياها المتوج بالبها",53,"ه",2,0],["غَذَّت محاسنها الحضارةَ فارتقت","في حينِ كانوا صائداً وَمصيدَا",54,"د",2,0],["غذوا لبان النهى صفواً بلا كدر","بيضُ الخلائق والأعراض والشيمِ",55,"م",1,0],["غذ تسربت قطع","من شوارد لظبا",56,"ب",2,0],["غذّي البنين وعلميهم نخوتي","عملي همو وحياتهم أنبائي",57,"ا",2,0],["غذ قد تحاط بك الجنو","د وأنت بينهمو مسوق",58,"ق",1,0],["غِذاؤُها أَزكى طَعام رَغَدا","لا تَشرَبُ الماءَ وَلا تَخشى الصَدا",59,"د",2,0],["غُذين الصِّبا حتّى اِرتَوَيْنَ من الصِّبا","سنينَ كما تغذو الصبيّ المطاعمُ",60,"م",1,0],["غذاهُ اللؤْمَ صِرْفاً والداهُ","فضمَّ إليهِ من صَلَفٍ مِزاجا",61,"ج",2,0],["غَذَتْهَا نِعْمَةٌ ولذيذُ عيشٍ","فأنبَتَ صدرها ثَمَر الشَّبابِ",62,"ب",1,0],["غذ هو أولى بالصواب منكم","وعلمه جم يغيب عنكم",63,"م",1,0],["غَذاهُ مِنَ السِرَّينِ أَو بَطنِ حَليَةٍ","فُروعُ الأَباءِ في عَميمِ السَوائِلِ",64,"ل",1,0],["غَذِيِّ لِقاحٍ لا يَزالُ كَأَنَّهُ","حَميتٌ بِدَبغٍ عَظمُهُ غَيرُ ذي حَجمِ",65,"م",1,0]]}