{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[88,"وفي الألعاب لم تر قط عيني","https://www.aldiwan.net/poem44395.html","الوافر"],[72,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[62,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[61,"غذيت به طفلا وإن رمت تركه","https://www.aldiwan.net/poem51306.html","السريع"],[58,"أنا علي وابن عبد المطلب مهذب","https://www.aldiwan.net/poem31159.html","الرجز"],[21,"غذوتك مولودا وعلتك يافعا","https://www.aldiwan.net/poem36184.html","الكامل"],[22,"عرفت منازلا من آل هند","https://www.aldiwan.net/poem21670.html","الوافر"],[48,"دع الأطلال تسفيها الجنوب","https://www.aldiwan.net/poem10768.html","الوافر"],[46,"تعالي قدرة وخفوت جرس","https://www.aldiwan.net/poem22835.html","الوافر"],[46,"قد آذنتنا بأمر فادح أذن","https://www.aldiwan.net/poem23517.html","البسيط"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142015","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141918","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[36,"بعيدُ الثَّرَى لا يَبْلُغُ القَوْمُ قَعْرَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=15886",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[96,"الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=13197",""],[7,"أتارِكَة ٌ تدَلَلّهَا قَطامِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17593",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""],[120,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[129,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[186,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[211,"يا جنة الخلد كيف يشقى","https://www.aldiwan.net/poem46558.html","مخلع البسيط"],[229,"ليهنك أني لم أجد لك عائبا","https://www.aldiwan.net/poem51099.html","الطويل"],[237,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[239,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[249,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[252,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[260,"ألا أبلغ لديك أبا حميسٍ","https://www.aldiwan.net/poem1114.html",""],[281,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[282,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[310,"ضحكت وجوه الدهر بعد عبوس","https://www.aldiwan.net/poem59511.html","الكامل"],[328,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[403,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[416,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[416,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[437,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[437,"ترى زائري طيف الخيال الذي سرى","https://www.aldiwan.net/poem2571.html","الطويل"],[439,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[449,"من وحي العلم","https://www.aldiwan.net/poem987.html",""],[453,"عيد الضحية مرحبا بك عيدا","https://www.aldiwan.net/poem61686.html","الكامل"],[464,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[479,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[479,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[479,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[493,"من منصفي من محكم الكتاب","https://www.aldiwan.net/poem67302.html","الرجز"],[551,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[551,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[567,"ومنزل قينة سهل الجناب","https://www.aldiwan.net/poem69805.html","الوافر"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["غَذِيَّ زَماعٍ لا يَمَلُّ كَأَنَّما","يَرى اللَيلَ كَوراً وَالمَجَرَّةَ مِقوَدا",0,"د",2,0],["غَذَتْهُ رُبا نَجْدٍ فشَبَّ كأنّهُ","شَبا مَشْرَفيٍّ يَقيُرُ السُّمَّ مُنْقَعا",1,"ع",2,0],["غذاء النفوس وطب العقو","ل وحفظ الجسوم بها يطلب",2,"ب",1,0],["غذِيَ الرجاءَ نباتُها فانْظر لمن","وشَّاه من مدحٍ فمُ ابنِ نباتها",3,"ت",3,0],["غَذاهُ وَحَولِيُّ الثَرى فَوقَ مَتنِهِ","مَدَبُّ الأَتِيِّ وَالأَراكِ الدَوائِحُ",4,"ح",1,0],["غذتك بعد حَسَن المغبِة سائغٍ","وسقتك من جارى المياه بُراد",5,"د",1,0],["غَذَّينَها في مَهدِها","بِلِبانِهِنَّ الطاهِراتِ",6,"ت",1,0],["غَذا الهِندُوانِيّاتِ بِالهامِ وَالطُلى","فَهُنَّ مَداريها وَهُنَّ المَخانِقُ",7,"ق",1,0],["غذينها بالنار إلى أن","أدينا رماتها بفراقها",8,"ق",3,0],["غذيت به طفلا وإن رمت تركه","تأبى وأغرتني به ألفة المهد",9,"د",1,1],["غَذَيتُ في الحَربِ وَعِصيانَ النُّوَب","مِن بَيتِ عِزٍ لَيسَ فيهِ مُنشَعَب",10,"ب",1,0],["غَذوَتُكَ مولوداً وَعُلتُكَ يافِعاً","تُعَلُّ بِما أُحنيَ عَلَيكَ وَتَنهلُ",11,"ل",1,1],["غَذِيَّةُ بَينِ أَبوابٍ وَدورٍ","سَقاها بَردُ رائِحَةِ العَشِيِّ",12,"ي",1,0],["غَذَتهُ صَنعَةُ الداياتِ حَتّى","زَها فَزَها بِهِ دَلٌّ وَطيبُ",13,"ب",1,0],["غَذا العِرسانِ بِإِبنِهِما عَدوّاً","أَقَلُّ أَذيَّةً مِنهُ اِبنُ عِرسِ",14,"س",1,0],["غَذاكُمُ اللَهُ مِنّي ثُمَّ عَوَّضَني","مِمّا لَقيتُ فَبِالأَجسامِ غَذّاني",15,"ن",2,0],["غَذاهُنّ مُحْمَرَّ النّجيعِ قَوارِحاً","كما كُنّ يُغْذَيْنَ الضّريبَ مِهارا",16,"ر",2,0],["غذتها الضحايا بالجسوم فأخصت","وأترعها سيلٌ من الدمِّ جارفُ",17,"ف",1,0],["غُذيتُ النّعامَ الرّوحَ دونَ مَزارِكُمْ","وأسهَرَني زأرُ الضّراغِمَةِ الفُدْع",18,"ع",1,0],["غَذَاهَا البَيَانُ العَذْبُ تَهْمِي سَحَابُهُ","وَتُرْوِي البُّهَى أَنْهَارُهُ وَالسَّوَاعِدُ",19,"د",1,0],["غذا غنى حماة الحق شعري","فكم غنى البشامة والأراكا",20,"ك",2,0],["غذيت ماضيها بأكثر ما مضى","من صبوتى واليوم جئت بما بقى",21,"ق",2,0],["غذّت الأحداث منّا أنفُسا","لم يزدها العنف إلا عنفوانا",22,"ن",2,0],["غذيتها بدم الشباب وطيبه","وهرقت في لهواتها أفراحي",23,"ي",1,0],["غَذَا عِيسَنا بالبِيدِ شَدْوُ حُداتِنا","بذِكرِكَ فاِستَغنتْ عن الماءِ والحَمْضِ",24,"ض",1,0],["غَذّاهُ ماءُ النَعيمِ لكِن","ذَوى وَمذويهِ غَيرُ باغِ",25,"غ",1,0],["غذتْه أَطْبَاءُ طَلٍ","حيناً وأثْداءُ مُزْن",26,"ن",1,0],["غذا حل ركب في ذراه وظله","ليمنعهم مما تخاف نوازلهُ",27,"ل",2,0],["غَذَا همو من ثمار النيلِ يانُعها","ومن حَرَائر وادي النيل ألبان",28,"ن",1,0],["غذتها الضحايا بالجسوم فأخصبت","وأترعها سيلٌ من الدَّم جارفُ",29,"ف",1,0],["غذا فضتْ خواتمهُ علاهُ","يَبيسُ القُّمَّحانِ، منَ المُدامِ",30,"م",1,0],["غذاً فعاقبني ربي معاقبة ً ،","قرتْ بها عينُ منْ يأتيكَ بالفندِ",31,"د",1,0],["غذائي الحب يا من فيه حرمان","منى له أبدا ماعشت نشدان",32,"ن",1,1],["غذَّيته مُرَّ الفِطام","وحرمته ذَوقَ الغَرام",33,"م",1,0],["غذاؤهم من مسوخ البحر يزحة","وعومة أكلها سخف وتفنيد",34,"د",1,0],["غذاءُ أسماعنا غناءٌ","يكاد من لطفه يذوب",35,"ب",1,0],["غذتنِيَ مذ كُنتُ النبوّةُ والهدى","فحسبيّ أَن كانا هما لِيَ عُنصُرَا",36,"ر",2,0],["غِذَاؤُهُمْ ذِكْرُ حَبِيبِهِمُ","وَرُبَّمَا قَامَتْ بِهِ الْبِنْيَهْ",37,"ي",2,0],["غذى بلبان العلم طفلا ويافعاً","وأصبح في أثوابه يتقلب",38,"ب",1,0],["غَذاها قارِصٌ يَجري عَلَيها","وَمَحضٌ حينَ تَنبَعِثُ العِشارُ",39,"ر",1,0],["غَذاه عِرقٌ في المَكارِمِ معرقٌ","وَنَماهُ أَصلٌ في الفَخار أَصيلُ",40,"ل",1,0],["غَذَتكُم في غَداةِ الناسِ حِجا","غِذاءَ الجائِعِ الجَدعِ اللَئيمِ",41,"م",1,0],["غذى وربّى وأولى كل عارفةٍ","وبالحنانِ لنا في ظله كنفا",42,"ف",2,0],["غَذاهُ ثَديُ العُلى طِفلاً لِبانَ نَدىً","فَصارَ طَبعاً وَحَجرُ المُلكِ رَبّاهُ",43,"ا",2,0],["غذراً فقد طمس الشباب ونوره","وأضاء صبح الشيب عند طموس",44,"س",1,0],["غذاها النور والخمر","فأمر جمالها عجب",45,"ب",1,0],["غذاني وربَّاني صغيراً بعلمه","وما زال يغذوني به ويفيد",46,"د",1,0],["غَذَتْه به أُمُّ المعالي لبانَها","وطابتْ فروعٌ قد زكتْ وأُصول",47,"ل",1,0],["غذاءٌ لروحي مَدْحُهُ وثناؤه","وإنَّ أحاديثَ الكرام غذائي",48,"ي",1,0],["غذ ترى الأبطال صرعى خوفة","فرميل لا بضرب وبطعن",49,"ن",1,0],["غذي بلبان الجود كهلا ويافعا","فلا غرو أن أولى العطايا وكثّرا",50,"ر",2,0],["غَذَوْتَهُما لِبانَ الحربِ حَتَّى","تَرَكْتَهُما إِلَيْها آنِسَيْنِ",51,"ن",1,0],["غذاها نمير العلم من فيض نوره","جلت عن محياها المتوج بالبها",52,"ه",2,0],["غَذَّت محاسنها الحضارةَ فارتقت","في حينِ كانوا صائداً وَمصيدَا",53,"د",2,0],["غذوا لبان النهى صفواً بلا كدر","بيضُ الخلائق والأعراض والشيمِ",54,"م",1,0],["غذ تسربت قطع","من شوارد لظبا",55,"ب",2,0],["غذّي البنين وعلميهم نخوتي","عملي همو وحياتهم أنبائي",56,"ا",2,0],["غذ قد تحاط بك الجنو","د وأنت بينهمو مسوق",57,"ق",1,0],["غِذاؤُها أَزكى طَعام رَغَدا","لا تَشرَبُ الماءَ وَلا تَخشى الصَدا",58,"د",2,0],["غُذين الصِّبا حتّى اِرتَوَيْنَ من الصِّبا","سنينَ كما تغذو الصبيّ المطاعمُ",59,"م",1,0],["غذاهُ اللؤْمَ صِرْفاً والداهُ","فضمَّ إليهِ من صَلَفٍ مِزاجا",60,"ج",2,0],["غَذَتْهَا نِعْمَةٌ ولذيذُ عيشٍ","فأنبَتَ صدرها ثَمَر الشَّبابِ",61,"ب",1,0],["غذ هو أولى بالصواب منكم","وعلمه جم يغيب عنكم",62,"م",1,0]]}