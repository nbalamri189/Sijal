{"poems":[[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53914","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136336","الطويل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101897","الرجز"],[6278,"جميلتي عمّان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86849&r=&rc=2",""]],"verses":[["عليَّ إتمامُ أمرٍ قد خُلقتُ لهُ","لأنني خادمٌ من جملة الخدم",0,"م",1,0],["عُلىً أتتْ سحراً بالطّيب نفحتُها","فاحَ الدُّجى سَحَراً من عَرْفها العَطِرِ",1,"ر",1,0],["عليا تعإلى في العلى وارتقى إلى","مراتب لا تحصى بعد وحسبان",2,"ن",1,0],["على اتحاد الفحل مبنى النشر","بين الرضيعين هنا لا الظئر",3,"ر",1,0],["علّي أتوب وهل يتوب العاشق","هو لا يتوب ولا يتوب وألف لا",4,"ل",2,0]]}