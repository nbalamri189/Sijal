.ae/diwan/poem/34548","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29311","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81918","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136473",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58092","البسيط"],[4601,"","https://poetry.dctabudhabi.ae/diwan/poem/147770","الكامل"],[4717,"العشقُ في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=199594",""],[4767,"شمس الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179940",""],[4929,"جزء من قصيدة ملحمة النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=199886",""],[4984,"\" ليس الأدل \" 1","https://www.poetsgate.com/ViewPoem.aspx?id=175797",""],[4984,"منَّة رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=180976",""],[5038,"بنت الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=189983",""],[5147,"خطب كما تعلمونه صعب","https://www.poetsgate.com/ViewPoem.aspx?id=166695",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5387,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=53792",""],[5402,"لو تدري مافعلت بنا الأسماك","https://www.poetsgate.com/ViewPoem.aspx?id=215528",""],[5409,"منعاك عز على العراق الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=155480",""],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""],[5431,"النارنج قصة عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=202098",""],[5705,"الحَرْبُ أوّلَ مَا تَكونُ فُتَيّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=4538",""],[5725,"الشبل المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=190296",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""],[4442,"تطوي الذميل على الرسيم","https://www.poetsgate.com/ViewPoem.aspx?id=171227",""],[6259,"قولا له هل دارَ في حوبائهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59352&r=&rc=0",""]],"verses":[["حَتَّى إِذَا حَلَّى العَيَاءُ جَبِينُهَا","بِنَدًى وَأَخْمَدَ جَمْرَةً مِنْ عَزْمِهَا",0,"م",3,0],["حَتّى إِذا حُزَّت مِياهُ رزونِهِ","وَبِأَيِّ حَزِّ مَلاوَةٍ يَتَقَطَّعُ",1,"ع",1,1],["حَتّى إِذا حانَ مِن خُضرِ قَوادِمُهُ","ذي جُدَّتَينِ يَكُفُّ الطَرفَ تَغييمُ",2,"م",1,0],["حتى إذا حطّ منقضّاً على بلد","ينقضّ والبلد الأقصى له أمَم",3,"م",1,0],["حتى إذا حسرتْ ظلالُ عمايتي","أعرضتُ عنه بصفحةِ المستيئس",4,"س",1,0],["حتى إذا حملتكُم في وشيجكُمُ","سارت هناك بآسادٍ وآجامِ",5,"م",1,0],["حَتّى إِذا حانَ الوُصولُ رَمَت بِنا","نَكباءُ عاتِيَةٌ إِلى الغَبراءِ",6,"ا",2,0],["حَتّى إِذا حالَ النَوى","بَيني وَبَينَ كِناسِها",7,"س",3,0],["حَتّى إِذا حالَتِ الأَرحاءُ دونَهُمُ","أَرحاءَ أَرمُلَ حارَ الطَرفُ أَو بَعَدوا",8,"د",3,0],["حَتّى إِذا حَسَرَ الظَلامُ وَأَسفَرَت","فَرَأَت أَوابِدَ يَرتَعينَ هُجولا",9,"ل",2,0],["حَتّى إِذا حَيّوا المُؤَيَّدَ بِالهُدى","وَدَعَوا بِطولِ العِزِّ وَالإِمكانِ",10,"ن",1,0],["حَتّى إِذا حَطّوا بِسَفحِ الجودي","وَأَيقَنوا بِعَودَةِ الوُجودِ",11,"د",1,0],["حتى إِذا حزتَ من طِيبٍ ومن أرَجٍ","لطيمةً ذاتَ أنواعٍ وألوانٍ",12,"ن",1,0],["حَتّى إِذا حَذِقَ القِيادَةَ كُلَّها","باعَ القِيانَ وَجَدَّ في التَعيّنِ",13,"ن",1,0],["حَتّى إِذا حَلَّتِ الكَأسُ النَشاطَ لَهُ","أَتبَعتُهُ بِثَلاثٍ تَبعَثُ الفَرَحا",14,"ح",2,0],["حَتّى إِذا حانَ أَمرُ الغَيبِ وَاِنحَسَرَت","أَستارُهُ عَن ضَميرِ اللَوحِ وَالقَلَمِ",15,"م",1,0],["حَتّى إِذا حَصَلَ الأُمو","رُ وَصارَ لِلحَسَبِ المَصائِر",16,"ر",1,0],["حَتّى إِذا حاطَت بِهِ آثامُهُ","وَقَرُبَت مِنَ الرَدى أَيّامُه",17,"ه",1,0],["حتى إذا حرِجَتْ به أرْضُ العدى","مُتَمَطّياً وتَضايقَتْ أعطانها",18,"ن",3,0],["حَتّى إِذا حازَها الحَيُّ الَّذي قَصَدوا","بِها إِلَيهِ فَحيزَت مِنهُ في دارِ",19,"ر",1,0],["حَتّى إِذا حَطَّها وَأَنزَلَها","وَفَكَّ عَنها الخِتامَ فَدّاها",20,"ا",3,0],["حتى إذا حمي الهجاءُ على استهِ","ورأى بأن ما في يديهِ خلاصُ",21,"ص",1,0],["حتَّى إذا حَلَّ على مُطْنيَه","وكانَ فيها أخبثُ البريَّهْ",22,"ه",1,0],["حتّى إذا حَلَّ على تُطيلَهْ","بكتْ على دمائِها المَطْلولَهْ",22,"ه",1,0],["حَتَّى إِذَا حَالَتِ الشَّهْلاَءُ دُونَهُمُ","واسْتَوْقَدَ الحَرُّ قَالُوا قَوْلَةً قِيلُوا",23,"ل",3,0],["حتى إذا حانَ الرحيلُ هتفت بي","فوقفتُ واستبقتْ خطاك نواظري",24,"ر",2,0],["حَتَّى إِذَا حَلَّ ضَاحِي الْيَوْمِ حَبْوَتَهُ","وَكَادَتِ الشَّمْسُ بَيْنَ الْغَرْبِ تَنْهَبِطُ",25,"ط",1,0],["حَتَّى إِذَا حُمِلَتْ إِليْكَ سَبِيَّةً","مَجْلُوبَةً فِي جُمْلَةِ الآْلاَءِ",26,"ا",2,0],["حَتّى إِذا حُكِّمَ فيهِ الرَدى","لَم أَستَطِع قَبضاً وَلا بَسطا",27,"ط",2,0],["حتى إذا حَصَلَ الأُمُو","وصار للحسبِ المصاير",28,"ر",1,0],["حتى إذا حَميَتْ وغىً وأدارها","كأساً \" إياسٌ \" مرةً و\" عِصام \"",29,"م",1,0],["حتى إذا حكَم المغيبُ بدا له","شفقٌ يُحيطُ البدرَ حين مُثوله",30,"ل",2,0],["حَتَّى إِذا حَذِقَ القِيَادَةَ كُلَّها","باعَ القِيانَ وجَدَّ فِي التَّعْيِينِ",31,"ن",1,0],["حتى إذا حان الوصول ... رمت بنا","نكباء عانية إلى الغبراء!",32,"ا",2,0],["حتى إذا حاولتَ إخراجَه","بصَبِّ بعضِ الماء وَلَّى وفَرّْ",33,"ر",1,0],["حتى إذا حدثتُه لفظةً","ينساك في ساعِته قبلَها",34,"ل",3,0],["حتى إذا حصّل برّي له","انقلب الشوق إلى فوق",35,"ق",1,0],["حَتّى إِذا حطم الهَوى قيثاري","أَوتاره اِنقَطَعَت عَن النَغماتِ",36,"ت",1,0],["حَتَّى إِذا حَسَرَ الصّبَاحُ كَأَنَّهُ","وَجْهُ الْوَجِيهِ تَبَلُّجَاً وَتَأَلُّقا",37,"ق",2,0],["حتى إذا حمَّ القضاء","وأبت من دنيا السراب",38,"ب",1,0],["حتّى إِذا حاذاهُ","صكَّ بها مَجلاهُ",39,"ه",1,0],["حتى إذا حلقت في الجو أخيلتي","وعانقت في دنى الاباد آزالي",40,"ل",2,0],["حتَّى إِذا حَصلَ الحَرفان لا يَئِسَت","منه النُّفوسُ إِلى أَن يَحصُلَ اللطَفُ",41,"ف",1,0],["حَتّى إِذا حانَ الغُرو","ب صَحى وَقَلبي غَير صاحي",42,"ح",2,0],["حتَّى إذا حار الطبيب بعلَّتي","وقف القياس بها على الإيهام",43,"م",1,0],["حتى إذا حبس القطارُ وأجحفتْ","غُبرُ السنين وحالَ نوءُ المرْزَمِ",44,"م",1,0],["حتى إذا حلَّت بساحة قصدهِ","فكّت هنالك غالقات رهونها",45,"ن",3,0],["حتّى إذا حلَّ النّوى","حدا إليَّ ظُعُنَهْ",46,"ن",2,0],["حتّى إذا حان بلوغُ المَدى","قِيدوا إلى المكروه أو سُوِّقوا",47,"ق",3,0],["حَتّى إِذا حَلَّ لَم تَعقِد مَناحَتُهُ","إِلّا عَلى حادِثٍ مِن قَبلُ مَرهوبِ",48,"ب",1,0],["حتَى إذا حَمي الوَطيسُ وأحضِرَت","عَنهُ السَّوابِقُ أيّما إحضار",49,"ر",1,0],["حتى إذا حِميتَ مراجلُها جرت","كالليث يزأرُ في الفلا غضبانا",50,"ن",2,0],["حتَّى إذا حيَّت بَدَا","في ثغرها الدرُّ النَّضير",51,"ر",1,0],["حتَّى إذا حنَّتْ إلى المزار","سحابةٌ مسحوبةُ الأزرار",52,"ر",1,0],["حتى إذا حلّوا بذاك النادي","واستوثقوا طرفي ذاك الوادي",53,"ي",1,0],["حتى إذا حطّ اليقين لثامه","عادت سيوف العلج وهي قيود",54,"د",1,0],["حَتَّى إِذا حالَ عَلَيهِ الحَول","وَجاءَ شَعبان عراه الوَيل",55,"ل",1,0],["حتَّى إذا حضَروا النَّديَّ رأَيتَهُمْ","مثْل الاهلَّةِ في فتوقِ الزّبْرجِ",56,"ج",1,0],["حتى إذا حسر الظلام قناعه","قامت وواكف دمعها يجري",57,"ر",2,0],["حَتّى إِذا حكتُ أَثواب المَديح إِذا","بِجودُ لابِسِها قَولٌ وَلا عَمَل",58,"ل",1,0],["حَتّى إِذا حَلّوا النَدى وَأَينَعَت","لَهُمُ رِياض البَشر وَالادناء",59,"ا",2,0],["حتى إذا حليت بالتنزيلِ","نظرت في حقائق التأويلِ",60,"ل",1,0],["حَتّى إِذا حَلَّ شَرقِيٌّ عَساكِرَهُ","ما في قَوادِمِ سِقطَيه مِن اِفراجِ",61,"ج",1,0],["حتى إذا حم والحمام وآن له","تلقى عماداً للعلا وعميدا",62,"د",2,0],["حتى إذا حم الحمام","وصوبت يده سهامه",63,"م",2,0],["حَتّى إِذا حَلَّوا بِقَفرٍ بَلقَعٍ","وَخَيَّموا وَاِفتَرَشوا الطَنافِسا",64,"س",2,0],["حَتّى إِذا حَلَّ النَوى","لَم تَلقَ عَيناً تَدمَعِ",65,"ع",1,0],["حتى اذا حضنت منها كفلا","يرتج في مثل الكثيب الأهيل",66,"ل",1,0],["حَتَّى إِذا حمل السّحابَ بِجيدِهِ","لَم تَحتَملهُ فَرائصُ المَحمولِ",67,"ل",1,0],["حتى إذا حاولت قفزاً بساحتها","ظلت تصادم كثباناً وجدرانا",68,"ن",2,0],["حَتّى إِذا حَلت بِربعك غدوة","أَبدَت عَن الإخلاص وَجهاً مُشرِقا",69,"ق",2,0],["حَتّى إِذا حَلَّتِ الشَهلاءُ دونَهُمُ","وَاِستَوقَدَ الحَرُّ قالوا قَولَةً قيلوا",70,"ل",3,0],["حتى إذا حلت به آنست","ازهر يحوى العز برداه",71,"ا",2,0],["حتى إذا حاذيت باب الخان","نادى هلم أنت عن سكاني",72,"ي",1,0],["حتى إذا حم القضا اغتالوه في","حفيرةٍ ان القضا لن يغلبا",73,"ب",2,0],["حتى إذا حم القضاء اغتاله","نفسي فدا خير الخلائق جعفر",74,"ر",1,0],["حَتّى إِذا حل القَضا","وَتبدّل المغَنى ممرّ",75,"ر",1,0],["حَتّى إِذا حَقّ النَوى","حاوَلت سلوانا تعذّر",76,"ر",1,0],["حتى إذا حاذاه","صكٍّ بها محذاه",77,"ه",1,0],["حتى إذا حدق الخميس بمن بغى","حنقاً وجد به الذي لم يهزل",78,"ل",1,0],["حتى إذا حكت الحبشان شائلةً","دهم العناقيد في لفاءَ خضراء",79,"ا",2,0],["حَتّى إِذا حَلَّ الصَباحُ تَنَفَّسَت","فيها الزُهورُ وَزَقزَقَ العُصفورُ",80,"ر",1,0],["حتى إذا حارتِ الأفكارُ تائهةً","تضاربت في معانيه التعاليم",81,"م",1,0],["حتى إذا حمي الهجير بنا","نصف النهار وحرَّه اتقدَّا",82,"د",2,0],["حتى اذا حمي الوطيس بموقفٍ","شابت لديه مفارقُ الأيام",83,"م",1,0],["حتى إذا حانَ سكرٌ في رؤوسهمُ","مالُوا جميعاً إلى ذات المخانيق",84,"ق",1,0],["حتى إذا حان الوداع ولاح لي","طيف النوى من لوعةٍ وشجونِ",85,"ن",1,0],["حَتَّى إِذَا حُمِّلُوا بِالْعِشْقِ وانْطَلَقُوا","فْلِلْخَلَايا قُلُوبٌ سَوْفَ تَنْتَظِرُ",86,"ر",1,0],["حتى إذا حانَ أمرُ الله واتضحتْ","كبرَى العلامات مما كان مرتقبا",87,"ب",2,0],["حتى إذا حسَمُوا في، القتل أمرهمو","أنجاك من شرهم ربُ السما وحمى",88,"م",2,0],["حتى إذا حط الرحال ارتقى","للنجم فأل واختفي في عجل",89,"ل",1,0],["حتى إذا حط بأحيائنا","شهر كريم فاضل ماجد",90,"د",1,0],["حَتّى إِذا حَمِيَ الْوَطِيسُ بِرَمْلَةٍ","تاهَتْ بَنُو صِهْيونَ في الْأَرْجاءِ",91,"ا",2,0],["حتى إذا حقت حقايقها","وامتاز صدق القول والكذب",92,"ب",1,0],["حَتَّى إِذَا حُجِبَتْ لِلشَّمْسِ شَارِقَةٌ","وَأَطْبَقَتْ حُجَبٌ بِالْكُفْرِ وَالظُّلَمِ",93,"م",1,0],["حتى إذا حان الختام تسارعتْ","خطواتها وارتج طبلُ واحتضر",94,"ر",1,0],["حتّى إذا حان الوداعُ معجلاً","تركوا الفؤاد تمضّهُ الاشواكُ",95,"ك",1,0],["حتى إذا حق المصاب استسلمت","ليد الحوادث أيما استسلام",96,"م",1,0],["حتى إذا حان المخاض بليلة","ليلاء والرقباء عنها نومُ",97,"م",1,0],["حتى إذا حضنت سمائي وجهه","ضحكت له النجمات والأحداقُ",98,"ق",1,0],["حتى إذا حَمِيّتْ وَشُبّ ضِرَامُها","عادتْ عجوزاً غيرَ ذاتِ خليلِ",99,"ل",1,0],["حتى اذا حمي الوطيس فجلْ بها","كالصقر تخشاه الطرائد حائفا",100,"ف",2,0],["حَتَّى إذَا حلَّتْ به نُّوبٌ","واسْتيقنَ الرَّدَى بِمُلتَطِمِ",101,"م",1,0],["حتى إذا حمي الوطيس تخاذلوا","وتنصلوا بئس النصير الخاذل",102,"ل",1,0],["حتى إذا حان القضاء","وفاء بالأمر الحكيم",103,"م",1,0],["حتى إذا حطَّ الصّباح لثامه","ومضى الظلامُ يجرُّ فضلَ ردائه",104,"ا",3,0]]}