{"poems":[[39,"هلا سألت منازلا بالأبرق","https://www.aldiwan.net/poem7239.html","الكامل"],[74,"قالوا وقد زدتني برا وتكرمة","https://www.aldiwan.net/poem20613.html","البسيط"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[71,"يا جامع الحسن أما","https://www.aldiwan.net/poem28853.html","مجزوء الرجز"],[107,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39643","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116960","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[139,"ما بال أصدق وعدها كسراب","https://www.aldiwan.net/poem49142.html","الكامل"],[146,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[170,"وفى السحاب لمغناه وإن خانا","https://www.aldiwan.net/poem46863.html","البسيط"],[170,"يا صخر ما بك هزة لندى","https://www.aldiwan.net/poem47056.html","أحذ الكامل"],[197,"لنا صديق يجيد لقما","https://www.aldiwan.net/poem13154.html","مخلع البسيط"],[358,"ما راح بدر المعالي يمتطي الفلكا","https://www.aldiwan.net/poem40008.html","البسيط"],[385,"وجد له في الحشا دبيب","https://www.aldiwan.net/poem49249.html","مخلع البسيط"],[591,"رأى رضابا عن تسل","https://www.aldiwan.net/poem17852.html","مجزوء الرجز"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124037","البسيط"],[1448,"","https://poetry.dctabudhabi.ae/diwan/poem/144540","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87875","البسيط"],[234,"","https://poetry.dctabudhabi.ae/diwan/poem/52744","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105438","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216663",""],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52078","السريع"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114798","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101821","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93562","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204631","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118807","الكامل"],[3176,"","https://poetry.dctabudhabi.ae/diwan/poem/203960","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121642","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139904","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52992","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91296","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131234",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114473","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58092","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33658","البسيط"],[4830,"حصاد العمر","https://www.poetsgate.com/ViewPoem.aspx?id=195090",""],[5122,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=27210",""],[5187,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=33000",""],[5206,"في الصديق والصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=187434",""],[5216,"النّيل","https://www.poetsgate.com/ViewPoem.aspx?id=186992",""],[5363,"إلى أحد أعضاء مجلس الشورى","https://www.poetsgate.com/ViewPoem.aspx?id=199947",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5431,"اذكر لربك وابقَ العمر متصلا","https://www.poetsgate.com/ViewPoem.aspx?id=192168",""],[5674,"ياسيد الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=186435",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[4623,"للحب تبدو وان تخفى علامات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146688",""],[5864,"تفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=190339",""],[5943,"أماهُ فارثيه( اليتيم)","https://www.poetsgate.com/ViewPoem.aspx?id=50979",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[6139,"قرة العين","https://www.poetsgate.com/ViewPoem.aspx?id=212332",""]],"verses":[["ما ذاق بؤس معيشة ونعيمها","فيما مضى أحد إذا لم يعشقِ",0,"ق",1,0],["ماذا قبضت نهار العشر قلتُ لهم","قبضتُ ميقاتَ موسى من أياديهِ",1,"ه",1,0],["ما ذاق شهداً أجل ولا صَبِراً","من لم يذق شهده ولا صبرَه",2,"ر",2,0],["ما ذاقَ ذو وجدٍ كما","قدْ ذقتُ فيهِ مِنْ كمدْ",3,"د",1,0],["ما ذاق مهلكه أبو جهلٍ ولا","أودى أبو لهبٍ وربُّك يَشهدُ",4,"د",1,0],["ماذا قدومهُما والغيثُ مِدرارُ","لا صاحبُ الدَّارِ طلاَّعٌ ولا الدارُ",5,"ر",1,1],["ما ذاقَ طعم الغنى من لا قنوعَ له","ولن ترى قانِعاً ما عاشَ مفتَقِرا",6,"ر",2,1],["ما ذاق حُلْوَ اللثْم في خَدِّهِ","ولا حنانَ المَسِّ في شَعْرِهِ",7,"ر",2,0],["ما ذاقَ ذو هِرمٍ سلافةَ ريقها","إلاّ وعاد إلى زمانِ شبابِ",8,"ب",1,0],["ما ذاق طعمَ النوم ناظرُهُ","حتى البشيرُ أتاه بالبشِر",9,"ر",1,0],["ما ذاقَ طعمَ الكرى إنسانُ عَيني مُذْ","زفَّ السُّهادُ إليهِ أُمَّ غَيلانا",10,"ن",2,0],["ما ذاقَ خبزَكَ في الورى أحدٌ","للهِ ثُمَّ لخُبزِك العِزَّه",11,"ه",1,0],["ما ذاقَ مِن كَسبِهِ وَلَكِن","أَذى قَفاه أَذاقَ فاه",12,"ه",1,0],["ما ذاقَ طَرفي الكَرى إِلّا لأَجعَلَهُ","لِلطَيف مِنكَ عَلى حُكم الهَوى شركا",13,"ك",2,0],["ما ذاقَ صَفو الدَنا فَصيح","وَرُبَما ملَّهُ حَبيب",14,"ب",1,0],["ما ذاقَهُ وَشاقَهُ","هذا وَمَا كَيْفَ وَلوْ",15,"و",1,0],["ما ذاق قلب محب من هوى العين","ما ذاق قلبى من احدى المرادين",16,"ن",1,1],["ما ذاقها مُتعِّبدٌ","إلاّ وزَلَّ عنِ الصَّواب",17,"ب",1,0],["ما ذاق مرءٌ من الدنيا النعيم بلا","عشق ولا تسعد العشّاقُ إِن تَهِمِ",18,"م",1,0],["ما ذاق مُرَّ معيشةٍ من لم يَذُقْ","مُرَّ التَّفرَّقِ بعد طِيب تلاق",19,"ق",1,0],["ما ذاق طعم فراتهم حتى قضى","عطشاً فغسل بالدماء القانيه",20,"ي",2,0],["مَا ذاق جفني مِنْ لضا الوجد غمضه","فِيْ صورته عَنْ لذة النوم يعتاض",21,"ض",1,0],["ما ذاقَهَا المسكين فِيمَا مَضَى","وَإن تزد شرّها المُنتضى",22,"ض",2,0],["ما ذاقَ طعمَ النّومِ إلا خِلسَةً","بخِلت على أَجفانِه أَن يُكحَلا",23,"ل",2,0],["ماذاقه وأخوه صاد باذلا","نفسا بها لأخيه غير ظنين",24,"ن",1,0],["ما ذاقَها غَير السواك وَلَم يَكُن","يَستاف غَير لثاتها أَقداحها",25,"ح",3,0],["ما ذاق مذ فارق الروض الأريض سوى","حب القلوب ولم يجرع سوى الغصص",26,"ص",1,0],["ما ذاقه ِإلا غريمُ غرامه","وسواهُ ريحُ الكأس لا يُستنشقُ",27,"ق",1,0],["ما ذاق طعم الغنى من لا قنوع له","ولا يرى قانعاً ما عاش منتظرا",28,"ر",2,1],["ما ذَاقَ فيه السُّهْدَ إلاَّ ناظِرٌ","للنَّرْجِسِ الغَضِّ الشَّهِيِّ تَسَهَّدَا",29,"د",2,0],["ما ذاق طعم الماء حتى","صار للأسياف طعمه",30,"م",2,0],["ماذاق إلا شربةً من هجرنا","وكأنّه شربَ الفرات شمولا",31,"ل",2,0],["ماذا قصائدُ شاعرٍ","لو أنه فيها مجيد",32,"د",1,1],["ما ذاقَها ذو حكمة","إِلا تستَّر بالعلن",33,"ن",1,0],["ما ذاق مر العيش فيه فتىً ولا","جرحت يد الحدثان قلب فتاة",34,"ت",3,0],["ما ذاق طعماً للهوى وجنونهِ","حتى يرقَّ لحالَةِ الولهانِ",35,"ن",1,0],["ما ذاقَها باخلٌ إلا وقد سَمَحَتْ","فيها يداه بآلافِ الدوانيقِ",36,"ق",1,0],["ما ذاقَ حسنَ العزاءِ شوقاً","فكيفَ من فارقَ القرينا",37,"ن",2,0],["ما ذاقتْ النفسُ من مرٍّ ومن ألمٍ","قد صار حلواً بعين الله ما كَئُدا",38,"د",2,0],["ما ذاق بالدنيا سعادة وراحه","أيلا استوت كثر الضجيج ،، ومحقها",39,"ق",3,0],["ماذ أقولُ لكلِّ هاجسةٍ هَمَتْ....","تدمي خنايا قلبيَ الخفاقِ",40,"ق",1,0],["مَاذَا قَدِرْتَ فَكَم فِي النَّاسِ مِن رَجُلٍ","قَدْ كَانَ يَعبُدُ غَيرَ اللهِ إشْرَاكَا",41,"ك",2,0],["ما ذاق ماءَكَ زائِرٌ أو سائِحٌ","إلّا وعادَ على الهوى محمولا",42,"ل",2,0],["ماذا قد أنجز تمدحه","ما أخرج فوك سوى الزبدِ",43,"د",1,0],["ما ذاق بارده وحر فؤاده","متوقد مثل الحريق المضرم",44,"م",1,0],["ماذاق قلبك همّ القبر إنْ رُبطت","به الدروب ولا عن نوره ارتحلا",45,"ل",2,0],["ماذا قصدتَ؟ وهل تَرى تلك الإمارة شاغره؟؟","هل أطربت أشعارها تلكَ النجومُ الساهره؟؟",46,"ر",2,0],["ما ذاق طعم النوم قد ضاقت له","نفس بصدر دق باللوعات",47,"ت",1,0],["ما ذاقه احد إلا وضاق به","درعا وليس له تطيب لذات",48,"ت",1,0],["ما ذاقََ مُرَّ الهمِّ مَن","كان الهُدى يَسقِيهِ شَهدَه",49,"د",2,0],["ماذاقَ طعمَ الأسى من عاشَ في ترفٍ","وذاقَهُ حنظلا طفلٌ يعانيهِ",50,"ي",2,0],["ما ذاق هذا الطعمَ طول حياته","بل كان أفقرَ من فقيرٍ أتعسِ",51,"س",1,0],["مَا ذاقَ ذَاكَ العِشقَ لولاعِشْقُها","يَسْري مَعَ الأيّام والأعْوامِ",52,"م",1,0]]}