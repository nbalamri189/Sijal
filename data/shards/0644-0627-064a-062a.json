4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18988","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[4755,"جُرحُ المَجَانِين","https://www.poetsgate.com/ViewPoem.aspx?id=184072",""],[4830,"يامُهجةَ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=203676",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[5148,"هذي عروسك أنت !","https://www.poetsgate.com/ViewPoem.aspx?id=187252",""],[5717,"وهل قرأت من كتاب النفس ما","https://www.poetsgate.com/ViewPoem.aspx?id=170602",""],[5956,"يستلهم الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=182395",""],[5956,"حالُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=192358",""],[5956,"ضمُّ أحفادي لصدري","https://www.poetsgate.com/ViewPoem.aspx?id=193147",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[5956,"أرتين قد بدأ المسير مهللا","https://www.poetsgate.com/ViewPoem.aspx?id=205422",""]],"verses":[["لا يُتبِعُ المالَ أَنفاساً مُصاعَدَةً","وَلا يُعيرُ العَطايا زَفرَةَ النَدَمِ",0,"م",1,0],["لا يَتعَبُ العاذِلُ في حُبِّهِم","قَد ذَهَبَ السَهمُ بِقَلبِ الرَمي",1,"م",2,0],["لا يَتَّقي الشَمسَ الظَهائِرَ إِن سَرى","إِلّا بِظِلِّ قَناً وَعارِضِ عِثيَرِ",2,"ر",1,0],["لا يَتَنَمّى لَها بِالقَيظِ يَركَبُها","إِلّا الَّذينَ لَهُم فيما أَتَوا مَهَلُ",3,"ل",1,0],["لا يَتَّقي في الوَغى وَقعَ الأَسِنَّةِ بِا","لزَغفِ الدلاصِ كَفاهُ سَيفُهُ وَزَرا",4,"ر",2,0],["لا يَتَّصِلنَ إِذا اِفتَخَرنَ بِتَغلِبٍ","وَرُزِقنَ زُخرُفَ نِعمَةٍ وَجَمالا",5,"ل",2,0],["لا يَتَدَاوَى بِنَزلَةٍ منهمُ ال","مُدنَفُ من هَيضَةِ الكَرَى الوَصِبُ",6,"ب",1,0],["لا يتداوى بنزلة منهم المد","نو من هيضة الكرى والوصب",7,"ب",1,0],["لايَترُقِ النازِلُ المَحذورُ ساحَتَهُ","وَلا تَمُدُّ إِلَيهِ الحادِثاتُ يَدا",8,"د",2,0],["لا يتَّقي في جميلٍ هولَ مُرتكَبٍ","إذا اتَّقى في رَغيبٍ قُبْحَ مُرتكَبِ",9,"ب",1,0],["لا يتقين بأيديهن مس يدٍ","لكن بأرجلِ سمحاتٍ مطاويع",10,"ع",1,0],["لا يتبع الصفوة لي بالقذى","ولا الطمأنينة بالفزعه",11,"ع",2,0],["لا يترك الحق مغبوناً لسائمه","خسفاً ولا يتعدى الحق حيّافا",12,"ف",2,0],["لا يتّقي شرَّ العيونِ","ولا يخافُ الألسنا",13,"ن",2,0],["لا يَتَّخِذنَ إِذا عَلَونَ مَفازَةً","إِلّا بَياضَ الفَرقَدَينِ دَليلا",14,"ل",2,0],["لا يَتَشَكَّينَ مِنَ الكَلالِ","وَلا يُحاذِرنَ مِنَ الضَلالِ",15,"ل",1,0],["لايَتَوَقّى أَبو العَشائِرِ مِن","لَبسِ مَعاني الوَرى بِمَعناهُ",16,"ا",2,0],["لا يَتَحَظّى كَما اِحتَجَّ البَخيلُ وَلا","يُحِبُّ مِن مالِهِ إِلّا الَّذي يَهِبُ",17,"ب",1,0],["لا يُتعِبُ النائِلُ المَبذولُ هِمَّتَهُ","وَكَيفَ يُتعِبُ عَينَ الناظِرِ النَظَرُ",18,"ر",1,0],["لا يَتَأَنّى العَدُوَّ يُمهِلُهُ","وَلا يُبادي الصَديقَ يَمتَهِنُه",19,"ن",2,0],["لا يَتَّقي إِن أَمكَنَتهُ فُرصَةٌ","دُوَلَ الزَمانِ نَظارِ قالَ نَظارِ",20,"ر",1,0],["لا يتّقي العُدْمَ في وِرْدٍ ولا صَدَرٍ","مَنْ صافَحَتْ كفَّه من كفّه ذِمَمُ",21,"م",1,0],["لا يتَّقي في الضَّربِ سَيْفُكَ مِغْفَراً","فله من القَدَرِ المُطاعِ غِرَارُ",22,"ر",1,0],["لا يَتَخَطّاهُ الطَرفُ مِن أَحَدٍ","يُنصِفُ إِلّا صَلّى عَلى صَنَعِه",23,"ع",2,0],["لا يتمُّ السهمُ إلاّ","ولهُ نصلٌ وريشُ",24,"ش",1,0],["لا يتَّقي الرَّوعَ إن صَاحَ النذيرُ ولا","يُلقي إلى السّيفِ يوماً بالمعاذيرِ",25,"ر",1,0],["لا يَتَّقي بَطشَ الظَلومِ إِذا اِنتَحى","وَأَشاحَ في هَبَواتِهِ يَتَوَثَّبُ",26,"ب",1,0],["لا يَتَّقيهِ هارِبٌ بِفَوتِ","سَهمٌ مُصيبٌ كُلَّما رَمَيتِ",27,"ت",1,0],["لا يَتَطَيَّر بِناعِبٍ أَحَدٌ","فَكُلُّ ما شاهَدَ الفَتى طِيَرَه",28,"ر",2,0],["لا يَترُكَنَّ قَليلَ الخَيرِ يَفعَلُهُ","مَن نالَ في الأَرضِ تَأيِيداً وَتَمكينا",29,"ن",2,0],["لا يُتبِعُ المَنَّ ما جادَت يَداهُ بِهِ","وَلا تُحَكَّمُ في مَعروفِهِ العِلَلُ",30,"ل",1,0],["لا يتوقى أبو العشائر من","ليس معاني الورى بمعناه",31,"ا",2,0],["لا يَتَأَرَّونَ في المضيقِ وإن","نادَى الُمنادي أَن أَنزِلوا نَزَلُوا",32,"ل",3,0],["لا يَتْرُكُ الْحُبُّ قَلْبِي مِنْ لَواعِجِهِ","كَأَنَّمَا بَيْنَ قَلْبِي وَالْهَوَى نَسَبُ",33,"ب",1,0],["لاَ يَتْرُكُ الْجَارِي عَلَيْهِ حُكْمَهُ","إِلاَّ لِيُدْرِكَهُ الْقَضَاءُ الْجَارِي",34,"ر",2,0],["لا يترجَّى فَكَّ رقٍّ ولا","يُخشى عليه مُوبِقاتُ الإباق",35,"ق",1,0],["لا يتنمى لها بالقيظ يركبها","إلا الذين لهم فيها أتوا مهل",36,"ل",1,0],["لا يتعدى امرؤ جبلته","قد قسمت في الطبيعة الرتب",37,"ب",1,0],["لا يَتبع العينَ قلبي وهي تابعةٌ","وكيف طاعةُ ذى أمرٍ لمأمورِ",38,"ر",1,0],["لا يترجَّى الضيفُ إمراعَهُ","ولا يخاف الجارُ إمحالَهْ",39,"ل",2,0],["لا يتوارى ضميرِّ عن سريرته","كأنما ظنُّه للغيب مِسبارُ",40,"ر",1,0],["لا يتقي يوم النزال باسه","ولا يرد قوله يوم الجدل",41,"ل",1,0],["لا يَتَّقي بَأَسَهُ الأَبطالُ يَومَ وَغىً","إِلّا بِعَقدِ ذِمامٍ مِنهُ أَو هَرَبِ",42,"ب",1,0],["لا يَتَّقي اللَهَ العَلِيَّ وَلا يَرى","لِشَقائِهِ الفِعلَ الجَميلَ جَميلا",43,"ل",2,0],["لا يترك الإنسان أخلاقه","طوعا ولو شدّ بأمراس",44,"س",1,0],["لا يَتعَبُ الحَكَمُ حتى تَستَبينَ لَهُ","مَواقِعُ الحَقِّ إِنَّ القاضِيَ الفَهِمُ",45,"م",1,0],["لا يتبعون الهاربين وانهم","لشد حربا من حروب التبع",46,"ع",1,0],["لا يَتَّقي وَلا يَخا","فُ غيلَةً فَيَتَّقي",47,"ق",2,0],["لا يَتَواصَونَ بِأَمرٍ بِمَع","روفٍ وَلا يَنهونَ عَن مُنكَرِ",48,"ر",1,0],["لا يتَّقون قُبحا","ولا يَعونَ نُصحا",49,"ح",2,0],["لاَ يَتَأرّى لِمَأ في القِدْرِ يَرْقبُهُ","ولا يَعَضّ على شُرسُوفِهِ الصَّفَرُ",50,"ر",1,0],["لا يتمن السيف عند الحق أسرتها","ولا يبيتُ على أعناقها قسمُ",51,"م",1,0],["لا يَتْبعَنَّ المرءَ ذو رِيَبٍ","عُرِفَتْ فكم من تابعٍ يَصِم",52,"م",1,0],["لا يتعبن من أتاك ينصرها","بمدحه فالنقيض يَخذلُها",53,"ل",3,0],["لا يتَّقي في الله لومة لائمٍ","خصم الأَعادي والعدوُّ الأكبرُ",54,"ر",1,0],["لا يتجافاني بذنب واحد","كل حبر عالم في الناس زلّا",55,"ل",2,0],["لا يتبع الجور أذى مثل ما","يتبعه الغير وطول المطال",56,"ل",1,0],["لا يتوقَّى عُورَها وعُضْبها","مَن عيَّف الأعيُنَ والقُرونا",57,"ن",2,0],["لا يتمشَّون الضَّرَاء غيلةً","لجارِهم ولا يدِبُّون الخَمَرْ",58,"ر",1,0],["لا يُتهِمُ الليلُ عليها فجرَهُ","ولا يَخافُ عدوةَ العوادي",59,"د",2,0],["لا يتمنَّون على حظوظهم","أن يَجِدُوا دنيا إذا لم يُجدُوا",60,"د",3,0],["لا يتجافى عن السؤال ولا","تدعوهُ أخلاقهُ إلى الملل",61,"ل",1,0],["لا يتأرى لما في القدر يرقبه","ولا بعض على شرسوفه الصفر",62,"ر",1,0],["لا يتركون ذُرى الأسرّة عزّةً","إِلّا إِذا رَكبوا ظهورَ جيادِ",63,"د",1,0],["لا يترُكُ البينُ قلباً غيرَ مُنكسِرٍ","مِنَّا ولا دمعَ عينٍ غيرَ مسكوبِ",64,"ب",1,0],["لايَتَّقِي مَلِكاً ولا أَسَداً ولا","شِبلاً فهذا الشِّبلُ أَدَركَهُ الرَدَى",65,"د",2,0],["لا يَترُكُ الدَّهرُ عيناً لا دُموعَ بها","ولا دُمُوعاً بلا مَسحٍ يُؤاتيها",66,"ي",3,0],["لا يَترُكُ البَينُ عيناً غيرَ باكيةٍ","وليسَ يَترُكُ قلباً غيرَ مُنكسرِ",67,"ر",1,0],["لا يَتهِ جَوْهَرُ العُقودِ ولا يش","مَخْ عَلَيْها فالوَجْه والثَّغْر جَوْهَرْ",68,"ر",1,0],["لا يَتَناهَى مِنَ العُلُوِّ فَلَو","قُنِّعَ بالخافِقَينِ ما قَنِعا",69,"ع",2,0],["لا يتقي اجفانها","ضافي الدروع ولا المغافر",70,"ر",1,0],["لا يَتَّقِي رَمَدَ النَّوَائِبِ ناظِرٌ","يُجْلَى بِمِرْوَدِ صَفْحَتَيْهِ وَيُكْحَلُ",71,"ل",1,0],["لا يتركون غليلاً في قلوبهمُ","وفي بطونهمُ سم الثعابين",72,"ن",1,0],["لا يترك اللذات وهي مذلة","ومتى تعز النفس وهو ذليل",73,"ل",1,0],["لا يتبعُ الفَشَلُ المِفرارُ يِقتلهُ","إِنّ الفرارَ لَعارٌ فيهِ يَكفيهِ",74,"ي",2,0],["لا يتطاول منكباً","على التعدي من كَبا",75,"ب",2,0],["لا يتبع المن منا حين يبذله","ولا يشوب صفاء منه تكديرُ",76,"ر",1,0],["لا يتركان من ذنوبي إثماً","وأنت من أرجو ومن أخشاه",77,"ه",1,0],["لا يُتّبع المَنَّ منه موهبةً","يَبدؤها قبلُ أَو يُعيّدُهَا",78,"د",3,0],["لا يتركون لشخص","إن غاب عظما ولحما",79,"م",2,0],["لا يتقي اللوم في شوط السماحة وال","تقوى ولو صارت الأملاك لوّاما",80,"م",2,0],["لا يتقي لهب البارود منحدراً","كالسيل يفتق جيب الليل بالشرر",81,"ر",1,0],["لا يتَّقُونَ المنايا جنده فَرَقاً","إذا همو لِقرَى الأعداءِ قد رَكَضُوا",82,"ض",3,0],["لا يتأرّون في المضيق وإن","نادى منادٍ أن انزلوا نزلوا",83,"ل",3,0],["لا يتبع المال طرفاً حين يَبْذُلُه","ولا يكدّر صفو الجود بالمنن",84,"ن",1,0],["لا يتباح حمى له خفرٌ","ويموت دون عرينه الأسد",85,"د",1,0],["لا يَترُكِ اللَهُ أَنفاً تَعطِسونَ بِها","بَني العُبَيدِ شُهوداً غَيرَ غُيّابِ",86,"ب",1,0],["لا يترك الدينارُ ساحةَ كَفَّهِ","حتى ينادى أنتَ رزٌ فلان",87,"ن",1,0],["لا يتبع إذا العقل اتبع","حد الكلام وما افاد المستمع",88,"ع",1,0],["لا يتبع المال مناً حين ينفقه","والمنُّ بالجود نجل المرء والمنن",89,"ن",1,0],["لأيتها قولوا أبو الطيب انتمى","وقد قال ما أملت عليه سماء",90,"ا",2,0],["لا يتركون اللوم لو قد متا","مع أن حبَّ أهل سلعٍ عذرى",91,"ر",2,0],["لا يتْركُ الحزْمَ اللبيبُ الأكْيَسُ","أن تَرِدَ الماءَ بماءٍ أكْيَسُ",92,"س",1,0],["لا يتناهونَ بِها عن باطلِ","وكلُّهُم بالحقّ غيرُ عامِل",93,"ل",1,0],["لا يَتعاطى سَعى العَلاءِ أَبي","سعدٍ نجيبٌ الاَّ كَبا وَنَبَا",94,"ب",2,0],["لا يتركونَ من التلا","دِ لوارثٍ الا المآثرْ",95,"ر",1,0],["لا يَتلافى المُشْفِي على عَطَبهِ","وعاسلاتُ الرماحِ تحْدِقُ بِهْ",96,"ب",2,1],["لا يترك الله داراً ليس يتحفها","من الورى بكريم يكشف الكربا",97,"ب",2,0],["لا يَتقون سِوى الهَوى إِلا الكَما","لَ وَما لهم غَيرَ الفَكاهةِ مطمح",98,"ح",1,0],["لا يَتقي بَأس الفَتى","إِلا إِذا هَزَّ العلم",99,"م",1,0],["لا يَترك اللَه ثاري","يا مَن أَبحتَ دمائي",100,"ي",1,1],["لا يتغير أن ولى","عن الوداد الأول",101,"ل",1,0],["لا يُتركُ الوطنُ القريب لمنزلٍ","شحط ويُصَرم للحديث الأقدم",102,"م",1,0],["لا يتبعون عطاءهم","وصنايع المعروف في من",103,"ن",1,0],["لا يترك العبد وما شاءه","إلا إذا أهمله المولى",104,"ل",2,0],["لا يتناهى فَيْضُ معروفِه","وأَيُّ بحرٍ ما لَهُ سحلُ",105,"ل",1,0],["لا يَترُكُنَ أَخاهُم في مُوَدَّأَةٍ","يَسفى عَلَيهِ دَليكُ الذِلِّ وَالعارِ",106,"ر",1,0],["لا يَتَّقي الطَّعن إِلا أَن يَصدَّكُما","صَدَّت كَريمَةُ قَومٍ أُسمِعَت هجرا",107,"ر",2,0],["لا يَترُكُ الإِنسَانُ شيئًا إِذا","لَم يَأبَهُ إِلَّا لِشَيءٍ أَهَم",108,"م",1,0],["لايتّّقِ الصّبُّ اِلاّ بَوْحَ أدمُعِهِ","فرُبّ طرفُ الفتى يُنبيكَ أسرارا",109,"ر",2,0],["لا يتعب الفكر في ادراك غايته","ويرفض السمع بالإنشاد تلحينا",110,"ن",2,0],["لا يتركُ الحُرُّ للباغينَ حُرْمَتَهُ","هذي بلادُكَ أنتَ الآنَ .. عِشْ فيها!",111,"ي",3,0],["لا يتجسد الإله إذ فسا","د الكون والتركيب أي ملزم",112,"م",1,0],["لا يترك اللمس لا يألو مداعبة","لِلَحْمك البضِّ في أعماق كعبتِهِ",113,"ت",2,0],["لا يتركون مواقعاً وطنيةً","إلا بأتعسِ حالةٍ وشرورِ",114,"ر",1,0],["لا يتم الحُبُّ إلا أن أراهم","كلَّهم حولي إلى يومِ لحودي",115,"د",2,0],["لا يترك الله إنساناً بلا سَقَمٍ","حتى يُسَجّى ويلقَى وضعَ مقبورِ",116,"ر",1,0],["لا يتركان أذية بجواره","تهوي عليه، وأحسنا التدبيرا",117,"ر",2,0]]}