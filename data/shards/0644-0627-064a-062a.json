{"poems":[[53,"أحق من كانت النعماء سابغة","https://www.aldiwan.net/poem29814.html","البسيط"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[71,"عجبت للطيف يا لمياء حين سرى","https://www.aldiwan.net/poem4012.html","البسيط"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[47,"ياطول شوقي إن قالوا الرحيل غدا","https://www.aldiwan.net/poem25299.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"لخالد بيت سوء مثل ساكنه","https://www.aldiwan.net/poem65074.html","البسيط"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[91,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[43,"قالوا ألم تكنه فقلت لهم","https://www.aldiwan.net/poem10600.html","المنسرح"],[45,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[45,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[28,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[69,"إن يطش بعض كلامي","https://www.aldiwan.net/poem28849.html","مجزوء الرمل"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[105,"بعد التحية والكرامة كلها","https://www.aldiwan.net/poem43109.html","الكامل"],[52,"يا كف ما حيت إذ غدوت","https://www.aldiwan.net/poem27189.html","الرجز"],[46,"من عاش سبعين فهو في نصب","https://www.aldiwan.net/poem22637.html","المنسرح"],[46,"يا قوت ما أنت ياقوت ولا ذهب","https://www.aldiwan.net/poem23479.html","البسيط"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140946",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21000","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[139,"ما كل من شم نال رائحة","https://www.aldiwan.net/poem3684.html","الطويل"],[142,"هل في جنوب اللوى وجد فأطربه","https://www.aldiwan.net/poem58378.html","البسيط"],[142,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[142,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[160,"لي منكم يا كهف الملوك والدول","https://www.aldiwan.net/poem58757.html","الرجز"],[169,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[169,"ما شئتما يا صاحبي فقولا","https://www.aldiwan.net/poem1656.html",""],[186,"أقلل من الخلطة للناس","https://www.aldiwan.net/poem43727.html","السريع"],[195,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[210,"ذكر الغنا فحنت عليه أضلعي","https://www.aldiwan.net/poem13297.html","الكامل"],[235,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[235,"كم أنفق الأيام في خدمة","https://www.aldiwan.net/poem31922.html","السريع"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[331,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[355,"يا ويح ناجة ما هذا الذي زعمت","https://www.aldiwan.net/poem61024.html","البسيط"],[364,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[377,"نفس غدت قد عصاك أسهلها","https://www.aldiwan.net/poem59283.html","المنسرح"],[416,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[437,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[437,"يا مانعي النوم بقطع الوصال","https://www.aldiwan.net/poem2583.html","السريع"],[458,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[458,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[458,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[458,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[485,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[551,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[562,"زر قبر جرجي الغلام اللاذقي سحرا","https://www.aldiwan.net/poem52534.html","البسيط"],[562,"لو أنصف الراثي وسار على هدى","https://www.aldiwan.net/poem52821.html","الكامل"],[562,"اليوم ربك أعطى القوس باريها","https://www.aldiwan.net/poem52826.html","البسيط"],[562,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[575,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["لا يُتبِعُ المالَ أَنفاساً مُصاعَدَةً","وَلا يُعيرُ العَطايا زَفرَةَ النَدَمِ",0,"م",1,0],["لا يَتعَبُ العاذِلُ في حُبِّهِم","قَد ذَهَبَ السَهمُ بِقَلبِ الرَمي",1,"م",2,0],["لا يَتَّقي الشَمسَ الظَهائِرَ إِن سَرى","إِلّا بِظِلِّ قَناً وَعارِضِ عِثيَرِ",2,"ر",1,0],["لا يَتَنَمّى لَها بِالقَيظِ يَركَبُها","إِلّا الَّذينَ لَهُم فيما أَتَوا مَهَلُ",3,"ل",1,0],["لا يَتَّقي في الوَغى وَقعَ الأَسِنَّةِ بِا","لزَغفِ الدلاصِ كَفاهُ سَيفُهُ وَزَرا",4,"ر",2,0],["لا يَتَّصِلنَ إِذا اِفتَخَرنَ بِتَغلِبٍ","وَرُزِقنَ زُخرُفَ نِعمَةٍ وَجَمالا",5,"ل",2,0],["لا يَتَدَاوَى بِنَزلَةٍ منهمُ ال","مُدنَفُ من هَيضَةِ الكَرَى الوَصِبُ",6,"ب",1,0],["لا يتداوى بنزلة منهم المد","نو من هيضة الكرى والوصب",7,"ب",1,0],["لايَترُقِ النازِلُ المَحذورُ ساحَتَهُ","وَلا تَمُدُّ إِلَيهِ الحادِثاتُ يَدا",8,"د",2,0],["لا يتَّقي في جميلٍ هولَ مُرتكَبٍ","إذا اتَّقى في رَغيبٍ قُبْحَ مُرتكَبِ",9,"ب",1,0],["لا يتقين بأيديهن مس يدٍ","لكن بأرجلِ سمحاتٍ مطاويع",10,"ع",1,0],["لا يتبع الصفوة لي بالقذى","ولا الطمأنينة بالفزعه",11,"ع",2,0],["لا يترك الحق مغبوناً لسائمه","خسفاً ولا يتعدى الحق حيّافا",12,"ف",2,0],["لا يتّقي شرَّ العيونِ","ولا يخافُ الألسنا",13,"ن",2,0],["لا يَتَّخِذنَ إِذا عَلَونَ مَفازَةً","إِلّا بَياضَ الفَرقَدَينِ دَليلا",14,"ل",2,0],["لا يَتَشَكَّينَ مِنَ الكَلالِ","وَلا يُحاذِرنَ مِنَ الضَلالِ",15,"ل",1,0],["لايَتَوَقّى أَبو العَشائِرِ مِن","لَبسِ مَعاني الوَرى بِمَعناهُ",16,"ا",2,0],["لا يَتَحَظّى كَما اِحتَجَّ البَخيلُ وَلا","يُحِبُّ مِن مالِهِ إِلّا الَّذي يَهِبُ",17,"ب",1,0],["لا يُتعِبُ النائِلُ المَبذولُ هِمَّتَهُ","وَكَيفَ يُتعِبُ عَينَ الناظِرِ النَظَرُ",18,"ر",1,0],["لا يَتَأَنّى العَدُوَّ يُمهِلُهُ","وَلا يُبادي الصَديقَ يَمتَهِنُه",19,"ن",2,0],["لا يَتَّقي إِن أَمكَنَتهُ فُرصَةٌ","دُوَلَ الزَمانِ نَظارِ قالَ نَظارِ",20,"ر",1,0],["لا يتّقي العُدْمَ في وِرْدٍ ولا صَدَرٍ","مَنْ صافَحَتْ كفَّه من كفّه ذِمَمُ",21,"م",1,0],["لا يتَّقي في الضَّربِ سَيْفُكَ مِغْفَراً","فله من القَدَرِ المُطاعِ غِرَارُ",22,"ر",1,0],["لا يَتَخَطّاهُ الطَرفُ مِن أَحَدٍ","يُنصِفُ إِلّا صَلّى عَلى صَنَعِه",23,"ع",2,0],["لا يتمُّ السهمُ إلاّ","ولهُ نصلٌ وريشُ",24,"ش",1,0],["لا يتَّقي الرَّوعَ إن صَاحَ النذيرُ ولا","يُلقي إلى السّيفِ يوماً بالمعاذيرِ",25,"ر",1,0],["لا يَتَّقي بَطشَ الظَلومِ إِذا اِنتَحى","وَأَشاحَ في هَبَواتِهِ يَتَوَثَّبُ",26,"ب",1,0],["لا يَتَّقيهِ هارِبٌ بِفَوتِ","سَهمٌ مُصيبٌ كُلَّما رَمَيتِ",27,"ت",1,0],["لا يَتَطَيَّر بِناعِبٍ أَحَدٌ","فَكُلُّ ما شاهَدَ الفَتى طِيَرَه",28,"ر",2,0],["لا يَترُكَنَّ قَليلَ الخَيرِ يَفعَلُهُ","مَن نالَ في الأَرضِ تَأيِيداً وَتَمكينا",29,"ن",2,0],["لا يُتبِعُ المَنَّ ما جادَت يَداهُ بِهِ","وَلا تُحَكَّمُ في مَعروفِهِ العِلَلُ",30,"ل",1,0],["لا يتوقى أبو العشائر من","ليس معاني الورى بمعناه",31,"ا",2,0],["لا يَتَأَرَّونَ في المضيقِ وإن","نادَى الُمنادي أَن أَنزِلوا نَزَلُوا",32,"ل",3,0],["لا يَتْرُكُ الْحُبُّ قَلْبِي مِنْ لَواعِجِهِ","كَأَنَّمَا بَيْنَ قَلْبِي وَالْهَوَى نَسَبُ",33,"ب",1,0],["لاَ يَتْرُكُ الْجَارِي عَلَيْهِ حُكْمَهُ","إِلاَّ لِيُدْرِكَهُ الْقَضَاءُ الْجَارِي",34,"ر",2,0],["لا يترجَّى فَكَّ رقٍّ ولا","يُخشى عليه مُوبِقاتُ الإباق",35,"ق",1,0],["لا يتنمى لها بالقيظ يركبها","إلا الذين لهم فيها أتوا مهل",36,"ل",1,0],["لا يتعدى امرؤ جبلته","قد قسمت في الطبيعة الرتب",37,"ب",1,0],["لا يَتبع العينَ قلبي وهي تابعةٌ","وكيف طاعةُ ذى أمرٍ لمأمورِ",38,"ر",1,0],["لا يترجَّى الضيفُ إمراعَهُ","ولا يخاف الجارُ إمحالَهْ",39,"ل",2,0],["لا يتوارى ضميرِّ عن سريرته","كأنما ظنُّه للغيب مِسبارُ",40,"ر",1,0],["لا يتقي يوم النزال باسه","ولا يرد قوله يوم الجدل",41,"ل",1,0],["لا يَتَّقي بَأَسَهُ الأَبطالُ يَومَ وَغىً","إِلّا بِعَقدِ ذِمامٍ مِنهُ أَو هَرَبِ",42,"ب",1,0],["لا يَتَّقي اللَهَ العَلِيَّ وَلا يَرى","لِشَقائِهِ الفِعلَ الجَميلَ جَميلا",43,"ل",2,0],["لا يترك الإنسان أخلاقه","طوعا ولو شدّ بأمراس",44,"س",1,0],["لا يَتعَبُ الحَكَمُ حتى تَستَبينَ لَهُ","مَواقِعُ الحَقِّ إِنَّ القاضِيَ الفَهِمُ",45,"م",1,0],["لا يتبعون الهاربين وانهم","لشد حربا من حروب التبع",46,"ع",1,0],["لا يَتَّقي وَلا يَخا","فُ غيلَةً فَيَتَّقي",47,"ق",2,0],["لا يَتَواصَونَ بِأَمرٍ بِمَع","روفٍ وَلا يَنهونَ عَن مُنكَرِ",48,"ر",1,0],["لا يتَّقون قُبحا","ولا يَعونَ نُصحا",49,"ح",2,0],["لاَ يَتَأرّى لِمَأ في القِدْرِ يَرْقبُهُ","ولا يَعَضّ على شُرسُوفِهِ الصَّفَرُ",50,"ر",1,0],["لا يتمن السيف عند الحق أسرتها","ولا يبيتُ على أعناقها قسمُ",51,"م",1,0],["لا يَتْبعَنَّ المرءَ ذو رِيَبٍ","عُرِفَتْ فكم من تابعٍ يَصِم",52,"م",1,0],["لا يتعبن من أتاك ينصرها","بمدحه فالنقيض يَخذلُها",53,"ل",3,0],["لا يتَّقي في الله لومة لائمٍ","خصم الأَعادي والعدوُّ الأكبرُ",54,"ر",1,0],["لا يتجافاني بذنب واحد","كل حبر عالم في الناس زلّا",55,"ل",2,0],["لا يتبع الجور أذى مثل ما","يتبعه الغير وطول المطال",56,"ل",1,0],["لا يتوقَّى عُورَها وعُضْبها","مَن عيَّف الأعيُنَ والقُرونا",57,"ن",2,0],["لا يتمشَّون الضَّرَاء غيلةً","لجارِهم ولا يدِبُّون الخَمَرْ",58,"ر",1,0],["لا يُتهِمُ الليلُ عليها فجرَهُ","ولا يَخافُ عدوةَ العوادي",59,"ي",1,0],["لا يتمنَّون على حظوظهم","أن يَجِدُوا دنيا إذا لم يُجدُوا",60,"د",3,0],["لا يتجافى عن السؤال ولا","تدعوهُ أخلاقهُ إلى الملل",61,"ل",1,0],["لا يتأرى لما في القدر يرقبه","ولا بعض على شرسوفه الصفر",62,"ر",1,0],["لا يتركون ذُرى الأسرّة عزّةً","إِلّا إِذا رَكبوا ظهورَ جيادِ",63,"د",1,0],["لا يترُكُ البينُ قلباً غيرَ مُنكسِرٍ","مِنَّا ولا دمعَ عينٍ غيرَ مسكوبِ",64,"ب",1,0],["لايَتَّقِي مَلِكاً ولا أَسَداً ولا","شِبلاً فهذا الشِّبلُ أَدَركَهُ الرَدَى",65,"د",2,0],["لا يَترُكُ الدَّهرُ عيناً لا دُموعَ بها","ولا دُمُوعاً بلا مَسحٍ يُؤاتيها",66,"ي",3,0],["لا يَترُكُ البَينُ عيناً غيرَ باكيةٍ","وليسَ يَترُكُ قلباً غيرَ مُنكسرِ",67,"ر",1,0],["لا يَتهِ جَوْهَرُ العُقودِ ولا يش","مَخْ عَلَيْها فالوَجْه والثَّغْر جَوْهَرْ",68,"ر",1,0]]}