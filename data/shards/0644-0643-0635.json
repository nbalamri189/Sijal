{"poems":[[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[53,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[132,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[201,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[422,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120042","الكامل"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119100","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64692","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136147","الخفيف"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146945","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79479","الخفيف"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136777",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125470","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137081",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137070",""],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93454","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132638","الخفيف"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105573","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86478","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33548","الخفيف"],[4621,"","https://poetry.dctabudhabi.ae/diwan/poem/97651","الخفيف"],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[5012,"في ها البحر غرق","https://www.poetsgate.com/ViewPoem.aspx?id=34961",""],[5213,"يا دار يومك بالغميم محجل","https://www.poetsgate.com/ViewPoem.aspx?id=170533",""],[5756,"كلمة حق","https://www.poetsgate.com/ViewPoem.aspx?id=5380",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[5956,"سأكون دون إقامة وأبورُ","https://www.poetsgate.com/ViewPoem.aspx?id=204590",""],[5976,"قمراي","https://www.poetsgate.com/ViewPoem.aspx?id=30350",""],[6144,"الورد","https://www.poetsgate.com/ViewPoem.aspx?id=13695",""]],"verses":[["لَكَ صالِحُ الأَعمالِ إِذ شَيَّعتَها","بِالبِرِّ ساعَةَ تُعرَضُ الأَعمالُ",0,"ل",1,0],["لك صفو المديح والشكر مني","في نظام وصلته بنظامِ",1,"م",1,0],["لك صِدْقُ وعدِ اللّهِ في فُرقَانِهِ","لا ما يقولُ الجاهلونَ الضُّلَّل",2,"ل",1,0],["لك صارمٌ عضبٌ تقدُّ","به الجماجمَ والجسوما",3,"م",2,0],["لك صغتها ورفتها","لمقامك السامي الكريم",4,"م",1,0],["لك صدر طاهر من دنس","عن مياه الحقد طبعاً صدرا",5,"ر",2,0],["لك صروة الشمس المنيرة جالسا","وإذا ركبت فسورة الضرغام",6,"م",1,0],["لك صولات على قل","بي بقد كالرديني",7,"ن",2,0],["لكَ صَولَةُ الأسَدُ الهُصُو","رِ ونَفْرَةُ الرَّشَأِ الرَّبيبِ",8,"ب",1,0],["لك صدق وأنت حق وفيك","الوصف يبدو بما إليك يروح",9,"ح",1,0],["لك صورة ذل الجمال لحسنها","تقضي بجور في النفوس وتحكم",10,"م",1,0],["لكَ صدغٌ كأنَّهُ قلبُ فرعو","نَ ووجهٌ كأنَّهُ يَدُ موسى",11,"س",2,1],["لك صدرٌ بالعلى رحبٌ","غير علم الله ما وسعا",12,"ع",2,0],["لك صولةٌ قد حَكَّمَت","في مهجةِ الأسَدِ الغَزَال",13,"ل",1,0],["لك صفحة بيضاء في تاريخه","هي من سنا الشمس المنيرة انصع",14,"ع",1,0],["لك صفحة بيضاء في تاريخه","تتلى تلاوة معجز الفرقان",15,"ن",1,0],["لَكَ صَولاتٌ عَلى قَل","بي دَليلاتٌ لحيني",16,"ن",2,0],["لك صعب العلاء عاد ذلولا","وعلى طالبي مداك شموسا",17,"س",2,0],["لك صهوة المجد التي لا ترتقي","بالفكر نفاذاً ولا بالسلم",18,"م",1,0],["لك صدغان فوق خديك لاحا","مثلما التف بالشقيق بنفسج",19,"ج",1,1],["لكَ صبرٌ تسلُو بهِ ولقلبي","حُرَقٌ مستديمةٌ وغرامُ",20,"م",1,0],["لك صدغ كأنما","نونه نون كاتب",21,"ب",1,0],["لك صمُّ الصُّخور لانت بمشيٍ","فوقها لا الرِّمال والبطحاء",22,"ا",2,0],["لك صاحبٍ ما خاف في هالبحر غرق","وكل البحور اللي تغرق فباله",23,"ل",2,0],["لك صيغ يا ظبي النقا من نرجس","طرف ومن نور الاقاح مقبل",24,"ل",1,0],["لك صرح حافل بالمحبه ولازال","وان بادت صروح الغلا منت بايد",25,"د",1,0],["لَكِ صُورَةٌ مَثُلَتْ وليسَ مَثيلَها","مَثُلَتْ فَسُبحانَ الذي سَوّاكِ",26,"ك",1,0],["لك صورة في مقلتي وضّاحةٌ","مهْما يَجُرْ ليلي ففيها النّورُ",27,"ر",1,0],["لك صاحب ٍ باغلى ثمن شرّاي","يشري غرامك .. ما يبيعك يوم",28,"م",1,0],["لك صنعه في العين والحاجب بيها تتعاجب","وتقول وجود الله واجب مين بيه يكفر",29,"ر",1,0]]}