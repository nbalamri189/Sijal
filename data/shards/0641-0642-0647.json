{"poems":[[79,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[47,"قم تأمل بنا عجائب دهر","https://www.aldiwan.net/poem65226.html","الخفيف"],[68,"قد نشر الزنبق أعلامه","https://www.aldiwan.net/poem38807.html","السريع"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[318,"فقهاؤنا كذبالة النبراس","https://www.aldiwan.net/poem59491.html","الكامل"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[438,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[563,"فاز الذي شرب الشراب الصافي","https://www.aldiwan.net/poem33540.html","الكامل"],[563,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64091","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27778","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76089","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36715","المنسرح"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40097","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111517","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111402","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104529","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120398","الوافر"],[4929,"ومن يرض في فقدِ الكرامةِ عِيشةً","https://www.poetsgate.com/ViewPoem.aspx?id=204153",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5411,"لست أدري..","https://www.poetsgate.com/ViewPoem.aspx?id=191057",""],[5720,"أهلاً بمقدمِ سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=199864",""],[5829,"فقه الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=198509",""],[5929,"وتكاد تمطرنا السماء...","https://www.poetsgate.com/ViewPoem.aspx?id=202655",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[6093,"قالوا: خرجتَ عن القديم أجابهم (الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176081",""]],"verses":[["فقَهَرْتَ كلَّ مُعانِدٍ وسلَكْتَ طُرْ","قَ العدْلِ بيْنَ أوامِرٍ ونَواهي",0,"ي",1,0],["فَقهَةٌ تُكثِرُ الحَراكَ وَأَيرٌ","ساقِطُ الحِسِّ لَيسَ فيهِ حَراكُ",1,"ك",1,0],["فَقَهقَهَ الوَردُ بِهِ هازِئاً","وَقالَ ما تَحذَرُ مِن سَطوَتي",2,"ت",2,0],["فِقهُ الحياةِ أصابَ فيه إمامَه","وإلى الأئمةِ يرجَعُ الجُهّالُ",3,"ل",1,0],["فقّهَ الناسَ بالنبيّ بِنطقٍ","أَذِئابٌ بين الورى فقهاءُ",4,"ا",2,0],["فُقَهاؤُنَا كَذُبالَةِ النِّبراسِ","هِيَ في الحَرِيقِ وَضَوءُهَا لِلنَّاسِ",5,"س",1,1],["فقْه دهْرٍ أبداهُ من طُولِ ما عِنْ","دك يُلفَى تَناظُرُ الفُقَهاء",6,"ا",2,0],["فِقْهٌ تَبِينُ المُشْكِلاتُ به","وتروحُ مُطْلَقَةً من الشُّكْل",7,"ل",1,0],["فقه المعارف والحقائق ظاهر","من عبده في سورة الأعراف",8,"ف",1,0],["فقَّهته في الدين قامات غيد","إن تثنت تزري بسمر الرماح",9,"ح",1,0],["فقهوةٌ كالنار لكنها","إن تلقَ غيرَ الهمِّ لم تَحْرق",10,"ق",1,0],["فقهقر المعلون يع","دو معلماً بي معلنا",11,"ن",2,0],["فقهٍ وَنحوٍ وَتَأريخٍ وَمَعرِفَةٍ","وَلَحظِ فكرٍ إِلى نيلِ العُلومِ رَنا",12,"ن",2,0],["فَقَهقَهَت وَاِنثَنَت مُعاتبةً","وَالعَتبُ لِلحُرِّ رادِعٌ قامِع",13,"ع",1,0],["فُقهاء الإِسلامِ إِنْ عَنَّ","لبس أحباره خُطَبَاؤُه",14,"ا",3,0],["فقهقه الجمع وبعده قذف","بها لينط ثم آياس وقف",15,"ف",1,0],["فَقِهَ الأَمرَ كاهِنٌ ذو سَدادٍ","واحتِدَامُ الإِلاهِ أَذَّى مفَادَه",16,"د",2,0],["فقهاء أنى يفقهون وإن من","عاداتهم أن يحملوا الأسفارا",17,"ر",2,0],["فقه في حديثه من يزنه","لم يزحزحه عن مقام النيابه",18,"ب",2,0],["فقهقه ثم قال فتقطوني","بقهقهة من الناجود خلفي",19,"ف",2,0],["فَقِهنَا مِنَ الإسلامِ طاعةَ من يلي ...،","ولو أنَّه من طيزِ ابليسَ وافدُ",20,"د",1,0],["فقهاء مدرسةٍ وفتيتة ملعبٍ","يتقارضون العيش عيشاً أخضرا",21,"ر",2,0],["فَقِه المَعْنى لا تَظُنَّ جزافًا","كَمْ رَمى النّاس بالظّنون نَبِيَّا",22,"ي",2,0],["فقهٌ ،، وتوحيدٌ ،، وعلمٌ نافعٌ","صرنا به من أعظمِ البلدانِ",23,"ن",1,0],["فقه الهوى باب الجمال فخذ به","في كل امر بالغ لمعاده",24,"د",2,1],["فقهاء فتوى الحيض، أحكامِ اللّحى","وشرائعِ التفخيذ والقمصان",25,"ن",1,0],["فقه الشريعة أول","في الفضل لأفقه العشائر",26,"ر",1,1],["فَقِهَ العَروضَ عن الأوائل ملْهَمٌ","وأضافَ هنْدسةَ العروض عليمُ",27,"م",1,0]]}