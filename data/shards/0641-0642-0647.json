{"poems":[[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[45,"قم تأمل بنا عجائب دهر","https://www.aldiwan.net/poem65226.html","الخفيف"],[66,"قد نشر الزنبق أعلامه","https://www.aldiwan.net/poem38807.html","السريع"],[105,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[311,"فقهاؤنا كذبالة النبراس","https://www.aldiwan.net/poem59491.html","الكامل"],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[429,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[556,"فاز الذي شرب الشراب الصافي","https://www.aldiwan.net/poem33540.html","الكامل"],[556,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"]],"verses":[["فقَهَرْتَ كلَّ مُعانِدٍ وسلَكْتَ طُرْ","قَ العدْلِ بيْنَ أوامِرٍ ونَواهي",0,"ي",1,0],["فَقهَةٌ تُكثِرُ الحَراكَ وَأَيرٌ","ساقِطُ الحِسِّ لَيسَ فيهِ حَراكُ",1,"ك",1,0],["فَقَهقَهَ الوَردُ بِهِ هازِئاً","وَقالَ ما تَحذَرُ مِن سَطوَتي",2,"ت",2,0],["فِقهُ الحياةِ أصابَ فيه إمامَه","وإلى الأئمةِ يرجَعُ الجُهّالُ",3,"ل",1,0],["فقّهَ الناسَ بالنبيّ بِنطقٍ","أَذِئابٌ بين الورى فقهاءُ",4,"ا",2,0],["فُقَهاؤُنَا كَذُبالَةِ النِّبراسِ","هِيَ في الحَرِيقِ وَضَوءُهَا لِلنَّاسِ",5,"س",1,1],["فقْه دهْرٍ أبداهُ من طُولِ ما عِنْ","دك يُلفَى تَناظُرُ الفُقَهاء",6,"ا",2,0],["فِقْهٌ تَبِينُ المُشْكِلاتُ به","وتروحُ مُطْلَقَةً من الشُّكْل",7,"ل",1,0],["فقه المعارف والحقائق ظاهر","من عبده في سورة الأعراف",8,"ف",1,0],["فقَّهته في الدين قامات غيد","إن تثنت تزري بسمر الرماح",9,"ح",1,0]]}