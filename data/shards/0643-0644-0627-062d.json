{"poems":[[55,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[53,"خليلي قد عللتماني بالأسى","https://www.aldiwan.net/poem65889.html","الطويل"],[53,"وما راحة المرزوء في رزء غيره","https://www.aldiwan.net/poem65890.html","الطويل"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[50,"كفاك ما مر على راسي","https://www.aldiwan.net/poem63441.html","السريع"],[154,"زمان بتطهير القلوب موكل","https://www.aldiwan.net/poem68523.html","الطويل"],[154,"كتمت الهوى حتى تبدت سماته","https://www.aldiwan.net/poem68555.html","الطويل"],[287,"بأبي الريم الذي مر بنا","https://www.aldiwan.net/poem32406.html","الرمل"],[458,"الفطر جاء بآمال نجددها","https://www.aldiwan.net/poem61274.html","البسيط"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53744","الطويل"],[3466,"","https://poetry.dctabudhabi.ae/diwan/poem/124615","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4699,"انكسار","https://www.poetsgate.com/ViewPoem.aspx?id=155953",""],[4755,"كُلُّ احتِيَاجَاتِ نَفسِي صِرتُ أَعرِفُها","https://www.poetsgate.com/ViewPoem.aspx?id=183687",""],[4852,"بياني","https://www.poetsgate.com/ViewPoem.aspx?id=214367",""],[5206,"الدُّنيا والنفس","https://www.poetsgate.com/ViewPoem.aspx?id=187386",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""]],"verses":[["كُلُّ أَحوى عاقِصٌ بِالد","دَمِ أَطرافَ السَبيبِ",0,"ب",1,0],["كلا حامِلَيْ أوْقِ الرزيئةِ مُثقلٌ","وليس مُعيناً مثقلَ الظهر مُثقلُ",1,"ل",1,0],["كِلا حاملي أوقِ الرزيةِ مثقلٌ","وليس مُعيناً مثقلُ الظهر مُثقلا",2,"ل",2,0],["كل أحبابي القدامى نسوني","لا نوار تجيب أو عفراء",3,"ا",2,0],["كُلُّ أَحاديثي سِوى ذِكرُها","مُنكَشِفٌ مِنّي لِجُلّاسي",4,"س",2,0],["كِلا حالتي هذين فيها فضيلة","وحالة ترتيل القراءة أفضل",5,"ل",1,0],["كِلا حَالتي هَذَا الهوَى حَالُ لَذَّةٍ","فَسِيَّانِ عِندِي حِينَ أضحَكُ أو أبكِي",6,"ك",2,0],["كُلُّ أَحوى فاتِرِ الطَرفِ إِذا","ما رَآهُ ذو عَفافٍ فُتِنا",7,"ن",2,0],["كل احتفاء به للسلم مرجعه","والسلم كالحب لم يعرفه تحديد",8,"د",1,0],["كل أحوالي بكم ظهرت","وغرامي غير منكتم",9,"م",1,0],["كِلاَ حاَلَتْيهِ الجودُ أنَّى تصرَّفَتْ","به دُوَلُ الأيامِ في العُسْرِ واليُسْرِ",10,"ر",1,0],["كلا حبّه والخوف لله طاعةٌ","وقلبي للوصفَينِ حاوٍ وجامع",11,"ع",1,0],["كلا حاليه في سر وجهر","مراودة الخنا أو شرب خمر",12,"ر",1,0],["كل أحلامي توارت","كل أنفاسي لهيب",13,"ب",1,1],["كُلُّ احتِيَاجَاتِ نَفسِي صِرتُ أَعرِفُها","لكنني لَستُ أَدرِي كَيفَ أَطلُبُها!",14,"ب",3,1],["كل احتمالٍ للخمورِ .. بأسطري","يضحى السُّلافَ إذا رواهُ .. لساني",15,"ي",1,0],["كَلَّاحَةٌ كَشَّاحَةٌ فَضَّاحَةٌ","جَرَّاحَةٌ ذَبَّاحَةٌ قَتَّالَه",16,"ل",2,0],["كلُّ احتياجٍ له أنغامُ يبعثها","وأجملُ اللحنِ لحنُ الحبِّ والسَّمَرِ",17,"ر",1,0]]}