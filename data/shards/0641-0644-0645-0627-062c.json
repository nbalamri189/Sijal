id=186498",""],[5273,"عانس","https://www.poetsgate.com/ViewPoem.aspx?id=180576",""],[5277,"تلويحٌ وتلميح","https://www.poetsgate.com/ViewPoem.aspx?id=203960",""],[5365,"شكراً جزيلا","https://www.poetsgate.com/ViewPoem.aspx?id=191082",""],[5510,"مرايا الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=206318",""],[5582,"بَدَتْ عَنْ وَجْهِها سَحَراً فَلاحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186791",""],[5689,"لا تنس أنا بأفق الغرب في قلق","https://www.poetsgate.com/ViewPoem.aspx?id=143417",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5822,"تَمَادى الْقطر وَانْقطع السَّبِيل","https://www.poetsgate.com/ViewPoem.aspx?id=191659",""],[6082,"وسط الزحام","https://www.poetsgate.com/ViewPoem.aspx?id=60245",""],[6093,"تجربة ماء","https://www.poetsgate.com/ViewPoem.aspx?id=205456",""],[6259,"أتلك حُدوجٌ أم نجوم سوائرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59384&r=&rc=32",""]],"verses":[["فَلَمْ أَجُبِ البَيْداءَ إِذْ أَرْخَتِ الدُّجَى","ذَلاذِلَها مِنْهُ بِأَبْيَضَ باتِرِ",0,"ر",1,0],["فَلَمّا جَرَت في الجَزلِ جَرياً كَأَنَّهُ","سَنا الفَجرِ أَحدَثنا لِخالِقِنا شُكرا",1,"ر",2,0],["فلم أجِبْهُ وحظِّي في إجابتهِ","لكنْ سكتُّ كأنِّي غير مُكترثِ",2,"ث",1,0],["فَلَم أَجِد غَيرَ صَريعٍ هامِدٍ","مُنطَرِحٍ في جانِبِ الشَلّالِ",3,"ل",1,0],["فَلَمّا جاوَزَ الرَبَلاتِ مِنها","إِلى الكاذاتِ باتَ بِها وَقالا",4,"ل",2,0],["فلما جاء سدرته","وكان القرب أعظمه",5,"م",2,0],["فَلَم أَجِد لِيَ مِنهُ غَي","رَ جَدَّتي مِن مَهرَبِ",6,"ب",1,0],["فَلَمّا جِئتُهُ أَعلى مَحَلّي","وَأَجلَسَني عَلى السَبعِ الشِدادِ",7,"د",1,0],["فلَمّا جئتُ أشرقَ منكَ بَدرٌ","وكان لتِمِّه الإسعادُ بُرْجا",8,"ج",2,0],["فَلَمّا جَلى عَنّي الكَرى وَتَقَطَّعَت","غَيايَةُ شَوقٍ غابَ عَنّي صَدوقُها",9,"ق",3,0],["فَلَم أَجِدِ الأَخلاقَ إِلّا تَخَلُّقاً","وَلَم أَجِدِ الأَفضالَ إِلّا تَفَضُّلا",10,"ل",2,0],["فَلَمْ أُجِبْ غَيْرَ أَنَّ الدَّمْعَ نَمَّ عَلَى","وَجْدِي وَدَلَّتْهُ أَنْفَاسِي عَلَى شَجَنِي",11,"ن",2,0],["فلما جَدَّ جِدُّ الحربِ كانوا","قُوَى الأعداءِ تَرْمِي النّاصرينا",12,"ن",2,0],["فَلَم أَجهَل لِخَلقٍ جاهِلِيٍّ","وَلَم أَجزَع لِحادِثَةِ اللَيالي",13,"ل",2,0],["فَلَم أَجِدِ الهَوى إِلّا نَذيراً","يُؤَذِّنُ في المَمالِكِ بِالزَوالِ",13,"ل",1,0],["فَلَمّا جاوَزَت عِشرينَ عاماً","مُخَدَّرَةً وَقَرَّت في قَرارِ",14,"ر",1,0],["فلما جاءهم بالحقِّ صَدُّوا","وصَدُّ أُولئك العَجَبُ العَجيبُ",15,"ب",1,0],["فَلَمّا جَلاها لِلنَدامى بَدا لَها","نَسيمُ عَبيرٍ ساطِعٍ وَلَحيبُ",16,"ب",1,0],["فَلَمّا جَرَت فيهِ تَغَنّى وَقالَ لي","بِسُكرٍ أَلا هاتِ اسقِنا بِالدَوارِقِ",17,"ق",1,0],["فَلَم أَجعَلكِ لِلقُربانِ نَحراً","وَلا قُلتُ اِشرَقي بِدَمِ الوَتينِ",18,"ن",1,0],["فَلَمّا جِئتُ قُلنَ نَعِمتَ بالاً","خَلا شَجَنٌ وَغُيِّبَ مَن يَغارُ",19,"ر",1,0],["فَلَم أَجزَع وَإِن كُنتُ","جَزوعاً حينَ خوفيتُ",20,"ت",1,0],["فَلَمّا جِئتُ رَوَّعَني غَريمٌ","يُحاوِلُ ما كَرِهتُ وَلا يَهابُ",21,"ب",1,0],["فلَمّا جَرى الماءُ الحَمِيمُ وأُدرِكَت","هَزِيمَتُهُ الأُولى التّي كُنتُ أَطلُبُ",22,"ب",1,0],["فَلَم أَجِدِ الإِخوانَ إِلاَّ صَحابَةً","وَلَم أَجِدِ الأَهلِينَ إِلاَّ مَثاوِيا",23,"ي",2,0],["فلَم أَجتَعِل فيمَا أَتَيتُ مَلاَمَةً","أَتَيتُ الَجمالَ واجتَنَبتُ القَنازِعا",24,"ع",2,0],["فَلَمّا جاءَني أَيقَنتُ لَمّا","فَضَضتُ خِتامَهُ أَنّي لَما بي",25,"ب",2,0],["فلم أجد منشودتي في موضع","ثم حدست انها رهن الثرى",26,"ا",1,0],["فَلَمّا جَلاَ عَني الكَرَى وَتَقَطّعَتْ","غَيَايَةُ شَوْقٍ غَابَ عَني صَدُوقُها",27,"ق",3,0],["فَلَمّا جَزَمتُ بِهِ قِربَتي","تَيَمَّمتُ أَطرِقَةً أَو خَليفا",28,"ف",2,0],["فَلَم أجِد غَيرَ نَصّ الذِّكر مُتَّضِحاً","والذِّكرُ أردَعُ من صَمصَامَةٍ ذَكَرِ",29,"ر",1,0],["فلم أجد غير درب الله درب هدىً","وغير ينبوعها نبعاً لمغترفِ",30,"ف",1,0],["فلم أجد موجبا والآن ثار له","من يطلب الثار منه أيما طلب",31,"ب",1,0],["فَلَم أَجِد بَعدَ يَأسي غَيرَ مُرتَحَلي","عَنهُم لِهَمٍّ أسَلِّيهِ وَمُتَّدَعِ",32,"ع",1,0],["فَلَمّا جَعَلتَ جَوابي السُكوتَ","تَبَيَّنَ لي أَنَّني أَحمَقُ",33,"ق",1,0],["فَلَمّا جَرى تَحتَهُ سابِحاً","غَدا طائِعاً تابِعاً ما رَسَم",34,"م",1,0],["فلمّا جعَلْتَ الأرضَ وهْي فسيحةٌ","على شِيعةِ الإلحادِ كِفّةَ حابل",35,"ل",1,0],["فلم أَجِدْ في الشّرِّ غيرَ شامتٍ","ولم أَجِدْ في الخَيرِ غيرَ حاسد",36,"د",1,0],["فَلَمّا جَرَحتَ القَلبَ صارَت مَدامِعي","دِماءً فَأَورَت وَجنَتَيكَ شَقيقا",37,"ق",2,0],["فلَم أجِد مَسلَكاً فعُدتُ فَمِن","ذلِكَ أَن قُلتُ فيكَ لَم أطُلِ",38,"ل",1,0],["فلم أجد في فنائه أحداً","والدر ملقى به لمغتنمه",39,"م",2,0],["فلم أجد بدا سوى رفع ما","دار إلى العلامة الأعرف",40,"ف",1,0],["فلمّا جرحْتُ الخَدَّ مِنكَ بنظرَةٍ","جرحْتَ فؤادي والجُروحُ قِصاصُ",41,"ص",1,0],["فَلَمّا جَرى ما كانَ أَقفرت قلبه","لأَنَّكَ نَفّاع إِذا شِئتَ ضائِرُ",42,"ر",1,0],["فلم أجزَعْ لِفَجْئَاتِ التّنائِي","ولم أفْرَقَ لروْعاتِ الفِراقِ",43,"ق",1,0],["فلم أجد غير صدق النصح يشفعني","واشرف النصح لا يجزى بإصغاء",44,"ا",2,0],["فلم أجد قبلها إلا الأَلوفَ ولا","سكنتُ من عهدها إلا إلى سَكنِ",45,"ن",1,0],["فلما جرتْ كأسُ الشَّمول تراجعت","رزايا الهوى تطوى بهنَّ التَّنائفُ",46,"ف",1,0],["فلما جرى مجرى الرياح وطبَّقت","قوافيهِ أقطار البلادِ العوازبِ",47,"ب",1,0],["فلم أجدْ من جزاءٍ غيرَ قافيةٍ","تَفْنى الليالي ولا تفْنى مناقِبُها",48,"ب",3,0],["فَلَمّا جِئتُ قالَت لي كَلاماً","بَرَمتُ بِهِ فَما وَجَدتَ لَهُ جَوابا",49,"ب",2,1],["فَلَم أَجِد فيهِ مِنَ الماءِ ما","أَغسَلَ مِن وَجهي بِهِ جَفني",50,"ن",2,0],["فَلَم أَجِد لك فيهِ مِن موافَقَةٍ","فَقُلتُ وافقَ رأيي واِنتَهى الطَلَبُ",51,"ب",1,0],["فلم أجد منك سوى","شواغلاً برّحن بي",52,"ب",2,0],["فلم أجدْ كعليٍّ من يليقُ به","حَلْيُ العلاءِ إذا ما اخترتُ أليقه",53,"ق",2,0],["فَلَم أَجبُن وَلَم أَنكُل وَلَكِن","شَدَدتُ عَلى أَبي عَمرِو بنِ عَمرِو",54,"و",1,1],["فلمّا جئتهُ أعلى محلّي","وَأَغناني نداه عن اللئامِ",55,"م",1,0],["فلمّا جئتهم ورأوكَ أضحَوا","سكارى ذاهلين بلا مدامِ",55,"م",1,0],["فلمَّا جِئْتم طبّا عَروفا","بعرفٍ حين يأتيه ونكرِ",56,"ر",1,0],["فلما جاء وقت قضاء بحقي","تغير في بنيِّك كل ظني",57,"ي",1,0],["فَلَم أَجزِهِ إِلّا المَودَّةَ جاهِداً","وَحَسبُكَ مِنّي أَن أُوَدَّ فَأَجهَدا",58,"د",2,1],["فلم اجد مطمعا يحيي موات فوا","د المستهام ولا برقا سرى فشرا",59,"ر",2,0],["فلم اجد في الفهم لي مسلكا","الا بحكم نافذ في البشر",60,"ر",1,0],["فلمّا جرّب الإبريقَ اغضى","مشيراً بالكئوسِ لخَيرِ نادِ",61,"د",1,0],["فَلَم أَجد إِلا كِتاباً أَنظمه","أتحفه بنظمه وَأخدمه",62,"ه",1,0],["فلم اجزع لهذا العمر يمضي","كأني قد مللت من البقاء",63,"ا",2,0],["فلم أجد أوعظَ للنّاس من","أَصواتِ وُعّاظِ جلودِ البقر",64,"ر",1,0],["فلمّا جُحدِلَت مِئتانِ منهم","وَفرَّ حنانُهُم عنهم فزالوا",65,"ل",3,0],["فلم أجد فيهم فتىً ينجز ال","وعد أميناً لا يخون العهود",66,"د",1,0],["فَلَمّا جرَت هيفُ الجنائبِ بالسفا","وأيقَنَّ أنَّ الجزءَ فيه تصرَّما",67,"م",2,0],["فلما جد جد السيف فيهم","وجدناه إمام المدبرينا",68,"ن",2,0],["فلما جلا ستر الظلام ضياؤه","تبدى ركام مثقل الحمل ابيض",69,"ض",1,0],["فلم أجد منع ما حاولَته حسنًا","إذ كنت أهلا لنيل النجح في الطلب",70,"ب",1,0],["فلم أجد غيري فمن ذا الذي","أنكحته فلينظر الأمر",71,"ر",1,0],["فلم أجد فيه مسا","غاً للذي قامَ بنا",72,"ن",2,0],["فلم أجدكم ولم أسمع لكم خبراً","وكيف تسمع أذن خلف أسوار",73,"ر",1,0],["فلم أجد كرسولِ الله من بشر","أو وارثيه وهم أهل الحميات",74,"ت",1,0],["فلم أجد غير ذاتي","لما بسطتُ يديّا",75,"ي",2,0],["فلم أجدْ عند مذاقِ الجنى","طعمَ الذي أعلم بالخبر",76,"ر",1,0],["فلما جئت ببلة خير دار","أمالتني بكل رشى أبي",77,"ي",1,0],["فلما جَدَّنا اللّي","لُ بذلنا بيننا دَنَّا",78,"ن",2,0],["فلما جئتها أوردتُ نفسى","مناهلَ من محاسِنِها عِذَابا",79,"ب",2,0],["فلم أجد أبهى من الأشعار","وليس نظم الشعر من شعاري",80,"ي",1,0],["فلم أجد عالماً أعيش به","قلبي وعقلي هُما بَلايَ هما",81,"م",2,0],["فلم أجرحه في تكذيب ظنٍّ","ولم أجعله بالإعراض دوني",82,"ن",2,0],["فلم أجد لسقام الروح فيه دواً","ولم أجد لجنون القلب فيه رقى",83,"ق",2,0],["فلمْ أجدْ فاضلاً فيمن صحبتُ سوى","محمدِ بن أبي العيش بنِ يربوعِ",84,"ع",1,0],["فلم أجد من أود فيه","أي وإله برى معدا",85,"د",2,0],["فلم أجد وَزَراً مما أًُكابِده","من الزمانِ فعَزَّ اليومَ وِجْدان",86,"ن",1,0],["فلم اجد غير احسان لراحته","لما تحدّر يوماً اوطف الديم",87,"م",1,0],["فلم أجد كمصابي","أبكى وأدهى وأضنى",88,"ن",2,0],["فلم أجد أنفس منه لمَنْ","محَّضَني قلبًا نفيس الشِّيم",89,"م",1,0],["فلم أجد في حماهم","الا ختولا وحاسد",90,"د",1,0],["فَلَمّا جَلَسنا لِلغَداءِ رَأَيتُهُ","يَرى إِنَّما من بَعضِ أَعضائِهِ أَكلي",91,"ل",2,0],["فَلَم أجِد بُدًّا مِنَ الإسعافِ","مَع كَونِ رَسمَ العِلمِ غَيرُ عَافِى",92,"ف",2,0],["فلما جئتهن نظرن نحوى","بوب ساحبات الطرف نجل",93,"ل",1,0],["فلما جئته الفيت شخصاً","حمى عرضاً له واباح عرضا",94,"ض",2,0],["فَلَم أَجِدها وَقد قامَت قِيامَتُها","سِوى سَرابٍ بِقيعان لمحتسِبِ",95,"ب",1,0],["فَلَم أجزِهِ إِذ خَيَّبَ اللَّهُ سَعيَهُ","عَلى خَطَأٍ إِذ كانَ مِنهُ عَلَى عَمْدِ",96,"د",1,0],["فلم أجد عذرا من الإجابه","ونسأل التوفيق للإصابه",97,"ه",1,0],["فلما جاءهم غدروا جميعا","وعما اقدموه اليه تابوا",98,"ب",3,0],["فلم أجربْهُ ولكنَّني","وجدتُه في سِفْرِ طبٍّ دَرِي",99,"ر",2,0],["فلم أجدْ حادياً غيرَ المشيب غدا","يحدو بعمر تقضّى صفوُه نكدا",100,"د",2,0],["فلم أجد من سواي فيه","عرق آباؤه فأنجد",101,"د",1,0],["فلم أجِد مثلَ دينِ المصطفى ألَقاً","ولم أجِد مثلَهُ نهراً يُروِّينا",102,"ن",2,0],["فلمْ أجدْ كغُرُورِالنفسِ مُوبِقَها","ولا أشَدَّ مِنَ المستكبرينَ غَبَا",103,"ب",2,0],["فلم أجد لفظةً إلا ارتمت فغدت","ثكلى تصيح معي والدمع ينهمر",104,"ر",1,0],["فلم أجد نفسي ولكنني","كسرت جفنيَّ على غمزته",105,"ت",2,0],["فَلَمْ أجِدِ الرّجالَ سِوى ذكورٍ","غَرائزُهُمْ بَدَتْ فيهم سُكارى",106,"ر",2,0],["فلمْ أجدِ الَّذينَ مضوا بعيداً","ودونَ لقائِهمْ بيدٌ وسفحُ",107,"ح",1,0],["فلمّا جَسّ من نبضي حريقاً","تحوّل في يدي بحراً طويلا",108,"ل",2,0],["فلم أجد في مرايا الروح عودته","ولا هناك على هجر لنا سببُ",109,"ب",1,0],["فَلَمَّا جاءَهُمْ وَلَّوْا فِراراً","وَأَلْقَوْا عِنْدَ رُؤْيَتِهِ السِّلاحَا",110,"ح",2,0],["فلم أجد بعد تلك الكأس لي ولو","كأسا من الصاب قد أشفي بها حرقي",111,"ق",2,0],["فلما جلى هذا الوجود وأسندت","له إمرة التدبير أول دولتي",112,"ت",2,0],["فَلم أجد السَّبِيل إِلَى حبيب","اودعه وَقد أفد الرحيل",113,"ل",1,0],["فلم اجني بركضي خلف وهم","سوى نبض مليء بالسقام",114,"م",1,0],["فلم أجعلْ تجاربَهُ","كماءٍ عاشَ في الماعُونْ",115,"ن",1,0],["فلما جرى ما كان أفقر قلبه","لأنك نفّاعٌ إذا شئت ضائر",116,"ر",1,0]]}