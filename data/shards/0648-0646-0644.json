لم تنله قط غانية","حسناً وحسنى بها تزدان دنياك",156,"ك",1,0],["وَنُلقِحُها مَبسورَةً ضَرزَنِيَّةً","بِأَسيافِنا حَتّى نُذِلُّ إباءَها",157,"ا",3,0],["ونلت ما نلت على أنني","ما كنت أستوجب ذاك النوال",158,"ل",1,0],["وَنِلتَ بِفِتيَةٍ زُهرَ الأَماني","وَبِالأَحفادِ جامِعَةَ الرِّغابِ",159,"ب",1,0],["ونلت ما نلت بالفيض المقدس لا","بالكسب منك ودم في السعي واكتسب",160,"ب",1,0],["ونلتُ من المسرَّة منك مالو","اردتُ به لطرتُ بلا جناح",161,"ح",1,0],["وَنِلنا مِنكَ ما نَرجو وَأَوفى","فَلَيسَ البَحرُ تَنقُصُهُ الدِلاءُ",162,"ا",2,0],["ونلتُ فيها مراماً عَزَّ مطلبهُ","وغبتُ بالقرب عن عرب وعن عجمِ",163,"م",1,0],["ونلن سقاطاً من حديث كأنّه","جنى النحل في أبكار عودٍ تقطَّفُ",164,"ف",1,1],["وَنُلقى كَأَنّا مَغنَمٌ قَد حَوَيتَهُ","وَتَرغَبُ عَن جَزلِ العَطاءِ وَتُسرِفُ",165,"ف",1,0],["ونلن سقاطاً من حديث كأنّه","جنى النحل في أبكار عودٍ نقطّفُ",165,"ف",1,0],["ونلقى مرىء الفطر صبحا مصادفا","ومرّ الطوى في مغرب وعشاء",166,"ا",2,0],["ونلت منه ما يفوق ظني","ثم اختفى بلا حجاب عني",167,"ي",1,0],["ونلحقَ من سروا ليلاً","وأمّوا منزلاً رحبَا",168,"ب",2,0],["وَنِلنا أَمانينا بأيد بَواسِط","رِداها لأرواحِ الأَعادي قَوابِضِ",169,"ض",1,0],["وَنِلتَ بَسطَةَ تَمكينٍ قَهَرتَ بِها","معانديك فَضع وَارفع وُصل وَطُلِ",170,"ل",1,0],["ونلت يا آمنةُ مفخراً","لما حملت السيد الأنبلا",171,"ل",2,0],["ونلت بالوضع به رفعة","يا رب وضع فيه نيل العلا",171,"ل",2,0],["ونلفتت فيه العيون فلم تجد","اثراً له فغدت ترجع شجونا",172,"ن",2,0],["ونلاقي تلك النزاهة فيمن","لا نلاقي في نفسه اطماعا",173,"ع",2,0],["وَنلنا الأَماني بكلِّ التَهاني","وَعاد الزَمان مجيباً لقصدي",174,"د",2,0],["ونلتُ لا أكفرُ الأيامَ ما وهبت","فكم لها عندنا من نعمةٍ ويَدِ",175,"د",1,0],["وَنلتُ وَوَفَّيتُ الصَبابةَ حَقَّها","وَما ثَمّ مَن رَفع الوَقارِ وَلا خفض",176,"ض",1,0],["ونلت في اليقظة ما الحلمُ لا","يسديه للناس ولا الأولق",177,"ق",1,0],["ونلنا باجتماع الرأي أمراً","من الطلبات صعباً لا ينال",178,"ل",1,0],["وَنِلْتُ مِنْ رِيقِهِ وَعارِضِهِ","أَطْيَبَ مِن راحِهِ وَرَيْحانِهْ",179,"ه",1,0],["ونلت سقيا به تكون ساقيةً","تسقي وتحيي الذي بالبوس قد يئسا",180,"س",2,0],["وَنَل ذُروَةَ المَجدِ الرَّفيعِ مُخَلَّداً","بِمَقتَلِ هَكطُورَ الفَتى الباسِلِ الجَرِي",181,"ر",2,0],["وَنِلتُ بِالحَزمِ ما لَم يَجرِ في خُلد","وَأَن يَمُدَّ إِلَيهِ طالِبُ طَمعا",182,"ع",2,0],["وَنِلنا المُنى فيها عَلى البَشَر وَالصَفا","وَلَيسَت عَوادي الدَهر فيها تُضايِر",183,"ر",1,0],["وَنِلنا المُنى مِن بَعدِ مُشكِلَةِ العَنا","وَأَحلى وِصالَ ما أَتى عَقبَ الصَدِّ",184,"د",1,0],["وَنِلتُ الأَماني حَيثُ أَصبَحتَ وافِداً","عَلى خَيرِ مَن يُرجى بِساحَتِهِ الرَفد",185,"د",1,0],["وَنلتَ مِنَ الدُنيا وَمِن سوءِ فِعلِها","جَزاءَك وَاِنقادَت إَلَيكَ الصَغائرُ",186,"ر",1,0],["وَنِلتُ مِنها غَفلةً","كانتَ كَبرقِ خَلِبِ",187,"ب",1,0],["ونلتَ وزارة جاءتك طوعاً","لها بعليّ جانبك اتحاد",188,"د",1,0],["ونِلت رضا الخُنكار من حيث لم تزل","تفوق كمالاً سيّداً بعد سيّدِ",189,"د",1,0],["وَنُلحِقُ مَن يُزاحِمُنا عَلَيهِ","بِأَعراضِ اليَمامَةِ أَو جُرّادا",190,"د",2,0],["ونلتم مقاما فيه طرف السها سهى","فما قيصر يوم الفخار وما كسرى",191,"ر",2,0],["ونلبس أثواب المسرة والهنا","مزررة بالسعد موشيّة الكم",192,"م",1,0],["ونلت على رغم الرقيب تشرفي","بذات تسامت بالجمال عن الند",193,"د",1,0],["وَنَلتَذ مِن بير الحِجارِ بِشَربَةٍ","وَيُقرَعُ سَمعي مِن خَميسٍ بِتَخميسِ",194,"س",1,0],["وَنلقى كل ميّاسٍ بدوحٍ","عليهِ صنوف أنواع الطيورِ",195,"ر",1,0],["ونلقي بذي الجداث كلٌّ نصيبهُ","علينا من الاحباب لوح المعاذبِ",196,"ب",1,0],["ونلقى كل يومٍ منك عيداً","يحاكي طلعة العيد الكبيرِ",197,"ر",1,0],["ونلت ما كنت طول الدهر تأمله","وعنك أضحى العنا والبؤسُ مرتحلا",198,"ل",2,0],["ونِلتُ من ثَغْرِه رشْفاً على حَذَرٍ","من الرقيب وتَقْبيلاً على عَجَل",199,"ل",1,0],["وَنَلبَسُ للعَدُو جُلُودَ أُسدٍ","إِذا نَلقَاهُمُ وَجُلودَ نُمرِ",200,"ر",1,0],["ونلت مزايا بباطن وظاهر","وسارت مطايا بمجدي تظاهر",201,"ر",1,0],["ونَلْتَقِي بِشارِدِ المجدِ الَّذِي","فَرَّقَهُ اهمالُنا ايْدِي سَبا",202,"ا",1,0],["ونلتُ الذي أرجوهُ واللَهِ عاجلاً","وكم لي بها من بعدِ ذلكَ آجلُ",203,"ل",1,0],["ونلت بالباقيات الصالحات مني","بها قد اجتمعت شتات آمالي",204,"ل",2,0],["ونلتَ ببيت الله رفداً وكم وكم","ببيتك نال الرفدَ والرشد وافد",205,"د",1,0],["ونلهمُ تلكَ الظلالَ وفاءً","ونسهر للمقلةِ الفاقدة",206,"د",2,0],["ونُلقي زمانا كسير الجناح","أظلَّ العقول بعيدا، بعيدا",207,"د",2,0],["وَنَلْتَقِيْ بَعْدَ مَاْ شَطَّ الْمَزَاْرُ بِنَاْ","كَيْ يُخْصِبَ الْحَرْثُ يَاْ عَفْرَاْءُ بِالْمَطَرِ",208,"ر",1,0],["وَنُلَقِنُ الصَّفَوِيَّ دَرْساً قَاْسِياًّ","فَدُرُوْسُنَاْ لِلْمَاْجِنِيْنَ بَلاْءُ",209,"ا",2,0],["ونلت من نعم الرحمن مهما تشا","من كل فضل همى غيثا بانواء",210,"ا",2,0],["ونلت بالسيف ملكاً أنت سيده","ولم يولك مرسومٌ وتقليد",211,"د",1,0],["ونلقي نفوساً كلهنَّ مرؤة","ولطف أسرنا في حبالتهِ اسراً",212,"ر",2,0],["ونلتقي فكأن الأرض ما وُجدت","إلا لنا، وكأن الناس ما خلقوا",213,"ق",3,0],["١٦-ونلوذ من دنس الذنوب ورجسها","ويؤوب بعد تقهقر إيمان",214,"ن",1,0],["ونلقى لنا محتاج ولا مساكين","نعطي لهم عنّا وعن والدينا..",215,"ن",2,0],["ونلحق ُالموتَ في أحدا قِنا أملا","ً يشبُّ عزّاً وفي أرواحِنا آرتهنا",216,"ن",2,0],["ونلت رضاء المصطفى وثناءه","ثناء كساك المجد أبيض لا يصدا",217,"د",2,0],["ونلاقي كل يوم آهة","ترضع القلب شجونا وعناء",218,"ا",2,0],["وَ نَلْقَاكَ بِالرِّضْوَانِ تُجْلِي جَهَالَةً","وَ مَنْ عَاشَ فِي جَهْلٍ إِلَيْكَ سَيُحْوَجُ",219,"ج",1,0],["ونُلبِس ذي الأماني عقدَ فرحٍ","على جيد الليالي الفاتناتِ",220,"ت",1,0],["ونلتقي فيه .. والأفراح مُشْرِعَة","فترتوي الأرض أفراحاً وإحسانا",221,"ن",2,0],["وَنِلْتَ فَضْلَ عِبَادِ اللهِ أَجْمِعِهِم","مِنَ الإِلٰهِ بِهَدْيٍ ظَلَّ أَزْمَانَا",222,"ن",2,0],["وَنِلْتَ أَجْرَاً وَمِقْدَارَاً وَمَنْزِلَةً","وَحُزْتَ رِضْوَانَ ذِي الْإِحسَانِ والرِّفْقِ",223,"ق",1,0],["وَنَلُمُّ أحجار الكرامة جُملة","نَبْنِى بها الهرم الكبير العاتى",224,"ت",2,0],["ون لدت النظره على وجه رجال","يطيح من طوله ويرثي قمرها",225,"ر",3,0],["وَنَلْهُو فِي مَجَرَّات الْأمَانِي","عَلَى سَرَرٍ وَقَدْ صَارَتْ مِهَادا",226,"د",2,0],["ونِلْتَ في ضِمنِ ما وُلِّيتَ من نِعَمٍ","يُمْناً ومأمَنةً من زَلَّةِ القَدَمِ",227,"م",1,0],["ونلبس ثوب الود درع قلوبنا","ونرويه نوراً بالمحبة مفعما",228,"م",2,0],["ونلت فوق الذي تشاء وقد","دوفع كلٌ عن حقه ولوي",229,"و",2,0],["وَنلهَثُ خَلفَ طُعمٍ فيه حَتْفٌ","بِخيطٍ ليسَ 