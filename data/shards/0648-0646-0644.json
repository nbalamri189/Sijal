{"poems":[[55,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[55,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[65,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[79,"نعمنا بوصل من حبيب مساعد","https://www.aldiwan.net/poem36532.html","الطويل"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[90,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[90,"مضى عبد وهاب الهبات لربه","https://www.aldiwan.net/poem45046.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[93,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[58,"بها غير معذول فداو خمارها","https://www.aldiwan.net/poem58589.html","الطويل"],[47,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[47,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[47,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[63,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[68,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[68,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[82,"لحظك بالعلى بالفوز قدح","https://www.aldiwan.net/poem31507.html","الوافر"],[76,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[107,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[107,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[50,"إذا ما وطئ الأمر","https://www.aldiwan.net/poem62575.html","الوافر"],[52,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62230","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54896","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[79,"نعمنا بوصل من حبيب مساعد","https://www.poetsgate.com/ViewPoem.aspx?id=34091",""],[79,"يا سيدي أفديك بالنفس","https://www.poetsgate.com/ViewPoem.aspx?id=34187",""],[113,"أجرني بالتواصل بعد بعدك","https://www.aldiwan.net/poem16394.html","الوافر"],[139,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[148,"منا القلب عطفا بالمسيء برحمة","https://www.aldiwan.net/poem4458.html","الطويل"],[154,"ولا تزل في سعود","https://www.aldiwan.net/poem68536.html","المجتث"],[154,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[164,"غايات جودك لا تبطي عن الامل","https://www.aldiwan.net/poem59074.html","البسيط"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[210,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[211,"يا دار أسماء بين السفح فالرحب","https://www.aldiwan.net/poem27978.html","البسيط"],[214,"تخطرت والتفتت كالرشا","https://www.aldiwan.net/poem13346.html","السريع"],[214,"طاب الزمان وجاء الدهر يعتذر","https://www.aldiwan.net/poem13432.html","البسيط"],[214,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[214,"سلام كعرف المسك يعبق بالنشر","https://www.aldiwan.net/poem13525.html","الطويل"],[215,"حضرنا ننظر النهرا","https://www.aldiwan.net/poem46274.html","مجزوء الوافر"],[241,"أسعدك الله بالولد","https://www.aldiwan.net/poem18161.html","مخلع البسيط"],[265,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[307,"وحمراء لما ترشفتها","https://www.aldiwan.net/poem57792.html","المتقارب"],[308,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[330,"سألت الديار وأطلالها","https://www.aldiwan.net/poem44248.html","المتقارب"],[346,"ما بين اخفاق حبي","https://www.aldiwan.net/poem55335.html","المجتث"],[365,"رسول الله ضاق بي القضاء","https://www.aldiwan.net/poem68144.html","الوافر"],[368,"وقيت ما فيك أتقيه","https://www.aldiwan.net/poem60580.html","مخلع البسيط"],[368,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[374,"ولما أتانا والديار بعيدة","https://www.aldiwan.net/poem1329.html",""],[395,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[407,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[407,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[420,"سقى الله عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53888.html","الطويل"],[420,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[420,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[420,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[433,"إلى علياك تبتسم المعالي","https://www.aldiwan.net/poem39834.html","الوافر"],[433,"يا غائبا عن حبه","https://www.aldiwan.net/poem41005.html","مجزوء الرجز"],[436,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[461,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[461,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[468,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[480,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[503,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[517,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[518,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[532,"ولو كان لي ملء البسيطة ألسن","https://www.aldiwan.net/poem37398.html","الطويل"],[541,"تبدت نجوم الفن في أفق الغرب","https://www.aldiwan.net/poem48272.html","عموديه"],[554,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[554,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[554,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[558,"ففر زهير خيفة من عقابنا","https://www.aldiwan.net/poem1924.html","الطويل"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[561,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[561,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[561,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[565,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[565,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[566,"إذا جلت فكرا في العلوم عويصها","https://www.aldiwan.net/poem13612.html","الطويل"],[578,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"],[578,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[578,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10452","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10407","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22565","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[1111,"","https://poetry.dctabudhabi.ae/diwan/poem/22627","الوافر"],[1140,"","https://poetry.dctabudhabi.ae/diwan/poem/29458","الوافر"]],"verses":[["وَنَلقى قَبلَ لُقيانِ المَنايا","رِماحَ الداءِ تَطعَنُ في الجُسومِ",0,"م",1,0],["وَنَلقى أَشهَبَ الأَمواهِ تَرمي","بِرَغبَتِنا إِلى شِبهِ البُحورِ",1,"ر",1,0],["وَنَل مِن نَسيمِ الرَندِ وَالبانِ نَفحَةً","فَهَيهاتَ وادٍ يُنبِتُ البانَ وَالرَندا",2,"د",2,0],["وَنِلتُ حَديثاً كادَ يَغشى مَواقِفي","مِنَ القُلَّةِ الشَّماءِ بالأَعصَمِ الفَردِ",3,"د",1,0],["ونلْثِمُ ما بيْنَ النّحورِ الى الطُّلا","وإنْ هيَ غصّتْ بالحُلى والقلائِدِ",4,"د",1,0],["وَنَلبَسُ في الحَربِ نَسجَ الحَديدِ","وَنَسحَبُ في السِلمِ خَزّاً وَقَزّا",5,"ز",2,0],["وَنِلنا سِقاطاً مِن حَديثٍ كَأَنَّهُ","جَنى النَحلِ مَمزوجاً بِماءِ الوَقائِعِ",6,"ع",1,0],["ونُلزِمهنّ قعر البيت قهراً","ونحسبهنّ فيه من الهَنات",7,"ت",1,0],["ونلجأ عند الأدّكار إلى البِكا","ونفزع من بعد البكاء إلى الصبر",8,"ر",1,0],["وَنُلفَى في الجُدُوبَة أهلَ خصبٍ","وفي ظُلَم الحَنَادس مُقمرينَا",9,"ن",2,0],["ونلقى منك محتقِراً لُهاهُ","وحولَ أخسِّها قَدْراً يُحامُ",10,"م",1,0],["وَنَلومُ هاجِرَها عَلى نِسيانِهِ","وَاللائِمِ الناسينَ أَوَّلُ ناسي",11,"س",2,0],["وَنَلقى الجَوَّ صاعِقَةً وَرَعداً","إِذا قَصرُ الدُبارَةِ فيهِ غاما",12,"م",2,0],["وَنَلْ مِنْ عَظيمِ الوِزْرِ كُلَّ عَظيمةٍ","إِذا ذُكِرَتْ خافَ الحَفيظانِ نَارَهَا",13,"ر",3,0],["وَنُلحى في مُواصَلَةِ الغَواني","وَما تُلحى الغَواني في الصُدودِ",14,"د",1,0],["وَنِلتُ خَسيساً مِنهُ ثُمَّ تَرَكتُهُ","وَأَقلَعتُ عَنهُ وَهوَ مُنعَفِرٌ فَردُ",15,"د",1,0],["وَنَلومُ طَلحَةَ وَالزُبَيرَ كِلَيهِما","وَنُعَنِّفُ الصِدّيقَ وَالفاروقا",16,"ق",2,0],["ونِلْتَ أَمنعَهُم حِصْناً وأبعَدَهم","فليسَ تَعصِمُهُمْ من بأسِكَ العِصَمُ",17,"م",1,0],["وَنِلتُ مِن فَضلِها ما كانَ أَسأَرَهُ","بِقَعرِها مِن رُضابٍ نَشرُهُ نَفَحا",18,"ح",2,0],["وَنِلتَ فيهِ ما تَرومُ مِن مِنىً","وَعِشتَ في عِزٍّ وَبَأسٍ وَمِنَن",19,"ن",1,0],["وَنِلتُ بِها سُؤلي مِنَ العِزِّ لا الغِنى","وَما عُدَّ مَن عافَ الهِباتِ بِخائِبِ",20,"ب",1,0],["ونلتَ سعادةً ما اسودّ ليلٌ","وعينَ كرامةٍ ما ابيضّ صبحُ",21,"ح",1,0],["وَنَل نَظرَةً مِن نُضرَةِ الحُسنِ وَاِنتَعِش","بِغُرَّةِ رَقراقِ الشَبابِ غَريرِ",22,"ر",1,0],["وَنَلهو بِالحِسانِ فَلا تُرينا","تَبَرُّمَ عاتِبٍ وَمَلالَ قالِ",23,"ل",1,0],["وَنِلتَ بدارِهم ما رُمتَ منهم","فهل لك بعد ذلكَ من مرامِ",24,"م",1,0],["وَنِلهُ كَيفَما شِئتَ اِق","تِضاباً وَعَلى مَوعِد",25,"د",1,0],["وَنِلتَ مِنَ الشَبارِقِ وَالقَلايا","وَأُعطيتَ البَنَفسَجَ في الخُمارِ",26,"ر",1,0],["ونُلْحِفُ النَّارَ جَزْلاً وَهْيَ بَارِزَةٌ","ولاَ نَلُطُّ وَرَاءَ النّارِ بِالسُّتَرِ",27,"ر",1,0],["ونُلْصِقُ بالكُوم الجِلاَدِ وقَدْ رَغَتْ","أَجِنَّتُهَا ولَمْ تُنَضِّجْ لَهَا حَمْلاَ",28,"ل",2,0],["وَنلْثَمُ أَرْضاً فَاخَرَ التِّبْرَ تُرْبُهَا","وَنافَسَ أَدْنَى مَرْوِهَا غَالِيَ الدُّرِّ",29,"ر",1,0],["ونلبس الأشعار من حسنها","ما شاءه إبداعنا أن يكون",30,"ن",1,0],["ونلنا كما شاء الهوى عقب النوى","على رغم أنف من عدو وحاسد",31,"د",1,0],["ونلثم ما بين النحور إلى الطلى","وإن هي غصت بالحلى والقلائد",31,"د",1,0],["ونلت منه شرفا خالدا","يأبى دروس المرء في الرمس",32,"س",1,0],["وَنَلثم اقحوان الثَغر طَوراً","عَلى جَزع وَنَهصر غُصن قَدك",33,"ك",1,0],["ونلت معارفاً رقت ودقت","فصرت الفرد في هذا الزمانِ",34,"ن",1,0],["ونلتم شرابا طيبا من ودادنا","وعلما وطيبتم بطيب كفايتي",35,"ي",1,0],["ونلت قصدك ما ب","ين راحة وقعود",36,"د",1,0],["وَنِلنا الهُدى مِن وَبلِها بَعدَ طَلِّها","بيُمنِ نَبيٍّ فَضلُهُ أَصلُ فَضلِها",37,"ه",2,0],["ونلت منها ونالت راحتي بها","ما عنه يقصر ابعا كل منتول",38,"ل",1,0],["ونلتُ لدَيكَ رفعاً في مَحلِّي","تُناقضُهُ بوضعٍ في رِحالي",39,"ل",2,0],["ونلنا من منى كلّ الأماني","وبتنا في رباها موقنينا",40,"ن",2,0],["وَنِلتَ مَجداً فَحاذِر أَن تُدَنِّسَهُ","أَبٌ كَريمٌ وَجَدٌّ غَيرُ مُؤتَشَبِ",41,"ب",1,0],["ونلت بالفرع وبالفرق ما","قد حير الطرف وما ادهشا",42,"ش",2,0],["ونلت بالعز ما لا ناله ملك","وحزت بالمجد ما لا حازه بشر",43,"ر",1,0],["ونلت فخارا ما بدا الروض يانعا","وما رنحت اعطافه نسمة الفجر",44,"ر",1,0],["ونلت من الاقبال والسعد والعلا","محلّا به تعلو على الشمس والبدر",45,"ر",1,0],["ونلمح في جوانبه","بريق العسجد الذائب",46,"ب",1,0],["وَنِلْتًمُ خَيْرَ ذَا الْبَلَدْ","بِوَالِدٍ مَعْ مَا وَلَدْ",47,"د",1,0],["ونلت به نصراً عزيزا على العدي","ولا خاذل والله يمنحك النصرا",48,"ر",2,0],["ونلت المسرات دون الورى","لأني سبقتهمو بالكميت",49,"ت",1,0],["ونلت من ربي رضا وقربه","يكون فيها قطع كل الأسباب",50,"ب",1,0],["وَنِلتُ مَجالِسَ مَشهورَةً","يُنالُ الكِرامُ بِمَن نالَها",51,"ل",3,0],["ونلت من كل شكل","وحزتُ من كل جنس",52,"س",1,0],["وَنِلت مِن السِيادَة مُنتَهاها","عُلُوّ دون رُتبَه العَلاء",53,"ا",2,0],["ونِلْتَ من صَفْوِ كُلِّ عِزٍّ","ما مثْلُ عُلْياكَ يَقْتَضيه",54,"ي",2,0],["ونِلْتُ منه نَوالاً لا يُشاكِلُه","إلاّ قِطارُ الغَوادي وهْي تَنْهَمِر",55,"ر",1,0],["وَنِلْتُ مِنَ الأيّامِ مَا كُنْتُ راجيِاً","وُقُلْتُ لِدَهْري: كيفَ ما شِئتَ فَاصنْعَا",56,"ع",2,0],["ونلت من ربي رضا وقربه","وكل خصله لن تبور",57,"ر",1,0],["ونل منها بعض ما رامه","في قبض ما يصرف في المصرف",58,"ف",1,0],["ونُلبِس هذا القلب ثوبَ ندامة","على ما أتانا من جناياته كسبا",59,"ب",2,0],["ونلتُ كما أهوى بوصلي لها المنى","ولم أنْسَها كالغصن إذ مال وانثنى",60,"ن",2,0],["ونِلْتُم به في كلّ يوم مسرَّةً","يجيء بها في مثل يومكم غد",61,"د",1,0],["ونلت بتوفيق العناية رتبة","عدوَّك يلقى دونها مورد الردى",62,"د",2,0],["ونِلْتُ بك المرادَ من الأماني","فَنِلْتَ من المهيمنِ ما تريد",63,"د",1,0],["ونل عزاً وزد صدقاً وأرخ","سما عدلية الأحكام رفعه",64,"ع",2,0],["ونل نوالا فاض من","تقبيل كفّ ذي سعه",65,"ع",2,0],["ونلْتَ من رُتَب العَليا وغايتِها","ثمّ استوَتْ في انحطاطٍ بعدَها الرُّتَبُ",66,"ب",1,0],["ونلْ بيمينك الدنيا جميعاً","وأطبقْها على السبعِ الطباقِ",67,"ق",1,0],["ونَلْ وأبوك العزَّ ما حنَّ فاقدٌ","وقام على السَّبْع الطِّباقِ مديرُها",68,"ر",3,0],["وَنَلتَقي والرِّياح الهُوج تَصفَعُنا","فَما تُُشابِكُ أهدابا ً مَآ قينا !",69,"ن",2,0],["ونلتُ مِنَ الشَّعرِ الثريا تطاولاً","فيا ليتهمْ نالوا على قربهِ الثرى",70,"ر",2,0],["ونِلْتُ كلَّ مطْلَبي","وتمَّ لي مُؤَمَّلي",71,"ل",2,0],["ونلثِمُ من ثنايا الجِذْعِ برقاً","فنحسَبُهُ ثُغورَ بَني حِسابِ",72,"ب",1,0],["ونلت من عظماء الجيش تكرمة","وخلة حرست من عارض الخلل",73,"ل",1,0],["ونِلْتُ مِنَ الإحْسانِ مالَوْ أقَلُّهُ","يُوازِنُ قَدْرِي كانَ أكْثَر منْ قَدْرِي",74,"ر",2,0],["ونِلتُم أسمَى حُظوةٍ ومكَانةٍ","لَدَى المِلكِ الحامِي الحِمَى عاهِلِ الشَّعبِ",75,"ب",1,0],["وَنَلثمُ في رَبْعِ الذّين تحمّلوا","من التُّربِ آثار الخُطا والأخامصِ",76,"ص",1,0],["ونِلتُ ما ذِيدَ عنه كلُّ مُلتَمِسٍ","عفواً وطامَنْ عنه كلُّ جبّارِ",77,"ر",1,0],["وَنِلتموها بَيعةً فلتةً","حَتّى تَرى العين الّذي قُدِّرا",78,"ر",2,0],["وَنَلقى قُمَيرا في المَكَرِّ وَحَبتَراً","وَجارَهُم في الفَجرِ يَدعونَ حاطِما",79,"م",2,0],["ونلنا فضلهُ أرِّخ","برحلةِ قُدْسه الأكرمْ",80,"م",1,0],["ونلت على قدر المنى رتب المنى","وما يستوي الولهان والفارغ الخلو",81,"و",1,0],["ونلجأ في شأننا كله","إليه ليكفيَنا ما أهمّْ",82,"م",1,0],["ونلنا الصفا عند الصفا يوم سعينا","إلى مروة التركيب فوق المراكب",83,"ب",1,0],["ونِلتَ في اللُّطفِ سِرّاً طابَ عُنصُرُهُ","فكانَ من حاسدِيهِ ألطَفُ النَسَمِ",84,"م",1,0],["ونَلقَى من عَواصِفِها غُباراً","حسِبناهُ لأوجُهِنا جَمالا",85,"ل",2,0],["وَنِلتُ لَذيذَ العِلمِ بِالذَوقِ وَحدَهُ","وَكُلّ لَذيذٍ غَيرُهُ كَهَبيدِ",86,"د",1,0],["ونِلْتُ ما نِلْتُ مما لم أَهُمَّ به","ولا تَرقَّتْ إِليه هِمَّةُ الأَمَلِ",87,"ل",1,0],["ونلتُ في نَوْمِي وفي يقْظَتي","رؤْيايَ في نوْمي وفي حُلْمي",88,"م",2,0],["ونلتُ منه ولا كفراً لأَنعمه","فوقَ الَّذِي كانَ في ظَنِّي وفي أَمَلِي",89,"ل",2,0],["وَنَلبَسُ يَومَ الرَوعِ زَعفاً مُفاضَةً","مُضاعَفَةً بيضاً لَها حَبَبٌ يَجري",90,"ر",2,0],["وَنُلقِحُها مَبسورَةً ضَرزَنِيَّةً","بِأَسيافِنا حَتّى نُذِلُّ إباءَها",91,"ا",3,0],["ونلن سقاطاً من حديث كأنّه","جنى النحل في أبكار عودٍ تقطَّفُ",92,"ف",1,1],["وَنُلقى كَأَنّا مَغنَمٌ قَد حَوَيتَهُ","وَتَرغَبُ عَن جَزلِ العَطاءِ وَتُسرِفُ",93,"ف",1,0],["ونلن سقاطاً من حديث كأنّه","جنى النحل في أبكار عودٍ نقطّفُ",93,"ف",1,0],["وَنُلحِقُ مَن يُزاحِمُنا عَلَيهِ","بِأَعراضِ اليَمامَةِ أَو جُرّادا",94,"د",2,0],["وَنَلبَسُ للعَدُو جُلُودَ أُسدٍ","إِذا نَلقَاهُمُ وَجُلودَ نُمرِ",95,"ر",1,0]]}