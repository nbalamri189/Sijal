{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[53,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[63,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[77,"نعمنا بوصل من حبيب مساعد","https://www.aldiwan.net/poem36532.html","الطويل"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[30,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[88,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[88,"مضى عبد وهاب الهبات لربه","https://www.aldiwan.net/poem45046.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[85,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[56,"بها غير معذول فداو خمارها","https://www.aldiwan.net/poem58589.html","الطويل"],[45,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[61,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[66,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[66,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[80,"لحظك بالعلى بالفوز قدح","https://www.aldiwan.net/poem31507.html","الوافر"],[74,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[105,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[105,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[48,"إذا ما وطئ الأمر","https://www.aldiwan.net/poem62575.html","الوافر"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54896","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[77,"نعمنا بوصل من حبيب مساعد","https://www.poetsgate.com/ViewPoem.aspx?id=34091",""],[77,"يا سيدي أفديك بالنفس","https://www.poetsgate.com/ViewPoem.aspx?id=34187",""],[110,"أجرني بالتواصل بعد بعدك","https://www.aldiwan.net/poem16394.html","الوافر"],[136,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[145,"منا القلب عطفا بالمسيء برحمة","https://www.aldiwan.net/poem4458.html","الطويل"],[151,"ولا تزل في سعود","https://www.aldiwan.net/poem68536.html","المجتث"],[151,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[161,"غايات جودك لا تبطي عن الامل","https://www.aldiwan.net/poem59074.html","البسيط"],[167,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[207,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[208,"يا دار أسماء بين السفح فالرحب","https://www.aldiwan.net/poem27978.html","البسيط"],[211,"تخطرت والتفتت كالرشا","https://www.aldiwan.net/poem13346.html","السريع"],[211,"طاب الزمان وجاء الدهر يعتذر","https://www.aldiwan.net/poem13432.html","البسيط"],[211,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[211,"سلام كعرف المسك يعبق بالنشر","https://www.aldiwan.net/poem13525.html","الطويل"],[212,"حضرنا ننظر النهرا","https://www.aldiwan.net/poem46274.html","مجزوء الوافر"],[238,"أسعدك الله بالولد","https://www.aldiwan.net/poem18161.html","مخلع البسيط"],[262,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[304,"وحمراء لما ترشفتها","https://www.aldiwan.net/poem57792.html","المتقارب"],[305,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[327,"سألت الديار وأطلالها","https://www.aldiwan.net/poem44248.html","المتقارب"],[343,"ما بين اخفاق حبي","https://www.aldiwan.net/poem55335.html","المجتث"],[362,"رسول الله ضاق بي القضاء","https://www.aldiwan.net/poem68144.html","الوافر"],[365,"وقيت ما فيك أتقيه","https://www.aldiwan.net/poem60580.html","مخلع البسيط"],[365,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[371,"ولما أتانا والديار بعيدة","https://www.aldiwan.net/poem1329.html",""],[392,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[404,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[404,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[417,"سقى الله عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53888.html","الطويل"],[417,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[417,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[417,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[430,"إلى علياك تبتسم المعالي","https://www.aldiwan.net/poem39834.html","الوافر"],[430,"يا غائبا عن حبه","https://www.aldiwan.net/poem41005.html","مجزوء الرجز"],[433,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[459,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[466,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[478,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[501,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[515,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[516,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[530,"ولو كان لي ملء البسيطة ألسن","https://www.aldiwan.net/poem37398.html","الطويل"],[539,"تبدت نجوم الفن في أفق الغرب","https://www.aldiwan.net/poem48272.html","عموديه"],[552,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[552,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[552,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[556,"ففر زهير خيفة من عقابنا","https://www.aldiwan.net/poem1924.html","الطويل"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[559,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[559,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[563,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[563,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[564,"إذا جلت فكرا في العلوم عويصها","https://www.aldiwan.net/poem13612.html","الطويل"],[576,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"],[576,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[576,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"]],"verses":[["وَنَلقى قَبلَ لُقيانِ المَنايا","رِماحَ الداءِ تَطعَنُ في الجُسومِ",0,"م",1,0],["وَنَلقى أَشهَبَ الأَمواهِ تَرمي","بِرَغبَتِنا إِلى شِبهِ البُحورِ",1,"ر",1,0],["وَنَل مِن نَسيمِ الرَندِ وَالبانِ نَفحَةً","فَهَيهاتَ وادٍ يُنبِتُ البانَ وَالرَندا",2,"د",2,0],["وَنِلتُ حَديثاً كادَ يَغشى مَواقِفي","مِنَ القُلَّةِ الشَّماءِ بالأَعصَمِ الفَردِ",3,"د",1,0],["ونلْثِمُ ما بيْنَ النّحورِ الى الطُّلا","وإنْ هيَ غصّتْ بالحُلى والقلائِدِ",4,"د",1,0],["وَنَلبَسُ في الحَربِ نَسجَ الحَديدِ","وَنَسحَبُ في السِلمِ خَزّاً وَقَزّا",5,"ز",2,0],["وَنِلنا سِقاطاً مِن حَديثٍ كَأَنَّهُ","جَنى النَحلِ مَمزوجاً بِماءِ الوَقائِعِ",6,"ع",1,0],["ونُلزِمهنّ قعر البيت قهراً","ونحسبهنّ فيه من الهَنات",7,"ت",1,0],["ونلجأ عند الأدّكار إلى البِكا","ونفزع من بعد البكاء إلى الصبر",8,"ر",1,0],["وَنُلفَى في الجُدُوبَة أهلَ خصبٍ","وفي ظُلَم الحَنَادس مُقمرينَا",9,"ن",2,0],["ونلقى منك محتقِراً لُهاهُ","وحولَ أخسِّها قَدْراً يُحامُ",10,"م",1,0],["وَنَلومُ هاجِرَها عَلى نِسيانِهِ","وَاللائِمِ الناسينَ أَوَّلُ ناسي",11,"س",2,0],["وَنَلقى الجَوَّ صاعِقَةً وَرَعداً","إِذا قَصرُ الدُبارَةِ فيهِ غاما",12,"م",2,0],["وَنَلْ مِنْ عَظيمِ الوِزْرِ كُلَّ عَظيمةٍ","إِذا ذُكِرَتْ خافَ الحَفيظانِ نَارَهَا",13,"ر",3,0],["وَنُلحى في مُواصَلَةِ الغَواني","وَما تُلحى الغَواني في الصُدودِ",14,"د",1,0],["وَنِلتُ خَسيساً مِنهُ ثُمَّ تَرَكتُهُ","وَأَقلَعتُ عَنهُ وَهوَ مُنعَفِرٌ فَردُ",15,"د",1,0],["وَنَلومُ طَلحَةَ وَالزُبَيرَ كِلَيهِما","وَنُعَنِّفُ الصِدّيقَ وَالفاروقا",16,"ق",2,0],["ونِلْتَ أَمنعَهُم حِصْناً وأبعَدَهم","فليسَ تَعصِمُهُمْ من بأسِكَ العِصَمُ",17,"م",1,0],["وَنِلتُ مِن فَضلِها ما كانَ أَسأَرَهُ","بِقَعرِها مِن رُضابٍ نَشرُهُ نَفَحا",18,"ح",2,0],["وَنِلتَ فيهِ ما تَرومُ مِن مِنىً","وَعِشتَ في عِزٍّ وَبَأسٍ وَمِنَن",19,"ن",1,0],["وَنِلتُ بِها سُؤلي مِنَ العِزِّ لا الغِنى","وَما عُدَّ مَن عافَ الهِباتِ بِخائِبِ",20,"ب",1,0],["ونلتَ سعادةً ما اسودّ ليلٌ","وعينَ كرامةٍ ما ابيضّ صبحُ",21,"ح",1,0],["وَنَل نَظرَةً مِن نُضرَةِ الحُسنِ وَاِنتَعِش","بِغُرَّةِ رَقراقِ الشَبابِ غَريرِ",22,"ر",1,0],["وَنَلهو بِالحِسانِ فَلا تُرينا","تَبَرُّمَ عاتِبٍ وَمَلالَ قالِ",23,"ل",1,0],["وَنِلتَ بدارِهم ما رُمتَ منهم","فهل لك بعد ذلكَ من مرامِ",24,"م",1,0],["وَنِلهُ كَيفَما شِئتَ اِق","تِضاباً وَعَلى مَوعِد",25,"د",1,0],["وَنِلتَ مِنَ الشَبارِقِ وَالقَلايا","وَأُعطيتَ البَنَفسَجَ في الخُمارِ",26,"ر",1,0],["وَنلْثَمُ أَرْضاً فَاخَرَ التِّبْرَ تُرْبُهَا","وَنافَسَ أَدْنَى مَرْوِهَا غَالِيَ الدُّرِّ",27,"ر",1,0],["ونلبس الأشعار من حسنها","ما شاءه إبداعنا أن يكون",28,"ن",1,0],["ونلنا كما شاء الهوى عقب النوى","على رغم أنف من عدو وحاسد",29,"د",1,0],["ونلثم ما بين النحور إلى الطلى","وإن هي غصت بالحلى والقلائد",29,"د",1,0],["ونلت منه شرفا خالدا","يأبى دروس المرء في الرمس",30,"س",1,0],["وَنَلثم اقحوان الثَغر طَوراً","عَلى جَزع وَنَهصر غُصن قَدك",31,"ك",1,0],["ونلت معارفاً رقت ودقت","فصرت الفرد في هذا الزمانِ",32,"ن",1,0],["ونلتم شرابا طيبا من ودادنا","وعلما وطيبتم بطيب كفايتي",33,"ي",1,0],["ونلت قصدك ما ب","ين راحة وقعود",34,"د",1,0],["وَنِلنا الهُدى مِن وَبلِها بَعدَ طَلِّها","بيُمنِ نَبيٍّ فَضلُهُ أَصلُ فَضلِها",35,"ه",2,0],["ونلت منها ونالت راحتي بها","ما عنه يقصر ابعا كل منتول",36,"ل",1,0],["ونلتُ لدَيكَ رفعاً في مَحلِّي","تُناقضُهُ بوضعٍ في رِحالي",37,"ل",2,0],["ونلنا من منى كلّ الأماني","وبتنا في رباها موقنينا",38,"ن",2,0],["وَنِلتَ مَجداً فَحاذِر أَن تُدَنِّسَهُ","أَبٌ كَريمٌ وَجَدٌّ غَيرُ مُؤتَشَبِ",39,"ب",1,0],["ونلت بالفرع وبالفرق ما","قد حير الطرف وما ادهشا",40,"ش",2,0],["ونلت بالعز ما لا ناله ملك","وحزت بالمجد ما لا حازه بشر",41,"ر",1,0],["ونلت فخارا ما بدا الروض يانعا","وما رنحت اعطافه نسمة الفجر",42,"ر",1,0],["ونلت من الاقبال والسعد والعلا","محلّا به تعلو على الشمس والبدر",43,"ر",1,0],["ونلمح في جوانبه","بريق العسجد الذائب",44,"ب",1,0],["وَنِلْتًمُ خَيْرَ ذَا الْبَلَدْ","بِوَالِدٍ مَعْ مَا وَلَدْ",45,"د",1,0],["ونلت به نصراً عزيزا على العدي","ولا خاذل والله يمنحك النصرا",46,"ر",2,0],["ونلت المسرات دون الورى","لأني سبقتهمو بالكميت",47,"ت",1,0],["ونلت من ربي رضا وقربه","يكون فيها قطع كل الأسباب",48,"ب",1,0],["وَنِلتُ مَجالِسَ مَشهورَةً","يُنالُ الكِرامُ بِمَن نالَها",49,"ل",3,0],["ونلت من كل شكل","وحزتُ من كل جنس",50,"س",1,0],["وَنِلت مِن السِيادَة مُنتَهاها","عُلُوّ دون رُتبَه العَلاء",51,"ا",2,0],["ونِلْتَ من صَفْوِ كُلِّ عِزٍّ","ما مثْلُ عُلْياكَ يَقْتَضيه",52,"ي",2,0],["ونِلْتُ منه نَوالاً لا يُشاكِلُه","إلاّ قِطارُ الغَوادي وهْي تَنْهَمِر",53,"ر",1,0],["وَنِلْتُ مِنَ الأيّامِ مَا كُنْتُ راجيِاً","وُقُلْتُ لِدَهْري: كيفَ ما شِئتَ فَاصنْعَا",54,"ع",2,0],["ونلت من ربي رضا وقربه","وكل خصله لن تبور",55,"ر",1,0],["ونل منها بعض ما رامه","في قبض ما يصرف في المصرف",56,"ف",1,0],["ونُلبِس هذا القلب ثوبَ ندامة","على ما أتانا من جناياته كسبا",57,"ب",2,0],["ونلتُ كما أهوى بوصلي لها المنى","ولم أنْسَها كالغصن إذ مال وانثنى",58,"ن",2,0],["ونِلْتُم به في كلّ يوم مسرَّةً","يجيء بها في مثل يومكم غد",59,"د",1,0],["ونلت بتوفيق العناية رتبة","عدوَّك يلقى دونها مورد الردى",60,"د",2,0],["ونِلْتُ بك المرادَ من الأماني","فَنِلْتَ من المهيمنِ ما تريد",61,"د",1,0],["ونل عزاً وزد صدقاً وأرخ","سما عدلية الأحكام رفعه",62,"ع",2,0],["ونل نوالا فاض من","تقبيل كفّ ذي سعه",63,"ع",2,0],["ونلْتَ من رُتَب العَليا وغايتِها","ثمّ استوَتْ في انحطاطٍ بعدَها الرُّتَبُ",64,"ب",1,0],["ونلْ بيمينك الدنيا جميعاً","وأطبقْها على السبعِ الطباقِ",65,"ق",1,0],["ونَلْ وأبوك العزَّ ما حنَّ فاقدٌ","وقام على السَّبْع الطِّباقِ مديرُها",66,"ر",3,0],["وَنَلتَقي والرِّياح الهُوج تَصفَعُنا","فَما تُُشابِكُ أهدابا ً مَآ قينا !",67,"ن",2,0],["ونلتُ مِنَ الشَّعرِ الثريا تطاولاً","فيا ليتهمْ نالوا على قربهِ الثرى",68,"ر",2,0],["ونِلْتُ كلَّ مطْلَبي","وتمَّ لي مُؤَمَّلي",69,"ل",2,0],["ونلثِمُ من ثنايا الجِذْعِ برقاً","فنحسَبُهُ ثُغورَ بَني حِسابِ",70,"ب",1,0],["ونلت من عظماء الجيش تكرمة","وخلة حرست من عارض الخلل",71,"ل",1,0],["ونِلْتُ مِنَ الإحْسانِ مالَوْ أقَلُّهُ","يُوازِنُ قَدْرِي كانَ أكْثَر منْ قَدْرِي",72,"ر",2,0],["ونِلتُم أسمَى حُظوةٍ ومكَانةٍ","لَدَى المِلكِ الحامِي الحِمَى عاهِلِ الشَّعبِ",73,"ب",1,0],["وَنَلثمُ في رَبْعِ الذّين تحمّلوا","من التُّربِ آثار الخُطا والأخامصِ",74,"ص",1,0],["ونِلتُ ما ذِيدَ عنه كلُّ مُلتَمِسٍ","عفواً وطامَنْ عنه كلُّ جبّارِ",75,"ر",1,0],["وَنِلتموها بَيعةً فلتةً","حَتّى تَرى العين الّذي قُدِّرا",76,"ر",2,0],["وَنَلقى قُمَيرا في المَكَرِّ وَحَبتَراً","وَجارَهُم في الفَجرِ يَدعونَ حاطِما",77,"م",2,0],["ونلنا فضلهُ أرِّخ","برحلةِ قُدْسه الأكرمْ",78,"م",1,0],["ونلت على قدر المنى رتب المنى","وما يستوي الولهان والفارغ الخلو",79,"و",1,0],["ونلجأ في شأننا كله","إليه ليكفيَنا ما أهمّْ",80,"م",1,0],["ونلنا الصفا عند الصفا يوم سعينا","إلى مروة التركيب فوق المراكب",81,"ب",1,0],["ونِلتَ في اللُّطفِ سِرّاً طابَ عُنصُرُهُ","فكانَ من حاسدِيهِ ألطَفُ النَسَمِ",82,"م",1,0],["ونَلقَى من عَواصِفِها غُباراً","حسِبناهُ لأوجُهِنا جَمالا",83,"ل",2,0],["وَنِلتُ لَذيذَ العِلمِ بِالذَوقِ وَحدَهُ","وَكُلّ لَذيذٍ غَيرُهُ كَهَبيدِ",84,"د",1,0],["ونِلْتُ ما نِلْتُ مما لم أَهُمَّ به","ولا تَرقَّتْ إِليه هِمَّةُ الأَمَلِ",85,"ل",1,0],["ونلتُ في نَوْمِي وفي يقْظَتي","رؤْيايَ في نوْمي وفي حُلْمي",86,"م",2,0],["ونلتُ منه ولا كفراً لأَنعمه","فوقَ الَّذِي كانَ في ظَنِّي وفي أَمَلِي",87,"ل",2,0]]}