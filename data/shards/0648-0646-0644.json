,""],[5344,"تم إيداع الراتب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180711",""],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5644,"خيل البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=199970",""],[5720,"يَا عِيْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199358",""],[5720,"صَاحِبُ الشَّرْعِﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200030",""],[5720,"أَهْلُ الْبِر","https://www.poetsgate.com/ViewPoem.aspx?id=206964",""],[5895,"دُمُوع ُالأَقْصَى","https://www.poetsgate.com/ViewPoem.aspx?id=202143",""],[5907,"تعب ضيقه!","https://www.poetsgate.com/ViewPoem.aspx?id=176258",""],[5997,"غريب","https://www.poetsgate.com/ViewPoem.aspx?id=214230",""],[6031,"هَنَّاكَ رَبُّكَ ما أولاَكَ من نِعَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=46367",""],[6052,"أبواب النفوس","https://www.poetsgate.com/ViewPoem.aspx?id=34966",""],[6069,"يا شاعراً أودعت أنامله","https://www.poetsgate.com/ViewPoem.aspx?id=105720",""],[6097,"خُطى القَدَر","https://www.poetsgate.com/ViewPoem.aspx?id=197430",""],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[6221,"رحلة في دروب الذكريات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64919&r=&rc=3",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""],[556,"خليلي ألا عجبتما بالقلائص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24264&r=&rc=3",""]],"verses":[["وَنَلقى قَبلَ لُقيانِ المَنايا","رِماحَ الداءِ تَطعَنُ في الجُسومِ",0,"م",1,0],["وَنَلقى أَشهَبَ الأَمواهِ تَرمي","بِرَغبَتِنا إِلى شِبهِ البُحورِ",1,"ر",1,0],["وَنَل مِن نَسيمِ الرَندِ وَالبانِ نَفحَةً","فَهَيهاتَ وادٍ يُنبِتُ البانَ وَالرَندا",2,"د",2,0],["وَنِلتُ حَديثاً كادَ يَغشى مَواقِفي","مِنَ القُلَّةِ الشَّماءِ بالأَعصَمِ الفَردِ",3,"د",1,0],["ونلْثِمُ ما بيْنَ النّحورِ الى الطُّلا","وإنْ هيَ غصّتْ بالحُلى والقلائِدِ",4,"د",1,0],["وَنَلبَسُ في الحَربِ نَسجَ الحَديدِ","وَنَسحَبُ في السِلمِ خَزّاً وَقَزّا",5,"ز",2,0],["وَنِلنا سِقاطاً مِن حَديثٍ كَأَنَّهُ","جَنى النَحلِ مَمزوجاً بِماءِ الوَقائِعِ",6,"ع",1,0],["ونُلزِمهنّ قعر البيت قهراً","ونحسبهنّ فيه من الهَنات",7,"ت",1,0],["ونلجأ عند الأدّكار إلى البِكا","ونفزع من بعد البكاء إلى الصبر",8,"ر",1,0],["وَنُلفَى في الجُدُوبَة أهلَ خصبٍ","وفي ظُلَم الحَنَادس مُقمرينَا",9,"ن",2,0],["ونلقى منك محتقِراً لُهاهُ","وحولَ أخسِّها قَدْراً يُحامُ",10,"م",1,0],["وَنَلومُ هاجِرَها عَلى نِسيانِهِ","وَاللائِمِ الناسينَ أَوَّلُ ناسي",11,"س",2,0],["وَنَلقى الجَوَّ صاعِقَةً وَرَعداً","إِذا قَصرُ الدُبارَةِ فيهِ غاما",12,"م",2,0],["وَنَلْ مِنْ عَظيمِ الوِزْرِ كُلَّ عَظيمةٍ","إِذا ذُكِرَتْ خافَ الحَفيظانِ نَارَهَا",13,"ر",3,0],["وَنُلحى في مُواصَلَةِ الغَواني","وَما تُلحى الغَواني في الصُدودِ",14,"د",1,0],["وَنِلتُ خَسيساً مِنهُ ثُمَّ تَرَكتُهُ","وَأَقلَعتُ عَنهُ وَهوَ مُنعَفِرٌ فَردُ",15,"د",1,0],["وَنَلومُ طَلحَةَ وَالزُبَيرَ كِلَيهِما","وَنُعَنِّفُ الصِدّيقَ وَالفاروقا",16,"ق",2,0],["ونِلْتَ أَمنعَهُم حِصْناً وأبعَدَهم","فليسَ تَعصِمُهُمْ من بأسِكَ العِصَمُ",17,"م",1,0],["وَنِلتُ مِن فَضلِها ما كانَ أَسأَرَهُ","بِقَعرِها مِن رُضابٍ نَشرُهُ نَفَحا",18,"ح",2,0],["وَنِلتَ فيهِ ما تَرومُ مِن مِنىً","وَعِشتَ في عِزٍّ وَبَأسٍ وَمِنَن",19,"ن",1,0],["وَنِلتُ بِها سُؤلي مِنَ العِزِّ لا الغِنى","وَما عُدَّ مَن عافَ الهِباتِ بِخائِبِ",20,"ب",1,0],["ونلتَ سعادةً ما اسودّ ليلٌ","وعينَ كرامةٍ ما ابيضّ صبحُ",21,"ح",1,0],["وَنَل نَظرَةً مِن نُضرَةِ الحُسنِ وَاِنتَعِش","بِغُرَّةِ رَقراقِ الشَبابِ غَريرِ",22,"ر",1,0],["وَنَلهو بِالحِسانِ فَلا تُرينا","تَبَرُّمَ عاتِبٍ وَمَلالَ قالِ",23,"ل",1,0],["وَنِلتَ بدارِهم ما رُمتَ منهم","فهل لك بعد ذلكَ من مرامِ",24,"م",1,0],["وَنِلهُ كَيفَما شِئتَ اِق","تِضاباً وَعَلى مَوعِد",25,"د",1,0],["وَنِلتَ مِنَ الشَبارِقِ وَالقَلايا","وَأُعطيتَ البَنَفسَجَ في الخُمارِ",26,"ر",1,0],["ونُلْحِفُ النَّارَ جَزْلاً وَهْيَ بَارِزَةٌ","ولاَ نَلُطُّ وَرَاءَ النّارِ بِالسُّتَرِ",27,"ر",1,0],["ونُلْصِقُ بالكُوم الجِلاَدِ وقَدْ رَغَتْ","أَجِنَّتُهَا ولَمْ تُنَضِّجْ لَهَا حَمْلاَ",28,"ل",2,0],["وَنلْثَمُ أَرْضاً فَاخَرَ التِّبْرَ تُرْبُهَا","وَنافَسَ أَدْنَى مَرْوِهَا غَالِيَ الدُّرِّ",29,"ر",1,0],["ونلبس الأشعار من حسنها","ما شاءه إبداعنا أن يكون",30,"ن",1,0],["ونلنا كما شاء الهوى عقب النوى","على رغم أنف من عدو وحاسد",31,"د",1,0],["ونلثم ما بين النحور إلى الطلى","وإن هي غصت بالحلى والقلائد",31,"د",1,0],["ونلت منه شرفا خالدا","يأبى دروس المرء في الرمس",32,"س",1,0],["وَنَلثم اقحوان الثَغر طَوراً","عَلى جَزع وَنَهصر غُصن قَدك",33,"ك",1,0],["ونلت معارفاً رقت ودقت","فصرت الفرد في هذا الزمانِ",34,"ن",1,0],["ونلتم شرابا طيبا من ودادنا","وعلما وطيبتم بطيب كفايتي",35,"ي",1,0],["ونلت قصدك ما ب","ين راحة وقعود",36,"د",1,0],["وَنِلنا الهُدى مِن وَبلِها بَعدَ طَلِّها","بيُمنِ نَبيٍّ فَضلُهُ أَصلُ فَضلِها",37,"ه",2,0],["ونلت منها ونالت راحتي بها","ما عنه يقصر ابعا كل منتول",38,"ل",1,0],["ونلتُ لدَيكَ رفعاً في مَحلِّي","تُناقضُهُ بوضعٍ في رِحالي",39,"ل",2,0],["ونلنا من منى كلّ الأماني","وبتنا في رباها موقنينا",40,"ن",2,0],["وَنِلتَ مَجداً فَحاذِر أَن تُدَنِّسَهُ","أَبٌ كَريمٌ وَجَدٌّ غَيرُ مُؤتَشَبِ",41,"ب",1,0],["ونلت بالفرع وبالفرق ما","قد حير الطرف وما ادهشا",42,"ش",2,0],["ونلت بالعز ما لا ناله ملك","وحزت بالمجد ما لا حازه بشر",43,"ر",1,0],["ونلت فخارا ما بدا الروض يانعا","وما رنحت اعطافه نسمة الفجر",44,"ر",1,0],["ونلت من الاقبال والسعد والعلا","محلّا به تعلو على الشمس والبدر",45,"ر",1,0],["ونلمح في جوانبه","بريق العسجد الذائب",46,"ب",1,0],["وَنِلْتًمُ خَيْرَ ذَا الْبَلَدْ","بِوَالِدٍ مَعْ مَا وَلَدْ",47,"د",1,0],["ونلت به نصراً عزيزا على العدي","ولا خاذل والله يمنحك النصرا",48,"ر",2,0],["ونلت المسرات دون الورى","لأني سبقتهمو بالكميت",49,"ت",1,0],["ونلت من ربي رضا وقربه","يكون فيها قطع كل الأسباب",50,"ب",1,0],["وَنِلتُ مَجالِسَ مَشهورَةً","يُنالُ الكِرامُ بِمَن نالَها",51,"ل",3,0],["ونلت من كل شكل","وحزتُ من كل جنس",52,"س",1,0],["وَنِلت مِن السِيادَة مُنتَهاها","عُلُوّ دون رُتبَه العَلاء",53,"ا",2,0],["ونِلْتَ من صَفْوِ كُلِّ عِزٍّ","ما مثْلُ عُلْياكَ يَقْتَضيه",54,"ي",2,0],["ونِلْتُ منه نَوالاً لا يُشاكِلُه","إلاّ قِطارُ الغَوادي وهْي تَنْهَمِر",55,"ر",1,0],["وَنِلْتُ مِنَ الأيّامِ مَا كُنْتُ راجيِاً","وُقُلْتُ لِدَهْري: كيفَ ما شِئتَ فَاصنْعَا",56,"ع",2,0],["ونلت من ربي رضا وقربه","وكل خصله لن تبور",57,"ر",1,0],["ونل منها بعض ما رامه","في قبض ما يصرف في المصرف",58,"ف",1,0],["ونُلبِس هذا القلب ثوبَ ندامة","على ما أتانا من جناياته كسبا",59,"ب",2,0],["ونلتُ كما أهوى بوصلي لها المنى","ولم أنْسَها كالغصن إذ مال وانثنى",60,"ن",2,0],["ونِلْتُم به في كلّ يوم مسرَّةً","يجيء بها في مثل يومكم غد",61,"د",1,0],["ونلت بتوفيق العناية رتبة","عدوَّك يلقى دونها مورد الردى",62,"د",2,0],["ونِلْتُ بك المرادَ من الأماني","فَنِلْتَ من المهيمنِ ما تريد",63,"د",1,0],["ونل عزاً وزد صدقاً وأرخ","سما عدلية الأحكام رفعه",64,"ع",2,0],["ونل نوالا فاض من","تقبيل كفّ ذي سعه",65,"ع",2,0],["ونلْتَ من رُتَب العَليا وغايتِها","ثمّ استوَتْ في انحطاطٍ بعدَها الرُّتَبُ",66,"ب",1,0],["ونلْ بيمينك الدنيا جميعاً","وأطبقْها على السبعِ الطباقِ",67,"ق",1,0],["ونَلْ وأبوك العزَّ ما حنَّ فاقدٌ","وقام على السَّبْع الطِّباقِ مديرُها",68,"ر",3,0],["وَنَلتَقي والرِّياح الهُوج تَصفَعُنا","فَما تُُشابِكُ أهدابا ً مَآ قينا !",69,"ن",2,0],["ونلتُ مِنَ الشَّعرِ الثريا تطاولاً","فيا ليتهمْ نالوا على قربهِ الثرى",70,"ر",2,0],["ونِلْتُ كلَّ مطْلَبي","وتمَّ لي مُؤَمَّلي",71,"ل",2,0],["ونلثِمُ من ثنايا الجِذْعِ برقاً","فنحسَبُهُ ثُغورَ بَني حِسابِ",72,"ب",1,0],["ونلت من عظماء الجيش تكرمة","وخلة حرست من عارض الخلل",73,"ل",1,0],["ونِلْتُ مِنَ الإحْسانِ مالَوْ أقَلُّهُ","يُوازِنُ قَدْرِي كانَ أكْثَر منْ قَدْرِي",74,"ر",2,0],["ونِلتُم أسمَى حُظوةٍ ومكَانةٍ","لَدَى المِلكِ الحامِي الحِمَى عاهِلِ الشَّعبِ",75,"ب",1,0],["وَنَلثمُ في رَبْعِ الذّين تحمّلوا","من التُّربِ آثار الخُطا والأخامصِ",76,"ص",1,0],["ونِلتُ ما ذِيدَ عنه كلُّ مُلتَمِسٍ","عفواً وطامَنْ عنه كلُّ جبّارِ",77,"ر",1,0],["وَنِلتموها بَيعةً فلتةً","حَتّى تَرى العين الّذي قُدِّرا",78,"ر",2,0],["وَنَلقى قُمَيرا في المَكَرِّ وَحَبتَراً","وَجارَهُم في الفَجرِ يَدعونَ حاطِما",79,"م",2,0],["ونلنا فضلهُ أرِّخ","برحلةِ قُدْسه الأكرمْ",80,"م",1,0],["ونلت على قدر المنى رتب المنى","وما يستوي الولهان والفارغ الخلو",81,"و",1,0],["ونلجأ في شأننا كله","إليه ليكفيَنا ما أهمّْ",82,"م",1,0],["ونلنا الصفا عند الصفا يوم سعينا","إلى مروة التركيب فوق المراكب",83,"ب",1,0],["ونِلتَ في اللُّطفِ سِرّاً طابَ عُنصُرُهُ","فكانَ من حاسدِيهِ ألطَفُ النَسَمِ",84,"م",1,0],["ونَلقَى من عَواصِفِها غُباراً","حسِبناهُ لأوجُهِنا جَمالا",85,"ل",2,0],["وَنِلتُ لَذيذَ العِلمِ بِالذَوقِ وَحدَهُ","وَكُلّ لَذيذٍ غَيرُهُ كَهَبيدِ",86,"د",1,0],["ونِلْتُ ما نِلْتُ مما لم أَهُمَّ به","ولا تَرقَّتْ إِليه هِمَّةُ الأَمَلِ",87,"ل",1,0],["ونلتُ في نَوْمِي وفي يقْظَتي","رؤْيايَ في نوْمي وفي حُلْمي",88,"م",2,0],["ونلتُ منه ولا كفراً لأَنعمه","فوقَ الَّذِي كانَ في ظَنِّي وفي أَمَلِي",89,"ل",2,0],["ونلتُ مارمتُ معتزاً كَذِي يَزَنٍ","او مثل سابورَ يرقى عرشَ أَهوازِ",90,"ز",1,0],["ونلت رتبة مجد دونها زحل","قد كل دون مداها كل دراك",91,"ك",1,0],["وَنِلتَ مَنزلة لا شَكَ أَنتَ لَها","أَهل بِمَجدٍ تَليدٍ غَير مَسبوق",92,"ق",1,0],["وَنِلت مِن الأَيّام ما كُنتُ أَرتَجي","بِطَلعة مَن يحيي مآثرَ تالده",93,"د",2,0],["وَنلت ما رمت في وَصفي لدولته","بِما تَزيد بِهِ في تُونس شمما",94,"م",2,0],["وَنلتَ مِن العَلياء ما أَنتَ طالب","وَربك بِالتَمييز في الحال فَضَّلك",95,"ك",1,0],["وَنلت عِندَ مِنى كُل المُنى وَرضي","عَنكَ الإِلَه فَأَنتَ اليَوم مَسرور",96,"ر",1,0],["ونلتُ من الجاه الجميل ملابساً","عليه بغير الروح والله لم أُرْشِ",97,"ش",1,0],["ونلتم منزلاً في الحال فيها","مقاصدكم وفزتم بالنجاحِ",98,"ح",1,0],["ونلت على قدر الضنى حق أجره","وما كان أقساه ضنى وأشدَّهُ",99,"د",2,0],["ونلتمُ في السنين الخمس ما عجزت","عنه الفراعين من ملك وتشييد",100,"د",1,0],["ونلت حسن الذكر والمعاليا","أولى من العجز الذي أبكانيا",101,"ي",2,0],["ونلهو به حتى نهب فلا نرى","له أثراً بين العوالم باقيا",102,"ي",2,0],["وَنِلتَ عَلى العَلياءِ خَيرَ مَغانِم","وَكُنتَ هِزَبراً ذا اِبتِسام مَباسِمِ",103,"م",1,0],["وَنِلتَ مُراداً لَم تَنلهُ أوايلٌ","وَلَيسَ لَهُ يَوماً تَطولُ اللَّواحِقُ",104,"ق",1,0],["وَنِلت الّذي تَرجو ما أَنت آملٌ","وَدُمتَ بِحفظِ اللَّهِ وَاللّطف محتَفّا",105,"ف",2,0],["ونِلْنا به وِتْرَ العطاء وَشَفْعَهُ","كأنّا أَقَمْنا نحوه الوتْرَ والشَّفْعا",106,"ع",2,0],["وَنِلْنَا بِهِ جَاهاً وَفَخْراً وَمنْعَةً","وَفي دِينِنَا لَمْ تَخْشَ غَيَّا وَبِدْعَةً",107,"ه",1,0],["وَنِلْنَا بِهِ جَاهاً مَعَ الْقَصْدِ وَالْمُنى","نَبيٌّ لَهُ الآيَاتُ تَشْهَدُ بِالثَّنَا",108,"ن",2,0],["ونلثَمُ من ساحاتها وعِراصهَا","مواطئَ أقدام الظِبّاء الرواتعِ",109,"ع",1,0],["ونلت ما ترتجيه من أمل","تامله في أخي الندى ولدك",110,"ك",1,0],["وَنِلْتَ بِحُسْنِ الرَّأيِ مَا لاَ يَنَالُهُ","سِوَاكَ بِبِيضِ الهِنْدِ خيفَ انْفصَامُهَا",111,"م",3,0],["ونلت من راحتها نهلة","أطفى بها ما سامنى من أوار",112,"ر",1,0],["ونُلتَني كلَّ أمورِ الورى","مَنْ قد مضى منهم وَمنْ قد بَقِي",113,"ق",2,0],["ونلْتُ في مَعْلوم ديِنِي صِحَةً","كمَ جدَّ فيه طَالبٌ فَلَمْ يَنَلْ",114,"ل",1,0],["وَنلت ما أَشتهي فيها وَلا حذرا","مِن الرَّقيب فتخفى مِنهُ أَسرار",115,"ر",1,0],["ونلهو ثم نضحك ملء فينا","وما فينا احترام واحتشام",116,"م",1,0],["ونلت ختاما شريفاً تساما","وحزت مقاما فهاك ودادي",117,"د",2,0],["ونلت دوام تقريب لرب","رحيم قد وقاك من الصروف",118,"ف",1,0],["ونلتَ خمساً ولم يظفر بها أَحَدٌ","في الأنبياء ولا في الرسل كلّهم",119,"م",1,0],["ونلت بالجد والجد اللذين هما","امنيتا كل نفسٍ كل مطلب",120,"ب",1,0],["وَنِلْنَا كلَّ ما نَهْواهُ","مِن لَذَّاتِنَا جَهْرا",121,"ر",2,0],["ونلت مرادا ايها القبر لم يفز","به قصر غمدان نعم لو تمناه",122,"ا",2,0],["ونُلْزمهم أثقال كلَّ مهمةٍ","وكلهمُ رحبٌ بها غير سائمِ",123,"م",1,0],["ونلبس من ليل شَرخٍ سُتوراً","ونسحب من ذيل عيشٍ فضولا",124,"ل",2,0],["ونلتَ المنى في ماجدٍ الخِيم سيّدٍ","بدا فضُله في العالمين وخيرُهُ",125,"ر",2,0],["ونلتَ في الولد الزاكي الأجلّ أبي","عبد الإله المنى والعز والحَبَرا",126,"ر",2,0],["ونلتُ ما نِلتُ أنّه كذبٌ","فآهِ لو صدقت لى منكمُ الحُلُمُ",127,"م",1,0],["ونلت ما لم ينله في السماء","مقرّبٌ سواك على التفصيل والجمل",128,"ل",1,0],["ونلتُ البراءةَ من