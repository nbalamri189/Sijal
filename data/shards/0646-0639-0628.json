{"poems":[[90,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[29,"بان الخليط فما له من مطلب","https://www.aldiwan.net/poem5661.html","الكامل"],[29,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[12,"ومرقبة عنقاء يقصر دونها","https://www.aldiwan.net/poem1216.html",""],[35,"نعب الغراب ببين ليلى غدوة","https://www.aldiwan.net/poem25890.html","الكامل"],[78,"نعب الغراب فقلت أكذب طائر","https://www.aldiwan.net/poem39295.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54222","الرمل"],[96,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[29,"بَانَ الخَليطُ فَمَا لَهُ مِنْ مَطْلَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16342&r=&rc=6",""],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[295,"لا تلم أن هجرت أيام أنسى","https://www.aldiwan.net/poem11670.html","الخفيف"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[454,"مدى كتابك غابات وأنهار","https://www.aldiwan.net/poem983.html",""],[505,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[510,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107221","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206241",""],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130214","الكامل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45455","البسيط"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144431","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205769","الخفيف"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131995","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103028","الكامل"],[4271,"","https://poetry.dctabudhabi.ae/diwan/poem/27012","الكامل"],[5409,"ليس يجدي من الضعيف الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=155309",""],[5431,"مشرقاتٍ وجوهنا وقدامى...","https://www.poetsgate.com/ViewPoem.aspx?id=198390",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[454,"مدى كتابك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82673&r=&rc=37",""]],"verses":[["نعبُد اللّه والعبادة لحن","عند بعضٍ وعند بعض عويل",0,"ل",1,0],["نَعَبَ الغُرابُ فَقُلتُ بَينٌ عاجِلٌ","ما شِئتَ إِذ ظَعَنوا لِبَينٍ فَاِنعَبِ",1,"ب",1,0],["نَعَبنا بِجانِبَيهِ المَشيَ نَعباً","خَواضِعَ وَهوَ يَنسَلِبُ اِنسِلابا",2,"ب",2,0],["نَعَبَ الغُرابُ فَقُلتُ بَينٌ عاجِلٌ","وَجَرى بِهِ الصُرَدُ الغَداةَ الأَلمَعُ",3,"ع",1,0],["نَعَبتُ إِلى أَدنى ذُراها وَقَد دَنا","مِنَ اللَيلِ مُلتَفُّ الحَديَقةِ أَسدَفُ",4,"ف",1,0],["نَعَبَ الغُرابُ بِبَينِ لَيلى غَدوَةً","إِنَّ الكِتابَ بِبَينَهُم مَخطوطا",5,"ط",2,1],["نَعَبَ الغُرابُ فقُلْتُ أَكذَبُ طائرٍ","إنْ لَمْ يُصَدّقهُ رُغاءُ بَعيرِ",6,"ر",1,1],["نَعَبَ البَيْنُ بِنَا سقياً له","فاسْتَعَدْتُ البَيْنَ لمّا نَعبا",7,"ب",2,0],["نعبّ منه بلا رفق ويظمؤنا","فنحن أصدى إليه ما ارتشفناه",8,"ا",2,0],["نَعَبَ الغُرابُ فقُلتُ بَينٌ عَاجِلٌ","ما شِئْتَ إذا ظَعَنُوا لبَينٍ فانْعَبِ",9,"ب",1,0],["نعب الغراب وللمشوق كهانة","فعلمت قطعاً أنه يعنيني",10,"ن",2,0],["نعبثَ الدهر والحوادث فيها","فتولت وغالها يوم نحس",11,"س",1,0],["نَعَبَ الغرابُ بِهَا فطارَ بأَهلِها","سِرْباً على مِثلِ الغرابِ النَّاعِبِ",12,"ب",1,0],["نعب من نبعها أحلى سلافته","عذبا ومن ثمرات العلم نمتار",13,"ر",1,0],["نعبُدُ اللهَ ولا نعبُدُ من","يُهْلِكَنْهُمْ دهرُهُمْ أَو هَلَكُوا",14,"ك",3,0],["نعبدُ من عزّنا نهاراً","ونعبدُ اللهَ في الرّواحِ",15,"ح",1,0],["نَعَبَ الغُرَابُ فَقالَ زاجِرُهُ لَنا","إِنَّ التَّفَرُّقَ يا مَشُوقُ قَرِيبُ",16,"ب",1,1],["نعبد والعبادة التذلل","لله وهو القاهر المذلل",17,"ل",1,0],["نعب الناعة أصيلا فبدا","فى النواحى كل بؤس وحزن",18,"ن",1,0],["نعبّر عن الواقع ولا هوب كذّابه","عن أوصاف لَي كلٍّ بفعله وترتيبه",19,"ب",2,0],["نعب الغراب فراعني","بالبين إذا نعب الغراب",20,"ب",1,0],["نَعبُ الأَشاهيبِ فَالأَخبارُ مَجمَعُها","وَاللَيلُ ساقِطَهٌ أَرواقُهُ داجِ",21,"ج",1,0],["نَعبَ الغُرابُ فقلتُ: مالكَ تَنعبُ؟","أنأَى أليفُكَ أم لِحالٍ تُرهبُ",22,"ب",1,1],["نعبت في الظلام تنذر عيشي","بنصيب المضيع المغبون",23,"ن",1,0],["نعبد تصديقا كما أمرتنا","ونسئل العون فماعنه غنا",24,"ن",2,0],["نعبد كى نكذب الجبريا","إذ عطل الشرع فهام غيّا",24,"ي",2,0],["نعبد بامتثال ما امرتنا","ونسئل الترك لما حذرتنا",24,"ن",2,0],["نعبد ربّا لم يزل مأمولا","ونسال الثبات والقبولا",24,"ل",2,0],["نعبد فيه صحة الشريعه","فانها الوسيلة الرفيعه",24,"ه",1,0],["نَعَبَ البُومُ في عِراصِ حِماكم","ليسَ شيءٌ سِوى الالهِ بباقِ",25,"ق",1,0],["نعبد الله اتباعا للنبي","ونرى القرآن خير الكتب",26,"ب",1,0],["نعب الغراب بها فأسمع أهلها","ما يصدع الأسماع رجع لحونه",27,"ن",2,0],["نَعَبَ الغُرابُ وَلَيتَهُ لَم يَنعَبِ","بِالبَينِ مِن سَلمى وَأُمِّ الحَوشَبِ",28,"ب",1,1],["نعب السكر قبلكم برؤوس","سخرت من فراغها الأجسام",29,"م",1,0],["نعبر الوقت في ذهول السكارى","دون خمرٍ ولذّة وندامى!",30,"م",2,0],["نعبُّ النسيم العليلَ البليلْ","نعبُّ المياه وكلَّ انْهِمَالْ",31,"ل",1,0],["نعب من نبعها أحلى سلافتها","عذبا ومن ثمرات العلم نمتار",32,"ر",1,0]]}