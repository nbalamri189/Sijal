,"https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90821","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58100","الطويل"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130266","الطويل"],[4927,"لصوص المخابرات","https://www.poetsgate.com/ViewPoem.aspx?id=80802",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5956,"الأشواقُ الجنونية","https://www.poetsgate.com/ViewPoem.aspx?id=192466",""],[5956,"وقى الله بيته شر الحريقْ","https://www.poetsgate.com/ViewPoem.aspx?id=194149",""],[6259,"ألمَّ وليلى بالكواكب أشيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59357&r=&rc=5",""],[6291,"فتوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87670&r=&rc=3",""],[2220,"رعى اللهُ طيراً على بانة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19298&r=&rc=840",""],[5190,"دعاة الشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85051&r=&rc=126",""],[572,"تَشَبَّهَ في النحوِ بالأخفشِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9392&r=&rc=249",""]],"verses":[["ولَمْ يَسْرِ مَرقوعُ الأظَلِّ على الوَجى","رَذِيّ مَطايا حَطَّ أكْوارَها السَّفْرُ",0,"ر",1,0],["ولَمْ يَسْلُبْهُمُ سَفَهٌ حُباهُمْ","وكيفَ تُزعْزِعُ الرِّيحُ الجِبالا",1,"ل",2,0],["وَلَم يَسَعَ الرَسولُ إِليَّ مِنها","بِأَحسَنِ ما يَجيءُ بِهِ الرَسولُ",2,"ل",1,0],["ولمْ يسْتَطِعْ من بعْدِ ما بَعُدَ المَدى","سِوى لوْعةٍ تعْتادُ أو مِدْحَةٍ تُهْدى",3,"د",2,0],["وَلَم يَسعَ في الأَقوامِ سَعيَكَ واحِدٌ","وَلَيسَ إِناءٌ لِلنَدى كَإِنائِكا",4,"ك",2,0],["وَلَم يَسعَ في العَلياءِ سَعيَكَ ماجِدٌ","وَلا ذو إِنىً في الحَيِّ مِثلَ قَرائِكا",4,"ك",2,0],["وَلَمْ يَسِرْ بِبَنِيهَا مِثْلَ سِرَتِهِ","سَاعٍ إِلَى النَّصْرِ لا سَاهٍ وَلا وَانِ",5,"ن",1,0],["وَلَم يَستَطِع إِلفٌ لِإِلفٍ تَحِيَّةً","مِنَ الناسِ إِلّا أَن يُسَلِّمَ حاجِبُه",6,"ب",2,0],["ولم يستقد إِلاّ لذي المعيّة","يكون كرأي العين رجم ظنونه",7,"ن",2,0],["وَلَم يَسُقكَ إِلى التَنعيمِ زِعنِفَةٌ","مِنَ المَعاشِرِ مِمَّن قَد نَفَت عُدُسُ",8,"س",1,0],["ولم يسع نحوي شخصه أو خياله","فإن لم أصب من وصله الوبل فالطلاّ",9,"ل",2,0],["ولم يَسْلُبْك ثوبكَ إنّ هذا","لأعظمُ ما يكونُ من المغانمْ",10,"م",1,0],["وَلَم يَستِر سَبيلَ الخَيرِ عَنكُم","وَلَم يَقبِض أَكُفّ الباذِلينا",11,"ن",2,0],["ولم يسلكوا للخُلود المرجَّى","سبيلَ الرّدى وظَلامَ اللّحودْ",12,"د",1,0],["وَلَم يُسلِها إِلّا المَنايا وَإِنَّما","أَشَدُّ مِنَ السُقمِ الَّذي أَذهَبَ السُقما",13,"م",2,0],["ولم يسقني الراح ممزوجَةً","بماءِ اللِّثَى لا بماءِ المُزَن",14,"ن",1,0],["وَلَم يَسعَ في المُلكِ سَعيَ اِمرِئٍ","تَبَدّى بِخَيرٍ وَثَنّى بِخَير",15,"ر",1,0],["وَلَم يُسَلِ الكَثيرَ وَغَيرُ سَهلٍ","تَطَلُّبُكَ القَليلَ مِنَ القَليلِ",16,"ل",1,0],["وَلَم يَسبِق فَعالَكَ فَرطُ قَولي","وَخَبطي في مَديحِكَ وَاِفتِناني",17,"ن",2,0],["وَلَم يَستَطِع نَسجَ اِمرِئِ القَيسِ مِثلَها","وَأَعيَت مَراقيها لَبيداً وَجَروَلا",18,"ل",2,0],["وَلَم يَسلِموهُ أَو يُضَرَّعَ حَولَهُ","رِجالُ بِلاءٍ بِالحُروبِ ذَوو حَسَب",19,"ب",1,0],["وَلَم يَستَغلِ مَحمَدَةً بِمالٍ","وَلَو أَضحَت تُحيطُ بِكُلِّ مالِه",20,"ل",2,0],["ولم يُسِرْنيَ من مثواكَ مَوْتُ أبي","وَقَد يُقَلقِلُ مَوْتُ الوالِدِ الوَلَدا",21,"د",2,0],["وَلَم يَسمَعوا قَولاً أَمِن صَمَمٍ بِهِم","وَلَم يَفهَموا رَجعاً كَأَنَّهُمُ خُرسُ",22,"س",1,0],["ولم يستمع غير صوت الضمير","يناديه من سرّه الموجع",23,"ع",1,0],["وَلم يسعَ في المُلْكِ سَعيَ امرِىءٍ","تَبَدّا بِخَيْرٍ، وَثَنّى بِخيَرّ",24,"ر",1,0],["وَلمْ يَستَطعْ نسْجَ امرِىءِ القيس مثلها،","وَأعْيَتْ مَرَاقيها لَبِيداً وَجَرْوَلا",25,"ل",2,0],["ولم يَسلكوا للخلمودِ المرجَّى","سبيلَ الرّدى ، وظَلامَ اللّحودْ",26,"د",1,0],["وَلَم يُسعِدهُ في التَّعرِيجِ حَتَّى","كَسته يَدُ الهَوَى العُذرِيِّ دَاءَ",27,"ا",2,0],["ولم يستعن في الأمر إلاَّ بربه","لذاك أعاديه تقوم وتقعد",28,"د",1,0],["ولم يسلنِي شيءٌ فأنساك عنده","وإن برّ آلٌ أو توفّر مال",29,"ل",1,0],["ولم يسلم غيرها في عتقه","فلا تلم ولا تضق من فعلته",30,"ت",2,0],["ولم يسرِ في طُرْق المكارم مُذْ نَشا","وما زالَ معروفاً سُرى القَين بالكِذْبِ",31,"ب",1,0],["وَلَم يسألِ المُختار من كلّ مؤمنٍ","على الدينِ إلّا أَن يودّهمُ أجرا",32,"ر",2,0],["ولم يستطيعوا بعض اطفاء وقدها","ومن ذا الذي يسطيع رد البلية",33,"ه",1,0],["ولم يستطع يوما فراغا عن الهوى","وكيف ومن يهواه بالحب شاغله",34,"ل",2,0],["وَلم يَسعى إِلى التَفريقِ قومٌ","يوحّدُ بَينَهُم وَطَنٌ وَنُطقُ",35,"ق",1,0],["ولم يَسترِحْ قلبُه من أسىً","ولم تَخلُ أحشاؤه من جوى",36,"ا",1,0],["وَلَم يُسلِ أَمراً مِثلُ أَمرِ صَريمَةٍ","إِذا حاجَةٌ في النَفسِ طالَ اِعتَراضُها",37,"ض",3,0],["وَلَم يَسعَ في الدُنيا لَبيبٌ لِغَيرِ ما","مَنَّ اللَهُ في الأُخرى يُجازى لَهُ الأَجرُ",38,"ر",1,0],["ولم يُسْلِني عنهم وإنْ عشتُ بعدهم","بنو زمني هذا الّذينَ أُزاوِر",39,"ر",1,0],["وَلَم يَستَمِع فيها أَحاديثَ مُرسِلٍ","وَلَكِن رَأى فيها حَديثَ الحَوادِثِ",40,"ث",1,0],["وَلَم يَستَطِع نَقصاً لَهُ وَزِيادَةً","عَلَيهِ إِذا ما مَنَّ بِالحُلوِ وَالمُرِّ",41,"ر",1,0],["وَلَم يَستَمِع يَوماً نِصائِحَ دَهرِهِ","إِذا قالَ في مالٍ يَجودُ بِهِ صُنهُ",42,"ن",2,0],["وَلَم يَستَكِفَّ النَيلُ مِنهُ سَماحَةً","وَلَم يَستَخِفَّ الحِلمُ مِنهُ المَقَطَّعا",43,"ع",2,0],["ولم يَستعن إيمانُه سيفَ كافرٍ","كما يستعين الغير وهو ذليل",44,"ل",1,0],["وَلَم يَستَفِد بِالمَدحِ ما لَيسَ عِندَهُ","وَهَل يَنفَعُ التَجميل من هو أَشهَبُ",45,"ب",1,0],["ولم يستمع فيها عذولاً ولائما","إذا كانت الورقاء فيه عذولها",46,"ه",2,0],["ولم يستَطع كتْم الجوى ذو صبابة","له فيضُ دمعٍ بالتباريحِ بائحُ",47,"ح",1,0],["ولم يساورني سوى","عقربِ صدغ لادغهْ",48,"غ",2,0],["ولم يستلب لبّي سوى صرف حبّكم","وما خامرت عقلي سلاف من الخمر",49,"ر",1,0],["وَلَمْ يَسْتَطِعْ ياقُبٌ نَصْرَها","ولا دَفَعَ الخَسْفَ عنهُ انْتِصارا",50,"ر",2,0],["وَلَمْ يستطِعْ نحوَ الحياةِ تأَخُّراً","بِفَوْتٍ ولا نحوَ النَّجاةِ تَقَدُّما",51,"م",2,0],["ولم يسلم المخلوق من عيب عائب","سلمن الحجار الجامدات الصلادم",52,"م",1,0],["ولم يسار الموت من عقله","دخيل ولا ذا النهى والهيزري",53,"ي",1,0],["ولم يسبق له مثل","بتأريخ لنا يروى",54,"ا",1,0],["ولم يسلم من الاقطا","ر الا قطر أميركا",54,"ا",1,0],["ولم يَسمْهم هَجرُ انقلاب ال","جَنوبِ منهم إلى الشَّمالِ",55,"ل",1,0],["وَلم يَسكنوا إلّا ظِلالَ عظيمةٍ","وَلَم يأمنوا إلّا خلالَ المخاوفِ",56,"ف",1,0],["ولم يُسلِني شَيءٌ سِوى أنّ جارتِي","قَضى اللَّه بَعدِي أن تجاور جَدّها",57,"د",3,0],["ولم يسعَ فيما تبتغون ودونَهُ","حجازٌ منَ الأعداءِ ليس ببارحِ",58,"ح",1,0],["ولم يُستلبْ بالرّماح الطّوا","لِ في الرّوع واسطةُ المِقْنَبِ",59,"ب",1,0],["وَلَمْ يِسْمَعِ النَّحْوَ لَكِنَّهُ","قَرَا مِنْهُ شَيْئِاً وَقَدْ صَحَّفَهْ",60,"ف",2,0],["ولم يسر سيرة من كان عبر","من النبيين كما جاء الخبر",61,"ر",1,0],["ولم يُسمه ولا أشارا","إليه بل قد جعل الخيارا",61,"ر",2,0],["ولم يسر بسيرة النبي","من بعده في رد ذاك الشيء",61,"ي",2,0],["ولم يسر عن قومه مسيرا","حتى أقام فيهم أميرا",61,"ر",2,0],["ولم يسونا على القياس","في حكمه حين قضى بالناس",61,"س",1,0],["ولم يسو فاضلا في فضله","بمن يكون دونه في فعله",61,"ه",1,0],["ولم يُسْل قَلْبِي أَو فَمي عن غَزَالةٍ","وعن غَزَلي إِلا مديحُ المُعظَّم",62,"م",1,0],["وَلَم يَستَفيدوا مِن تَقاطُعٍ بَينَهُم","سِوى عَيشٍ ذَلَّ تَحتَ نِقمَةِ موتِرِ",63,"ر",1,0],["ولم يُسمع بِها في مُلك كسرى","ولا في مُلك مَهديٍّ وهادي",64,"د",2,0],["وَلم يَستَطع مِن شدّة الشَوق وَالجَوى","يؤثِّر في وَجدي وَفَرط هيامي",65,"م",2,0],["وَلَم يَسمَع مَقالاً مِن نصوح","وَرجَّح عقله عَن كُل عَقل",66,"ل",1,0],["وَلَم يَستَجر يَوماً بِهِ في زَمانه","أَخو الروع إِلا واطمأنّ مِن الأُسد",67,"د",1,0],["ولم يُسَمَّ إمامٌ في الأولى سبقوا","عبدَ العزيز سواه فاسمهُ ابتكرا",68,"ر",2,0],["ولم يسلني إلا يقينيَ أنها","أثيبت من الباري بأعلى وأوسعا",69,"ع",2,0],["ولم يستطع رفعاً لمن يخفضونه","قضاء ولم يملك لمن رفعوا خفضا",70,"ض",2,0],["ولم يسترعِ صرفُ الدهر مني","جُرازاً حين يَسْتَرْعِي جروزا",71,"ز",2,0],["وَلَم يَسَل أَرنَبُنا عَن بُمب","بَل اِختَفى في شَجر الكرنب",72,"ب",1,0],["وَلَم يَسَل عَما جَنى مِن خَيري","يَجني مَعي كَما جَنى مَع غَيري",73,"ي",1,0],["ولم يستزر عن رغبة في زيارة","ولكن على رغم المزور يزور",74,"ر",1,0],["ولم يُسلني عنهم رِواءٌ يشوقُني","ولا مَطمحٌ للقلب فيه تفكر",75,"ر",1,0],["وَلَمْ يَسْمَحُوا لي مِنْهُمُ بِالرَّسَائِلِ","لَقَدْ هَيَّجَتْ يَوْمَ الْفِرَاقِ بِلاَ بِلي",76,"ي",1,0],["ولم يسلني طولُ التنائي عليكمُ","بل زادني وجداً وجدد لي ذكرا",77,"ر",2,0],["ولم يستمتعا بالوصل حتى","أنار الفجرُ يؤذِنُ بالفراقِ",78,"ق",1,0],["وَلَم يَستَخِفّوا بِأَعلامِنا","وَلَم يَستَطيلوا عَلى الصالِحين",79,"ن",1,0],["ولم يستطع كتم الهوى ذو صبابه","له فيض دمع بالتباريح صادع",80,"ع",1,0],["وَلَم يسق أخرى بالوداد فأنكرت","عليها وَعابتها بغير عيوب",81,"ب",1,0],["وَلَم يَسأَلِ الناسَ النَبِيُّ مُحَمَّدٌ","سِوى وُدِّ ذي القُربى القَريبَةِ مِن أَجرِ",82,"ر",1,0],["ولم يستهوه نغم الغواني","ولا صوت المثالث والمثاني",83,"ن",2,0],["ولم يسحر فؤادي قط طرف","سوى طرفين فيها ساحرين",84,"ن",1,0],["ولم يستطع رَدّا لِساني وإِنَّما","دَعا من دُموعِ المُقْلَتَيْن مُجِيبا",85,"ب",2,0],["ولم يستطيعوا توَقي ضربٍ","عليهم كالصاعقات انحدر",86,"ر",1,0],["وَلَم يَستَطيعو عُبوراً لَهُ","فَقُلتُ دُموعي جَرَينَ دُرَر",87,"ر",1,0],["ولم يستقم للعجم عز وأحجمت","وولى رعيل عند ذاك وقهقرا",88,"ر",2,0],["ولم يستطع إلياسُ أن يأت مُعجزاً","ولا الخِضر حتّى باسمِه قد تضرّعا",89,"ع",2,0],["وَلَم يَسمحُوا يَوماً بِشَيءٍ وَلَم أَكُن","لأَسأل رِفداً مِن غَبِيٍّ مُمَخرَقِ",90,"ق",1,0],["وَلَم يَستَشفِ فِعلَ كَريمِ قَومٍ","وَفادى بَعدَ ما شَدَّ الوِثاقا",91,"ق",2,0],["ولم يستبدلوني عنه ضَوءاً","ليهديني إلى النهج الحقيقي",92,"ق",2,0],["ولم يسمِ إِذا بايعته من خليفتي","ولم يشترط إلا اشتراط المجازف",93,"ف",1,0],["وَلَم يسئك خَبير","إِن راحَ يحسن نقدك",94,"ك",1,0],["ولم يستطعها الأَردَشِيرُ بِحدِّهِ","ولا رأيه الجوَّال حينَ يَجُولُ",95,"ل",1,0],["ولم يستطع لما رآه فخر من","تجليه مغشياً عليه على الثرى",96,"ر",2,0],["ولم يستغث إذ لا مساعد جازعاً","ولكن نداه في العوالم أثرا",97,"ر",2,0],["ولم يستطع ذاك الحسود لحاقه","عدا طلقاً في السعي اضحى بلا حد",98,"د",1,0],["ولم يسع مراد عبد الله","لما دهاه بالمنون داه",99,"ه",1,0],["ولم يسكن سويدائي"