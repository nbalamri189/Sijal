","https://www.poetsgate.com/ViewPoem.aspx?id=200623",""],[4755,"مُكَاشَفَة","https://www.poetsgate.com/ViewPoem.aspx?id=207193",""],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[4778,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=200390",""],[4814,"نكهة الأشياء","https://www.poetsgate.com/ViewPoem.aspx?id=194101",""],[4929,"فاقدُ الهمَّةِ ما صَعَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=204721",""],[4935,"لاحت لعيني زهرة الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=129285",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5365,"ربِحتَ البيع","https://www.poetsgate.com/ViewPoem.aspx?id=190474",""],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5510,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=206114",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5691,"باب الخليفة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207262",""],[5701,"يا سعد قم وانظر تجد ما نستحي","https://www.poetsgate.com/ViewPoem.aspx?id=164583",""],[5748,"ربّ حمّمام تلظى","https://www.poetsgate.com/ViewPoem.aspx?id=26229",""],[5943,"رُبَّ حبٍّ يُرثُ القلبَ العنا","https://www.poetsgate.com/ViewPoem.aspx?id=34707",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""]],"verses":[["رُبَّ حُزنٍ لي طَويلٍ","مَعَ حُبٍّ لي كَتَمتُه",0,"ت",2,0],["رُبَّ حَيٍّ أَشقاهُمُ آخِرَ الدَه","رِ وَحَيٍّ سَقاهُمُ بِسِجالِ",1,"ل",1,0],["رُبَّ حِلمٍ أَضاعَهُ عَدَمُ الما","لِ وَجَهلٍ غَطّى عَلَيهِ النَعيمُ",2,"م",1,0],["رب حكم منه قد أض","حى لحكم الله وفقا",3,"ق",2,0],["رب حسناء سلمها الدهر فقرا","فبدت في ثوب لها إخلاق",4,"ق",1,0],["رب حسناء كالعرا","رة في طرفها حور",5,"ر",1,0],["رب حب نزعته من فؤادي","فكأني اقتلعت باليد ضرسي",6,"س",2,0],["ربّ حقق آمال سعدٍ وحققذ","ربّ ما فيهِ ربّ سعدٌ يجدِ",7,"د",1,0],["رُبَّ حُرٍّ صَنَعتُ فيهِ ثَناءً","عَجِزَ الناحِتونَ عَن تِمثالِه",8,"ل",2,0],["رَبِحَت مِنَ التَصريحِ أَنَّ قُيودَها","قَد صِرنَ مِن ذَهَبٍ وَكُنَّ حَديدا",9,"د",2,0],["رِبَحلَةٍ أَسمَرٍ مُقَبَّلُها","سِبَحلَةٍ أَبيَضٍ مُجَرَّدُها",10,"د",3,0],["رُبَّ حِلمٍ لِلبَطشِ فِيهِ كُمونٌ","كَلَظى النارِ كامِناً في الزِنادِ",11,"د",1,0],["رُب حسنٍ من الوداعة يبدو","فيه عطفٌ وفي حناياه بِرُّ",12,"ر",1,0],["رُبَّ حُسْنٍ فِي ثِيَابٍ","عَادَ غِسْلِيناً وَمُهْلا",13,"ل",2,0],["رَبِّ حَمَّلتَني مِنَ الحُبِّ ثِقلاً","رَبِّ لا صَبرَ لي وَلا عَزمَ عِندي",14,"د",2,0],["رُبَّ حَتفٍ في حياةٍ تُشتهَى","وحياةٍ هي في حتفٍ وحَيْنْ",15,"ن",1,0],["رَبِحتُ سُرورَهُ وَظَلَلتُ فيهِ","بِرُغمِ العاذِلاتِ رَخيَّ بالِ",16,"ل",1,0],["رُبَّ حَكِيمٍ مُرْسِلٍ لِحْيَةً","أَوْقرَ مِنْ مُسْتَثْقلِ الضَّيْفِ",17,"ف",1,1],["رب حيٍّ أَوْلَى التَّقدُمَ حَيّاً","وَله فِي الظوَاهِرِ التَّأْخِيرُ",18,"ر",1,0],["رَبِحَ البَخيلُ عَلى اِحتِيالٍ عِرضَهُ","بِنَدى يَدَيكَ وَوَجهِكَ المُتَهَلِّلِ",19,"ل",1,0],["رُبَّ حُسْنٍ يعوق عن وَصْفِ حُسْنٍ","وَجَمالٍ يُنْسي جَمالَ المَعَاني",20,"ن",2,0],["رُبَّ حقلٍ كسوته بعد عُري","فإذا الحقلُ أخضرُ الطَّيلسان",21,"ن",1,0],["رُب حكمٍ قد أَصْدَرُوهُ عليه","فتلقى صُدُورَهُ بابتسامه",22,"م",2,0],["رُبَّ حقٍّ صانه، أو بَائِس","ذاد عنه، أو سَفيه رَدَعه",23,"ع",2,0],["ربّ حلم تناقلته اللّيالي","والخيالات فاستحال نبيّا",24,"ي",2,0],["رب حر إذا تجاهر بال","حق يقولون كافر زنديق",25,"ق",1,0],["ربح المُخلصون بِالإِخلاصِ","وَاِكتَفى العابِدون هول القَصاصِ",26,"ص",1,1],["ربح تهب لنا من كل ناحيةٍ","وديمة كحلها نور ونيران",27,"ن",1,0],["ربَّ حمَّامٍ تلَظّى","كتلظي كلِّ وامقْ",28,"ق",1,1],["رَبحَ السَيفُ فانِياتِ القَضايا","وَمَلَكتُ العُلى بِبَعضِ سُطورِ",29,"ر",1,0],["رَبِّ حَوِّل عَينَيَّ عَن كُلِّ حَيٍّ","رَبِّ سَكِّر سَمعي عَن الأَنباءِ",30,"ا",2,0],["ربحهُم خُسرانُ","وشكرُهم كُفرانُ",31,"ن",1,0],["رَبِّ حَسُنَ اللِحاظُ دُعاةً","في صَميمِ القُلوبِ بَنوا غَرامَه",32,"م",2,0],["رِبَحلَةً إِن مَشَت أَرخَت مَفاصِلَها","فَاِرتَجَّ مِن بُدنِها الأَوصالُ وَالكَفَلُ",33,"ل",1,0],["رُبَّ حَدباءَ فَيافٍ","في رِمالٍ وَوُعورِ",34,"ر",1,0],["رُبَّ حلمٍ ودِدتُ لو عاش دهراً","ثم ولّى فكان ميلاد بؤس",35,"س",1,0],["رب حم القضاء فانصر رجالي","واسكب الصبر والهدى والسكينة",36,"ن",2,0],["رُبَّ حُسنٍ مِنَ النُفوسِ قَريبِ","وَسَميعُ الدُعاءَ غَيرُ مُجيبِ",37,"ب",1,1],["رُبَّ حَيٍّ عِداً قَرعْنا قَناهمْ","بقَنانا والشّرُّ أنْفى",38,"ف",2,0],["ربح الذين تعلقوا بكتابه","أما الذين تنكبوه فخابوا .",39,"ب",3,0],["ربحت فيكم تجارة شعري","لا رماها في غيركم بالكساد",40,"د",1,0],["ربَّ حسن قبحت أفعاله","من رأى شيئاً قبيحاً حسنا",41,"ن",2,0],["رُبَّ حالٍ صِينَ في خِرْقَتِنا","دونَهُ البحرُ إذا ينهَمِرُ",42,"ر",1,0],["ربح الحياةَ بطعنِه وضرابهِ","والهائبُ النَّخِبُ الجبانُ قتيلُ",43,"ل",1,0],["ربح الشريكين في التقسيط بينهما","بقدر ما لهما أو نسبة العمل",44,"ل",1,1],["رب حل الوباء مصر ولا أع","لم كيف المصير بعد الوباءِ",45,"ا",2,1],["رب حالِ كأنها مُذْهَبُ الديبا","جِ صارت من رقّة كاللاَّذِ",46,"ذ",1,1],["رب حرب حائل ما","غيرها وهي لقوحُ",47,"ح",1,0],["ربحت غداة بعت الخلق طرّاً","بوجد أني له وعدمت غيني",48,"ن",2,0],["ربحت تجارة مؤمن في قلبه","حب لآل محمد وتودد",49,"د",1,0],["رب حزم وحجى كم احكما","من ذ كا عرفٍ وعلم نفس",50,"س",1,0],["ربح البيع من اقام المعاني","شاهدات من نفسه حين سامت",51,"ت",1,0],["رُبَّ حليم إِذا أطبّاهُ هوىً","من حبِّ حَسْناءً ظلَّ يعبُدهَا",52,"د",3,0],["رَبَحُ الأَبناءُ عزٌّ كاملُ","وذكا الأولادِ فضلٌ شاملُ",53,"ل",1,1],["ربَّ حبسٍ يكون عنوان فصلٍ","وقيودٍ تبقى حلَّى وسُوارا",54,"ر",2,0],["ربَّ حِلم يخاله الناس ضَعفاً","وتراه عينُ اللبيب اقتدارا",54,"ر",2,0],["ربَحلَةٌ لَو رأى منها الجنَيدُ كما","عايَنتُ باتَ بليلِ الساهرِ الغائي",55,"ي",1,0],["رب حسن يكاد أستغفر الله","لفرط الجمال والحسن يعبد",56,"د",1,0],["رَبِحَ الثَنا بِخَسارَةٍ مِن مالِهِ","فَأَتاهُ ربحُ الحَمدِ مِن خُسرانِهِ",57,"ه",1,0],["ربحوا ببيعهم الذي قد بايعوا","فاعرف مقامك أين انت من النما",58,"م",2,0],["ربحت تجارتكم ألا فاستبشروا","هاتيك سوق المكرمات تقام",59,"م",1,0],["ربٌّ حباك به حُباً وتكرمةً","فاصغِ إليه جزاءً إذ يناديكا",60,"ك",2,0],["ربحت تجارة مشتريه وسوقه","للسائمين بها الحجا سمسار",61,"ر",1,0],["رَبِحَتْ تجارتُها فباعت فانياً","بشريف ما يبقى بغير نفاد",62,"د",1,0],["رَبِحَتْ تجارتُه فأنفق فَانياً","لينالَ في دار النّعيم خلودا",63,"د",2,0],["رَبِّ حَلّاً فَقَد ذَكَرتُ أَصيصي","وَلِحافي حَتّى تَغورَ النُجوم",64,"م",1,0],["رَبحت وأيم اللَه حينَ اِنتَجعتها","بوارق مِنها صَدقتك المَخايل",65,"ل",1,0],["رَبحت صَفقة العَوالم مِنهُ","بِمقيم لدين أَحمَد سوقا",66,"ق",2,0],["ربحت تجارتك التي لم تتخذ","غير التقى من منهج وسبيل",67,"ل",1,0],["ربحت تجارة كل شخص أمه","بِبَديع مدح ناظِم أَو ناثِر",68,"ر",1,0],["رب حبر آوى إلى ضيق قبر","كان مأواه في الحياة رحيبا",69,"ب",2,0],["رب حسن ناداه قلبي كليما","وهو في طور وجده يتأوه",70,"و",2,0],["رب حبر حيث نادته العلى","أن ترحل ولك التكريم",71,"م",1,0],["ربُّ حَزمٍ فكّاكُ مُعضِلةٍ من","كلِ امرٍ تدبُّراً وَسَدادا",72,"د",2,0],["ربحٌ قليل في الكثير مبارك","والرزق موكولٌ إلى الديان",73,"ن",1,0],["ربحنا بمدحِ الهاشمي محمدٍ","فصلّوا عليه نقسم الربحَ في التجر",74,"ر",1,0],["ر بحظ الذي يكون أديبا","كم لئيم بها تنعم دوما",75,"م",2,0],["ربحوا في الغرْوِ وما خسروا","والأعداء عادوا بالخذلان",76,"ن",1,0],["ربحتْ تجارةُ من خزائن ماله","قلبُ الرعية وهو من حُرَّاسها",77,"س",3,0],["رُبَّ حَربٍ أدنى إلى اللَهِ سِلماً","من سَلامٍ يكونُ منهُ النِزالُ",78,"ل",1,0],["رب حي رأيتهم ورأوني","ثم قالوا: متى يموت قدارُ",79,"ر",1,1],["رب حق فيه نفيس ومرذو","ل ومَينٌ يرجى ومَينٌ يخيف",80,"ف",1,0],["رب حرب لم تجن في الحال أعطيت","بعد كرٍ من السنين جناها",81,"ا",3,0],["رَبٌّ حَبانا بِأَموالٍ مُخَوَّلَةٍ","وَكُلُّ شَيءٍ حَباهُ اللَهُ تَخويلُ",82,"ل",1,0],["ربح البيع ولكن قلت ال","مشتري قول المسيء المعتذر",83,"ر",1,0],["رب حطنا من العداة وصنّا","في صوان الذين عنهم تصون",84,"ن",1,0],["رب حاد منك ب