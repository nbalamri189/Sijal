وَكَفانا مُذَكِّراً بِالمَنايا","عِلمُنا أَنَّنا مِنَ الحَيوانِ",2,"ن",1,0],["وَكَفاكَ مِن شَرَفِ القَبيلِ بِأَن تَرى","بَدَدَ القُبورُ لِمُنجِدٍ أَو مُتهِمِ",3,"م",1,0],["وَكَفاكَ أَنّي لَستُ أَع","قِدُ خِنصِري إِلّا عَلَيكا",4,"ك",2,0],["وَكَفكَفتُ عَمِّن سِواهُ يَدي","وَكُنتُ أَرى الماءَ لا يُشبِعُ",5,"ع",1,0],["وَكَفٌّ كَالغَمامِ يَفيضُ حَتّى","يَعُمُّ الأَرضَ مِن كَلَإٍ وَماءِ",6,"ا",2,0],["وَكَفِّي بِهَزِّ المَشْرَفَيِّ لَبيقةٌ","وَباعي بِتَصْريفِ القَناةِ رَحيبُ",7,"ب",1,0],["وكَفٌّ كما انْهَلَّ الغَمامُ طَليقَةٌ","ووَجْهٌ كَما لاحَ الهِلالُ طَليقُ",8,"ق",1,0],["وكَفى مُعِزَّ الدين رأيُكَ عَسْكَراً","لَجِباً يُجَنّحُ جانبَيْهِ بعَسْكَرِ",9,"ر",1,0],["وَكَفَى بِإِبْرَاهِيمَ بَدْرَ خِلاَفَةٍ","تَعْنُو لِغُرَّتِهِ الْبُدُورُ الْكُمَّلُ",10,"ل",1,0],["وَكَفَى بِإِبْرَاهِيمَ لَيْثَ كَرِيهَةٍ","يِعْنُو لِغُرَّتِهِ الْهِزَبْرُ الْمُشْبلُ",10,"ل",1,0],["وكفَتْ شَديدَ حُروبِها وجُدوبِها","كفّا الجَلالِ يَمينُهُ ويَسارُهُ",11,"ر",2,0],["وَكَفَفَتْ كَفَّ الجَوْرِ فِي أَرْجَائِهَا","وَعَمرْتَ رَبْعَ العَدْلِ وَهْوَ خَلاَءُ",12,"ا",2,0],["وَكَفلٍ كَالنَقا مالَت جَوانِبُهُ","لَيسَت مِنَ الزُلِّ أَوراكاً وَما اِنتَطَقا",13,"ق",2,0],["وَكَفّاً إِذا جالَت عَلى الطِرسِ جَولَةً","تَمايَلَ إِعجاباً بِها البَلَدانِ",14,"ن",1,0],["وَكَفَّنوهُ بِدَرجٍ مِن صَحائِفِهِ","أَو واضِحٍ مِن قَميصِ الصُبحِ مَقدودِ",15,"د",1,0],["وَكَفٌّ بِحِنّاءِ المُدامِ تُقَنَّأُ","وَكائِن عَدَونا مُصعِدينَ عَلى الجِسرِ",16,"ر",1,0],["وكفى لذلك ما جلا","للناس من مرآة عمرك",17,"ك",1,0],["وَكَفَاهُ نُبْلاً أَنَّهُ","يحْذُو بهِ أَسنَى مِثَالِ",18,"ل",1,0],["وكفاكَ ردُّ الشمسِ بعد مغيبها","وكفاكَ ما قدْ جاءَ في الإِسراءِ",19,"ا",2,0],["وكفى المرء بعد موت حياةً","أن ذكراه حلوة حسناء",20,"ا",2,0],["وكفى بسعدون له خلفا","لفعاله في المجد متّبعا",21,"ع",2,0],["وَكَفى الإِلَهُ المُؤمِنينَ قِتالَهُم","وَأَثابَهُم في الأَجرِ خَيرَ ثَوابِ",22,"ب",1,0],["وَكَفى بِنا فَضلاً عَلى مَن غَيرِنا","حُبُّ النَبِيِّ مُحَمَّدٍ إِيّانا",23,"ن",2,1],["وكفّر ذنبَ أغزالٍ تقضت","ختامُ المدح في قاضي القضاة",24,"ه",1,0],["وكفَّاك للمدَّاح أيام عشرها","وليلة من تسعى لها ليلة القدر",25,"ر",1,0],["وكفى عداتي أنني ما فيّ أن","ورد الشتا إلا لسانيَ داف",26,"ف",1,0],["وكفيتني حتَّى قفوت معاشراً","كثر الندَى فاسْتكثرت أطفالها",27,"ل",3,0],["وكفى لأمَّته بذاك بشارة","أن سوفَ تخمد في الجنان جحيم",28,"م",1,0],["وكفي يا كريمة كيد حسن","فلا كيد العذول ولا كرامه",29,"م",2,0],["وكفاكمُ أنَّ الغيوث إذا همت","تمحو الرسوم وغيثكمُ ينسيها",30,"ه",2,0],["وكفاهمُ مرتبات المحنِ","طاهر الأسرار شهمُ العلنِ",31,"ن",1,0],["وكفى شاهداً بذاك مليكٌ","لم تزل عينُهُ عليَّ رقيبا",32,"ب",2,0],["وكفاكُم بذاك زادكُم اللَّ","هُ علوَّاً وضدُّكُم مَذعوتُ",33,"ت",1,0],["وكَفَّانِ في هذي رَدَى كل ظالمٍ","وفي هذه للمُستغيث مَغَاوثُ",34,"ث",1,0],["وكَفَّيْن تَسْتَحِيي السماءُ إذا رأت","رُفُودَهُمَا من ضَنِّها برُفُودها",35,"د",3,0],["وكفانا زاجراً عن غَدْرةٍ","قولُهُمُ أنجَز حرٌّ ما وعدْ",36,"د",1,0],["وكَفَانا مُسْتَحثّاً قولهم","لا تُؤخِّر لذّةَ اليوم لغدْ",36,"د",1,0],["وكَفَاك من مجدٍ إذا اج","تمع المؤبَّد والمجدَّدْ",37,"د",1,0],["وكفى الحقود مهانةً وغضاضةً","أن لست تلقاه عدوّ جهارِ",38,"ر",1,0],["وكفاكم بأبي قاسِمهم","ذي الأيادي والسجايا الطاهره",39,"ر",2,0],["وكفاهُمُ شرفاً لهم وصيانةً","عن شقوةٍ ومذلةٍ وخضوع",40,"ع",1,0],["وكفيتمونا ما أهمَّ فكلُّنا","يرعى مريع العيش غيرَ مَرُوع",40,"ع",1,0],["وكفت بالندى يداك على النا","س وما زلت عارضاً وكّافا",41,"ف",2,0],["وكفاني بها وعيداً لواعٍ","صان حوض المعروف عن أن يُعافا",41,"ف",2,0],["وكفَّلته برفد يابسها","ووكَّلته بكيدِ مارقها",42,"ق",3,0],["وكفاهُمُ من قتلِ أنفسِهم","باثنين من وضحٍ ومن حلكِ",43,"ك",1,0],["وكفانا مكان ما فات منه","فضلُ من أضحك الأنامَ وأبكى",44,"ك",2,0],["وكفٍّ معاذَ اللَّهِ من بخلِ مثلها","أترفعُ للسُّقيا فتُسقى وتبخلُ",45,"ل",1,0],["وكفَى من الزلزالِ بعد محمدٍ","أنْ لَيْسَ يُعْرَفُ بعده إفضالُ",46,"ل",1,0],["وكفاني من الوسائل أخلا","قُك يا أيّها القريبُ المنالهْ",47,"ل",2,0],["وكفاه بما تسلّفَ منها","من قديمِ الخبالِ بعد الخبالِ",48,"ل",1,0],["وكفٌّ صَنَاعٌ تجبرُ الكسر منهمُ","وتدملُ من ذي كَلْمهم حين يُكْلمُ",49,"م",1,0],["وكفاكَ يمنُ مُرَشَّحٍ فرجَتْ","بركاتُهُ في غُمَّةِ الغُمَمِ",50,"م",1,0],["وكفانا تَهيُّب العَوْد في الحا","جاتِ أنَّ السماح منك مكين",51,"ن",1,0],["وكفى عزاءً لامرئٍ عن فائتٍ","أن لا يخافَ عليه صرفَ زمان",52,"ن",1,0],["وَكَفَفتَ صَرفَ الدَهرِ بَعدَ جِماحِهِ","فَكَأَنَّما هُوَ مارِدٌ مَغلولُ",53,"ل",1,0],["وَكفَرتُ بِالرَحمَنِ إِن كُنتُ اِمرَأً","أَرضى لَما أَولَيتَهُ أَن يُكفَرا",54,"ر",2,0],["وَكَفى اِهتِماماً مِنهُما بِكَ أَن غَدا","كُلٌّ يُريدُكَ أَن تَكونَ لِذاتِهِ",55,"ت",2,0],["وَكفّ فَتىً لم يَعرفِ السَّلخَ قَبلها","تَجورُ يَداهُ في الإِهابِ وَتَخرُجُ",56,"ج",1,1],["وكفى الحياةُ لنا شواغل فأفتني","ملأ النجوم وعالم الأقمار",57,"ر",1,0],["وَكَفاكُم أَنَّني العَبدُ المُطيع","أَخدُمُ المُنعِمَ جَهدَ المُستَطيع",58,"ع",1,0],["وَكَفى المَوتُ ما تَخافُ وَتَرجو","وَشَفى مِن أَصادِقٍ وَأَعادي",59,"د",2,0],["وَكَفَّ عَن قَلبِهِ المَعمودِ نَبلَهُما","أَلَيسَ عَهدُكَ فيهِ حَبَّةً وَدَما",60,"م",2,0],["وَكَفى الحَياةُ لَنا حَوادِثَ فَاِفتِني","مَلَأَ النُجوم وَعالَمَ الأَقمارِ",61,"ر",1,0],["وَكَفٍّ لا تُنازِعُ مَن أَتاني","يُنازِعُني سِوى شَرَفي وَخَيري",62,"ر",2,0],["وَكَفى بِمَن فَضَحَ الجَدايَةَ فاضِحاً","لِمُحِبِّهِ وَبِمَصرَعي ذا مَصرَعا",63,"ع",2,0],["وَكِفاحاً تَكِعُّ عَنهُ الأَعادي","وَاِرتِياحاً يَحارُ فيهِ الأَنامُ",64,"م",1,0],["وَكَفَتكَ الصَفائِحُ الناسَ حَتّى","قَد كَفَتكَ الصَفائِحَ الأَقلامُ",65,"م",1,0],["وَكَفَتكَ التَجارِبُ الفِكرَ حَتّى","قَد كَفاكَ التَجارِبَ الإِلهامُ",65,"م",1,0],["وكفلتَ لي بالنُّجْحِ منذ وعدتَني","وكذاكَ ميعادُ الكريمِ ضَمانُ",66,"ن",1,0],["وكفيتَني منَّ اللئيمِ بجاهِه","إنَّ اللئيمَ بجاهِه منَّانُ",66,"ن",1,0],["وكفاهُ جهدَ الرأي يَشْغَلُهُ","عفوُ البديهةِ ما بها شُغُلُ",67,"ل",1,0],["وكفيتَني مِنَنَ الرِجالِ ولم يزلْ","مِنَنُ الرجال يعافُها الأحرارُ",68,"ر",1,0],["وَكَفاني إِذا الحَوادِثُ أَظلَم","نَ شِهاباً بِغُرَّةِ اِبنِ شِهابِ",69,"ب",1,0],["وَكَفى الكَريمَ بِها أُولاءِ مَكارِماً","مَأثورَةً في سِلمِهِ أَو حَربِهِ",70,"ب",2,0],["وَكَفاكَ مِن حَنَشِ الصَريمِ تَهَدُّداً","أَن مَدَّ فَضلَ لِسانِهِ أَو نَضنَضا",71,"ض",2,0],["وَكفى صُروفَ الدَهرِ مُضطَلِعاً بِها","وَالدَهرُ تِربُ حَوادِثٍ وَصُروفِ",72,"ف",1,0],["وَكِفلانِ مِن وَعدٍ عَلَيكَ مُقَدَّمٍ","أَطاعَ لَنا كِفلٌ وَمانَعَنا كِفلُ",73,"ل",1,0],["وَكَفَتهُمُ الشورى شَواهِدَ أَعرَبَت","عَن أَمرِهِ وَفَضيلَةٌ ما تُشكِلُ",74,"ل",1,0],["وَكَفاني عَلى الَّذي يوجَدُ الفَض","لُ لَدَيهِ بِالحاسِدينَ دَليلا",75,"ل",2,0],["وَكَفّاكَ بَعدَ اللَهِ في راحَتَيهِما","لِمَن تَحتَ هَذي فَوقَنا الرِزقُ وافِيا",76,"ي",2,0],["وكفاك من نفسي شهيد ناطق","يا صاح إنك عندها مثلي",77,"ي",1,0],["وكَفٌّ منك شَاعِرَةُ العَطايا","تُعَلِّمُني دَقيقاتِ المَعاني",78,"ي",1,0],["وكفاكَ بي خُلّا تَسُرُّ خِلالُه","وكفَى بمثلِك مُسعِداً ومُواصِلا",79,"ل",2,0],["وكفَى الهَوى لو كان مُكتَفياً","ما رحتُ أُضْمِرُهُ وأُظْهِرُه",80,"ر",2,0],["وكفَّاكَ الغَمامُ الجَوْدُ يَسْري","وفي أحشائِه ماءٌ ونارُ",81,"ر",1,0],["وكَفٌّ لو يكونُ لها كِفاءٌ","وَقَيْناها بديباجِ الخُدودِ",82,"د",1,0],["وكفى الوَفْدَ أن يَحُثَّ المَطايا","بندىً يغتدي إلى الوَفْدِ وَفْدا",83,"د",2,0],["وكفاكَ أنَّ الدَّهرَ أَعْتَبَنِي به","فَكَفَيْتُ عَتْبي عنده وعِتابي",84,"ب",2,0],["وَكَفّي عَن أَذى الجيرانِ نَفسي","وَإِعلاني لِمَن يَبغي عِلاني",85,"ي",1,0],["وَكَفاكَ مِن عِبَرِ الحَوادِثِ أَنهُ","يَبلى الجَديدُ وَيُحصَدُ المَزروعُ",86,"ع",1,0],["وَكَفاكَ ما جَرَّبتَهُ","حَسبُ امرِئٍ ما جَرَّبا",87,"ب",2,0],["وَكَفى بِعِلمِكَ بِالأُمو","رِ إِنِ انتَفَعتَ بِما عَلِمتا",88,"ت",2,0],["وَكَفَيتُ نَفسي ظُلمَ عادِيَتي","وَمَنَحتُ صَفوَ مَوَدَّتي سِلمي",89,"ي",1,0],["وَكَفُّ الصُبحِ قَد سَلَّت نِصالاً","تُخَرِّقُ حُلَّةَ اللَيلِ البَهيمِ",90,"م",1,0],["وَكَفَّرتُ عَن زَلَّةِ الإِنقِطاعِ","بِأَحسَنِ مَن كانَ في مَنزِلي",91,"ل",2,0],["وَكَفٍّ تَشيمُ السَيفَ غَضبانَ ضاحِكاً","وَتَثنيهِ بَعدَ الكَرِّ جَذلانَ باكِيا",92,"ي",2,0],["وَكَفَلتَ مَن كَلِفَ الزَمانُ بِحِفظِهِ","حَتّى كَأَنَّكَ لِلبَرِيَّةِ والِدُ",93,"د",1,0],["وكفاه الرمحُ فَعالَ السيف","فقيل أيضربُ مَنْ طَعَنا",94,"ن",2,0],["وكفّكَ المزنُ تسْقي من دَنَا ونأى","وليس من غيرِ مُزْنٍ يرتجى المطرُ",95,"ر",1,0],["وَكَفكَفتُ عَنكَ الذَمَّ حَتّى كَأَنَّما","أَجارَكَ مَجدٌ أَو كَأَنِّيَ مُفحَمُ",96,"م",1,0],["وَكَفَى بِسِبْطَيْهِ إِمَامَا رَحْمَةٍ","نَالا مِنَ الرِّضْوَانِ مَا قَصَدَاهُ",97,"د",3,0],["وَكَفَاكَ بِي رَجُلاً إِذَا اعْتُقِلَ النُّهَى","بِالصَّمْتِ أَوْ رَعَفَ السِّنَانُ بِعَنْدَمِ",98,"م",1,0],["وكفهم بالوعظِ لكنْ جبى","فأكلُهُمْ بالخمسِ والكفِّ",99,"ف",1,0],["وَكَفَّت سَوابِقَ مِن عَبرَةٍ","عَلى الخَدِّ جالَ بِها الإِثمِدُ",100,"د",1,0],["وَكَفا بي مِدرَهاً لِخُصومٍ","لَسِواها عِندَ جِدَّ تَنابي",101,"ي",1,0],["وَكَفى أَسىً أَن لاسَفيرٌ بَينَنا","يَمشي وَأَن لامَوعِدٌ لِلِقاءِ",102,"ا",2,0],["وَكَفى اِكتِئاباً أَن تَعيثَ يَدُ البِلى","في مَحوِ تِلكَ الصورَةِ الحَسناءِ",102,"ا",2,0],["وَكَفى أَسىً وَصَبابَةً أَن أُنزِلوا","وَهُمُ الأَقارِبُ مَنزِلَ البُعَداءِ",103,"ا",2,0],["وَكَفاهُما أَن يَخلوا بِأَراكَةٍ","عِندَ المَقيلِ وَيَشرَبا مِن ماءِ",103,"ا",2,0],["وَكفاهُ مَجداً أَن يَقولَ وَلِلدُجى","فَجرٌ لَهُ مِن دَمعِهِ أَمدادُ",104,"د",1,0],["وَكَفى مَعاداً لِلتَلاقي في الكَرى","لَو كانَ يَسمَحُ بِالخَيالِ رُقادُ",104,"د",1,0],["وَكَفَت فَسالَت فِضَّةً وَلَرُبَّما","طَبَعَت بِكُلِّ قَرارَةٍ دينارا",105,"ر",2,0],["وَكَفاكَ أَنَّكَ مِن بُدورِ مَعاشِرٍ","طَلَعوا لِأَوَّلِ لَيلَةٍ أَقمارا",105,"ر",2,0],["وَكَفاكَ مِن غُصنٍ لِسَطرِ بَلاغَةٍ","مُتَناسِقِ الأَثمارِ وَالأَوراقِ",106,"ق",1,0],["وَكَفى بِلَمحِ البَرقِ غَمزَةَ حاجِبٍ","وَبِصَوتِ ذاكَ الرَعدِ رَجعَ كَلامِ",107,"م",1,0],["وَكَفى اِحتِماءَ مَكانَةٍ وَصِيانَةٍ","أَنّي عَلِقتُ بِذِمَّةٍ مِن مَريَمِ",108,"م",1,0],["وَكَفاني مَسُّ فاقَتِهِ","أَن يُذيعَ الدَهرُ مُهتَضَمي",109,"م",2,0],["وَكَفى بِمَدحِكَ نَيلَ سُؤلٍ إِنَّني","نَزَّهتُ فيكَ الشِعرَ عَن أَن يَكذِبا",110,"ب",2,0],["وَكَفرتم بِنعمة اللَه حَتّى","ضاقَ ذَرعاً بِالكفر موسى الكَليم",111,"م",1,0],["وَكَفُّهُ الأُخرى بِها يَبتَغي","نَقضَ ثَأى قَومٍ وَأَوذَمِها",112,"م",3,0],["وَكَفَّنتُ وَحدي مُنذِراً في ثِيابِهِ","وَصادَفَ حَوطاً مِن عَدُوِّيَ قاتِلُ",113,"ل",1,0],["وَكَفَلٍ بِسَفلِ فَضلِ المِئزَرِ","تُخبِرُ عَيناهُ بِعِشقٍ مُضمَرِ",114,"ر",1,0],["وَكُفؤاً لِخَيرِ نِساءِ العِبادِ","ما بَينَ شَرقٍ إِلى مَغرِبِ",115,"ب",1,0],["وَكَفَتْهُ بِنَسْجِها عنكبوتٌ","ما كَفَتْهُ الحمامةُ الحَصْداءُ",116,"ا",2,0],["وَكفاهُ المستهزئينَ وَكم سا","ءَ نبِيَّاً من قومِه استهزاءُ",116,"ا",2,0],["وَكَفَاني باتِّباعي طَريقَاً","رَغِبَ المُخْتارُ فيها رِغابا",117,"ب",2,0],["وَكَفانيَ سَعْيِي إليها لأُهْدَى","مِنه بالرُّشْدِ في جميع الأُمورِ",118,"ر",1,0],["وَكَفَى اليهودَ بأنهم قد مَثَّلُوا","مَعْبُودَهمْ بِعِبادِهِ تَمثيلا",119,"ل",2,0],["وكَفَى بمنْ ميراثُهُ الدّنيا ومَن","خُلِقَتْ لهُ وعَبيدُهُ الثَّقَلانِ",120,"ن",1,0],["وكَفَى بشيعَتِهِ الزّكيّةِ شِيعَةً","وكَفَى بهم في البرّ من صِنْوانِ",120,"ن",1,0],["وكفاكَ أن كنْتَ الإمامَ المرتضَى","وأبوكَ إنّ عُدَّ النبيُّ المُرسَل",121,"ل",1,0],["وكفكَفْتَ عنهم مَن يجور ويعتَدي","وأمّنْتَ منهم من يخافُ ويجْزَع",122,"ع",1,0],["وكفاكَ من حُبِّ السماحَةِ أنّهَا","منه بموضع مُقلةٍ من مَحْجِر",123,"ر",1,0],["وكُفَّ على بحرٍ إلى اليوم موجُهُ","فليس له جَزْرٌ وليس له مَدُّ",124,"د",1,0],["وكفاكَ أن أطرَيتَهم ومَدَحْتَهم","جهْدَ المديح فما وجدتَ مكذِّبا",125,"ب",2,0],["وَكَفّاهُ تَجودانِ","بِما لا تَأمَلُ النَفسُ",126,"س",1,0],["وَكَفاكَ أَنّي لَم أُحِط","بِشَكاةِ مَن أَحبَبتُ خُبرا",127,"ر",2,0],["وَكَفاكَ بي حَجراً لِشاعِرِ مَعشَرٍ","وَرَدَت قَصائِدُهُ وَهُنَّ ذُعورُ",128,"ر",1,0],["وَكَفاكَ مِن عَجَبٍ تَجَنُّبُ رُشدِهِ","وَطِلابُ ما تَهوَى وَأَنتَ بَصيرُ",129,"ر",1,0],["وَكَفى بِمُضطَرِبِ العُقودِ فَإِنَّهُ","نَحرٌ يَزينُ زَبَرجَداً وَفَريدا",130,"د",2,0],["وَكَفَيتَ رَهطَكَ واحِداً","لِلَّهِ دَرُّكَ أَيَّ واحِد",131,"د",1,0],["وَكَفاني أَمراً أَبَرَّ عَلى البُخ","لِ بِكَفٍّ مَحمودَةٍ بَيضاءِ",132,"ا",2,0],["وَكَفَّرَها لَيلٌ تَرَهَّبَ شُهبُهُ","تُخالُ يَهوداً عاقَ عَن سَيرِها السَبتُ",133,"ت",1,0],["وَكَفاني مِمّا يُعَبُّ لُجَينِي","يٌ إِذا عُبَّ صِرفُكَ الذَهَبِيُّ",134,"ب",2,0],["وَكَفَيتُ صَحبِيَ إِلَّتَيّا","بَعدَ اللُتَيّا وَاللُتَيّا",135,"ت",3,0],["وَكَفٌّ أَدارَتْ مُذْهَبَ اللَّون أَصْفراً","بِمُذْهَبَةٍ في رَاحَةِ الكفِّ صَفْراءِ",136,"ر",3,0],["وكَفَاني عِزّاً بحُبّكَ ذُلّي","وخُضوعي ولستُ من أكْفاكا",137,"ك",2,0],["وكفاحَ أَيامٍ وعَرْكَ شدائدٍ","بجميلِ صبر أو طويلِ جِهَادِ",138,"د",1,0],["وكفَّ عن الهمْسِ حتى النسيمُ","وأمسكَ عن لَعِبٍ ماؤها",139,"ه",2,0],["وَكَفَاكَ عِلْمُكَ بِالأُمُورِ وَلَيْسَ مَنْ","سَلَكَ السَّبِيلَ كَجَائِرٍ لَمْ يَهْتَدِ",140,"د",1,0],["وَكَفَى بِعَادِيَةِ الْحَوَادِثِ مُنْذِراً","لِلْغَافِلِينَ لَوِ اكْتَفُوا بِعَوَادِي",141,"ي",1,0],["وَكَفْكَفْتُ دَمْعَاً لَوْ أَسَلْتُ شُؤُونَهُ","عَلَى الأَرْضِ مَا شَكَّ امْرُؤٌ أَنَّهُ الْبَحْرُ",142,"ر",1,0],["وَكَفَى بِالْمَشِيبِ وَهْوَ أَخُو الحَزْ","مِ دَلِيلاً إِلى طَرِيقِ الصَّوابِ",143,"ب",1,0],["وَكَفَقْدِهِمْ فَقْدَ الغَرانِيقُ العُلَى","عَلَمَ الهُدَى لِلفِتْيَةِ النُّجَبَاءِ",144,"ا",2,0],["وَكَفَى إِلى أَمَد سَرَاحِينَ الطَّوَى","وَالضَّارِيَ الشَّبْعَانَ شَرَّ قِتَالِ",145,"ل",1,0],["وَكَفَى مِصْرَ مِنْ أَيَادِيكَ فِيهَا","أَنَّ عَهْدَ الْفُنُونِ عَهْدُ نُشُورِ",146,"ر",1,0],["وَكَفَى مَحَاسِنَكِ الفَرَائِدَ أَنَّهَا","بَاتَتْ حَوَاسِدَ لِلْفَضَائِلِ فِيكِ",147,"ك",1,0],["وَكَفى مَنْ شهِدَتْ يَوْماً لَهُ","شُهرَةً تُولِيهِ فِي الأَقْطَارِ زَخْرَا",148,"ر",2,0],["وَكَفَاهَا مِنْ عِزَّةٍ أَنْ نَمَّاهَا","أَنْبَلُ الأُمَهَاتِ وَالآبَاءِ",149,"ا",2,0],["وَكَفَاهُ فَخْراً أَنَّ ذَاكَ المَالَ لَمْ","يَكُ مَكْسَ جَابٍ أَوْ تَطَوُّلَ والِ",150,"ل",1,0],["وَكَفَرْحِهِ فِي المَجْدِ","فَلْيَكُ عَزْمَ كُلِّ سَمَيْدَعِ",151,"ع",1,0],["وَكَفَ الحَيا وَكَفى البُكا لَو أنّهُ","أَجرى مَدامِعنا بِغَيرِ دِماءِ",152,"ا",2,0],["وَكَفكَفتُ جهدي عبرَتي وَرعافَهُ","فَلَم أَستَطِع أَن يَرقَأ الدَمَيانِ",153,"ن",1,0],["وكفى عجباً أَنِّي قنصٌ","للسِّرب سبانِي أغْيَدهُ",154,"د",2,0],["وكفاه غلامٌ أَوْرَثَهُ","إِسْحَاق المَجْدِ وأَحْمَدهُ",154,"د",2,0],["وَكُفِّن في ثَوبِ الكَرامَةِ وَالثَنا","عَلَيهِ حَنوطٌ وَالدُموعُ غَسولُ",155,"ل",1,0],["وكفى الشيب واعظاً غير أنّي","آملُ العيشَ والممات قريبُ",156,"ب",1,0],["وكَفَّ عن النَّبض قلبٌ كبيرٌ","بأضلاعهِ ليلةً ما استَقَّر",157,"ر",1,0],["وكَفكِف من أياديك اللواتي","أنارَ بياضُها وجهَ الوجود",158,"د",1,0],["وكفُّ طبيبٍ تكُفُّ دماءَ","بنيها، وتحِقنُ سيَّالَها!",159,"ل",3,0],["وَكفاني باتِّباسثعِي طَرِيقاً","رغب المختار فيها رغابا",160,"ب",2,0],["وكفى المحتلَ هَوناً أن يُرى","الاسرون الغلبُ منه اسراء",161,"ا",2,0],["وكفانا من التّقهقُرِ أنّا","لم نعالج حتى الأمورَ الصغارا",162,"ر",2,0],["وكفاكَ من بلدٍ جَمالاً أنَّه","حَدِبٌ على إنعاش قلبِ نزيله",163,"ل",2,0],["وكفّاً تُمدُّ وراء الحجاب","فترسُمُ في الأفْقِ ما ترسُم",164,"م",1,0],["وَكَفَى الكَرِيمَ بهَؤلاءِ مَكارِماً","مأثُورَةً في سِلْمِهِ، أوْ حَرْبِهِ",165,"ب",2,0],["وكفى عزاءً لأمرىء عن فائتٍ","أن لا يخافَ عليه صرفُ زمان",166,"ن",1,0],["وكفاكَ يمُن مُرَسَّحٍ فرجَتْ","بركاتُهُ في غُمَّة ِ الغُمَم",167,"م",1,0],["وَكَفَّتْ سَوَابِقَ مِنْ عَبْرَة ٍ،","كَمَا کرْفَضَّ نَظْمٌ بَعِيدُ المَسَاكِ",168,"ك",1,0],["وكفكفتُ دمعاً فوق خدّيه جاريا","وقلتُ له هون عليك فإنما",169,"ا",1,0],["وكفاكَ علمُكِ بالأمورِ، وليسَ من","سَلَكَ السَّبيلَ كَحَائِرٍ لَمْ يَهْتَدِ",170,"د",1,0],["وَكَفْكَفْتُ دَمْعاً، لَوْ أَسَلْتُ شُئُونَهُ","عَلَى الأَرْضِ مَا شَكَّ امْرُؤٌ أَنَّهُ الْبَحْرُ",171,"ر",1,0]]}