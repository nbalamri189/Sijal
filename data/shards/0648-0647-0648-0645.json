ل الحاكي يردد اقوا","ل سواه ولا يعي ما يقول",150,"ل",1,0],["وهو من بيتٍ شريف المنتمى","وهي ممن عرفوا بالدخل",151,"ل",1,0],["وهو مِلاك الأَمر والصِّنَاره","وكفة الميزان والإصباره",152,"ه",1,0],["وهو من السباع والجوارح","مِخلبها والطير غير الجارح",153,"ح",1,0],["وهو محيطٌ بكل شيءٍ","وكله كائنٌ بأمره",154,"ر",2,0],["وَهوَ مِن دائِهِ المُبرح قَد قا","مَ عَلى أَربعٍ بِغَيرِ شَكيمه",155,"م",2,0],["وَهوَ مَهما عَتا ولَم يَتَهَيَّب","ذَلَّ عَن أَن يَدنُو وَوَجهَي يَقرَب",156,"ب",1,0],["وَهوَ مُعَرَّضٌ لِشَكٍّ يَطرُقُ","وَفِيهِ لِلأشيَاخِ تُنمَى طرُقُ",157,"ق",1,0],["وَهوَ مُؤَدٍّ لاِفتِقَارِهِ إِلَى","مُؤَثِّرٍ لمَا عَرِفتَ أوَّلاَ",157,"ل",2,0],["وَهوَ مُحالٌ وَكَذَا الجَهلُ وَمَا","ضَاهَاهُ وَالوَصفُ بِمَوتٍ أو عَمَى",157,"م",2,0],["وهو مثل الإلهام أومأ إيماء","ففرّت له المشاعرُ جذلى",158,"ل",2,0],["وهو معروش وإن لم يعرش","ثم أوفى سانحاً منتعشا",159,"ش",2,0],["وهو من ياس وكرب قرنا","كان لي باب الرجا والفرج",160,"ج",1,0],["وهو من في موسم العليا اتجر","وتجارات المعالي لن تبور",160,"ر",1,0],["وهو ملاذ الورى اذا ما","ضمهمو للحساب حشر",161,"ر",1,0],["وهو مقصود ما أراد به","المعبود من خلقه وشرُ خفاء",162,"ا",2,0],["وَهو من قد أَقالَني عثراتي","من ذُنوبٍ جَنَيتُها أَوّاهُ",163,"ا",2,0],["وهو ماء لم تبق منه الليالي","في إناء الحياة إلا صبابة",164,"ه",1,0],["وهو مسكينٌ ضعيفٌ قدرهُ","ربِّ قتيل غائِظٍ محتبس",165,"س",1,0],["وهو ما قد ترونه غير مفض","حين انشاده إلى التعجيز",166,"ز",1,0],["وهو مشغولٌ بشيء أحسنِ","هاجهُ مرأى محُيَّاها البهِي",167,"ي",1,0],["وهو ممن صدقت أقوالهم","وتدانى دونها كل فصيح",168,"ح",1,0],["وهو ملاذي عقب خالقنا جميع الى ...ضواني","ظيقة فالصدر ولا جاتني للدمع ...خله",169,"ل",2,0],["وهو مهما زوّقوه باطلٌ","وعلى من يبذل الروح احتيالْ",170,"ل",1,0],["وهو من يوم ( أدم ) ينفتح لك يالكويت اكتاب","كتابٍ يلثم التاريخ سرى في صلب أجنابه",171,"ب",2,0],["وهو مستجيب الدعوة اللي دعاله","وهو ملتجا اللي مالقا ملتجا له",172,"ل",2,0],["وهو ما زال أعزبا وعليه","بعد من ورطة الزواج هموم",173,"م",1,0],["وهو من قوم بهم قد عرقت","عصبة من هاشم طابت نجارا",174,"ر",2,0],["وهو مسخ ما عاش إ