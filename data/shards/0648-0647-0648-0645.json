hp?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""],[6256,"أقفر الساح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65925&r=&rc=13",""]],"verses":[["وهْوَ منَ الشّبابِ أبْهى مَنظَراً","وأينَ منْ مُنبَلَجِ الفَجْرِ الدُّجى",0,"ا",1,0],["وَهوَ مِن مَعشَرٍ أَغاثوا ذَوي البُؤ","سِ وَقاموا في اللَهِ خَيرَ القِيامِ",1,"م",1,0],["وَهوَ مَتى عَلَّهُ رِجالهُمُ","أَنهَلَ مِنهُ نِساؤُهُم وَصَدَر",2,"ر",1,0],["وهو معِراجنا إلى أفْق غيبٍ","لن تناهي أبعاده والنواحي",3,"ح",2,0],["وهو مصري ومطب","وع لذيذ الاجتماع",4,"ع",1,0],["وهو مستضعف العيان ولكن","فيه للسامعين بأس قويّ",5,"ي",1,0],["وهو موسى وصاحبُ السيف والجي","ش ورُكْنُ الخِلافة الغلباءِ",6,"ا",2,0],["وهو معافىً من السُّهاد فلا","يجهل فيشري فراشُه قضضا",7,"ض",2,0],["وهو مُسْتروحٌ لقاءك إيّا","ه يرى أنه نسيمُ الشمالِ",8,"ل",1,0],["وهْو من بعد ذاك زينتُها الحُسْ","نى بذاك السَّنا وذاك الوسام",9,"م",1,0],["وهْو ممَّنْ تقدَّمَ الناسَ كالرَّأ","سِ وممن علاهُمُ كالسنام",9,"م",1,0],["وهو من بينهم سميُّ أبيه","غيرَ حرفٍ يُزاد للفُرقان",10,"ن",1,0],["وَهوَ مِثلُ الشَمسِ لَن يَبلِغَها","صاعِدٌ مَهَما تَعالى وَاِرتَقى",11,"ق",2,0],["وَهوميروسُ كَالشَيخِ كانَ ضَريرا","وَلَقَد ماتَ اِبنُ بُردٍ فَقيرا",12,"ر",2,0],["وَهوَ مَعروفٌ وَلَكِن","هُوَ مَعروفٌ مُنَكَّر",13,"ر",1,0],["وهو مغنيسياهم","واسمه صورة الصور",14,"ر",1,0],["وهو مركب من لطاف","وشداد شيبت يطبخ يسيرِ",15,"ر",1,0],["وهوَ مَنْ سُخّرَتْ لهُ الإنْسُ والجِنْ","نُ بما صَحّ من شَهادَةِ صَادِ",16,"د",1,0],["وَهوَ من غير مبدأ في اِقتياسي","وهو من غير منتهىً في اعتقادي",17,"د",2,0],["وَهْوَ مَن لا تنَالُ مِنْهُ الأَعَادِي","لَو غَدَا بَعْضُهُم لِبَعْضٍ ظَهِيرَا",18,"ر",2,0],["وهو مِثْلُ الزَّهْرِ إِنْ أكْثرْتِ مِنْ","شَمِّهِ يا زَيْنُ أمْسَى حَطَبا",19,"ب",2,0],["وهو مِثْلُ المَال إنْ أَسْرفْتِ في","بَذْلهِ للسَّائِليه سُلِبَا",19,"ب",2,0],["وَهْو من أخرجَ النُّضَار من الأر","ض، وصَفَّى من التُّراب لُبابه؟!",20,"ب",2,0],["وهو ما ضمّ كتاب ،","هو منها ، وإليها",21,"ي",3,0],["وهو ميزاب رحمة اللَه والفي","ض الإلهي المنشور للأبطال",22,"ل",1,0],["وَهوَ مِنَ الغَفلَةِ في أَهويةٍ","كَخابِطٍ بَينَ ظَلامٍ وَعَشى",23,"ا",1,0],["وهو من البُلهِ وفيما رَوَوا","أكثرُ أهلِ الجنّةِ البُلُه",24,"ه",1,0],["وَهوَ مِن كلِّ البريّاتِ اِصطَفى","عبدَهُ الهادي لأَسنى سننِ",25,"ن",1,0],["وَهوَ مِن بعدُ على اللَّه كريم","فمَتى يَشفَع يشفّعهُ بنا",26,"ن",2,0],["وهوَ من تدللهِ","هاجرٌ ومصطحبُ",27,"ب",1,0],["وهو من ملاحتهِ","سافرٌ ومنتقبُ",27,"ب",1,0],["وهو منها في ضحكٍ","وهي منهُ تنتحبُ",27,"ب",1,0],["وهو من اشرف الورى نسبا","من بني هاشم ومن كعب",28,"ب",1,0],["وهو من اشرف القبائل قوما","وهو من خير عنصر وسلالة",29,"ل",2,0],["وهو من عيش الصبا في نشوة","أثرها في خاطري لم يزل",30,"ل",1,0],["وَهَوَّمَتِ الطَيرُ بَينَ الغُصونِ","لِتَحلمَ أَحلامَها الصافِيَه",31,"ي",2,0],["وهو من بَعْدِ ذا يَسُلْ","لُ بعَيْنيه مُرْهفا",32,"ف",2,0],["وهو معنا بسرّه حيث سرنا","مثلما الحبّ قد سرى في الأحبّهْ",33,"ب",2,0],["وَهوَ مِرآةُ عَينِ روحِ حَياتي","في شُهودي وَالغَيرُ جِسمٌ وأَعضا",34,"ض",2,0],["وَهوَ مَثوى عَفوِ الإِلَهِ تَعالى","أَصلُ نورِ الوُجودِ طَهَ الصَفِيِّ",35,"ي",1,0],["وهو مرمي على الطريق ولكن","عندنا عزة له لا مكان",36,"ن",1,0],["وَهوَ مُنسابٌ يُحاكي الأرثما","مُستثيراً أَنعُماً من أبؤسِ",37,"س",1,0],["وَهُوَ مَن يَعفُهُ يُنِخ بِكَريمٍ","يَلقَ جوداً مِن ماجِدٍ مِفضالِ",38,"ل",1,0],["وهو ماض كأنه آية الفج","ر إذا حف جانبيه القتام",39,"م",1,0],["وهو من لم أبحه سرى ولم أع","لمه أمرى في ثورتي ونظامي",40,"م",2,0],["وهو من لم أهبه حبي ولم اس","كنه قلبي ولم أعره اهتمامي",40,"م",2,0],["وهو ما زال كالأساطير لفظ","حائر في الشفاه والأقلام",40,"م",1,0],["وَهوَ مُحالٌ عَلى الإِلَهِ لَدى","كُلِّ لَبيبٍ زَكا بِمَعرِفَتِه",41,"ت",2,0],["وَهوَ مِن نَفسي وَردٌ","صَحَّ مِنهُ العَرفُ وِردُ",42,"د",1,0],["وَهوَ مِنَ الجَنِّ الأولى","لَهُم سُلَيمانُ أَسَر",43,"ر",1,0],["وهْو مع ذاك مُسمِعٌ مُبْدِعٌ حُلْ","وُ المَعاني فصيحُ نُطقِ اللِّسان",44,"ن",1,0],["وهْو من دونها المُدْبِّرُ للمُلْ","كِ إذا جادَ رأْيُه بالأشِعّه",45,"ع",2,0],["وَهوَ مِرآةٌ يَبينُ بِها","مِن ضَميرِ الضِدِّ أَضغانُ",46,"ن",1,0],["وهو مما احتَسَبتُه من أيا","ديهِ وعدَّدتها وكيفَ تُعدَّد",47,"د",1,0],["وهو محرم فينهاه كما الله نهاه","بالرفق واللطف نصحا لا يعنف أخاه",48,"ا",2,0],["وَهوَ ملآنُ مِنك وداً مُصفّى","قَد نَفى المذق عنه وَالتَدليسا",49,"س",2,0],["وَهوَ مَع ما بهِ أُلوفٌ إِذا فا","رق إِلفاً فَلَيسَ يَملِك صَبرا",50,"ر",2,0],["وَهو من نَاظِري وقَلبي وإن مَل","لَ وأبدَى القِلَى مكانُ السّوادِ",51,"د",1,0],["وهْوَ ما قَدْرُهُ من العَيْنِ مثقا","لٌ ومثقالُ ذَرَّةٍ منه يكفي",52,"ف",2,0],["وهو من حين لحين لم يزل","يتعدى ربوة منذ الدلج",53,"ج",1,0],["وهو من يعرف الزئيرَ من القب","رِ إذا هَدَّمَ القبورَ الجبانُ",54,"ن",1,0],["وهو منهم في البؤسِ إن لم يكن من","هم اذا ما استعبدَ النُّهىَ الإذعانُ",54,"ن",1,0],["وهو من بَدَّل البكامَة إفصا","حاً فعافت قيودَها الأوزان",54,"ن",1,0],["وهو مع المجد على سبيله","ماضٍ مضاءَ المشرفيّ الصارمِ",55,"م",1,0],["وهو مغرىً بِيَ من بين بنيهِ","سفهاً مالكَ يا دهرُ ومالي",56,"ل",2,0],["وهو مريض ليتني","داويتهُ بعكسه",57,"ه",1,0],["وهو مِقَدّ إن خاض في مفرق ال","رأس مِقطّ لها من الكفل",58,"ل",1,0],["وَهوَ مَا بَينَ ذَا وذاكَ تَرَاهُ","فِي ابتِسَامٍ وطَلقَةٍ مِن جَبِينِ",59,"ن",1,0],["وَهوَ مِن مُعوِزٍ لِحَالِهِ شاكٍ","جابِرٌ صَدعَ مُعوِزٍ مِسكِينِ",59,"ن",1,0],["وهو موقوف على ذوق الفنا","فيه فافنوا وعليه دوموا",60,"م",3,0],["وهو مريد قادر","أركان إيجاد العوام",61,"م",1,0],["وهو مشهودنا وشاهدنا في","شاننا حيث يقظة ومنام",62,"م",1,0],["وهو معقول بمعنى","خاطر فيكم ببال",63,"ل",1,0],["وهو منسوب إليَّ كما","جاء في التكليف باسترسال",64,"ل",1,0],["وهو مني كله شكر","وثناء ما به إخلال",64,"ل",1,0],["وهو مع ذاك التنزه بادٍ","يتجلى بسافل وبعالي",65,"ل",2,0],["وهو من قبل ذائق ليس يخفى","عنه في جانب الإله دقيقه",66,"ق",2,0],["وهو محض الوجود والكل فان","فيه طراً من فرعه للأساس",67,"س",1,0],["وهو مستولٍ عليَّ بما","شاء لا يبقي ولا يذر",68,"ر",1,0],["وهو ما بيني وبيني","لم يزل يضرب سورا",69,"ر",2,0],["وهو ما زال على ما","كان جباراً غفورا",69,"ر",2,0],["وهو محيط بنا وبالأشيا","جميعها جاحد ومجحود",70,"د",1,0],["وهو معنى التكليف محض اعتقاد","حاد عنه الشقي وفاز السعيد",71,"د",1,0],["وهو من الخزرج في ذراها","وكان في الأنصار من أعلاها",72,"ه",2,0],["وهو مقال الخارجي الجائر","على الذي روي 