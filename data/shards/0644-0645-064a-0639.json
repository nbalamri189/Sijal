,"إلا وجلَّ بأن يعز كفيل",116,"ل",1,0],["لم يعدْ لي من ملاذٍ","هل تراني، خاب ظني؟",117,"ن",2,0],["لم يعدْ للشعر نايٌ","مؤنسٌ عند الرفاق",118,"ق",1,0],["لم يعشْ إلا شهوراً","بعدها أضحى كسيرا",119,"ر",2,0],["لم يعتمد نجل العميد محله","كلا ولا المولى العماد له سما",120,"م",2,0],["لم يعرفِ النسيانَ قلبي ساعةً","لا يعرفنَّ فؤادُكِ النّسيانا",121,"ن",2,0],["لم يعرفوا العلَم إِلا من مدارسِنا","ولا الفروسةَ إِلا من مجارينا",122,"ن",2,0],["لَمْ يَعْتَرِضْهُ مَسَاؤُهُ بِمَساءةٍ","إلا وضَاعَفَها عَلَيْهِ صَبَاحُهُ",123,"ح",2,0],["لَمْ يُعْطَ هذا الدَّهْرُ قَطُّ فَضِيلَةً","كَنَدى أَبِي الْيُمْنِ الْجَزِيلِ عَطاؤُهُ",124,"ا",3,0],["لَم يُعنَ يَوماً بِعانٍ في هَواهُ وَلَم","يُنقِذ بِوَصلٍ مُعَنَّىً بِاللَّظى صالي",125,"ي",1,0],["لَم يعدُ فيهِ فقه مذهب مالكٍ","إلّا لفقهِ إمامهِ النعمانِ",126,"ن",1,0],["لَم يعرُ عن حسبٍ مِن بَيتهم نسبٌ","وَلا أُبينت بِحجبٍ دونه الرحمُ",127,"م",1,0],["لَم يعدُهُ بيت الرئاسةِ واسماً","أَعقابَ كلّ متوّج ومعمّمِ",128,"م",1,0],["لَم يَعتَمِد إيفاءَ مدحكَ حقّهُ","بِل قصدَ هادٍ مقتفٍ لغموسِ",129,"س",1,0],["لَم يُعطِها إِلّا أَميناً صادِقاً","شَهماً هُماماً بِالعُلا ما أَجدَرَه",130,"ر",2,0],["لَم يَعلِ مَنصِبُ في قَضا وادارِهِ","إِلّا وُضوءَ كَمالِهِ قَد نورَه",130,"ر",2,0],["لَم يَعتَرِف بِمَعانيها لَدى أَحَدِ","فَدَعهُ يُنكِرُ أَو يَرتابُ في نَكَدِ",131,"د",1,0],["لم يعد لي من حبّكم غير أحلا","م صداها يشتّت الأحلاما",132,"م",2,0],["لم يعد فيك ما يسّر العيونا","فاعذري العابثات والعابثينا",133,"ن",2,0],["لم يعد غير ليلة وصباح","وأوارى في ضجّة النائحات",134,"ت",1,0],["لم يعد في الظلام روح شقي","غير روح محا الظلام سناها",135,"ه",2,0],["لم يعرهُ جبنٌ ول","كن روحه ضاقت بهونه",136,"ن",2,0],["لَمْ يَعُدْني مُحَمَّدٌ مُذْ تَشَكَّيْتُ","وَكَمْ جِئْتُهُ وَحَاشاهُ عَائِدْ",137,"د",1,1],["لَم يَعدُ فيهِ أَسَدٌ حَدَّهُ","إِلّا أَراهُ حَتفَهُ الكَلبُ",138,"ب",1,0],["لَم يَعرِفِ العَقلُ البَسيطُ جَمالَهُ","لَو لَم إِلَيهِ بِوَصفِهِ يَتَعَرَّفُ",139,"ف",1,0],["لَم يَعِبكَ الِّي بِعَينِكَ عِندي","أنتَ أعلَى مِن أَن تُعَابَ وَأسنَى",140,"ن",2,1],["لِمَ يَعلُو سَرجَهُ مَن لَم يَقُم","فِي بَدَادَيهِ ضَرُوباً مِدعَسَا",141,"س",2,0],["لم يَعْدَمِ اللّفْظَ تَحْبيري وإنْ وَجَدوا","خلْفَ المعاني إذا ما قلتُ إمعاني",142,"ي",1,0],["لم يَعْهدوا كمَضاءٍ في صَوارمه","في سَيْفِ غِمْدٍ ولا في سَيْفِ غُمْدان",143,"ن",1,0],["لم يَعتَمِدْ في العُلا من أَمرِها طَرَفاً","ولم يقَعْ رأْيُه في نَقْدِها غَلَطا",144,"ط",2,0],["لم يَعْصِ أمرَك رأسُ أغلبَ أبيضٍ","إلاّ تَعّوضَ صدْرَ أعجَفَ أَسمَر",145,"ر",1,0],["لِمَ يَعجَبونَ فَإِنَّها","كَيَدٍ تُحَدِّثُ عَن حُسامِ",146,"م",1,0],["لَم يَعُمَّ المَشيبُ أَسبابَ جَهلي","شَيبُ شِهري خِلافُ شَيبِ شِعاري",147,"ر",2,0],["لم يَعلموا بقفُولها عَن أرضِهم","سيما وقد عَلموا بأن سيعودُ",148,"د",1,0],["لَم يَعرِفوا لِضَلالِهِم","فَضلَ الزَئيرِ عَلى الصِياحِ",149,"ح",1,0],["لَم يَعلَموا أَنَّ الهَوى يَهوى بِمَن","تَركَ العَقيدَةَ رنة الأَنسابِ",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","غَلَبَ الخضارِمَ كلَّ يومِ غلابِ",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","آخى النَبِيَّ اخوَّةَ الاِنجاب",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","سَبَقَ الجَميعَ بِسُنَّةٍ وَكتاب",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","لَم يَرضَ بِالأَصنامِ وَالأَنصاب",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","آتى الزَكاةَ وَكانَ في المِحراب",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","حَكَمَ الغَديرُ لَهُ عَلى الأَصحاب",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","قَد سامَ أَهلَ الشِركِ سَوم عَذاب",150,"ب",1,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","أَزرى بِبَدرٍ كُلَّ أَصيَدَ آبي",150,"ب",2,0],["لَم يَعلَموا أَنَّ الوَصِيَّ هوَ الَّذي","تَرَكَ الضَلالَ مُفَلَّلَ الأَنياب",150,"ب",1,0],["لَم يَعبَث التَقليدُ بي وَمَحَبَّتي","لعمارَة الأَسلافِ وَالأَحسابِ",150,"ب",1,0],["لَم يَعلَموا وَالأَذانُ يرفعُكُم","صوتَ أَذانٍ أَو قَرعَ ناقوس",151,"س",1,0],["لم يعد واللهِ من عذرٍ لكم","قامت الحُجَّةُ مهما تدَّعون",152,"ن",1,0],["لم يعرِفُوا لكُم قدْراً وإن كَرُمَتْ","أخْلاقُهم وعرفنا قدرَ فضلِكُمُ",153,"م",1,0],["لم يعانِ الزّرنيخَ وهو لعمري","فيه للداء في الذقون دواء",154,"ا",2,0],["لم يعتقل سمهريا يوم معركةٍ","إلّا وقام مقام الجحفل اللجب",155,"ب",1,0],["لم يَعْبُدُوا الأَصْنامَ إِلّا أَنَّهُمْ","عَبَدُوا الغُرورَ عبادَةَ الأَصْنامِ",156,"م",1,0],["لم يعرف الصبر عنكم","ولا الهدو فؤادي",157,"د",2,0],["لم يعرف الموَتى حياةَ مثلها","ذُخرَت وَشَعَّت من أَعزِّ حقائقِ",158,"ق",1,0],["لم يعتصم بالمكر إلى عالما","أن ليس إن صدَقَ الكريهةَ ناجيا",159,"ي",2,0],["لم يعدُ في كُوفانَ خصمُك أن رأى","فيه مقامَ أبيك في صِفِّينِ",160,"ن",1,0],["لم يعترِقْ بنانَهُ ندامة","على الندى ولا ندىً مع الندَمْ",161,"م",1,0],["لم يعقدوا للرأي فيها حَبوةً","يوماً ولا اقتسموا عليها فالا",162,"ل",2,0],["لم يعتلقني بأثامٍ حبلُها","ولم ينلني عارُها ولم يَكَدْ",163,"د",1,0],["لم يُعبني فضلٌ أداريهم به","وإنما أعيا عليّ الجَدُّ",164,"د",1,0],["لم يعدُ من وصف الأسودِ","سوى الجهالة والجهامة",165,"م",2,0],["لَم يَعجِ البَقمِ عَن عاجِها","حَتّى اِستَعارَت مِنهُ لَوناً أَنيق",166,"ق",1,0],["لم يعقني عن العيادة شغل","أو فيكم تعوقني الأشغال",167,"ل",1,0],["لم يعتصب وينتخب لذاته","غير الهدى وأهلهُ عصائِبا",168,"ب",2,0],["لَم يَعلَم النَعشَ ما عَلَيهِ مِن ال","عرف وَلا الحامِلونَ ما حَمَلوا",169,"ل",3,0],["لم يَعيشوا من فوقِها غَيرَ نَزر","حَسِبوهُ في آخِرِ الأمرِ دَهرا",170,"ر",2,0],["لم يعطني قبل الرّضا","حتَّى تسلّفَهنَّ قبْلا",171,"ل",2,0],["لم يَعُقْنا عن بلوغ الأماني","في المعالِي ما ثناكمْ وعاقا",172,"ق",2,0],["لَم يُعيِني بعد أن أعيا الرّجال معاً","من بين شُمٍّ كنجم الأُفق أو شُوسِ",173,"س",1,0],["لم يعرفوا غيرَ بثِّ العُرْفِ بينهمُ","عفواً ولا طُبعوا إِلّا على الجودِ",174,"د",1,0],["لم يعدُنِي بلْ خصّنِي","خَطْبٌ به فينا عُريتا",175,"ت",2,0],["لَم يَعدُها الشَوقُ قَلبي وَهيَ في يَدِها","لَقَد تَسَلّى بِها أَو بي لَقَد غَدَرا",176,"ر",2,0],["لم يَعشَقِ الدُنيا فلم يَجْزَعْ إذا","ولَّت وإنْ هيَ أقبَلَتْ لم يَطرَبِ",177,"ب",1,0],["لم يُعَلِّلْ نصيبَهُ من مَعَالي","جدِّه يَعُرب الكريمِ النِّصابِ",178,"ب",1,0],["لم يُعْدِه بالبُخْل من أَخْلاقِها","فَلَطالَما سَمَحت وقَلْبي مَا سَمَح",179,"ح",1,0],["لَم يَعلَموا أَن قَد مَشى حَذَرَ الخَزى","بِالسَيفِ لِلمَوتِ اِبنُ بَدرَةَ بَيهَسُ",180,"س",1,0]]}