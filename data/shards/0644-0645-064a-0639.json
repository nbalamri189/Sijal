","https://www.aldiwan.net/poem47744.html","البسيط"],[549,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[549,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[551,"إيها دع اللوم عني لست مزدجرا","https://www.aldiwan.net/poem68366.html","البسيط"],[560,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[573,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[574,"أبلغ ضبيعة كهلها ووليدها","https://www.aldiwan.net/poem1779.html","الكامل"]],"verses":[["لَم يَعتَقِلهُ الحَبسُ مُم","تَهَناً وَلَم يُعزَل ذَميما",0,"م",2,0],["لَم يَعِش مَن عاشَ مَذموماً وَلا","ماتَ أَقوامٌ إِذا ماتوا كِراما",1,"م",2,0],["لَم يَعدَموا يَومَ حَربٍ تَحتَ قَسطَلِها","طَيرُ الدِخامِ عَلى لَبّاتِهِم تَقَعُ",2,"ع",1,0],["لَمْ يَعْرِفِ الدَّهْرُ قَدْرِي حينَ ضَيَّعَنِي","وَكيفَ يَعْرِفُ قَدْرَ اللَّؤْلُؤِ الصَّدَفُ",3,"ف",1,1],["لَمْ يُعْطِ مَا أَعْطَيْتَ مُعْطٍ قَبْلَهَا","مِنْ صَامِتِ بُرٍّ وَمِنْ أَثْوَابِ",4,"ب",1,0],["لَم يُعَوِّد جُنودَهُ يَومَ خَطبٍ","أَن يُنادى فَلا يَرُدُّ الجَوابا",5,"ب",2,0],["لَم يَعبَه أَن تَجَنّى دَهرُهُ","رُبَّ جِدٍّ حادَ عَن مَجراهُ جَد",6,"د",1,0],["لَم يَعلُها عَنكَبوتٌ أَينَما تُرِكَت","وَلا تُخافُ عَلَيها سَطوَةُ اللَهَبِ",7,"ب",1,0],["لَم يَعيَ أَحمَدُ أَن يَجي","ءَ بِآيِ قَيسٍ أَو نِزارِ",8,"ر",1,0],["لَم يَعزُبِ الوَصلُ فيما بَينَنا أَبَداً","لَو كُنتِ واجِدَةً مِثلَ الَّذي أَجِدُ",9,"د",1,0],["لَم يَعلَموا أَنَّ الهَوى","رِقٌّ وَأَنَّ الحُسنَ أَحمَر",10,"ر",1,0],["لَمْ يَعْتَوِرْ مَجْدَهَا مَهْدُومُ أَرْوِقَةٍ","وَلَمْ يُذِلْ فَنَّهَا مَهْدُودُ أَرْكَانِ",11,"ن",1,0],["لَمْ يَعْدُ أحْكَمَ خُطَّةٍ يَخْتَطُّهَا","فِيمَا يُبَاعِدُ تَارَةً وَيُدَانِي",12,"ن",2,0],["لَمْ يَعُزِّ التَّمَامِ عَنْهَا سِوَى","أَنَّ الَّتِي أَنْجَبَتْ مِثَالَ التَّمَامِ",13,"م",1,0],["لم يعرف التركيبَ سيفُكَ في الوغى","فاعجبْ له قد أحكم التحليلا",14,"ل",2,0],["لم يعِب ربُّها ولا الناسُ منها","غير إنذارها عليه الحميرا",15,"ر",2,1],["لم يَعِبْها سوى قوافٍ تشاغل","نَ عن المدح فيك بالتشبيبِ",16,"ب",1,0],["لم يَعْتصِبْ ذو حرمةٍ","بعصائب العار اعتصابهْ",17,"ب",2,0],["لم يُعادِلْهُ في كمالِ المعاني","توأمُ الحُسنِ من بني يعقوبِ",18,"ب",1,0],["لم يعرفا خيمةً ولا وَتِداً","ولا عموداً لها ولا طُنُبا",19,"ب",2,0],["لم يَعْنه أرَقِي وفيه لقيتَهُ","حتى أضرَّ بمقلتي إلحاحُهُ",20,"ح",2,0],["لم يُعْمِل السَّيْفَ ظُلماً في ضَرائبه","فلم يُسَلَّطْ عليه سيفُ ذي قَوَدِ",21,"د",1,0],["لم يُعلها السَّقْي بل تعالت","من قبل أن تسقي العبادا",22,"د",2,0],["لم يعتصم عودُها بزامرةٍ","ولا ضوى وجهها إلى السُّترِ",23,"ر",1,0],["لم يعد أن أرعف الأقلام يرفدهم","ولو عتوا رعف الخرصان إرعافا",24,"ف",2,0],["لم يعبهنَّ عند ذي الجهلِ إلّا","أنَّ ساعاتِهنَّ غيرُ طوالِ",25,"ل",1,0],["لم يعوَّض بُدن النساء كقوم","حُرِموا حظهم من الأذهان",26,"ن",1,0],["لم يعانِدْ أخٌ أخاه بأن خفْ","فَفَ من ثِقْل مِحْنَةٍ عن بنيه",27,"ي",2,0],["لَم يُعَفِّر جَبينَهُ في التُرابِ","لَم يُوارِب في مَوقِفٍ لَم يُحابِ",28,"ب",1,0],["لَم يَعتَقِد بِالعِلمِ وَهوَ حَقائِقٌ","لَكِنَّهُ اِعتَقَدَ التَمائِمَ وَالرُقى",29,"ق",2,0],["لَم يَعشَقِ الناسُ الفَناءَ وَإِنَّما","فَوقَ البَصائِرِ وَالعُقولِ سُدولُ",30,"ل",1,0],["لَم يَعرِفِ الأَقوامُ حَقّاً واجِباً","إِلّا وَخدمتُها أَحَقُّ وَأَوجَبُ",31,"ب",1,0],["لمْ يَعُدْ لي بقاءْ","فَوْقَ هذي البقاعْ",32,"ع",1,0],["لم يعول على السلاح لدرء","الضيم عن مصر بل على الادراك",33,"ك",1,0],["لم يعطهم من نعمة الأولاد ما","أعطى الخلائق مثريا وفقيرا",34,"ر",2,0],["لَم يُعطَ هِمَّتَهُم وَلا إِحسانَهُم","بانٍ عَلى وادي المُلوكِ هُمامُ",35,"م",1,0],["لَم يُعيِهِ لَفظٌ وَلا مَعنىً وَلا","غَرَضٌ وَلا نَظمٌ وَلا مَنثورُ",36,"ر",1,0],["لَم يُعافَ قَبلَكُما","والِدٌ وَلا وَلَدُ",37,"د",1,0],["لَم يُعَلِّم قَومَهُ حَرفاً وَلَم","يُضِىءِ الأَرضَ بِنورِ الكَهرُباء",38,"ا",2,0],["لَم يُعادِ اللَهُ العَبيدَ وَلَكِن","شَقِيَت بِالغَباوَةِ الأَغبِياءُ",39,"ا",2,0],["لَمْ يَعِشْ أَنّهُ جَليدٌ ولكنْ","دَقَّ جِدّاً فما تَراهُ العُيونُ",40,"ن",1,0],["لَمْ يَعْبُدِ الأَصْنَامَ قَطُّ","ولا أَرابَ ولا عَتَا",41,"ت",2,0],["لَم يَعِبهُ أَن بُزَّ مِن بُسُطِ الدي","باجِ وَاِستَلَّ مِن سُتورِ المَقسِ",42,"س",1,0],["لَم يَعبَ لِلنِعمَةِ الجَزاءَ لَم","يَقدُر جَليلَ المَعروفِ ما ثَمَنُه",43,"ن",2,0],["لَم يَعِبهُ إِلّا حُضورُ الهَدادِيِّ","عَلَيهِ لَعائِنُ الرَحمَنِ",44,"ن",1,0],["لم يعلُ نجمُكَ في أعلى مَطالِعِه","حتى غدَتْ أنجُمُ الأعداءِ تَنتشِرُ",45,"ر",1,0],["لم يُعْزَ دُرُّ عقودِه","إلا إلى بحرِ الخَواطِر",46,"ر",1,0],["لَم يَعمَلِ الناسُ في التَصحيحِ بَينَهُمُ","فَاِضطَرَّ بَعضُهُمُ بَعضاً إِلى الخُدَعِ",47,"ع",1,0],["لَم يَعدُ حَيٍّ رِزقُهُ","رِزقُ اِمرِئً حَيثُ قُسِم",48,"م",1,0],["لَم يَعتَصِم بِاللَهِ مِن خَلقِهِ","مَن لَيسَ يَرجوهُ وَيَخشاهُ",49,"ا",2,0],["لَم يَعلَمِ العالِمونَ ما فَقَدوا","مِنهُ وَلا الأَقرَبونَ ما عَدِموا",50,"م",3,0],["لَم يَعلَموا أَيَّ جُذوَةٍ قَدحَوا","وَأَيَّ أَمرٍ إِلَيهِ قَد قَدِموا",51,"م",3,0],["لَم يَعقِلوا إِلّا وَآجامُ القَنا","سورٌ لَها وَدَمُ الفَوارِسِ خَندَقُ",52,"ق",1,0],["لَم يَعفُ بَل قَطَعَ الأَكُفَّ وَأَرجُلاً","مِن بَعدِ ما سَمَلَ النَواظِرَ مِنهُمُ",53,"م",1,0],["لم يعرف الجسمُ خلاصاً به","من كُدرَةِ الطين ولم تَنجُ روح",54,"ح",1,0],["لَم يُعطِكَ اللَهُ الَّذي أَعطاكَهُ","حَتّى اِستَخَفَّ بِبَدرِهِ وَبِشَمسِهِ",55,"س",2,0],["لَم يَعرِفوا مِثلَهُ جَمالاً","جَلَّ عَنِ المِثلِ وَالنَظيرِ",56,"ر",1,0],["لَم يَعُقهُ بَعدَ المَقاديرِ عَنهُ","غَيرُ سِترٍ مِنَ البِلادِ رَقيقِ",57,"ق",1,0],["لَم يُعطِ نازِلَةَ الهَوى حَقَّ الهَوى","دَنِفٌ أَطافَ بِهِ الهَوى فَتَجَلَّدا",58,"د",2,0],["لم يُعنَ بالعلياءِ إلا سيداً","ولا شفى ذا الغيِّ إلا ذو هُدى",59,"د",2,1],["لم يُعْطِ أوطانَ العُروبةِ حَقَّها","من كان يَطْمَعُ أن تُباعَ وتُوهَبا",60,"ب",2,0],["لَم يَعلَموا ما سِرّه فَإِذا بَكى","حَسبوه يَضحك للربيع المُقبلِ",61,"ل",1,0],["لَم يَعدَموا رائِحاً مِن إِرثِ مَجدِهِمِ","وَلَن يَبيتَ سِواهُم حِلمُهُم عَزَبا",62,"ب",2,0],["لم يعلموا أنّ ذاكَ العزمَ مُنصَلِتٌ","وأنّ تِلكَ المنَايا بالمَراصِيد",63,"د",1,0],["لَم يَعرِفوا حَقَّ الهَوى فَلَحوا","لَو جَرَّبوهُ تَبَيَّنوا عُذري",64,"ي",1,0],["لَم يُعطَ إِلّا مِثلَهُ النُواسي","لَم يُعطَ إِلّا م