{"poems":[[88,"كم مر بي فيك عيش لست أذكره","https://www.aldiwan.net/poem10506.html","البسيط"],[88,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[53,"قل للأمير أدام الله دولته","https://www.aldiwan.net/poem8700.html","البسيط"],[45,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[82,"ولما تنازعن معنى الحديث","https://www.aldiwan.net/poem31372.html","المتقارب"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[46,"عثمان لا تلهج بذكر محمد","https://www.aldiwan.net/poem30027.html","الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[164,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[189,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[214,"بدر توارى في من رقبائه","https://www.aldiwan.net/poem13380.html","الكامل"],[280,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[287,"ماست كخوط البانة المياس","https://www.aldiwan.net/poem32736.html","الكامل"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[409,"وأما شيوخي في العلوم فإنهم","https://www.aldiwan.net/poem33941.html","الطويل"],[422,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[435,"ويوم فوق وادي القرن جالت","https://www.aldiwan.net/poem40748.html","الوافر"],[438,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[463,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[469,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[519,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[520,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[556,"وما مرح الفتى تزور عنه","https://www.aldiwan.net/poem47893.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138370",""],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104008","الكامل"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/113001","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48588","البسيط"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67845","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119268","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203785","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80236","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143134","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79844","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114006","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108816","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116558","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53029","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26154","المجتث"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100914","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140108",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139927","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205902",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40106","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90859","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120554","البسيط"],[5030,"سهر","https://www.poetsgate.com/ViewPoem.aspx?id=215698",""],[5145,"هذا الربيع وهذه أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=108102",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5385,"عهدنا بغرب مطلع البدر مشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=144220",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5582,"مُذْ حُلْنَ دُونَكِ يا سُعادُ فَراسِخُ","https://www.poetsgate.com/ViewPoem.aspx?id=186855",""],[5596,"جامع الإمام الخليل بن شاذان","https://www.poetsgate.com/ViewPoem.aspx?id=206784",""],[6068,"هل تارك روحي لنصح العاذل","https://www.poetsgate.com/ViewPoem.aspx?id=181693",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""]],"verses":[["فَكانَ عَوني عَلى وَجدٍ أُكابِدُهُ","وَمُرِّ عَيشٍ عَلى العِلّاتِ أَلقاهُ",0,"ا",2,0],["فَكانَ عَلى أَبوابِ مَكَّةَ رَكبُهُ","وَفي يَثرِبٍ أَنوارُهُ تَتَفَجَّرُ",1,"ر",1,0],["فكان عوناً عليه ما استعانَ به","وشتَّتَتْه يداهُ أَيَّ تشتيتِ",2,"ت",1,0],["فَكانَ عَنها سَبَبَ التَرحالِ","تَشويقُ إِكثارٍ إِلى إِقلالِ",3,"ل",1,0],["فكان علينا الهوى لا لنا","وعَنَّ الفراقُ وَمِنهُ الفرَق",4,"ق",1,0],["فكأنّ عينك منه واقعةٌ على","بطَلٍ مُبِيدٍ في الحروب مُبَادِ",5,"د",1,0],["فَكَأَنَّ عِرضَكَ في السُهولَةِ وَجهُهُ","وَكَأَنَّ وَجهَكَ في الحُزونَةِ عِرضُهُ",6,"ض",2,0],["فَكانَ عامَ وُفودٍ كُلَّما اِنصَرَفَت","عِصابَةٌ أَقبَلَت أُخرى عَلى قَدَمِ",7,"م",1,0],["فكان عليك عضْباً فوق عَضْبِ","تبخترْ وامضِ مسنوناً صَقيلا",8,"ل",2,0],["فَكَأَنَّ عاقِدَهُ كُراتُ زُمُرُّدٍ","وُكَأَنَّ زَاهِرَهُ كَواكِبُ في الرُوَا",9,"ا",1,0],["فكان عليه وحده عار قتله","وكانت لك الاموال عفو بلا صدف",10,"ف",1,0],["فكأن عيشي كان بينهما","قبل التفرق روضة أُنُفا",11,"ف",2,0],["فَكانَ علَيهم قيدهُ بسلاسلٍ","وَأَن يحجروهُ عَن فظائعهِ حجرا",12,"ر",2,0],["فكانَ عَلى الرسلِ الإمامَ المُقدّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",13,"م",2,0],["فكأن عرف المسك خالط تربه","او در كافور على حصبائه",14,"ا",3,0],["فكأنَّ عهْداً من وليّ العهدِ لي","أنْ تُسْفِرَ الغَمراتُ عنّيَ غَالبا",15,"ب",2,0],["فَكَأَنَّ عافِيهِ زُهَيرٌ مادِحاً","هَرِماً فَحادَ بِهِ عَنِ الإِفلاسِ",16,"س",1,0],["فكأنَّ عَينَ الشّمسِ عَينٌ أصبَحتْ","لعُلاكَ وهْي على الطّريقِ المَهْيَع",17,"ع",1,0],["فكان علينا واجب كشف جهلكم","بنظم كدر في الطروس منضد",18,"د",1,0],["فكان عيدٌ من الأَعياد سُرَّ به","أهلُ الحفيظة من حافٍ ومنتعل",19,"ل",1,0],["فكان عالي أمره بطبعه","ونشره في كل أقطار الملا",20,"ا",1,0],["فكان على بني حجلان غمّا","وللشهب الكواسر عدَّ عيدا",21,"د",2,0],["فكأنّ عدلَك أُقحوانةُ ثغرِه","وكأن بأسكَ جُلّنارة خدّه",22,"د",2,0],["فكان على ذاك شَمُّ السَّفا","ولسُّ الهشيم وإن كان مُرَّا",23,"ر",2,0],["فكأن عيد النحر دهرك كلُّه","من غير ما نفرٍ وساحتها منى",24,"ن",2,0],["فكأنّ عينَ الشمسِ كانت ضرّةً","تَسقيهِ من لبَنِ الصّباحِ وتُرضِعُ",25,"ع",1,0],["فكأن علم الكائنات وديعة","مخزونة وصدوركم خزانها",26,"ن",3,0],["فكان على قَذى الأيّامِ صفوِي","وكان على حَنادِسها صباحِي",27,"ح",2,0],["فكان عزرائيل اقبل شاهراً","سيفا على عنقي غدا مسلولا",28,"ل",2,0],["فكانّ عُذرةَ بينها تحكي لنا","صفة الخضوعِ وحالةَ المعمودِ",29,"د",1,0],["فكان عند المائة الأولى عمر","خليفة العدل بإجماع وقر",30,"ر",1,0],["فكان عهدكم إفكاً وأوجهكم","كأنها الخمر أشكالاً وألوانا",31,"ن",2,0],["فَكانَ عُقبى أَمرِهِم نَدامَة","لَكِنَّها آلَت إِلى سَلامَة",32,"ه",1,0],["فَكَانَ عَلىَ حُبِّ الثَّوَابِ مُحَرِّضَا","لأَهْلِ النُّهى مِنْهُ الْبِشَارَةُ وَالرِّضَا",33,"ض",2,0],["فكان على أزم الخنا وخطابه","أخا خفر لا يختلي غير طابه",34,"ه",1,1],["فكان عظيما والشباب رداؤه","وأعظَمَ بأسا، واللجين ذوائبه",35,"ب",2,0],["فَكانَّ عاصِفَة المَحَبة وَالنُهى","ريح الجُنوبِ يَقُلُّ رَجُلَ جَرادِ",36,"د",1,0],["فكأنَّ عينا للغواني لم يزل","بالسرٍّ يخبرهنَّ أو جاسوسا",37,"س",2,0],["فكأَنَّ عُرس المصطفى فيه الورى","كلّ محمدُ صالحٍ أَن يطربا",38,"ب",2,0],["فَكَأَنَّ عَيني مطفلٍ بخَميلَةٍ","بينَ الصرائمِ خاذِلاً عيناها",39,"ا",3,0],["فكأن عيسى يوم ضم صليبه","ألقى إليه أعنة الأعمال",40,"ل",1,0],["فكان عيشٌ على السرّاءِ مُطَّرِدٌ","يُزري بِهَمٍ عن الاحشاءِ مطرودِ",41,"د",1,0],["فكأن عين الشمس قبل ذُرُورِها","فيها ثنته بمقلة رمداء",42,"ا",2,0],["فَكَأن عزرائيل خط فرنده","وَبِهِ أَحاديث الحمام سُطور",43,"ر",1,0],["فَكانَ عُقبايَ عُقبى","نَبيهِ يَعقوبِ",44,"ب",1,0],["فكأنَّ عينيَّ اللتين غزتهما","تلكَ الدموعُ تطايران شرارا",45,"ر",2,0],["فكان عقرب صدغها في خدها","لما بدا تحته قلب العقرب",46,"ب",1,1],["فكأنَّ عيني وجفني غطائي","ولآلى الحُلى دمعُ المآقي",47,"ق",2,0],["فكأن عابره إذا","أمسى طَرِيدَةَ هيكلِ",48,"ل",1,0],["فكان عاقبة الأقوام أن هلكوا","لهم عذابان سجين وسجّيل",49,"ل",1,0],["فكان عَويلي رَعْدُهَا وابْتسامُهُ","وَمِيضاً وأهواء القُلُوبِ جنُوبها",50,"ب",3,0],["فكأن عبني واحمرار دموعها","يد سيدي البيضاء تمطر عسجدا",51,"د",2,0],["فكان عقباهم حزا لندامة","صدورهم بعد خسران وتتبيب",52,"ب",1,0],["فكان عاصرُها من فوقهِمْ شفقًا","وكان ساكِبُها كالريحِ في كاسي",53,"س",2,0],["فكأن عدل بهاء دين الله قد","أضحت له ثقة به استنصاره",54,"ر",2,0],["فكان علينا واجباً متعيناً","إجابته لما هدى وأتى هجراً",55,"ر",2,0],["فكان عياناً فوق ما وصفوا لنا","وشاهدت فرداً بالكمال تخلقا",56,"ق",2,0],["فَكَانَ عَلى يَدَيْهِ الحَقُّ يُبْنَى","وَ كَانَ الغَيُّ مُنْصَاعًا لِهَدْمِ..",57,"م",1,0],["فَكَأَنَّ عَقْرَبَها لِقَلْبِي عَقْرَبٌ","وَالأَسْوَدَ المَضْفُورَ أَسْوَدُ سالِخُ",58,"خ",1,0],["فكان عزاه فيه يوم افتتاحه","فأمسى له للخلد فتحاً ومعبرا",59,"ر",2,0],["فكأنّ عين الماء في جنباتها","دمع الحزين على الحبيب الراحل",60,"ل",1,0],["فكأنَّ عصرَكمُ .. انقضى","وكأنَّ في الأفق انعتاق",61,"ق",1,0]]}