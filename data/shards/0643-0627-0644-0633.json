//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83636&r=&rc=17",""]],"verses":[["كَالسِلكِ ضاعَفتَ بِهِ النِظاما","إِلامَ مَدَّ بَحرُكُم إِلاما",0,"م",2,0],["كَالسِربِ أَوجَسَ نَبأَةً مِن قانِصٍ","فَمَضى يَلُفُّ مُؤَخَّراً بِمُقَدَّمُ",1,"م",1,0],["كَالسيدِ لا يَنمي طَريدَتَهُ","لَيسَ لَهُ مِمّا يُحانُ حِوَل",2,"ل",1,0],["كالسيف مُنصَلِتاً تُضاحِك وجهَه ال","أنوارُ وهي عليه مُلتَمِعات",3,"ت",1,0],["كَالسامِرِيِّ غَداةَ ضَلَّ بِقَومِهِ","وَالعِجلُ يُعكَفُ حَولَهُ وَيَخورُ",4,"ر",1,0],["كالسهم ذي النصل لا نُهوضَ به","ما لم يكن ريشُهُ ولا عَقَبُهْ",5,"ب",2,0],["كالسيف في القَدِّ والصرامة وال","رَوْعة لكنَّ حَلْيَهُ أدبُهْ",5,"ب",2,0],["كالسَّيف ذو لين لمن مسَّه","صَفْحاً وفي شفرته الذبْحُ",6,"ح",1,0],["كالسّماعِ الذي يحرِّك للهُيْ","يَاب إطرابَهُم وللبخَّالِ",7,"ل",1,0],["كالسَّماء الضَّحُوكِ كاللَّيلَةِ القمراءِ","كالوردِ كابتسامِ الوليدِ",8,"د",1,0],["كالسيف عريانا ولي","س بلابس الا فرندا",9,"د",2,0],["كالسيلِ لولا أنه دُفَعٌ","والليلِ لولا أنهُ ظُلَلُ",10,"ل",1,0],["كَالسَيفِ يَقطَعُ وَهوَ مَس","لولٌ وَيُرهَبُ وَهوَ مُغمَد",11,"د",1,0],["كَالسَيفِ يَكسِرُ مَتنَهُ","قَصَرَ العِدى وَيُبيرُ حَدُّه",12,"د",2,0],["كَالسَيفِ في ذاتِ الإِلَهِ وَقَد يَرى","كَرَماً كَفَرعِ النَبعَةِ المُنآدِ",13,"د",1,0],["كَالسَهمِ لا يَكتَفي بِوَحدَتِهِ ال","قانِصُ حَتّى يُعينَهُ وَتَرُه",14,"ر",2,0],["كَالسَيفِ في إِخذامِهِ وَالغَيثُ في","إِرحامِهِ وَاللَيثُ في إِقدامِهِ",15,"م",2,0],["كَالسَيلِ أَصبَحَ في ذُراكَ أَتِيُّهُ","وَالصُبحُ مُصحٍ ما يُحَسُّ غَمامُهُ",16,"م",2,0],["كَالسامِرِيِّ يَقولُ إِن حَرَّكتَهُ","دَعني فَلَيسَ عَلَيَّ غَيرُ إِزاري",17,"ر",2,1],["كالسَّيلِ تَحفِزُ أُولاهُ أواخِرُه","حتى أسالَ دُروبَ الرُّومِ سَائِلُه",18,"ل",2,0],["كَالسُمرِ تُبدي لِلنَواظِرِ مَنظَراً","مُتَأَلِّقاً وَالمَوتُ في شَفَراتِها",19,"ت",3,0],["كَالسَيفِ يُبدي لِلنَواظِرِ مَنظَراً","طَلقاً وَيُمضي في الهَياجِ مَضارِبا",20,"ب",2,0],["كَالسَيلِ يُحمَدُ مِنهُ عَذباً واصِلاً","وَيَعُدُّهُ قَومٌ عَذاباً واصِبا",20,"ب",2,0],["كَالسَّيفِ هُزَّ غِرارُهُ بِيَدٍ","لِلضَّربِ وهوَ مُصَمِّمٌ ذكَرُ",21,"ر",1,0],["كَالسَيفِ لَيسَ بِزُمَّلٍ شِهدارَةٍ","يَوماً وَلا بِغُضُبَّةٍ جَبّاهِ",22,"ه",1,0],["كَالسَرابِ الرَقراقِ في النَعتِ إِلّا","أَنَّهُ لَيسَ مِثلَهُ في الخِداعِ",23,"ع",1,0],["كَالسَيفِ يُعطيكَ مِلءَ عَينَيكَ مِن","فِرِندِهِ تارَةً وَمِن رُبَدِه",24,"د",2,0],["كَالسَيفِ أَغمِدهُ يَكُن لَكَ حِليَةً","أَو لا فَجَرِّدهُ يَكُن لَكَ مَأمَنا",25,"ن",2,0],["كَالسَيفِ أَخلَصَهُ الجَلاءُ وَصانَهُ","تَصميمُهُ بِجَماجِمِ الكُفّارِ",26,"ر",1,0],["كَالسَيفِ سُمِّيَ قَطّاعاً وَما ضَرَبَت","بِهِ الأَكُفُّ وَلا في هامَةٍ وَلَغا",27,"غ",2,0],["كَالسَوامِ الأَنامُ هَل فازَ مَن سا","فَرَ مِنهُم إِلى بَطيءِ المَراحِل",28,"ل",1,0],["كالسهْمِ لا تَنْبُو إِذَا","نَظَرَتْ ولا تُخْطِي الرَمِيَّهْ",29,"ي",2,0],["كَالسيف سُلَّ مِنَ الْقِرا","بِ مُثَقَّفَ الْحَدَّيْنِ عَضْبَا",30,"ب",2,0],["كالسيلِ في تحديرهِ والسيفِ في","تطبيقِه والرُمحِ في تثقيفه",31,"ف",2,0],["كالسّيْفِ يَكسِرُ مَتْنُهُ","قَصَرَ العِدَى، وَيُبيرُ جِدّهْ",32,"د",2,0],["كالسّيْفِ في إخْذامِهِ، وَالغَيْثِ في","إرْهَامِهِ، وَاللّيْثِ في إقْدامِهِ",33,"م",2,0],["كالسّبايا لطمن خدّا ومزّقن","شفوف الحرير بردا فبردا",34,"د",2,0],["كالسراب الرقراق يحسبه الظمآ","ن ماء وما به من ماء",35,"ا",2,0],["كالسمهرىّ عزمُه لو لم يكن","ينقُص عنه الرمحُ باضطرابهِ",36,"ب",2,0],["كالسيف رونقُ أَثْرِهِ في متنهِ","ومضاؤه في حدِّه المسنونِ",37,"ن",1,0],["كالسيف يأمن صفحتيه ماسح","ويميل عن حديهما ويحاذر",38,"ر",1,0],["كالسيف يَخْترِم النفوس غرارُه","ورُواهُ يُعجِب ناظرَ الإنسان",39,"ن",1,0],["كالسيف والرمح حين يَخفَى","فعلهما في يدِ الجبانِ",40,"ن",1,0],["كالسيف لولم يعله صدأ","لفرت مضارب حدّه الغمدا",41,"د",2,0],["كَالسِحرِ تَنفُثُ في القُلوبِ مَكائِداً","لا تُتَّقى فَكَأَنَّها مِن بابِلِ",42,"ل",1,0],["كالسيف يجلوه قِراعٌ ولا","يأخذُ ضربُ الهامِ من حدّه",43,"د",2,0],["كالسحاب الجون إلا أنه","ليس يسقي الأرض إلا عرقا",44,"ق",2,0],["كَألْسُنِنا أسْيافُنا فِي مَضَائِها","فلا خُطْبَةٌ حَتَّى نَقُومَ ولا شِعْرُ",45,"ر",1,0],["كالسَّهْم قَرَّبَه رامٍ ليُبْعِدَه","والسّيفِ يَقْرُبُه حامٍ ليَنْتضيا",46,"ي",2,0],["كالسَّيفِ يَحْمَدُه غيرُ القتيلِ به","يومَ الجِلادِ إذا ما احْمَرَّ من عَلَق",47,"ق",1,0],["كالسّيفِ في غِمْدٍ تَخرَّق يَغْتدى","لا كلّ مَسْلولٍ ولا مَغْمود",48,"د",1,0],["كالسّهْمِ راميهِ يُقَرّبُه","ولأجْلِ بُعْدٍ ذلك القُرب",49,"ب",1,0],["كالسيفِ ما ينفكُّ يهزمُ حدُّه","غِلَظَ الرّقابِ برِقةٍ في المضرِب",50,"ب",1,0],["كَالسُحبِ مُسوَدَّةَ المَرأى وَدانِيَةً","وَفي جُفوني أَرى مُستَودَع السُحُبِ",51,"ب",1,0],["كالسَّيفِ قد صقلَتْ صَفيحةَ","عزمه أيدي التجاربْ",52,"ب",1,0],["كالسيف أصْلِتَ نصلُه من غمده","فبدا نظيرَ الكوكب المتوقد",53,"د",1,0],["كالسرب يرعى رياض الحزن معشبة","يلهو ومن نبأة القناص في قضض",54,"ض",1,0],["كالسطر يكتبه الحيا","ويعيدُ ذيلُ الريح محوَهْ",55,"و",2,0],["كالسيفِ لا زَينُه التحليِّ","يوماً ولا عيبهُ الفُلولُ",56,"ل",1,0],["كالسيف يحلو سِلمُه حالياً","زيناً ويُرضِي حربَه عاطلا",57,"ل",2,0],["كالسطر بعد السطر مخطوطة","من صفحة البيضِ على مَخرَقِ",58,"ق",1,0],["كالسيف أرسله في الروع صاحبُهُ","على الكتيبة ذات الحشْدِ لم يقفِ",59,"ف",1,0],["كالسيل ليس لوجهه متحدَّر","نفص الربى عما يحاول مُصرفُ",60,"ف",1,0],["كالسيف تلبس منه مغمداً شرفاً","وشارةً ويقيك الشرّ مخترطا",61,"ط",2,0],["كالسهم أَحرزَ ذكراً يومَ تُرسله","لم يُعطِهِ أبواه القوسُ والوتَرُ",62,"ر",1,0],["كالسيل من شاهقٍ يجري لغايتهِ","طبعاً فلا هو مكدودٌ ولا يَهِنُ",63,"ن",1,0],["كالسَّيْفِ ثَبْتٌ في الغُمودِ","وقاطِعٌ يومَ الجِلادِ",64,"د",1,0],["كالسمهريّ تحار بين أواخرٍ","ونهُ مسدّدةٍ وبين أوائل",65,"ل",1,0],["كالسيف تعرف حده من هجره","خشناً وتعرف صفحه من لينه",66,"ن",2,0],["كالسيل أو كالليل ليس بعازبٍ","عن ركبها السيَّار غايةُ موضع",67,"ع",1,0],["كَالسُحُلِ البيضِ جَلا لَونَها","سَحُّ نِجاءِ الحَمَلِ الأَسوَلِ",68,"ل",1,0],["كالُّسفْنِ في بحرِالسرابِ ترتمي","أضحى لها أطمارُهم قُلوعا",69,"ع",2,0],["كالسهمِ في الخرقِ القصيِّ","يكادُ أن يشأى سَمامَه",70,"م",2,0],["كالساكني ربع التنية واللوى","والحلة الفيحاء بين الفرهد",71,"د",1,0],["كالسيل والليل لا ينجو طريدهما","من المنية في الإمعان بالهرب",72,"ب",1,0],["كالسِّحر بل دونه سِحرُ الساحِر","يَرسُبُ في قرارةِ الأحشاءِ",73,"ا",2,0],["كَالسّيفِ لَيسَ بِنابٍ","وَالسّيف بِالضربِ يَنبو",74,"ب",2,0],["كَالسَيفُ في أَوضائِهِ وَمَضائِهِ","وَاللَيثُ في وَثباتِهِ وَثَباتِهِ",75,"ت",2,0],["كالسِّلكِ بَتَّ قُواهُ الكَفُ فانحَدَرَت","مِنهُ بَوادِرُ مِن دُرِّ وَمِرجانِ",76,"ن",1,0],["كالسم في الأفعى تَقِي وتحتفُ","تحيا به وبالنفوس تتلف",77,"ف",1,0],["كالسَهمِ مُقلَتُهُ وَالقَوسِ حاجِبُهُ","وَمُهجَتي لَهما قَد أَصبَحَت هَدَفا",78,"ف",2,0],["كالسَّهْمِ بل أمضى من السَّ","همِ إذا الرامي مَعَطْ",79,"ط",1,0],["كَالسّقفِ مِن لازَورد فيهِ مُلتَصِقٌ","مِرآة دُرٍّ وَتُفّاح مِنَ الدّررِ",80,"ر",1,0],["كالسّيد ما استقبلتهُ وإذا","ولّى تقولُ مُلمْلمٌ ضرْبُ",81,"ب",1,0],["كَالسَّهْمِ يُرْشَقُ في احشَاءِ حَاسِدِهِ","لَكِنَّهُ لِمُرَجِّي الجُودِ كَالهَدَفِ",82,"ف",1,0],["كَالسيلِ يعمرُ في البلادِ أماكناً","وَيفيض في الفلواتِ يسقى يشربُ",83,"ب",1,0],["كالسيلِ يعمرُ في البلادِ أماكناً","طوراً وفي بعضِ الأماكنِ يخربُ",83,"ب",1,0],["كالسيف صادق عزمه لكنه","في الحرب ليس يكل مثل كلاله",84,"ل",2,0],["كَالسَيفِ في غَمَراتِهِ وَالبَدرُ في","ظُلُماتِهِ وَالغَيثُ في أَزَماتِهِ",85,"ت",2,0],["كَالسَيفِ إِن لاقَيتَهُ أَلفَيتَهُ","لِلُّطفِ يُدمِجُ شِدَّةً في اللّينِ",86,"ن",1,0],["كَالسَمعِ لَم يَنقُبِ البيطارُ سُرَّتَهُ","وَلَم يَدِجهُ وَلَم يَغمِز لَهُ عَصَبا",87,"ب",2,0],["كالسيل يوجد سكَّراً في بقعةٍ","طابت ويوجد في الخبيثة علقما",88,"م",2,0],["كالسيف تحمله أخفّ مؤونة","ولدى المخاوف تنتضيه صقيلا",89,"ل",2,0],["كَالسَحابِ الكَنَهوَرِ الجَودِ قادَت","هُ النُعامى فَطَبَّقَ بِالأَرضِ قَطرا",90,"ر",2,0],["كالسيل أنصبت جارفةً","وطمت لا يوقفها سدُّ",91,"د",1,0],["كالسيل اقدم كلما","كفكفت زاد به غرامه",92,"م",2,0],["كالسيّد الباشا الرضى وهو الذي","طِيبُ اسْمِهِ يُهدي شذا معناه",93,"ا",2,0],["كالسدر أصل النبق مخضود مكا","ن الشوك من ثمر ذوي ألوان",94,"ن",1,0],["كَالسَيفِ مُنصَلِتاً وَاللَيثِ مُفتَرِسا","وَالسَيلِ مُنحَدِراً وَالبَحرِ مُضطَرِبا",95,"ب",2,0],["كَالسَّيفِ يُسعِرُ حَدُّهُ نارَ الوَغى","وَالماء في صَفَحاتِهِ رَقراقُ",96,"ق",1,0],["كالسلسل العذب تجري في سلاستها","ما كلفتها يد التكليف تعقيدا",97,"د",2,0],["كَالسَيف مَشحوذ الشَبا","وَالرُمحِ هَذَّبه ثِقافه",98,"ف",2,0],["كالسيف قد جاء مص