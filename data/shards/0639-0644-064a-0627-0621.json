{"poems":[[77,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[189,"هذا الإمام إمامي حاضر بادي","https://www.aldiwan.net/poem14504.html","البسيط"],[342,"سل الهموم التي باتت مؤرقة","https://www.aldiwan.net/poem45296.html","البسيط"],[369,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56046","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53225","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[5298,"سلِّ الهمومَ التي باتتْ مؤرِّقة ً","https://www.poetsgate.com/ViewPoem.aspx?id=182937",""],[5415,"الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=212225",""]],"verses":[["عَلياءُ مُوفِيَةٌ على عَليائِهِ","في حيْثُ أسلَمَ مُقلَةً إنسانُها",0,"ن",3,0],["عَلْياءُ أُسَّسها آباؤه وبَنى","فيها بغُرِّ الأَيادي فوق أَطْواد",1,"د",1,0],["عَلياءَ نَضّاخَةِ الذِفرى مُذَكَّرَةٍ","عَيرَانَةً مِثلَ قَوسِ الفِلقَةِ الضالِ",2,"ل",1,0],["عَلياءَ في ظِلِّها","تُدْرِكُ أَقصَى المُراد",3,"د",1,0],["علياء شاهقة البنا غرّاء وا","سعة الرحاب لضيفها ونزيلها",4,"ل",3,0],["علياء ما بهرت إلا وقد ظهرت","آياته فملأن الأرض برهانا",5,"ن",2,0],["علياء فاتت سموّا كل منزلة","فلم يكن في سواها ما يساويها",6,"ي",3,0],["علياءُ تُزهَى على الخلدِ الذى ضرعت","له مآثر قومٍ كلَّها غرر",7,"ر",1,0],["علياءَ نضّاحة ِ الذِّفرى مُذَكَّرة","ٍ عَيْرانة ٍ مثلِ قوْس الفِلْقة ِ الضّالِ",8,"ل",1,0],["عَلْيَاءُ شَامِخَةٌ بِهَا الْخَيْرَاتُ لَوْ","شَاهَدْتَهَا هِيَ آيَةَ الرَّحْمَانِ",9,"ن",1,0]]}