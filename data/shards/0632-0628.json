جرى من أثير","وَفَقاقيع منه في دأماء",10,"ا",2,0],["زَبَدٌ طارَ عن رُغاءِ المَنايا","فاحتَسَى البِيضُ كارْتِغاءِ الحَليب",11,"ب",1,0],["زبليناً ساء فأل الأعزل","ومتى ينهض عزيز فارده",12,"ه",1,0],["زُبى الأُسدِ أَو أَشراكها لَحَظاتُها","وَسَيفُ الرَدى فيها فَكَيفَ التَحَرُّزُ",13,"ز",1,0],["زبدٍ يداهُ بالقداح إذا شتا","هتَّاك غايات التجار ملوَّم",14,"م",1,0]]}