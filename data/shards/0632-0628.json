{"poems":[[55,"ألا أيها القمر الأزهر","https://www.aldiwan.net/poem26306.html","المتقارب"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[23,"زبانية حول أبياتهم","https://www.aldiwan.net/poem21629.html","المتقارب"],[61,"وعقفاء مثل هلال السما","https://www.aldiwan.net/poem51597.html","المتقارب"],[80,"وخفاقة الرايات في جوف نقعها","https://www.aldiwan.net/poem31414.html","الطويل"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[21,"علم ابن جدعان بن عمرو","https://www.aldiwan.net/poem36215.html","مجزوء الكامل"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[46,"عيشتي سلتي ورمسي غمدي","https://www.aldiwan.net/poem23542.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[3,"هلْ غادرَ الشُّعراءُ منْ متردَّم ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10745&r=&rc=99",""],[161,"زبيد إذا ما شئت سكنى ببلدة","https://www.aldiwan.net/poem58889.html","الطويل"],[233,"ألا قل لركن الدين ذي الفضل والحجا","https://www.aldiwan.net/poem14894.html","الطويل"],[233,"زبالة لا لشر أنت ممن","https://www.aldiwan.net/poem14895.html","الوافر"],[253,"وفستقة شبهتها إذ رأيتها","https://www.aldiwan.net/poem1481.html",""],[299,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[459,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[471,"زبيرية بالعرج منها منازل","https://www.aldiwan.net/poem4818.html","الطويل"],[514,"زبالة لا هم أسقها ثم روها","https://www.aldiwan.net/poem67773.html","الطويل"],[530,"حواري رسول الله هم خلفاؤه","https://www.aldiwan.net/poem37497.html","الطويل"],[539,"خليفة عيسى في الشفاء من الضر","https://www.aldiwan.net/poem48178.html","عموديه"],[559,"للزاي في شأن الخلافة زينة","https://www.aldiwan.net/poem33519.html","الكامل"],[559,"زينة الله منه حرز حريز","https://www.aldiwan.net/poem33549.html","الطويل"],[559,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"]],"verses":[["زُبالَةُ مِن دونِهِ وَالشُقو","قُ وَالثَعلَبِيَّةُ وَالأَجفُرُ",0,"ر",1,0],["زُبْدَةُ الْعرْفَانِ مَعْنَى","كُلّ نُسْكٍ وَارِتيَاضِ",1,"ض",1,0],["زَبِداً بِبابِلَ فَهوَ يَسقي أَهلَها","رَغَداً تُفَجِّرُهُ النَبيطُ خِلالَها",2,"ل",3,0],["زَبانِيَةٌ حَولَ أَبياتِهِم","وَخورٌ لَدى الحَربِ في المَعمَعَه",3,"ه",1,1],["زَبَرَجَدَةٌ حَسُنَتْ مَنْظَراً","وكافورَةٌ بَرَدَتْ مَلمَسا",4,"س",2,0],["زَبونٌ رَبَا سَمّ بأطرافِ سُمْرِها","كأنّ ثعابِيناً بها تَتَنفّسُ",5,"س",1,0],["زبانيَةٌ خُلِقُوا للحروبِ","يَشُبّونَ نيرانَها بالوقودِ",6,"د",1,0],["زَبَدٌ وَقَرقَرةٌ كَقَرقَرَةِ","الفُحولِ إِذا تُخاطَر",7,"ر",1,0],["زَبَدُ اللُغامِ يَطيرُ مِن فَمِها","نَفضَ النَوادِفِ ناعِمَ القُطنِ",8,"ن",1,0],["زَبَّنَتها عَن دَرِّها أُمُّ دَفرٍ","فَصِفوها بِالحَيزَبونِ الزَبونِ",9,"ن",1,0],["زبد في نهر جرى من أثير","وَفَقاقيع منه في دأماء",10,"ا",2,0],["زَبَدٌ طارَ عن رُغاءِ المَنايا","فاحتَسَى البِيضُ كارْتِغاءِ الحَليب",11,"ب",1,0],["زبليناً ساء فأل الأعزل","ومتى ينهض عزيز فارده",12,"ه",1,0],["زُبى الأُسدِ أَو أَشراكها لَحَظاتُها","وَسَيفُ الرَدى فيها فَكَيفَ التَحَرُّزُ",13,"ز",1,0],["زبدٍ يداهُ بالقداح إذا شتا","هتَّاك غايات التجار ملوَّم",14,"م",1,0],["زبيد إذا ما شئت سكنى ببلدة","فما ثم في الأرضين غير زبيد",15,"د",1,1],["زبيد هي الماوى الذي سر أهله","سروراً به فاقت بقاع زبيد",15,"د",1,0],["زبيد هي السلوان للنفس والهوى","فما الهم مخلوقاً بأرض زبيد",15,"د",1,0],["زبيد ويكفيك اسمها عن صفاتها","فما جنة في الأرض غير زبيد",15,"د",1,0],["زبيد هي الجنات والغيد حورها","فلا عيش الاشئته بزبيد",15,"د",1,0],["زبيد بلاد من هوى كل مهجة","أقيمت فكل هائم بزبيد",15,"د",1,0],["زبيد لروح المرء روح وراحة","فما بات مرتاح بارض زبيد",15,"د",1,0],["زبيد بإسماعيل تزهو وتزدهي","على كل مصر فافخروا بزبيد",15,"د",1,0],["زبيد متى تقبل بهمك نحوها","دخلت وحد الهم باب زبيد",15,"د",1,0],["زبيد تنسي من أتاها بأهله","ولا أرض تنسى المرء أرض زبيد",15,"د",1,0],["زبيد هي الدنيا فخذها غنيمة","لنفسك دارا فالهوى بزبيد",15,"د",1,0],["زُبالَة لا بَأسٌ لَدَيهِ وَلا نَدى","بِنَيلٍ وَلا رَأياً لَدَيهِ وَلا أَصلا",16,"ل",2,0],["زُبالَةُ لا لِشَرٍّ أَنتَ مِمَّن","يُرجيهِ الصَديقُ وَلا لخَيرِ",17,"ر",1,1],["زبرجدة خَضراء وَسط حَريرة","بحقّة عاجٍ في غلاف أَديم",18,"م",1,0],["زبدُ الموجِ عَلَى زرقتهِ","أَنجمٌ في حالكاتِ اللونِ جون",19,"ن",1,0],["زُبُرٌ تَوغَّلُ حيث لا ابن الزُّبرةِ ال","دامي ولا ابنُ الغابة الرّعافُ",20,"ف",1,0],["زُبَيرِيَّةٌ بِالعَرجِ مِنها مَنازِلٌ","وَبِالخَيفِ مِن أَدنى مَنازِلِها رَسمُ",21,"م",1,1],["زبالة لا هم أسقها ثم روها","وقلت لها أضعاف ذي الدعوات",22,"ت",1,1],["زُبَيْرُهُمُ جَرَّاحُهُمْ وَابْنُ عَوْفِهِمْ","وجَعْفَرٌ الطَّيارُ يَتْلُوهُ حَمْزَةُ",23,"ه",1,0],["زبائنُه فيهم يَراكَ مزاجماً","تُخَلِّصهم من بين نابِه والظُّفرِ",24,"ر",1,0],["زبر الكتاب حروفه ومرادهم","معنى الحروف بسر تركيباتها",25,"ت",3,0],["زبرتها لهم صفات التجلي","وبها الكل ظاهر معزوز",26,"ز",1,0],["زبلُهُم في الماء صيَّرهم","شربُهُ من غير أفهام",27,"م",1,0]]}