{"poems":[[47,"أقم علها أن ترجع القول أو علي","https://www.aldiwan.net/poem65594.html","الطويل"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[47,"عَزَمْتُ عَلى المَنَازِلِ أنْ تَبينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31886",""],[240,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[240,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[280,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[463,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80012","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[4926,"إلى متى أنت باللَّذات مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=171096",""]],"verses":[["وَأَعهَدَ كَفّاً غَيرَ مَعقودَةِ النَدى","وَعِقدَ وِدادٍ ثَمَّ لَيسَ بِمُنحَلِّ",0,"ل",1,0],["وَأَعهَدُ أَرضَهُم أَعدى سِباعاً","وَآشَبَ دونَ عادِيَةٍ عَرينا",1,"ن",2,0],["وأعْهَدُ أرْضهِمْ أعْدَى سِبَاعاً،","وَآشَبُ عِنْدَ عادِيَةٍ عَرِينَا",2,"ن",2,0],["وَأَعهَدُ قَبلَ البَينِ قَلبي يُطيعُني","وَلَكِنَّهُ يَومَ الوَداعِ عَصاني",3,"ن",2,0],["وَأَعهَدُها سِلمي وَيا رُبَّ زَعزَعٍ","جَرَت مِن مَهَبّي سَحسَحٍ وَرُخاءِ",4,"ا",2,0],["واعْهدْ إلى أبنائِك الصِّيد الألَى","طالوا سَناء حينَ طابوا مَوْلِدا",5,"د",2,0],["وأعهدها والدمع يجري بلونه","فتصبغه من خدّها بنجيعِ",6,"ع",1,0],["وأعهدُ خصراً يشتكي ثقلَ ردفه","فوارحمتا تحتَ الرشا لك يا خصرُ",7,"ر",1,0],["واعهَدِ الغَرسَ بالرَوا قبلَ وقتٍ","ليسَ يُجدي بهِ الحَيا الهَطَّالُ",8,"ل",1,0],["واعهد لحبل الدُّنا بالزُّهد تصرمه","(فإنّما حبلها بالزُّور موصول)",9,"ل",1,0]]}