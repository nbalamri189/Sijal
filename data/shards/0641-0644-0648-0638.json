{"poems":[[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17113","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110773","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97893","الوافر"],[4119,"رأيت نهر قويق","https://www.poetsgate.com/ViewPoem.aspx?id=16101",""]],"verses":[["فلو ظفرتُ منهُمُ بتابع","رائدَ نصحي أو عذلتُ سامعا",0,"ع",2,0],["فَلَو ظَنَّني أَسلوهُ لَم يَكُ هاجِراً","وَلَو خالَني أَنساهُ لَم يَكُ نائِيا",1,"ي",2,0],["فلو ظهر الوشاة عليه يوما","لها جوا مثل يأجوج وماجوا",2,"ج",3,0],["فلو ظفرا الكمى بها وكانت","بسبي الحرب سلمها حسامه",3,"م",2,0],["فلو ظمئت وأسقيت","ماءه ما رويت",4,"ت",1,0]]}