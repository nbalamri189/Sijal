em.aspx?id=208738",""],[5720,"غِناءُ الطَّير (*)","https://www.poetsgate.com/ViewPoem.aspx?id=200231",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5848,"تفاصيل الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=52029",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5861,"نسيج آلامي","https://www.poetsgate.com/ViewPoem.aspx?id=188577",""],[5874,"الدَّرْوِيشَة","https://www.poetsgate.com/ViewPoem.aspx?id=212177",""],[5897,"رمضان يستعيد الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=156849",""],[5956,"مناجاتي لابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=192383",""],[5956,"أ تذْكر؟","https://www.poetsgate.com/ViewPoem.aspx?id=192440",""],[5956,"تنقلكم شوّش استقراري","https://www.poetsgate.com/ViewPoem.aspx?id=193157",""],[5956,"الضحيَّةُ والمنقذ","https://www.poetsgate.com/ViewPoem.aspx?id=194198",""],[5957,"أتاني هواك","https://www.poetsgate.com/ViewPoem.aspx?id=12042",""],[5957,"ولما التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=16086",""],[5974,"أُسْتَاذي","https://www.poetsgate.com/ViewPoem.aspx?id=200426",""],[5977,"تساؤلات","https://www.poetsgate.com/ViewPoem.aspx?id=212742",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6131,"قلبي الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=189337",""],[6132,"اتذكر ليلى عهدنا المتقدما","https://www.poetsgate.com/ViewPoem.aspx?id=194879",""],[6187,"أتذكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82158&r=&rc=2",""],[5355,"نُزُوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87127&r=&rc=22",""],[6228,"حين تنطق العين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85966&r=&rc=3",""],[6229,"قلادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65192&r=&rc=17",""],[6247,"من أوراق امرأة مطلقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80295&r=&rc=34",""]],"verses":[["أَتَذهَلُ بَعدَ إِنذارِ المَنايا","وَقَبلَ النَزعِ أَنبَضَتِ الحَنايا",0,"ا",3,1],["أَتُذكِراني طَلَبَ الطَوائِلِ","أَيقَظتُما مِنِّيَ غَيرَ غافِلِ",1,"ل",1,1],["أَتَذكُرُ أَيّاماً مَضَينَ بِذي الغَضَى","سَقاهُنَّ رَجَّافُ العَشيِّ هَطولُ",2,"ل",1,0],["أَتَذكُرُ عَبلَةً وَتَبيتُ حَيّ","وَدونَ خِبائِها أَسَدٌ مَهولُ",3,"ل",1,0],["أَتَذهَبُ نَفسي لَم أَنَل مِنكِ نائِلاً","وَلَم أَتَعَلَّل مِنكِ يَوماً بِمَوعِدِ",4,"د",1,1],["أَتَذكُرُهُم وَحاجَتُكَ اِدِّكارُ","وَقَلبُكَ في الظَعائِنِ مُستَعارُ",5,"ر",1,1],["أتذكُرُ أيَّاماً بها وليالياً","محاسنُها كالروضِ في صُبْحَةِ الدَّجن",6,"ن",1,0],["أتذكرُ إذ أبوك ببرطَباثا","يصيدُ بنهرِها سمكاً طريّا",7,"ي",2,0],["أَتَذَلُّ آنافَ المُلوكِ جُدودُكُ","وَتَسومُكُم خَسفاً رُعاةُ الماشِيَه",8,"ي",2,0],["أَتَذكُرُ إِذ هُوَ يَطوي الشُهورَ","وَإِذ هُوَ كَالخِشفِ حُلوٌ أَغَن",9,"ن",1,0],["أَتَذكُرُ إِذ أَنتَ تَحتَ اللِواءِ","نَبيهَ المَكانَةِ لِجَمَّ العَديد",10,"د",1,0],["أَتَذكُرُ إِذ غَضِبَت كَاللُباةِ","وَلَمَّت مِنَ الغيلِ أَشبالَها",11,"ل",3,0],["أَتَذكُرينَ حَنيني في الزَمانِ لَها","وَسَكبِيَ الدَمعَ مِن تَذكارِها قاني",12,"ن",2,0],["أَتَذَكُرُ إِذ نُعطي الصَبابَةَ حَقَّها","وَنَشرَبُ مِن صِرفِ الهَوى بِدِنانِ",13,"ن",1,0],["أَتَذكُرُ قَبلَ هَذا الجيلِ جيلاً","سَهِرنا عَن مُعَلِّمِهِم وَناما",14,"م",2,0],["أَتَذكُرُ شَأنَ الأَزدِ ما أَنتَ مِنهُمُ","وَما لَقِيَت مِنّا عُمانُ وَذَلَّتِ",15,"ت",1,0],["أَتذكرُ إذ لِقَومكَ ما أرادوا","وإذ لكرومَرَ البطشُ الشّديدُ",16,"د",1,0],["أتذكرُ دُنشوايَ وكيف كادت","جوانبُها بأهليها تَميدُ",16,"د",1,0],["أتذكرُ إذ نُعاتِبُه فيطغى","ويَهدِرُ في مقالتِه الوعيدُ",16,"د",1,0],["أَتذهبُ أُختُنا لا نحنُ نَدرِي","ولا هُوَ عِندَهُ عِلمُ اللّبيبِ",17,"ب",1,0],["أَتُذهَبُ دارٌ بِالنُضارِ وَرَبُّها","يُخَلِّفُها عَمّا قَليلٍ وَيَذهَبُ",18,"ب",1,1],["أَتَذكُرُ يا طِرفُ الوَغى وَرُكومَها","وَقَد صِرتَ مِن نَبلٍ كَأَنَّكَ شَيهَمُ",19,"م",1,0],["أتذهب من آل الوحيد ولم تطف","بكل مكان أربع كالخرائد",20,"د",1,0],["أتذرفين إذا مت","تُ دَمعةً فوق قَبري",21,"ي",1,0],["أَتَذكُرُ إِذ أَنتَ تَحتَ اللِواءِ","نَبيهَ المَكانَةِ جَمَّ العَديد",22,"د",1,0],["أَتَذكُرُ عَبلَةً وَتَبيتُ حَيّاً","وَدونَ خِبائِها أَسَدٌ مَهولُ",23,"ل",1,0],["أَتَذُمُّ أَولادَ النَبِ","يِّ وَأَنتَ مِن وَلَدِ النُغولِ",24,"ل",1,0],["أتذكرُ إذ نمشي إلى الدرسِ بُكْرَةً","بِنُوتِنْجِهامٍ تستحِثُّ فأُسرع",25,"ع",1,0],["أتذكُرُ يوماً بالقناةِ وقد سعتْ","شُعوبٌ وسالتْ بالملوكِ شِعاب",26,"ب",1,0],["أتذكرُ إذ تَمازَحْنَا لتنسَى","وقد أدركتَ أنَّ المزحَ خَتْل",27,"ل",1,0],["أتذهب ادراج الرياح دماؤه","ولا كدم العصفور ما فيه قائم",28,"م",1,0],["أتذيع سرّ حضارةٍ ان غُيبَّت","منها السرائر فالرسوم بوادي",29,"د",2,0],["أَتَذُمُّ أَولادَ النَّبيِّ","وأَنْتَ مِن وَلدِ النُّقُولِ",30,"ل",1,0],["أتذلّ آناف الملوك جدودكم","وتسومكم خسفا رعاة الماشية ؟",31,"ي",2,0],["أتذكر والخمار بورك سعيه","يجيء بخيرات العقول ويذهب",32,"ب",1,1],["أتذكرُ إذ كُنا على القبرِ ستةً","نعدّد آثار الإمام ونندبُ",33,"ب",1,1],["أتذكر إذ شمرت ذيلك ناهضا","لخذلان سعد الدين يوم التناصر",34,"ر",1,0],["أَتَذكُرُ هالِكاً مِن عَهدِ نُوحٍ","مَضى وَالدَهرُ حِينَئِذٍ غُلامُ",35,"م",1,0],["أتذكر قولي إنني منك خائفٌ","ألست تخاف الله إن كنتَ منصِفا",36,"ف",2,0],["أتذكر في يوم الثلاثاء ساعة","قطعنا بها البيداء في ساعة الظهر",37,"ر",1,0],["أتذكر كيف كان الموج يجرى","كما يجرى الشقيق إلى الشقيق",38,"ق",1,0],["أَتَذكُرُ إذ أنتَ منّي النِياطُ","من القلب أو أنت لي أَقربُ",39,"ب",1,0],["أَتَذكُرُ لَيلَةَ نادَمتِني","وَمالَ بِعَطفَيكَ تيهٌ وَسُكرُ",40,"ر",1,0],["أَتَذْكُر دارَ عِزِّها عزَّةَ البَها","فشعش نَفْساً ودُّهَا صادِق الوَعدِ",41,"د",1,0],["أَتَذْهَبُ لَمْ يُشْرَعْ َأَمَامَكَ ذَابِل","لِمَنْعٍ وَلَمْ يُشْهَرْ وَرَاءَكَ مُنْصُلُ",42,"ل",1,0],["أَتذكر عن هَوى تَلَعاتِ نَجدٍ","وأَينَ الهِندُ من تَلَعاتِ نَجدِ",43,"د",1,0],["أتذكرُ إذْ تجنّى الذئبُ يوماً","عَلى حَمَلٍ بتكديرِ الزلال؟",44,"ل",1,0],["أَتَذكرُ إِذ مَسحتَ بفيكَ عيني","وَقَد حلّ البكاءُ بها عقوده",45,"ه",1,1],["اتذكر هند اذ مرت","بذاك الزيّ والشكل",46,"ل",1,0],["اتذكر ذاك يا عار","ف هل تذكر ما أملي",46,"ل",2,0],["أَتذكُر لي حَديثاً عَن اليفي","وَتنكر أَن تَرى دَمعي صَبيبا",47,"ب",2,0],["أَتذَكُرُني يا طَير مَن أَنا ذاكر","وَلَم أَنسَهُ يَوماً فَتَحَدث لي ذِكرا",48,"ر",2,0],["أَتَذكُرُ إِذ كُنّا لَدى الدَهر رتعاً","وَمصر وَأَرض الشامِ إِذ عَيشُنا نضرُ",49,"ر",1,0],["أتَذْكُرُ دون الجزع بالخَيْف أربُعا","ولعْت بها والصّبّ لا زال مولعا",50,"ع",2,1],["أتذكرُ يوم أقبلنا عليها","على إبلٍ تقدُّ السَّيرَ قدَّا",51,"د",2,0],["أتذكر أطلالاً تعفَّتْ وأرسُما","بذاتِ الفضا في الجزعِ مِنْ أَيمن الحمى",52,"م",2,1],["اتذكر عهدك لي بالعقيق","سقى اللهُ عهد العقيقِ العهادا",53,"د",2,0],["أتذعنون لهم شكرا وترضية","من بعد ما دمروا الأخلاق والدورا",54,"ر",2,0],["أتذكر اليوم ما لاقيت من كمدٍ","أم قد كفاك رسولي بالذي ذكرا",55,"ر",2,1],["أتذكر والقضية في اقتراع","مواقفهم فهل بدوا انسجاما",56,"م",2,0],["أَتَذكُرُ داراً بَينَ دَمخٍ وَمَنوَرا","وَقَد آنَ لِلمَخزونِ أَن يَتَذَكَّرا",57,"ر",2,1],["أتَذكُرُ يا عبدَ العزيزِ ولم تَكُن","بِناسٍ وليلُ الجَهلِ قد سَدلَ السِّترا",58,"ر",2,0],["أتَذكُرُ يا ابنَ داوُودٍ وُقُوتا","بقَلبِي لا يزالُ لها دَبيبُ",59,"ب",1,0],["أَتَذكُرُ عَهدَ ذي العَهدِ المُحيلِ","وَعَصرَكَ بالأَعارِفِ وَالشلولِ",60,"ل",1,1],["أتذكرُ إِذْ هبطنا ذاتَ عِرْقٍ","ونحن معاً على أقتادِ عَنْسِ",61,"س",1,0],["أتذكر الغصن لما","شدا القريض تثنى",62,"ن",2,0],["أَتذكر الآن شعر البحتري وَقَد","أُنسِي بِكَ اليَوم فيما بَيننا وَنَبا",63,"ب",2,0],["أَتَذكُرُنا وَمُرَّةَ إِذ غَزَونا","وَأَنتَ عَلى بُغَيلِكَ ذي الوُشومِ",64,"م",1,0],["أتذوق طعم النوم بعدك أعين","فقئت إذاً إن عادها التهويم",65,"م",1,0],["أتذري عينُهُ فضَضَ الجمان","غراماً من تذَكّره المغاني",66,"ن",2,1],["أتذهَبُ كَلبُ لم تَنَلها رِماحُنا","وتُتركُ قَتلَى راهطٍ وهيَ ما هِيا",67,"ي",2,0],["أتذكرين الليالي السالفاتِ لنا","وليلةً لستُ أنساها إلى الأبَدِ",68,"د",1,0],["أتذرِفُ من نرجسِ العينِ دمعاً","خليقٌ بجفنك سَفكُ الدِّماء",69,"ا",2,0],["أتذيلُ دَمعك كُلُّه إن بانوا","صُن بعضَهُ فوراك الأوطانُ",70,"ن",1,1],["أتذكر أيامنا في الصبا","وأنت اذا لحت كنت الهلالا",71,"ل",2,0],["أَتَذهَبُ أَيّامي وَلَم أَسقِ تَرفُلاً","وَأَشياعَهُ الكَأسَ الَّتي صَبَّحوا جِهَما",72,"م",2,1],["أَتذكُر كَم مِن طيبَةٍ اثر طيبَةٍ","سَحَبنا لَها في فَنتنيط العُلا مِرطا",73,"ط",2,0],["أتذكر حين جاء وحل ضيفا","عزيزاً عند أرباب الزعامه",74,"م",2,0],["أَتَذكُرُ فَخراً في قَبائِلِ يَعرُبٍ","وتُنكِرُ قاراً وَهوَ أَبلَجُ واضِحُ",75,"ح",1,1],["أَتَذكُر عَهدَ الحارِثِيَّةِ بَعدَما","نَأَيتَ فَلا تَستَطيعُ أَن تَتَعَهَّدا",76,"د",2,0],["أتذكر يا مولاي حين تقول لي","واني لأرجو أن ستنفعني الذكرى",77,"ر",2,0],["أَتَذكُرُ إِذ دارَت عَلَيكَ رِماحُنا","بِمَسكِنَ وَالكَلبِيُّ ثُمَّ غَريبُ",78,"ب",1,0],["أتذكر إِذ بتنَا يتامى نوادبا","ووجهُك موفورُ البشاشة والبشرِ",79,"ر",1,0],["أَتَذكُرُ أَمراً لَم تَنَلهُ وَإِنَّما","تَناوَلَ سَجلَ الحَربِ مَن كانَ أَنجَدا",80,"د",2,0],["أتذكر حين نرتع في سرور","ونمرح في ميادين القوافي",81,"ف",2,0],["اتذكر ليلة بالسفح مرت","لنا ما بين غزة والحوادي",82,"د",2,0],["أَتَذكُرِ بَيِّ عَيشَتَنَا زَمَاناً","نُنَعَّمُ بالوِئَامِ وبِالتَّصَافِي",83,"ف",2,0],["أتذكر عهد انس قد تقضي","بصوت مهزّج وبرشف كأس",84,"س",1,0],["أتذكرها وقد فني الشبابُ","ومرَّ بك الزمان المستطابُ",85,"ب",1,1],["أتذكر قوماً أوجعتك رماحهم","وذبوا عن الأحساب عند المآقط",86,"ط",1,0],["أتذكر الدنيا وبهجة حسنها","وأعيد ذكر الأهل والدماء",87,"ا",2,0],["أتذكر أيام كنت الغنى","وقد جئتني بائسا تجتدي",88,"د",2,0],["اتذكرت باللوى والكثيب","ملعب الريم والغزال الربيب",89,"ب",1,1],["أتذهَبُ سَلمَى في النهارِ فلا تَرَى","وباليل أيمٌ حيثُ شَاءَ يَشيبُ",90,"ب",1,0],["أتذكر إذْ نهاية ما تمنّى","ملاحظةٌ بها منهُ تَفوز؟",91,"ز",1,1],["أتذكرُ إذ لِحافُك صوف شاةٍ","وإذ نعلاك من جلد البعيرِ",92,"ر",1,0],["أَتَذكُرُ أَقواماً كَفَوكَ شُؤونَهُم","وَشَأنُكَ إِلاّ تَركُهُ مُتَفاقِمُ",93,"م",1,0],["أتذكرني الشمس في برجها","أو الروض في الساحل العاطر",94,"ر",1,1],["أتذكر إذ هصرت بفود سلمى","وكانت من عقاب الجو اصعب",95,"ب",1,0],["أتذوب أحشائي عليه ظما","ورضابه المعسول لا يدري",96,"ر",2,0],["أَتَذكُرُ إِذ أَنتَ تَحتَ الزَمانِ","وَحيدٌ بِلا دِرهَمٍ واحِدِ",97,"د",1,0],["أتذكر إِذ لنا في مصرَ ذكرُ","وأَيامٌ على التاريخِ غرُّ",98,"ر",1,1],["أتذكرُ من بغدادَ مقتبلَ العمرِ","ومجداً ثوى بين الرصافة والجسرِ",99,"ر",1,1],["أتذكرً ما اسديتَ واخترت فعلة","وجئت من المكروه والشر والنكر",100,"ر",1,0],["أَتذكُر يَومَ كنّا في أليد","وقد حشدت جوارينا صفوفا",101,"ف",2,1],["أتذكرُ أعظُماً رِمَ