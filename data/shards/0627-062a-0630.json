{"poems":[[53,"أتذهل بعد إنذار المنايا","https://www.aldiwan.net/poem29623.html","الوافر"],[53,"أتذكراني طلب الطوائل","https://www.aldiwan.net/poem29897.html","الرجز"],[63,"هل الوجد إلا لوعة أعقبت أسى","https://www.aldiwan.net/poem45797.html","الطويل"],[3,"فؤاد ليس يثنيه العذول","https://www.aldiwan.net/poem193.html",""],[55,"أتذهب نفسي لم أنل منك نائلا","https://www.aldiwan.net/poem26374.html","الطويل"],[27,"أتذكرهم وحاجتك ادكار","https://www.aldiwan.net/poem5757.html","الوافر"],[51,"ألا أيها الموسوم باسم وكنية","https://www.aldiwan.net/poem66404.html","الطويل"],[51,"أبن لي لم تعمم طابقيا","https://www.aldiwan.net/poem66760.html","الوافر"],[91,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[85,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[85,"جعلت حلاها وتمثالها","https://www.aldiwan.net/poem62953.html","المتقارب"],[85,"الله في الخلق من صب ومن عاني","https://www.aldiwan.net/poem63000.html","البسيط"],[85,"صحا القلب إلا من خمار أماني","https://www.aldiwan.net/poem63002.html","الطويل"],[85,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[28,"لقد هتك العبد الطرماح ستره","https://www.aldiwan.net/poem4964.html","الطويل"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[105,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[46,"أتذهب دار بالنضار وربها","https://www.aldiwan.net/poem22080.html","الطويل"],[46,"توهمت خيرا في الزمان وأهله","https://www.aldiwan.net/poem23288.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85697","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19209","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9963","الوافر"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10171","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[54,"قُلْ لابنِ خائِنَة ِ البُعُولِ =","https://www.poetsgate.com/ViewPoem.aspx?id=14467",""],[91,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[125,"أتذكر والخمار بورك سعيه","https://www.aldiwan.net/poem23798.html","الطويل"],[136,"أتذكر إذ كنا على القبر ستة","https://www.aldiwan.net/poem49079.html","الطويل"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[170,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[205,"طباعك فالزمها وخل التكلفا","https://www.aldiwan.net/poem53252.html","الطويل"],[212,"سلام على الشط الذي كنت نوره","https://www.aldiwan.net/poem46252.html","الطويل"],[212,"وداعا للرمال وللمغاني","https://www.aldiwan.net/poem46336.html","الوافر"],[226,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[236,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[276,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[281,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[298,"يقول الهاشمي غداة جزنا","https://www.aldiwan.net/poem33283.html","الوافر"],[299,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[306,"أتذكر إذ مسحت بفيك عيني","https://www.aldiwan.net/poem56569.html","الوافر"],[343,"أبا غازي ابا الفضل","https://www.aldiwan.net/poem55349.html","مجزوء الوافر"],[381,"على القلب المعذب أن يذوبا","https://www.aldiwan.net/poem49196.html","الوافر"],[381,"بعينيه سحار يعلمني السحرا","https://www.aldiwan.net/poem49207.html","الطويل"],[407,"لنفسك لم لا عذر قد نفذ العذر","https://www.aldiwan.net/poem50166.html","الطويل"],[417,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[417,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[417,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[438,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[454,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[514,"أتذكر اليوم ما لاقيت من كمد","https://www.aldiwan.net/poem67748.html","البسيط"],[535,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[537,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[539,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[539,"أودع في صباح غد حبيبا","https://www.aldiwan.net/poem48269.html","عموديه"],[541,"أتذكر عهد ذي العهد المحيل","https://www.aldiwan.net/poem56697.html","الطويل"],[552,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"]],"verses":[["أَتَذهَلُ بَعدَ إِنذارِ المَنايا","وَقَبلَ النَزعِ أَنبَضَتِ الحَنايا",0,"ا",3,1],["أَتُذكِراني طَلَبَ الطَوائِلِ","أَيقَظتُما مِنِّيَ غَيرَ غافِلِ",1,"ل",1,1],["أَتَذكُرُ أَيّاماً مَضَينَ بِذي الغَضَى","سَقاهُنَّ رَجَّافُ العَشيِّ هَطولُ",2,"ل",1,0],["أَتَذكُرُ عَبلَةً وَتَبيتُ حَيّ","وَدونَ خِبائِها أَسَدٌ مَهولُ",3,"ل",1,0],["أَتَذهَبُ نَفسي لَم أَنَل مِنكِ نائِلاً","وَلَم أَتَعَلَّل مِنكِ يَوماً بِمَوعِدِ",4,"د",1,1],["أَتَذكُرُهُم وَحاجَتُكَ اِدِّكارُ","وَقَلبُكَ في الظَعائِنِ مُستَعارُ",5,"ر",1,1],["أتذكُرُ أيَّاماً بها وليالياً","محاسنُها كالروضِ في صُبْحَةِ الدَّجن",6,"ن",1,0],["أتذكرُ إذ أبوك ببرطَباثا","يصيدُ بنهرِها سمكاً طريّا",7,"ي",2,0],["أَتَذَلُّ آنافَ المُلوكِ جُدودُكُ","وَتَسومُكُم خَسفاً رُعاةُ الماشِيَه",8,"ي",2,0],["أَتَذكُرُ إِذ هُوَ يَطوي الشُهورَ","وَإِذ هُوَ كَالخِشفِ حُلوٌ أَغَن",9,"ن",1,0],["أَتَذكُرُ إِذ أَنتَ تَحتَ اللِواءِ","نَبيهَ المَكانَةِ لِجَمَّ العَديد",10,"د",1,0],["أَتَذكُرُ إِذ غَضِبَت كَاللُباةِ","وَلَمَّت مِنَ الغيلِ أَشبالَها",11,"ل",3,0],["أَتَذكُرينَ حَنيني في الزَمانِ لَها","وَسَكبِيَ الدَمعَ مِن تَذكارِها قاني",12,"ن",2,0],["أَتَذَكُرُ إِذ نُعطي الصَبابَةَ حَقَّها","وَنَشرَبُ مِن صِرفِ الهَوى بِدِنانِ",13,"ن",1,0],["أَتَذكُرُ قَبلَ هَذا الجيلِ جيلاً","سَهِرنا عَن مُعَلِّمِهِم وَناما",14,"م",2,0],["أَتَذكُرُ شَأنَ الأَزدِ ما أَنتَ مِنهُمُ","وَما لَقِيَت مِنّا عُمانُ وَذَلَّتِ",15,"ت",1,0],["أَتذكرُ إذ لِقَومكَ ما أرادوا","وإذ لكرومَرَ البطشُ الشّديدُ",16,"د",1,0],["أتذكرُ دُنشوايَ وكيف كادت","جوانبُها بأهليها تَميدُ",16,"د",1,0],["أتذكرُ إذ نُعاتِبُه فيطغى","ويَهدِرُ في مقالتِه الوعيدُ",16,"د",1,0],["أَتذهبُ أُختُنا لا نحنُ نَدرِي","ولا هُوَ عِندَهُ عِلمُ اللّبيبِ",17,"ب",1,0],["أَتُذهَبُ دارٌ بِالنُضارِ وَرَبُّها","يُخَلِّفُها عَمّا قَليلٍ وَيَذهَبُ",18,"ب",1,1],["أَتَذكُرُ يا طِرفُ الوَغى وَرُكومَها","وَقَد صِرتَ مِن نَبلٍ كَأَنَّكَ شَيهَمُ",19,"م",1,0],["أتذرفين إذا مت","تُ دَمعةً فوق قَبري",20,"ي",1,0],["أَتَذكُرُ إِذ أَنتَ تَحتَ اللِواءِ","نَبيهَ المَكانَةِ جَمَّ العَديد",21,"د",1,0],["أَتَذكُرُ عَبلَةً وَتَبيتُ حَيّاً","وَدونَ خِبائِها أَسَدٌ مَهولُ",22,"ل",1,0],["أَتَذُمُّ أَولادَ النَبِ","يِّ وَأَنتَ مِن وَلَدِ النُغولِ",23,"ل",1,0],["أتذكرُ إذ نمشي إلى الدرسِ بُكْرَةً","بِنُوتِنْجِهامٍ تستحِثُّ فأُسرع",24,"ع",1,0],["أتذكُرُ يوماً بالقناةِ وقد سعتْ","شُعوبٌ وسالتْ بالملوكِ شِعاب",25,"ب",1,0],["أتذكرُ إذ تَمازَحْنَا لتنسَى","وقد أدركتَ أنَّ المزحَ خَتْل",26,"ل",1,0],["أتذيع سرّ حضارةٍ ان غُيبَّت","منها السرائر فالرسوم بوادي",27,"د",2,0],["أَتَذُمُّ أَولادَ النَّبيِّ","وأَنْتَ مِن وَلدِ النُّقُولِ",28,"ل",1,0],["أتذلّ آناف الملوك جدودكم","وتسومكم خسفا رعاة الماشية ؟",29,"ي",2,0],["أتذكر والخمار بورك سعيه","يجيء بخيرات العقول ويذهب",30,"ب",1,1],["أتذكرُ إذ كُنا على القبرِ ستةً","نعدّد آثار الإمام ونندبُ",31,"ب",1,1],["أتذكر إذ شمرت ذيلك ناهضا","لخذلان سعد الدين يوم التناصر",32,"ر",1,0],["أَتَذكُرُ هالِكاً مِن عَهدِ نُوحٍ","مَضى وَالدَهرُ حِينَئِذٍ غُلامُ",33,"م",1,0],["أتذكر قولي إنني منك خائفٌ","ألست تخاف الله إن كنتَ منصِفا",34,"ف",2,0],["أتذكر في يوم الثلاثاء ساعة","قطعنا بها البيداء في ساعة الظهر",35,"ر",1,0],["أتذكر كيف كان الموج يجرى","كما يجرى الشقيق إلى الشقيق",36,"ق",1,0],["أَتَذكُرُ إذ أنتَ منّي النِياطُ","من القلب أو أنت لي أَقربُ",37,"ب",1,0],["أَتَذكُرُ لَيلَةَ نادَمتِني","وَمالَ بِعَطفَيكَ تيهٌ وَسُكرُ",38,"ر",1,0],["أَتَذْكُر دارَ عِزِّها عزَّةَ البَها","فشعش نَفْساً ودُّهَا صادِق الوَعدِ",39,"د",1,0],["أَتَذْهَبُ لَمْ يُشْرَعْ َأَمَامَكَ ذَابِل","لِمَنْعٍ وَلَمْ يُشْهَرْ وَرَاءَكَ مُنْصُلُ",40,"ل",1,0],["أَتذكر عن هَوى تَلَعاتِ نَجدٍ","وأَينَ الهِندُ من تَلَعاتِ نَجدِ",41,"د",1,0],["أتذكرُ إذْ تجنّى الذئبُ يوماً","عَلى حَمَلٍ بتكديرِ الزلال؟",42,"ل",1,0],["أَتَذكرُ إِذ مَسحتَ بفيكَ عيني","وَقَد حلّ البكاءُ بها عقوده",43,"ه",1,1],["اتذكر هند اذ مرت","بذاك الزيّ والشكل",44,"ل",1,0],["اتذكر ذاك يا عار","ف هل تذكر ما أملي",44,"ل",2,0],["أَتذكُر لي حَديثاً عَن اليفي","وَتنكر أَن تَرى دَمعي صَبيبا",45,"ب",2,0],["أَتذَكُرُني يا طَير مَن أَنا ذاكر","وَلَم أَنسَهُ يَوماً فَتَحَدث لي ذِكرا",46,"ر",2,0],["أَتَذكُرُ إِذ كُنّا لَدى الدَهر رتعاً","وَمصر وَأَرض الشامِ إِذ عَيشُنا نضرُ",47,"ر",1,0],["أتَذْكُرُ دون الجزع بالخَيْف أربُعا","ولعْت بها والصّبّ لا زال مولعا",48,"ع",2,1],["أتذكرُ يوم أقبلنا عليها","على إبلٍ تقدُّ السَّيرَ قدَّا",49,"د",2,0],["أتذكر أطلالاً تعفَّتْ وأرسُما","بذاتِ الفضا في الجزعِ مِنْ أَيمن الحمى",50,"م",2,1],["اتذكر عهدك لي بالعقيق","سقى اللهُ عهد العقيقِ العهادا",51,"د",2,0],["أتذعنون لهم شكرا وترضية","من بعد ما دمروا الأخلاق والدورا",52,"ر",2,0],["أتذكر اليوم ما لاقيت من كمدٍ","أم قد كفاك رسولي بالذي ذكرا",53,"ر",2,1],["أتذكر والقضية في اقتراع","مواقفهم فهل بدوا انسجاما",54,"م",2,0],["أَتَذكُرُ داراً بَينَ دَمخٍ وَمَنوَرا","وَقَد آنَ لِلمَخزونِ أَن يَتَذَكَّرا",55,"ر",2,1],["أتَذكُرُ يا عبدَ العزيزِ ولم تَكُن","بِناسٍ وليلُ الجَهلِ قد سَدلَ السِّترا",56,"ر",2,0],["أتَذكُرُ يا ابنَ داوُودٍ وُقُوتا","بقَلبِي لا يزالُ لها دَبيبُ",57,"ب",1,0],["أَتَذكُرُ عَهدَ ذي العَهدِ المُحيلِ","وَعَصرَكَ بالأَعارِفِ وَالشلولِ",58,"ل",1,1],["أتذكرُ إِذْ هبطنا ذاتَ عِرْقٍ","ونحن معاً على أقتادِ عَنْسِ",59,"س",1,0]]}