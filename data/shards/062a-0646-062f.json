{"poems":[[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[65,"هو ما ترى فأقل من تعنيفي","https://www.aldiwan.net/poem46129.html","الكامل"],[88,"كم ذا يكابد عاشق ويلاقي","https://www.aldiwan.net/poem10915.html","الكامل"],[29,"بان الخليط فما له من مطلب","https://www.aldiwan.net/poem5661.html","الكامل"],[39,"تندى أكفهم وفي أبياتهم","https://www.aldiwan.net/poem7244.html","الكامل"],[74,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[74,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[53,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[45,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[47,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[47,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[46,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[89,"عم الحيا واستنت الجداول","https://www.aldiwan.net/poem8367.html","الرجز"],[92,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[76,"ورداء ليل بات فيه معانقي","https://www.aldiwan.net/poem12817.html","الكامل"],[76,"يا رب ليل بته","https://www.aldiwan.net/poem12940.html","مجزوء الكامل"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[76,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[76,"والشمس شاحبة الجبين مريضة","https://www.aldiwan.net/poem13218.html","الكامل"],[77,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140869",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43781","الطويل"],[102,"صنعاء والموت والميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=50405",""],[47,"لهَا مَنْزِلٌ بَينَ الدَّخولِ فَتُوضَحِ","https://www.poetsgate.com/ViewPoem.aspx?id=33040",""],[47,"كُفِّي المَلاَمَةَ أَو دُومِي عَلَى العَذَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31888",""],[96,"خالقه","https://www.poetsgate.com/ViewPoem.aspx?id=15633",""],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[102,"صنعاء والموت والميلاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67670&r=&rc=157",""],[113,"بان الخليط ضحى من الجرعاء","https://www.aldiwan.net/poem16224.html","الكامل"],[119,"ما قام في بيت النبي المجتبي","https://www.aldiwan.net/poem41245.html","عموديه"],[164,"يا نائب الله في الدنيا ومن فيها","https://www.aldiwan.net/poem58971.html","البسيط"],[168,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[276,"مثل لعينك خدرا في الحمى ضربا","https://www.aldiwan.net/poem52086.html","البسيط"],[276,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[280,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[303,"عجبت للبحر يطغى ثم ينقبض","https://www.aldiwan.net/poem36837.html","البسيط"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[333,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[371,"الحسن جاد على الأحباب فازدادوا","https://www.aldiwan.net/poem17180.html","البسيط"],[384,"قد علمت خود بساقيها الغفر","https://www.aldiwan.net/poem4547.html","الرجز"],[412,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[435,"ورب خرساء اضحت بعد لكنتها","https://www.aldiwan.net/poem40859.html","البسيط"],[520,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[556,"ألا رب أمر بت أحذر غبه","https://www.aldiwan.net/poem47252.html","الطويل"],[556,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[556,"ألا أرقت لضوء برق أومضا","https://www.aldiwan.net/poem47737.html","الكامل"],[556,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[556,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[578,"أحق ما كان من قلبي تباريح","https://www.aldiwan.net/poem3654.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122746","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122660","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48517","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93092","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69402","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69400","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69389","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46436","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53221","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53119","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53103","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53032","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27182","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77209","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100881","البسيط"],[2679,"","https://poetry.dctabudhabi.ae/diwan/poem/122392","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205771",""],[3108,"","https://poetry.dctabudhabi.ae/diwan/poem/146676","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112682","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108402",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109976","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216632",""],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99282","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102983","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103010","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103026","الكامل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116900","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67668","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77687","الكامل"],[4529,"","https://poetry.dctabudhabi.ae/diwan/poem/105373","الرجز"],[5002,"من خلف السّحاب...","https://www.poetsgate.com/ViewPoem.aspx?id=202380",""],[4119,"لو كان سرك للوشاة معرضا","https://www.poetsgate.com/ViewPoem.aspx?id=16177",""],[5121,"شُرُوق","https://www.poetsgate.com/ViewPoem.aspx?id=71117",""],[5285,"أميرة الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=203533",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5431,"أن يظلّوا كشعلة مستنيره...","https://www.poetsgate.com/ViewPoem.aspx?id=198462",""],[5691,"جارة القمر","https://www.poetsgate.com/ViewPoem.aspx?id=205881",""],[5781,"حبُّكَ...في الأول من نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=212813",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""],[5846,"نداءُ شاعرة..","https://www.poetsgate.com/ViewPoem.aspx?id=123432",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["تَندى مَناسِمُها دَماً وَشِفاهُها","تَندى لُغاماً وَالخِفافُ مَشافِرُ",0,"ر",1,0],["تندى إذا جَمَدَتْ أكُفُّ مَعاشِرٍ","فكأنّها خُلِقَتْ منَ المَعْروفِ",1,"ف",1,0],["تَندى وَتَيبَسُ لِلخَلائِقِ كَفُّهُ","بِالماءِ طَوعَ الأَصفَرِ البَرّاقِ",2,"ق",1,0],["تَندى أَكُفُّهُمُ بِخَيرٍ فاضِلٍ","قِدماً إِذا يَبِسَت أَكُفُّ الخُيَّبِ",3,"ب",1,0],["تندى أكفُهم وفي أبياتهم","ثقةُ المجاورِ والمضاف المُرْهَقِ",4,"ق",1,1],["تندي حياءً غداةَ الجود طلعته","كأنما منعت كفاه ما منحت",5,"ت",1,0],["تندف القطن عبرة وهو قطنٌ","هكذا يندف الغريب المقتر",6,"ر",1,0],["تنِدُّ أرواحه فتطرأُ من","أقصى قَصيِّ البلادِ أخباره",7,"ر",2,0],["تَندى سَوالِفُها إِذا اِستَحضَرتَها","وَيُظَنَّ عَقدُ عِنانِها مَحلولا",8,"ل",2,0],["تَنَدَّمَ لَمّا أَخلَفَتهُ ظُنونُهُ","وَباتَت خَزايا مُفسِدٍ غَيرُ مُصلِحِ",9,"ح",1,0],["تَندى مَناصِلُهُ حَتفاً وَراحَتُهُ","عُرفاً يَفيضُ كَفيضِ امُسبِلِ الوَبَلِ",10,"ل",1,0],["تَندى عُفاتُكَ لِلعُفاةِ وَتَغتَدي","رِفقاً إِلى زُوّارِكَ الزُوّارُ",11,"ر",1,0],["تَنْدَى بِهِ الأَسْحَارُ وَالأَصَائِلُ","كَأَنَّمَا النَّبَاتُ بَحْرٌ هَائِلُ",12,"ل",1,0],["تندسُ في النَّشوات الحُمسِ عائذَةً","هذي فُتدركها الأخرى على الأثَرِ",13,"ر",1,0],["تَندى بِفيهِ أُقحُوانَةُ أَجرَعٍ","قَد غازَلَتها الشَمسُ غِبَّ سَماءِ",14,"ا",2,0],["تَندى شَقائِقُ وَجنَتَيكِ","بِهِ وَتَنفَحُ ريحُ نَشرِك",15,"ك",1,0],["تَندى بِفيهِ أُقاحَةٌ نَفّاحَةٌ","شَرِبَت عَلى ظَمَإٍ بِماءِ الكَوثَرِ",16,"ر",1,0],["تَندى عَلى كَبِدي لَدونَةُ مَنطِقٍ","فَتَفي بِحُرِّ تَرائِبٍ وَتَراقِ",17,"ق",1,0],["تَندى لَها وَرداً أَسِرَّةُ كَفِّهِ","أَبَداً وَبَطنُ يَمينِهِ مَبلولُ",18,"ل",1,0],["تُندي بآلافِ الألوفِ إلى مَدىً","يَعيا على الحُسّابِ والحُسْبانِ",19,"ن",1,0],["تندى سوالفها إذا استحضرتها","وتظن عقد عنانها محلولا",20,"ل",2,0],["تَنْدَى وَتَسْطَعُ فِي يَدَيْكَ مَهَارَةً","كَالمَاءِ لِيناً وَالرَّجَاءِ بَريقَا",21,"ق",2,0],["تَنَدَّمَ حُسّادي وَقالَ كَبيرُهُم","أَرَدنا بِخَيرِ الناسِ زَيغاً فَلَم يَزَغ",22,"غ",1,1],["تندى لتجف لكي تندى","وترف ترف لكي تصفر",23,"ر",1,0],["تَنَدّمَ لَمّا أخْلَفَتْهُ ظُنُونُهُ،","وَبَانَتْ خَزَايا مُفسِدٍ غيرِ مُصْلِحِ",24,"ح",1,0],["تَنْدَى مَنَاصِلُهُ حَتْفاً ، ورَاحَتُهُ","عُرْفاً يَفِيضُ كَفَيْضِ المُسْبِلِ الوَبِلِ",25,"ل",1,0],["تندى البراءة فيه فهو منسكب","من لغو طفل ومن تغريد عصفور",26,"ر",1,0],["تندر الأشباه ممّا اختلفت","صور الحسن وتخفى النظراء",27,"ا",2,0],["تندى وتجف لكي تندى","وترفّ ترفّ لكي تصفر",28,"ر",1,0],["تَندي أَنامِلُهُ وَيُشرق وَجهُهُ","فَيَجود بِاللألاءِ وَالآلاءِ",29,"ا",2,0],["تندبه الروح وتلفى عاجلا","غوثا لها مساعفا منتدبا",30,"ب",2,0],["تند حياء وتحميها سكينتها","عن التلكم فيما ليس يعينها",31,"ه",2,0],["تَنَدَّمتُ وَالتَفريطُ يُجني نَدامَةً","وَمَن ذا عَلى التَفريطِ لا يَتَنَدَّمُ",32,"م",1,0],["تندى الغمام اذا اِستَمطرتها مطرا","وابن العواتك تندى كفه ذهبا",33,"ب",2,0],["تندى عليك عَبير اطيبا وَعَلى","مهاجرين وآل ثم أنصار",34,"ر",1,0],["تَنْدَى أَصَائِلُها صُفْراً غَلائِلُها","كأَنَّ ماءَ نُضارٍ فَوْقها يَكِفُ",35,"ف",1,0],["تنداح أو تتلوى وهي جاريةٌ","وتسقيم عَلَى سَمْتٍ وتعترض",36,"ض",1,0],["تَندى إِذا بَخِلَ الأَكُفُّ وَلا تُرى","تَعلو بَراجِمَ كَفِّهِ إِبهامُها",37,"م",3,0],["تندب المجد بعد أن ضعضع","الحق هواها فما تزال سجينه",38,"ن",2,0],["تَندى بِجودِكَ عامَ المَحلِ أَربَعَةٌ","أُفقٌ وَأَرضٌ وَأَنفاسٌ وَأَكبادُ",39,"د",1,0],["تندح الصيف على ذات السرر","تزعى المباهيل الى الثور الأغر",40,"ر",1,0],["تندى أسرة وَجهِهِ وَيَمينَهُ","في حالَةِ الإِعسارِ والإِيسارِ",41,"ر",1,0],["تنددين بأني غير ناطقة","ألم تري منطقي يروي ظما الصادي",42,"د",2,0],["تندى أسرة وجهه فكأنه","ريان من ماء النضارة قد سقي",43,"ق",2,0],["تندّمتُ في أعجازه حين لم يكنْ","وقد فاتَ مِن كفّيَّ إلّا التّندُّمُ",44,"م",1,0],["تندى على حرّ الهجير ظِلالُهُ","وَيضيء في وقت العشيّ ظَلامُهُ",45,"م",2,0],["تندى على غُلَلِ العُفاةِ أكفُّهمْ","فَيعود منهمْ مثرياً مَن أنفضا",46,"ض",2,0],["تَندى مِفارِقُهمْ مِسْكاً فإنْ جُهلوا","نمّت عليهمْ برَيّا نشرها الأُزُرُ",47,"ر",1,0],["تَندّمتُ لمّا لَم تَكُن لي نَدامةٌ","فَألّا وفى كفّي لو شئتُ ردّها",48,"د",3,0],["تَندى الوُجوهُ نَجيعاً وَهيَ مُشرِقَةٌ","كَأَنَّها في دُجى الهَيجا مَصابيحُ",49,"ح",1,0],["تَنَدَّمتُ فيما كانَ مِن عَجرَفيَّةٍ","وَما كُلُّ مأخُوذِ القَرينَةِ تَوأَمُ",50,"م",1,0],["تَندَى عَلَيّ كأنَّ نُضحَ ثيابِها","رَدعٌ تُغَل بِهِ الحَشِيَّة رادِع",51,"ع",1,0],["تندى مطالعهم كنو","رِ الروض باكره الغمام",52,"م",1,0],["تندب الندب اباها المرتضى","يا أبياً علمَّ الناس الآيا",53,"ي",2,0],["تَندى أَنامِلُهُ وَيُشرِقُ وَجهُهُ","حَيثُ الوُجُوهُ نَواقِصُ الأَلوانِ",54,"ن",1,0],["تَندى يَداهُ فَلَو يَمَسُّ بِنانُهُ","جُلمُودَ صَخرٍ أَنبَتَ الجُلُمودا",55,"د",2,0],["تَندى فَلَو لَمَسَت حِجارَةَ حَرَّةٍ","لانَت بِلِينِ بَنانِهِ الأَحجارُ",56,"ر",1,0],["تَندى أَسرةُ وَجهِهِ وَيَمينه","في ح