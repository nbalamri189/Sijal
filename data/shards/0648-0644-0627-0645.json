,2,0],["ولا ما لقي في الله منك رجاله","من الهول في إنكاره والمحاقر",140,"ر",1,0],["ولا مدحِيَ المُجْتبى شذَّ عنْهُ","ولا مَنحُهُ المُجْتنى شذَّ عَنْ",141,"ن",1,0],["وَلامَني فيكَ أَقوامٌ فَقُلتُ لَهُم","عَنّي إِلَيكُم فَما في الحَقِّ مِن باسِ",142,"س",1,0],["وَلا مَنَعت في مُلتَقاها مُلوكها","قَرابَتُها صُهبُ اللِّحى والبَطارِقُ",143,"ق",1,0],["وَلا مادِحٍ إِلّا سُراةَ بَني أَبي","جَمالُ المَعالي بَل لُيُوثُ المَعارِكِ",144,"ك",1,0],["وَلا مالَ إِلّا ذابِلٌ وَمُهَنَّدٌ","وَسَرجٌ عَلى ذي أَولَقٍ وَلِجامُ",145,"م",1,0],["وَلاَ مِثلِى يُوَافِقُهُ خَلِيلٌ","إذا كانَت مَوَدَّتُهُ فُنُونَا",146,"ن",2,0],["وَلاَ مَاشِياً وَحدِى وَلاَ فِى جَمَاعةٍ","مِنَ النَّاسِ إِلاّ قِيلَ أنتَ مُرِيبُ",147,"ب",1,0],["وَلا مُضِيعاً لَها سِرَاً عَلِمتُ بِهِ","حَتّى يُجِيبَ حِمَامَ المَوتِ دَاعِيهَا",148,"ي",3,0],["ولا مرسل إلا لساني إِليكُم","ولا في سوى دمعي يُرَدّ جواب",149,"ب",1,0],["ولا مَلْكَ في الأرض إلا وظاهرٌ","على وجهه من ذكر فضلك أسطر",150,"ر",1,0],["ولا مدحت كريما في تكرّمه","رجاء نيل ولا أزريت بالسفل",151,"ل",1,0],["ولا مال ولا ثوب سوى ما","على جسدي لبذلي والجمال",152,"ل",1,0],["ولامني معشرٌ فقلت لهم","لا تكثروا في الملام والعذل",153,"ل",1,0],["ولا مغنّ غيري إذا طربت","نفسي تغنّيت غير متئد",154,"د",1,0],["ولا معاش كما للقرد مكتسَب","إلا معاش عليه الذلّ منصوب",155,"ب",1,0],["وَلامَت لمنعِ الإِستغاثة جدّهُ","وَمِن عمّه نعمان أنكرت النكرا",156,"ر",2,0],["وَلا مثلهُ خلقٌ ولا هوَ مثلهم","كَمالاتُهم منهُ وعَن نَقصِهم يَبرا",157,"ر",2,0],["وَلَأَمدَحَنَّكَ مِدحَةً مَذكورَةً","إن لَم تَغَلني قَبلَ ذَلِكَ غولُ",158,"ل",1,0],["ولا مثلما تقسو قلوبٌ نواعم","كأنَّ قلوب العاشقين حديدُ",159,"د",1,0],["ولا مريمٌ كانت به حملت ولا","لها قيل هزّي في الندا جذع نخلة",160,"ه",1,0],["ولا مولى ارى فيهم كريما","كأن الناس قد ماتوا جميعا",161,"ع",2,0],["ولا مارد الا ومنها بصيبه","شهاب له ما زال بالرجم يتبع",162,"ع",1,0],["ولا مادح إلا لذكرك حامد","وما لك في الأفعال حاشاك عاتب",163,"ب",1,0],["ولا مقلة الا وفرحها البكا","تجارت وقد اضحت تسابقها الحمر",164,"ر",1,0],["ولا مَلِكٌ في سالِف الدهر مثله","إلى الحَش