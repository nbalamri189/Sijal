,"","https://poetry.dctabudhabi.ae/diwan/poem/20982","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[93,"عَبْدَ العَزِيزِ لَقَدْ جَزِعْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=33738",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[45,"إذا عَرَضَتْ أحْدَاجُ سلمى، فنادِها","https://www.poetsgate.com/ViewPoem.aspx?id=31564",""],[39,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[0,"سما لكَ شوقٌ بعدما كان أقصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14327&r=&rc=3",""]],"verses":[["وَلا مُسنِدوهُ بِالأَكُفِّ عَنِ الحَشى","عَلى جَزَعٍ وَالمُفرِشوهُ التَراقِيا",0,"ي",2,0],["وَلا مَن تَقَدَّمَ نالَ العُلى","رَخيصاً وَلَكِنَّ مَن قُدِّما",1,"م",2,0],["وَلا مِثلُ لَيلي بِالشَقيقَةِ وَالهَوى","يَضُمُّ إِلى نَحري غَزالاً مُنَعَّما",2,"م",2,1],["وَلا مانِعٌ مِمّا رَمى اللَهُ سَهمَهُ","دِفاعُ المُحامي وَاِدِّراعُ المُدَرَّعِ",3,"ع",1,0],["وَلا مَرحَباً بِالأَرضِ لَستُم حُلولَها","وَإِن كانَ مَرعىً لِلقَطينِ مَريعُ",4,"ع",1,0],["وَلا مَرِضَت نارُ القِرى في خِيامِهِ","بِلَيلٍ وَلَو أَنَّ الرِياحَ زَعازِعُ",5,"ع",1,0],["وَلا مَشَت بِيَ الخَيلُ إِن لَم أَطَأ","سَريرَ هَذا الأَغلَبِ الماجِدِ",6,"د",1,0],["وَلَأمَةٍ سالَ فَوقَها زَرَدٌ","كَالماءِ في قِطعَةٍ مِنَ الزَبَدِ",7,"د",1,0],["وَلا مَلَكَتْ ظَمْياءُ نَفْساً أَبِيَّةً","قَليلٌ إِلى دارِ الهَوانِ الْتِفاتُها",8,"ت",3,0],["ولإمامِ أبي العبَّاسِ عارِفَةٌ","تُروي الصَّدى والندىً المَنزورُ يُظْميني",9,"ي",1,0],["وَلا مالَ إِلّا ما أَفادَكَ نَيلُهُ","ثَناءً وَلا مالٌ لِمَن لا لَهُ مَجدُ",10,"د",1,0],["ولا مِثْلَ شَفّافِ الضِّياءِ بَنَيْتَهُ","على الطّائِرِ الميْمونِ والطّالِع السّعْدِ",11,"د",1,0],["وَلا مِن رَهطِ جَبّارِ بنِ قُرطٍ","وَلا مِن رَهطِ حارِثَةَ اِبنِ زَيدِ",12,"د",1,0],["وَلا مُستَنزِلٌ هِبَةً بِمَدحٍ","وَلا مُستَنجِزٌ حُرَّ الوُعودِ",13,"د",1,0],["وَلَأَمسَتِ البيضُ الحَرائِرُ أَسهُماً","فيها سَبايا وَالمَوالي أَعبُدا",14,"د",2,0],["وَلا مِثلَ يَومٍ في قُدارانَ ظِلتُهُ","كَأَنّي وَأَصحابي عَلى قَرنِ أَعفَرا",15,"ر",2,0],["وَلاَ مُرَجَّاةَ بَعْسلٍ","وَعَيْلَةٍ صَالِحينا",16,"ن",2,0],["وَلا مِثلَ ما أَلقى إِذا الحَيُّ فارَقوا","وَلا أَثَرَ الأَظعانُ يَلقاهُ مُسلِمُ",17,"م",1,0],["وَلا مِثلَ دَمعِ العَينِ يَومَ أَكُفُّهُ","وَتَأبى سَواقيهِ العُلى أَن تَصَرَّما",18,"م",2,0],["وَلا مِثلَ وَجدي يَومَ جَرعاءِ مالِكٍ","وَجُمهورِ حُزوى يَومَ سارَت حُمولُها",19,"ل",3,0],["وَلا مُخرِفٌ فَردٌ بِأَعلى صَريمَةٍ","تَصَدّى لِأَحوى مَدمَعِ العَينِ عاطِفِ",20,"ف",1,0],["وَلا مَيَّ إِلا أَن تَزورَ بِمُشرِفٍ","أَو الزُرقِ مِن أَطلالِها دِمَناً قَفرا",21,"ر",2,0],["ولا مثل تعريف الشفاء حقوقه","فقد بان فيه للعقول جميعُها",22,"ع",3,0],["ولا ممّن يرى الأديان قامت","بوحيٍ مُنزلٍ للأنبياء",23,"ا",2,0],["ولا ممّن قد ارتبطوا بماضٍ","فعاشوا ينظرون إلى الوراء",23,"ا",2,0],["ولا ممّن يرى للناس حكماً","سوى الحكام أرباب القضاء",23,"ا",2,0],["ولا ممّن تودّد في حضور","وعند الغيب جاهر بالعداء",23,"ا",2,0],["ولا ممّن يرى الأنساب ممّا","يمتّ به الأنام إلى العلاء",23,"ا",2,0],["ولا ممّن إذا وُبئوا استعاذوا","بتمتمة الدعاء من الوباء",23,"ا",2,0],["ولا من معشر صَلَّوْا وصامُوا","لما وُعِدوه من حسن الجزاء",23,"ا",2,0],["ولا ممّن يرون الله يجزي","على الصلوات بالحور الوضاء",23,"ا",2,0],["ولا ممّن يرى الأشياء تفَنَى","بحيث تكون من عَدَم هواء",23,"ا",2,0],["وَلامَت قُرَيشٌ في الزُبَيرِ مُجاشِعاً","وَلَم يَعذُروا مَن كانَ أَهلَ المَلاوِمِ",24,"م",1,0],["وَلامَت في الحُدودِ وَعاتَبَتهُ","فَقَد يَئِسَت نُوارُ مِنَ العِتابِ",25,"ب",1,0],["وَلا مِن أَبي جَزءٍ وَجاري حَمومَةٍ","قَتيلِهِما وَالشارِبِ المُتَقَطِّرِ",26,"ر",1,0],["وَلا مِن رَبيعِ المُقتِرينَ رُزِئتُهُ","بِذي عَلَقٍ فَاِقنَي حَياءَكِ وَاِصبِري",26,"ر",2,0],["ولا مَخَاضٌ ولا عِشارُ مَطَا","فيلُ ولا قُرَّحٌ ولا سُلُبُ",27,"ب",1,0],["وَلا ماءٌ سِوى نُطفِ الأَداوي","وَلا زادٌ سِوى القَنَصِ المُثارِ",28,"ر",1,0],["وَلا مانِعاً لِلمالِ فيما يَنوبُهُ","وَلا ناكِلاً في الحَربِ جِبساً مُغَفَّلا",29,"ل",2,0],["وَلا مَن يَملَءُ الشيزى وَيَحمي","إِذا ما الكَلبُ أَجحَرَهُ الضَريبُ",30,"ب",1,0],["وَلا مَشى فَوقَ ظَهرِ الأَرضِ مِن أَحَدٍ","أَوفى بِذِمَّةِ جارٍ أَو بِميعادِ",31,"د",1,0],["ولا مثالَ لما شادتْ عزائمه","إلاَّ إذا نيلت الشهبُ المنيرات",32,"ت",1,0],["ولا مقلةٌ نجلاءُ يحرس لحظها","لَمًى فأقول السيف قد حرس الثغرا",33,"ر",2,0],["ولا مرشفٌ ماءَ الحياةِ حسبته","ولا نبتُ خدٍّ كنت أحسبه الخضرا",33,"ر",2,0],["ولام على حسنه المجتلى","وِقاحُ العيون فما أثروا",34,"ر",3,0],["ولا مناسك فيها للهدى شهبٌ","ولا ديارٌ بها للوحيِ تنزيل",35,"ل",1,0],["ولا ملامَ على مُرتادِ مصلحةٍ","باع اللُّجينَ بضعفَيهِ من الذهبِ",36,"ب",1,0],["ولا من التَّفْصِيلِ مَنْكُوسَةً","ولا من الشَّيِّ ولا الطَّبْخ",37,"خ",1,0],["ولا مثلكم من قال طالبُ رفده","بخلتُمْ ببرد اليأس عني وبالرِّفْدِ",38,"د",1,0],["ولا مدحُ ما لم يمدح المرءُ نفسَهُ","بأفعال صدقٍ لم تَشُبها الخسائس",39,"س",1,0],["ولا مِنْ حَمْلها إياك منْه","وقد حمل الخنا بطنٌ يعيكا",40,"ك",2,0],["ولا مُعظماً خِلّاً لغير ثرائه","وإن كان ذا تقوى وإن كان ذا عقلِ",41,"ل",1,0],["ولا مَلِك لا مجدَ إلا وقد بنى","ولا رأسَ سامي الطَّرفِ إلا وقد وقمْ",42,"م",1,0],["ولا مُرْسَلٌ بالوَحْي وحيِ مليكه","سِراجاً منيراً نورُهُ الساطعُ الأتمْ",42,"م",1,0],["وَلا مُتَحَيِّرٌ باتَت عَلَيهِ","بِبَلقَعَةٍ يَمانِيَةٌ تَفوحُ",43,"ح",1,0],["وَلا مَرَّ يَومٌ مُذ تَرامَت بِكِ النَوى","وَلا لَيلَةٌ إِلّا هَوىً مِنكِ رادِفُ",44,"ف",1,0],["ولا مثله في مصر ذا عبقرية","على ما يراه قومه غير جامد",45,"د",1,0],["ولامة بعد الوفاق تخالفت","فتقطعت لخلافها اوصالها",46,"ل",3,0],["ولا مثل بطن القبر دار عدالة","تساوى بها حالا رؤوس وأرجل",47,"ل",1,0],["ولأمر ما وسر غامض","تسعد النطفة أو يشقى الجنين",48,"ن",1,0],["ولا منٌّ عليك به","فِمن جدواك منجمه",49,"م",2,0],["ولا مجاهل الثرى","تطوى كما تطوى القرى",50,"ر",2,0],["وَلا مُستَودَعاً مالاً لِقَومٍ","إِذا رَجَعوا لَهُ أَدّى وَزادا",51,"د",2,0],["وَلا مَن في جَنازَتِها تِجارٌ","يَكونُ وَداعُها نَفضَ النِعالِ",52,"ل",1,0],["وَلا مُفارَقَةُ الأَحبابِ ما وَجَدَت","لَها المَنايا إِلى أَرواحِنا سُبُلا",53,"ل",2,0],["وَلا ما تَضُمُّ إِلى صَدرِها","وَلَو عَلِمَت هالَها ضَمُّهُ",54,"م",2,0],["وَلا مِنَ اللَيثِ إِلّا قُبحَ مَنظَرِهِ","وَمِن سِواهُ سِوى ما لَيسَ بِالحَسَنِ",55,"ن",1,0],["وَلا مَلَكا سِوى مُلكِ الأَعادي","وَلا وَرِثا سِوى مَن يَقتُلانِ",56,"ن",1,0],["ولا متُّ أو ألقاكَ حظُّكُ دولةٌ","وحظُّ الأعادي رنَّةٌ وعويلُ",57,"ل",1,0],["ولا موقِدٌ ناري بعلياءَ للقِرَى","ولا رافعٌ لي بالعَراء قِبابَا",58,"ب",2,0],["وَلا مالَتِ الدُنيا بِهِ حينَ أَشرَفَت","لَهُ في تَناهي هُسنِها وَاِحتِشادِها",59,"د",3,0],["وَلا مانِعٌ مِمّا تَوَهَّمتُ غَيرَ أَن","تَذَكَّرَ بَعضَ الأُنسِ أَو تَتَذَمَّما",60,"م",2,0],["وَلا مَجدَ إِلّا حينَ تُحسِنُ عائِداً","وَكُلُّ فَتىً في الناسِ يُحسِنُ بادِيا",61,"ي",2,0],["وَلا مَدَّ باعاً باهِلِيٌّ إِلى العُلى","وَلا أُغمِضَت عَيناهُ إِلّا عَلى وِترِ",62,"ر",1,0],["وَلا مالِ مَولىً لِلوَلِيِّ الَّذي جَنى","عَلى نَفسِهِ بَعضَ الحُتوفِ اللَواحِقِ",63,"ق",1,0],["وَلا مُكَلَّلَةٌ راحَ السِماكُ لَها","في ناحِراتِ سَرارٍ قَبلَ إِهلالِ",64,"ل",1,0],["وَلا مُنصِفي يَوماً فَأُدرِكَ عِندَهُ","مَظالِمَهُ عِندي وَلا تارِكاً أَكلي",65,"ي",1,0],["ولا مُفرداً يَثني الكتائبَ بأسُهُ","ويرتاعُ منه دارِعٌ وهو حاسِرُ",66,"ر",1,0],["ولا معاقلَ إلا كلُّ سابغَةٍ","يطوي الفِجاجَ سَناها وهو منشورُ",67,"ر",1,0],["وَلا مُهانٍ وَلَكِن عِندَ ذي كَرَمٍ","وَفي حِبالِ وَفِيٍّ غَيرِ مَجهولِ",68,"ل",1,0],["وَلا مُلكَ إِلّا مُلكُهُ عَزَّ وَجهُهُ","هُوَ القَبلُ في سُلطانِهِ وَهُوَ البَعدُ",69,"د",1,0],["وَلا مُتَلَقِّيَهُ قافِلاً","بِقَتلِ عَدُوٍّ وَلا أَسرِهِ",70,"ر",2,0],["وَلا ما يَسوءُ النَفسَ غَيرُ نِفارِهِ","وَلا ما يَروعُ القَلبَ غَيرُ عُقوقِهِ",71,"ق",2,0],["وَلا مُهِّدَ الإِسلامُ عِندَ اِضطِرابِهِ","فَأَصبَحَ مَشدوداً بِهِ ذَلِكَ الأَزرُ",72,"ر",1,0],["ولا مكانٌ تتجارى به","خيلُ القوافي غيرُ هذا المكان",73,"ن",1,0],["ولا مجانيقَ إلا ضُمّرٌ جُعِلَتْ","صخورها حولها الأبطال والبهمُ",74,"م",1,0],["ولا مهابَةُ محجوبٍ تَبَرَّجَها","كَأنّهُ عِندَ أبصارِ الورى خَفَرُ",75,"ر",1,0],["وَلا مُرَّتا ذُهلٍ وَلا الحِصنُ غالَهُ","وَلا كَفَّ شَأوَيهِ عَلِيٌّ وَلا صَعبُ",76,"ب",1,0],["وَلا مالَ إِلّا ما كَسَبتَ بِنَيلِهِ","ثَناءً وَلا مالٌ لِمَن لا لَهُ مَجدُ",77,"د",1,0],["ولا محباً لذي فضلٍ ولا ثقةٍ","ولا أميناً ولا عدلاً عنِ العوجِ",78,"ج",1,0],["ولا مصيخاً إلى مدْحٍ إذا مُدحوا","ولا كريماً يخافُ الهجوَ حيثُ هُجي",78,"ج",2,0],["ولا مرادي وصالُ المردِ إذ خَطَروا","ولا ازدهاني بخدٍّ ناعمٍ ضرجِ",78,"ج",1,0],["وَلا مَن يُنادي نَحوَ نَهرٍ وَدَوحَةٍ","وَوَجهِ أَخي حُسنٍ يُقابَلُ بِالبَدرِ",79,"ر",1,0],["وَلا مُنشِداً ما أَبرَمَ الطَلحُ سامِراً","وَقَد مالَ مِن لَيلِ التِمامِ هَزيعُ",80,"ع",1,0],["وَلا مِنهُمُ نائِلٌ عاجِلٌ وَلا","بِالفُرُوضِ جَزَونا قُرُوضا",81,"ض",2,0],["وَلأَمنَعَنَّ العَينَ فيهِ مَنامَها","وَلأَجْعَلَنَّ لها السُّهَادَ خَلِيلا",82,"ل",2,0],["ولا مُهُور سِوَى الأرْوَاحِ تَقْبَلُها","الْبِيضُ البَهاتِيرُ والسُّمْرُ العَطابِيلُ",83,"ل",1,0],["ولا مَدْحَ إلاّ للمعِزّ حقِيقَةً","يُفصَّلُ دُرّاً والمديحُ أساليب",84,"ب",1,0],["وَلاِمتَرَتها وَخَيلُ القَومِ جائِلَةٌ","أَيدي الفَوارِسِ مِن صُمِّ الأَنابيبِ",85,"ب",1,0],["وَلا مُجازٍ مُخطِياً إِذا تاب","وَكَيفَ لي بِوِردِ نُسكٍ مُؤتاب",86,"ب",1,0],["ولا مُقِرُّ عَلى اللَذاتِ أَولُها","شُهدٌ يَغُرُّ وَلكِن غِبَّهُ مِقَرُ",87,"ر",1,0],["وَلا مُغَنِّيَ بَل مُبدٍ لَهُ أَسَفاً","كَما يَقولُ بَنو سَرّاكَ حُزّانُ",88,"ن",1,0],["وَلا مُلكَ إِلّا لِلَّذي عَزَّ وَجهُهُ","وَدامَت عَلى مَرِّ الزَمانِ عُلاهُ",89,"ل",3,0],["وَلا مَهُما عَن فَرطِ حُبِّهِما لَهُ","وَفي بُغضِهِ إِيّاهُما عَذَلاهُ",89,"ل",3,0],["ولا مِثْلَ فُقْدانِ الشّريف محَمّدٍ","رزِيّةَ خَطبٍ أو جِنايةَ ذي جُرْمِ",90,"م",1,0],["ولا مُبْقٍ إذا يسعى صُدُوعاً","غَوَائِرَ في الدّكادِكِ والإكامِ",91,"م",1,0],["وَلا مَحالَةَ مِن قَبرٍ بِمَحنِيَةٍ","وَكَفَنٍ كَسَراةِ الثَورِ وَضّاحِ",92,"ح",1,0],["وَلاَ مَلِقٌ يَنزُو ويُندِرُ رَوثَهُ","أُحادَ إِذا فَأسُ اللِجامِ تَصَلصَلا",93,"ل",2,0],["ولا مثل يوم ظل يبكي غمامه","ويضحك في طياته البرق والرعد",94,"د",1,0],["ولا مثل صاد في الهجيرة بينه","وَبين بلوغ الماء من دجلة سد",94,"د",1,0],["ولا ملْك إلاّ أنت والملك فضلةٌ","كأنّك نصلٌ فيه وهو قراب",95,"ب",1,0],["وَلا مُلكَ إِلّا أَنتَ وَالمُلكُ فَضلَةٌ","كَأَنَّكَ سَيفٌ فيهِ وَهُوَ قِرابُ",96,"ب",1,0],["ولامَكِ الضّليلُ في دهره","فمنكِ لا منه الضلال المبينْ",97,"ن",1,0],["ولا مَلَكَت يَدايَ عِنانَ طِرفٍ","ولا أَبصَرتُ مِن شَمسٍ شُعاعا",98,"ع",2,0],["وَلأَمْحُوَنَّ رُسُومَ أَسْلاَفِي بِهَا","فَيَبِيتُ مَاضِي الصِّينِ وَهْوَ مُحَجَّبُ",99,"ب",1,0],["وَلأُمِّهِ الكُبْرَى وَأُمِّكَ قَبْلَهُ","خَلِّي وَلِيدَكِ وَارْقدِي بِهَنَاءِ",100,"ا",2,0],["وَلِأَمرِ اللَهِ أُخرى أرجِئَت","فَهيَ وَقفٌ بَينَ أَمنٌ وَفَرق",101,"ق",1,0],["ولا مَلكٌ تعبَّدَهُ هواهُ","ولم يُكْبَحْ لشهوتِهِ جِماحُ",102,"ح",1,0],["ولا مَنْ أصلهُ في الخلق طينٌ","ولا مَنْ أصلهُ في الخلق نار",103,"ر",1,0],["ولا مَنْ أصلُه: ذهَبٌ، ومِسْكٌ","وأصلُ سواه: مخْشَلَبٌ، وقار",103,"ر",1,0],["ولا من زان سَحْنَتَه أبيضاضٌ","وآخرُ شَانَ سحنته اسمرَار",103,"ر",1,0],["وَلأُمَّةٍ أَعْزَزْتَ شَأْنَ","رُبُوعِهَا بَيْنَ الرُّبُوعِ",104,"ع",1,0],["ولأمرٍ يَدوي الفضاءُ هُتافاً","من مُحييَّك فوقَ كلِّ رَصيف",105,"ف",1,0],["ولا مشتْ \" بُرُدٌ \" والموتُ يحملها","ولا سعتْ \" رُسلٌ \" والموتُ يتَّبع",106,"ع",1,0],["وَلاَ مالَتِ الدّنْيَا بهِ حينَ أشرَقَتْ","لهُ في تَنَاهي حُسْنِها، واحتِشَادِها",107,"د",3,0],["ولاَ منشداً، ما أبرمَ الطَّلخُ، سامراً","وقدْ مالَ منْ ليلِ التَمامِ هزيعُ",108,"ع",1,0],["وَلاَ مِثْلَ هَذِي العَيْنِ تُرْوِي عَلَى ظَمَا","وَلاَ كَحَلاً فِي الجَفْنِ أَفْضَحَ لِلْكُحْلِ",109,"ل",1,0],["ولا مثلَ يوم فق قُدار ان ظللتهُ","كأني وأصحابي على قرنِ أعفرا",110,"ر",2,0]]}