عزعني قطُّ بالنّاهلِ",262,"ل",1,0],["وَلا مزيّةَ لَولا ما يَجيء بهِ","فضلُ الفتى بين مسعودٍ ومنحوسِ",263,"س",1,0],["ولا مكانٍ يستوي عندَهُ","دَرادِقُ الذَّوْدِ مع الجِلَّةِ",264,"ه",1,0],["وَلا ملك الأَنامَ سِواك مولَى","وَلا قَصدوا سِوى نُعماكَ بابا",265,"ب",2,0],["وَلا مَزّقتْ جلدي الغداة أظافرٌ","وَلا خَرَقْتهُ للزّمان نيوبُ",266,"ب",1,0],["ولا من أنبياء الل","ه إني أو من الرسل",267,"ل",1,0],["ولا من والد لي بل","ولا أم ولا نجل",267,"ل",1,0],["ولا مال عند القوم إلا نفوسهم","تجارتهم فيها غلت والبضائع",268,"ع",1,0],["ولا ملِكُ إلا وحجّابه به","تحف اشتمالا بالقنا والقاضب",269,"ب",1,0],["ولا معز بلا شخص يعززه","ولا مذل بلا قوم أذلّاء",270,"ا",2,0],["وَلا مَعَ الماشي وَلا مَشِيُّ","يَلمِزُها وَذاكَ طُرآنِيُّ",271,"ي",1,0],["وَلا مَلِلنا وَإِن لَم","تَترُك دَوامَ المَلالِ",272,"ل",1,0],["ولا من الحج ولا الجهاد","لأهل دار الشرك والأعادي",273,"ي",1,0],["ولا من الحكام بين الناس","بالظلم والجور بني العباس",273,"س",1,0],["ولا مذوق لا ولا مري","ولا موات لا ولا من حي",273,"ي",1,0],["ولا مقسم لا تبرح الدهر بيتها","لأَجعله قبل المَمات لها قبرا",274,"ر",2,0],["ولأَمدحنَّك بالفتوَّ","ةِ في الحضورِ وفي المغيبِ",275,"ب",1,0],["ولا مثل هذا الرئيس الَّذِي","عَلى كُلِّ فَخْرٍ له مَفْخَرُ",276,"ر",1,0],["وَلا مَدايِحَ إلّا في مُحمَّد بْن","الافْتِخارِ المُرْجَى دَافعِ الضَّررِ",277,"ر",1,0]]}