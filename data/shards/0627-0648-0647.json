{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[53,"مثال عينيك في الظبي الذي سنحا","https://www.aldiwan.net/poem30655.html","البسيط"],[63,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[77,"ياليت شعري هل يقضى تألفنا","https://www.aldiwan.net/poem36029.html","البسيط"],[93,"أدعو القريض فيعصي بعد طاعته","https://www.aldiwan.net/poem11272.html","البسيط"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[38,"أو هيبان نجيب نام عن غنم","https://www.aldiwan.net/poem7827.html","البسيط"],[85,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[85,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[66,"أوهمتها صمما في مسمعي فغدت","https://www.aldiwan.net/poem39664.html","البسيط"],[97,"طلق شجونك في ثرى الأحبابِ","https://www.aldiwan.net/poem24392.html","الكامل"],[97,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[80,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[69,"قالوا بدا الشعر أما تشعر","https://www.aldiwan.net/poem28916.html","السريع"],[31,"قد هاج أحزان قلبك الذكر","https://www.aldiwan.net/poem42493.html","المنسرح"],[31,"ذكر القلب ذكرة من","https://www.aldiwan.net/poem42642.html","مجزوء الخفيف"],[105,"حي العروبة آسادا وأشبالا","https://www.aldiwan.net/poem41930.html","البسيط"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"شفعيني يا شر في رد نفسي","https://www.aldiwan.net/poem26780.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141033",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[99,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[31,"قد هاجَ أحزانَ قلبكَ الذكرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18906&r=&rc=169",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[115,"سأم القلب زماناً","https://www.aldiwan.net/poem40456.html","عموديه"],[128,"قيل لي أنت في مديحك تغلو","https://www.aldiwan.net/poem50545.html","الخفيف"],[129,"أوه ألم يكتب هذا القلم","https://www.aldiwan.net/poem67440.html","السريع"],[160,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[160,"هو القضا فخذ المبسوط مختصرا","https://www.aldiwan.net/poem59004.html","البسيط"],[169,"كم أرجع الزفرات في أحشائي","https://www.aldiwan.net/poem1594.html",""],[199,"على السماء وفوق الشمس أشعاري","https://www.aldiwan.net/poem45351.html","البسيط"],[207,"إما تري يا أم فروة خيلنا","https://www.aldiwan.net/poem27940.html","الكامل"],[210,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[221,"ذهبالشباب فأطرقت","https://www.aldiwan.net/poem55286.html","مجزوء الكامل"],[229,"إنما تكرم الطباع إذا ما","https://www.aldiwan.net/poem50853.html","الخفيف"],[229,"أوهمتني من رقة العذر","https://www.aldiwan.net/poem51007.html","أحذ الكامل"],[235,"يا خير من لبس النعال وخير من","https://www.aldiwan.net/poem31735.html","الكامل"],[235,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[237,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[241,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[252,"ما نام بعد البين يستحلي الكرى","https://www.aldiwan.net/poem1416.html",""],[257,"ما للموله من سكره لا يفيق","https://www.aldiwan.net/poem2656.html","المجتث"],[270,"في عجزنا لعداتنا إعجاز","https://www.aldiwan.net/poem34994.html","الكامل"],[270,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[298,"حطمت أغلال يدي","https://www.aldiwan.net/poem36294.html","عموديه"],[300,"أفد الرحيل وليته لم يأفد","https://www.aldiwan.net/poem45492.html","الكامل"],[303,"قولوا له رد النفار إلى الظبا","https://www.aldiwan.net/poem58097.html","الكامل"],[304,"يا وجيه إنها هب","https://www.aldiwan.net/poem16885.html","عموديه"],[328,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[361,"هي الليالي فلا تغتر بالامل","https://www.aldiwan.net/poem68072.html","البسيط"],[364,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[371,"منيتها تفرق من عاذلي","https://www.aldiwan.net/poem57221.html","الكامل"],[371,"أوهاني الواهي الضعيف","https://www.aldiwan.net/poem57303.html","مجزوء الخفيف"],[400,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[403,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[406,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[406,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[409,"من مبلغ عني فلان","https://www.aldiwan.net/poem31953.html","مجزوء الكامل"],[416,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[429,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[429,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[429,"جاءت تميس وقدها الخطار","https://www.aldiwan.net/poem40716.html","الكامل"],[429,"رفقا بأسيرك يا أسما","https://www.aldiwan.net/poem41412.html","المتدارك"],[429,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[429,"من الأحبة أم من طيب ربعهم","https://www.aldiwan.net/poem41426.html","البسيط"],[441,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[443,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[453,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[461,"ليس حملي مجرد الزين والظر","https://www.aldiwan.net/poem15385.html","الخفيف"],[464,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[479,"زان طرفها الحور","https://www.aldiwan.net/poem36921.html","المقتضب"],[500,"إطمس مشاهدك التي","https://www.aldiwan.net/poem37971.html","مجزوء الكامل"],[515,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[536,"لما رأيت نبينا متحملاً","https://www.aldiwan.net/poem23867.html","الكامل"],[538,"ألقلب من حذر النوى ملآن","https://www.aldiwan.net/poem47592.html","عموديه"],[553,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[558,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[562,"تلك أيامنا عليها السلام","https://www.aldiwan.net/poem52965.html","الخفيف"]],"verses":[["أَوهَنَت مِنهُ اللَيالي فَقرَةً","لا يُلاقي وَهنَها اليَومَ جُبارا",0,"ر",2,0],["أَوهَت أَكُفُّهُمُ بَيني وَبَينَهُمُ","فَتقاً بِغَيرِ العَوالي قَلَّ ما نُصِحا",1,"ح",2,0],["أوْهى مَعاقِدَها وأطْفأَ نارَها","قبلَ انْتِشارِ لَظىً وبعْدَ وَقودِ",2,"د",1,0],["أوْ هَلْ يَحِنُّ عَلَى نَفْسِي مُعَذِّبُهَا","أوْ هَلْ يَرِقُّ لِقَلْبِي قَلبِيَ الثَّانِي",3,"ي",1,0],["أَوْهَى الكَوَاهِلِ يَقْوَى الاِرْتِيَاضُ بِهَا","حَتَّى يَعِزَّ الحِمَى مِنْهَا بِأَرْكَانِ",4,"ن",1,0],["أَوْ هَلْ أَذَابَ سِوَاكَ مِنْ تَدْقِيقِهِ","فِيهَا سُوَيْدَاءَ الفُؤَادِ المُغْرَمِ",5,"م",1,0],["أو هل الشرق وحده في الأقالي","م مباح أن يُستبى ويضاما",6,"م",2,0],["أو هل القوم عاهدوا الله في أن","لا يراعوا للمسلمين ذِماما",6,"م",2,0],["أوْهَمَ العينَ أنه أخطأ المَضْ","رِبَ هذَّاً وقد مَضَى المضْروبُ",7,"ب",1,0],["أو هامس يُكذِبُني أو هامسه","عزَّ القضاءُ الأيديَ المُخالسه",8,"س",2,0],["أوهى معاقدَ صبره كُلَفٌ","لم يوهه يوماً تمتُّعُهُ",9,"ع",2,0],["أَو هِقلَةٌ مِن نَعامِ الجَوِّ عارَضَها","قَردُ العِفاءِ وَفي يافوخِهِ صَقَعُ",10,"ع",1,0],["أَو هَيَّبانٌ نَجيبٌ نامَ عَن غَنَمٍ","مُستَوهِلٌ في سَوادِ اللَيلِ مَذؤوبُ",11,"ب",1,1],["أوهنته الحادثات هوى","وهو خفاق على الوهن",12,"ن",1,0],["أَوهى جَناحَيهِ الحَدي","دُ وَحَزَّ ساقَيهِ الحَرير",13,"ر",1,0],["أَو هارِباً أَو طالِباً أَو راغِباً","أَو راهِباً أَو هالِكاً أَو نادِبا",14,"ب",2,0],["أَوهِ بَديلٌ مِن قَولَتي واهاً","لِمَن نَأَت وَالبَديلُ ذِكراها",15,"ا",3,1],["أَوهِ لِمَن لا أَرى مَحاسِنَها","وَأَصلُ واهاً وَأَوهِ مَرآها",15,"ا",3,0],["أَوهَمتُها صَمَماً في مَسمَعي فَغُدَت","تُكَرِّرُ اللَفظَ أَحياناً وَتَبتَسِمُ",16,"م",1,1],["أو هكذا الدنيا وذاكَ مآلُهَا","أسفاً لغادرةٍ كلمعِ سرابِ",17,"ب",1,0],["أو هكذا الدنيا وذاك مآلُهَا","أوَ ذاكَ وعدُ خيالِهَا الكذابِ",17,"ب",1,0],["أو هذا السرور من ذكر الما","ضي تسميه بالعذاب المبين",18,"ن",1,0],["أوَ هذا كلّه من لِمّةٍ","أبْصَرَتْ فيها بياضَ الشيبِ لاح",19,"ح",1,0],["أوهمتُهُ برشْفِ ريقِ الثغرِ","وغصتُ في البحر ابتغاءَ الدرِّ",20,"ر",1,0],["أو هو بحرٌ مِنْ حياةٍ طما","يُزجى إلى ساحلِهِ العنبرُ",21,"ر",1,0],["أَو هَل يُغَنّي لِشَجوِهِ فَبَكى","كَما تَغَنّى لِشَجوِهِ عَمَرُ",22,"ر",1,0],["أَو هِلالٌ بَدا لَنا","وَسطَ زُهرِ الكَواكِبِ",23,"ب",1,0],["أَوهْىَ قُوايَ وهَدَّ اليومَ من هِمَمي","داءٌ أراهُ شديدَ الفَتْكِ قتّالا",24,"ل",2,0],["أَو هُدبُ حُلَّتِهِ في السِلمِ يَلبَسُها","وَهَذِهِ في الوَغى سَردٌ يُدَرَّعُهُ",25,"ع",2,0],["أَو هَبي لي صَبراً أَرُدُّ بِهِ الدَم","عَ فَإِنّي أَخافُ دَمعي عَلَيكِ",26,"ك",1,0],["أوْ هُوَ النحلُ قَرْصُهَا يَجْلُبُ الحَت","فَ إليها وما له إنْكَاءُ",27,"ا",2,0],["أَوهَبَ مِنهُ لِذي أَثرٍ وَسابِغَةٍ","وَقَينَةٍ عِندَ شَربٍ ذاتِ أَشكالِ",28,"ل",1,0],["أوه إن الفراق أصعب من كُل","لِ عذابٍ يشقى به الموزور",29,"ر",1,0],["أوه من ألاّ أرى محاسنها","وأصل واهاً وأوه مرآها",30,"ا",3,0],["أَوْهَنْتِ عَزْمِي وَهْوَ حَمْلَةُ فَيْلَقٍ","وَحَطَمْتِ عُودِي وَهْوَ رُمْحُ طِرَادِ",31,"د",1,0],["أَوْهَتْ رُجُومُ الْغَيْبِ أَضْلاعُهُ","لَكِنْ نَبَتْ عنْ نَفْسِ مُسْتَكْبِرِ",32,"ر",1,0],["أَو هَب لَهُ النَومَ وَمُر","طَيفَكَ يُخبِر خَبَرَك",33,"ك",1,0],["أَوْ هَزَّ شَيْطَانُهُ أَوتَارَ مَنْطِقِهِ","فَاخْشَ الأَتِيَّ وَحَاذِرْ صَوْلَةَ العُبُبِ",34,"ب",1,0],["أو هل تُرَى ابن أبي ربي","عةَ بعد غيبتِه حضر؟",35,"ر",1,0],["أوهمتني فجوةٌ واحدةٌ","أنَّ في فيَّ تضاريسَ عِظاما",36,"م",2,0],["أو هذا .. الذي انتهيت إليه ؟","مجدك الآن .. قنب .. وغبار",37,"ر",1,0],["أوَ هل يعود إلى العرو","بة ذلك المجد الأثيلُ",38,"ل",1,1],["أو هل تغنى لشجوهِ، فبكى ،","كما تغنى لشجوهِ عمر؟",39,"ر",1,0],["أَوْ هَكذا زَعَمُوا! وَجِيءَ بِهِ إلى","بَلَدي الْجَريحِ عَلَى يَدِ الأَعْوانِ",40,"ن",1,0],["اوهن الصد وطيشا","للاداني احسنا",41,"ن",2,0],["أَوَ هَلْ يستوى الخضمُّ ومَن لا","يُمْتَرى مِن يمينه قطُّ نَهْلُ",42,"ل",1,0],["أوهِ ألَم يُكتَب هذا القَلم","إِلا بأن يَشكو الأسى والألم",43,"م",1,1],["أو همه الواشي بما يفتري","مختلفاً فأوه ما أوهما",44,"م",2,0],["أو هارب منه قد قامت قيامته","فطار في الأفق لا يلقى له أثرا",45,"ر",2,0],["أَو هاجَروا في الأَرضِ فَهيَ عَريضَةٌ","فَالتّيهُ خَيرٌ مِن حِمى الأَحساءِ",46,"ا",2,0],["أو هذهِ لبستْ من ليلها حُللاً","ومن كواكبها زرتْ بأزرارِ",47,"ر",1,0],["أَوهى مُقارَعَةُ الأَعادي أَدمَها","فيها نَوافِذُ مِن جِراحٍ تَنبَعُ",48,"ع",1,0],["او هام به جبل لهوى","مما بالهجر يهدده",49,"د",2,0],["أو هيكل نصبوه من","عظم بوسط بسابس",50,"س",1,0],["أو هَزَزْناك للخطوبِ هَزَزْنا","شَفْرَةَ الصّارِم الحُسامِ الصَّقيل",51,"ل",1,0],["أوهمتني من رِقَّة العُذْر","أنّ الوفاء يكون بالغَدْرِ",52,"ر",1,1],["أَو هَل يَليقُ بِمِثلِ جودِهِ أَن يَرى","حِرمانَ مَن أَمسى بِشُكرِكَ مُعلِنا",53,"ن",2,0],["أَو هارِبٍ ضاقَت عَليهِ بِرُحبِها ال","أَرضُ الفَضاءُ وَأينَ مِنكَ المَهرَبُ",54,"ب",1,0],["أَوْ هَمْزِهِ أَوْ غَمْزِهِ أَوْ لَمْزِهِ","أَوْ رَجْزِهِ أَوْ رِجْسِهِ أَوْ نَجْشِهِ",55,"ش",2,0],["أَوهمُوهُ أن الذكاءَ ثراءٌ","فمضى يَسحبُ الذيولَ اغترارا",56,"ر",2,0],["أَو هَزَّ في الهَيجاءِ أَسمَرَ ذابِلاً","إِلّا وَآلَ بِرأسِ طاغٍ مُثمِرا",57,"ر",2,0],["أَو هَل أَديب يَحيي لَنا بِالغروس","ما كانَ أَحلى",58,"ل",2,0],["أوَ هُم عبادُكَ وحدَهُم لِتُعزَّهم","وتُذِلَّنا أم طِينُهم ممتاز",59,"ز",1,0],["أو هل تصحُّ خلافةٌ وإمامةٌ","حيثُ الفرنجةُ واليهودُ قيام",60,"م",1,0],["أو هوجم الليثُ حَمَى","أَشبالَه في غيله",61,"ه",1,0],["أَو هَل تَرَينَ الدَهرَ عَرّى مَسَّهُ","إِلّا عَلى لَمَمٍ يَروحُ وَيَغتَدي",62,"د",2,0],["أو هات غيري للتجني والجفا","فأنا استجرت بذمة السلوان",63,"ن",1,0],["أو هو البعد حتى","نجتمع في اللحود",64,"د",1,0],["أو هكذا أمضى وما","بلّغتُ من أملي مداه",65,"ه",1,0],["أَو هل نَسيب لدو اللموت أَو عميت","عَيناكَ عن واضِع نعشا وَمُحتَمل",66,"ل",1,0],["أوهَتْ رزيئةُ هذا منّةً وأَتَتْ","أيّامُ هذا فأهدَتْ قُوّةَ المنَن",67,"ن",1,0],["أَو هَز مِن آرائِه صارِماً","أدنَى حلُولَ الأَجلِ الآجِلِ",68,"ل",1,0],["أوهانيَ الواهي الضَّعيفُ","والفَتكُ من طَرفٍ طَريفُ",69,"ف",1,1],["أوهَّابيَّةٌ، والحقُّ شمسٌ","يبدِّد نورُها الليل الطَّويلا؟",70,"ل",2,0],["أوهمتني أني سواك به","وبمثل هذا كتبكم تُنْبِي",71,"ي",1,0],["أَو هَل يباريك السَحاب وَجوده","ماء وجود يَديك بالعِقبانِ",72,"ن",1,0],["أَوَ هَل يُريد الجود بَعدَ يَمينِهِ","وَهوَ النِهايَة في العُلوِّ نزولا",73,"ل",2,0],["أوهَتْ خطوبُ الدهرِ من","هِمَمِي وفلَّتْ حدَّ عَزمي",74,"م",2,0],["أوْهَنَتْه أثْقال وِزرٍ ثقيل","إنَّ ضُعْفَ القُوى وفقدانَ عَوني",75,"ي",1,0],["أو هز أقلامه قالت كتائبها","ما السيف أصدق أنباءً من الكتبِ",76,"ب",1,0],["أو هاتها حمراء كوجنة شادنٍ","للَه من أجفانه للَه",77,"ه",1,0],["أو هزّ خطيّا فهذا واقع","فوق الثرى خوفاً وذا فرّارُ",78,"ر",1,0],["أو همت بظبي أو بدر","فجمالك كلهما عمّا",79,"م",2,0],["أو هز لدنا اسمراً","خلت ابن معدي او غثم",80,"م",1,0],["أو هزّ لدنا ترى الأعداء هاربة","ما بين منسفج منهم ومنهزم",81,"م",1,0],["أو هاب الهنائد كانسات","وقائد كل غيطاء اللجام",82,"م",1,0],["أو هو الثلج ذائب أو هو الكو","ثر يجري في حوض هذي الجنان",83,"ن",1,0],["أو هو الفجر والظلام اقاما","ساعة في الجبال يصطرعان",83,"ن",1,0],["أو هزت الألباب ثورة فنه","إلا وأرضخه إلى تعليمنا",84,"ن",2,0],["أُوهِمُ العينَ منه مَسحَ المُحيَّا","ومُرادي كَفٌّ الدموع الجواري",85,"ي",1,0],["أوهنت أيدها العفاةُ فقد ظا","هرتَ منها إلى نداك السُّبلا",86,"ل",2,0],["أو هما ولا شبه","العقيق والدرر",87,"ر",1,0],["أَوْهامَ مَصْروعِ الحَضي","ضِ إلى العُلى يتَطَلَّعُ",88,"ع",1,0],["أو هل تزور النار ساحة جنة","أجريت فيها من نداك الكوثرا",89,"ر",2,0],["أَوهَيتُ قَلبي عِندَ ذاكَ بِهُلكِهِ","وَالعَظمُ مِنّي ما حَييتُ كَسيرُ",90,"ر",1,0],["أو هَزَّكُم شَوقٌ لها أم هَزَّها","شَوقٌ إِليكَ وَرَحمَةٌ وَحَنَانُ",91,"ن",1,0],["أَوهَنَني حُبُّ مَن شُغِفتُ بِهِ","حَتّى بَراني وَشَفَّني الوَهنُ",92,"ن",1,0],["أو هي الظلُّ فسل عن شاخصٍ","هو منا دائماً أولى بنا",93,"ن",2,0],["أوهَمَتْنا طُولَ الحياة علينا","بَعْدَها إنَّ ساعةَ الصبرِ عامُ",94,"م",1,0]]}