أل سؤالك ليس يجدي!...","https://www.poetsgate.com/ViewPoem.aspx?id=191234",""],[5431,"قد جئت دهرك ثائرا ووحيدا","https://www.poetsgate.com/ViewPoem.aspx?id=196789",""],[5493,"شِعر بعمقِ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=197000",""],[5510,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=206114",""],[5516,"نم يا كحيل العين","https://www.poetsgate.com/ViewPoem.aspx?id=212405",""],[5525,"هداج","https://www.poetsgate.com/ViewPoem.aspx?id=7284",""],[5525,"كل ما دعاني الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=7180",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5644,"سَكَرَات شوق","https://www.poetsgate.com/ViewPoem.aspx?id=198575",""],[5683,"برج الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=32346",""],[5703,"لن أعود","https://www.poetsgate.com/ViewPoem.aspx?id=210293",""],[5751,"ليالي سَجاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=214792",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5829,"خبر يندى له الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=156844",""],[5829,"بلبل الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=176836",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[5910,"فلطالما حاربتُ ذا سفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207125",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"غيري من الشعراء...","https://www.poetsgate.com/ViewPoem.aspx?id=193359",""],[5957,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=56335",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""],[6056,"طيور الظلامي","https://www.poetsgate.com/ViewPoem.aspx?id=130381",""],[6142,"ما نشا في السما ولا ساح في الأر","https://www.poetsgate.com/ViewPoem.aspx?id=155697",""],[6147,"إبحار في متاهات أنفاسها","https://www.poetsgate.com/ViewPoem.aspx?id=151482",""],[5309,"عاش يهواها ويستوحي جهاده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573547",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""],[6167,"على شط الأربعين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85485&r=&rc=14",""],[4035,"ناعس الأجفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1526&r=&rc=9",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""]],"verses":[["أَوهَنَت مِنهُ اللَيالي فَقرَةً","لا يُلاقي وَهنَها اليَومَ جُبارا",0,"ر",2,0],["أَوهَت أَكُفُّهُمُ بَيني وَبَينَهُمُ","فَتقاً بِغَيرِ العَوالي قَلَّ ما نُصِحا",1,"ح",2,0],["أوْهى مَعاقِدَها وأطْفأَ نارَها","قبلَ انْتِشارِ لَظىً وبعْدَ وَقودِ",2,"د",1,0],["أوْ هَلْ يَحِنُّ عَلَى نَفْسِي مُعَذِّبُهَا","أوْ هَلْ يَرِقُّ لِقَلْبِي قَلبِيَ الثَّانِي",3,"ي",1,0],["أَوْهَى الكَوَاهِلِ يَقْوَى الاِرْتِيَاضُ بِهَا","حَتَّى يَعِزَّ الحِمَى مِنْهَا بِأَرْكَانِ",4,"ن",1,0],["أَوْ هَلْ أَذَابَ سِوَاكَ مِنْ تَدْقِيقِهِ","فِيهَا سُوَيْدَاءَ الفُؤَادِ المُغْرَمِ",5,"م",1,0],["أو هل الشرق وحده في الأقالي","م مباح أن يُستبى ويضاما",6,"م",2,0],["أو هل القوم عاهدوا الله في أن","لا يراعوا للمسلمين ذِماما",6,"م",2,0],["أوْهَمَ العينَ أنه أخطأ المَضْ","رِبَ هذَّاً وقد مَضَى المضْروبُ",7,"ب",1,0],["أو هامس يُكذِبُني أو هامسه","عزَّ القضاءُ الأيديَ المُخالسه",8,"س",2,0],["أوهى معاقدَ صبره كُلَفٌ","لم يوهه يوماً تمتُّعُهُ",9,"ع",2,0],["أَو هِقلَةٌ مِن نَعامِ الجَوِّ عارَضَها","قَردُ العِفاءِ وَفي يافوخِهِ صَقَعُ",10,"ع",1,0],["أَو هَيَّبانٌ نَجيبٌ نامَ عَن غَنَمٍ","مُستَوهِلٌ في سَوادِ اللَيلِ مَذؤوبُ",11,"ب",1,1],["أوهنته الحادثات هوى","وهو خفاق على الوهن",12,"ن",1,0],["أَوهى جَناحَيهِ الحَدي","دُ وَحَزَّ ساقَيهِ الحَرير",13,"ر",1,0],["أَو هارِباً أَو طالِباً أَو راغِباً","أَو راهِباً أَو هالِكاً أَو نادِبا",14,"ب",2,0],["أَوهِ بَديلٌ مِن قَولَتي واهاً","لِمَن نَأَت وَالبَديلُ ذِكراها",15,"ا",3,1],["أَوهِ لِمَن لا أَرى مَحاسِنَها","وَأَصلُ واهاً وَأَوهِ مَرآها",15,"ا",3,0],["أَوهَمتُها صَمَماً في مَسمَعي فَغُدَت","تُكَرِّرُ اللَفظَ أَحياناً وَتَبتَسِمُ",16,"م",1,1],["أو هكذا الدنيا وذاكَ مآلُهَا","أسفاً لغادرةٍ كلمعِ سرابِ",17,"ب",1,0],["أو هكذا الدنيا وذاك مآلُهَا","أوَ ذاكَ وعدُ خيالِهَا الكذابِ",17,"ب",1,0],["أو هذا السرور من ذكر الما","ضي تسميه بالعذاب المبين",18,"ن",1,0],["أوَ هذا كلّه من لِمّةٍ","أبْصَرَتْ فيها بياضَ الشيبِ لاح",19,"ح",1,0],["أوهمتُهُ برشْفِ ريقِ الثغرِ","وغصتُ في البحر ابتغاءَ الدرِّ",20,"ر",1,0],["أو هو بحرٌ مِنْ حياةٍ طما","يُزجى إلى ساحلِهِ العنبرُ",21,"ر",1,0],["أَو هَل يُغَنّي لِشَجوِهِ فَبَكى","كَما تَغَنّى لِشَجوِهِ عَمَرُ",22,"ر",1,0],["أَو هِلالٌ بَدا لَنا","وَسطَ زُهرِ الكَواكِبِ",23,"ب",1,0],["أَوهْىَ قُوايَ وهَدَّ اليومَ من هِمَمي","داءٌ أراهُ شديدَ الفَتْكِ قتّالا",24,"ل",2,0],["أَو هُدبُ حُلَّتِهِ في السِلمِ يَلبَسُها","وَهَذِهِ في الوَغى سَردٌ يُدَرَّعُهُ",25,"ع",2,0],["أَو هَبي لي صَبراً أَرُدُّ بِهِ الدَم","عَ فَإِنّي أَخافُ دَمعي عَلَيكِ",26,"ك",1,0],["أوْ هُوَ النحلُ قَرْصُهَا يَجْلُبُ الحَت","فَ إليها وما له إنْكَاءُ",27,"ا",2,0],["أَوهَبَ مِنهُ لِذي أَثرٍ وَسابِغَةٍ","وَقَينَةٍ عِندَ شَربٍ ذاتِ أَشكالِ",28,"ل",1,0],["أوه إن الفراق أصعب من كُل","لِ عذابٍ يشقى به الموزور",29,"ر",1,0],["أوه من ألاّ أرى محاسنها","وأصل واهاً وأوه مرآها",30,"ا",3,0],["أَوْهَنْتِ عَزْمِي وَهْوَ حَمْلَةُ فَيْلَقٍ","وَحَطَمْتِ عُودِي وَهْوَ رُمْحُ طِرَادِ",31,"د",1,0],["أَوْهَتْ رُجُومُ الْغَيْبِ أَضْلاعُهُ","لَكِنْ نَبَتْ عنْ نَفْسِ مُسْتَكْبِرِ",32,"ر",1,0],["أَو هَب لَهُ النَومَ وَمُر","طَيفَكَ يُخبِر خَبَرَك",33,"ك",1,0],["أَوْ هَزَّ شَيْطَانُهُ أَوتَارَ مَنْطِقِهِ","فَاخْشَ الأَتِيَّ وَحَاذِرْ صَوْلَةَ العُبُبِ",34,"ب",1,0],["أو هل تُرَى ابن أبي ربي","عةَ بعد غيبتِه حضر؟",35,"ر",1,0],["أوهمتني فجوةٌ واحدةٌ","أنَّ في فيَّ تضاريسَ عِظاما",36,"م",2,0],["أو هذا .. الذي انتهيت إليه ؟","مجدك الآن .. قنب .. وغبار",37,"ر",1,0],["أوَ هل يعود إلى العرو","بة ذلك المجد الأثيلُ",38,"ل",1,1],["أو هل تغنى لشجوهِ، فبكى ،","كما تغنى لشجوهِ عمر؟",39,"ر",1,0],["أَوْ هَكذا زَعَمُوا! وَجِيءَ بِهِ إلى","بَلَدي الْجَريحِ عَلَى يَدِ الأَعْوانِ",40,"ن",1,0],["اوهن الصد وطيشا","للاداني احسنا",41,"ن",2,0],["أَوَ هَلْ يستوى الخضمُّ ومَن لا","يُمْتَرى مِن يمينه قطُّ نَهْلُ",42,"ل",1,0],["أوهِ ألَم يُكتَب هذا القَلم","إِلا بأن يَشكو الأسى والألم",43,"م",1,1],["أو همه الواشي بما يفتري","مختلفاً فأوه ما أوهما",44,"م",2,0],["أو هارب منه قد قامت قيامته","فطار في الأفق لا يلقى له أثرا",45,"ر",2,0],["أَو هاجَروا في الأَرضِ فَهيَ عَريضَةٌ","فَالتّيهُ خَيرٌ مِن حِمى الأَحساءِ",46,"ا",2,0],["أو هذهِ لبستْ من ليلها حُللاً","ومن كواكبها زرتْ بأزرارِ",47,"ر",1,0],["أَوهى مُقارَعَةُ الأَعادي أَدمَها","فيها نَوافِذُ مِن جِراحٍ تَنبَعُ",48,"ع",1,0],["او هام به جبل لهوى","مما بالهجر يهدده",49,"د",2,0],["أو هيكل نصبوه من","عظم بوسط بسابس",50,"س",1,0],["أو هَزَزْناك للخطوبِ هَزَزْنا","شَفْرَةَ الصّارِم الحُسامِ الصَّقيل",51,"ل",1,0],["أوهمتني من رِقَّة العُذْر","أنّ الوفاء يكون بالغَدْرِ",52,"ر",1,1],["أَو هَل يَليقُ بِمِثلِ جودِهِ أَن يَرى","حِرمانَ مَن أَمسى بِشُكرِكَ مُعلِنا",53,"ن",2,0],["أَو هارِبٍ ضاقَت عَليهِ بِرُحبِها ال","أَرضُ الفَضاءُ وَأينَ مِنكَ المَهرَبُ",54,"ب",1,0],["أَوْ هَمْزِهِ أَوْ غَمْزِهِ أَوْ لَمْزِهِ","أَوْ رَجْزِهِ أَوْ رِجْسِهِ أَوْ نَجْشِهِ",55,"ش",2,0],["أَوهمُوهُ أن الذكاءَ ثراءٌ","فمضى يَسحبُ الذيولَ اغترارا",56,"ر",2,0],["أَو هَزَّ في الهَيجاءِ أَسمَرَ ذابِلاً","إِلّا وَآلَ بِرأسِ طاغٍ مُثمِرا",57,"ر",2,0],["أَو هَل أَديب يَحيي لَنا بِالغروس","ما كانَ أَحلى",58,"ل",2,0],["أوَ هُم عبادُكَ وحدَهُم لِتُعزَّهم","وتُذِلَّنا أم طِينُهم ممتاز",59,"ز",1,0],["أو هل تصحُّ خلافةٌ وإمامةٌ","حيثُ الفرنجةُ واليهودُ قيام",60,"م",1,0],["أو هوجم الليثُ حَمَى","أَشبالَه في غيله",61,"ه",1,0],["أَو هَل تَرَينَ الدَهرَ عَرّى مَسَّهُ","إِلّا عَلى لَمَمٍ يَروحُ وَيَغتَدي",62,"د",2,0],["أو هات غيري للتجني والجفا","فأنا استجرت بذمة السلوان",63,"ن",1,0],["أو هو البعد حتى","نجتمع في اللحود",64,"د",1,0],["أو هكذا أمضى وما","بلّغتُ من أملي مداه",65,"ه",1,0],["أَو هل نَسيب لدو اللموت أَو عميت","عَيناكَ عن واضِع نعشا وَمُحتَمل",66,"ل",1,0],["أوهَتْ رزيئةُ هذا منّةً وأَتَتْ","أيّامُ هذا فأهدَتْ قُوّةَ المنَن",67,"ن",1,0],["أَو هَز مِن آرائِه صارِماً","أدنَى حلُولَ الأَجلِ الآجِلِ",68,"ل",1,0],["أوهانيَ الواهي الضَّعيفُ","والفَتكُ من طَرفٍ طَريفُ",69,"ف",1,1],["أوهَّابيَّةٌ، والحقُّ شمسٌ","يبدِّد نورُها الليل الطَّويلا؟",70,"ل",2,0],["أوهمتني أني سواك به","وبمثل هذا كتبكم تُنْبِي",71,"ب",2,0],["أَو هَل يباريك السَحاب وَجوده","ماء وجود يَديك بالعِقبانِ",72,"ن",1,0],["أَوَ هَل يُريد الجود بَعدَ يَمينِهِ","وَهوَ النِهايَة في العُلوِّ نزولا",73,"ل",2,0],["أوهَتْ خطوبُ الدهرِ من","هِمَمِي وفلَّتْ حدَّ عَزمي",74,"م",2,0],["أوْهَنَتْه أثْقال وِزرٍ ثقيل","إنَّ ضُعْفَ القُوى وفقدانَ عَوني",75,"ي",1,0],["أو هز أقلامه قالت كتائبها","ما السيف أصدق أنباءً من الكتبِ",76,"ب",1,0],["أو هاتها حمراء كوجنة شادنٍ","للَه من أجفانه للَه",77,"ه",1,0],["أو هزّ خطيّا فهذا واقع","فوق الثرى خوفاً وذا فرّارُ",78,"ر",1,0],["أو همت بظبي أو بدر","فجمالك كلهما عمّا",79,"م",2,0],["أو هز لدنا اسمراً","خلت ابن معدي او غثم",80,"م",1,0],["أو هزّ لدنا ترى الأعداء هاربة","ما بين منسفج منهم ومنهزم",81,"م",1,0],["أو هاب الهنائد كانسات","وقائد كل غيطاء اللجام",82,"م",1,0],["أو هو الثلج ذائب أو هو الكو","ثر يجري في حوض هذي الجنان",83,"ن",1,0],["أو هو الفجر والظلام اقاما","ساعة في الجبال يصطرعان",83,"ن",1,0],["أو هزت الألباب ثورة فنه","إلا وأرضخه إلى تعليمنا",84,"ن",2,0],["أُوهِمُ العينَ منه مَسحَ المُحيَّا","ومُرادي كَفٌّ الدموع الجواري",85,"ر",2,0],["أوهنت أيدها العفاةُ فقد ظا","هرتَ منها إلى نداك السُّبلا",86,"ل",2,0],["أو هما ولا شبه","العقيق والدرر",87,"ر",1,0],["أَوْهامَ مَصْروعِ الحَضي","ضِ إلى العُلى يتَطَلَّعُ",88,"ع",1,0],["أو هل تزور النار ساحة جنة","أجريت فيها من نداك الكوثرا",89,"ر",2,0],["أَوهَيتُ قَلبي عِندَ ذاكَ بِهُلكِهِ","وَالعَظمُ مِنّي ما حَييتُ كَسيرُ",90,"ر",1,0],["أو هَزَّكُم شَوقٌ لها أم هَزَّها","شَوقٌ إِليكَ وَرَحمَةٌ وَحَنَانُ",91,"ن",1,0],["أَوهَنَني حُبُّ مَن شُغِفتُ بِهِ","حَتّى بَراني وَشَفَّني الوَهنُ",92,"ن",1,0],["أو هي الظلُّ فسل عن شاخصٍ","هو منا دائماً أولى بنا",93,"ن",2,0],["أوهَمَتْنا طُولَ الحياة علينا","بَعْدَها إنَّ ساعةَ الصبرِ عامُ",94,"م",1,0],["أو هامتي قد كللت شيباً فمن","رهب اليس نهاب عزرائيلا",95,"ل",2,0],["أو هنأوك فبالحقيقة هنأوا","كرم السجايا قد حواه كريم",96,"م",1,0],["أَو هَت فَصاحَتُهُ الأَقوالُ أَمتَنَها","حَتّى تَكادُ عَلَيها تُؤَثِّرُ البَكَما",97,"م",2,0],["أوَ هَل مُجاري النّاسِ عِندَ قُروحِهِ","مَن حازَ خُصلَ السَّبقِ في أجذاعِه",98,"ع",2,0],["أو هَل تَزندَقَ أو تمجَّسَ","أو تَنَصَّرَ أو تَهَوَّد",99,"د",1,0],["أو هَل يَمانيُّ البَديعِ وَسَفحُهُ","خيَمٌ سَقاهُنَّ الهَوَى وَسَقاهُ",100,"ا",2,0],["أوهَى من الصَّبِّ وأكدَى","من الضَّبِّ وأعشى من فِراخ الدجاج",101,"ج",1,0],["أو هضم الدهرُ الظلو","م حقه لا يتعب",102,"ب",1,0],["أَو هِلالٍ قَلَّ شَخص لَمَحا","لَو نَضى أَثوابَهُ لَم يبنِ",103,"ن",1,0],["أَو هَزَّ خَطِّيَّه أَو سَلَّ صارمَهُ","رَأَيت كُلّاً قَصير العُمرِ وَالأَجلِ",104,"ل",1,0],["أوهى القوى منه تذكر أهله","عطشى وأعينهم إليه قيام",105,"م",1,0],["أو هل محا حاجة الأيام نضرتها","وهل تغير ذاك المنظر النضر",106,"ر",1,0],["أوهمتنا عيونُها دامعاتٍ","أنها البحرُ والمدى والشراعُ",107,"ع",1,0],["أوهب يوما للقا نسيم","على نبىّ جاءنا باليسر",108,"ر",1,0],["أوهمتها مدح السوى","فتميزت بالغيظ وهما",109,"م",2,0],["أو هدنوا بمهود هز أحبلها","كف من الكف في كوع من الكرم",110,"م",1,0],["أَو هَفى لِلرِّيحِ غُصنٌ ناعِمُ","أَو شَدا بالشِّعرِ صَبٌّ هائِمُ",111,"م",1,0],["أو هيّبانٌ نجيبٌ نام على غنمٍ","مُستوهلٌ في سوادِ الليلِ مذؤوبُ",112,"ب",1,0],["أو هل يوفى الكيل بحرا طمى","أو هل يوفي القيس مسح الظلام",113,"م",1,0],["أو هل يوفي الحرب سر العلا","والسفل او تحصى معاني الكلام",113,"م",1,0],["أو هل يشابه راس الطير طائره","أو يعادل عنقا مغرب الفيل",114,"ل",1,0],["أو هل يوفى بذرع الكون ذراعه","أم تضبط البحر بالكيل المكاييل",114,"ل",1,0],["أو هزير يصول فوق جواد","أبيض اللون ألحف النوارا",115,"ر",2,0],["أو هزت الشمأل أغصانها","فانتثر الطلّ بواديها",116,"ي",3,0],["أوهت قواها يوم منعرج اللوى","لفتات مياس القوام رطيب",117,"ب",1,0],["أو هل تظنّ بأن مولودي الذي","قد جاء ينسيني هوى الأسياد",118,"د",1,0],["أو هزَّ أقوم اسمر أو سلّ ما","ضي ابتر خشيت سطاه اسودُ",119,"د",1,0],["أَوْهَمْتَ نُصْحاً لو أَنَّ النُّصح مقبولُ","لا أُلْهَينَّكَ إِنِّي عنكَ مَشْغولُ",120,"ل",1,1],["أوهننا حبها وتيمنا","حتى برانا وشفنا الوهن",121,"ن",1,0],["أوهى قوى سبط النبي مصاب","وبه تقوت للضلال دعائم",122,"م",1,0],["او هل يفيد الاصل مثلك فاخرا","ولو انتميت به الى يقظان",123,"ن",1,0],["او هل نظرت من الحبيب غزالة","ليست تجر من الرقيب قرودا",124,"د",2,0],["أو هل تقاس الهضب بالطود الذي","لم تعمل الأرياح من زلزاله",125,"ل",2,0],["أَوهَنَ زندَيها وَأَكبادَها","قَرعُ المَنايا في الصَناديدِ",126,"د",1,0],["أو هل تميل لبانات اللوى فبها","تقضى لبانات قلب عاقر الوطر",127,"ر",1,0],["أو هل تزور حمى الزورا وتهتف في","غضا فؤاد بنار الهجر مستعر",127,"ر",1,0],["أوهت صفاة الإِسلام حادثةٌ","حقَّ لكلِّ الأنام تندبُها",128,"ب",3,0],["او همُ في اعتقادِ من سوف يجزو","ن بنار الجحيمِ ذات الضرامِ",129,"م",1,0],["اوهام جهل تدنّي النفسَ تسقطها","والجسم تَدنى القوى منه وبنيتُهُ",130,"ه",1,0],["أو هاشم ميرغني قال منتظماً","مدحاً وأَشند عُجبا فيك مبتدر",131,"ر",1,0],["أوهبوا عفواً وفضلاً كي أكن","أنا منظوماً مع الحزب الجلي",132,"ل",2,0],["أو هي المسك ينفُذ العَرف عنه","من وراء الأستار والحجُرات",133,"ت",1,0],["أوهمُ الطيب إذ يفوح أريجا","أنت مسك وأنت منه الذكاء",134,"ا",2,0],["أوهمُ النهرُ أو هم الطل فخرا","فلأنت العباب أنت الحياء",134,"ا",2,0],["أو هوت فوق يذبل لتداعى","هل ترى أن جلقاً تقواها",135,"ا",3,0],["أو هل تستطيع وجهة أرض","أن يضمّ العرش العظيم ثراها",135,"ا",3,0],["أَو هَل يكشف العظايم من ك","ل البرايا عنها سوى عظماها",135,"ا",3,0],["أو هل لأيَّامِ المسرّةِ عودةٌ","فلطالما مَطَلت وَفَاءَ عهودِها",136,"د",3,0],["أو هل تلجلج منطقي في حجة","لو كان تحت يد الفضاء خصام",137,"م",1,0],["أَوهى مَناكِبَها الحُلِيُّ كَأَنَّما","يَمشي الجَوادُ بِما عَلَيهِ مُقَيَّدا",138,"د",2,0],["أو هاء أو راء سوى جَضِمَ الفتى","أي صار يُكثرُ أكلَه إذ يَطعمُ",139,"م",1,0],["اوهى جلد العشاق فما","يغني الولهان تجلده",140,"د",2,0],["