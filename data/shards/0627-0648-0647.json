آسادا وأشبالا","https://www.aldiwan.net/poem41930.html","البسيط"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"شفعيني يا شر في رد نفسي","https://www.aldiwan.net/poem26780.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141033",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[99,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[31,"قد هاجَ أحزانَ قلبكَ الذكرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18906&r=&rc=169",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["أَوهَنَت مِنهُ اللَيالي فَقرَةً","لا يُلاقي وَهنَها اليَومَ جُبارا",0,"ر",2,0],["أَوهَت أَكُفُّهُمُ بَيني وَبَينَهُمُ","فَتقاً بِغَيرِ العَوالي قَلَّ ما نُصِحا",1,"ح",2,0],["أوْهى مَعاقِدَها وأطْفأَ نارَها","قبلَ انْتِشارِ لَظىً وبعْدَ وَقودِ",2,"د",1,0],["أوْ هَلْ يَحِنُّ عَلَى نَفْسِي مُعَذِّبُهَا","أوْ هَلْ يَرِقُّ لِقَلْبِي قَلبِيَ الثَّانِي",3,"ي",1,0],["أَوْهَى الكَوَاهِلِ يَقْوَى الاِرْتِيَاضُ بِهَا","حَتَّى يَعِزَّ الحِمَى مِنْهَا بِأَرْكَانِ",4,"ن",1,0],["أَوْ هَلْ أَذَابَ سِوَاكَ مِنْ تَدْقِيقِهِ","فِيهَا سُوَيْدَاءَ الفُؤَادِ المُغْرَمِ",5,"م",1,0],["أو هل الشرق وحده في الأقالي","م مباح أن يُستبى ويضاما",6,"م",2,0],["أو هل القوم عاهدوا الله في أن","لا يراعوا للمسلمين ذِماما",6,"م",2,0],["أوْهَمَ العينَ أنه أخطأ المَضْ","رِبَ هذَّاً وقد مَضَى المضْروبُ",7,"ب",1,0],["أو هامس يُكذِبُني أو هامسه","عزَّ القضاءُ الأيديَ المُخالسه",8,"س",2,0],["أوهى معاقدَ صبره كُلَفٌ","لم يوهه يوماً تمتُّعُهُ",9,"ع",2,0],["أَو هِقلَةٌ مِن نَعامِ الجَوِّ عارَضَها","قَردُ العِفاءِ وَفي يافوخِهِ صَقَعُ",10,"ع",1,0],["أَو هَيَّبانٌ نَجيبٌ نامَ عَن غَنَمٍ","مُستَوهِلٌ في سَوادِ اللَيلِ مَذؤوبُ",11,"ب",1,1],["أوهنته الحادثات هوى","وهو خفاق على الوهن",12,"ن",1,0],["أَوهى جَناحَيهِ الحَدي","دُ وَحَزَّ ساقَيهِ الحَرير",13,"ر",1,0],["أَو هارِباً أَو طالِباً أَو راغِباً","أَو راهِباً أَو هالِكاً أَو نادِبا",14,"ب",2,0],["أَوهِ بَديلٌ مِن قَولَتي واهاً","لِمَن نَأَت وَالبَديلُ ذِكراها",15,"ا",3,1],["أَوهِ لِمَن لا أَرى مَحاسِنَها","وَأَصلُ واهاً وَأَوهِ مَرآها",15,"ا",3,0],["أَوهَمتُها صَمَماً في مَسمَعي فَغُدَت","تُكَرِّرُ اللَفظَ أَحياناً وَتَبتَسِمُ",16,"م",1,1],["أو هكذا الدنيا وذاكَ مآلُهَا","أسفاً لغادرةٍ كلمعِ سرابِ",17,"ب",1,0],["أو هكذا الدنيا وذاك مآلُهَا","أوَ ذاكَ وعدُ خيالِهَا الكذابِ",17,"ب",1,0],["أو هذا السرور من ذكر الما","ضي تسميه بالعذاب المبين",18,"ن",1,0],["أوَ هذا كلّه من لِمّةٍ","أبْصَرَتْ فيها بياضَ الشيبِ لاح",19,"ح",1,0],["أوهمتُهُ برشْفِ ريقِ الثغرِ","وغصتُ في البحر ابتغاءَ الدرِّ",20,"ر",1,0],["أو هو بحرٌ مِنْ حياةٍ طما","يُزجى إلى ساحلِهِ العنبرُ",21,"ر",1,0],["أَو هَل يُغَنّي لِشَجوِهِ فَبَكى","كَما تَغَنّى لِشَجوِهِ عَمَرُ",22,"ر",1,0],["أَو هِلالٌ بَدا لَنا","وَسطَ زُهرِ الكَواكِبِ",23,"ب",1,0],["أَوهْىَ قُوايَ وهَدَّ اليومَ من هِمَمي","داءٌ أراهُ شديدَ الفَتْكِ قتّالا",24,"ل",2,0],["أَو هُدبُ حُلَّتِهِ في السِلمِ يَلبَسُها","وَهَذِهِ في الوَغى سَردٌ يُدَرَّعُهُ",25,"ع",2,0],["أَو هَبي لي صَبراً أَرُدُّ بِهِ الدَم","عَ فَإِنّي أَخافُ دَمعي عَلَيكِ",26,"ك",1,0],["أوْ هُوَ النحلُ قَرْصُهَا يَجْلُبُ الحَت","فَ إليها وما له إنْكَاءُ",27,"ا",2,0],["أَوهَبَ مِنهُ لِذي أَثرٍ وَسابِغَةٍ","وَقَينَةٍ عِندَ شَربٍ ذاتِ أَشكالِ",28,"ل",1,0],["أوه إن الفراق أصعب من كُل","لِ عذابٍ يشقى به الموزور",29,"ر",1,0],["أوه من ألاّ أرى محاسنها","وأصل واهاً وأوه مرآها",30,"ا",3,0],["أَوْهَنْتِ عَزْمِي وَهْوَ حَمْلَةُ فَيْلَقٍ","وَحَطَمْتِ عُودِي وَهْوَ رُمْحُ طِرَادِ",31,"د",1,0],["أَوْهَتْ رُجُومُ الْغَيْبِ أَضْلاعُهُ","لَكِنْ نَبَتْ عنْ نَفْسِ مُسْتَكْبِرِ",32,"ر",1,0],["أَو هَب لَهُ النَومَ وَمُر","طَيفَكَ يُخبِر خَبَرَك",33,"ك",1,0],["أَوْ هَزَّ شَيْطَانُهُ أَوتَارَ مَنْطِقِهِ","فَاخْشَ الأَتِيَّ وَحَاذِرْ صَوْلَةَ العُبُبِ",34,"ب",1,0],["أو هل تُرَى ابن أبي ربي","عةَ بعد غيبتِه حضر؟",35,"ر",1,0],["أوهمتني فجوةٌ واحدةٌ","أنَّ في فيَّ تضاريسَ عِظاما",36,"م",2,0],["أو هذا .. الذي انتهيت إليه ؟","مجدك الآن .. قنب .. وغبار",37,"ر",1,0],["أوَ هل يعود إلى العرو","بة ذلك المجد الأثيلُ",38,"ل",1,1],["أو هل تغنى لشجوهِ، فبكى ،","كما تغنى لشجوهِ عمر؟",39,"ر",1,0],["أَوْ هَكذا زَعَمُوا! وَجِيءَ بِهِ إلى","بَلَدي الْجَريحِ عَلَى يَدِ الأَعْوانِ",40,"ن",1,0]]}