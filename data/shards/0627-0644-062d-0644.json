{"poems":[[88,"ماذا ادخرت لهذا العيد من أدب","https://www.aldiwan.net/poem68957.html","البسيط"],[37,"حي المنازل قد عفت أطلالها","https://www.aldiwan.net/poem39103.html","الكامل"],[95,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[215,"شادن قد وفى فأسكر روحا","https://www.aldiwan.net/poem46593.html","الخفيف"],[230,"الحلو لما انعطف","https://www.aldiwan.net/poem55082.html","عموديه"],[303,"يا ليتني لما شرب","https://www.aldiwan.net/poem36797.html","عموديه"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[412,"الحلم أولى بمن شابت ذوائبه","https://www.aldiwan.net/poem50201.html","البسيط"],[443,"في طول عمرك عمن قد مضى خلف","https://www.aldiwan.net/poem2602.html","البسيط"],[520,"بان العزا وفؤادي ماله جلد","https://www.aldiwan.net/poem12086.html","البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53756","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122670","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122662","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86905","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64075","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112819","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35779","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52034","الكامل"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111231","الكامل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128102","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137392",""],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133990","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61268","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125913","الكامل"],[4701,"في آخر السطر","https://www.poetsgate.com/ViewPoem.aspx?id=207126",""],[4755,"كُله جشائب","https://www.poetsgate.com/ViewPoem.aspx?id=191418",""],[4767,"أكياسنا","https://www.poetsgate.com/ViewPoem.aspx?id=214166",""],[4797,"ماهوب كفو الوقت حبك يمحّيه","https://www.poetsgate.com/ViewPoem.aspx?id=50259",""],[4852,"الحلم بحر","https://www.poetsgate.com/ViewPoem.aspx?id=214431",""],[4869,"الجواكر","https://www.poetsgate.com/ViewPoem.aspx?id=151668",""],[4902,"ان حكت","https://www.poetsgate.com/ViewPoem.aspx?id=18515",""],[4916,"حلم الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=135376",""],[4978,"ماذا دهاك فلا تقوى على الكلم؟","https://www.poetsgate.com/ViewPoem.aspx?id=177181",""],[5002,"تلك المشاعر....","https://www.poetsgate.com/ViewPoem.aspx?id=215972",""],[5026,"بوابة تطل على الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=210777",""],[5118,"السدرة والريح","https://www.poetsgate.com/ViewPoem.aspx?id=129801",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5219,"اهات حرف","https://www.poetsgate.com/ViewPoem.aspx?id=194919",""],[5272,"حلم صغير","https://www.poetsgate.com/ViewPoem.aspx?id=202108",""],[5285,"الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=203649",""],[5419,"عذراً رسولَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=32217",""],[5431,"لايحمل العشق الا الموت عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=195352",""],[5431,"قلبٌ من الحلوى ..لحبيبي رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=206463",""],[5736,"نسرينتي","https://www.poetsgate.com/ViewPoem.aspx?id=203850",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5843,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=51282",""],[5881,"وفي خيالي تغطس","https://www.poetsgate.com/ViewPoem.aspx?id=183817",""],[5956,"يُقيم مبادرات باسلات","https://www.poetsgate.com/ViewPoem.aspx?id=193203",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6140,"كلّ عروسٍ حسنٍ وَجههَا","https://www.poetsgate.com/ViewPoem.aspx?id=191678",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""]],"verses":[["الحِلمُ حِليَتُهُ وَالعَدلُ قِبلَتُهُ","وَالسَعدُ لَمحَتُهُ كَشّافَةَ الكُرَبِ",0,"ب",1,0],["الحِلمُ أَثبَتُ مَنزِلاً في صَدرِهِ","مِن هَضبِ صِندِدَ حَيثُ حَلَّ خَيالُها",1,"ل",3,0],["أَلحِلْمُ مَا تَجْلُو صَبَاحَةٌ وَجْههِ","وَالعَزْمُ مَا تَذْكُو بِهِ العَيْنَانِ",2,"ن",1,0],["الحلم ثبطه عن ثأر واتره","وَما الحليم بمأمونٍ على الغضب",3,"ب",1,0],["الحِلْمُ حِلْمُكِ إِنْ بَاهَى المُلُوكُ بِهِ","حَاشَاكِ أَنْ تَزْهَدِي فِي البِرِّ حَاشَاكِ",4,"ك",1,0],["الحلو في مرّه بالشعر أبهرهُ","فيغتدى وهو في المرين حلوان",5,"ن",1,0],["الحلو لما انعَطف","أخجل جميع الغصون",6,"ن",1,1],["الحلوُ يجرح والدلا","لُ عَلى ملاحتِه يعنّي",7,"ن",2,0],["الحَليم الَّذي هُوَ البَحر حلماً","وِرده العَذب قَد وَرَدنا زلاله",8,"ل",2,0],["الحِلمُ أَولى بِمَن شابَت ذَوائِبُهُ","وَالحَمدُ أَحرى بِمَن دامَت تَجارِبُهُ",9,"ب",2,1],["الحلم والصبر لولاكم لما عرفا","وإنما الخلق من تباركم عرفوا",10,"ف",3,0],["الحلم أنذرني أني سأفقده","رأيت ذاك مراراً مالها عدد",11,"د",1,0],["الحِلمُ يُصمتهُ والعلمُ يُنطقُهُ","وفي تُقى اللّهِ ما يأتي وما يَذَرُ",12,"ر",1,0],["الحِلمُ والبَأسُ والسَّماحَةُ والعِفَّ","ةُ والاحتِرامُ والوَرَعا",13,"ع",2,0],["الحِلمُ والعِلمُ والإقدامُ فيهش مَعاً","والبِرُّ فيهِ وفيهِ الدّينُ والوَرَعُ",14,"ع",1,0],["الحلم طود راسخ","وَالجُود بحر زاخر",15,"ر",1,0],["الحلمُ والعُدمُ خيرٌ أم يُقالُ له","لا كان ما كان أغناهُ وأحمقَه",16,"ق",2,0],["الحليم المجيب من قد دعاه","رحمة البر والجزيل المداد",17,"د",1,0],["الحِلمُ يَملُكُهُ لَدى سَطَواتِهِ","وَالجودُ يَملِكُ كَفَّهُ وَنَوالَها",18,"ل",3,0],["الحِلمُ فِيكَ سَجِيةٌ معروُفَةٌ","يَا خَيرَ مَن يُولِي الجَمْيِلَ إذا غَلَبْ",19,"ب",1,0],["الحلم من اطوادها والعلم من","أسرارها والجود من آثارها",20,"ر",3,0],["الحلم والعلمُ والمعروف والعدلُ","مثلُ الطَّبائع إذ همُ للعلا أصلُ",21,"ل",1,1],["الحلم من أخلاقه والعلم من","عشاقه والفضل أشهر من علم",22,"م",1,0],["الحلو والمزّ ومنه القابض","وتَفِه وعافص وحامض",23,"ض",1,0],["الحلم يبدو في اقتدار وسطوة","بعفو توالي بالمراحم جوده",24,"د",2,0],["الحلُّ وَالتِرحالُ في","كَ إِلَيكَ إن رحلوا وحلّوا",25,"ل",3,0],["الحَليفَين حَيثُ كانا فَكُلٌّ","مِنهُما لائِذٌ بِرُكنٍ شَديدِ",26,"د",1,0],["الحلمُ أنت مثالُه والجودُ أنت","مآلُهُ والعدلُ القسطاس",27,"س",1,0],["الحلمُ والنُّبل والإيثار عن كرمٍ","والعزمُ والحزمُ والإقدامُ والأنفُ",28,"ف",1,0],["الحُلْمُ فِينا جُرْحٌ عَمِيقٌ","إنْ لَم يُطَبَّبْ فاليَأسُ غَالِبْ",29,"ب",1,0],["الحلم والعقل لها زينة","بالحلم للجهل غدت عائفة",30,"ف",2,0],["الحلم ياتيني بزولك واراعيه","وفي كل حلم اقوم قبل اتحفاه",31,"ا",2,0],["الحلمُ كالبحرِ تُغْرِي النَّفس َ زُرقتُه","وغيمُ لقياهُ لم يوصدْ لهُ بابا\"",32,"ب",2,1],["الحَلوه اللي تنكشف للملآيين","ما اظن يآكلهآ من الخلق طآهر",33,"ر",1,0],["الحلا يا حلوتي شبّه بكي","منهكٍ حرفي ويشكي به قصور",34,"ر",1,0],["الحلم ميّت / والمعاذير / الاقدار","والصبح فارق محجر العين نوره !",35,"ر",2,0],["الحلم لي ؟ وشمول الفكر تزعمه","حسبي هموميَ مما جئتَ، لا تلًمِ",36,"م",1,0],["الحلمُ فصلٌ مِن َالأعمارِ نَعْشَقُهُ","إذا انْقضَى فالدُّنى بِيدٌ بسُكناها",37,"ا",3,0],["الحُلمُ يعْمُرُ لي الصروح على المنى","وإذا صَحوتُ فَكُلُّ صَرْحٍ دِمْنَهْ",38,"ن",2,0],["ال حِلم ضامر من ردى حظي الجاف","__________ والصبر ./ سِدرة واحتطبها جفافي",39,"ف",2,1],["الحلم مقتلة لهم","ومديحهم لعن وسب",40,"ب",1,0],["الحلم يعتل الكدور صفا","والنزق ينتهل الصفا كدرا",41,"ر",2,0],["الحلم راودني دهرا أطارده","مثل السراب بدا من كذبه وهم",42,"م",1,0],["الحلمُ ياولدي أبوابُهُ كَثُرتْ","فالبسْ لحلمكَ صدقَ القولِ تأتيهِ",43,"ي",2,0],["الحُلمُ فينا تائهٌ رغمَ الحنين","يأبي خُروجاً مِنْ حياةِ الحائرينْ",44,"ن",1,1],["الحِلمُ كان أساساً فوقه ارتفعتْ","دعائمُ الدينِ في عزٍّ وفي غلبِ",45,"ب",1,0],["الحلم مرتبة الأخيار يبلغها","شخص برفعته يهديك غفرانا",46,"ن",2,0],["الحلم والعقل قنديلان من عبقٍ","في الغار ضوءهما كشفٌ على الفحوى",47,"و",2,0],["الحلمُ باتَ مقطّعا أوصاله","من ذا لحلمِ ضائعٍ كي يُحضنا",48,"ن",2,0],["الحُلوةُ يبدِلُها أحلى","إنّ الفحلَ يهدُّ المقحمْ!",49,"م",1,0],["الحلم يامعري ٍ صدر امنياتي وانت سداد","ماشح لدن الغصون من الرجى والصبح توه",50,"و",2,1],["الحلم وسواسٌ يداعب أنفساً","تشكو الحياة وفي أساها تحبس",51,"س",1,0],["أُلح لكي يعود إلى حُضوني","ولم تزلِ الأماني في التهابِ",52,"ب",1,0],["الحلم ، عدّه سيّد ،، لكل الأفعال","والصدق مفتا ح ٍ لكل الوعايد",53,"د",1,0],["الحلى مها مستعار لَهَا","وخمر كأسى حليها فِيهَا",54,"ه",2,0],["الحِلمُ والفضلُ في أخلاقه ارْتسَما","وفي حنايا يديه منبعُ الكرم",55,"م",1,0]]}