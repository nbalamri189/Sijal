{"poems":[[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[51,"الحرص لؤم ومثله الطمع","https://www.aldiwan.net/poem62152.html","المنسرح"],[7,"حدثوني بني الشقيقة","https://www.aldiwan.net/poem1975.html","الخفيف"],[7,"حَدِّثُوني بني الشَقيقَة ِ","https://www.poetsgate.com/ViewPoem.aspx?id=17585",""],[147,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[325,"يا سريا له السعادة وافت","https://www.aldiwan.net/poem67206.html","الخفيف"],[366,"آل بيت النبي ما لي سواكم","https://www.aldiwan.net/poem68119.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66705","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87127","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35803","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114026","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53232","الخفيف"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110652","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93797","الخفيف"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48310","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138472",""],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36539","الدوبيت"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119590","الرمل"],[4929,"فاقدُ الهمَّةِ ما صَعَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=204721",""],[5081,"مَنْ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=191363",""],[5137,"عد يا رفيق الروحِ","https://www.poetsgate.com/ViewPoem.aspx?id=101522",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5739,"من يسرق البلبل اجناحه","https://www.poetsgate.com/ViewPoem.aspx?id=126712",""],[147,"قَدْ كَفى اللَّهُ وَهْوَ نِعْمَ الْكَافِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27436&r=&rc=3",""]],"verses":[["مَن يَضجُرُ البَلوى فَغايَةُ جَهدِهِ","رُجعى إِلى الأَقدارِ وَاِستِسلامُ",0,"م",1,0],["مَن يَضِقِ الصَبرُ عَن مُصيبَتِهِ","ضاقَ وَلَم يَتَّسِع بِهِ الجَزَعُ",1,"ع",1,0],["مَن يَضُرَّ الأَدنى وَيَعجَزُ عَن ضَر","رِ الأَقاصي وَمَن يَخونُ الخَليلا",2,"ل",2,0],["مَنْ يضرّ الأدنى ، ويَعجزُ عن ضرّ","الأقاصي، ومن يخونُ الخَليلا",3,"ل",2,0],["مَن يُضِع أَمرَهُ فَإِنَّ إِمامَ ال","عَصرِ يَدري مَن يَصطَفي وَيُصافي",4,"ف",2,0],["مَن يُضاهيكَ في الوَجاهَةِ وَالعِ","زِّ وَفي فَضلِ بَيتِكَ المَعمورِ",5,"ر",1,0],["من يُضاهي فخاركم آل طه","وَعَليكُم سرادق العز ممتد",6,"د",1,0],["من يضيف الغريب قال عليّ","أنا للضيفِ انطلقْ مأجورا",7,"ر",2,0],["مَن يُضاهيه في عُلومٍ وَفضلٍ","وَفُنون وَفي مَقال قَويم",8,"م",1,0],["مَن يَضَع رِجلَهُ بِبابِ اِبنِ مَنصو","رٍ يَضَعهُ بِبابِ أَبيَضَ سامي",9,"م",2,0],["من يُضاهي عليَّا بن حسين بنِ","عليّ في عفةٍ وَصلاح",10,"ح",1,0],["من يضم الأرامل الشعث من بع","دك أم من يؤمه المسكين",11,"ن",1,0],["من يضاهيهم فحاراً ومجداً","لا يضاهي شمس النهار سواها",12,"ا",3,0],["من يضاهيك في انتساب جدود","منتهاهم عدنان جد نزار",13,"ر",1,0],["من يضاهي جدواه وهو حفيد","لولى النعماء ذات التوالي",14,"ل",2,0],["من يضاهي عزيز مصر افتخارا","وسنا المجد من معاليه ساطع",15,"ع",1,0],["من يضلل اللَه فلا هادي له","ومن بنور المصطفى قد أوصله",16,"ه",1,0],["مَنْ يَضرُّ العدوَّ جهراً اذا شا","ءَ وانْ شاءَ قادراً ضَرَّ خَتْلا",17,"ل",2,0],["مَنْ يُضاهي في الأرضِ يوسُفَ مَوْلىً","قد خبَرْنا تمْكينَهُ ومكانَهْ",18,"ن",2,0],["من يُضاهِيه يوسُفيَّ خِلالٍ","بيْنَ دُنْيا أعظِمْ بِها ودِيانَهْ",18,"ن",2,0],["من يضاهيك في انتساب الليه","صهره وابن عمه وأخوه",19,"و",2,0],["مَن يَضمَنُ لي إِلى المنى تَبليغا","لِلقَلب عَنِ الهَمِّ يَرى تَفريغا",20,"غ",2,1],["من يضارطني يضارط موسرا","يخرج الضرطة كالرعد القصف",21,"ف",1,1],["من يُضيِّعْ عمرَهُ هدَراً","ليتَه في الدهرِ ما وُجِدا",22,"د",2,0],["مَنْ يَضْرِبُ الْأَمْثَالَ فِي قُرْآنِهِ","لِلنَّاسِ كِي تَعِيَ الْبَيَانَ وَتَعْقِلَا ؟",23,"ل",2,0],["مَنْ يُضْحِكُ الْأَحْزَانَ فيْنَا بَعْدَمَا","غَابَ الَّذي فِيْهَا يُذَوِّبُ سُكَّرَا!!",24,"ر",2,0],["من يضغم باسل حبر أخى ثقة","وجهبذ ألمعي فاضل فطن",25,"ن",1,0],["من يضوع الند في ناديهم","وبه داعي الهدى في الدهر نادى",26,"د",2,0],["من يضمن البحر بهدوّه.!","هادي ويزعل من ارياحه.",27,"ح",2,0],["مَنْ يُضِعْ أَمْرَهُ فإِنَّ إِحَامَ العصْ","رِ يدري منْ يصطفي ويصافي",28,"ف",2,0]]}