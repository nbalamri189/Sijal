{"poems":[[55,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[74,"الله سخر لي وعائلتي","https://www.aldiwan.net/poem20029.html","أحذ الكامل"],[87,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[47,"لولا تعنفني لقلت المنزل","https://www.aldiwan.net/poem65578.html","الكامل"],[30,"يا ليت شعري هل أسيب ضمرا","https://www.aldiwan.net/poem5133.html","الكامل"],[63,"سدت سيوفك خلة الثغرين","https://www.aldiwan.net/poem51413.html","الكامل"],[108,"تقليد","https://www.poetsgate.com/ViewPoem.aspx?id=179377",""],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[505,"زر حيش لا تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[519,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48750","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124719","الكامل"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101398","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132579","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108301","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81696","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120193","الكامل"],[5191,"غزلٌ لا إراديّ","https://www.poetsgate.com/ViewPoem.aspx?id=212086",""],[5351,"عذاب اليوم..","https://www.poetsgate.com/ViewPoem.aspx?id=203746",""],[5461,"حنا العرب","https://www.poetsgate.com/ViewPoem.aspx?id=22531",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""]],"verses":[["اللَهُ سابَقَكُم إِلى أَرواحِها","وَكَسَبتُمُ الآثامَ في أَجسادِها",0,"د",3,0],["الله سخّر لي وعائلتي","من خفّ بي الإكرام والكرما",1,"م",2,1],["اللَهُ سَخَّرَ لِلكِنانَةِ خازِناً","أَخَذَ الأَمانَ لَها مِنَ الأَعوامِ",2,"م",1,0],["اللَهُ سَهَّلَ بِالخَليفَةُ جَعفَرٍ","مِن دَهرِنا ما لَم يَكُن يُتَسَهَّلُ",3,"ل",1,0],["اللَهُ سَخَّرَها بِكَفَّي خالِدٍ","وَلَقَد تَكونُ عَزيزَةَ الأَضرارِ",4,"ر",1,0],["اللهُ سَرَّكَ في أخيكَ ولم يَكُنْ","لِيَمِيْلَ عُرشُ العزِّ ذي الرُّكنَيْنَ",5,"ن",1,0],["الله ساقك للمُعَلِّم نجدةً","وبناك حصنًا للعلوم مئيدا",6,"د",2,0],["اللَه سلَّ به سيف المهابة لل","بُقيا وأصبح سيف البغي مغمودا",7,"د",2,0],["اللّه سربلكم بالملك مَصلحةً","للعالمين فمن ذا عنك نازعُهُ",8,"ع",2,0],["اللهُ سَرْبَلَ قَلْبَهُ بِعنايةٍ","لَبَسَتْ من الوَهْبِ العَليِّ الباسا",9,"س",2,0],["اللّهُ سخّرَها لهُ فجَموحُها","سَلِسُ القِيادِ لديهِ طوْعُ عِنانهِ",10,"ن",2,0],["اللّه سخر أرضه لعباده","ونهاهم أن يرهقوا ويسخِّروا",11,"ر",3,0],["الله سماه كلاماً فادعه","بدعائه في السر والإعلان",12,"ن",1,0],["اللَه سواها والهمها فهل","تنحو السبيل إلى المحل الأرفع",13,"ع",1,0],["الله سدد للعدى من رأيه","سهماً أصاب فحبذا التسديد",14,"د",1,0],["الله سامحكم أيا غصن النقا","وغدا فؤادك لي كقدك يعطف",15,"ف",1,0],["الله سيَّده فدام وإنَّما","يخشى البِلى ما الله ليس بشائِدِ",16,"د",1,0],["اللَّه سدده وشدده وأيده","وكان بما قضاه عليما",17,"م",2,0],["اللهُ سنَّ السحرَ في","عينيك... والدنيا سُننْ",18,"ن",1,0],["الله سيرهم إلينا كي نرى","فيهم عذاب اليوم قبل الآخرة",19,"ر",2,0],["الله سقانا من بحرنا عذوبه","وانهاركم مثل البحر هدر تنساب",20,"ب",1,0],["اللهُ سنَّ لنا شرعًا وبيَّنه","لمنْ أراد الهُدَى، مِن دونِه الظُّلَمُ",21,"م",1,0]]}