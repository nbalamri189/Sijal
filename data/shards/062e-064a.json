],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[76,"سرى طيف الحبيب على البعاد","https://www.aldiwan.net/poem39434.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85483","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140839",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16641","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16625","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16657","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10884","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20990","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42682","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55157","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54817","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54513","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55034","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67301","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43838","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[106,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[49,"النّاسُ في الدين والدّنْيا، ذوُو درَجِ،","https://www.poetsgate.com/ViewPoem.aspx?id=16973",""],[50,"خيرُ إخوانكَ المشاركُ في المرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=31053",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"غلّسَ الشّيبُ، أوْ تَعجّلَ وِرْدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32940",""],[45,"خَيرُ نَيلِكَ، إنْ أنَلتَ، الجِزيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=31800",""],[45,"خيَالٌ مُلِمٌّ، أو حَبيبٌ مُسَلِّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=32021",""],[45,"تَبَسَّمُ عَنْ واضِحٍ ذي أشَرْ،","https://www.poetsgate.com/ViewPoem.aspx?id=31246",""],[45,"أجد الوجد جمرة في ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=31275",""],[91,"لارفعن للسما احتجاجي","https://www.poetsgate.com/ViewPoem.aspx?id=52995",""],[51,"شغَلَ المُحبَّ عن الرسو","https://www.poetsgate.com/ViewPoem.aspx?id=30515",""],[6,"ولوَ أنَّ ما يأوِي إلَيَّ م","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14191&r=&rc=6",""]],"verses":[["خَيلٌ تَوَقَّحُ بِالنَجيعِ مِنَ الوَجى","وَقناً تَثَقَّفُ بِالطُلى وَالأَضلُعِ",0,"ع",1,0],["خِيامٌ قَصيراتُ العِمادِ كَأَنَّها","كِلابٌ عَلى الأَذنابِ مُقعِيَةٌ رُبدُ",1,"د",1,0],["خِياماً قَصيراتِ العِمادِ تَخالُها","كِلاباً عَلى الأَذنابِ مُقعِيَةً رُبدا",2,"د",2,0],["خَيرُ الهَوى ما نَجا مِنَ الكَمَدِ","وَعاشِقُ العِزِّ ماجِدُ الكَبِدِ",3,"د",1,1],["خَيرٌ مِنَ المالِ الَّذي يُعطيكَهُ","وَأَحَدُّ مِن غَربِ الحُسامِ الضارِبُ",4,"ب",1,0],["خَيْلٌ عِرابٌ فوْقَ أثْباجِها","في حَومَةِ الحَرْبِ أعاريبُ",5,"ب",1,0],["خَيلي وَفارِسُها لَعَم","رُ أَبيكَ كانَ أجَلَّ فَقدا",6,"د",2,0],["خَيْرِ خَلْقِ اللهِ فِي حَا","لٍ وفِي آتٍ وَمَاضِي",7,"ي",1,0],["خَيَّرْتَنِي بَيْنَ الْمُقَامِ أَو السُّرَى","وَالأَمْرُ يُفْصِحُ بِالْمَسِير وَيُعْرِبُ",8,"ب",1,0],["خَيرُ الصَنائِعِ في الأَنامِ صَنيعَةٌ","تَنبو بِحامِلِها عَنِ الإِذلالِ",9,"ل",1,0],["خَيرُ الشُهورِ اِختَرتَ عِندَ طُلوعِهِ","خَيرَ البِقاعِ لَهُ بِأَسعَدِ طالِعِ",10,"ع",1,0],["خَيرُ إِخوانِكَ المُشارِكُ في الأَم","رِ وَأَينَ الشَريكُ في الأَمرِ أَينا",11,"ن",2,1],["خَيرُ البَرِيَّةِ في قِرىً","صَخرٌ وَأَكرَمُهُم فِعالا",12,"ل",2,0],["خَيْرُ مَا يَأْتِي الذَكَاءُ بِهِ","هُوَ مَا يَأْتِي مِنَ الْقَلْبِ",13,"ب",1,0],["خَيْرُ أُمٍّ وَخَيْرُ زَوْجٍ","تَنْتَمِي لِخَيْرِ أَبْ",14,"ب",1,0],["خير ما توجد الروابط فيهم","إذ تكون الروابط الآلام",15,"م",1,0],["خَيْرُ مَا تُثْمِرُ المَحَاسِنُ فِي رَوْضِ","أَبٍ فَاضِلٍ وَأُم حُرَّهْ",16,"ر",2,0],["خَيْرُ الدُّعَاةِ إِلَى الوفاقِ عَلَى","مَا يَقْتَضِيهِ الشَّرْعُ وَالسُّنَنُ",17,"ن",1,0],["خَيْرُ الحِلَى مِنْ أدَبٍ وَطُهْرِ","وَمِنْ ذَكَاءٍ فِي بَنَاتِ العَصْرِ",18,"ر",1,1],["خَيْرُ أَوْلادِهَا لَدّيْهَا مَقَامَا","مَنْ رَعَى عَهْدَهَا وَصَانَ الذِّمَامَا",19,"م",2,0],["خَيْرُ الرِّفَاقِ رِفَاقُهُ وَبِمِثْلِهِ","وَبِمِثْلِهِمْ تَتَحَرَّرُ الأَقْوَامُ",20,"م",1,0],["خَيْرُ أُمٍّ لَوُلْدِهَا وَرَؤُومٌ","بَعْدَهُمْ لِلضِّعَافِ وَالأَيْتَامِ",21,"م",1,0],["خَيرُ المَآثِرِ لِلْبَرِ","يَّةِ حُسْنُ تَرْبِيَةِ السَّلِيلْ",22,"ل",1,0],["خيالٌ على بعد المزار أَلَمَّ بي","فأذكرني من لم أكن عنه ساليا",23,"ي",2,0],["خيرِ البريَّةِ مجتباها ذخرها","ظلَّ الإِلهِ الوارف الأفياء",24,"ا",2,0],["خيرتها بين المنى فوجدتها","أقصى مُناها أَنّها تُتَقَبَّلُ",25,"ل",1,0],["خير النساء أقلّها لخطيبها","مهراً وأكثرها إليه تحبُّبا",26,"ب",2,0],["خيال به رحنا نعلّل أنفساً","هز أن به لما رجعن إلى الحجر",27,"ر",1,0],["خَيلي الَّتي وَرَدَت نَجرانَ ثُمَّ ثَنَت","يَومَ الكِلابِ بِوِردٍ غَيرِ مَحبوسِ",28,"س",1,0],["خَيرِ حَيّ وَمَيّتٍ من بَنِي آ","دَمَ طُرَّاً مَأمُومِهم والإِمَامِ",29,"م",1,0],["خَيرُ مُستَرضَعٍ وَخَيرُ فَطِيمٍ","وَجَنِينٍ أُقِرَّ في الأَرحَامِ",29,"م",1,0],["خَيَارَ ما يَجتَوُن فيهِ إِذ ال","جَانُونَ في ذِي أكُفِّهم أَرِبُوا",30,"ب",3,0],["خيار ما يجتبون فيه اذا الجا","نون في ذي اكفهم أربوا",31,"ب",3,0],["خَيلٌ نُناجيهِنَّ كَيفَ شينا","طَيِّعَةٌ وَلَجمُها أَيدينا",32,"ن",2,0],["خَيرٌ مِنَ النَجاحِ لِلإِنسانِ","إِصابَةُ الرَأيِ مَعَ الحِرمانِ",32,"ن",1,0],["خَيلي وَإِن قَلَّت كَثيرٌ نَفعُها","بَينَ الصَوارِمِ وَالقَنا الرَعّافِ",33,"ف",1,0],["خَيرَ البَرِيَّةِ أَتقاها وَأَعدَلَها","إِلّا النَبِيَّ وَأَوفاها بِما حَمَلا",34,"ل",2,0],["خَيرَ البَرِيَّةِ إِنّي كُنتُ في نَهَرٍ","جارٍ فَأَصبَحتُ مِثلَ المُفرَدِ الصادي",35,"ي",1,0],["خيالٌ يزور أخير الدجى","فتحسبه مبتدا صبحه",36,"ح",2,0],["خير عيدٍ بكلِّ خيرٍ يعود","لك يا من لقاه للعيد عيد",37,"د",1,1],["خيلانها في جنةٍ","ولباسُهم فيها حرير",38,"ر",1,0],["خيولهم في الوغى للبيض راكضةٌ","وفي جفان القِرى كالبُدنِ تبترك",39,"ك",1,0],["خير الممالك في خير المواسم يا","خيرَ السلاطين يأتي خيرة الدول",40,"ل",1,0],["خير دار حلَّت بها خير دارٍ","يا سعيد الدارين يا ركن مله",41,"ل",2,0],["خيل تحاذي الصيد حيث مالا","كأنها أضحت له ظِلالا",42,"ل",2,0],["خيرُ ما فيهُم ولا خيرَ فيهم","أنهم غيرُ آثمي المُغتابِ",43,"ب",1,0],["خيلٌ عليهنّ آساد مدرّبةٌ","تأجَّموا الأسَلَ الخطِّيَّ لا القَصَبَا",44,"ب",2,0],["خَيْرُ جُرْثُومَةٍ وأنضْرُ فَرعٍ","بين هَذِي وذاكَ أنْجَبُ عُودِ",45,"د",1,0],["خَيَّبْتَني ثقةً بلؤمك إنه","لمن استعد لشاتمٍ لَعتادُ",46,"د",1,0],["خيرُ دارٍ حلَّ فيها","خيرُ أرباب الديار",47,"ر",1,0],["خيِّم على عَبر واقنع بها سِمةً","فيها لمثلك إن أنصفت مُقتصَر",48,"ر",1,0],["خيرُ ما استعصمتْ به الكف عضبٌ","ذكَرٌ حدُّهُ أنيثُ المَهَزِّ",49,"ز",1,1],["خيراً لهم من أن يروا بك حادثاً","مُستشنَعَ المرئيِّ والمسموع",50,"ع",1,0],["خير حديثٍ من أخٍ صدقُهُ","يا من أبت أعراقه وضعه",51,"ع",2,0],["خير أحوالك أن تس","لم من داء الحُلاق",52,"ق",1,0],["خِيريُّ ورد أتاك في طبقٍ","قد ملأ الخافقين من عبَقِهْ",53,"ه",1,1],["خيلٌ إذا أُسرجت أو أُلجمت لكُمُ","ذلَّ العزيزُ لإسراجٍ وإلجامِ",54,"م",1,0],["خيرُ الفُروع الباسقا","تِ سما به خيرُ