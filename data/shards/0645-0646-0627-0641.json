{"poems":[[88,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[27,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[27,"منا فتى الفتيان والجود معقل","https://www.aldiwan.net/poem5955.html","الطويل"],[27,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[72,"ملوز الطرف أهلا","https://www.aldiwan.net/poem20548.html","المجتث"],[43,"ألا لا أرى الأحداث حمدا ولا ذما","https://www.aldiwan.net/poem10543.html","الطويل"],[28,"لا بارك الله في قوم ولا شربوا","https://www.aldiwan.net/poem5627.html","البسيط"],[61,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30492","الطويل"],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[141,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[158,"نعم صب دمع الصب يا لائمي لولا","https://www.aldiwan.net/poem59059.html","الطويل"],[235,"أحاجيك عن تفاحة ذات بهجة","https://www.aldiwan.net/poem18127.html","الطويل"],[235,"من أفقر الخلق بذا الزمن","https://www.aldiwan.net/poem19296.html","السريع"],[280,"دع الحمى وليالي الضال والعلم","https://www.aldiwan.net/poem32450.html","البسيط"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[344,"وجاءت بها دهم البغال وشهبها","https://www.aldiwan.net/poem24110.html","الطويل"],[440,"منا فوارس قاتلوا عن سبيهم","https://www.aldiwan.net/poem1757.html","الكامل"],[447,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[466,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[480,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["من أفق فسطاطها في الشرق قد طلعت","شمس إذا غاب قرص الشمس لم تغِب",0,"ب",1,0],["مِنّا فَوارِسُ يَومِ الصَمدِ كانَ لَهُم","قَتلى وَأَسرى وَأَسلابٌ وَأَسلابُ",1,"ب",1,0],["مِنّا فَوارِسُ مَنعِجٍ وَفَوارِسٌ","شَدّوا وِثاقَ الحَوفَزانِ بِأُودا",2,"د",2,0],["مِنّا فَوارِسُ ذي بَهدى وَذي نَجَبٍ","وَالمُعلِمونَ صَباحاً يَومَ ذي قارِ",3,"ر",1,0],["مِنّا فَتى الفِتيانِ وَالجودِ مَعقِلٌ","وَمِنّا الَّذي لاقى بِدِجلَةَ مَعقِلا",4,"ل",2,1],["مِنّا فَوارِسُ لَن تَجيءَ بِمِثلِهِم","وَبِناءُ مَكرُمَةٍ أَشَمُّ طَويلُ",5,"ل",1,0],["من أفضل الناس نفساً","وأنفس الناس فضلا",6,"ل",2,0],["مَنافِعُها ما ضَرَّ في نَفعِ غَيرِها","تَغَذّى وَتَروى أَن تَجوعَ وَأَن تَظما",7,"م",2,0],["مُنافِقينَ اِستَحَلّوا كُلَّ فاحِشَةٍ","كانوا عَلى غَيرِ تَقوى اللَهِ أَعوانا",8,"ن",2,0],["منافرٌ نفَراً رثَّت حِبالُهمُ","وأنهجَ الجودُ فيهم أيَّ إنهاجِ",9,"ج",1,0],["مُنافِرةٍ للإِنْسِ تأنَسُ بالفَلا","مُفَرِّقةٍ للشَّهْدِ مِن بَعْضِها السُّمُّ",10,"م",1,0],["من أفْقها شعَّ البيان، وما الورى","دون البيان سوى هياكلَ، أو دُمى",11,"م",2,0],["مُنافِياً كُلَّ مَن تُخفيهِ هِمَّتُهُ","فَلَيسَ يُعرَفُ إِلّا حينَ يَنتَسِبُ",12,"ب",1,0],["منافيه مهلا فالمنى فيه فاستمع","إذا لم تقل فضلا لنيرانه فضلا",13,"ل",2,0],["مَنَافِعُهُ بَيْنَ الأَنَامِ شَهِيرَةٌ","عَلَى أَنَّهُ مِنْ أَجْلِهَا لَيْسَ يَمْدَحُ",14,"ح",1,0],["مِنْ أَفْقَرِ الْخَلْقِ بِذَا الزَّمَنِ","مِنَ ابْنِ زَاكُورٍ أَخِي الشَّجَنِ",15,"ن",1,1],["مُنافِسٌ في اِكتِسابِ المَجدِ دَيدَنُهُ","فَكاكُ عانٍ وَإِنقاذٌ مِنَ العَدَمِ",16,"م",1,0],["من اِفتراءِ الكَذبِ","في حزَنٍ وَطَرَبِ",17,"ب",1,0],["مُنافِيَّةً غَرّاءُ جادَت بِوُدِّها","لِعَبدِ مَنافِيٍّ أَغَرَّ مُشَهَّرِ",18,"ر",1,0],["منا فوارس قاتلوا عن سبيهم","يوم النسار وليس منا أشطر",19,"ر",1,1],["منافقون ولكن من سيردعهم","وأكثر القوم من صهبائه شربوا",20,"ب",3,0],["مِن أَفرُخٍ شامِيَّةٍ","ما شامَها إِلّا طِلابي",21,"ب",2,0],["منافح لو شمت لأنست لذائذ ال","وجود وما تاقت لعاصمتي كسرا",22,"ر",2,0],["منا فقد نرى البلاد كلها","بأسرها معا ومن قد حلها",23,"ه",2,0]]}