{"poems":[[90,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[29,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[29,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[29,"منا فتى الفتيان والجود معقل","https://www.aldiwan.net/poem5955.html","الطويل"],[29,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[74,"ملوز الطرف أهلا","https://www.aldiwan.net/poem20548.html","المجتث"],[45,"ألا لا أرى الأحداث حمدا ولا ذما","https://www.aldiwan.net/poem10543.html","الطويل"],[30,"لا بارك الله في قوم ولا شربوا","https://www.aldiwan.net/poem5627.html","البسيط"],[63,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30492","الطويل"],[108,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[164,"نعم صب دمع الصب يا لائمي لولا","https://www.aldiwan.net/poem59059.html","الطويل"],[242,"أحاجيك عن تفاحة ذات بهجة","https://www.aldiwan.net/poem18127.html","الطويل"],[242,"من أفقر الخلق بذا الزمن","https://www.aldiwan.net/poem19296.html","السريع"],[287,"دع الحمى وليالي الضال والعلم","https://www.aldiwan.net/poem32450.html","البسيط"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[351,"وجاءت بها دهم البغال وشهبها","https://www.aldiwan.net/poem24110.html","الطويل"],[448,"منا فوارس قاتلوا عن سبيهم","https://www.aldiwan.net/poem1757.html","الكامل"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[473,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[487,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138302",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122713","المنسرح"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88604","الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88613","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48815","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70964","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133802","السريع"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31568","المتقارب"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82285","السريع"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106709","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114730","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109391","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109426","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2246,"","https://poetry.dctabudhabi.ae/diwan/poem/116777","الوافر"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82976","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65992","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121858","الرجز"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53016","البسيط"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67795","الرجز"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45316","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[3591,"ظن الحبيب بأن الصب قد عدلا","https://www.poetsgate.com/ViewPoem.aspx?id=149380",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5608,"أحلا قصيد","https://www.poetsgate.com/ViewPoem.aspx?id=33532",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5956,"الله كرَّر لي نبيلِ ميشيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194195",""]],"verses":[["من أفق فسطاطها في الشرق قد طلعت","شمس إذا غاب قرص الشمس لم تغِب",0,"ب",1,0],["مِنّا فَوارِسُ يَومِ الصَمدِ كانَ لَهُم","قَتلى وَأَسرى وَأَسلابٌ وَأَسلابُ",1,"ب",1,0],["مِنّا فَوارِسُ مَنعِجٍ وَفَوارِسٌ","شَدّوا وِثاقَ الحَوفَزانِ بِأُودا",2,"د",2,0],["مِنّا فَوارِسُ ذي بَهدى وَذي نَجَبٍ","وَالمُعلِمونَ صَباحاً يَومَ ذي قارِ",3,"ر",1,0],["مِنّا فَتى الفِتيانِ وَالجودِ مَعقِلٌ","وَمِنّا الَّذي لاقى بِدِجلَةَ مَعقِلا",4,"ل",2,1],["مِنّا فَوارِسُ لَن تَجيءَ بِمِثلِهِم","وَبِناءُ مَكرُمَةٍ أَشَمُّ طَويلُ",5,"ل",1,0],["من أفضل الناس نفساً","وأنفس الناس فضلا",6,"ل",2,0],["مَنافِعُها ما ضَرَّ في نَفعِ غَيرِها","تَغَذّى وَتَروى أَن تَجوعَ وَأَن تَظما",7,"م",2,0],["مُنافِقينَ اِستَحَلّوا كُلَّ فاحِشَةٍ","كانوا عَلى غَيرِ تَقوى اللَهِ أَعوانا",8,"ن",2,0],["منافرٌ نفَراً رثَّت حِبالُهمُ","وأنهجَ الجودُ فيهم أيَّ إنهاجِ",9,"ج",1,0],["مُنافِرةٍ للإِنْسِ تأنَسُ بالفَلا","مُفَرِّقةٍ للشَّهْدِ مِن بَعْضِها السُّمُّ",10,"م",1,0],["من أفْقها شعَّ البيان، وما الورى","دون البيان سوى هياكلَ، أو دُمى",11,"م",2,0],["مُنافِياً كُلَّ مَن تُخفيهِ هِمَّتُهُ","فَلَيسَ يُعرَفُ إِلّا حينَ يَنتَسِبُ",12,"ب",1,0],["منافيه مهلا فالمنى فيه فاستمع","إذا لم تقل فضلا لنيرانه فضلا",13,"ل",2,0],["مَنَافِعُهُ بَيْنَ الأَنَامِ شَهِيرَةٌ","عَلَى أَنَّهُ مِنْ أَجْلِهَا لَيْسَ يَمْدَحُ",14,"ح",1,0],["مِنْ أَفْقَرِ الْخَلْقِ بِذَا الزَّمَنِ","مِنَ ابْنِ زَاكُورٍ أَخِي الشَّجَنِ",15,"ن",1,1],["مُنافِسٌ في اِكتِسابِ المَجدِ دَيدَنُهُ","فَكاكُ عانٍ وَإِنقاذٌ مِنَ العَدَمِ",16,"م",1,0],["من اِفتراءِ الكَذبِ","في حزَنٍ وَطَرَبِ",17,"ب",1,0],["مُنافِيَّةً غَرّاءُ جادَت بِوُدِّها","لِعَبدِ مَنافِيٍّ أَغَرَّ مُشَهَّرِ",18,"ر",1,0],["منا فوارس قاتلوا عن سبيهم","يوم النسار وليس منا أشطر",19,"ر",1,1],["منافقون ولكن من سيردعهم","وأكثر القوم من صهبائه شربوا",20,"ب",3,0],["مِن أَفرُخٍ شامِيَّةٍ","ما شامَها إِلّا طِلابي",21,"ب",2,0],["منافح لو شمت لأنست لذائذ ال","وجود وما تاقت لعاصمتي كسرا",22,"ر",2,0],["منا فقد نرى البلاد كلها","بأسرها معا ومن قد حلها",23,"ه",2,0],["من أفسدت أخلاقها حرية","أضحى بها جد الحليلة عاثرا",24,"ر",2,0],["مِن أفَضلِ الخَلقِ مِن بَني آدَمٍ","مَن فاضِلٌ ومَفضُولُ",25,"ل",1,0],["من أَفوه لو كان حد لسانه","سيفا لراعك من شباه مذلق",26,"ق",1,0],["من أفوه لسن يصيب","بحد مقوله خصيمه",27,"م",2,0],["منافعُ الناس بين الناس بالغةٌ","ما ليس تبلغهُ الآحادُ والجُمَع",28,"ع",1,0],["منافع جمعتهم في وثائقهم","قبل الذي يقتضيه الدينُ والنسب",29,"ب",1,0],["منافق كالضَّب لكنه","أخبثُ طبعاً منه بل أحْير",30,"ر",1,0],["من أفق تمضي إلى آخر","ذاهبة دائرة في الفضاء",31,"ا",2,0],["مَنافِعُها أَبداً جَمَّةٌ","لمالِكِها غيرَ قَوْلٍ كَذِبْ",32,"ب",1,0],["مُنافِقٌ ظاهِرُهُ ناسِكٌ","مُخالِفُ الباطِنِ لِلظّاهِرِ",33,"ر",1,0],["من أفصَحَ الحجرُ الأصَمُّ بِصِدقِهِ","وأجَابَهُ ذِئبُ الفَلاَةِ وَرِيمُها",34,"م",3,0],["مُنافٍ للحقيقة مُستريحٍ","إلى خُدَعِ الإحالةِ والمَجازِ",35,"ز",1,0],["من أفق مصر العلاقد كان مطلعه","والآن في روض بر الشام قد نزلا",36,"ل",2,0],["من أفق مجلاها لقد أشرقت","شموس أنس للنهى تسكر",37,"ر",1,0],["مِن أفضَلِ الأعمَالِ هَاتِيكَ الزِّيَا","رَةُ وَهيَ يَومَ الحَشرِ فِي المِيزَانِ",38,"ن",1,0],["منافسة العدوّ أو الصديق","تجرُّ إلى المذمة والملامة",39,"ه",1,1],["منافسةُ الفَتى فيما يَزولُ","على نُقصانِ هِمَّتِهِ دَليلُ",40,"ل",1,1],["مَنافِعَ للسارينَ من كُلِّ بَلدَةٍ","مِنَ الصينِ للسومالِ في البرِّ والبَحرِ",41,"ر",1,0],["منافقهم في كل وعد منافق","وعفّهم عف إذا لم يضمَّن",42,"ن",1,0],["مِن أفضلِ التَّصدُّقاتِ بِرَّا","جُهْدُ مُقِلٍ لفقِيرٍ سَرَّا",43,"ر",2,1],["من أفدح الأشرار أن يقضى على","حرم الإله بغارة الأشرار",44,"ر",1,0],["منافع القطر منه ضاءت","لها بنور النجاح عين",45,"ن",1,0],["مَنْ أَفْرِغَ الصبْرُ عَلَيْهِ زَانَهْ","أوْ غَلَبَ الجُبْنُ عَلَيْهِ شَانَهْ",46,"ن",2,0],["مَن أَفلَسِ الناسِ مِن دينٍ وَمِن حَسَبِ","وَأَظلَمِ الناسِ طُرّاً لِلمَساكينِ",47,"ن",1,0],["منافذ أوقعته بكل ضنك","وهم سبب الوصول إلى مقام",48,"م",1,0],["منافق كل أهل الأرض قد عرفت","نفاقة وبهذا عز من جهلا",49,"ل",2,0],["مُنَافِقٌ بِكِذْبِهِ وَ يَدَّعِي !","أَنَّ الحَقِيْقَةَ كَشَمْسٍ تُشْرِقُ",50,"ق",1,0],["من أفارق طيفك انتي .. لحظه حسيت بقهر","واشعر اني يا غناتي .. صرت فالدنيا وحيد",51,"د",1,0],["من أفق بيروت طارت نحو سدتكم","ترجو القبول إذا فازت بلقيا كا",52,"ك",2,0],["من أفضل الخبراء في مطروحهِ","مِن أرفع الدرجاتِ لا \"المقبولِ\"",53,"ل",1,0]]}