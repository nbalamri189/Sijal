{"poems":[[74,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[99,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[82,"أسهام مفوقات لرميي","https://www.aldiwan.net/poem31536.html","الخفيف"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[113,"هاك إبلى فيك المطي حثيثا","https://www.aldiwan.net/poem16300.html","الخفيف"],[199,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[214,"راح يرنو مرنح الاعطاف","https://www.aldiwan.net/poem13327.html","الخفيف"],[369,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[438,"دون بيض الخدور سمر العوالي","https://www.aldiwan.net/poem12694.html","الخفيف"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[469,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[563,"صح عندي في منزل الإختصاص","https://www.aldiwan.net/poem33546.html","الخفيف"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48564","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109384","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132343","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112583","الرمل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3476,"","https://poetry.dctabudhabi.ae/diwan/poem/98036","الوافر"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125939","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102955","الرمل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104529","الخفيف"],[4755,"جَوَّابُ العُصُور","https://www.poetsgate.com/ViewPoem.aspx?id=185155",""],[4800,"صياد","https://www.poetsgate.com/ViewPoem.aspx?id=104752",""],[5431,"كيف تنجو بخبثها الأشرارُ؟...","https://www.poetsgate.com/ViewPoem.aspx?id=211836",""],[5692,"صايح عند العصير إستهاضنا","https://www.poetsgate.com/ViewPoem.aspx?id=179113",""],[5841,"أبحرت في !! بحر الهوى !! ولقيت سناره","https://www.poetsgate.com/ViewPoem.aspx?id=34861",""],[6090,"قل لسكرى فليحيي آنا ليرنو","https://www.poetsgate.com/ViewPoem.aspx?id=170906",""],[6093,"لَمْ يَكُنْ يَجْهَلُ ذَاتَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=180649",""]],"verses":[["صائل الحسن إنْ رنا وتثنى","سلَّ أسيافه وهزَّ قناته",0,"ت",2,0],["صائد الدر تراه غارقاً في","صحف أو غائصاً في كتب",1,"ب",1,0],["صائباتٌ جميعُهَا فاتراتٌ","وَيْحَ قلبي ماذا يُعِدّ لقلبي",2,"ب",2,0],["صَائِلُ الْمَوْجِ كَالْفُحُولِ تَرَاغَى","مِنْ هِيَاجٍ وَتَرْتَمِي بِاللُّغَامِ",3,"م",1,0],["صائِباتُ الصُدورِ يَبدو إِذا أَق","عَينَ مِن كُلِّ مِرفَقٍ بَدَدُه",4,"د",2,0],["صَائِلاً فِي المَجَالِ كَرّاً وَفَرّاً","يَأْسِرُ اللُّبَّ بَيْنَ كَرّ وَفرِّ",5,"ر",1,0],["صَائِنِي دَارِهِمِ العَذْرَاءِ عَنْ","وَاطِيءٍ إِلاَّ وَمَا فِيَها مَوَاتُ",6,"ت",1,0],["صائِناً في حِماكَ عَذراءَ أَخجل","ت جَريراً بِحُسنِها وَالبَعيثا",7,"ث",2,0],["صائِمُ يَقصِمُ أَدنى أَمرِهِ","قَد بَرى جَبلَتَهُ عَسفَ الرِقابِ",8,"ب",1,0],["صائغ الحسن صاغ خاتم فيه","من عقيق وجوهر شفاف",9,"ف",1,0],["صائبُ الرّأيِ بَعيدُ المُنتهَى","طاهُرُ العِرْضِ حَميدُ الشيمتَين",10,"ن",1,0],["صائلٌ في العِدى بسيفينِ هذا","لجدالِ وذا لوَشْكِ قِتالِ",11,"ل",1,0],["صائحاً نادباً تُقرِّعُ حيناً","وتُربِّى بعقلك الجبار",12,"ر",1,0],["صائدٌ باللحظ إن قيل رنا","طاعن أن قيل انثنى",13,"ن",2,0],["صائب النبل إن رميتَ وإلا","كن مهيّاً لوقع هذا الرصاص",14,"ص",1,0],["صائمُ الحرّ قائمُ القرّ دأبا","حسَبَ المستجيد والمستفيد",15,"د",1,0],["صائلاً يضرب الرقاب بسيف","جائلاً بالقنا يشق الصدورا",16,"ر",2,0],["صائِبُ الرّأيِ سَديدٌ ما يرى","لا يُرى فيما يراهُ الدّهرَ قَدحُ",17,"ح",1,0],["صائِداً لِلشّمسِ مِن كَبدِ السّما","أَو سِواها كَالجَواري الكنَّسِ",18,"س",1,0],["صائِفَةٍ وَحمى تصدى لَهُ","كالقَوسِ من فارعَةِ الأَشكلِ",19,"ل",1,0],["صائلاً يرعب المنايا ونفس","الموت كادت بأن ينوب قواها",20,"ا",3,0],["صائب الآراء في الأخطار كم","ردَّ من جيش الأسا عنا جنودا",21,"د",2,0],["صائداتٍ ظُبى العُقُولِ بِدَلٍّ","طِبقَ حالٍ يُثيرُ للأشعارِ",22,"ر",1,1],["صائم طول الحياة","زاده تقوى الإله",23,"ه",1,1],["صائدو الأطيار من بين الحرم","لست مظلوماً فإني ظالم",24,"م",1,0],["صائدٌ تأمنهُ غِزلانه","مثل ما تَأمن غزلان الحَرَم",25,"م",1,0],["صائخا للحب لا يرعى سوى","عهده ذاك الاثيم المجرم",26,"م",1,0],["صائدا كل جميل أصيدا","بارزا في كل حرب أسدا",27,"د",2,0],["صائبات أفكاره حين ترمي","فكأن كل فكرة نشابه",28,"ب",2,0],["صائِدًا لِلبُرُوقِ مِن كُلِّ صَوبٍ","عائدًا بالدُّخَانِ مِن كُلِّ مَسرَى",29,"ر",2,0],["صاير هواوي وغادي طير بالوادي","فارد جناحه على دنياه وظباها",30,"ا",3,1],["صائدو الحبّ والمدى إعصارُ","وانقضاضٌ ورهبةٌ وفرارُ",31,"ر",1,1],["صائدو الخير أنتمُ شرّ قومٍ","غضب الله : ذلةٌ واحتقارُ",31,"ر",1,0],["صايح عند العصير إستهاضنا","يقول إن عمار خياله شيف",32,"ف",1,1],["صاير لها تامر وتنهي مثل عبّاره","يلعب بها قبطانها بافكار ملعونه",33,"ن",2,0],["صائد الغيد بالشراك فهلا","من شراك لها وهل من مصاد",34,"د",1,0],["صَائِمٌ عَنْ كُلِّ فُحْشٍ","حافِظٌ _ دَوْمَاً – صَلَاتَهْ",35,"ت",2,0],["صَائِنٌ للغِيْرِ قَدْراً","لَمْ يَكُنْ يَجْهَلُ ذَاتَهْ",35,"ت",2,0]]}