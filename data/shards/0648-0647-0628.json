لهزج"],[48,"حلت سعاد وأهلها سرفا","https://www.aldiwan.net/poem64408.html","الكامل"],[48,"تباعد ما استطعت من الشقوق","https://www.aldiwan.net/poem66603.html","الوافر"],[50,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[50,"وهبت له على المسواك ريقا","https://www.aldiwan.net/poem62297.html","الوافر"],[50,"أباهل إني للحروب عواد","https://www.aldiwan.net/poem63892.html","الطويل"],[50,"ألا يا صنم الأززد","https://www.aldiwan.net/poem64851.html","الهزج"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[46,"نقمت على الدنيا ولا ذنب أسلفت","https://www.aldiwan.net/poem22057.html","الطويل"],[46,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[8,"جهلت علي ابن الحيا وظلمتني","https://www.aldiwan.net/poem21816.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"أعطيته ما سألا","https://www.aldiwan.net/poem39032.html","مجزوء الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39661","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42703","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42730","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54864","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/19803","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43656","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43870","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1913","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[104,"يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=37408",""],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[77,"أما وخيال في المنام يزور","https://www.poetsgate.com/ViewPoem.aspx?id=34134",""],[90,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[0,"ألا عِمْ صَبَاحاً أيّهَا الطّلَلُ البَالي","https://www.poetsgate.com/ViewPoem.aspx?id=4731",""],[54,"نعوني ولما ينعيني غير شامتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14476",""],[45,"بَاكَرَتْنا بَوَاكِرُ الوَسْميِّ","https://www.poetsgate.com/ViewPoem.aspx?id=31661",""],[45,"مَنْ سَائِلٌ لمُعَذَّرٍ عَنْ خَطْبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31561",""],[45,"فَدَتْكَ أكُفُّ قَوْمٍ ما استَطاعوا","https://www.poetsgate.com/ViewPoem.aspx?id=31127",""],[51,"لعمري لقد غاب الرضا فتطاولتْ","https://www.poetsgate.com/ViewPoem.aspx?id=30457",""],[51,"بلغ البُغاة عليَّ حيث أرادوا","https://www.poetsgate.com/ViewPoem.aspx?id=27672",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""]],"verses":[["وَهَبَّت لِأَصحابي شَمالٌ لَطيفَةٌ","قَريبَةُ عَهدٍ بِالحَبيبِ بَليلُ",0,"ل",1,0],["وَهَبتُ لَهُ ظَهري عَلى عَقرِ غارِبي","فَكُلُّ زِمامٍ قادَني مِنهُ أَتبَعُ",1,"ع",1,0],["وَهَبتُ لِضَوءِ الفَرقَدَينِ نَواظِري","إِلى أَن بَدا فَتقٌ مِنَ الفَجرِ ساطِعُ",2,"ع",1,0],["وَهَبكَ اِتَّقَيتَ السَهمَ مِن حَيثُ يُتَّقى","فَمَن لِيَدٍ تَرميكَ مِن حَيثُ لا تَدري",3,"ر",2,0],["وَهَبنا لِفَيضِ الدُموعِ الخُدودَ","عَليكُم وَحَرَّ الغَرامِ القُلوبا",4,"ب",2,0],["وَهَبَت لَنا هَذا الحُسامَ المُنتَضى","فينا وَهَذي العِزَّةَ القَعساءَ",5,"ا",2,0],["وَهَبَّ صِحابي واجِمِينَ وَكُلُّهُم","يَقولُ أَلا لِلَّهِ نَفسٌ تَعَنَّتِ",6,"ت",1,0],["وهبّتْ عصافيرُ اللِّوَى فتكلّمَتْ","وجاوَبَها فوقَ الأراكِ حَمامُهُ",7,"م",2,0],["وهبّتْ بكَ الآمالُ بعدَ ضَياعِها","لَدى مَعْشَرٍ عنْ رَعْيِهِنَّ نِيامِ",8,"م",1,0],["وهَبْنيَ لا أرمي بطَرفي إلَيْهِما","فأذْكُرُها الشان في الشّمسِ والبَدْرِ",9,"ر",1,0],["وهَبَّ الغُلامُ العَبْشَميُّ بسَيفِهِ","إِلى جُنَّحِ الأضلاعِ مِيلِ الغَوارِبِ",10,"ب",1,0],["وهَبْها فارَقَتْهُ فأيُّ وادٍ","تُصادِفُ في مَذانِبهِ بِلالا",11,"ل",2,0],["وَهَبتُ لَها نَفسي فَضَنَّت بِوَصلِها","فَيا لَكَ مِن مُعطٍ وَمِن مُتَمَنِّعِ",12,"ع",1,0],["وهبّوا الى أعْطافِهِمْ ولِحاظِهمْ","فكمْ صَعْدَةٍ هُزّتْ وكمْ صارِمٍ سُلاّ",13,"ل",2,0],["وهَبْ أنّني أذْنَبْتُ والعَبْدُ مُذْنِبٌ","فَلِي حسَناتٌ في ذُنوبيَ تشْفَعُ",14,"ع",1,0],["وَهَبْنِي أَمِنْتُ الْحَادِثَات ولَمْ تَرُعْ","جَنَانِي وَخَلاَّنِي الزّمَانُ وَحَلاَّنِي",15,"ي",1,0],["وَهَبْ لِيَ مُلْكاً بَعْدَهَا لَيْسَ يَنْبَغِي","تَقَلُّدُهُ بَعْدِي لإِنْسٍ وَلاَ جَانِ",16,"ن",1,0],["وَهَبْهُ نَالَ الَّذِي أَرَادَ أَمَا","بَيْنَ يَدَيْهِ الْمَشِيبُ وَالْهَرَمُ",17,"م",1,0],["وهبّ نسيمُ الوصْلِ في روضَةِ الرِّضا","بَليلاً وأكْواسُ السّرورِ تَدورُ",18,"ر",1,0],["وهَبّ العَليلُ اللَّدْنُ مُستَشْفِياً بها","فكانَ الدّواءُ البانَ والشّيحَ والرَّنْدا",19,"د",2,0],["وهَبّتْ رِياحُ النّصْرِ في جَنَباتِها","فأنشأنَ سُحْبَ العَنْبَرِ الوَرْدِ والنَّدِّ",20,"د",1,0],["وَهَبنِيَ مِن أَنوارِ عِلمِكَ لَمعَةً","عَلى ضَوئِها أَسري وَأَقفو مَنِ اِهتَدى",21,"د",2,0],["وَهَب أَنَّ ما يُعزى إِلَيهِ مُصَدَّقٌ","وَأَنَّكَ قَد أَقرَرتَ فينا بِإِمرِهِ",22,"ر",2,0],["وَهَبكُم سَمحتُم وَالظُنونُ كَواذِبٌ","بِطَيفِكُمُ أَينَ الجُفونُ مِن الوَسَن",23,"ن",1,0],["وَهَبَّت لَنا ريحٌ أَتَتنا مِنَ الحِمى","تحَدّثُ عَمّا حَمَّلَتها قِبابُهُ",24,"ب",2,0],["وَهَبَّت لَهُ ريحٌ بِمُختَلَفِ الصَو","صَباً وَشِمالاً في مَنازِلِ قَفّالِ",25,"ل",1,0],["وَهبها كَشَيءٍ لَم يَكُن أَو كَنازِحٍ","بِهِ الدَارُ أَو مَن غَيّبَتهُ المَقابِرُ",26,"ر",1,0],["وَهَبتُ لِسُعدى ماءهُ وَنَباتَهُ","كَما كُلُّ ذي وُدٍّ لِمَن وَدَّ وَاهِبُ",27,"ب",1,0],["وَهَبَتْنِي أَسنَى الهِبَاتِ مُلُوكٌ","فَتَقَبَّلْتُهَا وَقَلْبِي أَبِيْ",28,"ي",1,0],["وَهَبُوا النَّفَائِسَ وَالنُّفُوسَ كَأَنَّهَا","فَضَلاتُ زَادٍ فِي هَوَى لُبْنَانِ",29,"ن",1,0],["وَهَبَ المآثِرَ لَيْلَهُ وَنَهَارَهُ","خَذِلاً وَهُنَّ مَتَاعِبٌ وَهُمُومُ",30,"م",1,0],["وَهَب شِعرَهُ إِن ماتَ ماتَ فَأَينَ ما","تَحَمَّلَهُ الراوُونَ وَالخَطُّ حابِلُه",31,"ل",2,0],["وَهَبَّت لَهُ ريحُ الجَنوبِ تَسوقُها","كَما سيقَ مَوهونُ الذِراعِ مُهيضُها",32,"ض",3,0],["وَهَبَّت بِها الأَرواحُ حَتّى تَنَكَّرَت","عَلى العَينِ نَكباواتُها وَجَنوبُها",33,"ب",3,0],["وهبْ عليلٌ لفَّ طيَّ بُرودِهِ","أحاديثَ أهداها إلى الغَور من نَجدِ",34,"د",1,0],["وهبّ عليها نسيم الفنو","ن يروح ويغدو بها يلعب",35,"ب",1,0],["وهب الآله بك الجمال تجمّلاً","حتى كأنك للجمال جمال",36,"ل",1,0],["وهبَت به هوج الرياح فلم تدع","من العلم جذراً فوقه غير مُجتَثّ",37,"ث",1,0],["وهَبْهم جَفَوْك اليوم بُخْلاً بوُدّهم","ألم تَغْنَ عنهم أن ملكت القوافيا",38,"ي",2,0],["وهَبْنا جهلنا بدأه من تقادم","فهل يدرك العقل انتهاء مداره",39,"ر",2,0],["وهبها كما قد قيل أحلام نائم","أما في بني الدنيا لها من معبّر",40,"ر",1,0],["وهبوب النسيم يكتب في الما","ء سطوراً مهتزّة في إطراد",41,"د",1,0],["وَهَبتُ عُطارِداً لِبَني صُدَيٍّ","وَلَولا غَيرُهُ عَلَكَ اللِجاما",42,"م",2,1],["وَهَبتُ سُلُوّي ثُمَّ جِئتُ أَرومُهُ","وَمِن دونِ مارُمتُ القَنا وَالقَنابِلُ",43,"ل",1,0],["وَهَبَّ وَسنانُ النَباتِ لاحِقُه","إِذا بَكاهُ ضَحِكَت بَوارِقُه",44,"ق",2,0],["وَهَبتُ شَبابي وَالشَبابُ مَضِنَّةٌ","لِأَبلَجَ مِن أَبناءِ عَمِّيَ أَجمَعا",45,"ع",2,0],["وَهَبتُ لَها ما حازَهُ الجَيشُ كُلَّهُ","وَرُحتُ وَلَم يُكشَف لِأَبياتِها سِترُ",46,"ر",1,0],["وَهَبتُ لِضَنّي سوءَ ظَنّي وَلَم أَدَع","عَلى حالِهِ قَلبي يُسِرُّ لَهُ شَرّا",47,"ر",2,0],["وَهَبني كَما تَدَّعي مُذنِباً","أَما يُقبَلُ العُذرُ مِن مُذنِبِ",48,"ب",1,0],["وهبت الكرى لجفون الرَّشا","فكم ذا ينام وكم أسهر",49,"ر",1,0],["وهباتك اللاتي تعجّل رفدها","ويجيب طالبها بغير سؤال",50,"ل",1,0],["وهبني كنت قد أخطأت فامْنن","بحلمٍ إنه سبب المعالي",51,"ي",1,0],["وهبَّ من طيِّ مثواه نسيم ثناً","يودّ نشر الغوالي لو يُقاسمه",52,"م",2,0],["وهبت قلبي له فقال عسى","نومك أيضاً فقلت من عيني",53,"ي",1,0],["وهبت يداه ونبَّهت آراؤه","فرووا العلى عن وهب بن منبّه",54,"ه",1,0],["وهبْ أنها الدنيا التي المرءُ مُوقنٌ","بفرقتها والمرءُ في شأن لاعبِ",55,"ب",1,0],["وهبُ يا واهبَ الهباتِ اللواتي","قَصُرَتْ دونها الهباتُ الرِّغابُ",56,"ب",1,1],["وَهَبَتْ له كفٌّ وَهُو","بٌ كلَّ ما لا يُوهَبُ",57,"ب",1,0],["وَهَبِ القضاءَ كما قضيتَ ألم يكنْ","في محضِ شِعري ما يجيز ضريبَهُ",58,"ب",2,0],["وَهَبْهُ جنى ذنوبَ القومِ طرَّاً","ألم يكُ عن عقاب في حجابِ",59,"ب",1,0],["وهبْكَ حَتَمْتَ أنّ له عقاباً","ألم يكُ دونَ عتبك من عقابِ",59,"ب",1,0],["وهباً رجائي ورجاءَ من رَجا","لا أخطأتْ وهباً نجاةُ من نجا",60,"ج",2,0],["وهبنيَ لم أبلغ من المدح مَبْلغاً","رضيّاً ألمْ أكْدَح لذلك مَكْدحا",61,"ح",2,0],["وَهَبَتْ له القلمَ المُعلّى هِمَّةٌ","رَفَضتْ من الأقلام كلَّ مَنِيحِ",62,"ح",1,0],["وَهَبِ السُّعاةَ أتوْا بحقٍّ واضحٍ","أين الكرامُ أَبُدِّلُوا أم بادوا",63,"د",3,0],["وهبوا لجانيها الذنوبَ وأقسموا","أن لو يعود إلى الذنوب لعادوا",63,"د",3,0],["وهبت شطر الرضا له فهب ال","كلَّ فليس الكمال في الشطرِ",64,"ر",1,0],["وهبني كتمتُ الحق أو قلتُ غيرهُ","أتخفَى على أهل العقول السرائر",65,"ر",1,0],["وهَبْ خادماً لم يوفِ نُعماك شكرَها","فبُدِّل عرف عنده بنَكيرِ",66,"ر",1,1],["وهب الإله لما بنيتَ من البُنا","شَرَف الذرى ووثاقة الآساس",67,"س",1,0],["وهبْه يُوارِي شَيْبَه أين ماؤُهُ","وأين أديمٌ للشبيبة أملسُ",68,"س",1,0],["وهبَتْ له عَيْنِي الهُجوعا","فأثابها منه الدُموعا",69,"ع",2,1],["وهب حسن رأيك لي محسناً","ليهجع ليلي مع الهاجع",70,"ع",1,0],["وهب الزمان له فضائل نفسه","ورجاله فحكاه في تصريفه",71,"ف",2,0],["وهب النفس للعلا فجزته","رتبةً تفرع النجوم سموقا",72,"ق",2,0],["وهبْتُ له نفسي ووُدِّي ونُصرتي","ولو صكَّ وجهي حدُّ أبيضَ باتِك",73,"ك",1,0],["وهبْ أني عدمتُ الفضلَ طرّاً","سوى علمي بفضلك في الرجالِ",74,"ل",1,0],["وهبِ الذنبَ واقعاً أين إمها","لُك ذاك الشبيهُ بالإهمالِ",75,"ل",1,0],["وهبِ الحين حينه أتُراه","خان أخلاقَه تجمُّلُ قالِ",75,"ل",1,0],["وهبْتُ له طوعاً حفاظي وإنه","لأوْهبُ مني للحفاظ وأبذلُ",76,"ل",1,0],["وهبنيَ عبداً مُذْنباً أو مُعطّلاً","سلبياً من الآلاتِ أين المكارمُ",77,"م",1,0],["وهبني جفاني الإذنُ منك عُقوبةً","على غيرِ جُرمٍ لمْ جَفَتْنِي الدَّراهمُ",77,"م",1,0],["وهَبْ لي على ما كان مني مكانتي","وحَظِّي فإني سيِّئُ الحال واجمُ",77,"م",1,0],["وهَبْني كتَمْتُ أتخفى له","بروقُ نداه على الشائمِ",78,"م",1,0],["وهَبْتُمُ لِعُبيْدِ اللَّهِ موهبةً","لا مثلها ولو اسودَّتْ له النِّعَمُ",79,"م",1,0],["وهبَّ نسيمه وذَكا نثاه","فيالِلَّهِ من طِيبٍ وحُسْنِ",80,"ن",1,0],["وهبِ الحقيقةَ كلَّ ما حُدِّثْتَه","أينَ السماحُ وقد أُعنْتَ بدين",81,"ن",1,0],["وَهَبتُكِ قَلبي وَاِستَعَضتُ بِهِ الأَسى","وَهَبتُكِ شَيئاً في الوَرى لَيسَ يوهَبُ",82,"ب",1,0],["وَهَبِ اِتَّقَيتُكَ بِالحِجابِ فَإِنَّني","لا بُدَّ خالِعَه وَأَنتَ حِجابي",83,"ي",1,0],["وَهَبنِيَ بَأساً يَسكُنُ الدَهرُ عِندَهُ","فَقَد طالَما جاشَت عَلَيَّ مَناخِرُه",84,"ر",2,0],["وَهَبتَ قَلبَكَ غَيري وَهوَ مِلكُ يَدي","ما خِفتِ شَرعا وَلا بالَيتَ مُزدَجَرا",85,"ر",2,0],["وَهَبوهُمُ الرومانَ في غَلوائِهِم","أَفَما غَلَبتُم أُمَّةَ الرومانِ",86,"ن",1,0],["وَهَبتُكُمُ في الحُبِّ عَقلِيَ راضِياً","وَيا لَيتَكُم أَبقَيتُمُ لِيَ ديني",87,"ي",1,0],["وَهَب أَنَّهُ قَولٌ مِنَ اللَهِ مُنزَلٌ","فَقَد بَدَّلَ التَوراةَ قَومٌ وَحَرَّفوا",88,"ف",3,0],["وَهَبنِيَ أُعطيتُ البَلاغَةَ كُلَّها","فَما قَدرُ مَدحي في عُلاكَ وَما عَسى",89,"س",2,0],["وَهَبتُ باقي عُمُري","لَكُم بِيَومٍ واحِدِ",90,"د",1,0],["وهبتها وللطبيعة جود","من صنوف الخيرات ما لا يعد",91,"د",1,0],["وهب لي ريالين تحت الحساب","وبعد غد نلتقى ههنا",92,"ن",2,1],["وهبتمو هِبة للعلم ما تركت","بالبائسين ولا الأيتام حرمانا",93,"ن",2,0],["وَهَبها صورَةً مِن غَيرِ روح","أَلَيسَ مِنَ القَبولِ لَها حَياةُ",94,"ه",1,0],["وَهَب لي مِنكَ خَطّاً أَو رَسولاً","يُبَلِّغُ عَنكَ كُلَّ الطَيِّباتِ",95,"ت",1,0],["وَهَبوني الحَمامَ لَذَّةَ سَجعٍ","أَينَ فَضلُ الحَمامِ في تَحنانِه",96,"ن",2,0],["وَهَبِ الرُشدَ أَنَّني أَنا أَسلو","ما مِنَ العَقلِ أَن تَرومَ مُحالا",97,"ل",2,0],["وَهَبِ الزَمانَ أَعادَها","هَل لِلشَبيبَةِ مَن يُعيد",98,"د",1,0],["وَهَبتُكِ غَيرَ هَيّابٍ يَراعاً","أَشَدَّ عَلى العَدُوِّ مِنَ الحُسامِ",99,"م",1,0],["وَهَبِ المَلامَةَ في اللَذاذَةِ كَالكَرى","مَطرودَةً بِسُهادِهِ وَبُكائِهِ",100,"ا",3,0],["وَهَبني قُلتُ هَذا الصُبحُ لَيلٌ","أَيَعمى العالَمونَ عَنِ الضِياءِ",101,"ا",2,0],["وَهَبَّت بِحِسمى هُبوبَ الدَبورِ","مُستَقبِلاتٍ مَهَبَّ الصَبا",102,"ا",1,0],["وَهَبتَ عَلى مِقدارِ كَفّى زَمانِنا","وَنَفسي عَلى مِقدارِ كَفَّيكَ تَطلُبُ",103,"ب",1,0],["وَهَبكَ سَمَحتَ حَتّى لا جَوادٌ","فَكَيفَ عَلَوتَ حَتّى لا رَفيعا",104,"ع",2,0],["وَهَبتُ السُلُوَّ لِمَن لامَني","وَبِتُّ مِنَ الشَوقِ في شاغِلِ",105,"ل",1,0],["وَهَبَ الَّذي وَرِثَ الجُدودَ وَما رَأى","أَفعالَهُم لِاِبنٍ بِلا أَفعالِهِ",106,"ل",2,0],["وَهَبكَ طَوَيتَها وَخَرَجتَ عَنها","أَتَطوي ما عَلَيكَ مِنَ الجَمالِ",107,"ل",1,0],["وَهَبتُ عِتابي كُلَّهُ لِجَفائِهِ","وَقَد كانَ عِندي لِلعِتابِ صَحائِفُ",108,"ف",1,0],["وهَبْهُمُ الماءَ موّاراً على حَجَرٍ","والماءُ ينقرُ في صَلْدٍ من الحجرِ",109,"ر",1,0],["وهَبْكَ ملكتَ رزقَ غدٍ","فمنْ لكَ بالحياةِ غَدَا",110,"د",2,0],["وهبتُ للجِدِّ أيامي فعلَّمَنِي","تلاعبُ الدهرِ بي أن أُوثرَ اللَّعِبَا",111,"ب",2,0],["وَهَبتَ عَزيزاتِ النُفوسِ لِمَعشَرِ","يَعُدّونَها أَقصى اللُهى وَالمَواهِبِ",112,"ب",1,0],["وَهَبَ اِبنُ وَهبٍ وَفرَهُ حَطتى لَقَد","أَوفى عَلى شَرقِ الثَناءِ وَغَربِهِ",113,"ب",2,0],["وَهَبتَ الَّذي لو لَم تَهَبهُ لَما اِلتَوى","بِكَ اللَومُ إِنَّ العُذرَ عِندَ التَعَذُّرِ",114,"ر",1,0],["وَهَبتَ لَنا العِنايَةَ بَعدَما قَد","نَزاها عِندَ أَقوامٍ تُباعُ",115,"ع",1,0],["وَهَبتَ لَهُم بِالسِلمِ باقي نُفوسِهِمُ","وَقَد شارَفوا أَن يَستَتِمَّهُمُ القَتلُ",116,"ل",1,0],["وَهَبتَ لي مالَكَ سَمحاً بِهِ","وَكَيفَ لا تَأخُذُ لي مالي",117,"ي",1,0],["وَهَبَ اللَهُ لِلرَعِيَّةِ مِنهُ","سيرَةَ الفاضِلِ النَقِيِّ الزَكِيِّ",118,"ي",1,0],["وَهَب لي خُنَيساً وَاِتَّخِذ فيهِ مِنَّةً","لِحَوبَةِ أُمٍّ ما يَسوغُ شَرابُها",119,"ب",3,0],["وَهَبَ القَصائِدَ لي النَوابِغَ إِذ مَضَوا","وَأَبو يَزيدَ وَذو القُروحِ وَجَروَلُ",120,"ل",1,0],["وَهَبتُ بَني بَدرٍ لِأَسماءَ بَعدَما","جَرَت فَوقَهُ رَيحانِ يَختَلِفانِ",121,"ن",1,0],["وهبَّ ذُو الرَّعَثَاتِ الحُمر مُنتشياً","فارتاعَ من صَارمٍ للصُّبحِ مَسلولِ",122,"ل",1,0],["وهَبَّتْ جَليدِيَّةٌ قَرَّةٌ","رَذاذاً وأَسلَمُها دائِقُ",123,"ق",1,0],["وَهَبَ المجدُ له أوضاحَه","فارتداهُنَّ وللنَّاسِ التَّرَح",124,"ح",1,0],["وهَبْكَ حاولتَ مَدحاً تستميحُ به","فلِمْ جَريتَ على تلك المَلاماتِ",125,"ت",1,0],["وهبَتْ شمائلُه الجزيلَ وأَبرأَتْ","يُمناه من نَدَبِ الزَّمانِ إهابي",126,"ب",2,0],["وَهَبها أَتَتني بِالكُنوزِ وَدُرِّها","وَأَموال قارونَ وَمُلك القَبايِلِ",127,"ل",1,0],["وَهَبتُكَ روحي فَاِقضِ مِنها وَلا تَخَف","لِأَنَّ عِناني نَحوَ غَيرِكَ لا يُلوى",128,"و",2,0],["وَهَبتُمُ مَوعِداً وَنُمتُم","فَعِندِيَ المُقعِدُ المُقيمُ",129,"م",1,0],["وَهَبَت لَكَ العَلياءُ حَقَّ صَداقِها","حَتّى رَضيتَ بِأَن تَراكَ خَليلا",130,"ل",2,0],["وَهَبَّ لَنا شادٍ حَكى الغُصنَ قَدُّهُ","أَلفٌ إِذا ما رُعتَهُ اِهتاجَ أَعزَلُ",131,"ل",1,0],["وَهُبَّ معَ الصَباحِ إِلى صَبوحٍ","وَصِل آناءَ لَيلِكَ بِالنَهارِ",132,"ر",1,0],["وَهَبَّ لَنا شادٍ كَريمٌ نِجادُهُ","خُؤولَتُهُ في الفَخرِ قَيسٌ وَبَرمَكُ",133,"ك",1,0],["وَهَبَّ لَنا شادٍ حَكى الغُصنَ قَدُّهُ","يُرَدِّدُ طَرفاً صامِتاً مُتَحَدِّثا",134,"ث",2,0],["وَهَبتُ لَها كَهلاً مِنَ العَقلِ وافِراً","فَكانَ لَدَيها النِصفُ وَالثُلثُ وَالسُدسُ",135,"س",1,0],["وَهَبتُكَ في الهَوى رَوحي بِوَعدٍ","وَبِعتُكَ عامِداً نَقداً بِدَينِ",136,"ن",1,0],["وَهَبَ الزَمانُ لَنا اللِقا","وَدَعاهُ في اِستِرجاعِه",137,"ع",2,0],["وَهَبَتهُ العَلياءُ هِمَّةَ قَلبٍ","طَهَّرَت مِن شَوائِبِ العَيبِ ذاتَه",138,"ت",2,0],["وَهَب مَلَكي الغالي الكريم وحارسي","تخلّى فما عذر الوفاء وما عذري",139,"ر",2,0],["وهَب السجن بابه صار حرا","لكَ لا حائل ولا أسوار",140,"ر",1,0],["وهب الطائر عن عشك طارا","جفت الغدران والثلج أغارا",141,"ر",2,0],["وهَبني قد قدحتُ زنادَ عزمٍ","تضرّمَ في الأناة له حريقُ",142,"ق",1,0],["وَهَبتُ نَفسِي لَهُ حُبّا وَتَكرِمَة","فَهَل تَراني بَلَغتُ السُّؤلَ مِن سَلَمي",143,"م",2,0],["وَهَبَّتْ رِياحٌ من الطَّيِّبَاتِ","و\" الطَّيِّبِينَ \" ولم يُقْشَعِ",144,"ع",1,0],["وَهَبَّ بِها يَمضي فَيَفري كَأَنَّما","شِهابٌ بِها يَنقَضُّ أَو قَدَرٌ يَجري",145,"ر",2,0],["وَهَبَّ كَما هَبَّ الحُسامُ شَهامَةً","وَعَبَّ كَما عَبَّ الخِضَمُّ تَبَرُّعا",146,"ع",2,0],["وَهَبنِيَ أَجي وَردَ خَدٍّ بِناظِري","فَمِن أَينَ لي مِنهُ بِتُفّاحِ لُبنانِ",147,"ن",1,0],["وَهَبوا لربِّهمُ النُّفوسَ كريمةً","لا تُفتدَى منه ولا هي تُعتَقُ",148,"ق",1,0],["وَهَبوا لها أعمارَهم وكأنّما","وَهبتْ لهم من أهلها الأعمارا",149,"ر",2,0],["وهبَّ الشّعبُ ملءَ الأرضِ يجزي","يدَ الغازي ويلقى الوافدينا",150,"ن",2,0],["وهبتم للمالك ما تمَّنتْ","وقُمُتمْ في الشُّعوبِ مُهذِّبينا",150,"ن",2,0],["وَهَبتُ الصبى وَالشَيبَ وَالشَوقُ وَالهَوى","لِمِصرَ وَإِن لَم أَقضِ حَقَّ الهَوى مِصرا",151,"ر",2,0],["وَهَبنا أُمَّةً في الجَهلِ غَرقى","وَشَعباً في مَهانَتِهِ دَفينا",152,"ن",2,0],["وَهَبتُ لَكَ المُلكَ مُلكَ القَريضِ","وَذَلِكَ أَفضَلُ ما يوهَبُ",153,"ب",1,0],["وَهَبَتكُمُ الخَيرَ الجَزيلَ فَهَل فَتىً","مِنكُم بِحُسنِ صَنيعِها يَجزيها",154,"ي",3,0],["وهبَّ أميرُ الغيلِ يدفعُ دونه","ويُولِعُ بالفتكِ اللّيوثَ الضواريا",155,"ي",2,0],["وَهَبتُ وَلا مَنٌّ عَلى الحُبِّ مُهجَتي","وَلُبّي وَسِلواني لِغَيرِ مُثيبِ",156,"ب",1,0],["وُهُبِ المِئينَ مِنَ المِئي","نِ إِلى المِئينِ مِنَ اللَواقِح",157,"ح",1,0],["وَهَبتُ لِوَجهِهِ أَلحاظَ عَيني","بِلا خَوفٍ لِأَولادِ الزَواني",158,"ي",1,0],["وَهَبتُ لَها قَلبي فَلا تَطلُبوا دَمي","وَلَيسَ عَلَيها مِن فِداءٍ وَلا قَتلِ",159,"ل",1,0],["وَهَبني أَرَيتُ الحاسِدينَ تَجَلُّداً","فَكَيفَ بِحُبٍّ ضُمِّنَتهُ الأَضالِعُ",160,"ع",1,0],["وَهَبتُ سَلامي ما حَيَيتُ لَمَجلِسٍ","عَلى قَصرِ بِسطامٍ أَميرِ المَجالِسِ",161,"س",1,0],["وَهَبَ الإِلهُ لهُ الكمالَ وإنَّهُ","في غَيْرِهِ مِنْ جِنْسِ ما لا يُوهَبُ",162,"ب",1,0],["وهبنا تركنا أن نعدّد ما خلا","وسارت به منّا القرون الأوائل",163,"ل",1,0],["وهَبِ المَداوِسَ صَنَّعَتْهُ فحَسْبُهُ","سِنْخٌ يُؤيّدُهُ وحَدٌّ مِقصَل",164,"ل",1,0],["وَهَبْ لي وَزيراً من أخي أستعِنْ به","وشُدَّ به أزري وأشركْه في أمري",165,"ر",2,0],["وَهَبَ الدّهرُ نفيساً فاسترَدّ","رُبّما جاد لئيمٌ فحسَدْ",166,"د",1,1],["وَهَبَ الصَريحُ لَهُ سَنابِكَهُ","وَأَعارَهُ التَحجيلَ وَالقَرَحا",167,"ح",2,0],["وَهَبكَ مِن قَصفِ بَغدادٍ تُخَلِّصُني","كَيفَ التَخَلُّصُ لي مِن طِزَناباذِ",168,"ذ",1,0],["وَهَبني بُحتُ بِالحُبِّ","فَهَل في الحُبِّ مِن باسِ",169,"س",1,0],["وَهَبَ الجَديلُ لَها مَدارِعَهُ","وَالقِمَّةَ العَلياءَ وَالشَعَفا",170,"ف",2,0],["وهب للنارِ نفسَكَ في هواها","وجاهر لا عدمتُكَ بالفسوقِ",171,"ق",1,0],["وَهَبتَ لَنا يا فَتى مِنقَرٍ","وَعِجلٍ وَأَكرَمَهُم أَوَّلا",172,"ل",2,1],["وَهَبتِ لَهُ عَلى المِسواكِ ريقاً","فَطابَ لَهُ بِطيبِ ثَنِيَّتَيكِ",173,"ك",1,1],["وَهَبتُ لِأَيرِ الضالِمِيِّ إِستَ شاعِرٍ","وَقُدتُ اِبنَ نِهيا وَالأُسودُ تُقادُ",174,"د",1,0],["وَهَبني كُنتُ أَذنَبتُ","أَما تَغفُرُ لي ذَنبا",175,"ب",2,0],["وَهَبَّتِ الريحُ مِن تِلقاءِ ذي أُرُلٍ","تُزجي مَعَ اللَيلِ مِن صُرّادِها صِرَما",176,"م",2,0],["وَهَبها فَتاةً هَل عَلَيها جِنايَةٌ","بِمَن هُوَ صَبٌّ في هَواها مُعَذَّبُ",177,"ب",1,0],["وَهَبَّ يَرومُ سُنبُلَةَ السَواري","خَبيرٌ وَالزَرائِعُ مُحصِداتُ",178,"ت",1,0],["وَهَبنا لَكُم فِيها المئِينَ وَغادَرَت","مَغارَتُنا خدّا مِنَ الناسِ عُيَّلا",179,"ل",2,0],["وهبّ أهلُ الصَّبرِ والبَصائرِ","فأوعَقوا على العدوِّ الكافرِ",180,"ر",1,0],["وهَبتُهُ روحي فما","أَدري بهِ ما فَعلا",181,"ل",2,0],["وَهب أن لي ذاكَ الدَليل وأنني","هربت فهَل يألو عَن البحث جعفر",182,"ر",1,0],["وهب اللَه للرعايا حقوقاً","غصبتها من الرعايا الولاة",183,"ه",1,0],["وهبه الدهر قوى","ثم استرد ما وهب",184,"ب",1,0],["وَهُبِّي عذارى النخل فرعاءَ وارقصي","بخُضْرِ أكاليلٍ وحُمْرِ عقودِ",185,"د",1,0],["وهبتُكَ الغضَّ من شبابي","سكرانَ من خمر أُمسياتي",186,"ي",1,0],["وَهَبّتْ في نواحي الأرضِ دُنيا","لحقٍّ يُجتَبَى ومُنىً تُلَبُّ",187,"ب",1,0],["وهبه لم يأمن عواديَ العبثْ","أليس كالكير الذي ينفي الخبث",188,"ث",1,0],["وهبط النور عليه وحيا","ونزل الفرقان فيه محيا",189,"ي",2,0],["وهبَّ منهم من لحقِّكَ اختلسْ","وفَجَعوك بالصلاة في الغلسْ",190,"س",1,0],["وَهَبْنِي فَارِسَ الْهَيْجا","ءِ أَغْشَاهَا فَتَنْكَشِفُ",191,"ف",1,0],["وَهَبْتُ لَهُ مَا قَدْ جَنَى مِنْ إِسَاءَةٍ","وَلَوْ شِئْتُ كَانَ الْسَّيْفُ أَدْنَى إِلَى الْفَصْلِ",192,"ل",1,0],["وَهَبَّتْ مُنِيخَاتُ أَطْوَادِهَا","نَوَاشِزَ كَالإِبِلِ الشُّرَّدِ",193,"د",1,0],["وَهَبَّتْ أَزَاهِيرُ الرَّبِيعِ نَقِيَّةً","جَلاَهَا مِنَ النَّقْعِ الَّذِي كَانَ يُنْشَرُ",194,"ر",1,0],["وَهَبَتْ فَأَجْزَلَتِ الْهِبا","تِ وَمِنْ أَيَادِيهَا الرَّجَاءْ",195,"ا",2,0],["وَهَبَ المُحِبُّ قُوَاهُ وَهْي مُضَنَّةٌ","لِلّهِ دَرُّ الحُبِّ مِْ وَهَّابِ",196,"ب",1,0],["وَهَبَّت رِيَاحُ الصَّيفِ يَرمِينَ بِالسَفا","بَليّةَ باقي قَرمَلٍ بالمآثِبِ",197,"ب",1,0],["وَهَب لِيَ أُنساً مِنكَ يُذهِبُ وَحشَتي","وَيَبسُطُ قَلباً ذا اِنقِباضٍ وَيَشرَحُ",198,"ح",1,0],["وهبوا نبوغكَ في الحياة لحفنةٍ","من أدمعٍ مجبولة برماد",199,"د",1,0],["وَهَبِ السقامَ مَحا سَناكَ فَما لَهُ","أَفضى إِلى شَفَتَيكَ حَتّى قَلَّصا",200,"ص",2,0],["وَهَبتُكَ حَظّي مِن سرورٍ وَلذَّةٍ","فَجازَيتَني أَن زِدتُ بَلوى عَلى بَلوى",201,"و",2,0],["وهبت قوايَ للحَدَق الضِّعافِ","وإن كانَت بسفكِ دَمي تُكَافي",202,"ف",2,1],["وَهَبتُ لِلقَبر ريّهُ بِدَمي","لَمّا شَفاني بِطيبِ رَيّاهُ",203,"ا",2,0],["وَهَبها جَفَت مَن أحصنت بِلبانَة","قَضاها أَتَجفو مَن غَذَت بِلبانِ",204,"ن",1,0],["وَهَبَّت لَهُ ريحٌ بِمُختَلَفِ الصَوا","صَباً وَشِمالاً في مَنازِلِ قَفّالِ",205,"ل",1,0],["وَهَبَ الحياةَ كريمةً لبِلادِهِ","ومَضَى إلى الأُخْرَى صَريعَ جِهاد",206,"د",1,0],["وهبوا الروحَ للُبنان فِدىً","وضَنينٌ كلُّ مَنْ لم يَهَب",207,"ب",1,0],["وَهَبَتْ لَكَ الدنْيا مَفَا","تِحَ مَجْدِهَا مِنْ غَيْرِ رَدِّ",208,"د",1,0],["وهبك وصلت الى صرحها","وهبك هدمت السدود نضالا",209,"ل",2,0],["وهبَتْ لعرشك ما لها، ودماءها","إن شئت تلق كليهما مبذولا",210,"ل",2,0],["وهب نسيم الروض في روضة الرضا","بليلا وأكواس السرور تدور",211,"ر",1,0],["وهَبي : بَنُوكِ قَضوا لأجلكِ كلُّهم","عاشت بناتُك حاملات لواك",212,"ك",1,0],["وَهبِ اللفظَ سُلَّماً فمتى استحسنتِ","العينُ واهباتِ السلالم؟",213,"م",1,0],["وهبْ أوفى ب \" أنقرة \" وأنعمْ","رُواءُ المُلك يَزدهرُ التماعا",214,"ع",2,0],["وَهَبوا مرةً نجحتم فلا تنخدعوا ،","سوف تُخْذلون مرارا",215,"ر",2,0],["وهبْ ذهبت ضحايا \" العدل \" ظُلماً","نفوسٌ من تظنِّيه بُراء",216,"ا",2,0],["وهبَيه عهدَ اقتطاعٍ وكانتِ","لك في الحكم أُسوةٌ بسِواك",217,"ك",1,0],["وهب أنني أخنَتْ عليَّ صراحتي","فهل عيشُ من داجَي يكون لسرمَد",218,"د",1,0],["وهَبْ أنه قد أُلهِمَ العلمَ كلَّه","وحلَّلَ حتى الجوهرَ الفردَ والذرّا",219,"ر",2,0],["وَهَبّتْ لهُ رِيحٌ بمُخْتَلَفِ الصُّوَا","صباً وشمال في منازلِ قفّال",220,"ل",1,0],["وَهَبْ شِعْرَهُ إِنْ ماتَ ماتَ فأيْنَ ما","تَحَمَّلَهُ الراوونَ والخطُّ ناقِلُهْ",221,"ل",2,0],["وَهَبَ الله للرّعيّةِ مِنْهُ","سِيرَةَ الفاضِلِ، التّقيّ، الذّكيّ",222,"ي",1,0],["وَهَبَ ابنُ وَهْبٍ وَفرَه، حتى لقَدْ","أوْفَى على شَرْقِ الثّنَاءِ، وَغَرْبهِ",223,"ب",2,0],["وَهَبْتَ لَنَا العِنَايَةَ، بَعدَما قد","نَرَاهَا عِنْدَ أقْوَامٍ تُبَاعُ",224,"ع",1,0],["وهبني عبداً مُذْنباً أو مُعطلاً","سليباً من الآلاتِ أين المكارم",225,"م",1,0],["وهَبْ لي على ما كان مني مكانتي","وحَظِّي فإني سيىء ُ الحال واجمُ",225,"م",1,0],["وهبوا لجانبها الذنوبَ وأقسموا","أن لو يعود إلى الذنوب لعادوا",226,"د",3,0],["وهَبْكَ شفعْتَ لي وعداً بوعدٍ","لتُحْكَمَ مِرَّة ٌ ويُشَد عَقْدُ",227,"د",1,0]]}