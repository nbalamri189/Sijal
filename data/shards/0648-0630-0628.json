{"poems":[[55,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[57,"أروني وجه نسرين","https://www.aldiwan.net/poem26047.html","الهزج"],[39,"وذبا عن الحرمات الكبار","https://www.aldiwan.net/poem7022.html","المتقارب"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[93,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[80,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[87,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[83,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[52,"يا فرخ نهيا بإفك قلت أو زور","https://www.aldiwan.net/poem63807.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142181","الكامل"],[87,"طويَ البساطُ وجفت الأقداحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9595&r=&rc=85",""],[136,"هاج إدكارى شادن بدكار","https://www.aldiwan.net/poem54836.html","الكامل"],[147,"بإحرازك الفضل الذي بهر الخلقا","https://www.aldiwan.net/poem11786.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[189,"أنحلني حبك يا متلفي","https://www.aldiwan.net/poem14592.html","السريع"],[264,"الحمد لله مهذب النفوس","https://www.aldiwan.net/poem35935.html","الرجز"],[274,"أبا الأطول طولت","https://www.aldiwan.net/poem26458.html","الهزج"],[276,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[303,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[347,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[366,"أيها القوم ويحكم قد هدمتم","https://www.aldiwan.net/poem68114.html","الخفيف"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[385,"أحريق أم غرام","https://www.aldiwan.net/poem48801.html","مجزوء الرمل"],[398,"برئت من الأرجاس رهط امية","https://www.aldiwan.net/poem53633.html","الطويل"],[412,"يغالبني فرط الغرام على الصبر","https://www.aldiwan.net/poem50164.html","الطويل"],[438,"قسما بسؤددك القديم","https://www.aldiwan.net/poem12531.html","مجزوء الكامل"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[463,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[463,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[487,"أطلعن في قمر الأفوق شموسنا","https://www.aldiwan.net/poem24426.html","عموديه"],[520,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[520,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2464","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122543","الوافر"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206071","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122350","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77606","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46714",""],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[1947,"","https://poetry.dctabudhabi.ae/diwan/poem/178105","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69314","البسيط"],[333,"","https://poetry.dctabudhabi.ae/diwan/poem/110986","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53165","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87347","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65986","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205049","الكامل"],[3335,"","https://poetry.dctabudhabi.ae/diwan/poem/202295","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62762","الكامل"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35535","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125811","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81919","الخفيف"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143039","الطويل"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75840","الوافر"],[4753,"الى عيني ماجدة","https://www.poetsgate.com/ViewPoem.aspx?id=58866",""],[4755,"مُكَاشَفَة","https://www.poetsgate.com/ViewPoem.aspx?id=207193",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[3271,"ويعيش أحرار العقول بظلها غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=104120",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5240,"لا تلمني فالنفس طال عناها","https://www.poetsgate.com/ViewPoem.aspx?id=171238",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5408,"لماذا أنا وهو لا","https://www.poetsgate.com/ViewPoem.aspx?id=190787",""],[5431,"ولم يبقَ غير الحب اسطورةً كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=197493",""],[5442,"غنى بذكر الحمى فارتاح كل شجى","https://www.poetsgate.com/ViewPoem.aspx?id=114774",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5691,"أطبق الصمت...!","https://www.poetsgate.com/ViewPoem.aspx?id=206739",""],[4442,"لك من أبيك تحية وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=171200",""],[6259,"يغالبني فرطُ الغرام على الصبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59380&r=&rc=28",""]],"verses":[["وَذَبّي عَن حِمى بَغدادَ قِدماً","بِفَضلِ العَزمِ وَالنَفسِ العِصاءِ",0,"ا",2,0],["وَذُبّوا اليَأسَ عَن قَلبي","بِما شِئتُم وَغُرّوني",1,"ن",2,0],["وذبَّا عن الحُرمات الكبار","إذا بلغ الخوف إلا مُجيرا",2,"ر",2,1],["وذبَّ الذئابَ الطُّلْسَ عنا فأصبحتْ","ومنها طريدُ الخوفِ والمتحرَّمُ",3,"م",1,0],["وَذُبولُ الغُصنِ في فَصلِ الرَبيع","لَو رَآهُ شَجَرُ الرَوضِ المَريع",4,"ع",1,0],["وَذُبتُ إِلّا ذَماءً فيَّ يُمسكني","أَنّي عَهدتُكَ تَعفو حينَ تَقتَدِرُ",5,"ر",1,0],["وَذَبَحنَ حَنجَرَةً عَلى أَوتارِها","تُؤسى الجِراحُ وَتُذبَحُ الأَتراحُ",6,"ح",1,0],["وَذَبّي عَن مَآثِرَ صالِحاتٍ","بِمالي وَالعَوارِمِ مِن لِساني",7,"ن",2,0],["وذبالٍ على القنا مُشْعَلاتٍ","مطفئات الأرواح في الأجسام",8,"م",1,0],["وَذُبابُ الهِندِيِّ أَشرَفُهُ لَي","سَ عَلَيهِ مِنَ التَأَخُّرِ عارُ",9,"ر",1,0],["وَذَبَّ عَنّي غُواةَ الناسِ مُعتَدِياً","بابٌ حَديدٌ وَصَوتٌ غَيرُ مَنزورِ",10,"ر",1,0],["وذبحوا الشيخ على الفُرقانِ","حتى بَكى الذِّكْرُ بدمعٍ قانِ",11,"ن",1,0],["وذبيحة نحرت ليأتي","الذئب منها ما استطابه",12,"ب",2,0],["وذبحهنَ حنجرة ً على أوتارها","تُؤسَى الجِراحُ، وتُذْبَحُ الأَتراح",13,"ح",1,0],["وذَبِيحُهم وبلاَلُهُم وجَمِيعُهم","مَا بَينَ بَدرٍ كَامِلٍ ودَرَارِي",14,"ر",2,0],["وَذَبّوا عَنِ الأَعراضِ عِلماً بِأَنَّها","بِغَيرِ مِياهِ البَذلِ وَالعَدلِ لا تَبقا",15,"ق",2,0],["وذب عن الدين الحنيف بسيفه","برغم عرانين الألوف الصواغر",16,"ر",1,0],["وذبتُ حتى لو رمى بي الهوى","في ناظرِ الناظرِ لم يَطْرف",17,"ف",1,0],["وذبحها بمدية المجاهدَهْ","فيها بما تكون فيه رائدَهْ",18,"ه",1,0],["وَذِبّاناً حَوالَيكَ","فَمَوقوذٌ وَمَقتولُ",19,"ل",1,0],["وَذبت وجدا لأرض لي بها وطر","هَيهات كَم بَينَ أَوطاني وأَوطاري",20,"ر",2,0],["وذبذبتْ بذيلها","تضمّهُ لتنشره",21,"ر",2,0],["وذب شذى ورحيقاً","في كأس هذي البقاع",22,"ع",1,0],["وَذَبَحتُم هذا المُهَذَّب غَدراً","وَقَطَعتُم بِغَلطَة أَوراده",23,"د",2,0],["وذبيحةٌ سريةٌ ذُبحت به ال","أعداءُ والأضداد والأوثان",24,"ن",1,0],["وَذُبول ما بِجسمي","أَم خَفاءٌ أَم سقام",25,"م",1,0],["وَذَبحِهِم خيرَ الرِجالِ ارومةً","حسينَ العلي بِالكُرب في كَربَلائهم",26,"م",1,0],["وَذُبتُ فَلَو أَلقَيتَ في كأسِ خمرةٍ","لما اغتصَّ بي في كأسِها شارِب الخَمرِ",27,"ر",1,0],["وذبَبْتَ عن أرجائِها","ذبّ الغَيورِ عن الحريمِ",28,"م",1,0],["وذَبَّ عدلُكَ دونَ الحقِّ منتقِماً","ورَدَّ نصرُكَ ظُلْمَ العِلْمِ مُحْتَسِبا",29,"ب",2,0],["وذب عن ملكهما صارم","من رأيه بالعجز لم يُثلَمِ",30,"م",1,0],["وذَبَّبتُ عنها الناس ضنًّا بعُذْرها","لمجدكَ حتى كنتَ فضَّ ختامِها",31,"م",3,0],["وذبَّ عني فوفيتُ ناهضاً","من الخطوب بذئابٍ طُلْسِ",32,"س",1,0],["وذبّب عنها من عُقَيلِ بن عامرٍ","أراقمُ لا تَحوي شَباها رُقاتُها",33,"ت",3,0],["وذب البسيطة فوق لج مزبد","ما أن يزال على القرار جيسا",34,"س",2,0],["وذبالة أضحى بقلبي لذعها","زفراته بتنفس الصعداء",35,"ا",2,0],["وذب لسانه وظباه عنها","فأصبح روضها غرد الذباب",36,"ب",1,0],["وَذَبٍّ عَنِ الجارِ المُلَبِّسِ حَبلَهُ","بِحَبلَيهِما وَبِالحَليفِ المُقاسِمِ",37,"م",1,0],["وَذُبنَ جَوامِدَ الأكبادِ حتى","خَشيتُ من الصَّبابَةِ أن أذوبا",38,"ب",2,0],["وذبي عن أعراضهم كل مترف","وجدي إذا كان القيام على رجل",39,"ل",1,0],["وذبت عشقا لم أدر ام سقما","بل في الذي اعظي له سبل",40,"ل",1,0],["وَذَبَحوه بِالمُدي في ساعَه","وَاِجتَمَعَت عِندَ الغَدا جَماعَه",41,"ه",1,0],["وذُبتُ ضنىً حتى خَفِيتُ عن الضَّنى","فسقُمِي عن سُقمي يدافعُ دوني",42,"ن",2,0],["وَذُبولِ الشَبابِ دارَت عَلَيهِ","بِرَحاها كَفُّ المُجونِ الثَقيلَه",43,"ل",2,0],["وذببت العدو عنه ولولا","ك بلا مريةٍ لعط أديما",44,"م",2,0],["وَذُبَّلٌ مِن رِماحِ الخَطِّ حامِلَة","مِنَ الأَسِنَّةِ نيراناً بِلا شَرَرِ",45,"ر",1,0],["وذبت في الطين طينا","فما أريد انقساما",46,"م",2,0],["وذببت عنه بالسيوف قواضباً","والخيل جرداً والرماح ذوابلا",47,"ل",2,0],["وذُبَّانُ عَيُّوقٍ إذا كانَ طالعاً","على الحدِّ مِثلُ الجاهِ قِسهُ مَعَ النَّسرِ",48,"ر",1,0],["وذُبَّانُ في هذينِ في فَردِ مَرَّةٍ","على تَانةٍ إن كُنتَ بالعلمِ خابِر",49,"ر",1,0],["وذُبَّانُ عيُّوقٍ إلى الشَّرقِ طامحُ","تأمَّل وشاوِر وَاسهَرِ الليلَ واعزِمِ",50,"م",1,0],["وذُبَّانُ عَيُّوقٍ كذاك محقَّقِ","على المر وما فيه نفيسٌ وضيّقِ",50,"ق",1,0],["وذبّوا العدا بالزرق والجرد واضربوا","بأسيافكم ضرباً يبتٌّ الغلاصما",51,"م",2,0],["وذبحته وأقمت منه وليمة","ودعوت دونكم الأعق الأظلما",52,"م",2,0],["وذببوا من رام جيرانكم","بالسوء بالبتر وبالسمر",53,"ر",1,0],["وذبابُ سيفكِ أنّهُ قَسَمُ الوَغى","والموتُ في ثوبٍ من الفِرْصادِ",54,"د",1,0],["وذبحوا في سوحه طليّا","وجعلوه للعشا مضبيّا",55,"ي",2,0],["وَذبّل مِن رِماحِ الخَطِّ مشرَعة","في طولِهنّ لِأَعمار الوَرى قصرُ",56,"ر",1,0],["وذبالة فيه الشبيبة هالةٌ","نور الترقي في سناها بادي",57,"د",2,0],["وذبتُ شوقاً ولا أشكو الغرام أحد","أقول إذ نحن نزال بخير بلد",58,"د",1,0],["وذبحتُ الغزال ذبحاً بسكين شب","ابي في روض عصر التصابي",59,"ب",2,0],["وذبيت دهراً عن دسوت حللتها","وقد حان ذبي عن سريري ومنبري",60,"ر",2,0],["وَذُبيانيَّةٍ أَوصَت بَنيها","بأن كذَبَ القَراطِفُ وَالقُروفُ",61,"ف",1,0],["وذبول عينيها كعيني وارد","كأس المدام وقد اطال مواردة",62,"د",2,0],["وذُبنَا في ظِلالِ البُنِّ شَوقًا","إلى الخَضراءِ مِن قَحطٍ يَؤُوسِ؟!",63,"س",1,0],["وذبح ولدانا وفجع نسوة","اذل بني يعقوب افناهم القتل",64,"ل",1,0],["وذبالةٌ تذكي الفناء لعُمرها","وخيوطها بالنور جدّ ضوافي",65,"ف",2,0],["وَذَبَحْنَاْ عِطْرَ ظِلَّيْنَاْ شَمَاْتَاً وَرِهَاْنَاً","وَمُلِئْنَاْ بِغُرُوْرٍ وَقِحٍ كَاْنَ انْتِحَاْرَاْ",66,"ر",2,0],["وذبيح على التراب طريحا","قد كسته الرياح نسج ذراها",67,"ا",3,0],["وذبحا ونذرا عندها واستغاثة","يسوغ لمطلوبٍ من الميت للوفد",68,"د",1,0],["وذبح واستغاثة مستغيث","ونذر واستعانة ذي الجلال",69,"ل",1,0],["وذبتُ اشتهاءً ونارُ العروقِ","تلظَّتْ وخطّتْ شهيقيَ كُتبُ",70,"ب",1,0],["وذبتُ بدفْقِ الشعر قطعة سكرٍ","بها نشوة الصوفي قلبي بكى وذابْ",71,"ب",1,0],["وذب غنهم وأغنتهم شفاعته","عند الحساب عن الأعذار والحجج",72,"ج",1,0],["[ وَذُبْتُ حَشىً مِنْ لَظَى لَوْعَةٍ","قَدْ اتَّقَدَتْ فِي حَشايَ اتِّقادا ]",73,"د",2,0],["وذَبَحْنا خُيولَنا وانْتحَرْنا","تحْتَ أقْدام ِخَيْلِهِ أفْواجا !",74,"ج",2,0],["وذببت عن عرش المليك وتاجه","(ويذب دون عرينه الضرغام)",75,"م",1,0],["وذبتُ فلو ألقيتُ في كأس خمرة ٍ","لما غصّ بي في كأسها شاربُ الخمر",76,"ر",1,0]]}