{"poems":[[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[92,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[130,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[221,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[269,"دمى طلل بين الطلول بحا جر","https://www.aldiwan.net/poem52110.html","الطويل"],[340,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[362,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"]],"verses":[["وفي ثالث الأسوار تشجيك ساحةٌ","تمور بتيّار من الخسف مُزبِد",0,"د",1,0],["وفي ثقة تدعو إلى الرَّيْثِ مَعْجَبٌ","لقوم ولكنْ أنتَ أَنت المفهَّمُ",1,"م",1,0],["وفي ثَغرهِ بَسَماتُ الشُّجونِ","وفي طَرفِهِ حَسَراتُ السِّنينْ",2,"ن",1,0],["وفي ثراه البلقع اليباب","ما شئت من أهل ومن أحباب",3,"ب",1,0],["وفي ثَمَرِ البُهمَى لِمِثلِكَ أُسوَةٌ","فَأنتَ وَمَا قَد أَثمَرتَ مِن سفي سَوَا",4,"و",2,0],["وَفي ثَناياكَ هَوىً طاهِرٌ","وَبَينَ جَنبَيكَ هَوىً أَطهَرُ",5,"ر",1,0],["وَفي ثمر أَهوى بسهم فَلَم يزل","بِجيش لهم بالرمى من غير حافِر",6,"ر",1,0],["وفي ثنايا الهواء","ام في ظلال الدوالي",7,"ي",1,0],["وفي ثَوْبِ عُمْرٍ يَسْحَبُ الدّهْرَ ذَيْلَه","من المُلْكِ سَحْباً في عِراصٍ فَسائح",8,"ح",1,0]]}