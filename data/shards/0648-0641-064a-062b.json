{"poems":[[90,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[94,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[136,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[276,"دمى طلل بين الطلول بحا جر","https://www.aldiwan.net/poem52110.html","الطويل"],[347,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138197",""],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/112999","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67012","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38967","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38875","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38212","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37870","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59126","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96672","الطويل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18215","البسيط"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85002","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85257","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131079",""],[3916,"","https://poetry.dctabudhabi.ae/diwan/poem/122209","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104533","الرجز"],[4578,"مصر الغرام فؤادي في هوى الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49405",""],[4929,"دردشة مع ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=202227",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5005,"بارقة الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=208142",""],[5129,"هذي الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=151604",""],[5340,"ويوم ترى كانونا الأول مقبلا","https://www.poetsgate.com/ViewPoem.aspx?id=186106",""],[5832,"أرى بدرينِ قد طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=96993",""],[5845,"دمي طللٌ بينَ الطلولِ بحاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=16706",""]],"verses":[["وفي ثالث الأسوار تشجيك ساحةٌ","تمور بتيّار من الخسف مُزبِد",0,"د",1,0],["وفي ثقة تدعو إلى الرَّيْثِ مَعْجَبٌ","لقوم ولكنْ أنتَ أَنت المفهَّمُ",1,"م",1,0],["وفي ثَغرهِ بَسَماتُ الشُّجونِ","وفي طَرفِهِ حَسَراتُ السِّنينْ",2,"ن",1,0],["وفي ثراه البلقع اليباب","ما شئت من أهل ومن أحباب",3,"ب",1,0],["وفي ثَمَرِ البُهمَى لِمِثلِكَ أُسوَةٌ","فَأنتَ وَمَا قَد أَثمَرتَ مِن سفي سَوَا",4,"و",2,0],["وَفي ثَناياكَ هَوىً طاهِرٌ","وَبَينَ جَنبَيكَ هَوىً أَطهَرُ",5,"ر",1,0],["وَفي ثمر أَهوى بسهم فَلَم يزل","بِجيش لهم بالرمى من غير حافِر",6,"ر",1,0],["وفي ثنايا الهواء","ام في ظلال الدوالي",7,"ل",2,0],["وفي ثَوْبِ عُمْرٍ يَسْحَبُ الدّهْرَ ذَيْلَه","من المُلْكِ سَحْباً في عِراصٍ فَسائح",8,"ح",1,0],["وفي ثقافتك العليا وفي أدب","وفي حصافة حكم عند إفتاء",9,"ا",2,0],["وفي ثمانينَ مع ستٍ تليهِ قَضى","عبدُ المليك وله الأمرُ الذي اشتهَرا",10,"ر",2,0],["وفي ثَغْرِكَ الوَضَّاحِ رِيُّ لُبَانَتِي","فَظَلْمُكَ صَدْآءٌ وقلبيَ صَدْيانُ",11,"ن",1,0],["وَفي ثُريّا العُلى وَالعزّ أَرّخه","بِالجدّ بِالسّعدِ هَذا البدرُ مَولودُ",12,"د",1,0],["وَفي ثَغرِها خَمرانِ ريقٌ وَمَلفَظ","وَفي لَحظِها المَخمور أَسنى شمولِ",13,"ل",1,0],["وَفي ثُريّا العزِّ كانَ مَكنَسها","وَإِنّها الشّمسُ حَلَّت دارَة الحمَلِ",14,"ل",1,0],["وَفي ثَلاثٍ مِنَ الأَيّامِ نَأخُذُها","وَنَملكُ الأَرضَ عَرضاً ضمنهُ الطولُ",15,"ل",1,0],["وَفي ثَلاثٍ بِشوّالٍ وَعَشرتِهِ","جاؤوا وطالِعُهم بِالنَّحسِ مَوصولُ",15,"ل",1,0],["وَفِي ثَغْرِهِ الأزْهَارُ وَالزُّهْرُ وَالسَّنَا","وَقَطْرُ الحَيَا والرَّاحُ وَالشَّهْدُ وَالأقْطُ",16,"ط",1,0],["وفي ثبير وفي ثور وغار حرا","نصر وفتح وتأييد وتاثيل",17,"ل",1,0],["وَفي ثَغرِها كالخمرِ خمرٌ معتَّقٌ","ودرٌّ حَكى الدرَّ النفيس نفيسُ",18,"س",1,0],["وَفي ثَلاثَةِ رَهطٍ أَنتَ رابِعُهُم","توعِدُني واسِطاً جُرثومَةَ العَرَبِ",19,"ب",1,0],["وفي ثلاث سنين يستديم بنا","يقارع الحرب اطواراً ويأتمر",20,"ر",1,0],["وفي ثلاثين مكوكاً على رجلٍ","أعطى بها نخلة فالبيع مرتجف",21,"ف",1,0],["وفي ثلاثين وستٍّ ترى","بنتِ لبونٍ ثم تستتبعُ",22,"ع",1,0],["وَفي ثَغرِهِ خَمرٌ وَبَينَ شِفاهُهُ","رِضابُ رِضاها في الشَتيتَينِ كَوثَرُ",23,"ر",1,0],["وفي ثلاثة عشر مات مجتهداً","وقلد الأمر أقواهم بغير خفا",24,"ف",2,0],["وفي ثلاثة وعشرين الشهادة قد","سيقت إبليه بفرض الصبح إذ وقفا",24,"ف",2,0],["وفي ثلاثين حولاً كان مدتهم","فيها الهدى بين أهل الأرض قد عكفا",24,"ف",2,0],["وفي ثغرها أقاح","وفي الوجنتين ورد",25,"د",1,0],["وفي ثغره ورد منعت وُروده","وما ضرّه لو جاد بالورد والوِرد",26,"د",1,0],["وفي ثيبا أنا في صر","ح إيتينٍ لعيشٍ شجى",27,"ج",2,0],["وَفي ثُغرِ أَلفِيا في طَرَفِ","فيلوسَ قامَت فَوقَ تَلٍّ مُشرِفِ",28,"ف",1,0],["وفي ثلاثٍ بِبَنِي سِيما أَتى","إِبنُ شَرُوفُسٍ وأَغلايا الفتى",29,"ت",2,0],["وفي ثلاثينَ مَلا فِيلبُّسِ","وَأَنطِفُوسٍ وَلَدَي ثَسَّالُسِ",29,"س",1,0],["وفي ثرى وادي السلام انهملت","عيناي لا وادي العقيق الدائر",30,"ر",1,0],["وفي ثنا فاضل أبدي الفضايل في","نظمٍ توفي به الأيامُ موعودي",31,"د",2,0],["وفي ثراها شياطينٌ مصنفةٌ","لآل بيت الهدى في زعمهم طينا",32,"ن",2,0],["وفي ثامن من شهرماي14 فضيحة","من القتل والإفساد أبشعه خَرْبا",33,"ب",2,0],["وفي ثَغري حروفٌ ليسَ أدري","لها معنًى سوى هَجرِ الملَلْ",34,"ل",1,0],["وفي ثراها بذورُ النَّشرِ حاضرةٌ","حتى يعيدَ بأمرِ البعثِ مولاها",35,"ا",3,0],["وفي ثالث العشرين تطلع نثرة","وخامس أن لا تنظر الطرف ذا شزر",36,"ر",1,0],["وفي ثوبين قد صُبِغَا","صباغَ الخدِّ والحدَق",37,"ق",1,0],["وفي ثمدٍ أهوى َ بسهمٍ فلمْيزلْ","يجيشُ لهمْ بالريِّ منْ غيرِ حافرِ",38,"ر",1,0]]}