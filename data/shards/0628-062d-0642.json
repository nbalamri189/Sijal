587,"بخفق فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=196773",""],[5688,"رفقا بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200758",""],[5704,"جفاءٌ .. فصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=191336",""],[5732,"عشقت الورد","https://www.poetsgate.com/ViewPoem.aspx?id=177951",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5785,"يا من يغير البدر جنح الأسحار","https://www.poetsgate.com/ViewPoem.aspx?id=131577",""],[5790,"حلفتم لنا أن لا تخونوا فخنتم","https://www.poetsgate.com/ViewPoem.aspx?id=112127",""],[487,"دعوناك لما أن تقلب دهرنا","https://www.poetsgate.com/ViewPoem.aspx?id=129710",""],[487,"إلهي بأهل السر والنقطة التي","https://www.poetsgate.com/ViewPoem.aspx?id=129590",""],[5956,"بحقل الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=182640",""],[5956,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=192541",""],[6101,"مبتور عدوك / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[1387,"غفرانك اللهم يا رباه","https://diwany.org/%D8%BA%D9%81%D8%B1%D8%A7%D9%86%D9%83-%D8%A7%D9%84%D9%84%D9%87%D9%85-%D9%8A%D8%A7-%D8%B1%D8%A8%D8%A7%D9%87/","الرجز"],[463,"بعثتُ لقلبي الهمَّ يومَ هويتكمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60133&r=&rc=189",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""]],"verses":[["بِحَقٍّ كانَ أَوّلَهُم وُلوجاً","عَلى هَولٍ وَآخِرَهُم خَراجا",0,"ج",2,0],["بِحَقِّ الهَوى لا تَعذِلوني وَأَقصِرو","عَنِ اللَومِ إِنَّ اللَومَ لَيسَ بِنافِعِ",1,"ع",1,0],["بِحَقِّ مَا بَيْنَنَا يَا سَاكِني الْقَصَبَة","رُدُّوا عَلَيَّ حَيَاتِي فَهْيَ مُغْتَصَبَهْ",2,"ه",1,1],["بِحَقَّتِها حُبِسَت في اللَجي","نِ حَتّى السَديسُ لَها قَد أَسَن",3,"ن",1,0],["بِحَقِّكَ إِن تَنطُق تَقُل غَيرَ مُهجِرٍ","صَواباً وَإِن يَخفَف حَصى القَومِ تَرزُنِ",4,"ن",1,0],["بِحَقِّ تِلكَ القُبَلِ الطِيابِ","بَعدَ التَجَنّي مِنكِ وَالعِتابِ",5,"ب",1,0],["بِحَقِّ امرِئٍ يَجري فَيُحسَبُ سابِقاً","بَنو هَرِمٍ وَاِبنا سِنانِن حَلائِبُه",6,"ب",2,0],["بِحَقِّ المُستَجيرِ يَخافُ رَوعاً","إِذا أَمسى بِحَبلِكَ أَن يَناما",7,"م",2,0],["بِحَقِّكُمُ أمسَت قُرَيشٌ تَقُودُنا","وبِالفَذِّ مِنها والرَّدِيفَينِ نُركَبُ",8,"ب",1,0],["بحقّك قلْ لي أينَ من طارَ ذكره","فأصبح في كلِّ البقاع له وَكرُ",9,"ر",1,0],["بحقِّ الركوب لمن قالها","على عنق الضِّدِّ بالغاشيه",10,"ي",2,0],["بحقِّك أمطرتَ الورى وبحقهمْ","لأنهُمُ أرضٌ وأنتَ سماءُ",11,"ا",2,0],["بحقِّهمُ أن باعدوني وقَرَّبوا","سِواي وتقريبُ المُباعَد أوجبُ",12,"ب",1,0],["بحقِّ من أعلاك فوقَ الورى","إحلافةً بالحق أحلفْتُها",13,"ت",3,0],["بحقّ مَن تُوجَب الحقوقُ لهُ","من هاشميِّيك أنجم الدهرِ",14,"ر",1,0],["بحقه المسكين لم يعطني","غير الهواهي والمخاريق",15,"ق",1,0],["بحقّ منْ أنت راجيه وخائفُهُ","جُدْ باغتفارٍ وأخْمِدْ بعض نيْرانك",16,"ك",1,0],["بحقّ ذاك الذي يقومُ مقا","مَ التاجِ للمَلكِ والأكاليلِ",17,"ل",1,0],["بحقِّ الوزيرِ بنِ الوزيرِ وعَيْشِهِ","تأمَّلْ مليَّاً هل على العَفْوِ نادمُ",18,"م",1,0],["بِحَقِّ اللَهِ مَتِّع","ني مِن وَجهِكَ بِالبُعدِ",19,"د",1,1],["بِحَقّ لَخمٍ وَطيٍّ","وَكِندَةً وَمُرادِ",20,"د",1,0],["بحق أبْغَضَ الشِّيعَ","ةُ عنديَ يومَ الاثنينِ",21,"ن",1,0],["بِحَقِّ وَلِيٍّ بَينَ يوسُفَ عيصُهُ","وَبَينَ أَبي العاصي وَبَينَ أَبي حَربِ",22,"ب",1,0],["بِحَقِّ اِمرِئٍ بَينَ الوَليدِ قَناتُهُ","وَكِندَةَ فَوقَ المُرتَقى يَتَصَعَّدُ",23,"د",1,0],["بِحَقِّكَ تَحوي المَكرُماتِ وَلَم تَجِد","أَباً لَكَ إِلّا ماجِداً وَاِبنَ ماجِدِ",24,"د",1,0],["بِحَقّي أُضيمُ العالِمينَ بِخِندِفٍ","وَقَد قَهَرَ الأَحياءَ مِنّا قَهورُها",25,"ر",3,0],["بِحَقِّ اِمرِئٍ لا يَبلُغُ الناسُ قِبصَهُ","بَنو البَزَرى مِن قَيسِ عَيلانَ ناصِرُه",26,"ر",2,0],["بِحَقّي أَن أَكونَ إِلَيكَ أَسعى","وَفي يَدِكَ العُقوبَةُ وَالنَوالُ",27,"ل",1,0],["بِحَقِّ اِمرِئٍ أَضحى أَبوهُ اِبنَ دارِمٍ","وَضَبَّةَ مِنها المُجِباتُ الكَرائِمُ",28,"م",1,1],["بحقّكمُ أن تملكوا الناس أعبُدا","سواء رقيق منهمُ وعتيق",29,"ق",1,0],["بحقّ تلك السما","تِ عند مولى عِنانِ",30,"ن",1,0],["بحقّ تلك التي لم","ترع من الهجرانِ",30,"ن",1,0],["بحقِّ بيت النارِ","والدينِ والزنهارِ",31,"ر",1,0],["بحقِّ المهر كانِ ونؤكروز","ومرحف امساه الكبيسِ",32,"س",1,0],["بحقِّ دينِ النصارى","عليكَ في الأديان",33,"ن",1,1],["بحَقّ عِصيانيَ اللّاحي عليك وما","بأضلُعي طاعةً للوَجْدِ من وهَجِ",34,"ج",1,0],["بحقِّ عُلاكَ وهو هُدىً ونورٌ","وحقِّ هَواكَ وهو عُلاً وكسْبُ",35,"ب",1,0],["بِحَقِّ الهَوى لا تَعذِلوني وَأَقصِروا","عَنِ اللَومِ إِنَّ اللَومَ لَيسَ بِنافِعِ",36,"ع",1,0],["بِحَقِّ أَبيكَ داوي جُرحَ قَلبي","وَرَوِّح نارَ سِرّي بِالمَقالِ",37,"ل",1,0],["بحَقّ امرِىءٍ بَينَ الوَليدِ قَنَاتُهُ","وَكِنْدَةَ فَوْقَ المرُتَقَى يَتَصَعّدُ",38,"د",1,0],["بِحَقّ وَليٍّ بَينَ يُوسُفَ عِيصُهُ","وَبَينَ أبي العاصي وَبَينَ بَني حَرْبِ",39,"ب",1,0],["بحَقّ امْرِىءٍ لا يَبْلُغُ النّاسُ قِبصَهُ","بَنو البَزَرَى من قيس عيلان ناصرُهْ",40,"ر",2,0],["بحَقّ امرىءٍ أضْحَى أبُوهُ ابنَ دارِمٍ","وَضَبّةَ مِنْهَا المُنْجِبَاتُ الكَرَائِمُ",41,"م",1,1],["بِحقّ أُدْماناتِها الخوازل","أبكارِهنّ الغيدِ والمطافل",42,"ل",1,0],["بحق مَن تُجب الحقوقُ لهُ","من هاشميِّيك أنجم الدهرِ",43,"ر",1,0],["بحق عينيك ترفق بفتى","يشهد في نحوله العيان",44,"ن",1,0],["بحق هواك يا من من جفاه","كما يبغي تناهبني السقام",45,"م",1,0],["بحقك يا مثير العيس ليلا","وساحات الحجيج لها التطام",46,"م",1,0],["بحقك بالقبول اشمل ضراعي","لانشط والقبول هو الختام",46,"م",1,0],["بحقوق الهوى بود قديم","لا ترع بالصدود من برعاكا",47,"ك",2,0],["بحقك ان نهزت العيس صبحا","فطر باخي التوله للعراق",48,"ق",1,0],["بحقكما رفقا بمضنى موله","كثير هيام لم يكن قلبه معه",49,"ع",2,0],["بحقكم يا جيرة الشعب اتحفوا","عبيدكم بالوصل إن الجفا يزري",50,"ر",2,0],["بحقكم ردُّوا العدات ودمروا","وحَلوا بحسن الفضل عبدكم هذا",51,"ذ",2,0],["بِحَقٍّ وَقُل فيهِ وَلا تَخشَ مُنحيا","بَذولٌ فَلا جَدبٌ إِذا بَخِلَ الحَيا",52,"ي",2,0],["بِحَقِّها يا هَوَاها أَغْرِ هَجْرَكَ بِي","إِذا تَمَنَّيْتُ مِنْها هَجْرَ وَصْلِيها",53,"ي",3,0],["بحقكم يا هاجرين تداركوا","عمارة جسمي اليوم فهو خراب",54,"ب",1,0],["بحقوق الحبّ المبرّح إرحم",