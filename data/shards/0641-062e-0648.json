{"poems":[[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[91,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[46,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[146,"وعيشكم لا ورد الحوم","https://www.aldiwan.net/poem58424.html","السريع"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[211,"أبلغ سراة بني شهاب كلها","https://www.aldiwan.net/poem27976.html","الكامل"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[520,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[543,"تأخرت عن صوغ القريض له قصدا","https://www.aldiwan.net/poem48216.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122771","الطويل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110733","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48785","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199818","المسحوب"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100248","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91111","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135457","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94585","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117229","الوافر"],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[5212,"زعيمُ الحوزةِ الكُبرى","https://www.poetsgate.com/ViewPoem.aspx?id=212056",""],[307,"عاشق الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=213651",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""]],"verses":[["فَخَوى وَما مِن ذي شَبا","بٍ دائِمٍ أَبَداً شَبابُه",0,"ب",2,0],["فخول الشعب حقو","ق الامم المجاوره",1,"ر",2,0],["فَخَولانٌ فَيَحصُبُ كانَ فيهِم","وَفيها غالَهُم عَجبٌ عَجيبُ",2,"ب",1,0],["فَخُوراً بِرَحْبِ الصَّدْرِ وَالكَفَلِ الخَدْلِ","فَآلَى لَهَا يَوْماً بِأَنْ يَتَأَهَّلاَ",3,"ل",2,0],["فخوضُها في غَمراتِ الهوى","لأنّه يندُرُ فيها الدَّمُ",4,"م",1,0],["فَخَوفُكَ في صَدرِهِ ماثِلٌ","وَأَمرُكَ في صَرفِهِ مُمتَثَل",5,"ل",1,0],["فِخّوا بِأَطرافِ الأُنوفِ وَأَمهِلوا","عَنكُم قَوادِمَ صِرمَةِ الأَعرابِ",6,"ب",1,0],["فخَوْفُهمُ لم يَتَّرِكْ لهُم يَداً","ولم يُبْقِ مِن أبطالِهم مَن يقاوِم",7,"م",1,0],["فخوفه منك إشفاقاً يباعده","وظنه منك بالإحسان واعده",8,"د",2,0],["فخورٌ بِكم لم ينسَ أنعُمَك التِي","عليها مدَى الأيام يحمَدُكُم حَمدا",9,"د",2,0],["فَخَوَّلتُ ما خُوِّلتُ مِنهُ عَلَى هدىً","وَأُوتيتُ ما أُوتيتُ مِنهُ عَلَى عِلمِ",10,"م",1,0],["فخود تحياتي مدى الدهر والمدى","تزف إليه بالثنا الباهر الوقد",11,"د",1,0],["فخور أنت بي فيه وإني","على كل العباد بك الفخور",12,"ر",1,0],["فخوضته بحرا من النور آخذا","بقصته أسقيه من شدة الظما",13,"م",2,0],["فَخُوضُوا فيهِ حِفظَاً واعتقاداً","تنالوا جِنسَ أَصنافِ المَنالِ",14,"ل",1,0],["فخورٍ بالوسام اللّي هديته","وفخري بك على هذا رقيّه",15,"ي",2,0],["فخوف جميع المبطلين لسطوتي","وحسن رجا الأخيار طراً شواهدي",16,"د",2,0],["فخوَّلهُ السلامة وارتضاه","أمام هدى لنهي واقتراح",17,"ح",1,0],["فخوِّل لتذليل الكرام لئامَها","فَمَن رامَ قنص الصَيد للكلب يحرج",18,"ج",1,0],["فخوذوا ذوي الهمات للسفر للعلى","وإياكم مكثاً ذوو المكث باليا",19,"ي",2,0],["فَخُوذَةَ آذِيسَ أَلقَت عَلَيها","لِتَخفَى عَلَيهِ وَيَبدُو لَدَيها",20,"ه",2,0],["فخول فطرقل صون الخلايا","وأما سلامته فأبى",21,"ب",2,0],["فخَوِّلهُ يا رحمان صبراً مُجمَّلاً","وأوقيهِ يا ربّاهُ شرَّ العواطبِ",22,"ب",1,0],["فخوَّله الولا بولا حميدٍ","بحزم فراسةٍ والاتكال",23,"ل",1,0],["فخوفي من قطيعتكم براني","وأورثني المذلة والخمولا",24,"ل",2,0],["فخوف أخا جهل يلوم على الهوى","مجال حليف الوجد فيه ورعبه",25,"ب",2,0],["فَخورٌ مَنْ بِوادي اللهِ مَسْكَنُهُ","فَكَيْفَ إِذا ضَجيعٌ كانَ قُرْبَ عَلي!",26,"ل",2,0],["فَخَوفِي بعدَما مُلئَتْ عُيوني","رَحِيلاً زادَهُ بالهَجْرِ دَاءُ",27,"ا",2,0],["فخواطر الإيمان في قلب الفتى","للخير أصل ليس ذا إشكال",28,"ل",1,0]]}