{"poems":[[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49974","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21661","المنسرح"]],"verses":[["كَفَضلِ جَوادِ الخَيلِ يَسبِقُ عَفوُهُ ال","سِراعَ وَإِن يَجهَدنَ يَجهَد وَيَبعُدِ",0,"د",1,0],["كَفَّ ضَرْبَ الكُماةِ في كُلّ هَيْجٍ","فَضَلاتٌ مِنْ ذَيْلِها المَسْحُوب",1,"ب",1,0],["كفضة قد موّهت بالتبر","ثم صلاة الله والتسليم",2,"م",1,0],["كفضل أم المؤمنين عائشة","على النساء ميتة وعائشة",3,"ه",1,0],["كفضل ذهل وحسنى يعرب ابتدرا","تلك المكارم لم يمنعهما قِصرُ",4,"ر",1,0],["كَفِضَّةِ الكَنزِ أُشرِبَت ذَهَباً","يَكادُ طَرفُ الجَليسِ يَكلِمُها",5,"م",3,0]]}