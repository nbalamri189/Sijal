{"poems":[[47,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[30,"أباهل هل أنتم مغير لونكم","https://www.aldiwan.net/poem5559.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[30,"أباهل هل أنتم مغير لونكم","https://www.poetsgate.com/ViewPoem.aspx?id=20998",""],[164,"بجود يديك أورقت الغصون","https://www.aldiwan.net/poem59070.html","الوافر"],[170,"يشقى المعيل بقلب ضيق كمدا","https://www.aldiwan.net/poem47092.html","البسيط"],[239,"فعلت وأنجزت فعل الكرام","https://www.aldiwan.net/poem31921.html","المتقارب"],[410,"أتى الدهر من حيث لا أتقي","https://www.aldiwan.net/poem50144.html","المتقارب"]],"verses":[["وَإِن يَطَّلِب مَسعاةَ مَجدٍ بَعيدَةٍ","يَنَلها بِجَدٍّ أَريَحِيٍّ وَوالِدِ",0,"د",1,0],["وَإِن يَطَّلِع نَجداً تَعَضّوا بَنانَاكُم","عَلى حينَ لا تُغني نَدامَةَ نادِمِ",1,"م",1,0],["وإن يطلع عليكم قرن والٍ","يَخِرُّ بكم إلى الأرض السجود",2,"د",1,0],["وَإنْ يَطّلِعْ نَجْداً تَعضّوا بَنانَكُمْ","على حِينَ لا تُغْني نَدامَةُ نَادِمِ",3,"م",1,0],["وإني طامع ان سوف تنسى","مكاني من ظلالكم مكين",4,"ن",1,0],["وإن يَطشْ وَتدٌ ما بينَ فخذِكَ فاشْ","ججهُ فقدماً أذاقوا الشجّةَ الوَتدا",5,"د",2,0],["وَإِنَّي طَويلُ لِسانِ الثَناءِ","عَليكَ وَلَكِنَّني موجِزُ",6,"ز",1,0],["وَإِنّي طود إِذا صادمته","رياحُ الحَوادِث لَم يَقلقِ",7,"ق",1,0]]}