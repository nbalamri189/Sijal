{"poems":[[47,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[30,"أباهل هل أنتم مغير لونكم","https://www.aldiwan.net/poem5559.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[30,"أباهل هل أنتم مغير لونكم","https://www.poetsgate.com/ViewPoem.aspx?id=20998",""],[164,"بجود يديك أورقت الغصون","https://www.aldiwan.net/poem59070.html","الوافر"],[170,"يشقى المعيل بقلب ضيق كمدا","https://www.aldiwan.net/poem47092.html","البسيط"],[240,"فعلت وأنجزت فعل الكرام","https://www.aldiwan.net/poem31921.html","المتقارب"],[412,"أتى الدهر من حيث لا أتقي","https://www.aldiwan.net/poem50144.html","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38966","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38445","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199440","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118369","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118343","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137134",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135622","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136056","الرجز"],[1901,"عدتْك كرائمُ الديَمُ الغوادي","https://www.poetsgate.com/ViewPoem.aspx?id=160388",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""]],"verses":[["وَإِن يَطَّلِب مَسعاةَ مَجدٍ بَعيدَةٍ","يَنَلها بِجَدٍّ أَريَحِيٍّ وَوالِدِ",0,"د",1,0],["وَإِن يَطَّلِع نَجداً تَعَضّوا بَنانَاكُم","عَلى حينَ لا تُغني نَدامَةَ نادِمِ",1,"م",1,0],["وإن يطلع عليكم قرن والٍ","يَخِرُّ بكم إلى الأرض السجود",2,"د",1,0],["وَإنْ يَطّلِعْ نَجْداً تَعضّوا بَنانَكُمْ","على حِينَ لا تُغْني نَدامَةُ نَادِمِ",3,"م",1,0],["وإني طامع ان سوف تنسى","مكاني من ظلالكم مكين",4,"ن",1,0],["وإن يَطشْ وَتدٌ ما بينَ فخذِكَ فاشْ","ججهُ فقدماً أذاقوا الشجّةَ الوَتدا",5,"د",2,0],["وَإِنَّي طَويلُ لِسانِ الثَناءِ","عَليكَ وَلَكِنَّني موجِزُ",6,"ز",1,0],["وَإِنّي طود إِذا صادمته","رياحُ الحَوادِث لَم يَقلقِ",7,"ق",1,0],["وَإِنّي طَلَبت الوَصلَ مِنها بِنَظرة","فَقالَت بِشرطٍ إنْ قبلتَ به تُعطى",8,"ط",2,0],["وَأَن يَطول في تَقطيعِهِ زمناً","عَساهُ يَملَأ مِن رُؤياهُ أَجفاني",9,"ن",2,0],["وإن يطمع الأعداء فرط تذللي","فحاشاك معزولاً وعتباك واليا",10,"ي",2,0],["وان يطلع ذو اللوم قولا لعله","يكون لغيب الامر غير مطالع",11,"ع",1,0],["وان يطول على رغم الحسود مع السابين","منك على سمت الهدى العمر",12,"ر",1,0],["وأن يطأن على هام الكماة إذا","لف الوغى بهواديها تواليها",13,"ي",3,0],["وان يطو منه الرمس اعظم ماجد","فما زال منشوراً بغر الشمائل",14,"ل",1,0],["وإن يطالبهم بحريةٍ","فهو عدو لهم ازرق",15,"ق",1,0],["وإن يطع صديقُك العدوَّ قدْ","شاركه في ذا العداوة ورَدْ",16,"د",1,0],["وإن يُطِعْ صديقُكَ العدوَّ قدْ","شاركَهُ في ذي العداوةِ ورَدْ",17,"د",1,0],["وإن يطرفَ ثراها الآن طرفي","فقبلاً شاقَ أَنافَ الأعادي",18,"د",2,0],["[ وَإِنْ يَطَّبِينِي مِنْهُ وَعْدٌ تَخَلَّفَتْ","طَبائِعُهُ عَنِّي وَلَمْ يَصْدُقْ الوَعْدُ ]",19,"د",1,0]]}