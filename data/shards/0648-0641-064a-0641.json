ُ في أغوارِ لوحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=205053",""],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[5431,"نبيل","https://www.poetsgate.com/ViewPoem.aspx?id=197967",""],[5493,"أسرار الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=197477",""],[5616,"حرص","https://www.poetsgate.com/ViewPoem.aspx?id=207652",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5781,"بعضٌ من حب","https://www.poetsgate.com/ViewPoem.aspx?id=202852",""],[402,"دعا الوفاء وهذا وقت تبيان","https://www.poetsgate.com/ViewPoem.aspx?id=36473",""],[5854,"أذكيتَ نيرانَ وجدي يا نسيمُ كفى ((بين الحاء والباء))","https://www.poetsgate.com/ViewPoem.aspx?id=197020",""],[5989,"ليت أنك قد ذقتا","https://www.poetsgate.com/ViewPoem.aspx?id=181497",""],[6078,"ياأيُّها المتعبون","https://www.poetsgate.com/ViewPoem.aspx?id=202779",""],[6225,"تقويم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80905&r=&rc=174",""],[463,"تعجبُ من صبري على ألوانها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60266&r=&rc=322",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[5190,"ثمن الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78316&r=&rc=29",""]],"verses":[["وفي فدك لما أجازوا إغتصابها","بتحريمِ ميراث السليل لمرسَل",0,"ل",1,0],["وَفي فؤادي تَبَوَّأتْ وَطناً","وَكان بالأَبرَقَينِ مَعهَدُها",1,"د",3,0],["وفِيَّ فَضائِلٌ يُغْنينَ عَنْهُمْ","بِها أوْطَأتُ أخمَصِيَ الهِلالا",2,"ل",2,0],["وَفِي فُرُعِهَمَا مَن تُسْتَدَامُ بِهِ","خَيْرُ الحَيَالتَيْنِ لِلْبَاقِي وَلِلْفَاني",3,"ن",2,0],["وفي فروع الأشجار بيتي","فالظل فوقي والزهر تحتي",4,"ي",1,0],["وفي فمها بان ابتسام كأنها","تشاهد شخص الزوج فيما تخيَّلُ",5,"ل",1,0],["وَفي فَمِ البَحرِ لِمَن جاءَهُ","لِسانُ أَرضٍ فاقَ فُرضاتِهِ",6,"ت",2,0],["وَفي فِرسالَ قَد جِئتَ العُجابا","بَسَطتَ الجَيشَ تَقرَؤُهُ كِتابا",7,"ا",1,0],["وَفي فَنائي فَنا فَنائي","وَفي فَنائي وَجَدتَ أَنتا",8,"ت",2,0],["وَفي فَناءِ المُلوكِ مُعتَبَرٌ","كَفى بِهِ حُجَّةً عَلى السَوقِ",9,"ق",1,0],["وَفي فيكِ جَنى النَحلُ","وَما أَحلاهُ مِن فيكِ",10,"ك",1,0],["وَفيفَ الريحِ إِذ دَلَفَت مَعَدٌّ","بِأَجمَعِها وَأُسرَةُ ذي رُعَينِ",11,"ن",1,0],["وفي فتى ذي ملح شاعر","يحسن ما شئت من الشعر",12,"ر",1,0],["وفي فجرِ الزمانِ طلعتِ فجراً","على الدنيا فأيقظتِ النِياما",13,"م",2,0],["وفى فى وفى فى ثم فى فى وفى فى","وفى وجْنتَىْ سلمى أٌقّبل لم أمَلْ",14,"ل",1,0],["وفي فنائي فنا فنائي","وفي فنائي وجدت أنت",15,"ت",1,0],["وفي فيحاء يثرب لي حبيب","يسيل بسر رمشته الجهام",16,"م",1,0],["وفي فراش رسول الله بات وقد","طاف العدا حوله بالمكر والحيل",17,"ل",1,0],["وفي فتح قطر الشام كم سد ثغره","بها الدين اضحى كاسيا بالمحامد",18,"د",1,0],["وفي فؤاديَ من لذعِ الهوى سَقَرٌ","طولَ الزَّمانِ وما أداك ما سَقَرُ",19,"ر",1,0],["وَفي فُؤادي من شجونِ الهَوى","ما في فُؤادِ الشاعِرِ الأَحنَفِ",20,"ف",1,0],["وَفي فُؤادي أَدمُعٌ كُلَّما","فاضَت في آهاتِهِ تعثُرُ",21,"ر",1,0],["وفي فمي سكرةٌ حلوةٌ","قد نغصتها لوزةٌ مره",22,"ه",1,1],["وَفي فمه سكِّينةٌ وَكلاهما","إلى دمِها من شهوةٍ يتمطق",23,"ق",1,0],["وفي فرحي وفي حزني","وفي جدي وفي سمري",24,"ر",2,0],["وَفي فُراتي كُلُّ بِئرٍ عُطِّلَت","فيها اليَواقيتُ وَأَيتامُ الدُرَر",25,"ر",1,0],["وَفي فِرَقِ الجَمعِ اِجتَمَعتُ بِفَرقَةٍ","أَصَبتُ بِهِم قَولُ المُصيبِ مِنَ المُخطي",26,"ط",2,0],["وَفي فُنون الهَوى العذرِيّ لي سَلف","اِن لَم أَرِث حِفظُها عَنهُم فَمَن يَرِث",27,"ث",1,0],["وَفي فَقرِ عافيهِ إِلَيهِ وَسيلَةٌ","كَفى باعِثاً لِلسَيلِ أَن يَتَصَوَّبا",28,"ب",2,0],["وفي فجور وفي زور وفي لعب","وفي غرور وفي عجب وآفات",29,"ت",1,0],["وفي فؤادٍ بسيف البين منصدعٍ","قامتْ حروبُ الهوى فيه على ساقِ",30,"ق",1,0],["وفي فيك لنا خمرٌ","وأنت الخمر والحان",31,"ن",1,0],["وَفي فَرَسٍ نَهدٍ عَتيقٍ جَعَلتُهُ","حِجاباً لِبَيتي ثُمَّ أَخدَمتُه عَبدا",32,"د",2,0],["وفي فمها لقد ختمت","بمرجانٍ على خمرِ",33,"ر",1,0],["وفي فمها المعطار كاس مدامة","سلاف رضاب لا السلاف من الخمر",34,"ر",1,0],["وفي فؤادِيَ لا فَوْدِي قَتِيرُ هوًى","لم يُخْفِهِ الشَّعْرُ إِذْ لم يُبْدِهِ الشَّعَرُ",35,"ر",1,0],["وفيفاءَ تكبو الريحُ في جنَباتِها","ويرجِعُ عنها الطرفُ وهو حَسيرُ",36,"ر",1,0],["وفي فلكِ الأحداجِ بدرُ محاسنٍ","كسَتْهُ أيادي البين ثوبَ سِرارِه",37,"ر",2,0],["وفي فيَّ ماءٌ من بقايا ودادكم","كثيراً به من ماء وجهي أرقتمُ",38,"م",1,0],["وفي فهمه لك نَضنَاضَةٌ","خَدورٌ وفي درعه قَسْورُ",39,"ر",1,0],["وفي فرَحٍ وفي مَرَحٍ تَساوى","صَغيرُ القَومِ فينا والكَبيرُ",40,"ر",1,0],["وفي فرَحٍ وفي مَرَحٍ تَساوت","وفودٌ فيه ماجت كالبُحورِ",41,"ر",1,0],["وفي فترةِ الأَجفانِ والعذرُ لائحٌ","دَعا مُهجتي داعي الغرامِ فلبَّتِ",42,"ت",1,0],["وفي فَضائلهم تتلو مناقبهم","هيَ الّتي ليسَ تُحصى قطّ بالقلمِ",43,"م",1,0],["وفي فؤادي وطرفي أي معجزة","غريق بحر بحر النار مشعول",44,"ل",1,0],["وَفي فَيدَ صَدَّقنا وَجاءَت وُفودُنا","إِلى فَيدَ حَتّى ما تُعَدُّ رِجالُها",45,"ل",3,0],["وَفي فَلكِ العَلياءِ قَد حَلَّ مَنزلاً","بَناهُ مِنَ العَلياءِ أَتقَنَهُ رَصفا",46,"ف",2,0],["وفي فَقدِ نورِ الدّينِ في الدينِ ثلمَةٌ","وَلَيستْ تُسَدُّ الدَّهرَ صاحِ وتُجبَرُ",47,"ر",1,0],["وفى فؤادى حرّ نيران الغضا","والصبر منى عند ذلك انقضى",48,"ض",2,0],["وَفِي فِلَسْطينَ أَشْلاءٌ مُبَعْثَرةٌ","وفي فِلَسْطِينَ أَهلْي أَدْمُعٌ وَدِمَا",49,"م",2,0],["وفي فَمي مِنْ أغاريدِ الحُقولِ شَجًا","سَكَبْتُهُ في مَزاميري وقِيثاري",50,"ر",2,0],["وفي فلج الشُّراة شُراةُ موتٍ","لقوم أحدثوا في الحزم أمرا",51,"ر",2,0],["وفي فضاله مع صفوان متضح","وفي الصحيفة إظهار لما كتما",52,"م",2,0],["وفى فَرعها لو تُستطاع جَنابُها","جنًى يجتنيه المُجتَنى لو ينالُها",53,"ل",3,0],["وَفي فَمِ القَلَمِ المَرفوعُ قائِمُهُ","ماءُ الحَيوةِ بِماءِ الرُشدِ مُمتَزِجُ",54,"ج",1,0],["وفي فضلك طلب","جد بالرضى يا معين",55,"ن",1,0],["وفي فايض الجود الالهي غنيمة","لمثلك ممن يطلب السر من مثلي",56,"ل",2,0],["وَفي فُروعِ الأَيكِ وُرقٌ إِذا","بَلَّ النَدى أَغصانَها تَسجَعُ",57,"ع",1,1],["وفي فعيل نادر وفي فعل","وغير مفرد كمثله عمل",58,"ل",1,0],["وفي فواعل وفي أفعال","أيضا وقس ما شئت من أمثال",59,"ل",1,0],["وفي فانظور بواو اشبعوا","ونحو بيرود للبس يمنع",59,"ع",1,0],["وَفي فرعِهِ وَالفَرق وَالجيد وَالطلى","لِآيات حُسن هُنَّ مِن سُورة الفَجر",60,"ر",1,0],["وفي فلك الأحداج غابوا عن الحمى","وهنّ بأحشائي بدورٌ طوالع",61,"ع",1,0],["وفي فؤادي المصطلي ظلمة","بغير نور الحق لم تُقشَع",62,"ع",1,0],["وفي فؤاد الثور عظم وقد","يعرفه الجازر ذو الخبر",63,"ر",1,0],["وَفي فَتحِ أَبوابِ البَيادِرِ مُثلَةٌ","يُكَلَّفُها وَالظُلم مِمّا يُكَلَّفُ",64,"ف",1,0],["وفي فرقهِ والفرعِ والوجهِ إذ بدا","أرى الناسَ خيط الصبح والليل والبدرا",65,"ر",2,0],["وفي فؤادي لهم نار هوى","لم يطفها ما سحَّ من شؤوني",66,"ن",2,0],["وفي فؤادي ليل البؤس نازلة","دجاه في مهجةٍ فيها الأسى نزلا",67,"ل",2,0],["وَفي فلوات غالِسيا غُزاة","وَهَضب الدردَنيل مُجدَّلينا",68,"ن",2,0],["وفي فضلهم جاءت أحاديث جمة","عن أفضل خلق الواحد الصمد البر",69,"ر",1,0],["وَفي فِكرِهِ السامي خَفي كَظاهر","فَإِن كِلا الأَمرين يَستَويان",70,"ن",1,0],["وفي فؤادي منبع للأسى","تفيض منه مؤلمات الذّكر",71,"ر",1,0],["وفي فلسطين هذا اليوم منقطع","نظيره بهجة في سائر الحقب",72,"ب",1,0],["وَفِي فهمِ الشَّوارِدِ لو تراهَا","بِناءً شَادَ غَنَّى بارتفَاعِ",73,"ع",1,0],["وفي فؤاديَ نار ال","طموح تشعل ذاتي",74,"ت",2,0],["وفي فهم فخر القطر عيد مبارك","زكي له من ذي الفقار صناديد",75,"د",1,0],["وفي فؤاديَ حزن","ولوعة لا تزال",76,"ل",1,0],["وفي فؤادي حسرة","لفرط وجدي أنت هي",77,"ي",1,0],["وَفِى فَعيلٍ وَصفَ عَلٍ ورَد","كَذَاكَ فِى أُنثَاهُ أيضاِّ اطَّرَد",78,"د",1,0],["وفي فعالك فينا","ستضرب الأمثال",79,"ل",1,0],["وَفَى فنثيرُ التبرِ ما جادَ نَثرُه","وَجادَ فَنظمُ الدرّ ما هوَ يَنظم",80,"م",1,0],["وفي فضل وفي عبد الحميد ال","شهامة والزعامة والشداد",81,"د",1,0],["وَفي فَمي لا شَكَّ قَطرُالنَدى","وَشاهِدي فيهِ الثَنايا الحِسانِ",82,"ن",1,0],["وَفِي فَضلِ مَسجِدِكُم وَرَدَت","أحَادِيثُ مَا كَانَ أن تُفتَرَى",83,"ر",2,0],["وفيفاء جُبناها يحار بها الذِّهْن","فؤادي فيها من هواهُ له رهنُ",84,"ن",1,1],["وَفي فَتَراتٍ يَنبَحُ الكَلبُ عابِساً","فَيَعوي لَهُ ذِئبٌ مِنَ الحَقلِ خادِرُ",85,"ر",1,0],["وفي فؤادي غليلُ منتزِحٍ","يعاف إلا الدِّيار تقْتربُ",86,"ب",1,0],["وفي فؤادي من عكس الردى حرق","قد أضرمنها رياح شابها الألم",87,"م",1,0],["وَفي فَجرِ ثضانِي عَشرَ يَوماً مَقَامَهُ","أَتَى زَفسُ في رَهطِ الخُلُودِ الأَفاضلِ",88,"ل",1,0],["وفي فجاجٍ قرب جرف البحر","لدى دوي الموج فوق الثغر",89,"ر",1,0],["وفي فِلاقا بَيتُهُ لم يَكمُلِ","وعِرسُهُ تَبكِيهِ مِلءَ المُقَلِ",90,"ل",1,0],["وَفي فُلكِ الاماني جزتُ بَحراً","وَكانَ السهدُ في سَفَري رَفيقي",91,"ق",2,0],["وَفي فنِّ البيانِ وَفي المَعاني","يَفوقُ فَطاحل العُصُرِ الخَوالي",92,"ل",2,0],["وَفي فَنا قشلَةِ القَنديلِ أسدُ شَرى","قَد تاجَروا اللَهَ تَجراً غَيرَ مَغبونِ",93,"ن",1,0],["وفي فحص التلاميذ اِستنارَت","منارات النهى في ذا الزَمانِ",94,"ن",1,0],["وفي فرعها ليل لعلم معلّم","وفي وجهها عين لعين معاين",95,"ن",1,0],["وفي فيك يا سيِّدي حسرة","ستفنى الحياة ولا تنقضي",96,"ض",2,0],["وفي فَمِي ماءٌ وهَلْ يَنْطِقُ مَنْ","في فِيهِ ماءٌ ساالُوا اهْلَ النُّهَى",97,"ا",1,0],["وَفي فيهِ مِن روحي نُفِختَ كِنايَةً","هَلِ الروحُ إِلّا عَينُهُ يا مُنازِعُ",98,"ع",1,0],["وفي فم الليلِ ، تُلقي كُلّ من حضنوا","حُلمي ، وتنزعُ من أحضانهِ أَجَلَكْ",99,"ك",1,0],["وفي فَمِ الرِّيحِ قَرنٌ، وهي نافِخةٌ","بهِ على الأَرضِ، تَروِيعًا وإِثخانا",100,"ن",2,0],["وفي فلك العليا غدت شهب فضله","لها بسنا الإقبال مسرى ومسرح",101,"ح",1,0],["وفي فَلَكِ الهوى للشعرِ فُلْكٌ","تدورُ وللهوى في القلبِ غِمدُ",102,"د",1,0],["وفي فضله عيد الصيام مؤرخ","حسن سما بالخير والحسن عيده",103,"د",2,0],["وفي فضلك اللهم ارغب دائما","فلا تحرمني المن يا من له الفضل",104,"ل",1,0],["وفي في خوتك منت بمثل طبع الردي جساس","كريم ومدتك مدات حاتم ...لا طلبه الغير",105,"ر",1,0],["وَفِيِ فَلَكِ النُّجُومِ تَرَى سُمُوِّي","ضِيَاءُ الرُّوْحِ فِيْ كَاسِيْ سَكَبْتُ",106,"ت",1,0],["وفي فلسطينَ حبلٌ ليس منقطعاَ","في الأرض جذرٌ ويعلو للسماواتِ",107,"ت",1,0],["وفي فنجاني الصاحي أرى شبحاً","من الماضي يعيد الأمن في نفسي",108,"س",2,0],["وفيٌ في المحبة مثل نخلٍ","كريمٌ مثل سلطان البلاط",109,"ط",1,0],["وفي فجرِ قلبِي تذوبُ المعَانِي","فتصفُو المرَايَا بأغْوارِهِ",110,"ر",2,0],["وفي فجرِ الكلام غرقتُ صمتاً","لأنّ النّطقَ دون فمٍ عويصُ",111,"ص",1,0],["وفي فَرَاغَاتِهِ صِنّارَتا حُلُم","شطآنهُ أمنْهُُ,, والرّعْبُ بَغّاتُ",112,"ت",1,0],["وَفي فَتْحَةِ الحَرْفِ انْقِشاعُ أَطايِبٍ","فَمَنْ في نَدِيَّاتِ الشِّفاهِ يبُزُّهُ؟",113,"ز",2,0],["وفي فرعهما من تستدام به","ير الحياتين للباقي وللفاني",114,"ن",2,0],["وفي فؤادي طغتْ أمواجُ قافيتي","جاش الحنينُ به واهتاجَ واغترفا",115,"ف",2,0],["وفي فلك العشاق دار مُسَلماً","بقوة جذبٍ من عيونك أرسلتا",116,"ت",2,0],["وفي فم التائهين اليومَ أغنيةٌ","تَجترُّ حسرتَها ألحانُ مُجتَرِئِ",117,"ا",1,0],["وفي فرَحٍ يكونُ الحزنُ ليلا","يكبّلُ بالضحى ألقا قويا",118,"ي",2,0],["وفي فؤادي لهواك رتبة ٌ","لا يصل العشقُ إلى مكانها",119,"ن",3,0],["وفي فمي بسمة مذ هولة جمعت","من النقيضين فيها الصدق والعجب",120,"ب",1,0],["وفي فراقِ حبيبٍ قد حُرِمتَ بِهِ","طعمَ الكرى والهنا يا صاحبي مللُ ؟",121,"ل",1,0]]}