{"poems":[[108,"خليلي","https://www.shoaraa.com/p11134",""],[63,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[93,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[88,"سمعت شعرا للعندليب","https://www.aldiwan.net/poem44413.html","مخلع البسيط"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[85,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[58,"رأيت ربي بعين قلبي","https://www.aldiwan.net/poem31117.html","مجزوء البسيط"],[49,"ما أغفل الناس والخطوب بهم","https://www.aldiwan.net/poem62182.html","البسيط"],[49,"أجاب الله داعيك","https://www.aldiwan.net/poem64262.html","الهزج"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/199536","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[64,"رأَيتُ ربّي بعين قلبِ فقلتُ","https://www.poetsgate.com/ViewPoem.aspx?id=8522",""],[116,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[116,"كنز المقل سلاح الخائف الوجل","https://www.aldiwan.net/poem40858.html","عموديه"],[116,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[167,"ما أنس لا أنسه والبين جد به","https://www.aldiwan.net/poem47073.html","البسيط"],[224,"ألدمع من عيني لم يذرف","https://www.aldiwan.net/poem41626.html","السريع"],[224,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[257,"وفي فمي سكرة حلوة","https://www.aldiwan.net/poem48400.html","السريع"],[299,"إذا أصبح الجزار للسرب راعيا","https://www.aldiwan.net/poem36836.html","الطويل"],[343,"إليك إليك يا وطني","https://www.aldiwan.net/poem55317.html","مجزوء الوافر"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[350,"خلعت بلبس العز ثوب تنكسي","https://www.aldiwan.net/poem15761.html","الطويل"],[362,"يا عاذلي لا تلمني انه عبث","https://www.aldiwan.net/poem68128.html","البسيط"],[367,"ورثت المعالي عن أبيك شريعة","https://www.aldiwan.net/poem17161.html","الطويل"],[392,"يا حسرتي ضاع عمري في البطالات","https://www.aldiwan.net/poem54608.html","عموديه"],[403,"نقضت بعد النوى عهدي وميثاقي","https://www.aldiwan.net/poem46540.html","البسيط"],[417,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[421,"يعاتبني في الدين قومي وإنما","https://www.aldiwan.net/poem4848.html","الطويل"],[430,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[430,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[433,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[433,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[433,"بعينيه شكري لا بكأس عقاره","https://www.aldiwan.net/poem12787.html","الطويل"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[539,"أتى بقدوم فاطمة البشير","https://www.aldiwan.net/poem48146.html","عموديه"],[539,"تشرفت الأحبة بالحضور","https://www.aldiwan.net/poem48189.html","عموديه"]],"verses":[["وفي فدك لما أجازوا إغتصابها","بتحريمِ ميراث السليل لمرسَل",0,"ل",1,0],["وَفي فؤادي تَبَوَّأتْ وَطناً","وَكان بالأَبرَقَينِ مَعهَدُها",1,"د",3,0],["وفِيَّ فَضائِلٌ يُغْنينَ عَنْهُمْ","بِها أوْطَأتُ أخمَصِيَ الهِلالا",2,"ل",2,0],["وَفِي فُرُعِهَمَا مَن تُسْتَدَامُ بِهِ","خَيْرُ الحَيَالتَيْنِ لِلْبَاقِي وَلِلْفَاني",3,"ن",2,0],["وفي فروع الأشجار بيتي","فالظل فوقي والزهر تحتي",4,"ي",1,0],["وفي فمها بان ابتسام كأنها","تشاهد شخص الزوج فيما تخيَّلُ",5,"ل",1,0],["وَفي فَمِ البَحرِ لِمَن جاءَهُ","لِسانُ أَرضٍ فاقَ فُرضاتِهِ",6,"ت",2,0],["وَفي فِرسالَ قَد جِئتَ العُجابا","بَسَطتَ الجَيشَ تَقرَؤُهُ كِتابا",7,"ا",1,0],["وَفي فَنائي فَنا فَنائي","وَفي فَنائي وَجَدتَ أَنتا",8,"ت",2,0],["وَفي فَناءِ المُلوكِ مُعتَبَرٌ","كَفى بِهِ حُجَّةً عَلى السَوقِ",9,"ق",1,0],["وَفي فيكِ جَنى النَحلُ","وَما أَحلاهُ مِن فيكِ",10,"ك",1,0],["وَفيفَ الريحِ إِذ دَلَفَت مَعَدٌّ","بِأَجمَعِها وَأُسرَةُ ذي رُعَينِ",11,"ن",1,0],["وفي فتى ذي ملح شاعر","يحسن ما شئت من الشعر",12,"ر",1,0],["وفي فجرِ الزمانِ طلعتِ فجراً","على الدنيا فأيقظتِ النِياما",13,"م",2,0],["وفى فى وفى فى ثم فى فى وفى فى","وفى وجْنتَىْ سلمى أٌقّبل لم أمَلْ",14,"ل",1,0],["وفي فنائي فنا فنائي","وفي فنائي وجدت أنت",15,"ت",1,0],["وفي فيحاء يثرب لي حبيب","يسيل بسر رمشته الجهام",16,"م",1,0],["وفي فراش رسول الله بات وقد","طاف العدا حوله بالمكر والحيل",17,"ل",1,0],["وفي فتح قطر الشام كم سد ثغره","بها الدين اضحى كاسيا بالمحامد",18,"د",1,0],["وفي فؤاديَ من لذعِ الهوى سَقَرٌ","طولَ الزَّمانِ وما أداك ما سَقَرُ",19,"ر",1,0],["وَفي فُؤادي من شجونِ الهَوى","ما في فُؤادِ الشاعِرِ الأَحنَفِ",20,"ف",1,0],["وَفي فُؤادي أَدمُعٌ كُلَّما","فاضَت في آهاتِهِ تعثُرُ",21,"ر",1,0],["وفي فمي سكرةٌ حلوةٌ","قد نغصتها لوزةٌ مره",22,"ه",1,1],["وَفي فمه سكِّينةٌ وَكلاهما","إلى دمِها من شهوةٍ يتمطق",23,"ق",1,0],["وفي فرحي وفي حزني","وفي جدي وفي سمري",24,"ر",2,0],["وَفي فُراتي كُلُّ بِئرٍ عُطِّلَت","فيها اليَواقيتُ وَأَيتامُ الدُرَر",25,"ر",1,0],["وَفي فِرَقِ الجَمعِ اِجتَمَعتُ بِفَرقَةٍ","أَصَبتُ بِهِم قَولُ المُصيبِ مِنَ المُخطي",26,"ط",2,0],["وَفي فُنون الهَوى العذرِيّ لي سَلف","اِن لَم أَرِث حِفظُها عَنهُم فَمَن يَرِث",27,"ث",1,0],["وَفي فَقرِ عافيهِ إِلَيهِ وَسيلَةٌ","كَفى باعِثاً لِلسَيلِ أَن يَتَصَوَّبا",28,"ب",2,0],["وفي فجور وفي زور وفي لعب","وفي غرور وفي عجب وآفات",29,"ت",1,0],["وفي فؤادٍ بسيف البين منصدعٍ","قامتْ حروبُ الهوى فيه على ساقِ",30,"ق",1,0],["وفي فيك لنا خمرٌ","وأنت الخمر والحان",31,"ن",1,0],["وَفي فَرَسٍ نَهدٍ عَتيقٍ جَعَلتُهُ","حِجاباً لِبَيتي ثُمَّ أَخدَمتُه عَبدا",32,"د",2,0],["وفي فمها لقد ختمت","بمرجانٍ على خمرِ",33,"ر",1,0],["وفي فمها المعطار كاس مدامة","سلاف رضاب لا السلاف من الخمر",34,"ر",1,0],["وفي فؤادِيَ لا فَوْدِي قَتِيرُ هوًى","لم يُخْفِهِ الشَّعْرُ إِذْ لم يُبْدِهِ الشَّعَرُ",35,"ر",1,0],["وفيفاءَ تكبو الريحُ في جنَباتِها","ويرجِعُ عنها الطرفُ وهو حَسيرُ",36,"ر",1,0],["وفي فلكِ الأحداجِ بدرُ محاسنٍ","كسَتْهُ أيادي البين ثوبَ سِرارِه",37,"ر",2,0],["وفي فيَّ ماءٌ من بقايا ودادكم","كثيراً به من ماء وجهي أرقتمُ",38,"م",1,0],["وفي فهمه لك نَضنَاضَةٌ","خَدورٌ وفي درعه قَسْورُ",39,"ر",1,0],["وفي فرَحٍ وفي مَرَحٍ تَساوى","صَغيرُ القَومِ فينا والكَبيرُ",40,"ر",1,0],["وفي فرَحٍ وفي مَرَحٍ تَساوت","وفودٌ فيه ماجت كالبُحورِ",41,"ر",1,0]]}