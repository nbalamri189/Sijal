{"poems":[[53,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[54,"إياك والمطل أن تقارفه","https://www.aldiwan.net/poem27594.html","المنسرح"],[30,"يا حاديي بنت فضاض أما لكما","https://www.aldiwan.net/poem29609.html","البسيط"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"إذا مطلت امرأ بحاجته","https://www.aldiwan.net/poem61984.html","المنسرح"],[43,"دروع لملك الروم هذي الرسائل","https://www.aldiwan.net/poem9969.html","الطويل"],[193,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[233,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[303,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[456,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[456,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[459,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[538,"إذا مطمع يوما غزاني غزوته","https://www.aldiwan.net/poem56860.html","الطويل"]],"verses":[["إِذا مُطِلَ الثَارُ جَرَّ القَنا","نَشاوى تَقاضى صُدورَ الصَفاحِ",0,"ح",1,0],["إِذا مَطَلتَ اِمرَأً بِحاجَتِهِ","فَاِمضِ عَلى مَطلِهِ وَلا تَحِدِ",1,"د",1,0],["إِذا مَطَونا نُسوعَ الرَحلِ مُصعِدَةً","يَسلُكنَ أَخراتَ أَرباضِ المَداريجِ",2,"ج",1,0],["إذا مَطرتْ كفّاهُ بالبذل نَوَّرتْ","له الأرضُ واهتزت رُباها من الخصْب",3,"ب",1,0],["إذا مطلت امرأ بحاجته","فامضِ على منعه ولا تحِدِ",4,"د",1,1],["إِذا مَطَرَت مِنهُم وَمِنكَ سَحائِبٌ","فَوابِلُهُم طَلٌّ وَطَلُّكَ وابِلُ",5,"ل",1,0],["إِذا مَطَرَت جَثَمَت فَوقَها","مُخَوِيَّةٌ زِفُّها يَنطِفُ",6,"ف",1,0],["إِذا مَطَلَت لَمياءُ وَهيَ قَريبَةٌ","فَأَجدَرُ أَن تُلوى الدُيونُ عَلى البُعدِ",7,"د",1,0],["إِذا مُطفآتُ الرضفِ يوماً دَعَتهمُ","أُعيدَ الصفا رضفاً وصمّ الحَصى عبطا",8,"ط",2,0],["إذا مطرت بأرضٍ لم تخضِّر","أراكتَها ولم يُخصِب ثراها",9,"ا",3,0],["إذا مَطَرَتْ ترى الأحسابَ بيضاً","بما يُثنِينَ والأعراضَ خُضْرا",10,"ر",2,0],["إذا مطلتْ أيامُه وعْدَ مَفْخَرٍ","تَعلَّقها فِعْلَ الغَريمِ اليَلَنْدَد",11,"د",1,0],["إِذا مَطمَعٌ يَوماً غَزَاني غَزَوتُهُ","كَتائِبَ ناسٍ كَرَّها واِطِّرادَها",12,"د",3,1]]}