{"poems":[[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[56,"إياك والمطل أن تقارفه","https://www.aldiwan.net/poem27594.html","المنسرح"],[32,"يا حاديي بنت فضاض أما لكما","https://www.aldiwan.net/poem29609.html","البسيط"],[53,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[53,"إذا مطلت امرأ بحاجته","https://www.aldiwan.net/poem61984.html","المنسرح"],[45,"دروع لملك الروم هذي الرسائل","https://www.aldiwan.net/poem9969.html","الطويل"],[199,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[466,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[545,"إذا مطمع يوما غزاني غزوته","https://www.aldiwan.net/poem56860.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83256","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123550","الرجز"],[6211,"أَعنِيهِ، لَيْسَ عَنْهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78533&r=&rc=15",""]],"verses":[["إِذا مُطِلَ الثَارُ جَرَّ القَنا","نَشاوى تَقاضى صُدورَ الصَفاحِ",0,"ح",1,0],["إِذا مَطَلتَ اِمرَأً بِحاجَتِهِ","فَاِمضِ عَلى مَطلِهِ وَلا تَحِدِ",1,"د",1,0],["إِذا مَطَونا نُسوعَ الرَحلِ مُصعِدَةً","يَسلُكنَ أَخراتَ أَرباضِ المَداريجِ",2,"ج",1,0],["إذا مَطرتْ كفّاهُ بالبذل نَوَّرتْ","له الأرضُ واهتزت رُباها من الخصْب",3,"ب",1,0],["إذا مطلت امرأ بحاجته","فامضِ على منعه ولا تحِدِ",4,"د",1,1],["إِذا مَطَرَت مِنهُم وَمِنكَ سَحائِبٌ","فَوابِلُهُم طَلٌّ وَطَلُّكَ وابِلُ",5,"ل",1,0],["إِذا مَطَرَت جَثَمَت فَوقَها","مُخَوِيَّةٌ زِفُّها يَنطِفُ",6,"ف",1,0],["إِذا مَطَلَت لَمياءُ وَهيَ قَريبَةٌ","فَأَجدَرُ أَن تُلوى الدُيونُ عَلى البُعدِ",7,"د",1,0],["إِذا مُطفآتُ الرضفِ يوماً دَعَتهمُ","أُعيدَ الصفا رضفاً وصمّ الحَصى عبطا",8,"ط",2,0],["إذا مطرت بأرضٍ لم تخضِّر","أراكتَها ولم يُخصِب ثراها",9,"ا",3,0],["إذا مَطَرَتْ ترى الأحسابَ بيضاً","بما يُثنِينَ والأعراضَ خُضْرا",10,"ر",2,0],["إذا مطلتْ أيامُه وعْدَ مَفْخَرٍ","تَعلَّقها فِعْلَ الغَريمِ اليَلَنْدَد",11,"د",1,0],["إِذا مَطمَعٌ يَوماً غَزَاني غَزَوتُهُ","كَتائِبَ ناسٍ كَرَّها واِطِّرادَها",12,"د",3,1],["إِذا مَطَرَ الغَيثُ الرِياضَ بِوابِلٍ","فَأَيُّ يَدٍ لِلطائِرِ المُتَرَنِّمِ",13,"م",1,0],["إذا مَطايا العَزْمِ أَخْلَتْ بُرْهةً","سَلِّمْ زِمامَها إلى يَدِ الْقَضَا",14,"ض",2,0],["أَذَا مَطَرٌ هذا الذي هالَ شَعْبَنا","أمِ العيْنُ عينُ الشّعبِ فاجَأَها الهَوْلُ؟",15,"ل",1,0]]}