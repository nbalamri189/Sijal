{"poems":[[129,"ملك بدا ما به زيغ ولا خطل","https://www.aldiwan.net/poem50538.html","البسيط"],[372,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[462,"طربت قوافي الشعر حيث يقودها","https://www.aldiwan.net/poem15179.html","الكامل"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[465,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[515,"فجر الهدى","https://www.aldiwan.net/poem20844.html","مجزوء الرجز"],[515,"فجر الهدى حيدري عم نائله","https://www.aldiwan.net/poem20852.html","البسيط"]],"verses":[["حتفُ العدى لا يبالِي إن به نزلوا","نورُ الدُّنا ليس يأوى ربعَه خَلَلُ",0,"ل",1,0],["حتفُ الفَوارسِ أن دُعيتَ أباً لهَا","وأبو الفَوارسِ للفَوارسِ راحِمُ",1,"م",1,0],["حتفُ الرجال لدى النزال وضربه","والطعنُ حتفُ صوارمٍ ورماحِ",2,"ح",1,0],["حتفي اللحاظ لا السيوف شهرت","أو القدود خطرت لا الأسل",3,"ل",1,0],["حتف المتيم منك يوم قطيعة","وحياته في الحب يوم وصال",4,"ل",1,0],["حتف العدات مع العداة فريقهُ","عذب الجنى مرُّ العذاب لمن جنى",5,"ن",2,0],["حَتفُ العِدَا","سِمطُ الثَّنَا",6,"ن",2,0],["حَتفُ العِدَا صَاعِدٌ تُخشَى نَوازِلُهُ","سمطُ الثَّنَا عِندَ بَيتِ المَالِ صَاحِبُهُ",7,"ب",2,0]]}