{"poems":[[111,"همم الملوك أجلها أعظامها","https://www.poetsgate.com/ViewPoem.aspx?id=533",""],[132,"ملك بدا ما به زيغ ولا خطل","https://www.aldiwan.net/poem50538.html","البسيط"],[376,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[466,"طربت قوافي الشعر حيث يقودها","https://www.aldiwan.net/poem15179.html","الكامل"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[469,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[469,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[519,"فجر الهدى","https://www.aldiwan.net/poem20844.html","مجزوء الرجز"],[519,"فجر الهدى حيدري عم نائله","https://www.aldiwan.net/poem20852.html","البسيط"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120084","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136338","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79946","البسيط"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127385","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94964","الرمل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4862,"أملٌ يجدد للحبيب رجوعا","https://www.poetsgate.com/ViewPoem.aspx?id=55512",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["حتف على الأضداد لفتة رأيه","لمن السيوف ودونهن حمامها",0,"م",3,0],["حتفُ العدى لا يبالِي إن به نزلوا","نورُ الدُّنا ليس يأوى ربعَه خَلَلُ",1,"ل",1,0],["حتفُ الفَوارسِ أن دُعيتَ أباً لهَا","وأبو الفَوارسِ للفَوارسِ راحِمُ",2,"م",1,0],["حتفُ الرجال لدى النزال وضربه","والطعنُ حتفُ صوارمٍ ورماحِ",3,"ح",1,0],["حتفي اللحاظ لا السيوف شهرت","أو القدود خطرت لا الأسل",4,"ل",1,0],["حتف المتيم منك يوم قطيعة","وحياته في الحب يوم وصال",5,"ل",1,0],["حتف العدات مع العداة فريقهُ","عذب الجنى مرُّ العذاب لمن جنى",6,"ن",2,0],["حَتفُ العِدَا","سِمطُ الثَّنَا",7,"ن",2,0],["حَتفُ العِدَا صَاعِدٌ تُخشَى نَوازِلُهُ","سمطُ الثَّنَا عِندَ بَيتِ المَالِ صَاحِبُهُ",8,"ب",2,0],["حَتَفَ اللهُ مَرْدَواجَ بحدّ","منْهُ في أَنْفُس الوَرَى مَرْكُوز",9,"ز",1,0],["حتف العدا غيث الندى","جبل الحجى بحر العلومِ",10,"م",1,0],["حتف العدا فرد ارباب الندى واما","م الجود رحمة ذي ذنب وعصيان",11,"ن",1,0],["حتفُ الحُماة ومقدام السراة له","في الروع سطوة هجّام على النوَب",12,"ب",1,0],["حتفٌ لهم جاء بالنصر القريب لكم","والحتف للفتح في مقلوبه فالُ",13,"ل",1,0],["حتفه يرقبه ما","بين أرض وسماء",14,"ا",2,0],["حتفُ ليلى أرَّخوهُ قد رَوى","في جنان الخلد قد حازت نعيم",15,"م",1,0],["حَتْفُ العَدُوِّ فَلَم يَبْرَحْ عَلى خَطَرٍ","فَسَرِّحِ اللَّحْظَ في بادٍ وَمُحْتَضِرٍ",16,"ر",1,0],["حتفي يكاد يزورني إن لم أجد","أملاً يجدد للحبيب رجوعا",17,"ع",2,0],["حَتْفَاً لِمَنْ ذَبحوا يحيى ووالِدَهُ","ومِنْ زَكِيِّ دِمَانَاْ فَجَّرُوا نَهَرا",18,"ر",2,0],["حتفَ نفس ٍ نذرتُها لهواهنّ","وعهد ٍ أصيبَ بالإخفاقِ",19,"ق",1,0]]}