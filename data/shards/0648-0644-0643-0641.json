{"poems":[[95,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[119,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135793","الرجز"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131653",""],[5461,"تدلل","https://www.poetsgate.com/ViewPoem.aspx?id=6831",""],[5572,"ظبية البان","https://www.poetsgate.com/ViewPoem.aspx?id=53653",""],[5756,"وش اللي يجبر الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=5428",""]],"verses":[["ولَكَ فِي كُلِّ حَالَةٍ عَرَضَتْ","سُنَّةٌ مِنْ طَرَائِفِ السُّنَنِ",0,"ن",1,0],["ولَكفُّ الأمير أحمدُ منه","أثراً في النبات والحيوان",1,"ن",1,0],["ولكف ألاذا ودفع البلايا","وحصول الشفا ومحو العار",2,"ر",1,0],["ولك فيمَن كان مثل الأمو","يِّ أسوةٌ بها اقتدى كلُّ تقي",3,"ق",2,0],["ولك فقري أشدُّ وأشدْ","من الذي غيري من كل أحدْ",4,"د",1,0],["ولك فرسك حلاه كالشهد سايل","وعنقاد القزاقز رأس بازل",5,"ل",1,0],["ولك في خيال الشاعر المهتوي ميعاد","ومجلس على غيمة وليلة قمر نجدي",6,"د",2,0],["ولك في عيوني حلم يا ظبية البان","حلم الدفا بعيون طير الكناري",7,"ر",2,0],["ولك في خافقي صوره تلاشت بين ضي ونور","وأخاف اسكت من الفرحة وتنطق باسمك الصورة",8,"ر",2,0]]}