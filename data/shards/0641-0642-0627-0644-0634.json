{"poems":[[53,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[35,"ألا يا طبيب الجن ويحك داوني","https://www.aldiwan.net/poem25750.html","الطويل"],[228,"مضت أشهر نذرت للمطر","https://www.aldiwan.net/poem39700.html","المتقارب"],[564,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66822","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77595","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131533",""],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96212","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28024","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129938","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204493","البسيط"],[5804,"حوار معا الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=191224",""],[2220,"حسٌّ يفرقُ والأرواحُ تتحدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11285&r=&rc=159",""]],"verses":[["فقال شيخ منهمُ عاقلٌ","فكِّرْ فهادِي النفس تفكيرُها",0,"ر",3,0],["فَقالَ شِياهٌ راتِعاتٌ بِقَفرَةٍ","بِمُستَأسِدِ القُريانِ حُوٍّ مَسائِلُه",1,"ل",2,0],["فَقالَ شِفاءُ الحُبِّ أَن تُلصِقَ الحَشا","بِأَحشاءِ مَن تَهوى إِذا كُنتَ خالِيا",2,"ي",2,0],["فَقالَ شَفيقٌ وَفي قَلبه","رَجاءٌ يَموتُ وَحبٌّ يَثور",3,"ر",1,0],["فقال شَرابي جلَ عما وصَفتهُ","وخمَرتنَا ممّا ذَكَرْتَ لنَا أغلى",4,"ل",2,0],["فقال شقيُّ منهم لِقرينهِ","وكم من شقيٍّ يَستذلُ ويَفتنُ",5,"ن",1,0],["فَقالَ شَيخٌ مَرَّ بِالغُلام","هَذا عمىً في العَين أَم تَعامي",6,"ي",1,0],["فَقالَ شَيخ مِنهُم موقر","المال أَطغاه وَيَبغي المكثر",7,"ر",1,0],["فَقالَ شَيخ ما الَّذي يَمنعه","مِن خطبة الملك وَما يَدفعه",8,"ه",1,0],["فَقالَ شَيخ مِنهُم هَذا كَذب","ما هو مِمَن لِلمحال يَضطَرب",8,"ب",1,0],["فَقال شَيخ عاجز ضَعيف","يَأنف أن يقتله الشريف",9,"ف",1,0],["فقال شان خير لا محذور","سبق اللسان عادة العجلان",10,"ن",1,0],["فقال شفاؤه الرمان مما","تضمنه حشاه من السعير",11,"ر",1,0],["فقال شخص بما الثاني يقلبله","وكلهم ناظر في الله مجتهد",12,"د",1,0],["فقال شبّه فقُلت شمسٌ","قد سدّ من نورِها شعاعُ",13,"ع",1,0],["فقال شكواك هذي طُرفة ندَرت","وما لها في شكاوانا مثيلات",14,"ت",1,0],["فقالَ شيطانُهُمْ في كلِّ ناحيةٍ","جُندي وإنَّ جميعَ الناسِ أشباهُ",15,"ا",2,0],["فقال شخص بما الثاني يقابله","وكلهمْ ناظرٌ في اللهِ مجتهدُ",16,"د",1,0]]}