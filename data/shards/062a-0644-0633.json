{"poems":[[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[305,"شكوت ذهاب طارقتي إليها","https://www.aldiwan.net/poem45496.html","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132093","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86470","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72452","الكامل"],[6323,"قتامة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82176&r=&rc=7",""]],"verses":[["تَلُسَّ آثارَ دَرورٍ جَونَةٍ","أَلقَت عَلى ذي بَقَرٍ بَعاعَها",0,"ع",3,0],["تَلَسَّنَ اَهلُهُ رُبعاً عَلَيها","رِماثاً تَحتَ مِقلاةٍ نَيوبِ",1,"ب",1,0],["تلستوي أعطيت الحقائق حقها","بأرضٍ بها جور السراة وفيرُ",2,"ر",1,0],["تلستوي ساويت المعرّي بظلمة","بها يتساوى مبصر وضرير",2,"ر",1,0],["تلسعني عقرب أصداغه","فيسمح الثغر بدرياقه",3,"ق",2,0],["ت لسرِّك المكنون أجحد","لك ذات قدس في العلا",4,"ل",2,0],["تَلْسَعُ في الخَفَاءِ عنْ دَهاءٍ ‍","وَفي الضُّحَى كَالحَمَلِ الأَليفِ",5,"ف",1,0]]}