{"poems":[[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[64,"أبى الله أن أسمو بغير فضائلي","https://www.aldiwan.net/poem52453.html","الطويل"],[47,"ألمت وهل إلمامها لك نافيع","https://www.aldiwan.net/poem64706.html","الطويل"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[82,"نفى هم شيبي سرور الشباب","https://www.aldiwan.net/poem31576.html","المتقارب"],[71,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[54,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85820","الطويل"],[147,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[185,"ونبئت ليلى أرسلت بشفاعة","https://www.aldiwan.net/poem58735.html","الطويل"],[354,"أأكشف حالا ستره في النهى شرط","https://www.aldiwan.net/poem15762.html","الطويل"],[374,"أيا من أرجيه وآمل عفوه","https://www.aldiwan.net/poem4325.html","الطويل"],[469,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[520,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[580,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[646,"","https://poetry.dctabudhabi.ae/diwan/poem/202620","الطويل"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19952","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/141861","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49594","الطويل"],[1820,"","https://poetry.dctabudhabi.ae/diwan/poem/128130","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53150","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65942","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201706","الطويل"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198445",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112493","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145049","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67988","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103956","الوافر"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125964","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85121","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85120","الكامل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107278","الوافر"],[4045,"","https://poetry.dctabudhabi.ae/diwan/poem/34755","الهزج"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117311","المتقارب"],[5102,"أبي . . .","https://www.poetsgate.com/ViewPoem.aspx?id=15171",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5150,"الخائنة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202894",""],[5324,"شهادة في حضرة الحب .","https://www.poetsgate.com/ViewPoem.aspx?id=207309",""],[5758,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=200497",""],[5829,"بوح الظمآن","https://www.poetsgate.com/ViewPoem.aspx?id=179846",""]],"verses":[["أَأَكلَؤُها خَوفَ الحَوادِثِ إِنَّها","تَريبُ عَلى الإِنسانِ أَم أَتَوَكَّلُ",0,"ل",1,0],["أَأُكفَى ولا أَكْفِي وتلك غَضاضَةٌ","أرى دونَها وقعَ الحسامِ المُهَنَّدِ",1,"د",1,0],["أَأَكفُرُكَ النَعماءَ عِندي وَقَد نَمَت","عَلَيَّ نُمُوَّ الفَجرِ وَالفَجرُ ساطِعُ",2,"ع",1,0],["أ أكرمَ النَّاسِ إلاَّ أن تُعَدَّ أباً","فاتَ الكِرامَ بآباءٍ وآثارِ",3,"ر",1,0],["أأكسو المشيبَ سوادَ الخضاب","فأجعلَ للصبح ليلاً غطاءَ",4,"ا",2,0],["أأكنزُ أموالاً واحملُ إثمَها","وأتركُها للوارثينَ وأذهبُ",5,"ب",1,0],["أَآكُلُ لَحمي وَأَحسو دَمي","فَيا قَومِ لِلعَجَبِ الأَعجَبِ",6,"ب",1,0],["أأكفر لما شاء لي الكفر ساعة","واخلد في النيران غير مفارق",7,"ق",1,0],["أَأَكونُ مَن يُهدي إِلَيكَ حَياتَهُ","وَأَرومُ ما يُهدي إِلَيكَ العارا",8,"ر",2,0],["أَأَكرَمُ مِن لَيلَى عَلَىَّ فَتَبتَغِى","بِهِ الجاهَ أَم كُنتُ امرَءً الا أُطِيعُهَا",9,"ه",2,0],["أَأَكشِفُ حالاً سَترُهُ في النُهى شَرطُ","وَأَستُرُ ما في كَشفِهِ اِتَّسَعَ الخَطُّ",10,"ط",1,1],["أاَكفر ما أوليتني من كرامة","شواهدها كالشمس ليس تغيب",11,"ب",1,0],["أأكون ذا شجنٍ بهِ ويصدُّني","عذلٌ ويدعوني الخليُّ فاتبع",12,"ع",1,0],["أأكون جار أبي الضياء وأتقي","في ظله ظلم القضاء الجائر",13,"ر",1,0],["أأَكون عبدَكَ ثم يق","تُلني الهوَى جَوْراً وظُلْما",14,"م",2,0],["أَأَكرمَ وَجْهٍ خَطَّه كَفُّ لاعِطِ","فَدَتْ نَعْلَك اليُسرى جُدودُ الأَشايط",15,"ط",1,1],["أأكرم من ليلى علي فتبتغي","به الجاه أم كنت امرأ لا أطيعها",16,"ه",2,0],["أأكون في الحزب الش","مال وأترك الحزب اليمينا",17,"ن",2,0],["أأكون سيدهم وحاسدهم","ويفوز جدهم على جدي",18,"د",2,0],["أأكسِرُ قوْسِي بعدَ عِلمي بأَنَني","رميتُ فما أخْطَيْتُ شاكلةَ الرَّمي",19,"م",2,0],["أأكتم حباً من جفاك تجددا","وأبدي لدي الواشين عنك تجلدا",20,"د",2,1],["أأكون قد مارست غدر طباعه","وأسومه من بعد ذلك أن يَفِي",21,"ف",2,0],["أأكتم أنعمه السابغات عليَّ وق","د ملأت كل مصر",22,"ر",1,0],["أأكون كالسفها الذين تخيروا","عرض الحياة ومرها كقداح",23,"ح",1,0],["أأكشف عن نفسي لدي غير أهلها","وأودعُ أسرار النهى غير كاتم",24,"م",1,0],["أآكلَ ما تشتهي","نُهِيتَ ولم تَنْتَهِ",25,"ه",1,1],["أأكفر من بؤسي بأحكام خالقي","كفى بي رزقا أنني الدهر مسلم",26,"م",1,0],["أأكتم وجدي أو أهدئ إحساسي","و(ثامن ماي) جرحه ما له أسي",27,"س",2,1],["أَأَكذِب اللهَ فِي غيره كَلَفي","هيهاتَ واللهِ لَيْسَ الحبُّ ينقسِم",28,"م",1,0],["أأكتمه ويكشفه شهيق","يلازمني وإطراق طويل",29,"ل",1,0],["أأكتم الوجد الذي هاجه","منها ابتسام حسنه جائر",30,"ر",1,0],["أأكون فيه طامعاً","من غيره والغير فتنه",31,"ن",2,0],["أأكون فيه طامعا","والبخل عند الناس فطنه",32,"ه",1,0],["أأكتُمُ حبَّهم ودُموع عَيني","على الوجَناتِ تحكي شرحَ حالِي",33,"ل",2,0],["أَأَكسوهُ وَلَم أَرهَب","لَهُ سَوطاً وَلا حِرزا",34,"ز",2,0],["أأكناف نجد ترى فيك تجدى","دموع بخدى توالى الهمولا",35,"ل",2,0],["أَأَكتبُ عنكِ ولاتغضبي","وإن قلتُ أهواكِ لاتعجبي",36,"ب",2,1],["أأكفر نعماك التي فاض فيضها","على خلّتي، إنّي إذاً لكفور",37,"ر",1,0],["أأكتمُ الأمرَ عن إبنٍ يُسائلني","أم أكتفي برياحِ العمِرِ تسفيها",38,"ي",3,0],["أأكون مثلك يازمان نذالة","وأدير وجهي ناكرا حسناها",39,"ا",3,0],["أَأَكْتُبُ كُلَّمَا نَادَى مِدَادٌ","وَهَذا دَمْعُنَا حِبْرٌ مِدَادُ",40,"د",1,0],["أأكون من بعد الفراق محطما","واهيمُ في دنيا الغرام واحرمً",41,"م",1,0]]}