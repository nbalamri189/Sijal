{"poems":[[53,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[47,"قُمْ تأَملْ بِنا عَجَائِبَ دَهْرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=32153",""],[292,"كلفت بليلى خدين الشباب","https://www.aldiwan.net/poem1913.html","المتقارب"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[443,"شكراً لما تولى من الإنعام","https://www.aldiwan.net/poem2566.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63868","المنسرح"],[2965,"","https://poetry.dctabudhabi.ae/diwan/poem/146558","الوافر"],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143531","الخفيف"]],"verses":[["فقحة فيها اتساع متى لم","يحشه ضاقت عليه البقاع",0,"ع",1,0],["فَقْحَةٌ تُكْثِرُ الحَرَاكَ ،وأَيْرٌ","ساقِطُ الحِسِّ لَيْسَ فيه حَرَاكُ",1,"ك",1,0],["فَقَحطانُ تَعلَمُ أَن لَيسَ حَيٌّ","مِنَ الناسِ أَكرَمَ مِنكُم فِعالا",2,"ل",2,0],["فقحطهم لازم","وجدبهم والسنات",3,"ت",1,0],["فقحتم فكر المديح لمجدكم","منّي وكنت عقلت بالإفحام",4,"م",1,0],["فَقْحَتُهُ تُرْسُهُ فهمَّتُهُ","في رمحِ لحمٍ في تُرْسِهِ يُرْكَز",5,"ز",1,0],["فقحط والجدوبة والبلايا","وكل هين في جنب سوري",6,"ي",1,0],["فقحة مثل عجنة الحواري","حسنها يترك الصحاة سكارى",7,"ر",2,1]]}