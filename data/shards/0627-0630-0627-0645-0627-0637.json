{"poems":[[55,"أقول لها بين الغديرين والنقا","https://www.aldiwan.net/poem29961.html","الطويل"],[55,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[85,"ذروني فإني بالعلاء خبير","https://www.aldiwan.net/poem54303.html","الطويل"],[94,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[47,"إلى كم أرى سعدا مقيما مكانه","https://www.aldiwan.net/poem63572.html","الطويل"],[47,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[47,"بعينيك إعوالي وطول شهيقي","https://www.aldiwan.net/poem65197.html","الطويل"],[47,"هل الربع قد أمست خلاء منازله","https://www.aldiwan.net/poem65625.html","الطويل"],[63,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[82,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[35,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[54,"وفتيان لهو غدوا للصبوح","https://www.aldiwan.net/poem26981.html","المتقارب"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[47,"إلى كمْ أرَى سَعْداً مُقِيماً مَكانَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31257",""],[98,"القمر العاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66135&r=&rc=2",""],[285,"أبا حسن أنت أهل الجميل","https://www.aldiwan.net/poem60592.html","المتقارب"],[343,"يحب الفتى طول البقاء وإنه","https://www.aldiwan.net/poem68831.html","الطويل"],[351,"وداع دعاني والنجوم كأنها","https://www.aldiwan.net/poem24119.html","الطويل"],[385,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[412,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[447,"رأيت الزمان وإخوانه","https://www.aldiwan.net/poem14395.html","المتقارب"],[466,"دلفت بجيش ذي زهاء كأنه","https://www.aldiwan.net/poem15308.html","الطويل"],[466,"وبالذروة الشماء من موطن العلى","https://www.aldiwan.net/poem15456.html","الطويل"],[482,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[556,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[590,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137346",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63950","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100134","الوافر"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17636","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72325","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16774","الهزج"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202102","الطويل"],[1461,"","https://poetry.dctabudhabi.ae/diwan/poem/98046","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79898","الطويل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87948","الكامل"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127895","المتقارب"],[266,"","https://poetry.dctabudhabi.ae/diwan/poem/129598","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201719","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67229","الهزج"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70347","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100326","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74273","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74165","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45875","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92220","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/76998","الطويل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147523","الطويل"],[4755,"يَمُوتُ أَبُوهُ مِن حُزنٍ عليهِ","https://www.poetsgate.com/ViewPoem.aspx?id=205492",""],[5183,"الِّلثَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186447",""],[5268,"تَحُفُّ بِيَ المَخَاطِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206999",""],[5277,"طائفُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=208587",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[5567,"قالت الشهباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69064&r=&rc=4",""]],"verses":[["إِذا ما طَلَعتِ النَقبَ وَاللَيلُ دونَهُ","أَمِنتِ العِدى إِلّا تَلَفُّتَ خائِفِ",0,"ف",1,0],["إِذا ما طَرَقتَ المَرءَ مِنهُم وَجَدتَهُ","عَلى النارِ لا كابي الزِنادِ وَلا وَغدا",1,"د",2,0],["إِذا ماطَلَتنا بَعدَ ظَمءٍ بِمائِها","وَعَجَّ الظَوامي أَورَدَتنا سَرابَها",2,"ب",3,0],["إذا ما طوى يوماً على السر كشحه","فليس له حتّى المَمَاتِ نشورُ",3,"ر",1,0],["إِذا مَا طَمحْتُ إلى غايةٍ","رَكِبتُ المنى ونَسيتُ الحَذرْ",4,"ر",1,0],["إِذا ماط عنه السِّتْرَ مُدَّ سُرادِقٌ","عليه من النور الإلهيِّ مضروبُ",5,"ب",1,0],["إِذا ما طَلَعنا مِن فَمِ الصِلحِ شَرَّقَ ال","غُرابُ وَغارَ النَحسُ حَيثُ يَغورُ",6,"ر",1,0],["إِذا ما طِرازُ الشِعرِ وافاهُ جاءَنا","غَريبُ طِرازِ السوسِ سَبطَ الرَفارِفِ",7,"ف",1,0],["إِذا ما طَلَبنا خُطَّةَ النِصفِ رَدَّها","عَلَينا اِبنُ خُبثٍ فاحِشٍ وَفُسوقِ",8,"ق",1,0],["إِذا ما طُغُجُّ سارَ في صَدرِ عَسكَرٍ","تُجيبُ رَواغيهِ عِشاءً صَواهِلُه",9,"ل",2,0],["إذا ما طُلِبْنَ فخيلُ السِّباقِ","وإمَّا طَلَبنَ فسفْنَ النَّجاءِ",10,"ا",2,0],["إذا ما طما وامتدّ بالرّيح مدُّهُ","ذَكرنا به فيَّاضَ نائِلك الغمرِ",11,"ر",1,0],["إِذا ما طَواكِ الدَهرُ يا أُمَّ مالِكٍ","فَشَأنُ المَنايا القاضِياتِ وَشانِيا",12,"ي",2,0],["إِذا ما طَعَنّا بُطونَ القَنا","ني سارَ دَمُ الكَرمِ عَنهُنَّ سَورا",13,"ر",2,0],["إذا ما طوَيتَ على عَزْمَةٍ","فحسبُكَ أن لا تُحَلّ الحُبى",14,"ا",1,0],["إذا ما طَريدُ العُصْمِ وافى حَضِيضَه","تَبَوّأ فيهِ واثقاً باعتصامِهِ",15,"م",2,0],["إذا ما طافَ بالشُّرْ","فَةِ ضوء القمر المضْنَى",16,"ن",2,1],["إذا ما طافَ بالأرضِ","شعاعُ الكوكبِ الفضِّي",17,"ي",1,1],["إذا ما طلَعنا من فمِ الصّلحِ شَرّق ال","غُرَابُ، وغاد النحْسُ حيْثُ يغورُ",18,"ر",1,0],["إذا ما طاف بالشرفة ضوء القمر المُضنى","ورفّ عليكِ مثل الحلم أو إشراقة المعنى",19,"ن",2,1],["إِذا ما طَعَنْتَ بِهِ مَطْلَباً","سَفَكْتَ بِغَيْرِ جُناحٍ دَمَهْ",20,"م",2,0],["إذا ما طَوى يَوماً طَوى اليَومُ بَعضَهُ","وَيَطويهِ إِن جَنَّ المَساءُ مَساءُ",21,"ا",2,0],["إِذا ما طَغا فيها المِزاجُ حَسَبتَها","كَواكِبَ دُرٍّ في سَماءِ عَقيقِ",22,"ق",1,0],["إِذا ما طَفا فيها حَريق هَجيرها","تَحصنت الأَرواح في طُرر الضال",23,"ل",1,0],["إِذا ما طَريق المَدحِ ضاق عَلى امرىءٍ","رأَيتُ طَريق المَدحِ نَحوَكَ مهيعا",24,"ع",2,0],["إذا ما طلبت الصديق الصدو","ق أعدمك الدهر وجدانه",25,"ن",2,0],["إذا ما طوتْ ماء النِّهاءِ تخمُّطاً","فموردها ما أنبعَ الهامُ والنَّحرُ",26,"ر",1,0],["إِذا ما طوت ورداً شهيّاً فوِرْدُها","غداةَ الوغى نصرٌ كرامٌ مناهِلهْ",27,"ل",2,0],["اِذا ما طالَ بالحسناءِ عهدي","أعادتْ ذلك الودَّ ازورارا",28,"ر",2,0],["إِذا ما طَمَتْ بِيَ أَشواقُه","دَعوتُ الحُسينَ فَغاضَ الأسى",29,"ا",1,0],["إِذا ما طُفت حول دروب مقرى","فعرِّج بي إِلى دَيْر الحكيم",30,"م",1,0],["إِذا ما طواكَ الرمسُ ينشرك الذي","تركتَ من الآثار وهو جليل",31,"ل",1,0],["إذا ما طاردته في مكان","رأت منه مراس الراسخات",32,"ت",1,0],["إذا ما طفا النيلوفَرُ الغضّ فَوْقَه","مفتَّحةً أجفانُهُ أو مُغَمَّضه",33,"ض",2,0],["إذا ما طال لا يعلوه شأوٍ","ومهما قال لا يعدو سدادا",34,"د",2,0],["إِذا ما طَوى دوني اِمرؤٌ بَطنَ كَفِّهِ","طَوَيتُ يَميني دونَهُ وَشمالِيا",35,"ي",2,1],["إذا ما طوى الرايات وقت مسيره","غدت عوضاً منها الطيور الحوائم",36,"م",1,0],["إِذا ما طَرَقَ المَرءَ","جَرى في طَلَقِ الكَربِ",37,"ب",1,0],["إذا ما طويت اليوم أحَسَبُه غدا","وإن مَرَّ شَهْرُ الحج قلت المحرم",38,"م",1,0],["إِذا ما طَها للقومِ كانَ كأنّه","حَميّ وكانَت شيمةٌ لا تزايِلُه",39,"ل",2,0],["إذا ما طرحنا الرحلَ عنها بربعهِ","غفرتُ لأيامِ الزمانِ ذُنوبها",40,"ب",3,0],["إِذا مَا طَغَت بَطَراً مَشَاعِرُ سُنَّةٍ","فِيكُم فَأَوعَزَ لِلفُجُورِ قُواكُم",41,"م",1,0],["إذا ما طوى خبري صاحبٌ","أَبى طيبُ عرفيَ الاَّ انتشارا",42,"ر",2,0],["إذا ما طفت غدرانها وتبادرت","رأيت بها انسان عيني سابحا",43,"ح",2,0],["إذا ما طوت كف الزمان علومهم","وكانوا كأمثال الطلول الدوارس",44,"س",1,0],["إذا ما طافَ خِلناها","سحيقَ المسكِ قد فَاحا",45,"ح",2,0],["إذا ما طمعنا أن تقر ديارهم","تداركهم بعد الرحيل رحيل",46,"ل",1,0],["اذا ما طرحت لها اصبعاً","الى الوصل القت من الهجر باعا",47,"ع",2,0],["إِذا ما طَلَبت الورد أَهوى بِخَده","وَإِن رمت صافي الوَرد عجل بِالثغر",48,"ر",1,0],["إِذ أَماطَ اللثام فَانفلق الصُب","حُ وَبانَت مَحاسن المَحجوب",49,"ب",1,0],["إِذا ما طَمى الروع في مركبٍ","بهِ للنَدى أَبحرٌ طاميَه",50,"ي",2,0],["إِذا ما طَلَبت وَفا صاحب","وَلَم تَحظ مِنهُ بذاك الطَلَب",51,"ب",1,0],["اذا ما طَوى والديك الثَرى","فعمّا قليلٍ عليك العَفا",52,"ف",2,0],["إذا ما طفتَ حوليه","فثق أنك تلقاني",53,"ن",2,0],["إِذا ما طَرَحتَ القَلبَ مِنهُ فَإِنَّهُ","لِبَعض عِلاج العَين طَبُّ حَكيم",54,"م",1,0],["إذا ما طويناها نشرت من الندى","فلا تحمد الأشعار إن طاب نشرها",55,"ر",3,0],["إذا ما طُفتَ تَبحَثُ عَن حَزينٍ","يَراهُ المَوتُ مُشتاقًا إِليهِ",56,"ه",1,1],["إذ أماطت لثامها وهي حُسنُُ","يتمنى جبينها أن يراها",57,"ا",3,0],["إذا مَا طَالَ لَيلُكَ في الأديمِ","فَبُحْ بالشَّوقِ للوَطَنِ القَديمِ",58,"م",1,1],["إذا ما طلّ في ليل التصافي","كمثلِ البدرِ يعشقهُ طموحي",59,"ح",2,0],["إذا ما طالبٌ علماً أتاهم","لِنيل العلم ألفاهم بحارا",60,"ر",2,0],["إِذا ما طابَ طَعْماً بَعْدَ حِينٍ","تأَبَّى بَعْدَ ذلِكَ أَنْ يَطِيبا",61,"ب",2,0],["إذا ما طال بي ليلي","وعمَّ ظلامه الأغبر",62,"ر",1,0],["إذا ما طاف بي ساق","وصبَّ الكأس مبتردا",63,"د",2,0]]}