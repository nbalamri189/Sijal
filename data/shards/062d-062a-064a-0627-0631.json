aspx?id=50474",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5725,"امنية","https://www.poetsgate.com/ViewPoem.aspx?id=191275",""],[5725,"راهبة","https://www.poetsgate.com/ViewPoem.aspx?id=197099",""],[5725,"يا نخلة البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=210802",""],[5854,"أذكيتَ نيرانَ وجدي يا نسيمُ كفى ((بين الحاء والباء))","https://www.poetsgate.com/ViewPoem.aspx?id=197020",""],[5956,"أطفالي","https://www.poetsgate.com/ViewPoem.aspx?id=194840",""],[5956,"يا من تُسَمِّي أجملَ الأسماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205262",""],[6052,"رداء السكينة والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=34646",""],[6070,"ما أجملَ الشِّعرَ حِينَ الرُّوحُ تَسْكبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=197535",""],[6308,"ذاكرة الوطن القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87728&r=&rc=6",""]],"verses":[["حَتّى أُرى مُتَمَلِّكاً","شَرقَ العُلى وَالغَربَ وَحدي",0,"د",2,0],["حَتّى أَرى الشَرقَ يَسمو","رَغمَ اِعتِداءِ الزَمانِ",1,"ن",1,0],["حتى أرى ليلتنا باقيه","محفوفةً مِن وصلنا بالنعيم",2,"م",1,0],["حتَّى أراني من مص","ر قد فتحت قمامهْ",3,"م",2,0],["حتى أراه لدى التذكر وال","تذكيرِ حلماً مِنْ بعضِ أحلامي",4,"م",2,0],["حَتّى أَرى ضارِبَ الناقوسِ يُطرِبُهُ","صَوتُ الأُذَينِ وَهَذا رَنَّةُ الجَرَسِ",5,"س",1,0],["حَتّى أَرُدَّ المَطايا وَهيَ ساهِمَةٌ","كَأَنَّ أَنضاءَها أَلواحُ أَحراجِ",6,"ج",1,0],["حتى ارتقت في جبال الإعتدال إلى","كمالها وهو رمز القوم في الحجرِ",7,"ر",1,0],["حَتّى أَراني كُلَّ مُظلِمِ لَيلَةٍ","بَينَ الصَحيحِ العَزمِ وَالنَشوانِ",8,"ن",1,0],["حتى أرى والوَصْلُ يجمعنا","إنسانَ عينك نُصْبَ إنساني",9,"ن",2,0],["حَتّى أَرى عنها ظِباءَ الفلا","مُرَحَّلاتٍ بِظباءِ الخيام",10,"م",1,0],["حَتّى أَرى بِالوَصْلِ حَبْلَ الهوَى","لا يتُقّى بِالبَينِ مِنهُ انصِرام",10,"م",1,0],["حَتّى أرعَوَينَ إِلى حَدِي","ثِيَ بَعدَ إِرعادِ الخَصائِل",11,"ل",1,0],["حَتّى أَرى النورَ في مَغناكَ مُبتَسِماً","كَأَنَّهُ حَدَقٌ في غَيرِ أَجفانِ",12,"ن",1,0],["حَتّى أَرانا العينَ دونَ وِردِهِ","مُطَرَّداً يَحسو بِشُفرَي عِدِّهِ",13,"د",2,0],["حَتّى اِرتَقَيتُ إِلَيها في مُشَيَّدَةٍ","دونَ السَماءِ تُناغي ظِلَّها صَعَدا",14,"د",2,0],["حَتّى أَروحَ وَقَد قَضَيتُ لُبانَةً","أَندى مِنَ المُتَضَيِّفِ الرَوّاحِ",15,"ح",1,0],["حتى أراد الله أن نظمت","من سير الرجال ما استعظمت",16,"ت",1,0],["حتى أراد الله إمساك الدم","في كرمٍ لسيفه المقدَّم",17,"م",1,0],["حَتَّى أَرَادَتْ مِصْرُ غَيْرَ مُرَادِهِمْ","وَجَلاَهُ مِنْ أَوْفَى بَنِيهَا جَالِ",18,"ل",1,0],["حتى أرى الشمس على اقْتراب:","إذا مال قُرصْها إلى الغِيَاب",19,"ب",1,0],["حَتَّى ارْعَوَيْنَ إِلَى حَدِي","مِ لِكُلِّ بِطْرِيقٍ مُخَايِلْ",20,"ل",1,0],["حَتّى أَراهُ اللَهُ أَحمَد ماجد","مُحيي المَمالك قامع الأَرجاس",21,"س",1,0],["حتى أرتقى أعلى الفرادس وارتوى","في ظلها من عذبِ هذا المنهلِ",22,"ل",1,0],["حتى أراني في حماكم واهباً","روحي فداكم في رضاكم أرغب",23,"ب",1,0],["حتى أراك امام الجيش مبتسماً","فاستصغر الوصف واستردى الذي فعلا",24,"ل",2,0],["حتى أراهم أجمعين بموقف","يدعون ربهم وقد حمدوه",25,"و",2,0],["حتى أرى نقصَ حظي إذ غدا سبباً","إلى النوى من أيادي الدهر في عنقي",26,"ق",2,0],["حتى أروي من جمالك غلتي","وتزول أثقال الهوى وهمومه",27,"م",2,0],["حتّى أَرى وأَختَبِر","والفَوزُ حظُّ المصطَبِر",28,"ر",1,0],["حتى ارتميتُ وليس بي","رمقٌ وقد جاوزتُ جهدا",29,"د",2,0],["حَتّى أَراني كَصَرّافِ البِلادِ فَكَم","يَعُدَّ بِالأَلفِ وَالحَصرِ المَهادِ لَهُ",30,"ل",2,0],["حَتّى أَرعووا لِحَديثي وَالضُحى غَسَقٌ","وَلاتَ حينَ مَناص أَيُّها الفطنُ",31,"ن",1,0],["حتى أرى فجر العَقيدَة ضاحكاً","طلقاً وحتَّى أسمع الأطيارا",32,"ر",2,0],["حتى ارتحلت فساقطت مقلي","حباته فشدد العقد",33,"د",1,0],["حتى أرى فارس الصموت على","أكساء خيلٍ كأنها الإبل",34,"ل",1,0],["حَتَّى أَرَيْتَهُمُ السَّنا تَحْتَ الدُّجى","وخيالَ سَارٍ فِي مَخِيلَةِ سارِبِ",35,"ب",1,0],["حَتَّى ارْتَقَيْتَ سريرَ مُلْكِكَ حَفَّهُ","نُورُ السرورِ جوانِباً بِجوانِبِ",35,"ب",1,0],["حَتَّى ارتقَيْتَ من المنابِرِ رُتْبَةً","غَرَّتْ بِهَا غُرُّ الرجال وَصِيدُها",36,"د",3,0],["حتى أرق قلوب حساد الضنى","وبكى فأعذرني بكم من لامني",37,"ن",2,0],["حتى أرتل في سناك تحية","بالنور عابقة وبالألوان",38,"ن",1,0],["حتى أرى كلّ يومِ مُلكٍ","لكم يسمَّى سعدَ القِرانِ",39,"ن",1,0],["حتى أرانا العجز في قولِهِمُ","طالب شأوِ المجدِ غيرُ ظافرِ",40,"ر",1,0],["حتى أراك وأخمَصاك معاً","قُرطانِ للعَيّوق والنَّسرِ",41,"ر",1,0],["حتى أرى الحيَّ البعيدَ وقد دنا","منَّي وأنفُ البينِ يُلْفَى اجدَعا",42,"ع",2,0],["حتى أراك أو تراني حرضا","حاش لما أبرمته أن انقضا",43,"ض",2,0],["حتّى أراهُ ربُّهُ أنّكِ","الدُّنيا بحالٍ لم يتبدَّلِ",44,"ل",1,0],["حَتَّى أَرَى الإجابَه","تأتي بلا اسْتِرابَهْ",45,"ه",1,0],["حتَّى أراها بِيدِي","فلا ضَياعِ زَهرتِي",46,"ي",1,0],["حتى أراد لها قدماً فقدرها","طبق الذي هي فيه ضمن أجزاء",47,"ا",2,0],["حَتّى اِرعَوَيتُ إِلى الرَشا","دِ وَما اِرعَوَيتُ لِنَهيِهِنَّه",48,"ن",2,0],["حتى ارتقى في الشرع وال","شعر وعلم الأدب",49,"ب",1,0],["حتّى أَرى دَولَةَ الإِصباح قَد ظَهَرت","تُمحى بِها دَولة الظّلماءِ وَالشّهبِ",50,"ب",1,0],["حتى أرَى حُسْن ظني","بكم غدا من جزائي",51,"ا",2,0],["حتى أرى جُملة تدبيرهِ","وأعرِفَ المستُورَ والظاهرا",52,"ر",2,0],["حتى ارتقيت محجة الإسلام والدا","عي الأنام إلى الهدى إرشادا",53,"د",2,0],["حتى أري سحب الحمى كيف البكا","وأعلم الورقاء كيف تنوح",54,"ح",1,0],["حتى أرى دولة الأوغاد والسفل","مالي ومالهمُ خُلّفت عندهم",55,"م",1,0],["حتى ارعوى لِحميةٍ لحقت به","والكبرياءُ يشيِّعُ المَكثورا",56,"ر",2,0],["حَتَّى أَرانَا وَجْهَك المَرْغُوسا","وَالدَيْنُ يُحْمِي هاجِساً مَهْجُوسا",57,"س",2,0],["حتى ارتويتَ وفاح عرفك وابتدى","رطبُ الفروع البعدَ عن نخلاتهِ",58,"ت",2,0],["حَتّى أرى مُتَقَسَّما","يَومي لِذا وَغَدي لِذاكا",59,"ك",2,0],["حتَّى ارتقوا أفلاكها وغدا لهم","دون البريَّة غربُها والمشرق",60,"ق",1,0],["حتَّى أرانا ذئبَه مُفترساً","بين الشبولِ لَيثه في غابِه",61,"ب",2,0],["حَتّى أَرى من سكرتي وَشربي","إِذا ذكرتم أَنَّني معاكم",62,"م",1,0],["حتى أرى بالنائل المكتسب","منكم اليكم صادق المنتسب",63,"ب",1,0],["حَتّى اِرتَوَت مِن تَحتِنا نُجُودُه","وَمَهمَهٍ مُمحِلَةٍ حُدُودُه",64,"د",2,0],["حتى أرى لك عريفات","جُلّنار قد بان",65,"ن",1,0],["حَتّى ارتَوَوا كُلهُم مِنهُ وَقَد مَلَؤُوا","سِقاءَهُم يَحمَدُونَ اللَهَ باكثارِ",66,"ر",1,0],["حَتّى