{"poems":[[30,"لست بلاق مازنيا مقنعا","https://www.aldiwan.net/poem5448.html","الطويل"],[71,"إذا ما زوجة الإنسان ماتت","https://www.aldiwan.net/poem28562.html","الوافر"],[33,"ألا يا بكر قد طرقا","https://www.aldiwan.net/poem42035.html","مجزوء الوافر"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[50,"ألا خذها كمصباح الظلام","https://www.aldiwan.net/poem65116.html","الوافر"],[113,"أدار علي طرفك ما أدارا","https://www.aldiwan.net/poem16251.html","الوافر"],[113,"إذا ما زرت أكناف المرام","https://www.aldiwan.net/poem16459.html","الوافر"],[214,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[285,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[398,"علي كالغزال أو الغزاله","https://www.aldiwan.net/poem53454.html","الوافر"],[422,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[422,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[447,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[469,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[473,"إذا ما زارني بركات يوما","https://www.aldiwan.net/poem60169.html","الوافر"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138977",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86614","الطويل"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206094","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63761","الهزج"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111305","الوافر"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93100","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35777","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128705","الطويل"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87950","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69344","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53111","المتقارب"],[2355,"","https://poetry.dctabudhabi.ae/diwan/poem/199765","الهزج"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115541","الهزج"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104839","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44681","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101394","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117251","الطويل"],[4119,"إذا ما زرت ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=16233",""],[5616,"إيضاح شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204839",""],[5781,"مدنٌ فارغةٌ من وطن","https://www.poetsgate.com/ViewPoem.aspx?id=198833",""],[6084,"وذات دمالج تهتز لينا","https://www.poetsgate.com/ViewPoem.aspx?id=170842",""],[6084,"أبيت الليل سهرانا","https://www.poetsgate.com/ViewPoem.aspx?id=170882",""],[6093,"تجربة ماء","https://www.poetsgate.com/ViewPoem.aspx?id=205456",""]],"verses":[["إِذا مازِنٌ شَدَّت إِلى الحَربِ أَزرَها","كَفَت قَومَها وِردَ المَنايا النَواهِلِ",0,"ل",1,0],["إذا ما زوجةُُ الإنسانِ ماتتْ","فما بقيتْ لمسكنِهِ سكينَهْ",1,"ه",1,1],["إِذا ما زَينَبٌ ذُكِرَت","سَكَبتُ الدَمعَ مُتَّسِقا",2,"ق",2,0],["إذا ما زالتِ الشُّمُّ الجِثيُّ","وكان لها انطلاقٌ أو مُضِيُّ",3,"ي",1,0],["إِذا ما زَقَّ فَرخاً مِن سُلافٍ","تَراهُ دامِياً مِن بَينِ دامِ",4,"م",1,0],["إِذا ما زُرتَهُ زُرت المَعالي","وَصادَفت السَكينة وَالوَقارا",5,"ر",2,0],["إِذا ما زُرت أَكناف المَرام","بِقونية فَبَلغها سَلامي",6,"م",2,1],["اذا ما زارني منه خيالٌ","وبات معانقي زنداً وزندا",7,"د",2,0],["إِذا ما زادَ تَعذيبي وَهَجري","يَزيدُ اليهِ وَجدي وَاِرتياحي",8,"ح",2,0],["إِذا ما زُلْزِلتْ كانوا جِبالاً","وَإِنْ هِيَ أَمْحَلَتْ كانوا بِحارا",9,"ر",2,0],["اِذا ما زِدتَ وَصلاً زُدتُ خبلاً","كَأَنَّ حِبالَ وَصلِكَ لي خبالَه",10,"ل",2,0],["إذا ما زفَّها السَّاقي بلَيْلٍ","أعاد اللَّيل حينئذٍ نهارا",11,"ر",2,0],["إذا ما زكت أعراقها وأُصولها","يُؤَرِّقُني في ذكرهم حين يعرض",12,"ض",1,0],["إذا ما زرتُهم يوماً وفى لي","ضميني للزيارةِ بالنجاحِ",13,"ح",1,0],["إذا ما زفن أعمالي","فإن الزيف منقود",14,"د",1,0],["إذا ما زعيم الدين حدَّثَ عنهُمُ","توارَدَ شُبّانُ الفخارِ وشيبُهُ",15,"ب",2,0],["إذا ما زار غُمضٌ صدَّ عتباً","عليَّ كأنّهُ منهُ يغار",16,"ر",1,0],["إِذا ما زارَني بَرَكاتُ يَوماً","فَذَلِكَ أَبرَكَ الأَيّامِ عِندي",17,"د",2,1],["إذا ما زها في العين من ذاك معبد","لذكر حلا في السمع من ذاك معبد",18,"د",1,0],["إِذا ما زَماني بِالقَنا وَالقَواضب","عَليّ سَطا في مصر سَطوة غاضبِ",19,"ب",1,1],["إذا ما زعانيف الرباب أشظها","نقال المراري والذرا والجماجم",20,"م",1,1],["إذا ما زِدْتُكَ الآنَ","وفاءً زِدْتَني غدرا",21,"ر",2,0],["إذا ما زادها ضيف بليل","قرته بطيب زاد غير ممسِ",22,"س",1,0],["إذا ما زار أزري بالدراري","وان غنى فعن ذا العود يغني",23,"ن",2,0],["إذا ما زمزم الحادى أعدت","لقطع البيد أجنحة الرياح",24,"ح",1,0],["إِذا مازَجَ الشَيبُ الشَبابَ تَجَهَّزَت","إِلى الحلمِ أَفراسُ الصِبا وَرَواحِلُه",25,"ل",2,0],["إذا ما زنت عيني برؤية غيرها","سفاحا فمن ماء المدامع تطهر",26,"ر",1,0],["إِذا ما زَرَعتَ العُرفَ في قَلبِ مومس","فَإِنَّكَ لا تَجنى سِوى شائِك النُكر",27,"ر",1,1],["إِذا ما زارَ مُجنَأَةً عَلَيها","ثِقالُ الصَخرِ وَالخَشَبُ القَطيلُ",28,"ل",1,0],["إِذا ما زَحَمتَ الجَيشَ بِالجَيشِ مُيِّلَت","مُتُونُ الأَعادي عَن مُتُونِ القَنا المُلدِ",29,"د",1,0],["إذا مازج الذلّ صفو الحياة فأع","ذب منه ارتشاف الكدرْ",30,"ر",1,0],["إذا ما زرت مشتاقاً","فرَبْعٌ دارس مُقفِرْ",31,"ر",1,0],["إذا ما زمزمَ الحادي","رمى في قلبه جمره",32,"ر",2,0],["إذا ما زارني في جنح ليل","محا بضيائه صبح الليال",33,"ل",1,0],["إذا ما زرت ناديهن يوماً","يرحب بي ويثني لي الوساد",34,"د",1,0],["إِذا ما زَرتَني في جُنحِ ليلٍ","وَضَمَّ بِكم بَعيد الهَجر شَملُ",35,"ل",1,0],["إذا مازفها الساقي عروسا","وجلببها الصبا برد الزجاج",36,"ج",1,0],["إذا مازج الدينار خبثٌ فإنما","يخلص ما فيه من الخبث السبك",37,"ك",1,0],["إذا ما زرت ماريا","فما سعدى وماريا",38,"ي",2,1],["إذا ما زار خيمتَنا \"حبيبٌ\"","نطيرُ إليهِ بالخَطوِ الرشيقِ",39,"ق",1,0],["إذا ما زارَني في الحُلْمِ أبكي","كَما يَبْكي المِدادُ على الدَّوايا",40,"ا",3,0],["اذا ما زارت الندماء أرخى","عليها الحسن عن واش خمارا",41,"ر",2,0],["اذا ما زف لي كاسي","رددت الكاس خجلانا",42,"ا",1,0],["إذا ما زارها الواشون","أخال حبيتي كانون",43,"ن",1,1]]}