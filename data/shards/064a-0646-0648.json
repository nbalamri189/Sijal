282",""],[5273,"الشاعر القتيل","https://www.poetsgate.com/ViewPoem.aspx?id=197218",""],[5431,"فرات الجود مقهورٌ مباحُ","https://www.poetsgate.com/ViewPoem.aspx?id=185456",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5582,"دَعاهُ يَعُجْ فِي حُبِّهِ لِمَعاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63476",""],[402,"ماذا أصاب أباك الشيخ واحربا","https://www.poetsgate.com/ViewPoem.aspx?id=35348",""],[5975,"وداعاً","https://www.poetsgate.com/ViewPoem.aspx?id=52976",""],[5997,"ريع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214208",""],[6070,"ينوحُ الى عظيمِ الكونِ أمْرَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=189819",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""],[463,"إذا فاتها روضُ الحمى وجنوبهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59984&r=&rc=40",""],[6259,"ألمَّ خيالها بعد الهجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59388&r=&rc=36",""]],"verses":[["يَنوءُ تَحامُلَ ذي رَيثَةٍ","وَيَقعُدُ إِقعاءَ غَرثانَ صالِ",0,"ل",1,0],["يَنوشُ بواديها الأَراكَ وَعِندَهُ","مناهِلُ تُرعي أَهلَها وَتُسيمُ",1,"م",1,0],["يَنوبُ عنِ الأجْفانِ في عَرَصاتِها","إذا كَلَّ منْها عارِضٌ مُتَتابِعُ",2,"ع",1,0],["يَنُوبُ نَظْمِي مَنَابَ كَبْشٍ","وَالنَّتْرُ عَنْ قُفَّةِ النِّخَالَه",3,"ه",1,0],["يَنُوبُ عَنِ الإِصْبَاحِ إِنْ مَطَلَ الدُّجَى","وَيَضْمنُ سُقْيَا السَّرْحِ إِنْ عَظُمَ الْقَحْطُ",4,"ط",1,0],["يَنوءُ بِها بوصٌ إِذا ما تَفَضَّلَت","تَوَعَّبَ عَرضَ الشَرعَبِيِّ المُغَيَّلِ",5,"ل",1,0],["يَنولُ العَشيرَةَ ما عِندَهُ","وَيَغفِرُ ما قالَ جُهّالُها",6,"ل",3,0],["يَنوبُ عَنِ المُدّاحِ مِنِّيَ واحِدٌ","جَميعُ الخِصالِ لَيسَ عَنهُ مَنابُ",7,"ب",1,0],["يَنوءُ فَيَعدو مِن قَريبٍ إِذا عَدا","وَيَكمُنُ في خَشباءَ وَعثٍ مَقيلُها",8,"ل",3,0],["يَنُؤنَ وَلَم يُكسَينَ إَلّا قَنازِعاً","مِنَ الريشِ تَنواءَ الفِصالِ الهَزائِلِ",9,"ل",1,0],["يَنُوءُ بأعباء الهوان مقيَّداً","ويكفيه أن لو كان غير مقيّد",10,"د",1,0],["ينوحُ على الأحرارِ في جوْرِ غيره","ويُوسعهُمْ جَوْراً ويَشْرَى على العذلِ",11,"ل",1,0],["ينوحُ به بومٌ وتعزفُ جنةٌ","فيعوي لها سِيدٌ ويضْبَحُ سَمْسَمُ",12,"م",1,0],["يَنوحُ في الرَوض وَالأَشجارُ مورِقَةٌ","كَما يَنوحُ عَلى الأَطلال وَالدِمَنِ",13,"ن",1,0],["يُنوؤونَ بِالأَيدي وَأَفضَلُ زادِهِم","بَقِيَّةُ لَحمٍ مِن جَزورٍ مُمَلَّحِ",14,"ح",1,0],["يُنَوِّر عِلمُكَ أَرجاءَها","وَيَقطُرُ طَبعُك فيها نَدى",15,"د",2,0],["يَنوبُ عن الأنواءِ فيضُ يمينهِ","ويُغني عن البيضاء حين تغيبُ",16,"ب",1,0],["يُنَوِّلُنا حُمولَةُ مِن بَعيدٍ","وَيَحرِمُنا رِجالٌ مِن قَريبِ",17,"ب",1,0],["يَنوي فِراراً لَو يَرى مَخلَصاً","مِن سَبَبٍ يُفضي بِهِ أَو طَريق",18,"ق",1,0],["يَنوحُ بِها الخِرَّيتُ نَدباً لِنَفسِهِ","إِذا اِختَلَفَت حَصباؤُها وَصُخورُها",19,"ر",3,0],["يَنوءُ بِصَدرِهِ وَالرُمحُ فيهِ","وَيَخلُجُهُ خَدبٌ كَالبَعيرِ",20,"ر",1,0],["ينوبُ منابَ السيف في الروع ذكرُهُ","فما ذَكَرٌ ماضٍ يسيلُ منَ الذكرِ",21,"ر",1,0],["يَنُوحُ عَلَى فَقْدِ الْهَديلِ وَلَمْ يَكُنْ","رَآهُ فَيَا لِلَّهِ كَيْفَ تَهَكَّمَا",22,"م",2,0],["يَنوي به للمسلمينَ عقوبةً","وكذا تكونُ موائدُ الحكّامِ",23,"م",1,0],["يُنَوِّرُ بِالبِشرِ أَخلاقَهُ","وَيَجري بِكَفَّيهِ ماءُ الكَرَم",24,"م",1,0],["يَنوءُ بِجَنْبيهِ ويرتجُّ ماشياً","إذا اضطربتْ منه الشَّوى والرَّوانفُ",25,"ف",1,0],["يَنُوبُ لها عَنِ الكُتبِ المَوَاضي","ولَيْسَتْ عنه في حالٍ تَنُوبُ",26,"ب",1,0],["ينوءُ إذا ما ناءَ منك رُكامُه","برادفَةٍ لا تَستَقِلُّ منَ الوَجَى",27,"ج",2,0],["يَنوءُ بِرِدفِهِ فَإِذا تَمَشّى","تَثَنّى في غَلائِلِهِ قَضيبُ",28,"ب",1,0],["يَنوشُ بِها القَلبُ أَوطارَهُ","فَلَيتَ مَآرِبَهُ لَم تُنَشّ",29,"ش",1,0],["يَنوحُ عَلى إِلفٍ لَهُ وَإِذا شَكا","شَكا بِنَحيبٍ لا بِنُطقِ لِسانِ",30,"ن",1,0],["يُنَوِّرُ شِعْرُهُمْ فِي كلِّ وَادٍ","وَيُزْهِرُ نَثْرُهُمْ فِي كُلِّ حَقلِ",31,"ل",1,0],["يَنوءُ ثُكْلاً وَقَبْلَ الثُّكْلِ لاَ نَصَبَا","شَكَا وَإِنْ جُلَّ مَا يَلْقَى َلاَ وَصَبَا",32,"ب",2,0],["يَنْوِي التَّرحُّلَ عَنْ أَهْلٍ وَعَنْ وَطَنٍ","وَفِي جَوَانِحِهِ أَحْزَانُ مَكبُودِ",33,"د",1,0],["ينوبُ بكفِّي عن أبيه وقد مضى","كما نُبْتَ عن آبائِك السادةِ الغُرِّ",34,"ر",1,0],["ينوح في الشام ثكلى ناشرا لهم","قميص عثمان نوح الورق بالسحر",35,"ر",1,0],["ينوي كفنّان ، بلا فكرة","يغلي كطيش الفكرة الملحفه",36,"ف",2,0],["ينوح المغرد شجواً فلا","يَغُرَّنْكَ إن غرّد النائح",37,"ح",1,0],["ينوء بردفه نوءا فيمشى","نزيفا مشى ذى خطو مدانى",38,"ن",2,0],["يَنوبانِ في المَعنى عَنِ المُزنِ وَالمُدى","فَلِلَّهِ ما أَردى وَلِلَّهِ ما وَدى",39,"د",2,0],["يَنوي الَّتي فَضَّلَها ربُّ العُلى","لَمّا دَحا تُربَتَها عَلى البُنى",40,"ا",1,0],["ينوح وأبكي غيرَ أنّ مدَامِعي","تَجود وما تَنْدَى لعينيه أجفان",41,"ن",1,0],["ينوب المرء نحس فيه نقصٌ","يتمّمه المنجم بالحساب",42,"ب",1,1],["يَنُوْشُنا الدَّهرُ أعواقاً بأكبِدِنا","وبانَ للبينِ أعواقٌ وأعواقُ",43,"ق",1,0],["يَنُوحُ عليه البومُ والورقُ حوله","تُغرِّدُ بالألحانِ فيه وتَسْجَع",44,"ع",1,0],["ينوحُ كنوحِ العندليبِ هَديله","على سرحه بالقاع يلعى ويَلْهَثُ",45,"ث",1,0],["يَنوبُ عَن وَردِ الرَبيعِ خَدُّهُ","كَأَنَّما شَقيقُهُ شَقيقُهُ",46,"ق",2,0],["يَنوحُ وَلَم يُضمِر غَرامي ضُلوعُهُ","وَلا عادَهُ فيمَن كَلِفتُ بِهِ عيدي",47,"د",2,0],["ينؤنَ بأعجازٍ ثِقالٍ وأسوقٍ","خَدالٍ وأقدامٍ لطافٍ خُصورُها",48,"ر",3,0],["يَنوي مُحاوَلَةَ القِيامِ وَقَد مَضَت","فيهِ مَخارِصَ كُلِّ لَدنٍ لَهذَمِ",49,"م",1,0],["يَنوي وَسيقَتَها وَقَد وَسَقَت لَهُ","ماءَ الوَسيقَةِ في وِعاءٍ مُعجِبِ",50,"ب",1,0],["يَنوح وَلَم يفقد أَليفاً يَشوقُه","وأَفقد الفاً شائِقاً فأنوح",51,"ح",1,0],["ينوع للعافين جزل عطائه","فمنها تليد يحتذى وطريف",52,"ف",1,0],["يَنوونَ مَسلَمَةَ الفَيّاضَ نائِلُهُ","وَكَعبُهُ في يَفاعِ المَجدِ مُعتَدِلُ",53,"ل",1,0],["ينوح نواح الغريب الطليح","إذا أذكرته الليالي هواه",54,"ا",2,0],["يَنوبُ عن كلِّ شَمسٍ إنْ هي احتجَبتْ","مَنابَ ذي ناظرٍ للحُجْبِ هَتّاك",55,"ك",1,0],["ينوح يبكي على تقصيره آه آه","خذا من الناس في جانب عطاهم قفاه",56,"ا",2,0],["يَنوبُ بِوَجهِهِ عَن كُلِّ شَمسٍ","يَغيب من الغُروبِ إِلى الطُلوعِ",57,"ع",1,0],["يَنوطُ نجادي رأيه وَحسامه","بِصَدرٍ كَمِثلِ البَرِّ أَو دونَهُ البَرُّ",58,"ر",1,0],["يَنوطُ نِجادي رَأيه وَحسامه","بِصَدرٍ كَمثل البَحرِ أَو سِعَة البَرِّ",59,"ر",1,0],["يَنوطُ نَجادي رَأيه وَحُسامِهِ","بصدر كَمِثلِ البَرِّ بَل هوَ أَرحَبُ",60,"ب",1,0],["ينوب عن الصَّباح إذا تجلَّى","وما ناب الصَّباح له منابا",61,"ب",2,0],["يَنُوبُ عن ضَرَمِ الأَحشاءِ بارِقُها","وعن دُمُوعِكَ فِيهَا الوَابِلُ الهَمِعُ",62,"ع",1,0],["ينوِّر قَدحاً من زُنَيدٍ ورَى له","من الظن لا مرخٌ ولا هو ضالُ",63,"ل",1,0],["ينوء بها أَن القدودَ خفائفٌ","ويُظلِعها أَن المتونَ رواجحُ",64,"ح",1,0],["ينوبان من ناديك أمنعَ جانبٍ","وأنضرَ رَيعٍ غضُّهُ وقشيبُهُ",65,"ب",2,0],["ينوسُ بغُبَّرٍ من صاعِداتٍ","بِطاءِ الجَذْبِ يضطرمُ اضطراما",66,"م",2,0],["ينوضُ على الحصْباءِ لكنَّ وّدْقَه","مدى الشمس يُروي كل برٍّ وفاجرِ",67,"ر",1,0],["ينوسُ بأجْوازِ المُروتِ كأنهُ","نَزيفٌ حسا الصهباء من خمر صَرْخد",68,"د",1,0],["ينوبُ شَبا أقْلامهِ عن رماحهِ","وآراؤهُ عن كلِّ أبيضَ مِخْذَم",69,"م",1,0],["يَنوبُ الرَّأيُ منهُ عنْ نِزالٍ","ويُغْنيهِ عن الجيشِ الكِتابُ",70,"ب",1,0],["ينوحُ ووجهُ الصبحُ قد لاحَ مشرقاً","يقولُ لنوّامِ الدُّجىويحكُمْ هبّوا",71,"ب",3,0],["ينوبون في التبليغ عنه وأنهم","له أوصيا في الفارقات الحنيفيّه",72,"ي",2,0],["ينوبُ الهاشميَّ وليس بدعاً","إذ أناب الوصيُّ عن النبيِّ",73,"ي",1,0],["ينوط نجاديها بعاتق أروع","عزيز له النصر العزيز قرين",74,"ن",1,0],["ينوح وقلبي للهوى دون قلبه","وعينِيَ دمعاً دون عينيه تذرِفُ",75,"ف",1,0],["يَنوبُ مَنابَ البدرِ ليلةَ تمّهِ","وَيُغني غناءَ الشّمسِ حين تغيبُ",76,"ب",1,0],["يُنوِّرُ الطَّرْفُ كَيَسَا","إِنْ نَاوَلَ الكَفَّ كَاسَا",77,"س",2,1],["يُنَوِّلُ جانٍ تَمْرَهُنَّ فَيَجْتَنِي","وَيُمْهَلُ جَانٍ عِنْدَهُنُّ وَيُهْمَلُ",78,"ل",1,0],["يَنوحونَ نَوحَ الثاكِلاتِ فَكُلُّهُم","تَدَفَّقُ عَن مِثلِ السُيولِ مَحاجِرُه",79,"ر",2,0],["يَنُوبُهُ النّاسُ في ضَيقٍ وفي سِعَةٍ","لِلرِّزقِ ماب َينَ أزواجٍ وأفراد",80,"د",1,0],["ينوبُ الوفدَ حاشيَتي سِماطٍ","ضَحُوكٍ مُكثِرٍ لَهُمُ مُطيب",81,"ب",1,0],["ينوي الإقامة ما بقيت وأقسمت","لا تنزل اللذات ما لم يرحل",82,"ل",1,0],["ينوحُ على غِريدها بُلبلُ العلى","ويُذوي مُحياها الوسيمَ نُحول",83,"ل",1,0],["ينوحُ على عهدِ الشبيبةِ نادباً"