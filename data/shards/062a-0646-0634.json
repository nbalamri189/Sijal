https://www.poetsgate.com/ViewPoem.aspx?id=170503",""],[5582,"أَشَجاكَ لِعاتِكَةٍ طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=63553",""],[5781,"تراخى على القدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=211099",""],[5895,"قطرةٌ مِنْ أَنْهَارِ ِالأُمُومَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=198675",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"رحماكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182668",""],[5956,"من والى الاستعماريين فهو منهم","https://www.poetsgate.com/ViewPoem.aspx?id=192218",""],[5956,"وُعُود الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=192695",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""],[463,"إلى كمْ حبسها تشكو المضيقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60169&r=&rc=225",""]],"verses":[["تَنْشُرُ الزّهْرُ علَيْنا ورَقًا","نقَشَ الكوْنُ علَيْها وطَبَعْ",0,"ع",1,0],["تَنَشَّقَ مِن عَرفِ الصَبا ما تَنَشَّقا","وَعاوَدَهُ ذِكرُ الصِبا فَتَشَوَّقا",1,"ق",2,1],["تُنَشَّأُ مِن تَرآئِبِ شَرِّ فَحلٍ","وَحَلَّ بِشَرِّ مُرتَكَضٍ قَرارا",2,"ر",2,0],["تنشد الشعر في الغناء فتأتي","بلحون مطابقات المعاني",3,"ن",2,0],["تُنْشِدُ الناسَ نفسَها وهي في المهْ","رَقِ مثلَ الغِناء من أوحادِهْ",4,"د",2,0],["تُنْشئُ في تلكَ المَواتِ أنفُسا","تَربُّه الأنوارُ رَبّاً مِرغَسا",5,"س",2,0],["تنشَّب في أحشاء صدرك ظفره","فأضعفه عن حرب مكروبه الألب",6,"ب",1,0],["تُنشِدُ الناسَ في القَضِيَّةِ لَحناً","كَالحَوارِيِّ رَتَّلَ الإِنجيلا",7,"ل",2,0],["تُنشِدُ أَثوابُنا مَدائِحُهُ","بِأَلسُنٍ مالَهُنَّ أَفواهُ",8,"ا",2,0],["تَنشُو خِلالَ شِغافِ القلبِ إن نشأَتْ","ذاتُ الحَبابِ خِلالَ الطِّينِ والقارِ",9,"ر",1,0],["تَنشُرُ الحادِثاتُ طَوراً وَتَطوي","إِنَّما الحادِثاتُ نَشراً وَطِيّا",10,"ي",2,0],["تُنشِطُ رَبَّ العَجزِ إِلّا أَنَّها","تُعجِزُ بِالشُكرِ لِساني وَيَدي",11,"د",2,0],["تَنشالُ حَولَ مُدَرَّعٍ بِجِنانِهِ","فَكَأَنَّهُ مِن بَأسِهِ في مَعقِلِ",12,"ل",1,0],["تَنشَقُّ في ظُلَمِ المَعاني إِن دَجَت","مِنهُ تَباشيرُ الكَلامِ المُشرِقِ",13,"ق",1,0],["تُنَشِّفُ أَوشالَ النِطافِ وَدونَها","كُلى عِجَلٍ مَكتوبُهُنَّ وَكيعُ",14,"ع",1,0],["تَنشَقُّ رَوعاتُ الوَغى عَن رَأسِهِ","صَلَتانَ يَفتِكُ بِالأُمورِ وَحيدا",15,"د",2,0],["تَنَشّى الفَتى بِلَذيذِ المُدامِ","فَكانَ الخُمارُ عَقيبَ التَنَش",16,"ش",1,0],["تنشرُ الموْتَ بليلٍ مُقمِرِ","يا لمصرَ أتُرى لم تثأرِ",17,"ر",1,0],["تَنْشَقُهُ النَّفْسُ ذكِياً وَمَا","يَفْنى إِذَا مَا فَنِيَ العِطْرُ",18,"ر",1,0],["تنشدها المحافل المحافلا","تُولي الصديقَ نحلَها العواسلا",19,"ل",2,0],["تنشهّى (( تنوي)) تتحدّى","تستأني((تعدو)) تتخيّل",20,"ل",1,0],["تَنْشُرُ فيها يَدُ الرَّبيعِ لنَا","ثوباً مِنَ الوَشْيِ حاكَهُ القَطْرُ",21,"ر",1,0],["تَنَشَّرْتُ مِنْ نَشْرِهِ مسكَةً","ونَاجَيْتُ فَتْكِي بِسِرٍّ عَجَبْ",22,"ب",1,0],["تَنشَّمي في مدارِ الرّيح مُتْعِبَتي","أُلملِمُ الريحَ ، فيها مِسْك مُنْتَشَقي",23,"ق",2,0],["تنشقت منك اليود يقدح نفحه","بأطيب من نفح يطير عن الخمر",24,"ر",1,0],["تنشَقُّ عن وَلَدٍ حيٍّ إذا حَمَلَتْ","ولم يُشَقَّ لها عَيْنٌ ترى وفَمُ",25,"م",1,0],["تنشَّقتُ ريّا الوردِ من نفَحاتِها","وراعَيتُ فيها البدرَ منكِ تماما",26,"م",2,0],["تنشّقتُ النسيمَ فنعّشتني","نوافحُ برَّدت حرّى الكبود",27,"د",1,0],["تنشَّقتُ ريّا من صباها مُقبِّلاً","ثراها الذي يحوي عِظام غزاة",28,"ه",1,0],["تنشَّقتُ مِنكِ ومنها شذا","فرقَّق شِعري ولطّفَ حبّي",29,"ب",2,0],["تنشدُ الأمن والسلام وتبغي","لبقايا الأحزان في الدير قبرا",30,"ر",2,0],["تنشرين الضياء ثم تغيبي","ن فلا تنشقينَ عطر سلامي",31,"ي",1,0],["تَنشَطُ النَّفسُ بِهِ إِن سَئِمَت","يَرطُبُ العَيشُ بِهِ إِن يَبسا",32,"س",2,0],["تَنشُرُ وَحفاً مُسبَكِرّاً على","لَبَّاتِها أَسوَدَ مُغدَودِنا",33,"ن",2,0],["تنشرُ أثوابُنا مدائحَه","بألسُنٍ ما لهُنّ أفواهُ",34,"ه",1,1],["تُنشي بُرودَ أزاهرٍ","أبَداً محاسنها تزيد",35,"د",1,0],["تَنشُر ما بين مشرق الشمس وال","غرب رياحاً لأرضكم فُغُما",36,"م",2,0],["تنشّطْ سُوقَها واسرَحْ طُلاها","عساها أن تَرى للخصب سُوقا",37,"ق",2,0],["تنشرُ من أخفافها أجنحةً","وخيدُها على الثرى مَطارُها",38,"ر",3,0],["تنشر الوشيَ عبقرياً وتجلو","أوجهَ النور ملقياتِ الكمامِ",39,"م",1,0],["تنشدُ الرّوحُ السّلامَ أين كانَ","والسّلامُ في خُطاك أينَ رُحتا",40,"ت",2,0],["تنشر طي الجود منها ألسن","أعطر من نشر النسيم العاطر",41,"ر",1,0],["تنشق من ملقاك أعطر نفحة","تطيب على قلب الهدى حين تنشق",42,"ق",1,0],["تَنَشّر مِنكم في القواءِ معاشرٌ","كَأنّهُمُ لِلمُبصرينَ مُلاءُ",43,"ا",2,0],["تُنَشِّطُنِي أُخْرَيَاتُ الشَّبَابِ","وَتَقْتَادُنِي أُولَيَاتُ الكِبَرْ",44,"ر",1,0],["تَنْشَا لَهُ حَرَكَاتٌ في أَسَافِلِهِ","كأنها حركات الماءِ في الشَّجَرِ",45,"ر",1,0],["تنشا بنوك كما نشأت وتعتلى","ويكون منهم فاضل وعظيم",46,"م",1,0],["تنشقُّ أكمام لها عن كُسى","من حُللٍ تُبرِقُ ألوانِ",47,"ن",1,0],["تنشقتُ منها للوداد نواسماً","يفوق شذاها المسْكَ خالَطَه النَّدُّ",48,"د",1,0],["تُنَشِّفين البَحر وَالأَنهار","وَتَحرِقين اللَيلَ وَالنَهار",49,"ر",1,0],["تنشّأَ أصلُها من معْ","دن المعروفِ والفخر",50,"ر",1,0],["تنشْأ من أهلِ الندى آلِ هاشمٍ","فيا خيرَ ما فرعٍ تنشَّأ من حَوَّا",51,"و",2,0],["تنشق من غيظ إذا لم تجد","أير الدماغ النغل في شقها",52,"ق",3,0],["تَنشدُ الخطبا ونسيم الصبا","في رِياض الربا نفحهُ خضلُ",53,"ل",1,0],["تنشرُ العلمَ عَلى راسِ المَلا","وَتَرى خَيرَهُم أَقصى مُراد",54,"د",1,0],["تنشد النازِلين أَهلاً وَسَهلا","أدخلوا آمِنين أَسعد دار",55,"ر",1,0],["تَنْشَقُّ أَعرافُ الأُبابِ الجَفْلِ","عَنْ صُدُعٍ يَقْمُصْنَ بَعْدَ الزَجْلِ",56,"ل",1,0],["تَنَشَّطَتْ بِالعَسْفِ وَالإِمْجاجِ","شَأْسَ الصُوَى مَحْدَوْدِب الأَخْراجِ",57,"ج",1,0],["تَنَشَّطَتْهُ كُلُّ مِغْلاةِ الوَهَقْ","مَضْبُورَةٍ قَرْواءَ هِرْجابٍ فُنُقْ",58,"ق",1,0],["تَنشَقُّ عَن لَمعِ البَياضِ كَأَنَّها","قَلبِي تَبَسَّمَ عَن ثُغورِ وِدَادِي",59,"د",2,0],["تنشق النفس من شذاه فتحيا","عيشة غضّة بكل قرار",60,"ر",1,0],["تنشئ الخفَّة في روحِ النسيم","وتروضُ الصعبَ منهم للكرم",61,"م",1,0],["تَنشُد في أبنائها عاصماً","ترجوه يوم الحادث المُفزع",62,"ع",1,0],["تنشَد إسماعيل فيمن مضى","ثَكِلته يا مصرُ فاسترجعي",62,"ع",2,0],["تنشر الكتب قبل طرفة عين","في البرايا أو خطرةٍ من نسيم",63,"م",1,0],["تنشبُ النابَ في الذي نالَ منها","واستمالته مغرياتُ الحِسانِ",64,"ن",1,0],["تنشر عنها معجراً من زبرجد","يد الشمس ذرته عليها يد القطر",65,"ر",1,0],["تنشر الخير للعباد يمينا","والمبرّات مشرقات شمالا",66,"ل",2,0],["تَنشَقُّ أَصدافهُ في البَحث عن دُرَرٍ","تَهدي إِلى الحَقِّ مَفهوماً وَمُلتَزِما",67,"م",2,0],["تنشي لنا مْن الغرب غيم","شوامخٍ في مِبتداه",68,"ا",2,0],["تَنشَقُّ عَنهُ ظُلَمُ الغِمَارِ","تَمَزُّقَ الليلِ عنِ النّهَارِ",69,"ر",1,0],["تنشيطها الإنسان للعباده","شهراً عليه عشرة زياده",70,"ه",1,0],["تنشر فيها أيدي الربيع لنا","ثوباً من الوشي حاكه القطر",71,"ر",1,0],["تَنشدُ البانينَ والبانون قد","أيقظوها وغدَوا عنها نِياما",72,"م",2,0],["تنشر الشمس في الصباح ضياء","من مزيج اللجين بالتبر سالا",73,"ل",2,0],["تنشأ في الكهوف والغيران","من ماء سيل العارض الهتان",74,"ن",1,0],["تنشي لنا تحفا عليل نسيمها","يروي الشذا عن صحة الأخبار",75,"ر",1,0],["تنشَّق ريحاً من زرود فراعه","ترصدُ عيني قانص بزرودِ",76,"د",1,0],["تنشقت ريح العنبر الورد غدوة","نشقتُ بها فيك الرياح الحواصبا",77,"ب",2,0],["تنشر بعضُ الصحْف شعري ولا","يعرف لي أربابُها من حقوق",78,"ق",1,1],["تنشر الأمة بالعزم وإن","تك ميتا مدرجا في كفن",79,"ن",1,0],["تنشق الأَلطاف مِن أَعطافه","كُلما حركته زاد اهتِماما",80,"م",2,0],["تنشأُ منه سيئاتٌ جمّه","كذبٌ وتحريفُ مقالٍ عجمَه",81,"ه",1,0],["تنشى القلوب وتنسى الكروب","وتقصى اللغوب عن الخيرة",82,"ه",1,0],["تنشؤها مساكن صالحات","وتدرج بين ساحات الشهامه",83,"م",2,0],["تُنَشُّ علينا بارداتٌ من الصَّبا","فتُهدي لَنَا عِطراً من الزهر يَنْزع",84,"ع",1,0],["تَنشقُّ عَنهُ سُرَّة الوادي الَّذي","ما حَلَّ ناحيتيه إِلا سَيّدُ",85,"د",1,0],["تنشقتُ من انفاسها طيب مندل","ولكن غليلي الطيب لم يك ناقعا",86,"ع",2,0],["تنشقت من فيك عطر الثما","ر، أو نكهة العنب الناضجِ",87,"ج",1,1],["تنشي فواصل كالآذان منشأة","مثل الجمان عقوداً أي إنشاء",88,"ا",2,0],["تَنشُرُ الوَقتَ في الحَياةِ لِتَطوي","هِ جَديدا وَالبَعضُ في أَسمالِ",89,"ا",2,0],["تنشَّقتُ النَّسيمَ فما شَفاني","وَهل يشفِي عليلاً ذُو اعتِلالِ",90,"ل",1,0],["تَنَشَّرُ في الصَّبا وَنَذودُ عَنها","صَميمَ القُرِّ أَثباجٌ دِفاءُ",91,"ا",2,0],["تنشق رياحين السلام فانما","أفض بها مسكاً عليك مختما",92,"م",2,1],["تنشَّيْتُ وجدا إذ تنشَّيت عرفه","ولم لا ومنه عاطر الورد يعبق",93,"ق",1,0],["تنشقت من روض الرضا يا ابن صالح","نسائم قدسٍ من شذا العفو نافحٍ",94,"ح",1,1],["تنشر الذعر في بلاد عليها","خيم الموت والأسى والعويل",95,"ل",1,0],["تنشر الخوفَ على الأمن بِما","أُرضِعَتْ من شر ضرعِ الشغب",96,"ب",1,0],["تنشر الحب في نفوس عليها","سيطر الظلم دون أي انقطاع",97,"ع",1,0],["تنشر لك الأعلام يوم الوغى","بالفوز والعزة والفخر",98,"ر",1,0],["تنشئ العيون بخدها وردا أبي","بسوي اللواحظ غضهُ أن يقطفا",99,"ف",2,0],["تنشى اليسار بيمينه وتفي بما","عقدت إذا حلت وتجبر ما انكسر",100,"ر",1,0],["تُنَشِّئُ النّشْءَ ترعى الباحثينَ فما","كَفٌّ تَضِنُّ بها أو نالَها رَهَقُ",101,"ق",1,0],["تنشّيتُ سكرى بحضنِ الحبيبِ","فمِلتُ ارتِئادًا كغصنٍ رطيبِ",102,"ب",1,1],["تنشقّ ظلمة ظلم الأرض عن قمرٍ","إشراق دولته يأتي على الدول",103,"ل",1,0],["تنشق القلب شاذي نفحه، وكفى،","ما العطر للعين، إن العطر للقلب",104,"ب",1,0],["تُنشدُ الألحانَ في دنيا الهوى","دونَ أنْ تَدري خَفايا النّكسَةِ",105,"ه",1,0],["تنشقت بالدارات من مية عرفا","فرحت أصوب الدمع كالديمة الوطفا",106,"ف",2,1],["تُنْشِدُ الخُطَبا وَتَشِيمُ الصَّبا","فِي رِياضٍ رَيَّا نَفْحِهِ خَضِلُ",107,"ل",1,0],["تنشَّفَ دَمْعي في المحاجرِ مُجْهَدًا","وكُنْتَ خَضيبَ الشوقِ في اللِّينِ والعِنْدِ",108,"د",1,0],["تَنْشِلُنا من بَحْرِ هُمُومٍ فَيطُول العُمْرْ","ونبيتُ بأهْدابٍ تَحْنُو مِن مَهْدِ الذُّخْرْ",109,"ر",1,0],["تنشاق بعد عبير عنبر مسكها","رمم الانام وذا التراب وطاء",110,"ا",2,0],["تُنشِد في سمْعي أغنيةً","تسقيني البِشْرَ مدى الدهرِ",111,"ر",1,0],["تنشر الأزمات في أوطاننا","رغم هذا بعضنا والى الغبا",112,"ب",2,0],["تنَشط فينا الشكاية صبراً","تُسَهّل كل الصعاب علينا",113,"ن",2,0],["تنشَّق أوكسجيناً مستنيراً","بديل عفانة طول الليالي",114,"ل",2,0],["تنشد وكني انا ما زال","اعشق بحر عينك وبرك",115,"ك",1,0],["تنشد الحق والجمال وتفني","في سبيليهما الصبا والمشيبا",116,"ب",2,0],["تنشّطْ سوقها واسرحْ طلالها","عساها أنْ ترى للخصبِ سوقا",117,"ق",2,0]]}