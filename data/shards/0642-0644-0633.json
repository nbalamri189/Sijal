{"poems":[[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43854","البسيط"],[479,"قل سلام على العفاف إذا ما","https://www.aldiwan.net/poem37007.html","الخفيف"],[558,"قل هو الله","https://www.aldiwan.net/poem34606.html","مجزوء الرمل"]],"verses":[["قُلْ سَلامٌ عَلَيْكِ يَا خَيْرَ دَارٍ","بُورِكَتْ بِاسْمِهِ عَلَيْهِ السَّلامُ",0,"م",1,0],["قَلَّ سُروراً وَضاقَ ذَرعاً","خِلوٌ مِن اِبنٍ وَمِن صَديقِ",1,"ق",1,0],["قل سلام على العفاف إذا ما","برزت في ببابهن الغواني",2,"ي",1,1],["قل سواه باطلٌ","وهو الحقُّ الأحد",3,"د",1,0]]}