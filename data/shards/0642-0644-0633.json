{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43854","البسيط"],[484,"قل سلام على العفاف إذا ما","https://www.aldiwan.net/poem37007.html","الخفيف"],[563,"قل هو الله","https://www.aldiwan.net/poem34606.html","مجزوء الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""]],"verses":[["قُلْ سَلامٌ عَلَيْكِ يَا خَيْرَ دَارٍ","بُورِكَتْ بِاسْمِهِ عَلَيْهِ السَّلامُ",0,"م",1,0],["قَلَّ سُروراً وَضاقَ ذَرعاً","خِلوٌ مِن اِبنٍ وَمِن صَديقِ",1,"ق",1,0],["قل سلام على العفاف إذا ما","برزت في ببابهن الغواني",2,"ي",1,1],["قل سواه باطلٌ","وهو الحقُّ الأحد",3,"د",1,0],["قل سوف يلقى جسمه مجرداً","لأن هكطور استباح العددا",4,"د",2,0],["قل سلاما ثم أعرض عنهمو","جهلهم راميهمو في المقتلِ",5,"ل",1,0]]}