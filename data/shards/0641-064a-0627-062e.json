لاء المعرّي","https://www.poetsgate.com/ViewPoem.aspx?id=200503",""],[5781,"ريحاني نَعيمُهُ والوَردْ","https://www.poetsgate.com/ViewPoem.aspx?id=208765",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5937,"الأوركيديّة","https://www.poetsgate.com/ViewPoem.aspx?id=211800",""],[1920,"جدارٌ مُنهك","https://www.poetsgate.com/ViewPoem.aspx?id=198877",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""],[6093,"لقد سالت المآقي","https://www.poetsgate.com/ViewPoem.aspx?id=178383",""],[6148,"شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=201600",""],[6225,"رؤية المصطفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78023&r=&rc=108",""],[6229,"بين يدي الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65210&r=&rc=33",""],[6235,"قبور الأمهات..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77690&r=&rc=5",""],[463,"أشاقكَ منْ حسناءُ وهنا طروقها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60156&r=&rc=212",""],[6262,"اللغةُ لم تكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80118&r=&rc=16",""],[2220,"إذا أنا بالقرعِ الشديد لبابهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11201&r=&rc=75",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""]],"verses":[["فَيا خادِيَيْها سائِقَيْنِ طَلائِحاً","تَجوبُ بصَحْراءِ الأراكَةِ فَدْفَدا",0,"د",2,0],["فَيا خَيرَ سُوّاسِ هَذي الأُمورِ","وَناسِكَ أَربابِ هَذي الدُوَل",1,"ل",1,0],["فِي أُخْرَيَاتِ لَيالِيهِ يَجِدُّ بِهَا","سَعْياً كَمَا جَدَّ فِي أَيَّامِهِ الأُوَلِ",2,"ل",1,0],["فيا خجلي ويا عُتبي لدهرٍ","إذا وصل الدَّقيق إلى الهدايا",3,"ي",2,0],["فيأخذنا لذاك الزم","ع والإشفاق والفرق",4,"ق",1,0],["فَيا خَبَراً أَلقى الفَجيعَةَ بَينَنا","لَأَنتَ عَلَينا اليَومَ أَشأَمَ طائِرِ",5,"ر",1,0],["فَيا خَيرَ مَصحوبٍ إِذا أَنا لَم أَقُل","بِشُكرِكَ فَاِعلَم أَنَّني شَرُّ صاحِبِ",6,"ب",1,0],["في اِخضِرارٍ مِنَ اللِباسِ عَلى أَص","فَرَ يَختالُ في صَبيغَةِ وَرسِ",7,"س",1,0],["فَيا خَيرَ مَهزومٍ وَيا شَرَّ هازِمٍ","إِذا الشَيبُ راقَت لِلشَبابِ كَتايِبُه",8,"ب",2,0],["فَيا خَيرَ أَهلِ الأَرضِ إِنَّكَ لَو تَرى","بِساقَيَّ آثارَ القُيودِ النَواسِفِ",9,"ف",1,0],["فَيا خَيرَ مَن ضَمَّ الجَوانِحَ وَالحَشا","وَيا خَيرَ مَيتٍ ضَمّهُ التُربُ وَالثَرى",10,"ا",1,0],["فَيَا خَبَرَاً شَفَّ الْفُؤَادَ فَأَوْشَكَتْ","سُوَيْدَاؤُهُ أَنْ تَسْتَحِيلَ فَتَسْجُمَا",11,"م",2,0],["فيأخذُه عليٌّ شَرَّ أخذِ","أُصِيبَ بِقسْوَرِيِّ البأسِ فذِّ",12,"ذ",1,0],["في اخضرارٍ كأنه أَملي في","ك وثلجٍ نقاؤهُ كالجبين",13,"ن",1,0],["فيا خَسَارَةَ نَفْسٍ في تِجَارَتِها","لَمْ تَشْتَرِ الدِّينَ بالدُّنيا ولَمْ تَسُمِ",14,"م",1,0],["فَيَأخُذُ مِنها لَونُهُ بَعضَ لَونِها","فَلَوناهُما في الخَدِّ يَطَّرِدانِ",15,"ن",1,0],["فَيا خَيرَ مَدْعُوٍّ دَعَوتُكَ فَاْستَمِعْ","وما لِي شَفِيْعٌ غَيْرُ فَضْلِكَ فَاشْفَعِ",16,"ع",1,0],["في آخرِ الجُزءِ الّذي في الضَّربِ","أو في العَروضِ غير قولِ الكذبِ",17,"ب",1,0],["فِي اخْتِلاطٍ مُرْهِقٍ سُمَّاعَهُ","وَاخْتِلالٍ مُزْهِقٍ حَشْداً وَحَشْرا",18,"ر",2,0],["فِي آخِرِ المَعْمورِ كَمْ لَهم","آثَارُ إِبْدَاءٍ وَإِيجادِ",19,"د",1,0],["فيا خجلة الصحراء لم ينج جؤذر","ولا قرّ عينا بالأمان ظليم",20,"م",1,0],["فيأخذ من تذكرها فنونا","تزكيه بعلم الحب فهما",21,"م",2,0],["فيا خير البِقاعِ بكل أرضٍ","حويت المدح منا والنَّسبيَا",22,"ب",3,0],["فَيا خُطَّةً راثَت عَلَيكَ وَنى لَها","ثُمامَةُ يَرعاها عَلى السَيفِ جاثِمُ",23,"م",1,0],["فَيا خاطِبَ العَلياءِ لا تَحسَبَنَّها","حَديثَ العَذارى أَنشَأَتهُ المَغازِلُ",24,"ل",1,0],["فَيا خاطِبَ العَلياءِ لَيسَ مَنالُها","بِرَفعِ الغَواشي وَاِتِّخاذِ التَراجِمِ",25,"م",1,0],["فيا خالق الدنيا منىً وحقائقاً","ليعرفهُ أهل المنى والحقائقِ",26,"ق",1,0],["فيا خالق النار العصوف وشائقي","إليها أدم فيها لواعج إصلائي",27,"ي",1,0],["فيا خير من زم النياق لحجة","وألجم خيلا للجهاد وأسرجا",28,"ج",2,0],["فيا خير مبعوث إلى خير أمةً","به أصبحت في الخلق شامخة إلينا",29,"ن",2,0],["فَيَأخُذُ كُلٌّ مِن لِقائِكَ حَظَّهُ","وَما زِلتَ بِالقِسطاسِ تَحكُمُ وَالعَدلِ",30,"ل",1,0],["فيا خير من أعطى وأولى وحا","ول المعالي فاستولى وقال فأسمعا",31,"ع",2,0],["فيا خَيبةَ المسعى ويا ضَيعةَ الهوى","لدى صنمٍ عنهُ تُزاحُ البراقع",32,"ع",1,0],["فَيا خَطيبَ القُدسِ يا مَن غَدا","أَفصَحَ مِن قُسٍّ وَسَحبانا",33,"ن",2,0],["فَيا خَيرَ خَلقِ اللَه جئتُك قاصِداً","وَقصدُك في الدارين مَغنىً ومغنَمُ",34,"م",1,0],["فيا خدرَ الأُباةِ بلا هوان","صبرتِ على الأذى صبراً جميلا",35,"ل",2,0],["فيأخذُ مُذْ بِنتُمْ ليالِيَّ قاطِعاً","ذَوائبَها لم يَنتسِبْنَ إلى عُمري",36,"ر",2,0],["فيأخذُهُ فيرفعُهُ","فيَخفِضُهُ فَيَقتَصِدُه",37,"د",2,0],["فيا خائضاً بحر العروض بنظمه","ويعجبه منه بسيطٌ وكامل",38,"ل",1,0],["فيا خَاطِراً في رداءِ الْبَها","سواكَ بِبَالِيَ لاَ يخطرُ",39,"ر",1,0],["فيأخذ للمظلوم من حسنات من","غدا ظالماً يا ويح من هو ظالم",40,"م",1,0],["فيأخذها منهم غني ومترف","ورب فقير دمعه يتحدر",41,"ر",1,0],["فيا خليليَّ أما منكما","من يسعد الصب بما يطلب",42,"ب",1,0],["فيا خِزْيَ ذا مِنْ سَبْقِ خَطْوٍ مُخاطِرٍ","ويا لَهْفَ ذا مِنْ فَوْتِ غِرَّةِ مُغْتَرِّ",43,"ر",1,0],["فيا خير من وَلَدَتْهُ الملوكُ","وأَكرَمَ من نَصَرَتْهُ الجنودُ",44,"د",1,0],["فيا خالي البال دعني وحزني","فليس الخلي بحال الشجي",45,"ي",1,0],["فيا خِّلىَ الحرَّ الأبى وتوأمي","بروحي وتفكيري بيومي وغابري",46,"ر",2,0],["فيأخذُ يومُ المهرجان اصطفاءَه","بحصَّته من فذِّها وتؤامِها",47,"م",3,0],["فيا خجلةً في خيبة فاض وَرْسُها","حياءً بما خابت وغاض خَلوقُها",48,"ق",3,0],["فيأخُذَ حقاً عاقَهُ الدهرُ دونَهُ","فغادرهُ رهنَ الحمامِ المُقَدَّرِ",49,"ر",1,0],["فَيا خِلَّةَ النَفسِ الَّتي لَيسَ فَوقَها","لَنا مِن أَخِلّاءِ الصَفاءِ خَليلُ",50,"ل",1,0],["في اِختِصاصِ التُفّاحِ بِالطَيِّبِ وَالخَم","رَةِ لا في كَثافَةِ التُفّاحِ",51,"ح",1,0],["فيأخذها الاني بمولاه عارفاً","ويأخذها المرد حسب الطوية",52,"ه",1,0],["في إِخوَةٍ جَمَعوا نَدىً وَسَماحَةً","هُضمٍ إِذا أَزمُ الشِتاءِ تَزَعَّبا",53,"ب",2,0],["فيا خابط العشواء في طلب الغنى","وعقل الفتى من وصمة الجهل معقل",54,"ل",1,0],["فيا خبراً أذرى العيونَ جوامداً","وأبقى القلوبَ السّاكناتِ خوافقا",55,"ق",2,0],["فَيا خَاتَم الرُّسْلِ الكِرَامِ وَمَنْ بِهِ","لَنَا مِنْ مَهُولاتِ الذُّنوبِ تَخَلُّصُ",56,"ص",1,1],["فيا خَجْلةَ الظَّبْي لَمّا بَدا","شَبيهاً لَهُ في اللَّمَى وَالكَحَلْ",57,"ل",1,0],["فيا خَيّالْ خذ الأَبطالْ","مَع الأَقيالْ في الأَغلاس",58,"س",1,0],["فَيا خَليليَّ هَذا الربعُ لاحَ لَنا","يَدعو الوُقوفَ عَلَيهِ وَالبُكا فقِفا",59,"ف",2,0],["فيا خلة راموا هلاكي وأرفعوا","تخذتكم درعاً حصيناً لتمنعوا",60,"ع",3,0],["فيا خير مغوار أظلَّتهُ رايةٌ","وأتقى إمامٍ باسمه اهتز منبر",61,"ر",1,0],["في أخت مصر لأجل مصر عواصف","هاجت هوى الجارات والأتراب",62,"ب",1,0],["في أخضرٍ يمشي وفي أحمرٍ","كالغصنِ في الأوراقِ والنَّوْر",63,"ر",1,0],["فَيا خَيبَةَ المَسعى ويا ضَيعَةَ السُّرى","وَيا شقوةَ السّاعي إِذا فاتَهُ المُنى",64,"ا",1,0],["في إخائي وفي وفائي ورائي","وعفافي ومنطقي وفعالي",65,"ل",2,0],["فَيا خَيرَ جَيشٍ لِلعِراقِ وَأَهلِهِ","سُقيتُم رَوايا كُلِّ أَسحَمَ ساكِبِ",66,"ب",1,0],["فيا خالقي قد سمعتَ دعائي","تقبَلْه يا أرحمَ الراحمينا",67,"ن",2,0],["فيا خطباء المنبرين بحضرتي","حِماكم يُناجيني بمحض وداده",68,"د",2,0],["فيا خيماتِ أنسٍ تحتميها","ليوث سادة لم يستعابوا",69,"ب",3,0],["فَيا خَير من والى وآلى ومن عَلا","وَيا خَير من صَلى وَيا خير ما أما",70,"م",2,0],["فيا خير الأنام عساك تصغي","لمدح جاء يدلي بافتقار",71,"ر",1,0],["فَيا خَير مَن يدعى لِكُل مُلمة","وَأَكرم مَن يرجى لِنَيل الرَّغائِب",72,"ب",1,0],["فيا خليلي مدحاً","ماشيتما فيه قولا",73,"ل",2,0],["فيا خير خلق الله جدلي بالرضا","وأمن مخافي من عقاب المآثم",74,"م",1,0],["فيا خاتم الرسل الكرام شفاعة","إلى الله نرجوها فلا تقطع الرجوى",75,"و",2,0],["فيا خير ما ذقنا ويا حسن مابه","نطقنا وفرق بين وصف وخبرة",76,"ه",1,0],["فيا خاطب الحسناء أمهر بدعوةٍ","فمن خطب الحسناء بحسن في المهر",77,"ر",1,0],["في آخر البا نصفها الاعلى ومن","يقول كالبا قُلبت فقد وَهَن",78,"ن",1,0],["فيا خليلي إلى كم ارى","دمعي وحبي دائماً في انتزاح",79,"ح",1,0],["فيا خافض اخفضه بأسفل سافل","وسلط عليه الرجز في كل وجهة",80,"ه",1,0],["فَيَا خَاطِري وَفِّ الثّنَاءَ حُقوقَهُ","وَصِفهُ كَمَا قَالُوا سِوَارٌ عَلَى زَندِ",81,"د",1,0],["فيا خير الورى إني دخيلٌ","بجاهك والخطوبُ كما تراها",82,"ا",3,0],["في اختبار كأنه حجر الصا","ئِغُ يُبدى الجواهرَ المقبُولَه",83,"ل",2,0],["فيا 