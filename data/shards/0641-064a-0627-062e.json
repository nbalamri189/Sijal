{"poems":[[63,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[93,"نأسى إذا ودعتنا الشمس في الطفل","https://www.aldiwan.net/poem11475.html","البسيط"],[72,"برغمي أن أهاديكم بمعنى","https://www.aldiwan.net/poem20609.html","الوافر"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[45,"محمد ما آمالنا بكواذب","https://www.aldiwan.net/poem10648.html","الطويل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[28,"ألا حبذا البيت الذي أنت هايبه","https://www.aldiwan.net/poem1265.html",""],[28,"تصيح به الأصداء يخشى به الردى","https://www.aldiwan.net/poem5319.html","الطويل"],[58,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[87,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"وخمر كعين الديك صبحت سحرة","https://www.aldiwan.net/poem65292.html","الطويل"],[76,"بني لئن أعيا الطبيب ابن مسلم","https://www.aldiwan.net/poem39264.html","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[113,"سقاك العارض الوسمي سجما","https://www.aldiwan.net/poem40598.html","عموديه"],[126,"أيا سوقا فلو صورت شخصا","https://www.aldiwan.net/poem50670.html","الوافر"],[129,"لعمرك ما آسى حراض ابن أمه","https://www.aldiwan.net/poem23983.html","الطويل"],[167,"صداق المعالي مشرفي وذابل","https://www.aldiwan.net/poem1647.html",""],[167,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[197,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[209,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[229,"أوجهك أم ضوء الصباح تبلجا","https://www.aldiwan.net/poem44571.html","الطويل"],[229,"إذا صار قلب العبد للسر معدنا","https://www.aldiwan.net/poem44575.html","الطويل"],[233,"حللت حلول الغيث في البلد المحل","https://www.aldiwan.net/poem31791.html","الطويل"],[259,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[268,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[280,"يا من لأهل الفضل أنسانا","https://www.aldiwan.net/poem32338.html","السريع"],[295,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[296,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[362,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[363,"أمرتك يوم ذي صنعاء أمرا","https://www.aldiwan.net/poem44520.html","مجزوء الوافر"],[374,"لقد نزل المولى العلي وهو رافل","https://www.aldiwan.net/poem59289.html","الطويل"],[399,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[400,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[400,"سؤال فهل مفت عليه يحرر","https://www.aldiwan.net/poem33932.html","الطويل"],[400,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[436,"زمان جديد وصنع جديد","https://www.aldiwan.net/poem34911.html","المتقارب"],[438,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[451,"أخي وجمال الشعر ما أنت ناثر","https://www.aldiwan.net/poem61748.html","الطويل"],[456,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[456,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[459,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[464,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem50386.html","الطويل"],[491,"غادني بالصبوح قبل الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[498,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[505,"أبلغ لديك أبا خليد وائلاً","https://www.aldiwan.net/poem2135.html","الكامل"],[513,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[549,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[584,"فيا خاتم الرسل الكرام ومن به","https://www.aldiwan.net/poem17570.html","الطويل"],[584,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["فَيا خادِيَيْها سائِقَيْنِ طَلائِحاً","تَجوبُ بصَحْراءِ الأراكَةِ فَدْفَدا",0,"د",2,0],["فَيا خَيرَ سُوّاسِ هَذي الأُمورِ","وَناسِكَ أَربابِ هَذي الدُوَل",1,"ل",1,0],["فِي أُخْرَيَاتِ لَيالِيهِ يَجِدُّ بِهَا","سَعْياً كَمَا جَدَّ فِي أَيَّامِهِ الأُوَلِ",2,"ل",1,0],["فيا خجلي ويا عُتبي لدهرٍ","إذا وصل الدَّقيق إلى الهدايا",3,"ي",2,0],["فيأخذنا لذاك الزم","ع والإشفاق والفرق",4,"ق",1,0],["فَيا خَبَراً أَلقى الفَجيعَةَ بَينَنا","لَأَنتَ عَلَينا اليَومَ أَشأَمَ طائِرِ",5,"ر",1,0],["فَيا خَيرَ مَصحوبٍ إِذا أَنا لَم أَقُل","بِشُكرِكَ فَاِعلَم أَنَّني شَرُّ صاحِبِ",6,"ب",1,0],["في اِخضِرارٍ مِنَ اللِباسِ عَلى أَص","فَرَ يَختالُ في صَبيغَةِ وَرسِ",7,"س",1,0],["فَيا خَيرَ مَهزومٍ وَيا شَرَّ هازِمٍ","إِذا الشَيبُ راقَت لِلشَبابِ كَتايِبُه",8,"ب",2,0],["فَيا خَيرَ أَهلِ الأَرضِ إِنَّكَ لَو تَرى","بِساقَيَّ آثارَ القُيودِ النَواسِفِ",9,"ف",1,0],["فَيا خَيرَ مَن ضَمَّ الجَوانِحَ وَالحَشا","وَيا خَيرَ مَيتٍ ضَمّهُ التُربُ وَالثَرى",10,"ا",1,0],["فَيَا خَبَرَاً شَفَّ الْفُؤَادَ فَأَوْشَكَتْ","سُوَيْدَاؤُهُ أَنْ تَسْتَحِيلَ فَتَسْجُمَا",11,"م",2,0],["فيأخذُه عليٌّ شَرَّ أخذِ","أُصِيبَ بِقسْوَرِيِّ البأسِ فذِّ",12,"ذ",1,0],["في اخضرارٍ كأنه أَملي في","ك وثلجٍ نقاؤهُ كالجبين",13,"ن",1,0],["فيا خَسَارَةَ نَفْسٍ في تِجَارَتِها","لَمْ تَشْتَرِ الدِّينَ بالدُّنيا ولَمْ تَسُمِ",14,"م",1,0],["فَيَأخُذُ مِنها لَونُهُ بَعضَ لَونِها","فَلَوناهُما في الخَدِّ يَطَّرِدانِ",15,"ن",1,0],["فَيا خَيرَ مَدْعُوٍّ دَعَوتُكَ فَاْستَمِعْ","وما لِي شَفِيْعٌ غَيْرُ فَضْلِكَ فَاشْفَعِ",16,"ع",1,0],["في آخرِ الجُزءِ الّذي في الضَّربِ","أو في العَروضِ غير قولِ الكذبِ",17,"ب",1,0],["فِي اخْتِلاطٍ مُرْهِقٍ سُمَّاعَهُ","وَاخْتِلالٍ مُزْهِقٍ حَشْداً وَحَشْرا",18,"ر",2,0],["فِي آخِرِ المَعْمورِ كَمْ لَهم","آثَارُ إِبْدَاءٍ وَإِيجادِ",19,"د",1,0],["فيأخذ من تذكرها فنونا","تزكيه بعلم الحب فهما",20,"م",2,0],["فيا خير البِقاعِ بكل أرضٍ","حويت المدح منا والنَّسبيَا",21,"ب",3,0],["فَيا خُطَّةً راثَت عَلَيكَ وَنى لَها","ثُمامَةُ يَرعاها عَلى السَيفِ جاثِمُ",22,"م",1,0],["فَيا خاطِبَ العَلياءِ لا تَحسَبَنَّها","حَديثَ العَذارى أَنشَأَتهُ المَغازِلُ",23,"ل",1,0],["فَيا خاطِبَ العَلياءِ لَيسَ مَنالُها","بِرَفعِ الغَواشي وَاِتِّخاذِ التَراجِمِ",24,"م",1,0],["فيا خالق الدنيا منىً وحقائقاً","ليعرفهُ أهل المنى والحقائقِ",25,"ق",1,0],["فيا خالق النار العصوف وشائقي","إليها أدم فيها لواعج إصلائي",26,"ي",1,0],["فيا خير من زم النياق لحجة","وألجم خيلا للجهاد وأسرجا",27,"ج",2,0],["فيا خير مبعوث إلى خير أمةً","به أصبحت في الخلق شامخة إلينا",28,"ن",2,0],["فَيَأخُذُ كُلٌّ مِن لِقائِكَ حَظَّهُ","وَما زِلتَ بِالقِسطاسِ تَحكُمُ وَالعَدلِ",29,"ل",1,0],["فيا خير من أعطى وأولى وحا","ول المعالي فاستولى وقال فأسمعا",30,"ع",2,0],["فيا خَيبةَ المسعى ويا ضَيعةَ الهوى","لدى صنمٍ عنهُ تُزاحُ البراقع",31,"ع",1,0],["فَيا خَطيبَ القُدسِ يا مَن غَدا","أَفصَحَ مِن قُسٍّ وَسَحبانا",32,"ن",2,0],["فَيا خَيرَ خَلقِ اللَه جئتُك قاصِداً","وَقصدُك في الدارين مَغنىً ومغنَمُ",33,"م",1,0],["فيا خدرَ الأُباةِ بلا هوان","صبرتِ على الأذى صبراً جميلا",34,"ل",2,0],["فيأخذُ مُذْ بِنتُمْ ليالِيَّ قاطِعاً","ذَوائبَها لم يَنتسِبْنَ إلى عُمري",35,"ر",2,0],["فيأخذُهُ فيرفعُهُ","فيَخفِضُهُ فَيَقتَصِدُه",36,"د",2,0],["فيا خائضاً بحر العروض بنظمه","ويعجبه منه بسيطٌ وكامل",37,"ل",1,0],["فيا خَاطِراً في رداءِ الْبَها","سواكَ بِبَالِيَ لاَ يخطرُ",38,"ر",1,0],["فيأخذ للمظلوم من حسنات من","غدا ظالماً يا ويح من هو ظالم",39,"م",1,0],["فيأخذها منهم غني ومترف","ورب فقير دمعه يتحدر",40,"ر",1,0],["فيا خليليَّ أما منكما","من يسعد الصب بما يطلب",41,"ب",1,0],["فيا خِزْيَ ذا مِنْ سَبْقِ خَطْوٍ مُخاطِرٍ","ويا لَهْفَ ذا مِنْ فَوْتِ غِرَّةِ مُغْتَرِّ",42,"ر",1,0],["فيا خير من وَلَدَتْهُ الملوكُ","وأَكرَمَ من نَصَرَتْهُ الجنودُ",43,"د",1,0],["فيا خالي البال دعني وحزني","فليس الخلي بحال الشجي",44,"ي",1,0],["فيا خِّلىَ الحرَّ الأبى وتوأمي","بروحي وتفكيري بيومي وغابري",45,"ر",2,0],["فيأخذُ يومُ المهرجان اصطفاءَه","بحصَّته من فذِّها وتؤامِها",46,"م",3,0],["فيا خجلةً في خيبة فاض وَرْسُها","حياءً بما خابت وغاض خَلوقُها",47,"ق",3,0],["فيأخُذَ حقاً عاقَهُ الدهرُ دونَهُ","فغادرهُ رهنَ الحمامِ المُقَدَّرِ",48,"ر",1,0],["فَيا خِلَّةَ النَفسِ الَّتي لَيسَ فَوقَها","لَنا مِن أَخِلّاءِ الصَفاءِ خَليلُ",49,"ل",1,0],["في اِختِصاصِ التُفّاحِ بِالطَيِّبِ وَالخَم","رَةِ لا في كَثافَةِ التُفّاحِ",50,"ح",1,0],["فيأخذها الاني بمولاه عارفاً","ويأخذها المرد حسب الطوية",51,"ه",1,0],["في إِخوَةٍ جَمَعوا نَدىً وَسَماحَةً","هُضمٍ إِذا أَزمُ الشِتاءِ تَزَعَّبا",52,"ب",2,0],["فيا خابط العشواء في طلب الغنى","وعقل الفتى من وصمة الجهل معقل",53,"ل",1,0],["فيا خبراً أذرى العيونَ جوامداً","وأبقى القلوبَ السّاكناتِ خوافقا",54,"ق",2,0],["فَيا خَاتَم الرُّسْلِ الكِرَامِ وَمَنْ بِهِ","لَنَا مِنْ مَهُولاتِ الذُّنوبِ تَخَلُّصُ",55,"ص",1,1],["فيا خَجْلةَ الظَّبْي لَمّا بَدا","شَبيهاً لَهُ في اللَّمَى وَالكَحَلْ",56,"ل",1,0]]}