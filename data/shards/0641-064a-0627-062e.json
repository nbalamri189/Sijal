{"poems":[[63,"غدا أبطن الكشح الحسام المهندا","https://www.aldiwan.net/poem46171.html","الوافر"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[93,"نأسى إذا ودعتنا الشمس في الطفل","https://www.aldiwan.net/poem11475.html","البسيط"],[72,"برغمي أن أهاديكم بمعنى","https://www.aldiwan.net/poem20609.html","الوافر"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[45,"محمد ما آمالنا بكواذب","https://www.aldiwan.net/poem10648.html","الطويل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[28,"ألا حبذا البيت الذي أنت هايبه","https://www.aldiwan.net/poem1265.html",""],[28,"تصيح به الأصداء يخشى به الردى","https://www.aldiwan.net/poem5319.html","الطويل"],[58,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[87,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"وخمر كعين الديك صبحت سحرة","https://www.aldiwan.net/poem65292.html","الطويل"],[76,"بني لئن أعيا الطبيب ابن مسلم","https://www.aldiwan.net/poem39264.html","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[94,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[115,"سقاك العارض الوسمي سجما","https://www.aldiwan.net/poem40598.html","عموديه"],[128,"أيا سوقا فلو صورت شخصا","https://www.aldiwan.net/poem50670.html","الوافر"],[131,"لعمرك ما آسى حراض ابن أمه","https://www.aldiwan.net/poem23983.html","الطويل"],[169,"صداق المعالي مشرفي وذابل","https://www.aldiwan.net/poem1647.html",""],[169,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[199,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[211,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[231,"أوجهك أم ضوء الصباح تبلجا","https://www.aldiwan.net/poem44571.html","الطويل"],[231,"إذا صار قلب العبد للسر معدنا","https://www.aldiwan.net/poem44575.html","الطويل"],[235,"حللت حلول الغيث في البلد المحل","https://www.aldiwan.net/poem31791.html","الطويل"],[261,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[270,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[282,"يا من لأهل الفضل أنسانا","https://www.aldiwan.net/poem32338.html","السريع"],[297,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[298,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[364,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[365,"أمرتك يوم ذي صنعاء أمرا","https://www.aldiwan.net/poem44520.html","مجزوء الوافر"],[377,"لقد نزل المولى العلي وهو رافل","https://www.aldiwan.net/poem59289.html","الطويل"],[402,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[403,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[403,"سؤال فهل مفت عليه يحرر","https://www.aldiwan.net/poem33932.html","الطويل"],[403,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[439,"زمان جديد وصنع جديد","https://www.aldiwan.net/poem34911.html","المتقارب"],[441,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[453,"أخي وجمال الشعر ما أنت ناثر","https://www.aldiwan.net/poem61748.html","الطويل"],[458,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[458,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[461,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[466,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem50386.html","الطويل"],[493,"غادني بالصبوح قبل الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[500,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[507,"أبلغ لديك أبا خليد وائلاً","https://www.aldiwan.net/poem2135.html","الكامل"],[515,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[551,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[586,"فيا خاتم الرسل الكرام ومن به","https://www.aldiwan.net/poem17570.html","الطويل"],[586,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["فَيا خادِيَيْها سائِقَيْنِ طَلائِحاً","تَجوبُ بصَحْراءِ الأراكَةِ فَدْفَدا",0,"د",2,0],["فَيا خَيرَ سُوّاسِ هَذي الأُمورِ","وَناسِكَ أَربابِ هَذي الدُوَل",1,"ل",1,0],["فِي أُخْرَيَاتِ لَيالِيهِ يَجِدُّ بِهَا","سَعْياً كَمَا جَدَّ فِي أَيَّامِهِ الأُوَلِ",2,"ل",1,0],["فيا خجلي ويا عُتبي لدهرٍ","إذا وصل الدَّقيق إلى الهدايا",3,"ي",2,0],["فيأخذنا لذاك الزم","ع والإشفاق والفرق",4,"ق",1,0],["فَيا خَبَراً أَلقى الفَجيعَةَ بَينَنا","لَأَنتَ عَلَينا اليَومَ أَشأَمَ طائِرِ",5,"ر",1,0],["فَيا خَيرَ مَصحوبٍ إِذا أَنا لَم أَقُل","بِشُكرِكَ فَاِعلَم أَنَّني شَرُّ صاحِبِ",6,"ب",1,0],["في اِخضِرارٍ مِنَ اللِباسِ عَلى أَص","فَرَ يَختالُ في صَبيغَةِ وَرسِ",7,"س",1,0],["فَيا خَيرَ مَهزومٍ وَيا شَرَّ هازِمٍ","إِذا الشَيبُ راقَت لِلشَبابِ كَتايِبُه",8,"ب",2,0],["فَيا خَيرَ أَهلِ الأَرضِ إِنَّكَ لَو تَرى","بِساقَيَّ آثارَ القُيودِ النَواسِفِ",9,"ف",1,0],["فَيا خَيرَ مَن ضَمَّ الجَوانِحَ وَالحَشا","وَيا خَيرَ مَيتٍ ضَمّهُ التُربُ وَالثَرى",10,"ا",1,0],["فَيَا خَبَرَاً شَفَّ الْفُؤَادَ فَأَوْشَكَتْ","سُوَيْدَاؤُهُ أَنْ تَسْتَحِيلَ فَتَسْجُمَا",11,"م",2,0],["فيأخذُه عليٌّ شَرَّ أخذِ","أُصِيبَ بِقسْوَرِيِّ البأسِ فذِّ",12,"ذ",1,0],["في اخضرارٍ كأنه أَملي في","ك وثلجٍ نقاؤهُ كالجبين",13,"ن",1,0],["فيا خَسَارَةَ نَفْسٍ في تِجَارَتِها","لَمْ تَشْتَرِ الدِّينَ بالدُّنيا ولَمْ تَسُمِ",14,"م",1,0],["فَيَأخُذُ مِنها لَونُهُ بَعضَ لَونِها","فَلَوناهُما في الخَدِّ يَطَّرِدانِ",15,"ن",1,0],["فَيا خَيرَ مَدْعُوٍّ دَعَوتُكَ فَاْستَمِعْ","وما لِي شَفِيْعٌ غَيْرُ فَضْلِكَ فَاشْفَعِ",16,"ع",1,0],["في آخرِ الجُزءِ الّذي في الضَّربِ","أو في العَروضِ غير قولِ الكذبِ",17,"ب",1,0],["فِي اخْتِلاطٍ مُرْهِقٍ سُمَّاعَهُ","وَاخْتِلالٍ مُزْهِقٍ حَشْداً وَحَشْرا",18,"ر",2,0],["فِي آخِرِ المَعْمورِ كَمْ لَهم","آثَارُ إِبْدَاءٍ وَإِيجادِ",19,"د",1,0],["فيا خجلة الصحراء لم ينج جؤذر","ولا قرّ عينا بالأمان ظليم",20,"م",1,0],["فيأخذ من تذكرها فنونا","تزكيه بعلم الحب فهما",21,"م",2,0],["فيا خير البِقاعِ بكل أرضٍ","حويت المدح منا والنَّسبيَا",22,"ب",3,0],["فَيا خُطَّةً راثَت عَلَيكَ وَنى لَها","ثُمامَةُ يَرعاها عَلى السَيفِ جاثِمُ",23,"م",1,0],["فَيا خاطِبَ العَلياءِ لا تَحسَبَنَّها","حَديثَ العَذارى أَنشَأَتهُ المَغازِلُ",24,"ل",1,0],["فَيا خاطِبَ العَلياءِ لَيسَ مَنالُها","بِرَفعِ الغَواشي وَاِتِّخاذِ التَراجِمِ",25,"م",1,0],["فيا خالق الدنيا منىً وحقائقاً","ليعرفهُ أهل المنى والحقائقِ",26,"ق",1,0],["فيا خالق النار العصوف وشائقي","إليها أدم فيها لواعج إصلائي",27,"ي",1,0],["فيا خير من زم النياق لحجة","وألجم خيلا للجهاد وأسرجا",28,"ج",2,0],["فيا خير مبعوث إلى خير أمةً","به أصبحت في الخلق شامخة إلينا",29,"ن",2,0],["فَيَأخُذُ كُلٌّ مِن لِقائِكَ حَظَّهُ","وَما زِلتَ بِالقِسطاسِ تَحكُمُ وَالعَدلِ",30,"ل",1,0],["فيا خير من أعطى وأولى وحا","ول المعالي فاستولى وقال فأسمعا",31,"ع",2,0],["فيا خَيبةَ المسعى ويا ضَيعةَ الهوى","لدى صنمٍ عنهُ تُزاحُ البراقع",32,"ع",1,0],["فَيا خَطيبَ القُدسِ يا مَن غَدا","أَفصَحَ مِن قُسٍّ وَسَحبانا",33,"ن",2,0],["فَيا خَيرَ خَلقِ اللَه جئتُك قاصِداً","وَقصدُك في الدارين مَغنىً ومغنَمُ",34,"م",1,0],["فيا خدرَ الأُباةِ بلا هوان","صبرتِ على الأذى صبراً جميلا",35,"ل",2,0],["فيأخذُ مُذْ بِنتُمْ ليالِيَّ قاطِعاً","ذَوائبَها لم يَنتسِبْنَ إلى عُمري",36,"ر",2,0],["فيأخذُهُ فيرفعُهُ","فيَخفِضُهُ فَيَقتَصِدُه",37,"د",2,0],["فيا خائضاً بحر العروض بنظمه","ويعجبه منه بسيطٌ وكامل",38,"ل",1,0],["فيا خَاطِراً في رداءِ الْبَها","سواكَ بِبَالِيَ لاَ يخطرُ",39,"ر",1,0],["فيأخذ للمظلوم من حسنات من","غدا ظالماً يا ويح من هو ظالم",40,"م",1,0],["فيأخذها منهم غني ومترف","ورب فقير دمعه يتحدر",41,"ر",1,0],["فيا خليليَّ أما منكما","من يسعد الصب بما يطلب",42,"ب",1,0],["فيا خِزْيَ ذا مِنْ سَبْقِ خَطْوٍ مُخاطِرٍ","ويا لَهْفَ ذا مِنْ فَوْتِ غِرَّةِ مُغْتَرِّ",43,"ر",1,0],["فيا خير من وَلَدَتْهُ الملوكُ","وأَكرَمَ من نَصَرَتْهُ الجنودُ",44,"د",1,0],["فيا خالي البال دعني وحزني","فليس الخلي بحال الشجي",45,"ي",1,0],["فيا خِّلىَ الحرَّ الأبى وتوأمي","بروحي وتفكيري بيومي وغابري",46,"ر",2,0],["فيأخذُ يومُ المهرجان اصطفاءَه","بحصَّته من فذِّها وتؤامِها",47,"م",3,0],["فيا خجلةً في خيبة فاض وَرْسُها","حياءً بما خابت وغاض خَلوقُها",48,"ق",3,0],["فيأخُذَ حقاً عاقَهُ الدهرُ دونَهُ","فغادرهُ رهنَ الحمامِ المُقَدَّرِ",49,"ر",1,0],["فَيا خِلَّةَ النَفسِ الَّتي لَيسَ فَوقَها","لَنا مِن أَخِلّاءِ الصَفاءِ خَليلُ",50,"ل",1,0],["في اِختِصاصِ التُفّاحِ بِالطَيِّبِ وَالخَم","رَةِ لا في كَثافَةِ التُفّاحِ",51,"ح",1,0],["فيأخذها الاني بمولاه عارفاً","ويأخذها المرد حسب الطوية",52,"ه",1,0],["في إِخوَةٍ جَمَعوا نَدىً وَسَماحَةً","هُضمٍ إِذا أَزمُ الشِتاءِ تَزَعَّبا",53,"ب",2,0],["فيا خابط العشواء في طلب الغنى","وعقل الفتى من وصمة الجهل معقل",54,"ل",1,0],["فيا خبراً أذرى العيونَ جوامداً","وأبقى القلوبَ السّاكناتِ خوافقا",55,"ق",2,0],["فَيا خَاتَم الرُّسْلِ الكِرَامِ وَمَنْ بِهِ","لَنَا مِنْ مَهُولاتِ الذُّنوبِ تَخَلُّصُ",56,"ص",1,1],["فيا خَجْلةَ الظَّبْي لَمّا بَدا","شَبيهاً لَهُ في اللَّمَى وَالكَحَلْ",57,"ل",1,0]]}