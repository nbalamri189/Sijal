ِذَا بَعُدَ المُؤَمَّلُ أَدْرَكُوهُ","قَرِيبَ الشَّأْوِ مَيْسُورَ الطِّلاَبِ",166,"ب",1,0],["إِذَا بَانَ سَرْكِيسُ الأَدِيبُ فَمَنْ لَهُ","بَرَاعَةُ مُفْتَنٍّ وَعِلْمُ مُحَقِّقِ",167,"ق",1,0],["إِذا بَاتَ يَسْتَوحِي فَأَوْغَلَ صَاعِداً","حَتَّى أَلمَّ بِمَصْدَرِ الإِيحَاءِ",168,"ا",2,0],["إِذا بَزَغَت ذكاءُ فَزِد بُكاء","وَقُل ما كانَ ذاكَ سِوى أَخي ذي",169,"ي",1,0],["إِذا بارَزَ الأَقرانَ شَدَّدَ خامِعاً","فَما هِيَ إِلّا شِدَّةٌ فَوُثوبُ",170,"ب",1,0],["إِذا بَرَعَ الطِّبُّ الحَدِيثُ فَقُلْ لَهُ","يَدُ المَوْتِ أَمْضَى مِنْ يَدَيْك وأَبْرَع",171,"ع",1,0],["إذا بعُدت آمالُهم فتردَّدوا","دعاهم إلى الإقدامِ فاتسقربوا البعدا",172,"د",2,0],["إِذا بَدَا الْفَجْرُ ظَنَّتْهُ ضَرَاغِمُهَا","سَيْفاً فَكَرَّتْ إِلَيْه كَرَّ صِنْدِيدِ",173,"د",1,0],["إِذَا بَدَأَتْ أَشْجَاكَ أَوَّلُ صَوْتِها","وإنْ سَكَتَتْ أَعْيَا بَيَانَك آخِرُه",174,"ر",2,0],["إذا بدت الغزالةُ ثم غارت","علِمنا أن هذا العيشَ ظِلّ",175,"ل",1,0],["إذا بدت بسمةٌ على شَفَتي","تشكو إلى الله غُربَةَ الوطن",176,"ن",1,0],["إذا بلغَ الرأيُ النصيحة فاستعنْ","بعزم نصيح، أو بتأييد حازم ِ",177,"م",1,1],["إذا \" بالعدل\" يكبِسهُ ، لماذا ؟","لانَّ العدلَ يكبس من يشاء ..!",178,"ا",2,0],["إذا به واهنُ المَجرى يعارِضُه","عودٌ ويمنعه عن سيره حَجَر",179,"ر",1,0],["إذا باتَ يُعطي والسّماحِ حَليفَهُ،","تَوَهّمَ يَعطُو بالسَّماحِ أخيهِ",180,"ي",2,0],["إِذا بَقْيتَ لِدِينِ اللهِ تَكُلأُهُ","فَكُلُّ رُزْءٍ صَغِيرُ القَدْرِ مُحْتَمَلُ",181,"ل",1,0],["إذا بُتِكَتْ يُمْنى يد فهي التي","مَكانُ الشّمالِ حاجَزَتْ أوْ تَحَدّتِ",182,"ت",1,0],["إذا بلغ الفطام لنا صبيٌ","تخرُ لهُ الجبابرُ ساجدينا",183,"ن",2,0],["إذا بَعُدَتْ دارُ الأحبَّة بالنوى","فذاك لهم هجرٌ وإنْ يكن هجر",184,"ر",1,0],["إذا بنى رجل قصرا وزخرفه","سقنا إليه التهاني وامتدحناه",185,"ا",2,0],["إذا بَكَيَا حُوَرَاهُما اسَتحَثّتْ","جَناجِنَ جِلّةِ الأجْوَافِ خُورِ",186,"ر",1,0],["إذا بدت كالفيشة ِ المقصَّعه","مصقولة ً مدهونة ً مصنَّعه",187,"ع",2,0],["إذا بحملي تلاشى","واستيقظت عينايا",188,"ا",3,0],["إذا بعُدت آمالُهم فتردَّدوا","دعاهم إلى الإقدامِ فاستقربوا البعدا",189,"د",2,0],