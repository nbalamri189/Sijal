tps://poetry.dctabudhabi.ae/diwan/poem/54278","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[50,"إذا بلغَ الرأيُ النصيحة فاستعنْ","https://www.poetsgate.com/ViewPoem.aspx?id=1469",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[45,"متى تَسألي عَن عَهْدِهِ تَجِدِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31643",""],[45,"غُروبُ دَمْعِ مِنَ الأَجْفَانِ تَنْهَمِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=31856",""],[45,"رَأتْ وَخْطَ شيْبٍ من عذاري، فصَدّت","https://www.poetsgate.com/ViewPoem.aspx?id=33105",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[80,"خيالكِ للأجفان مثَّلهُ الفكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3278",""],[91,"في قلبك الله","https://www.poetsgate.com/ViewPoem.aspx?id=53348",""],[28,"تمنى المستزيدة لي المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=21591",""],[51,"رأس أبي حفصٍ عظيم المَنْفعهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29551",""],[97,"الناي المحترق","https://www.poetsgate.com/ViewPoem.aspx?id=17261",""],[101,"بكَيْنا النُّضارَ الْحُرّ والحسَبَ العِدَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62455&r=&rc=47",""],[105,"لهان على نعاتك أن نصابا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55035&r=&rc=205",""],[31,"ألما بذاتِ الخالِ، فاستطلعا لنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19051&r=&rc=314",""]],"verses":[["إِذا بَعُدَ الكَلامُ دَنَت","عَلَيَّ مَسافَةُ الكَلِمِ",0,"م",1,0],["إِذا بَلَّ مِن داءٍ أَعادَت لَهُ المَها","نُكاساً إِذا ما عادَ عادَ مُقيما",1,"م",2,0],["إِذا بَسَطوا الخُطا سَحَبوا رِقاقَ ال","بُرودِ عَلى الرِقاقِ مِنَ النِعالِ",2,"ل",1,0],["إِذا بَعُدَ الأَعداءُ عَن سَطَواتِهِ","فَلا يَأمَنوا مِن بالِغٍ وَوَصولِ",3,"ل",1,0],["إِذا بَخِلَ الغَمامُ عَلى مَحَلٍّ","تَدارَكَ غُلَّةَ الإِبِلِ الزِماعِ",4,"ع",1,0],["إِذا بابُ الحُسَينِ أَضافَ رَحلي","أَذُمُّ عَلى المَطِيِّ مِنَ المَسيرِ",5,"ر",1,0],["إِذا بَزَّني مالي عَطاءً تَرَكتُهُ","حَميداً وَطالَبتُ القَواضِبَ بِالرَدِّ",6,"د",1,0],["إِذا بُشِّرتُ عَنكَ بِقُربِ دارٍ","نَزا قَلبي إِلَيكَ مِنَ الوَجيبِ",7,"ب",1,0],["إِذا بادَروا مَجداً بَرَزَت وَبَلَّدوا","وَإِن طالَعوا عِزّاً شَهِدتَ وَغابوا",8,"ب",3,0],["إِذا بَلَغَت ناديكَ نالَ رِفاقُها","عَريضَ عَطاءٍ مِن طَويلِ ثَناءِ",9,"ا",2,0],["إِذا بَدَتْ سارَقَتْها العَينُ نَظرَتَها","تَلَمُّحَ الصَّقرِ رُعباً فَوقَ مُرتَبإِ",10,"ا",1,0],["إذا بَدا اخْتَلَسَ الأبْصارُ نَظرَتَها","إليهِ منْ هَيْبةٍ في طَيّها كَرَمُ",11,"م",1,0],["إذا بلَغْنا عَضُدَ الدِّينِ لمْ","نَثْلِمْ شَبا المَحْلِ بضَرْبِ القِداحْ",12,"ح",1,0],["إذا بَسَطَ المَدْحُ الوُجوهَ وأشرَقَتْ","زَوى بينَ عَيْنَيهِ على الشّاعِرِ الوَغْدُ",13,"د",1,0],["إذا بَلَغْنا أبا مَرفوعَةَ ارْتَبَعَتْ","بحيثُ لا يألَفُ المَهْرِيُّ أقْتادا",14,"د",2,0],["إِذا بَلَغَ الفِطامَ لَنا صَبِيٌّ","تَخِرُّ لَهُ أَعادينا سُجودا",15,"د",2,0],["إِذَا بَارِقٌ لِلثَّغْرِ يَوْمَاً أَهَابَ بِي","رَكِبْتُ إِلَيْهِ الْخَطْبَ وَهْوَ جَلِيلُ",16,"ل",1,0],["إِذا بُزِلَت مِن دَنِّها فاحَ ريحُها","وَقَد أُخرِجَت مِن أَسوَدِ الجَوفِ أَدهَما",17,"م",2,0],["أَذأُبٌ هامَت بِلَحمي","فَاِنتِهاشٌ وَاِنتِهاسُ",18,"س",1,0],["إَذا بَلَغَ الفِطامَ لَنا وَليدٌ","تَخِرُّ لَهُ الجَبابِرُ ساجِدينا",19,"ن",2,0],["إِذا بِنتِ بانَ العُرفُ إِلّا أَقَلَّهُ","مِنَ الناسِ وَاِستَعلى الحَياةَ ذَميمُها",20,"م",3,0],["إِذا بَرَقَت نَحوَ البُوَيبِ سَحابَةٌ","لِعَينَيكَ مِنها لا تَجِفُّ سُجومُ",21,"م",1,0],["إِذا بَلَّت الخِرصان صاحَت كُعوبُها","فَلَم تَبقَ إِلّا المارِناتُ الذَوابِلُ",22,"ل",1,0],["إِذا بَصُرَت بِها العَينانِ لَجَّت","بِدَمعِهِما مَعَ النَظَرِ اللَجوجُ",23,"ج",1,0],["إِذا بَرَكَت طَرَحتُ لَها زِماماً","وَلَم أَعقل بِرُكبَتها عِقالا",24,"ل",2,0],["إذا بعثت لي أنّةّ عن تَوَجُّع","بعثت إليها أنّةً عن ترحُّم",25,"م",1,0],["إِذا بَلَّغَت رَحلي رَجيعٌ أَمَلَّها","نُزولِيَ بِالمَوماةِ ثُمَّ اِرتِحالِيا",26,"ي",2,0],["إِذا بَلَغوا المَنازِلَ لَم تُقَيَّد","وَفي طولِ الكَلالِ لَها قُيودُ",27,"د",1,0],["إِذا بَلَّغَ اللَهُ الخَليفَةَ لَم تُبَل","سِقاطَ الرَزايا مِن حَسيرٍ وَظالِعِ",28,"ع",1,0],["إِذا بَعضُ السِنينَ تَعَرَّقَتنا","كَفى الأَيتامَ فَقدَ أَبي اليَتيمِ",29,"م",1,0],["إِذا بَدَتِ الأَهِلَّةُ يا اِبنَ تَيمٍ","غُمِمتَ فَما بَدَوتَ مِنَ الغُمومِ",30,"م",1,0],["إِذا بَكَرَ النِساءُ مُرَدَّفاتٍ","حَواسِرَ لا يُجِئنَ عَلى الخِدامِ",31,"م",1,0],["إذا بَدَت بَعدَ كَاعِبٍ رَؤُدٍ","شَمطَاءَ منها اللِّحَاءُ والصَخَبُ",32,"ب",1,0],["إِذا بَقِيَ الأَميرُ قَريرَ عَينٍ","فَدَيناهُ اِختِياراً لا اِضطِرارا",33,"ر",2,0],["إذا بسطت كفَّاه باليمنِ للورى","رجوا بسطها للأمنِ بالدعوات",34,"ت",1,0],["إذا بلغت في الملك دار نعيمه","أبى عزمه إلا النعيم مخلَّدا",35,"د",2,0],["إذا بشر الإنسان في الحين مرة","على وجه وضَّاح الهلال منير",36,"ر",1,0],["إذا بدا أبصرْتَ حسَّاده","من مهطع الرأس ومن مقنع",37,"ع",1,0],["إذا برى قلماً قالت ممالكها","يا بارئ النسم احرس باريَ القلم",38,"م",1,0],["إِذا بَلَغَ الصَبُّ الكَمالَ مِنَ الهَوى","وَغابَ عَنِ المَذكورِ في سَطوَةِ الذِكرِ",39,"ر",1,1],["إذا بَرَّكتَ في صومٍ لقومٍ","دعوتَ لهم بتطويل العذابِ",40,"ب",1,1],["إذا بغَتتْ أشياءُ قد كان مثلها","قديماً فلا تعتدَّها بغَتَاتِ",41,"ت",1,0],["إذا بَدْءُ ما أعْطَى أنَامَ عُفَاتَهُ","سرى عَوْدُهُ مُسْتَيْقِظاً لِرُقُودها",42,"د",3,0],["إذا باع تَجرُ الحمد إياه حَمدَهُم","فقد ربحتْ ربحَ الغنى صفقةُ التجرِ",43,"ر",1,0],["إذا بعتُ صَوْني حُرَّ وجهي وراحتي","بجوعٍ فَمَن مِنِّي أتَبُّ وأخسر",44,"ر",1,0],["إذا بدا وجهُهُ لزهرتها","حار لها تارةً وحيّرها",45,"ر",3,0],["إذا بدَتْ لِلعيون طلعَتُها","أبدتْ لها سرّها ومُضْمَرها",45,"ر",3,0],["إذا بدا في اختلافٍ من محاسنه","أراك كيف اختلاط النار بالنور",46,"ر",1,0],["إذا بذل المعروفَ أغْضى جُفُونَهُ","وطاطأ رأساً لم يذلِّله عاكس",47,"س",1,0],["إذا بتَّ والفكر تستخرجا","ن مفتاح أمر عسير الغلق",48,"ق",1,1],["إذا بدا الفيلُ وخرطومُه","قلنا أعارت بظرها الفيلا",49,"ل",2,0],["إذا بدا وجهُ ذَنْب فهو ذو سنةٍ","وإن بدا وجْه خَطْب فهْو يقظان",50,"ن",1,0],["إذا بدا وجهُه لقوم","لاذت بأجفانها العيونُ",51,"ن",1,0],["إِذا بُنِيَ القِبابُ عَلى عُكاظٍ","وَقامَ البَيعُ وَاِجتَمَع الأُلوفُ",52,"ف",1,0],["إِذا بَدَت عَورَةٌ مِنها أَضَرَّ بِها","بادي الكَراديسِ خاظي اللَحمِ زُغلولُ",53,"ل",1,0],["إِذا بَلَغَت بِشرَ اِبنَ مَروانَ ناقَتي","سَرَت خَوفَها نَفسي وَنامَت هُمومُها",54,"م",3,0],["إِذا بُحِثَت أَنسابُهُنَّ لِسائِلٍ","دَعَونَ عِكَبّاً أَو بُجَيرَ اِبنَ سالِمِ",55,"م",1,0],["إِذا بَكاهُ الغَمامُ شَقَّت","مِنَ الأَسى زَهرُهُ الجُيوبا",56,"ب",2,0],["إِذا بَصُرتَ بِهِ عَينُ الأَديبِ","فَقَد وَقَعَت عَلى رَجُلٍ مُريبِ",57,"ب",1,0],["إِذا بَصُرتَ بِهِ لا فاتَهُ كَدَرٌ","رَأَيتَ أَسمَجَ خَلقِ اللَهِ كُلِّهِمِ",58,"م",1,0],["إِذا بَعُدوا لا يَأمَنونَ اِقتِرابَهُ","تَشَوُّفَ أَهلَ الغائِبِ المُتَنَظَّرِ",59,"ر",1,0],["إِذا بَخَسَ الجُهّالُ قَدرَ فَضيلَةٍ","فَلَيسوا بِها بِالجاهِلينَ فَيُبخَسا",60,"س",2,0],["إِذا بِتُّمُ بَينَ الأُدَيّاتِ لَيلَةً","وَأَخنَستُمُ مِن عالِجٍ كُلَّ أَجرَعا",61,"ع",2,0],["إذا بلغن التراقى","فكل ربح خساره",62,"ر",2,0],["إذا برزت ود النهار قميصها","يُغير به شمس الضحى فتغار",63,"ر",1,0],["إِذا بُعِثَتْ سَمِعتَ لها زُهَاءً","وجَهْوَرَةً كَجَهورَةِ القُسوسِ",64,"س",1,0],["إِذا بَدا حَجَبَت عَينَيكَ هَيبَتُهُ","وَلَيسَ يَحجُبُهُ سِترٌ إِذا اِحتَجَبا",65,"ب",2,0],["إِذا بَقيتَ سالِماً أَبا عَلي","فَالمُلكُ لِلَّهِ العَزيزِ ثُمَّ لي",66,"ل",2,0],["إِذا بَرَقوا لَم تُعرَفِ البيضُ مِنهُمُ","ثِيابُهُمُ مِن مِثلِها وَالعَمائِمُ",67,"م",1,0],["إِذا بَيَّتَ الأَعداءَ كانَ اِستِماعُهُم","صَريرُ العَوالي قَبلَ قَعقَعَةِ اللُجمِ",68,"م",1,0],["إِذا بَكَرَ الفَرّاشُ يَنثو حَديثَهُ","تَضاءَلَ مُطريهِ وَأَطنَبَ عائِبُه",69,"ب",2,0],["إِذا بَدا لِلعُيونِ حَوَّلَها","ساطِعَ بِشرِ يَروقُها لَهَبُه",70,"ب",2,0],["إِذا بُتِكَت يُمنى يَدي فَهِيَ الَّتي","مَكانَ الشَمالِ حاجَزَت أَو تَحَدَّتِ",71,"ت",1,0],["إِذا باكَرَتهُ غادِياتُ هُمومِهِ","أَراحَ عَلَيها الراحَ حَمراءَ كَالوَردِ",72,"د",1,0],["إِذا بَعُدَت دِيارُكَ عَن دِياري","دَجَت شَمسي وَغابَ ضِياءُ بَدري",73,"ي",1,0],["إِذا بَدَونَ لِلَحظِ الناظِرينَ فَقُل","في لُؤلُؤٍ بِجُنوبِ الرَملِ مَنثورُ",74,"ر",1,0],["إِذا بَدَرَت مِنهُ العَزيمَةُ لَم يَقِف","وَإِن جازَ عَنهُ الأَمرُ لَم يَتَتَبَّعِ",75,"ع",1,0],["إِذا بَعَثناهُنَّ ذُدنَ الكَرى","عَنّا إِلى حَيثُ اِطَّباهُ الضُجوع",76,"ع",1,0],["إِذا بَعُدَت أَبلَت وَإِن قَرُبَت شَفَت","فَهِجرانُها يُبلي وَلُقيانُها يَشفي",77,"ي",1,0],["إِذا بَرَزَت وَالشَمسُ قُلتَ تَجارَتا","إِلى أَمَدٍ أَو كادَتِ الشَمسُ تَسبِقُ",78,"ق",1,0],["إِذا بَعَثَتهُ الأَريَحِيَّةُ أُضعِفَت","أَياديهِ أَو جاءَت تُؤاماً فَواضِلُه",79,"ل",2,0],["إِذا بَدَوا في حَرَجاتِ القَنا","حَسِبتَ أُسدَ الغابِ في غيلِها",80,"ل",3,0],["إِذا بَقيتَ لِدينِ اللَهِ تَكلَؤُهُ","فَكُلُّ رُزءٍ صَغيرُ القَدرِ مُحتَمَلُ",81,"ل",1,0],["إِذا بَرَقَ الرَبيعُ لَهُ كَسَتهُ","غَوادي المُزنِ وَالريحُ الرُخامى",82,"م",2,0],["إِذا بَدَأَت لَنا أُسلوبَ شَوقٍ","رَأَينا في التَصابي ما تُرينا",83,"ن",2,0],["إِذا باتَ يُعطي وَالسَماحُ حَليفُهُ","تُوُهِّمَ يُعطي بِالسَماحِ أَخيهِ",84,"ي",2,0],["إِذا بَكَيا حُوارَهُما اِستَحَثَّت","جَناجِنَ جِلَّةِ الأَجوافِ خورِ",85,"ر",1,0],["إِذا باهِلِيٌّ تَحتَهُ حَنظَلِيَّةٌ","لَهُ وَلَدٌ مِنها فَذاكَ المُذَرَّعُ",86,"ع",1,1],["إِذا بَلَغَت بي خالِداً وَهيَ لَم تَقُم","فَبَلَّ يَدَيها مِن دَمِ الجَوفِ سائِلُه",87,"ل",2,0],["إِذا بَلَّغتِني رَحلي وَنَفسي","إِلى الكَلبِيِّ ناقَ فَلا تَقومي",88,"م",2,0],["إذا بَدا الصبحُ فهو الشَّمسُ طالِعةً","وإن دَجَى اللَّيلُ فهو النارُ والعَلَمُ",89,"م",1,0],["إذا بَدا نَحوَكَ شبَّهْتَهُ","بقَهْوَةٍ في قَدَحٍ أزرَقِ",90,"ق",1,0],["إذا برزَتْ كان العَفافُ حِجابَها","وإن سفرَتْ كانَ الحياءُ نِقابَها",91,"ب",3,0],["إذا بَكَرَ القَنَّاصُ فيه وأعزَبَتْ","حبائلُه في صَيدِ تلك العوازِبِ",92,"ب",1,0],["إذا بلَوْنا عَدِيّاً يومَ عاديةٍ","كانت ضرائبُها أحلى من الضَّربِ",93,"ب",1,0],["إذا بدا الصبحُ من إشراقِ طلعتِه","أبَدتْ لكَ الليلَ مُسودّاً ذوائبُه",94,"ب",2,0],["إِذا بَقِيَ المَأمومُ لي فَالرَشيدُ لي","وَلي جَعفَرٌ لَم يُفقَدا وَمُحَمَّدُ",95,"د",1,0],["أَذابَ الهَوى جِسمي وَلَحمي وَقُوَّتي","فَلَم يَبقَ إِلّا الروحُ وَالجَسَدُ النَضوُ",96,"و",1,0],["إِذا بَدا مَعناهُ قالَ الوَرى","كَم تَرَكَ الأَوَّلُ لِلآخِرِ",97,"ر",1,0],["إِذا بُلي اللَبيبُ بِقُربِ فَدمٍ","تَجَرَّعَ مِنهُ كاساتِ الحُتوفِ",98,"ف",1,1],["إِذا بَسَمَت لِلهَمِّ راحَ مُقَطِّباً","وَإِن سَفَرَت لِلحُزنِ سارَ مُحَثحِثا",99,"ث",2,0],["أَذابَ التِبرَ في كَأسِ اللُجَينِ","رَشاً بِالراحِ مَخضوبَ اليَدينِ",100,"ن",1,1],["إِذا بَدا نُورُكَ لا يَصُدُّهُ","تَزاحُمُ المَوكِبِ في اِرتِكابِهِ",101,"ب",2,0],["إِذا بَخِلَت كَفّي بِنِعمَةِ مُنعِمٍ","فَقَد ساءَ في تِكرارِ أَنعُمِهِ ظَنّي",102,"ي",1,0],["إذا بحلمي تلاشى","واستيقظت عينايا",103,"ا",3,0],["إذا بَرَقَتْ فيه الأسنّةُ خِلْتَها","كواكبَ تجلو في السُّكاكِ غمائما",104,"م",2,0],["أَذابِلُ النرجِسِ في مُقلَتَيكْ","أَم ناضِرُ الوَردِ عَلى وَجنَتَيكْ",105,"ك",1,1],["إذا بَعُدَتْ دار الأحبَّةِ بالنوى","فذاك لهمْ هجرٌ وإنْ لم يَكُن هَجرُ",106,"ر",1,0],["إذا باتَ قلبي بالصبابةِ عندها","ففي أيّ قلبٍ باتَ وجدي بما عندي",107,"د",2,0],["إِذا بَرقَ الإِصباح هزّ انتفاضَها","من الظلّ أشباهُ العواملِ والقضبِ",108,"ب",1,0],["أَذابَ سَنامَها قَطعُ الفَيافي","وَمَزَّقَ جِلدَها نَضجُ العَصيمِ",109,"م",1,0],["إِذا بَدا لَكَ مُرٌّ في كَتائِبِهِم","لَم يُحجَبِ المَوتُ عَن روحٍ وَلا بَدَنِ",110,"ن",1,0],["إِذا بَلغنَ أَبا كُلثومٍ اِتَّصَلَت","تِلكَ المُنى وَأَخَذنَ الحاجَ مِن أَمَمِ",111,"م",1,0],["أَذابَت لِيَ الدُنيا يَمينُكَ بَعدَما","وَقَفتُ عَلى شُخبٍ مِنَ العَيشِ جامِدِ",112,"د",1,0],["إذا بعتُهُ رَدُّوهُ بالعيبِ سرعةً","عليَّ وللمبتاعِ في ردِّهِ العذرُ",113,"ر",1,0],["إذا برزَتْ في قباءِ الحرير","تقولُ هيَ الشمسُ في الأطلسِ",114,"س",1,1],["إِذا بِنتِ بانَت نِعمَةُ العَيشِ وَالهَوى","وَإِن قَرُبَت دارٌ بِكُم فَكَأَنَّما",115,"م",2,0],["إِذا بَدَتِ الكَواكِبُ فيهِ غَرقى","رَأَيتَ الأَرضَ تَحسُدُها السَماءُ",116,"ا",2,0],["إِذا بَسَطَت كَفُّ الهَياجِ إِلى العِدى","أَنامِلَ سُمرِ الخَطِّ كانوا لَها زَندا",117,"د",2,0],["إِذا بانَ مَن تَهوى وَشَطَّ بِهِ النَوى","فَفُرقَةُ مَن تَهوى أَحَرُّ مِنَ الجَمرِ",118,"ر",1,0],["إذا باتت شُعوبُ الشّرقِ حَيْرَى","أضاءَ لها السَّبيلَ هُدىً ورُشدا",119,"د",2,0],["إذا بات الهُجوعُ أعزَّ شيءٍ","أصابوه بِساحتِه نِهابا",120,"ب",2,0],["إذا بلغوا الدّيارَ تَجهَّمَتهُم","فساروا في البلادِ مُباعدينا",121,"ن",2,0],["إذا بات العَرينُ بغير حامٍ","ورِيعَ حِمَى الخلائفِ فاذكرينا",121,"ن",2,0],["إذا بلغ المطارُ بهنّ أرضاً","بلغن من العِدَى ما يشتهينا",121,"ن",2,0],["إذا بعثوا بالجيشِ ألقى سلاحَهُ","فلا النَّصرُ مَرْجُوٌّ ولا الجيشُ راجعُ",122,"ع",1,0],["إِذا بَشَّرَ الأَقوامَ بِالوَيلِ صائِحٌ","فَماذا يَقولُ المُنذِرُ المُتَهَدِّدُ",123,"د",1,0],["أَذابوا الأُمَّهاتِ أَسىً وَوَجداً","وَطاحوا بِالأُبُوَّةِ وَالبَنينا",124,"ن",2,0],["أذابَ الجوعُ أنفسَهم فَضَجُّوا","وَضَجَّتْ في جُلودِهمْ العِظامُ",125,"م",1,0],["إذا بَعثوا من باطلِ القولِ فتنةً","تَلقّفها من صادقِ الوحيِ خاطِفُ",126,"ف",1,0],["إِذا بَخَلوا أَعطى وَإِن أَحجَموا مَضى","وَإِن أَصلَدوا أَورى وَنارُ عَما",127,"م",2,0],["إِذا بَلَغو الَّتي أَجروا إِليها","تَقبَلَهُم وَحُلِّلَ مَن يَصومُ",128,"م",1,0],["إِذ آبَهَتهُم وَلَم يَدروا بِفاحِشَةٍ","وَأَرغَمَتهُم وَلَم يَدروا بِما هَجَعوا",129,"ع",3,1],["إِذا بَهَظَ الحِملُ صيدَ الرِجال","فَأَضحَت بِأَثقالِها بالِحَه",130,"ح",2,0],["إِذا بَلَّ الزَعفَرانِ لُبانَهُ","مَعَ المِسكِ يَزدادانِ طيباً وَيَعبَقا",131,"ق",2,0],["إِذا بَدَت لِجَبانِ القَومِ سَيءَ بِها","قَلبُ الجَبانِ وَما رى بَعدَ تَبلِيدِ",132,"د",1,0],["إِذا باتَ لِلعُوّارِ بِاللَيلِ نوكُهُ","ضَجيعاً وَأَضحى نائِماً لَم يُوَسَّدِ",133,"د",1,0],["إِذا بَهَشَت يَداهُ إِلى كَمِيٍّ","فَلَيسَ لَهُ وَإِن زُجِرَ اِنتِهاءُ",134,"ا",2,0],["إِذا بَلَغَتكَ أَلقَت ما عَلَيها","وَإِنَّكَ خَيرُ مَن دَنّى الرَحيلُ",135,"ل",1,0],["إِذا بَرَكَت لَم يُؤذِها صَوتُ سامِرٍ","وَلَم تُقصَ عَن أَدنى المَخاضِ قَذورُها",136,"ر",3,0],["إِذا بَدا يَخطِرُ في مَجلِسٍ","فَكَم مُحِبٍّ فيهِ يَهواهُ",137,"ه",1,0],["إذْ أَبَتْهُ لِيُتْمِهِ مُرْضِعاتٌ","قُلْنَ ما في اليتيمِ عنا غَنَاءُ",138,"ا",2,0],["إذ أبى الفيلُ ما أتى صاحبُ الفي","لِ ولم ينفعِ الحِجا والذكاءُ",138,"ا",2,0],["إذا بَنْو مُرّةٍ صَلّوا عليْكَ فلا","صَلّتْ إيادٌ على كعْبِ الإياديّ",139,"ي",1,0],["إِذ أَبصَرَت عَينُ قَلبي","لِحَينِهِ المُتَقارِب",140,"ب",1,0],["إِذا بِكافِرَةٍ شَمطاءَ قَد بَرَزَت","في زَيِّ مُختَشِعٍ لِلَّهِ زِمّيتِ",