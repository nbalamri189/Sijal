{"poems":[[100,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39028","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53195","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77385","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"]],"verses":[["إيه غليوم استزد من حشدها","واستنبح أبناءها واسترسل",0,"ل",1,0],["إيهٍ غُزَيِّلةَ الأراكِ مَنِ الَّذي","أغْراكِ بِي ظُلماً ولَمّا يُنْصِفِ",1,"ف",1,0],["إيهٍ غياث الدين ملكاً إلى","أقصى العراقين وأرض الشآم",2,"م",1,0],["إيهِ غدّارَةُ اِهجُرِيني مَلِيّاً","إِنَّني بِالصُدودِ مِنك خَليقُ",3,"ق",1,0],["إيه غليومُ لا تموّه على الناسِ","المعانِي فأنت بالشرّ بادِ",4,"د",1,0]]}