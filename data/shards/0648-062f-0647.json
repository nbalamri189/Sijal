etry.dctabudhabi.ae/diwan/poem/123483","الكامل"],[4273,"","https://poetry.dctabudhabi.ae/diwan/poem/45446","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66136","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58074","الوافر"],[4697,"يا عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=22687",""],[4718,"مالي ومال مكثرين السواليف","https://www.poetsgate.com/ViewPoem.aspx?id=137247",""],[4791,"هاجس احلامي","https://www.poetsgate.com/ViewPoem.aspx?id=37105",""],[4883,"قرية سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=48355",""],[4903,"هَنَتكَ أميرَ الجُودِ خَيرَ هديِة","https://www.poetsgate.com/ViewPoem.aspx?id=96541",""],[4931,"نبض المسرّات","https://www.poetsgate.com/ViewPoem.aspx?id=32544",""],[5008,"ريح الورودي","https://www.poetsgate.com/ViewPoem.aspx?id=28399",""],[5061,"الامير","https://www.poetsgate.com/ViewPoem.aspx?id=147171",""],[5198,"رسالة مع البدر","https://www.poetsgate.com/ViewPoem.aspx?id=135394",""],[5198,"روشان","https://www.poetsgate.com/ViewPoem.aspx?id=139895",""],[5213,"ودهري لما خالستني صروفه","https://www.poetsgate.com/ViewPoem.aspx?id=170442",""],[5277,"مطالعُ الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=191929",""],[308,"ظَنَنْت العَبْد عَن مصر تسلى","https://www.poetsgate.com/ViewPoem.aspx?id=189405",""],[5302,"هام قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201901",""],[5401,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=78116",""],[5525,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=7255",""],[5582,"قِف بِالرسومِ الخاليات مخاطباً","https://www.poetsgate.com/ViewPoem.aspx?id=63456",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5689,"أظل خيالي أم ضرام جهنم","https://www.poetsgate.com/ViewPoem.aspx?id=143403",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5794,"صمت المدينة ..","https://www.poetsgate.com/ViewPoem.aspx?id=122799",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5848,"ارتباكات القلق","https://www.poetsgate.com/ViewPoem.aspx?id=48862",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""]],"verses":[["وَدَهراً يُمَوِّلُ زَلّاتِهِ","وَلا يَدخَرُ العُدمَ إِلّا لِيَه",0,"ي",2,0],["وَدَهرٌ يُتابِعُ أَحداثَهُ","كَما تابَعَ الطَلَقَ النابِلُ",1,"ل",1,0],["وَدَهرٌ يَرُدُّ عَلينا العَلا","ءَ أَجدِر بِهِ أَن يَرُدَّ الغُفارا",2,"ر",2,0],["وَدَهماءَ مِن لَيلِ التَمامِ قَطَعتُها","أُغَنّي حِداءً وَالمَراسيلُ تَطرَبُ",3,"ب",1,0],["وَدَهرٌ لا يَصُحُّ بِهِ سَقيمُ","وَكَيفَ يَصُحُّ وَالأَيّامُ داءُ",4,"ا",2,0],["ودَهْرُكَ دَعْ بَنيهِ إليكَ يَهْفو","بِطاعَةِ مُسْتَبينِ الرِّقِّ عَبْدِ",5,"د",1,0],["وَدَهْرُكَ مُقْبِلٌ وَالعَيْشُ رَغْدٌ","كَمَا تَهْوَى وَسَرْبُكَ فِي أَمَانِ",6,"ن",1,0],["ودهاء لو ما كرته دواهي الدّ","هر طُرّاً لاغتالها منه غول",7,"ل",1,0],["وَدَهمٍ كَجُنحِ اللَيلِ زُرنا بِهِ العِدى","لَهُ عِثيَرٌ مِمّا تُثيرُ قَنابِلُه",8,"ل",2,0],["وَدَهى الدينَ وَالخِلافَةَ أَمرٌ","فادِحٌ رائِعٌ جَليلٌ جُسامُ",9,"م",1,0],["وَدُهانٍ كَلامِعِ الزَيتِ مَرَّت","أَعصُرٌ بِالسِراجِ وَالزَيتِ وُضّا",10,"ض",2,0],["وَدَها الجَزيرَةَ بَعدَ إِس","ماعيلَ وَالمَلِكِ الكَبير",11,"ر",1,0],["وَدَهرٌ ناسُهُ ناسٌ صِغارٌ","وَإِن كانَت لَهُم جُثَثٌ ضِخامُ",12,"م",1,0],["ودهن صفرة بيض فاغمرنَّ به","ما قد علمت وقَطّره علىعَكَرِ",13,"ر",1,0],["ودهرٌ قضتْ أحكامُه مُذْ تشابهتْ","أعاجيبُه أنْ ليس فيها أعاجيبُ",14,"ب",1,0],["وَدَهماءَ مِغضابٍ عَلى اللَحمِ نَبَّهَت","عُيوناً عَنِ الأَضيافِ لَيسَت بِرُقَّدِ",15,"د",1,0],["ودَهماءُ تهدِرُ هَدْرَ الفَنيقِ","إذا ما امتطَتْ لهباً مُسعِرا",16,"ر",2,0],["ودُهْمٌ إذا ما الليلُ رَفَّعَ سِجْفَه","تكشَّفَ منها عن وجوهٍ شَواحبِ",17,"ب",1,0],["وَدُهمٍ بِأَيدي الغانِياتِ تَقَعقَعَت","مَفاصِلُها مِن هَولِ ما تَتَنَظَّرُ",18,"ر",1,0],["وَدُهم بني دهمانَ فاض على الوغى","بِكُلِّ فتىً أحلى بسالتِهِ مُرُّ",19,"ر",1,0],["وَدُهْمٌ بفرسانِ الكفاحِ سوابِحٌ","تَجافيفُها في الروعِ مُنسَدِلُ اللبدِ",20,"د",1,0],["ودهرُنا أيُّ دهرٍ في تقلُّبِهِ","قَدْ هانَ فيهِ التقى والعلمُ والأدبُ",21,"ب",1,0],["وَدُهيتُ مِن خَطِّ العِذارِ بِخَدِّهِ","في صَدِّهِ وَالمَوتُ في لَحَظاتِه",22,"ت",2,0],["وَدَهرٍ مُؤاتٍ قَد مَلَكتُ نَعيمَهُ","وَأُعطيتُ مِن حَلواءِ عَيشٍ وَأَعطَيتُ",23,"ت",1,0],["وَدَهَى الأَسودَ بنَ عبدِ يغوثٍ","أن سَقَاهُ كأسَ الرَّدَى اسْتِسْقَاءُ",24,"ا",2,0],["وَدَهَتْ أَوْجُهاً بها وبيوتاً","مُلّ منها الإكفاءُ والإقواءُ",24,"ا",2,0],["ودُهْماً إذا استقبلْنَ حُوّاً كأنّما","عُلِلنَ إلى الأرساغ مسكاً وعنبرا",25,"ر",2,0],["وَدَهماءَ تُرسيها رَقاشٌ إِذا شَتَت","مُرَكَّبَةُ الآذانِ أُمُّ عِيالِ",26,"ل",1,1],["وَدَهقانَةٍ ميزانُها نُصبَ عَينِها","وَميزانُها لِلمُشتَرينَ غَشومُ",27,"م",1,0],["وَدَهرُ المَرءِ مُنقَلِبٌ عَلَيهِ","فُنوناً وَالنَعيمُ إِلى اِنقِلابِ",28,"ب",1,0],["وَدَهري بِالمُغارِ أَغارَ صَبري","وَعَلَّمَني التَعَفُّفَ بِالتَعَفّي",29,"ف",2,0],["وَدَهْرٌ سَادَتِ الْعُبدانُ فِيهِ","وَعاثَتْ في جَوَانِبِهِ الذِّئابُ",30,"ب",1,0],["ودهقانة ميزانه نصب عينه","وميزانه للمشترين غشوم",31,"م",1,0],["ودَهْورهَ الوفاءُ ونعمَ عقبى","الصداقةِ أنْ يدهوركَ الوفاء!",32,"ا",2,0],["وَدَهرَنا جَميعُهُ","إِن لَم نُغالطهُ غَصص",33,"ص",1,0],["ودهشة لقلوب العاشقين بدت","برونق فيه سلطان الجمال جلي",34,"ل",2,0],["وِدُّهُ وِدٌّ صحيحٌ","وهْوَ عَنِّي ذو انْقِباضِ",35,"ض",1,0],["ودهرك معمور نهاراً تصومه","وليلا بتطويل القيام وبالذكرى",36,"ر",2,0],["ودهر لأهل النقص سلم وصرفه","باشرافه في حرب ذى الفضل مولع",37,"ع",1,0],["ودهمتهم بكتائب لو أنها","دهمت صروف الدهر هدت ما بنى",38,"ن",2,0],["ودهشتُ حتى لستُ أدْري أنّهُ","ماضٍ قضى أو أنّه قاضٍ مَضى",39,"ض",2,0],["ودهشتُ حينَ رأيتُ في غلَسِ الدُّجى","شمساً تصكّ البدرَ بالعُنّابِ",40,"ب",1,0],["وَدُهماً وَحُوَّاً لِلغُرابِ تَخالُها","إِذا اِغتَسَلَت بِالماءِ طَيراً عَلاجِما",41,"م",2,0],["ودهى سقراط منه نا اشتكى","بعده من حيرة العقل صاعورا",42,"ر",2,0],["ودهر لنا كانت تريش نصاله","وقد تاب مما قد جنى وتنصلا",43,"ل",2,0],["ودهر قد نعمت به فولي","ولم ار ذاك الا من شقائي",44,"ا",2,0],["وَدَّهِلالُ الأُفق لَو أَنَّهُ","أَصبحَ في ساعِدِ سُعدى سِوار",45,"ر",1,0],["ودهرٍ ذميم ظلت فيه كأنني","أراقب عيشي من شفاه الأراقم",46,"م",1,0],["ودهر إذا استعفيته عن مظالمي","كأني سألت الضب ان يسلك البحرا",47,"ر",2,0],["ودهر طلبنا القرب فيه من النوى","ففرق من آمالنا ما تجمعا",48,"ع",2,0],["ودَهى الوَرَى مِنْ ثُكْلِ هَادِيهِم بِما","أعْيَا عَلَى الأفْهامِ والأَوْهامِ",49,"م",1,0],["وَدَهري عَلى أَنَّهُ مُبصِرٌ","تَعامى عَلَيَّ كَذا من ظَلَم",50,"م",1,0],["وَدُهمٍ تُصاديها الوَلائِدُ جَلَّةٍ","إِذا جَهِلَت أَجوافُها لَم تَحَلَّمِ",51,"م",1,0],["ودهْرٍ ضاعَ فيه مَضاءُ حَدّي","ضياعَ السَّيفِ في كفِّ الجَبان",52,"ن",1,0],["ودَهرٌ عَلا سِنُّه","فبانَ علَيه الخَرَف",53,"ف",1,0],["ودَهاها من طَرفها ما دَهاني","فهي مسحورةُ الفؤادِ بسِحري",54,"ر",2,0],["ودهاها الصِبا ورونقُ حسنٍ","مستعارٌ وزينبٌ ورباب",55,"ب",1,0],["وَدَهرٌ لا يَجود عَلى مُحب","عَفيف بِاللُقا دَهر بَخيل",56,"ل",1,0],["وَدَهرٌ يُخادع مُستَلئِماً","لَهُ قَتل الشَك إِيقانَهُ",57,"ن",2,0],["ودهر مشوم لا تعد ذنوبه","وهيهات أن أحصي الحصى بكلامي",58,"م",2,0],["ودهرٌ قد جنى ذنباً عظيماً","فلما قيل هل تلقي اعتذارك",59,"ك",1,0],["ودهرٍ أعاني كل يوم خطوبه","وذلك دأبي يا أميم ودأبه",60,"ب",2,0],["ودُهاةٍ تَوَرَّطُوا مُقْفَلاَتٍ","فَتَحَتْهَا آرَاؤُه بهُداةِ",61,"ه",1,0],["وَدُهْمِ أَسَاطيلٍ تُحَاكِي مُتُونُها","أَراقِمَ مِمَّا قد نَفَثْنَ مِنَ السُّمِّ",62,"م",1,0],["ودّه أنّى خلونا","أبدا سهل مواتي",63,"ي",1,0],["ودَهرٍ مُطيعٍ وسورٍ منيعٍ","وقصرٍ رفيعٍ مشيدِ البناءِ",64,"ا",2,0],["ودُهْمٍ كأمثالِ الدَّآدي حَوالكٍ","جوالبَ من هَمِّ الرجال المُؤرقِ",65,"ق",1,0],["ودُّهُ والعهْدُ اِذْ يبْذلُهُ","خَلَصا منْ شوبِ عُذْرٍ ومللْ",66,"ل",1,0],["وَدُهْمٍ كسَوْنَ اللّيلَ سودَ ثيابهِ","عليهنّ فيحاءُ الفروج فَؤرُ",67,"ر",1,1],["وَدَهراً لا يُصيخُ إِلى نَصيحٍ","وَعَيشاً لا يَلَذُّ ولا يطيبُ",68,"ب",1,0],["ودهاني بما أُعزَّى فيه","عن ثباتِي له وحُسْنِ عَزائي",69,"ي",1,0],["ودهَتْنِي أَقاربٌ لي من الأَنْ","ساب لاَ بَلْ عَقارِبٌ في اللَّب",70,"ب",1,0],["وَدهى بِيَومِ الطَّفِ آلَ مُحَمَّدٍ","رُزءاً وَهَدَّ بِخالِِدٍ مَخزُوما",71,"م",2,0],["ودَهرُك كُلُّهُ يَومٌ ولَيلٌ","تَكَرَّر لَيسَ مِنهُ غدٌ وأمسُ",72,"س",1,0],["وَدَهرٌ مَضى لَو كانَ بِالوَصلِ عائِداً","لَزار الرِضى مِن بَعد سقم وَإِغضابِ",73,"ب",1,0],["وَدُهم وَشقر تَنشُدُ البهمَ بَينَها","إِذا ناصَبَت قَوما تَوَلّوا وَأَوصَلوا",74,"ل",3,0],["ودهاك فادح خطبه برزية","عمت وخصت بالشجى أنجابها",75,"ب",3,0],["وَدَهْرُ الْوَصْلِ يحكْيِ لِي رَبِيعاً","يُشَابِهُ نَبْتُهُ خَلَى الْهَلُوكِ",76,"ك",1,0],["ودهريَ سمحٌ بالمعظَّم فيصل","وأولادِه الصِّيدِ الأسودِ الضراغمِ",77,"م",1,0],["ودهرنا لبنيه","مُضَحِّك ومُبَكِّي",78,"ك",2,0],["ودهر تكلم عن صامتٍ","فكان السؤال وكان الجوابْ",79,"ب",1,0],["وَدهاهمُ بكتائبٍ وقت الضُحى","أَضحى بِها في النقعِ أسود حالكا",80,"ك",2,0],["ودهانا منها على غير وتر","حادث مفعم وخطب فظيع",81,"ع",1,0],["ودَهْرُنا غيرُ مَنْزُورٍ الهِباتِ لَنا","كأنَّ مِنْ كفِّ مجدِ الدِّينِ ما وَهَبا",82,"ب",2,0],["ودهياءَ في يومٍ عصيبٍ أَدَرْتَها","على رأْسِ مَلْكٍ فيه بالتَّاجِ معصوبِ",83,"ب",1,0],["ودهر الدهر والأوقات واختلفت","بما يشاء فلم ينقص ولم يزد",84,"د",1,0],["ودهرٌ لا يزال يحُطُّ رحلي","بمَضْيَعةٍ ويُرويني بِلُوحِ",85,"ح",1,0],["ودهم في الدنو منهم قليلٌ","فإذا ما بعدت كان كثيرا",86,"ر",2,0],["ودهاهم من الأسى ما دهاهم","لكريم نواه خطب مبينُ",87,"ن",1,0],["ودها (الإمارات) الشجيّة لوعةٌ","شجوٌ يعم الأهل والأبناءَ",88,"ا",2,0],["ودهانا خطبهُ عندَ الصباح","فأرانا الويلَ فيما قد فعل",89,"ل",1,0],["ودهراً تقضّى لنا بالمناز","ل بين الرياض وبين النَّقا",90,"ا",1,0],["ودها العدا بجحافل","منها تضيق الباديه",91,"ي",2,0],["ودهرك سلم والخطوب غوافل","وسترك مرخي والحبيب ضجيع",92,"ع",1,0],["ودهاه الهوى فلبى سريعا","وكذا شيمة المحب المعنى",93,"ن",2,0],["ودهم كأن الليل ألقى رداءه","عليها فمرفوع النواحي ومنجرّ",94,"ر",1,0],["ودهّنك ابن الزنا","يعمل عليك ذهنك",95,"ك",1,0],["وَدَهري فَيَكفيني القَليلُ وَإِنَّني","أَؤوبُ إِذا ما أَبت لا أَتَعلَّلُ",96,"ل",1,0],["ودهراً كنت فيه أودّ قتلي","بسيف اللحظ أو رمح القوام",97,"م",1,0],["ودهاهم ذاك القياس المستبين",