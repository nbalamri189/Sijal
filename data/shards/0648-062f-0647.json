{"poems":[[53,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[53,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[85,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[85,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[28,"وليلة ليل قد رفعت سناءها","https://www.aldiwan.net/poem5000.html","الطويل"],[61,"لنا غرفة حسنت منظرا","https://www.aldiwan.net/poem51645.html","المتقارب"],[61,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[66,"وإني لألهو بالمدام وإنها","https://www.aldiwan.net/poem40675.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[52,"نطقت مناطق خصره بصفاته","https://www.aldiwan.net/poem27214.html","الكامل"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"ودهماء ترسيها رقاش إذا شتت","https://www.aldiwan.net/poem65046.html","الطويل"],[48,"إذا خطرت فيك الهموم فداوها","https://www.aldiwan.net/poem65098.html","الطويل"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[46,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[76,"رجاء دون أقربه السحاب","https://www.aldiwan.net/poem39489.html","الكامل"],[48,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[109,"قم ننتهزها فرصا","https://www.aldiwan.net/poem16615.html","مجزوء الرجز"],[115,"اقامك الحسن سكراناً بخمرته","https://www.aldiwan.net/poem40623.html","عموديه"],[155,"لي حبيب خده كال","https://www.aldiwan.net/poem55647.html","مجزوء الرمل"],[160,"تقضت ليال ضاعفت لكم الأجرا","https://www.aldiwan.net/poem58864.html","الطويل"],[160,"يغر بحسن الرأى راج ويخدع","https://www.aldiwan.net/poem58992.html","الطويل"],[160,"انجزت في الأعداء ميعاد المنى","https://www.aldiwan.net/poem59087.html","الكامل"],[166,"قاض مضى لسبيله لما قضى","https://www.aldiwan.net/poem47036.html","الكامل"],[166,"يا طيب ليلتنا بصحبة غادة","https://www.aldiwan.net/poem47124.html","الكامل"],[207,"ولا زائل أزجي الجياد على الوجى","https://www.aldiwan.net/poem27900.html","الطويل"],[209,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[210,"قدوم أتى باليسر والسعد مقبلا","https://www.aldiwan.net/poem13308.html","الطويل"],[210,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[232,"عذرا فقلبي ما عليه اعتذار","https://www.aldiwan.net/poem14839.html","السريع"],[261,"هو المجد ما يقظانه مثل نائم","https://www.aldiwan.net/poem38191.html","الطويل"],[261,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[261,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[275,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[282,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[300,"ألم ترم الأطلال من حول جعشم","https://www.aldiwan.net/poem45455.html","الطويل"],[364,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[371,"جنى ما جنى وانصرف","https://www.aldiwan.net/poem57310.html","مجزوء المتقارب"],[371,"ما أقامت إلا لترحل صبري","https://www.aldiwan.net/poem57468.html","البسيط"],[377,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[380,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[380,"تعفى العقيق وكثبانه","https://www.aldiwan.net/poem49200.html","المتقارب"],[403,"ولما ظمئنا من حرارة فقدكم","https://www.aldiwan.net/poem33430.html","الطويل"],[416,"تبارك من براك ابن المبارك","https://www.aldiwan.net/poem54012.html","الوافر"],[416,"سؤالك هذا الربع أين جوابه","https://www.aldiwan.net/poem54156.html","الطويل"],[432,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[432,"يقر لغليلم المليك بن غليلم","https://www.aldiwan.net/poem12345.html","الطويل"],[437,"لي صديق من أبر الناس","https://www.aldiwan.net/poem2510.html","مجزوء الرمل"],[439,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[461,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[461,"ولقد أكتم همي جازما","https://www.aldiwan.net/poem15665.html","الرمل"],[551,"ودهم كسون الليل سود ثيابه","https://www.aldiwan.net/poem47820.html","الطويل"],[551,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[575,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["وَدَهراً يُمَوِّلُ زَلّاتِهِ","وَلا يَدخَرُ العُدمَ إِلّا لِيَه",0,"ي",2,0],["وَدَهرٌ يُتابِعُ أَحداثَهُ","كَما تابَعَ الطَلَقَ النابِلُ",1,"ل",1,0],["وَدَهرٌ يَرُدُّ عَلينا العَلا","ءَ أَجدِر بِهِ أَن يَرُدَّ الغُفارا",2,"ر",2,0],["وَدَهماءَ مِن لَيلِ التَمامِ قَطَعتُها","أُغَنّي حِداءً وَالمَراسيلُ تَطرَبُ",3,"ب",1,0],["وَدَهرٌ لا يَصُحُّ بِهِ سَقيمُ","وَكَيفَ يَصُحُّ وَالأَيّامُ داءُ",4,"ا",2,0],["ودَهْرُكَ دَعْ بَنيهِ إليكَ يَهْفو","بِطاعَةِ مُسْتَبينِ الرِّقِّ عَبْدِ",5,"د",1,0],["وَدَهْرُكَ مُقْبِلٌ وَالعَيْشُ رَغْدٌ","كَمَا تَهْوَى وَسَرْبُكَ فِي أَمَانِ",6,"ن",1,0],["ودهاء لو ما كرته دواهي الدّ","هر طُرّاً لاغتالها منه غول",7,"ل",1,0],["وَدَهمٍ كَجُنحِ اللَيلِ زُرنا بِهِ العِدى","لَهُ عِثيَرٌ مِمّا تُثيرُ قَنابِلُه",8,"ل",2,0],["وَدَهى الدينَ وَالخِلافَةَ أَمرٌ","فادِحٌ رائِعٌ جَليلٌ جُسامُ",9,"م",1,0],["وَدُهانٍ كَلامِعِ الزَيتِ مَرَّت","أَعصُرٌ بِالسِراجِ وَالزَيتِ وُضّا",10,"ض",2,0],["وَدَها الجَزيرَةَ بَعدَ إِس","ماعيلَ وَالمَلِكِ الكَبير",11,"ر",1,0],["وَدَهرٌ ناسُهُ ناسٌ صِغارٌ","وَإِن كانَت لَهُم جُثَثٌ ضِخامُ",12,"م",1,0],["ودهن صفرة بيض فاغمرنَّ به","ما قد علمت وقَطّره علىعَكَرِ",13,"ر",1,0],["ودهرٌ قضتْ أحكامُه مُذْ تشابهتْ","أعاجيبُه أنْ ليس فيها أعاجيبُ",14,"ب",1,0],["وَدَهماءَ مِغضابٍ عَلى اللَحمِ نَبَّهَت","عُيوناً عَنِ الأَضيافِ لَيسَت بِرُقَّدِ",15,"د",1,0],["ودَهماءُ تهدِرُ هَدْرَ الفَنيقِ","إذا ما امتطَتْ لهباً مُسعِرا",16,"ر",2,0],["ودُهْمٌ إذا ما الليلُ رَفَّعَ سِجْفَه","تكشَّفَ منها عن وجوهٍ شَواحبِ",17,"ب",1,0],["وَدُهمٍ بِأَيدي الغانِياتِ تَقَعقَعَت","مَفاصِلُها مِن هَولِ ما تَتَنَظَّرُ",18,"ر",1,0],["وَدُهم بني دهمانَ فاض على الوغى","بِكُلِّ فتىً أحلى بسالتِهِ مُرُّ",19,"ر",1,0],["وَدُهْمٌ بفرسانِ الكفاحِ سوابِحٌ","تَجافيفُها في الروعِ مُنسَدِلُ اللبدِ",20,"د",1,0],["ودهرُنا أيُّ دهرٍ في تقلُّبِهِ","قَدْ هانَ فيهِ التقى والعلمُ والأدبُ",21,"ب",1,0],["وَدُهيتُ مِن خَطِّ العِذارِ بِخَدِّهِ","في صَدِّهِ وَالمَوتُ في لَحَظاتِه",22,"ت",2,0],["وَدَهرٍ مُؤاتٍ قَد مَلَكتُ نَعيمَهُ","وَأُعطيتُ مِن حَلواءِ عَيشٍ وَأَعطَيتُ",23,"ت",1,0],["وَدَهَى الأَسودَ بنَ عبدِ يغوثٍ","أن سَقَاهُ كأسَ الرَّدَى اسْتِسْقَاءُ",24,"ا",2,0],["وَدَهَتْ أَوْجُهاً بها وبيوتاً","مُلّ منها الإكفاءُ والإقواءُ",24,"ا",2,0],["ودُهْماً إذا استقبلْنَ حُوّاً كأنّما","عُلِلنَ إلى الأرساغ مسكاً وعنبرا",25,"ر",2,0],["وَدَهماءَ تُرسيها رَقاشٌ إِذا شَتَت","مُرَكَّبَةُ الآذانِ أُمُّ عِيالِ",26,"ل",1,1],["وَدَهقانَةٍ ميزانُها نُصبَ عَينِها","وَميزانُها لِلمُشتَرينَ غَشومُ",27,"م",1,0],["وَدَهرُ المَرءِ مُنقَلِبٌ عَلَيهِ","فُنوناً وَالنَعيمُ إِلى اِنقِلابِ",28,"ب",1,0],["وَدَهري بِالمُغارِ أَغارَ صَبري","وَعَلَّمَني التَعَفُّفَ بِالتَعَفّي",29,"ي",1,0],["وَدَهْرٌ سَادَتِ الْعُبدانُ فِيهِ","وَعاثَتْ في جَوَانِبِهِ الذِّئابُ",30,"ب",1,0],["ودهقانة ميزانه نصب عينه","وميزانه للمشترين غشوم",31,"م",1,0],["ودَهْورهَ الوفاءُ ونعمَ عقبى","الصداقةِ أنْ يدهوركَ الوفاء!",32,"ا",2,0],["وَدَهرَنا جَميعُهُ","إِن لَم نُغالطهُ غَصص",33,"ص",1,0],["ودهشة لقلوب العاشقين بدت","برونق فيه سلطان الجمال جلي",34,"ل",2,0],["وِدُّهُ وِدٌّ صحيحٌ","وهْوَ عَنِّي ذو انْقِباضِ",35,"ض",1,0],["ودهرك معمور نهاراً تصومه","وليلا بتطويل القيام وبالذكرى",36,"ر",2,0],["ودهر لأهل النقص سلم وصرفه","باشرافه في حرب ذى الفضل مولع",37,"ع",1,0],["ودهمتهم بكتائب لو أنها","دهمت صروف الدهر هدت ما بنى",38,"ن",2,0],["ودهشتُ حتى لستُ أدْري أنّهُ","ماضٍ قضى أو أنّه قاضٍ مَضى",39,"ض",2,0],["ودهشتُ حينَ رأيتُ في غلَسِ الدُّجى","شمساً تصكّ البدرَ بالعُنّابِ",40,"ب",1,0],["وَدُهماً وَحُوَّاً لِلغُرابِ تَخالُها","إِذا اِغتَسَلَت بِالماءِ طَيراً عَلاجِما",41,"م",2,0],["ودهى سقراط منه نا اشتكى","بعده من حيرة العقل صاعورا",42,"ر",2,0],["ودهر لنا كانت تريش نصاله","وقد تاب مما قد جنى وتنصلا",43,"ل",2,0],["ودهر قد نعمت به فولي","ولم ار ذاك الا من شقائي",44,"ا",2,0],["وَدَّهِلالُ الأُفق لَو أَنَّهُ","أَصبحَ في ساعِدِ سُعدى سِوار",45,"ر",1,0],["ودهرٍ ذميم ظلت فيه كأنني","أراقب عيشي من شفاه الأراقم",46,"م",1,0],["ودهر إذا استعفيته عن مظالمي","كأني سألت الضب ان يسلك البحرا",47,"ر",2,0],["ودهر طلبنا القرب فيه من النوى","ففرق من آمالنا ما تجمعا",48,"ع",2,0],["ودَهى الوَرَى مِنْ ثُكْلِ هَادِيهِم بِما","أعْيَا عَلَى الأفْهامِ والأَوْهامِ",49,"م",1,0],["وَدَهري عَلى أَنَّهُ مُبصِرٌ","تَعامى عَلَيَّ كَذا من ظَلَم",50,"م",1,0],["وَدُهمٍ تُصاديها الوَلائِدُ جَلَّةٍ","إِذا جَهِلَت أَجوافُها لَم تَحَلَّمِ",51,"م",1,0],["ودهْرٍ ضاعَ فيه مَضاءُ حَدّي","ضياعَ السَّيفِ في كفِّ الجَبان",52,"ن",1,0],["ودَهرٌ عَلا سِنُّه","فبانَ علَيه الخَرَف",53,"ف",1,0],["ودَهاها من طَرفها ما دَهاني","فهي مسحورةُ الفؤادِ بسِحري",54,"ي",1,0],["ودهاها الصِبا ورونقُ حسنٍ","مستعارٌ وزينبٌ ورباب",55,"ب",1,0],["وَدَهرٌ لا يَجود عَلى مُحب","عَفيف بِاللُقا دَهر بَخيل",56,"ل",1,0],["وَدَهرٌ يُخادع مُستَلئِماً","لَهُ قَتل الشَك إِيقانَهُ",57,"ن",2,0],["ودهر مشوم لا تعد ذنوبه","وهيهات أن أحصي الحصى بكلامي",58,"ي",1,0],["ودهرٌ قد جنى ذنباً عظيماً","فلما قيل هل تلقي اعتذارك",59,"ك",1,0],["ودهرٍ أعاني كل يوم خطوبه","وذلك دأبي يا أميم ودأبه",60,"ب",2,0],["ودُهاةٍ تَوَرَّطُوا مُقْفَلاَتٍ","فَتَحَتْهَا آرَاؤُه بهُداةِ",61,"ه",1,0],["وَدُهْمِ أَسَاطيلٍ تُحَاكِي مُتُونُها","أَراقِمَ مِمَّا قد نَفَثْنَ مِنَ السُّمِّ",62,"م",1,0],["ودّه أنّى خلونا","أبدا سهل مواتي",63,"ي",1,0],["ودَهرٍ مُطيعٍ وسورٍ منيعٍ","وقصرٍ رفيعٍ مشيدِ البناءِ",64,"ا",2,0],["ودُهْمٍ كأمثالِ الدَّآدي حَوالكٍ","جوالبَ من هَمِّ الرجال المُؤرقِ",65,"ق",1,0],["ودُّهُ والعهْدُ اِذْ يبْذلُهُ","خَلَصا منْ شوبِ عُذْرٍ ومللْ",66,"ل",1,0],["وَدُهْمٍ كسَوْنَ اللّيلَ سودَ ثيابهِ","عليهنّ فيحاءُ الفروج فَؤرُ",67,"ر",1,1],["وَدَهراً لا يُصيخُ إِلى نَصيحٍ","وَعَيشاً لا يَلَذُّ ولا يطيبُ",68,"ب",1,0],["ودهاني بما أُعزَّى فيه","عن ثباتِي له وحُسْنِ عَزائي",69,"ي",1,0],["ودهَتْنِي أَقاربٌ لي من الأَنْ","ساب لاَ بَلْ عَقارِبٌ في اللَّب",70,"ب",1,0]]}