{"poems":[[53,"لو كنت مجبول السماح","https://www.aldiwan.net/poem62934.html","مجزوء الكامل"],[87,"غزالة مرت على أتان","https://www.aldiwan.net/poem8007.html","الرجز"],[47,"فدتك أكف قوم ما استطاعوا","https://www.aldiwan.net/poem64659.html","الوافر"],[63,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[71,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[147,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[164,"اقرت رؤسا في الطلا هذه الرسل","https://www.aldiwan.net/poem58966.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[469,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[469,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[473,"يا غزالا خلعت فيه العذارا","https://www.aldiwan.net/poem60069.html","الخفيف"],[534,"هذي بيوت حل فيها القاصر","https://www.aldiwan.net/poem37377.html","الرجز"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46527","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94320","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34570","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35599","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120485","الكامل"],[5050,"صبرا على مضض المصارع","https://www.poetsgate.com/ViewPoem.aspx?id=38198",""]],"verses":[["ففعلتَهُ لا للثنا","ءِ ولا لطبعٍ فيك مُجبَر",0,"ر",1,0],["فَفَعَلَت بِسَيِّدِ الصِغارِ","فِعلَ الأَتانِ بِاِبنِها الحِمارِ",1,"ر",1,0],["فَفِعلُكَ إِن سُئِلتَ لَنا مُطيعٌ","وَقَولُكَ إِن سَأَلتَ لَنا مُطاعُ",2,"ع",1,0],["فَفَعالُهُ المحمودُ عند بخيلهِ","وفَعالُه المَذْمومُ عندَ جَوادِه",3,"د",2,0],["ففعلُكَ للجميلِ اسمُ اختتامٍ","فَدُمْ ما دامَ ها حرفَ افتتاحِ",4,"ح",1,0],["فَفَعَلنا ذَلِكُم زَمَناً","ثُمَّ دانى بَينَنا حَكَمُه",5,"م",2,0],["فَفَعَلتَ ما عَجَزَ الوَرى عَن فِعلِهِ","فَعَرَفتَ ما أَعياهُمُ عِرفانُهُ",6,"ن",2,0],["ففعلك في ثغر الزمان تبسم","وفي وجهه حسن وفي عينه كحل",7,"ل",1,0],["ففعلك تأويل لرؤياك إنها","به أتضحت كالشمس وقت الظهائر",8,"ر",1,0],["ففعاله مرئية آياته","وسخاؤهُ مروية أخباره",9,"ر",2,0],["ففعاله حسنٌ غداة","وزعته يا ابن الحسينِ",10,"ن",1,0],["فَفَعَلتُ الَّذي فَعَلتُ اِضطِراراً","إِذا فَعَلتَ الَّذي فَعَلتَ اِختِيارا",11,"ر",2,0],["ففَعُلَ ضُمّا كَذاكَ فَعِلَ","كَسْراً وافْوَعَّلَ ثم افْعَنْللا",12,"ل",2,0],["ففعل وترك سنة وكلاهما","أتت عن رسول الله إن كنت مقتد",13,"د",1,0],["فَفَعلت ذاكَ وَقالَت للشرط","أريد أَن أخزي بَعلي بِالغَلط",14,"ط",1,0],["ففعل كل ممكن أو تركه","في حقه يجوز عز ملكه",15,"ه",1,0],["ففعلك بالتّمييز إرثا وإنّما","على الفاعل التّمييزُ قد يتحوّلُ",16,"ل",1,0],["ففعلهم ذاك قد صحت مقاصدهم","فيه بتعظيم بيت الله والحرم",17,"م",1,0],["ففعلتُ ما فعل المشوقُ بليلةٍ","عادت لذاذتها عليَّ صباحا",18,"ح",2,0],["فَفِعالها مِن مُقلَتَيهِ وَلَونها","مِن وَجنَتيهِ وَطَعمُها مِن ريقِهِ",19,"ه",1,0],["ففعاله منها الغناء لمعدم","وبناء تلك لغير شي موجب",20,"ب",1,0],["ففعسى المهيمن أن يدا","ركني بعفو منه واسع",21,"ع",1,0]]}