لمتقارب"],[235,"تعشقته واهي المواعيد مذاقا","https://www.aldiwan.net/poem31810.html","الطويل"],[235,"عليل الشوق فيك متى يصح","https://www.aldiwan.net/poem32107.html","الوافر"],[249,"تغيرت المنازل من سليمى","https://www.aldiwan.net/poem2124.html","الوافر"],[261,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[282,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[297,"بكيت أسى لو رد عنك البكا حتفا","https://www.aldiwan.net/poem33216.html","الطويل"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[322,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[366,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[366,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[380,"بأي حال تراه يصطبر","https://www.aldiwan.net/poem48834.html","المنسرح"],[380,"تأنف صحبة النفس","https://www.aldiwan.net/poem49218.html","مجزوء الوافر"],[393,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[406,"لنفسك لم لا عذر قد نفذ العذر","https://www.aldiwan.net/poem50166.html","الطويل"],[406,"أرى الشعب فانظر دونه هل هو الشعب","https://www.aldiwan.net/poem50205.html","الطويل"],[416,"علي لا زلت مسرورا بسلمان","https://www.aldiwan.net/poem53863.html","البسيط"],[416,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[416,"دعوت فؤادي للسلو فما أجدى","https://www.aldiwan.net/poem54056.html","الطويل"],[416,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[429,"سلا ظبية الوعساء أين يمينها","https://www.aldiwan.net/poem39912.html","الطويل"],[439,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[461,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[466,"قضى غرمائي حب أسماء بعدما","https://www.aldiwan.net/poem50423.html","الطويل"],[477,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[529,"علي لله عهد لا يكدره","https://www.aldiwan.net/poem37154.html","البسيط"],[529,"علي لله إن أعطيت مقدرة","https://www.aldiwan.net/poem37388.html","البسيط"],[551,"عليلكم يرجو الشفاء وإنما العليل","https://www.aldiwan.net/poem47329.html","الطويل"],[558,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[562,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[562,"هذه رسالة صب دائم القلق","https://www.aldiwan.net/poem52904.html","البسيط"]],"verses":[["عَلى لَقَبٍ بَيَّنَت صِدقَهُ","مَناقِبُكَ الغُرُّ كُلَّ البَيانِ",0,"ن",1,0],["على لاحِقِ الأطْلَيْنِ يخْتَصِرُ المَدى","بإرْخاءِ ذِئْبِ الرّدْهَةِ المُتَورِّدِ",1,"د",1,0],["عَليلَ دَهرٍ سامَني تَعذيبا","أَدنى الضَنى إِذ أَبعَدَ الطَبيبا",2,"ب",2,0],["عَلى لاحِبٍ لا يَهتَدي بِمَنارِهِ","إِذا سافَهُ العَودُ النُباطِيُّ جَرجَرا",3,"ر",2,0],["عَليلَةٌ بِالشَآمِ مُفرَدَةٌ","باتَ بِأَيدي العِدى مُعَلِّلُها",4,"ل",3,0],["عَلَيَّ لِمَن ضَنَّت عَلَيَّ جُفونُهُ","غَوارِبُ دَمعٍ يَشمَلُ الحَيَّ أَجمَعا",5,"ع",2,0],["عَلَيَّ لِكُلِّ هَمٍّ كُلُّ عيسٍ","أَمونُ الرَحلِ مُؤجَدَةُ الفَقارِ",6,"ر",1,0],["عَلَيَّ لِأَبكارِ الكَلامِ وَعَونِهِ","مَفاخِرُ تُفنيهِ وَتَبقى مَفاخِرُ",7,"ر",1,0],["عليَّ له أن أبذل القلب والحشا","على ما يرى في الحبِّ والأمر أمره",8,"ر",2,0],["عليَّ لعمروٍ نعمةٌ بعدَ نعمةٍ","لوالِده ليستْ بذات عقاربِ",9,"ب",1,0],["عليّ لَبوسٌ قاسميٌّ من الرضا","وطوق من النعمى وتاجٌ من الفخر",10,"ر",1,0],["على لحن صوتٍ تخيَّرتُهُ","وإلا فلا تُدْنِها مِنْ فَمِي",11,"ي",1,0],["عَليلُ هَجرِكَ في حُمّى صَبابَتِهِ","لَهُ مِنَ الدَمعِ طولَ اللَيلِ بُحرانُ",12,"ن",1,0],["عَلَيَّ لِذاكَ اليَومِ صَومٌ نَذَرتُهُ","وَعِندي عَلى رَأيِ التَصَوُّفِ شُكرانُ",13,"ن",1,0],["عَلِيُّ لَوِ اِستَشَرتَ أَباكَ قَبلاً","فَإِنَّ الخَيرَ حَظُّ المُستَشيرِ",14,"ر",1,1],["عَلِيُّ لَقَد لَقَّبَتكَ البِلادُ","بِآسي الجِراحِ وَنِعمَ اللَقَب",15,"ب",1,0],["عَلى لِوائِكَ مِنهُم كُلُّ مُنتَقِمٍ","لِلَّهِ مُستَقتِلٍ في اللَهِ مُعتَزِمِ",16,"م",1,0],["عَلى لَهَواتِهِم شُعَراءُ لُسنٌ","وَفي أَعطافِهِم خُطَباءُ شُدقُ",17,"ق",1,0],["عَلَيَّ لِأَهلِ الجَورِ كُلُّ طِمِرَّةٍ","عَلَيها غُلامٌ مِلءُ حَيزومِهِ غِمرُ",18,"ر",1,0],["عَلِيٌّ لَيسَ يَمنَعُ مِن مَجيءِ","مُبارِزَهُ وَيَمنَعُهُ الرُجوعا",19,"ع",2,0],["عَليلُ الجِسمِ مُمتَنِعُ القِيامِ","شَديدُ السُكرِ مِن غَيرِ المُدامِ",20,"م",1,0],["عليلَةُ أنفاسِ الرِّياحِ كأنَّما","يُعَلُّ بماءِ الوَرْدِ نَرجِسُها النَّدي",21,"د",2,0],["عَلى لاحِبٍ مِثلِ المَجَرَّةِ خِلتَهُ","إِذا ما عَلا نَشزاً مِنَ الأَرضِ مُهرَقُ",22,"ق",1,0],["عَلِيلٌ أَنْتَ مُسْقِمُهُ","فَمَا لَكَ لا تُكَلِّمُهُ",23,"م",2,1],["عَلى لُجَّةٍ تَرتَجُّ أَمّا حَبابُها","فَنورٌ وَأَمّا مَوجُها فَكَثيبُ",24,"ب",1,0],["عَلَيَّ لَهُم حَقٌّ وَلي عِندَهُم هَوىً","تَتابَعَ ما بَيني وَبَينَهُما العُمرُ",25,"ر",1,0],["عليٌّ للعُقابِ وما عليٌّ","سِوى البطلِ الذي يحمي العُقابا",26,"ب",2,0],["عَليلٌ شاقَهُ نَفَسٌ عَليلُ","فَجادَ بِدَمعِهِ أَمَلٌ بَخيلُ",27,"ل",1,1],["عَليلاً عَلى لَبّاتِ بيضٍ كَأَنَّها","بَناتُ المَلا مِنها المَقاليتُ وَالنُزُر",28,"ر",1,0],["عليّ له جُهد نفسِ الشّكور","وإن قَصُرَتْ عن بلوغِ المدى",29,"ا",1,0],["على ليالٍ قصارِ","فديتُ فيها شعاري",30,"ي",1,0],["علَيّ لأمْلاكِ البِلادِ نَصِيحَةٌ","يقُومُ بها ذو حِسْبَةٍ في قِيامِهِ",31,"م",2,0],["عَلى لاحِبٍ كَحَصِيِر الصَنا","عِ سَوَّى لَها الصِنفَ إرِمالُها",32,"ه",2,1],["عليَّ لقد ملكت عصاة موسى","فقم واضرب بها أفعى الخمول",33,"ل",1,0],["عَلَيَّ لَإِن لاقَيتُ لَيلى بِخَلوَةٍ","زِيارَةُ بَيتِ اللَهِ رَجلانِ حافِيا",34,"ي",2,0],["عَلَيَّ لِصَفْوَةٍ نُجُبٍ حُقُوقٌ","أَنوءُ بِهَا وَأَعْبَاءٌ ثِقَالُ",35,"ل",1,0],["عَلَيَّ لِرَبعِ العامِرِيَّةِ وَقفَةٌ","تُمِلُّ عَلَيَّ الشَوقَ وَالدَمعُ كاتِبُ",36,"ب",1,0],["عَلَيَّ لِسَيفِ الدَولَةِ القَرمِ أَنعُمٌ","أَوانِسُ لَم يَنفِرنَ عَنّي رَبائِبُ",36,"ب",1,0],["عليّ لهُ جهدُ نفسي الشّكور","وإن قَصُرَتْ عن بلوغِ المدى",37,"ا",1,0],["عَلَيَّ لَها أَن أَحفَظَ العَهدَ وَالوُدّا","وَإِن لَم يُفِد إِلّا القَطيعَةَ وَالبُعدا",38,"د",2,1],["عَلِيلُ القَلْبِ وَالبَدَنِ","بَعِيدُ الدَّارِ وَالسَّكَنِ",39,"ن",1,1],["عَلِيلٌ عَلَى فَرْشِهِ مُدْنَفٌ","وكلُّ النُّجُومِ بِهِ تُحْدِقُ",40,"ق",1,0],["على لها دمعٌ إِذا ما رأيتهُ","مع القطر يهمي قلت أيهما القطرُ",41,"ر",1,0],["عليّ لها أن لا انام ولا أسلو","وأن ليس يجدي في لوم ولا عذل",42,"ل",1,1],["عَلَيَّ لَها سَعيُ الكِرامِ فَإِن أَمُت","فَوَهّابُها سَلّابُها وَنَزُوعُها",43,"ع",3,0],["عَليَّ لَكُم حمدٌ عَلى عُظم منّةٍ","تَعذّر عِندي أَن أُقابلها قَدرا",44,"ر",2,0],["عليّ لهم شرح البيان وما أرى","عليّ لهم شرح العلوم الفواضل",45,"ل",1,0],["على لوعةٍ يصطلي نارَها","وحرُّ الهوى في حشاهُ استعرْ",46,"ر",1,0],["على ليلة العيد التي تذكرونها","سلامٌ وإن لم يبق للعيد موثق",47,"ق",1,0],["على لذة لم يطل وقتها","أطال الزمان بها كربتي",48,"ي",1,0],["على لذة كان لي طعمها","مزيجاً من الحزن واللذة",48,"ه",1,0],["عَلَيَّ لَهُم أَن يَشرَقَ الرَبعُ بَعدَهُم","بِدَمعِيَ إِن أَبقى لِيَ الدَمعُ آماقا",49,"ق",2,0],["عَليلُ الشَوقِ فيكِ مَتى يَصِحُّ","وَسَكرانٌ بِحُبِّكِ كَيفَ يَصحو",50,"ح",2,1],["عَلى لُحُقٍ أَياطِلُهُنَّ قُبٍّ","يُثِرنَ النَقعَ بِالشُعثِ الصِباحِ",51,"ح",1,0],["عليل هوي الأحبة لن يعادا","ومأسور المحبة لا يفادى",52,"د",2,1],["عَلِيٌّ لَقَد جَلَّت أَياديكَ كَثرَةً","فَقَصَّرَ عَن إِحصائِها الهِندُ وَالقِبطُ",53,"ط",1,0],["عليَّ لأَصنافِ الرَزايا تناوبٌ","أُساور منها كلَّ آونةٍ صِنفا",54,"ف",2,0],["على لطفه الجاري الخفي وتستره ال","جميل وفضل فائض متكاثر",55,"ر",1,0],["عَلى لا حِبٍ يَزدادُ في اللُبسِ جِدَّةً","وَيَبلى عَنِ الإِعفاءِ طوراً وَيَخلُقُ",56,"ق",1,0],["عَلَيَّ لا أَفزَعُ مِن ريحِهِ","وَإِنَّما الأَحبابُ أَغصانُ",57,"ن",1,0],["عَلَيَّ لِنَفسي أَن أُطيعَ اِشتِطاطَها","عَلَيَّ إِذا لَم تَبغِ إِلّا المَعالِيا",58,"ي",2,0],["عَليل حُب عَلى فِراش ضَناً","مُحتَضر لِلحَمام مُنتَظر",59,"ر",1,0],["عَليلٌ قَد كَساهُ الدَم","ع أَثواباً مِن الوَرس",60,"س",1,0],["عليٌّ له في الطَيرِ ما طارَ ذِكرُهُ","وَقامَت بهِ أَعداؤُهُ وَهيَ تَشهَدُ",61,"د",1,0],["عَلي لَهُ في هَل أَتى ما تَلوتُمُ","عَلى الرُغمِ مِن آنافَكم فَتفرَّدوا",61,"د",3,0],["عَليلٌ وَما دائي سِوى الضَيم مِنهُمُ","فَهَل مِن خَلاصٍ إِذ مَدى الغايَة القَبرُ",62,"ر",1,0],["عَلى لاحب لَم يَعرِفوا نَصَبَ السُرى","بِحَيث ابن مَحمود حَميد لَهُم نُصُبُ",63,"ب",1,0],["عَليُّ لا زِلتَ مسروراً بسلمان","مَسَرَّةً تتمنَّى مُنذُ أزمانِ",64,"ن",1,1],["عليَّ لك الفضل الَّذي هو شاملي","وإنَّك قد حُزْتَ الفضائل أَجمعا",65,"ع",2,0],["عليَّ له من فضل قديم ما هو أهله","إليَّ وكم من نعمة منه قد أسدى",66,"د",2,0],["على ليث هزبر تكاد منه","ليوث الغاب تصفد في صفاد",67,"د",1,0],["عليّ له العليا طريفاً وتالداً","وكل افتخارٍ خدنها وقرينها",68,"ن",3,0],["عَلى لُجَجٍ خُضْرٍ إذَا هَبَّتِ الصَّبا","ترامى بنا فِيهَا ثَبيرٌ وثَهْلانُ",69,"ن",1,0],["على لاحبٍ من جو أرضٍ صقيلةٍ","إذا ما مشى فيها اليراعُ تبخترا",70,"ر",2,0],["عَلَيَّ لَهُم في كُلِّ شَهرٍ أَديَّةٌ","ثَمانونَ وافٍ نَقدَها وَجَزورُ",71,"ر",1,0],["عليلُ الوجدِ عندكَ لا يُعادُ","وسرُّ الحبِّ عندي لا يُعادُ",72,"د",1,1],["عَلَيَّ للهِ عَهْدٌ لا يُكَدِّرُهُ","صَقْرٌ وَلاَ عَاشَ مَنْ لَمْ يُوفِ بالذِّمَمِ",73,"م",1,1],["عَلَيَّ للهِ إنْ أُعْطيتُ مَقْدِرَةً","في الْحَلِّ والْعَقْدِ في وِرْدٍ وفي صَدَرِ",74,"ر",1,1],["عليلكُمُ يرجو الشّفاءَ وإنّما ال","عليلُ ولا يرجو الشفاءَ عليلُ",75,"ل",1,1],["عليل الهوى أضحى يعلله الهوى","وقد جبرت بالكسر منه الجبائر",76,"ر",1,0],["عليلةٌ من دواعي الشَّوقِ حينَ دَرَى","من لُطفِهِ ما بها وافَى كمُفتقِدِ",77,"د",1,0],["عليلةٌ اللفظِ والمعنى مجرَّدةٌ","صحيحةُ العَزْم في الأسفارِ والطُرُقِ",78,"ق",1,0]]}