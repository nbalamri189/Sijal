tsgate.com/ViewPoem.aspx?id=149039",""],[5213,"تنشقت بالدارات من مية عرفا","https://www.poetsgate.com/ViewPoem.aspx?id=170503",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5277,"دمعةٌ في مآقي دجلة..","https://www.poetsgate.com/ViewPoem.aspx?id=198594",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[307,"خَرِيفُ العُمْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215587",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[5356,"همسُ اشتياقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204474",""],[5431,"على لوحٍ بنور الله يُسقى...","https://www.poetsgate.com/ViewPoem.aspx?id=200032",""],[5442,"نوى ولو أن الفعل وافق ما نوى","https://www.poetsgate.com/ViewPoem.aspx?id=114765",""],[5582,"إِلَى التِّيهِ مالَتْ لَها أَنْ تَمِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=187262",""],[5595,"عليٌّ أصلهُ نسبُ النبيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=144759",""],[5596,"سمائل المذهلة","https://www.poetsgate.com/ViewPoem.aspx?id=206486",""],[5605,"مدرسة الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=162130",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""],[5628,"أمنية العام الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=178523",""],[5628,"ميادة الحناوي تألق دائم *","https://www.poetsgate.com/ViewPoem.aspx?id=182932",""],[5652,"عقولٍ تعشق الرأفه بليده دون فكرية","https://www.poetsgate.com/ViewPoem.aspx?id=178408",""],[5732,"ليحان صدري","https://www.poetsgate.com/ViewPoem.aspx?id=177912",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[5853,"ومض الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=202391",""],[6124,"حتى ألاقيك","https://www.poetsgate.com/ViewPoem.aspx?id=201231",""],[5309,"عليل له عند الطغاة رجاء","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573939",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6176,"رأيت جرحي واقفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65154&r=&rc=5",""],[463,"ينام على الغدر من لا يغارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60056&r=&rc=112",""],[6259,"لنفسكِ لم لا عذر قد نفدَ العذرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59410&r=&rc=58",""],[2220,"رأيتُ بارقة ً كالنجمِ لامعة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11425&r=&rc=299",""]],"verses":[["عَلى لَقَبٍ بَيَّنَت صِدقَهُ","مَناقِبُكَ الغُرُّ كُلَّ البَيانِ",0,"ن",1,0],["على لاحِقِ الأطْلَيْنِ يخْتَصِرُ المَدى","بإرْخاءِ ذِئْبِ الرّدْهَةِ المُتَورِّدِ",1,"د",1,0],["عَليلَ دَهرٍ سامَني تَعذيبا","أَدنى الضَنى إِذ أَبعَدَ الطَبيبا",2,"ب",2,0],["عَلى لاحِبٍ لا يَهتَدي بِمَنارِهِ","إِذا سافَهُ العَودُ النُباطِيُّ جَرجَرا",3,"ر",2,0],["عَليلَةٌ بِالشَآمِ مُفرَدَةٌ","باتَ بِأَيدي العِدى مُعَلِّلُها",4,"ل",3,0],["عَلَيَّ لِمَن ضَنَّت عَلَيَّ جُفونُهُ","غَوارِبُ دَمعٍ يَشمَلُ الحَيَّ أَجمَعا",5,"ع",2,0],["عَلَيَّ لِكُلِّ هَمٍّ كُلُّ عيسٍ","أَمونُ الرَحلِ مُؤجَدَةُ الفَقارِ",6,"ر",1,0],["عَلَيَّ لِأَبكارِ الكَلامِ وَعَونِهِ","مَفاخِرُ تُفنيهِ وَتَبقى مَفاخِرُ",7,"ر",1,0],["عليَّ له أن أبذل القلب والحشا","على ما يرى في الحبِّ والأمر أمره",8,"ر",2,0],["عليَّ لعمروٍ نعمةٌ بعدَ نعمةٍ","لوالِده ليستْ بذات عقاربِ",9,"ب",1,0],["عليّ لَبوسٌ قاسميٌّ من الرضا","وطوق من النعمى وتاجٌ من الفخر",10,"ر",1,0],["على لحن صوتٍ تخيَّرتُهُ","وإلا فلا تُدْنِها مِنْ فَمِي",11,"م",2,0],["عَليلُ هَجرِكَ في حُمّى صَبابَتِهِ","لَهُ مِنَ الدَمعِ طولَ اللَيلِ بُحرانُ",12,"ن",1,0],["عَلَيَّ لِذاكَ اليَومِ صَومٌ نَذَرتُهُ","وَعِندي عَلى رَأيِ التَصَوُّفِ شُكرانُ",13,"ن",1,0],["عَلِيُّ لَوِ اِستَشَرتَ أَباكَ قَبلاً","فَإِنَّ الخَيرَ حَظُّ المُستَشيرِ",14,"ر",1,1],["عَلِيُّ لَقَد لَقَّبَتكَ البِلادُ","بِآسي الجِراحِ وَنِعمَ اللَقَب",15,"ب",1,0],["عَلى لِوائِكَ مِنهُم كُلُّ مُنتَقِمٍ","لِلَّهِ مُستَقتِلٍ في اللَهِ مُعتَزِمِ",16,"م",1,0],["عَلى لَهَواتِهِم شُعَراءُ لُسنٌ","وَفي أَعطافِهِم خُطَباءُ شُدقُ",17,"ق",1,0],["عَلَيَّ لِأَهلِ الجَورِ كُلُّ طِمِرَّةٍ","عَلَيها غُلامٌ مِلءُ حَيزومِهِ غِمرُ",18,"ر",1,0],["عَلِيٌّ لَيسَ يَمنَعُ مِن مَجيءِ","مُبارِزَهُ وَيَمنَعُهُ الرُجوعا",19,"ع",2,0],["عَليلُ الجِسمِ مُمتَنِعُ القِيامِ","شَديدُ السُكرِ مِن غَيرِ المُدامِ",20,"م",1,0],["عليلَةُ أنفاسِ الرِّياحِ كأنَّما","يُعَلُّ بماءِ الوَرْدِ نَرجِسُها النَّدي",21,"د",2,0],["عَلى لاحِبٍ مِثلِ المَجَرَّةِ خِلتَهُ","إِذا ما عَلا نَشزاً مِنَ الأَرضِ مُهرَقُ",22,"ق",1,0],["عَلِيلٌ أَنْتَ مُسْقِمُهُ","فَمَا لَكَ لا تُكَلِّمُهُ",23,"م",2,1],["عَلى لُجَّةٍ تَرتَجُّ أَمّا حَبابُها","فَنورٌ وَأَمّا مَوجُها فَكَثيبُ",24,"ب",1,0],["عَلَيَّ لَهُم حَقٌّ وَلي عِندَهُم هَوىً","تَتابَعَ ما بَيني وَبَينَهُما العُمرُ",25,"ر",1,0],["عليٌّ للعُقابِ وما عليٌّ","سِوى البطلِ الذي يحمي العُقابا",26,"ب",2,0],["عَليلٌ شاقَهُ نَفَسٌ عَليلُ","فَجادَ بِدَمعِهِ أَمَلٌ بَخيلُ",27,"ل",1,1],["عَليلاً عَلى لَبّاتِ بيضٍ كَأَنَّها","بَناتُ المَلا مِنها المَقاليتُ وَالنُزُر",28,"ر",1,0],["عليّ له جُهد نفسِ الشّكور","وإن قَصُرَتْ عن بلوغِ المدى",29,"ا",1,0],["على ليالٍ قصارِ","فديتُ فيها شعاري",30,"ر",2,0],["علَيّ لأمْلاكِ البِلادِ نَصِيحَةٌ","يقُومُ بها ذو حِسْبَةٍ في قِيامِهِ",31,"م",2,0],["عَلى لاحِبٍ كَحَصِيِر الصَنا","عِ سَوَّى لَها الصِنفَ إرِمالُها",32,"ه",2,1],["عليَّ لقد ملكت عصاة موسى","فقم واضرب بها أفعى الخمول",33,"ل",1,0],["عَلَيَّ لَإِن لاقَيتُ لَيلى بِخَلوَةٍ","زِيارَةُ بَيتِ اللَهِ رَجلانِ حافِيا",34,"ي",2,0],["عَلَيَّ لِصَفْوَةٍ نُجُبٍ حُقُوقٌ","أَنوءُ بِهَا وَأَعْبَاءٌ ثِقَالُ",35,"ل",1,0],["عَلَيَّ لِرَبعِ العامِرِيَّةِ وَقفَةٌ","تُمِلُّ عَلَيَّ الشَوقَ وَالدَمعُ كاتِبُ",36,"ب",1,0],["عَلَيَّ لِسَيفِ الدَولَةِ القَرمِ أَنعُمٌ","أَوانِسُ لَم يَنفِرنَ عَنّي رَبائِبُ",36,"ب",1,0],["عليّ لهُ جهدُ نفسي الشّكور","وإن قَصُرَتْ عن بلوغِ المدى",37,"ا",1,0],["عَلَيَّ لَها أَن أَحفَظَ العَهدَ وَالوُدّا","وَإِن لَم يُفِد إِلّا القَطيعَةَ وَالبُعدا",38,"د",2,1],["عَلِيلُ القَلْبِ وَالبَدَنِ","بَعِيدُ الدَّارِ وَالسَّكَنِ",39,"ن",1,1],["عَلِيلٌ عَلَى فَرْشِهِ مُدْنَفٌ","وكلُّ النُّجُومِ بِهِ تُحْدِقُ",40,"ق",1,0],["على لها دمعٌ إِذا ما رأيتهُ","مع القطر يهمي قلت أيهما القطرُ",41,"ر",1,0],["عليّ لها أن لا انام ولا أسلو","وأن ليس يجدي في لوم ولا عذل",42,"ل",1,1],["عَلَيَّ لَها سَعيُ الكِرامِ فَإِن أَمُت","فَوَهّابُها سَلّابُها وَنَزُوعُها",43,"ع",3,0],["عَليَّ لَكُم حمدٌ عَلى عُظم منّةٍ","تَعذّر عِندي أَن أُقابلها قَدرا",44,"ر",2,0],["عليّ لهم شرح البيان وما أرى","عليّ لهم شرح العلوم الفواضل",45,"ل",1,0],["على لوعةٍ يصطلي نارَها","وحرُّ الهوى في حشاهُ استعرْ",46,"ر",1,0],["على ليلة العيد التي تذكرونها","سلامٌ وإن لم يبق للعيد موثق",47,"ق",1,0],["على لذة لم يطل وقتها","أطال الزمان بها كربتي",48,"ي",1,0],["على لذة كان لي طعمها","مزيجاً من الحزن واللذة",48,"ه",1,0],["عَلَيَّ لَهُم أَن يَشرَقَ الرَبعُ بَعدَهُم","بِدَمعِيَ إِن أَبقى لِيَ الدَمعُ آماقا",49,"ق",2,0],["عَليلُ الشَوقِ فيكِ مَتى يَصِحُّ","وَسَكرانٌ بِحُبِّكِ كَيفَ يَصحو",50,"ح",2,1],["عَلى لُحُقٍ أَياطِلُهُنَّ قُبٍّ","يُثِرنَ النَقعَ بِالشُعثِ الصِباحِ",51,"ح",1,0],["عليل هوي الأحبة لن يعادا","ومأسور المحبة لا يفادى",52,"د",2,1],["عَلِيٌّ لَقَد جَلَّت أَياديكَ كَثرَةً","فَقَصَّرَ عَن إِحصائِها الهِندُ وَالقِبطُ",53,"ط",1,0],["عليَّ لأَصنافِ الرَزايا تناوبٌ","أُساور منها كلَّ آونةٍ صِنفا",54,"ف",2,0],["على لطفه الجاري الخفي وتستره ال","جميل وفضل فائض متكاثر",55,"ر",1,0],["عَلى لا حِبٍ يَزدادُ في اللُبسِ جِدَّةً","وَيَبلى عَنِ الإِعفاءِ طوراً وَيَخلُقُ",56,"ق",1,0],["عَلَيَّ لا أَفزَعُ مِن ريحِهِ","وَإِنَّما الأَحبابُ أَغصانُ",57,"ن",1,0],["عَلَيَّ لِنَفسي أَن أُطيعَ اِشتِطاطَها","عَلَيَّ إِذا لَم تَبغِ إِلّا المَعالِيا",58,"ي",2,0],["عَليل حُب عَلى فِراش ضَناً","مُحتَضر لِلحَمام مُنتَظر",59,"ر",1,0],["عَليلٌ قَد كَساهُ الدَم","ع أَثواباً مِن الوَرس",60,"س",1,0],["عليٌّ له في الطَيرِ ما طارَ ذِكرُهُ","وَقامَت بهِ أَعداؤُهُ وَهيَ تَشهَدُ",61,"د",1,0],["عَلي لَهُ في هَل أَتى ما تَلوتُمُ","عَلى الرُغمِ مِن آنافَكم فَتفرَّدوا",61,"د",3,0],["عَليلٌ وَما دائي سِوى الضَيم مِنهُمُ","فَهَل مِن خَلاصٍ إِذ مَدى الغايَة القَبرُ",62,"ر",1,0],["عَلى لاحب لَم يَعرِفوا نَصَبَ السُرى","بِحَيث ابن مَحمود حَميد لَهُم نُصُبُ",63,"ب",1,0],[