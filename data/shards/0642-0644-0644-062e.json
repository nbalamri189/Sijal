{"poems":[[74,"قل لخليلي الذي رجوت به","https://www.aldiwan.net/poem19652.html","المنسرح"],[53,"قل لخلي أبي علي فتى البصرة","https://www.aldiwan.net/poem66438.html","البسيط"],[237,"كيف حرمت على جفني الوسن","https://www.aldiwan.net/poem14825.html","الرمل"],[333,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[358,"قل لخليلي يا خلي الهوى","https://www.aldiwan.net/poem39991.html","السريع"],[556,"قل لخل له وإن كان لا يد","https://www.aldiwan.net/poem47384.html","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99989","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99985","المديد"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131545",""],[1536,"قُلْ لِخَيْرِ الكُفاةِ أَحْمَدَ أعلى الْ","https://www.poetsgate.com/ViewPoem.aspx?id=85722",""]],"verses":[["قل لخليلي الذي رجوت به","تقدُّمي في الورَى وإجلالي",0,"ي",1,1],["قل لخليِّ أبي علي فتى البَصْ","رة حقاً لا بل فتى العسكرينِ",1,"ن",1,1],["قُل لِخَدَّيكَ مَتى كانَ الحَيا","لِجَحيمِ النارِ رَبعاً وَوَطَن",2,"ن",1,0],["قل لخير الأنام حبّك حسبي","يا مناط الآمال يوم المآب",3,"ب",1,0],["قُل لخليلي يا خليّ الهَوى","رِفقاً بِحالي إنّ أمري جلي",4,"ي",1,1],["قلْ لِخلٍّ له وإنْ كان لا يْد","ري جميعي وتالدي وطريفي",5,"ف",2,1],["قُلْ لِخَيْرِ الكُفاةِ أَحْمَدَ الْ","خَلْق جُوداً وَأعْظَمِ النَّاسِ قَدْرا",6,"ر",2,1],["قُلْ لِخيْرِ النَّاسِ كُلِّهِم","لا أُحاشِي فيهِ مِنْ أَحَدِ",7,"د",1,0],["قل لخفاقة الجناح","بين الأقتاب والجريد",8,"د",1,1],["قُلْ لِخَيْرِ الكُفاةِ أَحْمَدَ أعلى الْ","خَلْق جُوداً وَأعْظَمِ النَّاسِ قَدْرا",9,"ر",2,1]]}