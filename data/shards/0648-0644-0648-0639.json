ldiwan.net/poem47743.html","البسيط"],[554,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[565,"بكى حتى بكيت على بكاه","https://www.aldiwan.net/poem52917.html","الوافر"],[565,"على الدنيا ومن فيها السلام","https://www.aldiwan.net/poem52970.html","الوافر"],[578,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[578,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[578,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[643,"","https://poetry.dctabudhabi.ae/diwan/poem/26691","البسيط"],[1044,"","https://poetry.dctabudhabi.ae/diwan/poem/27088","الطويل"],[605,"ألا يا عين بكي لا تملي","https://www.poetsgate.com/ViewPoem.aspx?id=81338",""],[390,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","https://www.poetsgate.com/ViewPoem.aspx?id=4653",""]],"verses":[["وَلَو عَضُدُ المُلكِ اِجتَلاها مَخيلَةً","لَقَطَّعَها بِالعَضبِ وَهيَ تُحاكُ",0,"ك",1,0],["وَلَو عَلِقَت مِنّي بِغَيرِكَ مَدحَةٌ","لَكُنتُ كَمَن يَعتاضُ بِالماءِ جَلمَدا",1,"د",2,0],["وَلَوعَةٍ تَحطِمُ الضُلوعَ إِذا","ذَكَرتُ قُربَ اللِقاءِ عَنِ كَثَبِ",2,"ب",1,0],["وَلَوعَةٍ بِتُّ أُخفيها وَأُظهِرُها","بِمَنزِلِ الحَيِّ بَينَ الضَّالِ وَالسَلَمِ",3,"م",1,1],["ولو عَلِمَتْ ماذا تُعانيهِ بَعْدَنا","لما شَمِتَتْ جَهْلاً بِنا سُفَهاؤُها",4,"ا",3,0],["ولَوْعَةٌ كَشَباةِ الرُّمْحِ يُطفِئُها","تَجَلُّدي وأُوارُ الشّوْقِ يُذْكيها",5,"ي",3,0],["ولَو عَلِمَتْ بغدادُ أنّ ركائِبي","على ظَمَأٍ لاسْتَشْرَفَتْ لي صراتُها",6,"ت",3,0],["وَلَو عَرَفَ الطَبيبُ دَواءَ داءٍ","يَرُدُّ المَوتَ ما قاسى النِزاعا",7,"ع",2,0],["وَلوعٌ بِتَصويرِ الطِباعِ فَلَم يَجُز","بِعاطِفَةٍ إِلّا حَسِبناهُ يَرسُمُ",8,"م",1,0],["وَلَو عَن نَثاً غَيرِهِ جاءَني","وَجُرحُ اللِسانِ كَجُرحِ اليَدِ",9,"د",1,0],["وَلَو عُرِّيَت أَصلابُها عِندَ بَيهَسٍ","عَلى ذاتِ غِسلٍ لَم تُشَمَّس رِحالُها",10,"ل",3,0],["وَلَو عايَنتِنا لَعَلِمتِ أَنّا","نَمُدُّ بِحَبلِ آنِسَةٍ شَرودِ",11,"د",1,0],["ولو عَدِمت طباع القوم ُلؤماً","لما غدت النساء محجّبات",12,"ت",1,0],["وَلَو عاقَدتَ حَبلَ أَبي سَعيدِ","لَذَبَّ الخَيلَ ما حَمَلَ النِجادا",13,"د",2,0],["وَلَو عَلِمَت عِلمي أُمامَةُ كَذَّبَت","مَقالَةَ مَن يَنعى عَلَيَّ وَيَعنُفُ",14,"ف",1,0],["وَلَو عَلِمَ اِبنُ شَيبَةَ لُؤمَ تَيمٍ","لَما طافوا بِزَمزَمَ وَالحَطيمِ",15,"م",1,0],["وَلَو عَلِقَت حَبلَ الزُبَيرِ حِبالُنا","لَكانَ كَناجٍ في عَطالَةَ أَعصَما",16,"م",2,0],["وَلَو عَرَفَت هَذي العَشائِرُ رُشدَها","إِذاً جَعَلَتنا دونَ أَعدائِها سَدّا",17,"د",2,0],["وَلَو عَرَفوني حَقَّ مَعرِفَتي بِهِم","إِذاً عَلِموا أَنّي شَهِدتُ وَغابوا",18,"ب",3,0],["ولو عاودت ذاكَ الشقيّ شبيبةٌ","لعاودَ ذياكَ النعيم وأزيدا",19,"د",2,0],["ولو عطف الوشاة على ضعيف","إذاً شهدوا بشكري واحْتفالي",20,"ل",2,0],["ولو عَتْبُ الشَّباب ظهيرُ عَتْبي","رَجَعْنَ إليَّ بالعُتبى جوابي",21,"ب",2,0],["ولو عاينتْه جحيمُ الإله","لخرت لمعدته ساجدهْ",22,"د",2,0],["ولو عَقِلَت ما كايدتنا لأنها","بأنفاسها والوجهِ والطبلِ أكْيَدُ",23,"د",1,0],["ولو عاش عاشتْ في ذَاره وأَورقتْ","لها من عطاياه غصونٌ موائدُ",24,"د",1,0],["ولو علت لابساً سوالك من ال","نَاس لطالت وبينت قِصَرَه",25,"ر",2,0],["ولو عزمتْ نفسي على قطع لُجّةٍ","من البحرِ سبحاً ما نكَلْتُ عن البحرِ",26,"ر",1,0],["ولو عُدم الريحانُ حَيَّاهُ نشرُهُ","بمثلِ سحيقِ المسكِ فوقَ المداوك",27,"ك",1,0],["ولو عدَّهم قِرناً كفِيّاً لبأسهِ","إذن ما أتاهم من وجوه المخاتِلِ",28,"ل",1,0],["ولو عجلتُ وجدتُ اللَّه يعذرني","في قوله خُلق الإنسان من عجلِ",29,"ل",1,0],["ولو عِيبتْ هنالكمُ لديهِ","لقال نكيرهُ صمِّي صمامِ",30,"م",1,0],["ولو عقِلتُ ما حاولتُ نافلةً","ولا بكيتُ وقد أقصيتني شجنا",31,"ن",2,0],["وَلَو عَثَرَت عِندي إِذاً ما لَحَيتُها","بِعَثرَتِها وَلا اُسيءَ جَوابُها",32,"ب",3,0],["وَلَو عَلِمَ الخَلقُ ما عِندَهُ","أَهَلّوا إِلى اللَهِ كَي يَغرُبا",33,"ب",2,0],["وَلَو عَلِمَ العيدُ ما عِندَهُم","أَبى أَن يُمَزِّقَ عَنهُ الخِبا",33,"ب",2,0],["وَلوعونَ بِالغَدرِ مِن طَبعِهِم","فَمَن لَم يَكُن غادِراً جَرَّبا",33,"ب",2,0],["وَلَو عَلِمَت صَنعاءُ أَنَّكَ قادِمٌ","لَحَلَّت لَها البُشرى وَدامَ بِها البِشرُ",34,"ر",1,0],["وَلَو عَلِمَت قُعسوسُ أَنسابَ وَالِدي","وَوالِدِها ظَلَّت تَقَاصَرُ دونَها",35,"ن",3,0],["وَلَو عُدنا إِلَيها بَعدَ قَرنٍ","رَحَمنا الطِرسَ مِنها وَالمِدادا",36,"د",2,0],["وَلوعُ الرَجاءِ بِما لَم تَنَل","عُقولُ الأَوالي وَلَم تَطلُبِ",37,"ب",1,0],["وَلَو عُقِرَت لَبَلَّغَني إِلَيهِ","حَديثٌ عَنهُ يَحمِلُ كُلَّ ماشِ",38,"ش",1,0],["ولو عَرَفُوا مقدارَ فضلي ألِفْتُهمْ","ولم ألتمسْ منهم ثَواباً ولا أجْرَا",39,"ر",2,0],["ولو عجموا للحرب عُودَكَ مرةً","لما عاد إلا خائبُ الظنِّ محروبُ",40,"ب",1,0],["وَلَوعاتُ الهَوى هُنَّ اللَواتي","دَعَونَكَ لِلبُلابِلِ وَالغِناءِ",41,"ا",2,0],["وَلَو عاشَ مَيتٌ أَو تَقَرَّبَ نازِحٌ","لَدارَت مِنَ المَكروهِ ثَمَّ دَوائِرُه",42,"ر",2,0],["وَلَوعَةِ مُشتاقٍ تَبيتُ كَأَنَّها","إِذا اِضطَرَمَت في الصَدرِ شُعلَةُ قابِسِ",43,"س",1,0],["وَلَو عَلِموا أَنَّ المَنايا تُنيلُهُم","رِضاهُ إِذاً باتوا نَدامى عَلى السَمِّ",44,"م",1,0],["وَلوعَكَ إِنَّ الصَبَّ إِمّا مُتَمِّمٌ","عَلى وَجدِهِ أَو زائِدٌ في وَلوعِهِ",45,"ع",2,0],["وَلَو عُدَّ ما أَعطَيتَ مِن كُلِّ قَينَةٍ","وَأَجرَدَ خِنذيذٍ طِوالٍ ذَوائِبُه",46,"ب",2,0],["وَلَو عَلِموا أَوفى لِحَقنِ دِمائِهِم","وَأَبيَنَ فَضلاً عِندَ تِلكَ الفَواضِلِ",47,"ل",1,0],["وَلَو عَلِمَت أَنَّ الوَثاقَ أَشَدُّهُ","إِلى النارِ قالَت لي مَقالَةَ ذي عَقلِ",48,"ل",1,0],["وَلَو عَلِمَ الحَجّاجُ عِلمَكَ لَم تَبِع","يَمينُكَ ماءً مُسلِماً بِثَمينِ",49,"ن",1,0],["ولو عَلِمَت بطحاؤُّه ما تضمَّنَت","تطاولَتِ البطحاءُ وافتخرَ الشَّعبُ",50,"ب",1,0],["وَلَو عَمِلَ اِبنُ أَبي طالِبٍ","بِهَذي الأُمور لَفُزنا بِها",51,"ب",3,0],["وَلَو عَلِمَت أَهلُ المَدارِسِ قَدرَها","جَلَت كَأسَها في مَوضِعِ يُذكَرُ الدَرسُ",52,"س",1,0],["ولَوعةٍ بالشوقِ غيرِ لوعتي","وأضلعٍ في الوجد غير أضلُعي",53,"ع",2,0],["ولَو عَدّ ذو عِلمٍ جُدودَكَ لانتهى","إلى أوّلِ الدنيا بِهِ آخرُ العَدِّ",54,"د",1,0],["ولو عَلمتْ سني لما كان لومُها","عليّ سناناً جارحاً كلَّ جارحه",55,"ح",2,0],["وَلوعٍ بِسوءِ الظَنِّ لا يَعرِفُ الوَفا","يَبيتُ عَلى سَلمٍ وَيَغدو عَلى حَربِ",56,"ب",1,0],["وَلَو عاشَ فينا بَعدَ عَيشِ فَعالِهِ","لَأَخلَقَ أَعمارَ النُسورِ القَشاعِمِ",57,"م",1,0],["وَلَو عَلِمَ الشَيخانِ أُدٌّ وَيَعرُبٌ","لَسُرَّت إِذَن تِلكَ العِظامُ الرَمائِمُ",58,"م",1,0],["وَلَو عَضَلتَ عَنِ الأَكفاءِ أَيِّمَها","وَلَم يَكُن لَكَ في أَطهارِها أَرَبُ",59,"ب",1,0],["وَلَوْ عَرَفُوا مَا أَنْكَرُوهُ لأَيْقَنُوا","بِأَنَّ نَعِيمَ الدَّهْرِ خُدْعَةُ حَالِمِ",60,"م",1,0],["ولو عينُ معراثاً رأيتَ صفاءَها","لأصبحتَ مِنْ غيظِ الملامةِ ريِّضا",61,"ض",2,0],["ولو عزلوه جاءَ الرخصُ يسعى","إذا عُزل الغليظُ أتى الدقيقُ",62,"ق",1,0],["ولو عَقَلَ الإنسانُ لم يهدِ مدحةً","إليكَ وهل يُهدى إلى هجرٍ تمرُ",63,"ر",1,0],["وَلَو عَلِمَت وَخَيرُ العِل","مِ لِلإِنسانِ ما صَدَقا",64,"ق",2,0],["وَلَو عَبدٌ أَتى مِن آلِ لَيلى","لِيَركَبَني لَصِرتُ لَهُ حِمارا",65,"ر",2,1],["وَلَو عَرَفَ القَومُ مَعنى الحَياةِ","وَماذا يُرادُ مِنَ المُسلِمِ",66,"م",1,0],["وَلَو عَلِمَ الرَكبُ خَطبي إِذَن","لَما صَحِبونِيَ عِندَ المَسيرِ",67,"ر",1,0],["وُلوعٌ وَذَكرى أَورَثَتكَ صَبابَةً","أَلا إِنَّما الذِكرى هَوىً وَوُلوعُ",68,"ع",1,0],["ولو علم الناس الخفيّات مثله","لما كان في الأرض العريضة جاهل",69,"ل",1,0],["ولو عَلِقَتْهُ من أُميّةَ أحْبُلٌ","لَجُبَّ سَنامٌ من بني الشعر تامك",70,"ك",1,0],["وَلَو عَلِمنا أَنَّهُ هَكَذا","كُنّا إِذا بُسنا مَسَحناها",71,"ا",3,0],["وَلَو عايَنوها لَم يَلوموا عَلى البُكا","كَريماً سَقاهُ الخَمرَ بَدرٌ مُحلِّقُ",72,"ق",1,0],["وَلَو عَلِمتُم بِداءِ الذِئبِ مِن سَغَبٍ","إِذاً لَسامَحتُمُ بِالشَاةِ لِلذيبِ",73,"ب",1,0],["وَلَو عَوَّضوا عَنبَراً عَن بُراً","وَبُدَّلَ يَوماً حَصاهُم بِدُرّ",74,"ر",1,0],["وَلَو عَلِمناهُ سِرنا طالِبينَ لَهُ","لَعَلَّنا بِشِفا عَمرٍ نُوافيهِ",75,"ف",3,0],["ولو عَبِقَتْ في الشرق أنفاسُ طِيبِها","وفي الغربِ مزكومٌ لعادَ لهُ الشَّمُّ",76,"م",1,0],["ولو علِمْتُ بأَنّ الحُبّ آخِرُهُ","هذا الحِمَامُ لَمَا خالَفتُ لُوّامي",77,"م",2,0],["ولو عاد الذي يمضي سلونا","ولكن من ترحَّل لا يعود",78,"د",1,0],["ولو عَلِمَتْ نفْسُ الفتى يوْمَ حَتْفِه","ولاقَتْهُ فيها لم تُحِنْها مَنُونها",79,"ن",3,0],["ولَو عَلِمنا جِبالاً يُستَلاذُ بها","مِن رَهطِنا قامَةٌ لِلمُلكِ أَعمارا",80,"ر",2,0],["وَلَوْ عَلِمَ الإِنْسَانُ عُقْبَانَ أَمْرِهِ","لَهَانَ عَلَيْهِ مَا يَسُرُّ وَيَفْجَعُ",81,"ع",1,0],["وَلَوْ عَلِمَ الإنْسَانُ ما فِيهِ نَفْعُهُ","لأَبْصَرَ ما يَأْتِي وَمَا يَتَجَنَّبُ",82,"ب",1,0],["وَلَو عِشتَ يا عَبدَ الغنيّ خَلفتَني","وَلكِن عَناني ما بَكَتهُ عَناني",83,"ن",2,0],["وَلَو عاشَ لي خُوِّلَت","بِهِ الخَيلُ إِنجادَها",84,"د",3,0],["ولوعةُ مكلوم الفؤادِ وسادُه","يحنُّ له قُرباً فيوُسِعُه صدّا",85,"د",2,0],["ولو عُولِجَ الاقطاعُ حُمَّ شِفاؤها","ومَنْ لي بطَبٍّ بّينِ الحِذْقِ حاسم؟",86,"م",1,0],["ولو عَرَفت بلادي ما أرادَت","بها النُواب لم ترد انتخابا",87,"ب",2,0],["ولو عاش عاشتْ في ذَراه وأَورقتْ","لها من عطاياه غصونٌ موائدُ",88,"د",1,0],["ولوعدلنا بشيء من مناقبهم","شهب النجوم لقد قلنا اذا شططا",89,"ط",2,0],["ولو عميت إذاً لاشتقت نوركما","بقلب راعٍ وفيٍّ غير نساء",90,"ا",2,0],["ولو علِم العاصونَ في شرِّ دارهم","شريكاً لهم هذا المذمَّمُ لم يرضُوا",91,"ض",3,0],["ولو عمل الرويهب ثم أبدت","دُليلها لمَالَ عن العميل",92,"ل",1,0],["ولو علِمتَ الذي يجرى على كبدي","لقلتَ إنهما في الحبِّ سِيّانِ",93,"ن",1,0],["وَلَو عايَنَتكَ الجاهِلِيَّةُ لَم يَئِد","فَقيرٌ وَلا ضَمَّ الجَماعَةَ مَيسِرُ",94,"ر",1,0],["وَلَو عَمِيَت عَمّا أَرَيتَ بَصائِرٌ","لَبَصَّرتَها بِالقَعضَبِيَّةِ لُمَّعا",95,"ع",2,0],["وَلَو عَدّاكَ هَذا الجَيشُ يَوماً","لَأَصبَحَتِ الحُصونُ لَهُم سُجونا",96,"ن",2,0],["ولو عرفوك ما حملوا سيوفاً","ولا شحذوا الأَسنة والرجاجا",97,"ج",2,0],["ولو علموا ما للمطيعين عندنا","لساروا إليه العسج والوسج والوخطا",98,"ط",2,0],["وَلَو عارَضَت رَضوى بِأَيسَرِ دَرئِها","صَبوراً عَلى مَكروهِها حينَ تَعجُمُ",99,"م",1,0],["وَلَو عاوَدتَنِى لَرَأَيتَ قَومِى","هُمُ الأَشرافُ وَالعَدَدُ الكَثِيرُ",100,"ر",1,0],["وَلَو عنكِ عوّضتُ المَمالك كلّها","لَكانَ بِعيني كلُّ أَعدادِها صفرا",101,"ر",2,0],["وَلَو عاشَ الغَريضُ لَكانَ مِمَّن","يُقِرّ بِفَضلِ صَنعَتِهُ وَيَشهَد",102,"د",1,0],["ولو عرف الناسُ لم تهدهمْ","سبيلَ المنافعِ إلا النوبْ",103,"ب",1,0],["ولو عرفت مصر المفدّاة قدرها","لباتت لما يلقى البيان على جمر",104,"ر",1,0],["ولو عَلِمَ الأصحابُ طُرّاً بحاجَتي","إليهِ لَرَامُوا طَلْبَه الثَقَلانِ",105,"ن",1,0],["ولو عَلِم الأعداءُ منه مذلّةً","لما بانَ مِنْهُمْ في الزَمانِ التَخاصُمُ",106,"م",1,0],["ولو عَلِمَ الساعونَ طُرّاً بِفَضْلِه","لجأوا جميعاً نحوَه وتَكَلَّفُوا",107,"ف",3,0],["وَلَو عَقلوا لَحرَّرهم نِظامٌ","عَلى أَبوابِ حَقِّهِمِ يدقُ",108,"ق",1,0],["ولو عُلِّمَ الغصنُ مِن مَيْسِها","تعلّم مِنها وصلى لها",109,"ل",3,0],["ولو عاين القَطْرُ انهِمالَ يمينِه","إذا جاد ما أَثْنَى على نفسِه القَطْر",110,"ر",1,0],["وَلو عَلِمَت حَصباءُ أَرضِكَ مَن ثَوى","ضَجيعاً لَها باهَت عَلى الأَنجُمِ الزُهرِ",111,"ر",1,0],["وَلوعٌ أتيحتْ للفؤادِ ولم تكنْ","تُنالُ على عفوٍ كذاكَ سرائرهُ",112,"ر",2,0],["ولو عقلت القت الي زمامها","ولكنها الخرقاء ليس لها حجر",113,"ر",1,0],["ولو عهدنا دوام حي","دام إذا آدم ونوح",114,"ح",1,0],["ولو عادلَ الأعداءَ جُنداً وأهبةً","لنثَّرَ إِكليلَ السّماءِ وضَفَّرا",115,"ر",2,0],["وَلَو عَلِمَ المرتاب مَا يَعقُب الجَفا","لأَرْبابِهِ لاقتَصَّ مِن نَفسِهِ يَفدِي",116,"د",2,0],["وَلوعاً بِيُمنَى نَمْنَمَتْها حَدِيقَةٌ","نَزْهَدُ أَحْدَاق الوَرَى فِي الحَدَائِقِ",117,"ق",1,0],["ولَوْ علِقُوا بِيَحْيَى دُونَ غَمْصٍ","لَما قُلِعُوا جَميعاً قَلْع صَمْغِ",118,"غ",1,0],["وَلَو عَلِمَ الورى ما أَنتَ أَضحوا","لوجهك ساجدين ولم يُحابوا",119,"ب",3,0],["وَلَوعَةٍ لا تَزال الدَهرَ مُسعرَةً","بين الجوانح ناراً ذات تَسعيرِ",120,"ر",1,0],["ولو علموا ما عالم العقل منهم","وأنهم بالحس في دار غربة",121,"ه",1,0],["ولوعة الحر حين يمسى","وزاده النار والحديد",122,"د",1,0],["ولوعةَ البلبل المهجور ألبسَهُ","بعد الأحبّة أثواباً من السقم",123,"م",1,0],["ولوعتي ونحيبي","وانتشيه بقلبي",124,"ي",1,0],["ولوعتي وأماني العمر ذاهبة","شتى ضحية اهمال واغفال",125,"ل",1,0],["وَلَوعَة لَو وَعى طَرفي بِوادِرِها","ما سارَ مَدمَعَهُ في حُبِّكُم مَثَلا",126,"ل",2,0],["ولو عَزّوا أهنْتُهمُ انْتِقاماً","ولكنْ لا إهانةَ للمُهان",127,"ن",1,0],["ولوعْدٍ منك بعَوْدتِه","في عِز يَخلُدُ سَرْمَده",128,"د",2,0],["وَلَو عَينُ الشَفيقِ بَدَت لِوَجهي","لَفاضَت أَدمُعاً إِذ غاضَ بِشري",129,"ر",2,0],["وَلَو عُرِضَت مِن دُونِهِ شقة النَوى","وَكَوبد فيها كُل مُستَعضل صَعب",130,"ب",1,0],["وَلَو عَلم المِسكينُ ماذا يَنالُهُ","من الظُلمِ بَعدي ماتَ قَبل مَماتي",131,"ي",1,0],["ولو عَرضَت يوم الرَّحيل بنشرها","لذي كَربةٍ مُوفٍ على الموت مُدنَفِ",132,"ف",1,0],["ولو عَصَتْ فيهمْ يدي","أبَنْتَها عَنْ عَضُدي",133,"د",2,0],["وَلَو علمت بِالطَيفِ عاقَته دونَنا","لَقَد غبطت بُخلاً بِما لا يَضيرها",134,"ر",3,0],["ولو عَلمُوا مقدارَ حَظِّيَ منكُمُ","وهمّي بكم زال التّنافُسُ والغَبْطُ",135,"ط",1,0],["ولو عَلموا ما بي من الوجد والأسى","لرقُّوا لحالي في الهوى وتوجَّعوا",136,"ع",3,0],["ولو علم السُّلطان إقدامَ ناصر","لما استنصر السُّلطان إلاَّ بناصر",137,"ر",1,0],["ولو عَلِمْتُ بهذَا ما عَلِمْتَ به","وكانَ لي دونَهُ في الأَرضِ مُصْطَرَفُ",138,"ف",1,0],["ولو عَدَّدْتَ مالَكَ من أَيادٍ","لأَفنَيْتُ الطُّروسَ ولم أُوَفِّ",139,"ف",1,1],["ولو علا مقدارُ هِمَّاتِه","حاولَ أَدنى رُتْبَةٍ ما هي",140,"ه",2,0],["ولو علمتُ أنّ الخيالَ يزورُني","لجادتْ به عن ناظريّ الولائدُ",141,"د",1,0],["ولو عادَ دهرٌ كما قد بَدا","له وزمانٌ كما قد مضى",142,"ض",2,0],["ولو عَنَّ لي ظَبْيُ الفَلا لاجْتَنَبْتُهُ","لِتِمْثالِ عَيْنَيْكِ وسالِفَتَيْكِ",143,"ك",1,0],["ولو عَجَزَتْ عن هِمَّتِي لتبلَّغَتْ","بذي قَدَمٍ تصبو إِلَى ذي يدٍ تُصبي",144,"ب",2,0],["ولو عقل الورى حرصوا على أن","يكونوا كلهم للحب أهلا",145,"ل",2,0],["ولوعة إذا تنفّستُ لها","عن كبدي حرّقني أُوارُها",146,"ر",3,0],["ولو عَقلتْ عُقَيْلٌ شاورتني","فكنتُ برأي ناصِحها أشيرُ",147,"ر",1,0],["ولو علمتُ رغبةً تسوق لي","نفعاً لَخِفتُ أن يَضُرَّ الزهدُ",148,"د",1,0],["ولو على النار مرَّت منه لافحةٌ","لغالَب النارَ ما فيه من الشُّعلِ",149,"ل",1,0],["ولَوعٌ بذكرِ اللّهِ في خَلَواتِهِ","وفي الجهر بالإحسانِ والشُّكر قائم",150,"م",1,0],["ولو علِموا سَرائرَهُ كَعِلْمي","غَدا كُلٌّ كَمثْلي مُسْتهَاما",151,"م",2,0],["ولو عَلِموا ما باتَ يُضْمِرُ قَلْبُهُ","ويَنْويهِ منْ مُسْتَقْبَلِ الخيرِ شامِلِ",152,"ل",1,0],["ولوعاينتَني لحسبتَ أنّي","لدى العُوّاد مَيتْاً حلَّ رَمْسا",153,"س",2,0],["وُلُوْعٌ بَتذكارِ الأحبَّةِ لا يَفْنَى","وفرطُ حنينٍ في المنازلِ لو أغنى",154,"ن",2,1],["ولو عاينتَني ابكي غراماً","بدمعٍ فيه بعدَ البينِ شُرْبي",155,"ب",2,0],["ولو علمت بأن الشوق موصله","إلى الحمام لما قد ذقت من حرج",156,"ج",1,0],["ولوعةٍ بسره ساكنةٍ","وفكرةٍ لأجلها أطالها",157,"ل",3,0],["وَلوعٌ ولم أهْجَعْ لأجلِ جَمالِكُمْ","ومن أينَ للطَّرفِ الوَلوعِ هجوعُ",158,"ع",1,0],["ولوعةٌ أذْهلَتْ روحي وعن شغَفٍ","بنورِ حُسنكَ عن كلِّ الوَرَى ذهِلتْ",159,"ت",1,0],["ولو عرضت فرضاً على قلب ميت","تصور اوهام الصبابة يجزع",160,"ع",1,0],["ولو علموا صدق المدائح فيهم","لكانت مساعيهم تهش وتطرب",161,"ب",1,0],["ولو عذرتم كان إحسانكم","مطالباً بالشكر لا يعذر",162,"ر",1,0],["ولوعتي تضمن عن زفيري","غناك عن زجر حداة العير",163,"ر",1,0],["ولو عصرت معانيها لما رشحت","إلا بسالف ما أسدى من المنن",164,"ن",1,0],["وَلَوْ عاشَ ابنُ بُرْدٍ مَزَّ","قَ الْبَرْدُ بلا مُهْلَهْ",165,"ل",2,0],["ولو علمَ المغرُورُ قَدرَ مُصَابهِ","لعَضَّ بنَانا للندَامَة دامِيا",166,"ي",2,0],["ولو علَى خدِّي كتَبتُه وكا","نَ عِوضَ الحِبرِ سوَادُ حَدَقِي",167,"ق",2,0],["وَلَو علم الحَمامُ كما علمنا","من الدّنيا لما طَرِب الحَمامُ",168,"م",1,0],["ولو علمتَ ببسطِ الدّهرِ قبضتَهُ","إلى فِنائِك ما طالتْ له كَتِفُ",169,"ف",1,0],["ولو علمتُ بما لي في صدورهُمُ","قطعتُ منهمْ قُبيلَ اليوم أمراسي",170,"س",2,0],["ولو عَلِمَ السّيفُ لمّا علا","كَ حالَ كليلاً بلا مَضرِبِ",171,"ب",1,0],["ولو عَرَفَتْهُما الأَعرابُ قِدْماً","لَخرَّتْ نحوَ شِعِرِهِما الجِباهُ",172,"ا",2,0],["ولو عُرِفت لهُ في التُربِ ذاتٌ","ومَنزلةٌ لَهابَتْهُ الهَوامُ",173,"م",1,0],["ولو عَلِمَتْ زُهْرُ النجومِ مَكانَتي","لخرَّتْ جميعاً نَحْوَ وَجْهِيَ سجَّدا",174,"د",2,0],["ولو عُدْتُ بالملكِ العقيم وإِنني","رَجعْتُ به ما كنت إِلاَّ مُخَيَّبَا",175,"ب",2,0],["ولَو عَرْبَدتْ يَوْماً علَّي صُروفُه","وجئتُ له أَشْكُوه أَوْرَده الحَدَّا",176,"د",2,0],["وَلُّو عُيَينَةَ مِن بَعدي أُمورَكُمُ","وَاِستَيقِنوا أَنَّهُ بَعدي لَكُم حامِ",177,"م",1,1],["وَلَو عَرَفت صَرف البُيوعِ لَسَرَّها","بِمَكَّةَ أَن تَبتاعَ حَمضاً بِإِذخِرِ",178,"ر",1,0],["ولو عشنا ونحن نراك فينا","وأمر الله يترك ما بكيت",179,"ت",1,0],["ولَوْ عَلِمَ اللهُ الجِبَالَ عَصَيْنَهُ","لَجَاءَ بأَمْرَاسِ الْجِبَالِ يَقُودُها",180,"د",3,0]]}