iewPoem.aspx?id=186141",""],[5956,"اختصكِ الرحمن بالتوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=207452",""],[5977,"جنة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213138",""],[6038,"غزوة رمش","https://www.poetsgate.com/ViewPoem.aspx?id=27051",""],[6061,"يا أسفي للشؤم والجد النكد","https://www.poetsgate.com/ViewPoem.aspx?id=52711",""],[6089,"لاحبَّ إلا أنت","https://www.poetsgate.com/ViewPoem.aspx?id=213764",""],[6101,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177544",""],[6152,"أنتِ صباحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=203108",""],[6152,"صباحك ورد","https://www.poetsgate.com/ViewPoem.aspx?id=203109",""],[6323,"واحة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82170&r=&rc=1",""]],"verses":[["يا أَسيرَ الخُطوبِ نادِ غِياثَ ال","خَلقِ إِنَّ الَّذي رَجَوتَ هُناكا",0,"ك",2,0],["يا أَسيراً في سَنتِ هيلينَ رَحِّب","بِأَسيرٍ في سالُنيكَ جَديدِ",1,"د",1,0],["يا آسيَ المرضى ومنتجَعَ الرضى","ومُاسيَ الأيتامِ والضُعَفاءِ",2,"ا",2,0],["يا أَسمَ صَبراً عَلى ما كانَ مِن حَدَثٍ","إِنَّ الحَوادِثَ مَلقِيٌّ وَمُنتَظَرُ",3,"ر",1,0],["يا أسداً يا ابن جَهْوَرَ طَرَقَتْ","دهياءُ يغني في مثلها الأسدُ",4,"د",1,1],["يا آسفاً إنْ بذَّهُ حَسَنٌ","سبقَ القضاءُ ومِرَّةُ الوذَمِ",5,"م",1,0],["يا أسمحَ الناس نفساً باللُّهى ويداً","وأفسحَ الناس في مكروهةٍ عَطَنا",6,"ن",2,0],["يا أَسبَقَ الناسِ إِلى","مَوَدَّتي ما أَخَّرَك",7,"ك",1,0],["يا أسد القفار","يا حية البراري",8,"ي",1,0],["يا اِستَ وَهبِ بنِ سُلَيما","نَ بنِ وَهبِ بنِ سَعيدِ",9,"د",1,1],["يا آسِراً قَلبَ المُحِبِّ فَدَمعُهُ","وَالنَومُ مِنهُ مُطلَقٌ وَمُطَلَّقُ",10,"ق",1,0],["يا آسيَ الأسِيِّ لممتَ جراحتي","وأسلتَ عند نواكَ أيَّ جراحِ",11,"ح",1,0],["يا آسي الآسي لممت جراحتي","وأسلت يوم نواك أيّ جراح",12,"ح",1,0],["يا أَسَدَ المَوتِ تَخَلَّصتَهُ","مِن بَينِ لِحيَي أَسَدِ القاصِرَه",13,"ر",2,0],["يا أُساةَ الشَعبِ إِن أَعتِب فَقَد","شَفَّني من دائكم ما شفَّني",14,"ن",2,0],["يا أَسمَحَ الناسِ بِالسَلامِ وَيا","أَبخَلَهُم بِالصَفاءِ وَالصَفَدِ",15,"د",1,0],["يا أَسمُ جودي بِمَعروفٍ نَعيشُ بِهِ","وَلا تَكوني لَنا حَرباً وَأَوصابا",16,"ب",2,0],["يآ أَسَدَ الحَيِّ إِن راحوا بِمَأدُبَةٍ","وَثَعلَبَ الحَيِّ إِن ذافوا لِأَعداءِ",17,"ا",2,0],["يَا أُسْرَةَ الصّيْدنَاوِيِّ الَّتِي سَلكَتْ","قصْد السَّبِيلِ وَلاَ دَعْوَىَ وَلاَ صَلفَا",18,"ف",2,0],["يَا أَسَفَاً أَنَّهُ تَوَلَّى","رَيَّانَ عُودٍ غَضَّ الإِهَابْ",19,"ب",1,0],["يا أُسْرَةَ المُلْكِ صاغ الشعْرُ تهنئةً","من حبَّةِ القلب معناها ومبناها",20,"ا",3,0],["يَا آسَدَ الحَيِّ إِنْ رَاحُوا لِمَأدُبَة","ٍ وَثَعْلَبَ الحَيِّ إِنْ ذَافُوا لأَعْدَاء",21,"ا",2,0],["يا أستاذ فن الدلع يمعلم الطيبه","يروع من أيجيد فن الصحوه الغمضه",22,"ض",2,0],["يا أست وهب بن سليما","ن وهب بن سعيد",23,"د",1,1],["يا أسفاً للربيع يذهب بالورد","فلا تجتليه أعيننا",24,"ن",2,1],["يا آسيات بنا شوق تضيق به","منا الصدور فلا تخشين من صلع",25,"ع",1,0],["يا أسيل الخدّين باللَه هب لي","قبلةٌ من لماك واشف أوامي",26,"م",2,0],["يا أسعدَ الأيام يا عنوانَها","أنعِم وأكرِم إن تكُن عنوانا",27,"ن",2,0],["يا آسراً أنا سابيه وآسرهُ","بجاحم من سعير الوجد وهّاج",28,"ج",1,0],["يا أسير القبر من أسر القلوب","أنت بعد الموت سحارٌ رهيب",29,"ب",1,0],["يا أُساةَ الحيِّ لو أَجَّلتُمُ","رَأيكُم فيَّ إلى يومِ غدِ",30,"د",1,0],["يا آسِيَ الحَيِّ هل فَتَّشتَ في كَبدي","وهل تَبَيَّنتَ داءً في زَواياها",31,"ا",3,1],["يا آسيَ الجرحِ بادرْ ضمدَ سائله","إذا تريَّثتَ لم تنجعْ ضمائده",32,"د",2,0],["يا أسود الشرى وأشبال طه","ها هو الغرب يبتغي أن يهينه",33,"ن",2,0],["يا أَسمُ قَد خَبَلَ الفُؤادَ مُرَوِّحٌ","مِن سِرِّ حُبِّكِ مُعلِقٌ إِعلاقا",34,"ق",2,0],["يا أَسَفا على خُزَزِ بنِ عمرو","ويا نَدَما عليه ولَهفَ نفسي",35,"س",2,1],["يا أسم أسقاك البريق الوامض","والديم الغادية الفضافض",36,"ض",1,1],["يا آسرِي في حُبِّهِ","هَلْ من فكاكٍ للأسير",37,"ر",1,0],["يا أسم لا جزعي إن بات يبعدني","عنك الزمان فإن الشوق أدناني",38,"ن",2,0],["يا أسعدَ السعداءِ دع","وةُ مَن بجاهِكَ يُعرَفُ",39,"ف",1,1],["يا أسعدَ السعداءِ جودُك قد طَما","فغرقتُ لولا العَوْمُ في طوفانِه",40,"ن",2,0],["يا أسعد اللَه جدي يوم تلمحها","عيني وإن رتعت بالأدمع السرد",41,"د",1,0],["يا أسعدَ اللّهُ المساءَ وأنعَما","وحباك