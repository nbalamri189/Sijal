{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[86,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[4,"ترى الكثير قليلا حين تسأله","https://www.aldiwan.net/poem21281.html","البسيط"],[51,"يا أسدا يا ابن جهور طرقت","https://www.aldiwan.net/poem61867.html","المنسرح"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[70,"بالله قل لي خبرك","https://www.aldiwan.net/poem42917.html","مجزوء الرجز"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[45,"يا است وهب بن سليمان","https://www.aldiwan.net/poem63523.html","مجزوء الرمل"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[97,"فيم الغدو غداً وأين رواحي","https://www.aldiwan.net/poem24401.html","الكامل"],[97,"فيم الغدوّ غداً وأين رواحي","https://www.aldiwan.net/poem24762.html","الكامل"],[44,"لا سقيت أطلالك الداثره","https://www.aldiwan.net/poem30043.html","السريع"],[105,"رب أحببني وأحبب أسرتي","https://www.aldiwan.net/poem43384.html","الكامل"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[50,"يا صاح قم فاسقني بالكأس إعرابا","https://www.aldiwan.net/poem64847.html","البسيط"],[50,"لا تبغ شر امرئ شرا من الداء","https://www.aldiwan.net/poem64885.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54648","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[50,"لا تَبْغ شَرَّ امْرىء شَرًّا من الدَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=19924",""],[45,"يا أست وهب بن سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=31383",""],[118,"يا أسفا للربيع يذهب بالورد","https://www.aldiwan.net/poem49327.html","المنسرح"],[122,"حام السرور على قلبي فلست أعي","https://www.aldiwan.net/poem23790.html","البسيط"],[195,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[195,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[209,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[209,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[223,"خبروني اليوم أني في غد","https://www.aldiwan.net/poem55166.html","الرمل"],[223,"يا آسي الحي هل فتشت في كبدي","https://www.aldiwan.net/poem55168.html","البسيط"],[296,"أمده الدمع حتى غاض جائده","https://www.aldiwan.net/poem36819.html","عموديه"],[326,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[335,"صدع الظعائن قلبه المشتاقا","https://www.aldiwan.net/poem45423.html","الكامل"],[363,"يا أسفا على خزز بن عمرو","https://www.aldiwan.net/poem44499.html","الوافر"],[376,"يا أسم أسقاك البريق الوامض","https://www.aldiwan.net/poem4560.html","الرجز"],[399,"يا طلعة القمر المنير","https://www.aldiwan.net/poem46725.html","مجزوء الكامل"],[426,"من سفح لبنان أم من ذيل لبنان","https://www.aldiwan.net/poem40249.html","البسيط"],[429,"يا أسعد السعداء دع","https://www.aldiwan.net/poem12669.html","مجزوء الكامل"],[429,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[438,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[450,"يا أسعد الله المساء وأنعما","https://www.aldiwan.net/poem13902.html","الكامل"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[456,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[493,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[493,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[498,"يا رجال الغيب أين الهمم","https://www.aldiwan.net/poem37787.html","الرمل"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[513,"يا أسد الدين بدت حاجة","https://www.aldiwan.net/poem12124.html","السريع"],[542,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[549,"يا أسم إن صبابتي","https://www.aldiwan.net/poem47301.html","مجزوء الكامل"],[573,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"]],"verses":[["يا أَسيرَ الخُطوبِ نادِ غِياثَ ال","خَلقِ إِنَّ الَّذي رَجَوتَ هُناكا",0,"ك",2,0],["يا أَسيراً في سَنتِ هيلينَ رَحِّب","بِأَسيرٍ في سالُنيكَ جَديدِ",1,"د",1,0],["يا آسيَ المرضى ومنتجَعَ الرضى","ومُاسيَ الأيتامِ والضُعَفاءِ",2,"ا",2,0],["يا أَسمَ صَبراً عَلى ما كانَ مِن حَدَثٍ","إِنَّ الحَوادِثَ مَلقِيٌّ وَمُنتَظَرُ",3,"ر",1,0],["يا أسداً يا ابن جَهْوَرَ طَرَقَتْ","دهياءُ يغني في مثلها الأسدُ",4,"د",1,1],["يا آسفاً إنْ بذَّهُ حَسَنٌ","سبقَ القضاءُ ومِرَّةُ الوذَمِ",5,"م",1,0],["يا أسمحَ الناس نفساً باللُّهى ويداً","وأفسحَ الناس في مكروهةٍ عَطَنا",6,"ن",2,0],["يا أَسبَقَ الناسِ إِلى","مَوَدَّتي ما أَخَّرَك",7,"ك",1,0],["يا أسد القفار","يا حية البراري",8,"ي",1,0],["يا اِستَ وَهبِ بنِ سُلَيما","نَ بنِ وَهبِ بنِ سَعيدِ",9,"د",1,1],["يا آسِراً قَلبَ المُحِبِّ فَدَمعُهُ","وَالنَومُ مِنهُ مُطلَقٌ وَمُطَلَّقُ",10,"ق",1,0],["يا آسيَ الأسِيِّ لممتَ جراحتي","وأسلتَ عند نواكَ أيَّ جراحِ",11,"ح",1,0],["يا آسي الآسي لممت جراحتي","وأسلت يوم نواك أيّ جراح",12,"ح",1,0],["يا أَسَدَ المَوتِ تَخَلَّصتَهُ","مِن بَينِ لِحيَي أَسَدِ القاصِرَه",13,"ر",2,0],["يا أُساةَ الشَعبِ إِن أَعتِب فَقَد","شَفَّني من دائكم ما شفَّني",14,"ن",2,0],["يا أَسمَحَ الناسِ بِالسَلامِ وَيا","أَبخَلَهُم بِالصَفاءِ وَالصَفَدِ",15,"د",1,0],["يا أَسمُ جودي بِمَعروفٍ نَعيشُ بِهِ","وَلا تَكوني لَنا حَرباً وَأَوصابا",16,"ب",2,0],["يآ أَسَدَ الحَيِّ إِن راحوا بِمَأدُبَةٍ","وَثَعلَبَ الحَيِّ إِن ذافوا لِأَعداءِ",17,"ا",2,0],["يَا أُسْرَةَ الصّيْدنَاوِيِّ الَّتِي سَلكَتْ","قصْد السَّبِيلِ وَلاَ دَعْوَىَ وَلاَ صَلفَا",18,"ف",2,0],["يَا أَسَفَاً أَنَّهُ تَوَلَّى","رَيَّانَ عُودٍ غَضَّ الإِهَابْ",19,"ب",1,0],["يا أُسْرَةَ المُلْكِ صاغ الشعْرُ تهنئةً","من حبَّةِ القلب معناها ومبناها",20,"ا",3,0],["يَا آسَدَ الحَيِّ إِنْ رَاحُوا لِمَأدُبَة","ٍ وَثَعْلَبَ الحَيِّ إِنْ ذَافُوا لأَعْدَاء",21,"ا",2,0],["يا أست وهب بن سليما","ن وهب بن سعيد",22,"د",1,1],["يا أسفاً للربيع يذهب بالورد","فلا تجتليه أعيننا",23,"ن",2,1],["يا آسيات بنا شوق تضيق به","منا الصدور فلا تخشين من صلع",24,"ع",1,0],["يا أسيل الخدّين باللَه هب لي","قبلةٌ من لماك واشف أوامي",25,"ي",1,0],["يا أسعدَ الأيام يا عنوانَها","أنعِم وأكرِم إن تكُن عنوانا",26,"ن",2,0],["يا آسراً أنا سابيه وآسرهُ","بجاحم من سعير الوجد وهّاج",27,"ج",1,0],["يا أسير القبر من أسر القلوب","أنت بعد الموت سحارٌ رهيب",28,"ب",1,0],["يا أُساةَ الحيِّ لو أَجَّلتُمُ","رَأيكُم فيَّ إلى يومِ غدِ",29,"د",1,0],["يا آسِيَ الحَيِّ هل فَتَّشتَ في كَبدي","وهل تَبَيَّنتَ داءً في زَواياها",30,"ا",3,1],["يا آسيَ الجرحِ بادرْ ضمدَ سائله","إذا تريَّثتَ لم تنجعْ ضمائده",31,"د",2,0],["يا أسود الشرى وأشبال طه","ها هو الغرب يبتغي أن يهينه",32,"ن",2,0],["يا أَسمُ قَد خَبَلَ الفُؤادَ مُرَوِّحٌ","مِن سِرِّ حُبِّكِ مُعلِقٌ إِعلاقا",33,"ق",2,0],["يا أَسَفا على خُزَزِ بنِ عمرو","ويا نَدَما عليه ولَهفَ نفسي",34,"ي",1,1],["يا أسم أسقاك البريق الوامض","والديم الغادية الفضافض",35,"ض",1,1],["يا آسرِي في حُبِّهِ","هَلْ من فكاكٍ للأسير",36,"ر",1,0],["يا أسم لا جزعي إن بات يبعدني","عنك الزمان فإن الشوق أدناني",37,"ن",2,0],["يا أسعدَ السعداءِ دع","وةُ مَن بجاهِكَ يُعرَفُ",38,"ف",1,1],["يا أسعدَ السعداءِ جودُك قد طَما","فغرقتُ لولا العَوْمُ في طوفانِه",39,"ن",2,0],["يا أسعد اللَه جدي يوم تلمحها","عيني وإن رتعت بالأدمع السرد",40,"د",1,0],["يا أسعدَ اللّهُ المساءَ وأنعَما","وحباكَ بالعَيشِ الرغيدِ مُخيّما",41,"م",2,1],["يا أسرتي مالي أَلُسُّ خَشاشتي","يبَساً وواديكم أغنُّ جميمُ",42,"م",1,0],["يا أُسْرةَ المجدِ التي لم تنتبهْ","عن مثلها الأيامُ وهي رُقودُ",43,"د",1,0],["يا أسد الملك لا الغياض ويا","سيف السنا والسناء لا الخِلل",44,"ل",1,0],["يا أَسَدَ الخلوة خنزير الملا","مَا لَكَ في الجري تقود الجملا",45,"ل",2,0],["يا أَساطينَ الحِمى يا سَادَتي","رضِيَ الله تعالى عنكُمُ",46,"م",1,0],["يا أسد الدين وما من حاجة","يدعى لها مد الفرات الزاخر",47,"ر",1,0],["يا أسد الدين بدت حاجة","نزاهتي تخجل من ذكرها",48,"ر",3,1],["يا أُسْرَةَ الشَّجَنِ العالي، لنا رَحِمٌ","من (الموسيقا)، لنا أَهْلٌ، لنَا.. ولنَا",49,"ن",2,0],["يا أسمُ إنّ صْبابتي","بك لو أويتِ لها طويلَهْ",50,"ل",2,1],["يا أَسعداً شَقِيتْ جُنُوبٌ بَعْدَهُ","جعلت مفارِشَها من السَّعْدَانِ",51,"ن",1,0]]}