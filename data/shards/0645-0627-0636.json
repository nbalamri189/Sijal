"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/199525","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141965","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43821","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116968","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"شكر عارفة","https://www.poetsgate.com/ViewPoem.aspx?id=179475",""],[106,"غادة البسفور","https://www.poetsgate.com/ViewPoem.aspx?id=179474",""],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[77,"نفحت فشبت لافح التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=34093",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[34,"أُنْبِئْتُ أنَّ لِخالي هَجْمَة ً حُبُساً","https://www.poetsgate.com/ViewPoem.aspx?id=22474",""],[45,"اسْتَوقِفا الرَّكبَ في أَطْلالِهم، وقِفا","https://www.poetsgate.com/ViewPoem.aspx?id=32848",""],[45,"مرنت مسامعه على التفنيد","https://www.poetsgate.com/ViewPoem.aspx?id=31332",""],[45,"بين الشقيقة فاللوى فالأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=2816",""],[91,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""],[78,"الأَكثَرين مُسَوَّدًا وَمُملَّكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86645&r=&rc=140",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["ما ضَرَّنا أَنَّنا بِلا جِدَةٍ","وَالبَيتُ وَالرُكنُ وَالمَقامُ لَنا",0,"ن",2,0],["ما ضاقَ هَمّاً كَالشُجاعِ وَلا خَلا","بِمَسَرَّةٍ كَالعاجِزِ المُتَواني",1,"ي",1,0],["ما ضَرَّني أَن لَو بَعِدتُ عَنِ الغِنى","أَبَداً وَأَنّي مِن لِقائِكَ دانِ",1,"ن",1,0],["ما ضَرَّ لَيثَ الغابِ نارٌ أُضرِمَت","في غابِهِ وَنَجا بِغَيرِ هَوانِ",1,"ن",1,0],["ما ضَرَّ راحِلَةً وَأَنتَ وَراءَها","مِن أَن يَكونَ عَلى المَنونُ قَدومُها",2,"م",3,0],["ما ضَرَّهُ مِن أَن يُشامَ وَما اِقتَنى","صَدَأً يُشَبَّهُ نَصلُهُ بِكَهامِ",3,"م",1,0],["ما ضَجَّ مِن طولِ مَطلِهِ أَمَلٌ","وَلا اِشتَكَتهُ العُهودُ وَالذِمَمُ",4,"م",1,0],["ماضٍ كَأَنَّ ذِراعَهُ","مِن قائِمِ العَضبِ الحُسامِ",5,"م",1,0],["ماضٍ مِنَ العَيشِ لَو يُفدى بَذَلتُ لَهُ","كَرائِمَ المالِ مِن خَيلٍ وَمِن نَعَمِ",6,"م",1,0],["ماضي المَقالِ يَكادُ مِن تَطبيقِهِ","يَومَ الجِدالِ يَئِنُّ مِنهُ المَفصِلُ",7,"ل",1,0],["ما ضَرَّ ذي الأَيّامِ لَو","أَنَّ البَياضَ الناصِلُ",8,"ل",1,0],["ما ضَرَّهُ ذاكَ وَهوَ مُنصَلِتٌ","تَسقُطُ مِنهُ الرِقابُ وَالقُلَلُ",9,"ل",1,0],["ماضٍ عَلى الهَولِ طَلاعٌ بِغُرَّتِهِ","عَلى الحَوادِثِ مِقدامٌ عَلى الأَجَلِ",10,"ل",1,0],["ماضٍ إِذا أَهوى بِهِ كَنَفٌ","مِن جِنحِ لَيلٍ ضَمَّهُ كَنَفُ",11,"ف",1,0],["ماضٍ عَلى وَقَعاتِ الدَهرِ إِن طَرَقَت","غَدا بِحَملِ أَذاها جِدُّ مُضطَلِعِ",12,"ع",1,0],["ما ضَرَّ مَن مُطِروا بِبَلدَتِهِ","إِن كانَ ماءُ المُزنِ مُحتَبَسا",13,"س",2,0],["ما ضَرَّ مَن شَرِبَ الحِمامَ تَكَرُّهاً","بِظُباكَ في رَوعٍ وَأَنتَ تُعاقِرُ",14,"ر",1,0],["ما ضَرَّهُ مِن سَمعِهِ","أَن لا يُعانَ بِالبَصَر",15,"ر",1,0],["ما ضَرَّهُم وَالبَينُ يَحفِزُهُم","لَو عَلَّلونا بِاِنتِظارِ غَدِ",16,"د",1,0],["ما ضَلَّ عَنّي إِنَّما","ضَلَّ بِقَلبي كَمَدا",17,"د",2,0],["ماضٍ فَإِن شَمَّ طُرو","قَ الضَيمِ زاغَ حَيَدا",17,"د",2,0],["ما ضَرَّني لَمّا فَلَلتُ غُروبَهُم","أَنّي كَثُرتُ لَهُم وَقَلَّ عَديدي",18,"د",2,0],["ما ضَرَّ مَنْ كانَ عَبْدُ اللهِ والِدَهُ","إن لم يكنْ أبَويْهِ الشّمسُ والقَمَرُ",19,"ر",1,0],["ما ضَرَّ أَهلَكِ أَلاّ يَنظُروا أَبَداً","ما دُمتِ فيهِم إِلى شَمسٍ وَلا قَمَرِ",20,"ر",1,0],["ما ضَرَّ قَوماً وَطِئتِ اليَومَ أَرضَهُمُ","أَن لا يَرَوا ضَوءَ شَمسٍ آخِرَ الأَبَدِ",21,"د",1,0],["ما ضَرَّ مَن قَطَعَ الرَجاءَ بِبُخلِهِ","لَو كانَ عَلَّلَني بِوَعدٍ كاذِبِ",22,"ب",1,0],["ما ضَرَّ خالِيَ عَمرواً لَو تَقَسَّمَها","بَعضُ الحِياضِ وَجَمُّ البِئرِ مُحتَفِلُ",23,"ل",1,0],["ما ضَرَّ بَحرَ الفُراتُ يَوماً","إِن خاضَ بَعضُ الكِلابِ فيهِ",24,"ه",1,0],["ما ضَرَّ نَصلَ السَيفِ إِخلاقُ غِمدِهِ","إِذا كانَ عَضباً حَيثُ وَجَّهتَهُ فَرى",25,"ر",2,0],["ما ضرَّ لو سلّمَ أو ودّعا","مَنْ أوْدَعَ القلْبَ الذي أوْدَعا",26,"ع",2,1],["مَاضِي العَزِيمَةِ مَيْمُونٍ نَقِيبَتُهُ","جَارٍ مِنَ الْبِرِّ وَالتَّقوَى عَلَى سنَنِ",27,"ن",1,0],["مَا ضَرَّهُمْ إِذْ نَاوَشَتْهُ كِلاَبُهُمْ","وَسَطَتْ بِهِ أَنْ لَمْ يَكُونُوا مُثَّلُ",28,"ل",1,0],["ما ضرّني أنْ لمْ أجِئْ متقدِّماً","السّبْقُ يُعْرَفُ آخِرَ المِضْمارِ",29,"ر",1,0],["ما ضَرَّ قَبراً أَنتَ ساكِنهُ","أَن لا يَمرّ بِأَرضِهِ القَطرُ",30,"ر",1,0],["ما ضَرَّ مَن كانَ هَذا في أَنامِلِهِ","أَن يَشهَدَ الحَربَ لَم يَسكُن إِلى يَلَبِ",31,"ب",1,0],["ما ضَرَّني لَو كُنتُ أَس","تَمِعُ الكَلامَ وَأَخضَعُ",32,"ع",1,0],["ما ضَرَّني لَو صُنتُ أَث","وابي فَلا تَتَقَطَّعُ",32,"ع",1,0],["ما ضاقَ أَصغَرُهُ عَن مَدحِ سَيِّدِهِ","وَلا اِستَعانَ بِمَدحِ الراحِ وَالبانِ",33,"ن",1,0],["ما ضَئيلٌ لَهُ الهَواءُ مَقيلٌ","مُكتَسٍ يَومَهُ وَفي اللَيلِ عاري",34,"ي",1,1],["ما ضَلَّ غِمرٌ عَن مَحَجَّةِ قَصدِهِ","إِلّا وَكانَ لَهُ إِلَيها مُرشِدا",35,"د",2,0],["ماضي العَزيمَةِ لا يُرى في رَأيِهِ","يَومَ الكَريهَةِ حائِراً مُتَرَدِّدا",35,"د",2,0],["ما ضَرَّ أَن لَم نَكُن أَكفاءَهُ شَرَفاً","وَفي المَوَدَّةِ كافٍ مِن تَكافينا",36,"ن",2,0],["ما ضَرَّهُ لَو قالَ لا تَثريبا","وَلا مَلامَ يَلحَقُ القُلوبا",37,"ب",2,0],["ما ضَرَّ لَو أَنَّكَ لي راحِمُ","وَعِلَّتي أَنتَ بِها عالِمُ",38,"م",1,1],["ما ضَرَّ أَنَّكِ بِالسَلامِ ضَنينَةٌ","أَيّامَ طَيفُكِ بِالعِناقِ جَوادُ",39,"د",1,0],["مَاضٍ بِفِطْرَتِهِ فِي نَهْجِ عِتْرَتِهِ","عَفِّ اللِّسَانِ نَقِيِّ النَّفْسِ مِنْ رِيَبِ",40,"ب",1,0],["مَا ضُرِّجَتْ بِالدَّمِ أَثْوَابُهُ","وَلا وَرَى الصَّادِعُ مِنْ زِنْدِهِ",41,"د",2,0],["مَا ضَاقَ صَدْراً وَهْوَ أَصْدَقُ مُسْلِمٍ","بِتَخَالُفِ الآرَاءِ وَالأَدْيَانِ",42,"ن",1,0],["مَا ضَارَ أَنْ بِنْتُمُو صِغَاراً","فَفِي النُّهَى بِتُّمُوا عِظَامَا",43,"م",2,0],["ما ضرَّ إذ أرسلت نظرة فاتكٍ","أن لو عطفت بنظرة المترحِّمِ",44,"م",1,0],["ما ضرَّ من رقَتْ غلائلُه ضحىً","لو باتَ ينقعُ للمحبِّ غليلا",45,"ل",2,0],["ما ضر نسمة حاجر لو أنها","أهدتْ لنا خبراً من الأخبارِ",46,"ر",1,0],["ما ضَرَّكم لو تسمعون لناصح","لم يَأتِ من نسج الكلام بهَلهَل",47,"ل",1,0],["ما ضرّ لو نحن وحّدنا ثقافتنا","قبل السياسة بالتعليم والكتب",48,"ب",1,0],["ما ضرّني غير أني اليوم مِن عرب","لا يغضبون لأمرٍ ليس يُرضيني",49,"ي",1,0],["ما ضرّهم لو نحَوْا في الأمر جامعةً","تنفي الكنائس عنها والمحاريب",50,"ب",1,0],["ما ضرّ من بعدما خلدّت من كتب","أن لا نرى لك بين الناس أنجالا",51,"ل",2,0],["ماضٍ عَلى الغَمَراتِ يُمضي هَمَّهُ","وَاللَيلُ مُختَلِفُ الطَرائِقِ داجي",52,"ج",2,0],["ما ضَرَّ أَهلَكِ أَن يَقولَ أَميرُكُم","قَولاً لِزائِرِكِ المُلِمُّ سَديدا",53,"د",2,0],["ماضٍ عَلى الهَولِ رِكّابٌ لِما قَطَعوا","إِذا الكُماةُ تَحامَوا في الصَناديدِ",54,"د",1,0],["ما ضرَّ من لمْ يجدْ في الحبِّ تعذيبي","لو كانَ يحملُ عنِّي همَّ تأنيبي",55,"ب",2,1],["ما ضرَّ مثلك لائم إلاَّ كما","قد ضرَّ أقمار الدجنَّة نابح",56,"ح",1,0],["ما ضرَّ ركباً كانَ بدراً له","أن لا يراعي النجم في قصده",57,"د",2,0],["ما ضرَّ إحسانك يا سيدي","لو حاد في أمري عن الاقتصاد",58,"د",1,1],["ما ضرني إن تولوا وهو مرتقب","وخاس عهد الغوادي وهو لم يخس",59,"س",1,0],["ما ضرّ بسام البروق لو أنه","يروي حديث جوايَ عن عباس",60,"س",1,0],["ما ضره والفعل فعل باهر","طلب السهى والأصل أصلٌ معرق",61,"ق",1,0],["ماضي الولاية في العشَّاق ناظرها","واحرَّ قلباه من ناظر الوالي",62,"ي",1,0],["ما ضرَّ عامل قدّه لو كانَ ذا","عطف فليس يضيع أجر العامل",63,"ل",1,0],["ما ضر إسماعيل غوث ذوي الرجا","لو صانني عن هذه الأحوال",64,"ل",1,0],["ما ضرَّه في مطاوي الأرض منزلةً","وأنت دافنه والله راحمه",65,"م",2,0],["ما ضرَّ معشر حاسديه لو أنهم","فطنوا لسرّ الله فيه وأذعنوا",66,"ن",3,0],["ماضي شبا العزم كم حالٍ به علقت","تعلُّق الحال من فعلٍ بماضيه",67,"ي",2,0],["ماضي السباق أظهر اللباس","ناهيك من سهمٍ ومن قرطاس",68,"س",1,0],["ما ضرَّ من خيَّم في جنابه","أن لا يكون الشهد من أطنابه",68,"ه",1,0],["ماضي القضاءِ إذا ارتأى","لم يستطع شَكٌّ جِذابهْ",69,"ب",2,0],["ما ضَرَّهُ أهَجَوْتَهُ","يا وغدُ أم طَنّتْ ذُبابهْ",69,"ب",2,0],["ماضٍ على الهَوْل نحو المجدِ يَطلبُهُ","من شأنه السُّربةُ البُعدى من السُّربِ",70,"ب",1,0],["ماضي الأداتين من سيف ومن قلم","كبش الكتابة كبش الحرب إن نطحا",71,"ح",2,0],["ما ضرَّ من زمَّ الكتابةَ زَمَّةً","أن كان مَنْبتُهُ بأرض الشِّيحِ",72,"ح",1,0],["ما ضرَّه أن لم تكن سَمُرَاتُهُ","نَخْلاً يُلَقِّحُهُ ذوو التلقيحِ",72,"ح",1,0],["ما ضرَّ مدحاً في جوا","دٍ بارِعٍ أن لا يجوَّدْ",73,"د",1,1],["ما ضرطةٌ بَدَرَتْ وهباً بواهبةٍ","لمن هجاه كحظٍّ ناله أَبَدا",74,"د",2,1],["ما ضرَّ شعري أعابه سفهاً","أم دسَّ في حُجر أمِّه وتَدَهْ",75,"د",2,0],["ما ضَرها أن لا يعي","شَ لها الفرزدقُ أو جريرُ",76,"ر",1,0],["ما ضم سيفاً لنا غِمدٌ ولا برحت","ضريبتاه من الأعداء والجَزر",77,"ر",1,0],["ما ضرَّ مهتدياً به في حندسٍ","عُدمُ الهداةِ وغيبةُ الأقباس",78,"س",1,0],["ماضي القضاء يكاد يسبق عَضُّهُ","ظهرَ القَطاة صَليله في القَونَس",79,"س",1,0],["ما ضر ناري التي صَلِيتَ بها","يا ابن استِها من فراشِكَ الغاشي",80,"ش",2,0],["ما ضرَّ ذاكِرهُ وناظرهُ","ألّا ينام على سِوى الحسكِ",81,"ك",1,0],["ما ضرَّهُ جُدَرِيٌّ حلّ وَجنتَه","لولا النجومُ إذاً لم يحسن الفلكُ",82,"ك",1,1],["ما ضرَّ مجفُوّكم جفاؤكُمُ","بالأمس في عيْشه ولا أمَلِهْ",83,"ل",2,0],["ما ضره ألا يجيدَ وما لَهُ","بسوى نداكَ إلى جداك توسُّلُ",84,"ل",1,0],["ما ضرَّ أعداءكم ألا يكون لهُمْ","إلٌّ تراعونه فيهم ولا ذِمَمُ",85,"م",1,0],["ما ضرَّ من عيناه تانِك ويحَهُ","ألا يكون لوجهه عينان",86,"ن",1,0],["ما ضَرَّ دُنيا كان فيها مِثْلُه","أَلا يُحلَّى غَيرُهُ بحُلِيِّ",87,"ل",2,0],["ماضٍ تَرى الطَيرَ تَردي في مَنازِلِهِ","عَلى مَزاحيفَ كانَت تَبلُغُ النَجَدا",88,"د",2,0],["ما ضَرَهُم أَنَّها باتَت تُسائِلُهُم","أَينَ المَواثيقُ أَينَ العَهدُ وَالقَسَمُ",89,"م",1,0],["ما ضَرَّنا وَالوِدُّ مُلتَإِمٌ","أَن لا يَكونَ الشَملُ مُلتَإِما",90,"م",2,0],["ما ضَربَةُ السَيفِ مِن ذي مُرَّةٍ بَطَلٍ","وَمُستَطيرُ اللَظى مِن قَلبِ صَوّانِ",91,"ن",1,0],["ماضَرَّهُ لَو كانَ وا","فى زائِراً عَلى مَهَل",92,"ل",1,0],["ما ضاحَكَتهُ الشَمسُ إِلّا خِلتَه","نُضِحَت جَوانِبُهُ بِماء نُظارِ",93,"ر",1,0],["ما ضر لو حميتهن","مثل ام حادب",94,"ب",1,0],["ما ضرنا لو ضل هذا","الكون غير معلل",95,"ل",1,0],["ما ضر لوجعلت كأسي مراشفها","ولو سقتني بصافٍ من حمياها",96,"ا",3,0],["ما ضج منك زقاق","ولا اشتكت منك حاره",97,"ر",2,0],["ما ضر لو زار أجفاني ولي رمق","عساى بالرمق الباقي أشيعه",98,"ع",2,0],["ما ضَرَّ لَو وافَيتُهُم زائِراً","أُريهُمُ فَوقَ الَّذي اِستَغرَبوا",99,"ب",3,0],["ما ضَرَّ لَو حَبَسوا الرَكائِبَ ساعَةً","وَثَنوا إِلى الفُسطاطِ فَضلَ زِمامِ",100,"م",1,0],["ما ضارَعَتها بَياناً عِندَ مُلتَأَمٍ","وَلا حَكَتها قَضاءً عِندَ مُختَصَمِ",101,"م",1,0],["ماضِياً في الجِهادِ لَم تَتَأَخَّر","تَزِنُ الصَفَّ أَو تُقيمَ الرَعيلا",102,"ل",2,0],["ما ضَرَّ لَو صَبَرَت رِكابُكَ ساعَةً","كَيفَ الوُقوفُ إِذا أَهابَ الداعي",103,"ع",2,0],["ما ضَرَّ لَو جَعَلوا العَلاقَةَ في غَدٍ","بَينَ الشُعوبِ مَوَدَّةً وَإِخاءَ",104,"ا",2,0],["ما ضَفَت قَطُّ في المُلوكِ عَلى نَذ","لِ المَعالي وَلا تَرَدَّت بِنَجسِ",105,"س",1,0],["ما ضَرَّني أَن لَيسَ أُفقُكَ مَطلَعي","وَعَلى كَواكِبِهِ تَعَلَّمتُ السُرى",106,"ر",2,0],["ما ضَرَّها مَن أَتاها","وَإِنَّما ضَرَّ صُلبَه",107,"ب",2,0],["ماضي الجَنانِ يُريهِ الحَزمُ قَبلَ غَدٍ","بِقَلبِهِ ما تَرى عَيناهُ بَعدَ غَدِ",108,"د",1,0],["ما ضاقَ قَبلَكِ خَلخالٌ عَلى رَشَأٍ","وَلا سَمِعتُ بِديباجٍ عَلى كَنَسِ",109,"س",1,0],["ما ضرَّهُ فيما جَنَاهُ عليهما","لو كانَ قدَّم منهما ما أخَّرَا",110,"ر",2,0],["ما ضرَّنِي أنْ كنتُ صاحبَ ضيعةٍ","لي دَخْلُها وعلى سوايَ خَراجُها",111,"ه",2,0],["ما ضَرَّ أَهلَ الثَغرِ إِبطاءُ الحَيا","عَنهُم وَفيهِم يوسُفُ بنُ مُحَمَّدِ",112,"د",1,0],["ما ضَرَّ شائِقَةَ الفُؤادِ لَوَ اَنَّهُ","شُفِيَ الغَليلُ أَوِ اِستَبَلَّ الوارِدُ",113,"د",1,0],["ما ضَرَّ قَوماً إِذا أَوطَأتِ أَرضَهُمُ","أَلّا يَرَوا ضَوءَ شَمسٍ آخِرَ الأَبَدِ",114,"د",1,0],["ماضٍ عَلى الحَدَثانِ لَم يَرجِع لَهُ","رَأيٌ بِرايَةِ عاجِزٍ مَجدودِ",115,"د",1,0],["ماضي الحُسامِ إِذا حَدَّ الحُسامِ نَبا","ثَبتُ الجَنانِ إِذا قَلبُ الجَبانِ هَفا",116,"ف",2,0],["ماضٍ وَإِن لَم تُمضِهِ يَدُ فارِسٍ","بَتَلٍ وَمَصقولٌ وَإِن لَم يُصقَلِ",117,"ل",1,0],["ماضٍ عَلى عَزمِهِ في الجودِ لَو وَهَبَ ال","شَبابَ يَومَ لِقاءِ البيضِ ما نَدِما",118,"م",2,0],["ما ضَرَّ قَومَكَ لَو رَدَّت حُكومَتُهُ","عَدلَ القَضاءِ كَما قَد جارَ في الحُكُمِ",119,"م",1,0],["ما ضَيَّعَ اللَهُ في بَدوٍ وَلا حَضَرٍ","رَعِيَّةً أَنتَ بِالإِحسانِ راعيها",120,"ي",3,0],["ماضٍ إِذا وَقَفَ المُشَهَّرُ لَم يَقِف","يَقِظٌ إِذا هَجَعَ السُها لَم يَهجَعِ",121,"ع",1,0],["ما ضَرَّها أَن لَم يَلِدها اِبنُ عاصِمٍ","وَأَن لَم يَلِدها مِن زُرارَةَ مَعبَدُ",122,"د",1,1],["ما ضَرَّ تَغلِبَ وائِلٍ أَهَجَوتَها","أَم بُلتَ حَيثُ تَناطَحَ البَحرانِ",123,"ن",1,0],["ما ضَرَّ ليلتَنا بسَفْحِ مُحَجِّرِ","لو باعَدَتْ سَفَرَ الصَّباحِ المُسفِرِ",124,"ر",1,1],["ما ضَرَّ وَسْنَى المُقلَتَينِ لو أنَّها","رَدَّتْ على الصَّبِّ الرُّقادَ الشَّارِدا",125,"د",2,0],["ما ضَرَّ مَن عَرَفَ الدُنيا وَغِرَّتَها","أَلّا يُنافِسَ فيها أَهلَها أَبَدا",126,"د",2,0],["ما ضَرَّ مَن جَعلَ التُرابَ فِراشَهُ","أَلّا يَنامَ عَلى الحَريرِ إِذا قَنِع",127,"ع",1,0],["ما ضَرَّ أَصحابَ القَليلِ وَما","أَغنى عَنِ الأَملاكِ ما مَلَكوا",128,"ك",3,0],["ما ضَلَّ صاحِبُكُم بِذا","كَ عَنِ الصَوابِ وَما غَوى",129,"و",2,0],["ما ضَرَّ مَولايَ لَو زادَ الخِطابُ بِهِ","وَلَو تَطَوَّلَ بِالحُسنى وَطَوَّلَهُ",130,"ل",2,0],["ما ضَرَّ مَن ظَلَّ في أَفناءِ مَنزِلِهِ","إِن أَغلَقَ الدَهرُ بابَ الرِزقِ أَو فَتَحا",131,"ح",2,0],["ما ضَرَّ طَيفَ خَيالِهِ لَو أَنَّهُ","يَسخو عَلَيَّ وَلَو بِطَيفِ خَيالِهِ",132,"ل",2,0],["ما ضَلَّ فِكري في جَميلِ صِفاتِهِ","إِلّا اِهتَدى شِعري بِحُسنِ خِلالِهِ",132,"ل",2,0],["ماضيَّ ضاعَ ولو قدر","تُ لجدتُ بالمستقبلِ",133,"ل",1,0],["ماضٍ وكم فيه من عثار","ومن عذابٍ قد انقضى",134,"ض",2,0],["ماضٍ على هَوْلِ الوقائعِ مُقْدِمٌ","كَالسيفِ صَمّمَ وَالغَضَنفرِ صالا",135,"ل",2,0],["ما ضَرَّ مَن تَمَّت مَحاسِنُهُ","لَو كانَ رَقَّ فُؤادُهُ الفَظُّ",136,"ظ",1,0],["ما ضَرَّ أَروَعَ يَرتَقي في هِمَّةٍ","عَلياءَ أَلّا يَرتَقي في سُلَّمِ",137,"م",1,0],["ما ضَرَّ مَن أَصبَحَ المَأمونُ سائِسَهُ","أَن لَم يَسُسهُ أَبو بَكرٍ وَلا عُمَرُ",138,"ر",1,0],["ماضٍ إِذا الكُرَبُ اِلتَفَّت رَأَيتَ لَهُ","بِوَخدِهِنَّ اِستِطالاتٍ عَلى النُوَبِ",139,"ب",1,0],["ما ضرَّكِ أنْ تُسقي بماءِ فردِ","والواجبُ أنْ يكونَ ماءَ الوردِ",140,"د",1,0],["ما ضرَّكِ أن تُسْقَيْ بماءٍ فردِ","والواجبُ أنْ يكونَ بماءِ الوردِ",141,"د",1,0],["ما ضِراري نَفسي بِهَجرَةِ مَن لَي","سَ مُسيئاً وَلا بَعيداً ثَراهُ",142,"ا",2,0],["ما ضارَ لابِسَ مِثلِهِ مِن خاتَمٍ","أَن لا يَشُبَّ مَعَ الظَلامِ ذُبالا",143,"ل",2,1],["ما ضَاعَ مِن مَالِ الفَتى وعتادِه","ما تَستعيرُ مِنَ اليمينِ شِمالُ",144,"ل",1,0],["ما ضاقَ في الدُنيا مَجالُ مُغامِرٍ","إِلّا تَقاذَفَهُ المَجالُ الأَوسَعُ",145,"ع",1,0],["ماضٍ عَلى هَولِ السُرى يَفري الدُجى","بِمَضاءِ عَزمٍ كَالشِهابِ المُوقَدِ",146,"د",1,0],["ما ضرَّ مَنْ يَسخو بِمُهجةِ نفسِهِ","أنْ لا يفوزَ من امرئٍ بِسَخاءِ",147,"ا",2,0],["ما ضَرَّها أَن لَم يَكُن مِسكاً وَلا","دُرّاً حَصىً حَلَّت بِهِ وَرُغامُ",148,"م",1,0],["ما ضَرَّني مَع رُؤيَةِ الحُسنِ الرِضى","أَنّي أُفارِقُ مَوطِناً أَو مَعشَرا",149,"ر",2,0],["ماضي الزَمانِ عَلَيكَ يَحسِدُ حالَهُ","لا زالَ غَيظَ الحاسِدِ المَحسودُ",150,"د",1,0],["ماضٍ تحصنت البلاد بظّله","من كيد منتدب وصولة عاد",151,"د",1,0],["ما ضَلَّ ذو أملٍ سَعى","يوماً وحكمتهُ الدَّليلُ",152,"ل",1,0],["ما ضاقَ عيشك لو سعي","ت له ولوْ لمْ تشْكُ ضِيقَهْ",152,"ه",1,0],["ماضٍ إِذا الأَنكاسُ بَعدَ الكَرى","تَباعَجَت أَرواحُ أَحلامِها",153,"م",3,0],["ماضٍ عَلى العَزَماتِ يَنصُرُ رَأيَهُ","مِن رَبِهِ التَوفيقُ وَالتَسديدُ",154,"د",1,0],["ما ضَرَّ حبرَاً قَلَّدَتْهُ أَئِمَّةٌ","أَن لم يكنْ لِمَنَاصِبٍ بمُبَلَّدِ",155,"د",1,0],["ما ضرَّهم قول المُعانِدِ إنهمْ","بِفِعَالِهِم أقوى الأنامِ نُفُوسا",156,"س",2,0],["ما ضَرَّكُمْ وَحَسْبُهُ","ما تَلْتَقِ في مِنْ آلامِ",157,"م",1,0],["ماضي العزائمِ غيرُه اغتَنَمَ اللُّهَى","في الحربِ واغتنَمَ النفّوسَ نِهابَا",158,"ب",2,0],["ماضٍ وَمُرتَهَنٌ بِدائِهِمُ","فَنُفوسُهُم لِلِقائِهِم تَجري",159,"ي",1,0],["ماضي العِداتِ إِذا وافَقتَ نَظرَتَهُ","أَدّى إِلَيكَ الَّذي يُعنى بِهِ النَظَرُ",160,"ر",1,0],["ما ضَرَّ أَهلَكِ يا سُعدى فَقَدتُهُمو","مِن عاشِقٍ زارَ لَو قالوا لَهُ سَدَدا",161,"د",2,0],["ما ضَرَّ عِندَكَ حَاجَتي ما ضَرَّها","عُذْراً إذا أعْطَيتَ نَفْسَكَ قدْرَها",162,"ر",3,1],["ما ضرنا الجهل لا نصغي لقالته","فكل أَرض على الجهال تشتمل",163,"ل",1,0],["ما ضره من لطمها","لو أنها كف خضيب",164,"ب",1,0],["ما ضرَّ لو حميتهن","ن مثل أمٍّ حادبِ",165,"ب",1,0],["ما ضرَّ سامعَها لَو اِخ","تلفت قوافيها القَصيد",166,"د",1,0],["ما ضرّ حقاً بيِّناً","أَن لا يَكون له شهود",166,"د",1,0],["ما ضاء من ليلاتنا أظلما","والسبت خَدَّاعٌ بها كالأحد",167,"د",1,0],["ما ضَيّع الدّين ولا اللسانا","ولا يد الفارُوق والإحْسانا",168,"ن",2,0],["ما ضرّ عمراً منضج الهواجر","إن كان لم ينصر ولم يهاجر",169,"ر",1,0],["ما ضَرَّ موسى لَو يَشُقُّ مَدامِعي","بَحراً لِيَغرَقَ عاذِلي وَرَقيبُهُ",170,"ب",2,0],["مَاضٍ مِنَ الْعَيْشِ مَا لاحَتْ مَخَايِلُهُ","فِي صَفْحَةِ الْفِكْرِ إِلا هَاجَ بَلْبَالِي",171,"ي",1,0],["مَاضِي الْغِرَارَيْنِ وَلَكِنَّهُ","لا يَعْرِفُ الصَّيْقَلَ وَالْمِبْرَدَا",172,"د",2,0],["مَاضِي الْبَصِيرَةِ غَلَّابٌ إِذَا اشْتَبَهَتْ","مَسَالِكُ الرَّأْيِ صَادَ الْبَازَ بِالْحَجَلِ",173,"ل",1,0],["مَا ضرَّ لوْ بَلَّغَهُ الدَّهْرُ فِي","ظِلِّ أَبِيهِ زمَنَ اليَافِعِ",174,"ع",1,0],["ماضِي العَزِيمَةِ ذُو ذَكَاءٍ باهِرٍ","مُتَوَافِقُ النِّيَّاتِ وَالأَقْوَالِ",175,"ل",1,0],["مَا ضَارَهَا مِنْ لَيَالٍ إِنْ عَبَسْنَ بِهَا","فَرُبَّ مَجْدٍ مِنَ الأَدْهَارِ ضَحَّاكِ",176,"ك",1,0],["مَا ضَارَ مَنْ ذَمَّ النُضَارَ وَرَبَّمَا","كانَتْ نقِيصَتُهُ بِعَيْنِ العَائِبِ",177,"ب",1,0],["ما ضَرَّ شيخُ نِزَار أنْ يُفارِقَه","مَن لا يَزين إذا أبناؤُه اتَسقُوا",178,"ق",3,0],["ماضيه، لو يدري بحاضره","رغم الأخوة مات من حسد",179,"د",1,0],["ما ضَرَّ مُوقِدَهَا، وَالخُلْدُ مَنْزِلُهُ‏‏‏","إِذا رَمى نَفْسَهُ في نارِها حَطَبا",180,"ب",2,0],["ما ضَلَّ في قَلبِ اِمرِىءٍ أَمَلٌ سَرى","إِلّا وُجودُهُمُ الهُدى وَالهادي",181,"ي",1,0],["ما ضَرَّك لو داوَيْتَ ضَنَى","صَبٍّ يُدْنيكَ وتُبْعِدهُ",182,"د",2,0],["ما ضَرَّني بَغيٌ عَلَي","يَ فَدَعهُمُ يَبغوا نَشاوى",183,"ا",3,0],["ما ضرّ عبداً صحّت إرادتُه","أجاع يوماً في اللَه أو شبعا",184,"ع",2,1],["ما ضرّ عبدا صحّت عزائِمهُ","أينٌ من الأرض أين ما صقعا",184,"ع",2,0],["ما ضَنَّ بالرِّفْدِ على وَافِدٍ","ولا لَوَى حَقَاً ولا ضَيَّعَأ",185,"ع",2,0],["ما ضرَّ أنجُمَك الزواهرَ أنَّنا","منها استَعرنَا للمعارف واحدًا",186,"د",2,0],["ما ضر غرسًا طاب قَبلَ أوانه","أن كان حراً في النبات أصيلا؟",187,"ل",2,0],["ما ضاع شعرُك حين خلَّ","ف في مسامعها صدى",188,"د",2,0],["ما ضاع من أيدي الليوث جمعِتهِ","وفي قبْضتَيْ ظبي أغنَّ، غرير",189,"ر",1,0],["ما ضرَّ لو نسىَ الجميعُ نفوسَهم","فيعودَ صفوُ الودِّ بعدَ تجاف!",190,"ف",1,0],["ما ضر أعظُمَهُ تواضعُ قبره","فالدرُّ درٌّ، وهْوَ في الأصْداف",190,"ف",1,0],["ماضٍ يَزينُ، وحاضرٌ يُزْهَى به","كالكَرمْ طابَ جَنًى، وطاب معتَّقَا",191,"ق",2,0],["ما ضرني أني لم أزرْها طالبًا","وقد اقتبست العلم ممن زارها",192,"ر",3,0],["ما ضرَّ لو لم يمزجوا","بالسمُّ هذا البلسما؟",193,"م",2,0],["ما ضاق ذرعًا بالنصا","رى رُحبها أو باليهود",194,"د",1,0],["ما ضرَّ مصرَ -ومصرُ دارُ الخلد- لو","صارت على المحتلِّ نارَ جهنَّم؟",195,"م",1,0],["ماضي العروبة يخطو نحوَ حاضرها","لي بالعروبةِ والرحمنِ إيمان",196,"ن",1,0],["ما ضَرَّ شعبًا أنتمو من أهله","أن يستطيل على الشعوب ويَفْخَرا",197,"ر",2,0],["ما ضَرَّه عِرْضٌ سلِيمٌ فوقَه","ثَوبٌ رخِيصٌ، أو قَمِيصٌ بَالِي",198,"ل",2,0],["ما ضَرَّ أن حاولوا إنضَاج خبزهِمُو","لو أحرقوا كوكبًا بالناس مَعْمورا؟",199,"ر",2,0],["ما ضيفُ إبراهيمَ ح","ينَ بدَا سوى مَلْكٍ كريم",200,"م",1,0],["ما ضرَّ أهل الريف ألا يحفلوا","بالطب، أو لا يعرفوا«الميكروبا»؟",201,"ب",2,0],["ماضٍ نعيشُ على أنقاضه أممًا","ونستمد القوى من وحيِ ذكراه",202,"ا",2,0],["ما ضرني أن لم أجيء متقدما","السبق يعرف آخر المضمار",203,"ر",1,0],["ما ضرني إذ نحن نخدع نفسنا","لو قلت ما أدري وفهت بما أرى",204,"ر",2,0],["ما ضرَّ من ضمن الحشا","لو كان يرعى ما ضمن",205,"ن",1,0],["ما ضرَّ انك ما مَلَكتَ لسانا","ولأنت أفصحُ مَنطِقاً وبيانا",206,"ن",2,0],["ما ضر خَلِيَ عَمْراً لَوْ تَقَسَّمَهَا","بَعْضُ الحِيَاضِ وَجَمُّ البِئْرِ مُحْتَفِلُ",207,"ل",1,0],["ماضِي الحُسامِ إِذا حَدُّالحُسَامِ نَبَا","ثَبْتُ الجَنَانِ إِذا قَلْبُ الجَنانِ هَفَا",208,"ف",2,0],["ماض على الحدثان، لم يرجع له","رأي براية عاجر مجدود",209,"د",1,0],["ماضِ، إذا وَقَفَ المُشَهَّرُ لم يُعِفْ،","يَقِظٌ، إذا هجَعَ السُّهَا لمْ يهْجَعِ",210,"ع",1,0],["ما ضرّنا ، والودّ ملتئم","أن لا يكون الشّمل ملتئما",211,"م",2,0],["ما ضاحَكَتهُ الشَّمسُ إِلّا خِلتَه","نُضِحَت جَوانِبُهُ بِماء نُضارِ",212,"ر",1,0],["ما ضَرَّني لَوْ قَدْ سَكَتُّ وَكُلَّما","غَلَبَ الأسى بالَغْتُ في الكِتْمانِ؟",213,"ن",1,0]]}