{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[33,"ومن كان محزونا بإهراق عبرة","https://www.aldiwan.net/poem42560.html","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65164","السريع"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112403","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44638","الكامل"],[4750,"كل دار أرجعت وأنا سناوي","https://www.poetsgate.com/ViewPoem.aspx?id=180447",""]],"verses":[["نُعَنّى بِالمِطالِ مِنَ الغَواني","وَهانَ عَلى المَواطِلِ ما لَقينا",0,"ن",2,0],["نُعِنهُ عَلى الإِثكالِ إِن كانَ ثاكِلاً","وَإِن كانَ مَحروباً وَإِن كانَ مُقصَدا",1,"د",2,0],["نعني به المولى أبا فارس","من يسُبك القول بلفظ وجيز",2,"ز",1,0],["ن عن العين يا رفيع العماد","يا عطوفاً وفي الشؤون عظيماً",3,"م",2,0],["نعنو لَدَيهِ كأنّهُ المسجِد","وكأنّنَا النُّسّاكُ في الزُّهدِ",4,"د",1,0],["نِعناعةٌ مَناعةٌ عَن كُلِّ ما","فيهِ الهَناءُ لِعاشقِ الأَقمارِ",5,"ر",1,0],["نعنبوك أنتي مكاسر عود جاوي","ملبسك سندس شرابك سلسبيله",6,"ل",2,0]]}