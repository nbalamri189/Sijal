{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[74,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[53,"أبوه بلبل ضاو ويكنى","https://www.aldiwan.net/poem65982.html","الوافر"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[92,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54306","الكامل"],[7,"ولستُ بذاخرٍ لغدٍ طعاماً","https://www.poetsgate.com/ViewPoem.aspx?id=17594",""],[119,"تمحضني النصيحة يا عذولي","https://www.aldiwan.net/poem40923.html","عموديه"],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[280,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[422,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[482,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"],[484,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[556,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[572,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103085","البسيط"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139019",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59138","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96750","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78007","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65975","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93994","الكامل"],[3378,"","https://poetry.dctabudhabi.ae/diwan/poem/203981","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74039","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4852,"بي طمع","https://www.poetsgate.com/ViewPoem.aspx?id=214275",""],[4978,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=177226",""],[4119,"قلت تقول الله لا خائفا","https://www.poetsgate.com/ViewPoem.aspx?id=16247",""],[5061,"النصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=156538",""],[585,"هل في العراق من الرفاق مواس","https://www.poetsgate.com/ViewPoem.aspx?id=161918",""],[3591,"أين الذي كان في باريس يزدهر","https://www.poetsgate.com/ViewPoem.aspx?id=149476",""],[1420,"احذر بني من القران العاشر","https://www.poetsgate.com/ViewPoem.aspx?id=87636",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5376,"عمَّ السماءَ فضائلٌ وسناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188367",""],[5956,"دائماً صهيون تنجو من العقاب","https://www.poetsgate.com/ViewPoem.aspx?id=192311",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""]],"verses":[["تَمحو أَساطيرَ الخُطوبِ كَما مَحا","مَرُّ الشَمالِ مِنَ الغَمامِ المُثقَلِ",0,"ل",1,0],["تمحو ظلام الليل بيضُ سيوفه","مذ قيل إنَّ الليل يسمى كافرا",1,"ر",2,0],["تمحّلَ نِسبةً أعيت أباه","وكان المرءُ يعجزُ لا المحالَهْ",2,"ل",2,0],["تمحو خِضابَ يديها مقلتي وأرى","أن ليسَ لثمُ لآلي الثغرِ من شاني",3,"ن",2,0],["تُمحى الغضارات في الدنيا سوى شفق","من الطفولة عذبٍ مثلها غضَرِ",4,"ر",1,0],["تَمحو صَحيفَةَ صَفحَتَيهِ يَدُ البِلى","عَبَثاً وَتَطوي ذِكرَهُ الآبادُ",5,"د",1,0],["تَمحو السُيوفُ وَلِلحَقائِقِ حُكمُها","مُلكَ الخَيالِ وَدَولَةَ الصِبيانِ",6,"ن",1,0],["تمحو سواجمُهُ المِدادَ فخطُّهُ","أسطارُ ملتَهِبِ الحشَا مُلْتاع",7,"ع",1,0],["تمحضتِ المنونُ لهُ بيومٍ","أتَى ، ولكلّ حاملة ٍ تمامُ",8,"م",1,0],["تمحضني النصيحة يا عذولي","وانك عاذل حينا وباش",9,"ش",1,1],["تَمحُو الذِي كَتَبَ التَّجْسيمُ مِن ظُلَمٍ","وَالصُّبْحُ مَاحِيةٌ أَنْوارُهُ الغَلَسا",10,"س",2,0],["تَمْحُو لُهَاهُ الأزْلَ هامِلَةً","لا زَالَ مَرْعِيّاً بِهِ الهَتَلُ",11,"ل",1,0],["تمحّض فيها البذر عمّا أجنّهُ","وَعاد لأيدي الباذِرين حَصيدها",12,"د",3,0],["تمحى ذنوبك سوى","كبائر السيآت",13,"ت",1,0],["تَمحقُ الباغين عن آخرهم","مثلما يمحو الدجى الصبحُ المنير",14,"ر",1,0],["تمحو منا سِمُها سطراً وتُثْبِتُه","نحوَ الدِّيارِ فممحوٌّ ومكتوبُ",15,"ب",1,0],["تمحو الزكاة سطور كل ضغينة","منها الفقير على الغني يتهجم",16,"م",1,0],["تمحضُ الصّدقَ إنْ أجابتْ سَؤولاً","وهْيَ خِلْوٌ من فهم تلك المعاني",17,"ن",2,0],["تَمْحُو إساءَاتِ القَدَرْ","وتترُكُ الدَّهْرَ أَغَرْ",18,"ر",1,0],["تمحى وتثبت بالأوهام في عدم","وذاك أيضاً من التحقيق أخلاكا",19,"ك",2,0],["تمحض منها القصد فيها فأرشدت","حيارى ثووا من جهلهم في مجاهل",20,"ل",1,0],["تَمَّ حُسْناً وَبَدَا بَدْرَ تَمَامْ","في اللَّيَالِي السُّودْ",21,"د",1,1],["تمحنتها في السَّير حتّى أنختها","بباب مليكٍ خُصَّ بالمجدِ والعُلا",22,"ل",2,0],["تمحو الأبوة والأموة والقوى","وتُميط ما تتضمن الأوراق",23,"ق",1,0],["تمحضه عفوا يكون بفضله","لما قد جنى عمدا مجلله غمدا",24,"د",2,0],["تمحي مضاضة دائه","وتزيل منه برحائه",25,"ه",1,0],["تمحو به عاراً وتبني مفخراً","لكنها ذلت وأنت الموئل",26,"ل",1,0],["تمحو وتثبت في الأنا","م كما تشاء أناملك",27,"ك",1,0],["تمحو دجى الإعدام راحة كفه","كرماً كما يمحو الهمومَ الراح",28,"ح",1,0],["تُمحى رسوم اللَيالي مولية","جَلالُها في اللَيالي لَيسَ يندثرُ",29,"ر",1,0],["تَمحى وَتثبت ما رامَت وَما رَفَضَت","بَينَ الاِنامِ بِاِقوالِ سميات",30,"ت",1,0],["تمحو خطايا التي -تاللهِ- مِن كسلٍ","قد أحسنتْ ظنَّها .. ما أحسنتْ عملا",31,"ل",2,0],["تَمَحُّكه بذكر القدسِ يعني","سواها لليهودِ له انتسابُ",32,"ب",1,0],["تمحو تصاوير الدمى عن يد","تبني المحاريب خلال المحان",33,"ن",1,0],["تمحي الزلهہ مثل سلخ الأديم","وعبدك الغاوي تدلهہ عن غواهہ",34,"ا",2,0],["تمحو الهموم وكل وزرٍ موبقٍ","أنقى وأطهر ما تذوَّق حاس",35,"س",1,0],["تمحى المسرّة في وقت البعاد ولا","تمحى الصبابة والأشواق والذكر",36,"ر",1,0],["تمحى خلافته وينسى ذكره","بين البرية صنع رب قادر",37,"ر",1,0],["تَمْحو ظَلاَمَ الغَيِّ لَيسَ لآيِهَا","نَسْخٌ عَلَى مَاضِي الزَّمَانِ وَمَا يَجِي",38,"ج",2,0],["تمحى الذنوبُ فلا تدومُ لتائبٍ","فاظفرْ به إنَّ النفوسَ ظِماءُ",39,"ا",2,0],["تمحق الآداب أنَّى ذهبتْ","بينما نحن نغذي الأدبا",40,"ب",2,0],["تمحضت للذات عن شبه الأثر","باسم السلام المؤمن المهيمن",41,"ن",1,0],["تُمحى بالرِّيح محطَّاتي","وجهاتي باءَتْ بالخسرانْ",42,"ن",1,0],["تمحّصنا بلوى، ونعلمُ أنَّنَا..","إذا استشْرت الأرْزاءُ كنَّا وِقَاءها",43,"ا",3,0]]}