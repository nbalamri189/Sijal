{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[567,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35811","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108977","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47211","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70341","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134001","الطويل"],[4859,"بوّابة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=191606",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""]],"verses":[["وأيَّ صبابةٍ سالتْ","على أوتارِه لحنا",0,"ن",2,0],["وَأَيُّ صَنِيعٍ بَعْدَ فَضْلِكَ يُرْتَجَى","وَأَنْتَ مَلِيكٌ فِي الْبَرِيَّةِ عَادِلُ",1,"ل",1,0],["وَأَيّ صَديقٍ لَم تُصبْه مثوبتي","وَأَيّ عدوٍّ لَم يَنلهُ عِقابي",2,"ب",2,0],["وأيُّ صباحٍ لا تليهِ عشيَّةٌ","وأيُّ ربيعٍ لا يليهِ خَريفُ",3,"ف",1,0],["وَإِيصالي إِلى أَقصى صلاتي","بِمَكَّةَ بَينَ زَمزَمِ وَالحجونِ",4,"ن",1,0],["وأي صبرٍ عليها غير مفترقٍ","وأي قلبٍ عليها غير منكسر",5,"ر",1,0],["وأيّ صلاةٍ للإِمام فسادُها","تبيّنَ فالمأموم في ذاك تابعُ",6,"ع",1,1],["وأي صبر أبتغي","وهو بكم مستهلك",7,"ك",1,0],["وأي صفات غير نعتك عرفها","إذا تليت ازكى من العطر والند",8,"د",1,0],["وأيُّ صحبٍ سيُنسون الفؤادَ أسى","وحسرةُ الرّوح نارٌ قوْتُها صدري",9,"ي",1,1],["وأيْ صاحبي ما ذنْب نفْسي إذا سَهتْ","عنِ الْهِيم قبْلًا،يوْمَ ما كُنتُ داريَا",10,"ي",2,0]]}