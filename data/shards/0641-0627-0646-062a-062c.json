{"poems":[[59,"خبت نار نفسي باشتعال مفارقي","https://www.aldiwan.net/poem24732.html","الطويل"],[44,"لا يصلح الناس فوضى لا سراة لهم","https://www.aldiwan.net/poem50309.html","البسيط"],[95,"بالعلم يدرك أقصى المجد من أمم","https://www.aldiwan.net/poem11392.html","البسيط"],[56,"ألا إنما الانسان غمد لقلبه","https://www.aldiwan.net/poem27382.html","الطويل"],[29,"لقد نادى أميرك بابتكار","https://www.aldiwan.net/poem5777.html","الوافر"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[93,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[47,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[30,"جزى الله عني في الأمور مجاشعا","https://www.aldiwan.net/poem5285.html","الطويل"],[68,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[99,"تعال سل القبيلة والجمالا","https://www.aldiwan.net/poem24942.html","الوافر"],[89,"هجوتك غير مبتدع مقالاً","https://www.aldiwan.net/poem8262.html","الوافر"],[71,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29363","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[124,"أيا ساعة مليت فيها بحسنه","https://www.aldiwan.net/poem49302.html","الطويل"],[173,"أأسكت عن مولى الورى أم أعاتبه","https://www.aldiwan.net/poem1603.html",""],[197,"جفون قد تملكها السهاد","https://www.aldiwan.net/poem13020.html","الوافر"],[254,"تداركني أوس بن سعدى بنعمة","https://www.aldiwan.net/poem2112.html","الطويل"],[295,"مهما تألبت الأحداث والغير","https://www.aldiwan.net/poem11710.html","البسيط"],[369,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[382,"عفت نفسي أمانيها","https://www.aldiwan.net/poem59166.html","مجزوء الوافر"],[382,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[409,"أقلب قلبا بعد بعدك في الجمر","https://www.aldiwan.net/poem33922.html","الطويل"],[409,"أهنيك بالعام الجديد وإنما","https://www.aldiwan.net/poem33935.html","الطويل"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[447,"عتاب أحال الشهد كالصاب في الحلق","https://www.aldiwan.net/poem14428.html","الطويل"],[466,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[518,"كم دون أرضك من واد ومن علم","https://www.aldiwan.net/poem67770.html","البسيط"],[556,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[556,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[558,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[564,"فجر المعارف في شرق الهدى وضحا","https://www.aldiwan.net/poem69366.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122663","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103079","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101469","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137599",""],[824,"","https://poetry.dctabudhabi.ae/diwan/poem/29485","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122306","الرجز"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77503","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70807","المجتث"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70783","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70960","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70956","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64918","الطويل"],[1267,"","https://poetry.dctabudhabi.ae/diwan/poem/144497","المجتث"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112706","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64467","الطويل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124296","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69419","الطويل"],[2017,"","https://poetry.dctabudhabi.ae/diwan/poem/21194","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53151","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33886","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27260","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28022","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28043","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109669","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88698","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2642,"","https://poetry.dctabudhabi.ae/diwan/poem/97843","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204476","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202988","السريع"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11259","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100174","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138557",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45902","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91961","البسيط"],[3720,"","https://poetry.dctabudhabi.ae/diwan/poem/146959","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131015",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133261","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135913","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77169","البسيط"],[4068,"","https://poetry.dctabudhabi.ae/diwan/poem/206108","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127061","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117268","البسيط"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130867","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133089","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133094","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136425",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141633","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[4674,"سفر","https://www.poetsgate.com/ViewPoem.aspx?id=207092",""],[4692,"مذ قيل صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=198278",""],[4954,"هلْ لي منْ غزالٍ سماحةً","https://www.poetsgate.com/ViewPoem.aspx?id=208832",""],[5102,"جولة في العيون الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=12899",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[5703,"أسطورة حلب","https://www.poetsgate.com/ViewPoem.aspx?id=206281",""],[5840,"أأحبابنا من بالقطيعة أغراكم","https://www.poetsgate.com/ViewPoem.aspx?id=181435",""],[5956,"أعِنّا يا إله الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192567",""]],"verses":[["فَإِن تَجتَنِبها كُنتَ سِلماً لِأَهلِها","وَإِن تَجتَذِبها نازَعَتكَ كِلابُها",0,"ب",3,0],["فَإِن تَجَمَّعَ أَوتادٌ وَأَعمِدَةٌ","لِمَعشَرٍ بَلغوا الأَمرَ الَّذي كادوا",1,"د",3,0],["فَإِنْ تَجِدْ كَرَماً فِي غَيْرِ مَحْمَدَةٍ","فَقَدْ تَكُونُ أَدَاةُ المَوْتِ فِي الْكَرْمِ",2,"م",1,0],["فَإِن تَجمَعِ الآفاتِ فَالبُخلُ شَرُّها","وَشَرٌّ مِنَ البُخلِ المَواعيدُ وَالمَطلُ",3,"ل",1,0],["فَإِن تَجزوا بِنِعمَتِنا شَكَرتُم","رِياحاً أَو فَوارِسَ ذي الخِمارِ",4,"ر",1,0],["فانتجعنا به الحيا غيرَ ذي الإقْ","لاعِ والبحرَ غيرَ ذي التنضيبِ",5,"ب",1,0],["فَإِن تَجِدنا حَولَها عُكَّفاً","فَالمَنهَلُ العَذبُ كَثيرُ الزِحام",6,"م",1,0],["فَإِن تَجحَدوهُ أَنعُماً بَعدَ أَنعُمٍ","مُرَدَّدَةٍ فيكُم فَهُنَّ شَواهِدُه",7,"د",2,0],["فَإِن تَجزِني مِنهُم فَإِنَّكَ قادِرٌ","تَجُزُّ كَما شِئتَ العِبادَ وَتَزرَعُ",8,"ع",1,0],["فَأَنتَجتُ مِن فِكري لَهُ كُلَّ كاعِبٍ","يُزَيِّنُ عِطفَيها البَديعُ المُنَقَّحُ",9,"ح",1,0],["فإن تجب القفار عليه يوماً","تردُّ له سوافيها السؤالا",10,"ل",2,0],["فَإِنْ تَجْزَعْ فَمِنْ خَوَرٍ وَجُبْنٍ","وَإِنْ تَصْبِرْ فَمِنْ ضَعَةٍ وَلُؤْمِ",11,"م",1,0],["فإنْ تجاوروا بمنظومٍ تدعْهُ سُدى","وإنْ تباروا بمنثورٍ تذرْهُ هَبَا",12,"ب",2,0],["فَاِنتَجَعنا الحارِثَ الأَعرَجَ في","جَحفَلٍ كَاللَيلِ خَطّارِ العَوالي",13,"ل",2,0],["فإن تجشبا أجتسب وإن تتنخّلا","وإن كنت أفتى منكما أتنخل",14,"ل",1,0],["فإنْ تَجِدِ الدّيَار كما أراد ال","غَريبُ فما الصّديقُ كما أرادا",15,"د",2,0],["فإن تجد عيبا فكن عين الرضى","أو مرّ مر الكرماء معرضا",16,"ض",2,0],["فَاِنتَجَعَ الظَمآنُ غَيثَ البِلى","وَإِنَّما يَنتَجِعُ القحطا",17,"ط",2,0],["فأنت جحيمي في الحياة وجنتي","وأنت عدوي والحبيب المؤازر",18,"ر",1,0],["فَإِن تَجفُني فَالبَحرُ عِندي كَثيرَةٌ","مَراكِبُهُ وَالبَرُّ عِندي رَكائِبُهْ",19,"ب",2,0],["فَإِن تَجمع شَتيتَ الشَّملِ مِنّا","وَفي الأَيّامِ جورٌ وَاِقتِصادُ",20,"د",1,0],["فَإِن تَجعَلِ النَعماءَ مِنكَ تِمامَةً","وَنُعماكَ نُعمى لا تَزالُ تَفيضُ",21,"ض",1,0],["فان تجرعتَ من أحداثه غصصا","فاصبر وقبلك في الأحداث يعتبر",22,"ر",1,0],["فانتَجَعوا العِزَّ في ذُرا مَلِكٍ","عافوه في جّنّةٍ تَبَوَّؤها",23,"ا",3,0],["فإن تجهل مباديها","فلم تجهل تناهيها",24,"ي",3,0],["فإن تجهل فلا تجهل","رسوم الدار والأحيا",25,"ي",2,0],["فإن تجمع الأيام بيني وبينكم","فذاك الذي أرجو وإن غيبت في القبر",26,"ر",1,0],["فأنت جمال العام والدهر كله","وأنت إمام العصر الحل والعقد",27,"د",1,0],["فَأَنْتَ جَزَاءُ صَوْمِنا وَصَلاتِنا","وَفِيكَ رَأَيْنا مَا ابْتَغَيْنَا مِنَ الأَجْرِ",28,"ر",1,0],["فأنت جدير بالنفيس من الثَنا","فكم قد ثنى روض عَلى صيب الودق",29,"ق",1,0],["فإن تجهلوني فالقنا ومجاشعٌ","وعزمي وحزمي والعلى واحتلالُها",30,"ل",3,0],["فإن تجد لي فمحقوق بذاك وإن","تبخل علي فلا لوم ولا حرج",31,"ج",1,0],["فإِن تجدني كما جرّبتَ ذا لَسَنٍ","فإِنَّ مدْحَك موقوفٌ على لَسَني",32,"ن",2,0],["فَإِنْ تَجلَّتْ غُمَمٌ رُكَّدٌ","تَركنني وَعْراً على وَعْرِ",33,"ر",1,0],["فَإِن تَجمّل قومٌ في وزارتهمْ","فَاِجَّمَّلتْ فيك أدراعُ الوزاراتِ",34,"ت",1,0],["فَإِن تَجمُد دُموعُ لَئيمِ قَومٍ","فَلَيسَ لِدَمعِ ذي حَسَبٍ جُمودُ",35,"د",1,0],["فان تجوهرت فاشطح فالسكون هنا","لاينبغي إِنما السكران من شطحا",36,"ح",2,0],["فإن تجمَعِ الأيّامُ شَملي بأحمَدٍ","فإنَّ لها عِندي يَداً لا أُضيعُها",37,"ع",3,0],["فأنت جمع المثاني السبع خاتمها","وفاتح سر ما أملت لنا الملل",38,"ل",1,0],["فان تجلَّى له نُورُ الصبابة لم","يَعُد يرى البؤس همَّا والضنى سقَما",39,"م",2,0],["فأنتج عن الخير خيرا أجل","وأما عن الشر شرا فلا",40,"ل",2,0],["فَإِن تَجزَع عَلَيهِ بَنو أَبيهِ","لَقَضدَ فَجِعوا وَفاتَهُم خَليلُ",41,"ل",1,0],["فإن تجد يدي على ترائبي","فلا تقل لغيبة الفؤاد",42,"د",1,0],["فإن تجيزوا الفحص عَن حال البلد","وَما من الشدة وَالضيق وجد",43,"د",1,0],["فَإِن تَجَردَت قم وَخُذها","وَلا يَقال الكِرامُ مانوا",44,"ن",3,0],["فإن تجاورْهمُ جا","وروك ظلما وجاروا",45,"ر",3,0],["فإن تجودوا عليه فهْو فتًى","له وقوفٌ على جداركم",46,"م",1,0],["فإن تجدْه نقيا ما به دنس","فاصحبْه فهْو الصديقُ الصادقُ الجازى",47,"ز",2,0],["فإنْ تجانبهم أصبحتَ مُغْتَنِما","وإنْ تُعَوِّلْ عليهم عشتَ مُفْتقرا",48,"ر",2,0],["فأَنْتَ جوادٌ لا يشُقُّ غبارَه","سوى نجلِكَ المنصورِ قُدِّسَ مِنْ نَجْلِ",49,"ل",1,0],["فأنت جنّة حسن","قد حزت روضاً أثيثا",50,"ث",2,0],["فأنت جدير بالإغاثة سيدي","قدير حرىٌ بالإعاثة والنصر",51,"ر",1,0],["فان تجد مركبا ولم يكن","مرجعه لاصله فما حسن",52,"ن",1,0],["فأنت جميل البر متسع العطا","حميد مجيد لا تضيق بخلتي",53,"ي",1,0],["فأنت جدير تمّ خمس بزورة","تداوى مهيض القرح من أم سالم",54,"م",1,0],["فَأَنتَ جَمالٌ كُنتَ في صَدرِ مَجلِسٍ","لَدى السَلمِ أَو في صَدرِ جَيشٍ عَرَمرَمِ",55,"م",1,0],["ف