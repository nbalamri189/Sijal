{"poems":[[37,"ولقد لقيت على الدريجة ليلة","https://www.aldiwan.net/poem39168.html","الكامل"],[87,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[83,"وألمى بقلبي منه جمر مؤجج","https://www.aldiwan.net/poem61532.html","الطويل"],[48,"أنا بالليالي والحواده أخبر","https://www.aldiwan.net/poem22560.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[96,"دمعة على الشاعر عبد الحميد الرافعي","https://www.poetsgate.com/ViewPoem.aspx?id=13792",""],[119,"عقولنا وسعت كل الشؤن بها","https://www.aldiwan.net/poem41214.html","عموديه"],[119,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[136,"سرى الطيف من لبنى فهاج الضنى وهنا","https://www.aldiwan.net/poem54730.html","الطويل"],[136,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2408","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38384","السلسلة"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38116","المجتث"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59589","الكامل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177919","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78166","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11892","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132281","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27827","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[3178,"","https://poetry.dctabudhabi.ae/diwan/poem/144551","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97958","الطويل"],[3322,"","https://poetry.dctabudhabi.ae/diwan/poem/142925","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138622",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216814","البسيط"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90816","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83537","الخفيف"],[4778,"الحي أكرم منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=204702",""],[4797,"حن جنودش ياقطر لاجى الصحيح","https://www.poetsgate.com/ViewPoem.aspx?id=132243",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[5186,"حي المشيد للعمران تكريما","https://www.poetsgate.com/ViewPoem.aspx?id=156456",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5526,"دومة الجندل","https://www.poetsgate.com/ViewPoem.aspx?id=207021",""],[5691,"شآم العزة...","https://www.poetsgate.com/ViewPoem.aspx?id=206441",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["وَالمَيتُ يُنشَرُ أَن تَمَسَّ عِظامَهُ","مَسًّا وَيَخلُدُ أَن يِرَاكِ خُلودا",0,"د",2,0],["والميت أقرب سلوة من غائبٍ","يرجى فلا يزداد غير بِعاد",1,"د",1,0],["والميِّتينَ وقد هيضت ضمائرهُم","بواخزٍ معهم في القبر مدفون",2,"ن",1,0],["وَأَلمى بِقَلبي مِنهُ جَمرٌ مُؤَجَّجٌ","أَراهُ عَلى خَدَّيهِ يَندى وَيَبرُدُ",3,"د",1,1],["وَالمَينُ أَغلَبُ في المَعاشِرِ كَم أَخٍ","لِلدَفرِ وَهوَ إِذا يُسَمّى العَنبَرُ",4,"ر",1,0],["والمَيادِينُ كُلُّها أُمَمٌ تُزْ","جَى كما تُكْدَسُ السّحائبُ رُبْدَا",5,"د",2,0],["والميامين آل جفنة والتّاج","عليهم أبوّتي وجدودي",6,"د",2,0],["والميل في الطبع شيء يستحث به","ركون قلب الفتى أو الحمة النسب",7,"ب",1,0],["والميت احياه الاله تكرما","بدعائه وتواتر الانباء",8,"ا",2,0],["وألمَى شَتِيتًَ النَّبتِ عَذباً مُؤَشَّراً","كَنورِ أقَاحِى الرَّوضِ مُطلُولَةٍ حُسنَا",9,"ن",2,0],["وألمَى كَالسَّدُوسِ وكَالأقَاحِى","تَبَطَّنَتِ الأجارِعَ والسُّيُولا",10,"ل",2,0],["وألميّ وكحّال","ومن يلعب بالقرد",11,"د",1,0],["والميم مع ثلاثة أصول","يزاد أوّلاً على المنقول",12,"ل",1,0],["وَالمِئَةَ المُصطَفاةَ يَحفِزُها ال","راعي وَبِالفَحلِ وَسطَها السَدِمِ",13,"م",1,0],["وَالمَيل عَن سِنَن الصلاة وَفَرضها","وَالحَج عِندَ تَطوّع برضاء",14,"ا",2,0],["وَالميس سِنان لَهُ بِلينَة عطفٍ","في طَعنِ فُؤادي قَسا قَساوةَ ضرّاب",15,"ب",1,0],["وَالمِيلُ يَقطَعُهُ في","عامَينِ مُتّصِلَينِ",16,"ن",1,0],["والميم لم تُفتح فصارت أدُمعاً","تنهلُّ من عين المُشوق المكمد",17,"د",1,0],["والميم: فوها فالحروف تألفت","مكتوبة والصبر عنها يكشطُ",18,"ط",1,0],["والميل للأقهار والأرغام","مع كلما يفضي إلى استغنامِ",19,"م",1,0],["والميم إذما وخلا حاشا بها","ما وعدا والوجه من أبوابها",20,"ه",2,0],["والميمُ والواو كرأس الفاءِ","والنونُ مبسوطا كرأس الراءِ",21,"ا",2,0],["والميمُ من رأس لواوٍ رُكِّبَت","لآخر الباءِ التي تقدَّمَت",21,"ت",1,0],["والميمُ في إفرادها مُعَلّقه","رأسٌ على راءٍ مَضَت مُعَلّقه",21,"ه",1,0],["والميم في التفريع كالثلث وفي","مسبلة لفٌّ بتدوير يفي",21,"ي",1,0],["والميم ضربان افردن وركبِ","فابدأ بما افردته ورتب",21,"ب",1,0],["والميم لا تفتح الا ما ندر","ورأسُهُ كالواو منه تعتبر",21,"ر",1,0],["والميم في الرحمن والرحيم","يلفّ أو لوّز بطمس الميم",21,"م",1,0],["وَالمَيت مَن لا جاه يُرجى لَهُ","في الحَي لا المَيت الَّذي يُقبَرُ",22,"ر",1,0],["وأَلمّي كخيالٍ سَلّما","هوَّم الركبُ فحيّا مضجِعي",23,"ي",1,0],["وَأَلمى كَمِثلِ البَدرِ تَبدو جُيوبُهُ","عَلى مِثلِ خوطِ البانَةِ المَتَأَوِّدِ",24,"د",1,0],["وألمي ثغره مثل الأقاحي","يزينه إذا افترّ ابتسام",25,"م",1,0],["والميم يروي به من كان ذا عطشٍ","من العلومِ بهذا القدر قد فخرا",26,"ر",2,0],["والميخُ والجاهُ وقُطبُ الجاهِ","والفرقدانِ فَردُ حَرفٍ زاهي",27,"ي",1,0],["والميخُ والجاهُ وذا القطبُ أَلِف","مُعتَدِلٌ مقوَّمٌ لَم يَنحَرِف",27,"ف",1,0],["والميخُ فوقَ الجاهِ لا يزول","كلاهُمَا يستقبلُ النزول",27,"ل",1,0],["وألمى عليهِ لُعسَةٌ زِينَ حُسنُها","بأبيضَ معسولِ الرُّضابِ شَتيت",28,"ت",1,0],["والم يكن للشعب من مجد أمسه","دعاء لعود المجد فليحرم الرزقا",29,"ق",2,0],["والمَيْنُ مَنْقَصةٌ تَشينُ وإنها","لنتيجةُ الوَهِنِ المَهينِ الهَيِّن",30,"ن",1,0],["وَالمِيمُ أولَى مِن سِوَاهُ بِالبَقَا","وَالهَمزُ وَاليَا مِثلُهُ إن سَبَقَا",31,"ق",2,0],["والميتون إذا تشيع فالورى","هذا وذاك مكبر ومهلل",32,"ل",1,0],["والميت قد ينفع الأحياء ما عمروا","وليس ينفعه الأحياء في الرجم",33,"م",1,0],["والميم والطاء من لفظ المحيط كما","أدخلتهم جيب طه مظهرِ المدد",34,"د",1,0],["والميت حي لم يمت ما دام في ال","دنيا عليه ترحم الأحياء",35,"ا",2,0],["وَالمَيامينُ آلهُ خيرُ آلٍ","وَكِرامٌ في الناسِ خيرُ كِرامِ",36,"م",1,0],["والميت يذهب من دنيا لضرتها","دستورها، الجاه عند الله للأتقى",37,"ق",2,0],["والمين وحن هل امات الظبيح","حضرنا والبدو فاللازم ولم",38,"م",1,0],["والمياه الملح فيها وافرٌ","والكلي تشكو وشدقي يتفل",39,"ل",1,0],["والمين أصبح محمودا بساحتهم","، حتى على ربهم، والصدق مذموما",40,"م",2,0],["والميم عند الواو والفاء مظهرٌ","هُمْ في وعند الواو في وِلدانِ",41,"ن",1,0],["والمئذنه تروي مآتم وأعياد","ورجال عاشوا في حياة الكسافه",42,"ف",2,0],["والميم منزل عزّ قد سما كرماً","فوق النجوم ولم يُبلَغْ له طولُ",43,"ل",1,0],["وَإِلَّم يَكُنْ لِلشِّعرِ دَورٌ بِنَهضَةٍ","( فَلَيسَ جَدِيرًا أَن يُقالَ لَهُ : \" شِعرُ \" )",44,"ر",1,0],["وَالميركة مثل الوسادة محررة","وَعهونها تلعب أَشكال أَلوان",45,"ن",1,0],["وَالميركة من شال ترمه مكلفة","وَمطوراً بريش النَعام طوار",46,"ر",1,0],["وَالميركة مثل الوسادة مشربشة","وَبِالريش من شان الغَواطورونها",47,"ن",3,0],["وَالميركة مثل الوسادة مُطورة","بِالريش من فَوق السَفايف زَهالها",48,"ل",3,0],["وَالميركة مثل الوسادة مصنعة","وَما هودها من خاص ترمي شال",49,"ل",1,0]]}