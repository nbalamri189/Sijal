9379",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[6070,"قدْ أقبَلَ الصُّبحُ بالأضواءِ والفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=197530",""],[4442,"ما بال جفنك لا يدر","https://www.poetsgate.com/ViewPoem.aspx?id=171226",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["قد أقْلَقوا كلَّ مَشْحوذِ الغِرارِ الى","شَنِّ الغِوارِ وسَلّوا كلَّ ذي مَيَدِ",0,"د",1,0],["قَد أَقسَموا لِلطِبِّ أَن يَسموا بِهِ","فَوقَ السِماكِ فَبَرَّتِ الأَقسامُ",1,"م",1,0],["قَد أَقسَمَ البيضُ بِصُلبانِهِم","لا يَهجُرونَ المَوتَ أَو يُنصَروا",2,"ر",3,0],["قَد أَقطَعُ الخَرقَ بِالخَرقاءِ لاهِيَةً","كَأَنَّما آلُها في الآلِ إِزميمُ",3,"م",1,1],["قد أقسمَ الجودُ لا ينفكُّ عن يدِه","إمَّا لعافيهِ أو للنسرِ والذيب",4,"ب",1,0],["قد أقسمت أحشاي لا تدع الأسى","كأناملِ المنصور لا تدع الندى",5,"د",2,0],["قد أقاموا نفوسَهم لذوي المدْ","حِ مُقامَ الأندادِ والنظراءِ",6,"ا",2,0],["قد أقال الإله بالرغم من أن","فك من لم يزل يقيل وأبقى",7,"ق",2,0],["قَد أَقسَمَ المَجدُ حَقّاً لا يُحالِفُهُم","حَتّى يُحالِفَ بَطنَ الراحَةِ الشَعَرُ",8,"ر",1,0],["قَد أَقسَموا أَنَّهُم لا يُشرِكونَ بِهِ","بِئسَ الإِلَهُ وَبِئسَ القَومُ وَالقَسَمُ",9,"م",1,0],["قَد أَقامَت وَعُدَّ ما","شِئتَ في قَعرِ مَخزَنِ",10,"ن",1,0],["قَد أَقحَمَتني مِنهُ مِثلُها","يُضَيِّق القَولَ عَلى القائِل",11,"ل",1,0],["قد أقبل التاريخ في محرابه","بجزى الرجال وينطق الأحكاما",12,"م",2,0],["قد اقتسموا ممالكه فكانت","لهم وطنا من الفصحى مشاعا",13,"ع",2,0],["قَد أَقاموا قُدوَةً صالِحَةً","وَمَضَوا أَمثِلَةً لِلمُحتَذين",14,"ن",1,0],["قَد أَقذِفُ العيسَ في لَيلِ كَأَنَّ لَهُ","وَشياً مِنَ النورِ أَو أَرضاً مِنَ العُشُبِ",15,"ب",1,0],["قَدِ اِقتَسَمَت عَيناكِ يَومَ لَقيتِنا","حُشاشَةَ نَفسٍ ما يَحِلُّ اِقتِسامُها",16,"م",3,0],["قَد أَقعَدَتني عَنكُمُ مَفاصِلٌ","وَإِن أَقامَت في اِنقِطاعي عُذري",17,"ي",1,1],["قَد أَقسَمَ الدَهرُ أَنَّ العَينَ ما نَظَرَت","سِواهُمُ مِن جَميعِ الناسِ إِنسانا",18,"ن",2,0],["قد أقبل السبت بأنواره","يهدي التقى بالأمن والسبت",19,"ت",1,1],["قد أقبل الليل فحيّ الجلد","في رجل يدأبُ منذ الصباح",20,"ح",1,0],["قَد أَقبَلَت وَهيَ في فَخرٍ وَفي جَذَلٍ","وَأَدبَرَت وَهيَ في خِزيٍ وَفي سَدَمِ",21,"م",1,0],["قَد أَقبَلَت تَعذُلُني باطِلاً","وَاِنصَرَفَت عَن وَجهِ حَقٍّ مُبين",22,"ن",1,0],["قَد أَقطَعُ السَبروتَ يَملَأُ بِال","آلِ المُروتَ فَيَشحُبُ السَبرُ",23,"ر",1,0],["قد أقَرّ الطّبيبُ عَنْكَ بِعَجْزٍ","وتَقَضّى تَرَدّدُ العُوّادِ",24,"د",1,0],["قد أقاموا على الجحيم صراطاً","عرضه شعرة فكيف العبور",25,"ر",1,1],["قد أقسمتْ لا ينال الدارَ مغتصبٌ","حتَّى وإنْ شرقتْ بالنار أعلامُ",26,"م",1,0],["قَد أُقيمَت مِنَ الجَمادِ وَلَكِن","مِن مَعاني الحَياةِ فيها سُطورُ",27,"ر",1,0],["قَد أَقولُ حينَ أَرى الن","نارَ في تَسَعُّرِها",28,"ر",3,0],["قد اقتَرَنَ اسمُك باسم القناةِ","وخلَّدَ ذكرَك هذا المَمَرّ",29,"ر",1,0],["قد أقمنا في كل صدرٍ لها حف","لاً، وفي كلِّ مهجة مِهْرجانا",30,"ن",2,0],["قد أقلعوا كل مشحوذ الغرار إلى","شن الغوار وسلوا كل ذي ميد",31,"د",1,0],["قد أقبل العامُ الجديد لذلك الوجه","السعيد بما يسرَ ويطربُ",32,"ب",1,0],["قد أقفر الدهر وما الضبا به","يصبر صبر الجرش من ضبابه",33,"ب",2,0],["قَد أَقرَحَ الدَمعُ عَينَيهِ وَقَد وَهَنَت","مِنهُ العِظامُ وَأَضحى الجِسمُ قَد نَحُفا",34,"ف",2,0],["قَدِ اِقتَبسوا مِن نورِ أحمد نورهم","فَبانَ لهُم ما في شَريعتهِ أجرى",35,"ر",2,0],["قد أقامَ الدليلَ فيهم كلام ال","لَهِ أَو لا فالصارمَ المشرفيّا",36,"ي",2,0],["قد أقفرت نفس على","أطلالها نعب الغراب",37,"ب",1,0],["قَد أَقَمنا عَلى الجَهالَة عَهداً","وَعلى الجَهلِ لا يُقيمُ البَصيرُ",38,"ر",1,0],["قَد أَقامَ الثَلجُ فيها","شَتوَةً مِن بَعدِ شَتوَه",39,"و",2,0],["قَد أَقسَمَت لا اِهتَدى الخَيالُ إِلى","جَفني وَبَرَّت لَمياءُ في القَسَمِ",40,"م",1,0],["قَد أَقَرَّ المِلاحُ بِالفَضلِ طَوعاً","لَكَ وَالحُسنُ شاهِدٌ وَالجَمالُ",41,"ل",1,0],["قَد أَقلَعَت فَاِصفَحوا عَن جُرمِها الغَيرُ","وَقَد أَتَتكُم صُروفُ الدَهرِ تَعتَذِرُ",42,"ر",1,1],["قَدْ أَقْبَلَ الأُنْسُ وَفَرًّ الأَسَى","وَأَدْبَرَ النَّحْسُ وَجَاءَ النَّجَاحْ",43,"ح",1,0],["قَدْ أَقَامَ لِكَوْنِكُمْ فِيهِ عُرْساً","فَتَحَلَّتْ بِثََلْجِهِ أَطْوَاقُهْ",44,"ق",2,0],["قَدِ اِقتادَ الغَرامُ بِهِ عِناني","كَما اِقتادَت عِنانُ أَبا نُواسِ",45,"س",1,0],["قد أَقفرَت تلك الربوعُ وفُرِّقَت","تلك الجموعُ فلا البهيُّ ولا البَها",46,"ه",2,0],["قد أقرّت شفاههُ عند نطقٍ","أَنّ في فيهِ خمرةً فهيَ خَجلى",47,"ل",2,0],["قَد أقيموا في حالِ صبرٍ وشكرٍ","موقف الإتّباع للآدابِ",48,"ب",1,0],["قَدْ أَقْسَمَتْ أَكُوَارُها وَسُرُوجُها","لا سَارَ في ظَهْرٍ بِمثْلِكَ عُودُ",49,"د",1,0],["قد أقبل يَطلُبُ قادِمُه","عَهْداً بنَداكَ يُجَدَده",50,"د",2,0],["قد أقفرت مني الطلول وحقكم","ما أقفرت مني رُباً وطلول",51,"ل",1,0],["قَد أَقبَلَت تَفتَرّ عَن حَبب الثَنا","تَزري بِما تُبديهِ وَقع الأَنجُمِ",52,"م",1,0],["قَد أَقامَ الحُدود لِلعَدل هَدياً","وَنَفى النَحس أَسعَد الوُزراءِ",53,"ا",2,0],["قد اقْتَدى بالمُزْنِ في جُودِه","بل بِنداهُ يَقتدي المُزنُ",54,"ن",1,0],["قد أقَرَّتْ واستقرَّت عندما","زجرت طائرك الميمون سعدا",55,"د",2,0],["قد أقبلَت شمسُ النهارِ بجُملةٍ","خضراً وفي أسرارِها أسرارُ",56,"ر",1,0],["قد أَقسم الحمدُ لا يسيرُ إِلى","غيرِ أَبى القاسِمِ بن حَمُّودِ",57,"د",1,0],["قد أَقْفَرُوا وَطَنَ الأَنيسِ وأُنِّسَتْ","بِهِمُ مفاوِزُ بالفَلا وقِفارُ",58,"ر",1,0],["قد اقترفت ذنوباً لا تقاس بها","أجا وسلمى ولا رضوى بأهضبها",59,"ه",2,0],["قد أقسموا أن يصونوا مصر عن سفه","ويبلغوها مكانا فوق كيوان",60,"ن",1,0],["قد أقحط الوادي فلا لابنٌ","لطارقِ الحيّ ولا تامرُ",61,"ر",1,0],["قد اقتسمنا زيَّاً ومعرفةً","فالعلمُ عندي والزيُّ عندهم",62,"م",1,0],["قَد أَقبَلَ النَبتُ بِاَسماطِهِ","مِن مِمطَرٍ مِنهُ وَمِن بَرَّكان",63,"ن",1,1],["قد اقترفوا فعل المساخيط إذ جفوا","وحادوا عن الغرا بفعل الرذائل",64,"ل",1,0],["قد أَقامَ الحُدودَ عدلاً ووَفَّى","بوَفاءِ العُهودِ شأْنَ الوَفِيِّ",65,"ي",1,0],["قَد أقَمنَا بِمَكَّةٍ واجتَمَعنَا","بعدُ فِي مَسجدِ النَّبِيِّ الأمِينِ",66,"ن",1,0],["قَد أَقصَدَت فُؤادي","خُمصانَةٌ خَريدُ",67,"د",1,0],["قد أقفرت وخلت منه الربوع فيا","للعلم فابكوا دماً بل اخضلوا ديما",68,"م",2,0],["قد اقتناها الذي غالي بقيمتها","لما أقام لها وزنا وما اسفا",69,"ف",2,0],["قَد أَقبَلَ الزَمَنُ الَّذي أَبناؤُهُ","لا يَحمِلونَ سَلاسِلاً وَقُيودا",70,"د",2,0],["قَد أَقطَعُ الأَوطانُ كُلَّ عَنائِهِ","وَأَحَلَّ خِدمَتِها صَميمَ شَفافِهِ",71,"ف",2,0],["قد أقامت هذي الشبيبة حفلاً","لفقيدٍ مَضى لتكسبَ أَجرا",72,"ر",2,0],["قد أقروا بساحهن شقيقي","مذا غدا لا يرى الفضاء فضاءا",73,"ا",3,0],["قد أَقمت الفعل الجَميل مع الناس","مقام الارواح في الاجسام",74,"م",1,0],["قد اقتدوا برسول الله سيدنا","محمدٍ ذي السنا الأبهى من الفلق",75,"ق",1,0],["قَد أقسم الدَّهر أيْماناً مُغَلَّظَةً","أنْ لَيْسَ يُنجِحُ حِرْصاً فاسْعَ أو فَدَعِ",76,"ع",1,0],["قد أَقْرَحَتْ بما تَئِنُّ كَبِدي","إنّ الحزين يَرْحَمُ الحزينا",77,"ن",2,0],["قد أقام حُسنَ شكلي","المقام اليوسفيُّ",78,"ي",1,0],["قد أقلت صيداً تظل قلوب ال","صيد منها خوافقاً إشفاقا",79,"ق",2,0],["قَد أَقبَلَ ألمَنثُورُ يا سَيِّدي","كالدُّرِّ واليَاقُوت في نَظمِهِ",80,"ه",1,1],["قَد أَقسمت يَوم جَرى قارها","لا اقتضها إِلا ندامى كرام",81,"م",1,0],["قد اقيما بعقر بيت علوم","طال فضلا شرافة وعمودا",82,"د",2,0],["قد أقبلت بالهايلا","ت المذهلات المرهبهْ",83,"ب",2,0],["قد اقسم الله تعالى بالقلم","واصلُ هذا الفخر من ذاك القسم",84,"م",1,0],["قد أقبلَ الصيفُ يحكي حَرَّ أنفاسِي","وفي فؤادي حَرٌّ ما لهُ آسي",85,"ي",1,1],["قد أقرَّ الإِله عينيك فيمن","كان في غرّة لعينيك نورا",86,"ر",2,0],["قد أقرَّ الله منكم أعيناً","كم لحظتم بالغِنى فيها عديما",87,"م",2,0],["قد أقبلت وطريقُ الحسنِ متّسعٌ","تضيقُ خُطواً وإن لم تَقترف جُرما",88,"م",2,0],["قد أقراً العيون منك بصنعٍ","عاد طرفُ الإسلامِ فيه قريرا",89,"ر",2,0],["قد أقضت من مضجعي في حياتي","وهي أدهى إذا امتطى التربَ جَنبي",90,"ب",2,0],["قد أقبل العيد المجيد مقدماً","لك حلة الإقبال والإجلال",91,"ل",1,0],["قد أقْفَرَتْ منكَ ميادينُنَا","فأصبَحَتْ غيرَ ميادين",92,"ن",1,0],["قَدِ اِقتَرَبَت لَو أَنَّ في قُربِ دارِها","نَوالاً وَلَكِن كَلُّ مَن ضَنَّ مانِعُ",93,"ع",1,0],["قَد أَقسَمَ اللَّهُ في الذِّكرِ الحَكيمِ بِهِ","فَقالَ وَالنَجمِ هَذا أَوفَرُ القَسَمِ",94,"م",1,0