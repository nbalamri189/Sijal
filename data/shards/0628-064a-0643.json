{"poems":[[113,"أميرنا لا برحت في رتب","https://www.aldiwan.net/poem16298.html","المنسرح"],[237,"ما لي إليك سوى النسيم رسول","https://www.aldiwan.net/poem14763.html","الكامل"],[308,"أنا مني كل نفس","https://www.aldiwan.net/poem57714.html","المجتث"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38521","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80192","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109261","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49571","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93918","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86285","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72706","البسيط"],[4755,"نَحنُ أَهدَافُ رَمْيِنَا.. والرُّمَاةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184090",""],[5277,"جرحُ فاطمة..رحمها الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=191249",""],[5277,"نابُ النوى","https://www.poetsgate.com/ViewPoem.aspx?id=191464",""],[5672,"مجمرة الوهن","https://www.poetsgate.com/ViewPoem.aspx?id=206449",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""]],"verses":[["بيكلر بيكيا سُموك مظلمة","وَأَنتَ بِالمَجد وَالعُلى مَلك",0,"ك",1,0],["بي كُلَّما حَدَّثتُ بِاِسمِكَ لَوعَةٌ","ما بَينَ أَحناءِ الضُلوعِ تَجولُ",1,"ل",1,0],["بي كل شمسٍ نضارٍ","فيها من الدر نجمُ",2,"م",1,0],["بي كَعبَةُ الحسنِ البَديعَةِ وَجهه","يَسعى لَها أَهلُ الغَرامِ مِنَ الوَرى",3,"ر",2,1],["بي كُنتِ لاهِيَةً وَكانَ الخَطبُ في","الآفاقِ يُلهي عَنكِ مِن رَقبوكِ",4,"ك",1,0],["بي كل شيءٍ قد سكن","خلا الطنين في الأُذُن",5,"ن",1,0],["بي كُلَّما نابَ خَطْبٌ أو نأَيَ سكنٌ","نَفْسٌ عزَوفٌ وأَنْف كله أَنَف",6,"ف",1,0],["بيك أمير لواء عز جانبه","لكنه سهلت منه الجبلات",7,"ت",1,0],["بيك همام فَلَو فَلو دامَت انصِفوهُ لما","يَموه جَهلاً بِبيك بَل بِسُلطان",8,"ن",1,0],["بي كاتب خطه المسودَّ نسخته","قد بيضت كل تسويد من اللمم",9,"م",1,1],["بي كَصَنعاءَ زَفرَةٌ حِينَ تُمسِي","والمَصَابيحُ بالدُّجَى مُفعَمَاتُ",10,"ت",1,0],["بي كل معنى يصوغ اللفظ قافية","فتستعين على التوصيف بالكلم",11,"م",1,0],["بي كلُّ معنىً لهذا الحزن أحملها","كالمثقلات نزلنَ العمرَ من قممِ",11,"م",1,0],["بي كل وجدٍ شاقهم لما غدوا","جرحَ الشغافِ وما لجرحيَ بلسما",12,"م",2,0],["بي كلُّ قافيةٍ قصائدُها","ترمي الفؤادَ بنافشِ العهنِ",13,"ن",1,0],["بي كلُّ ما تهبُ الطبيعةُ فانعمي","بمناخ أوديتي وطقس جبالي",14,"ل",2,0]]}