102063","الوافر"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116855","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114383","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133243","الوافر"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2560","الوافر"],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4927,"دَاْرُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=30192",""],[5512,"عجاف الدَّهر ( أنا الشَّام )","https://www.poetsgate.com/ViewPoem.aspx?id=204281",""]],"verses":[["بِمُخطَفَةِ الأَرجاءِ أَزرى بِنَيِّها","جِذابُ السُرى بِالقَومِ وَالطَيرُ هُجَّعُ",0,"ع",1,0],["بِمُختَلَفِ الأَرواحِ بَينَ سُوَيقَةٍ","وَأَحدَبَ كادَت بَعدَ عَهدِكِ تَخلُقُ",1,"ق",1,0],["بِمُختَلِفِ الأَصواتِ تَسمَعُ وَسطَهُ","كَرِزِّ القَطا لا يَفقَهُ الصَوتَ قائِلُه",2,"ل",2,0],["بِمُختَلِفِ الألفاظِ والقصدُ واحِدٌ","كَمُختَلِفِ الأَنفاسِ مِن أرَجِ الزَّهرِ",3,"ر",1,0],["بِمُختَبِلٍ ساجٍ مِنَ الطَرفِ أَحوَرٍ","وَمُقتَبِلٍ صافٍ مِنَ الثَغرِ أَشنَبِ",4,"ب",1,0],["بِمُخضَلَّةٍ جادَ الرَبيعُ زُهائَها","رَهائِمَ وَسمِيٍّ سَحائِبُهُ غُزرُ",5,"ر",1,0],["بِمُخَنَّثٍ ذي مَيعَةٍ","يَنزو أَمامَ الخَيلِ نَزوا",6,"و",2,0],["بِمُخطَفِ الأَيلُلِ في خَطمِهِ","طولٌ وَفي شِدقَيهِ تَأخيرُ",7,"ر",1,0],["بِمُخَضَّبٍ رَخصٍ كَأَنَّ بَنانَهُ","عَنَمٌ يَكادُ مِنَ اللَطافَةِ يُعقَدِ",8,"د",1,0],["بِمَخالِب مثل الخَناجِر جردت","من غلفها وَبمنسر مَفغور",9,"ر",1,0],["بِمُخْتَلَسٍ مِنْ نَوَاحِي الحُتُو","فِ تُرْمَى الرِّجَالُ بِهِ عَنْ شَزَنْ",10,"ن",1,0],["بمخُزْنَ باسم الله موجَ خُضَارةٍ","واسمِ الهدى ومبادئِ الإسلام",11,"م",1,0],["بمُخَضَّبٍ رَخْصٍ، كأنّ بنانَهُ","عنم على اغصانه لم يعقدِ",12,"د",1,0],["بِمُخْضَلَّة ٍ جادَ الرَّبِيعُ زُهَاءَهَا","رهائم وسمي سحائبه غزر",13,"ر",1,0],["بمخمَلةٍ خَضراءَ بعتُ سعادتي","ونمتُ على سوداءَ لهفانَ مُبعَدا",14,"د",2,0],["بِمُخطَفِ الخَصرِ مَهزوزِ المَعاطِفِ مَع","سولِ المَراشِفِ نَفّاعٌ وَضَرّارُ",15,"ر",1,0],["بمخطف الكشحِ مجدول الشوى غَنِج","مُنَعْس الطَّرفِ معسول اللَّمى عَبق",16,"ق",1,0],["بمخضرَّةٍ والنارُ حول شفارها","تجول كجري الماء في الغصن النضر",17,"ر",1,0],["بمختلفٍ لأبكارِ ال","سحائب أيِّ مختلف",18,"ف",1,0],["بمخلوقِ الخلائقِ من سعودٍ","إذا خُلِقَ الخلائقُ من نُحوس",19,"س",1,0],["بمخنَّثِينَ مُصنَّعين كأنهمْ","لُعَبٌ بأيدي اللاعبات تُصَنَّع",20,"ع",1,0],["بمخضر الثرى ما اسود نقع","أعاد البيض حمرا كالعقيق",21,"ق",1,0],["بمخضّب رخص كأنّ بنانَه","عنمٌ على أغصانِهِ لم يقعدِ",22,"د",1,0],["بمخازِنٍ تَلقى الرُؤوسُ بِهِ الظَبيَ","فَتَخِرُّ ساجِدَةً لِهَيبَةِ أَحمَدِ",23,"د",1,0],["بمختار وخير الخلق برا","به فضلاً خلقت لكل شي",24,"ي",1,0],["بِمَخشُوبةٍ بيضٍ إذا ما تَناوَلَت","ذُرى البَيضِ أبدَت عن فِراخ الجَماجم",25,"م",1,0],["بمختصَرِ الحَبرِ ابن إسحاقَ قد غَذا","يُقَر‍ِّرُ أبحاثاً تجلُّ وَتُعتَما",26,"م",2,0],["بمختلف اللغات الكل يدعو","وثوب الإنكسار لهم شعار",27,"ر",1,0],["بِمَخرَجِنا فَلا نَخفى عَلَيهِم","وَيَأتيهِم بِعَورَتِنا الدَليلُ",28,"ل",1,0],["بمختلف الأمر افتقرت وأكثروا","وعبس يذب الصم عن تامرٍ ولاَ",29,"ا",1,0],["بِمَخْدَعٍٍ مَاْ رَأَتْهُ الْعَاْذِلاْتُº وَلاْ","شَخْصٌ رَآهُ، بِهِ الأَمْثَاْلَ قَدْ ضَرَبُواْ",30,"ب",3,0],["بمخلبِ عُربِنا أُشْبِعْتُ قهراً","وغربٌ قد تمادى في دياري",31,"ر",2,0]]}