"الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91481","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91415","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91275","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92044","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119599","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130604","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33557","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72688","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72354","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120365","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120380","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139547",""],[4717,"أخت القمر","https://www.poetsgate.com/ViewPoem.aspx?id=199655",""],[4778,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188181",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[4858,"بوركتمُ , وجه الحضارة مشرقاً","https://www.poetsgate.com/ViewPoem.aspx?id=138294",""],[4858,"من وحي أدائي العمرة","https://www.poetsgate.com/ViewPoem.aspx?id=139900",""],[4984,"ذَاكَ الذِي يُضْنِيكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206418",""],[5057,"أرقّ قلوبا","https://www.poetsgate.com/ViewPoem.aspx?id=197518",""],[3591,"حاشا لهجرك أن يكون طوببلا","https://www.poetsgate.com/ViewPoem.aspx?id=149394",""],[5285,"لكِ ما أردتِ","https://www.poetsgate.com/ViewPoem.aspx?id=203190",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5324,"وجع العراق .","https://www.poetsgate.com/ViewPoem.aspx?id=207229",""],[5376,"بدرٌ أطاحَ بهيمَ ليلٍ ألْيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=202792",""],[5561,"حسٌّ وتراب","https://www.poetsgate.com/ViewPoem.aspx?id=197538",""],[5628,"البحث عن بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=191332",""],[5829,"العاشق الجسور","https://www.poetsgate.com/ViewPoem.aspx?id=215927",""],[5842,"إلى بشار الأسد بعد خطابه الثاني ( ثائر على الأسد )","https://www.poetsgate.com/ViewPoem.aspx?id=62445",""],[5910,"فلطالما حاربتُ ذا سفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207125",""],[6142,"ما نشا في السما ولا ساح في الأر","https://www.poetsgate.com/ViewPoem.aspx?id=155697",""],[6334,"سيد الأزمان !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82263&r=&rc=13",""]],"verses":[["فَلَطالَما أَقصَدنَني ظَبَياتُهُ","وَأَرِقتُ فيهِ لِبارِقٍ لَمّاحِ",0,"ح",1,0],["فَلَطالَما أَبدى الحَنينَ لِقِسِّهِ","وَاِهتَزَّ أَشواقاً إِلى سَحبانِهِ",1,"ن",2,0],["فَلَطَّمَت وَجهَها وَاِستَنبَهَت مَعَها","بَيضاءُ آنِسَةٌ مِن شَأنِها الخَفَرُ",2,"ر",1,0],["فَلَطالَما كُنّا نُريحُ بِظِلِّهِ","فَنُريحُ مِنهُ بِسَرحَةٍ غَنّاءِ",3,"ا",2,0],["فَلَطالَما كُنّا نَروقُ المُجتَلي","حُسناً وَنَملَأُ ناظِرَ العَلياءِ",3,"ا",2,0],["فلطالما مَلأُوا المياهَ مراكبًا","ولطالما مَلأوا السهول خيولا",4,"ل",2,0],["فلطالما نَشَر السلا","مَ، وباسمه جَرَت الدِّما",5,"م",2,0],["فلطالما دكّ القلاع بعزمه","ولطالما ردَّ الجيوش فُلولا",6,"ل",2,0],["فلطالما حابَيتُ غير مصارحٍ","ولطالما صارحتُ غير مُحابي",7,"ب",2,0],["فلطفها مذيب","وسرها فتان",8,"ن",1,0],["فَلَطالَما أَضرَمتَ في إِحرازِها","لَهَباً رُؤوسُ الدارِعينَ شَرارُهُ",9,"ر",2,0],["فَلطَهذَرِ الهِمَمُ المُذالَةُ في الثَرى","هِمَماً تَجُرُّ عَلى السَماءِ ذُيولا",10,"ل",2,0],["فَلَطالَما خاطَرتُ في حُبِّ الدُمى","وَخَطَرتُ في ثَوبِ الصِبا الفَضفاضِ",11,"ض",1,0],["فلطالما نوهت باسم خامل","ذكرا وخاملنا الذي لم يذكر",12,"ر",1,0],["فلطالما طار الذباب مع الهوى","ورقا وقد سكن التراب العسجد",13,"د",1,0],["فلطالما فيهِ ابتَسَمتِ وطالما","بلَّلتِ بالدّمعِ السخينِ جفونا",14,"ن",2,0],["فلطالما عذَّبتِني ومنعتني","فاستَغفري عن بخلِك الرحمانا",15,"ن",2,0],["فلطالما كَشَفَت مؤانسةٌ جوىً","وسَرى الضياءُ على الثَّرى بثراء",16,"ا",2,0],["فلَطالما من أينَ جِئْتُك راغباً","لاقَيْتُ تَطْويلي بفَضْلِ تَطَوُّل",17,"ل",1,0],["فَلطالما و