{"poems":[[53,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[85,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[31,"قل للمليحة قد أبلتني الذكر","https://www.aldiwan.net/poem42546.html","البسيط"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[113,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[141,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[141,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[233,"آنسن في الفودين وخط بياض","https://www.aldiwan.net/poem31901.html","الكامل"],[259,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[259,"حوشيت در مدامع لا تجمد","https://www.aldiwan.net/poem38336.html","الكامل"],[268,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[268,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[268,"هذا مليك القبة الزرقاء","https://www.aldiwan.net/poem35689.html","الكامل"],[362,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[362,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[369,"صبرا لما فعل الزمن","https://www.aldiwan.net/poem57011.html","مجزوء الكامل"],[369,"ما كان يدري كيف يصبح هاجرا","https://www.aldiwan.net/poem57466.html","البسيط"],[406,"إن يحسدوا في السلم من","https://www.aldiwan.net/poem32175.html","مجزوء الكامل"],[438,"أودع من لا أستطيع وداعه","https://www.aldiwan.net/poem14325.html","الطويل"],[438,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[462,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[462,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[477,"يا ابن الأمين وحسب بي","https://www.aldiwan.net/poem36981.html","مجزوء الكامل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"]],"verses":[["فَلَطالَما أَقصَدنَني ظَبَياتُهُ","وَأَرِقتُ فيهِ لِبارِقٍ لَمّاحِ",0,"ح",1,0],["فَلَطالَما أَبدى الحَنينَ لِقِسِّهِ","وَاِهتَزَّ أَشواقاً إِلى سَحبانِهِ",1,"ن",2,0],["فَلَطَّمَت وَجهَها وَاِستَنبَهَت مَعَها","بَيضاءُ آنِسَةٌ مِن شَأنِها الخَفَرُ",2,"ر",1,0],["فَلَطالَما كُنّا نُريحُ بِظِلِّهِ","فَنُريحُ مِنهُ بِسَرحَةٍ غَنّاءِ",3,"ا",2,0],["فَلَطالَما كُنّا نَروقُ المُجتَلي","حُسناً وَنَملَأُ ناظِرَ العَلياءِ",3,"ا",2,0],["فلطالما مَلأُوا المياهَ مراكبًا","ولطالما مَلأوا السهول خيولا",4,"ل",2,0],["فلطالما نَشَر السلا","مَ، وباسمه جَرَت الدِّما",5,"م",2,0],["فلطالما دكّ القلاع بعزمه","ولطالما ردَّ الجيوش فُلولا",6,"ل",2,0],["فلطالما حابَيتُ غير مصارحٍ","ولطالما صارحتُ غير مُحابي",7,"ب",2,0],["فلطفها مذيب","وسرها فتان",8,"ن",1,0],["فَلَطالَما أَضرَمتَ في إِحرازِها","لَهَباً رُؤوسُ الدارِعينَ شَرارُهُ",9,"ر",2,0],["فَلطَهذَرِ الهِمَمُ المُذالَةُ في الثَرى","هِمَماً تَجُرُّ عَلى السَماءِ ذُيولا",10,"ل",2,0],["فَلَطالَما خاطَرتُ في حُبِّ الدُمى","وَخَطَرتُ في ثَوبِ الصِبا الفَضفاضِ",11,"ض",1,0],["فلطالما نوهت باسم خامل","ذكرا وخاملنا الذي لم يذكر",12,"ر",1,0],["فلطالما طار الذباب مع الهوى","ورقا وقد سكن التراب العسجد",13,"د",1,0],["فلطالما فيهِ ابتَسَمتِ وطالما","بلَّلتِ بالدّمعِ السخينِ جفونا",14,"ن",2,0],["فلطالما عذَّبتِني ومنعتني","فاستَغفري عن بخلِك الرحمانا",15,"ن",2,0],["فلطالما كَشَفَت مؤانسةٌ جوىً","وسَرى الضياءُ على الثَّرى بثراء",16,"ا",2,0],["فلَطالما من أينَ جِئْتُك راغباً","لاقَيْتُ تَطْويلي بفَضْلِ تَطَوُّل",17,"ل",1,0],["فَلطالما والدّهرُ ذو دُوَلٍ","لِوَميضِ بَرْقِكَ بِتُّ أرتَفِق",18,"ق",1,0],["فلَطالَما استَخدمتَهُ","بينَ المَنايا والمِنَن",19,"ن",1,0],["فلَطالما كثُرت أقاويلُ الورى","فأتيتُ بالنَّزر القليلِ مُكاثِرا",20,"ر",2,0],["فلطالَما أقدمتُ إِقْ","دَامَ الحُتوفِ على الحُتوفِ",21,"ف",1,0],["فلطفاً بعبدٍ قد جنى فيك ما دجنى","ولاذ بباب العفو راجٍ وساعه",22,"ع",2,0],["فلطالما أَجريته وحررته","بمحامد الأَفعال والأَسماء",23,"ا",2,0],["فلطالما حقّقتَ قصدَ قصائدي","وسلبتَ بالإحسان عقل عقائلي",24,"ل",2,0],["فلطالما صقلت مهندة الظبى","فازداد رونق حسنها ومضائها",25,"ا",3,0],["فلطالما جنت به","وكفى الحبيب جنونها",26,"ن",3,0],["فلَطالما أعرضتُ عن وجه الهوى","وثنيتُ عن جهة الغواني كلْكَلي",27,"ل",2,0],["فَلَطالَما أَضحى رِدائي ساحباً","في ظلّك الوافي وعودِيَ أخضرا",28,"ر",2,0]]}