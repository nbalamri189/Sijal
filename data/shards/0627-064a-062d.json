{"poems":[[63,"وأشلاء دار بالحمى تلبس البلى","https://www.aldiwan.net/poem45691.html","الطويل"],[77,"أيحيى سقى حيث لحت الحيا","https://www.aldiwan.net/poem36062.html","المتقارب"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[73,"أنا ظرف للهو كل ظريف","https://www.aldiwan.net/poem11989.html","الخفيف"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[93,"يا أميراً دعا ومن لا يلبي","https://www.aldiwan.net/poem11287.html","الخفيف"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[88,"أدرنة مهلا فإن الظبى","https://www.aldiwan.net/poem44466.html","المتقارب"],[88,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[88,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[88,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[47,"أيحلو لمن لا صبر ينجده صبر","https://www.aldiwan.net/poem25288.html","الطويل"],[72,"أيا ملكا فاق الكرام وفاتهم","https://www.aldiwan.net/poem19212.html","الطويل"],[72,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[51,"أيا غرة العليا ويا عينها اليمنى","https://www.aldiwan.net/poem7987.html","الطويل"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"وهب خادما لم يوف نعماك شكرها","https://www.aldiwan.net/poem64062.html","الطويل"],[51,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[51,"أيحجبني عمرو وقد عاش حقبة","https://www.aldiwan.net/poem65971.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لعلي أبي الحسين سميي","https://www.aldiwan.net/poem66444.html","الخفيف"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[85,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"أي حسن للبدر غطى تلالي","https://www.aldiwan.net/poem62641.html","الخفيف"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[28,"لأدنو من أرض لأرضك إن دنت","https://www.aldiwan.net/poem5546.html","الطويل"],[58,"أيحسب أولاد الجهالة أننا","https://www.aldiwan.net/poem30995.html","الطويل"],[49,"هل على نفسه امرؤ محزون","https://www.aldiwan.net/poem63134.html","الخفيف"],[66,"عزمت يا متلفي على السفر","https://www.aldiwan.net/poem39640.html","المنسرح"],[97,"دع النفس تمرح في خيال وأوهام","https://www.aldiwan.net/poem24779.html","الطويل"],[44,"شد ما استنزلتك عن ربعك الأظ","https://www.aldiwan.net/poem30128.html","الخفيف"],[69,"ما شرت في المكتب صنفين من","https://www.aldiwan.net/poem28929.html","السريع"],[105,"مصر أنت الحياة والموت طرا","https://www.aldiwan.net/poem43126.html","الخفيف"],[105,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[102,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[52,"راض نفسي حتى ترضيت إبلي","https://www.aldiwan.net/poem26911.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"لمن صولجان فوق خدك عابث","https://www.aldiwan.net/poem69097.html","الطويل"],[50,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[50,"خليلي قوما فاعذرا أو تعتبا","https://www.aldiwan.net/poem64836.html","الطويل"],[46,"الخير كالعرفج الممطور ضرمه","https://www.aldiwan.net/poem22427.html","البسيط"],[76,"وا كبدا قد تقطعت كبدي","https://www.aldiwan.net/poem39438.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147491","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55084","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54662","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[106,"سلطان العاشقين أبو سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=179375",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[90,"صورة للخواطر!","https://www.poetsgate.com/ViewPoem.aspx?id=179131",""],[45,"لا يَرِمْ رَبْعَكَ السّحابُ يَجُودُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31418",""],[51,"ألا قُلْ لذي العَطَن الواسعِ","https://www.poetsgate.com/ViewPoem.aspx?id=29513",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"]],"verses":[["أيحسَبْنَ قَلبي خالياً من غَرامِها","وأَيُّ فؤادٍ من مَودَّتها خِلوُ",0,"و",1,0],["أَيَحْيَى سَقَى حَيْثُ لُحْتَ الْحَيَا","فَنِعْمَ الشِّعَابُ وَنِعْمَ الْوُكُونْ",1,"ن",1,1],["أَيَّ حينٍ وَقَد دَبَبتُ وَدَبَّت","وَلَبِسنا مِن بَعدِ دَهرٍ دُهورا",2,"ر",2,0],["أَيُحصي مَعانيكَ القَريضُ المُهَذَّبُ","عَلى أَنَّ صَدرَ الشِعرِ لِلمَدحِ أَرحَبُ",3,"ب",1,1],["أَيُّ حُسنٍ يَفي بِحُسنِيَ مَحمو","لاً بِكَفَّي وَصيفَةٍ أَو وَصيفِ",4,"ف",1,0],["أي حسنٍ في كل ما تقع العي","ن عليه من مونقات المجالي",5,"ل",2,0],["أيُّ حَفْلٍ بَدَا الصَّنِيعُ بِهِ","وَالوَفَاءُ البَدِيعُ فِي قَرَنِ",6,"ن",1,0],["أَيُّ حَفْلٍ فَخْمٍ تَوَسَّطَتْ فِيهِ","وَالسُّرَاةُ الشُّهُودُ عِقْدٌ نَظِيمُ",7,"م",1,0],["أَيُّ حُسْنٍ فِي وَجْهِ هَذَا الفَتَى المُشْ","رِقِ يَجْلُو لِلنَّاسِ بَدْراً تَمَامَا",8,"م",2,0],["أيَحُسن يا قوم أن نقعدا","وقد آن أن ينهض القاعدون",9,"ن",1,0],["أيُحجم عنا هارباً بعُلوجه","ويبغي بقتل الأبرياء له فخرا",10,"ر",2,0],["أيَحسُن اللحن إذ آباؤكم فصحُوا","أم يحسن العجز إذ آباءكم نشِطوا",11,"ط",3,0],["أيّ حرّ في الشرق عاش سعيداً","لم تشُب صفو عيشه الأقذاء",12,"ا",2,0],["أَيَحلو لِمَن لا صَبرَ يُنجِدُهُ صَبرُ","إِذا ما اِنقَضى فِكرٌ أَلَمَّ بِهِ فِكرُ",13,"ر",1,1],["أيحسن بعدِي عن بلادك بعد ما","عرفت بقولٍ في صفاتك بارع",14,"ع",1,0],["أيّ حرّ لو لم تفضّل ذووه","لكفتْه في الفضل نفس عصامهْ",15,"م",2,0],["أيحجبُ عني عِشرةً قد ومِقْتُها","فشوقي إليها شوق قيس إلى لُبْنى",16,"ن",2,0],["أيحيى العلا لهفي لذكراك لهفةً","يباشر مَكْواها الفؤادَ فيَنْضجُ",17,"ج",1,0],["أيُّ حِرْز فيه من الطَّيْر أنْ لَوْ","جعلُوه فزَّاعةً في قَرَاحِ",18,"ح",1,0],["أيحجبني عمرٌو فلا يُحْجَب الحيا","ولا ترتمي الآفاق بالجمر والصخر",19,"ر",1,0],["أيحسُن أن جَرَّ العيالَ رجاؤكم","وخاس نداكم وهْو خير خفير",20,"ر",1,0],["أيحسن رفعي بكم صرختي","ألا هل عن الظلم من رادع",21,"ع",1,0],["أيحجبني عمرٌو وقدْ عاشَ حقبةً","حبيبتُه خُفٌّ ومركبُه نَعْلُ",22,"ل",1,1],["أيُّ حقٍّ لها فيرعاه راعٍ","من نوالٍ لأهلِها ووصالِ",23,"ل",1,0],["أيّ حين أتاهُ طالبُ جدوا","هُ أتاه في حينه وأوانِهِ",24,"ن",2,0],["أَيَحوكُ مِثلَ العَنكَبوتِ بُيوتَهُ","حَوكاً وَيَبني كَالنُسورِ وُكورا",25,"ر",2,0],["أيحيا أمرؤ في القبر ميتاً وإنما","يموت الذي يحيا إذا سكن القبرا",26,"ر",2,0],["أى حي سواك يوم تولى","خدّدته نجابة الأولاد",27,"د",1,0],["أَيَحمِلُني عُمراً وَيَحمي شَبيبَتي","وَأَخذُلُهُ في وَهنِهِ وَأُخَيِّبُ",28,"ب",1,0],["أَيُّ حُسنٍ لِلبَدرِ غَطّى تَلالي","هِ سَحابٌ إِذا عَلاهُ سَحابهُ",29,"ب",2,1],["أَيُّ حَمدٍ تَحوزُهُ إِن تَعايَي","تَ بِشَأني أَم أَيُّ ذِكرٍ تُفيدُه",30,"د",2,0],["أَيَحيا مَريضٌ بَعدَما مُيِّتَت لَهُ","سَوادُ الَّتي تَحتَ الفُؤادِ قِيامُها",31,"م",3,0],["أَيَحسَبُ أَولادَ الجَهالَةِ أَنَنا","عَلى الخيلِ لَسنا مِثلَهُم في الفَوارِسِ",32,"س",1,1],["أَيُّ حَيٍّ إِلّا سَيَصرَعُهُ المَو","تُ وَإِلّا سَتَستَبيهِ المَنونُ",33,"ن",1,0],["أَيَحمِل حَتفاً مَن رَجاك","وَيُقتَل وَهوَ في حِماك",34,"ك",1,0],["أيحرم حتى وهم حبك من رمى","بمهجته في ناره دون إحجامِ",35,"م",1,0],["أَيُّ حُسنٍ في الذاهِبينَ تَوَلّى","وَجَمالٍ عَلى ظُهورِ الجِمالِ",36,"ل",1,0],["أيُّ حياةٍ لامرئٍ رزقُهُ","يأخذُهُ مِنْ بين ظفرٍ ونابْ",37,"ب",1,0],["أَيُّ حَقٍّ مِن قَبلِ حَقِّكِ يُقضى","وَذِمامٍ يُصانُ قَبلَ ذِمامِكْ",38,"ك",1,0],["أيُّ حقٍّ ذلَّ في سُلطانِهِ","أيُّ زُورٍ عزَّ في الدُّنيا وسادا",39,"د",2,0],["أَي حَرب أَثار ظُلمُ فَرَنسا","فَدهاها ما لَيسَ بِالحسبان",40,"ن",1,0],["أَيُّ حُسنٍ تُخفي الدُنانُ مِنَ الرا","حِ وَحُسنٍ تَبديهِ مِنها الكُؤوسُ",41,"س",1,0],["أَيُّ حُبٍّ يَصِحُّ منه وطَرْفِي","لِلْكَرَى واصِلٌ وطَيْفُكَ رَاءُ",42,"ا",2,0],["أَيَحْسَبُ الصَّبُّ أنَّ الحُبَّ مُنْكتِمٌ","ما بَيْنَ مُنْسَجِمٍ منهُ ومُضْطَرِمِ",43,"م",1,0],["أيحسَبُ ساري الليلةِ البدرَ واحداً","وفي كِلَلِ الأظعانِ ثانٍ وثالث",44,"ث",1,0],["أَيُّ حَديثٍ دَبَّ الوُشاةُ بِهِ","أَبصَرتِ غَيّي فَأَبصِري رَشَدي",45,"د",2,0],["أَيَحيى بنَ زَيدٍ فيمَ تَقطَعُ خُلَّتي","لَقَد خُنتَ وُدّاً بَل تَجَشَّمتَ مُعجَبا",46,"ب",2,0],["أَيُحمَدُ المَرءُ لَم يَهمُم بِمَكرُمَةٍ","يَوماً وَيُترَكُ مَولى العُرفِ ما حُمِدا",47,"د",2,0],["أَيَّ حُسَامٍ سَلبْتَ رَوْنَقَهُ","وَأَيَّ رُوحٍ سَلَلْتَ منْ جَسَدِ",48,"د",1,0],["أَيُّ حَشاً لَمْ تَذُبْ لَهُ أَسَفاً","وَأَيُّ عَينٍ عَليْهِ لَمْ تَجُدِ",48,"د",1,0],["أي حقِّ في أن أنالَ شرابي","بعد أن صَحَّ أنني مثبور",49,"ر",1,0],["أَيحسب المَرء جهلاً","أن النساء فقوع",50,"ع",1,0],["أيحترس المرء من حتفه","وما حاد عن يومه المحترس",51,"س",1,1],["أَيَّ حُسْنٍ جَلَوْتَهُ لِنَدَامَاكَ","وَمَاذَا سَقَيْتَهُمْ مِنْ رَحيقِ",52,"ق",1,0],["أَيُّ حَكِيمٍ لَمْ يُكدِّرْ صَفْوَهُ","تَخَالُفُ الرَّأْيِ وَالاِعْتِقَادِ",53,"د",1,0],["أَيْ حَافِظَ الْعَهْدِ الَّذِي أَدْعُو وَمَا","أَخْشَى لَدَيْهِ أَنْ يَخِيبَ دُعَائِي",54,"ا",2,0],["أَيُّ حَيِّ أُتِيَ العِصْمَةَ فِي","حُكْمِهِ مِنْ خُطَّةٍ فِيهَا هَنَاتُ",55,"ت",1,0],["أيُحَكَّمُ الغوغاء في أدبائها","ويذود عن سفهائها \"بوليسها\"",56,"س",3,0],["أيحيا عيد أيلول","على مليون مقتول",57,"ل",1,0],["أيحيا الناسُ في بذخٍ وعزٍّ","ونحيا مثلَ زُهاد الهنود؟",58,"د",1,0],["أيُّ حبٍ في ذلك الديوان؟","أي شعرٍ فيه رقيق المعاني؟",59,"ن",2,1],["أيحسب أن داء القلب خصمٌ","وأن الحرب بينهما سِجَال؟",60,"ل",1,0],["أيُّ حالٍ هذي ، وما السرُّ في تكوين","خلقٍ بهذه الأعصاب",61,"ب",1,0],["أيُّ حَمْدٍ تَحُوزُهُ إنْ تَعَايَبْ","تَ بشأني، أمْ أيُّ ذِكْرٍ تُفيدُهْ",62,"د",2,0],["أيحسن رفعي بكم صرختي","أهل هل عن الظلم من رادع",63,"ع",1,0],["أي حزن به يحس وبرح","عندما يدفن الصديق الصديق",64,"ق",1,0]]}