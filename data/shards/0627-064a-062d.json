https://www.aldiwan.net/poem49230.html","مجزوء الوافر"],[393,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[400,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[402,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[403,"أي حرف تراه وصفا لجمع","https://www.aldiwan.net/poem34104.html","الخفيف"],[409,"أيحسب دهري أني جزعت","https://www.aldiwan.net/poem32154.html","المتقارب"],[416,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[432,"أي حبيب في خده شرطه","https://www.aldiwan.net/poem12465.html","المنسرح"],[432,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[437,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[439,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[453,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[453,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[453,"أصار مثلي عارا أم غدا خطرا","https://www.aldiwan.net/poem61605.html","البسيط"],[453,"يعز علي أن ألفى المعزى","https://www.aldiwan.net/poem61775.html","الوافر"],[464,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[500,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[515,"أيحسب صرف الدهر أني عائبه","https://www.aldiwan.net/poem12017.html","الطويل"],[515,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[538,"حشلاف قد مات ابنه مرددا","https://www.aldiwan.net/poem47959.html","عموديه"],[551,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[551,"سألتك ربة الوجه النضير","https://www.aldiwan.net/poem47793.html","الوافر"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[559,"كشف المحبوب عن قلبي الغطا","https://www.aldiwan.net/poem69334.html","الرمل"],[567,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[575,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[587,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"]],"verses":[["أيحسَبْنَ قَلبي خالياً من غَرامِها","وأَيُّ فؤادٍ من مَودَّتها خِلوُ",0,"و",1,0],["أَيَحْيَى سَقَى حَيْثُ لُحْتَ الْحَيَا","فَنِعْمَ الشِّعَابُ وَنِعْمَ الْوُكُونْ",1,"ن",1,1],["أَيَّ حينٍ وَقَد دَبَبتُ وَدَبَّت","وَلَبِسنا مِن بَعدِ دَهرٍ دُهورا",2,"ر",2,0],["أَيُحصي مَعانيكَ القَريضُ المُهَذَّبُ","عَلى أَنَّ صَدرَ الشِعرِ لِلمَدحِ أَرحَبُ",3,"ب",1,1],["أَيُّ حُسنٍ يَفي بِحُسنِيَ مَحمو","لاً بِكَفَّي وَصيفَةٍ أَو وَصيفِ",4,"ف",1,0],["أي حسنٍ في كل ما تقع العي","ن عليه من مونقات المجالي",5,"ل",2,0],["أيُّ حَفْلٍ بَدَا الصَّنِيعُ بِهِ","وَالوَفَاءُ البَدِيعُ فِي قَرَنِ",6,"ن",1,0],["أَيُّ حَفْلٍ فَخْمٍ تَوَسَّطَتْ فِيهِ","وَالسُّرَاةُ الشُّهُودُ عِقْدٌ نَظِيمُ",7,"م",1,0],["أَيُّ حُسْنٍ فِي وَجْهِ هَذَا الفَتَى المُشْ","رِقِ يَجْلُو لِلنَّاسِ بَدْراً تَمَامَا",8,"م",2,0],["أيَحُسن يا قوم أن نقعدا","وقد آن أن ينهض القاعدون",9,"ن",1,0],["أيُحجم عنا هارباً بعُلوجه","ويبغي بقتل الأبرياء له فخرا",10,"ر",2,0],["أيَحسُن اللحن إذ آباؤكم فصحُوا","أم يحسن العجز إذ آباءكم نشِطوا",11,"ط",3,0],["أيّ حرّ في الشرق عاش سعيداً","لم تشُب صفو عيشه الأقذاء",12,"ا",2,0],["أَيَحلو لِمَن لا صَبرَ يُنجِدُهُ صَبرُ","إِذا ما اِنقَضى فِكرٌ أَلَمَّ بِهِ فِكرُ",13,"ر",1,1],["أيحسن بعدِي عن بلادك بعد ما","عرفت بقولٍ في صفاتك بارع",14,"ع",1,0],["أيّ حرّ لو لم تفضّل ذووه","لكفتْه في الفضل نفس عصامهْ",15,"م",2,0],["أيحجبُ عني عِشرةً قد ومِقْتُها","فشوقي إليها شوق قيس إلى لُبْنى",16,"ن",2,0],["أيحيى العلا لهفي لذكراك لهفةً","يباشر مَكْواها الفؤادَ فيَنْضجُ",17,"ج",1,0],["أيُّ حِرْز فيه من الطَّيْر أنْ لَوْ","جعلُوه فزَّاعةً في قَرَاحِ",18,"ح",1,0],["أيحجبني عمرٌو فلا يُحْجَب الحيا","ولا ترتمي الآفاق بالجمر والصخر",19,"ر",1,0],["أيحسُن أن جَرَّ العيالَ رجاؤكم","وخاس نداكم وهْو خير خفير",20,"ر",1,0],["أيحسن رفعي بكم صرختي","ألا هل عن الظلم من رادع",21,"ع",1,0],["أيحجبني عمرٌو وقدْ عاشَ حقبةً","حبيبتُه خُفٌّ ومركبُه نَعْلُ",22,"ل",1,1],["أيُّ حقٍّ لها فيرعاه راعٍ","من نوالٍ لأهلِها ووصالِ",23,"ل",1,0],["أيّ حين أتاهُ طالبُ جدوا","هُ أتاه في حينه وأوانِهِ",24,"ن",2,0],["أَيَحوكُ مِثلَ العَنكَبوتِ بُيوتَهُ","حَوكاً وَيَبني كَالنُسورِ وُكورا",25,"ر",2,0],["أيحيا أمرؤ في القبر ميتاً وإنما","يموت الذي يحيا إذا سكن القبرا",26,"ر",2,0],["أى حي سواك يوم تولى","خدّدته نجابة الأولاد",27,"د",1,0],["أَيَحمِلُني عُمراً وَيَحمي شَبيبَتي","وَأَخذُلُهُ في وَهنِهِ وَأُخَيِّبُ",28,"ب",1,0],["أَيُّ حُسنٍ لِلبَدرِ غَطّى تَلالي","هِ سَحابٌ إِذا عَلاهُ سَحابهُ",29,"ب",2,1],["أَيُّ حَمدٍ تَحوزُهُ إِن تَعايَي","تَ بِشَأني أَم أَيُّ ذِكرٍ تُفيدُه",30,"د",2,0],["أَيَحيا مَريضٌ بَعدَما مُيِّتَت لَهُ","سَوادُ الَّتي تَحتَ الفُؤادِ قِيامُها",31,"م",3,0],["أَيَحسَبُ أَولادَ الجَهالَةِ أَنَنا","عَلى الخيلِ لَسنا مِثلَهُم في الفَوارِسِ",32,"س",1,1],["أَيُّ حَيٍّ إِلّا سَيَصرَعُهُ المَو","تُ وَإِلّا سَتَستَبيهِ المَنونُ",33,"ن",1,0],["أَيَحمِل حَتفاً مَن رَجاك","وَيُقتَل وَهوَ في حِماك",34,"ك",1,0],["أيحرم حتى وهم حبك من رمى","بمهجته في ناره دون إحجامِ",35,"م",1,0],["أَيُّ حُسنٍ في الذاهِبينَ تَوَلّى","وَجَمالٍ عَلى ظُهورِ الجِمالِ",36,"ل",1,0],["أيُّ حياةٍ لامرئٍ رزقُهُ","يأخذُهُ مِنْ بين ظفرٍ ونابْ",37,"ب",1,0],["أَيُّ حَقٍّ مِن قَبلِ حَقِّكِ يُقضى","وَذِمامٍ يُصانُ قَبلَ ذِمامِكْ",38,"ك",1,0],["أيُّ حقٍّ ذلَّ في سُلطانِهِ","أيُّ زُورٍ عزَّ في الدُّنيا وسادا",39,"د",2,0],["أَي حَرب أَثار ظُلمُ فَرَنسا","فَدهاها ما لَيسَ بِالحسبان",40,"ن",1,0],["أَيُّ حُسنٍ تُخفي الدُنانُ مِنَ الرا","حِ وَحُسنٍ تَبديهِ مِنها الكُؤوسُ",41,"س",1,0],["أَيُّ حُبٍّ يَصِحُّ منه وطَرْفِي","لِلْكَرَى واصِلٌ وطَيْفُكَ رَاءُ",42,"ا",2,0],["أَيَحْسَبُ الصَّبُّ أنَّ الحُبَّ مُنْكتِمٌ","ما بَيْنَ مُنْسَجِمٍ منهُ ومُضْطَرِمِ",43,"م",1,0],["أيحسَبُ ساري الليلةِ البدرَ واحداً","وفي كِلَلِ الأظعانِ ثانٍ وثالث",44,"ث",1,0],["أَيُّ حَديثٍ دَبَّ الوُشاةُ بِهِ","أَبصَرتِ غَيّي فَأَبصِري رَشَدي",45,"د",2,0],["أَيَحيى بنَ زَيدٍ فيمَ تَقطَعُ خُلَّتي","لَقَد خُنتَ وُدّاً بَل تَجَشَّمتَ مُعجَبا",46,"ب",2,0],["أَيُحمَدُ المَرءُ لَم يَهمُم بِمَكرُمَةٍ","يَوماً وَيُترَكُ مَولى العُرفِ ما حُمِدا",47,"د",2,0],["أَيَّ حُسَامٍ سَلبْتَ رَوْنَقَهُ","وَأَيَّ رُوحٍ سَلَلْتَ منْ جَسَدِ",48,"د",1,0],["أَيُّ حَشاً لَمْ تَذُبْ لَهُ أَسَفاً","وَأَيُّ عَينٍ عَليْهِ لَمْ تَجُدِ",48,"د",1,0],["أي حقِّ في أن أنالَ شرابي","بعد أن صَحَّ أنني مثبور",49,"ر",1,0],["أَيحسب المَرء جهلاً","أن النساء فقوع",50,"ع",1,0],["أيحترس المرء من حتفه","وما حاد عن يومه المحترس",51,"س",1,1],["أَيَّ حُسْنٍ جَلَوْتَهُ لِنَدَامَاكَ","وَمَاذَا سَقَيْتَهُمْ مِنْ رَحيقِ",52,"ق",1,0],["أَيُّ حَكِيمٍ لَمْ يُكدِّرْ صَفْوَهُ","تَخَالُفُ الرَّأْيِ وَالاِعْتِقَادِ",53,"د",1,0],["أَيْ حَافِظَ الْعَهْدِ الَّذِي أَدْعُو وَمَا","أَخْشَى لَدَيْهِ أَنْ يَخِيبَ دُعَائِي",54,"ا",2,0],["أَيُّ حَيِّ أُتِيَ العِصْمَةَ فِي","حُكْمِهِ مِنْ خُطَّةٍ فِيهَا هَنَاتُ",55,"ت",1,0],["أيُحَكَّمُ الغوغاء في أدبائها","ويذود عن سفهائها \"بوليسها\"",56,"س",3,0],["أيحيا عيد أيلول","على مليون مقتول",57,"ل",1,0],["أيحيا الناسُ في بذخٍ وعزٍّ","ونحيا مثلَ زُهاد الهنود؟",58,"د",1,0],["أيُّ حبٍ في ذلك الديوان؟","أي شعرٍ فيه رقيق المعاني؟",59,"ن",2,1],["أيحسب أن داء القلب خصمٌ","وأن الحرب بينهما سِجَال؟",60,"ل",1,0],["أيُّ حالٍ هذي ، وما السرُّ في تكوين","خلقٍ بهذه الأعصاب",61,"ب",1,0],["أيُّ حَمْدٍ تَحُوزُهُ إنْ تَعَايَبْ","تَ بشأني، أمْ أيُّ ذِكْرٍ تُفيدُهْ",62,"د",2,0],["أيحسن رفعي بكم صرختي","أهل هل عن الظلم من رادع",63,"ع",1,0],["أي حزن به يحس وبرح","عندما يدفن الصديق الصديق",64,"ق",1,0],["ايحسن حال القلب والهم حشوه","ويصفو وذي الاكدار اعظم شاغل",65,"ل",1,0],["أيَحسِبُ أَنَّك الحادي","تَحُثُّ الرَكبَ والظَّعنا",66,"ن",2,0],["أيُحُبُّ النبي مَالاً وقَد عَف","فَ لِزُهدٍ عَنِ النُّضَارِ جِبَالا",67,"ل",2,0],["أيحكى بوارقُها والقِطا","رُ للعين عسجدَه والرَّقينا",68,"ن",2,0],["أَيُّ حَيفٍ وَلِلخِلافَةِ سَيفٌ","تَستَمِدُّ السُيوفُ مِنهُ المَضاءَ",69,"ا",2,0],["أيحلّ ريب الدهر ما عقدوا وكم","حلّت عقودي بالمنى المتخيّل",70,"ل",1,0],["أيُّ حياةٍ لامرئٍ قد بُلي","بالقُرب من فُرقة أحبابِهِ",71,"ب",2,0],["أَيَحسُنُ هاءُ اللَهِ خَدعُ عَدُوِّكُم","وَيُلهيكُمُ غَرسُ الوَدِيِّ الجَثاجِثِ",72,"ث",1,0],["أَيُّ حَدٍّ كافَحتُموهُ بِحَدٍّ","مِنكُمُ لَم يَدَعهُ وَهوَ فَليلُ",73,"ل",1,0],["أَيَحسبُ فيك اللومُ أني سمعتُه","إذاً بَخِلتْ كفِّى بما أنا واجد",74,"د",1,0],["أيّ حال أرقّ من مثل حالي","أيّ خلق يكون في مثل شاني",75,"ي",1,0],["أيّ حياة لمستغيث","شفاء أسقامه وفاته",76,"ت",2,0],["أيحسن يا حبيب بأن تراني","أُصافيك الوداد وتجتويني",77,"ن",2,0],["أَيَحجُبُ الخامِلونَ عَنّي","ما تَبدِعين",78,"ن",1,0],["أَيَحِقُّ لي في غَيرِها الغَزلُ","وَعَلى فَمي مِن قَلبِها قُبَلُ",79,"ل",1,1],["أَيَحسُنُ أَنّي أُرى واقِفاً","بِأَبوابِ غَيرُكُم سائِلاً",80,"ل",2,0],["أيحسنُ أن أشكو الزمانَ الذي غَدَت","صنائعهُ عندي تَجِلُّ عن الشُّكرِ",81,"ر",1,0],["أيْ حبيبي لا تدنّي","منه خذ دعماً وحِمْلا",82,"ل",2,0],["أيُّ حقدٍ بغد حبٍّ","غير مسبوق أُقِرُّ",83,"ر",1,0],["أيحرمُني النهارُ أقلَّ شيءٍ","وفي الليلِ البهيمِ تُؤانسيني",84,"ي",1,0],["أيحظى بِشَمِّ الزَّهرِ خداً وباقةً","مُحِبٌّ يُعاني مطمعاً بعد مأمل",85,"ل",1,0],["أَيَحْسُن بعد ضَنِّكَ حُسْنُ ظنّي","فأَجمعَ بين يأسي والتَّمنّي",86,"ي",1,1],["أَيَحمِلُ خَوطُ بانٍ جُلَّناراً","بِهِ مِن وَجنَتَيها جُلُّ ناري",87,"ي",1,0],["أي حلم أرى وأي أمان","تتداعى لخاطري حين تشدوا",88,"د",3,1],["أيحل في شرع الهوى هذا ومن","أفتى بأن دم المحب جبارُ",89,"ر",1,0],["أي حين واي عيش تقضى","بين تلك الربوع والأعلام",90,"م",1,0],["أَيَحسَبُ الصَبَّ إِنَّ الحَُّ مُنكَتِمِ","ما بَينَ مُنسَجِمٍ مِنهُ ومُضطَّرَمِ",91,"م",1,0],["أَيَحذَربُ المَرءُ فَوتَ أَمرٍ","في قَصدِهِ عُمرُهُ يَفوتُ",92,"ت",1,0],["أَيَحتاجُ عُشبُ الدُجى زارِعاً","لَهُ وَقَليبُ السَما حافِرا",93,"ر",2,0],["أيحلبون دماً منا ونحلبهم","رسلاً لقد شرفونا في الورى حلبا",94,"ب",2,0],["أَيُحسن مِنكَ أَن يَعزى","لِقليك قَسوة الصَخر",95,"ر",1,0],["أَي حينَ طالَعت غرتهُ","آية اللَيل محتها بِسَناها",96,"ا",3,0],["أَيُحسن مِنكَ هِجراني","وَأَنتَ مِن الوَرى سُؤلي",97,"ي",1,0],["أَيَحلو اِذا الشيعيُّ رَدَّد ذكرَهُ","لكِن عَلى النُصابِ مثل الصاب",98,"ب",1,0],["أيُّ حربٍ هذه أيُّ ضلالِ","ولماذا أغلقوا باب \" المعالي \"",99,"ل",2,1],["أيّ حييَن لِراجي نصرةٍ","وهما خولان طُرّاً والحيامُ",100,"م",1,0],