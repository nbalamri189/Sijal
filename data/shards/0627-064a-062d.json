poem49195.html","الرمل"],[381,"أيا فردا بلا مثل","https://www.aldiwan.net/poem49230.html","مجزوء الوافر"],[394,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[401,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[403,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[404,"أي حرف تراه وصفا لجمع","https://www.aldiwan.net/poem34104.html","الخفيف"],[410,"أيحسب دهري أني جزعت","https://www.aldiwan.net/poem32154.html","المتقارب"],[417,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[433,"أي حبيب في خده شرطه","https://www.aldiwan.net/poem12465.html","المنسرح"],[433,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[438,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[440,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[454,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[454,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[454,"أصار مثلي عارا أم غدا خطرا","https://www.aldiwan.net/poem61605.html","البسيط"],[454,"يعز علي أن ألفى المعزى","https://www.aldiwan.net/poem61775.html","الوافر"],[465,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[501,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[516,"أيحسب صرف الدهر أني عائبه","https://www.aldiwan.net/poem12017.html","الطويل"],[516,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[539,"حشلاف قد مات ابنه مرددا","https://www.aldiwan.net/poem47959.html","عموديه"],[552,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[552,"سألتك ربة الوجه النضير","https://www.aldiwan.net/poem47793.html","الوافر"],[559,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[560,"كشف المحبوب عن قلبي الغطا","https://www.aldiwan.net/poem69334.html","الرمل"],[568,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[588,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"]],"verses":[["أيحسب وجدي أن وجدي دالهٌ","بواكف أطلالٍ وبارق هوجل",0,"ل",1,0],["أيحسب إذ يسلوا بشاهد ما عفا","أيحسب أن هذا سؤالي وسؤللي",0,"ل",2,0],["أيحسَبْنَ قَلبي خالياً من غَرامِها","وأَيُّ فؤادٍ من مَودَّتها خِلوُ",1,"و",1,0],["أَيَحْيَى سَقَى حَيْثُ لُحْتَ الْحَيَا","فَنِعْمَ الشِّعَابُ وَنِعْمَ الْوُكُونْ",2,"ن",1,1],["أَيَّ حينٍ وَقَد دَبَبتُ وَدَبَّت","وَلَبِسنا مِن بَعدِ دَهرٍ دُهورا",3,"ر",2,0],["أَيُحصي مَعانيكَ القَريضُ المُهَذَّبُ","عَلى أَنَّ صَدرَ الشِعرِ لِلمَدحِ أَرحَبُ",4,"ب",1,1],["أَيُّ حُسنٍ يَفي بِحُسنِيَ مَحمو","لاً بِكَفَّي وَصيفَةٍ أَو وَصيفِ",5,"ف",1,0],["أي حسنٍ في كل ما تقع العي","ن عليه من مونقات المجالي",6,"ل",2,0],["أيُّ حَفْلٍ بَدَا الصَّنِيعُ بِهِ","وَالوَفَاءُ البَدِيعُ فِي قَرَنِ",7,"ن",1,0],["أَيُّ حَفْلٍ فَخْمٍ تَوَسَّطَتْ فِيهِ","وَالسُّرَاةُ الشُّهُودُ عِقْدٌ نَظِيمُ",8,"م",1,0],["أَيُّ حُسْنٍ فِي وَجْهِ هَذَا الفَتَى المُشْ","رِقِ يَجْلُو لِلنَّاسِ بَدْراً تَمَامَا",9,"م",2,0],["أيَحُسن يا قوم أن نقعدا","وقد آن أن ينهض القاعدون",10,"ن",1,0],["أيُحجم عنا هارباً بعُلوجه","ويبغي بقتل الأبرياء له فخرا",11,"ر",2,0],["أيَحسُن اللحن إذ آباؤكم فصحُوا","أم يحسن العجز إذ آباءكم نشِطوا",12,"ط",3,0],["أيّ حرّ في الشرق عاش سعيداً","لم تشُب صفو عيشه الأقذاء",13,"ا",2,0],["أَيَحلو لِمَن لا صَبرَ يُنجِدُهُ صَبرُ","إِذا ما اِنقَضى فِكرٌ أَلَمَّ بِهِ فِكرُ",14,"ر",1,1],["أيحسن بعدِي عن بلادك بعد ما","عرفت بقولٍ في صفاتك بارع",15,"ع",1,0],["أيّ حرّ لو لم تفضّل ذووه","لكفتْه في الفضل نفس عصامهْ",16,"م",2,0],["أيحجبُ عني عِشرةً قد ومِقْتُها","فشوقي إليها شوق قيس إلى لُبْنى",17,"ن",2,0],["أيحيى العلا لهفي لذكراك لهفةً","يباشر مَكْواها الفؤادَ فيَنْضجُ",18,"ج",1,0],["أيُّ حِرْز فيه من الطَّيْر أنْ لَوْ","جعلُوه فزَّاعةً في قَرَاحِ",19,"ح",1,0],["أيحجبني عمرٌو فلا يُحْجَب الحيا","ولا ترتمي الآفاق بالجمر والصخر",20,"ر",1,0],["أيحسُن أن جَرَّ العيالَ رجاؤكم","وخاس نداكم وهْو خير خفير",21,"ر",1,0],["أيحسن رفعي بكم صرختي","ألا هل عن الظلم من رادع",22,"ع",1,0],["أيحجبني عمرٌو وقدْ عاشَ حقبةً","حبيبتُه خُفٌّ ومركبُه نَعْلُ",23,"ل",1,1],["أيُّ حقٍّ لها فيرعاه راعٍ","من نوالٍ لأهلِها ووصالِ",24,"ل",1,0],["أيّ حين أتاهُ طالبُ جدوا","هُ أتاه في حينه وأوانِهِ",25,"ن",2,0],["أَيَحوكُ مِثلَ العَنكَبوتِ بُيوتَهُ","حَوكاً وَيَبني كَالنُسورِ وُكورا",26,"ر",2,0],["أيحيا أمرؤ في القبر ميتاً وإنما","يموت الذي يحيا إذا سكن القبرا",27,"ر",2,0],["أى حي سواك يوم تولى","خدّدته نجابة الأولاد",28,"د",1,0],["أَيَحمِلُني عُمراً وَيَحمي شَبيبَتي","وَأَخذُلُهُ في وَهنِهِ وَأُخَيِّبُ",29,"ب",1,0],["أَيُّ حُسنٍ لِلبَدرِ غَطّى تَلالي","هِ سَحابٌ إِذا عَلاهُ سَحابهُ",30,"ب",2,1],["أَيُّ حَمدٍ تَحوزُهُ إِن تَعايَي","تَ بِشَأني أَم أَيُّ ذِكرٍ تُفيدُه",31,"د",2,0],["أَيَحيا مَريضٌ بَعدَما مُيِّتَت لَهُ","سَوادُ الَّتي تَحتَ الفُؤادِ قِيامُها",32,"م",3,0],["أَيَحسَبُ أَولادَ الجَهالَةِ أَنَنا","عَلى الخيلِ لَسنا مِثلَهُم في الفَوارِسِ",33,"س",1,1],["أَيُّ حَيٍّ إِلّا سَيَصرَعُهُ المَو","تُ وَإِلّا سَتَستَبيهِ المَنونُ",34,"ن",1,0],["أَيَحمِل حَتفاً مَن رَجاك","وَيُقتَل وَهوَ في حِماك",35,"ك",1,0],["أيحرم حتى وهم حبك من رمى","بمهجته في ناره دون إحجامِ",36,"م",1,0],["أَيُّ حُسنٍ في الذاهِبينَ تَوَلّى","وَجَمالٍ عَلى ظُهورِ الجِمالِ",37,"ل",1,0],["أيُّ حياةٍ لامرئٍ رزقُهُ","يأخذُهُ مِنْ بين ظفرٍ ونابْ",38,"ب",1,0],["أَيُّ حَقٍّ مِن قَبلِ حَقِّكِ يُقضى","وَذِمامٍ يُصانُ قَبلَ ذِمامِكْ",39,"ك",1,0],["أيُّ حقٍّ ذلَّ في سُلطانِهِ","أيُّ زُورٍ عزَّ في الدُّنيا وسادا",40,"د",2,0],["أَي حَرب أَثار ظُلمُ فَرَنسا","فَدهاها ما لَيسَ بِالحسبان",41,"ن",1,0],["أَيُّ حُسنٍ تُخفي الدُنانُ مِنَ الرا","حِ وَحُسنٍ تَبديهِ مِنها الكُؤوسُ",42,"س",1,0],["أَيُّ حُبٍّ يَصِحُّ منه وطَرْفِي","لِلْكَرَى واصِلٌ وطَيْفُكَ رَاءُ",43,"ا",2,0],["أَيَحْسَبُ الصَّبُّ أنَّ الحُبَّ مُنْكتِمٌ","ما بَيْنَ مُنْسَجِمٍ منهُ ومُضْطَرِمِ",44,"م",1,0],["أيحسَبُ ساري الليلةِ البدرَ واحداً","وفي كِلَلِ الأظعانِ ثانٍ وثالث",45,"ث",1,0],["أَيُّ حَديثٍ دَبَّ الوُشاةُ بِهِ","أَبصَرتِ غَيّي فَأَبصِري رَشَدي",46,"د",2,0],["أَيَحيى بنَ زَيدٍ فيمَ تَقطَعُ خُلَّتي","لَقَد خُنتَ وُدّاً بَل تَجَشَّمتَ مُعجَبا",47,"ب",2,0],["أَيُحمَدُ المَرءُ لَم يَهمُم بِمَكرُمَةٍ","يَوماً وَيُترَكُ مَولى العُرفِ ما حُمِدا",48,"د",2,0],["أَيَّ حُسَامٍ سَلبْتَ رَوْنَقَهُ","وَأَيَّ رُوحٍ سَلَلْتَ منْ جَسَدِ",49,"د",1,0],["أَيُّ حَشاً لَمْ تَذُبْ لَهُ أَسَفاً","وَأَيُّ عَينٍ عَليْهِ لَمْ تَجُدِ",49,"د",1,0],["أي حقِّ في أن أنالَ شرابي","بعد أن صَحَّ أنني مثبور",50,"ر",1,0],["أَيحسب المَرء جهلاً","أن النساء فقوع",51,"ع",1,0],["أيحترس المرء من حتفه","وما حاد عن يومه المحترس",52,"س",1,1],["أَيَّ حُسْنٍ جَلَوْتَهُ لِنَدَامَاكَ","وَمَاذَا سَقَيْتَهُمْ مِنْ رَحيقِ",53,"ق",1,0],["أَيُّ حَكِيمٍ لَمْ يُكدِّرْ صَفْوَهُ","تَخَالُفُ الرَّأْيِ وَالاِعْتِقَادِ",54,"د",1,0],["أَيْ حَافِظَ الْعَهْدِ الَّذِي أَدْعُو وَمَا","أَخْشَى لَدَيْهِ أَنْ يَخِيبَ دُعَائِي",55,"ا",2,0],["أَيُّ حَيِّ أُتِيَ العِصْمَةَ فِي","حُكْمِهِ مِنْ خُطَّةٍ فِيهَا هَنَاتُ",56,"ت",1,0],["أيُحَكَّمُ الغوغاء في أدبائها","ويذود عن سفهائها \"بوليسها\"",57,"س",3,0],["أيحيا عيد أيلول","على مليون مقتول",58,"ل",1,0],["أيحيا الناسُ في بذخٍ وعزٍّ","ونحيا مثلَ زُهاد الهنود؟",59,"د",1,0],["أيُّ حبٍ في ذلك الديوان؟","أي شعرٍ فيه رقيق المعاني؟",60,"ن",2,1],["أيحسب أن داء القلب خصمٌ","وأن الحرب بينهما سِجَال؟",61,"ل",1,0],["أيُّ حالٍ هذي ، وما السرُّ في تكوين","خلقٍ بهذه الأعصاب",62,"ب",1,0],["أيُّ حَمْدٍ تَحُوزُهُ إنْ تَعَايَبْ","تَ بشأني، أمْ أيُّ ذِكْرٍ تُفيدُهْ",63,"د",2,0],["أيحسن رفعي بكم صرختي","أهل هل عن الظلم من رادع",64,"ع",1,0],["أي حزن به يحس وبرح","عندما يدفن الصديق الصديق",65,"ق",1,0],["ايحسن حال القلب والهم حشوه","ويصفو وذي الاكدار اعظم شاغل",66,"ل",1,0],["أيَحسِبُ أَنَّك الحادي","تَحُثُّ الرَكبَ والظَّعنا",67,"ن",2,0],["أيُحُبُّ النبي مَالاً وقَد عَف","فَ لِزُهدٍ عَنِ النُّضَارِ جِبَالا",68,"ل",2,0],["أيحكى بوارقُها والقِطا","رُ للعين عسجدَه والرَّقينا",69,"ن",2,0],["أَيُّ حَيفٍ وَلِلخِلافَةِ سَيفٌ","تَستَمِدُّ السُيوفُ مِنهُ المَضاءَ",70,"ا",2,0],["أيحلّ ريب الدهر ما عقدوا وكم","حلّت عقودي بالمنى المتخيّل",71,"ل",1,0],["أيُّ حياةٍ لامرئٍ قد بُلي","بالقُرب من فُرقة أحبابِهِ",72,"ب",2,0],["أَيَحسُنُ هاءُ اللَهِ خَدعُ عَدُوِّكُم","وَيُلهيكُمُ غَرسُ الوَدِيِّ الجَثاجِثِ",73,"ث",1,0],["أَيُّ حَدٍّ كافَحتُموهُ بِحَدٍّ","مِنكُمُ لَم يَدَعهُ وَهوَ فَليلُ",74,"ل",1,0],["أَيَحسبُ فيك اللومُ أني سمعتُه","إذاً بَخِلتْ كفِّى بما أنا واجد",75,"د",1,0],["أيّ حال أرقّ من مثل حالي","أيّ خلق يكون في مثل شاني",76,"ن",2,0],["أيّ حياة لمستغيث","شفاء أسقامه وفاته",77,"ت",2,0],["أيحسن يا حبيب بأن تراني","أُصافيك الوداد وتجتويني",78,"ن",2,0],["أَيَحجُبُ الخامِلونَ عَنّي","ما تَبدِعين",79,"ن",1,0],["أَيَحِقُّ لي في غَيرِها الغَزلُ","وَعَلى فَمي مِن قَلبِها قُبَلُ",80,"ل",1,1],["أَيَحسُنُ أَنّي أُرى واقِفاً","بِأَبوابِ غَيرُكُم سائِلاً",81,"ل",2,0],["أيحسنُ أن أشكو الزمانَ الذي غَدَت","صنائعهُ عندي تَجِلُّ عن الشُّكرِ",82,"ر",1,0],["أيْ حبيبي لا تدنّي","منه خذ دعماً وحِمْلا",83,"ل",2,0],["أيُّ حقدٍ بغد حبٍّ","غير مسبوق أُقِرُّ",84,"ر",1,0],["أيحرمُني النهارُ أقلَّ شيءٍ","وفي الليلِ البهيمِ تُؤانسيني",85,"ن",2,0],["أيحظى بِشَمِّ الزَّهرِ خداً وباقةً","مُحِبٌّ يُعاني مطمعاً بعد مأمل",86,"ل",1,0],["أَيَحْسُن بعد ضَنِّكَ حُسْنُ ظنّي","فأَجمعَ بين يأسي والتَّمنّي",87,"ن",2,1],["أَيَحمِلُ خَوطُ بانٍ جُلَّناراً","بِهِ مِن وَجنَتَيها جُلُّ ناري",88,"ر",2,0],["أي حلم أرى وأي أمان","تتداعى لخاطري حين تشدوا",89,"د",3,1],["أيحل في شرع الهوى هذا ومن","أفتى بأن دم المحب جبارُ",90,"ر",1,0],["أي حين واي عيش تقضى","بين تلك الربوع والأعلام",91,"م",1,0],["أَيَحسَبُ الصَبَّ إِنَّ الحَُّ مُنكَتِمِ","ما بَينَ مُنسَجِمٍ مِنهُ ومُضطَّرَمِ",92,"م",1,0],["أَيَحذَربُ المَرءُ فَوتَ أَمرٍ","في قَصدِهِ عُمرُهُ يَفوتُ",93,"ت",1,0],["أَيَحتاجُ عُشبُ الدُجى زارِعاً","لَهُ وَقَليبُ السَما حافِرا",94,"ر",2,0],["أيحلبون دماً منا ونحلبهم","رسلاً لقد شرفونا في الورى حلبا",95,"ب",2,0],["أَيُحسن مِنكَ أَن يَعزى","لِقليك قَسوة الصَخر",96,"ر",1,0],["أَي حينَ طالَعت غرتهُ","آية اللَيل محتها بِسَناها",97,"ا",3,0],["أَيُحسن مِنكَ هِجراني","وَأَنتَ مِن الوَرى سُؤلي",98,"ل",2,0],["أَيَحلو اِذا الشيعيُّ رَدَّد ذكرَهُ"