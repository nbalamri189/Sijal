{"poems":[[53,"أأبقى على نضو الهموم كأنما","https://www.aldiwan.net/poem29790.html","الطويل"],[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[53,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"أرى للروح بالبدن اتصالا","https://www.aldiwan.net/poem45062.html","الوافر"],[4,"بلينا وما تبلى النجوم الطوالع","https://www.aldiwan.net/poem21175.html","الطويل"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"حلفت بما يملا النديم وما يملي","https://www.aldiwan.net/poem19468.html","الطويل"],[72,"إذا ظفرت يوما بقربكم المنا","https://www.aldiwan.net/poem20155.html","الطويل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[91,"عادت رياض القوافي وهي حالية","https://www.aldiwan.net/poem8742.html","عموديه"],[70,"إليك عني ودعني","https://www.aldiwan.net/poem42411.html","المجتث"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[45,"مرضت فأمرضت القلوب وجانبت","https://www.aldiwan.net/poem64554.html","الطويل"],[45,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[61,"ليس التجلد شيمة العشاق","https://www.aldiwan.net/poem51519.html","الكامل"],[61,"عذلت وهل عذل المتيم نافعه","https://www.aldiwan.net/poem51566.html","الطويل"],[44,"رأيت العلا معمورة بك دارها","https://www.aldiwan.net/poem29982.html","الطويل"],[52,"ضمان على عيني سقي ديارك","https://www.aldiwan.net/poem26783.html","الطويل"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42642","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42659","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[109,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=8399",""],[12,"أقيموا بني أمي صدورَ مطيَّكمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8986&r=&rc=0",""],[116,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[116,"صاحبت أهلك في هواك وهم عدا","https://www.aldiwan.net/poem41488.html","الكامل"],[133,"فلا جزع إذا انفرادى قد يبدو","https://www.aldiwan.net/poem54856.html","الطويل"],[144,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[148,"لنا في كل مكرمة مجال","https://www.aldiwan.net/poem47692.html","الوافر"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"وعهدي به والله يصلح أمره","https://www.aldiwan.net/poem27628.html","الطويل"],[196,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[236,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[236,"لنا صاحب قالص ظله","https://www.aldiwan.net/poem31903.html","المتقارب"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[276,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[358,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[400,"قل للمغيب تحت أطباق الثرى","https://www.aldiwan.net/poem4525.html","الكامل"],[438,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[440,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[459,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[465,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[465,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[465,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[478,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[480,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[496,"أقول لإحدى المعضلات العظائم","https://www.aldiwan.net/poem10271.html","الطويل"],[516,"هي البدر من سنة البدر أملح","https://www.aldiwan.net/poem12055.html","الطويل"],[552,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[559,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[576,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[588,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["فَلا جامِعاً مالاً وَلا مُدرِكاً عُلىً","وَلا مُحرِزاً أَجراً وَلا طالِباً عِلما",0,"م",2,0],["فَلَأَجعَلَنَّ عُقوبَتي أَبَداً","أَن لا أَمُدَّ يَداً إِلى أَحَدِ",1,"د",1,0],["فَلا جودَ إِلّا أَن تَمَلَّ مَطامِعٌ","وَلا عَفوَ إِلّا أَن يَطولَ عِقابُ",2,"ب",1,0],["فَلاَ جَحْدَ مَا خَوَّلْتَنِي مِنْ سَجَّيتِي","وَلاَ كُفْرَ نُعْمَاكَ الْعَمِيمَةِ مِنْ شَانِي",3,"ن",2,0],["فلا جفنَ إلاّ مرسلٌ سُحْبَ دمعه","ولا قلبَ إلا بالجوى يَتَلَهَّفُ",4,"ف",1,0],["فلا جسد يقوم بغير روح","ولا روح بلا جسد تقوم",5,"م",1,0],["فَلا جَزِعٌ إِن فَرَّقَ الدَهرُ بَينَنا","وَكُلُّ فَتىً يَوماً بِهِ الدَهرُ فاجِعُ",6,"ع",1,0],["فلا جناحٌ بمنهاضٍ إذا عضدت","من جانبيه ولا قلبٌ بمرتجف",7,"ف",1,0],["فلا جائرٌ فينا سوى ساق غادةٍ","ولا ظالمٌ إلاَّ من الأعين النجْل",8,"ل",1,0],["فلا جلّقٌ بالسهم تمنع قاصداً","ولا حلب الشهباء تلبس جوشنا",9,"ن",2,0],["فَلَأَجعَلَنَّ بَني كُلَيبٍ شُهرَةً","بِعَوارِمٍ ذَهَبَت مَعَ القُفّالِ",10,"ل",1,0],["فَلا جَناحٌ إِذا ما قالَ شاعِرُنا","لِلبَحرِ يا بَحرُ أَغلى الدُرِّ ما أَهَبُ",11,"ب",1,0],["فَلا جَزى اللَهُ خَيراً","يَوماً عَرَفناكَ فيهِ",12,"ي",2,0],["فَلا جَزعٌ مِن خَلَّةٍ مُتَكَثَّفٌ","وَلا مَرحٌ تَحتَ الغِنى أَتَخَيَّلُ",13,"ل",1,0],["فَلا جُزِيَت مِصرٌ لِذاكَ اِحتَقَرتُها","وَلَم تَرَ شَيئاً أَن جَرى تَحتَكَ البَحرُ",14,"ر",1,0],["فَلا جودَ إِلّا جودُهُ أَو كَجودِهِ","وَلا بَدرَ مالَم يوفِ عَشراً وَأَربَعا",15,"ع",2,0],["فَلأُجرِيَنَّ الدَمعَ إِن لَم تُجرِهِ","وَلأَعرِفَنَّ الوَجدَ إِن لَم تَعرِفِ",16,"ف",1,0],["فَلأجلِبَنَّ إليكَ كلَّ غَريبَةٍ","تُضْحى الكِرامُ لها من العُشَّاقِ",17,"ق",1,0],["فلا جودَ إلاّ ما تُفيدُ يمينُه","ولا مجدَ إلاّ ما تَشيدُ وقائِعُه",18,"ع",2,0],["فَلا جارَكَ العافي تَناوَلَ مَحلُها","وَلا عِرضَكَ الوافي تَناوَلَ عارُها",19,"ر",3,0],["فَلا جَزَعٌ إِن رابَ دَهرٌ بِصَرفِهِ","وَبَدَّلَ حالاً فَالخَطوبُ كَذَلِكِ",20,"ك",1,0],["فلا جالت الفرسانُ إلا لنصره","ولا حملتها المقرباتُ الصواهل",21,"ل",1,0],["فلا جُودَ إلاّ بالجَزيلِ لآمِلٍ","ولا عَفْوَ إلاّ أن تَجِلّ الجَرائم",22,"م",1,0],["فَلا جَوَادٌ صَاهِلٌ عَزَّهُمْ","يَوْمَاً وَلا خَيْفَانَةٌ شَاخِرَهْ",23,"ر",2,0],["فَلا جَوَّ إِلَّا سَمْهَرِيٌّ وقاضِبٌ","وَلا أَرْضَ إِلَّا شَمَّرِيٌّ وَسابِحُ",24,"ح",1,0],["فَلا جمشِيدُ دَافَعَ إِذْ أَتَتْهُ","بِحَادِثِها وَلا رَبُّ الدِّرَفْسِ",25,"س",1,0],["فَلا جَهْرُهُ سِرٌّ وَلا سِرُّ صَدْرِهِ","إِذَا امْتَحَنَ الْوَاشِي ضَمَائِرَهُ جَهْرُ",26,"ر",1,0],["فَلأَجْعَلَنَّ كِتَابَهَا","حَتَّى أُحَقِّقَهُ إِمَامِي",27,"م",2,0],["فلا جيت بيت الصاحب .. الضفر .. الشلي","اللي حروفه ... بالتهايم... شايعه",28,"ع",2,0],["فلا جَزَعٌ من خِلةٍ مُتكشِّفٌ","ولا مَرِحٌ تحت الغِنى أتخيلُ",29,"ل",1,0],["فلا جلدي مهما صبرت بنافع","ولا لهفتي في طي سري تضمر",30,"ر",1,0],["فلا جل نفس ألف نفس تفتدي","ومقامها منهم أجل وأعظم",31,"م",1,0],["فَلاَ جَزَعٌ إذَا انفِرَادِى قَد يَبدُو","بَلِ الرُّشدُ إفرَادِى إذَا انفَرَد العَبدُ",32,"د",1,1],["فلا جزعٌ فالفَردُ مَع كُلِّ مُفرَدٍ","ولم يَكُ فَرداً من يَكُن مَعَهُ الفَردُ",32,"د",1,0],["فَلِأَجلِ ذا مَدّوا إِلَيكَ رِقابَهُم","يَرجونَ أَن تَرضى وَما أَولاكا",33,"ك",2,0],["فلا جزعٌ ولا هلعٌ مشينٌ","ومنّا الغدرُ أو كذبٌ محال",34,"ل",1,0],["فَلا جِهةٌ تحويهِ لا جهةٌ له","تَنزّهَ ربّي عَنهما وَعلا قدرا",35,"ر",2,0],["فَلا جَعَلَ اللَهُ الوُلايَةَ سِبَة","عَلَيهِ فَإِنّي بِالوِلايَةِ ذو خَبَرِ",36,"ر",1,0],["فَلا جَوادٌ مِنَ الأَقوامِ يَعدِلُهُ","في الوَضعِ وَهوَ أَحَقُّ الناسِ أَن يَسَعا",37,"ع",2,0],["فَلا جودٌ غَداةَ ثَوَيتِ يُرجى","مَخيلَتُهُ وَلا كَرَمٌ يُشامُ",38,"م",1,0],["فَلا جادَها الغَيثُ مِن أَربُعٍ","وَلا بارَكَ اللَهُ فيها عِراصا",39,"ص",2,0],["فلا جمالٌ تروقُ العينَ بهجتُه","ولا عبيرٌ معَ الأرواحِ يأتينا",40,"ن",2,0],["فلا جامحٌ إلا لِعَلْياه جَانِحٌ","ولا صَائِلٌ إلا لِمَثْواه صَائِرُ",41,"ر",1,0],["فَلأجل ذَاكَ يُرَى القَتِيلُ ولا يُرَى","أَثَرٌ بِهِ مِن ذَابِلٍ وحُسَامِ",42,"م",1,0],["فَلأجعلنّ الحزنَ بَعدكَ مُؤنسي","وَلأجعلنّ الدمعَ فيك وِشاحيا",43,"ي",2,0],["فلا جود إلا ما أفادت يمينهُ","ولا نصر إلا ما أفاءت كتائبُه",44,"ب",2,0],["فَلأَجْعَلَنَّ ثناءَ مَا أَوْلَيْتُما","زاداً لكُلِّ مكَوِّفٍ أَوْ مُنجِدِ",45,"د",1,0],["فلا جرماً ما ناصفَت في حسابِها","سوى أن ملِلْتم والملالُ تَجَرُّمُ",46,"م",1,0],["فلأجزينَّك خيرَ ما جازَى امرؤٌ","وجَدَ المقال فقالَ وهو مُجيدُ",47,"د",1,0],["فلا جرَّ رزقٌ غِبطةً وهو يُجتَدَى","ولا سَدَّ مالٌ خَلَّةً وهو يُوهبُ",48,"ب",1,0],["فلا جادها جفن من المزن سافح","ولازال عن سكانها الخوف والمحل",49,"ل",1,0],["فلأجلها أجفانهُ","وسنى وعاشقهُ مسهَّد",50,"د",1,0],["فلأجلها أضحى الوصالُ تكلفاً","والعتبُ مذقاً والودادُ تملقا",51,"ق",2,0],["فلا جفَّ غَرْبُ العينِ أن بانَ حيُّها","وسارتْ بها اِبْلٌ نواحلُ سُهَّمُ",52,"م",1,0],["فلا جنسا ولا دينا","يداجي الكل نهاما",53,"م",2,0],["فلا جَرَم اعتضنا من الخز حزنه","وسرنا حفاة حُسّراً في المآتم",54,"م",1,0],["فلا جفن إلا ماؤه ثم يسفح","ولا نار إلا زندها ثم يقدح",55,"ح",1,0],["فَلا جَوٌّ نَشيم بهِ بروقاً","وَلا أَرضٌ نشمّ لَها تُرابا",56,"ب",2,0],["فلأجلِ ذا من كلِّ معنىً أطربُ","ما في المناهل منهل مستعذبُ",57,"ب",1,0],["فَلأَجْرُ السَّقامِ أَغْلَى وأَعْلى","وثَوابُ الآلاَمِ أَوْفَى وأَوْفَر",58,"ر",1,0],["فلا جزع مما قضى الله ربنا","وقد منح المولى متوبة ظابر",59,"ر",1,0]]}