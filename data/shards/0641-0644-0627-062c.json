369",""],[4862,"ولم تزل العبرات مخنوقه","https://www.poetsgate.com/ViewPoem.aspx?id=55632",""],[5092,"جفاء","https://www.poetsgate.com/ViewPoem.aspx?id=182904",""],[3591,"لم يبرح الفتك من جفنيك مشتغلا","https://www.poetsgate.com/ViewPoem.aspx?id=149457",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5183,"نهر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186612",""],[5213,"فلأجلبن على العذيب جحافلا","https://www.poetsgate.com/ViewPoem.aspx?id=170425",""],[5273,"في الفخر","https://www.poetsgate.com/ViewPoem.aspx?id=215879",""],[5431,"دمشق الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=197674",""],[5431,"الطاغية ....","https://www.poetsgate.com/ViewPoem.aspx?id=205781",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5830,"سَلِي العُرُوبَةَ","https://www.poetsgate.com/ViewPoem.aspx?id=200822",""],[5847,"في ظلال ميلاد النبي محمد صلى الله عليه وسلم 1431","https://www.poetsgate.com/ViewPoem.aspx?id=52777",""],[5966,"حلم الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=159347",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6142,"أنائحة مثلي على العرصة القفرا","https://www.poetsgate.com/ViewPoem.aspx?id=155746",""],[469,"أمذكري ظبيات سلع والنقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574810",""],[463,"تهوى وأنت محلأٌ مصدودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60041&r=&rc=97",""],[5190,"في المقهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78322&r=&rc=35",""]],"verses":[["فَلا جامِعاً مالاً وَلا مُدرِكاً عُلىً","وَلا مُحرِزاً أَجراً وَلا طالِباً عِلما",0,"م",2,0],["فَلَأَجعَلَنَّ عُقوبَتي أَبَداً","أَن لا أَمُدَّ يَداً إِلى أَحَدِ",1,"د",1,0],["فَلا جودَ إِلّا أَن تَمَلَّ مَطامِعٌ","وَلا عَفوَ إِلّا أَن يَطولَ عِقابُ",2,"ب",1,0],["فَلاَ جَحْدَ مَا خَوَّلْتَنِي مِنْ سَجَّيتِي","وَلاَ كُفْرَ نُعْمَاكَ الْعَمِيمَةِ مِنْ شَانِي",3,"ن",2,0],["فلا جفنَ إلاّ مرسلٌ سُحْبَ دمعه","ولا قلبَ إلا بالجوى يَتَلَهَّفُ",4,"ف",1,0],["فلا جسد يقوم بغير روح","ولا روح بلا جسد تقوم",5,"م",1,0],["فَلا جَزِعٌ إِن فَرَّقَ الدَهرُ بَينَنا","وَكُلُّ فَتىً يَوماً بِهِ الدَهرُ فاجِعُ",6,"ع",1,0],["فلا جناحٌ بمنهاضٍ إذا عضدت","من جانبيه ولا قلبٌ بمرتجف",7,"ف",1,0],["فلا جائرٌ فينا سوى ساق غادةٍ","ولا ظالمٌ إلاَّ من الأعين النجْل",8,"ل",1,0],["فلا جلّقٌ بالسهم تمنع قاصداً","ولا حلب الشهباء تلبس جوشنا",9,"ن",2,0],["فَلَأَجعَلَنَّ بَني كُلَيبٍ شُهرَةً","بِعَوارِمٍ ذَهَبَت مَعَ القُفّالِ",10,"ل",1,0],["فَلا جَناحٌ إِذا ما قالَ شاعِرُنا","لِلبَحرِ يا بَحرُ أَغلى الدُرِّ ما أَهَبُ",11,"ب",1,0],["فَلا جَزى اللَهُ خَيراً","يَوماً عَرَفناكَ فيهِ",12,"ي",2,0],["فَلا جَزعٌ مِن خَلَّةٍ مُتَكَثَّفٌ","وَلا مَرحٌ تَحتَ الغِنى أَتَخَيَّلُ",13,"ل",1,0],["فَلا جُزِيَت مِصرٌ لِذاكَ اِحتَقَرتُها","وَلَم تَرَ شَيئاً أَن جَرى تَحتَكَ البَحرُ",14,"ر",1,0],["فَلا جودَ إِلّا جودُهُ أَو كَجودِهِ","وَلا بَدرَ مالَم يوفِ عَشراً وَأَربَعا",15,"ع",2,0],["فَلأُجرِيَنَّ الدَمعَ إِن لَم تُجرِهِ","وَلأَعرِفَنَّ الوَجدَ إِن لَم تَعرِفِ",16,"ف",1,0],["فَلأجلِبَنَّ إليكَ كلَّ غَريبَةٍ","تُضْحى الكِرامُ لها من العُشَّاقِ",17,"ق",1,0],["فلا جودَ إلاّ ما تُفيدُ يمينُه","ولا مجدَ إلاّ ما تَشيدُ وقائِعُه",18,"ع",2,0],["فَلا جارَكَ العافي تَناوَلَ مَحلُها","وَلا عِرضَكَ الوافي تَناوَلَ عارُها",19,"ر",3,0],["فَلا جَزَعٌ إِن رابَ دَهرٌ بِصَرفِهِ","وَبَدَّلَ حالاً فَالخَطوبُ كَذَلِكِ",20,"ك",1,0],["فلا جالت الفرسانُ إلا لنصره","ولا حملتها المقرباتُ الصواهل",21,"ل",1,0],["فلا جُودَ إلاّ بالجَزيلِ لآمِلٍ","ولا عَفْوَ إلاّ أن تَجِلّ الجَرائم",22,"م",1,0],["فَلا جَوَادٌ صَاهِلٌ عَزَّهُمْ","يَوْمَاً وَلا خَيْفَانَةٌ شَاخِرَهْ",23,"ر",2,0],["فَلا جَوَّ إِلَّا سَمْهَرِيٌّ وقاضِبٌ","وَلا أَرْضَ إِلَّا شَمَّرِيٌّ وَسابِحُ",24,"ح",1,0],["فَلا جمشِيدُ دَافَعَ إِذْ أَتَتْهُ","بِحَادِثِها وَلا رَبُّ الدِّرَفْسِ",25,"س",1,0],["فَلا جَهْرُهُ سِرٌّ وَلا سِرُّ صَدْرِهِ","إِذَا امْتَحَنَ الْوَاشِي ضَمَائِرَهُ جَهْرُ",26,"ر",1,0],["فَلأَجْعَلَنَّ كِتَابَهَا","حَتَّى أُحَقِّقَهُ إِمَامِي",27,"م",2,0],["فلا جبرت حداه ان ظل مغمدا","وهندي هند منجد ومغير",28,"ر",1,0],["فلا جيت بيت الصاحب .. الضفر .. الشلي","اللي حروفه ... بالتهايم... شايعه",29,"ع",2,0],["فلا جَزَعٌ من خِلةٍ مُتكشِّفٌ","ولا مَرِحٌ تحت الغِنى أتخيلُ",30,"ل",1,0],["فلا جلدي مهما صبرت بنافع","ولا لهفتي في طي سري تضمر",31,"ر",1,0],["فلا جل نفس ألف نفس تفتدي","ومقامها منهم أجل وأعظم",32,"م",1,0],["فَلاَ جَزَعٌ إذَا انفِرَادِى قَد يَبدُو","بَلِ الرُّشدُ إفرَادِى إذَا انفَرَد العَبدُ",33,"د",1,1],["فلا جزعٌ فالفَردُ مَع كُلِّ مُفرَدٍ","ولم يَكُ فَرداً من يَكُن مَعَهُ الفَردُ",33,"د",1,0],["فَلِأَجلِ ذا مَدّوا إِلَيكَ رِقابَهُم","يَرجونَ أَن تَرضى وَما أَولاكا",34,"ك",2,0],["فلا جزعٌ ولا هلعٌ مشينٌ","ومنّا الغدرُ أو كذبٌ محال",35,"ل",1,0],["فَلا جِهةٌ تحويهِ لا جهةٌ له","تَنزّهَ ربّي عَنهما وَعلا قدرا",36,"ر",2,0],["فَلا جَعَلَ اللَهُ الوُلايَةَ سِبَة","عَلَيهِ فَإِنّي بِالوِلايَةِ ذو خَبَرِ",37,"ر",1,0],["فَلا جَوادٌ مِنَ الأَقوامِ يَعدِلُهُ","في الوَضعِ وَهوَ أَحَقُّ الناسِ أَن يَسَعا",38,"ع",2,0],["فَلا جودٌ غَداةَ ثَوَيتِ يُرجى","مَخيلَتُهُ وَلا كَرَمٌ يُشامُ",39,"م",1,0],["فَلا جادَها الغَيثُ مِن أَربُعٍ","وَلا بارَكَ اللَهُ فيها عِراصا",40,"ص",2,0],["فلا جمالٌ تروقُ العينَ بهجتُه","ولا عبيرٌ معَ الأرواحِ يأتينا",41,"ن",2,0],["فلا جامحٌ إلا لِعَلْياه جَانِحٌ","ولا صَائِلٌ إلا لِمَثْواه صَائِرُ",42,"ر",1,0],["فَلأجل ذَاكَ يُرَى القَتِيلُ ولا يُرَى","أَثَرٌ بِهِ مِن ذَابِلٍ وحُسَامِ",43,"م",1,0],["فَلأجعلنّ الحزنَ بَعدكَ مُؤنسي","وَلأجعلنّ الدمعَ فيك وِشاحيا",44,"ي",2,0],["فلا جود إلا ما أفادت يمينهُ","ولا نصر إلا ما أفاءت كتائبُه",45,"ب",2,0],["فَلأَجْعَلَنَّ ثناءَ مَا أَوْلَيْتُما","زاداً لكُلِّ مكَوِّفٍ أَوْ مُنجِدِ",46,"د",1,0],["فلا جرماً ما ناصفَت في حسابِها","سوى أن ملِلْتم والملالُ تَجَرُّمُ",47,"م",1,0],["فلأجزينَّك خيرَ ما جازَى امرؤٌ","وجَدَ المقال فقالَ وهو مُجيدُ",48,"د",1,0],["فلا جرَّ رزقٌ غِبطةً وهو يُجتَدَى","ولا سَدَّ مالٌ خَلَّةً وهو يُوهبُ",49,"ب",1,0],["فلا جادها جفن من المزن سافح","ولازال عن سكانها الخوف والمحل",50,"ل",1,0],["فلأجلها أجفانهُ","وسنى وعاشقهُ مسهَّد",51,"د",1,0],["فلأجلها أضحى الوصالُ تكلفاً","والعتبُ مذقاً والودادُ تملقا",52,"ق",2,0],["فلا جفَّ غَرْبُ العينِ أن بانَ حيُّها","وسارتْ بها اِبْلٌ نواحلُ سُهَّمُ",53,"م",1,0],["فلا جنسا ولا دينا","يداجي الكل نهاما",54,"م",2,0],["فلا جَرَم اعتضنا من الخز حزنه","وسرنا حفاة حُسّراً في المآتم",55,"م",1,0],["فلا جفن إلا ماؤه ثم يسفح","ولا نار إلا زندها ثم يقدح",56,"ح",1,0],["فَلا جَوٌّ نَشيم بهِ بروقاً","وَلا أَرضٌ نشمّ لَها تُرابا",57,"ب",2,0],["فلأجلِ ذا من كلِّ معنىً أطربُ","ما في المناهل منهل مستعذبُ",58,"ب",1,0],["فَلأَجْرُ السَّقامِ أَغْلَى وأَعْلى","وثَوابُ الآلاَمِ أَوْفَى وأَوْفَر",59,"ر",1,0],["فلا جزع مما قضى الله ربنا","وقد منح المولى متوبة ظابر",60,"ر",1,0],["فَلِأَجلِ ذَلِكَ قَلَّدَتهُ دُمُوعُهُ","دُرراً وَحَلّاهُ الضَنى بنُضارِهِ",61,"ر",2,0],["فلا جور في غير الحسان محكم","ولا سيف في غير اللحاظ مجرد",62,"د",1,0],["فلا جند بغير المال يُغني","ولا بالعكس نيلُ الملك يُدْرَى",63,"ر",2,0],["فلا جو كالجو الصقيل بأفقنا","وذاك الهواء الغض كالملمس اللدن",64,"ن",1,0],["فلا جل ذلك لا قيام لكافرٍ","في الدّين مثل قيام ذي طهرٍ وبرْ",65,"ر",1,0],["فلا جريت ولا روّيت ذا ظمأ","ولا أمدك غيث واكف همع",66,"ع",1,0],["فلاجل ذلك ذا تتوج رأسه","اجر الامين وذا تتوق جدا",67,"د",2,0],["فلا جود إلا حزتموا بصَنيعِكم","ولا مجد إلاّ حزتموا بالتّوقّلِ",68,"ل",1,0],["فلأجلِ ذا لم تلفني بمُتَيَّمٍ","في وَجنةٍ ولها العذارُ شِعارُ",69,"ر",1,0],["فلا جوّ إلا وهو أسودُ مُظلمٌ","ولا أرضَ إلا وهي مُوحشة فَلُّ",70,"ل",1,0],["فلا جزعٌ هناك ولا اصطبار","ولا صمت تقول ولا صياح",71,"ح",1,0],["فلأجل ذا ذنب الردى","في جعفر أرخت يغفر",72,"ر",1,0],["فَلِأَجلِ أَنَّكَ ما حَيِيتَ وَإِنَّما","يُخشى عَلَيكَ مَدى الزَمانِ وَيُحكَمُ",73,"م",1,0],["فلا جرم أن يهتضم","وهي الهمم ليست قِسَم",74,"م",1,0],["فلأجلها اكتست الأباطح والربا","وشياً من الروض الأريض مزخرفا",75,"ف",2,0],["فلأجهدن إلى علاك حوادثاً","ألقت بآمال إليك ومطلب",76,"ب",1,0],["فلا جُرعت بعد اليوم رُزْءاً","يريك الصبرَ ممنوعَ اللزام",77,"م",1,0],["فَلأجلِ هَذَا خَصَّ يُونُسَ دُونَهُم","بالذِّكرِ تَحقِيقاً لهَذَا الشَّانِ",78,"ن",1,0],["فلأجلِ ذَا قَالوا التسلسُلَ بَاطِلٌ","والجِسمُ لا يخلو عَن الحِدثَانِ",78,"ن",1,0],["فَلأجلِ هَذَا قَد عَزَلنَاهَا وَوَلَّي","نَا العُقُولَ وَمَنطِقَ اليُونَانِ",78,"ن",1,0],["فَلأجلِ ذَاكَ نَبَذُوا الكِتَابَ وَرَاءهُم","وَمَضَوا عَلى آثارِ كُلِّ مُهَانِ",78,"ن",1,0],["فَلأجلِ هَذَا لَم نُحَكِّم إن شِئتُم","أو فَاقبَلُوا آراءَ عَقلِ فَلاَنِ",78,"ن",1,0],["فَلأجلِهِ افتَرَقَا فَلاَ يَتَلاَقَيَا","حَتَّى يَزُولَ إذاً فَيَلتَقِيانِ",78,"ن",1,0],["فَلا جُرأة منّي فأهجم لاثِماً","وَلا رَحمة مِنهُ فَيَرحَم من قَتل",79,"ل",1,0],["فلا جسمي مع الشبان يجري","ولا روحي تقيم مع الشيوخ",80,"خ",1,0],["فلا جمال ولا نور ولا متع","ولا حياة بها عيش وأعمار",81,"ر",1,0],["فَلا جُوعٌ وَيُمْناهُ الغَوادِي","وَلا خَوْفٌ وَقَتْلاهُ الليوثُ",82,"ث",1,0],["فلا جليسٌ غير زهر الرّبى","ولا أنيسٌ غير صوت الهزار",83,"ر",1,0],["فلا جرت الايام نحوك كارثاً","ولا زلت طول الدهر مبتسم الثغرِ",84,"ر",1,0],["فلا جُرمَ إلا ما بهِ العقلُ حاكمٌ","ولا غَروَ أَنَّ الجُرمَ من دونهِ سُدَى",85,"د",2,0],["فَلا جسم إِلا من تراب لمثله","وَبينهما دورٌ لذي الآدمية",86,"ه",1,0],["فَلأجل ذا أَغلقت با","بَ القَول عَلِّي أَستريح",87,"ح",1,0],["فلا جاور الشرق امرؤ يصطفي له","عدوًّا لآمال الشعوب معاديا",88,"ي",2,0],["فلا جزع مما قضى اللَه فاصطبر","وإلا ستسلو مثل شلو البهائم",89,"م",1,0],["فلا جاوزت مغناك يوماً صواعقٌ","ولا جاده هامٍ من المزن مغدق",90,"ق",1,0],["فلا جللٌ إلا جلاء محنكٌ","ولا خطرٌ إلا ثناه خطير",91,"ر",1,0],["فلا جيش للأعداءِ إِلاّ هزمتُه","ولا قُطْر إلا جُست بالغزَواتِ",92,"ت",1,0],["فلأجل ذا قد عشت فيه مفرداً","ما جازني فيه فتى إلا عمِى",93,"م",2,0],["فلا جسمَ إِلاّ بالبواتر مُقْصَدٌ","ولا قلبَ إِلاّ بالنواظر مقصود",94,"د",1,0],["فلا جارهم يحمى إذا عن فادح","ولا نارهم تهدى إلى ام طارق",95,"ق",1,0],["فلا جَدُّ السُرى يجدي سُلوّاً","وَشمس الكون محجوبٌ ضياها",96,"ا",3,0],["فلا جيد من غيداء يشفي عناقها","غليل صباباتي ولا شفة لميا",97,"ي",2,0],["فَلا جَزى اللَّهُ عجلاً","وَالعُصبَةَ الدُلفِيَّهْ",98,"ي",2,0],["فلأجلِ ذلةِ ذا وعزةِ هذه","يبكى الغمام ويبسم النوارُ",99,"ر",1,0],