اجعة","https://www.poetsgate.com/ViewPoem.aspx?id=213662",""],[5324,"كفى للعنف .","https://www.poetsgate.com/ViewPoem.aspx?id=207662",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[5348,"الخطب الجليل","https://www.poetsgate.com/ViewPoem.aspx?id=59566",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5430,"وداعا سماحة الشيخ","https://www.poetsgate.com/ViewPoem.aspx?id=1444",""],[5431,"ويملكني جميل الروح سهلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187535",""],[5539,"على الله","https://www.poetsgate.com/ViewPoem.aspx?id=199247",""],[5629,"أحلامنا","https://www.poetsgate.com/ViewPoem.aspx?id=184505",""],[5670,"دِيارٌ هجرناها !","https://www.poetsgate.com/ViewPoem.aspx?id=211212",""],[5690,"إذا ما المجد داريهِ الكلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172178",""],[5691,"شدّوا الحزام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207057",""],[5704,"المذاهب الاربعه...","https://www.poetsgate.com/ViewPoem.aspx?id=200005",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[6031,"وراءَ كُما إنَّ المُصَابَ جَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46289",""],[6115,"رحمك الله يابو حاتم","https://www.poetsgate.com/ViewPoem.aspx?id=180484",""],[6152,"زايد بن سلطان آل نهيان حكيم العرب","https://www.poetsgate.com/ViewPoem.aspx?id=203346",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6187,"أتذكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82158&r=&rc=2",""],[5126,"فكرة مُختلطة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87818&r=&rc=33",""]],"verses":[["فَقَد نَضَبَتْ بَشاشَةُ كُلِّ عَيشٍ","غَزيرٍ دَرُّهُ شَرِقِ الضُروعِ",0,"ع",1,0],["فَقَد نَكأَتْ قَرحاً رَجَوتُ اندِمالَهُ","بِقَرحٍ فَزِيدَ القَلبُ كَرباً عَلى كَربِ",1,"ب",1,0],["فقدْ نَزَعَتْ وَلْهَى إلَيْكَ وخيّمَتْ","بخَيْرِ فَتىً واسْتَوْطَنَتْ خَيْرَ مَنصِبِ",2,"ب",1,0],["فقد نَضَوْتُ بها الأيّامَ ناضِرَةً","تُغْني عنِ السَّحَرِ الأعلى لَياليها",3,"ي",3,0],["فقد نَمَتْكَ جِيادٌ لا تُلِمُّ بها","حتى تَرى السُّمْرَ مُحْمَرّاً عَواليها",3,"ي",3,0],["فقَدْ نَزَتْ بِطَنٌ ما تَحتَها فِطَنٌ","بالعاجِز الوَغْدِ والهَيَّابَةِ الوَكَلِ",4,"ل",1,0],["فَقَدناكَ فِقدانَ السَحابَةِ لَم يَزَل","لَها أَثَرٌ يُثني بِهِ السَهلُ وَالوَعرُ",5,"ر",1,0],["فقدنا الذي قد كان في العلم عيلما","فماجت لمنعاه البحار العيالم",6,"م",1,0],["فقدنا به شيخ البرلمان ينجلي","به ليلة الداجي إذا قام يخطب",7,"ب",1,0],["فقدنا منك خير زعيم قوم","وخير نضيج تجربة حنيك",8,"ك",1,0],["فقدنا به صلت الجبين مهذّباً","كريم سجايا النفس عفّ المؤزّز",9,"ز",1,0],["فَقَد نَرتَعي سَبتاً وَلَسنا بِجيرَةٍ","مَحَلَّ المُلوكِ نُقدَةً فَالمَغاسِلا",10,"ل",2,0],["فقدناهُ فقدانَ الربيعِ فدهرنا","جمادى وزالَ المستماح المرجب",11,"ب",1,0],["فقدنا بني الدنيا فلما تلفتَّت","وجوهُ أمانينا فقدنا بني الأخرى",12,"ر",2,0],["فقدناه مشكور المساعي منزهاً","عن الوزر إن أودى بذي تربة وزر",13,"ر",1,0],["فقدناه فيّاض المكارم واللهى","يشفّ ضياء المجد بين خلاله",14,"ل",2,0],["فقدنا لأعناق البرية مالكاً","وشمنا لأنواع الجميل متمما",15,"م",2,0],["فقد نالني بعضُ الذي رضخُوا به","فهل لك في أن تُرحضَ الشكَّ مَرحضا",16,"ض",2,0],["فقدناكِ فاسْوَدَّتْ عليكِ قلوبُنا","وحُقَّتْ بأن تسودَّ وابيضَّتْ اللِّمَمْ",17,"م",1,0],["فَقَد نَكونُ كِراماً ما نُضامُ وَقَد","يَنمي لَنا قَبلَ مَرجِ الصُفَّرِ الظَفَرُ",18,"ر",1,0],["فَقَد نَعاهُ إِلَيكِ الفَجرُ مُرتَعِشاً","وَلَيسَ مَنعاهُ إِلّا بَعضَ مَنعاكِ",19,"ك",1,0],["فَقَد نظرت إِلَيهِ عُيونُ نَحسٍ","مَضَت مِنهُ بِمَعدومِ النَظيرِ",20,"ر",1,0],["فَقَدنا بِمَفقودِكُم شاعِراً","يَقِلُّ الزَمانُ لَهُ راوِيَه",21,"ي",2,0],["فَقَد نَظَرتُكَ حَتّى حانَ مُرتَحَلي","وَذا الوَداعُ فَكُن أَهلاً لِما شيتا",22,"ت",2,0],["فَقَدنا يَهودِيَّ قُطرُبُّلٍ","وَما فَقدُناهُ بِإِحدى الكُبَر",23,"ر",1,0],["فَقَدناكَ فِقدانَ الحَياةِ وَأَقبَلَت","تُلاحِظُنا خُزراً إِلَينا القَبائِلُ",24,"ل",1,0],["فَقَد نَقَضَ الأَيّامُ بَعدَ مُحَمَّدٍ","عَلى القَومِ مِن مِرّاتِهِم كُلَّ مُبرَمِ",25,"م",1,0],["فقد نَضَبَت غُدْرُ الكَلامِ وأصبحَت","كِعابُ القَوافي الغُرِّ بعدَك أَيِّما",26,"م",2,0],["فقد نُتِفَتْ لِحاكَ بها ولاقَت","صُنوجُكَ بعدَها خَطْباً فَظيعا",27,"ع",2,0],["فقد نَبَشَتْ شآبيبُ الغَوادي","عليهِنَّ النمارِقَ والقُطوعا",27,"ع",2,0],["فقَد نشرَ الصُّبحُ أعلامَه","وحانَ لكاساتِها أن تَدورا",28,"ر",2,0],["فَقَد نَقلاه عن بياضِ مَناسبي","إلى نَسَبِ في الخالديَّةِ أسودَا",29,"د",2,0],["فقد نشرَ الثَّناءَ عليك منه","خطيبٌ ليس يُشْبِهُه خَطيبُ",30,"ب",1,0],["فَقَد نَزَلَت بِالمُسلِمينَ مُصيبَةٌ","كَصَدعِ الصَفا لا صَدعٍ لِلشَعبِ في الصَفا",31,"ا",1,0],["فَقَد نَعى اللَيلَ بَشيرُ الصَباحِ","باكِر فَطَرفُ الدَهرِ في غَفلَةٍ",32,"ه",1,0],["فَقَد نَزَلَ المُرتادُ مِنهُ بِماجِدٍ","مَواهِبُهُ غَورٌ وَسُؤدُدُهُ نَجدُ",33,"د",1,0],["فَقَدْنَاهُ فِقْدَانَ الظِّمَاءِ شَرَابَهُمْ","بِدَيْمُومَةٍ وَالْوِرْدُ لَيْسَ بِدَانِي",34,"ن",2,0],["فقدناك أدهى من نحب فجيعة","وأوجع من نرجو البقاء له فقدا",35,"د",2,0],["فَقَدنا الظَهيرَ فَقَدنا النَصيرَ","فَقَدنا المُجيرَ فَقَدنا العِمادا",36,"د",2,0],["فَقَدنا المَضاءَ فَقَدنا الوَفاءَ","فَقَدنا الإِباءَ فَقَدنا السَدادا",36,"د",2,0],["فَقَد نَشَرَ الصَباحُ رِداءَ نورٍ","وَهَبَّت بِالنَدى أَنفاسُ ريحِ",37,"ح",1,0],["فَقَدْ نَسَفَ التِّلالَ الحُمْرَ نَسْفاً","وَلَمْ يَتْرُكْ بِعَرْصَتِها جُرُونا",38,"ن",2,0],["فقُدْنا إلى الوَحشِ أشْباهَها","ورُعْنا المها فوقَ مثلِ المَها",39,"ا",1,0],["فَقَد نَدِمتُ عَلى ما كانَ مِن خَطَلٍ","وَمِن إِضاعَةِ مَكتوبِ المَواقيتِ",40,"ت",1,0],["فَقَد نَسيتُ وَقَلبي في صَبابَتِهِ","كَأَنَّهُ عِندَها حَيرانُ في سَبَبِ",41,"ب",1,0],["فقد نزع المثرين من عقرِ مالهم","كأنهمُ من قبل ذلك لم يثروا",42,"ر",3,0],["فقدنا بك الأفراحَ وَالجاهَ وَالغنى","جَميعاً فأنف العيش بعدك أَجدع",43,"ع",1,0],["فقد نظرتك حتى حان مرتحلٌ","وذا الوداع فكن أهلاً لما شيتا",44,"ت",2,0],["فقَدْنَ رِجالاً وافْتَقَرْنَ عَشِيّةً","إلى لُبْسِ أدْراعِ الحَديدِ على رَغْم",45,"م",1,0],["فَقَدْ نَسَمَتْ رِيحُ الشَّمالِ فَنَبَّهَتْ","عُيُونَ الْقَمَارِي وَهْيَ فِي سِنَةِ الْفَجْرِ",46,"ر",1,0],["فَقَدْنَاهُ فِقْدَانَ الشَّرَابِ عَلَى الظَمَا","فَفِي كُلِّ قَلْبٍ غُلَّةٌ لَيْسَ تُنْقَعُ",47,"ع",1,0],["فَقَد نَبَحتني كِلابُ العِدى","وَدَبَّت عَقارِبهم نُشَّظا",48,"ظ",2,0],["فقَدْنا الربيعَ أبا جعفرٍ","فلا دَرَّ خِلْفٌ على حالِبِ",49,"ب",1,0],["فقد نُبِذْنَ مَنْبَذَ الرِّباذِ","وهُنَّ إذ رُوِّعْنَ بانتِباذِ",50,"ذ",1,0],["فَقَدْناهُ فِقدانَ الكَمِيِّ سلاحَه","وما بين قِيدِ الرمحِ والرمحِ إِصْبع",51,"ع",1,0],["فقدناه حتى قد فقدنا وجودَنا","فهل بَقِيَتْ إلاّ جُفونٌ وأدمع",51,"ع",1,0],["فقدناه فِقْدانَ الأليفِ أليفَه","يصيحُ به في كل روضٍ ويسجَع",51,"ع",1,0],["فقدناه ريَّانَ الشبابِ تضوَّعت","شمائلُه مِسكاً وآثارُه نَدّا",52,"د",2,0],["فقدناه والأحْداثُ تَغْشَى غُيُومُها","وتنتظمُ الآفاق عابسةً رُبْدا",52,"د",2,0],["فقدناه والآمالُ تومي بإِصْبَعٍ","إليه وتمتدُّ العُيونُ له مَدّا",52,"د",2,0],["فقدناه أزهَى ما نكونُ بمثله","وأعلَى به كعباً وأقَوى به زَنْدا",52,"د",2,0],["فقدناه سيفاً هاشمياً إذا سطت","سيوفُ الليالي كان أرهفَها حدّا",52,"د",2,0],["فَقدْنَا به زَيْنَ الْفَوَارِسِ إِن رَمَى","أَصَابَ وإِنْ يُرْخِ الْعِنَانَيْنِ يَسْبِقِ",53,"ق",1,0],["فقَدناك فقدَ الغريب الدليلَ","فَقَدناك فقد الفلاةِ المطر",54,"ر",1,0],["فقدناك فقد النواظر نورها","وكنت لنا نورا يضيء لمن يسري",55,"ر",2,0],["فقد نافسَتْ بغدادُ بطحاء مكّةٍ","وقد غبرَّت بغدادُ في وجهِ جِلَّق",56,"ق",1,0],["فقدنا الحليفه … مذّ باعنا","إلى كلّ سوق … جنود الخليفه",57,"ف",2,0],["فقد نعاه إليك الفجر ترتعشا","وليس منعاه إلاّ بعض منعاك",58,"ك",1,0],["فقد نزلت بذلي في حماه وقد","أخذته في الورى ركناً ومعتمدا",59,"د",2,0],["فقد نامَ نوماً","بلا يَقظةِ",60,"ه",1,0],["فَقَدنا عَميدَ الحَيِّ فَالرُكنُ خاشِعٌ","لِفَقدِ أَبي عُثمانَ وَالبَيتُ وَالحِجرُ",61,"ر",1,1],["فقد نزل الكرى ضيفاً بجفني","وأغراهُ القِرى أن لا يزولا",62,"ل",2,0],["فَقَد نَزَلَت رَسائِلُكَ المَواضي","مَكاناً مِن قُلوبِهِمُ مَكينا",63,"ن",2,0],["فَقَدناهُ فِقدانَ الصُدورِ قُلوبَها","عَلى أَنَّنا بِالدَمعِ وَالذِكرِ نَستَشفي",64,"ي",1,0],["فَقَدناهُ يَشفي كُلَّ داءٍ لَنا عَيا","يَخُصُّ عَلى الإِخلاصِ يَنهى عَنِ الريا",64,"ي",2,0],["فَقَد نُبّهَ الساهي وَغيثَ المُغَوِّثُ","عَفا مُذ أَتى رَسمُ الضَلالَةِ واِنمَحى",65,"ح",2,0],["فقد نحلت أجسادهم وأذابها","قيام لياليهم وصوم الهواجر",66,"ر",1,0],["فَقَد نِلتُ المُنى غَضّاً بِجِدٍّ","وَعَزمٍ لا يَقِرُّ عَلى قَرارِ",67,"ر",1,0],["فَقَد نامَتِ الأَحيا عَنِ الغَزوِ فَاِستَوى","بِكُلِّ سَبيلٍ أُسدُهُ وَخَياطِلُه",68,"ل",2,0],["فَقُدنا الخَيلَ تَعثُرُ فى قَناها","عَوَابِسَ كَالسَّعالِى قَد وجِينَا",69,"ن",2,0],["فقد نال المحاَمد والمعالى","بِجِد واجْتهادٍ واكتساب",70,"ب",1,0],["فقد ناداهمُ جَدْواك حتى","حَداهم نحوه سَعْى وركض",71,"ض",1,0],["فقد نعمنا على ذكراك آونةً","بسائغٍ من نمير الوصل معسول",72,"ل",1,0],["فقدناكَ والأيامُ سودٌ عوابسٌ","وكنت بليلاتٍ يُضِئُ لها سِفْرُ",73,"ر",1,0],["فقد نبأتني بما لم يدر","ببالي وها هو حقاً وقع",74,"ع",1,0],["فقدنا بفقدانه سيدا","لخدمة أوطانه شمرا",75,"ر",2,0],["فَقَدناكَ فُقدانَ الكَمِىِّ سِلاحَه","وَسارى الدِياجي كَوكَبَ القُطبِ هادِيا",76,"ي",2,0],["فقد نال مني منع طيفك مثلما","شجاني من البيت المطوح ما شجا",77,"ج",2,0],["فقدنَاكَ فُقدانَ الرضيعِ لأُمِّه","ولَم يَبقَ مَن يحنُو عليه ويَحدَبُ",78,"ب",1,0],["فَقَد نَقَضَ التِراتِ وَقَد شَفاها","وَخَلّانا لِتَشرابِ الخُمورِ",79,"ر",1,0],["فقدناه حبراً دونه البحر وارتدى","رداء الردى مع فضله وتدرعا",80,"ع",2,0],["فقَدنا جمالاً منكِ لن نستردَّهُ","فكيفَ وقد أعطيتِه اللهَ في صَكّ",81,"ك",1,0],["فَقَد نَشَرَ المَشيبُ كِتابَ صَدِّ ال","أَحِبَّةِ وَانطَوَت صُحُفُ العِتابِ",82,"ب",1,0],["فقدْنا الجدَّ بل والهزلَ فيها","وَأشخاصُ الروايةِ أَغبياءُ",83,"ا",2,0],["فَقَدنا جَميعَ الخَيرِ لَمّا تَرَحَّلوا","وَمِنهُ خَلا وَعرَ البَسيطَةِ وَالسَهلِ",84,"ل",1,0],["فَقدناهُ فقدَ الشمسِ في ساعةِ الضّحى","وَفقد زلالٍ طابَ باليمن والرفدِ",85,"د",1,0],["فَقَدنا أَديباً كانَ طرس يراعه","إِذا خَطّ سَطراً نالَ مِن حَظِّهِ شطرا",86,"ر",2,0],["فَقَدنا مِن الأَبرار مَولى صِفاتهُ","وَأَوصافه الحُسنى نهى وَمَحامدُ",87,"د",1,0],["فقد نهبَتْ صَبرِي من الصَّدر مَوهناً","طليعةُ بَينٍ جَالبٍ جيشَه الغَد",88,"د",1,0],["فَقَد نَفَضَ الدَمعُ المورَّد صَبغهُ","عَلى أَرض خَدي مثل ما يَشتَهي نَفضا",89