{"poems":[[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9911","الوافر"],[184,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[368,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[488,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/22635","الطويل"]],"verses":[["وَخَثعَمُ قَد صَبَحناها صَباحاً","بُكوراً قَبلَ ما نادى المُنادي",0,"د",2,0],["وَخَثعَمُ قَومِى ما مِنَ النّاسِ مَعشَرٌ","أَعَمُّ نَدًى مِنهُم وَأَنجَى لِخائِفِ",1,"ف",1,0],["وَخَثعَمُ لُثِّموا حتى أَقَرُّوا","بخَرجٍ في مَواشيهم ورِفدِ",2,"د",1,0],["وَخَثعَمَ في أَيّامِ ناسٍ كَثيرَةٍ","هَمَطناهُمُ هَمطَ العَزيزِ المُؤَسَّرِ",3,"ر",1,0],["وَخَثعَمَ أَروَيتُ القَنا مِن دَمائِها","بِشَفّانَ حَتّى سالَ كُلَّ مَسيلِ",4,"ل",1,0]]}