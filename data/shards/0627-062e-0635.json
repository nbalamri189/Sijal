{"poems":[[73,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[88,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[88,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[72,"أحمر الخد زاد منه لهيبي","https://www.aldiwan.net/poem18250.html","الخفيف"],[66,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[126,"سلام يسلى الفؤاد الشغيل","https://www.aldiwan.net/poem50534.html","المتقارب"],[126,"سلام وتسليم وألف تحية","https://www.aldiwan.net/poem50599.html","الطويل"],[126,"سلام كماء الورد ديف بعنبر","https://www.aldiwan.net/poem50608.html","الطويل"],[126,"تعلم العلم حقا يا فتى عمر","https://www.aldiwan.net/poem50614.html","البسيط"],[126,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50661.html","الطويل"],[126,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50665.html","الطويل"],[132,"ألا ليت حظي من حياطة نصركم","https://www.aldiwan.net/poem21010.html","الطويل"],[163,"قفا فاسمعا أخبركما إذا سألتما","https://www.aldiwan.net/poem720.html",""],[184,"دعوه يبكي لفقد خلانه","https://www.aldiwan.net/poem43249.html","المنسرح"],[195,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[209,"لقد جاء يوم العيد والقلب بالجوى","https://www.aldiwan.net/poem46775.html","الطويل"],[273,"سلام كما افتر الربيع عن الورد","https://www.aldiwan.net/poem25578.html","الطويل"],[362,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[369,"عسى بعض هاتيك العوائد عائد","https://www.aldiwan.net/poem57499.html","الطويل"],[374,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[400,"قد رأينا ما دار في الريحان","https://www.aldiwan.net/poem33368.html","الخفيف"],[426,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[426,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[435,"جمرة من صدى صوتها","https://www.aldiwan.net/poem505.html",""],[456,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[462,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[475,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[551,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[556,"جئنا إلى الحسن المعروف بالراعي","https://www.aldiwan.net/poem34367.html","البسيط"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["أُخَصُّ لِفَهمي بِالقِلى وَكَأَنَّما","يَبيتُ لِذي الفَهمِ الزَمانُ عَلى ذَحلِ",0,"ل",1,0],["أخصب الله أرضه ولو أنّي","لست أرعى رياضه ومروجه",1,"ج",2,0],["أخْصِ في العلم إن أردت كمالاً","ووصولاً إلى الفَخار الأتمّ",2,"م",1,1],["أخصب الدمع كل حي كما أخ","صب جود الوزير كل جديب",3,"ب",1,0],["أَخصَبَت عِندَ شُربِها ساحَةُ العَي","شِ وَأَمسى أَحوى الهُمومِ هَشيما",4,"م",2,0],["أخْصَبَ العَيْشُ عِنْدَهَا بعدَ مَحْلٍ","إذ غَدا للنبيِّ منها غِذاءُ",5,"ا",2,0],["أَخصَبَت عِندي وَإِنّي","عِندَها غَيرُ خَصيبِ",6,"ب",1,0],["أخُصّ بها من كُلّ حَيّ عَمِيدَهُ","وأصْرِفُها مُسْتكبِراً عن طَغامهِ",7,"م",2,0],["أَخُصُّ بِالشِّعْرِ أَحْبَابِي وَأُكْرِمُهُ","عَنْ أَنْ يَكُونَ مُدَاجَاةً وَمُزْدَلَفَا",8,"ف",2,0],["أخصُّ به الوالي المرتضَى","بشيراً حليفَ العطاء الجزيلْ",9,"ل",1,0],["أخصُّ به الزاكى سلالة ماجد","محمد الحامى هو الباسلُ الذَّمرُ",10,"ر",1,0],["أخصُّ به الشيخ الولى أخا الرضى","فتَى الجودِ والجدوى وأهل التفكرِ",11,"ر",1,0],["أخُصُّ بالنصح محمودَ اللقاء لنا","أعنى بذاكَ سليماناً فتَى عِبرِ",12,"ر",1,0],["أخصُّ به الزاكي الكريم محمداً","فتى المجد والنَّدْبُ الشجاع المجرَّبُ",13,"ب",1,0],["أخصُّ به الزاكى الكريم محمداً","فَتى ماجدٌ ندبٌ شجاعٌ مُجرِّبُ",14,"ب",1,0],["أَخصُّ خُصوصاً عَبدَ شَمسٍ وَنَوفَلا","هُما نَبَذانا مِثلَ ما نُبِذَ الجَمرُ",15,"ر",1,0],["أخصيي حمار بات يكدم نجمة","أتا كل جاراتي وجارك سالم",16,"م",1,0],["أخصمني والذي أؤمّلُه","لعفوه في غد وغفرانه",17,"ن",2,0],["أخصرةٌ أنا مالي لا تحرّكني","هذي المدام ولا تلك الأغاريد",18,"د",1,0],["أخٌ صادقٌ والصدق بعض خلاله","ولم يك فيه للملامة موضِعُ",19,"ع",1,0],["أخُصُّ به مَثْوى أبي الحَسَن الذي","تكُنُّ الحَشا مِن حُبهِ ضعفَ ما تبدِي",20,"د",2,0],["أخصَّ سِواهُ بعِلْمِ الكتاب","كما خَصَّ كُلاً بما قد رأى",21,"ا",1,0],["أخَصمي من الأيام ينجدُني على","خِصام الهوى تلكَ الأماني الأباعدُ",22,"د",1,0],["أخصصْ به ربّاً تجلى إذ علا","أكرِمْ به مولىً إذا قال فعل",23,"ل",1,0],["أخصصتم بما أرى أم لديكم","جاز قلب الأعيان للأعيان",24,"ن",1,0],["أخصهُ بالنصر والإقبالِ","ما كرّت الأيام والليالي",25,"ي",1,0],["أخصبت العيش والتمني لما","من نبات البشير فاضت بحورُ",26,"ر",1,0],["أخصبتْ مرتعَ الفؤادِ جمال","ثمّ ولّتْ فعادَ ملكاً مهانا",27,"ن",2,0],["أخصَّك بالتفضيل إلا لعلمه","بعجزهمُ عن بعض تلك المواقفِ",28,"ف",1,0],["أخصبتَ ربعي فالخيرُ متسعٌ","وضمَّ شملي فالحبل موصول",29,"ل",1,0],["أخَصُّهمُ كَهامٌ حيث شامُوا","سيوفَهمُ الكَليلَةَ أو دَدانُ",30,"ن",1,0],["أَخَصُّ النَدامى عِندَها وَأَحَبُّهُم","إِلَيها الَّذي لا يَعرِفُ الظُهرَ وَالعَصرا",31,"ر",2,0],["أخصه في رجال الغيب أقصد لا","أعمه في سواهم وهو إجماعي",32,"ي",1,0],["أَخصبَ الوجهُ بالجمالِ وخصَّ ال","خَصْرُ في فَلاَتِها بالجَدْب",33,"ب",1,0]]}