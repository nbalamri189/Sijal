{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[90,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[90,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[74,"أحمر الخد زاد منه لهيبي","https://www.aldiwan.net/poem18250.html","الخفيف"],[68,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[52,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[48,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[132,"سلام يسلى الفؤاد الشغيل","https://www.aldiwan.net/poem50534.html","المتقارب"],[132,"سلام وتسليم وألف تحية","https://www.aldiwan.net/poem50599.html","الطويل"],[132,"سلام كماء الورد ديف بعنبر","https://www.aldiwan.net/poem50608.html","الطويل"],[132,"تعلم العلم حقا يا فتى عمر","https://www.aldiwan.net/poem50614.html","البسيط"],[132,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50661.html","الطويل"],[132,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50665.html","الطويل"],[138,"ألا ليت حظي من حياطة نصركم","https://www.aldiwan.net/poem21010.html","الطويل"],[169,"قفا فاسمعا أخبركما إذا سألتما","https://www.aldiwan.net/poem720.html",""],[190,"دعوه يبكي لفقد خلانه","https://www.aldiwan.net/poem43249.html","المنسرح"],[201,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[215,"لقد جاء يوم العيد والقلب بالجوى","https://www.aldiwan.net/poem46775.html","الطويل"],[279,"سلام كما افتر الربيع عن الورد","https://www.aldiwan.net/poem25578.html","الطويل"],[368,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[375,"عسى بعض هاتيك العوائد عائد","https://www.aldiwan.net/poem57499.html","الطويل"],[381,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[407,"قد رأينا ما دار في الريحان","https://www.aldiwan.net/poem33368.html","الخفيف"],[433,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[433,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[442,"جمرة من صدى صوتها","https://www.aldiwan.net/poem505.html",""],[461,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[467,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[480,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[556,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[561,"جئنا إلى الحسن المعروف بالراعي","https://www.aldiwan.net/poem34367.html","البسيط"],[578,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["أخص مكرّم الوجه المرجّى","إذا ما الصبر يوم الروع شابا",0,"ب",2,0],["أُخَصُّ لِفَهمي بِالقِلى وَكَأَنَّما","يَبيتُ لِذي الفَهمِ الزَمانُ عَلى ذَحلِ",1,"ل",1,0],["أخصب الله أرضه ولو أنّي","لست أرعى رياضه ومروجه",2,"ج",2,0],["أخْصِ في العلم إن أردت كمالاً","ووصولاً إلى الفَخار الأتمّ",3,"م",1,1],["أخصب الدمع كل حي كما أخ","صب جود الوزير كل جديب",4,"ب",1,0],["أَخصَبَت عِندَ شُربِها ساحَةُ العَي","شِ وَأَمسى أَحوى الهُمومِ هَشيما",5,"م",2,0],["أخْصَبَ العَيْشُ عِنْدَهَا بعدَ مَحْلٍ","إذ غَدا للنبيِّ منها غِذاءُ",6,"ا",2,0],["أَخصَبَت عِندي وَإِنّي","عِندَها غَيرُ خَصيبِ",7,"ب",1,0],["أخُصّ بها من كُلّ حَيّ عَمِيدَهُ","وأصْرِفُها مُسْتكبِراً عن طَغامهِ",8,"م",2,0],["أَخُصُّ بِالشِّعْرِ أَحْبَابِي وَأُكْرِمُهُ","عَنْ أَنْ يَكُونَ مُدَاجَاةً وَمُزْدَلَفَا",9,"ف",2,0],["أخصُّ به الوالي المرتضَى","بشيراً حليفَ العطاء الجزيلْ",10,"ل",1,0],["أخصُّ به الزاكى سلالة ماجد","محمد الحامى هو الباسلُ الذَّمرُ",11,"ر",1,0],["أخصُّ به الشيخ الولى أخا الرضى","فتَى الجودِ والجدوى وأهل التفكرِ",12,"ر",1,0],["أخُصُّ بالنصح محمودَ اللقاء لنا","أعنى بذاكَ سليماناً فتَى عِبرِ",13,"ر",1,0],["أخصُّ به الزاكي الكريم محمداً","فتى المجد والنَّدْبُ الشجاع المجرَّبُ",14,"ب",1,0],["أخصُّ به الزاكى الكريم محمداً","فَتى ماجدٌ ندبٌ شجاعٌ مُجرِّبُ",15,"ب",1,0],["أَخصُّ خُصوصاً عَبدَ شَمسٍ وَنَوفَلا","هُما نَبَذانا مِثلَ ما نُبِذَ الجَمرُ",16,"ر",1,0],["أخصيي حمار بات يكدم نجمة","أتا كل جاراتي وجارك سالم",17,"م",1,0],["أخصمني والذي أؤمّلُه","لعفوه في غد وغفرانه",18,"ن",2,0],["أخصرةٌ أنا مالي لا تحرّكني","هذي المدام ولا تلك الأغاريد",19,"د",1,0],["أخٌ صادقٌ والصدق بعض خلاله","ولم يك فيه للملامة موضِعُ",20,"ع",1,0],["أخُصُّ به مَثْوى أبي الحَسَن الذي","تكُنُّ الحَشا مِن حُبهِ ضعفَ ما تبدِي",21,"د",2,0],["أخصَّ سِواهُ بعِلْمِ الكتاب","كما خَصَّ كُلاً بما قد رأى",22,"ا",1,0],["أخَصمي من الأيام ينجدُني على","خِصام الهوى تلكَ الأماني الأباعدُ",23,"د",1,0],["أخصصْ به ربّاً تجلى إذ علا","أكرِمْ به مولىً إذا قال فعل",24,"ل",1,0],["أخصصتم بما أرى أم لديكم","جاز قلب الأعيان للأعيان",25,"ن",1,0],["أخصهُ بالنصر والإقبالِ","ما كرّت الأيام والليالي",26,"ي",1,0],["أخصبت العيش والتمني لما","من نبات البشير فاضت بحورُ",27,"ر",1,0],["أخصبتْ مرتعَ الفؤادِ جمال","ثمّ ولّتْ فعادَ ملكاً مهانا",28,"ن",2,0],["أخصَّك بالتفضيل إلا لعلمه","بعجزهمُ عن بعض تلك المواقفِ",29,"ف",1,0],["أخصبتَ ربعي فالخيرُ متسعٌ","وضمَّ شملي فالحبل موصول",30,"ل",1,0],["أخَصُّهمُ كَهامٌ حيث شامُوا","سيوفَهمُ الكَليلَةَ أو دَدانُ",31,"ن",1,0],["أَخَصُّ النَدامى عِندَها وَأَحَبُّهُم","إِلَيها الَّذي لا يَعرِفُ الظُهرَ وَالعَصرا",32,"ر",2,0],["أخصه في رجال الغيب أقصد لا","أعمه في سواهم وهو إجماعي",33,"ع",2,0],["أَخصبَ الوجهُ بالجمالِ وخصَّ ال","خَصْرُ في فَلاَتِها بالجَدْب",34,"ب",1,0]]}