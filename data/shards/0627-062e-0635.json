{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[90,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[90,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[74,"أحمر الخد زاد منه لهيبي","https://www.aldiwan.net/poem18250.html","الخفيف"],[68,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[52,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[48,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[132,"سلام يسلى الفؤاد الشغيل","https://www.aldiwan.net/poem50534.html","المتقارب"],[132,"سلام وتسليم وألف تحية","https://www.aldiwan.net/poem50599.html","الطويل"],[132,"سلام كماء الورد ديف بعنبر","https://www.aldiwan.net/poem50608.html","الطويل"],[132,"تعلم العلم حقا يا فتى عمر","https://www.aldiwan.net/poem50614.html","البسيط"],[132,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50661.html","الطويل"],[132,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50665.html","الطويل"],[138,"ألا ليت حظي من حياطة نصركم","https://www.aldiwan.net/poem21010.html","الطويل"],[169,"قفا فاسمعا أخبركما إذا سألتما","https://www.aldiwan.net/poem720.html",""],[190,"دعوه يبكي لفقد خلانه","https://www.aldiwan.net/poem43249.html","المنسرح"],[201,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[215,"لقد جاء يوم العيد والقلب بالجوى","https://www.aldiwan.net/poem46775.html","الطويل"],[280,"سلام كما افتر الربيع عن الورد","https://www.aldiwan.net/poem25578.html","الطويل"],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[376,"عسى بعض هاتيك العوائد عائد","https://www.aldiwan.net/poem57499.html","الطويل"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[409,"قد رأينا ما دار في الريحان","https://www.aldiwan.net/poem33368.html","الخفيف"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[435,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[444,"جمرة من صدى صوتها","https://www.aldiwan.net/poem505.html",""],[463,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[482,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[558,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[563,"جئنا إلى الحسن المعروف بالراعي","https://www.aldiwan.net/poem34367.html","البسيط"],[580,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122819","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99970","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99975","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59796","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62542","الطويل"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110682","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44860","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11167","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52072","الطويل"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110695","الوافر"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110688","الوافر"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110689","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69360","الوافر"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/121500","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137163",""],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103413","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100774","الوافر"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126102","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62926","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86570","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135709","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135529","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135712","الوافر"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127232","الوافر"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123465","البسيط"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127927","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4929,"في المولد النبيوي","https://www.poetsgate.com/ViewPoem.aspx?id=199724",""],[4929,"زهابك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=202086",""],[585,"يا نازح الدار هل أحسست بالدار","https://www.poetsgate.com/ViewPoem.aspx?id=161940",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5431,"حنظلة...مازال في العشق الكثير لنكمله!","https://www.poetsgate.com/ViewPoem.aspx?id=198015",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[402,"عطف المليك شفاء","https://www.poetsgate.com/ViewPoem.aspx?id=35951",""],[5956,"عانيتُ حبَّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182334",""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[463,"يزوِّرُ عنْ حسناءَ زورة َ خائفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60142&r=&rc=198",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""],[444,"جمرة من صدى صوتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81748&r=&rc=4",""]],"verses":[["أخص مكرّم الوجه المرجّى","إذا ما الصبر يوم الروع شابا",0,"ب",2,0],["أُخَصُّ لِفَهمي بِالقِلى وَكَأَنَّما","يَبيتُ لِذي الفَهمِ الزَمانُ عَلى ذَحلِ",1,"ل",1,0],["أخصب الله أرضه ولو أنّي","لست أرعى رياضه ومروجه",2,"ج",2,0],["أخْصِ في العلم إن أردت كمالاً","ووصولاً إلى الفَخار الأتمّ",3,"م",1,1],["أخصب الدمع كل حي كما أخ","صب جود الوزير كل جديب",4,"ب",1,0],["أَخصَبَت عِندَ شُربِها ساحَةُ العَي","شِ وَأَمسى أَحوى الهُمومِ هَشيما",5,"م",2,0],["أخْصَبَ العَيْشُ عِنْدَهَا بعدَ مَحْلٍ","إذ غَدا للنبيِّ منها غِذاءُ",6,"ا",2,0],["أَخصَبَت عِندي وَإِنّي","عِندَها غَيرُ خَصيبِ",7,"ب",1,0],["أخُصّ بها من كُلّ حَيّ عَمِيدَهُ","وأصْرِفُها مُسْتكبِراً عن طَغامهِ",8,"م",2,0],["أَخُصُّ بِالشِّعْرِ أَحْبَابِي وَأُكْرِمُهُ","عَنْ أَنْ يَكُونَ مُدَاجَاةً وَمُزْدَلَفَا",9,"ف",2,0],["أخصُّ به الوالي المرتضَى","بشيراً حليفَ العطاء الجزيلْ",10,"ل",1,0],["أخصُّ به الزاكى سلالة ماجد","محمد الحامى هو الباسلُ الذَّمرُ",11,"ر",1,0],["أخصُّ به الشيخ الولى أخا الرضى","فتَى الجودِ والجدوى وأهل التفكرِ",12,"ر",1,0],["أخُصُّ بالنصح محمودَ اللقاء لنا","أعنى بذاكَ سليماناً فتَى عِبرِ",13,"ر",1,0],["أخصُّ به الزاكي الكريم محمداً","فتى المجد والنَّدْبُ الشجاع المجرَّبُ",14,"ب",1,0],["أخصُّ به الزاكى الكريم محمداً","فَتى ماجدٌ ندبٌ شجاعٌ مُجرِّبُ",15,"ب",1,0],["أَخصُّ خُصوصاً عَبدَ شَمسٍ وَنَوفَلا","هُما نَبَذانا مِثلَ ما نُبِذَ الجَمرُ",16,"ر",1,0],["أخصيي حمار بات يكدم نجمة","أتا كل جاراتي وجارك سالم",17,"م",1,0],["أخصمني والذي أؤمّلُه","لعفوه في غد وغفرانه",18,"ن",2,0],["أخصرةٌ أنا مالي لا تحرّكني","هذي المدام ولا تلك الأغاريد",19,"د",1,0],["أخٌ صادقٌ والصدق بعض خلاله","ولم يك فيه للملامة موضِعُ",20,"ع",1,0],["أخُصُّ به مَثْوى أبي الحَسَن الذي","تكُنُّ الحَشا مِن حُبهِ ضعفَ ما تبدِي",21,"د",2,0],["أخصَّ سِواهُ بعِلْمِ الكتاب","كما خَصَّ كُلاً بما قد رأى",22,"ا",1,0],["أخَصمي من الأيام ينجدُني على","خِصام الهوى تلكَ الأماني الأباعدُ",23,"د",1,0],["أخصصْ به ربّاً تجلى إذ علا","أكرِمْ به مولىً إذا قال فعل",24,"ل",1,0],["أخصصتم بما أرى أم لديكم","جاز قلب الأعيان للأعيان",25,"ن",1,0],["أخصهُ بالنصر والإقبالِ","ما كرّت الأيام والليالي",26,"ي",1,0],["أخصبت العيش والتمني لما","من نبات البشير فاضت بحورُ",27,"ر",1,0],["أخصبتْ مرتعَ الفؤادِ جمال","ثمّ ولّتْ فعادَ ملكاً مهانا",28,"ن",2,0],["أخصَّك بالتفضيل إلا لعلمه","بعجزهمُ عن بعض تلك المواقفِ",29,"ف",1,0],["أخصبتَ ربعي فالخيرُ متسعٌ","وضمَّ شملي فالحبل موصول",30,"ل",1,0],["أخَصُّهمُ كَهامٌ حيث شامُوا","سيوفَهمُ الكَليلَةَ أو دَدانُ",31,"ن",1,0],["أَخَصُّ النَدامى عِندَها وَأَحَبُّهُم","إِلَيها الَّذي لا يَعرِفُ الظُهرَ وَالعَصرا",32,"ر",2,0],["أخصه في رجال الغيب أقصد لا","أعمه في سواهم وهو إجماعي",33,"ع",2,0],["أَخصبَ الوجهُ بالجمالِ وخصَّ ال","خَصْرُ في فَلاَتِها بالجَدْب",34,"ب",1,0],["أخص كنائسا بالذكر شيدت","بمال الروس من قبل الرزيه",35,"ي",2,0],["أخَصَصتمُ عَلَم الزَّمانِ وَرِشتُمُ","بُلهَ الرِّهانِ فَلَيتَني مِن بُلهِهِ",36,"ه",2,0],["أَخْصَبَتْ أَرْبُعُ الْوَرَى بإِمَامٍ","قَاتِلِ الْمَحَلِ جَابِرِ الْمُنْهَاضِ",37,"ض",1,0],["أَخْصَبَ الحُسْنُ في جميعكَ إلاَّ","أَنَّ حظِّي منْ كُلِّ ذَلكَ جَدْبُ",38,"ب",1,0],["أَخصّ مِنهُم ذابِراً نِحريرا","لَقَد أَجادَ الحِفظ وَالتَحريرا",39,"ر",2,0],["أخص به من حرَّم الصون ذكره","وإن كنتُ طول الدهر منه على ذكر",40,"ر",1,0],["أخصك والصحب الكرام وكل من","له في الطريق المستقيم مآثرُ",41,"ر",1,0],["أخص منهم جعفر ال","معصوم من كل زلل",42,"ل",1,0],["أَخُصُّكَ لا أَنِّي ازدَهَيتُ عَلَى الوَرَى","وَلَكِن تَخَطَّيتُ التُّرَابَ إِلَى التِّبرِ",43,"ر",1,0],["أخصبت ربعَك أنواءُ الهنا","فبنوء الجود لم يبرح خصيبا",44,"ب",2,0],["أَخُصُّ بِها رَوقَي عُيَينَةَ إِنَّهُ","كَذاكَ ضَحاحُ الماءِ يَأوي إِلى الغَمرِ",45,"ر",1,0],["أخِصَيانَ وَهْرَان أفِيقُوا فَإنّكُمْ","بُغَاةٌ وَأنَّا مُسلِمُونَ فُحُولُ",46,"ل",1,0],["أخص به رضيع المجد جداً","وترب المكرمات أباً وأما",47,"م",2,0],["أخص به شقيق الصبح بشراً","سليل بشارة ذي المنقبات",48,"ت",1,0],["أخص به المولى سليل بشارة","أخي الفضل من في مدحه يزدهي الشعر",49,"ر",1,0],["أَخُصُّكَ بِالثَنا ما دُمتُ حَيا","لِأَنَّكَ بِالثَنا مِنّي حَرِيُّ",50,"ي",1,0],["أخصه بتحياتي وأخبره","أني سئمت من الترحال والسفر",51,"ر",1,0],["أخصبت بالعلم والاخلاق زاكية","فاخصبت بك الباب واذهان",52,"ن",1,0],["أَخَصُّ الصِفاتِ التي","تَناولها من كَثَب",53,"ب",1,1],["أخصك بالرثاء ولا أعزى","سوى نفسي اذا طلبت عزاء",54,"ا",2,0],["اخصب المقام الغمر ان كان غرنى","سنا خلب او زلت القدمان",55,"ن",1,1],["أَخصُّكَ بالقولِ الذي أنتَ أهلُهُ","وان رَغِمَتْ مما أَقولُ المَعَاطِسُ",56,"س",1,0],["أخص وسائل التمريض فيه","وسيماء السلامة في ذاره",57,"ا",3,0],["أخصُّ بذا حُصنَ الطريد لغوثنا","كتاب جليل القدر للقدر سلما",58,"م",2,0],["اخصُصْ بذا سعدنا سعد السعود ومن","أعطاه مولاه مذ أنشاه ريّاه",59,"ه",1,0],["أخصُّ بذاك نظم القطب حقاً","فريد العصر أكرم من فريد",60,"د",1,0],["أخصبت ثم أعشبت ثم سدت","جانب الأفق هدهدات ونخلا",61,"ل",2,0],["اخصل به رصيع المجد جدا","وترب المكرمات أبا وأما",62,"م",2,0],["أخصُّ منهم مليكَ العصرِ سيِّدَنا","أبا المحاسنِ أَوفى المعظَمين حِبا",63,"ب",2,0],["اخصها بمن رقي فوق السها","قدراً وفاق الشمس حسناً وبها",64,"ه",2,0],["أخصبت منهم البسيطةُ جوداً","أبد الدهر ليس تلفى جفافا",65,"ف",2,0],["أخصب المدح من نداهم وشتى ال","مدحُ في خصب راحتيهم وصافا",65,"ف",2,0],["أخصَبتَ بالوحي في أعماقها قَحَلاً","فَأصبَحت بالهدى رَوْضاً صحاريها",66,"ي",3,0],["أخصبتَ للحكمة الغراء طينتَهَا","فانهال عارضُهَا بالشعرِ مِهْطَالا",67,"ل",2,0],["أخصبت فيهم فلم يعوزك خصب ثرى","ولم تنافسك أرضٌ ذات إصدار",68,"ر",1,0],["أخص به الإمام القطب حقا","وجيه الدين تاج العارفينا",69,"ن",2,0],["أخصبوا حكمة وعلماً وآدا","باً وفضلاً على الأنام جزيلا",70,"ل",2,0],["أخصوك واستلوا مناجلَ غلّهم","نحوي وروحي باشتهائك سنبله!",71,"ل",2,0],["أخصوك وارتعشت حدائقُ شهقتي","مازال في العشق الكثير لنكمله!!",71,"ل",2,0],["أخص بالذكر (عبدالله) من سطعت","به السيادة شمساً في القيادات",72,"ت",1,0],["أخصلت للملك الولاء فلان لي","دهري ولم يخطئني التوفيق",73,"ق",1,0],["أخصبْتِ حبي برغم القحط في غصُني","لله درُّ خبيرٍ في تعامُلِهِ",74,"ل",2,0],["أخص من شرفوا حفلي وأسعدني","حضورهم وذي الأبيات أزجيها",75,"ي",3,0],["أخصَّكَ للتفضيلِ إلاَّ لعلمهِ","بعجزهمْ عنْ بعضِ تلكَ المواقفِ",76,"ف",1,0],["أخْصَبتْ فيكَ غَائلاتُ المآسي","والمآسي لحامل الهمِّ شِرْعَةْْ",77,"ع",2,0],["أَخصرُها الأَهيَفُ أَمْ خَيزُرَانْ","أَمْ صاغَها التّولِيبُ والأُقحوَانْ؟!",78,"ن",1,1],["أخصبتْ مرتعَ الفؤادِ جمالاً","ثمّ ولّتْ فعادَ \" ملكاً مهانا \"",79,"ن",2,0]]}