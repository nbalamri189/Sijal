l","عموديه"],[396,"قالوا نراه يسل شعر عذاره","https://www.aldiwan.net/poem3673.html","الكامل"],[403,"رمنا الفخار فنلنا منه ما شينا","https://www.aldiwan.net/poem46430.html","البسيط"],[404,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[407,"قسما بوصلك إن بعد مرامه","https://www.aldiwan.net/poem50114.html","الكامل"],[407,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[410,"من مبلغ المعتر والقانع","https://www.aldiwan.net/poem31879.html","السريع"],[410,"إن تقطع الأيام منك علائقي","https://www.aldiwan.net/poem32407.html","الكامل"],[410,"ما منهم لك معتاض ولا خلف","https://www.aldiwan.net/poem32425.html","البسيط"],[410,"باحت بسرك أدمع تكف","https://www.aldiwan.net/poem32563.html","أحذ الكامل"],[417,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[417,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[433,"هل يا حداة النجب","https://www.aldiwan.net/poem12478.html","مجزوء الرجز"],[440,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[440,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[444,"سادت بهذا الكون حكمة قاهر","https://www.aldiwan.net/poem55964.html","الخفيف"],[454,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[454,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[459,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[459,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[459,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[459,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[462,"اضطرار الحر الكريم إلى الدو","https://www.aldiwan.net/poem16005.html","الخفيف"],[478,"همت غراما بالبروق اللمع","https://www.aldiwan.net/poem15223.html","الرجز"],[478,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[480,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[501,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[506,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[507,"لي نحو أرض المنى من شرق اندلس","https://www.aldiwan.net/poem2422.html","البسيط"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[530,"أبغضوه لا لذنب","https://www.aldiwan.net/poem37283.html","مجزوء الرمل"],[550,"أمن القتول منازل ومعرس","https://www.aldiwan.net/poem446.html",""],[552,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[552,"لأنتم آل خير الناس كلهم","https://www.aldiwan.net/poem47379.html","البسيط"],[563,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[563,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[563,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[587,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"]],"verses":[["هَل يورِثُ الرَجُلُ الكَريمُ إِذا مَضى","إِلّا بَواقِيَ مِن عُلىً وَتَكَرُّمِ",0,"م",1,0],["هَل يَنفَعَنّي في الوِهادِ وَالقُلَل","مَدُّ العَلابِيِّ مِنَ النوقِ الذُلُل",1,"ل",1,0],["هَل يَروعُ القُرومَ عِندَكَ وَالأُس","دَ كُلَيبٌ عَوى لَها في حِماكا",2,"ك",2,0],["هَل يَعطِفَنَّكُمُ تَوَجُّعُها","أَو يُقبِلَنَّ بِكُم تَلَهُّفُها",3,"ف",3,0],["هَل يُبلِغَنَّهُمُ النَفسَ الَّتي ذَهَبَت","فيهِم شَعاعاً أَوِ القَلبَ الَّذي قَرِحا",4,"ح",2,0],["هَل يَبلُغَنَّهُم نُضوبُ مَدامِعي","وَفَناءُ قَلبي بَعدَهُم حَسَراتِ",5,"ت",1,1],["هَل يَخِفُّ مَحمِلُهُ","يا ثَقيلَةَ الكَفَلِ",6,"ل",1,0],["هلْ يُعْجِزَنّي والبِقاعُ فَسيحَةٌ","في هذه الأرْضِ الفَضاءِ مَقيلُ",7,"ل",1,0],["هلْ يَخفِضُ السّادِرُ منْ هَديرِهِ","فالمَجْدُ لا يَعْبَقُ بالأراذِلِ",8,"ل",1,0],["هَل يَبلُغونَ مدًى يَطوي اللُّغوبُ بهِ","أذيالَ مَنشُورةِ الأعْرافِ مِهْداجِ",9,"ج",1,0],["هَل يُحرَمُ المَرءُ القَوِيُّ","وَقَد تَرى لِلنّوكِ رُشدا",10,"د",2,0],["هلْ يُبحُ الوُرودُ بعْدَ دُيادٍ","أو يُتاحُ اللِّقاءُ بعْدَ انتِزاحِ",11,"ح",1,0],["هَل يُنكِرُ النَومُ جَفنٌ لَو أُتيحَ لَهُ","إِلّا أَنا وَنُجومُ اللَيلِ وَالقَمَرُ",12,"ر",1,0],["هَل يَشكُرَنَّ أَبو الوَليد","إِدناءَكَ الأَمَلَ البَعيد",13,"د",1,1],["هَلْ يُفِيدُ الخِصْبُ فِي بَلَدٍ","وَقُلُوبُ القَوْمِ فِي جَدْبِ",14,"ب",1,0],["هلْ يُنْكِرُ المَجْدُ الصَّحِي","حُ عَلَى التَّعَدُّدِ فِي الأَدِلَّهْ",15,"ل",2,0],["هَلْ يَسْعُفِ القَوْلُ فِي حَمْدِ الأُولَى وَفَدُوا","أَوْ يَسْعُدِ العُذْرُ فِي تَقْصِيرِ كَاتِبِهِ",16,"ب",2,1],["هَلْ يَبْلُغُ الإِنْسَانُ خُلُقَ غَيْرِهِ","أَعْلَى الذُّرَى فِي رُتْبَةِ الإِنْسَانِ",17,"ن",1,0],["هَلْ يَسْتَطِيعُ إِشَارَةً أَوْ نَبْأةً","أَوْ رَمْزِ طَرْفٍ أَوْ حَرَاكَ بَنَانِ",18,"ن",1,0],["هَلْ يَسْتَقِيمُ الأَمْرُ بَيْنَ جَمَاعَةٍ","وَالدَّارُ تَجْمَعُ غَانِماً وَغَرِيمَا",19,"م",2,0],["هَلْ يُسْعِفُ الإِيجَازُ فِي تَصْوِيرِهِمْ","يَا بُعْدَ مَا يَسْمُو لَهُ الرَّسَّامُ",20,"م",1,0],["هَلْ يُجْزِيءُ الشُّكْرُ مِنْ ضَيْمٍ تَحَمَّلَهُ","بِالأَمْسِ مَنْ مَنْكُمُو فِي رَأْيِهِ ضِيمَا",21,"م",2,0],["هَلْ يَمْلِكُ الحَيُّ لَوْ دَانَتْ لَهُ أُمَمٌ","لأَمْرِ رَبِّكَ تَأْخِيراً وتَقْدِيمَا",22,"م",2,0],["هَلْ يُجْتَلى بِالنَّقْلِ مَا فِي","الأَصْلِ مِنْ شَرَفِ الخِصَالِ",23,"ل",1,0],["هل ينفع الباعُ الطويل وقد غدتْ","يوم الطراد قصيرةَ الأَعْمارِ",24,"ر",1,0],["هل يأمن القوم أن يحتلّ ساحتهم","جيش يدُكّ من الشام الأهاضيبا",25,"ب",2,0],["هل يعلم الشرقيّ أن حياته","تعلو إذا ربّى البنات وهذّبا",26,"ب",2,0],["هَل يَرجِعَنَّ وَلَيسَ الدَهرُ مُرتَجِعاً","عَيشٌ بِها طالَما اِحلَولى وَما لانا",27,"ن",2,0],["هَل يَنفَعَنَّكَ إِن جَرَّبتَ تَجريبُ","أَم هَل شَبابُكَ بَعدَ الشَيبِ مَطلوبُ",28,"ب",1,1],["هَل يَصبُوَنَّ حَليمٌ بَعدَ كَبرَتِهِ","أَمسى وَأَخدانُهُ الأَعمامُ وَالشيبُ",28,"ب",1,0],["هَل يُبلِغَنّي دِيارَها حَرَجٌ","وَجناءُ تَفري النَجاءَ وَالخَبَبا",29,"ب",2,0],["هل يعلم اللّحم أني بعد نقلته","ما سرتُ من علمٍ إلا إلى علم",30,"م",1,0],["هل يُجتَلى الصبحُ بالمصَابح في ال","أفْقِ إذا لاح ساطعاً لَهَبُهْ",31,"ب",2,0],["هل يَسُرّ الكريمَ أنَّ كِساهُ","كَمُنَاهُ وعِرضُه مَهْرُوتُ",32,"ت",1,0],["هل يُخْلِفُ الحرُّ وعْداً خُلْفُهُ خطرٌ","يُخَافُ منه هَلاَكُ الروحِ والجسدِ",33,"د",1,0],["هل ينتهي نظر إلا إلى نظرِ","أو ينقضي وطر إلا إلى وطرِ",34,"ر",1,1],["هل يرجعُ الدمع الذي","سَلَبتْهُ عنك الأحرُس",35,"س",1,0],["هل يمنع الحرُّ جنى حظِّهِ","من هزَّ هزّاً ليِّناً جِذْعه",36,"ع",2,0],["هل يخلف البدر وجه سيدنا","كلا ولا الشمس في مشارقها",37,"ق",3,0],["هل يرى الناسُ بعدما حقَّقُوني","بك حتى لقيلَ لي إسحاقُك",38,"ك",1,0],["هل يطلبُ الصبحَ بالمصباحِ طالبُه","ما استُهلك الصبحُ عن عين ولا خملا",39,"ل",2,0],["هل يُخجِلُ التسفيلُ مَنْ كُلُّه","يصلحُ للتسفيل تسفيلا",40,"ل",2,0],["هل يُعرَّى امرؤٌ من الحسدِ المَحْ","ضِ على نيلِ أفضلِ الأقسام",41,"م",1,0],["هل يُعافي العبدَ من محذورِهِ","أنَّ أخلاقك أضحت جُنَنَه",42,"ن",2,0],["هل يُداجيني زُلالٌ قد صفا","وأبى طيبُ ثناه أَسنه",42,"ن",2,0],["هل يُعير الجود وغداً زينةً","ويعيرُ البُخْل حُرّاً أُبَنَه",42,"ن",2,0],["هل يعير البرُّ بحراً عِيسَه","أو يعير البحرُ برَّاً سُفنه",42,"ن",2,0],["هَل يُسلِيَنَّكَ عَمّا لا يَفينَ بِهِ","شَحطٌ بِهِنَّ لِبَينِ النِيَّةِ الغَرَبِ",43,"ب",1,0],["هَل يَملَءُ الأَغوارَ تِبراً كَالضُحى","وَيَرُدُّ كَالغَيثِ المَواتَ نَضيرا",44,"ر",2,0],["هَل يَرُدُّ المَوتَ سُلطا","نُكَ وَالدُنيا الكَثيفَه",45,"ف",2,0],["هل يستوي النور يفيض","دافقا والظلم",46,"م",1,0],["هل يخرق العادات فيما جاءه","الا جريئي لا يخاف ملاما",47,"م",2,0],["هل ينافي شجاعتي انني اح","رص ان لا تمضي حياتي ضياعا",48,"ع",2,0],["هل يحول الحجاب بين التي لم","تتثقف والطيش في الرغبات",49,"ت",1,0],["هل يضر الشمس المضيئة أن يب","دُوَ في شانها من العمى جحد",50,"د",1,0],["هل ينكر الأقوام أن محمدا","ملأ الوجود وسلاما",51,"م",2,0],["هَل يَمُدُّ اللَهُ لِيَ العَيشَ عَسى","أَن أَراكُم في الفَريقِ السُعَداء",52,"ا",2,0],["هَل يَسُرَّنَّ باقِياً بَعدَ ماضٍ","ما تَقولُ العُداةُ في كُلِّ نادِ",53,"د",1,0],["هَل يَشكُرُ الحَسَنَ بنِ مَخلَدٍ الَّذي","أَولاهُ مَحمودُ