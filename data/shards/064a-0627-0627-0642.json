{"poems":[[74,"يا أقرب الناس من مدح ومن كرم","https://www.aldiwan.net/poem18747.html","البسيط"],[87,"يا أقرب الناس من أمين","https://www.aldiwan.net/poem7785.html","مخلع البسيط"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[45,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[112,"أحلى وسيلة","https://www.poetsgate.com/ViewPoem.aspx?id=8387",""],[132,"درويش يا ذا الخلفة الشوهاء","https://www.aldiwan.net/poem50675.html","البسيط"],[310,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[591,"يا أقتل الناس ألحاظا وأعذبهم","https://www.aldiwan.net/poem18009.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48604","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48738","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120142","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108950","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42448","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42486","البسيط"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104434","الكامل"],[2867,"","https://poetry.dctabudhabi.ae/diwan/poem/102044","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103610","البسيط"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27121","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90957","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133182",""],[357,"ريان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=19987",""],[4816,"بنات الشك","https://www.poetsgate.com/ViewPoem.aspx?id=8481",""],[4859,"روحٌ موحدةٌ.","https://www.poetsgate.com/ViewPoem.aspx?id=207843",""],[5057,"خاصمتها","https://www.poetsgate.com/ViewPoem.aspx?id=183939",""],[5195,"هل يتاح للرواح","https://www.poetsgate.com/ViewPoem.aspx?id=186947",""],[5628,"عاشق الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=179808",""],[5776,"شهيدة مجهولة","https://www.poetsgate.com/ViewPoem.aspx?id=205849",""],[5848,"البقية في حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=50592",""],[192,"يا كاعب","https://www.poetsgate.com/ViewPoem.aspx?id=9857",""],[5937,"إلى مُعَلمة","https://www.poetsgate.com/ViewPoem.aspx?id=211808",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[6019,"يا أقسى من ليلٍ أسودْ","https://www.poetsgate.com/ViewPoem.aspx?id=202307",""],[6142,"يا أقرب الصحب للزهرا مصاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=155744",""]],"verses":[["يا أقرب الناس من مدحٍ ومن كرمٍ","وأبعدَ الناس من عابٍ ومن عار",0,"ر",1,1],["يا أقرب الناس من أمين","وأفقد الناس للثمين",1,"ن",1,1],["يا أقربَ الناسِ مَنالاً في النَّدى","وأبعدَ الناسِ مَراماً في الهِمَم",2,"م",1,0],["يا أَقدَرَ السُفّارِ وَالقُفّالِ","لَو شِئتَ صِدتَ الأُسدَ بِالثِعالي",3,"ل",2,0],["ياأقسى من الطعنات فى حرب جالوت","وأرخى من ورود الرياض الجميله",4,"ل",2,0],["يا أقذر الأخلاق خُلُقاً في الوَرَى","يا قُرْحَةَ في القلبِ والأحشاءِ",5,"ا",2,0],["يا أقرعاً تستنّ في مضمار من","قادت جوانبه الفنون جنائبا",6,"ب",2,0],["يا أَقْتَلَ الناسِ أَلْحاظاً وأَعذَبهُمْ","رِيقاً مَتَى كَانَ فِيكَ الصَّابُ والعَسَلُ",7,"ل",1,1],["يا أقرب الجيران لولاك ما","أبصرت من جار شقيِّ الضميرْ",8,"ر",1,0],["يا أقدر الأحرار ألسنة لدى","فصل الخطاب وخيرهم أقلاما",9,"م",2,0],["يا أقل الأنام في ال","عين مع كبرة الظَفَف",10,"ف",1,0],["يا أقرع بن حابس يا أقرع","إنك إن يصرع أخوك تصرع",11,"ع",1,0],["يا أقبح الناس بل يا عير أقبحهم","ما الناس ناسٌ إذا لم يتقوا اللَه",12,"ه",1,0],["يا أقربَ النَّاسِ من قلبي وأبعدَهم","عن ناظرٍ ظلَّ في معناكَ مبتهجِ",13,"ج",1,0],["يا أقتلَ الناسِ ألحاظاً وأسبقُهم","في مهجة الصبِّ فتكاً دونَهُ الأجلُ",14,"ل",1,0],["يا أقبراً شيدت بعرصة كربلا","أضحت ملائكة السما زوارها",15,"ر",3,0],["يا أقبراً أرضك إلاهاج بي شجن","ومدمعي سال من عيني مدرارا",16,"ر",2,0],["يا أقتل الناس الحاظا واطيبهم","ريقا متى كان فيك الصّاب والعسل",17,"ل",1,1],["يا أَقرَبَ الناسِ مِن حَمدٍ وَمَكرَمَةٍ","وَأَبعَدَ الناسِ مِن ذَمٍّ وَمِن عارِ",18,"ر",1,0],["يا أقرب الأحباب من قلبي وإن","حالت فدافد بيننا وسباسب",19,"ب",1,0],["يا أقمر الوجه يا غصن النقا","يا أثقل الردف فياح الخدود",20,"د",1,0],["يا اقرب القرابي","يا شوقي والمدام",21,"م",1,0],["يا اقرب عقرب على غصن زيتون","ياللي حياته والنقائض مبادي",22,"د",2,0],["يا أقرب الناس من قلبي كفى عتباً","وأسأل عليّ اذا ما شئتَ إحساسَك",23,"ك",1,1],["يا أقرب الناس مِن قلبي كفى ألماً","فدمعُ عينيكِ لولا الحبّ ما نزلا",24,"ل",2,0],["يا أقاح يا فواح","من حماك عن مضناك",25,"ك",1,0],["يا أقحوانَ زماني لو سكرتَ معي","هنيهة ً لاغتدى شوك ٌ رياحينا",26,"ن",2,0],["يا أقدسَ الأقداسِ في وطني","يا كعبةً طافتْ على الحَزَنِ",27,"ن",1,1],["يا اقرب اقرب من حروفي في شفاتي","لو قربتي خايف اقرب .. ونتفرّق",28,"ق",1,0],["يا أقدم الكيد الجديد","كيد انسجن منه نبي",29,"ب",2,0],["يا أقدسَ الكلمات ، هاتي جُملةً","لفمي ، فكلُّ فمٍ بغيركِ ، أبكَمُ",30,"م",1,0],["يا أقربَ القرَبا لنا مِن مصطفى","هلاّ دعوتِ له، فجفْنُه ما غفا",31,"ف",2,0],["يا أقسى من ليلٍ أسودْ","يا همّاً يَقهرُ مُذ عربدْ",32,"د",1,1],["يا أقرب الصحب للزهرا مصاهرة","أجل وأدناهم في غابر النسب",33,"ب",1,1]]}