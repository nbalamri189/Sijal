iewPoem.aspx?id=188891",""],[592,"أقول نعم هذا هو الحق والهدى","https://www.poetsgate.com/ViewPoem.aspx?id=128810",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5417,"لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188602",""],[5629,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=184509",""],[402,"رب البيان وسيدا لقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36326",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5956,"إخلاصُك المعروفُ عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194138",""],[6038,"مجرد أوهام 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25701",""],[6102,"طلل","https://www.poetsgate.com/ViewPoem.aspx?id=184437",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["أَجهَدتُهُ وَالكَرُّ يَعصِرُهُ","وَالماءُ مِن عِطفَيهِ يَنهَمِلُ",0,"ل",1,0],["أَجِهاراً جاهَرتِ لا عَتبَ فيهِ","أَم أَرادَت خِيانَةً وَفُجورا",1,"ر",2,0],["أَجْهَدْتَ فِكْرَكَ فِي تَعَقُّلِهِ","وَصَدَرْتَ عَنْهُ وَارِداً كَظَمِي",2,"م",2,0],["أُجهْزُ بالإنشاء كلَّ كتيبةٍ","من الكُتْبِ والكُتّابُ في عرضها جندي",3,"د",2,0],["أَجهَضنَ مُعجَلَةً لِسِتَّةِ أَشهُرٍ","مِثلَ الفِراخِ جُلودُهُنَّ تَمَوَّرُ",4,"ر",1,0],["أَجهَضنَ مُعجَلَةٌ لِسِتَّةِ أَشهُرٍ","وَحُذينَ بَعدَ نِعالِهِنَّ نِعالا",5,"ل",2,0],["أجهلتها إذ هي موفورةٌ","ثم نَضَتْ عني فعُرِّفْتُها",6,"ت",3,0],["أُجَهِّزُ فيك جميلَ الثنا","إلى حافظٍ وإلى راقمِ",7,"م",1,0],["أجهدت نائلهم فجاء صبابة","ودعوت نائله فجاء صبيبا",8,"ب",2,0],["اَجهِد وَلا تَكسَل وَلا تَكُ غافِلاً","فَنَدامَةُ العُقبى لِمَن يَتكاسَلُ",9,"ل",1,0],["اِجهَدِ الآنَ كُلَّ جَهدِكَ فينا","سَتَرى ما يَكونُ في شَوّالِ",10,"ل",1,0],["أَجهِل بِساداتِهِم وَإِن زَعَموا","أَنَّهُمُ في عُلومِهِم رَسَخوا",11,"خ",3,0],["أَجهَلُ مِنّي رَجُلٌ يَبتَغي","عِندِيَ ما لَستُ لَهُ مُحسِنا",12,"ن",2,0],["أَجهل بقوم قد رأوا","فضل البنين عَلى البنات",13,"ت",1,0],["أجهلُ الناس مدّعٍ يحسَبُ العلمَ","كتاباً ويحسَبُ الفنّ سطرا",14,"ر",2,0],["أَجْهَدَ الْفَارِسَ المُلِحَّ وَأفْنَى","نَبْلَهُ حَوْلَهُ وَأضْنَى حِصَانَه",15,"ن",2,0],["أجهدتْ في السرى خوافقَ عِزْري","لَ فرفّتْ من خَلْفهِنَّ وئيدا",16,"د",2,0],["أَجْهَدَ الشعْرَ أَنْ يَرَى عَزَماتٍ","يَعْجِزُ الْوَصْفُ دُونَها وَجُهُودا",17,"د",2,0],["أجْهدتَ ساريةَ الخيال فأجْبَلَتْ","ماذا تقولُ اليومَ في أمداحهَا",18,"ح",3,0],["أَجهزْ على الداء، أجهزْ غيرَ متَّئدٍ","إنَّا صبرْنا على آلامه حِقَبَا",19,"ب",2,0],["اجهَرْ بصوت الحقِّ. ضلَّ الحقُّ في","هذا الزمان منافذَ الأسماع",20,"ع",1,0],["أجهدت نفسك في مرضاة خالقها","يا مجهد النفس اربح رحمة الأزل",21,"ل",1,0],["أجهدتنا الضحى على زحمة الرّوع","فهل يسعد الطلاح الأصيل",22,"ل",1,0],["أُجَهِّزُ فيك جميلَ الثنا","إلى حافظٍ وإلى آقم",23,"م",1,0],["أجهازا جاهزت لا عتبَ فيهِ","أمْ أرَادَتْ خِيانة ً وفُجورَا",24,"ر",2,0],["أجهلت يا ظب الابيرق ان لي","مجداً ذووه الزهر غير نيام",25,"م",1,0],["أَجهَدتَ نَفسَكَ طالِباً","ما لَيسَ يُدرِكُهُ طِلابُ",26,"ب",1,0],["أُجَهِّزُها وَيَحمِلُها إِلَيكُم","ذَوو الحاجاتِ وَالقُلُصُ المَناقي",27,"ق",2,0],["أجهز غاراتِ شوقي له","فتلقى تشوقهُ قد دنا",28,"ن",2,0],["أُجهٌ أَمونٌ كَالقَبرُ هامَتُها","ذاتُ هِبابٍ في لَحيِها سَجَحُ",29,"ح",1,0],["اجهدتني فكرتي في طالعي","يا لتعسي طالعي في زحل",30,"ل",1,0],["أجهلتم أن الموالاة التي","وجبت ترد صريح ما قالوه",31,"و",2,0],["أجهلت ما قد كنت تعلمه","أيام سربك في الهوى سربي",32,"ب",2,0],["أجهلا وبغيا واستطالة فاجر","وعصر جيوب القوم قد طفح الكيل",33,"ل",1,0],["أجهلت قدرك أيها الإنسانُ","أنت الجميع وبعضك الأكوانُ",34,"ن",1,1],["أَجهَلتُ مَن قَومٌ هَرَقتُ دِماءُهُم","بِيَدي وَلَم أُدهَم بِجَنبِ تِغارا",35,"ر",2,0],["اجهد وَلازم طُرق الفَلاح","تَفوز بِالنَصر وَبِالنَجاح",36,"ح",1,0],["أجهدت نفسك في بناء قصائد","نحت الصخور ونحتها سيان",37,"ن",1,0],["أَجْهَدَني ما ضَيَّعَتْ مِنْ ذِمَّتي","وَقَدْ حَفِظْتُ إِلَّها بِجِهْدي",38,"د",2,0],["أجهشوا بالدموع حولك من حز","ن فكفكفتها لهم بساما",39,"م",2,0],["أجهلت أن تجليات جَلاَلِهِ","ظهرت لسائلة المحال مخوفه",40,"ف",2,0],["اجهد بجهدكَ فيما قد قَصدتَ له","فَفرجَةُ الله بين النُّونِ والكافِ",41,"ف",1,0],["أجهش البرق والمسرة ناحت","يندبان الفقيد عفا نقيّا",42,"ي",2,0],["أجهداها في خدمة الدين نفساً","شكرَ اللهُ سعيَها المشكورا",43,"ر",2,0],["أجهش فيها بالبكا لغدرة","في الدين كل من يعيها أجهشا",44,"ش",2,0],["أجهَدتَ نفسكَ بحثاً عن جواهرها","ونلتَ بالجدِّ منها غاية الأدَبِ",45,"ب",1,0],["أَجهَدتُ نَفسي في المَديحِ فَلَم أَجِد","ما قَد صَنَعتُ مُجازِياً ما يَصنَعُ",46,"ع",1,0],["اجهد الجسم ولما ضاره","نشب السل به مستحكما",47,"م",2,0],["أجَهِلتَ أوصَافَ المبِيعِ وقَدرَهُ","أم كُنتَ ذا جَهلٍ بِذِي الأثمَانِ",48,"ن",1,0],["اجهلت رزء الغاضرية ام","سيان منك العلم والجهل",49,"ل",1,0],["اجهد لها وأبوك حي قبل ان","تكتاله أيدي المنون بصاعها",50,"ع",3,0],["أجهلت ما بعد القيامة من زبا","نية شداد لا تطاق غلاظ",51,"ظ",1,0],["أجهلت شؤونه وهي فرض","أم رفضت من شرعه كل رفض",52,"ض",1,0],["أجهلت في فن العروض ضرورة","الإقواء يا هذا ألست أديبا",53,"ب",2,0],["اجهد النفس ان تكون بزي","مثل زي المشايخ الصوفيه",54,"ي",2,0],["إجهر برأيك ان الحق قد غلبا","هذا يراعك يحكى السيف ما كتبا",55,"ب",2,1],["أجهدتَ نفسكَ فاربأ تسترح زمنا","لا يستريح امروءٌ والفكرُ مشغول",56,"ل",1,0],["أجهلت رتبة حيدرٍ من أحمد","قل لي وحقك هل أتى نزلت ممن",57,"ن",1,0],["اِجهد لنفسك إِن تعز","ز إِذا اِستَهَلَّ وَتكرما",58,"م",2,0],["أجِهاتي ودُرُّ مدْحيَ فيها","أمْ نحورٌ قد حُلّيتْ وخُصورُ",59,"ر",1,0],["أَجهَدَ النّاسَ قَصدُ ما بَعد هذا","الكَونُ بَحثاً مُنذُ العُصورِ الخَوالي",60,"ل",2,0],["أجهلت قدر العرب يا إقدام","ولهم على هام النجوم مقام",61,"م",1,1],["أجهلت ما نالوه من شرف به","يسمو الزمان وتفخر الأيام",61,"م",1,0],["أجهل لعلك أن تنال بعجزه","ما لم تنل من قوة الإفهام",62,"م",1,0],["أجهشت خلفك النواظر عبرى","فاضحاً دمعها الحيا المسكوبا",63,"ب",2,0],["أجهلتَ أم نُسِّيتَ مِن فَرطِ الجَوى","أَنَّ الحِدادَ على الرِجالِ مُحَرَّمُ",64,"م",1,0],["أجهِلتُهم 