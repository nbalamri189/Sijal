{"poems":[[55,"شرف الخلافة يا بني العباس","https://www.aldiwan.net/poem30200.html","الكامل"],[64,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[396,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[422,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[484,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[484,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[519,"بالزور شانيك عارض فوق خدك خط","https://www.aldiwan.net/poem20923.html","المواليا"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/199827","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77868","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89117","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125915","الكامل"],[4718,"السهم والقوس","https://www.poetsgate.com/ViewPoem.aspx?id=137156",""],[4791,"عقد ثمين","https://www.poetsgate.com/ViewPoem.aspx?id=37114",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[592,"أقول نعم هذا هو الحق والهدى","https://www.poetsgate.com/ViewPoem.aspx?id=128810",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5461,"لا هنت","https://www.poetsgate.com/ViewPoem.aspx?id=8541",""],[5493,"من وحيِ القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=197043",""],[5956,"شكراً على الاستدفاء بنيرانكم","https://www.poetsgate.com/ViewPoem.aspx?id=192365",""],[5126,"خيبة أمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87798&r=&rc=13",""]],"verses":[["بِالزابِ وَالآمالُ واقِفَةُ الخُطى","بَينَ الرَجاءِ لِنَيلِها وَالياسِ",0,"س",1,0],["بالزوابيق زال ظل النحاسِ","وابتدا عقد آنكٍ ذي صريرِ",1,"ر",1,1],["بالزهد في ذي الدنيه","وكل خصله عليه",2,"ه",1,0],["بالزكيِّ الطاهر الشَّهْمِ الَّذي","طابَ في النَّاس فروعاً وأُصولا",3,"ل",2,0],["بالزوج والأبوين بر","رّت والمبرّة تنفع",4,"ع",1,0],["بالزمان خبير","زاد فينا احتراما",5,"م",2,0],["بالزور شانيك عارض فوق خدك خط","حاشاك لكن قصدهُ رتبتك تنحط",6,"ط",1,1],["بِالزَّبَيْدِيَّةِ الْمُشَهَّرَةِ الْحُسْ","نِ وَحَوْزِ الَّلَذَاذَةِ الْمَاحُوزِ",7,"ز",1,0],["بالزنج حر غير الأجسادا","حتى كسا جلودها سوادا",8,"د",2,1],["بالزور وَالبهتان وَالإِيحاش","يريد أَن لا نَلتَقي في الدهر",9,"ر",1,0],["بالزورق المسعود والصدر انشرحْ","تهللت بشراً فأمسى واصطبح",10,"ح",1,0],["بالزيت قد فاضت خزائُنها","بَلْهَ المياهَ الجمةَ القدر",11,"ر",1,0],["بالزين كله والحلا يعطي دروس","يحتار من ياخذ عليه المقاييس",12,"س",1,0],["بالزين يا قاهر طغى كل مملوح","البيض فضه وأنت عقدٍ ثميني",13,"ن",2,1],["بالزعيم \" الحَجّاج \" أُبْدِلَ ثان ٍ","وكذا الدهْرُ طبْعُه الإبدالُ !",14,"ل",1,0],["بإلزام أهل الحق بالبغي والهوى","لوازم لا ترضى ولا هي تلزم",15,"م",1,0],["بالزورمان وبالبهتان عن قحة","تباً له من جهور مارق مانا",16,"ن",2,0],["بالزهد والمعروف والصبر كونت","منهاج فيصل منهج اللي يعذلون",17,"ن",1,0],["بِالزادِ أوْ بالماءِ لا يَحيَا سوى","جسدٍ بغيرِ الرُّوح صار مُحَطَّمَا",18,"م",2,0],["\"بالزمهريشنْ\" تقدرون حسابنا","فالموت من قرٍّ وجوع منتشرْ",19,"ر",1,0],["بالزُّبْدِ أدْهُنُهُ وما أدْمَوْا بهِ","والشَّهْدُ أطْلِيهِ فما لَعَقُوهُ",20,"و",2,0]]}