et/poem3390.html","عموديه"],[464,"إلا يا دار لا أوحشت يوماً","https://www.aldiwan.net/poem3402.html","عموديه"],[466,"أما وإلى الواشي وإن طاوعتهم","https://www.aldiwan.net/poem50380.html","الطويل"],[477,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[477,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[495,"علي أن لا أريح العيش والقتبا","https://www.aldiwan.net/poem9763.html","البسيط"],[495,"حنانيك من نفس خافت","https://www.aldiwan.net/poem9786.html","المتقارب"],[495,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[495,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[500,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[500,"لأهل بطاح الحي في سدرة العلى","https://www.aldiwan.net/poem38036.html","الطويل"],[506,"صبرت على غدر الزمان وحقده","https://www.aldiwan.net/poem2440.html","الطويل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[514,"هوى الكوكب الدري من أفق المجد","https://www.aldiwan.net/poem20841.html","الطويل"],[515,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[515,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[515,"إجر النسيم إلى السمائم","https://www.aldiwan.net/poem12266.html","مجزوء الكامل"],[538,"لم يكن لي من المدام نصيب","https://www.aldiwan.net/poem47582.html","عموديه"],[538,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[551,"جلب البرق لقلبي","https://www.aldiwan.net/poem47298.html","مجزوء الرمل"],[551,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[551,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[551,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[551,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[551,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[558,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[558,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[567,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[567,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"فؤادي بسهم المقلتين رماه","https://www.aldiwan.net/poem2836.html","الطويل"]],"verses":[["وَعَزمٍ يُشاوِرُ حَدَّ الحُسامِ","وَيَدنو وَقائِمُهُ غَيرُ داني",0,"ي",1,0],["وَعِزٍّ لا يُزَعزَعُ بِالرَزايا","وَطودٍ لا يُضَعضَعُ بِالزِحامِ",1,"م",1,0],["وَعَزمٍ أُعاطيهِ العَوالي وَحاجَةٍ","رَمَيتُ بِها ما بَينَ أَرضٍ وَتَنسِمِ",2,"م",1,0],["وَعَزمٌ إِن مَضَيتَ بِهِ جَريّاً","هَوى مَطَرُ القَنا بِدَمٍ صَبيبِ",3,"ب",1,0],["وَعَزمٍ كَأَطرافِ الأَسِنَّةِ في الحَشا","طَعَنتُ بِهِ كَيدَ العَدوِّ المُوارِبِ",4,"ب",1,0],["وَعِزُّكَ باقٍ لا يُزَلزَلُ طَودُهُ","وَكُلُّ المَعالي بَينَ ماضٍ وَآيِبِ",4,"ب",1,0],["وعَزْمَةُ القادِرِ المَحْبُوِّ سائِلُهُ","والخارجي لَوى منْ جيدِه الأشَرُ",5,"ر",1,0],["وعزّةُ المُقْتَدي تُكْسى مَهابَتُها","حتى يَعودَ خفيّاً دونَكَ النّظَرُ",5,"ر",1,0],["وعِزٌّ بمَرْسى الأخْشَبَيْنِ مُخيِّمٌ","ومجْدٌ لدى البَيْتِ العَتيقِ عَتيقُ",6,"ق",1,0],["وعزَّ بكَ الشّرْقُ حتى لوى","إليكَ أخادِعَهُ المَغْرِبُ",7,"ب",1,0],["وعَزمَةٍ نالَ بها ما ابْتَغى","منَ العِدا والسّيْفُ مَقْروبُ",8,"ب",1,0],["وعَزّوا حين غِبْتَ فهُمْ أُسودٌ","وذلّوا إذْ حَضَرْتَ فهُمْ نَقادُ",9,"د",1,0],["وعَزْمَةُ ذي شِبلَيْنِ ضاقَ بِهَمِّه","ذِراعاً فلا يَثْنيهِ زَجْرٌ ولا رَدُّ",10,"د",1,0],["وعَزْمَةُ ذي شِبلَينِ إن شمَّ مَرْغَماً","أخاضَ النّجيعَ الوردَ ناباً وأولَغا",11,"غ",2,0],["وعِزَّةٌ دونَ أدْناها مُمَنَّعَةٌ","ممّا يُناجي عَلَيهِ الفَرْقَدَ الوَعِلُ",12,"ل",1,0],["وعَزْمٍ إذا ما الحَرْبُ حَطّتْ لِثامَها","يُلَوِّي أنابيبَ الوَشيجِ المُقَوَّمِ",13,"م",1,0],["وَعَزيزَةٍ مَفقودَةٍ قَد هَوَّنَت","مُهَجُ النَوافِلِ بَعدَها مَفقودَها",14,"د",3,0],["وعَزيزٌ عليّ أنْ كُنْتَ يَحْيَى","ثمّ لمْ تأخُذِ الكِتابَ بقُوّهْ",15,"و",2,0],["وَعَزماً شَآمِيّاً لَهُ أَينَما مَضى","شَبا هِندُوانِيٍّ وَحَدُّ يَماني",16,"ي",1,0],["وَعَزائِمٌ كانَت تَفُلُّ عَزائِمَ ال","أَحداثِ وَالأَيّامِ وَالأَعداءِ",17,"ا",2,0],["وَعَزمَةٌ لَو قُسِّمَت في الوَرى","باتوا مِنَ الشِعرى عَلى مَسمَعِ",18,"ع",1,0],["وَعِزَّهُ داؤُها وَقَد شَهِدَت","لَهُ رُواةُ الأَخبارِ بِالخُبرِ",19,"ر",1,0],["وَعَزيزِ قَومٍ مُترَفٍ سَربَلتَهُ","ذُلّا وَكانَ الطاغِيَ المُتَمَرِّدا",20,"د",2,0],["وَعَزَاءَكُمْ يَا آلَهُ إِنَّ الَّذِي","تَبْكُونَهُ فِي نِعْمَةٍ وَجِنَانِ",21,"ن",1,0],["وَعَزَاءَكُمْ يَا مُعْجَبِينَ بِفَضْلِهِ","فِيمَا دَنَا وَنَأَى مِنَ الأَوْطَانِ",21,"ن",1,0],["وَعَزَّ أَسَا دَارِ السَّلامِ وَصُوِّحَتْ","بِقَاعُ العَزِيزِ الخُضْرُ وَاهْتَزَّ لُبْنَانُ",22,"ن",1,0],["وَعَزِيزُهَا بِسِلاحِهِ وَكِفَاحِهِ","وَذَلِيلُهَا بِالحَقِّ وَالبُرْهَانِ",23,"ن",1,0],["وَعَزِيمَةٌ قُرِنَتْ بِصَبْرٍ لَمْ تَدَعْ","لَكَ فِي مَجَالِ السَّبْقِ مِنْ أَقْرَانِ",23,"ن",1,0],["وَعَزَاؤُنَا هُوَ مُلْتَقَى أَرْوَاحِنَا","بِالذِّكْرِ بَعْدَ تَشَتُّتِ الأَجْسَامِ",24,"م",1,0],["وَعِزةٍ كَالرَّوَاسِي","وَرِقَّةٍ كَالنَّسِيمِ",25,"م",1,0],["وعزمك أمضى من حسامك في الوغى","وإن كان مصقول الغِرَارَيْنِ ماضيا",26,"ي",2,0],["وَعزمٍ كما انشقَّ الصباح مُصَمِّم","ورأي به بيض الصوارم تُرْهَفُ",27,"ف",1,0],["وَعَزمَةٌ لايَنامُ اللَيلَ صاحِبُها","إِلّا عَلى ظَفَرٍ في طَيِّهِ كَرَمُ",28,"م",1,0],["وَعَزمَةُ خَرّاجٍ مِنَ الضَيمِ فاتِكٍ","وَفِيٍّ أَبِيٍّ يَأخُذُ الأَمرَ مِن عَلِ",29,"ل",1,0],["وعزيزةٍ هي للنواظرِ جنَّةٌ","تجلى ولكن للقلوب شقاء",30,"ا",2,0],["وعزٍّا كبتّ به العدَى لما رأوا","من رفعِ منزلة وفيض سماح",31,"ح",1,0],["وعزمٌ إلى الأخرى يهمّ نهوضه","ولكنه بالذَّنبِ كالظَّهر مُوقَر",32,"ر",1,0],["وعزّ لقاؤنا والربع دانٍ","كما أبصرت تفليج الثغور",33,"ر",1,0],["وعزّ قولي ولم أقصد بوافده","إلاَّ العزيز ولم أبذله مجَّانا",34,"ن",2,0],["وعزيزٌ عليَّ عَضِّيكَ باللو","م ولكنْ أصبتَ صدري بداءِ",35,"ا",2,0],["وعزيزٌ عليَّ أنْ قلتُ ما قل","تُ ولكنْ حرَّقْتَني إحْماءَ",36,"ا",2,0],["وعزةُ المعروف في ذُلِّه","وذلّةُ العُرف إذا استصْعِبا",37,"ب",2,0],["وعزَّ عليَّ أن تبْلى وأبقى","ولكنَّ الحوادثَ لا تُحابي",38,"ب",2,0],["وعزاك عن ليل الشباب معاشرٌ","فقالوا نهارُ الشيب أهدى وأرشدُ",39,"د",1,0],["وعزَّى أناساً أن كل حديقةٍ","وإن أغْدَقَتْ أفنانُها ستخضَّدُ",39,"د",1,0],["وعزيزٌ عليَّ مَدْحِيَ نفسي","غير أني جُشِّمتُه للدلالهْ",40,"ل",2,0],["وعزَّ على مولاكَ صَرْفُ اهتمامِه","إلى القُوتِ لكنْ أمرهُ مُتفاقمُ",41,"م",1,0],["وعزيفٍ عليه من مُسْمِعات","وحديثٍ عليه من أخلام",42,"م",1,0],["وعزيزٌ عليَّ تَقْريعُ خِلّ","لا يُدانيه عنديَ الخلان",43,"ن",1,0],["وعزيزٌ عليَّ سلِّيه لكنْ","كُلُّ سَيْفٍ فللظهور كُمونه",44,"ن",2,0],["وعزيزٌ عليهما أن يكونا","عنك لولا الإزعاج يرتحلان",45,"ن",1,0],["وَعَزَّ عِندي تَسييرُ ذاكَ وَقَد","شَبَّهتَهُ بِالخُدودِ وَالحَدَقِ",46,"ق",1,0],["وعَزِّها عَنْ أَساها","فقدْ دَهَتْها المُصيبَهْ",47,"ه",1,0],["وعزيز على العروبة ان يغمد","في قبر سيفها المسلول",48,"ل",1,0],["وعزة الله بلا عزت","لا تنفع القارى ولا خردله",49,"ل",2,0],["وَعَزَّيتُ بَيتاً قَد تَبارَت سَماؤُهُ","مَشايِخَ أَقماراً وَمُرداً دَرارِيا",50,"ي",2,0],["وَعَزمُكَ مِن هوميرَ أَمضى بَديهَةً","وَأَجلى بَياناً في القُلوبِ وَأَعذَبُ",51,"ب",1,0],["وعَزيزٍ بينَ الدَّلالِ وبينَ المُلْ","كِ فارَقْتُهُ على رَغْمِ أَنْفي",52,"ي",1,1],["وَعَزمَةٌ بَعَثَتها هِمَّةٌ زُحَلٌ","مِن تَحتِها بِمَكانِ التُربِ مِن زُحَلِ",53,"ل",1,0],["وَعَزَّت قَديماً في ذَراكَ خُيولُهُم","وَعَزّوا وَعامَت في نَداكَ وَعاموا",54,"م",3,0],["وعزمةُ مطرود الرُّقادِ يدُلُّهُ","على الغيب رأيٌ ما يكادُ يَفيلُ",55,"ل",1,0],["وعزيمةٌ هجماتُها دُفعٌ","كالسَّيل طامنَ عنقه الصَّبَبُ",56,"ب",1,0],["وَعَزيمٌ تَخُبُّ بِاِبنِ عَزيمٍ","جاذِباهُ الإِدلاجُ وَالتَأويبُ",57,"ب",1,0],["وَعَزيمَةٌ يُمضي بِها","فَصلَ الخِطابِ فَما يَرُدُّه",58,"د",2,0],["وَعَزيزٌ إِلّا لَدَيكَ بِهَذا ال","فَخِّ أَخذُ الغِلمانِ بِالأَشعارِ",59,"ر",1,0],["وَعَزَّكَ مِهراقٌ مِنَ الدَمعِ حَيثُما","تَوَجَّهَ بَعدَ البَينِ صادَفَ مَهرَقا",60,"ق",2,0],["وَعَزيزٌ عَلَيَّ أَن أَنزَلَتني","مَثُلاتُ الدُنيا إِلى أَمثالِك",61,"ك",1,0],["وعَزمةٌ يَنطوي اللَّيلُ البَهيمُ بها","كأنَّما الصُّبح جُزْءٌ من تَلالِيها",62,"ي",3,0],["وَعزَّ على العَلياءِ أن حِيلَ بينَه","وبينَ ظُبَا أسيافِه والعَواملِ",63,"ل",1,0],["وعَزمَةٌ لا تَزالُ الدَّهرَ نَجدَتَه","تَهُزُّ منها على الأَعداءِ أسيافا",64,"ف",2,0],["وَعَزَّتها كَواهِلُها وَكَلَّت","سَنابِكُها وَقَدَّحَتِ العُيونُ",65,"ن",1,0],["وَعَزَمتَ مِنكَ عَلى الحَيا","ةِ وَطولِها عَزماً بَتاتا",66,"ت",2,0],["وَعَزَلنا الإِدامَ فيهِ وَلُذنا","بِقَنانٍ مَصفوفَةٍ وَقِيانِ",67,"ن",1,0],["وَعَزّوا إِلى أَن سالَمَتهُم نُجومُها","فَلا نَجمَ إِلّا وَهوَ في رَبعِهِم سَعدُ",68,"د",1,0],["وَعَزمٍ يُزيلُ الخَطبَ عَن مُستَقَرِّهِ","رَأَينا بِهِ السَبعَ الطِباقَ ثَمانِيا",69,"ي",2,0],["وعزّكُمُ يُفْضي إلى الذلّ والنّوَى","من البينِ تَرْمي الشملَ منكم بما ترمي",70,"م",2,0],["وعزّيْتُ فيها النّفسَ لمّا رأيْتُها","تُكابِدُ داءً قاتل السمّ ناحِسا",71,"س",2,0],["وعَزائِمٍ تَرمِيهُمُ بِضَراغِمٍ","تستأصلُ الآلافَ بالآحادِ",72,"د",1,0],["وَعَزيزٌ عَلَيَّ أَن تَجتَني الأَب","صارُ زَهرَ الرَبيعِ مِن وَجنَتَيكا",73,"ك",2,0],["وَعَزائِماً في الرَوعِ مُعتَصِمِيَّةً","مَيمونَةَ الإِدبارِ وَالإِقبالِ",74,"ل",1,0],["وَعَزَزتُ بِالسَبُعِ الَّذي بِزَئيرِهِ","أَمسَت وَأَصبَحَتِ الثُغورُ غَريفا",75,"ف",2,0],["وَعَزْمَةٌ بَعَثَتْهَا هِمَّةٌ شَهَرَتْ","بِهَا عَلَى الدَّهْرِ عَضْباً لَيْسَ يَنْثَلِمُ",76,"م",1,0],["وعزلُ الفتى في اللهِ أكبرُ منصبٍ","يقيهِ الذي يخشى بحسن يقينهِ",77,"ه",1,0],["وَعَزمٌ يُذِلُّ الطَودَ هَدّاً وَنَجدَةٌ","تَهُزُ قُدودَ السُمرِ في الحُلَلِ الحُمرِ",78,"ر",1,0],["وَعِزُّ شَبابٍ كانَ قَد هانَ بُرهَةً","أَلا إِنَّها الأَعلاقُ تَغلو وَتَرخُصُ",79,"ص",1,0],["وَعَزَّ الهُدى مِنهُ بِأَمجَدَ أَوحَدٍ","طَويلِ نِجادِ السَيفِ أَبلَجَ أَروَعا",80,"ع",2,0],["وَعَزَّيتُ نَفسي وَهيَ بَينَ صَبابَةٍ","تَجودُ وَهَل لي بِالفُراقِ يَدانِ",81,"ن",1,0],["وَعَزَّيتُ نَفساً عَن هَواكِ كَريمَةً","عَلى ما بِها مِن لَوعَةٍ وَغَليلِ",82,"ل",1,1],["وَعَزِّ حُ