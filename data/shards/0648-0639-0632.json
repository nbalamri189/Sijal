ا بحياتي","https://www.aldiwan.net/poem64737.html","الطويل"],[50,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[50,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[19,"أيتها النفس أجملي جزعا","https://www.aldiwan.net/poem347.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16679","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54528","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54753","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[22,"تَجَهَّمَ لي بالبِشْر يَوْمَ لَقِيتُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=19811",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[45,"رأيت القعود على الإقتصاد","https://www.poetsgate.com/ViewPoem.aspx?id=31306",""],[51,"لا يُخطئنِّي منك لَوزينَجٌ","https://www.poetsgate.com/ViewPoem.aspx?id=25875",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[85,"سقى اللهُ بالكفر الأباظيِّ مضجعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9636&r=&rc=126",""],[57,"خبتْ نارُ نفسي بِاشْتِعالِ مَفَارِقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14210&r=&rc=6",""]],"verses":[["وَعَزمٍ يُشاوِرُ حَدَّ الحُسامِ","وَيَدنو وَقائِمُهُ غَيرُ داني",0,"ي",1,0],["وَعِزٍّ لا يُزَعزَعُ بِالرَزايا","وَطودٍ لا يُضَعضَعُ بِالزِحامِ",1,"م",1,0],["وَعَزمٍ أُعاطيهِ العَوالي وَحاجَةٍ","رَمَيتُ بِها ما بَينَ أَرضٍ وَتَنسِمِ",2,"م",1,0],["وَعَزمٌ إِن مَضَيتَ بِهِ جَريّاً","هَوى مَطَرُ القَنا بِدَمٍ صَبيبِ",3,"ب",1,0],["وَعَزمٍ كَأَطرافِ الأَسِنَّةِ في الحَشا","طَعَنتُ بِهِ كَيدَ العَدوِّ المُوارِبِ",4,"ب",1,0],["وَعِزُّكَ باقٍ لا يُزَلزَلُ طَودُهُ","وَكُلُّ المَعالي بَينَ ماضٍ وَآيِبِ",4,"ب",1,0],["وعَزْمَةُ القادِرِ المَحْبُوِّ سائِلُهُ","والخارجي لَوى منْ جيدِه الأشَرُ",5,"ر",1,0],["وعزّةُ المُقْتَدي تُكْسى مَهابَتُها","حتى يَعودَ خفيّاً دونَكَ النّظَرُ",5,"ر",1,0],["وعِزٌّ بمَرْسى الأخْشَبَيْنِ مُخيِّمٌ","ومجْدٌ لدى البَيْتِ العَتيقِ عَتيقُ",6,"ق",1,0],["وعزَّ بكَ الشّرْقُ حتى لوى","إليكَ أخادِعَهُ المَغْرِبُ",7,"ب",1,0],["وعَزمَةٍ نالَ بها ما ابْتَغى","منَ العِدا والسّيْفُ مَقْروبُ",8,"ب",1,0],["وعَزّوا حين غِبْتَ فهُمْ أُسودٌ","وذلّوا إذْ حَضَرْتَ فهُمْ نَقادُ",9,"د",1,0],["وعَزْمَةُ ذي شِبلَيْنِ ضاقَ بِهَمِّه","ذِراعاً فلا يَثْنيهِ زَجْرٌ ولا رَدُّ",10,"د",1,0],["وعَزْمَةُ ذي شِبلَينِ إن شمَّ مَرْغَماً","أخاضَ النّجيعَ الوردَ ناباً وأولَغا",11,"غ",2,0],["وعِزَّةٌ دونَ أدْناها مُمَنَّعَةٌ","ممّا يُناجي عَلَيهِ الفَرْقَدَ الوَعِلُ",12,"ل",1,0],["وعَزْمٍ إذا ما الحَرْبُ حَطّتْ لِثامَها","يُلَوِّي أنابيبَ الوَشيجِ المُقَوَّمِ",13,"م",1,0],["وَعَزيزَةٍ مَفقودَةٍ قَد هَوَّنَت","مُهَجُ النَوافِلِ بَعدَها مَفقودَها",14,"د",3,0],["وعَزيزٌ عليّ أنْ كُنْتَ يَحْيَى","ثمّ لمْ تأخُذِ الكِتابَ بقُوّهْ",15,"و",2,0],["وَعَزماً شَآمِيّاً لَهُ أَينَما مَضى","شَبا هِندُوانِيٍّ وَحَدُّ يَماني",16,"ي",1,0],["وَعَزائِمٌ كانَت تَفُلُّ عَزائِمَ ال","أَحداثِ وَالأَيّامِ وَالأَعداءِ",17,"ا",2,0],["وَعَزمَةٌ لَو قُسِّمَت في الوَرى","باتوا مِنَ الشِعرى عَلى مَسمَعِ",18,"ع",1,0],["وَعِزَّهُ داؤُها وَقَد شَهِدَت","لَهُ رُواةُ الأَخبارِ بِالخُبرِ",19,"ر",1,0],["وَعَزيزِ قَومٍ مُترَفٍ سَربَلتَهُ","ذُلّا وَكانَ الطاغِيَ المُتَمَرِّدا",20,"د",2,0],["وَعَزَاءَكُمْ يَا آلَهُ إِنَّ الَّذِي","تَبْكُونَهُ فِي نِعْمَةٍ وَجِنَانِ",21,"ن",1,0],["وَعَزَاءَكُمْ يَا مُعْجَبِينَ بِفَضْلِهِ","فِيمَا دَنَا وَنَأَى مِنَ الأَوْطَانِ",21,"ن",1,0],["وَعَزَّ أَسَا دَارِ السَّلامِ وَصُوِّحَتْ","بِقَاعُ العَزِيزِ الخُضْرُ وَاهْتَزَّ لُبْنَانُ",22,"ن",1,0],["وَعَزِيزُهَا بِسِلاحِهِ وَكِفَاحِهِ","وَذَلِيلُهَا بِالحَقِّ وَالبُرْهَانِ",23,"ن",1,0],["وَعَزِيمَةٌ قُرِنَتْ بِصَبْرٍ لَمْ تَدَعْ","لَكَ فِي مَجَالِ السَّبْقِ مِنْ أَقْرَانِ",23,"ن",1,0],["وَعَزَاؤُنَا هُوَ مُلْتَقَى أَرْوَاحِنَا","بِالذِّكْرِ بَعْدَ تَشَتُّتِ الأَجْسَامِ",24,"م",1,0],["وَعِزةٍ كَالرَّوَاسِي","وَرِقَّةٍ كَالنَّسِيمِ",25,"م",1,0],["وعزمك أمضى من حسامك في الوغى","وإن كان مصقول الغِرَارَيْنِ ماضيا",26,"ي",2,0],["وَعزمٍ كما انشقَّ الصباح مُصَمِّم","ورأي به بيض الصوارم تُرْهَفُ",27,"ف",1,0],["وَعَزمَةٌ لايَنامُ اللَيلَ صاحِبُها","إِلّا عَلى ظَفَرٍ في طَيِّهِ كَرَمُ",28,"م",1,0],["وَعَزمَةُ خَرّاجٍ مِنَ الضَيمِ فاتِكٍ","وَفِيٍّ أَبِيٍّ يَأخُذُ الأَمرَ مِن عَلِ",29,"ل",1,0],["وعزيزةٍ هي للنواظرِ جنَّةٌ","تجلى ولكن للقلوب شقاء",30,"ا",2,0],["وعزٍّا كبتّ به العدَى لما رأوا","من رفعِ منزلة وفيض سماح",31,"ح",1,0],["وعزمٌ إلى الأخرى يهمّ نهوضه","ولكنه بالذَّنبِ كالظَّهر مُوقَر",32,"ر",1,0],["وعزّ لقاؤنا والربع دانٍ","كما أبصرت تفليج الثغور",33,"ر",1,0],["وعزّ قولي ولم أقصد بوافده","إلاَّ العزيز ولم أبذله مجَّانا",34,"ن",2,0],["وعزيزٌ عليَّ عَضِّيكَ باللو","م ولكنْ أصبتَ صدري بداءِ",35,"ا",2,0],["وعزيزٌ عليَّ أنْ قلتُ ما قل","تُ ولكنْ حرَّقْتَني إحْماءَ",36,"ا",2,0],["وعزةُ المعروف في ذُلِّه","وذلّةُ العُرف إذا استصْعِبا",37,"ب",2,0],["وعزَّ عليَّ أن تبْلى وأبقى","ولكنَّ الحوادثَ لا تُحابي",38,"ب",2,0],["وعزاك عن ليل الشباب معاشرٌ","فقالوا نهارُ الشيب أهدى وأرشدُ",39,"د",1,0],["وعزَّى أناساً أن كل حديقةٍ","وإن أغْدَقَتْ أفنانُها ستخضَّدُ",39,"د",1,0],["وعزيزٌ عليَّ مَدْحِيَ نفسي","غير أني جُشِّمتُه للدلالهْ",40,"ل",2,0],["وعزَّ على مولاكَ صَرْفُ اهتمامِه","إلى القُوتِ لكنْ أمرهُ مُتفاقمُ",41,"م",1,0],["وعزيفٍ عليه من مُسْمِعات","وحديثٍ عليه من أخلام",42,"م",1,0],["وعزيزٌ عليَّ تَقْريعُ خِلّ","لا يُدانيه عنديَ الخلان",43,"ن",1,0],["وعزيزٌ عليَّ سلِّيه لكنْ","كُلُّ سَيْفٍ فللظهور كُمونه",44,"ن",2,0],["وعزيزٌ عليهما أن يكونا","عنك لولا الإزعاج يرتحلان",45,"ن",1,0],["وَعَزَّ عِندي تَسييرُ ذاكَ وَقَد","شَبَّهتَهُ بِالخُدودِ وَالحَدَقِ",46,"ق",1,0],["وعَزِّها عَنْ أَساها","فقدْ دَهَتْها المُصيبَهْ",47,"ه",1,0],["وعزيز على العروبة ان يغمد","في قبر سيفها المسلول",48,"ل",1,0],["وعزة الله بلا عزت","لا تنفع القارى ولا خردله",49,"ل",2,0],["وَعَزَّيتُ بَيتاً قَد تَبارَت سَماؤُهُ","مَشايِخَ أَقماراً وَمُرداً دَرارِيا",50,"ي",2,0],["وَعَزمُكَ مِن هوميرَ أَمضى بَديهَةً","وَأَجلى بَياناً في القُلوبِ وَأَعذَبُ",51,"ب",1,0],["وعَزيزٍ بينَ الدَّلالِ وبينَ المُلْ","كِ فارَقْتُهُ على رَغْمِ أَنْفي",52,"ي",1,1],["وَعَزمَةٌ بَعَثَتها هِمَّةٌ زُحَلٌ","مِن تَحتِها بِمَكانِ التُربِ مِن زُحَلِ",53,"ل",1,0],["وَعَزَّت قَديماً في ذَراكَ خُيولُهُم","وَعَزّوا وَعامَت في نَداكَ وَعاموا",54,"م",3,0],["وعزمةُ مطرود الرُّقادِ يدُلُّهُ","على الغيب رأيٌ ما يكادُ يَفيلُ",55,"ل",1,0],["وعزيمةٌ هجماتُها دُفعٌ","كالسَّيل طامنَ عنقه الصَّبَبُ",56,"ب",1,0],["وَعَزيمٌ تَخُبُّ بِاِبنِ عَزيمٍ","جاذِباهُ الإِدلاجُ وَالتَأويبُ",57,"ب",1,0],["وَعَزيمَةٌ يُمضي بِها","فَصلَ الخِطابِ فَما يَرُدُّه",58,"د",2,0],["وَعَزيزٌ إِلّا لَدَيكَ بِهَذا ال","فَخِّ أَخذُ الغِلمانِ بِالأَشعارِ",59,"ر",1,0],["وَعَزَّكَ مِهراقٌ مِنَ الدَمعِ حَيثُما","تَوَجَّهَ بَعدَ البَينِ صادَفَ مَهرَقا",60,"ق",2,0],["وَعَزيزٌ عَلَيَّ أَن أَنزَلَتني","مَثُلاتُ الدُنيا إِلى أَمثالِك",61,"ك",1,0],["وعَزمةٌ يَنطوي اللَّيلُ البَهيمُ بها","كأنَّما الصُّبح جُزْءٌ من تَلالِيها",62,"ي",3,0],["وَعزَّ على العَلياءِ أن حِيلَ بينَه","وبينَ ظُبَا أسيافِه والعَواملِ",63,"ل",1,0],["وعَزمَةٌ لا تَزالُ الدَّهرَ نَجدَتَه","تَهُزُّ منها على الأَعداءِ أسيافا",64,"ف",2,0],["وَعَزَّتها كَواهِلُها وَكَلَّت","سَنابِكُها وَقَدَّحَتِ العُيونُ",65,"ن",1,0],["وَعَزَمتَ مِنكَ عَلى الحَيا","ةِ وَطولِها عَزماً بَتاتا",66,"ت",2,0],["وَعَزَلنا الإِدامَ فيهِ وَلُذنا","بِقَنانٍ مَصفوفَةٍ وَقِيانِ",67,"ن",1,0],["وَعَزّوا إِلى أَن سالَمَتهُم نُجومُها","فَلا نَجمَ إِلّا وَهوَ في رَبعِهِم سَعدُ",68,"د",1,0],["وَعَزمٍ يُزيلُ الخَطبَ عَن مُستَقَرِّهِ","رَأَينا بِهِ السَبعَ الطِباقَ ثَمانِيا",69,"ي",2,0],["وعزّكُمُ يُفْضي إلى الذلّ والنّوَى","من البينِ تَرْمي الشملَ منكم بما ترمي",70,"م",2,0],["وعزّيْتُ فيها النّفسَ لمّا رأيْتُها","تُكابِدُ داءً قاتل السمّ ناحِسا",71,"س",2,0],["وعَزائِمٍ تَرمِيهُمُ بِضَراغِمٍ","تستأصلُ الآلافَ بالآحادِ",72,"د",1,0],["وَعَزيزٌ عَلَيَّ أَن تَجتَني الأَب","صارُ زَهرَ الرَبيعِ مِن وَجنَتَيكا",73,"ك",2,0],["وَعَزائِماً في الرَوعِ مُعتَصِمِيَّةً","مَيمونَةَ الإِدبارِ وَالإِقبالِ",74,"ل",1,0],["وَعَزَزتُ بِالسَبُعِ الَّذي بِزَئيرِهِ","أَمسَت وَأَصبَحَتِ الثُغورُ غَريفا",75,"ف",2,0],["وَعَزْمَةٌ بَعَثَتْهَا هِمَّةٌ شَهَرَتْ","بِهَا عَلَى الدَّهْرِ عَضْباً لَيْسَ يَنْثَلِمُ",76,"م",1,0],["وعزلُ الفتى في اللهِ أكبرُ منصبٍ","يقيهِ الذي يخشى بحسن يقينهِ",77,"ه",1,0],["وَعَزمٌ يُذِلُّ الطَودَ هَدّاً وَنَجدَةٌ","تَهُزُ قُدودَ السُمرِ في الحُلَلِ الحُمرِ",78,"ر",1,0],["وَعِزُّ شَبابٍ كانَ قَد هانَ بُرهَةً","أَلا إِنَّها الأَعلاقُ تَغلو وَتَرخُصُ",79,"ص",1,0],["وَعَزَّ الهُدى مِنهُ بِأَمجَدَ أَوحَدٍ","طَويلِ نِجادِ السَيفِ أَبلَجَ أَروَعا",80,"ع",2,0],["وَعَزَّيتُ نَفسي وَهيَ بَينَ صَبابَةٍ","تَجودُ وَهَل لي بِالفُراقِ يَدانِ",81,"ن",1,0],["وَعَزَّيتُ نَفساً عَن هَواكِ كَريمَةً","عَلى ما بِها مِن لَوعَةٍ وَغَليلِ",82,"ل",1,1],["وَعَزِّ حُماةَ النّيلِ وَاسْتفتِ أهلَه","أحقَّاً أضاعوا الرأي واستشعروا العَمى",83,"م",2,0],["وَعَزّى بَني الشَرقِ عَن مَجدِهِ","وَبارك لِلغَرب في أُمَّتِه",84,"ت",2,0],["وَعَزيز عَليَّ أَن تُبصر العَي","ن فَلسطين وَهِيَ تُعطي هَديه"