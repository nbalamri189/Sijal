{"poems":[[57,"ما كان في الدور من أنس بغيركم","https://www.aldiwan.net/poem26293.html","البسيط"],[79,"قالوا كلفت به غلاما حالكا","https://www.aldiwan.net/poem36649.html","الكامل"],[74,"يا رب أسألك الغنى عن معشر","https://www.aldiwan.net/poem18657.html","الكامل"],[93,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[72,"رحل الواشون عنا","https://www.aldiwan.net/poem42400.html","مجزوء الرمل"],[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[87,"قالوا كرومر قد ولى","https://www.aldiwan.net/poem7269.html","مجزوء الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85803","البسيط"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[79,"قالوا كلفت به غلاما حالكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54606&r=&rc=128",""],[128,"قالوا كبا جواده وما كبا","https://www.aldiwan.net/poem23744.html","الرجز"],[132,"صب تحرقه أسى لرعاته","https://www.aldiwan.net/poem50654.html","الكامل"],[164,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[408,"قالوا ذكرت أبا بكر فقلت لهم","https://www.aldiwan.net/poem46946.html","البسيط"],[469,"قالوا كسا الزقزوق واعظه","https://www.aldiwan.net/poem3238.html","عموديه"],[484,"في موقف العدل والأبصار شاخصة","https://www.aldiwan.net/poem37613.html","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27813","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60853","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121344","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139902","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85088","البسيط"],[3825,"","https://poetry.dctabudhabi.ae/diwan/poem/206304",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69913","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4755,"صَوتَكْ سَالْ في دَفتَري","https://www.poetsgate.com/ViewPoem.aspx?id=195278",""],[4830,"سَلْ طرفَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=211160",""],[4836,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=207082",""],[4959,"الشَّهِيدُ الْفِلَسْطِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=213889",""],[5186,"قالوا طغى وبغى وجار وأفرطا","https://www.poetsgate.com/ViewPoem.aspx?id=156546",""],[5200,"وعظ المشيب فمرحبا","https://www.poetsgate.com/ViewPoem.aspx?id=200804",""],[5320,"على لسان كفيف","https://www.poetsgate.com/ViewPoem.aspx?id=40400",""]],"verses":[["قَالوا كَتَمتَ اِسمَها فَاِنعَت مَحاسِنَها","وَذاكَ خَطبٌ جَليلٌ غَيرُ مَحقورِ",0,"ر",1,0],["قالُوا كَلِفْتَ بهِ غُلاماً حالِكاً","فأجَبْتُمْ لي فيهِ ما يَشْفي المُهَجْ",1,"ج",1,1],["قالوا كرهنا منه مدّ لسانه","والله ما كرهوا سوى مدّ اليد",2,"د",1,0],["قالوا كُهولٌ قَد تَصَرَّمَ عَصرُهُم","لَيتَ الشَبابَ مِنَ الكُهولِ تَعَلَّموا",3,"م",3,0],["قالوا كَبِرتَ عَنِ الصِبا","وَقَطَعتَ تِلكَ الناحِيَه",4,"ه",1,0],["قالوا كفرت ولم اكفر كما زعموا","أكل من قال حقا بينا كفرا",5,"ر",2,0],["قالوا كرومر قد ولى","من مصر بل قالوا أدبر",6,"ر",1,1],["قالوا كفرت ولم أكفر كما زعموا","أكلُّ من قال حقّا بيننا كفرا",7,"ر",2,0],["قالوا: كبحتَ النفسَ، قلنا: فارس","يعتاد منذ صباه كبح جياد",8,"د",1,0],["قالوا كلفت به غلاما حالكا","فأجبتهم لي فيه ما يشفي المهج",9,"ج",1,1],["قالوا كبا جواده وما كبا","قالوا نبا حسامه وما نبا",10,"ب",2,1],["قالوا كبدر النِّمِّ غُرَّةُ وجهه","كذبوا فأين صفاؤه وصفاتُه",11,"ت",2,0],["قالوا كذبنا في الشهادة أولا","والحق خذه من الشهاة آخرا",12,"ر",2,0],["قالوا كِرامٌ وَأَتى بَعدَهُم","لِلُّؤمِ أَزمانٌ وَأَزمانُ",13,"ن",1,0],["قالوا كذاكَ أَبا حَفْصٍ وصَاحبَه","عثمان قلتُ نعمْ والحمدُ الله",14,"ه",1,0],["قالوا كسا الزقزوق واعظه","فأجبت تلك رذيلة الفلك",15,"ك",1,1],["قالوا كفى الغرم تعويضا وترضية","والمال عارية والجرح ملتثم",16,"م",1,0],["قالوا كمثلِ قولنا","قولاً صحيحاً بيّنا",17,"ن",2,0],["قَالُوا كَلاَمُ الله كُلُّ هَ","ذا خَلقِ مِن جِنٍّ وَمِن إنسَانِ",18,"ن",1,0],["قالوا كتمت الحبَّ حينَ أذعتَه","مَن سِرّهُ في جفنِه هل يكتم",19,"م",1,0],["قالوا كريم قلت ما برهانكم","الكف معطية هي البرهان",20,"ن",1,0],["قالوا كسوفُ الشمسِ مقترب","قلت ادخرتُ لدفعِ نائبها",21,"ب",3,1],["قالوا كبرتَ ولمْ تبرح كذا غَزلاً","أزرى بك الفاضحان الشيبُ والغزلُ",22,"ل",1,0],["قالوا كما الورق أن غنت فقلت لهم","تاللَه لا تتساوى العجم والعرب",23,"ب",1,0],["قالوا: كتمت هواه عن جلد","لو أن لي رمقاً لبحت به",24,"ب",2,0],["قالوا كسوناهُ ثَوباً نَحنُ نَلبسهُ","مِن بَعدِ نقاشِه وَالدَمعُ منهمرُ",25,"ر",1,0],["قالوا كأنّ الحكمَ أوقرَ سمعه","وجداً فلا يصغى للومةِ لائم",26,"م",1,0],["قالوا: كنتْ سِبتمبري","سَقف الشَّمس هامَتَكْ",27,"ك",1,0],["قالوا كفاكَ : فقلتُ اِنّي لا أرى","في مُعجَمِ العشاقِ لفظَ كِفايَهْ",28,"ا",3,0],["قالوا : كأنَّك لم تكُنْ مِنْ أرضِنا","عَجَباً ، أتعشَقُ كائِناً لم يُخْلَق ِ؟!",29,"ق",1,0],["قَالُواْ كَأَنَّكَ مِنْ لُبْنَانَ قُلْتُ لَهُمْ","مِصْرٌ كَلُبْنَانَ عِنْدِي الْكُلُّ أَوْطَانُ",30,"ن",1,0],["\"قالوا: كذبت، فإن في \"\"أحراره\"\"\"","ما قد أصاب، مسطرا ومخططا",31,"ط",2,0],["قالوا كبرت فقلت بل","زينت بالثوب القشيب",32,"ب",1,0],["قَالوُا كَفيفاً .. قُلتُ أُبصِر بالفُؤاد","لا لن يعوق الطرف عن شرف الجهاد",33,"د",1,1]]}