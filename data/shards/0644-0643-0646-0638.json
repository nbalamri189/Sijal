{"poems":[[99,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[354,"يا مي مل الهوى إلا معناك","https://www.aldiwan.net/poem15813.html","البسيط"],[396,"أشكو إلى الواحد الرحمن","https://www.aldiwan.net/poem54486.html","عموديه"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125453","الكامل"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143026","الكامل"],[4788,"ذكرى تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=132307",""],[4816,"بوابة وموقع","https://www.poetsgate.com/ViewPoem.aspx?id=27086",""],[5136,"من في الملوك يقاس بالشمس","https://www.poetsgate.com/ViewPoem.aspx?id=121607",""],[5277,"يا سيّدَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188104",""],[5861,"لغز العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190728",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[5956,"حربُ تَشرين التحريرية","https://www.poetsgate.com/ViewPoem.aspx?id=194123",""]],"verses":[["لك نظرة الفجر الجَمي","لِ على الذوائبِ والقمم",0,"م",1,0],["لَكَ نَظْمٌ فِي المَكْرُمَاتِ بَدِيعٌ","شِعْرُهُ نَمَّ عَنْ أَرَقِّ الشُّعُورِ",1,"ر",1,0],["لَكِن ظُهورِكَ بِالتَأنيسِ جَسِّرَني","حَتّى تَفَوَّهتُ في سِرّي بِذِكراكِ",2,"ك",1,0],["لكن ظني حسن في الله","بأن يجيني فرج في الآن",3,"ن",1,0],["لكن ظفار مع ذا جَنّة","طيّبة المطعم والمشربِ",4,"ب",1,0],["لكن ظني جميل بالإله ومن","يحسن الظن تكنفه الرعايات",5,"ت",1,0],["لكن ظني جميل بالجميل ومن","يحسن الظن في رحمانه رحما",6,"م",2,0],["لكِ نظرةٌ فتنَ الجمالَ بسحرِها","ومُقَبَّلٌ يفى غليل الصادي",7,"د",2,0],["لكن ظفرت بحبها وبحبنا","وعدمت في القدر الأعز مثيلا",8,"ل",2,0],["لَكِن ظَوَاهِرُ مَا يُطَابِقُ ظَنَّهَا","مَا فِي الحَقِيقَةِ عِندَنَا بِوِزَانِ",9,"ن",1,0],["لكن ظننت بأن جدي ربما","يجدي ويغنم فيك طول جهادي",10,"د",2,0],["لكن ظهر ثم حط في رجلي اقيود","أثر الحزن مالك حياتي وكدي",11,"د",2,0],["لك نظمت الشعر واهديك القوافي","علني اوفيك باسم الشعر شيا",12,"ي",2,0],["لكن ظل الله منه علا","في الزوال وهي على العكس",13,"س",1,0],["لكنَّ ظني بربِّ العرشِ يرحمني","ورحمةُ اللهِ تأتي كلَّ ملتمسِ",14,"س",1,0],["لكَ نظرةٌ فيها الحروفُ تُقالُ","فترى الفؤادَ بسحرِها يُغتالُ",15,"ل",1,1],["لكن ظننتَ مدائحي","عكسا لما في باليا",16,"ي",2,0],["لكنَّ ظلم ذوي الأطماع يدفعهم","أن يرفضوا السلم إلا عادل الشِّيَمِ",17,"م",1,0]]}