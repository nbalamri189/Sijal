{"poems":[[47,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[30,"ولست بناس فضل مروان ما دعت","https://www.aldiwan.net/poem5320.html","الطويل"],[51,"كأن المنايا قد قرعن صفاتي","https://www.aldiwan.net/poem10835.html","الطويل"],[82,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[385,"نسبتم إلى المقهور ما اقترف الدهر","https://www.aldiwan.net/poem48761.html","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145959","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111248","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34639","الطويل"],[6070,"رحى الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=188815",""]],"verses":[["حُتوفٌ أَصابَتها الحُتوفُ وَأَسهُمٌ","مِنَ المَوتِ كَرَّ المَوتُ فيها بِأَسهُمِ",0,"م",1,0],["حُتوفُ المَنايا قَد أَطَفنَ بِنَفسِهِ","وَأَشلاءِ مَحبوسٍ عَلى المَوتِ واقِفِ",1,"ف",1,0],["حُتوفُ المَنايا قاصِداتٌ لِمَن تَرى","مُوافينَ بِالرَوحاتِ وَالغَدَواتِ",2,"ت",1,0],["حُتوفٌ على سَرْحِ النّفوسِ مغيرةٌ","فقلْ كيف تغدو وهيَ آمنةُ السّرْبِ",3,"ب",1,0],["حُتوفٌ تَلَهّى بأمْثالِها","وأُسْدٌ تُغِذُّ بأُسْدِ الشَّرَى",4,"ا",1,0],["حتوّاً عَلى جان مَحا العَتب صَبرَهُ","فَما ذَنبَهُ عَمد وَما قَلبُهُ صَخر",5,"ر",1,0],["حُتوفي الغاضباتُ أنا مُدِلٌّ","حوافرَها على غَبَش اليَمَامِ",6,"م",1,0],["حتوا اتوا ارض الطفوف بنينوي","ارض الكروب وارض كل بلاء",7,"ا",2,0],["حتوفاً اذا وجهتهن قواضباً","عجالاً اذا أغريتهن بزجركما",8,"ك",3,0],["حتوفُ الدّّهرِ آتيةٌ","فلا منجى ولا هرَبُ",9,"ب",1,0]]}