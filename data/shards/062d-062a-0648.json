{"poems":[[45,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[28,"ولست بناس فضل مروان ما دعت","https://www.aldiwan.net/poem5320.html","الطويل"],[49,"كأن المنايا قد قرعن صفاتي","https://www.aldiwan.net/poem10835.html","الطويل"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[380,"نسبتم إلى المقهور ما اقترف الدهر","https://www.aldiwan.net/poem48761.html","الطويل"]],"verses":[["حُتوفٌ أَصابَتها الحُتوفُ وَأَسهُمٌ","مِنَ المَوتِ كَرَّ المَوتُ فيها بِأَسهُمِ",0,"م",1,0],["حُتوفُ المَنايا قَد أَطَفنَ بِنَفسِهِ","وَأَشلاءِ مَحبوسٍ عَلى المَوتِ واقِفِ",1,"ف",1,0],["حُتوفُ المَنايا قاصِداتٌ لِمَن تَرى","مُوافينَ بِالرَوحاتِ وَالغَدَواتِ",2,"ت",1,0],["حُتوفٌ على سَرْحِ النّفوسِ مغيرةٌ","فقلْ كيف تغدو وهيَ آمنةُ السّرْبِ",3,"ب",1,0],["حُتوفٌ تَلَهّى بأمْثالِها","وأُسْدٌ تُغِذُّ بأُسْدِ الشَّرَى",4,"ا",1,0],["حتوّاً عَلى جان مَحا العَتب صَبرَهُ","فَما ذَنبَهُ عَمد وَما قَلبُهُ صَخر",5,"ر",1,0]]}