{"poems":[[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30502","البسيط"],[86,"نالت سليمان منه رجل","https://www.poetsgate.com/ViewPoem.aspx?id=26365",""],[185,"يا سخنة العين للجرمى إن جمعت","https://www.aldiwan.net/poem58812.html","البسيط"],[215,"أقبل العيد ما رأينا صفاه","https://www.aldiwan.net/poem46236.html","الخفيف"],[261,"يا سخن العين التي لم تزل","https://www.aldiwan.net/poem48416.html","السريع"],[369,"فعلت هذه الجفون الضواري","https://www.aldiwan.net/poem60874.html","الخفيف"],[471,"يا سخنة العين للجرمي إذ جمعت","https://www.aldiwan.net/poem50425.html","البسيط"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75796","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133794","الرمل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121868","السريع"],[259,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=180839",""],[5434,"رجتني الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=37621",""]],"verses":[["يا سُخْطَ ربِّ العُلا علَيْهِ","إِذْ أَدَّتِ المُرْتَضَى يَدَاهُ",0,"ا",2,0],["يا سخط رب العلا عليه","إذا ادت المرتضى يداه",1,"ا",2,0],["يا سُخنَةَ العَينِ للجَرمِىِّ إِن جَمَعَت","بَينِى وَبَينَ هَوَى وَحشِيَّةَ الدَّارُ",2,"ر",1,1],["يا سخيفا فاق كل سخيف","وبكيد الأحرار ظلما معنى",3,"ن",2,0],["يا سخن العين التي لم تزل","تعيش في الناس بلا عقلِ",4,"ل",1,1],["يا سَخيّاً بكلِّ ما لا يُريدُ الصْ","صَبُّ من جَفوةٍ ومن نَأْي دار",5,"ر",1,0],["يا سَخنَةَ العَينِ لِلجَرميِّ إِذ جَمَعَت","بَيني وَبَينَ نُوارٍ وَحشَةُ الدارِ",6,"ر",1,1],["يا سَخيف الطباع ضيف غَريب","ذاق منك المرار صَرفاً مِرارا",7,"ر",2,0],["يا سخي القلب لم يدعُك","للتضحيات الحمر صوت من جبالي",8,"ل",2,0],["يا سُخْرةَ الشيخِ بلا أُجْرَهْ","وفَسْوةَ المَبْطونِ في السُّحْرَهْ",9,"ر",2,1],["ياسخيَّ العفو صالحْ","ثم سامحْ يا رحيمُ",10,"م",1,0],["ياسخيف الذرعان ماني بمرجوج","رجتني الدنيا بغدر وحيله",11,"ل",2,1]]}