ا ألفَ شكر للسمية بِنْتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=206261",""],[159,"أَمَغْنَى الهَوَى غالَتْكَ أَيدي النِّوائِبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26937&r=&rc=8",""],[6288,"فضاء وانطلاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78108&r=&rc=32",""]],"verses":[["بِرَكبٍ فَرَوا بُردَ الظَلامِ وَقَلَّصوا","حَواشيهِ في أَيدي القِلاصِ الرَواتِكِ",0,"ك",1,0],["بِرَكبٍ تُرعَدُ الظَلماءُ مِنهُم","فَيَستُرُها مِنَ الجَزَعِ النَهارُ",1,"ر",1,0],["بِرَكضٍ يُصَدِّعُ صَدرَ الوِها","دِ حَتّى تَئِنَّ قُلوبَ الصَفا",2,"ا",1,0],["بَرَكَت عَلى جَنبِ الرِداعِ كَأَنَّم","بَرَكَت عَلى قَصَبٍ أَجَشَّ مُهَضَّمِ",3,"م",1,0],["بَركاتُ السّماءِ تَبْتَدِرُ الأرْ","ضَ إذا اسْتُودِعَتْ بُذورَ السّماحِ",4,"ح",1,0],["بَرَكاتُ هَذي لا يَغيضُ مَعينُها","نَفَحاتُ تِلكَ كَثيرُها مَأمولُ",5,"ل",1,0],["بِرَكائِبٍ مِن بَينِ كُلِّ ثَنِيَّةٍ","سُرُحِ اليَدَينِ وَبازِلٍ شِملالِ",6,"ل",1,0],["بِرَكبٍ سَرَوا حَتّى كَأَنَّ اِضطِرابَهُم","عَلى شُعَبِ المَيسِ اِضطِرابُ الغَدائِرِ",7,"ر",1,0],["بركةٌ لو يُزَلَّجُ ال","فِيلُ في دُبْرِهِ انْزَلَجْ",8,"ج",1,0],["بَرَكت تَلوحُ وَفي الفُؤاد بَلابِلُ","سفَهاً وَهَل يُثني الحَليمَ الجاهِلُ",9,"ل",1,1],["بَرَكاتُ شَيخٍ بِالصَعيدِ مُحَمَّلٌ","عِبءَ السِنينَ مُؤَمَّلٍ نَفّاحِ",10,"ح",1,0],["بِرَكٌ تحلَّتْ بالكواكبِ أرضُها","فَأَرَتْكَ وجهَ الأرضِ وهو سَماءُ",11,"ا",2,0],["بركاتُ السَّمح المؤمَّلِ يَقرِي","أُممَ الأرضِ زائراً أو مزورا",12,"ر",2,0],["بِرُكامٍ يَملَءُ الأَرضَ خَيلاً","وَرِجالٍ لا تَهابُ المَنونا",13,"ن",2,0],["بَرَكَت عَلى جَنبِ الرِداعِ كَأَنَّما","بَرَكَت عَلى قَصَبٍ أَجَشَّ مُهَضَّمِ",14,"م",1,0],["بركانُ حرب مسَّ مصرَ دخانُهُ","وكوى الشعوب بنار مقذوفاته",15,"ت",2,0],["بركات السماء تبتدر الأرض","إذا استودعت بدور السماح",16,"ح",1,0],["بِرَكٌ تحلَّتْ بالكواكبِ أرضُها","فارتْد وجهَ الأرضِ وهوسماءُ",17,"ا",2,0],["بركات رسل الله غير خفية","ومحمد خير البرية أبرك",18,"ك",1,1],["بركبٍ سُقُوا كَأْسَ الكَرى فرؤوسُهم","مُوَسَّدةٌ أَعْناقُها بِالمَنَاكبِ",19,"ب",1,0],["بَركات منك لا نَعْدَمُها","قَصَّرت فيها صِفاتُ المُطْنِب",20,"ب",1,0],["بركاتُك اشتملتْ عليه فما خَلا","منهن لا شهرٌ ولا إنسان",21,"ن",1,0],["بَركاتٌ أرخَت عليها رخاءً","في زمانٍ غالَ الجميع الغلاءُ",22,"ا",2,0],["بَرَكَت عَلى عادٍ كَلاكِلُ دَهرِهِم","وَثَمودَ بَعدَ تَكاثُرٍ وَثَراءِ",23,"ا",2,0],["برك قد حدثنا عن عطا","وصح ما جاء عن الناقل",24,"ل",1,0],["بَرَكَتْ بِهِمْ أَيَّامُهُمْ يَا عَائِذاً","بِاللهِ مِنْ سُوءِ الزَّمَانِ الْبَارِكِ",25,"ك",1,0],["بركاتها في المسلمين عميمة","كالغَيث يشمل سائر البلدان",26,"ن",1,0],["بَرَكَتْ بكُلّ مَحَلّةٍ بركاتُه","شَفْعاً يُبَادرُ بذلُها شُفعاءها",27,"ا",3,0],["بر كريم سخي النفس ينفق ما","حوت يداه من الدنيا بأيقان",28,"ن",1,0],["بركة الوجود مغنى الوفو","د عين الشهود مجلى الكمال",29,"ل",1,0],["بِركاب أَشرَفِ قادمٍ فَوقَ السُها","تَأبى علاه أَن تبوَّأ مَنزِلا",30,"ل",2,0],["بركاتُ مولانا عليكَ تعودُ","قرُبت فأنت من النحوسِ بعيدُ",31,"د",1,1],["بَرَكَاتٌ لديكَ وَفَّرَها اللَّ","هُ وأَبْقَى لها أَبَا البركات",32,"ت",1,0],["بِرْكَةٌ بُورِكَتْ فنحنُ لَدَيْهَا","نستفيدُ الغِمارَ من ضَحْضَاحِ",33,"ح",1,1],["بركاتِ الشهرِ المباركِ في العزّ","ولقّاهُ باكراتِ سُعودِه",34,"د",2,0],["بركاتٌ تتابعتْ في ذرى السعْ","دِ فكانتْ في وجنة الدهر خالا",35,"ل",2,0],["بركاتٌ لكم محت من فؤادي","ما أَمَلّ الضلالَ عمٌّ وخالُ",36,"ل",1,0],["بركن الدين سالمني زماني","وأطلقتِ الحوادثُ من وثَاقي",37,"ق",2,0],["بِرَكٌ مُمَنطَقَةُ الخُصورِ","وَرُبىً مُعَطَّفَةُ النُحورِ",38,"ر",1,1],["بَرَكاتُ عِندي كَاِسمِهِ بَرَكاتُ","ظَبيٌ طَرائِفُ طَرفِهِ اللَحَظاتُ",39,"ت",1,1],["برك المعهود عندي","بالغ فيه نصابك",40,"ك",1,0],["برَكاتُ لا برِحَ العُلا بوجودهِ","فرِحاً ولا فجِع الزّمانُ بفَقْدهِ",41,"د",2,0],["بَرَكنَ على وادي مِنىً بعد شِقْوَةٍ","ومِن بعد أنْ قضَّيْنَ منّا المناسكا",42,"ك",2,0],["بركبٍ أراق السّير ماءَ وجوههمْ","ولوّحَها تهجيرُهمْ في الودائقِ",43,"ق",1,0],["بِرَكبٍ خِفافٍ مِن زُجاجٍ كَأَنَّها","ثُدِيُّ عَذارى لَم تَخَف مِن يَدٍ كَسرا",44,"ر",2,0],["بِرُكنِهِ أَركانَ دَمخٍ لا نَقَعَر","أَرعَنَ جَرّارٍ إِذا جَرَّ الأَثَر",45,"ر",1,0],["بركاتك انسكبت عليه كأنها","أمطار فضل من لدنك غزار",46,"ر",1,0],["بركاته هطلت عليك كثيرة","وهباته كالصّيب المدرار",47,"ر",1,0],["بِرُكنٍ لا يُمَلُّ لَهُ استِلامٌ","وَمَنزِلَةٍ غَدَت لِلجَمعِ جَمعا",48,"ع",2,0],["بِرُكنَينِ مِن هَضّامَ هَضّامَةَ العِدَى","وَمِن قاسِمٍ أهلِ الفَخارِ المُقَسَّمِ",49,"م",1,0],["بركاتُ اللهِ قد حلَّت بها","فَهيَ من آثارِ بيتِ المقدسِ",50,"س",1,0],["برٌّ كفى أجراً عليه أن أرى","متنعماً مرحاً به يتمثل",51,"ل",1,0],["بركبك تعتز القرى والمدائنُ","وتستبق السبلَ المنى والميامنُ",52,"ن",1,1],["بركةٌ تُرْبَتها الكافو","رُ والدُّرُّ حَصَاها",53,"ا",3,0],["بِرَكٌ تُرْصَفُ الجواشنُ فيها","وسواقٍ تًسَلُّ سلَّ السيوف",54,"ف",1,0],["بركاتكم فاضت وخَا","دِمُكم بقدركم اعتنى",55,"ن",2,0],["بركاتُ سيدنا المعظم فيصل","طارت بهم في ساحل الأمن الأدلّ",56,"ل",1,0],["بركام مزن ودقه طبقٌ روى","متحلبٌ متدفقٌ سحّاح",57,"ح",1,0],["بِرُكوبِ المُقَبَّحاتِ جِهاراً","يَفسُدُ الجاهُ وَالمُروءَةُ تَخرَب",58,"ب",1,1],["بركينها السَيّار غارَ بِرَكبِنا","فَعَجِبتُ مِن رَكبٍ عَلى نيرانِ",59,"ن",1,0],["بركائب خوص براهن السرى","وغدت تقل من الجبال القودا",60,"د",2,0],["بركانه فيه خامدٌ أبداً","من نظرة باللحاظ يتقدُ",61,"د",1,0],["بُركت ليلةٌ تخيَّلت من أر","دانها عُطّرت بنشر الطيبِ",62,"ب",1,0],["بَرَكات وَجهك عمت الدنيا ومن","فيها فَجارك جاره لا يضهد",63,"د",1,0],["بركاتُ الإله يا نوحَ حلَّت","قُضِي الأمر أقلعي يا سماء",64,"ا",2,0],["بركبٍ إذا شامُوا البروقَ تَحَمَّلُوا","هو الموتُ إلا أنني أتجَمَّلُ",65,"ل",1,0],["بَرَكَت حِيالي كَالحَنِيَّةِ في الدُجى","وَهَجَدتُ مِثلَ المَشرَفيّ حِيالَها",66,"ل",3,0],["بِرِكابٍ عَلى رَكائِبِها رَك","ب خِفاقٌ كَأَنَّهُم أَفياءُ",67,"ا",2,0],["بركة الرطلي هواها","للنفوس أضحى مناها",68,"ه",2,0],["بركة ما تهيأت لبني العب","اس يوماً ولا بني مروان",69,"ن",1,0],["بركات هذي الارض من بركاته","وحياتُها بهوامعِ الأمطار",70,"ر",1,0],["بِرُّكَ النَفسَ أَن تُؤامِنَ بِاللَ","هِ مُطيعاً وَغَيرُ ذاكَ العقوقُ",71,"ق",1,1],["بَرَكَ الزَّمانُ عَلَيهِمُ بِجِرانِهِ","وَهَفَت بِهِم ريحُ الخُطوبِ الزّعزَعُ",72,"ع",1,0],["برّك ذاك الخفيّ أثقلني","وحمل ما لا أطيقه خطر",73,"ر",1,0],["بَرَكَ الزَمانُ عَلى اِبنِ هاتِكِ عَرشِهِ","وَعَلى أُذَينَةَ سالِبِ الأَنواحِ",74,"ح",1,0],["بركب ترى كسر الكرى في جفونهم","وعهد الليالي في وجوه شواحب",75,"ب",1,0],["برك لذي منزل وادع الاله وقل","ما جاء في سنن غفروا لذنبهم",76,"م",1,0],["برك لعرس بلام او بلفظ على","لا بالرفا وبنين لاتفه بهم",76,"م",1,0],["برْكانُ نارٍ حيث ثار","فوراً وصار له هَدير",77,"ر",1,0],["بركات الاسم والوصف ومن","ببرود الأنس والصفو كسى",78,"س",2,0],["بركوب مولي العالمي","ن من الاقاصي والاداتي",79,"ي",1,0],["بركاتهُ حلَّت فَحَلَّت جيدهم","كَالعقد بَل حلت مِراراً حَنضَلا",80,"ل",2,0],["برك الزمان على حماهمو فانثنوا","صرعى كأعجاز النخيل الناخره",81,"ر",2,0],["بركات الإشفاق منكَ أَعاد","تنيَ بعد الإشفاء حلفَ الشفاءِ",82,"ا",2,0],["بركان له الطهارة بردةٌ","سمح كأن له المحامد عنصر",83,"ر",1,0],["بركب بْحور الأمل وأبدأ أصيد","ما يحك جلدك مثل ظفرك أبد",84,"د",1,0],["بركاتٌ حقَّت حليمة منها","غاب عنها بؤس وطاب الرَّخاء",85,"ا",2,0],["بركانُ غضبتِك الجبارُ ُ ساعتُه","حانت وآن لها أن تصنعَ العجبَا",86,"ب",2,0],["بركان نار ظل يقذف مُهْلَهُ","حِمما تَصبُّ على الغزاة سوائله",87,"ل",2,0],["بركان حب وجوف قاعة تباريح","وأمطار شوق محمله عاد نايد",88,"د",1,0],["بركت في سباقها وهي تعدو","فنزاها الهوى وكان ضعيفا",89,"ف",2,1],["بركتْ منْ بعدِهمْ رجلي وما","أن أطاقتْ منْ نهوضٍ ركبتَيْ",90,"ي",1,0],["بركان شوقي يغلي فيَّ مصطبرا","في عمقه حمم والعقل مزدلف!",91,"ف",1,0],["بركان عشقي موقدٌ متوله","وعلى السفوح جداولي متفجره",92,"ر",2,0],["بركان جوعك قادمٌ","والموت أرسل خنجره",93,"ر",2,0],["بركان عزّتنا يفور ردىً","أن دنس العدوان منّا نعل",94,"ل",1,0],["بَرَكَاتُ آلِ قُحَافَةٍ، مِنْ عِقْدِهَا","فَإِذَا الصّعِيدُ لِمَنْ تَيَمّمَ مَنْشَدَا",95,"د",2,0],["بركاتُ عمري من رضاهُ","وتستمر ، وقد تولى",96,"ل",2,0],["بركاني الغافي لخمسة أشهرٍ","قدعاد يقذف ناره الوحشية",97,"ي",2,0],["بركانُ هذا القلبِ يَنفثُ غيرتي","يا غيثَ أشواقِ الجَوَى أطفيني",98,"ن",2,0],["بَرَكَاتُها في عيشنا بحِياضها","لكنَّ فِرعَوْناً أصرَّ لِنُقْصَما",99,"م",2,0],["بَرَكاتُهُ جَعَلَتْ لظاهم جنَّةً","يا ألف شكر للأخ المأمومِ",100,"م",1,0],["بركات ربي في طهارة كَسْبِهِ","جَرّا الزكاة على الفقير وحُبّهِ",101,"ب",2,0],["بركاته دوماً تهلّ لعيشتي","في وقت آلامي فأرجع حيّا",102,"ي",2,0],["بركاتُ أهلِك والشقيقِ المفتدى","زادت وأنقذت الجميع من العنا",103,"ن",2,0],["بركبٍ سقوا كأسَ الكرى فرؤسهم","مُوَسَّدة ٌ أَعْنَاقُها بالمُناكبِ",104,"ب",1,0],["بركب السكون ٍ يشق طريقا ً","على جانبيه نجوم السماء ْ",105,"ا",2,0]]}