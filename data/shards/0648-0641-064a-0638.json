طويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97876","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62761","الوافر"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66571","الهزج"],[3878,"","https://poetry.dctabudhabi.ae/diwan/poem/31437","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29310","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4984,"الْيَأْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=204660",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5266,"مُقَاسَاةُ لَيْلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=210314",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5910,"أقولُ وقد حنَّ الفؤادُ","https://www.poetsgate.com/ViewPoem.aspx?id=206880",""],[6367,"أشواق حجازية الإيقاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80598&r=&rc=1",""]],"verses":[["وفي ظلِّهِ الممدودِ حَطُّوا ذُنُوبهم","فَعادوا ولا وِزْرٌ عليهم ولا ذَنْبُ",0,"ب",1,0],["وفي ظلال الموت موتِ الوجود","وخلفَ أطلال البِلى والهمود",1,"د",1,0],["وفي ظاهر الأقدار أسرار حكمة","طواهن من علم الغيوب ضمير",2,"ر",1,0],["وفي ظلال أبي غازي منضّرة","مرّ الشّباب مرور الطيف عجلانا",3,"ن",2,0],["وفي ظلم القبور لنا مجيرٌ","يجلى وحشة العيش الجهام",4,"م",1,0],["وَفي ظِلِّ مَحمودِ بنِ نَصرِ بنِ صالِحٍ","مَراقٍ لِمَن يَبغي إِلى المَجدِ سُلَّما",5,"م",2,0],["وَفي ظِلالِكَ لِلآمالِ مُنتَجَعٌ","تَجودهُ مِن نَدى راحاتك السُّحبُ",6,"ب",1,0],["وفي ظمأ الهواجر واعتزال","عن الأشرار مع سهر الليالي",7,"ل",2,0],["وفي ظَهْرِ إبراهيمَ كانتْ خَبيئةً","أكفُّكم حتّى غَدتْ نارهُ بَردا",8,"د",2,0],["وفي ظني بلطفك تعف عني","فأصبح في حمى حرز حراز",9,"ز",1,0],["وفي ظلِّ الكريمِ رَعاه ربّي","وأبقاهُ لكلِّ العربِ ذُخرا",10,"ر",2,0],["وفي ظلال النخل طاب السكن","يهنيك يا قاطف أرطابه",11,"ه",1,0],["وَفي ظلك المَمدود تَبلغ سؤلها","بِحُسن سَداد مِنكَ في الحُكم يُحمد",12,"د",1,0],["وَفي ظل العَزيز خديو مصر","حَباه اللَه عَزاً دائِميا",13,"ي",2,0],["وفي ظِباء البَدْو مَنْ يَزْدرِي","بالظَّبَيَاتِ الحَضَرِيَّاتِ",14,"ت",1,0],["وفي ظُلَلِ الأفْنانِ خُوْطٌ على نَقَاً","مَنيْعُ الجَنى لَدْنُ التَأَوُّدِ فَيْنانُ",15,"ن",1,0],["وفي ظنه الصديق قد سد كوة","بكعف عليها رقطها بتقحم",16,"م",1,0],["وفي ظاهري من شاهد الوجد ما ترا","نحول وقلب ذاب من حرقة الفقد",17,"د",1,0],["وفي ظلمات الشك في غمرة الردى","تحرّيتُ نور اللّه في بسمة الثغر",18,"ر",1,0],["وفي ظلال سليمان أقام على","رغدٍ المعيشة حيناً غير خشيان",19,"ن",1,0],["وفي ظلام شعره","رقّصه فهيّمه",20,"م",2,0],["وفي ظل عفو اللَه امسى مؤرخاً","واصبح في دار النعيم مخلدا",21,"د",2,0],["وفي ظله حزت الهنا واسترحت من","زماني ولم أخش الخطوب الدواهيا",22,"ي",2,0],["وفي ظهور بني العباسِ قاطبةً","لولاك ما هي في بغداد تقتسمُ",23,"م",1,0],["وفي ظل انعام الخديوي نجاحها","بتوفيق مولانا العزيز تكامله",24,"ل",2,0],["وفي ظل عباس المليك تدوم في","تهاني ارتقاء لا يزال تواليها",25,"ه",2,0],["وفي ظنهم أن الحريص على ولا","ئها مغرف يبغي نوال نداها",26,"ا",3,0],["وفي ظلها الممدود غر ميامنٌ","وكانوا على الدنيا من الشعث والغبش",27,"ش",1,0],["وفي ظهرِ الأُحَيْدِبِ حمّلَتْهُمْ","خِفاف سيوفِه عبئاً ثَقيلا",28,"ل",2,0],["وَفِي ظُلْمَةِ خَطْبِ الدَّهْ","رِ وَجْهُ القَمَرِ السَّارِي",29,"ر",2,0],["وَفي ظِفارَ بَنتَ آباؤنا غُرَفاً","وَكَوكبانِ وَقصرِ المُلكِ ريدانا",30,"ن",2,0],["وَفي ظِلالِ اللوفِ","بِجانِبِ الشادوفِ",31,"ف",1,0],["وفي ظلها أهل الفضائل قائل","تجلى به عني دجا كل غمة",32,"ه",1,0],["وفي ظننا أنَّا حِيَاضُ محبَّة","فمن أين يأتي في الصفاء قَذَى البُغْض",33,"ض",1,0],["وفي ظلم سود ثلاث حبسته","بلج ببطن الحوت بالظلمة الظلمى",34,"م",2,0],["وَفِي ظِلِّ هَذا اللّيل رَاحَ تَهَلّلِي","وَفِي لُجّةِ الأًحْزَانِ سَاخِي الْمَنَاكِبِ",35,"ب",1,0],["وفي ظل النخيل حطام عش","تلفع بالأزاهر والغصون",36,"ن",1,0],["وفي ظَهرِ عمَّانَ استقرَّ مقامُها","وفي مصرَ قومي حين تُنْمَى المعاشرُ",37,"ر",1,0],["وفي ظل بيت الله في موئل الهدى","أقمت موازيني وعاد لي الرشد",38,"د",1,0]]}