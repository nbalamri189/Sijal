{"poems":[[105,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[118,"لهان علي أن ألقى حمامي","https://www.aldiwan.net/poem49367.html","الوافر"],[141,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[180,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[302,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[362,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[438,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"]],"verses":[["وفي ظلِّهِ الممدودِ حَطُّوا ذُنُوبهم","فَعادوا ولا وِزْرٌ عليهم ولا ذَنْبُ",0,"ب",1,0],["وفي ظلال الموت موتِ الوجود","وخلفَ أطلال البِلى والهمود",1,"د",1,0],["وفي ظلم القبور لنا مجيرٌ","يجلى وحشة العيش الجهام",2,"م",1,0],["وَفي ظِلِّ مَحمودِ بنِ نَصرِ بنِ صالِحٍ","مَراقٍ لِمَن يَبغي إِلى المَجدِ سُلَّما",3,"م",2,0],["وَفي ظِلالِكَ لِلآمالِ مُنتَجَعٌ","تَجودهُ مِن نَدى راحاتك السُّحبُ",4,"ب",1,0],["وفي ظمأ الهواجر واعتزال","عن الأشرار مع سهر الليالي",5,"ل",2,0],["وفي ظَهْرِ إبراهيمَ كانتْ خَبيئةً","أكفُّكم حتّى غَدتْ نارهُ بَردا",6,"د",2,0],["وفي ظني بلطفك تعف عني","فأصبح في حمى حرز حراز",7,"ز",1,0]]}