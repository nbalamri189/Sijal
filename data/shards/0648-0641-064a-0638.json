{"poems":[[105,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[94,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[120,"لهان علي أن ألقى حمامي","https://www.aldiwan.net/poem49367.html","الوافر"],[143,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[182,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[304,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[364,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[441,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"]],"verses":[["وفي ظلِّهِ الممدودِ حَطُّوا ذُنُوبهم","فَعادوا ولا وِزْرٌ عليهم ولا ذَنْبُ",0,"ب",1,0],["وفي ظلال الموت موتِ الوجود","وخلفَ أطلال البِلى والهمود",1,"د",1,0],["وفي ظلال أبي غازي منضّرة","مرّ الشّباب مرور الطيف عجلانا",2,"ن",2,0],["وفي ظلم القبور لنا مجيرٌ","يجلى وحشة العيش الجهام",3,"م",1,0],["وَفي ظِلِّ مَحمودِ بنِ نَصرِ بنِ صالِحٍ","مَراقٍ لِمَن يَبغي إِلى المَجدِ سُلَّما",4,"م",2,0],["وَفي ظِلالِكَ لِلآمالِ مُنتَجَعٌ","تَجودهُ مِن نَدى راحاتك السُّحبُ",5,"ب",1,0],["وفي ظمأ الهواجر واعتزال","عن الأشرار مع سهر الليالي",6,"ل",2,0],["وفي ظَهْرِ إبراهيمَ كانتْ خَبيئةً","أكفُّكم حتّى غَدتْ نارهُ بَردا",7,"د",2,0],["وفي ظني بلطفك تعف عني","فأصبح في حمى حرز حراز",8,"ز",1,0]]}