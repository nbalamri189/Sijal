{"poems":[[107,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[96,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[124,"لهان علي أن ألقى حمامي","https://www.aldiwan.net/poem49367.html","الوافر"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[186,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[308,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[368,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[445,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"]],"verses":[["وفي ظلِّهِ الممدودِ حَطُّوا ذُنُوبهم","فَعادوا ولا وِزْرٌ عليهم ولا ذَنْبُ",0,"ب",1,0],["وفي ظلال الموت موتِ الوجود","وخلفَ أطلال البِلى والهمود",1,"د",1,0],["وفي ظاهر الأقدار أسرار حكمة","طواهن من علم الغيوب ضمير",2,"ر",1,0],["وفي ظلال أبي غازي منضّرة","مرّ الشّباب مرور الطيف عجلانا",3,"ن",2,0],["وفي ظلم القبور لنا مجيرٌ","يجلى وحشة العيش الجهام",4,"م",1,0],["وَفي ظِلِّ مَحمودِ بنِ نَصرِ بنِ صالِحٍ","مَراقٍ لِمَن يَبغي إِلى المَجدِ سُلَّما",5,"م",2,0],["وَفي ظِلالِكَ لِلآمالِ مُنتَجَعٌ","تَجودهُ مِن نَدى راحاتك السُّحبُ",6,"ب",1,0],["وفي ظمأ الهواجر واعتزال","عن الأشرار مع سهر الليالي",7,"ل",2,0],["وفي ظَهْرِ إبراهيمَ كانتْ خَبيئةً","أكفُّكم حتّى غَدتْ نارهُ بَردا",8,"د",2,0],["وفي ظني بلطفك تعف عني","فأصبح في حمى حرز حراز",9,"ز",1,0]]}