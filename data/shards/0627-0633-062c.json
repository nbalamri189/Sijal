{"poems":[[74,"طوق جود الوزير جيدي","https://www.aldiwan.net/poem19417.html","مخلع البسيط"],[53,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[76,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[42,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[69,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[52,"وإنني في الصلاة أحضرها","https://www.aldiwan.net/poem63841.html","المنسرح"],[52,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[112,"يارب اجرني","https://www.poetsgate.com/ViewPoem.aspx?id=8422",""],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[275,"طربا أهجت لنا برقصك هذا","https://www.aldiwan.net/poem35267.html","الكامل"],[376,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[382,"إليك أضرع في مدحٍ خصصتِ به","https://www.aldiwan.net/poem59155.html","البسيط"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[487,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[580,"أين كؤوسي وأين أكوابي","https://www.aldiwan.net/poem2745.html","المنسرح"],[580,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122598","البسيط"],[761,"","https://poetry.dctabudhabi.ae/diwan/poem/27042","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37855","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56607","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125366","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200985","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202585","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200407","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99514","الكامل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126104","الرجز"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28318","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131955","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54369","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4816,"فرحة قليبي","https://www.poetsgate.com/ViewPoem.aspx?id=8465",""],[4816,"سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=8552",""],[4830,"قاضي الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=193673",""],[4830,"هَيتَ لك","https://www.poetsgate.com/ViewPoem.aspx?id=198709",""],[4916,"حلم الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=135376",""],[5055,"مآثر","https://www.poetsgate.com/ViewPoem.aspx?id=100739",""],[5136,"أودى بحمد الله عامر","https://www.poetsgate.com/ViewPoem.aspx?id=121599",""],[5277,"حيرة","https://www.poetsgate.com/ViewPoem.aspx?id=190987",""],[5288,"الزمان غروب","https://www.poetsgate.com/ViewPoem.aspx?id=1152",""],[5376,"اِسجدْ إليهم واقْتربْ","https://www.poetsgate.com/ViewPoem.aspx?id=197472",""],[5437,"إنتفاضة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=143707",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[5652,"ماتت عظيمه","https://www.poetsgate.com/ViewPoem.aspx?id=208677",""],[5652,"ياكبر ضيقات الليالي والايام","https://www.poetsgate.com/ViewPoem.aspx?id=208686",""],[5725,"ايلان","https://www.poetsgate.com/ViewPoem.aspx?id=177746",""],[5725,"أسجى الهوى؟","https://www.poetsgate.com/ViewPoem.aspx?id=204831",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""]],"verses":[["أسجع بالمدحِ في علاه","لا غَرْوَ أن يسجع المطوَّق",0,"ق",1,0],["أسجدُ من هدهدٍ إذا برزت","فيشةُ فحلٍ عظيمة العَكَدَهْ",1,"د",2,0],["أَسَجايا كَما تَرِقُّ المُدامَه","وَعَطايا كَما تُريقُ الغَمامَه",2,"م",2,1],["أَسجَرُ قَد باتَ عَلَي","هِ مِن سَحابٍ ضَرِبُ",3,"ب",1,0],["أسْجَدَ اللهُ لهُ أمْلاكُهُ","يَوْمَ خَرُّوا لأَبيهِ ساجِدينا",4,"ن",2,0],["أَسجُدُ وَالقومُ راكِعونَ مَعاً","وَأُسرِعُ الوَثبَ إِن هُمُ قَعَدوا",5,"د",3,0],["اِسجَحي يا عُبَيدُ في وُدِّ نَفسي","لَيسَ إِمساكُها مِنَ الإِسجاحِ",6,"ح",1,0],["أسجد لوجهك يربي يامزيل الهموم..","ياكافل العبد.. من قدهو . ألى. لاقده",7,"د",2,1],["أسجل فيها ما أشاء من المنى","ومن خطرات الروح للشاعر الغرد",8,"د",1,0],["أسجَيت لي تلكَ الجفونَ ولحظها","أرهَفتِهِ حتى غدا نفّاذا",9,"ذ",2,0],["أسَجايا مُلهَمٍ وَرِثَت","أم رَضاعاً كنَّ في اللَّبنِ",10,"ن",1,0],["اُسجد وعظِّم لمن بالحسن أبدعها","في حي منزلها السامي بأسماء",11,"ا",2,0],["أسجد لربك في البيت العتيق فقد","أفعمته اليوم تكبيرا وتهليلا",12,"ل",2,0],["أسجد لديه مصليا","بما يلوح لدى المقابر",13,"ر",1,0],["أسجنٌ وضَربٌ مُؤلِمٌ وإهَانَةٌ","وزَجرٌ وتَعزير وما اقترَفوا وِزرا",14,"ر",2,0],["أَسجُدُ شُكْراً لها إِذا طَلَعَتْ","كأَنَّ كأْسِي لَدَيَّ محْرابي",15,"ب",2,0],["أَسْجِحْ فإِنَّكَ قَدْ مَلكْ","تَ وحُزْتَ دونَ الْخَلقِ قنِّي",16,"ن",2,0],["أسجِح وأروِد ولَو حُلَّ العِقالِ فعن","دَ اللهِ أُجرةُ إسجاحٍ وإروادِ",17,"د",1,0],["أَسِجناً وَقَيداً وَاِغتِراباً وَعُسرَةً","وَذِكرى حَبيبٍ إِن ذا لِعَطيمِ",18,"م",1,1],["اُسجُدْ وَجُدْ تَحظَ بِعزِّ الدُّنى","وَعَزِّ أُخراكَ ونَيلِ السُّعودِ",19,"د",1,1],["أسجن مراد لو تكلم منزل","لأخبرتنا عما جرى لمراد",20,"د",1,1],["أسجنَ قنا لقد نِلتَ الأماني","وبتَّ بفضلهِ في خيرِ حالِ",21,"ل",1,0],["أسجل شعر هذا الدهر نظما","وأجلوه بكلتي صفحتيه",22,"ه",1,1],["أسجّل منها بعض ما أنا سامع","فأصبح فيكم للروائع قائلا",23,"ل",2,0],["أسجّل أعدائي لآمن غدرهم","وقد كثروا حتى نسيت الأعاديا",24,"ي",2,0],["أسجدت فوق الخد منه فمي","شكراً لما أوليت من طرب",25,"ب",1,0],["اسجد لقرد السوء في زمانه","ولو تلقاك بخنزوانه",26,"ه",1,1],["أَسَجحَةُ يا جَريرُ لَكُم أَحَلَّت","نِكاحَ المَيتِ قَد لَقيَ الحِسابا",27,"ب",2,0],["أَسِجناً وَقَيداً وَاِغتِراباً وَفُرقَةً","وَذِكرى حَبيبٍ إِن ذا لَعظيمُ",28,"م",1,1],["اسجعي عصفورة الوادي الخصيب","بنشيد الحب في دار الحبيب",29,"ب",1,1],["أسْجَحْتَ حينَ ملكتَ عفواً عنهمُ","إنَّ الكريمَ مُؤمّلٌ إسجاحُهُ",30,"ح",2,0],["أسجحٌ ثمَّ أغرٌّ وطليق","يُخجلُ الأقمارُ زهواً وبَريق",31,"ق",1,0],["اسجي ديار الخل همال وبلك","يا رب لي كل المخاليق ترجاك",32,"ك",1,0],["اسج لا جى زولك بطيف مرظوف","واشوق من الريان للصايميني",33,"ن",2,0],["أسجيّةٌ أم تَخبَرُ الهَجْرا","فألِفتَ غيرَ حشاشتي وَكْرا",34,"ر",2,1],["أسجيّةُ المغرورِ حُسناً قد بَدَتْ","أم تبتغي نأيَ الذي قد أوصَلَكْ",35,"ك",1,0],["اسج عن دربك ولو صار ما صار","مثلي على [ درب المفارق ] صبوره",36,"ر",2,0],["أسجل بك تواريخ الوجوه أعراق","وتتصاقت فشاشيغن ولا واحي",37,"ح",2,0],["اسجد لربك واقترب","شكراً تفز بمزيد شاكر",38,"ر",1,0],["أسجينةَ القلبِ المضمَّخِ بالأسى","أنا بعدَ أن رحتِ المحبُّ اليائسُ",39,"س",1,0],["أسجّ بعيد .. وأتلاقى بطيفك .. والزمان غروب","وأسامر بالوفاء قلبك .. وأعاتب وأشتكي فقدك",40,"ك",1,1],["اِسجدْ إليهم واقْتربْ","ما دمْت منْهم ترْتَعِبْ",41,"ب",1,1],["اسج في ليلي اذا لاح هتان","وأطرب ليامن زهبوا لي المعاميل",42,"ل",1,0],["اسْجِنُوهُ وَكُلَّ حُرٍّ عَنِيدٍ","لا لِحُرٍّ يَعِيشُ بَيْنَ الْعَبِيدِ",43,"د",1,0],["أسج عن .. طاري .. تباريحٍ إتهمْ","في وادي ..النسيان .. منهو نساها",44,"ا",3,0],["اسج عنها في مراقيب الاسنام","الي عليها .. شف .. حالي حلالي",45,"ل",2,0],["اسجدْ عسى الرحمن يقبل دمعةً","من حرٌها كلّ البحار تسجّرُ",46,"ر",1,0],["أسجى الهوى يا حلوة الصمتِ؟","فلتسقنيها خمرة الصوتِ",47,"ت",1,1],["أسجاعُ ليلٍ قوافيها تسيرُ بِها","قوارباً شَدَّها الإبحارُ في سَحَرِ",48,"ر",1,0],["أسَجَاحُ ترنو فوق ذِقْنَيْ دجلة","لمسيلمٍ يعظُ (القطيف)َ و(كاظمة)ْ",49,"م",2,0],["اسجد الليل لتسطعي مثل بدر ٍ,","في سماء الشرق والليل الرهيب.",50,"ب",1,0],["أُسَجّل من خَلَدِ الأمنياتِ‏","على خَلَد الأفعوان المُهَيّا",51,"ي",2,0]]}