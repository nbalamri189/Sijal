{"poems":[[72,"طوق جود الوزير جيدي","https://www.aldiwan.net/poem19417.html","مخلع البسيط"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[74,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[40,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[50,"وإنني في الصلاة أحضرها","https://www.aldiwan.net/poem63841.html","المنسرح"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[209,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[268,"طربا أهجت لنا برقصك هذا","https://www.aldiwan.net/poem35267.html","الكامل"],[369,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[374,"إليك أضرع في مدحٍ خصصتِ به","https://www.aldiwan.net/poem59155.html","البسيط"],[477,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[480,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[536,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[573,"أين كؤوسي وأين أكوابي","https://www.aldiwan.net/poem2745.html","المنسرح"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"]],"verses":[["أسجع بالمدحِ في علاه","لا غَرْوَ أن يسجع المطوَّق",0,"ق",1,0],["أسجدُ من هدهدٍ إذا برزت","فيشةُ فحلٍ عظيمة العَكَدَهْ",1,"د",2,0],["أَسَجايا كَما تَرِقُّ المُدامَه","وَعَطايا كَما تُريقُ الغَمامَه",2,"م",2,1],["أَسجَرُ قَد باتَ عَلَي","هِ مِن سَحابٍ ضَرِبُ",3,"ب",1,0],["أسْجَدَ اللهُ لهُ أمْلاكُهُ","يَوْمَ خَرُّوا لأَبيهِ ساجِدينا",4,"ن",2,0],["أَسجُدُ وَالقومُ راكِعونَ مَعاً","وَأُسرِعُ الوَثبَ إِن هُمُ قَعَدوا",5,"د",3,0],["اِسجَحي يا عُبَيدُ في وُدِّ نَفسي","لَيسَ إِمساكُها مِنَ الإِسجاحِ",6,"ح",1,0],["أسجل فيها ما أشاء من المنى","ومن خطرات الروح للشاعر الغرد",7,"د",1,0],["أسجَيت لي تلكَ الجفونَ ولحظها","أرهَفتِهِ حتى غدا نفّاذا",8,"ذ",2,0],["أسَجايا مُلهَمٍ وَرِثَت","أم رَضاعاً كنَّ في اللَّبنِ",9,"ن",1,0],["اُسجد وعظِّم لمن بالحسن أبدعها","في حي منزلها السامي بأسماء",10,"ا",2,0],["أسجد لربك في البيت العتيق فقد","أفعمته اليوم تكبيرا وتهليلا",11,"ل",2,0],["أسجد لديه مصليا","بما يلوح لدى المقابر",12,"ر",1,0],["أسجنٌ وضَربٌ مُؤلِمٌ وإهَانَةٌ","وزَجرٌ وتَعزير وما اقترَفوا وِزرا",13,"ر",2,0],["أَسجُدُ شُكْراً لها إِذا طَلَعَتْ","كأَنَّ كأْسِي لَدَيَّ محْرابي",14,"ي",1,0],["أَسْجِحْ فإِنَّكَ قَدْ مَلكْ","تَ وحُزْتَ دونَ الْخَلقِ قنِّي",15,"ي",1,0]]}