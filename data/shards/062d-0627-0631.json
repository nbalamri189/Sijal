d=129535",""],[182,"دمع غير قابل للتاجيل","https://www.poetsgate.com/ViewPoem.aspx?id=72844",""],[182,"فيحاء ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=72839",""],[4966,"قلبى أسير محبتك","https://www.poetsgate.com/ViewPoem.aspx?id=196771",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5087,"زفرات تعتادني عند ذكرا","https://www.poetsgate.com/ViewPoem.aspx?id=96348",""],[5135,"أيُّهَا الظَّبْيُ","https://www.poetsgate.com/ViewPoem.aspx?id=202223",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5150,"أي قلب تملكين ...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203781",""],[5156,"يا والي الإمام هنأك الله","https://www.poetsgate.com/ViewPoem.aspx?id=99178",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5219,"اهات حرف","https://www.poetsgate.com/ViewPoem.aspx?id=194919",""],[5261,"رمضانيون","https://www.poetsgate.com/ViewPoem.aspx?id=212890",""],[5277,"الرحيل على صهوة الحيرة","https://www.poetsgate.com/ViewPoem.aspx?id=185132",""],[5277,"حارَ الطبيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=188891",""],[5277,"حيرة","https://www.poetsgate.com/ViewPoem.aspx?id=192580",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5362,"فلق الفجر هامة الظلماء","https://www.poetsgate.com/ViewPoem.aspx?id=170369",""],[5422,"رباعيه للوطن","https://www.poetsgate.com/ViewPoem.aspx?id=86112",""],[5431,"مورق الحس شعره المنحوتُ","https://www.poetsgate.com/ViewPoem.aspx?id=197897",""],[5431,"ليته كان شفّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=203703",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5461,"لا تكسر الفانوس","https://www.poetsgate.com/ViewPoem.aspx?id=8537",""],[5493,"ضاعَ الحَياء","https://www.poetsgate.com/ViewPoem.aspx?id=197003",""],[5533,"ما بَيْنَ بُرْدَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=181664",""],[2110,"حسبي من الوجد ما بي أيها اللاحي","https://www.poetsgate.com/ViewPoem.aspx?id=156268",""],[5685,"في رثاء زايد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34735",""],[5694,"غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=132097",""],[5732,"حار قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177943",""],[5736,"طاحون الهواء","https://www.poetsgate.com/ViewPoem.aspx?id=203881",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5759,"عد إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=213623",""],[5781,"مقاليدُ العشقِ بيدي!","https://www.poetsgate.com/ViewPoem.aspx?id=208762",""],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""],[5790,"لا وعينيك ويكفى ذا القسم","https://www.poetsgate.com/ViewPoem.aspx?id=111869",""],[5861,"لغز العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190728",""],[5908,"أسفر الحي حين زارت نوار","https://www.poetsgate.com/ViewPoem.aspx?id=170973",""],[5943,"مزقًا تفرَّقنا","https://www.poetsgate.com/ViewPoem.aspx?id=34311",""],[5956,"الوطن العربي","https://www.poetsgate.com/ViewPoem.aspx?id=192339",""],[5974,"هاج القريض","https://www.poetsgate.com/ViewPoem.aspx?id=215845",""],[6056,"ساعة الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=130358",""],[6056,"البرقع الذوق","https://www.poetsgate.com/ViewPoem.aspx?id=156710",""],[6070,"المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=188466",""],[6093,"ماله عندي شبيه ( مجزوء الرمل )","https://www.poetsgate.com/ViewPoem.aspx?id=176000",""],[6093,"إِبْرةُ الحُسن","https://www.poetsgate.com/ViewPoem.aspx?id=176025",""],[6093,"حيّ الفريقَ وحيِّ الدارَ والسَّكَنَا","https://www.poetsgate.com/ViewPoem.aspx?id=176578",""],[6124,"حارت الأقدار","https://www.poetsgate.com/ViewPoem.aspx?id=174942",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[313,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66484&r=&rc=9",""],[313,"نهاية حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66488&r=&rc=13",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6237,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77869&r=&rc=11",""],[6275,"البريق الضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83614&r=&rc=6",""],[6310,"الزَّحف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71996&r=&rc=1",""],[5567,"إسراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81756&r=&rc=20",""],[5567,"شغف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81761&r=&rc=29",""]],"verses":[["حارَ المُجارونَ إِذ جارَوكَ في طَلَقٍ","وَأَجفَلوا عَن طَريقِ السابِقِ الأَرِنِ",0,"ن",1,0],["حارَتْ وراءَهُمُ العُقولُ كأننا","شَرْبٌ تُطَوِّحُهُمْ كُؤوسُ عُقارِ",1,"ر",1,0],["حارَبوا الجَهلَ وَكانوا قَبلَنا","في دُجى عَميائِهِ حَتّى اِنهَزَم",2,"م",1,0],["حارَبتُمُ أَخلاقَكُم لِتُحارِبوا","أَخلاقَنا فَتَأَلَّمَ الشَعبانِ",3,"ن",1,0],["حارَ الفِراشُ وَحِرتُ فيهِ فَأَنتُما","تَحتَ الظَلامِ مُعَذَّبٌ وَمُؤَرَّقُ",4,"ق",1,0],["حارساً أربع العروبة بالسي","ف معيداً لها الزمان الأغرّا",5,"ر",2,0],["حارِ بنَ كَعبٍ أَلا الأَحلامُ تَزجُرُكُم","عَنّي وَأَنتُم مِنَ الجوفِ الجَماخيرِ",6,"ر",1,1],["حاربني إذ لم تُحَنّكْهُ الحُنَكْ","حتى إذ ما الأمر بالأمرِ ارتبكْ",7,"ك",1,0],["حار في خدَّيهِ ماءٌ","مازجَ الماءَ ضِرامُ",8,"م",1,0],["حاربَ أجفانَه الرقادُ فما","يسكنُ من ليلهِ إلى سكَنِ",9,"ن",1,1],["حارَبوا البُؤسَ فيو الصِغارِ صَغيراً","قَبلَ أَن يَستَبِدَّ فيهِم قَوِيّا",10,"ي",2,0],["حارَ أَمري فيكَ حَتّى","لَستُ أَدري ما أَقولُ",11,"ل",1,0],["حارَ المساكينُ وارتاعوا وأعْجَزَهم","أن يحذَروه وهلْ يُجديهمُ الحَذَرُ",12,"ر",1,0],["حاربت السلم حبا في صيانته","حتى تألفت الاقوام والامم",13,"م",1,0],["حارَ فيكِ المُهَندِسونَ عُقولاً","وَتَوَلَّت عَزائِمُ العِلمِ مَرضى",14,"ض",2,0],["حارَبَتني الأَيّامُ حَتّى لَقَد أَص","بَحَ حَربي مَن كُنتُ أَعتَدُّ سِلمي",15,"م",2,0],["حارِسُ مُلكٍ لَهُ مِن دونِهِ أَبَداً","صَدرٌ شَفيقٌ وَرَأيٌ غَيرُ مُتَّهَمِ",16,"م",1,0],["حارَبتُ دَهري مُذ حَلَلتُ بِرَبعِهِ","وَجَعَلتُهُ عِندَ المَضيقِ سِلاحي",17,"ح",2,0],["حَارَ فِيهَا أَرِسْطَطَالِيسُ قِدْماً","وَنَعَاهَا الْحَكِيمُ أَفْلاطُونُ",18,"ن",1,0],["حارتِ الأفكارُ في قدرةِ مَنْ","قدْ هدانا سبلاً عزَّ وجلْ",19,"ل",1,0],["حَارَ الطَّبِيبُ ورَاحَ مِن أَسَفٍ","يُلقِي العُلومَ ويَنبذُ الحِيَلا",20,"ل",2,0],["حَارَ الظّلامُ فما يلوذُ بجانبٍ","إلا يُحِيطُ به الضّياءُ ويُحدِقُ",21,"ق",1,0],["حارَ الهِلالُ فَما يُحاوِلُ نَهضَةً","إِلّا رَماهُ مُحَلِّقُ الصُلبانِ",22,"ن",1,0],["حارَبتُمُ الأَخلاقَ حَربَ مُناجِزٍ","يَرمي بِزاخِرَةِ العُبابِ عَوانِ",22,"ن",1,0],["حَارِسُ الثّلمةِ يُلقِي حَولَها","صخرةً من عَزمِهِ لم تُثلَمِ",23,"م",1,0],["حارَتِ الأحزابُ ماذا تنتوي","وبِمَنْ فيما دَهاها تَحتَمِي",23,"م",2,0],["حارِبوا اللَّهَ وزِيدوا شَطَطاً","إنها فتنتُهُ في من جَحَدْ",24,"د",1,0],["حاربوه وانصروا أصنامكم","لا تبالوا من قُواهُ ما حَشَدْ",24,"د",1,0],["حارَبتَ حِزبَ الشِركِ عَنهُ بِالحِجى","وَالرِفقُ مِثلُ البَطشِ يَقصِمُ أَظهُرا",25,"ر",2,0],["حارَبَتْهُمْ نَوائِبُ الدّهْرِ حتّى","آذَنُوا بالفِراقِ قبْلَ التّلاقي",26,"ق",2,0],["حارَبتَ صَبراً إِنَّ رُؤيَتَها","عَلَقٌ بِقَلبِكَ لا تُحارِبُهُ",27,"ب",2,0],["حارَبوا بالرياح هوجاً وبالإع","صارِ في ناره تذوب الصخور",28,"ر",1,0],["حاربوا بالبروق تومض والرع","د فيغلي من صوته التامور",28,"ر",1,0],["حاربوا بالبحار تلقى على الجي","ش بِحولٍ وماؤها مسعور",28,"ر",1,0],["حاربوا بالجبال تقذفُ بالأي","دي تباعاً كأنهن قشور",28,"ر",1,0],["حار في وصفه الأديب فَلا يَع","لم ماذا عَسى يَقول الأديب",29,"ب",1,0],["حاربت جيش عدائها ببسالة","في موقف شخصت به الأحداق",30,"ق",1,0],["حارِبيني يا نائِباتِ اللَيالي","عَن يَميني وَتارَةً عَن شِمالي",31,"ل",2,1],["حَارَ بِهَا فِكْرُ وَالِدَيْها","وَالْفِكْرُ فِي مِثْلِهَا يَحَارْ",32,"ر",1,0],["حارَبَني الدَهرُ فيكَ حَرباً","لَم يَقِها الدِرعُ وَالسِلاحُ",33,"ح",1,0],["حَارتْ به كفي تحاولُ مسحهُ","فكأنَّها تُغْريه بالإيكافِ",34,"ف",1,0],["حارَ بنشنج فِيكَ يَابْنَ شَعُوبٍ","ونَقَضْتَ الْمُجَرَّبَ الْمَعْقُولاَ",35,"ل",2,0],["حَارَ القَرِيضُ وكيفَ أَبْلُغُ غَايةً","هي فَوْقَ طَوقِ يِرَاعَتي وجُهُودِي",36,"د",2,0],["حارت وحار رجالها","بين المروق والانتساب",37,"ب",1,0],["حار ابن إبراهيم في ترتيبه","شرفا له زهر النجوم سواجد",38,"د",1,0],["حار في الحب قلبه","حيرة الصمت في القمم",39,"م",1,0],["حار في الموت والحياة ... كراع","ضاع تحت الدجى وضاع قطيعه",40,"ع",2,0],["حارس يبتزّ ما يحرسه","ويدين الصبح (سعدا) أو (قتاده)",41,"د",2,0],["حارَ طيَّ الَّلهاةِ مّني سؤالٌ","أنا أدرى بردِّهِ والجواب!",42,"ب",1,0],["حاربوا البؤس صغيرا","قبل أن يستبدّ فيهم قويّا",43,"ي",2,0],["حارَ لِساني فَما أَقول تَرى","أَنتَ مَليك الزَمان أَم مَلك",44,"ك",1,0],["حاربتموني بهجران فاتعبني","هجرانكم ووهى والهفتي حالي",45,"ل",2,0],["حاربتني وغزوت قلبي فارسا","ويلاه من هذا الغزال الفارس",46,"س",1,0],["حاربوا الله وراموا عنوة","وضع من اعلاه بئس المعتقد",47,"د",1,0],["حاربتني بحسنها فرمتني","حين ماست وقطعت أوصالي",48,"ل",2,0],["حاربتني الأقدار فاعتب علينا","ودهتني وما وجدت معينا",49,"ن",2,0],["حاربتني إذ قلت ربك واحد","ونصرته إذ قال بل هم عدة",50,"ه",1,0],["حاربوا الرحمن سراً","وأطاعوه جهارا",51,"ر",2,0],["حارَت فما تَدري أَتفخرُ عِزّةً","بِكَ أَم تُؤاخِذُ بِالقُصورِ فَتَخجَلا",52,"ل",2,0],["حارَبَ العُرب وَالأعاجمَ منه","بِسلاحٍ له السلاح فداءُ",53,"ا",2,0],["حارَ في كنههِ الملائكُ عجزاً","عنهُ والأنبياءُ والأولياءُ",53,"ا",2,0],["حاربت حرب الانبياء لغاية","ما نالها الاَّ النبيُّ محمدُ",54,"د",1,0],["حاربتْ آلامَ عصبتها","ولكم يشكونَ من ألمِ",55,"م",1,0],["حار حكمي في حكمك الجائر العد","ل وفي خلقك الجليل اللطيفِ",56,"ف",1,0],["حار النبيون في تطهير فطرتهم","فما عسى نفع أمثالي وأشعاري",57,"ر",2,0],["حار قَلبي بِهِ وَحارَت عُيوني","لا أُطيقُ الغَرامَ في أَلفِ وَجهٍ",58,"ه",1,0],["حارت براعة فهمي فيك فانحصرت","عن وصفِ مَعْنىً وحيدٍ من معانيكا",59,"ك",2,0],["حارَبْتَ بالبَغْي إمامَ الهدى","ولم تَهَبْ منها عزيزاً يُهاب",60,"ب",1,0],["حارَب الناسُ قبلنا الأعداءَ","حين كانوا أعِزَّةً أكْفاءَ",61,"ا",2,1],["حارَ طَرفي فيهِ أَبَدرُ سَماءٍ","هُوَ أَم خوطُ بانَةٍ أَم غَزالُ",62,"ل",1,0],["حاروا وَقَد حارَت لَديكَ قُلوبُهُم","مِمّا رَأَوا فِرَقاً وَقَلبُكَ أَصَمَعُ",63,"ع",1,0],["حارت عقولهم فقالوا إنه","شعر بسحر اَلأولين مطلسم",64,"م",1,0],["حارَ فكري وضاق صدري وإن حا","زَ هموماً يَضيقُ عنها الفَضاءُ",65,"ا",2,0],["حارَ فكري وضاق صدري لأمرٍ","أخطرَتهُ الأقدارُ عجزاً ببالي",66,"ل",2,0],["حاربتُهنَّ بمثلِ ما حارَبنني","حتى يُكسَّرَ بالسلاحِ سِلاح",67,"ح",1,0],["حارَ الثُّناءُ فَما يَدْرِي أَغايَتُهُ","أَعْراقُهُ الْبِيضُ أَمْ أَخْلاقُهُ السُّجُح",68,"ح",1,0],["حارَ الوَرى فيهِ فَقالَ كُلُّهُم","هَل مَلِكٌ أَنتَ عَلَينا أَم مَلَك",69,"ك",1,0],["حار ما بينهما شوقُهُما","قبلةٌ تجزيه عنها قبلتين",70,"ن",1,0],["حارساً ملكَه برأيٍ وجدٍّ","لَو دَعا النجمَ صارَ فوراً قَطينه",71,"ن",2,0],["حاربوها وما يزالون والمو","كب يجرى وروحه الإقدام",72,"م",1,0],["حار فيه كل من دبت","على الأرض خطاه",73,"ه",1,0],["حارت الأفكار فيها","مذ عرفنا الزَمنا",74,"ن",2,0],["حارب الكفر والضلالة فانقا","د له كل عاقل ورشيد",75,"د",1,0],["حارَت بِهِ الحور جَمالاً فَما","ألطف ما قالتَ ذَوات الدَلال",76,"ل",1,0],["حارَتْ عيونُ العالَمِينَ كثْرةً","من المساعي لك والمَحامد",77,"د",1,0],["حارَبَ واسْتَعْوى قَراضِبَةً","ليْسَ ميَّاه يُحازُ نَعَمْ",78,"م",1,0],["حار بها خِرِّيت فكريَ الذي","كان قديماً داخلاً كل بيت",79,"ت",1,0],["حاربتْني الأَعيُنُ النجلُ ومن","مُهْجَتي غُذُّوا ومن لي أنْ تسالم",80,"م",1,0],["حار حكم الحبّ في الحبّ فما","أنْصَفَ المظلومَ ممن ظلما",81,"م",2,0],["حارن ما حارن وارتاض له","لقد أرمَّ ولأمر ما نطقْ",82,"ق",1,0],["حارساً بالبخلِ الحسنَ وما","يحرس الحسنُ بمثل البخل",83,"ل",1,0],["حارَ وَعَقَّت مُزنَهُ الريحُ وَاِن","قارَ بِهِ العَرضُ وَلَم يُشمَلِ",84,"ل",1,0],["حار الحجا في وصفها","سبحانه من خالق",85,"ق",1,0],["حارَ الرِّجالُ سابقٌ","بِشأنهِ ولاحِقُ",86,"ق",1,0],["حارَتْ عُقولُ أُلي النُّهى","بنِماطِ نُقطةِ رمزِ بائِكْ",87,"ك",1,0],["حارَبنَ فيها مَعَدّاً وَاِعتَصَمنَ بِها","إِذ أَصبَحَ الدينُ ديناً غَيرَ مَوثوقِ",88,"ق",1,0],["حار الطبيب وحرت في","ما قد دهاه من الضنى",89,"ا",1,0],["حار الطبيب بما يداوي داءه","لما غدا والموت أكبر دابه",90,"ب",2,0],["حارب على مصر نجوم السما","فملك مصر ما عليه اصطلاح",91,"ح",1,0],["حار الطبيب بما يداوي سقمه","ودواؤه مالي إليه سبيل",92,"ل",1,0],["حارَ الطَّبيبُ وطِبُّهُ في عِلَّتِي","فَجَوابُهُ إذ تَلتَقِي العَينانِ",93,"ن",1,0],["حاروا جميعاً في العِلاجِ وإنَّني","في تَركِهِم ما كنتُ بِالحَيرانِ",93,"ن",1,0],["حارسُ المَرمى كَصَقرِ","واقِفٌ فِي بابِ وَكرِ",94,"ر",1,0],["حاروا فليس لديهمُ إنْ خوطِبوا","أو خاطبوا فَهْمٌ ولا إفهامُ",95,"م",1,0],["حَارَبَتْكَ الأقدارُ عنّي على أن","ني شجاعٌ وأنتَ غيرُ شجاعِ",96,"ع",1,0],["حارَبَني بَعدَكَ السُرورُ كَما","صالَحَني عِندَ فَقدِكَ الحَزَنُ",97,"ن",1,0],["حارت عقول الناس في إدراكها","كم عربي تائه وأعجمي",98,"م",2,0],["حار أرباب الهوى","في الهوى وارتكبوا",99,"ا",1,0],["ح أرته في اللوح شكلاً ونقطا","أيها القلب في بيوت الهدى قر",100,"ر",1,0],["حار حتى لا يعي أبداً","وهو بالأغيار مرتبط",101,"ط",1,0],["حاربَهُ القومُ وهو ناصِرُهُ","قِدْماً وغَشُّوه وهْوَناصحُهْ",102,"ح",2,0],["حارَ الأَنامُ وحاروا في تحيُّرهم","ما حَيرَةُ الخَلْقِ إِلاَّ حكمةُ البَارِي",103,"ر",2,0],["حاربتني فيك الليالي ولم يح","فظن عهدي ولا رعين ذمامي",104,"م",2,0],["حار ماء الحسن فيه","فإذا الناس حيارا",105,"ر",2,0],["حارساً منزلي يرد مغيراً","بالحسام المنصور في كل مضربْ",106,"ب",1,0],["حار العباد وحرت بين أحبة","أسرى وبين معاندين طغاة",107,"ه",1,0],["حاربتمُ ففشلتمُ وستلتوي","أحقادكم فيكم فتحتربونا",108,"ن",2,0],["حاربت طيب افراشي","نومي وآزم تعب",109,"ب",1,0],["حارَبتَهم حَربَ جَدٍّ في مَواطِنِهم","فَعُدتَ بِالنّصرِ في إِشراقِ مُبتَهِجِ",110,"ج",1,0],["حاروا عليه لنسج العنكبوت إذ","باض الحمام فخاب كل مضلل",111,"ل",1,0],["حارِثُ قَدْ عالَجْتَ إِحْدَى الصُمِّ","مِنْ سَنَةٍ تَرْتَمُّ كُلَّ رِمِّ",112,"م",1,0],["حارب الصب بها حرب الرشا","