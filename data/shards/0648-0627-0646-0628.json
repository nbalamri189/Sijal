s://www.aldiwan.net/poem23351.html","البسيط"],[46,"أريد ليان العيش في دار شقوة","https://www.aldiwan.net/poem23499.html","الطويل"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[1,"إذا كنت في حاجة مرسلاً","https://www.aldiwan.net/poem34003.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140953",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55122","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10257","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[49,"هوَ المَوْتُ، فاصْنَعْ كلَّ ما أنتَ صانعُ،","https://www.poetsgate.com/ViewPoem.aspx?id=25222",""],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=18932",""],[7,"أتارِكَة ٌ تدَلَلّهَا قَطامِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17593",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[80,"عجبي من سكينتي وَوَقَاري","https://www.poetsgate.com/ViewPoem.aspx?id=3243",""],[91,"هملت","https://www.poetsgate.com/ViewPoem.aspx?id=53205",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[88,"تيقَّظ فما انت بالخالدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19512&r=&rc=15",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[14,"أقِلِّي عَلَيَّ اللِّوْمَ يا ابْنَة َ مُنْذِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17403&r=&rc=14",""],[71,"حبيبٌ نأى وهو القريبُ المُصاقِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28023&r=&rc=10",""]],"verses":[["وَإِنَّ بُلوغَ الخَوفِ مِن قَلبِ خائِفٍ","لَدونَ بُلوغِ الخَوفِ مِن قَلبِ آمِنِ",0,"ن",1,0],["وَإِن بُزَّ مِن ذاكَ الجَناحِ مُطارُهُ","فَرُبَّ مَقالٍ مِنكَ ذي طَيَرانِ",1,"ن",1,0],["وَإِنَّ بِذاكَ الجِزعِ وَحشاً غَريرَةٌ","تَصيدُ وَأَعيا الناسُ كَيفَ تُصادُ",2,"د",1,0],["وَإِنَّ بُروداً لِلمَخازي مُعَدَّةٌ","فَمَن شاءَ في ذا الحَيِّ أَسحَبتُهُ بُردا",3,"د",2,0],["وَإِنَّ بُكاءَ مَن تَبكيهِ قُربى","لَدونَ بُكاءِ مَن يَبكيهِ وُدُّ",4,"د",1,0],["وَإِن بَعُدَ اللِقاءُ عَلى اِشتِياقي","تَرامَقنا بِأَلحاظِ القُلوبِ",5,"ب",1,0],["وَإِن بَلَغَ الرِّجالُ مَدايَ فيما","أُحاوِلُهُ فَلَستُ مِن الرِّجالِ",6,"ل",1,0],["وَإِنَّ بُيُوتَهُ لَكَمَا سَمِعْنَا","بُيُوتَ الْخَيْل وَالنَّعَمِ الْجِسَامِ",7,"م",1,0],["وَإِنَّ بَنِي زيَّانَ فِي أُفُقِ الْعُلَى","لأَنْجُمُ هَدْيٍ كُلَّمَا أَفَلَ النَّجْمُ",8,"م",1,0],["وَإِن بَرَقَت في مُخَيَلِ الصَوا","بِ عَمياءُ لا يَجتَليها البَصَر",9,"ر",1,0],["وَإِن بَشَرٌ يَوماً أَحالَ بِوَجهِهِ","عَلَيكَ فَحُل عَنهُ وَإِن كانَ دانِيا",10,"ي",2,0],["وَأَنبَتَ في النُفوسِ لَكُم جَفاءً","تَعَهَّدَهُ بِمُنهَلِّ الصُدودِ",11,"د",1,0],["وَإِن باتَ نَهّاضاً بِمِصرَ إِلى الذُرا","فَمِن جَدِّهِ الأَعلى عَلِيٍّ تَعَلَّما",12,"م",2,0],["وَاِنبَرى يَصدَعُ مِن أَغلالِها","بِاليَراعِ الحُرِّ لا بِالقُضُبِ",13,"ب",1,0],["وَأَنبَتَ في حِقفِ النَقاخيرُ رانَةً","تُقِلُّ هِلالاً أَطلَعَتهُ الذَوائِبُ",14,"ب",1,0],["وَإِن بَعُدتُ وَأَضنَتني الهُمومُ لَقَد","عَهِدتُهُ وَهوَ يُدنيني فَيُسليني",15,"ي",1,0],["وَإِنَّ بِلاداً هُنتُ فيها لَأَهوَنُ","وَمَن رامَ مِثلي بِالدَنِيَّةِ أَدنَأُ",16,"ن",2,0],["وَأَن باتَ مَن والاكَ في نَشوَةِ الغِنى","وَأَصبَحَ مَن عاداكَ في غَمرَةِ الرَدى",17,"د",2,0],["وَأَنَّ بَياضَ الرَأسِ يُعقِبُ بِالنُهى","وَلَكِنَّ أَطلالَ الشَبابِ تَزينُ",18,"ن",1,0],["وَإِنَّ بِجَوفي مِنكِ داءٌ مُخامِراً","وَجَوفُكِ مِمّا بي عَلَيك سَليمُ",19,"م",1,0],["وَإِن بَدَتِ الخَيماتُ مِن بَطنِ أَرثَدٍ","لَنا وَفِيافي المَرخَتَينِ الدَكادِكُ",20,"ك",1,0],["وأن بابا رجل يعبد","إلا إذا فاتته منه يد",21,"د",1,0],["وَأَنَّ بَيْتَكَ مَا مَرَّتْ بِهِ حِقَبٌ","حَلِيفُ نُجْحٍ وَإِقْبَالٍ وَعُمْرَانِ",22,"ن",1,0],["وَإِنَّ بَدِيلَ عَصْرٍ كَانَ فِيهِ","عِجَافُ الْقَوْمِ مِلْكاً لِلضِّخَامِ",23,"م",1,0],["وَأَنباطُ السَوادِ قَدِ اِستَحالوا","بِها عَرَباً فَقَد خَرِبَ السَوادُ",24,"د",1,0],["وَإِن بَدا آخَرُ نآءٍ أَغبَرُ","كَأَنَّهُ في رَيطَةٍ مُخَدَّرُ",25,"ر",1,0],["وَأَنَّ بَني اِمرِئِ القَيسِ اِبنِ لؤمٍ","أَبَت عَيدانُها إِلّا اِنكِسارا",26,"ر",2,0],["وأن بات بات على يقظةٍ","بطَرف لنجم العلا راصد",27,"د",1,0],["وإن بها للعلم قَدراً وحُرمة","وإن بها للحق عوناً وناصرا",28,"ر",2,0],["وَإِنَّ بَني رِفاعَةَ مِن تَميمٍ","هُمُ اللَجَأُ المُؤَمَّلُ وَالنَصيرُ",29,"ر",1,0],["وَإِنَّ بِالقَصيمِ مِنهُ ذِكرا","إِذ لَو يُطيعُ الرُؤَساءَ فَرّا",30,"ر",2,0],["وَأَنبُشَ مِن تَحتِ القُبورِ أُبُوَّةً","كِراماً هُمُ شَدّوا عَلَيَّ التَمائِما",31,"م",2,0],["وَإِن بَكَروا غَدَوتَ بِمُسمِعاتٍ","وَأَدكَنَ عاتِقٍ جَلدِ العِصامِ",32,"م",1,0],["وإن بَلغَت رَبيعَةَ جاءَ مِنهَا","أُسُودُ الغَابِ حَولِي مُوفِقِينَا",33,"ن",2,0],["وَأَنبَتَ حَوذاناً وَعَوفاً مُنَوِّراً","سَأُتبِعُهُ مِن خَيرِ ما أَنا قائِلُ",34,"ل",1,0],["وأنَّ بني الآمال أعوز رعيهم","وضاعوا فلا أمٌّ هناكَ ولا أب",35,"ب",1,0],["وانبرى غيثك الهتون بجدوى","علَّمتني مدائحاً لا تُبارى",36,"ر",2,0],["وأنبتّ بالتطعيم أشجار فضة","ومن أحسن الأشجار كلّ مطعّم",37,"م",1,0],["وإن بخسَ المُطْرون حقك إنهُ","لحق ثقيل لا يُظلَّم باخسه",38,"س",2,0],["وأنَّبتني حتى كأنك إنَّما","تتبَّعتَ هاتيكَ المواعيد بالنَّقض",39,"ض",1,0],["وإن بيوت البدو لو تصدقوننا","لأبنيةٌ ما ظللتكم نُطوعها",40,"ع",3,0],["وإن بغاك امرؤ بحيث بنى","أحمدُ أعلى بنيانه وجدكْ",41,"ك",1,0],["وَإِنَّ بَني أُمَيَّةَ أَلبَسوني","ظِلالَ كَرامَةٍ ما إِن تَزولُ",42,"ل",1,0],["وَإِن بَدَأَ النُعمى تَلاها بِمِثلِها","فَتَزدادُ حُسناً كَالقَريضِ مُجَنَّسا",43,"س",2,0],["وَإِن بَرَكَت مِنها عَجاساءُ جِلَّةٌ","بِمَحنِيَةٍ أَشلى العِفاسَ وَبَروَعا",44,"ع",2,0],["وَإِنَّ بَناتِ حَلّابٍ وَجَدنا","فَوارِسَهُنَّ في الهَيجا قُيونا",45,"ن",2,0],["وَإِن بِأَرضٍ نَبَت بِيَ الدارُ فَعَج","جَلتُ إِلى غَيرِ أَهلِها القُرَبا",46,"ب",2,0],["وَاِنبَرى النِساءُ لَهُ","عُجمُهُنَّ وَالعَرَبُ",47,"ب",1,0],["وَإِن بَعُدنا قَليلاً","حَمَلتَ رُمحاً وَحَربَه",48,"ب",2,0],["وَإِنَّ بِها وَإِنَّ بِهِ لَنَقصاً","وَأَنتَ لَها النِهايَةُ في الكَمالِ",49,"ل",1,0],["وَإِن بَذَلَ الإِنسانُ لي جودَ عابِسٍ","جَزَيتُ بِجودِ التارِكِ المُتَبَسِّمِ",50,"م",1,0],["وَإِن بُليتُ بِوُدٍّ مِثلِ وُدِّكُمُ","فَإِنَّني بِفِراقٍ مِثلِهِ قَمِنُ",51,"ن",1,0],["وإن بدَّلَ الأيَّامَ بؤسى بنعمةٍ","فلا تُنكري ما استبدلتْ وخُذيهِ",52,"ي",2,0],["وإنَّ بمسقطِ العلمين ماءً","نميراً دونَهُ ظِلٌّ ظليلُ",53,"ل",1,0],["وإِنَّ بقاءَ المالِ بعديَ نافعٌ","لمن كان بعدي في الزمان بقاؤهُ",54,"ا",3,0],["وَإِنَّ بِقَلبي كُلَّما هاجَ شَوقُهُ","حَراراتِ أَقباسٍ تَلوحُ لِراهِبِ",55,"ب",1,0],["وَأَنَّ بِوَجهِ البَدرِ مَحواً وَلَطخَةً","وَوَجهَكَ ما فيهِ مَعابٌ لِعائِبِ",56,"ب",1,0],["وَإِن باتَتِ الأَعداءُ دونَ بِلادِهِ","تَوَرَّدَها مَكروهُهُ في بِلادِها",57,"د",3,0],["وَإِن بَخِلتِ فَلا وَصلٌ وَلا صِلَةٌ","إِلّا اِهتِداءَ خَيالٍ مِنكِ زَوّارِ",58,"ر",1,0],["وَإِنب قَضى اللَهُ أَن تَبينَ فَقَد","كانَت فَبانَت مِن أَهلِها البَصِرَه",59,"ر",2,0],["وَإِنَّ بَخيلَكُم بِالجودِ يُكنى","سَفاهاً وَاِسمُ صِفرِدِكُم شُجاعُ",60,"ع",1,0],["وَإِنَّ بَني حَربٍ وَمَروانَ أَصبَحوا","بِدارِ هَوانٍ قَد عَراهُم نَكالُها",61,"ل",3,0],["وَإِنَّ بُكائِيَ بِالطُلولِ لَراحَةٌ","فَهَل مُسعِداتي بِالبُكاءِ طُلولُ",62,"ل",1,0],["وَإِنَّ بَقائي بَعدَهُ لَخِيانَةٌ","وَما كُنتُ يَوماً قَبلَهُ بِخَئونِ",63,"ن",1,0],["وَإِنَّ بَني المَراغَةِ لَم يُصيبوا","إِذا اِختاروا مُشاتَمَتي اِختِيارا",64,"ر",2,0],["وَإِنَّ بَني كُلَيبٍ إِذ هَجَوني","لَكَالجِعلانِ إِذ يَغشَينَ نارا",64,"ر",2,0],["وَإِنَّ بِلالاً لا تُحَجَّلُ قِدرُهُ","إِذا سُتِرَت دونَ الضُيوفِ حِجالُها",65,"ل",3,0],["وَإِنَّ بِلالاً يَقتُلُ الجوعَ إِن سَرَت","شَآمِيَّةً بِالنيبِ غُرّاً مَحالُها",65,"ل",3,0],["وإن بدا الليل فأجفانه","في لجة البركة مسبوته",66,"ت",2,0],["وَانْبَسَطَ النُّورُ على","وجهِ الثّرى فابتسَما",67,"م",2,0],["وإن بدأَتْ مواهبُه وعادَت","فمَدحي عائدٌ فيه وبَادِي",68,"ي",1,0],["وَإِن بَرَقَت في مَخيلِ الظُنو","نِ عَمياءَ لا يَجتَليها البَصَر",69,"ر",1,0],["وَانبِذ هُمومَكَ أَن تَضي","قَ بِها فَإِنَّ لَها مَخارِج",70,"ج",1,0],["وَإِنَّ بُطونَ المُكثِراتِ كَأَنَّما","يُنَقنِقُ في أَجوافِهِنَّ الضَفادِعُ",71,"ع",1,0],["وَاَنبَتَّ ما كانَ مَوصُلاً بِأَيدينا","أَينَ الَّذينَ عَهِدنا الجودَ يوثِقُنا",72,"ن",2,0],["وَإِنَّ بِأَيدينا الحديدَ لَناطقٌ","إِذا ما غَدا في غَيرها وَهوَ أَبكَمُ",73,"م",1,0],["وانبرَتْ منهما ولائدُ دُرٍّ","طائرِ الوَثبِ عَنهُما بالنّفارِ",74,"ر",1,0],["وَإِن بُليتُ بِجِدٍّ مِن حُزونَتِهِ","سَهَّلتُهُ فَكَأَنّي مِنهُ في لَعِبِ",75,"ب",1,0],["وَإِنَّ بُجرِيَّةً نابَت جَأَرتُ لَها","إِلى ذُرى جَلَدي فَاِستَوهَلَ الجَلَدُ",76,"د",1,0],["وَإِن بَكَرَت في ظُعنِهِم وَحُدوجِهِم","زَيانِبُ مِن أَحبابِنا وَعَواتِكُ",77,"ك",1,0],["وَإِنَّ بِعَينَيها لَعَمرُكَ شُهلَةً","فَقُلتُ كِرامُ الطَيرِ شُهلٌ عُيونُها",78,"ه",2,0],["وَإِنَّ بِنا لَو تَعلَمينَ لُغَلَّةٍ","إِلَيكَ كَما بِالحائِماتِ غَليلُ",79,"ل",1,0],["وأنبتَّ العلومَ بكلِّ أرضٍ","فتلك ثمارُها تُجنَى فُنونا",80,"ن",2,0],["وَإِنَّ بِلاداً سامَها الضَيمَ أَهلُها","لَأَجدَرُ أَن يَقضي عَلَيها الأَجانِبُ",81,"ب",1,0],["وإنَّ بها من كُلِّ رامٍ وَضَارِبٍ","أُلوفاً هُم السُّمُّ الذُّعافُ لمن يَبْلو",82,"ل",2,0],["وَإِن بَكَت لا بَكَت هَماً فَقَد عَلِمَت","وَأَيقَنَت أن ذاكَ الهَمّ يبكيني",83,"ي",1,0],["وَإِن بَرَكَت أَوفَت عَلى ثَفِناتِها","عَلى قَصَبٍ مِثلِ اليَراعِ المُقَصَّدِ",84,"د",1,0],["وَإِنَّ بَلائَهُم ما قَد عَلِمتُم","عَلى الأَيّامِ إِن نَفَعَ البَلاءُ",85,"ا",2,0],["وَإِن بَدا بِالرُمحِ كانَ أَعجَبا","تَحسَبُهُ قِرداً يَجُرُّ ذَنَبا",86,"ب",2,0],["وإنّ بهِ منهمْ لكُفْواً ومَقْنَعاً","ولكنّنا نأسى لِفَقْدِ المَقاوِل",87,"ل",1,0],["وإنّ بِنا شوقاً إليْهِ ولَوعَةً","تَكادُ لها أكبادُنَا تَتَصَدّع",88,"ع",1,0],["وإنّ بأهلِ الأرضِ فَقراً وفاقَةً","إليك وكلُّ النّاس آتيك مُهْطِع",88,"ع",1,0],["وَإِنباهُكَهُ في سا","دَةٍ مِن خَيرِ جُلّاسي",89,"ي",1,0],["وَاِنبَرى لي عَجرَدٌ يوعِدُني","كَمُثيرِ اللَيثِ لَيلاً ما شَعَر",90,"ر",1,0],["وَاِنبِض إِذا حارَبتَ غَيرَ نابِ","يا عُقبَ يا ذا القُحَمِ الرِغابِ",91,"ب",1,0],["وَأَنبَأَهُ المُنَبِّئُ أَنَّ حَيّاً","حُلولاً مِن حَرامٍ أَو جُذامِ",92,"م",1,0],["وَإِنَّ بَني حَوّاءَ زورٌ عَنِ الهُدى","وَلَو ضُرِبوا بِالسَيفِ ضَربَ الغَرائِبِ",93,"ب",1,0],["وَإِن بَلَغَ المِقدارُ لَم يَنجُ سابِحٌ","وَلَو أَنَّهُ في كُبَةِ الخَيلِ أَعوَجُ",94,"ج",1,0],["وَإِن بُتِكَت عَشرٌ فَمِن بَعدِ ما جَنَت","بِكُلِّ فَسيطٍ قُضَّ أَكثَرَ مِن عَشرِ",95,"ر",1,0],["وَاِنبُذ إِلى مَن تَشَكّى قِرَّةً سَمَلاً","مِنَ الثِيابِ وَأَورِد ظامِئاً سَمَلَك",96,"ك",1,0],["وَإِن بَدَوتِ فَلا يُؤنِسكِ شَقَةٌ","ضُحىً تُناجينَ سَوّاراً وَزَمّاما",97,"م",2,0],["وَإِنَّ بَني الدَيّانِ أَخمَلُ عِزَّهُم","قِيامُ عَميدٍ مِن خُزَيمَةَ دَيّانِ",98,"ن",1,0],["وإنْ بخِلْتَ عن الأحياء كلّهمِ","فاسْقِ المَواطِرَ حَيّاً من بَني مَطَرِ",99,"ر",1,0],["وَإِن بابُ أَمرٍ عَلَيكَ اِلتَوى","فَشاوِر لَبيباً وَلا تَعصِهِ",100,"ص",2,0],["وإن بها صحباً عن الحق ذادة","أبوا أن يهد الحيف من شرفي ركنا",101,"ن",2,0],["وإن بغداد فيها أُمَّة صدقوا","وإن بغداد فيها أُمَّة مانوا",102,"ن",3,0],["وإن بُكائي اليوم لَو نفع البكا","عليهم وَفي مستقبلي سَيَطول",103,"ل",1,0],["وأنبتّ منهم ربيع السّباع","فأثنت بإحسانك الشّامل",104,"ل",1,0],["وَانْبَرَى مِنْ فوْرِهِ أَرْغَبُهُمْ","فِي رِضَى الْغَاشِمِ يسْتَرْضِي الطِّمِرَّا",105,"ر",2,0],["وَأَنْبَتَت الْفَضَائِلَ فِي بَنِيهَا","نَبَاتَ المُخْصِبَاتِ مِنَ الحُقُول",106,"ل",1,0],["وَأَنْبتَ خَيْرَ إِنْبَاتٍ فرُوعاً","تُزَكِّيهِ كَمَا زَكَّى الأُصُولاَ",107,"ل",2,0],["وَأَنبَتَ في جِسمي البَلابِلَ وَالبلى","وَأَمطَرَ مِن آماقيَ الدَمَ وَالدَمعا",108,"ع",2,0],["وَأَنَّ بَني الحَصانِ تَعيثُ فيهِم","عَلانِيَةً سُيوفُ بَني البَغِيِّ",109,"ي",1,0],["وأنّ به نفساً يحطّمُ دونها","منيعُ الصياصي والحديد المَذرَّب",110,"ب",1,0],["وأن به من صَوْلةِ اللّه جَحْفَلاً","يَثُل عُروشَ القاسطينَ ويَسْلُب",110,"ب",1,0],["وإن بسمت له الدنيا سمِعنا","نشيداً يملأ الأطيارَ حِقدا",111,"د",2,0],["وإنَّ بُطُونَ المكثراتِ كأنَّما","تنقنقُ فِي أجوافِهِنَّ الضَّفَادِعُ",112,"ع",1,0],["وإنّ بَلاءَهُم ما قد عَلِمْتُمْ","لدى الذّاعي إذا رُفِع اللّواء",113,"ا",2,0],["وأنْبَأهُ المُنَبّىء ُ أنّ حَيّاً","حُلُولاً مِنْ حَرامٍ، أو جُذامِ",114,"م",1,0],["وانبرت عبقَرٌ تزجِّي من الجنّ","وفوداً مزهوةً بالمواسم",115,"م",1,0],["وإنَّ بلاداً أنجبتْكَ سعيدةٌ","وشعباً تَسامَى عِزُّهُ بك غانم",116,"م",1,0],["وانبرى كالغيمِ في مُضْحِيَةٍ","فسقى دهراً وأحيا وأفاء",117,"ا",2,0],["وانبرى التاريخُ في حَيْرتِهِ","أأماماً يتخطّى ام وراء",117,"ا",2,0],["وانبساطِ السَّفْحِ الذَّي زاحمته","دَفَعاتٌ من مَوجكَ الثَّوْري",118,"ي",1,0],["وانبرَتْ كفٌّ هي البُرْهُ مشَى","فشفَى من \" مُزمن \" داءً عُضالا",119,"ل",2,0],["وأنّ بطونَ العُتاةِ التي","مِن السُحتِ تَهضِمُ ما تهضم",120,"م",1,0],["وانبزتْ منهما ولائدُ دُرٍّ","طائرِ الوثب عهما بالنفّار",121,"ر",1,0],["وانبوا إلى الآتين من بعدكم","يبن لمن يخلفه القابل",122,"ل",1,0],["وأنبأه بصارمه اليقينا","جميعاً للدفاع مسلَّحينا",123,"ا",1,0],["وإن بات بات على يَقظَة ٍ","بطرف لنجم العلى راصد",124,"د",1,0],["وإنَّ بلاداً بالتجارِب هُدّمت","وضُيّعَ أهلوها لإحدى العجائب",125,"ب",1,0],["وإنْ بَعِدُوا لا يَأْمَنُونَ اقْتِرَابَهُ","تَشَوُّفَ أهلِ الغائبِ المُتَنَظَّرِ",126,"ر",1,0],["وأَنْبَتَ في حِقفِ النَّقَاخِيزُ رانة","تُقِلُّ هلالاً أَطلعتْهُ الذَّوائبُ",127,"ب",1,0]]}